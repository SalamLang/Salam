[MAIN]
ignore-patterns=

# numpy is a real dependency of benchmark/programs/4*_matrix_stdlib_* - those
# two exist precisely to time actual NumPy against the Salam matrix package -
# but it is not installed in the linter image, so resolving the import fails
# there and nowhere else. Tell pylint not to try; every other check still runs
# over the files.
ignored-modules=numpy

[MESSAGES CONTROL]
disable=missing-module-docstring,
        missing-function-docstring,
        invalid-name,
        redefined-outer-name,
        global-statement,
        duplicate-code
