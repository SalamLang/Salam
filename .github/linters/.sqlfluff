[sqlfluff]
# Every .sql file in this repo is a MariaDB / MySQL schema loaded by the
# example APIs under tests/en/apps/. sqlfluff has no default dialect, so
# without this line it exits with "No dialect was specified" and lints
# nothing at all.
dialect = mariadb

# The schemas are hand-aligned into columns (name, type, constraints) and the
# seed-data INSERTs line their values up the same way, because these files are
# read as much as they are run. sqlfluff's whitespace rules want exactly one
# space everywhere, which would collapse all of that.
exclude_rules = LT01, LT02

# Alignment padding pushes a few seed-data rows past the 80-column default.
max_line_length = 120

[sqlfluff:rules:references.keywords]
# MariaDB is happy with non-reserved keywords as column names, and the schemas
# use the obvious ones: title, year, notes, done.
unquoted_identifiers_policy = none
