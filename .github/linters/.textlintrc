{
  // Prose terminology for the natural-language linter.
  //
  // "skip" adds Code to textlint's defaults so a term inside `backticks` is
  // left alone. That is not enough on its own here: several files hard-wrap
  // long lines through the middle of an inline-code span, textlint pairs the
  // backticks differently than a reader does, and identifiers land in the
  // rule's view as ordinary prose.
  //
  // "exclude" therefore drops the four default terms that collide with this
  // project's own API vocabulary. Each is a real, case-significant name in
  // the language or its stdlib, and "correcting" the docs would make them
  // describe something that does not exist:
  //
  //   OK       - `ok` is a field of DurationResult/TimeResult, and `Ok` is a
  //              method on db.Connection and db.Rows
  //   SQLite   - `SQLITE` is a db backend constant; `sqlite` is the package
  //   MySQL    - `MYSQL` is the matching backend constant
  //   ID       - `id` appears as a struct field
  //
  // Everything else in the default list still applies.
  "rules": {
    "terminology": {
      "skip": ["Link", "Image", "BlockQuote", "Emphasis", "Code"],
      "exclude": ["OK", "SQLite", "MySQL", "ID"]
    }
  }
}
