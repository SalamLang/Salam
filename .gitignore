.ruff_cache
# ---- Archive ----
*.rar
*.zip
*.vsix
# ---- Build artifacts ----
*.log
*.o
*.a
*.obj
*.hash
*.exe
*.tmp
*.ll
*.ll.run.sh
# Root-anchored: a bare "salam" would also match the tools/salam/ directory.
# .stage1 is separate - build-selfhost.sh only removes it on success.
/salam
/salam.stage1
/salam-*
# ---- WebAssembly playground bundle (generated by tools/build-wasm.sh) ----
salam-wa.js
salam-wa.wasm
salam-wa.data
salam-wa.html
# ---- Dependencies & caches ----
node_modules/
__pycache__/
.mypy_cache/
*.pyc
# ---- Build / dist / test output ----
build/
dist/
/c/tests/.work/
.work
# ---- Editor / IDE ----
.vscode/
.idea/
.claude/
# ---- Books ----
# /books/
/books/*/*/_minted
/books/*/*/*.tex.tmp
/books/*/*/*.tex.tmp.*
/books/*/*/*.out
/books/*/*/*.log
/books/*/*/*.aux
*.pdf
/books/*/*/*.fdb_latexmk
/books/*/*/*.fls
/books/*/*/*.xdv
/books/*/*/*.toc
/books/*/*/*.synctex(busy)
/books/*/*/*.synctex.gz
