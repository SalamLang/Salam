.ruff_cache
# ---- Archive ----
*.rar
*.zip
*.vsix
# ---- Build artifacts ----
*.log
*.o
*.a
*.obj
*.hash
*.exe
*.tmp
# LLVM IR emitted by --emit-llvm plus its generated run wrapper
*.ll
*.ll.run.sh
# Native compiler binaries (Linux ELF builds have no extension; *.exe covers
# Windows). Anchored to the repository root, which is where c/Makefile puts
# them (OUTDIR ?= ..): unanchored, "salam" also matches the DIRECTORY
# tools/salam/, so every file added there was silently ignored - the ones
# already tracked only survived because they predate the rule.
/salam
/salam-mcp
# ---- WebAssembly playground bundle (generated by tools/build-wasm.sh) ----
salam-wa.js
salam-wa.wasm
salam-wa.data
salam-wa.html
# ---- Dependencies & caches ----
node_modules/
__pycache__/
.mypy_cache/
*.pyc
# ---- Build / dist / test output ----
build/
dist/
/c/tests/.work/
.work
# ---- Editor / IDE ----
.vscode/
.idea/
.claude/
# ---- Books ----
# /books/
/books/*/*/_minted
/books/*/*/*.tex.tmp
/books/*/*/*.tex.tmp.*
/books/*/*/*.out
/books/*/*/*.log
/books/*/*/*.aux
/books/*/*/*.pdf
/books/*/*/*.fdb_latexmk
/books/*/*/*.fls
/books/*/*/*.xdv
/books/*/*/*.toc
/books/*/*/*.synctex(busy)
/books/*/*/*.synctex.gz
# ---- Documents ----
*.md
!SKILL.md
!CODE_OF_CONDUCT.md
!CONTRIBUTING.md
!docs/GETTING_STARTED.md
!docs/PLATFORMS.md
!docs/PROFILING.md
!docs/LLVM_DEFAULT_BACKEND.md
# AI-facing documentation and the MCP server that serves it
!docs/ai/AGENTS.md
!tools/mcp/README.md
# The native LLVM/LLD shim: why those six files are the one bit of C/C++
# that stays after the compiler finished self-hosting.
!std/llvm/native/README.md
!tools/mcp/claude-plugin/skills/salam-lang/SKILL.md
!tools/mcp/claude-plugin/commands/*.md
# ---- Online Editor ----
editor/*
!editor/page.salam
!editor/app.salam
!editor/anim.salam
!editor/anim_frames.salam
!editor/history.salam
!editor/assets/
editor/assets/*
!editor/assets/*.svg
!editor/assets/logo-box.png
!editor/build.sh
!editor/README.md
!editor/package.json
# ---- Generated Files ----
.salam-build/
# macOS
.DS_Store

# MyST build outputs
_build

/tests/**/*.html
/tests/**/*.js
/tests/**/*.css
/*.html
/_*
*.salam.bak
/benchmark/*_bin
/benchmark/results/chunk*.json
/kids/dist.html
/editor/index.html
*.db
*.bak
*.keystore
/docs/ai/stdlib-index.json

# UCD text files cached by the unicode table generator. Two paths because the
# generator was ported from Python to Salam and either can still be run.
/tools/python/.ucd-cache/
/tools/salam/.ucd-cache/
