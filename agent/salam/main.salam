const LOCK_JS := `(() => {
  if (window.__salamLocked) return;
  window.__salamLocked = true;

  const READABLE = ".msg-body, .bubble";
  const EDITABLE =
    "input, textarea, select, [contenteditable]:not([contenteditable='false'])";

  const style = document.createElement("style");
  style.textContent =
    "html, html * { -webkit-user-select: none; user-select: none; -webkit-user-drag: none; -webkit-touch-callout: none; }" +
    "html .msg-body, html .msg-body *, html .bubble, html .bubble *, html input, html textarea, html [contenteditable]:not([contenteditable='false']), html [contenteditable]:not([contenteditable='false']) * { -webkit-user-select: text; user-select: text; }" +
    "html img, html svg, html a { -webkit-user-drag: none; }";
  document.documentElement.appendChild(style);

  const element = (node) =>
    node && node.nodeType === 1 ? node : node && node.parentElement;
  const within = (node, selector) => {
    const el = element(node);
    return !!(el && el.closest && el.closest(selector));
  };

  const stop = (e) => {
    e.preventDefault();
    e.stopImmediatePropagation();
  };

  window.addEventListener("contextmenu", stop, true);
  window.addEventListener("dragstart", stop, true);
  window.addEventListener(
    "selectstart",
    (e) => {
      if (!within(e.target, READABLE) && !within(e.target, EDITABLE))
        e.preventDefault();
    },
    true,
  );

  const blocked = (e) => {
    const mod = e.ctrlKey || e.metaKey;
    const code = e.code;
    if (code === "F12" || code === "F5" || code === "F7") return true;
    if (
      e.altKey &&
      (code === "ArrowLeft" || code === "ArrowRight" || code === "Home")
    )
      return true;
    if (!mod) return false;
    if (code === "KeyA") return !within(e.target, EDITABLE);
    if (
      e.shiftKey &&
      (code === "KeyI" ||
        code === "KeyJ" ||
        code === "KeyC" ||
        code === "KeyK" ||
        code === "KeyR" ||
        code === "KeyP")
    )
      return true;
    if (
      e.altKey &&
      (code === "KeyI" || code === "KeyJ" || code === "KeyC" || code === "KeyU")
    )
      return true;
    return (
      code === "KeyU" ||
      code === "KeyS" ||
      code === "KeyP" ||
      code === "KeyR" ||
      code === "KeyG" ||
      code === "KeyO"
    );
  };

  window.addEventListener(
    "keydown",
    (e) => {
      if (blocked(e)) stop(e);
    },
    true,
  );

  window.addEventListener(
    "keyup",
    (e) => {
      if (e.code === "F12") stop(e);
    },
    true,
  );
})();
`
const APP_URL := "https://ai.salamlang.ir/"
const API_URL := "https://ai-api.salamlang.ir"
const AGENT_VERSION := "0.6.2"
const ANSWER_WAIT_MS := 540000
const MEMORY_DIR := ".salam-agent"
const MAX_SLUG := 60
const MAX_INSTRUCTIONS := 32768
const MAX_INDEX := 16384
const MEMORY_CUT := "[... cut, read the file for the rest ...]"
const REPEAT_GAP_MS := 4000
const SNIPPET_CHARS := 140
const TITLE_CHARS := 60
const OUTPUT_CAP := 30000
const MAX_READ := 10485760
const DEFAULT_LINES := 2000
const MAX_ENTRIES := 1000
const MAX_DIFF := 20000
const MAX_FILES := 500
const MAX_MATCHES := 300
const MAX_FILE_BYTES := 2097152
const OFFLINE_GRACE_MS := 20000
const WATCH_STEP_MS := 2000
const WATCH_LIMIT_MS := 7200000
const MAX_JOBS := 8
const WATCHDOG_CHECK_MS := 3000
const WATCHDOG_SILENCE_MS := 45000
const WATCHDOG_PROBE_MS := 15000
const WATCHDOG_RECOVER_GAP_MS := 120000

mut g_mu := sync.NewMutex()
mut g_cv := sync.NewCondVar()
mut g_ready := false
mut g_win := webview.Window {}
mut g_os_version := ""
mut g_device_id := ""
mut g_device_name := ""
mut g_secret := ""
mut g_connected := false
mut g_told_offline := false
mut g_flips := 0
mut g_poll_started := 0 as i64
mut g_modes := HashMap {} as HashMap<str, str>
mut g_always := HashMap {} as HashMap<str, bool>
mut g_pending := HashMap {} as HashMap<str, Pending*>
mut g_running := HashMap {} as HashMap<str, bool>
mut g_prefs := Prefs {}
mut g_recent := HashMap {} as HashMap<str, i64>
mut g_notified := HashMap {} as HashMap<i64, bool>
mut g_watchers := HashMap {} as HashMap<str, WatchJob*>
mut g_watch_seq := 0 as i64
mut g_last_beat := 0 as i64
mut g_armed := false
mut g_pong := false

struct Workspace:
    pub root: str = ""
    pub error: str = ""

    pub func resolve(rel: str, inside &: bool): str:
        clean := str.Trim(rel)
        mut joined := this.root
        if clean.len() > 0 and clean != ".":
            joined = is_absolute(clean) ? clean : filepath.Join(this.root, clean)
        end
        path := canonical_prefix(normalize_path(joined))
        inside = path_inside(path, this.root)
        ret path
    end

    pub func display(path: str): str:
        if path == this.root:
            ret "."
        end
        if path_inside(path, this.root):
            skip := str.Len(this.root) + (str.EndsWith(this.root, "/") or str.EndsWith(this.root, "\\") ? 0 : 1)
            ret str.Replace(str.Substr(path, skip, str.Len(path) - skip), "\\", "/")
        end
        ret path
    end
end

