{
  "$schema": "../gen/schemas/remote-schema.json",
  "identifier": "remote-agent",
  "description": "The Salam AI site may drive the local agent, and nothing else may.",
  "windows": ["main"],
  "remote": {
    "urls": ["https://ai.salamlang.ir/*"]
  },
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-agent-info",
    "allow-agent-link",
    "allow-agent-unlink",
    "allow-agent-pick-folder",
    "allow-agent-set-mode",
    "allow-agent-decide",
    "allow-agent-stop",
    "allow-agent-pending",
    "allow-agent-project-context",
    "allow-agent-path-status",
    "allow-agent-alive",
    "allow-agent-notify",
    "allow-agent-notify-prefs",
    "allow-agent-set-notify-prefs",
    "allow-agent-watch-reply",
    "allow-agent-unwatch-reply",
    "allow-agent-open-url",
    "allow-agent-pay",
    "allow-chatgpt-pick-export",
    "allow-chatgpt-import",
    "allow-ws-index-open",
    "allow-ws-index-close",
    "allow-ws-search",
    "allow-ws-mention-picked"
  ]
}
