package aiact

import str
import encoding.json
import encoding.value

const SITE := "https://www.salamlang.ir"
const SKILL_URL := "https://github.com/SalamLang/Salam/blob/main/SKILL.md"
const EN_DOCS := "https://salamlang.github.io/Salam"
const DETAIL_MAX := 120
const THOUGHT_MAX := 6000

mut REDACT := Vector {} as Vector<str>
mut STRICT := Vector {} as Vector<str>

func field(v: value.Value, key: str): value.Value:
    if not value.IsObject(v):
        ret value.ValueNull()
    end
    mut ok := false
    got := value.ObjectGetOk(v, key, ok)
    if not ok:
        ret value.ValueNull()
    end
    ret got
end

func text_of(v: value.Value, key: str): str:
    f := field(v, key)
    if value.IsString(f):
        ret value.AsString(f)
    end
    ret ""
end

func int_of(v: value.Value, key: str): i64:
    f := field(v, key)
    if value.IsNumber(f):
        ret value.AsInt(f)
    end
    ret 0
end

func head_bytes(s: str, max: int): str:
    if s.len() <= max:
        ret s
    end
    mut cut := max
    until cut > 0:
        b := s[cut] as int
        if b < 128 or b >= 192:
            break
        end
        cut--
    end
    ret s.substr(0, cut)
end

func clip(s: str, max: int): str:
    t := str.Trim(str.Replace(str.Replace(s, "\r", " "), "\n", " "))
    if t.len() <= max:
        ret t
    end
    mut b := str.NewBuilder()
    defer str.BufFree(b)
    mut used := 0
    each cp in str.CodePoints(t):
        w := cp < 128 ? 1 : (cp < 2048 ? 2 : (cp < 65536 ? 3 : 4))
        if used + w > max:
            break
        end
        str.BufAppendCp(b, cp)
        used += w
    end
    ret str.BufStr(b) + "…"
end

func fa_num(n: i64): str:
    ret str.ToPersianDigits("" + n)
end

func last_slash(s: str): int:
    mut at := -1
    mut i := 0
    until i < s.len():
        if s.substr(i, 1) == "/":
            at = i
        end
        i++
    end
    ret at
end

func rel_path(p: str): str:
    mut r := p
    if r == "/work" or str.EndsWith(r, "/work"):
        ret ""
    end
    i := str.Find(r, "/work/")
    if i >= 0:
        r = r.substr(i + 6, r.len() - i - 6)
    end
    ret str.TrimPrefix(r, "./")
end

func ascii_name(s: str): bool:
    each cp in str.CodePoints(s):
        if cp >= 128:
            ret false
        end
    end
    ret true
end

func std_package(rel: str): str:
    if not str.StartsWith(rel, "std/"):
        ret ""
    end
    rest := rel.substr(4, rel.len() - 4)
    cut := str.EndsWith(rest, ".salam") or str.EndsWith(rest, ".md") ? last_slash(rest) : rest.len()
    if cut <= 0:
        ret ""
    end
    ret str.Replace(rest.substr(0, cut), "/", ".")
end

func std_link(pkg: str): str:
    if pkg.len() == 0 or not ascii_name(pkg):
        ret SITE + "/std/"
    end
    ret SITE + "/std/" + str.Replace(pkg, ".", "-") + "/"
end

func source_name(rel: str, link &: str): str:
    if rel.len() == 0 or rel == "." or rel == "work":
        link = SITE + "/learn/"
        ret "همه‌ی مستندات سلام"
    end
    if str.Find(rel, "SKILL.md") >= 0:
        link = SKILL_URL
        ret "راهنمای کامل زبان سلام"
    end
    if str.Find(rel, "llms-fa") >= 0:
        link = SITE + "/learn/"
        ret "آموزش و مرجع فارسی سلام"
    end
    if str.Find(rel, "llms-en") >= 0:
        link = EN_DOCS + "/learn/"
        ret "آموزش و مرجع انگلیسی سلام"
    end
    pkg := std_package(rel)
    if pkg.len() > 0:
        link = std_link(pkg)
        ret "بسته‌ی " + pkg + " در کتابخانه‌ی استاندارد"
    end
    if str.StartsWith(rel, "std"):
        link = std_link("")
        ret "کتابخانه‌ی استاندارد سلام"
    end
    link = ""
    ret rel
end

func result_en(fa: str): str:
    if fa == "زمان اجرا تمام شد":
        ret "time limit reached"
    end
    if fa == "بدون خطا":
        ret "no errors"
    end
    if fa == "ناموفق":
        ret "failed"
    end
    if str.EndsWith(fa, " خطا پیدا شد"):
        ret str.ToEnglishDigits(str.TrimSuffix(fa, " خطا پیدا شد")) + " errors found"
    end
    if str.StartsWith(fa, "بدون خطا، "):
        ret "no errors, " + str.ToEnglishDigits(str.TrimSuffix(str.TrimPrefix(fa, "بدون خطا، "), " هشدار")) + " warnings"
    end
    ret str.ToEnglishDigits(fa)
end

func quoted_en(s: str): str:
    ret str.Replace(str.Replace(s, "«", "\""), "»", "\"")
end

func src_en(fa: str): str:
    if fa == "همه‌ی مستندات سلام":
        ret "all of the Salam docs"
    end
    if fa == "راهنمای کامل زبان سلام":
        ret "the full Salam language guide"
    end
    if fa == "آموزش و مرجع فارسی سلام":
        ret "the Persian Salam course and reference"
    end
    if fa == "آموزش و مرجع انگلیسی سلام":
        ret "the English Salam course and reference"
    end
    if fa == "کتابخانه‌ی استاندارد سلام":
        ret "the Salam standard library"
    end
    tail := " در کتابخانه‌ی استاندارد"
    if str.StartsWith(fa, "بسته‌ی ") and str.EndsWith(fa, tail):
        ret "the " + str.TrimSuffix(str.TrimPrefix(fa, "بسته‌ی "), tail) + " package of the standard library"
    end
    ret fa
end

func title_en(fa: str): str:
    if fa == "جست‌وجو در وب":
        ret "Searching the web"
    end
    if fa == "خواندن صفحه‌ی وب":
        ret "Reading a web page"
    end
    if str.StartsWith(fa, "جست‌وجو در مستندات سلام"):
        ret "Searching the Salam docs"
    end
    if str.StartsWith(fa, "جست‌وجو در "):
        ret "Searching " + src_en(str.TrimPrefix(fa, "جست‌وجو در "))
    end
    if str.StartsWith(fa, "مطالعه‌ی کد منبع "):
        ret "Reading the source of " + src_en(str.TrimPrefix(fa, "مطالعه‌ی کد منبع "))
    end
    if str.StartsWith(fa, "مطالعه‌ی "):
        ret "Reading " + src_en(str.TrimPrefix(fa, "مطالعه‌ی "))
    end
    if str.StartsWith(fa, "بررسی توابع بسته‌ی "):
