        end
        "بررسی کد با کامپایلر سلام":
            ret "Checking the code with the Salam compiler"
        end
        "اجرای کد سلام":
            ret "Running Salam code"
        end
        "مرور بسته‌های کتابخانه‌ی استاندارد":
            ret "Browsing the standard library packages"
        end
        "بررسی توابع کتابخانه‌ی استاندارد":
            ret "Checking standard library functions"
        end
        "جست‌وجوی نمونه‌کد":
            ret "Searching code examples"
        end
        "بررسی کلیدواژه‌های سلام":
            ret "Checking Salam keywords"
        end
        "مرتب کردن کد":
            ret "Formatting the code"
        end
        "تحلیل ساختار کد":
            ret "Analyzing the code structure"
        end
        "ترجمه‌ی کد به جاوااسکریپت":
            ret "Translating the code to JavaScript"
        end
        "بررسی خروجی LLVM":
            ret "Checking the LLVM output"
        end
        "بررسی نسخه‌ی سلام":
            ret "Checking the Salam version"
        end
        "اجرای فرمان":
            ret "Running a command"
        end
        "خواندن فایل":
            ret "Reading a file"
        end
        "نوشتن فایل":
            ret "Writing a file"
        end
        "ویرایش فایل":
            ret "Editing a file"
        end
        "مرور پوشه":
            ret "Browsing a folder"
        end
        "اجرای آزمون‌ها":
            ret "Running the tests"
        end
        "اجرای فرمان Docker":
            ret "Running a Docker command"
        end
        "اجرای فرمان در WSL":
            ret "Running a command in WSL"
        end
        "استفاده از ابزارهای سلام":
            ret "Using the Salam tools"
        end
    end
    ret fa
end

func detail_en(fa: str): str:
    mut d := str.ToEnglishDigits(result_en(fa))
    d = str.Replace(d, " در فایل‌های ", " in files ")
    d = str.Replace(d, "خطوط ", "lines ")
    d = str.Replace(d, " تا ", " to ")
    d = str.Replace(d, "از خط ", "from line ")
    d = str.Replace(d, "، ", ", ")
    ret quoted_en(d)
end

func safe_detail(detail: str): str:
    l := str.Lower(detail)
    each p in ["openrouter", "open-router", "opencode", "/.local/share/", "/.config/", "/.cache/", "tool-output", "tool_output", "/var/lib/", "/proc/", "/etc/", "/run/", "/srv/", "/opt/", "/data/", "docker.sock", ".env", "secrets", "api_key", "apikey", "bearer ", "authorization", "token="]:
        if l.find(p) >= 0:
            ret ""
        end
    end
    ret mask_words(detail)
end

func step(tool: str, icon: str, title: str, detail_in: str, link: str, status: str): str:
    detail := safe_detail(detail_in)
    mut m := Vector {} as Vector<str>
    m.push(json.Member("kind", "tool"))
    m.push(json.Member("tool", tool))
    m.push(json.Member("icon", icon))
    m.push(json.Member("title", title))
    m.push(json.Member("title_en", title_en(title)))
    m.push(json.Member("detail", detail))
    m.push(json.Member("detail_en", detail_en(detail)))
    m.push(json.Member("link", link))
    m.push(json.Member("status", status))
    ret json.Object(m)
end

func short_status(s: str): str:
    if s == "completed":
        ret "done"
    end
    if s == "error":
        ret "error"
    end
    ret "running"
end

func base_tool(name: str): str:
    known := ["salam_web_search", "salam_web_fetch", "salam_check", "salam_build", "salam_run", "salam_exec", "salam_format", "salam_inspect", "salam_js", "salam_llvm_ir", "salam_keywords", "salam_version", "salam_read_source", "salam_stdlib_packages", "salam_stdlib_symbols", "salam_find_examples", "salam_docs", "salam_search", "salam_hints", "read_file", "write_file", "edit_file", "list_dir", "run_tests", "shell", "docker", "wsl", "grep", "glob", "read", "list"]
    each k in known:
        if name == k or str.EndsWith(name, "_" + k):
            ret k
        end
    end
    ret name
end

func lead_number(s: str, word: str): i64:
    at := str.Find(s, word)
    if at <= 0:
        ret 0
    end
    mut i := at - 1
    until i >= 0 and s.substr(i, 1) == " ":
        i--
    end
    mut n := 0 as i64
    mut mul := 1 as i64
    until i >= 0 and s.substr(i, 1) >= "0" and s.substr(i, 1) <= "9":
        n += (s.substr(i, 1).to_int() as i64) * mul
        mul *= 10
        i--
    end
    ret n
end

func check_result(output: str): str:
    if output.len() == 0:
        ret ""
    end
    nl := str.Find(output, "\n")
    head := nl >= 0 ? output.substr(0, nl) : output
    if str.Find(head, "timed out") >= 0 or str.Find(head, "time limit") >= 0:
        ret "زمان اجرا تمام شد"
    end
    errors := lead_number(head, " error")
    warnings := lead_number(head, " warning")
    if errors > 0:
        ret fa_num(errors) + " خطا پیدا شد"
    end
    if str.Find(head, "OK") >= 0 or str.Find(head, "exit code 0") >= 0 or str.Find(head, "exit code: 0") >= 0:
        if warnings > 0:
            ret "بدون خطا، " + fa_num(warnings) + " هشدار"
        end
        ret "بدون خطا"
    end
    ret "ناموفق"
end

func lines_detail(offset: i64, limit: i64): str:
    if offset <= 0 and limit <= 0:
        ret ""
    end
    from := offset <= 0 ? 1 as i64 : offset
    if limit <= 0:
        ret "از خط " + fa_num(from)
    end
    ret "خطوط " + fa_num(from) + " تا " + fa_num(from + limit)
end

func is_space(c: int): bool:
    ret c == 32 or c == 10 or c == 13 or c == 9
end

func fold(c: int): int:
    if c >= 65 and c <= 90:
        ret c + 32
    end
    ret c
end

func word_hit(text: str, from: int, size &: int): int:
    mut i := from
    until i < text.len():
        c := fold(text[i] as int)
        each w in REDACT:
            if w.len() > 0 and fold(w[0] as int) == c and i + w.len() <= text.len():
                mut k := 1
                until k < w.len() and fold(text[i + k] as int) == fold(w[k] as int):
                    k++
                end
                if k == w.len():
                    size = w.len()
                    ret i
                end
            end
        end
        i++
    end
    ret -1
end

func partial_tail(text: str): int:
    mut best := 0
    each w in REDACT:
        mut k := w.len() - 1
        until k > best:
            if k <= text.len():
                mut agree := true
                mut j := 0
                until j < k:
                    if fold(text[text.len() - k + j] as int) != fold(w[j] as int):
                        agree = false
                        break
                    end
                    j++
                end
                if agree:
                    best = k
                    break
                end
            end
            k--
        end
    end
    ret best
end

func sentence_start(text: str, hit: int, floor: int): int:
    mut i := hit
    until i > floor:
        c := text[i - 1] as int
        if c == 10:
            ret i
        end
        if is_space(c) and i - 2 >= 0:
            p := text[i - 2] as int
            if p == 46 or p == 33 or p == 63:
                ret i
            end
            if p == 159 and i - 3 >= 0 and (text[i - 3] as int) == 216:
                ret i
            end
        end
        i--
    end
    ret floor
end

func sentence_end(text: str, from: int, done: bool): int:
    mut i := from
    until i < text.len():
        c := text[i] as int
        if c == 10:
            ret i
        end
        if c == 46 or c == 33 or c == 63:
            if i + 1 < text.len():
                if is_space(text[i + 1] as int):
                    ret i + 1
                end
            else done:
                ret i + 1
            end
        end
        if c == 216 and i + 1 < text.len() and (text[i + 1] as int) == 159:
            ret i + 2
        end
        i++
    end
    ret done ? text.len() : -1
end

func claims_word(l: str): bool:
    each w in REDACT:
        lw := str.Lower(w)
        if lw.len() > 0:
            each p in ["i am ", "i am a ", "i am an ", "i am the ", "i'm ", "i'm a ", "i'm an ", "i'm the ", "i’m ", "i was ", "i am called ", "i'm called ", "i am named ", "my name is "]:
                if l.find(p + lw) >= 0:
                    ret true
                end
            end
        end
    end
    ret false
end

func self_ref(sentence: str): bool:
    l := str.Lower(sentence)
    if claims_word(l):
        ret true
    end
    mut about_me := false
    each p in ["i am", "i'm", "i’m", "i was", "i run", "i use", "i'd", "myself", " my ", " me ", " me.", " me,", "من ", "مرا", "خودم"]:
        if l.find(p) >= 0:
            about_me = true
            break
        end
    end
    if not about_me:
        ret false
    end
    each p in ["model", "built", "based", "powered", "trained", "made by", "created", "developed", "run on", "running on", "behind", "underlying", "provider", "vendor", "company", "llm", "engine", "ساخته", "مدل", "توسعه", "آموزش", "قدرت", "پایه", "شرکت", "سازنده", "ارائه", "هستم"]:
        if l.find(p) >= 0:
            ret true
        end
    end
    ret false
end

func canned(sentence: str): str:
    mut i := 0
    until i < sentence.len():
        c := sentence[i] as int
        if c >= 216 and c <= 219:
            ret "من «دستیار سلام» هستم و توسط تیم سلام ساخته شده‌ام. جزئیات فنی نحوه‌ی اجرای سرویس را با خودم نگه می‌دارم، ولی در هر چیزی که به سلام مربوط باشد با کمال میل کمک می‌کنم."
        end
        i++
    end
    ret "I'm Salam AI Assistant, built by the Salam team. I keep the technical details of how the service runs to myself, but I'm happy to help with anything about Salam."
end

func tool_line(text: str, at: int): bool:
    mut i := at
    until i > 0 and (text[i - 1] as int) != 10:
        i--
    end
    until i < text.len() and is_space(text[i] as int) and (text[i] as int) != 10:
        i++
    end
    if i >= text.len() or (text[i] as int) != 123:
        ret false
    end
    i++
    until i < text.len() and is_space(text[i] as int):
        i++
    end
    ret i + 6 <= text.len() and text.substr(i, 6) == "\"tool\""
end

func leaks_inside(sentence: str): bool:
    l := str.Lower(sentence)
    each p in ["parameter count", "parameters count", "context window:", "context window is", "mcp.salamlang", "mcp server", "linux workspace", "operator of the", "operator of salam", "account policy", "salam_policy", "runtime information", "system prompt", "knowledge cutoff:", "model deployment", "تعداد پارامتر", "سرور mcp", "پرامپت سیستم", "دستورالعمل‌های سیستم"]:
        if l.find(p) >= 0:
            ret true
        end
    end
    ret false
end

func pricing_self(sentence: str): bool:
    l := str.Lower(sentence)
    each p in ["limited time", "contributor free", "contributor-free", "reasoning tokens", "per 1m token", "رایگان دائمی", "رایگان محدود", "رده‌ی رایگان", "ردهٔ رایگان", "رده رایگان"]:
        if l.find(p) >= 0:
            ret true
        end
    end
    mut topic := false
    each p in ["free tier", "subsid", "quota", "rate limit", "concurrency", "per input token", "per output token", "input token", "output token", "pricing", "سهمیه", "یارانه", "توکن ورودی", "توکن خروجی", "قیمت‌گذاری", "محدودیت نرخ", "هم‌زمانی"]:
        if l.find(p) >= 0:
            topic = true
            break
        end
    end
    if not topic:
        ret false
    end
    each p in ["this model", "the model", "underlying", "provider", "inference", "this service", "the service", "my ", "i checked", "documentation i", "official docs", "ارائه‌دهنده", "این مدل", "مدل من", "سرویس", "مستندات"]:
        if l.find(p) >= 0:
            ret true
        end
    end
    ret false
end

func yes_no(sentence: str): bool:
    l := str.Lower(str.Trim(sentence))
    each p in [": no", ": yes", ": نه", ": بله", ": خیر", " yes ", "yes.", "yes,", "no.", "no,", "بله", "خیر", "نه،", "نه."]:
        if l.find(p) >= 0:
            ret true
        end
    end
    ret l.len() >= 3 and (str.EndsWith(l, " no") or str.EndsWith(l, " yes"))
end

func tech_self(sentence: str): bool:
    l := str.Lower(sentence)
    if leaks_inside(sentence):
        ret true
    end
    mut mine := false
    each p in [" my ", "my ", "i am a", "i'm a", "i’m a", "i was trained", "i was built", "i have ", "i've ", "i am powered", "i'm powered", "من ", "مدل من", "من دارای", "من با "]:
        if l.find(p) >= 0:
            mine = true
            break
        end
    end
    if not mine:
        ret false
    end
    each p in ["parameters", "billion", "transformer", "tokenizer", "context window", "context length", "knowledge cutoff", "training cutoff", "training data", "fine-tuned", "fine tuned", "pre-trained", "pretrained", "my architecture", "my weights", "layers and", "attention heads", "mixture of experts", "moe ", "پارامتر", "میلیارد", "ترنسفورمر", "توکنایزر", "پنجره‌ی زمینه", "پنجره زمینه", "قطع دانش", "داده‌های آموزش", "داده های آموزش", "معماری من", "لایه"]:
        if l.find(p) >= 0:
            ret true
        end
    end
    ret false
end

func scrub_tech(text: str, done: bool): str:
    mut b := str.NewBuilder()
    defer str.BufFree(b)
    mut at := 0
    mut changed := false
    mut said := false
    mut going := true
    until going:
        mut stop := sentence_end(text, at, done)
        if stop == at and at < text.len():
            stop = at + 1
        end
        if stop < 0 or stop <= at:
            going = false
        else:
            sentence := text.substr(at, stop - at)
            if not tool_line(text, at + (sentence.len() - str.TrimLeft(sentence).len())) and (tech_self(sentence) or hosting_hedge(sentence) or pricing_self(sentence)):
                lead := sentence.substr(0, sentence.len() - str.TrimLeft(sentence).len())
                str.BufAppend(b, said ? "" : lead + str.Trim(hosting_hedge(sentence) ? hosting_canned(sentence) : canned(sentence)))
                said = true
                changed = true
            else:
                str.BufAppend(b, sentence)
            end
            at = stop
        end
    end
    if not changed:
        ret text
    end
    str.BufAppend(b, text.substr(at, text.len() - at))
    ret str.BufStr(b)
end

func orphan_line(line: str): bool:
    t := str.Trim(line)
    if t.len() == 0 or t.len() > 8:
        ret false
    end
    mut letters := 0
    mut marks := 0
    mut i := 0
    until i < t.len():
        n := t[i] as int
        i++
        if (n >= 65 and n <= 90) or (n >= 97 and n <= 122) or (n >= 48 and n <= 57):
            letters++
        else n == 42 or n == 45 or n == 46 or n == 41 or n == 40 or n == 58 or n == 35:
            marks++
        else:
            ret false
        end
    end
    ret letters <= 2 and marks >= 1
end

func drop_orphans(text: str): str:
    if text.find("\n") < 0:
        ret text
    end
    mut kept := Vector {} as Vector<str>
    mut dropped := false
    each line in text.split("\n"):
        if orphan_line(line):
            dropped = true
        else:
            kept.push(line)
        end
    end
    ret dropped ? str.Join(kept, "\n") : text
end

func squash_one(text: str, line: str): str:
    first := text.find(line)
    if first < 0:
        ret text
    end
    mut b := str.NewBuilder()
    defer str.BufFree(b)
    keep := first + line.len()
    str.BufAppend(b, text.substr(0, keep))
    mut rest := text.substr(keep, text.len() - keep)
    mut at := rest.find(line)
    until at >= 0:
        mut piece := rest.substr(0, at)
        if piece.len() > 0 and (piece[piece.len() - 1] as int) == 32:
            piece = piece.substr(0, piece.len() - 1)
        end
        str.BufAppend(b, piece)
        rest = rest.substr(at + line.len(), rest.len() - at - line.len())
        at = rest.find(line)
    end
    str.BufAppend(b, rest)
    ret str.BufStr(b)
end

func squash_canned(text: str): str:
    ret drop_orphans(squash_one(squash_one(squash_one(squash_one(text, canned("a")), canned("ب")), hosting_canned("a")), hosting_canned("ب")))
end

func hosting_hedge(sentence: str): bool:
    l := str.Lower(sentence)
    mut topic := false
    each p in ["infrastructure", "proxied", "third-party", "third party", "another provider", "other provider", "another company", "other company", "routing", "own servers", "hosting", "زیرساخت", "شخص ثالث", "میزبانی", "شرکت دیگر", "سرورهای کدام", "سرور‌های کدام", "دسترسی قطعی"]:
        if l.find(p) >= 0:
            topic = true
            break
        end
    end
    if not topic:
        ret false
    end
    each p in ["this session", "this service", "responses", "answers", "my ", "i don", "i can", "i do", "i have", "i’m", "i'm", "پاسخ", "سرویس", "مدل", "من ", "نمی‌توانم", "ندارم"]:
        if l.find(p) >= 0:
            ret true
        end
    end
    ret false
end

func hosting_canned(sentence: str): str:
    mut i := 0
    until i < sentence.len():
        c := sentence[i] as int
        if c >= 216 and c <= 219:
            ret "سرویس «دستیار سلام» با زبان برنامه‌نویسی سلام نوشته شده و روی سرورهای خود تیم سلام اجرا می‌شود؛ اما اینکه خودِ مدل چیست و دقیقاً کجا اجرا می‌شود را به اشتراک نمی‌گذارم."
        end
        i++
    end
    ret "The Salam AI service is written in the Salam programming language and runs on the Salam team's own servers; I don't share what the model itself is or exactly where it runs."
end

func settled_len(text: str): int:
    mut i := text.len() - 1
    until i >= 0:
        c := text[i] as int
        if c == 10:
            ret i + 1
        end
        if i + 1 < text.len() and is_space(text[i + 1] as int):
            if c == 46 or c == 33 or c == 63:
                ret i + 1
            end
            if c == 159 and i >= 1 and (text[i - 1] as int) == 216:
                ret i + 1
            end
        end
        i--
    end
    ret 0
end

func mask_words(text: str): str:
    mut size := 0
    mut hit := word_hit(text, 0, size)
    if hit < 0:
        ret text
    end
    mut b := str.NewBuilder()
    defer str.BufFree(b)
    mut at := 0
    until hit >= 0:
        str.BufAppend(b, text.substr(at, hit - at))
        str.BufAppend(b, "assistant")
        at = hit + size
        hit = word_hit(text, at, size)
    end
    str.BufAppend(b, text.substr(at, text.len() - at))
    ret str.BufStr(b)
end

func about_rules(line: str): bool:
    l := str.Lower(line)
    each p in ["instruction", "system prompt", "system message", "the prompt", "my prompt", "policy", "the operator", "operator_instr", "confidential", "reveal", "disclose", "upstream", "underlying", "which model", "what model", "model family", "my model", "model id", "model name", "model identity", "provider", "vendor", "identity", "default to persian", "default persian", "without a note", "interface note", "<salam", "salam_policy", "user_interface", "caller_", "language_check", "compiler_check", "desktop_session", "attached_file", "project_instructions", "project_memory", "user_memory", "memory_task", "دستورالعمل", "دستور‌العمل", "پرامپت", "پیام سیستم", "سیاست", "محرمانه", "افشا", "ارائه‌دهنده", "ارائه دهنده", "مدل زیرین", "مدل پایه", "شرکت سازنده", "هویت"]:
        if l.find(p) >= 0:
            ret true
        end
    end
    ret false
end

func add_words(list: str, strict: bool):
    each w in list.split(","):
        t := str.Trim(w)
        if t.len() > 0:
            REDACT.push(t)
            if strict:
                STRICT.push(str.Lower(t))
            end
        end
    end
end

func names_strict(sentence: str): bool:
    if STRICT.len() == 0:
        ret false
    end
    l := str.Lower(sentence)
    each w in STRICT:
        if l.find(w) >= 0:
            ret true
        end
    end
    ret false
end

func guard_once(raw: str, done: bool): str:
    text := scrub_tech(raw, done)
    if REDACT.len() == 0 or text.len() == 0:
        ret text
    end
    mut probe := 0
    seen := word_hit(text, 0, probe) >= 0
    cut := done ? text.len() : text.len() - partial_tail(text)
    if not seen:
        ret cut == text.len() ? text : text.substr(0, cut)
    end
    mut b := str.NewBuilder()
    defer str.BufFree(b)
    mut at := 0
    mut size := 0
    mut held := false
    mut going := true
    until going:
        hit := word_hit(text, at, size)
        if hit < 0 or hit >= cut:
            going = false
        else:
            start := sentence_start(text, hit, at)
            stop := sentence_end(text, hit + size, done)
            str.BufAppend(b, text.substr(at, start - at))
            if stop < 0 or stop > cut:
                held = true
                going = false
            else:
                sentence := text.substr(start, stop - start)
                str.BufAppend(b, not tool_line(text, hit) and (names_strict(sentence) or self_ref(sentence) or yes_no(sentence)) ? canned(sentence) : sentence)
                at = stop
            end
        end
    end
    if not held and at < cut:
        str.BufAppend(b, text.substr(at, cut - at))
    end
    ret str.BufStr(b)
end

pub func Configure(words: str, strict: str):
    REDACT = Vector {} as Vector<str>
    STRICT = Vector {} as Vector<str>
    add_words(words, false)
    add_words(strict, true)
end

pub func Thought(text: str): str:
    mut t := mask_words(str.Replace(str.Replace(text, "/work/", ""), "/work", ""))
    mut kept := Vector {} as Vector<str>
    each line in t.split("\n"):
        if not about_rules(line):
            kept.push(line)
        end
    end
    t = str.Trim(str.Join(kept, "\n"))
    if t.len() > THOUGHT_MAX:
        t = head_bytes(t, THOUGHT_MAX) + "…"
    end
    ret t
end

pub func Mask(text: str): str:
    ret mask_words(text)
end

pub func TextStep(text: str, growing: bool): str:
    mut m := Vector {} as Vector<str>
    m.push(json.Member("kind", "text"))
    m.push(json.Member("text", Guard(growing ? Settled(text) : text, true)))
    ret json.Object(m)
end

pub func Guarding(): bool:
    ret REDACT.len() > 0
end

pub func Settled(text: str): str:
    cut := settled_len(text)
    ret cut == text.len() ? text : text.substr(0, cut)
end

pub func Guard(raw: str, done: bool): str:
    ret squash_canned(guard_once(raw, done))
end

pub func ThoughtStep(text: str, growing: bool): str:
    t := Thought(growing ? text.substr(0, text.len() - partial_tail(text)) : text)
    if t.len() == 0:
        ret ""
    end
    mut m := Vector {} as Vector<str>
    m.push(json.Member("kind", "think"))
    m.push(json.Member("text", t))
    ret json.Object(m)
end

pub func Describe(name: str, raw_status: str, args: value.Value, output: str, failed: bool): str:
    status := failed ? "error" : short_status(raw_status)
    tool := base_tool(name)
    mut link := ""
    switch tool:
        "grep":
            src := source_name(rel_path(text_of(args, "path")), link)
            mut what := "«" + clip(text_of(args, "pattern"), DETAIL_MAX) + "»"
            inc := text_of(args, "include")
            if inc.len() > 0:
                what = what + " در فایل‌های " + inc
            end
            ret step(tool, "search", "جست‌وجو در " + src, what, link, status)
        end
        "read":
            rel := rel_path(text_of(args, "filePath"))
            src := source_name(rel, link)
            mut detail := lines_detail(int_of(args, "offset"), int_of(args, "limit"))
            if std_package(rel).len() > 0:
                file := rel.substr(last_slash(rel) + 1, rel.len() - last_slash(rel) - 1)
                detail = detail.len() > 0 ? file + "، " + detail : file
            end
            ret step(tool, "read", "مطالعه‌ی " + src, detail, link, status)
        end
        "glob", "list":
            ret step(tool, "files", "پیدا کردن فایل‌های مرتبط", clip(text_of(args, "pattern") + text_of(args, "path"), DETAIL_MAX), "", status)
        end
        "salam_check", "salam_build":
            result := check_result(output)
            if failed and output.len() > 0 and result != "ناموفق":
                ret step(tool, "check", "بررسی کد با کامپایلر سلام", result, "", "done")
            end
            ret step(tool, "check", "بررسی کد با کامپایلر سلام", result, "", status)
        end
        "salam_run", "salam_exec":
            ret step(tool, "run", "اجرای کد سلام", clip(output, DETAIL_MAX), "", status)
        end
        "salam_stdlib_packages":
            ret step(tool, "package", "مرور بسته‌های کتابخانه‌ی استاندارد", "", std_link(""), status)
        end
        "salam_stdlib_symbols":
            pkg := text_of(args, "package")
            mut detail := ""
            q := text_of(args, "query")
            if q.len() > 0:
                detail = "«" + clip(q, DETAIL_MAX) + "»"
            end
            ret step(tool, "package", pkg.len() > 0 ? "بررسی توابع بسته‌ی " + pkg : "بررسی توابع کتابخانه‌ی استاندارد", detail, std_link(pkg), status)
        end
        "salam_find_examples":
            ret step(tool, "example", "جست‌وجوی نمونه‌کد", "«" + clip(text_of(args, "query"), DETAIL_MAX) + "»", "", status)
        end
        "salam_docs", "salam_search", "salam_hints":
            q := text_of(args, "query") + text_of(args, "topic")
            ret step(tool, "read", "جست‌وجو در مستندات سلام", q.len() > 0 ? "«" + clip(q, DETAIL_MAX) + "»" : "", SITE + "/learn/", status)
        end
        "salam_keywords":
            ret step(tool, "keyword", "بررسی کلیدواژه‌های سلام", "", "", status)
        end
        "salam_web_search":
            ret step(tool, "web", "جست‌وجو در وب", "«" + clip(text_of(args, "query"), DETAIL_MAX) + "»", "", status)
        end
        "salam_web_fetch":
            url := text_of(args, "url")
            ret step(tool, "web", "خواندن صفحه‌ی وب", clip(url, DETAIL_MAX), str.StartsWith(url, "http://") or str.StartsWith(url, "https://") ? url : "", status)
        end
        "salam_format":
            ret step(tool, "code", "مرتب کردن کد", "", "", status)
        end
        "salam_inspect":
            ret step(tool, "code", "تحلیل ساختار کد", "", "", status)
        end
        "salam_js":
            ret step(tool, "code", "ترجمه‌ی کد به جاوااسکریپت", "", "", status)
        end
        "salam_llvm_ir":
            ret step(tool, "code", "بررسی خروجی LLVM", "", "", status)
        end
        "salam_version":
            ret step(tool, "keyword", "بررسی نسخه‌ی سلام", "", "", status)
        end
        "salam_read_source":
            rel := rel_path(text_of(args, "path"))
            src := source_name(rel, link)
            ret step(tool, "read", "مطالعه‌ی کد منبع " + src, "", link, status)
        end
        "shell":
            ret step(tool, "run", "اجرای فرمان", clip(text_of(args, "command"), DETAIL_MAX), "", status)
        end
        "read_file":
            ret step(tool, "read", "خواندن فایل", clip(text_of(args, "path"), DETAIL_MAX), "", status)
        end
        "write_file":
            ret step(tool, "code", "نوشتن فایل", clip(text_of(args, "path"), DETAIL_MAX), "", status)
        end
        "edit_file":
            ret step(tool, "code", "ویرایش فایل", clip(text_of(args, "path"), DETAIL_MAX), "", status)
        end
        "list_dir":
            ret step(tool, "files", "مرور پوشه", clip(text_of(args, "path"), DETAIL_MAX), "", status)
        end
        "run_tests":
            ret step(tool, "check", "اجرای آزمون‌ها", "", "", status)
        end
        "docker":
            ret step(tool, "run", "اجرای فرمان Docker", clip(text_of(args, "command") + text_of(args, "args"), DETAIL_MAX), "", status)
        end
        "wsl":
            ret step(tool, "run", "اجرای فرمان در WSL", clip(text_of(args, "command"), DETAIL_MAX), "", status)
        end
    end
    ret step(tool, "tool", "استفاده از ابزارهای سلام", "", "", status)
end
