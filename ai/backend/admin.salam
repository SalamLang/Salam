func admin_keys_json(where: str, args: Vector<str>): str:
    mut items := Vector {} as Vector<str>
    aistore.Lock()
    mut rows := aistore.Stmt("SELECT k.id, k.name, k.prefix, k.created, k.last_used, k.revoked, (SELECT COUNT(*) FROM api_requests r WHERE r.key_id = k.id), k.salam_prompt, k.salam_tools, COALESCE(k.system_prompt, ''), k.policy_at, k.policy_by, u.id, u.name, u.email FROM api_keys k JOIN users u ON u.id = k.user_id WHERE " + where + " ORDER BY k.id DESC LIMIT 50", args)
    until aistore.Next(rows):
        mut u := Vector {} as Vector<str>
        u.Push(json.MemberRaw("id", aistore.Text(rows, 12)))
        u.Push(json.Member("name", aistore.Text(rows, 13)))
        u.Push(json.Member("email", aistore.Text(rows, 14)))
        mut m := Vector {} as Vector<str>
        m.Push(json.MemberRaw("id", aistore.Text(rows, 0)))
        m.Push(json.Member("name", aistore.Text(rows, 1)))
        m.Push(json.Member("prefix", aistore.Text(rows, 2)))
        m.Push(json.MemberRaw("created", aistore.Text(rows, 3)))
        m.Push(json.MemberRaw("last_used", aistore.Text(rows, 4)))
        m.Push(json.MemberBool("revoked", aistore.Text(rows, 5) != "0"))
        m.Push(json.MemberRaw("requests", aistore.Text(rows, 6)))
        m.Push(json.MemberBool("salam_prompt", aistore.Text(rows, 7) != "0"))
        m.Push(json.MemberBool("salam_tools", aistore.Text(rows, 8) != "0"))
        m.Push(json.Member("system_prompt", aistore.Text(rows, 9)))
        m.Push(json.MemberRaw("policy_at", aistore.Text(rows, 10)))
        m.Push(json.MemberRaw("policy_by", aistore.Text(rows, 11)))
        m.Push(json.MemberRaw("user", json.Object(u)))
        items.Push(json.Object(m))
    end
    aistore.Finish(rows)
    aistore.Unlock()
    ret json.Array(items)
end

func admin_list_keys(ctx: i64):
    if aiweb.NeedAdmin(ctx) == 0:
        ret
    end
    mut before := http.Query(ctx, "before").ToInt() as i64
    if before <= 0:
        before = 9223372036854775807
    end
    mut where := "k.id < ?1"
    mut args := one(n(before))
    user := http.Query(ctx, "user")
    if user.Len() > 0:
        args.Push(user)
        where = where + " AND k.user_id = ?" + args.Len()
    end
    if http.Query(ctx, "custom") == "1":
        where += " AND (k.salam_prompt = 0 OR k.salam_tools = 0 OR COALESCE(k.system_prompt, '') <> '')"
    end
    if http.Query(ctx, "active") == "1":
        where += " AND k.revoked = 0"
    end
    mut m := Vector {} as Vector<str>
    m.Push(json.MemberRaw("keys", admin_keys_json(where, args)))
    m.Push(json.MemberBool("plain_ready", aiengine.PlainReady()))
    aiweb.Reply(ctx, 200, json.Object(m))
end

func admin_update_key(ctx: i64):
    admin := aiweb.NeedAdmin(ctx)
    if admin == 0:
        ret
    end
    id := http.Param(ctx, "id")
    body := http.Body(ctx)
    aistore.Lock()
    found := aistore.OneText("SELECT id FROM api_keys WHERE id = ?1", one(id))
    aistore.Unlock()
    if found.Len() == 0:
        aiweb.Fail(ctx, 404, "not_found", "این کلید پیدا نشد.")
        ret
    end
    mut sets := Vector {} as Vector<str>
    mut args := one(id)
    each name in ["salam_prompt", "salam_tools"]:
        v := json.Get(body, name)
        if v == "true" or v == "false":
            args.Push(v == "true" ? "1" : "0")
            sets.Push(name + " = ?" + args.Len())
        else v.Len() > 0:
            aiweb.Fail(ctx, 400, "invalid", name + " باید true یا false باشد.")
            ret
        end
    end
    if body.Find(`"system_prompt"`) >= 0:
        mut text := json.Get(body, "system_prompt")
        if text == "null":
            text = ""
        end
        text = str.Trim(text)
        if text.Len() > MAX_SYSTEM_PROMPT:
            aiweb.Fail(ctx, 400, "too_long", "پرامپت سیستمی حداکثر ۲۵۶ کیلوبایت است.")
            ret
        end
        args.Push(text)
        sets.Push("system_prompt = ?" + args.Len())
    end
    if sets.Len() == 0:
        aiweb.Fail(ctx, 400, "empty", "چیزی برای تغییر فرستاده نشد.")
        ret
    end
    args.Push(n(admin))
    sets.Push("policy_by = ?" + args.Len())
    args.Push(n(aistore.Now()))
    sets.Push("policy_at = ?" + args.Len())
    aistore.Lock()
    ok := aistore.Run("UPDATE api_keys SET " + str.Join(sets, ", ") + " WHERE id = ?1", args)
    aistore.Unlock()
    if not ok:
        aiweb.Fail(ctx, 500, "server", "ذخیره ناموفق بود. دوباره تلاش کنید.")
        ret
    end
    aiweb.Reply(ctx, 200, `{"key": ` + str.TrimSuffix(str.TrimPrefix(admin_keys_json("k.id = ?1", one(id)), "["), "]") + "}")
end

func stat(m &: Vector<str>, key: str, sql: str, args: Vector<str>):
    m.Push(json.MemberRaw(key, count(sql, args)))
end

func user_profile(ctx: i64):
    if aiweb.NeedAdmin(ctx) == 0:
        ret
    end
    id := str.Trim(http.Param(ctx, "id"))
    now := n(aistore.Now())
    both := two(id, now)
    mut m := Vector {} as Vector<str>
    aistore.Lock()
    mut rows := aistore.Stmt("SELECT id, name, email, created FROM users WHERE id = ?1", one(id))
    if not aistore.Next(rows):
        aistore.Finish(rows)
        aistore.Unlock()
        aiweb.Fail(ctx, 404, "user", "این کاربر پیدا نشد.")
        ret
    end
    m.Push(json.MemberRaw("id", aistore.Text(rows, 0)))
    m.Push(json.Member("name", aistore.Text(rows, 1)))
    m.Push(json.Member("email", aistore.Text(rows, 2)))
    m.Push(json.MemberRaw("created", aistore.Text(rows, 3)))
    aistore.Finish(rows)
    mut sub := aistore.Stmt("SELECT s.plan, COALESCE(p.name, s.plan), s.source, s.started, s.expires FROM subscriptions s LEFT JOIN plans p ON p.id = s.plan WHERE s.user_id = ?1 AND s.status = 'active' AND (s.expires = 0 OR s.expires > ?2) ORDER BY s.id DESC LIMIT 1", both)
    mut plan := Vector {} as Vector<str>
    if aistore.Next(sub):
        plan.Push(json.Member("id", aistore.Text(sub, 0)))
        plan.Push(json.Member("name", aistore.Text(sub, 1)))
        plan.Push(json.Member("source", aistore.Text(sub, 2)))
        plan.Push(json.MemberRaw("started", aistore.Text(sub, 3)))
        plan.Push(json.MemberRaw("expires", aistore.Text(sub, 4)))
    else:
        plan.Push(json.Member("id", "free"))
        plan.Push(json.Member("name", ""))
        plan.Push(json.Member("source", "free"))
        plan.Push(json.MemberRaw("started", "0"))
        plan.Push(json.MemberRaw("expires", "0"))
    end
    aistore.Finish(sub)
    m.Push(json.MemberRaw("plan", json.Object(plan)))
    mut c := Vector {} as Vector<str>
    stat(c, "chats", "SELECT COUNT(*) FROM chats WHERE user_id = ?1", both)
    stat(c, "messages", "SELECT COUNT(*) FROM messages m JOIN chats c ON c.id = m.chat_id WHERE c.user_id = ?1 AND m.role = 'user'", both)
    stat(c, "telegram_chats", "SELECT COUNT(*) FROM chats WHERE user_id = ?1 AND source = 'telegram'", both)
    stat(c, "agent_chats", "SELECT COUNT(*) FROM chats WHERE user_id = ?1 AND device_id != 0", both)
    stat(c, "last_chat", "SELECT COALESCE(MAX(updated), 0) FROM chats WHERE user_id = ?1", both)
    stat(c, "sessions", "SELECT COUNT(*) FROM sessions WHERE user_id = ?1 AND expires > ?2", both)
    stat(c, "logins", "SELECT COUNT(*) FROM sessions WHERE user_id = ?1", both)
    stat(c, "last_login", "SELECT COALESCE(MAX(created), 0) FROM sessions WHERE user_id = ?1", both)
    stat(c, "last_seen", "SELECT COALESCE(MAX(last_used), 0) FROM sessions WHERE user_id = ?1", both)
    stat(c, "keys", "SELECT COUNT(*) FROM api_keys WHERE user_id = ?1 AND revoked = 0", both)
    stat(c, "keys_revoked", "SELECT COUNT(*) FROM api_keys WHERE user_id = ?1 AND revoked <> 0", both)
    stat(c, "api_requests", "SELECT COUNT(*) FROM api_requests WHERE user_id = ?1", both)
    stat(c, "api_requests_24h", "SELECT COUNT(*) FROM api_requests WHERE user_id = ?1 AND created > ?2 - 86400", both)
    stat(c, "api_tokens_in", "SELECT COALESCE(SUM(tokens_in), 0) FROM api_requests WHERE user_id = ?1", both)
    stat(c, "api_tokens_out", "SELECT COALESCE(SUM(tokens_out), 0) FROM api_requests WHERE user_id = ?1", both)
    stat(c, "chat_tokens_in", "SELECT COALESCE(SUM(m.tokens_in), 0) FROM messages m JOIN chats c ON c.id = m.chat_id WHERE c.user_id = ?1", both)
    stat(c, "chat_tokens_out", "SELECT COALESCE(SUM(m.tokens_out), 0) FROM messages m JOIN chats c ON c.id = m.chat_id WHERE c.user_id = ?1", both)
    stat(c, "mcp_calls", "SELECT COUNT(*) FROM mcp_events WHERE user_id = ?1", both)
    stat(c, "mcp_last", "SELECT COALESCE(MAX(created), 0) FROM mcp_events WHERE user_id = ?1", both)
    stat(c, "apps", "SELECT COUNT(*) FROM oauth_grants WHERE user_id = ?1 AND revoked = 0", both)
    stat(c, "telegram_links", "SELECT COUNT(*) FROM telegram_links WHERE user_id = ?1", both)
    stat(c, "files", "SELECT COUNT(*) FROM message_files WHERE user_id = ?1", both)
    stat(c, "memories", "SELECT COUNT(*) FROM memories WHERE user_id = ?1", both)
    stat(c, "devices", "SELECT COUNT(*) FROM bridge_devices WHERE user_id = ?1 AND revoked = 0", both)
    stat(c, "projects", "SELECT COUNT(*) FROM projects WHERE user_id = ?1", both)
    stat(c, "shares", "SELECT COUNT(*) FROM shares WHERE user_id = ?1", both)
    stat(c, "subscriptions", "SELECT COUNT(*) FROM subscriptions WHERE user_id = ?1", both)
    stat(c, "payments_paid", "SELECT COUNT(*) FROM payments WHERE user_id = ?1 AND status = 'paid'", both)
    stat(c, "payments_failed", "SELECT COUNT(*) FROM payments WHERE user_id = ?1 AND status <> 'paid' AND status <> 'pending'", both)
    stat(c, "payments_pending", "SELECT COUNT(*) FROM payments WHERE user_id = ?1 AND status = 'pending'", both)
    stat(c, "payments_attempts", "SELECT COUNT(*) FROM payments WHERE user_id = ?1", both)
    stat(c, "paid_total", "SELECT COALESCE(SUM(amount), 0) FROM payments WHERE user_id = ?1 AND status = 'paid'", both)
    stat(c, "last_payment", "SELECT COALESCE(MAX(created), 0) FROM payments WHERE user_id = ?1", both)
    m.Push(json.MemberRaw("counts", json.Object(c)))
    mut ids := Vector {} as Vector<str>
    mut irows := aistore.Stmt("SELECT provider, login, email, created FROM identities WHERE user_id = ?1 ORDER BY created", one(id))
    until aistore.Next(irows):
        mut x := Vector {} as Vector<str>
        x.Push(json.Member("provider", aistore.Text(irows, 0)))
        x.Push(json.Member("login", aistore.Text(irows, 1)))
        x.Push(json.Member("email", aistore.Text(irows, 2)))
        x.Push(json.MemberRaw("created", aistore.Text(irows, 3)))
        ids.Push(json.Object(x))
    end
    aistore.Finish(irows)
    m.Push(json.MemberRaw("identities", json.Array(ids)))
    mut ints := Vector {} as Vector<str>
    mut nrows := aistore.Stmt("SELECT provider, login FROM integrations WHERE user_id = ?1 ORDER BY provider", one(id))
    until aistore.Next(nrows):
        mut x := Vector {} as Vector<str>
        x.Push(json.Member("provider", aistore.Text(nrows, 0)))
        x.Push(json.Member("login", aistore.Text(nrows, 1)))
        ints.Push(json.Object(x))
    end
    aistore.Finish(nrows)
    m.Push(json.MemberRaw("integrations", json.Array(ints)))
    mut tgs := Vector {} as Vector<str>
    mut trows := aistore.Stmt("SELECT tg_id, name, username, lang, created, last_seen FROM telegram_links WHERE user_id = ?1 ORDER BY created", one(id))
    until aistore.Next(trows):
        mut x := Vector {} as Vector<str>
        x.Push(json.Member("tg_id", aistore.Text(trows, 0)))
        x.Push(json.Member("name", aistore.Text(trows, 1)))
        x.Push(json.Member("username", aistore.Text(trows, 2)))
        x.Push(json.Member("lang", aistore.Text(trows, 3)))
        x.Push(json.MemberRaw("created", aistore.Text(trows, 4)))
        x.Push(json.MemberRaw("last_seen", aistore.Text(trows, 5)))
        tgs.Push(json.Object(x))
    end
    aistore.Finish(trows)
    m.Push(json.MemberRaw("telegram", json.Array(tgs)))
    aistore.Unlock()
    aiweb.Reply(ctx, 200, json.Object(m))
end

func admin_user_policy(ctx: i64):
    admin := aiweb.NeedAdmin(ctx)
    if admin == 0:
        ret
    end
    id := http.Param(ctx, "id")
    body := http.Body(ctx)
    aistore.Lock()
    found := aistore.OneText("SELECT id FROM users WHERE id = ?1", one(id))
    aistore.Unlock()
    if found.Len() == 0:
        aiweb.Fail(ctx, 404, "not_found", "این کاربر پیدا نشد.")
        ret
    end
    mut sets := Vector {} as Vector<str>
    mut args := one(id)
    if body.Find(`"policy_system"`) >= 0:
        mut text := json.Get(body, "policy_system")
        if text == "null":
            text = ""
        end
        text = str.Trim(text)
        if text.Len() > MAX_SYSTEM_PROMPT:
            aiweb.Fail(ctx, 400, "too_long", "پرامپت سیستمی حداکثر ۲۵۶ کیلوبایت است.")
            ret
        end
        args.Push(text)
        sets.Push("policy_system = ?" + args.Len())
    end
    if sets.Len() == 0:
        aiweb.Fail(ctx, 400, "empty", "چیزی برای تغییر فرستاده نشد.")
        ret
    end
    args.Push(n(admin))
    sets.Push("policy_by = ?" + args.Len())
    args.Push(n(aistore.Now()))
    sets.Push("policy_at = ?" + args.Len())
    aistore.Lock()
    ok := aistore.Run("UPDATE users SET " + str.Join(sets, ", ") + " WHERE id = ?1", args)
    aistore.Unlock()
    if not ok:
        aiweb.Fail(ctx, 500, "server", "ذخیره ناموفق بود. دوباره تلاش کنید.")
        ret
    end
    mut m := Vector {} as Vector<str>
    m.Push(json.MemberRaw("id", id))
    m.Push(json.Member("policy_system", aiweb.OperatorText(id)))
    aiweb.Reply(ctx, 200, `{"user": ` + json.Object(m) + "}")
end

func admin_telegram(ctx: i64):
    if aiweb.NeedAdmin(ctx) == 0:
        ret
    end
    now := aistore.Now()
    mut links := Vector {} as Vector<str>
    mut guests := Vector {} as Vector<str>
    aistore.Lock()
    mut rows := aistore.Stmt("SELECT t.tg_id, t.name, t.username, t.lang, t.created, t.last_seen, u.id, u.name, u.email, (SELECT COUNT(*) FROM chats c WHERE c.user_id = u.id AND c.source = 'telegram'), (SELECT COUNT(*) FROM messages m JOIN chats c ON c.id = m.chat_id WHERE c.user_id = u.id AND c.source = 'telegram' AND m.role = 'user'), (SELECT COUNT(*) FROM messages m JOIN chats c ON c.id = m.chat_id WHERE c.user_id = u.id AND c.source = 'telegram' AND m.status = 'pending'), t.chat_id FROM telegram_links t JOIN users u ON u.id = t.user_id ORDER BY t.last_seen DESC, t.created DESC LIMIT 200", Vector {} as Vector<str>)
    until aistore.Next(rows):
        mut u := Vector {} as Vector<str>
        u.Push(json.MemberRaw("id", aistore.Text(rows, 6)))
        u.Push(json.Member("name", aistore.Text(rows, 7)))
        u.Push(json.Member("email", aistore.Text(rows, 8)))
        mut m := Vector {} as Vector<str>
        m.Push(json.Member("tg_id", aistore.Text(rows, 0)))
        m.Push(json.Member("name", aistore.Text(rows, 1)))
        m.Push(json.Member("username", aistore.Text(rows, 2)))
        m.Push(json.Member("lang", aistore.Text(rows, 3)))
        m.Push(json.MemberRaw("created", aistore.Text(rows, 4)))
        m.Push(json.MemberRaw("last_seen", aistore.Text(rows, 5)))
        m.Push(json.MemberRaw("user", json.Object(u)))
        m.Push(json.MemberRaw("chats", aistore.Text(rows, 9)))
        m.Push(json.MemberRaw("messages", aistore.Text(rows, 10)))
        m.Push(json.MemberBool("answering", aistore.Text(rows, 11) != "0"))
        m.Push(json.Member("chat_id", aistore.Text(rows, 12)))
        links.Push(json.Object(m))
    end
    aistore.Finish(rows)
    mut grows := aistore.Stmt("SELECT g.tg_id, g.name, g.username, g.lang, g.created, g.last_seen, s.id, s.messages, (SELECT COUNT(*) FROM guest_messages gm WHERE gm.guest_id = s.id AND gm.status = 'pending') FROM telegram_guests g JOIN guest_sessions s ON s.id = g.guest_id ORDER BY g.last_seen DESC, g.created DESC LIMIT 200", Vector {} as Vector<str>)
    until aistore.Next(grows):
        mut m := Vector {} as Vector<str>
        m.Push(json.Member("tg_id", aistore.Text(grows, 0)))
        m.Push(json.Member("name", aistore.Text(grows, 1)))
        m.Push(json.Member("username", aistore.Text(grows, 2)))
        m.Push(json.Member("lang", aistore.Text(grows, 3)))
        m.Push(json.MemberRaw("created", aistore.Text(grows, 4)))
        m.Push(json.MemberRaw("last_seen", aistore.Text(grows, 5)))
        m.Push(json.MemberRaw("guest_id", aistore.Text(grows, 6)))
        m.Push(json.MemberRaw("messages", aistore.Text(grows, 7)))
        m.Push(json.MemberBool("answering", aistore.Text(grows, 8) != "0"))
        guests.Push(json.Object(m))
    end
    aistore.Finish(grows)
    online_links := aistore.OneText("SELECT COUNT(*) FROM telegram_links WHERE last_seen > ?1", one(n(now - 300)))
    online_guests := aistore.OneText("SELECT COUNT(*) FROM telegram_guests WHERE last_seen > ?1", one(n(now - 300)))
    aistore.Unlock()
    mut out := Vector {} as Vector<str>
    out.Push(json.MemberRaw("links", json.Array(links)))
    out.Push(json.MemberRaw("guests", json.Array(guests)))
    out.Push(json.MemberRaw("online_links", online_links))
    out.Push(json.MemberRaw("online_guests", online_guests))
    out.Push(json.MemberInt("now", now))
    aiweb.Reply(ctx, 200, json.Object(out))
end

func revoke_app(ctx: i64):
    if aiweb.NeedAdmin(ctx) == 0:
        ret
    end
    aioauth.RevokeGrant(http.Param(ctx, "id"))
    aiweb.Reply(ctx, 200, `{"ok": true}`)
end

pub func Routes(r &: router.Router):
    router.Get(r, "/admin/summary", summary)
    router.Get(r, "/admin/users", list_users)
    router.Get(r, "/admin/users/:id/chats", list_user_chats)
    router.Get(r, "/admin/users/:id/profile", user_profile)
    router.Get(r, "/admin/chats", list_latest_chats)
    router.Get(r, "/admin/chats/:id", get_admin_chat)
    router.Get(r, "/admin/messages/:id/trace", get_trace)
    router.Get(r, "/admin/chats/:id/files/:fid", get_admin_file)
    router.Get(r, "/admin/guests", list_guests)
    router.Get(r, "/admin/guests/:id", get_guest)
    router.Get(r, "/admin/sessions", list_sessions)
    router.Get(r, "/admin/platforms", platforms)
    router.Get(r, "/admin/models", models)
    router.Delete(r, "/admin/sessions/:id", revoke_session)
    router.Delete(r, "/admin/users/:id/sessions", revoke_user_sessions)
    router.Get(r, "/admin/files", list_files)
    router.Get(r, "/admin/files/:id", download_file)
    router.Get(r, "/admin/events", list_events)
    router.Get(r, "/admin/apps", admin_list_apps)
    router.Delete(r, "/admin/apps/:id", revoke_app)
    router.Get(r, "/admin/requests", list_requests)
    router.Get(r, "/admin/keys", admin_list_keys)
    router.Patch(r, "/admin/keys/:id", admin_update_key)
    router.Patch(r, "/admin/users/:id/policy", admin_user_policy)
    router.Get(r, "/admin/telegram", admin_telegram)
    each path in ["/admin/summary", "/admin/users", "/admin/users/:id/chats", "/admin/users/:id/profile", "/admin/chats", "/admin/chats/:id", "/admin/messages/:id/trace", "/admin/chats/:id/files/:fid", "/admin/files", "/admin/files/:id", "/admin/guests", "/admin/guests/:id", "/admin/sessions", "/admin/platforms", "/admin/sessions/:id", "/admin/users/:id/sessions", "/admin/events", "/admin/apps", "/admin/apps/:id", "/admin/requests", "/admin/keys", "/admin/keys/:id", "/admin/users/:id/policy", "/admin/telegram"]:
        router.Options(r, path, aiweb.Preflight)
    end
end
