func device_json(client: str, ua: str, os: str, os_version: str, arch: str, hints: str, stored: str): str:
    mut h := aiua.HintsFrom(hints)
    h.client = client
    h.os = os
    h.os_version = os_version
    h.arch = arch
    info := aiua.Resolve(stored, ua, h)
    mut m := Vector {} as Vector<str>
    m.Push(json.Member("os", info.os))
    m.Push(json.Member("os_ver", info.os_ver))
    m.Push(json.Member("os_label", aiua.OsLabel(info)))
    m.Push(json.Member("distro", info.distro))
    m.Push(json.Member("build", info.build))
    m.Push(json.Member("kind", info.kind))
    m.Push(json.Member("model", info.model))
    m.Push(json.Member("browser", info.browser))
    m.Push(json.Member("browser_ver", info.browser_ver))
    m.Push(json.Member("browser_label", aiua.BrowserLabel(info)))
    m.Push(json.Member("engine", info.engine))
    m.Push(json.Member("arch", info.arch))
    m.Push(json.MemberBool("tool", info.tool))
    m.Push(json.MemberBool("webview", info.webview))
    ret json.Object(m)
end

func list_sessions(ctx: i64):
    if aiweb.NeedAdmin(ctx) == 0:
        ret
    end
    mut offset := http.Query(ctx, "offset").ToInt()
    if offset < 0:
        offset = 0
    end
    user := http.Query(ctx, "user").ToInt()
    client := http.Query(ctx, "client")
    mine := aiweb.Hash(aiweb.Bearer(ctx))
    mut where := "s.expires > ?1"
    if user > 0:
        where += " AND s.user_id = ?2"
    end
    if client == "web" or client == "agent":
        where += " AND s.client = ?3"
    end
    mut a := Vector {} as Vector<str>
    a.Push(n(aistore.Now()))
    a.Push(n(user as i64))
    a.Push(client)
    a.Push(mine)
    mut items := Vector {} as Vector<str>
    aistore.Lock()
    total := count("SELECT COUNT(*) FROM sessions s WHERE " + where, a)
    mut rows := aistore.Stmt("SELECT s.id, s.created, s.last_used, s.expires, s.ip, s.agent, s.client, s.client_version, s.token = ?4, u.id, u.name, u.email, s.os, s.os_version, s.arch, s.hints, s.device FROM sessions s JOIN users u ON u.id = s.user_id WHERE " + where + " ORDER BY GREATEST(s.last_used, s.created) DESC LIMIT 50 OFFSET " + n(offset as i64), a)
    until aistore.Next(rows):
        mut m := Vector {} as Vector<str>
        m.Push(json.MemberRaw("id", aistore.Text(rows, 0)))
        m.Push(json.MemberRaw("created", aistore.Text(rows, 1)))
        m.Push(json.MemberRaw("last_used", aistore.Text(rows, 2)))
        m.Push(json.MemberRaw("expires", aistore.Text(rows, 3)))
        m.Push(json.Member("ip", aistore.Text(rows, 4)))
        m.Push(json.Member("agent", aistore.Text(rows, 5)))
        m.Push(json.Member("client", aistore.Text(rows, 6)))
        m.Push(json.Member("client_version", aistore.Text(rows, 7)))
        m.Push(json.MemberBool("current", aistore.Text(rows, 8) == "1"))
        m.Push(json.Member("os", aistore.Text(rows, 12)))
        m.Push(json.Member("os_version", aistore.Text(rows, 13)))
        m.Push(json.Member("arch", aistore.Text(rows, 14)))
        m.Push(json.MemberRaw("device", device_json(aistore.Text(rows, 6), aistore.Text(rows, 5), aistore.Text(rows, 12), aistore.Text(rows, 13), aistore.Text(rows, 14), aistore.Text(rows, 15), aistore.Text(rows, 16))))
        mut um := Vector {} as Vector<str>
        um.Push(json.MemberRaw("id", aistore.Text(rows, 9)))
        um.Push(json.Member("name", aistore.Text(rows, 10)))
        um.Push(json.Member("email", aistore.Text(rows, 11)))
        m.Push(json.MemberRaw("user", json.Object(um)))
        items.Push(json.Object(m))
    end
    aistore.Finish(rows)
    aistore.Unlock()
    aiweb.Reply(ctx, 200, `{"sessions": ` + json.Array(items) + `, "total": ` + total + "}")
end

func platform_item(id: str, total: str): str:
    mut m := Vector {} as Vector<str>
    m.Push(json.Member("id", id))
    m.Push(json.MemberRaw("count", total))
    ret json.Object(m)
end

func platforms(ctx: i64):
    if aiweb.NeedAdmin(ctx) == 0:
        ret
    end
    mut days := http.Query(ctx, "days").ToInt()
    if days < 0 or days > 3650:
        days = 0
    end
    cutoff := days == 0 ? 0 as i64 : aistore.Now() - (days as i64) * 86400
    since := one(n(cutoff))
    mut seen := HashMap {} as HashMap<str, str>
    aistore.Lock()
    mut rows := aistore.Stmt("SELECT IF(client = 'agent' AND os != '', os, 'unknown'), COUNT(*) FROM sessions WHERE GREATEST(last_used, created) >= ?1 GROUP BY 1", since)
    until aistore.Next(rows):
        seen.Put(aistore.Text(rows, 0), aistore.Text(rows, 1))
    end
    aistore.Finish(rows)
    site := count("SELECT COUNT(*) FROM guest_sessions g WHERE g.updated >= ?1 AND g.id NOT IN (SELECT guest_id FROM telegram_guests)", since)
    linked := count("SELECT COUNT(*) FROM telegram_links WHERE GREATEST(last_seen, created) >= ?1", since)
    guests := count("SELECT COUNT(*) FROM telegram_guests WHERE GREATEST(last_seen, created) >= ?1", since)
    mut systems := Vector {} as Vector<str>
    mut srows := aistore.Stmt("SELECT os, os_version, arch, COUNT(*) FROM sessions WHERE client = 'agent' AND os != '' AND GREATEST(last_used, created) >= ?1 GROUP BY os, os_version, arch ORDER BY COUNT(*) DESC, os, os_version LIMIT 30", since)
    until aistore.Next(srows):
        mut m := Vector {} as Vector<str>
        m.Push(json.Member("os", aistore.Text(srows, 0)))
        m.Push(json.Member("version", aistore.Text(srows, 1)))
        m.Push(json.Member("arch", aistore.Text(srows, 2)))
        m.Push(json.MemberRaw("count", aistore.Text(srows, 3)))
        systems.Push(json.Object(m))
    end
    aistore.Finish(srows)
    aistore.Unlock()
    mut items := Vector {} as Vector<str>
    mut total := 0 as i64
    each id in ["windows", "macos", "linux", "other"]:
        c := seen.Has(id) ? seen.Get(id).ToInt() as i64 : 0 as i64
        items.Push(platform_item(id, n(c)))
        total += c
    end
    tg := linked.ToInt() as i64 + guests.ToInt() as i64
    unknown := (seen.Has("unknown") ? seen.Get("unknown").ToInt() as i64 : 0 as i64) + site.ToInt() as i64
    items.Push(platform_item("telegram", n(tg)))
    items.Push(platform_item("unknown", n(unknown)))
    total += tg + unknown
    mut out := Vector {} as Vector<str>
    out.Push(json.MemberRaw("days", n(days as i64)))
    out.Push(json.MemberRaw("total", n(total)))
    out.Push(json.MemberRaw("platforms", json.Array(items)))
    out.Push(json.MemberRaw("systems", json.Array(systems)))
    aiweb.Reply(ctx, 200, json.Object(out))
end

