func platforms(ctx: i64):
    if aiweb.NeedAdmin(ctx) == 0:
        ret
    end
    mut days := http.Query(ctx, "days").to_int()
    if days < 0 or days > 3650:
        days = 0
    end
    cutoff := days == 0 ? 0 as i64 : aistore.Now() - (days as i64) * 86400
    since := one(n(cutoff))
    mut seen := HashMap {} as HashMap<str, str>
    aistore.Lock()
    mut rows := aistore.Stmt("SELECT IF(client = 'agent' AND os != '', os, 'unknown'), COUNT(*) FROM sessions WHERE GREATEST(last_used, created) >= ?1 GROUP BY 1", since)
    until aistore.Next(rows):
        seen.put(aistore.Text(rows, 0), aistore.Text(rows, 1))
    end
    aistore.Finish(rows)
    site := count("SELECT COUNT(*) FROM guest_sessions g WHERE g.updated >= ?1 AND g.id NOT IN (SELECT guest_id FROM telegram_guests)", since)
    linked := count("SELECT COUNT(*) FROM telegram_links WHERE GREATEST(last_seen, created) >= ?1", since)
    guests := count("SELECT COUNT(*) FROM telegram_guests WHERE GREATEST(last_seen, created) >= ?1", since)
    mut systems := Vector {} as Vector<str>
    mut srows := aistore.Stmt("SELECT os, os_version, arch, COUNT(*) FROM sessions WHERE client = 'agent' AND os != '' AND GREATEST(last_used, created) >= ?1 GROUP BY os, os_version, arch ORDER BY COUNT(*) DESC, os, os_version LIMIT 30", since)
    until aistore.Next(srows):
        mut m := Vector {} as Vector<str>
        m.push(json.Member("os", aistore.Text(srows, 0)))
        m.push(json.Member("version", aistore.Text(srows, 1)))
        m.push(json.Member("arch", aistore.Text(srows, 2)))
        m.push(json.MemberRaw("count", aistore.Text(srows, 3)))
        systems.push(json.Object(m))
    end
    aistore.Finish(srows)
    aistore.Unlock()
    mut items := Vector {} as Vector<str>
    mut total := 0 as i64
    each id in ["windows", "macos", "linux", "other"]:
        c := seen.has(id) ? seen.get(id).to_int() as i64 : 0 as i64
        items.push(platform_item(id, n(c)))
        total += c
    end
    tg := linked.to_int() as i64 + guests.to_int() as i64
    unknown := (seen.has("unknown") ? seen.get("unknown").to_int() as i64 : 0 as i64) + site.to_int() as i64
    items.push(platform_item("telegram", n(tg)))
    items.push(platform_item("unknown", n(unknown)))
    total += tg + unknown
    mut out := Vector {} as Vector<str>
    out.push(json.MemberRaw("days", n(days as i64)))
    out.push(json.MemberRaw("total", n(total)))
    out.push(json.MemberRaw("platforms", json.Array(items)))
    out.push(json.MemberRaw("systems", json.Array(systems)))
    aiweb.Reply(ctx, 200, json.Object(out))
end

func revoke_session(ctx: i64):
    if aiweb.NeedAdmin(ctx) == 0:
        ret
    end
    id := http.Param(ctx, "id")
    mine := aiweb.Hash(aiweb.Bearer(ctx))
    aistore.Lock()
    own := count("SELECT COUNT(*) FROM sessions WHERE id = ?1 AND token = ?2", two(id, mine))
    gone := own == "0" and aistore.Run("DELETE FROM sessions WHERE id = ?1", one(id))
    aistore.Unlock()
    if own != "0":
        aiweb.Fail(ctx, 400, "self", "نشست فعلی خودتان را از اینجا نمی‌توانید ببندید؛ از حساب خارج شوید.")
        ret
    end
    aiweb.Reply(ctx, 200, `{"ok": ` + (gone ? "true" : "false") + "}")
end

func revoke_user_sessions(ctx: i64):
