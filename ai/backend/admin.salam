    uid := http.Param(ctx, "id")
    mine := aiweb.Hash(aiweb.Bearer(ctx))
    aistore.Lock()
    before := count("SELECT COUNT(*) FROM sessions WHERE user_id = ?1 AND token != ?2", two(uid, mine))
    _d := aistore.Run("DELETE FROM sessions WHERE user_id = ?1 AND token != ?2", two(uid, mine))
    aistore.Unlock()
    aiweb.Reply(ctx, 200, `{"revoked": ` + before + "}")
end

