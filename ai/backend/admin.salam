func list_sessions(ctx: i64):
    if aiweb.NeedAdmin(ctx) == 0:
        ret
    end
    mut offset := http.Query(ctx, "offset").to_int()
    if offset < 0:
        offset = 0
    end
    user := http.Query(ctx, "user").to_int()
    client := http.Query(ctx, "client")
    mine := aiweb.Hash(aiweb.Bearer(ctx))
    mut where := "s.expires > ?1"
    if user > 0:
        where = where + " AND s.user_id = ?2"
    end
    if client == "web" or client == "agent":
        where = where + " AND s.client = ?3"
    end
    mut a := Vector {} as Vector<str>
    a.push(n(aistore.Now()))
    a.push(n(user as i64))
    a.push(client)
    a.push(mine)
    mut items := Vector {} as Vector<str>
    aistore.Lock()
    total := count("SELECT COUNT(*) FROM sessions s WHERE " + where, a)
    mut rows := aistore.Stmt("SELECT s.id, s.created, s.last_used, s.expires, s.ip, s.agent, s.client, s.client_version, s.token = ?4, u.id, u.name, u.email, s.os, s.os_version, s.arch FROM sessions s JOIN users u ON u.id = s.user_id WHERE " + where + " ORDER BY GREATEST(s.last_used, s.created) DESC LIMIT 50 OFFSET " + n(offset as i64), a)
    until aistore.Next(rows):
        mut m := Vector {} as Vector<str>
        m.push(json.MemberRaw("id", aistore.Text(rows, 0)))
        m.push(json.MemberRaw("created", aistore.Text(rows, 1)))
        m.push(json.MemberRaw("last_used", aistore.Text(rows, 2)))
        m.push(json.MemberRaw("expires", aistore.Text(rows, 3)))
        m.push(json.Member("ip", aistore.Text(rows, 4)))
        m.push(json.Member("agent", aistore.Text(rows, 5)))
        m.push(json.Member("client", aistore.Text(rows, 6)))
        m.push(json.Member("client_version", aistore.Text(rows, 7)))
        m.push(json.MemberBool("current", aistore.Text(rows, 8) == "1"))
        m.push(json.Member("os", aistore.Text(rows, 12)))
        m.push(json.Member("os_version", aistore.Text(rows, 13)))
        m.push(json.Member("arch", aistore.Text(rows, 14)))
        mut um := Vector {} as Vector<str>
        um.push(json.MemberRaw("id", aistore.Text(rows, 9)))
        um.push(json.Member("name", aistore.Text(rows, 10)))
        um.push(json.Member("email", aistore.Text(rows, 11)))
        m.push(json.MemberRaw("user", json.Object(um)))
        items.push(json.Object(m))
    end
    aistore.Finish(rows)
    aistore.Unlock()
    aiweb.Reply(ctx, 200, `{"sessions": ` + json.Array(items) + `, "total": ` + total + "}")
end

