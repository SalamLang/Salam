package aiadmin

import net.http
import net.router
import encoding.json
import str
import calendar

include aistore "store.salam"
include aiweb "web.salam"
include aiua "ua.salam"
include aioauth "oauth.salam"
include aiopenai "openai.salam"
include aiturn "turn.salam"
include aiengine "engine.salam"
include aifiles "files.salam"
include ailangfuse "langfuse.salam"

const TEHRAN := 12600
const MAX_SYSTEM_PROMPT := 262144
const EPOCH_JDN := 2440588

func n(v: i64): str:
    ret aiweb.I64s(v)
end

func one(v: str): Vector<str>:
    mut a := Vector {} as Vector<str>
    a.Push(v)
    ret a
end

func two(v: str, w: str): Vector<str>:
    mut a := one(v)
    a.Push(w)
    ret a
end

func count(sql: str, args: Vector<str>): str:
    v := aistore.OneText(sql, args)
    if v.Len() == 0:
        ret "0"
    end
    ret v
end

func local_day(t: i64): i64:
    ret (t + TEHRAN) / 86400
end

func day_start(day: i64): i64:
    ret day * 86400 - TEHRAN
end

func jalali_month_start(year: int, month: int): i64:
    jdn := calendar.JalaliToJDN(calendar.JalaliDate { year = year, month = month, day = 1 })
    ret day_start(jdn - EPOCH_JDN)
end

func usage_of(table: str, filter: str, from: i64, upto: i64): str:
    a := two(n(from), n(upto))
    mut rows := aistore.Stmt("SELECT COUNT(*), COALESCE(SUM(tokens_in), 0), COALESCE(SUM(tokens_out), 0), COALESCE(SUM(tokens_reasoning), 0), COALESCE(SUM(cache_read), 0), COALESCE(SUM(cache_write), 0), COALESCE(SUM(cost), 0), COALESCE(SUM(cost_in), 0), COALESCE(SUM(cost_out), 0) FROM " + table + " WHERE created >= ?1 AND created < ?2" + filter, a)
    mut m := Vector {} as Vector<str>
    if aistore.Next(rows):
        m.Push(json.MemberRaw("count", aistore.Text(rows, 0)))
        m.Push(json.MemberRaw("input", aistore.Text(rows, 1)))
        m.Push(json.MemberRaw("output", aistore.Text(rows, 2)))
        m.Push(json.MemberRaw("reasoning", aistore.Text(rows, 3)))
        m.Push(json.MemberRaw("cache_read", aistore.Text(rows, 4)))
        m.Push(json.MemberRaw("cache_write", aistore.Text(rows, 5)))
        m.Push(json.MemberRaw("cost", aistore.Text(rows, 6)))
        m.Push(json.MemberRaw("cost_in", aistore.Text(rows, 7)))
        m.Push(json.MemberRaw("cost_out", aistore.Text(rows, 8)))
    end
    aistore.Finish(rows)
    ret json.Object(m)
end

func period(key: str, from: i64, upto: i64): str:
    mut m := Vector {} as Vector<str>
    m.Push(json.Member("key", key))
    m.Push(json.MemberInt("from", from))
    m.Push(json.MemberInt("to", upto))
    m.Push(json.MemberRaw("chat", usage_of("messages", " AND role = 'assistant'", from, upto)))
    m.Push(json.MemberRaw("api", usage_of("api_requests", "", from, upto)))
    ret json.Object(m)
end

func usage_periods(t: i64): str:
    today := local_day(t)
    start := day_start(today)
    week := start - ((today + 5) % 7) * 86400
    j := calendar.JDNToJalali(today + EPOCH_JDN)
    month := jalali_month_start(j.year, j.month)
    mut py := j.year
    mut pm := j.month - 1
    if pm == 0:
        pm = 12
        py--
    end
    last := jalali_month_start(py, pm)
    future := t + 86400
    mut items := Vector {} as Vector<str>
    items.Push(period("today", start, future))
    items.Push(period("week", week, future))
    items.Push(period("month", month, future))
    items.Push(period("last_month", last, month))
    items.Push(period("all", 0, future))
    ret json.Array(items)
end

func ranking(sql: str, args: Vector<str>, label: str): str:
    mut items := Vector {} as Vector<str>
    mut rows := aistore.Stmt(sql, args)
    until aistore.Next(rows):
        mut m := Vector {} as Vector<str>
        m.Push(json.Member(label, aistore.Text(rows, 0)))
        m.Push(json.MemberRaw("count", aistore.Text(rows, 1)))
        items.Push(json.Object(m))
    end
    aistore.Finish(rows)
    ret json.Array(items)
end

func summary(ctx: i64):
    if aiweb.NeedAdmin(ctx) == 0:
        ret
    end
    t := aistore.Now()
    day := n(t - 86400)
    week := n(t - 7 * 86400)
    since := n((t / 86400 - 13) * 86400)
    none := Vector {} as Vector<str>
    mut m := Vector {} as Vector<str>
    aistore.Lock()
    m.Push(json.MemberRaw("users", count("SELECT COUNT(*) FROM users", none)))
    m.Push(json.MemberRaw("users_7d", count("SELECT COUNT(DISTINCT user_id) FROM (SELECT user_id FROM sessions WHERE expires > ?1 UNION SELECT user_id FROM mcp_events WHERE created > ?2 UNION SELECT c.user_id FROM chats c WHERE c.updated > ?2) a", two(n(t + 23 * 86400), week))))
    m.Push(json.MemberRaw("chats", count("SELECT COUNT(*) FROM chats", none)))
    m.Push(json.MemberRaw("messages", count("SELECT COUNT(*) FROM messages WHERE role = 'user'", none)))
    m.Push(json.MemberRaw("uploads", count("SELECT COUNT(*) FROM message_files", none)))
    m.Push(json.MemberRaw("uploads_images", count("SELECT COUNT(*) FROM message_files WHERE kind = 'image'", none)))
    m.Push(json.MemberRaw("uploads_bytes", count("SELECT COALESCE(SUM(size), 0) FROM message_files", none)))
    m.Push(json.MemberRaw("guests", count("SELECT COUNT(*) FROM guest_sessions", none)))
    m.Push(json.MemberRaw("guest_messages", count("SELECT COUNT(*) FROM guest_messages WHERE role = 'user'", none)))
    m.Push(json.MemberRaw("guests_at_limit", count("SELECT COUNT(*) FROM guest_sessions WHERE messages >= 15", none)))
    m.Push(json.MemberRaw("apps", count("SELECT COUNT(*) FROM oauth_grants WHERE revoked = 0", none)))
    m.Push(json.MemberRaw("mcp_calls", count("SELECT COUNT(*) FROM mcp_events", none)))
    m.Push(json.MemberRaw("mcp_calls_24h", count("SELECT COUNT(*) FROM mcp_events WHERE created > ?1", one(day))))
    m.Push(json.MemberRaw("mcp_errors_24h", count("SELECT COUNT(*) FROM mcp_events WHERE created > ?1 AND ok = 0", one(day))))
    m.Push(json.MemberRaw("top_tools", ranking("SELECT tool, COUNT(*) AS n FROM mcp_events WHERE tool <> '' GROUP BY tool ORDER BY n DESC LIMIT 10", none, "tool")))
    m.Push(json.MemberRaw("usage", usage_periods(t)))
    m.Push(json.MemberRaw("api_requests", count("SELECT COUNT(*) FROM api_requests", none)))
    m.Push(json.MemberRaw("api_requests_24h", count("SELECT COUNT(*) FROM api_requests WHERE created > ?1", one(day))))
    m.Push(json.MemberRaw("api_errors_24h", count("SELECT COUNT(*) FROM api_requests WHERE created > ?1 AND status = 'error'", one(day))))
    m.Push(json.MemberRaw("top_projects", ranking("SELECT project, COUNT(*) AS n FROM api_requests WHERE project <> '' GROUP BY project ORDER BY n DESC LIMIT 10", none, "name")))
    m.Push(json.MemberRaw("top_clients", ranking("SELECT COALESCE(c.name, e.client_id), COUNT(*) AS n FROM mcp_events e LEFT JOIN oauth_clients c ON c.id = e.client_id GROUP BY COALESCE(c.name, e.client_id) ORDER BY n DESC LIMIT 10", none, "name")))
    mut days := Vector {} as Vector<str>
    mut rows := aistore.Stmt("SELECT FROM_UNIXTIME(created - MOD(created, 86400), '%Y-%m-%d') AS d, COUNT(*), COUNT(DISTINCT user_id) FROM mcp_events WHERE created >= ?1 GROUP BY d ORDER BY d", one(since))
    mut found := HashMap {} as HashMap<str, str>
    until aistore.Next(rows):
        found.Put(aistore.Text(rows, 0), aistore.Text(rows, 1) + "|" + aistore.Text(rows, 2))
    end
    aistore.Finish(rows)
    mut api_rows := aistore.Stmt("SELECT FROM_UNIXTIME(created - MOD(created, 86400), '%Y-%m-%d') AS d, COUNT(*) FROM api_requests WHERE created >= ?1 GROUP BY d", one(since))
    mut api_days := HashMap {} as HashMap<str, str>
    until aistore.Next(api_rows):
        api_days.Put(aistore.Text(api_rows, 0), aistore.Text(api_rows, 1))
    end
    aistore.Finish(api_rows)
    mut tok_rows := aistore.Stmt("SELECT d, SUM(i), SUM(o), SUM(c) FROM (SELECT FROM_UNIXTIME(created - MOD(created, 86400), '%Y-%m-%d') AS d, tokens_in + cache_read + cache_write AS i, tokens_out + tokens_reasoning AS o, cache_read + cache_write AS c FROM messages WHERE role = 'assistant' AND created >= ?1 UNION ALL SELECT FROM_UNIXTIME(created - MOD(created, 86400), '%Y-%m-%d'), tokens_in + cache_read + cache_write, tokens_out + tokens_reasoning, cache_read + cache_write FROM api_requests WHERE created >= ?1) x GROUP BY d", one(since))
    mut tok_days := HashMap {} as HashMap<str, str>
    until aistore.Next(tok_rows):
        tok_days.Put(aistore.Text(tok_rows, 0), aistore.Text(tok_rows, 1) + "|" + aistore.Text(tok_rows, 2) + "|" + aistore.Text(tok_rows, 3))
    end
    aistore.Finish(tok_rows)
    aistore.Unlock()
    mut i := 0
    until i < 14:
        stamp := (t / 86400 - 13 + i) * 86400
        label := day_label(stamp)
        mut calls := "0"
        mut users := "0"
        if found.Has(label):
            v := found.Get(label)
            bar := v.Find("|")
            calls = v.Substr(0, bar)
            users = v.Substr(bar + 1, v.Len() - bar - 1)
        end
        mut d := Vector {} as Vector<str>
        d.Push(json.Member("day", label))
        d.Push(json.MemberRaw("calls", calls))
        d.Push(json.MemberRaw("users", users))
        d.Push(json.MemberRaw("api", api_days.Has(label) ? api_days.Get(label) : "0"))
        mut tin := "0"
        mut tout := "0"
        mut tcache := "0"
        if tok_days.Has(label):
            tv := tok_days.Get(label)
            tb := tv.Find("|")
            tin = tv.Substr(0, tb)
            trest := tv.Substr(tb + 1, tv.Len() - tb - 1)
            tb2 := trest.Find("|")
            tout = trest.Substr(0, tb2)
            tcache = trest.Substr(tb2 + 1, trest.Len() - tb2 - 1)
        end
        d.Push(json.MemberRaw("tokens_in", tin))
        d.Push(json.MemberRaw("tokens_out", tout))
        d.Push(json.MemberRaw("tokens_cache", tcache))
        days.Push(json.Object(d))
        i++
    end
    m.Push(json.MemberRaw("daily", json.Array(days)))
    aiweb.Reply(ctx, 200, json.Object(m))
end

func day_label(stamp: i64): str:
    aistore.Lock()
    v := aistore.OneText("SELECT FROM_UNIXTIME(?1 - MOD(?1, 86400), '%Y-%m-%d')", one(n(stamp)))
    aistore.Unlock()
    ret v
end

func list_users(ctx: i64):
    if aiweb.NeedAdmin(ctx) == 0:
        ret
    end
    q := str.Trim(http.Query(ctx, "q"))
    mut offset := http.Query(ctx, "offset").ToInt()
    if offset < 0:
        offset = 0
    end
    like := "%" + str.Replace(str.Replace(q, "%", ""), "_", "") + "%"
    mut items := Vector {} as Vector<str>
    aistore.Lock()
    total := count("SELECT COUNT(*) FROM users WHERE name LIKE ?1 OR email LIKE ?1", one(like))
    mut rows := aistore.Stmt("SELECT u.id, u.name, u.email, u.created, (SELECT COUNT(*) FROM chats c WHERE c.user_id = u.id), (SELECT COUNT(*) FROM messages m JOIN chats c ON c.id = m.chat_id WHERE c.user_id = u.id AND m.role = 'user'), (SELECT COUNT(*) FROM oauth_grants g WHERE g.user_id = u.id AND g.revoked = 0), (SELECT COUNT(*) FROM mcp_events e WHERE e.user_id = u.id), COALESCE((SELECT MAX(updated) FROM chats c WHERE c.user_id = u.id), 0), GREATEST(COALESCE((SELECT MAX(updated) FROM chats c WHERE c.user_id = u.id AND c.device_id != 0), 0), COALESCE((SELECT MAX(created) FROM mcp_events e WHERE e.user_id = u.id), 0)), COALESCE((SELECT MAX(created) FROM api_requests r WHERE r.user_id = u.id), 0), (SELECT COUNT(*) FROM api_requests r WHERE r.user_id = u.id), (SELECT COALESCE(SUM(m.tokens_in + m.cache_read + m.cache_write), 0) FROM messages m JOIN chats c ON c.id = m.chat_id WHERE c.user_id = u.id) + (SELECT COALESCE(SUM(r.tokens_in + r.cache_read + r.cache_write), 0) FROM api_requests r WHERE r.user_id = u.id), (SELECT COALESCE(SUM(m.tokens_out), 0) FROM messages m JOIN chats c ON c.id = m.chat_id WHERE c.user_id = u.id) + (SELECT COALESCE(SUM(r.tokens_out), 0) FROM api_requests r WHERE r.user_id = u.id), u.last_login, u.logins, (SELECT COUNT(*) FROM message_files f WHERE f.user_id = u.id AND f.kind = 'image'), (SELECT COUNT(*) FROM message_files f WHERE f.user_id = u.id), (SELECT COUNT(*) FROM sessions s WHERE s.user_id = u.id AND s.expires > UNIX_TIMESTAMP()), COALESCE((SELECT s.client_version FROM sessions s WHERE s.user_id = u.id AND s.client = 'agent' AND s.client_version != '' ORDER BY s.last_used DESC LIMIT 1), ''), (SELECT COALESCE(SUM(m.cost_in), 0) FROM messages m JOIN chats c ON c.id = m.chat_id WHERE c.user_id = u.id) + (SELECT COALESCE(SUM(r.cost_in), 0) FROM api_requests r WHERE r.user_id = u.id), (SELECT COALESCE(SUM(m.cost_out), 0) FROM messages m JOIN chats c ON c.id = m.chat_id WHERE c.user_id = u.id) + (SELECT COALESCE(SUM(r.cost_out), 0) FROM api_requests r WHERE r.user_id = u.id), u.policy_free, COALESCE(u.policy_system, ''), (SELECT COUNT(*) FROM telegram_links t WHERE t.user_id = u.id), (SELECT COALESCE(SUM(m.cache_read + m.cache_write), 0) FROM messages m JOIN chats c ON c.id = m.chat_id WHERE c.user_id = u.id) + (SELECT COALESCE(SUM(r.cache_read + r.cache_write), 0) FROM api_requests r WHERE r.user_id = u.id) FROM users u WHERE u.name LIKE ?1 OR u.email LIKE ?1 ORDER BY u.id DESC LIMIT 50 OFFSET " + n(offset as i64), one(like))
    until aistore.Next(rows):
        mut m := Vector {} as Vector<str>
        m.Push(json.MemberRaw("id", aistore.Text(rows, 0)))
        m.Push(json.Member("name", aistore.Text(rows, 1)))
        m.Push(json.Member("email", aistore.Text(rows, 2)))
        m.Push(json.MemberRaw("created", aistore.Text(rows, 3)))
        m.Push(json.MemberRaw("chats", aistore.Text(rows, 4)))
        m.Push(json.MemberRaw("messages", aistore.Text(rows, 5)))
        m.Push(json.MemberRaw("apps", aistore.Text(rows, 6)))
        m.Push(json.MemberRaw("mcp_calls", aistore.Text(rows, 7)))
        m.Push(json.MemberRaw("last_active_chat", aistore.Text(rows, 8)))
        m.Push(json.MemberRaw("last_active_agent", aistore.Text(rows, 9)))
        m.Push(json.MemberRaw("last_active_api", aistore.Text(rows, 10)))
        m.Push(json.MemberRaw("api_requests", aistore.Text(rows, 11)))
        m.Push(json.MemberRaw("tokens_in", aistore.Text(rows, 12)))
        m.Push(json.MemberRaw("tokens_out", aistore.Text(rows, 13)))
        m.Push(json.MemberRaw("last_login", aistore.Text(rows, 14)))
        m.Push(json.MemberRaw("logins", aistore.Text(rows, 15)))
        m.Push(json.MemberRaw("images", aistore.Text(rows, 16)))
        m.Push(json.MemberRaw("files", aistore.Text(rows, 17)))
        m.Push(json.MemberRaw("sessions", aistore.Text(rows, 18)))
        m.Push(json.Member("agent_version", aistore.Text(rows, 19)))
        m.Push(json.MemberRaw("cost_in", aistore.Text(rows, 20)))
        m.Push(json.MemberRaw("cost_out", aistore.Text(rows, 21)))
        m.Push(json.Member("policy_system", aistore.Text(rows, 23)))
        m.Push(json.MemberRaw("telegram", aistore.Text(rows, 24)))
        m.Push(json.MemberRaw("tokens_cache", aistore.Text(rows, 25)))
        items.Push(json.Object(m))
    end
    aistore.Finish(rows)
    aistore.Unlock()
    aiweb.Reply(ctx, 200, `{"users": ` + json.Array(items) + `, "total": ` + total + `, "plain_ready": ` + (aiengine.PlainReady() ? "true" : "false") + `, "desktop_plain_ready": ` + (aiengine.PlainDesktopReady() ? "true" : "false") + "}")
end

func list_events(ctx: i64):
    if aiweb.NeedAdmin(ctx) == 0:
        ret
    end
    mut where := "e.id < ?1"
    mut before := http.Query(ctx, "before").ToInt() as i64
    if before <= 0:
        before = 9223372036854775807
    end
    mut args := one(n(before))
    user := http.Query(ctx, "user")
    if user.Len() > 0:
        args.Push(user)
        where = where + " AND e.user_id = ?" + args.Len()
    end
    tool := http.Query(ctx, "tool")
    if tool.Len() > 0:
        args.Push(tool)
        where = where + " AND e.tool = ?" + args.Len()
    end
    client := http.Query(ctx, "client")
    if client.Len() > 0:
        args.Push(client)
        where = where + " AND COALESCE(c.name, e.client_id) = ?" + args.Len()
    end
    aiweb.Reply(ctx, 200, `{"events": ` + aioauth.Events(where, args, true) + "}")
end

func admin_list_apps(ctx: i64):
    if aiweb.NeedAdmin(ctx) == 0:
        ret
    end
    mut before := http.Query(ctx, "before").ToInt() as i64
    if before <= 0:
        before = 9223372036854775807
    end
    mut where := "g.id < ?1"
    mut args := one(n(before))
    user := http.Query(ctx, "user")
    if user.Len() > 0:
        args.Push(user)
        where += " AND g.user_id = ?2"
    end
    mut items := Vector {} as Vector<str>
    aistore.Lock()
    mut rows := aistore.Stmt("SELECT g.id, u.id, u.name, u.email, g.client_id, COALESCE(c.kind, ''), COALESCE(c.name, g.client_id), COALESCE(c.uri, ''), COALESCE(c.logo, ''), COALESCE(c.redirects, '[]'), g.scope, g.created, g.last_used, g.calls, g.revoked FROM oauth_grants g JOIN users u ON u.id = g.user_id LEFT JOIN oauth_clients c ON c.id = g.client_id WHERE " + where + " ORDER BY g.id DESC LIMIT 50", args)
    until aistore.Next(rows):
        mut u := Vector {} as Vector<str>
        u.Push(json.MemberRaw("id", aistore.Text(rows, 1)))
        u.Push(json.Member("name", aistore.Text(rows, 2)))
        u.Push(json.Member("email", aistore.Text(rows, 3)))
        mut m := Vector {} as Vector<str>
        m.Push(json.MemberRaw("id", aistore.Text(rows, 0)))
        m.Push(json.MemberRaw("user", json.Object(u)))
        m.Push(json.MemberRaw("client", aioauth.ClientJson(aistore.Text(rows, 4), aistore.Text(rows, 5), aistore.Text(rows, 6), aistore.Text(rows, 7), aistore.Text(rows, 8), aistore.Text(rows, 9))))
        m.Push(json.Member("scope", aistore.Text(rows, 10)))
        m.Push(json.MemberRaw("created", aistore.Text(rows, 11)))
        m.Push(json.MemberRaw("last_used", aistore.Text(rows, 12)))
        m.Push(json.MemberRaw("calls", aistore.Text(rows, 13)))
        m.Push(json.MemberBool("revoked", aistore.Text(rows, 14) != "0"))
        items.Push(json.Object(m))
    end
    aistore.Finish(rows)
    aistore.Unlock()
    aiweb.Reply(ctx, 200, `{"apps": ` + json.Array(items) + "}")
end

func list_requests(ctx: i64):
    if aiweb.NeedAdmin(ctx) == 0:
        ret
    end
    mut before := http.Query(ctx, "before").ToInt() as i64
    if before <= 0:
        before = 9223372036854775807
    end
    mut where := "r.id < ?1"
    mut args := one(n(before))
    user := http.Query(ctx, "user")
    if user.Len() > 0:
        args.Push(user)
        where = where + " AND r.user_id = ?" + args.Len()
    end
    project := http.Query(ctx, "project")
    if project.Len() > 0:
        args.Push(project)
        where = where + " AND r.project = ?" + args.Len()
    end
    key := http.Query(ctx, "key")
    if key.Len() > 0:
        args.Push(key)
        where = where + " AND r.key_id = ?" + args.Len()
    end
    aiweb.Reply(ctx, 200, `{"requests": ` + aiopenai.Requests(where, args, true) + "}")
end

func admin_chat_json(id: str, title: str, updated: str, device: str, workspace: str): str:
    mut m := Vector {} as Vector<str>
    m.Push(json.Member("id", id))
    m.Push(json.Member("title", title))
    m.Push(json.MemberRaw("updated", updated))
    if device != "0" and device.Len() > 0:
        m.Push(json.MemberBool("agent", true))
        m.Push(json.MemberRaw("device_id", device))
        m.Push(json.Member("workspace", workspace))
    end
    ret json.Object(m)
end

func admin_activity_raw(s: str): str:
    t := str.Trim(s)
    if str.StartsWith(t, "[") and str.EndsWith(t, "]"):
        ret t
    end
    ret "[]"
end

func admin_message_json(id: str, role: str, body: str, status: str, created: str, activity: str, ms: str): str:
    mut m := Vector {} as Vector<str>
    m.Push(json.MemberRaw("id", id))
    m.Push(json.Member("role", role))
    m.Push(json.Member("body", role == "assistant" ? aiturn.Plain(body) : body))
    m.Push(json.Member("status", status))
    m.Push(json.MemberRaw("created", created))
    m.Push(json.MemberRaw("activity", admin_activity_raw(activity)))
    m.Push(json.MemberRaw("ms", ms.Len() > 0 ? ms : "0"))
    ret json.Object(m)
end

func list_user_chats(ctx: i64):
    if aiweb.NeedAdmin(ctx) == 0:
        ret
    end
    uid := http.Param(ctx, "id")
    mut items := Vector {} as Vector<str>
    aistore.Lock()
    mut rows := aistore.Stmt("SELECT id, title, updated, device_id, workspace FROM chats WHERE user_id = ?1 ORDER BY updated DESC LIMIT 200", one(uid))
    until aistore.Next(rows):
        items.Push(admin_chat_json(aistore.Text(rows, 0), aistore.Text(rows, 1), aistore.Text(rows, 2), aistore.Text(rows, 3), aistore.Text(rows, 4)))
    end
    aistore.Finish(rows)
    aistore.Unlock()
    aiweb.Reply(ctx, 200, `{"chats": ` + json.Array(items) + "}")
end

func list_latest_chats(ctx: i64):
    if aiweb.NeedAdmin(ctx) == 0:
        ret
    end
    mut offset := http.Query(ctx, "offset").ToInt()
    if offset < 0:
        offset = 0
    end
    q := str.Trim(http.Query(ctx, "q"))
    mut args := Vector {} as Vector<str>
    mut where := "1 = 1"
    if q.Len() > 0:
        args.Push("%" + q + "%")
        where = "(c.title LIKE ?1 OR u.name LIKE ?1 OR u.email LIKE ?1)"
    end
    mut items := Vector {} as Vector<str>
    aistore.Lock()
    mut rows := aistore.Stmt("SELECT c.id, c.title, c.updated, c.device_id, c.workspace, u.id, u.name, u.email, COALESCE((SELECT LEFT(body, 240) FROM messages WHERE chat_id = c.id AND role = 'user' ORDER BY id LIMIT 1), ''), COALESCE((SELECT LEFT(body, 240) FROM messages WHERE chat_id = c.id AND body <> '' ORDER BY id DESC LIMIT 1), ''), COALESCE((SELECT role FROM messages WHERE chat_id = c.id AND body <> '' ORDER BY id DESC LIMIT 1), ''), (SELECT COUNT(*) FROM messages WHERE chat_id = c.id) FROM chats c JOIN users u ON u.id = c.user_id WHERE " + where + " ORDER BY c.updated DESC, c.id DESC LIMIT 51 OFFSET " + offset, args)
    mut more := false
    until aistore.Next(rows):
        if items.Len() >= 50:
            more = true
            break
        end
        mut one_chat := admin_chat_json(aistore.Text(rows, 0), aistore.Text(rows, 1), aistore.Text(rows, 2), aistore.Text(rows, 3), aistore.Text(rows, 4))
        one_chat = str.TrimSuffix(one_chat, "}") + ", " + json.Member("user_name", aistore.Text(rows, 6)) + ", " + json.MemberRaw("user_id", aistore.Text(rows, 5)) + ", " + json.Member("user_email", aistore.Text(rows, 7)) + ", " + json.Member("first", aistore.Text(rows, 8)) + ", " + json.Member("last", aistore.Text(rows, 9)) + ", " + json.Member("last_role", aistore.Text(rows, 10)) + ", " + json.MemberRaw("messages", aistore.Text(rows, 11)) + "}"
        items.Push(one_chat)
    end
    aistore.Finish(rows)
    aistore.Unlock()
    aiweb.Reply(ctx, 200, `{"chats": ` + json.Array(items) + `, "more": ` + (more ? "true" : "false") + "}")
end

func get_admin_chat(ctx: i64):
    if aiweb.NeedAdmin(ctx) == 0:
        ret
    end
    id := http.Param(ctx, "id")
    attached := aifiles.ForChat(id)
    mut head := ""
    aistore.Lock()
    mut crow := aistore.Stmt("SELECT id, title, updated, device_id, workspace, engine_sid FROM chats WHERE id = ?1", one(id))
    if aistore.Next(crow):
        head = admin_chat_json(aistore.Text(crow, 0), aistore.Text(crow, 1), aistore.Text(crow, 2), aistore.Text(crow, 3), aistore.Text(crow, 4))
        langfuse_url := ailangfuse.SessionUrl(aistore.Text(crow, 5))
        if langfuse_url.Len() > 0:
            head = head.Substr(0, head.Len() - 1) + `, "langfuse_url": ` + json.Str(langfuse_url) + "}"
        end
    end
    aistore.Finish(crow)
    if head.Len() == 0:
        aistore.Unlock()
        aiweb.Fail(ctx, 404, "not_found", "این گفت‌وگو پیدا نشد.")
        ret
    end
    mut owner := "null"
    mut orow := aistore.Stmt("SELECT u.id, u.name, u.email FROM chats c JOIN users u ON u.id = c.user_id WHERE c.id = ?1", one(id))
    if aistore.Next(orow):
        mut om := Vector {} as Vector<str>
        om.Push(json.MemberRaw("id", aistore.Text(orow, 0)))
        om.Push(json.Member("name", aistore.Text(orow, 1)))
        om.Push(json.Member("email", aistore.Text(orow, 2)))
        owner = json.Object(om)
    end
    aistore.Finish(orow)
    mut items := Vector {} as Vector<str>
    mut rows := aistore.Stmt("SELECT id, role, body, status, created, COALESCE(activity, ''), ms FROM messages WHERE chat_id = ?1 ORDER BY id", one(id))
    until aistore.Next(rows):
        mid := aistore.Text(rows, 0)
        mut item := admin_message_json(mid, aistore.Text(rows, 1), aistore.Text(rows, 2), aistore.Text(rows, 3), aistore.Text(rows, 4), aistore.Text(rows, 5), aistore.Text(rows, 6))
        if attached.Has(mid):
            item = item.Substr(0, item.Len() - 1) + `, "files": ` + attached.Get(mid) + "}"
        end
        items.Push(item)
    end
    aistore.Finish(rows)
    mut calls := Vector {} as Vector<str>
    mut crows := aistore.Stmt("SELECT id, message_id, tool, kind, summary, detail, lang, outside, cwd, output, state, created, finished FROM bridge_calls WHERE chat_id = ?1 ORDER BY seq", one(id))
    until aistore.Next(crows):
        mut cm := Vector {} as Vector<str>
        cm.Push(json.Member("call_id", aistore.Text(crows, 0)))
        cm.Push(json.Member("chat", id))
        cm.Push(json.MemberRaw("mid", aistore.Text(crows, 1)))
        cm.Push(json.Member("tool", aistore.Text(crows, 2)))
        cm.Push(json.Member("kind", aistore.Text(crows, 3)))
        cm.Push(json.Member("summary", aistore.Text(crows, 4)))
        cm.Push(json.Member("detail", aistore.Text(crows, 5)))
        cm.Push(json.Member("lang", aistore.Text(crows, 6)))
        cm.Push(json.MemberBool("outside", aistore.Text(crows, 7) == "1"))
        cm.Push(json.Member("cwd", aistore.Text(crows, 8)))
        cm.Push(json.Member("output", aistore.Text(crows, 9)))
        cm.Push(json.Member("state", aistore.Text(crows, 10)))
        cm.Push(json.MemberRaw("created", aistore.Text(crows, 11)))
        cm.Push(json.MemberRaw("finished", aistore.Text(crows, 12)))
        calls.Push(json.Object(cm))
    end
    aistore.Finish(crows)
    aistore.Unlock()
    aiweb.Reply(ctx, 200, `{"chat": ` + head + `, "user": ` + owner + `, "messages": ` + json.Array(items) + `, "calls": ` + json.Array(calls) + "}")
end

func get_trace(ctx: i64):
    if aiweb.NeedAdmin(ctx) == 0:
        ret
    end
    id := http.Param(ctx, "id")
    mut chat := ""
    mut status := ""
    mut created := 0 as i64
    mut stored := ""
    aistore.Lock()
    mut rows := aistore.Stmt("SELECT chat_id, status, created, COALESCE(trace, '') FROM messages WHERE id = ?1 AND role = 'assistant'", one(id))
    if aistore.Next(rows):
        chat = aistore.Text(rows, 0)
        status = aistore.Text(rows, 1)
        created = aistore.Int64(rows, 2)
        stored = aistore.Text(rows, 3)
    end
    aistore.Finish(rows)
    if chat.Len() == 0:
        aistore.Unlock()
        aiweb.Fail(ctx, 404, "not_found", "این پیام پیدا نشد.")
        ret
    end
    if stored.Len() > 0:
        aistore.Unlock()
        aiweb.Reply(ctx, 200, `{"trace": ` + stored + `, "saved": true}`)
        ret
    end
    sid := aistore.OneText("SELECT engine_sid FROM chats WHERE id = ?1", one(chat))
    token := aistore.OneText("SELECT bridge_token FROM chats WHERE id = ?1", one(chat))
    next := aistore.OneText("SELECT COALESCE(MIN(created), 0) FROM messages WHERE chat_id = ?1 AND role = 'user' AND id > ?2", two(chat, id))
    aistore.Unlock()
    if sid.Len() == 0:
        aiweb.Reply(ctx, 200, `{"trace": [], "saved": false}`)
        ret
    end
    mut ok := false
    trace := aiengine.Transcript(sid, created * 1000, (next.ToInt() as i64) * 1000, token, ok)
    if not ok:
        aiweb.Fail(ctx, 502, "engine", "جزئیات این پاسخ از موتور دستیار خوانده نشد.")
        ret
    end
    if status != "pending" and trace != "[]":
        aistore.Lock()
        _u := aistore.Run("UPDATE messages SET trace = ?1 WHERE id = ?2", two(trace, id))
        aistore.Unlock()
    end
    aiweb.Reply(ctx, 200, `{"trace": ` + trace + `, "saved": false}`)
end

