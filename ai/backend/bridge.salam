package aibridge

import net.http
import net.router
import net.tcp
import encoding.json
import encoding.value
import encoding.encerr
import crypto
import sync
import time
import str

include aistore "store.salam"
include aiweb "web.salam"

const POLL_MS := 25000
const CALL_MS := 600000
const OFFLINE_SECONDS := 45
const MAX_DEVICES := 10
const MAX_OUTPUT := 200000
const PROTOCOL := "2025-06-18"
const TOOLS := `[
{"name": "shell", "description": "Run a command in the user's shell (bash or sh on Linux and macOS, PowerShell on Windows unless shell is set). Runs in the workspace unless cwd is given. Use it to build, run, install, use git and so on.", "inputSchema": {"type": "object", "properties": {"session": {"type": "string", "description": "The desktop session id from the conversation."}, "command": {"type": "string"}, "cwd": {"type": "string", "description": "Directory relative to the workspace."}, "shell": {"type": "string", "enum": ["default", "bash", "sh", "powershell", "cmd"]}, "timeout": {"type": "integer", "description": "Seconds, default 120, at most 1800."}}, "required": ["session", "command"]}},
{"name": "read_file", "description": "Read a text file. Lines are numbered from 1; use offset and limit for big files.", "inputSchema": {"type": "object", "properties": {"session": {"type": "string"}, "path": {"type": "string"}, "offset": {"type": "integer"}, "limit": {"type": "integer"}}, "required": ["session", "path"]}},
{"name": "write_file", "description": "Create a file or replace its whole content. Parent folders are created.", "inputSchema": {"type": "object", "properties": {"session": {"type": "string"}, "path": {"type": "string"}, "content": {"type": "string"}}, "required": ["session", "path", "content"]}},
{"name": "edit_file", "description": "Replace one exact occurrence of old_text with new_text. old_text must appear exactly once unless replace_all is true.", "inputSchema": {"type": "object", "properties": {"session": {"type": "string"}, "path": {"type": "string"}, "old_text": {"type": "string"}, "new_text": {"type": "string"}, "replace_all": {"type": "boolean"}}, "required": ["session", "path", "old_text", "new_text"]}},
{"name": "list_dir", "description": "List a directory. Folders end with a slash.", "inputSchema": {"type": "object", "properties": {"session": {"type": "string"}, "path": {"type": "string"}}, "required": ["session"]}},
{"name": "glob", "description": "Find files by glob pattern such as src/**/*.rs, respecting .gitignore.", "inputSchema": {"type": "object", "properties": {"session": {"type": "string"}, "pattern": {"type": "string"}, "path": {"type": "string"}}, "required": ["session", "pattern"]}},
{"name": "grep", "description": "Search file contents with a regular expression, respecting .gitignore. Returns path:line: text.", "inputSchema": {"type": "object", "properties": {"session": {"type": "string"}, "pattern": {"type": "string"}, "path": {"type": "string"}, "glob": {"type": "string"}, "ignore_case": {"type": "boolean"}}, "required": ["session", "pattern"]}},
{"name": "docker", "description": "Run the docker CLI with the given arguments, for example [\"ps\", \"-a\"] or [\"compose\", \"up\", \"-d\"].", "inputSchema": {"type": "object", "properties": {"session": {"type": "string"}, "args": {"type": "array", "items": {"type": "string"}}, "cwd": {"type": "string"}, "timeout": {"type": "integer"}}, "required": ["session", "args"]}},
{"name": "wsl", "description": "Windows only: run a bash command inside WSL. distro is optional; leave command empty to list the installed distros.", "inputSchema": {"type": "object", "properties": {"session": {"type": "string"}, "command": {"type": "string"}, "distro": {"type": "string"}, "cwd": {"type": "string"}, "timeout": {"type": "integer"}}, "required": ["session"]}},
{"name": "run_tests", "description": "Detect the project's test runner (cargo, npm, bun, pnpm, yarn, go, pytest, make) and run it, or run command if given.", "inputSchema": {"type": "object", "properties": {"session": {"type": "string"}, "command": {"type": "string"}, "cwd": {"type": "string"}, "timeout": {"type": "integer"}}, "required": ["session"]}},
{"name": "wait", "description": "Wait for a call that is still running on the user's computer and return its result. Use the call_id from the earlier result that said the call is still running. Do not repeat the original call.", "inputSchema": {"type": "object", "properties": {"session": {"type": "string"}, "call_id": {"type": "string"}}, "required": ["session", "call_id"]}}
]`
const INSTRUCTIONS := "These tools act on the user's own computer through Salam Agent, the desktop app on the user's computer. Every call needs the session id given at the top of the user's message. The user may refuse a call; respect the refusal and do not retry the same call. A call that takes long, or waits for the user's approval, returns a call_id; then call wait with it until the result arrives instead of repeating the call."

mut SECRET := ""
mut SLOTS := 32
mut HOLD_MS := 40000 as i64
mut ACTIVE := 0
mut LOCK := sync.Mutex {}
mut SEEN := HashMap {} as HashMap<str, str>
mut CALLS := HashMap {} as HashMap<str, str>
mut OWNER := HashMap {} as HashMap<str, str>
mut TAKEN := HashMap {} as HashMap<str, str>
mut RESULTS := HashMap {} as HashMap<str, str>
mut STARTED := HashMap {} as HashMap<str, i64>

func one(v: str): Vector<str>:
    mut a := Vector {} as Vector<str>
    a.push(v)
    ret a
end

func two(v: str, w: str): Vector<str>:
    mut a := one(v)
    a.push(w)
    ret a
end

func n(v: i64): str:
    ret aiweb.I64s(v)
end

func clip(s: str, max: int): str:
    if s.len() <= max:
        ret s
    end
    ret s.substr(0, max)
end

func header(h: HashMap<str, str>, name: str): str:
    if h.has(name):
        ret h.get(name)
    end
    ret ""
end

func respond(c: tcp.Conn, status: str, body: str): bool:
    mut off := 0
    mut tries := 0
    head := "HTTP/1.1 " + status + "\r\nContent-Type: application/json\r\nContent-Length: " + body.len() + "\r\nCache-Control: no-store\r\nConnection: close\r\n\r\n" + body
    until off < head.len():
        got := tcp.Write(c, head.substr(off, head.len() - off))
        if got > 0:
            off += got
            tries = 0
        else:
            tries += 1
            if tries >= 4:
                ret false
            end
            sync.SleepMs(50)
        end
    end
    ret true
end

func fail(c: tcp.Conn, status: str, code: str, message: str):
    mut m := Vector {} as Vector<str>
    m.push(json.Member("error", code))
    m.push(json.Member("message", message))
    _r := respond(c, status, json.Object(m))
end

func bearer_of(h: HashMap<str, str>): str:
    auth := header(h, "authorization")
    if not str.StartsWith(str.Lower(auth), "bearer "):
        ret ""
    end
    ret str.Trim(auth.substr(7, auth.len() - 7))
end

func device_of(h: HashMap<str, str>): str:
    raw := bearer_of(h)
    if not str.StartsWith(raw, "sd-"):
        ret ""
    end
    aistore.Lock()
    id := aistore.OneText("SELECT id FROM bridge_devices WHERE hash = ?1 AND revoked = 0", one(aiweb.Hash(raw)))
    aistore.Unlock()
    ret id
end

func slot(delta: int): bool:
    _l := sync.Lock(LOCK)
    mut ok := true
    if delta > 0 and ACTIVE >= SLOTS:
        ok = false
    else:
        ACTIVE = ACTIVE + delta
    end
    _u := sync.Unlock(LOCK)
    ret ok
end

func touch(dev: str):
    _l := sync.Lock(LOCK)
    SEEN.put(dev, n(aistore.Now()))
    _u := sync.Unlock(LOCK)
end

func next_call(dev: str): str:
    _l := sync.Lock(LOCK)
    mut found := ""
    each k, v in OWNER:
        if v == dev and not TAKEN.has(k):
            found = k
            break
        end
    end
    mut out := ""
    if found.len() > 0:
        TAKEN.put(found, "1")
        out = CALLS.get(found)
    end
    _u := sync.Unlock(LOCK)
    ret out
end

func untake(call: str):
    id := json.Get(call, "id")
    _l := sync.Lock(LOCK)
    if TAKEN.has(id):
        _r := TAKEN.remove(id)
    end
    _u := sync.Unlock(LOCK)
end

func poll(c: tcp.Conn, h: HashMap<str, str>):
    dev := device_of(h)
    if dev.len() == 0:
        fail(c, "401 Unauthorized", "unauthorized", "unknown or revoked device")
        ret
    end
    if not slot(1):
        fail(c, "503 Service Unavailable", "busy", "too many devices are waiting; retry shortly")
        ret
    end
    tcp.SetReadDeadline(c, 0)
    start := time.NowMillis()
    mut call := ""
    until time.NowMillis() - start < POLL_MS:
        touch(dev)
        call = next_call(dev)
        if call.len() > 0:
            break
        end
        sync.SleepMs(100)
    end
    _s := slot(0 - 1)
    if call.len() == 0:
        _w := tcp.Write(c, "HTTP/1.1 204 No Content\r\nContent-Length: 0\r\nConnection: close\r\n\r\n")
        ret
    end
    if not respond(c, "200 OK", `{"call": ` + call + "}"):
        untake(call)
    end
end

func result(c: tcp.Conn, h: HashMap<str, str>, body: str):
    dev := device_of(h)
    if dev.len() == 0:
        fail(c, "401 Unauthorized", "unauthorized", "unknown or revoked device")
        ret
    end
    id := json.Get(body, "call_id")
    _l := sync.Lock(LOCK)
    mine := OWNER.has(id) and OWNER.get(id) == dev
    if mine:
        RESULTS.put(id, body)
    end
    _u := sync.Unlock(LOCK)
    if not mine:
        fail(c, "404 Not Found", "not_found", "no such call is waiting for this device")
        ret
    end
    touch(dev)
    _r := respond(c, "200 OK", `{"ok": true}`)
end

func online(dev: str): bool:
    _l := sync.Lock(LOCK)
    mut seen := 0
    if SEEN.has(dev):
        seen = SEEN.get(dev).to_int()
    end
    _u := sync.Unlock(LOCK)
    ret seen > 0 and (aistore.Now() as int) - seen <= OFFLINE_SECONDS
end

func known_tool(name: str): bool:
    switch name:
        "shell", "read_file", "write_file", "edit_file", "list_dir", "glob", "grep", "docker", "wsl", "run_tests":
            ret true
        end
    end
    ret false
end

func tool_text(text: str, is_error: bool): str:
    mut item := Vector {} as Vector<str>
    item.push(json.Member("type", "text"))
    item.push(json.Member("text", text))
    mut m := Vector {} as Vector<str>
    m.push(json.MemberRaw("content", "[" + json.Object(item) + "]"))
    m.push(json.MemberBool("isError", is_error))
    ret json.Object(m)
end

func forget(id: str):
    _l := sync.Lock(LOCK)
    if CALLS.has(id):
        _c := CALLS.remove(id)
    end
    if OWNER.has(id):
        _o := OWNER.remove(id)
    end
    if TAKEN.has(id):
        _t := TAKEN.remove(id)
    end
    if RESULTS.has(id):
        _r := RESULTS.remove(id)
    end
    if STARTED.has(id):
        _s := STARTED.remove(id)
    end
    _u := sync.Unlock(LOCK)
end

func sweep():
    now := time.NowMillis()
    mut old := Vector {} as Vector<str>
    _l := sync.Lock(LOCK)
    each k, v in STARTED:
        if now - v > CALL_MS + 60000:
            old.push(k)
        end
    end
    _u := sync.Unlock(LOCK)
    each k in old:
        forget(k)
    end
end

func session_device(session: str, chat &: str, dev &: str, workspace &: str):
    aistore.Lock()
    mut rows := aistore.Stmt("SELECT c.id, c.device_id, c.workspace FROM chats c JOIN bridge_devices d ON d.id = c.device_id AND d.user_id = c.user_id AND d.revoked = 0 WHERE c.bridge_token = ?1", one(session))
    if aistore.Next(rows):
        chat = aistore.Text(rows, 0)
        dev = aistore.Text(rows, 1)
        workspace = aistore.Text(rows, 2)
    end
    aistore.Finish(rows)
    aistore.Unlock()
end

func await_call(id: str, dev: str): str:
    if not slot(1):
        ret tool_text("Too many tool calls are running. Call wait again with call_id \"" + id + "\" in a moment.", false)
    end
    held := time.NowMillis()
    _a := sync.Lock(LOCK)
    began := STARTED.has(id) ? STARTED.get(id) : held
    _b := sync.Unlock(LOCK)
    mut got := ""
    mut lost := false
    until got.len() == 0:
        _c := sync.Lock(LOCK)
        if RESULTS.has(id):
            got = RESULTS.get(id)
        end
        _d := sync.Unlock(LOCK)
        if got.len() == 0:
            now := time.NowMillis()
            if now - began > CALL_MS or not online(dev):
                lost = true
                break
            end
            if now - held > HOLD_MS:
                break
            end
            sync.SleepMs(100)
        end
    end
    _s := slot(0 - 1)
    if lost:
        forget(id)
        ret tool_text("Salam Agent did not answer in time or disconnected.", true)
    end
    if got.len() == 0:
        ret tool_text("The call is still running on the user's computer (it may be waiting for the user's approval). Call wait with call_id \"" + id + "\" and the same session to get its result. Do not repeat the original call.", false)
    end
    forget(id)
    status := json.Get(got, "status")
    mut output := clip(json.Get(got, "output"), MAX_OUTPUT)
    if status == "denied" and output.len() == 0:
        output = "The user refused this call."
    end
    ret tool_text(output, status != "ok")
end

func wait_call(args: str): str:
    session := json.Get(args, "session")
    id := json.Get(args, "call_id")
    mut chat := ""
    mut dev := ""
    mut workspace := ""
    if session.len() == 32:
        session_device(session, chat, dev, workspace)
    end
    _l := sync.Lock(LOCK)
    mine := dev.len() > 0 and OWNER.has(id) and OWNER.get(id) == dev and CALLS.has(id) and json.Get(CALLS.get(id), "chat") == chat
    _u := sync.Unlock(LOCK)
    if not mine:
        ret tool_text("No call with this call_id is running for this session. It may have finished already; run the original call again only if its result is really needed.", true)
    end
    ret await_call(id, dev)
end

func call_tool(params: str): str:
    name := json.Get(params, "name")
    mut args := json.Get(params, "arguments")
    if args.len() == 0:
        args = "{}"
    end
    if name == "wait":
        ret wait_call(args)
    end
    if not known_tool(name):
        ret tool_text("Unknown tool " + name + ".", true)
    end
    session := json.Get(args, "session")
    if session.len() != 32:
        ret tool_text("The session argument is missing or wrong. Copy it exactly from the desktop session block in the user's message.", true)
    end
    mut chat := ""
    mut dev := ""
    mut workspace := ""
    session_device(session, chat, dev, workspace)
    if chat.len() == 0:
        ret tool_text("This session is not linked to Salam Agent. Tell the user to open the conversation in Salam Agent.", true)
    end
    if not online(dev):
        ret tool_text("Salam Agent is not connected right now. Ask the user to open it and try again.", true)
    end
    sweep()
    id := crypto.RandomHex(12)
    mut m := Vector {} as Vector<str>
    m.push(json.Member("id", id))
    m.push(json.Member("tool", name))
    m.push(json.MemberRaw("args", args))
    m.push(json.Member("chat", chat))
    m.push(json.Member("workspace", workspace))
    _l := sync.Lock(LOCK)
    CALLS.put(id, json.Object(m))
    OWNER.put(id, dev)
    STARTED.put(id, time.NowMillis())
    _u := sync.Unlock(LOCK)
    ret await_call(id, dev)
end

func rpc_id(body: str): str:
    mut err := encerr.EncodingError {}
    root := json.Decode(body, err)
    if encerr.IsError(err) or not value.IsObject(root):
        ret ""
    end
    mut ok := false
    idv := value.ObjectGetOk(root, "id", ok)
    mut out := ""
    if ok and not value.IsNull(idv):
        out = json.Encode(idv, json.JSONOptions {})
    end
    value.ValueFree(root)
    ret out
end

func envelope(id: str, key: str, body: str): str:
    ret `{"jsonrpc": "2.0", "id": ` + id + `, "` + key + `": ` + body + "}"
end

func mcp(c: tcp.Conn, method: str, h: HashMap<str, str>, body: str):
    if SECRET.len() < 16 or not crypto.SecretEquals(bearer_of(h), SECRET):
        fail(c, "401 Unauthorized", "unauthorized", "the bridge secret is wrong")
        ret
    end
    if method != "POST":
        _w := tcp.Write(c, "HTTP/1.1 405 Method Not Allowed\r\nAllow: POST\r\nContent-Length: 0\r\nConnection: close\r\n\r\n")
        ret
    end
    tcp.SetReadDeadline(c, 0)
    id := rpc_id(body)
    rpc := json.Get(body, "method")
    if id.len() == 0:
        _w := tcp.Write(c, "HTTP/1.1 202 Accepted\r\nContent-Length: 0\r\nConnection: close\r\n\r\n")
        ret
    end
    params := json.Get(body, "params")
    mut out := ""
    switch rpc:
        "initialize":
            mut proto := json.Get(params, "protocolVersion")
            if proto.len() == 0:
                proto = PROTOCOL
            end
            mut m := Vector {} as Vector<str>
            m.push(json.Member("protocolVersion", proto))
            m.push(json.MemberRaw("capabilities", `{"tools": {"listChanged": false}}`))
            m.push(json.MemberRaw("serverInfo", `{"name": "salam-agent", "version": "1.0.0"}`))
            m.push(json.Member("instructions", INSTRUCTIONS))
            out = envelope(id, "result", json.Object(m))
            break
        end
        "ping":
            out = envelope(id, "result", "{}")
            break
        end
        "tools/list":
            out = envelope(id, "result", `{"tools": ` + TOOLS + "}")
            break
        end
        "tools/call":
            out = envelope(id, "result", call_tool(params))
            break
        end
        else:
            out = envelope(id, "error", `{"code": -32601, "message": "method not found"}`)
        end
    end
    _r := respond(c, "200 OK", out)
end

func device_json(id: str, name: str, os_name: str, created: str): str:
    mut m := Vector {} as Vector<str>
    m.push(json.MemberRaw("id", id))
    m.push(json.Member("name", name))
    m.push(json.Member("os", os_name))
    m.push(json.MemberRaw("created", created))
    m.push(json.MemberBool("online", online(id)))
    ret json.Object(m)
end

func list_devices(ctx: i64):
    uid := aiweb.NeedUser(ctx)
    if uid == 0:
        ret
    end
    mut items := Vector {} as Vector<str>
    mut ids := Vector {} as Vector<str>
    mut names := Vector {} as Vector<str>
    mut systems := Vector {} as Vector<str>
    mut times := Vector {} as Vector<str>
    aistore.Lock()
    mut rows := aistore.Stmt("SELECT id, name, os, created FROM bridge_devices WHERE user_id = ?1 AND revoked = 0 ORDER BY id DESC", one(n(uid)))
    until aistore.Next(rows):
        ids.push(aistore.Text(rows, 0))
        names.push(aistore.Text(rows, 1))
        systems.push(aistore.Text(rows, 2))
        times.push(aistore.Text(rows, 3))
    end
    aistore.Finish(rows)
    aistore.Unlock()
    repeat ids.len() in i:
        items.push(device_json(ids.get(i), names.get(i), systems.get(i), times.get(i)))
    end
    aiweb.Reply(ctx, 200, `{"devices": ` + json.Array(items) + "}")
end

func create_device(ctx: i64):
    uid := aiweb.NeedUser(ctx)
    if uid == 0:
        ret
    end
    body := http.Ctx_body(ctx)
    name := str.Trim(json.Get(body, "name"))
    mut os_name := json.Get(body, "os")
    if name.len() == 0 or str.CodePoints(name).len() > 80:
        aiweb.Fail(ctx, 400, "name", "نام دستگاه باید بین ۱ تا ۸۰ نویسه باشد.")
        ret
    end
    if os_name != "windows" and os_name != "macos" and os_name != "linux":
        os_name = "other"
    end
    aistore.Lock()
    active := aistore.OneText("SELECT COUNT(*) FROM bridge_devices WHERE user_id = ?1 AND revoked = 0", one(n(uid)))
    aistore.Unlock()
    if active.to_int() >= MAX_DEVICES:
        aiweb.Fail(ctx, 409, "too_many", "حداکثر ۱۰ دستگاه می‌توانید وصل کنید. یکی را حذف کنید.")
        ret
    end
    secret := "sd-" + crypto.RandomHex(24)
    t := n(aistore.Now())
    mut a := two(n(uid), name)
    a.push(os_name)
    a.push(aiweb.Hash(secret))
    a.push(t)
    aistore.Lock()
    ok := aistore.Run("INSERT INTO bridge_devices (user_id, name, os, hash, created) VALUES (?1, ?2, ?3, ?4, ?5)", a)
    id := aistore.LastId()
    aistore.Unlock()
    if not ok:
        aiweb.Fail(ctx, 500, "server", "ثبت دستگاه ناموفق بود. دوباره تلاش کنید.")
        ret
    end
    aiweb.Reply(ctx, 201, `{"device": ` + device_json(id, name, os_name, t) + `, "secret": ` + json.Str(secret) + "}")
end

func revoke_device(ctx: i64):
    uid := aiweb.NeedUser(ctx)
    if uid == 0:
        ret
    end
    id := http.Ctx_param(ctx, "id")
    aistore.Lock()
    found := aistore.OneText("SELECT id FROM bridge_devices WHERE id = ?1 AND user_id = ?2 AND revoked = 0", two(id, n(uid)))
    if found.len() > 0:
        _u := aistore.Run("UPDATE bridge_devices SET revoked = 1 WHERE id = ?1", one(id))
    end
    aistore.Unlock()
    if found.len() == 0:
        aiweb.Fail(ctx, 404, "not_found", "این دستگاه پیدا نشد.")
        ret
    end
    aiweb.Reply(ctx, 200, `{"ok": true}`)
end

pub func Configure(secret: str, slots: int, hold_seconds: int):
    SECRET = secret
    LOCK = sync.NewMutex()
    if slots > 0:
        SLOTS = slots
    end
    if hold_seconds > 0:
        HOLD_MS = (hold_seconds as i64) * 1000
    end
end

pub func DeviceOs(uid: i64, dev: str): str:
    aistore.Lock()
    found := aistore.OneText("SELECT os FROM bridge_devices WHERE id = ?1 AND user_id = ?2 AND revoked = 0", two(dev, n(uid)))
    aistore.Unlock()
    ret found
end

pub func Online(dev: str): bool:
    ret online(dev)
end

pub func Handles(path: str): bool:
    ret path == "/bridge/poll" or path == "/bridge/result" or path == "/bridge/mcp"
end

pub func Serve(c: tcp.Conn, method: str, path: str, h: HashMap<str, str>, body: str):
    switch path:
        "/bridge/poll":
            if method == "GET":
                poll(c, h)
                ret
            end
            break
        end
        "/bridge/result":
            if method == "POST":
                result(c, h, body)
                ret
            end
            break
        end
        "/bridge/mcp":
            mcp(c, method, h, body)
            ret
        end
    end
    fail(c, "404 Not Found", "not_found", "unknown bridge endpoint")
end

pub func Routes(r &: router.Router):
    router.Get(r, "/bridge/devices", list_devices)
    router.Post(r, "/bridge/devices", create_device)
    router.Delete(r, "/bridge/devices/:id", revoke_device)
    each path in ["/bridge/devices", "/bridge/devices/:id"]:
        router.Options(r, path, aiweb.Preflight)
    end
end
