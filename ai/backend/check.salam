package aicheck

import os
import str
import sync
import fs
import fs.path
import os.temp

const MAX_BLOCKS := 6
const MAX_REPORT := 3000
const TOP_EN := "expected a top-level definition"
const TOP_FA := "یک تعریف سطح‌بالا انتظار می‌رفت"

mut BIN := ""
mut LOCK := sync.Mutex {}

func persian(code: str): bool:
    each cp in str.CodePoints(code):
        if cp >= 1536 and cp <= 1791:
            ret true
        end
    end
    ret false
end

func salam_fence(info: str): bool:
    lang := str.Lower(str.Trim(info))
    ret lang == "salam" or lang == "سلام" or lang == "sl"
end

func untagged(info: str): bool:
    lang := str.Lower(str.Trim(info))
    ret lang.Len() == 0 or lang == "text" or lang == "txt" or lang == "plaintext" or lang == "fa" or lang == "en" or lang == "فارسی"
end

func declares_salam(code: str): bool:
    each line in code.Split("\n"):
        t := str.Trim(line)
        if t.Len() == 0:
            continue
        end
        ret str.StartsWith(t, "// زبان:") or str.StartsWith(t, "// lang:") or str.StartsWith(t, "// language:")
    end
    ret false
end

func blocks(text: str): Vector<str>:
    mut out := Vector {} as Vector<str>
    mut inside := false
    mut keep := false
    mut loose := false
    mut b := str.NewBuilder()
    defer str.BufFree(b)
    each line in text.Split("\n"):
        t := str.Trim(line)
        if not inside:
            if str.StartsWith(t, "```"):
                inside = true
                info := t.Substr(3, t.Len() - 3)
                keep = salam_fence(info)
                loose = untagged(info)
                str.BufReset(b)
            end
            continue
        end
        if t == "```":
            inside = false
            if (keep or (loose and declares_salam(str.BufStr(b)))) and out.Len() < MAX_BLOCKS:
                out.Push(str.BufStr(b))
            end
            continue
        end
        if keep or loose:
            str.BufAppend(b, str.TrimSuffix(line, "\r"))
            str.BufAppend(b, "\n")
        end
    end
    ret out
end

func compile(code: str): str:
    dir := temp.Directory()
    if dir.Len() == 0:
        ret ""
    end
    src := path.Join(dir, "main.salam")
    log := path.Join(dir, "out.txt")
    if fs.WriteText(src, code) < 0:
        temp.RemoveDir(dir)
        ret ""
    end
    _l := sync.Lock(LOCK)
    code_ := os.Run("cd '" + dir + "' && timeout 20 '" + BIN + "' inspect main.salam --emit-symbol --log-level=error --no-color --xml-out=/dev/null > out.txt 2>&1")
    _u := sync.Unlock(LOCK)
    mut out := ""
    if code_ != 0:
        out = fs.ReadText(log)
        if out.Len() == 0:
            out = "error"
        end
    end
    temp.RemoveDir(dir)
    ret out
end

func errors_of(out: str, syntax_only: bool): Vector<str>:
    mut found := Vector {} as Vector<str>
    lines := out.Split("\n")
    repeat lines.Len() in i:
        l := lines.Get(i)
        head := str.StartsWith(l, "error") or str.StartsWith(l, "خطا")
        if not head:
            continue
        end
        coded := str.StartsWith(l, "error[") or str.StartsWith(l, "خطا[")
        if syntax_only and coded:
            continue
        end
        if l.Find(TOP_EN) >= 0 or l.Find(TOP_FA) >= 0:
            continue
        end
        mut item := l
        if i + 1 < lines.Len():
            item = item + "\n" + lines.Get(i + 1)
        end
        if i + 3 < lines.Len():
            item = item + "\n" + lines.Get(i + 3)
        end
        found.Push(item)
        if found.Len() >= 4:
            break
        end
    end
    ret found
end

func check_block(code: str): str:
    out := compile(code)
    if out.Len() == 0:
        ret ""
    end
    if out.Find(TOP_EN) < 0 and out.Find(TOP_FA) < 0:
        if code.Find("include ") >= 0:
            ret str.Join(errors_of(out, true), "\n")
        end
        ret str.Join(errors_of(out, false), "\n")
    end
    mut wrapped := ""
    if persian(code):
        wrapped = "تابع ریشه:\n" + code + "پایان\n"
    else:
        wrapped = "func main:\n" + code + "end\n"
    end
    again := compile(wrapped)
    if again.Len() == 0:
        ret ""
    end
    ret str.Join(errors_of(again, true), "\n")
end

pub func Configure(bin: str):
    LOCK = sync.NewMutex()
    if bin.Len() > 0 and fs.Exists(bin):
        BIN = bin
    end
end

pub func Enabled(): bool:
    ret BIN.Len() > 0
end

pub func Problems(text: str): str:
    if BIN.Len() == 0 or text.Find("```") < 0:
        ret ""
    end
    mut report := Vector {} as Vector<str>
    found := blocks(text)
    repeat found.Len() in i:
        problems := check_block(found.Get(i))
        if problems.Len() > 0:
            report.Push("Code block " + (i + 1) + ":\n" + found.Get(i) + "Compiler:\n" + problems)
        end
    end
    mut kept := Vector {} as Vector<str>
    mut size := 0
    each part in report:
        if kept.Len() > 0 and size + part.Len() > MAX_REPORT:
            break
        end
        kept.Push(part)
        size += part.Len()
    end
    ret str.Join(kept, "\n\n")
end
