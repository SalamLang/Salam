package aieffort

import str
import time

const STYLE := `<answer_style>
Fit the length of every reply to what was asked. Most replies are short.
- A greeting, thanks or small talk gets one short, friendly line and nothing else: no introduction of yourself, no list of what you can do, no questions back unless one is needed.
- A direct question gets the direct answer first, in a few sentences. Add steps, code, options or background only when the user needs them to act on the answer, or asks for them ("explain", "why", "in detail", "step by step").
- Do not restate the question, do not open with praise or filler, do not end with a summary of what you just said or a list of follow-up offers. One short offer is fine when it really helps.
- Use headings, tables and bullet lists only when the content is long or truly a list; a short answer is plain sentences.
- When you give code, give the code with a line or two around it, not a tutorial. Explain only the parts that are not obvious.
- When the user asks for depth, a full program or a long document, give all of it: brevity never cuts what was asked for.
</answer_style>

<current_knowledge>
Today is {date}. Your training stopped some time ago, so for anything that may have changed since (versions and releases, news and current events, prices, outside libraries and services, documentation of other projects) or when the user gives a link, use the web search and web fetch tools when you have them instead of guessing, and name the pages you used as links. Salam itself you check with the Salam tools, not the web.
</current_knowledge>`

const LOW := `

<effort level="low">
The user asked for a quick answer to this message. Answer from what you already know in as few words as do the job. Call a tool only when you cannot answer without it, at most two calls, and skip extra verification.
</effort>`

const HIGH := `

<effort level="high">
The user asked for your most careful work on this message. Before answering, think it through step by step: break the problem into parts, consider edge cases and other approaches, and check the result. Recompute math and logic a second way, compile and run code with the tools before giving it, and confirm facts against sources. For math and reasoning show the key steps, then the final answer clearly. The length still follows the question.
</effort>`

mut MODELS := HashMap {} as HashMap<str, str>
mut VARIANTS := HashMap {} as HashMap<str, str>

func pairs(list: str): HashMap<str, str>:
    mut out := HashMap {} as HashMap<str, str>
    each part in str.Split(list, ","):
        at := part.find("=")
        if at > 0:
            key := Normal(part.substr(0, at))
            val := str.Trim(part.substr(at + 1, part.Len() - at - 1))
            if val.Len() > 0:
                out.put(key, val)
            end
        end
    end
    ret out
end

pub func Configure(models: str, variants: str):
    MODELS = pairs(models)
    VARIANTS = pairs(variants)
end

pub func Normal(effort: str): str:
    e := str.Lower(str.Trim(effort))
    switch e:
        "low", "fast", "quick", "minimal", "کم", "سریع":
            ret "low"
        end
        "high", "deep", "max", "xhigh", "زیاد", "عمیق":
            ret "high"
        end
    end
    ret "medium"
end

pub func Note(effort: str): str:
    style := str.Replace(STYLE, "{date}", time.FormatDate(time.Now()))
    switch Normal(effort):
        "low":
            ret style + LOW
        end
        "high":
            ret style + HIGH
        end
    end
    ret style
end

pub func Model(effort: str): str:
    e := Normal(effort)
    ret MODELS.has(e) ? MODELS.get(e) : ""
end

pub func Variant(effort: str): str:
    e := Normal(effort)
    ret VARIANTS.has(e) ? VARIANTS.get(e) : ""
end
