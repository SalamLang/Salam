package aiengine

import net.tcp
import encoding.json
import encoding.value
import str
import conv
import sync
import time

include aiact "activity.salam"
include aieffort "effort.salam"
include aimodels "models.salam"
include aigate "gate.salam"

const CALL_MS := 20000
const SEND_MS := 60000
const RESUME_MAX := 3
const RESUME_PREFIX := "(automatic continuation)"
const RESUME_NOTE := "(automatic continuation) Your previous reply was cut off by a technical interruption, not by the user. Continue exactly where you stopped. Do not repeat what you already wrote or did; if you were in the middle of a task, carry on with it and finish it. Answer in the same language as before."
const TRACE_FIELD_MAX := 200000

mut ENGINE_HOST := "127.0.0.1"
mut ENGINE_PORT := 4096
mut ENGINE_BASE := ""
mut ENGINE_AUTH := ""
mut ENGINE_AGENT := ""
mut DESKTOP_AGENT := ""
mut PLAIN_AGENT := ""
mut PLAIN_DESKTOP_AGENT := ""
mut SYSTEM := ""
mut LOCK := sync.Mutex {}
mut AGENTS := ""
mut AGENTS_AT := 0 as i64
mut SESSION_AGENT := HashMap {} as HashMap<str, str>
mut SESSION_PROMPT := HashMap {} as HashMap<str, str>
mut SESSION_PARTS := HashMap {} as HashMap<str, str>
mut CAPS_AT := 0 as i64
mut PRICES := HashMap {} as HashMap<str, str>
mut PRICES_AT := 0 as i64
mut CAPS_IMAGE := false
mut CAPS_PDF := false
mut SESSION_MODEL := HashMap {} as HashMap<str, str>
mut SESSION_SYSTEM := HashMap {} as HashMap<str, str>
mut SESSION_TOOLS := HashMap {} as HashMap<str, str>
mut SESSION_TRY := HashMap {} as HashMap<str, int>
mut SESSION_RETRY_AT := HashMap {} as HashMap<str, i64>
mut SESSION_EFFORT := HashMap {} as HashMap<str, str>
mut SESSION_VARIANT := HashMap {} as HashMap<str, str>
mut SESSION_ASK := HashMap {} as HashMap<str, str>
mut FALLBACKS := Vector {} as Vector<str>
mut POOL_CAPS_AT := 0 as i64
mut SESSION_RESUMES := HashMap {} as HashMap<str, int>
mut SESSION_RESUME_AT := HashMap {} as HashMap<str, i64>

struct Answer:
    pub status: int = 0
    pub body: str = ""
end

pub struct Reply:
    pub text: str = ""
    pub phase: str = "thinking"
    pub done: bool = false
    pub failed: bool = false
    pub activity: str = "[]"
    pub started: bool = false
    pub idle: bool = false
    pub acted: bool = false
    pub timed_out: bool = false
    pub interrupted: bool = false
end

pub struct Usage:
    pub ok: bool = false
    pub input: i64 = 0
    pub output: i64 = 0
    pub reasoning: i64 = 0
    pub cache_read: i64 = 0
    pub cache_write: i64 = 0
    pub cost: f64 = 0.0
    pub cost_in: f64 = 0.0
    pub cost_out: f64 = 0.0
    pub tools: int = 0
    pub steps: int = 0
    pub ms: i64 = 0
end

func hex_value(s: str): int:
    mut n := 0
    mut i := 0
    digits := "0123456789abcdef"
    lower := str.Lower(str.Trim(s))
    until i < lower.Len():
        c := lower.Substr(i, 1)
        if c == ";":
            break
        end
        d := digits.Find(c)
        if d < 0:
            ret -1
        end
        n = n * 16 + d
        i++
    end
    if i == 0:
        ret -1
    end
    ret n
end

func dechunk(raw: str, ok &: bool): str:
    mut b := str.NewBuilder()
    defer str.BufFree(b)
    mut pos := 0
    ok = false
    until pos < raw.Len():
        rest := raw.Substr(pos, raw.Len() - pos)
        le := rest.Find("\r\n")
        if le < 0:
            break
        end
        size := hex_value(rest.Substr(0, le))
        if size < 0:
            break
        end
        if size == 0:
            ok = true
            break
        end
        if rest.Len() < le + 2 + size:
            break
        end
        str.BufAppend(b, rest.Substr(le + 2, size))
        pos = pos + le + 2 + size + 2
    end
    ret str.BufStr(b)
end

func call(method: str, path: str, body: str, wait_ms: int): Answer:
    mut out := Answer {}
    c := tcp.Dial(ENGINE_HOST, ENGINE_PORT)
    if not tcp.ConnOk(c):
        tcp.Close(c)
        ret out
    end
    tcp.SetReadDeadline(c, wait_ms)
    tcp.SetWriteDeadline(c, wait_ms)
    mut req := method + " " + ENGINE_BASE + path + " HTTP/1.1\r\nHost: " + ENGINE_HOST + "\r\nUser-Agent: salam-ai\r\nAccept: application/json\r\nConnection: close\r\n"
    if ENGINE_AUTH.Len() > 0:
        req = req + "Authorization: " + ENGINE_AUTH + "\r\n"
    end
    if method != "GET":
        req = req + "Content-Type: application/json\r\nContent-Length: " + body.Len() + "\r\n"
    end
    req = req + "\r\n" + body
    if tcp.Write(c, req) <= 0:
        tcp.Close(c)
        ret out
    end
    mut b := str.NewBuilder()
    defer str.BufFree(b)
    until true:
        got := tcp.Read(c, 65536)
        if got.Len() == 0:
            break
        end
        str.BufAppend(b, got)
    end
    tcp.Close(c)
    raw := str.BufStr(b)
    he := raw.Find("\r\n\r\n")
    sp := raw.Find(" ")
    if he < 0 or sp < 0 or sp > he:
        ret out
    end
    head := str.Lower(raw.Substr(0, he))
    mut rest := raw.Substr(he + 4, raw.Len() - he - 4)
    if head.Find("transfer-encoding: chunked") >= 0:
        mut whole := false
        rest = dechunk(rest, whole)
        if not whole:
            ret out
        end
    else:
        cl := head.Find("content-length:")
        if cl >= 0:
            tail := head.Substr(cl + 15, head.Len() - cl - 15)
            le := tail.Find("\r\n")
            want := str.Trim(le >= 0 ? tail.Substr(0, le) : tail).ToInt()
            if rest.Len() < want:
                ret out
            end
        end
    end
    out.status = raw.Substr(sp + 1, 3).ToInt()
    out.body = rest
    ret out
end

func ok_status(r: Answer): bool:
    ret r.status >= 200 and r.status < 300
end

func busy_now(sid: str, known &: bool): bool:
    r := call("GET", "/session/status", "", CALL_MS)
    known = ok_status(r)
    if not known:
        ret true
    end
    ret json.Has(r.body, sid)
end

func field(v: value.Value, key: str): value.Value:
    mut ok := false
    got := value.ObjectGetOk(v, key, ok)
    if not ok:
        ret value.ValueNull()
    end
    ret got
end

func is_resume(msg: value.Value): bool:
    parts := field(msg, "parts")
    if not value.IsArray(parts):
        ret false
    end
    repeat value.ArrayLen(parts) in j:
        p := value.ArrayGet(parts, j)
        if text_of(p, "type") == "text" and str.StartsWith(text_of(p, "text"), RESUME_PREFIX):
            ret true
        end
    end
    ret false
end

func text_of(v: value.Value, key: str): str:
    f := field(v, key)
    if value.IsString(f):
        ret value.AsString(f)
    end
    ret ""
end

func num(v: value.Value, key: str): i64:
    f := field(v, key)
    if value.IsNumber(f):
        ret value.AsInt(f)
    end
    ret 0
end

func flag(v: value.Value, key: str): bool:
    f := field(v, key)
    ret value.IsBool(f) and value.AsBool(f)
end

func agent_in_engine(sid: str): str:
    r := call("GET", "/session/" + sid + "/message", "", SEND_MS)
    if not ok_status(r):
        ret ""
    end
    mut list := try json.Decode(r.body) catch value.ValueNull()
    mut found := ""
    if value.IsArray(list):
        repeat value.ArrayLen(list) in i:
            info := field(value.ArrayGet(list, i), "info")
            if text_of(info, "role") == "user" and text_of(info, "agent").Len() > 0:
                found = text_of(info, "agent")
            end
        end
    end
    value.ValueFree(list)
    ret found
end

func agent_exists(name: str): bool:
    now := time.NowMillis()
    _l := sync.Lock(LOCK)
    mut names := AGENTS
    stale := now - AGENTS_AT > 300000
    _u := sync.Unlock(LOCK)
    if stale or names.Len() == 0:
        r := call("GET", "/agent", "", CALL_MS)
        if not ok_status(r):
            ret true
        end
        mut found := Vector {} as Vector<str>
        mut list := try json.Decode(r.body) catch value.ValueNull()
        if value.IsArray(list):
            repeat value.ArrayLen(list) in i:
                found.Push(text_of(value.ArrayGet(list, i), "name"))
            end
        end
        value.ValueFree(list)
        names = "\n" + str.Join(found, "\n") + "\n"
        _a := sync.Lock(LOCK)
        AGENTS = names
        AGENTS_AT = now
        _b := sync.Unlock(LOCK)
    end
    ret names.Find("\n" + name + "\n") >= 0
end

func model_json(model: str): str:
    slash := model.Find("/")
    if slash <= 0 or slash >= model.Len() - 1:
        ret ""
    end
    ret `, "model": {"providerID": ` + json.Str(model.Substr(0, slash)) + `, "modelID": ` + json.Str(model.Substr(slash + 1, model.Len() - slash - 1)) + "}"
end

func remember(sid: str, agent: str, text: str, model: str, fresh: bool, parts: str, system: str, tools: str, variant: str):
    _l := sync.Lock(LOCK)
    if SESSION_AGENT.Size() > 5000:
        SESSION_AGENT = HashMap {} as HashMap<str, str>
        SESSION_PROMPT = HashMap {} as HashMap<str, str>
        SESSION_PARTS = HashMap {} as HashMap<str, str>
        SESSION_MODEL = HashMap {} as HashMap<str, str>
        SESSION_SYSTEM = HashMap {} as HashMap<str, str>
        SESSION_TOOLS = HashMap {} as HashMap<str, str>
        SESSION_TRY = HashMap {} as HashMap<str, int>
        SESSION_RETRY_AT = HashMap {} as HashMap<str, i64>
        SESSION_EFFORT = HashMap {} as HashMap<str, str>
        SESSION_VARIANT = HashMap {} as HashMap<str, str>
    end
    SESSION_AGENT.Put(sid, agent)
    SESSION_VARIANT.Put(sid, variant)
    SESSION_MODEL.Put(sid, model)
    SESSION_SYSTEM.Put(sid, system)
    SESSION_TOOLS.Put(sid, tools)
    if fresh:
        SESSION_PROMPT.Put(sid, text)
        SESSION_PARTS.Put(sid, parts)
        SESSION_TRY.Put(sid, 0)
        _r := SESSION_RETRY_AT.Remove(sid)
        _q := SESSION_RESUMES.Remove(sid)
    end
    _u := sync.Unlock(LOCK)
end

func post_prompt(sid: str, agent: str, text: str, model: str, parts: str, system: str, tools: str, variant: str): bool:
    mut b := str.NewBuilder()
    defer str.BufFree(b)
    str.BufAppend(b, `{"agent": `)
    str.BufAppend(b, json.Str(agent))
    str.BufAppend(b, model_json(model))
    if variant.Len() > 0:
        str.BufAppend(b, `, "variant": `)
        str.BufAppend(b, json.Str(variant))
    end
    if system.Len() > 0:
        str.BufAppend(b, `, "system": `)
        str.BufAppend(b, json.Str(system))
    end
    if tools.Len() > 0:
        str.BufAppend(b, `, "tools": `)
        str.BufAppend(b, tools)
    end
    str.BufAppend(b, `, "parts": [{"type": "text", "text": `)
    str.BufAppend(b, json.Str(text))
    str.BufAppend(b, "}")
    str.BufAppend(b, parts)
    str.BufAppend(b, "]}")
    ret ok_status(call("POST", "/session/" + sid + "/prompt_async", str.BufStr(b), SEND_MS))
end

func wants_image(parts: str): bool:
    ret parts.Find(`"mime": "image/`) >= 0
end

func wants_pdf(parts: str): bool:
    ret parts.Find(`"mime": "application/pdf`) >= 0
end

func load_pool_caps():
    _l := sync.Lock(LOCK)
    stale := time.NowMillis() - POOL_CAPS_AT > 600000
    _u := sync.Unlock(LOCK)
    if not stale:
        ret
    end
    mut loaded := false
    pr := call("GET", "/config/providers", "", CALL_MS)
    if ok_status(pr):
        mut all := try json.Decode(pr.body) catch value.ValueNull()
        list := field(all, "providers")
        if value.IsArray(list):
            each model in aimodels.Models():
                slash := model.Find("/")
                pid := model.Substr(0, slash)
                mid := model.Substr(slash + 1, model.Len() - slash - 1)
                repeat value.ArrayLen(list) in i:
                    prov := value.ArrayGet(list, i)
                    if text_of(prov, "id") == pid:
                        accepts := field(field(field(field(prov, "models"), mid), "capabilities"), "input")
                        if value.IsObject(accepts):
                            aimodels.SetCaps(model, flag(accepts, "image"), flag(accepts, "pdf"))
                            loaded = true
                        end
                    end
                end
            end
        end
        value.ValueFree(all)
    end
    _a := sync.Lock(LOCK)
    POOL_CAPS_AT = loaded ? time.NowMillis() : time.NowMillis() - 570000
    _b := sync.Unlock(LOCK)
end

func send_as(sid: str, agent: str, text: str, parts: str, system_in: str, tools: str): bool:
    _l := sync.Lock(LOCK)
    effort := SESSION_EFFORT.Has(sid) ? SESSION_EFFORT.Get(sid) : ""
    _u := sync.Unlock(LOCK)
    mut system := system_in
    mut model := ""
    mut variant := ""
    if effort.Len() > 0:
        system = system + "\n\n" + aieffort.Note(effort)
        model = aieffort.Model(effort)
        variant = aieffort.Variant(effort)
    end
    if model.Len() == 0 and aimodels.Managed():
        load_pool_caps()
        now := time.NowMillis()
        aimodels.Refresh(now)
        model = aimodels.Pick(now, wants_image(parts), wants_pdf(parts))
    end
    mut sent := text
    _g := sync.Lock(LOCK)
    typed := SESSION_ASK.Has(sid) ? SESSION_ASK.Get(sid) : ""
    SESSION_ASK.Put(sid, "")
    _h := sync.Unlock(LOCK)
    asked := aigate.Asks(typed.Len() > 0 ? typed : text)
    if asked.Len() > 0:
        println "language gate replaced a message about the assistant itself"
        sent = aigate.Notice(asked)
    end
    remember(sid, agent, sent, model, true, parts, system, tools, variant)
    ret post_prompt(sid, agent, sent, model, parts, system, tools, variant)
end

func caps_model(config: value.Value, agent: str): str:
    own := text_of(field(field(config, "agent"), agent), "model")
    if own.Len() > 0:
        ret own
    end
    ret text_of(config, "model")
end

func load_caps():
    mut image := false
    mut pdf := false
    mut loaded := false
    r := call("GET", "/config", "", CALL_MS)
    if ok_status(r):
        mut config := try json.Decode(r.body) catch value.ValueNull()
        model := caps_model(config, ENGINE_AGENT)
        value.ValueFree(config)
        slash := model.Find("/")
        if slash > 0:
            pid := model.Substr(0, slash)
            mid := model.Substr(slash + 1, model.Len() - slash - 1)
            pr := call("GET", "/config/providers", "", CALL_MS)
            if ok_status(pr):
                mut all := try json.Decode(pr.body) catch value.ValueNull()
                list := field(all, "providers")
                if value.IsArray(list):
                    repeat value.ArrayLen(list) in i:
                        prov := value.ArrayGet(list, i)
                        if text_of(prov, "id") == pid:
                            accepts := field(field(field(field(prov, "models"), mid), "capabilities"), "input")
                            image = flag(accepts, "image")
                            pdf = flag(accepts, "pdf")
                            loaded = value.IsObject(accepts)
                        end
                    end
                end
                value.ValueFree(all)
            end
        end
    end
    _l := sync.Lock(LOCK)
    if loaded:
        CAPS_IMAGE = image
        CAPS_PDF = pdf
        CAPS_AT = time.NowMillis()
    else:
        CAPS_AT = time.NowMillis() - 540000
    end
    _u := sync.Unlock(LOCK)
end

func scrub(s: str, mask: str): str:
    mut t := s
    if mask.Len() > 0:
        t = str.Replace(t, mask, "…")
    end
    t = aiact.Mask(t)
    if t.Len() > TRACE_FIELD_MAX:
        t = str.CharSubstr(t, 0, TRACE_FIELD_MAX / 2) + "\n…"
    end
    ret t
end

func millis(v: value.Value, key: str): i64:
    f := field(v, key)
    if value.IsNumber(f):
        ret value.AsInt(f)
    end
    ret 0
end

func trace_part(p: value.Value, mask: str): str:
    kind := text_of(p, "type")
    mut m := Vector {} as Vector<str>
    if kind == "text":
        t := text_of(p, "text")
        if str.Trim(t).Len() == 0:
            ret ""
        end
        m.Push(json.Member("kind", "text"))
        m.Push(json.Member("text", scrub(t, mask)))
        m.Push(json.MemberBool("synthetic", flag(p, "synthetic")))
        m.Push(json.MemberInt("at", millis(field(p, "time"), "start")))
    else kind == "reasoning":
        t := text_of(p, "text")
        if str.Trim(t).Len() == 0:
            ret ""
        end
        m.Push(json.Member("kind", "think"))
        m.Push(json.Member("text", scrub(t, mask)))
        m.Push(json.MemberInt("at", millis(field(p, "time"), "start")))
    else kind == "tool":
        state := field(p, "state")
        times := field(state, "time")
        given := field(state, "input")
        mut args := "{}"
        if value.IsObject(given):
            args = json.Encode(given, json.JSONOptions { indent = "  " })
        end
        m.Push(json.Member("kind", "tool"))
        m.Push(json.Member("tool", text_of(p, "tool")))
        m.Push(json.Member("status", text_of(state, "status")))
        m.Push(json.Member("title", scrub(text_of(state, "title"), mask)))
        m.Push(json.Member("input", scrub(args, mask)))
        m.Push(json.Member("output", scrub(text_of(state, "output"), mask)))
        m.Push(json.Member("error", scrub(text_of(state, "error"), mask)))
        m.Push(json.MemberInt("at", millis(times, "start")))
        m.Push(json.MemberInt("end", millis(times, "end")))
    else kind == "file":
        m.Push(json.Member("kind", "file"))
        m.Push(json.Member("text", text_of(p, "filename") + " " + text_of(p, "mime")))
    else:
        ret ""
    end
    ret json.Object(m)
end

func load_prices():
    pr := call("GET", "/config/providers", "", CALL_MS)
    if not ok_status(pr):
        _l := sync.Lock(LOCK)
        PRICES_AT = time.NowMillis() - 540000
        _u := sync.Unlock(LOCK)
        ret
    end
    mut all := try json.Decode(pr.body) catch value.ValueNull()
    list := field(all, "providers")
    mut table := HashMap {} as HashMap<str, str>
    if value.IsArray(list):
        repeat value.ArrayLen(list) in i:
            prov := value.ArrayGet(list, i)
            pid := text_of(prov, "id")
            models := field(prov, "models")
            if value.IsObject(models):
                each mid in value.ObjectKeys(models):
                    c := field(field(models, mid), "cost")
                    if value.IsObject(c):
                        table.Put(pid + "/" + mid, price_of(c, "input") + "|" + price_of(c, "output") + "|" + price_of(c, "cache_read") + "|" + price_of(c, "cache_write"))
                    end
                end
            end
        end
    end
    value.ValueFree(all)
    _a := sync.Lock(LOCK)
    PRICES = table
    PRICES_AT = time.NowMillis()
    _b := sync.Unlock(LOCK)
end

func price_of(c: value.Value, key: str): str:
    f := field(c, key)
    if value.IsNumber(f):
        ret conv.FormatFloatPrec(value.AsFloat(f), 8)
    end
    ret "0"
end

func prices_for(model_key: str, pin &: f64, pout &: f64, pcr &: f64, pcw &: f64): bool:
    _l := sync.Lock(LOCK)
    stale := time.NowMillis() - PRICES_AT > 600000
    _u := sync.Unlock(LOCK)
    if stale:
        load_prices()
    end
    _a := sync.Lock(LOCK)
    have := PRICES.Has(model_key)
    row := have ? PRICES.Get(model_key) : ""
    _b := sync.Unlock(LOCK)
    if not have:
        ret false
    end
    p := row.Split("|")
    if p.Len() != 4:
        ret false
    end
    pin = p.Get(0).ToFloat()
    pout = p.Get(1).ToFloat()
    pcr = p.Get(2).ToFloat()
    pcw = p.Get(3).ToFloat()
    ret pin > 0.0 or pout > 0.0
end

func split_cost(model_key: str, total: f64, in_tokens: i64, out_tokens: i64, cache_read: i64, cache_write: i64, cost_in &: f64, cost_out &: f64):
    if total <= 0.0:
        ret
    end
    mut pin := 0.0
    mut pout := 0.0
    mut pcr := 0.0
    mut pcw := 0.0
    if not prices_for(model_key, pin, pout, pcr, pcw):
        pin = 1.0
        pout = 5.0
        pcr = 0.1
        pcw = 1.25
    end
    ci := (in_tokens as f64) * pin + (cache_read as f64) * pcr + (cache_write as f64) * pcw
    co := (out_tokens as f64) * pout
    sum := ci + co
    if sum <= 0.0:
        cost_in += total
        ret
    end
    cost_in += total * ci / sum
    cost_out += total * co / sum
end

func hollow(text: str): bool:
    mut in_tag := false
    mut i := 0
    until i < text.Len():
        c := text[i] as int
        if in_tag:
            if c == 62:
                in_tag = false
            end
        else c == 60:
            in_tag = true
        else c >= 128 or (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122):
            ret false
        end
        i++
    end
    ret true
end

pub func Configure(url: str, auth: str, agent: str, desktop: str):
    LOCK = sync.NewMutex()
    mut rest := str.TrimPrefix(url, "http://")
    slash := rest.Find("/")
    if slash >= 0:
        ENGINE_BASE = str.TrimSuffix(rest.Substr(slash, rest.Len() - slash), "/")
        rest = rest.Substr(0, slash)
    end
    colon := rest.Find(":")
    if colon > 0:
        ENGINE_PORT = rest.Substr(colon + 1, rest.Len() - colon - 1).ToInt()
        ENGINE_HOST = rest.Substr(0, colon)
    else:
        ENGINE_PORT = 80
        ENGINE_HOST = rest
    end
    ENGINE_AUTH = auth
    ENGINE_AGENT = agent
    DESKTOP_AGENT = desktop
end

pub func NewSession(title: str): str:
    r := call("POST", "/session", `{"title": ` + json.Str(title) + "}", SEND_MS)
    if not ok_status(r):
        ret ""
    end
    ret json.Get(r.body, "id")
end

pub func SetPolicy(system: str, plain_agent: str):
    SYSTEM = system
    PLAIN_AGENT = plain_agent
end

pub func SetPlainDesktop(agent: str):
    PLAIN_DESKTOP_AGENT = agent
end

pub func PlainReady(): bool:
    ret PLAIN_AGENT.Len() > 0 and agent_exists(PLAIN_AGENT)
end

pub func PlainDesktopReady(): bool:
    ret PLAIN_DESKTOP_AGENT.Len() > 0 and agent_exists(PLAIN_DESKTOP_AGENT)
end

pub func Send(sid: str, text: str, parts: str): bool:
    ret send_as(sid, ENGINE_AGENT, text, parts, SYSTEM, "")
end

pub func SendWith(sid: str, text: str, parts: str, plain: bool, system: str, tools: bool): bool:
    mut agent := ENGINE_AGENT
    if plain:
        if PlainReady():
            agent = PLAIN_AGENT
        else:
            println "engine has no agent", PLAIN_AGENT, "so a custom API key is answered by", ENGINE_AGENT
        end
    end
    ret send_as(sid, agent, text, parts, system, tools ? "" : `{"*": false}`)
end

pub func SendFree(sid: str, text: str, parts: str, system: str): bool:
    ret SendWith(sid, text, parts, true, system, true)
end

pub func SendDesktopFree(sid: str, text: str, parts: str, system: str): bool:
    mut agent := DESKTOP_AGENT
    if PLAIN_DESKTOP_AGENT.Len() > 0 and agent_exists(PLAIN_DESKTOP_AGENT):
        agent = PLAIN_DESKTOP_AGENT
    else PlainReady():
        agent = PLAIN_AGENT
    end
    if agent == DESKTOP_AGENT and DESKTOP_AGENT != ENGINE_AGENT and not agent_exists(DESKTOP_AGENT):
        agent = ENGINE_AGENT
    end
    ret send_as(sid, agent, text, parts, system, "")
end

pub func SendDesktop(sid: str, text: str, parts: str): bool:
    if DESKTOP_AGENT != ENGINE_AGENT and not agent_exists(DESKTOP_AGENT):
        println "engine has no agent", DESKTOP_AGENT, "so desktop chats use", ENGINE_AGENT
        ret send_as(sid, ENGINE_AGENT, text, parts, SYSTEM, "")
    end
    ret send_as(sid, DESKTOP_AGENT, text, parts, SYSTEM, "")
end

pub func Accepts(image &: bool, pdf &: bool):
    _l := sync.Lock(LOCK)
    stale := time.NowMillis() - CAPS_AT > 600000
    _u := sync.Unlock(LOCK)
    if stale:
        load_caps()
    end
    if aimodels.Managed():
        load_pool_caps()
        image = aimodels.AnyImage()
        pdf = aimodels.AnyPdf()
        ret
    end
    _a := sync.Lock(LOCK)
    image = CAPS_IMAGE
    pdf = CAPS_PDF
    _b := sync.Unlock(LOCK)
end

pub func AcceptsFor(sid: str, image &: bool, pdf &: bool):
    _l := sync.Lock(LOCK)
    model := SESSION_MODEL.Has(sid) ? SESSION_MODEL.Get(sid) : ""
    _u := sync.Unlock(LOCK)
    if model.Len() > 0 and aimodels.Owns(model):
        load_pool_caps()
        image = aimodels.Can(model, true, false)
        pdf = aimodels.Can(model, false, true)
        ret
    end
    Accepts(image, pdf)
end

pub func Followup(sid: str, text: str): bool:
    _l := sync.Lock(LOCK)
    agent := SESSION_AGENT.Has(sid) ? SESSION_AGENT.Get(sid) : ENGINE_AGENT
    mut model := SESSION_MODEL.Has(sid) ? SESSION_MODEL.Get(sid) : ""
    system := SESSION_SYSTEM.Has(sid) ? SESSION_SYSTEM.Get(sid) : SYSTEM
    tools := SESSION_TOOLS.Has(sid) ? SESSION_TOOLS.Get(sid) : ""
    variant := SESSION_VARIANT.Has(sid) ? SESSION_VARIANT.Get(sid) : ""
    _u := sync.Unlock(LOCK)
    if aimodels.Managed() and (model.Len() == 0 or aimodels.Owns(model)):
        aimodels.Refresh(time.NowMillis())
        model = aimodels.Pick(time.NowMillis(), false, false)
    end
    remember(sid, agent, text, model, false, "", system, tools, variant)
    ret post_prompt(sid, agent, text, model, "", system, tools, variant)
end

pub func SetEffort(sid: str, effort: str):
    _l := sync.Lock(LOCK)
    SESSION_EFFORT.Put(sid, aieffort.Normal(effort))
    _u := sync.Unlock(LOCK)
end

pub func SetAsk(sid: str, typed: str):
    _l := sync.Lock(LOCK)
    SESSION_ASK.Put(sid, typed)
    _u := sync.Unlock(LOCK)
end

pub func Effort(effort: str): str:
    ret aieffort.Normal(effort)
end

pub func SetEfforts(models: str, variants: str):
    aieffort.Configure(models, variants)
end

pub func SetFallbacks(list: str):
    mut found := Vector {} as Vector<str>
    each part in str.Split(list, ","):
        m := str.Trim(part)
        if model_json(m).Len() > 0:
            found.Push(m)
        end
    end
    FALLBACKS = found
end

pub func SetModels(preferred: str, fallbacks: str, file: str):
    aimodels.Configure(preferred, fallbacks)
    if file.Len() > 0:
        aimodels.WatchFile(file)
    end
end

pub func Fallbacks(): int:
    if aimodels.Managed():
        ret aimodels.Count()
    end
    ret FALLBACKS.Len()
end

pub func Retry(sid: str): bool:
    now := time.NowMillis()
    _l := sync.Lock(LOCK)
    if SESSION_RETRY_AT.Has(sid) and now - SESSION_RETRY_AT.Get(sid) < 4000:
        _e := sync.Unlock(LOCK)
        ret true
    end
    managed := aimodels.Managed()
    pool := managed ? aimodels.Count() : FALLBACKS.Len()
    tried := SESSION_TRY.Has(sid) ? SESSION_TRY.Get(sid) : pool
    mut model := ""
    if managed and tried < pool:
        if SESSION_MODEL.Has(sid):
            aimodels.Fail(SESSION_MODEL.Get(sid), now)
        end
        aimodels.Refresh(now)
        keep := SESSION_PARTS.Has(sid) ? SESSION_PARTS.Get(sid) : ""
        model = aimodels.Ready(now, wants_image(keep), wants_pdf(keep))
    else tried < pool:
        model = FALLBACKS.Get(tried)
    end
    if tried >= pool or model.Len() == 0 or not SESSION_PROMPT.Has(sid):
        _f := sync.Unlock(LOCK)
        ret false
    end
    SESSION_TRY.Put(sid, tried + 1)
    SESSION_RETRY_AT.Put(sid, now)
    agent := SESSION_AGENT.Has(sid) ? SESSION_AGENT.Get(sid) : ENGINE_AGENT
    text := SESSION_PROMPT.Get(sid)
    parts := SESSION_PARTS.Has(sid) ? SESSION_PARTS.Get(sid) : ""
    system := SESSION_SYSTEM.Has(sid) ? SESSION_SYSTEM.Get(sid) : SYSTEM
    tools := SESSION_TOOLS.Has(sid) ? SESSION_TOOLS.Get(sid) : ""
    _u := sync.Unlock(LOCK)
    seen := Poll(sid)
    if seen.acted or seen.text.Len() > 0:
        ret false
    end
    _a := call("POST", "/session/" + sid + "/abort", "{}", CALL_MS)
    println "engine turn failed, retrying with fallback", tried + 1, "of", pool
    remember(sid, agent, text, model, false, "", system, tools, "")
    ret post_prompt(sid, agent, text, model, parts, system, tools, "")
end

pub func Resume(sid: str, interrupted: bool): bool:
    now := time.NowMillis()
    _l := sync.Lock(LOCK)
    if SESSION_RESUME_AT.Has(sid) and now - SESSION_RESUME_AT.Get(sid) < 4000:
        _e := sync.Unlock(LOCK)
        ret true
    end
    used := SESSION_RESUMES.Has(sid) ? SESSION_RESUMES.Get(sid) : 0
    if used >= RESUME_MAX:
        _f := sync.Unlock(LOCK)
        ret false
    end
    SESSION_RESUMES.Put(sid, used + 1)
    SESSION_RESUME_AT.Put(sid, now)
    mut agent := SESSION_AGENT.Has(sid) ? SESSION_AGENT.Get(sid) : ""
    mut model := SESSION_MODEL.Has(sid) ? SESSION_MODEL.Get(sid) : ""
    system := SESSION_SYSTEM.Has(sid) ? SESSION_SYSTEM.Get(sid) : SYSTEM
    tools := SESSION_TOOLS.Has(sid) ? SESSION_TOOLS.Get(sid) : ""
    variant := SESSION_VARIANT.Has(sid) ? SESSION_VARIANT.Get(sid) : ""
    _u := sync.Unlock(LOCK)
    if agent.Len() == 0:
        agent = agent_in_engine(sid)
        if agent.Len() == 0:
            agent = ENGINE_AGENT
        end
    end
    if aimodels.Managed():
        aimodels.Refresh(now)
        if not interrupted and model.Len() > 0:
            aimodels.Fail(model, now)
        end
        next := aimodels.Ready(now, false, false)
        if next.Len() == 0 and not interrupted:
            ret false
        end
        if next.Len() > 0:
            model = next
        end
    end
    _a := call("POST", "/session/" + sid + "/abort", "{}", CALL_MS)
    println "engine turn cut off, resuming it", used + 1, "of", RESUME_MAX
    remember(sid, agent, RESUME_NOTE, model, false, "", system, tools, variant)
    ret post_prompt(sid, agent, RESUME_NOTE, model, "", system, tools, variant)
end

pub func SetGate(url: str):
    aigate.Configure(url)
end

pub func SetRedactions(words: str, strict: str):
    aiact.Configure(words, strict)
end

pub func ModelWords(): str:
    mut out := Vector {} as Vector<str>
    out.Push("opencode")
    mut ids := aimodels.Models()
    each m in FALLBACKS:
        ids.Push(m)
    end
    each m in ids:
        out.Push(m)
        slash := m.Find("/")
        if slash > 0 and slash < m.Len() - 1 and m.Len() - slash - 1 >= 6:
            part := m.Substr(slash + 1, m.Len() - slash - 1)
            out.Push(part)
            spaced := str.Replace(str.Replace(part, "-", " "), "_", " ")
            out.Push(spaced)
            dash := part.Find("-")
            if dash >= 5:
                out.Push(part.Substr(0, dash))
            end
        end
    end
    ret str.Join(out, ",")
end

pub func Transcript(sid: str, from_ms: i64, upto_ms: i64, mask: str, ok &: bool): str:
    ok = false
    r := call("GET", "/session/" + sid + "/message", "", SEND_MS)
    if not ok_status(r):
        ret "[]"
    end
    mut list := try json.Decode(r.body) catch value.ValueNull()
    if not value.IsArray(list):
        value.ValueFree(list)
        ret "[]"
    end
    mut out := Vector {} as Vector<str>
    repeat value.ArrayLen(list) in i:
        msg := value.ArrayGet(list, i)
        info := field(msg, "info")
        at := millis(field(info, "time"), "created")
        if at >= from_ms and (upto_ms <= 0 or at < upto_ms):
            mut role := text_of(info, "role")
            parts := field(msg, "parts")
            if role == "user" and is_resume(msg):
                role = "resume"
            end
            if role == "user":
                mut pieces := Vector {} as Vector<str>
                if value.IsArray(parts):
                    repeat value.ArrayLen(parts) in j:
                        pt := value.ArrayGet(parts, j)
                        if text_of(pt, "type") == "text":
                            pieces.Push(text_of(pt, "text"))
                        end
                    end
                end
                mut m := Vector {} as Vector<str>
                m.Push(json.Member("kind", "prompt"))
                m.Push(json.Member("text", scrub(str.Join(pieces, "\n\n"), mask)))
                m.Push(json.MemberInt("at", at))
                out.Push(json.Object(m))
            else role == "assistant":
                e := field(info, "error")
                if value.IsArray(parts):
                    repeat value.ArrayLen(parts) in j:
                        piece := trace_part(value.ArrayGet(parts, j), mask)
                        if piece.Len() > 0:
                            out.Push(piece)
                        end
                    end
                end
                if not value.IsNull(e):
                    mut m := Vector {} as Vector<str>
                    m.Push(json.Member("kind", "error"))
                    m.Push(json.Member("text", scrub(text_of(field(e, "data"), "message") + " " + text_of(e, "name"), mask)))
                    m.Push(json.MemberInt("at", at))
                    out.Push(json.Object(m))
                end
            end
        end
    end
    value.ValueFree(list)
    ok = true
    ret json.Array(out)
end

pub func Forget(sid: str):
    _l := sync.Lock(LOCK)
    _p := SESSION_PROMPT.Remove(sid)
    _q := SESSION_PARTS.Remove(sid)
    _u := sync.Unlock(LOCK)
end

pub func Abort(sid: str):
    Forget(sid)
    _r := call("POST", "/session/" + sid + "/abort", "{}", CALL_MS)
end

pub func Delete(sid: str):
    Forget(sid)
    _r := call("DELETE", "/session/" + sid, "", CALL_MS)
end

pub func ModelOf(sid: str): str:
    _l := sync.Lock(LOCK)
    model := SESSION_MODEL.Has(sid) ? SESSION_MODEL.Get(sid) : ""
    _u := sync.Unlock(LOCK)
    ret model
end

pub func UsageOf(sid: str): Usage:
    mut u := Usage {}
    if sid.Len() == 0:
        ret u
    end
    r := call("GET", "/session/" + sid + "/message", "", SEND_MS)
    if not ok_status(r):
        ret u
    end
    mut list := try json.Decode(r.body) catch value.ValueNull()
    if not value.IsArray(list):
        ret u
    end
    n := value.ArrayLen(list)
    mut start := 0
    repeat n in i:
        if text_of(field(value.ArrayGet(list, i), "info"), "role") == "user":
            start = i + 1
        end
    end
    mut first := 0 as i64
    mut last := 0 as i64
    mut k := start
    until k < n:
        m := value.ArrayGet(list, k)
        info := field(m, "info")
        if text_of(info, "role") == "assistant":
            u.ok = true
            u.steps++
            t := field(info, "tokens")
            u.input += num(t, "input")
            u.output += num(t, "output")
            u.reasoning += num(t, "reasoning")
            u.cache_read += num(field(t, "cache"), "read")
            u.cache_write += num(field(t, "cache"), "write")
            c := field(info, "cost")
            if value.IsNumber(c):
                u.cost += value.AsFloat(c)
                split_cost(text_of(info, "providerID") + "/" + text_of(info, "modelID"), value.AsFloat(c), num(t, "input"), num(t, "output") + num(t, "reasoning"), num(field(t, "cache"), "read"), num(field(t, "cache"), "write"), u.cost_in, u.cost_out)
            end
            tm := field(info, "time")
            created := num(tm, "created")
            completed := num(tm, "completed")
            if first == 0 or (created > 0 and created < first):
                first = created
            end
            if completed > last:
                last = completed
            end
            parts := field(m, "parts")
            if value.IsArray(parts):
                repeat value.ArrayLen(parts) in j:
                    if text_of(value.ArrayGet(parts, j), "type") == "tool":
                        u.tools++
                    end
                end
            end
        end
        k++
    end
    value.ValueFree(list)
    if first > 0 and last >= first:
        u.ms = last - first
    end
    ret u
end

pub func Retrying(sid: str, note &: str, wait_ms &: i64): bool:
    r := call("GET", "/session/status", "", CALL_MS)
    if not ok_status(r):
        ret false
    end
    entry := json.Get(r.body, sid)
    if entry.Len() == 0 or json.Get(entry, "type") != "retry":
        ret false
    end
    note = json.Get(entry, "message")
    next := json.Get(entry, "next")
    wait_ms = 0
    if next.Len() > 0:
        wait_ms = conv.ParseIntOr(next, 0) - time.NowMillis()
        if wait_ms < 0:
            wait_ms = 0
        end
    end
    ret true
end

pub func Hollow(text: str): bool:
    ret hollow(text)
end

pub func Poll(sid: str): Reply:
    mut out := Reply {}
    mut known := false
    busy := busy_now(sid, known)
    r := call("GET", "/session/" + sid + "/message", "", SEND_MS)
    if r.status == 0 or not known:
        ret out
    end
    if not ok_status(r):
        out.failed = not busy
        out.done = out.failed
        ret out
    end
    mut list := try json.Decode(r.body) catch value.ValueNull()
    if not value.IsArray(list):
        value.ValueFree(list)
        ret out
    end
    n := value.ArrayLen(list)
    mut start := 0
    repeat n in i:
        if text_of(field(value.ArrayGet(list, i), "info"), "role") == "user" and not is_resume(value.ArrayGet(list, i)):
            start = i + 1
        end
    end
    mut pieces := Vector {} as Vector<str>
    mut last_finish := ""
    mut last_done := false
    mut searching := false
    mut errored := false
    mut k := start
    until k < n:
        m := value.ArrayGet(list, k)
        info := field(m, "info")
        if text_of(info, "role") == "assistant":
            out.started = true
            if not value.IsNull(field(info, "error")):
                errored = true
            end
            last_finish = text_of(info, "finish")
            last_done = not value.IsNull(field(field(info, "time"), "completed"))
            searching = false
            parts := field(m, "parts")
            if value.IsArray(parts):
                repeat value.ArrayLen(parts) in j:
                    p := value.ArrayGet(parts, j)
                    kind := text_of(p, "type")
                    if kind == "text" and not flag(p, "synthetic"):
                        t := text_of(p, "text")
                        if str.Trim(t).Len() > 0:
                            pieces.Push(t)
                        end
                    else kind == "tool":
                        out.acted = true
                        status := text_of(field(p, "state"), "status")
                        if status == "running" or status == "pending":
                            searching = true
                        end
                    end
                end
            end
        end
        k++
    end
    value.ValueFree(list)
    out.text = str.Join(pieces, "\n\n")
    mut emptied := false
    if out.text.Len() > 0 and hollow(out.text):
        out.text = ""
        emptied = true
    end
    if errored and not busy:
        out.failed = true
        out.done = true
        ret out
    end
    out.idle = not busy
    out.done = not busy and last_done and last_finish != "tool-calls"
    if out.done and out.text.Len() > 0 and aimodels.Managed():
        _m := sync.Lock(LOCK)
        used := SESSION_MODEL.Has(sid) ? SESSION_MODEL.Get(sid) : ""
        _n := sync.Unlock(LOCK)
        aimodels.Ok(used)
    end
    out.failed = out.done and emptied
    out.interrupted = not busy and out.started and not last_done
    if searching:
        out.phase = "searching"
    else out.text.Len() > 0:
        out.phase = "writing"
    end
    ret out
end
