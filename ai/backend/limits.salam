package ailimits

import str

pub const CEILING := 43200 as i64

func clamp(seconds: i64, fallback: i64): i64:
    if seconds <= 0:
        ret fallback
    end
    if seconds > CEILING:
        ret CEILING
    end
    ret seconds
end

func mpeg_frame(b: u8*): bool:
    if b[0] as int != 255 or ((b[1] as int) & 224) != 224:
        ret false
    end
    version := ((b[1] as int) >> 3) & 3
    layer := ((b[1] as int) >> 1) & 3
    bitrate := (b[2] as int) >> 4
    rate := ((b[2] as int) >> 2) & 3
    ret version != 1 and layer != 0 and bitrate != 0 and bitrate != 15 and rate != 3
end

pub func Pick(device: bool, plan: str, chat: i64, agent: i64, unlimited: i64): i64:
    if plan == "unlimited":
        base := device ? clamp(agent, 3600 as i64) : clamp(chat, 600 as i64)
        top := clamp(unlimited, 1800 as i64)
        ret top > base ? top : base
    end
    if device:
        ret clamp(agent, 3600 as i64)
    end
    ret clamp(chat, 600 as i64)
end

pub func SpeechVerdict(requests: int, seconds: int, max_requests: int, max_seconds: int): str:
    if max_requests > 0 and requests >= max_requests:
        ret "requests"
    end
    if max_seconds > 0 and seconds >= max_seconds:
        ret "seconds"
    end
    ret ""
end

pub func AudioContainer(p: void*, n: int): str:
    if n < 12:
        ret ""
    end
    b := p as u8*
    if b[0] as int == 26 and b[1] as int == 69 and b[2] as int == 223 and b[3] as int == 163:
        ret "matroska"
    end
    if b[0] as int == 79 and b[1] as int == 103 and b[2] as int == 103 and b[3] as int == 83:
        ret "ogg"
    end
    if b[4] as int == 102 and b[5] as int == 116 and b[6] as int == 121 and b[7] as int == 112:
        ret "mp4"
    end
    if b[0] as int == 102 and b[1] as int == 76 and b[2] as int == 97 and b[3] as int == 67:
        ret "flac"
    end
    if b[0] as int == 82 and b[1] as int == 73 and b[2] as int == 70 and b[3] as int == 70 and b[8] as int == 87 and b[9] as int == 65 and b[10] as int == 86 and b[11] as int == 69:
        ret "wav"
    end
    if b[0] as int == 73 and b[1] as int == 68 and b[2] as int == 51:
        ret "mp3"
    end
    if mpeg_frame(b):
        ret "mp3"
    end
    ret ""
end

pub func GuestShare(whole: int, least: int): int:
    if whole <= 0:
        ret 0
    end
    share := whole / 3
    ret share < least ? least : share
end

pub func SafeFilePath(p: str): bool:
    if p.len() == 0 or p.len() > 300 or str.StartsWith(p, "/") or str.StartsWith(p, "."):
        ret false
    end
    if p.find("..") >= 0 or p.find("//") >= 0:
        ret false
    end
    mut i := 0
    until i < p.len():
        c := p[i] as int
        ok := (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 45 or c == 46 or c == 47 or c == 95
        if not ok:
            ret false
        end
        i += 1
    end
    ret true
end

pub func CutUtf8(s: str, max: int): str:
    if s.len() <= max:
        ret s
    end
    mut at := max
    until at > 0 and ((s[at] as int) & 192) == 128:
        at -= 1
    end
    ret s.substr(0, at)
end

pub func CaptionLang(caption: str): str:
    c := str.Lower(str.Trim(caption))
    if c == "en" or c == "/en":
        ret "en"
    end
    if c == "fa" or c == "/fa":
        ret "fa"
    end
    ret ""
end

pub func VoiceDocument(mime: str, name: str): bool:
    m := str.Lower(mime)
    if str.StartsWith(m, "audio/") or str.StartsWith(m, "video/"):
        ret true
    end
    if m.len() > 0 and m != "application/octet-stream" and m != "application/ogg":
        ret false
    end
    n := str.Lower(name)
    each e in [".mp3", ".m4a", ".mp4", ".ogg", ".oga", ".opus", ".flac", ".wav", ".webm", ".mka", ".mov"]:
        if str.EndsWith(n, e):
            ret true
        end
    end
    ret false
end
