func run_queued_now(ctx: i64):
    uid := need_user(ctx)
    if uid == 0:
        ret
    end
    id := http.Param(ctx, "id")
    qid := http.Param(ctx, "qid")
    owned := own_chat(uid, id)
    if owned.len() == 0:
        fail(ctx, 404, "not_found", "این گفت‌وگو پیدا نشد.")
        ret
    end
    aistore.Lock()
    found := aistore.OneText("SELECT COUNT(*) FROM chat_queue WHERE id = ?1 AND chat_id = ?2", two(qid, id))
    if found == "1":
        _f := aistore.Run("UPDATE chat_queue SET pos = (SELECT m FROM (SELECT COALESCE(MIN(pos), 0) - 1 AS m FROM chat_queue WHERE chat_id = ?1) t) WHERE id = ?2", two(id, qid))
    end
    aistore.Unlock()
    if found != "1":
        fail(ctx, 404, "not_found", "این پیام دیگر در صف نیست.")
        ret
    end
    _s := abort_turn(id, str.TrimSuffix(owned, "|"))
    mut launched := ""
    if queue_step(id, launched):
        reply(ctx, 201, launched)
        ret
    end
    queue_reply(ctx, 200, id, `"waiting": true`)
end

func queue_worker():
    until true:
        sync.SleepMs(QUEUE_MS)
        queue_tick()
    end
end

func queue_tick():
    mut chats := Vector {} as Vector<str>
    aistore.Lock()
    mut rows := aistore.Stmt("SELECT chat_id FROM chat_queue UNION SELECT chat_id FROM messages WHERE status = 'pending' AND via_queue = 1 LIMIT 200", Vector {} as Vector<str>)
    until aistore.Next(rows):
        chats.push(aistore.Text(rows, 0))
    end
    aistore.Finish(rows)
    aistore.Unlock()
    each id in chats:
        mut launched := ""
        _l := queue_step(id, launched)
    end
end

func queue_step(id: str, launched &: str): bool:
    aistore.Lock()
    sid := aistore.OneText("SELECT engine_sid FROM chats WHERE id = ?1", one(id))
    uid := aistore.OneText("SELECT user_id FROM chats WHERE id = ?1", one(id))
    mut prow := aistore.Stmt("SELECT id, created FROM messages WHERE chat_id = ?1 AND status = 'pending' ORDER BY id DESC LIMIT 1", one(id))
    mut mid := ""
    mut created := 0 as i64
    if aistore.Next(prow):
        mid = aistore.Text(prow, 0)
        created = aistore.Int64(prow, 1)
    end
    aistore.Finish(prow)
    mut qrow := aistore.Stmt("SELECT id, body, ui_note, project, effort FROM chat_queue WHERE chat_id = ?1 ORDER BY pos, id LIMIT 1", one(id))
    mut qid := ""
    mut text := ""
    mut note := ""
    mut project := ""
    mut effort := ""
    if aistore.Next(qrow):
        qid = aistore.Text(qrow, 0)
        text = aistore.Text(qrow, 1)
        note = aistore.Text(qrow, 2)
        project = aistore.Text(qrow, 3)
        effort = aistore.Text(qrow, 4)
    end
    aistore.Finish(qrow)
    aistore.Unlock()
    if mid.len() > 0:
        r := settle(mid, sid, created, turn_seconds(id))
        if not r.done:
            ret false
        end
    end
    if qid.len() == 0 or uid.len() == 0:
        ret false
    end
    mut files := aifiles.Revive(qid)
    mut status := 0
    mut code := ""
    mut message := ""
    body := `{"effort": ` + json.Str(effort) + (project.len() > 0 ? `, "project": ` + project : "") + "}"
    if launch_turn(uid.to_int(), id, sid, text, files, note, body, qid, "0", "", status, code, message, launched):
        ret true
    end
    if status == 500:
        println "salam-ai: dropped a queued message that could not start:", code, message
        aistore.Lock()
        _d := aistore.Run("DELETE FROM chat_queue WHERE id = ?1", one(qid))
        aistore.Unlock()
    end
    ret false
end

