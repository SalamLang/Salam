func desktop_preamble(uid: i64, device: str, workspace: str, token: str, extra: str): str:
    os_name := aibridge.DeviceOs(uid, device)
    mut state := "connected"
    if not aibridge.Online(device):
        state = "not connected right now"
    end
    ret "<desktop_session>\nsession: " + token + "\nworkspace: " + workspace + (extra.len() > 0 ? "\nextra_folder: " + extra + " (absolute path, also yours to read and change)" : "") + "\nos: " + os_name + "\napp: " + state + "\nYou are working on this user's computer through Salam Agent, the desktop app on their computer. Use the desktop tools (shell, read_file, write_file, edit_file, list_dir, glob, grep, docker, wsl, run_tests, browser) and pass the session value above in every call. After changing a web page or frontend, open it with browser, look at the screenshot and the console errors, and fix what is wrong before you say it is done. Paths are relative to the workspace. Look before you change things, keep edits small, run the tests after changing code, and tell the user what you did.\nThe project's own instructions, from its AGENTS.md or AGENT.md, come in a project_instructions block: follow them unless they conflict with the Salam policy. The project's memory lives in .salam-agent/ in the workspace: .salam-agent/index.md lists every memory with a link to its file under .salam-agent/memory/, and it comes in a project_memory block. Read a memory file with read_file when its title looks relevant. Save what will help in a later session, such as how to build and test, the layout, decisions, the user's preferences and the traps you hit, with save_memory (reuse a slug to update a memory), and use forget_memory for what turned out wrong. If neither block has appeared in this conversation, read AGENTS.md or AGENT.md and .salam-agent/index.md yourself when they exist.\n</desktop_session>\n\n"
end

func project_block(chat: str, body: str, fresh: bool): str:
    project := json.Get(body, "project")
    if not str.StartsWith(project, "{"):
        ret ""
    end
    file := json.Get(project, "instructions_file")
    rules := str.Trim(json.Get(project, "instructions"))
    index := str.Trim(json.Get(project, "memory_index"))
    digest := aiweb.Hash(file + "\n" + rules + "\n" + index)
    key := "chat " + chat
    _l := sync.Lock(CONTEXT_LOCK)
    if CONTEXT_SENT.size() > 5000:
        CONTEXT_SENT = HashMap {} as HashMap<str, str>
    end
    same := not fresh and CONTEXT_SENT.has(key) and CONTEXT_SENT.get(key) == digest
    CONTEXT_SENT.put(key, digest)
    _u := sync.Unlock(CONTEXT_LOCK)
    if same:
        ret ""
    end
    mut out := ""
    if rules.len() > 0:
        name := file == "AGENT.md" ? "AGENT.md" : "AGENTS.md"
        out = out + "<project_instructions file=\"" + name + "\">\n" + aipolicy.Defang(clip_bytes(rules, 32768)) + "\n</project_instructions>\n\n"
    end
    if index.len() > 0:
        out = out + "<project_memory>\n" + aipolicy.Defang(clip_bytes(index, 16384)) + "\n</project_memory>\n\n"
    end
    ret out
end

func chat_project_block(chat: str, fresh: bool): str:
    aistore.Lock()
    mut rows := aistore.Stmt("SELECT p.name, p.description FROM chats c JOIN projects p ON p.id = c.project_id WHERE c.id = ?1", one(chat))
    mut name := ""
    mut desc := ""
    if aistore.Next(rows):
        name = aistore.Text(rows, 0)
        desc = aistore.Text(rows, 1)
    end
    aistore.Finish(rows)
    aistore.Unlock()
    if name.len() == 0:
        ret ""
    end
    digest := aiweb.Hash(name + "\n" + desc)
    key := "chat " + chat + " project"
    _l := sync.Lock(CONTEXT_LOCK)
    if CONTEXT_SENT.size() > 5000:
        CONTEXT_SENT = HashMap {} as HashMap<str, str>
    end
    same := not fresh and CONTEXT_SENT.has(key) and CONTEXT_SENT.get(key) == digest
    CONTEXT_SENT.put(key, digest)
    _u := sync.Unlock(CONTEXT_LOCK)
    if same:
        ret ""
    end
    mut out := "<project_context>\nname: " + aipolicy.Defang(clip_bytes(name, 200)) + "\n"
    if desc.len() > 0:
        out = out + "description: " + aipolicy.Defang(clip_bytes(desc, 4000)) + "\n"
    end
    ret out + "</project_context>\n\n"
end

func clip_bytes(s: str, max: int): str:
    if s.len() <= max:
        ret s
    end
    mut cut := max
    until cut > 0:
        b := s[cut] as int
        if b < 128 or b >= 192:
            break
        end
        cut--
    end
    ret s.substr(0, cut) + "\n[... cut, read the file for the rest ...]"
end

func poll_message(ctx: i64):
    uid := need_user(ctx)
    if uid == 0:
        ret
    end
    id := http.Param(ctx, "id")
    mid := http.Param(ctx, "mid")
    owned := own_chat(uid, id)
    if owned.len() == 0:
        fail(ctx, 404, "not_found", "این گفت‌وگو پیدا نشد.")
        ret
    end
    aistore.Lock()
    mut rows := aistore.Stmt("SELECT body, status, created FROM messages WHERE id = ?1 AND chat_id = ?2", two(mid, id))
    mut found := false
    mut body := ""
    mut status := ""
    mut created := 0 as i64
    if aistore.Next(rows):
        found = true
        body = aistore.Text(rows, 0)
        status = aistore.Text(rows, 1)
        created = aistore.Int64(rows, 2)
    end
    aistore.Finish(rows)
    aistore.Unlock()
    if not found:
        fail(ctx, 404, "not_found", "این پیام پیدا نشد.")
        ret
    end
    mut phase := "done"
    mut activity := "[]"
    body = aiturn.Plain(body)
    if status == "pending":
        r := settle(mid, str.TrimSuffix(owned, "|"), created, turn_seconds(id))
        body = r.text
        activity = activity_raw(r.activity)
        if r.done:
            status = r.failed ? "error" : "done"
        else:
            phase = r.phase
        end
    end
    mut m := Vector {} as Vector<str>
    m.push(json.MemberRaw("id", mid))
    m.push(json.Member("body", body))
    m.push(json.Member("status", status))
    m.push(json.Member("phase", phase))
    m.push(json.MemberRaw("activity", activity))
    reply(ctx, 200, json.Object(m))
end

func stop_message(ctx: i64):
    uid := need_user(ctx)
    if uid == 0:
        ret
    end
    id := http.Param(ctx, "id")
    owned := own_chat(uid, id)
    if owned.len() == 0:
        fail(ctx, 404, "not_found", "این گفت‌وگو پیدا نشد.")
        ret
    end
    body := abort_turn(id, str.TrimSuffix(owned, "|"))
    reply(ctx, 200, `{"ok": true, "body": ` + json.Str(body) + "}")
end

func abort_turn(id: str, sid: str): str:
    if sid.len() > 0:
        aiengine.Abort(sid)
    end
    r := aiengine.Poll(sid)
    mut body := r.text
    if body.len() == 0:
        body = "پاسخ متوقف شد."
    end
    stopped_activity := sid.len() > 0 ? activity_raw(ailive.Activity(sid, true)) : "[]"
    aistore.Lock()
    _u := aistore.Run("UPDATE messages SET body = ?1, status = 'done', activity = ?3 WHERE chat_id = ?2 AND status = 'pending'", three(body, id, stopped_activity))
    aistore.Unlock()
    if sid.len() > 0:
        ailive.End(sid)
        forget_check(sid)
    end
    ret body
end

func cors_lines(origin: str): str:
    mut h := "Vary: Origin\r\n"
    if allowed_origin(origin):
        h = h + "Access-Control-Allow-Origin: " + origin + "\r\nAccess-Control-Allow-Headers: Authorization, Content-Type\r\nAccess-Control-Allow-Methods: GET, OPTIONS\r\nAccess-Control-Max-Age: 86400\r\n"
    end
    ret h
end

func wr_all(c: tcp.Conn, data: str): bool:
    mut off := 0
    mut tries := 0
    until off < data.len():
        got := tcp.Write(c, data.substr(off, data.len() - off))
        if got > 0:
            off += got
            tries = 0
        else:
            tries++
            if tries >= 4:
                ret false
            end
            sync.SleepMs(50)
        end
    end
    ret true
end

func stream_plain(c: tcp.Conn, status: str, origin: str, body: str):
    _w := wr_all(c, "HTTP/1.1 " + status + "\r\nContent-Type: application/json\r\nContent-Length: " + body.len() + "\r\nCache-Control: no-store\r\nConnection: close\r\n" + cors_lines(origin) + "\r\n" + body)
end

func stream_error(c: tcp.Conn, status: str, origin: str, code: str, message: str):
    mut m := Vector {} as Vector<str>
    m.push(json.Member("error", code))
    m.push(json.Member("message", message))
    stream_plain(c, status, origin, json.Object(m))
end

func send_event(c: tcp.Conn, name: str, data: str): bool:
    ret wr_all(c, "event: " + name + "\ndata: " + data + "\n\n")
end

func text_event(t: str): str:
    ret "{" + json.Member("t", t) + "}"
end

func stream_slot(uid: i64, delta: int): bool:
    key := i64s(uid)
    _l := sync.Lock(STREAM_LOCK)
    mut have := 0
    if STREAM_COUNT.has(key):
        have = STREAM_COUNT.get(key).to_int()
    end
    mut ok := true
    if delta > 0 and have >= STREAMS_PER_USER:
        ok = false
    else:
        have += delta
        if have <= 0:
            _r := STREAM_COUNT.remove(key)
        else:
            STREAM_COUNT.put(key, "" + have)
        end
    end
    _u := sync.Unlock(STREAM_LOCK)
    ret ok
end

func read_body(c: tcp.Conn, head: str, want: int, whole &: bool): str:
    mut b := str.NewBuilder()
    defer str.BufFree(b)
    mut have := head.len()
    str.BufAppend(b, head)
    until have < want:
        more := tcp.Read(c, 65536)
        if more.len() == 0:
            whole = false
            ret ""
        end
        str.BufAppend(b, more)
        have += more.len()
    end
    whole = true
    ret str.BufStr(b)
end

func rss_mb(): int:
    data := io.ReadFile("/proc/self/status")
    at := data.find("VmRSS:")
    if at < 0:
        ret 0
    end
    rest := data.substr(at + 6, data.len() - at - 6)
    nl := rest.find("\n")
    line := str.Trim(nl >= 0 ? rest.substr(0, nl) : rest)
    ret str.Trim(str.TrimSuffix(line, "kB")).to_int() / 1024
end

func watchdog():
    start := time.NowMillis()
    until true:
        sync.SleepMs(WATCH_MS)
        mb := rss_mb()
        if mb > 0 and time.NowMillis() - start > WATCH_GRACE_MS:
            live := aiweb.Live()
            if mb >= MEM_HARD_MB or (mb >= MEM_SOFT_MB and live == 0):
                println "salam-ai: restarting to give memory back at", mb, "MB with", live, "requests in flight"
                os.Exit(0)
            end
        end
    end
end

func serve_stream(c: tcp.Conn):
    tcp.SetReadDeadline(c, 5000)
    mut req := ""
    until req.find("\r\n\r\n") < 0:
        got := tcp.Read(c, 8192)
        if got.len() == 0 or req.len() > 32768:
            ret
        end
        req += got
    end
    lines := req.substr(0, req.find("\r\n\r\n")).split("\n")
    first := str.Trim(lines.get(0)).split(" ")
    if first.len() < 2:
        ret
    end
    method := first.get(0)
    mut path := first.get(1)
    mut origin := ""
    mut auth := ""
    mut headers := HashMap {} as HashMap<str, str>
    each line in lines:
        l := str.Trim(line)
        colon := l.find(":")
        if colon > 0:
            headers.put(str.Lower(str.Trim(l.substr(0, colon))), str.Trim(l.substr(colon + 1, l.len() - colon - 1)))
        end
        lower := str.Lower(l)
        if str.StartsWith(lower, "origin:"):
            origin = str.Trim(l.substr(7, l.len() - 7))
        else str.StartsWith(lower, "authorization:"):
            auth = str.Trim(l.substr(14, l.len() - 14))
        end
    end
    mut bare := path
    cut := bare.find("?")
    if cut >= 0:
        bare = bare.substr(0, cut)
    end
    if aiopenai.Handles(bare) or aibridge.Handles(bare):
        head_end := req.find("\r\n\r\n") + 4
        mut want := 0
        if headers.has("content-length"):
            want = headers.get("content-length").to_int()
        end
        if want > MAX_BODY:
            stream_error(c, "413 Payload Too Large", origin, "too_large", "request body is larger than 8 MB")
            ret
        end
        mut whole := false
        tcp.SetReadDeadline(c, BODY_MS)
        if str.Lower(headers.has("expect") ? headers.get("expect") : "") == "100-continue":
            if not wr_all(c, "HTTP/1.1 100 Continue\r\n\r\n"):
                ret
            end
        end
        body := read_body(c, req.substr(head_end, req.len() - head_end), want, whole)
        if not whole:
            stream_error(c, "400 Bad Request", origin, "short_body", "the request body stopped before Content-Length")
            ret
        end
        if aibridge.Handles(bare):
            aiweb.Enter()
            aibridge.Serve(c, method, bare, headers, body)
            aiweb.Leave()
        else:
            aiopenai.Serve(c, method, bare, headers, body)
        end
        ret
    end
    if method == "OPTIONS":
        _w := wr_all(c, "HTTP/1.1 204 No Content\r\nContent-Length: 0\r\nConnection: close\r\n" + cors_lines(origin) + "\r\n")
        ret
    end
    q := path.find("?")
    mut query := ""
    if q >= 0:
        query = path.substr(q + 1, path.len() - q - 1)
        path = path.substr(0, q)
    end
    seg := path.split("/")
    if method == "GET" and seg.len() == 5 and seg.get(1) == "guest" and seg.get(2) == "messages" and seg.get(4) == "stream":
        aiweb.Enter()
        guest_stream(c, origin, seg.get(3), query_value(query, "guest"), query_value(query, "lang") == "en")
        aiweb.Leave()
        ret
    end
    if method != "GET" or seg.len() != 6 or seg.get(1) != "chats" or seg.get(3) != "messages" or seg.get(5) != "stream":
        stream_error(c, "404 Not Found", origin, "not_found", "این مسیر وجود ندارد.")
        ret
    end
    id := seg.get(2)
    mid := seg.get(4)
    mut token := ""
    if str.StartsWith(auth, "Bearer "):
        token = str.Trim(auth.substr(7, auth.len() - 7))
    end
    uid := user_from_token(token)
    if uid == 0:
        stream_error(c, "401 Unauthorized", origin, "unauthorized", "لطفا دوباره وارد شوید.")
        ret
    end
    owned := own_chat(uid, id)
    if owned.len() == 0:
        stream_error(c, "404 Not Found", origin, "not_found", "این گفت‌وگو پیدا نشد.")
        ret
    end
    if not stream_slot(uid, 1):
        stream_error(c, "429 Too Many Requests", origin, "streams", "پاسخ‌های زیادی را هم‌زمان دنبال می‌کنید. چند لحظه بعد دوباره تلاش کنید.")
        ret
    end
    aiweb.Enter()
    stream_answer(c, origin, id, mid, owned)
    aiweb.Leave()
    _s := stream_slot(uid, 0 - 1)
end

func stream_answer(c: tcp.Conn, origin: str, id: str, mid: str, owned: str):
    aistore.Lock()
    mut rows := aistore.Stmt("SELECT body, status, created, COALESCE(activity, ''), ms FROM messages WHERE id = ?1 AND chat_id = ?2 AND role = 'assistant'", two(mid, id))
    mut found := false
    mut body := ""
    mut status := ""
    mut created := 0 as i64
    mut stored_activity := ""
    mut stored_ms := "0"
    if aistore.Next(rows):
        found = true
        body = aistore.Text(rows, 0)
        status = aistore.Text(rows, 1)
        created = aistore.Int64(rows, 2)
        stored_activity = aistore.Text(rows, 3)
        stored_ms = aistore.Text(rows, 4)
    end
    aistore.Finish(rows)
    aistore.Unlock()
    if not found:
        stream_error(c, "404 Not Found", origin, "not_found", "این پیام پیدا نشد.")
        ret
    end
    tcp.SetReadDeadline(c, 0)
    head := "HTTP/1.1 200 OK\r\nContent-Type: text/event-stream; charset=utf-8\r\nCache-Control: no-cache, no-transform\r\nX-Accel-Buffering: no\r\nConnection: close\r\n" + cors_lines(origin) + "\r\n"
    if not wr_all(c, head + ": stream\n\n"):
        ret
    end
    sid := str.TrimSuffix(owned, "|")
    if status != "pending":
        _d := send_event(c, "done", "{" + json.Member("body", aiturn.Plain(body)) + ", " + json.Member("status", status) + ", " + json.MemberRaw("activity", activity_raw(stored_activity)) + ", " + json.MemberRaw("ms", stored_ms.len() > 0 ? stored_ms : "0") + "}")
        ret
    end
    limit := turn_seconds(id)
    mut sent := ""
    mut phase_sent := ""
    mut activity_sent := "[]"
    mut activity_steps := 0
    mut activity_at := 0 as i64
    mut gen := ailive.Gen()
    mut beat := time.NowMillis()
    start := aistore.Now()
    tcp.SetWriteDeadline(c, 30000)
    until true:
        r := settle(mid, sid, created, limit)
        if r.done:
            final := r.failed ? "error" : "done"
            took := time.NowMillis() - created * 1000
            _d := send_event(c, "done", "{" + json.Member("body", r.text) + ", " + json.Member("status", final) + ", " + json.MemberRaw("activity", activity_raw(r.activity)) + ", " + json.MemberRaw("ms", i64s(took)) + "}")
            ret
        end
        sent_before := sent
        phase_before := phase_sent
        activity_before := activity_sent
        if r.activity != activity_sent:
            steps_now := r.activity.split("\"kind\"").len()
            now_ms := time.NowMillis()
            if steps_now != activity_steps or now_ms - activity_at >= 300:
                if not send_event(c, "activity", "{" + json.MemberRaw("steps", activity_raw(r.activity)) + "}"):
                    ret
                end
                activity_sent = r.activity
                activity_steps = steps_now
                activity_at = now_ms
            end
        end
        if r.text != sent:
            if str.StartsWith(r.text, sent):
                if not send_event(c, "delta", text_event(r.text.substr(sent.len(), r.text.len() - sent.len()))):
                    ret
                end
            else:
                if not send_event(c, "reset", text_event(r.text)):
                    ret
                end
            end
            sent = r.text
        end
        if r.phase != phase_sent:
            if not send_event(c, "phase", "{" + json.Member("phase", r.phase) + "}"):
                ret
            end
            phase_sent = r.phase
        end
        if aistore.Now() - start > STREAM_SECONDS:
            ret
        end
        if activity_sent != activity_before or sent != sent_before or phase_sent != phase_before:
            beat = time.NowMillis()
        else time.NowMillis() - beat >= BEAT_MS:
            if not wr_all(c, ": ping\n\n"):
                ret
            end
            beat = time.NowMillis()
        end
        if ailive.Connected():
            gen = ailive.Wait(gen, BEAT_MS / 2)
            sync.SleepMs(TICK_MS)
        else:
            sync.SleepMs(700)
        end
    end
end

func query_value(query: str, key: str): str:
    each pair in query.split("&"):
        at := pair.find("=")
        if at > 0 and pair.substr(0, at) == key:
            ret pair.substr(at + 1, pair.len() - at - 1)
        end
    end
    ret ""
end

func guest_stream(c: tcp.Conn, origin: str, mid: str, token: str, en: bool):
    cors := aiguest.CorsLines(origin)
    mut gid := ""
    mut sid := ""
    mut status := ""
    mut body := ""
    mut created := 0 as i64
    if token.len() < 20 or not aiguest.Find(mid, token, gid, sid, status, body, created):
        _n := wr_all(c, "HTTP/1.1 404 Not Found\r\nContent-Type: application/json\r\nContent-Length: 21\r\nConnection: close\r\n" + cors + "\r\n{\"error\": \"not_found\"}")
        ret
    end
    slot := 0 - (gid.to_int() as i64)
    if not stream_slot(slot, 1):
        _b := wr_all(c, "HTTP/1.1 429 Too Many Requests\r\nContent-Type: application/json\r\nContent-Length: 17\r\nConnection: close\r\n" + cors + "\r\n{\"error\": \"busy\"}")
        ret
    end
    tcp.SetReadDeadline(c, 0)
    tcp.SetWriteDeadline(c, 30000)
    head := "HTTP/1.1 200 OK\r\nContent-Type: text/event-stream; charset=utf-8\r\nCache-Control: no-cache, no-transform\r\nX-Accel-Buffering: no\r\nConnection: close\r\n" + cors + "\r\n"
    if wr_all(c, head + ": stream\n\n"):
        mut sent := ""
        mut phase_sent := ""
        mut beat := time.NowMillis()
        mut gen := ailive.Gen()
        start := aistore.Now()
        mut going := true
        until going:
            mut phase := "done"
            if status == "pending":
                phase = aiguest.Step(mid, sid, created, en, status, body)
            end
            if status != "pending":
                _d := send_event(c, "done", "{" + json.Member("body", body) + ", " + json.Member("status", status) + "}")
                going = false
            else:
                changed := body != sent or phase != phase_sent
                if body != sent:
                    if str.StartsWith(body, sent):
                        going = send_event(c, "delta", text_event(body.substr(sent.len(), body.len() - sent.len())))
                    else:
                        going = send_event(c, "reset", text_event(body))
                    end
                    sent = body
                end
                if going and phase != phase_sent:
                    going = send_event(c, "phase", "{" + json.Member("phase", phase) + "}")
                    phase_sent = phase
                end
                if changed:
                    beat = time.NowMillis()
                else going and time.NowMillis() - beat >= BEAT_MS:
                    going = wr_all(c, ": ping\n\n")
                    beat = time.NowMillis()
                end
                if going and aistore.Now() - start > STREAM_SECONDS:
                    going = false
                end
                if going:
                    if ailive.Connected():
                        gen = ailive.Wait(gen, BEAT_MS / 2)
                        sync.SleepMs(TICK_MS)
                    else:
                        sync.SleepMs(700)
                    end
                end
            end
        end
    end
    _s := stream_slot(slot, 0 - 1)
end

func stream_worker():
    mut open := true
    until true:
        fd := STREAM_JOBS.recv(open)
        if not open:
            break
        end
        c := tcp.ConnFromFd(fd)
        serve_stream(c)
        tcp.Close(c)
    end
end

func stream_acceptor():
    until true:
        c := tcp.Accept(STREAM_SRV)
        if tcp.ConnOk(c):
            STREAM_JOBS.send(c.fd)
        end
    end
end
