    aistore.Unlock()
    reply(ctx, 200, "{" + json.Member("master_prompt", text) + ", " + json.MemberInt("max", aimaster.AccountMax() as i64) + ", " + json.MemberInt("project_max", aimaster.ProjectMax() as i64) + "}")
