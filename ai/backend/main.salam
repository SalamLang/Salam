func delete_chat(ctx: i64):
    uid := need_user(ctx)
    if uid == 0:
        ret
    end
    id := http.Param(ctx, "id")
    owned := own_chat(uid, id)
    if owned.len() == 0:
        fail(ctx, 404, "not_found", "این گفت‌وگو پیدا نشد.")
        ret
    end
    aistore.Lock()
    cloud_token := aistore.OneText("SELECT bridge_token FROM chats WHERE id = ?1 AND cloud = 1", one(id))
    _m := aistore.Run("DELETE FROM messages WHERE chat_id = ?1", one(id))
    _c := aistore.Run("DELETE FROM chats WHERE id = ?1", one(id))
    aistore.Unlock()
