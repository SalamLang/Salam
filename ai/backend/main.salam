func enqueue_message(ctx: i64):
    uid := need_user(ctx)
    if uid == 0:
        ret
    end
    id := http.Param(ctx, "id")
    body := http.Body(ctx)
    mut text := str.Trim(json.Get(body, "text"))
    mut files := Vector {} as Vector<aifiles.Upload>
    if not read_files(ctx, body, files):
        ret
    end
    if text.len() == 0 and files.len() == 0:
        fail(ctx, 400, "empty", "پیام خالی است.")
        ret
    end
    if text.len() > MAX_MESSAGE:
        mut problem := ""
        if not aifiles.AdoptText(text, "pasted-message.txt", files, problem, aiweb.English(ctx)):
            fail(ctx, 400, "too_long", problem)
            ret
        end
        text = ""
    end
    if own_chat(uid, id).len() == 0:
        fail(ctx, 404, "not_found", "این گفت‌وگو پیدا نشد.")
        ret
    end
    aistore.Lock()
    waiting := aistore.OneText("SELECT COUNT(*) FROM chat_queue WHERE chat_id = ?1", one(id))
    aistore.Unlock()
    if waiting.to_int() >= QUEUE_MAX:
        fail(ctx, 429, "queue_full", "صف این گفت‌وگو پر است. صبر کنید تا چند پیام اجرا شود یا بعضی را حذف کنید.")
        ret
    end
    if files.len() > 0 and not aifiles.Store(files, aistore.Now()):
        fail(ctx, 500, "file", "ذخیره‌ی فایل‌ها ناموفق بود. دوباره تلاش کنید.")
        ret
    end
    project := json.Get(body, "project")
    mut a := Vector {} as Vector<str>
    a.push(id)
    a.push(i64s(uid))
    a.push(text)
    a.push(aiweb.UiLangNote(ctx))
    a.push(str.StartsWith(project, "{") ? project : "")
    a.push(i64s(aistore.Now()))
    a.push(aiengine.Effort(json.Get(body, "effort")))
    aistore.Lock()
    ok := aistore.Run("INSERT INTO chat_queue (chat_id, user_id, body, ui_note, project, created, effort) VALUES (?1, ?2, ?3, ?4, ?5, ?6, ?7)", a)
    qid := aistore.LastId()
    aistore.Unlock()
    if not ok or not aifiles.Persist(qid, files):
        fail(ctx, 500, "server", "افزودن به صف ناموفق بود. دوباره تلاش کنید.")
        ret
    end
    queue_reply(ctx, 201, id, `"added": ` + qid)
end

