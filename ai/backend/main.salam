func send_message(ctx: i64):
    uid := need_user(ctx)
    if uid == 0:
        ret
    end
    id := http.Param(ctx, "id")
    body := http.Body(ctx)
    text := str.Trim(json.Get(body, "text"))
    mut files := Vector {} as Vector<aifiles.Upload>
    if body.find(`"files"`) >= 0:
        mut image_ok := false
        mut pdf_ok := false
        aiengine.Accepts(image_ok, pdf_ok)
        mut problem := ""
        if not aifiles.Parse(body, image_ok, pdf_ok, files, problem, aiweb.English(ctx)):
            fail(ctx, 400, "file", problem)
            ret
        end
    end
    if text.len() == 0 and files.len() == 0:
        fail(ctx, 400, "empty", "پیام خالی است.")
        ret
    end
    if text.len() > MAX_MESSAGE:
        fail(ctx, 400, "too_long", "پیام خیلی بلند است. آن را کوتاه‌تر کنید.")
        ret
    end
    owned := own_chat(uid, id)
    if owned.len() == 0:
        fail(ctx, 404, "not_found", "این گفت‌وگو پیدا نشد.")
        ret
    end
    mut sid := str.TrimSuffix(owned, "|")
    sync_pending(id, sid)
    t := i64s(aistore.Now())
    aistore.Lock()
    pending := aistore.OneText("SELECT COUNT(*) FROM messages WHERE chat_id = ?1 AND status = 'pending'", one(id))
    recent := aistore.OneText("SELECT COUNT(*) FROM messages m JOIN chats c ON c.id = m.chat_id WHERE c.user_id = ?1 AND m.role = 'user' AND m.created > ?2", two(i64s(uid), i64s(aistore.Now() - 3600)))
    title := aistore.OneText("SELECT title FROM chats WHERE id = ?1", one(id))
    mut rows := aistore.Stmt("SELECT device_id, workspace, bridge_token, cloud FROM chats WHERE id = ?1", one(id))
    mut device := "0"
    mut workspace := ""
    mut token := ""
    mut cloud := false
    if aistore.Next(rows):
        device = aistore.Text(rows, 0)
        workspace = aistore.Text(rows, 1)
        token = aistore.Text(rows, 2)
        cloud = aistore.Text(rows, 3) == "1"
    end
    aistore.Finish(rows)
    aistore.Unlock()
    if pending != "0":
        fail(ctx, 409, "busy", "هنوز پاسخ پیام قبلی کامل نشده است.")
        ret
    end
    limits := aibilling.LimitsOf(i64s(uid))
    if limits.chat_hourly > 0 and recent.to_int() >= limits.chat_hourly:
        fail(ctx, 429, "rate", "پیام‌های این ساعت پلن «" + limits.name + "» تمام شد. کمی بعد دوباره تلاش کنید یا پلن را ارتقا دهید.")
        ret
    end
    mut fresh := false
    if sid.len() == 0:
        fresh = true
        sid = aiengine.NewSession("chat " + id)
        if sid.len() == 0:
            fail(ctx, 503, "engine", "دستیار در دسترس نیست. چند لحظه بعد دوباره تلاش کنید.")
            ret
        end
        aistore.Lock()
        _s := aistore.Run("UPDATE chats SET engine_sid = ?1 WHERE id = ?2", two(sid, id))
        aistore.Unlock()
    end
    mut new_title := title
    if title == DEFAULT_TITLE:
        new_title = short_title(text.len() > 0 ? text : files.get(0).name)
    end
    if files.len() > 0 and not aifiles.Store(files, aistore.Now()):
        fail(ctx, 500, "file", "ذخیره‌ی فایل‌ها ناموفق بود. دوباره تلاش کنید.")
        ret
    end
    aistore.Lock()
    _a := aistore.Run("INSERT INTO messages (chat_id, role, body, status, created) VALUES (?1, 'user', ?2, 'done', ?3)", three(id, text, t))
    umid := aistore.LastId()
    _b := aistore.Run("INSERT INTO messages (chat_id, role, body, status, created) VALUES (?1, 'assistant', '', 'pending', ?2)", two(id, t))
    amid := aistore.LastId()
    _c := aistore.Run("UPDATE chats SET title = ?1, updated = ?2 WHERE id = ?3", three(new_title, t, id))
    aistore.Unlock()
    if not aifiles.Record(id, umid, i64s(uid), files, t):
        aistore.Lock()
        _x := aistore.Run("DELETE FROM message_files WHERE message_id = ?1", one(umid))
        _y := aistore.Run("DELETE FROM messages WHERE id = ?1 OR id = ?2", two(umid, amid))
        aistore.Unlock()
        fail(ctx, 500, "file", "ذخیره‌ی فایل‌ها ناموفق بود. دوباره تلاش کنید.")
        ret
    end
    recall := fresh ? aimemory.Recall(i64s(uid), id) : ""
    prompt := aiweb.UiLangNote(ctx) + aifiles.PromptText(aipolicy.Defang(text), files) + recall + aipolicy.Reminder()
    parts := aifiles.Parts(files)
    ailive.Begin(sid)
    forget_check(sid)
    mut sent := false
    if device != "0" and token.len() > 0:
        sent = aiengine.SendDesktop(sid, desktop_preamble(uid, device, workspace, token) + project_block(id, body, fresh) + prompt, parts)
    else cloud and token.len() > 0:
        sent = aiengine.SendDesktop(sid, aicloud.Prelude(token, i64s(uid)) + prompt, parts)
    else:
        sent = aiengine.Send(sid, prompt, parts)
    end
    if not sent:
        ailive.End(sid)
        aistore.Lock()
        _e := aistore.Run("UPDATE messages SET status = 'error', body = ?1 WHERE id = ?2", two("دستیار در دسترس نیست. چند لحظه بعد دوباره تلاش کنید.", amid))
        aistore.Unlock()
        fail(ctx, 503, "engine", "دستیار در دسترس نیست. چند لحظه بعد دوباره تلاش کنید.")
        ret
    end
    mut m := Vector {} as Vector<str>
    m.push(json.MemberRaw("user", with_files(message_json(umid, "user", text, "done", t, "[]", "0"), files.len() > 0 ? aifiles.Metas(files) : "")))
    m.push(json.MemberRaw("assistant", message_json(amid, "assistant", "", "pending", t, "[]", "0")))
    m.push(json.Member("title", new_title))
    reply(ctx, 201, json.Object(m))
end

