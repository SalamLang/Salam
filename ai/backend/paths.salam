package aipaths

import str

pub const MAX := 1000

func letter(c: int): bool:
    ret (c >= 65 and c <= 90) or (c >= 97 and c <= 122)
end

func absolute(p: str): bool:
    if p.Len() == 0:
        ret false
    end
    if p[0] as int == 47:
        ret true
    end
    if p.Len() >= 3 and letter(p[0] as int) and p[1] as int == 58 and (p[2] as int == 92 or p[2] as int == 47):
        ret true
    end
    ret p.Len() >= 3 and p[0] as int == 92 and p[1] as int == 92
end

func climbs(p: str): bool:
    mut seg := 0
    mut i := 0
    until i <= p.Len():
        c := i < p.Len() ? p[i] as int : 47
        if c == 47 or c == 92:
            if i - seg == 2 and p[seg] as int == 46 and p[seg + 1] as int == 46:
                ret true
            end
            seg = i + 1
        end
        i++
    end
    ret false
end

pub func Clean(raw: str): str:
    mut p := str.Trim(raw)
    if p.Len() == 0 or p.Len() > MAX:
        ret ""
    end
    mut i := 0
    until i < p.Len():
        c := p[i] as int
        if c < 32 or c == 127:
            ret ""
        end
        i++
    end
    if not absolute(p):
        ret ""
    end
    if climbs(p):
        ret ""
    end
    until p.Len() > 1 and (p[p.Len() - 1] as int == 47 or p[p.Len() - 1] as int == 92) and not (p.Len() == 3 and p[1] as int == 58):
        p = p.substr(0, p.Len() - 1)
    end
    ret p
end
