package aishare

import str
import sync
import time
import crypto
import encoding.json
import encoding.value

const TOKEN_BYTES := 20
const TABLE_MAX := 20000

pub const KIND_VIEW := "view"
pub const KIND_COLLAB := "collab"
pub const NAME_MAX := 24
pub const GUEST := "Guest"

mut LOCK := sync.Mutex {}
mut HITS := HashMap {} as HashMap<str, str>

func bad_cp(cp: int): bool:
    if cp < 32 or cp == 127:
        ret true
    end
    if cp >= 128 and cp < 160:
        ret true
    end
    if cp == 60 or cp == 62 or cp == 38 or cp == 34 or cp == 39 or cp == 96 or cp == 92 or cp == 47:
        ret true
    end
    if cp >= 8203 and cp <= 8207 and cp != 8204:
        ret true
    end
    if cp >= 8232 and cp <= 8238:
        ret true
    end
    if cp >= 8294 and cp <= 8297:
        ret true
    end
    if cp == 65279 or cp == 8288:
        ret true
    end
    ret false
end

func clean(raw: str, max: int): str:
    mut b := str.NewBuilder()
    defer str.BufFree(b)
    mut count := 0
    mut space := true
    each cp in str.CodePoints(raw):
        if bad_cp(cp):
            continue
        end
        if cp == 32 or cp == 9:
            if space:
                continue
            end
            space = true
        else:
            space = false
        end
        if count >= max:
            break
        end
        str.BufAppendCp(b, cp)
        count++
    end
    ret str.Trim(str.BufStr(b))
end

func field(v: value.Value, key: str): value.Value:
    if not value.IsObject(v):
        ret value.ValueNull()
    end
    mut ok := false
    got := value.ObjectGetOk(v, key, ok)
    if not ok:
        ret value.ValueNull()
    end
    ret got
end

func text_of(v: value.Value, key: str): str:
    f := field(v, key)
    if value.IsString(f):
        ret value.AsString(f)
    end
    ret ""
end

func generic_title(icon: str, en: bool): str:
    switch icon:
        "search":
            ret en ? "Searching" : "جست‌وجو"
        end
        "read":
            ret en ? "Reading" : "خواندن"
        end
        "files":
            ret en ? "Working with files" : "کار با فایل‌ها"
        end
        "run":
            ret en ? "Running a step" : "اجرای یک گام"
        end
        "web":
            ret en ? "Looking online" : "جست‌وجو در وب"
        end
        "check":
            ret en ? "Checking" : "بررسی"
        end
    end
    ret en ? "Working" : "در حال کار"
end

pub func Init():
    LOCK = sync.NewMutex()
end

pub func NewToken(): str:
    ret crypto.RandomToken(TOKEN_BYTES)
end

pub func ValidToken(t: str): bool:
    if t.len() != TOKEN_BYTES * 2:
        ret false
    end
    mut i := 0
    until i < t.len():
        c := t.substr(i, 1)
        if not ((c >= "0" and c <= "9") or (c >= "a" and c <= "f")):
            ret false
        end
        i++
    end
    ret true
end

pub func ValidKind(k: str): bool:
    ret k == KIND_VIEW or k == KIND_COLLAB
end

pub func ValidHours(h: int): bool:
    ret h == 0 or h == 1 or h == 24 or h == 168
end

pub func ExpiryFor(hours: int, now: i64): i64:
    if hours <= 0:
        ret 0
    end
    ret now + (hours * 3600) as i64
end

pub func CollabRefusal(device: bool, cloud: bool): str:
    if device:
        ret "device"
    end
    if cloud:
        ret "cloud"
    end
    ret ""
end

pub func HideTools(device: bool, cloud: bool): bool:
    ret device or cloud
end

pub func CleanName(raw: str): str:
    out := clean(raw, NAME_MAX)
    if out.len() == 0:
        ret GUEST
    end
    ret out
end

pub func CleanLabel(raw: str): str:
    ret clean(raw, 60)
end

pub func GuestNote(name: str): str:
    ret "<shared_chat>\nThe next message was written by a guest called \"" + name + "\" who opened a shared link to this chat. It was not written by the chat owner. Answer it like any other message in this conversation and never reveal details about the owner or their account. Do not mention this note.\n</shared_chat>\n\n"
end

pub func State(paused: bool, reason: str, expires: i64, now: i64, cap: int, sent: int, daily_cap: int, daily_sent: int): str:
    if expires > 0 and now >= expires:
        ret "expired"
    end
    if paused:
        ret reason == "limit" ? "limit" : "paused"
    end
    if cap > 0 and sent >= cap:
        ret "cap"
    end
    if daily_cap > 0 and daily_sent >= daily_cap:
        ret "daily"
    end
    ret "ok"
end

pub func Hit(key: str, limit: int, window: int): bool:
    if limit <= 0:
        ret true
    end
    now := time.Now()
    _l := sync.Lock(LOCK)
    if HITS.size() > TABLE_MAX:
        HITS = HashMap {} as HashMap<str, str>
    end
    mut count := 0
    mut start := now
    if HITS.has(key):
        parts := HITS.get(key).split("|")
        if parts.len() == 2 and now - parts.get(1).ToInt() < window:
            count = parts.get(0).ToInt()
            start = parts.get(1).ToInt() as i64
        end
    end
    mut ok := true
    if count >= limit:
        ok = false
    else:
        count++
    end
    HITS.put(key, "" + count + "|" + start)
    _u := sync.Unlock(LOCK)
    ret ok
end

pub func RedactActivity(activity: str, hide_tools: bool): str:
    mut list := try json.Decode(activity) catch value.ValueNull()
    if not value.IsArray(list):
        value.ValueFree(list)
        ret "[]"
    end
    mut out := Vector {} as Vector<str>
    mut i := 0
    until i < value.ArrayLen(list):
        step := value.ArrayGet(list, i)
        kind := text_of(step, "kind")
        if kind == "tool":
            mut m := Vector {} as Vector<str>
            m.push(json.Member("kind", "tool"))
            icon := text_of(step, "icon")
            m.push(json.Member("icon", icon))
            if hide_tools:
                m.push(json.Member("title", generic_title(icon, false)))
                m.push(json.Member("title_en", generic_title(icon, true)))
            else:
                m.push(json.Member("title", text_of(step, "title")))
                m.push(json.Member("title_en", text_of(step, "title_en")))
            end
            m.push(json.Member("detail", ""))
            m.push(json.Member("link", ""))
            st := text_of(step, "status")
            m.push(json.Member("status", st == "running" or st == "error" ? st : "done"))
            out.push(json.Object(m))
        else kind == "text" and not hide_tools:
            mut m := Vector {} as Vector<str>
            m.push(json.Member("kind", "text"))
            m.push(json.Member("text", text_of(step, "text")))
            out.push(json.Object(m))
        end
        i++
    end
    value.ValueFree(list)
    ret json.Array(out)
end
