    tables.Push("ALTER TABLE sessions ADD COLUMN IF NOT EXISTS os VARCHAR(16) NOT NULL DEFAULT '', ADD COLUMN IF NOT EXISTS os_version VARCHAR(64) NOT NULL DEFAULT '', ADD COLUMN IF NOT EXISTS arch VARCHAR(16) NOT NULL DEFAULT ''")
    tables.Push("ALTER TABLE sessions ADD COLUMN IF NOT EXISTS hints VARCHAR(700) NOT NULL DEFAULT '', ADD COLUMN IF NOT EXISTS device VARCHAR(600) NOT NULL DEFAULT ''")
    tables.Push("CREATE TABLE IF NOT EXISTS shares (id BIGINT AUTO_INCREMENT PRIMARY KEY, chat_id CHAR(24) NOT NULL, user_id BIGINT NOT NULL, kind VARCHAR(8) NOT NULL, token_hash CHAR(64) NOT NULL UNIQUE, token_enc TEXT NOT NULL, label VARCHAR(80) NOT NULL DEFAULT '', created BIGINT NOT NULL, expires BIGINT NOT NULL DEFAULT 0, paused TINYINT NOT NULL DEFAULT 0, pause_reason VARCHAR(8) NOT NULL DEFAULT '', max_messages INT NOT NULL DEFAULT 0, max_daily INT NOT NULL DEFAULT 0, last_used BIGINT NOT NULL DEFAULT 0, views BIGINT NOT NULL DEFAULT 0, UNIQUE KEY shares_chat_kind (chat_id, kind), INDEX shares_user (user_id, chat_id), CONSTRAINT shares_chat_fk FOREIGN KEY (chat_id) REFERENCES chats(id) ON DELETE CASCADE) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci")
    tables.Push("ALTER TABLE messages ADD COLUMN IF NOT EXISTS share_id BIGINT NOT NULL DEFAULT 0, ADD COLUMN IF NOT EXISTS guest VARCHAR(40) NOT NULL DEFAULT ''")
    tables.Push("CREATE INDEX IF NOT EXISTS messages_share ON messages (share_id, role, created)")
    tables.Push("CREATE TABLE IF NOT EXISTS projects (id CHAR(24) PRIMARY KEY, user_id BIGINT NOT NULL, name VARCHAR(120) NOT NULL, description VARCHAR(1000) NOT NULL DEFAULT '', color VARCHAR(16) NOT NULL DEFAULT '', emoji VARCHAR(16) NOT NULL DEFAULT '', pinned TINYINT NOT NULL DEFAULT 0, created BIGINT NOT NULL, updated BIGINT NOT NULL, INDEX projects_user (user_id, updated), CONSTRAINT projects_user_fk FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci")
    tables.Push("ALTER TABLE chats ADD COLUMN IF NOT EXISTS project_id CHAR(24) NOT NULL DEFAULT ''")
    tables.Push("CREATE INDEX IF NOT EXISTS chats_project ON chats (project_id, updated)")
    tables.Push("ALTER TABLE projects ADD COLUMN IF NOT EXISTS archived TINYINT NOT NULL DEFAULT 0")
    tables.Push("ALTER TABLE projects ADD COLUMN IF NOT EXISTS path VARCHAR(1000) NOT NULL DEFAULT ''")
    tables.Push("ALTER TABLE chats ADD COLUMN IF NOT EXISTS extra_path VARCHAR(1000) NOT NULL DEFAULT ''")
    tables.Push("ALTER TABLE projects ADD COLUMN IF NOT EXISTS master_prompt MEDIUMTEXT NULL")
    tables.Push("ALTER TABLE users ADD COLUMN IF NOT EXISTS master_prompt MEDIUMTEXT NULL")
    tables.Push("ALTER TABLE chats ADD COLUMN IF NOT EXISTS ext_id VARCHAR(64) NOT NULL DEFAULT '', ADD COLUMN IF NOT EXISTS import_id BIGINT NOT NULL DEFAULT 0")
    tables.Push("CREATE INDEX IF NOT EXISTS chats_ext ON chats (user_id, ext_id)")
    tables.Push("CREATE INDEX IF NOT EXISTS chats_import ON chats (import_id)")
    tables.Push("CREATE TABLE IF NOT EXISTS imports (id BIGINT AUTO_INCREMENT PRIMARY KEY, user_id BIGINT NOT NULL, fingerprint VARCHAR(64) NOT NULL DEFAULT '', filename VARCHAR(200) NOT NULL DEFAULT '', status VARCHAR(12) NOT NULL, parts INT NOT NULL DEFAULT 0, received INT NOT NULL DEFAULT 0, parts_done INT NOT NULL DEFAULT 0, vault CHAR(32) NOT NULL, bytes BIGINT NOT NULL DEFAULT 0, raw_bytes BIGINT NOT NULL DEFAULT 0, chats INT NOT NULL DEFAULT 0, messages INT NOT NULL DEFAULT 0, memories INT NOT NULL DEFAULT 0, skipped INT NOT NULL DEFAULT 0, existing INT NOT NULL DEFAULT 0, projects INT NOT NULL DEFAULT 0, instructions INT NOT NULL DEFAULT 0, error VARCHAR(300) NOT NULL DEFAULT '', created BIGINT NOT NULL, updated BIGINT NOT NULL, finished BIGINT NOT NULL DEFAULT 0, INDEX imports_user (user_id, id), INDEX imports_status (status, id), CONSTRAINT imports_user_fk FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci")
    tables.Push("CREATE TABLE IF NOT EXISTS import_parts (import_id BIGINT NOT NULL, n INT NOT NULL, kind VARCHAR(16) NOT NULL, name VARCHAR(100) NOT NULL DEFAULT '', sha CHAR(64) NOT NULL, size BIGINT NOT NULL, file CHAR(32) NOT NULL, created BIGINT NOT NULL, PRIMARY KEY (import_id, n), CONSTRAINT import_parts_fk FOREIGN KEY (import_id) REFERENCES imports(id) ON DELETE CASCADE) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci")
    tables.Push("CREATE TABLE IF NOT EXISTS discount_codes (id BIGINT AUTO_INCREMENT PRIMARY KEY, code VARCHAR(32) NOT NULL, kind VARCHAR(8) NOT NULL, value BIGINT NOT NULL, user_id BIGINT NOT NULL DEFAULT 0, max_users INT NOT NULL DEFAULT 0, max_uses INT NOT NULL DEFAULT 0, expires BIGINT NOT NULL DEFAULT 0, active TINYINT NOT NULL DEFAULT 1, note VARCHAR(255) NOT NULL DEFAULT '', created_by BIGINT NOT NULL DEFAULT 0, created BIGINT NOT NULL, UNIQUE KEY discount_codes_code (code), INDEX discount_codes_user (user_id)) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci")
    tables.Push("CREATE TABLE IF NOT EXISTS discount_redemptions (id BIGINT AUTO_INCREMENT PRIMARY KEY, code_id BIGINT NOT NULL, user_id BIGINT NOT NULL, payment_id BIGINT NOT NULL DEFAULT 0, created BIGINT NOT NULL, INDEX discount_redemptions_code (code_id), INDEX discount_redemptions_user (code_id, user_id), CONSTRAINT discount_redemptions_code_fk FOREIGN KEY (code_id) REFERENCES discount_codes(id) ON DELETE CASCADE, CONSTRAINT discount_redemptions_user_fk FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci")
    tables.Push("ALTER TABLE payments ADD COLUMN IF NOT EXISTS discount_code_id BIGINT NOT NULL DEFAULT 0, ADD COLUMN IF NOT EXISTS discount_amount BIGINT NOT NULL DEFAULT 0")
    tables.Push("ALTER TABLE subscriptions ADD COLUMN IF NOT EXISTS discount_code_id BIGINT NOT NULL DEFAULT 0")
    tables.Push("ALTER TABLE payments ADD COLUMN IF NOT EXISTS campaign_vid VARCHAR(80) NOT NULL DEFAULT '', ADD COLUMN IF NOT EXISTS campaign_source VARCHAR(80) NOT NULL DEFAULT '', ADD COLUMN IF NOT EXISTS campaign_medium VARCHAR(80) NOT NULL DEFAULT '', ADD COLUMN IF NOT EXISTS campaign_name VARCHAR(80) NOT NULL DEFAULT '', ADD COLUMN IF NOT EXISTS campaign_term VARCHAR(80) NOT NULL DEFAULT '', ADD COLUMN IF NOT EXISTS campaign_content VARCHAR(80) NOT NULL DEFAULT ''")
    tables.Push("ALTER TABLE chats ADD COLUMN IF NOT EXISTS client_os VARCHAR(40) NOT NULL DEFAULT '', ADD COLUMN IF NOT EXISTS client_browser VARCHAR(60) NOT NULL DEFAULT '', ADD COLUMN IF NOT EXISTS client_version VARCHAR(32) NOT NULL DEFAULT '', ADD COLUMN IF NOT EXISTS client_arch VARCHAR(16) NOT NULL DEFAULT ''")
    tables.Push("ALTER TABLE messages ADD COLUMN IF NOT EXISTS model VARCHAR(80) NOT NULL DEFAULT ''")
    each sql in tables:
        if mysql.Exec(DB, sql) != 0:
            ret false
        end
    end
    _svc := mysql.Exec(DB, "INSERT IGNORE INTO oauth_clients (id, kind, name, uri, logo, redirects, created) VALUES ('salam-ai', 'svc', 'دستیار سلام', 'https://ai.salamlang.ir', '', '[]', UNIX_TIMESTAMP())")
    ret true
end

pub func Error(): str:
    ret mysql.Error(DB)
end

pub func Now(): i64:
    ret time.Now()
end

pub func DayStart(): i64:
    t := time.Now()
    ret t - ((t + 12600) % 86400)
end

pub func WeekStart(): i64:
    t := time.Now()
    days := (t + 12600) / 86400
    ret DayStart() - ((days + 5) % 7) * 86400
end

pub func Stmt(sql: str, args: Vector<str>): mysql.Result:
    ensure()
    mut res := mysql.Query(DB, bind(sql, args))
    if not mysql.QueryOk(res) and lost():
        ensure()
        res = mysql.Query(DB, bind(sql, args))
    end
    ret res
end

pub func Run(sql: str, args: Vector<str>): bool:
    ensure()
    mut rc := mysql.Exec(DB, bind(sql, args))
    if rc != 0 and lost():
        ensure()
        rc = mysql.Exec(DB, bind(sql, args))
    end
    ret rc == 0
end

pub func LastId(): str:
    ret "" + mysql.LastInsertId(DB)
end

pub func OneText(sql: str, args: Vector<str>): str:
    mut rows := Stmt(sql, args)
    mut out := ""
    if mysql.Next(rows):
        out = mysql.Text(rows, 0)
    end
    mysql.Finish(rows)
    ret out
end

pub func Lock():
    _l := sync.Lock(LOCK)
end

pub func Unlock():
    _u := sync.Unlock(LOCK)
end

pub func Next(rows &: mysql.Result): bool:
    ret mysql.Next(rows)
end

pub func Text(rows: mysql.Result, col: int): str:
    ret mysql.Text(rows, col)
end

pub func Int64(rows: mysql.Result, col: int): i64:
    ret mysql.Int64(rows, col)
end

pub func Finish(rows: mysql.Result):
    mysql.Finish(rows)
end
