import mem

include ailimits "../limits.salam"

mut FAILED := 0

func same(name: str, got: i64, want: i64):
    if got != want:
        println "FAIL", name, "got", got, "want", want
        FAILED += 1
    end
end

func same_text(name: str, got: str, want: str):
    if got != want:
        println "FAIL", name, "got", got, "want", want
        FAILED += 1
    end
end

func audio_kind(head: str): str:
    buf := mem.AllocateZeroed(16 as u64)
    mut i := 0
    until i < head.len():
        (buf as u8*)[i] = head[i] as u8
        i += 1
    end
    kind := ailimits.AudioContainer(buf, head.len())
    mem.Free(buf)
    ret kind
end

func main(): int:
    same("chat default", ailimits.Pick(false, "free", 600 as i64, 3600 as i64, 43200 as i64), 600 as i64)
    same("agent default", ailimits.Pick(true, "pro", 600 as i64, 3600 as i64, 43200 as i64), 3600 as i64)
    same("unlimited chat", ailimits.Pick(false, "unlimited", 600 as i64, 3600 as i64, 43200 as i64), 43200 as i64)
    same("unlimited agent", ailimits.Pick(true, "unlimited", 600 as i64, 3600 as i64, 43200 as i64), 43200 as i64)
    same("unlimited env lower", ailimits.Pick(true, "unlimited", 600 as i64, 3600 as i64, 7200 as i64), 7200 as i64)
    same("unlimited env too high", ailimits.Pick(true, "unlimited", 600 as i64, 3600 as i64, 999999 as i64), 43200 as i64)
    same("unlimited env zero", ailimits.Pick(false, "unlimited", 600 as i64, 3600 as i64, 0 as i64), 43200 as i64)
    same("agent env too high", ailimits.Pick(true, "plus", 600 as i64, 999999 as i64, 43200 as i64), 43200 as i64)
    same("chat env zero", ailimits.Pick(false, "plus", 0 as i64, 3600 as i64, 43200 as i64), 600 as i64)
    same_text("speech within limits", ailimits.SpeechVerdict(29, 599, 30, 600), "")
    same_text("speech requests used up", ailimits.SpeechVerdict(30, 0, 30, 600), "requests")
    same_text("speech seconds used up", ailimits.SpeechVerdict(1, 600, 30, 600), "seconds")
    same_text("speech limits off", ailimits.SpeechVerdict(1000, 100000, 0, 0), "")
    same_text("webm is audio", audio_kind("\x1a\x45\xdf\xa3........"), "matroska")
    same_text("ogg is audio", audio_kind("OggS........"), "ogg")
    same_text("mp4 is audio", audio_kind("....ftypisom"), "mp4")
    same_text("short is not audio", audio_kind("OggS"), "")
    same_text("png is not audio", audio_kind("PNGPNGPNGPNG"), "")
    same_text("text is not audio", audio_kind("hello, this is text"), "")
    if FAILED > 0:
        println FAILED, "failed"
        ret 1
    end
    println "ok"
    ret 0
end
