include aimodels "../models.salam"

mut FAILED := 0

func same(name: str, got: str, want: str):
    if got != want:
        println "FAIL", name, "got", got, "want", want
        FAILED += 1
    end
end

func main(): int:
    aimodels.Configure("", "p/b")
    same("fallbacks alone are not managed", aimodels.Managed() ? "yes" : "no", "no")
    aimodels.Configure("p/a, p/b, bad", "p/b,q/c")
    same("pool size", "" + aimodels.Count(), "3")
    same("first healthy", aimodels.Ready(1000), "p/a")
    aimodels.Fail("p/a", 1000)
    same("skips cooling", aimodels.Ready(2000), "p/b")
    same("returns after hold", aimodels.Ready(200000), "p/a")
    aimodels.Fail("p/a", 200000)
    same("second fail holds longer", aimodels.Ready(200000 + 200000), "p/b")
    aimodels.Ok("p/a")
    same("success clears", aimodels.Ready(200001), "p/a")
    aimodels.Fail("p/a", 5000)
    aimodels.Fail("p/b", 5000)
    aimodels.Fail("q/c", 6000)
    same("all cooling has no ready", aimodels.Ready(7000), "")
    same("pick still answers", aimodels.Pick(7000), "p/a")
    same("unknown ignored", aimodels.Owns("x/y") ? "yes" : "no", "no")
    if FAILED > 0:
        println FAILED, "failed"
        ret 1
    end
    println "ok"
    ret 0
end
