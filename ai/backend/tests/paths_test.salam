import str

include aipaths "../paths.salam"

mut FAILED := 0

func same_text(name: str, got: str, want: str):
    if got != want:
        println "FAIL", name, "got", got, "want", want
        FAILED++
    end
end

func main(): int:
    same_text("posix", aipaths.Clean("/home/ali/app"), "/home/ali/app")
    same_text("trim", aipaths.Clean("  /home/ali/app  "), "/home/ali/app")
    same_text("trailing slash", aipaths.Clean("/home/ali/app/"), "/home/ali/app")
    same_text("root", aipaths.Clean("/"), "/")
    same_text("windows", aipaths.Clean("C:\\Users\\Ali\\app"), "C:\\Users\\Ali\\app")
    same_text("windows root", aipaths.Clean("C:\\"), "C:\\")
    same_text("unc", aipaths.Clean("\\\\server\\share"), "\\\\server\\share")
    same_text("dots in names", aipaths.Clean("/home/a..b/.hidden/..x"), "/home/a..b/.hidden/..x")
    same_text("relative", aipaths.Clean("src/app"), "")
    same_text("home tilde", aipaths.Clean("~/app"), "")
    same_text("dot", aipaths.Clean("."), "")
    same_text("climb", aipaths.Clean("/home/ali/../root"), "")
    same_text("climb end", aipaths.Clean("/home/ali/.."), "")
    same_text("climb windows", aipaths.Clean("C:\\a\\..\\b"), "")
    same_text("control", aipaths.Clean("/home/a\x01b"), "")
    same_text("newline", aipaths.Clean("/home/a\nb"), "")
    same_text("empty", aipaths.Clean("   "), "")
    same_text("too long", aipaths.Clean("/" + str.Repeat("a", 1001)), "")
    if FAILED > 0:
        println FAILED, "failed"
        ret 1
    end
    println "ok"
    ret 0
end
