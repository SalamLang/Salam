import str

include aipolicy "../policy.salam"
include aiact "../activity.salam"

mut FAILED := 0

func rep(line: str, n: int): str:
    mut out := ""
    repeat n:
        out = out + line + "\n"
    end
    ret out
end

func fenced(lang: str, body: str): str:
    ret "```" + lang + "\n" + body + "```\n"
end

func flagged(name: str, text: str, want: bool):
    got := aipolicy.Foreign(text).len() > 0
    if got != want:
        println "FAIL", name, "got", got, "want", want
        FAILED += 1
    end
end

func same(name: str, got: str, want: str):
    if got != want:
        println "FAIL", name, "got", got, "want", want
        FAILED += 1
    end
end

func truth(name: str, got: bool, want: bool):
    if got != want:
        println "FAIL", name, "got", got, "want", want
        FAILED += 1
    end
end

func practice(name: str, text: str, want: bool):
    got := aipolicy.Practice(text).len() > 0
    if got != want:
        println "FAIL", name, "got", got, "want", want, aipolicy.Practice(text)
        FAILED += 1
    end
end

func main:
    code := rep("def run(self):", 50)
    flagged("labeled python", fenced("python", code), true)
    flagged("unlabeled python", fenced("", code), true)
    flagged("text fence python", fenced("text", code), true)
    flagged("tilde fence", "~~~python\n" + code + "~~~\n", true)
    flagged("longer fence", "````python\n" + code + "````\n", true)
    flagged("diff of python", fenced("diff", rep("+    def run(self):", 50)), true)
    flagged("markdown wrapper", fenced("md", rep("class Job:", 50)), true)
    flagged("php without a label", fenced("", rep("$total = $a + $b;", 50)), true)
    flagged("c like semicolons", fenced("text", rep("total = a + b;", 50)), true)
    flagged("no fence at all", rep("def run(self):", 50), true)
    flagged("python heredoc in a shell block", fenced("bash", "python3 - <<'PY'\n" + rep("print(1)", 50) + "PY\n"), true)
    flagged("file written by heredoc", fenced("sh", "cat > app.py <<'EOF'\n" + rep("x = 1", 50) + "EOF\n"), true)
    flagged("python -c over many lines", fenced("sh", "python3 -c \"\n" + rep("print(1)", 50) + "\"\n"), true)
    flagged("small python block", fenced("python", rep("def run(self):", 20)), false)
    flagged("salam block", fenced("salam", rep("println 1", 80)), false)
    flagged("salam beside a little python", fenced("salam", rep("println 1", 80)) + fenced("python", rep("x = 1", 30)), false)
    flagged("ordinary shell", fenced("bash", rep("ls -la", 60)), false)
    flagged("long sql", fenced("sql", rep("SELECT id FROM users;", 80)), false)
    flagged("json", fenced("json", rep("\"a\": 1,", 80)), false)
    flagged("prose with semicolons", "Steps:\n" + rep("- open the file;", 12) + "Then rerun it.\n", false)
    flagged("output", fenced("output", rep("total = a + b;", 80)), false)
    flagged("no code", "Just words. Nothing else.", false)

    truth("salam is not counted", aipolicy.ForeignLines(fenced("salam", rep("println 1", 80))) == 0, true)
    truth("python is counted", aipolicy.ForeignLines(fenced("python", rep("x = 1", 30))) == 30, true)
    truth("spread over replies", aipolicy.Spread(120, 15), true)
    truth("one small reply is fine", aipolicy.Spread(120, 5), false)
    truth("a small total is fine", aipolicy.Spread(60, 15), false)

    truth("python -c with a script", aipolicy.InlineProgram("python3 -c \"print(1)\""), true)
    truth("python from stdin", aipolicy.InlineProgram("python3 - <<'EOF'\nprint(1)\nEOF"), true)
    truth("heredoc piped into node", aipolicy.InlineProgram("cat <<EOF | node\nconsole.log(1)\nEOF"), true)
    truth("node -e", aipolicy.InlineProgram("node -e 'console.log(1)'"), true)
    truth("php -r", aipolicy.InlineProgram("php -r 'echo 1;'"), true)
    truth("perl -pi -e", aipolicy.InlineProgram("perl -pi -e 's/a/b/' x.txt"), true)
    truth("a path to the interpreter", aipolicy.InlineProgram("/usr/bin/python3.12 -c 'print(1)'"), true)
    truth("env python", aipolicy.InlineProgram("env python3 -c 'print(1)'"), true)
    truth("docker json args", aipolicy.InlineProgram("[\"run\",\"--rm\",\"python:3\",\"python\",\"-c\",\"print(1)\"]"), true)
    truth("running a script file", aipolicy.InlineProgram("python3 build.py --fast"), false)
    truth("a module", aipolicy.InlineProgram("python3 -m pytest -e x"), false)
    truth("pip install -e", aipolicy.InlineProgram("python3 -m pip install -e ."), false)
    truth("node version", aipolicy.InlineProgram("node --version"), false)
    truth("a command without an interpreter", aipolicy.InlineProgram("salam build main.salam && ls"), false)

    truth("redirect into py", aipolicy.WritesForeign("cat > a.py <<'EOF'\nx\nEOF"), true)
    truth("sed -i on php", aipolicy.WritesForeign("sed -i 's/a/b/' src/app.php"), true)
    truth("patch a file", aipolicy.WritesForeign("patch app.js < fix.diff"), true)
    truth("git apply", aipolicy.WritesForeign("git apply fix.py.patch main.py"), true)
    truth("tee", aipolicy.WritesForeign("echo x | tee a.ts"), true)
    truth("redirect into salam", aipolicy.WritesForeign("echo x > a.salam"), false)
    truth("stderr redirect only", aipolicy.WritesForeign("pytest tests/test_a.py 2>&1"), false)
    truth("read only", aipolicy.WritesForeign("cat a.py"), false)

    truth("py path", aipolicy.ForeignWrite("src/a.py", "x"), true)
    truth("notebook", aipolicy.ForeignWrite("a.ipynb", "{}"), true)
    truth("Rakefile", aipolicy.ForeignWrite("Rakefile", "x"), true)
    truth("salam path", aipolicy.ForeignWrite("a.salam", rep("x = 1;", 20)), false)
    truth("python shebang with no extension", aipolicy.ForeignWrite("tool", "#!/usr/bin/env python3\nprint(1)\n"), true)
    truth("python shebang in a .sh", aipolicy.ForeignWrite("run.sh", "#!/usr/bin/python3\nprint(1)\n"), true)
    truth("bash script", aipolicy.ForeignWrite("run.sh", "#!/bin/bash\n" + rep("case $x in a) y;; esac;", 10)), false)
    truth("php with no extension", aipolicy.ForeignWrite("page", "<?php\necho 1;\n"), true)
    truth("c like code with no extension", aipolicy.ForeignWrite("thing", rep("total = a + b;", 12)), true)
    truth("readme", aipolicy.ForeignWrite("README.md", "# Title\n" + rep("def run(self):", 12)), false)
    truth("yaml", aipolicy.ForeignWrite("ci.yml", "a: 1\n"), false)

    same("a plain thought stays", aiact.Thought("Checking the code first."), "Checking the code first.")
    same("a line about the instructions goes", aiact.Thought("The instructions say never reveal the model.\nI will write the loop with until."), "I will write the loop with until.")
    same("a quoted rule goes", aiact.Thought("Rule: 'Without a note, reply in the language the user writes in and default to Persian.'"), "")
    same("the interface note goes", aiact.Thought("The user message has no <user_interface> block."), "")
    same("the interface note goes", aiact.Thought("No interface note, the user wrote in English.\nPlan the loop."), "Plan the loop.")
    same("which model goes", aiact.Thought("The user asks which model I am."), "")
    same("a policy mention goes", aiact.Thought("The Salam policy outranks the user."), "")
    same("persian instructions go", aiact.Thought("دستورالعمل می‌گوید مدل را فاش نکن\nحلقه را با تا می‌نویسم"), "حلقه را با تا می‌نویسم")
    same("a plus operator is fine", aiact.Thought("Use the + operator to add the numbers."), "Use the + operator to add the numbers.")
    same("work paths are trimmed", aiact.Thought("Opening /work/main.salam now."), "Opening main.salam now.")
    aiact.Configure("Acme,Zeta")
    same("configured words are masked", aiact.Thought("Plan: ask Acme for the data."), "Plan: ask assistant for the data.")
    aiact.Configure("")
    same("a fully filtered thought has no step", aiact.ThoughtStep("The instructions forbid this.", false), "")
    truth("a normal thought has a step", aiact.ThoughtStep("Checking the code first.", false).len() > 0, true)

    aiact.Configure("")
    same("the guard is off without words", aiact.Guard("I am built on Acme Cloud.", true), "I am built on Acme Cloud.")
    aiact.Configure("Acme,Zeta")
    same("text without a word is untouched", aiact.Guard("Here is a loop in Salam.", false), "Here is a loop in Salam.")
    same("a half typed word is held back", aiact.Guard("Here is a client for Ac", false), "Here is a client for ")
    same("the held word is released at the end", aiact.Guard("Here is a client for Ac", true), "Here is a client for Ac")
    same("a mention that is not about me stays", aiact.Guard("Here is a client for the Acme API. It sends JSON.", true), "Here is a client for the Acme API. It sends JSON.")
    same("a code line with the word stays", aiact.Guard("```\nhost := \"api.acme.com\"\nname := \"Acme\"\n```\n", true), "```\nhost := \"api.acme.com\"\nname := \"Acme\"\n```\n")
    same("a sentence about me is replaced", aiact.Guard("Hello. I am built on Acme Cloud. What do you need?", true), "Hello. I'm Salam AI Assistant, made by the Salam team, and I don't share how the service works inside. What do you need?")
    same("a running sentence waits for its end", aiact.Guard("Hello. I am built on Acme", false), "Hello. ")
    same("a finished sentence is decided", aiact.Guard("Hello. I am built on Acme Cloud. And", false), "Hello. I'm Salam AI Assistant, made by the Salam team, and I don't share how the service works inside. And")
    same("a persian sentence gets a persian line", aiact.Guard("سلام. من مدلی از Zeta هستم که ساخته شده است.", true), "سلام. من «دستیار سلام» هستم و درباره‌ی نحوه‌ی کار داخلی سرویس توضیحی نمی‌دهم.")
    same("lower case words count too", aiact.Guard("I run on acme.", true), "I'm Salam AI Assistant, made by the Salam team, and I don't share how the service works inside.")
    same("a question mark ends a sentence", aiact.Guard("Am I Acme? I am the model behind Zeta! Fine.", true), "Am I Acme? I'm Salam AI Assistant, made by the Salam team, and I don't share how the service works inside. Fine.")
    same("settled keeps whole sentences", aiact.Settled("One. Two"), "One.")
    same("settled keeps whole lines", aiact.Settled("One\nTwo"), "One\n")
    same("settled holds a first unfinished sentence", aiact.Settled("One"), "")
    same("settled ignores a dot inside a word", aiact.Settled("main.salam is"), "")
    same("settled keeps a finished text", aiact.Settled("One. Two. "), "One. Two.")
    aiact.Configure("Acme,Zeta")
    canned_en := "I'm Salam AI Assistant, made by the Salam team, and I don't share how the service works inside."
    same("a plain claim is replaced", aiact.Guard("I am Acme.", true), canned_en)
    hex_loop := "func hex(s: str): int:\n    mut r := 0\n    each c in s.bytes():\n        r = r * 16 + (c - 48)\n    end\n    ret r\nend\n"
    practice("hand rolled hex", fenced("salam", hex_loop), true)
    practice("hand rolled hex with spaces dropped", fenced("salam", "func h(s: str): int:\n    ret r*16+c-87\nend\n"), true)
    practice("hand rolled decimal", fenced("salam", "func d(s: str): int:\n    r = r * 10 + (c - 48)\nend\n"), true)
    practice("std hex", fenced("salam", "import conv\n\nfunc hex(s: str): i64 throws:\n    ret try conv.ParseHex(s)\nend\n"), false)
    practice("hex loop in a python block is not salam", fenced("python", hex_loop), false)
    fa_bad := "// زبان: فارسی\nتابع parse_colour(متن: رشته): صحیح:\n    ناپایا total := ۰\n    برگشت total\nپایان\n"
    practice("persian code with english names", fenced("salam", fa_bad), true)
    fa_good := "// زبان: فارسی\nتابع خواندن_رنگ(متن: رشته): صحیح:\n    ناپایا جمع := ۰\n    برگشت جمع\nپایان\n\nتابع ریشه:\n    سرچاپ خواندن_رنگ(\"x\")\nپایان\n"
    practice("persian code with persian names", fenced("salam", fa_good), false)
    en_bad := "func خواندن(text: str): int:\n    mut جمع := 0\n    ret جمع\nend\n"
    practice("english code with persian names", fenced("salam", en_bad), true)
    en_good := "func parse_colour(text: str): int:\n    mut total := 0\n    ret total\nend\n\nfunc main:\n    println parse_colour(\"x\")\nend\n"
    practice("english code with english names", fenced("salam", en_good), false)
    practice("persian digits in a persian name", fenced("salam", "// زبان: فارسی\nتابع گام۲(الف: صحیح): صحیح:\n    ناپایا ب۱ := ۰\n    برگشت ب۱\nپایان\n"), false)
    practice("one stray english name is tolerated", fenced("salam", "// زبان: فارسی\nتابع جمع(الف: صحیح): صحیح:\n    ناپایا x := ۰\n    برگشت x\nپایان\n"), false)
    practice("no code", "Just words.", false)

    practice("annotations are not names", fenced("salam", "// زبان: فارسی\nجداشمار سایه:\n    @en \"Dark\"\n    تیره\n    @en \"Light\"\n    روشن\nپایان\n"), false)
    practice("an unused underscore marker is not a style error", fenced("salam", "// زبان: فارسی\nتابع کار(_الف: صحیح، _ب: صحیح): صحیح:\n    _ر := ۱\n    برگشت ۱\nپایان\n"), false)
    practice("upper case constants are fine in persian code", fenced("salam", "// زبان: فارسی\nپایا ZONE := ۱\nپایا AFTER_ONE := ۲\n\nتابع ریشه:\n    سرچاپ ZONE + AFTER_ONE\nپایان\n"), false)
    practice("lower case english names are still found", fenced("salam", "// زبان: فارسی\nتابع show(label: رشته):\n    چاپ label\nپایان\n"), true)


    practice("english generic names in a persian function", fenced("salam", "// زبان: فارسی\nتابع بیشینه<Item، Other>(الف: Item): Item:\n    برگشت الف\nپایان\n"), true)
    practice("single letter and persian generics are fine", fenced("salam", "// زبان: فارسی\nتابع بیشینه<T: شکل>(الف: T): T:\n    برگشت الف\nپایان\n\nتابع دیگر<ت>(الف: ت): ت:\n    برگشت الف\nپایان\n"), false)
    practice("persian generic names in an english struct", fenced("salam", "struct Box<مورد، دیگر>:\n    pub value: int = 0\nend\n"), true)
    practice("english generic names are fine in english", fenced("salam", "struct Box<Item, Other>:\n    pub value: int = 0\nend\n\nfunc largest<Item: Shape>(a: Item): Item:\n    ret a\nend\n"), false)


    practice("persian names with spaces are the standard", fenced("salam", "// زبان: فارسی\nساختار رنگ‌آمیزی:\n    همگانی مقدار قرمز: صحیح = ۰\n    همگانی مقدار سبز: صحیح = ۰\n\n    همگانی تابع جمع کل(ضریب اول: صحیح): صحیح:\n        برگشت این.مقدار قرمز * ضریب اول\n    پایان\nپایان\n\nپایا حداکثر‌مقدار := ۱۰\n\nتابع خواندن رنگ(متن ورودی: رشته): صحیح:\n    ناپایا جمع کل := ۰\n    هر عدد‌جاری در فهرست:\n        جمع کل += عدد‌جاری\n    پایان\n    برگشت جمع کل\nپایان\n"), false)
    practice("persian names with underscores are flagged", fenced("salam", "// زبان: فارسی\nتابع خواندن_رنگ(متن_ورودی: رشته): صحیح:\n    ناپایا جمع_کل := ۰\n    برگشت جمع_کل\nپایان\n"), true)
    practice("one underscore name is tolerated", fenced("salam", "// زبان: فارسی\nتابع خواندن_رنگ(متن: رشته): صحیح:\n    ناپایا جمع کل := ۰\n    برگشت جمع کل\nپایان\n"), false)
    practice("underscores in fields and enum members are flagged", fenced("salam", "// زبان: فارسی\nساختار رنگ:\n    همگانی مقدار_قرمز: صحیح = ۰\n    همگانی مقدار_سبز: صحیح = ۰\nپایان\n"), true)
    practice("underscores in a type and a constant are flagged", fenced("salam", "// زبان: فارسی\nپایا حداکثر_مقدار := ۱۰\nساختار رنگ_آمیزی:\n    همگانی مقدار: صحیح = ۰\nپایان\n"), true)
    practice("test underscore names are not style errors", fenced("salam", "// زبان: فارسی\nتابع test_جمع_کل():\n    ناپایا جمع کل := ۰\n    برگشت جمع کل\nپایان\n\nتابع test_تفریق_کل():\n    ناپایا تفریق کل := ۰\n    برگشت تفریق کل\nپایان\n"), false)
    practice("english snake case is fine", fenced("salam", "func parse_colour(text_value: str): int:\n    mut total_sum := 0\n    ret total_sum\nend\n\nfunc main:\n    println parse_colour(\"x\")\nend\n"), false)
    practice("an english constant with a persian name is flagged", fenced("salam", "const حداکثر := 10\nconst حداقل := 1\n\nfunc main:\n    println حداکثر + حداقل\nend\n"), true)
    practice("an english constant is fine", fenced("salam", "const MAX_SIZE := 10\nconst MIN_SIZE := 1\n\nfunc main:\n    println MAX_SIZE + MIN_SIZE\nend\n"), false)
    practice("english type names with persian names in loops are flagged", fenced("salam", "func main:\n    each عدد in items:\n        println عدد\n    end\n    each مورد in items:\n        println مورد\n    end\nend\n"), true)


    practice("english enum members in a persian enum", fenced("salam", "// زبان: فارسی\nجداشمار مولفه: Red، Green، Blue پایان\n\nتابع ریشه:\n    سرچاپ ۱\nپایان\n"), true)
    practice("persian enum members in a persian enum", fenced("salam", "// زبان: فارسی\nجداشمار مولفه: قرمز، سبز، آبی پایان\n\nتابع ریشه:\n    سرچاپ ۱\nپایان\n"), false)
    practice("english multi line enum in persian code", fenced("salam", "// زبان: فارسی\nجداشمار پرداخت:\n    Cash\n    Card(last4: رشته)\n    Voucher(code: رشته)\nپایان\n"), true)
    practice("persian multi line enum with data", fenced("salam", "// زبان: فارسی\nجداشمار پرداخت:\n    نقد\n    کارت(چهار رقم: رشته)\n    بن(کد: رشته)\nپایان\n"), false)
    practice("persian members in an english enum", fenced("salam", "enum Payment:\n    نقد\n    کارت(رقم: str)\nend\n"), true)
    practice("english multi line enum in english code", fenced("salam", "enum Payment:\n    Cash\n    Card(last4: str)\nend\n\nfunc main:\n    println 1\nend\n"), false)
    practice("the line after an enum is not a member", fenced("salam", "enum Light: Red, Green end\n\nfunc main:\n    mut current := Light.Red\n    println current.name()\nend\n"), false)
    practice("acronym names are fine in persian code", fenced("salam", "// زبان: فارسی\nتابع HTTP(URL: رشته): رشته:\n    ناپایا JSON := URL\n    برگشت JSON\nپایان\n"), false)
    practice("single letter names are fine in persian code", fenced("salam", "// زبان: فارسی\nتابع جمع(x: صحیح، y: صحیح): صحیح:\n    هر i در فهرست:\n        چاپ i\n    پایان\n    برگشت x + y\nپایان\n"), false)
    practice("hand rolled number to text", fenced("salam", "func text(n: int): str:\n    mut out := \"\"\n    until n > 0:\n        out = (n % 10 + 48) as str + out\n        n = n / 10\n    end\n    ret out\nend\n"), true)
    practice("hand rolled upper casing", fenced("salam", "func up(c: int): int:\n    if c >= 97 and c <= 122:\n        ret c - 32\n    end\n    ret c\nend\n"), true)
    practice("a percent ten alone is not number to text", fenced("salam", "func even_tens(n: int): bool:\n    ret n % 10 == 0\nend\n"), false)


    fa_full := "// زبان: فارسی\nجداشمار مولفه: قرمز، سبز پایان\n\nساختار رنگ:\n    همگانی مقدار قرمز: صحیح = ۰\n    همگانی مقدار سبز: صحیح = ۰\n\n    همگانی تابع مقدار(م: مولفه): صحیح:\n        برگشت این.مقدار قرمز\n    پایان\nپایان\n\nتابع جمع رنگ(رنگ ها: وکتور<رنگ>): صحیح:\n    ناپایا جمع := ۰\n    هر ر در رنگ ها:\n        جمع += ر.مقدار(مولفه.قرمز)\n    پایان\n    تلاش:\n        جمع += ۱\n    گرفتن خطا خ:\n        جمع = ۰\n    پایان\n    برگشت جمع\nپایان\n\nتابع ریشه:\n    سرچاپ جمع رنگ(وکتور {} برگردان وکتور<رنگ>)\nپایان\n"
    practice("a full persian program with persian names everywhere", fenced("salam", fa_full), false)
    en_full := "enum Channel: Red, Green end\n\nstruct Rgb:\n    pub red_value: int = 0\n    pub func value(c: Channel): int:\n        ret this.red_value\n    end\nend\n\nfunc total(items: Vector<Rgb>): int:\n    mut sum := 0\n    each item in items:\n        sum += item.value(Channel.Red)\n    end\n    try:\n        sum += 1\n    catch err:\n        sum = 0\n    end\n    ret sum\nend\n\nfunc main:\n    println total(Vector {} as Vector<Rgb>)\nend\n"
    practice("a full english program with english names everywhere", fenced("salam", en_full), false)
    practice("persian parameters in english code", fenced("salam", "func add(الف: int, ب: int): int:\n    ret الف + ب\nend\n"), true)
    practice("english parameters in persian code", fenced("salam", "// زبان: فارسی\nتابع جمع(first: صحیح، second: صحیح): صحیح:\n    برگشت first + second\nپایان\n"), true)
    practice("english fields in persian code", fenced("salam", "// زبان: فارسی\nساختار نقطه:\n    همگانی xpos: صحیح = ۰\n    همگانی ypos: صحیح = ۰\nپایان\n"), true)
    practice("persian fields in english code", fenced("salam", "struct Point:\n    pub افقی: int = 0\n    pub عمودی: int = 0\nend\n"), true)
    practice("english loop and catch names in persian code", fenced("salam", "// زبان: فارسی\nتابع کار():\n    هر item، other در فهرست:\n        چاپ item\n    پایان\nپایان\n"), true)
    practice("a local variable declared per line is not a field", fenced("salam", "func f(): int:\n    ret a ? b : c\nend\n"), false)
    practice("extern names in a persian file are the c names", fenced("salam", "// زبان: فارسی\nدرون‌داد:\n    تابع puts(s: رشته): صحیح\n    تابع strlen(s: رشته): صحیح\nپایان\n\nتابع ریشه:\n    ناپایا جمع := ۰\n    برگشت جمع\nپایان\n"), false)
    practice("extern names in an english file may be c names", fenced("salam", "extern:\n    func puts(s: str): int\nend\n\nfunc main:\n    println 1\nend\n"), false)
    practice("test functions keep their prefix", fenced("salam", "// زبان: فارسی\nتابع test_جمع():\n    ناپایا نتیجه := ۰\n    برگشت نتیجه\nپایان\n\nتابع test_تفریق():\n    ناپایا نتیجه := ۰\n    برگشت نتیجه\nپایان\n"), false)
    practice("tab indentation is read", fenced("salam", "// زبان: فارسی\nساختار نقطه:\n\tهمگانی xpos: صحیح = ۰\n\tهمگانی ypos: صحیح = ۰\nپایان\n"), true)
    practice("persian comma in a binding list", fenced("salam", "// زبان: فارسی\nتابع کار():\n    first، second := دو()\n    برگشت first\nپایان\n"), true)


    en_fa_strings := "func show():\n    println \"تابع پایان برگشت\"\n    msg := \"ساختار\"\n    ret msg\nend\n\nfunc main:\n    show()\nend\n"
    practice("english code with persian words in strings", fenced("salam", en_fa_strings), false)
    en_fa_comment := "func total(a: int): int:\n    // تابع پایان برگشت: r = r * 16 + (c - 48)\n    ret a\nend\n\nfunc main:\n    println total(1)\nend\n"
    practice("english code with a persian comment", fenced("salam", en_fa_comment), false)
    practice("a hex loop only inside a string is not code", fenced("salam", "func main:\n    println \"r = r * 16 + (c - 48)\"\nend\n"), false)
    practice("a hex loop only inside a comment is not code", fenced("salam", "func main:\n    // r = r * 16 + (c - 48)\n    println 1\nend\n"), false)
    fa_en_strings := "تابع سلام کن():\n    سرچاپ \"func ret end parse_colour total value\"\n    پیام := \"if else each\"\n    برگشت پیام\nپایان\n\nتابع ریشه:\n    سلام کن()\nپایان\n"
    practice("persian code with english words in strings", fenced("salam", fa_en_strings), false)
    fa_guillemet := "تابع نمایش():\n    سرچاپ «func ret end total value»\n    ناپایا جمع := ۰\n    برگشت جمع\nپایان\n\nتابع ریشه:\n    نمایش()\nپایان\n"
    practice("persian code with english words in a guillemet string", fenced("salam", fa_guillemet), false)
    fa_en_names_strings := "تابع parse_colour(متن: رشته): رشته:\n    ناپایا total := \"\"\n    برگشت total\nپایان\n"
    practice("persian code with english names is still found", fenced("salam", fa_en_names_strings), true)
    practice("no keywords means no guess", fenced("salam", "x := 1\nname := 2\n"), false)
    practice("escaped quote does not end the string", fenced("salam", "func main:\n    println \"a \\\" تابع پایان برگشت\"\nend\n"), false)


    same("a contracted claim is replaced", aiact.Guard("I'm Zeta.", true), canned_en)
    same("a name claim is replaced", aiact.Guard("My name is Acme.", true), canned_en)
    same("using the word is not a claim", aiact.Guard("I am using Acme here.", true), "I am using Acme here.")
    same("a tool call line is never rewritten", aiact.Guard("{\"tool\": \"write\", \"arguments\": {\"content\": \"I am a model from Acme\"}}", true), "{\"tool\": \"write\", \"arguments\": {\"content\": \"I am a model from Acme\"}}")
    same("prose before a tool call line is still checked", aiact.Guard("I am Acme.\n{\"tool\": \"ls\", \"arguments\": {}}", true), canned_en + "\n{\"tool\": \"ls\", \"arguments\": {}}")
    truth("other json lines are checked", aiact.Guard("{\"note\": \"I am built on Acme.\"}", true).find("Acme") < 0, true)
    truth("a growing text step holds the unfinished sentence", aiact.TextStep("Hello. I am built on Ac", true).find("Ac") < 0 and aiact.TextStep("Hello. I am built on Ac", true).find("Hello.") >= 0, true)
    truth("a growing thought holds a half typed word", aiact.ThoughtStep("Ask Ac", true).find("Ac") < 0 and aiact.ThoughtStep("Ask Ac", true).find("Ask") >= 0, true)
    aiact.Configure("acme")
    same("configured words match in any letter case", aiact.Guard("I am built on ACME Cloud.", true), canned_en)
    same("masking matches in any letter case", aiact.Mask("Ask Acme and ACME and acme."), "Ask assistant and assistant and assistant.")
    same("thoughts mask in any letter case", aiact.Thought("Plan: ask ACME for the data."), "Plan: ask assistant for the data.")
    aiact.Configure("Acme,Zeta")
    sample := "Intro line.\nI am a model made by Acme. Use the Acme API like this: `acme.send(x)`. I'm powered by Zeta and more.\n\nBye."
    final := aiact.Guard(sample, true)
    mut k := 0
    until k < sample.len():
        part := aiact.Settled(aiact.Guard(sample.substr(0, k), false))
        truth("a streamed prefix of " + k + " bytes is a prefix of the final text", str.StartsWith(final, part), true)
        k += 1
    end
    truth("the final text keeps the neutral mention and drops the claims", final.find("Acme") >= 0 and final.find("Zeta") < 0, true)
    aiact.Configure("")

    if FAILED > 0:
        println FAILED, "failed"
        ret 1
    end
    println "ok"
end
