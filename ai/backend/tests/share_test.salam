include aishare "../share.salam"

mut FAILED := 0

func same(name: str, got: str, want: str):
    if got != want:
        println "FAIL", name, "got", got, "want", want
        FAILED++
    end
end

func truth(name: str, got: bool, want: bool):
    if got != want:
        println "FAIL", name, "got", got, "want", want
        FAILED++
    end
end

func main:
    aishare.Init()
    t := aishare.NewToken()
    truth("new token is valid", aishare.ValidToken(t), true)
    truth("tokens are 160 bits", t.Len() == 40, true)
    truth("two tokens differ", aishare.NewToken() != t, true)
    truth("short token", aishare.ValidToken("abc"), false)
    truth("upper case token", aishare.ValidToken("ABCDEF0123ABCDEF0123ABCDEF0123ABCDEF0123"), false)
    truth("sql in token", aishare.ValidToken("' OR 1=1 --aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"), false)
    truth("kind view", aishare.ValidKind("view"), true)
    truth("kind collab", aishare.ValidKind("collab"), true)
    truth("kind other", aishare.ValidKind("admin"), false)
    truth("hours 24", aishare.ValidHours(24), true)
    truth("hours 5", aishare.ValidHours(5), false)
    same("expiry never", "" + aishare.ExpiryFor(0, 1000 as i64), "0")
    same("expiry 1h", "" + aishare.ExpiryFor(1, 1000 as i64), "4600")
    same("device refuses", aishare.CollabRefusal(true, false), "device")
    same("cloud refuses", aishare.CollabRefusal(false, true), "cloud")
    same("plain chat allowed", aishare.CollabRefusal(false, false), "")
    truth("device hides tools", aishare.HideTools(true, false), true)
    truth("plain shows tools", aishare.HideTools(false, false), false)
    same("name plain", aishare.CleanName("Sara"), "Sara")
    same("name empty", aishare.CleanName("   "), "Guest")
    same("name html", aishare.CleanName("<b>Ali</b>"), "bAlib")
    same("name quote", aishare.CleanName("a\"b'c`d"), "abcd")
    same("name spaces", aishare.CleanName("  a   b  "), "a b")
    same("name persian", aishare.CleanName("سارا"), "سارا")
    same("name bidi override", aishare.CleanName("ab\u202Ecd"), "abcd")
    same("name newline", aishare.CleanName("a\nb"), "ab")
    same("name too long", aishare.CleanName("abcdefghijklmnopqrstuvwxyz0123456789"), "abcdefghijklmnopqrstuvwx")
    same("state ok", aishare.State(false, "", 0 as i64, 100 as i64, 10, 1, 5, 1), "ok")
    same("state expired", aishare.State(false, "", 50 as i64, 100 as i64, 10, 1, 5, 1), "expired")
    same("state paused", aishare.State(true, "owner", 0 as i64, 100 as i64, 10, 1, 5, 1), "paused")
    same("state limit", aishare.State(true, "limit", 0 as i64, 100 as i64, 10, 1, 5, 1), "limit")
    same("state cap", aishare.State(false, "", 0 as i64, 100 as i64, 10, 10, 5, 1), "cap")
    same("state daily", aishare.State(false, "", 0 as i64, 100 as i64, 10, 4, 5, 5), "daily")
    same("state no caps", aishare.State(false, "", 0 as i64, 100 as i64, 0, 999, 0, 999), "ok")
    same("expired beats paused", aishare.State(true, "owner", 50 as i64, 100 as i64, 0, 0, 0, 0), "expired")
    truth("rate 1", aishare.Hit("k1", 2, 60), true)
    truth("rate 2", aishare.Hit("k1", 2, 60), true)
    truth("rate 3 blocked", aishare.Hit("k1", 2, 60), false)
    truth("rate other key", aishare.Hit("k2", 2, 60), true)
    truth("rate no limit", aishare.Hit("k3", 0, 60), true)
    steps := `[{"kind":"think","text":"secret reasoning"},{"kind":"tool","tool":"read","icon":"read","title":"Reading /home/x/secret.txt","title_en":"Reading /home/x/secret.txt","detail":"cat /etc/passwd","link":"https://x","status":"done"},{"kind":"text","text":"hello"}]`
    plain := aishare.RedactActivity(steps, false)
    truth("plain keeps title", plain.find("secret.txt") >= 0, true)
    truth("plain drops detail", plain.find("passwd") < 0, true)
    truth("plain drops thinking", plain.find("secret reasoning") < 0, true)
    truth("plain keeps narration", plain.find("hello") >= 0, true)
    hidden := aishare.RedactActivity(steps, true)
    truth("hidden drops path", hidden.find("secret.txt") < 0, true)
    truth("hidden drops detail", hidden.find("passwd") < 0, true)
    truth("hidden drops narration", hidden.find("hello") < 0, true)
    truth("hidden keeps a generic step", hidden.find("Reading") >= 0, true)
    same("bad json", aishare.RedactActivity("nonsense", false), "[]")
    if FAILED > 0:
        println FAILED, "failed"
        ret 1
    end
    println "ok"
    ret 0
end
