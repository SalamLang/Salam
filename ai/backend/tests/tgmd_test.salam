 * Designed by Seyyed Ali Mohammadiyeh and the Salam Team
 * Born from a decade of language design experience (since 2018)
 *
 * Repository: https://github.com/SalamLang/Salam
 *
 */

include aitgmd "../tgmd.salam"

mut FAILED := 0

func check(name: str, got: str, want: str):
    if got != want:
        println "FAIL", name
        println "  got :", got
        println "  want:", want
        FAILED += 1
    end
end

func main:
    check("bold", aitgmd.Html("a **b** c"), "a <b>b</b> c")
    check("italic star", aitgmd.Html("a *b* c"), "a <i>b</i> c")
    check("math stars", aitgmd.Html("2 * 3 * 4"), "2 * 3 * 4")
    check("snake case", aitgmd.Html("use my_var_name here"), "use my_var_name here")
    check("italic underscore", aitgmd.Html("a _b_ c"), "a <i>b</i> c")
    check("inline code", aitgmd.Html("run `a<b>` now"), "run <code>a&lt;b&gt;</code> now")
    check("escape", aitgmd.Html("1 < 2 & 3 > 2"), "1 &lt; 2 &amp; 3 &gt; 2")
    check("heading", aitgmd.Html("## Title"), "<b>Title</b>")
    check("list", aitgmd.Html("- one\n- **two**"), "• one\n• <b>two</b>")
    check("link", aitgmd.Html("see [docs](https://x.ir/a?b=1&c=2)"), "see <a href=\"https://x.ir/a?b=1&amp;c=2\">docs</a>")
    check("bad link", aitgmd.Html("[x](javascript:alert(1))"), "[x](javascript:alert(1))")
    check("strike", aitgmd.Html("~~gone~~"), "<s>gone</s>")
    check("quote", aitgmd.Html("> a\n> b"), "<blockquote>a\nb</blockquote>")
    check("rule", aitgmd.Html("---"), "────────────")
    check("table", aitgmd.Html("| a | b |\n|---|---|\n| 1 | 2 |"), "<pre>| a | b |\n|---|---|\n| 1 | 2 |</pre>")
    check("fence", aitgmd.Html("x\n```salam\nprintln \"<hi>\"\n```\ny"), "x\n<pre><code class=\"language-salam\">println \"&lt;hi&gt;\"</code></pre>\ny")
    check("open fence", aitgmd.Html("```\nabc"), "<pre>abc</pre>")
    check("unterminated bold", aitgmd.Html("a **b"), "a **b")
    check("nested", aitgmd.Html("**a `b` *c***"), "<b>a <code>b</code> <i>c</i></b>")
    check("persian", aitgmd.Html("سلام **دنیا**"), "سلام <b>دنیا</b>")
    parts := aitgmd.Split("one\ntwo\nthree", 100)
    check("split small", "" + parts.len(), "1")
    mut big := ""
    repeat 300 in i:
        big = big + "line number " + i + " of the answer\n"
    end
    chunks := aitgmd.Split(big, 1000)
    mut longest := 0
    each c in chunks:
        if c.len() > longest:
            longest = c.len()
        end
    end
    check("split many", chunks.len() > 4 ? "ok" : "few", "ok")
    check("split bound", longest <= 1000 ? "ok" : "long " + longest, "ok")
    mut code := "```salam\n"
    repeat 200 in i:
        code = code + "println " + i + "\n"
    end
    code = code + "```\n"
    cc := aitgmd.Split(code, 500)
    mut balanced := true
    each c in cc:
        fences := c.split("```").len() - 1
        if fences % 2 != 0:
            balanced = false
        end
    end
    check("split fences", balanced ? "ok" : "unbalanced", "ok")
    mut wide := ""
    repeat 900:
        wide = wide + "سلام"
    end
    wp := aitgmd.Split(wide, 400)
    mut whole := ""
    each c in wp:
        whole = whole + c
    end
    check("split utf8", whole == wide ? "ok" : "lost", "ok")
    mut whole_chars := true
    each c in wp:
        if c.len() % 2 != 0:
            whole_chars = false
        end
    end
    check("split keeps characters whole", whole_chars ? "ok" : "cut inside a character", "ok")
    if FAILED > 0:
        println FAILED, "failed"
        ret 1
    end
    println "tgmd ok"
    ret 0
end
