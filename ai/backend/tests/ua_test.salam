    reported("agent manjaro", GTK_WEBKIT, "linux", "Manjaro Linux", "x86_64", "Manjaro|desktop|WebKitGTK 17|WebKit||x64|wv")
    reported("agent ubuntu", GTK_WEBKIT, "linux", "Ubuntu 24.04", "x86_64", "Ubuntu 24.04|desktop|WebKitGTK 17|WebKit||x64|wv")
    reported("agent fedora", GTK_WEBKIT, "linux", "Fedora Linux 41", "aarch64", "Fedora 41|desktop|WebKitGTK 17|WebKit||arm64|wv")
    reported("agent debian", GTK_WEBKIT, "linux", "Debian GNU/Linux 12", "x86_64", "Debian 12|desktop|WebKitGTK 17|WebKit||x64|wv")
    reported("agent arch", GTK_WEBKIT, "linux", "Arch Linux", "x86_64", "Arch Linux|desktop|WebKitGTK 17|WebKit||x64|wv")
    reported("agent linux empty", GTK_WEBKIT, "linux", "", "", "Linux|desktop|WebKitGTK 17|WebKit||x64|wv")
    reported("agent other os", GTK_WEBKIT, "other", "", "", "Linux|desktop|WebKitGTK 17|WebKit||x64|wv")
    check("darwin 20", aiua.DarwinToMacos("20.6.0"), "11")
    check("darwin 23", aiua.DarwinToMacos("23.5.0"), "14")
    check("darwin 24", aiua.DarwinToMacos("24.1.0"), "15")
    check("darwin 25", aiua.DarwinToMacos("25.0.0"), "26")
    check("darwin 26", aiua.DarwinToMacos("26.0.1"), "27")
    check("darwin 19", aiua.DarwinToMacos("19.6.0"), "10.15")
    check("darwin low", aiua.DarwinToMacos("12"), "")
    check("macos 15 stays", aiua.MacosVersion("15.2"), "15.2")
    check("macos 26 stays", aiua.MacosVersion("26.1"), "26.1")
    check("unquote", aiua.Unquote(" \"Windows\" "), "Windows")
    check("unquote bare", aiua.Unquote("Linux"), "Linux")
    mut round := aiua.Info {}
    parsed := aiua.Parse(WIN_EDGE, aiua.Hints {})
    check("stored round trip", aiua.Stored(aiua.InfoJson(parsed), round) ? aiua.Summary(round) : "no", aiua.Summary(parsed))
    mut stale := aiua.Info {}
    check("stored stale version", aiua.Stored("{\"v\": 0, \"os\": \"Windows\"}", stale) ? "yes" : "no", "no")
    check("stored empty", aiua.Stored("", stale) ? "yes" : "no", "no")
    check("resolve falls back", aiua.Summary(aiua.Resolve("", WIN_EDGE, aiua.Hints {})), "Windows 10/11|desktop|Edge 156|Blink||x64|")
    mut hints := hint("Windows", "15.0.0", "", "x86", "64", "?0", "\"Brave\";v=\"141\"")
    hints.os_id = "x"
    again := aiua.HintsFrom(aiua.HintsJson(hints))
    check("hints round trip", aiua.Summary(aiua.Parse(WIN_CHROME, again)), aiua.Summary(aiua.Parse(WIN_CHROME, hints)))
    check("hints empty json", aiua.HintsJson(aiua.Hints {}), "")
    if FAILED > 0:
        println FAILED, "failed"
        ret 1
    end
    println "ok"
    ret 0
end
