package aiturn

import sync
import str
import conv

include aistore "store.salam"
include aiengine "engine.salam"
include ailive "live.salam"
include aicheck "check.salam"

const CHECK_SECONDS := 10
const FIX_ROUNDS := 2
const START_SECONDS := 45
const EM := 8212
const EN := 8211

mut EM_S := ""
mut EN_S := ""
mut CHECK_LOCK := sync.Mutex {}
mut CHECKED := HashMap {} as HashMap<str, str>
mut ROUNDS := HashMap {} as HashMap<str, int>
mut VERIFYING := HashMap {} as HashMap<str, str>
mut ASKED := HashMap {} as HashMap<str, i64>

func check_due(sid: str): bool:
    _l := sync.Lock(CHECK_LOCK)
    t := aistore.Now()
    mut due := false
    if not CHECKED.has(sid):
        CHECKED.put(sid, conv.FormatInt(t))
    else t - (CHECKED.get(sid).to_int() as i64) >= CHECK_SECONDS:
        CHECKED.put(sid, conv.FormatInt(t))
        due = true
    end
    _u := sync.Unlock(CHECK_LOCK)
    ret due
end

func dash(cp: int): bool:
    ret cp == EM or cp == EN
end

func persian(cp: int): bool:
    ret (cp >= 1536 and cp <= 1791) or (cp >= 64336 and cp <= 65023) or (cp >= 65136 and cp <= 65279) or (cp >= 1776 and cp <= 1785)
end

func digit(cp: int): bool:
    ret (cp >= 48 and cp <= 57) or (cp >= 1776 and cp <= 1785) or (cp >= 1632 and cp <= 1641)
end

func comma_after(b &: str.StringBuilder, prev: int):
    if persian(prev):
        str.BufAppendCp(b, 1548)
    else:
        str.BufAppend(b, ",")
    end
end

func fix_prompt(report: str): str:
    ret "<compiler_check>\nThe Salam code in your last answer does not compile with the Salam compiler:\n\n" + report + "\n\nLook up the right syntax (salam_docs, salam_find_examples), check every code block with salam_check until it passes, then write your whole answer again with the corrected code. Answer the user's last message directly. Do not mention this check.\n</compiler_check>"
end

func asked_at(sid: str, created: i64): i64:
    _l := sync.Lock(CHECK_LOCK)
    t := ASKED.has(sid) ? ASKED.get(sid) : created
    _u := sync.Unlock(CHECK_LOCK)
    ret t
end

func verify(sid: str, text: str): bool:
    _l := sync.Lock(CHECK_LOCK)
    round := ROUNDS.has(sid) ? ROUNDS.get(sid) : 0
    if round >= FIX_ROUNDS or VERIFYING.has(sid):
        busy := VERIFYING.has(sid)
        _u := sync.Unlock(CHECK_LOCK)
        ret busy
    end
    VERIFYING.put(sid, "1")
    _u := sync.Unlock(CHECK_LOCK)
    report := aicheck.Problems(text)
    mut sent := false
    if report.len() > 0:
        ailive.Begin(sid)
        sent = aiengine.Followup(sid, fix_prompt(report))
    end
    _a := sync.Lock(CHECK_LOCK)
    _v := VERIFYING.remove(sid)
    if sent:
        ROUNDS.put(sid, round + 1)
        ASKED.put(sid, aistore.Now())
    else:
        ROUNDS.put(sid, FIX_ROUNDS)
    end
    _b := sync.Unlock(CHECK_LOCK)
    ret sent
end

pub func SaveUsage(table: str, id: str, u: aiengine.Usage):
    if not u.ok or id.len() == 0:
        ret
    end
    mut a := Vector {} as Vector<str>
    a.push(conv.FormatInt(u.input))
    a.push(conv.FormatInt(u.output))
    a.push(conv.FormatInt(u.reasoning))
    a.push(conv.FormatInt(u.cache_read))
    a.push(conv.FormatInt(u.cache_write))
    a.push(conv.FormatFloatPrec(u.cost, 8))
    a.push(conv.FormatInt(u.tools as i64))
    a.push(conv.FormatInt(u.steps as i64))
    a.push(id)
    mut extra := ""
    if table == "messages":
        a.push(conv.FormatInt(u.ms))
        a.push(conv.FormatInt(aistore.Now()))
        extra = ", ms = ?10, finished = ?11"
    end
    aistore.Lock()
    _u := aistore.Run("UPDATE " + table + " SET tokens_in = ?1, tokens_out = ?2, tokens_reasoning = ?3, cache_read = ?4, cache_write = ?5, cost = ?6, tools = ?7, steps = ?8" + extra + " WHERE id = ?9", a)
    aistore.Unlock()
end

pub func Init():
    CHECK_LOCK = sync.NewMutex()
    mut b := str.NewBuilder()
    defer str.BufFree(b)
    str.BufAppendCp(b, EM)
    EM_S = str.BufStr(b)
    str.BufReset(b)
    str.BufAppendCp(b, EN)
    EN_S = str.BufStr(b)
end

pub func Forget(sid: str):
    _l := sync.Lock(CHECK_LOCK)
    _r := CHECKED.remove(sid)
    _o := ROUNDS.remove(sid)
    _a := ASKED.remove(sid)
    _u := sync.Unlock(CHECK_LOCK)
end

pub func Plain(text: str): str:
    if text.find(EM_S) < 0 and text.find(EN_S) < 0:
        ret text
    end
    cps := str.CodePoints(text)
    n := cps.len()
    mut has := false
    each cp in cps:
        if dash(cp):
            has = true
        end
    end
    if not has:
        ret text
    end
    mut b := str.NewBuilder()
    defer str.BufFree(b)
    mut i := 0
    until i < n:
        c := cps.get(i)
        if c == 32 and i + 1 < n and dash(cps.get(i + 1)):
            if i + 2 >= n:
                break
            end
            if cps.get(i + 2) == 32:
                prev := i > 0 ? cps.get(i - 1) : 32
                if prev == 10 or i == 0:
                    str.BufAppend(b, " - ")
                else:
                    comma_after(b, prev)
                    str.BufAppend(b, " ")
                end
                i += 3
                continue
            end
        end
        if dash(c):
            if i + 1 >= n:
                break
            end
            prev := i > 0 ? cps.get(i - 1) : 10
            next := cps.get(i + 1)
            if prev == 10 or prev == 32 or digit(prev) or digit(next) or c == EN:
                str.BufAppend(b, "-")
            else:
                comma_after(b, prev)
                if next != 32:
                    str.BufAppend(b, " ")
                end
            end
            i += 1
            continue
        end
        str.BufAppendCp(b, c)
        i += 1
    end
    ret str.BufStr(b)
end

pub func Progress(sid: str, created: i64, limit: i64): aiengine.Reply:
    ret Advance(sid, created, limit, START_SECONDS as i64, true, true)
end

pub func Advance(sid: str, created: i64, limit: i64, start_limit: i64, check: bool, want_steps: bool): aiengine.Reply:
    mut r := aiengine.Reply {}
    if sid.len() == 0:
        r.failed = true
        r.done = true
        ret r
    end
    mut text := ""
    mut phase := ""
    mut idle := false
    mut failed := false
    tracked := ailive.Snapshot(sid, text, phase, idle, failed)
    if tracked and failed and not idle:
        aiengine.Abort(sid)
        r.text = text
        r.done = true
        r.failed = true
    else tracked and ailive.Connected() and not idle and not failed and not check_due(sid):
        r.text = text
        r.phase = phase
    else:
        r = aiengine.Poll(sid)
        if not r.done and tracked and text.len() > r.text.len():
            r.text = text
            r.phase = phase
        end
    end
    if not r.done and r.idle and not r.started and aistore.Now() - asked_at(sid, created) > start_limit:
        aiengine.Abort(sid)
        r.done = true
        r.failed = true
    end
    if check and r.done and not r.failed and r.text.len() > 0 and verify(sid, r.text):
        r.done = false
        r.text = ""
        r.phase = "checking"
    end
    if not r.done and aistore.Now() - created > limit:
        aiengine.Abort(sid)
        r.done = true
        r.failed = r.text.len() == 0
    end
    if tracked and want_steps:
        r.activity = ailive.Activity(sid)
    end
    r.text = Plain(r.text)
    ret r
end
