package aiweb

import net.http
import encoding
import encoding.json
import crypto
import sync
import conv
import str

include aistore "store.salam"

mut ORIGINS := ","
mut ADMINS := ","
mut ADMIN_IDS := ","
mut SECRET := ""
mut LIVE_LOCK := sync.Mutex {}
mut LIVE := 0
mut EN := HashMap {} as HashMap<str, str>

func one(v: str): Vector<str>:
    mut a := Vector {} as Vector<str>
    a.push(v)
    ret a
end

func two(v: str, w: str): Vector<str>:
    mut a := one(v)
    a.push(w)
    ret a
end

