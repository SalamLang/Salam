package aiweb

import net.http
import encoding
import encoding.json
import crypto
import sync
import conv
import str

include aistore "store.salam"

mut ORIGINS := ","
mut ADMINS := ","
mut ADMIN_IDS := ","
mut SECRET := ""
mut LIVE_LOCK := sync.Mutex {}
mut LIVE := 0
mut EN := HashMap {} as HashMap<str, str>

func one(v: str): Vector<str>:
    mut a := Vector {} as Vector<str>
    a.push(v)
    ret a
end

func two(v: str, w: str): Vector<str>:
    mut a := one(v)
    a.push(w)
    ret a
end

func fill_english():
    EN.put("اشتراک شما نامحدود است و به خرید تازه نیازی ندارد.", "Your subscription is unlimited, so there is nothing to buy.")
    EN.put("ایمیل یا گذرواژه درست نیست.", "The email or password is not correct.")
    EN.put("این اتصال پیدا نشد.", "This connection was not found.")
    EN.put("این اشتراک فعال پیدا نشد.", "This active subscription was not found.")
    EN.put("این بخش فقط برای مدیران است.", "This section is for admins only.")
    EN.put("این درخواست اتصال پیدا نشد یا منقضی شده است. اتصال را از خود برنامه دوباره شروع کنید.", "This connection request was not found or has expired. Start connecting again from the app.")
    EN.put("این درگاه پرداخت الان فعال نیست.", "This payment gateway is not active right now.")
    EN.put("این دستگاه پیدا نشد.", "This device was not found.")
    EN.put("این دستگاه پیدا نشد. برنامه‌ی دسکتاپ را دوباره وصل کنید.", "This device was not found. Connect the desktop app again.")
    EN.put("این فایل پیدا نشد.", "This file was not found.")
    EN.put("این پلن برای خرید نیست.", "This plan cannot be bought.")
    EN.put("این پلن را نمی‌شناسیم.", "This plan is unknown.")
    EN.put("این پیام پیدا نشد.", "This message was not found.")
    EN.put("این کاربر پیدا نشد.", "This user was not found.")
    EN.put("این کلید پیدا نشد.", "This key was not found.")
    EN.put("این گفت‌وگو پیدا نشد.", "This chat was not found.")
    EN.put("با این ایمیل قبلا حساب ساخته شده است. وارد شوید.", "An account with this email already exists. Sign in instead.")
    EN.put("با این ایمیل نمی‌توان حساب تازه ساخت.", "A new account cannot be made with this email.")
    EN.put("به این درخواست اتصال قبلا پاسخ داده شده است.", "This connection request was already answered.")
    EN.put("ثبت دستگاه ناموفق بود. دوباره تلاش کنید.", "Registering the device failed. Please try again.")
    EN.put("ثبت پرداخت انجام نشد. دوباره تلاش کنید.", "The payment could not be recorded. Please try again.")
    EN.put("جزئیات این پاسخ از موتور دستیار خوانده نشد.", "The details of this answer could not be read from the assistant engine.")
    EN.put("حداکثر ۱۰ دستگاه می‌توانید وصل کنید. یکی را حذف کنید.", "You can connect at most 10 devices. Remove one first.")
    EN.put("حداکثر ۲۰ کلید فعال می‌توانید داشته باشید. یکی را باطل کنید.", "You can have at most 20 active keys. Revoke one first.")
    EN.put("دستیار در دسترس نیست. چند لحظه بعد دوباره تلاش کنید.", "The assistant is not available. Please try again in a moment.")
    EN.put("ذخیره‌ی فایل‌ها ناموفق بود. دوباره تلاش کنید.", "Saving the files failed. Please try again.")
    EN.put("ساخت اتصال ناموفق بود. دوباره تلاش کنید.", "Creating the connection failed. Please try again.")
    EN.put("ساخت حساب ناموفق بود. دوباره تلاش کنید.", "Creating the account failed. Please try again.")
    EN.put("ساخت کلید ناموفق بود. دوباره تلاش کنید.", "Creating the key failed. Please try again.")
    EN.put("ساخت گفت‌وگو ناموفق بود.", "Creating the chat failed.")
    EN.put("لطفا دوباره وارد شوید.", "Please sign in again.")
    EN.put("نام باید بین ۲ تا ۸۰ نویسه باشد.", "The name must be 2 to 80 characters.")
