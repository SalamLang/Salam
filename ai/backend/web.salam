func english(m: str): str:
    if EN.has(m):
        ret EN.get(m)
    end
    mut at := 0
    each rate in ["پیام‌های امروز پلن «", "پیام‌های این هفته پلن «", "پیام‌های ۵ ساعت اخیر پلن «"]:
        if str.StartsWith(m, rate):
            rest := m.substr(rate.len(), m.len() - rate.len())
            cut := rest.find("»")
            name := cut >= 0 ? rest.substr(0, cut) : ""
            if at == 1:
                ret "You have used this week's messages on the " + name + " plan. They reset on Saturday at midnight Tehran time, or you can upgrade your plan."
            end
            if at == 2:
                ret "You have used the messages of the last 5 hours on the " + name + " plan. Try again a little later or upgrade your plan."
            end
            ret "You have used today's messages on the " + name + " plan. They reset at midnight Tehran time, or you can upgrade your plan."
        end
        at += 1
    end
    ret m
end

func version_char(c: str): bool:
    ret (c >= "0" and c <= "9") or (c >= "a" and c <= "z") or (c >= "A" and c <= "Z") or c == "." or c == "-" or c == "+"
end

func label_char(c: str): bool:
    ret version_char(c) or c == " " or c == "_" or c == "(" or c == ")"
end

func label_header(ctx: i64, name: str, max: int): str:
    v := str.Trim(http.Header(ctx, name))
    if v.len() == 0 or v.len() > max:
        ret ""
    end
    mut i := 0
    until i < v.len():
        if not label_char(v.substr(i, 1)):
            ret ""
        end
        i++
    end
    ret v
end

func touch(ctx: i64, hash: str):
    now := aistore.Now()
    mut a := Vector {} as Vector<str>
    a.push(I64s(now))
    a.push(ClientIp(ctx))
    a.push(http.Header(ctx, "X-Salam-Client").len() > 0 ? ClientKind(ctx) : "")
    a.push(ClientVersion(ctx))
    a.push(hash)
    a.push(I64s(now - 60))
    a.push(ClientOs(ctx))
    a.push(ClientOsVersion(ctx))
    a.push(ClientArch(ctx))
    aistore.Lock()
    _r := aistore.Run("UPDATE sessions SET last_used = ?1, ip = LEFT(?2, 64), client = IF(?3 = '', client, ?3), client_version = IF(?4 = '', client_version, ?4), os = IF(?7 = '', os, ?7), os_version = IF(?8 = '', os_version, ?8), arch = IF(?9 = '', arch, ?9) WHERE token = ?5 AND last_used < ?6", a)
    aistore.Unlock()
end

func general_user(uid: str): bool:
    aistore.Lock()
    v := aistore.OneText("SELECT COUNT(*) FROM subscriptions s WHERE s.user_id = ?1 AND s.status = 'active' AND s.plan <> 'free' AND (s.expires = 0 OR s.expires > ?2) AND NOT EXISTS (SELECT 1 FROM plans p WHERE p.id = s.plan AND p.salam_only = 1)", two(uid, I64s(aistore.Now())))
    aistore.Unlock()
    ret v.len() > 0 and v != "0"
end

pub func Enter():
    _l := sync.Lock(LIVE_LOCK)
    LIVE++
    _u := sync.Unlock(LIVE_LOCK)
end

pub func Leave():
    _l := sync.Lock(LIVE_LOCK)
    if LIVE > 0:
        LIVE--
    end
    _u := sync.Unlock(LIVE_LOCK)
end

pub func Live(): int:
    _l := sync.Lock(LIVE_LOCK)
    v := LIVE
    _u := sync.Unlock(LIVE_LOCK)
    ret v
end

pub func Configure(origins: str, admins: str, admin_ids: str, secret: str):
    LIVE_LOCK = sync.NewMutex()
    ORIGINS = "," + str.Replace(origins, " ", "") + ","
    ADMINS = "," + str.Lower(str.Replace(admins, " ", "")) + ","
    ADMIN_IDS = "," + str.Replace(admin_ids, " ", "") + ","
    SECRET = secret
    fill_english()
end

pub func AllowedOrigin(origin: str): bool:
    ret origin.len() > 0 and ORIGINS.find("," + origin + ",") >= 0
end

pub func ReservedEmail(email: str): bool:
    ret email.len() > 0 and ADMINS.find("," + str.Lower(email) + ",") >= 0
end

pub func IsAdmin(uid: str, email: str): bool:
    if uid.len() > 0 and ADMIN_IDS.find("," + uid + ",") >= 0:
        ret true
    end
    ret ReservedEmail(email)
end

pub func Cors(ctx: i64):
    origin := http.Header(ctx, "Origin")
    if AllowedOrigin(origin):
        http.SetHeader(ctx, "Access-Control-Allow-Origin", origin)
        http.SetHeader(ctx, "Access-Control-Allow-Headers", "Authorization, Content-Type, X-Salam-Client, X-Salam-Version, X-Salam-OS, X-Salam-OS-Version, X-Salam-Arch, X-Salam-Lang")
        http.SetHeader(ctx, "Access-Control-Allow-Methods", "GET, POST, PUT, PATCH, DELETE, OPTIONS")
        http.SetHeader(ctx, "Access-Control-Max-Age", "86400")
        http.SetHeader(ctx, "Access-Control-Expose-Headers", "Server-Timing")
    end
    http.SetHeader(ctx, "Vary", "Origin")
    http.SetHeader(ctx, "Cache-Control", "no-store")
    http.SetHeader(ctx, "X-Content-Type-Options", "nosniff")
end

pub func OpenCors(ctx: i64):
    http.SetHeader(ctx, "Access-Control-Allow-Origin", "*")
    http.SetHeader(ctx, "Access-Control-Allow-Headers", "Authorization, Content-Type, MCP-Protocol-Version")
    http.SetHeader(ctx, "Access-Control-Allow-Methods", "GET, POST, OPTIONS")
    http.SetHeader(ctx, "Access-Control-Max-Age", "86400")
    http.SetHeader(ctx, "Cache-Control", "no-store")
    http.SetHeader(ctx, "Pragma", "no-cache")
    http.SetHeader(ctx, "X-Content-Type-Options", "nosniff")
end

pub func Reply(ctx: i64, status: int, body: str):
    Cors(ctx)
    http.SetStatus(ctx, status)
    http.Json(ctx, body)
end

pub func Fail(ctx: i64, status: int, code: str, message: str):
    mut m := Vector {} as Vector<str>
    m.push(json.Member("error", code))
    m.push(json.Member("message", English(ctx) ? english(message) : message))
    Reply(ctx, status, json.Object(m))
end

pub func Preflight(ctx: i64):
    Cors(ctx)
    http.SetStatus(ctx, 204)
    http.Text(ctx, "")
end

pub func OpenPreflight(ctx: i64):
    OpenCors(ctx)
    http.SetStatus(ctx, 204)
    http.Text(ctx, "")
end

pub func I64s(n: i64): str:
    ret conv.FormatInt(n)
end

pub func Hash(token: str): str:
    ret crypto.Sha256Hex(token)
end

pub func ClientIp(ctx: i64): str:
    cf := http.Header(ctx, "CF-Connecting-IP")
    if cf.len() > 0:
        ret cf
    end
    real := http.Header(ctx, "X-Real-IP")
    if real.len() > 0:
        ret real
    end
    fwd := http.Header(ctx, "X-Forwarded-For")
    comma := fwd.find(",")
    if comma >= 0:
        ret str.Trim(fwd.substr(0, comma))
    end
    ret fwd
end

pub func English(ctx: i64): bool:
    ret http.Header(ctx, "X-Salam-Lang") == "en"
end

pub func UiLangNote(ctx: i64): str:
    ret LangNote(English(ctx))
end

pub func LangNote(en: bool): str:
    if en:
        ret "<user_interface>\nThe user is using the English interface. Unless they ask otherwise, answer in English and write English Salam code (files start with `// lang: en`). If they ask for another reply language, for Persian Salam code, or for both versions, do exactly that. Do not mention this note.\n</user_interface>\n\n"
    end
    ret "<user_interface>\nThe user is using the Persian interface. Unless they ask otherwise, answer in Persian and write Persian Salam code (files start with `// زبان: فارسی`). If they ask for another reply language, for English Salam code, or for both versions, do exactly that. Do not mention this note.\n</user_interface>\n\n"
end

pub func Pick(ctx: i64, fa: str, en: str): str:
    ret English(ctx) ? en : fa
end

pub func ClientKind(ctx: i64): str:
    ret http.Header(ctx, "X-Salam-Client") == "agent" ? "agent" : "web"
end

pub func ClientVersion(ctx: i64): str:
    v := str.Trim(http.Header(ctx, "X-Salam-Version"))
    if v.len() == 0 or v.len() > 32:
        ret ""
    end
    mut i := 0
    until i < v.len():
        if not version_char(v.substr(i, 1)):
            ret ""
        end
        i++
    end
    ret v
end

pub func ClientOs(ctx: i64): str:
    v := http.Header(ctx, "X-Salam-OS")
    if v == "windows" or v == "macos" or v == "linux" or v == "other":
        ret v
    end
    ret ""
end

pub func ClientOsVersion(ctx: i64): str:
    ret label_header(ctx, "X-Salam-OS-Version", 64)
end

pub func ClientArch(ctx: i64): str:
    ret label_header(ctx, "X-Salam-Arch", 16)
end

pub func Bearer(ctx: i64): str:
    h := http.Header(ctx, "Authorization")
    if str.StartsWith(h, "Bearer "):
        ret str.Trim(h.substr(7, h.len() - 7))
    end
    ret ""
end

pub func UserFromToken(token: str): i64:
    if token.len() < 20:
        ret 0
    end
    aistore.Lock()
    id := aistore.OneText("SELECT user_id FROM sessions WHERE token = ?1 AND expires > ?2", two(Hash(token), I64s(aistore.Now())))
    aistore.Unlock()
    if id.len() == 0:
        ret 0
    end
    ret id.to_int()
end

pub func NeedUser(ctx: i64): i64:
    token := Bearer(ctx)
    uid := UserFromToken(token)
    if uid == 0:
        Fail(ctx, 401, "unauthorized", "لطفا دوباره وارد شوید.")
    else:
        touch(ctx, Hash(token))
    end
    ret uid
end

pub func UserEmail(uid: i64): str:
    aistore.Lock()
    email := aistore.OneText("SELECT email FROM users WHERE id = ?1", one(I64s(uid)))
    aistore.Unlock()
    ret email
end

pub func OperatorText(uid: str): str:
    aistore.Lock()
    v := aistore.OneText("SELECT COALESCE(policy_system, '') FROM users WHERE id = ?1", one(uid))
    aistore.Unlock()
    ret v
end

pub func GeneralMode(uid: str): bool:
    ret general_user(uid)
end

pub func ChatGeneral(chat: str): bool:
    aistore.Lock()
    owner := aistore.OneText("SELECT user_id FROM chats WHERE id = ?1", one(chat))
    aistore.Unlock()
    ret owner.len() > 0 and general_user(owner)
end

pub func ChatOwner(chat: str): str:
    aistore.Lock()
    owner := aistore.OneText("SELECT user_id FROM chats WHERE id = ?1", one(chat))
    aistore.Unlock()
    ret owner
end

pub func NeedAdmin(ctx: i64): i64:
    uid := NeedUser(ctx)
    if uid == 0:
        ret 0
    end
    if not IsAdmin(I64s(uid), UserEmail(uid)):
        Fail(ctx, 403, "forbidden", "این بخش فقط برای مدیران است.")
        ret 0
    end
    ret uid
end

pub func ServiceCaller(ctx: i64): bool:
    if SECRET.len() < 16:
        ret false
    end
    h := http.Header(ctx, "Authorization")
    if not str.StartsWith(h, "Basic "):
        ret false
    end
    mut decoded := ""
    try:
        decoded = encoding.Base64Decode(str.Trim(h.substr(6, h.len() - 6)))
    catch:
        ret false
    end
    ret crypto.SecretEquals(decoded, "salam-mcp:" + SECRET)
end
