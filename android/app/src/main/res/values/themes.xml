<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Salam" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">#FF5C00</item>
        <item name="android:colorPrimaryDark">#F5F6F8</item>
        <item name="android:colorAccent">#FF5C00</item>
        <item name="android:windowBackground">@color/bg_light</item>
        <item name="android:textColorPrimary">#1B1D22</item>
    </style>

    <style name="Theme.Salam.Dark" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorPrimary">#FF5C00</item>
        <item name="android:colorPrimaryDark">#1E2128</item>
        <item name="android:colorAccent">#FF8A4C</item>
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:textColorPrimary">#E6E8EC</item>
    </style>

    <style name="Theme.Salam.Launch" parent="Theme.Salam">
        <item name="android:windowBackground">@drawable/launch</item>
    </style>
</resources>
