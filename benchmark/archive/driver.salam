package main

import archive
import os

func main(): int:
    args := os.Args()
    mode := args[1]
    inp := args[2]
    outp := args[3]
    mut ok := false
    if mode == "gunzip":
        ok = archive.GzipDecompressFile(inp, outp)
    else mode == "gzip":
        ok = archive.GzipCompressFile(inp, outp)
    else mode == "bunzip2":
        ok = archive.Bzip2DecompressFile(inp, outp)
    else mode == "bzip2":
        ok = archive.Bzip2CompressFile(inp, outp)
    else mode == "unxz":
        ok = archive.XzDecompressFile(inp, outp)
    else mode == "xz":
        ok = archive.XzCompressFile(inp, outp)
    else mode == "unlzma":
        ok = archive.LzmaDecompressFile(inp, outp)
    else mode == "lzma":
        ok = archive.LzmaCompressFile(inp, outp)
    else mode == "unzstd":
        ok = archive.ZstdDecompressFile(inp, outp)
    else mode == "zstd":
        ok = archive.ZstdCompressFile(inp, outp)
    else:
        mut rok := false
        b := archive.ReadBinaryFile(inp, rok)
        if not rok:
            println "read fail"
            ret 2
        end
        os.MkdirAll(outp)
        if mode == "unzip":
            ok = archive.ZipExtractAll(b.data, b.len, outp)
        else mode == "un7z":
            ok = archive.SevenZipExtractAll(b.data, b.len, outp)
        else mode == "unrar":
            ok = archive.RarExtractAll(b.data, b.len, outp)
        else:
            println "bad mode"
        end
    end
    if not ok:
        println "FAIL"
        ret 1
    end
    ret 0
end
