package bench

import filepath
import os

func mark_build_fail(s &: Store, name: str, lang: str, msg: str):
    k := kkey(name, lang)
    s.status.Put(k, "build_failed")
    s.berr.Put(k, tail_chars(msg, 2000))
end

func build_program(name: str, cfg &: Config, s &: Store): HashMap<str, str>:
    src := filepath.Join(cfg.work_programs, name)
    mut cmds := HashMap {} as HashMap<str, str> c_bin := filepath.Join(cfg.build, name.Concat("_c"))
    mut r := sh_cap("gcc -O3 -o ".Concat(c_bin).Concat(" ").Concat(filepath.Join(src, "prog.c")).Concat(" -lm"))
    if r.code == 0:
        cmds.Put("c", c_bin)
    else:
        mark_build_fail(s, name, "c", r.out)
    end

    cpp_bin := filepath.Join(cfg.build, name.Concat("_cpp"))
    r = sh_cap("g++ -O3 -o ".Concat(cpp_bin).Concat(" ").Concat(filepath.Join(src, "prog.cpp")))
    if r.code == 0:
        cmds.Put("cpp", cpp_bin)
    else:
        mark_build_fail(s, name, "cpp", r.out)
    end

    rust_bin := filepath.Join(cfg.build, name.Concat("_rust"))
    r = sh_cap("rustc -C opt-level=3 -o ".Concat(rust_bin).Concat(" ").Concat(filepath.Join(src, "prog.rs")))
    if r.code == 0 and os.Exists(rust_bin):
        cmds.Put("rust", rust_bin)
    else:
        mark_build_fail(s, name, "rust", r.out)
    end

    go_bin := filepath.Join(cfg.build, name.Concat("_go"))
    r = sh_cap("cd ".Concat(src).Concat(" && go build -o ").Concat(go_bin).Concat(" prog.go"))
    if r.code == 0 and os.Exists(go_bin):
        cmds.Put("go", go_bin)
    else:
        mark_build_fail(s, name, "go", r.out)
    end

    salam_src := filepath.Join(src, "prog.salam")
    prog_build := filepath.Join(cfg.build, name)
    os.MkdirAll(prog_build)
    salam_pre := "cd ".Concat(prog_build).Concat(" && SALAM_STD=").Concat(cfg.std_dir).Concat(" ").Concat(cfg.salam)
    quiet := " --release --log-level=error "

    tcc_bin := filepath.Join(cfg.build, name.Concat("_salam_tcc"))
    r = sh_cap(salam_pre.Concat(" build").Concat(quiet).Concat(salam_src).Concat(" --output=").Concat(tcc_bin))
    if r.code == 0 and os.Exists(tcc_bin):
        cmds.Put("salam_tcc", tcc_bin)
    else:
        mark_build_fail(s, name, "salam_tcc", r.out)
    end

    gcc_bin := filepath.Join(cfg.build, name.Concat("_salam_gcc"))
    r = sh_cap(salam_pre.Concat(" build").Concat(quiet).Concat(salam_src).Concat(` --cc="gcc -O3" --output=`).Concat(gcc_bin))
    if r.code == 0 and os.Exists(gcc_bin):
        cmds.Put("salam_gcc", gcc_bin)
    else:
        mark_build_fail(s, name, "salam_gcc", r.out)
    end

    llvm_bin := filepath.Join(cfg.build, name.Concat("_salam_llvm"))
    r = sh_cap(salam_pre.Concat(" llvm").Concat(quiet).Concat(salam_src).Concat(" -O3 --exec -o ").Concat(llvm_bin))
    if r.code == 0 and os.Exists(llvm_bin):
        cmds.Put("salam_llvm", llvm_bin)
    else:
        mark_build_fail(s, name, "salam_llvm", r.out)
    end

    native_bin := filepath.Join(cfg.build, name.Concat("_salam_native"))
    r = sh_cap(salam_pre.Concat(" build").Concat(quiet).Concat(salam_src).Concat(" --backend=native --output=").Concat(native_bin))
    if r.code == 0 and os.Exists(native_bin):
        cmds.Put("salam_native", native_bin)
    else:
        mark_build_fail(s, name, "salam_native", r.out)
    end

    cmds.Put("python", "python3 ".Concat(filepath.Join(src, "prog.py")))
    cmds.Put("php", "php -n ".Concat(filepath.Join(src, "prog.php")))
    ret cmds
end
