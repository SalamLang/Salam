package bench

func lang order(): Vector<str>:
    mut v := Vector {} as Vector<str> v.push("c")
    v.push("cpp")
    v.push("rust")
    v.push("go")
    v.push("salam_llvm")
    v.push("salam_gcc")
    v.push("salam_tcc")
    v.push("php")
    v.push("python")
    ret v
end

func lang label(l: str): str:
    switch l:
        "c":
            ret "C"
        end
        "cpp":
            ret "C++"
        end
        "rust":
            ret "Rust"
        end
        "go":
            ret "Go"
        end
        "salam_llvm":
            ret "Salam-l"
        end
        "salam_gcc":
            ret "Salam-g"
        end
        "salam_tcc":
            ret "Salam-t"
        end
        "php":
            ret "PHP"
        end
        "python":
            ret "Python"
        end
    end
    ret l
end

func is salam(l: str): bool:
    ret l == "salam_llvm" or l == "salam_gcc" or l == "salam_tcc"
end
