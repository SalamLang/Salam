package bench

func lang_order(): Vector<str>:
    mut v := Vector {} as Vector<str> v.Push("c")
    v.Push("cpp")
    v.Push("rust")
    v.Push("go")
    v.Push("salam_llvm")
    v.Push("salam_native")
    v.Push("salam_gcc")
    v.Push("salam_tcc")
    v.Push("php")
    v.Push("python")
    ret v
end

func lang_label(l: str): str:
    switch l:
        "c":
            ret "C"
        end
        "cpp":
            ret "C++"
        end
        "rust":
            ret "Rust"
        end
        "go":
            ret "Go"
        end
        "salam_llvm":
            ret "Salam-l"
        end
        "salam_native":
            ret "Salam-n"
        end
        "salam_gcc":
            ret "Salam-g"
        end
        "salam_tcc":
            ret "Salam-t"
        end
        "php":
            ret "PHP"
        end
        "python":
            ret "Python"
        end
    end
    ret l
end

func is_salam(l: str): bool:
    ret l == "salam_llvm" or l == "salam_native" or l == "salam_gcc" or l == "salam_tcc"
end
