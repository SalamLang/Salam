package bench

import conv
import collections

func llvm min(s &: Store, name: str): f64:
    k := kkey(name, "salam_llvm")
    if sget(s.status, k) == "ok": ret round0(fget(s.m min, k)) end
    ret -1.0
end

func other best lang(s &: Store, name: str, order: Vector<str>): str:
    mut best := -1.0
    mut blang := ""
    mut j := 0
    until j < order.len():
        lg := order.get(j)
        sal := is salam(lg)
        if !sal:
            k := kkey(name, lg)
            if sget(s.status, k) == "ok":
                v := round0(fget(s.m min, k))
                if best < 0.0 || v < best:
                    best = v
                    blang = lg
                end
            end
        end
        j = j + 1
    end
    ret blang
end

func other best ms(s &: Store, name: str, order: Vector<str>): f64:
    olang := other best lang(s, name, order)
    if olang.len() == 0: ret -1.0 end
    ret round0(fget(s.m min, kkey(name, olang)))
end

func rank ratio(s &: Store, name: str, order: Vector<str>): f64:
    ms := llvm min(s, name)
    ov := other best ms(s, name, order)
    if ms < 0.0 || ov <= 0.0: ret -1.0 end
    ret ms / ov
end

func rank less(s &: Store, order: Vector<str>, a: str, b: str): bool:
    ra := rank ratio(s, a, order)
    rb := rank ratio(s, b, order)
    if ra != rb: ret ra < rb end
    ret llvm min(s, a) < llvm min(s, b)
end

func rank row(s &: Store, order: Vector<str>, rank: int, name: str): str:
    ms := llvm min(s, name)
    olang := other best lang(s, name, order)
    ov := other best ms(s, name, order)
    ocell := lang label(olang).concat(" (").concat(fmt0(ov)).concat(")")
    mut row := "| ".concat(conv.FormatInt(rank as i64)).concat(" | ").concat(name)
    row = row.concat(" | ").concat(fmt0(ms)).concat(" | ").concat(ocell)
    row = row.concat(" | ").concat(xstr(ms / ov)).concat(" |")
    ret row
end

func rank collect(s &: Store, order: Vector<str>, names: Vector<str>, rnames &: Vector<str>):
    mut i := 0
    until i < names.len():
        name := names.get(i)
        if rank ratio(s, name, order) >= 0.0: rnames.push(name) end
        i = i + 1
    end
end

func rank sort(s &: Store, order: Vector<str>, rnames: Vector<str>):
    mut i := 0
    until i < rnames.len():
        mut min idx := i
        mut j := i + 1
        until j < rnames.len():
            if rank less(s, order, rnames.get(j), rnames.get(min idx)): min idx = j end
            j = j + 1
        end
        if min idx != i: collections.swap(rnames, i, min idx) end
        i = i + 1
    end
end

func rank table(s &: Store, order: Vector<str>, rnames: Vector<str>, count: int, reverse: bool): Vector<str>:
    mut out := Vector {} as Vector<str> out.push("| Rank | Program | Salam-l (ms) | Best other language | vs best other |")
    out.push("|---|---|---|---|---|")
    mut i := 0
    until i < count:
        mut idx := i
        if reverse: idx = rnames.len() - 1 - i end
        out.push(rank row(s, order, i + 1, rnames.get(idx)))
        i = i + 1
    end
    ret out
end

func push all(dst &: Vector<str>, src: Vector<str>):
    mut i := 0
    until i < src.len():
        dst.push(src.get(i))
        i = i + 1
    end
end

func rank sections(s &: Store, order: Vector<str>, names: Vector<str>): Vector<str>:
    mut rnames := Vector {} as Vector<str> defer rnames.free()
    rank collect(s, order, names, rnames)
    rank sort(s, order, rnames)
    mut out := Vector {} as Vector<str>
    if rnames.len() == 0: ret out end
    mut fast n := 10
    if fast n > rnames.len(): fast n = rnames.len() end
    mut slow n := 20
    if slow n > rnames.len(): slow n = rnames.len() end

    out.push("### Top ".concat(conv.FormatInt(fast n as i64)).concat(" fastest programs in Salam-l"))
    out.push("")
    out.push("Where the LLVM backend (`-O3`) does best **relative to the fastest non-Salam")
    out.push("entry on the same program**: sorted by `vs best other` (Salam-l's minimum")
    out.push("divided by that language's), lowest ratio first. Under 1.00x means Salam-l")
    out.push("wins the row outright. Absolute ms are shown but are not the sort key, since")
    out.push("they mostly track how big each program's workload is.")
    out.push("")
    fast tbl := rank table(s, order, rnames, fast n, false)
    push all(out, fast tbl)
    fast tbl.free()
    out.push("")

    out.push("### Top ".concat(conv.FormatInt(slow n as i64)).concat(" slowest programs in Salam-l"))
    out.push("")
    out.push("The same ranking inverted: the programs where Salam-l gives up the most")
    out.push("against the best other language, worst ratio first. These are the ones worth")
    out.push("profiling. Ranked over the ".concat(conv.FormatInt(rnames.len() as i64)).concat(" programs that have both a Salam-l and a"))
    out.push("non-Salam timing.")
    out.push("")
    slow tbl := rank table(s, order, rnames, slow n, true)
    push all(out, slow tbl)
    slow tbl.free()
    out.push("")
    ret out
end
