package bench

import conv
import collections

func llvm_min(s &: Store, name: str): f64:
    k := kkey(name, "salam_llvm")
    if sget(s.status, k) == "ok": ret round0(fget(s.m_min, k)) end
    ret -1.0
end

func other_best_lang(s &: Store, name: str, order: Vector<str>): str:
    mut best := -1.0
    mut blang := ""
    mut j := 0
    until j < order.Len():
        lg := order.Get(j)
        sal := is_salam(lg)
        if not sal:
            k := kkey(name, lg)
            if sget(s.status, k) == "ok":
                v := round0(fget(s.m_min, k))
                if best < 0.0 or v < best:
                    best = v
                    blang = lg
                end
            end
        end
        j++
    end
    ret blang
end

func other_best_ms(s &: Store, name: str, order: Vector<str>): f64:
    olang := other_best_lang(s, name, order)
    if olang.Len() == 0: ret -1.0 end
    ret round0(fget(s.m_min, kkey(name, olang)))
end

func rank_ratio(s &: Store, name: str, order: Vector<str>): f64:
    ms := llvm_min(s, name)
    ov := other_best_ms(s, name, order)
    if ms < 0.0 or ov <= 0.0: ret -1.0 end
    ret ms / ov
end

func rank_less(s &: Store, order: Vector<str>, a: str, b: str): bool:
    ra := rank_ratio(s, a, order)
    rb := rank_ratio(s, b, order)
    if ra != rb: ret ra < rb end
    ret llvm_min(s, a) < llvm_min(s, b)
end

func rank_row(s &: Store, order: Vector<str>, rank: int, name: str): str:
    ms := llvm_min(s, name)
    olang := other_best_lang(s, name, order)
    ov := other_best_ms(s, name, order)
    ocell := lang_label(olang).Concat(" (").Concat(fmt0(ov)).Concat(")")
    mut row := "| ".Concat(conv.FormatInt(rank as i64)).Concat(" | ").Concat(name)
    row = row.Concat(" | ").Concat(fmt0(ms)).Concat(" | ").Concat(ocell)
    row = row.Concat(" | ").Concat(xstr(ms / ov)).Concat(" |")
    ret row
end

func rank_collect(s &: Store, order: Vector<str>, names: Vector<str>, rnames &: Vector<str>):
    mut i := 0
    until i < names.Len():
        name := names.Get(i)
        if rank_ratio(s, name, order) >= 0.0: rnames.Push(name) end
        i++
    end
end

func rank_sort(s &: Store, order: Vector<str>, rnames: Vector<str>):
    mut i := 0
    until i < rnames.Len():
        mut min_idx := i
        mut j := i + 1
        until j < rnames.Len():
            if rank_less(s, order, rnames.Get(j), rnames.Get(min_idx)): min_idx = j end
            j++
        end
        if min_idx != i: collections.Swap(rnames, i, min_idx) end
        i++
    end
end

func rank_table(s &: Store, order: Vector<str>, rnames: Vector<str>, count: int, reverse: bool): Vector<str>:
    mut out := Vector {} as Vector<str> out.Push("| Rank | Program | Salam-l (ms) | Best other language | vs best other |")
    out.Push("|---|---|---|---|---|")
    mut i := 0
    until i < count:
        mut idx := i
        if reverse: idx = rnames.Len() - 1 - i end
        out.Push(rank_row(s, order, i + 1, rnames.Get(idx)))
        i++
    end
    ret out
end

func push_all(dst &: Vector<str>, src: Vector<str>):
    mut i := 0
    until i < src.Len():
        dst.Push(src.Get(i))
        i++
    end
end

func rank_sections(s &: Store, order: Vector<str>, names: Vector<str>): Vector<str>:
    mut rnames := Vector {} as Vector<str> defer rnames.Free()
    rank_collect(s, order, names, rnames)
    rank_sort(s, order, rnames)
    mut out := Vector {} as Vector<str>
    if rnames.Len() == 0: ret out end
    mut fast_n := 10
    if fast_n > rnames.Len(): fast_n = rnames.Len() end
    mut slow_n := 20
    if slow_n > rnames.Len(): slow_n = rnames.Len() end

    out.Push("### Top ".Concat(conv.FormatInt(fast_n as i64)).Concat(" fastest programs in Salam-l"))
    out.Push("")
    out.Push("Where the LLVM backend (`-O3`) does best **relative to the fastest non-Salam")
    out.Push("entry on the same program**: sorted by `vs best other` (Salam-l's minimum")
    out.Push("divided by that language's), lowest ratio first. Under 1.00x means Salam-l")
    out.Push("wins the row outright. Absolute ms are shown but are not the sort key, since")
    out.Push("they mostly track how big each program's workload is.")
    out.Push("")
    fast_tbl := rank_table(s, order, rnames, fast_n, false)
    push_all(out, fast_tbl)
    defer fast_tbl.Free()
    out.Push("")

    out.Push("### Top ".Concat(conv.FormatInt(slow_n as i64)).Concat(" slowest programs in Salam-l"))
    out.Push("")
    out.Push("The same ranking inverted: the programs where Salam-l gives up the most")
    out.Push("against the best other language, worst ratio first. These are the ones worth")
    out.Push("profiling. Ranked over the ".Concat(conv.FormatInt(rnames.Len() as i64)).Concat(" programs that have both a Salam-l and a"))
    out.Push("non-Salam timing.")
    out.Push("")
    slow_tbl := rank_table(s, order, rnames, slow_n, true)
    push_all(out, slow_tbl)
    defer slow_tbl.Free()
    out.Push("")
    ret out
end
