package bench

import conv
import collections

func llvm min(s &: Store, name: str): f64:
    k := kkey(name, "salam_llvm")
    if sget(s.status, k) == "ok": ret round0(fget(s.m min, k)) end
    ret -1.0
end

func other best lang(s &: Store, name: str, order: Vector<str>): str:
    mut best := -1.0
    mut blang := ""
    mut j := 0
    until j < order.len():
        lg := order.get(j)[0]
        sal := is salam(lg)
        if !sal:
            k := kkey(name, lg)
            if sget(s.status, k) == "ok":
                v := round0(fget(s.m min, k))
                if best < 0.0 || v < best:
                    best = v
                    blang = lg
                end
            end
        end
        j = j + 1
    end
    ret blang
end

func rank row(s &: Store, order: Vector<str>, rank: int, name: str, ms: f64): str:
    olang := other best lang(s, name, order)
    mut ocell := "-"
    mut vs cell := "-"
    if olang.len() > 0:
        ov := round0(fget(s.m min, kkey(name, olang)))
        ocell = lang label(olang).concat(" (").concat(fmt0(ov)).concat(")")
        if ov > 0.0 && ms > 0.0: vs cell = xstr(ms / ov) end
    end
    mut row := "| ".concat(conv.FormatInt(rank as i64)).concat(" | ").concat(name)
    row = row.concat(" | ").concat(fmt0(ms))
    row = row.concat(" | ").concat(ocell).concat(" | ").concat(vs cell).concat(" |")
    ret row
end

func rank collect(s &: Store, names: Vector<str>, rnames &: Vector<str>, rms &: Vector<f64>):
    mut i := 0
    until i < names.len():
        name := names.get(i)[0]
        v := llvm min(s, name)
        if v >= 0.0:
            rnames.push(name)
            rms.push(v)
        end
        i = i + 1
    end
end

func rank sort(rnames: Vector<str>, rms: Vector<f64>):
    mut i := 0
    until i < rms.len():
        mut min idx := i
        mut j := i + 1
        until j < rms.len():
            if rms.get(j)[0] < rms.get(min idx)[0]: min idx = j end
            j = j + 1
        end
        if min idx != i:
            collections.swap(rnames, i, min idx)
            collections.swap(rms, i, min idx)
        end
        i = i + 1
    end
end

func rank table(s &: Store, order: Vector<str>, rnames: Vector<str>, rms: Vector<f64>, count: int, reverse: bool): Vector<str>:
    mut out := Vector {} as Vector<str> out.push("| Rank | Program | Salam-l (ms) | Best other language | vs best other |")
    out.push("|---|---|---|---|---|")
    mut i := 0
    until i < count:
        mut idx := i
        if reverse: idx = rnames.len() - 1 - i end
        out.push(rank row(s, order, i + 1, rnames.get(idx)[0], rms.get(idx)[0]))
        i = i + 1
    end
    ret out
end

func push all(dst &: Vector<str>, src: Vector<str>):
    mut i := 0
    until i < src.len():
        dst.push(src.get(i)[0])
        i = i + 1
    end
end

func rank sections(s &: Store, order: Vector<str>, names: Vector<str>): Vector<str>:
    mut rnames := Vector {} as Vector<str> defer rnames.free()
    mut rms := Vector {} as Vector<f64> defer rms.free()
    rank collect(s, names, rnames, rms)
    rank sort(rnames, rms)
    mut out := Vector {} as Vector<str>
    if rnames.len() == 0: ret out end
    mut fast n := 10
    if fast n > rnames.len(): fast n = rnames.len() end
    mut slow n := 20
    if slow n > rnames.len(): slow n = rnames.len() end

    out.push("### Top ".concat(conv.FormatInt(fast n as i64)).concat(" fastest programs in Salam-l"))
    out.push("")
    out.push("Ranked by the **Salam-l (LLVM backend, `-O3`) minimum time**, fastest first,")
    out.push("over the ".concat(conv.FormatInt(rnames.len() as i64)).concat(" programs Salam-l completed. `Best other language` is the"))
    out.push("quickest non-Salam entry on the same program, so a `vs best other` under")
    out.push("1.00x means Salam-l wins that row outright.")
    out.push("")
    fast tbl := rank table(s, order, rnames, rms, fast n, false)
    push all(out, fast tbl)
    fast tbl.free()
    out.push("")

    out.push("### Top ".concat(conv.FormatInt(slow n as i64)).concat(" slowest programs in Salam-l"))
    out.push("")
    out.push("The same ranking inverted: the programs Salam-l takes longest on, slowest")
    out.push("first. Absolute time dominates this list, so a slow row is not by itself a")
    out.push("Salam-l weakness -- read it together with `vs best other`.")
    out.push("")
    slow tbl := rank table(s, order, rnames, rms, slow n, true)
    push all(out, slow tbl)
    slow tbl.free()
    out.push("")
    ret out
end
