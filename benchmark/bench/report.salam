package bench

import str
import conv
import fmt
import stats
import io
import filepath
import collections
import os
import time

func round0(x: f64): f64: ret ((x + 0.5) as i64) as f64 end

func xstr(r: f64): str: ret fmt.FloatPrec(r, 2).Concat("x") end

func gm less(a: f64, b: f64): bool:
    if a <= 0.0: ret false end
    if b <= 0.0: ret true end
    ret a < b
end

func names contains(names: Vector<str>, target: str): bool:
    mut i := 0
    until i < names.Len():
        if names.Get(i) == target: ret true end
        i++
    end
    ret false
end

func lang counted(s &: Store, name: str, lang: str): bool:
    k := kkey(name, lang)
    if sget(s.status, k) != "ok": ret false end
    ret fget(s.m min, k) > 0.0
end

func lang min geomean(s &: Store, names: Vector<str>, lang: str): f64:
    mut vals := Vector {} as Vector<f64> defer vals.Free()
    mut i := 0
    until i < names.Len():
        name := names.Get(i)
        if lang counted(s, name, lang): vals.Push(fget(s.m min, kkey(name, lang))) end
        i++
    end
    result := stats.Geomean(vals)
    ret result
end

func lang counted n(s &: Store, names: Vector<str>, lang: str): int:
    mut n := 0
    mut i := 0
    until i < names.Len():
        if lang counted(s, names.Get(i), lang): n++ end
        i++
    end
    ret n
end

func status label(st: str): str:
    switch st:
        "build_failed":
            ret "build failed"
        end
        "run_failed":
            ret "run failed"
        end
        "mismatch":
            ret "output mismatch"
        end
        "ok":
            ret "ok"
        end
    end
    ret "not run"
end

func failure sections(s &: Store, names: Vector<str>, order: Vector<str>): Vector<str>:
    mut out := Vector {} as Vector<str> mut rows := Vector {} as Vector<str> defer rows.Free()
    mut i := 0
    until i < names.Len():
        name := names.Get(i)
        mut j := 0
        until j < order.Len():
            lg := order.Get(j)
            st := sget(s.status, kkey(name, lg))
            if st != "ok":
                mut row := "| ".Concat(name).Concat(" | ").Concat(lang label(lg))
                row = row.Concat(" | ").Concat(status label(st)).Concat(" |")
                rows.Push(row)
            end
            j++
        end
        i++
    end
    if rows.Len() == 0: ret out end
    out.Push("## Failures")
    out.Push("")
    out.Push(conv.FormatInt(rows.Len() as i64).Concat(" program/language pairs produced no timing. They are left out of that"))
    out.Push("language's geomean, which is why the `Programs` column in the ranking is")
    out.Push("worth reading before comparing two rows. Full compiler output for each one")
    out.Push("is in `results.json`.")
    out.Push("")
    out.Push("| Program | Language | Status |")
    out.Push("|---|---|---|")
    mut shown := rows.Len()
    if shown > 30: shown = 30 end
    mut r := 0
    until r < shown:
        out.Push(rows.Get(r))
        r++
    end
    if rows.Len() > shown:
        out.Push("")
        out.Push("...and ".Concat(conv.FormatInt((rows.Len() - shown) as i64)).Concat(" more, in `results.json`."))
    end
    out.Push("")
    ret out
end

func program best(s &: Store, name: str, order: Vector<str>): f64:
    mut best := -1.0
    mut j := 0
    until j < order.Len():
        k := kkey(name, order.Get(j))
        if sget(s.status, k) == "ok":
            v := round0(fget(s.m min, k))
            if best < 0.0 or v < best: best = v end
        end
        j++
    end
    ret best
end

func program winners(s &: Store, name: str, order: Vector<str>): Vector<str>:
    best := program best(s, name, order)
    mut winners := Vector {} as Vector<str> mut j := 0
    until j < order.Len():
        lg := order.Get(j)
        k := kkey(name, lg)
        if sget(s.status, k) == "ok":
            v := round0(fget(s.m min, k))
            if best >= 0.0 and v == best: winners.Push(lg) end
        end
        j++
    end
    ret winners
end

func compute wins(s &: Store, names: Vector<str>, order: Vector<str>): Vector<int>:
    mut wins := Vector {} as Vector<int> mut oi := 0
    until oi < order.Len():
        wins.Push(0)
        oi++
    end
    mut i := 0
    until i < names.Len():
        name := names.Get(i)
        winners := program winners(s, name, order)
        mut j := 0
        until j < winners.Len():
            idx := collections.IndexOf(order, winners.Get(j))
            if idx >= 0: wins.Set(idx, wins.Get(idx) + 1) end
            j++
        end
        winners.Free()
        i++
    end
    ret wins
end

func fastest cell(s &: Store, name: str, order: Vector<str>): str:
    winners := program winners(s, name, order)
    defer winners.Free()
    best := program best(s, name, order)
    mut salam count := 0
    mut j := 0
    until j < winners.Len():
        if is salam(winners.Get(j)): salam count++ end
        j++
    end
    mut labels := Vector {} as Vector<str> defer labels.Free()
    mut added salam := false
    mut j2 := 0
    until j2 < winners.Len():
        lg := winners.Get(j2)
        if is salam(lg):
            if salam count >= 2:
                if not added salam:
                    labels.Push("Salam")
                    added salam = true
                end
            else:
                labels.Push(lang label(lg))
            end
        else:
            labels.Push(lang label(lg))
        end
        j2++
    end
    joined := str.Join(labels, " / ")
    mut cell := joined.Concat(" (").Concat(fmt0(best)).Concat(")")
    if salam count > 0: cell = "**".Concat(cell).Concat("**") end
    ret cell
end

func min cell(s &: Store, name: str, lang: str): str:
    k := kkey(name, lang)
    if sget(s.status, k) == "ok": ret fmt0(fget(s.m min, k)) end
    ret "-"
end

func program class(s &: Store, name: str, order: Vector<str>): int:
    winners := program winners(s, name, order)
    defer winners.Free()
    mut has salam := false
    mut has other := false
    mut j := 0
    until j < winners.Len():
        if is salam(winners.Get(j)): has salam = true
        else:
            has other = true
        end
        j++
    end
    if has salam and not has other: ret 2 end
    if has salam and has other: ret 1 end
    ret 0
end

func salam best min(s &: Store, name: str): f64:
    mut best := -1.0
    mut lgs := Vector {} as Vector<str> defer lgs.Free()
    lgs.Push("salam_llvm")
    lgs.Push("salam_native")
    lgs.Push("salam_gcc")
    lgs.Push("salam_tcc")
    mut i := 0
    until i < lgs.Len():
        k := kkey(name, lgs.Get(i))
        if sget(s.status, k) == "ok":
            v := round0(fget(s.m min, k))
            if best < 0.0 or v < best: best = v end
        end
        i++
    end
    ret best
end

pub func WriteReport(cfg &: Config, s &: Store, names: Vector<str>, ekeys: Vector<str>, evals: Vector<str>, started: i64, finished: i64):
    order := lang order()
    defer order.Free()
    mut lines := Vector {} as Vector<str> defer lines.Free()

    lines.Push("# Salam Benchmark Suite Results")
    lines.Push("")
    lines.Push(conv.FormatInt(names.Len() as i64).Concat(" CPU- and IO-bound programs implemented identically in C, C++, Rust, Go,"))
    lines.Push("Python, PHP, and Salam. Salam is measured four ways: the LLVM backend at")
    lines.Push("`-O3`, the native x86-64 backend (`--backend=native`), the C backend compiled")
    lines.Push("by `gcc -O3`, and the default `tcc` toolchain (no optimizer) as the")
    lines.Push("out-of-the-box reference. C and C++ run at `-O3` too.")
    lines.Push("")
    lines.Push("- Date: ".Concat(time.FormatISOUTC(started / 1000000000)).Concat(" (took ").Concat(conv.FormatInt((finished - started) / 60000000000)).Concat(" min)"))
    commit := os.Env("BENCH_COMMIT")
    if commit.Len() > 0: lines.Push("- Commit: `".Concat(commit).Concat("`")) end
    lines.Push("")

    lines.Push("## Methodology")
    lines.Push("")
    if cfg.runs > 1:
        lines.Push("Times below are the **minimum wall-clock over ".Concat(conv.FormatInt(cfg.runs as i64)).Concat(" timed runs** (plus one"))
        lines.Push("untimed warm-up run per variant). The minimum is the most robust")
        lines.Push("single-number estimator on a shared machine: it rejects scheduler and")
        lines.Push("background-load noise, which inflates averages on short-lived processes.")
    else:
        lines.Push("Times below are from **a single timed run** per variant (plus one untimed")
        lines.Push("warm-up run). One sample cannot filter out scheduler or background-load")
        lines.Push("noise, so treat small differences with care.")
    end
    lines.Push("Each program prints a deterministic result that is identical across every")
    lines.Push("language; all variants are verified against the C output before timing.")
    lines.Push("")
    lines.Push("For the full per-run distribution (min/avg/max/median/stdev, raw epoch-ns")
    lines.Push("samples), see [`results.json`](results.json) and [`results.csv`](results.csv).")
    lines.Push("")

    lines.Push("## Environment")
    lines.Push("")
    mut env order := Vector {} as Vector<str> defer env order.Free()
    env order.Push("cpu")
    env order.Push("gcc")
    env order.Push("g++")
    env order.Push("rustc")
    env order.Push("go")
    env order.Push("tcc")
    env order.Push("clang")
    env order.Push("python")
    env order.Push("numpy")
    env order.Push("php")
    env order.Push("salam")
    mut ei := 0
    until ei < env order.Len():
        ek := env order.Get(ei)
        ev := env get(ekeys, evals, ek)
        mut el := ek
        if ek == "cpu": el = "CPU" end
        if ev.Len() > 0: lines.Push("- **".Concat(el).Concat("**: ").Concat(ev)) end
        ei++
    end
    lines.Push("")

    c gm := lang min geomean(s, names, "c")
    rust gm := lang min geomean(s, names, "rust")
    python gm := lang min geomean(s, names, "python")
    php gm := lang min geomean(s, names, "php")

    mut salam best gm := lang min geomean(s, names, "salam_gcc")
    mut salam best lang := "salam_gcc"
    llvm gm := lang min geomean(s, names, "salam_llvm")
    if llvm gm > 0.0 and (salam best gm <= 0.0 or llvm gm < salam best gm):
        salam best gm = llvm gm
        salam best lang = "salam_llvm"
    end
    native gm := lang min geomean(s, names, "salam_native")
    if native gm > 0.0 and (salam best gm <= 0.0 or native gm < salam best gm):
        salam best gm = native gm
        salam best lang = "salam_native"
    end
    tcc gm := lang min geomean(s, names, "salam_tcc")
    if tcc gm > 0.0 and (salam best gm <= 0.0 or tcc gm < salam best gm):
        salam best gm = tcc gm
        salam best lang = "salam_tcc"
    end

    mut gm langs := Vector {} as Vector<str> defer gm langs.Free()
    mut gm vals := Vector {} as Vector<f64> defer gm vals.Free()
    mut gm counts := Vector {} as Vector<int> defer gm counts.Free()
    mut oi := 0
    until oi < order.Len():
        lg := order.Get(oi)
        gm langs.Push(lg)
        gm vals.Push(lang min geomean(s, names, lg))
        gm counts.Push(lang counted n(s, names, lg))
        oi++
    end
    mut gm wins := compute wins(s, names, order)
    defer gm wins.Free()

    mut si := 0
    until si < gm vals.Len():
        mut min idx := si
        mut sj := si + 1
        until sj < gm vals.Len():
            if gm less(gm vals.Get(sj), gm vals.Get(min idx)): min idx = sj end
            sj++
        end
        if min idx != si:
            collections.Swap(gm langs, si, min idx)
            collections.Swap(gm vals, si, min idx)
            collections.Swap(gm wins, si, min idx)
            collections.Swap(gm counts, si, min idx)
        end
        si++
    end

    lines.Push("## Overall ranking (fastest to slowest)")
    lines.Push("")
    lines.Push("One number per language: the **geometric mean of minimum times across the")
    lines.Push("programs it completed** (geometric mean is used because it is not skewed by the few")
    lines.Push("slow/high-variance programs the way an arithmetic mean would be). `Programs`")
    lines.Push("is how many of the ".Concat(conv.FormatInt(names.Len() as i64)).Concat(" went into that mean: a language that fails to build"))
    lines.Push("one is averaged over the rest, so two rows with different counts are not")
    lines.Push("measuring the same workload, and a row with 0 has no result at all. Lower is")
    lines.Push("faster; `vs C` and `vs Salam` express the same geomean as a multiple of C's")
    lines.Push("and of the fastest Salam backend's (".Concat(lang label(salam best lang)).Concat("). Salam's four variants are"))
    lines.Push("suffixed **-g** (C backend, `gcc -O3`), **-l** (LLVM backend, `-O3`), **-n**")
    lines.Push("(native x86-64 backend, `--release`), and **-t** (C backend, `tcc`, no")
    lines.Push("optimizer, the out-of-the-box default).")
    lines.Push("")
    lines.Push("| Rank | Language | Geomean | vs C | vs Salam | Programs | Fastest / tied-fastest on |")
    lines.Push("|---|---|---|---|---|---|---|")
    mut ri := 0
    until ri < gm langs.Len():
        lg := gm langs.Get(ri)
        val := gm vals.Get(ri)
        w := gm wins.Get(ri)
        mut label := lang label(lg)
        if is salam(lg): label = "**".Concat(label).Concat("**") end
        mut c cell := "-"
        if val > 0.0 and c gm > 0.0: c cell = xstr(val / c gm) end
        mut salam cell := "-"
        if val > 0.0 and salam best gm > 0.0: salam cell = xstr(val / salam best gm) end
        mut gm cell := fmt.FloatPrec(val, 2).Concat(" ms")
        if val <= 0.0: gm cell = "n/a" end
        mut row := "| ".Concat(conv.FormatInt((ri + 1) as i64)).Concat(" | ").Concat(label)
        row = row.Concat(" | ").Concat(gm cell).Concat(" | ").Concat(c cell)
        row = row.Concat(" | ").Concat(salam cell)
        row = row.Concat(" | ").Concat(conv.FormatInt(gm counts.Get(ri) as i64)).Concat(" / ").Concat(conv.FormatInt(names.Len() as i64))
        row = row.Concat(" | ").Concat(conv.FormatInt(w as i64)).Concat(" / ").Concat(conv.FormatInt(names.Len() as i64)).Concat(" |")
        lines.Push(row)
        ri++
    end
    lines.Push("")

    mut scale max := 0.0
    mut smi := 0
    until smi < gm langs.Len():
        if gm langs.Get(smi) != "python" and gm langs.Get(smi) != "php":
            v2 := gm vals.Get(smi)
            if v2 > scale max: scale max = v2 end
        end
        smi++
    end

    lines.Push("```")
    mut bi := 0
    until bi < gm langs.Len():
        lg := gm langs.Get(bi)
        val := gm vals.Get(bi)
        mut bar text := "(off scale)"
        if val <= 0.0: bar text = "(no result)" end
        if val > 0.0 and scale max > 0.0 and val <= scale max * 3.0:
            mut blen := ((val / scale max) * 45.0 + 0.5) as i64 as int
            if blen < 1: blen = 1 end
            if blen > 45: blen = 45 end
            bar text = str.Repeat("█", blen)
        end
        mut line := fmt.PadRight(lang label(lg), 12).Concat(" ").Concat(fmt.PadRight(bar text, 45))
        mut val text := fmt.FloatPrec(val, 2).Concat(" ms")
        if val <= 0.0: val text = "n/a" end
        line = line.Concat(" ").Concat(fmt.PadLeft(val text, 10))
        if val > 0.0 and c gm > 0.0: line = line.Concat("  ").Concat(xstr(val / c gm)).Concat(" C") end
        if lg == "c": line = line.Concat("  <- baseline") end
        lines.Push(line)
        bi++
    end
    lines.Push("```")
    lines.Push("")

    lines.Push("Takeaways:")
    lines.Push("")
    mut max win := -1
    mut max win lang := ""
    mut mi := 0
    until mi < gm wins.Len():
        wv := gm wins.Get(mi)
        if wv > max win:
            max win = wv
            max win lang = gm langs.Get(mi)
        end
        mi++
    end
    lines.Push("- **Fastest Salam backend:** ".Concat(lang label(salam best lang)).Concat(", geomean ").Concat(fmt.FloatPrec(salam best gm, 2)).Concat(" ms"))
    if c gm > 0.0 and rust gm > 0.0:
        lines.Push("  (".Concat(xstr(salam best gm / c gm)).Concat(" C's geomean, ").Concat(xstr(salam best gm / rust gm)).Concat(" Rust's)."))
    end
    if max win >= 0:
        lines.Push("- **".Concat(lang label(max win lang)).Concat(" is fastest or tied-fastest on the most programs** ("))
        lines.Push("  ".Concat(conv.FormatInt(max win as i64)).Concat("/").Concat(conv.FormatInt(names.Len() as i64)).Concat("); see the per-program table below."))
    end
    if tcc gm > 0.0 and salam best gm > 0.0 and salam best lang != "salam_tcc":
        lines.Push("- **`salam build` with no flags** (Salam-t, tcc, no optimizer) is ".Concat(xstr(tcc gm / salam best gm)).Concat(" slower than the"))
        lines.Push("  fastest Salam backend, so it is the out-of-the-box baseline, not the number")
        lines.Push("  to compare against other optimized languages -- pass `-O3` / use the LLVM")
        lines.Push("  backend for like-for-like comparisons.")
    end
    if python gm > 0.0 and php gm > 0.0 and c gm > 0.0:
        mut lo := python gm / c gm
        mut hi := php gm / c gm
        if hi < lo:
            tmp := lo
            lo = hi
            hi = tmp
        end
        lines.Push("- **Python and PHP are ".Concat(fmt0(lo)).Concat("-").Concat(fmt0(hi)).Concat("x slower** than the compiled languages on"))
        lines.Push("  this suite and are included for scale only.")
    end
    lines.Push(`- "Fastest / tied-fastest on" counts ties on every side (e.g. a 4-way tie`)
    lines.Push("  adds 1 to all 4 languages), so the column does not sum to ".Concat(conv.FormatInt(names.Len() as i64)).Concat("."))
    mut ni2 := 0
    until ni2 < gm langs.Len():
        if gm counts.Get(ni2) == 0:
            lines.Push("- **".Concat(lang label(gm langs.Get(ni2))).Concat(" produced no usable timing on any program** and is ranked"))
            lines.Push("  last with no geomean; see the failures table below.")
        end
        ni2++
    end
    lines.Push("")

    mut fail lines := failure sections(s, names, order)
    push all(lines, fail lines)
    fail lines.Free()

    lines.Push("## Per-program results (minimum ms)")
    lines.Push("")
    mut hdr := "| Program |"
    mut hi := 0
    until hi < order.Len():
        hdr = hdr.Concat(" ").Concat(lang label(order.Get(hi))).Concat(" |")
        hi++
    end
    hdr = hdr.Concat(" Fastest |")
    lines.Push(hdr)
    lines.Push(str.Repeat("|---", order.Len() + 2).Concat("|"))
    mut pi := 0
    until pi < names.Len():
        name := names.Get(pi)
        mut row := "| ".Concat(name)
        mut li := 0
        until li < order.Len():
            row = row.Concat(" | ").Concat(min cell(s, name, order.Get(li)))
            li++
        end
        row = row.Concat(" | ").Concat(fastest cell(s, name, order))
        lines.Push(row.Concat(" |"))
        pi++
    end
    lines.Push("")
    lines.Push("Bold marks rows where a Salam backend is the fastest or tied for fastest.")
    lines.Push("")

    mut rank lines := rank sections(s, order, names)
    mut rli := 0
    until rli < rank lines.Len():
        lines.Push(rank lines.Get(rli))
        rli++
    end
    defer rank lines.Free()

    lines.Push("## Summary")
    lines.Push("")
    lines.Push("Taking the **best Salam backend per program** against the best of the other")
    lines.Push("compiled languages (C / C++ / Rust / Go):")
    lines.Push("")
    mut outright := Vector {} as Vector<str> defer outright.Free()
    mut tied := Vector {} as Vector<str> defer tied.Free()
    mut trailing := Vector {} as Vector<str> defer trailing.Free()
    mut ti := 0
    until ti < names.Len():
        name := names.Get(ti)
        cls := program class(s, name, order)
        if cls == 2:
            outright.Push(name)
        else cls == 1:
            tied.Push(name)
        else:
            best := program best(s, name, order)
            sbest := salam best min(s, name)
            if best >= 0.0 and sbest >= 0.0:
                margin := sbest - best
                winners := program winners(s, name, order)
                mut wl := Vector {} as Vector<str> mut wj := 0
                until wj < winners.Len():
                    wl.Push(lang label(winners.Get(wj)))
                    wj++
                end
                winners.Free()
                item := name.Concat(" (+").Concat(fmt0(margin)).Concat(" vs ").Concat(str.Join(wl, "/")).Concat(")")
                wl.Free()
                trailing.Push(item)
            end
        end
        ti++
    end
    if outright.Len() > 0:
        lines.Push("- **Fastest outright (".Concat(conv.FormatInt(outright.Len() as i64)).Concat("):** ").Concat(str.Join(outright, ", ")).Concat("."))
    end
    if tied.Len() > 0:
        lines.Push("- **Tied for fastest (".Concat(conv.FormatInt(tied.Len() as i64)).Concat("):** ").Concat(str.Join(tied, ", ")).Concat("."))
    end
    if trailing.Len() > 0:
        lines.Push("- **Trailing the fastest (".Concat(conv.FormatInt(trailing.Len() as i64)).Concat("):** ").Concat(str.Join(trailing, "; ")).Concat("."))
    end
    lines.Push("")
    matched := outright.Len() + tied.Len()
    lines.Push("Salam matches or beats the fastest other compiled language on ".Concat(conv.FormatInt(matched as i64)).Concat(" of ").Concat(conv.FormatInt(names.Len() as i64)).Concat(" programs."))
    lines.Push("")

    lines.Push("Notes:")
    lines.Push("")
    lines.Push("- `12_hello_print` prints a constant line one million times, so it measures")
    lines.Push("  how each runtime buffers stdout more than how good its generated code is.")
    lines.Push("- The `*_stdlib_*` programs use each language's own library where it has one")
    lines.Push("  (Salam's `matrix`/`tensor`, NumPy in Python); C, C++, Rust, Go and PHP use")
    lines.Push("  plain loops. Those rows compare libraries, not compilers.")
    lines.Push("- Python and PHP are included for scale only; they are consistently much")
    lines.Push("  slower and are never the fastest on this suite.")
    lines.Push("- Measurements were taken on a single machine under normal background load;")
    lines.Push("  small gaps between the compiled languages can be within run-to-run noise.")

    io.WriteLines(filepath.Join(filepath.Join(cfg.root, "results"), "README.md"), lines)
end
