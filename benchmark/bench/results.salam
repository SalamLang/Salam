package bench

import io
import filepath
import encoding.csv
import conv
import encoding.json

func stored output(out: str): str:
    if out.Len() <= 1024: ret out end
    ret head chars(out, 512).Concat("\n... (").Concat(conv.FormatInt(out.Len() as i64)).Concat(" bytes, truncated)")
end

func mismatch json(name: str, s &: Store): str:
    order := lang order()
    defer order.Free()
    mut mism := Vector {} as Vector<str> defer mism.Free()
    mut i := 0
    until i < order.Len():
        lang := order.Get(i)
        k := kkey(name, lang)
        if sget(s.status, k) == "mismatch":
            mism.Push(json.Member(lang, stored output(sget(s.note, k))))
        end
        i++
    end
    mut res := ""
    if mism.Len() > 0: res = json.Object(mism) end
    ret res
end

func stats json(s &: Store, k: str): str:
    mut m := Vector {} as Vector<str> m.Push(json.MemberRaw("min_ms", fmt3(fget(s.m min, k))))
    m.Push(json.MemberRaw("max_ms", fmt3(fget(s.m max, k))))
    m.Push(json.MemberRaw("avg_ms", fmt3(fget(s.m avg, k))))
    m.Push(json.MemberRaw("median_ms", fmt3(fget(s.m med, k))))
    m.Push(json.MemberRaw("stdev_ms", fmt3(fget(s.m sd, k))))
    m.Push(json.MemberInt("runs", iget(s.m runs, k) as i64))
    out := json.Object(m)
    ret out
end

func samples json(s &: Store, name: str, lang: str): str:
    mut items := Vector {} as Vector<str> defer items.Free()
    mut i := 0
    until i < s.sp.Len():
        if s.sp.Get(i) == name and s.sl.Get(i) == lang:
            mut m := Vector {} as Vector<str> m.Push(json.MemberInt("epoch_start_ns", s.st0.Get(i)))
            m.Push(json.MemberInt("epoch_end_ns", s.st1.Get(i)))
            m.Push(json.MemberRaw("ms", fmt3(s.sms.Get(i))))
            items.Push(json.Object(m))
            m.Free()
        end
        i++
    end
    out := json.Array(items)
    ret out
end

pub func WriteCsv(cfg &: Config, s &: Store):
    mut lines := Vector {} as Vector<str> defer lines.Free()
    mut hdr := Vector {} as Vector<str> defer hdr.Free()
    hdr.Push("program")
    hdr.Push("language")
    hdr.Push("run")
    hdr.Push("epoch_start_ns")
    hdr.Push("epoch_end_ns")
    hdr.Push("duration_ms")
    lines.Push(csv.WriteLine(hdr))
    mut i := 0
    until i < s.sp.Len():
        mut row := Vector {} as Vector<str> row.Push(s.sp.Get(i))
        row.Push(s.sl.Get(i))
        row.Push(conv.FormatInt(s.sr.Get(i) as i64))
        row.Push(conv.FormatInt(s.st0.Get(i)))
        row.Push(conv.FormatInt(s.st1.Get(i)))
        row.Push(fmt3(s.sms.Get(i)))
        lines.Push(csv.WriteLine(row))
        row.Free()
        i++
    end
    io.WriteLines(filepath.Join(cfg.results, "results.csv"), lines)
end

pub func WriteJson(cfg &: Config, s &: Store, names: Vector<str>, ekeys: Vector<str>, evals: Vector<str>, started: i64, finished: i64):
    mut progs := Vector {} as Vector<str> defer progs.Free()
    order := lang order()
    defer order.Free()
    mut ni := 0
    until ni < names.Len():
        name := names.Get(ni)
        mut pm := Vector {} as Vector<str> pm.Push(json.Member("reference_output", stored output(sget(s.refout, name))))
        mut mm := Vector {} as Vector<str> mut em := Vector {} as Vector<str> mut lm := Vector {} as Vector<str> mut li := 0
        until li < order.Len():
            lang := order.Get(li)
            k := kkey(name, lang)
            st := sget(s.status, k)
            switch st:
                "build_failed":
                    em.Push(json.Member(lang, sget(s.berr, k)))
                    break
                end
                "ok":
                    mut e := Vector {} as Vector<str> e.Push(json.MemberRaw("stats", stats json(s, k)))
                    e.Push(json.MemberRaw("samples", samples json(s, name, lang)))
                    lm.Push(json.MemberRaw(lang, json.Object(e)))
                    e.Free()
                    break
                end
                "mismatch", "run_failed":
                    mut e := Vector {} as Vector<str> e.Push(json.MemberRaw("stats", "null"))
                    e.Push(json.MemberRaw("samples", "[]"))
                    if st == "mismatch":
                        mm.Push(json.Member(lang, stored output(sget(s.note, k))))
                        e.Push(json.Member("note", "output mismatch"))
                    end
                    lm.Push(json.MemberRaw(lang, json.Object(e)))
                    e.Free()
                    break
                end
            end
            li++
        end
        pm.Push(json.MemberRaw("mismatched", json.Object(mm)))
        pm.Push(json.MemberRaw("errors", json.Object(em)))
        pm.Push(json.MemberRaw("langs", json.Object(lm)))
        progs.Push(json.MemberRaw(name, json.Object(pm)))
        mm.Free()
        em.Free()
        lm.Free()
        pm.Free()
        ni++
    end
    mut env members := Vector {} as Vector<str> defer env members.Free()
    mut ei := 0
    until ei < ekeys.Len():
        env members.Push(json.Member(ekeys.Get(ei), evals.Get(ei)))
        ei++
    end
    mut top := Vector {} as Vector<str> defer top.Free()
    top.Push(json.MemberInt("started_epoch_ns", started))
    top.Push(json.MemberInt("finished_epoch_ns", finished))
    top.Push(json.MemberRaw("environment", json.Object(env members)))
    top.Push(json.MemberInt("runs", cfg.runs as i64))
    top.Push(json.MemberRaw("results", json.Object(progs)))
    io.WriteFile(filepath.Join(cfg.results, "results.json"), json.Indent(json.Object(top)).Concat("\n"))
end
