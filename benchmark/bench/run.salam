package bench

pub func RunProgram(name: str, cfg &: Config, s &: Store):
    println "[bench] ".Concat(name).Concat(": building")
    cmds := build program(name, cfg, s)
    defer cmds.Free()
    mj := verify prog(name, cmds, s)
    if mj.Len() > 0:
        println "[bench] ".Concat(name).Concat(": OUTPUT MISMATCH ").Concat(mj)
    end
    order := lang order()
    defer order.Free()
    mut li := 0
    until li < order.Len():
        lang := order.Get(li)
        k := kkey(name, lang)
        if cmds.Has(lang) and sget(s.status, k) != "mismatch":
            println "[bench] ".Concat(name).Concat(": timing ").Concat(lang)
            if bench lang(name, lang, cmds.Get(lang), cfg, s):
                mut msg := "[bench] ".Concat(name).Concat(": ").Concat(lang)
                msg = msg.Concat(" min=").Concat(fmt1(fget(s.m min, k)))
                msg = msg.Concat(" avg=").Concat(fmt1(fget(s.m avg, k)))
                msg = msg.Concat(" max=").Concat(fmt1(fget(s.m max, k))).Concat(" ms")
                println msg
            else:
                println "[bench] ".Concat(name).Concat(": ").Concat(lang).Concat(" FAILED at runtime")
            end
        end
        li++
    end
end
