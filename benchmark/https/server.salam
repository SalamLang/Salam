import conv
import mem
import net.http
import net.router
import os

mut body_100k := ""

func json_route(h: i64):
    http.Json(http.Ctx(h), "{\"message\":\"Hello, World!\"}")
end

func kb100_route(h: i64):
    http.Text(http.Ctx(h), body_100k)
end

func main:
    a := os.Args()
    mut port := 0
    try:
        port = conv.ParseInt(a.Get(2)) as int
    catch:
        ret 1
    end
    m := mem.Allocate(102401 as u64)
    mem.Set(m, 120, 102400 as u64)
    bp := m as u8*
    bp[102400] = 0 as u8
    body_100k = m as str
    mut r := router.NewRouter()
    router.Get(r, "/json", json_route)
    router.Get(r, "/100k", kb100_route)
    router.Static(r, "/s", ".")
    mut s := http.NewServer(port)
    http.Use(s, r)
    if a.Get(1) == "https":
        http.RunTLS(s, a.Get(3), a.Get(4))
    else:
        http.Run(s)
    end
    ret 0
end
