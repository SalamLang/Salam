func main:
    mut sum := 0.0
    mut sign := 1.0
    mut den := 1.0
    mut k := 0 as i64
    until k < 3000000:
        sum += sign / den
        sign = 0.0 - sign
        den += 2.0
        k++
    end
    pi := 4.0 * sum
    v := pi * 1000000.0
    println v as i64
end
