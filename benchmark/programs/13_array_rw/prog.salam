func main:
    mut arr := Vector {} as Vector<i64> arr.Zeros(1000000)
    mut i := 0
    until i < 1000000:
        n := i as i64
        arr.Set(i, (n * n + 3 * n + 7) % 1000000007)
        i++
    end
    mut sum := 0 as i64
    mut pass := 0
    until pass < 5:
        mut j := 0
        until j < 1000000:
            sum = (sum + arr.Get(j) + (pass as i64)) % 1000000007
            j++
        end
        pass++
    end
    println sum
end
