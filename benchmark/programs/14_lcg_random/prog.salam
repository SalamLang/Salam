func main:
    mut x := 1 as i64
    mut sum := 0 as i64
    mut i := 0
    until i < 5000000:
        x = (x * 1103515245 + 12345) % 2147483648
        sum = (sum + x) % 1000000007
        i = i + 1
    end
    println sum
end
