func quicksort(arr: Vector<i64>, lo: int, hi: int):
    if lo >= hi:
        ret
    end
    mid := (lo + hi) / 2
    pivot := arr.Get(mid)
    mut i := lo
    mut j := hi
    until i <= j:
        until arr.Get(i) < pivot:
            i++
        end
        until arr.Get(j) > pivot:
            j--
        end
        if i <= j:
            tmp := arr.Get(i)
            arr.Set(i, arr.Get(j))
            arr.Set(j, tmp)
            i++
            j--
        end
    end
    quicksort(arr, lo, j)
    quicksort(arr, i, hi)
end

func main:
    n := 300000
    mut arr := Vector {} as Vector<i64> mut x := 1 as i64
    mut i := 0
    until i < n:
        x = (x * 1103515245 + 12345) % 2147483648
        arr.Push(x)
        i++
    end
    quicksort(arr, 0, n - 1)
    mut checksum := 0 as i64
    i = 0
    until i < n:
        checksum = (checksum + (arr.Get(i) % 1000000007) * (((i + 1) as i64) % 1000000007)) % 1000000007
        i++
    end
    println arr.Get(0)
    println arr.Get(n - 1)
    println checksum
end
