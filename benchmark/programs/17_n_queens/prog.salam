 * Repository: https://github.com/SalamLang/Salam
 *
 */

func solve(row: int, n: int, cols &: Vector<i32>, diag1 &: Vector<i32>, diag2 &: Vector<i32>, solutions &: i64):
    if row == n:
        solutions++
        ret
    end
    mut col := 0
    until col < n:
        d1 := row + col
        d2 := row - col + n - 1
        ci := col
        if cols.Get(ci) == 0 and diag1.Get(d1) == 0 and diag2.Get(d2) == 0:
            cols.Set(ci, 1 as i32)
            diag1.Set(d1, 1 as i32)
            diag2.Set(d2, 1 as i32)
            solve(row + 1, n, cols, diag1, diag2, solutions)
            cols.Set(ci, 0 as i32)
            diag1.Set(d1, 0 as i32)
            diag2.Set(d2, 0 as i32)
        end
        col++
    end
end

func main:
    n := 12
    mut cols := Vector {} as Vector<i32> mut diag1 := Vector {} as Vector<i32> mut diag2 := Vector {} as Vector<i32> mut i := 0
    until i < n:
        cols.Push(0 as i32)
        i++
    end
    i = 0
    until i < 2 * n - 1:
        diag1.Push(0 as i32)
        diag2.Push(0 as i32)
        i++
    end
    mut solutions := 0 as i64
    solve(0, n, cols, diag1, diag2, solutions)
    println solutions
end
