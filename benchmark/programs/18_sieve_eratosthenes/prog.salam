func main:
    LIMIT := 3000000
    mut is_composite := Vector {} as Vector<i8> is_composite.zeros(LIMIT + 1)
    mut i := 0
    is_composite.Set(0, 1 as i8)
    is_composite.Set(1, 1 as i8)
    i = 2
    until i * i <= LIMIT:
        if is_composite.Get(i) == 0:
            mut j := i * i
            until j <= LIMIT:
                is_composite.Set(j, 1 as i8)
                j += i
            end
        end
        i++
    end
    mut count := 0 as i64
    mut k := 2
    until k <= LIMIT:
        if is_composite.Get(k) == 0:
            count++
        end
        k++
    end
    println count
end
