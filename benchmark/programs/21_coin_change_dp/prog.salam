func main:
    AMOUNT := 100000
    mut coins := Vector {} as Vector<i64> coins.Push(1 as i64)
    coins.Push(5 as i64)
    coins.Push(10 as i64)
    coins.Push(25 as i64)
    coins.Push(50 as i64)
    coins.Push(100 as i64)

    mut ways := Vector {} as Vector<i64> mut i := 0
    until i <= AMOUNT:
        ways.Push(0 as i64)
        i++
    end
    ways.Set(0, 1 as i64)

    mut ci := 0
    until ci < 6:
        c := coins.Get(ci) as int
        mut a := c
        until a <= AMOUNT:
            v := (ways.Get(a) + ways.Get(a - c)) % 1000000007
            ways.Set(a, v)
            a++
        end
        ci++
    end

    result := ways.Get(AMOUNT)
    println result
end
