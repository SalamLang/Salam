 * Born from a decade of language design experience (since 2018)
 *
 * Repository: https://github.com/SalamLang/Salam
 *
 */

func main:
    NITEMS := 500
    CAPACITY := 12500
    mut weight := Vector {} as Vector<i64> mut value := Vector {} as Vector<i64> mut dp := Vector {} as Vector<i64> mut i := 0
    until i < NITEMS:
        wi := ((i * 7 + 3) % 50 + 1) as i64
        vi := ((i * 13 + 5) % 100 + 1) as i64
        weight.Push(wi)
        value.Push(vi)
        i++
    end

    mut k := 0
    until k <= CAPACITY:
        dp.Push(0 as i64)
        k++
    end

    i = 0
    until i < NITEMS:
        wi := weight.Get(i) as int
        vi := value.Get(i)
        mut w := CAPACITY
        until w >= wi:
            cand := dp.Get(w - wi) + vi
            if cand > dp.Get(w):
                dp.Set(w, cand)
            end
            w--
        end
        i++
    end

    result := dp.Get(CAPACITY)
    println result
end
