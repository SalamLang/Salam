func ackermann(m: i64, n: i64): i64:
    if m == 0: ret n + 1 end
    if n == 0: ret ackermann(m - 1, 1) end
    ret ackermann(m - 1, ackermann(m, n - 1))
end

func main:
    println ackermann(3, 6)
end
