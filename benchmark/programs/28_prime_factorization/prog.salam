func main:
    limit := 2000000 as i64
    mut total := 0 as i64
    mut n := 2 as i64
    until n <= limit:
        mut temp := n
        mut d := 2 as i64
        until d * d <= temp:
            until temp % d == 0:
                total++
                temp /= d
            end
            d++
        end
        if temp > 1:
            total++
        end
        n++
    end
    println total
end
