func main:
    n := 10000000 as i64
    mut dot := 0 as i64
    mut i := 0 as i64
    until i < n:
        a := (i * 3 + 1) % 1009
        b := (i * 7 + 2) % 1013
        dot = (dot + a * b) % 1000000007
        i = i + 1
    end
    println dot
end
