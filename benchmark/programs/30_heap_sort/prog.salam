func heapify(arr: Vector<i64>, n: int, i: int):
    mut largest := i
    l := 2 * i + 1
    r := 2 * i + 2
    if l < n and arr.Get(l) > arr.Get(largest):
        largest = l
    end
    if r < n and arr.Get(r) > arr.Get(largest):
        largest = r
    end
    if largest != i:
        tmp := arr.Get(i)
        arr.Set(i, arr.Get(largest))
        arr.Set(largest, tmp)
        heapify(arr, n, largest)
    end
end

func main:
    n := 300000
    mut arr := Vector {} as Vector<i64> arr.zeros(n)
    mut x := 3 as i64
    mut i := 0
    until i < n:
        x = (x * 1103515245 + 12345) % 2147483648
        arr.Set(i, x)
        i++
    end
    mut j := n / 2 - 1
    until j >= 0:
        heapify(arr, n, j)
        j--
    end
    mut bound := n - 1
    until bound >= 1:
        tmp := arr.Get(0)
        arr.Set(0, arr.Get(bound))
        arr.Set(bound, tmp)
        heapify(arr, bound, 0)
        bound--
    end
    mut checksum := 0 as i64
    i = 0
    until i < n:
        checksum = (checksum + (arr.Get(i) % 1000000007) * (((i + 1) as i64) % 1000000007)) % 1000000007
        i++
    end
    println arr.Get(0)
    println arr.Get(n - 1)
    println checksum
end
