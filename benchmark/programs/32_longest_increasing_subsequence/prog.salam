 * Designed by Seyyed Ali Mohammadiyeh and the Salam Team
 * Born from a decade of language design experience (since 2018)
 *
 * Repository: https://github.com/SalamLang/Salam
 *
 */

func main:
    N := 6000

    mut seq := Vector {} as Vector<i64> mut i := 0
    until i < N:
        seq.Push(((i * 37 + 11) % 10007) as i64)
        i++
    end

    mut dp := Vector {} as Vector<i64> i = 0
    until i < N:
        dp.Push(1 as i64)
        i++
    end

    i = 0
    until i < N:
        mut j := 0
        until j < i:
            if seq.Get(j) < seq.Get(i):
                if dp.Get(j) + 1 > dp.Get(i):
                    dp.Set(i, dp.Get(j) + 1)
                end
            end
            j++
        end
        i++
    end

    mut answer := dp.Get(0)
    i = 0
    until i < N:
        if dp.Get(i) > answer:
            answer = dp.Get(i)
        end
        i++
    end

    println answer
end
