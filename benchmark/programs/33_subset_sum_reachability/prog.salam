 * Designed by Seyyed Ali Mohammadiyeh and the Salam Team
 * Born from a decade of language design experience (since 2018)
 *
 * Repository: https://github.com/SalamLang/Salam
 *
 */

func main:
    NITEMS := 1000
    TARGET := 30000
    mut weight := Vector {} as Vector<i32> mut reachable := Vector {} as Vector<i32> mut i := 0
    until i < NITEMS:
        wi := ((i * 11 + 5) % 40) + 1
        weight.Push(wi)
        i++
    end

    reachable.zeros(TARGET + 1)
    mut s := 0
    reachable.Set(0, 1)

    i = 0
    until i < NITEMS:
        wi := weight.Get(i)
        w := wi
        mut s2 := TARGET
        until s2 >= w:
            if reachable.Get(s2 - w) == 1:
                reachable.Set(s2, 1 as i32)
            end
            s2--
        end
        i++
    end

    mut count := 0 as i64
    s = 0
    until s <= TARGET:
        if reachable.Get(s) == 1:
            count++
        end
        s++
    end

    println count
end
