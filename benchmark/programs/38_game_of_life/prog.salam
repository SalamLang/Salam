/*
 * Salam Programming Language (2024-2026)
 *
 *   +-------------------+
 *   |     S A L A M     |
 *   +-------------------+
 *
 * Designed by Seyyed Ali Mohammadiyeh and the Salam Team
 * Born from a decade of language design experience (since 2018)
 *
 * Repository: https://github.com/SalamLang/Salam
 *
 */

func main:
    w := 150
    h := 150
    generations := 150

    mut grid := Vector {} as Vector<i32> mut next_grid := Vector {} as Vector<i32> mut r := 0
    until r < h:
        mut c := 0
        until c < w:
            seed := (r * 31 + c * 17 + 7) % 5
            if seed == 0:
                grid.Push(1 as i32)
            else:
                grid.Push(0 as i32)
            end
            next_grid.Push(0 as i32)
            c++
        end
        r++
    end

    mut gen := 0
    until gen < generations:
        r = 0
        until r < h:
            mut c := 0
            until c < w:
                mut count := 0 as i32
                mut dr := -1
                until dr <= 1:
                    mut dc := -1
                    until dc <= 1:
                        if not (dr == 0 and dc == 0):
                            nr := r + dr
                            nc := c + dc
                            if nr >= 0 and nr < h and nc >= 0 and nc < w:
                                count += grid.Get(nr * w + nc)
                            end
                        end
                        dc++
                    end
                    dr++
                end
                alive := grid.Get(r * w + c)
                if alive == 1 as i32:
                    if count == 2 as i32 or count == 3 as i32:
                        next_grid.Set(r * w + c, 1 as i32)
                    else:
                        next_grid.Set(r * w + c, 0 as i32)
                    end
                else:
                    if count == 3 as i32:
                        next_grid.Set(r * w + c, 1 as i32)
                    else:
                        next_grid.Set(r * w + c, 0 as i32)
                    end
                end
                c++
            end
            r++
        end
        tmp := grid
        grid = next_grid
        next_grid = tmp
        gen++
    end

    mut live_count := 0 as i64
    mut i := 0
    until i < w * h:
        live_count += (grid.Get(i) as i64)
        i++
    end
    println live_count
end
