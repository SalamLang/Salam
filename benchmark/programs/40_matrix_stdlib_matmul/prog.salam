// Matrix-stdlib benchmark: unlike 15_matrix_mult (a hand-rolled triple loop
// in every language), this drives the real std/matrix package end to end -
// Zeros, set and MatMul - the same calls a Salam program would actually make.
// The Python side is real NumPy (@), not a Python triple loop, so this is
// Salam's matrix library against NumPy's, not against itself.

import matrix

func main:
    n := 400
    mut a := matrix.Zeros(n, n)
    mut b := matrix.Zeros(n, n)
    mut i := 0
    until i < n:
        mut j := 0
        until j < n:
            a.set(i, j, ((i * 3 + j * 7 + 1) % 97) as f64)
            b.set(i, j, ((i * 5 + j * 2 + 3) % 89) as f64)
            j = j + 1
        end
        i = i + 1
    end
    c := matrix.MatMul(a, b)
    mut checksum := 0 as i64
    mut k := 0
    until k < c.count():
        checksum = (checksum + (c.flat(k) as i64)) % 1000000007
        k = k + 1
    end
    println checksum
end
