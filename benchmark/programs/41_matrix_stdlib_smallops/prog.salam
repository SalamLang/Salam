import matrix

func main:
    reps := 200000
    mut checksum := 0 as i64
    mut r := 0
    until r < reps:
        mut a := matrix.Zeros(4, 4)
        mut i := 0
        until i < 4:
            mut j := 0
            until j < 4:
                a.Set(i, j, ((r + i * 3 + j * 7 + 1) % 97) as f64)
                j++
            end
            i++
        end
        mut t := matrix.Transpose(a)
        mut c := matrix.MatMul(a, t)
        tr := matrix.Trace(c)
        checksum = (checksum + (tr as i64)) % 1000000007
        a.Free()
        t.Free()
        c.Free()
        r++
    end
    println checksum
end
