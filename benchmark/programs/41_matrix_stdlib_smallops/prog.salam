// Many small matrix-stdlib calls rather than one big one: build a 4x4,
// transpose it, multiply, take the trace, repeat. This is the shape most
// real code actually has - lots of small operations - where a compiled
// library pays no per-call dispatch tax and NumPy's does.

import matrix

func main:
    reps := 200000
    mut checksum := 0 as i64
    mut r := 0
    until r < reps:
        mut a := matrix.Zeros(4, 4)
        mut i := 0
        until i < 4:
            mut j := 0
            until j < 4:
                a.set(i, j, ((r + i * 3 + j * 7 + 1) % 97) as f64)
                j = j + 1
            end
            i = i + 1
        end
        t := matrix.Transpose(a)
        c := matrix.MatMul(a, t)
        tr := matrix.Trace(c)
        checksum = (checksum + (tr as i64)) % 1000000007
        a.free()
        t.free()
        c.free()
        r = r + 1
    end
    println checksum
end
