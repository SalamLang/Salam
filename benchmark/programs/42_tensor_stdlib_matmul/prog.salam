import tensor

func main:
    n := 400
    mut a := tensor.Zeros2(n, n)
    mut b := tensor.Zeros2(n, n)
    mut i := 0
    until i < n:
        mut j := 0
        until j < n:
            a.set_at2(i, j, ((i * 3 + j * 7 + 1) % 97) as f64)
            b.set_at2(i, j, ((i * 5 + j * 2 + 3) % 89) as f64)
            j = j + 1
        end
        i = i + 1
    end
    c := tensor.MatMul(a, b)
    mut checksum := 0 as i64
    mut k := 0
    until k < c.numel():
        checksum = (checksum + (c.at(k) as i64)) % 1000000007
        k = k + 1
    end
    println checksum
end
