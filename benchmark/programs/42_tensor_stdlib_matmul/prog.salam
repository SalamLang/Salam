import ai.tensor

func main:
    n := 400
    mut a := tensor.Zeros2(n, n)
    mut b := tensor.Zeros2(n, n)
    mut i := 0
    until i < n:
        mut j := 0
        until j < n:
            a.SetAt2(i, j, ((i * 3 + j * 7 + 1) % 97) as f64)
            b.SetAt2(i, j, ((i * 5 + j * 2 + 3) % 89) as f64)
            j++
        end
        i++
    end
    c := tensor.MatMul(a, b)
    mut checksum := 0 as i64
    mut k := 0
    until k < c.Numel():
        checksum = (checksum + (c.At(k) as i64)) % 1000000007
        k++
    end
    println checksum
end
