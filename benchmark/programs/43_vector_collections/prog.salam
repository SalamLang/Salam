import collections

func main:
    n := 5000000

    mut v := Vector {} as Vector<int>
    repeat n in i:
        v.push(i)
    end
    println "push:", v.Len()

    mut sum := 0
    repeat n in i:
        sum += v.get(i)
    end
    println "get:", sum

    mut s2 := 0
    each x in v:
        s2 += x
    end
    println "iter:", s2

    mut w := collections.clone(v)
    println "clone:", w.Len()

    mut e := Vector {} as Vector<int>
    collections.extend(e, v)
    println "extend:", e.Len()

    sl := collections.slice(v, 1000, 100000)
    println "slice:", sl.Len()

    mut m := Vector {} as Vector<int>
    repeat 200000 in i:
        m.insert(m.Len(), i)
    end
    println "insert_end:", m.Len()

    mut r := Vector {} as Vector<int>
    repeat 20000 in i:
        r.push(i)
    end
    repeat 5000 in _:
        r.remove_at(0)
    end
    println "remove_front:", r.Len()

    v.free()
    w.free()
    e.free()
    sl.free()
    m.free()
    r.free()
end
