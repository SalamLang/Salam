func main:
    n := 2000000

    mut m := HashMap {} as HashMap<int, int>
    repeat n in i:
        m.put(i, i * 3)
    end
    println "put:", m.size()

    mut sum := 0
    repeat n in i:
        sum += m.get(i)
    end
    println "get_hit:", sum

    mut miss := 0
    repeat n in i:
        miss += m.get(i + n)
    end
    println "get_miss:", miss

    mut hc := 0
    repeat n in i:
        if m.has(i): hc++ end
    end
    println "has:", hc

    mut upd := HashMap {} as HashMap<int, int>
    repeat n in i:
        upd.put(i, i)
    end
    repeat n in i:
        upd.put(i, i + 1)
    end
    println "update:", upd.size(), upd.get(10)

    mut rm := HashMap {} as HashMap<int, int>
    repeat n in i:
        rm.put(i, i)
    end
    repeat n in i:
        if i % 2 == 0: rm.remove(i) end
    end
    println "remove:", rm.size()

    mut itc := 0
    mut it := m.iter()
    until it.has_next():
        itc += it.value()
        it.next()
    end
    println "iter:", itc

    m.free()
    upd.free()
    rm.free()
end
