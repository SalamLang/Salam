func main:
    n := 2000000

    mut m := HashMap {} as HashMap<int, int>
    repeat n in i:
        m.Put(i, i * 3)
    end
    println "put:", m.Size()

    mut sum := 0
    repeat n in i:
        sum += m.Get(i)
    end
    println "get_hit:", sum

    mut miss := 0
    repeat n in i:
        miss += m.Get(i + n)
    end
    println "get_miss:", miss

    mut hc := 0
    repeat n in i:
        if m.Has(i): hc++ end
    end
    println "has:", hc

    mut upd := HashMap {} as HashMap<int, int>
    repeat n in i:
        upd.Put(i, i)
    end
    repeat n in i:
        upd.Put(i, i + 1)
    end
    println "update:", upd.Size(), upd.Get(10)

    mut rm := HashMap {} as HashMap<int, int>
    repeat n in i:
        rm.Put(i, i)
    end
    repeat n in i:
        if i % 2 == 0: rm.Remove(i) end
    end
    println "remove:", rm.Size()

    mut itc := 0
    mut it := m.Iter()
    until it.HasNext():
        itc += it.Value()
        it.Next()
    end
    println "iter:", itc

    m.Free()
    upd.Free()
    rm.Free()
end
