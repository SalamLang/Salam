import str

func main:
    n := 300000
    mut m := HashMap {} as HashMap<str, int>

    repeat n in i:
        k := "key_" + str.FromInt(i as i64)
        m.Put(k, i)
    end
    println "put:", m.Size()

    mut sum := 0
    repeat n in i:
        k := "key_" + str.FromInt(i as i64)
        sum += m.Get(k)
    end
    println "get:", sum

    mut miss := 0
    repeat n in i:
        k := "miss_" + str.FromInt(i as i64)
        miss += m.Get(k)
    end
    println "miss:", miss

    mut hc := 0
    repeat n in i:
        k := "key_" + str.FromInt(i as i64)
        if m.Has(k): hc++ end
    end
    println "has:", hc

    m.Free()
end
