import str

func main:
    n := 300000
    mut keys := Vector {} as Vector<str>
    mut miss := Vector {} as Vector<str>
    repeat n in i:
        keys.Push("key_" + str.FromInt(i as i64))
        miss.Push("miss_" + str.FromInt(i as i64))
    end

    mut m := HashMap {} as HashMap<str, int>
    repeat n in i:
        m.Put(keys.Get(i), i)
    end
    println "put:", m.Size()

    mut sum := 0
    repeat n in i:
        sum += m.Get(keys.Get(i))
    end
    println "get:", sum

    mut mc := 0
    repeat n in i:
        mc += m.Get(miss.Get(i))
    end
    println "miss:", mc

    mut hc := 0
    repeat n in i:
        if m.Has(keys.Get(i)): hc++ end
    end
    println "has:", hc

    m.Free()
    keys.Free()
    miss.Free()
end
