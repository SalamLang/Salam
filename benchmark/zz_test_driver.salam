import "bench/bench.salam"

func main:
    mut cfg := bench.Config {}
    cfg.root = "/work"
    cfg.runs = 2

    mut s := bench.NewStore()
    mut names := Vector {} as Vector<str> names.push("prog_a")
    names.push("prog_b")
    names.push("prog_c")

    mut langs := Vector {} as Vector<str> langs.push("c")
    langs.push("rust")
    langs.push("salam_gcc")

    mut vi := 0
    mut base := 2.0
    until vi < langs.len():
        lg := langs.get(vi)[0]
        mut pi := 0
        until pi < names.len():
            nm := names.get(pi)[0]
            k := nm.concat("|").concat(lg)
            s.status.put(k, "ok")
            s.m min.put(k, base + (vi as f64) * 3.0 + (pi as f64) * 5.0)
            pi = pi + 1
        end
        vi = vi + 1
    end

    mut ekeys := Vector {} as Vector<str> mut evals := Vector {} as Vector<str>
    ekeys.push("cpu")
    evals.push("test-cpu")

    bench.WriteReport(cfg, s, names, ekeys, evals, 1000, 2000)
    println "driver done"
end
