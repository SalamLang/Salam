# Build context is the repo root; only c/ and std/ are needed.

# ---- Everything else at the repo root ----
android/
benchmark/
books/
design/
docs/
editor/
examples/
extensions/
node_modules/
*.html

# ---- Build artifacts (rebuilt inside the image) ----
c/build/
c/dist/
c/salam
c/salam.exe
salam
salam.exe
**/*.o
**/*.a
**/*.obj
**/*.hash
**/*.exe
**/*.tmp
**/*.log

# ---- Test scratch ----
tests/*/.work/
c/cmttest/

# ---- Dependencies & caches ----
**/node_modules/
**/__pycache__/
.mypy_cache/
*.pyc

# ---- Editor / IDE / agent state / VCS ----
.vscode/
.idea/
.claude/
.git/

# ---- Docker's own files (not needed inside the image) ----
c/docker/
