// Flat merge of the salam/xml port (see salam/PORTING.md "Layout - FLAT"):
// xml.c + xml_emit.c - one package `xml`, one file.
// XML writer used by --emit-tokens-xml / --emit-ast-xml / --emit-symbol-xml.
//
// C differences: the C writer borrows an external sb_t; here the Writer owns
// its str.StringBuilder (created in New, released in Free) and the result is
// read back with Str(). The frame stack (xml_frame_t array) is three parallel
// vectors; capacity doubling is handled by Vector itself.
package xml

import str

// ===== xml.c =====
// xml_writer_t + xml_frame_t: one frame per open element, index = depth.
pub struct Writer:
    pub out: str.StringBuilder = str.NewBuilder()
    pub names: Vector<str> = Vector {} // frame.name
    pub printed_gt: Vector<bool> = Vector {} // frame.printed_gt
    pub inlined: Vector<bool> = Vector {} // frame.inlined
end

// xml_indent
func indent(w &: Writer, depth: int):
    repeat depth:
        str.BufAppend(w.out, "  ")
    end
end

// ===== xml_emit.c =====
// xml_escaped: byte-wise scan; escape chars are all ASCII so raw bytes of a
// UTF-8 str pass through untouched.
func escaped(w &: Writer, s: str):
    bp := (s as void*) as i8*
    n := s.len()
    repeat n with i:
        c := bp[i] as int
        if c == 38: // '&'
            str.BufAppend(w.out, "&amp;")
        else c == 60: // '<'
            str.BufAppend(w.out, "&lt;")
        else c == 62: // '>'
            str.BufAppend(w.out, "&gt;")
        else c == 34: // '"'
            str.BufAppend(w.out, "&quot;")
        else c == 39: // '\''
            str.BufAppend(w.out, "&apos;")
        else:
            str.BufAppendChar(w.out, c)
        end
    end
end

// ===== xml.c =====
// xml_new
pub func New(): Writer:
    ret Writer {}
end

// xml_free (also releases the owned builder, unlike C where sb is external)
pub func Free(w &: Writer):
    w.names.free()
    w.printed_gt.free()
    w.inlined.free()
    str.BufFree(w.out)
end

// Current output as a string (replaces reading the external sb_t in C).
pub func Str(w &: Writer): str:
    ret str.BufStr(w.out)
end

// xml_decl
pub func Decl(w &: Writer):
    str.BufAppend(w.out, "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n")
end

// xml_open
pub func Open(w &: Writer, tag: str):
    d := w.names.len()
    if d > 0:
        parent_gt := w.printed_gt.get(d - 1)[0]
        if !parent_gt:
            str.BufAppend(w.out, ">\n")
            w.printed_gt.set(d - 1, true)
        end
    end
    indent(w, d)
    str.BufAppend(w.out, "<")
    str.BufAppend(w.out, tag)
    w.names.push(tag)
    w.printed_gt.push(false)
    w.inlined.push(false)
end

// xml_close
pub func Close(w &: Writer):
    d := w.names.len() - 1
    name := w.names.pop()
    gt := w.printed_gt.pop()
    inl := w.inlined.pop()
    if !gt:
        str.BufAppend(w.out, " />\n")
    else inl:
        str.BufAppend(w.out, "</")
        str.BufAppend(w.out, name)
        str.BufAppend(w.out, ">\n")
    else:
        indent(w, d)
        str.BufAppend(w.out, "</")
        str.BufAppend(w.out, name)
        str.BufAppend(w.out, ">\n")
    end
end

// ===== xml_emit.c =====
// xml_attr
pub func Attr(w &: Writer, key: str, value: str):
    str.BufAppend(w.out, " ")
    str.BufAppend(w.out, key)
    str.BufAppend(w.out, `="`)
    escaped(w, value)
    str.BufAppend(w.out, `"`)
end

// xml_attr_int (C: sb_printf "=\"%lld\"" - the key is not escaped, the number
// needs no escaping)
pub func AttrInt(w &: Writer, key: str, value: i64):
    str.BufAppend(w.out, " ")
    str.BufAppend(w.out, key)
    str.BufAppend(w.out, `="`)
    str.BufAppendInt(w.out, value)
    str.BufAppend(w.out, `"`)
end

// xml_text
pub func Text(w &: Writer, text: str):
    d := w.names.len()
    if d <= 0: ret end
    gt := w.printed_gt.get(d - 1)[0]
    if !gt:
        str.BufAppend(w.out, ">")
        w.printed_gt.set(d - 1, true)
    end
    w.inlined.set(d - 1, true)
    escaped(w, text)
end

// xml_leaf
pub func Leaf(w &: Writer, tag: str, text: str):
    Open(w, tag)
    Text(w, text)
    Close(w)
end

// xml_leaf_int
pub func LeafInt(w &: Writer, tag: str, value: i64):
    Leaf(w, tag, str.FromInt(value))
end
