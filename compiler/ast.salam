// Flat merge of the salam/ast port (see salam/PORTING.md "Layout - FLAT"):
// ast.c + ast.h + ast_xml.c - one package `ast`, one file.
//
// C differences (per salam/PORTING.md):
// - ast_kind_t / ast_order_phase_t are `pub const` ints (+ `pub type AstKind`)
//   instead of enums: cross-package enum members don't resolve and the C
//   backend miscompiles non-main-package enums. Values match the C enums
//   exactly, so --emit-ast-xml output is byte-identical.
// - ast_node_t* pointers become integer indices (`pub type NodeId = int`)
//   into Ast.nodes (a Vector<Node>). NodeId 0 is the C NULL: NewAst() seeds
//   a sentinel node at index 0, so real nodes start at id 1.
// - Node mutation protocol: Vector<T> is a value struct (data/len/cap), so
//   ALL writes go get-copy -> mutate -> Put/set-back (the accessors below do
//   this). NEVER hold a Node copy across a mutating call on the same Ast and
//   Put it back later - its child-list headers may be stale by then; re-Get.
// - token_value_t union -> flattened value_kind/value_int/value_float/
//   value_str/value_bool fields (TV_CHAR codepoints live in value_int, as in
//   C). SetTokenValue/ValueOf convert from/to token.TokenValue.
// - src_span_t is inlined as begin_*/end_*/length u32 fields (same as the
//   Token port). end_index/length are kept but not emitted in XML (as in C).
// - `name`/`type_str`/`origin_lang` use "" where C used NULL (`name` is only
//   emitted in XML when non-empty; the C parser never produces empty names).
// - The C field `type` is renamed `ty` (`type` is a Salam keyword); `a`, `b`,
//   `c`, `d` and the vec_t fields keep their C names.
// - ast_new's arena parameter is gone: nodes are owned by the Ast; FreeAst()
//   releases everything. ast_clone clones into the same Ast (the only way
//   the C compiler uses it, modulo the arena).
package ast

import tok "token.salam"
import x "xml.salam"
import co "sal_core.salam"
import str

// ===== ast.c =====
// ast_kind_t - order and values MUST stay identical to the C enum.
pub const AST_PROGRAM := 0
pub const AST_IMPORT := 1
pub const AST_LINK := 2
pub const AST_TYPE_ALIAS := 3
pub const AST_CONST_DECL := 4
pub const AST_FUNC_DEF := 5
pub const AST_PARAM := 6
pub const AST_STRUCT_DEF := 7
pub const AST_FIELD := 8
pub const AST_INTERFACE_DEF := 9
pub const AST_IMPL_DEF := 10
pub const AST_ENUM_DEF := 11
pub const AST_ENUM_MEMBER := 12
pub const AST_BLOCK := 13
pub const AST_VAR_DECL := 14
pub const AST_ASSIGN := 15
pub const AST_IF := 16
pub const AST_UNTIL := 17
pub const AST_FOR := 18
pub const AST_REPEAT := 19
pub const AST_EACH := 20
pub const AST_RETURN := 21
pub const AST_BREAK := 22
pub const AST_CONTINUE := 23
pub const AST_DEFER := 24
pub const AST_EXPR_STMT := 25
pub const AST_BINARY := 26
pub const AST_UNARY := 27
pub const AST_INCDEC := 28
pub const AST_CAST := 29
pub const AST_LITERAL := 30
pub const AST_IDENTIFIER := 31
pub const AST_FUNC_ADDR := 32
pub const AST_THIS := 33
pub const AST_CALL := 34
pub const AST_MEMBER := 35
pub const AST_INDEX := 36
pub const AST_SLICE := 37
pub const AST_TERNARY := 38
pub const AST_LAMBDA := 39
pub const AST_ARRAY_LIT := 40
pub const AST_STRUCT_LIT := 41
pub const AST_FIELD_INIT := 42
pub const AST_TYPE := 43
pub const AST_LAYOUT_BLOCK := 44
pub const AST_LAYOUT_ELEMENT := 45
pub const AST_LAYOUT_ATTR := 46
pub const AST_LAYOUT_COMPONENT := 47
pub const AST_MATCH := 48
pub const AST_MATCH_ARM := 49
pub const AST_MATCH_PATTERN := 50
pub const AST_VARIANT_BOX := 51
pub const AST_VARIANT_UNWRAP := 52
pub const AST_COUNT := 53 // AST__COUNT - not a real kind

// ast_order_phase_t
pub const AST_ORDER_IMPORT := 0
pub const AST_ORDER_CONST := 1
pub const AST_ORDER_VAR := 2
pub const AST_ORDER_TYPEDEF := 3
pub const AST_ORDER_FUNC := 4
pub const AST_ORDER_NONE := 0 - 1

// k_ast_names[] from ast.c, indexed by AST_* (53 = AST_COUNT entries).
k_ast_names := [
    "Program", "Import", "Link", "TypeAlias", "ConstDecl", "FunctionDef", "Param", "StructDef", "Field",
    "InterfaceDef", "ImplDef", "EnumDef", "EnumMember", "Block", "VariableDecl", "Assignment", "IfStmt",
    "UntilStmt", "ForStmt", "RepeatStmt", "EachStmt", "ReturnStmt", "BreakStmt", "ContinueStmt", "DeferStmt",
    "ExprStmt", "BinaryExpr", "UnaryExpr", "IncDecExpr", "Cast", "Literal", "Identifier", "FuncAddr",
    "This", "Call", "MemberAccess", "ArrayAccess", "SliceExpr", "TernaryExpr", "Lambda", "ArrayLiteral",
    "StructLiteral", "FieldInit", "Type", "LayoutBlock", "LayoutElement", "LayoutAttribute", "LayoutComponent",
    "MatchExpr", "MatchArm", "MatchPattern", "VariantBox", "VariantUnwrap"
] as str[53]

// ast_kind_t / node handle (see file header for why not an enum / pointer).
pub type AstKind = int
pub type NodeId = int

// struct ast_node (ast.h). Fields keep the C names except `type` -> `ty`.
pub struct Node:
    pub kind: AstKind = 0
    // src_span_t span (inlined; end_index/length kept but not in XML)
    pub begin_line: u32 = 0 as u32
    pub begin_col: u32 = 0 as u32
    pub begin_index: u32 = 0 as u32
    pub end_line: u32 = 0 as u32
    pub end_col: u32 = 0 as u32
    pub end_index: u32 = 0 as u32
    pub length: u32 = 0 as u32
    pub name: str = ""
    // token_value_t value (union flattened; TV_CHAR codepoint in value_int)
    pub value_kind: int = 0 // tok.TV_NONE
    pub value_int: u64 = 0 as u64
    pub value_float: f64 = 0.0
    pub value_str: str = ""
    pub value_bool: bool = false
    pub op: int = 0 // token_kind_t (tok.TK_*)
    pub is_mut: bool = false
    pub is_pointer: bool = false
    pub synthetic: bool = false
    pub file_boundary: bool = false
    pub is_extern: bool = false
    pub is_variadic: bool = false
    pub is_dyn: bool = false
    pub is_ref: bool = false
    pub is_pub: bool = false
    pub is_inline: bool = false
    pub is_noinline: bool = false
    pub is_pure: bool = false
    pub is_noret: bool = false
    pub is_deprecated: bool = false
    pub is_slice: bool = false
    pub is_prefix: bool = false
    pub match_is_expr: bool = false
    pub ty: NodeId = 0 // ast_node_t *type
    pub a: NodeId = 0
    pub b: NodeId = 0
    pub c: NodeId = 0
    pub d: NodeId = 0
    pub list: Vector<int> = Vector {} // vec_t list (NodeIds)
    pub dims: Vector<int> = Vector {} // vec_t dims (NodeIds)
    pub typarams: Vector<str> = Vector {} // vec_t typarams (names)
    pub typaram_bounds: Vector<str> = Vector {} // vec_t typaram_bounds ("" = none)
    pub aliases: Vector<str> = Vector {} // vec_t aliases (names)
    pub captures: Vector<int> = Vector {} // vec_t captures (NodeIds)
    pub type_str: str = ""
    pub origin_lang: str = ""
end

// Node storage: all nodes of one tree, indexed by NodeId (0 = sentinel/none).
pub struct Ast:
    pub nodes: Vector<Node> = Vector {}
end

// ===== ast_xml.c (private helpers) =====

// ast_kind_has_op
func kind_has_op(k: int): bool:
    ret k == AST_BINARY || k == AST_UNARY || k == AST_INCDEC || k == AST_ASSIGN || k == AST_LITERAL
end

// ast_emit_value
func emit_value(w &: x.Writer, n: Node):
    if n.value_kind == tok.TV_NONE:
        ret
    end
    x.Open(w, "value")
    if n.value_kind == tok.TV_INT:
        x.Attr(w, "kind", "int")
        x.Text(w, co.U64Toa(n.value_int))
    else n.value_kind == tok.TV_FLOAT:
        x.Attr(w, "kind", "float")
        x.Text(w, co.Format1("%g", co.ArgFloat(n.value_float)))
    else n.value_kind == tok.TV_STRING:
        x.Attr(w, "kind", "string")
        x.Text(w, n.value_str)
    else n.value_kind == tok.TV_CHAR:
        x.Attr(w, "kind", "char")
        x.Text(w, co.U64Toa(n.value_int))
    else n.value_kind == tok.TV_BOOL:
        x.Attr(w, "kind", "bool")
        x.Text(w, n.value_bool ? "true" : "false")
    end
    x.Close(w)
end

// ast_loc
func emit_loc(w &: x.Writer, n: Node):
    x.Open(w, "location")
    x.LeafInt(w, "begin_line", n.begin_line as i64)
    x.LeafInt(w, "begin_column", n.begin_col as i64)
    x.LeafInt(w, "begin_index", n.begin_index as i64)
    x.LeafInt(w, "end_line", n.end_line as i64)
    x.LeafInt(w, "end_column", n.end_col as i64)
    x.Close(w)
end

// ast_child - omitted entirely when the node is none (C NULL).
func emit_child(w &: x.Writer, role: str, a: Ast, id: int):
    if id == 0:
        ret
    end
    x.Open(w, role)
    ToXml(w, a, id)
    x.Close(w)
end

// ast_child_list - the role element is emitted even when empty.
func emit_child_list(w &: x.Writer, role: str, a: Ast, ids: Vector<int>):
    x.Open(w, role)
    repeat ids.len() with i:
        ToXml(w, a, ids.get(i)[0])
    end
    x.Close(w)
end

// ===== ast.c (public) =====

// Creates an empty tree; index 0 is a sentinel standing in for C NULL.
pub func NewAst(): Ast:
    mut a := Ast {}
    a.nodes.push(Node { kind = 0 - 1 })
    ret a
end

// Frees every node's vectors and the node storage itself.
pub func FreeAst(a &: Ast):
    repeat a.nodes.len() with i:
        mut n := a.nodes.get(i)[0]
        n.list.free()
        n.dims.free()
        n.typarams.free()
        n.typaram_bounds.free()
        n.aliases.free()
        n.captures.free()
    end
    a.nodes.free()
end

// Number of node slots, including the id-0 sentinel.
pub func Count(a: Ast): int:
    ret a.nodes.len()
end

// ast_new (span starts zeroed - see SetSpan).
pub func NewNode(a &: Ast, kind: AstKind): NodeId:
    id := a.nodes.len()
    a.nodes.push(Node { kind = kind })
    ret id
end

// Full node read (returns a copy; see the mutation protocol in the header).
pub func Get(a: Ast, id: NodeId): Node:
    ret a.nodes.get(id)[0]
end

// Full node write-back.
pub func Put(a &: Ast, id: NodeId, n: Node):
    a.nodes.set(id, n)
end

pub func KindOf(a: Ast, id: NodeId): AstKind:
    n := a.nodes.get(id)[0]
    ret n.kind
end

pub func SetSpan(
    a &: Ast, id: NodeId, bl: u32, bc: u32, bi: u32, el: u32, ec: u32, ei: u32, length: u32
):
    mut n := a.nodes.get(id)[0]
    n.begin_line = bl
    n.begin_col = bc
    n.begin_index = bi
    n.end_line = el
    n.end_col = ec
    n.end_index = ei
    n.length = length
    a.nodes.set(id, n)
end

pub func SetName(a &: Ast, id: NodeId, name: str):
    mut n := a.nodes.get(id)[0]
    n.name = name
    a.nodes.set(id, n)
end

pub func SetOp(a &: Ast, id: NodeId, op: int):
    mut n := a.nodes.get(id)[0]
    n.op = op
    a.nodes.set(id, n)
end

pub func SetTypeNode(a &: Ast, id: NodeId, t: NodeId):
    mut n := a.nodes.get(id)[0]
    n.ty = t
    a.nodes.set(id, n)
end

pub func SetTypeStr(a &: Ast, id: NodeId, s: str):
    mut n := a.nodes.get(id)[0]
    n.type_str = s
    a.nodes.set(id, n)
end

// Copies a token.TokenValue payload into the node (parser convenience).
pub func SetTokenValue(a &: Ast, id: NodeId, v: tok.TokenValue):
    mut n := a.nodes.get(id)[0]
    n.value_kind = v.kind
    n.value_int = v.ival
    n.value_float = v.fval
    n.value_str = v.sval
    n.value_bool = v.bval
    a.nodes.set(id, n)
end

// Reads the node's value back as a token.TokenValue.
pub func ValueOf(a: Ast, id: NodeId): tok.TokenValue:
    n := a.nodes.get(id)[0]
    mut v := tok.ValueNone()
    v.kind = n.value_kind
    v.ival = n.value_int
    v.fval = n.value_float
    v.sval = n.value_str
    v.bval = n.value_bool
    ret v
end

// ast_add - appends to n->list, skipping none (C NULL) children.
pub func AddChild(a &: Ast, parent: NodeId, child: NodeId):
    if child == 0:
        ret
    end
    mut n := a.nodes.get(parent)[0]
    n.list.push(child)
    a.nodes.set(parent, n)
end

pub func Child(a: Ast, id: NodeId, i: int): NodeId:
    n := a.nodes.get(id)[0]
    ret n.list.get(i)[0]
end

pub func ChildCount(a: Ast, id: NodeId): int:
    n := a.nodes.get(id)[0]
    ret n.list.len()
end

pub func AddDim(a &: Ast, id: NodeId, dim: NodeId):
    mut n := a.nodes.get(id)[0]
    n.dims.push(dim)
    a.nodes.set(id, n)
end

pub func Dim(a: Ast, id: NodeId, i: int): NodeId:
    n := a.nodes.get(id)[0]
    ret n.dims.get(i)[0]
end

pub func DimCount(a: Ast, id: NodeId): int:
    n := a.nodes.get(id)[0]
    ret n.dims.len()
end

pub func AddCapture(a &: Ast, id: NodeId, cap: NodeId):
    mut n := a.nodes.get(id)[0]
    n.captures.push(cap)
    a.nodes.set(id, n)
end

pub func Capture(a: Ast, id: NodeId, i: int): NodeId:
    n := a.nodes.get(id)[0]
    ret n.captures.get(i)[0]
end

pub func CaptureCount(a: Ast, id: NodeId): int:
    n := a.nodes.get(id)[0]
    ret n.captures.len()
end

// Type parameter + its bound ("" = unbounded), kept in lockstep.
pub func AddTyparam(a &: Ast, id: NodeId, name: str, bound: str):
    mut n := a.nodes.get(id)[0]
    n.typarams.push(name)
    n.typaram_bounds.push(bound)
    a.nodes.set(id, n)
end

pub func Typaram(a: Ast, id: NodeId, i: int): str:
    n := a.nodes.get(id)[0]
    ret n.typarams.get(i)[0]
end

pub func TyparamBound(a: Ast, id: NodeId, i: int): str:
    n := a.nodes.get(id)[0]
    ret n.typaram_bounds.get(i)[0]
end

pub func TyparamCount(a: Ast, id: NodeId): int:
    n := a.nodes.get(id)[0]
    ret n.typarams.len()
end

pub func AddAlias(a &: Ast, id: NodeId, alias: str):
    mut n := a.nodes.get(id)[0]
    n.aliases.push(alias)
    a.nodes.set(id, n)
end

pub func Alias(a: Ast, id: NodeId, i: int): str:
    n := a.nodes.get(id)[0]
    ret n.aliases.get(i)[0]
end

pub func AliasCount(a: Ast, id: NodeId): int:
    n := a.nodes.get(id)[0]
    ret n.aliases.len()
end

// ast_kind_name
pub func KindName(kind: AstKind): str:
    if kind < 0 || kind >= AST_COUNT:
        ret "Unknown"
    end
    ret k_ast_names[kind]
end

// ast_toplevel_order_phase
pub func ToplevelOrderPhase(a: Ast, id: NodeId): int:
    n := a.nodes.get(id)[0]
    if n.is_extern && n.kind == AST_VAR_DECL:
        ret AST_ORDER_IMPORT
    end
    if n.is_extern && n.kind == AST_FUNC_DEF && n.a == 0:
        ret AST_ORDER_IMPORT
    end
    if n.kind == AST_IMPORT || n.kind == AST_LINK:
        ret AST_ORDER_IMPORT
    end
    if n.kind == AST_CONST_DECL:
        ret AST_ORDER_CONST
    end
    if n.kind == AST_VAR_DECL:
        ret AST_ORDER_VAR
    end
    if n.kind == AST_TYPE_ALIAS || n.kind == AST_STRUCT_DEF || n.kind == AST_ENUM_DEF || n.kind == AST_INTERFACE_DEF || n.kind == AST_IMPL_DEF:
        ret AST_ORDER_TYPEDEF
    end
    if n.kind == AST_FUNC_DEF:
        ret AST_ORDER_FUNC
    end
    ret AST_ORDER_NONE
end

// ast_str_lit_len - -1 unless the node is a string literal (Salam strings are
// never NULL, so the C NULL-payload -1 case cannot occur; "" gives 0).
pub func StrLitLen(a: Ast, id: NodeId): i64:
    if id == 0:
        ret (0 - 1) as i64
    end
    n := a.nodes.get(id)[0]
    if n.kind != AST_LITERAL:
        ret (0 - 1) as i64
    end
    if n.op != tok.TK_STRING && n.op != tok.TK_TRIPLE_STRING && n.op != tok.TK_RAW_STRING:
        ret (0 - 1) as i64
    end
    if n.value_kind != tok.TV_STRING:
        ret (0 - 1) as i64
    end
    ret str.Len(n.value_str) as i64
end

// ast_clone - deep copy into the same Ast; returns the new root's id.
pub func Clone(a &: Ast, id: NodeId): NodeId:
    if id == 0:
        ret 0
    end
    src := a.nodes.get(id)[0]
    mut c := src
    c.ty = Clone(a, src.ty)
    c.a = Clone(a, src.a)
    c.b = Clone(a, src.b)
    c.c = Clone(a, src.c)
    c.d = Clone(a, src.d)
    c.list = Vector {} as Vector<int>
    repeat src.list.len() with i0:
        c.list.push(Clone(a, src.list.get(i0)[0]))
    end
    c.dims = Vector {} as Vector<int>
    repeat src.dims.len() with i1:
        c.dims.push(Clone(a, src.dims.get(i1)[0]))
    end
    c.captures = Vector {} as Vector<int>
    repeat src.captures.len() with i2:
        c.captures.push(Clone(a, src.captures.get(i2)[0]))
    end
    c.typarams = Vector {} as Vector<str>
    repeat src.typarams.len() with i3:
        c.typarams.push(src.typarams.get(i3)[0])
    end
    c.typaram_bounds = Vector {} as Vector<str>
    repeat src.typaram_bounds.len() with i4:
        c.typaram_bounds.push(src.typaram_bounds.get(i4)[0])
    end
    c.aliases = Vector {} as Vector<str>
    repeat src.aliases.len() with i5:
        c.aliases.push(src.aliases.get(i5)[0])
    end
    nid := a.nodes.len()
    a.nodes.push(c)
    ret nid
end

// ===== ast_xml.c =====
// The --emit-ast-xml dump. The kind dispatch is an if/else chain, not
// `match`: C-switch order kept. AST_SLICE / AST_LAMBDA / AST_BREAK /
// AST_CONTINUE / AST_IMPORT / AST_LINK / AST_LITERAL / AST_IDENTIFIER /
// AST_FUNC_ADDR / AST_THIS hit the C default: no child elements.

// ast_to_xml - id 0 (C NULL) emits nothing. The driver wraps this with
// xml.Decl() + file output; byte-compatible with the C emitter.
pub func ToXml(w &: x.Writer, a: Ast, id: NodeId):
    if id == 0:
        ret
    end
    n := Get(a, id)
    x.Open(w, "node")
    x.Attr(w, "kind", KindName(n.kind))
    if str.Len(n.name) != 0:
        x.Attr(w, "name", n.name)
    end
    if str.Len(n.type_str) != 0:
        x.Attr(w, "type", n.type_str)
    end
    if kind_has_op(n.kind):
        x.Attr(w, "op", tok.KindName(n.op))
    end
    if n.kind == AST_INCDEC:
        x.Attr(w, "fixity", n.is_prefix ? "prefix" : "postfix")
    end
    if n.kind == AST_VAR_DECL:
        x.Attr(w, "mut", n.is_mut ? "true" : "false")
    end
    if n.kind == AST_TYPE && n.is_pointer:
        x.Attr(w, "pointer", "true")
    end
    if n.is_extern:
        x.Attr(w, "extern", "true")
    end
    if n.is_variadic:
        x.Attr(w, "variadic", "true")
    end
    if n.is_pub:
        x.Attr(w, "pub", "true")
    end
    emit_loc(w, n)
    emit_value(w, n) // no-op when value_kind == TV_NONE
    k := n.kind
    if k == AST_PROGRAM:
        emit_child_list(w, "defs", a, n.list)
    else k == AST_TYPE_ALIAS:
        emit_child(w, "type", a, n.ty)
    else k == AST_CONST_DECL:
        emit_child(w, "type", a, n.ty)
        emit_child(w, "value", a, n.a)
    else k == AST_FUNC_DEF:
        emit_child(w, "return_type", a, n.ty)
        emit_child_list(w, "params", a, n.list)
        emit_child(w, "body", a, n.a)
    else k == AST_PARAM:
        emit_child(w, "type", a, n.ty)
        emit_child(w, "default", a, n.a)
    else k == AST_STRUCT_DEF:
        emit_child_list(w, "members", a, n.list)
    else k == AST_INTERFACE_DEF:
        emit_child_list(w, "methods", a, n.list)
    else k == AST_FIELD:
        emit_child(w, "type", a, n.ty)
        emit_child(w, "default", a, n.a)
    else k == AST_ENUM_DEF:
        emit_child_list(w, "members", a, n.list)
    else k == AST_ENUM_MEMBER:
        emit_child(w, "value", a, n.a)
    else k == AST_BLOCK:
        emit_child_list(w, "statements", a, n.list)
    else k == AST_VAR_DECL:
        emit_child(w, "type", a, n.ty)
        emit_child(w, "init", a, n.a)
    else k == AST_ASSIGN:
        emit_child(w, "target", a, n.a)
        emit_child(w, "value", a, n.b)
    else k == AST_IF:
        emit_child(w, "condition", a, n.a)
        emit_child(w, "then", a, n.b)
        emit_child(w, "else", a, n.c)
    else k == AST_UNTIL:
        emit_child(w, "condition", a, n.a)
        emit_child(w, "body", a, n.b)
    else k == AST_REPEAT:
        if n.c != 0:
            emit_child(w, "from", a, n.a)
        else:
            emit_child(w, "count", a, n.a)
        end
        emit_child(w, "to", a, n.c)
        emit_child(w, "step", a, n.d)
        emit_child(w, "body", a, n.b)
    else k == AST_FOR:
        emit_child(w, "init", a, n.a)
        emit_child(w, "condition", a, n.b)
        emit_child(w, "post", a, n.c)
        emit_child(w, "body", a, n.d)
    else k == AST_EACH:
        emit_child(w, "key", a, n.c)
        emit_child(w, "iterable", a, n.a)
        emit_child(w, "body", a, n.b)
    else k == AST_RETURN:
        emit_child(w, "value", a, n.a)
    else k == AST_DEFER:
        emit_child(w, "statement", a, n.a)
    else k == AST_EXPR_STMT:
        emit_child(w, "expr", a, n.a)
    else k == AST_BINARY:
        emit_child(w, "left", a, n.a)
        emit_child(w, "right", a, n.b)
    else k == AST_UNARY:
        emit_child(w, "operand", a, n.a)
    else k == AST_INCDEC:
        emit_child(w, "operand", a, n.a)
    else k == AST_CAST:
        emit_child(w, "operand", a, n.a)
        emit_child(w, "type", a, n.ty)
    else k == AST_CALL:
        emit_child(w, "callee", a, n.a)
        emit_child_list(w, "args", a, n.list)
    else k == AST_MEMBER:
        emit_child(w, "object", a, n.a)
    else k == AST_INDEX:
        emit_child(w, "object", a, n.a)
        emit_child(w, "index", a, n.b)
    else k == AST_TERNARY:
        emit_child(w, "condition", a, n.a)
        emit_child(w, "then", a, n.b)
        emit_child(w, "else", a, n.c)
    else k == AST_ARRAY_LIT:
        emit_child_list(w, "elements", a, n.list)
    else k == AST_STRUCT_LIT:
        emit_child_list(w, "fields", a, n.list)
    else k == AST_FIELD_INIT:
        emit_child(w, "value", a, n.a)
    else k == AST_TYPE:
        if n.dims.len() != 0:
            emit_child_list(w, "dims", a, n.dims)
        end
    else k == AST_LAYOUT_BLOCK:
        emit_child_list(w, "items", a, n.list)
    else k == AST_LAYOUT_ELEMENT:
        emit_child_list(w, "children", a, n.list)
    else k == AST_LAYOUT_ATTR:
        emit_child(w, "value", a, n.a)
    else k == AST_LAYOUT_COMPONENT:
        emit_child_list(w, "params", a, n.list)
        emit_child(w, "body", a, n.a)
    else k == AST_MATCH:
        emit_child(w, "subject", a, n.a)
        emit_child_list(w, "arms", a, n.list)
    else k == AST_MATCH_ARM:
        emit_child_list(w, "patterns", a, n.list)
        emit_child(w, "body", a, n.b)
    else k == AST_MATCH_PATTERN:
        emit_child(w, "head", a, n.a)
    else k == AST_VARIANT_BOX || k == AST_VARIANT_UNWRAP:
        emit_child(w, "operand", a, n.a)
    end
    x.Close(w)
end
