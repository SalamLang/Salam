// Flat single-file module (see salam/PORTING.md "Layout - FLAT").
// Port of compiler/src/cli/{cli.c,cli_help.c,cli_options.c,cli_subcmd.c} PLUS
// the command-dispatch switch of compiler/src/driver/driver.c's driver_main
// (stage 8c, the FINAL wave of the self-hosting port). Package `cli`, alias
// `cl`.
//
// Scope:
// - cli_subcmd.c's cli_dispatch_command -> dispatch_command: argv[1] (a
//   Vector<str> here, args[0] = program name exactly like C's argv[0]) ->
//   Dr.command + the "start" index cli_parse_options resumes from.
// - cli_options.c's cli_parse_options/cli_positional/cli_opt_value ->
//   parse_options/positional/opt_value: every flag in the C, one-for-one.
// - cli.c's cli_parse (defaults + the post-parse "push SALAM_SAFE" step) ->
//   pub ParseArgs.
// - cli_help.c's cli_print_usage -> pub UsageText() (returns the exact text
//   instead of writing to a FILE*, so callers/tests can inspect it without
//   capturing stdout; Run() prints it where the C would).
// - driver_main's version print (core/build_info.h) -> pub VersionText().
// - driver_main's `switch (opt.command)` -> pub Run(args): the actual
//   top-level entry point main.salam calls. Dispatches to dr.Build/Obj/Run/
//   Exec/Inspect/Llvm/Js/LayoutBuild/Web (salam/driver.salam) exactly like
//   the C switch does, including the same "requires at least one input
//   file" guards driver_main performs before calling into build.c for
//   CMD_BUILD/CMD_OBJ/CMD_LLVM/CMD_JS/CMD_LAYOUT_BUILD/CMD_WEB.
//
// Also ports two driver_main-adjacent bodies that PORTING.md's stage-8a note
// explicitly leaves for "the cli wave" (driver.c's driver_new/driver_fmt):
// - CMD_NEW -> new_project() (driver_new: project scaffolding).
// - CMD_FMT -> fmt_cmd()/fmt_walk()/fmt_one_file() (driver_fmt: the file/dir
//   walk + --check reporting around sal_fmt.salam's already-ported Source()
//   formatter).
// - CMD_DEBUG / CMD_MEMCHECK -> debug_cmd()/memcheck_cmd() (driver/
//   debug_cmd.c: build via dr.Build then launch gdb/lldb or run under
//   valgrind/ASAN). Not part of any prior stage's brief; ported here directly
//   in cli.salam (not driver.salam, per the "never edit driver.salam" rule)
//   since both are thin wrappers over dr.Build + os.Run with no dependency
//   on anything driver.salam doesn't already expose as pub.
//
// Deviations from the C (all deliberate, non-functional):
// - Fixed SALAM_MAX_INPUTS array caps are dropped everywhere, matching
//   driver.salam's own established convention (Vector<str> has no cap).
// - core/build_info.h's SALAM_GIT_COMMIT/SALAM_GIT_DATE/SALAM_BUILD_DATE are
//   populated by the C build's Makefile (git describe / __DATE__ __TIME__);
//   there is no equivalent injection mechanism in a plain `salam build`, so
//   VersionText() hardcodes the build_info.h *fallback* defaults ("unknown"
//   / "" / "0.2.6") instead. SALAM_VERSION ("0.2.6") matches this repo's
//   current release line (branch max-updates-0.2.6).
// - CMD_REPL / CMD_REPL_LAYOUT (driver/repl.c) are a PORT-TODO stub here:
//   repl.c is raw-terminal interactive I/O (termios/Win32 console, line
//   history, incremental re-lex/parse/sema/codegen of a growing session) - //   explicitly called out as a different wave's brief (concurrent with this
//   one). The stub reports the same "not ported yet" shape the driver.salam
//   Llvm/Js/LayoutBuild/Web stubs already established, so `salam cli`/
//   `salam layout` (bare, no subcommand) fail cleanly instead of silently
//   doing nothing. Swap to `dr.Repl(&opt)` once that wave lands.
// - shell_arg()/path_stem() re-implement core/sb.c's sb_put_shell_arg and
//   debug_cmd.c's path_stem as private helpers local to this file (the
//   driver.salam originals of the same idioms are private to that package
//   and, per the stage brief, driver.salam is read-only from here).
// - fmt_cmd()'s `--fix-order` is accepted (parsed, stored on Dr) but not
//   actually applied: fmt_order.c / `fmt_reorder_toplevel` is not ported by
//   any wave yet (sal_fmt.salam's own header comment already documents this
//   gap - "needs parser + semantic", which are now done, but the reordering
//   pass itself has no Salam port to call). Passing --fix-order here simply
//   formats normally without reordering, matching a no-op degrade rather
//   than an error.
package cli

import os
import io
import str
import dr "driver.salam"
import lg "logger.salam"
import dg "diag.salam"
import i18 "i18n.salam"
import lp "langpack.salam"
import lx "lexer.salam"
import src "source.salam"
import co "sal_core.salam"
import sf "sal_fmt.salam"
import sm "semantic.salam"

// ===== core/build_info.h fallback values (see header note above) =====
const SALAM_VERSION := "0.2.6"
const SALAM_GIT_COMMIT := "unknown"
const SALAM_GIT_DIRTY := ""
const SALAM_GIT_DATE := "unknown"
const SALAM_BUILD_DATE := "unknown"

// ===== driver.c's fmt_ctx_t (driver_fmt's accumulator, threaded through
// fmt_walk/fmt_one_file). All fields pub - E017: non-pub struct fields are
// unusable even from free functions in the SAME package. =====
struct FmtCtx:
    pub check: bool = false
    pub fix_order: bool = false
    pub tabs: bool = false
    pub width: int = 4
    pub pack: int = 0
    pub changed: int = 0
    pub ok: int = 0
    pub errors: int = 0
    pub total: int = 0
end

// ---------------------------------------------------------------------------
// Small private helpers
// ---------------------------------------------------------------------------

// Unsigned byte read from a str (same idiom used throughout the port, e.g.
// driver.salam's byte_at / str/str.salam's _bp+_ub - re-derived locally
// since those are private to their own packages).
func byte_at(s: str, i: int): int:
    bp := (s as void*) as i8*
    mut v := bp[i] as int
    if v < 0:
        v = v + 256
    end
    ret v
end

// cli_opt_value: arg == "key=VALUE" ? val=VALUE, true : false.
func opt_value(arg: str, key: str, val &: str): bool:
    prefix := key + "="
    if str.StartsWith(arg, prefix):
        val = str.Substr(arg, str.Len(prefix), str.Len(arg) - str.Len(prefix))
        ret true
    end
    ret false
end

// strtol(val, &endp, 10) with the same "every char must be a digit, no
// trailing junk, range 1-16" validation cli_options.c's --indent handler
// does (endp==val || *endp || n<1 || n>16 -> reject).
func parse_indent_width(val: str, out &: int): bool:
    n := str.Len(val)
    if n == 0:
        ret false
    end
    mut num := 0
    mut i := 0
    until i < n:
        code := byte_at(val, i)
        if !str.IsDigit(code):
            ret false
        end
        num = num * 10 + (code - 48)
        i += 1
    end
    if num < 1 || num > 16:
        ret false
    end
    out = num
    ret true
end

// --timeout=<ms> for `salam run`/`exec`/`jit`: the tree-walking interpreter's
// wall-clock deadline (interp.salam defaults to 5000ms when unset). Same
// digit-only validation as parse_indent_width, but no small upper cap since
// long-running interpreted programs are a legitimate use case; still bounded
// so a garbage/huge value can't overflow the int field.
func parse_timeout_ms(val: str, out &: int): bool:
    n := str.Len(val)
    if n == 0 || n > 9:
        ret false
    end
    mut num := 0
    mut i := 0
    until i < n:
        code := byte_at(val, i)
        if !str.IsDigit(code):
            ret false
        end
        num = num * 10 + (code - 48)
        i += 1
    end
    if num < 1:
        ret false
    end
    out = num
    ret true
end

// core/sb.c's sb_put_shell_arg: quote a single argv-style token so it
// survives a shell command line built with string concatenation (used by
// debug_cmd/memcheck_cmd, which invoke gdb/lldb/valgrind via os.Run).
func shell_arg(s: str): str:
    if SALAM_OS_WINDOWS:
        mut out := "\""
        out = out + str.Replace(s, "\"", "\\\"")
        out = out + "\""
        ret out
    else:
        mut sb := str.NewBuilder()
        str.BufAppendChar(sb, 39) // '
        n := str.Len(s)
        mut i := 0
        until i < n:
            code := byte_at(s, i)
            if code == 39:
                str.BufAppend(sb, "'\\''")
            else:
                str.BufAppendChar(sb, code)
            end
            i += 1
        end
        str.BufAppendChar(sb, 39)
        out := str.BufStr(sb)
        str.BufFree(sb)
        ret out
    end
end

// debug_cmd.c's path_stem: basename with the extension stripped.
func path_stem(path: str): str:
    mut base := path
    slash := str.LastIndex(path, "/")
    bslash := str.LastIndex(path, "\\")
    mut cut := slash
    if bslash > cut:
        cut = bslash
    end
    if cut >= 0:
        base = str.Substr(path, cut + 1, str.Len(path) - cut - 1)
    end
    dot := str.LastIndex(base, ".")
    if dot >= 0:
        base = str.Substr(base, 0, dot)
    end
    ret base
end

// ---------------------------------------------------------------------------
// cli_options.c's cli_positional
// ---------------------------------------------------------------------------
func positional(arg: str, out &: dr.Dr): bool:
    if out.command == dr.CMD_NEW:
        if str.Len(out.new_name) > 0:
            io.EPrintln(
                co.Format2(
                    i18.Tr("salam: 'new' takes a single project name ('%s' after '%s')"), co.ArgStr(arg),
                    co.ArgStr(out.new_name)
                )
            )
            ret false
        end
        out.new_name = arg
    else out.command == dr.CMD_RUN:
        if str.Len(out.input) == 0:
            out.inputs.push(arg)
            out.input = arg
        else:
            out.run_args.push(arg)
        end
    else out.command == dr.CMD_BUILD || out.command == dr.CMD_OBJ || out.command == dr.CMD_LLVM || out.command == dr.CMD_JS || out.command == dr.CMD_LAYOUT_BUILD || out.command == dr.CMD_WEB || out.command == dr.CMD_DEBUG || out.command == dr.CMD_MEMCHECK || out.command == dr.CMD_FMT:
        out.inputs.push(arg)
        if str.Len(out.input) == 0:
            out.input = arg
        end
    else:
        if str.Len(out.input) > 0:
            io.EPrintln(
                co.Format2(
                    i18.Tr(
                        "salam: multiple input files require the 'build' command ('%s' after '%s')"
                    ), co.ArgStr(arg), co.ArgStr(out.input)
                )
            )
            ret false
        end
        out.input = arg
    end
    ret true
end

// ---------------------------------------------------------------------------
// cli_subcmd.c's cli_dispatch_command. `args` mirrors C's argv exactly:
// args[0] is the program name (see main.salam / os.Args()'s salam_set_args
// contract), args[1] is the first real word.
// ---------------------------------------------------------------------------
func dispatch_command(args: Vector<str>, out &: dr.Dr): int:
    mut start := 1
    n := args.len()
    mut cmd := ""
    if n > 1:
        cmd = args.get(1)[0]
    end
    if str.Len(cmd) == 0:
        out.command = dr.CMD_HELP
    else str.Equals(cmd, "build"):
        out.command = dr.CMD_BUILD
        start = 2
    else str.Equals(cmd, "obj"):
        out.command = dr.CMD_OBJ
        start = 2
    else str.Equals(cmd, "llvm") || str.Equals(cmd, "emit-llvm"):
        out.command = dr.CMD_LLVM
        start = 2
    else str.Equals(cmd, "js") || str.Equals(cmd, "emit-js"):
        out.command = dr.CMD_JS
        start = 2
    else str.Equals(cmd, "run"):
        out.command = dr.CMD_RUN
        start = 2
    else str.Equals(cmd, "exec") || str.Equals(cmd, "jit"):
        out.command = dr.CMD_RUN
        out.interp = true
        start = 2
    else str.Equals(cmd, "debug"):
        out.command = dr.CMD_DEBUG
        out.debug_info = true
        start = 2
    else str.Equals(cmd, "memcheck"):
        out.command = dr.CMD_MEMCHECK
        out.debug_info = true
        out.asan = true
        start = 2
    else str.Equals(cmd, "new"):
        out.command = dr.CMD_NEW
        start = 2
    else str.Equals(cmd, "format"):
        out.command = dr.CMD_FMT
        start = 2
    else str.Equals(cmd, "help"):
        out.command = dr.CMD_HELP
        start = 2
    else str.Equals(cmd, "version"):
        out.command = dr.CMD_VERSION
        start = 2
    else str.Equals(cmd, "web"):
        out.command = dr.CMD_WEB
        start = 2
    else str.Equals(cmd, "layout"):
        if n > 2 && str.Equals(args.get(2)[0], "build"):
            out.command = dr.CMD_LAYOUT_BUILD
            start = 3
        else:
            out.command = dr.CMD_REPL_LAYOUT
            start = 2
        end
    else str.Equals(cmd, "cli"):
        if n > 2 && str.Equals(args.get(2)[0], "build"):
            out.command = dr.CMD_BUILD
            start = 3
        else n > 2 && str.Equals(args.get(2)[0], "obj"):
            out.command = dr.CMD_OBJ
            start = 3
        else:
            out.command = dr.CMD_REPL
            start = 2
        end
    end
    // Unmatched `cmd` (e.g. a bare "file.salam"): leave out.command at the
    // CMD_INSPECT default ParseArgs already set via dr.NewOptions(), start
    // stays 1 so parse_options treats `cmd` itself as the first positional
    // ("salam <input.salam> [inspect options]").
    ret start
end

// ---------------------------------------------------------------------------
// cli_options.c's cli_parse_options
// ---------------------------------------------------------------------------
func parse_options(args: Vector<str>, start: int, out &: dr.Dr): bool:
    n := args.len()
    mut i := start
    until i < n:
        arg := args.get(i)[0]
        mut val := ""
        if str.Equals(arg, "--keep-c"):
            out.keep_c = true
        else str.Equals(arg, "--short") && out.command == dr.CMD_VERSION:
            out.version_short = true
        else str.Equals(arg, "-O0"):
            out.llvm_opt_level = 0
        else str.Equals(arg, "-O1"):
            out.llvm_opt_level = 1
        else str.Equals(arg, "-O2"):
            out.llvm_opt_level = 2
        else str.Equals(arg, "-O3"):
            out.llvm_opt_level = 3
        else str.Equals(arg, "-Os"):
            out.llvm_opt_level = 4
        else str.Equals(arg, "-Oz"):
            out.llvm_opt_level = 5
        else str.Equals(arg, "--emit-llvm"):
            out.llvm_emit = 0
        else str.Equals(arg, "--emit-asm"):
            out.llvm_emit = 1
        else str.Equals(arg, "--emit-obj") || str.Equals(arg, "-c"):
            out.llvm_emit = 2
        else str.Equals(arg, "--emit-bitcode") || str.Equals(arg, "-flto"):
            out.llvm_emit = 3
        else str.Equals(arg, "--exec") || str.Equals(arg, "--emit-exec"):
            out.llvm_emit = 4
        else str.Equals(arg, "--jit") && out.command == dr.CMD_LLVM:
            out.llvm_emit = 5
        else str.Equals(arg, "--verify-ir"):
            out.llvm_verify = true
        else str.Equals(arg, "--native-cpu") || str.Equals(arg, "-march=native"):
            out.llvm_native_cpu = true
        else opt_value(arg, "--target", val):
            out.llvm_target = val
        else str.Equals(arg, "--release"):
            out.safe = false
        else str.Equals(arg, "--check"):
            out.fmt_check = true
        else str.Equals(arg, "--fix-order"):
            out.fmt_fix_order = true
        else str.Equals(arg, "-r") || str.Equals(arg, "--recursive"):
            out.fmt_recursive = true
        else str.Equals(arg, "--tabs"):
            out.fmt_tabs = true
        else str.Equals(arg, "--spaces"):
            out.fmt_tabs = false
        else opt_value(arg, "--indent", val):
            if str.Equals(val, "tab") || str.Equals(val, "tabs"):
                out.fmt_tabs = true
            else:
                mut width := 0
                if !parse_indent_width(val, width):
                    io.EPrintln(
                        co.Format1(
                            i18.Tr(
                                "salam: invalid --indent value '%s' (use 'tab' or a width 1-16)"
                            ), co.ArgStr(val)
                        )
                    )
                    ret false
                end
                out.fmt_tabs = false
                out.fmt_indent_width = width
            end
        else str.Equals(arg, "-g") || str.Equals(arg, "--debug-info"):
            out.debug_info = true
        else str.Equals(arg, "--asan"):
            out.asan = true
        else str.Equals(arg, "--interp") || str.Equals(arg, "--jit"):
            out.interp = true
        else str.Equals(arg, "--inline"):
            out.inline_mode = true
        else str.Equals(arg, "--split"):
            out.split = true
        else str.Equals(arg, "--no-js-minify-names"):
            out.no_js_minify_names = true
        else str.Equals(arg, "--no-minify"):
            out.no_minify = true
        else opt_value(arg, "--output", val):
            out.output = val
        else str.Equals(arg, "-o"):
            if i + 1 >= n:
                io.EPrintln(i18.Tr("salam: -o requires a file argument"))
                ret false
            end
            i += 1
            out.output = args.get(i)[0]
        else opt_value(arg, "--cc", val):
            out.cc = val
        else opt_value(arg, "--stdlib-path", val):
            out.stdlib_path = val
        else opt_value(arg, "--define", val):
            out.defines.push(val)
        else str.StartsWith(arg, "-D") && str.Len(arg) > 2:
            out.defines.push(str.Substr(arg, 2, str.Len(arg) - 2))
        else opt_value(arg, "--export", val):
            out.exports.push(val)
        else str.Equals(arg, "--emit-tokens-xml"):
            out.emit_tokens_xml = true
        else str.Equals(arg, "--emit-ast-xml"):
            out.emit_ast_xml = true
        else str.Equals(arg, "--emit-symbol-xml") || str.Equals(arg, "--emit-symbols-xml"):
            out.emit_symbol_xml = true
        else str.Equals(arg, "--color"):
            out.color = 1
        else str.Equals(arg, "--no-color"):
            out.color = 0
        else opt_value(arg, "--error-style", val):
            mut st := 0
            if !dg.StyleFromString(val, st):
                io.EPrintln(
                    co.Format1(
                        i18.Tr("salam: invalid error style '%s' (rust|gcc|clang)"), co.ArgStr(val)
                    )
                )
                ret false
            end
            out.diag_style = st
        else opt_value(arg, "--error-format", val):
            mut efmt := 0
            if !dg.FormatFromString(val, efmt):
                io.EPrintln(
                    co.Format1(
                        i18.Tr("salam: invalid error format '%s' (human|json|xml)"), co.ArgStr(val)
                    )
                )
                ret false
            end
            out.diag_format = efmt
        else opt_value(arg, "--log-level", val):
            mut lvl := 0
            if !lg.LevelFromString(val, lvl):
                io.EPrintln(co.Format1(i18.Tr("salam: invalid log level '%s'"), co.ArgStr(val)))
                ret false
            end
            out.log_level = lvl
        else opt_value(arg, "--lang", val):
            out.lang = val
        else opt_value(arg, "--xml-out", val):
            out.xml_out = val
        else opt_value(arg, "--timeout", val):
            mut ms := 0
            if !parse_timeout_ms(val, ms):
                io.EPrintln(
                    co.Format1(
                        i18.Tr("salam: invalid --timeout value '%s' (milliseconds, > 0)"), co.ArgStr(val)
                    )
                )
                ret false
            end
            out.timeout_ms = ms
        else str.StartsWith(arg, "-") && str.Len(arg) > 1:
            io.EPrintln(co.Format1(i18.Tr("salam: unknown option '%s'"), co.ArgStr(arg)))
            ret false
        else:
            if !positional(arg, out):
                ret false
            end
        end
        i += 1
    end
    ret true
end

// ---------------------------------------------------------------------------
// driver.c's driver_new (project scaffolding) - not part of any prior
// stage's brief ("scaffolding is cli-wave territory", PORTING.md).
// ---------------------------------------------------------------------------
func new_project(opt &: dr.Dr): int:
    mut name := opt.new_name
    if str.Len(name) == 0:
        print "Project name: "
        line := io.Input()
        name = str.Trim(line)
    end
    if str.Len(name) == 0:
        io.EPrintln(i18.Tr("salam: project name cannot be empty"))
        ret 2
    end
    if str.Contains(name, "/") || str.Contains(name, "\\"):
        io.EPrintln(
            co.Format1(
                i18.Tr("salam: project name must not contain path separators ('%s')"), co.ArgStr(name)
            )
        )
        ret 2
    end
    if os.Mkdir(name) != 0:
        if os.Exists(name):
            io.EPrintln(co.Format1(i18.Tr("salam: '%s' already exists"), co.ArgStr(name)))
        else:
            io.EPrintln(
                co.Format1(
                    i18.Tr("salam: cannot create directory '%s'"), co.ArgStr(name)
                )
            )
        end
        ret 2
    end
    fa := str.Equals(opt.lang, "fa")
    ar := str.Equals(opt.lang, "ar")
    en_content := "func main:\n    println \"Hello, World!\"\nend\n"
    fa_content := "تابع main:\n    چاپ \"سلام، دنیا!\"\nپایان\n"
    ar_content := "دالة الرئيسية:\n    اطبع \"مرحبا بالعالم!\"\nنهاية\n"
    mut content := en_content
    if fa:
        content = fa_content
    else ar:
        content = ar_content
    end
    path := name + "/main.salam"
    wrc := io.WriteFile(path, content)
    if wrc < 0:
        io.EPrintln(co.Format1(i18.Tr("salam: cannot write '%s'"), co.ArgStr(path)))
        ret 2
    end
    println "Created project '" + name + "':"
    println "  " + path
    println ""
    println "Next steps:"
    mut exe_suffix := ""
    if SALAM_OS_WINDOWS:
        exe_suffix = ".exe"
    else:
        exe_suffix = ""
    end
    println "  salam build " + path + " --output=" + name + exe_suffix
    if fa:
        println "  (زبان فارسی)"
    else ar:
        println "  (اللغة العربية)"
    end
    ret 0
end

// ---------------------------------------------------------------------------
// driver.c's driver_fmt + fmt_walk + fmt_one_file (CMD_FMT), calling
// sal_fmt.salam's already-ported Source() formatter.
// ---------------------------------------------------------------------------
func has_salam_ext(name: str): bool:
    ret str.EndsWith(name, ".salam")
end

func fmt_one_file(c &: FmtCtx, path: str):
    mut sfile := src.New()
    if !src.Load(path, sfile):
        io.EPrintln(co.Format1(i18.Tr("cannot read source file '%s'"), co.ArgStr(path)))
        c.errors += 1
        ret
    end
    c.total += 1
    pack := lx.Detect(sfile, c.pack)
    style := sf.NewStyle(c.tabs, c.width)
    mut out := co.SbNew()
    lgr := lg.New(lg.LOG_OFF, false)
    ok := sf.Source(lgr, pack, sfile, style, out)
    if !ok:
        co.SbFree(out)
        io.EPrintln(
            co.Format1(
                i18.Tr("cannot format '%s': fix the lexical errors first"), co.ArgStr(path)
            )
        )
        c.errors += 1
        ret
    end
    formatted := co.SbCstr(out)
    changed := !str.Equals(formatted, sfile.text)
    if !changed:
        c.ok += 1
        co.SbFree(out)
        ret
    end
    c.changed += 1
    if c.check:
        println path
    else:
        wrc := io.WriteFile(path, formatted)
        if wrc < 0:
            io.EPrintln(co.Format1(i18.Tr("salam: cannot write '%s'"), co.ArgStr(path)))
            c.errors += 1
        else:
            println co.Format1(i18.Tr("formatted %s"), co.ArgStr(path))
        end
    end
    co.SbFree(out)
end

func fmt_walk(c &: FmtCtx, dir: str):
    entries := os.ListDir(dir)
    defer entries.free()
    repeat entries.len() with i:
        name := entries.get(i)[0]
        if str.StartsWith(name, "."):
            continue
        end
        child := dir + "/" + name
        if os.IsDir(child):
            fmt_walk(c, child)
        else has_salam_ext(name):
            fmt_one_file(c, child)
        end
    end
end

func fmt_cmd(opt &: dr.Dr): int:
    pack := lp.Load(opt.lang)
    if pack == lp.LP_NONE:
        io.EPrintln(co.Format1(i18.Tr("unknown language pack '%s'"), co.ArgStr(opt.lang)))
        ret 2
    end
    mut c := FmtCtx {}
    c.check = opt.fmt_check
    c.fix_order = opt.fmt_fix_order
    c.tabs = opt.fmt_tabs
    c.width = opt.fmt_indent_width
    c.pack = pack
    if opt.inputs.len() == 0:
        fmt_walk(c, ".")
    else:
        repeat opt.inputs.len() with i:
            p := opt.inputs.get(i)[0]
            if os.IsDir(p):
                fmt_walk(c, p)
            else:
                fmt_one_file(c, p)
            end
        end
    end
    if c.check:
        if c.changed == 0:
            println co.Format1(
                i18.Tr("all %d file(s) already formatted"), co.ArgInt(c.total as i64)
            )
        else:
            println co.Format2(
                i18.Tr("%d of %d file(s) need formatting"), co.ArgInt(c.changed as i64), co.ArgInt(c.total as i64)
            )
        end
    else:
        println co.Format2(
            i18.Tr("done: %d formatted, %d unchanged"), co.ArgInt(c.changed as i64), co.ArgInt(c.ok as i64)
        )
    end
    mut rc := 0
    if c.errors > 0:
        rc = 2
    else c.check && c.changed > 0:
        rc = 1
    end
    ret rc
end

// ---------------------------------------------------------------------------
// driver/debug_cmd.c's driver_debug/driver_memcheck.
// ---------------------------------------------------------------------------
func debug_cmd(opt &: dr.Dr): int:
    if opt.inputs.len() == 0:
        io.EPrintln("salam debug: no input file")
        ret 2
    end
    opt.debug_info = true
    if !opt.safe:
        opt.safe = true
        opt.defines.push("SALAM_SAFE")
    end
    mut exe := opt.output
    if str.Len(exe) == 0:
        exe = path_stem(opt.inputs.get(0)[0]) + ".exe"
        opt.output = exe
    end
    rc := dr.Build(opt)
    if rc != 0:
        ret rc
    end
    target := str.Len(opt.exe_path) > 0 ? opt.exe_path : exe
    mut dbg := "gdb"
    if SALAM_OS_MAC:
        dbg = "lldb"
    else:
        dbg = "gdb"
    end
    mut cmd := ""
    if SALAM_OS_MAC:
        cmd = dbg + " -o 'breakpoint set --name main' -o 'run' -- " + shell_arg(target)
        println ""
        println "salam: launching " + dbg
        println "  (lldb) breakpoint set --name main  -> already set"
        println "  (lldb) next / step                 -> step over / into"
        println "  (lldb) frame variable <var>        -> inspect a variable"
        println "  (lldb) source list                 -> show Salam source (via #line)"
        println "  (lldb) continue / quit             -> resume / exit"
        println ""
    else SALAM_OS_WINDOWS:
        cmd = dbg + " " + shell_arg(target)
        println ""
        println "salam: launching " + dbg
        println "  Tip: (gdb) break main   -> set a breakpoint"
        println "       (gdb) run          -> start the program"
        println "       (gdb) next / step  -> step over / into"
        println "       (gdb) print <var>  -> inspect a variable"
        println ""
    else:
        cmd = dbg + " -ex 'break main' -ex 'run' " + shell_arg(target)
        println ""
        println "salam: launching " + dbg
        println "  (gdb) break main  -> already set"
        println "  (gdb) next / step -> step over / into"
        println "  (gdb) print <var> -> inspect a variable"
        println "  (gdb) list        -> show Salam source (via #line)"
        println ""
    end
    run_rc := os.Run(cmd)
    if run_rc == 127:
        io.EPrintln("salam debug: '" + dbg + "' not found in PATH.")
        io.EPrintln("  Linux:  sudo apt-get install gdb      (or: sudo apt-get install lldb)")
        io.EPrintln("  macOS:  xcode-select --install         (ships lldb)")
        io.EPrintln("          or: brew install llvm           (provides a newer lldb)")
        io.EPrintln("  Win:    pacman -S mingw-w64-x86_64-gdb (MSYS2)")
        ret 3
    end
    ret run_rc == 0 ? 0 : 1
end

func memcheck_cmd(opt &: dr.Dr): int:
    if opt.inputs.len() == 0:
        io.EPrintln("salam memcheck: no input file")
        ret 2
    end
    if str.Contains(opt.cc, "tcc"):
        io.EPrintln("salam memcheck: tcc does not support AddressSanitizer.")
        io.EPrintln("  Use --cc=gcc or --cc=clang:")
        io.EPrintln("    salam memcheck " + opt.inputs.get(0)[0] + " --cc=gcc")
        ret 2
    end
    opt.debug_info = true
    opt.asan = true
    if !opt.safe:
        opt.safe = true
        opt.defines.push("SALAM_SAFE")
    end
    mut exe := opt.output
    if str.Len(exe) == 0:
        exe = path_stem(opt.inputs.get(0)[0]) + ".exe"
        opt.output = exe
    end
    println "salam memcheck: building with AddressSanitizer + debug symbols..."
    rc := dr.Build(opt)
    if rc != 0:
        ret rc
    end
    target := str.Len(opt.exe_path) > 0 ? opt.exe_path : exe
    mut cmd := ""
    if SALAM_OS_WINDOWS:
        println "salam memcheck: Valgrind is not available on Windows."
        println "  Running binary with ASAN error reporting..."
        println ""
        cmd = shell_arg(target)
    else:
        probe := os.Run("valgrind --version > /dev/null 2>&1")
        if probe == 0:
            println "salam memcheck: running under Valgrind..."
            println ""
            cmd = "valgrind --leak-check=full --track-origins=yes --show-leak-kinds=all " + "--error-exitcode=1 " + shell_arg(target)
        else:
            println "salam memcheck: valgrind not found; running with ASAN error reporting."
            println "  (Install: sudo apt-get install valgrind)"
            println ""
            cmd = shell_arg(target)
        end
    end
    run_rc := os.Run(cmd)
    if run_rc == 0:
        println ""
        println "salam memcheck: no memory errors detected."
    else:
        io.EPrintln("")
        io.EPrintln(
            "salam memcheck: errors detected (exit " + str.FromInt(run_rc as i64) + "). Review the output above."
        )
    end
    ret run_rc == 0 ? 0 : 1
end

// ---------------------------------------------------------------------------
// Public API (E088: pub section last)
// ---------------------------------------------------------------------------

// cli.c's cli_parse: fresh defaults (dr.NewOptions(), mirroring
// cli_set_defaults) + dispatch_command + parse_options + the post-parse
// "safe -> push SALAM_SAFE define" step, verbatim.
pub func ParseArgs(args: Vector<str>, out &: dr.Dr): bool:
    out = dr.NewOptions()
    start := dispatch_command(args, out)
    if !parse_options(args, start, out):
        ret false
    end
    if out.safe:
        out.defines.push("SALAM_SAFE")
    end
    ret true
end

// cli_help.c's cli_print_usage, returned as text (instead of taking a
// FILE*) so tests can assert on it and Run() can send it to stdout or
// stderr as the C does depending on the call site.
pub func UsageText(): str:
    ret """salam - Salam compiler

Usage:
  salam <command> [arguments] [options]
  salam <input.salam> [inspect options]

Commands:
  build    <files...> [build options]           Compile to an executable (cross-compile with --target)
  obj      <files...> [build options]           Compile to an object file (cross-compile with --target)
  llvm     <file.salam> [--output=FILE]         Emit LLVM IR (.ll) for the LLVM/wasm backend
  js       <files...> [--output=FILE]           Compile to browser-ready JavaScript (.js, or a
                                                self-contained page when FILE ends in .html)
  web      <page.salam> [--output=FILE] [--split]  Build a web project: layout page + compiled
                                                'script: src="*.salam"' programs; one .html
                                                (default) or .html/.css/.js with --split
  run      [file.salam] [build options]         Build (auto-detect entry) + run, no artifacts kept
  exec     [file.salam] [--timeout=MS]           Run with the tree-walking interpreter (no C toolchain)
  new      [name] [--lang=en|fa|ar]             Scaffold a new project directory
  format   [files/dirs...] [--check] [-r] [--tabs]  Format .salam source in place (recursive)
  layout   build <files...> [--inline]          Build the layout DSL to HTML/CSS/JS
  debug    <file.salam> [build options]         Build -g + launch GDB/LLDB
  memcheck <file.salam> [build options]         Build ASAN + run memory checker
  cli                                           Start the general REPL
  layout                                        Start the layout REPL
  help                                          Show this help
  version  [--short]                            Show version, git commit, and build date (--short: just the version number)

Build options:
  --output=FILE            Output executable (default: <module>.exe)
  --cc=PATH                C compiler to invoke (default: tcc)
  --stdlib-path=DIR        Root directory for 'std/...' imports
                           (else: $SALAM_STD, sibling salam.cfg,
                            binary-relative, install prefix, then ./std)
  --keep-c                 Keep generated .c/.h files
  --export=Fn:CName        Keep top-level pub func Fn alive despite DCE and
                           emit it under the literal C name CName instead of
                           the usual mangled one (repeatable). For embedding
                           a hand-picked API into a host with no entry point.
  -g, --debug-info         Embed DWARF debug symbols; emit #line directives
  --asan                   Enable AddressSanitizer (requires gcc/clang)
  --release                Release build: strip bounds/safety checks (e.g. Vector.get/set, array indexing) for speed
                           (default: development build, checks kept)
  --target=TRIPLE          Cross-compile via LLVM to this target triple,
                           e.g. x86_64-w64-windows-gnu (needs clang/llc + lld
                           and a sysroot); honors link/OS macros; a bundled
                           mingw sysroot ($SALAM_SYSROOTS) is used if present

Interpreter options (salam exec/run/jit <file>):
  --timeout=MS              Wall-clock deadline for the tree-walking
                           interpreter, in milliseconds (default: 5000)

LLVM backend options (salam llvm <file>):
  -O0|-O1|-O2|-O3|-Os|-Oz   Optimization level (default -O0)
  --emit-llvm               Emit textual LLVM IR (.ll) [default]
  --emit-asm                Emit target assembly (.s)
  --emit-obj, -c            Emit an object file (.o)
  --emit-bitcode, -flto     Emit LLVM bitcode (.bc) for LTO
  --exec                    Build a native executable (links libc/m)
  --jit                     JIT-run immediately via lli (no artifact)
  --target=TRIPLE           Cross-compile target (e.g. wasm32-wasi)
  -g                        Emit DWARF debug info into the IR
  --verify-ir               Run the LLVM verifier before emitting
  --native-cpu              Tune generated code for this machine's CPU
                            (host-only artifacts; ignored with --target)
  -o FILE                   Output path (default: derived from module)

JavaScript backend options (salam js <files>):
  --no-minify               Disable output minification (JS/CSS/HTML kept pretty-printed;
                            minified to a single compact line by default)
  --no-js-minify-names      Disable minification of variable/function names
                            (minified by default: a, b, c... reduces code size;
                            implied by --no-minify)

Format options:
  --check                  Report files that need formatting; do not rewrite (exit 1 if any)
  -r, --recursive          Recurse into directories (implied when no path is given)
  --tabs                   Indent with one tab per level (convert spaces to tabs)
  --spaces                 Indent with spaces (default)
  --indent=tab|N           Indent style: 'tab', or N spaces per level (1-16, default 4)
  --fix-order              Also reorder top-level declarations to satisfy the
                           import/const/var/type/func ordering rules (pure
                           reordering only; anything it can't safely move on
                           its own, e.g. inside 'extern:' blocks or platform
                           'if' blocks, is left in place and reported)
  --lang=CODE              Language pack of the source (fa=Persian, ar=Arabic)

Inspect options:
  --emit-tokens-xml        Emit the token stream as XML
  --emit-ast-xml           Lex + parse + analyze, emit the decorated AST as XML
  --emit-symbol-xml        Lex + parse + analyze, emit the symbol table as XML
  --xml-out=FILE           Write XML to FILE (default: stdout)
  --log-level=LEVEL        trace|debug|info|warn|error|off (default: info)
  --lang=CODE              Language pack (default: en)
  --color / --no-color     Force or disable colored logs (default: auto)
  --error-style=STYLE      rust|gcc|clang (default: rust)
  --error-format=FORMAT    human|json|xml (default: human)
"""
end

// driver_print_version (core/build_info.h) - see the header note on why the
// commit/date fields are hardcoded fallbacks rather than build-injected.
pub func VersionText(short_form: bool): str:
    if short_form:
        ret SALAM_VERSION + "\n"
    end
    mut out := "salam " + SALAM_VERSION + "\n"
    out = out + "commit:  " + SALAM_GIT_COMMIT + SALAM_GIT_DIRTY + "\n"
    out = out + "date:    " + SALAM_GIT_DATE + "\n"
    out = out + "built:   " + SALAM_BUILD_DATE + "\n"
    ret out
end

// driver_main: parse -> i18n_set_lang -> stdlib root/layout-schema init ->
// dispatch on opt.command. This is the real entry point main.salam calls.
pub func Run(args: Vector<str>): int:
    mut opt := dr.NewOptions()
    defer opt.inputs.free()
    defer opt.run_args.free()
    defer opt.defines.free()

    if !ParseArgs(args, opt):
        ret 2
    end
    i18.SetLang(opt.lang)
    sm.SetStdlibRoot(opt.stdlib_path)
    sm.LayoutSchemaInit(opt.stdlib_path)

    if opt.command == dr.CMD_HELP:
        text := UsageText()
        print text
        ret 0
    end
    if opt.command == dr.CMD_VERSION:
        text := VersionText(opt.version_short)
        print text
        ret 0
    end
    if opt.command == dr.CMD_NEW:
        r_new := new_project(opt)
        ret r_new
    end
    if opt.command == dr.CMD_FMT:
        r_fmt := fmt_cmd(opt)
        ret r_fmt
    end
    if opt.command == dr.CMD_RUN:
        r_run := opt.interp ? dr.Exec(opt) : dr.Run(opt)
        ret r_run
    end
    if opt.command == dr.CMD_REPL || opt.command == dr.CMD_REPL_LAYOUT:
        io.EPrintln("salam: the interactive REPL is not ported yet (PORT-TODO)")
        ret 2
    end
    if opt.command == dr.CMD_DEBUG:
        r_dbg := debug_cmd(opt)
        ret r_dbg
    end
    if opt.command == dr.CMD_MEMCHECK:
        r_mc := memcheck_cmd(opt)
        ret r_mc
    end
    if opt.command == dr.CMD_BUILD || opt.command == dr.CMD_OBJ:
        if opt.inputs.len() == 0:
            which := opt.command == dr.CMD_OBJ ? "obj" : "build"
            io.EPrintln(
                co.Format1(
                    i18.Tr("salam: '%s' requires at least one input file"), co.ArgStr(which)
                )
            )
            ret 2
        end
        r_bo := opt.command == dr.CMD_OBJ ? dr.Obj(opt) : dr.Build(opt)
        ret r_bo
    end
    if opt.command == dr.CMD_LLVM:
        if opt.inputs.len() == 0:
            io.EPrintln(i18.Tr("salam: 'llvm' requires an input file"))
            ret 2
        end
        r_llvm := dr.Llvm(opt)
        ret r_llvm
    end
    if opt.command == dr.CMD_JS:
        if opt.inputs.len() == 0:
            io.EPrintln(i18.Tr("salam: 'js' requires at least one input file"))
            ret 2
        end
        r_js := dr.Js(opt)
        ret r_js
    end
    if opt.command == dr.CMD_LAYOUT_BUILD:
        if opt.inputs.len() == 0:
            io.EPrintln(i18.Tr("salam: 'layout build' requires at least one input file"))
            ret 2
        end
        r_lb := dr.LayoutBuild(opt)
        ret r_lb
    end
    if opt.command == dr.CMD_WEB:
        if opt.inputs.len() == 0:
            io.EPrintln(i18.Tr("salam: 'web' requires an input file"))
            ret 2
        end
        r_web := dr.Web(opt)
        ret r_web
    end
    // CMD_INSPECT (default command, or a bare "salam <file.salam>" call).
    if str.Len(opt.input) == 0:
        io.EPrintln(i18.Tr("salam: no input file"))
        io.EPrintln("")
        text := UsageText()
        io.EPrint(text)
        ret 2
    end
    r_insp := dr.Inspect(opt)
    ret r_insp
end
