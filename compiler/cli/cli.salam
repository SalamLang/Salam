package cli

mut _time_report := false
mut _time_report_fmt := 0
mut _time_trace := ""

struct FmtCtx:
    pub check: bool = false
    pub fix_order: bool = false
    pub tabs: bool = false
    pub width: int = 4
    pub minify: bool = false
    pub pack: int = 0
    pub changed: int = 0
    pub ok: int = 0
    pub errors: int = 0
    pub total: int = 0
    pub skipped: int = 0
    pub exclude: Vector<str> = Vector {}
    pub include: Vector<str> = Vector {}
end
