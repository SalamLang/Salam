func format_mem_gib(mem_bytes: i64): str:
    gib := (1024 as i64) * 1024 * 1024
    tenths := (mem_bytes * 10) / gib
    ret co.I64Toa(tenths / 10) + "." + co.I64Toa(tenths % 10) + " GiB"
end

func receipt_field(text: str, key: str): str:
    lines := str.Split(text, "\n")
    defer lines.free()
    prefix := key + "="
    repeat lines.len() in i:
        line := lines.get(i)
        if str.StartsWith(line, prefix):
            ret str.TrimRight(str.Substr(line, str.Len(prefix), str.Len(line) - str.Len(prefix)))
        end
    end
    ret ""
end

func origin_desc(): str:
    receipt := sm.ReadReleaseReceipt()
    if str.Equals(receipt_field(receipt, "channel"), "release"):
        tag := receipt_field(receipt, "tag")
        ret str.Len(tag) > 0 ? "official release build (" + tag + ")" : "official release build"
    end
    dirty := str.Len(co.GIT_DIRTY) > 0
    if str.Equals(co.GIT_COMMIT, "unknown"):
        ret "built from source (no git metadata)"
    end
    ret dirty ? "built from source (local build, uncommitted changes)" : "built from source (local build)"
end

func edit_distance(a: str, b: str): int:
    la := str.Len(a)
    lb := str.Len(b)
    mut prev := Vector {} as Vector<int>
    repeat lb + 1 in j:
        prev.push(j)
    end
    mut i := 1
    until i <= la:
        mut cur := Vector {} as Vector<int>
        cur.push(i)
        mut k := 1
        until k <= lb:
            mut cost := 1
            if co.ByteAt(a, i - 1) == co.ByteAt(b, k - 1):
                cost = 0
            end
            mut best := prev.get(k) + 1
            if cur.get(k - 1) + 1 < best:
                best = cur.get(k - 1) + 1
            end
            if prev.get(k - 1) + cost < best:
                best = prev.get(k - 1) + cost
            end
            cur.push(best)
            k += 1
        end
        prev.free()
        prev = cur
        i += 1
    end
    d := prev.get(lb)
    prev.free()
    ret d
end

pub func NearestCommand(word: str): str:
    if str.EndsWith(word, ".salam"):
        ret "run " + word
    end
    if str.StartsWith(word, "-"):
        w := str.TrimPrefix(str.TrimPrefix(word, "-"), "-")
        if str.Equals(w, "version") or str.Equals(w, "v"):
            ret "version"
        end
        if str.Equals(w, "help") or str.Equals(w, "h"):
            ret "help"
        end
        ret ""
    end
    names := ["build", "check", "run", "exec", "obj", "llvm", "js", "web", "serve", "new", "init", "add", "remove", "update", "deps", "install", "search", "format", "doc", "translate", "sql", "page", "debug", "memcheck", "inspect", "cli", "upgrade", "help", "version"]
    mut best := ""
    mut best_d := 3
    repeat names.len() in i:
        d := edit_distance(word, names[i])
        if d < best_d:
            best_d = d
            best = names[i]
        end
    end
    if str.Equals(word, "compile") or str.Equals(word, "make"):
        ret "build"
    end
    if str.Equals(word, "test") or str.Equals(word, "lint") or str.Equals(word, "typecheck") or str.Equals(word, "verify"):
        ret "check"
    end
    if str.Equals(word, "fmt"):
        ret "format"
    end
    if str.Equals(word, "selfupdate") or str.Equals(word, "self_update"):
        ret "upgrade"
    end
    if str.Equals(word, "repl") or str.Equals(word, "shell"):
        ret "cli"
    end
    ret best
end

pub func ParseArgs(args: Vector<str>, out &: dr.Dr): bool:
    out = dr.NewOptions()
    start := dispatch_command(args, out)
    if out.command == dr.CMD_UNKNOWN:
        bad := args.get(1)
        io.EPrintln(co.Format1(i18.Tr("salam: unknown command '%s'"), co.ArgStr(bad)))
        near := NearestCommand(bad)
        if str.Len(near) > 0:
            io.EPrintln(co.Format1(i18.Tr("did you mean 'salam %s'?"), co.ArgStr(near)))
        end
        io.EPrintln(i18.Tr("run 'salam help' to see every command"))
        ret false
    end
    if not parse_options(args, start, out):
        ret false
    end
    if out.safe:
        out.defines.push("SALAM_SAFE")
    end
    ret true
end

pub func UsageText(): str:
    ret """salam - Salam compiler

Usage:
  salam <command> [arguments] [options]

Commands:
  build    [files|dir] [build options]          Compile to an executable (cross-compile with --target); no
                                                input builds the project here (entry file: main.salam)
  check    [file.salam|dir]                     Lex, parse and type-check without building; the fast way
                                                to find errors (exit 1 when there are any)
  obj      <files...> [build options]           Compile to an object file (cross-compile with --target)
  llvm     <file.salam> [--output=FILE]         Emit LLVM IR (.ll) for the LLVM/wasm backend
  js       <files...> [--output=FILE]           Compile to browser-ready JavaScript (.js, or a
                                                self-contained page when FILE ends in .html)
  web      [page.salam|dir] [--output=FILE] [--split]  Build a web project: page + compiled
                                                'script: src="*.salam"' programs; one .html
                                                (default) or .html/.css/.js with --split
  serve    [dir] [--port=N] [--host=H]          Serve a directory over HTTP (default: '.',
                                                127.0.0.1:8000); directory listing when no
                                                index.html is present
  run      [file.salam] [build options]         Build (auto-detect entry) + run, no artifacts kept
  exec     [file.salam] [--timeout=MS]           Run with the tree-walking interpreter (no C toolchain)
  new      [name] [--lang=en|fa]                 Scaffold a new project directory (main.salam, salam.toml)
  init     [dir] [--lang=en|fa]                  Turn a directory (default '.') into a project; keeps files
                                                that are already there
  add      <github.com/owner/repo[@vX.Y.Z]>...  Add a package to salam.toml (newest release by default),
                                                download it and record it in salam.lock
  remove   <github.com/owner/repo>...           Drop a package from salam.toml and salam.lock
  update   [github.com/owner/repo...]           Move packages to their newest release (all when none given)
  deps                                          Download what salam.lock lists, check every checksum and
                                                print the dependency list
  install  [github.com/owner/repo[/cmd][@vX.Y.Z]]  Build a program's main.salam in release mode and put it in
                                                ~/.salam/bin ($SALAM_BIN); no argument installs this project
  search   <words>                              Find packages in the standard library and the registry
  format   [files/dirs...] [--check] [-r] [--tabs] [--exclude=PAT]  Format .salam source in place (recursive)
  doc      [path] [--output=FILE] [--lang=CODE]     Generate a self-contained API doc.html from a
                                                project directory (default '.') or a single file
  translate en|fa [files|dir] [--lang=CODE] [--rewrite] [--output=PATH]
                                                Rewrite Salam source between language packs: keywords,
                                                true/false/null/this, the entry function, primitive
                                                type names, and Vector/HashMap/File/Variant methods
                                                after '.' (see 'Translate options' below)
  sql      check [files|dirs...] [--dialect=NAME] [--schema=PATH]
                                                Check SQL without a database: .sql files, and every SQL
                                                string literal in .salam files. Without --dialect the
                                                engine comes from the code's own db/<engine> import;
                                                --schema points at the DDL (a file or a directory of
                                                .sql files) and turns on table and column checking
  sql      generate <files|dirs...> --schema=PATH [--output=FILE] [--package=NAME]
                                                Generate typed Salam functions and row structs from
                                                '-- name: Thing :one' annotated queries, checked against
                                                the schema as they are generated (kinds: one, many,
                                                exec, execrows)
  page     build [files|dir] [--inline]         Build a page to HTML/CSS/JS (no input: main.salam,
                                                else every page here)
  debug    <file.salam> [build options]         Build -g + launch GDB/LLDB
  memcheck <file.salam> [build options]         Build ASAN + run memory checker
  inspect  <file.salam> [inspect options]       Lex/parse/analyze and dump tokens/AST/symbols as XML
  cli                                           Start the general REPL
  page                                          Start the page REPL
  help                                          Show this help
  upgrade  [X.Y.Z] [--check] [--force]          Upgrade salam, its standard library and bundled tools to
                                                the newest release (or X.Y.Z); --check only reports
  version  [--short]                            Show version, git commit, and build date (--short: just the version number)

Build options:
  --output=FILE            Output executable (default: <module>, plus
                           .exe when the target is Windows)
  --backend=llvm|c         Code generator (default: llvm when this build
                           has it, else c). llvm optimizes and links
                           in-process; c goes through a C compiler.
                           A build optimizes at -O2 either way (-O3 with
                           --release, none with --debug-info or --asan);
                           -O<n> overrides it for the llvm backend
  --cc=PATH                C compiler to invoke (default: tcc);
                           implies --backend=c
  --libpath=DIR            Extra library search directory for the link
                           step (repeatable), for archives not installed
                           under the usual prefix
  --stdlib-path=DIR        Root directory for 'std/...' imports
                           (else: $SALAM_STD, sibling salam.cfg,
                            binary-relative, install prefix, then ./std)
  --keep-temp              Keep generated temp build files (.c/.h, .ll)
                           instead of deleting them once the build/run
                           finishes; also applies to 'run' and 'jit'
  --emit-c                 Emit the generated C and stop (implies --keep-temp)
  -dNAME=VALUE             Define a compile-time constant the program can
    (--const=NAME=VALUE)   read by name, as if the source said
                           'const NAME := VALUE' (repeatable). NAME must be
                           upper case (A-Z, 0-9, '_'; no '-'). VALUE is read
                           as an integer, float, true/false, else a string;
                           wrap it in quotes to force a string. Bare -dNAME
                           means true. A constant declared in the source
                           wins over one defined here.
  -DNAME[=VALUE]           Define a conditional-compilation flag for 'if'
    (--define=NAME[=VALUE]) conditions (repeatable); see also -d above
  --time-report[=FMT]      Report where the compiler spent its own time
                           (FMT: table (default) or json; written to stderr)
  --time-trace[=FILE]      Write a Chrome Trace Event JSON of the same run
                           (default: salam-trace.json; open in Perfetto,
                            chrome://tracing or speedscope)
  -B, --force              Rebuild everything: ignore cached .o objects and
                           recompile every module, even if unchanged
  --lib[=shared|static]    Build a library instead of an executable: a .so
                           (.dylib on macOS, .dll plus an import library on
                           Windows) or a static .a, plus a C header listing
                           the functions of the entry file's 'export:' block.
                           No main is needed; the runtime starts when the
                           library loads. Builds through the C backend
  --export=Fn:CName        Keep top-level pub func Fn alive despite DCE and
                           emit it under the literal C name CName instead of
                           the usual mangled one (repeatable). For embedding
                           a hand-picked API into a host with no entry point.
  -g, --debug-info         Embed DWARF debug symbols; emit #line directives
  --asan                   Enable AddressSanitizer (requires gcc/clang)
  --lto                    Whole-program LTO on the final link (gcc/clang;
                           slower, single-threaded link vs. the default
                           parallel per-file compile - smaller/faster binary)
  --release                Release build: strip bounds/safety checks (e.g. Vector.get/set, array indexing) for speed,
                           and assume signed +,-,* do not overflow (LLVM
                           backend). Signed wrap is only guaranteed in a
                           development build - use an unsigned type where
                           you rely on it. Unsigned wrap is always defined
                           (default: development build, checks kept)
  --ownership=MODE         Compile-time memory checks: on (default; errors
                           for a definite use after free, double free or a
                           returned value its own defer frees), warn (also
                           warn on paths that may do so), error (warnings
                           become errors), off. Costs nothing at run time
  --target=TRIPLE         Cross-compile via LLVM to this target triple,
                           e.g. x86_64-w64-windows-gnu (needs clang/llc + lld
                           and a sysroot); honors link/OS macros; a bundled
                           mingw sysroot ($SALAM_SYSROOTS) is used if present

Interpreter options (salam exec/run/jit <file>):
  --timeout=MS              Wall-clock deadline for the tree-walking
                           interpreter, in milliseconds (default: no limit)

Serve options (salam serve [dir]):
  --port=N                 Port to listen on (default: 8000)
  --host=HOST              Address to bind: 127.0.0.1 (default), 0.0.0.0 (all
                           interfaces), localhost, or any resolvable host/IP

Upgrade options (salam upgrade [X.Y.Z]):
  --check                  Only report whether a newer release exists
  --force                  Reinstall even when already up to date, or replace a
                           copy that a package manager installed
  X.Y.Z, --version=X.Y.Z   Install that release instead of the newest one
                           (this can also move back to an older release)
  The official installer (install.sh, or install.ps1 on Windows) replaces the
  compiler, std/ and any bundled tools together, in the directory this salam
  runs from. SALAM_INSTALLER names a local installer script to use instead of
  downloading one; GITHUB_TOKEN lifts GitHub's API rate limit.

LLVM backend options (salam llvm <file>):
  -O0|-O1|-O2|-O3|-Os|-Oz   Optimization level (default -O0 here, since
                            this command is for reading the IR; `salam
                            build --backend=llvm` defaults to -O2)
  --emit-llvm               Emit textual LLVM IR (.ll) [default]
  --emit-asm                Emit target assembly (.s)
  --emit-obj, -c            Emit an object file (.o)
  --emit-bitcode, -flto     Emit LLVM bitcode (.bc) for LTO
  --exec                    Build a native executable (links libc/m)
  --jit                     JIT-run immediately via lli (no artifact)
  -- ARGS...                Pass ARGS to the program (with 'run' or '--jit')
  --target=TRIPLE           Cross-compile target (e.g. wasm32-wasi)
  -g                        Emit DWARF debug info into the IR
  --verify-ir               Run the LLVM verifier before emitting
  --native-cpu              Tune generated code for this machine's CPU
                            (host-only artifacts; ignored with --target)
  -o FILE                   Output path (default: derived from module)

JavaScript backend options (salam js <files>):
  --no-minify               Disable output minification (JS/CSS/HTML kept pretty-printed;
                            minified to a single compact line by default)
  --no-js-minify-names      Disable minification of variable/function names
                            (minified by default: a, b, c... reduces code size;
                            implied by --no-minify)

Format options:
  --check                  Report files that need formatting; do not rewrite (exit 1 if any)
  -r, --recursive          Recurse into directories (implied when no path is given)
  --tabs                   Indent with one tab per level (convert spaces to tabs)
  --spaces                 Indent with spaces (default)
  --indent=tab|N           Indent style: 'tab', or N spaces per level (1-16, default 4)
  --minify                 Strip all comments, indentation and blank lines (keeps
                           statement newlines; token stream is unchanged)
  --no-fix-order           Keep top-level declarations where they are. By
                           default format reorders them to satisfy the
                           import/const/var/type/func ordering rules (pure
                           reordering only; anything it can't safely move on
                           its own, e.g. inside 'extern:' blocks or platform
                           'if' blocks, is left in place and reported)
  --exclude=PATTERN        Skip files/dirs matching PATTERN (repeatable); a
                           directory match prunes the whole subtree. No '/'
                           matches the basename at any depth (e.g. '*.gen.
                           salam', 'vendor'); with a '/' it anchors against
                           the path from the input root (e.g. 'tests/fixtures/**').
                           '*' matches within one path segment, '**' across
                           segments, '?' matches one character
  --include=PATTERN        Only format files matching PATTERN (repeatable;
                           same glob syntax as --exclude); --exclude still
                           removes matches from this set
  --exclude-from=FILE      Read more --exclude patterns from FILE, one per
                           line ('#' comments and blank lines skipped;
                           repeatable)
  A '.salamfmtignore' file in the current directory, if present, is read
  the same way and merged in automatically.
  --lang=CODE              Language pack of the source (fa=Persian)

Translate options (salam translate en|fa [files|dir]):
  --lang=CODE              Source language pack (default: auto-detect per file
                           from a '// lang: fa' / '// زبان: فارسی' style
                           header comment in the first 8 lines, else which
                           pack's keywords the file matches better)
  --rewrite                Overwrite the input file(s) in place instead of
                           writing beside them
  --output=PATH            Output directory (or file, for a single input);
                           default: '<input>-<lang>' for a directory, or
                           '<stem>.<lang>.salam' next to a single input file
  Only recognized words move: reserved keywords (and/or/not included),
  true/false/null/this, the entry function name (main <-> ریشه), primitive type names in a type position (after ':',
  'as', or inside '<...>'), and Vector/HashMap/File/Variant/MapIter methods
  right after '.'. Everything else - user identifiers, comments, string
  contents, formatting - is left byte-for-byte alone. A user-defined method
  that happens to share a name with a built-in container method (e.g. its
  own '.get()') is renamed too; review the output before using --rewrite.

Doc options:
  --output=FILE            Output file; a '.json' name writes the raw API model
                           instead of HTML (default: '<dir>/doc.html', or
                           '<file-stem>.doc.html' next to a single input file)
  --lang=CODE              Language pack of the source (fa=Persian)
  Doc comments: a run of leading '//' or '///' line comments, or one
  '/** ... */' block, with no blank line before the declaration, becomes its
  doc text. Optional '@lang' tags split it per language, e.g.:
    /// @en Adds two integers.
    /// @fa دو عدد صحیح را جمع می کند.
    pub func Add(x: int, y: int): int
  Struct/interface/enum members and existing @en/@fa name aliases are
  picked up automatically; the generated page's language switcher only
  appears when more than one language is actually present in the project.

Inspect options:
  --emit-tokens            Emit the token stream as XML
  --emit-ast               Lex + parse + analyze, emit the decorated AST as XML
  --emit-symbol            Lex + parse + analyze, emit the symbol table as XML
  --xml-out=FILE           Write XML to FILE (default: stdout)
  --log-level=LEVEL        trace|debug|info|warn|error|off (default: info)
  --lang=CODE              Language pack (default: en)
  --color / --no-color     Force or disable colored logs (default: auto)
  --error-style=STYLE      rust|gcc|clang (default: rust)
  --error-format=FORMAT    human|json|xml (default: human)
"""
end

pub func VersionText(short_form: bool): str:
    if short_form:
        ret co.VERSION + "\n"
    end
    mut out := "salam " + co.VERSION + "\n"
    out = out + "commit:  " + co.GIT_COMMIT + co.GIT_DIRTY + "\n"
    out = out + "date:    " + co.GIT_DATE + "\n"
    out = out + "built:   " + co.BUILD_DATE + "\n"
    out = out + "origin:  " + origin_desc() + "\n"
    out = out + "os:      " + platform.OS() + "\n"
    out = out + "arch:    " + platform.Arch() + "\n"
    out = out + "cpus:    " + co.I64Toa(platform.CpuCount() as i64) + "\n"
    out = out + "threads: " + co.I64Toa(platform.CpuCount() as i64) + "\n"
    mem := platform.TotalMemory()
    if mem > 0:
        out = out + "memory:  " + format_mem_gib(mem) + "\n"
    end
    ret out
end

pub func RunCommand(args: Vector<str>): int:
    mut opt := dr.NewOptions()
    defer opt.inputs.free()
    defer opt.run_args.free()
    defer opt.defines.free()
    defer opt.fmt_exclude.free()
    defer opt.fmt_include.free()
    defer opt.fmt_exclude_from.free()

    if not ParseArgs(args, opt):
        ret 2
    end
    if opt.time_report or str.Len(opt.time_trace) > 0:
        pf.Enable(str.Len(opt.time_trace) > 0)
        _time_report = opt.time_report
        _time_report_fmt = opt.time_report_fmt
        _time_trace = opt.time_trace
    end
    if not opt.lang_set and str.Len(opt.input) > 0:
        mut sf := src.New()
        if src.Load(opt.input, sf):
            if str.Equals(lp.Code(lx.Detect(sf, lp.Load("en"))), "fa"):
                opt.lang = "fa"
            end
            src.Free(sf)
        end
    end
    i18.SetLang(opt.lang)
    sm.SetConsts(opt.consts)
    sm.SetOwnership(opt.ownership)
    sm.SetStdlibRoot(opt.stdlib_path)
    sm.LayoutSchemaInit(opt.stdlib_path)

    if opt.command == dr.CMD_HELP:
        text := UsageText()
        print text
        ret 0
    end
    if opt.command == dr.CMD_VERSION:
        text := VersionText(opt.version_short)
        print text
        ret 0
    end
    if opt.command == dr.CMD_UPDATE:
        r_up := update_cmd(opt)
        ret r_up
    end
    if opt.command == dr.CMD_NEW:
        r_new := new_project(opt)
        ret r_new
    end
    if opt.command == dr.CMD_INIT:
        r_init := init_project(opt)
        ret r_init
    end
    if opt.command == dr.CMD_ADD:
        r_add := pkg_add_cmd(opt)
        ret r_add
    end
    if opt.command == dr.CMD_REMOVE:
        r_rm := pkg_remove_cmd(opt)
        ret r_rm
    end
    if opt.command == dr.CMD_DEPS_UPDATE:
        r_pu := pkg_update_cmd(opt)
        ret r_pu
    end
    if opt.command == dr.CMD_DEPS:
        r_deps := pkg_deps_cmd(opt)
        ret r_deps
    end
    if opt.command == dr.CMD_INSTALL:
        r_inst := pkg_install_cmd(opt)
        ret r_inst
    end
    if opt.command == dr.CMD_SEARCH:
        r_srch := pkg_search_cmd(opt)
        ret r_srch
    end
    if opt.command == dr.CMD_FMT:
        r_fmt := fmt_cmd(opt)
        ret r_fmt
    end
    if opt.command == dr.CMD_DOC:
        r_doc := doc_cmd(opt)
        ret r_doc
    end
    if opt.command == dr.CMD_TRANSLATE:
        r_tr := translate_cmd(opt)
        ret r_tr
    end
    if opt.command == dr.CMD_SQL:
        r_sql := sql_cmd(opt)
        ret r_sql
    end
    if opt.command == dr.CMD_RUN:
        r_run := opt.interp ? dr.Exec(opt) : dr.Run(opt)
        ret r_run
    end
    if opt.command == dr.CMD_REPL or opt.command == dr.CMD_REPL_LAYOUT:
        r_repl := rp.Run(opt)
        ret r_repl
    end
    if opt.command == dr.CMD_DEBUG:
        r_dbg := debug_cmd(opt)
        ret r_dbg
    end
    if opt.command == dr.CMD_MEMCHECK:
        r_mc := memcheck_cmd(opt)
        ret r_mc
    end
    if opt.command == dr.CMD_BUILD or opt.command == dr.CMD_OBJ:
        r_bo := opt.command == dr.CMD_OBJ ? dr.Obj(opt) : dr.Build(opt)
        ret r_bo
    end
    if opt.command == dr.CMD_LLVM:
        if opt.inputs.len() == 0:
            io.EPrintln(i18.Tr("salam: 'llvm' requires an input file"))
            ret 2
        end
        r_llvm := dr.Llvm(opt)
        ret r_llvm
    end
    if opt.command == dr.CMD_JS:
        if opt.inputs.len() == 0:
            io.EPrintln(i18.Tr("salam: 'js' requires at least one input file"))
            ret 2
        end
        r_js := dr.Js(opt)
        ret r_js
    end
    if opt.command == dr.CMD_LAYOUT_BUILD:
        r_lb := dr.LayoutBuild(opt)
        ret r_lb
    end
    if opt.command == dr.CMD_WEB:
        r_web := dr.Web(opt)
        ret r_web
    end
    if opt.command == dr.CMD_SERVE:
        r_serve := dr.Serve(opt)
        ret r_serve
    end
    if str.Len(opt.input) == 0:
        io.EPrintln(i18.Tr("salam: no input file"))
        io.EPrintln("")
        text := UsageText()
        io.EPrint(text)
        ret 2
    end
    r_insp := dr.Inspect(opt)
    ret r_insp
end

pub func Run(args: Vector<str>): int:
    if args.len() > 1 and str.Equals(args.get(1), "lsp"):
        ret ls.Main(args)
    end
    if args.len() > 1 and str.Equals(args.get(1), "dap"):
        ret ls.DapMain(args)
    end
    rc := RunCommand(args)
    if pf.On():
        if _time_report:
            pf.Report(_time_report_fmt)
        end
        if str.Len(_time_trace) > 0:
            if not pf.WriteTrace(_time_trace):
                io.EPrint(
                    co.Format1(i18.Tr("salam: cannot write trace to '%s'\n"), co.ArgStr(_time_trace))
                )
            end
        end
        pf.Shutdown()
    end
    ret rc
end
