package cli

import os
import io
import str

include pth "../sal_path.salam"
include dr "../driver/driver.salam"
include i18 "../i18n.salam"
include co "../sal_core.salam"
include sm "../semantic/semantic.salam"

func app_script_name(platform: str): str:
    if str.Equals(platform, "android"):
        ret "build-android-app.sh"
    end
    if str.Equals(platform, "ios"):
        ret "build-ios-app.sh"
    end
    ret ""
end

func app_root_ok(root: str, script: str): bool:
    if str.Len(root) == 0:
        ret false
    end
    ret os.Exists(pth.PathJoin(pth.PathJoin(pth.PathJoin(root, "tools"), "bash"), script))
end

func app_find_root(script: str): str:
    env := os.Env("SALAM_MOBILE_ROOT")
    if app_root_ok(env, script):
        ret env
    end
    std := sm.GetStdlibRoot()
    if str.Len(std) > 0:
        root := pth.PathDir(pth.PathTrimSep(std))
        if app_root_ok(root, script):
            ret root
        end
    end
    ret ""
end

func app_exe(): str:
    mut exe := ""
    if not sm.ExePath(exe):
        ret "salam"
    end
    if not pth.PathIsAbs(exe) and str.Contains(exe, "/"):
        ret pth.PathJoin(os.Cwd(), exe)
    end
    ret exe
end

func app_wants_help(opt &: dr.Dr): bool:
    mut i := 0
    until i < opt.run_args.Len():
        a := opt.run_args.Get(i)
        if str.Equals(a, "--help") or str.Equals(a, "-h"):
            ret true
        end
        i++
    end
    ret false
end

if SALAM_OS_WINDOWS:
    func app_host_windows(): bool:
        ret true
    end
else:
    func app_host_windows(): bool:
        ret false
    end
end

func app_cmd(opt &: dr.Dr): int:
    if app_host_windows():
        io.EPrintln(i18.Tr("salam app: building phone apps is not supported on Windows; use Linux or macOS"))
        ret 2
    end
    if app_wants_help(opt):
        println i18.Tr("salam app: build a program with the native UI into a phone app\n\nUsage:\n  salam app android APP.salam --out DIR [--id ID] [--name LABEL] [--icon PNG] [--icon-bg COLOR] [--splash-color COLOR] [--splash-icon PNG] [--version NAME] [--build N]\n      [--min-sdk N] [--target-sdk N] [--orientation O] [--category C] [--config FILE] [--abi LIST|all] [--size] [--split] [--no-strip]\n      [--release] [--aab] [--keystore FILE --keystore-pass P --key-alias A [--key-pass P]]\n      [--fonts DIR] [--assets DIR] [--permission NAME]... [--no-apk] [--run]\n  salam app ios APP.salam --out DIR [--device] [--id ID] [--name LABEL] [--icon PNG] [--splash-color COLOR] [--splash-icon PNG]\n      [--ipa] [--team ID] [--profile FILE] [--sign-identity NAME] [--version NAME] [--build N] [--min-ios V] [--orientation O] [--category C] [--config FILE] [--permission NAME]...\n\nandroid needs the Android SDK with an NDK and a JDK 21; --run installs and starts the app\non the connected phone or emulator. ios needs Xcode on macOS and builds for the simulator\nunless --device is given. The build files come from the release folder next to std/, or\nfrom SALAM_MOBILE_ROOT.")
        ret 0
    end
    if opt.run_args.Len() == 0:
        io.EPrintln(i18.Tr("salam app: name a platform: salam app android APP.salam --out DIR"))
        ret 2
    end
    platform := opt.run_args.Get(0)
    script := app_script_name(platform)
    if str.Len(script) == 0:
        io.EPrintln(
            co.Format1(
                i18.Tr("salam app: unknown platform '%s' (available: android, ios)"),
                co.ArgStr(platform)
            )
        )
        ret 2
    end
    root := app_find_root(script)
    if str.Len(root) == 0:
        io.EPrintln(
            i18.Tr(
                "salam app: the mobile build files are not next to this compiler; point SALAM_MOBILE_ROOT at a Salam release folder or source checkout"
            )
        )
        ret 2
    end
    path := pth.PathJoin(pth.PathJoin(pth.PathJoin(root, "tools"), "bash"), script)
    mut cmd := "SALAM=" + shell_arg(app_exe()) + " sh " + shell_arg(path)
    mut i := 1
    until i < opt.run_args.Len():
        cmd += " " + shell_arg(opt.run_args.Get(i))
        i++
    end
    ret os.Run(cmd)
end
