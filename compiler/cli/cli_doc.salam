package cli

import os
import io
import str
import dr "../driver/driver.salam"
import docg "../docgen/docgen.salam"
import lg "../logger.salam"
import i18 "../i18n.salam"
import lp "../langpack.salam"
import co "../sal_core.salam"
import sm "../semantic/semantic.salam"

// ---------------------------------------------------------------------------
// `salam doc` (CMD_DOC) - not from any C original (docgen.salam is a new,
// self-hosted-only feature, same as CMD_SERVE above). Discovers .salam files
// (recursive walk for a directory input, mirroring fmt_walk; the stdlib
// package auto-glob via sm.PackageFiles for a single-file input), hands each
// one to docg.ParseFile, then renders the whole DocDb with docg.Render.
// ---------------------------------------------------------------------------
func doc_walk(dir: str, files &: Vector<str>):
    entries := os.ListDir(dir)
    defer entries.free()
    repeat entries.len() with i:
        name := entries.get(i)[0]
        if str.StartsWith(name, "."):
            continue
        end
        child := dir + "/" + name
        if os.IsDir(child):
            doc_walk(child, files)
        else has_salam_ext(name):
            files.push(child)
        end
    end
end

func strip_trailing_slash(p: str): str:
    n := str.Len(p)
    if n > 0:
        last := byte_at(p, n - 1)
        if last == 47 || last == 92:
            ret str.Substr(p, 0, n - 1)
        end
    end
    ret p
end

func doc_dir_prefix(path: str): str:
    slash := str.LastIndex(path, "/")
    bslash := str.LastIndex(path, "\\")
    mut cut := slash
    if bslash > cut:
        cut = bslash
    end
    if cut < 0:
        ret ""
    end
    ret str.Substr(path, 0, cut + 1)
end

// Directory input -> "<dir>/doc.html" (so bare `salam doc` writes
// "./doc.html"); single-file input -> "<same dir>/<stem>.doc.html".
// --output=FILE overrides either default.
func doc_output_path(explicit: str, path: str): str:
    if str.Len(explicit) > 0:
        ret explicit
    end
    if os.IsDir(path):
        ret strip_trailing_slash(path) + "/doc.html"
    end
    ret doc_dir_prefix(path) + path_stem(path) + ".doc.html"
end

func doc_write(lgr: lg.Logger, path: str, content: str): bool:
    if io.WriteFile(path, content) < 0:
        lg.Log(lgr, lg.PH_DRIVER, lg.LOG_ERROR, co.Format1(i18.Tr("cannot write '%s'"), co.ArgStr(path)))
        ret false
    end
    ret true
end

func doc_cmd(opt &: dr.Dr): int:
    path := opt.inputs.len() > 0 ? opt.inputs.get(0)[0] : "."
    if !os.Exists(path):
        io.EPrintln(co.Format1(i18.Tr("salam doc: '%s' does not exist"), co.ArgStr(path)))
        ret 2
    end
    pack := lp.Load(opt.lang)
    if pack == lp.LP_NONE:
        io.EPrintln(co.Format1(i18.Tr("unknown language pack '%s'"), co.ArgStr(opt.lang)))
        ret 2
    end
    mut files := Vector {} as Vector<str>
    defer files.free()
    if os.IsDir(path):
        doc_walk(strip_trailing_slash(path), files)
    else:
        files = sm.PackageFiles(path)
    end
    if files.len() == 0:
        io.EPrintln(co.Format1(i18.Tr("salam doc: no .salam files found under '%s'"), co.ArgStr(path)))
        ret 2
    end
    lgr := lg.New(lg.LOG_OFF, false)
    mut db := docg.NewDb()
    mut warn := 0
    repeat files.len() with i:
        p := files.get(i)[0]
        ok := docg.ParseFile(db, lgr, pack, p, p, opt.defines)
        if !ok:
            warn += 1
        end
    end
    title := path_stem(strip_trailing_slash(path))
    html := docg.Render(db, title)
    out := doc_output_path(opt.output, path)
    if !doc_write(lgr, out, html):
        ret 2
    end
    mut pub_count := 0
    mut priv_count := 0
    repeat db.decls.len() with i:
        d := db.decls.get(i)[0]
        if d.is_pub:
            pub_count += 1
        else:
            priv_count += 1
        end
    end
    summary := "salam doc: scanned " + str.FromInt(files.len() as i64) + " file" + plural_suffix(files.len()) + " (" + str.FromInt(pub_count as i64) + " public, " + str.FromInt(priv_count as i64) + " private declarations)"
    println summary
    println "  -> " + out
    // Without this, a nonzero exit and a few silently missing entries are the
    // only clue that a source file failed to parse.
    if warn > 0:
        println "  note: " + str.FromInt(warn as i64) + " file" + plural_suffix(warn) + " did not parse cleanly; declarations the parser could not read were skipped"
    end
    ret warn > 0 ? 1 : 0
end
