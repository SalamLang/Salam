package cli

func tpl_cli_main(fa: bool): str:
    if fa:
        ret `// زبان: فارسی
فراخوانی خوشامد "src/greet.salam"

تابع ریشه:
    سرچاپ خوشامد.سلام("دنیا")
پایان
`
    end
    ret `include greet "src/greet.salam"

func main:
    println greet.Hello("World")
end
`
end

func tpl_cli_greet(fa: bool): str:
    if fa:
        ret `// زبان: فارسی
بسته خوشامد

همگانی تابع سلام(نام: رشته): رشته:
    برگشت "سلام، " + نام + "!"
پایان
`
    end
    ret `package greet

pub func Hello(name: str): str:
    ret "Hello, " + name + "!"
end
`
end

func tpl_cli_test(fa: bool): str:
    if fa:
        ret `// زبان: فارسی
واردسازی آزمایش

فراخوانی خوشامد "../src/greet.salam"

تابع آزمون سلام():
    آزمایش.ادعای برابری رشته(خوشامد.سلام("سلام"), "سلام، سلام!")
پایان
`
    end
    ret `import testing

include greet "../src/greet.salam"

func test_hello():
    testing.AssertEqStr(greet.Hello("Salam"), "Hello, Salam!")
end
`
end

func tpl_http_main(fa: bool): str:
    if fa:
        ret `// زبان: فارسی
واردسازی شبکه.اچ تی تی پی
واردسازی شبکه.مسیریاب

تابع خانه(کتکس: صحیح۶۴):
    اچ تی تی پی.متن(کتکس، "سلام از سلام")
پایان

تابع سلام(کتکس: صحیح۶۴):
    اچ تی تی پی.متن(کتکس، "سلام، " + اچ تی تی پی.پارامتر(کتکس، "name") + "!")
پایان

تابع سلامت(کتکس: صحیح۶۴):
    اچ تی تی پی.جیسون(کتکس، "{\"status\":\"ok\"}")
پایان

تابع ریشه:
    ناپایا ر := مسیریاب.مسیریاب جدید()
    مسیریاب.دریافت(ر، "/"، خانه)
    مسیریاب.دریافت(ر، "/hello/:name"، سلام)
    مسیریاب.دریافت(ر، "/health"، سلامت)
    ناپایا س := اچ تی تی پی.سرور جدید(8080)
    اچ تی تی پی.استفاده(س، ر)
    سرچاپ "گوش می دهد روی http://localhost:8080"
    اچ تی تی پی.اجرا(س)
پایان
`
    end
    ret `import net.http
import net.router

func home(ctx: i64):
    http.Text(ctx, "Hello from Salam")
end

func hello(ctx: i64):
    http.Text(ctx, "Hello, " + http.Param(ctx, "name") + "!")
end

func health(ctx: i64):
    http.Json(ctx, "{\"status\":\"ok\"}")
end

func main:
    mut r := router.NewRouter()
    router.Get(r, "/", home)
    router.Get(r, "/hello/:name", hello)
    router.Get(r, "/health", health)
    mut s := http.NewServer(8080)
    http.Use(s, r)
    println "listening on http://localhost:8080"
    http.Run(s)
end
`
end

func tpl_page_main(fa: bool): str:
    if fa:
        ret `// زبان: فارسی
بخش شمارنده:
    شمار := 0
    جعبه:
        شکاف = 12
        پاراگراف:
            محتوا = "تعداد کلیک: " + شمار
        پایان
        دکمه:
            کلیک = (): شمار++ پایان
            محتوا = "کلیک کنید"
        پایان
    پایان
پایان

صفحه:
    عنوان = "برنامه من"
    زبان = "fa"
    جعبه:
        فاصله = 32
        شکاف = 16
        بیشینه عرض = 480
        فضا = 0، "خودکار"
        سرتیتر:
            اندازه = 1
            محتوا = "برنامه من"
        پایان
        شمارنده: پایان
    پایان
پایان
`
    end
    ret `component Counter:
    count := 0
    box:
        gap = 12
        paragraph:
            content = "Clicked " + count + " times"
        end
        button:
            click = (): count++ end
            content = "Click me"
        end
    end
end

page:
    title = "My App"
    box:
        padding = 32
        gap = 16
        max width = 480
        margin = 0, "auto"
        heading:
            size = 1
            content = "My App"
        end
        Counter: end
    end
end
`
end

func tpl_spa_main(fa: bool): str:
    if fa:
        ret `// زبان: فارسی
صفحه:
    حالت = "هش"
    عنوان = "برنامه من"
    زبان = "fa"
    جعبه:
        کمینه ارتفاع = 100vh
        سربرگ‌سایت: پایان
        اصلی:
            بیشینه عرض = 720
            فضا = 0، "خودکار"
            فاصله = 32، 20
            نمای مسیر: پایان
        پایان
    پایان
پایان
`
    end
    ret `page:
    mode = "hash"
    title = "My App"
    box:
        min height = 100vh
        SiteHeader: end
        main:
            max width = 720
            margin = 0, "auto"
            padding = 32, 20
            Outlet: end
        end
    end
end
`
end

func tpl_spa_header(fa: bool): str:
    if fa:
        ret `// زبان: فارسی
همگانی بخش سربرگ‌سایت:
    سرصفحه:
        چیدمان = "ردیف"
        تراز = "وسط"
        شکاف = 20
        فاصله = 16، 24
        کادر پایین = 1، "توپر"، "#e5e7eb"
        پیوند:
            مقصد = "/"
            وزن قلم = 700
            تزیین متن = "هیچ"
            محتوا = "برنامه من"
        پایان
        پیوند:
            مقصد = "/about"
            تزیین متن = "هیچ"
            محتوا = "درباره"
        پایان
    پایان
پایان
`
    end
    ret `pub component SiteHeader:
    header:
        layout = "row"
        align = "center"
        gap = 20
        padding = 16, 24
        border bottom = 1, "solid", "#e5e7eb"
        link:
            to = "/"
            font weight = 700
            decoration = "none"
            content = "My App"
        end
        link:
            to = "/about"
            decoration = "none"
            content = "About"
        end
    end
end
`
end

func tpl_spa_index(fa: bool): str:
    if fa:
        ret `// زبان: فارسی
همگانی بخش خانه:
    عنوان = "خانه"
    شمار := 0
    جعبه:
        شکاف = 12
        سرتیتر:
            اندازه = 1
            محتوا = "خوش آمدید"
        پایان
        پاراگراف:
            محتوا = "فایل pages/index.salam را ویرایش و ذخیره کنید."
        پایان
        دکمه:
            کلیک = (): شمار++ پایان
            محتوا = "تعداد کلیک: " + شمار
        پایان
    پایان
پایان
`
    end
    ret `pub component Home:
    title = "Home"
    count := 0
    box:
        gap = 12
        heading:
            size = 1
            content = "Welcome"
        end
        paragraph:
            content = "Edit pages/index.salam and save."
        end
        button:
            click = (): count++ end
            content = "Clicked " + count + " times"
        end
    end
end
`
end

func tpl_spa_about(fa: bool): str:
    if fa:
        ret `// زبان: فارسی
همگانی بخش درباره:
    عنوان = "درباره"
    جعبه:
        شکاف = 12
        سرتیتر:
            اندازه = 1
            محتوا = "درباره"
        پایان
        پاراگراف:
            محتوا = "هر فایل در پوشه pages یک مسیر است."
        پایان
    پایان
پایان
`
    end
    ret `pub component About:
    title = "About"
    box:
        gap = 12
        heading:
            size = 1
            content = "About"
        end
        paragraph:
            content = "Every file in pages/ is a route."
        end
    end
end
`
end

func tpl_spa_404(fa: bool): str:
    if fa:
        ret `// زبان: فارسی
همگانی بخش پیدانشد:
    عنوان = "پیدا نشد"
    جعبه:
        شکاف = 12
        سرتیتر:
            اندازه = 1
            محتوا = "صفحه پیدا نشد"
        پایان
        پیوند:
            مقصد = "/"
            محتوا = "بازگشت به خانه"
        پایان
    پایان
پایان
`
    end
    ret `pub component Missing:
    title = "Not found"
    box:
        gap = 12
        heading:
            size = 1
            content = "Page not found"
        end
        link:
            to = "/"
            content = "Back to the home page"
        end
    end
end
`
end

func tpl_ssr_main(fa: bool): str:
    if fa:
        ret `// زبان: فارسی
@en "Greeting"
سرور تابع خوشامد(نام: رشته): رشته:
    برگشت "سلام، " + نام + "! این متن روی سرور ساخته شد."
پایان

صفحه:
    عنوان = "برنامه من"
    زبان = "fa"
    جعبه:
        کمینه ارتفاع = 100vh
        سرصفحه:
            چیدمان = "ردیف"
            تراز = "وسط"
            شکاف = 20
            فاصله = 16، 24
            کادر پایین = 1، "توپر"، "#e5e7eb"
            پیوند:
                مقصد = "/"
                وزن قلم = 700
                تزیین متن = "هیچ"
                محتوا = "برنامه من"
            پایان
            پیوند:
                مقصد = "/about"
                تزیین متن = "هیچ"
                محتوا = "درباره"
            پایان
        پایان
        اصلی:
            بیشینه عرض = 720
            فضا = 0، "خودکار"
            فاصله = 32، 20
            نمای مسیر: پایان
        پایان
    پایان
پایان
`
    end
    ret `server func Greeting(name: str): str:
    ret "Hello, " + name + "! This text was made on the server."
end

page:
    title = "My App"
    box:
        min height = 100vh
        header:
            layout = "row"
            align = "center"
            gap = 20
            padding = 16, 24
            border bottom = 1, "solid", "#e5e7eb"
            link:
                to = "/"
                font weight = 700
                decoration = "none"
                content = "My App"
            end
            link:
                to = "/about"
                decoration = "none"
                content = "About"
            end
        end
        main:
            max width = 720
            margin = 0, "auto"
            padding = 32, 20
            Outlet: end
        end
    end
end
`
end

