package cli

import os
import io
import str

include dr "../driver/driver.salam"
include i18 "../i18n.salam"
include co "../sal_core.salam"
include pth "../sal_path.salam"

func toml_quote(s: str): str:
    ret "\"" + str.Replace(str.Replace(s, "\\", "\\\\"), "\"", "\\\"") + "\""
end

func project_path(dir: str, file: str): str:
    if str.Len(dir) == 0 or str.Equals(dir, "."):
        ret file
    end
    ret pth.PathJoin(dir, file)
end

func write_if_missing(path: str, content: str, made &: Vector<str>): bool:
    if os.Exists(path):
        ret true
    end
    if io.WriteFile(path, content) < 0:
        io.EPrintln(co.Format1(i18.Tr("salam: cannot write '%s'"), co.ArgStr(path)))
        ret false
    end
    made.Push(path)
    ret true
end

func is_ignored_entry(name: str): bool:
    if str.Equals(name, ".git"):
        ret true
    end
    low := str.Lower(name)
    ret str.Equals(low, "readme") or str.StartsWith(
        low, "readme."
    ) or str.Equals(low, "license") or str.StartsWith(
        low, "license."
    )
end

func is_empty_dir(dir: str): bool:
    entries := os.ListDir(dir)
    defer entries.Free()
    repeat entries.Len() in i:
        if not is_ignored_entry(entries.Get(i)):
            ret false
        end
    end
    ret true
end

func init_target(dir: str, name: str): str:
    if not os.Exists(dir) or is_empty_dir(dir):
        ret dir
    end
    sub := project_path(dir, name)
    if os.Exists(sub) and (not os.IsDir(sub) or not is_empty_dir(sub)):
        io.EPrintln(co.Format1(i18.Tr("salam: '%s' already exists"), co.ArgStr(sub)))
        ret ""
    end
    ret sub
end

func scaffold(dir: str, name: str, fa: bool, made &: Vector<str>): bool:
    mut content := "func main:\n    println \"Hello, World!\"\nend\n"
    if fa:
        content = "تابع ریشه:\n    سرچاپ \"سلام، دنیا!\"\nپایان\n"
    end
    if not write_if_missing(project_path(dir, "main.salam"), content, made):
        ret false
    end
    manifest := "[package]\nname = " + toml_quote(name) + "\nversion = \"0.1.0\"\nsalam = \">=" +
        str.TrimPrefix(
            co.VERSION, "v"
        ) + "\"\n\n[dependencies]\n"
    if not write_if_missing(project_path(dir, "salam.toml"), manifest, made):
        ret false
    end
    ignore := ".salam-build/\n/" + name + "\n/" + name + ".exe\n"
    ret write_if_missing(project_path(dir, ".gitignore"), ignore, made)
end

func scaffold_desktop(dir: str, name: str, fa: bool, made &: Vector<str>): bool:
    mut main_text := `import gui.webview

func main:
    webview.Init(webview.Config { id = "com.example.APP", name = "APP", assets_dir = "www" })
    webview.Command("greet", (c: webview.Call):
        c.ResolveStr("Hello " + c.Str("name"))
    end)
    win := webview.Open(webview.WindowOptions { title = "APP", width = 900, height = 600 })
    if win.IsClosed():
        println "could not open a window"
        ret 1
    end
    webview.Run()
end
`
    if fa:
        main_text = `واردسازی رابط گرافیکی.نمایش وب

تابع ریشه:
    نمایش وب.آغاز(نمایش وب.پیکربندی { شناسه = "com.example.APP"، نام = "APP"، پوشه دارایی ها = "www" })
    نمایش وب.فرمان("greet"، (ف: نمایش وب.فراخوان):
        ف.پاسخ متنی("سلام " + ف.متن("name"))
    پایان)
    پنجره := نمایش وب.باز کردن(نمایش وب.گزینه های پنجره { عنوان = "APP"، پهنا = ۹۰۰، بلندی = ۶۰۰ })
    اگر پنجره.بسته شده است():
        سرچاپ "پنجره باز نشد"
        برگشت ۱
    پایان
    نمایش وب.اجرا()
پایان
`
    end
    page := `<!doctype html>
<html lang="LANG" dir="DIR">
  <head>
    <meta charset="utf-8">
    <title>APP</title>
    <link rel="stylesheet" href="style.css">
  </head>
  <body>
    <h1>APP</h1>
    <button id="ask" type="button">GREET</button>
    <p id="out"></p>
    <script src="app.js"></script>
  </body>
</html>
`
    script := `const out = document.getElementById("out");

document.getElementById("ask").addEventListener("click", async () => {
  out.textContent = await salam.invoke("greet", { name: "NAME" });
});
`
    style := `body {
  font-family: system-ui, sans-serif;
  margin: 2rem;
}
`
    page_text := str.Replace(
        str.Replace(
            str.Replace(str.Replace(page, "LANG", fa ? "fa" : "en"), "DIR", fa ? "rtl" : "ltr"),
            "APP",
            name
        ),
        "GREET",
        fa ? "سلام کن" : "Say hello"
    )
    manifest := "[app]\nid = " + toml_quote(
        "com.example." + name
    ) + "\nname = " + toml_quote(name) +
        "\nversion = \"0.1.0\"\nmain = \"main.salam\"\nassets = \"www\"\n"
    folder := project_path(dir, "www")
    if os.Mkdir(folder) != 0 and not os.Exists(folder):
        io.EPrintln(co.Format1(i18.Tr("salam: cannot create directory '%s'"), co.ArgStr(folder)))
        ret false
    end
    ignore := ".salam-build/\n/dist/\n/" + name + "\n/" + name + ".exe\n"
    if not write_if_missing(
        project_path(dir, "main.salam"), str.Replace(main_text, "APP", name), made
    ):
        ret false
    end
    if not write_if_missing(project_path(dir, "salam.toml"), manifest, made):
        ret false
    end
    if not write_if_missing(project_path(dir, ".gitignore"), ignore, made):
        ret false
    end
    if not write_if_missing(project_path(folder, "index.html"), page_text, made):
        ret false
    end
    if not write_if_missing(
        project_path(folder, "app.js"), str.Replace(script, "NAME", fa ? "دنیا" : "World"), made
    ):
        ret false
    end
    ret write_if_missing(project_path(folder, "style.css"), style, made)
end

func print_created(name: str, made: Vector<str>, cd: str, run_cmd: str):
    println co.Format1(i18.Tr("Created project '%s':"), co.ArgStr(name))
    repeat made.Len() in i:
        println "  " + made.Get(i)
    end
    println ""
    println i18.Tr("Next steps:")
    if str.Len(cd) > 0:
        println "  cd " + cd
    end
    println "  " + run_cmd
end

func new_project(opt &: dr.Dr): int:
    mut name := opt.new_name
    if str.Len(name) == 0:
        print "Project name: "
        line := io.Input()
        name = str.Trim(line)
    end
    if str.Len(name) == 0:
        io.EPrintln(i18.Tr("salam: project name cannot be empty"))
        ret 2
    end
    if str.Contains(name, "/") or str.Contains(name, "\\"):
        io.EPrintln(
            co.Format1(
                i18.Tr("salam: project name must not contain path separators ('%s')"),
                co.ArgStr(name)
            )
        )
        ret 2
    end
    if os.Mkdir(name) != 0:
        if os.Exists(name):
            io.EPrintln(co.Format1(i18.Tr("salam: '%s' already exists"), co.ArgStr(name)))
        else:
            io.EPrintln(
                co.Format1(
                    i18.Tr("salam: cannot create directory '%s'"), co.ArgStr(name)
                )
            )
        end
        ret 2
    end
    mut made := Vector {} as Vector<str>
    defer made.Free()
    fa := str.Equals(opt.lang, "fa")
    if opt.new_desktop:
        if not scaffold_desktop(name, name, fa, made):
            ret 2
        end
    else not scaffold(name, name, fa, made):
        ret 2
    end
    print_created(name, made, name, "salam run")
    if opt.new_desktop:
        println "  salam bundle"
    end
    ret 0
end

func init_project(opt &: dr.Dr): int:
    mut dir := opt.new_name
    if str.Len(dir) == 0:
        dir = "."
    end
    if os.Exists(dir) and not os.IsDir(dir):
        io.EPrintln(co.Format1(i18.Tr("salam: '%s' is not a directory"), co.ArgStr(dir)))
        ret 2
    end
    if os.Exists(project_path(dir, "main.salam")) and os.Exists(project_path(dir, "salam.toml")):
        io.EPrintln(co.Format1(i18.Tr("salam: '%s' is already a Salam project"), co.ArgStr(dir)))
        ret 2
    end
    mut base := dir
    if str.Equals(dir, "."):
        base = os.Cwd()
    end
    mut name := pth.PathBase(pth.PathTrimSep(base))
    if str.Len(name) == 0 or str.Equals(name, ".") or str.Equals(name, ".."):
        name = "app"
    end
    if wizard_flags_given(opt) or stdin_is_tty():
        ret init_wizard(opt, dir, name)
    end
    target := init_target(dir, name)
    if str.Len(target) == 0:
        ret 2
    end
    if not os.Exists(target) and os.MkdirAll(target) != 0:
        io.EPrintln(co.Format1(i18.Tr("salam: cannot create directory '%s'"), co.ArgStr(target)))
        ret 2
    end
    mut made := Vector {} as Vector<str>
    defer made.Free()
    if not scaffold(target, name, str.Equals(opt.lang, "fa"), made):
        ret 2
    end
    mut cd := ""
    if not str.Equals(target, "."):
        cd = target
    end
    print_created(name, made, cd, "salam run")
    ret 0
end
