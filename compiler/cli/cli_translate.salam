package cli

import os
import io
import str

include pth "../sal_path.salam"
include dr "../driver/driver.salam"
include lg "../logger.salam"
include i18 "../i18n.salam"
include lp "../langpack.salam"
include lx "../lexer/lexer.salam"
include tok "../token.salam"
include at "../ast.salam"
include ps "../parser/parser.salam"
include src "../source.salam"
include co "../sal_core.salam"
include sm "../semantic/semantic.salam"

const K_TR_METHOD_COUNT := 38
const K_TR_CTX_COUNT := 5

k_tr_type := [
    "تهی", "void", "منطقی", "bool", "نویسه", "char", "رشته", "str", "یونیکد", "uchar", "صحیح۸", "i8", "صحیح۱۶", "i16", "صحیح۳۲", "i32", "صحیح", "int", "صحیح۶۴", "i64", "طبیعی۸", "u8", "طبیعی۱۶", "u16", "طبیعی۳۲", "u32", "طبیعی", "uint", "طبیعی۶۴", "u64", "اندازه مثبت", "usize", "اندازه", "size", "اعشار۳۲", "f32", "اعشار", "float", "اعشار۶۴", "f64", "وکتور", "Vector", "نگاشت", "HashMap", "پیمایشگرنگاشت", "MapIter", "پرونده", "File", "گوناگون", "Variant"
]

k_tr_type_alt := [
    "صحیح8", "i8", "صحیح16", "i16", "صحیح32", "i32", "صحیح64", "i64", "طبیعی8", "u8", "طبیعی16", "u16", "طبیعی32", "u32", "طبیعی64", "u64", "اعشار32", "f32", "اعشار64", "f64"
]

k_tr_method := [
    "بیفزا", "push", "دربیاور", "pop", "بگیر", "get", "ارجاع", "ref", "بنشان", "set", "طول", "len", "ظرفیت", "cap", "آزادکن", "free", "درج", "put", "دارد", "has", "حذف", "remove", "اندازه", "size", "پیمایش", "iter", "داردبعدی", "has_next", "کلید", "key", "مقدار", "value", "بعدی", "next", "خواندن", "read", "خواندن خط", "readline", "نوشتن", "write", "جابجایی", "seek", "ببند", "close", "پیوست", "concat", "زیررشته", "substr", "بیاب", "find", "بشکاف", "split", "پیراست", "trim", "به صحیح", "to_int", "به اعشار", "to_float", "شمارنویسه", "char_count", "نویسه شماره", "char_at", "زیررشته نویسه", "char_substr", "بیاب نویسه", "char_find", "شروع با", "starts_with", "ختم با", "ends_with", "دربردارد", "includes", "رونوشت", "copy", "رونوشت عمیق", "deep_copy"
]

k_tr_ctx := [
    "پیوند", "link", "ایستا", "static", "پویا", "dynamic", "چارچوب", "framework", "شامل", "use"
]

mut tr_pkg_ready := false
mut tr_pkg_root := ""
mut tr_pkg_en := Vector {} as Vector<str>
mut tr_pkg_fa := Vector {} as Vector<str>
mut tr_pkg_dir := Vector {} as Vector<str>

struct TrCtx:
    pub target: int = 0
    pub fallback: int = 0
    pub rewrite: bool = false
    pub stdlib_root: str = ""
    pub total: int = 0
    pub changed: int = 0
    pub ok: int = 0
    pub errors: int = 0
end

func tr_type_to_fa(name: str): str:
    mut i := 0
    until i < len(k_tr_type) / 2:
        if str.Equals(k_tr_type[i * 2 + 1], name):
            ret k_tr_type[i * 2]
        end
        i += 1
    end
    ret ""
end

func tr_type_to_en(name: str): str:
    mut i := 0
    until i < len(k_tr_type) / 2:
        if str.Equals(k_tr_type[i * 2], name):
            ret k_tr_type[i * 2 + 1]
        end
        i += 1
    end
    i = 0
    until i < len(k_tr_type_alt) / 2:
        if str.Equals(k_tr_type_alt[i * 2], name):
            ret k_tr_type_alt[i * 2 + 1]
        end
        i += 1
    end
    ret ""
end

func tr_method_to_fa(name: str): str:
    mut i := 0
    until i < K_TR_METHOD_COUNT:
        if str.Equals(k_tr_method[i * 2 + 1], name):
            ret k_tr_method[i * 2]
        end
        i += 1
    end
    ret ""
end

func tr_method_to_en(name: str): str:
    mut i := 0
    until i < K_TR_METHOD_COUNT:
        if str.Equals(k_tr_method[i * 2], name):
            ret k_tr_method[i * 2 + 1]
        end
        i += 1
    end
    ret ""
end

func tr_ctx_to_fa(name: str): str:
    mut i := 0
    until i < K_TR_CTX_COUNT:
        if str.Equals(k_tr_ctx[i * 2 + 1], name):
            ret k_tr_ctx[i * 2]
        end
        i += 1
    end
    ret ""
end

func tr_ctx_to_en(name: str): str:
    mut i := 0
    until i < K_TR_CTX_COUNT:
        if str.Equals(k_tr_ctx[i * 2], name):
            ret k_tr_ctx[i * 2 + 1]
        end
        i += 1
    end
    ret ""
end

func tr_type_word(targetpack: int, name: str): str:
    ret targetpack == lp.LP_FA ? tr_type_to_fa(name) : tr_type_to_en(name)
end

func tr_method_word(targetpack: int, name: str): str:
    ret targetpack == lp.LP_FA ? tr_method_to_fa(name) : tr_method_to_en(name)
end

func tr_ctx_word(targetpack: int, name: str): str:
    ret targetpack == lp.LP_FA ? tr_ctx_to_fa(name) : tr_ctx_to_en(name)
end

func tr_ctx_word_here(targetpack: int, name: str, prev_kind: int, next_kind: int): bool:
    mapped := tr_ctx_word(targetpack, name)
    if str.Len(mapped) == 0:
        ret false
    end
    if next_kind == tok.TK_KW_FUNC:
        ret str.Equals(mapped, "static") or str.Equals(mapped, "ایستا")
    end
    at_line_start := prev_kind == tok.TK_STMT_END or prev_kind == tok.TK_KW_PUB or prev_kind == tok.TK_COLON
    ret at_line_start and next_kind == tok.TK_IDENT and (str.Equals(mapped, "use") or str.Equals(mapped, "شامل"))
end

func tr_keyword_spelling(targetpack: int, kind: int): str:
    if kind == tok.TK_NOT:
        ret targetpack == lp.LP_FA ? "وارونه" : "not"
    end
    ret lp.Spelling(targetpack, kind)
end

func tr_extract_tag(line: str, tag_prefix: str): str:
    trimmed := str.TrimLeft(line)
    if not str.StartsWith(trimmed, tag_prefix):
        ret ""
    end
    rest := str.Substr(trimmed, str.Len(tag_prefix), str.Len(trimmed) - str.Len(tag_prefix))
    q1 := str.IndexOf(rest, "\"")
    if q1 < 0:
        ret ""
    end
    q2 := str.IndexFrom(rest, "\"", q1 + 1)
    if q2 < 0:
        ret ""
    end
    ret str.Substr(rest, q1 + 1, q2 - q1 - 1)
end

func tr_read_pkg_tags(path: str, en_out &: str, fa_out &: str):
    text := os.ReadFile(path)
    if str.Len(text) == 0:
        ret
    end
    lines := str.Split(text, "\n")
    defer lines.free()
    repeat lines.len() in i:
        line := lines.get(i)
        trimmed := str.TrimLeft(line)
        if str.StartsWith(trimmed, "package "):
            break
        end
        e := tr_extract_tag(line, "@en ")
        if str.Len(e) > 0:
            en_out = e
        end
        f := tr_extract_tag(line, "@fa ")
        if str.Len(f) > 0:
            fa_out = f
        end
    end
end

func tr_index_dir(std_root: str, rel: str, parent_en: str, parent_fa: str, depth: int):
    dirpath := str.Len(rel) == 0 ? std_root : pth.PathJoin(std_root, rel)
    entries := os.ListDir(dirpath)
    defer entries.free()
    repeat entries.len() in i:
        name := entries.get(i)
        if str.StartsWith(name, "."):
            continue
        end
        sub := str.Len(rel) == 0 ? name : rel + "/" + name
        full := pth.PathJoin(std_root, sub)
        if not os.IsDir(full):
            continue
        end
        mut en_tag := ""
        mut fa_tag := ""
        file := pth.PathJoin(full, name + ".salam")
        if os.Exists(file):
            tr_read_pkg_tags(file, en_tag, fa_tag)
        end
        en_path := str.Len(parent_en) > 0 ? parent_en + "." + name : name
        fa_seg := str.Len(fa_tag) > 0 ? fa_tag : name
        fa_path := str.Len(parent_fa) > 0 ? parent_fa + "." + fa_seg : fa_seg
        if str.Len(fa_tag) > 0:
            tr_pkg_en.push(en_path)
            tr_pkg_fa.push(fa_path)
            tr_pkg_dir.push(sub)
        end
        if depth < 4:
            tr_index_dir(std_root, sub, en_path, fa_path, depth + 1)
        end
    end
end

func tr_build_pkg_index(std_root: str):
    if tr_pkg_ready and str.Equals(tr_pkg_root, std_root):
        ret
    end
    tr_pkg_en.free()
    tr_pkg_fa.free()
    tr_pkg_dir.free()
    tr_pkg_en = Vector {} as Vector<str>
    tr_pkg_fa = Vector {} as Vector<str>
    tr_pkg_dir = Vector {} as Vector<str>
    tr_pkg_ready = true
    tr_pkg_root = std_root
    if not os.IsDir(std_root):
        ret
    end
    tr_index_dir(std_root, "", "", "", 0)
end

func tr_pkg_find(std_root: str, path: str, from_fa: bool): int:
    tr_build_pkg_index(std_root)
    repeat tr_pkg_en.len() in i:
        if from_fa:
            if lp.IdentEqual(tr_pkg_fa.get(i), path):
                ret i
            end
        else str.Equals(tr_pkg_en.get(i), path):
            ret i
        end
    end
    ret 0 - 1
end

func tr_last_seg(path: str): str:
    dot := str.LastIndex(path, ".")
    if dot < 0:
        ret path
    end
    ret str.Substr(path, dot + 1, str.Len(path) - dot - 1)
end

func tr_pkg_target_alias(idx: int, targetpack: int): str:
    ret tr_last_seg(targetpack == lp.LP_FA ? tr_pkg_fa.get(idx) : tr_pkg_en.get(idx))
end

func tr_decl_name(line: str): str:
    mut rest := str.TrimLeft(line)
    mut changed := true
    until changed:
        changed = false
        each pre in ["pub ", "inline ", "pure ", "extern "]:
            if str.StartsWith(rest, pre):
                rest = str.TrimLeft(str.Substr(rest, str.Len(pre), str.Len(rest) - str.Len(pre)))
                changed = true
            end
        end
    end
    mut kw_found := false
    each kw in ["func ", "const ", "struct ", "interface ", "enum ", "type ", "mut "]:
        if not kw_found and str.StartsWith(rest, kw):
            rest = str.TrimLeft(str.Substr(rest, str.Len(kw), str.Len(rest) - str.Len(kw)))
            kw_found = true
        end
    end
    if not kw_found:
        ret ""
    end
    mut end_at := 0
    until end_at < str.Len(rest):
        c := co.ByteAt(rest, end_at)
        if not ((c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95):
            break
        end
        end_at += 1
    end
    ret str.Substr(rest, 0, end_at)
end

func tr_scan_file_member(path: str, name: str, from_fa: bool, methods: bool): str:
    text := os.ReadFile(path)
    if str.Len(text) == 0:
        ret ""
    end
    lines := str.Split(text, "\n")
    defer lines.free()
    mut pending_en := ""
    mut pending_method := false
    mut struct_indent := 0 - 1
    mut i := 0
    until i < lines.len():
        line := lines.get(i)
        trimmed_line := str.TrimLeft(line)
        indent := str.Len(line) - str.Len(trimmed_line)
        if str.StartsWith(trimmed_line, "struct ") or str.StartsWith(trimmed_line, "pub struct ") or str.StartsWith(trimmed_line, "interface ") or str.StartsWith(trimmed_line, "pub interface "):
            struct_indent = indent
        else struct_indent >= 0 and indent == struct_indent and str.Equals(str.TrimRight(trimmed_line), "end"):
            struct_indent = 0 - 1
        end
        e := tr_extract_tag(line, "@en ")
        if str.Len(e) > 0:
            pending_en = e
            pending_method = struct_indent >= 0 and indent > struct_indent
            i += 1
            continue
        end
        f := tr_extract_tag(line, "@fa ")
        if str.Len(f) > 0:
            mut header := false
            mut k := i + 1
            until k < lines.len() and str.Len(str.Trim(lines.get(k))) == 0:
                k += 1
            end
            if k < lines.len() and str.StartsWith(str.TrimLeft(lines.get(k)), "package "):
                header = true
            end
            if str.Len(pending_en) > 0 and pending_method == methods and not header:
                decl := k < lines.len() ? tr_decl_name(lines.get(k)) : ""
                if from_fa and lp.IdentEqual(f, name):
                    ret str.Len(decl) > 0 ? decl : pending_en
                end
                if not from_fa and (str.Equals(pending_en, name) or str.Equals(decl, name)):
                    ret f
                end
            end
            pending_en = ""
            i += 1
            continue
        end
        trimmed := str.TrimLeft(line)
        if str.Len(trimmed) > 0 and not str.StartsWith(trimmed, "@"):
            pending_en = ""
        end
        i += 1
    end
    ret ""
end

func tr_pkg_member(std_root: str, pkg_dir: str, name: str, from_fa: bool, methods: bool): str:
    dirpath := pth.PathJoin(std_root, pkg_dir)
    if not os.IsDir(dirpath):
        ret ""
    end
    files := os.ListDir(dirpath)
    defer files.free()
    mut result := ""
    mut i := 0
    until i < files.len() and str.Len(result) == 0:
        fname := files.get(i)
        if str.EndsWith(fname, ".salam"):
            found := tr_scan_file_member(pth.PathJoin(dirpath, fname), name, from_fa, methods)
            if str.Len(found) > 0:
                result = found
            end
        end
        i += 1
    end
    ret result
end

func tr_word_kind(kind: int): bool:
    ret kind == tok.TK_IDENT or tok.IsKeyword(kind) or kind == tok.TK_AND or kind == tok.TK_OR or kind == tok.TK_NOT
end

func tr_member_words(std_root: str, pkg_dir: str, toks: tok.TokenStream, i: int, n: int, from_fa: bool, methods: bool, best_j &: int): str:
    first := tok.StreamAt(toks, i)
    mut words := first.lexeme
    mut found := tr_pkg_member(std_root, pkg_dir, words, from_fa, methods)
    best_j = i
    mut j := i
    until j + 1 < n and j - i < 6 and (from_fa and tr_word_kind(tok.StreamAt(toks, j + 1).kind) or tok.StreamAt(toks, j + 1).kind == tok.TK_IDENT) and tok.StreamAt(toks, j + 1).begin_line == first.begin_line:
        j += 1
        words = words + " " + tok.StreamAt(toks, j).lexeme
        cand := tr_pkg_member(std_root, pkg_dir, words, from_fa, methods)
        if str.Len(cand) > 0:
            found = cand
            best_j = j
        end
    end
    ret found
end

func tr_builtin_words(targetpack: int, toks: tok.TokenStream, i: int, n: int, from_fa: bool, best_j &: int): str:
    first := tok.StreamAt(toks, i)
    mut words := first.lexeme
    mut found := ""
    if tr_next_is_call(toks, i, n):
        found = tr_method_word(targetpack, words)
        best_j = i
    end
    if not from_fa:
        ret found
    end
    mut j := i
    until j + 1 < n and j - i < 3 and tr_word_kind(tok.StreamAt(toks, j + 1).kind) and tok.StreamAt(toks, j + 1).begin_line == first.begin_line:
        j += 1
        words = words + " " + tok.StreamAt(toks, j).lexeme
        if tr_next_is_call(toks, j, n):
            cand := tr_method_word(targetpack, words)
            if str.Len(cand) > 0:
                found = cand
                best_j = j
            end
        end
    end
    ret found
end

func tr_resolve_member(std_root: str, targetpack: int, toks: tok.TokenStream, i: int, n: int, from_fa: bool, member_pkg: int, var_pkg: int, alias_pkg: Vector<int>, declared: bool, best_j &: int): str:
    best_j = i
    if member_pkg >= 0:
        ret tr_member_words(std_root, tr_pkg_dir.get(member_pkg), toks, i, n, from_fa, false, best_j)
    end
    if var_pkg >= 0:
        found := tr_member_words(std_root, tr_pkg_dir.get(var_pkg), toks, i, n, from_fa, true, best_j)
        if str.Len(found) > 0 and tr_next_is_call(toks, best_j, n):
            ret found
        end
    end
    builtin := tr_builtin_words(targetpack, toks, i, n, from_fa, best_j)
    if str.Len(builtin) > 0:
        ret builtin
    end
    best_j = i
    if declared:
        ret ""
    end
    repeat alias_pkg.len() in pk:
        if alias_pkg.get(pk) >= 0:
            found := tr_member_words(std_root, tr_pkg_dir.get(alias_pkg.get(pk)), toks, i, n, from_fa, true, best_j)
            if str.Len(found) > 0 and tr_next_is_call(toks, best_j, n):
                ret found
            end
        end
    end
    best_j = i
    ret ""
end

func tr_builtin_word(targetpack: int, name: str): str:
    if targetpack == lp.LP_FA:
        ret lp.BuiltinSpellOf(lp.LP_FA, name)
    end
    canon := lp.BuiltinCanonOf(lp.LP_FA, name)
    if str.Equals(canon, name):
        ret ""
    end
    ret canon
end

func tr_is_marker_line(line: str): bool:
    trimmed := str.TrimLeft(line)
    if not str.StartsWith(trimmed, "//"):
        ret false
    end
    rest := str.Substr(trimmed, 2, str.Len(trimmed) - 2)
    ret str.Contains(rest, "lang") or str.Contains(rest, "زبان")
end

func tr_apply_marker(text: str, target_code: str): str:
    lines := str.Split(text, "\n")
    defer lines.free()
    mut out_lines := Vector {} as Vector<str>
    defer out_lines.free()
    mut removed := false
    mut header := true
    mut in_block := false
    mut i := 0
    until i < lines.len():
        line := lines.get(i)
        trimmed := str.Trim(line)
        if header and not in_block and not removed and tr_is_marker_line(line):
            removed = true
            i += 1
            continue
        end
        if header:
            if in_block:
                in_block = not str.Contains(trimmed, "*/")
            else str.StartsWith(trimmed, "/*"):
                in_block = not str.Contains(str.Substr(trimmed, 2, str.Len(trimmed) - 2), "*/")
            else str.Len(trimmed) > 0 and not str.StartsWith(trimmed, "//"):
                header = false
            end
        end
        out_lines.push(line)
        i += 1
    end
    body := str.Join(out_lines, "\n")
    ret "// lang: " + target_code + "\n" + body
end

func tr_next_kind(toks: tok.TokenStream, i: int, n: int): int:
    mut j := i + 1
    until j < n:
        k := tok.StreamAt(toks, j).kind
        if k != tok.TK_COMMENT_LINE and k != tok.TK_COMMENT_BLOCK:
            ret k
        end
        j += 1
    end
    ret 0 - 1
end

func tr_next_is_call(toks: tok.TokenStream, i: int, n: int): bool:
    ret tr_next_kind(toks, i, n) == tok.TK_LPAREN
end

func tr_declared_names(toks: tok.TokenStream, n: int): Vector<str>:
    mut names := Vector {} as Vector<str>
    mut prev_kind := 0 - 1
    mut i := 0
    until i < n:
        t := tok.StreamAt(toks, i)
        if t.kind == tok.TK_IDENT and tr_is_decl_name(toks, i, n, prev_kind):
            names.push(t.lexeme)
        end
        if t.kind != tok.TK_COMMENT_LINE and t.kind != tok.TK_COMMENT_BLOCK:
            prev_kind = t.kind
        end
        i += 1
    end
    ret names
end

func tr_component_names(toks: tok.TokenStream, n: int): Vector<str>:
    mut names := Vector {} as Vector<str>
    mut i := 0
    until i < n:
        t := tok.StreamAt(toks, i)
        if t.kind == tok.TK_KW_COMPONENT:
            mut j := i + 1
            mut cname := ""
            until j < n and tok.StreamAt(toks, j).kind == tok.TK_IDENT:
                cname = str.Len(cname) > 0 ? cname + " " + tok.StreamAt(toks, j).lexeme : tok.StreamAt(toks, j).lexeme
                j += 1
            end
            if str.Len(cname) > 0:
                names.push(cname)
            end
            if j < n and tok.StreamAt(toks, j).kind == tok.TK_LPAREN:
                j += 1
                mut depth := 1
                mut want := true
                mut pname := ""
                until j < n and depth > 0:
                    k := tok.StreamAt(toks, j).kind
                    if k == tok.TK_LPAREN or k == tok.TK_LBRACKET:
                        depth += 1
                    else k == tok.TK_RPAREN or k == tok.TK_RBRACKET:
                        depth -= 1
                    end
                    if depth == 1 and k == tok.TK_IDENT and want:
                        pname = str.Len(pname) > 0 ? pname + " " + tok.StreamAt(toks, j).lexeme : tok.StreamAt(toks, j).lexeme
                    else depth >= 1 and want and str.Len(pname) > 0:
                        names.push(pname)
                        pname = ""
                        want = false
                    end
                    if depth == 1 and k == tok.TK_COMMA:
                        want = true
                    end
                    j += 1
                end
                if str.Len(pname) > 0:
                    names.push(pname)
                end
            end
            i = j
            continue
        end
        i += 1
    end
    ret names
end

func tr_imported_packages(toks: tok.TokenStream, n: int): Vector<str>:
    mut names := Vector {} as Vector<str>
    mut i := 0
    until i < n:
        if tok.StreamAt(toks, i).kind == tok.TK_KW_IMPORT:
            mut j := i + 1
            mut path := ""
            mut word := ""
            until j < n:
                k := tok.StreamAt(toks, j).kind
                if k == tok.TK_IDENT:
                    word = str.Len(word) > 0 ? word + " " + tok.StreamAt(toks, j).lexeme : tok.StreamAt(toks, j).lexeme
                else k == tok.TK_DOT:
                    path = str.Len(path) > 0 ? path + "." + word : word
                    word = ""
                else:
                    break
                end
                j += 1
            end
            if str.Len(word) > 0:
                path = str.Len(path) > 0 ? path + "." + word : word
            end
            if str.Len(path) > 0:
                names.push(path)
            end
            i = j
            continue
        end
        i += 1
    end
    ret names
end

func tr_alias_words(toks: tok.TokenStream, i: int, n: int, aliases: Vector<str>, count &: int): int:
    first := tok.StreamAt(toks, i)
    mut words := first.lexeme
    mut j := i
    until true:
        if tr_next_kind(toks, j, n) == tok.TK_DOT:
            repeat aliases.len() in a:
                if lp.IdentEqual(aliases.get(a), words):
                    count = j - i + 1
                    ret a
                end
            end
        end
        if j + 1 >= n or j - i >= 5:
            break
        end
        nx := tok.StreamAt(toks, j + 1)
        if nx.kind != tok.TK_IDENT or nx.begin_line != first.begin_line:
            break
        end
        j += 1
        words = words + " " + nx.lexeme
    end
    ret 0 - 1
end

func tr_var_packages(toks: tok.TokenStream, n: int, aliases: Vector<str>, alias_pkg: Vector<int>, var_names &: Vector<str>, var_pkgs &: Vector<int>):
    mut prev := 0 - 1
    mut i := 0
    until i + 3 < n:
        t := tok.StreamAt(toks, i)
        if t.kind == tok.TK_IDENT and prev != tok.TK_DOT:
            op := tok.StreamAt(toks, i + 1).kind
            if op == tok.TK_COLON_ASSIGN or op == tok.TK_ASSIGN:
                mut count := 0
                a := tr_alias_words(toks, i + 2, n, aliases, count)
                if a >= 0 and alias_pkg.get(a) >= 0:
                    var_names.push(t.lexeme)
                    var_pkgs.push(alias_pkg.get(a))
                end
            end
        end
        if t.kind != tok.TK_COMMENT_LINE and t.kind != tok.TK_COMMENT_BLOCK:
            prev = t.kind
        end
        i += 1
    end
end

func tr_var_package(var_names: Vector<str>, var_pkgs: Vector<int>, name: str): int:
    mut found := 0 - 1
    repeat var_names.len() in v:
        if lp.IdentEqual(var_names.get(v), name):
            found = var_pkgs.get(v)
        end
    end
    ret found
end

func tr_has_ident(names: Vector<str>, w: str): bool:
    repeat names.len() in i:
        if lp.IdentEqual(names.get(i), w):
            ret true
        end
    end
    ret false
end

func tr_has(names: Vector<str>, w: str): bool:
    repeat names.len() in i:
        if str.Equals(names.get(i), w):
            ret true
        end
    end
    ret false
end

func tr_prev_same_line(toks: tok.TokenStream, i: int): bool:
    mut j := i - 1
    until j >= 0:
        p := tok.StreamAt(toks, j)
        if p.kind != tok.TK_COMMENT_LINE and p.kind != tok.TK_COMMENT_BLOCK and p.kind != tok.TK_STMT_END:
            ret p.end_line == tok.StreamAt(toks, i).begin_line
        end
        j -= 1
    end
    ret false
end

func tr_is_decl_name(toks: tok.TokenStream, i: int, n: int, prev_kind: int): bool:
    nk := tr_next_kind(toks, i, n)
    if prev_kind == tok.TK_DOT or (nk != tok.TK_COLON and nk != tok.TK_COLON_ASSIGN):
        ret false
    end
    if not tr_prev_same_line(toks, i):
        ret true
    end
    ret prev_kind != tok.TK_COLON and prev_kind != tok.TK_RPAREN and prev_kind != tok.TK_KW_AS and prev_kind != tok.TK_KW_ON
end

func compare_symbol(kind: int): str:
    if kind == tok.TK_EQ:
        ret "=="
    else kind == tok.TK_NE:
        ret "!="
    else kind == tok.TK_LT:
        ret "<"
    else kind == tok.TK_GT:
        ret ">"
    else kind == tok.TK_LE:
        ret "<="
    end
    ret ">="
end

func tr_compare_gaps(pack: int, sfile: src.SourceFile, gaps &: Vector<int>):
    quiet := lg.New(lg.LOG_OFF, false)
    mut toks := tok.StreamNew(sfile.path)
    if lx.Run(quiet, pack, sfile, toks):
        mut a := at.NewAst()
        mut prog := 0
        if ps.Run(quiet, toks, a, prog):
            n := at.Count(a)
            mut i := 1
            until i < n:
                nd := at.Get(a, i)
                if nd.kind == at.AST_BINARY and nd.op >= tok.TK_EQ and nd.op <= tok.TK_GE and nd.a != 0 and nd.b != 0:
                    gaps.push(at.Get(a, nd.a).end_index as int)
                    gaps.push(at.Get(a, nd.b).begin_index as int)
                end
                i += 1
            end
        end
        at.FreeAst(a)
    end
    tok.StreamFree(toks)
end

func tr_in_gap(gaps: Vector<int>, at_index: int): bool:
    mut i := 0
    until i + 1 < gaps.len():
        if at_index >= gaps.get(i) and at_index < gaps.get(i + 1):
            ret true
        end
        i += 2
    end
    ret false
end

func tr_is_space(text: str, i: int, n: int): bool:
    if i < 0 or i >= n:
        ret true
    end
    c := str.Substr(text, i, 1)
    ret str.Equals(c, " ") or str.Equals(c, "\t") or str.Equals(c, "\n") or str.Equals(c, "\r")
end

func tr_css_value_en(attr: str, raw: str): str:
    n := str.Len(raw)
    mut inner := ""
    if n >= 4 and str.StartsWith(raw, "«") and str.EndsWith(raw, "»"):
        inner = str.Substr(raw, 2, n - 4)
    else n >= 2 and co.ByteAt(raw, 0) == 34 and co.ByteAt(raw, n - 1) == 34 and str.IndexOf(raw, "\\") < 0:
        inner = str.Substr(raw, 1, n - 2)
    else:
        ret ""
    end
    mapped := sm.LayoutCssValueEn(attr, inner)
    ret str.Equals(mapped, inner) ? "" : mapped
end

func translate_source(lgr: lg.Logger, srcpack: int, targetpack: int, std_root: str, sfile: src.SourceFile, out &: str): bool:
    mut toks := tok.StreamNew(sfile.path)
    ok := lx.RunSplit(lgr, srcpack, sfile, true, true, toks)
    if not ok:
        tok.StreamFree(toks)
        ret false
    end
    src_entry := lp.Entry(srcpack)
    tgt_entry := lp.Entry(targetpack)
    text := sfile.text
    n := tok.StreamCount(toks)
    mut sb := co.SbNew()
    mut cursor := 0
    mut prev_kind := 0 - 1
    mut expect_entry := false
    mut pending_recv := 0 - 1
    mut member_pkg := 0 - 1
    mut in_import := false
    mut imp_path := ""
    from_fa := targetpack != lp.LP_FA
    mut angle_depth := 0
    mut alias_rhs := false
    mut css_attr := ""
    names := tr_declared_names(toks, n)
    defer names.free()
    comp_names := tr_component_names(toks, n)
    defer comp_names.free()
    pkgs := tr_imported_packages(toks, n)
    defer pkgs.free()
    mut aliases := Vector {} as Vector<str>
    defer aliases.free()
    mut alias_pkg := Vector {} as Vector<int>
    defer alias_pkg.free()
    each ip in pkgs:
        aliases.push(tr_last_seg(ip))
        alias_pkg.push(tr_pkg_find(std_root, ip, from_fa))
    end
    mut var_names := Vector {} as Vector<str>
    defer var_names.free()
    mut var_pkgs := Vector {} as Vector<int>
    defer var_pkgs.free()
    tr_var_packages(toks, n, aliases, alias_pkg, var_names, var_pkgs)
    mut prev_ident := ""
    mut dot_var := ""
    mut gaps := Vector {} as Vector<int>
    defer gaps.free()
    tr_compare_gaps(srcpack, sfile, gaps)
    mut i := 0
    until i < n:
        t := tok.StreamAt(toks, i)
        if t.kind == tok.TK_EOF:
            break
        end
        bi := t.begin_index as int
        mut ei := t.end_index as int
        if bi > cursor:
            co.SbPuts(sb, str.Substr(text, cursor, bi - cursor))
        end
        mut lexeme := t.lexeme
        mut skip_emit := false
        recv_prev := pending_recv
        pending_recv = 0 - 1
        mut recv_count := 0
        mut recv_a := 0 - 1
        mut kw_j := i
        mut dot_member := ""
        if prev_kind == tok.TK_DOT and tr_word_kind(t.kind) and (t.kind == tok.TK_IDENT or from_fa):
            dot_member = tr_resolve_member(std_root, targetpack, toks, i, n, from_fa, member_pkg, tr_var_package(var_names, var_pkgs, dot_var), alias_pkg, tr_has(names, t.lexeme), kw_j)
        end
        if t.kind == tok.TK_IDENT and not in_import and prev_kind != tok.TK_DOT and not tr_has(names, t.lexeme):
            recv_a = tr_alias_words(toks, i, n, aliases, recv_count)
        end
        if t.kind == tok.TK_STMT_END:
            if ei > bi:
                lexeme = str.Substr(text, bi, ei - bi)
            else:
                skip_emit = true
            end
        else t.kind == tok.TK_STRING and targetpack != lp.LP_FA and prev_kind == tok.TK_ASSIGN and str.Len(css_attr) > 0 and str.Len(tr_css_value_en(css_attr, str.Substr(text, bi, ei - bi))) > 0:
            lexeme = `"` + str.Replace(tr_css_value_en(css_attr, str.Substr(text, bi, ei - bi)), `"`, `\"`) + `"`
        else t.kind == tok.TK_STRING and targetpack != lp.LP_FA and str.StartsWith(t.lexeme, "«") and str.EndsWith(t.lexeme, "»"):
            inner := str.Substr(t.lexeme, 2, str.Len(t.lexeme) - 4)
            lexeme = `"` + str.Replace(inner, `"`, `\"`) + `"`
        else (t.kind == tok.TK_LAYOUT_ELEMENT or t.kind == tok.TK_LAYOUT_ATTR_NAME) and not tr_has_ident(comp_names, t.lexeme):
            want_fa := targetpack == lp.LP_FA
            mapped := t.kind == tok.TK_LAYOUT_ELEMENT ? sm.LayoutElemSpelling(t.lexeme, want_fa) : sm.LayoutAttrSpelling(t.lexeme, want_fa)
            if str.Len(mapped) > 0:
                raw_name := str.Substr(text, bi, ei - bi)
                mut tail := ""
                mut k := str.Len(raw_name)
                until k > 0 and (co.ByteAt(raw_name, k - 1) == 32 or co.ByteAt(raw_name, k - 1) == 9):
                    k -= 1
                end
                if k < str.Len(raw_name):
                    tail = str.Substr(raw_name, k, str.Len(raw_name) - k)
                end
                lexeme = mapped + tail
            end
        else t.kind == tok.TK_META:
            mapped := tr_ctx_word(targetpack, t.lexeme)
            lexeme = "@" + (str.Len(mapped) > 0 ? mapped : t.lexeme)
        else t.kind == tok.TK_IDENT and in_import:
            mut words := t.lexeme
            mut j := i
            until j + 1 < n and tok.StreamAt(toks, j + 1).kind == tok.TK_IDENT and tok.StreamAt(toks, j + 1).begin_line == t.begin_line:
                j += 1
                words = words + " " + tok.StreamAt(toks, j).lexeme
            end
            imp_path = str.Len(imp_path) > 0 ? imp_path + "." + words : words
            ei = tok.StreamAt(toks, j).end_index as int
            i = j
            idx := tr_pkg_find(std_root, imp_path, from_fa)
            lexeme = idx >= 0 ? tr_pkg_target_alias(idx, targetpack) : str.Substr(text, bi, ei - bi)
        else t.kind == tok.TK_IDENT and recv_a >= 0 and alias_pkg.get(recv_a) >= 0:
            last := i + recv_count - 1
            ei = tok.StreamAt(toks, last).end_index as int
            i = last
            lexeme = tr_pkg_target_alias(alias_pkg.get(recv_a), targetpack)
            pending_recv = alias_pkg.get(recv_a)
        else from_fa and prev_kind == tok.TK_DOT and t.kind != tok.TK_IDENT and str.Len(dot_member) > 0:
            lexeme = dot_member
            ei = tok.StreamAt(toks, kw_j).end_index as int
            i = kw_j
        else t.kind == tok.TK_IDENT and prev_kind != tok.TK_DOT and tr_next_is_call(toks, i, n) and not tr_has(names, t.lexeme) and str.Len(tr_builtin_word(targetpack, t.lexeme)) > 0:
            lexeme = tr_builtin_word(targetpack, t.lexeme)
        else t.kind == tok.TK_IDENT and i + 1 < n and tr_ctx_word_here(targetpack, t.lexeme, prev_kind, tok.StreamAt(toks, i + 1).kind):
            lexeme = tr_ctx_word(targetpack, t.lexeme)
        else t.kind == tok.TK_IDENT and i + 1 < n and prev_kind != tok.TK_IDENT and prev_kind != tok.TK_DOT and tok.StreamAt(toks, i + 1).kind == tok.TK_IDENT and (str.Equals(t.lexeme, "dyn") or str.Equals(t.lexeme, "پویا")):
            lexeme = targetpack == lp.LP_FA ? "پویا" : "dyn"
        else t.kind == tok.TK_NOT and (prev_kind == tok.TK_DOT or prev_kind == tok.TK_IDENT):
            lexeme = t.lexeme
        else tok.IsKeyword(t.kind) or t.kind == tok.TK_AND or t.kind == tok.TK_OR or t.kind == tok.TK_NOT:
            spelled := tr_keyword_spelling(targetpack, t.kind)
            if str.Len(spelled) > 0:
                lexeme = spelled
            end
        else t.kind == tok.TK_COMMA:
            lexeme = targetpack == lp.LP_FA ? "\xD8\x8C" : ","
        else t.kind >= tok.TK_EQ and t.kind <= tok.TK_GE:
            sym := compare_symbol(t.kind)
            if targetpack != lp.LP_FA or t.layout_mode:
                lexeme = sym
            else not str.Equals(t.lexeme, sym) or tr_in_gap(gaps, bi):
                lexeme = lp.Spelling(targetpack, t.kind)
                if not tr_is_space(text, bi - 1, sfile.len):
                    lexeme = " " + lexeme
                end
                if not tr_is_space(text, ei, sfile.len):
                    lexeme = lexeme + " "
                end
            end
        else t.kind == tok.TK_IDENT:
            if expect_entry and str.Equals(t.lexeme, src_entry):
                lexeme = tgt_entry
            else:
                mut type_mapped := ""
                if prev_kind == tok.TK_DOT and tr_next_kind(toks, i, n) == tok.TK_LT:
                    type_mapped = tr_type_word(targetpack, t.lexeme)
                else prev_kind != tok.TK_DOT and not tr_is_decl_name(toks, i, n, prev_kind) and not ((prev_kind == tok.TK_LBRACE or prev_kind == tok.TK_COMMA) and tr_next_kind(toks, i, n) == tok.TK_ASSIGN):
                    type_pos := (prev_kind == tok.TK_COLON and tr_prev_same_line(toks, i)) or (prev_kind == tok.TK_ASSIGN and alias_rhs) or prev_kind == tok.TK_KW_AS or prev_kind == tok.TK_KW_ON or prev_kind == tok.TK_LT or (prev_kind == tok.TK_COMMA and angle_depth > 0) or tr_next_kind(toks, i, n) == tok.TK_LBRACE
                    if type_pos or not tr_has(names, t.lexeme):
                        type_mapped = tr_type_word(targetpack, t.lexeme)
                    end
                end
                if str.Len(type_mapped) > 0:
                    lexeme = type_mapped
                else prev_kind == tok.TK_DOT:
                    sym_mapped := dot_member
                    best_j := kw_j
                    if str.Len(sym_mapped) > 0:
                        lexeme = sym_mapped
                        if best_j > i:
                            ei = tok.StreamAt(toks, best_j).end_index as int
                            i = best_j
                        end
                    end
                end
            end
        end
        if not skip_emit:
            co.SbPuts(sb, lexeme)
        end
        expect_entry = t.kind == tok.TK_KW_FUNC
        if t.kind == tok.TK_DOT:
            member_pkg = recv_prev
            dot_var = prev_kind == tok.TK_IDENT ? prev_ident : ""
        else t.kind != tok.TK_COMMENT_LINE and t.kind != tok.TK_COMMENT_BLOCK:
            member_pkg = 0 - 1
        end
        if t.kind == tok.TK_IDENT:
            prev_ident = t.lexeme
        end
        if t.kind == tok.TK_KW_IMPORT:
            in_import = true
            imp_path = ""
        else t.kind == tok.TK_STMT_END:
            in_import = false
        end
        if t.kind == tok.TK_KW_TYPE:
            alias_rhs = true
        else t.kind == tok.TK_STMT_END:
            alias_rhs = false
        end
        if t.kind == tok.TK_LT and prev_kind == tok.TK_IDENT:
            angle_depth += 1
        else t.kind == tok.TK_GT and angle_depth > 0:
            angle_depth -= 1
        end
        if t.kind == tok.TK_LAYOUT_ATTR_NAME:
            css_attr = t.lexeme
        else t.kind != tok.TK_ASSIGN and t.kind != tok.TK_COMMENT_LINE and t.kind != tok.TK_COMMENT_BLOCK:
            css_attr = ""
        end
        if t.kind != tok.TK_COMMENT_LINE and t.kind != tok.TK_COMMENT_BLOCK:
            prev_kind = t.kind
        end
        cursor = ei
        i += 1
    end
    if cursor < sfile.len:
        co.SbPuts(sb, str.Substr(text, cursor, sfile.len - cursor))
    end
    out = co.SbCstr(sb)
    co.SbFree(sb)
    tok.StreamFree(toks)
    ret true
end

func tr_ensure_dir(path: str):
    dir := pth.PathDir(path)
    if str.Len(dir) > 0:
        os.MkdirAll(dir)
    end
end

func translate_one_file(c &: TrCtx, src_path: str, dst_path: str):
    mut sfile := src.New()
    if not src.Load(src_path, sfile):
        io.EPrintln(co.Format1(i18.Tr("cannot read source file '%s'"), co.ArgStr(src_path)))
        c.errors += 1
        ret
    end
    c.total += 1
    srcpack := lx.Detect(sfile, c.fallback)
    tr_ensure_dir(dst_path)
    if srcpack == c.target:
        if not str.Equals(src_path, dst_path):
            wrc := os.WriteFile(dst_path, sfile.text)
            if wrc < 0:
                io.EPrintln(co.Format1(i18.Tr("cannot write '%s'"), co.ArgStr(dst_path)))
                c.errors += 1
                ret
            end
        end
        c.ok += 1
        ret
    end
    lgr := lg.New(lg.LOG_OFF, false)
    mut translated := ""
    if not translate_source(lgr, srcpack, c.target, c.stdlib_root, sfile, translated):
        io.EPrintln(
            co.Format1(i18.Tr("cannot translate '%s': fix the lexical errors first"), co.ArgStr(src_path))
        )
        c.errors += 1
        ret
    end
    final_text := tr_apply_marker(translated, lp.Code(c.target))
    wrc := os.WriteFile(dst_path, final_text)
    if wrc < 0:
        io.EPrintln(co.Format1(i18.Tr("cannot write '%s'"), co.ArgStr(dst_path)))
        c.errors += 1
        ret
    end
    c.changed += 1
    println co.Format2(i18.Tr("translated %s -> %s"), co.ArgStr(src_path), co.ArgStr(dst_path))
end

func translate_walk(c &: TrCtx, src_dir: str, dst_dir: str):
    entries := os.ListDir(src_dir)
    defer entries.free()
    os.MkdirAll(dst_dir)
    repeat entries.len() in i:
        name := entries.get(i)
        if str.StartsWith(name, "."):
            continue
        end
        schild := pth.PathJoin(src_dir, name)
        dchild := pth.PathJoin(dst_dir, name)
        if os.IsDir(schild):
            translate_walk(c, schild, dchild)
        else has_salam_ext(name):
            translate_one_file(c, schild, dchild)
        else:
            if not str.Equals(schild, dchild):
                os.Copy(schild, dchild)
            end
        end
    end
end

func tr_default_output_dir(path: str, target_code: str): str:
    ret pth.PathTrimSep(path) + "-" + target_code
end

func tr_default_output_file(path: str, target_code: str): str:
    dir := pth.PathDir(path)
    stem := pth.PathStem(pth.PathBase(path))
    name := stem + "." + target_code + ".salam"
    ret pth.PathJoin(dir, name)
end

func translate_target_path(opt &: dr.Dr, p: str, single_input: bool): str:
    if opt.translate_rewrite:
        ret p
    end
    if str.Len(opt.output) > 0:
        if single_input:
            ret opt.output
        end
        ret pth.PathJoin(opt.output, pth.PathBase(pth.PathTrimSep(p)))
    end
    if os.IsDir(p):
        ret tr_default_output_dir(p, opt.translate_lang)
    end
    ret tr_default_output_file(p, opt.translate_lang)
end

func translate_cmd(opt &: dr.Dr): int:
    if str.Len(opt.translate_lang) == 0:
        io.EPrintln(i18.Tr("salam: 'translate' requires a target language ('en' or 'fa')"))
        ret 2
    end
    target := lp.Load(opt.translate_lang)
    if target == lp.LP_NONE:
        io.EPrintln(co.Format1(i18.Tr("unknown language pack '%s'"), co.ArgStr(opt.translate_lang)))
        ret 2
    end
    fallback := lp.Load(opt.lang)
    if fallback == lp.LP_NONE:
        io.EPrintln(co.Format1(i18.Tr("unknown language pack '%s'"), co.ArgStr(opt.lang)))
        ret 2
    end
    mut default_inputs := Vector {} as Vector<str>
    defer default_inputs.free()
    mut inputs := opt.inputs
    if inputs.len() == 0:
        default_inputs.push(".")
        inputs = default_inputs
    end
    mut c := TrCtx {}
    c.target = target
    c.fallback = fallback
    c.rewrite = opt.translate_rewrite
    c.stdlib_root = str.Len(opt.stdlib_path) > 0 ? opt.stdlib_path : "std"
    if str.Len(opt.stdlib_path) == 0 and not os.IsDir("std"):
        sroot := sm.GetStdlibRoot()
        if str.Len(sroot) > 0 and os.IsDir(sroot + "/std"):
            c.stdlib_root = sroot + "/std"
        end
    end
    single_input := inputs.len() == 1
    repeat inputs.len() in idx:
        p := inputs.get(idx)
        outp := translate_target_path(opt, p, single_input)
        if os.IsDir(p):
            translate_walk(c, p, outp)
        else has_salam_ext(p):
            translate_one_file(c, p, outp)
        else:
            tr_ensure_dir(outp)
            if not str.Equals(p, outp):
                os.Copy(p, outp)
            end
        end
    end
    println co.Format4(
        i18.Tr("translate: %d translated, %d unchanged, %d error%s"), co.ArgInt(c.changed as i64), co.ArgInt(c.ok as i64), co.ArgInt(c.errors as i64), co.ArgStr(plural_suffix(c.errors))
    )
    mut rc := 0
    if c.errors > 0:
        rc = 2
    end
    ret rc
end
