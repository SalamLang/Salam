// Flat merge of the salam/codegen port (see salam/PORTING.md "Layout - FLAT"):
// compiler/src/codegen/ - one package `codegen`, one file. Import alias for
// consumers: `cg`. The module's expr/stmt emitters are mutually recursive
// with everything else, so the module is ported by two sequential agents
// INTO THIS ONE FILE:
//
//   6a (DONE): codegen.c (run/orchestration), codegen_emit.c (emit context),
//       codegen_type.c (type -> C emission, mangling), codegen_header.c
//       (the generated .h; dyn vtables), codegen_decl.c (signatures,
//       extern protos, cg_function), print_fmt.c, plus sig_of_decl from
//       codegen_overload.c (header emission needs it - 6b: do NOT re-port).
//   6b (DONE): codegen_expr.c, codegen_stmt.c, codegen_call.c,
//       codegen_lambda.c, the rest of codegen_overload.c - the former
//       stubs are replaced in place in the "6b" section below.
//
// C -> Salam decisions for this module (6b must inherit these):
// - cg_t -> `pub struct Cg` (all fields pub - E017). Pointer/struct fields
//   become indices: cur_struct: SymId, cur_fn_home: ScopeId, cur_lambda:
//   at.NodeId; "" = the C NULL for every str field (module/pkg/entry/
//   src_path/target_triple/match_result_tmp/match_end_label).
// - arena_t* and cg_fmt(...) are GONE: strings are values; call sites build
//   text with `+` / co.Format* instead of printf-style formats.
// - sema_result_t* cg->sem is NOT stored in Cg: thread `s &: sm.Sema`
//   (and `a &: at.Ast` for tree access) through every function, exactly
//   like the semantic port threads the Ast. Parameter order: (g, s, a, ...).
// - sb_t *h / *c / *lam_decls / *lam_defs -> four str.StringBuilder fields
//   bh / bc / blamd / blamf plus a `cur` sink selector (CG_OUT_*). The C
//   pointer swap `savec = cg->c; cg->c = cg->h;` becomes
//   `save := g.cur; g.cur = CG_OUT_H; ...; g.cur = save`. Every
//   sb_puts(cg->c, ...) is out(g, ...) (current sink); sb_puts(cg->h/h, ...)
//   is outh(g, ...) (always the header). 6b's lambda lifting must write
//   lam decls/defs the same way (out with g.cur = CG_OUT_LAMD / _LAMF, or
//   outb directly).
// - vec_t locals/deferred/vec_types/variant_types/dyn_ifaces/dyn_impls ->
//   Vector<str>; fn_defers -> Vector<int> (at.NodeIds of AST_DEFER stmts).
// - type_t* parameter lists (mangling, signatures) -> Vector<int> of
//   sm TypeIds; type_to_string -> sm.ToString.
// - The C's fixed char buffers keep their clamps where observable
//   (iface[96], variant members [64][160], parse_typestr base cap,
//   cg_vec_elem 96, dyn impl pair 256): giant nested types truncate
//   identically.
// - Known C bugs are ported bug-for-bug: hdr_globals emits `extern const`
//   for a non-mut package global while emit_globals defines it non-const
//   (the PORTING.md extern-const array bug), hdr_enums emits plain
//   `typedef enum` names that collide across packages, dyn_collect happily
//   records non-interface names like "Shape[1]" (filtered later by symbol
//   kind), and parse_typestr only strips ONE trailing '*'.
package codegen

import str
import co "sal_core.salam"
import tok "token.salam"
import at "ast.salam"
import lg "logger.salam"
import i18 "i18n.salam"
import sm "semantic.salam"

// ===== codegen.h =====
// #define SALAM_MOD_PREFIX / SALAM_MEM_* (names are repo-unique: flat C
// global namespace, see PORTING.md).
pub const CG_MOD_PREFIX := "salam_mod_"
pub const CG_MEM_ALLOC := "_Salam_mem_Allocate_u64"
pub const CG_MEM_REALLOC := "_Salam_mem_Reallocate_void_ptr_u64"
pub const CG_MEM_FREE := "_Salam_mem_Free_void_ptr"

// ===== print_fmt.h =====
// pf_kind_t - order and values MUST stay identical to the C enum.
pub const PF_LIT := 0
pub const PF_STR := 1
pub const PF_I32 := 2
pub const PF_U32 := 3
pub const PF_I64 := 4
pub const PF_U64 := 5
pub const PF_SIZE := 6
pub const PF_F64 := 7
pub const PF_BOOL := 8
pub const PF_CHAR := 9

// Output sink selector for Cg.cur (replaces the C sb_t* cg->c swaps).
pub const CG_OUT_C := 0
pub const CG_OUT_H := 1
pub const CG_OUT_LAMD := 2
pub const CG_OUT_LAMF := 3

const K_CG_CKW_COUNT := 48
const K_CG_BASE_COUNT := 17

// cg_is_c_keyword's kw[] (codegen_type.c), order kept.
k_cg_ckw := [
    "auto", "break", "case", "char", "const", "continue", "default", "do", "double", "else", "enum",
    "extern", "float", "for", "goto", "if", "inline", "int", "long", "register", "restrict", "return",
    "short", "signed", "sizeof", "static", "struct", "switch", "typedef", "union", "unsigned", "void",
    "volatile", "while", "asm", "bool", "true", "false", "_Bool", "_Complex", "_Imaginary", "_Alignas",
    "_Alignof", "_Atomic", "_Generic", "_Noreturn", "_Static_assert", "_Thread_local"
] as str[48]

// base_ctype's m[] as two parallel arrays (order kept).
k_cg_base_s := [
    "void", "bool", "char", "str", "uchar", "i8", "i16", "i32", "i64", "u8", "u16", "u32", "u64", "size",
    "f32", "f64", "File"
] as str[17]

k_cg_base_c := [
    "void", "bool", "char", "const char*", "const char*", "int8_t", "int16_t", "int32_t", "int64_t",
    "uint8_t", "uint16_t", "uint32_t", "uint64_t", "size_t", "float", "double", "salam_file"
] as str[17]

// g_cg_export_{pkg,from,to} - --export=Fn:CName overrides (driver.salam
// populates via AddExportOverride while scanning each module's own AST, so
// pkg is always that function's OWN defining package). Keyed by (pkg, fn):
// name-only would rename every same-named free function this build
// transitively pulls in (e.g. llvm.salam's own Emit() vs. sal_web.salam's).
mut g_cg_export_pkg := Vector {} as Vector<str>
mut g_cg_export_from := Vector {} as Vector<str>
mut g_cg_export_to := Vector {} as Vector<str>

// ===== codegen.h =====
// codegen_output_t. C field `module` -> module_name (kept obvious).
pub struct Output:
    pub module_name: str = ""
    pub h_src: str = ""
    pub c_src: str = ""
end

// ===== print_fmt.h =====
// pf_seg_t. `expr` is an at.NodeId (0 = none); `text` "" = the C NULL.
pub struct PfSeg:
    pub kind: int = 0
    pub text: str = ""
    pub expr: int = 0
end

// ===== codegen_internal.h =====
// cg_t (see the file header for every representation change).
pub struct Cg:
    pub log: lg.Logger = lg.New(2, false)
    pub module: str = ""
    pub bh: str.StringBuilder = str.NewBuilder() // sb_t *h
    pub bc: str.StringBuilder = str.NewBuilder() // sb_t *c
    pub blamd: str.StringBuilder = str.NewBuilder() // sb_t *lam_decls
    pub blamf: str.StringBuilder = str.NewBuilder() // sb_t *lam_defs
    pub cur: int = 0 // current sink (CG_OUT_*), replaces cg->c swaps
    pub indent: int = 0
    pub locals: Vector<str> = Vector {}
    pub cur_struct: int = 0 // SymId (0 = C NULL)
    pub cur_fn_home: int = 0 // ScopeId (0 = C NULL)
    pub safe: bool = false
    pub debug_info: bool = false
    pub single_threaded: bool = false
    pub src_path: str = ""
    pub tmpn: int = 0
    pub cur_sret: bool = false
    pub vec_types: Vector<str> = Vector {}
    pub variant_types: Vector<str> = Vector {}
    pub dyn_ifaces: Vector<str> = Vector {}
    pub dyn_impls: Vector<str> = Vector {}
    pub pkg: str = ""
    pub entry: str = ""
    pub deferred: Vector<str> = Vector {}
    pub fn_defers: Vector<int> = Vector {} // at.NodeIds (6b: AST_DEFER stmts)
    pub lam_n: int = 0
    pub clos_n: int = 0
    pub cur_lambda: int = 0 // at.NodeId (0 = C NULL)
    pub is_gui_mode: bool = false
    pub target_triple: str = ""
    pub match_result_tmp: str = ""
    pub match_end_label: str = ""
    pub compact: bool = false
end

// cg_export_override - "" if (pkg, fname) has no registered override.
func cg_export_override(pkg: str, fname: str): str:
    repeat g_cg_export_from.len() with i:
        if str.Equals(g_cg_export_pkg.get(i)[0], pkg) && str.Equals(g_cg_export_from.get(i)[0], fname):
            ret g_cg_export_to.get(i)[0]
        end
    end
    ret ""
end

// ---------------------------------------------------------------------------
// Low-level shared helpers (no direct C equivalent).
// ---------------------------------------------------------------------------

// Unsigned byte read from a str (same idiom as the other ports).
func byte_at(s: str, i: int): int:
    bp := (s as void*) as i8*
    mut v := bp[i] as int
    if v < 0:
        v += 256
    end
    ret v
end

// isdigit / isalnum on a byte (C default locale: ASCII only).
func is_digit_b(c: int): bool:
    ret c >= 48 && c <= 57
end

func is_alnum_b(c: int): bool:
    ret (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122)
end

// &node->span as a co.SrcSpan (nodes inline their span fields).
func span_of(a &: at.Ast, id: int): co.SrcSpan:
    n := at.Get(a, id)
    ret co.MakeSpan(
        co.MakePos(n.begin_line, n.begin_col, n.begin_index), co.MakePos(n.end_line, n.end_col, n.end_index),
        n.length
    )
end

// sb_puts(cg->c, s) - append to the CURRENT sink (see Cg.cur).
func out(g &: Cg, s: str):
    if g.cur == CG_OUT_H:
        str.BufAppend(g.bh, s)
    else g.cur == CG_OUT_LAMD:
        str.BufAppend(g.blamd, s)
    else g.cur == CG_OUT_LAMF:
        str.BufAppend(g.blamf, s)
    else:
        str.BufAppend(g.bc, s)
    end
end

// sb_putc(cg->c, ch)
func outc(g &: Cg, code: int):
    if g.cur == CG_OUT_H:
        str.BufAppendChar(g.bh, code)
    else g.cur == CG_OUT_LAMD:
        str.BufAppendChar(g.blamd, code)
    else g.cur == CG_OUT_LAMF:
        str.BufAppendChar(g.blamf, code)
    else:
        str.BufAppendChar(g.bc, code)
    end
end

// sb_puts(cg->h, s) / sb_puts(h, s) - always the header builder.
func outh(g &: Cg, s: str):
    str.BufAppend(g.bh, s)
end

// ===== codegen_emit.c =====
// cg_fmt is gone (see file header). cg_indent/cg_line keep their names;
// cg_line takes pre-formatted text.

func cg_indent(g &: Cg):
    if g.compact:
        ret
    end
    repeat g.indent:
        out(g, "    ")
    end
end

func cg_source_line(g &: Cg, sp: co.SrcSpan):
    if !g.debug_info || sp.begin.line == (0 as u32):
        ret
    end
    if str.Len(g.src_path) == 0:
        ret
    end
    // escaped[1024]: backslashes doubled, clamped like the C buffer.
    mut b := co.SbNew()
    n := str.Len(g.src_path)
    mut ei := 0
    mut i := 0
    until i < n && ei < 1022:
        c := byte_at(g.src_path, i)
        if c == 92:
            co.SbPutc(b, 92)
            ei += 1
        end
        co.SbPutc(b, c)
        ei += 1
        i += 1
    end
    esc := co.SbCstr(b)
    co.SbFree(b)
    out(g, "#line " + co.U64Toa(sp.begin.line as u64) + " \"" + esc + "\"\n")
end

func cg_line(g &: Cg, text: str):
    cg_indent(g)
    out(g, text)
    outc(g, g.compact ? 32 : 10)
end

func local_known(g &: Cg, name: str): bool:
    repeat g.locals.len() with i:
        if str.Equals(g.locals.get(i)[0], name):
            ret true
        end
    end
    ret false
end

func local_add(g &: Cg, name: str):
    g.locals.push(name)
end

// ===== codegen_type.c =====

// cg_kv - split "Map<K, V>"-style typestrs; cap mirrors the C buffer size.
func cg_kv(ts: str, kbuf &: str, vbuf &: str, cap: int):
    kbuf = ""
    vbuf = ""
    lt := str.IndexOf(ts, "<")
    if lt < 0:
        ret
    end
    comma := str.IndexFrom(ts, ",", lt)
    gt := str.LastIndex(ts, ">")
    if comma < 0 || gt < 0:
        ret
    end
    mut ks := lt + 1
    until ks < str.Len(ts) && byte_at(ts, ks) == 32:
        ks += 1
    end
    mut ke := comma
    until ke > ks && byte_at(ts, ke - 1) == 32:
        ke -= 1
    end
    mut vs := comma + 1
    until vs < str.Len(ts) && byte_at(ts, vs) == 32:
        vs += 1
    end
    mut ve := gt
    until ve > vs && byte_at(ts, ve - 1) == 32:
        ve -= 1
    end
    mut kl := ke - ks
    if kl >= cap:
        kl = cap - 1
    end
    kbuf = str.Substr(ts, ks, kl)
    mut vl := ve - vs
    if vl >= cap:
        vl = cap - 1
    end
    vbuf = str.Substr(ts, vs, vl)
end

func cg_put_ident_byte(b &: str.StringBuilder, c: int):
    if is_alnum_b(c):
        co.SbPutc(b, c)
    else c == 95:
        co.SbPuts(b, "__")
    else:
        co.SbPutc(b, 95)
        hi := (c >> 4) & 15
        lo := c & 15
        co.SbPutc(b, hi < 10 ? 48 + hi : 87 + hi)
        co.SbPutc(b, lo < 10 ? 48 + lo : 87 + lo)
    end
end

func cg_is_c_keyword(s: str): bool:
    repeat K_CG_CKW_COUNT with i:
        if str.Equals(s, k_cg_ckw[i]):
            ret true
        end
    end
    ret false
end

func cg_cident(name: str): str:
    if str.Len(name) == 0:
        ret "_"
    end
    n := str.Len(name)
    mut ok := !is_digit_b(byte_at(name, 0))
    mut i := 0
    until ok && i < n:
        if !is_alnum_b(byte_at(name, i)):
            ok = false
        end
        i += 1
    end
    if ok:
        if cg_is_c_keyword(name):
            ret name + "_"
        end
        ret name
    end
    mut b := co.SbNew()
    if is_digit_b(byte_at(name, 0)):
        co.SbPutc(b, 95)
    end
    mut j := 0
    until j < n:
        cg_put_ident_byte(b, byte_at(name, j))
        j += 1
    end
    r := co.SbCstr(b)
    co.SbFree(b)
    ret r
end

// base_ctype - `found` mirrors the C's pointer-identity check (bc == base).
func base_ctype(base: str, found &: bool): str:
    repeat K_CG_BASE_COUNT with i:
        if str.Equals(base, k_cg_base_s[i]):
            found = true
            ret k_cg_base_c[i]
        end
    end
    found = false
    ret base
end

// parse_typestr - cap mirrors the caller's base[] buffer size.
// Bug-compat: only ONE trailing '*' is stripped; the ']' search is
// unbounded (strchr) while the '[' walk is bounded by the star-stripped len.
func parse_typestr(
    ts: str, cap: int, base &: str, ptr &: bool, dims &: Vector<int>
):
    ptr = false
    dims.clear()
    tslen := str.Len(ts)
    mut n := tslen
    if n > 0 && byte_at(ts, n - 1) == 42:
        ptr = true
        n -= 1
    end
    mut lb := 0 - 1
    mut i := 0
    until i < n:
        if byte_at(ts, i) == 91:
            lb = i
            break
        end
        i += 1
    end
    mut blen := n
    if lb >= 0:
        blen = lb
        mut p := lb
        until p < n && byte_at(ts, p) == 91:
            mut rb := 0 - 1
            mut q := p + 1
            until q < tslen:
                if byte_at(ts, q) == 93:
                    rb = q
                    break
                end
                q += 1
            end
            if rb < 0:
                break
            end
            mut d := 0
            mut q2 := p + 1
            until q2 < rb:
                c := byte_at(ts, q2)
                if c >= 48 && c <= 57:
                    d = d * 10 + (c - 48)
                end
                q2 += 1
            end
            dims.push(d)
            p = rb + 1
        end
    end
    if blen >= cap:
        blen = cap - 1
    end
    base = str.Substr(ts, 0, blen)
end

func cg_is_int_typestr(ts: str): bool:
    ret str.Equals(ts, "i8") || str.Equals(ts, "i16") || str.Equals(ts, "i32") || str.Equals(ts, "i64") || str.Equals(ts, "u8") || str.Equals(ts, "u16") || str.Equals(ts, "u32") || str.Equals(ts, "u64") || str.Equals(ts, "size")
end

func cg_is_unsigned_typestr(ts: str): bool:
    ret str.Equals(ts, "u8") || str.Equals(ts, "u16") || str.Equals(ts, "u32") || str.Equals(ts, "u64") || str.Equals(ts, "size")
end

// cg_vec_elem - elem of "Vector<T>" (cap mirrors the C ebuf).
func cg_vec_elem(ts: str, cap: int): str:
    lt := str.IndexOf(ts, "<")
    gt := str.LastIndex(ts, ">")
    if lt < 0 || gt < 0 || gt <= lt:
        ret ""
    end
    mut es := lt + 1
    until es < str.Len(ts) && byte_at(ts, es) == 32:
        es += 1
    end
    mut ee := gt
    until ee > es && byte_at(ts, ee - 1) == 32:
        ee -= 1
    end
    mut el := ee - es
    if el >= cap:
        el = cap - 1
    end
    ret str.Substr(ts, es, el)
end

func cg_encode_typestr(b &: str.StringBuilder, s: str, skip_spaces: bool):
    n := str.Len(s)
    mut i := 0
    until i < n:
        c := byte_at(s, i)
        if c == 42:
            co.SbPuts(b, "_ptr")
        else c == 91:
            co.SbPuts(b, "_arr")
        else:
            // ']' is dropped; so is ' ' when skip_spaces.
            if c != 93 && !(c == 32 && skip_spaces):
                cg_put_ident_byte(b, c)
            end
        end
        i += 1
    end
end

func cg_vec_code_str(elem: str): str:
    mut b := co.SbNew()
    cg_encode_typestr(b, elem, true)
    r := co.SbCstr(b)
    co.SbFree(b)
    ret r
end

func cg_vec_cname(ts: str): str:
    ret "Vector_" + cg_vec_code_str(cg_vec_elem(ts, 96))
end

// cg_variant_push_trimmed - [64][160] clamps kept.
func variant_push_trimmed(ts: str, s0: int, e0: int, out2 &: Vector<str>):
    mut s := s0
    mut e := e0
    until s < e && byte_at(ts, s) == 32:
        s += 1
    end
    until e > s && byte_at(ts, e - 1) == 32:
        e -= 1
    end
    if out2.len() >= 64:
        ret
    end
    mut l := e - s
    if l >= 160:
        l = 159
    end
    out2.push(str.Substr(ts, s, l))
end

// cg_variant_members - the caller frees the returned vector.
func cg_variant_members(ts: str): Vector<str>:
    mut mv := Vector {} as Vector<str>
    lt := str.IndexOf(ts, "<")
    gt := str.LastIndex(ts, ">")
    if lt < 0 || gt < 0 || gt <= lt:
        ret mv
    end
    mut start := lt + 1
    mut depth := 0
    mut p := start
    until p < gt:
        c := byte_at(ts, p)
        if c == 60:
            depth += 1
        else c == 62:
            depth -= 1
        else c == 44 && depth == 0:
            variant_push_trimmed(ts, start, p, mv)
            start = p + 1
        end
        p += 1
    end
    variant_push_trimmed(ts, start, gt, mv)
    ret mv
end

func cg_variant_cname(ts: str): str:
    mut members := cg_variant_members(ts)
    defer members.free()
    mut b := co.SbNew()
    co.SbPuts(b, "_Salam_variant")
    repeat members.len() with i:
        co.SbPutc(b, 95)
        co.SbPuts(b, cg_vec_code_str(members.get(i)[0]))
    end
    r := co.SbCstr(b)
    co.SbFree(b)
    ret r
end

func cg_variant_tag_of(variant_ts: str, member_ts: str): int:
    mut members := cg_variant_members(variant_ts)
    defer members.free()
    mut r := 0 - 1
    repeat members.len() with i:
        if r < 0 && str.Equals(members.get(i)[0], member_ts):
            r = i
        end
    end
    ret r
end

func cg_is_slice_ts(ts: str): bool:
    ret str.StartsWith(ts, "slice<")
end

func cg_slice_elem(ts: str, cap: int): str:
    ret cg_vec_elem(ts, cap)
end

// strpbrk(p, "[*") - index of the first '[' or '*' at/after `from`, -1 none.
func pbrk_arr_star(s: str, from: int): int:
    n := str.Len(s)
    mut i := from
    until i < n:
        c := byte_at(s, i)
        if c == 91 || c == 42:
            ret i
        end
        i += 1
    end
    ret 0 - 1
end

func cg_ctype(ts: str): str:
    if str.Len(ts) == 0:
        ret "void"
    end
    if cg_is_slice_ts(ts):
        ret "salam_slice"
    end
    if str.StartsWith(ts, "Variant<"):
        ret cg_variant_cname(ts)
    end
    if str.StartsWith(ts, "dyn "):
        suf := pbrk_arr_star(ts, 4)
        mut il := (suf >= 0 ? suf : str.Len(ts)) - 4
        if il >= 96:
            il = 95
        end
        iface := str.Substr(ts, 4, il)
        ret "_Salam_dyn_" + cg_cident(iface) + (suf >= 0 ? "*" : "")
    end
    if str.StartsWith(ts, "func(") || str.StartsWith(ts, "externfunc("):
        ret "void*"
    end
    mut base := ""
    mut ptr := false
    mut dims := Vector {} as Vector<int>
    defer dims.free()
    parse_typestr(ts, 96, base, ptr, dims)
    mut found := false
    mut bc := base_ctype(base, found)
    if !found:
        bc = cg_cident(base)
    end
    nd := dims.len()
    if nd > 0:
        ret bc + "*"
    end
    if ptr:
        ret bc + "*"
    end
    ret bc
end

func cg_decl(ts: str, name: str): str:
    if cg_is_slice_ts(ts):
        ret "salam_slice " + cg_cident(name)
    end
    if str.StartsWith(ts, "Variant<"):
        ret cg_variant_cname(ts) + " " + cg_cident(name)
    end
    if str.StartsWith(ts, "dyn "):
        suf := pbrk_arr_star(ts, 4)
        mut il := (suf >= 0 ? suf : str.Len(ts)) - 4
        if il >= 96:
            il = 95
        end
        iface := str.Substr(ts, 4, il)
        mut star := ""
        mut dstr := ""
        if suf >= 0 && byte_at(ts, suf) == 42:
            star = "*"
        end
        if suf >= 0 && byte_at(ts, suf) == 91:
            dstr = str.Substr(ts, suf, str.Len(ts) - suf)
        end
        ret "_Salam_dyn_" + cg_cident(iface) + star + " " + cg_cident(name) + dstr
    end
    if str.StartsWith(ts, "func(") || str.StartsWith(ts, "externfunc("):
        ret "void* " + cg_cident(name)
    end
    mut base := ""
    mut ptr := false
    mut dims := Vector {} as Vector<int>
    defer dims.free()
    parse_typestr(ts, 96, base, ptr, dims)
    mut found := false
    mut bc := base_ctype(base, found)
    if !found:
        bc = cg_cident(base)
    end
    cname := cg_cident(name)
    if dims.len() > 0:
        mut b := co.SbNew()
        co.SbPuts(b, bc)
        co.SbPutc(b, 32)
        co.SbPuts(b, cname)
        repeat dims.len() with i:
            co.SbPuts(b, "[" + dims.get(i)[0] + "]")
        end
        r := co.SbCstr(b)
        co.SbFree(b)
        ret r
    end
    if ptr:
        ret bc + "* " + cname
    end
    ret bc + " " + cname
end

// type_code - encoded type_to_string (spaces kept, unlike vec_code_str).
func type_code(s &: sm.Sema, t: int): str:
    ts := sm.ToString(s, t)
    mut b := co.SbNew()
    cg_encode_typestr(b, ts, false)
    r := co.SbCstr(b)
    co.SbFree(b)
    ret r
end

// cg_mangle_in - params are sm TypeIds. "" = the C NULL for pkg/sname.
func cg_mangle_in(
    s &: sm.Sema, pkg: str, sname: str, fname: str, params: Vector<int>
): str:
    if str.Len(sname) == 0:
        override := cg_export_override(pkg, fname)
        if str.Len(override) > 0:
            ret override
        end
    end
    mut b := co.SbNew()
    co.SbPuts(b, "_Salam_")
    co.SbPuts(b, cg_cident(str.Len(pkg) > 0 ? pkg : "main"))
    if str.Len(sname) > 0:
        co.SbPuts(b, "_S_")
        co.SbPuts(b, cg_cident(sname))
    end
    co.SbPutc(b, 95)
    co.SbPuts(b, cg_cident(fname))
    repeat params.len() with i:
        co.SbPutc(b, 95)
        co.SbPuts(b, type_code(s, params.get(i)[0]))
    end
    r := co.SbCstr(b)
    co.SbFree(b)
    ret r
end

func cg_mangle(
    g &: Cg, s &: sm.Sema, sname: str, fname: str, params: Vector<int>
): str:
    ret cg_mangle_in(s, g.pkg, sname, fname, params)
end

// cg_mangle_method - owner is a SymId (0 = C NULL), sname "" = C NULL.
func cg_mangle_method(
    g &: Cg, s &: sm.Sema, sname: str, owner: int, fname: str, params: Vector<int>
): str:
    osym := sm.SymAt(s, owner)
    inst := (owner != 0 && str.Len(osym.generic_base) > 0) || (owner == 0 && str.Len(sname) > 0)
    if inst:
        sn := str.Len(sname) > 0 ? sname : (owner != 0 ? osym.name : "")
        ret cg_mangle_in(s, "g", sn, fname, params)
    end
    sn2 := owner != 0 ? osym.name : sname
    pkg := (owner != 0 && str.Len(osym.pkgname) > 0) ? osym.pkgname : g.pkg
    ret cg_mangle_in(s, pkg, sn2, fname, params)
end

func cg_mangle_ti(
    s &: sm.Sema, typestr: str, fname: str, params: Vector<int>
): str:
    ret cg_mangle_in(s, "ti", typestr, fname, params)
end

func func_ret_of(ts: str): str:
    if !str.StartsWith(ts, "func("):
        ret "void"
    end
    n := str.Len(ts)
    mut p := 4
    mut d := 0
    until p < n:
        c := byte_at(ts, p)
        if c == 40:
            d += 1
        else c == 41:
            d -= 1
            if d == 0:
                p += 1
                break
            end
        end
        p += 1
    end
    until p < n && byte_at(ts, p) == 32:
        p += 1
    end
    if p < n:
        ret str.Substr(ts, p, n - p)
    end
    ret "void"
end

// 'externfunc(...)' counterpart of func_ret_of (raw C function pointers).
func raw_ret_of(ts: str): str:
    if !str.StartsWith(ts, "externfunc("):
        ret "void"
    end
    n := str.Len(ts)
    mut p := 10
    mut d := 0
    until p < n:
        c := byte_at(ts, p)
        if c == 40:
            d += 1
        else c == 41:
            d -= 1
            if d == 0:
                p += 1
                break
            end
        end
        p += 1
    end
    until p < n && byte_at(ts, p) == 32:
        p += 1
    end
    if p < n:
        ret str.Substr(ts, p, n - p)
    end
    ret "void"
end

// Shared body of raw_cast_params / func_cast_params (identical scans in C).
func cast_params_from(ts: str, s0: int): str:
    mut b := co.SbNew()
    co.SbPutc(b, 40)
    n := str.Len(ts)
    mut depth := 0
    mut start := s0
    mut any := false
    mut p := s0
    until true:
        c := p < n ? byte_at(ts, p) : 0
        if c == 60 || c == 40:
            depth += 1
        else c == 62:
            depth -= 1
        else c == 41 && depth > 0:
            depth -= 1
        end
        if (c == 44 && depth == 0) || (c == 41 && depth == 0) || c == 0:
            mut ss := start
            mut l := p - start
            until l > 0 && byte_at(ts, ss) == 32:
                ss += 1
                l -= 1
            end
            until l > 0 && byte_at(ts, ss + l - 1) == 32:
                l -= 1
            end
            if l > 0:
                if l >= 128:
                    l = 127
                end
                if any:
                    co.SbPuts(b, ", ")
                end
                co.SbPuts(b, cg_ctype(str.Substr(ts, ss, l)))
                any = true
            end
            if c == 41 || c == 0:
                break
            end
            start = p + 1
        end
        p += 1
    end
    if !any:
        co.SbPuts(b, "void")
    end
    co.SbPutc(b, 41)
    r := co.SbCstr(b)
    co.SbFree(b)
    ret r
end

func raw_cast_params(ts: str): str:
    if !str.StartsWith(ts, "externfunc("):
        ret "(void)"
    end
    ret cast_params_from(ts, 11)
end

func func_cast_params(ts: str): str:
    if !str.StartsWith(ts, "func("):
        ret "(void)"
    end
    ret cast_params_from(ts, 5)
end

func func_cast_params_env(ts: str): str:
    base := func_cast_params(ts)
    if str.Equals(base, "(void)"):
        ret "(void*)"
    end
    ret "(void*, " + str.Substr(base, 1, str.Len(base) - 1)
end

// type_is_byval_agg - t is a sm TypeId (sm.TYPE_NONE = C NULL).
func type_is_byval_agg(s &: sm.Sema, t: int): bool:
    if t == sm.TYPE_NONE:
        ret false
    end
    k := sm.TypeAt(s, t).kind
    ret k == sm.TY_STRUCT || k == sm.TY_VEC || k == sm.TY_DYN || k == sm.TY_SLICE || k == sm.TY_VARIANT
end

func array_size_of(ts: str): i64:
    if str.Len(ts) == 0:
        ret 0 as i64
    end
    lb := str.IndexOf(ts, "[")
    if lb < 0:
        ret 0 as i64
    end
    mut n := 0 as i64
    mut p := lb + 1
    tslen := str.Len(ts)
    until p < tslen:
        c := byte_at(ts, p)
        if c == 93:
            break
        end
        if c >= 48 && c <= 57:
            n = n * (10 as i64) + ((c - 48) as i64)
        end
        p += 1
    end
    ret n
end

func print_tag(ts: str): int:
    if str.Len(ts) == 0:
        ret 7
    end
    if str.Equals(ts, "str"):
        ret 7
    end
    if str.Equals(ts, "uchar"):
        ret 7
    end
    if str.Equals(ts, "bool"):
        ret 5
    end
    if str.Equals(ts, "char"):
        ret 6
    end
    if str.Equals(ts, "f32") || str.Equals(ts, "f64"):
        ret 4
    end
    if str.Equals(ts, "i64"):
        ret 1
    end
    if str.Equals(ts, "u32"):
        ret 2
    end
    if str.Equals(ts, "u64"):
        ret 3
    end
    if str.Equals(ts, "size"):
        ret 3
    end
    ret 0
end

func prim_suffix(tag: int): str:
    if tag == 1:
        ret "i64"
    end
    if tag == 2:
        ret "u32"
    end
    if tag == 3:
        ret "u64"
    end
    if tag == 4:
        ret "f64"
    end
    if tag == 5:
        ret "bool"
    end
    if tag == 6:
        ret "char"
    end
    ret "i32"
end

// ===== codegen_overload.c (sig_of_decl only - ported in 6a because the
// header/prototype emission needs it; 6b must NOT re-port it) =====

// sig_of_decl - fsym is a SymId, decl an at.NodeId; returns a SigId (0 =
// C NULL).
func sig_of_decl(s &: sm.Sema, fsym: int, decl: int): int:
    if fsym == 0:
        ret 0
    end
    fs := sm.SymAt(s, fsym)
    repeat fs.overloads.len() with i:
        sg := fs.overloads.get(i)[0]
        if sm.SigAt(s, sg).decl == decl:
            ret sg
        end
    end
    ret 0
end

// ===== print_fmt.c =====

func ts_is_unsigned(ts: str): bool:
    ret str.Len(ts) > 0 && cg_is_unsigned_typestr(ts)
end

func ts_is_int(ts: str): bool:
    if str.Len(ts) == 0:
        ret true
    end
    ret str.Equals(ts, "i8") || str.Equals(ts, "i16") || str.Equals(ts, "i32") || str.Equals(ts, "i64") || str.Equals(ts, "int") || str.Equals(ts, "u8") || str.Equals(ts, "u16") || str.Equals(ts, "u32") || str.Equals(ts, "u64") || str.Equals(ts, "uint") || str.Equals(ts, "size")
end

func ts_is_float(ts: str): bool:
    ret str.Equals(ts, "f32") || str.Equals(ts, "f64")
end

func pf_kind_of(ts: str): int:
    if str.Len(ts) == 0:
        ret PF_I32
    end
    if str.Equals(ts, "str"):
        ret PF_STR
    end
    if str.Equals(ts, "uchar"):
        ret PF_STR
    end
    if str.Equals(ts, "bool"):
        ret PF_BOOL
    end
    if str.Equals(ts, "char"):
        ret PF_CHAR
    end
    if ts_is_float(ts):
        ret PF_F64
    end
    if str.Equals(ts, "i64"):
        ret PF_I64
    end
    if str.Equals(ts, "u64"):
        ret PF_U64
    end
    if str.Equals(ts, "size"):
        ret PF_SIZE
    end
    if ts_is_unsigned(ts):
        ret PF_U32
    end
    ret PF_I32
end

func pf_spec_impl(k: int): str:
    if k == PF_STR:
        ret "%s"
    end
    if k == PF_I32:
        ret "%d"
    end
    if k == PF_U32:
        ret "%u"
    end
    if k == PF_I64:
        ret "%lld"
    end
    if k == PF_U64:
        ret "%llu"
    end
    if k == PF_SIZE:
        ret "%zu"
    end
    if k == PF_F64:
        ret "%g"
    end
    if k == PF_BOOL:
        ret "%s"
    end
    if k == PF_CHAR:
        ret "%c"
    end
    ret ""
end

func fold_int(a &: at.Ast, id: int, out2 &: i64): bool:
    if id == 0:
        ret false
    end
    n := at.Get(a, id)
    if n.kind == at.AST_LITERAL && n.op == tok.TK_INT:
        out2 = n.value_int as i64
        ret true
    end
    if n.kind == at.AST_UNARY && n.op == tok.TK_MINUS:
        mut v := 0 as i64
        if fold_int(a, n.a, v):
            out2 = (0 as i64) - v
            ret true
        end
        ret false
    end
    if n.kind == at.AST_BINARY:
        mut va := 0 as i64
        mut vb := 0 as i64
        if !fold_int(a, n.a, va) || !fold_int(a, n.b, vb):
            ret false
        end
        if n.op == tok.TK_PLUS:
            out2 = va + vb
            ret true
        end
        if n.op == tok.TK_MINUS:
            out2 = va - vb
            ret true
        end
        if n.op == tok.TK_STAR:
            out2 = va * vb
            ret true
        end
        ret false
    end
    ret false
end

func fold_flt(a &: at.Ast, id: int, out2 &: f64): bool:
    if id == 0:
        ret false
    end
    n := at.Get(a, id)
    if n.kind == at.AST_LITERAL && n.op == tok.TK_FLOAT:
        out2 = n.value_float
        ret true
    end
    mut iv := 0 as i64
    if fold_int(a, id, iv):
        out2 = iv as f64
        ret true
    end
    if n.kind == at.AST_UNARY && n.op == tok.TK_MINUS:
        mut v := 0.0
        if fold_flt(a, n.a, v):
            out2 = 0.0 - v
            ret true
        end
        ret false
    end
    if n.kind == at.AST_BINARY:
        mut va := 0.0
        mut vb := 0.0
        if !fold_flt(a, n.a, va) || !fold_flt(a, n.b, vb):
            ret false
        end
        if n.op == tok.TK_PLUS:
            out2 = va + vb
            ret true
        end
        if n.op == tok.TK_MINUS:
            out2 = va - vb
            ret true
        end
        if n.op == tok.TK_STAR:
            out2 = va * vb
            ret true
        end
        if n.op == tok.TK_SLASH:
            if vb != 0.0:
                out2 = va / vb
                ret true
            end
            ret false
        end
        ret false
    end
    ret false
end

func append_utf8(b &: str.StringBuilder, cp: i64):
    c := cp as int
    if cp < (128 as i64):
        co.SbPutc(b, c)
        ret
    end
    if cp < (2048 as i64):
        co.SbPutc(b, 192 | (c >> 6))
        co.SbPutc(b, 128 | (c & 63))
        ret
    end
    if cp < (65536 as i64):
        co.SbPutc(b, 224 | (c >> 12))
        co.SbPutc(b, 128 | ((c >> 6) & 63))
        co.SbPutc(b, 128 | (c & 63))
        ret
    end
    co.SbPutc(b, 240 | (c >> 18))
    co.SbPutc(b, 128 | ((c >> 12) & 63))
    co.SbPutc(b, 128 | ((c >> 6) & 63))
    co.SbPutc(b, 128 | (c & 63))
end

func pf_try_fold(a &: at.Ast, argid: int, lit &: str.StringBuilder): bool:
    arg := at.Get(a, argid)
    ts := arg.type_str
    if arg.kind == at.AST_LITERAL:
        if arg.op == tok.TK_KW_TRUE:
            co.SbPuts(lit, "true")
            ret true
        end
        if arg.op == tok.TK_KW_FALSE:
            co.SbPuts(lit, "false")
            ret true
        end
        if arg.op == tok.TK_STRING || arg.op == tok.TK_TRIPLE_STRING || arg.op == tok.TK_RAW_STRING:
            co.SbPuts(lit, arg.value_str)
            ret true
        end
        if arg.op == tok.TK_UTF8_CHAR:
            co.SbPuts(lit, arg.value_str)
            ret true
        end
        if arg.op == tok.TK_CHAR:
            append_utf8(lit, arg.value_int as i64)
            ret true
        end
    end
    if ts_is_float(ts):
        mut f := 0.0
        if fold_flt(a, argid, f):
            co.SbPuts(lit, co.Format1("%g", co.ArgFloat(f)))
            ret true
        end
        ret false
    end
    if ts_is_int(ts):
        mut v := 0 as i64
        if fold_int(a, argid, v):
            if ts_is_unsigned(ts):
                co.SbPuts(lit, co.U64Toa(v as u64))
            else:
                co.SbPuts(lit, co.I64Toa(v))
            end
            ret true
        end
    end
    ret false
end

func push_lit(out2 &: Vector<PfSeg>, lit &: str.StringBuilder):
    if co.SbLen(lit) == (0 as i64):
        ret
    end
    out2.push(PfSeg { kind = PF_LIT, text = co.SbCstr(lit), expr = 0 })
    // C: sb_free + sb_init - leave the builder empty and reusable.
    co.SbFree(lit)
end

func pf_build_impl(a &: at.Ast, call: int, nl: bool, out2 &: Vector<PfSeg>):
    mut lit := co.SbNew()
    cn := at.Get(a, call)
    repeat cn.list.len() with i:
        argid := cn.list.get(i)[0]
        if i > 0:
            co.SbPutc(lit, 32)
        end
        if pf_try_fold(a, argid, lit):
            continue
        end
        push_lit(out2, lit)
        argn := at.Get(a, argid)
        out2.push(
            PfSeg {
                kind = pf_kind_of(argn.type_str), text = "", expr = argid
            }
        )
    end
    if nl:
        co.SbPutc(lit, 10)
    end
    push_lit(out2, lit)
    co.SbFree(lit)
end

// ===== codegen_decl.c =====

func sig_is_sret(s &: sm.Sema, sig: int, is_main: bool): bool:
    ret !is_main && sig != 0 && type_is_byval_agg(s, sm.SigAt(s, sig).ret_type)
end

func func_signature(
    g &: Cg, s &: sm.Sema, a &: at.Ast, fnid: int, owner: int, sigid: int, is_main: bool
): str:
    sig := sm.SigAt(s, sigid)
    fn := at.Get(a, fnid)
    sret := sig_is_sret(s, sigid, is_main)
    mut rets := ""
    if is_main:
        rets = "int"
    else sret:
        rets = "void"
    else:
        rets = cg_ctype(sm.ToString(s, sig.ret_type))
    end
    osym := sm.SymAt(s, owner)
    ti := owner != 0 && osym.kind == sm.SYM_TYPEIMPL
    mut ti_ts := ""
    if ti:
        ti_ts = sm.ToString(s, osym.ty)
    end
    is_instance := (owner != 0 && str.Len(osym.generic_base) > 0) || fn.synthetic
    mut nm := ""
    if is_main:
        nm = "main"
    else fn.is_extern:
        nm = fn.name
    else ti:
        nm = cg_mangle_ti(s, ti_ts, fn.name, sig.params)
    else is_instance:
        nm = cg_mangle_in(
            s, "g", owner != 0 ? osym.name : "", fn.name, sig.params
        )
    else:
        nm = cg_mangle_in(
            s, g.pkg, owner != 0 ? osym.name : "", fn.name, sig.params
        )
    end
    if is_main:
        ret "int main(int argc, char** argv)"
    end
    pkgmod := !str.Equals(g.pkg, "main")
    exported := (owner != 0 || fn.is_extern || fn.is_pub || pkgmod) && !is_instance
    inl := fn.is_inline && !fn.is_extern && owner == 0 && (fn.is_pub || !pkgmod)
    mut b := co.SbNew()
    if is_instance || inl:
        co.SbPuts(b, "static inline ")
    else !exported:
        co.SbPuts(b, "static ")
    end
    if !fn.is_extern:
        if fn.is_noinline:
            co.SbPuts(b, "SALAM_NOINLINE ")
        end
        if fn.is_pure:
            co.SbPuts(b, "SALAM_PURE ")
        end
        if fn.is_deprecated:
            co.SbPuts(b, "SALAM_DEPRECATED ")
        end
    end
    if fn.is_noret:
        co.SbPuts(b, "SALAM_NORET ")
    end
    co.SbPuts(b, rets + " " + nm + "(")
    mut first := true
    if owner != 0:
        if ti:
            co.SbPuts(b, cg_ctype(ti_ts) + " this")
        else:
            co.SbPuts(b, cg_ctype(sm.ToString(s, osym.ty)) + "* this")
        end
        first = false
    end
    repeat fn.list.len() with i:
        p := at.Get(a, fn.list.get(i)[0])
        pts := sm.ToString(s, sig.params.get(i)[0])
        if !first:
            co.SbPuts(b, ", ")
        end
        if p.is_ref:
            co.SbPuts(b, cg_ctype(pts) + "* " + cg_cident(p.name))
        else:
            co.SbPuts(b, cg_decl(pts, p.name))
        end
        first = false
    end
    if sret:
        if !first:
            co.SbPuts(b, ", ")
        end
        co.SbPuts(b, cg_ctype(sm.ToString(s, sig.ret_type)) + "* __ret")
        first = false
    end
    if first && owner == 0:
        co.SbPuts(b, "void")
    end
    co.SbPutc(b, 41)
    r := co.SbCstr(b)
    co.SbFree(b)
    ret r
end

func cg_extern_proto(s &: sm.Sema, a &: at.Ast, fnid: int, sigid: int): str:
    sig := sm.SigAt(s, sigid)
    fn := at.Get(a, fnid)
    rets := cg_ctype(sm.ToString(s, sig.ret_type))
    mut b := co.SbNew()
    co.SbPuts(b, "extern ")
    if fn.is_pure:
        co.SbPuts(b, "SALAM_PURE ")
    end
    if fn.is_noret:
        co.SbPuts(b, "SALAM_NORET ")
    end
    co.SbPuts(b, rets + " " + fn.name + "(")
    mut first := true
    repeat fn.list.len() with i:
        p := at.Get(a, fn.list.get(i)[0])
        pts := sm.ToString(s, sig.params.get(i)[0])
        if !first:
            co.SbPuts(b, ", ")
        end
        if p.is_ref:
            co.SbPuts(b, cg_ctype(pts) + "* " + cg_cident(p.name))
        else:
            co.SbPuts(b, cg_decl(pts, p.name))
        end
        first = false
    end
    if fn.is_variadic:
        if !first:
            co.SbPuts(b, ", ")
        end
        co.SbPuts(b, "...")
        first = false
    end
    if first:
        co.SbPuts(b, "void")
    end
    co.SbPutc(b, 41)
    r := co.SbCstr(b)
    co.SbFree(b)
    ret r
end

func cg_function(g &: Cg, s &: sm.Sema, a &: at.Ast, fnid: int, owner: int):
    fn := at.Get(a, fnid)
    mut fsym := 0
    if owner != 0:
        fsym = sm.LookupLocal(s, sm.SymAt(s, owner).members, fn.name)
    else:
        fsym = sm.LookupLocal(s, s.global, fn.name)
    end
    sig := sig_of_decl(s, fsym, fnid)
    if sig == 0:
        ret
    end
    is_main := owner == 0 && str.Equals(fn.name, g.entry)
    lg.Log(
        g.log, lg.PH_CODEGEN, lg.LOG_TRACE, "emit function " + (owner != 0 ? sm.SymAt(s, owner).name : "") + fn.name
    )
    g.cur_struct = owner
    g.cur_fn_home = fsym != 0 ? sm.SymAt(s, fsym).home : 0
    g.cur_sret = sig_is_sret(s, sig, is_main)
    g.locals.clear()
    if owner != 0:
        local_add(g, "this")
    end
    repeat fn.list.len() with i:
        local_add(g, at.Get(a, fn.list.get(i)[0]).name)
    end
    saved_defers := g.fn_defers
    g.fn_defers = Vector {} as Vector<int>
    cg_source_line(g, span_of(a, fnid))
    if is_main && g.is_gui_mode:
        out(g, "#ifdef _WIN32\n")
        cg_line(
            g, "int WINAPI WinMain(HINSTANCE hInst, HINSTANCE " + "hPrevInst, LPSTR lpCmdLine, int nCmdShow) {"
        )
        out(
            g, "    (void)hInst; (void)hPrevInst; (void)lpCmdLine; " + "(void)nCmdShow;\n"
        )
        out(g, "#else\n")
        cg_line(g, "int main(int argc, char** argv) {")
        out(g, "#endif\n")
    else:
        cg_line(g, func_signature(g, s, a, fnid, owner, sig, is_main) + " {")
    end
    g.indent += 1
    if is_main:
        if !g.is_gui_mode:
            cg_line(g, "salam_set_args(argc, argv);")
        else:
            cg_line(g, "#ifdef _WIN32")
            cg_line(g, "(void)0;")
            cg_line(g, "#else")
            cg_line(g, "salam_set_args(argc, argv);")
            cg_line(g, "#endif")
        end
        repeat g.deferred.len() with i2:
            cg_line(g, g.deferred.get(i2)[0])
        end
    end
    if fn.a != 0:
        cg_block(g, s, a, fn.a)
    end
    cg_emit_defers(g, s, a)
    if is_main && sm.TypeAt(s, sm.SigAt(s, sig).ret_type).kind == sm.TY_VOID:
        cg_line(g, "return 0;")
    end
    g.indent -= 1
    cg_line(g, "}")
    outc(g, 10)
    g.cur_struct = 0
    g.cur_fn_home = 0
    g.cur_sret = false
    // The C leaked the inner arena vec on restore; the port frees it.
    mut inner := g.fn_defers
    defer inner.free()
    g.fn_defers = saved_defers
end

// ===== codegen_header.c =====

func vec_collect_one(g &: Cg, ts: str):
    if str.Len(ts) == 0:
        ret
    end
    if str.StartsWith(ts, "Vector<"):
        repeat g.vec_types.len() with i:
            if str.Equals(g.vec_types.get(i)[0], ts):
                ret
            end
        end
        g.vec_types.push(ts)
    else str.StartsWith(ts, "Variant<"):
        repeat g.variant_types.len() with i2:
            if str.Equals(g.variant_types.get(i2)[0], ts):
                ret
            end
        end
        g.variant_types.push(ts)
    end
end

func vec_collect(g &: Cg, a &: at.Ast, id: int):
    if id == 0:
        ret
    end
    n := at.Get(a, id)
    vec_collect_one(g, n.type_str)
    vec_collect(g, a, n.ty)
    vec_collect(g, a, n.a)
    vec_collect(g, a, n.b)
    vec_collect(g, a, n.c)
    vec_collect(g, a, n.d)
    repeat n.list.len() with i:
        vec_collect(g, a, n.list.get(i)[0])
    end
    repeat n.dims.len() with i2:
        vec_collect(g, a, n.dims.get(i2)[0])
    end
end

func vec_collect_types(g &: Cg, s &: sm.Sema, a &: at.Ast, program: int):
    prog := at.Get(a, program)
    repeat prog.list.len() with i:
        d := at.Get(a, prog.list.get(i)[0])
        if d.kind != at.AST_STRUCT_DEF:
            continue
        end
        ssym := sm.LookupLocal(s, s.global, d.name)
        if ssym == 0:
            continue
        end
        members := sm.SymAt(s, ssym).members
        msc := sm.ScopeAt(s, members)
        repeat msc.symbols.len() with j:
            f := sm.SymAt(s, msc.symbols.get(j)[0])
            if f.kind == sm.SYM_FIELD && f.ty != sm.TYPE_NONE:
                vec_collect_one(g, sm.ToString(s, f.ty))
            end
        end
    end
end

func dyn_set_add(setv &: Vector<str>, s2: str):
    repeat setv.len() with i:
        if str.Equals(setv.get(i)[0], s2):
            ret
        end
    end
    setv.push(s2)
end

func dyn_collect(g &: Cg, a &: at.Ast, id: int):
    if id == 0:
        ret
    end
    n := at.Get(a, id)
    if str.StartsWith(n.type_str, "dyn "):
        dyn_set_add(
            g.dyn_ifaces, str.Substr(
                n.type_str, 4, str.Len(n.type_str) - 4
            )
        )
    end
    if n.kind == at.AST_TYPE && n.is_dyn && str.Len(n.name) > 0:
        dyn_set_add(g.dyn_ifaces, n.name)
    end
    if n.kind == at.AST_CAST && str.StartsWith(n.type_str, "dyn ") && n.a != 0:
        an := at.Get(a, n.a)
        if str.Len(an.type_str) > 0:
            iface := str.Substr(n.type_str, 4, str.Len(n.type_str) - 4)
            dyn_set_add(g.dyn_ifaces, iface)
            // char pair[256] - sal_snprintf truncation kept.
            mut pair := iface + "|" + an.type_str
            if str.Len(pair) > 255:
                pair = str.Substr(pair, 0, 255)
            end
            dyn_set_add(g.dyn_impls, pair)
        end
    end
    dyn_collect(g, a, n.ty)
    dyn_collect(g, a, n.a)
    dyn_collect(g, a, n.b)
    dyn_collect(g, a, n.c)
    dyn_collect(g, a, n.d)
    repeat n.list.len() with i:
        dyn_collect(g, a, n.list.get(i)[0])
    end
    repeat n.dims.len() with i2:
        dyn_collect(g, a, n.dims.get(i2)[0])
    end
end

// dyn_match_sig - cm is a SymId, want a SigId; returns a SigId.
func dyn_match_sig(s &: sm.Sema, cm: int, want: int): int:
    if cm == 0:
        ret 0
    end
    cs := sm.SymAt(s, cm)
    wsig := sm.SigAt(s, want)
    repeat cs.overloads.len() with k:
        h := cs.overloads.get(k)[0]
        hsig := sm.SigAt(s, h)
        if hsig.params.len() != wsig.params.len():
            continue
        end
        mut ok := true
        repeat wsig.params.len() with p:
            if !sm.Equiv(s, hsig.params.get(p)[0], wsig.params.get(p)[0]):
                ok = false
                break
            end
        end
        if ok:
            ret h
        end
    end
    if cs.overloads.len() > 0:
        ret cs.overloads.get(0)[0]
    end
    ret 0
end

func cg_emit_dyn_types(g &: Cg, s &: sm.Sema):
    repeat g.dyn_ifaces.len() with i:
        iname := g.dyn_ifaces.get(i)[0]
        ci := cg_cident(iname)
        isym := sm.Lookup(s, s.global, iname)
        if isym == 0 || sm.SymAt(s, isym).kind != sm.SYM_INTERFACE:
            continue
        end
        outh(
            g, "#ifndef SALAM_DYN_" + ci + "_DEFINED\n#define SALAM_DYN_" + ci + "_DEFINED\n"
        )
        outh(g, "typedef struct _Salam_vtbl_" + ci + " {\n")
        imembers := sm.SymAt(s, isym).members
        isc := sm.ScopeAt(s, imembers)
        repeat isc.symbols.len() with m:
            ms := sm.SymAt(s, isc.symbols.get(m)[0])
            if ms.kind != sm.SYM_METHOD || ms.overloads.len() == 0:
                continue
            end
            sig := sm.SigAt(s, ms.overloads.get(0)[0])
            outh(
                g, "    " + cg_ctype(sm.ToString(s, sig.ret_type)) + " (*" + cg_cident(ms.name) + ")(void*"
            )
            repeat sig.params.len() with p:
                outh(
                    g, ", " + cg_ctype(
                        sm.ToString(
                            s, sig.params.get(p)[0]
                        )
                    )
                )
            end
            outh(g, ");\n")
        end
        outh(g, "} _Salam_vtbl_" + ci + ";\n")
        outh(
            g, "typedef struct { void* data; const _Salam_vtbl_" + ci + "* vtable; } _Salam_dyn_" + ci + ";\n"
        )
        outh(g, "#endif\n")
    end
end

// cg_emit_dyn_vtables - writes to the C sink (callers keep cur == CG_OUT_C).
func cg_emit_dyn_vtables_impl(g &: Cg, s &: sm.Sema):
    repeat g.dyn_impls.len() with i:
        pair := g.dyn_impls.get(i)[0]
        bar := str.IndexOf(pair, "|")
        if bar < 0:
            continue
        end
        iname := str.Substr(pair, 0, bar)
        cnamev := str.Substr(pair, bar + 1, str.Len(pair) - bar - 1)
        ci := cg_cident(iname)
        cc2 := cg_cident(cnamev)
        isym := sm.Lookup(s, s.global, iname)
        csym := sm.Lookup(s, s.global, cnamev)
        if isym == 0 || sm.SymAt(s, isym).kind != sm.SYM_INTERFACE || csym == 0 || sm.SymAt(s, csym).kind != sm.SYM_STRUCT:
            continue
        end
        imembers := sm.SymAt(s, isym).members
        isc := sm.ScopeAt(s, imembers)
        repeat isc.symbols.len() with m:
            ms := sm.SymAt(s, isc.symbols.get(m)[0])
            if ms.kind != sm.SYM_METHOD || ms.overloads.len() == 0:
                continue
            end
            isig := ms.overloads.get(0)[0]
            cm := sm.LookupLocal(s, sm.SymAt(s, csym).members, ms.name)
            csig := dyn_match_sig(s, cm, isig)
            if csig == 0:
                continue
            end
            mangled := cg_mangle(
                g, s, sm.SymAt(s, csym).name, ms.name, sm.SigAt(s, csig).params
            )
            isigv := sm.SigAt(s, isig)
            rets := cg_ctype(sm.ToString(s, isigv.ret_type))
            mut ps := co.SbNew()
            mut asb := co.SbNew()
            repeat isigv.params.len() with p:
                pt := cg_ctype(sm.ToString(s, isigv.params.get(p)[0]))
                co.SbPuts(ps, ", " + pt + " __a" + p)
                co.SbPuts(asb, ", __a" + p)
            end
            isvoid := isigv.ret_type != sm.TYPE_NONE && sm.TypeAt(s, isigv.ret_type).kind == sm.TY_VOID
            out(
                g, "static " + rets + " _Salam_thunk_" + ci + "_" + cc2 + "_" + cg_cident(ms.name) + "(void* self" + co.SbCstr(ps) + "){ " + (isvoid ? "" : "return ") + mangled + "((" + cc2 + "*)self" + co.SbCstr(asb) + "); }\n"
            )
            co.SbFree(ps)
            co.SbFree(asb)
        end
        out(
            g, "static const _Salam_vtbl_" + ci + " _Salam_vtbl_" + ci + "_" + cc2 + " = {"
        )
        mut first := true
        repeat isc.symbols.len() with m2:
            ms2 := sm.SymAt(s, isc.symbols.get(m2)[0])
            if ms2.kind != sm.SYM_METHOD || ms2.overloads.len() == 0:
                continue
            end
            out(
                g, (first ? "" : ",") + " _Salam_thunk_" + ci + "_" + cc2 + "_" + cg_cident(ms2.name)
            )
            first = false
        end
        out(g, " };\n")
    end
    if g.dyn_impls.len() > 0:
        outc(g, 10)
    end
end

func vec_emit_typedef(g &: Cg, ts: str):
    elem := cg_vec_elem(ts, 96)
    ec := cg_ctype(elem)
    cn := cg_vec_cname(ts)
    outh(
        g, "#ifndef SALAM_" + cn + "_TYPEDEF\n#define SALAM_" + cn + "_TYPEDEF\n"
    )
    outh(
        g, "typedef struct { " + ec + "* data; int32_t len; int32_t cap; " + "} " + cn + ";\n"
    )
    outh(g, "#endif\n")
end

func variant_emit_typedef(g &: Cg, ts: str):
    mut members := cg_variant_members(ts)
    defer members.free()
    cn := cg_variant_cname(ts)
    outh(
        g, "#ifndef SALAM_" + cn + "_TYPEDEF\n#define SALAM_" + cn + "_TYPEDEF\n"
    )
    outh(g, "typedef struct { int32_t tag; union {")
    repeat members.len() with i:
        outh(g, " " + cg_decl(members.get(i)[0], "v" + i) + ";")
    end
    outh(g, " } payload; } " + cn + ";\n")
    outh(g, "#endif\n")
end

func vec_emit(g &: Cg, ts: str):
    elem := cg_vec_elem(ts, 96)
    ec := cg_ctype(elem)
    cn := cg_vec_cname(ts)
    outh(
        g, "#ifndef SALAM_" + cn + "_DEFINED\n#define SALAM_" + cn + "_DEFINED\n"
    )
    outh(
        g, "static void " + cn + "_grow(" + cn + "* v, int32_t need){ " + "if(need<=v->cap) return; int32_t c=v->cap?v->cap:4; " + "while(c<need) c*=2; v->data=(" + ec + "*)" + CG_MEM_REALLOC + "(v->data,(uint64_t)c*sizeof(" + ec + ")); v->cap=c; }\n"
    )
    outh(
        g, "static void " + cn + "_push(" + cn + "* v, " + ec + " x){ " + cn + "_grow(v, v->len+1); v->data[v->len++]=x; }\n"
    )
    outh(
        g, "static " + ec + " " + cn + "_pop(" + cn + "* v){ return " + "v->data[--v->len]; }\n"
    )
    outh(
        g, "static " + ec + "* " + cn + "_get(" + cn + "* v, int32_t i){ " + "if(i<0||i>=v->len) return (" + ec + "*)0; return " + "&v->data[i]; }\n"
    )
    outh(
        g, "static void " + cn + "_set(" + cn + "* v, int32_t i, " + ec + " x){ if(i<0) return; " + cn + "_grow(v, i+1); if(i>=v->len) " + "v->len=i+1; v->data[i]=x; }\n"
    )
    outh(
        g, "static int32_t " + cn + "_len(" + cn + "* v){ return v->len; " + "}\n"
    )
    outh(
        g, "static int32_t " + cn + "_cap(" + cn + "* v){ return v->cap; " + "}\n"
    )
    outh(
        g, "static void " + cn + "_free(" + cn + "* v){ " + CG_MEM_FREE + "(v->data); v->data=(" + ec + "*)0; v->len=0; v->cap=0; }\n"
    )
    outh(g, "#endif\n")
end

func hdr_prelude(g &: Cg, a &: at.Ast, program: int):
    outh(g, "#pragma once\n")
    guard := cg_cident(g.module)
    outh(
        g, "#ifndef SALAM_MODULE_" + guard + "_H\n#define SALAM_MODULE_" + guard + "_H\n"
    )
    if g.is_gui_mode:
        outh(g, "#ifdef _WIN32\n#include <windows.h>\n#endif\n")
    end
    outh(
        g, "#include <stdint.h>\n#include <stdbool.h>\n#include <math.h>" + "\n#include <stddef.h>\n"
    )
    outh(
        g, "#ifndef SALAM_OUT_DEFINED\n#define SALAM_OUT_DEFINED\n" + "#define SALAM_OB_SZ 65536\n" + "extern int fflush(void *);\n" + "extern int snprintf(char *buf, uint64_t size, const char " + "*fmt, ...);\n" + "#if defined(_WIN32)\n" + "extern int _write(int, void *, unsigned);\n" + "#define SALAM_RAW_WRITE(fd, buf, n) _write((fd), (void " + "*)(buf), (unsigned)(n))\n" + "#else\n" + "extern int64_t write(int32_t, void *, uint64_t);\n" + "#define SALAM_RAW_WRITE(fd, buf, n) write((fd), (void " + "*)(buf), (uint64_t)(n))\n" + "#endif\n" + "#if (defined(__GNUC__) || defined(__clang__)) && " + "!defined(__TINYC__)\n" + "__attribute__((weak)) char salam_ob[SALAM_OB_SZ];\n" + "__attribute__((weak)) uint64_t salam_obn;\n" + "__attribute__((weak)) void salam_out_flush(void) {\n" + "    if (salam_obn) { int64_t r = " + "(int64_t)SALAM_RAW_WRITE(1, salam_ob, salam_obn); (void)r; " + "salam_obn = 0; }\n" + "}\n" + "__attribute__((weak, destructor)) void salam_out_fini(void) " + "{ salam_out_flush(); }\n" + "static inline void salam_out_write_(const void *s, uint64_t " + "n) {\n" + "    if (salam_obn + n > SALAM_OB_SZ) salam_out_flush();\n" + "    if (n >= SALAM_OB_SZ) { int64_t r = " + "(int64_t)SALAM_RAW_WRITE(1, s, n); (void)r; return; }\n" + "    __builtin_memcpy(salam_ob + salam_obn, s, (size_t)n); " + "salam_obn += n;\n" + "}\n" + "#else\n" + "static void salam_out_flush(void) { fflush(0); }\n" + "static void salam_out_write_(const void *s, uint64_t n) {\n" + "    int64_t r = (int64_t)SALAM_RAW_WRITE(1, s, n); (void)r;\n" + "}\n" + "#endif\n" + "#define SALAM_OUT_LIT(s, n) salam_out_write_((s), " + "(uint64_t)(n))\n" + "#endif\n"
    )
    outh(
        g, "#ifndef SALAM_FN_ATTRS_DEFINED\n#define " + "SALAM_FN_ATTRS_DEFINED\n" + "#if defined(__GNUC__) || defined(__clang__)\n" + "#define SALAM_NOINLINE __attribute__((noinline))\n" + "#define SALAM_PURE __attribute__((pure))\n" + "#define SALAM_NORET __attribute__((noreturn))\n" + "#define SALAM_DEPRECATED __attribute__((deprecated))\n" + "#else\n" + "#define SALAM_NOINLINE\n" + "#define SALAM_PURE\n" + "#define SALAM_NORET\n" + "#define SALAM_DEPRECATED\n" + "#endif\n" + "#endif\n"
    )
    outh(
        g, "#ifndef SALAM_RT_TYPES_DEFINED\n#define " + "SALAM_RT_TYPES_DEFINED\n" + "typedef struct salam_file salam_file;\n" + "typedef struct salam_map salam_map;\n" + "typedef struct salam_map_iter salam_map_iter;\n" + "typedef struct { void* data; int64_t len; } salam_slice;\n" + "extern int64_t salam_idx(int64_t, int64_t);\n" + "extern SALAM_NORET void salam_panic(const char* msg);\n" + "void* " + CG_MEM_ALLOC + "(uint64_t size);\n" + "void* " + CG_MEM_REALLOC + "(void* ptr, uint64_t size);\n" + "void " + CG_MEM_FREE + "(void* ptr);\n" + "static inline void salam_slice_new(salam_slice* out, void* " + "b, int64_t lo, int64_t hi, int64_t esz)" + "{ out->data=(void*)((char*)b+(lo)*(esz)); " + "out->len=(hi)-(lo); }\n" + "static inline void salam_slice_sub(salam_slice* out, " + "salam_slice b, int64_t lo, int64_t hi, int has_hi, int64_t " + "esz)" + "{ if(!has_hi) hi=b.len; " + "out->data=(void*)((char*)b.data+(lo)*(esz)); " + "out->len=(hi)-(lo); }\n" + "static inline void* salam_slice_at(salam_slice s, int64_t i, " + "int64_t esz, int sf)" + "{ return " + "(void*)((char*)s.data+(sf?salam_idx(i,s.len):i)*(esz)); }\n" + "typedef void (*salam_thread_fn)(void);\n" + "#endif\n"
    )
    outh(
        g, "#ifndef SALAM_RT_STR_DEFINED\n#define SALAM_RT_STR_DEFINED\n" + "extern uint64_t strlen(const char* s);\n" + "extern int32_t strcmp(const char* a, const char* b);\n" + "extern const char* strstr(const char* haystack, const char* " + "needle);\n" + "extern int64_t strtol(const char* s, void* endptr, int32_t " + "base);\n" + "extern double strtod(const char* s, void* endptr);\n" + "extern const char* salam_strcat(const char* a, const char* " + "b);\n" + "extern const char* salam_char_from_code(int32_t c);\n" + "extern const char* salam_str_substr(const char* s, int32_t " + "start, int32_t n);\n" + "extern const char* salam_str_trim(const char* s);\n" + "extern void* salam_str_split(const char* s, const char* " + "delim, void* out_count);\n" + "extern const char* salam_str_repeat(const char* s, int32_t " + "n);\n" + "extern const char* salam_str_upper(const char* s);\n" + "extern const char* salam_str_lower(const char* s);\n" + "#endif\n"
    )
    if !str.Equals(g.module, "core"):
        outh(g, "#include \"" + CG_MOD_PREFIX + "core.h\"\n")
    end
    prog := at.Get(a, program)
    repeat prog.list.len() with i:
        d := at.Get(a, prog.list.get(i)[0])
        if d.kind != at.AST_IMPORT:
            continue
        end
        mut p := d.name
        if d.value_kind == tok.TV_STRING && str.Len(d.value_str) > 0:
            p = d.value_str
        end
        if str.Len(p) == 0:
            continue
        end
        mut resolved := d.type_str
        if str.Len(resolved) == 0:
            resolved = sm.ResolveImport("", p)
        end
        slash := str.LastIndex(resolved, "/")
        bs := str.LastIndex(resolved, "\\")
        mut stem := slash >= 0 ? slash + 1 : 0
        if bs >= 0 && (slash < 0 || bs > slash):
            stem = bs + 1
        end
        // char base[128] clamp kept.
        rl := str.Len(resolved)
        mut k := 0
        mut b := co.SbNew()
        mut q := stem
        until q < rl && k < 127:
            c := byte_at(resolved, q)
            if c == 46:
                break
            end
            co.SbPutc(b, c)
            k += 1
            q += 1
        end
        basev := co.SbCstr(b)
        co.SbFree(b)
        outh(g, "#include \"" + CG_MOD_PREFIX + basev + ".h\"\n")
    end
    outh(g, "\n")
end

func hdr_enums(g &: Cg, a &: at.Ast, program: int):
    prog := at.Get(a, program)
    repeat prog.list.len() with i:
        d := at.Get(a, prog.list.get(i)[0])
        if d.kind != at.AST_ENUM_DEF:
            continue
        end
        outh(g, "typedef enum {")
        mut next := 0 as i64
        repeat d.list.len() with j:
            m := at.Get(a, d.list.get(j)[0])
            if m.a != 0:
                ma := at.Get(a, m.a)
                if ma.kind == at.AST_LITERAL && ma.value_kind == tok.TV_INT:
                    next = ma.value_int as i64
                end
            end
            outh(
                g, (j > 0 ? "," : "") + " " + cg_cident(d.name) + "_" + cg_cident(m.name) + " = " + co.I64Toa(next)
            )
            next += 1 as i64
        end
        outh(g, " } " + cg_cident(d.name) + ";\n")
    end
end

func hdr_struct_fwd(g &: Cg, s &: sm.Sema, a &: at.Ast, program: int):
    prog := at.Get(a, program)
    repeat prog.list.len() with i:
        d := at.Get(a, prog.list.get(i)[0])
        if d.kind != at.AST_STRUCT_DEF:
            continue
        end
        if d.typarams.len() > 0:
            continue
        end
        ssym2 := sm.LookupLocal(s, s.global, d.name)
        mut raw2 := d.name
        if ssym2 != 0:
            sv := sm.SymAt(s, ssym2)
            if sv.ty != sm.TYPE_NONE:
                tn := sm.TypeAt(s, sv.ty).name
                if str.Len(tn) > 0:
                    raw2 = tn
                end
            end
        end
        cn := cg_cident(raw2)
        outh(
            g, "#ifndef SALAM_FWD_" + cn + "\n#define SALAM_FWD_" + cn + "\ntypedef struct " + cn + " " + cn + ";\n#endif\n"
        )
    end
end

func hdr_struct_fwd_imports(g &: Cg, s &: sm.Sema, a &: at.Ast):
    repeat sm.PackageCount(s) with p:
        pk := sm.PackageAt(s, p)
        if pk == 0:
            continue
        end
        pkv := sm.SymAt(s, pk)
        if pkv.kind != sm.SYM_PACKAGE || pkv.members == 0:
            continue
        end
        psc := sm.ScopeAt(s, pkv.members)
        repeat psc.symbols.len() with i:
            sv := sm.SymAt(s, psc.symbols.get(i)[0])
            if sv.kind != sm.SYM_STRUCT || sv.ty == sm.TYPE_NONE:
                continue
            end
            tn := sm.TypeAt(s, sv.ty).name
            if str.Len(tn) == 0:
                continue
            end
            if sv.decl != 0 && at.Get(a, sv.decl).typarams.len() > 0:
                continue
            end
            cn := cg_cident(tn)
            outh(
                g, "#ifndef SALAM_FWD_" + cn + "\n#define SALAM_FWD_" + cn + "\ntypedef struct " + cn + " " + cn + ";\n#endif\n"
            )
        end
    end
end

func emit_struct_def(g &: Cg, s &: sm.Sema, ssym: int, gcn: str):
    outh(
        g, "#ifndef SALAM_DEF_" + gcn + "\n#define SALAM_DEF_" + gcn + "\n"
    )
    outh(g, "struct " + gcn + " {\n")
    mut nfields := 0
    msc := sm.ScopeAt(s, sm.SymAt(s, ssym).members)
    repeat msc.symbols.len() with j:
        f := sm.SymAt(s, msc.symbols.get(j)[0])
        if f.kind != sm.SYM_FIELD:
            continue
        end
        outh(g, "    " + cg_decl(sm.ToString(s, f.ty), f.name) + ";\n")
        nfields += 1
    end
    if nfields == 0:
        outh(g, "    char _salam_empty;\n")
    end
    outh(g, "};\n#endif\n")
end

// struct_dep_cname - "" = the C NULL (no dependency).
func struct_dep_cname(s &: sm.Sema, t0: int): str:
    mut t := t0
    until t != sm.TYPE_NONE && sm.TypeAt(s, t).kind == sm.TY_ARRAY:
        t = sm.TypeAt(s, t).elem
    end
    if t == sm.TYPE_NONE:
        ret ""
    end
    k := sm.TypeAt(s, t).kind
    if k == sm.TY_STRUCT || k == sm.TY_VEC || k == sm.TY_MAP_ITER:
        ret cg_ctype(sm.ToString(s, t))
    end
    ret ""
end

func hdr_struct_visit_dep(
    g &: Cg, s &: sm.Sema, dep: str, self: int, syms: Vector<int>, gcns: Vector<str>, state &: Vector<int>
):
    n := gcns.len()
    repeat n with k:
        if k != self && str.Equals(dep, gcns.get(k)[0]):
            hdr_struct_visit(g, s, k, syms, gcns, state)
        end
    end
end

func hdr_variant_field_deps(
    g &: Cg, s &: sm.Sema, vt: int, self: int, syms: Vector<int>, gcns: Vector<str>, state &: Vector<int>
):
    vtv := sm.TypeAt(s, vt)
    repeat vtv.params.len() with m:
        dep := struct_dep_cname(s, vtv.params.get(m)[0])
        if str.Len(dep) > 0:
            hdr_struct_visit_dep(g, s, dep, self, syms, gcns, state)
        end
    end
    variant_emit_typedef(g, sm.ToString(s, vt))
end

func hdr_struct_visit(
    g &: Cg, s &: sm.Sema, i: int, syms: Vector<int>, gcns: Vector<str>, state &: Vector<int>
):
    if state.get(i)[0] != 0:
        ret
    end
    state.set(i, 1)
    ssym := syms.get(i)[0]
    msc := sm.ScopeAt(s, sm.SymAt(s, ssym).members)
    repeat msc.symbols.len() with j:
        f := sm.SymAt(s, msc.symbols.get(j)[0])
        if f.kind != sm.SYM_FIELD:
            continue
        end
        if f.ty != sm.TYPE_NONE && sm.TypeAt(s, f.ty).kind == sm.TY_VARIANT:
            hdr_variant_field_deps(g, s, f.ty, i, syms, gcns, state)
            continue
        end
        dep := struct_dep_cname(s, f.ty)
        if str.Len(dep) > 0:
            hdr_struct_visit_dep(g, s, dep, i, syms, gcns, state)
        end
    end
    emit_struct_def(g, s, ssym, gcns.get(i)[0])
    state.set(i, 2)
end

func hdr_structs(g &: Cg, s &: sm.Sema, a &: at.Ast, program: int):
    mut syms := Vector {} as Vector<int>
    defer syms.free()
    mut gcns := Vector {} as Vector<str>
    defer gcns.free()
    mut state := Vector {} as Vector<int>
    defer state.free()
    prog := at.Get(a, program)
    repeat prog.list.len() with i:
        d := at.Get(a, prog.list.get(i)[0])
        if d.kind != at.AST_STRUCT_DEF:
            continue
        end
        if d.typarams.len() > 0:
            continue
        end
        ssym := sm.LookupLocal(s, s.global, d.name)
        if ssym == 0 || sm.SymAt(s, ssym).members == 0:
            continue
        end
        mut raw_cn := d.name
        sv := sm.SymAt(s, ssym)
        if sv.ty != sm.TYPE_NONE:
            tn := sm.TypeAt(s, sv.ty).name
            if str.Len(tn) > 0:
                raw_cn = tn
            end
        end
        syms.push(ssym)
        gcns.push(cg_cident(raw_cn))
        state.push(0)
    end
    repeat syms.len() with i2:
        hdr_struct_visit(g, s, i2, syms, gcns, state)
    end
end

func hdr_aliases(g &: Cg, s &: sm.Sema, a &: at.Ast, program: int):
    prog := at.Get(a, program)
    repeat prog.list.len() with i:
        d := at.Get(a, prog.list.get(i)[0])
        if d.kind != at.AST_TYPE_ALIAS:
            continue
        end
        asym := sm.LookupLocal(s, s.global, d.name)
        if asym == 0:
            continue
        end
        outh(
            g, "typedef " + cg_decl(sm.ToString(s, sm.SymAt(s, asym).ty), d.name) + ";\n"
        )
    end
end

func hdr_externs(g &: Cg, s &: sm.Sema, a &: at.Ast, program: int):
    prog := at.Get(a, program)
    repeat prog.list.len() with i:
        did := prog.list.get(i)[0]
        d := at.Get(a, did)
        if !d.is_extern:
            continue
        end
        if d.kind == at.AST_FUNC_DEF:
            fsym := sm.LookupLocal(s, s.global, d.name)
            sig := sig_of_decl(s, fsym, did)
            if sig != 0:
                outh(g, cg_extern_proto(s, a, did, sig) + ";\n")
            end
        else d.kind == at.AST_VAR_DECL:
            ts := str.Len(d.type_str) > 0 ? d.type_str : "int32_t"
            outh(g, "extern " + cg_decl(ts, d.name) + ";\n")
        end
    end
    outh(g, "\n")
end

func hdr_globals(g &: Cg, a &: at.Ast, program: int):
    prog := at.Get(a, program)
    repeat prog.list.len() with i:
        d := at.Get(a, prog.list.get(i)[0])
        pkgmod := !str.Equals(g.pkg, "main")
        if d.kind != at.AST_CONST_DECL && d.kind != at.AST_VAR_DECL:
            continue
        end
        if d.is_extern || (!d.is_pub && !pkgmod):
            continue
        end
        ts := str.Len(d.type_str) > 0 ? d.type_str : "int32_t"
        decl := cg_decl(ts, d.name)
        is_array := str.IndexOf(ts, "[") >= 0
        can_defer := d.kind == at.AST_VAR_DECL && d.a != 0 && at.KindOf(a, d.a) != at.AST_LITERAL && !is_array
        want_const := !can_defer && (d.kind == at.AST_CONST_DECL || !d.is_mut)
        gct_const := want_const && str.StartsWith(cg_ctype(ts), "const ")
        pfx := (want_const && !gct_const) ? "const " : ""
        outh(g, "extern " + pfx + decl + ";\n")
    end
    outh(g, "\n")
end

func hdr_prototypes(g &: Cg, s &: sm.Sema, a &: at.Ast, program: int):
    prog := at.Get(a, program)
    repeat prog.list.len() with i:
        did := prog.list.get(i)[0]
        d := at.Get(a, did)
        pkgmod := !str.Equals(g.pkg, "main")
        if d.typarams.len() > 0:
            continue
        end
        if d.is_extern:
            continue
        end
        if d.synthetic:
            continue
        end
        if d.kind == at.AST_FUNC_DEF && !str.Equals(d.name, g.entry) && (d.is_pub || pkgmod):
            fsym := sm.LookupLocal(s, s.global, d.name)
            sig := sig_of_decl(s, fsym, did)
            if sig != 0:
                outh(g, func_signature(g, s, a, did, 0, sig, false) + ";\n")
            end
        else d.kind == at.AST_STRUCT_DEF:
            ssym := sm.LookupLocal(s, s.global, d.name)
            if ssym == 0 || sm.SymAt(s, ssym).members == 0:
                continue
            end
            repeat d.list.len() with j:
                mid := d.list.get(j)[0]
                m := at.Get(a, mid)
                if m.kind != at.AST_FUNC_DEF:
                    continue
                end
                msym := sm.LookupLocal(s, sm.SymAt(s, ssym).members, m.name)
                sig2 := sig_of_decl(s, msym, mid)
                if sig2 != 0:
                    outh(
                        g, func_signature(
                            g, s, a, mid, ssym, sig2, false
                        ) + ";\n"
                    )
                end
            end
        end
    end
end

func cg_header_impl(g &: Cg, s &: sm.Sema, a &: at.Ast, program: int):
    hdr_prelude(g, a, program)
    hdr_enums(g, a, program)
    hdr_struct_fwd(g, s, a, program)
    hdr_struct_fwd_imports(g, s, a)
    dyn_collect(g, a, program)
    cg_emit_dyn_types(g, s)
    outh(g, "\n")
    vec_collect(g, a, program)
    vec_collect_types(g, s, a, program)
    repeat g.vec_types.len() with i:
        vec_emit_typedef(g, g.vec_types.get(i)[0])
    end
    outh(g, "\n")
    hdr_structs(g, s, a, program)
    hdr_aliases(g, s, a, program)
    repeat g.variant_types.len() with i2:
        variant_emit_typedef(g, g.variant_types.get(i2)[0])
    end
    outh(g, "\n")
    repeat g.vec_types.len() with i3:
        vec_emit(g, g.vec_types.get(i3)[0])
    end
    outh(g, "\n")
    hdr_externs(g, s, a, program)
    hdr_globals(g, a, program)
    hdr_prototypes(g, s, a, program)
end

// ===== codegen.c =====

func detect_gui_imports(a &: at.Ast, program: int): bool:
    prog := at.Get(a, program)
    repeat prog.list.len() with i:
        d := at.Get(a, prog.list.get(i)[0])
        if d.kind != at.AST_IMPORT:
            continue
        end
        if str.Len(d.name) == 0:
            continue
        end
        if str.Equals(d.name, "webview") || str.Equals(d.name, "layout"):
            ret true
        end
    end
    ret false
end

func emit_private_protos(g &: Cg, s &: sm.Sema, a &: at.Ast, program: int):
    prog := at.Get(a, program)
    repeat prog.list.len() with i:
        did := prog.list.get(i)[0]
        d := at.Get(a, did)
        if d.typarams.len() > 0:
            continue
        end
        if d.synthetic:
            continue
        end
        if d.kind == at.AST_FUNC_DEF && !d.is_extern && !str.Equals(d.name, g.entry) && !d.is_pub:
            fsym := sm.LookupLocal(s, s.global, d.name)
            sig := sig_of_decl(s, fsym, did)
            if sig != 0:
                out(g, func_signature(g, s, a, did, 0, sig, false) + ";\n")
            end
        end
    end
    out(g, "\n")
end

func emit_globals(g &: Cg, s &: sm.Sema, a &: at.Ast, program: int):
    prog := at.Get(a, program)
    repeat prog.list.len() with i:
        d := at.Get(a, prog.list.get(i)[0])
        if d.kind != at.AST_CONST_DECL && d.kind != at.AST_VAR_DECL:
            continue
        end
        if d.is_extern:
            continue
        end
        ts := str.Len(d.type_str) > 0 ? d.type_str : "int32_t"
        decl := cg_decl(ts, d.name)
        is_array := str.IndexOf(ts, "[") >= 0
        can_defer := d.kind == at.AST_VAR_DECL && d.a != 0 && at.KindOf(a, d.a) != at.AST_LITERAL && !is_array
        if can_defer:
            out(g, decl + ";\n")
            g.deferred.push(
                cg_cident(d.name) + " = " + cg_expr(g, s, a, d.a) + ";"
            )
        else:
            want_const := d.kind == at.AST_CONST_DECL
            gct_const := want_const && str.StartsWith(cg_ctype(ts), "const ")
            pfx := (want_const && !gct_const) ? "const " : ""
            if d.a != 0:
                out(g, pfx + decl + " = " + cg_expr(g, s, a, d.a) + ";\n")
            else:
                out(g, pfx + decl + ";\n")
            end
        end
    end
    out(g, "\n")
end

func emit_impl_protos(g &: Cg, s &: sm.Sema, a &: at.Ast):
    gsc := sm.ScopeAt(s, s.global)
    repeat gsc.symbols.len() with i:
        oid := gsc.symbols.get(i)[0]
        owner := sm.SymAt(s, oid)
        if owner.kind != sm.SYM_TYPEIMPL || owner.members == 0:
            continue
        end
        msc := sm.ScopeAt(s, owner.members)
        repeat msc.symbols.len() with j:
            m := sm.SymAt(s, msc.symbols.get(j)[0])
            if m.kind != sm.SYM_METHOD:
                continue
            end
            repeat m.overloads.len() with k:
                sig := m.overloads.get(k)[0]
                if sig != 0 && sm.SigAt(s, sig).decl != 0:
                    out(
                        g, func_signature(
                            g, s, a, sm.SigAt(s, sig).decl, oid, sig, false
                        ) + ";\n"
                    )
                end
            end
        end
    end
end

func emit_impl_bodies(g &: Cg, s &: sm.Sema, a &: at.Ast):
    gsc := sm.ScopeAt(s, s.global)
    repeat gsc.symbols.len() with i:
        oid := gsc.symbols.get(i)[0]
        owner := sm.SymAt(s, oid)
        if owner.kind != sm.SYM_TYPEIMPL || owner.members == 0:
            continue
        end
        msc := sm.ScopeAt(s, owner.members)
        repeat msc.symbols.len() with j:
            m := sm.SymAt(s, msc.symbols.get(j)[0])
            if m.kind != sm.SYM_METHOD:
                continue
            end
            repeat m.overloads.len() with k:
                sig := m.overloads.get(k)[0]
                if sig != 0 && sm.SigAt(s, sig).decl != 0:
                    cg_function(g, s, a, sm.SigAt(s, sig).decl, oid)
                end
            end
        end
    end
end

func inl_name_in(names: Vector<str>, name: str): bool:
    repeat names.len() with i:
        if str.Equals(names.get(i)[0], name):
            ret true
        end
    end
    ret false
end

func inl_collect_locals(a &: at.Ast, names &: Vector<str>, id: int):
    if id == 0:
        ret
    end
    n := at.Get(a, id)
    if str.Len(n.name) > 0 && (
        n.kind == at.AST_PARAM || n.kind == at.AST_VAR_DECL || n.kind == at.AST_FOR || n.kind == at.AST_REPEAT
    ):
        names.push(n.name)
    end
    inl_collect_locals(a, names, n.a)
    inl_collect_locals(a, names, n.b)
    inl_collect_locals(a, names, n.c)
    inl_collect_locals(a, names, n.d)
    repeat n.list.len() with i:
        inl_collect_locals(a, names, n.list.get(i)[0])
    end
end

// inl_sym_decl - SymId -> at.NodeId (0 = C NULL).
func inl_sym_decl(s &: sm.Sema, symid: int): int:
    sv := sm.SymAt(s, symid)
    if sv.decl != 0:
        ret sv.decl
    end
    if sv.overloads.len() > 0:
        sig := sv.overloads.get(0)[0]
        if sig != 0:
            ret sm.SigAt(s, sig).decl
        end
    end
    ret 0
end

func inl_body_exportable(
    s &: sm.Sema, a &: at.Ast, names: Vector<str>, id: int
): bool:
    if id == 0:
        ret true
    end
    n := at.Get(a, id)
    if n.kind == at.AST_LAMBDA:
        ret false
    end
    if n.kind == at.AST_IDENTIFIER && str.Len(n.name) > 0 && !inl_name_in(names, n.name):
        symid := sm.LookupLocal(s, s.global, n.name)
        if symid != 0:
            sk := sm.SymAt(s, symid).kind
            if sk == sm.SYM_FUNC || sk == sm.SYM_VAR || sk == sm.SYM_CONST:
                decl := inl_sym_decl(s, symid)
                if decl != 0:
                    dn := at.Get(a, decl)
                    if !dn.is_pub && !dn.is_extern:
                        ret false
                    end
                end
            end
        end
    end
    if !inl_body_exportable(s, a, names, n.a):
        ret false
    end
    if !inl_body_exportable(s, a, names, n.b):
        ret false
    end
    if !inl_body_exportable(s, a, names, n.c):
        ret false
    end
    if !inl_body_exportable(s, a, names, n.d):
        ret false
    end
    repeat n.list.len() with i:
        if !inl_body_exportable(s, a, names, n.list.get(i)[0]):
            ret false
        end
    end
    ret true
end

func demote_nonexportable_inlines(
    g &: Cg, s &: sm.Sema, a &: at.Ast, program: int
):
    prog := at.Get(a, program)
    repeat prog.list.len() with i:
        did := prog.list.get(i)[0]
        d := at.Get(a, did)
        if d.kind != at.AST_FUNC_DEF || !d.is_inline:
            continue
        end
        if d.typarams.len() > 0 || d.synthetic || d.is_extern:
            continue
        end
        if str.Equals(d.name, g.entry):
            mut dn := at.Get(a, did)
            dn.is_inline = false
            at.Put(a, did, dn)
            continue
        end
        if !d.is_pub:
            continue
        end
        mut names := Vector {} as Vector<str>
        inl_collect_locals(a, names, did)
        if !inl_body_exportable(s, a, names, d.a):
            mut dn2 := at.Get(a, did)
            dn2.is_inline = false
            at.Put(a, did, dn2)
            lg.Log(
                g.log, lg.PH_CODEGEN, lg.LOG_INFO, "inline '" + d.name + "' uses module-private symbols; " + "emitting it as a regular function"
            )
        end
        names.free()
    end
end

func emit_inline_header(g &: Cg, s &: sm.Sema, a &: at.Ast, program: int):
    save := g.cur
    g.cur = CG_OUT_H
    prog := at.Get(a, program)
    repeat prog.list.len() with i:
        did := prog.list.get(i)[0]
        d := at.Get(a, did)
        if d.kind != at.AST_FUNC_DEF || !d.is_inline || !d.is_pub:
            continue
        end
        if d.typarams.len() > 0 || d.synthetic || d.is_extern || d.a == 0:
            continue
        end
        cg_function(g, s, a, did, 0)
    end
    g.cur = save
end

func emit_function_bodies(g &: Cg, s &: sm.Sema, a &: at.Ast, program: int):
    prog := at.Get(a, program)
    repeat prog.list.len() with i:
        did := prog.list.get(i)[0]
        d := at.Get(a, did)
        if d.typarams.len() > 0:
            continue
        end
        if d.synthetic:
            continue
        end
        if d.kind == at.AST_FUNC_DEF:
            if d.is_extern && d.a == 0:
                continue
            end
            if d.is_inline && d.is_pub:
                continue
            end
            cg_function(g, s, a, did, 0)
        else d.kind == at.AST_STRUCT_DEF:
            ssym := sm.LookupLocal(s, s.global, d.name)
            repeat d.list.len() with j:
                mid := d.list.get(j)[0]
                if at.KindOf(a, mid) == at.AST_FUNC_DEF:
                    cg_function(g, s, a, mid, ssym)
                end
            end
        else d.kind == at.AST_LAYOUT_BLOCK:
            out(g, "/* layout block omitted in general (C) mode */\n\n")
        end
    end
end

func inst_fn_name(s &: sm.Sema, owner: int, fname: str, sig: int): str:
    ret cg_mangle_in(
        s, "g", owner != 0 ? sm.SymAt(s, owner).name : "", fname, sm.SigAt(s, sig).params
    )
end

func emit_instances_header(
    g &: Cg, s &: sm.Sema, a &: at.Ast, program: int
):
    prog := at.Get(a, program)
    repeat prog.list.len() with i:
        did := prog.list.get(i)[0]
        d := at.Get(a, did)
        if !d.synthetic:
            continue
        end
        if d.kind == at.AST_FUNC_DEF && !d.is_extern:
            fsym := sm.LookupLocal(s, s.global, d.name)
            sig := sig_of_decl(s, fsym, did)
            if sig == 0:
                continue
            end
            nm := inst_fn_name(s, 0, d.name, sig)
            outh(
                g, "#ifndef SALAM_IP_" + nm + "\n#define SALAM_IP_" + nm + "\n" + func_signature(g, s, a, did, 0, sig, false) + ";\n#endif\n"
            )
        else d.kind == at.AST_STRUCT_DEF:
            ssym := sm.LookupLocal(s, s.global, d.name)
            if ssym == 0:
                continue
            end
            repeat d.list.len() with j:
                mid := d.list.get(j)[0]
                m := at.Get(a, mid)
                if m.kind != at.AST_FUNC_DEF:
                    continue
                end
                msym := sm.LookupLocal(s, sm.SymAt(s, ssym).members, m.name)
                sig2 := sig_of_decl(s, msym, mid)
                if sig2 == 0:
                    continue
                end
                nm2 := inst_fn_name(s, ssym, m.name, sig2)
                outh(
                    g, "#ifndef SALAM_IP_" + nm2 + "\n#define SALAM_IP_" + nm2 + "\n" + func_signature(g, s, a, mid, ssym, sig2, false) + ";\n#endif\n"
                )
            end
        end
    end
    save := g.cur
    g.cur = CG_OUT_H
    repeat prog.list.len() with i2:
        did := prog.list.get(i2)[0]
        d := at.Get(a, did)
        if !d.synthetic:
            continue
        end
        if d.kind == at.AST_FUNC_DEF && !d.is_extern && d.a != 0:
            fsym := sm.LookupLocal(s, s.global, d.name)
            sig := sig_of_decl(s, fsym, did)
            if sig == 0:
                continue
            end
            nm := inst_fn_name(s, 0, d.name, sig)
            outh(
                g, "#ifndef SALAM_IB_" + nm + "\n#define SALAM_IB_" + nm + "\n"
            )
            cg_function(g, s, a, did, 0)
            outh(g, "#endif\n")
        else d.kind == at.AST_STRUCT_DEF:
            ssym := sm.LookupLocal(s, s.global, d.name)
            if ssym == 0:
                continue
            end
            repeat d.list.len() with j:
                mid := d.list.get(j)[0]
                m := at.Get(a, mid)
                if m.kind != at.AST_FUNC_DEF:
                    continue
                end
                msym := sm.LookupLocal(s, sm.SymAt(s, ssym).members, m.name)
                sig2 := sig_of_decl(s, msym, mid)
                if sig2 == 0:
                    continue
                end
                nm2 := inst_fn_name(s, ssym, m.name, sig2)
                outh(
                    g, "#ifndef SALAM_IB_" + nm2 + "\n#define SALAM_IB_" + nm2 + "\n"
                )
                cg_function(g, s, a, mid, ssym)
                outh(g, "#endif\n")
            end
        end
    end
    g.cur = save
end

// cg_tidy - trims trailing whitespace, collapses blank-line runs, drops
// leading/trailing blank lines. Every emitted line ends with '\n'.
func cg_tidy(sn: str): str:
    mut b := co.SbNew()
    mut emitted := false
    mut pending := false
    n := str.Len(sn)
    mut i := 0
    until i < n:
        mut nl := 0 - 1
        mut j := i
        until j < n:
            if byte_at(sn, j) == 10:
                nl = j
                break
            end
            j += 1
        end
        linelen := nl >= 0 ? nl - i : n - i
        mut endw := linelen
        until endw > 0:
            c := byte_at(sn, i + endw - 1)
            if c == 13 || c == 32 || c == 9:
                endw -= 1
            else:
                break
            end
        end
        if endw == 0:
            if emitted:
                pending = true
            end
        else:
            if pending:
                co.SbPutc(b, 10)
                pending = false
            end
            mut k := 0
            until k < endw:
                co.SbPutc(b, byte_at(sn, i + k))
                k += 1
            end
            co.SbPutc(b, 10)
            emitted = true
        end
        if nl < 0:
            break
        end
        i = nl + 1
    end
    r := co.SbCstr(b)
    co.SbFree(b)
    ret r
end

func node_uses_spawn(a &: at.Ast, id: int): bool:
    if id == 0:
        ret false
    end
    n := at.Get(a, id)
    if n.kind == at.AST_CALL && n.a != 0:
        an := at.Get(a, n.a)
        if an.kind == at.AST_IDENTIFIER && str.Equals(an.name, "spawn"):
            ret true
        end
    end
    if node_uses_spawn(a, n.a) || node_uses_spawn(a, n.b) || node_uses_spawn(a, n.c) || node_uses_spawn(a, n.d):
        ret true
    end
    repeat n.list.len() with i:
        if node_uses_spawn(a, n.list.get(i)[0]):
            ret true
        end
    end
    ret false
end

func module_single_threaded_impl(a &: at.Ast, program: int): bool:
    prog := at.Get(a, program)
    repeat prog.list.len() with i:
        did := prog.list.get(i)[0]
        d := at.Get(a, did)
        if d.kind == at.AST_IMPORT:
            mut p := d.name
            if d.value_kind == tok.TV_STRING && str.Len(d.value_str) > 0:
                p = d.value_str
            end
            if str.Len(p) > 0 && str.Contains(p, "thread"):
                ret false
            end
        end
        if node_uses_spawn(a, did):
            ret false
        end
    end
    ret true
end

// Releases everything the Cg owns (the C freed the sbs; the arena took the
// vectors).
func cg_free(g &: Cg):
    str.BufFree(g.bh)
    str.BufFree(g.bc)
    str.BufFree(g.blamd)
    str.BufFree(g.blamf)
    g.locals.free()
    g.vec_types.free()
    g.variant_types.free()
    g.dyn_ifaces.free()
    g.dyn_impls.free()
    g.deferred.free()
    g.fn_defers.free()
end

// ===========================================================================
// 6b - codegen_expr.c / codegen_stmt.c / codegen_call.c / codegen_lambda.c /
// codegen_overload.c (minus sig_of_decl, ported in 6a above).
// "" = the C NULL for every str return; SymId/SigId/NodeId 0 = C NULL.
// ===========================================================================

// --- shared 6b helpers (no direct C equivalent) ---

// sb_puts(cg->lam_decls, s) - always the lambda-decls builder.
func outd(g &: Cg, s2: str):
    str.BufAppend(g.blamd, s2)
end

// Length of the CURRENT sink (used to capture nested stmt emission the way
// the C swapped cg->c to a local sb).
func cur_sink_len(g &: Cg): i64:
    if g.cur == CG_OUT_H:
        ret str.BufLen(g.bh)
    else g.cur == CG_OUT_LAMD:
        ret str.BufLen(g.blamd)
    else g.cur == CG_OUT_LAMF:
        ret str.BufLen(g.blamf)
    end
    ret str.BufLen(g.bc)
end

func sb_take(b &: str.StringBuilder, mark: i64): str:
    total := str.BufLen(b)
    if total <= mark:
        ret ""
    end
    full := str.BufStr(b)
    r := str.Substr(full, mark as int, (total - mark) as int)
    b._len = mark
    ret r
end

// Extract everything appended to the current sink after `mark` and roll the
// sink back (replaces the C's local sb_t capture in cg_match_expr).
func cur_sink_take(g &: Cg, mark: i64): str:
    if g.cur == CG_OUT_H:
        ret sb_take(g.bh, mark)
    else g.cur == CG_OUT_LAMD:
        ret sb_take(g.blamd, mark)
    else g.cur == CG_OUT_LAMF:
        ret sb_take(g.blamf, mark)
    end
    ret sb_take(g.bc, mark)
end

// cg->locals.len = mark (the C truncated the vec in place).
func locals_trunc(g &: Cg, mark: int):
    until g.locals.len() > mark:
        _dropped := g.locals.pop()
    end
end

// ===== codegen_overload.c (rest) =====

// pick_overload - SigId (0 = C NULL). fsym is a SymId, call an at.NodeId.
func pick_overload(s &: sm.Sema, a &: at.Ast, fsym: int, call: int): int:
    mut fallback := 0
    fs := sm.SymAt(s, fsym)
    cn := at.Get(a, call)
    repeat fs.overloads.len() with i:
        sg := fs.overloads.get(i)[0]
        if fallback == 0:
            fallback = sg
        end
        sv := sm.SigAt(s, sg)
        if cn.list.len() < sv.required:
            continue
        end
        if !sv.variadic && cn.list.len() > sv.params.len():
            continue
        end
        mut nfix := cn.list.len()
        if nfix > sv.params.len():
            nfix = sv.params.len()
        end
        mut ok := true
        repeat nfix with j:
            argn := at.Get(a, cn.list.get(j)[0])
            pt := sm.ToString(s, sv.params.get(j)[0])
            if str.Len(argn.type_str) == 0 || !str.Equals(argn.type_str, pt):
                ok = false
                break
            end
        end
        if ok:
            ret sg
        end
    end
    ret fallback
end

// struct_by_name - SymId (0 = C NULL).
func struct_by_name(s &: sm.Sema, name: str): int:
    sy := sm.Lookup(s, s.global, name)
    if sy != 0 && sm.SymAt(s, sy).kind == sm.SYM_STRUCT:
        ret sy
    end
    gsc := sm.ScopeAt(s, s.global)
    repeat gsc.symbols.len() with i:
        symid := gsc.symbols.get(i)[0]
        sv := sm.SymAt(s, symid)
        if sv.kind == sm.SYM_STRUCT && sv.ty != sm.TYPE_NONE && str.Equals(sm.TypeAt(s, sv.ty).name, name) && str.Len(sm.TypeAt(s, sv.ty).name) > 0:
            ret symid
        end
    end
    repeat gsc.symbols.len() with i2:
        pkid := gsc.symbols.get(i2)[0]
        pk := sm.SymAt(s, pkid)
        if pk.kind != sm.SYM_PACKAGE || pk.members == 0:
            continue
        end
        psc := sm.ScopeAt(s, pk.members)
        repeat psc.symbols.len() with j:
            symid2 := psc.symbols.get(j)[0]
            sv2 := sm.SymAt(s, symid2)
            if sv2.kind != sm.SYM_STRUCT:
                continue
            end
            if str.Equals(sv2.name, name):
                ret symid2
            end
            if sv2.ty != sm.TYPE_NONE && str.Len(sm.TypeAt(s, sv2.ty).name) > 0 && str.Equals(sm.TypeAt(s, sv2.ty).name, name):
                ret symid2
            end
        end
    end
    ret 0
end

// A member/index expression is only really addressable in the emitted C if
// its BASE is: `x.field`/`x[i]` need `x` itself to be a real lvalue (or a
// compound literal, which C99 lvalues too). A base that is itself a call
// result (e.g. `sm.SymAt(s, sym).overloads`) is emitted as a GNU
// statement-expression (see call_sret) whose value gcc/clang do NOT treat
// as addressable once a further `.field`/`&(...)` is chained onto it
// ("lvalue required as unary '&' operand") - so this must recurse into the
// base rather than assume every AST_MEMBER/AST_INDEX is addressable.
func cg_addressable(a &: at.Ast, n: int): bool:
    k := at.KindOf(a, n)
    if k == at.AST_MEMBER || k == at.AST_INDEX:
        ret cg_addressable(a, at.Get(a, n).a)
    end
    ret k == at.AST_IDENTIFIER || k == at.AST_THIS || k == at.AST_STRUCT_LIT
end

// cg_struct_of - SymId; sname gets the parsed base typestr (the C wrote
// into the caller's char sname[96] buffer).
func cg_struct_of(s &: sm.Sema, ts: str, sname &: str): int:
    mut ptr := false
    mut dims := Vector {} as Vector<int>
    defer dims.free()
    parse_typestr(ts, 96, sname, ptr, dims)
    ret struct_by_name(s, sname)
end

// cg_op_method - "" = C NULL.
func cg_op_method(k: int): str:
    if k == tok.TK_PLUS:
        ret "operator_add"
    end
    if k == tok.TK_MINUS:
        ret "operator_sub"
    end
    if k == tok.TK_STAR:
        ret "operator_mul"
    end
    if k == tok.TK_SLASH:
        ret "operator_div"
    end
    if k == tok.TK_PERCENT:
        ret "operator_mod"
    end
    if k == tok.TK_POWER:
        ret "operator_pow"
    end
    if k == tok.TK_EQ:
        ret "operator_eq"
    end
    if k == tok.TK_NE:
        ret "operator_ne"
    end
    if k == tok.TK_LT:
        ret "operator_lt"
    end
    if k == tok.TK_GT:
        ret "operator_gt"
    end
    if k == tok.TK_LE:
        ret "operator_le"
    end
    if k == tok.TK_GE:
        ret "operator_ge"
    end
    ret ""
end

// cg_compound_base - tok.TK_EOF = none.
func cg_compound_base(k: int): int:
    if k == tok.TK_PLUS_EQ:
        ret tok.TK_PLUS
    end
    if k == tok.TK_MINUS_EQ:
        ret tok.TK_MINUS
    end
    if k == tok.TK_STAR_EQ:
        ret tok.TK_STAR
    end
    if k == tok.TK_SLASH_EQ:
        ret tok.TK_SLASH
    end
    if k == tok.TK_PERCENT_EQ:
        ret tok.TK_PERCENT
    end
    if k == tok.TK_POWER_EQ:
        ret tok.TK_POWER
    end
    ret tok.TK_EOF
end

// pick_op_overload - SigId; first overload with the wanted param count.
func pick_op_overload(s &: sm.Sema, msym: int, want_nparams: int): int:
    mut fallback := 0
    ms := sm.SymAt(s, msym)
    repeat ms.overloads.len() with i:
        sg := ms.overloads.get(i)[0]
        if sm.SigAt(s, sg).params.len() == want_nparams:
            if fallback == 0:
                fallback = sg
            end
        end
    end
    ret fallback
end

// ===== codegen_expr.c =====

// cg_op - token kind -> C operator text.
func cg_op(k: int): str:
    if k == tok.TK_PLUS:
        ret "+"
    end
    if k == tok.TK_MINUS:
        ret "-"
    end
    if k == tok.TK_STAR:
        ret "*"
    end
    if k == tok.TK_SLASH:
        ret "/"
    end
    if k == tok.TK_PERCENT:
        ret "%"
    end
    if k == tok.TK_EQ:
        ret "=="
    end
    if k == tok.TK_NE:
        ret "!="
    end
    if k == tok.TK_LT:
        ret "<"
    end
    if k == tok.TK_GT:
        ret ">"
    end
    if k == tok.TK_LE:
        ret "<="
    end
    if k == tok.TK_GE:
        ret ">="
    end
    if k == tok.TK_AND:
        ret "&&"
    end
    if k == tok.TK_OR:
        ret "||"
    end
    if k == tok.TK_NOT:
        ret "!"
    end
    if k == tok.TK_AMP:
        ret "&"
    end
    if k == tok.TK_PIPE:
        ret "|"
    end
    if k == tok.TK_CARET:
        ret "^"
    end
    if k == tok.TK_TILDE:
        ret "~"
    end
    if k == tok.TK_SHL:
        ret "<<"
    end
    if k == tok.TK_SHR:
        ret ">>"
    end
    if k == tok.TK_ASSIGN:
        ret "="
    end
    if k == tok.TK_PLUS_EQ:
        ret "+="
    end
    if k == tok.TK_MINUS_EQ:
        ret "-="
    end
    if k == tok.TK_STAR_EQ:
        ret "*="
    end
    if k == tok.TK_SLASH_EQ:
        ret "/="
    end
    if k == tok.TK_PERCENT_EQ:
        ret "%="
    end
    if k == tok.TK_AMP_EQ:
        ret "&="
    end
    if k == tok.TK_PIPE_EQ:
        ret "|="
    end
    if k == tok.TK_CARET_EQ:
        ret "^="
    end
    if k == tok.TK_SHL_EQ:
        ret "<<="
    end
    if k == tok.TK_SHR_EQ:
        ret ">>="
    end
    ret "?"
end

func cg_is_str_ts(ts: str): bool:
    ret str.Equals(ts, "str") || str.Equals(ts, "uchar")
end

func cg_str_operand(g &: Cg, s &: sm.Sema, a &: at.Ast, n: int): str:
    nn := at.Get(a, n)
    if cg_is_str_ts(nn.type_str):
        ret cg_expr(g, s, a, n)
    end
    ret "salam_tostr_" + prim_suffix(print_tag(nn.type_str)) + "(" + cg_expr(g, s, a, n) + ")"
end

// cg_cescape - C string literal escaping (bug-compat: stops at a NUL byte
// like the C's char* walk).
func cg_cescape(sv: str): str:
    mut b := co.SbNew()
    co.SbPutc(b, 34)
    n := str.Len(sv)
    mut i := 0
    until i < n:
        c := byte_at(sv, i)
        if c == 0:
            break
        end
        if c == 10:
            co.SbPuts(b, "\\n")
        else c == 9:
            co.SbPuts(b, "\\t")
        else c == 13:
            co.SbPuts(b, "\\r")
        else c == 7:
            co.SbPuts(b, "\\a")
        else c == 8:
            co.SbPuts(b, "\\b")
        else c == 12:
            co.SbPuts(b, "\\f")
        else c == 11:
            co.SbPuts(b, "\\v")
        else c == 34:
            co.SbPuts(b, "\\\"")
        else c == 92:
            co.SbPuts(b, "\\\\")
        else:
            if c < 32 || c >= 127:
                co.SbPutc(b, 92)
                co.SbPutc(b, 48 + ((c >> 6) & 7))
                co.SbPutc(b, 48 + ((c >> 3) & 7))
                co.SbPutc(b, 48 + (c & 7))
            else:
                co.SbPutc(b, c)
            end
        end
        i += 1
    end
    co.SbPutc(b, 34)
    r := co.SbCstr(b)
    co.SbFree(b)
    ret r
end

func cg_match_arm_cond(
    g &: Cg, s &: sm.Sema, a &: at.Ast, arm: int, subj_var: str, subj_ts: str
): str:
    armn := at.Get(a, arm)
    is_variant := str.StartsWith(subj_ts, "Variant<")
    mut b := co.SbNew()
    if armn.op == tok.TK_KW_ELSE:
        co.SbPuts(b, "1")
    else:
        repeat armn.list.len() with i:
            patn := at.Get(a, armn.list.get(i)[0])
            if i > 0:
                co.SbPuts(b, " || ")
            end
            if is_variant:
                co.SbPuts(
                    b, "((" + subj_var + ").tag == " + (patn.value_int as int) + ")"
                )
            else cg_is_str_ts(subj_ts):
                co.SbPuts(
                    b, "(strcmp(" + subj_var + ", " + cg_expr(g, s, a, patn.a) + ") == 0)"
                )
            else:
                co.SbPuts(
                    b, "((" + subj_var + ") == (" + cg_expr(g, s, a, patn.a) + "))"
                )
            end
        end
    end
    r := co.SbCstr(b)
    co.SbFree(b)
    ret r
end

func cg_variant_box(g &: Cg, s &: sm.Sema, a &: at.Ast, n: int): str:
    nn := at.Get(a, n)
    vts := str.Len(nn.type_str) > 0 ? nn.type_str : "Variant<i32, i32>"
    vc := cg_variant_cname(vts)
    tag := nn.value_int as int
    ret "(" + vc + "){ .tag = " + tag + ", .payload = { .v" + tag + " = (" + cg_expr(g, s, a, nn.a) + ") } }"
end

func cg_variant_unwrap(g &: Cg, s &: sm.Sema, a &: at.Ast, n: int): str:
    nn := at.Get(a, n)
    member_ts := str.Len(nn.type_str) > 0 ? nn.type_str : "i32"
    variant_ts := at.Get(a, nn.a).type_str
    mut tag := cg_variant_tag_of(variant_ts, member_ts)
    if tag < 0:
        tag = 0
    end
    ret "(" + cg_expr(g, s, a, nn.a) + ").payload.v" + tag
end

func cg_match_expr(g &: Cg, s &: sm.Sema, a &: at.Ast, n: int): str:
    nn := at.Get(a, n)
    g.tmpn += 1
    t := g.tmpn
    rty := cg_ctype(str.Len(nn.type_str) > 0 ? nn.type_str : "int32_t")
    subj_ts := at.Get(a, nn.a).type_str
    sty := cg_ctype(str.Len(subj_ts) > 0 ? subj_ts : "int32_t")
    subj_var := "__msubj" + t
    res_var := "__mres" + t
    end_lbl := "__mend" + t
    saved_tmp := g.match_result_tmp
    saved_lbl := g.match_end_label
    mut has_wildcard := false
    mut b := co.SbNew()
    co.SbPuts(
        b, "({ " + rty + " " + res_var + "; " + sty + " " + subj_var + " = (" + cg_expr(g, s, a, nn.a) + ");\n"
    )
    g.match_result_tmp = res_var
    g.match_end_label = end_lbl
    repeat nn.list.len() with i:
        armid := nn.list.get(i)[0]
        armn := at.Get(a, armid)
        cond := cg_match_arm_cond(g, s, a, armid, subj_var, subj_ts)
        if armn.op == tok.TK_KW_ELSE:
            has_wildcard = true
        end
        co.SbPuts(b, (i > 0 ? "else" : "") + " if (" + cond + ") {\n")
        saved_indent := g.indent
        mark := g.locals.len()
        pos := cur_sink_len(g)
        g.indent = 0
        bn := at.Get(a, armn.b)
        repeat bn.list.len() with j:
            cg_stmt(g, s, a, bn.list.get(j)[0])
        end
        g.indent = saved_indent
        locals_trunc(g, mark)
        co.SbPuts(b, cur_sink_take(g, pos))
        co.SbPuts(b, "}\n")
    end
    if !has_wildcard:
        co.SbPuts(b, "else { salam_panic(\"no match arm matched\"); }\n")
    end
    co.SbPuts(b, end_lbl + ": " + res_var + "; })")
    g.match_result_tmp = saved_tmp
    g.match_end_label = saved_lbl
    r := co.SbCstr(b)
    co.SbFree(b)
    ret r
end

func cg_dyn_box(g &: Cg, s &: sm.Sema, a &: at.Ast, n: int): str:
    nn := at.Get(a, n)
    iface := str.Substr(nn.type_str, 4, str.Len(nn.type_str) - 4)
    concrete := at.Get(a, nn.a).type_str
    ci := cg_cident(iface)
    cc2 := cg_cident(concrete)
    g.tmpn += 1
    t := g.tmpn
    ret "({ " + cc2 + "* __dp" + t + " = (" + cc2 + "*)" + CG_MEM_ALLOC + "((uint64_t)sizeof(" + cc2 + ")); *__dp" + t + " = (" + cg_expr(g, s, a, nn.a) + "); (_Salam_dyn_" + ci + "){ (void*)__dp" + t + ", &_Salam_vtbl_" + ci + "_" + cc2 + " }; })"
end

// cg_emit_op_call - operator overloads. lhs/rhs are at.NodeIds (rhs 0 =
// the C NULL), ssym a SymId; returns "" for the C NULL.
func cg_emit_op_call(
    g &: Cg, s &: sm.Sema, a &: at.Ast, lhs: int, ssym: int, sname: str, mname: str, rhs: int
): str:
    m := sm.LookupLocal(s, sm.SymAt(s, ssym).members, mname)
    if m == 0 || sm.SymAt(s, m).kind != sm.SYM_METHOD:
        ret ""
    end
    nparams := rhs != 0 ? 1 : 0
    sig := pick_op_overload(s, m, nparams)
    if sig == 0:
        ret ""
    end
    mangled := cg_mangle_method(
        g, s, sname, ssym, mname, sm.SigAt(s, sig).params
    )
    ret_struct := type_is_byval_agg(s, sm.SigAt(s, sig).ret_type)
    mut rc := ""
    if ret_struct:
        rc = cg_ctype(sm.ToString(s, sm.SigAt(s, sig).ret_type))
    end
    lhs_ts := at.Get(a, lhs).type_str
    lhs_is_ptr := str.Len(lhs_ts) > 0 && str.EndsWith(lhs_ts, "*")
    addressable := cg_addressable(a, lhs)
    mut rhs_c := ""
    if rhs != 0:
        rhs_c = cg_expr(g, s, a, rhs)
    end
    sep := rhs != 0 ? ", " : ""
    if lhs_is_ptr || addressable:
        mut recv := ""
        if lhs_is_ptr:
            recv = cg_expr(g, s, a, lhs)
        else:
            recv = "&(" + cg_expr(g, s, a, lhs) + ")"
        end
        if ret_struct:
            g.tmpn += 1
            sv := g.tmpn
            ret "({ " + rc + " __s" + sv + "; " + mangled + "(" + recv + sep + rhs_c + ", &__s" + sv + "); __s" + sv + "; })"
        end
        ret mangled + "(" + recv + sep + rhs_c + ")"
    end
    g.tmpn += 1
    t := g.tmpn
    lhs_c := cg_expr(g, s, a, lhs)
    if ret_struct:
        g.tmpn += 1
        sv2 := g.tmpn
        ret "({ " + cg_ctype(lhs_ts) + " __t" + t + " = (" + lhs_c + "); " + rc + " __s" + sv2 + "; " + mangled + "(&__t" + t + sep + rhs_c + ", &__s" + sv2 + "); __s" + sv2 + "; })"
    end
    ret "({ " + cg_ctype(lhs_ts) + " __t" + t + " = (" + lhs_c + "); " + mangled + "(&__t" + t + sep + rhs_c + "); })"
end

func cg_struct_lit(g &: Cg, s &: sm.Sema, a &: at.Ast, n: int): str:
    nn := at.Get(a, n)
    ssym := struct_by_name(s, nn.name)
    mut sl_cn := nn.name
    if ssym != 0:
        sv := sm.SymAt(s, ssym)
        if sv.ty != sm.TYPE_NONE && str.Len(sm.TypeAt(s, sv.ty).name) > 0:
            sl_cn = sm.TypeAt(s, sv.ty).name
        end
    end
    mut b := co.SbNew()
    co.SbPuts(b, "(" + cg_cident(sl_cn) + "){ ")
    mut first := true
    if ssym != 0:
        msc := sm.ScopeAt(s, sm.SymAt(s, ssym).members)
        repeat msc.symbols.len() with i:
            f := sm.SymAt(s, msc.symbols.get(i)[0])
            if f.kind != sm.SYM_FIELD:
                continue
            end
            mut provided := 0
            repeat nn.list.len() with j:
                fiid := nn.list.get(j)[0]
                fi := at.Get(a, fiid)
                if provided == 0 && str.Len(fi.name) > 0 && str.Equals(fi.name, f.name):
                    provided = fiid
                end
            end
            mut val := ""
            mut has_val := false
            if provided != 0:
                val = cg_expr(g, s, a, at.Get(a, provided).a)
                has_val = true
            else f.decl != 0 && at.Get(a, f.decl).a != 0:
                val = cg_expr(g, s, a, at.Get(a, f.decl).a)
                has_val = true
            end
            if !has_val:
                continue
            end
            if !first:
                co.SbPuts(b, ", ")
            end
            co.SbPuts(b, "." + cg_cident(f.name) + " = " + val)
            first = false
        end
    end
    if first:
        co.SbPuts(b, "0")
    end
    co.SbPuts(b, " }")
    r := co.SbCstr(b)
    co.SbFree(b)
    ret r
end

// cg_expr - returns the C expression text ("0" for the C NULL node).
func cg_expr(g &: Cg, s &: sm.Sema, a &: at.Ast, n: int): str:
    if n == 0:
        ret "0"
    end
    nn := at.Get(a, n)
    k := nn.kind
    if k == at.AST_LITERAL:
        if nn.op == tok.TK_INT:
            u := nn.value_int
            ts := nn.type_str
            uns := str.Len(ts) > 0 && (byte_at(ts, 0) == 117 || str.Equals(ts, "size"))
            imax := 9223372036854775807 as u64
            if !uns && u > imax:
                if u == imax + (1 as u64):
                    ret "(-9223372036854775807LL - 1LL)"
                end
                ret "(" + co.I64Toa(u as i64) + "LL)"
            end
            mut suf := ""
            if u > imax:
                suf = "ULL"
            else u > (2147483647 as u64):
                suf = "LL"
            end
            ret co.U64Toa(u) + suf
        end
        if nn.op == tok.TK_FLOAT:
            buf := co.Format1("%.17g", co.ArgFloat(nn.value_float))
            nb := str.Len(buf)
            mut hasmark := false
            mut bi := 0
            until bi < nb:
                c2 := byte_at(buf, bi)
                if c2 == 46 || c2 == 101 || c2 == 69 || c2 == 110 || c2 == 78:
                    hasmark = true
                    break
                end
                bi += 1
            end
            if !hasmark:
                ret buf + ".0"
            end
            ret buf
        end
        if nn.op == tok.TK_STRING || nn.op == tok.TK_TRIPLE_STRING || nn.op == tok.TK_RAW_STRING || nn.op == tok.TK_UTF8_CHAR:
            ret cg_cescape(nn.value_str)
        end
        if nn.op == tok.TK_CHAR:
            ret co.U64Toa(nn.value_int)
        end
        if nn.op == tok.TK_KW_TRUE:
            ret "true"
        end
        if nn.op == tok.TK_KW_FALSE:
            ret "false"
        end
        if nn.op == tok.TK_KW_NULL:
            ret "NULL"
        end
        ret "0"
    end
    if k == at.AST_IDENTIFIER:
        if g.cur_lambda != 0:
            lam := at.Get(a, g.cur_lambda)
            repeat lam.captures.len() with ci:
                if str.Equals(
                    at.Get(a, lam.captures.get(ci)[0]).name, nn.name
                ):
                    ret "__env->" + cg_cident(nn.name)
                end
            end
        end
        if local_known(g, nn.name):
            if nn.is_ref:
                ret "(*" + cg_cident(nn.name) + ")"
            end
            ret cg_cident(nn.name)
        end
        if g.cur_struct != 0:
            f := sm.LookupLocal(
                s, sm.SymAt(s, g.cur_struct).members, nn.name
            )
            if f != 0 && sm.SymAt(s, f).kind == sm.SYM_FIELD:
                ret "this->" + cg_cident(nn.name)
            end
        end
        ret cg_cident(nn.name)
    end
    if k == at.AST_FUNC_ADDR:
        mut fsym := sm.Lookup(s, s.global, nn.name)
        mut home_pkg := ""
        if fsym == 0 && g.cur_fn_home != 0:
            hs := sm.Lookup(s, g.cur_fn_home, nn.name)
            if hs != 0 && sm.SymAt(s, hs).kind == sm.SYM_FUNC:
                fsym = hs
                home_pkg = sm.SymAt(s, hs).pkgname
            end
        end
        if fsym == 0 && g.cur_struct != 0 && sm.SymAt(s, g.cur_struct).home != 0:
            hs2 := sm.Lookup(s, sm.SymAt(s, g.cur_struct).home, nn.name)
            if hs2 != 0 && sm.SymAt(s, hs2).kind == sm.SYM_FUNC:
                fsym = hs2
                home_pkg = sm.SymAt(s, hs2).pkgname
            end
        end
        mut sig := 0
        if fsym != 0 && sm.SymAt(s, fsym).overloads.len() == 1:
            sig = sm.SymAt(s, fsym).overloads.get(0)[0]
        end
        is_extern_fn := sig != 0 && sm.SigAt(s, sig).decl != 0 && at.Get(a, sm.SigAt(s, sig).decl).is_extern
        mut raw := ""
        if is_extern_fn:
            raw = nn.name
        else:
            pkg2 := str.Len(home_pkg) > 0 ? home_pkg : g.pkg
            if sig != 0:
                raw = cg_mangle_in(
                    s, pkg2, "", nn.name, sm.SigAt(s, sig).params
                )
            else:
                mut empty := Vector {} as Vector<int>
                raw = cg_mangle_in(s, pkg2, "", nn.name, empty)
                empty.free()
            end
        end
        ret "((void*)(&" + raw + "))"
    end
    if k == at.AST_THIS:
        ret "this"
    end
    if k == at.AST_BINARY:
        an := at.Get(a, nn.a)
        bn := at.Get(a, nn.b)
        if nn.a != 0 && str.Len(an.type_str) > 0:
            mut sname := ""
            ssym := cg_struct_of(s, an.type_str, sname)
            if ssym != 0:
                neg_eq := nn.op == tok.TK_NE && nn.synthetic
                mname := neg_eq ? "operator_eq" : cg_op_method(nn.op)
                if str.Len(mname) > 0:
                    callv := cg_emit_op_call(
                        g, s, a, nn.a, ssym, sname, mname, nn.b
                    )
                    if str.Len(callv) > 0:
                        if neg_eq:
                            ret "(!(" + callv + "))"
                        end
                        ret callv
                    end
                end
            end
        end
        if nn.op == tok.TK_POWER:
            ea := cg_expr(g, s, a, nn.a)
            eb := cg_expr(g, s, a, nn.b)
            ret "pow((double)(" + ea + "), (double)(" + eb + "))"
        end
        if nn.op == tok.TK_PLUS && (cg_is_str_ts(an.type_str) || cg_is_str_ts(bn.type_str)):
            oa := cg_str_operand(g, s, a, nn.a)
            ob := cg_str_operand(g, s, a, nn.b)
            ret "salam_strcat(" + oa + ", " + ob + ")"
        end
        if nn.op == tok.TK_STAR && (cg_is_str_ts(an.type_str) || cg_is_str_ts(bn.type_str)):
            a_str := cg_is_str_ts(an.type_str)
            sop := a_str ? nn.a : nn.b
            nop := a_str ? nn.b : nn.a
            es := cg_expr(g, s, a, sop)
            en := cg_expr(g, s, a, nop)
            ret "salam_str_repeat(" + es + ", (int32_t)(" + en + "))"
        end
        if cg_is_str_ts(an.type_str) && cg_is_str_ts(bn.type_str):
            mut opv := ""
            if nn.op == tok.TK_EQ:
                opv = "=="
            else nn.op == tok.TK_NE:
                opv = "!="
            else nn.op == tok.TK_LT:
                opv = "<"
            else nn.op == tok.TK_GT:
                opv = ">"
            else nn.op == tok.TK_LE:
                opv = "<="
            else nn.op == tok.TK_GE:
                opv = ">="
            end
            if str.Len(opv) > 0:
                ea2 := cg_expr(g, s, a, nn.a)
                eb2 := cg_expr(g, s, a, nn.b)
                ret "(strcmp(" + ea2 + ", " + eb2 + ") " + opv + " 0)"
            end
        end
        ea3 := cg_expr(g, s, a, nn.a)
        eb3 := cg_expr(g, s, a, nn.b)
        ret "(" + ea3 + " " + cg_op(nn.op) + " " + eb3 + ")"
    end
    if k == at.AST_TERNARY:
        ea := cg_expr(g, s, a, nn.a)
        eb := cg_expr(g, s, a, nn.b)
        ec := cg_expr(g, s, a, nn.c)
        ret "((" + ea + ") ? (" + eb + ") : (" + ec + "))"
    end
    if k == at.AST_UNARY:
        if nn.a != 0 && str.Len(at.Get(a, nn.a).type_str) > 0:
            mut sname2 := ""
            ssym2 := cg_struct_of(s, at.Get(a, nn.a).type_str, sname2)
            if ssym2 != 0:
                mut mname2 := ""
                if nn.op == tok.TK_MINUS:
                    mname2 = "operator_sub"
                else nn.op == tok.TK_NOT:
                    mname2 = "operator_not"
                end
                if str.Len(mname2) > 0:
                    m2 := sm.LookupLocal(
                        s, sm.SymAt(s, ssym2).members, mname2
                    )
                    if m2 != 0 && sm.SymAt(s, m2).kind == sm.SYM_METHOD && pick_op_overload(s, m2, 0) != 0:
                        callv2 := cg_emit_op_call(
                            g, s, a, nn.a, ssym2, sname2, mname2, 0
                        )
                        if str.Len(callv2) > 0:
                            ret callv2
                        end
                    end
                end
            end
        end
        ret "(" + cg_op(nn.op) + cg_expr(g, s, a, nn.a) + ")"
    end
    if k == at.AST_INCDEC:
        opc := nn.op == tok.TK_PLUS_PLUS ? "++" : "--"
        operand := cg_expr(g, s, a, nn.a)
        if nn.is_prefix:
            ret "(" + opc + operand + ")"
        end
        ret "(" + operand + opc + ")"
    end
    if k == at.AST_CAST:
        if str.StartsWith(nn.type_str, "dyn ") && !str.EndsWith(nn.type_str, "*"):
            ret cg_dyn_box(g, s, a, n)
        end
        if nn.a != 0 && (
            at.KindOf(a, nn.a) == at.AST_ARRAY_LIT || at.KindOf(a, nn.a) == at.AST_STRUCT_LIT
        ):
            ret cg_expr(g, s, a, nn.a)
        end
        sts := nn.a != 0 ? at.Get(a, nn.a).type_str : ""
        dts := nn.ty != 0 ? at.Get(a, nn.ty).type_str : ""
        if str.Len(sts) > 0 && str.Len(dts) > 0 && str.Equals(sts, dts):
            ret cg_expr(g, s, a, nn.a)
        end
        dptr := str.Len(dts) > 0 && str.EndsWith(dts, "*")
        sptr := str.Len(sts) > 0 && str.EndsWith(sts, "*")
        tgt := str.Len(dts) > 0 ? dts : nn.type_str
        if (
            dptr != sptr && (cg_is_int_typestr(dts) || cg_is_int_typestr(sts))
        ) || (dptr && str.Equals(sts, "str") && !str.Equals(dts, "str")):
            ret "((" + cg_ctype(tgt) + ")(intptr_t)(" + cg_expr(g, s, a, nn.a) + "))"
        end
        ret "((" + cg_ctype(tgt) + ")(" + cg_expr(g, s, a, nn.a) + "))"
    end
    if k == at.AST_CALL:
        ret cg_call(g, s, a, n)
    end
    if k == at.AST_MEMBER:
        an2 := at.Get(a, nn.a)
        if nn.a != 0 && an2.kind == at.AST_IDENTIFIER && !local_known(g, an2.name):
            e := sm.Lookup(s, s.global, an2.name)
            if e != 0 && sm.SymAt(s, e).kind == sm.SYM_ENUM:
                ret cg_cident(sm.SymAt(s, e).name) + "_" + cg_cident(nn.name)
            end
            if e != 0 && sm.SymAt(s, e).kind == sm.SYM_PACKAGE:
                m := sm.LookupLocal(s, sm.SymAt(s, e).members, nn.name)
                if m != 0:
                    ms := sm.SymAt(s, m)
                    if ms.kind == sm.SYM_CONST && ms.decl != 0 && at.Get(a, ms.decl).a != 0:
                        ret cg_expr(g, s, a, at.Get(a, ms.decl).a)
                    end
                    if ms.decl != 0 && at.Get(a, ms.decl).a != 0:
                        ret cg_expr(g, s, a, at.Get(a, ms.decl).a)
                    end
                end
            end
        end
        objts := an2.type_str
        ptr := str.Len(objts) > 0 && str.EndsWith(objts, "*")
        ret cg_expr(g, s, a, nn.a) + (ptr ? "->" : ".") + cg_cident(nn.name)
    end
    if k == at.AST_INDEX:
        an3 := at.Get(a, nn.a)
        if nn.a != 0 && str.Len(an3.type_str) > 0:
            mut sname3 := ""
            ssym3 := cg_struct_of(s, an3.type_str, sname3)
            if ssym3 != 0:
                m3 := sm.LookupLocal(
                    s, sm.SymAt(s, ssym3).members, "operator_index"
                )
                if m3 != 0 && sm.SymAt(s, m3).kind == sm.SYM_METHOD:
                    callv3 := cg_emit_op_call(
                        g, s, a, nn.a, ssym3, sname3, "operator_index", nn.b
                    )
                    if str.Len(callv3) > 0:
                        ret callv3
                    end
                end
            end
        end
        if cg_is_slice_ts(an3.type_str):
            ec2 := cg_ctype(cg_slice_elem(an3.type_str, 96))
            se := cg_expr(g, s, a, nn.a)
            idx := cg_expr(g, s, a, nn.b)
            ret "(*(" + ec2 + "*)salam_slice_at(" + se + ", " + idx + ", (int64_t)sizeof(" + ec2 + "), " + (g.safe ? 1 : 0) + "))"
        end
        arr := cg_expr(g, s, a, nn.a)
        idx2 := cg_expr(g, s, a, nn.b)
        if g.safe:
            sz := array_size_of(an3.type_str)
            if sz > (0 as i64):
                ret arr + "[salam_idx(" + idx2 + ", " + co.I64Toa(sz) + ")]"
            end
        end
        ret arr + "[" + idx2 + "]"
    end
    if k == at.AST_SLICE:
        ec3 := cg_ctype(cg_slice_elem(nn.type_str, 96))
        base := cg_expr(g, s, a, nn.a)
        mut lo := "0"
        if nn.b != 0:
            lo = cg_expr(g, s, a, nn.b)
        end
        g.tmpn += 1
        t := g.tmpn
        a_ts := at.Get(a, nn.a).type_str
        if cg_is_slice_ts(a_ts):
            if nn.c != 0:
                ret "({ salam_slice __sl" + t + "; salam_slice_sub(&__sl" + t + ", " + base + ", " + lo + ", " + cg_expr(g, s, a, nn.c) + ", 1, (int64_t)sizeof(" + ec3 + ")); __sl" + t + "; })"
            end
            ret "({ salam_slice __sl" + t + "; salam_slice_sub(&__sl" + t + ", " + base + ", " + lo + ", 0, 0, (int64_t)sizeof(" + ec3 + ")); __sl" + t + "; })"
        end
        mut hi := ""
        if nn.c != 0:
            hi = cg_expr(g, s, a, nn.c)
        else:
            hi = co.I64Toa(array_size_of(a_ts))
        end
        ret "({ salam_slice __sl" + t + "; salam_slice_new(&__sl" + t + ", (void*)(" + base + "), " + lo + ", " + hi + ", (int64_t)sizeof(" + ec3 + ")); __sl" + t + "; })"
    end
    if k == at.AST_MATCH:
        ret cg_match_expr(g, s, a, n)
    end
    if k == at.AST_VARIANT_BOX:
        ret cg_variant_box(g, s, a, n)
    end
    if k == at.AST_VARIANT_UNWRAP:
        ret cg_variant_unwrap(g, s, a, n)
    end
    if k == at.AST_LAMBDA:
        ret cg_lambda_value(g, s, a, n)
    end
    if k == at.AST_STRUCT_LIT:
        ret cg_struct_lit(g, s, a, n)
    end
    if k == at.AST_ARRAY_LIT:
        mut b := co.SbNew()
        co.SbPutc(b, 123)
        repeat nn.list.len() with i:
            if i > 0:
                co.SbPuts(b, ", ")
            end
            co.SbPuts(b, cg_expr(g, s, a, nn.list.get(i)[0]))
        end
        co.SbPutc(b, 125)
        r := co.SbCstr(b)
        co.SbFree(b)
        ret r
    end
    ret "0"
end

// ===== codegen_call.c =====

func arg_at(g &: Cg, s &: sm.Sema, a &: at.Ast, n: int, i: int): str:
    cn := at.Get(a, n)
    if cn.list.len() > i:
        ret cg_expr(g, s, a, cn.list.get(i)[0])
    end
    ret "0"
end

func cg_fill_defaults(
    g &: Cg, s &: sm.Sema, a &: at.Ast, b &: str.StringBuilder, call: int, sig: int, emitted0: int
):
    if sig == 0 || sm.SigAt(s, sig).decl == 0:
        ret
    end
    dn := at.Get(a, sm.SigAt(s, sig).decl)
    np := dn.list.len()
    mut emitted := emitted0
    mut i := at.Get(a, call).list.len()
    until i < np:
        p := at.Get(a, dn.list.get(i)[0])
        if p.a != 0:
            if emitted > 0:
                co.SbPuts(b, ", ")
            end
            co.SbPuts(b, cg_expr(g, s, a, p.a))
            emitted += 1
        end
        i += 1
    end
end

// call_args - sig is a SigId (0 = C NULL).
func call_args(g &: Cg, s &: sm.Sema, a &: at.Ast, call: int, sig: int): str:
    mut b := co.SbNew()
    cn := at.Get(a, call)
    mut sdecl := 0
    if sig != 0:
        sdecl = sm.SigAt(s, sig).decl
    end
    repeat cn.list.len() with i:
        argid := cn.list.get(i)[0]
        if i > 0:
            co.SbPuts(b, ", ")
        end
        mut arg_is_ref := false
        if sig != 0 && sdecl != 0:
            dn := at.Get(a, sdecl)
            if i < dn.list.len():
                arg_is_ref = at.Get(a, dn.list.get(i)[0]).is_ref
            end
        end
        if arg_is_ref:
            sv := sm.SigAt(s, sig)
            mut ref_c := ""
            if cg_addressable(a, argid):
                ref_c = "&(" + cg_expr(g, s, a, argid) + ")"
            else:
                // argid isn't a real C lvalue (e.g. a member of a
                // byval-struct-returning call's result) - bind it to a
                // genuine local temp first, same fallback cg_method already
                // uses below, so `&` has an actual lvalue to operate on.
                g.tmpn += 1
                rt := g.tmpn
                argc := cg_expr(g, s, a, argid)
                argts := at.Get(a, argid).type_str
                ref_c = "({ " + cg_ctype(argts) + " __r" + rt + " = (" + argc + "); &__r" + rt + "; })"
            end
            if i < sv.params.len():
                co.SbPuts(
                    b, "(" + cg_ctype(sm.ToString(s, sv.params.get(i)[0])) + "*)" + ref_c
                )
            else:
                co.SbPuts(b, ref_c)
            end
        else:
            co.SbPuts(b, cg_expr(g, s, a, argid))
        end
    end
    cg_fill_defaults(g, s, a, b, call, sig, cn.list.len())
    r := co.SbCstr(b)
    co.SbFree(b)
    ret r
end

func call_args_lead(
    g &: Cg, s &: sm.Sema, a &: at.Ast, call: int, sig: int
): str:
    mut b := co.SbNew()
    cn := at.Get(a, call)
    repeat cn.list.len() with i:
        co.SbPuts(b, ", ")
        co.SbPuts(b, cg_expr(g, s, a, cn.list.get(i)[0]))
    end
    cg_fill_defaults(g, s, a, b, call, sig, 1)
    r := co.SbCstr(b)
    co.SbFree(b)
    ret r
end

// call_sret - ret_t is a sm TypeId.
func call_sret(
    g &: Cg, s &: sm.Sema, ret_t: int, mangled: str, args: str
): str:
    rc := cg_ctype(sm.ToString(s, ret_t))
    g.tmpn += 1
    t := g.tmpn
    sep := str.Len(args) > 0 ? ", " : ""
    ret "({ " + rc + " __s" + t + "; " + mangled + "(" + args + sep + "&__s" + t + "); __s" + t + "; })"
end

func call_value(
    g &: Cg, s &: sm.Sema, a &: at.Ast, n: int, callee: int
): str:
    callee_ts := at.Get(a, callee).type_str
    cret := cg_ctype(func_ret_of(callee_ts))
    cps := func_cast_params_env(callee_ts)
    args := call_args_lead(g, s, a, n, 0)
    tmp := "_clz" + g.clos_n
    g.clos_n += 1
    callee_c := cg_expr(g, s, a, callee)
    ret "({ void *" + tmp + " = (void*)(" + callee_c + "); ((" + cret + "(*)" + cps + ")(*(void**)" + tmp + "))(" + tmp + args + "); })"
end

// 'extern func(...)' values are raw C-ABI function pointers (no closure
// env word) - call the address directly.
func call_raw_ptr(
    g &: Cg, s &: sm.Sema, a &: at.Ast, n: int, callee: int
): str:
    callee_ts := at.Get(a, callee).type_str
    cret := cg_ctype(raw_ret_of(callee_ts))
    cps := raw_cast_params(callee_ts)
    args := call_args(g, s, a, n, 0)
    ret "((" + cret + "(*)" + cps + ")(" + cg_expr(g, s, a, callee) + "))(" + args + ")"
end

func cg_order_stdout(g &: Cg, printf_expr: str): str:
    if !g.single_threaded:
        ret printf_expr
    end
    ret "({ salam_out_flush(); " + printf_expr + "; fflush(0); })"
end

func cg_lower_print(
    g &: Cg, s &: sm.Sema, a &: at.Ast, n: int, nl: bool, err: bool
): str:
    mut segs := Vector {} as Vector<PfSeg>
    defer segs.free()
    pf_build_impl(a, n, nl, segs)
    if segs.len() == 0:
        ret "(void)0"
    end
    if !err && g.single_threaded:
        mut all_lit := true
        mut raw := co.SbNew()
        repeat segs.len() with i:
            sg := segs.get(i)[0]
            if sg.kind != PF_LIT:
                all_lit = false
                break
            end
            co.SbPuts(raw, sg.text)
        end
        if all_lit:
            rawlen := co.SbLen(raw)
            lit := cg_cescape(co.SbCstr(raw))
            co.SbFree(raw)
            ret "SALAM_OUT_LIT(" + lit + ", " + co.I64Toa(rawlen) + ")"
        end
        co.SbFree(raw)
    end
    mut fb := co.SbNew()
    mut ab := co.SbNew()
    repeat segs.len() with i2:
        sg2 := segs.get(i2)[0]
        if sg2.kind == PF_LIT:
            tn := str.Len(sg2.text)
            mut ti := 0
            until ti < tn:
                ch := byte_at(sg2.text, ti)
                if ch == 37:
                    co.SbPutc(fb, 37)
                end
                co.SbPutc(fb, ch)
                ti += 1
            end
            continue
        end
        e := cg_expr(g, s, a, sg2.expr)
        mut av := ""
        if sg2.kind == PF_CHAR:
            co.SbPuts(fb, "%s")
            av = "salam_char_from_code(" + e + ")"
        else sg2.kind == PF_BOOL:
            co.SbPuts(fb, pf_spec_impl(sg2.kind))
            av = "((" + e + ") ? \"true\" : \"false\")"
        else sg2.kind == PF_F64:
            co.SbPuts(fb, pf_spec_impl(sg2.kind))
            av = "(double)(" + e + ")"
        else sg2.kind == PF_U32:
            co.SbPuts(fb, pf_spec_impl(sg2.kind))
            av = "(unsigned)(" + e + ")"
        else sg2.kind == PF_I64:
            co.SbPuts(fb, pf_spec_impl(sg2.kind))
            av = "(long long)(" + e + ")"
        else sg2.kind == PF_U64:
            co.SbPuts(fb, pf_spec_impl(sg2.kind))
            av = "(unsigned long long)(" + e + ")"
        else sg2.kind == PF_SIZE:
            co.SbPuts(fb, pf_spec_impl(sg2.kind))
            av = "(size_t)(" + e + ")"
        else sg2.kind == PF_I32:
            co.SbPuts(fb, pf_spec_impl(sg2.kind))
            av = "(int)(" + e + ")"
        else:
            co.SbPuts(fb, pf_spec_impl(sg2.kind))
            av = e
        end
        co.SbPuts(ab, ", ")
        co.SbPuts(ab, av)
    end
    cfmt := cg_cescape(co.SbCstr(fb))
    al := co.SbCstr(ab)
    co.SbFree(fb)
    co.SbFree(ab)
    if err:
        ret cg_order_stdout(
            g, "({ int32_t __ern = snprintf((void*)0, (uint64_t)0, " + cfmt + al + "); char *__erb = __ern > 0 ? (char*)" + CG_MEM_ALLOC + "((uint64_t)__ern + 1) : (char*)0; if (__erb) snprintf(__erb, " + "(uint64_t)__ern + 1, " + cfmt + al + "); if (__erb) { int64_t __err_r = (int64_t)SALAM_RAW_WRITE(2, " + "__erb, __ern); (void)__err_r; } })"
        )
    end
    ret cg_order_stdout(g, "printf(" + cfmt + al + ")")
end

func call_ident(
    g &: Cg, s &: sm.Sema, a &: at.Ast, n: int, callee: int
): str:
    cn := at.Get(a, n)
    nm := at.Get(a, callee).name
    if str.Equals(nm, "spawn") && cn.list.len() == 1:
        fnn := at.Get(a, cn.list.get(0)[0])
        fsym := sm.Lookup(s, s.global, fnn.name)
        mut mangled := fnn.name
        if fsym != 0:
            mut empty := Vector {} as Vector<int>
            mangled = cg_mangle(g, s, "", fnn.name, empty)
            empty.free()
        end
        ret "salam_thread_spawn((salam_thread_fn)" + mangled + ")"
    end
    if str.Equals(nm, "funcptr") && cn.list.len() == 1:
        fnn2 := at.Get(a, cn.list.get(0)[0])
        fsym2 := sm.Lookup(s, s.global, fnn2.name)
        mut mangled2 := fnn2.name
        if fsym2 != 0 && sm.SymAt(s, fsym2).overloads.len() > 0:
            sig0 := sm.SymAt(s, fsym2).overloads.get(0)[0]
            mangled2 = cg_mangle(
                g, s, "", fnn2.name, sm.SigAt(s, sig0).params
            )
        end
        ret "(int64_t)(void*)" + mangled2
    end
    if str.Equals(nm, "callhandler") && cn.list.len() == 2:
        fnp := cg_expr(g, s, a, cn.list.get(0)[0])
        argx := cg_expr(g, s, a, cn.list.get(1)[0])
        ret "((void(*)(int64_t))(intptr_t)(" + fnp + "))((int64_t)(" + argx + "))"
    end
    is_print := str.Equals(nm, "print")
    is_println := str.Equals(nm, "println")
    is_printerr := str.Equals(nm, "printerr")
    is_printerrln := str.Equals(nm, "printerrln")
    if is_print || is_println || is_printerr || is_printerrln:
        ret cg_lower_print(
            g, s, a, n, is_println || is_printerrln, is_printerr || is_printerrln
        )
    end
    if str.Equals(nm, "input"):
        ret "salam_input()"
    end
    if str.Equals(nm, "lang"):
        ret "\"" + i18.Lang() + "\""
    end
    if str.Equals(nm, "args"):
        cnv := cg_ctype(str.Len(cn.type_str) > 0 ? cn.type_str : "Vector_str")
        g.tmpn += 1
        t := g.tmpn
        ret "({ int32_t __an" + t + "; const char** __ad" + t + " = salam_args(&__an" + t + "); (" + cnv + "){ __ad" + t + ", __an" + t + ", __an" + t + " }; })"
    end
    if str.Equals(nm, "listdir") && cn.list.len() == 1:
        cnv2 := cg_ctype(str.Len(cn.type_str) > 0 ? cn.type_str : "Vector_str")
        argx2 := cg_expr(g, s, a, cn.list.get(0)[0])
        g.tmpn += 1
        t2 := g.tmpn
        ret "({ int32_t __vn" + t2 + "; const char** __vd" + t2 + " = salam_os_listdir(" + argx2 + ", &__vn" + t2 + "); (" + cnv2 + "){ __vd" + t2 + ", __vn" + t2 + ", __vn" + t2 + " }; })"
    end
    if str.Equals(nm, "sizeof") && cn.list.len() == 1:
        opn := at.Get(a, cn.list.get(0)[0])
        ret "(size_t)sizeof(" + cg_ctype(opn.type_str) + ")"
    end
    if sm.Lookup(s, s.global, nm) == 0:
        if str.Equals(nm, "hash") && cn.list.len() == 1:
            hid := cn.list.get(0)[0]
            ats := at.Get(a, hid).type_str
            if str.Equals(ats, "str"):
                ret "salam_str_hash(" + cg_expr(g, s, a, hid) + ")"
            end
            ret "salam_hash_int((uint64_t)(intptr_t)(" + cg_expr(g, s, a, hid) + "))"
        end
    end
    if str.Equals(nm, "len") && cn.list.len() == 1:
        argid := cn.list.get(0)[0]
        argn := at.Get(a, argid)
        if cg_is_slice_ts(argn.type_str):
            ret "(int32_t)(" + cg_expr(g, s, a, argid) + ").len"
        end
        if str.IndexOf(argn.type_str, "[") >= 0:
            ret co.I64Toa(array_size_of(argn.type_str))
        end
        klen := at.StrLitLen(a, argid)
        if klen >= (0 as i64):
            ret co.I64Toa(klen)
        end
        ret "(int32_t)strlen(" + cg_expr(g, s, a, argid) + ")"
    end
    if str.Equals(nm, "char_code") && cn.list.len() == 1:
        ret "(int32_t)(unsigned char)(" + cg_expr(g, s, a, cn.list.get(0)[0]) + ")[0]"
    end
    bi := sm.BuiltinLookup(nm)
    fsym0 := sm.Lookup(s, s.global, nm)
    if bi >= 0 && fsym0 == 0:
        mut b := co.SbNew()
        co.SbPuts(b, sm.BuiltinAt(bi).runtime)
        co.SbPutc(b, 40)
        repeat cn.list.len() with i:
            if i > 0:
                co.SbPuts(b, ", ")
            end
            co.SbPuts(b, cg_expr(g, s, a, cn.list.get(i)[0]))
        end
        co.SbPutc(b, 41)
        r := co.SbCstr(b)
        co.SbFree(b)
        ret r
    end
    mut fsym := sm.Lookup(s, s.global, nm)
    mut home_pkg := ""
    if fsym == 0 && g.cur_fn_home != 0:
        hs := sm.Lookup(s, g.cur_fn_home, nm)
        if hs != 0 && sm.SymAt(s, hs).kind == sm.SYM_FUNC:
            fsym = hs
            home_pkg = sm.SymAt(s, hs).pkgname
        end
    end
    if fsym == 0 && g.cur_struct != 0 && sm.SymAt(s, g.cur_struct).home != 0:
        hs2 := sm.Lookup(s, sm.SymAt(s, g.cur_struct).home, nm)
        if hs2 != 0 && sm.SymAt(s, hs2).kind == sm.SYM_FUNC:
            fsym = hs2
            home_pkg = sm.SymAt(s, hs2).pkgname
        end
    end
    mut sig := 0
    if fsym != 0:
        sig = pick_overload(s, a, fsym, n)
    end
    is_extern_call := sig != 0 && sm.SigAt(s, sig).decl != 0 && at.Get(a, sm.SigAt(s, sig).decl).is_extern
    inst_fn := sig != 0 && sm.SigAt(s, sig).decl != 0 && at.Get(a, sm.SigAt(s, sig).decl).synthetic
    mut mangled3 := nm
    if is_extern_call:
        mangled3 = nm
    else inst_fn:
        mangled3 = cg_mangle_in(s, "g", "", nm, sm.SigAt(s, sig).params)
    else sig != 0:
        mangled3 = cg_mangle_in(
            s, str.Len(home_pkg) > 0 ? home_pkg : g.pkg, "", nm, sm.SigAt(s, sig).params
        )
    end
    args := call_args(g, s, a, n, sig)
    if sig != 0 && type_is_byval_agg(s, sm.SigAt(s, sig).ret_type) && !is_extern_call:
        ret call_sret(g, s, sm.SigAt(s, sig).ret_type, mangled3, args)
    end
    ret mangled3 + "(" + args + ")"
end

func call_pkg(
    g &: Cg, s &: sm.Sema, a &: at.Ast, n: int, pk: int, callee: int
): str:
    nm := at.Get(a, callee).name
    fn := sm.LookupLocal(s, sm.SymAt(s, pk).members, nm)
    mut sig := 0
    if fn != 0:
        sig = pick_overload(s, a, fn, n)
    end
    is_extern_call := sig != 0 && sm.SigAt(s, sig).decl != 0 && at.Get(a, sm.SigAt(s, sig).decl).is_extern
    mut mangled := ""
    if is_extern_call:
        mangled = nm
    else sig != 0 && sm.SigAt(s, sig).decl != 0 && at.Get(a, sm.SigAt(s, sig).decl).synthetic:
        mangled = cg_mangle_in(s, "g", "", nm, sm.SigAt(s, sig).params)
    else sig != 0:
        mangled = cg_mangle_in(
            s, sm.SymAt(s, pk).pkgname, "", nm, sm.SigAt(s, sig).params
        )
    else:
        mut empty := Vector {} as Vector<int>
        mangled = cg_mangle_in(s, sm.SymAt(s, pk).pkgname, "", nm, empty)
        empty.free()
    end
    args := call_args(g, s, a, n, sig)
    if sig != 0 && type_is_byval_agg(s, sm.SigAt(s, sig).ret_type) && !is_extern_call:
        ret call_sret(g, s, sm.SigAt(s, sig).ret_type, mangled, args)
    end
    ret mangled + "(" + args + ")"
end

func call_dyn(
    g &: Cg, s &: sm.Sema, a &: at.Ast, n: int, obj: int, callee: int, objts: str
): str:
    is_ptr := str.EndsWith(objts, "*")
    recv := cg_expr(g, s, a, obj)
    acc := is_ptr ? "->" : "."
    g.tmpn += 1
    t := g.tmpn
    dynct := cg_ctype(objts)
    mname := at.Get(a, callee).name
    if str.Equals(mname, "free"):
        ret "({ " + dynct + " __dv" + t + " = (" + recv + "); " + CG_MEM_FREE + "(__dv" + t + acc + "data); })"
    end
    asv := call_args_lead(g, s, a, n, 0)
    ret "({ " + dynct + " __dv" + t + " = (" + recv + "); __dv" + t + acc + "vtable->" + cg_cident(mname) + "(__dv" + t + acc + "data" + asv + "); })"
end

func call_file(
    g &: Cg, s &: sm.Sema, a &: at.Ast, n: int, obj: int, callee: int
): str:
    recv := cg_expr(g, s, a, obj)
    m := at.Get(a, callee).name
    a0 := arg_at(g, s, a, n, 0)
    a1 := arg_at(g, s, a, n, 1)
    if str.Equals(m, "read"):
        ret "salam_file_read(" + recv + ", (unsigned long long)(" + a0 + "))"
    end
    if str.Equals(m, "readline"):
        ret "salam_file_readline(" + recv + ")"
    end
    if str.Equals(m, "write"):
        ret "salam_file_write(" + recv + ", " + a0 + ")"
    end
    if str.Equals(m, "seek"):
        ret "salam_file_seek(" + recv + ", (long long)(" + a0 + "), " + a1 + ")"
    end
    if str.Equals(m, "close"):
        ret "salam_file_close(" + recv + ")"
    end
    ret "0"
end

func call_array(
    g &: Cg, s &: sm.Sema, a &: at.Ast, obj: int, callee: int
): str:
    m := at.Get(a, callee).name
    if str.Equals(m, "len"):
        objts := at.Get(a, obj).type_str
        if cg_is_slice_ts(objts):
            ret "(int32_t)(" + cg_expr(g, s, a, obj) + ").len"
        end
        ret co.I64Toa(array_size_of(objts))
    end
    ret "0"
end

func call_str(
    g &: Cg, s &: sm.Sema, a &: at.Ast, n: int, obj: int, callee: int
): str:
    m := at.Get(a, callee).name
    if str.Equals(m, "len"):
        klen := at.StrLitLen(a, obj)
        if klen >= (0 as i64):
            ret co.I64Toa(klen)
        end
    end
    recv := cg_expr(g, s, a, obj)
    a0 := arg_at(g, s, a, n, 0)
    a1 := arg_at(g, s, a, n, 1)
    if str.Equals(m, "len"):
        ret "(int32_t)strlen(" + recv + ")"
    end
    if str.Equals(m, "concat"):
        ret "salam_strcat(" + recv + ", " + a0 + ")"
    end
    if str.Equals(m, "substr"):
        ret "salam_str_substr(" + recv + ", " + a0 + ", " + a1 + ")"
    end
    if str.Equals(m, "find") || str.Equals(m, "search") || str.Equals(m, "indexOf"):
        g.tmpn += 1
        tf := g.tmpn
        ret "({ const char *__fh" + tf + "=(" + recv + "); const char *__fn" + tf + "=(" + a0 + "); const char *__fp" + tf + "=(__fh" + tf + "&&__fn" + tf + ")?strstr(__fh" + tf + ",__fn" + tf + "):0; __fp" + tf + "?(int32_t)(__fp" + tf + "-__fh" + tf + "):-1; })"
    end
    if str.Equals(m, "trim"):
        ret "salam_str_trim(" + recv + ")"
    end
    if str.Equals(m, "to_int"):
        ret "(int32_t)strtol(" + recv + ", ((void*)0), 10)"
    end
    if str.Equals(m, "to_float"):
        ret "strtod(" + recv + ", ((void*)0))"
    end
    if str.Equals(m, "lower"):
        ret "salam_str_lower(" + recv + ")"
    end
    if str.Equals(m, "upper"):
        ret "salam_str_upper(" + recv + ")"
    end
    if str.Equals(m, "repeat"):
        ret "salam_str_repeat(" + recv + ", " + a0 + ")"
    end
    if str.Equals(m, "split"):
        n_ts := at.Get(a, n).type_str
        cnv := cg_ctype(str.Len(n_ts) > 0 ? n_ts : "Vector_str")
        g.tmpn += 1
        t := g.tmpn
        ret "({ int32_t __sn" + t + "; char** __sd" + t + " = salam_str_split(" + recv + ", " + a0 + ", &__sn" + t + "); (" + cnv + "){ __sd" + t + ", __sn" + t + ", __sn" + t + " }; })"
    end
    ret "0"
end

func call_method(
    g &: Cg, s &: sm.Sema, a &: at.Ast, n: int, obj: int, callee: int, objts: str
): str:
    obj_is_ptr := str.Len(objts) > 0 && str.EndsWith(objts, "*")
    mname := at.Get(a, callee).name
    mut sname := ""
    ssym := cg_struct_of(s, objts, sname)
    mut msym := 0
    if ssym != 0:
        msym = sm.LookupLocal(s, sm.SymAt(s, ssym).members, mname)
    end
    mut sig := 0
    if msym != 0:
        sig = pick_overload(s, a, msym, n)
    end
    mut mangled := ""
    if sig != 0:
        mangled = cg_mangle_method(
            g, s, sname, ssym, mname, sm.SigAt(s, sig).params
        )
    else:
        mut empty := Vector {} as Vector<int>
        mangled = cg_mangle_method(g, s, sname, ssym, mname, empty)
        empty.free()
    end
    asv := call_args_lead(g, s, a, n, sig)
    addressable := cg_addressable(a, obj)
    ret_struct := sig != 0 && type_is_byval_agg(s, sm.SigAt(s, sig).ret_type)
    mut rc := ""
    if ret_struct:
        rc = cg_ctype(sm.ToString(s, sm.SigAt(s, sig).ret_type))
    end
    if obj_is_ptr || addressable:
        mut recv := ""
        if obj_is_ptr:
            recv = cg_expr(g, s, a, obj)
        else:
            recv = "&(" + cg_expr(g, s, a, obj) + ")"
        end
        if ret_struct:
            g.tmpn += 1
            sv := g.tmpn
            ret "({ " + rc + " __s" + sv + "; " + mangled + "(" + recv + asv + ", &__s" + sv + "); __s" + sv + "; })"
        end
        ret mangled + "(" + recv + asv + ")"
    end
    g.tmpn += 1
    t := g.tmpn
    oexpr := cg_expr(g, s, a, obj)
    if ret_struct:
        g.tmpn += 1
        sv2 := g.tmpn
        ret "({ " + cg_ctype(objts) + " __t" + t + " = (" + oexpr + "); " + rc + " __s" + sv2 + "; " + mangled + "(&__t" + t + asv + ", &__s" + sv2 + "); __s" + sv2 + "; })"
    end
    ret "({ " + cg_ctype(objts) + " __t" + t + " = (" + oexpr + "); " + mangled + "(&__t" + t + asv + "); })"
end

func call_impl(
    g &: Cg, s &: sm.Sema, a &: at.Ast, n: int, obj: int, callee: int, objts: str, owner: int
): str:
    mname := at.Get(a, callee).name
    msym := sm.LookupLocal(s, sm.SymAt(s, owner).members, mname)
    mut sig := 0
    if msym != 0:
        sig = pick_overload(s, a, msym, n)
    end
    mut mangled := ""
    if sig != 0:
        mangled = cg_mangle_ti(s, objts, mname, sm.SigAt(s, sig).params)
    else:
        mut empty := Vector {} as Vector<int>
        mangled = cg_mangle_ti(s, objts, mname, empty)
        empty.free()
    end
    asv := call_args_lead(g, s, a, n, sig)
    recv := cg_expr(g, s, a, obj)
    if sig != 0 && type_is_byval_agg(s, sm.SigAt(s, sig).ret_type):
        rc := cg_ctype(sm.ToString(s, sm.SigAt(s, sig).ret_type))
        g.tmpn += 1
        sv := g.tmpn
        ret "({ " + rc + " __s" + sv + "; " + mangled + "((" + recv + ")" + asv + ", &__s" + sv + "); __s" + sv + "; })"
    end
    ret mangled + "((" + recv + ")" + asv + ")"
end

func call_member(
    g &: Cg, s &: sm.Sema, a &: at.Ast, n: int, callee: int
): str:
    cn2 := at.Get(a, callee)
    obj := cn2.a
    objn := at.Get(a, obj)
    if obj != 0 && objn.kind == at.AST_IDENTIFIER && !local_known(g, objn.name):
        mut pk := sm.Lookup(s, s.global, objn.name)
        if (pk == 0 || sm.SymAt(s, pk).kind != sm.SYM_PACKAGE) && g.cur_struct != 0 && sm.SymAt(s, g.cur_struct).home != 0:
            pk = sm.Lookup(s, sm.SymAt(s, g.cur_struct).home, objn.name)
        end
        if (pk == 0 || sm.SymAt(s, pk).kind != sm.SYM_PACKAGE) && g.cur_fn_home != 0:
            pk = sm.Lookup(s, g.cur_fn_home, objn.name)
        end
        if pk != 0 && sm.SymAt(s, pk).kind == sm.SYM_PACKAGE:
            ret call_pkg(g, s, a, n, pk, callee)
        end
    end
    objts := objn.type_str
    implsym := sm.Lookup(s, s.global, sm.ImplOwnerKey(objts))
    if implsym != 0 && sm.SymAt(s, implsym).kind == sm.SYM_TYPEIMPL && sm.LookupLocal(s, sm.SymAt(s, implsym).members, cn2.name) != 0:
        ret call_impl(g, s, a, n, obj, callee, objts, implsym)
    end
    if str.StartsWith(objts, "dyn "):
        ret call_dyn(g, s, a, n, obj, callee, objts)
    end
    if str.Equals(objts, "File*"):
        ret call_file(g, s, a, n, obj, callee)
    end
    if str.Equals(objts, "str"):
        ret call_str(g, s, a, n, obj, callee)
    end
    if cg_is_slice_ts(objts) || str.IndexOf(objts, "[") >= 0:
        ret call_array(g, s, a, obj, callee)
    end
    ret call_method(g, s, a, n, obj, callee, objts)
end

// cg_call - returns the C expression text.
func cg_call(g &: Cg, s &: sm.Sema, a &: at.Ast, n: int): str:
    calleeid := at.Get(a, n).a
    if calleeid != 0:
        callee := at.Get(a, calleeid)
        if str.StartsWith(callee.type_str, "externfunc("):
            ret call_raw_ptr(g, s, a, n, calleeid)
        end
        if str.StartsWith(callee.type_str, "func("):
            ret call_value(g, s, a, n, calleeid)
        end
        if callee.kind == at.AST_IDENTIFIER:
            ret call_ident(g, s, a, n, calleeid)
        end
        if callee.kind == at.AST_MEMBER:
            ret call_member(g, s, a, n, calleeid)
        end
    end
    ret "/*uncallable*/0"
end

// ===== codegen_stmt.c =====

// cg_emit_defers - flush g.fn_defers LIFO (without popping).
func cg_emit_defers(g &: Cg, s &: sm.Sema, a &: at.Ast):
    mut i := g.fn_defers.len()
    until i > 0:
        cg_stmt(g, s, a, g.fn_defers.get(i - 1)[0])
        i -= 1
    end
end

func cg_vardecl_inline(g &: Cg, s &: sm.Sema, a &: at.Ast, n: int): str:
    nn := at.Get(a, n)
    ts := str.Len(nn.type_str) > 0 ? nn.type_str : "int32_t"
    decl := cg_decl(ts, nn.name)
    local_add(g, nn.name)
    is_ref := str.IndexOf(ts, "[") >= 0 || str.EndsWith(ts, "*") || struct_by_name(s, ts) != 0
    already_const := str.StartsWith(cg_ctype(ts), "const ")
    prefix := (nn.is_mut || is_ref || already_const) ? "" : "const "
    if nn.a != 0:
        ret prefix + decl + " = " + cg_expr(g, s, a, nn.a)
    end
    if str.IndexOf(ts, "[") >= 0:
        ret prefix + decl + " = {0}"
    end
    ret prefix + decl
end

func cg_simple_inline(g &: Cg, s &: sm.Sema, a &: at.Ast, n: int): str:
    nn := at.Get(a, n)
    if nn.kind == at.AST_VAR_DECL:
        ret cg_vardecl_inline(g, s, a, n)
    end
    if nn.kind == at.AST_ASSIGN:
        if nn.op == tok.TK_POWER_EQ:
            e1 := cg_expr(g, s, a, nn.a)
            e2 := cg_expr(g, s, a, nn.a)
            e3 := cg_expr(g, s, a, nn.b)
            ret e1 + " = pow((double)(" + e2 + "), (double)(" + e3 + "))"
        end
        ea := cg_expr(g, s, a, nn.a)
        eb := cg_expr(g, s, a, nn.b)
        ret ea + " " + cg_op(nn.op) + " " + eb
    end
    if nn.kind == at.AST_EXPR_STMT:
        ret cg_expr(g, s, a, nn.a)
    end
    ret cg_expr(g, s, a, n)
end

func cg_stmt(g &: Cg, s &: sm.Sema, a &: at.Ast, n: int):
    if n == 0:
        ret
    end
    cg_source_line(g, span_of(a, n))
    nn := at.Get(a, n)
    k := nn.kind
    if k == at.AST_BLOCK:
        cg_block(g, s, a, n)
        ret
    end
    if k == at.AST_VAR_DECL:
        if str.StartsWith(nn.type_str, "dyn ") && str.IndexOf(nn.type_str, "[") >= 0 && nn.a != 0 && at.KindOf(a, nn.a) == at.AST_ARRAY_LIT:
            local_add(g, nn.name)
            cg_line(g, cg_decl(nn.type_str, nn.name) + ";")
            an := at.Get(a, nn.a)
            repeat an.list.len() with i:
                cg_line(
                    g, cg_cident(nn.name) + "[" + i + "] = " + cg_expr(g, s, a, an.list.get(i)[0]) + ";"
                )
            end
            ret
        end
        cg_line(g, cg_vardecl_inline(g, s, a, n) + ";")
        ret
    end
    if k == at.AST_CONST_DECL:
        cts := str.Len(nn.type_str) > 0 ? nn.type_str : "int32_t"
        decl := cg_decl(cts, nn.name)
        local_add(g, nn.name)
        cpfx := str.StartsWith(cg_ctype(cts), "const ") ? "" : "const "
        cg_line(g, cpfx + decl + " = " + cg_expr(g, s, a, nn.a) + ";")
        ret
    end
    if k == at.AST_ASSIGN:
        if nn.op == tok.TK_ASSIGN && nn.a != 0 && at.KindOf(a, nn.a) == at.AST_INDEX:
            ixn := at.Get(a, nn.a)
            container_ts := at.Get(a, ixn.a).type_str
            if ixn.a != 0 && str.Len(container_ts) > 0:
                mut sname := ""
                ssym := cg_struct_of(s, container_ts, sname)
                if ssym != 0:
                    m := sm.LookupLocal(
                        s, sm.SymAt(s, ssym).members, "operator_index_set"
                    )
                    if m != 0 && sm.SymAt(s, m).kind == sm.SYM_METHOD:
                        sig := pick_op_overload(s, m, 2)
                        if sig != 0:
                            mangled := cg_mangle_method(
                                g, s, sname, ssym, "operator_index_set", sm.SigAt(s, sig).params
                            )
                            container := ixn.a
                            idx_c := cg_expr(g, s, a, ixn.b)
                            val_c := cg_expr(g, s, a, nn.b)
                            ck := at.KindOf(a, container)
                            addressable := ck == at.AST_IDENTIFIER || ck == at.AST_MEMBER || ck == at.AST_INDEX || ck == at.AST_THIS
                            if addressable:
                                recv := "&(" + cg_expr(g, s, a, container) + ")"
                                cg_line(
                                    g, mangled + "(" + recv + ", " + idx_c + ", " + val_c + ");"
                                )
                            else:
                                g.tmpn += 1
                                t := g.tmpn
                                cts2 := at.Get(a, container).type_str
                                ct := cg_ctype(str.Len(cts2) > 0 ? cts2 : sname)
                                lc := cg_expr(g, s, a, container)
                                cg_line(
                                    g, "{ " + ct + " __t" + t + " = (" + lc + "); " + mangled + "(&__t" + t + ", " + idx_c + ", " + val_c + "); }"
                                )
                            end
                            ret
                        end
                    end
                end
            end
        end
        if nn.op != tok.TK_ASSIGN && nn.a != 0 && str.Len(at.Get(a, nn.a).type_str) > 0:
            base_op := cg_compound_base(nn.op)
            if base_op != tok.TK_EOF:
                mut sname2 := ""
                ssym2 := cg_struct_of(s, at.Get(a, nn.a).type_str, sname2)
                if ssym2 != 0:
                    mname := cg_op_method(base_op)
                    if str.Len(mname) > 0:
                        callv := cg_emit_op_call(
                            g, s, a, nn.a, ssym2, sname2, mname, nn.b
                        )
                        if str.Len(callv) > 0:
                            cg_line(
                                g, cg_expr(g, s, a, nn.a) + " = " + callv + ";"
                            )
                            ret
                        end
                    end
                end
            end
        end
        if nn.op == tok.TK_PLUS_EQ && str.Equals(at.Get(a, nn.a).type_str, "str"):
            e1 := cg_expr(g, s, a, nn.a)
            e2 := cg_expr(g, s, a, nn.a)
            ob := cg_str_operand(g, s, a, nn.b)
            cg_line(g, e1 + " = salam_strcat(" + e2 + ", " + ob + ");")
            ret
        end
        if nn.op == tok.TK_POWER_EQ:
            a_ts := at.Get(a, nn.a).type_str
            ct2 := cg_ctype(str.Len(a_ts) > 0 ? a_ts : "double")
            g.tmpn += 1
            t2 := g.tmpn
            lhs := cg_expr(g, s, a, nn.a)
            rhs := cg_expr(g, s, a, nn.b)
            cg_line(
                g, "{ " + ct2 + " *__pw" + t2 + " = &(" + lhs + "); " + "*__pw" + t2 + " = (" + ct2 + ")pow((double)(*__pw" + t2 + "), (double)(" + rhs + ")); }"
            )
            ret
        end
        ea := cg_expr(g, s, a, nn.a)
        eb := cg_expr(g, s, a, nn.b)
        cg_line(g, ea + " " + cg_op(nn.op) + " " + eb + ";")
        ret
    end
    if k == at.AST_EXPR_STMT:
        cg_line(g, cg_expr(g, s, a, nn.a) + ";")
        ret
    end
    if k == at.AST_DEFER:
        g.fn_defers.push(nn.a)
        ret
    end
    if k == at.AST_RETURN:
        if str.Len(g.match_result_tmp) > 0:
            if nn.a != 0:
                cg_line(
                    g, g.match_result_tmp + " = (" + cg_expr(g, s, a, nn.a) + "); goto " + g.match_end_label + ";"
                )
            else:
                cg_line(g, "goto " + g.match_end_label + ";")
            end
            ret
        end
        if nn.a != 0 && g.fn_defers.len() > 0:
            expr := cg_expr(g, s, a, nn.a)
            r_ts := at.Get(a, nn.a).type_str
            g.tmpn += 1
            t := g.tmpn
            tmp := "__retv" + t
            cg_line(
                g, cg_ctype(str.Len(r_ts) > 0 ? r_ts : "int32_t") + " " + tmp + " = (" + expr + ");"
            )
            cg_emit_defers(g, s, a)
            if g.cur_sret:
                cg_line(g, "*__ret = " + tmp + "; return;")
            else:
                cg_line(g, "return " + tmp + ";")
            end
        else nn.a != 0 && g.cur_sret:
            cg_emit_defers(g, s, a)
            cg_line(g, "*__ret = (" + cg_expr(g, s, a, nn.a) + "); return;")
        else nn.a != 0:
            cg_emit_defers(g, s, a)
            cg_line(g, "return " + cg_expr(g, s, a, nn.a) + ";")
        else:
            cg_emit_defers(g, s, a)
            cg_line(g, "return;")
        end
        ret
    end
    if k == at.AST_MATCH:
        subj_ts := at.Get(a, nn.a).type_str
        g.tmpn += 1
        t := g.tmpn
        subj_var := "__msubj" + t
        cg_line(g, "{")
        g.indent += 1
        cg_line(
            g, cg_ctype(str.Len(subj_ts) > 0 ? subj_ts : "int32_t") + " " + subj_var + " = (" + cg_expr(g, s, a, nn.a) + ");"
        )
        repeat nn.list.len() with i:
            armid := nn.list.get(i)[0]
            cond := cg_match_arm_cond(g, s, a, armid, subj_var, subj_ts)
            cg_line(g, (i > 0 ? "} else " : "") + "if (" + cond + ") {")
            g.indent += 1
            mark := g.locals.len()
            bn := at.Get(a, at.Get(a, armid).b)
            repeat bn.list.len() with j:
                cg_stmt(g, s, a, bn.list.get(j)[0])
            end
            locals_trunc(g, mark)
            g.indent -= 1
        end
        if nn.list.len() > 0:
            cg_line(g, "}")
        end
        g.indent -= 1
        cg_line(g, "}")
        ret
    end
    if k == at.AST_BREAK:
        cg_line(g, "break;")
        ret
    end
    if k == at.AST_CONTINUE:
        cg_line(g, "continue;")
        ret
    end
    if k == at.AST_IF:
        cg_line(g, "if (" + cg_expr(g, s, a, nn.a) + ") {")
        g.indent += 1
        mark := g.locals.len()
        bn := at.Get(a, nn.b)
        repeat bn.list.len() with i:
            cg_stmt(g, s, a, bn.list.get(i)[0])
        end
        locals_trunc(g, mark)
        g.indent -= 1
        if nn.c != 0 && at.KindOf(a, nn.c) == at.AST_IF:
            cg_indent(g)
            out(g, "} else ")
            en := at.Get(a, nn.c)
            out(g, "if (" + cg_expr(g, s, a, en.a) + ") {\n")
            g.indent += 1
            mark2 := g.locals.len()
            ebn := at.Get(a, en.b)
            repeat ebn.list.len() with i2:
                cg_stmt(g, s, a, ebn.list.get(i2)[0])
            end
            locals_trunc(g, mark2)
            g.indent -= 1
            if en.c != 0:
                cg_line(g, "} else {")
                g.indent += 1
                cg_stmt(g, s, a, en.c)
                g.indent -= 1
            end
            cg_line(g, "}")
        else nn.c != 0:
            cg_line(g, "} else {")
            g.indent += 1
            mark3 := g.locals.len()
            en2 := at.Get(a, nn.c)
            repeat en2.list.len() with i3:
                cg_stmt(g, s, a, en2.list.get(i3)[0])
            end
            locals_trunc(g, mark3)
            g.indent -= 1
            cg_line(g, "}")
        else:
            cg_line(g, "}")
        end
        ret
    end
    if k == at.AST_UNTIL:
        cg_line(g, "while (" + cg_expr(g, s, a, nn.a) + ") {")
        g.indent += 1
        mark := g.locals.len()
        bn := at.Get(a, nn.b)
        repeat bn.list.len() with i:
            cg_stmt(g, s, a, bn.list.get(i)[0])
        end
        locals_trunc(g, mark)
        g.indent -= 1
        cg_line(g, "}")
        ret
    end
    if k == at.AST_REPEAT:
        g.tmpn += 1
        t := g.tmpn
        if nn.c != 0:
            from_c := cg_expr(g, s, a, nn.a)
            to_c := cg_expr(g, s, a, nn.c)
            mut step := "1"
            if nn.d != 0:
                step = cg_expr(g, s, a, nn.d)
            end
            cg_line(
                g, "for (int64_t __rep" + t + " = (int64_t)(" + from_c + "), __repe" + t + " = (int64_t)(" + to_c + "), __repa" + t + " = (int64_t)(" + step + "), __reps" + t + " = (__rep" + t + " <= __repe" + t + ") ? __repa" + t + " : -__repa" + t + "; (__reps" + t + " > 0) ? (__rep" + t + " <= __repe" + t + ") : (__rep" + t + " >= __repe" + t + "); __rep" + t + " += __reps" + t + ") {"
            )
        else:
            cg_line(
                g, "for (int64_t __rep" + t + " = 0, __repn" + t + " = (int64_t)(" + cg_expr(g, s, a, nn.a) + "); __rep" + t + " < __repn" + t + "; __rep" + t + "++) {"
            )
        end
        g.indent += 1
        mark := g.locals.len()
        if str.Len(nn.name) > 0:
            ivct := cg_ctype(str.Len(nn.type_str) > 0 ? nn.type_str : "i32")
            cg_line(
                g, "const " + ivct + " " + cg_cident(nn.name) + " = (" + ivct + ")__rep" + t + ";"
            )
            local_add(g, nn.name)
        end
        bn := at.Get(a, nn.b)
        repeat bn.list.len() with i:
            cg_stmt(g, s, a, bn.list.get(i)[0])
        end
        locals_trunc(g, mark)
        g.indent -= 1
        cg_line(g, "}")
        ret
    end
    if k == at.AST_FOR:
        mark := g.locals.len()
        mut init := ""
        if nn.a != 0:
            init = cg_simple_inline(g, s, a, nn.a)
        end
        mut cond := ""
        if nn.b != 0:
            cond = cg_expr(g, s, a, nn.b)
        end
        mut post := ""
        if nn.c != 0:
            post = cg_simple_inline(g, s, a, nn.c)
        end
        cg_line(g, "for (" + init + "; " + cond + "; " + post + ") {")
        g.indent += 1
        dn := at.Get(a, nn.d)
        repeat dn.list.len() with i:
            cg_stmt(g, s, a, dn.list.get(i)[0])
        end
        g.indent -= 1
        cg_line(g, "}")
        locals_trunc(g, mark)
        ret
    end
end

func cg_block(g &: Cg, s &: sm.Sema, a &: at.Ast, block: int):
    mark := g.locals.len()
    bn := at.Get(a, block)
    repeat bn.list.len() with i:
        cg_stmt(g, s, a, bn.list.get(i)[0])
    end
    locals_trunc(g, mark)
end

// ===== codegen_lambda.c =====

// cg_emit_lambda - writes the lifted lambda's decl into blamd and its
// definition into blamf (the C's cg->c = cg->lam_defs swap becomes
// g.cur = CG_OUT_LAMF). Names the node in place.
func cg_emit_lambda(g &: Cg, s &: sm.Sema, a &: at.Ast, n: int):
    nn := at.Get(a, n)
    if str.Len(nn.name) > 0:
        ret
    end
    name := "_Salam_lambda_" + g.lam_n
    g.lam_n += 1
    mut nw := at.Get(a, n)
    nw.name = name
    at.Put(a, n, nw)
    cret := cg_ctype(func_ret_of(nn.type_str))
    ncap := nn.captures.len()
    mut pb := co.SbNew()
    co.SbPuts(pb, "void *__envp")
    repeat nn.list.len() with i:
        p := at.Get(a, nn.list.get(i)[0])
        co.SbPuts(pb, ", ")
        co.SbPuts(pb, cg_decl(p.type_str, p.name))
    end
    ps := co.SbCstr(pb)
    co.SbFree(pb)
    if ncap > 0:
        mut st := co.SbNew()
        co.SbPuts(st, "typedef struct { void *fn;")
        repeat ncap with i2:
            c := at.Get(a, nn.captures.get(i2)[0])
            co.SbPuts(st, " " + cg_decl(c.type_str, c.name) + ";")
        end
        co.SbPuts(st, " } " + name + "_env;\n")
        outd(g, co.SbCstr(st))
        co.SbFree(st)
        outd(g, "static void *" + name + "_make(")
        repeat ncap with i3:
            c2 := at.Get(a, nn.captures.get(i3)[0])
            if i3 > 0:
                outd(g, ", ")
            end
            outd(g, cg_decl(c2.type_str, c2.name))
        end
        outd(g, ");\n")
    end
    outd(g, "static " + cret + " " + name + "(" + ps + ");\n")
    saved_cur := g.cur
    saved_indent := g.indent
    saved_locals := g.locals
    saved_defers := g.fn_defers
    saved_sret := g.cur_sret
    saved_struct := g.cur_struct
    saved_lambda := g.cur_lambda
    g.cur = CG_OUT_LAMF
    g.indent = 0
    g.locals = Vector {} as Vector<str>
    g.fn_defers = Vector {} as Vector<int>
    g.cur_sret = false
    g.cur_struct = 0
    g.cur_lambda = n
    repeat nn.list.len() with i4:
        local_add(g, at.Get(a, nn.list.get(i4)[0]).name)
    end
    cg_line(g, "static " + cret + " " + name + "(" + ps + ") {")
    g.indent += 1
    if ncap > 0:
        cg_line(
            g, name + "_env *__env = (" + name + "_env *)__envp; (void)__env;"
        )
    else:
        cg_line(g, "(void)__envp;")
    end
    if nn.a != 0:
        cg_block(g, s, a, nn.a)
    end
    cg_emit_defers(g, s, a)
    g.indent -= 1
    cg_line(g, "}")
    outc(g, 10)
    if ncap > 0:
        mut mp := co.SbNew()
        repeat ncap with i5:
            c3 := at.Get(a, nn.captures.get(i5)[0])
            if i5 > 0:
                co.SbPuts(mp, ", ")
            end
            co.SbPuts(mp, cg_decl(c3.type_str, c3.name))
        end
        mps := co.SbCstr(mp)
        co.SbFree(mp)
        cg_line(g, "static void *" + name + "_make(" + mps + ") {")
        g.indent += 1
        cg_line(
            g, name + "_env *e = (" + name + "_env *)" + CG_MEM_ALLOC + "((uint64_t)sizeof(" + name + "_env));"
        )
        cg_line(g, "e->fn = (void*)&" + name + ";")
        repeat ncap with i6:
            c4 := at.Get(a, nn.captures.get(i6)[0])
            cg_line(
                g, "e->" + cg_cident(c4.name) + " = " + cg_cident(c4.name) + ";"
            )
        end
        cg_line(g, "return e;")
        g.indent -= 1
        cg_line(g, "}")
    else:
        cg_line(g, "static void *" + name + "_env = (void*)&" + name + ";")
    end
    outc(g, 10)
    // The C restored the saved vecs and leaked the inner ones; the port
    // frees them.
    mut inner_locals := g.locals
    defer inner_locals.free()
    mut inner_defers := g.fn_defers
    defer inner_defers.free()
    g.cur = saved_cur
    g.indent = saved_indent
    g.locals = saved_locals
    g.fn_defers = saved_defers
    g.cur_sret = saved_sret
    g.cur_struct = saved_struct
    g.cur_lambda = saved_lambda
end

func cg_lambda_value(g &: Cg, s &: sm.Sema, a &: at.Ast, n: int): str:
    if str.Len(at.Get(a, n).name) == 0:
        cg_emit_lambda(g, s, a, n)
    end
    nn := at.Get(a, n)
    if nn.captures.len() == 0:
        ret "(void*)&" + nn.name + "_env"
    end
    mut ab := co.SbNew()
    repeat nn.captures.len() with i:
        if i > 0:
            co.SbPuts(ab, ", ")
        end
        co.SbPuts(ab, cg_expr(g, s, a, nn.captures.get(i)[0]))
    end
    args := co.SbCstr(ab)
    co.SbFree(ab)
    ret nn.name + "_make(" + args + ")"
end

// cg_lift_walk - pre-pass that lifts every lambda in the tree into
// blamd/blamf (recurses a/b/c/d and list only, like the C).
func cg_lift_walk(g &: Cg, s &: sm.Sema, a &: at.Ast, node: int):
    if node == 0:
        ret
    end
    nn := at.Get(a, node)
    if nn.kind == at.AST_LAMBDA:
        cg_lift_walk(g, s, a, nn.a)
        cg_emit_lambda(g, s, a, node)
        ret
    end
    cg_lift_walk(g, s, a, nn.a)
    cg_lift_walk(g, s, a, nn.b)
    cg_lift_walk(g, s, a, nn.c)
    cg_lift_walk(g, s, a, nn.d)
    repeat nn.list.len() with i:
        cg_lift_walk(g, s, a, nn.list.get(i)[0])
    end
end

