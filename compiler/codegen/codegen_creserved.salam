"wcstombs", "wctomb", "write", "y0", "y0f", "y0l", "y1", "y1f", "y1l", "yn", "ynf", "ynl"
]

func cg_is_c_allcaps(name: str): bool:
    n := str.Len(name)
    if n < 2:
        ret false
    end
    c0 := byte_at(name, 0)
    if c0 < 65 || c0 > 90:
        ret false
    end
    mut i := 1
    until i < n:
        c := byte_at(name, i)
        if !((c >= 65 && c <= 90) || (c >= 48 && c <= 57)):
            ret false
        end
        i += 1
    end
    ret true
end

func cg_is_c_reserved(name: str): bool:
    if cg_is_c_allcaps(name):
        ret true
    end
    mut lo := 0
    mut hi := K_CG_CRESERVED_COUNT
    until lo < hi:
        mid := (lo + hi) / 2
        cur := k_cg_creserved[mid]
        if str.Equals(cur, name):
            ret true
        end
        if cur < name:
            lo = mid + 1
        else:
            hi = mid
        end
    end
    ret false
end
