package codegen

import str

// ===== codegen_creserved.salam =====
//
// C identifiers a Salam name must never be emitted as, beyond the keywords in
// k_cg_ckw. Every Salam identifier that contains an underscore is already
// safe: cg_cident doubles interior underscores, so `M_PI` becomes `M__PI` and
// can never meet <math.h>'s macro. The names that CAN collide are the
// underscore-free ones, and this table lists those: every macro, function,
// typedef, struct tag and enumerator that the headers the generated C includes
// (<stdint.h> <stdbool.h> <stddef.h> <math.h> <stdio.h> <malloc.h>, plus
// <stdlib.h> <string.h> <errno.h> <limits.h> <time.h> <unistd.h>, which std
// modules hand-declare from) put into the ordinary namespace, harvested from
// glibc with clang's AST dump and `-dM`, plus the compilers' own predefined
// macros (`linux`, `unix`, `i386`), the argument names of C's main, and the
// C23 keywords.
//
// A local, parameter or field named `NULL`, `INFINITY`, `NAN` or `linux` used
// to reach the C compiler verbatim and stop the build ("expected identifier
// before numeric constant"); a local named `pow` or `strcmp` shadowed the
// libc function the surrounding expression was lowered to ("called object is
// not a function"); a struct named `FILE` redefined <stdio.h>'s typedef.
// cg_cident appends one underscore to any name found here, the same escape it
// applies to a C keyword, and the encoding stays one-to-one because the table
// holds no name that ends in an underscore.
//
// Sorted by byte value: cg_is_c_reserved binary-searches it.
const K_CG_CRESERVED_COUNT := 596

k_cg_creserved := [
    "a64l", "abort", "abs", "access", "acct", "acos", "acosf", "acosh", "acoshf", "acoshl",
    "acosl", "alarm", "alignas", "alignof", "alloca", "apple", "arc4random", "argc", "argv",
    "asctime", "asin", "asinf", "asinh", "asinhf", "asinhl", "asinl", "asprintf", "atan", "atan2",
    "atan2f", "atan2l", "atanf", "atanh", "atanhf", "atanhl", "atanl", "atexit", "atof", "atoi",
    "atol", "atoll", "bcmp", "bcopy", "be16toh", "be32toh", "be64toh", "brk", "bsearch", "bzero",
    "calloc", "cbrt", "cbrtf", "cbrtl", "cdecl", "ceil", "ceilf", "ceill", "chdir", "chown",
    "chroot", "clearenv", "clearerr", "clock", "close", "closefrom", "confstr", "constexpr",
    "copysign", "copysignf", "copysignl", "cos", "cosf", "cosh", "coshf", "coshl", "cosl", "crypt",
    "ctermid", "ctime", "daemon", "daylight", "difftime", "div", "dprintf", "drand48", "drem",
    "dremf", "dreml", "dup", "dup2", "dysize", "ecvt", "endusershell", "environ", "erand48", "erf",
    "erfc", "erfcf", "erfcl", "erff", "erfl", "errno", "execl", "execle", "execlp", "execv",
    "execve", "execvp", "exit", "exp", "exp2", "exp2f", "exp2l", "expf", "expl", "expm1", "expm1f",
    "expm1l", "fabs", "fabsf", "fabsl", "faccessat", "far", "fastcall", "fchdir", "fchown",
    "fchownat", "fclose", "fcvt", "fdatasync", "fdim", "fdimf", "fdiml", "fdopen", "feof",
    "ferror", "fexecve", "fflush", "ffs", "ffsl", "ffsll", "fgetc", "fgetpos", "fgets", "fileno",
    "finite", "finitef", "finitel", "flockfile", "floor", "floorf", "floorl", "fma", "fmaf",
    "fmal", "fmax", "fmaxf", "fmaxl", "fmemopen", "fmin", "fminf", "fminl", "fmod", "fmodf",
    "fmodl", "fopen", "fopencookie", "fork", "fpathconf", "fpclassify", "fprintf", "fputc",
    "fputs", "fread", "free", "freopen", "frexp", "frexpf", "frexpl", "fscanf", "fseek", "fseeko",
    "fsetpos", "fsync", "ftell", "ftello", "ftruncate", "ftrylockfile", "funlockfile", "fwrite",
    "gamma", "gammaf", "gammal", "gcvt", "getc", "getchar", "getcwd", "getdelim", "getdomainname",
    "getdtablesize", "getegid", "getentropy", "getenv", "geteuid", "getgid", "getgroups",
    "gethostid", "gethostname", "getline", "getloadavg", "getlogin", "getopt", "getpagesize",
    "getpass", "getpgid", "getpgrp", "getpid", "getppid", "getsid", "getsubopt", "getuid",
    "getusershell", "getw", "getwd", "gmtime", "htobe16", "htobe32", "htobe64", "htole16",
    "htole32", "htole64", "hyper", "hypot", "hypotf", "hypotl", "i386", "ilogb", "ilogbf",
    "ilogbl", "index", "initstate", "interface", "isatty", "iscanonical", "iseqsig", "isfinite",
    "isgreater", "isgreaterequal", "isinf", "isinff", "isinfl", "isless", "islessequal",
    "islessgreater", "isnan", "isnanf", "isnanl", "isnormal", "issignaling", "issubnormal",
    "isunordered", "iszero", "itimerspec", "j0", "j0f", "j0l", "j1", "j1f", "j1l", "jn", "jnf",
    "jnl", "jrand48", "l64a", "labs", "lchown", "lcong48", "ldexp", "ldexpf", "ldexpl", "ldiv",
    "le16toh", "le32toh", "le64toh", "lgamma", "lgammaf", "lgammal", "link", "linkat", "linux",
    "llabs", "lldiv", "llrint", "llrintf", "llrintl", "llround", "llroundf", "llroundl",
    "localtime", "lockf", "log", "log10", "log10f", "log10l", "log1p", "log1pf", "log1pl", "log2",
    "log2f", "log2l", "logb", "logbf", "logbl", "logf", "logl", "lrand48", "lrint", "lrintf",
    "lrintl", "lround", "lroundf", "lroundl", "lseek", "mallinfo", "mallinfo2", "malloc",
    "mallopt", "max", "mblen", "mbstowcs", "mbtowc", "memalign", "memccpy", "memchr", "memcmp",
    "memcpy", "memmem", "memmove", "mempcpy", "memset", "min", "mkdtemp", "mkstemp", "mkstemps",
    "mktemp", "mktime", "modf", "modff", "modfl", "mrand48", "nan", "nanf", "nanl", "nanosleep",
    "near", "nearbyint", "nearbyintf", "nearbyintl", "nextafter", "nextafterf", "nextafterl",
    "nexttoward", "nexttowardf", "nexttowardl", "nice", "nrand48", "nullptr", "offsetof", "optarg",
    "opterr", "optind", "optopt", "pascal", "pathconf", "pause", "pclose", "perror", "pipe",
    "popen", "pow", "powf", "powl", "pread", "printf", "profil", "pselect", "putc", "putchar",
    "putenv", "puts", "putw", "pvalloc", "pwrite", "qecvt", "qfcvt", "qgcvt", "qsort", "rand",
    "random", "read", "readlink", "readlinkat", "realloc", "reallocarray", "realpath", "remainder",
    "remainderf", "remainderl", "remove", "remquo", "remquof", "remquol", "rename", "renameat",
    "revoke", "rewind", "rindex", "rint", "rintf", "rintl", "rmdir", "round", "roundf", "roundl",
    "rpmatch", "sbrk", "scalb", "scalbf", "scalbl", "scalbln", "scalblnf", "scalblnl", "scalbn",
    "scalbnf", "scalbnl", "scanf", "seed48", "select", "setbuf", "setbuffer", "setdomainname",
    "setegid", "setenv", "seteuid", "setgid", "sethostid", "sethostname", "setlinebuf", "setlogin",
    "setpgid", "setpgrp", "setregid", "setreuid", "setsid", "setstate", "setuid", "setusershell",
    "setvbuf", "sigevent", "signbit", "signgam", "significand", "significandf", "significandl",
    "sin", "sinf", "sinh", "sinhf", "sinhl", "sinl", "sleep", "small", "snprintf", "sprintf",
    "sqrt", "sqrtf", "sqrtl", "srand", "srand48", "srandom", "sscanf", "stdcall", "stderr",
    "stdin", "stdout", "stpcpy", "stpncpy", "strcasecmp", "strcasestr", "strcat", "strchr",
    "strchrnul", "strcmp", "strcoll", "strcpy", "strcspn", "strdup", "strerror", "strftime",
    "strlcat", "strlcpy", "strlen", "strncasecmp", "strncat", "strncmp", "strncpy", "strndup",
    "strnlen", "strpbrk", "strrchr", "strsep", "strsignal", "strspn", "strstr", "strtod", "strtof",
    "strtok", "strtol", "strtold", "strtoll", "strtoq", "strtoul", "strtoull", "strtouq",
    "strxfrm", "symlink", "symlinkat", "sync", "syscall", "sysconf", "system", "tan", "tanf",
    "tanh", "tanhf", "tanhl", "tanl", "tcgetpgrp", "tcsetpgrp", "tempnam", "tgamma", "tgammaf",
    "tgammal", "time", "timegm", "timelocal", "timespec", "timeval", "timezone", "tm", "tmpfile",
    "tmpnam", "trunc", "truncate", "truncf", "truncl", "ttyname", "ttyslot", "typeof", "tzname",
    "tzset", "ualarm", "uint", "ulong", "ungetc", "unix", "unlink", "unlinkat", "unreachable",
    "unsetenv", "ushort", "usleep", "valloc", "vasprintf", "vdprintf", "vfork", "vfprintf",
    "vfscanf", "vhangup", "vprintf", "vscanf", "vsnprintf", "vsprintf", "vsscanf", "wcstombs",
    "wctomb", "write", "y0", "y0f", "y0l", "y1", "y1f", "y1l", "yn", "ynf", "ynl"
]

// Any name of two or more characters made only of capitals and digits is
// treated as a macro even when it is not in the table: that is how every C
// header spells its constants, and a Salam field or local spelled that way
// (`EOF`, `NAN`, `BUFSIZ`, windows.h's `ERROR` and `DELETE`) is far more
// likely to meet one than to need the bare spelling.
func cg_is_c_allcaps(name: str): bool:
    n := str.Len(name)
    if n < 2:
        ret false
    end
    c0 := byte_at(name, 0)
    if c0 < 65 || c0 > 90:
        ret false
    end
    mut i := 1
    until i < n:
        c := byte_at(name, i)
        if !((c >= 65 && c <= 90) || (c >= 48 && c <= 57)):
            ret false
        end
        i += 1
    end
    ret true
end

// cg_is_c_reserved - true when `name` (an underscore-free identifier) would
// collide with something C or its headers already own.
func cg_is_c_reserved(name: str): bool:
    if cg_is_c_allcaps(name):
        ret true
    end
    mut lo := 0
    mut hi := K_CG_CRESERVED_COUNT
    until lo < hi:
        mid := (lo + hi) / 2
        cur := k_cg_creserved[mid]
        if str.Equals(cur, name):
            ret true
        end
        if cur < name:
            lo = mid + 1
        else:
            hi = mid
        end
    end
    ret false
end
