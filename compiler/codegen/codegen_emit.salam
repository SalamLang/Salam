package codegen

import str
import co "../sal_core.salam"

// ===== codegen_emit.c =====
// cg_fmt is gone (see file header). cg_indent/cg_line keep their names;
// cg_line takes pre-formatted text.

func cg_indent(g &: Cg):
    if g.compact:
        ret
    end
    repeat g.indent:
        out(g, "    ")
    end
end

func cg_source_line(g &: Cg, sp: co.SrcSpan):
    if !g.debug_info || sp.begin.line == (0 as u32):
        ret
    end
    if str.Len(g.src_path) == 0:
        ret
    end
    // escaped[1024]: backslashes doubled, clamped like the C buffer.
    mut b := co.SbNew()
    n := str.Len(g.src_path)
    mut ei := 0
    mut i := 0
    until i < n && ei < 1022:
        c := byte_at(g.src_path, i)
        if c == 92:
            co.SbPutc(b, 92)
            ei += 1
        end
        co.SbPutc(b, c)
        ei += 1
        i += 1
    end
    esc := co.SbCstr(b)
    co.SbFree(b)
    out(g, "#line " + co.U64Toa(sp.begin.line as u64) + " \"" + esc + "\"\n")
end

func cg_line(g &: Cg, text: str):
    cg_indent(g)
    out(g, text)
    outc(g, g.compact ? 32 : 10)
end

func local_known(g &: Cg, name: str): bool:
    repeat g.locals.len() with i:
        if str.Equals(g.locals.get(i)[0], name):
            ret true
        end
    end
    ret false
end

func local_add(g &: Cg, name: str):
    g.locals.push(name)
end
