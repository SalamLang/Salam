package codegen

import str
import pth "../sal_path.salam"
import co "../sal_core.salam"
import tok "../token.salam"
import at "../ast.salam"
import sm "../semantic/semantic.salam"

// ===== codegen_header.c =====

// The stem the driver names an import's generated module after: the base
// name of the resolved file with its extension dropped, which is what
// driver_build turns into salam_mod_<stem>.c/.h/.o. "" when the import cannot
// be resolved, which the caller treats as "nothing to emit" - a missing import
// is already a semantic error by the time codegen runs.
func cg_import_module(a &: at.Ast, did: int): str:
    d := at.Get(a, did)
    mut p := d.name
    if d.value_kind == tok.TV_STRING && str.Len(d.value_str) > 0:
        p = d.value_str
    end
    if str.Len(p) == 0:
        ret ""
    end
    mut resolved := d.type_str
    if str.Len(resolved) == 0:
        resolved = sm.ResolveImport("", p)
    end
    if str.Len(resolved) == 0:
        ret ""
    end
    stem := str.Len(resolved) - str.Len(pth.PathBase(resolved))
    rl := str.Len(resolved)
    mut k := 0
    mut b := co.SbNew()
    mut q := stem
    until q < rl && k < 127:
        c := byte_at(resolved, q)
        if c == 46:
            break
        end
        co.SbPutc(b, c)
        k += 1
        q += 1
    end
    basev := co.SbCstr(b)
    co.SbFree(b)
    ret basev
end

func cg_module_init_name(module_name: str): str:
    ret CG_MOD_PREFIX + cg_cident(module_name) + "_init"
end

func vec_collect_one(g &: Cg, ts: str):
    if str.Len(ts) == 0:
        ret
    end
    if str.StartsWith(ts, "Vector<"):
        repeat g.vec_types.len() with i:
            if str.Equals(g.vec_types.get(i), ts):
                ret
            end
        end
        g.vec_types.push(ts)
    else str.StartsWith(ts, "Variant<"):
        repeat g.variant_types.len() with i2:
            if str.Equals(g.variant_types.get(i2), ts):
                ret
            end
        end
        g.variant_types.push(ts)
    end
end

func vec_collect(g &: Cg, a &: at.Ast, id: int):
    if id == 0:
        ret
    end
    n := at.Get(a, id)
    vec_collect_one(g, n.type_str)
    vec_collect(g, a, n.ty)
    vec_collect(g, a, n.a)
    vec_collect(g, a, n.b)
    vec_collect(g, a, n.c)
    vec_collect(g, a, n.d)
    repeat n.list.len() with i:
        vec_collect(g, a, n.list.get(i))
    end
    repeat n.dims.len() with i2:
        vec_collect(g, a, n.dims.get(i2))
    end
end

func vec_collect_types(g &: Cg, s &: sm.Sema, a &: at.Ast, program: int):
    prog := at.Get(a, program)
    repeat prog.list.len() with i:
        d := at.Get(a, prog.list.get(i))
        if d.kind != at.AST_STRUCT_DEF:
            continue
        end
        ssym := sm.LookupLocal(s, s.global, d.name)
        if ssym == 0:
            continue
        end
        members := sm.SymAt(s, ssym).members
        msc := sm.ScopeAt(s, members)
        repeat msc.symbols.len() with j:
            f := sm.SymAt(s, msc.symbols.get(j))
            if f.kind == sm.SYM_FIELD && f.ty != sm.TYPE_NONE:
                vec_collect_one(g, sm.ToString(s, f.ty))
            end
        end
    end
end

func dyn_set_add(setv &: Vector<str>, s2: str):
    repeat setv.len() with i:
        if str.Equals(setv.get(i), s2):
            ret
        end
    end
    setv.push(s2)
end

func cg_iface_canon_name(s &: sm.Sema, sym: int): str:
    symv := sm.SymAt(s, sym)
    if str.Len(symv.pkgname) > 0 && !str.Equals(symv.pkgname, "main"):
        ret symv.pkgname + "_" + symv.name
    end
    ret symv.name
end

func dyn_collect(g &: Cg, s &: sm.Sema, a &: at.Ast, id: int):
    if id == 0:
        ret
    end
    n := at.Get(a, id)
    if str.StartsWith(n.type_str, "dyn "):
        dyn_set_add(
            g.dyn_ifaces, str.Substr(
                n.type_str, 4, str.Len(n.type_str) - 4
            )
        )
    end
    if n.kind == at.AST_TYPE && n.is_dyn && str.Len(n.name) > 0:
        // A type node carries the name as written ("Rows", "db.Rows");
        // every other route here carries the canonical one the type
        // string uses. Register the canonical form or the interface gets
        // two typedefs, only one of which the rest of the module refers
        // to.
        isym3 := cg_iface_sym(s, n.name)
        dyn_set_add(g.dyn_ifaces, isym3 != 0 ? cg_iface_canon_name(s, isym3) : n.name)
    end
    if n.kind == at.AST_CAST && str.StartsWith(n.type_str, "dyn ") && n.a != 0:
        an := at.Get(a, n.a)
        if str.Len(an.type_str) > 0:
            iface := str.Substr(n.type_str, 4, str.Len(n.type_str) - 4)
            dyn_set_add(g.dyn_ifaces, iface)
            // char pair[256] - sal_snprintf truncation kept.
            mut pair := iface + "|" + an.type_str
            if str.Len(pair) > 255:
                pair = str.Substr(pair, 0, 255)
            end
            dyn_set_add(g.dyn_impls, pair)
        end
    end
    dyn_collect(g, s, a, n.ty)
    dyn_collect(g, s, a, n.a)
    dyn_collect(g, s, a, n.b)
    dyn_collect(g, s, a, n.c)
    dyn_collect(g, s, a, n.d)
    repeat n.list.len() with i:
        dyn_collect(g, s, a, n.list.get(i))
    end
    repeat n.dims.len() with i2:
        dyn_collect(g, s, a, n.dims.get(i2))
    end
end

// dyn_match_sig - cm is a SymId, want a SigId; returns a SigId.
func dyn_match_sig(s &: sm.Sema, cm: int, want: int): int:
    if cm == 0:
        ret 0
    end
    cs := sm.SymAt(s, cm)
    wsig := sm.SigAt(s, want)
    repeat cs.overloads.len() with k:
        h := cs.overloads.get(k)
        hsig := sm.SigAt(s, h)
        if hsig.params.len() != wsig.params.len():
            continue
        end
        mut ok := true
        repeat wsig.params.len() with p:
            if !sm.Equiv(s, hsig.params.get(p), wsig.params.get(p)):
                ok = false
                break
            end
        end
        if ok:
            ret h
        end
    end
    if cs.overloads.len() > 0:
        ret cs.overloads.get(0)
    end
    ret 0
end

// A type name that reaches codegen is canonical: a struct or interface
// declared in package `db` is named "db_Connection" no matter which file
// names it, and only a main-module declaration keeps its bare name
// (sema_decl.salam). So a symbol has to be found by that canonical name,
// which for anything outside the main module means walking the packages -
// it is not in the global scope under that spelling.
func cg_canon_sym(s &: sm.Sema, name: str, kind: int): int:
    if str.Len(name) == 0:
        ret 0
    end
    mut sym := sm.Lookup(s, s.global, name)
    if sym != 0 && sm.SymAt(s, sym).kind == kind:
        ret sym
    end
    repeat sm.PackageCount(s) with p:
        pk := sm.PackageAt(s, p)
        pkv := sm.SymAt(s, pk)
        if pkv.kind != sm.SYM_PACKAGE || pkv.members == 0:
            continue
        end
        msc := sm.ScopeAt(s, pkv.members)
        repeat msc.symbols.len() with i:
            sym = msc.symbols.get(i)
            symv := sm.SymAt(s, sym)
            if symv.kind != kind || str.Len(symv.name) == 0:
                continue
            end
            if symv.ty != sm.TYPE_NONE && str.Equals(sm.TypeAt(s, symv.ty).name, name):
                ret sym
            end
            if str.Len(symv.pkgname) == 0:
                continue
            end
            if str.Equals(symv.pkgname + "_" + symv.name, name):
                ret sym
            end
        end
    end
    ret 0
end

func cg_iface_sym(s &: sm.Sema, name: str): int:
    ret cg_canon_sym(s, name, sm.SYM_INTERFACE)
end

// The concrete side of an impl pair is canonical too: a driver struct in
// another package reaches here as "drv_DB".
func cg_struct_sym(s &: sm.Sema, name: str): int:
    ret cg_canon_sym(s, name, sm.SYM_STRUCT)
end

func cg_emit_dyn_types(g &: Cg, s &: sm.Sema):
    repeat g.dyn_ifaces.len() with i:
        iname := g.dyn_ifaces.get(i)
        ci := cg_cident(iname)
        isym := cg_iface_sym(s, iname)
        if isym == 0:
            continue
        end
        outh(
            g, "#ifndef SALAM_DYN_" + ci + "_DEFINED\n#define SALAM_DYN_" + ci + "_DEFINED\n"
        )
        outh(g, "typedef struct _Salam_vtbl_" + ci + " {\n")
        imembers := sm.SymAt(s, isym).members
        isc := sm.ScopeAt(s, imembers)
        repeat isc.symbols.len() with m:
            ms := sm.SymAt(s, isc.symbols.get(m))
            if ms.kind != sm.SYM_METHOD || ms.overloads.len() == 0:
                continue
            end
            sig := sm.SigAt(s, ms.overloads.get(0))
            // An aggregate return lowers to an out-parameter here just as it
            // does for a plain function (func_signature), so the slot has
            // to be typed `void (*)(void*, ..., R*)`.
            sret := type_is_byval_agg(s, sig.ret_type)
            rc := cg_ctype(sm.ToString(s, sig.ret_type))
            outh(
                g, "    " + (sret ? "void" : rc) + " (*" + cg_cident(ms.name) + ")(void*"
            )
            repeat sig.params.len() with p:
                outh(
                    g, ", " + cg_ctype(
                        sm.ToString(
                            s, sig.params.get(p)
                        )
                    )
                )
            end
            if sret:
                outh(g, ", " + rc + "*")
            end
            outh(g, ");\n")
        end
        outh(g, "} _Salam_vtbl_" + ci + ";\n")
        outh(
            g, "typedef struct { void* data; const _Salam_vtbl_" + ci + "* vtable; } _Salam_dyn_" + ci + ";\n"
        )
        outh(g, "#endif\n")
    end
end

// cg_emit_dyn_vtables - writes to the C sink (callers keep cur == CG_OUT_C).
func cg_emit_dyn_vtables_impl(g &: Cg, s &: sm.Sema):
    repeat g.dyn_impls.len() with i:
        pair := g.dyn_impls.get(i)
        bar := str.IndexOf(pair, "|")
        if bar < 0:
            continue
        end
        iname := str.Substr(pair, 0, bar)
        cnamev := str.Substr(pair, bar + 1, str.Len(pair) - bar - 1)
        ci := cg_cident(iname)
        cc2 := cg_cident(cnamev)
        isym := cg_iface_sym(s, iname)
        csym := cg_struct_sym(s, cnamev)
        if isym == 0 || csym == 0:
            continue
        end
        imembers := sm.SymAt(s, isym).members
        isc := sm.ScopeAt(s, imembers)
        repeat isc.symbols.len() with m:
            ms := sm.SymAt(s, isc.symbols.get(m))
            if ms.kind != sm.SYM_METHOD || ms.overloads.len() == 0:
                continue
            end
            isig := ms.overloads.get(0)
            cm := sm.LookupLocal(s, sm.SymAt(s, csym).members, ms.name)
            csig := dyn_match_sig(s, cm, isig)
            if csig == 0:
                continue
            end
            // Through cg_mangle_method, not cg_mangle: the method belongs
            // to the struct's own package, which is not the module being
            // emitted when a driver in another package is boxed into an
            // interface here.
            mangled := cg_mangle_method(
                g, s, sm.SymAt(s, csym).name, csym, ms.name, sm.SigAt(s, csig).params
            )
            isigv := sm.SigAt(s, isig)
            rets := cg_ctype(sm.ToString(s, isigv.ret_type))
            mut ps := co.SbNew()
            mut asb := co.SbNew()
            repeat isigv.params.len() with p:
                pt := cg_ctype(sm.ToString(s, isigv.params.get(p)))
                co.SbPuts(ps, ", " + pt + " __a" + p)
                co.SbPuts(asb, ", __a" + p)
            end
            isvoid := isigv.ret_type != sm.TYPE_NONE && sm.TypeAt(s, isigv.ret_type).kind == sm.TY_VOID
            // The callee is `void f(C*, ..., R* __ret)` when it returns an
            // aggregate, so the thunk cannot `return f(...)` - it takes the
            // caller's out-pointer and hands it straight on.
            sret2 := type_is_byval_agg(s, isigv.ret_type)
            if sret2:
                out(
                    g, "static void _Salam_thunk_" + ci + "_" + cc2 + "_" + cg_cident(ms.name) + "(void* self" + co.SbCstr(ps) + ", " + rets + "* __ret){ " + mangled + "((" + cc2 + "*)self" + co.SbCstr(asb) + ", __ret); }\n"
                )
            else:
                out(
                    g, "static " + rets + " _Salam_thunk_" + ci + "_" + cc2 + "_" + cg_cident(ms.name) + "(void* self" + co.SbCstr(ps) + "){ " + (isvoid ? "" : "return ") + mangled + "((" + cc2 + "*)self" + co.SbCstr(asb) + "); }\n"
                )
            end
            co.SbFree(ps)
            co.SbFree(asb)
        end
        out(
            g, "static const _Salam_vtbl_" + ci + " _Salam_vtbl_" + ci + "_" + cc2 + " = {"
        )
        mut first := true
        repeat isc.symbols.len() with m2:
            ms2 := sm.SymAt(s, isc.symbols.get(m2))
            if ms2.kind != sm.SYM_METHOD || ms2.overloads.len() == 0:
                continue
            end
            out(
                g, (first ? "" : ",") + " _Salam_thunk_" + ci + "_" + cc2 + "_" + cg_cident(ms2.name)
            )
            first = false
        end
        out(g, " };\n")
    end
    if g.dyn_impls.len() > 0:
        outc(g, 10)
    end
end

func vec_emit_typedef(g &: Cg, ts: str):
    elem := cg_vec_elem(ts, 96)
    ec := cg_ctype(elem)
    cn := cg_vec_cname(ts)
    outh(
        g, "#ifndef SALAM_" + cn + "_TYPEDEF\n#define SALAM_" + cn + "_TYPEDEF\n"
    )
    outh(
        g, "typedef struct { " + ec + "* data; int32_t len; int32_t cap; " + "} " + cn + ";\n"
    )
    outh(g, "#endif\n")
end

func variant_emit_typedef(g &: Cg, ts: str):
    mut members := cg_variant_members(ts)
    defer members.free()
    cn := cg_variant_cname(ts)
    outh(
        g, "#ifndef SALAM_" + cn + "_TYPEDEF\n#define SALAM_" + cn + "_TYPEDEF\n"
    )
    outh(g, "typedef struct { int32_t tag; union {")
    repeat members.len() with i:
        outh(g, " " + cg_decl(members.get(i), "v" + i) + ";")
    end
    outh(g, " } payload; } " + cn + ";\n")
    outh(g, "#endif\n")
end

func vec_emit(g &: Cg, ts: str):
    elem := cg_vec_elem(ts, 96)
    ec := cg_ctype(elem)
    cn := cg_vec_cname(ts)
    outh(
        g, "#ifndef SALAM_" + cn + "_DEFINED\n#define SALAM_" + cn + "_DEFINED\n"
    )
    outh(
        g, "static void " + cn + "_grow(" + cn + "* v, int32_t need){ " + "if(need<=v->cap) return; int32_t c=v->cap?v->cap:4; " + "while(c<need) c*=2; v->data=(" + ec + "*)" + CG_MEM_REALLOC + "(v->data,(uint64_t)c*sizeof(" + ec + ")); v->cap=c; }\n"
    )
    outh(
        g, "static void " + cn + "_push(" + cn + "* v, " + ec + " x){ " + cn + "_grow(v, v->len+1); v->data[v->len++]=x; }\n"
    )
    outh(
        g, "static " + ec + " " + cn + "_pop(" + cn + "* v){ return " + "v->data[--v->len]; }\n"
    )
    outh(
        g, "static " + ec + " " + cn + "_get(" + cn + "* v, int32_t i){ " + "if(i<0||i>=v->len) salam_panic(\"Vector.get: index out of " + "bounds\"); return v->data[i]; }\n"
    )
    // What get returned before it started handing back the element itself.
    // Out of range stays a null pointer rather than a panic: this is the
    // escape hatch, and code that reaches for it can check.
    outh(
        g, "static " + ec + "* " + cn + "_ref(" + cn + "* v, int32_t i){ " + "if(i<0||i>=v->len) return (" + ec + "*)0; return " + "&v->data[i]; }\n"
    )
    outh(
        g, "static void " + cn + "_set(" + cn + "* v, int32_t i, " + ec + " x){ if(i<0) return; " + cn + "_grow(v, i+1); if(i>=v->len) " + "v->len=i+1; v->data[i]=x; }\n"
    )
    outh(
        g, "static int32_t " + cn + "_len(" + cn + "* v){ return v->len; " + "}\n"
    )
    outh(
        g, "static int32_t " + cn + "_cap(" + cn + "* v){ return v->cap; " + "}\n"
    )
    outh(
        g, "static void " + cn + "_free(" + cn + "* v){ " + CG_MEM_FREE + "(v->data); v->data=(" + ec + "*)0; v->len=0; v->cap=0; }\n"
    )
    outh(g, "#endif\n")
end

func hdr_prelude(g &: Cg, a &: at.Ast, program: int):
    outh(g, "#pragma once\n")
    guard := cg_cident(g.module)
    outh(
        g, "#ifndef SALAM_MODULE_" + guard + "_H\n#define SALAM_MODULE_" + guard + "_H\n"
    )
    if g.is_gui_mode:
        outh(g, "#ifdef _WIN32\n#include <windows.h>\n#endif\n")
    end
    // stdint, stdbool and stddef are freestanding headers - the C standard
    // requires a freestanding implementation to provide them, and gcc and
    // clang both do under -ffreestanding. <math.h> is not one of them, and a
    // kernel must not reach libm anyway.
    if g.freestanding:
        outh(
            g, "#include <stdint.h>\n#include <stdbool.h>\n#include <stddef.h>\n"
        )
    else:
        outh(
            g, "#include <stdint.h>\n#include <stdbool.h>\n#include <math.h>" + "\n#include <stddef.h>\n"
        )
    end
    // <stdio.h> is included rather than fopen/fread/fwrite being
    // hand-declared like the rest of the CRT surface: clang's
    // -Wbuiltin-requires-header fires on any declaration of those three
    // outside the real header, however exactly it matches its own idea of
    // the prototype (78 warnings in one benchmark-runner build).
    // is_stdio_name below drops the hand-declarations that would now
    // conflict with it.
    //
    // Its macros are undefined again immediately. `stdout` and `stderr` are
    // ordinary field names in Salam - std/ssh's Channel has both - and musl
    // spells the macro `(stdout)`, which turns `ch->stdout` into a syntax
    // error; mingw spells it `(&__iob_func()[1])`. Only the macro shorthand
    // goes, the libc functions and objects behind it survive, and nothing
    // generated here ever refers to a stdio macro.
    // <stdio.h> does not exist freestanding, so the hand-declared
    // fopen/fread/fwrite that hdr_externs suppresses for a hosted build come
    // back instead and libbs supplies them.
    if !g.freestanding:
        outh(
            g, "#include <stdio.h>\n" + "#undef stdin\n#undef stdout\n#undef stderr\n" + "#undef EOF\n#undef BUFSIZ\n" + "#undef SEEK_SET\n#undef SEEK_CUR\n#undef SEEK_END\n"
        )
    end
    // fflush and snprintf come from the <stdio.h> above. Hand-declaring them
    // again is what the include is there to avoid: salam spells the size as
    // uint64_t where the standard says size_t, and the stream as void* where
    // it says FILE*.
    // Keep freed blocks inside the process instead of handing them straight
    // back to the kernel. glibc's defaults return anything past 128 KiB with
    // munmap or an sbrk shrink, so a loop that allocates a result, frees it
    // and allocates the next one re-faults every page it touches: measured on
    // a 2048x2048 f64 matrix add, 8192 minor faults per call and roughly two
    // thirds of the wall time, none of it arithmetic. Raising both thresholds
    // lets the same pages come back already resident.
    //
    // Only glibc has mallopt; everywhere else this is an empty function that
    // the compiler deletes. SALAM_NO_ALLOC_TUNE opts out for a program that
    // would rather return memory promptly than reuse it.
    //
    // Deliberately no getenv() check for an existing MALLOC_*_ setting:
    // <stdlib.h> declares getenv as char*, std/os hand-declares it as void*,
    // and pulling the real header in here makes the two collide in every
    // translation unit that touches os. The compile-time define is the
    // supported way out.
    // Freestanding there is no glibc and no <malloc.h>. Emit the empty arm
    // so the call in emit_module_init still compiles away to nothing.
    if g.freestanding:
        outh(
            g, "#ifndef SALAM_ALLOC_TUNE_DEFINED\n#define SALAM_ALLOC_TUNE_DEFINED\n" + "static inline void salam_tune_allocator(void) { }\n" + "#endif\n"
        )
    else:
        outh(
            g, "#ifndef SALAM_ALLOC_TUNE_DEFINED\n#define SALAM_ALLOC_TUNE_DEFINED\n" + "#if defined(__GLIBC__) && !defined(SALAM_NO_ALLOC_TUNE)\n" + "#include <malloc.h>\n" + "static inline void salam_tune_allocator(void) {\n" + "    static int done = 0;\n" + "    if (done) return;\n" + "    done = 1;\n" + "    mallopt(M_MMAP_THRESHOLD, 256 * 1024 * 1024);\n" + "    mallopt(M_TRIM_THRESHOLD, 512 * 1024 * 1024);\n" + "}\n" + "#else\n" + "static inline void salam_tune_allocator(void) { }\n" + "#endif\n#endif\n"
        )
    end
    // Freestanding: no stdio, no write(2) and no destructor to flush from.
    // The program supplies salam_rt_write; a kernel points it at the serial
    // port. Unbuffered on purpose - when a kernel triple-faults you want the
    // last line to have already left the machine.
    if g.freestanding:
        outh(
            g, "#ifndef SALAM_OUT_DEFINED\n#define SALAM_OUT_DEFINED\n" + "extern void salam_rt_write(int32_t fd, const void *buf, uint64_t n);\n" + "#define SALAM_RAW_WRITE(fd, buf, n) (salam_rt_write((int32_t)(fd), " + "(const void *)(buf), (uint64_t)(n)), 0)\n" + "static void salam_out_flush(void) { }\n" + "static void salam_out_write_(const void *s, uint64_t n) {\n" + "    salam_rt_write(1, s, n);\n" + "}\n" + "#define SALAM_OUT_LIT(s, n) salam_out_write_((s), (uint64_t)(n))\n" + "#endif\n"
        )
    else:
        outh(
            g, "#ifndef SALAM_OUT_DEFINED\n#define SALAM_OUT_DEFINED\n" + "#define SALAM_OB_SZ 65536\n" + "#if defined(_WIN32)\n" + "extern int _write(int, void *, unsigned);\n" + "#define SALAM_RAW_WRITE(fd, buf, n) _write((fd), (void " + "*)(buf), (unsigned)(n))\n" + "#else\n" + "extern int64_t write(int32_t, void *, uint64_t);\n" + "#define SALAM_RAW_WRITE(fd, buf, n) write((fd), (void " + "*)(buf), (uint64_t)(n))\n" + "#endif\n" + "#if (defined(__GNUC__) || defined(__clang__)) && " + "!defined(__TINYC__)\n" + "__attribute__((weak)) char salam_ob[SALAM_OB_SZ];\n" + "__attribute__((weak)) uint64_t salam_obn;\n" + "__attribute__((weak)) void salam_out_flush(void) {\n" + "    if (salam_obn) { int64_t r = " + "(int64_t)SALAM_RAW_WRITE(1, salam_ob, salam_obn); (void)r; " + "salam_obn = 0; }\n" + "}\n" + "__attribute__((weak, destructor)) void salam_out_fini(void) " + "{ salam_out_flush(); }\n" + "static inline void salam_out_write_(const void *s, uint64_t " + "n) {\n" + "    if (salam_obn + n > SALAM_OB_SZ) salam_out_flush();\n" + "    if (n >= SALAM_OB_SZ) { int64_t r = " + "(int64_t)SALAM_RAW_WRITE(1, s, n); (void)r; return; }\n" + "    __builtin_memcpy(salam_ob + salam_obn, s, (size_t)n); " + "salam_obn += n;\n" + "    if (__builtin_memchr(s, '\\n', (size_t)n)) salam_out_flush();\n" + "}\n" + "#else\n" + "static void salam_out_flush(void) { fflush(0); }\n" + "static void salam_out_write_(const void *s, uint64_t n) {\n" + "    int64_t r = (int64_t)SALAM_RAW_WRITE(1, s, n); (void)r;\n" + "}\n" + "#endif\n" + "#define SALAM_OUT_LIT(s, n) salam_out_write_((s), " + "(uint64_t)(n))\n" + "#endif\n"
        )
    end
    // See cg_needs_fparg in codegen_call.salam: tcc 0.9.27 (x86-64)
    // overwrites a computed floating-point argument with the value of the
    // floating-point argument that follows it, so every such argument is
    // routed through an opaque identity call that forces it into its own
    // slot. Expands to nothing outside __TINYC__ - no other toolchain pays
    // for it, and even under tcc only calls with two adjacent float
    // parameters are wrapped.
    outh(
        g, "#ifndef SALAM_FPARG_DEFINED\n#define SALAM_FPARG_DEFINED\n" + "#if defined(__TINYC__)\n" + "static double salam_fparg_d(double v) { return v; }\n" + "static float salam_fparg_f(float v) { return v; }\n" + "#define SALAM_FPARG_D(x) salam_fparg_d(x)\n" + "#define SALAM_FPARG_F(x) salam_fparg_f(x)\n" + "#else\n" + "#define SALAM_FPARG_D(x) (x)\n" + "#define SALAM_FPARG_F(x) (x)\n" + "#endif\n" + "#endif\n"
    )
    outh(
        g, "#ifndef SALAM_FN_ATTRS_DEFINED\n#define " + "SALAM_FN_ATTRS_DEFINED\n" + "#if defined(__GNUC__) || defined(__clang__)\n" + "#define SALAM_NOINLINE __attribute__((noinline))\n" + "#define SALAM_PURE __attribute__((pure))\n" + "#define SALAM_NORET __attribute__((noreturn))\n" + "#define SALAM_DEPRECATED __attribute__((deprecated))\n" + "#else\n" + "#define SALAM_NOINLINE\n" + "#define SALAM_PURE\n" + "#define SALAM_NORET\n" + "#define SALAM_DEPRECATED\n" + "#endif\n" + "#endif\n"
    )
    // The four allocator entry points are declared here, ahead of every
    // #include, because a generic method is instantiated into the header of
    // whichever module happens to use it: Vector<str> lands in
    // salam_mod_str.h, which core.h reaches long before mem.h gets to declare
    // its own functions. Whatever those instantiated bodies call therefore has
    // to be visible from the very top of any module header, not from mem's.
    outh(
        g, "#ifndef SALAM_RT_TYPES_DEFINED\n#define " + "SALAM_RT_TYPES_DEFINED\n" + "typedef struct salam_file salam_file;\n" + "typedef struct salam_map salam_map;\n" + "typedef struct salam_map_iter salam_map_iter;\n" + "typedef struct { void* data; int64_t len; } salam_slice;\n" + "extern int64_t salam_idx(int64_t, int64_t);\n"
            // The bounds check, inline. salam_idx itself lives in another
            // translation unit, so a call to it is a call even under -O2 -
            // one per subscript, and one the vectorizer will not look
            // past. The fast path is a single unsigned compare (a negative
            // index reinterprets as huge and fails the same test), and the
            // failing path still goes to salam_idx, so the diagnostic and
            // the abort stay exactly where they were.
            + "#define SALAM_IDX(i, n) ({ int64_t __salam_ix = (int64_t)(i); "
            + "((uint64_t)__salam_ix < (uint64_t)(int64_t)(n)) ? __salam_ix "
            + ": salam_idx(__salam_ix, (int64_t)(n)); })\n" + "extern SALAM_NORET void salam_panic(const char* msg);\n" + "extern uint64_t salam_hash_int(uint64_t x);\n" + "extern uint64_t salam_str_hash(const char* s);\n" + "void* " + CG_MEM_ALLOC + "(uint64_t size);\n" + "void* " + CG_MEM_ALLOC_ZEROED + "(uint64_t size);\n" + "void* " + CG_MEM_REALLOC + "(void* ptr, uint64_t size);\n" + "void " + CG_MEM_FREE + "(void* ptr);\n" + "static inline void salam_slice_new(salam_slice* out, void* " + "b, int64_t lo, int64_t hi, int64_t esz)" + "{ out->data=(void*)((char*)b+(lo)*(esz)); " + "out->len=(hi)-(lo); }\n" + "static inline void salam_slice_sub(salam_slice* out, " + "salam_slice b, int64_t lo, int64_t hi, int has_hi, int64_t " + "esz)" + "{ if(!has_hi) hi=b.len; " + "out->data=(void*)((char*)b.data+(lo)*(esz)); " + "out->len=(hi)-(lo); }\n" + "static inline void* salam_slice_at(salam_slice s, int64_t i, " + "int64_t esz, int sf)" + "{ return " + "(void*)((char*)s.data+(sf?SALAM_IDX(i,s.len):i)*(esz)); }\n" + "typedef void (*salam_thread_fn)(void);\n" + "typedef void (*salam_thread_arg_fn)(void*);\n" + "#endif\n"
    )
    // std/ modules (mem, str, thread, sync, webview, ...) declare their own
    // CRT/WinAPI extern funcs (e.g. strlen, WaitForSingleObject) using
    // salam's own type spellings. tcc does strict typedef-identity
    // comparison, so on _WIN32 in GUI mode - where <windows.h> above
    // transitively pulls in the *real* prototypes - those collide with the
    // hand-rolled ones just below and in hdr_externs. Claiming these guards
    // here, before either block, suppresses this module's own copies so
    // only the <windows.h> versions apply. See is_wellknown_libc_name.
    //
    // Two tiers, because the two supported Windows compilers do not agree on
    // what <windows.h> drags in. Both declare the kernel32/user32 set, so
    // SALAM_EXTERN_LIBC_ON_WIN32 is unconditional. Only gcc/clang also reach
    // <stdlib.h> and winsock from it (winnt.h -> x86intrin.h -> mm_malloc.h ->
    // stdlib.h, plus winsock.h), which is where getenv, socket, send, recv, ...
    // come from - tcc's headers never do, so suppressing those names for tcc
    // would leave them with no declaration at all.
    // SALAM_EXTERN_WIDE_LIBC_ON_WIN32 is therefore claimed only when the
    // compiler is not tcc.
    if g.is_gui_mode:
        outh(g, "#ifdef _WIN32\n#define SALAM_RT_STR_DEFINED\n" + "#define SALAM_EXTERN_LIBC_ON_WIN32\n" + "#if !defined(__TINYC__)\n" + "#define SALAM_EXTERN_WIDE_LIBC_ON_WIN32\n" + "#endif\n#endif\n")
    end
    // Spelled exactly as <string.h>/<stdlib.h> spell them, not in salam's own
    // type vocabulary. gcc (-Wbuiltin-declaration-mismatch) and clang
    // (-Wincompatible-library-redeclaration) both know these five by name and
    // warn about every difference: `const char*` where strstr returns `char*`,
    // `void*` where strtol/strtod take `char**`, `int64_t` where strtol
    // returns `long` (a different width on Windows). Salam has no way to write
    // a `char**` parameter, so the C text is written out here instead of being
    // derived from a salam signature - same reason libc_canonical_proto exists
    // for the extern blocks in std/.
    outh(
        g, "#ifndef SALAM_RT_STR_DEFINED\n#define SALAM_RT_STR_DEFINED\n" + "extern size_t strlen(const char* s);\n" + "extern int strcmp(const char* a, const char* b);\n" + "extern char* strstr(const char* haystack, const char* " + "needle);\n" + "extern long strtol(const char* s, char** endptr, int " + "base);\n" + "extern double strtod(const char* s, char** endptr);\n" + "#endif\n"
    )
    outh(
        g, "#ifndef SALAM_RT_STR2_DEFINED\n#define SALAM_RT_STR2_DEFINED\n" + "extern const char* salam_strcat(const char* a, const char* " + "b);\n" + "extern const char* salam_char_from_code(int32_t c);\n" + "extern const char* salam_fmt_f64(double v);\n" + "extern const char* salam_str_substr(const char* s, int32_t " + "start, int32_t n);\n" + "extern const char* salam_str_trim(const char* s);\n" + "extern void* salam_str_split(const char* s, const char* " + "delim, void* out_count);\n" + "extern const char* salam_str_repeat(const char* s, int32_t " + "n);\n" + "extern const char* salam_str_upper(const char* s);\n" + "extern const char* salam_str_lower(const char* s);\n" + "#endif\n"
    )
    if !str.Equals(g.module, "core"):
        outh(g, `#include "` + CG_MOD_PREFIX + "core.h\"\n")
    end
    prog := at.Get(a, program)
    repeat prog.list.len() with i:
        d := at.Get(a, prog.list.get(i))
        if d.kind != at.AST_IMPORT:
            continue
        end
        basev := cg_import_module(a, prog.list.get(i))
        if str.Len(basev) == 0:
            continue
        end
        outh(g, `#include "` + CG_MOD_PREFIX + basev + ".h\"\n")
    end
    outh(g, "\n")
end

func hdr_enums(g &: Cg, s &: sm.Sema, a &: at.Ast, program: int):
    prog := at.Get(a, program)
    repeat prog.list.len() with i:
        d := at.Get(a, prog.list.get(i))
        if d.kind != at.AST_ENUM_DEF:
            continue
        end
        esym := sm.LookupLocal(s, s.global, d.name)
        backing := esym != 0 ? sm.SymAt(s, esym).enum_val_kind : tok.TV_INT
        // The type's own C name is package-mangled for a non-main package
        // (sema_decl.salam's AST_ENUM_DEF pre-pass), matching what cg_ctype
        // already produces for a variable/param declared with this enum's
        // type - so the typedef itself has to use that name too, or
        // "unknown type name" follows the moment anything outside this
        // enum's own package refers to it. The *member constant* names stay
        // on the short, unmangled prefix (d.name): same-package reads
        // (cg_expr's AST_MEMBER case) already rely on that, unchanged here.
        mut tname := d.name
        if esym != 0:
            esv := sm.SymAt(s, esym)
            if esv.ty != sm.TYPE_NONE:
                etn := sm.TypeAt(s, esv.ty).name
                if str.Len(etn) > 0:
                    tname = etn
                end
            end
        end
        // A C `enum` can only ever hold integers, so a string/float backed
        // enum can't become one - it's emitted as one `static const`
        // declaration per member instead. Either way the member-read site
        // (cg_expr's AST_MEMBER case) just emits the bare identifier
        // `Enum_Member`, so it doesn't care which of these two forms
        // declared it.
        if backing != tok.TV_INT:
            // Other codegen sites resolve the type name "Color" straight to
            // a C type via typedef (variable decls, params, struct fields) -
            // without a C `enum` to supply that, a plain typedef to the
            // backing C type keeps "Color" valid.
            outh(
                g, "typedef " + (backing == tok.TV_STRING ? "const char *" : "double") + " " + cg_cident(tname) + ";\n"
            )
            repeat d.list.len() with j:
                m := at.Get(a, d.list.get(j))
                mut lit := "0"
                if m.a != 0:
                    ma := at.Get(a, m.a)
                    if ma.kind == at.AST_LITERAL:
                        if backing == tok.TV_STRING:
                            lit = cg_cescape(ma.value_str)
                        else if backing == tok.TV_FLOAT:
                            lit = co.Format1("%.17g", co.ArgFloat(ma.value_float))
                        end
                    end
                end
                outh(
                    g, "static const " + cg_cident(tname) + " " + cg_cident(d.name) + "_" + cg_cident(m.name) + " = " + lit + ";\n"
                )
            end
            continue
        end
        outh(g, "typedef enum {")
        mut next := 0 as i64
        repeat d.list.len() with j:
            m := at.Get(a, d.list.get(j))
            if m.a != 0:
                ma := at.Get(a, m.a)
                if ma.kind == at.AST_LITERAL && ma.value_kind == tok.TV_INT:
                    next = ma.value_int as i64
                end
            end
            outh(
                g, (j > 0 ? "," : "") + " " + cg_cident(d.name) + "_" + cg_cident(m.name) + " = " + co.I64Toa(next)
            )
            next += 1 as i64
        end
        outh(g, " } " + cg_cident(tname) + ";\n")
    end
end

func hdr_struct_fwd(g &: Cg, s &: sm.Sema, a &: at.Ast, program: int):
    prog := at.Get(a, program)
    repeat prog.list.len() with i:
        d := at.Get(a, prog.list.get(i))
        if d.kind != at.AST_STRUCT_DEF:
            continue
        end
        if d.typarams.len() > 0:
            continue
        end
        ssym2 := sm.LookupLocal(s, s.global, d.name)
        mut raw2 := d.name
        if ssym2 != 0:
            sv := sm.SymAt(s, ssym2)
            if sv.ty != sm.TYPE_NONE:
                tn := sm.TypeAt(s, sv.ty).name
                if str.Len(tn) > 0:
                    raw2 = tn
                end
            end
        end
        cn := cg_cident(raw2)
        outh(
            g, "#ifndef SALAM_FWD_" + cn + "\n#define SALAM_FWD_" + cn + "\ntypedef struct " + cn + " " + cn + ";\n#endif\n"
        )
    end
end

func hdr_struct_fwd_imports(g &: Cg, s &: sm.Sema, a &: at.Ast):
    repeat sm.PackageCount(s) with p:
        pk := sm.PackageAt(s, p)
        if pk == 0:
            continue
        end
        pkv := sm.SymAt(s, pk)
        if pkv.kind != sm.SYM_PACKAGE || pkv.members == 0:
            continue
        end
        psc := sm.ScopeAt(s, pkv.members)
        repeat psc.symbols.len() with i:
            sv := sm.SymAt(s, psc.symbols.get(i))
            if sv.kind != sm.SYM_STRUCT || sv.ty == sm.TYPE_NONE:
                continue
            end
            tn := sm.TypeAt(s, sv.ty).name
            if str.Len(tn) == 0:
                continue
            end
            if sv.decl != 0 && at.Get(a, sv.decl).typarams.len() > 0:
                continue
            end
            cn := cg_cident(tn)
            outh(
                g, "#ifndef SALAM_FWD_" + cn + "\n#define SALAM_FWD_" + cn + "\ntypedef struct " + cn + " " + cn + ";\n#endif\n"
            )
        end
    end
end

func emit_struct_def(g &: Cg, s &: sm.Sema, ssym: int, gcn: str):
    outh(
        g, "#ifndef SALAM_DEF_" + gcn + "\n#define SALAM_DEF_" + gcn + "\n"
    )
    outh(g, "struct " + gcn + " {\n")
    mut nfields := 0
    msc := sm.ScopeAt(s, sm.SymAt(s, ssym).members)
    repeat msc.symbols.len() with j:
        f := sm.SymAt(s, msc.symbols.get(j))
        if f.kind != sm.SYM_FIELD:
            continue
        end
        outh(g, "    " + cg_decl(sm.ToString(s, f.ty), f.name) + ";\n")
        nfields += 1
    end
    if nfields == 0:
        outh(g, "    char _salam_empty;\n")
    end
    outh(g, "};\n#endif\n")
end

// struct_dep_cname - "" = the C NULL (no dependency).
func struct_dep_cname(s &: sm.Sema, t0: int): str:
    mut t := t0
    until t != sm.TYPE_NONE && sm.TypeAt(s, t).kind == sm.TY_ARRAY:
        t = sm.TypeAt(s, t).elem
    end
    if t == sm.TYPE_NONE:
        ret ""
    end
    k := sm.TypeAt(s, t).kind
    if k == sm.TY_STRUCT || k == sm.TY_VEC || k == sm.TY_MAP_ITER:
        ret cg_ctype(sm.ToString(s, t))
    end
    ret ""
end

func hdr_struct_visit_dep(
    g &: Cg, s &: sm.Sema, dep: str, self: int, syms: Vector<int>, gcns: Vector<str>, state &: Vector<int>
):
    n := gcns.len()
    repeat n with k:
        if k != self && str.Equals(dep, gcns.get(k)):
            hdr_struct_visit(g, s, k, syms, gcns, state)
        end
    end
end

func hdr_variant_field_deps(
    g &: Cg, s &: sm.Sema, vt: int, self: int, syms: Vector<int>, gcns: Vector<str>, state &: Vector<int>
):
    vtv := sm.TypeAt(s, vt)
    repeat vtv.params.len() with m:
        dep := struct_dep_cname(s, vtv.params.get(m))
        if str.Len(dep) > 0:
            hdr_struct_visit_dep(g, s, dep, self, syms, gcns, state)
        end
    end
    variant_emit_typedef(g, sm.ToString(s, vt))
end

func hdr_struct_visit(
    g &: Cg, s &: sm.Sema, i: int, syms: Vector<int>, gcns: Vector<str>, state &: Vector<int>
):
    if state.get(i) != 0:
        ret
    end
    state.set(i, 1)
    ssym := syms.get(i)
    msc := sm.ScopeAt(s, sm.SymAt(s, ssym).members)
    repeat msc.symbols.len() with j:
        f := sm.SymAt(s, msc.symbols.get(j))
        if f.kind != sm.SYM_FIELD:
            continue
        end
        if f.ty != sm.TYPE_NONE && sm.TypeAt(s, f.ty).kind == sm.TY_VARIANT:
            hdr_variant_field_deps(g, s, f.ty, i, syms, gcns, state)
            continue
        end
        dep := struct_dep_cname(s, f.ty)
        if str.Len(dep) > 0:
            hdr_struct_visit_dep(g, s, dep, i, syms, gcns, state)
        end
    end
    emit_struct_def(g, s, ssym, gcns.get(i))
    state.set(i, 2)
end

func hdr_structs(g &: Cg, s &: sm.Sema, a &: at.Ast, program: int):
    mut syms := Vector {} as Vector<int>
    defer syms.free()
    mut gcns := Vector {} as Vector<str>
    defer gcns.free()
    mut state := Vector {} as Vector<int>
    defer state.free()
    prog := at.Get(a, program)
    repeat prog.list.len() with i:
        d := at.Get(a, prog.list.get(i))
        if d.kind != at.AST_STRUCT_DEF:
            continue
        end
        if d.typarams.len() > 0:
            continue
        end
        ssym := sm.LookupLocal(s, s.global, d.name)
        if ssym == 0 || sm.SymAt(s, ssym).members == 0:
            continue
        end
        mut raw_cn := d.name
        sv := sm.SymAt(s, ssym)
        if sv.ty != sm.TYPE_NONE:
            tn := sm.TypeAt(s, sv.ty).name
            if str.Len(tn) > 0:
                raw_cn = tn
            end
        end
        syms.push(ssym)
        gcns.push(cg_cident(raw_cn))
        state.push(0)
    end
    repeat syms.len() with i2:
        hdr_struct_visit(g, s, i2, syms, gcns, state)
    end
end

func hdr_aliases(g &: Cg, s &: sm.Sema, a &: at.Ast, program: int):
    prog := at.Get(a, program)
    repeat prog.list.len() with i:
        d := at.Get(a, prog.list.get(i))
        if d.kind != at.AST_TYPE_ALIAS:
            continue
        end
        asym := sm.LookupLocal(s, s.global, d.name)
        if asym == 0:
            continue
        end
        outh(
            g, "typedef " + cg_decl(sm.ToString(s, sm.SymAt(s, asym).ty), d.name) + ";\n"
        )
    end
end

// CRT functions and genuine WinAPI functions (kernel32/user32, all
// transitively declared by <windows.h>) that std/ modules declare via
// their own `extern func` blocks - see the comment above the
// SALAM_EXTERN_LIBC_ON_WIN32 guard in hdr_prelude for why these must not
// be redeclared when windows.h has already provided the real prototype.
func is_wellknown_libc_name(name: str): bool:
    names := [
        "malloc", "realloc", "free", "calloc", "memset", "memcpy", "memmove",
        "memcmp", "strlen", "strcmp", "strncmp", "strcpy", "strncpy", "strcat",
        "strncat", "strstr", "strchr", "strrchr", "strtol", "strtod", "atoi",
        "atof",
        "FindFirstFileA", "FindNextFileA", "FindClose", "WaitForSingleObject",
        "CloseHandle", "CreateMutexA", "ReleaseMutex", "Sleep", "SleepEx",
        "GetSystemTimeAsFileTime", "GetCurrentDirectoryA", "GetFileAttributesA",
        // std/fs spells the info-level param `int`; <windows.h> spells it
        // GET_FILEEX_INFO_LEVELS (an enum), which no Salam extern can
        // express, so this one is only ever safe behind the guard.
        "GetFileAttributesExA",
        "MultiByteToWideChar", "WideCharToMultiByte", "CreateWindowExA",
        "DestroyWindow", "IsWindow", "PeekMessageA", "TranslateMessage",
        "DispatchMessageA", "SetWindowTextA", "SetWindowPos",
        // std/os/process (CreateProcessA/CreatePipe/ReadFile/... for the
        // Run/RunCapture pipeline), std/debug (DebugBreak) and the REPL's
        // raw-console mode. Same collision as above: <windows.h> spells these
        // with HANDLE/DWORD/BOOL/LPVOID and STARTUPINFO-style struct pointers,
        // none of which a Salam extern can name, so any GUI program importing
        // those modules failed to compile without this. Derived by testing
        // every `extern:` name in std/ and compiler/ against <windows.h>.
        "CreateProcessA", "CreatePipe", "ReadFile", "GetStdHandle",
        "GetFileType", "GetLastError", "GetExitCodeProcess",
        "TerminateProcess", "SetHandleInformation", "MoveFileExA",
        "GetConsoleMode", "SetConsoleMode", "ReadConsoleInputA", "DebugBreak",
        // std/time's monotonic clock (QueryPerformanceCounter/Frequency take a
        // LARGE_INTEGER* that Salam spells `void*`) and the selfhost compiler's
        // own CPU-time profiling in sal_core (GetProcessTimes' FILETIME*
        // params, likewise `void*`). std/time reaches a GUI translation unit
        // transitively - webview -> ... -> debug -> time - so it collides there
        // even though nothing GUI calls it.
        "QueryPerformanceCounter", "QueryPerformanceFrequency",
        "GetCurrentProcess", "GetProcessTimes",
        // Both compilers' <windows.h> declares these; std/os/process'
        // CreateFileA/WriteFile are the ones a GUI build actually reaches
        // (Run/RunCapture redirect through them), and the GDI/user32 set
        // belongs to the drawing and window-property helpers. GetProp, SetProp
        // and LoadImage are macros over their ...A/...W variants there, so the
        // guard is the only way the two can agree.
        "CreateFileA", "WriteFile", "Arc", "BeginPath", "FillRect", "LineTo",
        "RoundRect", "LoadImage", "GetProp", "SetProp",
    ]
    // names.len(), never a literal: a hand-written bound silently stops
    // guarding the tail entries the next time a name is appended.
    repeat names.len() with i:
        if str.Equals(names[i], name):
            ret true
        end
    end
    ret false
end

// The <math.h> functions std/math declares in its own `extern:` block. Every
// generated header includes <math.h> (see hdr_prelude), and Salam spells
// these exactly as the standard does - `double f(double)` - so redeclaring
// them adds nothing and can only conflict with what the header already said.
//
// It does conflict, on tcc 0.9.28rc: its tcc_libm.h answers msvcrt's slow
// fabs() with a `__CRT_INLINE double __cdecl fabs(...)` of its own ("Override
// msvcrt fabs(): 6.3x speedup!"), which is `static`, so a plain include leaves
// a harmless local `t fabs` per object. A later `extern` redeclaration
// promotes that definition to external linkage, every module that includes
// math.h exports a body, and the link dies on "symbol 'fabs' defined twice" -
// 10 of the general tests, and any user program importing std/math. 0.9.27
// ships no tcc_libm.h and never saw it. Dropping the redeclarations fixes it
// for whatever the next such override turns out to be, too.
func is_libm_name(name: str): bool:
    names := [
        "sqrt", "sin", "cos", "tan", "asin", "acos", "atan", "atan2",
        "log", "log10", "exp", "floor", "ceil", "fabs", "fmod"
    ]
    repeat names.len() with i:
        if str.Equals(names[i], name):
            ret true
        end
    end
    ret false
end

// Declared by the <stdio.h> that hdr_prelude includes, so std/'s own `extern
// func fopen(...)` blocks must not be emitted at all: their salam spelling
// (`void*` for FILE*, `int` for long, `u64` for size_t) conflicts with the
// real prototype, and for fopen/fread/fwrite clang additionally rejects any
// declaration outside the header itself (-Wbuiltin-requires-header). Call
// sites keep compiling because void* converts to FILE* and back implicitly.
//
// Standard names, plus the non-C ones <stdio.h> declares on every platform
// that has them: std/fs, std/os and compiler/interp declare each group inside
// the matching half of a `if SALAM_OS_WINDOWS:` split, so a build that emits
// one is a build whose <stdio.h> already declared it. The Windows spellings
// are in mingw's header and in the bundled tcc's alike. Anything a platform
// might *not* have stays hand-declared.
func is_stdio_name(name: str): bool:
    names := [
        "clearerr", "fclose", "feof", "ferror", "fflush", "fgetc", "fgetpos",
        "fgets", "fopen", "fprintf", "fputc", "fputs", "fread", "freopen",
        "fscanf", "fseek", "fsetpos", "ftell", "fwrite", "getc", "getchar",
        "perror", "printf", "putc", "putchar", "puts", "remove", "rename",
        "rewind", "scanf", "setbuf", "setvbuf", "snprintf", "sprintf",
        "sscanf", "tmpfile", "tmpnam", "ungetc", "vfprintf", "vprintf",
        "vsnprintf", "vsprintf",
        "fdopen", "fileno", "fseeko", "ftello", "getdelim", "getline",
        "pclose", "popen",
        "_fdopen", "_fileno", "_fseeki64", "_ftelli64", "_pclose", "_popen"
    ]
    repeat names.len() with i:
        if str.Equals(names[i], name):
            ret true
        end
    end
    ret false
end

// <string.h>/<stdlib.h> names whose real prototype salam's type vocabulary
// cannot express, so an `extern func memcpy(dst: void*, src: void*, n: u64)`
// in std/mem came out as a declaration both gcc and clang consider
// incompatible with the library function they know (const-qualified source
// pointer, char** out-parameter, size_t/long widths). The C text wins over the
// salam signature for these; every call site still type-checks, because the
// differences only ever *add* a qualifier or widen a parameter.
//
// Only functions whose declaration is warned about are listed. The rest of the
// CRT surface std/ declares is emitted from its salam signature as before.
// Returns "" for anything not in the table.
func libc_canonical_proto(name: str): str:
    if str.Equals(name, "memcpy"):
        ret "extern void* memcpy(void* dst, const void* src, size_t n)"
    end
    if str.Equals(name, "memmove"):
        ret "extern void* memmove(void* dst, const void* src, size_t n)"
    end
    if str.Equals(name, "strstr"):
        ret "extern char* strstr(const char* haystack, const char* needle)"
    end
    if str.Equals(name, "strtol"):
        ret "extern long strtol(const char* s, char** endptr, int base)"
    end
    if str.Equals(name, "strtod"):
        ret "extern double strtod(const char* s, char** endptr)"
    end
    // Everything taking or returning a size. Salam spells these `u64`, which
    // codegen writes as `uint64_t` - the same type as size_t on LP64 Linux, so
    // gcc never objected, but a DIFFERENT type on macOS where size_t is
    // `unsigned long` and uint64_t is `unsigned long long`. clang then rejects
    // the second declaration outright:
    //
    //   error: conflicting types for 'strlen'
    //   extern uint64_t strlen(const char* s);
    //   note: previous declaration is here
    //   extern size_t strlen(const char* s);
    //
    // (the prelude's own, correct, one). That killed the stage 2 build.
    // memset's `int` matters for the same reason - `int32_t` is not spelled
    // `int` everywhere - and clang reports it as an
    // incompatible-library-redeclaration of a builtin.
    if str.Equals(name, "strlen"):
        ret "extern size_t strlen(const char* s)"
    end
    if str.Equals(name, "malloc"):
        ret "extern void* malloc(size_t size)"
    end
    if str.Equals(name, "calloc"):
        ret "extern void* calloc(size_t n, size_t size)"
    end
    if str.Equals(name, "realloc"):
        ret "extern void* realloc(void* ptr, size_t size)"
    end
    if str.Equals(name, "memset"):
        ret "extern void* memset(void* ptr, int value, size_t n)"
    end
    if str.Equals(name, "memcmp"):
        ret "extern int memcmp(const void* a, const void* b, size_t n)"
    end
    ret ""
end

// The gcc/clang-only half of the collision set: names that only *their*
// <windows.h> reaches, via <stdlib.h> and winsock. Guarded by
// SALAM_EXTERN_WIDE_LIBC_ON_WIN32, which tcc never defines, so tcc keeps
// emitting its own declarations exactly as before. Derived by probing every
// `extern:` name in std/ and compiler/ against the real GUI-mode header set
// with both compilers and taking the difference, not by hand.
func is_wide_libc_name(name: str): bool:
    names := [
        // <stdlib.h>, reached from windows.h only on gcc/clang
        "abort", "exit", "getenv", "system", "_putenv_s",
        // winsock.h, which windows.h includes unless WIN32_LEAN_AND_MEAN
        "socket", "bind", "listen", "accept", "connect", "shutdown",
        "closesocket", "ioctlsocket", "send", "recv", "sendto", "recvfrom",
        "setsockopt", "getsockname", "gethostbyname", "inet_ntoa", "htons",
        "ntohs", "WSAStartup",
        // wincrypt.h, same story - std/tls' native root-store reader
        "CertOpenSystemStoreA", "CertEnumCertificatesInStore", "CertCloseStore",
    ]
    repeat names.len() with i:
        if str.Equals(names[i], name):
            ret true
        end
    end
    ret false
end

func hdr_externs(g &: Cg, s &: sm.Sema, a &: at.Ast, program: int):
    prog := at.Get(a, program)
    repeat prog.list.len() with i:
        did := prog.list.get(i)
        d := at.Get(a, did)
        if !d.is_extern:
            continue
        end
        if d.kind == at.AST_FUNC_DEF:
            fsym := sm.LookupLocal(s, s.global, d.name)
            sig := sig_of_decl(s, fsym, did)
            // The libm/stdio suppressions exist because the real headers
            // already declare those names and clang warns about a second,
            // not-quite-matching declaration. Freestanding there is no
            // <stdio.h> and no <math.h>, so nothing else declares them and
            // the hand-declaration is the only one - keep it.
            suppress := !g.freestanding && (is_libm_name(d.name) || is_stdio_name(d.name))
            if sig != 0 && !suppress:
                mut guard := ""
                if is_wellknown_libc_name(d.name):
                    guard = "SALAM_EXTERN_LIBC_ON_WIN32"
                else is_wide_libc_name(d.name):
                    guard = "SALAM_EXTERN_WIDE_LIBC_ON_WIN32"
                end
                if str.Len(guard) > 0:
                    outh(g, "#ifndef " + guard + "\n")
                end
                mut proto := libc_canonical_proto(d.name)
                if str.Len(proto) == 0:
                    proto = cg_extern_proto(s, a, did, sig)
                end
                outh(g, proto + ";\n")
                if str.Len(guard) > 0:
                    outh(g, "#endif\n")
                end
            end
        else d.kind == at.AST_VAR_DECL:
            ts := str.Len(d.type_str) > 0 ? d.type_str : "int32_t"
            // cg_decl_cn, not cg_decl: an extern names a symbol defined
            // outside Salam, so it has to be spelled exactly as written.
            // cg_cident doubles interior underscores, which turned
            // `salam_embed_musl` into `salam__embed__musl` and left the link
            // undefined. Extern functions already went out raw; only the
            // variable form was encoded.
            outh(g, "extern " + cg_decl_cn(ts, d.name) + ";\n")
        end
    end
    outh(g, "\n")
end

func hdr_globals(g &: Cg, a &: at.Ast, program: int):
    prog := at.Get(a, program)
    repeat prog.list.len() with i:
        d := at.Get(a, prog.list.get(i))
        pkgmod := !str.Equals(g.pkg, "main")
        if d.kind != at.AST_CONST_DECL && d.kind != at.AST_VAR_DECL:
            continue
        end
        if d.is_extern || (!d.is_pub && !pkgmod):
            continue
        end
        ts := str.Len(d.type_str) > 0 ? d.type_str : "int32_t"
        // Must match emit_globals' spelling exactly (cg_global_cname).
        decl := cg_decl_cn(ts, cg_global_cname(g.pkg, d.name))
        is_array := str.IndexOf(ts, "[") >= 0
        can_defer := d.kind == at.AST_VAR_DECL && d.a != 0 && at.KindOf(a, d.a) != at.AST_LITERAL && !is_array
        // !is_array matches emit_globals in codegen_core - see the comment
        // there for why an array global cannot carry the qualifier. The two
        // must agree or the extern and the definition conflict.
        // !is_array and !type_is_callable match emit_globals in
        // codegen_core.salam - the two must agree or the extern and the
        // definition conflict.
        want_const := !can_defer && !is_array && !type_is_callable(ts) && (d.kind == at.AST_CONST_DECL || !d.is_mut)
        gct_const := want_const && str.StartsWith(cg_ctype(ts), "const ")
        pfx := (want_const && !gct_const) ? "const " : ""
        outh(g, "extern " + pfx + decl + ";\n")
    end
    outh(g, "\n")
end

func hdr_prototypes(g &: Cg, s &: sm.Sema, a &: at.Ast, program: int):
    prog := at.Get(a, program)
    repeat prog.list.len() with i:
        did := prog.list.get(i)
        d := at.Get(a, did)
        pkgmod := !str.Equals(g.pkg, "main")
        if d.typarams.len() > 0:
            continue
        end
        if d.is_extern:
            continue
        end
        if d.synthetic:
            continue
        end
        if d.kind == at.AST_FUNC_DEF && !str.Equals(d.name, g.entry) && (d.is_pub || pkgmod):
            fsym := sm.LookupLocal(s, s.global, d.name)
            sig := sig_of_decl(s, fsym, did)
            if sig != 0:
                outh(g, func_signature(g, s, a, did, 0, sig, false) + ";\n")
            end
        else d.kind == at.AST_STRUCT_DEF:
            ssym := sm.LookupLocal(s, s.global, d.name)
            if ssym == 0 || sm.SymAt(s, ssym).members == 0:
                continue
            end
            repeat d.list.len() with j:
                mid := d.list.get(j)
                m := at.Get(a, mid)
                if m.kind != at.AST_FUNC_DEF:
                    continue
                end
                msym := sm.LookupLocal(s, sm.SymAt(s, ssym).members, m.name)
                sig2 := sig_of_decl(s, msym, mid)
                if sig2 != 0:
                    outh(
                        g, func_signature(
                            g, s, a, mid, ssym, sig2, false
                        ) + ";\n"
                    )
                end
            end
        end
    end
end

// Prototypes for `impl Trait for T` methods, which codegen_core also
// forward-declares at the top of the .c. They are needed in the *header*
// as well: a generic function is instantiated as a `static inline` body
// appended to this header, and such a body calls the trait impls of
// whatever type it was instantiated with. Those calls sat above the .c's
// declarations, so the only thing that made them compile was C89 implicit
// declaration - tcc still allows it, gcc 16 made it an error, and the
// returned `const char*` came back as `int` on any compiler that took it.
func hdr_impl_prototypes(g &: Cg, s &: sm.Sema, a &: at.Ast):
    gsc := sm.ScopeAt(s, s.global)
    repeat gsc.symbols.len() with i:
        oid := gsc.symbols.get(i)
        owner := sm.SymAt(s, oid)
        if owner.kind != sm.SYM_TYPEIMPL || owner.members == 0:
            continue
        end
        msc := sm.ScopeAt(s, owner.members)
        repeat msc.symbols.len() with j:
            m := sm.SymAt(s, msc.symbols.get(j))
            if m.kind != sm.SYM_METHOD:
                continue
            end
            repeat m.overloads.len() with k:
                sig := m.overloads.get(k)
                if sig != 0 && sm.SigAt(s, sig).decl != 0:
                    outh(
                        g, func_signature(
                            g, s, a, sm.SigAt(s, sig).decl, oid, sig, false
                        ) + ";\n"
                    )
                end
            end
        end
    end
end

func cg_header_impl(g &: Cg, s &: sm.Sema, a &: at.Ast, program: int):
    hdr_prelude(g, a, program)
    hdr_enums(g, s, a, program)
    hdr_struct_fwd(g, s, a, program)
    hdr_struct_fwd_imports(g, s, a)
    dyn_collect(g, s, a, program)
    cg_emit_dyn_types(g, s)
    outh(g, "\n")
    vec_collect(g, a, program)
    vec_collect_types(g, s, a, program)
    repeat g.vec_types.len() with i:
        vec_emit_typedef(g, g.vec_types.get(i))
    end
    outh(g, "\n")
    hdr_structs(g, s, a, program)
    hdr_aliases(g, s, a, program)
    repeat g.variant_types.len() with i2:
        variant_emit_typedef(g, g.variant_types.get(i2))
    end
    outh(g, "\n")
    repeat g.vec_types.len() with i3:
        vec_emit(g, g.vec_types.get(i3))
    end
    outh(g, "\n")
    hdr_externs(g, s, a, program)
    hdr_globals(g, a, program)
    hdr_prototypes(g, s, a, program)
    hdr_impl_prototypes(g, s, a)
end
