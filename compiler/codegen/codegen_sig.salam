package codegen

import at "../ast.salam"
import sm "../semantic/semantic.salam"

// ===== codegen_overload.c (sig_of_decl only - ported in 6a because the
// header/prototype emission needs it; 6b must NOT re-port it) =====

// sig_of_decl - fsym is a SymId, decl an at.NodeId; returns a SigId (0 =
// C NULL).
func sig_of_decl(s &: sm.Sema, fsym: int, decl: int): int:
    if fsym == 0:
        ret 0
    end
    fs := sm.SymAt(s, fsym)
    repeat fs.overloads.len() with i:
        sg := fs.overloads.get(i)
        if sm.SigAt(s, sg).decl == decl:
            ret sg
        end
    end
    ret 0
end
