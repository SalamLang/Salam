package codegen

import str
import tok "../token.salam"
import at "../ast.salam"
import sm "../semantic/semantic.salam"

// ===== codegen_stmt.c =====

// `defer` is scoped to the block it is written in, not to the whole function.
// The registration list is still one flat per-function stack, but every nested
// block remembers its depth on entry and flushes back down to it on the way
// out, so a defer that names a block-local sees that name in scope:
//
//     if cond:
//         mut v := ...
//         defer v.free()     // emitted here, at the closing brace
//     end                    // - not at function exit, where v is gone
//
// That also makes the cleanup conditional (it only runs when the branch runs)
// and makes a defer in a loop body run once per iteration, which is what the
// interpreter does by registering defers as it reaches them.
//
// `ret` still flushes the whole stack, since it leaves every open block.
func cg_emit_defers_from(g &: Cg, s &: sm.Sema, a &: at.Ast, mark: int):
    mut i := g.fn_defers.len()
    until i > mark:
        cg_stmt(g, s, a, g.fn_defers.get(i - 1))
        i -= 1
    end
end

// cg_emit_defers - flush g.fn_defers LIFO (without popping).
func cg_emit_defers(g &: Cg, s &: sm.Sema, a &: at.Ast):
    cg_emit_defers_from(g, s, a, 0)
end

func defers_trunc(g &: Cg, mark: int):
    until g.fn_defers.len() > mark:
        _dropped := g.fn_defers.pop()
    end
end

// A block whose last statement jumps has already emitted its defers on that
// path (ret flushes everything, break/continue flush back to the loop mark),
// so a second copy at the closing brace would be dead code.
func cg_list_terminates(a &: at.Ast, blockid: int): bool:
    bn := at.Get(a, blockid)
    n := bn.list.len()
    if n == 0:
        ret false
    end
    k := at.KindOf(a, bn.list.get(n - 1))
    ret k == at.AST_RETURN || k == at.AST_BREAK || k == at.AST_CONTINUE
end

// Emit the statements of a nested block, then its own defers, then drop them.
func cg_scoped_stmts(g &: Cg, s &: sm.Sema, a &: at.Ast, blockid: int):
    lmark := g.locals.len()
    dmark := g.fn_defers.len()
    bn := at.Get(a, blockid)
    repeat bn.list.len() with i:
        cg_stmt(g, s, a, bn.list.get(i))
    end
    if cg_list_terminates(a, blockid) == false:
        cg_emit_defers_from(g, s, a, dmark)
    end
    defers_trunc(g, dmark)
    locals_trunc(g, lmark)
end

// Loop bodies additionally record their defer depth so that break/continue,
// which skip the end of the body, still run what the body registered.
func cg_loop_push(g &: Cg):
    g.loop_dmark.push(g.fn_defers.len())
end

func cg_loop_pop(g &: Cg):
    if g.loop_dmark.len() > 0:
        _dropped := g.loop_dmark.pop()
    end
end

func cg_emit_loop_exit_defers(g &: Cg, s &: sm.Sema, a &: at.Ast):
    n := g.loop_dmark.len()
    if n > 0:
        cg_emit_defers_from(g, s, a, g.loop_dmark.get(n - 1))
    end
end

// cg_expr parenthesizes every binary expression it builds, so `if (%s)` came
// out as `if ((f == NULL))`. clang reads doubled parens around an equality
// test as the "did you mean = ?" idiom and warns on every one of them
// (-Wparentheses-equality; 22 in a benchmark-runner build alone), and gcc does
// the same under -Wall. Dropping the redundant layer at the condition sites
// fixes it without changing how expressions are built anywhere else.
//
// The outer parens only come off when they wrap the whole expression: `(a) &&
// (b)` opens and closes before the end and is left alone. String and char
// literals are skipped so a parenthesis inside one is not counted.
func cg_unparen(e: str): str:
    n := e.len()
    // `({ ... })` is a GNU statement expression: those parens are syntax, not
    // grouping, and taking them off leaves a block where an expression goes.
    if n < 2 || byte_at(e, 0) != 40 || byte_at(e, n - 1) != 41 || byte_at(e, 1) == 123:
        ret e
    end
    mut depth := 0
    mut i := 0
    until i < n:
        c := byte_at(e, i)
        if c == 34 || c == 39:
            i += 1
            until i < n && byte_at(e, i) != c:
                if byte_at(e, i) == 92:
                    i += 1
                end
                i += 1
            end
        else c == 40:
            depth += 1
        else c == 41:
            depth -= 1
            if depth == 0 && i + 1 != n:
                ret e
            end
        end
        i += 1
    end
    if depth != 0:
        ret e
    end
    ret e.substr(1, n - 2)
end

func cg_cond(g &: Cg, s &: sm.Sema, a &: at.Ast, n: int): str:
    ret cg_unparen(cg_expr(g, s, a, n))
end

func cg_vardecl_inline(g &: Cg, s &: sm.Sema, a &: at.Ast, n: int): str:
    nn := at.Get(a, n)
    ts := str.Len(nn.type_str) > 0 ? nn.type_str : "int32_t"
    decl := cg_decl(ts, nn.name)
    local_add(g, nn.name)
    is_ref := str.IndexOf(ts, "[") >= 0 || str.EndsWith(ts, "*") || struct_by_name(s, ts) != 0
    already_const := str.StartsWith(cg_ctype(ts), "const ")
    prefix := (nn.is_mut || is_ref || already_const) ? "" : "const "
    if nn.a != 0:
        ret prefix + decl + " = " + cg_expr(g, s, a, nn.a)
    end
    // No initializer. Sema rejects every read that no assignment precedes, but
    // a `&:` parameter the callee only writes on some paths would still leave
    // this slot indeterminate, so zero it: a defined value beats UB. `= {0}`
    // initializes scalars, pointers, arrays and structs alike (C11 6.7.9p11).
    ret prefix + decl + " = {0}"
end

func cg_simple_inline(g &: Cg, s &: sm.Sema, a &: at.Ast, n: int): str:
    nn := at.Get(a, n)
    if nn.kind == at.AST_VAR_DECL:
        ret cg_vardecl_inline(g, s, a, n)
    end
    if nn.kind == at.AST_ASSIGN:
        if nn.op == tok.TK_POWER_EQ:
            e1 := cg_expr(g, s, a, nn.a)
            e2 := cg_expr(g, s, a, nn.a)
            e3 := cg_expr(g, s, a, nn.b)
            ret e1 + " = pow(SALAM_FPARG_D((double)(" + e2 + ")), (double)(" + e3 + "))"
        end
        ea := cg_expr(g, s, a, nn.a)
        eb := cg_expr(g, s, a, nn.b)
        ret ea + " " + cg_op(nn.op) + " " + eb
    end
    if nn.kind == at.AST_EXPR_STMT:
        ret cg_expr(g, s, a, nn.a)
    end
    ret cg_expr(g, s, a, n)
end

func cg_stmt(g &: Cg, s &: sm.Sema, a &: at.Ast, n: int):
    if n == 0:
        ret
    end
    cg_source_line(g, span_of(a, n))
    nn := at.Get(a, n)
    k := nn.kind
    if k == at.AST_BLOCK:
        cg_block(g, s, a, n)
        ret
    end
    if k == at.AST_VAR_DECL:
        if str.StartsWith(nn.type_str, "dyn ") && str.IndexOf(nn.type_str, "[") >= 0 && nn.a != 0 && at.KindOf(a, nn.a) == at.AST_ARRAY_LIT:
            local_add(g, nn.name)
            cg_line(g, cg_decl(nn.type_str, nn.name) + ";")
            an := at.Get(a, nn.a)
            repeat an.list.len() with i:
                cg_line(
                    g, cg_cident(nn.name) + "[" + i + "] = " + cg_expr(g, s, a, an.list.get(i)) + ";"
                )
            end
            ret
        end
        cg_line(g, cg_vardecl_inline(g, s, a, n) + ";")
        ret
    end
    if k == at.AST_CONST_DECL:
        cts := str.Len(nn.type_str) > 0 ? nn.type_str : "int32_t"
        decl := cg_decl(cts, nn.name)
        local_add(g, nn.name)
        cpfx := str.StartsWith(cg_ctype(cts), "const ") ? "" : "const "
        cg_line(g, cpfx + decl + " = " + cg_expr(g, s, a, nn.a) + ";")
        ret
    end
    if k == at.AST_ASSIGN:
        if nn.op == tok.TK_ASSIGN && nn.a != 0 && at.KindOf(a, nn.a) == at.AST_INDEX:
            ixn := at.Get(a, nn.a)
            container_ts := at.Get(a, ixn.a).type_str
            if ixn.a != 0 && str.Len(container_ts) > 0:
                mut sname := ""
                ssym := cg_struct_of(s, container_ts, sname)
                if ssym != 0:
                    m := sm.LookupLocal(
                        s, sm.SymAt(s, ssym).members, "operator_index_set"
                    )
                    if m != 0 && sm.SymAt(s, m).kind == sm.SYM_METHOD:
                        sig := pick_op_overload(s, m, 2)
                        if sig != 0:
                            mangled := cg_mangle_method(
                                g, s, sname, ssym, "operator_index_set", sm.SigAt(s, sig).params
                            )
                            container := ixn.a
                            idx_c := cg_expr(g, s, a, ixn.b)
                            val_c := cg_expr(g, s, a, nn.b)
                            ck := at.KindOf(a, container)
                            addressable := ck == at.AST_IDENTIFIER || ck == at.AST_MEMBER || ck == at.AST_INDEX || ck == at.AST_THIS
                            if addressable:
                                recv := "&(" + cg_expr(g, s, a, container) + ")"
                                cg_line(
                                    g, mangled + "(" + recv + ", " + idx_c + ", " + val_c + ");"
                                )
                            else:
                                g.tmpn += 1
                                t := g.tmpn
                                cts2 := at.Get(a, container).type_str
                                ct := cg_ctype(str.Len(cts2) > 0 ? cts2 : sname)
                                lc := cg_expr(g, s, a, container)
                                cg_line(
                                    g, "{ " + ct + " __t" + t + " = (" + lc + "); " + mangled + "(&__t" + t + ", " + idx_c + ", " + val_c + "); }"
                                )
                            end
                            ret
                        end
                    end
                end
            end
        end
        if nn.op != tok.TK_ASSIGN && nn.a != 0 && str.Len(at.Get(a, nn.a).type_str) > 0:
            base_op := cg_compound_base(nn.op)
            if base_op != tok.TK_EOF:
                mut sname2 := ""
                ssym2 := cg_struct_of(s, at.Get(a, nn.a).type_str, sname2)
                if ssym2 != 0:
                    mname := cg_op_method(base_op)
                    if str.Len(mname) > 0:
                        callv := cg_emit_op_call(
                            g, s, a, nn.a, ssym2, sname2, mname, nn.b
                        )
                        if str.Len(callv) > 0:
                            cg_line(
                                g, cg_expr(g, s, a, nn.a) + " = " + callv + ";"
                            )
                            ret
                        end
                    end
                end
            end
        end
        if nn.op == tok.TK_PLUS_EQ && str.Equals(at.Get(a, nn.a).type_str, "str"):
            e1 := cg_expr(g, s, a, nn.a)
            e2 := cg_expr(g, s, a, nn.a)
            ob := cg_str_operand(g, s, a, nn.b)
            cg_line(g, e1 + " = salam_strcat(" + e2 + ", " + ob + ");")
            ret
        end
        if nn.op == tok.TK_POWER_EQ:
            a_ts := at.Get(a, nn.a).type_str
            ct2 := cg_ctype(str.Len(a_ts) > 0 ? a_ts : "double")
            g.tmpn += 1
            t2 := g.tmpn
            lhs := cg_expr(g, s, a, nn.a)
            rhs := cg_expr(g, s, a, nn.b)
            cg_line(
                g, "{ " + ct2 + " *__pw" + t2 + " = &(" + lhs + "); " + "*__pw" + t2 + " = (" + ct2 + ")pow(SALAM_FPARG_D((double)(*__pw" + t2 + ")), (double)(" + rhs + ")); }"
            )
            ret
        end
        ea := cg_expr(g, s, a, nn.a)
        eb := cg_expr(g, s, a, nn.b)
        cg_line(g, ea + " " + cg_op(nn.op) + " " + eb + ";")
        ret
    end
    if k == at.AST_EXPR_STMT:
        // A call returning a struct is built as a GNU statement expression
        // whose value is the temporary it filled in. Called for its effect
        // only, that trailing value is dropped, and clang says so
        // (-Wunused-value). Casting to void is how C spells "yes, on purpose".
        e := cg_expr(g, s, a, nn.a)
        mut pfx := ""
        if byte_at(e, 0) == 40 && byte_at(e, 1) == 123:
            pfx = "(void)"
        end
        cg_line(g, pfx + e + ";")
        ret
    end
    if k == at.AST_DEFER:
        g.fn_defers.push(nn.a)
        ret
    end
    if k == at.AST_RETURN:
        if str.Len(g.match_result_tmp) > 0:
            if nn.a != 0:
                cg_line(
                    g, g.match_result_tmp + " = (" + g.match_result_ctype + ")(" + cg_expr(g, s, a, nn.a) + "); goto " + g.match_end_label + ";"
                )
            else:
                cg_line(g, "goto " + g.match_end_label + ";")
            end
            ret
        end
        if nn.a != 0 && g.fn_defers.len() > 0:
            expr := cg_expr(g, s, a, nn.a)
            r_ts := at.Get(a, nn.a).type_str
            g.tmpn += 1
            t := g.tmpn
            tmp := "__retv" + t
            cg_line(
                g, cg_ctype(str.Len(r_ts) > 0 ? r_ts : "int32_t") + " " + tmp + " = (" + expr + ");"
            )
            cg_emit_defers(g, s, a)
            if g.cur_sret:
                cg_line(g, "*__ret = " + tmp + "; return;")
            else:
                cg_line(g, "return " + tmp + ";")
            end
        else nn.a != 0 && g.cur_sret:
            cg_emit_defers(g, s, a)
            cg_line(g, "*__ret = (" + cg_expr(g, s, a, nn.a) + "); return;")
        else nn.a != 0:
            cg_emit_defers(g, s, a)
            cg_line(g, "return " + cg_expr(g, s, a, nn.a) + ";")
        else:
            cg_emit_defers(g, s, a)
            // `func main:` has no declared return type but is emitted as C's
            // `int main`, so a bare `ret` in it is a bare `return;` from a
            // non-void function. tcc accepts that silently; gcc 16 makes
            // -Wreturn-mismatch an error, which took out every telegram/
            // websocket example that ends a branch with a bare `ret`. The
            // language already says main implicitly returns i32, so the
            // value that `ret` means here is 0.
            if g.cur_is_main:
                cg_line(g, "return 0;")
            else:
                cg_line(g, "return;")
            end
        end
        ret
    end
    if k == at.AST_MATCH:
        subj_ts := at.Get(a, nn.a).type_str
        g.tmpn += 1
        t := g.tmpn
        subj_var := "__msubj" + t
        cg_line(g, "{")
        g.indent += 1
        cg_line(
            g, cg_ctype(str.Len(subj_ts) > 0 ? subj_ts : "int32_t") + " " + subj_var + " = (" + cg_expr(g, s, a, nn.a) + ");"
        )
        repeat nn.list.len() with i:
            armid := nn.list.get(i)
            cond := cg_unparen(cg_match_arm_cond(g, s, a, armid, subj_var, subj_ts))
            cg_line(g, (i > 0 ? "} else " : "") + "if (" + cond + ") {")
            g.indent += 1
            cg_scoped_stmts(g, s, a, at.Get(a, armid).b)
            g.indent -= 1
        end
        if nn.list.len() > 0:
            cg_line(g, "}")
        end
        g.indent -= 1
        cg_line(g, "}")
        ret
    end
    if k == at.AST_BREAK:
        cg_emit_loop_exit_defers(g, s, a)
        cg_line(g, "break;")
        ret
    end
    if k == at.AST_CONTINUE:
        cg_emit_loop_exit_defers(g, s, a)
        cg_line(g, "continue;")
        ret
    end
    if k == at.AST_IF:
        cg_line(g, "if (" + cg_cond(g, s, a, nn.a) + ") {")
        g.indent += 1
        cg_scoped_stmts(g, s, a, nn.b)
        g.indent -= 1
        if nn.c != 0 && at.KindOf(a, nn.c) == at.AST_IF:
            cg_indent(g)
            out(g, "} else ")
            en := at.Get(a, nn.c)
            out(g, "if (" + cg_cond(g, s, a, en.a) + ") {\n")
            g.indent += 1
            cg_scoped_stmts(g, s, a, en.b)
            g.indent -= 1
            if en.c != 0:
                cg_line(g, "} else {")
                g.indent += 1
                cg_stmt(g, s, a, en.c)
                g.indent -= 1
            end
            cg_line(g, "}")
        else nn.c != 0:
            cg_line(g, "} else {")
            g.indent += 1
            cg_scoped_stmts(g, s, a, nn.c)
            g.indent -= 1
            cg_line(g, "}")
        else:
            cg_line(g, "}")
        end
        ret
    end
    if k == at.AST_UNTIL:
        cg_line(g, "while (" + cg_cond(g, s, a, nn.a) + ") {")
        g.indent += 1
        cg_loop_push(g)
        cg_scoped_stmts(g, s, a, nn.b)
        cg_loop_pop(g)
        g.indent -= 1
        cg_line(g, "}")
        ret
    end
    if k == at.AST_REPEAT:
        g.tmpn += 1
        t := g.tmpn
        if nn.c != 0:
            from_c := cg_expr(g, s, a, nn.a)
            to_c := cg_expr(g, s, a, nn.c)
            mut step := "1"
            if nn.d != 0:
                step = cg_expr(g, s, a, nn.d)
            end
            cg_line(
                g, "for (int64_t __rep" + t + " = (int64_t)(" + from_c + "), __repe" + t + " = (int64_t)(" + to_c + "), __repa" + t + " = (int64_t)(" + step + "), __reps" + t + " = (__rep" + t + " <= __repe" + t + ") ? __repa" + t + " : -__repa" + t + "; (__reps" + t + " > 0) ? (__rep" + t + " <= __repe" + t + ") : (__rep" + t + " >= __repe" + t + "); __rep" + t + " += __reps" + t + ") {"
            )
        else:
            cg_line(
                g, "for (int64_t __rep" + t + " = 0, __repn" + t + " = (int64_t)(" + cg_expr(g, s, a, nn.a) + "); __rep" + t + " < __repn" + t + "; __rep" + t + "++) {"
            )
        end
        g.indent += 1
        cg_loop_push(g)
        mark := g.locals.len()
        if str.Len(nn.name) > 0:
            ivct := cg_ctype(str.Len(nn.type_str) > 0 ? nn.type_str : "i32")
            cg_line(
                g, "const " + ivct + " " + cg_cident(nn.name) + " = (" + ivct + ")__rep" + t + ";"
            )
            local_add(g, nn.name)
        end
        cg_scoped_stmts(g, s, a, nn.b)
        locals_trunc(g, mark)
        cg_loop_pop(g)
        g.indent -= 1
        cg_line(g, "}")
        ret
    end
    if k == at.AST_FOR:
        mark := g.locals.len()
        mut init := ""
        if nn.a != 0:
            init = cg_simple_inline(g, s, a, nn.a)
        end
        mut cond := ""
        if nn.b != 0:
            cond = cg_expr(g, s, a, nn.b)
        end
        mut post := ""
        if nn.c != 0:
            post = cg_simple_inline(g, s, a, nn.c)
        end
        cg_line(g, "for (" + init + "; " + cond + "; " + post + ") {")
        g.indent += 1
        cg_loop_push(g)
        cg_scoped_stmts(g, s, a, nn.d)
        cg_loop_pop(g)
        g.indent -= 1
        cg_line(g, "}")
        locals_trunc(g, mark)
        ret
    end
end

func cg_block(g &: Cg, s &: sm.Sema, a &: at.Ast, block: int):
    cg_scoped_stmts(g, s, a, block)
end
