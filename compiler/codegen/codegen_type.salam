package codegen

import str
import co "../sal_core.salam"
import tok "../token.salam"
import sm "../semantic/semantic.salam"

// ===== codegen_type.c =====

// cg_kv - split "Map<K, V>"-style typestrs; cap mirrors the C buffer size.
func cg_kv(ts: str, kbuf &: str, vbuf &: str, cap: int):
    kbuf = ""
    vbuf = ""
    lt := str.IndexOf(ts, "<")
    if lt < 0:
        ret
    end
    comma := str.IndexFrom(ts, ",", lt)
    gt := str.LastIndex(ts, ">")
    if comma < 0 || gt < 0:
        ret
    end
    mut ks := lt + 1
    until ks < str.Len(ts) && byte_at(ts, ks) == 32:
        ks += 1
    end
    mut ke := comma
    until ke > ks && byte_at(ts, ke - 1) == 32:
        ke -= 1
    end
    mut vs := comma + 1
    until vs < str.Len(ts) && byte_at(ts, vs) == 32:
        vs += 1
    end
    mut ve := gt
    until ve > vs && byte_at(ts, ve - 1) == 32:
        ve -= 1
    end
    mut kl := ke - ks
    if kl >= cap:
        kl = cap - 1
    end
    kbuf = str.Substr(ts, ks, kl)
    mut vl := ve - vs
    if vl >= cap:
        vl = cap - 1
    end
    vbuf = str.Substr(ts, vs, vl)
end

func cg_put_ident_byte(b &: str.StringBuilder, c: int):
    if is_alnum_b(c):
        co.SbPutc(b, c)
    else c == 95:
        co.SbPuts(b, "__")
    else:
        co.SbPutc(b, 95)
        hi := (c >> 4) & 15
        lo := c & 15
        co.SbPutc(b, hi < 10 ? 48 + hi : 87 + hi)
        co.SbPutc(b, lo < 10 ? 48 + lo : 87 + lo)
    end
end

func cg_is_c_keyword(s: str): bool:
    repeat K_CG_CKW_COUNT with i:
        if str.Equals(s, k_cg_ckw[i]):
            ret true
        end
    end
    ret false
end

func cg_cident(name: str): str:
    if str.Len(name) == 0:
        ret "_"
    end
    n := str.Len(name)
    mut ok := !is_digit_b(byte_at(name, 0))
    mut i := 0
    until ok && i < n:
        if !is_alnum_b(byte_at(name, i)):
            ok = false
        end
        i += 1
    end
    if ok:
        if cg_is_c_keyword(name):
            ret name + "_"
        end
        ret name
    end
    mut b := co.SbNew()
    if is_digit_b(byte_at(name, 0)):
        co.SbPutc(b, 95)
    end
    // A LEADING underscore is copied through as one, not doubled. C reserves
    // every identifier starting with "__" for the implementation, and gcc
    // really does use that space: on x86-64 it predefines __k8 as an
    // architecture macro, so Salam's `_k8` (the ordinary "declared but
    // unused" spelling) became C's `__k8` and expanded to `1`. Interior
    // underscores still double, so the mangling stays one-to-one:
    // `_a_b` -> `_a__b`, while `a_b` -> `a__b`.
    mut j := 0
    if byte_at(name, 0) == 95:
        co.SbPutc(b, 95)
        j = 1
    end
    until j < n:
        cg_put_ident_byte(b, byte_at(name, j))
        j += 1
    end
    r := co.SbCstr(b)
    co.SbFree(b)
    // Copying the leading underscore through as one lets a name land exactly
    // on a C keyword that the doubling used to step over: `_Bool` came out as
    // `__Bool` before, and as plain `_Bool` now - "two or more data types in
    // declaration specifiers". The suffix is the same escape the all-alnum
    // path above already applies to `int`, `while` and friends.
    if cg_is_c_keyword(r):
        ret r + "_"
    end
    ret r
end

// base_ctype - `found` mirrors the C's pointer-identity check (bc == base).
func base_ctype(base: str, found &: bool): str:
    repeat K_CG_BASE_COUNT with i:
        if str.Equals(base, k_cg_base_s[i]):
            found = true
            ret k_cg_base_c[i]
        end
    end
    found = false
    ret base
end

// A lambda, closure or function value. All of them lower to the `void*` that
// carries the closure environment, which matters beyond the C spelling: a
// callee takes that pointer as a plain `void*` and may write through it (a
// counter closure updates the state it captured), so such a binding must not
// be const-qualified even when the Salam name is immutable.
func type_is_callable(ts: str): bool:
    ret str.StartsWith(ts, "func(") || str.StartsWith(ts, "externfunc(")
end

// parse_typestr_ex - cap mirrors the caller's base[] buffer size, plus the
// star count that belongs to an array's ELEMENT type: "Edge*[6]" yields
// base "Edge", dims {6}, ptr false, eptr 1.
func parse_typestr_ex(
    ts: str, cap: int, base &: str, ptr &: bool, dims &: Vector<int>, eptr &: int, pdepth &: int
):
    ptr = false
    eptr = 0
    pdepth = 0
    dims.clear()
    tslen := str.Len(ts)
    mut n := tslen
    // Stars nest: Vector<Edge*> lays its data pointer out as "Edge**", so
    // the whole trailing run is counted rather than just the last one.
    until n > 0 && byte_at(ts, n - 1) == 42:
        ptr = true
        pdepth += 1
        n -= 1
    end
    mut lb := 0 - 1
    mut i := 0
    until i < n:
        if byte_at(ts, i) == 91:
            lb = i
            break
        end
        i += 1
    end
    mut blen := n
    if lb >= 0:
        blen = lb
    end
    // An array OF pointers spells its stars between the element name and
    // the first '[' - "Edge*[6]" is six Edge*, not a pointer to anything.
    // They have to come off `base` here: everything downstream feeds the
    // base through cg_cident, which would hex-escape the '*' into a type
    // name that was never declared. The count travels out via eptr so
    // callers can put the stars back on the element type.
    until blen > 0 && byte_at(ts, blen - 1) == 42:
        blen -= 1
        eptr += 1
    end
    if lb >= 0:
        mut p := lb
        until p < n && byte_at(ts, p) == 91:
            mut rb := 0 - 1
            mut q := p + 1
            until q < tslen:
                if byte_at(ts, q) == 93:
                    rb = q
                    break
                end
                q += 1
            end
            if rb < 0:
                break
            end
            mut d := 0
            mut q2 := p + 1
            until q2 < rb:
                c := byte_at(ts, q2)
                if c >= 48 && c <= 57:
                    d = d * 10 + (c - 48)
                end
                q2 += 1
            end
            dims.push(d)
            p = rb + 1
        end
    end
    if blen >= cap:
        blen = cap - 1
    end
    base = str.Substr(ts, 0, blen)
end

func parse_typestr(
    ts: str, cap: int, base &: str, ptr &: bool, dims &: Vector<int>
):
    mut eptr := 0
    mut pdepth := 0
    parse_typestr_ex(ts, cap, base, ptr, dims, eptr, pdepth)
end

func cg_is_int_typestr(ts: str): bool:
    ret str.Equals(ts, "i8") || str.Equals(ts, "i16") || str.Equals(ts, "i32") || str.Equals(ts, "i64") || str.Equals(ts, "u8") || str.Equals(ts, "u16") || str.Equals(ts, "u32") || str.Equals(ts, "u64") || str.Equals(ts, "size")
end

func cg_is_unsigned_typestr(ts: str): bool:
    ret str.Equals(ts, "u8") || str.Equals(ts, "u16") || str.Equals(ts, "u32") || str.Equals(ts, "u64") || str.Equals(ts, "size")
end

// The unsigned type of the same width, or `ts` itself when there isn't one.
//
// Salam defines +, - and * to wrap modulo 2^n in the operand type
// (SALAM-TYPES 4.1, 15), but signed overflow is undefined in C, not wrapping:
// at -O2 gcc is entitled to assume it never happens and fold the branch that
// checks for it. Emitting the arithmetic in the unsigned twin and converting
// the result back gives exactly the defined wrap Salam promises - unsigned
// arithmetic is modular by definition, and the narrowing conversion back is
// two's complement on every target Salam supports (and mandated by C23).
func cg_unsigned_twin(ts: str): str:
    if str.Equals(ts, "i8"):
        ret "u8"
    end
    if str.Equals(ts, "i16"):
        ret "u16"
    end
    if str.Equals(ts, "i32"):
        ret "u32"
    end
    if str.Equals(ts, "i64"):
        ret "u64"
    end
    ret ts
end

func cg_int_ts_bits(ts: str): int:
    if str.Equals(ts, "i8") || str.Equals(ts, "u8"):
        ret 8
    end
    if str.Equals(ts, "i16") || str.Equals(ts, "u16"):
        ret 16
    end
    if str.Equals(ts, "i32") || str.Equals(ts, "u32"):
        ret 32
    end
    ret 64
end

// Common type of an integer binary operation (SALAM-TYPES.md 15): same
// signedness picks the higher rank, mixed signedness has no common type
// (semantic analysis rejects it as E021).
func cg_common_int_typestr(x: str, y: str): str:
    if !cg_is_int_typestr(x) || !cg_is_int_typestr(y):
        ret ""
    end
    if str.Equals(x, y):
        ret x
    end
    if cg_is_unsigned_typestr(x) != cg_is_unsigned_typestr(y):
        ret ""
    end
    ret cg_int_ts_bits(x) >= cg_int_ts_bits(y) ? x : y
end

func cg_op_is_cmp(k: int): bool:
    ret k == tok.TK_EQ || k == tok.TK_NE || k == tok.TK_LT || k == tok.TK_GT || k == tok.TK_LE || k == tok.TK_GE
end

// cg_vec_elem - elem of "Vector<T>" (cap mirrors the C ebuf).
func cg_vec_elem(ts: str, cap: int): str:
    lt := str.IndexOf(ts, "<")
    gt := str.LastIndex(ts, ">")
    if lt < 0 || gt < 0 || gt <= lt:
        ret ""
    end
    mut es := lt + 1
    until es < str.Len(ts) && byte_at(ts, es) == 32:
        es += 1
    end
    mut ee := gt
    until ee > es && byte_at(ts, ee - 1) == 32:
        ee -= 1
    end
    mut el := ee - es
    if el >= cap:
        el = cap - 1
    end
    ret str.Substr(ts, es, el)
end

func cg_encode_typestr(b &: str.StringBuilder, s: str, skip_spaces: bool):
    n := str.Len(s)
    mut i := 0
    until i < n:
        c := byte_at(s, i)
        if c == 42:
            co.SbPuts(b, "_ptr")
        else c == 91:
            co.SbPuts(b, "_arr")
        else:
            // ']' is dropped; so is ' ' when skip_spaces.
            if c != 93 && !(c == 32 && skip_spaces):
                cg_put_ident_byte(b, c)
            end
        end
        i += 1
    end
end

func cg_vec_code_str(elem: str): str:
    mut b := co.SbNew()
    cg_encode_typestr(b, elem, true)
    r := co.SbCstr(b)
    co.SbFree(b)
    ret r
end

func cg_vec_cname(ts: str): str:
    ret "Vector_" + cg_vec_code_str(cg_vec_elem(ts, 96))
end

// cg_variant_push_trimmed - [64][160] clamps kept.
func variant_push_trimmed(ts: str, s0: int, e0: int, out2 &: Vector<str>):
    mut s := s0
    mut e := e0
    until s < e && byte_at(ts, s) == 32:
        s += 1
    end
    until e > s && byte_at(ts, e - 1) == 32:
        e -= 1
    end
    if out2.len() >= 64:
        ret
    end
    mut l := e - s
    if l >= 160:
        l = 159
    end
    out2.push(str.Substr(ts, s, l))
end

// cg_variant_members - the caller frees the returned vector.
func cg_variant_members(ts: str): Vector<str>:
    mut mv := Vector {} as Vector<str>
    lt := str.IndexOf(ts, "<")
    gt := str.LastIndex(ts, ">")
    if lt < 0 || gt < 0 || gt <= lt:
        ret mv
    end
    mut start := lt + 1
    mut depth := 0
    mut p := start
    until p < gt:
        c := byte_at(ts, p)
        if c == 60:
            depth += 1
        else c == 62:
            depth -= 1
        else c == 44 && depth == 0:
            variant_push_trimmed(ts, start, p, mv)
            start = p + 1
        end
        p += 1
    end
    variant_push_trimmed(ts, start, gt, mv)
    ret mv
end

func cg_variant_cname(ts: str): str:
    mut members := cg_variant_members(ts)
    defer members.free()
    mut b := co.SbNew()
    co.SbPuts(b, "_Salam_variant")
    repeat members.len() with i:
        co.SbPutc(b, 95)
        co.SbPuts(b, cg_vec_code_str(members.get(i)))
    end
    r := co.SbCstr(b)
    co.SbFree(b)
    ret r
end

func cg_variant_tag_of(variant_ts: str, member_ts: str): int:
    mut members := cg_variant_members(variant_ts)
    defer members.free()
    mut r := 0 - 1
    repeat members.len() with i:
        if r < 0 && str.Equals(members.get(i), member_ts):
            r = i
        end
    end
    ret r
end

// A type string that names a pointer. `x[i]` over one is address
// arithmetic, never the pointee's operator_index (see sema's AST_INDEX).
func cg_is_ptr_ts(ts: str): bool:
    ret str.EndsWith(ts, "*")
end

func cg_is_slice_ts(ts: str): bool:
    ret str.StartsWith(ts, "slice<")
end

func cg_slice_elem(ts: str, cap: int): str:
    ret cg_vec_elem(ts, cap)
end

// strpbrk(p, "[*") - index of the first '[' or '*' at/after `from`, -1 none.
func pbrk_arr_star(s: str, from: int): int:
    n := str.Len(s)
    mut i := from
    until i < n:
        c := byte_at(s, i)
        if c == 91 || c == 42:
            ret i
        end
        i += 1
    end
    ret 0 - 1
end

func cg_ctype(ts: str): str:
    if str.Len(ts) == 0:
        ret "void"
    end
    if cg_is_slice_ts(ts):
        ret "salam_slice"
    end
    if str.StartsWith(ts, "Variant<"):
        ret cg_variant_cname(ts)
    end
    if str.StartsWith(ts, "dyn "):
        suf := pbrk_arr_star(ts, 4)
        mut il := (suf >= 0 ? suf : str.Len(ts)) - 4
        if il >= 96:
            il = 95
        end
        iface := str.Substr(ts, 4, il)
        ret "_Salam_dyn_" + cg_cident(iface) + (suf >= 0 ? "*" : "")
    end
    if type_is_callable(ts):
        ret "void*"
    end
    mut base := ""
    mut ptr := false
    mut dims := Vector {} as Vector<int>
    defer dims.free()
    mut eptr := 0
    mut pdepth := 0
    parse_typestr_ex(ts, 96, base, ptr, dims, eptr, pdepth)
    mut found := false
    mut bc := base_ctype(base, found)
    if !found:
        bc = cg_cident(base)
    end
    until eptr > 0:
        bc = bc + "*"
        eptr -= 1
    end
    if dims.len() > 0:
        ret bc + "*"
    end
    until pdepth > 0:
        bc = bc + "*"
        pdepth -= 1
    end
    ret bc
end

// The C spelling of an array type with no declarator attached -
// "int32_t[3]" - which is what a compound literal needs in front of its
// braces. "" for anything that is not a plain array of a nameable element
// type, so callers can fall back to the bare brace form.
func cg_array_ctype(ts: str): str:
    if str.Len(ts) == 0 || cg_is_slice_ts(ts) || str.StartsWith(ts, "Variant<") || str.StartsWith(ts, "dyn ") || str.StartsWith(ts, "func("):
        ret ""
    end
    mut base := ""
    mut ptr := false
    mut dims := Vector {} as Vector<int>
    defer dims.free()
    mut eptr := 0
    mut pdepth := 0
    parse_typestr_ex(ts, 96, base, ptr, dims, eptr, pdepth)
    if dims.len() == 0 || ptr:
        ret ""
    end
    mut found := false
    mut bc := base_ctype(base, found)
    if !found:
        bc = cg_cident(base)
    end
    until eptr > 0:
        bc = bc + "*"
        eptr -= 1
    end
    mut b := co.SbNew()
    co.SbPuts(b, bc)
    mut zero := false
    repeat dims.len() with di:
        d := dims.get(di)
        if d == 0:
            zero = true
        end
        co.SbPuts(b, "[" + d + "]")
    end
    r := co.SbCstr(b)
    co.SbFree(b)
    if zero:
        ret ""
    end
    ret r
end

// The C name of a module-level global. Functions and types have carried their
// package since the beginning; globals went out under their bare Salam name,
// so two modules that each declared `const COLS` produced two `COLS` objects
// in one flat C namespace and the link failed with "multiple definition" -
// even when neither was `pub`, and even for std's own `excel.FormatUnknown`
// against `image.FormatUnknown`, which is why no program could import both.
//
// `pkg` is the package the global was declared in, not necessarily the module
// being emitted: a generic body instantiated in another module still reads
// its home package's globals, and must name them the same way that package
// defined them.
func cg_global_cname(pkg: str, name: str): str:
    ret "_Salam_g_" + cg_cident(str.Len(pkg) > 0 ? pkg : "main") + "_" + cg_cident(name)
end

func cg_decl(ts: str, name: str): str:
    ret cg_decl_cn(ts, cg_cident(name))
end

// cg_decl over a name that is already a C identifier. A module-level global is
// spelled with its package baked in (cg_global_cname), and that spelling must
// not go through cg_cident a second time - the encoder doubles interior
// underscores, so the definition and the extern would disagree.
func cg_decl_cn(ts: str, name: str): str:
    if cg_is_slice_ts(ts):
        ret "salam_slice " + name
    end
    if str.StartsWith(ts, "Variant<"):
        ret cg_variant_cname(ts) + " " + name
    end
    if str.StartsWith(ts, "dyn "):
        suf := pbrk_arr_star(ts, 4)
        mut il := (suf >= 0 ? suf : str.Len(ts)) - 4
        if il >= 96:
            il = 95
        end
        iface := str.Substr(ts, 4, il)
        mut star := ""
        mut dstr := ""
        if suf >= 0 && byte_at(ts, suf) == 42:
            star = "*"
        end
        if suf >= 0 && byte_at(ts, suf) == 91:
            dstr = str.Substr(ts, suf, str.Len(ts) - suf)
        end
        ret "_Salam_dyn_" + cg_cident(iface) + star + " " + name + dstr
    end
    if str.StartsWith(ts, "func(") || str.StartsWith(ts, "externfunc("):
        ret "void* " + name
    end
    mut base := ""
    mut ptr := false
    mut dims := Vector {} as Vector<int>
    defer dims.free()
    mut eptr := 0
    mut pdepth := 0
    parse_typestr_ex(ts, 96, base, ptr, dims, eptr, pdepth)
    mut found := false
    mut bc := base_ctype(base, found)
    if !found:
        bc = cg_cident(base)
    end
    until eptr > 0:
        bc = bc + "*"
        eptr -= 1
    end
    cname := name
    if dims.len() > 0:
        mut b := co.SbNew()
        co.SbPuts(b, bc)
        co.SbPutc(b, 32)
        co.SbPuts(b, cname)
        repeat dims.len() with i:
            co.SbPuts(b, "[" + dims.get(i) + "]")
        end
        r := co.SbCstr(b)
        co.SbFree(b)
        ret r
    end
    until pdepth > 0:
        bc = bc + "*"
        pdepth -= 1
    end
    ret bc + " " + cname
end

// type_code - encoded type_to_string (spaces kept, unlike vec_code_str).
func type_code(s &: sm.Sema, t: int): str:
    ts := sm.ToString(s, t)
    mut b := co.SbNew()
    cg_encode_typestr(b, ts, false)
    r := co.SbCstr(b)
    co.SbFree(b)
    ret r
end

// cg_mangle_in - params are sm TypeIds. "" = the C NULL for pkg/sname.
func cg_mangle_in(
    s &: sm.Sema, pkg: str, sname: str, fname: str, params: Vector<int>
): str:
    if str.Len(sname) == 0:
        override := cg_export_override(pkg, fname)
        if str.Len(override) > 0:
            ret override
        end
    end
    mut b := co.SbNew()
    co.SbPuts(b, "_Salam_")
    co.SbPuts(b, cg_cident(str.Len(pkg) > 0 ? pkg : "main"))
    if str.Len(sname) > 0:
        co.SbPuts(b, "_S_")
        co.SbPuts(b, cg_cident(sname))
    end
    co.SbPutc(b, 95)
    co.SbPuts(b, cg_cident(fname))
    repeat params.len() with i:
        co.SbPutc(b, 95)
        co.SbPuts(b, type_code(s, params.get(i)))
    end
    r := co.SbCstr(b)
    co.SbFree(b)
    ret r
end

func cg_mangle(
    g &: Cg, s &: sm.Sema, sname: str, fname: str, params: Vector<int>
): str:
    ret cg_mangle_in(s, g.pkg, sname, fname, params)
end

// cg_mangle_method - owner is a SymId (0 = C NULL), sname "" = C NULL.
func cg_mangle_method(
    g &: Cg, s &: sm.Sema, sname: str, owner: int, fname: str, params: Vector<int>
): str:
    osym := sm.SymAt(s, owner)
    inst := (owner != 0 && str.Len(osym.generic_base) > 0) || (owner == 0 && str.Len(sname) > 0)
    if inst:
        sn := str.Len(sname) > 0 ? sname : (owner != 0 ? osym.name : "")
        ret cg_mangle_in(s, "g", sn, fname, params)
    end
    sn2 := owner != 0 ? osym.name : sname
    pkg := (owner != 0 && str.Len(osym.pkgname) > 0) ? osym.pkgname : g.pkg
    ret cg_mangle_in(s, pkg, sn2, fname, params)
end

func cg_mangle_ti(
    s &: sm.Sema, typestr: str, fname: str, params: Vector<int>
): str:
    ret cg_mangle_in(s, "ti", typestr, fname, params)
end

func func_ret_of(ts: str): str:
    if !str.StartsWith(ts, "func("):
        ret "void"
    end
    n := str.Len(ts)
    mut p := 4
    mut d := 0
    until p < n:
        c := byte_at(ts, p)
        if c == 40:
            d += 1
        else c == 41:
            d -= 1
            if d == 0:
                p += 1
                break
            end
        end
        p += 1
    end
    until p < n && byte_at(ts, p) == 32:
        p += 1
    end
    if p < n:
        ret str.Substr(ts, p, n - p)
    end
    ret "void"
end

// 'externfunc(...)' counterpart of func_ret_of (raw C function pointers).
func raw_ret_of(ts: str): str:
    if !str.StartsWith(ts, "externfunc("):
        ret "void"
    end
    n := str.Len(ts)
    mut p := 10
    mut d := 0
    until p < n:
        c := byte_at(ts, p)
        if c == 40:
            d += 1
        else c == 41:
            d -= 1
            if d == 0:
                p += 1
                break
            end
        end
        p += 1
    end
    until p < n && byte_at(ts, p) == 32:
        p += 1
    end
    if p < n:
        ret str.Substr(ts, p, n - p)
    end
    ret "void"
end

// Shared body of raw_cast_params / func_cast_params (identical scans in C).
func cast_params_from(ts: str, s0: int): str:
    mut b := co.SbNew()
    co.SbPutc(b, 40)
    n := str.Len(ts)
    mut depth := 0
    mut start := s0
    mut any := false
    mut p := s0
    until true:
        c := p < n ? byte_at(ts, p) : 0
        if c == 60 || c == 40:
            depth += 1
        else c == 62:
            depth -= 1
        else c == 41 && depth > 0:
            depth -= 1
        end
        if (c == 44 && depth == 0) || (c == 41 && depth == 0) || c == 0:
            mut ss := start
            mut l := p - start
            until l > 0 && byte_at(ts, ss) == 32:
                ss += 1
                l -= 1
            end
            until l > 0 && byte_at(ts, ss + l - 1) == 32:
                l -= 1
            end
            if l > 0:
                if l >= 128:
                    l = 127
                end
                if any:
                    co.SbPuts(b, ", ")
                end
                co.SbPuts(b, cg_ctype(str.Substr(ts, ss, l)))
                any = true
            end
            if c == 41 || c == 0:
                break
            end
            start = p + 1
        end
        p += 1
    end
    if !any:
        co.SbPuts(b, "void")
    end
    co.SbPutc(b, 41)
    r := co.SbCstr(b)
    co.SbFree(b)
    ret r
end

func raw_cast_params(ts: str): str:
    if !str.StartsWith(ts, "externfunc("):
        ret "(void)"
    end
    ret cast_params_from(ts, 11)
end

func func_cast_params(ts: str): str:
    if !str.StartsWith(ts, "func("):
        ret "(void)"
    end
    ret cast_params_from(ts, 5)
end

func func_cast_params_env(ts: str): str:
    base := func_cast_params(ts)
    if str.Equals(base, "(void)"):
        ret "(void*)"
    end
    ret "(void*, " + str.Substr(base, 1, str.Len(base) - 1)
end

// type_is_byval_agg - t is a sm TypeId (sm.TYPE_NONE = C NULL).
func type_is_byval_agg(s &: sm.Sema, t: int): bool:
    if t == sm.TYPE_NONE:
        ret false
    end
    k := sm.TypeAt(s, t).kind
    ret k == sm.TY_STRUCT || k == sm.TY_VEC || k == sm.TY_DYN || k == sm.TY_SLICE || k == sm.TY_VARIANT
end

func array_size_of(ts: str): i64:
    if str.Len(ts) == 0:
        ret 0 as i64
    end
    lb := str.IndexOf(ts, "[")
    if lb < 0:
        ret 0 as i64
    end
    mut n := 0 as i64
    mut p := lb + 1
    tslen := str.Len(ts)
    until p < tslen:
        c := byte_at(ts, p)
        if c == 93:
            break
        end
        if c >= 48 && c <= 57:
            n = n * (10 as i64) + ((c - 48) as i64)
        end
        p += 1
    end
    ret n
end

func print_tag(ts: str): int:
    if str.Len(ts) == 0:
        ret 7
    end
    if str.Equals(ts, "str"):
        ret 7
    end
    if str.Equals(ts, "uchar"):
        ret 7
    end
    if str.Equals(ts, "bool"):
        ret 5
    end
    if str.Equals(ts, "char"):
        ret 6
    end
    if str.Equals(ts, "f32") || str.Equals(ts, "f64"):
        ret 4
    end
    if str.Equals(ts, "i64"):
        ret 1
    end
    if str.Equals(ts, "u32"):
        ret 2
    end
    if str.Equals(ts, "u64"):
        ret 3
    end
    if str.Equals(ts, "size"):
        ret 3
    end
    ret 0
end

func prim_suffix(tag: int): str:
    if tag == 1:
        ret "i64"
    end
    if tag == 2:
        ret "u32"
    end
    if tag == 3:
        ret "u64"
    end
    if tag == 4:
        ret "f64"
    end
    if tag == 5:
        ret "bool"
    end
    if tag == 6:
        ret "char"
    end
    ret "i32"
end
