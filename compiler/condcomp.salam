package condcomp

import tok "token.salam"

import lg "logger.salam"

import at "ast.salam"

import str

pub const CC_BOOL := 0

pub const CC_STR := 1

const K_CC_NUM_BOOL_FLAGS := 25

k_cc_all_bool_flags := [
    "SALAM_OS_WINDOWS", "SALAM_OS_WIN64", "SALAM_OS_WIN32", "SALAM_OS_WASM", "SALAM_OS_ANDROID", "SALAM_OS_LINUX", "SALAM_OS_MAC", "SALAM_OS_BSD", "SALAM_OS_FREEBSD", "SALAM_OS_OPENBSD", "SALAM_OS_NETBSD", "SALAM_OS_UNIX", "SALAM_ARCH_X64", "SALAM_ARCH_X86", "SALAM_ARCH_ARM64", "SALAM_ARCH_ARM", "SALAM_ARCH_WASM", "SALAM_MEM_DEBUG", "SALAM_ASAN", "SALAM_SAFE", "SALAM_OS_BSOS", "SALAM_OS_UEFI", "SALAM_FREESTANDING", "SALAM_KERNEL", "SALAM_OS_SALAMOS"
]

struct Bres:
    pub ok: bool = false
    pub bval: bool = false
end

struct Scalar:
    pub ok: bool = false
    pub is_str: bool = false
    pub bval: bool = false
    pub sval: str = ""
end

pub struct Entry:
    pub name: str = ""
    pub kind: int = 0
    pub bval: bool = false
    pub sval: str = ""
end

pub struct Table:
    pub entries: Vector<Entry> = Vector {}
end

func cc_push_bool(t &: Table, name: str, val: bool):
    t.entries.push(Entry { name = name, kind = CC_BOOL, bval = val, sval = "" })
end

func cc_push_str(t &: Table, name: str, val: str):
    t.entries.push(Entry { name = name, kind = CC_STR, bval = false, sval = val })
end

func cc_push_host_defs(t &: Table):
    if SALAM_OS_WINDOWS:
        cc_push_bool(t, "SALAM_OS_WINDOWS", true)
        cc_push_str(t, "SALAM_OS", "windows")
        if SALAM_OS_WIN64:
            cc_push_bool(t, "SALAM_OS_WIN64", true)
        else:
            cc_push_bool(t, "SALAM_OS_WIN32", true)
        end
    else SALAM_OS_WASM:
        cc_push_bool(t, "SALAM_OS_WASM", true)
        cc_push_bool(t, "SALAM_OS_UNIX", true)
        cc_push_str(t, "SALAM_OS", "wasm")
    else SALAM_OS_ANDROID:
        cc_push_bool(t, "SALAM_OS_ANDROID", true)
        cc_push_bool(t, "SALAM_OS_LINUX", true)
        cc_push_bool(t, "SALAM_OS_UNIX", true)
        cc_push_str(t, "SALAM_OS", "android")
    else SALAM_OS_LINUX:
        cc_push_bool(t, "SALAM_OS_LINUX", true)
        cc_push_bool(t, "SALAM_OS_UNIX", true)
        cc_push_str(t, "SALAM_OS", "linux")
    else SALAM_OS_MAC:
        cc_push_bool(t, "SALAM_OS_MAC", true)
        cc_push_bool(t, "SALAM_OS_BSD", true)
        cc_push_bool(t, "SALAM_OS_UNIX", true)
        cc_push_str(t, "SALAM_OS", "mac")
    else SALAM_OS_FREEBSD:
        cc_push_bool(t, "SALAM_OS_FREEBSD", true)
        cc_push_bool(t, "SALAM_OS_BSD", true)
        cc_push_bool(t, "SALAM_OS_UNIX", true)
        cc_push_str(t, "SALAM_OS", "freebsd")
    else SALAM_OS_OPENBSD:
        cc_push_bool(t, "SALAM_OS_OPENBSD", true)
        cc_push_bool(t, "SALAM_OS_BSD", true)
        cc_push_bool(t, "SALAM_OS_UNIX", true)
        cc_push_str(t, "SALAM_OS", "openbsd")
    else SALAM_OS_NETBSD:
        cc_push_bool(t, "SALAM_OS_NETBSD", true)
        cc_push_bool(t, "SALAM_OS_BSD", true)
        cc_push_bool(t, "SALAM_OS_UNIX", true)
        cc_push_str(t, "SALAM_OS", "netbsd")
    else:
        cc_push_str(t, "SALAM_OS", "unknown")
    end

    if SALAM_ARCH_X64:
        cc_push_bool(t, "SALAM_ARCH_X64", true)
        cc_push_str(t, "SALAM_ARCH", "x64")
    else SALAM_ARCH_X86:
        cc_push_bool(t, "SALAM_ARCH_X86", true)
        cc_push_str(t, "SALAM_ARCH", "x86")
    else SALAM_ARCH_ARM64:
        cc_push_bool(t, "SALAM_ARCH_ARM64", true)
        cc_push_str(t, "SALAM_ARCH", "arm64")
    else SALAM_ARCH_ARM:
        cc_push_bool(t, "SALAM_ARCH_ARM", true)
        cc_push_str(t, "SALAM_ARCH", "arm")
    else SALAM_ARCH_WASM:
        cc_push_bool(t, "SALAM_ARCH_WASM", true)
        cc_push_str(t, "SALAM_ARCH", "wasm")
    end
end

func trip_has(hay: str, needle: str): bool:
    ret str.Contains(hay, needle)
end

func cc_push_target_defs(t &: Table, trip: str):
    mut bits64 := false
    if trip_has(trip, "x86_64") || trip_has(trip, "amd64"):
        bits64 = true
        cc_push_bool(t, "SALAM_ARCH_X64", true)
        cc_push_str(t, "SALAM_ARCH", "x64")
    else trip_has(trip, "aarch64") || trip_has(trip, "arm64"):
        bits64 = true
        cc_push_bool(t, "SALAM_ARCH_ARM64", true)
        cc_push_str(t, "SALAM_ARCH", "arm64")
    else trip_has(trip, "i386") || trip_has(trip, "i486") || trip_has(trip, "i586") || trip_has(trip, "i686") || trip_has(trip, "x86"):
        cc_push_bool(t, "SALAM_ARCH_X86", true)
        cc_push_str(t, "SALAM_ARCH", "x86")
    else trip_has(trip, "wasm64"):
        bits64 = true
        cc_push_bool(t, "SALAM_ARCH_WASM", true)
        cc_push_str(t, "SALAM_ARCH", "wasm")
    else trip_has(trip, "wasm") || trip_has(trip, "wasm32"):
        cc_push_bool(t, "SALAM_ARCH_WASM", true)
        cc_push_str(t, "SALAM_ARCH", "wasm")
    else trip_has(trip, "arm"):
        cc_push_bool(t, "SALAM_ARCH_ARM", true)
        cc_push_str(t, "SALAM_ARCH", "arm")
    end

    if trip_has(trip, "bsos"):
        cc_push_bool(t, "SALAM_OS_BSOS", true)
        cc_push_str(t, "SALAM_OS", "bsos")
        cc_push_bool(t, "SALAM_FREESTANDING", true)
        if trip_has(trip, "kernel"):
            cc_push_bool(t, "SALAM_KERNEL", true)
        end
    else trip_has(trip, "salamos"):
        cc_push_bool(t, "SALAM_OS_SALAMOS", true)
        cc_push_str(t, "SALAM_OS", "salamos")
        cc_push_bool(t, "SALAM_FREESTANDING", true)
        if trip_has(trip, "kernel"):
            cc_push_bool(t, "SALAM_KERNEL", true)
        end
    else trip_has(trip, "uefi"):
        cc_push_bool(t, "SALAM_OS_UEFI", true)
        cc_push_bool(t, "SALAM_FREESTANDING", true)
        cc_push_str(t, "SALAM_OS", "uefi")
    else trip_has(trip, "windows") || trip_has(trip, "mingw") || trip_has(trip, "win32"):
        cc_push_bool(t, "SALAM_OS_WINDOWS", true)
        cc_push_str(t, "SALAM_OS", "windows")
        cc_push_bool(t, bits64 ? "SALAM_OS_WIN64" : "SALAM_OS_WIN32", true)
    else trip_has(trip, "darwin") || trip_has(trip, "macos") || trip_has(trip, "macosx") || trip_has(trip, "apple") || trip_has(trip, "ios"):
        cc_push_bool(t, "SALAM_OS_MAC", true)
        cc_push_bool(t, "SALAM_OS_BSD", true)
        cc_push_bool(t, "SALAM_OS_UNIX", true)
        cc_push_str(t, "SALAM_OS", "mac")
    else trip_has(trip, "android"):
        cc_push_bool(t, "SALAM_OS_ANDROID", true)
        cc_push_bool(t, "SALAM_OS_LINUX", true)
        cc_push_bool(t, "SALAM_OS_UNIX", true)
        cc_push_str(t, "SALAM_OS", "android")
    else trip_has(trip, "linux"):
        cc_push_bool(t, "SALAM_OS_LINUX", true)
        cc_push_bool(t, "SALAM_OS_UNIX", true)
        cc_push_str(t, "SALAM_OS", "linux")
    else trip_has(trip, "freebsd"):
        cc_push_bool(t, "SALAM_OS_FREEBSD", true)
        cc_push_bool(t, "SALAM_OS_BSD", true)
        cc_push_bool(t, "SALAM_OS_UNIX", true)
        cc_push_str(t, "SALAM_OS", "freebsd")
    else trip_has(trip, "openbsd"):
        cc_push_bool(t, "SALAM_OS_OPENBSD", true)
        cc_push_bool(t, "SALAM_OS_BSD", true)
        cc_push_bool(t, "SALAM_OS_UNIX", true)
        cc_push_str(t, "SALAM_OS", "openbsd")
    else trip_has(trip, "netbsd"):
        cc_push_bool(t, "SALAM_OS_NETBSD", true)
        cc_push_bool(t, "SALAM_OS_BSD", true)
        cc_push_bool(t, "SALAM_OS_UNIX", true)
        cc_push_str(t, "SALAM_OS", "netbsd")
    else trip_has(trip, "wasi") || trip_has(trip, "emscripten") || trip_has(trip, "wasm"):
        cc_push_bool(t, "SALAM_OS_WASM", true)
        cc_push_bool(t, "SALAM_OS_UNIX", true)
        cc_push_str(t, "SALAM_OS", "wasm")
    else:
        cc_push_str(t, "SALAM_OS", "unknown")
    end
end

func cc_push_missing_bool_defaults(t &: Table):
    repeat K_CC_NUM_BOOL_FLAGS with i:
        if Lookup(t, k_cc_all_bool_flags[i]) < 0:
            cc_push_bool(t, k_cc_all_bool_flags[i], false)
        end
    end
end

func cc_push_define(t &: Table, def: str):
    eq := str.IndexOf(def, "=")
    if eq < 0:
        cc_push_bool(t, def, true)
        ret
    end
    cc_push_str(
        t, str.Substr(def, 0, eq), str.Substr(def, eq + 1, str.Len(def) - eq - 1)
    )
end

func cc_fold_defined_call(a: at.Ast, t: Table, id: int): Bres:
    n := at.Get(a, id)
    if n.a == 0:
        ret Bres {}
    end
    callee := at.Get(a, n.a)
    if callee.kind != at.AST_IDENTIFIER || str.Len(callee.name) == 0 || !str.Equals(callee.name, "defined"):
        ret Bres {}
    end
    if n.list.len() != 1:
        ret Bres {}
    end
    argid := n.list.get(0)
    if argid == 0:
        ret Bres {}
    end
    arg := at.Get(a, argid)
    if arg.kind != at.AST_IDENTIFIER || str.Len(arg.name) == 0:
        ret Bres {}
    end
    ret Bres { ok = true, bval = Lookup(t, arg.name) >= 0 }
end

func cc_fold_scalar(a: at.Ast, t: Table, id: int, lenient: bool): Scalar:
    if id == 0:
        ret Scalar {}
    end
    n := at.Get(a, id)
    if n.kind == at.AST_LITERAL:
        if n.value_kind == tok.TV_BOOL:
            ret Scalar { ok = true, is_str = false, bval = n.value_bool, sval = "" }
        end
        if n.value_kind == tok.TV_STRING:
            ret Scalar { ok = true, is_str = true, bval = false, sval = n.value_str }
        end
        ret Scalar {}
    end
    if n.kind == at.AST_IDENTIFIER:
        ci := Lookup(t, n.name)
        if ci < 0:
            if lenient:
                ret Scalar { ok = true, is_str = false, bval = false, sval = "" }
            end
            ret Scalar {}
        end
        e := t.entries.get(ci)
        if e.kind == CC_BOOL:
            ret Scalar { ok = true, is_str = false, bval = e.bval, sval = "" }
        end
        ret Scalar { ok = true, is_str = true, bval = false, sval = e.sval }
    end
    if (n.kind == at.AST_UNARY && n.op == tok.TK_NOT) || (
        n.kind == at.AST_BINARY && (
            n.op == tok.TK_AND || n.op == tok.TK_OR || n.op == tok.TK_EQ || n.op == tok.TK_NE
        )
    ) || n.kind == at.AST_CALL:
        r := cc_fold_bool(a, t, id, lenient)
        if !r.ok:
            ret Scalar {}
        end
        ret Scalar { ok = true, is_str = false, bval = r.bval, sval = "" }
    end
    ret Scalar {}
end

func cc_fold_bool(a: at.Ast, t: Table, id: int, lenient: bool): Bres:
    if id == 0:
        ret Bres {}
    end
    n := at.Get(a, id)
    if n.kind == at.AST_UNARY && n.op == tok.TK_NOT:
        r := cc_fold_bool(a, t, n.a, lenient)
        if !r.ok:
            ret Bres {}
        end
        ret Bres { ok = true, bval = !r.bval }
    end
    if n.kind == at.AST_BINARY && (n.op == tok.TK_AND || n.op == tok.TK_OR):
        l := cc_fold_bool(a, t, n.a, lenient)
        if l.ok:
            if n.op == tok.TK_AND && !l.bval:
                ret Bres { ok = true, bval = false }
            end
            if n.op == tok.TK_OR && l.bval:
                ret Bres { ok = true, bval = true }
            end
        end
        if !l.ok:
            ret Bres {}
        end
        r := cc_fold_bool(a, t, n.b, lenient)
        if !r.ok:
            ret Bres {}
        end
        v := n.op == tok.TK_AND ? (l.bval && r.bval) : (l.bval || r.bval)
        ret Bres { ok = true, bval = v }
    end
    if n.kind == at.AST_BINARY && (n.op == tok.TK_EQ || n.op == tok.TK_NE):
        l := cc_fold_scalar(a, t, n.a, lenient)
        r := cc_fold_scalar(a, t, n.b, lenient)
        if !l.ok || !r.ok || l.is_str != r.is_str:
            ret Bres {}
        end
        eq := l.is_str ? str.Equals(l.sval, r.sval) : l.bval == r.bval
        ret Bres { ok = true, bval = n.op == tok.TK_EQ ? eq : !eq }
    end
    if n.kind == at.AST_CALL:
        ret cc_fold_defined_call(a, t, id)
    end
    s := cc_fold_scalar(a, t, id, lenient)
    if !s.ok || s.is_str:
        ret Bres {}
    end
    ret Bres { ok = true, bval = s.bval }
end

func cc_cond_has_ref(a: at.Ast, id: int): bool:
    if id == 0:
        ret false
    end
    n := at.Get(a, id)
    if n.kind == at.AST_IDENTIFIER || n.kind == at.AST_CALL:
        ret true
    end
    if n.kind == at.AST_UNARY && n.op == tok.TK_NOT:
        ret cc_cond_has_ref(a, n.a)
    end
    if n.kind == at.AST_BINARY && (
        n.op == tok.TK_AND || n.op == tok.TK_OR || n.op == tok.TK_EQ || n.op == tok.TK_NE
    ):
        ret cc_cond_has_ref(a, n.a) || cc_cond_has_ref(a, n.b)
    end
    ret false
end

func cc_lvalue_root(a &: at.Ast, id: int): int:
    mut cur := id
    until cur != 0:
        k := at.KindOf(a, cur)
        if k == at.AST_IDENTIFIER:
            ret cur
        end
        if k != at.AST_MEMBER && k != at.AST_INDEX && k != at.AST_SLICE:
            ret 0
        end
        cur = at.Get(a, cur).a
    end
    ret 0
end

func cc_note_write(a &: at.Ast, file: str, target: int):
    r := cc_lvalue_root(a, target)
    if r != 0:
        at.NotePruned(a, file, at.Get(a, r).name, true)
    end
end

func cc_note_pruned(a &: at.Ast, file: str, id: int):
    if id == 0:
        ret
    end
    n := at.Get(a, id)
    at.NotePruned(a, file, n.name, false)
    if n.kind == at.AST_ASSIGN || n.kind == at.AST_INCDEC:
        cc_note_write(a, file, n.a)
    end
    if n.kind == at.AST_CALL:
        if at.KindOf(a, n.a) == at.AST_MEMBER:
            cc_note_write(a, file, at.Get(a, n.a).a)
        end
        repeat at.ChildCount(a, id) with ai:
            arg := at.Child(a, id, ai)
            if arg != 0 && at.KindOf(a, arg) == at.AST_IDENTIFIER:
                at.NotePruned(a, file, at.Get(a, arg).name, true)
            end
        end
    end
    cc_note_pruned(a, file, n.ty)
    cc_note_pruned(a, file, n.a)
    cc_note_pruned(a, file, n.b)
    cc_note_pruned(a, file, n.c)
    cc_note_pruned(a, file, n.d)
    repeat at.ChildCount(a, id) with i0:
        cc_note_pruned(a, file, at.Child(a, id, i0))
    end
    repeat at.DimCount(a, id) with i1:
        cc_note_pruned(a, file, at.Dim(a, id, i1))
    end
    repeat at.CaptureCount(a, id) with i2:
        cc_note_pruned(a, file, at.Capture(a, id, i2))
    end
end

func cc_resolve_if(
    a &: at.Ast, log: lg.Logger, file: str, t: Table, id: int, top_level: bool, ok &: bool
): int:
    n := at.Get(a, id)
    mut r := Bres {}
    if top_level || cc_cond_has_ref(a, n.a):
        r = cc_fold_bool(a, t, n.a, top_level)
    end
    if r.ok:
        taken := r.bval ? n.b : n.c
        cc_note_pruned(a, file, r.bval ? n.c : n.b)
        if taken == 0:
            ret 0
        end
        if at.KindOf(a, taken) == at.AST_IF:
            ret cc_resolve_if(a, log, file, t, taken, top_level, ok)
        end
        cc_process_list(a, log, file, t, taken, top_level, ok)
        ret taken
    end
    if top_level:
        cond := at.Get(a, n.a)
        lg.LogAt(
            log, lg.PH_PARSER, lg.LOG_ERROR, file, cond.begin_line as int, cond.begin_col as int, "top-level if condition must be a compile-time constant"
        )
        ok = false
        ret 0
    end
    cc_process_list(a, log, file, t, n.b, false, ok)
    if n.c != 0:
        if at.KindOf(a, n.c) == at.AST_IF:
            newc := cc_resolve_if(a, log, file, t, n.c, false, ok)
            mut n2 := at.Get(a, id)
            n2.c = newc
            at.Put(a, id, n2)
        else:
            cc_process_list(a, log, file, t, n.c, false, ok)
        end
    end
    ret id
end

func cc_resolve_slot(
    a &: at.Ast, log: lg.Logger, file: str, t: Table, id: int, ok &: bool
): int:
    if id == 0:
        ret 0
    end
    k := at.KindOf(a, id)
    if k == at.AST_IF:
        ret cc_resolve_if(a, log, file, t, id, false, ok)
    end
    if k == at.AST_BLOCK || k == at.AST_PROGRAM:
        cc_process_list(a, log, file, t, id, false, ok)
        ret id
    end
    n := at.Get(a, id)
    nty := cc_resolve_slot(a, log, file, t, n.ty, ok)
    na := cc_resolve_slot(a, log, file, t, n.a, ok)
    nb := cc_resolve_slot(a, log, file, t, n.b, ok)
    nc := cc_resolve_slot(a, log, file, t, n.c, ok)
    new_d := cc_resolve_slot(a, log, file, t, n.d, ok)
    mut n2 := at.Get(a, id)
    n2.ty = nty
    n2.a = na
    n2.b = nb
    n2.c = nc
    n2.d = new_d
    at.Put(a, id, n2)
    repeat at.ChildCount(a, id) with i0:
        cid := at.Child(a, id, i0)
        nid := cc_resolve_slot(a, log, file, t, cid, ok)
        if nid != cid:
            mut n3 := at.Get(a, id)
            n3.list.set(i0, nid)
            at.Put(a, id, n3)
        end
    end
    repeat at.DimCount(a, id) with i1:
        did := at.Dim(a, id, i1)
        ndid := cc_resolve_slot(a, log, file, t, did, ok)
        if ndid != did:
            mut n4 := at.Get(a, id)
            n4.dims.set(i1, ndid)
            at.Put(a, id, n4)
        end
    end
    repeat at.CaptureCount(a, id) with i2:
        capid := at.Capture(a, id, i2)
        ncap := cc_resolve_slot(a, log, file, t, capid, ok)
        if ncap != capid:
            mut n5 := at.Get(a, id)
            n5.captures.set(i2, ncap)
            at.Put(a, id, n5)
        end
    end
    ret id
end

func cc_process_list(
    a &: at.Ast, log: lg.Logger, file: str, t: Table, owner: int, top_level: bool, ok &: bool
):
    mut orig := Vector {} as Vector<int>
    defer orig.free()
    n0 := at.Get(a, owner)
    repeat n0.list.len() with i0:
        orig.push(n0.list.get(i0))
    end
    mut out := Vector {} as Vector<int>
    repeat orig.len() with i1:
        it := orig.get(i1)
        if it != 0 && at.KindOf(a, it) == at.AST_IF:
            resolved := cc_resolve_if(a, log, file, t, it, top_level, ok)
            if resolved != 0:
                if at.KindOf(a, resolved) == at.AST_BLOCK:
                    rn := at.Get(a, resolved)
                    repeat rn.list.len() with j:
                        out.push(rn.list.get(j))
                    end
                else:
                    out.push(resolved)
                end
            end
        else:
            out.push(cc_resolve_slot(a, log, file, t, it, ok))
        end
    end
    mut n1 := at.Get(a, owner)
    n1.list.free()
    n1.list = out
    at.Put(a, owner, n1)
end

pub func TableBuild(target_triple: str, defines: Vector<str>): Table:
    mut t := Table {}
    if str.Len(target_triple) != 0:
        cc_push_target_defs(t, target_triple)
    else:
        cc_push_host_defs(t)
    end
    repeat defines.len() with i:
        cc_push_define(t, defines.get(i))
    end
    cc_push_missing_bool_defaults(t)
    ret t
end

pub func TableFree(t &: Table):
    t.entries.free()
end

pub func Lookup(t: Table, name: str): int:
    repeat t.entries.len() with i:
        e := t.entries.get(i)
        if str.Equals(e.name, name):
            ret i
        end
    end
    ret 0 - 1
end

pub func EntryCount(t: Table): int:
    ret t.entries.len()
end

pub func EntryName(t: Table, i: int): str:
    e := t.entries.get(i)
    ret e.name
end

pub func EntryKind(t: Table, i: int): int:
    e := t.entries.get(i)
    ret e.kind
end

pub func EntryBool(t: Table, i: int): bool:
    e := t.entries.get(i)
    ret e.bval
end

pub func EntryStr(t: Table, i: int): str:
    e := t.entries.get(i)
    ret e.sval
end

pub func EvalBool(a &: at.Ast, t: Table, expr: int, lenient: bool, bval &: bool): bool:
    r := cc_fold_bool(a, t, expr, lenient)
    if r.ok:
        bval = r.bval
    end
    ret r.ok
end

pub func PruneProgram(
    a &: at.Ast, log: lg.Logger, file: str, t: Table, program: int
): bool:
    mut ok := true
    cc_process_list(a, log, file, t, program, true, ok)
    ret ok
end
