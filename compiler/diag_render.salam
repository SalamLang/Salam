package diagrender

import str
import co "sal_core.salam"
import i18 "i18n.salam"

const RS_RUST := 0
const RS_GCC := 1
const RS_CLANG := 2

const RF_HUMAN := 0
const RF_JSON := 1
const RF_XML := 2

const A_RESET := "\x1b[0m"
const A_BOLD := "\x1b[1m"
const A_RED := "\x1b[1;31m"
const A_YELLOW := "\x1b[1;33m"
const A_CYAN := "\x1b[1;36m"
const A_GREEN := "\x1b[1;32m"
const A_BLUE := "\x1b[34m"
const A_BBLUE := "\x1b[1;34m"

const TAB_WIDTH := 4

const LINE_CAP := 1023

const FA_DIGITS := ["۰", "۱", "۲", "۳", "۴", "۵", "۶", "۷", "۸", "۹"]

pub type DiagStyle = int
pub type DiagFormat = int

func tr(s: str): str:
    ret i18.Tr(s)
end

func ub(bp: i8*, i: int): int:
    mut v := bp[i] as int
    if v < 0:
        v += 256
    end
    ret v
end

func spaces(n: int): str:
    if n <= 0:
        ret ""
    end
    ret " ".repeat(n)
end

func hex2(c: int): str:
    tbl := "0123456789abcdef"
    ret tbl.substr((c / 16) % 16, 1) + tbl.substr(c % 16, 1)
end

func code_str(is_error: bool, code: int): str:
    if str.Equals(i18.Lang(), "fa"):
        mut c := code % 1000
        if c < 0:
            c += 1000
        end
        word := tr(is_error ? "error" : "warning")
        ret word + FA_DIGITS[(c / 100) % 10] + FA_DIGITS[(c / 10) % 10] + FA_DIGITS[c % 10]
    end
    ret co.Format2("%c%03d", co.ArgChar(is_error ? 69 : 87), co.ArgInt(code as i64))
end

func level_color(level: str): str:
    if str.Equals(level, "error"):
        ret A_RED
    end
    if str.Equals(level, "warning"):
        ret A_YELLOW
    end
    if str.Equals(level, "note"):
        ret A_CYAN
    end
    if str.Equals(level, "help"):
        ret A_GREEN
    end
    ret A_BOLD
end

func get_src_line(text: str, text_len: int, lineno: int): str:
    bp := (text as void*) as i8*
    mut n := text_len
    if n > str.Len(text):
        n = str.Len(text)
    end
    mut p := 0
    mut cur := 1
    until cur < lineno && p < n:
        if bp[p] == (10 as i8):
            cur += 1
        end
        p += 1
    end
    if p >= n || cur != lineno:
        ret ""
    end
    start := p
    until p < n && bp[p] != (10 as i8) && bp[p] != (13 as i8):
        p += 1
    end
    mut ll := p - start
    if ll > LINE_CAP:
        ll = LINE_CAP
    end
    ret text.substr(start, ll)
end

func visual_col(line_buf: str, byte_off: int): int:
    bp := (line_buf as void*) as i8*
    n := str.Len(line_buf)
    mut vis := 0
    mut i := 0
    until i < byte_off:
        if i < n && bp[i] == (9 as i8):
            vis += TAB_WIDTH - (vis % TAB_WIDTH)
        else:
            vis += 1
        end
        i += 1
    end
    ret vis
end

func expand_line(line_buf: str): str:
    bp := (line_buf as void*) as i8*
    n := str.Len(line_buf)
    mut b := str.NewBuilder()
    mut colv := 0
    mut i := 0
    until i < n:
        if bp[i] == (9 as i8):
            spn := TAB_WIDTH - (colv % TAB_WIDTH)
            str.BufAppend(b, spaces(spn))
            colv += spn
        else:
            str.BufAppendChar(b, ub(bp, i))
            colv += 1
        end
        i += 1
    end
    r := str.BufStr(b)
    str.BufFree(b)
    ret r
end

func span_visuals(line_buf: str, col: int, length: int, vis_s &: int, vis_w &: int):
    line_len := str.Len(line_buf)
    mut byte_start := 0
    if col > 0:
        byte_start = col - 1
    end
    if byte_start > line_len:
        byte_start = line_len
    end
    mut span_bytes := 1
    if length > 0:
        span_bytes = length
    end
    mut byte_end := byte_start + span_bytes
    if byte_end > line_len:
        byte_end = line_len
    end
    if byte_end <= byte_start:
        byte_end = byte_start + 1
    end
    vis_s = visual_col(line_buf, byte_start)
    ve := visual_col(line_buf, byte_end)
    vis_w = 1
    if ve > vis_s:
        vis_w = ve - vis_s
    end
end

func gutter_str(lineno: int, num_width: int, color: bool): str:
    mut numpart := ""
    if lineno == 0:
        numpart = spaces(num_width)
    else:
        ns := str.FromInt(lineno as i64)
        pad := num_width - str.Len(ns)
        numpart = spaces(pad) + ns
    end
    if color:
        ret A_BBLUE + numpart + " |" + A_RESET
    end
    ret numpart + " |"
end

func num_width_for(line: int): int:
    mut w := 1
    mut t := line
    until t >= 10:
        t /= 10
        w += 1
    end
    ret w
end

func json_escape(s: str): str:
    bp := (s as void*) as i8*
    n := str.Len(s)
    mut b := str.NewBuilder()
    mut i := 0
    until i < n:
        c := ub(bp, i)
        if c == 34:
            str.BufAppend(b, `\"`)
        else c == 92:
            str.BufAppend(b, `\\`)
        else c == 10:
            str.BufAppend(b, "\\n")
        else c == 13:
            str.BufAppend(b, "\\r")
        else c == 9:
            str.BufAppend(b, "\\t")
        else c < 32:
            str.BufAppend(b, "\\u00" + hex2(c))
        else:
            str.BufAppendChar(b, c)
        end
        i += 1
    end
    r := str.BufStr(b)
    str.BufFree(b)
    ret r
end

func xml_escape(s: str): str:
    bp := (s as void*) as i8*
    n := str.Len(s)
    mut b := str.NewBuilder()
    mut i := 0
    until i < n:
        c := ub(bp, i)
        if c == 38:
            str.BufAppend(b, "&amp;")
        else c == 60:
            str.BufAppend(b, "&lt;")
        else c == 62:
            str.BufAppend(b, "&gt;")
        else c == 34:
            str.BufAppend(b, "&quot;")
        else c == 39:
            str.BufAppend(b, "&apos;")
        else:
            str.BufAppendChar(b, c)
        end
        i += 1
    end
    r := str.BufStr(b)
    str.BufFree(b)
    ret r
end

pub func StyleFromString(s: str, out &: int): bool:
    if str.EqualFold(s, "rust"):
        out = RS_RUST
        ret true
    end
    if str.EqualFold(s, "gcc"):
        out = RS_GCC
        ret true
    end
    if str.EqualFold(s, "clang"):
        out = RS_CLANG
        ret true
    end
    ret false
end

pub func FormatFromString(s: str, out &: int): bool:
    if str.EqualFold(s, "human"):
        out = RF_HUMAN
        ret true
    end
    if str.EqualFold(s, "json"):
        out = RF_JSON
        ret true
    end
    if str.EqualFold(s, "xml"):
        out = RF_XML
        ret true
    end
    ret false
end

pub func Render(
    level: str, code: int, is_error: bool, file: str, span: co.SrcSpan, src_text: str, src_len: int, msg: str, help: str, style: DiagStyle, format: DiagFormat, color: bool
): str:
    ret RenderAt(
        level, code, is_error, file, span.begin.line as int, span.begin.col as int, span.length as int, src_text, src_len, msg, help, style, format, color
    )
end

pub func RenderAt(
    level: str, code: int, is_error: bool, file: str, line: int, col: int, length: int, src_text: str, src_len: int, msg: str, help: str, style: DiagStyle, format: DiagFormat, color: bool
): str:
    mut lvl := level
    if str.Len(lvl) == 0:
        lvl = "error"
    end
    if format == RF_JSON:
        ret RenderJson(lvl, code, is_error, file, line, col, length, msg, help)
    end
    if format == RF_XML:
        ret RenderXml(lvl, code, is_error, file, line, col, length, msg, help)
    end
    if style == RS_GCC:
        ret RenderGcc(
            lvl, code, is_error, file, line, col, length, src_text, src_len, msg, help, color
        )
    end
    if style == RS_CLANG:
        ret RenderClang(
            lvl, code, is_error, file, line, col, length, src_text, src_len, msg, help, color
        )
    end
    ret RenderRust(
        lvl, code, is_error, file, line, col, length, src_text, src_len, msg, help, color
    )
end

pub func RenderJson(
    level: str, code: int, is_error: bool, file: str, line: int, col: int, length: int, body: str, help: str
): str:
    mut out := `{"level":"` + json_escape(level) + `"`
    if code > 0:
        out = out + `,"code":"` + json_escape(code_str(is_error, code)) + `"`
    end
    out = out + `,"message":"` + json_escape(body) + `"`
    if str.Len(file) > 0:
        out = out + `,"file":"` + json_escape(file) + `"`
    end
    if line > 0:
        out = out + `,"line":` + line + `,"column":` + col
        if length > 0:
            out = out + `,"length":` + length
        end
    end
    if str.Len(help) > 0:
        out = out + `,"help":"` + json_escape(help) + `"`
    end
    ret out + "}\n"
end

pub func RenderXml(
    level: str, code: int, is_error: bool, file: str, line: int, col: int, length: int, body: str, help: str
): str:
    mut out := `<diagnostic level="` + xml_escape(level) + `"`
    if code > 0:
        out = out + ` code="` + code_str(is_error, code) + `"`
    end
    if str.Len(file) > 0:
        out = out + ` file="` + xml_escape(file) + `"`
    end
    if line > 0:
        out = out + ` line="` + line + `" column="` + col + `"`
        if length > 0:
            out = out + ` length="` + length + `"`
        end
    end
    out = out + "><message>" + xml_escape(body) + "</message>"
    if str.Len(help) > 0:
        out = out + "<help>" + xml_escape(help) + "</help>"
    end
    ret out + "</diagnostic>\n"
end

pub func RenderRust(
    level: str, code: int, is_error: bool, file: str, line: int, col: int, length: int, src_text: str, src_len: int, body: str, help: str, color: bool
): str:
    lc := color ? level_color(level) : ""
    reset := color ? A_RESET : ""
    blue := color ? A_BLUE : ""
    bold := color ? A_BOLD : ""
    green := color ? A_GREEN : ""

    mut out := lc + tr(level)
    if code > 0:
        out = out + "[" + code_str(is_error, code) + "]"
    end
    out = out + reset + ": " + bold + body + reset + "\n"
    if str.Len(file) == 0:
        ret out
    end

    if line <= 0:
        out = out + " " + blue + "-->" + reset + " " + file + "\n"
        if str.Len(help) > 0:
            out = out + "   " + green + "= " + tr("help") + ":" + reset + " " + help + "\n"
        end
        ret out
    end
    out = out + " " + blue + "-->" + reset + " " + file + ":" + line + ":" + col + "\n"

    nw := num_width_for(line)
    has_src := str.Len(src_text) > 0

    out = out + gutter_str(0, nw, color) + "\n"

    mut line_buf := ""
    if has_src:
        line_buf = get_src_line(src_text, src_len, line)
    end
    out = out + gutter_str(line, nw, color) + " "
    if has_src:
        out = out + expand_line(line_buf)
    end
    out = out + "\n"

    out = out + gutter_str(0, nw, color) + " "
    if has_src && col > 0:
        mut vis_s := 0
        mut vis_w := 1
        span_visuals(line_buf, col, length, vis_s, vis_w)
        out = out + lc + spaces(vis_s) + "^".repeat(vis_w) + reset
    end
    out = out + "\n"

    out = out + gutter_str(0, nw, color) + "\n"

    if str.Len(help) > 0:
        out = out + spaces(nw) + " " + green + "= " + tr("help") + ":" + reset + " " + help + "\n"
    end
    ret out
end

pub func RenderGcc(
    level: str, code: int, is_error: bool, file: str, line: int, col: int, length: int, src_text: str, src_len: int, body: str, help: str, color: bool
): str:
    lc := color ? level_color(level) : ""
    reset := color ? A_RESET : ""
    bold := color ? A_BOLD : ""
    cyan := color ? A_CYAN : ""

    mut out := ""
    if str.Len(file) > 0 && line > 0:
        out = out + bold + file + ":" + line + ":" + col + ":" + reset + " "
    else str.Len(file) > 0:
        out = out + bold + file + ":" + reset + " "
    end
    out = out + lc + tr(level) + reset + ": " + body
    if code > 0:
        out = out + " [" + code_str(is_error, code) + "]"
    end
    out = out + "\n"
    if str.Len(src_text) == 0 || line <= 0:
        if str.Len(help) > 0:
            out = out + "  " + cyan + tr("note") + ":" + reset + " " + help + "\n"
        end
        ret out
    end

    line_buf := get_src_line(src_text, src_len, line)
    out = out + "    " + expand_line(line_buf) + "\n"

    if col > 0:
        mut vis_s := 0
        mut vis_w := 1
        span_visuals(line_buf, col, length, vis_s, vis_w)
        out = out + "    " + lc + spaces(vis_s) + "^"
        if vis_w > 1:
            out = out + "~".repeat(vis_w - 1)
        end
        out = out + reset + "\n"
    end
    if str.Len(help) > 0:
        out = out + "  " + cyan + tr("note") + ":" + reset + " " + help + "\n"
    end
    ret out
end

pub func RenderClang(
    level: str, code: int, is_error: bool, file: str, line: int, col: int, length: int, src_text: str, src_len: int, body: str, help: str, color: bool
): str:
    lc := color ? level_color(level) : ""
    reset := color ? A_RESET : ""
    bold := color ? A_BOLD : ""
    cyan := color ? A_CYAN : ""
    green := color ? A_GREEN : ""

    mut out := ""
    if str.Len(file) > 0 && line > 0:
        out = out + bold + file + ":" + line + ":" + col + ":" + reset + " "
    else str.Len(file) > 0:
        out = out + bold + file + ":" + reset + " "
    end
    out = out + lc + tr(level) + reset + ": " + body
    if code > 0:
        out = out + " [" + code_str(is_error, code) + "]"
    end
    out = out + "\n"
    if str.Len(src_text) == 0 || line <= 0:
        if str.Len(help) > 0:
            out = out + "  " + cyan + tr("note") + ":" + reset + " " + help + "\n"
        end
        ret out
    end

    line_buf := get_src_line(src_text, src_len, line)
    out = out + "    " + expand_line(line_buf) + "\n"

    mut vis_s := 0
    mut vis_w := 1
    if col > 0:
        span_visuals(line_buf, col, length, vis_s, vis_w)
    end

    out = out + "    " + lc + spaces(vis_s) + "^"
    if vis_w > 1:
        out = out + "~".repeat(vis_w - 1)
    end
    out = out + reset + "\n"

    out = out + "    " + lc + spaces(vis_s) + "| " + body + reset + "\n"

    if str.Len(help) > 0:
        out = out + "    " + spaces(vis_s) + green + "= " + reset + help + "\n"
    end
    ret out
end
