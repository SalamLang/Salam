package docgen

import str

include tok "../token.salam"

func split_lines(s: str): Vector<str>:
    mut out := Vector {} as Vector<str>
    n := s.Len()
    mut start := 0
    mut i := 0
    until i < n:
        if byte_at(s, i) == 10:
            out.push(str.Substr(s, start, i - start))
            start = i + 1
        end
        i++
    end
    out.push(str.Substr(s, start, n - start))
    ret out
end

func strip_line_comment(raw: str): str:
    n := raw.Len()
    mut i := 0
    until i < n and byte_at(raw, i) == 47:
        i++
    end
    ret str.Trim(str.Substr(raw, i, n - i))
end

func strip_block_comment(raw: str): str:
    n := raw.Len()
    mut start := 0
    if n >= 2 and byte_at(raw, 0) == 47 and byte_at(raw, 1) == 42:
        start = 2
    end
    until start < n and byte_at(raw, start) == 42:
        start++
    end
    mut stop := n
    if stop >= 2 and byte_at(raw, stop - 1) == 47 and byte_at(raw, stop - 2) == 42:
        stop -= 2
    end
    if stop < start:
        stop = start
    end
    body := str.Substr(raw, start, stop - start)
    lines := split_lines(body)
    mut b := str.NewBuilder()
    mut first := true
    repeat lines.Len() in li:
        mut line := str.Trim(lines.get(li))
        if line.Len() > 0 and byte_at(line, 0) == 42:
            line = str.Trim(str.Substr(line, 1, line.Len() - 1))
        end
        if not first:
            str.BufAppendChar(b, 10)
        end
        str.BufAppend(b, line)
        first = false
    end
    r := str.BufStr(b)
    str.BufFree(b)
    ret str.Trim(r)
end

func split_lang_sections(text: str, out &: Vector<str>):
    lines := split_lines(text)
    mut cur_lang := ""
    mut cur := ""
    mut has_any := false
    repeat lines.Len() in i:
        line := lines.get(i)
        trimmed := str.Trim(line)
        mut tag := ""
        mut rest := ""
        mut is_tag := false
        if trimmed.Len() > 1 and byte_at(trimmed, 0) == 64:
            mut j := 1
            until j < trimmed.Len() and is_alpha(byte_at(trimmed, j)):
                j++
            end
            if j > 1:
                tag = str.Substr(trimmed, 1, j - 1)
                rest = str.Trim(str.Substr(trimmed, j, trimmed.Len() - j))
                is_tag = true
            end
        end
        if is_tag:
            if has_any:
                out.push(cur_lang)
                out.push(str.Trim(cur))
            end
            cur_lang = tag
            cur = rest
            has_any = true
        else:
            if has_any or line.Len() > 0:
                if cur.Len() > 0:
                    cur += "\n"
                end
                cur += line
                has_any = true
            end
        end
    end
    if has_any:
        out.push(cur_lang)
        out.push(str.Trim(cur))
    end
end

func finalize_block(blocks &: Vector<CommentBlock>, raw: Vector<str>, end_line: int):
    if raw.Len() == 0:
        ret
    end
    mut joined := ""
    repeat raw.Len() in i:
        if i != 0:
            joined += "\n"
        end
        joined += raw.get(i)
    end
    mut cb := CommentBlock {}
    cb.end_line = end_line
    split_lang_sections(joined, cb.texts)
    blocks.push(cb)
end

func collect_comment_blocks(toks2: tok.TokenStream): Vector<CommentBlock>:
    mut blocks := Vector {} as Vector<CommentBlock>
    n := tok.StreamCount(toks2)
    mut raw := Vector {} as Vector<str>
    mut last_end := 0 - 1000
    mut i := 0
    until i < n:
        t := tok.StreamAt(toks2, i)
        if t.kind == tok.TK_COMMENT_BLOCK:
            finalize_block(blocks, raw, last_end)
            raw.free()
            raw = Vector {} as Vector<str>
            mut single := Vector {} as Vector<str>
            single.push(strip_block_comment(t.lexeme))
            finalize_block(blocks, single, t.end_line as int)
            single.free()
            last_end = 0 - 1000
        else t.kind == tok.TK_COMMENT_LINE:
            this_begin := t.begin_line as int
            if raw.Len() > 0 and this_begin != last_end + 1:
                finalize_block(blocks, raw, last_end)
                raw.free()
                raw = Vector {} as Vector<str>
            end
            raw.push(strip_line_comment(t.lexeme))
            last_end = t.end_line as int
        end
        i++
    end
    finalize_block(blocks, raw, last_end)
    defer raw.free()
    ret blocks
end

func attach_doc(db &: DocDb, blocks: Vector<CommentBlock>, decl_idx: int, begin_line: int):
    n := blocks.Len()
    mut i := 0
    until i < n:
        cb := blocks.get(i)
        if cb.end_line == begin_line - 1:
            mut j := 0
            until j + 1 < cb.texts.Len():
                db_add_doc(db, decl_idx, cb.texts.get(j), cb.texts.get(j + 1))
                j += 2
            end
            ret
        end
        i++
    end
end
