package docgen

import str
import co "../sal_core.salam"

// Escapes a runtime str into a JS/JSON string literal (double-quoted).
// Escapes every '/' too, so embedded doc text can never spell "</script>"
// and break out of the surrounding <script> block.
func js_str(s: str): str:
    mut b := str.NewBuilder()
    str.BufAppendChar(b, 34)
    n := s.len()
    mut i := 0
    until i < n:
        ch := byte_at(s, i)
        if ch == 10:
            str.BufAppend(b, "\\n")
        else ch == 13:
            str.BufAppend(b, "\\r")
        else ch == 9:
            str.BufAppend(b, "\\t")
        else ch == 34:
            str.BufAppend(b, "\\\"")
        else ch == 92:
            str.BufAppend(b, "\\\\")
        else ch == 47:
            str.BufAppend(b, "\\/")
        else:
            if ch < 32:
                str.BufAppend(b, co.Format1("\\u%04x", co.ArgUint(ch as u64)))
            else:
                str.BufAppendChar(b, ch)
            end
        end
        i += 1
    end
    str.BufAppendChar(b, 34)
    r := str.BufStr(b)
    str.BufFree(b)
    ret r
end

func emit_pairs(b &: str.StringBuilder, pairs: Vector<str>):
    str.BufAppendChar(b, 91)
    n := pairs.len()
    mut first := true
    mut i := 0
    until i + 1 < n:
        if !first:
            str.BufAppendChar(b, 44)
        end
        str.BufAppendChar(b, 91)
        str.BufAppend(b, js_str(pairs.get(i)[0]))
        str.BufAppendChar(b, 44)
        str.BufAppend(b, js_str(pairs.get(i + 1)[0]))
        str.BufAppendChar(b, 93)
        first = false
        i += 2
    end
    str.BufAppendChar(b, 93)
end

func emit_ints(b &: str.StringBuilder, xs: Vector<int>):
    str.BufAppendChar(b, 91)
    n := xs.len()
    mut i := 0
    until i < n:
        if i != 0:
            str.BufAppendChar(b, 44)
        end
        str.BufAppend(b, str.FromInt(xs.get(i)[0] as i64))
        i += 1
    end
    str.BufAppendChar(b, 93)
end

func emit_decl(b &: str.StringBuilder, d: DocDecl):
    str.BufAppendChar(b, 123)
    str.BufAppend(b, "\"k\":")
    str.BufAppend(b, js_str(kind_name(d.kind)))
    str.BufAppend(b, ",\"n\":")
    str.BufAppend(b, js_str(d.name))
    str.BufAppend(b, ",\"s\":")
    str.BufAppend(b, js_str(d.sig))
    str.BufAppend(b, ",\"p\":")
    str.BufAppend(b, d.is_pub ? "true" : "false")
    str.BufAppend(b, ",\"dep\":")
    str.BufAppend(b, d.is_deprecated ? "true" : "false")
    str.BufAppend(b, ",\"f\":")
    str.BufAppend(b, str.FromInt(d.file_idx as i64))
    str.BufAppend(b, ",\"l\":")
    str.BufAppend(b, str.FromInt(d.line as i64))
    str.BufAppend(b, ",\"par\":")
    str.BufAppend(b, str.FromInt(d.parent as i64))
    str.BufAppend(b, ",\"a\":")
    emit_pairs(b, d.aliases)
    str.BufAppend(b, ",\"doc\":")
    emit_pairs(b, d.doc)
    str.BufAppend(b, ",\"m\":")
    emit_ints(b, d.members)
    str.BufAppendChar(b, 125)
end

func emit_db_json(b &: str.StringBuilder, db: DocDb):
    str.BufAppend(b, "{\"files\":[")
    fnn := db.files.len()
    mut fi := 0
    until fi < fnn:
        if fi != 0:
            str.BufAppendChar(b, 44)
        end
        str.BufAppend(b, js_str(db.files.get(fi)[0]))
        fi += 1
    end
    str.BufAppend(b, "],\"decls\":[")
    dn := db.decls.len()
    mut di := 0
    until di < dn:
        if di != 0:
            str.BufAppendChar(b, 44)
        end
        emit_decl(b, db.decls.get(di)[0])
        di += 1
    end
    str.BufAppend(b, "]}")
end

