# Build context is now the REPO ROOT (compiler/docker/docker-compose.yml:
# `context: ../..`) since std/ and tests/ live alongside compiler/ post-
# self-host-restructure. This repo is a big monorepo (docs, books, website,
# editor, kids, android, benchmark, registry, runner, node_modules, ...) —
# only compiler/, std/, and tests/ are actually needed inside the image, so
# everything else at the repo root is excluded explicitly.

# ---- Only compiler/, std/, tests/, and a couple of root files are needed ----
/*
!/compiler/
!/std/
!/tests/
!/VERSION
!/README.md

# ---- Within compiler/: exclude scratch/generated, keep source + salam.cfg ----
# (compiler/salam, the tracked bootstrap binary, MUST survive — do not
# exclude it; only stray same-named build outputs elsewhere are excluded.)
compiler/build/
compiler/dist/
compiler/salam.exe
compiler/tests_port/tmp_cg/**/*.o
*.o
*.a
*.obj
*.hash
*.tmp
*.log
compiler/docker/

# ---- Test scratch ----
tests/.work/

# ---- Dependencies & caches ----
**/node_modules/
**/__pycache__/
.mypy_cache/
*.pyc

# ---- Editor / IDE / agent state ----
.vscode/
.idea/
.claude/
.git/
