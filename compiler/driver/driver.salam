k_dr_js_prelude_texts := [
    "function salam_panic(message) {\n    throw new Error(\"Salam panic: \" + String(message));\n}\n", "function __salam_unsupported(what) {\n    throw new Error(\"not supported in the browser build: \" + what);\n}\n", "function salam_input() {\n    return typeof prompt === \"function\" ? String(prompt(\"\") || \"\") : \"\";\n}\n", "function salam_strcat(a, b) {\n    return String(a) + String(b);\n}\n", "function salam_str_hash(s) {\n    let h = 2166136261 >>> 0;\n    for (let i = 0; i < s.length; i++) {\n        h = Math.imul(h ^ s.charCodeAt(i), 16777619) >>> 0;\n    }\n    return h;\n}\n", "function salam_hash_int(v) {\n    return Math.abs(Math.trunc(v)) >>> 0;\n}\n", "const sqrt = Math.sqrt;\n", "const cbrt = Math.cbrt;\n", "const sin = Math.sin;\n", "const cos = Math.cos;\n", "const tan = Math.tan;\n", "const asin = Math.asin;\n", "const acos = Math.acos;\n", "const atan = Math.atan;\n", "const atan2 = Math.atan2;\n", "const exp = Math.exp;\n", "const log = Math.log;\n", "const log2 = Math.log2;\n", "const log10 = Math.log10;\n", "const floor = Math.floor;\n", "const ceil = Math.ceil;\n", "const round = Math.round;\n", "const trunc = Math.trunc;\n", "const hypot = Math.hypot;\n", "const fabs = Math.abs;\n", "const pow = Math.pow;\n", "function fmod(a, b) {\n    return a % b;\n}\n", "function __sal_loop(f) {\n    let prev = performance.now();\n    const step = function (t) {\n        let dt = t - prev;\n        prev = t;\n        if (dt > 100) dt = 100;\n        f(dt);\n        requestAnimationFrame(step);\n    };\n    requestAnimationFrame(step);\n}\n", "let __sal_audio = null;\nfunction __sal_tone(freq, ms) {\n    try {\n        if (!__sal_audio)\n            __sal_audio = new (window.AudioContext || window.webkitAudioContext)();\n        const t = __sal_audio.currentTime;\n        const osc = __sal_audio.createOscillator();\n        const gain = __sal_audio.createGain();\n        osc.type = \"square\";\n        osc.frequency.value = freq;\n        gain.gain.setValueAtTime(0.04, t);\n        gain.gain.exponentialRampToValueAtTime(0.001, t + ms / 1000);\n        osc.connect(gain);\n        gain.connect(__sal_audio.destination);\n        osc.start(t);\n        osc.stop(t + ms / 1000);\n    } catch (e) {\n        console.warn(\"__sal_tone: audio playback failed\", e);\n    }\n}\n", "function __sal_img(src) {\n    const img = new Image();\n    img.src = src;\n    return img;\n}\n", "function __sal_rrect(c, x, y, w, h, r) {\n    if (c.roundRect) c.roundRect(x, y, w, h, r);\n    else c.rect(x, y, w, h);\n}\n", "function __sal_lsget_i(k) {\n    try {\n        return Math.trunc(Number(localStorage.getItem(k) || 0)) || 0;\n    } catch (e) {\n        console.warn(\"__sal_lsget_i: localStorage read failed\", e);\n        return 0;\n    }\n}\n", "function __sal_lsget_s(k) {\n    try {\n        return String(localStorage.getItem(k) || \"\");\n    } catch (e) {\n        console.warn(\"__sal_lsget_s: localStorage read failed\", e);\n        return \"\";\n    }\n}\n", "function __sal_lsset(k, v) {\n    try {\n        localStorage.setItem(k, String(v));\n    } catch (e) {\n        console.warn(\"__sal_lsset: localStorage write failed\", e);\n    }\n}\n", "function __sal_touch(ev, axis) {\n    const t = (ev.changedTouches && ev.changedTouches[0]) || ev;\n    return Number((axis ? t.clientY : t.clientX) || 0);\n}\n", "function __sal_vlast(a) {\n    return a[a.length - 1];\n}\n", "function __sal_vclear(a) {\n    a.length = 0;\n}\n", "function __sal_vremove(a, i) {\n    return a.splice(i, 1)[0];\n}\n", "function __sal_vzeros(a, n) {\n    a.length = 0;\n    for (let i = 0; i < n; i++) a.push(0);\n}\n", "function __sal_vset(a, i, x) {\n    while (a.length <= i) a.push(0);\n    a[i] = x;\n}\n", "function __sal_vref(a, i) {\n    return { get 0() { return a[i]; }, set 0(v) { a[i] = v; } };\n}\n", "function __sal_viter(a) {\n    return { data: a, len: a.length, pos: 0 };\n}\n", "function __sal_mget(m, k, z) {\n    return m.has(k) ? m.get(k) : z;\n}\n", "function __sal_miter(m) {\n    return { m: m, ks: Array.from(m.keys()), pos: 0 };\n}\n", "function __sal_fmtf(x) {\n    if (Number.isNaN(x)) return \"nan\";\n    if (x === Infinity) return \"inf\";\n    if (x === -Infinity) return \"-inf\";\n    if (x === 0) return Object.is(x, -0) ? \"-0\" : \"0\";\n    let p = 15;\n    while (p < 17 && Number(x.toPrecision(p)) !== x) p++;\n    const parts = x.toExponential(p - 1).split(\"e\");\n    const e = parseInt(parts[1], 10);\n    const trim = function (t) {\n        return t.indexOf(\".\") < 0 ? t : t.replace(/0+$/, \"\").replace(/\\.$/, \"\");\n    };\n    if (e < -4 || e >= p) {\n        const ae = Math.abs(e);\n        return trim(parts[0]) + \"e\" + (e < 0 ? \"-\" : \"+\") + (ae < 10 ? \"0\" : \"\") + ae;\n    }\n    return trim(x.toFixed(Math.max(0, p - 1 - e)));\n}\n", "function __sal_dyn(b, m) {\n    const f = b[m];\n    if (f === undefined) {\n        if (m === \"free\") return undefined;\n        throw new Error(\"method '\" + m + \"' is not implemented by this value\");\n    }\n    return f.apply(null, [b.__d].concat(Array.prototype.slice.call(arguments, 2)));\n}\n", "let __sal_line = \"\";\nfunction __sal_out(t, nl, err) {\n    const s = String(t) + (nl ? \"\\n\" : \"\");\n    if (typeof process !== \"undefined\" && process.stdout && process.stdout.write) {\n        (err ? process.stderr : process.stdout).write(s);\n        return;\n    }\n    __sal_line += s;\n    let i;\n    while ((i = __sal_line.indexOf(\"\\n\")) >= 0) {\n        const line = __sal_line.slice(0, i);\n        __sal_line = __sal_line.slice(i + 1);\n        if (err) console.error(line);\n        else console.log(line);\n    }\n}\n", "function __sal_bytes(s) {\n    if (s instanceof Uint8Array) return s;\n    const e = new TextEncoder().encode(String(s));\n    const b = new Uint8Array(e.length + 1);\n    b.set(e);\n    return b;\n}\n", "function __sal_str(p) {\n    if (typeof p === \"string\") return p;\n    let n = p.length;\n    for (let i = 0; i < p.length; i++) {\n        if (p[i] === 0) { n = i; break; }\n    }\n    return new TextDecoder().decode(p.subarray(0, n));\n}\n", "function __sal_grow(p, n) {\n    const b = new Uint8Array(n);\n    if (p) b.set(p.subarray(0, Math.min(p.length, n)));\n    return b;\n}\n", "function __sal_memset(p, v, n) {\n    p.fill(v & 255, 0, n);\n    return p;\n}\n", "function __sal_memcpy(d, s, n) {\n    const src = __sal_bytes(s);\n    d.set(src.subarray(0, n), 0);\n    return d;\n}\n", "function __sal_ptradd(p, k) {\n    return __sal_bytes(p).subarray(k);\n}\n", "function __sal_w64(op, a, b, u) {\n    var r;\n    if (op === 3 || op === 4) b = b & 63;\n    if (op === 0) r = a + b;\n    else if (op === 1) r = a - b;\n    else if (op === 2) r = a * b;\n    else if (op === 3) r = a * Math.pow(2, b);\n    else if (op === 4) r = Math.floor(a / Math.pow(2, b));\n    else if (op === 8 && !u) r = -a - 1;\n    else if (op >= 5 && op <= 7 && (a | 0) === a && (b | 0) === b) r = op === 5 ? (a & b) : op === 6 ? (a | b) : (a ^ b);\n    if (r !== undefined && Number.isSafeInteger(r) && (!u || r >= 0)) return r;\n    if (!Number.isFinite(a) || !Number.isFinite(b)) return NaN;\n    var x = BigInt(Math.trunc(a)), y = BigInt(Math.trunc(b)), z, M = 9223372036854775808n;\n    if (!u) { if (x === M) x = M - 1n; if (y === M) y = M - 1n; }\n    if (op === 0) z = x + y;\n    else if (op === 1) z = x - y;\n    else if (op === 2) z = x * y;\n    else if (op === 3) z = x << (y & BigInt(63));\n    else if (op === 4) z = (u ? BigInt.asUintN(64, x) : BigInt.asIntN(64, x)) >> (y & BigInt(63));\n    else if (op === 5) z = x & y;\n    else if (op === 6) z = x | y;\n    else if (op === 7) z = x ^ y;\n    else z = ~x;\n    return Number(u ? BigInt.asUintN(64, z) : BigInt.asIntN(64, z));\n}\n", "function __sal_w64c(v, u) {\n    if (typeof v === \"function\") return v;\n    var t = Math.trunc(v);\n    if (!Number.isFinite(t)) return t;\n    if (u ? (t >= 0 && t <= Number.MAX_SAFE_INTEGER) : Number.isSafeInteger(t)) return t;\n    var x = BigInt(t);\n    return Number(u ? BigInt.asUintN(64, x) : BigInt.asIntN(64, x));\n}\n", "const abs = Math.abs;\n", "const labs = Math.abs;\n", "const llabs = Math.abs;\n", "function salam_char_from_code(c) {\n    return String.fromCodePoint(Math.max(0, Math.trunc(c)));\n}\n", "function write(fd, b, n) {\n    const bytes = __sal_bytes(b).subarray(0, Math.max(0, n));\n    __sal_out(new TextDecoder().decode(bytes), false, fd === 2);\n    return bytes.length;\n}\n", "function getpid() {\n    return typeof process !== \"undefined\" && process.pid ? process.pid : 0;\n}\n", "function __sal_parr(b, sz, k) {\n    const u = __sal_bytes(b);\n    const n = Math.floor(u.length / sz);\n    const T = [null, Int16Array, Uint16Array, Int32Array, Uint32Array, Float32Array, Float64Array][k || 0];\n    if (T && n > 0 && u.byteOffset % sz === 0) return new T(u.buffer, u.byteOffset, n);\n    return new Array(Math.max(1, n)).fill(0);\n}\n", "function __sal_slice(b, lo, hi) {\n    if (typeof b === \"string\") return b.slice(lo, hi);\n    if (ArrayBuffer.isView(b)) return b.subarray(lo, hi === undefined ? b.length : hi);\n    const end = hi === undefined ? b.length : hi;\n    const n = Math.max(0, end - lo);\n    const idx = (k) => typeof k === \"string\" && k !== \"\" && String(k >>> 0) === k;\n    return new Proxy(b, {\n        get(t, k) {\n            if (k === \"length\") return n;\n            if (idx(k)) return t[lo + Number(k)];\n            if (k === Symbol.iterator) return function* () { for (let i = 0; i < n; i++) yield t[lo + i]; };\n            if (k === \"__sal_view\") return true;\n            const v = Array.prototype[k];\n            return typeof v === \"function\" ? v.bind(Array.from({ length: n }, (_, i) => t[lo + i])) : t[k];\n        },\n        set(t, k, v) {\n            if (idx(k)) { t[lo + Number(k)] = v; return true; }\n            t[k] = v;\n            return true;\n        }\n    });\n}\n", "let __sal_u8s = null;\nlet __sal_u8b = null;\nfunction __sal_u8(s) {\n    s = __sal_str(s);\n    if (s !== __sal_u8s) {\n        __sal_u8s = s;\n        __sal_u8b = new TextEncoder().encode(s);\n    }\n    return __sal_u8b;\n}\n", "function __sal_blen(s) {\n    return __sal_u8(s).length;\n}\n", "function __sal_bsub(s, start, n) {\n    const b = __sal_u8(s);\n    const st = Math.min(Math.max(0, start), b.length);\n    const ln = Math.min(Math.max(0, n), b.length - st);\n    return new TextDecoder().decode(b.subarray(st, st + ln));\n}\n", "function __sal_bidx_in(s, u) {\n    s = __sal_str(s);\n    if (u <= 0) return u;\n    if (u >= s.length) return __sal_u8(s).length + (u - s.length);\n    return new TextEncoder().encode(s.slice(0, u)).length;\n}\n", "function __sal_bidx_out(s, b) {\n    s = __sal_str(s);\n    if (b <= 0) return b;\n    let n = 0;\n    let i = 0;\n    while (i < s.length && n < b) {\n        const c = s.charCodeAt(i);\n        let w = c < 0x80 ? 1 : (c < 0x800 ? 2 : 3);\n        let k = 1;\n        if (c >= 0xD800 && c < 0xDC00 && i + 1 < s.length && (s.charCodeAt(i + 1) & 0xFC00) === 0xDC00) {\n            w = 4;\n            k = 2;\n        }\n        n += w;\n        i += k;\n    }\n    return n >= b ? i : i + (b - n);\n}\n", "let __sal_td = null;\nfunction __sal_bch(b, c) {\n    if (c > 255) {\n        b.s += String.fromCharCode(c);\n        return b;\n    }\n    c &= 255;\n    if (c < 0x80 && !b.p) {\n        b.s += String.fromCharCode(c);\n        return b;\n    }\n    const p = b.p || (b.p = []);\n    p.push(c);\n    const l = p[0];\n    const need = l >= 0xF0 ? 4 : l >= 0xE0 ? 3 : l >= 0xC0 ? 2 : 1;\n    if (p.length >= need) {\n        if (!__sal_td) __sal_td = new TextDecoder();\n        b.s += __sal_td.decode(new Uint8Array(p));\n        b.p = null;\n    }\n    return b;\n}\n", "function __sal_ufc(cp) {\n    var c = Number(cp);\n    if (!(c >= 0 && c <= 0x10FFFF)) c = 0xFFFD;\n    return String.fromCodePoint(c);\n}\n", "function __sal_len(x) {\n    if (typeof x === \"string\") return __sal_blen(x);\n    if (x === null || x === undefined) return 0;\n    if (x instanceof Map) return x.size;\n    if (typeof x.s === \"string\") return __sal_blen(x.s);\n    const n = x.length;\n    return typeof n === \"number\" ? n : 0;\n}\n"
]

struct MuslTcc:
    pub active: bool = false
    pub tcc_dir: str = ""
    pub musl_dir: str = ""
end

pub type Command = int

pub struct Dr:
    pub command: Command = CMD_INSPECT
    pub input: str = ""
    pub lang: str = "en"
    pub lang_set: bool = false
    pub log_level: int = 2
    pub emit_tokens_xml: bool = false
    pub emit_ast_xml: bool = false
    pub emit_symbol_xml: bool = false
    pub xml_out: str = ""
    pub color: int = -1
    pub diag_style: int = 0
    pub diag_format: int = 0
    pub new_name: str = ""
    pub inline_mode: bool = false
    pub split: bool = false
    pub inputs: Vector<str> = Vector {}
    pub run_args: Vector<str> = Vector {}
    pub output: str = ""
    pub cc: str = "tcc"
    pub cc_explicit: bool = false
    pub backend: str = "auto"
    pub lib_paths: Vector<str> = Vector {}
    pub keep_temp: bool = false
    pub emit_c: bool = false
    pub force: bool = false
    pub safe: bool = true
    pub fmt_check: bool = false
    pub fmt_recursive: bool = false
    pub fmt_tabs: bool = false
    pub fmt_indent_width: int = 4
    pub fmt_fix_order: bool = true
    pub fmt_minify: bool = false
    pub fmt_exclude: Vector<str> = Vector {}
    pub fmt_include: Vector<str> = Vector {}
    pub fmt_exclude_from: Vector<str> = Vector {}
    pub debug_info: bool = false
    pub asan: bool = false
    pub time_report: bool = false
    pub time_report_fmt: int = 0
    pub time_trace: str = ""
    pub lto: bool = false
    pub interp: bool = false
    pub timeout_ms: int = 0
    pub stdlib_path: str = ""
    pub exe_path: str = ""
    pub defines: Vector<str> = Vector {}
    pub consts: Vector<str> = Vector {}
    pub exports: Vector<str> = Vector {}
    pub llvm_opt_level: int = 0
    pub llvm_opt_set: bool = false
    pub llvm_emit: int = 0
    pub llvm_verify: bool = false
    pub llvm_target: str = ""
    pub llvm_native_cpu: bool = false
    pub llvm_fp_contract: bool = false
    pub no_js_minify_names: bool = false
    pub no_minify: bool = false
    pub version_short: bool = false
    pub serve_host: str = ""
    pub serve_port: int = 0
    pub translate_lang: str = ""
    pub translate_rewrite: bool = false
end

if SALAM_OS_WINDOWS:
    func driver_pid(): int: ret _getpid() end
else:
    func driver_pid(): int: ret getpid() end
end
