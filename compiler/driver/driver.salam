extern:
    func system(cmd: str): int
    func getchar(): int
end

if SALAM_OS_WINDOWS:
    extern:
        func _isatty(fd: int): int
        func GetStdHandle(which: i32): void*
        func GetConsoleMode(h: void*, mode: void*): i32
        func SetConsoleMode(h: void*, mode: u32): i32
        func SetConsoleOutputCP(cp: int): int
        func _getpid(): int
    end
else:
    extern:
        func isatty(fd: int): int
        func getpid(): int
    end
end

