k_dr_js_prelude_names := [
    "salam_panic", "__salam_unsupported", "salam_input", "salam_strcat", "salam_str_hash", "salam_hash_int", "sqrt", "cbrt", "sin", "cos", "tan", "asin", "acos", "atan", "atan2", "exp", "log", "log2", "log10", "floor", "ceil", "round", "trunc", "hypot", "fabs", "pow", "fmod", "__sal_loop", "__sal_tone", "__sal_img", "__sal_rrect", "__sal_lsget_i", "__sal_lsget_s", "__sal_lsset", "__sal_touch", "__sal_vlast", "__sal_vclear", "__sal_vremove", "__sal_vzeros", "__sal_vset", "__sal_vref", "__sal_viter", "__sal_mget", "__sal_miter", "__sal_fmtf", "__sal_dyn", "__sal_out", "__sal_bytes", "__sal_str", "__sal_grow", "__sal_memset", "__sal_memcpy", "__sal_ptradd"
]

k_dr_js_prelude_texts := [
    "function salam_panic(message) {\n    throw new Error(\"Salam panic: \" + String(message));\n}\n", "function __salam_unsupported(what) {\n    throw new Error(\"not supported in the browser build: \" + what);\n}\n", "function salam_input() {\n    return typeof prompt === \"function\" ? String(prompt(\"\") || \"\") : \"\";\n}\n", "function salam_strcat(a, b) {\n    return String(a) + String(b);\n}\n", "function salam_str_hash(s) {\n    let h = 2166136261 >>> 0;\n    for (let i = 0; i < s.length; i++) {\n        h = Math.imul(h ^ s.charCodeAt(i), 16777619) >>> 0;\n    }\n    return h;\n}\n", "function salam_hash_int(v) {\n    return Math.abs(Math.trunc(v)) >>> 0;\n}\n", "const sqrt = Math.sqrt;\n", "const cbrt = Math.cbrt;\n", "const sin = Math.sin;\n", "const cos = Math.cos;\n", "const tan = Math.tan;\n", "const asin = Math.asin;\n", "const acos = Math.acos;\n", "const atan = Math.atan;\n", "const atan2 = Math.atan2;\n", "const exp = Math.exp;\n", "const log = Math.log;\n", "const log2 = Math.log2;\n", "const log10 = Math.log10;\n", "const floor = Math.floor;\n", "const ceil = Math.ceil;\n", "const round = Math.round;\n", "const trunc = Math.trunc;\n", "const hypot = Math.hypot;\n", "const fabs = Math.abs;\n", "const pow = Math.pow;\n", "function fmod(a, b) {\n    return a % b;\n}\n", "function __sal_loop(f) {\n    let prev = performance.now();\n    const step = function (t) {\n        let dt = t - prev;\n        prev = t;\n        if (dt > 100) dt = 100;\n        f(dt);\n        requestAnimationFrame(step);\n    };\n    requestAnimationFrame(step);\n}\n", "let __sal_audio = null;\nfunction __sal_tone(freq, ms) {\n    try {\n        if (!__sal_audio)\n            __sal_audio = new (window.AudioContext || window.webkitAudioContext)();\n        const t = __sal_audio.currentTime;\n        const osc = __sal_audio.createOscillator();\n        const gain = __sal_audio.createGain();\n        osc.type = \"square\";\n        osc.frequency.value = freq;\n        gain.gain.setValueAtTime(0.04, t);\n        gain.gain.exponentialRampToValueAtTime(0.001, t + ms / 1000);\n        osc.connect(gain);\n        gain.connect(__sal_audio.destination);\n        osc.start(t);\n        osc.stop(t + ms / 1000);\n    } catch (e) {\n        console.warn(\"__sal_tone: audio playback failed\", e);\n    }\n}\n", "function __sal_img(src) {\n    const img = new Image();\n    img.src = src;\n    return img;\n}\n", "function __sal_rrect(c, x, y, w, h, r) {\n    if (c.roundRect) c.roundRect(x, y, w, h, r);\n    else c.rect(x, y, w, h);\n}\n", "function __sal_lsget_i(k) {\n    try {\n        return Math.trunc(Number(localStorage.getItem(k) || 0)) || 0;\n    } catch (e) {\n        console.warn(\"__sal_lsget_i: localStorage read failed\", e);\n        return 0;\n    }\n}\n", "function __sal_lsget_s(k) {\n    try {\n        return String(localStorage.getItem(k) || \"\");\n    } catch (e) {\n        console.warn(\"__sal_lsget_s: localStorage read failed\", e);\n        return \"\";\n    }\n}\n", "function __sal_lsset(k, v) {\n    try {\n        localStorage.setItem(k, String(v));\n    } catch (e) {\n        console.warn(\"__sal_lsset: localStorage write failed\", e);\n    }\n}\n", "function __sal_touch(ev, axis) {\n    const t = (ev.changedTouches && ev.changedTouches[0]) || ev;\n    return Number((axis ? t.clientY : t.clientX) || 0);\n}\n", "function __sal_vlast(a) {\n    return a[a.length - 1];\n}\n", "function __sal_vclear(a) {\n    a.length = 0;\n}\n", "function __sal_vremove(a, i) {\n    return a.splice(i, 1)[0];\n}\n", "function __sal_vzeros(a, n) {\n    a.length = 0;\n    for (let i = 0; i < n; i++) a.push(0);\n}\n", "function __sal_vset(a, i, x) {\n    while (a.length <= i) a.push(0);\n    a[i] = x;\n}\n", "function __sal_vref(a, i) {\n    return { get 0() { return a[i]; }, set 0(v) { a[i] = v; } };\n}\n", "function __sal_viter(a) {\n    return { data: a, len: a.length, pos: 0 };\n}\n", "function __sal_mget(m, k, z) {\n    return m.has(k) ? m.get(k) : z;\n}\n", "function __sal_miter(m) {\n    return { m: m, ks: Array.from(m.keys()), pos: 0 };\n}\n", "function __sal_fmtf(x) {\n    if (Number.isNaN(x)) return \"nan\";\n    if (x === Infinity) return \"inf\";\n    if (x === -Infinity) return \"-inf\";\n    if (x === 0) return Object.is(x, -0) ? \"-0\" : \"0\";\n    let p = 15;\n    while (p < 17 && Number(x.toPrecision(p)) !== x) p++;\n    const parts = x.toExponential(p - 1).split(\"e\");\n    const e = parseInt(parts[1], 10);\n    const trim = function (t) {\n        return t.indexOf(\".\") < 0 ? t : t.replace(/0+$/, \"\").replace(/\\.$/, \"\");\n    };\n    if (e < -4 || e >= p) {\n        const ae = Math.abs(e);\n        return trim(parts[0]) + \"e\" + (e < 0 ? \"-\" : \"+\") + (ae < 10 ? \"0\" : \"\") + ae;\n    }\n    return trim(x.toFixed(Math.max(0, p - 1 - e)));\n}\n", "function __sal_dyn(b, m) {\n    return b[m].apply(null, [b.__d].concat(Array.prototype.slice.call(arguments, 2)));\n}\n", "let __sal_line = \"\";\nfunction __sal_out(t, nl, err) {\n    const s = String(t) + (nl ? \"\\n\" : \"\");\n    if (typeof process !== \"undefined\" && process.stdout && process.stdout.write) {\n        (err ? process.stderr : process.stdout).write(s);\n        return;\n    }\n    __sal_line += s;\n    let i;\n    while ((i = __sal_line.indexOf(\"\\n\")) >= 0) {\n        const line = __sal_line.slice(0, i);\n        __sal_line = __sal_line.slice(i + 1);\n        if (err) console.error(line);\n        else console.log(line);\n    }\n}\n", "function __sal_bytes(s) {\n    if (s instanceof Uint8Array) return s;\n    const e = new TextEncoder().encode(String(s));\n    const b = new Uint8Array(e.length + 1);\n    b.set(e);\n    return b;\n}\n", "function __sal_str(p) {\n    if (typeof p === \"string\") return p;\n    let n = p.length;\n    for (let i = 0; i < p.length; i++) {\n        if (p[i] === 0) { n = i; break; }\n    }\n    return new TextDecoder().decode(p.subarray(0, n));\n}\n", "function __sal_grow(p, n) {\n    const b = new Uint8Array(n);\n    if (p) b.set(p.subarray(0, Math.min(p.length, n)));\n    return b;\n}\n", "function __sal_memset(p, v, n) {\n    p.fill(v & 255, 0, n);\n    return p;\n}\n", "function __sal_memcpy(d, s, n) {\n    const src = __sal_bytes(s);\n    d.set(src.subarray(0, n), 0);\n    return d;\n}\n", "function __sal_ptradd(p, k) {\n    return __sal_bytes(p).subarray(k);\n}\n"
]

struct MuslTcc:
    pub active: bool = false
    pub tcc_dir: str = ""
    pub musl_dir: str = ""
end

pub type Command = int

pub struct Dr:
    pub command: Command = CMD_INSPECT
    pub input: str = ""
    pub lang: str = "en"
    pub log_level: int = 2
    pub emit_tokens_xml: bool = false
    pub emit_ast_xml: bool = false
    pub emit_symbol_xml: bool = false
    pub xml_out: str = ""
    pub color: int = -1
    pub diag_style: int = 0
    pub diag_format: int = 0
    pub new_name: str = ""
    pub inline_mode: bool = false
    pub split: bool = false
    pub inputs: Vector<str> = Vector {}
    pub run_args: Vector<str> = Vector {}
    pub output: str = ""
    pub cc: str = "tcc"
    pub cc_explicit: bool = false
    pub backend: str = "auto"
    pub lib_paths: Vector<str> = Vector {}
    pub keep_temp: bool = false
    pub emit_c: bool = false
    pub force: bool = false
    pub safe: bool = true
    pub fmt_check: bool = false
    pub fmt_recursive: bool = false
    pub fmt_tabs: bool = false
    pub fmt_indent_width: int = 4
    pub fmt_fix_order: bool = true
    pub fmt_minify: bool = false
    pub debug_info: bool = false
    pub asan: bool = false
    pub time_report: bool = false
    pub time_report_fmt: int = 0
    pub time_trace: str = ""
    pub lto: bool = false
    pub interp: bool = false
    pub timeout_ms: int = 0
    pub stdlib_path: str = ""
    pub exe_path: str = ""
    pub defines: Vector<str> = Vector {}
    pub consts: Vector<str> = Vector {}
    pub exports: Vector<str> = Vector {}
    pub llvm_opt_level: int = 0
    pub llvm_opt_set: bool = false
    pub llvm_emit: int = 0
    pub llvm_verify: bool = false
    pub llvm_target: str = ""
    pub llvm_native_cpu: bool = false
    pub llvm_fp_contract: bool = false
    pub no_js_minify_names: bool = false
    pub no_minify: bool = false
    pub version_short: bool = false
    pub serve_host: str = ""
    pub serve_port: int = 0
    pub translate_lang: str = ""
    pub translate_rewrite: bool = false
end

if SALAM_OS_WINDOWS:
    func driver_pid(): int: ret _getpid() end
else:
    func driver_pid(): int: ret getpid() end
end
