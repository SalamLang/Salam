package driver

import os
import io
import str
import pth "../sal_path.salam"
import tok "../token.salam"
import src "../source.salam"
import lg "../logger.salam"
import at "../ast.salam"
import i18 "../i18n.salam"
import lp "../langpack.salam"
import lx "../lexer/lexer.salam"
import ps "../parser/parser.salam"
import cc "../condcomp.salam"
import sm "../semantic/semantic.salam"
import cg "../codegen/codegen.salam"
import co "../sal_core.salam"
import pf "../prof_self.salam"

    // build.c cc_is_bare_name - a tool name we are expected to look up: no
    // directory component and no flags. Anything else ("gcc -O2",
    // "C:/tools/tcc.exe") is a command prefix the caller wrote deliberately
    // and is passed through untouched.
    func cc_is_bare_name(name: str): bool:
        if str.Len(name) == 0:
            ret false
        end
        if str.Contains(name, " "):
            ret false
        end
        if str.Contains(name, "/"):
            ret false
        end
        if str.Contains(name, "\\"):
            ret false
        end
        ret true
    end

    // driver/build.c driver_build (the CMD_BUILD/CMD_OBJ shared body; `opt`
    // must have .command already set to CMD_BUILD or CMD_OBJ by the caller).
    func build_impl(opt &: Dr): int:
        // A bare `salam build` (no inputs) or a directory passed as the
        // sole input (`salam build .`, `salam build ../project/`) doesn't
        // name a file - resolve it to the project's entry file
        // (salam.salam when present, else the one .salam file defining
        // `main`) BEFORE picking a backend: the LLVM path reads opt.input
        // directly and must see the resolved file, not a directory, and
        // the project-file rule has to hold for every backend equally.
        if opt.inputs.len() == 0 || (opt.inputs.len() == 1 && os.IsDir(opt.inputs.get(0))):
            rlgr := lg.New(opt.log_level, resolve_color(opt.color))
            rpack := lp.Load(opt.lang)
            if rpack == lp.LP_NONE:
                lg.Log(
                    rlgr, lg.PH_DRIVER, lg.LOG_ERROR, co.Format1(i18.Tr("unknown language pack '%s'"), co.ArgStr(opt.lang))
                )
                ret 2
            end
            mut rdir := "."
            if opt.inputs.len() == 1:
                rdir = opt.inputs.get(0)
            end
            first := resolve_dir_entry(rlgr, rpack, rdir)
            if str.Len(first) == 0:
                ret 2
            end
            if opt.inputs.len() == 0:
                opt.inputs.push(first)
            else:
                opt.inputs.set(0, first)
            end
            opt.input = first
        end

        // driver/build.c: `if (opt->llvm_target && opt->llvm_target[0]) return
        // driver_llvm_build(opt);` - NOT a bare driver_llvm call (that would
        // skip setting llvm_emit from opt->command). LlvmBuild (below, in the
        // public section) is that wrapper.
        if str.Len(opt.llvm_target) > 0:
            ret LlvmBuild(opt)
        end

        // Backend choice for a native build, mirroring driver_build()'s
        // build_use_llvm() in the C. LLVM is preferred whenever this binary
        // can actually drive it, because it optimizes and (with in-process
        // LLD) links without a compiler on the end user's machine.
        //
        // RC_LLVM_UNSUPPORTED means the module was emitted but is
        // incomplete - the program uses a construct the LLVM backend does
        // not lower yet. RC_LLVM_LINK_FAILED means codegen was fine but
        // producing the executable was not, which is what happens to every
        // program that links a host shared library (-lsqlite3, -lgtk-3):
        // the bundled static musl sysroot has none of them, while the C
        // backend's host toolchain does. Falling back on both keeps every
        // program that builds today building, which is what makes
        // defaulting to LLVM safe before backend parity is finished. Any
        // other non-zero code is a real error and is reported as-is rather
        // than retried, so a genuine mistake is not hidden behind a second
        // compile.
        if use_llvm_backend(opt):
            lrc := LlvmBuild(opt)
            if lrc != RC_LLVM_UNSUPPORTED && lrc != RC_LLVM_LINK_FAILED:
                ret lrc
            end
            if str.Equals(opt.backend, "llvm"):
                ret lrc
            end
            io.EPrintln(
                i18.Tr(
                    "salam: falling back to the C backend for this file (build with --backend=llvm to make this an error)"
                )
            )
        end

        lgr := lg.New(opt.log_level, resolve_color(opt.color))
        mut rc := 0
        scratch := scratch_dir()

        pack := lp.Load(opt.lang)
        if pack == lp.LP_NONE:
            lg.Log(
                lgr, lg.PH_DRIVER, lg.LOG_ERROR, co.Format1(i18.Tr("unknown language pack '%s'"), co.ArgStr(opt.lang))
            )
            ret 2
        end
        // Not from build.c: whole-build skip (see build_up_to_date's comment).
        // CMD_OBJ has no single tracked output and already has its own
        // per-object cache below, so this only applies to a real `salam
        // build` producing one executable.
        if opt.command == CMD_BUILD && !opt.force:
            predicted_output := str.Len(opt.output) > 0 ? opt.output : output_stem_of(opt.inputs.get(0)) + ".exe"
            sig0 := build_signature(opt)
            if build_up_to_date(scratch, sig0, predicted_output):
                lg.Log(lgr, lg.PH_DRIVER, lg.LOG_INFO, "up to date: " + predicted_output)
                if str.Len(opt.exe_path) == 0:
                    opt.exe_path = predicted_output
                end
                ret 0
            end
        end

        sm.SetStdlibRoot(opt.stdlib_path)
        sm.LayoutSchemaInit(opt.stdlib_path)

        // --export=Fn:CName is only registered (cg.AddExportOverride) once we
        // know the DEFINING file's own package (modpkg, below) - matching by
        // name alone would rename EVERY same-named free function across every
        // module this build transitively pulls in (e.g. llvm.salam's own
        // Emit() collides with sal_web.salam's Emit() otherwise).
        mut export_names := Vector {} as Vector<str>
        mut export_cnames := Vector {} as Vector<str>
        defer export_names.free()
        defer export_cnames.free()
        repeat opt.exports.len() with exi:
            spec := opt.exports.get(exi)
            colon := str.IndexOf(spec, ":")
            if colon <= 0 || colon >= str.Len(spec) - 1:
                lg.Log(
                    lgr, lg.PH_DRIVER, lg.LOG_ERROR, "invalid --export value '" + spec + "' (want Fn:CName)"
                )
                ret 2
            end
            fname := str.Substr(spec, 0, colon)
            cname := str.Substr(spec, colon + 1, str.Len(spec) - colon - 1)
            export_names.push(fname)
            export_cnames.push(cname)
        end

        mut musl_tcc := MuslTcc {}
        mut resolved := ""
        mut bundled := false
        mut found := false
        // opt.cc_explicit is what separates that sentinel from a user who
        // actually typed --cc=tcc. Testing the string alone made the two
        // identical, so an explicit --cc=tcc was silently resolved away to
        // whatever clang/gcc the ladder found first - not a compiler the
        // caller asked for. An explicit --cc is a choice, not a hint.
        //
        // It still has to be *found*, though: only the ladder is skipped
        // for an explicit --cc, never the lookup. See the else-branch.
        if !opt.cc_explicit && str.Equals(opt.cc, "tcc"):
            // clang > gcc > tcc, matching build.c's ladder exactly: clang
            // leads because it is the same codegen family as the LLVM
            // backend, so an auto build degrades to the closest thing
            // available rather than to a different toolchain.
            //
            // The *whole* ladder is walked over the bundled install tree
            // before $PATH is consulted at all - not bundled-then-$PATH per
            // rung. Interleaving them let a host gcc outrank the tcc a
            // self-contained install ships with, which is not the toolchain
            // that install was built and tested against: on Windows it swaps
            // in a mingw-w64 gcc whose <stdlib.h> spells __argv as a macro
            // over __p___argv(), so std/os/process' `extern void* __argv`
            // becomes a conflicting redeclaration and every program
            // importing it stops compiling. The $PATH pass still exists for
            // the case it was added for - an install that ships no toolchain
            // at all, most notably a plain source checkout.
            ladder := ["clang", "gcc", "tcc"] as str[3]
            repeat ladder.len() with i:
                if !found:
                    found = sm.FindBundledTool(ladder[i], resolved)
                    bundled = found
                end
            end
            repeat ladder.len() with j:
                if !found:
                    found = sm.FindPathTool(ladder[j], resolved)
                end
            end
        else opt.cc_explicit && cc_is_bare_name(opt.cc):
            // An explicit --cc says *which* compiler; where it lives is
            // still an open question, and the bundled toolchain is not on
            // $PATH. On Windows a release's tcc sits at
            // <install>/tcc/tcc.exe, so leaving the bare name for the shell
            // got cmd.exe's "'tcc' is not recognized" on every db/ and
            // opencv/ test - they all pass --cc=$DBCC. Bundled first, then
            // $PATH, exactly as the ladder does, minus the ladder.
            found = sm.FindBundledTool(opt.cc, resolved)
            bundled = found
            if !found:
                found = sm.FindPathTool(opt.cc, resolved)
            end
        end
        if found:
            mut origin := "host"
            if bundled:
                origin = "bundled"
            end
            lg.Log(lgr, lg.PH_DRIVER, lg.LOG_INFO, "using " + origin + " C compiler: " + resolved)
            if SALAM_OS_WINDOWS:
                musl_tcc = MuslTcc {}
            else:
                if bundled:
                    musl_tcc = detect_bundled_musl_tcc(resolved)
                    if musl_tcc.active:
                        lg.Log(lgr, lg.PH_DRIVER, lg.LOG_INFO, "using bundled musl sysroot: " + musl_tcc.musl_dir)
                    end
                end
            end
            // A --cc= the user typed is a command prefix and may carry
            // flags, so it goes into the command line verbatim; a path
            // resolved here is just a path, and $PATH entries like
            // "C:/Program Files/..." have to be quoted to survive it.
            if str.Contains(resolved, " "):
                opt.cc = "\"" + resolved + "\""
            else:
                opt.cc = resolved
            end
        end

        mut cfiles := Vector {} as Vector<str>
        mut generated := Vector {} as Vector<str>
        // 1 when cfiles[i]'s object must be rebuilt, 0 when the cached .o is
        // still valid. Parallel to cfiles (int, not bool, to stay clear of the
        // generic-nesting limits noted in PORTING.md).
        mut cdirty := Vector {} as Vector<int>
        defer cfiles.free()
        defer generated.free()
        defer cdirty.free()
        mut first_module := ""
        mut all_ok := true
        // paths that failed to read/parse/check/generate, recapped on abort
        // (below) so the reader doesn't have to scroll back past the phase
        // INFO logs of every other file in the build to find out what broke.
        mut failed_files := Vector {} as Vector<str>
        defer failed_files.free()

        entry := lp.Entry(pack)
        mut has_entry := false

        mut links := Vector {} as Vector<str>
        mut link_kinds := Vector {} as Vector<str>
        defer links.free()
        defer link_kinds.free()

        mut defs := Vector {} as Vector<str>
        defer defs.free()
        repeat opt.defines.len() with di0:
            defs.push(opt.defines.get(di0))
        end
        if opt.asan:
            defs.push("SALAM_MEM_DEBUG")
            defs.push("SALAM_ASAN")
        end
        use_tcc := str.Contains(opt.cc, "tcc")
        mut cc_def := "SALAM_CC_GCC"
        if use_tcc:
            cc_def = "SALAM_CC_TCC"
        else str.Contains(opt.cc, "clang"):
            cc_def = "SALAM_CC_CLANG"
        end
        defs.push(cc_def)

        mut work := Vector {} as Vector<str>
        defer work.free()
        repeat opt.inputs.len() with ii:
            work.push(opt.inputs.get(ii))
        end
        memp := sm.ResolveImport("", "mem")
        if str.Len(memp) > 0 && os.Exists(memp):
            work.push(memp)
        end
        corep := sm.ResolveImport("", "core")
        if str.Len(corep) > 0 && os.Exists(corep):
            work.push(corep)
        end

        // ONE Ast and ONE Sema for the whole build (the C uses a single arena
        // for both). Sharing them is what lets an imported package be lexed,
        // parsed and analyzed once per build instead of once per importer:
        // cached package symbols are SymIds into this Sema and hold NodeIds
        // into this Ast, so neither may be freed between work-list files.
        // NOTE: never copy these into a local (`mut x := a`) - at.Ast/Sema own
        // Vectors, and a struct copy snapshots the vector headers, so growth
        // through the copy would not be visible through the original (the
        // "Vector-header copy hazard" PORTING.md warns about). Pass them by
        // reference (`&:`) only, which every lexer/parser/sema/codegen entry
        // point already takes.
        mut a := at.NewAst()
        mut s := sm.New(lgr, "", "en")
        // Each file's own global ScopeId, handed back to sm.RebindScope before
        // that file's codegen (codegen resolves top-level names via s.global).
        mut w_global := Vector {} as Vector<int>
        mut w_prog := Vector {} as Vector<int>
        mut w_module := Vector {} as Vector<str>
        mut w_entry := Vector {} as Vector<str>
        mut w_pkg := Vector {} as Vector<str>
        mut w_path := Vector {} as Vector<str>
        defer w_global.free()
        defer w_prog.free()
        defer w_module.free()
        defer w_entry.free()
        defer w_pkg.free()
        defer w_path.free()

        sm.DceReset()
        sm.DceEnable()

        mut wi := 0
        until wi < work.len():
            path := work.get(wi)
            mut dup := false
            repeat wi with j:
                if str.Equals(work.get(j), path):
                    dup = true
                end
            end
            if dup:
                wi += 1
                continue
            end

            mut sf := src.New()
            _pt_source := pf.Begin(pf.TP_SOURCE, path)
            src_ok := src.Load(path, sf)
            pf.End(pf.TP_SOURCE, _pt_source)
            if !src_ok:
                lg.Log(
                    lgr, lg.PH_DRIVER, lg.LOG_ERROR, co.Format1(i18.Tr("cannot read source file '%s'"), co.ArgStr(path))
                )
                all_ok = false
                failed_files.push(path)
                wi += 1
                continue
            end

            table := cc.TableBuild("", defs)
            modpack := lx.Detect(sf, pack)
            modentry := lp.Entry(modpack)

            lg.SetDiagSource(lgr, sf.text, sf.len, opt.diag_style, opt.diag_format)
            lg.AddDiagSource(lgr, path, sf.text, sf.len)

            module := module_of(path)
            if str.Len(first_module) == 0:
                first_module = module
            end
            lg.Log(lgr, lg.PH_DRIVER, lg.LOG_INFO, "compiling " + path + " -> " + module + ".c")

            mut toks := tok.StreamNew(path)
            _pt_lexer := pf.Begin(pf.TP_LEXER, path)
            mut lok := lx.Run(lgr, modpack, sf, toks)
            pf.End(pf.TP_LEXER, _pt_lexer)
            pf.Count(pf.TC_TOKENS, tok.StreamCount(toks) as i64)
            mut prog := 0
            _pt_parser := pf.Begin(pf.TP_PARSER, path)
            mut pok := ps.Run(lgr, toks, a, prog)
            tok.StreamFree(toks)
            if !cc.PruneProgram(a, lgr, path, table, prog):
                pok = false
            end
            pf.End(pf.TP_PARSER, _pt_parser)

            mut pfiles := sm.PackageFiles(path)
            mut pi := 1
            until pi < pfiles.len():
                ppath := pfiles.get(pi)
                mut psf := src.New()
                if src.Load(ppath, psf):
                    lg.AddDiagSource(lgr, ppath, psf.text, psf.len)
                    mut ptoks := tok.StreamNew(ppath)
                    if !lx.Run(lgr, modpack, psf, ptoks):
                        lok = false
                    end
                    mut pprog := 0
                    if !ps.Run(lgr, ptoks, a, pprog):
                        pok = false
                    end
                    tok.StreamFree(ptoks)
                    if !cc.PruneProgram(a, lgr, ppath, table, pprog):
                        pok = false
                    end
                    sm.MergeProgram(a, prog, pprog)
                else:
                    lg.Log(
                        lgr, lg.PH_DRIVER, lg.LOG_ERROR, co.Format1(i18.Tr("cannot read source file '%s'"), co.ArgStr(ppath))
                    )
                    all_ok = false
                    failed_files.push(ppath)
                end
                pi += 1
            end
            pfiles.free()

            gscope := sm.Rebind(s, path, lp.Code(modpack))
            sm.SetCc(s, table)
            _pt_sema := pf.Begin(pf.TP_SEMANTIC, path)
            sok := sm.Run(s, a, prog)
            pf.End(pf.TP_SEMANTIC, _pt_sema)
            pf.Count(pf.TC_SYMBOLS, sm.ScopeAt(s, gscope).symbols.len() as i64)

            if !lok || !pok || !sok:
                all_ok = false
                failed_files.push(path)
                wi += 1
                continue
            end

            prog_n := at.Get(a, prog)
            modpkg := str.Len(prog_n.name) > 0 ? prog_n.name : "main"
            repeat prog_n.list.len() with di3:
                d := at.Get(a, prog_n.list.get(di3))
                if d.kind == at.AST_FUNC_DEF && str.Equals(d.name, modentry):
                    has_entry = true
                    sm.DceMarkRoot(modpkg, modentry)
                    break
                end
            end
            // --export only applies to the entry file itself (wi==0): matching
            // by name across every transitively-imported module would catch
            // unrelated same-named functions too (e.g. llvm.salam's own Emit()).
            if wi == 0 && export_names.len() > 0:
                repeat prog_n.list.len() with di3x:
                    d4 := at.Get(a, prog_n.list.get(di3x))
                    if d4.kind == at.AST_FUNC_DEF:
                        repeat export_names.len() with exj:
                            if str.Equals(d4.name, export_names.get(exj)):
                                sm.DceMarkRoot(modpkg, d4.name)
                                cg.AddExportOverride(modpkg, d4.name, export_cnames.get(exj))
                            end
                        end
                    end
                end
            end

            idir := dir_of(path)
            repeat prog_n.list.len() with di4:
                did := prog_n.list.get(di4)
                d2 := at.Get(a, did)
                if d2.kind == at.AST_LINK:
                    if d2.value_kind == tok.TV_STRING && str.Len(d2.value_str) > 0:
                        mut seen := false
                        repeat links.len() with lj:
                            if str.Equals(links.get(lj), d2.value_str):
                                seen = true
                            end
                        end
                        if !seen:
                            link_kinds.push(d2.name)
                            links.push(d2.value_str)
                            def := link_define(d2.value_str)
                            mut dseen := false
                            repeat defs.len() with dj:
                                if str.Equals(defs.get(dj), def):
                                    dseen = true
                                end
                            end
                            if !dseen:
                                defs.push(def)
                            end
                        end
                    end
                    continue
                end
                if d2.kind != at.AST_IMPORT:
                    continue
                end
                mut ipath := d2.type_str
                if str.Len(ipath) == 0:
                    ipath = sm.ResolveImportNode(a, idir, did, lp.Code(modpack))
                end
                if str.Len(ipath) == 0:
                    continue
                end
                mut known := false
                repeat work.len() with wj:
                    if str.Equals(work.get(wj), ipath):
                        known = true
                    end
                end
                if !known:
                    work.push(ipath)
                end
            end

            w_global.push(gscope)
            w_prog.push(prog)
            w_module.push(module)
            w_entry.push(modentry)
            w_pkg.push(modpkg)
            w_path.push(path)
            wi += 1
        end

        sm.DceFinish()

        repeat w_prog.len() with bi:
            prog2 := w_prog.get(bi)
            module2 := w_module.get(bi)
            entry2 := w_entry.get(bi)
            pkg2 := w_pkg.get(bi)
            path2 := w_path.get(bi)
            // Point the shared Sema back at this file's own global scope.
            sm.RebindScope(s, w_global.get(bi), pkg2, path2)

            mut kept := Vector {} as Vector<int>
            pn := at.Get(a, prog2)
            repeat pn.list.len() with ki:
                did2 := pn.list.get(ki)
                d3 := at.Get(a, did2)
                mut keep := true
                if d3.kind == at.AST_FUNC_DEF && !d3.is_extern && !d3.synthetic && d3.typarams.len() == 0 && !str.Equals(d3.name, entry2):
                    keep = sm.DceReachable(pkg2, d3.name)
                end
                if keep:
                    kept.push(did2)
                end
            end
            mut pw := at.Get(a, prog2)
            old_list := pw.list
            pw.list = kept
            at.Put(a, prog2, pw)
            old_list.free()

            if pf.On():
                mut nfuncs := 0
                kn := at.Get(a, prog2)
                repeat kn.list.len() with fi:
                    if at.Get(a, kn.list.get(fi)).kind == at.AST_FUNC_DEF:
                        nfuncs += 1
                    end
                end
                pf.Count(pf.TC_FUNCS_EMITTED, nfuncs as i64)
            end
            _pt_cg := pf.Begin(pf.TP_CODEGEN, path2)
            o := cg.Run(
                lgr, s, a, prog2, module2, opt.safe, opt.debug_info, path2, entry2, ""
            )
            pf.End(pf.TP_CODEGEN, _pt_cg)

            cpath := scratch + "/salam_mod_" + module2 + ".c"
            hpath := scratch + "/salam_mod_" + module2 + ".h"
            opath := scratch + "/salam_mod_" + module2 + ".o"
            // Only rewrite when the generated C actually differs: rewriting an
            // identical file would churn its timestamp and force a needless
            // recompile of an object that is still valid.
            _pt_w := pf.Begin(pf.TP_WRITE, path2)
            unchanged := !opt.force && os.Exists(opath) && file_unchanged(cpath, o.c_src) && file_unchanged(hpath, o.h_src)
            mut wok1 := true
            mut wok2 := true
            if !unchanged:
                wok1 = write_file(lgr, cpath, o.c_src)
                wok2 = write_file(lgr, hpath, o.h_src)
            end
            pf.End(pf.TP_WRITE, _pt_w)
            if !wok1 || !wok2:
                all_ok = false
                failed_files.push(path2)
            else:
                cfiles.push(cpath)
                if unchanged:
                    cdirty.push(0)
                else:
                    cdirty.push(1)
                end
                generated.push(cpath)
                generated.push(hpath)
            end

        end
        // The shared Ast/Sema are owned by the whole build, so they are freed
        // once here rather than per file.
        sm.Free(s)
        at.FreeAst(a)

        if !all_ok:
            lg.Log(
                lgr, lg.PH_DRIVER, lg.LOG_ERROR, abort_message(i18.Tr("build aborted: errors in source"), failed_files)
            )
            if !opt.keep_c:
                repeat generated.len() with gi1:
                    _rm1 := os.Remove(generated.get(gi1))
                end
            end
            ret 1
        end

        if opt.command != CMD_OBJ && !has_entry:
            lg.Log(
                lgr, lg.PH_DRIVER, lg.LOG_ERROR, co.Format1(
                    i18.Tr("no entry point: define a '%s' function"), co.ArgStr(entry)
                )
            )
            if !opt.keep_c:
                repeat generated.len() with gi2:
                    _rm2 := os.Remove(generated.get(gi2))
                end
            end
            ret 1
        end

        mut crc := 0
        no_tcc_opt := !str.Contains(opt.cc, "tcc")
        no_o_flag := !str.Contains(opt.cc, "-O")
        opt_flag := (!opt.debug_info && !opt.asan && no_tcc_opt && no_o_flag) ? " -O2" : ""
        // -fno-strict-aliasing is not optional, and is applied whenever the
        // compiler is not tcc - independently of -O, so a caller who passes
        // their own --cc="gcc -O2" still gets it. Generated C reaches every
        // aggregate through void* (slices hand back void* from
        // salam_slice_at, Vector payloads are re-cast per element, str
        // arrays are walked as int64_t*), which is exactly the punning
        // strict aliasing forbids: at -O2 gcc assumed those accesses could
        // not alias, `fmt.Sprintf` over a Vector<str> segfaulted and a
        // dozen tests truncated their output. -O0/-O1 were fine, which is
        // what made it look like a miscompile rather than UB in our output.
        alias_flag := no_tcc_opt ? " -fno-strict-aliasing" : ""
        // SALAM_C_STRICT=1 turns every diagnostic the C compiler would have
        // printed about generated code into a hard error, so a codegen
        // regression stops the build instead of scrolling past. -Werror on
        // its own, deliberately: it promotes what the compiler already chose
        // to warn about rather than switching on new warning classes, so the
        // bar means the same thing under tcc, gcc and clang. Off unless asked
        // for - a user's newer gcc inventing a warning must not break their
        // build - and turned on by run-tests.sh, where regressions have to be
        // caught and the compiler set is known.
        //
        // Two diagnostics are switched off rather than promoted, because
        // neither can tell what the generated code means:
        //
        //   div-by-zero  fires on a constant-folded `10 / d` sitting in the
        //                right arm of `d != 0 && ...`. Salam's && short-
        //                circuits, so that arm never runs, but the fold
        //                happens before the compiler knows that.
        //   deprecated-declarations
        //                codegen puts __attribute__((deprecated)) on the
        //                prototype so hand-written C including the header is
        //                warned. Salam call sites already get the semantic
        //                pass's own deprecation warning, so promoting the C
        //                copy of it turns "this test exercises a deprecated
        //                function" into a build failure.
        werror_flag := str.Equals(os.Env("SALAM_C_STRICT"), "1") ? " -Werror -Wno-div-by-zero -Wno-deprecated-declarations" : ""
        no_o0 := !str.Contains(opt.cc, "-O0")
        optimizing_build := !opt.debug_info && !opt.asan && no_tcc_opt && no_o0

        if opt.command == CMD_OBJ:
            dbg_flag := (opt.debug_info && no_tcc_opt) ? " -g" : ""
            mut oi := 0
            until oi < cfiles.len() && crc == 0:
                cf := cfiles.get(oi)
                obj := str.Substr(cf, 0, str.Len(cf) - 2) + ".o"
                mut cmdb := str.NewBuilder()
                str.BufAppend(cmdb, opt.cc)
                if musl_tcc.active:
                    str.BufAppend(cmdb, " -B")
                    str.BufAppend(cmdb, shell_arg(musl_tcc.tcc_dir))
                    str.BufAppend(cmdb, " -I")
                    str.BufAppend(cmdb, shell_arg(musl_tcc.tcc_dir))
                    str.BufAppend(cmdb, "/include -I")
                    str.BufAppend(cmdb, shell_arg(musl_tcc.musl_dir))
                    str.BufAppend(cmdb, "/include")
                end
                str.BufAppend(cmdb, " -c -I. -I")
                str.BufAppend(cmdb, shell_arg(scratch))
                str.BufAppend(cmdb, opt_flag)
                str.BufAppend(cmdb, alias_flag)
                str.BufAppend(cmdb, werror_flag)
                str.BufAppend(cmdb, dbg_flag)
                str.BufAppendChar(cmdb, 32)
                str.BufAppend(cmdb, shell_arg(cf))
                str.BufAppend(cmdb, " -o ")
                str.BufAppend(cmdb, shell_arg(obj))
                cmdtext := str.BufStr(cmdb)
                str.BufFree(cmdb)
                lg.Log(lgr, lg.PH_DRIVER, lg.LOG_INFO, "assembling: " + cmdtext)
                crc = proc_status(system(cmdtext))
                oi += 1
            end
            if crc != 0:
                lg.Log(
                    lgr, lg.PH_DRIVER, lg.LOG_ERROR, co.Format2(
                        i18.Tr("C compiler '%s' failed (exit %d)"), co.ArgStr(opt.cc), co.ArgInt(crc as i64)
                    )
                )
                rc = 3
            else:
                lg.Log(lgr, lg.PH_DRIVER, lg.LOG_INFO, "produced object files (.o)")
            end
        else:
            mut output := opt.output
            if str.Len(output) == 0:
                // Not first_module + ".exe": the fixed project entry file
                // salam.salam names the executable after its directory
                // (see output_stem_of), and this must agree with
                // build_up_to_date's predicted_output above.
                output = output_stem_of(opt.inputs.get(0)) + ".exe"
            end
            mut lm := " -lm"
            if SALAM_OS_WINDOWS:
                if use_tcc:
                    lm = " -lmsvcrt"
                else str.Contains(opt.cc, "clang"):
                    lm = ""
                else:
                    lm = " -lm"
                end
            else:
                lm = " -lm"
            end

            if opt.debug_info && use_tcc:
                lg.Log(
                    lgr, lg.PH_DRIVER, lg.LOG_WARN, "tcc has limited debug-symbol support; prefer --cc=gcc or " + "--cc=clang with -g"
                )
            end
            dbg_flag2 := (opt.debug_info && no_tcc_opt) ? " -g" : ""

            mut asan_flag := ""
            if opt.asan:
                if use_tcc:
                    lg.Log(
                        lgr, lg.PH_DRIVER, lg.LOG_ERROR, "tcc does not support AddressSanitizer; use --cc=gcc or --cc=clang"
                    )
                    if !opt.keep_c:
                        repeat generated.len() with gi3:
                            _rm3 := os.Remove(generated.get(gi3))
                        end
                    end
                    ret 2
                end
                asan_flag = " -fsanitize=address -fno-omit-frame-pointer -DSALAM_MEM_DEBUG"
            end

            mut link_defines := ""
            repeat links.len() with li:
                link_defines = link_defines + " -DSALAM_LINK_" + sanitize_ident(links.get(li))
            end

            if !opt.lto && !musl_tcc.active:
                // Fast path (default): compile every .c to its own .o across
                // worker threads, then one ordinary (non-LTO) link. See
                // compile_parallel's comment for why LTO stays opt-in instead.
                mut objs := Vector {} as Vector<str>
                mut jobs := Vector {} as Vector<str>
                // Cached objects were built with the previous flag set; if it
                // moved (--release, -g, --asan, a new link directive, a
                // different --cc) every object is stale no matter whether its
                // source changed.
                sigpath := scratch + "/salam_build.flags"
                sigtext := opt.cc + " " + opt_flag + " " + alias_flag + " " + dbg_flag2 + " " + asan_flag + " " + link_defines
                mut sig_pending := false
                if !file_unchanged(sigpath, sigtext):
                    repeat cfiles.len() with cd0:
                        cdirty.set(cd0, 1)
                    end
                    // Recorded only once every object has actually been
                    // rebuilt with these flags (see after compile_parallel).
                    // Writing it here, before compiling, meant a build that
                    // failed or was interrupted left the file claiming a flag
                    // set the objects on disk were never built with. The next
                    // run then believed its cache and linked whatever was
                    // lying there: switching gcc -> tcc that way handed the
                    // linker gcc's objects and it died on "unrecognized file
                    // type", pointing at nothing the user did.
                    sig_pending = true
                end
                repeat cfiles.len() with ci2:
                    cf2 := cfiles.get(ci2)
                    obj2 := str.Substr(cf2, 0, str.Len(cf2) - 2) + ".o"
                    objs.push(obj2)
                    if cdirty.get(ci2) == 0:
                        continue
                    end
                    mut jb := str.NewBuilder()
                    str.BufAppend(jb, opt.cc)
                    str.BufAppend(jb, " -c -I. -I")
                    str.BufAppend(jb, shell_arg(scratch))
                    str.BufAppend(jb, opt_flag)
                    str.BufAppend(jb, alias_flag)
                    str.BufAppend(jb, werror_flag)
                    // No -Wno-error=incompatible-pointer-types here. It was
                    // added to keep the parallel path building while newer
                    // GCC promoted pointer-type mismatches to errors, with
                    // the reason given as "an unrelated pre-existing codegen
                    // issue" - which is to say the generated C really was
                    // wrong and the driver agreed to look away. It also sat
                    // after -Werror, so it silently un-errored the one class
                    // SALAM_C_STRICT most needs to catch: emitting a pointer
                    // where an integer is expected is a bug wherever it comes
                    // from. All 45 modules of the self-hosted compiler now
                    // compile clean under gcc 16 and tcc with no exemption,
                    // so this is deleted rather than narrowed; if it ever
                    // trips again the build must stop and say so.
                    str.BufAppend(jb, dbg_flag2)
                    str.BufAppend(jb, asan_flag)
                    str.BufAppend(jb, link_defines)
                    str.BufAppendChar(jb, 32)
                    str.BufAppend(jb, shell_arg(cf2))
                    str.BufAppend(jb, " -o ")
                    str.BufAppend(jb, shell_arg(obj2))
                    jobs.push(str.BufStr(jb))
                    str.BufFree(jb)
                end
                lg.Log(
                    lgr, lg.PH_DRIVER, lg.LOG_INFO, "compiling " + str.FromInt(jobs.len() as i64) + " object file" + plural_suffix(jobs.len()) + " in parallel, reused " + str.FromInt((cfiles.len() - jobs.len()) as i64) + " cached object" + plural_suffix(cfiles.len() - jobs.len())
                )
                _pt_cc := pf.Begin(pf.TP_CC, "")
                crc = compile_parallel(jobs)
                pf.End(pf.TP_CC, _pt_cc)
                pf.Count(pf.TC_MODULES_BUILT, jobs.len() as i64)
                pf.Count(pf.TC_MODULES_CACHED, (cfiles.len() - jobs.len()) as i64)
                jobs.free()
                if crc != 0:
                    lg.Log(
                        lgr, lg.PH_DRIVER, lg.LOG_ERROR, co.Format2(
                            i18.Tr("C compiler '%s' failed (exit %d)"), co.ArgStr(opt.cc), co.ArgInt(crc as i64)
                        )
                    )
                    rc = 3
                else:
                    // Every object now matches these flags, so the cache may
                    // claim them. On failure the file is deliberately left
                    // alone, so the next run still sees the old signature,
                    // marks everything dirty and rebuilds.
                    if sig_pending:
                        _wsig := write_file(lgr, sigpath, sigtext)
                    end
                    mut cmdb2 := str.NewBuilder()
                    str.BufAppend(cmdb2, opt.cc)
                    str.BufAppend(cmdb2, asan_flag)
                    str.BufAppend(cmdb2, " -I. -I")
                    str.BufAppend(cmdb2, shell_arg(scratch))
                    str.BufAppend(cmdb2, " -o ")
                    str.BufAppend(cmdb2, shell_arg(output))
                    // See the matching stack-size/weak-symbol comments on
                    // the other final-link command below (musl_tcc/--lto
                    // path) - this is the default (non-LTO) fast-path's own
                    // separate link step, added for the parallel-object-
                    // compile optimization that has no C-original
                    // counterpart, so it needs the same fixes independently.
                    if SALAM_OS_WINDOWS:
                        if use_tcc:
                            str.BufAppend(cmdb2, " -Wl,--stack=8388608")
                        else:
                            str.BufAppend(cmdb2, " -Wl,--allow-multiple-definition")
                        end
                    end
                    repeat objs.len() with oi2:
                        str.BufAppendChar(cmdb2, 32)
                        str.BufAppend(cmdb2, shell_arg(objs.get(oi2)))
                    end
                    str.BufAppend(cmdb2, lm)
                    // --libpath=DIR, same as the LLVM link path honors - so
                    // an archive that is not installed yet (a freshly built
                    // libsalam_llvm.a, say) is linkable through the C
                    // backend too, not only through LLVM. Before the -l
                    // flags: a static link only resolves backwards.
                    repeat opt.lib_paths.len() with lp2:
                        str.BufAppend(cmdb2, " -L")
                        str.BufAppend(cmdb2, shell_arg(opt.lib_paths.get(lp2)))
                    end
                    repeat links.len() with li2:
                        emit_link(cmdb2, lgr, links.get(li2), link_kinds.get(li2), use_tcc)
                    end
                    cmdtext2 := str.BufStr(cmdb2)
                    str.BufFree(cmdb2)
                    lg.Log(lgr, lg.PH_DRIVER, lg.LOG_INFO, "linking: " + cmdtext2)
                    _pt_lk2 := pf.Begin(pf.TP_LINK, output)
                    crc = proc_status(system(cmdtext2))
                    pf.End(pf.TP_LINK, _pt_lk2)
                    if crc != 0:
                        lg.Log(
                            lgr, lg.PH_DRIVER, lg.LOG_ERROR, co.Format2(
                                i18.Tr("C compiler '%s' failed (exit %d)"), co.ArgStr(opt.cc), co.ArgInt(crc as i64)
                            )
                        )
                        rc = 3
                    else:
                        lg.Log(lgr, lg.PH_DRIVER, lg.LOG_INFO, "built executable: " + output)
                        if str.Len(opt.exe_path) == 0:
                            opt.exe_path = output
                        end
                        if opt.command == CMD_BUILD:
                            _wm := write_build_manifest(scratch, build_signature(opt), w_path)
                        end
                    end
                end
                // Objects are the incremental build cache now: keeping them is
                // what lets the next build reuse unchanged modules. They live
                // in the gitignored scratch dir, and --force ignores them.
                objs.free()
            else:
                mut lto_flag := ""
                if optimizing_build && !use_tcc:
                    if SALAM_OS_WINDOWS:
                        if !str.Contains(opt.cc, "clang"):
                            lto_flag = " -flto"
                        end
                    else:
                        lto_flag = " -flto"
                    end
                end

                mut cmdb := str.NewBuilder()
                str.BufAppend(cmdb, opt.cc)
                if musl_tcc.active:
                    str.BufAppend(cmdb, " -B")
                    str.BufAppend(cmdb, shell_arg(musl_tcc.tcc_dir))
                    str.BufAppend(cmdb, " -nostdlib -static -I")
                    str.BufAppend(cmdb, shell_arg(musl_tcc.tcc_dir))
                    str.BufAppend(cmdb, "/include -I")
                    str.BufAppend(cmdb, shell_arg(musl_tcc.musl_dir))
                    str.BufAppend(cmdb, "/include -L")
                    str.BufAppend(cmdb, shell_arg(musl_tcc.musl_dir))
                    str.BufAppend(cmdb, "/lib")
                end
                str.BufAppend(cmdb, opt_flag)
                str.BufAppend(cmdb, alias_flag)
                str.BufAppend(cmdb, werror_flag)
                str.BufAppend(cmdb, lto_flag)
                str.BufAppend(cmdb, " -I. -I")
                str.BufAppend(cmdb, shell_arg(scratch))
                str.BufAppend(cmdb, " -o ")
                str.BufAppend(cmdb, shell_arg(output))
                // tcc's default linked stack (SizeOfStackReserve in the PE
                // header) is only 1MiB on this target - half of MinGW gcc's
                // 2MiB default - which is too little for the self-hosted
                // compiler's own recursive descent parser/semantic pass to
                // process its own (large, deeply nested) source: a
                // tcc-linked salam.exe building compiler/*.salam with
                // --cc=tcc reliably stack-overflows partway through
                // parsing, while the identical workload run from a
                // gcc-linked salam.exe (2MiB stack) does not. Confirmed via
                // objdump -p on minimal tcc output (SizeOfStackReserve
                // 0x100000) vs the same source built by gcc (0x200000), and
                // via a direct A/B: a tcc-linked self-hosted binary crashes
                // rebuilding itself; the same binary relinked with gcc
                // instead does not. -Wl,--stack tells tcc's linker to
                // reserve more (8MiB, matching common *nix default thread
                // stack sizes) regardless of which --cc built the binary
                // doing the *compiling*.
                if SALAM_OS_WINDOWS:
                    if use_tcc:
                        str.BufAppend(cmdb, " -Wl,--stack=8388608")
                    else:
                        // codegen.salam's per-module SALAM_OUT_DEFINED
                        // prelude marks salam_ob/salam_obn/salam_out_flush/
                        // salam_out_fini __attribute__((weak)) so every
                        // module can carry its own copy and the linker
                        // picks one - reliable on ELF, but on this
                        // MinGW/GCC + binutils combination weak *data*
                        // symbols (salam_ob/salam_obn) sometimes still
                        // collide: "multiple definition of
                        // `.weak.salam_ob.'" etc - reproduced building
                        // tests/*/general/web_router.salam (query.o vs
                        // url.o). tcc takes the plain non-weak fallback in
                        // that same prelude (guarded by
                        // `!defined(__TINYC__)`), so it never hits this.
                        str.BufAppend(cmdb, " -Wl,--allow-multiple-definition")
                    end
                end
                str.BufAppend(cmdb, dbg_flag2)
                str.BufAppend(cmdb, asan_flag)
                str.BufAppend(cmdb, link_defines)

                if musl_tcc.active:
                    str.BufAppendChar(cmdb, 32)
                    str.BufAppend(cmdb, shell_arg(musl_tcc.musl_dir + "/lib/crt1.o"))
                    str.BufAppendChar(cmdb, 32)
                    str.BufAppend(cmdb, shell_arg(musl_tcc.musl_dir + "/lib/crti.o"))
                end

                repeat cfiles.len() with ci:
                    str.BufAppendChar(cmdb, 32)
                    str.BufAppend(cmdb, shell_arg(cfiles.get(ci)))
                end
                str.BufAppend(cmdb, lm)

                // See the matching --libpath block on the parallel-object
                // link command above; driver/build.c does the same.
                repeat opt.lib_paths.len() with lp2b:
                    str.BufAppend(cmdb, " -L")
                    str.BufAppend(cmdb, shell_arg(opt.lib_paths.get(lp2b)))
                end

                repeat links.len() with li2b:
                    emit_link(cmdb, lgr, links.get(li2b), link_kinds.get(li2b), use_tcc)
                end

                if musl_tcc.active:
                    libgcc := musl_tcc.musl_dir + "/lib/libgcc.a"
                    str.BufAppend(cmdb, " -lc ")
                    str.BufAppend(cmdb, shell_arg(libgcc))
                    str.BufAppendChar(cmdb, 32)
                    libtcc1 := musl_tcc.tcc_dir + "/libtcc1.a"
                    str.BufAppend(cmdb, shell_arg(libtcc1))
                    str.BufAppend(cmdb, " -lc ")
                    str.BufAppend(cmdb, shell_arg(libgcc))
                    crtn := musl_tcc.musl_dir + "/lib/crtn.o"
                    str.BufAppendChar(cmdb, 32)
                    str.BufAppend(cmdb, shell_arg(crtn))
                end

                cmdtext := str.BufStr(cmdb)
                str.BufFree(cmdb)
                lg.Log(lgr, lg.PH_DRIVER, lg.LOG_INFO, "linking: " + cmdtext)
                _pt_lk := pf.Begin(pf.TP_LINK, output)
                crc = proc_status(system(cmdtext))
                pf.End(pf.TP_LINK, _pt_lk)
                if crc != 0:
                    lg.Log(
                        lgr, lg.PH_DRIVER, lg.LOG_ERROR, co.Format2(
                            i18.Tr("C compiler '%s' failed (exit %d)"), co.ArgStr(opt.cc), co.ArgInt(crc as i64)
                        )
                    )
                    rc = 3
                else:
                    lg.Log(lgr, lg.PH_DRIVER, lg.LOG_INFO, "built executable: " + output)
                    if str.Len(opt.exe_path) == 0:
                        opt.exe_path = output
                    end
                    if opt.command == CMD_BUILD:
                        _wm2 := write_build_manifest(scratch, build_signature(opt), w_path)
                    end
                end
            end
        end

        // The generated .c/.h are the object cache's key: deleting them would
        // make every module look changed on the next build, so they stay in the
        // gitignored scratch dir regardless of --keep-c.
        if opt.keep_c:
            lg.Log(lgr, lg.PH_DRIVER, lg.LOG_INFO, "kept generated C files")
        end
        ret rc
    end

    // ===== driver/driver.c =====
