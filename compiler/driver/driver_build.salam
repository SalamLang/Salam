package driver

import os
import io
import str
import os.shell

include pth "../sal_path.salam"
include tok "../token.salam"
include src "../source.salam"
include lg "../logger.salam"
include at "../ast.salam"
include i18 "../i18n.salam"
include lp "../langpack.salam"
include sm "../semantic/semantic.salam"
include cg "../codegen/codegen.salam"
include co "../sal_core.salam"
include pm "../pkgmgr/pkgmgr.salam"
include pf "../prof_self.salam"
include lv "../llvmgen/llvmgen.salam"

func cc_is_bare_name(name: str): bool:
    if str.Len(name) == 0:
        ret false
    end
    if str.Contains(name, " "):
        ret false
    end
    if str.Contains(name, "/"):
        ret false
    end
    if str.Contains(name, "\\"):
        ret false
    end
    ret true
end

if SALAM_OS_MAC:
    func cc_assumes_finite_loops(cc: str, not_tcc: bool): bool: ret not_tcc or str.Contains(cc, "clang") end
else:
    func cc_assumes_finite_loops(cc: str, not_tcc: bool): bool: ret not_tcc and str.Contains(cc, "clang") end
end

func cc_debug_flag(opt &: Dr): str:
    if opt.dwarf_version > 0:
        ret " -gdwarf-" + str.FromInt(opt.dwarf_version as i64)
    end
    ret " -g"
end

func target_is_freestanding(triple: str): bool:
    if str.Len(triple) == 0:
        ret false
    end
    ret str.Contains(triple, "uefi") or str.Contains(triple, "salamos") or str.Contains(triple, "-none")
end

func win_from_project(opt &: Dr, pinfo: pm.PkgInfo, rdir: str):
    if str.Len(opt.win_subsystem) == 0:
        opt.win_subsystem = pinfo.win_subsystem
    end
    if str.Len(opt.win_icon) == 0 and str.Len(pinfo.win_icon) > 0:
        opt.win_icon = pth.PathIsAbs(pinfo.win_icon) ? pinfo.win_icon : pth.PathJoin(rdir, pinfo.win_icon)
    end
    if str.Len(opt.win_manifest) == 0 and str.Len(pinfo.win_manifest) > 0:
        opt.win_manifest = pth.PathIsAbs(pinfo.win_manifest) ? pinfo.win_manifest : pth.PathJoin(rdir, pinfo.win_manifest)
    end
    if pinfo.win_version.Len() == 0:
        ret
    end
    mut vs := Vector {} as Vector<str>
    mut has_ver := false
    each kv in pinfo.win_version:
        vs.Push(kv)
        has_ver = has_ver or str.StartsWith(kv, "version=")
    end
    if not has_ver and str.Len(pinfo.version) > 0:
        vs.Push("version=" + pinfo.version)
    end
    each kv2 in opt.win_version:
        vs.Push(kv2)
    end
    opt.win_version = vs
end

func protect_binary(lgr: lg.Logger, opt &: Dr, output: str):
    if not opt.protect or str.Len(opt.lib_kind) > 0:
        ret
    end
    mut sp := ""
    if not sm.FindPathTool("strip", sp):
        lg.Log(
            lgr, lg.PH_DRIVER, lg.LOG_WARN, i18.Tr("--protect: 'strip' not found; the executable keeps its symbol names (install binutils, or use a build without --protect)")
        )
        ret
    end
    mut cmd := ""
    if SALAM_OS_MAC:
        cmd = shell_arg(sp) + " " + shell_arg(output)
    else:
        cmd = shell_arg(sp) + " --strip-all " + shell_arg(output)
    end
    if shell.System(cmd) != 0:
        lg.Log(
            lgr, lg.PH_DRIVER, lg.LOG_WARN, i18.Tr("--protect: could not strip the symbol names from the executable")
        )
        ret
    end
    if SALAM_OS_MAC:
        mut cs := ""
        if sm.FindPathTool("codesign", cs):
            _r_cs := shell.System(shell_arg(cs) + " --force --sign - " + shell_arg(output) + " >/dev/null 2>&1")
        end
    end
end

func build_impl(opt &: Dr): int:
    mut lib_stem := ""
    mut lib_export_pub := false
    if opt.inputs.Len() == 0 or (opt.inputs.Len() == 1 and os.IsDir(opt.inputs.Get(0))):
        rlgr := lg.New(opt.log_level, resolve_color(opt.color))
        rpack := lp.Load(opt.lang)
        if rpack == lp.LP_NONE:
            lg.Log(
                rlgr, lg.PH_DRIVER, lg.LOG_ERROR, co.Format1(i18.Tr("unknown language pack '%s'"), co.ArgStr(opt.lang))
            )
            ret 2
        end
        mut rdir := "."
        if opt.inputs.Len() == 1:
            rdir = opt.inputs.Get(0)
        end
        mut pinfo := pm.PkgInfo {}
        _pi := pm.ReadPackageInfo(rdir, pinfo)
        if str.Equals(pinfo.kind, "lib") and str.Len(opt.lib_kind) == 0 and opt.command == CMD_BUILD:
            opt.lib_kind = "shared"
        end
        mut first := ""
        if str.Len(opt.lib_kind) > 0 and str.Len(project_entry_file(rdir)) > 0:
            first = project_entry_file(rdir)
        else:
            first = resolve_dir_entry(rlgr, rpack, rdir)
        end
        if str.Len(first) == 0:
            ret 2
        end
        if opt.inputs.Len() == 0:
            opt.inputs.Push(first)
        else:
            opt.inputs.Set(0, first)
        end
        opt.input = first
        mut pname := pinfo.name
        if str.Len(pname) == 0 or str.Contains(pname, "/") or str.Contains(pname, "\\"):
            pname = project_output_name(rdir)
        end
        lib_export_pub = pinfo.export_pub
        win_from_project(opt, pinfo, rdir)
        if str.Len(opt.lib_kind) > 0:
            lib_stem = pname
            opt.lib_name = pname
        else str.Len(opt.output) == 0 and opt.command != CMD_OBJ:
            opt.output = pname
        end
    end

    if str.Len(opt.input) == 0 and opt.inputs.Len() > 0:
        opt.input = opt.inputs.Get(0)
    end

    werr := win_settings(opt)
    if str.Len(werr) > 0:
        io.EPrintln("salam: " + werr)
        ret 2
    end
    if win_settings_used() and not str.Equals(opt.backend, "native") and not str.Equals(linker_mode(opt), "builtin") and not (str.Equals(opt.backend, "auto") and native_by_default()):
        io.EPrintln(i18.Tr("salam: warning: --subsystem, --icon, --manifest and --version-info only apply to Windows builds with --backend=native or --linker=builtin"))
    end

    if mac_is_universal(opt.llvm_target):
        ret mac_universal_build(opt)
    end

    if str.Len(opt.lib_kind) > 0 and not str.Equals(opt.backend, "c"):
        llvm_lib := not lib_export_pub and (str.Equals(opt.backend, "llvm") or str.Equals(opt.backend, "native") or (str.Len(opt.llvm_target) > 0 and not opt.cc_explicit))
        if llvm_lib:
            ret LlvmBuild(opt)
        end
        opt.backend = "c"
    end

    if str.Len(opt.llvm_target) > 0 and not str.Equals(opt.backend, "c"):
        ret LlvmBuild(opt)
    end
    if str.Len(opt.llvm_target) > 0 and target_is_freestanding(opt.llvm_target):
        io.EPrintln(i18.Tr("salam: freestanding targets need the LLVM backend; remove --backend=c"))
        ret 2
    end

    if str.Equals(opt.backend, "auto") and native_by_default():
        opt.backend = "native"
    end

    if str.Equals(opt.backend, "native"):
        ret LlvmBuild(opt)
    end

    if use_llvm_backend(opt):
        lrc := LlvmBuild(opt)
        if lrc != RC_LLVM_UNSUPPORTED and lrc != RC_LLVM_LINK_FAILED:
            ret lrc
        end
        if str.Equals(opt.backend, "llvm"):
            ret lrc
        end
        io.EPrintln(
            i18.Tr(
                "salam: falling back to the C backend for this file (build with --backend=llvm to make this an error)"
            )
        )
    end

    mut lgr := lg.New(opt.log_level, resolve_color(opt.color))
    mut rc := 0
    scratch := scratch_dir()

    pack := lp.Load(opt.lang)
    if pack == lp.LP_NONE:
        lg.Log(
            lgr, lg.PH_DRIVER, lg.LOG_ERROR, co.Format1(i18.Tr("unknown language pack '%s'"), co.ArgStr(opt.lang))
        )
        ret 2
    end
    build_sig := build_signature(opt) + "|" + co.VERSION + "|" + co.GIT_COMMIT + co.GIT_DIRTY
    if opt.command == CMD_BUILD and not opt.force and str.Len(opt.lib_kind) == 0:
        predicted_name := str.Len(opt.output) > 0 ? opt.output : output_stem_of(opt.inputs.Get(0))
        predicted_output := exe_name_for(predicted_name, opt.llvm_target)
        if build_up_to_date(scratch, build_sig, predicted_output):
            lg.Log(lgr, lg.PH_DRIVER, lg.LOG_INFO, "up to date: " + predicted_output)
            if str.Len(opt.exe_path) == 0:
                opt.exe_path = predicted_output
            end
            ret 0
        end
    end

    sm.SetStdlibRoot(opt.stdlib_path)
    sm.LayoutSchemaInit(opt.stdlib_path)

    mut export_names := Vector {} as Vector<str>
    mut export_cnames := Vector {} as Vector<str>
    defer export_names.Free()
    defer export_cnames.Free()
    repeat opt.exports.Len() in exi:
        spec := opt.exports.Get(exi)
        colon := str.IndexOf(spec, ":")
        if colon <= 0 or colon >= str.Len(spec) - 1:
            lg.Log(
                lgr, lg.PH_DRIVER, lg.LOG_ERROR, co.Format1(i18.Tr("invalid --export value '%s' (want Fn:CName)"), co.ArgStr(spec))
            )
            ret 2
        end
        fname := str.Substr(spec, 0, colon)
        cname := str.Substr(spec, colon + 1, str.Len(spec) - colon - 1)
        export_names.Push(fname)
        export_cnames.Push(cname)
    end

    mut musl_tcc := MuslTcc {}
    mut resolved := ""
    mut bundled := false
    mut found := false
    if not opt.cc_explicit and str.Equals(opt.cc, "tcc"):
        ladder := ["clang", "gcc", "tcc", "cc"]
        repeat ladder.Len() in i:
            if not found:
                found = sm.FindBundledTool(ladder[i], resolved)
                bundled = found
            end
        end
        repeat ladder.Len() in j:
            if not found:
                found = sm.FindPathTool(ladder[j], resolved)
                bundled = false
            end
        end
    else opt.cc_explicit and cc_is_bare_name(opt.cc):
        found = sm.FindBundledTool(opt.cc, resolved)
        bundled = found
        if not found:
            found = sm.FindPathTool(opt.cc, resolved)
            bundled = false
        end
        if not found:
            found = sm.FindPathTool("cc", resolved)
            bundled = false
        end
    else:
        found = sm.FindPathTool("cc", resolved)
        bundled = false
    end
    if found:
        mut origin := "host"
        if bundled:
            origin = "bundled"
        end
        lg.Log(lgr, lg.PH_DRIVER, lg.LOG_INFO, "using " + origin + " C compiler: " + resolved)
        if SALAM_OS_WINDOWS:
            musl_tcc = MuslTcc {}
        else:
            if bundled:
                musl_tcc = detect_bundled_musl_tcc(resolved)
                if musl_tcc.active:
                    lg.Log(lgr, lg.PH_DRIVER, lg.LOG_INFO, "using bundled musl sysroot: " + musl_tcc.musl_dir)
                end
            end
        end
        if str.Contains(resolved, " "):
            opt.cc = "\"" + resolved + "\""
        else:
            opt.cc = resolved
        end
    end

    mut cfiles := Vector {} as Vector<str>
    mut generated := Vector {} as Vector<str>
    mut cdirty := Vector {} as Vector<int>
    defer cfiles.Free()
    defer generated.Free()
    defer cdirty.Free()
    mut first_module := ""
    mut all_ok := true
    mut failed_files := Vector {} as Vector<str>
    defer failed_files.Free()

    entry := lp.Entry(pack)
    mut has_entry := false

    mut links := Vector {} as Vector<str>
    mut link_kinds := Vector {} as Vector<str>
    defer links.Free()
    defer link_kinds.Free()
    mut lib_exports := Vector {} as Vector<str>
    mut lib_params := Vector {} as Vector<str>
    defer lib_exports.Free()
    defer lib_params.Free()
    if str.Len(opt.llvm_target) > 0:
        pm.SetNativePlatform(pm.PlatformOfTriple(opt.llvm_target))
    end

    mut hostlibs := ""
    if EmbeddedExtralibs("", hostlibs):
        opt.lib_paths.Push(hostlibs)
        lg.Log(lgr, lg.PH_DRIVER, lg.LOG_INFO, "using embedded static third-party libs: " + hostlibs)
    end

    mut defs := Vector {} as Vector<str>
    defer defs.Free()
    front_defs(opt, defs)
    use_tcc := str.Contains(opt.cc, "tcc")
    mut cc_def := "SALAM_CC_GCC"
    if use_tcc:
        cc_def = "SALAM_CC_TCC"
    else str.Contains(opt.cc, "clang"):
        cc_def = "SALAM_CC_CLANG"
    end
    defs.Push(cc_def)

    mut work := Vector {} as Vector<str>
    defer work.Free()
    repeat opt.inputs.Len() in ii:
        work.Push(opt.inputs.Get(ii))
    end
    memp := sm.ResolveImport("", "mem")
    if str.Len(memp) > 0 and os.Exists(memp):
        work.Push(memp)
    end
    corep := sm.ResolveImport("", "core")
    if str.Len(corep) > 0 and os.Exists(corep):
        work.Push(corep)
    end

    if opt.inputs.Len() > 0:
        sm.SetProjectRootFrom(opt.inputs.Get(0))
    end
    defer sm.UnpinProjectRoot()
    mut a := at.NewAst()
    mut s := sm.New(lgr, "", "en")
    mut w_global := Vector {} as Vector<int>
    mut w_prog := Vector {} as Vector<int>
    mut w_module := Vector {} as Vector<str>
    mut w_entry := Vector {} as Vector<str>
    mut w_pkg := Vector {} as Vector<str>
    mut w_path := Vector {} as Vector<str>
    defer w_global.Free()
    defer w_prog.Free()
    defer w_module.Free()
    defer w_entry.Free()
    defer w_pkg.Free()
    defer w_path.Free()

    sm.DceReset()
    sm.DceEnable()

    mut wi := 0
    until wi < work.Len():
        path := work.Get(wi)
        mut dup := false
        repeat wi in j:
            if str.Equals(work.Get(j), path):
                dup = true
            end
        end
        if dup:
            wi++
            continue
        end

        mut fm := FrontModule {}
        sok := front_module(opt, lgr, s, a, pack, defs, path, true, failed_files, all_ok, fm)
        if not sok:
            wi++
            continue
        end
        modpack := fm.pack
        modentry := lp.Entry(modpack)
        prog := fm.prog
        gscope := fm.gscope
        module := module_of(path)
        if str.Len(first_module) == 0:
            first_module = module
        end

        prog_n := at.Get(a, prog)
        modpkg := str.Len(prog_n.name) > 0 ? prog_n.name : "main"
        if wi == 0:
            cg.SetRootPackage(modpkg)
        end
        repeat prog_n.list.Len() in di3:
            d := at.Get(a, prog_n.list.Get(di3))
            if d.kind == at.AST_FUNC_DEF and str.Equals(d.name, modentry):
                has_entry = true
                sm.DceMarkRoot(modpkg, modentry)
                break
            end
        end
        if wi == 0 and str.Len(opt.lib_kind) > 0 and lib_export_pub:
            mut cprefix := lib_c_prefix(lib_stem)
            if str.Len(cprefix) == 0:
                cprefix = lib_c_prefix(output_stem_of(path))
            end
            repeat prog_n.list.Len() in dpx:
                d6 := at.Get(a, prog_n.list.Get(dpx))
                if d6.kind == at.AST_FUNC_DEF and d6.is_pub and not d6.is_extern and d6.a != 0:
                    cname := cprefix + "_" + d6.name
                    sm.DceMarkRoot(modpkg, d6.name)
                    cg.AddExportOverride(modpkg, d6.name, cname)
                    lib_exports.Push(cname)
                    lib_params.Push(lib_param_names(a, d6))
                end
            end
        end
        if wi == 0 and str.Len(opt.lib_kind) > 0:
            repeat prog_n.list.Len() in dlx:
                d5 := at.Get(a, prog_n.list.Get(dlx))
                if d5.kind == at.AST_FUNC_DEF and d5.is_extern and d5.a != 0:
                    sm.DceMarkRoot(modpkg, d5.name)
                    lib_exports.Push(d5.name)
                    lib_params.Push(lib_param_names(a, d5))
                end
            end
            repeat export_cnames.Len() in ecx:
                lib_exports.Push(export_cnames.Get(ecx))
                lib_params.Push(lib_func_param_names(a, prog, export_names.Get(ecx)))
            end
        end
        if wi == 0 and export_names.Len() > 0:
            repeat prog_n.list.Len() in di3x:
                d4 := at.Get(a, prog_n.list.Get(di3x))
                if d4.kind == at.AST_FUNC_DEF:
                    repeat export_names.Len() in exj:
                        if str.Equals(d4.name, export_names.Get(exj)):
                            sm.DceMarkRoot(modpkg, d4.name)
                            cg.AddExportOverride(modpkg, d4.name, export_cnames.Get(exj))
                        end
                    end
                end
            end
        end

        idir := dir_of(path)
        repeat prog_n.list.Len() in di4:
            did := prog_n.list.Get(di4)
            d2 := at.Get(a, did)
            if d2.kind == at.AST_LINK:
                if d2.value_kind == tok.TV_STRING and str.Len(d2.value_str) > 0:
                    mut seen := false
                    repeat links.Len() in lj:
                        if str.Equals(links.Get(lj), d2.value_str):
                            seen = true
                        end
                    end
                    if not seen:
                        if not native_prepare(lgr, idir, d2.value_str, d2.name, opt.cc):
                            ret 2
                        end
                        link_kinds.Push(d2.name)
                        links.Push(d2.value_str)
                        def := link_define(d2.value_str)
                        mut dseen := false
                        repeat defs.Len() in dj:
                            if str.Equals(defs.Get(dj), def):
                                dseen = true
                            end
                        end
                        if not dseen:
                            defs.Push(def)
                        end
                    end
                end
                continue
            end
            if d2.kind != at.AST_IMPORT:
                continue
            end
            mut ipath := d2.type_str
            if str.Len(ipath) == 0:
                ipath = sm.ResolveImportNode(a, idir, did, lp.Code(modpack))
            end
            if str.Len(ipath) == 0:
                continue
            end
            ipath = pth.PathNormalize(ipath)
            mut known := false
            repeat work.Len() in wj:
                if str.Equals(work.Get(wj), ipath):
                    known = true
                end
            end
            if not known:
                work.Push(ipath)
            end
        end

        w_global.Push(gscope)
        w_prog.Push(prog)
        w_module.Push(module)
        w_entry.Push(modentry)
        w_pkg.Push(modpkg)
        w_path.Push(path)
        wi++
    end

    if not front_claims(lgr, w_pkg, w_module, w_path):
        all_ok = false
    end

    sm.DceFinish()

    mut cg_status := Vector {} as Vector<int>
    emit_modules(lgr, s, a, opt, scratch, w_global, w_prog, w_module, w_entry, w_pkg, w_path, cg_status)
    mut header_changed := false
    repeat w_prog.Len() in bi:
        cpath := mod_c_path(scratch, w_module.Get(bi))
        hpath := mod_h_path(scratch, w_module.Get(bi))
        st := cg_status.Get(bi)
        if st < 0:
            all_ok = false
            failed_files.Push(w_path.Get(bi))
        else:
            cfiles.Push(cpath)
            cdirty.Push(st)
            if st == 2:
                header_changed = true
            end
            generated.Push(cpath)
            generated.Push(hpath)
        end
    end
    cg_status.Free()
    if header_changed:
        repeat cdirty.Len() in hd:
            cdirty.Set(hd, 1)
        end
    end
    sm.Free(s)
    at.FreeAst(a)

    if not all_ok:
        lg.Log(
            lgr, lg.PH_DRIVER, lg.LOG_ERROR, abort_message(i18.Tr("build aborted: errors in source"), failed_files)
        )
        if not opt.keep_temp:
            repeat generated.Len() in gi1:
                _rm1 := os.Remove(generated.Get(gi1))
            end
        end
        ret 1
    end

    needs_entry := opt.command != CMD_OBJ and str.Len(opt.lib_kind) == 0 and not target_is_freestanding(opt.llvm_target)
    if needs_entry and not has_entry:
        lg.Log(
            lgr, lg.PH_DRIVER, lg.LOG_ERROR, co.Format1(
                i18.Tr("no entry point: define a '%s' function"), co.ArgStr(entry)
            )
        )
        if not opt.keep_temp:
            repeat generated.Len() in gi2:
                _rm2 := os.Remove(generated.Get(gi2))
            end
        end
        ret 1
    end

    if opt.emit_c:
        ret 0

    mut cc_probe := ""
    if not sm.FindBundledTool(opt.cc, cc_probe) and not sm.FindPathTool(opt.cc, cc_probe):
        mut bare_cc := opt.cc
        if str.StartsWith(bare_cc, "\"") and str.EndsWith(bare_cc, "\"") and str.Len(bare_cc) > 2:
            bare_cc = str.Substr(bare_cc, 1, str.Len(bare_cc) - 2)
        end
        if str.Len(bare_cc) == 0 or (cc_is_bare_name(bare_cc) and not sm.FindPathTool(bare_cc, cc_probe)):
            lg.Log(lgr, lg.PH_DRIVER, lg.LOG_WARN, "no C compiler found on PATH; Salam will try the built-in linker for linking when object files are available, but compiling C output still requires a C compiler (install gcc/clang/tcc or a bundled toolchain)")
        end
    end

    if str.Len(opt.lib_kind) > 0 and opt.command != CMD_OBJ:
        if musl_tcc.active:
            io.EPrintln(i18.Tr("salam: --lib needs a host C compiler; pass --cc=gcc or --cc=clang"))
            ret 2
        end
        initc := scratch + "/salam_lib_init.c"
        if os.WriteFile(initc, lib_init_source(mod_h_path(scratch, first_module))) < 0:
            io.EPrintln(co.Format1(i18.Tr("salam: cannot write '%s'"), co.ArgStr(initc)))
            ret 2
        end
        cfiles.Push(initc)
        cdirty.Push(1)
    end

    mut crc := 0
    no_tcc_opt := not str.Contains(opt.cc, "tcc")
    no_o_flag := not str.Contains(opt.cc, "-O")
    rel_opt := opt.safe ? " -O2" : " -O3"
    opt_flag := (not opt.debug_info and not opt.asan and no_tcc_opt and no_o_flag) ? rel_opt : ""
    finite_flag := cc_assumes_finite_loops(opt.cc, no_tcc_opt) ? " -fno-finite-loops" : ""
    alias_flag := no_tcc_opt ? " -fno-strict-aliasing -fwrapv" + finite_flag : ""
    quiet_flag := " -Wno-div-by-zero -Wno-deprecated-declarations"
    werror_flag := (str.Equals(os.Env("SALAM_C_STRICT"), "1") ? " -Werror" : "") + quiet_flag
    no_o0 := not str.Contains(opt.cc, "-O0")
    optimizing_build := not opt.debug_info and not opt.asan and no_tcc_opt and no_o0

    if opt.command == CMD_OBJ:
        dbg_flag := (opt.debug_info and no_tcc_opt) ? cc_debug_flag(opt) : ""
        mut oi := 0
        until oi < cfiles.Len() and crc == 0:
            cf := cfiles.Get(oi)
            obj := str.Substr(cf, 0, str.Len(cf) - 2) + ".o"
            mut cmdb := str.NewBuilder()
            str.BufAppend(cmdb, opt.cc)
            if musl_tcc.active:
                str.BufAppend(cmdb, " -B")
                str.BufAppend(cmdb, shell_arg(musl_tcc.tcc_dir))
                str.BufAppend(cmdb, " -I")
                str.BufAppend(cmdb, shell_arg(musl_tcc.tcc_dir))
                str.BufAppend(cmdb, "/include -I")
                str.BufAppend(cmdb, shell_arg(musl_tcc.musl_dir))
                str.BufAppend(cmdb, "/include")
            end
            str.BufAppend(cmdb, " -c -I. -I")
            str.BufAppend(cmdb, shell_arg(scratch))
            str.BufAppend(cmdb, opt_flag)
            str.BufAppend(cmdb, alias_flag)
            str.BufAppend(cmdb, werror_flag)
            str.BufAppend(cmdb, dbg_flag)
            str.BufAppendChar(cmdb, 32)
            str.BufAppend(cmdb, shell_arg(cf))
            str.BufAppend(cmdb, " -o ")
            str.BufAppend(cmdb, shell_arg(obj))
            cmdtext := str.BufStr(cmdb)
            str.BufFree(cmdb)
            lg.Log(lgr, lg.PH_DRIVER, lg.LOG_INFO, "assembling: " + cmdtext)
            crc = shell.System(cmdtext)
            oi++
        end
        if crc != 0:
            lg.Log(
                lgr, lg.PH_DRIVER, lg.LOG_ERROR, co.Format2(
                    i18.Tr("C compiler '%s' failed (exit %d)"), co.ArgStr(opt.cc), co.ArgInt(crc as i64)
                )
            )
            rc = 3
        else:
            lg.Log(lgr, lg.PH_DRIVER, lg.LOG_INFO, "produced object files (.o)")
        end
    else:
        mut output := opt.output
        if str.Len(output) == 0:
            output = output_stem_of(opt.inputs.Get(0))
        end
        output = exe_name_for(output, opt.llvm_target)
        is_lib := str.Len(opt.lib_kind) > 0
        if is_lib:
            mut stem := lib_stem
            if str.Len(stem) == 0:
                stem = output_stem_of(opt.inputs.Get(0))
            end
            lib_stem = stem
            output = lib_output_name(opt, stem)
        end
        pic_flag := (str.Equals(opt.lib_kind, "shared") and not lib_targets_windows(opt)) ? " -fPIC" : ""
        mut lm := " -lm"
        if SALAM_OS_WINDOWS:
            if use_tcc:
                lm = " -lmsvcrt"
            else str.Contains(opt.cc, "clang"):
                lm = ""
            else:
                lm = " -lm"
            end
        else:
            lm = " -lm"
        end

        if opt.debug_info and use_tcc:
            lg.Log(
                lgr, lg.PH_DRIVER, lg.LOG_WARN, i18.Tr("tcc has limited debug-symbol support; prefer --cc=gcc or --cc=clang with -g")
            )
        end
        dbg_flag2 := (opt.debug_info and no_tcc_opt) ? cc_debug_flag(opt) : ""

        mut asan_flag := ""
        if opt.asan:
            if use_tcc:
                lg.Log(
                    lgr, lg.PH_DRIVER, lg.LOG_ERROR, i18.Tr("tcc does not support AddressSanitizer; use --cc=gcc or --cc=clang")
                )
                if not opt.keep_temp:
                    repeat generated.Len() in gi3:
                        _rm3 := os.Remove(generated.Get(gi3))
                    end
                end
                ret 2
            end
            asan_flag = " -fsanitize=address -fno-omit-frame-pointer -DSALAM_MEM_DEBUG"
        end

        mut link_defines := ""
        repeat links.Len() in li:
            link_defines = link_defines + " -DSALAM_LINK_" + sanitize_ident(links.Get(li))
        end

        if (not opt.lto or is_lib) and not musl_tcc.active:
            mut objs := Vector {} as Vector<str>
            mut jobs := Vector {} as Vector<str>
            mut job_sizes := Vector {} as Vector<i64>
            sigpath := scratch + "/salam_build.flags"
            sigtext := opt.cc + " " + opt_flag + pic_flag + " " + alias_flag + " " + dbg_flag2 + " " + asan_flag + " " + link_defines
            mut sig_pending := false
            if not file_unchanged(sigpath, sigtext):
                repeat cfiles.Len() in cd0:
                    cdirty.Set(cd0, 1)
                end
                sig_pending = true
            end
            repeat cfiles.Len() in ci2:
                cf2 := cfiles.Get(ci2)
                obj2 := str.Substr(cf2, 0, str.Len(cf2) - 2) + ".o"
                objs.Push(obj2)
                if cdirty.Get(ci2) == 0:
                    continue
                end
                mut jb := str.NewBuilder()
                str.BufAppend(jb, opt.cc)
                str.BufAppend(jb, " -c -I. -I")
                str.BufAppend(jb, shell_arg(scratch))
                str.BufAppend(jb, opt_flag)
                str.BufAppend(jb, pic_flag)
                str.BufAppend(jb, alias_flag)
                str.BufAppend(jb, werror_flag)
                str.BufAppend(jb, dbg_flag2)
                str.BufAppend(jb, asan_flag)
                str.BufAppend(jb, link_defines)
                str.BufAppendChar(jb, 32)
                str.BufAppend(jb, shell_arg(cf2))
                str.BufAppend(jb, " -o ")
                str.BufAppend(jb, shell_arg(obj2))
                jobs.Push(str.BufStr(jb))
                job_sizes.Push(os.FileSize(cf2))
                str.BufFree(jb)
            end
            lg.Log(
                lgr, lg.PH_DRIVER, lg.LOG_INFO, "compiling " + str.FromInt(jobs.Len() as i64) + " object file" + plural_suffix(jobs.Len()) + " in parallel, reused " + str.FromInt((cfiles.Len() - jobs.Len()) as i64) + " cached object" + plural_suffix(cfiles.Len() - jobs.Len())
            )
            _pt_cc := pf.Begin(pf.TP_CC, "")
            crc = compile_parallel(jobs, job_sizes)
            pf.End(pf.TP_CC, _pt_cc)
            pf.Count(pf.TC_MODULES_BUILT, jobs.Len() as i64)
            pf.Count(pf.TC_MODULES_CACHED, (cfiles.Len() - jobs.Len()) as i64)
            jobs.Free()
            job_sizes.Free()
            if crc != 0:
                lg.Log(
                    lgr, lg.PH_DRIVER, lg.LOG_ERROR, co.Format2(
                        i18.Tr("C compiler '%s' failed (exit %d)"), co.ArgStr(opt.cc), co.ArgInt(crc as i64)
                    )
                )
                rc = 3
            else:
                if sig_pending:
                    _wsig := write_file(lgr, sigpath, sigtext)
                end
                mut cmdtext2 := ""
                if str.Equals(opt.lib_kind, "static"):
                    _rmold := os.Remove(output)
                    cmdtext2 = lib_archive_cmd(opt, use_tcc, output, objs, links)
                else:
                    mut cmdb2 := str.NewBuilder()
                    str.BufAppend(cmdb2, is_lib ? lib_linker(opt) : opt.cc)
                    str.BufAppend(cmdb2, asan_flag)
                    if is_lib:
                        str.BufAppend(cmdb2, lib_link_flags(opt, output, lib_stem))
                    end
                    str.BufAppend(cmdb2, " -I. -I")
                    str.BufAppend(cmdb2, shell_arg(scratch))
                    str.BufAppend(cmdb2, " -o ")
                    str.BufAppend(cmdb2, shell_arg(output))
                    if SALAM_OS_WINDOWS and not is_lib:
                        str.BufAppend(cmdb2, " -Wl,--stack=8388608")
                        if not use_tcc:
                            str.BufAppend(cmdb2, " -Wl,--allow-multiple-definition")
                        end
                    end
                    repeat objs.Len() in oi2:
                        str.BufAppendChar(cmdb2, 32)
                        str.BufAppend(cmdb2, shell_arg(objs.Get(oi2)))
                    end
                    str.BufAppend(cmdb2, lm)
                    repeat opt.lib_paths.Len() in lp2:
                        str.BufAppend(cmdb2, " -L")
                        str.BufAppend(cmdb2, shell_arg(opt.lib_paths.Get(lp2)))
                    end
                    repeat links.Len() in li2:
                        emit_link(cmdb2, lgr, links.Get(li2), link_kinds.Get(li2), use_tcc)
                    end
                    cmdtext2 = str.BufStr(cmdb2)
                    str.BufFree(cmdb2)
                end
                lg.Log(lgr, lg.PH_DRIVER, lg.LOG_INFO, "linking: " + cmdtext2)
                _pt_lk2 := pf.Begin(pf.TP_LINK, output)
                crc = shell.System(cmdtext2)
                pf.End(pf.TP_LINK, _pt_lk2)
                if crc != 0 and not is_lib and objs.Len() > 0:
                    mut lo := lv.Options {}
                    lo.link_libs = links
                    lo.link_kinds = link_kinds
                    lo.lib_paths = opt.lib_paths
                    lo.sysroot = ""
                    lo.target_triple = opt.llvm_target
                    if objs.Len() > 1:
                        mut eo := Vector {} as Vector<str>
                        repeat objs.Len() - 1 in ei:
                            eo.Push(objs.Get(ei + 1))
                        end
                        lo.extra_objects = eo
                    end
                    lg.Log(lgr, lg.PH_DRIVER, lg.LOG_WARN, "system linker unavailable or failed, trying built-in linker fallback: " + cmdtext2)
                    brc := builtin_link_mode(lgr, objs.Get(0), output, opt.llvm_target, lo, "builtin")
                    if brc == 0:
                        crc = 0
                    end
                end
                if crc != 0:
                    lg.Log(
                        lgr, lg.PH_DRIVER, lg.LOG_ERROR, co.Format2(
                            i18.Tr("C compiler '%s' failed (exit %d)"), co.ArgStr(opt.cc), co.ArgInt(crc as i64)
                        )
                    )
                    rc = 3
                else is_lib:
                    hdr := pth.PathJoin(pth.PathDir(output), lib_stem + ".h")
                    _wh := write_lib_header(hdr, lib_header_guard(lib_stem), cfiles, lib_exports, lib_params)
                    if str.Equals(opt.lib_kind, "shared") and lib_targets_windows(opt):
                        implib := lib_write_msvc_import(opt, output, lib_stem, lib_exports)
                        if str.Len(implib) > 0:
                            lg.Log(lgr, lg.PH_DRIVER, lg.LOG_INFO, "MSVC import: " + implib)
                        end
                    end
                    lg.Log(lgr, lg.PH_DRIVER, lg.LOG_INFO, "built library: " + output + " (header: " + hdr + ")")
                    println co.Format2(i18.Tr("built %s and %s"), co.ArgStr(output), co.ArgStr(hdr))
                else:
                    lg.Log(lgr, lg.PH_DRIVER, lg.LOG_INFO, "built executable: " + output)
                    if str.Len(opt.exe_path) == 0:
                        opt.exe_path = output
                    end
                    protect_binary(lgr, opt, output)
                    if opt.command == CMD_BUILD:
                        _wm := write_build_manifest(scratch, build_sig, src.LoadedPaths())
                    end
                end
            end
            objs.Free()
        else:
            mut lto_flag := ""
            if optimizing_build and not use_tcc:
                if SALAM_OS_WINDOWS:
                    if not str.Contains(opt.cc, "clang"):
                        lto_flag = " -flto"
                    end
                else:
                    lto_flag = " -flto"
                end
            end

            mut cmdb := str.NewBuilder()
            str.BufAppend(cmdb, opt.cc)
            if musl_tcc.active:
                str.BufAppend(cmdb, " -B")
                str.BufAppend(cmdb, shell_arg(musl_tcc.tcc_dir))
                str.BufAppend(cmdb, " -nostdlib -static -I")
                str.BufAppend(cmdb, shell_arg(musl_tcc.tcc_dir))
                str.BufAppend(cmdb, "/include -I")
                str.BufAppend(cmdb, shell_arg(musl_tcc.musl_dir))
                str.BufAppend(cmdb, "/include -L")
                str.BufAppend(cmdb, shell_arg(musl_tcc.musl_dir))
                str.BufAppend(cmdb, "/lib")
            end
            str.BufAppend(cmdb, opt_flag)
            str.BufAppend(cmdb, alias_flag)
            str.BufAppend(cmdb, werror_flag)
            str.BufAppend(cmdb, lto_flag)
            str.BufAppend(cmdb, " -I. -I")
            str.BufAppend(cmdb, shell_arg(scratch))
            str.BufAppend(cmdb, " -o ")
            str.BufAppend(cmdb, shell_arg(output))
            if SALAM_OS_WINDOWS:
                str.BufAppend(cmdb, " -Wl,--stack=8388608")
                if not use_tcc:
                    str.BufAppend(cmdb, " -Wl,--allow-multiple-definition")
                end
            end
            str.BufAppend(cmdb, dbg_flag2)
            str.BufAppend(cmdb, asan_flag)
            str.BufAppend(cmdb, link_defines)

            if musl_tcc.active:
                str.BufAppendChar(cmdb, 32)
                str.BufAppend(cmdb, shell_arg(musl_tcc.musl_dir + "/lib/crt1.o"))
                str.BufAppendChar(cmdb, 32)
                str.BufAppend(cmdb, shell_arg(musl_tcc.musl_dir + "/lib/crti.o"))
            end

            repeat cfiles.Len() in ci:
                str.BufAppendChar(cmdb, 32)
                str.BufAppend(cmdb, shell_arg(cfiles.Get(ci)))
            end
            str.BufAppend(cmdb, lm)

            repeat opt.lib_paths.Len() in lp2b:
                str.BufAppend(cmdb, " -L")
                str.BufAppend(cmdb, shell_arg(opt.lib_paths.Get(lp2b)))
            end

            repeat links.Len() in li2b:
                emit_link(cmdb, lgr, links.Get(li2b), link_kinds.Get(li2b), use_tcc)
            end

            if musl_tcc.active:
                libgcc := musl_tcc.musl_dir + "/lib/libgcc.a"
                str.BufAppend(cmdb, " -lc ")
                str.BufAppend(cmdb, shell_arg(libgcc))
                str.BufAppendChar(cmdb, 32)
                libtcc1 := musl_tcc.tcc_dir + "/libtcc1.a"
                str.BufAppend(cmdb, shell_arg(libtcc1))
                str.BufAppend(cmdb, " -lc ")
                str.BufAppend(cmdb, shell_arg(libgcc))
                crtn := musl_tcc.musl_dir + "/lib/crtn.o"
                str.BufAppendChar(cmdb, 32)
                str.BufAppend(cmdb, shell_arg(crtn))
            end

            cmdtext := str.BufStr(cmdb)
            str.BufFree(cmdb)
            lg.Log(lgr, lg.PH_DRIVER, lg.LOG_INFO, "linking: " + cmdtext)
            _pt_lk := pf.Begin(pf.TP_LINK, output)
            crc = shell.System(cmdtext)
            pf.End(pf.TP_LINK, _pt_lk)
            if crc != 0:
                lg.Log(
                    lgr, lg.PH_DRIVER, lg.LOG_ERROR, co.Format2(
                        i18.Tr("C compiler '%s' failed (exit %d)"), co.ArgStr(opt.cc), co.ArgInt(crc as i64)
                    )
                )
                rc = 3
            else:
                lg.Log(lgr, lg.PH_DRIVER, lg.LOG_INFO, "built executable: " + output)
                if str.Len(opt.exe_path) == 0:
                    opt.exe_path = output
                end
                protect_binary(lgr, opt, output)
                if opt.command == CMD_BUILD:
                    _wm2 := write_build_manifest(scratch, build_sig, src.LoadedPaths())
                end
            end
        end
    end

    if opt.keep_temp:
        lg.Log(lgr, lg.PH_DRIVER, lg.LOG_INFO, "kept generated C files")
    end
    ret rc
end

pub func IsFreestandingTarget(triple: str): bool:
    ret target_is_freestanding(triple)
end
