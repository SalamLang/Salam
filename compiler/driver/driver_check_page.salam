package driver

import os
import str

include src "../source.salam"
include lg "../logger.salam"
include i18 "../i18n.salam"
include lp "../langpack.salam"
include co "../sal_core.salam"
include sm "../semantic/semantic.salam"
include lx "../lexer/lexer.salam"

pub func IsPageEntry(path: str): bool:
    pack := lp.Load("en")
    if pack == lp.LP_NONE or not os.Exists(path) or os.IsDir(path):
        ret false
    end
    mut sf := src.New()
    if not src.Load(path, sf):
        ret false
    end
    ret file_has_layout_block(lx.Detect(sf, pack), path) and not file_has_entry(
        pack, lp.Entry(pack), path
    )
end

pub func CheckWebPage(opt &: Dr, entry: str, ssr: bool): int:
    if opt.log_level == lg.LOG_INFO:
        opt.log_level = lg.LOG_WARN
    end
    mut web := opt
    web.inputs = Vector {} as Vector<str>
    web.inputs.Push(entry)
    web.input = entry
    web.ssr = ssr
    web.inline_mode = false
    web.command = CMD_LAYOUT_BUILD
    sm.SetProjectRootFrom(entry)
    defer sm.UnpinProjectRoot()
    rc := LayoutBuild(web)
    if rc != 0:
        ret rc
    end
    if ssr:
        mut server := opt
        server.inputs = Vector {} as Vector<str>
        server.inputs.Push(entry)
        server.input = entry
        server.ssr_server = true
        ret Inspect(server)
    end
    if opt.log_level < lg.LOG_ERROR:
        println co.Format1(i18.Tr("%s: no errors"), co.ArgStr(entry))
    end
    ret 0
end
