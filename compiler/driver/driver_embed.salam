package driver

import str

if SALAM_HAVE_EMBED:
    link static "salam_embed"

    extern:
        salam_embed_musl_x86_64_ptr: void*
        salam_embed_musl_x86_64_len: i64
        salam_embed_musl_aarch64_ptr: void*
        salam_embed_musl_aarch64_len: i64
        salam_embed_musl_i686_ptr: void*
        salam_embed_musl_i686_len: i64
        salam_embed_musl_arm_ptr: void*
        salam_embed_musl_arm_len: i64
        salam_embed_mingw_x86_64_ptr: void*
        salam_embed_mingw_x86_64_len: i64
        salam_embed_mingw_i686_ptr: void*
        salam_embed_mingw_i686_len: i64
        salam_embed_hostlibs_ptr: void*
        salam_embed_hostlibs_len: i64
        salam_embed_extralibs_x86_64_linux_musl_ptr: void*
        salam_embed_extralibs_x86_64_linux_musl_len: i64
        salam_embed_extralibs_aarch64_linux_musl_ptr: void*
        salam_embed_extralibs_aarch64_linux_musl_len: i64
        salam_embed_extralibs_i686_linux_musl_ptr: void*
        salam_embed_extralibs_i686_linux_musl_len: i64
        salam_embed_extralibs_arm_linux_musleabihf_ptr: void*
        salam_embed_extralibs_arm_linux_musleabihf_len: i64
        salam_embed_extralibs_x86_64_w64_windows_gnu_ptr: void*
        salam_embed_extralibs_x86_64_w64_windows_gnu_len: i64
    end

    func embedded_blob(name: str, ptr &: void*, len &: i64): bool:
        if str.Equals(name, "x86_64-linux-musl"):
            ptr = salam_embed_musl_x86_64_ptr
            len = salam_embed_musl_x86_64_len
        else str.Equals(name, "aarch64-linux-musl"):
            ptr = salam_embed_musl_aarch64_ptr
            len = salam_embed_musl_aarch64_len
        else str.Equals(name, "i686-linux-musl"):
            ptr = salam_embed_musl_i686_ptr
            len = salam_embed_musl_i686_len
        else str.Equals(name, "arm-linux-musleabihf"):
            ptr = salam_embed_musl_arm_ptr
            len = salam_embed_musl_arm_len
        else str.Equals(name, "x86_64-w64-mingw32"):
            ptr = salam_embed_mingw_x86_64_ptr
            len = salam_embed_mingw_x86_64_len
        else str.Equals(name, "i686-w64-mingw32"):
            ptr = salam_embed_mingw_i686_ptr
            len = salam_embed_mingw_i686_len
        else str.Equals(name, "hostlibs"):
            ptr = salam_embed_hostlibs_ptr
            len = salam_embed_hostlibs_len
        else str.Equals(name, "extralibs-x86_64-linux-musl"):
            ptr = salam_embed_extralibs_x86_64_linux_musl_ptr
            len = salam_embed_extralibs_x86_64_linux_musl_len
        else str.Equals(name, "extralibs-aarch64-linux-musl"):
            ptr = salam_embed_extralibs_aarch64_linux_musl_ptr
            len = salam_embed_extralibs_aarch64_linux_musl_len
        else str.Equals(name, "extralibs-i686-linux-musl"):
            ptr = salam_embed_extralibs_i686_linux_musl_ptr
            len = salam_embed_extralibs_i686_linux_musl_len
        else str.Equals(name, "extralibs-arm-linux-musleabihf"):
            ptr = salam_embed_extralibs_arm_linux_musleabihf_ptr
            len = salam_embed_extralibs_arm_linux_musleabihf_len
        else str.Equals(name, "extralibs-x86_64-w64-windows-gnu"):
            ptr = salam_embed_extralibs_x86_64_w64_windows_gnu_ptr
            len = salam_embed_extralibs_x86_64_w64_windows_gnu_len
        else:
            ret false
        end
        ret ptr != null && len > (0 as i64)
    end

    func sysroot_name(triple: str): str:
        if str.Contains(triple, "linux-musl") || str.Contains(triple, "musleabihf"):
            if str.Contains(triple, "aarch64") || str.Contains(triple, "arm64"):
                ret "aarch64-linux-musl"
            end
            if str.Contains(triple, "musleabihf") || str.Contains(triple, "armv7"):
                ret "arm-linux-musleabihf"
            end
            if str.Contains(triple, "i686") || str.Contains(triple, "i386"):
                ret "i686-linux-musl"
            end
            ret "x86_64-linux-musl"
        end
        ret ""
    end

    pub func EmbeddedSysroot(name: str, out &: str): bool:
        mut p := null as void*
        mut n := 0 as i64
        if !embedded_blob(name, p, n):
            ret false
        end
        ret MaterializeSysroot(name, p, n, out)
    end

    pub func EmbeddedSysrootFor(triple: str, mingw_name: str, out &: str): bool:
        if str.Len(mingw_name) > 0 && EmbeddedSysroot(mingw_name, out):
            ret true
        end
        musl := sysroot_name(triple)
        if str.Len(musl) > 0:
            ret EmbeddedSysroot(musl, out)
        end
        ret false
    end

    pub func EmbeddedExtralibs(triple: str, out &: str): bool:
        mut name := "hostlibs"
        if str.Len(triple) > 0:
            name = "extralibs-" + triple
        end
        mut p := null as void*
        mut n := 0 as i64
        if !embedded_blob(name, p, n):
            ret false
        end
        ret MaterializeSysroot(name, p, n, out)
    end
else:
    pub func EmbeddedSysroot(_name: str, _out &: str): bool:
        ret false
    end

    pub func EmbeddedExtralibs(_triple: str, _out &: str): bool:
        ret false
    end

    pub func EmbeddedSysrootFor(_triple: str, _mingw_name: str, _out &: str): bool:
        ret false
    end
end
