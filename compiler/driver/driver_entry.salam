package driver

import os
import io
import str

include pth "../sal_path.salam"
include tok "../token.salam"
include src "../source.salam"
include lg "../logger.salam"
include at "../ast.salam"
include i18 "../i18n.salam"
include lp "../langpack.salam"
include lx "../lexer/lexer.salam"
include ps "../parser/parser.salam"
include cc "../condcomp.salam"
include co "../sal_core.salam"
include lo "../sal_layout/sal_layout.salam"

func list_salam_files(dir: str): Vector<str>:
    mut out := Vector {} as Vector<str>
    entries := os.ListDir(dir)
    defer entries.free()
    is_cwd := str.Equals(dir, ".")
    repeat entries.len() in i:
        name := entries.get(i)
        if str.EndsWith(name, ".salam"):
            if is_cwd:
                out.push(name)
            else:
                out.push(pth.PathJoin(dir, name))
            end
        end
    end
    ret out
end

func hint_main_rename(pack: lp.Langpack, entry: str, dir: str):
    mut files := list_salam_files(dir)
    defer files.free()
    if files.len() == 0:
        io.EPrintln("  start a project here with: salam init")
        ret
    end
    repeat files.len() in i:
        f := files.get(i)
        if file_has_entry(pack, entry, f):
            io.EPrintln("  rename " + f + " to main.salam, or run that file directly: salam run " + f)
            ret
        end
    end
    io.EPrintln("  create main.salam with a '" + entry + "' function, or run a file directly: salam run <file.salam>")
end

func resolve_dir_entry(lgr: lg.Logger, pack: lp.Langpack, dir: str): str:
    entry := lp.Entry(pack)
    proj := project_entry_file(dir)
    if str.Len(proj) == 0:
        mut where := dir
        if str.Len(where) == 0 or str.Equals(where, "."):
            where = os.Cwd()
        end
        lg.Log(
            lgr, lg.PH_DRIVER, lg.LOG_ERROR, co.Format1(
                i18.Tr("no main.salam in '%s': a project's entry file must be named main.salam"), co.ArgStr(where)
            )
        )
        hint_main_rename(pack, entry, dir)
        ret ""
    end
    if not file_has_entry(pack, entry, proj):
        lg.Log(
            lgr, lg.PH_DRIVER, lg.LOG_ERROR, co.Format2(
                i18.Tr("project entry file '%s' does not define a '%s' function"), co.ArgStr(proj), co.ArgStr(entry)
            )
        )
        if file_has_layout_block(pack, proj):
            io.EPrintln("  this looks like a web layout project; build it with: salam web " + proj)
        end
        ret ""
    end
    lg.Log(
        lgr, lg.PH_DRIVER, lg.LOG_INFO, co.Format1(i18.Tr("entry point: %s"), co.ArgStr(proj))
    )
    ret proj
end

func file_has_entry(pack: lp.Langpack, entry: str, path: str): bool:
    quiet := lg.New(lg.LOG_OFF, false)
    mut sf := src.New()
    if not src.Load(path, sf):
        ret false
    end
    fpack := lx.Detect(sf, pack)
    fentry := lp.Entry(fpack)
    mut toks := tok.StreamNew(path)
    _lok := lx.Run(quiet, fpack, sf, toks)
    mut a := at.NewAst()
    mut prog := 0
    _pok := ps.Run(quiet, toks, a, prog)
    tok.StreamFree(toks)
    mut nodefs := Vector {} as Vector<str>
    defer nodefs.free()
    table := cc.TableBuild("", nodefs)
    cc.TableSetPack(table, fpack)
    _ck := cc.PruneProgram(a, quiet, path, table, prog)
    mut found := false
    prog_n := at.Get(a, prog)
    repeat prog_n.list.len() in i2:
        d := at.Get(a, prog_n.list.get(i2))
        if d.kind == at.AST_FUNC_DEF and (str.Equals(d.name, entry) or str.Equals(d.name, fentry)):
            found = true
            break
        end
    end
    at.FreeAst(a)
    ret found
end

func file_has_layout_block(pack: lp.Langpack, path: str): bool:
    quiet := lg.New(lg.LOG_OFF, false)
    mut sf := src.New()
    if not src.Load(path, sf):
        ret false
    end
    mut toks := tok.StreamNew(path)
    _lok := lx.Run(quiet, pack, sf, toks)
    mut a := at.NewAst()
    mut prog := 0
    _pok := ps.Run(quiet, toks, a, prog)
    tok.StreamFree(toks)
    mut nodefs := Vector {} as Vector<str>
    defer nodefs.free()
    table := cc.TableBuild("", nodefs)
    cc.TableSetPack(table, pack)
    _ck := cc.PruneProgram(a, quiet, path, table, prog)
    found := lo.FindLayout(a, prog) != 0
    at.FreeAst(a)
    ret found
end

func resolve_dir_layout(lgr: lg.Logger, pack: lp.Langpack, dir: str, single: bool): Vector<str>:
    mut out := Vector {} as Vector<str>
    proj := project_entry_file(dir)
    if str.Len(proj) > 0:
        lg.Log(
            lgr, lg.PH_DRIVER, lg.LOG_INFO, co.Format1(i18.Tr("entry point: %s"), co.ArgStr(proj))
        )
        out.push(proj)
        ret out
    end
    mut files := list_salam_files(dir)
    mut pages := Vector {} as Vector<str>
    defer files.free()
    defer pages.free()
    if files.len() == 0:
        lg.Log(
            lgr, lg.PH_DRIVER, lg.LOG_ERROR, i18.Tr("no .salam files found in the current directory")
        )
        ret out
    end
    repeat files.len() in fi:
        f := files.get(fi)
        if file_has_layout_block(pack, f):
            pages.push(f)
        end
    end
    if pages.len() == 0:
        lg.Log(
            lgr, lg.PH_DRIVER, lg.LOG_ERROR, co.Format2(
                i18.Tr("no page entry: none of the %d .salam file%s here has a 'page' block"), co.ArgInt(files.len() as i64), co.ArgStr(plural_suffix(files.len()))
            )
        )
        io.EPrintln("  name the page 'main.salam' to make it the project entry")
        ret out
    end
    if single and pages.len() > 1:
        lg.Log(
            lgr, lg.PH_DRIVER, lg.LOG_ERROR, co.Format1(
                i18.Tr("ambiguous page entry: %d files have a 'page' block:"), co.ArgInt(pages.len() as i64)
            )
        )
        repeat pages.len() in pi:
            io.EPrintln("    " + pages.get(pi))
        end
        io.EPrintln("  build a specific one with: salam web <file.salam>")
        io.EPrintln("  or name the page 'main.salam' to make it the project entry")
        ret out
    end
    repeat pages.len() in qi:
        out.push(pages.get(qi))
    end
    ret out
end

func write_xml_out(lgr: lg.Logger, text: str, xml_out: str, what: str): int:
    if str.Len(xml_out) > 0:
        if os.WriteFile(xml_out, text) < 0:
            lg.Log(
                lgr, lg.PH_DRIVER, lg.LOG_ERROR, co.Format1(i18.Tr("cannot open '%s' for writing"), co.ArgStr(xml_out))
            )
            ret 2
        end
        lg.Log(lgr, lg.PH_DRIVER, lg.LOG_INFO, what + " XML written to " + xml_out)
        ret 0
    end
    print text
    ret 0
end
