package driver

import os
import io
import str

include lg "../logger.salam"
include i18 "../i18n.salam"
include co "../sal_core.salam"

func exec_headless_asked(): bool:
    mode := str.Lower(os.Env("SALAM_WINDOW_BACKEND"))
    ret str.Equals(mode, "headless") or str.Equals(mode, "none") or str.Equals(
        mode, "off"
    ) or str.Equals(mode, "0") or str.Equals(mode, "false")
end

func exec_page_refused(opt &: Dr, lgr: lg.Logger, web: bool): int:
    p := opt.platform
    if str.Equals(
        p, "android"
    ) or str.Equals(p, "ios") or str.Equals(p, "js") or str.Equals(p, "all"):
        verb := str.Equals(p, "js") or str.Equals(p, "all") ? "build" : "run"
        lg.Log(
            lgr,
            lg.PH_DRIVER,
            lg.LOG_ERROR,
            co.Format1(
                i18.Tr(
                    "the interpreter cannot run a page for this platform; use '%s' instead"
                ),
                co.ArgStr("salam " + verb + " " + opt.input + " --platform=" + p)
            )
        )
        ret 1
    end
    if str.Len(p) > 0 and not web and not str.Equals(p, "native") and not str.Equals(
        p, ExecHostPlatform()
    ):
        if not str.Equals(p, "linux") and not str.Equals(p, "macos") and not str.Equals(
            p, "windows"
        ):
            io.EPrintln(
                "salam: unknown platform '" + p +
                    "' (choose web, js, android, ios, linux, macos, windows or all)"
            )
            ret 2
        end
        lg.Log(
            lgr,
            lg.PH_DRIVER,
            lg.LOG_ERROR,
            co.Format1(
                i18.Tr(
                    "the interpreter cannot run a page for this platform; use '%s' instead"
                ),
                co.ArgStr("salam build " + opt.input + " --platform=" + p)
            )
        )
        ret 1
    end
    timed := opt.timeout_ms > 0 or str.Len(str.Trim(os.Env("SALAM_EXEC_TIMEOUT_MS"))) > 0
    if web and timed:
        lg.Log(
            lgr,
            lg.PH_DRIVER,
            lg.LOG_ERROR,
            co.Format1(
                i18.Tr(
                    "a web page is served until stopped, so it cannot run under a time limit; use '%s' instead"
                ),
                co.ArgStr("salam serve " + opt.input)
            )
        )
        ret 1
    end
    if web and opt.serve_render:
        lg.Log(
            lgr,
            lg.PH_DRIVER,
            lg.LOG_ERROR,
            co.Format1(
                i18.Tr(
                    "the interpreter cannot run server rendered pages, which are compiled; use '%s' instead"
                ),
                co.ArgStr("salam run --platform=web")
            )
        )
        ret 1
    end
    ret 0
end

func exec_serve_page(opt &: Dr): int:
    io.EPrintln(
        i18.Tr(
            "salam: the interpreter does not run web pages; serving this one for a browser, as 'salam serve' does"
        )
    )
    opt.command = CMD_SERVE
    opt.inputs.Clear()
    opt.inputs.Push(opt.input)
    ret Serve(opt)
end

if SALAM_OS_MAC:
    pub func ExecHostPlatform(): str: ret "macos" end
else SALAM_OS_WINDOWS:
    pub func ExecHostPlatform(): str: ret "windows" end
else:
    pub func ExecHostPlatform(): str: ret "linux" end
end
