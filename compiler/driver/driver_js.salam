struct JsMods:
    pub globals: Vector<str> = Vector {}
    pub seg_mod: Vector<int> = Vector {}
    pub fn_names: Vector<str> = Vector {}
    pub fn_texts: Vector<str> = Vector {}
    pub count: int = 0
    pub first_module: str = ""
    pub entry_name: str = ""
    pub failed: Vector<str> = Vector {}
    pub ml: str = ""
    pub mk: Vector<str> = Vector {}
    pub mv: Vector<str> = Vector {}
end

func is_alnum(c: int): bool:
    ret (c >= 48 and c <= 57) or (c >= 97 and c <= 122) or (c >= 65 and c <= 90)
end

func ascii_lower(c: int): int:
    if c >= 65 and c <= 90:
        ret c + 32
    end
    ret c
end

func ends_with_ci(s: str, suf: str): bool:
    sl := str.Len(s)
    fl := str.Len(suf)
    if fl > sl:
        ret false
    end
    mut ok := true
    repeat fl in i:
        av := ascii_lower(byte_at(s, sl - fl + i))
        bv := ascii_lower(byte_at(suf, i))
        if av != bv:
            ok = false
        end
    end
    ret ok
end

func js_refs(text: str, name: str): bool:
    nl := str.Len(name)
    if nl == 0:
        ret false
    end
    tn := str.Len(text)
    mut p := 0
    until true:
        idx := str.IndexFrom(text, name, p)
        if idx < 0:
            ret false
        end
        before := idx == 0 ? 0 : byte_at(text, idx - 1)
        after := idx + nl < tn ? byte_at(text, idx + nl) : 0
        bok := not (
            is_alnum(before) or before == 95 or before == 36 or before == 46
        )
        aok := not (is_alnum(after) or after == 95 or after == 36)
        if bok and aok:
            ret true
        end
        p = idx + 1
    end
end

func js_mods_free(mods &: JsMods):
    mods.globals.free()
    mods.seg_mod.free()
    mods.fn_names.free()
    mods.fn_texts.free()
    mods.failed.free()
    mods.mk.free()
    mods.mv.free()
end

func js_import_paths(a &: at.Ast, prog: int, idir: str, lang: str, work &: Vector<str>):
    pn := at.Get(a, prog)
    repeat pn.list.Len() in k:
        did := pn.list.get(k)
        d := at.Get(a, did)
        if d.kind != at.AST_IMPORT:
            continue
        end
        mut ipath := d.type_str
        if str.Len(ipath) == 0:
            ipath = sm.ResolveImportNode(a, idir, did, lang)
        end
        if str.Len(ipath) == 0:
            continue
        end
        mut known := false
        repeat work.Len() in j2:
            if str.Equals(work.get(j2), ipath):
                known = true
            end
        end
        if not known:
            work.push(ipath)
        end
    end
end

func js_compile_work(
    lgr &: lg.Logger, opt &: Dr, pack: int, work &: Vector<str>, nentries: int, a &: at.Ast, minify_names: bool, minify_ws: bool, mods &: JsMods
): bool:
    mut all_ok := true
    mut wi := 0
    until wi < work.Len():
        path := work.get(wi)
        mut dup := false
        repeat wi in j:
            if str.Equals(work.get(j), path):
                dup = true
            end
        end
        if dup:
            wi++
            continue
        end
        mut sf := src.New()
        if not src.Load(path, sf):
            lg.Log(
                lgr, lg.PH_DRIVER, lg.LOG_ERROR, co.Format1(i18.Tr("cannot read source file '%s'"), co.ArgStr(path))
            )
            all_ok = false
            mods.failed.push(path)
            wi++
            continue
        end
        mut table := cc.TableBuild(cc.JS_TARGET, opt.defines)
        modpack := lx.Detect(sf, pack)
        cc.TableSetPack(table, modpack)
        modentry := lp.Entry(modpack)
        module := module_of(path)
        lg.SetDiagSource(lgr, sf.text, sf.len, opt.diag_style, opt.diag_format)
        lg.AddDiagSource(lgr, path, sf.text, sf.len)
        if str.Len(mods.first_module) == 0:
            mods.first_module = module
        end
        lg.Log(
            lgr, lg.PH_DRIVER, lg.LOG_INFO, co.Format1(i18.Tr("compiling %s -> js"), co.ArgStr(path))
        )
        mut toks := tok.StreamNew(path)
        mut lok := lx.Run(lgr, modpack, sf, toks)
        mut prog := 0
        mut pok := ps.Run(lgr, toks, a, prog)
        tok.StreamFree(toks)
        if not cc.PruneProgram(a, lgr, path, table, prog):
            pok = false
        end
        mut pfiles := sm.PackageFiles(path)
        mut pi := 1
        until pi < pfiles.Len():
            ppath := pfiles.get(pi)
            mut psf := src.New()
            if src.Load(ppath, psf):
                lg.AddDiagSource(lgr, ppath, psf.text, psf.len)
                mut ptoks := tok.StreamNew(ppath)
                if not lx.Run(lgr, modpack, psf, ptoks):
                    lok = false
                end
                mut pprog := 0
                if not ps.Run(lgr, ptoks, a, pprog):
                    pok = false
                end
                tok.StreamFree(ptoks)
                if not cc.PruneProgram(a, lgr, ppath, table, pprog):
                    pok = false
                end
                sm.MergeProgram(a, prog, pprog)
            else:
                lg.Log(
                    lgr, lg.PH_DRIVER, lg.LOG_ERROR, co.Format1(i18.Tr("cannot read source file '%s'"), co.ArgStr(ppath))
                )
                all_ok = false
                mods.failed.push(ppath)
            end
            pi++
        end
        pfiles.free()

        _vw := lo.PrepareViews(lgr, modpack, table, a, prog, path)
        mut s := sm.New(lgr, path, lp.Code(modpack))
        sm.SetCc(s, table)
        sok := sm.RunCached(s, a, prog)
        if not lok or not pok or not sok:
            all_ok = false
            mods.failed.push(path)
            sm.Free(s)
            wi++
            continue
        end

        js_import_paths(a, prog, dir_of(path), lp.Code(modpack), work)
        if s.prelude_err != 0:
            cpath := sm.ResolveImport("", "core")
            mut has_core := str.Len(cpath) == 0
            repeat work.Len() in j3:
                if str.Equals(work.get(j3), cpath):
                    has_core = true
                end
            end
            if not has_core:
                work.push(cpath)
            end
        end

        mut out := jg.NewOutput()
        jg.Run(lgr, a, s, prog, module, modentry, minify_names, minify_ws, mods.ml, mods.mk, mods.mv, out, opt.safe)
        mods.globals.push(out.globals_src)
        repeat out.fn_names.Len() in fi:
            mods.fn_names.push(out.fn_names.get(fi))
            mods.fn_texts.push(out.fn_texts.get(fi))
            mods.seg_mod.push(mods.count)
        end
        if str.Len(mods.entry_name) == 0 and wi < nentries and str.Len(out.entry_mangled) > 0:
            mods.entry_name = out.entry_mangled
        end
        mods.count++
        jg.FreeOutput(out)
        sm.Free(s)
        wi++
    end
    ret all_ok
end

func js_build_bundle(
    lgr &: lg.Logger, opt &: Dr, entries: Vector<str>, module_out &: str, rc_out &: int
): str:
    rc_out = 0
    pack := lp.Load(opt.lang)
    if pack == lp.LP_NONE:
        lg.Log(
            lgr, lg.PH_DRIVER, lg.LOG_ERROR, co.Format1(i18.Tr("unknown language pack '%s'"), co.ArgStr(opt.lang))
        )
        rc_out = 2
        ret ""
    end
    sm.SetStdlibRoot(opt.stdlib_path)
    sm.LayoutSchemaInit(sm.GetStdlibRoot())

    minify_ws := not opt.no_minify
    minify_names := minify_ws and not opt.no_js_minify_names

    mut work := Vector {} as Vector<str>
    defer work.free()
    repeat entries.Len() in ii:
        work.push(entries.get(ii))
    end
    if entries.Len() > 0:
        sm.SetProjectRootFrom(entries.get(0))
    end
    defer sm.UnpinProjectRoot()

    mut a := at.NewAst()
    defer at.FreeAst(a)

    mut mods := JsMods {}
    defer js_mods_free(mods)
    all_ok := js_compile_work(
        lgr, opt, pack, work, entries.Len(), a, minify_names, minify_ws, mods
    )

    module_out = mods.first_module

    if not all_ok:
        lg.Log(
            lgr, lg.PH_DRIVER, lg.LOG_ERROR, abort_message(i18.Tr("build aborted: errors in source"), mods.failed)
        )
        rc_out = 1
        ret ""
    end
    if str.Len(mods.entry_name) == 0:
        lg.Log(
            lgr, lg.PH_DRIVER, lg.LOG_ERROR, co.Format1(
                i18.Tr("no entry point: define a '%s' function"), co.ArgStr(lp.Entry(pack))
            )
        )
        rc_out = 1
        ret ""
    end

    mut seg_names := Vector {} as Vector<str>
    mut seg_texts := Vector {} as Vector<str>
    mut seg_used := Vector {} as Vector<int>
    defer seg_names.free()
    defer seg_texts.free()
    defer seg_used.free()
    repeat len(k_dr_js_prelude_names) in pi2:
        mut ptext := k_dr_js_prelude_texts[pi2]
        if minify_ws:
            ptext = mn.Js(ptext)
        end
        seg_names.push(k_dr_js_prelude_names[pi2])
        seg_texts.push(ptext)
        seg_used.push(0)
    end
    mut m := mods.count - 1
    until m >= 0:
        repeat mods.fn_names.Len() in si:
            if mods.seg_mod.get(si) == m:
                seg_names.push(mods.fn_names.get(si))
                seg_texts.push(mods.fn_texts.get(si))
                seg_used.push(0)
            end
        end
        m--
    end

    boot := mods.entry_name
    mut roots := ""
    mut m2 := mods.count - 1
    until m2 >= 0:
        roots += mods.globals.get(m2)
        m2--
    end
    roots = roots + boot + "\n"
    mut changed := true
    until changed:
        changed = false
        mut sgi := 0
        until sgi < seg_names.Len():
            if seg_used.get(sgi) != 0:
                sgi++
                continue
            end
            nm := seg_names.get(sgi)
            if js_refs(roots, nm):
                seg_used.set(sgi, 1)
                changed = true
                sgi++
                continue
            end
            mut ti := 0
            until ti < seg_names.Len():
                if ti != sgi and seg_used.get(ti) != 0:
                    if js_refs(seg_texts.get(ti), nm):
                        seg_used.set(sgi, 1)
                        changed = true
                        break
                    end
                end
                ti++
            end
            sgi++
        end
    end

    mut js := str.NewBuilder()
    str.BufAppend(
        js, minify_ws ? `(function(){"use strict";` : "(function () {\n\"use strict\";\n\n"
    )
    mut have_globals := false
    mut m3 := mods.count - 1
    until m3 >= 0:
        if str.Len(mods.globals.get(m3)) > 0:
            have_globals = true
        end
        m3--
    end
    if have_globals:
        mut m4 := mods.count - 1
        until m4 >= 0:
            str.BufAppend(js, mods.globals.get(m4))
            m4--
        end
        str.BufAppendChar(js, minify_ws ? 32 : 10)
    end
    repeat seg_names.Len() in sgi2:
        if seg_used.get(sgi2) != 0:
            str.BufAppend(js, seg_texts.get(sgi2))
            str.BufAppendChar(js, minify_ws ? 32 : 10)
        end
    end
    if not minify_ws:
        str.BufAppend(js, "// Run the program once the DOM is ready.\n")
    end
    if minify_ws:
        str.BufAppend(
            js, `if(typeof document!=="undefined"&&document.readyState==="loading"){document.` + `addEventListener("DOMContentLoaded",` + boot + ");}else{" + boot + "();}"
        )
    else:
        str.BufAppend(
            js, "if (typeof document !== \"undefined\" && document.readyState === \"loading\") {\n" + "    document.addEventListener(" + `"DOMContentLoaded", ` + boot + ");\n" + "} else {\n    " + boot + "();\n}\n"
        )
    end
    str.BufAppend(js, minify_ws ? "})();" : "})();\n")
    text := str.BufStr(js)
    str.BufFree(js)
    ret text
end

func js_string_literal(s: str): str:
    ret "\"" + s + "\""
end

func collect_event_js(
    lgr &: lg.Logger, opt &: Dr, a &: at.Ast, s &: sm.Sema, prog: int, path: str, minify_ws: bool, handlers: Vector<str>, ok &: bool
): str:
    ok = true
    mut ml := ""
    mut mk := Vector {} as Vector<str>
    mut mv := Vector {} as Vector<str>
    defer mk.free()
    defer mv.free()
    mut out := jg.NewOutput()
    jg.Run(lgr, a, s, prog, "page", "", false, minify_ws, ml, mk, mv, out, opt.safe)

    if out.fn_names.Len() == 0 and str.Len(out.globals_src) == 0:
        jg.FreeOutput(out)
        ret ""
    end

    mut work := Vector {} as Vector<str>
    defer work.free()
    js_import_paths(a, prog, dir_of(path), s.lang, work)
    mut ia := at.NewAst()
    defer at.FreeAst(ia)
    mut mods := JsMods {}
    defer js_mods_free(mods)
    if work.Len() > 0:
        pack := lp.Load(opt.lang)
        if not js_compile_work(lgr, opt, pack, work, 0, ia, false, minify_ws, mods):
            lg.Log(
                lgr, lg.PH_DRIVER, lg.LOG_ERROR, abort_message(i18.Tr("build aborted: errors in source"), mods.failed)
            )
            ok = false
            jg.FreeOutput(out)
            ret ""
        end
    end

    mut roots := out.globals_src
    repeat out.fn_texts.Len() in ri:
        roots += out.fn_texts.get(ri)
    end
    repeat mods.globals.Len() in gi:
        roots += mods.globals.get(gi)
    end

    mut seg_names := Vector {} as Vector<str>
    mut seg_texts := Vector {} as Vector<str>
    mut seg_used := Vector {} as Vector<int>
    defer seg_names.free()
    defer seg_texts.free()
    defer seg_used.free()
    repeat len(k_dr_js_prelude_names) in pi:
        mut ptext := k_dr_js_prelude_texts[pi]
        if minify_ws:
            ptext = mn.Js(ptext)
        end
        seg_names.push(k_dr_js_prelude_names[pi])
        seg_texts.push(ptext)
        seg_used.push(0)
    end
    mut m := mods.count - 1
    until m >= 0:
        repeat mods.fn_names.Len() in si:
            if mods.seg_mod.get(si) == m:
                seg_names.push(mods.fn_names.get(si))
                seg_texts.push(mods.fn_texts.get(si))
                seg_used.push(0)
            end
        end
        m--
    end
    mut changed := true
    until changed:
        changed = false
        mut sgi := 0
        until sgi < seg_names.Len():
            if seg_used.get(sgi) == 0:
                nm := seg_names.get(sgi)
                mut hit := js_refs(roots, nm)
                if not hit:
                    mut ti := 0
                    until ti < seg_names.Len():
                        if ti != sgi and seg_used.get(ti) != 0 and js_refs(seg_texts.get(ti), nm):
                            hit = true
                            break
                        end
                        ti++
                    end
                end
                if hit:
                    seg_used.set(sgi, 1)
                    changed = true
                end
            end
            sgi++
        end
    end

    mut js := str.NewBuilder()
    str.BufAppend(
        js, minify_ws ? `(function(){"use strict";` : "(function () {\n\"use strict\";\n\n"
    )
    mut gm := mods.count - 1
    until gm >= 0:
        if str.Len(mods.globals.get(gm)) > 0:
            str.BufAppend(js, mods.globals.get(gm))
            str.BufAppendChar(js, minify_ws ? 32 : 10)
        end
        gm--
    end
    if str.Len(out.globals_src) > 0:
        str.BufAppend(js, out.globals_src)
        str.BufAppendChar(js, minify_ws ? 32 : 10)
    end
    repeat seg_names.Len() in sgi2:
        if seg_used.get(sgi2) != 0:
            str.BufAppend(js, seg_texts.get(sgi2))
            str.BufAppendChar(js, minify_ws ? 32 : 10)
        end
    end
    repeat out.fn_texts.Len() in fi2:
        str.BufAppend(js, out.fn_texts.get(fi2))
        str.BufAppendChar(js, minify_ws ? 32 : 10)
    end
    wcount := lo.WebStateCount()
    if wcount > 0:
        mut wviews := Vector {} as Vector<str>
        mut winits := Vector {} as Vector<str>
        repeat wcount in wi:
            wk := lo.WebStateKind(wi)
            wviews.push(wk == 1 ? "null" : jg.Ident("__salam_view_" + co.U64Toa(wi as u64)))
            winits.push(wk == 0 ? jg.Ident("__salam_init_" + co.U64Toa(wi as u64)) : "null")
        end
        mut wrt := lo.WebStateRuntime(wviews, winits)
        if minify_ws:
            wrt = mn.Js(wrt)
        end
        str.BufAppend(js, wrt)
        str.BufAppendChar(js, minify_ws ? 32 : 10)
        wviews.free()
        winits.free()
    end
    mut exposed := Vector {} as Vector<str>
    defer exposed.free()
    each call in handlers:
        paren := str.IndexOf(call, "(")
        if paren <= 0:
            continue
        end
        src_name := call.substr(0, paren)
        mut seen := false
        each prev in exposed:
            if str.Equals(prev, src_name):
                seen = true
            end
        end
        if seen:
            continue
        end
        exposed.push(src_name)
        str.BufAppend(js, "window[" + js_string_literal(src_name) + "] = " + jg.Ident(src_name) + ";")
        str.BufAppendChar(js, minify_ws ? 32 : 10)
    end
    str.BufAppend(js, minify_ws ? "})();" : "})();\n")
    text := str.BufStr(js)
    str.BufFree(js)
    jg.FreeOutput(out)
    ret text
end

func js_html_page(module: str, js_text: str, minify_ws: bool): str:
    mut b := str.NewBuilder()
    if minify_ws:
        str.BufAppend(b, `<!doctype html><html lang="en"><head>`)
        str.BufAppend(b, `<meta charset="utf-8">`)
        str.BufAppend(
            b, `<meta name="viewport" content="width=device-width, initial-scale=1">`
        )
        str.BufAppend(b, "<title>" + module + "</title>")
        str.BufAppend(b, "</head><body><script>")
        str.BufAppend(b, js_text)
        str.BufAppend(b, "</script></body></html>")
    else:
        str.BufAppend(b, "<!doctype html>\n<html lang=\"en\">\n<head>\n")
        str.BufAppend(b, "<meta charset=\"utf-8\">\n")
        str.BufAppend(
            b, "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n"
        )
        str.BufAppend(b, "<title>" + module + "</title>\n")
        str.BufAppend(b, "</head>\n<body>\n<script>\n")
        str.BufAppend(b, js_text)
        str.BufAppend(b, "</script>\n</body>\n</html>\n")
    end
    r := str.BufStr(b)
    str.BufFree(b)
    ret r
end

func plural_suffix(n: int): str:
    ret i18.Plural(n)
end

func path_ext2(stem: str, ext: str): str:
    ret stem + "." + ext
end

func join_path2(dir: str, rel: str): str:
    ret pth.PathJoin(dir, rel)
end

func base_name(p: str): str:
    ret pth.PathBase(p)
end

func strip_ext(p: str): str:
    base := pth.PathBase(p)
    dot := str.LastIndex(base, ".")
    if dot >= 0:
        ret str.Substr(p, 0, str.Len(p) - (str.Len(base) - dot))
    end
    ret p
end

func script_salam_src(a &: at.Ast, el: int): str:
    n := at.Get(a, el)
    repeat n.list.Len() in j:
        attr := at.Get(a, n.list.get(j))
        if attr.kind != at.AST_LAYOUT_ATTR or str.Len(attr.name) == 0:
            continue
        end
        if not str.Equals(attr.name, "src") and not str.Equals(attr.name, "url"):
            continue
        end
        if attr.a != 0:
            av := at.Get(a, attr.a)
            if av.kind == at.AST_LITERAL and av.value_kind == tok.TV_STRING and str.Len(av.value_str) > 0 and str.EndsWith(av.value_str, ".salam"):
                ret av.value_str
            end
        end
    end
    ret ""
end

func collect_scripts(a &: at.Ast, node: int, out &: Vector<str>):
    if node == 0:
        ret
    end
    n := at.Get(a, node)
    mut kept := Vector {} as Vector<int>
    repeat n.list.Len() in i:
        ch := n.list.get(i)
        chn := at.Get(a, ch)
        mut removed := false
        if chn.kind == at.AST_LAYOUT_ELEMENT:
            if str.Equals(chn.name, "script"):
                sp := script_salam_src(a, ch)
                if str.Len(sp) > 0:
                    out.push(sp)
                    removed = true
                end
            end
            if not removed:
                collect_scripts(a, ch, out)
            end
        end
        if not removed:
            kept.push(ch)
        end
    end
    mut nn := at.Get(a, node)
    old := nn.list
    nn.list = kept
    at.Put(a, node, nn)
    defer old.free()
end
