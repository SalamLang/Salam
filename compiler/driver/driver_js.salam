package driver

import os
import str
import mem

include pth "../sal_path.salam"
include tok "../token.salam"
include src "../source.salam"
include lg "../logger.salam"
include at "../ast.salam"
include i18 "../i18n.salam"
include lp "../langpack.salam"
include lx "../lexer/lexer.salam"
include ps "../parser/parser.salam"
include cc "../condcomp.salam"
include sm "../semantic/semantic.salam"
include co "../sal_core.salam"
include jg "../jsgen/jsgen.salam"
include mn "../minify.salam"

struct JsMods:
    pub globals: Vector<str> = Vector {}
    pub seg_mod: Vector<int> = Vector {}
    pub global_names: Vector<str> = Vector {}
    pub global_texts: Vector<str> = Vector {}
    pub global_mod: Vector<int> = Vector {}
    pub fn_names: Vector<str> = Vector {}
    pub fn_texts: Vector<str> = Vector {}
    pub count: int = 0
    pub first_module: str = ""
    pub entry_name: str = ""
    pub failed: Vector<str> = Vector {}
    pub ml: str = ""
    pub mk: Vector<str> = Vector {}
    pub mv: Vector<str> = Vector {}
end

func is_alnum(c: int): bool:
    ret (c >= 48 and c <= 57) or (c >= 97 and c <= 122) or (c >= 65 and c <= 90)
end

func ascii_lower(c: int): int:
    if c >= 65 and c <= 90:
        ret c + 32
    end
    ret c
end

func ends_with_ci(s: str, suf: str): bool:
    sl := str.Len(s)
    fl := str.Len(suf)
    if fl > sl:
        ret false
    end
    mut ok := true
    repeat fl in i:
        av := ascii_lower(byte_at(s, sl - fl + i))
        bv := ascii_lower(byte_at(suf, i))
        if av != bv:
            ok = false
        end
    end
    ret ok
end

func js_refs(text: str, name: str): bool:
    nl := str.Len(name)
    if nl == 0:
        ret false
    end
    tn := str.Len(text)
    mut p := 0
    until true:
        idx := str.IndexFrom(text, name, p)
        if idx < 0:
            ret false
        end
        before := idx == 0 ? 0 : byte_at(text, idx - 1)
        after := idx + nl < tn ? byte_at(text, idx + nl) : 0
        bok := not (
            is_alnum(before) or before == 95 or before == 36 or before == 46
        )
        aok := not (is_alnum(after) or after == 95 or after == 36)
        if bok and aok:
            ret true
        end
        p = idx + 1
    end
end

func js_word_byte(c: int): bool:
    ret is_alnum(c) or c == 95 or c == 36
end

func js_is_word(s: str): bool:
    n := str.Len(s)
    repeat n in i:
        if not js_word_byte(byte_at(s, i)):
            ret false
        end
    end
    ret n > 0
end

func js_next_ref(text: str, n: int, p &: int, start &: int): bool:
    until p < n:
        if not js_word_byte(byte_at(text, p)):
            p++
            continue
        end
        start = p
        until p < n and js_word_byte(byte_at(text, p)):
            p++
        end
        if start == 0 or byte_at(text, start - 1) != 46:
            ret true
        end
    end
    ret false
end

func js_word_in(buf: void*, text: str, start: int, ln: int): str:
    from := (text as void*) as i64 + start as i64
    mem.Copy(buf, from as void*, ln as u64)
    mem.Set((buf as i64 + ln as i64) as void*, 0, 1 as u64)
    ret buf as str
end

func js_mark_used(
    roots: str, names: Vector<str>, texts: Vector<str>, used &: Vector<int>
):
    mut head := HashMap {} as HashMap<str, int>
    defer head.Free()
    mut link := Vector {} as Vector<int>
    defer link.Free()
    mut odd := Vector {} as Vector<int>
    defer odd.Free()
    mut longest := 0
    repeat names.Len() in i:
        nm := names.Get(i)
        if js_is_word(nm):
            link.Push(head.Has(nm) ? head.Get(nm) : -1)
            head.Put(nm, i)
            if str.Len(nm) > longest:
                longest = str.Len(nm)
            end
        else:
            link.Push(-1)
            odd.Push(i)
        end
    end
    buf := mem.MustAllocateZeroed((longest + 1) as u64)
    defer mem.Free(buf)
    mut queue := Vector {} as Vector<int>
    defer queue.Free()
    mut qi := -1
    until qi < queue.Len():
        from := qi < 0 ? -1 : queue.Get(qi)
        text := from < 0 ? roots : texts.Get(from)
        n := str.Len(text)
        mut p := 0
        mut start := 0
        until js_next_ref(text, n, p, start):
            if p - start > longest:
                continue
            end
            word := js_word_in(buf, text, start, p - start)
            if not head.Has(word):
                continue
            end
            mut k := head.Get(word)
            until k >= 0:
                if k != from and used.Get(k) == 0:
                    used.Set(k, 1)
                    queue.Push(k)
                end
                k = link.Get(k)
            end
        end
        each o in odd:
            if o != from and used.Get(o) == 0 and js_refs(text, names.Get(o)):
                used.Set(o, 1)
                queue.Push(o)
            end
        end
        qi++
    end
end

func js_lit_rhs(rhs: str): bool:
    n := str.Len(rhs)
    if n < 2 or byte_at(rhs, 0) != 91:
        ret false
    end
    mut i := 0
    until i < n:
        c := byte_at(rhs, i)
        if c == 34:
            i++
            until i < n and byte_at(rhs, i) != 34:
                if byte_at(rhs, i) == 92:
                    i++
                end
                i++
            end
            i++
            continue
        end
        if not ((c >= 48 and c <= 57) or c == 91 or c == 93 or c == 44 or c == 46 or c == 45 or
            c == 32):
            ret false
        end
        i++
    end
    ret true
end

func js_scalar_rhs(rhs: str): bool:
    n := str.Len(rhs)
    if n == 0:
        ret false
    end
    if str.Equals(rhs, "true") or str.Equals(rhs, "false") or str.Equals(rhs, "null"):
        ret true
    end
    if byte_at(rhs, 0) == 91:
        ret js_lit_rhs(rhs)
    end
    if byte_at(rhs, 0) == 34:
        mut i := 1
        until i < n and byte_at(rhs, i) != 34:
            if byte_at(rhs, i) == 92:
                i++
            end
            i++
        end
        ret i == n - 1
    end
    mut i := 0
    until i < n:
        c := byte_at(rhs, i)
        if not ((c >= 48 and c <= 57) or c == 45 or c == 46):
            ret false
        end
        i++
    end
    ret true
end

func js_simple_global(line: str): bool:
    t := str.Trim(line)
    mut kw := 0
    if str.StartsWith(t, "const "):
        kw = 6
    else str.StartsWith(t, "let "):
        kw = 4
    end
    if kw == 0 or not str.EndsWith(t, ";"):
        ret false
    end
    eqp := str.IndexFrom(t, " = ", kw)
    if eqp <= kw:
        ret false
    end
    nm := str.Substr(t, kw, eqp - kw)
    repeat str.Len(nm) in k:
        c := byte_at(nm, k)
        if not (is_alnum(c) or c == 95 or c == 36):
            ret false
        end
    end
    ret js_scalar_rhs(str.Substr(t, eqp + 3, str.Len(t) - eqp - 4))
end

func js_lit_global(line: str, name &: str): bool:
    t := str.Trim(line)
    if not str.StartsWith(t, "const ") or not str.EndsWith(t, ";"):
        ret false
    end
    eqp := str.IndexFrom(t, " = ", 6)
    if eqp <= 6:
        ret false
    end
    nm := str.Substr(t, 6, eqp - 6)
    repeat str.Len(nm) in k:
        c := byte_at(nm, k)
        if not (is_alnum(c) or c == 95 or c == 36):
            ret false
        end
    end
    if not js_lit_rhs(str.Substr(t, eqp + 3, str.Len(t) - eqp - 4)):
        ret false
    end
    name = nm
    ret true
end

func js_prune_globals(globals: Vector<str>, code: str, hoisted &: str): Vector<str>:
    mut keep_text := code
    mut lit := Vector {} as Vector<str>
    defer lit.Free()
    mut no_text := Vector {} as Vector<str>
    defer no_text.Free()
    mut referenced := Vector {} as Vector<int>
    defer referenced.Free()
    repeat globals.Len() in gi:
        each line in str.Split(globals.Get(gi), "\n"):
            mut nm := ""
            if js_lit_global(line, nm):
                lit.Push(nm.Concat(""))
                no_text.Push("")
                referenced.Push(0)
            else:
                keep_text += line + "\n"
            end
        end
    end
    js_mark_used(keep_text, lit, no_text, referenced)
    each held in lit:
        mem.Free(held as void*)
    end
    mut li := 0
    mut out := Vector {} as Vector<str>
    repeat globals.Len() in gi2:
        mut kept := ""
        each line in str.Split(globals.Get(gi2), "\n"):
            mut nm := ""
            if js_lit_global(line, nm):
                li++
                if referenced.Get(li - 1) == 0:
                    continue
                end
            end
            if js_simple_global(line):
                hoisted += str.Trim(line) + "\n"
                continue
            end
            if str.Len(line) > 0:
                kept += line + "\n"
            end
        end
        out.Push(kept)
    end
    ret out
end

func js_shake(
    mods &: JsMods,
    roots: str,
    seg_names: Vector<str>,
    seg_texts: Vector<str>,
    seg_used &: Vector<int>,
    keep_mods: int
):
    mut names := Vector {} as Vector<str>
    defer names.Free()
    mut texts := Vector {} as Vector<str>
    defer texts.Free()
    mut used := Vector {} as Vector<int>
    defer used.Free()
    repeat seg_names.Len() in i:
        names.Push(seg_names.Get(i))
        texts.Push(seg_texts.Get(i))
        used.Push(seg_used.Get(i))
    end
    mut all_roots := roots
    repeat mods.global_names.Len() in k:
        kept := mods.global_mod.Get(k) < keep_mods
        names.Push(mods.global_names.Get(k))
        texts.Push(mods.global_texts.Get(k))
        used.Push(kept ? 1 : 0)
        if kept:
            all_roots += mods.global_texts.Get(k)
        end
    end
    js_mark_used(all_roots, names, texts, used)
    nsegs := seg_names.Len()
    repeat nsegs in s:
        seg_used.Set(s, used.Get(s))
    end
    repeat mods.globals.Len() in m:
        mut text := ""
        repeat mods.global_names.Len() in g:
            if mods.global_mod.Get(g) == m and used.Get(nsegs + g) != 0:
                text += mods.global_texts.Get(g)
            end
        end
        mods.globals.Set(m, text)
    end
end

func js_mods_free(mods &: JsMods):
    mods.globals.Free()
    mods.seg_mod.Free()
    mods.global_names.Free()
    mods.global_texts.Free()
    mods.global_mod.Free()
    mods.fn_names.Free()
    mods.fn_texts.Free()
    mods.failed.Free()
    mods.mk.Free()
    mods.mv.Free()
end

func js_import_paths(a &: at.Ast, prog: int, idir: str, lang: str, work &: Vector<str>):
    pn := at.Get(a, prog)
    repeat pn.list.Len() in k:
        did := pn.list.Get(k)
        d := at.Get(a, did)
        if d.kind != at.AST_IMPORT:
            continue
        end
        mut ipath := d.type_str
        if str.Len(ipath) == 0:
            ipath = sm.ResolveImportNode(a, idir, did, lang)
        end
        if str.Len(ipath) == 0:
            continue
        end
        mut known := false
        repeat work.Len() in j2:
            if str.Equals(work.Get(j2), ipath):
                known = true
            end
        end
        if not known:
            work.Push(ipath)
        end
    end
end

func js_compile_work(
    lgr &: lg.Logger,
    opt &: Dr,
    pack: int,
    work &: Vector<str>,
    nentries: int,
    a &: at.Ast,
    minify_names: bool,
    minify_ws: bool,
    mods &: JsMods
): bool:
    mut all_ok := true
    mut wi := 0
    until wi < work.Len():
        path := work.Get(wi)
        mut dup := false
        repeat wi in j:
            if str.Equals(work.Get(j), path):
                dup = true
            end
        end
        if dup or (wi >= nentries and jsc_use(path, work, mods)):
            wi++
            continue
        end
        mut sf := src.New()
        if not src.Load(path, sf):
            lg.Log(
                lgr,
                lg.PH_DRIVER,
                lg.LOG_ERROR,
                co.Format2(
                    i18.Tr("cannot read source file '%s': %s"),
                    co.ArgStr(path),
                    co.ArgStr(i18.Tr(src.ReadError()))
                )
            )
            all_ok = false
            mods.failed.Push(path)
            wi++
            continue
        end
        mut table := cc.TableBuild(cc.JS_TARGET, opt.defines)
        modpack := lx.Detect(sf, pack)
        cc.TableSetPack(table, modpack)
        modentry := lp.Entry(modpack)
        module := module_of(path)
        lg.SetDiagSource(lgr, sf.text, sf.len, opt.diag_style, opt.diag_format)
        lg.AddDiagSource(lgr, path, sf.text, sf.len)
        if str.Len(mods.first_module) == 0:
            mods.first_module = module
        end
        lg.Log(
            lgr,
            lg.PH_DRIVER,
            lg.LOG_INFO,
            co.Format1(i18.Tr("compiling %s -> js"), co.ArgStr(path))
        )
        mut toks := tok.StreamNew(path)
        mut lok := lx.Run(lgr, modpack, sf, toks)
        mut prog := 0
        mut pok := ps.Run(lgr, toks, a, prog)
        tok.StreamFree(toks)
        if not cc.PruneProgram(a, lgr, path, table, prog):
            pok = false
        end
        mut pfiles := sm.PackageFiles(path)
        mut pi := 1
        until pi < pfiles.Len():
            ppath := pfiles.Get(pi)
            mut psf := src.New()
            if src.Load(ppath, psf):
                lg.AddDiagSource(lgr, ppath, psf.text, psf.len)
                mut ptoks := tok.StreamNew(ppath)
                if not lx.Run(lgr, modpack, psf, ptoks):
                    lok = false
                end
                mut pprog := 0
                if not ps.Run(lgr, ptoks, a, pprog):
                    pok = false
                end
                tok.StreamFree(ptoks)
                if not cc.PruneProgram(a, lgr, ppath, table, pprog):
                    pok = false
                end
                sm.MergeProgram(a, prog, pprog)
            else:
                lg.Log(
                    lgr,
                    lg.PH_DRIVER,
                    lg.LOG_ERROR,
                    co.Format2(
                        i18.Tr("cannot read source file '%s': %s"),
                        co.ArgStr(ppath),
                        co.ArgStr(i18.Tr(src.ReadError()))
                    )
                )
                all_ok = false
                mods.failed.Push(ppath)
            end
            pi++
        end
        pfiles.Free()

        _vw := lo.PrepareViews(lgr, modpack, table, a, prog, path)
        mut s := sm.New(lgr, path, lp.Code(modpack))
        sm.SetCc(s, table)
        sm.SetServerMode(1)
        sm.SetSkipStdBodies(s, true)
        sm.SetStdLints(s, path)
        sok := sm.RunCached(s, a, prog)
        if not lok or not pok or not sok:
            all_ok = false
            mods.failed.Push(path)
            sm.Free(s)
            wi++
            continue
        end

        js_import_paths(a, prog, dir_of(path), lp.Code(modpack), work)
        if s.prelude_err != 0:
            cpath := sm.ResolveImport("", "core")
            mut has_core := str.Len(cpath) == 0
            repeat work.Len() in j3:
                if str.Equals(work.Get(j3), cpath):
                    has_core = true
                end
            end
            if not has_core:
                work.Push(cpath)
            end
        end

        mut out := jg.NewOutput()
        jg.Run(
            lgr,
            a,
            s,
            prog,
            module,
            modentry,
            minify_names,
            minify_ws,
            mods.ml,
            mods.mk,
            mods.mv,
            out,
            opt.safe
        )
        mods.globals.Push(out.globals_src)
        repeat out.global_names.Len() in gn:
            mods.global_names.Push(out.global_names.Get(gn))
            mods.global_texts.Push(out.global_texts.Get(gn))
            mods.global_mod.Push(mods.count)
        end
        repeat out.fn_names.Len() in fi:
            mods.fn_names.Push(out.fn_names.Get(fi))
            mods.fn_texts.Push(out.fn_texts.Get(fi))
            mods.seg_mod.Push(mods.count)
        end
        if str.Len(mods.entry_name) == 0 and wi < nentries and str.Len(out.entry_mangled) > 0:
            mods.entry_name = out.entry_mangled
        end
        if wi >= nentries and jsc_applies(path):
            mut deps := Vector {} as Vector<str>
            js_import_paths(a, prog, dir_of(path), lp.Code(modpack), deps)
            core := s.prelude_err != 0 ? sm.ResolveImport("", "core") : ""
            jsc_keep(path, deps, core, out)
            deps.Free()
        end
        mods.count++
        jg.FreeOutput(out)
        sm.Free(s)
        wi++
    end
    ret all_ok
end

func js_build_bundle(
    lgr &: lg.Logger, opt &: Dr, entries: Vector<str>, module_out &: str, rc_out &: int
): str:
    rc_out = 0
    pack := lp.Load(opt.lang)
    if pack == lp.LP_NONE:
        lg.Log(
            lgr,
            lg.PH_DRIVER,
            lg.LOG_ERROR,
            co.Format1(i18.Tr("unknown language pack '%s'"), co.ArgStr(opt.lang))
        )
        rc_out = 2
        ret ""
    end
    sm.SetStdlibRoot(opt.stdlib_path)
    sm.LayoutSchemaInit(sm.GetStdlibRoot())

    minify_ws := not opt.no_minify
    minify_names := minify_ws and not opt.no_js_minify_names

    mut work := Vector {} as Vector<str>
    defer work.Free()
    repeat entries.Len() in ii:
        work.Push(entries.Get(ii))
    end
    if entries.Len() > 0:
        sm.SetProjectRootFrom(entries.Get(0))
    end
    defer sm.UnpinProjectRoot()

    mut a := at.NewAst()
    defer at.FreeAst(a)

    mut mods := JsMods {}
    defer js_mods_free(mods)
    all_ok := js_compile_work(
        lgr, opt, pack, work, entries.Len(), a, minify_names, minify_ws, mods
    )

    module_out = mods.first_module

    if not all_ok:
        lg.Log(
            lgr,
            lg.PH_DRIVER,
            lg.LOG_ERROR,
            abort_message(i18.Tr("build aborted: errors in source"), mods.failed)
        )
        rc_out = 1
        ret ""
    end
    if str.Len(mods.entry_name) == 0:
        lg.Log(
            lgr,
            lg.PH_DRIVER,
            lg.LOG_ERROR,
            co.Format1(
                i18.Tr("no entry point: define a '%s' function"), co.ArgStr(lp.Entry(pack))
            )
        )
        rc_out = 1
        ret ""
    end

    mut seg_names := Vector {} as Vector<str>
    mut seg_texts := Vector {} as Vector<str>
    mut seg_used := Vector {} as Vector<int>
    defer seg_names.Free()
    defer seg_texts.Free()
    defer seg_used.Free()
    repeat len(k_dr_js_prelude_names) in pi2:
        mut ptext := k_dr_js_prelude_texts[pi2]
        if minify_ws:
            ptext = mn.Js(ptext)
        end
        seg_names.Push(k_dr_js_prelude_names[pi2])
        seg_texts.Push(ptext)
        seg_used.Push(0)
    end
    mut m := mods.count - 1
    until m >= 0:
        repeat mods.fn_names.Len() in si:
            if mods.seg_mod.Get(si) == m:
                seg_names.Push(mods.fn_names.Get(si))
                seg_texts.Push(mods.fn_texts.Get(si))
                seg_used.Push(0)
            end
        end
        m--
    end

    boot := mods.entry_name
    js_shake(mods, boot + "\n", seg_names, seg_texts, seg_used, entries.Len())

    mut js := str.NewBuilder()
    str.BufAppend(
        js, minify_ws ? `(function(){"use strict";` : "(function () {\n\"use strict\";\n\n"
    )
    mut used_code := boot + "\n"
    repeat seg_names.Len() in ui:
        if seg_used.Get(ui) != 0:
            used_code += seg_texts.Get(ui)
        end
    end
    mut hoisted := ""
    pruned := js_prune_globals(mods.globals, used_code, hoisted)
    repeat seg_names.Len() in sgi2:
        if seg_used.Get(sgi2) != 0:
            str.BufAppend(js, seg_texts.Get(sgi2))
            str.BufAppendChar(js, minify_ws ? 32 : 10)
        end
    end
    mut have_globals := false
    mut m3 := mods.count - 1
    until m3 >= 0:
        if str.Len(pruned.Get(m3)) > 0:
            have_globals = true
        end
        m3--
    end
    if str.Len(hoisted) > 0:
        str.BufAppend(js, hoisted)
    end
    if have_globals:
        mut m4 := mods.count - 1
        until m4 >= 0:
            str.BufAppend(js, pruned.Get(m4))
            m4--
        end
        str.BufAppendChar(js, minify_ws ? 32 : 10)
    end
    if not minify_ws:
        str.BufAppend(js, "// Run the program once the DOM is ready.\n")
    end
    if minify_ws:
        str.BufAppend(
            js,
            `if(typeof document!=="undefined"&&document.readyState==="loading"){document.` +
                `addEventListener("DOMContentLoaded",` + boot + ");}else{" + boot + "();}"
        )
    else:
        str.BufAppend(
            js,
            "if (typeof document !== \"undefined\" && document.readyState === \"loading\") {\n" +
                "    document.addEventListener(" + `"DOMContentLoaded", ` + boot + ");\n" +
                "} else {\n    " + boot + "();\n}\n"
        )
    end
    str.BufAppend(js, minify_ws ? "})();" : "})();\n")
    text := str.BufStr(js)
    str.BufFree(js)
    ret text
end

func js_string_literal(s: str): str:
    ret "\"" + s + "\""
end

func collect_event_js(
    lgr &: lg.Logger,
    opt &: Dr,
    a &: at.Ast,
    s &: sm.Sema,
    prog: int,
    path: str,
    minify_ws: bool,
    handlers: Vector<str>,
    ok &: bool
): str:
    ok = true
    mut ml := ""
    mut mk := Vector {} as Vector<str>
    mut mv := Vector {} as Vector<str>
    defer mk.Free()
    defer mv.Free()
    mut out := jg.NewOutput()
    jg.Run(lgr, a, s, prog, "page", "", false, minify_ws, ml, mk, mv, out, opt.safe)

    if out.fn_names.Len() == 0 and str.Len(out.globals_src) == 0:
        jg.FreeOutput(out)
        ret ""
    end

    mut work := Vector {} as Vector<str>
    defer work.Free()
    js_import_paths(a, prog, dir_of(path), s.lang, work)
    mut ia := at.NewAst()
    defer at.FreeAst(ia)
    mut mods := JsMods {}
    defer js_mods_free(mods)
    if work.Len() > 0:
        pack := lp.Load(opt.lang)
        if not js_compile_work(lgr, opt, pack, work, 0, ia, false, minify_ws, mods):
            lg.Log(
                lgr,
                lg.PH_DRIVER,
                lg.LOG_ERROR,
                abort_message(i18.Tr("build aborted: errors in source"), mods.failed)
            )
            ok = false
            jg.FreeOutput(out)
            ret ""
        end
    end

    mut seg_names := Vector {} as Vector<str>
    mut seg_texts := Vector {} as Vector<str>
    mut seg_used := Vector {} as Vector<int>
    defer seg_names.Free()
    defer seg_texts.Free()
    defer seg_used.Free()
    repeat len(k_dr_js_prelude_names) in pi:
        mut ptext := k_dr_js_prelude_texts[pi]
        if minify_ws:
            ptext = mn.Js(ptext)
        end
        seg_names.Push(k_dr_js_prelude_names[pi])
        seg_texts.Push(ptext)
        seg_used.Push(0)
    end
    mut m := mods.count - 1
    until m >= 0:
        repeat mods.fn_names.Len() in si:
            if mods.seg_mod.Get(si) == m:
                seg_names.Push(mods.fn_names.Get(si))
                seg_texts.Push(mods.fn_texts.Get(si))
                seg_used.Push(0)
            end
        end
        m--
    end
    mut roots := out.globals_src
    repeat out.fn_texts.Len() in ri:
        roots += out.fn_texts.Get(ri)
    end
    js_shake(mods, roots, seg_names, seg_texts, seg_used, 0)

    mut js := str.NewBuilder()
    str.BufAppend(
        js, minify_ws ? `(function(){"use strict";` : "(function () {\n\"use strict\";\n\n"
    )
    mut page_code := out.globals_src
    repeat out.fn_texts.Len() in pi3:
        page_code += out.fn_texts.Get(pi3)
    end
    repeat seg_names.Len() in ui2:
        if seg_used.Get(ui2) != 0:
            page_code += seg_texts.Get(ui2)
        end
    end
    mut hoisted := ""
    pruned := js_prune_globals(mods.globals, page_code, hoisted)
    repeat seg_names.Len() in sgi2:
        if seg_used.Get(sgi2) != 0:
            str.BufAppend(js, seg_texts.Get(sgi2))
            str.BufAppendChar(js, minify_ws ? 32 : 10)
        end
    end
    if str.Len(hoisted) > 0:
        str.BufAppend(js, hoisted)
    end
    mut gm := mods.count - 1
    until gm >= 0:
        if str.Len(pruned.Get(gm)) > 0:
            str.BufAppend(js, pruned.Get(gm))
            str.BufAppendChar(js, minify_ws ? 32 : 10)
        end
        gm--
    end
    if str.Len(out.globals_src) > 0:
        str.BufAppend(js, out.globals_src)
        str.BufAppendChar(js, minify_ws ? 32 : 10)
    end
    repeat out.fn_texts.Len() in fi2:
        str.BufAppend(js, out.fn_texts.Get(fi2))
        str.BufAppendChar(js, minify_ws ? 32 : 10)
    end
    if lo.WebStateCount() > 0:
        mut crt := lo.WebStateCacheRuntime()
        if minify_ws:
            crt = mn.Js(crt)
        end
        str.BufAppend(js, crt)
        str.BufAppendChar(js, minify_ws ? 32 : 10)
    end
    if lo.RoutesActive():
        mut rrt := lo.RouteRuntime(jg.Ident("__salam_route_set"), jg.Ident("__salam_route_check"))
        if minify_ws:
            rrt = mn.Js(rrt)
        end
        str.BufAppend(js, rrt)
        str.BufAppendChar(js, minify_ws ? 32 : 10)
    end
    wcount := lo.WebStateCount()
    if wcount > 0:
        mut wviews := Vector {} as Vector<str>
        mut winits := Vector {} as Vector<str>
        repeat wcount in wi:
            wk := lo.WebStateKind(wi)
            wviews.Push(wk == 1 ? "null" : jg.Ident("__salam_view_" + co.U64Toa(wi as u64)))
            winits.Push(wk == 0 ? jg.Ident("__salam_init_" + co.U64Toa(wi as u64)) : "null")
        end
        mut wrt := lo.WebStateRuntime(wviews, winits)
        if minify_ws:
            wrt = mn.Js(wrt)
        end
        str.BufAppend(js, wrt)
        str.BufAppendChar(js, minify_ws ? 32 : 10)
        wviews.Free()
        winits.Free()
    end
    mut exposed := Vector {} as Vector<str>
    defer exposed.Free()
    each call in handlers:
        paren := str.IndexOf(call, "(")
        if paren <= 0:
            continue
        end
        src_name := call.Substr(0, paren)
        mut seen := false
        each prev in exposed:
            if str.Equals(prev, src_name):
                seen = true
            end
        end
        if seen:
            continue
        end
        exposed.Push(src_name)
        str.BufAppend(
            js, "window[" + js_string_literal(src_name) + "] = " + jg.Ident(src_name) + ";"
        )
        str.BufAppendChar(js, minify_ws ? 32 : 10)
    end
    str.BufAppend(js, minify_ws ? "})();" : "})();\n")
    text := str.BufStr(js)
    str.BufFree(js)
    jg.FreeOutput(out)
    ret text
end

func js_html_page(module: str, js_text: str, minify_ws: bool): str:
    mut b := str.NewBuilder()
    if minify_ws:
        str.BufAppend(b, `<!doctype html><html lang="en"><head>`)
        str.BufAppend(b, `<meta charset="utf-8">`)
        str.BufAppend(
            b, `<meta name="viewport" content="width=device-width, initial-scale=1">`
        )
        str.BufAppend(b, "<title>" + module + "</title>")
        str.BufAppend(b, "</head><body><script>")
        str.BufAppend(b, js_text)
        str.BufAppend(b, "</script></body></html>")
    else:
        str.BufAppend(b, "<!doctype html>\n<html lang=\"en\">\n<head>\n")
        str.BufAppend(b, "<meta charset=\"utf-8\">\n")
        str.BufAppend(
            b, "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n"
        )
        str.BufAppend(b, "<title>" + module + "</title>\n")
        str.BufAppend(b, "</head>\n<body>\n<script>\n")
        str.BufAppend(b, js_text)
        str.BufAppend(b, "</script>\n</body>\n</html>\n")
    end
    r := str.BufStr(b)
    str.BufFree(b)
    ret r
end

func plural_suffix(n: int): str:
    ret i18.Plural(n)
end

func path_ext2(stem: str, ext: str): str:
    ret stem + "." + ext
end

func join_path2(dir: str, rel: str): str:
    ret pth.PathJoin(dir, rel)
end

func base_name(p: str): str:
    ret pth.PathBase(p)
end

func strip_ext(p: str): str:
    base := pth.PathBase(p)
    dot := str.LastIndex(base, ".")
    if dot >= 0:
        ret str.Substr(p, 0, str.Len(p) - (str.Len(base) - dot))
    end
    ret p
end

func script_salam_src(a &: at.Ast, el: int): str:
    n := at.Get(a, el)
    repeat n.list.Len() in j:
        attr := at.Get(a, n.list.Get(j))
        if attr.kind != at.AST_LAYOUT_ATTR or str.Len(attr.name) == 0:
            continue
        end
        if not str.Equals(attr.name, "src") and not str.Equals(attr.name, "url"):
            continue
        end
        if attr.a != 0:
            av := at.Get(a, attr.a)
            if av.kind == at.AST_LITERAL and av.value_kind == tok.TV_STRING and str.Len(
                av.value_str
            ) > 0 and str.EndsWith(
                av.value_str, ".salam"
            ):
                ret av.value_str
            end
        end
    end
    ret ""
end

func collect_scripts(a &: at.Ast, node: int, out &: Vector<str>):
    if node == 0:
        ret
    end
    n := at.Get(a, node)
    mut kept := Vector {} as Vector<int>
    repeat n.list.Len() in i:
        ch := n.list.Get(i)
        chn := at.Get(a, ch)
        mut removed := false
        if chn.kind == at.AST_LAYOUT_ELEMENT:
            if str.Equals(chn.name, "script"):
                sp := script_salam_src(a, ch)
                if str.Len(sp) > 0:
                    out.Push(sp)
                    removed = true
                end
            end
            if not removed:
                collect_scripts(a, ch, out)
            end
        end
        if not removed:
            kept.Push(ch)
        end
    end
    mut nn := at.Get(a, node)
    old := nn.list
    nn.list = kept
    at.Put(a, node, nn)
    defer old.Free()
end
