package driver

import io
import str
import mem

include pth "../sal_path.salam"
include sm "../semantic/semantic.salam"
include jg "../jsgen/jsgen.salam"

const K_DR_JSC_MAGIC := "salam-js-cache-3"

mut g_dr_jsc_on := false
mut g_dr_jsc_read := false
mut g_dr_jsc_keys := Vector {} as Vector<str>
mut g_dr_jsc_vals := Vector {} as Vector<JsCached>
mut g_dr_jsc_ix := HashMap {} as HashMap<str, int>

struct JsCached:
    pub deps: Vector<str> = Vector {}
    pub core: str = ""
    pub global_names: Vector<str> = Vector {}
    pub global_texts: Vector<str> = Vector {}
    pub names: Vector<str> = Vector {}
    pub texts: Vector<str> = Vector {}
end

struct JsCacheReader:
    pub text: str = ""
    pub len: int = 0
    pub pos: int = 0
    pub bad: bool = false
end

func jsc_add(key: str, entry: JsCached):
    if g_dr_jsc_ix.Has(key):
        ret
    end
    held := str.Clone(key)
    g_dr_jsc_ix.Put(held, g_dr_jsc_vals.Len())
    g_dr_jsc_keys.Push(held)
    g_dr_jsc_vals.Push(entry)
end

func jsc_put(b &: str.StringBuilder, field: str):
    str.BufAppend(b, str.FromInt(str.Len(field) as i64))
    str.BufAppendChar(b, 10)
    str.BufAppend(b, field)
end

func jsc_take(r &: JsCacheReader): str:
    mut n := 0
    mut digits := 0
    until r.pos < r.len:
        c := byte_at(r.text, r.pos)
        if c < 48 or c > 57 or digits > 8:
            break
        end
        n = n * 10 + (c - 48)
        digits++
        r.pos++
    end
    if digits == 0 or r.pos >= r.len or byte_at(r.text, r.pos) != 10 or n > r.len - r.pos - 1:
        r.bad = true
        r.pos = r.len
        ret ""
    end
    r.pos++
    out := mem.MustAllocateZeroed((n + 1) as u64)
    from := (r.text as void*) as i64 + r.pos as i64
    mem.Copy(out, from as void*, n as u64)
    r.pos += n
    ret out as str
end

func jsc_take_count(r &: JsCacheReader): int:
    field := jsc_take(r)
    limit := (r.len - r.pos) / 2
    digits := str.Len(field)
    mut n := 0
    mut ok := digits > 0
    mut i := 0
    until ok and i < digits:
        d := byte_at(field, i) - 48
        if d < 0 or d > 9 or d > limit or n > (limit - d) / 10:
            ok = false
        else:
            n = n * 10 + d
            i++
        end
    end
    if not ok:
        r.bad = true
        r.pos = r.len
        ret 0
    end
    ret n
end

func jsc_take_list(r &: JsCacheReader, out &: Vector<str>):
    repeat jsc_take_count(r):
        out.Push(jsc_take(r))
    end
end

func jsc_take_pairs(r &: JsCacheReader, names &: Vector<str>, texts &: Vector<str>):
    repeat jsc_take_count(r):
        names.Push(jsc_take(r))
        texts.Push(jsc_take(r))
    end
end

func jsc_parse(text: str, keys &: Vector<str>, vals &: Vector<JsCached>): bool:
    mut r := JsCacheReader {}
    r.text = text
    r.len = str.Len(text)
    if not str.Equals(jsc_take(r), K_DR_JSC_MAGIC):
        ret false
    end
    until r.pos < r.len:
        key := jsc_take(r)
        mut e := JsCached {}
        e.core = jsc_take(r)
        jsc_take_list(r, e.deps)
        jsc_take_pairs(r, e.global_names, e.global_texts)
        jsc_take_pairs(r, e.names, e.texts)
        if r.bad:
            break
        end
        keys.Push(key)
        vals.Push(e)
    end
    ret not r.bad
end

func jsc_read_shipped():
    if g_dr_jsc_read:
        ret
    end
    g_dr_jsc_read = true
    text := io.ReadFile(pth.PathJoin(sm.GetStdlibRoot(), "std/js.cache"))
    if str.Len(text) == 0:
        ret
    end
    mut keys := Vector {} as Vector<str>
    mut vals := Vector {} as Vector<JsCached>
    _complete := jsc_parse(
        text, keys, vals
    )
    repeat keys.Len() in i:
        jsc_add(keys.Get(i), vals.Get(i))
    end
    keys.Free()
    vals.Free()
    mem.Free(text as void*)
end

func jsc_applies(path: str): bool:
    ret g_dr_jsc_on and sm.IsStdSource(path)
end

func jsc_queue(path: str, work &: Vector<str>):
    if str.Len(path) == 0:
        ret
    end
    repeat work.Len() in i:
        if str.Equals(work.Get(i), path):
            ret
        end
    end
    work.Push(path)
end

func jsc_use(path: str, work &: Vector<str>, mods &: JsMods): bool:
    if not jsc_applies(path):
        ret false
    end
    jsc_read_shipped()
    if not g_dr_jsc_ix.Has(path):
        ret false
    end
    e := g_dr_jsc_vals.Get(g_dr_jsc_ix.Get(path))
    if str.Len(mods.first_module) == 0:
        mods.first_module = module_of(path)
    end
    each dep in e.deps:
        jsc_queue(dep, work)
    end
    jsc_queue(e.core, work)
    mods.globals.Push("")
    repeat e.global_names.Len() in g:
        mods.global_names.Push(e.global_names.Get(g))
        mods.global_texts.Push(e.global_texts.Get(g))
        mods.global_mod.Push(mods.count)
    end
    repeat e.names.Len() in i:
        mods.fn_names.Push(e.names.Get(i))
        mods.fn_texts.Push(e.texts.Get(i))
        mods.seg_mod.Push(mods.count)
    end
    mods.count++
    ret true
end

func jsc_keep(path: str, deps: Vector<str>, core: str, out &: jg.Output):
    if not jsc_applies(path) or out.uses_lang:
        ret
    end
    mut e := JsCached {}
    e.core = str.Clone(core)
    each dep in deps:
        e.deps.Push(str.Clone(dep))
    end
    repeat out.global_names.Len() in g:
        e.global_names.Push(str.Clone(out.global_names.Get(g)))
        e.global_texts.Push(str.Clone(out.global_texts.Get(g)))
    end
    repeat out.fn_names.Len() in i:
        e.names.Push(str.Clone(out.fn_names.Get(i)))
        e.texts.Push(str.Clone(out.fn_texts.Get(i)))
    end
    jsc_add(path, e)
end

func jsc_put_count(b &: str.StringBuilder, n: int):
    jsc_put(b, str.FromInt(n as i64))
end

func jsc_put_pairs(b &: str.StringBuilder, names: Vector<str>, texts: Vector<str>):
    jsc_put_count(b, names.Len())
    repeat names.Len() in i:
        jsc_put(b, names.Get(i))
        jsc_put(b, texts.Get(i))
    end
end

func jsc_serialize(keys: Vector<str>, vals: Vector<JsCached>): str:
    mut b := str.NewBuilder()
    jsc_put(b, K_DR_JSC_MAGIC)
    repeat vals.Len() in i:
        e := vals.Get(i)
        jsc_put(b, keys.Get(i))
        jsc_put(b, e.core)
        jsc_put_count(b, e.deps.Len())
        each dep in e.deps:
            jsc_put(b, dep)
        end
        jsc_put_pairs(b, e.global_names, e.global_texts)
        jsc_put_pairs(b, e.names, e.texts)
    end
    out := str.BufStr(b)
    str.BufFree(b)
    ret out
end

pub func ReuseStdScripts(enabled: bool):
    g_dr_jsc_on = enabled
end

pub func StdScriptCache(): str:
    out := jsc_serialize(g_dr_jsc_keys, g_dr_jsc_vals)
    mut keys := Vector {} as Vector<str>
    mut vals := Vector {} as Vector<JsCached>
    complete := jsc_parse(
        out, keys, vals
    )
    again := jsc_serialize(keys, vals)
    same := complete and vals.Len() > 0 and str.Equals(again, out)
    mem.Free(again as void*)
    keys.Free()
    vals.Free()
    ret same ? out : ""
end
