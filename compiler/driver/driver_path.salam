package driver

import os
import str
import lg "../logger.salam"
import i18 "../i18n.salam"
import co "../sal_core.salam"
import pth "../sal_path.salam"
import fs

    inline func byte_at(s: str, i: int): int: ret co.ByteAt(s, i) end

    func module_of(path: str): str:
        ret pth.PathStem(path)
    end

    func dir_of(path: str): str:
        ret pth.PathDir(path)
    end

    func project_entry_file(dir: str): str:
        p := pth.PathNormalize(pth.PathJoin(dir, "salam.salam"))
        if os.Exists(p) && !os.IsDir(p):
            ret p
        end
        ret ""
    end

    func output_stem_of(path: str): str:
        module := module_of(path)
        if !str.Equals(module, "salam"):
            ret module
        end
        mut dir := dir_of(path)
        if str.Len(dir) == 0 || str.Equals(dir, "."):
            dir = os.Cwd()
        end
        base := pth.PathBase(pth.PathTrimSep(dir))
        if str.Len(base) == 0 || str.Equals(base, ".") || str.Equals(base, ".."):
            ret module
        end
        ret base
    end

    func page_stem_of(path: str): str:
        module := module_of(path)
        if str.Equals(module, "salam"):
            ret "index"
        end
        ret module
    end

    func triple_is_windows(t: str): bool:
        if str.Len(t) == 0:
            if SALAM_OS_WINDOWS:
                ret true
            else:
                ret false
            end
        end
        ret str.Contains(t, "windows") || str.Contains(t, "mingw") || str.Contains(t, "win32")
    end

    func exe_suffix_for(triple: str): str:
        if triple_is_windows(triple):
            ret ".exe"
        end
        ret ""
    end

    func exe_name_for(name: str, triple: str): str:
        ext := exe_suffix_for(triple)
        if str.Len(ext) == 0:
            ret name
        end
        if str.EndsWith(str.Lower(name), ext):
            ret name
        end
        ret name + ext
    end

    func write_file(lgr: lg.Logger, path: str, content: str): bool:
        if os.WriteFile(path, content) < 0:
            lg.Log(
                lgr, lg.PH_DRIVER, lg.LOG_ERROR, co.Format1(i18.Tr("cannot write '%s'"), co.ArgStr(path))
            )
            ret false
        end
        ret true
    end

    func file_unchanged(path: str, content: str): bool:
        if !os.Exists(path):
            ret false
        end
        ret str.Equals(os.ReadFile(path), content)
    end

    func scratch_dir(): str:
        dir := ".salam-build"
        if os.MkdirAll(dir) != 0:
            ret "."
        end
        ret dir
    end

    func manifest_path(scratch: str): str:
        ret pth.PathJoin(scratch, "salam_build.manifest")
    end

    func build_signature(opt &: Dr): str:
        mut sig := opt.cc + "|" + (opt.debug_info ? "g" : "") + "|" + (opt.asan ? "a" : "") + "|" + (opt.lto ? "l" : "") + "|" + (opt.safe ? "s" : "") + "|" + opt.stdlib_path + "|" + opt.lang + "|" + opt.output
        repeat opt.defines.len() with di:
            sig = sig + "|D" + opt.defines.get(di)
        end
        repeat opt.exports.len() with ei:
            sig = sig + "|E" + opt.exports.get(ei)
        end
        ret sig
    end

    func write_build_manifest(scratch: str, sig: str, sources: Vector<str>): bool:
        mut sb := str.NewBuilder()
        str.BufAppend(sb, sig)
        str.BufAppendChar(sb, 10)
        repeat sources.len() with i:
            str.BufAppend(sb, sources.get(i))
            str.BufAppendChar(sb, 10)
        end
        txt := str.BufStr(sb)
        str.BufFree(sb)
        ret write_file(lg.New(lg.LOG_OFF, false), manifest_path(scratch), txt)
    end

    func resolve_output_path(output: str): str:
        if os.Exists(output):
            ret output
        end
        if SALAM_OS_WINDOWS:
            if !str.EndsWith(output, ".exe") && os.Exists(output + ".exe"):
                ret output + ".exe"
            end
        end
        ret output
    end

    func build_up_to_date(scratch: str, sig: str, output0: str): bool:
        mpath := manifest_path(scratch)
        output := resolve_output_path(output0)
        if !os.Exists(mpath) || !os.Exists(output):
            ret false
        end
        txt := os.ReadFile(mpath)
        lines := str.Split(txt, "\n")
        if lines.len() < 2:
            ret false
        end
        if !str.Equals(lines.get(0), sig):
            ret false
        end
        out_mtime := fs.ModTime(output)
        mut saw_source := false
        repeat lines.len() with li:
            if li == 0:
                continue
            end
            src_path := lines.get(li)
            if str.Len(src_path) == 0:
                continue
            end
            if !os.Exists(src_path):
                ret false
            end
            if fs.ModTime(src_path) > out_mtime:
                ret false
            end
            saw_source = true
        end
        ret saw_source
    end
