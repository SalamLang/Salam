package driver

import os
import str
import fs

include lg "../logger.salam"
include i18 "../i18n.salam"
include co "../sal_core.salam"
include pth "../sal_path.salam"
include sm "../semantic/semantic.salam"

inline func byte_at(s: str, i: int): int: ret co.ByteAt(s, i) end

func module_of(path: str): str:
    ret pth.PathStem(path)
end

func dir_of(path: str): str:
    ret pth.PathDir(path)
end

func project_entry_file(dir: str): str:
    p := pth.PathNormalize(pth.PathJoin(dir, "main.salam"))
    if os.Exists(p) and not os.IsDir(p):
        ret p
    end
    ret ""
end

func project_output_name(dir: str): str:
    mut d := dir
    if str.Len(d) == 0 or str.Equals(d, "."):
        d = os.Cwd()
    end
    base := pth.PathBase(pth.PathTrimSep(d))
    if str.Len(base) == 0 or str.Equals(base, ".") or str.Equals(base, ".."):
        ret "main"
    end
    ret base
end

func output_stem_of(path: str): str:
    ret module_of(path)
end

func page_stem_of(path: str): str:
    module := module_of(path)
    if str.Equals(module, "main"):
        ret "index"
    end
    ret module
end

func triple_is_windows(t: str): bool:
    if str.Len(t) == 0:
        if SALAM_OS_WINDOWS:
            ret true
        else:
            ret false
        end
    end
    ret str.Contains(t, "windows") or str.Contains(t, "mingw") or str.Contains(t, "win32")
end

func exe_suffix_for(triple: str): str:
    if triple_is_windows(triple):
        ret ".exe"
    end
    ret ""
end

func exe_name_for(name: str, triple: str): str:
    ext := exe_suffix_for(triple)
    if str.Len(ext) == 0:
        ret name
    end
    if str.EndsWith(str.Lower(name), ext):
        ret name
    end
    ret name + ext
end

func write_file(lgr: lg.Logger, path: str, content: str): bool:
    if os.WriteFile(path, content) < 0:
        lg.Log(
            lgr, lg.PH_DRIVER, lg.LOG_ERROR, co.Format1(i18.Tr("cannot write '%s'"), co.ArgStr(path))
        )
        ret false
    end
    ret true
end

func file_unchanged(path: str, content: str): bool:
    if not os.Exists(path):
        ret false
    end
    ret str.Equals(os.ReadFile(path), content)
end

func scratch_dir(): str:
    mut dir := os.Env("SALAM_BUILD_DIR")
    if str.Len(dir) == 0:
        dir = ".salam-build"
    end
    if os.MkdirAll(dir) != 0:
        ret "."
    end
    ret dir
end

func manifest_path(scratch: str): str:
    ret pth.PathJoin(scratch, "salam_build.manifest")
end

func build_signature(opt &: Dr): str:
    mut sig := opt.cc + "|" + (opt.debug_info ? "g" + str.FromInt(opt.dwarf_version as i64) : "") + "|" + (opt.asan ? "a" : "") + "|" + (opt.lto ? "l" : "") + "|" + (opt.safe ? "s" : "") + "|" + opt.stdlib_path + "|" + opt.lang + "|" + opt.output
    repeat opt.defines.Len() in di:
        sig = sig + "|D" + opt.defines.Get(di)
    end
    repeat opt.consts.Len() in ci:
        sig = sig + "|d" + opt.consts.Get(ci)
    end
    repeat opt.exports.Len() in ei:
        sig = sig + "|E" + opt.exports.Get(ei)
    end
    repeat opt.inputs.Len() in ii:
        sig = sig + "|I" + opt.inputs.Get(ii)
    end
    ret sig
end

func write_build_manifest(scratch: str, sig: str, sources: Vector<str>): bool:
    mut sb := str.NewBuilder()
    str.BufAppend(sb, sig)
    str.BufAppendChar(sb, 10)
    mut seen := Vector {} as Vector<str>
    repeat sources.Len() in i:
        p := sources.Get(i)
        mut dup := false
        repeat seen.Len() in j:
            if str.Equals(seen.Get(j), p):
                dup = true
                break
            end
        end
        if dup:
            continue
        end
        seen.Push(p)
        str.BufAppend(sb, p)
        str.BufAppendChar(sb, 10)
    end
    seen.Free()
    txt := str.BufStr(sb)
    str.BufFree(sb)
    ret write_file(lg.New(lg.LOG_OFF, false), manifest_path(scratch), txt)
end

func resolve_output_path(output: str): str:
    if os.Exists(output):
        ret output
    end
    if SALAM_OS_WINDOWS:
        if not str.EndsWith(output, ".exe") and os.Exists(output + ".exe"):
            ret output + ".exe"
        end
    end
    ret output
end

func build_up_to_date(scratch: str, sig: str, output0: str): bool:
    mpath := manifest_path(scratch)
    output := resolve_output_path(output0)
    if not os.Exists(mpath) or not os.Exists(output):
        ret false
    end
    txt := os.ReadFile(mpath)
    lines := str.Split(txt, "\n")
    if lines.Len() < 2:
        ret false
    end
    if not str.Equals(lines.Get(0), sig):
        ret false
    end
    out_mtime := fs.ModTime(output)
    mut exe := ""
    if sm.ExePath(exe) and os.Exists(exe) and fs.ModTime(exe) > out_mtime:
        ret false
    end
    mut saw_source := false
    repeat lines.Len() in li:
        if li == 0:
            continue
        end
        src_path := lines.Get(li)
        if str.Len(src_path) == 0:
            continue
        end
        if not os.Exists(src_path):
            ret false
        end
        if fs.ModTime(src_path) > out_mtime:
            ret false
        end
        saw_source = true
    end
    ret saw_source
end
