package driver

import os
import str
import fs

include lg "../logger.salam"
include i18 "../i18n.salam"
include co "../sal_core.salam"
include pth "../sal_path.salam"
include sm "../semantic/semantic.salam"

inline func byte_at(s: str, i: int): int: ret co.ByteAt(s, i) end

func module_of(path: str): str:
    ret pth.PathStem(path)
end

func dir_of(path: str): str:
    ret pth.PathDir(path)
end

func project_entry_file(dir: str): str:
    p := pth.PathNormalize(pth.PathJoin(dir, "main.salam"))
    if os.Exists(p) and not os.IsDir(p):
        ret p
    end
    ret ""
end

func project_output_name(dir: str): str:
    mut d := dir
    if str.Len(d) == 0 or str.Equals(d, "."):
        d = os.Cwd()
    end
    base := pth.PathBase(pth.PathTrimSep(d))
    if str.Len(base) == 0 or str.Equals(base, ".") or str.Equals(base, ".."):
        ret "main"
    end
    ret base
end

func output_stem_of(path: str): str:
    ret module_of(path)
end

func page_stem_of(path: str): str:
    module := module_of(path)
    if str.Equals(module, "main"):
        ret "index"
    end
    ret module
end

func triple_is_windows(t: str): bool:
    if str.Len(t) == 0:
        if SALAM_OS_WINDOWS:
            ret true
        else:
            ret false
        end
    end
    ret str.Contains(t, "windows") or str.Contains(t, "mingw") or str.Contains(t, "win32")
end

func exe_suffix_for(triple: str): str:
    if triple_is_windows(triple):
        ret ".exe"
    end
    ret ""
end

func exe_name_for(name: str, triple: str): str:
    ext := exe_suffix_for(triple)
    if str.Len(ext) == 0:
        ret name
    end
    if str.EndsWith(str.Lower(name), ext):
        ret name
    end
    ret name + ext
end

func write_file(lgr: lg.Logger, path: str, content: str): bool:
    if os.WriteFile(path, content) < 0:
        lg.Log(
            lgr, lg.PH_DRIVER, lg.LOG_ERROR, co.Format1(i18.Tr("cannot write '%s'"), co.ArgStr(path))
        )
        ret false
    end
    ret true
end

func file_unchanged(path: str, content: str): bool:
    if not os.Exists(path):
        ret false
    end
    ret str.Equals(os.ReadFile(path), content)
end

func scratch_dir(): str:
    mut dir := os.Env("SALAM_BUILD_DIR")
    if str.Len(dir) == 0:
        dir = ".salam-build"
    end
    if os.MkdirAll(dir) != 0:
        ret "."
    end
    ret dir
end

if SALAM_OS_WINDOWS:
    func lock_dir_open(path: str): int:
        ret -1
    end

    func lock_fd_take(fd: int): bool:
        ret true
    end

    func lock_fd_drop(fd: int):
        ret
    end
else:
    extern:
        func flock(fd: int, operation: int): int
        func open(path: str, flags: int, ...): int
        func close(fd: int): int
    end

    func lock_dir_open(path: str): int:
        mut flags := 0o100 | 2 | 0o2000000
        if SALAM_OS_MAC:
            flags = 0x200 | 2 | 0x1000000
        end
        ret open(path, flags, 0o600)
    end

    func lock_fd_take(fd: int): bool:
        ret flock(fd, 2) == 0
    end

    func lock_fd_drop(fd: int):
        _u := flock(fd, 8)
        _c := close(fd)
    end
end

func lock_scratch(scratch: str): int:
    ret lock_scratch_named(scratch, ".build.lock")
end

func unlock_scratch(fd: int):
    if fd >= 0:
        lock_fd_drop(fd)
    end
end

func abs_of(p: str): str:
    if pth.PathIsAbs(p):
        ret pth.PathNormalize(p)
    end
    ret pth.PathNormalize(pth.PathJoin(os.Cwd(), p))
end

func entry_key(entry: str): str:
    mut h1 := 2166136261 as u64
    mut h2 := 5381 as u64
    repeat str.Len(entry) in i:
        b := byte_at(entry, i) as u64
        h1 = ((h1 ^ b) * (16777619 as u64)) & (4294967295 as u64)
        h2 = ((h2 * (33 as u64)) + b) & (4294967295 as u64)
    end
    ret str.FromInt(h1 as i64) + "-" + str.FromInt(h2 as i64)
end

func scratch_for(opt &: Dr): str:
    if str.Len(os.Env("SALAM_BUILD_DIR")) > 0 or opt.inputs.Len() == 0:
        ret scratch_dir()
    end
    base := scratch_dir()
    key := entry_key(abs_of(opt.inputs.Get(0)))
    claim := lock_scratch_named(base, ".claim.lock")
    owner := pth.PathJoin(base, ".owner")
    mut cur := ""
    if os.Exists(owner):
        cur = os.ReadFile(owner)
    end
    mut dir := base
    if str.Len(cur) == 0 or str.Equals(cur, key):
        if not str.Equals(cur, key):
            _w := os.WriteFile(owner, key)
        end
    else:
        dir = pth.PathJoin(base, key)
        if os.MkdirAll(dir) != 0:
            dir = base
        end
    end
    unlock_scratch(claim)
    ret dir
end

func lock_scratch_named(scratch: str, name: str): int:
    fd := lock_dir_open(pth.PathJoin(scratch, name))
    if fd < 0:
        ret -1
    end
    if not lock_fd_take(fd):
        lock_fd_drop(fd)
        ret -1
    end
    ret fd
end

func manifest_path(scratch: str): str:
    ret pth.PathJoin(scratch, "salam_build.manifest")
end

func build_signature(opt &: Dr): str:
    mut sig := opt.cc + "|" + (opt.debug_info ? "g" + str.FromInt(opt.dwarf_version as i64) : "") + "|" + (opt.asan ? "a" : "") + "|" + (opt.lto ? "l" : "") + "|" + (opt.safe ? "s" : "") + "|" + opt.stdlib_path + "|" + opt.lang + "|" + opt.output
    sig = sig + "|" + (opt.protect ? "p" : "") + "|" + opt.backend + "|" + opt.llvm_target + "|O" + str.FromInt(opt.llvm_opt_level as i64) + "|" + opt.cpu + "|" + opt.linker + "|" + opt.lib_kind + "|" + opt.entry_symbol + "|" + opt.linker_script + "|u" + str.FromInt(opt.ui_target as i64)
    sig = sig + "|" + (opt.fast_math ? "f" : "") + (opt.llvm_native_cpu ? "n" : "") + (opt.llvm_fp_contract ? "c" : "") + (opt.icf ? "i" : "") + (opt.no_freestanding_runtime ? "r" : "")
    repeat opt.link_objects.Len() in li:
        sig = sig + "|L" + opt.link_objects.Get(li)
    end
    repeat opt.lib_paths.Len() in lpi:
        sig = sig + "|P" + opt.lib_paths.Get(lpi)
    end
    repeat opt.defines.Len() in di:
        sig = sig + "|D" + opt.defines.Get(di)
    end
    repeat opt.consts.Len() in ci:
        sig = sig + "|d" + opt.consts.Get(ci)
    end
    repeat opt.exports.Len() in ei:
        sig = sig + "|E" + opt.exports.Get(ei)
    end
    repeat opt.inputs.Len() in ii:
        sig = sig + "|I" + opt.inputs.Get(ii)
    end
    ret sig
end

func write_build_manifest(scratch: str, sig: str, sources: Vector<str>): bool:
    mut sb := str.NewBuilder()
    str.BufAppend(sb, sig)
    str.BufAppendChar(sb, 10)
    mut seen := Vector {} as Vector<str>
    repeat sources.Len() in i:
        p := sources.Get(i)
        mut dup := false
        repeat seen.Len() in j:
            if str.Equals(seen.Get(j), p):
                dup = true
                break
            end
        end
        if dup:
            continue
        end
        seen.Push(p)
        str.BufAppend(sb, p)
        str.BufAppendChar(sb, 10)
    end
    seen.Free()
    txt := str.BufStr(sb)
    str.BufFree(sb)
    ret write_file(lg.New(lg.LOG_OFF, false), manifest_path(scratch), txt)
end

func resolve_output_path(output: str): str:
    if os.Exists(output):
        ret output
    end
    if SALAM_OS_WINDOWS:
        if not str.EndsWith(output, ".exe") and os.Exists(output + ".exe"):
            ret output + ".exe"
        end
    end
    ret output
end

func build_up_to_date(scratch: str, sig: str, output0: str): bool:
    mpath := manifest_path(scratch)
    output := resolve_output_path(output0)
    if not os.Exists(mpath) or not os.Exists(output):
        ret false
    end
    txt := os.ReadFile(mpath)
    lines := str.Split(txt, "\n")
    if lines.Len() < 2:
        ret false
    end
    if not str.Equals(lines.Get(0), sig):
        ret false
    end
    out_mtime := fs.ModTime(output)
    mut exe := ""
    if sm.ExePath(exe) and os.Exists(exe) and fs.ModTime(exe) >= out_mtime:
        ret false
    end
    mut saw_source := false
    repeat lines.Len() in li:
        if li == 0:
            continue
        end
        src_path := lines.Get(li)
        if str.Len(src_path) == 0:
            continue
        end
        if not os.Exists(src_path):
            ret false
        end
        if fs.ModTime(src_path) >= out_mtime:
            ret false
        end
        saw_source = true
    end
    ret saw_source
end
