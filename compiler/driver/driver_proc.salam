package driver

import os
import str
import cc "../condcomp.salam"
import lv "../llvmgen/llvmgen.salam"
import thread
import sync

    // POSIX system()'s return packs the child's exit status in bits 8-15
    // (glibc WEXITSTATUS); same idiom compiler/std/os/os.salam's _proc_status
    // already uses. On Windows, system() already returns the raw exit code.
    func proc_status(code: int): int:
        if SALAM_OS_WINDOWS:
            ret code
        else:
            if code < 0:
                ret 1
            end
            ret (code / 256) % 256
        end
    end

    // stderr_is_tty - single home for the isatty/_isatty OS split, so callers
    // (just resolve_color today) don't each need their own SALAM_OS_WINDOWS
    // branch duplicating this.
    func stderr_is_tty(): bool:
        if SALAM_OS_WINDOWS:
            ret _isatty(2) != 0
        else:
            ret isatty(2) != 0
        end
    end

    // driver/driver.c resolve_color
    func resolve_color(flag: int): bool:
        if flag == 1:
            ret true
        end
        if flag == 0:
            ret false
        end
        ret stderr_is_tty()
    end

    // Thread entry point (spawn() requires a plain, zero-arg, void-returning
    // top-level function - see semantic.salam's "spawn" builtin check).
    func compile_worker():
        mut running := true
        until running:
            sync.Lock(g_cw_mu)
            mut idx := 0 - 1
            if g_cw_next < g_cw_jobs.len():
                idx = g_cw_next
                g_cw_next += 1
            end
            sync.Unlock(g_cw_mu)
            if idx < 0:
                running = false
            else:
                job_rc := proc_status(system(g_cw_jobs.get(idx)))
                if job_rc != 0:
                    sync.Lock(g_cw_mu)
                    if g_cw_rc == 0:
                        g_cw_rc = job_rc
                    end
                    sync.Unlock(g_cw_mu)
                end
            end
        end
    end

    // Best-effort logical CPU count (NUMBER_OF_PROCESSORS on Windows,
    // `nproc` elsewhere); falls back to 4 workers if detection fails.
    func cpu_count(): int:
        mut txt := ""
        if SALAM_OS_WINDOWS:
            txt = os.Env("NUMBER_OF_PROCESSORS")
        else:
            res := os.RunCapture("nproc")
            txt = str.TrimRight(res.out)
        end
        n := str.Len(txt)
        if n == 0:
            ret 4
        end
        mut v := 0
        repeat n with i:
            c := byte_at(txt, i)
            if c < 48 || c > 57:
                ret 4
            end
            v = v * 10 + (c - 48)
        end
        if v <= 0:
            ret 4
        end
        ret v
    end

    // Runs `jobs` (each a complete "cc ... -c file -o file.o" command)
    // across min(cpu_count(), jobs.len()) worker threads. Returns the
    // first nonzero exit code seen (0 if every job succeeded).
    func compile_parallel(jobs: Vector<str>): int:
        if jobs.len() == 0:
            ret 0
        end
        g_cw_mu = sync.NewMutex()
        g_cw_jobs = jobs
        g_cw_next = 0
        g_cw_rc = 0
        mut workers := cpu_count()
        if workers > jobs.len():
            workers = jobs.len()
        end
        if workers < 1:
            workers = 1
        end
        mut threads := Vector {} as Vector<thread.Thread>
        repeat workers:
            threads.push(thread.New(spawn(compile_worker)))
        end
        thread.JoinAll(threads)
        threads.free()
        ret g_cw_rc
    end

    // driver/build.c build_use_llvm. Both compilers now gate on the same
    // question: was static in-process LLVM linked into THIS binary
    // (SALAM_HAVE_LLVM in the C, lb.Available() here). Deliberately not "is
    // there a clang somewhere on this machine" - a Salam install must not
    // depend on clang/llvm/lld being present, so `auto` never shells out to
    // a toolchain the user did not ask for. The C backend is not deprecated
    // by this: --backend=c selects it, and so does any explicit --cc=, which
    // names a C compiler and can therefore only mean the C path.
    //
    // `auto` is a priority ladder: in-process LLVM first, else the C backend,
    // which itself prefers clang > gcc > tcc when resolving its compiler.
    func use_llvm_backend(opt &: Dr): bool:
        if str.Equals(opt.backend, "c"):
            ret false
        end
        if str.Equals(opt.backend, "llvm"):
            ret true
        end
        ret lv.NativeAvailable()
    end
