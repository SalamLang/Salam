package driver

import os
import str
import mem
import thread
import sync
import os.shell
import os.platform

include cc "../condcomp.salam"
include lv "../llvmgen/llvmgen.salam"

const _WIN_CP_UTF8 := 65001

const _WIN_STD_ERROR_HANDLE := 0 - 12

const _WIN_ENABLE_VT := 0x4

mut _win_console_ready := false

mut _win_ansi_ok := false

if SALAM_OS_WINDOWS:
    // Old conhost consoles (Windows Server 2016 included) default to
    // the legacy OEM codepage and leave VT100 escape processing off, so
    // raw source text prints as mojibake and diagnostics show their
    // ANSI codes literally unless a program opts both of these in.
    func win_console_init():
        if _win_console_ready:
            ret
        end
        _win_console_ready = true
        _cp := SetConsoleOutputCP(_WIN_CP_UTF8)
        h := GetStdHandle(_WIN_STD_ERROR_HANDLE)
        if h == null:
            ret
        end
        buf := mem.Allocate(8 as u64)
        defer mem.Free(buf)
        if GetConsoleMode(h, buf) == 0:
            ret
        end
        p := buf as u32*
        _win_ansi_ok = SetConsoleMode(h, p[0] | (_WIN_ENABLE_VT as u32)) != 0
    end
else:
    func win_console_init():
        ret
    end
end

func proc_status(code: int): int:
    if SALAM_OS_WINDOWS:
        ret code
    else:
        if code < 0:
            ret 1
        end
        ret (code / 256) % 256
    end
end

func proc_signal(code: int): int:
    if SALAM_OS_WINDOWS || code <= 0:
        ret 0
    end
    sig := (code % 256) % 128
    if sig == 127:
        ret 0
    end
    ret sig
end

func proc_signal_name(sig: int): str:
    if sig == 11:
        ret "segmentation fault"
    end
    if sig == 10 || sig == 7:
        ret "bus error"
    end
    if sig == 6:
        ret "abort"
    end
    if sig == 8:
        ret "arithmetic error"
    end
    if sig == 4:
        ret "illegal instruction"
    end
    if sig == 9:
        ret "killed"
    end
    ret "signal"
end

func stderr_is_tty(): bool:
    if SALAM_OS_WINDOWS:
        ret _isatty(2) != 0
    else:
        ret isatty(2) != 0
    end
end

func resolve_color(flag: int): bool:
    if SALAM_OS_WINDOWS:
        win_console_init()
    end
    if flag == 1:
        ret true
    end
    if flag == 0:
        ret false
    end
    if !stderr_is_tty():
        ret false
    end
    if SALAM_OS_WINDOWS:
        ret _win_ansi_ok
    else:
        ret true
    end
end

func compile_worker():
    mut running := true
    until running:
        sync.Lock(g_cw_mu)
        mut idx := 0 - 1
        if g_cw_next < g_cw_jobs.len():
            idx = g_cw_next
            g_cw_next += 1
        end
        sync.Unlock(g_cw_mu)
        if idx < 0:
            running = false
        else:
            job_rc := shell.System(g_cw_jobs.get(idx))
            if job_rc != 0:
                sync.Lock(g_cw_mu)
                if g_cw_rc == 0:
                    g_cw_rc = job_rc
                end
                sync.Unlock(g_cw_mu)
            end
        end
    end
end

func largest_first_idx(sizes: Vector<i64>): Vector<int>:
    mut order := Vector {} as Vector<int>
    repeat sizes.len() in i:
        mut pos := order.len()
        until pos > 0 && sizes.get(order.get(pos - 1)) < sizes.get(i):
            pos -= 1
        end
        order.insert(pos, i)
    end
    ret order
end

func largest_first(jobs: Vector<str>, sizes: Vector<i64>): Vector<str>:
    order := largest_first_idx(sizes)
    mut out := Vector {} as Vector<str>
    repeat order.len() in j:
        out.push(jobs.get(order.get(j)))
    end
    order.free()
    ret out
end

func compile_parallel(jobs: Vector<str>, sizes: Vector<i64>): int:
    if jobs.len() == 0:
        ret 0
    end
    g_cw_mu = sync.NewMutex()
    g_cw_jobs = largest_first(jobs, sizes)
    g_cw_next = 0
    g_cw_rc = 0
    mut workers := platform.CpuCount()
    if workers > jobs.len():
        workers = jobs.len()
    end
    if workers < 1:
        workers = 1
    end
    mut threads := Vector {} as Vector<thread.Thread>
    repeat workers:
        threads.push(thread.New(spawn(compile_worker)))
    end
    thread.JoinAll(threads)
    defer threads.free()
    g_cw_jobs.free()
    ret g_cw_rc
end

func use_llvm_backend(opt &: Dr): bool:
    if str.Equals(opt.backend, "c"):
        ret false
    end
    if str.Equals(opt.backend, "llvm"):
        ret true
    end
    ret lv.NativeAvailable()
end
