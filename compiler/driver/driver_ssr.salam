package driver

import os
import os.process
import fs
import str
import io
import time
import net.tcp
import fs.watcher
import net.http

include lg "../logger.salam"
include i18 "../i18n.salam"
include lp "../langpack.salam"
include co "../sal_core.salam"
include sm "../semantic/semantic.salam"

func ssr_self(): str:
    mut exe := ""
    if not sm.ExePath(exe):
        exe = "salam"
    end
    ret exe
end

func ssr_entry(lgr: lg.Logger, pack: lp.Langpack, given: str): str:
    mut arg := given
    if str.Len(arg) == 0:
        arg = "."
    end
    if os.IsDir(arg):
        resolved := resolve_dir_layout(lgr, pack, arg, true)
        if resolved.Len() != 1:
            ret ""
        end
        ret abs_of(resolved.Get(0))
    end
    ret abs_of(arg)
end

func ssr_lang_flag(opt: Dr): str:
    if str.Equals(opt.lang, "en"):
        ret ""
    end
    ret " --lang=" + dev_quote(opt.lang)
end

func ssr_trim(p: str): str:
    mut t := p
    until str.Len(t) > 1 and (str.EndsWith(t, "/") or str.EndsWith(t, "\\")):
        t = str.Substr(t, 0, str.Len(t) - 1)
    end
    ret t
end

func ssr_inside(dir: str, root: str): bool:
    d := ssr_trim(dir)
    r := ssr_trim(root)
    if str.Equals(d, r):
        ret true
    end
    ret str.StartsWith(r, d + "/")
end

func ssr_forward(opt: Dr): str:
    mut t := ""
    each d in opt.defines:
        t += " --define=" + dev_quote(d)
    end
    each c in opt.consts:
        t += " --const=" + dev_quote(c)
    end
    ret t
end

func ssr_scan_assets(dir: str, sig &: i64, depth: int):
    if depth > 8 or not os.IsDir(dir):
        ret
    end
    entries := os.ListDir(dir)
    defer entries.Free()
    each name in entries:
        full := join_path2(dir, name)
        if os.IsDir(full):
            ssr_scan_assets(full, sig, depth + 1)
        else:
            mut size := 0 as i64
            mut mt := 0 as i64
            if http.FileStat(full, size, mt):
                sig = (sig * 31 + mt % 1000003 + size % 1000003 + str.Len(full) as i64) % 1000000007
            end
        end
    end
end

func ssr_render_build(entry: str, out: str, lang: str, fwd: str): bool:
    _rm := os.RemoveAll(out)
    log_file := out + ".log"
    cmd := dev_quote(ssr_self()) + " page build --ssr=" + dev_quote(out) + " " + dev_quote(entry) +
        " --no-color --log-level=error --error-lang=" + g_dev_lang + lang + fwd + " > " +
        dev_quote(log_file) + " 2>&1"
    rc := os.Run(cmd)
    if rc != 0:
        io.EPrint(io.ReadFile(log_file))
        ret false
    end
    ret true
end

func ssr_error_text(out: str): str:
    text := os.Exists(out + ".log") ? io.ReadFile(out + ".log") : ""
    if str.Len(text) == 0:
        ret "the server build failed\n"
    end
    ret text
end

func ssr_launch(out: str, host: str, port: int, errfile: str, lang: str): process.Child:
    mut cmd := process.NewCommand(join_path2(out, "server"))
    cmd.Env("HOST", host)
    cmd.Env("PORT", co.I64Toa(port as i64))
    cmd.Env("SALAM_PUBLIC", join_path2(out, "public"))
    cmd.Env("SALAM_DEV_HMR", "1")
    cmd.Env("SALAM_DEV_HMR_ERR", errfile)
    cmd.Env("SALAM_DEV_HMR_LANG", lang)
    ret process.Launch(cmd)
end

func ssr_wait_listening(child &: process.Child, host: str, port: int): bool:
    if not child.Poll():
        ret false
    end
    ret tcp.WaitListening(host, port, 10000) and child.Poll()
end

func ssr_pid_alive(pid: str): bool:
    if not os.IsDir("/proc"):
        ret true
    end
    ret os.IsDir("/proc/" + pid)
end

func ssr_lock(lgr: lg.Logger, out: str): bool:
    lock := out + ".lock"
    _mk := os.MkdirAll(dir_of(out))
    if os.Mkdir(lock) != 0:
        pid_file := join_path2(lock, "pid")
        pid := os.Exists(pid_file) ? str.Trim(io.ReadFile(pid_file)) : ""
        if str.Len(pid) > 0 and not ssr_pid_alive(pid):
            _rl := os.RemoveAll(lock)
            if os.Mkdir(lock) != 0:
                ret false
            end
        else:
            lg.Log(
                lgr,
                lg.PH_DRIVER,
                lg.LOG_ERROR,
                co.Format3(
                    i18.Tr(
                        "another build is writing '%s' (process %s); wait for it, or remove the folder '%s.lock' if that process is gone"
                    ),
                    co.ArgStr(out),
                    co.ArgStr(str.Len(pid) > 0 ? pid : "?"),
                    co.ArgStr(out)
                )
            )
            ret false
        end
    end
    _wp := os.WriteFile(join_path2(lock, "pid"), co.I64Toa(os.Pid() as i64))
    ret true
end

func ssr_unlock(out: str):
    _ru := os.RemoveAll(out + ".lock")
end

func ssr_swap(out: str, stage: str): bool:
    old := out + ".old"
    _r0 := os.RemoveAll(old)
    if os.Exists(out):
        if fs.Rename(out, old) != 0:
            ret false
        end
    end
    if fs.Rename(stage, out) != 0:
        if os.Exists(old):
            _back := fs.Rename(old, out)
        end
        ret false
    end
    _r1 := os.RemoveAll(old)
    ret true
end

func ssr_build_stage(opt &: Dr, lgr: lg.Logger, entry: str, root: str, out: str): int:
    assets := join_path2(root, "public")
    pub_dir := join_path2(out, "public")
    _rm := os.RemoveAll(pub_dir)
    if os.MkdirAll(pub_dir) != 0:
        lg.Log(
            lgr,
            lg.PH_DRIVER,
            lg.LOG_ERROR,
            co.Format1(i18.Tr("cannot create '%s'"), co.ArgStr(pub_dir))
        )
        ret 2
    end
    if os.IsDir(assets):
        _cp := os.CopyTree(assets, pub_dir)
    end
    cwd0 := os.Cwd()
    if os.Chdir(pub_dir) != 0:
        ret 2
    end
    mut copt := opt
    copt.inputs = Vector {} as Vector<str>
    copt.inputs.Push(entry)
    copt.input = entry
    copt.ssr = true
    copt.inline_mode = false
    copt.split = false
    copt.output = ""
    rc := LayoutBuild(copt)
    _back := os.Chdir(cwd0)
    if rc != 0:
        ret rc
    end
    if not os.Exists(join_path2(pub_dir, k_ssr_shell)):
        lg.Log(
            lgr,
            lg.PH_DRIVER,
            lg.LOG_ERROR,
            i18.Tr("page build --ssr needs a page: block in the entry file")
        )
        ret 1
    end
    exe_file := join_path2(out, SALAM_OS_WINDOWS ? "server.exe" : "server")
    _old := os.Remove(exe_file)
    scratch := join_path2(
        os.TempDir(), "salam-ssr-" + co.I64Toa(os.Pid() as i64) + "-" + co.I64Toa(time.NowNanos())
    )
    if os.MkdirAll(scratch) != 0:
        ret 2
    end
    log_file := join_path2(scratch, "build.log")
    cmd := "cd " + dev_quote(scratch) + " && " + dev_quote(ssr_self()) + " build " +
        dev_quote(entry) + " --ssr-server --output=" + dev_quote(exe_file) +
        " --no-color --log-level=error" + ssr_lang_flag(opt) + ssr_forward(opt) + " > " +
        dev_quote(log_file) + " 2>&1"
    src := os.Run(cmd)
    if src != 0 or not os.Exists(exe_file):
        io.EPrint(io.ReadFile(log_file))
        lg.Log(
            lgr, lg.PH_DRIVER, lg.LOG_ERROR, i18.Tr("server build failed; no server written")
        )
        _rs := os.RemoveAll(scratch)
        ret 1
    end
    _rs2 := os.RemoveAll(scratch)
    ret 0
end

pub func SsrBuild(opt &: Dr): int:
    lgr := lg.New(opt.log_level, resolve_color(opt.color))
    pack := lp.Load(opt.lang)
    if pack == lp.LP_NONE:
        lg.Log(
            lgr,
            lg.PH_DRIVER,
            lg.LOG_ERROR,
            co.Format1(i18.Tr("unknown language pack '%s'"), co.ArgStr(opt.lang))
        )
        ret 2
    end
    if host_is_windows():
        io.EPrintln("salam: page build --ssr is not available on Windows yet")
        ret 2
    end
    if not ui_web_only(lgr, opt):
        ret 2
    end
    first := opt.inputs.Len() > 0 ? opt.inputs.Get(0) : "."
    entry := ssr_entry(lgr, pack, first)
    if str.Len(entry) == 0:
        ret 2
    end
    root := dir_of(entry)
    mut out := opt.ssr_out
    if str.Len(out) == 0:
        out = "dist"
    end
    out = ssr_trim(abs_of(out))
    assets := join_path2(root, "public")
    if ssr_inside(out, root) or ssr_inside(assets, out):
        lg.Log(
            lgr,
            lg.PH_DRIVER,
            lg.LOG_ERROR,
            co.Format1(
                i18.Tr("the output folder '%s' contains the project; choose another one"),
                co.ArgStr(out)
            )
        )
        ret 2
    end
    if not ssr_lock(lgr, out):
        ret 2
    end
    stage := out + ".tmp"
    _rs := os.RemoveAll(stage)
    mut rc := ssr_build_stage(opt, lgr, entry, root, stage)
    if rc == 0 and not ssr_swap(out, stage):
        lg.Log(
            lgr,
            lg.PH_DRIVER,
            lg.LOG_ERROR,
            co.Format1(i18.Tr("cannot move the new build into '%s'"), co.ArgStr(out))
        )
        rc = 2
    end
    if rc != 0:
        _rs2 := os.RemoveAll(stage)
    else:
        println "salam: built " + join_path2(
            out, SALAM_OS_WINDOWS ? "server.exe" : "server"
        ) + " and " + join_path2(out, "public")
    end
    ssr_unlock(out)
    ret rc
end

pub func ServeRender(opt &: Dr): int:
    if host_is_windows():
        io.EPrintln("salam: serve --render is not available on Windows yet")
        ret 2
    end
    lgr := lg.New(opt.log_level, resolve_color(opt.color))
    pack := lp.Load(opt.lang)
    if pack == lp.LP_NONE:
        ret 2
    end
    entry := ssr_entry(lgr, pack, opt.input)
    if str.Len(entry) == 0:
        ret 2
    end
    root := dir_of(entry)
    mut host := opt.serve_host
    if str.Len(host) == 0:
        host = "127.0.0.1"
    end
    port := opt.serve_port > 0 ? opt.serve_port : 8000
    work := join_path2(
        os.TempDir(),
        "salam-render-" + co.I64Toa(os.Pid() as i64) + "-" + co.I64Toa(time.NowNanos())
    )
    if os.MkdirAll(work) != 0:
        io.EPrintln("salam: cannot create a build directory in " + os.TempDir())
        ret 2
    end
    lang := ssr_lang_flag(opt)
    ui_lang := dev_pick_lang(opt, entry, "")
    g_dev_lang = ui_lang
    fwd := ssr_forward(opt)
    mut slot := 0
    mut out := join_path2(work, "a")
    mut sig := 0 as i64
    dev_scan(root, sig, 0)
    ssr_scan_assets(join_path2(root, "public"), sig, 0)
    if not ssr_render_build(entry, out, lang, fwd):
        io.EPrintln("salam: the first build failed")
        _rm := os.RemoveAll(work)
        ret 1
    end
    hmr_err := join_path2(work, "hmr_error.txt")
    _w0 := io.WriteFile(hmr_err, "")
    mut child := ssr_launch(out, host, port, hmr_err, ui_lang)
    if not ssr_wait_listening(child, host, port):
        io.EPrintln("salam: the server did not start on " + host + ":" + co.I64Toa(port as i64))
        _k := child.Kill()
        child.Close()
        _rm2 := os.RemoveAll(work)
        ret 2
    end
    println "salam: serving " + entry + " at http://" + host + ":" + co.I64Toa(port as i64) +
        "/ (rebuilds on save; Ctrl+C to stop)"
    io.Flush()
    dev_signals()
    mut ww := watcher.New(root)
    watcher.Ignore(ww, ".git")
    watcher.Ignore(ww, "node_modules")
    watcher.IgnoreHidden(ww)
    watcher.Snapshot(ww)
    until true:
        _woke := watcher.Wait(ww, watcher.IsNative(ww) ? 1000 : 500)
        if dev_stopped():
            _ks := child.Kill()
            _ws := child.Wait(2000)
            child.Close()
            _rw := os.RemoveAll(work)
            ret 0
        end
        mut now := 0 as i64
        dev_scan(root, now, 0)
        ssr_scan_assets(join_path2(root, "public"), now, 0)
        if now == sig:
            continue
        end
        sig = now
        next := join_path2(work, slot == 0 ? "b" : "a")
        if not ssr_render_build(entry, next, lang, fwd):
            _w1 := io.WriteFile(hmr_err, ssr_error_text(next))
            io.EPrintln("salam: build failed, the old server keeps running")
            continue
        end
        _k2 := child.Kill()
        _w := child.Wait(2000)
        child.Close()
        _w2 := io.WriteFile(hmr_err, "")
        mut fresh := ssr_launch(next, host, port, hmr_err, ui_lang)
        if ssr_wait_listening(fresh, host, port):
            child = fresh
            out = next
            slot = slot == 0 ? 1 : 0
            io.EPrintln("salam: rebuilt " + entry)
        else:
            _k3 := fresh.Kill()
            fresh.Close()
            io.EPrintln("salam: the rebuilt server did not start, restarting the previous one")
            child = ssr_launch(out, host, port, hmr_err, ui_lang)
            if not ssr_wait_listening(child, host, port):
                io.EPrintln(
                    "salam: the previous server did not start either; save a file to try again"
                )
            end
            sig = 0 - 1
        end
    end
end
