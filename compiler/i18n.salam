    "برگزین ناقص روی شمارش '%s': عضو(های) %s پوشش داده نشده است", "«بسته» را فقط یک‌بار می‌توان اعلام کرد، و تنها به‌عنوان نخستین دستور فایل",
    "«آوردن» باید پیش از هر دستور سطح‌بالای دیگری، درست پس از اعلان بسته بیاید؛ «%s» (خط %u) از پیش آغازگر بقیه‌ی فایل است", "پایدار «%s» باید پیش از هر تعریف کارکرد یا ریخت اعلام شود؛ آن را همراه دیگر پایدار‌ها به نزدیک ابتدای فایل، پیش از «%s» (خط %u) منتقل کنید",
    "متغیر سراسری «%s» باید پیش از هر تعریف کارکرد یا ریخت اعلام شود؛ آن را به نزدیک ابتدای فایل، پیش از «%s» (خط %u) منتقل کنید", "پایدار «%s» باید پیش از متغیرهای سراسری اعلام شود؛ آن را پیش از بخش متغیرها، پیش از «%s» (خط %u) قرار دهید",
    "«%s» باید پیش از هر تعریف کارکردی اعلام شود؛ تعریف‌های ریخت، ساختار، شمارش، میانجی و پیاده‌سازی را همگی بالای کارکردها، پیش از «%s» (خط %u) نگه دارید", "کارکرد «%s» باید پیش از کارکرد همگانی «%s» (خط %u) بیاید: از جایی که یک کارکرد همگانی بخش همگانی را آغاز می‌کند، تنها کارکردهای همگانی دیگر می‌توانند پس از آن بیایند، تا استفاده‌کنندگان بتوانند رابط همگانی را از انتهای فایل پیدا کنند",
    "فایل ورودی پروژه '%s' کارکرد '%s' را تعریف نمی‌کند", "نقطه‌ی ورود چیدمان وجود ندارد: هیچ‌کدام از %d فایل .salam اینجا بلوک 'layout' ندارد",
    "نقطه‌ی ورود چیدمان مبهم: %d فایل بلوک 'layout' دارند:"
]
func strip_loose(s: str): str:
    cs := str.Chars(s)
    defer cs.free()
    mut out := ""
    each c in cs:
        if !str.Equals(c, " ") && !str.Equals(c, k_i18n_zwnj):
            out = out + c
        end
    end
    ret out
end

func words_equal_loose(a: str, b: str): bool:
    ret str.Equals(strip_loose(a), strip_loose(b))
end

func msg_index(msgid: str): int:
    n := len(k_msg_en)
    mut i := 0
    until i < n:
        if str.Equals(k_msg_en[i], msgid):
            ret i
        end
        i += 1
    end
    ret -1
end

pub func SetLang(code: str):
    if str.Equals(code, "fa"):
        g_i18n_lang = "fa"
    else:
        g_i18n_lang = "en"
    end
end

pub func Lang(): str:
    ret g_i18n_lang
end

pub func RegisterLayoutWord(lang: str, alias: str, canonical: str):
    if g_dyn_word_lang.len() >= I18N_DYN_MAX:
        ret
    end
    g_dyn_word_lang.push(lang)
    g_dyn_word_alias.push(alias)
    g_dyn_word_canon.push(canonical)
end

pub func LayoutWord(name: str): str:
    n := g_dyn_word_lang.len()
    mut i := 0
    until i < n:
        if str.Equals(g_dyn_word_lang[i], g_i18n_lang) && str.Equals(g_dyn_word_alias[i], name):
            ret g_dyn_word_canon[i]
        end
        i += 1
    end
    i = 0
    until i < n:
        if str.Equals(g_dyn_word_lang[i], g_i18n_lang) && words_equal_loose(g_dyn_word_alias[i], name):
            ret g_dyn_word_canon[i]
        end
        i += 1
    end
    ret name
end

pub func RegisterLayoutValue(lang: str, alias: str, canonical: str):
    if g_dyn_val_lang.len() >= I18N_DYN_VAL_MAX:
        ret
    end
    g_dyn_val_lang.push(lang)
    g_dyn_val_alias.push(alias)
    g_dyn_val_canon.push(canonical)
end

pub func LayoutValue(value: str): str:
    n := g_dyn_val_lang.len()
    mut i := 0
    until i < n:
        lang_ok := str.StartsWith(g_dyn_val_lang[i], "*") || str.Equals(g_dyn_val_lang[i], g_i18n_lang)
        if lang_ok && str.Equals(g_dyn_val_alias[i], value):
            ret g_dyn_val_canon[i]
        end
        i += 1
    end
    ret value
end

pub func Tr(msgid: str): str:
    if !str.Equals(g_i18n_lang, "fa"):
        ret msgid
    end
    idx := msg_index(msgid)
    if idx < 0:
        ret msgid
    end
    ret k_msg_fa[idx]
end
