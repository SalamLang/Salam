// ---------------------------------------------------------------------------
// Private helpers (must precede the first pub function of the merged
// package - rule E088; the pub API lives in the sibling files).
// ---------------------------------------------------------------------------

// Codepoint-level rewrite of the skip loops in i18n_words_equal_loose():
// drop every space and ZWNJ, keep everything else.
func strip_loose(s: str): str:
    cs := str.Chars(s)
    defer cs.free()
    mut out := ""
    each c in cs:
        if !str.Equals(c, " ") && !str.Equals(c, k_i18n_zwnj):
            out = out + c
        end
    end
    ret out
end

// i18n_words_equal_loose (i18n_load.c): equal ignoring spaces and ZWNJ.
func words_equal_loose(a: str, b: str): bool:
    ret str.Equals(strip_loose(a), strip_loose(b))
end

// The scan loop of i18n_tr(): index of msgid in the English column, -1 if
// missing (first match wins, like the C linear scan).
func msg_index(msgid: str): int:
    n := len(k_msg_en)
    mut i := 0
    until i < n:
        if str.Equals(k_msg_en[i], msgid):
            ret i
        end
        i += 1
    end
    ret -1
end

// ===== i18n_locale.c =====
// Port of compiler/src/i18n/i18n_locale.c.
// Merged into this flat file: g_i18n_lang lives in
// i18n.salam and is referenced unqualified; sibling files must NOT import
// each other.
//
// Notes vs the C version:
// - i18n_set_lang(NULL) is impossible (str is never null); every non-"fa"/
//   non-"ar" code selects "en", exactly like the C fallthrough.
// - i18n_active_lang() (internal linkage in C) is not exported; siblings
//   read g_i18n_lang directly and external consumers use Lang().

// i18n_set_lang
pub func SetLang(code: str):
    if str.Equals(code, "fa"):
        g_i18n_lang = "fa"
    else str.Equals(code, "ar"):
        g_i18n_lang = "ar"
    else:
        g_i18n_lang = "en"
    end
end

// i18n_lang
pub func Lang(): str:
    ret g_i18n_lang
end

// ===== i18n_load.c =====
// Port of compiler/src/i18n/i18n_load.c - the dynamic layout word/value
// alias registries (filled by the layout module at startup).
// Merged into this flat file: the registry Vectors,
// the capacity consts and words_equal_loose() live in i18n.salam and are
// referenced unqualified.
//
// Notes vs the C version:
// - k_layout_fa / k_value_fa static fallback tables are EMPTY in the C
//   source, so their scan loops are not ported (they can never match).
// - NULL-argument guards are dropped (str is never null); the capacity
//   caps (I18N_DYN_MAX / I18N_DYN_VAL_MAX) are kept: registrations past
//   the cap are silently ignored, exactly like the C code.

// i18n_register_layout_word
pub func RegisterLayoutWord(lang: str, alias: str, canonical: str):
    if g_dyn_word_lang.len() >= I18N_DYN_MAX:
        ret
    end
    g_dyn_word_lang.push(lang)
    g_dyn_word_alias.push(alias)
    g_dyn_word_canon.push(canonical)
end

// i18n_layout_word - canonical spelling for a localized layout word.
// Pass 1: exact alias match for the active language; pass 2: loose match
// (spaces/ZWNJ ignored); otherwise the name is already canonical.
pub func LayoutWord(name: str): str:
    n := g_dyn_word_lang.len()
    mut i := 0
    until i < n:
        if str.Equals(g_dyn_word_lang[i], g_i18n_lang) && str.Equals(g_dyn_word_alias[i], name):
            ret g_dyn_word_canon[i]
        end
        i += 1
    end
    i = 0
    until i < n:
        if str.Equals(g_dyn_word_lang[i], g_i18n_lang) && words_equal_loose(g_dyn_word_alias[i], name):
            ret g_dyn_word_canon[i]
        end
        i += 1
    end
    ret name
end

// i18n_register_layout_value
pub func RegisterLayoutValue(lang: str, alias: str, canonical: str):
    if g_dyn_val_lang.len() >= I18N_DYN_VAL_MAX:
        ret
    end
    g_dyn_val_lang.push(lang)
    g_dyn_val_alias.push(alias)
    g_dyn_val_canon.push(canonical)
end

// i18n_layout_value - canonical spelling for a localized attribute value.
// A registration whose lang starts with '*' applies to every language
// (same test as the C `lang[0] == '*'`); values have no loose pass.
pub func LayoutValue(value: str): str:
    n := g_dyn_val_lang.len()
    mut i := 0
    until i < n:
        lang_ok := str.StartsWith(g_dyn_val_lang[i], "*") || str.Equals(g_dyn_val_lang[i], g_i18n_lang)
        if lang_ok && str.Equals(g_dyn_val_alias[i], value):
            ret g_dyn_val_canon[i]
        end
        i += 1
    end
    ret value
end

// ===== i18n_gettext.c =====
// Port of compiler/src/i18n/i18n_gettext.c (the i18n_tr() function).
// Merged into this flat file. The k_msgs[] data - // three parallel arrays k_msg_en/k_msg_fa/k_msg_ar - and the private
// msg_index() helper live above (E085/E088 ordering).
//
// Notes vs the C version:
// - `tr ? tr : msgid` NULL fallback: no k_msgs row has a NULL fa/ar column
//   in the C source (verified mechanically), so the port only falls back
//   when the msgid itself is not in the table - same observable behavior.

// i18n_tr - returns msgid untranslated for "en" (or when msgid is unknown).
pub func Tr(msgid: str): str:
    fa := str.Equals(g_i18n_lang, "fa")
    ar := str.Equals(g_i18n_lang, "ar")
    if !fa && !ar:
        ret msgid
    end
    idx := msg_index(msgid)
    if idx < 0:
        ret msgid
    end
    if fa:
        ret k_msg_fa[idx]
    end
    ret k_msg_ar[idx]
end
