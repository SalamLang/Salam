 تهی یا آرایه‌ای بدون چینش بومی ثابت برای عناصرش داده شد", "مفسر از روال بیرونی '%s' پشتیبانی نمی‌کند (به‌جای آن از 'salam run' استفاده کنید)", "مفسر از 'listdir' پشتیبانی نمی‌کند", "مفسر از 'hash' پشتیبانی نمی‌کند", "باز کردن نامعتبر گوناگون", "نمی‌توان نشانی آرایه‌ای تهی یا آرایه‌ای بدون چینش بومی ثابت برای عناصرش را گرفت", "در مفسر نمی‌توان نشانی این مقدار را گرفت (به‌جای آن از 'salam run' استفاده کنید)", "بسته‌ی '%s' عضوی به نام '%s' ندارد", "ارجاع به اشاره‌گر پوچ", "نوشتن از طریق اشاره‌گر پوچ", "این مقدار قابل خواندن با اندیس نیست", "salam doc: '%s' وجود ندارد", "salam doc: هیچ فایل .salam در '%s' یافت نشد", "salam: -d به نام ثابت نیاز دارد (-dNAME=VALUE)", "salam: '-' در نام ثابت -d مجاز نیست ('%s')؛ از '_' استفاده کنید", "salam: نام ثابت -d یعنی '%s' باید با حروف بزرگ باشد (A-Z، 0-9 و '_'، بدون رقم در آغاز)", "salam: 'new' تنها یک نام پروژه می‌گیرد ('%s' پس از '%s')", "salam: 'serve' تنها یک پوشه می‌گیرد ('%s' پس از '%s')", "salam: REPL چیدمان 'salam layout' است، نه 'salam cli layout'", "salam: REPL فایل ورودی نمی‌گیرد ('%s')؛ فایل را با 'salam run %s' اجرا کنید", "salam: چند فایل ورودی به دستور 'build' نیاز دارد ('%s' پس از '%s')", "salam: قالب ناشناخته‌ی --time-report یعنی '%s' ('table' یا 'json' انتظار می‌رفت)\n", "salam: مقدار نامعتبر --indent یعنی '%s' ('tab' یا پهنایی از 1 تا 16)", "salam: -o به یک فایل نیاز دارد", "salam: سبک خطای نامعتبر '%s' (rust|gcc|clang)", "salam: قالب خطای نامعتبر '%s' (human|json|xml)", "salam: سطح گزارش نامعتبر '%s'", "salam: مقدار نامعتبر --port یعنی '%s' (از 1 تا 65535)", "salam: مقدار نامعتبر --timeout یعنی '%s' (میلی‌ثانیه، بزرگ‌تر از 0)", "salam: گزینه‌ی ناشناخته '%s'", "salam: دستور ناشناخته '%s'", "salam: 'llvm' به یک فایل ورودی نیاز دارد", "salam: 'js' دست‌کم به یک فایل ورودی نیاز دارد", "salam: نمی‌توان ردگیری را در '%s' نوشت\n", "قالب‌بندی شد %s", "salam: نمی‌توان فایل --exclude-from یعنی '%s' را خواند", "هر %d فایل از پیش قالب‌بندی شده است", "%d از %d فایل به قالب‌بندی نیاز دارد", "پایان: %d قالب‌بندی شد، %d بدون تغییر", "رد شد: %d فایل (--exclude/--include)", "salam: نام پروژه نمی‌تواند خالی باشد", "salam: نام پروژه نباید جداکننده‌ی مسیر داشته باشد ('%s')", "salam: '%s' از پیش وجود دارد", "salam: نمی‌توان پوشه‌ی '%s' را ساخت", "پس از حاشیه‌نویسی '@' یک تعریف انتظار می‌رفت", "Count() آرگومانی نمی‌گیرد", "FromString(name, ok) یک رشته و یک ارجاع منطقی می‌گیرد", "Names() آرگومانی نمی‌گیرد", "نمی‌توان مقداری از گونه‌ی 'تهی' را چاپ کرد - این عبارت مقداری تولید نمی‌کند", "نمی‌توان مقدار گونه‌ی '%s' را مستقیم چاپ کرد - به‌جای آن عناصر یا فیلدهایش را چاپ کنید", "نمی‌توان اشاره‌گری از گونه‌ی '%s' را چاپ کرد - برای چاپ '%s' که به آن اشاره می‌کند '[0]' بیفزایید", "نمی‌توان اشاره‌گری از گونه‌ی '%s' را چاپ کرد - به‌جای آن چیزی را که به آن اشاره می‌کند چاپ کنید", "ref(index) یک آرگومان می‌گیرد", "name() آرگومانی نمی‌گیرد", "جداشمار متدی به نام '%s' ندارد", "%s(sub) یک آرگومان می‌گیرد", "%s() آرگومانی نمی‌گیرد", "repeat(n) یک آرگومان می‌گیرد", "عبارت همخوان گونه‌های متمایز بیش از حد دارد (بیشینه 64)", "نمی‌توان نشانی روال جنریک '%s' را گرفت", "تبدیل صریح در اینجا باید '%s' را تولید کند، یعنی گونه‌ای که این جایگاه لازم دارد، نه '%s'", "تبدیل بی‌فایده: این جایگاه از پیش '%s' را لازم دارد؛ تبدیل را حذف کنید", "متغیر سراسری '%s' پیش از تعریفش استفاده شده است؛ آن را بالای این خط ببرید", "بسته‌ی ناشناخته '%s' در '&%s.%s'", "'&%s.%s' به یک روال نیاز دارد", "'%s' یک متد است، نه روال آزاد؛ '&' نمی‌تواند نشانی آن را بگیرد", "'&%s' به یک روال نیاز دارد و '%s' روال نیست", "کارور '~' به عملوند صحیح نیاز دارد", "تبدیل بی‌فایده: این عبارت از پیش گونه‌ی '%s' را دارد؛ تبدیل را حذف کنید", "اندیس %d برای آرایه‌ای به طول %d خارج از محدوده است", "'%s' پیش از مقداردهی خوانده شده است (تعریف‌شده در خط %u)؛ با ':=' به آن مقدار دهید یا در هر مسیری که به اینجا می‌رسد به آن مقدار نسبت دهید", "قید '%s' روی پارامتر گونه‌ی '%s': %s", "آرایه‌ی ثابت ('%s') نمی‌تواند آرگومان گونه باشد؛ آن را در یک ساختار بپیچید یا از برش استفاده کنید", "فیلد '%s' در این مقدار ساختاری دو بار آمده است", "بسته‌ی ناشناخته '%s' در مقدار ساختاری '%s'", "بسته‌ی '%s' ساختار همگانی به نام '%s' ندارد", "گونه‌ی عناصر آرایه‌ای از پوچ‌ها قابل استنتاج نیست؛ برای مقصد گونه بنویسید، مثلاً 'slots: T*[%zu]'", "مقادیر گونه‌ی '%s' را نمی‌توان فیلد به فیلد مقایسه کرد؛ operator_eq را روی ساختار تعریف کنید", "کارور '**' به عملوندهای عددی نیاز دارد", "کارور '*' روی رشته نیاز دارد عملوند دیگر صحیح باشد ('%s' و '%s' دریافت شد)", "کارور بیتی به عملوندهای صحیح نیاز دارد ('%s' و '%s' دریافت شد)", "تعداد جابه‌جایی %d بیرون از پهنای '%s' است", "کارور بیتی را نمی‌توان روی '%s' و '%s' به کار برد", "گونه‌ی '%s.%s' به‌جای مقدار به کار رفته است", "متغیر حلقه‌ی استفاده‌نشده '%s': آن را حذف کنید یا جایی که حلقه به آن نیاز دارد نامش را '_' بگذارید", "کارور بیتی به عملوندهای صحیح نیاز دارد", "'%s' پس از 'dyn': %s", "'گوناگون' دست‌کم به 2 آرگومان گونه نیاز دارد (%zu دریافت شد)", "'گوناگون' نمی‌تواند 'گوناگون' دیگری را به‌عنوان عضو داشته باشد", "'%s' از پیش با همین گونه‌های پارامتر تعریف شده است", "ساختار '%s' خودش را به‌صورت مقدار در بر دارد و اندازه‌ی متناهی ندارد؛ فیلد را اشاره‌گر کنید", "'%s' یک گونه‌ی درونی است و نمی‌توان دوباره تعریفش کرد", "'%s' در `کاربست ... بر ...`: %s", "جداشمار '%s' بر پایه‌ی %s است؛ عضو '%s' نمی‌تواند مقدار %s داشته باشد", "عضو '%s' از جداشمار بر پایه‌ی %s به نام '%s' به مقدار صریح نیاز دارد", "پس از حاشیه‌نویسی '@' یک رشته انتظار می‌رفت", "واردسازی گروهی پشتیبانی نمی‌شود؛ هر واردسازی را در یک خط بنویسید و برای پرونده‌ها بنویسید فراخوانی \"a.salam\" \"b.salam\"", "'jsonschema' یک آرگومان می‌گیرد", "'%s' نام دیگری برای '%s' است", "ترابرد روی جداشمار '%s' این اعضا را پوشش نمی‌دهد: %s؛ موردهای جاافتاده یا یک 'وگرنه' بیفزایید", "'فراخوانی' مسیر یک پرونده را به‌شکل رشته می‌گیرد، برای نمونه فراخوانی \"util.salam\"", "مسیر فراخوانی '%s' نباید با './' آغاز شود؛ برای فایلی کنار همین فایل '%s' و از ریشه‌ی پروژه '@/%s' بنویسید", "پرونده‌ی '%s' برای فراخوانی پیدا نشد؛ سلام آن را در مسیر '%s' جست‌وجو کرد", "'%s' یک پوشه است، نه پرونده‌ای برای فراخوانی", "'واردسازی' یک کتابخانه را با نامش وارد می‌کند؛ برای افزودن یک پرونده از '