k_i18n_type_en := [
    "void", "bool", "char", "str", "uchar", "i8", "i16", "i32", "int", "i64", "u8", "u16", "u32", "uint", "u64", "usize", "size", "f32", "float", "f64", "Vector", "HashMap", "MapIter", "File", "Variant", "func", "dyn"
]

k_i18n_type_fa := [
    "تهی", "منطقی", "نویسه", "رشته", "یونیکد", "صحیح۸", "صحیح۱۶", "صحیح", "صحیح", "صحیح۶۴", "طبیعی۸", "طبیعی۱۶", "طبیعی", "طبیعی", "طبیعی۶۴", "اندازه مثبت", "اندازه", "اعشار۳۲", "اعشار", "اعشار۶۴", "وکتور", "نگاشت", "پیمایشگرنگاشت", "پرونده", "گوناگون", "روال", "پویا"
]

func strip_loose(s: str): str:
    cs := str.Chars(s)
    defer cs.free()
    mut out := ""
    each c in cs:
        if not str.Equals(c, " ") and not str.Equals(c, k_i18n_zwnj):
            out = out + c
        end
    end
    ret out
end

func words_equal_loose(a: str, b: str): bool:
    ret str.Equals(strip_loose(a), strip_loose(b))
end

func msg_index(msgid: str): int:
    n := len(k_msg_en)
    mut i := 0
    until i < n:
        if str.Equals(k_msg_en[i], msgid):
            ret i
        end
        i += 1
    end
    ret -1
end

func type_word_fa(w: str): str:
    repeat len(k_i18n_type_en) in i:
        if str.Equals(k_i18n_type_en[i], w):
            ret k_i18n_type_fa[i]
        end
    end
    ret ""
end

func type_word_disp(w: str, fa: bool): str:
    if not fa:
        repeat len(k_i18n_type_en) in i:
            if str.Equals(k_i18n_type_en[i], w):
                ret w
            end
        end
        ret ""
    end
    ret type_word_fa(w)
end

func generic_arity(head: str): int:
    if str.Equals(head, "Vector"):
        ret 1
    end
    if str.Equals(head, "HashMap") or str.Equals(head, "MapIter"):
        ret 2
    end
    if str.Equals(head, "Variant"):
        ret 0 - 1
    end
    ret 0
end

func unmangle_at(parts: Vector<str>, pos &: int, fa: bool): str:
    if pos >= parts.len():
        ret ""
    end
    head := parts.get(pos)
    pos += 1
    name := type_word_disp(head, fa)
    if str.Len(name) == 0:
        ret ""
    end
    arity := generic_arity(head)
    if arity == 0:
        ret name
    end
    mut args := ""
    mut k := 0
    until (arity < 0 and pos < parts.len()) or (arity > 0 and k < arity):
        arg := unmangle_at(parts, pos, fa)
        if str.Len(arg) == 0:
            ret ""
        end
        if k > 0:
            args = args + ", "
        end
        args = args + arg
        k += 1
    end
    if k == 0:
        ret ""
    end
    ret name + "<" + args + ">"
end

func unmangle_type(w: str, fa: bool): str:
    if not str.Contains(w, "_"):
        ret ""
    end
    parts := w.split("_")
    mut pos := 0
    out := unmangle_at(parts, pos, fa)
    if pos != parts.len():
        ret ""
    end
    ret out
end

func spec_list(f: str, positions &: Vector<int>, plural &: Vector<bool>): Vector<str>:
    mut out := Vector {} as Vector<str>
    n := str.Len(f)
    mut i := 0
    until i < n:
        if str.Substr(f, i, 1) != "%":
            i += 1
            continue
        end
        prev := i > 0 ? str.Substr(f, i - 1, 1) : ""
        i += 1
        if i < n and str.Substr(f, i, 1) == "%":
            i += 1
            continue
        end
        mut pos := 0 - 1
        mut j := i
        until j < n and str.Substr(f, j, 1) >= "0" and str.Substr(f, j, 1) <= "9":
            j += 1
        end
        if j > i and j < n and str.Substr(f, j, 1) == "$":
            mut pn := 0
            until i < j:
                pn = pn * 10 + (str.ToInt(str.Substr(f, i, 1)) as int)
                i += 1
            end
            pos = pn - 1
            i = j + 1
        end
        mut conv := ""
        if i + 1 < n and str.Substr(f, i, 2) == "zu":
            conv = "zu"
            i += 2
        else i < n:
            conv = str.Substr(f, i, 1)
            i += 1
        end
        out.push(conv)
        positions.push(pos)
        plural.push(str.Equals(conv, "s") and is_word_start(prev))
    end
    ret out
end

func check_pair(en: str, fa: str): str:
    mut epos := Vector {} as Vector<int>
    mut eplural := Vector {} as Vector<bool>
    especs := spec_list(en, epos, eplural)
    mut fpos := Vector {} as Vector<int>
    mut fplural := Vector {} as Vector<bool>
    fspecs := spec_list(fa, fpos, fplural)
    mut seq := 0
    mut max_used := 0 - 1
    repeat fspecs.len() in k:
        mut idx := fpos.get(k)
        if idx < 0:
            idx = seq
            seq += 1
        end
        if idx >= especs.len():
            ret "argument " + (idx + 1) + " does not exist in the English message"
        end
        if not str.Equals(especs.get(idx), fspecs.get(k)):
            ret "argument " + (idx + 1) + " is %" + especs.get(idx) + " in English but %" + fspecs.get(k) + " here"
        end
        if idx > max_used:
            max_used = idx
        end
    end
    repeat especs.len() in e:
        mut used := false
        repeat fspecs.len() in k2:
            mut idx2 := fpos.get(k2)
            if idx2 < 0:
                mut before := 0
                repeat k2 in k3:
                    if fpos.get(k3) < 0:
                        before += 1
                    end
                end
                idx2 = before
            end
            if idx2 == e:
                used = true
            end
        end
        if not used and not eplural.get(e):
            ret "argument " + (e + 1) + " is dropped"
        end
    end
    ret ""
end

func fa_digits_plain(t: str): str:
    n := str.Len(t)
    mut out := ""
    mut i := 0
    until i < n:
        c := str.Substr(t, i, 1)
        if c >= "0" and c <= "9":
            mut j := i
            until j < n and str.Substr(t, j, 1) >= "0" and str.Substr(t, j, 1) <= "9":
                j += 1
            end
            prev := i > 0 ? str.Substr(t, i - 1, 1) : ""
            next := j < n ? str.Substr(t, j, 1) : ""
            run := str.Substr(t, i, j - i)
            if is_word_start(prev) or is_word_start(next):
                out = out + run
            else:
                out = out + str.ToPersianDigits(run)
            end
            i = j
            continue
        end
        out = out + c
        i += 1
    end
    ret out
end

func fa_digits_outside_quotes(msg: str): str:
    n := str.Len(msg)
    mut out := ""
    mut i := 0
    until i < n:
        q := str.IndexFrom(msg, "'", i)
        if q < 0:
            break
        end
        q2 := str.IndexFrom(msg, "'", q + 1)
        if q2 < 0:
            break
        end
        out = out + fa_digits_plain(str.Substr(msg, i, q - i)) + str.Substr(msg, q, q2 - q + 1)
        i = q2 + 1
    end
    ret out + fa_digits_plain(str.Substr(msg, i, n - i))
end

func is_word_start(c: str): bool:
    ret (c >= "a" and c <= "z") or (c >= "A" and c <= "Z") or c == "_"
end

func is_word_char(c: str): bool:
    ret is_word_start(c) or (c >= "0" and c <= "9")
end

func type_seg(seg: str, fa: bool): str:
    n := str.Len(seg)
    mut out := ""
    mut i := 0
    until i < n:
        c := str.Substr(seg, i, 1)
        if is_word_start(c):
            mut j := i + 1
            until j < n and is_word_char(str.Substr(seg, j, 1)):
                j += 1
            end
            word := str.Substr(seg, i, j - i)
            mut disp := unmangle_type(word, fa)
            if str.Len(disp) == 0:
                disp = type_word_disp(word, fa)
            end
            out = out + (str.Len(disp) > 0 ? disp : word)
            i = j
            continue
        end
        out = out + c
        i += 1
    end
    ret out
end

pub func SetLang(code: str):
    if str.Equals(code, "fa"):
        g_i18n_lang = "fa"
    else:
        g_i18n_lang = "en"
    end
end

pub func Lang(): str:
    ret g_i18n_lang
end

pub func RegisterLayoutWord(lang: str, alias: str, canonical: str):
    if g_dyn_word_lang.len() >= I18N_DYN_MAX:
        ret
    end
    g_dyn_word_lang.push(lang)
    g_dyn_word_alias.push(alias)
    g_dyn_word_canon.push(canonical)
end

pub func LayoutWord(name: str): str:
    n := g_dyn_word_lang.len()
    mut i := 0
    until i < n:
        if str.Equals(g_dyn_word_lang[i], g_i18n_lang) and str.Equals(g_dyn_word_alias[i], name):
            ret g_dyn_word_canon[i]
        end
        i += 1
    end
    i = 0
    until i < n:
        if str.Equals(g_dyn_word_lang[i], g_i18n_lang) and words_equal_loose(g_dyn_word_alias[i], name):
            ret g_dyn_word_canon[i]
        end
        i += 1
    end
    ret name
end

pub func RegisterLayoutValue(lang: str, alias: str, canonical: str):
    if g_dyn_val_lang.len() >= I18N_DYN_VAL_MAX:
        ret
    end
    g_dyn_val_lang.push(lang)
    g_dyn_val_alias.push(alias)
    g_dyn_val_canon.push(canonical)
end

pub func LayoutValue(value: str): str:
    n := g_dyn_val_lang.len()
    mut i := 0
    until i < n:
        lang_ok := str.StartsWith(g_dyn_val_lang[i], "*") or str.Equals(g_dyn_val_lang[i], g_i18n_lang)
        if lang_ok and str.Equals(g_dyn_val_alias[i], value):
            ret g_dyn_val_canon[i]
        end
        i += 1
    end
    ret value
end

pub func CheckTranslations(): str:
    if len(k_msg_en) != len(k_msg_fa):
        ret "the message tables are not index-parallel: " + len(k_msg_en) + " English, " + len(k_msg_fa) + " Persian"
    end
    repeat len(k_msg_en) in i:
        problem := check_pair(k_msg_en[i], k_msg_fa[i])
        if str.Len(problem) > 0:
            ret "'" + k_msg_en[i] + "': " + problem
        end
    end
    ret ""
end

pub func LocalizeTypes(msg: str): str:
    fa := str.Equals(g_i18n_lang, "fa")
    n := str.Len(msg)
    mut out := ""
    mut i := 0
    until i < n:
        q := str.IndexFrom(msg, "\x01", i)
        if q < 0:
            break
        end
        q2 := str.IndexFrom(msg, "\x02", q + 1)
        if q2 < 0:
            break
        end
        out = out + str.Substr(msg, i, q - i) + type_seg(str.Substr(msg, q + 1, q2 - q - 1), fa)
        i = q2 + 1
    end
    out = out + str.Substr(msg, i, n - i)
    if not fa:
        ret out
    end
    ret fa_digits_outside_quotes(out)
end

pub func Tr(msgid: str): str:
    if not str.Equals(g_i18n_lang, "fa"):
        ret msgid
    end
    idx := msg_index(msgid)
    if idx < 0:
        ret msgid
    end
    ret k_msg_fa[idx]
end
