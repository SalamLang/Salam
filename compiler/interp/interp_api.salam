// --- builtins (interp_builtin.c) ---

// Index in the intrinsic table (22 = the platform sleep row), -1 = none.
pub func IntrinsicLookup(name: str): int:
    repeat K_IP_INTR_COUNT with i:
        if str.Equals(k_ip_intrinsics[i], name):
            ret i
        end
    end
    if SALAM_OS_WINDOWS:
        if str.Equals(name, "SleepEx"):
            ret K_IP_INTR_COUNT
        end
    else:
        if str.Equals(name, "usleep"):
            ret K_IP_INTR_COUNT
        end
    end
    ret 0 - 1
end

