// --- maps ---

pub func MapNew(ip &: Interp): int:
    ret map_new(ip)
end

pub func MapPut(ip &: Interp, mid: int, k: Value, v: Value):
    map_put(ip, mid, k, v)
end

pub func MapGet(ip &: Interp, mid: int, k: Value, found &: bool): Value:
    m := ip.maps.get(mid)[0]
    e := map_find(m, k)
    if e < 0:
        found = false
        ret val_null()
    end
    found = true
    ret m.vals.get(e)[0]
end

pub func MapHas(ip &: Interp, mid: int, k: Value): bool:
    m := ip.maps.get(mid)[0]
    ret map_find(m, k) >= 0
end

pub func MapRemove(ip &: Interp, mid: int, k: Value): bool:
    ret map_remove(ip, mid, k)
end

pub func MapSize(ip &: Interp, mid: int): int:
    m := ip.maps.get(mid)[0]
    ret m.count
end

pub func MkMap(id: int): Value:
    ret val_map(id)
end

