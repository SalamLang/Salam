// --- interp.c ---

// interp_run's construction half: interpreter state + options. The other
// half is Run() - split so callers (driver/web/tests) can read captured
// output and error state off the Interp afterwards.
pub func New(lgr: lg.Logger, entry: str, opts: Options): Interp:
    mut ipn := Interp {}
    ipn.log = lgr
    ipn.entry = entry
    ipn.lang = str.Len(opts.lang) != 0 ? opts.lang : "en"
    ipn.capture = opts.capture
    ipn.in_has = opts.has_input
    ipn.in_data = opts.input_data
    ms := opts.timeout_ms > 0 ? opts.timeout_ms : 5000
    ipn.deadline_ms = time.NowMillis() + (ms as i64)
    ipn.envs.push(Env {})
    ipn.arrs.push(Arr {})
    ipn.maps.push(SMap {})
    ipn.iters.push(SMapIter {})
    ipn.sts.push(SStruct {})
    ipn.closures.push(Closure {})
    ipn.variants.push(SVariant {})
    ipn.mods.push(Module {})
    ipn.fnlists.push(FuncList {})
    ipn.extern_fns.push(Value {})
    ipn.globals = env_new(ipn, 0)
    ret ipn
end

// Cross-package Options literal replacement (struct literals do not cross
// package boundaries - see salam/PORTING.md).
pub func NewOptions(): Options:
    ret Options {}
end

// interp_run's execution half. Returns the process exit code (main's int
// return, 0 otherwise, 1 on a runtime error - logged like the C setjmp arm).
pub func Run(ip &: Interp, a &: at.Ast, sem &: sm.Sema, program: int): int:
    collect_decls(ip, a, program)
    if ip.failed:
        ret run_fail(ip)
    end
    build_modules(ip, a, sem)
    if ip.failed:
        ret run_fail(ip)
    end
    fixup_generic_envs(ip, a, sem)
    main_fn := find_func(ip, a, ip.entry, 0 - 1)
    if main_fn == 0:
        lg.Log(
            ip.log, lg.PH_DRIVER, lg.LOG_ERROR, co.Format1(
                i18.Tr("no entry point: define a '%s' function"), co.ArgStr(ip.entry)
            )
        )
        ret 1
    end
    mut noargs := Vector {} as Vector<Value>
    defer noargs.free()
    rc := call_func(ip, a, main_fn, ip.globals, false, val_null(), noargs)
    if ip.failed:
        ret run_fail(ip)
    end
    if rc.kind == VAL_INT:
        ret rc.i as int
    end
    ret 0
end

// Releases every pool vector (the C freed its arena wholesale).
pub func Free(ip &: Interp):
    repeat ip.envs.len() with i0:
        e := ip.envs.get(i0)[0]
        e.names.free()
        e.vals.free()
    end
    ip.envs.free()
    repeat ip.arrs.len() with i1:
        ar := ip.arrs.get(i1)[0]
        ar.items.free()
    end
    ip.arrs.free()
    repeat ip.maps.len() with i2:
        m := ip.maps.get(i2)[0]
        m.keys.free()
        m.vals.free()
        m.used.free()
        m.index.free()
    end
    ip.maps.free()
    ip.iters.free()
    repeat ip.sts.len() with i3:
        s := ip.sts.get(i3)[0]
        s.fnames.free()
        s.fvals.free()
    end
    ip.sts.free()
    ip.closures.free()
    ip.variants.free()
    ip.mods.free()
    repeat ip.fnlists.len() with i4:
        fl := ip.fnlists.get(i4)[0]
        fl.nodes.free()
    end
    ip.fnlists.free()
    ip.funcs.free()
    ip.structs.free()
    ip.enums.free()
    ip.impls.free()
    ip.extern_fns.free()
    ip.extern_decls.free()
    ip.def_env_defs.free()
    ip.def_env_envs.free()
    ip.tab_funcs.keys.free()
    ip.tab_funcs.vals.free()
    ip.tab_structs.keys.free()
    ip.tab_structs.vals.free()
    ip.tab_enums.keys.free()
    ip.tab_enums.vals.free()
    ip.tab_modules.keys.free()
    ip.tab_modules.vals.free()
    ip.tab_extern_fns.keys.free()
    ip.tab_extern_fns.vals.free()
    ip.tab_extern_decls.keys.free()
    ip.tab_extern_decls.vals.free()
    ip.tab_def_envs.keys.free()
    ip.tab_def_envs.vals.free()
end

pub func Tick(ip &: Interp):
    tick(ip)
end

// --- environments ---

pub func EnvNew(ip &: Interp, parent: int): int:
    ret env_new(ip, parent)
end

pub func EnvDefine(ip &: Interp, e: int, name: str, v: Value):
    env_define(ip, e, name, v)
end

// env_find over the parent chain; false when unbound.
pub func EnvLookup(ip &: Interp, e: int, name: str, out &: Value): bool:
    mut where := 0
    slot := env_find(ip, e, name, where)
    if slot < 0:
        ret false
    end
    out = env_slot_val(ip, where, slot)
    ret true
end

pub func EnvLookupLocal(ip &: Interp, e: int, name: str, out &: Value): bool:
    slot := env_find_local(ip, e, name)
    if slot < 0:
        ret false
    end
    out = env_slot_val(ip, e, slot)
    ret true
end

