pub func IntrinsicLookup(name: str): int:
    repeat K_IP_INTR_COUNT in i:
        if str.Equals(k_ip_intrinsics[i], name):
            ret i
        end
    end
    if SALAM_OS_WINDOWS:
        if str.Equals(name, "SleepEx"):
            ret K_IP_INTR_COUNT
        end
    else:
        if str.Equals(name, "usleep"):
            ret K_IP_INTR_COUNT
        end
    end
    ret 0 - 1
end

