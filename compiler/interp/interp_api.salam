pub func EnvLookup(ip &: Interp, e: int, name: str, out &: Value): bool:
    mut where := 0
    slot := env_find(ip, e, name, where)
    if slot < 0:
        ret false
    end
    out = env_slot_val(ip, where, slot)
    ret true
end

pub func EnvLookupLocal(ip &: Interp, e: int, name: str, out &: Value): bool:
    slot := env_find_local(ip, e, name)
    if slot < 0:
        ret false
    end
    out = env_slot_val(ip, e, slot)
    ret true
end

