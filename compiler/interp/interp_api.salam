pub func MapGet(ip &: Interp, mid: int, k: Value, found &: bool): Value:
    m := ip.maps.Get(mid)
    e := map_find(m, k)
    if e < 0:
        found = false
        ret val_null()
    end
    found = true
    ret m.vals.Get(e)
end

pub func MapHas(ip &: Interp, mid: int, k: Value): bool:
    m := ip.maps.Get(mid)
    ret map_find(m, k) >= 0
end

