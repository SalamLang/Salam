pub func New(lgr: lg.Logger, entry: str, opts: Options): Interp:
    mut ipn := Interp {}
    ipn.log = lgr
    ipn.entry = entry
    ipn.lang = str.Len(opts.lang) != 0 ? opts.lang : "en"
    ipn.capture = opts.capture
    ipn.in_has = opts.has_input
    ipn.in_data = opts.input_data
    repeat opts.args.Len() in ai:
        ipn.prog_args.Push(opts.args.Get(ai))
    end
    if opts.timeout_ms > 0:
        ipn.deadline_ms = time.NowMillis() + (opts.timeout_ms as i64)
    else:
        ipn.deadline_ms = 0 as i64
    end
    ipn.envs.Push(Env {})
    ipn.arrs.Push(Arr {})
    ipn.maps.Push(SMap {})
    ipn.iters.Push(SMapIter {})
    ipn.sts.Push(SStruct {})
    ipn.closures.Push(Closure {})
    ipn.variants.Push(SVariant {})
    ipn.mods.Push(Module {})
    ipn.fnlists.Push(FuncList {})
    ipn.extern_fns.Push(Value {})
    ipn.globals = env_new(ipn, 0)
    ret ipn
end

pub func NewOptions(): Options:
    ret Options {}
end

pub func SetEmbedded(enabled: bool):
    g_ip_embedded = enabled
end

pub func Stop():
    g_ip_stop = true
end

pub func ClearStop():
    g_ip_stop = false
end

pub func Run(ip &: Interp, a &: at.Ast, sem &: sm.Sema, program: int): int:
    g_vm = ip
    g_ast = a
    g_ip_exit_req = false
    g_ip_exit_code = 0
    defer out_flush(g_vm)
    mut main_fn := 0
    prc := run_prepare(g_vm, g_ast, sem, program, main_fn)
    if main_fn == 0:
        ip = g_vm
        a = g_ast
        ret prc
    end
    g_run_main = main_fn
    stacks := [INTERP_BIG_STACK, INTERP_SMALL_STACK]
    mut ran := false
    repeat 2 in si:
        if ran:
            break
        end
        g_vm.max_depth = stacks[si] / INTERP_STACK_PER_FRAME
        t := thread.SpawnStack(run_on_big_stack, null, stacks[si] as u64)
        if thread.Valid(t):
            thread.Join(t)
            ran = true
        end
    end
    mut rc := g_run_rc
    if not ran:
        g_vm.max_depth = INTERP_MAX_DEPTH
        rc = run_execute(g_vm, g_ast, main_fn)
    end
    g_vm.max_depth = INTERP_MAX_DEPTH
    ip = g_vm
    a = g_ast
    ret rc
end

pub func Free(ip &: Interp):
    repeat ip.envs.Len() in i0:
        e := ip.envs.Get(i0)
        e.names.Free()
        e.vals.Free()
        if e.indexed:
            e.tab.keys.Free()
            e.tab.vals.Free()
        end
    end
    ip.envs.Free()
    repeat ip.arrs.Len() in i1:
        ar := ip.arrs.Get(i1)
        ar.items.Free()
    end
    ip.arrs.Free()
    repeat ip.maps.Len() in i2:
        m := ip.maps.Get(i2)
        m.keys.Free()
        m.vals.Free()
        m.used.Free()
        m.index.Free()
    end
    ip.maps.Free()
    ip.iters.Free()
    repeat ip.sts.Len() in i3:
        s := ip.sts.Get(i3)
        s.fnames.Free()
        s.fvals.Free()
    end
    ip.sts.Free()
    ip.closures.Free()
    ip.variants.Free()
    ip.mods.Free()
    repeat ip.fnlists.Len() in i4:
        fl := ip.fnlists.Get(i4)
        fl.nodes.Free()
    end
    ip.fnlists.Free()
    ip.funcs.Free()
    ip.structs.Free()
    ip.enums.Free()
    ip.impls.Free()
    ip.extern_fns.Free()
    ip.extern_decls.Free()
    ip.mem_boxes.Free()
    ip.def_env_defs.Free()
    ip.def_env_envs.Free()
    ip.tab_funcs.keys.Free()
    ip.tab_funcs.vals.Free()
    ip.tab_structs.keys.Free()
    ip.tab_structs.vals.Free()
    ip.tab_enums.keys.Free()
    ip.tab_enums.vals.Free()
    ip.tab_modules.keys.Free()
    ip.tab_modules.vals.Free()
    ip.tab_extern_fns.keys.Free()
    ip.tab_extern_fns.vals.Free()
    ip.tab_extern_decls.keys.Free()
    ip.tab_extern_decls.vals.Free()
    ip.tab_def_envs.keys.Free()
    ip.tab_def_envs.vals.Free()
end

