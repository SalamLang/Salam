package interp

import str
import co "../sal_core.salam"
import at "../ast.salam"
import i18 "../i18n.salam"
import net "interp_net.salam"

func nx_str(x: i64): str:
    p := x as void*
    ret p as str
end

func typestr_is_float(ts: str): bool:
    ret is_float_typename(base_typename(ts))
end

func marshal_arg(ip &: Interp, v: Value): i64:
    if v.kind == VAL_STR:
        sp := v.s as void*
        ret sp as i64
    end
    if v.kind == VAL_PTR:
        ret v.pa
    end
    if v.kind == VAL_BOOL:
        ret v.b ? (1 as i64) : (0 as i64)
    end
    if v.kind == VAL_CHAR || v.kind == VAL_INT:
        ret v.i
    end
    if v.kind == VAL_ARRAY:
        ret arr_materialize(ip, v.id)
    end
    ret 0
end

func native_dispatch(
    name: str, a0: i64, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64, a6: i64, a7: i64, found &: bool
): i64:
    found = true
    if str.Equals(name, "getenv"):
        gv := getenv(nx_str(a0))
        ret gv as i64
    end
    if str.Equals(name, "malloc"):
        mv := malloc(a0 as u64)
        ret mv as i64
    end
    if str.Equals(name, "calloc"):
        cv := calloc(a0 as u64, a1 as u64)
        ret cv as i64
    end
    if str.Equals(name, "realloc"):
        rv := realloc(a0 as void*, a1 as u64)
        ret rv as i64
    end
    if str.Equals(name, "free"):
        free(a0 as void*)
        ret 0
    end
    if str.Equals(name, "memset"):
        msv := memset(a0 as void*, a1 as int, a2 as u64)
        ret msv as i64
    end
    if str.Equals(name, "memcpy"):
        mcv := memcpy(a0 as void*, a1 as void*, a2 as u64)
        ret mcv as i64
    end
    if str.Equals(name, "memmove"):
        mmv := memmove(a0 as void*, a1 as void*, a2 as u64)
        ret mmv as i64
    end
    if str.Equals(name, "remove"):
        ret remove(nx_str(a0))
    end
    if str.Equals(name, "rename"):
        ret rename(nx_str(a0), nx_str(a1))
    end
    if str.Equals(name, "fopen"):
        fv := fopen(nx_str(a0), nx_str(a1))
        ret fv as i64
    end
    if str.Equals(name, "fclose"):
        ret fclose(a0 as void*)
    end
    if str.Equals(name, "fflush"):
        ret fflush(a0 as void*)
    end
    if str.Equals(name, "fseek"):
        ret fseek(a0 as void*, a1 as int, a2 as int)
    end
    if str.Equals(name, "ftell"):
        ret ftell(a0 as void*)
    end
    if str.Equals(name, "fread"):
        ret fread(a0 as void*, a1 as u64, a2 as u64, a3 as void*) as i64
    end
    if str.Equals(name, "fwrite"):
        ret fwrite(a0 as void*, a1 as u64, a2 as u64, a3 as void*) as i64
    end
    if str.Equals(name, "fgetc"):
        ret fgetc(a0 as void*)
    end
    if str.Equals(name, "fgets"):
        gsv := fgets(a0 as void*, a1 as int, a2 as void*)
        ret gsv as i64
    end
    if str.Equals(name, "exit"):
        exit(a0 as int)
    end
    if str.Equals(name, "abort"):
        abort()
    end
    if str.Equals(name, "socket"):
        ret net.Socket(a0 as int, a1 as int, a2 as int)
    end
    if str.Equals(name, "connect"):
        ret net.Connect(a0, a1 as void*, a2 as int)
    end
    if str.Equals(name, "send"):
        ret net.Send(a0, a1 as void*, a2 as int, a3 as int)
    end
    if str.Equals(name, "recv"):
        ret net.Recv(a0, a1 as void*, a2 as int, a3 as int)
    end
    if str.Equals(name, "sendto"):
        ret net.SendTo(a0, a1 as void*, a2 as int, a3 as int, a4 as void*, a5 as int)
    end
    if str.Equals(name, "recvfrom"):
        ret net.RecvFrom(a0, a1 as void*, a2 as int, a3 as int, a4 as void*, a5 as void*)
    end
    if str.Equals(name, "closesocket"):
        ret net.CloseSock(a0)
    end
    if !SALAM_OS_WINDOWS:
        if str.Equals(name, "close"):
            ret net.CloseSock(a0)
        end
        if str.Equals(name, "fcntl"):
            ret net.Fcntl3(a0 as int, a1 as int, a2 as int)
        end
    end
    if str.Equals(name, "shutdown"):
        ret net.ShutdownSock(a0, a1 as int)
    end
    if str.Equals(name, "setsockopt"):
        ret net.SetSockOpt(a0, a1 as int, a2 as int, a3 as void*, a4 as int)
    end
    if str.Equals(name, "getsockname"):
        ret net.GetSockName(a0, a1 as void*, a2 as void*)
    end
    if str.Equals(name, "getaddrinfo"):
        ret net.GetAddrInfo(nx_str(a0), nx_str(a1), a2 as void*, a3 as void*)
    end
    if str.Equals(name, "freeaddrinfo"):
        net.FreeAddrInfo(a0 as void*)
        ret 0
    end
    if str.Equals(name, "gethostbyname"):
        ghv := net.GetHostByName(nx_str(a0))
        ret ghv as i64
    end
    if str.Equals(name, "htons"):
        ret net.Htons(a0 as int)
    end
    if str.Equals(name, "ntohs"):
        ret net.Ntohs(a0 as int)
    end
    if str.Equals(name, "inet_ntoa"):
        iv := net.InetNtoa(a0 as int)
        ret (iv as void*) as i64
    end
    if str.Equals(name, "poll") || str.Equals(name, "WSAPoll"):
        ret net.Poll(a0 as void*, a1 as u64, a2 as int)
    end
    if str.Equals(name, "localtime"):
        lv := net.LocalTime(a0 as void*)
        ret lv as i64
    end
    if SALAM_OS_WINDOWS:
        if str.Equals(name, "ioctlsocket"):
            ret net.IoctlSocket(a0, a1 as int, a2 as void*)
        end
        if str.Equals(name, "rand_s"):
            ret net.RandS(a0 as void*)
        end
        if str.Equals(name, "WSAStartup"):
            ret net.WsaStartup(a0 as int, a1 as void*)
        end
        if str.Equals(name, "WinHttpOpen"):
            wv := net.HttpOpen(a0 as void*, a1 as int, a2 as void*, a3 as void*, a4 as int)
            ret wv as i64
        end
        if str.Equals(name, "WinHttpConnect"):
            wv := net.HttpConnect(a0 as void*, a1 as void*, a2 as int, a3 as int)
            ret wv as i64
        end
        if str.Equals(name, "WinHttpOpenRequest"):
            wv := net.HttpOpenRequest(
                a0 as void*, a1 as void*, a2 as void*, a3 as void*, a4 as void*, a5 as void*, a6 as int
            )
            ret wv as i64
        end
        if str.Equals(name, "WinHttpSendRequest"):
            ret net.HttpSendRequest(
                a0 as void*, a1 as void*, a2 as int, nx_str(a3), a4 as int, a5 as int, a6
            )
        end
        if str.Equals(name, "WinHttpReceiveResponse"):
            ret net.HttpReceiveResponse(a0 as void*, a1 as void*)
        end
        if str.Equals(name, "WinHttpQueryHeaders"):
            ret net.HttpQueryHeaders(
                a0 as void*, a1 as int, a2 as void*, a3 as void*, a4 as void*, a5 as void*
            )
        end
        if str.Equals(name, "WinHttpReadData"):
            ret net.HttpReadData(a0 as void*, a1 as void*, a2 as int, a3 as void*)
        end
        if str.Equals(name, "WinHttpAddRequestHeaders"):
            ret net.HttpAddRequestHeaders(a0 as void*, a1 as void*, a2 as int, a3 as int)
        end
        if str.Equals(name, "WinHttpCloseHandle"):
            ret net.HttpCloseHandle(a0 as void*)
        end
    end
    if SALAM_OS_WINDOWS:
        if str.Equals(name, "_mkdir"):
            ret _mkdir(nx_str(a0))
        end
        if str.Equals(name, "_rmdir"):
            ret _rmdir(nx_str(a0))
        end
        if str.Equals(name, "_chdir"):
            ret _chdir(nx_str(a0))
        end
        if str.Equals(name, "GetCurrentDirectoryA"):
            ret GetCurrentDirectoryA(a0 as int, a1 as void*)
        end
        if str.Equals(name, "GetFileAttributesA"):
            ret GetFileAttributesA(nx_str(a0))
        end
        if str.Equals(name, "_fseeki64"):
            ret _fseeki64(a0 as void*, a1, a2 as int)
        end
        if str.Equals(name, "FindFirstFileA"):
            ffv := FindFirstFileA(nx_str(a0), a1 as void*)
            ret ffv as i64
        end
        if str.Equals(name, "FindNextFileA"):
            ret FindNextFileA(a0 as void*, a1 as void*)
        end
        if str.Equals(name, "FindClose"):
            ret FindClose(a0 as void*)
        end
        if str.Equals(name, "GetSystemTimeAsFileTime"):
            GetSystemTimeAsFileTime(a0 as void*)
            ret 0
        end
        if str.Equals(name, "_getpid"):
            ret _getpid()
        end
        if str.Equals(name, "_popen"):
            pv := _popen(nx_str(a0), nx_str(a1))
            ret pv as i64
        end
        if str.Equals(name, "_pclose"):
            ret _pclose(a0 as void*)
        end
        if str.Equals(name, "MultiByteToWideChar"):
            ret MultiByteToWideChar(
                a0 as u32, a1 as u32, nx_str(a2), a3 as int, a4 as void*, a5 as int
            )
        end
        if str.Equals(name, "WideCharToMultiByte"):
            ret WideCharToMultiByte(
                a0 as u32, a1 as u32, a2 as void*, a3 as int, a4 as void*, a5 as int, a6 as void*, a7 as void*
            )
        end
    else:
        if str.Equals(name, "mkdir"):
            ret mkdir(nx_str(a0), a1 as int)
        end
        if str.Equals(name, "rmdir"):
            ret rmdir(nx_str(a0))
        end
        if str.Equals(name, "chdir"):
            ret chdir(nx_str(a0))
        end
        if str.Equals(name, "access"):
            ret access(nx_str(a0), a1 as int)
        end
        if str.Equals(name, "getcwd"):
            cwv := getcwd(a0 as void*, a1 as int)
            ret cwv as i64
        end
        if str.Equals(name, "opendir"):
            odv := opendir(nx_str(a0))
            ret odv as i64
        end
        if str.Equals(name, "readdir"):
            rdv := readdir(a0 as void*)
            ret rdv as i64
        end
        if str.Equals(name, "closedir"):
            ret closedir(a0 as void*)
        end
        if str.Equals(name, "fseeko"):
            ret fseeko(a0 as void*, a1, a2 as int)
        end
        if str.Equals(name, "clock_gettime"):
            ret clock_gettime(a0 as int, a1 as void*)
        end
        if str.Equals(name, "popen"):
            pov := popen(nx_str(a0), nx_str(a1))
            ret pov as i64
        end
        if str.Equals(name, "pclose"):
            ret pclose(a0 as void*)
        end
        if str.Equals(name, "getpid"):
            ret getpid()
        end
        if str.Equals(name, "system"):
            ret system(nx_str(a0))
        end
    end
    found = false
    ret 0
end

func call_native_extern(
    ip &: Interp, a &: at.Ast, call: int, decl: int, args: Vector<Value>
): Value:
    dn := at.Get(a, decl)
    if dn.is_variadic:
        rt_error(
            ip, a, call, co.Format1(
                i18.Tr("extern function '%s' is variadic, which the interpreter does not support (use 'salam run' instead)"), co.ArgStr(dn.name)
            )
        )
        ret val_null()
    end
    np := at.ChildCount(a, decl)
    if np > 8:
        rt_error(
            ip, a, call, co.Format1(
                i18.Tr("extern function '%s' takes too many parameters for the interpreter's native call support"), co.ArgStr(dn.name)
            )
        )
        ret val_null()
    end
    repeat np with i:
        p := at.Child(a, decl, i)
        pn := at.Get(a, p)
        pts := pn.ty != 0 ? at.Get(a, pn.ty).type_str : ""
        if typestr_is_float(pts):
            rt_error(
                ip, a, call, co.Format1(
                    i18.Tr("extern function '%s' takes a floating-point argument, which the interpreter does not support (use 'salam run' instead)"), co.ArgStr(dn.name)
                )
            )
            ret val_null()
        end
    end
    rts := dn.ty != 0 ? at.Get(a, dn.ty).type_str : ""
    if str.Len(rts) != 0 && typestr_is_float(rts):
        rt_error(
            ip, a, call, co.Format1(
                i18.Tr("extern function '%s' returns a floating-point value, which the interpreter does not support (use 'salam run' instead)"), co.ArgStr(dn.name)
            )
        )
        ret val_null()
    end
    mut a0 := 0 as i64
    mut a1 := 0 as i64
    mut a2 := 0 as i64
    mut a3 := 0 as i64
    mut a4 := 0 as i64
    mut a5 := 0 as i64
    mut a6 := 0 as i64
    mut a7 := 0 as i64
    mut mi := 0
    until mi < np && mi < args.len():
        av := args.get(mi)
        if av.kind == VAL_MAP || av.kind == VAL_MAPITER || av.kind == VAL_STRUCT || av.kind == VAL_FUNC || av.kind == VAL_MODULE || av.kind == VAL_VARIANT:
            rt_error(
                ip, a, call, co.Format1(
                    i18.Tr("extern function '%s' was passed a value the interpreter cannot turn into a native argument (use 'salam run' instead)"), co.ArgStr(dn.name)
                )
            )
            ret val_null()
        end
        mv := marshal_arg(ip, av)
        if mv == (0 as i64) && av.kind == VAL_ARRAY:
            rt_error(
                ip, a, call, co.Format1(
                    i18.Tr("extern function '%s' was passed an empty array, or one whose elements have no fixed native layout"), co.ArgStr(dn.name)
                )
            )
            ret val_null()
        end
        if mi == 0:
            a0 = mv
        else mi == 1:
            a1 = mv
        else mi == 2:
            a2 = mv
        else mi == 3:
            a3 = mv
        else mi == 4:
            a4 = mv
        else mi == 5:
            a5 = mv
        else mi == 6:
            a6 = mv
        else mi == 7:
            a7 = mv
        end
        mi += 1
    end
    mut found := false
    r := native_dispatch(dn.name, a0, a1, a2, a3, a4, a5, a6, a7, found)
    if !found:
        rt_error(
            ip, a, call, co.Format1(
                i18.Tr("extern function '%s' is not supported by the interpreter (use 'salam run' instead)"), co.ArgStr(dn.name)
            )
        )
        ret val_null()
    end
    if str.Len(rts) == 0:
        ret val_null()
    end
    if byte_at(rts, str.Len(rts) - 1) == 42:
        ret val_ptr(r, ptr_elem_from_typestr(rts))
    end
    rbase := base_typename(rts)
    if str.Equals(rbase, "bool"):
        ret val_bool(r != (0 as i64))
    end
    ret val_int(r)
end
