    end
    if str.Equals(name, "htons"):
        ret net.Htons(a0 as int)
    end
    if str.Equals(name, "ntohs"):
        ret net.Ntohs(a0 as int)
    end
    if str.Equals(name, "inet_ntoa"):
        iv := net.InetNtoa(a0 as int)
        ret (iv as void*) as i64
