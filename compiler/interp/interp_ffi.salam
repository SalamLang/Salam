package interp

import str
import mem

include co "../sal_core.salam"
include at "../ast.salam"
include tok "../token.salam"
include i18 "../i18n.salam"
include net "interp_net.salam"
include st "interp_static.salam"

if SALAM_OS_WINDOWS or SALAM_OS_WASM:
    func ffi_sym(_ip &: Interp, _a &: at.Ast, _name: str): void*:
        ret null
    end
else:
    extern:
        func dlopen(path: str, mode: int): void*
        func dlsym(handle: void*, name: str): void*
    end

    func ffi_open(path: str): bool:
        mode := SALAM_OS_MAC ? 10 : 258
        ret dlopen(path, mode) != null
    end

    func ffi_open_in(dirs: str, file: str): bool:
        if str.Len(dirs) == 0:
            ret false
        end
        parts := str.Split(dirs, ":")
        defer parts.free()
        repeat parts.Len() in i:
            d := parts.get(i)
            if str.Len(d) != 0 and ffi_open(d + "/" + file):
                ret true
            end
        end
        ret false
    end

    func ffi_open_lib(name: str, kind: str):
        if str.Equals(kind, "framework"):
            _f := ffi_open("/System/Library/Frameworks/" + name + ".framework/" + name)
            ret
        end
        if str.Contains(name, "/") and ffi_open(name):
            ret
        end
        file := "lib" + name + (SALAM_OS_MAC ? ".dylib" : ".so")
        env_dirs := [getenv("LIBRARY_PATH"), getenv("LD_LIBRARY_PATH"), getenv("DYLD_LIBRARY_PATH")]
        repeat 3 in i:
            v := env_dirs[i]
            if v != null and ffi_open_in(v as str, file):
                ret
            end
        end
        if ffi_open_in("/opt/homebrew/lib:/usr/local/lib", file):
            ret
        end
        if SALAM_OS_MAC and (str.Equals(name, "ssl") or str.Equals(name, "crypto")):
            ret
        end
        if ffi_open(file):
            ret
        end
        _s := ffi_open_in("/usr/lib:/usr/lib64:/usr/lib/x86_64-linux-gnu:/usr/lib/aarch64-linux-gnu", file)
    end

    func ffi_sym(ip &: Interp, a &: at.Ast, name: str): void*:
        dflt := (SALAM_OS_LINUX or SALAM_OS_ANDROID) ? (0 as i64) : (0 - 2 as i64)
        p := dlsym(dflt as void*, name)
        if p != null or ip.ffi_ready:
            ret p
        end
        ip.ffi_ready = true
        n := at.Count(a)
        mut i := 1
        until i < n:
            ln := at.At(a, i)
            if ln.kind == at.AST_LINK and ln.value_kind == tok.TV_STRING and str.Len(ln.value_str) != 0:
                ffi_open_lib(ln.value_str, ln.name)
            end
            i++
        end
        ret dlsym(dflt as void*, name)
    end
end

