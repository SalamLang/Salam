    func ffi_core_addr(name: str): void*:
        if str.Equals(name, "abort"):
            ret &abort
        end
        if str.Equals(name, "access"):
            ret &access
        end
        if str.Equals(name, "calloc"):
            ret &calloc
        end
        if str.Equals(name, "chdir"):
            ret &chdir
        end
        if str.Equals(name, "clock_gettime"):
            ret &clock_gettime
        end
        if str.Equals(name, "closedir"):
            ret &closedir
        end
        if str.Equals(name, "exit"):
            ret &exit
        end
        if str.Equals(name, "fclose"):
            ret &fclose
        end
        if str.Equals(name, "fflush"):
            ret &fflush
        end
        if str.Equals(name, "fgetc"):
            ret &fgetc
        end
        if str.Equals(name, "fgets"):
            ret &fgets
        end
        if str.Equals(name, "fopen"):
            ret &fopen
        end
        if str.Equals(name, "fread"):
            ret &fread
        end
        if str.Equals(name, "free"):
            ret &free
        end
        if str.Equals(name, "fseek"):
            ret &fseek
        end
        if str.Equals(name, "fseeko"):
            ret &fseeko
        end
        if str.Equals(name, "ftell"):
            ret &ftell
        end
        if str.Equals(name, "fwrite"):
            ret &fwrite
        end
        if str.Equals(name, "getcwd"):
            ret &getcwd
        end
        if str.Equals(name, "getenv"):
            ret &getenv
        end
        if str.Equals(name, "getpid"):
            ret &getpid
        end
        if str.Equals(name, "malloc"):
            ret &malloc
        end
        if str.Equals(name, "memcpy"):
            ret &memcpy
        end
        if str.Equals(name, "memmove"):
            ret &memmove
        end
        if str.Equals(name, "memset"):
            ret &memset
        end
        if str.Equals(name, "mkdir"):
            ret &mkdir
        end
        if str.Equals(name, "opendir"):
            ret &opendir
        end
        if str.Equals(name, "pclose"):
            ret &pclose
        end
        if str.Equals(name, "popen"):
            ret &popen
        end
        if str.Equals(name, "readdir"):
            ret &readdir
        end
        if str.Equals(name, "realloc"):
            ret &realloc
        end
        if str.Equals(name, "remove"):
            ret &remove
        end
        if str.Equals(name, "rename"):
            ret &rename
        end
        if str.Equals(name, "rmdir"):
            ret &rmdir
        end
        if str.Equals(name, "system"):
            ret &system
        end
        ret null
    end

    func ffi_is_static(ip &: Interp): bool:
        if ip.ffi_static == 0:
            ip.ffi_static = dlsym((0 as i64) as void*, "malloc") == null ? 1 : 2
        end
        ret ip.ffi_static == 1
    end

    func ffi_fn(ip &: Interp, a &: at.Ast, name: str): void*:
        if ffi_is_static(ip):
            mut p := st.FnAddr(name)
            if p == null:
                p = net.NetAddr(name)
            end
            ret p != null ? p : ffi_core_addr(name)
        end
        ret ffi_sym(ip, a, name)
    end

else:
    func ffi_is_static(_ip &: Interp): bool:
        ret false
    end

    func ffi_fn(ip &: Interp, a &: at.Ast, name: str): void*:
        ret ffi_sym(ip, a, name)
    end
end

if SALAM_OS_WINDOWS:
    if SALAM_ARCH_X86 or SALAM_ARCH_X64:
        func ffi_exec_page(code: int[], n: int): void*:
            page := VirtualAlloc(null, (4096 as i64) as void*, 0x3000 as u32, 4 as u32)
            if page == null:
                ret null
            end
            bytes := page as u8*
            repeat n in i:
                bytes[i] = code[i] as u8
            end
            old := mem.Allocate(8 as u64)
            done := VirtualProtect(page, (4096 as i64) as void*, 0x20 as u32, old)
            mem.Free(old)
            ret done != 0 ? page : null
        end
    else:
        func ffi_exec_page(_code: int[], _n: int): void*:
            ret null
        end
    end

    func ffi_addr(_ip &: Interp, _a &: at.Ast, name: str): void*:
        each lib in ["msvcrt.dll", "ucrtbase.dll", "kernel32.dll", "user32.dll", "ws2_32.dll"]:
            h := GetModuleHandleA(lib)
            if h != null:
                p := GetProcAddress(h, name)
                if p != null:
                    ret p
                end
            end
        end
        ret null
    end
else:
    func ffi_exec_page(_code: int[], _n: int): void*:
        ret null
    end

    func ffi_addr(ip &: Interp, a &: at.Ast, name: str): void*:
        ret ffi_fn(ip, a, name)
    end
end

func extern_var_value(ip &: Interp, a &: at.Ast, name: str, ts: str): Value:
    if ffi_is_static(ip):
        ret str.Equals(name, "environ") ? val_ptr(st.Environ() as i64, PTR_OPAQUE) : val_null()
    end
    addr := ffi_sym(ip, a, name)
    if addr == null:
        ret val_null()
    end
    ret interp_mem_load(ip, a, addr as i64, ts)
end

func f32_in_f64_bits(v: f64): f64:
    buf := mem.AllocateZeroed(8 as u64)
    pf := buf as f32*
    pf[0] = v as f32
    pd := buf as f64*
    r := pd[0]
    mem.Free(buf)
    ret r
end

func f32_word(v: f64): u32:
    buf := mem.AllocateZeroed(8 as u64)
    pf := buf as f32*
    pf[0] = v as f32
    pw := buf as u32*
    r := pw[0]
    mem.Free(buf)
    ret r
end

func f32_from_f64_bits(d: f64): f64:
    buf := mem.AllocateZeroed(8 as u64)
    pd := buf as f64*
    pd[0] = d
    pf := buf as f32*
    r := pf[0] as f64
    mem.Free(buf)
    ret r
end

func ffi_ret_value(r: i64, rts: str): Value:
    if str.Len(rts) == 0:
        ret val_null()
    end
    if byte_at(rts, str.Len(rts) - 1) == 42:
        ret val_ptr(r, ptr_elem_from_typestr(rts))
    end
    rbase := base_typename(rts)
    if str.Equals(rbase, "bool"):
        ret val_bool((r & (0xFF as i64)) != (0 as i64))
    end
    if str.Equals(rbase, "char"):
        ret val_char(r & (0xFF as i64))
    end
    if str.Equals(rbase, "str"):
        if r == (0 as i64):
            ret val_str("")
        end
        ret val_str(nx_str(r))
    end
    ity := int_ty_from_typestr(rbase)
    if ity != ITY_NONE:
        ret val_int_ty(r, ity)
    end
    ret val_int(r)
end

func nx_str(x: i64): str:
    p := x as void*
    ret p as str
end

func typestr_is_float(ts: str): bool:
    base := base_typename(ts)
    ret str.Len(base) == str.Len(ts) and is_float_typename(base)
end

func marshal_arg(ip &: Interp, v: Value): i64:
    if v.kind == VAL_STR:
        sp := v.s as void*
        ret sp as i64
    end
    if v.kind == VAL_PTR:
        ret v.pa
    end
    if v.kind == VAL_BOOL:
        ret v.b ? (1 as i64) : (0 as i64)
    end
    if v.kind == VAL_CHAR or v.kind == VAL_INT:
        ret v.i
    end
    if v.kind == VAL_ARRAY:
        ret arr_materialize(ip, v.id)
    end
    ret 0
end

func native_dispatch(
    name: str, a0: i64, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64, a6: i64, a7: i64, found &: bool
): i64:
    found = true
    if str.Equals(name, "getenv"):
        gv := getenv(nx_str(a0))
        ret gv as i64
    end
    if str.Equals(name, "malloc"):
        mv := malloc(a0 as u64)
        ret mv as i64
    end
    if str.Equals(name, "calloc"):
        cv := calloc(a0 as u64, a1 as u64)
        ret cv as i64
    end
    if str.Equals(name, "realloc"):
        rv := realloc(a0 as void*, a1 as u64)
        ret rv as i64
    end
    if str.Equals(name, "free"):
        free(a0 as void*)
        ret 0
    end
    if str.Equals(name, "memset"):
        msv := memset(a0 as void*, a1 as int, a2 as u64)
        ret msv as i64
    end
    if str.Equals(name, "memcpy"):
        mcv := memcpy(a0 as void*, a1 as void*, a2 as u64)
        ret mcv as i64
    end
    if str.Equals(name, "memmove"):
        mmv := memmove(a0 as void*, a1 as void*, a2 as u64)
        ret mmv as i64
    end
    if str.Equals(name, "remove"):
        ret remove(nx_str(a0))
    end
    if str.Equals(name, "rename"):
        ret rename(nx_str(a0), nx_str(a1))
    end
    if str.Equals(name, "fopen"):
        fv := fopen(nx_str(a0), nx_str(a1))
        ret fv as i64
    end
    if str.Equals(name, "fclose"):
        ret fclose(a0 as void*)
    end
    if str.Equals(name, "fflush"):
        ret fflush(a0 as void*)
    end
    if str.Equals(name, "fseek"):
        ret fseek(a0 as void*, a1 as int, a2 as int)
    end
    if str.Equals(name, "ftell"):
        ret ftell(a0 as void*)
    end
    if str.Equals(name, "fread"):
        ret fread(a0 as void*, a1 as u64, a2 as u64, a3 as void*) as i64
    end
    if str.Equals(name, "fwrite"):
        ret fwrite(a0 as void*, a1 as u64, a2 as u64, a3 as void*) as i64
    end
    if str.Equals(name, "fgetc"):
        ret fgetc(a0 as void*)
    end
    if str.Equals(name, "fgets"):
        gsv := fgets(a0 as void*, a1 as int, a2 as void*)
        ret gsv as i64
    end
    if str.Equals(name, "exit"):
        if g_ip_embedded:
            g_ip_exit_req = true
            g_ip_exit_code = a0 as int
            rt_fail(g_vm, "exit")
            ret 0
        end
        exit(a0 as int)
    end
    if str.Equals(name, "abort"):
        if g_ip_embedded:
            g_ip_exit_req = true
            g_ip_exit_code = 134
            rt_fail(g_vm, "abort")
            ret 0
        end
        abort()
    end
    if str.Equals(name, "socket"):
        ret net.Socket(a0 as int, a1 as int, a2 as int)
    end
    if str.Equals(name, "connect"):
        ret net.Connect(a0, a1 as void*, a2 as int)
    end
    if str.Equals(name, "send"):
        ret net.Send(a0, a1 as void*, a2 as int, a3 as int)
    end
    if str.Equals(name, "recv"):
