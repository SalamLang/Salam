package interp

func gc_st_put(ip &: Interp, s: SStruct): int:
    ip.gc_new++
    if ip.sts_free.Len() > 0:
        id := ip.sts_free.Pop()
        ip.sts.Set(id, s)
        ret id
    end
    ip.sts.Push(s)
    ret ip.sts.Len() - 1
end

func gc_arr_put(ip &: Interp, ar: Arr): int:
    ip.gc_new++
    if ip.arrs_free.Len() > 0:
        id := ip.arrs_free.Pop()
        ip.arrs.Set(id, ar)
        ret id
    end
    ip.arrs.Push(ar)
    ret ip.arrs.Len() - 1
end

func gc_map_put(ip &: Interp, m: SMap): int:
    ip.gc_new++
    if ip.maps_free.Len() > 0:
        id := ip.maps_free.Pop()
        ip.maps.Set(id, m)
        ret id
    end
    ip.maps.Push(m)
    ret ip.maps.Len() - 1
end

func gc_var_put(ip &: Interp, v: SVariant): int:
    ip.gc_new++
    if ip.vars_free.Len() > 0:
        id := ip.vars_free.Pop()
        ip.variants.Set(id, v)
        ret id
    end
    ip.variants.Push(v)
    ret ip.variants.Len() - 1
end

func gc_safe(ip &: Interp): bool:
    ret not g_threads_on and ip.tw_depth == 0
end

func vm_tw_leave(ip &: Interp):
    ip.tw_depth--
end

func gc_flags(n: int): Vector<bool>:
    mut v := Vector {} as Vector<bool>
    repeat n:
        v.Push(false)
    end
    ret v
end

func gc_push(work &: Vector<Value>, v: Value):
    k := v.kind
    if k == VAL_STRUCT or k == VAL_ARRAY or k == VAL_MAP or k == VAL_VARIANT or k == VAL_MAPITER:
        work.Push(v)
    end
end

func gc_push_all(work &: Vector<Value>, vals: Vector<Value>):
    repeat vals.Len() in i:
        gc_push(work, vals.Get(i))
    end
end

func gc_collect(ip &: Interp):
    mut ms := gc_flags(ip.sts.Len())
    mut ma := gc_flags(ip.arrs.Len())
    mut mm := gc_flags(ip.maps.Len())
    mut mv := gc_flags(ip.variants.Len())
    defer ms.Free()
    defer ma.Free()
    defer mm.Free()
    defer mv.Free()
    mut work := Vector {} as Vector<Value>
    defer work.Free()
    repeat ip.envs.Len() in ei:
        gc_push_all(work, ip.envs.Ref(ei).vals)
    end
    gc_push_all(work, ip.match_subj)
    gc_push_all(work, ip.mem_boxes)
    gc_push_all(work, ip.extern_fns)
    repeat ip.vm_fns.Len() in fi:
        fp := ip.vm_fns.Get(fi) as VmFn*
        gc_push_all(work, fp.kv)
    end
    mut fk := 0
    until fk + 1 < ip.vm_frames.Len():
        R := ip.vm_frames.Get(fk) as Value*
        n := ip.vm_frames.Get(fk + 1) as int
        repeat n in ri:
            gc_push(work, R[ri])
        end
        fk += 2
    end
    until work.Len() > 0:
        v := work.Pop()
        id := v.id
        if v.kind == VAL_STRUCT:
            if id > 0 and id < ms.Len() and not ms.Get(id):
                ms.Set(id, true)
                gc_push_all(work, ip.sts.Ref(id).fvals)
            end
        else v.kind == VAL_ARRAY:
            if id > 0 and id < ma.Len() and not ma.Get(id):
                ma.Set(id, true)
                ar := ip.arrs.Ref(id)
                if ar.is_view:
                    gc_push(work, Value { kind = VAL_ARRAY, id = ar.base })
                end
                gc_push_all(work, ar.items)
            end
        else v.kind == VAL_MAP:
            if id > 0 and id < mm.Len() and not mm.Get(id):
                mm.Set(id, true)
                mp := ip.maps.Ref(id)
                gc_push_all(work, mp.keys)
                gc_push_all(work, mp.vals)
            end
        else v.kind == VAL_MAPITER:
            if id > 0 and id < ip.iters.Len():
                gc_push(work, Value { kind = VAL_MAP, id = ip.iters.Get(id).map })
            end
        else:
            if id > 0 and id < mv.Len() and not mv.Get(id):
                mv.Set(id, true)
                vp := ip.variants.Ref(id)
                if vp.has_boxed:
                    gc_push(work, vp.boxed)
                end
            end
        end
    end
    mut fs := gc_flags(ip.sts.Len())
    defer fs.Free()
    repeat ip.sts_free.Len() in q0:
        fs.Set(ip.sts_free.Get(q0), true)
    end
    mut live := 0
    mut si := 1
    until si < ip.sts.Len():
        if ms.Get(si):
            live++
        else not fs.Get(si):
            sp := ip.sts.Ref(si)
            sp.fnames.Free()
            sp.fvals.Free()
            ip.sts.Set(si, SStruct {})
            ip.sts_free.Push(si)
        end
        si++
    end
    mut fa := gc_flags(ip.arrs.Len())
    defer fa.Free()
    repeat ip.arrs_free.Len() in q1:
        fa.Set(ip.arrs_free.Get(q1), true)
    end
    mut ai := 1
    until ai < ip.arrs.Len():
        if ma.Get(ai):
            live++
        else not fa.Get(ai):
            ap := ip.arrs.Ref(ai)
            ap.items.Free()
            ip.arrs.Set(ai, Arr {})
            ip.arrs_free.Push(ai)
        end
        ai++
    end
    mut fm := gc_flags(ip.maps.Len())
    defer fm.Free()
    repeat ip.maps_free.Len() in q2:
        fm.Set(ip.maps_free.Get(q2), true)
    end
    mut mi := 1
    until mi < ip.maps.Len():
        if mm.Get(mi):
            live++
        else not fm.Get(mi):
            mp2 := ip.maps.Ref(mi)
            mp2.keys.Free()
            mp2.vals.Free()
            mp2.used.Free()
            mp2.index.Free()
            ip.maps.Set(mi, SMap {})
            ip.maps_free.Push(mi)
        end
        mi++
    end
    mut fv := gc_flags(ip.variants.Len())
    defer fv.Free()
    repeat ip.vars_free.Len() in q3:
        fv.Set(ip.vars_free.Get(q3), true)
    end
    mut vi := 1
    until vi < ip.variants.Len():
        if mv.Get(vi):
            live++
        else not fv.Get(vi):
            ip.variants.Set(vi, SVariant {})
            ip.vars_free.Push(vi)
        end
        vi++
    end
    ip.gc_new = 0
    ip.gc_next = live * 2 > ip.gc_min ? live * 2 : ip.gc_min
end

func gc_maybe(ip &: Interp):
    if ip.gc_new >= ip.gc_next and gc_safe(ip):
        gc_collect(ip)
    end
end
