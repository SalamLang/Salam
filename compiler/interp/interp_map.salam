package interp

import str

include co "../sal_core.salam"

func key_eq(ka: Value, kb: Value): bool:
    if ka.kind != kb.kind:
        ret false
    end
    if ka.kind == VAL_STR:
        ret str.Equals(ka.s, kb.s)
    end
    if ka.kind == VAL_INT or ka.kind == VAL_CHAR:
        if ka.ity >= ITY_I128 or kb.ity >= ITY_I128:
            ret wide_cmp(ka, kb) == 0
        end
        ret ka.i == kb.i
    end
    if ka.kind == VAL_BOOL:
        ret ka.b == kb.b
    end
    if ka.kind == VAL_FLOAT:
        ret ka.f == kb.f
    end
    ret false
end

func key_hash(k: Value): u64:
    if k.kind == VAL_STR:
        ret itab_hash(k.s)
    end
    if k.kind == VAL_INT or k.kind == VAL_CHAR:
        mut x := k.ity >= ITY_I128 ? (k.i as u64) ^ ((k.pa as u64) * (0xc4ceb9fe1a85ec53 as u64)) : k.i as u64
        x ^= (x >> (33 as u64))
        x *= (0xff51afd7ed558ccd as u64)
        x ^= (x >> (33 as u64))
        ret x
    end
    if k.kind == VAL_BOOL:
        ret k.b ? (2 as u64) : (1 as u64)
    end
    if k.kind == VAL_FLOAT:
        d := k.f == 0.0 ? 0.0 : k.f
        mut bits := f64_bits(d)
        bits ^= (bits >> (33 as u64))
        bits *= (0xff51afd7ed558ccd as u64)
        bits ^= (bits >> (33 as u64))
        ret bits
    end
    ret 0
end

func map_index_insert(m &: SMap, hash: u64, entry_idx: int):
    mask := m.index_cap - 1
    mut i := (hash & (mask as u64)) as int
    until true:
        s0 := m.index.Get(i)
        if s0 == 0 or s0 == 1:
            if s0 == 0:
                m.index_used++
            end
            m.index.Set(i, entry_idx + 2)
            ret
        end
        i = (i + 1) & mask
    end
end

func map_index_rebuild(m &: SMap, want: int):
    mut nc := 16
    until nc < want * 2:
        nc *= 2
    end
    old := m.index
    mut ni := Vector {} as Vector<int>
    repeat nc:
        ni.Push(0)
    end
    m.index = ni
    defer old.Free()
    m.index_cap = nc
    m.index_used = 0
    mcap := m.cap
    repeat mcap in i:
        if m.used.Get(i):
            map_index_insert(m, key_hash(m.keys.Get(i)), i)
        end
    end
end

func map_new(ip &: Interp): int:
    mut m := SMap {}
    m.cap = 8
    repeat 8:
        m.keys.Push(val_null())
        m.vals.Push(val_null())
        m.used.Push(false)
    end
    map_index_rebuild(m, 8)
    ret gc_map_put(ip, m)
end

func map_slot_pos(m: SMap, k: Value): int:
    mask := m.index_cap - 1
    mut i := (key_hash(k) & (mask as u64)) as int
    until true:
        s0 := m.index.Get(i)
        if s0 == 0:
            ret 0 - 1
        end
        if s0 != 1:
            ei := s0 - 2
            if m.used.Get(ei) and key_eq(m.keys.Get(ei), k):
                ret i
            end
        end
        i = (i + 1) & mask
    end
end

func map_find(m: SMap, k: Value): int:
    pos := map_slot_pos(m, k)
    if pos < 0:
        ret 0 - 1
    end
    ret m.index.Get(pos) - 2
end

func map_put(ip &: Interp, mid: int, k: Value, v: Value):
    mut m := ip.maps.Get(mid)
    e := map_find(m, k)
    if e >= 0:
        m.vals.Set(e, v)
        ip.maps.Set(mid, m)
        ret
    end
    if m.count + 1 > m.cap:
        nc := co.GrowCap(m.cap as u64, (m.count + 1) as u64, 8 as u64) as int
        until m.cap < nc:
            m.keys.Push(val_null())
            m.vals.Push(val_null())
            m.used.Push(false)
            m.cap++
        end
    end
    mut i := m.free_hint
    until i < m.cap and m.used.Get(i):
        i++
    end
    m.keys.Set(i, k)
    m.vals.Set(i, v)
    m.used.Set(i, true)
    m.count++
    m.free_hint = i + 1
    if (m.index_used + 1) * 4 >= m.index_cap * 3:
        map_index_rebuild(m, m.count)
    else:
        map_index_insert(m, key_hash(k), i)
    end
    ip.maps.Set(mid, m)
end

func map_remove(ip &: Interp, mid: int, k: Value): bool:
    mut m := ip.maps.Get(mid)
    pos := map_slot_pos(m, k)
    if pos < 0:
        ret false
    end
    ei := m.index.Get(pos) - 2
    m.used.Set(ei, false)
    m.count--
    if ei < m.free_hint:
        m.free_hint = ei
    end
    m.index.Set(pos, 1)
    ip.maps.Set(mid, m)
    ret true
end

func mk_struct(ip &: Interp, name: str, def: int, nfields: int): Value:
    mut s := SStruct { type_name = name, def = def }
    repeat nfields:
        s.fnames.Push("")
        s.fvals.Push(val_null())
    end
    ret Value { kind = VAL_STRUCT, id = gc_st_put(ip, s) }
end

func st_field_set(ip &: Interp, sid: int, i: int, name: str, v: Value):
    mut s := ip.sts.Get(sid)
    s.fnames.Set(i, name)
    s.fvals.Set(i, v)
    ip.sts.Set(sid, s)
end

func st_field_set_val(ip &: Interp, sid: int, i: int, v: Value):
    mut s := ip.sts.Get(sid)
    s.fvals.Set(i, v)
    ip.sts.Set(sid, s)
end

func st_find_field(ip &: Interp, sid: int, name: str): int:
    s := ip.sts.Get(sid)
    repeat s.fnames.Len() in i:
        if str.Equals(s.fnames.Get(i), name):
            ret i
        end
    end
    ret 0 - 1
end

func mk_closure(ip &: Interp, fnnode: int, env: int): Value:
    id := ip.closures.Len()
    ip.closures.Push(Closure { fn = fnnode, env = env })
    ret Value { kind = VAL_FUNC, id = id }
end

func mk_variant(ip &: Interp, tag: int, has_boxed: bool, boxed: Value): Value:
    ret val_variant(gc_var_put(ip, SVariant { tag = tag, has_boxed = has_boxed, boxed = boxed }))
end
