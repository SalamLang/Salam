package interp_net

if SALAM_OS_WINDOWS:
    link dynamic "ws2_32"
    link dynamic "winhttp"
end

if SALAM_OS_WINDOWS:
    extern:
        func rand_s(out: void*): int
        func WSAStartup(version: int, wsa: void*): int
        func socket(family: int, socktype: int, proto: int): usize
        func connect(s: usize, addr: void*, addrlen: int): int
        func send(s: usize, buf: void*, len: int, flags: int): int
        func recv(s: usize, buf: void*, len: int, flags: int): int
        func sendto(s: usize, buf: void*, len: int, flags: int, addr: void*, addrlen: int): int
        func recvfrom(s: usize, buf: void*, len: int, flags: int, addr: void*, addrlen: void*): int
        func closesocket(s: usize): int
        func shutdown(s: usize, how: int): int
        func setsockopt(s: usize, level: int, optname: int, optval: void*, optlen: int): int
        func getsockname(s: usize, addr: void*, addrlen: void*): int
        func ioctlsocket(s: usize, cmd: int, argp: void*): int
        func getaddrinfo(node: str, service: str, hints: void*, res: void*): int
        func freeaddrinfo(res: void*)
        func gethostbyname(name: str): void*
        func htons(n: int): int
        func ntohs(n: int): int
        func inet_ntoa(addr: int): str
        func WSAPoll(fds: void*, nfds: u32, timeout: int): int
        func WinHttpOpen(agent: void*, access_type: int, proxy: void*, bypass: void*, flags: int): void*
        func WinHttpConnect(session: void*, host: void*, port: int, flags: int): void*
        func WinHttpOpenRequest(conn: void*, verb: void*, path: void*, ver: void*, ref: void*, types: void*, flags: int): void*
        func WinHttpSendRequest(req: void*, headers: void*, hlen: int, body: str, blen: int, total: int, ctx: usize): int
        func WinHttpReceiveResponse(req: void*, reserved: void*): int
        func WinHttpQueryHeaders(req: void*, info: int, name: void*, buf: void*, buflen: void*, index: void*): int
        func WinHttpReadData(req: void*, buf: void*, toread: int, read: void*): int
        func WinHttpAddRequestHeaders(req: void*, headers: void*, hlen: int, modifiers: int): int
        func WinHttpCloseHandle(handle: void*): int
    end
else:
    extern:
        func socket(family: int, socktype: int, proto: int): int
        func connect(s: int, addr: void*, addrlen: int): int
        func send(s: int, buf: void*, len: int, flags: int): int
        func recv(s: int, buf: void*, len: int, flags: int): int
        func sendto(s: int, buf: void*, len: int, flags: int, addr: void*, addrlen: int): int
        func recvfrom(s: int, buf: void*, len: int, flags: int, addr: void*, addrlen: void*): int
        func close(s: int): int
        func shutdown(s: int, how: int): int
        func setsockopt(s: int, level: int, optname: int, optval: void*, optlen: int): int
        func getsockname(s: int, addr: void*, addrlen: void*): int
        func fcntl(s: int, cmd: int, ...): int
        func getaddrinfo(node: str, service: str, hints: void*, res: void*): int
        func freeaddrinfo(res: void*)
        func gethostbyname(name: str): void*
        func htons(n: int): int
        func ntohs(n: int): int
        func inet_ntoa(addr: int): str
        func poll(fds: void*, nfds: usize, timeout: int): int
    end
end

extern:
    func localtime(tp: void*): void*
end

pub func Socket(family: int, socktype: int, proto: int): i64:
    if SALAM_OS_WINDOWS:
        s := socket(family, socktype, proto)
        if s == (0 - 1) as usize: ret 0 - 1 end
        ret s as i64
    else:
        ret socket(family, socktype, proto)
    end
end

pub func Connect(s: i64, addr: void*, addrlen: int): int:
    if SALAM_OS_WINDOWS:
        ret connect(s as usize, addr, addrlen)
    else:
        ret connect(s as int, addr, addrlen)
    end
end

pub func Send(s: i64, buf: void*, len: int, flags: int): int:
    if SALAM_OS_WINDOWS:
        ret send(s as usize, buf, len, flags)
    else:
        ret send(s as int, buf, len, flags)
    end
end

pub func Recv(s: i64, buf: void*, len: int, flags: int): int:
    if SALAM_OS_WINDOWS:
        ret recv(s as usize, buf, len, flags)
    else:
        ret recv(s as int, buf, len, flags)
    end
end

pub func SendTo(s: i64, buf: void*, len: int, flags: int, addr: void*, addrlen: int): int:
    if SALAM_OS_WINDOWS:
        ret sendto(s as usize, buf, len, flags, addr, addrlen)
    else:
        ret sendto(s as int, buf, len, flags, addr, addrlen)
    end
end

pub func RecvFrom(s: i64, buf: void*, len: int, flags: int, addr: void*, addrlen: void*): int:
    if SALAM_OS_WINDOWS:
        ret recvfrom(s as usize, buf, len, flags, addr, addrlen)
    else:
        ret recvfrom(s as int, buf, len, flags, addr, addrlen)
    end
end

pub func CloseSock(s: i64): int:
    if SALAM_OS_WINDOWS:
        ret closesocket(s as usize)
    else:
        ret close(s as int)
    end
end

pub func ShutdownSock(s: i64, how: int): int:
    if SALAM_OS_WINDOWS:
        ret shutdown(s as usize, how)
    else:
        ret shutdown(s as int, how)
    end
end

pub func SetSockOpt(s: i64, level: int, optname: int, optval: void*, optlen: int): int:
    if SALAM_OS_WINDOWS:
        ret setsockopt(s as usize, level, optname, optval, optlen)
    else:
        ret setsockopt(s as int, level, optname, optval, optlen)
    end
end

pub func GetSockName(s: i64, addr: void*, addrlen: void*): int:
    if SALAM_OS_WINDOWS:
        ret getsockname(s as usize, addr, addrlen)
    else:
        ret getsockname(s as int, addr, addrlen)
    end
end

if SALAM_OS_WINDOWS:
    pub func IoctlSocket(s: i64, cmd: int, argp: void*): int:
        ret ioctlsocket(s as usize, cmd, argp)
    end
else:
    pub func Fcntl3(s: int, cmd: int, arg: int): int:
        ret fcntl(s, cmd, arg)
    end
end

pub func GetAddrInfo(node: str, service: str, hints: void*, res: void*): int:
    ret getaddrinfo(node, service, hints, res)
end

pub func FreeAddrInfo(res: void*):
    freeaddrinfo(res)
end

pub func GetHostByName(name: str): void*:
    ret gethostbyname(name)
end

pub func Htons(n: int): int:
    ret htons(n)
end

pub func Ntohs(n: int): int:
    ret ntohs(n)
end

pub func InetNtoa(addr: int): str:
    ret inet_ntoa(addr)
end

pub func Poll(fds: void*, nfds: u64, timeout: int): int:
    if SALAM_OS_WINDOWS:
        ret WSAPoll(fds, nfds as u32, timeout)
    else:
        ret poll(fds, nfds as usize, timeout)
    end
end

pub func LocalTime(tp: void*): void*:
    ret localtime(tp)
end

if SALAM_OS_WINDOWS:
    pub func RandS(out: void*): int:
        ret rand_s(out)
    end

    pub func WsaStartup(version: int, wsa: void*): int:
        ret WSAStartup(version, wsa)
    end

    pub func HttpOpen(agent: void*, access_type: int, proxy: void*, bypass: void*, flags: int): void*:
        ret WinHttpOpen(agent, access_type, proxy, bypass, flags)
    end

    pub func HttpConnect(session: void*, host: void*, port: int, flags: int): void*:
        ret WinHttpConnect(session, host, port, flags)
    end

    pub func HttpOpenRequest(conn: void*, verb: void*, path: void*, ver: void*, ref: void*, types: void*, flags: int): void*:
        ret WinHttpOpenRequest(conn, verb, path, ver, ref, types, flags)
    end

    pub func HttpSendRequest(req: void*, headers: void*, hlen: int, body: str, blen: int, total: int, ctx: i64): int:
        ret WinHttpSendRequest(req, headers, hlen, body, blen, total, ctx as usize)
    end

    pub func HttpReceiveResponse(req: void*, reserved: void*): int:
        ret WinHttpReceiveResponse(req, reserved)
    end

    pub func HttpQueryHeaders(req: void*, info: int, name: void*, buf: void*, buflen: void*, index: void*): int:
        ret WinHttpQueryHeaders(req, info, name, buf, buflen, index)
    end

    pub func HttpReadData(req: void*, buf: void*, toread: int, read: void*): int:
        ret WinHttpReadData(req, buf, toread, read)
    end

    pub func HttpAddRequestHeaders(req: void*, headers: void*, hlen: int, modifiers: int): int:
        ret WinHttpAddRequestHeaders(req, headers, hlen, modifiers)
    end

    pub func HttpCloseHandle(handle: void*): int:
        ret WinHttpCloseHandle(handle)
    end
end
