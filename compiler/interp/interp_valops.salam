package interp

import str
import math
import tok "../token.salam"
import at "../ast.salam"
import i18 "../i18n.salam"

// base_typename - prefix before '<' '[' '*' ' ', clamped at 95 chars like
// the C's char[96] buffer.
func base_typename(ts: str): str:
    n := str.Len(ts)
    mut b := str.NewBuilder()
    mut i := 0
    until i < n && i < 95:
        c := byte_at(ts, i)
        if c == 60 || c == 91 || c == 42 || c == 32:
            break
        end
        str.BufAppendChar(b, c)
        i += 1
    end
    r := str.BufStr(b)
    str.BufFree(b)
    ret r
end

func ptr_elem_from_typestr(ts: str): int:
    base := base_typename(ts)
    if str.Equals(base, "i8"):
        ret PTR_I8
    end
    if str.Equals(base, "u8") || str.Equals(base, "byte"):
        ret PTR_U8
    end
    if str.Equals(base, "i16"):
        ret PTR_I16
    end
    if str.Equals(base, "u16"):
        ret PTR_U16
    end
    if str.Equals(base, "i32"):
        ret PTR_I32
    end
    if str.Equals(base, "u32"):
        ret PTR_U32
    end
    if str.Equals(base, "i64"):
        ret PTR_I64
    end
    if str.Equals(base, "u64") || str.Equals(base, "size"):
        ret PTR_U64
    end
    if str.Equals(base, "f32"):
        ret PTR_F32
    end
    if str.Equals(base, "f64"):
        ret PTR_F64
    end
    if str.Equals(base, "str"):
        ret PTR_STR
    end
    ret PTR_OPAQUE
end

// ptr_load / ptr_store - raw typed memory access for FFI values. PTR_STR
// reinterprets the cell's pointer bits as a char* str (aliasing, like the
// C); a NULL cell loads as "" (the C's val_str(NULL) was unusable).
func ptr_load(pa: i64, elem: int, idx: i64): Value:
    if elem == PTR_I8:
        p0 := pa as i8*
        ret val_int_ty(p0[idx] as i64, ITY_I8)
    end
    if elem == PTR_U8:
        p1 := pa as u8*
        ret val_int_ty(p1[idx] as i64, ITY_U8)
    end
    if elem == PTR_I16:
        p2 := pa as i16*
        ret val_int_ty(p2[idx] as i64, ITY_I16)
    end
    if elem == PTR_U16:
        p3 := pa as u16*
        ret val_int_ty(p3[idx] as i64, ITY_U16)
    end
    if elem == PTR_I32:
        p4 := pa as i32*
        ret val_int_ty(p4[idx] as i64, ITY_I32)
    end
    if elem == PTR_U32:
        p5 := pa as u32*
        ret val_int_ty(p5[idx] as i64, ITY_U32)
    end
    if elem == PTR_I64:
        p6 := pa as i64*
        ret val_int_ty(p6[idx], ITY_I64)
    end
    if elem == PTR_U64:
        p7 := pa as u64*
        ret val_int_ty(p7[idx] as i64, ITY_U64)
    end
    if elem == PTR_F32:
        p8 := pa as f32*
        ret val_float(p8[idx] as f64)
    end
    if elem == PTR_F64:
        p9 := pa as f64*
        ret val_float(p9[idx])
    end
    if elem == PTR_STR:
        // C: val_str(((const char **)addr)[idx]) - alias the char* as a str.
        ps := pa as i64*
        bits := ps[idx]
        if bits == (0 as i64):
            ret val_str("")
        end
        sp := bits as void*
        ret val_str(sp as str)
    end
    pv := pa as i64*
    ret val_ptr(pv[idx], PTR_OPAQUE)
end

func ptr_store(pa: i64, elem: int, idx: i64, v: Value):
    if elem == PTR_I8:
        p0 := pa as i8*
        p0[idx] = to_int(v) as i8
        ret
    end
    if elem == PTR_U8:
        p1 := pa as u8*
        p1[idx] = to_int(v) as u8
        ret
    end
    if elem == PTR_I16:
        p2 := pa as i16*
        p2[idx] = to_int(v) as i16
        ret
    end
    if elem == PTR_U16:
        p3 := pa as u16*
        p3[idx] = to_int(v) as u16
        ret
    end
    if elem == PTR_I32:
        p4 := pa as i32*
        p4[idx] = to_int(v) as i32
        ret
    end
    if elem == PTR_U32:
        p5 := pa as u32*
        p5[idx] = to_int(v) as u32
        ret
    end
    if elem == PTR_I64:
        p6 := pa as i64*
        p6[idx] = to_int(v)
        ret
    end
    if elem == PTR_U64:
        p7 := pa as u64*
        p7[idx] = to_int(v) as u64
        ret
    end
    if elem == PTR_F32:
        p8 := pa as f32*
        p8[idx] = to_float(v) as f32
        ret
    end
    if elem == PTR_F64:
        p9 := pa as f64*
        p9[idx] = to_float(v)
        ret
    end
    if elem == PTR_STR:
        // C: cell = v.kind == VAL_STR ? v.as.s : "" (the value's char*).
        ps := pa as i64*
        cs := v.kind == VAL_STR ? v.s : ""
        cp := cs as void*
        ps[idx] = cp as i64
        ret
    end
    pv := pa as i64*
    pv[idx] = v.kind == VAL_PTR ? v.pa : to_int(v)
end

func is_int_typename(b0: str): bool:
    ret str.Equals(b0, "i8") || str.Equals(b0, "i16") || str.Equals(b0, "i32") || str.Equals(b0, "i64") || str.Equals(b0, "u8") || str.Equals(b0, "u16") || str.Equals(b0, "u32") || str.Equals(b0, "u64") || str.Equals(b0, "int") || str.Equals(b0, "byte") || str.Equals(b0, "char") || str.Equals(b0, "size")
end

func is_float_typename(b0: str): bool:
    ret str.Equals(b0, "f32") || str.Equals(b0, "f64") || str.Equals(b0, "float")
end

func zero_for_base(base: str): Value:
    if is_int_typename(base):
        ret val_int(0 as i64)
    end
    if is_float_typename(base):
        ret val_float(0.0)
    end
    if str.Equals(base, "bool"):
        ret val_bool(false)
    end
    if str.Equals(base, "str"):
        ret val_str("")
    end
    ret val_null()
end

// default_for_type - zero-filled array for "T[n]" type strings, else null.
func default_for_type(ip &: Interp, ts: str): Value:
    if str.Len(ts) == 0:
        ret val_null()
    end
    lb := str.Find(ts, "[")
    if lb < 0:
        ret val_null()
    end
    mut n := 0
    mut p := lb + 1
    tn := str.Len(ts)
    until p < tn && byte_at(ts, p) != 93:
        c := byte_at(ts, p)
        if c >= 48 && c <= 57:
            n = n * 10 + (c - 48)
        end
        p += 1
    end
    zero := zero_for_base(base_typename(ts))
    aid := arr_new(ip, n > 0 ? n : 4)
    repeat n:
        arr_push(ip, aid, zero)
    end
    ret val_arr(aid)
end

// binop_method - operator-overload method name for a token kind ("" = none).
func binop_method(op: int): str:
    if op == tok.TK_PLUS:
        ret "operator_add"
    end
    if op == tok.TK_MINUS:
        ret "operator_sub"
    end
    if op == tok.TK_STAR:
        ret "operator_mul"
    end
    if op == tok.TK_SLASH:
        ret "operator_div"
    end
    if op == tok.TK_PERCENT:
        ret "operator_mod"
    end
    if op == tok.TK_POWER:
        ret "operator_pow"
    end
    if op == tok.TK_EQ:
        ret "operator_eq"
    end
    if op == tok.TK_NE:
        ret "operator_ne"
    end
    if op == tok.TK_LT:
        ret "operator_lt"
    end
    if op == tok.TK_GT:
        ret "operator_gt"
    end
    if op == tok.TK_LE:
        ret "operator_le"
    end
    if op == tok.TK_GE:
        ret "operator_ge"
    end
    ret ""
end

func compound_base(op: int): int:
    if op == tok.TK_PLUS_EQ:
        ret tok.TK_PLUS
    end
    if op == tok.TK_MINUS_EQ:
        ret tok.TK_MINUS
    end
    if op == tok.TK_STAR_EQ:
        ret tok.TK_STAR
    end
    if op == tok.TK_SLASH_EQ:
        ret tok.TK_SLASH
    end
    if op == tok.TK_PERCENT_EQ:
        ret tok.TK_PERCENT
    end
    if op == tok.TK_POWER_EQ:
        ret tok.TK_POWER
    end
    if op == tok.TK_AMP_EQ:
        ret tok.TK_AMP
    end
    if op == tok.TK_PIPE_EQ:
        ret tok.TK_PIPE
    end
    if op == tok.TK_CARET_EQ:
        ret tok.TK_CARET
    end
    if op == tok.TK_SHL_EQ:
        ret tok.TK_SHL
    end
    if op == tok.TK_SHR_EQ:
        ret tok.TK_SHR
    end
    ret tok.TK_EOF
end

func try_struct_op(
    ip &: Interp, a &: at.Ast, op: int, va: Value, vb: Value, has_b: bool, found &: bool
): Value:
    found = false
    if va.kind != VAL_STRUCT:
        ret val_null()
    end
    mname := binop_method(op)
    if str.Len(mname) == 0:
        ret val_null()
    end
    stv := ip.sts.get(va.id)
    m := struct_method_arity(a, stv.def, mname, has_b ? 1 : 0)
    if m == 0 && op == tok.TK_NE:
        eqm := struct_method_arity(a, stv.def, "operator_eq", 1)
        if eqm != 0:
            denv := find_def_env(ip, eqm)
            found = true
            mut args1 := Vector {} as Vector<Value>
            args1.push(vb)
            r := call_func(
                ip, a, eqm, denv != 0 ? denv : ip.globals, true, va, args1
            )
            args1.free()
            ret val_bool(!to_bool(r))
        end
    end
    if m == 0:
        ret val_null()
    end
    found = true
    denv2 := find_def_env(ip, m)
    mut args2 := Vector {} as Vector<Value>
    defer args2.free()
    if has_b:
        args2.push(vb)
    end
    r2 := call_func(ip, a, m, denv2 != 0 ? denv2 : ip.globals, true, va, args2)
    ret r2
end

func int_ty_from_typestr(ts: str): int:
    if str.Len(ts) == 0:
        ret ITY_NONE
    end
    // Only bare scalar names count: a trailing '*', '[' or '<' means the
    // decoration is a pointer/array/generic type, not an integer.
    c0 := byte_at(ts, 0)
    if c0 == 105:
        if str.Equals(ts, "i8"):
            ret ITY_I8
        end
        if str.Equals(ts, "i16"):
            ret ITY_I16
        end
        if str.Equals(ts, "i32"):
            ret ITY_I32
        end
        if str.Equals(ts, "i64"):
            ret ITY_I64
        end
        if str.Equals(ts, "int"):
            ret ITY_I32
        end
        ret ITY_NONE
    end
    if c0 == 117:
        if str.Equals(ts, "u8"):
            ret ITY_U8
        end
        if str.Equals(ts, "u16"):
            ret ITY_U16
        end
        if str.Equals(ts, "u32"):
            ret ITY_U32
        end
        if str.Equals(ts, "u64"):
            ret ITY_U64
        end
        if str.Equals(ts, "uint"):
            ret ITY_U32
        end
        ret ITY_NONE
    end
    if c0 == 115:
        if str.Equals(ts, "size"):
            ret ITY_U64
        end
        ret ITY_NONE
    end
    if c0 == 98:
        if str.Equals(ts, "byte"):
            ret ITY_U8
        end
        ret ITY_NONE
    end
    ret ITY_NONE
end

// Common type of a binary operation (SALAM-TYPES.md 15): same signedness
// picks the higher rank. Mixed signedness is rejected by semantic analysis,
// so it can only be reached from undecorated values; there the sized operand
// wins, which is what the int-literal adaptation in check_binary() would have
// produced for the usual `x + 1` shape.
func int_ty_common(x: int, y: int): int:
    if x == y:
        ret x
    end
    if x == ITY_NONE:
        ret y
    end
    if y == ITY_NONE:
        ret x
    end
    if int_ty_is_unsigned(x) != int_ty_is_unsigned(y):
        ret int_ty_is_unsigned(x) ? x : y
    end
    ret int_ty_rank(x) >= int_ty_rank(y) ? x : y
end

func coerce_int_ty(v: Value, t: int): Value:
    if t == ITY_NONE || v.kind != VAL_INT:
        ret v
    end
    mut r := v
    r.ity = t
    r.i = int_ty_wrap(t, v.i)
    ret r
end

func arith(ip &: Interp, a &: at.Ast, n: int, op: int, x: Value, y: Value): Value:
    if op == tok.TK_PLUS && (x.kind == VAL_STR || y.kind == VAL_STR):
        ret val_str(to_str(ip, x) + to_str(ip, y))
    end
    if op == tok.TK_STAR && (x.kind == VAL_STR || y.kind == VAL_STR):
        x_str := x.kind == VAL_STR
        sv := x_str ? x : y
        nv := x_str ? y : x
        ret str_repeat(sv.s, to_int(nv))
    end
    if op == tok.TK_POWER:
        r := math.Pow(to_float(x), to_float(y))
        if x.kind == VAL_INT && y.kind == VAL_INT && r == math.Floor(r) && math.Abs(r) < 9200000000000000000.0:
            ret val_int(r as i64)
        end
        ret val_float(r)
    end
    if is_intlike(x) && is_intlike(y):
        // Shifts keep the left operand's type; everything else uses the
        // common type of both. The operation is then carried out at that
        // type's width and signedness and wrapped back into it, so u32/u64
        // results stay unsigned instead of reading back as negative i64.
        shift := op == tok.TK_SHL || op == tok.TK_SHR
        rt := shift ? x.ity : int_ty_common(x.ity, y.ity)
        uns := int_ty_is_unsigned(rt)
        bits := int_ty_bits(rt)
        xi := int_ty_wrap(rt, x.i)
        yi := shift ? y.i : int_ty_wrap(rt, y.i)
        ux := xi as u64
        uy := yi as u64
        shmask := (bits - 1) as u64
        negone := (0 as i64) - (1 as i64)
        // INT64_MIN (a literal-lhs 1<<63 would be const-folded at 32 bits)
        imin := (0x8000000000000000 as u64) as i64
        if op == tok.TK_PLUS:
            ret val_int_ty((ux + uy) as i64, rt)
        end
        if op == tok.TK_MINUS:
            ret val_int_ty((ux - uy) as i64, rt)
        end
        if op == tok.TK_STAR:
            ret val_int_ty((ux * uy) as i64, rt)
        end
        if op == tok.TK_SLASH:
            if yi == (0 as i64):
                rt_error(ip, a, n, i18.Tr("division by zero"))
                ret val_null()
            end
            if uns:
                ret val_int_ty((ux / uy) as i64, rt)
            end
            if xi == imin && yi == negone:
                ret val_int_ty(imin, rt)
            end
            ret val_int_ty(xi / yi, rt)
        end
        if op == tok.TK_PERCENT:
            if yi == (0 as i64):
                rt_error(ip, a, n, i18.Tr("modulo by zero"))
                ret val_null()
            end
            if uns:
                ret val_int_ty((ux % uy) as i64, rt)
            end
            if xi == imin && yi == negone:
                ret val_int_ty(0 as i64, rt)
            end
            ret val_int_ty(xi % yi, rt)
        end
        if op == tok.TK_AMP:
            ret val_int_ty((ux & uy) as i64, rt)
        end
        if op == tok.TK_PIPE:
            ret val_int_ty((ux | uy) as i64, rt)
        end
        if op == tok.TK_CARET:
            ret val_int_ty((ux ^ uy) as i64, rt)
        end
        if op == tok.TK_SHL:
            ret val_int_ty((ux << (uy & shmask)) as i64, rt)
        end
        if op == tok.TK_SHR:
            // Logical for unsigned, arithmetic for signed - decided by the
            // declared type, not by the sign of the i64 carrier. ux is
            // already the zero-extended pattern when rt is unsigned.
            if uns:
                ret val_int_ty((ux >> (uy & shmask)) as i64, rt)
            end
            ret val_int_ty(xi >> ((uy & shmask) as i64), rt)
        end
    end
    xf := to_float(x)
    yf := to_float(y)
    if op == tok.TK_PLUS:
        ret val_float(xf + yf)
    end
    if op == tok.TK_MINUS:
        ret val_float(xf - yf)
    end
    if op == tok.TK_STAR:
        ret val_float(xf * yf)
    end
    if op == tok.TK_SLASH:
        if yf == 0.0:
            rt_error(ip, a, n, i18.Tr("division by zero"))
            ret val_null()
        end
        ret val_float(xf / yf)
    end
    if op == tok.TK_PERCENT:
        if yf == 0.0:
            rt_error(ip, a, n, i18.Tr("modulo by zero"))
            ret val_null()
        end
        ret val_float(math.Mod(xf, yf))
    end
    rt_error(ip, a, n, i18.Tr("unsupported arithmetic operator"))
    ret val_null()
end

func value_cmp(x: Value, y: Value): int:
    if x.kind == VAL_STR && y.kind == VAL_STR:
        c := str.Compare(x.s, y.s)
        ret c < 0 ? (0 - 1) : (c > 0 ? 1 : 0)
    end
    // Integer pairs compare as integers: going through f64 both loses
    // precision past 2^53 and would order u64 values by their signed
    // reinterpretation.
    if is_intlike(x) && is_intlike(y):
        rt := int_ty_common(x.ity, y.ity)
        xi := int_ty_wrap(rt, x.i)
        yi := int_ty_wrap(rt, y.i)
        if int_ty_is_unsigned(rt):
            ux := xi as u64
            uy := yi as u64
            ret ux < uy ? (0 - 1) : (ux > uy ? 1 : 0)
        end
        ret xi < yi ? (0 - 1) : (xi > yi ? 1 : 0)
    end
    xf := to_float(x)
    yf := to_float(y)
    ret xf < yf ? (0 - 1) : (xf > yf ? 1 : 0)
end

func value_eq(x: Value, y: Value): bool:
    if x.kind == VAL_STR && y.kind == VAL_STR:
        ret str.Equals(x.s, y.s)
    end
    if x.kind == VAL_PTR && y.kind == VAL_PTR:
        ret x.pa == y.pa
    end
    if x.kind == VAL_PTR && y.kind == VAL_NULL:
        ret x.pa == (0 as i64)
    end
    if x.kind == VAL_NULL && y.kind == VAL_PTR:
        ret y.pa == (0 as i64)
    end
    if x.kind == VAL_NULL || y.kind == VAL_NULL:
        ret x.kind == y.kind
    end
    if x.kind == VAL_BOOL || y.kind == VAL_BOOL:
        ret to_bool(x) == to_bool(y)
    end
    if is_intlike(x) && is_intlike(y):
        rt := int_ty_common(x.ity, y.ity)
        ret int_ty_wrap(rt, x.i) == int_ty_wrap(rt, y.i)
    end
    if is_number(x) && is_number(y):
        ret to_float(x) == to_float(y)
    end
    if x.kind == VAL_STRUCT && y.kind == VAL_STRUCT:
        ret x.id == y.id
    end
    ret false
end
