                pc += VM_W
                continue
            end
            VOP_EXEC:
                xmk := env_mark(ip)
                xe := vm_env_make(ip, f, R, y)
                mut xfr := Frame {}
                mut xrv := val_null()
                ip.tw_depth += 1
                xfl := exec_stmt(ip, a, xe, xfr, x, xrv)
                ip.tw_depth -= 1
                run_defers_from(ip, a, xfr, 0)
                xfr.defer_stmts.free()
                xfr.defer_envs.free()
                vm_env_back(ip, f, R, y, xe)
                env_release(ip, xmk)
                if ip.failed:
                    running = false
                    continue
                end
                if xfl == FLOW_RETURN or xfl == FLOW_MATCH_RET:
                    retv = xrv
                    if f.has_defer:
                        vm_run_defers(ip, a, f, R, dstack, 0)
                    end
                    running = false
                    continue
                end
                if (xfl == FLOW_BREAK and z >= 0) or (xfl == FLOW_CONTINUE and C[pc + 4] >= 0):
                    if C[pc + 5] >= 0:
                        vm_run_defers(ip, a, f, R, dstack, R[C[pc + 5]].i as int)
                    end
                    if xfl == FLOW_BREAK:
                        ip.break_levels = 0
                        pc = z
                    else:
                        pc = C[pc + 4]
                    end
                    continue
                end
                pc += VM_W
                continue
            end
            VOP_RET:
                retv = R[x]
                if f.has_defer:
                    vm_run_defers(ip, a, f, R, dstack, 0)
                end
                running = false
                continue
            end
            VOP_RETN:
                retv = Value {}
                if f.has_defer:
                    vm_run_defers(ip, a, f, R, dstack, 0)
                end
                running = false
                continue
            end
            VOP_DEFER:
                dstack.push(x)
                dstack.push(y)
                pc += VM_W
                continue
            end
            VOP_DMARK:
                R[x].kind = VAL_INT
                R[x].ity = ITY_I64
                R[x].i = dstack.len() as i64
                pc += VM_W
                continue
            end
            VOP_RUNDEF:
                vm_run_defers(ip, a, f, R, dstack, R[x].i as int)
                if ip.failed:
                    running = false
                    continue
                end
                pc += VM_W
                continue
            end
            VOP_CASE:
                csj := R[y]
                clo := R[z]
                cop := C[pc + 4]
                mut cm := false
                if cop == tok.TK_KW_TO:
                    cm = value_cmp(csj, clo) >= 0 and value_cmp(csj, R[C[pc + 5]]) <= 0
                else cop == 0 or cop == tok.TK_EQ:
                    if csj.kind == VAL_INT and clo.kind == VAL_INT and csj.ity == clo.ity:
                        cm = csj.i == clo.i
                    else:
                        cm = value_eq(csj, clo)
                    end
                else cop == tok.TK_NE:
                    cm = not value_eq(csj, clo)
                else:
                    cc := value_cmp(csj, clo)
                    if cop == tok.TK_GT:
                        cm = cc > 0
                    else cop == tok.TK_GE:
                        cm = cc >= 0
                    else cop == tok.TK_LT:
                        cm = cc < 0
                    else:
                        cm = cc <= 0
                    end
                end
                R[x].kind = VAL_BOOL
                R[x].b = cm
                pc += VM_W
                continue
            end
            VOP_SLIT:
                if C[pc + 4] == 0:
                    if str.Equals(at.At(a, y).name, "HashMap"):
                        R[x] = val_map(map_new(ip))
                    else:
                        R[x] = val_arr(arr_new(ip, 4))
                    end
                    pc += VM_W
                    continue
                end
                slv := vm_struct_lit(ip, a, y, C[pc + 4], R, z)
                if ip.failed:
                    running = false
                    continue
                end
                R[x] = slv
                pc += VM_W
                continue
            end
            VOP_SIZEOF:
                R[x] = val_int(interp_sizeof_typename(ip, a, at.At(a, y).type_str))
                vm_fix(R, x, z)
                pc += VM_W
                continue
            end
            VOP_STRCMP:
                R[x] = val_int(str.Compare(to_str(ip, R[y]), to_str(ip, R[z])) as i64)
                vm_fix(R, x, C[pc + 4])
                pc += VM_W
                continue
            end
            VOP_FMTF:
                R[x] = val_str(co.FmtF64(to_float(R[y])))
                pc += VM_W
                continue
            end
            VOP_DEFAULT:
                R[x] = default_for_type(ip, f.ks.get(y))
                pc += VM_W
                continue
            end
            VOP_REPNUM:
                rv := R[y]
                if rv.kind == VAL_INT:
                    R[x] = val_int(rv.i)
                else rv.kind == VAL_FLOAT:
                    R[x] = val_int(rv.f as i64)
                else:
                    rt_error(ip, a, z, i18.Tr(f.ks.get(C[pc + 4])))
                    running = false
                    continue
                end
                pc += VM_W
                continue
            end
            VOP_REPSTEP:
                if R[z].i <= (0 as i64):
                    rt_error(ip, a, C[pc + 4], i18.Tr("repeat step must be positive"))
                    running = false
                    continue
                end
                if R[x].i > R[y].i:
                    R[z] = val_int((0 as i64) - R[z].i)
                end
                pc += VM_W
                continue
            end
            VOP_REPJF:
                kv := R[x].i
                ev2 := R[y].i
                mode := C[pc + 4]
                mut more := false
                if mode == 1:
                    more = kv < ev2
                else mode == 2:
                    more = (kv as u64) < (ev2 as u64)
                else:
                    more = rep_more(kv, ev2, R[z].i, false)
                end
                if more:
                    pc += VM_W
                else:
                    pc = C[pc + 5]
                end
                continue
            end
            VOP_XCALL, VOP_ICALL:
                xci := f.calls.ref(C[pc + 4])
                mut xargs := vm_call_args(R, y, z)
                mut xres := Value {}
                if op == VOP_ICALL:
                    mut xh := false
                    xres = call_intrinsic(ip, xci.method, xargs, xh)
                else:
                    xres = call_native_extern(ip, a, 0, xci.call, xci.fn, xargs)
                end
                xargs.free()
                if ip.failed:
                    running = false
                    continue
                end
                R[x] = xres
                vm_fix(R, x, xci.ity)
                pc += VM_W
                continue
            end
            VOP_SETG:
                sgn := f.ks.get(y)
                mut sgw := 0
                sgs := env_find(ip, f.defenv, sgn, sgw)
                if sgs < 0:
                    rt_error(
                        ip, a, z, co.Format1(
                            i18.Tr("assignment to undeclared variable '%s'"), co.ArgStr(sgn)
                        )
                    )
                    running = false
                    continue
                end
                env_slot_set(ip, sgw, sgs, R[x])
                pc += VM_W
                continue
            end
            VOP_LEN:
                lv := vm_len(ip, a, z, R[y])
                if ip.failed:
                    running = false
                    continue
                end
                R[x] = lv
                pc += VM_W
                continue
            end
            else:
                rt_error(ip, a, f.fnnode, "internal error: bad vm opcode")
                running = false
                continue
            end
        end
    end
    ip.match_expr_depth = saved_med
    if ip.failed:
        ret val_null()
    end
    if f.has_ref:
        repeat f.nparam in ri:
            if f.param_ref.get(ri) and ri < nargs:
                argp[ri] = R[pbase + ri]
            end
        end
    end
    ret retv
end
