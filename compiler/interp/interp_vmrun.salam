                R[x] = vm_coerce_node(ip, a, C[pc + 4], fval)
                pc += VM_W
                continue
            end
            VOP_SETFIELD:
                mut floc := vm_member_loc(ip, a, C[pc + 4], R[x])
                if ip.failed:
                    running = false
                    continue
                end
                interp_loc_set(ip, a, floc, R[z])
                if ip.failed:
                    running = false
                    continue
                end
                pc += VM_W
                continue
            end
            VOP_EVAL:
                emk := env_mark(ip)
                ee := vm_env_make(ip, f, R, z)
                ip.tw_depth += 1
