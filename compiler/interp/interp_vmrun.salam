                        vm_fix(R, x, mci.ity)
                        pc += VM_W
                        continue
                    end
                end
                mut margs := vm_call_args(R, z, mna)
                mtw := back_addr != (0 as i64) ? 1 : 0
                ip.tw_depth += mtw
                mres := method_call_values(ip, a, 0, mci.call, mci.obj, mci.method, recvr, margs, back_addr, back_ts)
                ip.tw_depth -= mtw
                if ip.failed:
                    margs.free()
                    running = false
                    continue
                end
                vm_back(mci, R, margs)
                margs.free()
                R[x] = mres
                vm_fix(R, x, mci.ity)
                pc += VM_W
                continue
            end
            VOP_PRINT:
                sink(ip, to_str(ip, R[x]), y == 1)
                pc += VM_W
                continue
            end
            VOP_PRINTS:
                sink(ip, f.ks.get(x), y == 1)
                pc += VM_W
                continue
            end
            VOP_IDX:
                if R[y].kind == VAL_PTR and R[y].pa != (0 as i64) and R[z].kind == VAL_INT:
                    lpe := R[y].pe
                    if lpe == PTR_I64:
                        lp64 := R[y].pa as i64*
                        lv64 := lp64[R[z].i]
                        R[x].kind = VAL_INT
                        R[x].ity = ITY_I64
                        R[x].i = lv64
                        vm_fix(R, x, C[pc + 5])
                        pc += VM_W
                        continue
                    end
                    if lpe == PTR_I32:
                        lp32 := R[y].pa as i32*
                        lv32 := lp32[R[z].i] as i64
                        R[x].kind = VAL_INT
                        R[x].ity = ITY_I32
                        R[x].i = lv32
                        vm_fix(R, x, C[pc + 5])
                        pc += VM_W
                        continue
                    end
                    if lpe == PTR_F64:
                        lpf := R[y].pa as f64*
                        lvf := lpf[R[z].i]
                        R[x].kind = VAL_FLOAT
                        R[x].f = lvf
                        pc += VM_W
                        continue
                    end
                end
                ixv := vm_index(ip, a, C[pc + 4], R[y], R[z])
                if ip.failed:
                    running = false
                    continue
                end
                R[x] = ixv
                vm_fix(R, x, C[pc + 5])
                pc += VM_W
                continue
            end
            VOP_STIDX:
                if R[x].kind == VAL_PTR and R[x].pa != (0 as i64) and R[y].kind == VAL_INT:
                    spe := R[x].pe
                    if spe == PTR_I64 and R[z].kind == VAL_INT:
                        sp64 := R[x].pa as i64*
                        sp64[R[y].i] = R[z].i
                        pc += VM_W
                        continue
                    end
                    if spe == PTR_I32 and R[z].kind == VAL_INT:
                        sp32 := R[x].pa as i32*
                        sp32[R[y].i] = R[z].i as i32
                        pc += VM_W
                        continue
                    end
                    if spe == PTR_F64 and R[z].kind == VAL_FLOAT:
                        spf := R[x].pa as f64*
                        spf[R[y].i] = R[z].f
                        pc += VM_W
                        continue
                    end
                end
                mut sloc := vm_index_loc(ip, a, C[pc + 4], R[x], R[y])
                if ip.failed:
                    running = false
                    continue
                end
                interp_loc_set(ip, a, sloc, R[z])
                if ip.failed:
                    running = false
                    continue
                end
                pc += VM_W
                continue
            end
            VOP_IDXLOC:
                mut gloc := vm_index_loc(ip, a, C[pc + 4], R[y], R[z])
                if ip.failed:
                    running = false
                    continue
                end
                R[x] = interp_loc_get(ip, a, gloc)
                if ip.failed:
                    running = false
                    continue
                end
                pc += VM_W
                continue
            end
            VOP_FIELD:
                fo := R[y]
                if fo.kind == VAL_STRUCT:
                    fsp := ip.sts.ref(fo.id)
                    fcache := C[pc + 5]
                    mut ffi := (fcache & 0xFFFFF) - 1
                    fslot := pc / VM_W
                    if ffi < 0 or AX[fslot] != fsp.def + 1 or ffi >= fsp.fvals.len():
                        ffi = st_find_field(ip, fo.id, f.ks.get(z))
                        C[pc + 5] = (ffi + 1) | ((vc_ity(a, C[pc + 4]) + 1) << 20)
                        AX[fslot] = fsp.def + 1
                    end
                    if ffi >= 0:
                        R[x] = fsp.fvals.get(ffi)
                        vm_fix(R, x, (C[pc + 5] >> 20) - 1)
                        pc += VM_W
                        continue
                    end
                end
                fval := member_value(ip, a, C[pc + 4], fo)
                if ip.failed:
                    running = false
                    continue
