package interp

import str
import os

include co "../sal_core.salam"
include tok "../token.salam"
include at "../ast.salam"
include i18 "../i18n.salam"

func vm_get(ip &: Interp, a &: at.Ast, fnnode: int, defenv: int, has_this: bool): int:
    if ip.vm_state == 0:
        ev := os.Env("SALAM_VM")
        ip.vm_state = str.Equals(ev, "0") ? 2 : 1
    end
    if ip.vm_state != 1 or fnnode <= 0:
        ret 0
    end
    until ip.vm_of.len() <= fnnode:
        ip.vm_of.push(0)
    end
    st := ip.vm_of.get(fnnode)
    if st < 0:
        ret 0
    end
    if st > 0:
        fp := ip.vm_fns.ref(st - 1)
        if fp.defenv != defenv or fp.has_this != has_this:
            ret 0
        end
        ret st
    end
    ip.vm_of.set(fnnode, 0 - 1)
    mut c := vm_compile(ip, a, fnnode, defenv, has_this)
    c.names.free()
    c.regs.free()
    c.patch.free()
    c.patch_kind.free()
    c.loop_mark.free()
    c.loop_cont.free()
    if not c.ok or ip.failed:
        ret 0
    end
    ip.vm_fns.push(c.f)
    ip.vm_of.set(fnnode, ip.vm_fns.len())
    ret ip.vm_fns.len()
end

func vm_coerce_node(ip &: Interp, a &: at.Ast, n: int, v: Value): Value:
    if v.kind != VAL_INT or n == 0:
        ret v
    end
    if n < ip.node_ity.len():
        c := ip.node_ity.get(n)
        if c != 0:
            ret coerce_int_ty(v, c - 1)
        end
    else:
        until ip.node_ity.len() <= n:
            ip.node_ity.push(0)
        end
    end
    ity := int_ty_from_typestr(at.At(a, n).type_str)
    ip.node_ity.set(n, ity + 1)
    ret coerce_int_ty(v, ity)
end

func vm_env_make(ip &: Interp, f &: VmFn, R: Value*, sync: int): int:
    e := env_new(ip, f.defenv)
    cnt := f.sync.get(sync)
    repeat cnt in i:
        nm := f.ks.get(f.sync.get(sync + 1 + i * 2))
        r := f.sync.get(sync + 2 + i * 2)
        env_define(ip, e, nm, R[r])
    end
    ret e
end

func vm_env_back(ip &: Interp, f &: VmFn, R: Value*, sync: int, e: int):
    cnt := f.sync.get(sync)
    repeat cnt in i:
        nm := f.ks.get(f.sync.get(sync + 1 + i * 2))
        r := f.sync.get(sync + 2 + i * 2)
        slot := env_find_local(ip, e, nm)
        if slot >= 0:
            R[r] = env_slot_val(ip, e, slot)
        end
    end
end

func vm_index(ip &: Interp, a &: at.Ast, n: int, iav: Value, idxv: Value): Value:
    if iav.kind == VAL_STRUCT:
        stv := ip.sts.get(iav.id)
        m := struct_method(a, stv.def, "operator_index")
        if m != 0:
            denv := find_def_env(ip, m)
            mut ia := Vector {} as Vector<Value>
            ia.push(idxv)
            r := call_func(ip, a, m, denv != 0 ? denv : ip.globals, true, iav, ia)
            ia.free()
            ret r
        end
    end
    if iav.kind == VAL_ARRAY:
        iv := to_int(idxv)
        ln := arr_len(ip, iav.id)
        if iv < (0 as i64) or iv >= (ln as i64):
            rt_error(
                ip, a, n, co.Format2(
                    i18.Tr("index %lld out of range (len %zu)"), co.ArgInt(iv), co.ArgUint(ln as u64)
                )
            )
            ret val_null()
        end
        ret arr_get(ip, iav.id, iv as int)
    end
    if iav.kind == VAL_STR:
        iv2 := to_int(idxv)
        ln2 := str.Len(iav.s)
        if iv2 < (0 as i64) or iv2 >= (ln2 as i64):
            rt_error(ip, a, n, i18.Tr("string index out of range"))
            ret val_null()
        end
        ret val_char(byte_at(iav.s, iv2 as int) as i64)
    end
    if iav.kind == VAL_PTR:
        if iav.pa == (0 as i64):
            rt_error(ip, a, n, i18.Tr("dereference of a null pointer"))
            ret val_null()
        end
        ret mem_ptr_load(ip, a, iav, to_int(idxv))
    end
    if to_int(idxv) == (0 as i64):
        ret iav
    end
    rt_error(ip, a, n, i18.Tr("value is not indexable"))
    ret val_null()
end

func vm_index_loc(ip &: Interp, a &: at.Ast, target: int, av: Value, kv: Value): Loc:
    mut loc := Loc {}
    loc.target = target
    if av.kind == VAL_STRUCT:
        stv2 := ip.sts.get(av.id)
        set_m := struct_method(a, stv2.def, "operator_index_set")
        if set_m != 0:
            loc.kind = ILOC_OPIDX
            loc.obj = av
            loc.key = kv
            loc.set_m = set_m
            loc.get_m = struct_method(a, stv2.def, "operator_index")
            ret loc
        end
        rt_error(ip, a, target, i18.Tr("value is not index-assignable"))
        ret loc
    end
    if av.kind == VAL_ARRAY:
        iv := to_int(kv)
        if iv < (0 as i64) or iv >= (arr_len(ip, av.id) as i64):
            rt_error(ip, a, target, i18.Tr("index out of range in assignment"))
            ret loc
        end
        loc.kind = ILOC_ARR
        loc.arr = av.id
        loc.idx = iv
        ret loc
    end
    if av.kind == VAL_PTR:
        if av.pa == (0 as i64):
            rt_error(ip, a, target, i18.Tr("write through a null pointer"))
            ret loc
        end
        loc.kind = ILOC_PTR
        loc.pa = av.pa
        loc.pe = av.pe
        loc.pts = av.s
        loc.idx = to_int(kv)
        ret loc
    end
    rt_error(ip, a, target, i18.Tr("value is not index-assignable"))
    ret loc
end

func vm_member_loc(ip &: Interp, a &: at.Ast, target: int, obj: Value): Loc:
    mut loc := Loc {}
    loc.target = target
    tn := at.At(a, target)
    if obj.kind == VAL_PTR:
        mut paddr := 0 as i64
        mut pts := ""
        if interp_mem_ptr_field(ip, a, obj, tn.name, paddr, pts):
            loc.kind = ILOC_MEM
            loc.mem = paddr
            loc.mem_ts = pts
            ret loc
        end
    end
    if obj.kind != VAL_STRUCT:
        rt_error(ip, a, target, i18.Tr("cannot assign to member of non-struct"))
        ret loc
    end
    fi2 := st_find_field(ip, obj.id, tn.name)
    if fi2 >= 0:
        loc.kind = ILOC_FIELD
        loc.obj = obj
        loc.field_idx = fi2
        ret loc
    end
    stv := ip.sts.get(obj.id)
    rt_error(
        ip, a, target, co.Format2(
            i18.Tr("struct '%s' has no field '%s'"), co.ArgStr(stv.type_name), co.ArgStr(tn.name)
        )
    )
    ret loc
end

func vm_len(ip &: Interp, a &: at.Ast, n: int, la: Value): Value:
    if la.kind == VAL_ARRAY:
        ret val_int(arr_len(ip, la.id) as i64)
    end
    if la.kind == VAL_STR:
        ret val_int(str.Len(la.s) as i64)
    end
    if la.kind == VAL_MAP:
        lm := ip.maps.get(la.id)
        ret val_int(lm.count as i64)
    end
    rt_error(ip, a, n, i18.Tr("len() expects an array, string, or map"))
    ret val_null()
end

func vm_icmp(op: int, xi: i64, yi: i64, uns: bool): bool:
    mut c := 0
    if uns:
        ux := xi as u64
        uy := yi as u64
        c = ux < uy ? (0 - 1) : (ux > uy ? 1 : 0)
    else:
        c = xi < yi ? (0 - 1) : (xi > yi ? 1 : 0)
    end
    if op == tok.TK_EQ: ret c == 0 end
    if op == tok.TK_NE: ret c != 0 end
    if op == tok.TK_LT: ret c < 0 end
    if op == tok.TK_GT: ret c > 0 end
    if op == tok.TK_LE: ret c <= 0 end
    ret c >= 0
end

func vm_fcmp(op: int, x: f64, y: f64): bool:
    mut c := 0
    c = x < y ? (0 - 1) : (x > y ? 1 : 0)
    if op == tok.TK_EQ: ret x == y end
    if op == tok.TK_NE: ret x != y end
    if op == tok.TK_LT: ret c < 0 end
    if op == tok.TK_GT: ret c > 0 end
    if op == tok.TK_LE: ret c <= 0 end
    ret c >= 0
end

func vm_iop(ip &: Interp, a &: at.Ast, n: int, op: int, rt: int, x: Value, y: Value, out &: Value): bool:
    if x.kind != VAL_INT or y.kind != VAL_INT:
        ret false
    end
    bits := int_ty_bits(rt)
    wide := bits >= 64
    xi := wide ? x.i : int_ty_wrap(rt, x.i)
    shift := op == VOP_SHLI or op == VOP_SHRI
    yi := (wide or shift) ? y.i : int_ty_wrap(rt, y.i)
    ux := xi as u64
    uy := yi as u64
    mut r := 0 as i64
    if op == VOP_ADDI:
        r = (ux + uy) as i64
    else op == VOP_SUBI:
        r = (ux - uy) as i64
    else op == VOP_MULI:
        r = (ux * uy) as i64
    else op == VOP_DIVI or op == VOP_MODI:
        if yi == (0 as i64):
            rt_error(ip, a, n, op == VOP_DIVI ? i18.Tr("division byv zero") : i18.Tr("modulo byv zero"))
            out = val_null()
            ret true
        end
        imin := (0x8000000000000000 as u64) as i64
        negone := (0 as i64) - (1 as i64)
        if int_ty_is_unsigned(rt):
            r = op == VOP_DIVI ? (ux / uy) as i64 : (ux % uy) as i64
        else xi == imin and yi == negone:
            r = op == VOP_DIVI ? imin : (0 as i64)
        else:
            r = op == VOP_DIVI ? xi / yi : xi % yi
        end
    else op == VOP_ANDI:
        r = (ux & uy) as i64
    else op == VOP_ORI:
        r = (ux | uy) as i64
    else op == VOP_XORI:
        r = (ux ^ uy) as i64
    else op == VOP_SHLI:
        r = (ux << (uy & ((bits - 1) as u64))) as i64
    else:
        if int_ty_is_unsigned(rt):
            r = (ux >> (uy & ((bits - 1) as u64))) as i64
        else:
            r = xi >> ((uy & ((bits - 1) as u64)) as i64)
        end
    end
    out = Value { kind = VAL_INT, ity = rt, i = wide ? r : int_ty_wrap(rt, r) }
    ret true
end

func vm_iop_tok(op: int): int:
    if op == VOP_ADDI: ret tok.TK_PLUS end
    if op == VOP_SUBI: ret tok.TK_MINUS end
    if op == VOP_MULI: ret tok.TK_STAR end
    if op == VOP_DIVI: ret tok.TK_SLASH end
    if op == VOP_MODI: ret tok.TK_PERCENT end
    if op == VOP_ANDI: ret tok.TK_AMP end
    if op == VOP_ORI: ret tok.TK_PIPE end
    if op == VOP_XORI: ret tok.TK_CARET end
    if op == VOP_SHLI: ret tok.TK_SHL end
    if op == VOP_SHRI: ret tok.TK_SHR end
    if op == VOP_ADDF: ret tok.TK_PLUS end
    if op == VOP_SUBF: ret tok.TK_MINUS end
    if op == VOP_MULF: ret tok.TK_STAR end
    ret tok.TK_SLASH
end

func vm_call_args(R: Value*, base: int, n: int): Vector<Value>:
    mut args := Vector {} as Vector<Value>
    repeat n in i:
        args.push(R[base + i])
    end
    ret args
end

func vm_tb_push(ip &: Interp, call: int): bool:
    tracked := not g_threads_on
    if tracked:
        ip.tb_call.push(call)
        ip.tb_file.push(ip.cur_file)
    end
    ret tracked
end

func vm_tb_pop(ip &: Interp, tracked: bool):
    if tracked:
        _tc := ip.tb_call.pop()
        _tf := ip.tb_file.pop()
    end
end

func vm_back(ci &: VmCall, R: Value*, args: Vector<Value>):
    repeat ci.back.len() in i:
        r := ci.back.get(i)
        if r >= 0 and i < args.len():
            R[r] = args.get(i)
        end
    end
end

func vm_exec(
    ip &: Interp, a &: at.Ast, vi: int, defenv: int, has_this: bool, thisv: Value, args: Vector<Value>
): Value:
    mut f := ip.vm_fns.get(vi - 1)
    mut regs := Vector {} as Vector<Value>
    defer regs.free()
    repeat f.nreg + 1:
        regs.push(Value {})
    end
    R := regs.data
    C := f.code.data
    pbase := has_this ? 1 : 0
    if has_this:
        R[0] = thisv
    end
    repeat f.nparam in pi:
        reg := pbase + pi
        if pi < args.len():
            av := args.get(pi)
            R[reg] = f.param_ref.get(pi) ? av : val_copy_deep(ip, av)
        else f.param_def.get(pi) != 0:
            mk0 := env_mark(ip)
            e0 := env_new(ip, defenv)
            if has_this:
                env_define(ip, e0, "this", thisv)
            end
            repeat pi in pj:
                env_define(ip, e0, at.At(a, at.Child(a, f.fnnode, pj)).name, R[pbase + pj])
            end
            R[reg] = eval(ip, a, e0, f.param_def.get(pi))
            env_release(ip, mk0)
            if ip.failed:
                ret val_null()
            end
        end
        pty := f.param_ity.get(pi)
        if pty != ITY_NONE and R[reg].kind == VAL_INT:
            R[reg] = coerce_int_ty(R[reg], pty)
        end
    end
    saved_med := ip.match_expr_depth
    ip.match_expr_depth = 0
    mut retv := val_null()
    mut pc := 0
    mut running := true
    until running:
        op := C[pc]
        x := C[pc + 1]
        y := C[pc + 2]
        z := C[pc + 3]
        switch op:
            VOP_LOADK:
                R[x] = f.kv.get(y)
                pc += VM_W
                continue
            end
            VOP_MOV:
                R[x] = R[y]
                pc += VM_W
                continue
            end
            VOP_COPY:
                cv := R[y]
                if cv.kind == VAL_STRUCT or cv.kind == VAL_ARRAY:
                    R[x] = val_copy_deep(ip, cv)
                else:
                    R[x] = cv
                end
                pc += VM_W
                continue
            end
            VOP_COERCE:
                if y != ITY_NONE and R[x].kind == VAL_INT:
                    R[x] = coerce_int_ty(R[x], y)
                end
                pc += VM_W
                continue
            end
            VOP_ADDI, VOP_SUBI, VOP_MULI, VOP_DIVI, VOP_MODI, VOP_ANDI, VOP_ORI, VOP_XORI, VOP_SHLI, VOP_SHRI:
                xv := R[y]
                yv := R[z]
                rt := C[pc + 4]
                if op == VOP_ADDI and xv.kind == VAL_INT and yv.kind == VAL_INT and (rt == ITY_I64 or rt == ITY_U64):
                    R[x].kind = VAL_INT
                    R[x].ity = rt
                    R[x].i = ((xv.i as u64) + (yv.i as u64)) as i64
                    pc += VM_W
                    continue
                end
                mut iv := val_null()
                if not vm_iop(ip, a, C[pc + 5], op, rt, xv, yv, iv):
                    iv = binary_values(ip, a, C[pc + 5], vm_iop_tok(op), xv, yv)
                end
                if ip.failed:
                    running = false
                    continue
                end
                R[x] = iv
                pc += VM_W
                continue
            end
            VOP_ADDF, VOP_SUBF, VOP_MULF, VOP_DIVF:
                fx := R[y]
                fy := R[z]
                xf := fx.kind == VAL_FLOAT ? fx.f : to_float(fx)
                yf := fy.kind == VAL_FLOAT ? fy.f : to_float(fy)
                mut fr := 0.0
                if op == VOP_ADDF:
                    fr = xf + yf
                else op == VOP_SUBF:
                    fr = xf - yf
                else op == VOP_MULF:
                    fr = xf * yf
                else:
                    fr = xf / yf
                end
                if C[pc + 4] == 1:
                    fr = f32_narrow(fr)
                end
                if (fx.kind == VAL_FLOAT or fx.kind == VAL_INT) and (fy.kind == VAL_FLOAT or fy.kind == VAL_INT):
                    R[x] = val_float(fr)
                else:
                    R[x] = binary_values(ip, a, C[pc + 5], vm_iop_tok(op), fx, fy)
                end
                pc += VM_W
                continue
            end
            VOP_CMPI:
                cx := R[y]
                cy := R[z]
                if cx.kind == VAL_INT and cy.kind == VAL_INT:
                    crt := C[pc + 5]
                    R[x] = val_bool(vm_icmp(C[pc + 4], int_ty_wrap(crt, cx.i), int_ty_wrap(crt, cy.i), int_ty_is_unsigned(crt)))
                else:
                    R[x] = binary_values(ip, a, 0, C[pc + 4], cx, cy)
                end
                pc += VM_W
                continue
            end
            VOP_CMPF:
                gx := R[y]
                gy := R[z]
                if (gx.kind == VAL_FLOAT or gx.kind == VAL_INT) and (gy.kind == VAL_FLOAT or gy.kind == VAL_INT):
                    R[x] = val_bool(vm_fcmp(C[pc + 4], to_float(gx), to_float(gy)))
                else:
                    R[x] = binary_values(ip, a, 0, C[pc + 4], gx, gy)
                end
                pc += VM_W
                continue
            end
            VOP_BIN:
                bv := binary_values(ip, a, C[pc + 5], C[pc + 4], R[y], R[z])
                if ip.failed:
                    running = false
                    continue
                end
                R[x] = vm_coerce_node(ip, a, C[pc + 5], bv)
                pc += VM_W
                continue
            end
            VOP_CBIN:
                mut cfound := false
                bx := R[y]
                byv := R[z]
                cr := try_struct_op(ip, a, C[pc + 4], bx, byv, true, cfound)
                cv2 := cfound ? cr : arith(ip, a, C[pc + 5], C[pc + 4], bx, byv)
                if ip.failed:
                    running = false
                    continue
                end
                R[x] = cv2
                pc += VM_W
                continue
            end
            VOP_UN:
                uv := unary_value(ip, a, z, R[y])
                if ip.failed:
                    running = false
                    continue
                end
                R[x] = vm_coerce_node(ip, a, C[pc + 4], uv)
                pc += VM_W
                continue
            end
            VOP_NOT:
                R[x] = val_bool(not to_bool(R[y]))
                pc += VM_W
                continue
            end
            VOP_BOOL:
                R[x] = val_bool(to_bool(R[y]))
                pc += VM_W
                continue
            end
            VOP_NEGI:
                nv := R[y]
                if nv.kind == VAL_INT:
                    R[x] = val_int_ty(((0 as u64) - (nv.i as u64)) as i64, nv.ity)
                else:
                    R[x] = unary_value(ip, a, tok.TK_MINUS, nv)
                end
                pc += VM_W
                continue
            end
            VOP_NEGF:
                nf := R[y]
                if nf.kind == VAL_FLOAT:
                    R[x] = val_float(0.0 - nf.f)
                else:
                    R[x] = unary_value(ip, a, tok.TK_MINUS, nf)
                end
                pc += VM_W
                continue
            end
            VOP_CAST:
                ccv := cast_value(ip, a, z, R[y])
                if ip.failed:
                    running = false
                    continue
                end
                R[x] = vm_coerce_node(ip, a, z, ccv)
                pc += VM_W
                continue
            end
            VOP_CASTI:
                R[x] = val_int_ty(to_int(R[y]), z)
                pc += VM_W
                continue
            end
            VOP_CASTF:
                ff := to_float(R[y])
                R[x] = val_float(z == 1 ? f32_narrow(ff) : ff)
                pc += VM_W
                continue
            end
            VOP_JMP:
                pc = x
                continue
            end
            VOP_JF, VOP_JT:
                jv := R[x]
                jc := jv.kind == VAL_BOOL ? jv.b : to_bool(jv)
                if jc == (op == VOP_JT):
                    pc = y
                else:
                    pc += VM_W
                end
                continue
            end
            VOP_LOOP:
                tick(ip)
                if ip.failed:
                    running = false
                    continue
                end
                pc = x
                continue
            end
            VOP_GETG:
                gname := f.ks.get(y)
                mut gw := 0
                gslot := env_find(ip, f.defenv, gname, gw)
                if gslot >= 0:
                    R[x] = vm_coerce_node(ip, a, z, env_slot_val(ip, gw, gslot))
                else:
                    gfn := find_func(ip, a, gname, 0 - 1)
                    if gfn != 0:
                        R[x] = mk_closure(ip, gfn, ip.globals)
                    else:
                        rt_error(
                            ip, a, z, co.Format1(
                                i18.Tr("undefined variable '%s'"), co.ArgStr(gname)
                            )
                        )
                        running = false
                        continue
                    end
                end
                pc += VM_W
                continue
            end
            VOP_GETM:
                mname := f.ks.get(z)
                mslot := env_find_local(ip, y, mname)
                if mslot < 0:
                    md := ip.mods.get(C[pc + 5])
                    rt_error(
                        ip, a, C[pc + 4], co.Format2(
                            i18.Tr("package '%s' has no member '%s'"), co.ArgStr(md.name), co.ArgStr(mname)
                        )
                    )
                    running = false
                    continue
                end
                R[x] = vm_coerce_node(ip, a, C[pc + 4], env_slot_val(ip, y, mslot))
                pc += VM_W
                continue
            end
            VOP_CALL:
                ci := f.calls.get(C[pc + 4])
                mut cargs := vm_call_args(R, y, z)
                ctr := vm_tb_push(ip, ci.call)
                cres := call_func(ip, a, ci.fn, ci.env, false, val_null(), cargs)
                vm_tb_pop(ip, ctr)
                if ip.failed:
                    cargs.free()
                    running = false
                    continue
                end
                vm_back(ci, R, cargs)
                cargs.free()
                R[x] = vm_coerce_node(ip, a, ci.call, cres)
                pc += VM_W
                continue
            end
            VOP_CALLV:
                cvi := f.calls.get(C[pc + 5])
                fid := fn_id_of(R[y])
                if fid < 0 or fid >= ip.closures.len():
                    rt_error(
                        ip, a, cvi.call, co.Format1(
                            i18.Tr("call to undefined function '%s'"), co.ArgStr(cvi.method)
                        )
                    )
                    running = false
                    continue
                end
                vcl := ip.closures.get(fid)
                mut vargs := vm_call_args(R, z, C[pc + 4])
                vtr := vm_tb_push(ip, cvi.call)
                vres := call_func(ip, a, vcl.fn, vcl.env, false, val_null(), vargs)
                vm_tb_pop(ip, vtr)
                if ip.failed:
                    vargs.free()
                    running = false
                    continue
                end
                vm_back(cvi, R, vargs)
                vargs.free()
                R[x] = vm_coerce_node(ip, a, cvi.call, vres)
                pc += VM_W
                continue
            end
            VOP_MCALL:
                mci := f.calls.get(C[pc + 5])
                mut recvr := R[y]
                mut back_addr := 0 as i64
                mut back_ts := ""
                if recvr.kind == VAL_PTR and recvr.pe == PTR_STRUCT and recvr.pa != (0 as i64) and slot_kind(ip, recvr.s) == SLOT_STRUCT:
                    back_addr = recvr.pa
                    back_ts = recvr.s
                    recvr = interp_mem_load(ip, a, back_addr, back_ts)
                end
                mut margs := vm_call_args(R, z, C[pc + 4])
                mres := method_call_values(ip, a, 0, mci.call, mci.obj, mci.method, recvr, margs, back_addr, back_ts)
                if ip.failed:
                    margs.free()
                    running = false
                    continue
                end
                vm_back(mci, R, margs)
                margs.free()
                R[x] = vm_coerce_node(ip, a, mci.call, mres)
                pc += VM_W
                continue
            end
            VOP_PRINT:
                sink(ip, to_str(ip, R[x]), y == 1)
                pc += VM_W
                continue
            end
            VOP_PRINTS:
                sink(ip, f.ks.get(x), y == 1)
                pc += VM_W
                continue
            end
            VOP_IDX:
                ixv := vm_index(ip, a, C[pc + 4], R[y], R[z])
                if ip.failed:
                    running = false
                    continue
                end
                R[x] = vm_coerce_node(ip, a, C[pc + 4], ixv)
                pc += VM_W
                continue
            end
            VOP_STIDX:
                mut sloc := vm_index_loc(ip, a, C[pc + 4], R[x], R[y])
                if ip.failed:
                    running = false
                    continue
                end
                interp_loc_set(ip, a, sloc, R[z])
                if ip.failed:
                    running = false
                    continue
                end
                pc += VM_W
                continue
            end
            VOP_IDXLOC:
                mut gloc := vm_index_loc(ip, a, C[pc + 4], R[y], R[z])
                if ip.failed:
                    running = false
                    continue
                end
                R[x] = interp_loc_get(ip, a, gloc)
                if ip.failed:
                    running = false
                    continue
                end
                pc += VM_W
                continue
            end
            VOP_FIELD:
                fo := R[y]
                if fo.kind == VAL_STRUCT:
                    fsp := ip.sts.ref(fo.id)
                    fname := f.ks.get(z)
                    mut ffi := C[pc + 5] - 1
                    if ffi < 0 or ffi >= fsp.fnames.len() or not str.Equals(fsp.fnames.get(ffi), fname):
                        ffi = st_find_field(ip, fo.id, fname)
                        C[pc + 5] = ffi + 1
                    end
                    if ffi >= 0:
                        R[x] = vm_coerce_node(ip, a, C[pc + 4], fsp.fvals.get(ffi))
                        pc += VM_W
                        continue
                    end
                end
                fval := member_value(ip, a, C[pc + 4], fo)
                if ip.failed:
                    running = false
                    continue
                end
                R[x] = vm_coerce_node(ip, a, C[pc + 4], fval)
                pc += VM_W
                continue
            end
            VOP_SETFIELD:
                mut floc := vm_member_loc(ip, a, C[pc + 4], R[x])
                if ip.failed:
                    running = false
                    continue
                end
                interp_loc_set(ip, a, floc, R[z])
                if ip.failed:
                    running = false
                    continue
                end
                pc += VM_W
                continue
            end
            VOP_EVAL:
                emk := env_mark(ip)
                ee := vm_env_make(ip, f, R, z)
                evv := eval(ip, a, ee, y)
                vm_env_back(ip, f, R, z, ee)
                env_release(ip, emk)
                if ip.failed:
                    running = false
                    continue
                end
                mut epf := FLOW_NORMAL
                _tp := take_pending_flow(ip, epf)
                R[x] = evv
                pc += VM_W
                continue
            end
            VOP_EXEC:
                xmk := env_mark(ip)
                xe := vm_env_make(ip, f, R, y)
                mut xfr := Frame {}
                mut xrv := val_null()
                xfl := exec_stmt(ip, a, xe, xfr, x, xrv)
                run_defers_from(ip, a, xfr, 0)
                xfr.defer_stmts.free()
                xfr.defer_envs.free()
                vm_env_back(ip, f, R, y, xe)
                env_release(ip, xmk)
                if ip.failed:
                    running = false
                    continue
                end
                if xfl == FLOW_RETURN or xfl == FLOW_MATCH_RET:
                    retv = xrv
                    running = false
                    continue
                end
                if xfl == FLOW_BREAK and z >= 0:
                    ip.break_levels = 0
                    pc = z
                    continue
                end
                if xfl == FLOW_CONTINUE and C[pc + 4] >= 0:
                    pc = C[pc + 4]
                    continue
                end
                pc += VM_W
                continue
            end
            VOP_RET:
                retv = R[x]
                running = false
                continue
            end
            VOP_RETN:
                retv = val_null()
                running = false
                continue
            end
            VOP_DEFAULT:
                R[x] = default_for_type(ip, f.ks.get(y))
                pc += VM_W
                continue
            end
            VOP_REPNUM:
                rv := R[y]
                if rv.kind == VAL_INT:
                    R[x] = val_int(rv.i)
                else rv.kind == VAL_FLOAT:
                    R[x] = val_int(rv.f as i64)
                else:
                    rt_error(ip, a, z, i18.Tr(f.ks.get(C[pc + 4])))
                    running = false
                    continue
                end
                pc += VM_W
                continue
            end
            VOP_REPSTEP:
                if R[z].i <= (0 as i64):
                    rt_error(ip, a, C[pc + 4], i18.Tr("repeat step must be positive"))
                    running = false
                    continue
                end
                if R[x].i > R[y].i:
                    R[z] = val_int((0 as i64) - R[z].i)
                end
                pc += VM_W
                continue
            end
            VOP_REPJF:
                kv := R[x].i
                ev2 := R[y].i
                mode := C[pc + 4]
                mut more := false
                if mode == 1:
                    more = kv < ev2
                else mode == 2:
                    more = (kv as u64) < (ev2 as u64)
                else:
                    more = rep_more(kv, ev2, R[z].i, false)
                end
                if more:
                    pc += VM_W
                else:
                    pc = C[pc + 5]
                end
                continue
            end
            VOP_LEN:
                lv := vm_len(ip, a, z, R[y])
                if ip.failed:
                    running = false
                    continue
                end
                R[x] = lv
                pc += VM_W
                continue
            end
            else:
                rt_error(ip, a, f.fnnode, "internal error: bad vm opcode")
                running = false
                continue
            end
        end
    end
    ip.match_expr_depth = saved_med
    if ip.failed:
        ret val_null()
    end
    repeat f.nparam in ri:
        if f.param_ref.get(ri) and ri < args.len():
            args.set(ri, R[pbase + ri])
        end
    end
    ret retv
end
