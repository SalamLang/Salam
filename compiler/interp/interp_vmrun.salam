                pc += VM_W
                continue
            end
            VOP_CALL:
                ci := f.calls.ref(C[pc + 4])
                mut dvi := ci.vi
                if dvi == 0:
                    dvi = vm_get(ip, a, ci.fn, ci.env, false)
                    ci.vi = dvi > 0 ? dvi : (0 - 1)
                    if ci.fn < ip.fn_file.len():
                        ci.file = ip.fn_file.get(ci.fn)
                    end
                end
                if dvi > 0:
                    dres := vm_call_vm(ip, a, ci.call, ci.fn, ci.file, dvi, ci.env, false, Value {}, vm_reg_at(R, y), z)
                    if ip.failed:
                        running = false
                        continue
