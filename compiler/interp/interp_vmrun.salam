            VOP_JF, VOP_JT:
                jc := R[x].kind == VAL_BOOL ? R[x].b : to_bool(R[x])
                if jc == (op == VOP_JT):
                    pc = y
                else:
                    pc += VM_W
                end
                continue
            end
            VOP_LOOP:
                tick(ip)
                if ip.gc_new >= ip.gc_next:
                    gc_maybe(ip)
                end
                if ip.failed:
                    running = false
                    continue
                end
                pc = x
                continue
            end
            VOP_GETG:
                gname := f.ks.get(y)
                mut gw := 0
                gslot := env_find(ip, f.defenv, gname, gw)
                if gslot >= 0:
                    R[x] = env_slot_val(ip, gw, gslot)
                    vm_fix(R, x, C[pc + 4])
                else:
                    gfn := find_func(ip, a, gname, 0 - 1)
                    if gfn != 0:
                        R[x] = mk_closure(ip, gfn, ip.globals)
                    else:
                        rt_error(
                            ip, a, z, co.Format1(
                                i18.Tr("undefined variable '%s'"), co.ArgStr(gname)
                            )
                        )
                        running = false
                        continue
                    end
                end
                pc += VM_W
                continue
            end
            VOP_THISF:
                tname := f.ks.get(y)
                tv := R[0]
                if tv.kind == VAL_STRUCT:
                    tfi := st_find_field(ip, tv.id, tname)
                    if tfi >= 0:
                        R[x] = ip.sts.ref(tv.id).fvals.get(tfi)
                        vm_fix(R, x, C[pc + 4])
                        pc += VM_W
                        continue
                    end
                end
                tfn := find_func(ip, a, tname, 0 - 1)
                if tfn != 0:
                    R[x] = mk_closure(ip, tfn, ip.globals)
                    pc += VM_W
                    continue
                end
                rt_error(
                    ip, a, z, co.Format1(
                        i18.Tr("undefined variable '%s'"), co.ArgStr(tname)
                    )
                )
                running = false
                continue
            end
            VOP_GETM:
                mname := f.ks.get(z)
                mslot := env_find_local(ip, y, mname)
                if mslot < 0:
