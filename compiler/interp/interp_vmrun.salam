                    vm_backp(ci, R, vm_reg_at(R, y))
                    R[x] = dres
                    crt2 := C[pc + 5]
                    if crt2 != ITY_NONE and R[x].kind == VAL_INT and R[x].ity != crt2:
                        R[x].i = vm_wrap(crt2, R[x].i)
                        R[x].ity = crt2
                    end
                    pc += VM_W
                    continue
                end
                mut cargs := vm_call_args(R, y, z)
                ctr := vm_tb_push(ip, ci.call)
                cres := call_func(ip, a, ci.fn, ci.env, false, val_null(), cargs)
                vm_tb_pop(ip, ctr)
                if ip.failed:
                    cargs.free()
                    running = false
                    continue
                end
                vm_back(ci, R, cargs)
                cargs.free()
                R[x] = cres
                vm_fix(R, x, ci.ity)
                pc += VM_W
                continue
            end
            VOP_CALLV:
                cvi := f.calls.get(C[pc + 5])
                fid := fn_id_of(R[y])
                if fid < 0 or fid >= ip.closures.len():
