                        ip, a, cvi.call, co.Format1(
                            i18.Tr("call to undefined function '%s'"), co.ArgStr(cvi.method)
                        )
                    )
                    running = false
                    continue
                end
                vcl := ip.closures.get(fid)
                mut vargs := vm_call_args(R, z, C[pc + 4])
                vtr := vm_tb_push(ip, cvi.call)
                vres := call_func(ip, a, vcl.fn, vcl.env, false, val_null(), vargs)
                vm_tb_pop(ip, vtr)
                if ip.failed:
                    vargs.free()
                    running = false
                    continue
                end
                vm_back(cvi, R, vargs)
                vargs.free()
                R[x] = vres
                vm_fix(R, x, cvi.ity)
                pc += VM_W
                continue
            end
            VOP_MCALL:
                mci := f.calls.ref(C[pc + 5])
                mut recvr := R[y]
                mut back_addr := 0 as i64
                mut back_ts := ""
                if recvr.kind == VAL_PTR and recvr.pe == PTR_STRUCT and recvr.pa != (0 as i64) and slot_kind(ip, recvr.s) == SLOT_STRUCT:
                    back_addr = recvr.pa
                    back_ts = recvr.s
                    recvr = interp_mem_load(ip, a, back_addr, back_ts)
                end
                mna := C[pc + 4]
                if recvr.kind == VAL_STRUCT and not (mna == 0 and str.Equals(mci.method, "free")):
                    sdef := ip.sts.ref(recvr.id).def
                    if mci.cdef != sdef or mci.cfn == 0:
                        mut mm := struct_method_arity(a, sdef, mci.method, mna)
                        if mm == 0:
                            mm = struct_method(a, sdef, mci.method)
                        end
                        mci.cdef = sdef
                        mci.cfn = mm
                        mci.cvi = 0
                        mci.isvec = false
                        if mm != 0:
                            mdenv := find_def_env(ip, mm)
                            mci.cenv = mdenv != 0 ? mdenv : ip.globals
                            mci.cvi = vm_get(ip, a, mm, mci.cenv, true)
                            mci.cfile = vm_file_of(ip, mm)
                            mci.isvec = mci.vk != 0 and vm_is_std_vector(ip, ip.sts.ref(recvr.id), mm)
                        end
                    end
                    if mci.isvec and mci.cfn != 0:
                        vsp := ip.sts.ref(recvr.id)
                        vcnt := vsp.fvals.get(1).i
                        if mci.vk == 3:
                            R[x] = Value { kind = VAL_INT, ity = ITY_I32, i = vcnt }
                            vm_fix(R, x, mci.ity)
                            pc += VM_W
                            continue
                        end
                        vi0 := R[z]
                        vdat := vsp.fvals.get(0)
                        if vi0.kind == VAL_INT and vdat.kind == VAL_PTR and vdat.pa != (0 as i64) and ((vi0.i as u64) & (0xFFFFFFFF as u64)) < ((vcnt as u64) & (0xFFFFFFFF as u64)):
                            if mci.vk == 1:
                                mut gv := Value {}
                                if vm_ptr_get(vdat.pa, vdat.pe, vi0.i, gv):
                                    R[x] = gv
                                    vm_fix(R, x, mci.ity)
                                    pc += VM_W
                                    continue
                                end
                            else:
                                if vm_ptr_put(vdat.pa, vdat.pe, vi0.i, R[z + 1]):
                                    R[x] = Value {}
                                    pc += VM_W
                                    continue
                                end
                            end
                        end
                    end
                    if mci.cfn != 0 and mci.cvi > 0:
                        margp := vm_reg_at(R, z)
                        if back_addr != (0 as i64):
                            ip.tw_depth += 1
                        end
                        mres2 := vm_call_vm(ip, a, mci.call, mci.cfn, mci.cfile, mci.cvi, mci.cenv, true, recvr, margp, mna)
                        if back_addr != (0 as i64):
                            ip.tw_depth -= 1
                        end
                        if ip.failed:
                            running = false
                            continue
                        end
                        if back_addr != (0 as i64):
                            interp_mem_store(ip, a, back_addr, back_ts, recvr)
                        end
                        vm_backp(mci, R, margp)
