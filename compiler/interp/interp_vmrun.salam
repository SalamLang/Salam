package interp

import str
import os
import mem

include co "../sal_core.salam"
include tok "../token.salam"
include at "../ast.salam"
include i18 "../i18n.salam"

func vm_get(ip &: Interp, a &: at.Ast, fnnode: int, defenv: int, has_this: bool): int:
    if ip.vm_state == 0:
        ev := os.Env("SALAM_VM")
        ip.vm_state = str.Equals(ev, "0") ? 2 : (str.Equals(ev, "trace") ? 3 : 1)
        if str.Equals(os.Env("SALAM_GC_STRESS"), "1"):
            ip.gc_min = 64
            ip.gc_next = 64
        end
    end
    if ip.vm_state == 2 or fnnode <= 0:
        ret 0
    end
    until ip.vm_of.len() <= fnnode:
        ip.vm_of.push(0)
    end
    st := ip.vm_of.get(fnnode)
    if st < 0:
        ret 0
    end
    if st > 0:
        fp := ip.vm_fns.get(st - 1) as VmFn*
        if fp.defenv != defenv or fp.has_this != has_this:
            ret 0
        end
        ret st
    end
    ip.vm_of.set(fnnode, 0 - 1)
    mut c := vm_compile(ip, a, fnnode, defenv, has_this)
    c.names.free()
    c.regs.free()
    c.patch.free()
    c.patch_kind.free()
    c.loop_mark.free()
    c.loop_cont.free()
    c.dmarks.free()
    c.loop_dmark.free()
    if ip.vm_state == 3:
        fnm := at.At(a, fnnode).name
        if not c.ok:
            printerrln "vm: " + fnm + " not compiled"
        else c.escapes.len() > 0:
            mut sb := ""
            repeat c.escapes.len() in ei:
                en := at.At(a, c.escapes.get(ei))
                sb = sb + " " + en.kind + "@" + en.begin_line
            end
            printerrln "vm: " + fnm + " (" + vm_file_of(ip, fnnode) + ") escapes:" + sb
        else:
            printerrln "vm: " + fnm + " compiled, " + (c.f.code.len() / VM_W) + " ops"
        end
    end
    c.escapes.free()
    if not c.ok or ip.failed:
        ret 0
    end
    fpn := mem.Allocate(sizeof(VmFn) as u64) as VmFn*
    fpn[0] = c.f
    ip.vm_fns.push(fpn as i64)
    ip.vm_of.set(fnnode, ip.vm_fns.len())
    ret ip.vm_fns.len()
end

func vm_coerce_node(ip &: Interp, a &: at.Ast, n: int, v: Value): Value:
    if v.kind != VAL_INT or n == 0:
        ret v
    end
    if n < ip.node_ity.len():
        c := ip.node_ity.get(n)
        if c != 0:
            ret coerce_int_ty(v, c - 1)
        end
    else:
        until ip.node_ity.len() <= n:
            ip.node_ity.push(0)
        end
    end
    ity := int_ty_from_typestr(at.At(a, n).type_str)
    ip.node_ity.set(n, ity + 1)
    ret coerce_int_ty(v, ity)
end

func vm_env_make(ip &: Interp, f: VmFn*, R: Value*, sync: int): int:
    e := env_new(ip, f.defenv)
    cnt := f.sync.get(sync)
    repeat cnt in i:
        nm := f.ks.get(f.sync.get(sync + 1 + i * 2))
        r := f.sync.get(sync + 2 + i * 2)
        env_define(ip, e, nm, R[r])
    end
    ret e
end

func vm_env_back(ip &: Interp, f: VmFn*, R: Value*, sync: int, e: int):
    cnt := f.sync.get(sync)
    repeat cnt in i:
        nm := f.ks.get(f.sync.get(sync + 1 + i * 2))
        r := f.sync.get(sync + 2 + i * 2)
        slot := env_find_local(ip, e, nm)
        if slot >= 0:
            R[r] = env_slot_val(ip, e, slot)
        end
    end
end

func vm_run_defers(ip &: Interp, a &: at.Ast, f: VmFn*, R: Value*, ds &: Vector<int>, mark: int):
    until ds.len() > mark:
        sync := ds.pop()
        node := ds.pop()
        mk := env_mark(ip)
        e := vm_env_make(ip, f, R, sync)
        mut fr := Frame {}
        mut rv := Value {}
        ip.tw_depth += 1
        _fl := exec_stmt(ip, a, e, fr, node, rv)
        ip.tw_depth -= 1
        run_defers_from(ip, a, fr, 0)
        fr.defer_stmts.free()
        fr.defer_envs.free()
        vm_env_back(ip, f, R, sync, e)
        env_release(ip, mk)
    end
end

func vm_struct_lit(ip &: Interp, a &: at.Ast, n: int, sdef: int, R: Value*, base: int): Value:
    sdn := at.At(a, sdef)
    mut nf := 0
    repeat at.ChildCount(a, sdef) in ci:
        if at.KindOf(a, at.Child(a, sdef, ci)) == at.AST_FIELD:
            nf += 1
        end
    end
    sv := mk_struct(ip, sdn.name, sdef, nf)
    fenv := struct_home_env(ip, a, sdef)
    mut fi := 0
    mut next := base
    repeat at.ChildCount(a, sdef) in i:
        fnode := at.At(a, at.Child(a, sdef, i))
        if fnode.kind != at.AST_FIELD:
            continue
        end
        mut provided := false
        repeat at.ChildCount(a, n) in j:
            pn := at.At(a, at.Child(a, n, j))
            if str.Len(pn.name) != 0 and str.Equals(pn.name, fnode.name):
                provided = true
                break
            end
        end
        mut fval := Value {}
        if provided:
            fval = R[next]
            next += 1
        else fnode.a != 0:
            ip.tw_depth += 1
            fval = eval(ip, a, fenv, fnode.a)
            ip.tw_depth -= 1
        else:
            fts := fnode.ty != 0 ? at.At(a, fnode.ty).type_str : ""
            if str.Find(fts, "[") < 0:
                fval = zero_for_base(base_typename(fts))
            end
            if fval.kind == VAL_NULL:
                fval = default_for_type(ip, fts)
            end
        end
        if ip.failed:
            ret Value {}
        end
        st_field_set(ip, sv.id, fi, fnode.name, val_copy_deep(ip, fval))
        fi += 1
    end
    ret sv
end

func vm_is_std_vector(ip &: Interp, sp: SStruct*, mm: int): bool:
    if sp.fnames.len() != 3 or not str.Equals(sp.fnames.get(0), "data") or not str.Equals(sp.fnames.get(1), "count") or not str.Equals(sp.fnames.get(2), "capacity"):
        ret false
    end
    fl := vm_file_of(ip, mm)
    ret str.EndsWith(fl, "collections/vector.salam")
end

func vm_ptr_get(pa: i64, pe: int, i: i64, out &: Value): bool:
    if pe == PTR_I64:
        p := pa as i64*
        out = Value { kind = VAL_INT, ity = ITY_I64, i = p[i] }
        ret true
    end
    if pe == PTR_I32:
        p2 := pa as i32*
        out = Value { kind = VAL_INT, ity = ITY_I32, i = p2[i] as i64 }
        ret true
    end
    if pe == PTR_I8:
        p3 := pa as i8*
        out = Value { kind = VAL_INT, ity = ITY_I8, i = p3[i] as i64 }
        ret true
    end
    if pe == PTR_U8:
        p4 := pa as u8*
        out = Value { kind = VAL_INT, ity = ITY_U8, i = p4[i] as i64 }
        ret true
    end
    if pe == PTR_F64:
        p5 := pa as f64*
        out = Value { kind = VAL_FLOAT, f = p5[i] }
        ret true
    end
    if pe == PTR_U64:
        p6 := pa as u64*
        out = Value { kind = VAL_INT, ity = ITY_U64, i = p6[i] as i64 }
        ret true
    end
    ret false
end

func vm_ptr_put(pa: i64, pe: int, i: i64, v: Value): bool:
    if v.kind == VAL_INT:
        if pe == PTR_I64 or pe == PTR_U64:
            p := pa as i64*
            p[i] = v.i
            ret true
        end
        if pe == PTR_I32:
            p2 := pa as i32*
            p2[i] = v.i as i32
            ret true
        end
        if pe == PTR_I8:
            p3 := pa as i8*
            p3[i] = v.i as i8
            ret true
        end
        if pe == PTR_U8:
            p4 := pa as u8*
            p4[i] = v.i as u8
            ret true
        end
        ret false
    end
    if v.kind == VAL_FLOAT and pe == PTR_F64:
        p5 := pa as f64*
        p5[i] = v.f
        ret true
    end
    ret false
end

func vm_index(ip &: Interp, a &: at.Ast, n: int, iav: Value, idxv: Value): Value:
    if iav.kind == VAL_STRUCT:
        stv := ip.sts.get(iav.id)
        m := struct_method(a, stv.def, "operator_index")
        if m != 0:
            denv := find_def_env(ip, m)
            mut ia := Vector {} as Vector<Value>
            ia.push(idxv)
            r := call_func(ip, a, m, denv != 0 ? denv : ip.globals, true, iav, ia)
            ia.free()
            ret r
        end
    end
    if iav.kind == VAL_ARRAY:
        iv := to_int(idxv)
        ln := arr_len(ip, iav.id)
        if iv < (0 as i64) or iv >= (ln as i64):
            rt_error(
                ip, a, n, co.Format2(
                    i18.Tr("index %lld out of range (len %zu)"), co.ArgInt(iv), co.ArgUint(ln as u64)
                )
            )
            ret val_null()
        end
        ret arr_get(ip, iav.id, iv as int)
    end
    if iav.kind == VAL_STR:
        iv2 := to_int(idxv)
        ln2 := str.Len(iav.s)
        if iv2 < (0 as i64) or iv2 >= (ln2 as i64):
            rt_error(ip, a, n, i18.Tr("string index out of range"))
            ret val_null()
        end
        ret val_char(byte_at(iav.s, iv2 as int) as i64)
    end
    if iav.kind == VAL_PTR:
        if iav.pa == (0 as i64):
            rt_error(ip, a, n, i18.Tr("dereference of a null pointer"))
            ret val_null()
        end
        ret mem_ptr_load(ip, a, iav, to_int(idxv))
    end
    if to_int(idxv) == (0 as i64):
        ret iav
    end
    rt_error(ip, a, n, i18.Tr("value is not indexable"))
    ret val_null()
end

func vm_index_loc(ip &: Interp, a &: at.Ast, target: int, av: Value, kv: Value): Loc:
    mut loc := Loc {}
    loc.target = target
    if av.kind == VAL_STRUCT:
        stv2 := ip.sts.get(av.id)
        set_m := struct_method(a, stv2.def, "operator_index_set")
        if set_m != 0:
            loc.kind = ILOC_OPIDX
            loc.obj = av
            loc.key = kv
            loc.set_m = set_m
            loc.get_m = struct_method(a, stv2.def, "operator_index")
            ret loc
        end
        rt_error(ip, a, target, i18.Tr("value is not index-assignable"))
        ret loc
    end
    if av.kind == VAL_ARRAY:
        iv := to_int(kv)
        if iv < (0 as i64) or iv >= (arr_len(ip, av.id) as i64):
            rt_error(ip, a, target, i18.Tr("index out of range in assignment"))
            ret loc
        end
        loc.kind = ILOC_ARR
        loc.arr = av.id
        loc.idx = iv
        ret loc
    end
    if av.kind == VAL_PTR:
        if av.pa == (0 as i64):
            rt_error(ip, a, target, i18.Tr("write through a null pointer"))
            ret loc
        end
        loc.kind = ILOC_PTR
        loc.pa = av.pa
        loc.pe = av.pe
        loc.pts = av.s
        loc.idx = to_int(kv)
        ret loc
    end
    rt_error(ip, a, target, i18.Tr("value is not index-assignable"))
    ret loc
end

func vm_member_loc(ip &: Interp, a &: at.Ast, target: int, obj: Value): Loc:
    mut loc := Loc {}
    loc.target = target
    tn := at.At(a, target)
    if obj.kind == VAL_PTR:
        mut paddr := 0 as i64
        mut pts := ""
        if interp_mem_ptr_field(ip, a, obj, tn.name, paddr, pts):
            loc.kind = ILOC_MEM
            loc.mem = paddr
            loc.mem_ts = pts
            ret loc
        end
    end
    if obj.kind != VAL_STRUCT:
        rt_error(ip, a, target, i18.Tr("cannot assign to member of non-struct"))
        ret loc
    end
    fi2 := st_find_field(ip, obj.id, tn.name)
    if fi2 >= 0:
        loc.kind = ILOC_FIELD
        loc.obj = obj
        loc.field_idx = fi2
        ret loc
    end
    stv := ip.sts.get(obj.id)
    rt_error(
        ip, a, target, co.Format2(
            i18.Tr("struct '%s' has no field '%s'"), co.ArgStr(stv.type_name), co.ArgStr(tn.name)
        )
    )
    ret loc
end

func vm_len(ip &: Interp, a &: at.Ast, n: int, la: Value): Value:
    if la.kind == VAL_ARRAY:
        ret val_int(arr_len(ip, la.id) as i64)
    end
    if la.kind == VAL_STR:
        ret val_int(str.Len(la.s) as i64)
    end
    if la.kind == VAL_MAP:
        lm := ip.maps.get(la.id)
        ret val_int(lm.count as i64)
    end
    rt_error(ip, a, n, i18.Tr("len() expects an array, string, or map"))
    ret val_null()
end

func vm_icmp(op: int, xi: i64, yi: i64, uns: bool): bool:
    mut c := 0
    if uns:
        ux := xi as u64
        uy := yi as u64
        c = ux < uy ? (0 - 1) : (ux > uy ? 1 : 0)
    else:
        c = xi < yi ? (0 - 1) : (xi > yi ? 1 : 0)
    end
    if op == tok.TK_EQ: ret c == 0 end
    if op == tok.TK_NE: ret c != 0 end
    if op == tok.TK_LT: ret c < 0 end
    if op == tok.TK_GT: ret c > 0 end
    if op == tok.TK_LE: ret c <= 0 end
    ret c >= 0
end

func vm_fcmp(op: int, x: f64, y: f64): bool:
    mut c := 0
    c = x < y ? (0 - 1) : (x > y ? 1 : 0)
    if op == tok.TK_EQ: ret x == y end
    if op == tok.TK_NE: ret x != y end
    if op == tok.TK_LT: ret c < 0 end
    if op == tok.TK_GT: ret c > 0 end
    if op == tok.TK_LE: ret c <= 0 end
    ret c >= 0
end

func vm_iop(ip &: Interp, a &: at.Ast, n: int, op: int, rt: int, x: Value, y: Value, out &: Value): bool:
    if x.kind != VAL_INT or y.kind != VAL_INT:
        ret false
    end
    bits := int_ty_bits(rt)
    wide := bits >= 64
    xi := wide ? x.i : int_ty_wrap(rt, x.i)
    shift := op == VOP_SHLI or op == VOP_SHRI
    yi := (wide or shift) ? y.i : int_ty_wrap(rt, y.i)
    ux := xi as u64
    uy := yi as u64
    mut r := 0 as i64
    if op == VOP_ADDI:
        r = (ux + uy) as i64
    else op == VOP_SUBI:
        r = (ux - uy) as i64
    else op == VOP_MULI:
        r = (ux * uy) as i64
    else op == VOP_DIVI or op == VOP_MODI:
        if yi == (0 as i64):
            rt_error(ip, a, n, op == VOP_DIVI ? i18.Tr("division byv zero") : i18.Tr("modulo byv zero"))
            out = val_null()
            ret true
        end
        imin := (0x8000000000000000 as u64) as i64
        negone := (0 as i64) - (1 as i64)
        if int_ty_is_unsigned(rt):
            r = op == VOP_DIVI ? (ux / uy) as i64 : (ux % uy) as i64
        else xi == imin and yi == negone:
            r = op == VOP_DIVI ? imin : (0 as i64)
        else:
            r = op == VOP_DIVI ? xi / yi : xi % yi
        end
    else op == VOP_ANDI:
        r = (ux & uy) as i64
    else op == VOP_ORI:
        r = (ux | uy) as i64
    else op == VOP_XORI:
        r = (ux ^ uy) as i64
    else op == VOP_SHLI:
        r = (ux << (uy & ((bits - 1) as u64))) as i64
    else:
        if int_ty_is_unsigned(rt):
            r = (ux >> (uy & ((bits - 1) as u64))) as i64
        else:
            r = xi >> ((uy & ((bits - 1) as u64)) as i64)
        end
    end
    out = Value { kind = VAL_INT, ity = rt, i = wide ? r : int_ty_wrap(rt, r) }
    ret true
end

func vm_iop_tok(op: int): int:
    if op == VOP_ADDI: ret tok.TK_PLUS end
    if op == VOP_SUBI: ret tok.TK_MINUS end
    if op == VOP_MULI: ret tok.TK_STAR end
    if op == VOP_DIVI: ret tok.TK_SLASH end
    if op == VOP_MODI: ret tok.TK_PERCENT end
    if op == VOP_ANDI: ret tok.TK_AMP end
    if op == VOP_ORI: ret tok.TK_PIPE end
    if op == VOP_XORI: ret tok.TK_CARET end
    if op == VOP_SHLI: ret tok.TK_SHL end
    if op == VOP_SHRI: ret tok.TK_SHR end
    if op == VOP_ADDF: ret tok.TK_PLUS end
    if op == VOP_SUBF: ret tok.TK_MINUS end
    if op == VOP_MULF: ret tok.TK_STAR end
    ret tok.TK_SLASH
end

func vm_call_args(R: Value*, base: int, n: int): Vector<Value>:
    mut args := Vector {} as Vector<Value>
    repeat n in i:
        args.push(R[base + i])
    end
    ret args
end

func vm_tb_push(ip &: Interp, call: int): bool:
    tracked := not g_threads_on
    if tracked:
        ip.tb_call.push(call)
        ip.tb_file.push(ip.cur_file)
    end
    ret tracked
end

func vm_tb_pop(ip &: Interp, tracked: bool):
    if tracked:
        _tc := ip.tb_call.pop()
        _tf := ip.tb_file.pop()
    end
end

func vm_back(ci &: VmCall, R: Value*, args: Vector<Value>):
    repeat ci.back.len() in i:
        r := ci.back.get(i)
        if r >= 0 and i < args.len():
            R[r] = args.get(i)
        end
    end
end

func vm_backp(ci &: VmCall, R: Value*, argp: Value*):
    repeat ci.back.len() in i:
        r := ci.back.get(i)
        if r >= 0:
            R[r] = argp[i]
        end
    end
end

inline func vm_wrap(rt: int, v: i64): i64:
    if rt == ITY_I64 or rt == ITY_U64 or rt == ITY_NONE:
        ret v
    end
    if rt == ITY_I32:
        w32 := v as i32
        ret w32
    end
    if rt == ITY_U32:
        ret ((v as u64) & (0xFFFFFFFF as u64)) as i64
    end
    ret int_ty_wrap(rt, v)
end

inline func vm_fix(R: Value*, x: int, ity: int):
    if ity != ITY_NONE and R[x].kind == VAL_INT and R[x].ity != ity:
        R[x].i = vm_wrap(ity, R[x].i)
        R[x].ity = ity
    end
end

func vm_reg_at(R: Value*, i: int): Value*:
    ret ((R as i64) + (i as i64) * (sizeof(Value) as i64)) as Value*
end

func vm_regs_get(f: VmFn*): Value*:
    if not g_threads_on and f.pool.len() > 0:
        ret f.pool.pop() as Value*
    end
    ret mem.Allocate(((f.nreg + 1) as u64) * sizeof(Value)) as Value*
end

func vm_frame_pop(ip &: Interp):
    _fa := ip.vm_frames.pop()
    _fb := ip.vm_frames.pop()
end

func vm_regs_put(f: VmFn*, R: Value*):
    if not g_threads_on:
        f.pool.push(R as i64)
        ret
    end
    mem.Free(R as void*)
end

func vm_call_vm(
    ip &: Interp, a &: at.Ast, call: int, fn: int, file: str, vi: int, env: int, has_this: bool, thisv: Value, argp: Value*, nargs: int
): Value:
    ip.depth += 1
    if ip.depth > ip.max_depth:
        rt_error(ip, a, fn, i18.Tr("call stack too deep (possible infinite recursion)"))
        ip.depth -= 1
        ret Value {}
    end
    tracked := vm_tb_push(ip, call)
    saved_file := ip.cur_file
    if str.Len(file) > 0:
        ip.cur_file = file
    end
    ip.vm_direct += 1
    r := vm_exec(ip, a, vi, env, has_this, thisv, argp, nargs)
    ip.vm_direct -= 1
    ip.depth -= 1
    ip.cur_file = saved_file
    vm_tb_pop(ip, tracked)
    ret r
end

func vm_file_of(ip &: Interp, fn: int): str:
    if fn > 0 and fn < ip.fn_file.len():
        ret ip.fn_file.get(fn)
    end
    ret ""
end

func vm_exec(
    ip &: Interp, a &: at.Ast, vi: int, defenv: int, has_this: bool, thisv: Value, argp: Value*, nargs: int
): Value:
    FT := ip.vm_fns.data
    f := FT[vi - 1] as VmFn*
    R := vm_regs_get(f)
    defer vm_regs_put(f, R)
    ip.vm_frames.push(R as i64)
    ip.vm_frames.push((f.nreg + 1) as i64)
    defer vm_frame_pop(ip)
    C := f.code.data
    K := f.kv.data
    AX := f.aux.data
    PRF := f.param_ref.data
    PIT := f.param_ity.data
    pbase := has_this ? 1 : 0
    if has_this:
        R[0] = thisv
    end
    repeat f.nparam in pi:
        reg := pbase + pi
        if pi < nargs:
            if f.has_ref and PRF[pi]:
                R[reg] = argp[pi]
            else (argp[pi].kind == VAL_STRUCT or argp[pi].kind == VAL_ARRAY) and not f.param_ro.get(pi):
                R[reg] = val_copy_deep(ip, argp[pi])
            else:
                R[reg] = argp[pi]
            end
        else f.param_def.get(pi) != 0:
            mk0 := env_mark(ip)
            e0 := env_new(ip, defenv)
            if has_this:
                env_define(ip, e0, "this", thisv)
            end
            repeat pi in pj:
                env_define(ip, e0, at.At(a, at.Child(a, f.fnnode, pj)).name, R[pbase + pj])
            end
            ip.tw_depth += 1
            R[reg] = eval(ip, a, e0, f.param_def.get(pi))
            ip.tw_depth -= 1
            env_release(ip, mk0)
            if ip.failed:
                ret val_null()
            end
        end
        pty := PIT[pi]
        if pty != ITY_NONE and R[reg].kind == VAL_INT and R[reg].ity != pty:
            R[reg].i = vm_wrap(pty, R[reg].i)
            R[reg].ity = pty
        end
    end
    saved_med := ip.match_expr_depth
    ip.match_expr_depth = 0
    mut retv := Value {}
    mut dstack := Vector {} as Vector<int>
    defer dstack.free()
    mut pc := 0
    mut running := true
    until running:
        op := C[pc]
        x := C[pc + 1]
        y := C[pc + 2]
        z := C[pc + 3]
        switch op:
            VOP_LOADK:
                R[x] = K[y]
                pc += VM_W
                continue
            end
            VOP_MOV:
                R[x] = R[y]
                pc += VM_W
                continue
            end
            VOP_COPY:
                cv := R[y]
                if cv.kind == VAL_STRUCT or cv.kind == VAL_ARRAY:
                    R[x] = val_copy_deep(ip, cv)
                else:
                    R[x] = cv
                end
                pc += VM_W
                continue
            end
            VOP_COERCE:
                if y != ITY_NONE and R[x].kind == VAL_INT:
                    R[x] = coerce_int_ty(R[x], y)
                end
                pc += VM_W
                continue
            end
            VOP_ADDI, VOP_SUBI, VOP_MULI, VOP_DIVI, VOP_MODI, VOP_ANDI, VOP_ORI, VOP_XORI, VOP_SHLI, VOP_SHRI:
                rt := C[pc + 4]
                if op <= VOP_MULI and R[y].kind == VAL_INT and R[z].kind == VAL_INT:
                    ua := R[y].i as u64
                    ub := R[z].i as u64
                    mut ur := ua * ub
                    if op == VOP_ADDI:
                        ur = ua + ub
                    else op == VOP_SUBI:
                        ur = ua - ub
                    end
                    R[x].kind = VAL_INT
                    R[x].ity = rt
                    R[x].i = vm_wrap(rt, ur as i64)
                    pc += VM_W
                    continue
                end
                if (op == VOP_DIVI or op == VOP_MODI) and R[y].kind == VAL_INT and R[z].kind == VAL_INT and (rt == ITY_I64 or rt == ITY_I32) and R[z].i != (0 as i64):
                    da := vm_wrap(rt, R[y].i)
                    db := vm_wrap(rt, R[z].i)
                    mut dr := 0 as i64
                    if db == ((0 as i64) - (1 as i64)):
                        dr = op == VOP_DIVI ? vm_wrap(rt, ((0 as u64) - (da as u64)) as i64) : (0 as i64)
                    else op == VOP_DIVI:
                        dr = da / db
                    else:
                        dr = da % db
                    end
                    R[x].kind = VAL_INT
                    R[x].ity = rt
                    R[x].i = dr
                    pc += VM_W
                    continue
                end
                xv := R[y]
                yv := R[z]
                mut iv := val_null()
                if not vm_iop(ip, a, C[pc + 5], op, rt, xv, yv, iv):
                    iv = binary_values(ip, a, C[pc + 5], vm_iop_tok(op), xv, yv)
                end
                if ip.failed:
                    running = false
                    continue
                end
                R[x] = iv
                pc += VM_W
                continue
            end
            VOP_ADDF, VOP_SUBF, VOP_MULF, VOP_DIVF:
                fx := R[y]
                fy := R[z]
                xf := fx.kind == VAL_FLOAT ? fx.f : to_float(fx)
                yf := fy.kind == VAL_FLOAT ? fy.f : to_float(fy)
                mut fr := 0.0
                if op == VOP_ADDF:
                    fr = xf + yf
                else op == VOP_SUBF:
                    fr = xf - yf
                else op == VOP_MULF:
                    fr = xf * yf
                else:
                    fr = xf / yf
                end
                if C[pc + 4] == 1:
                    fr = f32_narrow(fr)
                end
                if (fx.kind == VAL_FLOAT or fx.kind == VAL_INT) and (fy.kind == VAL_FLOAT or fy.kind == VAL_INT):
                    R[x] = val_float(fr)
                else:
                    R[x] = binary_values(ip, a, C[pc + 5], vm_iop_tok(op), fx, fy)
                end
                pc += VM_W
                continue
            end
            VOP_CMPI:
                if R[y].kind == VAL_INT and R[z].kind == VAL_INT:
                    crt := C[pc + 5]
                    icres := vm_icmp(C[pc + 4], vm_wrap(crt, R[y].i), vm_wrap(crt, R[z].i), crt >= ITY_U8)
                    R[x].kind = VAL_BOOL
                    R[x].b = icres
                else:
                    R[x] = binary_values(ip, a, 0, C[pc + 4], R[y], R[z])
                end
                pc += VM_W
                continue
            end
            VOP_CMPF:
                gx := R[y]
                gy := R[z]
                if (gx.kind == VAL_FLOAT or gx.kind == VAL_INT) and (gy.kind == VAL_FLOAT or gy.kind == VAL_INT):
                    R[x] = val_bool(vm_fcmp(C[pc + 4], to_float(gx), to_float(gy)))
                else:
                    R[x] = binary_values(ip, a, 0, C[pc + 4], gx, gy)
                end
                pc += VM_W
                continue
            end
            VOP_BIN:
                bv := binary_values(ip, a, C[pc + 5], C[pc + 4], R[y], R[z])
                if ip.failed:
                    running = false
                    continue
                end
                R[x] = vm_coerce_node(ip, a, C[pc + 5], bv)
                pc += VM_W
                continue
            end
            VOP_CBIN:
                mut cfound := false
                bx := R[y]
                byv := R[z]
                cr := try_struct_op(ip, a, C[pc + 4], bx, byv, true, cfound)
                cv2 := cfound ? cr : arith(ip, a, C[pc + 5], C[pc + 4], bx, byv)
                if ip.failed:
                    running = false
                    continue
                end
                R[x] = cv2
                pc += VM_W
                continue
            end
            VOP_UN:
                uv := unary_value(ip, a, z, R[y])
                if ip.failed:
                    running = false
                    continue
                end
                R[x] = uv
                vm_fix(R, x, C[pc + 5])
                pc += VM_W
                continue
            end
            VOP_NOT:
                R[x] = val_bool(not to_bool(R[y]))
                pc += VM_W
                continue
            end
            VOP_BOOL:
                R[x] = val_bool(to_bool(R[y]))
                pc += VM_W
                continue
            end
            VOP_NEGI:
                nv := R[y]
                if nv.kind == VAL_INT:
                    R[x] = val_int_ty(((0 as u64) - (nv.i as u64)) as i64, nv.ity)
                else:
                    R[x] = unary_value(ip, a, tok.TK_MINUS, nv)
                end
                pc += VM_W
                continue
            end
            VOP_NEGF:
                nf := R[y]
                if nf.kind == VAL_FLOAT:
                    R[x] = val_float(0.0 - nf.f)
                else:
                    R[x] = unary_value(ip, a, tok.TK_MINUS, nf)
                end
                pc += VM_W
                continue
            end
            VOP_CAST:
                ccv := cast_value(ip, a, z, R[y])
                if ip.failed:
                    running = false
                    continue
                end
                R[x] = ccv
                vm_fix(R, x, C[pc + 4])
                pc += VM_W
                continue
            end
            VOP_CASTI:
                if R[y].kind == VAL_INT:
                    R[x].kind = VAL_INT
                    R[x].i = vm_wrap(z, R[y].i)
                    R[x].ity = z
                    pc += VM_W
                    continue
                end
                R[x] = val_int_ty(to_int(R[y]), z)
                pc += VM_W
                continue
            end
            VOP_CASTF:
                ff := to_float(R[y])
                R[x] = val_float(z == 1 ? f32_narrow(ff) : ff)
                pc += VM_W
                continue
            end
            VOP_JMP:
