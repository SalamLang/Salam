    "document", "window", "console", "Math", "JSON", "String", "Number", "Boolean", "Array", "Object", "Error", "Date", "Promise", "Symbol", "Map", "Set", "globalThis", "performance", "navigator", "location", "fetch", "alert", "confirm", "prompt", "parseInt", "parseFloat", "isNaN", "isFinite", "getComputedStyle", "requestAnimationFrame", "setTimeout", "setInterval", "clearTimeout", "clearInterval"
