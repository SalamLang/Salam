// ===== jsgen_host.c: k_js_host[] (name/template pairs, split) =====
k_js_host_names := [
    "salam_js_query", "salam_js_query_all", "salam_js_by_id", "salam_js_id_exists", "salam_js_create", "salam_js_body", "salam_js_document", "salam_js_window", "salam_js_global", "salam_js_append", "salam_js_remove", "salam_js_set_text", "salam_js_get_text", "salam_js_set_html", "salam_js_set_value", "salam_js_get_value", "salam_js_set_style", "salam_js_get_style", "salam_js_set_attr", "salam_js_get_attr", "salam_js_add_class", "salam_js_remove_class", "salam_js_toggle_class", "salam_js_on", "salam_js_on_e", "salam_js_on_opts", "salam_js_off", "salam_js_on_window", "salam_js_on_window_e", "salam_js_on_ready", "salam_js_on_resize", "salam_js_raf", "salam_js_set_timeout", "salam_js_set_interval", "salam_js_clear_timeout", "salam_js_clear_interval", "salam_js_win_width", "salam_js_win_height", "salam_js_doc_width", "salam_js_doc_height", "salam_js_scroll_x", "salam_js_scroll_y", "salam_js_now", "salam_js_get_prop", "salam_js_get_num", "salam_js_get_str", "salam_js_get_bool", "salam_js_set_prop", "salam_js_call", "salam_js_get_context", "salam_js_item_at", "salam_js_count_of", "salam_js_event_target", "salam_js_event_x", "salam_js_event_y", "salam_js_event_key", "salam_js_prevent_default", "salam_js_stop_propagation", "salam_js_alert", "salam_js_confirm", "salam_js_prompt", "salam_js_set_title", "salam_js_every_frame", "salam_js_random", "salam_js_tone", "salam_js_load_image", "salam_js_img_ready", "salam_js_lsget_i", "salam_js_lsset_i", "salam_js_lsget_s", "salam_js_lsset_s", "salam_js_touch_x", "salam_js_touch_y", "salam_js_canvas_ctx", "salam_js_ctx_of", "salam_js_canvas_w", "salam_js_canvas_h", "salam_js_fill_style", "salam_js_stroke_style", "salam_js_line_width", "salam_js_font", "salam_js_text_align", "salam_js_global_alpha", "salam_js_fill_rect", "salam_js_stroke_rect", "salam_js_clear_rect", "salam_js_round_rect", "salam_js_begin_path", "salam_js_close_path", "salam_js_move_to", "salam_js_line_to", "salam_js_arc", "salam_js_path_fill", "salam_js_path_stroke", "s