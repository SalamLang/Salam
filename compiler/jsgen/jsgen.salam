pub struct Output:
    pub module: str = ""
    pub globals_src: str = ""
    pub fn_names: Vector<str> = Vector {}
    pub fn_texts: Vector<str> = Vector {}
    pub entry_mangled: str = ""
end

pub struct Jg:
    pub log: lg.Logger = lg.New(lg.LOG_OFF, false)
    pub module: str = ""
    pub pkg: str = "main"
    pub entry: str = "main"
    pub compact: bool = false
    pub out: str.StringBuilder = str.NewBuilder()
    pub indent: int = 0
    pub locals: Vector<str> = Vector {}
    pub cur_struct: int = 0
    pub cur_fn_home: int = 0
    pub tmpn: int = 0
    pub fn_defers: Vector<int> = Vector {}
    pub loop_dmark: Vector<int> = Vector {}
    pub match_result_tmp: str = ""
    pub match_end_label: str = ""
    pub entry_mangled: str = ""
    pub last_fn_name: str = ""
    pub local_muts: Vector<int> = Vector {}
    pub local_emit: Vector<str> = Vector {}
    pub taken: Vector<str> = Vector {}
    pub fn_used_names: Vector<str> = Vector {}
    pub minify_keys: Vector<str> = Vector {}
    pub minify_vals: Vector<str> = Vector {}
    pub enable_minify: bool = false
    pub minify_last: str = ""
end
