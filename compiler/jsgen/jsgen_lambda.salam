package jsgen

import str
import at "../ast.salam"
import sm "../semantic/semantic.salam"

func jsg_lambda_ret_void(n: at.Node): bool:
    ret str.EndsWith(n.type_str, " void") && str.Len(n.type_str) >= 5
end

// 0 = C NULL
func jsg_lambda_expr_body(a &: at.Ast, id: int): int:
    n := at.Get(a, id)
    if n.a != 0 && at.KindOf(a, n.a) != at.AST_BLOCK:
        ret n.a
    end
    if n.a != 0 && at.KindOf(a, n.a) == at.AST_BLOCK:
        bv := at.Get(a, n.a)
        if bv.list.len() == 1:
            st := bv.list.get(0)
            stv := at.Get(a, st)
            if stv.kind == at.AST_RETURN && stv.a != 0:
                ret stv.a
            end
            if stv.kind == at.AST_EXPR_STMT && jsg_lambda_ret_void(n):
                ret stv.a
            end
        end
    end
    ret 0
end

func jsg_caps_immutable(g &: Jg, a &: at.Ast, id: int): bool:
    n := at.Get(a, id)
    cnt := n.captures.len()
    mut i := 0
    until i < cnt:
        c := at.Get(a, n.captures.get(i))
        if str.Len(c.name) == 0 || !local_known(g, c.name):
            ret false
        end
        if jsg_local_is_mut(g, c.name):
            ret false
        end
        i += 1
    end
    ret true
end

func jsg_lambda(g &: Jg, s &: sm.Sema, a &: at.Ast, id: int): str:
    n := at.Get(a, id)
    plain := n.captures.len() == 0 || jsg_caps_immutable(g, a, id)
    mut caps := str.NewBuilder()
    mut capvals := str.NewBuilder()
    if !plain:
        cnt := n.captures.len()
        mut i := 0
        until i < cnt:
            if i > 0:
                str.BufAppend(capvals, ", ")
            end
            str.BufAppend(capvals, jsg_expr_p(g, s, a, n.captures.get(i), 0))
            i += 1
        end
    end
    mut params := str.NewBuilder()
    mark := g.locals.len()
    saved_defers := g.fn_defers
    g.fn_defers = Vector {} as Vector<int>
    saved_dmark := g.loop_dmark
    g.loop_dmark = Vector {} as Vector<int>
    if !plain:
        cnt2 := n.captures.len()
        mut i2 := 0
        until i2 < cnt2:
            c := at.Get(a, n.captures.get(i2))
            nm := jsg_local(g, c.name, false)
            if i2 > 0:
                str.BufAppend(caps, ", ")
            end
            str.BufAppend(caps, nm)
            i2 += 1
        end
    end
    np := n.list.len()
    mut i3 := 0
    until i3 < np:
        p := at.Get(a, n.list.get(i3))
        nm2 := jsg_local(g, p.name, false)
        if i3 > 0:
            str.BufAppend(params, ", ")
        end
        str.BufAppend(params, nm2)
        i3 += 1
    end
    mut core := ""
    expr := jsg_lambda_expr_body(a, id)
    if expr != 0:
        mut body := jsg_expr_p(g, s, a, expr, JSP_LAMBDA)
        if at.KindOf(a, expr) == at.AST_STRUCT_LIT:
            body = "(" + body + ")"
        end
        core = "(" + str.BufStr(params) + ") => " + body
    else:
        saved := g.out
        g.out = str.NewBuilder()
        saved_mres := g.match_result_tmp
        saved_mlbl := g.match_end_label
        g.indent += 1
        g.match_result_tmp = ""
        g.match_end_label = ""
        if n.a != 0 && at.KindOf(a, n.a) == at.AST_BLOCK:
            jsg_block(g, s, a, n.a)
            jsg_emit_defers(g, s, a)
        else n.a != 0:
            cg_line(g, "return " + jsg_expr_p(g, s, a, n.a, 0) + ";")
        end
        g.match_result_tmp = saved_mres
        g.match_end_label = saved_mlbl
        g.indent -= 1
        body2 := str.BufStr(g.out)
        str.BufFree(g.out)
        g.out = saved
        if g.compact:
            core = "(" + str.BufStr(params) + ") => {" + body2 + "}"
        else:
            mut pad := ""
            repeat g.indent:
                pad = pad + "    "
            end
            core = "(" + str.BufStr(params) + ") => {\n" + body2 + pad + "}"
        end
    end
    jsg_scope_reset(g, mark)
    g.fn_defers.free()
    g.fn_defers = saved_defers
    g.loop_dmark.free()
    g.loop_dmark = saved_dmark
    if !plain:
        core = "((" + str.BufStr(caps) + ") => " + core + ")(" + str.BufStr(capvals) + ")"
    end
    str.BufFree(caps)
    str.BufFree(capvals)
    str.BufFree(params)
    ret core
end

func jsg_struct_lit(g &: Jg, s &: sm.Sema, a &: at.Ast, id: int): str:
    n := at.Get(a, id)
    // `Vector {}` is an empty JS array here, not the three-field struct its
    // Salam source declares (see jsg_call_vec).
    if cg_is_vector_ts(s, n.type_str) || str.Equals(n.name, "Vector"):
        ret "[]"
    end
    if cg_is_hashmap_ts(s, n.type_str) || str.Equals(n.name, "HashMap"):
        ret "new Map()"
    end
    ssym := struct_by_name(s, n.name)
    mut b := str.NewBuilder()
    str.BufAppend(b, "{ ")
    mut first := true
    if ssym != 0:
        mems := sm.SymAt(s, ssym).members
        msc := sm.ScopeAt(s, mems)
        cnt := msc.symbols.len()
        mut i := 0
        until i < cnt:
            f := sm.SymAt(s, msc.symbols.get(i))
            if f.kind != sm.SYM_FIELD:
                i += 1
                continue
            end
            mut provided := 0
            nfi := n.list.len()
            mut j := 0
            until j < nfi:
                fi := at.Get(a, n.list.get(j))
                if str.Len(fi.name) > 0 && str.Equals(fi.name, f.name):
                    provided = n.list.get(j)
                    break
                end
                j += 1
            end
            mut val := ""
            if provided != 0:
                val = jsg_expr_p(g, s, a, at.Get(a, provided).a, 0)
            else:
                mut dflt := 0
                if f.decl != 0:
                    dflt = at.Get(a, f.decl).a
                end
                if dflt != 0:
                    val = jsg_expr_p(g, s, a, dflt, 0)
                else:
                    mut fts := ""
                    if f.ty != sm.TYPE_NONE:
                        fts = sm.ToString(s, f.ty)
                    end
                    val = jsg_zero(s, fts)
                end
            end
            if !first:
                str.BufAppend(b, ", ")
            end
            str.BufAppend(b, cg_cident(f.name) + ": " + val)
            first = false
            i += 1
        end
    else:
        nfi2 := n.list.len()
        mut j2 := 0
        until j2 < nfi2:
            fi2 := at.Get(a, n.list.get(j2))
            if !first:
                str.BufAppend(b, ", ")
            end
            str.BufAppend(
                b, cg_cident(fi2.name) + ": " + jsg_expr_p(g, s, a, fi2.a, 0)
            )
            first = false
            j2 += 1
        end
    end
    str.BufAppend(b, " }")
    r := str.BufStr(b)
    str.BufFree(b)
    ret r
end
