package jsgen

import str
import tok "../token.salam"

// ===== codegen_expr.c: cg_op() =====
func cg_op(k: int): str:
    if k == tok.TK_PLUS:
        ret "+"
    else k == tok.TK_MINUS:
        ret "-"
    else k == tok.TK_STAR:
        ret "*"
    else k == tok.TK_SLASH:
        ret "/"
    else k == tok.TK_PERCENT:
        ret "%"
    else k == tok.TK_EQ:
        ret "=="
    else k == tok.TK_NE:
        ret "!="
    else k == tok.TK_LT:
        ret "<"
    else k == tok.TK_GT:
        ret ">"
    else k == tok.TK_LE:
        ret "<="
    else k == tok.TK_GE:
        ret ">="
    else k == tok.TK_AND:
        ret "&&"
    else k == tok.TK_OR:
        ret "||"
    else k == tok.TK_NOT:
        ret "!"
    else k == tok.TK_AMP:
        ret "&"
    else k == tok.TK_PIPE:
        ret "|"
    else k == tok.TK_CARET:
        ret "^"
    else k == tok.TK_TILDE:
        ret "~"
    else k == tok.TK_SHL:
        ret "<<"
    else k == tok.TK_SHR:
        ret ">>"
    else k == tok.TK_ASSIGN:
        ret "="
    else k == tok.TK_PLUS_EQ:
        ret "+="
    else k == tok.TK_MINUS_EQ:
        ret "-="
    else k == tok.TK_STAR_EQ:
        ret "*="
    else k == tok.TK_SLASH_EQ:
        ret "/="
    else k == tok.TK_PERCENT_EQ:
        ret "%="
    else k == tok.TK_AMP_EQ:
        ret "&="
    else k == tok.TK_PIPE_EQ:
        ret "|="
    else k == tok.TK_CARET_EQ:
        ret "^="
    else k == tok.TK_SHL_EQ:
        ret "<<="
    else k == tok.TK_SHR_EQ:
        ret ">>="
    end
    ret "?"
end

// ===== jsgen_host.c: js_host_lookup ("" = C NULL) =====
// .len(), never a literal: js_host_lookup bounds k_js_host[] with sizeof,
// and the hardcoded 101 here had fallen 13 entries behind the table, so
// every host builtin past salam_js_ctx_restore silently failed to resolve.
func host_lookup(name: str): str:
    repeat k_js_host_names.len() with i:
        if str.Equals(k_js_host_names[i], name):
            ret k_js_host_tmpls[i]
        end
    end
    ret ""
end
