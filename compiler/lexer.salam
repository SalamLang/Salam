// Flat merge of the salam/lexer port (see salam/PORTING.md "Layout — FLAT"):
// lexer.c + lexer.h + lexer_internal.h + lexer_char.c + lexer_cursor.c +
// lexer_detect.c + lexer_escape.c + lexer_ident.c + lexer_layout.c +
// lexer_number.c + lexer_operator.c + lexer_string.c + lexer_trivia.c —
// one package `lexer`, one file. Import alias for consumers: `lx`.
//
// C differences (per salam/PORTING.md):
// - lx_t -> struct Lx (private). The arena is gone (str owns its bytes), the
//   logger_t* is a value logger.Logger field, langpack_t* is the int handle
//   from langpack.salam, and the token_stream_t* out-pointer is a
//   Vector<tok.Token> owned by Lx, moved into the caller's TokenStream when
//   lexing finishes.
// - lexer_run/lexer_run_ex -> Run/RunEx: fill a caller-provided
//   tok.TokenStream (made with tok.StreamNew) and return `false` when any
//   lexical error was reported, exactly like the C bool.
// - langpack_marker_code -> MarkerCode returns "" where the C returns NULL.
// - langpack_detect -> Detect returns a langpack handle int (lp.LP_*).
// - All character scanning is done on byte codes 0..255 (int); Salam str is
//   NUL-terminated like the C buffer, so `byte_at(s, len) == 0` reproduces
//   the C sentinel reads.
// - lx_adv is split into adv() (void) and advc() (returns the byte) so no
//   call site discards a return value.
// - lx_expect/lx_consume_hex drop their (never used) return values.
// - lx_utf8_encode appends to a StringBuilder (utf8_append) instead of
//   filling a char[4]; `(char)` truncation is preserved by BufAppendChar's
//   `as i8` store.
// - Number decode uses str's `.to_float()`, which compiles to
//   strtod(s, NULL) — the exact C call.
// - Errors go through logger.LogAt (plain rendering, like the current
//   logger port) with the message translated by i18n.Tr, mirroring
//   LOG_E_AT(..., "%s", i18n_tr(msg)).
package lexer

import str
import co "sal_core.salam"
import src "source.salam"
import tok "token.salam"
import lg "logger.salam"
import lp "langpack.salam"
import i18n "i18n.salam"

// ===== lexer_internal.h =====
// lx_layout_sub_t
const LX_SUB_NAME := 0
const LX_SUB_VALUE := 1

// enum { LX_ESC_HEX_X = 2, LX_ESC_HEX_U = 4, LX_ESC_HEX_BIG_U = 8 }
const LX_ESC_HEX_X := 2
const LX_ESC_HEX_U := 4
const LX_ESC_HEX_BIG_U := 8

// ===== lexer_detect.c =====
// Marker byte sequences (static const char[] in C, byte-for-byte).
k_lx_fa_tag := "\xd8\xb2\xd8\xa8\xd8\xa7\xd9\x86"                          // "زبان" (8 bytes)
k_lx_ar_tag := "\xd9\x84\xd8\xba\xd8\xa9"                                  // "لغة" (6 bytes)
k_lx_fa_val := "\xd9\x81\xd8\xa7\xd8\xb1\xd8\xb3\xdb\x8c"                  // "فارسی" (10 bytes)
k_lx_en_val := "\xd8\xa7\xd9\x86\xda\xaf\xd9\x84\xdb\x8c\xd8\xb3\xdb\x8c"  // "انگلیسی" (14 bytes)
k_lx_ar_val := "\xd8\xa7\xd9\x84\xd8\xb9\xd8\xb1\xd8\xa8\xd9\x8a\xd8\xa9"  // "العربية" (14 bytes)

// ===== lexer_internal.h =====
// lx_t
struct Lx:
    pub s: str = ""                       // source text (L->s)
    pub n: int = 0                        // byte length (L->n)
    pub pos: int = 0
    pub line: int = 1
    pub col: int = 1
    pub file: str = ""
    pub group_depth: int = 0
    pub last: int = 0                     // token_kind_t last (TK_EOF)
    pub has_last: bool = false
    pub had_error: bool = false
    pub keep_comments: bool = false
    pub layout_mode: bool = false
    pub layout_depth: int = 0
    pub layout_sub: int = 0               // LX_SUB_NAME
    pub comp_header: bool = false
    pub lgr: lg.Logger = lg.New(2, false) // replaced in RunEx
    pub pack: int = 0                     // langpack handle (lp.LP_*)
    pub toks: Vector<tok.Token> = Vector {}
end

// ---------------------------------------------------------------------------
// Byte access (Salam str is NUL-terminated, like the C buffer).
// ---------------------------------------------------------------------------
func byte_at(s: str, i: int): int:
    bp := (s as void*) as i8*
    mut v := bp[i] as int
    if v < 0:
        v += 256
    end
    ret v
end

// ===== lexer_char.c =====
func is_digit(c: int): bool:
    ret c >= 48 && c <= 57
end

func is_alpha(c: int): bool:
    ret (c >= 97 && c <= 122) || (c >= 65 && c <= 90)
end

func is_ident_start(c: int): bool:
    ret is_alpha(c) || c == 95 || c >= 128
end

func is_ident_cont(c: int): bool:
    ret is_ident_start(c) || is_digit(c)
end

func hexval(c: int): int:
    if c >= 48 && c <= 57:
        ret c - 48
    end
    if c >= 97 && c <= 102:
        ret c - 97 + 10
    end
    if c >= 65 && c <= 70:
        ret c - 65 + 10
    end
    ret 0 - 1
end

// lx_is_base_digit — `base` is the byte after the leading 0 (x/b/o, any case)
func is_base_digit(c: int, base: int): bool:
    if base == 120 || base == 88:   // 'x' 'X'
        ret hexval(c) >= 0
    end
    if base == 98 || base == 66:    // 'b' 'B'
        ret c == 48 || c == 49
    end
    if base == 111 || base == 79:   // 'o' 'O'
        ret c >= 48 && c <= 55
    end
    ret false
end

// lx_decimal_digit — ASCII digit (1 byte) or Extended Arabic-Indic /
// Arabic-Indic digit (2 bytes); returns the byte length, 0 if none.
func decimal_digit_at(s: str, at: int, n: int, val &: int): int:
    if n == 0:
        ret 0
    end
    b0 := byte_at(s, at)
    if b0 >= 48 && b0 <= 57:
        val = b0 - 48
        ret 1
    end
    if n < 2:
        ret 0
    end
    b1 := byte_at(s, at + 1)
    if b0 == 217 && b1 >= 160 && b1 <= 169:   // 0xD9 0xA0..0xA9
        val = b1 - 160
        ret 2
    end
    if b0 == 219 && b1 >= 176 && b1 <= 185:   // 0xDB 0xB0..0xB9
        val = b1 - 176
        ret 2
    end
    ret 0
end

// lx_utf8_encode — appends the encoded bytes instead of filling char[4]
func utf8_append(out &: str.StringBuilder, cp: u32):
    if cp < (128 as u32):
        str.BufAppendChar(out, cp as int)
        ret
    end
    if cp < (2048 as u32):
        str.BufAppendChar(out, ((192 as u32) | (cp >> 6)) as int)
        str.BufAppendChar(out, ((128 as u32) | (cp & (63 as u32))) as int)
        ret
    end
    if cp < (65536 as u32):
        str.BufAppendChar(out, ((224 as u32) | (cp >> 12)) as int)
        str.BufAppendChar(out, ((128 as u32) | ((cp >> 6) & (63 as u32))) as int)
        str.BufAppendChar(out, ((128 as u32) | (cp & (63 as u32))) as int)
        ret
    end
    str.BufAppendChar(out, ((240 as u32) | (cp >> 18)) as int)
    str.BufAppendChar(out, ((128 as u32) | ((cp >> 12) & (63 as u32))) as int)
    str.BufAppendChar(out, ((128 as u32) | ((cp >> 6) & (63 as u32))) as int)
    str.BufAppendChar(out, ((128 as u32) | (cp & (63 as u32))) as int)
end

// lx_utf8_seq_len
func utf8_seq_len(s: str, n: int): int:
    if n == 0:
        ret 0
    end
    b0 := byte_at(s, 0)
    if b0 < 128:
        ret 1
    end
    if (b0 & 224) == 192 && n >= 2:
        ret 2
    end
    if (b0 & 240) == 224 && n >= 3:
        ret 3
    end
    if (b0 & 248) == 240 && n >= 4:
        ret 4
    end
    ret 0
end

// lx_parse_uint — parses digits of `base` starting at `from`, saturating at
// UINT64_MAX with the overflow flag, stopping at the first non-digit.
func parse_uint(d: str, from: int, base: int, overflow &: bool): u64:
    mut v := 0 as u64
    b := base as u64
    overflow = false
    umax := co.SizeMax()
    n := d.len()
    mut i := from
    until i < n:
        digit := hexval(byte_at(d, i))
        if digit < 0 || digit >= base:
            break
        end
        if v > (umax - (digit as u64)) / b:
            overflow = true
            v = umax
        else:
            v = v * b + (digit as u64)
        end
        i += 1
    end
    ret v
end

// ===== lexer_cursor.c =====
// LX_POS(L)
func lx_pos(L &: Lx): co.SrcPos:
    ret co.MakePos(L.line as u32, L.col as u32, L.pos as u32)
end

func peek(L &: Lx): int:
    if L.pos < L.n:
        ret byte_at(L.s, L.pos)
    end
    ret 0
end

func peek2(L &: Lx, k: int): int:
    if L.pos + k < L.n:
        ret byte_at(L.s, L.pos + k)
    end
    ret 0
end

func at_end(L &: Lx): bool:
    ret L.pos >= L.n
end

// lx_adv (void variant; see advc for the value-returning C shape)
func adv(L &: Lx):
    c := byte_at(L.s, L.pos)
    L.pos += 1
    if c == 10:
        L.line += 1
        L.col = 1
    else:
        L.col += 1
    end
end

// lx_adv when the consumed byte is needed
func advc(L &: Lx): int:
    c := byte_at(L.s, L.pos)
    adv(L)
    ret c
end

// lx_slice (arena_strndup -> substr copy)
func lex_slice(L &: Lx, start: int): str:
    ret L.s.substr(start, L.pos - start)
end

// lx_match ("match" is a Salam keyword)
func match_ch(L &: Lx, c: int): bool:
    if peek(L) == c:
        adv(L)
        ret true
    end
    ret false
end

func skip_ident(L &: Lx):
    until is_ident_cont(peek(L)):
        adv(L)
    end
end

func skip_to_eol(L &: Lx):
    until !at_end(L) && peek(L) != 10:
        adv(L)
    end
end

func at_digit(L &: Lx, k: int): int:
    p := L.pos + k
    if p >= L.n:
        ret 0
    end
    mut val := 0
    ret decimal_digit_at(L.s, p, L.n - p, val)
end

func take_digit(L &: Lx): int:
    if L.pos >= L.n:
        ret 0 - 1
    end
    mut val := 0
    len := decimal_digit_at(L.s, L.pos, L.n - L.pos, val)
    if len == 0:
        ret 0 - 1
    end
    repeat len:
        adv(L)
    end
    ret val
end

// lx_consume_hex (return value was never used; dropped)
func consume_hex(L &: Lx, maxn: int):
    mut n := 0
    until n < maxn && !at_end(L) && hexval(peek(L)) >= 0:
        adv(L)
        n += 1
    end
end

// lx_trim_ws_end
func trim_ws_end(s: str, start: int, stop: int): int:
    mut e := stop
    until e > start:
        c := byte_at(s, e - 1)
        if c == 32 || c == 9 || c == 13:
            e -= 1
        else:
            break
        end
    end
    ret e
end

// lx_emit_val
func emit_val(L &: Lx, kind: int, b: co.SrcPos, lexeme: str, v: tok.TokenValue):
    mut t := tok.New(kind, lexeme)
    t.layout_mode = L.layout_mode
    t.value = v
    t.begin_line = b.line
    t.begin_col = b.col
    t.begin_index = b.index
    t.end_line = L.line as u32
    t.end_col = L.col as u32
    t.end_index = L.pos as u32
    t.length = (L.pos as u32) - b.index
    L.toks.push(t)
    L.last = kind
    L.has_last = true
    if lg.Enabled(L.lgr, lg.LOG_TRACE):
        lg.LogAt(L.lgr, lg.PH_LEXER, lg.LOG_TRACE, L.file, b.line as int,
                 b.col as int, "token recognized: " + tok.KindName(kind) +
                 " '" + lexeme + "'")
    end
end

// lx_emit
func emit(L &: Lx, kind: int, b: co.SrcPos, lexeme: str):
    emit_val(L, kind, b, lexeme, tok.ValueNone())
end

// lx_error — LOG_E_AT(..., "%s", i18n_tr(msg)) via the plain logger path
func error_at(L &: Lx, at: co.SrcPos, msg: str):
    L.had_error = true
    lg.LogAt(L.lgr, lg.PH_LEXER, lg.LOG_ERROR, L.file, at.line as int,
             at.col as int, i18n.Tr(msg))
end

// lx_expect (bool return was never used; dropped)
func expect(L &: Lx, close: int, b: co.SrcPos, errmsg: str):
    if peek(L) == close:
        adv(L)
        ret
    end
    error_at(L, b, errmsg)
end

// ===== lexer_escape.c =====
func simple_escape(e: int): int:
    if e == 110:   // 'n'
        ret 10
    end
    if e == 116:   // 't'
        ret 9
    end
    if e == 114:   // 'r'
        ret 13
    end
    if e == 48:    // '0'
        ret 0
    end
    if e == 97:    // 'a'
        ret 7
    end
    if e == 98:    // 'b'
        ret 8
    end
    if e == 102:   // 'f'
        ret 12
    end
    if e == 118:   // 'v'
        ret 11
    end
    if e == 92:    // '\\'
        ret 92
    end
    if e == 34:    // '"'
        ret 34
    end
    if e == 39:    // '\''
        ret 39
    end
    ret 0 - 1
end

// decode_hex_run(p, len, max, cp) — p becomes (s, from), len -> avail
func decode_hex_run(s: str, from: int, avail: int, maxn: int, cp &: u32): int:
    mut v := 0 as u32
    mut n := 0
    until n < maxn && n < avail:
        d := hexval(byte_at(s, from + n))
        if d < 0:
            break
        end
        v = v * (16 as u32) + (d as u32)
        n += 1
    end
    cp = v
    ret n
end

// lx_decode_string — decode the escapes of a quoted lexeme (quotes included)
func decode_string(lex: str, triple: bool): str:
    lexlen := lex.len()
    q := triple ? 3 : 1
    if lexlen < 2 * q:
        ret ""
    end
    clen := lexlen - 2 * q
    mut out := str.NewBuilder()
    mut i := 0
    until i < clen:
        ch := byte_at(lex, q + i)
        if ch != 92 || i + 1 >= clen:
            str.BufAppendChar(out, ch)
            i += 1
            continue
        end
        i += 1
        e := byte_at(lex, q + i)
        simple := simple_escape(e)
        if simple >= 0:
            str.BufAppendChar(out, simple)
        else e == 120:   // 'x'
            hi := i + 1 < clen ? hexval(byte_at(lex, q + i + 1)) : (0 - 1)
            lo := i + 2 < clen ? hexval(byte_at(lex, q + i + 2)) : (0 - 1)
            if hi >= 0 && lo >= 0:
                str.BufAppendChar(out, hi * 16 + lo)
                i += 2
            else:
                str.BufAppendChar(out, 120)   // 'x'
            end
        else e == 117 || e == 85:   // 'u' 'U'
            mut cp := 0 as u32
            width := e == 117 ? LX_ESC_HEX_U : LX_ESC_HEX_BIG_U
            n := decode_hex_run(lex, q + i + 1, clen - (i + 1), width, cp)
            i += n
            utf8_append(out, cp)
        else:
            str.BufAppendChar(out, e)
        end
        i += 1
    end
    r := str.BufStr(out)
    str.BufFree(out)
    ret r
end

// lx_decode_char — codepoint value of a char literal lexeme (quotes included)
func decode_char(lex: str): u64:
    lexlen := lex.len()
    if lexlen < 3:
        ret 0 as u64
    end
    c0 := byte_at(lex, 1)
    if c0 != 92:
        ret c0 as u64
    end
    c1 := byte_at(lex, 2)
    simple := simple_escape(c1)
    if simple >= 0:
        ret simple as u64
    end
    if c1 == 120:   // 'x'
        hi := lexlen > 3 ? hexval(byte_at(lex, 3)) : (0 - 1)
        lo := lexlen > 4 ? hexval(byte_at(lex, 4)) : (0 - 1)
        if hi >= 0 && lo >= 0:
            ret (hi * 16 + lo) as u64
        end
        ret 0 as u64
    end
    if c1 == 117 || c1 == 85:   // 'u' 'U'
        avail := lexlen > 3 ? lexlen - 3 : 0
        width := c1 == 117 ? LX_ESC_HEX_U : LX_ESC_HEX_BIG_U
        mut cp := 0 as u32
        _n := decode_hex_run(lex, 3, avail, width, cp)
        ret cp as u64
    end
    ret c1 as u64
end

// ===== lexer_trivia.c =====
func token_continues(k: int): bool:
    ret k == tok.TK_PLUS || k == tok.TK_MINUS || k == tok.TK_SLASH ||
        k == tok.TK_PERCENT || k == tok.TK_POWER || k == tok.TK_EQ ||
        k == tok.TK_NE || k == tok.TK_LT || k == tok.TK_GT ||
        k == tok.TK_LE || k == tok.TK_GE || k == tok.TK_AND ||
        k == tok.TK_OR || k == tok.TK_NOT || k == tok.TK_ASSIGN ||
        k == tok.TK_PLUS_EQ || k == tok.TK_MINUS_EQ || k == tok.TK_STAR_EQ ||
        k == tok.TK_SLASH_EQ || k == tok.TK_PERCENT_EQ ||
        k == tok.TK_POWER_EQ || k == tok.TK_COMMA || k == tok.TK_DOT ||
        k == tok.TK_COLON || k == tok.TK_KW_AS || k == tok.TK_LPAREN ||
        k == tok.TK_LBRACKET || k == tok.TK_LBRACE
end

// lx_newline_terminator
func newline_terminator(L &: Lx):
    if L.group_depth != 0 || !L.has_last || L.last == tok.TK_STMT_END ||
        token_continues(L.last):
        ret
    end
    mut t := tok.New(tok.TK_STMT_END, "\\n")
    t.begin_line = L.line as u32
    t.begin_col = L.col as u32
    t.begin_index = L.pos as u32
    t.end_line = L.line as u32
    t.end_col = L.col as u32
    t.end_index = L.pos as u32
    t.length = 0 as u32
    L.toks.push(t)
    L.last = tok.TK_STMT_END
    L.has_last = true
    L.comp_header = false
    if lg.Enabled(L.lgr, lg.LOG_TRACE):
        lg.LogAt(L.lgr, lg.PH_LEXER, lg.LOG_TRACE, L.file, L.line, L.col,
                 "statement terminator (newline)")
    end
end

// lx_try_line_comment
func try_line_comment(L &: Lx): bool:
    if peek(L) != 47 || peek2(L, 1) != 47:
        ret false
    end
    start := L.pos
    b := lx_pos(L)
    skip_to_eol(L)
    if L.keep_comments:
        stop := trim_ws_end(L.s, start, L.pos)
        emit(L, tok.TK_COMMENT_LINE, b, L.s.substr(start, stop - start))
    end
    ret true
end

func scan_block_comment(L &: Lx):
    start := L.pos
    b := lx_pos(L)
    adv(L)
    adv(L)
    mut saw_newline := false
    mut depth := 1
    until !at_end(L):
        if peek(L) == 47 && peek2(L, 1) == 42:   // "/*"
            adv(L)
            adv(L)
            depth += 1
            continue
        end
        if peek(L) == 42 && peek2(L, 1) == 47:   // "*/"
            adv(L)
            adv(L)
            depth -= 1
            if depth == 0:
                break
            end
            continue
        end
        if peek(L) == 10:
            saw_newline = true
        end
        adv(L)
    end
    if depth != 0:
        error_at(L, b, "unterminated block comment")
    end
    if L.keep_comments:
        emit(L, tok.TK_COMMENT_BLOCK, b, lex_slice(L, start))
    end
    if saw_newline:
        newline_terminator(L)
    end
end

// lx_skip_trivia
func skip_trivia(L &: Lx):
    until true:
        c := peek(L)
        if c == 0:
            ret
        end
        if c == 32 || c == 9 || c == 13:
            adv(L)
            continue
        end
        if c == 10:
            adv(L)
            newline_terminator(L)
            continue
        end
        if try_line_comment(L):
            continue
        end
        if c == 47 && peek2(L, 1) == 42:   // "/*"
            scan_block_comment(L)
            continue
        end
        ret
    end
end

// ===== lexer_number.c =====
func scan_digits(L &: Lx, base: int, bad &: bool): int:
    mut ndig := 0
    mut prev_us := false
    mut any := false
    until true:
        mut digit := false
        if base != 0:
            digit = is_base_digit(peek(L), base)
        else:
            digit = at_digit(L, 0) != 0
        end
        if digit:
            if base != 0:
                adv(L)
            else:
                _d := take_digit(L)
            end
            ndig += 1
            prev_us = false
            any = true
        else peek(L) == 95:   // '_'
            if !any || prev_us:
                bad = true
            end
            adv(L)
            prev_us = true
        else:
            break
        end
    end
    if prev_us:
        bad = true
    end
    ret ndig
end

func scan_based_int(L &: Lx, b: co.SrcPos, bad &: bool):
    adv(L)              // '0'
    base := advc(L)     // 'x'/'b'/'o' (any case)
    if scan_digits(L, base, bad) == 0:
        error_at(L, b, "numeric literal has no digits after its base prefix")
    end
    if is_ident_cont(peek(L)):
        error_at(L, b, "invalid digit in numeric literal")
        skip_ident(L)
        bad = true
    end
end

func scan_decimal(L &: Lx, b: co.SrcPos, bad &: bool): bool:
    mut is_float := false
    _n1 := scan_digits(L, 0, bad)
    if peek(L) == 46 && at_digit(L, 1) != 0:   // '.'
        is_float = true
        adv(L)
        _n2 := scan_digits(L, 0, bad)
    end
    if peek(L) == 101 || peek(L) == 69:   // 'e' 'E'
        is_float = true
        adv(L)
        if peek(L) == 43 || peek(L) == 45:   // '+' '-'
            adv(L)
        end
        if scan_digits(L, 0, bad) == 0:
            error_at(L, b, "numeric literal has no exponent digits")
        end
    end
    if is_alpha(peek(L)):
        if peek(L) == 102:   // 'f'
            is_float = true
        end
        skip_ident(L)
    end
    ret is_float
end

// normalize_number — strip '_', fold Persian/Arabic digits to ASCII
func normalize_number(text: str): str:
    tlen := text.len()
    mut out := str.NewBuilder()
    mut i := 0
    until i < tlen:
        if byte_at(text, i) == 95:   // '_'
            i += 1
            continue
        end
        mut val := 0
        dlen := decimal_digit_at(text, i, tlen - i, val)
        if dlen == 2:
            str.BufAppendChar(out, 48 + val)
            i += 2
        else:
            str.BufAppendChar(out, byte_at(text, i))
            i += 1
        end
    end
    r := str.BufStr(out)
    str.BufFree(out)
    ret r
end

func decode_number(clean: str, is_float: bool, overflow &: bool): tok.TokenValue:
    overflow = false
    if is_float:
        ret tok.ValueFloat(clean.to_float())   // strtod(clean, NULL)
    end
    c0 := byte_at(clean, 0)
    c1 := byte_at(clean, 1)
    mut base := 10
    mut di := 0
    if c0 == 48 && (c1 == 120 || c1 == 88):   // 0x
        base = 16
        di = 2
    else c0 == 48 && (c1 == 98 || c1 == 66):  // 0b
        base = 2
        di = 2
    else c0 == 48 && (c1 == 111 || c1 == 79): // 0o
        base = 8
        di = 2
    end
    ret tok.ValueInt(parse_uint(clean, di, base, overflow))
end

// lx_scan_number
func scan_number(L &: Lx):
    start := L.pos
    b := lx_pos(L)
    mut bad := false
    c1 := peek2(L, 1)
    based := peek(L) == 48 && (c1 == 120 || c1 == 88 || c1 == 98 ||
                               c1 == 66 || c1 == 111 || c1 == 79)
    mut is_float := false
    if based:
        scan_based_int(L, b, bad)
    else:
        is_float = scan_decimal(L, b, bad)
    end
    if bad:
        error_at(L, b, "misplaced '_' separator in numeric literal")
    end
    text := lex_slice(L, start)
    clean := normalize_number(text)
    mut overflow := false
    v := decode_number(clean, is_float, overflow)
    if overflow:
        error_at(L, b, "integer literal is too large for a 64-bit value")
    end
    emit_val(L, is_float ? tok.TK_FLOAT : tok.TK_INT, b, text, v)
end

// ===== lexer_string.c =====
// lx_scan_string
func scan_string(L &: Lx):
    start := L.pos
    b := lx_pos(L)
    adv(L)
    until !at_end(L) && peek(L) != 34:
        if peek(L) == 92:
            adv(L)
            if !at_end(L):
                adv(L)
            end
        else peek(L) == 10:
            break
        else:
            adv(L)
        end
    end
    expect(L, 34, b, "unterminated string literal")
    text := lex_slice(L, start)
    emit_val(L, tok.TK_STRING, b, text, tok.ValueStr(decode_string(text, false)))
end

// lx_scan_triple
func scan_triple(L &: Lx):
    start := L.pos
    b := lx_pos(L)
    adv(L)
    adv(L)
    adv(L)
    mut closed := false
    until !at_end(L):
        if peek(L) == 34 && peek2(L, 1) == 34 && peek2(L, 2) == 34:
            adv(L)
            adv(L)
            adv(L)
            closed = true
            break
        end
        adv(L)
    end
    if !closed:
        error_at(L, b, "unterminated triple-quoted string")
    end
    text := lex_slice(L, start)
    emit_val(L, tok.TK_TRIPLE_STRING, b, text, tok.ValueStr(decode_string(text, true)))
end

// lx_scan_char
func scan_char(L &: Lx):
    start := L.pos
    b := lx_pos(L)
    adv(L)
    if peek(L) == 92:
        adv(L)
        if !at_end(L):
            esc := advc(L)
            if esc == 120:   // 'x'
                consume_hex(L, LX_ESC_HEX_X)
            else esc == 117: // 'u'
                consume_hex(L, LX_ESC_HEX_U)
            else esc == 85:  // 'U'
                consume_hex(L, LX_ESC_HEX_BIG_U)
            end
        end
    else !at_end(L) && peek(L) != 39:
        adv(L)
    end
    expect(L, 39, b, "unterminated char literal")
    text := lex_slice(L, start)
    emit_val(L, tok.TK_CHAR, b, text, tok.ValueChar(decode_char(text)))
end

// lx_scan_raw_string
func scan_raw_string(L &: Lx):
    start := L.pos
    b := lx_pos(L)
    adv(L)
    until !at_end(L) && peek(L) != 96:
        adv(L)
    end
    expect(L, 96, b, "unterminated raw string literal")
    text := lex_slice(L, start)
    tlen := text.len()
    inner := tlen >= 2 ? tlen - 2 : 0
    mut sval := ""
    if inner > 0:
        sval = text.substr(1, inner)
    end
    emit_val(L, tok.TK_RAW_STRING, b, text, tok.ValueStr(sval))
end

// lx_scan_utf8_char
func scan_utf8_char(L &: Lx):
    start := L.pos
    b := lx_pos(L)
    adv(L)              // 'u'
    quote := peek(L)
    adv(L)
    content_start := L.pos
    if quote == 34:
        until !at_end(L) && peek(L) != 34:
            if peek(L) == 92:
                adv(L)
                if !at_end(L):
                    adv(L)
                end
            else peek(L) == 10:
                break
            else:
                adv(L)
            end
        end
    else:
        until !at_end(L) && peek(L) != 39 && peek(L) != 10:
            adv(L)
        end
    end
    content_len := L.pos - content_start
    expect(L, quote, b, "unterminated unicode char literal")
    text := lex_slice(L, start)
    mut bytes := ""
    mut nbytes := 0
    if quote == 34:
        bytes = decode_string(text.substr(1, text.len() - 1), false)
        nbytes = bytes.len()
    else:
        bytes = L.s.substr(content_start, content_len)
        nbytes = content_len
    end
    if nbytes == 0:
        error_at(L, b, "empty unicode char literal")
    else:
        seq := utf8_seq_len(bytes, nbytes)
        if seq == 0 || seq != nbytes:
            error_at(L, b, "unicode char literal must contain exactly one codepoint")
        end
    end
    emit_val(L, tok.TK_UTF8_CHAR, b, text, tok.ValueStr(bytes))
end

// ===== lexer_ident.c =====
// lx_norm_ident — ZWNJ -> space, Arabic Yeh -> Farsi Yeh, Arabic Kaf -> Keheh
func norm_ident(text: str): str:
    n := text.len()
    mut need := false
    mut i := 0
    until i < n:
        b0 := byte_at(text, i)
        if b0 == 226 && byte_at(text, i + 1) == 128 && byte_at(text, i + 2) == 140:
            need = true
            break
        end
        if b0 == 217 && (byte_at(text, i + 1) == 138 || byte_at(text, i + 1) == 131):
            need = true
            break
        end
        i += 1
    end
    if !need:
        ret text
    end
    mut out := str.NewBuilder()
    i = 0
    until i < n:
        c0 := byte_at(text, i)
        c1 := byte_at(text, i + 1)
        if c0 == 226 && c1 == 128 && byte_at(text, i + 2) == 140:   // ZWNJ
            str.BufAppendChar(out, 32)
            i += 3
        else c0 == 217 && c1 == 138:   // U+064A -> U+06CC
            str.BufAppend(out, "\xDB\x8C")
            i += 2
        else c0 == 217 && c1 == 131:   // U+0643 -> U+06A9
            str.BufAppend(out, "\xDA\xA9")
            i += 2
        else:
            str.BufAppendChar(out, c0)
            i += 1
        end
    end
    r := str.BufStr(out)
    str.BufFree(out)
    ret r
end

// lx_scan_ident
func scan_ident(L &: Lx):
    start := L.pos
    b := lx_pos(L)
    skip_ident(L)
    raw := lex_slice(L, start)
    k := lp.LookupKeyword(L.pack, raw)
    mut text := raw
    if k == tok.TK_IDENT && !L.keep_comments:
        canon := lp.CanonWord(L.pack, raw)
        text = canon.len() > 0 ? canon : norm_ident(raw)
    end
    if k == tok.TK_KW_TRUE || k == tok.TK_KW_FALSE:
        emit_val(L, k, b, text, tok.ValueBool(k == tok.TK_KW_TRUE))
    else:
        emit(L, k, b, text)
    end
    if k == tok.TK_KW_COMPONENT:
        L.comp_header = true
    end
end

// lx_scan_meta
func scan_meta(L &: Lx):
    b := lx_pos(L)
    adv(L)   // '@'
    start := L.pos
    skip_ident(L)
    mut name := lex_slice(L, start)
    if !L.keep_comments:
        canon := lp.CanonWord(L.pack, name)
        if canon.len() > 0:
            name = canon
        end
    end
    emit(L, tok.TK_META, b, name)
end

// ===== lexer_operator.c =====
// lx_scan_unicode_op — fullwidth +/-, minus sign, Arabic question mark
func scan_unicode_op(L &: Lx): bool:
    rem := L.n - L.pos
    s0 := peek(L)
    s1 := peek2(L, 1)
    s2 := peek2(L, 2)
    mut k := 0
    mut len := 0
    if rem >= 3 && s0 == 239 && s1 == 188 && (s2 == 139 || s2 == 141):
        k = s2 == 139 ? tok.TK_PLUS : tok.TK_MINUS
        len = 3
    else rem >= 3 && s0 == 226 && s1 == 136 && s2 == 146:
        k = tok.TK_MINUS
        len = 3
    else rem >= 2 && s0 == 216 && s1 == 159:
        k = tok.TK_QUESTION
        len = 2
    else:
        ret false
    end
    b := lx_pos(L)
    start := L.pos
    repeat len:
        adv(L)
    end
    emit(L, k, b, lex_slice(L, start))
    ret true
end

// lx_scan_op
func scan_op(L &: Lx):
    prev := L.last
    start := L.pos
    b := lx_pos(L)
    c := advc(L)
    mut k := tok.TK_EOF
    if c == 40:        // '('
        L.group_depth += 1
        k = tok.TK_LPAREN
    else c == 41:      // ')'
        if L.group_depth > 0:
            L.group_depth -= 1
        end
        k = tok.TK_RPAREN
    else c == 91:      // '['
        k = tok.TK_LBRACKET
    else c == 93:      // ']'
        k = tok.TK_RBRACKET
    else c == 123:     // '{'
        k = tok.TK_LBRACE
    else c == 125:     // '}'
        k = tok.TK_RBRACE
    else c == 44:      // ','
        k = tok.TK_COMMA
    else c == 58:      // ':'
        k = match_ch(L, 61) ? tok.TK_COLON_ASSIGN : tok.TK_COLON
    else c == 63:      // '?'
        k = tok.TK_QUESTION
    else c == 46:      // '.'
        if peek(L) == 46 && peek2(L, 1) == 46:
            adv(L)
            adv(L)
            k = tok.TK_ELLIPSIS
        else:
            k = tok.TK_DOT
        end
    else c == 43:      // '+'
        if match_ch(L, 43):
            k = tok.TK_PLUS_PLUS
        else:
            k = match_ch(L, 61) ? tok.TK_PLUS_EQ : tok.TK_PLUS
        end
    else c == 45:      // '-'
        if match_ch(L, 45):
            k = tok.TK_MINUS_MINUS
        else:
            k = match_ch(L, 61) ? tok.TK_MINUS_EQ : tok.TK_MINUS
        end
    else c == 42:      // '*'
        if match_ch(L, 42):
            k = match_ch(L, 61) ? tok.TK_POWER_EQ : tok.TK_POWER
        else match_ch(L, 61):
            k = tok.TK_STAR_EQ
        else:
            k = tok.TK_STAR
        end
    else c == 47:      // '/'
        k = match_ch(L, 61) ? tok.TK_SLASH_EQ : tok.TK_SLASH
    else c == 37:      // '%'
        k = match_ch(L, 61) ? tok.TK_PERCENT_EQ : tok.TK_PERCENT
    else c == 61:      // '='
        if match_ch(L, 61):
            k = tok.TK_EQ
        else match_ch(L, 62):
            k = tok.TK_FAT_ARROW
        else:
            k = tok.TK_ASSIGN
        end
    else c == 33:      // '!'
        k = match_ch(L, 61) ? tok.TK_NE : tok.TK_NOT
    else c == 60:      // '<'
        if match_ch(L, 60):
            k = match_ch(L, 61) ? tok.TK_SHL_EQ : tok.TK_SHL
        else:
            k = match_ch(L, 61) ? tok.TK_LE : tok.TK_LT
        end
    else c == 62:      // '>'
        if match_ch(L, 62):
            k = match_ch(L, 61) ? tok.TK_SHR_EQ : tok.TK_SHR
        else:
            k = match_ch(L, 61) ? tok.TK_GE : tok.TK_GT
        end
    else c == 38:      // '&'
        if match_ch(L, 38):
            k = tok.TK_AND
        else:
            k = match_ch(L, 61) ? tok.TK_AMP_EQ : tok.TK_AMP
        end
    else c == 124:     // '|'
        if match_ch(L, 124):
            k = tok.TK_OR
        else:
            k = match_ch(L, 61) ? tok.TK_PIPE_EQ : tok.TK_PIPE
        end
    else c == 94:      // '^'
        k = match_ch(L, 61) ? tok.TK_CARET_EQ : tok.TK_CARET
    else c == 126:     // '~'
        k = tok.TK_TILDE
    else c == 59:      // ';'
        error_at(L, b,
            "unexpected ';' (statements end at a newline; 'for' uses ',' between clauses)")
        ret
    else:
        error_at(L, b, "unexpected character")
        ret
    end
    emit(L, k, b, lex_slice(L, start))

    if k == tok.TK_COLON &&
        (prev == tok.TK_KW_LAYOUT || (L.comp_header && L.group_depth == 0)):
        L.layout_mode = true
        L.layout_depth = 1
        L.layout_sub = LX_SUB_NAME
        L.comp_header = false
        lg.Log(L.lgr, lg.PH_LEXER, lg.LOG_DEBUG, "entering layout mode")
    end

    if k == tok.TK_STMT_END && L.group_depth == 0:
        L.comp_header = false
    end
end

// ===== lexer_layout.c =====
func layout_close_block(L &: Lx):
    L.layout_depth -= 1
    if L.layout_depth <= 0:
        L.layout_mode = false
        lg.Log(L.lgr, lg.PH_LEXER, lg.LOG_DEBUG, "exiting layout mode")
    end
end

func layout_emit_punct(L &: Lx, k: int, lexeme: str):
    cb := lx_pos(L)
    adv(L)
    emit(L, k, cb, lexeme)
end

func layout_skip_inline_ws(L &: Lx):
    until true:
        c := peek(L)
        if c == 32 || c == 9 || c == 13:
            adv(L)
            continue
        end
        if try_line_comment(L):
            continue
        end
        break
    end
end

func layout_scan_quoted(L &: Lx):
    if peek2(L, 1) == 34 && peek2(L, 2) == 34:
        scan_triple(L)
    else:
        scan_string(L)
    end
end

func layout_scan_func_value(L &: Lx):
    mut depth := 0
    until true:
        layout_skip_inline_ws(L)
        d := peek(L)
        if d == 0 || d == 10:
            eb := lx_pos(L)
            error_at(L, eb, "unterminated function value in layout")
            ret
        end
        if d == 40:   // '('
            depth += 1
            scan_op(L)
            continue
        end
        if d == 41:   // ')'
            depth -= 1
            scan_op(L)
            if depth <= 0:
                ret
            end
            continue
        end
        if d == 34:   // '"'
            layout_scan_quoted(L)
            continue
        end
        if at_digit(L, 0) != 0:
            scan_number(L)
            continue
        end
        if is_ident_start(d):
            scan_ident(L)
            continue
        end
        scan_op(L)
    end
end

func layout_value(L &: Lx):
    layout_skip_inline_ws(L)
    c := peek(L)
    if c == 0 || c == 10:
        b := lx_pos(L)
        error_at(L, b, "layout attribute requires a value")
        ret
    end
    if c == 34:   // '"'
        layout_scan_quoted(L)
        ret
    end
    if c == 96:   // '`'
        scan_raw_string(L)
        ret
    end
    if at_digit(L, 0) != 0:
        scan_number(L)
        ret
    end
    if is_ident_start(c):
        scan_ident(L)
        if peek(L) == 40:   // '('
            layout_scan_func_value(L)
        end
        ret
    end
    scan_op(L)
end

func layout_try_end_inline(L &: Lx, b: co.SrcPos): bool:
    end_kw := lp.EndSpelling(L.pack)
    klen := end_kw.len()
    mut matched_kw := ""
    mut matched_len := 0
    if L.pos + klen <= L.n && str.Equals(L.s.substr(L.pos, klen), end_kw):
        after := peek2(L, klen)
        if after == 32 || after == 9 || after == 13 || after == 10 || after == 0:
            matched_kw = end_kw
            matched_len = klen
        end
    end
    if matched_len == 0 && !str.Equals(end_kw, "end"):
        c0 := peek(L)
        c1 := peek2(L, 1)
        c2 := peek2(L, 2)
        c3 := peek2(L, 3)
        if c0 == 101 && c1 == 110 && c2 == 100 &&
            (c3 == 32 || c3 == 9 || c3 == 13 || c3 == 10 || c3 == 0):
            matched_kw = "end"
            matched_len = 3
        end
    end
    if matched_len == 0:
        ret false
    end
    repeat matched_len:
        adv(L)
    end
    emit(L, tok.TK_KW_END, b, matched_kw)
    layout_close_block(L)
    ret true
end

func layout_report_bad_name(L &: Lx, b: co.SrcPos, name: str, namelen: int):
    mut fw := 0
    until fw < namelen && byte_at(name, fw) != 32 && byte_at(name, fw) != 9:
        fw += 1
    end
    n0 := byte_at(name, 0)
    n1 := byte_at(name, 1)
    n2 := byte_at(name, 2)
    if fw == 3 && (n0 == 69 || n0 == 101) && (n1 == 78 || n1 == 110) &&
        (n2 == 68 || n2 == 100):
        error_at(L, b, "'end' keyword must be lowercase")
    else:
        error_at(L, b, "expected ':' or '=' after layout name")
    end
end

func layout_name(L &: Lx):
    b := lx_pos(L)
    if layout_try_end_inline(L, b):
        ret
    end
    start := L.pos
    until !at_end(L):
        c := peek(L)
        if c == 58 || c == 61 || c == 10:   // ':' '=' '\n'
            break
        end
        adv(L)
    end
    stop := trim_ws_end(L.s, start, L.pos)
    namelen := stop - start
    name := L.s.substr(start, namelen)
    term := peek(L)
    if namelen == 0:
        if term == 58:
            layout_emit_punct(L, tok.TK_COLON, ":")
        else term == 61:
            layout_emit_punct(L, tok.TK_ASSIGN, "=")
            L.layout_sub = LX_SUB_VALUE
        end
        ret
    end
    if (term == 10 || term == 0) && lp.LookupKeyword(L.pack, name) == tok.TK_KW_END:
        emit(L, tok.TK_KW_END, b, name)
        layout_close_block(L)
        ret
    end
    if term == 58:
        emit(L, tok.TK_LAYOUT_ELEMENT, b, name)
        layout_emit_punct(L, tok.TK_COLON, ":")
        L.layout_depth += 1
        L.layout_sub = LX_SUB_NAME
        ret
    end
    if term == 61:
        emit(L, tok.TK_LAYOUT_ATTR_NAME, b, name)
        layout_emit_punct(L, tok.TK_ASSIGN, "=")
        L.layout_sub = LX_SUB_VALUE
        ret
    end
    layout_report_bad_name(L, b, name, namelen)
    emit(L, tok.TK_LAYOUT_ELEMENT, b, name)
end

// lx_layout_step
func layout_step(L &: Lx):
    layout_skip_inline_ws(L)
    c := peek(L)
    if c == 0:
        if !at_end(L):
            adv(L)
        end
        ret
    end
    if c == 10:
        b := lx_pos(L)
        adv(L)
        emit(L, tok.TK_STMT_END, b, "\\n")
        L.layout_sub = LX_SUB_NAME
        ret
    end
    if L.layout_sub == LX_SUB_VALUE:
        layout_value(L)
        L.layout_sub = LX_SUB_NAME
        ret
    end
    layout_name(L)
end

// ===== lexer.c =====
// lx_scan_one
func scan_one(L &: Lx):
    c := peek(L)
    if at_digit(L, 0) != 0:
        scan_number(L)
        ret
    end
    if c == 46 && at_digit(L, 1) != 0:   // '.' digit
        scan_number(L)
        ret
    end
    if c == 117 && (peek2(L, 1) == 34 || peek2(L, 1) == 39):   // u" / u'
        scan_utf8_char(L)
        ret
    end
    if c >= 128 && scan_unicode_op(L):
        ret
    end
    if is_ident_start(c):
        scan_ident(L)
        ret
    end
    if c == 34:   // '"'
        if peek2(L, 1) == 34 && peek2(L, 2) == 34:
            scan_triple(L)
        else:
            scan_string(L)
        end
        ret
    end
    if c == 39:   // '\''
        scan_char(L)
        ret
    end
    if c == 96:   // '`'
        scan_raw_string(L)
        ret
    end
    if c == 64 && is_ident_start(peek2(L, 1)):   // '@'
        scan_meta(L)
        ret
    end
    scan_op(L)
end

// lx_emit_eof
func emit_eof(L &: Lx):
    mut t := tok.New(tok.TK_EOF, "")
    t.begin_line = L.line as u32
    t.begin_col = L.col as u32
    t.begin_index = L.pos as u32
    t.end_line = L.line as u32
    t.end_col = L.col as u32
    t.end_index = L.pos as u32
    t.length = 0 as u32
    L.toks.push(t)
end

// ===== lexer_detect.c =====
func det_match_ci(text: str, p: int, le: int, tag: str, n: int): int:
    if p + n > le:
        ret 0
    end
    repeat n with k:
        mut ch := byte_at(text, p + k)
        if ch >= 65 && ch <= 90:
            ch = ch - 65 + 97
        end
        if ch != byte_at(tag, k):
            ret 0
        end
    end
    ret n
end

func det_match_bytes(text: str, p: int, le: int, tag: str, n: int): int:
    if p + n > le:
        ret 0
    end
    repeat n with k:
        if byte_at(text, p + k) != byte_at(tag, k):
            ret 0
        end
    end
    ret n
end

// det_count_keywords
func det_count_keywords(quiet: lg.Logger, pack: int, sf: src.SourceFile): int:
    mut toks := tok.StreamNew(sf.path)
    _ok := RunEx(quiet, pack, sf, false, toks)
    mut count := 0
    n := tok.StreamCount(toks)
    repeat n with i:
        t := tok.StreamAt(toks, i)
        if t.kind == tok.TK_EOF:
            break
        end
        if tok.IsKeyword(t.kind):
            count += 1
        end
    end
    tok.StreamFree(toks)
    ret count
end

// ---------------------------------------------------------------------------
// Public API (E088: pub section last)
// ---------------------------------------------------------------------------

// ===== lexer.c =====
// lexer_run
pub func Run(lgr: lg.Logger, pack: int, sf: src.SourceFile,
             out &: tok.TokenStream): bool:
    ret RunEx(lgr, pack, sf, false, out)
end

// lexer_run_ex — fills `out` (made with tok.StreamNew) and returns
// !had_error, exactly like the C bool.
pub func RunEx(lgr: lg.Logger, pack: int, sf: src.SourceFile,
               keep_comments: bool, out &: tok.TokenStream): bool:
    // lx_init
    mut L := Lx {}
    L.s = sf.text
    L.n = sf.len
    L.file = sf.path
    L.last = tok.TK_EOF
    L.layout_sub = LX_SUB_NAME
    L.keep_comments = keep_comments
    L.lgr = lgr
    L.pack = pack
    lg.Log(lgr, lg.PH_LEXER, lg.LOG_DEBUG,
           "lexing " + sf.path + " (" + sf.len + " bytes, lang=" + lp.Code(pack) + ")")
    until true:
        if L.layout_mode:
            if at_end(L):
                break
            end
            layout_step(L)
            continue
        end
        skip_trivia(L)
        if at_end(L):
            break
        end
        scan_one(L)
    end
    if L.layout_mode:
        lg.Log(lgr, lg.PH_LEXER, lg.LOG_WARN, "unclosed layout block at end of file")
    end
    newline_terminator(L)
    emit_eof(L)
    mut suffix := ""
    if L.had_error:
        suffix = i18n.Tr(" (with errors)")
    end
    lg.Log(lgr, lg.PH_LEXER, lg.LOG_DEBUG,
           "lexing complete: " + L.toks.len() + " tokens" + suffix)
    out.file = sf.path
    out.toks = L.toks
    ret !L.had_error
end

// ===== lexer_detect.c =====
// langpack_marker_code — "" where the C returns NULL. Scans the first 8
// lines for a "// lang: …" / "// زبان: …" / "// لغة: …" marker comment.
pub func MarkerCode(text: str, length: int): str:
    mut i := 0
    mut line := 0
    until i < length && line < 8:
        mut ls := i
        until ls < length && (byte_at(text, ls) == 32 || byte_at(text, ls) == 9):
            ls += 1
        end
        mut le := ls
        until le < length && byte_at(text, le) != 10:
            le += 1
        end
        if ls + 1 < length && byte_at(text, ls) == 47 && byte_at(text, ls + 1) == 47:
            mut p := ls + 2
            until p < le:
                mut fa_tagged := false
                mut ar_tagged := false
                mut tlen := det_match_bytes(text, p, le, k_lx_fa_tag, 8)
                if tlen != 0:
                    fa_tagged = true
                end
                if tlen == 0:
                    tlen = det_match_bytes(text, p, le, k_lx_ar_tag, 6)
                    if tlen != 0:
                        ar_tagged = true
                    end
                end
                if tlen == 0:
                    tlen = det_match_ci(text, p, le, "language", 8)
                end
                if tlen == 0:
                    tlen = det_match_ci(text, p, le, "lang", 4)
                end
                if tlen == 0:
                    p += 1
                    continue
                end
                mut q := p + tlen
                until q < le && (byte_at(text, q) == 32 || byte_at(text, q) == 9):
                    q += 1
                end
                if q >= le || byte_at(text, q) != 58:   // ':'
                    p += 1
                    continue
                end
                q += 1
                until q < le && (byte_at(text, q) == 32 || byte_at(text, q) == 9):
                    q += 1
                end
                if fa_tagged || ar_tagged:
                    if det_match_bytes(text, q, le, k_lx_ar_val, 14) != 0:
                        ret "ar"
                    end
                    if det_match_bytes(text, q, le, k_lx_fa_val, 10) != 0:
                        ret "fa"
                    end
                    if det_match_bytes(text, q, le, k_lx_en_val, 14) != 0:
                        ret "en"
                    end
                    ret ""
                end
                if det_match_ci(text, q, le, "english", 7) != 0:
                    ret "en"
                end
                cs := q
                until q < le && ((byte_at(text, q) >= 97 && byte_at(text, q) <= 122) ||
                                 (byte_at(text, q) >= 65 && byte_at(text, q) <= 90)):
                    q += 1
                end
                if q - cs == 2 &&
                    (byte_at(text, cs) == 101 || byte_at(text, cs) == 69) &&
                    (byte_at(text, cs + 1) == 110 || byte_at(text, cs + 1) == 78):
                    ret "en"
                end
                ret ""
            end
        end
        i = le < length ? le + 1 : le
        line += 1
    end
    ret ""
end

// langpack_detect — marker comment first, then "which pack sees the most
// keywords" over en/fa/ar with a silenced logger.
pub func Detect(sf: src.SourceFile, fallback: int): int:
    marked := MarkerCode(sf.text, sf.len)
    if marked.len() > 0:
        p := lp.Load(marked)
        if p != lp.LP_NONE:
            ret p
        end
    end
    quiet := lg.New(lg.LOG_OFF, false)
    mut best := fallback
    mut best_kw := 0
    codes := ["en", "fa", "ar"] as str[3]
    each code in codes:
        p := lp.Load(code)
        if p == lp.LP_NONE:
            continue
        end
        kw := det_count_keywords(quiet, p, sf)
        if kw > best_kw:
            best_kw = kw
            best = p
        end
    end
    ret best
end
