package lexer

import tok "../token.salam"
import lg "../logger.salam"
import lp "../langpack.salam"
import co "../sal_core.salam"

const LX_SUB_NAME := 0
const LX_SUB_VALUE := 1

const LX_ESC_HEX_X := 2
const LX_ESC_HEX_U := 4
const LX_ESC_HEX_BIG_U := 8

k_lx_fa_tag := "\xd8\xb2\xd8\xa8\xd8\xa7\xd9\x86"
k_lx_fa_val := "\xd9\x81\xd8\xa7\xd8\xb1\xd8\xb3\xdb\x8c"
k_lx_en_val := "\xd8\xa7\xd9\x86\xda\xaf\xd9\x84\xdb\x8c\xd8\xb3\xdb\x8c"

struct Lx:
    pub s: str = ""
    pub n: int = 0
    pub pos: int = 0
    pub line: int = 1
    pub col: int = 1
    pub file: str = ""
    pub group_depth: int = 0
    pub last: int = 0
    pub has_last: bool = false
    pub had_error: bool = false
    pub keep_comments: bool = false
    pub layout_mode: bool = false
    pub layout_depth: int = 0
    pub layout_sub: int = 0
    pub comp_header: bool = false
    pub rep_header: bool = false
    pub lgr: lg.Logger = lg.New(2, false)
    pub pack: int = 0
    pub toks: Vector<tok.Token> = Vector {}
end

inline func byte_at(s: str, i: int): int: ret co.ByteAt(s, i) end
