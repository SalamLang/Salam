package lexer

include src "../source.salam"
include tok "../token.salam"
include lg "../logger.salam"
include lp "../langpack.salam"
include i18n "../i18n.salam"

func src_pos_at(s: str, off: int): co.SrcPos:
    mut line := 1
    mut col := 1
    repeat off in i:
        if byte_at(s, i) == 10:
            line++
            col = 1
        else:
            col++
        end
    end
    ret co.MakePos(line as u32, col as u32, off as u32)
end

func utf8_bad_at(s: str, n: int): int:
    mut i := 0
    until i < n:
        c := byte_at(s, i)
        if c < 128:
            i++
            continue
        end
        mut need := 0
        mut lo := 128
        mut hi := 191
        if c >= 194 and c <= 223:
            need = 1
        else c == 224:
            need = 2
            lo = 160
        else c == 237:
            need = 2
            hi = 159
        else c >= 225 and c <= 239:
            need = 2
        else c == 240:
            need = 3
            lo = 144
        else c == 244:
            need = 3
            hi = 143
        else c >= 241 and c <= 243:
            need = 3
        else:
            ret i
        end
        if i + need >= n:
            ret i
        end
        c1 := byte_at(s, i + 1)
        if c1 < lo or c1 > hi:
            ret i
        end
        mut k := 2
        until k <= need:
            ck := byte_at(s, i + k)
            if ck < 128 or ck > 191:
                ret i
            end
            k++
        end
        i += need + 1
    end
    ret 0 - 1
end

func check_source_bytes(L &: Lx, nul_at: int):
    if nul_at >= 0:
        error_at(L, src_pos_at(L.s, nul_at), "E261: the source contains a NUL byte here; the compiler cannot read past it")
        ret
    end
    bad := utf8_bad_at(L.s, L.n)
    if bad >= 0:
        error_at(L, src_pos_at(L.s, bad), "E261: the source is not valid UTF-8 here; save the file as UTF-8")
    end
end

pub func Run(
    lgr: lg.Logger, pack: int, sf: src.SourceFile, out &: tok.TokenStream
): bool:
    ret RunEx(lgr, pack, sf, false, out)
end

pub func RunEx(
    lgr: lg.Logger, pack: int, sf: src.SourceFile, keep_comments: bool, out &: tok.TokenStream
): bool:
    ret RunSplit(lgr, pack, sf, keep_comments, false, out)
end

pub func RunSplit(
    lgr: lg.Logger, pack: int, sf: src.SourceFile, keep_comments: bool, split_blocks: bool, out &: tok.TokenStream
): bool:
    mut L := Lx {}
    L.split_blocks = split_blocks
    L.s = sf.text
    L.n = sf.len
    L.file = sf.path
    L.last = tok.TK_EOF
    L.layout_sub = LX_SUB_NAME
    L.keep_comments = keep_comments
    L.lgr = lgr
    L.pack = pack
    L.bidi = not g_lx_probe and src_has_bidi(sf.text, sf.len)
    mut marker_at := co.SrcPos {}
    marker_bad := MarkerProblem(sf.text, sf.len, marker_at)
    if marker_bad == MARKER_WANT_FA:
        error_at(
            L, marker_at, "a Persian file declares its language with '// زبان: فارسی'; mixed forms such as '// lang: fa' are not accepted"
        )
    else marker_bad == MARKER_WANT_EN:
        error_at(
            L, marker_at, "an English file declares its language with '// lang: en'; a directive that mixes English and Persian words is not accepted"
        )
    end
    check_source_bytes(L, sf.nul_at)
    lg.Log(
        lgr, lg.PH_LEXER, lg.LOG_DEBUG, "lexing " + sf.path + " (" + sf.len + " bytes, lang=" + lp.Code(pack) + ")"
    )
    until true:
        if L.layout_mode:
            if at_end(L):
                break
            end
            layout_step(L)
            continue
        end
        skip_trivia(L)
        if at_end(L):
            break
        end
        scan_one(L)
    end
    if L.layout_mode:
        lg.Log(lgr, lg.PH_LEXER, lg.LOG_WARN, i18n.Tr("unclosed page block at end of file"))
    end
    newline_terminator(L)
    emit_eof(L)
    mut suffix := ""
    if L.had_error:
        suffix = i18n.Tr(" (with errors)")
    end
    lg.Log(
        lgr, lg.PH_LEXER, lg.LOG_DEBUG, "lexing complete: " + L.toks.Len() + " tokens" + suffix
    )
    out.file = sf.path
    out.toks = L.toks
    out.pack = pack
    ret not L.had_error
end

pub func MarkerCode(text: str, length: int): str:
    mut bad := 0
    mut bad_pos := co.SrcPos {}
    ret marker_scan(text, length, bad, bad_pos)
end

pub func MarkerProblem(text: str, length: int, at &: co.SrcPos): int:
    mut bad := 0
    _code := marker_scan(text, length, bad, at)
    ret bad
end

pub func Detect(sf: src.SourceFile, fallback: int): int:
    marked := MarkerCode(sf.text, sf.len)
    if marked.Len() > 0:
        p := lp.Load(marked)
        if p != lp.LP_NONE:
            ret p
        end
    end
    quiet := lg.New(lg.LOG_OFF, false)
    mut best := fallback
    mut best_kw := 0
    codes := ["en", "fa"]
    each code in codes:
        p := lp.Load(code)
        if p == lp.LP_NONE:
            continue
        end
        kw := det_count_keywords(quiet, p, sf)
        if kw > best_kw or (kw == best_kw and kw > 0 and p == fallback):
            best_kw = kw
            best = p
        end
    end
    ret best
end
