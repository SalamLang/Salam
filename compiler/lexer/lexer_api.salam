package lexer

include src "../source.salam"
include tok "../token.salam"
include lg "../logger.salam"
include lp "../langpack.salam"
include i18n "../i18n.salam"

pub func Run(
    lgr: lg.Logger, pack: int, sf: src.SourceFile, out &: tok.TokenStream
): bool:
    ret RunEx(lgr, pack, sf, false, out)
end

pub func RunEx(
    lgr: lg.Logger, pack: int, sf: src.SourceFile, keep_comments: bool, out &: tok.TokenStream
): bool:
    ret RunSplit(lgr, pack, sf, keep_comments, false, out)
end

pub func RunSplit(
    lgr: lg.Logger, pack: int, sf: src.SourceFile, keep_comments: bool, split_blocks: bool, out &: tok.TokenStream
): bool:
    mut L := Lx {}
    L.split_blocks = split_blocks
    L.s = sf.text
    L.n = sf.len
    L.file = sf.path
    L.last = tok.TK_EOF
    L.layout_sub = LX_SUB_NAME
    L.keep_comments = keep_comments
    L.lgr = lgr
    L.pack = pack
    lg.Log(
        lgr, lg.PH_LEXER, lg.LOG_DEBUG, "lexing " + sf.path + " (" + sf.len + " bytes, lang=" + lp.Code(pack) + ")"
    )
    until true:
        if L.layout_mode:
            if at_end(L):
                break
            end
            layout_step(L)
            continue
        end
        skip_trivia(L)
        if at_end(L):
            break
        end
        scan_one(L)
    end
    if L.layout_mode:
        lg.Log(lgr, lg.PH_LEXER, lg.LOG_WARN, i18n.Tr("unclosed layout block at end of file"))
    end
    newline_terminator(L)
    emit_eof(L)
    mut suffix := ""
    if L.had_error:
        suffix = i18n.Tr(" (with errors)")
    end
    lg.Log(
        lgr, lg.PH_LEXER, lg.LOG_DEBUG, "lexing complete: " + L.toks.len() + " tokens" + suffix
    )
    out.file = sf.path
    out.toks = L.toks
    ret not L.had_error
end

pub func MarkerCode(text: str, length: int): str:
    mut i := 0
    mut line := 0
    until i < length and line < 8:
        mut ls := i
        until ls < length and (byte_at(text, ls) == 32 or byte_at(text, ls) == 9):
            ls += 1
        end
        mut le := ls
        until le < length and byte_at(text, le) != 10:
            le += 1
        end
        if ls + 1 < length and byte_at(text, ls) == 47 and byte_at(text, ls + 1) == 47:
            mut p := ls + 2
            until p < le:
                mut fa_tagged := false
                mut tlen := det_match_bytes(text, p, le, k_lx_fa_tag, 8)
                if tlen != 0:
                    fa_tagged = true
                end
                if tlen == 0:
                    tlen = det_match_ci(text, p, le, "language", 8)
                end
                if tlen == 0:
                    tlen = det_match_ci(text, p, le, "lang", 4)
                end
                if tlen == 0:
                    p += 1
                    continue
                end
                mut q := p + tlen
                until q < le and (byte_at(text, q) == 32 or byte_at(text, q) == 9):
                    q += 1
                end
                if q >= le or byte_at(text, q) != 58:
                    p += 1
                    continue
                end
                q += 1
                until q < le and (byte_at(text, q) == 32 or byte_at(text, q) == 9):
                    q += 1
                end
                if fa_tagged:
                    if det_match_bytes(text, q, le, k_lx_fa_val, 10) != 0:
                        ret "fa"
                    end
                    if det_match_bytes(text, q, le, k_lx_en_val, 14) != 0:
                        ret "en"
                    end
                    ret ""
                end
                if det_match_ci(text, q, le, "english", 7) != 0:
                    ret "en"
                end
                if det_match_ci(text, q, le, "persian", 7) != 0:
                    ret "fa"
                end
                if det_match_ci(text, q, le, "farsi", 5) != 0:
                    ret "fa"
                end
                cs := q
                until q < le and (
                    (byte_at(text, q) >= 97 and byte_at(text, q) <= 122) or (byte_at(text, q) >= 65 and byte_at(text, q) <= 90)
                ):
                    q += 1
                end
                if q - cs == 2:
                    if (byte_at(text, cs) == 101 or byte_at(text, cs) == 69) and (byte_at(text, cs + 1) == 110 or byte_at(text, cs + 1) == 78):
                        ret "en"
                    end
                    if (byte_at(text, cs) == 102 or byte_at(text, cs) == 70) and (byte_at(text, cs + 1) == 97 or byte_at(text, cs + 1) == 65):
                        ret "fa"
                    end
                end
                ret ""
            end
        end
        i = le < length ? le + 1 : le
        line += 1
    end
    ret ""
end

pub func Detect(sf: src.SourceFile, fallback: int): int:
    marked := MarkerCode(sf.text, sf.len)
    if marked.len() > 0:
        p := lp.Load(marked)
        if p != lp.LP_NONE:
            ret p
        end
    end
    quiet := lg.New(lg.LOG_OFF, false)
    mut best := fallback
    mut best_kw := 0
    codes := ["en", "fa"]
    each code in codes:
        p := lp.Load(code)
        if p == lp.LP_NONE:
            continue
        end
        kw := det_count_keywords(quiet, p, sf)
        if kw > best_kw or (kw == best_kw and kw > 0 and p == fallback):
            best_kw = kw
            best = p
        end
    end
    ret best
end
