package lexer

import str

include co "../sal_core.salam"

func is_digit(c: int): bool:
    ret c >= 48 and c <= 57
end

func is_alpha(c: int): bool:
    ret (c >= 97 and c <= 122) or (c >= 65 and c <= 90)
end

func is_ident_start(c: int): bool:
    ret is_alpha(c) or c == 95 or c >= 128
end

func is_ident_cont(c: int): bool:
    ret is_ident_start(c) or is_digit(c)
end

func hexval(c: int): int:
    if c >= 48 and c <= 57:
        ret c - 48
    end
    if c >= 97 and c <= 102:
        ret c - 97 + 10
    end
    if c >= 65 and c <= 70:
        ret c - 65 + 10
    end
    ret 0 - 1
end

func is_base_digit(c: int, base: int): bool:
    if base == 120 or base == 88:
        ret hexval(c) >= 0
    end
    if base == 98 or base == 66:
        ret c == 48 or c == 49
    end
    if base == 111 or base == 79:
        ret c >= 48 and c <= 55
    end
    ret false
end

func decimal_digit_at(s: str, at: int, n: int, val &: int): int:
    if n == 0:
        ret 0
    end
    b0 := byte_at(s, at)
    if b0 >= 48 and b0 <= 57:
        val = b0 - 48
        ret 1
    end
    if n < 2:
        ret 0
    end
    b1 := byte_at(s, at + 1)
    if b0 == 217 and b1 >= 160 and b1 <= 169:
        val = b1 - 160
        ret 2
    end
    if b0 == 219 and b1 >= 176 and b1 <= 185:
        val = b1 - 176
        ret 2
    end
    ret 0
end

func utf8_append(out &: str.StringBuilder, cp: u32):
    if cp < (128 as u32):
        str.BufAppendChar(out, cp as int)
        ret
    end
    if cp < (2048 as u32):
        str.BufAppendChar(out, ((192 as u32) | (cp >> 6)) as int)
        str.BufAppendChar(out, ((128 as u32) | (cp & (63 as u32))) as int)
        ret
    end
    if cp < (65536 as u32):
        str.BufAppendChar(out, ((224 as u32) | (cp >> 12)) as int)
        str.BufAppendChar(out, ((128 as u32) | ((cp >> 6) & (63 as u32))) as int)
        str.BufAppendChar(out, ((128 as u32) | (cp & (63 as u32))) as int)
        ret
    end
    str.BufAppendChar(out, ((240 as u32) | (cp >> 18)) as int)
    str.BufAppendChar(out, ((128 as u32) | ((cp >> 12) & (63 as u32))) as int)
    str.BufAppendChar(out, ((128 as u32) | ((cp >> 6) & (63 as u32))) as int)
    str.BufAppendChar(out, ((128 as u32) | (cp & (63 as u32))) as int)
end

func utf8_seq_len(s: str, n: int): int:
    if n == 0:
        ret 0
    end
    b0 := byte_at(s, 0)
    if b0 < 128:
        ret 1
    end
    if (b0 & 224) == 192 and n >= 2:
        ret 2
    end
    if (b0 & 240) == 224 and n >= 3:
        ret 3
    end
    if (b0 & 248) == 240 and n >= 4:
        ret 4
    end
    ret 0
end

func parse_uint(d: str, from: int, base: int, overflow &: bool): u64:
    mut v := 0 as u64
    b := base as u64
    overflow = false
    umax := co.SizeMax()
    n := d.len()
    mut i := from
    until i < n:
        digit := hexval(byte_at(d, i))
        if digit < 0 or digit >= base:
            break
        end
        if v > (umax - (digit as u64)) / b:
            overflow = true
            v = umax
        else:
            v = v * b + (digit as u64)
        end
        i += 1
    end
    ret v
end
