package lexer

import str

func simple_escape(e: int): int:
    if e == 110:
        ret 10
    end
    if e == 116:
        ret 9
    end
    if e == 114:
        ret 13
    end
    if e == 48:
        ret 0
    end
    if e == 97:
        ret 7
    end
    if e == 98:
        ret 8
    end
    if e == 102:
        ret 12
    end
    if e == 118:
        ret 11
    end
    if e == 92:
        ret 92
    end
    if e == 34:
        ret 34
    end
    if e == 39:
        ret 39
    end
    ret 0 - 1
end

func decode_hex_run(s: str, from: int, avail: int, maxn: int, cp &: u32): int:
    mut v := 0 as u32
    mut n := 0
    until n < maxn && n < avail:
        d := hexval(byte_at(s, from + n))
        if d < 0:
            break
        end
        v = v * (16 as u32) + (d as u32)
        n += 1
    end
    cp = v
    ret n
end

func decode_string(lex: str, triple: bool): str:
    lexlen := lex.len()
    q := triple ? 3 : 1
    if lexlen < 2 * q:
        ret ""
    end
    content_len := lexlen - 2 * q
    mut out := str.NewBuilder()
    mut i := 0
    until i < content_len:
        ch := byte_at(lex, q + i)
        if ch != 92 || i + 1 >= content_len:
            str.BufAppendChar(out, ch)
            i += 1
            continue
        end
        i += 1
        e := byte_at(lex, q + i)
        simple := simple_escape(e)
        if simple >= 0:
            str.BufAppendChar(out, simple)
        else e == 120:
            hi := i + 1 < content_len ? hexval(byte_at(lex, q + i + 1)) : (0 - 1)
            lo := i + 2 < content_len ? hexval(byte_at(lex, q + i + 2)) : (0 - 1)
            if hi >= 0 && lo >= 0:
                str.BufAppendChar(out, hi * 16 + lo)
                i += 2
            else:
                str.BufAppendChar(out, 120)
            end
        else e == 117 || e == 85:
            mut cp := 0 as u32
            width := e == 117 ? LX_ESC_HEX_U : LX_ESC_HEX_BIG_U
            n := decode_hex_run(lex, q + i + 1, content_len - (i + 1), width, cp)
            i += n
            utf8_append(out, cp)
        else:
            str.BufAppendChar(out, e)
        end
        i += 1
    end
    r := str.BufStr(out)
    str.BufFree(out)
    ret r
end

func decode_char(lex: str): u64:
    lexlen := lex.len()
    if lexlen < 3:
        ret 0
    end
    c0 := byte_at(lex, 1)
    if c0 != 92:
        ret c0 as u64
    end
    c1 := byte_at(lex, 2)
    simple := simple_escape(c1)
    if simple >= 0:
        ret simple as u64
    end
    if c1 == 120:
        hi := lexlen > 3 ? hexval(byte_at(lex, 3)) : (0 - 1)
        lo := lexlen > 4 ? hexval(byte_at(lex, 4)) : (0 - 1)
        if hi >= 0 && lo >= 0:
            ret (hi * 16 + lo) as u64
        end
        ret 0
    end
    if c1 == 117 || c1 == 85:
        avail := lexlen > 3 ? lexlen - 3 : 0
        width := c1 == 117 ? LX_ESC_HEX_U : LX_ESC_HEX_BIG_U
        mut cp := 0 as u32
        _n := decode_hex_run(lex, 3, avail, width, cp)
        ret cp
    end
    ret c1 as u64
end
