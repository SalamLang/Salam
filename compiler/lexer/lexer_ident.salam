package lexer

import str

include tok "../token.salam"
include lp "../langpack.salam"

k_lx_spaced_head := "اندازه"
k_lx_spaced_tail := "مثبت"
k_lx_spaced_name := "اندازه مثبت"
k_lx_spaced_in := "درون"
k_lx_spaced_out := "برون"
k_lx_spaced_catch := "گرفتن"
k_lx_spaced_throw := "پرتاب"

func is_haraka(b1: int): bool:
    ret (b1 >= 139 and b1 <= 146) or b1 == 176
end

func norm_ident(text: str): str:
    n := text.len()
    mut need := false
    mut i := 0
    until i < n:
        b0 := byte_at(text, i)
        if b0 == 226 and byte_at(text, i + 1) == 128 and byte_at(text, i + 2) == 140:
            need = true
            break
        end
        if b0 == 217 and (byte_at(text, i + 1) == 138 or byte_at(text, i + 1) == 131 or is_haraka(byte_at(text, i + 1))):
            need = true
            break
        end
        i += 1
    end
    if not need:
        ret text
    end
    mut out := str.NewBuilder()
    i = 0
    until i < n:
        c0 := byte_at(text, i)
        c1 := byte_at(text, i + 1)
        if c0 == 226 and c1 == 128 and byte_at(text, i + 2) == 140:
            str.BufAppendChar(out, 32)
            i += 3
        else c0 == 217 and c1 == 138:
            str.BufAppend(out, "\xDB\x8C")
            i += 2
        else c0 == 217 and c1 == 131:
            str.BufAppend(out, "\xDA\xA9")
            i += 2
        else c0 == 217 and is_haraka(c1):
            i += 2
        else:
            str.BufAppendChar(out, c0)
            i += 1
        end
    end
    r := str.BufStr(out)
    str.BufFree(out)
    ret r
end

func spaced_keyword_end(L &: Lx, k: int, raw: str): int:
    if k != tok.TK_KW_FALSE and k != tok.TK_LT and k != tok.TK_GT and not (k == tok.TK_IDENT and (str.Equals(raw, k_lx_spaced_in) or str.Equals(raw, k_lx_spaced_out) or str.Equals(raw, k_lx_spaced_catch) or str.Equals(raw, k_lx_spaced_throw))):
        ret 0
    end
    mut j := 0
    until L.pos + j < L.n and byte_at(L.s, L.pos + j) == 32:
        j += 1
    end
    if j == 0 or L.pos + j >= L.n or not is_ident_start(byte_at(L.s, L.pos + j)):
        ret 0
    end
    mut e := L.pos + j
    until e < L.n and is_ident_cont(byte_at(L.s, e)):
        e += 1
    end
    ret e
end

func spaced_name_end(L &: Lx, raw: str): int:
    if not str.Equals(norm_ident(raw), k_lx_spaced_head):
        ret 0
    end
    mut j := 0
    until L.pos + j < L.n and byte_at(L.s, L.pos + j) == 32:
        j += 1
    end
    if j == 0:
        ret 0
    end
    tl := k_lx_spaced_tail.len()
    e := L.pos + j + tl
    if e > L.n or not str.Equals(str.SubstrIn(L.s, L.pos + j, tl), k_lx_spaced_tail):
        ret 0
    end
    if e < L.n and is_ident_cont(byte_at(L.s, e)):
        punct := byte_at(L.s, e) == 216 and e + 1 < L.n and (byte_at(L.s, e + 1) == 140 or byte_at(L.s, e + 1) == 159)
        if not punct:
            ret 0
        end
    end
    ret e
end

func input_starts_name(L &: Lx): bool:
    mut j := 0
    until L.pos + j < L.n and byte_at(L.s, L.pos + j) == 32:
        j += 1
    end
    if j == 0 or L.pos + j >= L.n or not is_ident_start(byte_at(L.s, L.pos + j)) or at_digit(L, j) > 0:
        ret false
    end
    mut e := L.pos + j
    until e < L.n and is_ident_cont(byte_at(L.s, e)):
        e += 1
    end
    word := str.SubstrIn(L.s, L.pos + j, e - L.pos - j)
    ret lp.LookupKeywordIn(L.pack, word, false) == tok.TK_IDENT
end

func lx_at_value_end(L &: Lx): bool:
    if not L.has_last:
        ret false
    end
    k := L.last
    ret k == tok.TK_INT or k == tok.TK_FLOAT or k == tok.TK_STRING or k == tok.TK_TRIPLE_STRING or k == tok.TK_RAW_STRING or k == tok.TK_CHAR or k == tok.TK_UTF8_CHAR or k == tok.TK_IDENT or k == tok.TK_RPAREN or k == tok.TK_RBRACKET or k == tok.TK_KW_TRUE or k == tok.TK_KW_FALSE or k == tok.TK_KW_NULL or k == tok.TK_KW_THIS
end

func soft_layout_header(L &: Lx, start: int): bool:
    mut i := start - 1
    until i >= 0 and (byte_at(L.s, i) == 32 or byte_at(L.s, i) == 9):
        i -= 1
    end
    if i >= 0 and byte_at(L.s, i) != 10 and not (L.has_last and L.last == tok.TK_KW_PUB):
        ret false
    end
    mut j := L.pos
    until j < L.n and (byte_at(L.s, j) == 32 or byte_at(L.s, j) == 9):
        j += 1
    end
    if j < L.n and byte_at(L.s, j) == 58:
        j += 1
        until j < L.n and (byte_at(L.s, j) == 32 or byte_at(L.s, j) == 9 or byte_at(L.s, j) == 13):
            j += 1
        end
        ret j >= L.n or byte_at(L.s, j) == 10 or (byte_at(L.s, j) == 47 and j + 1 < L.n and byte_at(L.s, j + 1) == 47)
    end
    if j >= L.n or not is_ident_start(byte_at(L.s, j)):
        ret false
    end
    mut depth := 0
    mut last := 0
    until j < L.n and byte_at(L.s, j) != 10:
        c := byte_at(L.s, j)
        if c == 40:
            depth += 1
        else c == 41 and depth > 0:
            depth -= 1
        else c == 61 and depth == 0:
            ret false
        else c == 47 and depth == 0 and j + 1 < L.n and byte_at(L.s, j + 1) == 47:
            break
        end
        if c != 32 and c != 9 and c != 13:
            last = c
        end
        j += 1
    end
    ret last == 58
end

func other_lang_form(L &: Lx, raw: str): str:
    if L.pack == lp.LP_FA:
        if str.Equals(raw, "this"):
            ret "این"
        end
        if str.Equals(raw, "Self"):
            ret "خود"
        end
    else L.pack == lp.LP_EN:
        if str.Equals(raw, "این"):
            ret "this"
        end
        if str.Equals(raw, "خود"):
            ret "Self"
        end
    end
    ret ""
end

func report_other_lang(L &: Lx, b: co.SrcPos, used: str, want: str, annotation: bool):
    if g_lx_probe:
        ret
    end
    mut msg := "identifier '%s' must be English in an English file"
    mut hint := "the English name is '%s'"
    if annotation:
        msg = "annotation '%s' must be English in an English file"
    end
    if L.pack == lp.LP_FA:
        msg = annotation ? "annotation '%s' must be Persian in a Persian file" : "identifier '%s' must be Persian in a Persian file"
        hint = "the Persian name is '%s'"
    end
    mut f := lg.Fix {}
    f.title = co.Format1(i18n.Tr("Write '%s'"), co.ArgStr(want))
    f.index = b.index as int
    f.length = str.Len(used)
    f.text = want
    f.preferred = true
    f.safe = true
    lg.StageFix(f)
    L.had_error = true
    help := co.Format1(i18n.Tr(hint), co.ArgStr(want))
    text := co.Format1(i18n.Tr(msg), co.ArgStr(used))
    lg.LogSpanHelp(
        L.lgr, lg.PH_LEXER, lg.LOG_ERROR, L.file, b.line as int, b.col as int, b.index as int, str.Len(used), help, text
    )
end

func scan_ident(L &: Lx):
    start := L.pos
    b := lx_pos(L)
    skip_ident(L)
    mut raw := lex_intern(L, start)
    mut k := lp.LookupKeywordIn(L.pack, raw, lx_at_value_end(L))
    if k == tok.TK_IDENT:
        want := other_lang_form(L, raw)
        if str.Len(want) > 0:
            report_other_lang(L, b, raw, want, false)
            raw = want
            if str.Equals(want, "this") or str.Equals(want, "این"):
                k = tok.TK_KW_THIS
            end
        end
    end
    if k == tok.TK_KW_INPUT and input_starts_name(L):
        k = tok.TK_IDENT
    end
    if k == tok.TK_KW_LAYOUT and lp.IsSoftLayout(L.pack, raw) and not soft_layout_header(L, start):
        k = tok.TK_IDENT
    end
    e := spaced_keyword_end(L, k, raw)
    if e > 0:
        cand := str.SubstrIn(L.s, start, e - start)
        k2 := lp.LookupKeywordIn(L.pack, cand, false)
        if k2 == tok.TK_KW_PRINTERR or k2 == tok.TK_KW_PRINTERRLN or k2 == tok.TK_KW_EXTERN or k2 == tok.TK_KW_EXPORT or k2 == tok.TK_KW_CATCH or k2 == tok.TK_KW_THROW or (k == tok.TK_LT and k2 == tok.TK_LE) or (k == tok.TK_GT and k2 == tok.TK_GE):
            k = k2
            repeat e - L.pos:
                adv(L)
            end
            raw = lex_intern(L, start)
        end
    end
    mut spaced := false
    if k == tok.TK_IDENT:
        se := spaced_name_end(L, raw)
        if se > 0:
            repeat se - L.pos:
                adv(L)
            end
            raw = lex_intern(L, start)
            spaced = true
        end
    end
    mut text := raw
    if spaced and not L.keep_comments:
        text = k_lx_spaced_name
    else k == tok.TK_IDENT and not L.keep_comments:
        canon := lp.CanonWord(L.pack, raw)
        text = canon.len() > 0 ? canon : norm_ident(raw)
    end
    if k == tok.TK_KW_TRUE or k == tok.TK_KW_FALSE:
        emit_val(L, k, b, text, tok.ValueBool(k == tok.TK_KW_TRUE))
    else:
        emit(L, k, b, text)
    end
    if k == tok.TK_KW_COMPONENT:
        L.comp_header = true
    end
    if k == tok.TK_KW_LAYOUT and not L.layout_mode:
        mut q := 0
        until peek2(L, q) == 32 or peek2(L, q) == 9:
            q += 1
        end
        if q > 0 and is_ident_start(peek2(L, q)):
            L.comp_header = true
        end
    end
end

func scan_meta(L &: Lx):
    b := lx_pos(L)
    adv(L)
    start := L.pos
    skip_ident(L)
    mut name := lex_intern(L, start)
    meta := lp.MetaCanon(L.pack, name)
    if str.Len(meta) > 0 and (L.pack == lp.LP_EN or L.pack == lp.LP_FA):
        want := lp.MetaSpelling(L.pack, meta)
        if not str.Equals(want, name):
            report_other_lang(L, b, "@" + name, "@" + want, true)
        end
        if not L.keep_comments:
            name = meta
        end
    else not L.keep_comments:
        canon := lp.CanonWord(L.pack, name)
        if canon.len() > 0:
            name = canon
        end
    end
    emit(L, tok.TK_META, b, name)
end
