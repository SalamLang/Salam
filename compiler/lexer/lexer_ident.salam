package lexer

import str

include tok "../token.salam"
include lp "../langpack.salam"

k_lx_spaced_head := "اندازه"
k_lx_spaced_tail := "مثبت"
k_lx_spaced_name := "اندازه مثبت"
k_lx_spaced_in := "درون"
k_lx_spaced_out := "برون"

func is_haraka(b1: int): bool:
    ret (b1 >= 139 and b1 <= 146) or b1 == 176
end

func norm_ident(text: str): str:
    n := text.len()
    mut need := false
    mut i := 0
    until i < n:
        b0 := byte_at(text, i)
        if b0 == 226 and byte_at(text, i + 1) == 128 and byte_at(text, i + 2) == 140:
            need = true
            break
        end
        if b0 == 217 and (byte_at(text, i + 1) == 138 or byte_at(text, i + 1) == 131 or is_haraka(byte_at(text, i + 1))):
            need = true
            break
        end
        i += 1
    end
    if not need:
        ret text
    end
    mut out := str.NewBuilder()
    i = 0
    until i < n:
        c0 := byte_at(text, i)
        c1 := byte_at(text, i + 1)
        if c0 == 226 and c1 == 128 and byte_at(text, i + 2) == 140:
            str.BufAppendChar(out, 32)
            i += 3
        else c0 == 217 and c1 == 138:
            str.BufAppend(out, "\xDB\x8C")
            i += 2
        else c0 == 217 and c1 == 131:
            str.BufAppend(out, "\xDA\xA9")
            i += 2
        else c0 == 217 and is_haraka(c1):
            i += 2
        else:
            str.BufAppendChar(out, c0)
            i += 1
        end
    end
    r := str.BufStr(out)
    str.BufFree(out)
    ret r
end

func spaced_keyword_end(L &: Lx, k: int, raw: str): int:
    if k != tok.TK_KW_FALSE and k != tok.TK_LT and k != tok.TK_GT and not (k == tok.TK_IDENT and (str.Equals(raw, k_lx_spaced_in) or str.Equals(raw, k_lx_spaced_out))):
        ret 0
    end
    mut j := 0
    until L.pos + j < L.n and byte_at(L.s, L.pos + j) == 32:
        j += 1
    end
    if j == 0 or L.pos + j >= L.n or not is_ident_start(byte_at(L.s, L.pos + j)):
        ret 0
    end
    mut e := L.pos + j
    until e < L.n and is_ident_cont(byte_at(L.s, e)):
        e += 1
    end
    ret e
end

func spaced_name_end(L &: Lx, raw: str): int:
    if not str.Equals(norm_ident(raw), k_lx_spaced_head):
        ret 0
    end
    mut j := 0
    until L.pos + j < L.n and byte_at(L.s, L.pos + j) == 32:
        j += 1
    end
    if j == 0:
        ret 0
    end
    tl := k_lx_spaced_tail.len()
    e := L.pos + j + tl
    if e > L.n or not str.Equals(str.SubstrIn(L.s, L.pos + j, tl), k_lx_spaced_tail):
        ret 0
    end
    if e < L.n and is_ident_cont(byte_at(L.s, e)):
        punct := byte_at(L.s, e) == 216 and e + 1 < L.n and (byte_at(L.s, e + 1) == 140 or byte_at(L.s, e + 1) == 159)
        if not punct:
            ret 0
        end
    end
    ret e
end

func input_starts_name(L &: Lx): bool:
    mut j := 0
    until L.pos + j < L.n and byte_at(L.s, L.pos + j) == 32:
        j += 1
    end
    if j == 0 or L.pos + j >= L.n or not is_ident_start(byte_at(L.s, L.pos + j)) or at_digit(L, j) > 0:
        ret false
    end
    mut e := L.pos + j
    until e < L.n and is_ident_cont(byte_at(L.s, e)):
        e += 1
    end
    word := str.SubstrIn(L.s, L.pos + j, e - L.pos - j)
    ret lp.LookupKeywordIn(L.pack, word, false) == tok.TK_IDENT
end

func lx_at_value_end(L &: Lx): bool:
    if not L.has_last:
        ret false
    end
    k := L.last
    ret k == tok.TK_INT or k == tok.TK_FLOAT or k == tok.TK_STRING or k == tok.TK_TRIPLE_STRING or k == tok.TK_RAW_STRING or k == tok.TK_CHAR or k == tok.TK_UTF8_CHAR or k == tok.TK_IDENT or k == tok.TK_RPAREN or k == tok.TK_RBRACKET or k == tok.TK_KW_TRUE or k == tok.TK_KW_FALSE or k == tok.TK_KW_NULL or k == tok.TK_KW_THIS
end

func scan_ident(L &: Lx):
    start := L.pos
    b := lx_pos(L)
    skip_ident(L)
    mut raw := lex_intern(L, start)
    mut k := lp.LookupKeywordIn(L.pack, raw, lx_at_value_end(L))
    if k == tok.TK_KW_INPUT and input_starts_name(L):
        k = tok.TK_IDENT
    end
    e := spaced_keyword_end(L, k, raw)
    if e > 0:
        cand := str.SubstrIn(L.s, start, e - start)
        k2 := lp.LookupKeywordIn(L.pack, cand, false)
        if k2 == tok.TK_KW_PRINTERR or k2 == tok.TK_KW_PRINTERRLN or k2 == tok.TK_KW_EXTERN or k2 == tok.TK_KW_EXPORT or (k == tok.TK_LT and k2 == tok.TK_LE) or (k == tok.TK_GT and k2 == tok.TK_GE):
            k = k2
            repeat e - L.pos:
                adv(L)
            end
            raw = lex_intern(L, start)
        end
    end
    mut spaced := false
    if k == tok.TK_IDENT:
        se := spaced_name_end(L, raw)
        if se > 0:
            repeat se - L.pos:
                adv(L)
            end
            raw = lex_intern(L, start)
            spaced = true
        end
    end
    mut text := raw
    if spaced and not L.keep_comments:
        text = k_lx_spaced_name
    else k == tok.TK_IDENT and not L.keep_comments:
        canon := lp.CanonWord(L.pack, raw)
        text = canon.len() > 0 ? canon : norm_ident(raw)
    end
    if k == tok.TK_KW_TRUE or k == tok.TK_KW_FALSE:
        emit_val(L, k, b, text, tok.ValueBool(k == tok.TK_KW_TRUE))
    else:
        emit(L, k, b, text)
    end
    if k == tok.TK_KW_COMPONENT:
        L.comp_header = true
    end
end

func scan_meta(L &: Lx):
    b := lx_pos(L)
    adv(L)
    start := L.pos
    skip_ident(L)
    mut name := lex_intern(L, start)
    if not L.keep_comments:
        canon := lp.CanonWord(L.pack, name)
        if canon.len() > 0:
            name = canon
        end
    end
    emit(L, tok.TK_META, b, name)
end
