package lexer

import str
import tok "../token.salam"
import lp "../langpack.salam"

func norm_ident(text: str): str:
    n := text.len()
    mut need := false
    mut i := 0
    until i < n:
        b0 := byte_at(text, i)
        if b0 == 226 && byte_at(text, i + 1) == 128 && byte_at(text, i + 2) == 140:
            need = true
            break
        end
        if b0 == 217 && (byte_at(text, i + 1) == 138 || byte_at(text, i + 1) == 131):
            need = true
            break
        end
        i += 1
    end
    if !need:
        ret text
    end
    mut out := str.NewBuilder()
    i = 0
    until i < n:
        c0 := byte_at(text, i)
        c1 := byte_at(text, i + 1)
        if c0 == 226 && c1 == 128 && byte_at(text, i + 2) == 140:
            str.BufAppendChar(out, 32)
            i += 3
        else c0 == 217 && c1 == 138:
            str.BufAppend(out, "\xDB\x8C")
            i += 2
        else c0 == 217 && c1 == 131:
            str.BufAppend(out, "\xDA\xA9")
            i += 2
        else:
            str.BufAppendChar(out, c0)
            i += 1
        end
    end
    r := str.BufStr(out)
    str.BufFree(out)
    ret r
end

func spaced_keyword_end(L &: Lx, k: int): int:
    if k != tok.TK_KW_FALSE:
        ret 0
    end
    mut j := 0
    until L.pos + j < L.n && byte_at(L.s, L.pos + j) == 32:
        j += 1
    end
    if j == 0 || L.pos + j >= L.n || !is_ident_start(byte_at(L.s, L.pos + j)):
        ret 0
    end
    mut e := L.pos + j
    until e < L.n && is_ident_cont(byte_at(L.s, e)):
        e += 1
    end
    ret e
end

func input_starts_name(L &: Lx): bool:
    mut j := 0
    until L.pos + j < L.n && byte_at(L.s, L.pos + j) == 32:
        j += 1
    end
    if j == 0 || L.pos + j >= L.n || !is_ident_start(byte_at(L.s, L.pos + j)):
        ret false
    end
    mut e := L.pos + j
    until e < L.n && is_ident_cont(byte_at(L.s, e)):
        e += 1
    end
    word := str.SubstrIn(L.s, L.pos + j, e - L.pos - j)
    ret lp.LookupKeywordIn(L.pack, word, false) == tok.TK_IDENT
end

func lx_at_value_end(L &: Lx): bool:
    if !L.has_last:
        ret false
    end
    k := L.last
    ret k == tok.TK_INT || k == tok.TK_FLOAT || k == tok.TK_STRING || k == tok.TK_TRIPLE_STRING || k == tok.TK_RAW_STRING || k == tok.TK_CHAR || k == tok.TK_UTF8_CHAR || k == tok.TK_IDENT || k == tok.TK_RPAREN || k == tok.TK_RBRACKET || k == tok.TK_KW_TRUE || k == tok.TK_KW_FALSE || k == tok.TK_KW_NULL || k == tok.TK_KW_THIS
end

func scan_ident(L &: Lx):
    start := L.pos
    b := lx_pos(L)
    skip_ident(L)
    mut raw := lex_slice(L, start)
    mut k := lp.LookupKeywordIn(L.pack, raw, lx_at_value_end(L))
    if k == tok.TK_KW_INPUT && input_starts_name(L):
        k = tok.TK_IDENT
    end
    e := spaced_keyword_end(L, k)
    if e > 0:
        cand := str.SubstrIn(L.s, start, e - start)
        k2 := lp.LookupKeywordIn(L.pack, cand, false)
        if k2 == tok.TK_KW_PRINTERR || k2 == tok.TK_KW_PRINTERRLN:
            k = k2
            repeat e - L.pos:
                adv(L)
            end
            raw = lex_slice(L, start)
        end
    end
    mut text := raw
    if k == tok.TK_IDENT && !L.keep_comments:
        canon := lp.CanonWord(L.pack, raw)
        text = canon.len() > 0 ? canon : norm_ident(raw)
    end
    if k == tok.TK_KW_TRUE || k == tok.TK_KW_FALSE:
        emit_val(L, k, b, text, tok.ValueBool(k == tok.TK_KW_TRUE))
    else:
        emit(L, k, b, text)
    end
    if k == tok.TK_KW_COMPONENT:
        L.comp_header = true
    end
end

func scan_meta(L &: Lx):
    b := lx_pos(L)
    adv(L)
    start := L.pos
    skip_ident(L)
    mut name := lex_slice(L, start)
    if !L.keep_comments:
        canon := lp.CanonWord(L.pack, name)
        if canon.len() > 0:
            name = canon
        end
    end
    emit(L, tok.TK_META, b, name)
end
