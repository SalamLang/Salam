// Flat merge of the salam/llvm port (see salam/PORTING.md "Layout - FLAT"):
// compiler/src/llvm/ - one package `llvm`, one file. Import alias for
// consumers: `lv`. The backend's expr/stmt emitters are mutually recursive
// with everything else, so the module is ported by three sequential agents
// INTO THIS ONE FILE:
//
//   A (DONE): codegen_llvm_internal.h (ll_t state + inline helpers),
//       codegen_llvm_emit.c (emit context, string constants, locals),
//       codegen_llvm_type.c (LLVM type strings, layouts, symbol lookups,
//       conversions), codegen_llvm_decl.c (struct types, mangling,
//       function/lambda frames, vtables, variant boxing, globals, externs,
//       package touch), codegen_llvm.c (datalayout/prologue/on-demand
//       runtime helpers/toplevel/run), PLUS two slices other stages must
//       NOT re-port: ll_emit_defers + ll_emit_return from
//       codegen_llvm_stmt.c (the function frame needs them) and ALL of
//       codegen_llvm_debug.c (run/function frames call the DI hooks).
//   B (DONE): codegen_llvm_expr.c and the REST of codegen_llvm_stmt.c
//       (ll_stmt/ll_block/ll_block_top and every static in both files:
//       ll_binary, ll_addr_of, ll_index_set, ll_match_arm_cond, ll_call*,
//       ll_lower_print, ll_literal, ll_struct_lit, ...). Replace the three
//       stubs at the marked insertion banner IN PLACE (lv_expr,
//       lv_block_top, lv_stmt) and add the remaining functions as new
//       privates in the same section. Do NOT re-port emit_defers,
//       emit_return, emit_lambda, box_dyn/box_variant/unwrap_variant,
//       conv/as_i1/common_ts, pick_overload, strconst, local_* - stage A
//       owns them.
//   C (DONE): native toolchain glue, replacing the NativeAvailable/NativeRun
//       stubs. DEVIATION (deliberate): llvm_native.c's real body only
//       exists behind `#ifdef SALAM_HAVE_LLVM` (the LLVM-C API) - the same
//       flag this repo's own reference binary builds WITHOUT (that's why
//       the pre-C-stage NativeAvailable stub already returned `false`,
//       mirroring the `#else` branch exactly). Binding the ~30-function
//       LLVM-C surface (opaque context/module/target-machine handles, the
//       ORC/LLJIT API for LLVM_OUT_JIT, ...) via `extern:` is out of scope
//       for a toolchain-glue port and unreachable in every build this repo
//       ships. What IS reachable, and what stage B's own reference-binary
//       log line ("native: clang %s -lm -o %s") already showed running,
//       is driver/llvm_toolchain.c's `salam_llvm_toolchain` - the
//       always-available fallback that shells out to `clang`/`opt`/`lli`
//       directly on the .ll text via a generated bash script (its
//       LLVM_OUT_EXEC case IS the observed `clang *.ll -lm -o <exe>`
//       convention, and its LLVM_OUT_ASM/OBJ/BITCODE/JIT/IR cases are
//       ported too). So NativeRun ports `salam_llvm_toolchain` +
//       `emit_tool_cmd` (private `nt_*` helpers below), and NativeAvailable
//       becomes a real "is a clang toolchain reachable" probe (bundled
//       tool via sm.FindBundledTool, else a PATH `--version` check) instead
//       of the C's compile-time `#ifdef` - matching what NativeAvailable is
//       actually FOR in this port (gating whether NativeRun can do
//       anything). A new pub `NativeBuildScript(ll_path, opts): str` exposes
//       the generated script text so llvm_test.salam can assert the exact
//       command line NativeRun would run without requiring a real
//       toolchain. `nt_to_tool_path`'s Windows branch (drive-letter ->
//       `/mnt/x` for `wsl.exe -e bash`) skips the C's `_fullpath`
//       resolve-to-absolute step (no equivalent Salam stdlib call) - a
//       relative path is passed through unresolved; harmless here since
//       every caller in this port already supplies a resolved-enough path
//       and the branch is compile-time-pruned out entirely on the
//       Linux/WSL builds this port is verified against (SALAM_OS_WINDOWS
//       false), same as `target_is_windows_of`'s pre-existing host-OS
//       fallback a few hundred lines up. llvm_native.c's own
//       `native_link_elf`/`native_link_mingw` in-process-lld path
//       (SALAM_HAVE_LLD) is likewise unreachable without SALAM_HAVE_LLVM
//       and is not ported; lld_link.cc has no Salam-reachable behavior of
//       its own (it's a thin LLD-library wrapper called only from there).
//
// C -> Salam decisions for this module (B/C must inherit these):
// - ll_t -> `pub struct Lv` (all fields pub - E017). sema_result_t *sem is
//   NOT stored: thread `s &: sm.Sema` and `a &: at.Ast` through every
//   function that needs them; parameter order is (v, s, a, ...), exactly
//   like the codegen port's (g, s, a, ...).
// - arena_t* and ll_fmt(...) are GONE: strings are values; call sites build
//   text with `+` / co.I64Toa / co.U64Toa. NO co.Format in this module - //   IR text must be byte-exact, so everything is explicit concatenation.
// - "" is the C NULL for every str field/return (ts, ret_ts, this_ref,
//   self_ts, cur_sp, cur_dbg, first_error, triple, env_ref, ...); 0 is the
//   C NULL for every id (NodeId/SymId/SigId/ScopeId); local_find /
//   global_find return an INDEX into v.locals / v.globals, -1 = C NULL.
// - sb_t *g/b/allocas/hg/meta -> five str.StringBuilder fields bg (module
//   text), bb (current function body), ba (current allocas), bhg
//   (on-demand helpers), bmeta (debug metadata). The C pointer swap
//   `ll->b = &body` becomes: in_fn=true selects bb for out_b()/emit();
//   emit_function/emit_lambda SAVE the builder HEADERS (StringBuilder is a
//   {data,len,cap} value), install fresh builders, and restore after
//   appending header+entry+allocas+body to bg - byte-identical nesting
//   (inner ensure_fn'd functions land in bg before their caller, like C).
//   NEVER alias two live builders; only header save/restore is safe.
// - Value numbering: v.tmp -> "%t<N>" (new_tmp), v.lbl -> "L<N>_<tag>"
//   (new_lbl), both reset to 0 per function/lambda and saved/restored
//   around nested emission. conv() allocates its tmp AT THE SAME POINT the
//   C does (after the dyn-box check, before the int/int fast path), so
//   numbering matches even when the tmp goes unused.
// - String constants: v.strings is a Vector<LvStr> {bytes,len,hash,gref};
//   dedup by FNV-1 hash (the C's exact constants, incl. the truncated
//   0x14650FB0739D0383 offset basis) + length + bytes; gref = "@.str.<i>".
// - const char *brk[64]/cont[64] -> Vector<str> brk/cont + nloop. B's loop
//   protocol: on loop entry, if v.brk.len() == v.nloop push, else set
//   (v.nloop indexes; slots are reused exactly like the C array); the
//   64-deep clamp ("loop nesting too deep") stays.
// - bool hneed[LL_H_COUNT] -> Vector<bool> seeded by new_lv0(); the
//   LL_HELPER_EMIT function-pointer table is an if/else chain in need().
// - ll_t.ok/first_error replace the C error protocol unchanged; lv_error
//   clamps the message at 255 bytes (the C's vsnprintf buf[256]).
// - Host-dependent defaults (ll_datalayout(NULL), ll_target_ptr_bits(NULL),
//   ll_target_is_windows(NULL)) use compile-time SALAM_ARCH_*/SALAM_OS_*
//   conditionals mirroring the C's #if chains.
// - codegen_llvm.h's codegen_llvm_options_t -> pub struct Options
//   (OptionsDefault() = codegen_llvm_options_default; the C NULL opts ==
//   OptionsDefault()). llvm_output_t -> pub struct Output (field `module`
//   -> module_name like the codegen port; `error` keeps its name).
//   link_libs/link_kinds (const char *const * + nlink) -> Vector<str> x2 +
//   nlink, consumed by stage C.
// - salam_module_single_threaded comes from the codegen port
//   (cg.ModuleSingleThreaded), mirroring the C #include "codegen/codegen.h".
package llvm

import str
import os
import co "sal_core.salam"
import tok "token.salam"
import at "ast.salam"
import lg "logger.salam"
import i18 "i18n.salam"
import sm "semantic.salam"
import cg "codegen.salam"

// ===== codegen_llvm.h =====
// llvm_opt_level_t - order and values MUST stay identical to the C enum.
pub const LV_OPT_O0 := 0
pub const LV_OPT_O1 := 1
pub const LV_OPT_O2 := 2
pub const LV_OPT_O3 := 3
pub const LV_OPT_OS := 4
pub const LV_OPT_OZ := 5

// llvm_output_mode_t
pub const LV_OUT_IR := 0
pub const LV_OUT_ASM := 1
pub const LV_OUT_OBJ := 2
pub const LV_OUT_BITCODE := 3
pub const LV_OUT_EXEC := 4
pub const LV_OUT_JIT := 5

// ===== codegen_llvm_internal.h =====
// ll_helper_t
pub const LV_H_SUBSTR := 0
pub const LV_H_STRCAT := 1
pub const LV_H_ISWS := 2
pub const LV_H_TRIM := 3
pub const LV_H_STRHASH := 4
pub const LV_H_INTHASH := 5
pub const LV_H_I64STR := 6
pub const LV_H_U64STR := 7
pub const LV_H_F64STR := 8
pub const LV_H_CHARSTR := 9
pub const LV_H_OUTBUF := 10
pub const LV_H_REPEAT := 11
pub const LV_H_UPPER := 12
pub const LV_H_LOWER := 13
pub const LV_H_COUNT := 14

// ll_target_ptr_bits' w64[]/w16[]/w32[] (codegen_llvm_type.c), order kept.
k_lv_w64 := [
    "x86_64", "amd64", "aarch64", "arm64", "riscv64", "wasm64", "powerpc64", "ppc64", "mips64", "sparc64",
    "s390x", "loongarch64"
] as str[12]

// Real LLVM backends with a 16-bit pointer datalayout (p:16). Checked before
// w32 so "avr"/"msp430" triples don't fall into a generic bucket.
k_lv_w16 := ["msp430", "avr"] as str[2]

k_lv_w32 := [
    "i386", "i486", "i586", "i686", "wasm32", "armv6", "armv7", "armv5", "thumb", "mipsel", "mips", "riscv32",
    "powerpc", "ppc", "arm"
] as str[15]

// ll_is_int's ints[] / ll_is_signed's uns[] (order kept).
k_lv_ints := [
    "bool", "char", "i8", "i16", "i32", "i64", "u8", "u16", "u32", "u64", "size"
] as str[11]

k_lv_uns := ["u8", "u16", "u32", "u64", "size"] as str[5]

// ll_extern_seen's prologue[] (codegen_llvm_decl.c), order kept.
k_lv_prologue_externs := [
    "printf", "dprintf", "strlen", "strcmp", "malloc", "memcpy", "realloc", "free", "memmove", "abort",
    "exit", "snprintf", "strtol", "strtod", "strstr", "write"
] as str[16]

// codegen_llvm_run_opts' rt_essentials[].
k_lv_rt_essentials := ["salam_panic", "salam_idx"] as str[2]

// ===== codegen_llvm.h =====
// codegen_llvm_options_t. The C NULL opts pointer == OptionsDefault().
pub struct Options:
    pub opt_level: int = 0
    pub debug_info: bool = false
    pub verify_module: bool = false
    pub native_cpu: bool = false
    pub output_mode: int = 0
    pub output_file: str = ""
    pub target_triple: str = ""
    pub link_libs: Vector<str> = Vector {} // consumed by NativeRun (-l/-framework/etc.)
    pub link_kinds: Vector<str> = Vector {} // "" | "framework" | "static", parallel to link_libs
    pub nlink: int = 0
    pub sysroot: str = ""
end

// llvm_output_t. C field `module` -> module_name (codegen-port convention).
pub struct Output:
    pub module_name: str = ""
    pub ll_src: str = ""
    pub ok: bool = false
    pub error: str = ""
end

// ===== codegen_llvm_internal.h =====
// llv_t - an emitted value: SSA/constant text + Salam typestring.
pub struct Llv:
    pub ref: str = ""
    pub ts: str = ""
end

// ll_addr_t - an address: pointer text + pointee typestring.
pub struct LvAddr:
    pub ptr: str = ""
    pub ts: str = ""
end

// lvar_t - a named local/global slot.
pub struct LvVar:
    pub name: str = ""
    pub ptr: str = ""
    pub ts: str = ""
end

// lstr_t - an interned string constant.
pub struct LvStr:
    pub bytes: str = ""
    pub len: int = 0
    pub hash: u64 = 0 as u64
    pub gref: str = ""
end

// ll_t (see the file header for every representation change).
// Always create through NewLv()/new_lv0() - a bare `Lv {}` lacks hneed.
pub struct Lv:
    pub log: lg.Logger = lg.New(2, false)
    pub module: str = ""
    pub entry: str = ""
    pub bg: str.StringBuilder = str.NewBuilder() // sb_t *g
    pub bb: str.StringBuilder = str.NewBuilder() // sb_t *b (function body)
    pub ba: str.StringBuilder = str.NewBuilder() // sb_t *allocas
    pub bhg: str.StringBuilder = str.NewBuilder() // sb_t *hg
    pub bmeta: str.StringBuilder = str.NewBuilder() // sb_t *meta
    pub in_fn: bool = false // C: ll->b == &body / ll->allocas != NULL
    pub tmp: int = 0
    pub lbl: int = 0
    pub term: bool = false
    pub locals: Vector<LvVar> = Vector {}
    pub strings: Vector<LvStr> = Vector {}
    pub ret_ts: str = ""
    pub is_main: bool = false
    pub brk: Vector<str> = Vector {} // const char *brk[64] (see header)
    pub cont: Vector<str> = Vector {} // const char *cont[64]
    pub nloop: int = 0
    pub defers: Vector<int> = Vector {} // at.NodeIds of deferred stmts
    pub self_ts: str = ""
    pub this_ref: str = ""
    pub self_byval: bool = false
    pub globals: Vector<LvVar> = Vector {}
    pub gdefer: Vector<int> = Vector {} // at.NodeIds of runtime-init decls
    pub extern_names: Vector<str> = Vector {}
    pub pkg_scope: int = 0 // sm ScopeId (0 = C NULL)
    pub emitted: Vector<str> = Vector {}
    pub pkg_touched: Vector<int> = Vector {} // sm SymIds
    pub cur_lambda: int = 0 // at.NodeId (0 = C NULL)
    pub env_ref: str = ""
    pub env_ty: str = ""
    pub lam_n: int = 0
    pub ok: bool = false
    pub first_error: str = ""
    pub debug: bool = false
    pub meta_n: int = 0
    pub di_file: str = ""
    pub di_cu: str = ""
    pub di_subty: str = ""
    pub cur_sp: str = ""
    pub cur_dbg: str = ""
    pub di_flag_dwarf: str = ""
    pub di_flag_debug: str = ""
    pub src_file: str = ""
    pub src_dir: str = ""
    pub triple: str = ""
    pub usize: str = ""
    pub ptr_bits: int = 0
    pub optsize: bool = false
    pub minsize: bool = false
    pub single_threaded: bool = false
    pub hneed: Vector<bool> = Vector {}
    pub match_result_ptr: str = ""
    pub match_result_ts: str = ""
    pub match_merge_block: str = ""
end

// ---------------------------------------------------------------------------
// Low-level shared helpers (no direct C equivalent).
// ---------------------------------------------------------------------------

// Unsigned byte read from a str (same idiom as the other ports).
func byte_at(sx: str, i: int): int:
    bp := (sx as void*) as i8*
    mut vb := bp[i] as int
    if vb < 0:
        vb += 256
    end
    ret vb
end

// isdigit / isalnum on a byte (C default locale: ASCII only).
func is_digit_b(c: int): bool:
    ret c >= 48 && c <= 57
end

func is_alnum_b(c: int): bool:
    ret (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122)
end

// isalpha on a byte (used by nt_to_tool_path's drive-letter detection).
func is_alpha_b(c: int): bool:
    ret (c >= 65 && c <= 90) || (c >= 97 && c <= 122)
end

// "%02x" / "%02X" of a byte.
func hex2_lower(c: int): str:
    d := "0123456789abcdef"
    ret str.Substr(d, (c / 16) % 16, 1) + str.Substr(d, c % 16, 1)
end

func hex2_upper(c: int): str:
    d := "0123456789ABCDEF"
    ret str.Substr(d, (c / 16) % 16, 1) + str.Substr(d, c % 16, 1)
end

// First index of byte `want` in sx, -1 if absent (C strchr).
func idx_byte(sx: str, want: int): int:
    n := str.Len(sx)
    mut i := 0
    until i < n:
        if byte_at(sx, i) == want:
            ret i
        end
        i += 1
    end
    ret 0 - 1
end

// Last index of byte `want` in sx, -1 if absent (C strrchr).
func last_byte(sx: str, want: int): int:
    mut i := str.Len(sx) - 1
    until i >= 0:
        if byte_at(sx, i) == want:
            ret i
        end
        i -= 1
    end
    ret 0 - 1
end

// The C's vsnprintf(buf[256], ...) clamp in ll_error.
func clamp255(msg: str): str:
    if str.Len(msg) > 255:
        ret str.Substr(msg, 0, 255)
    end
    ret msg
end

// Builder sinks. out_g = sb_puts(ll->g, ...); out_b = sb_puts(ll->b, ...)
// (the C b pointer: body inside a function, g at the top level).
func out_g(v &: Lv, sx: str):
    co.SbPuts(v.bg, sx)
end

func out_b(v &: Lv, sx: str):
    if v.in_fn:
        co.SbPuts(v.bb, sx)
    else:
        co.SbPuts(v.bg, sx)
    end
end

func out_hg(v &: Lv, sx: str):
    co.SbPuts(v.bhg, sx)
end

func out_meta(v &: Lv, sx: str):
    co.SbPuts(v.bmeta, sx)
end

// sb_t *dst = ll->allocas ? ll->allocas : ll->b;
func out_al(v &: Lv, sx: str):
    if v.in_fn:
        co.SbPuts(v.ba, sx)
    else:
        out_b(v, sx)
    end
end

// Lv construction/teardown (RunOpts' memset + vec_init block).
func new_lv0(): Lv:
    mut v := Lv {}
    v.locals = Vector {} as Vector<LvVar>
    v.strings = Vector {} as Vector<LvStr>
    v.brk = Vector {} as Vector<str>
    v.cont = Vector {} as Vector<str>
    v.defers = Vector {} as Vector<int>
    v.globals = Vector {} as Vector<LvVar>
    v.gdefer = Vector {} as Vector<int>
    v.extern_names = Vector {} as Vector<str>
    v.emitted = Vector {} as Vector<str>
    v.pkg_touched = Vector {} as Vector<int>
    v.hneed = Vector {} as Vector<bool>
    repeat LV_H_COUNT with hi:
        _hi := hi
        v.hneed.push(false)
    end
    ret v
end

func free_lv(v &: Lv):
    str.BufFree(v.bg)
    str.BufFree(v.bb)
    str.BufFree(v.ba)
    str.BufFree(v.bhg)
    str.BufFree(v.bmeta)
    v.locals.free()
    v.strings.free()
    v.brk.free()
    v.cont.free()
    v.defers.free()
    v.globals.free()
    v.gdefer.free()
    v.extern_names.free()
    v.emitted.free()
    v.pkg_touched.free()
    v.hneed.free()
end

// ===== codegen_llvm_internal.h (SAL_INLINE helpers) =====

// ll_is_str
func is_str(ts: str): bool:
    ret str.Equals(ts, "str") || str.Equals(ts, "uchar")
end

// ll_is_bool
func is_bool(ts: str): bool:
    ret str.Equals(ts, "bool")
end

// ll_is_float
func is_float(ts: str): bool:
    ret str.Equals(ts, "f32") || str.Equals(ts, "f64")
end

// ll_is_ptr_ts
func is_ptr_ts(ts: str): bool:
    n := str.Len(ts)
    ret n > 0 && byte_at(ts, n - 1) == 42
end

// ll_poison
func poison(ts: str): Llv:
    mut r := Llv {}
    r.ref = "0"
    r.ts = str.Len(ts) > 0 ? ts : "i32"
    ret r
end

func make_llv(ref2: str, ts: str): Llv:
    mut r := Llv {}
    r.ref = ref2
    r.ts = ts
    ret r
end

// ===== codegen_llvm_emit.c =====

// ll_safe_name
func safe_name(raw: str): str:
    if str.Len(raw) == 0:
        ret "_"
    end
    n := str.Len(raw)
    mut needs_fix := false
    mut i := 0
    until i < n && !needs_fix:
        c := byte_at(raw, i)
        okc := is_alnum_b(c) || c == 95 || c == 46 || c == 36
        if !okc:
            needs_fix = true
        end
        i += 1
    end
    if !needs_fix:
        ret raw
    end
    mut b := co.SbNew()
    mut j := 0
    until j < n:
        c2 := byte_at(raw, j)
        okc2 := is_alnum_b(c2) || c2 == 95 || c2 == 46 || c2 == 36
        if okc2:
            co.SbPutc(b, c2)
        else:
            co.SbPutc(b, 95)
        end
        j += 1
    end
    r := co.SbCstr(b)
    co.SbFree(b)
    ret r
end

// ll_attach_dbg - returns the ", !dbg !N" suffix instead of writing it.
func dbg_suffix(v &: Lv): str:
    if v.debug && str.Len(v.cur_dbg) > 0:
        ret ", !dbg " + v.cur_dbg
    end
    ret ""
end

// ll_emit - one two-space-indented instruction on the current body sink.
func emit(v &: Lv, text: str):
    if v.term:
        ret
    end
    out_b(v, "  " + text + dbg_suffix(v) + "\n")
end

// ll_emit_alloca - no term gate, no !dbg, goes to the allocas sink.
func emit_alloca(v &: Lv, text: str):
    out_al(v, "  " + text + "\n")
end

// ll_emit_label
func emit_label(v &: Lv, label: str):
    out_b(v, label + ":\n")
    v.term = false
end

// ll_emit_term
func emit_term(v &: Lv, text: str):
    if v.term:
        ret
    end
    out_b(v, "  " + text + dbg_suffix(v) + "\n")
    v.term = true
end

// ll_new_tmp
func new_tmp(v &: Lv): str:
    r := "%t" + co.I64Toa(v.tmp as i64)
    v.tmp += 1
    ret r
end

// ll_new_lbl
func new_lbl(v &: Lv, tag: str): str:
    r := "L" + co.I64Toa(v.lbl as i64) + "_" + tag
    v.lbl += 1
    ret r
end

// ll_error - message pre-formatted at the call site, clamped like the C's
// char buf[256].
func lv_error(v &: Lv, a &: at.Ast, n: int, msg: str):
    v.ok = false
    body := clamp255(msg)
    mut full := "LLVM backend: " + body
    if n != 0:
        nd := at.Get(a, n)
        if nd.begin_line != (0 as u32):
            full = "LLVM backend (line " + co.U64Toa(nd.begin_line as u64) + "): " + body
        end
    end
    if str.Len(v.first_error) == 0:
        v.first_error = full
    end
    lg.Log(v.log, lg.PH_CODEGEN, lg.LOG_ERROR, full)
end

// ll_escape - IR c"..." payload; arr_len = byte length + 1 (the \00).
func escape_bytes(sx: str, arr_len &: int):
    // (split: see escape_text; ref-returning a pair is clumsy - the two
    //  outputs are produced by escape_text + this length rule)
    arr_len = str.Len(sx) + 1
end

func escape_text(sx: str): str:
    n := str.Len(sx)
    mut b := co.SbNew()
    mut i := 0
    until i < n:
        c := byte_at(sx, i)
        if c == 34 || c == 92 || c < 32 || c > 126:
            co.SbPuts(b, "\\" + hex2_upper(c))
        else:
            co.SbPutc(b, c)
        end
        i += 1
    end
    co.SbPuts(b, "\\00")
    r := co.SbCstr(b)
    co.SbFree(b)
    ret r
end

// ll_str_hash - FNV-1a 64-bit, matching the C's ll_str_hash on 64-bit hosts
// (offset basis 14695981039346656037 = 0xCBF29CE484222325).
func str_hash(sx: str): u64:
    mut h := 0xCBF29CE484222325 as u64
    n := str.Len(sx)
    mut i := 0
    until i < n:
        h ^= byte_at(sx, i) as u64
        h *= 0x100000001B3 as u64
        i += 1
    end
    ret h
end

// ll_strconst - dedup + emit "@.str.N = private unnamed_addr constant ...".
func strconst(v &: Lv, sx: str): str:
    n := str.Len(sx)
    h := str_hash(sx)
    repeat v.strings.len() with i:
        e := v.strings.get(i)[0]
        if e.hash == h && e.len == n && str.Equals(e.bytes, sx):
            ret e.gref
        end
    end
    mut arr := 0
    escape_bytes(sx, arr)
    esc := escape_text(sx)
    gref := "@.str." + co.I64Toa(v.strings.len() as i64)
    out_g(
        v, gref + " = private unnamed_addr constant [" + co.I64Toa(arr as i64) + " x i8] c\"" + esc + "\"\n"
    )
    mut e2 := LvStr {}
    e2.bytes = sx
    e2.len = n
    e2.hash = h
    e2.gref = gref
    v.strings.push(e2)
    ret gref
end

// ll_local_add
func local_add(v &: Lv, name: str, ptr2: str, ts: str):
    mut lvv := LvVar {}
    lvv.name = name
    lvv.ptr = ptr2
    lvv.ts = ts
    v.locals.push(lvv)
end

// ll_local_find - newest-first scan; returns index into v.locals, -1 = NULL.
func local_find(v &: Lv, name: str): int:
    mut i := v.locals.len()
    until i > 0:
        if str.Equals(v.locals.get(i - 1)[0].name, name):
            ret i - 1
        end
        i -= 1
    end
    ret 0 - 1
end

// ll_global_find - returns index into v.globals, -1 = NULL.
func global_find(v &: Lv, name: str): int:
    repeat v.globals.len() with i:
        if str.Equals(v.globals.get(i)[0].name, name):
            ret i
        end
    end
    ret 0 - 1
end

// ===== codegen_llvm_type.c =====

// ll_int_bits ("" = the C NULL -> 32)
func int_bits(v &: Lv, ts: str): int:
    if str.Equals(ts, "bool"):
        ret 1
    end
    if str.Equals(ts, "char") || str.Equals(ts, "i8") || str.Equals(ts, "u8"):
        ret 8
    end
    if str.Equals(ts, "i16") || str.Equals(ts, "u16"):
        ret 16
    end
    if str.Equals(ts, "i32") || str.Equals(ts, "u32"):
        ret 32
    end
    if str.Equals(ts, "i64") || str.Equals(ts, "u64"):
        ret 64
    end
    if str.Equals(ts, "size"):
        ret v.ptr_bits
    end
    ret 32
end

// Host pointer width - the C's sizeof(void *) * 8 at compile time.
func host_ptr_bits(): int:
    if SALAM_ARCH_X64 || SALAM_ARCH_ARM64:
        ret 64
    else:
        ret 32
    end
end

// ll_target_ptr_bits
func target_ptr_bits_of(triple: str): int:
    if str.Len(triple) == 0:
        ret host_ptr_bits()
    end
    repeat 12 with i:
        if str.Contains(triple, k_lv_w64[i]):
            ret 64
        end
    end
    repeat 2 with k:
        if str.Contains(triple, k_lv_w16[k]):
            ret 16
        end
    end
    repeat 15 with j:
        if str.Contains(triple, k_lv_w32[j]):
            ret 32
        end
    end
    ret host_ptr_bits()
end

// ll_usize_to_i32
func usize_to_i32(v &: Lv, ref2: str): str:
    if v.ptr_bits <= 32:
        ret ref2
    end
    r := new_tmp(v)
    emit(v, r + " = trunc " + v.usize + " " + ref2 + " to i32")
    ret r
end

// ll_is_int
func is_int_ts(ts: str): bool:
    repeat 11 with i:
        if str.Equals(ts, k_lv_ints[i]):
            ret true
        end
    end
    ret false
end

// ll_is_signed ("" = the C NULL -> true)
func is_signed_ts(ts: str): bool:
    repeat 5 with i:
        if str.Equals(ts, k_lv_uns[i]):
            ret false
        end
    end
    if str.Equals(ts, "bool"):
        ret false
    end
    if str.Equals(ts, "char"):
        ret false
    end
    ret true
end

// ll_array_dim
func array_dim(ts: str): i64:
    lb := idx_byte(ts, 91)
    if lb < 0:
        ret 0 as i64
    end
    mut n := 0 as i64
    mut p := lb + 1
    sn := str.Len(ts)
    until p < sn && byte_at(ts, p) != 93:
        c := byte_at(ts, p)
        if c >= 48 && c <= 57:
            n = n * 10 + ((c - 48) as i64)
        end
        p += 1
    end
    ret n
end

// ll_array_elem
func array_elem(ts: str): str:
    lb := idx_byte(ts, 91)
    if lb < 0:
        ret ts
    end
    // C: strchr(lb, ']') - first ']' at/after lb
    n := str.Len(ts)
    mut rb := 0 - 1
    mut p := lb
    until p < n && rb < 0:
        if byte_at(ts, p) == 93:
            rb = p
        end
        p += 1
    end
    if rb < 0:
        ret ts
    end
    ret str.Substr(ts, 0, lb) + str.Substr(ts, rb + 1, n - rb - 1)
end

// ll_is_slice_ts
func is_slice(ts: str): bool:
    ret str.StartsWith(ts, "slice<")
end

// ll_slice_elem
func slice_elem(ts: str): str:
    lt := idx_byte(ts, 60)
    gt := last_byte(ts, 62)
    if lt < 0 || gt < 0 || gt <= lt:
        ret "i32"
    end
    ret str.Substr(ts, lt + 1, gt - lt - 1)
end

// ll_struct_ltype
func struct_ltype(name: str): str:
    n := str.Len(name)
    mut ascii := n > 0 && !is_digit_b(byte_at(name, 0))
    mut i := 0
    until ascii && i < n:
        if !is_alnum_b(byte_at(name, i)):
            ascii = false
        end
        i += 1
    end
    if ascii:
        ret "%struct." + name
    end
    mut b := co.SbNew()
    co.SbPuts(b, "%struct.")
    if n > 0 && is_digit_b(byte_at(name, 0)):
        co.SbPutc(b, 95)
    end
    mut j := 0
    until j < n:
        c := byte_at(name, j)
        if is_alnum_b(c):
            co.SbPutc(b, c)
        else c == 95:
            co.SbPuts(b, "__")
        else:
            co.SbPuts(b, "_" + hex2_lower(c))
        end
        j += 1
    end
    r := co.SbCstr(b)
    co.SbFree(b)
    ret r
end

// ll_variant_push_trimmed + ll_variant_members - members clamp at 64
// entries of at most 159 bytes, exactly like the C's char[64][160].
func variant_push_trimmed(ts: str, start0: int, end0: int, out2 &: Vector<str>):
    mut s0 := start0
    mut e0 := end0
    until s0 < e0 && byte_at(ts, s0) == 32:
        s0 += 1
    end
    until e0 > s0 && byte_at(ts, e0 - 1) == 32:
        e0 -= 1
    end
    if out2.len() >= 64:
        ret
    end
    mut l := e0 - s0
    if l >= 160:
        l = 159
    end
    out2.push(str.Substr(ts, s0, l))
end

func variant_members(ts: str): Vector<str>:
    mut out2 := Vector {} as Vector<str>
    lt := idx_byte(ts, 60)
    gt := last_byte(ts, 62)
    if lt < 0 || gt < 0 || gt <= lt:
        ret out2
    end
    mut start0 := lt + 1
    mut depth := 0
    mut p := start0
    until p < gt:
        c := byte_at(ts, p)
        if c == 60:
            depth += 1
        else c == 62:
            depth -= 1
        else c == 44 && depth == 0:
            variant_push_trimmed(ts, start0, p, out2)
            start0 = p + 1
        end
        p += 1
    end
    variant_push_trimmed(ts, start0, gt, out2)
    ret out2
end

// ll_variant_tag_of
func variant_tag_of(variant_ts: str, member_ts: str): int:
    mut members := variant_members(variant_ts)
    defer members.free()
    repeat members.len() with i:
        if str.Equals(members.get(i)[0], member_ts):
            ret i
        end
    end
    ret 0 - 1
end

// ll_ident_byte / ll_put_ident_byte (identical in type.c and decl.c).
func put_ident_byte(b &: str.StringBuilder, c: int):
    if is_alnum_b(c):
        co.SbPutc(b, c)
    else c == 95:
        co.SbPuts(b, "__")
    else:
        co.SbPuts(b, "_" + hex2_lower(c))
    end
end

// ll_put_ident
func put_ident(b &: str.StringBuilder, name: str):
    n := str.Len(name)
    mut i := 0
    until i < n:
        put_ident_byte(b, byte_at(name, i))
        i += 1
    end
end

// ll_encode_ts / ll_put_type_code (identical in type.c and decl.c).
func put_type_code(b &: str.StringBuilder, ts: str):
    n := str.Len(ts)
    mut i := 0
    until i < n:
        c := byte_at(ts, i)
        if c == 42:
            co.SbPuts(b, "_ptr")
        else c == 91:
            co.SbPuts(b, "_arr")
        else c == 93 || c == 32:
            // dropped
            _c := c
        else:
            put_ident_byte(b, c)
        end
        i += 1
    end
end

// ll_variant_cname
func variant_cname(ts: str): str:
    mut members := variant_members(ts)
    defer members.free()
    mut b := co.SbNew()
    co.SbPuts(b, "%_Salam_variant")
    repeat members.len() with i:
        co.SbPutc(b, 95)
        put_type_code(b, members.get(i)[0])
    end
    r := co.SbCstr(b)
    co.SbFree(b)
    ret r
end

// ll_struct_layout
func struct_layout(
    v &: Lv, s &: sm.Sema, a &: at.Ast, ts: str, out_size &: i64, out_align &: i64
):
    ssym := struct_sym(v, s, a, ts)
    mut off := 0 as i64
    mut maxalign := 1 as i64
    if ssym == 0:
        p := (v.ptr_bits / 8) as i64
        out_size = p
        out_align = p
        ret
    end
    members := sm.SymAt(s, ssym).members
    syms := sm.ScopeAt(s, members).symbols
    repeat syms.len() with j:
        f := sm.SymAt(s, syms.get(j)[0])
        if f.kind == sm.SYM_FIELD:
            mut fsz := 0 as i64
            mut fal := 0 as i64
            type_layout(v, s, a, sm.ToString(s, f.ty), fsz, fal)
            if fal < (1 as i64):
                fal = 1 as i64
            end
            if fal > maxalign:
                maxalign = fal
            end
            off = (off + fal - (1 as i64)) / fal * fal
            off += fsz
        end
    end
    off = (off + maxalign - (1 as i64)) / maxalign * maxalign
    if off == (0 as i64):
        off = 1 as i64
    end
    out_size = off
    out_align = maxalign
end

// ll_variant_layout_size
func variant_layout_size(
    v &: Lv, s &: sm.Sema, a &: at.Ast, ts: str, out_size &: i64, out_align &: i64
):
    mut members := variant_members(ts)
    defer members.free()
    mut maxsz := 1 as i64
    mut maxal := 1 as i64
    repeat members.len() with i:
        mut sz := 0 as i64
        mut al := 0 as i64
        type_layout(v, s, a, members.get(i)[0], sz, al)
        if sz > maxsz:
            maxsz = sz
        end
        if al > maxal:
            maxal = al
        end
    end
    out_size = maxsz
    out_align = maxal
end

// ll_type_layout
func type_layout(
    v &: Lv, s &: sm.Sema, a &: at.Ast, ts: str, out_size &: i64, out_align &: i64
):
    p := (v.ptr_bits / 8) as i64
    if str.Len(ts) == 0 || str.Equals(ts, "void"):
        out_size = 0 as i64
        out_align = 1 as i64
    else str.StartsWith(ts, "dyn ") && idx_byte(ts, 91) < 0:
        out_size = (2 as i64) * p
        out_align = p
    else str.StartsWith(ts, "Variant<"):
        variant_layout_size(v, s, a, ts, out_size, out_align)
    else is_str(ts) || is_ptr_ts(ts):
        out_size = p
        out_align = p
    else is_slice(ts):
        out_size = p + (8 as i64)
        out_align = p > (8 as i64) ? p : 8 as i64
    else idx_byte(ts, 91) >= 0:
        dim := array_dim(ts)
        mut esz := 0 as i64
        mut eal := 0 as i64
        type_layout(v, s, a, array_elem(ts), esz, eal)
        out_size = esz * (dim > (0 as i64) ? dim : 0 as i64)
        out_align = eal
    else str.Equals(ts, "f32"):
        out_size = 4 as i64
        out_align = 4 as i64
    else str.Equals(ts, "f64"):
        out_size = 8 as i64
        out_align = 8 as i64
    else str.Equals(ts, "bool") || str.Equals(ts, "char"):
        out_size = 1 as i64
        out_align = 1 as i64
    else is_int_ts(ts):
        bytes := ((int_bits(v, ts) + 7) / 8) as i64
        out_size = bytes
        out_align = bytes
    else struct_sym(v, s, a, ts) != 0:
        struct_layout(v, s, a, ts, out_size, out_align)
    else enum_sym(v, s, a, ts) != 0:
        out_size = 4 as i64
        out_align = 4 as i64
    else:
        out_size = p
        out_align = p
    end
end

// ll_ensure_variant_type
func ensure_variant_type(v &: Lv, s &: sm.Sema, a &: at.Ast, ts: str):
    cn := variant_cname(ts)
    repeat v.emitted.len() with i:
        if str.Equals(cn, v.emitted.get(i)[0]):
            ret
        end
    end
    v.emitted.push(cn)
    mut sz := 0 as i64
    mut al := 0 as i64
    variant_layout_size(v, s, a, ts, sz, al)
    _al := al
    mut k := (sz + (7 as i64)) / (8 as i64)
    if k < (1 as i64):
        k = 1 as i64
    end
    out_g(v, cn + " = type { i32, [" + co.I64Toa(k) + " x i64] }\n")
end

// ll_sym_plain
func sym_plain(v &: Lv, s &: sm.Sema, a &: at.Ast, name: str): int:
    mut r := sm.Lookup(s, s.global, name)
    if r == 0 && v.pkg_scope != 0:
        r = sm.LookupLocal(s, v.pkg_scope, name)
    end
    if r == 0:
        mut p := 0
        until p < sm.PackageCount(s) && r == 0:
            pk := sm.PackageAt(s, p)
            if pk != 0:
                pkm := sm.SymAt(s, pk).members
                if pkm != 0:
                    r = sm.LookupLocal(s, pkm, name)
                end
                if r != 0:
                    touch_pkg(v, s, a, pk)
                end
            end
            p += 1
        end
    end
    ret r
end

// ll_sym_qualified - try every '_'-suffix; accept when the symbol's type
// string equals the full name.
func sym_qualified(v &: Lv, s &: sm.Sema, a &: at.Ast, name: str): int:
    n := str.Len(name)
    mut us := idx_byte(name, 95)
    until us >= 0:
        cand := str.Substr(name, us + 1, n - us - 1)
        s2 := sym_plain(v, s, a, cand)
        if s2 != 0:
            t2 := sm.SymAt(s, s2).ty
            if t2 != sm.TYPE_NONE:
                if str.Equals(sm.ToString(s, t2), name):
                    ret s2
                end
            end
        end
        // strchr(us + 1, '_')
        mut nxt := 0 - 1
        mut q := us + 1
        until q < n && nxt < 0:
            if byte_at(name, q) == 95:
                nxt = q
            end
            q += 1
        end
        us = nxt
    end
    ret 0
end

// ll_sym
func sym_of(v &: Lv, s &: sm.Sema, a &: at.Ast, name: str): int:
    if str.Len(name) == 0:
        ret 0
    end
    mut r := sym_plain(v, s, a, name)
    if r == 0 && idx_byte(name, 95) >= 0:
        r = sym_qualified(v, s, a, name)
    end
    ret r
end

// ll_struct_sym
func struct_sym(v &: Lv, s &: sm.Sema, a &: at.Ast, name: str): int:
    r := sym_of(v, s, a, name)
    if r != 0 && sm.SymAt(s, r).kind == sm.SYM_STRUCT:
        ret r
    end
    ret 0
end

// ll_enum_sym
func enum_sym(v &: Lv, s &: sm.Sema, a &: at.Ast, name: str): int:
    r := sym_of(v, s, a, name)
    if r != 0 && sm.SymAt(s, r).kind == sm.SYM_ENUM:
        ret r
    end
    ret 0
end

// ll_field_index - index among SYM_FIELDs; out_field = the field SymId.
func field_index(s &: sm.Sema, ssym: int, field: str, out_field &: int): int:
    mut idx := 0
    members := sm.SymAt(s, ssym).members
    syms := sm.ScopeAt(s, members).symbols
    repeat syms.len() with i:
        fid := syms.get(i)[0]
        f := sm.SymAt(s, fid)
        if f.kind == sm.SYM_FIELD:
            if str.Equals(f.name, field):
                out_field = fid
                ret idx
            end
            idx += 1
        end
    end
    ret 0 - 1
end

// ll_func_ret
func func_ret(ts: str): str:
    if !str.StartsWith(ts, "func("):
        ret "void"
    end
    n := str.Len(ts)
    mut p := 4
    mut d := 0
    mut brk0 := false
    until p < n && !brk0:
        c := byte_at(ts, p)
        if c == 40:
            d += 1
            p += 1
        else c == 41:
            d -= 1
            if d == 0:
                p += 1
                brk0 = true
            else:
                p += 1
            end
        else:
            p += 1
        end
    end
    until p < n && byte_at(ts, p) == 32:
        p += 1
    end
    if p < n:
        ret str.Substr(ts, p, n - p)
    end
    ret "void"
end

// ll_func_params - caller owns (and frees) the returned vector.
func func_params(ts: str): Vector<str>:
    mut out2 := Vector {} as Vector<str>
    if !str.StartsWith(ts, "func("):
        ret out2
    end
    n := str.Len(ts)
    mut start0 := 5
    mut depth := 0
    mut p := 5
    mut fin := false
    until !fin:
        c := p < n ? byte_at(ts, p) : 0
        if c == 60 || c == 40:
            depth += 1
        else c == 62:
            depth -= 1
        else c == 41 && depth > 0:
            depth -= 1
        end
        if (c == 44 && depth == 0) || (c == 41 && depth == 0) || c == 0:
            mut st := start0
            mut ln := p - start0
            until ln > 0 && byte_at(ts, st) == 32:
                st += 1
                ln -= 1
            end
            until ln > 0 && byte_at(ts, st + ln - 1) == 32:
                ln -= 1
            end
            if ln > 0:
                out2.push(str.Substr(ts, st, ln))
            end
            if c == 41 || c == 0:
                fin = true
            else:
                start0 = p + 1
            end
        end
        p += 1
    end
    ret out2
end

// ll_zero
func zero_of(ts: str): str:
    if is_str(ts) || is_ptr_ts(ts):
        ret "null"
    end
    if is_bool(ts):
        ret "false"
    end
    if is_float(ts):
        ret "0.0"
    end
    if is_int_ts(ts):
        ret "0"
    end
    ret "zeroinitializer"
end

// ll_ty - Salam typestring -> LLVM type text.
func ty_of(v &: Lv, s &: sm.Sema, a &: at.Ast, ts: str): str:
    if str.Len(ts) == 0 || str.Equals(ts, "void"):
        ret "void"
    end
    if str.StartsWith(ts, "dyn ") && idx_byte(ts, 91) < 0:
        ret "%dyn"
    end
    if str.StartsWith(ts, "Variant<"):
        ensure_variant_type(v, s, a, ts)
        ret variant_cname(ts)
    end
    if is_str(ts):
        ret "ptr"
    end
    if is_ptr_ts(ts):
        ret "ptr"
    end
    if is_slice(ts):
        ret "{ ptr, i64 }"
    end
    if idx_byte(ts, 91) >= 0:
        ret "[" + co.I64Toa(array_dim(ts)) + " x " + ty_of(v, s, a, array_elem(ts)) + "]"
    end
    if str.Equals(ts, "f32"):
        ret "float"
    end
    if str.Equals(ts, "f64"):
        ret "double"
    end
    if is_int_ts(ts):
        ret "i" + co.I64Toa(int_bits(v, ts) as i64)
    end
    if struct_sym(v, s, a, ts) != 0:
        ret struct_ltype(ts)
    end
    if enum_sym(v, s, a, ts) != 0:
        ret "i32"
    end
    ret "ptr"
end

// ll_conv - value conversion; the temp is allocated exactly where the C
// allocates it (numbering fidelity - see the file header).
func conv(v &: Lv, s &: sm.Sema, a &: at.Ast, val: Llv, to_ts: str): str:
    from := str.Len(val.ts) > 0 ? val.ts : "i32"
    if str.Equals(from, to_ts):
        ret val.ref
    end
    if str.StartsWith(to_ts, "dyn ") && struct_sym(v, s, a, from) != 0:
        ret box_dyn(
            v, s, a, val, str.Substr(to_ts, 4, str.Len(to_ts) - 4)
        )
    end
    fi := is_int_ts(from)
    ff := is_float(from)
    fp := is_str(from) || is_ptr_ts(from)
    ti := is_int_ts(to_ts)
    tf := is_float(to_ts)
    tp := is_str(to_ts) || is_ptr_ts(to_ts)
    lf := ty_of(v, s, a, from)
    lt := ty_of(v, s, a, to_ts)
    r := new_tmp(v)
    if fi && ti:
        bf := int_bits(v, from)
        bt := int_bits(v, to_ts)
        if bt == bf:
            ret val.ref
        end
        if bt < bf:
            emit(v, r + " = trunc " + lf + " " + val.ref + " to " + lt)
        else is_signed_ts(from):
            emit(v, r + " = sext " + lf + " " + val.ref + " to " + lt)
        else:
            emit(v, r + " = zext " + lf + " " + val.ref + " to " + lt)
        end
        ret r
    end
    if ff && tf:
        if str.Equals(from, "f32") && str.Equals(to_ts, "f64"):
            emit(v, r + " = fpext float " + val.ref + " to double")
        else:
            emit(v, r + " = fptrunc double " + val.ref + " to float")
        end
        ret r
    end
    if fi && tf:
        emit(
            v, r + " = " + (is_signed_ts(from) ? "sitofp" : "uitofp") + " " + lf + " " + val.ref + " to " + lt
        )
        ret r
    end
    if ff && ti:
        emit(
            v, r + " = " + (is_signed_ts(to_ts) ? "fptosi" : "fptoui") + " " + lf + " " + val.ref + " to " + lt
        )
        ret r
    end
    if fi && tp:
        emit(v, r + " = inttoptr " + lf + " " + val.ref + " to ptr")
        ret r
    end
    if fp && ti:
        emit(v, r + " = ptrtoint ptr " + val.ref + " to " + lt)
        ret r
    end
    if fp && tp:
        ret val.ref
    end
    ret val.ref
end

// ll_common
func common_ts(v &: Lv, a1: str, b1: str): str:
    if is_float(a1) || is_float(b1):
        if str.Equals(a1, "f64") || str.Equals(b1, "f64"):
            ret "f64"
        end
        ret "f32"
    end
    ba := int_bits(v, a1)
    bb2 := int_bits(v, b1)
    bits := ba > bb2 ? ba : bb2
    sgn := is_signed_ts(a1) && is_signed_ts(b1)
    if bits <= 8:
        ret sgn ? "i8" : "u8"
    end
    if bits <= 16:
        ret sgn ? "i16" : "u16"
    end
    if bits <= 32:
        ret sgn ? "i32" : "u32"
    end
    ret sgn ? "i64" : "u64"
end

// ll_as_i1
func as_i1(v &: Lv, s &: sm.Sema, a &: at.Ast, val: Llv): str:
    if is_bool(val.ts):
        ret val.ref
    end
    r := new_tmp(v)
    if is_float(val.ts):
        emit(
            v, r + " = fcmp one " + ty_of(v, s, a, val.ts) + " " + val.ref + ", 0.0"
        )
    else:
        emit(
            v, r + " = icmp ne " + ty_of(v, s, a, val.ts) + " " + val.ref + ", 0"
        )
    end
    ret r
end

// ===== codegen_llvm.c =====

// ll_datalayout's host default (the C #if chain, folded at compile time).
func dl_host(): str:
    if SALAM_ARCH_X64 && SALAM_OS_WINDOWS:
        ret "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
    else SALAM_ARCH_X64 && SALAM_OS_MAC:
        ret "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
    else SALAM_ARCH_X64:
        ret "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
    else SALAM_ARCH_ARM64 && SALAM_OS_MAC:
        ret "e-m:o-i64:64-i128:128-n32:64-S128"
    else SALAM_ARCH_ARM64:
        ret "e-m:e-i8:8:32-i16:16:32-i64:64-i128:128-n32:64-S128"
    else SALAM_ARCH_X86:
        ret "e-m:e-p:32:32-p270:32:32-p271:32:32-p272:64:64-i128:128-f64:32:64-f80:32-n8:16:32-S128"
    else:
        ret ""
    end
end

// ll_datalayout ("" = none/unknown).
func datalayout(triple: str): str:
    dl_x64_elf := "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
    dl_x64_win := "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
    dl_x64_mac := "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
    dl_x86_elf := "e-m:e-p:32:32-p270:32:32-p271:32:32-p272:64:64-i128:128-f64:32:64-f80:32-n8:16:32-S128"
    dl_a64_elf := "e-m:e-i8:8:32-i16:16:32-i64:64-i128:128-n32:64-S128"
    dl_a64_mac := "e-m:o-i64:64-i128:128-n32:64-S128"
    dl_rv64 := "e-m:e-p:64:64-i64:64-i128:128-n32:64-S128"
    if str.Len(triple) == 0:
        ret dl_host()
    end
    win := str.Contains(triple, "windows")
    mac := str.Contains(triple, "apple") || str.Contains(triple, "darwin") || str.Contains(triple, "macos")
    if str.Contains(triple, "x86_64") || str.Contains(triple, "amd64"):
        ret win ? dl_x64_win : (mac ? dl_x64_mac : dl_x64_elf)
    end
    if str.Contains(triple, "aarch64") || str.Contains(triple, "arm64"):
        ret mac ? dl_a64_mac : dl_a64_elf
    end
    if !win && !mac && (
        str.Contains(triple, "i686") || str.Contains(triple, "i586") || str.Contains(triple, "i486") || str.Contains(triple, "i386")
    ):
        ret dl_x86_elf
    end
    if str.Contains(triple, "riscv64"):
        ret dl_rv64
    end
    ret ""
end

// ll_target_is_windows
func target_is_windows_of(triple: str): bool:
    if str.Len(triple) > 0:
        ret str.Contains(triple, "windows") || str.Contains(triple, "mingw") || str.Contains(triple, "win32")
    end
    if SALAM_OS_WINDOWS:
        ret true
    else:
        ret false
    end
end

// pl_widen - helper-local i32 -> usize widening (writes into ll->hg).
func pl_widen(v &: Lv, src: str, dst: str): str:
    if v.ptr_bits <= 32:
        ret src
    end
    out_hg(v, "  " + dst + " = sext i32 " + src + " to " + v.usize + "\n")
    ret dst
end

// ll_emit_prologue
func emit_prologue(v &: Lv):
    u := v.usize
    out_g(
        v, "; Salam -> LLVM IR (textual). usize = " + u + " (" + (v.ptr_bits == 32 ? "32" : "64") + "-bit target).\n"
    )
    out_g(v, "declare i32 @printf(ptr, ...) nounwind\n")
    out_g(v, "declare i32 @dprintf(i32, ptr, ...) nounwind\n")
    out_g(v, "declare i64 @write(i32, ptr, i64) nounwind\n")
    out_g(
        v, "declare " + u + " @strlen(ptr) nounwind willreturn memory(argmem: read)\n"
    )
    out_g(v, "declare i32 @strcmp(ptr, ptr) nounwind willreturn memory(argmem: read)\n")
    out_g(v, "declare noalias ptr @malloc(" + u + ") nounwind allocsize(0)\n")
    out_g(
        v, "declare noalias ptr @realloc(ptr, " + u + ") nounwind allocsize(1)\n"
    )
    out_g(v, "declare void @free(ptr) nounwind\n")
    out_g(v, "declare ptr @memcpy(ptr, ptr, " + u + ") nounwind\n")
    out_g(v, "declare ptr @memmove(ptr, ptr, " + u + ") nounwind\n")
    out_g(v, "declare void @abort() noreturn nounwind cold\n")
    out_g(v, "declare void @exit(i32) noreturn nounwind\n")
    out_g(v, "declare i32 @snprintf(ptr, " + u + ", ptr, ...) nounwind\n")
    out_g(v, "declare i64 @strtol(ptr, ptr, i32) nounwind\n")
    out_g(v, "declare double @strtod(ptr, ptr) nounwind\n")
    out_g(v, "declare ptr @strstr(ptr, ptr) nounwind willreturn memory(argmem: read)\n")
    out_g(v, "declare double @llvm.pow.f64(double, double)\n")
    out_g(v, "%dyn = type { ptr, ptr }\n")
end

// ll_emit_substr
func emit_substr(v &: Lv):
    u := v.usize
    out_hg(v, "define internal noalias ptr @salam_ll_substr(ptr %s, i32 %start, i32 %len) nounwind willreturn nofree {\nentry:\n")
    l := pl_widen(v, "%len", "%l")
    so := pl_widen(v, "%start", "%so")
    out_hg(v, "  %t = add " + u + " " + l + ", 1\n")
    out_hg(v, "  %buf = call ptr @malloc(" + u + " %t)\n")
    out_hg(v, "  %src = getelementptr i8, ptr %s, " + u + " " + so + "\n")
    out_hg(
        v, "  %c = call ptr @memcpy(ptr %buf, ptr %src, " + u + " " + l + ")\n"
    )
    out_hg(v, "  %e = getelementptr i8, ptr %buf, " + u + " " + l + "\n")
    out_hg(v, "  store i8 0, ptr %e\n  ret ptr %buf\n}\n\n")
end

// ll_emit_strcat
func emit_strcat(v &: Lv):
    u := v.usize
    out_hg(
        v, "define internal noalias ptr @salam_ll_strcat(ptr %a, ptr %b) nounwind willreturn nofree {\n" + "entry:\n" + "  %la = call " + u + " @strlen(ptr %a)\n" + "  %lb = call " + u + " @strlen(ptr %b)\n" + "  %sum = add " + u + " %la, %lb\n" + "  %tot = add " + u + " %sum, 1\n" + "  %buf = call ptr @malloc(" + u + " %tot)\n" + "  %c1 = call ptr @memcpy(ptr %buf, ptr %a, " + u + " %la)\n" + "  %end = getelementptr i8, ptr %buf, " + u + " %la\n" + "  %lb1 = add " + u + " %lb, 1\n" + "  %c2 = call ptr @memcpy(ptr %end, ptr %b, " + u + " %lb1)\n" + "  ret ptr %buf\n}\n\n"
    )
end

// ll_emit_isws
func emit_isws(v &: Lv):
    out_hg(
        v, "define internal i1 @salam_ll_isws(i8 %c) nounwind willreturn memory(none) {\n" + "entry:\n" + "  %s32 = icmp eq i8 %c, 32\n" + "  %s9 = icmp eq i8 %c, 9\n" + "  %s10 = icmp eq i8 %c, 10\n" + "  %s13 = icmp eq i8 %c, 13\n" + "  %o1 = or i1 %s32, %s9\n" + "  %o2 = or i1 %o1, %s10\n" + "  %o3 = or i1 %o2, %s13\n" + "  ret i1 %o3\n}\n\n"
    )
end

// ll_emit_trim
func emit_trim(v &: Lv):
    need(v, LV_H_ISWS)
    u := v.usize
    out_hg(
        v, "define internal noalias ptr @salam_ll_trim(ptr %s) nounwind willreturn nofree {\n" + "entry:\n" + "  %n = call " + u + " @strlen(ptr %s)\n" + "  br label %f\n" + "f:\n" + "  %a = phi " + u + " [ 0, %entry ], [ %an, %fbody ]\n" + "  %c1 = icmp ult " + u + " %a, %n\n" + "  br i1 %c1, label %fchk, label %b\n" + "fchk:\n" + "  %p1 = getelementptr i8, ptr %s, " + u + " %a\n" + "  %ch1 = load i8, ptr %p1\n" + "  %w1 = call i1 @salam_ll_isws(i8 %ch1)\n" + "  br i1 %w1, label %fbody, label %b\n" + "fbody:\n" + "  %an = add " + u + " %a, 1\n" + "  br label %f\n" + "b:\n" + "  br label %r\n" + "r:\n" + "  %e = phi " + u + " [ %n, %b ], [ %en, %rbody ]\n" + "  %c2 = icmp ugt " + u + " %e, %a\n" + "  br i1 %c2, label %rchk, label %done\n" + "rchk:\n" + "  %em1 = sub " + u + " %e, 1\n" + "  %p2 = getelementptr i8, ptr %s, " + u + " %em1\n" + "  %ch2 = load i8, ptr %p2\n" + "  %w2 = call i1 @salam_ll_isws(i8 %ch2)\n" + "  br i1 %w2, label %rbody, label %done\n" + "rbody:\n" + "  %en = sub " + u + " %e, 1\n" + "  br label %r\n" + "done:\n" + "  %len = sub " + u + " %e, %a\n" + "  %tot = add " + u + " %len, 1\n" + "  %buf = call ptr @malloc(" + u + " %tot)\n" + "  %src = getelementptr i8, ptr %s, " + u + " %a\n" + "  %cp = call ptr @memcpy(ptr %buf, ptr %src, " + u + " %len)\n" + "  %endp = getelementptr i8, ptr %buf, " + u + " %len\n" + "  store i8 0, ptr %endp\n" + "  ret ptr %buf\n}\n\n"
    )
end

// ll_emit_repeat
func emit_repeat(v &: Lv):
    u := v.usize
    out_hg(v, "define internal noalias ptr @salam_ll_repeat(ptr %s, i32 %n) nounwind willreturn nofree {\nentry:\n")
    out_hg(v, "  %slen = call " + u + " @strlen(ptr %s)\n")
    nw := pl_widen(v, "%n", "%nw")
    out_hg(v, "  %nle0 = icmp sle i32 %n, 0\n")
    out_hg(v, "  %slen0 = icmp eq " + u + " %slen, 0\n")
    out_hg(v, "  %skip = or i1 %nle0, %slen0\n")
    out_hg(v, "  br i1 %skip, label %empty, label %compute\n")
    out_hg(v, "empty:\n")
    out_hg(v, "  %eb = call ptr @malloc(" + u + " 1)\n")
    out_hg(v, "  store i8 0, ptr %eb\n  ret ptr %eb\n")
    out_hg(v, "compute:\n")
    out_hg(v, "  %total = mul " + u + " %slen, " + nw + "\n")
    out_hg(v, "  %tot1 = add " + u + " %total, 1\n")
    out_hg(v, "  %buf = call ptr @malloc(" + u + " %tot1)\n")
    out_hg(v, "  %c0 = call ptr @memcpy(ptr %buf, ptr %s, " + u + " %slen)\n")
    out_hg(v, "  br label %loop\n")
    out_hg(v, "loop:\n")
    out_hg(
        v, "  %filled = phi " + u + " [ %slen, %compute ], [ %newfilled, %body ]\n"
    )
    out_hg(v, "  %done = icmp uge " + u + " %filled, %total\n")
    out_hg(v, "  br i1 %done, label %finish, label %body\n")
    out_hg(v, "body:\n")
    out_hg(v, "  %remain = sub " + u + " %total, %filled\n")
    out_hg(v, "  %lt = icmp ult " + u + " %filled, %remain\n")
    out_hg(
        v, "  %chunk = select i1 %lt, " + u + " %filled, " + u + " %remain\n"
    )
    out_hg(v, "  %dst = getelementptr i8, ptr %buf, " + u + " %filled\n")
    out_hg(
        v, "  %cc = call ptr @memcpy(ptr %dst, ptr %buf, " + u + " %chunk)\n"
    )
    out_hg(v, "  %newfilled = add " + u + " %filled, %chunk\n")
    out_hg(v, "  br label %loop\n")
    out_hg(v, "finish:\n")
    out_hg(v, "  %endp = getelementptr i8, ptr %buf, " + u + " %total\n")
    out_hg(v, "  store i8 0, ptr %endp\n  ret ptr %buf\n}\n\n")
end

// ll_emit_case
func emit_case(v &: Lv, fname: str, lo: int, hi: int, delta: int):
    u := v.usize
    out_hg(
        v, "define internal noalias ptr @" + fname + "(ptr %s) nounwind willreturn nofree {\nentry:\n"
    )
    out_hg(v, "  %n = call " + u + " @strlen(ptr %s)\n")
    out_hg(v, "  %tot = add " + u + " %n, 1\n")
    out_hg(v, "  %buf = call ptr @malloc(" + u + " %tot)\n")
    out_hg(v, "  br label %loop\n")
    out_hg(v, "loop:\n")
    out_hg(v, "  %i = phi " + u + " [ 0, %entry ], [ %ni, %body ]\n")
    out_hg(v, "  %cont = icmp ult " + u + " %i, %n\n")
    out_hg(v, "  br i1 %cont, label %body, label %done\n")
    out_hg(v, "body:\n")
    out_hg(v, "  %sp = getelementptr i8, ptr %s, " + u + " %i\n")
    out_hg(v, "  %c = load i8, ptr %sp\n")
    out_hg(v, "  %ge = icmp sge i8 %c, " + co.I64Toa(lo as i64) + "\n")
    out_hg(v, "  %le = icmp sle i8 %c, " + co.I64Toa(hi as i64) + "\n")
    out_hg(v, "  %inrange = and i1 %ge, %le\n")
    out_hg(v, "  %c2 = add i8 %c, " + co.I64Toa(delta as i64) + "\n")
    out_hg(v, "  %oc = select i1 %inrange, i8 %c2, i8 %c\n")
    out_hg(v, "  %dp = getelementptr i8, ptr %buf, " + u + " %i\n")
    out_hg(v, "  store i8 %oc, ptr %dp\n")
    out_hg(v, "  %ni = add " + u + " %i, 1\n")
    out_hg(v, "  br label %loop\n")
    out_hg(v, "done:\n")
    out_hg(v, "  %ep = getelementptr i8, ptr %buf, " + u + " %n\n")
    out_hg(v, "  store i8 0, ptr %ep\n  ret ptr %buf\n}\n\n")
end

// ll_emit_upper / ll_emit_lower
func emit_upper(v &: Lv):
    emit_case(v, "salam_ll_upper", 97, 122, 0 - 32)
end

func emit_lower(v &: Lv):
    emit_case(v, "salam_ll_lower", 65, 90, 32)
end

// ll_emit_strhash
func emit_strhash(v &: Lv):
    out_hg(
        v, "define internal i64 @salam_ll_strhash(ptr %s) nounwind willreturn memory(argmem: read) {\n" + "entry:\n  br label %loop\n" + "loop:\n" + "  %j = phi i64 [ 0, %entry ], [ %jn, %body ]\n" + "  %h = phi i64 [ 14695981039346656037, %entry ], [ %hn, %body ]\n" + "  %p = getelementptr i8, ptr %s, i64 %j\n" + "  %c8 = load i8, ptr %p\n" + "  %z = icmp eq i8 %c8, 0\n" + "  br i1 %z, label %done, label %body\n" + "body:\n" + "  %c = zext i8 %c8 to i64\n" + "  %hm = mul i64 %h, 1099511628211\n" + "  %hn = add i64 %hm, %c\n" + "  %jn = add i64 %j, 1\n" + "  br label %loop\n" + "done:\n  ret i64 %h\n}\n\n"
    )
end

// ll_emit_inthash
func emit_inthash(v &: Lv):
    out_hg(
        v, "define internal i64 @salam_ll_inthash(i64 %x) nounwind willreturn memory(none) {\n" + "entry:\n" + "  %h0 = add i64 %x, 14695981039346656037\n" + "  %h1 = mul i64 %h0, 1099511628211\n" + "  %h2 = add i64 %h1, 1099511628211\n" + "  %h3 = mul i64 %h2, 1099511628211\n" + "  ret i64 %h3\n}\n\n"
    )
end

// ll_emit_i64str
func emit_i64str(v &: Lv):
    u := v.usize
    out_hg(v, "@.sfmt.lld = private unnamed_addr constant [5 x i8] c\"%lld\\00\"\n")
    out_hg(
        v, "define internal noalias ptr @salam_ll_i64str(i64 %v) nounwind willreturn nofree {\n" + "entry:\n" + "  %b = call ptr @malloc(" + u + " 32)\n" + "  %r = call i32 (ptr, " + u + ", ptr, ...) @snprintf(ptr %b, " + u + " 32, ptr @.sfmt.lld, i64 %v)\n" + "  ret ptr %b\n}\n\n"
    )
end

// ll_emit_u64str
func emit_u64str(v &: Lv):
    u := v.usize
    out_hg(v, "@.sfmt.llu = private unnamed_addr constant [5 x i8] c\"%llu\\00\"\n")
    out_hg(
        v, "define internal noalias ptr @salam_ll_u64str(i64 %v) nounwind willreturn nofree {\n" + "entry:\n" + "  %b = call ptr @malloc(" + u + " 32)\n" + "  %r = call i32 (ptr, " + u + ", ptr, ...) @snprintf(ptr %b, " + u + " 32, ptr @.sfmt.llu, i64 %v)\n" + "  ret ptr %b\n}\n\n"
    )
end

// ll_emit_f64str
func emit_f64str(v &: Lv):
    u := v.usize
    out_hg(v, "@.sfmt.g = private unnamed_addr constant [3 x i8] c\"%g\\00\"\n")
    out_hg(
        v, "define internal noalias ptr @salam_ll_f64str(double %v) nounwind willreturn nofree {\n" + "entry:\n" + "  %b = call ptr @malloc(" + u + " 32)\n" + "  %r = call i32 (ptr, " + u + ", ptr, ...) @snprintf(ptr %b, " + u + " 32, ptr @.sfmt.g, double %v)\n" + "  ret ptr %b\n}\n\n"
    )
end

// ll_emit_charstr
func emit_charstr(v &: Lv):
    out_hg(
        v, "define internal noalias ptr @salam_ll_charstr(i32 %c) nounwind willreturn nofree {\n" + "entry:\n" + "  %b = call ptr @malloc(" + v.usize + " 2)\n" + "  %t = trunc i32 %c to i8\n" + "  store i8 %t, ptr %b\n" + "  %p1 = getelementptr i8, ptr %b, i64 1\n" + "  store i8 0, ptr %p1\n" + "  ret ptr %b\n}\n\n"
    )
end

// ll_emit_outbuf
func emit_outbuf(v &: Lv):
    out_hg(
        v, "@salam_ob = internal global [65536 x i8] zeroinitializer\n" + "@salam_obn = internal global i64 0\n" + "@stdout = external global ptr\n" + "declare i32 @fflush(ptr) nounwind\n" + "declare void @llvm.memcpy.p0.p0.i64(ptr, ptr, i64, i1) nounwind\n" + "define internal void @salam_out_flush() nounwind {\n" + "entry:\n" + "  %n = load i64, ptr @salam_obn\n" + "  %z = icmp eq i64 %n, 0\n" + "  br i1 %z, label %done, label %do\n" + "do:\n" + "  %r = call i64 @write(i32 1, ptr @salam_ob, i64 %n)\n" + "  store i64 0, ptr @salam_obn\n" + "  br label %done\n" + "done:\n" + "  ret void\n" + "}\n" + "define internal void @salam_out_write(ptr %s, i64 %n) nounwind {\n" + "entry:\n" + "  %obn = load i64, ptr @salam_obn\n" + "  %sum = add i64 %obn, %n\n" + "  %over = icmp ugt i64 %sum, 65536\n" + "  br i1 %over, label %flush, label %chk\n" + "flush:\n" + "  call void @salam_out_flush()\n" + "  br label %chk\n" + "chk:\n" + "  %big = icmp uge i64 %n, 65536\n" + "  br i1 %big, label %direct, label %copy\n" + "direct:\n" + "  %rd = call i64 @write(i32 1, ptr %s, i64 %n)\n" + "  ret void\n" + "copy:\n" + "  %obn2 = load i64, ptr @salam_obn\n" + "  %dst = getelementptr inbounds [65536 x i8], ptr @salam_ob, i64 0, i64 %obn2\n" + "  call void @llvm.memcpy.p0.p0.i64(ptr %dst, ptr %s, i64 %n, i1 false)\n" + "  %newn = add i64 %obn2, %n\n" + "  store i64 %newn, ptr @salam_obn\n" + "  ret void\n" + "}\n" + "@llvm.global_dtors = appending global [1 x { i32, ptr, ptr }] " + "[{ i32, ptr, ptr } { i32 65535, ptr @salam_out_flush, ptr null }]\n\n"
    )
end

// ll_need - the LL_HELPER_EMIT[] dispatch as an if/else chain.
func need(v &: Lv, which: int):
    if v.hneed.get(which)[0]:
        ret
    end
    v.hneed.set(which, true)
    if which == LV_H_SUBSTR:
        emit_substr(v)
    else which == LV_H_STRCAT:
        emit_strcat(v)
    else which == LV_H_ISWS:
        emit_isws(v)
    else which == LV_H_TRIM:
        emit_trim(v)
    else which == LV_H_STRHASH:
        emit_strhash(v)
    else which == LV_H_INTHASH:
        emit_inthash(v)
    else which == LV_H_I64STR:
        emit_i64str(v)
    else which == LV_H_U64STR:
        emit_u64str(v)
    else which == LV_H_F64STR:
        emit_f64str(v)
    else which == LV_H_CHARSTR:
        emit_charstr(v)
    else which == LV_H_OUTBUF:
        emit_outbuf(v)
    else which == LV_H_REPEAT:
        emit_repeat(v)
    else which == LV_H_UPPER:
        emit_upper(v)
    else which == LV_H_LOWER:
        emit_lower(v)
    end
end

// ll_toplevel
func toplevel(v &: Lv, s &: sm.Sema, a &: at.Ast, d: int):
    dn := at.Get(a, d)
    k := dn.kind
    if k == at.AST_FUNC_DEF:
        if dn.is_extern && dn.a == 0:
            ret
        end
        if dn.typarams.len() > 0:
            ret
        end
        emit_function(v, s, a, d, 0)
    else k == at.AST_STRUCT_DEF:
        if dn.typarams.len() > 0:
            ret
        end
        ssym := struct_sym(v, s, a, dn.name)
        repeat at.ChildCount(a, d) with i:
            m := at.Child(a, d, i)
            if at.KindOf(a, m) == at.AST_FUNC_DEF:
                emit_function(v, s, a, m, ssym)
            end
        end
    else k == at.AST_ENUM_DEF || k == at.AST_CONST_DECL || k == at.AST_VAR_DECL || k == at.AST_INTERFACE_DEF || k == at.AST_IMPL_DEF || k == at.AST_IMPORT || k == at.AST_LINK || k == at.AST_TYPE_ALIAS:
        // nothing at the top level
        _k := k
    else:
        lv_error(
            v, a, d, "top-level " + at.KindName(k) + " (layout/unsupported)"
        )
    end
end

// ===== codegen_llvm_decl.c =====

// ll_emit_struct_types
func emit_struct_types(v &: Lv, s &: sm.Sema, a &: at.Ast, program: int):
    mut i := 0
    until i < at.ChildCount(a, program):
        d := at.Child(a, program, i)
        dn := at.Get(a, d)
        if dn.kind == at.AST_STRUCT_DEF && dn.typarams.len() == 0:
            ssym := struct_sym(v, s, a, dn.name)
            if ssym != 0 && sm.SymAt(s, ssym).members != 0:
                sy := sm.SymAt(s, ssym)
                sname := sy.ty != sm.TYPE_NONE ? sm.ToString(s, sy.ty) : dn.name
                ltname := struct_ltype(sname)
                mut seen := false
                repeat v.emitted.len() with ke:
                    if str.Equals(ltname, v.emitted.get(ke)[0]):
                        seen = true
                    end
                end
                if !seen:
                    v.emitted.push(ltname)
                    mut b := co.SbNew()
                    co.SbPuts(b, ltname + " = type { ")
                    mut nf := 0
                    syms := sm.ScopeAt(s, sy.members).symbols
                    repeat syms.len() with j:
                        f := sm.SymAt(s, syms.get(j)[0])
                        if f.kind == sm.SYM_FIELD:
                            if nf != 0:
                                co.SbPuts(b, ", ")
                            end
                            co.SbPuts(b, ty_of(v, s, a, sm.ToString(s, f.ty)))
                            nf += 1
                        end
                    end
                    co.SbPuts(b, " }\n")
                    out_g(v, co.SbCstr(b))
                    co.SbFree(b)
                end
            end
        end
        i += 1
    end
    out_g(v, "\n")
end

// ll_mangle - "" owner = the C NULL; sig 0 = the C NULL.
func mangle(v &: Lv, s &: sm.Sema, owner: str, fn_name: str, sig: int): str:
    if str.Len(owner) == 0 && str.Equals(fn_name, v.entry):
        ret "main"
    end
    mut b := co.SbNew()
    co.SbPuts(b, "salam_")
    if str.Len(owner) > 0:
        put_ident(b, owner)
        co.SbPutc(b, 95)
    end
    put_ident(b, fn_name)
    if sig != 0:
        sg := sm.SigAt(s, sig)
        repeat sg.params.len() with i:
            co.SbPutc(b, 95)
            put_type_code(b, sm.ToString(s, sg.params.get(i)[0]))
        end
    end
    r := co.SbCstr(b)
    co.SbFree(b)
    ret r
end

// ll_pick_overload - first exact arg-typestring match; else first
// arity-compatible; else overload 0.
func pick_overload(
    v &: Lv, s &: sm.Sema, a &: at.Ast, symid: int, call: int
): int:
    _v := v.tmp
    mut arity := 0
    sy := sm.SymAt(s, symid)
    nargs := at.ChildCount(a, call)
    repeat sy.overloads.len() with i:
        sigid := sy.overloads.get(i)[0]
        sg := sm.SigAt(s, sigid)
        skip := nargs < sg.required || (!sg.variadic && nargs > sg.params.len())
        if !skip:
            if arity == 0:
                arity = sigid
            end
            nfix := nargs < sg.params.len() ? nargs : sg.params.len()
            mut okm := true
            mut j := 0
            until j < nfix && okm:
                arg := at.Get(a, at.Child(a, call, j))
                pt := sm.ToString(s, sg.params.get(j)[0])
                if str.Len(arg.type_str) == 0 || !str.Equals(arg.type_str, pt):
                    okm = false
                end
                j += 1
            end
            if okm:
                ret sigid
            end
        end
    end
    if arity != 0:
        ret arity
    end
    if sy.overloads.len() > 0:
        ret sy.overloads.get(0)[0]
    end
    ret 0
end

// ll_sig_of
func sig_of(v &: Lv, s &: sm.Sema, a &: at.Ast, fn: int, owner: int): int:
    fname := at.Get(a, fn).name
    mut symid := 0
    if owner != 0:
        symid = sm.LookupLocal(s, sm.SymAt(s, owner).members, fname)
    else:
        symid = sym_of(v, s, a, fname)
    end
    if symid == 0:
        ret 0
    end
    sy := sm.SymAt(s, symid)
    repeat sy.overloads.len() with i:
        sigid := sy.overloads.get(i)[0]
        if sm.SigAt(s, sigid).decl == fn:
            ret sigid
        end
    end
    if sy.overloads.len() > 0:
        ret sy.overloads.get(0)[0]
    end
    ret 0
end

// ll_fn_header - recv_param "" = the C NULL.
func fn_header(
    v &: Lv, s &: sm.Sema, a &: at.Ast, fn: int, sig: int, ret_lty: str, fname: str, recv_param: str,
    exported: bool
): str:
    mut hdr := co.SbNew()
    co.SbPuts(
        hdr, "define " + (exported ? "" : "internal ") + ret_lty + " @" + fname + "("
    )
    mut first := true
    if str.Len(recv_param) > 0:
        co.SbPuts(hdr, recv_param)
        first = false
    end
    fnode := at.Get(a, fn)
    sg := sm.SigAt(s, sig)
    repeat at.ChildCount(a, fn) with i:
        p := at.Get(a, fnode.list.get(i)[0])
        pts := sm.ToString(s, sg.params.get(i)[0])
        if !first:
            co.SbPuts(hdr, ", ")
        end
        if p.is_ref:
            co.SbPuts(hdr, "ptr noundef nonnull %arg" + co.I64Toa(i as i64))
        else:
            co.SbPuts(hdr, ty_of(v, s, a, pts) + " %arg" + co.I64Toa(i as i64))
        end
        first = false
    end
    co.SbPuts(hdr, ")")
    if !v.is_main:
        if fnode.is_inline:
            co.SbPuts(hdr, " alwaysinline")
        end
        if fnode.is_noinline:
            co.SbPuts(hdr, " noinline")
        end
        if fnode.is_pure:
            co.SbPuts(hdr, " memory(read) willreturn nofree nosync")
        end
        if fnode.is_noret:
            co.SbPuts(hdr, " noreturn")
        end
    end
    if v.optsize:
        co.SbPuts(hdr, " optsize")
    end
    if v.minsize:
        co.SbPuts(hdr, " minsize")
    end
    co.SbPuts(hdr, " nounwind")
    if v.debug && str.Len(v.cur_sp) > 0:
        co.SbPuts(hdr, " !dbg " + v.cur_sp)
    end
    co.SbPuts(hdr, " {\n")
    r := co.SbCstr(hdr)
    co.SbFree(hdr)
    ret r
end

// ll_spill_params
func spill_params(v &: Lv, s &: sm.Sema, a &: at.Ast, fn: int, sig: int):
    fnode := at.Get(a, fn)
    sg := sm.SigAt(s, sig)
    repeat at.ChildCount(a, fn) with i:
        p := at.Get(a, fnode.list.get(i)[0])
        pts := sm.ToString(s, sg.params.get(i)[0])
        if p.is_ref:
            local_add(v, p.name, "%arg" + co.I64Toa(i as i64), pts)
        else:
            ptr2 := "%p." + safe_name(p.name)
            emit_alloca(v, ptr2 + " = alloca " + ty_of(v, s, a, pts))
            emit(
                v, "store " + ty_of(v, s, a, pts) + " %arg" + co.I64Toa(i as i64) + ", ptr " + ptr2
            )
            local_add(v, p.name, ptr2, pts)
        end
    end
end

// ll_function - the function frame. Body statements come from stage B's
// lv_block_top; everything else (header, spills, this-slot, global inits,
// implicit return, builder nesting) is stage A.
func emit_function(v &: Lv, s &: sm.Sema, a &: at.Ast, fn: int, owner: int):
    fnode := at.Get(a, fn)
    if owner == 0 && fnode.is_extern && fnode.a == 0:
        ret
    end
    sig := sig_of(v, s, a, fn, owner)
    if sig == 0:
        ret
    end
    is_main0 := owner == 0 && str.Equals(fnode.name, v.entry)
    is_impl := owner != 0 && sm.SymAt(s, owner).kind == sm.SYM_TYPEIMPL
    rts := sm.ToString(s, sm.SigAt(s, sig).ret_type)
    ret_lty := is_main0 ? "i32" : ty_of(v, s, a, rts)
    mut recv_ts := ""
    if is_impl:
        recv_ts = sm.ToString(s, sm.SymAt(s, owner).ty)
    else owner != 0:
        recv_ts = sm.SymAt(s, owner).name
    end
    mut fname := ""
    if is_impl:
        fname = mangle_ti(v, s, recv_ts, fnode.name, sig)
    else owner == 0 && fnode.is_extern:
        fname = fnode.name
    else:
        fname = mangle(
            v, s, owner != 0 ? sm.SymAt(s, owner).name : "", fnode.name, sig
        )
    end
    mut recv_param := ""
    if owner != 0:
        if is_impl:
            recv_param = ty_of(v, s, a, recv_ts) + " %this"
        else:
            recv_param = "ptr noundef %this"
        end
    end
    exported := is_main0 || (owner == 0 && fnode.is_extern)
    repeat v.emitted.len() with i:
        if str.Equals(fname, v.emitted.get(i)[0]):
            ret
        end
    end
    v.emitted.push(fname)

    saved_bb := v.bb
    saved_ba := v.ba
    saved_in_fn := v.in_fn
    saved_tmp := v.tmp
    saved_lbl := v.lbl
    saved_nloop := v.nloop
    saved_main := v.is_main
    saved_byval := v.self_byval
    saved_term := v.term
    saved_ret := v.ret_ts
    saved_sp := v.cur_sp
    saved_dbg := v.cur_dbg
    saved_self := v.self_ts
    saved_this := v.this_ref
    saved_locals := v.locals
    saved_defers := v.defers
    v.bb = str.NewBuilder()
    v.ba = str.NewBuilder()
    v.in_fn = true
    v.tmp = 0
    v.lbl = 0
    v.nloop = 0
    v.term = false
    v.ret_ts = rts
    v.is_main = is_main0
    v.self_ts = recv_ts
    v.self_byval = is_impl
    v.this_ref = owner != 0 ? "%this" : ""
    v.locals = Vector {} as Vector<LvVar>
    v.defers = Vector {} as Vector<int>
    if v.debug:
        _sp := debug_subprogram(v, fnode.name, fnode.begin_line as int)
        v.cur_dbg = debug_location(
            v, fnode.begin_line as int, fnode.begin_col as int
        )
    end
    header := fn_header(
        v, s, a, fn, sig, ret_lty, fname, recv_param, exported
    )
    if is_impl:
        emit_alloca(v, "%p.this = alloca " + ty_of(v, s, a, recv_ts))
        emit(v, "store " + ty_of(v, s, a, recv_ts) + " %this, ptr %p.this")
        v.this_ref = "%p.this"
    end
    spill_params(v, s, a, fn, sig)
    if is_main0:
        emit_global_inits(v, s, a)
    end
    if fnode.a != 0:
        lv_block_top(v, s, a, fnode.a)
    end
    if !v.term:
        emit_return(v, s, a, 0)
    end
    out_g(v, header)
    out_g(v, "entry:\n")
    out_g(v, co.SbCstr(v.ba))
    out_g(v, co.SbCstr(v.bb))
    out_g(v, "}\n\n")
    str.BufFree(v.bb)
    str.BufFree(v.ba)
    v.bb = saved_bb
    v.ba = saved_ba
    v.in_fn = saved_in_fn
    v.tmp = saved_tmp
    v.lbl = saved_lbl
    v.nloop = saved_nloop
    v.is_main = saved_main
    v.ret_ts = saved_ret
    v.self_byval = saved_byval
    v.term = saved_term
    v.cur_sp = saved_sp
    v.cur_dbg = saved_dbg
    v.self_ts = saved_self
    v.this_ref = saved_this
    v.locals.free()
    v.defers.free()
    v.locals = saved_locals
    v.defers = saved_defers
end

// ll_ensure_fn
func ensure_fn(
    v &: Lv, s &: sm.Sema, a &: at.Ast, fn: int, owner: int, pscope: int
):
    if fn == 0:
        ret
    end
    saved := v.pkg_scope
    v.pkg_scope = pscope
    emit_function(v, s, a, fn, owner)
    v.pkg_scope = saved
end

// ll_vtbl_name
func vtbl_name(iface: str, concrete: str): str:
    mut b := co.SbNew()
    co.SbPuts(b, "@vtbl.")
    put_ident(b, iface)
    co.SbPutc(b, 46)
    put_ident(b, concrete)
    r := co.SbCstr(b)
    co.SbFree(b)
    ret r
end

// ll_match_sig
func match_sig(s &: sm.Sema, m: int, want: int): int:
    sy := sm.SymAt(s, m)
    first := sy.overloads.len() > 0 ? sy.overloads.get(0)[0] : 0
    repeat sy.overloads.len() with i:
        sigid := sy.overloads.get(i)[0]
        if sm.SigAt(s, sigid).params.len() == want:
            ret sigid
        end
    end
    ret first
end

// ll_ensure_vtbl
func ensure_vtbl(
    v &: Lv, s &: sm.Sema, a &: at.Ast, iface: str, concrete: str
):
    name := vtbl_name(iface, concrete)
    repeat v.emitted.len() with i:
        if str.Equals(name, v.emitted.get(i)[0]):
            ret
        end
    end
    v.emitted.push(name)
    isym := sym_of(v, s, a, iface)
    csym := sym_of(v, s, a, concrete)
    if isym == 0 || sm.SymAt(s, isym).kind != sm.SYM_INTERFACE || csym == 0 || sm.SymAt(s, csym).members == 0:
        ret
    end
    mut slots := co.SbNew()
    mut n := 0
    isyms := sm.ScopeAt(s, sm.SymAt(s, isym).members).symbols
    repeat isyms.len() with mi:
        imid := isyms.get(mi)[0]
        im := sm.SymAt(s, imid)
        if im.kind == sm.SYM_METHOD && im.overloads.len() > 0:
            isig := im.overloads.get(0)[0]
            cm := sm.LookupLocal(s, sm.SymAt(s, csym).members, im.name)
            mut csig := 0
            if cm != 0 && sm.SymAt(s, cm).kind == sm.SYM_METHOD:
                csig = match_sig(s, cm, sm.SigAt(s, isig).params.len())
            end
            if n != 0:
                co.SbPuts(slots, ", ")
            end
            if csig != 0:
                ensure_fn(v, s, a, sm.SigAt(s, csig).decl, csym, v.pkg_scope)
                co.SbPuts(
                    slots, "ptr @" + mangle(
                        v, s, concrete, im.name, csig
                    )
                )
            else:
                co.SbPuts(slots, "ptr null")
            end
            n += 1
        end
    end
    out_g(
        v, name + " = private unnamed_addr constant [" + co.I64Toa(n as i64) + " x ptr] [" + co.SbCstr(slots) + "]\n"
    )
    co.SbFree(slots)
end

// ll_box_dyn - box a struct value into a %dyn { data, vtbl } pair.
func box_dyn(v &: Lv, s &: sm.Sema, a &: at.Ast, val: Llv, iface: str): str:
    // iface truncated at '*' / '[' into char ib[160]
    n := str.Len(iface)
    mut k := 0
    mut stop := false
    until k < n && k < 159 && !stop:
        c := byte_at(iface, k)
        if c == 42 || c == 91:
            stop = true
        else:
            k += 1
        end
    end
    ib := str.Substr(iface, 0, k)
    ensure_vtbl(v, s, a, ib, val.ts)
    cty := struct_ltype(val.ts)
    szp := new_tmp(v)
    sz := new_tmp(v)
    data := new_tmp(v)
    emit(v, szp + " = getelementptr " + cty + ", ptr null, i32 1")
    emit(v, sz + " = ptrtoint ptr " + szp + " to " + v.usize)
    emit(v, data + " = call ptr @malloc(" + v.usize + " " + sz + ")")
    emit(v, "store " + cty + " " + val.ref + ", ptr " + data)
    t0 := new_tmp(v)
    t1 := new_tmp(v)
    emit(v, t0 + " = insertvalue %dyn undef, ptr " + data + ", 0")
    emit(
        v, t1 + " = insertvalue %dyn " + t0 + ", ptr " + vtbl_name(ib, val.ts) + ", 1"
    )
    ret t1
end

// ll_box_variant
func box_variant(
    v &: Lv, s &: sm.Sema, a &: at.Ast, val: Llv, tag: int, variant_ts: str
): str:
    vt := ty_of(v, s, a, variant_ts)
    slot := new_tmp(v)
    tagp := new_tmp(v)
    payp := new_tmp(v)
    result := new_tmp(v)
    emit_alloca(v, slot + " = alloca " + vt)
    emit(
        v, tagp + " = getelementptr " + vt + ", ptr " + slot + ", i32 0, i32 0"
    )
    emit(v, "store i32 " + co.I64Toa(tag as i64) + ", ptr " + tagp)
    emit(
        v, payp + " = getelementptr " + vt + ", ptr " + slot + ", i32 0, i32 1"
    )
    emit(
        v, "store " + ty_of(v, s, a, val.ts) + " " + val.ref + ", ptr " + payp
    )
    emit(v, result + " = load " + vt + ", ptr " + slot)
    ret result
end

// ll_unwrap_variant
func unwrap_variant(
    v &: Lv, s &: sm.Sema, a &: at.Ast, val: Llv, member_ts: str
): Llv:
    vt := ty_of(v, s, a, val.ts)
    slot := new_tmp(v)
    payp := new_tmp(v)
    r := new_tmp(v)
    emit_alloca(v, slot + " = alloca " + vt)
    emit(v, "store " + vt + " " + val.ref + ", ptr " + slot)
    emit(
        v, payp + " = getelementptr " + vt + ", ptr " + slot + ", i32 0, i32 1"
    )
    emit(v, r + " = load " + ty_of(v, s, a, member_ts) + ", ptr " + payp)
    ret make_llv(r, member_ts)
end

// ll_mangle_ti
func mangle_ti(
    v &: Lv, s &: sm.Sema, typestr: str, fn_name: str, sig: int
): str:
    _v := v.tmp
    mut b := co.SbNew()
    co.SbPuts(b, "salam_ti_")
    put_type_code(b, typestr)
    co.SbPutc(b, 95)
    put_ident(b, fn_name)
    if sig != 0:
        sg := sm.SigAt(s, sig)
        repeat sg.params.len() with i:
            co.SbPutc(b, 95)
            put_type_code(b, sm.ToString(s, sg.params.get(i)[0]))
        end
    end
    r := co.SbCstr(b)
    co.SbFree(b)
    ret r
end

// ll_emit_impls_in
func emit_impls_in(v &: Lv, s &: sm.Sema, a &: at.Ast, gsc: int):
    syms := sm.ScopeAt(s, gsc).symbols
    repeat syms.len() with i:
        ownerid := syms.get(i)[0]
        owner := sm.SymAt(s, ownerid)
        if owner.kind == sm.SYM_TYPEIMPL && owner.members != 0:
            msyms := sm.ScopeAt(s, owner.members).symbols
            repeat msyms.len() with j:
                m := sm.SymAt(s, msyms.get(j)[0])
                if m.kind == sm.SYM_METHOD:
                    repeat m.overloads.len() with k:
                        sigid := m.overloads.get(k)[0]
                        d := sm.SigAt(s, sigid).decl
                        if d != 0:
                            emit_function(v, s, a, d, ownerid)
                        end
                    end
                end
            end
        end
    end
end

// ll_emit_impls
func emit_impls(v &: Lv, s &: sm.Sema, a &: at.Ast):
    emit_impls_in(v, s, a, s.global)
end

// ll_emit_lambda - the lambda frame (stage A); the body comes from stage
// B's lv_block_top like ll_function.
func emit_lambda(v &: Lv, s &: sm.Sema, a &: at.Ast, n: int):
    nd := at.Get(a, n)
    if str.Len(nd.name) > 0:
        ret
    end
    idx := v.lam_n
    v.lam_n += 1
    name := "salam_lambda_" + co.I64Toa(idx as i64)
    envty := "%lam." + co.I64Toa(idx as i64) + ".env"
    at.SetName(a, n, name)
    rts := func_ret(nd.type_str)
    ncap := nd.captures.len()

    mut et := co.SbNew()
    co.SbPuts(et, envty + " = type { ptr")
    repeat ncap with ci:
        cap := at.Get(a, nd.captures.get(ci)[0])
        co.SbPuts(et, ", " + ty_of(v, s, a, cap.type_str))
    end
    co.SbPuts(et, " }\n")
    out_g(v, co.SbCstr(et))
    co.SbFree(et)
    if ncap == 0:
        out_g(
            v, "@" + name + ".env = internal global " + envty + " { ptr @" + name + " }\n"
        )
    end

    saved_bb := v.bb
    saved_ba := v.ba
    saved_in_fn := v.in_fn
    saved_tmp := v.tmp
    saved_lbl := v.lbl
    saved_nloop := v.nloop
    saved_main := v.is_main
    saved_term := v.term
    saved_ret := v.ret_ts
    saved_self := v.self_ts
    saved_this := v.this_ref
    saved_sp := v.cur_sp
    saved_dbg := v.cur_dbg
    saved_lam := v.cur_lambda
    saved_env := v.env_ref
    saved_envty := v.env_ty
    saved_locals := v.locals
    saved_defers := v.defers
    saved_mres := v.match_result_ptr
    saved_mts := v.match_result_ts
    saved_mmerge := v.match_merge_block

    v.bb = str.NewBuilder()
    v.ba = str.NewBuilder()
    v.in_fn = true
    v.tmp = 0
    v.lbl = 0
    v.nloop = 0
    v.term = false
    v.is_main = false
    v.ret_ts = rts
    v.self_ts = ""
    v.this_ref = ""
    v.cur_lambda = n
    v.env_ref = "%env"
    v.env_ty = envty
    v.match_result_ptr = ""
    v.match_result_ts = ""
    v.match_merge_block = ""
    v.locals = Vector {} as Vector<LvVar>
    v.defers = Vector {} as Vector<int>

    mut hdr := co.SbNew()
    co.SbPuts(
        hdr, "define internal " + ty_of(v, s, a, rts) + " @" + name + "(ptr noundef %env"
    )
    repeat at.ChildCount(a, n) with i:
        p := at.Get(a, nd.list.get(i)[0])
        if p.is_ref:
            co.SbPuts(hdr, ", ptr %arg" + co.I64Toa(i as i64))
        else:
            co.SbPuts(
                hdr, ", " + ty_of(v, s, a, p.type_str) + " %arg" + co.I64Toa(i as i64)
            )
        end
    end
    co.SbPuts(hdr, ") nounwind {\n")
    header := co.SbCstr(hdr)
    co.SbFree(hdr)

    repeat at.ChildCount(a, n) with i2:
        p2 := at.Get(a, nd.list.get(i2)[0])
        if p2.is_ref:
            local_add(v, p2.name, "%arg" + co.I64Toa(i2 as i64), p2.type_str)
        else:
            ptr2 := "%p." + safe_name(p2.name)
            emit_alloca(v, ptr2 + " = alloca " + ty_of(v, s, a, p2.type_str))
            emit(
                v, "store " + ty_of(v, s, a, p2.type_str) + " %arg" + co.I64Toa(i2 as i64) + ", ptr " + ptr2
            )
            local_add(v, p2.name, ptr2, p2.type_str)
        end
    end
    if nd.a != 0:
        lv_block_top(v, s, a, nd.a)
    end
    if !v.term:
        emit_return(v, s, a, 0)
    end

    out_g(v, header)
    out_g(v, "entry:\n")
    out_g(v, co.SbCstr(v.ba))
    out_g(v, co.SbCstr(v.bb))
    out_g(v, "}\n\n")
    str.BufFree(v.bb)
    str.BufFree(v.ba)

    v.bb = saved_bb
    v.ba = saved_ba
    v.in_fn = saved_in_fn
    v.tmp = saved_tmp
    v.lbl = saved_lbl
    v.nloop = saved_nloop
    v.is_main = saved_main
    v.term = saved_term
    v.ret_ts = saved_ret
    v.self_ts = saved_self
    v.this_ref = saved_this
    v.cur_sp = saved_sp
    v.cur_dbg = saved_dbg
    v.cur_lambda = saved_lam
    v.env_ref = saved_env
    v.env_ty = saved_envty
    v.locals.free()
    v.defers.free()
    v.locals = saved_locals
    v.defers = saved_defers
    v.match_result_ptr = saved_mres
    v.match_result_ts = saved_mts
    v.match_merge_block = saved_mmerge
end

// ll_text_is_int
func text_is_int(sx: str): bool:
    n := str.Len(sx)
    if n == 0:
        ret false
    end
    mut i := byte_at(sx, 0) == 45 ? 1 : 0
    if i >= n:
        ret false
    end
    until i < n:
        c := byte_at(sx, i)
        if c < 48 || c > 57:
            ret false
        end
        i += 1
    end
    ret true
end

// ll_const_fpfix
func const_fpfix(lety: str, vtext: str): str:
    if (str.Equals(lety, "double") || str.Equals(lety, "float")) && text_is_int(vtext):
        ret vtext + ".0"
    end
    ret vtext
end

// ll_const_value - true when `n` folds to a global-initializer constant.
func const_value(
    v &: Lv, s &: sm.Sema, a &: at.Ast, n: int, out2 &: str
): bool:
    if n == 0:
        ret false
    end
    nd := at.Get(a, n)
    if nd.kind == at.AST_CAST:
        ret const_value(v, s, a, nd.a, out2)
    end
    if nd.kind == at.AST_LITERAL:
        op := nd.op
        if op == tok.TK_INT || op == tok.TK_FLOAT || op == tok.TK_STRING || op == tok.TK_TRIPLE_STRING || op == tok.TK_RAW_STRING || op == tok.TK_UTF8_CHAR || op == tok.TK_CHAR || op == tok.TK_KW_TRUE || op == tok.TK_KW_FALSE || op == tok.TK_KW_NULL:
            out2 = lv_expr(v, s, a, n).ref
            ret true
        end
        ret false
    end
    if nd.kind == at.AST_ARRAY_LIT || nd.kind == at.AST_STRUCT_LIT:
        ret const_agg(v, s, a, n, out2)
    end
    ret false
end

// ll_const_agg
func const_agg(v &: Lv, s &: sm.Sema, a &: at.Ast, n: int, out2 &: str): bool:
    nd := at.Get(a, n)
    if nd.kind == at.AST_ARRAY_LIT:
        ats := nd.type_str
        if str.Len(ats) == 0 || idx_byte(ats, 91) < 0:
            ret false
        end
        ety := array_elem(ats)
        lety := ty_of(v, s, a, ety)
        if nd.list.len() == 0:
            out2 = "zeroinitializer"
            ret true
        end
        mut b := co.SbNew()
        co.SbPuts(b, "[")
        mut okall := true
        mut i := 0
        until i < nd.list.len() && okall:
            mut vtext := ""
            if !const_value(v, s, a, nd.list.get(i)[0], vtext):
                okall = false
            else:
                if i != 0:
                    co.SbPuts(b, ", ")
                end
                co.SbPuts(b, lety + " " + const_fpfix(lety, vtext))
            end
            i += 1
        end
        if !okall:
            co.SbFree(b)
            ret false
        end
        co.SbPuts(b, "]")
        out2 = co.SbCstr(b)
        co.SbFree(b)
        ret true
    end
    if nd.kind == at.AST_STRUCT_LIT:
        ss := struct_sym(
            v, s, a, str.Len(nd.type_str) > 0 ? nd.type_str : nd.name
        )
        if ss == 0:
            ret false
        end
        mut b2 := co.SbNew()
        co.SbPuts(b2, "{ ")
        mut idx := 0
        mut okall2 := true
        fsyms := sm.ScopeAt(s, sm.SymAt(s, ss).members).symbols
        mut fi := 0
        until fi < fsyms.len() && okall2:
            f := sm.SymAt(s, fsyms.get(fi)[0])
            if f.kind == sm.SYM_FIELD:
                fts := sm.ToString(s, f.ty)
                mut prov := 0
                repeat nd.list.len() with j:
                    fld := at.Get(a, nd.list.get(j)[0])
                    if prov == 0 && str.Len(fld.name) > 0 && str.Equals(fld.name, f.name):
                        prov = nd.list.get(j)[0]
                    end
                end
                mut vtext2 := ""
                if prov != 0:
                    if !const_value(v, s, a, at.Get(a, prov).a, vtext2):
                        okall2 = false
                    end
                else f.decl != 0 && at.Get(a, f.decl).a != 0:
                    if !const_value(v, s, a, at.Get(a, f.decl).a, vtext2):
                        okall2 = false
                    end
                else:
                    vtext2 = zero_of(fts)
                end
                if okall2:
                    flety := ty_of(v, s, a, fts)
                    if idx != 0:
                        co.SbPuts(b2, ", ")
                    end
                    co.SbPuts(b2, flety + " " + const_fpfix(flety, vtext2))
                    idx += 1
                end
            end
            fi += 1
        end
        if !okall2:
            co.SbFree(b2)
            ret false
        end
        if idx == 0:
            co.SbFree(b2)
            out2 = "zeroinitializer"
            ret true
        end
        co.SbPuts(b2, " }")
        out2 = co.SbCstr(b2)
        co.SbFree(b2)
        ret true
    end
    ret false
end

// ll_emit_globals
func emit_globals(v &: Lv, s &: sm.Sema, a &: at.Ast, program: int):
    mut any := false
    mut i := 0
    until i < at.ChildCount(a, program):
        d := at.Child(a, program, i)
        dn := at.Get(a, d)
        skip := (
            dn.kind != at.AST_CONST_DECL && dn.kind != at.AST_VAR_DECL
        ) || dn.is_extern
        if !skip:
            ts := str.Len(dn.type_str) > 0 ? dn.type_str : "i32"
            gref := "@g." + str.TrimPrefix(struct_ltype(dn.name), "%struct.")
            lty := ty_of(v, s, a, ts)
            mut init := ""
            mut cv := ""
            if dn.a != 0 && const_value(v, s, a, dn.a, cv):
                init = cv
            else:
                init = zero_of(ts)
                if dn.a != 0:
                    v.gdefer.push(d)
                end
            end
            out_g(v, gref + " = internal global " + lty + " " + init + "\n")
            mut gv := LvVar {}
            gv.name = dn.name
            gv.ptr = gref
            gv.ts = ts
            v.globals.push(gv)
            any = true
        end
        i += 1
    end
    if any:
        out_g(v, "\n")
    end
end

// ll_extern_seen
func extern_seen(v &: Lv, name: str): bool:
    repeat 16 with p:
        if str.Equals(name, k_lv_prologue_externs[p]):
            ret true
        end
    end
    repeat v.extern_names.len() with i:
        if str.Equals(name, v.extern_names.get(i)[0]):
            ret true
        end
    end
    ret false
end

// ll_emit_externs_in
func emit_externs_in(v &: Lv, s &: sm.Sema, a &: at.Ast, gsc: int):
    syms := sm.ScopeAt(s, gsc).symbols
    repeat syms.len() with i:
        symid := syms.get(i)[0]
        sy := sm.SymAt(s, symid)
        mut skip := sy.kind != sm.SYM_FUNC || sy.overloads.len() == 0
        mut sigid := 0
        if !skip:
            sigid = sy.overloads.get(0)[0]
            d := sm.SigAt(s, sigid).decl
            if d == 0:
                skip = true
            else:
                dn := at.Get(a, d)
                if !dn.is_extern || dn.a != 0:
                    skip = true
                end
            end
        end
        if !skip && extern_seen(v, sy.name):
            skip = true
        end
        if !skip:
            repeat v.emitted.len() with ke:
                if str.Equals(sy.name, v.emitted.get(ke)[0]):
                    skip = true
                end
            end
        end
        if !skip:
            v.extern_names.push(sy.name)
            sg := sm.SigAt(s, sigid)
            dn2 := at.Get(a, sg.decl)
            mut b := co.SbNew()
            co.SbPuts(
                b, "declare " + ty_of(v, s, a, sm.ToString(s, sg.ret_type)) + " @" + sy.name + "("
            )
            repeat sg.params.len() with j:
                if j != 0:
                    co.SbPuts(b, ", ")
                end
                co.SbPuts(
                    b, ty_of(
                        v, s, a, sm.ToString(s, sg.params.get(j)[0])
                    )
                )
            end
            if sg.variadic:
                co.SbPuts(b, sg.params.len() > 0 ? ", ..." : "...")
            end
            co.SbPuts(b, ")")
            if dn2.is_pure:
                co.SbPuts(b, " nounwind willreturn nofree nosync memory(read)")
            end
            if dn2.is_noret:
                co.SbPuts(b, " noreturn")
            end
            co.SbPuts(b, "\n")
            out_g(v, co.SbCstr(b))
            co.SbFree(b)
        end
    end
end

// ll_emit_externs
func emit_externs(v &: Lv, s &: sm.Sema, a &: at.Ast):
    emit_externs_in(v, s, a, s.global)
end

// ll_touch_pkg - emit a package's struct types/externs/globals/impls once.
func touch_pkg(v &: Lv, s &: sm.Sema, a &: at.Ast, pk: int):
    if pk == 0:
        ret
    end
    py := sm.SymAt(s, pk)
    if py.kind != sm.SYM_PACKAGE || py.decl == 0:
        ret
    end
    repeat v.pkg_touched.len() with i:
        if v.pkg_touched.get(i)[0] == pk:
            ret
        end
    end
    v.pkg_touched.push(pk)
    prog := py.decl
    saved := v.pkg_scope
    v.pkg_scope = py.members
    emit_struct_types(v, s, a, prog)
    if py.members != 0:
        emit_externs_in(v, s, a, py.members)
    end
    emit_globals(v, s, a, prog)
    if py.members != 0:
        emit_impls_in(v, s, a, py.members)
    end
    v.pkg_scope = saved
end

// ll_touch_pkg_named
func touch_pkg_named(v &: Lv, s &: sm.Sema, a &: at.Ast, pkgname: str):
    if str.Len(pkgname) == 0:
        ret
    end
    repeat sm.PackageCount(s) with i:
        pk := sm.PackageAt(s, i)
        if pk != 0 && str.Equals(sm.SymAt(s, pk).pkgname, pkgname):
            touch_pkg(v, s, a, pk)
            ret
        end
    end
end

// ll_emit_global_inits - runs at the top of main().
func emit_global_inits(v &: Lv, s &: sm.Sema, a &: at.Ast):
    repeat v.gdefer.len() with i:
        d := v.gdefer.get(i)[0]
        dn := at.Get(a, d)
        gi := global_find(v, dn.name)
        if gi >= 0:
            g := v.globals.get(gi)[0]
            val := conv(v, s, a, lv_expr(v, s, a, dn.a), g.ts)
            emit(
                v, "store " + ty_of(v, s, a, g.ts) + " " + val + ", ptr " + g.ptr
            )
        end
    end
end

// ===== codegen_llvm_stmt.c (stage A slice - B must NOT re-port) =====

// ll_emit_defers - LIFO defer replay (body statements come from lv_stmt).
func emit_defers(v &: Lv, s &: sm.Sema, a &: at.Ast):
    mut i := v.defers.len()
    until i > 0:
        lv_stmt(v, s, a, v.defers.get(i - 1)[0])
        i -= 1
    end
end

// ll_emit_return
func emit_return(v &: Lv, s &: sm.Sema, a &: at.Ast, value: int):
    if str.Len(v.match_result_ptr) > 0:
        if value != 0:
            val := conv(v, s, a, lv_expr(v, s, a, value), v.match_result_ts)
            emit(
                v, "store " + ty_of(v, s, a, v.match_result_ts) + " " + val + ", ptr " + v.match_result_ptr
            )
        end
        emit_term(v, "br label %" + v.match_merge_block)
        ret
    end
    if v.is_main:
        mut val := ""
        if value != 0:
            val = conv(v, s, a, lv_expr(v, s, a, value), "i32")
        end
        emit_defers(v, s, a)
        if value != 0:
            emit_term(v, "ret i32 " + val)
        else:
            emit_term(v, "ret i32 0")
        end
        ret
    end
    if str.Len(v.ret_ts) == 0 || str.Equals(v.ret_ts, "void"):
        emit_defers(v, s, a)
        emit_term(v, "ret void")
        ret
    end
    val2 := conv(v, s, a, lv_expr(v, s, a, value), v.ret_ts)
    emit_defers(v, s, a)
    emit_term(v, "ret " + ty_of(v, s, a, v.ret_ts) + " " + val2)
end

// ===== codegen_llvm_debug.c (stage A - C stage must NOT re-port) =====

// ll_meta_add
func meta_add(v &: Lv, text: str): str:
    id := "!" + co.I64Toa(v.meta_n as i64)
    v.meta_n += 1
    out_meta(v, id + " = " + text + "\n")
    ret id
end

// di_escape
func di_escape(sx: str): str:
    n := str.Len(sx)
    mut b := co.SbNew()
    mut i := 0
    until i < n:
        c := byte_at(sx, i)
        if c == 92 || c == 34:
            co.SbPutc(b, 92)
        end
        co.SbPutc(b, c)
        i += 1
    end
    r := co.SbCstr(b)
    co.SbFree(b)
    ret r
end

// di_split_path
func di_split_path(v &: Lv, path: str):
    if str.Len(path) == 0:
        v.src_file = v.module + ".salam"
        v.src_dir = "."
        ret
    end
    slash := last_byte(path, 47)
    bs := last_byte(path, 92)
    mut cut := slash
    if bs >= 0 && (slash < 0 || bs > slash):
        cut = bs
    end
    if cut >= 0:
        v.src_file = str.Substr(path, cut + 1, str.Len(path) - cut - 1)
        v.src_dir = str.Substr(path, 0, cut)
    else:
        v.src_file = path
        v.src_dir = "."
    end
end

// ll_debug_init
func debug_init(v &: Lv, src_path: str):
    di_split_path(v, src_path)
    v.di_file = meta_add(
        v, "!DIFile(filename: \"" + di_escape(v.src_file) + "\", directory: \"" + di_escape(v.src_dir) + "\")"
    )
    v.di_cu = meta_add(
        v, "distinct !DICompileUnit(language: DW_LANG_C99, " + "file: " + v.di_file + ", producer: \"salam\", " + "isOptimized: false, runtimeVersion: 0, " + "emissionKind: FullDebug)"
    )
    types := meta_add(v, "!{null}")
    v.di_subty = meta_add(v, "!DISubroutineType(types: " + types + ")")
    v.di_flag_dwarf = meta_add(v, "!{i32 7, !\"Dwarf Version\", i32 5}")
    v.di_flag_debug = meta_add(v, "!{i32 2, !\"Debug Info Version\", i32 3}")
end

// ll_debug_subprogram
func debug_subprogram(v &: Lv, name: str, line: int): str:
    sp := meta_add(
        v, "distinct !DISubprogram(name: \"" + name + "\", scope: " + v.di_file + ", file: " + v.di_file + ", line: " + co.I64Toa(line as i64) + ", type: " + v.di_subty + ", scopeLine: " + co.I64Toa(line as i64) + ", spFlags: DISPFlagDefinition, unit: " + v.di_cu + ")"
    )
    v.cur_sp = sp
    ret sp
end

// ll_debug_location - "" when there is no current subprogram (C NULL).
func debug_location(v &: Lv, line: int, col: int): str:
    if str.Len(v.cur_sp) == 0:
        ret ""
    end
    ret meta_add(
        v, "!DILocation(line: " + co.I64Toa(line as i64) + ", column: " + co.I64Toa(col as i64) + ", scope: " + v.cur_sp + ")"
    )
end

// ll_debug_finalize
func debug_finalize(v &: Lv):
    if !v.debug:
        ret
    end
    out_g(v, "\n")
    out_g(
        v, "!llvm.module.flags = !{" + v.di_flag_dwarf + ", " + v.di_flag_debug + "}\n"
    )
    out_g(v, "!llvm.dbg.cu = !{" + v.di_cu + "}\n")
    out_g(v, co.SbCstr(v.bmeta))
end

// ===========================================================================
// >>> STAGE B INSERTION POINT - replace the three stubs below IN PLACE and
// >>> add the rest of codegen_llvm_expr.c / codegen_llvm_stmt.c here as new
// >>> private functions (ll_binary -> lv_binary, ll_addr_of -> lv_addr_of,
// >>> ll_index_set, ll_match_arm_cond, ll_call*, ll_literal, ll_struct_lit,
// >>> ll_array_lit, ll_slice_expr, ll_lambda_value, ll_match_expr,
// >>> ll_lower_print, ...). Everything ABOVE this banner is stage A and
// >>> must not be re-ported (incl. emit_defers/emit_return/emit_lambda and
// >>> all of the debug slice). Loop-stack protocol: on loop entry, if
// >>> v.brk.len() == v.nloop push, else v.brk.set(v.nloop, ...); same for
// >>> v.cont; then v.nloop += 1 (the C wrote brk[nloop] in place).
// ===========================================================================

// ===== codegen_llvm_expr.c =====

// ll_arith_op
// No 'nsw'/'nuw': salam defines signed and unsigned overflow alike as
// two's-complement wrap (SALAM-TYPES.md 4.1), while 'nsw' tells LLVM that
// signed overflow is poison - which let `(100 as i8) + (100 as i8)` fold to
// 200 instead of wrapping to -56.
func arith_op(k: int, isflt: bool, issigned: bool): str:
    if k == tok.TK_PLUS:
        ret isflt ? "fadd" : "add"
    end
    if k == tok.TK_MINUS:
        ret isflt ? "fsub" : "sub"
    end
    if k == tok.TK_STAR:
        ret isflt ? "fmul" : "mul"
    end
    if k == tok.TK_SLASH:
        ret isflt ? "fdiv" : (issigned ? "sdiv" : "udiv")
    end
    if k == tok.TK_PERCENT:
        ret isflt ? "frem" : (issigned ? "srem" : "urem")
    end
    if k == tok.TK_AMP:
        ret "and"
    end
    if k == tok.TK_PIPE:
        ret "or"
    end
    if k == tok.TK_CARET:
        ret "xor"
    end
    if k == tok.TK_SHL:
        ret "shl"
    end
    if k == tok.TK_SHR:
        ret issigned ? "ashr" : "lshr"
    end
    ret ""
end

// ll_cmp_pred
func cmp_pred(k: int, isflt: bool, issigned: bool): str:
    if k == tok.TK_EQ:
        ret isflt ? "oeq" : "eq"
    end
    if k == tok.TK_NE:
        ret isflt ? "one" : "ne"
    end
    if k == tok.TK_LT:
        ret isflt ? "olt" : (issigned ? "slt" : "ult")
    end
    if k == tok.TK_GT:
        ret isflt ? "ogt" : (issigned ? "sgt" : "ugt")
    end
    if k == tok.TK_LE:
        ret isflt ? "ole" : (issigned ? "sle" : "ule")
    end
    if k == tok.TK_GE:
        ret isflt ? "oge" : (issigned ? "sge" : "uge")
    end
    ret ""
end

// ll_is_cmp
func is_cmp_op(k: int): bool:
    ret k == tok.TK_EQ || k == tok.TK_NE || k == tok.TK_LT || k == tok.TK_GT || k == tok.TK_LE || k == tok.TK_GE
end

// ll_to_ptr
func to_ptr(v &: Lv, s &: sm.Sema, a &: at.Ast, val: Llv): str:
    if is_ptr_ts(val.ts) || is_str(val.ts) || str.Equals(val.ts, "null"):
        ret val.ref
    end
    r := new_tmp(v)
    emit(v, r + " = inttoptr " + ty_of(v, s, a, val.ts) + " " + val.ref + " to ptr")
    ret r
end

// ll_str_operand
func str_operand(v &: Lv, s &: sm.Sema, a &: at.Ast, n: int): str:
    nd := at.Get(a, n)
    ts := nd.type_str
    if str.Len(ts) > 0 && is_str(ts):
        ret lv_expr(v, s, a, n).ref
    end
    val := lv_expr(v, s, a, n)
    mut r := new_tmp(v)
    if is_bool(ts):
        t := strconst(v, "true")
        f := strconst(v, "false")
        emit(v, r + " = select i1 " + val.ref + ", ptr " + t + ", ptr " + f)
    else str.Equals(ts, "char"):
        need(v, LV_H_CHARSTR)
        emit(
            v, r + " = call ptr @salam_ll_charstr(i32 " + conv(v, s, a, val, "i32") + ")"
        )
    else is_float(ts):
        need(v, LV_H_F64STR)
        emit(
            v, r + " = call ptr @salam_ll_f64str(double " + conv(v, s, a, val, "f64") + ")"
        )
    else is_int_ts(ts):
        if is_signed_ts(ts):
            need(v, LV_H_I64STR)
            emit(
                v, r + " = call ptr @salam_ll_i64str(i64 " + conv(v, s, a, val, "i64") + ")"
            )
        else:
            need(v, LV_H_U64STR)
            emit(
                v, r + " = call ptr @salam_ll_u64str(i64 " + conv(v, s, a, val, "u64") + ")"
            )
        end
    else:
        lv_error(
            v, a, n, "string concatenation with an unsupported operand type '" + (str.Len(ts) > 0 ? ts : "?") + "'"
        )
        r = val.ref
    end
    ret r
end

// ll_binary_string
func binary_string(
    v &: Lv, s &: sm.Sema, a &: at.Ast, n: int, op: int, out2 &: Llv
): bool:
    nd := at.Get(a, n)
    an := at.Get(a, nd.a)
    bn := at.Get(a, nd.b)
    as2 := str.Len(an.type_str) > 0 && is_str(an.type_str)
    bs2 := str.Len(bn.type_str) > 0 && is_str(bn.type_str)
    if op == tok.TK_PLUS && (as2 || bs2):
        l := str_operand(v, s, a, nd.a)
        r2 := str_operand(v, s, a, nd.b)
        r := new_tmp(v)
        need(v, LV_H_STRCAT)
        emit(v, r + " = call ptr @salam_ll_strcat(ptr " + l + ", ptr " + r2 + ")")
        out2 = make_llv(r, "str")
        ret true
    end
    if op == tok.TK_STAR && (as2 || bs2):
        sop := as2 ? nd.a : nd.b
        nop := as2 ? nd.b : nd.a
        sv := lv_expr(v, s, a, sop).ref
        nv := conv(v, s, a, lv_expr(v, s, a, nop), "i32")
        r3 := new_tmp(v)
        need(v, LV_H_REPEAT)
        emit(v, r3 + " = call ptr @salam_ll_repeat(ptr " + sv + ", i32 " + nv + ")")
        out2 = make_llv(r3, "str")
        ret true
    end
    if is_cmp_op(op) && as2 && bs2:
        l2 := lv_expr(v, s, a, nd.a)
        r4 := lv_expr(v, s, a, nd.b)
        c := new_tmp(v)
        r5 := new_tmp(v)
        emit(v, c + " = call i32 @strcmp(ptr " + l2.ref + ", ptr " + r4.ref + ")")
        emit(v, r5 + " = icmp " + cmp_pred(op, false, true) + " i32 " + c + ", 0")
        out2 = make_llv(r5, "bool")
        ret true
    end
    ret false
end

// ll_binary_pow
func binary_pow(v &: Lv, s &: sm.Sema, a &: at.Ast, n: int): Llv:
    nd := at.Get(a, n)
    l := conv(v, s, a, lv_expr(v, s, a, nd.a), "f64")
    r2 := conv(v, s, a, lv_expr(v, s, a, nd.b), "f64")
    r := new_tmp(v)
    emit(v, r + " = call double @llvm.pow.f64(double " + l + ", double " + r2 + ")")
    if str.Len(nd.type_str) > 0 && !is_float(nd.type_str):
        ret make_llv(conv(v, s, a, make_llv(r, "f64"), nd.type_str), nd.type_str)
    end
    ret make_llv(r, str.Len(nd.type_str) > 0 ? nd.type_str : "f64")
end

// ll_op_method_name
func op_method_name(k: int): str:
    if k == tok.TK_PLUS:
        ret "operator_add"
    end
    if k == tok.TK_MINUS:
        ret "operator_sub"
    end
    if k == tok.TK_STAR:
        ret "operator_mul"
    end
    if k == tok.TK_SLASH:
        ret "operator_div"
    end
    if k == tok.TK_PERCENT:
        ret "operator_mod"
    end
    if k == tok.TK_POWER:
        ret "operator_pow"
    end
    if k == tok.TK_EQ:
        ret "operator_eq"
    end
    if k == tok.TK_NE:
        ret "operator_ne"
    end
    if k == tok.TK_LT:
        ret "operator_lt"
    end
    if k == tok.TK_GT:
        ret "operator_gt"
    end
    if k == tok.TK_LE:
        ret "operator_le"
    end
    if k == tok.TK_GE:
        ret "operator_ge"
    end
    ret ""
end

// ll_op_struct - sname2 receives the (possibly de-pointered) type name;
// returns the struct SymId, 0 = none.
func op_struct(v &: Lv, s &: sm.Sema, a &: at.Ast, ts: str, sname2 &: str): int:
    if str.Len(ts) == 0:
        ret 0
    end
    sname2 = is_ptr_ts(ts) ? str.Substr(ts, 0, str.Len(ts) - 1) : ts
    ret struct_sym(v, s, a, sname2)
end

// ll_pick_arity - first overload of `symid` with exactly `want` params,
// 0 = none.
func pick_arity(s &: sm.Sema, symid: int, want: int): int:
    sy := sm.SymAt(s, symid)
    mut i := 0
    until i < sy.overloads.len():
        sigid := sy.overloads.get(i)[0]
        if sm.SigAt(s, sigid).params.len() == want:
            ret sigid
        end
        i += 1
    end
    ret 0
end

// ll_op_call - rhs = 0 for a unary operator method.
func op_call(
    v &: Lv, s &: sm.Sema, a &: at.Ast, recv: int, sname2: str, ss: int, mname: str, rhs: int, out2 &: Llv
): bool:
    ms := sm.LookupLocal(s, sm.SymAt(s, ss).members, mname)
    if ms == 0 || sm.SymAt(s, ms).kind != sm.SYM_METHOD:
        ret false
    end
    sig := pick_arity(s, ms, rhs != 0 ? 1 : 0)
    if sig == 0:
        ret false
    end
    recvn := at.Get(a, recv)
    recvref := is_ptr_ts(recvn.type_str) ? lv_expr(v, s, a, recv).ref : lv_addr_of(v, s, a, recv).ptr
    mut argsb := "ptr " + recvref
    if rhs != 0:
        sg := sm.SigAt(s, sig)
        mut pts := sg.params.len() > 0 ? sm.ToString(s, sg.params.get(0)[0]) : ""
        rv := lv_expr(v, s, a, rhs)
        if str.Len(pts) == 0:
            pts = rv.ts
        end
        argsb = argsb + ", " + ty_of(v, s, a, pts) + " " + conv(v, s, a, rv, pts)
    end
    rts := sm.ToString(s, sm.SigAt(s, sig).ret_type)
    fname := mangle(v, s, sname2, mname, sig)
    if str.Equals(rts, "void"):
        emit(v, "call void @" + fname + "(" + argsb + ")")
        out2 = make_llv("0", "void")
        ret true
    end
    r := new_tmp(v)
    emit(v, r + " = call " + ty_of(v, s, a, rts) + " @" + fname + "(" + argsb + ")")
    out2 = make_llv(r, rts)
    ret true
end

// ll_index_set
func lv_index_set(v &: Lv, s &: sm.Sema, a &: at.Ast, idx: int, value: int): bool:
    idxn := at.Get(a, idx)
    if idxn.a == 0 || str.Len(at.Get(a, idxn.a).type_str) == 0:
        ret false
    end
    mut sname2 := ""
    ss := op_struct(v, s, a, at.Get(a, idxn.a).type_str, sname2)
    if ss == 0:
        ret false
    end
    ms := sm.LookupLocal(s, sm.SymAt(s, ss).members, "operator_index_set")
    if ms == 0 || sm.SymAt(s, ms).kind != sm.SYM_METHOD:
        ret false
    end
    sig := pick_arity(s, ms, 2)
    if sig == 0:
        ret false
    end
    an := at.Get(a, idxn.a)
    recv := is_ptr_ts(an.type_str) ? lv_expr(v, s, a, idxn.a).ref : lv_addr_of(v, s, a, idxn.a).ptr
    sg := sm.SigAt(s, sig)
    p0 := sm.ToString(s, sg.params.get(0)[0])
    p1 := sm.ToString(s, sg.params.get(1)[0])
    iv := conv(v, s, a, lv_expr(v, s, a, idxn.b), p0)
    vv := conv(v, s, a, lv_expr(v, s, a, value), p1)
    fname := mangle(v, s, sname2, "operator_index_set", sig)
    emit(
        v, "call void @" + fname + "(ptr " + recv + ", " + ty_of(v, s, a, p0) + " " + iv + ", " + ty_of(v, s, a, p1) + " " + vv + ")"
    )
    ret true
end

// ll_binary
func lv_binary(v &: Lv, s &: sm.Sema, a &: at.Ast, n: int): Llv:
    nd := at.Get(a, n)
    op := nd.op

    mut sname2 := ""
    mut oss := 0
    if nd.a != 0:
        oss = op_struct(v, s, a, at.Get(a, nd.a).type_str, sname2)
    end
    if oss != 0:
        neg := op == tok.TK_NE && nd.synthetic
        mname := neg ? "operator_eq" : op_method_name(op)
        mut out2 := Llv {}
        if str.Len(mname) > 0 && op_call(
            v, s, a, nd.a, sname2, oss, mname, nd.b, out2
        ):
            if !neg:
                ret out2
            end
            r := new_tmp(v)
            emit(v, r + " = xor i1 " + out2.ref + ", true")
            ret make_llv(r, "bool")
        end
    end

    mut handled := Llv {}
    if binary_string(v, s, a, n, op, handled):
        ret handled
    end

    if op == tok.TK_AND || op == tok.TK_OR:
        is_and := op == tok.TK_AND
        rhsL := new_lbl(v, "sc_rhs")
        scL := new_lbl(v, "sc_short")
        joinL := new_lbl(v, "sc_join")
        endL := new_lbl(v, "sc_end")
        la := as_i1(v, s, a, lv_expr(v, s, a, nd.a))
        if is_and:
            emit_term(v, "br i1 " + la + ", label %" + rhsL + ", label %" + scL)
        else:
            emit_term(v, "br i1 " + la + ", label %" + scL + ", label %" + rhsL)
        end
        emit_label(v, scL)
        emit_term(v, "br label %" + endL)
        emit_label(v, rhsL)
        lb := as_i1(v, s, a, lv_expr(v, s, a, nd.b))
        emit_term(v, "br label %" + joinL)
        emit_label(v, joinL)
        emit_term(v, "br label %" + endL)
        emit_label(v, endL)
        r2 := new_tmp(v)
        emit(
            v, r2 + " = phi i1 [ " + (is_and ? "false" : "true") + ", %" + scL + " ], [ " + lb + ", %" + joinL + " ]"
        )
        ret make_llv(r2, "bool")
    end
    if op == tok.TK_POWER:
        ret binary_pow(v, s, a, n)
    end
    lval := lv_expr(v, s, a, nd.a)
    rval := lv_expr(v, s, a, nd.b)
    if is_cmp_op(op):
        lp := is_ptr_ts(lval.ts) || str.Equals(lval.ts, "null")
        rp := is_ptr_ts(rval.ts) || str.Equals(rval.ts, "null")
        if lp || rp:
            lc := to_ptr(v, s, a, lval)
            rc := to_ptr(v, s, a, rval)
            r3 := new_tmp(v)
            emit(
                v, r3 + " = icmp " + cmp_pred(op, false, false) + " ptr " + lc + ", " + rc
            )
            ret make_llv(r3, "bool")
        end
        common := common_ts(v, lval.ts, rval.ts)
        lc2 := conv(v, s, a, lval, common)
        rc2 := conv(v, s, a, rval, common)
        flt := is_float(common)
        r4 := new_tmp(v)
        emit(
            v, r4 + " = " + (flt ? "fcmp" : "icmp") + " " + cmp_pred(op, flt, is_signed_ts(common)) + " " + ty_of(v, s, a, common) + " " + lc2 + ", " + rc2
        )
        ret make_llv(r4, "bool")
    end

    rt := str.Len(nd.type_str) > 0 ? nd.type_str : common_ts(v, lval.ts, rval.ts)
    lc3 := conv(v, s, a, lval, rt)
    rc3 := conv(v, s, a, rval, rt)
    flt2 := is_float(rt)
    o := arith_op(op, flt2, is_signed_ts(rt))
    if str.Len(o) == 0:
        lv_error(v, a, n, "binary operator")
        ret poison(rt)
    end
    r5 := new_tmp(v)
    emit(v, r5 + " = " + o + " " + ty_of(v, s, a, rt) + " " + lc3 + ", " + rc3)
    ret make_llv(r5, rt)
end

// ll_unary
func lv_unary(v &: Lv, s &: sm.Sema, a &: at.Ast, n: int): Llv:
    nd := at.Get(a, n)
    if nd.a != 0 && (nd.op == tok.TK_MINUS || nd.op == tok.TK_NOT):
        mut sname2 := ""
        oss := op_struct(v, s, a, at.Get(a, nd.a).type_str, sname2)
        if oss != 0:
            mname := nd.op == tok.TK_MINUS ? "operator_sub" : "operator_not"
            mut out2 := Llv {}
            if op_call(v, s, a, nd.a, sname2, oss, mname, 0, out2):
                ret out2
            end
        end
    end
    if nd.op == tok.TK_NOT:
        vv := as_i1(v, s, a, lv_expr(v, s, a, nd.a))
        r := new_tmp(v)
        emit(v, r + " = xor i1 " + vv + ", true")
        ret make_llv(r, "bool")
    end
    if nd.op == tok.TK_MINUS:
        val := lv_expr(v, s, a, nd.a)
        rt := str.Len(nd.type_str) > 0 ? nd.type_str : val.ts
        cv := conv(v, s, a, val, rt)
        r2 := new_tmp(v)
        if is_float(rt):
            emit(v, r2 + " = fneg " + ty_of(v, s, a, rt) + " " + cv)
        else:
            emit(v, r2 + " = sub " + ty_of(v, s, a, rt) + " 0, " + cv)
        end
        ret make_llv(r2, rt)
    end
    if nd.op == tok.TK_TILDE:
        val2 := lv_expr(v, s, a, nd.a)
        rt2 := str.Len(nd.type_str) > 0 ? nd.type_str : val2.ts
        cv2 := conv(v, s, a, val2, rt2)
        r3 := new_tmp(v)
        emit(v, r3 + " = xor " + ty_of(v, s, a, rt2) + " " + cv2 + ", -1")
        ret make_llv(r3, rt2)
    end
    lv_error(v, a, n, "unary operator")
    ret poison(nd.type_str)
end

// ll_incdec
func lv_incdec(v &: Lv, s &: sm.Sema, a &: at.Ast, n: int): Llv:
    nd := at.Get(a, n)
    tgt := nd.a
    tk := tgt != 0 ? at.KindOf(a, tgt) : 0 - 1
    if tgt == 0 || (
        tk != at.AST_IDENTIFIER && tk != at.AST_MEMBER && tk != at.AST_INDEX
    ):
        lv_error(v, a, n, "operand of '++'/'--' is not assignable")
        ret poison(nd.type_str)
    end
    addr := lv_addr_of(v, s, a, tgt)
    ts := addr.ts
    oldv := new_tmp(v)
    emit(v, oldv + " = load " + ty_of(v, s, a, ts) + ", ptr " + addr.ptr)
    flt := is_float(ts)
    step := flt ? "1.0" : "1"
    op2 := arith_op(
        nd.op == tok.TK_PLUS_PLUS ? tok.TK_PLUS : tok.TK_MINUS, flt, is_signed_ts(ts)
    )
    newv := new_tmp(v)
    emit(v, newv + " = " + op2 + " " + ty_of(v, s, a, ts) + " " + oldv + ", " + step)
    emit(v, "store " + ty_of(v, s, a, ts) + " " + newv + ", ptr " + addr.ptr)
    ret make_llv(nd.is_prefix ? newv : oldv, ts)
end

// ll_lower_print
func lv_lower_print(
    v &: Lv, s &: sm.Sema, a &: at.Ast, n: int, nl: bool, err: bool
):
    mut segs := Vector {} as Vector<cg.PfSeg>
    defer segs.free()
    cg.PfBuild(a, n, nl, segs)
    if segs.len() == 0:
        ret
    end

    buffered := v.single_threaded && !err

    if buffered:
        mut all_lit := true
        mut i := 0
        until i < segs.len() && all_lit:
            if segs.get(i)[0].kind != cg.PF_LIT:
                all_lit = false
            end
            i += 1
        end
        if all_lit:
            mut raw := co.SbNew()
            mut j := 0
            until j < segs.len():
                co.SbPuts(raw, segs.get(j)[0].text)
                j += 1
            end
            rawlen := co.SbLen(raw)
            lit := strconst(v, co.SbCstr(raw))
            co.SbFree(raw)
            if rawlen > (0 as i64):
                need(v, LV_H_OUTBUF)
                emit(
                    v, "call void @salam_out_write(ptr " + lit + ", i64 " + co.I64Toa(rawlen) + ")"
                )
            end
            ret
        end
    end

    mut fmt := co.SbNew()
    mut argsb := co.SbNew()
    mut k := 0
    until k < segs.len():
        sg := segs.get(k)[0]
        if sg.kind == cg.PF_LIT:
            tn := str.Len(sg.text)
            mut ti := 0
            until ti < tn:
                ch := byte_at(sg.text, ti)
                if ch == 37:
                    co.SbPutc(fmt, 37)
                end
                co.SbPutc(fmt, ch)
                ti += 1
            end
        else:
            val := lv_expr(v, s, a, sg.expr)
            co.SbPuts(fmt, cg.PfSpec(sg.kind))
            mut av := ""
            if sg.kind == cg.PF_STR:
                av = ", ptr " + val.ref
            else sg.kind == cg.PF_BOOL:
                t2 := strconst(v, "true")
                f2 := strconst(v, "false")
                sel := new_tmp(v)
                emit(
                    v, sel + " = select i1 " + val.ref + ", ptr " + t2 + ", ptr " + f2
                )
                av = ", ptr " + sel
            else sg.kind == cg.PF_CHAR:
                av = ", i32 " + conv(v, s, a, val, "i32")
            else sg.kind == cg.PF_F64:
                av = ", double " + conv(v, s, a, val, "f64")
            else sg.kind == cg.PF_I32:
                av = ", i32 " + conv(v, s, a, val, "i32")
            else sg.kind == cg.PF_U32:
                av = ", i32 " + conv(v, s, a, val, "u32")
            else sg.kind == cg.PF_I64:
                av = ", i64 " + val.ref
            else sg.kind == cg.PF_U64:
                av = ", i64 " + val.ref
            else sg.kind == cg.PF_SIZE:
                av = ", " + v.usize + " " + conv(v, s, a, val, "size")
            end
            co.SbPuts(argsb, av)
        end
        k += 1
    end
    f := strconst(v, co.SbCstr(fmt))
    if v.single_threaded:
        need(v, LV_H_OUTBUF)
        emit(v, "call void @salam_out_flush()")
    end
    t := new_tmp(v)
    if err && target_is_windows_of(v.triple):
        emit(
            v, t + " = call i32 (ptr, ...) @printf(ptr " + f + co.SbCstr(argsb) + ")"
        )
    else err:
        emit(
            v, t + " = call i32 (i32, ptr, ...) @dprintf(i32 2, ptr " + f + co.SbCstr(argsb) + ")"
        )
    else:
        emit(
            v, t + " = call i32 (ptr, ...) @printf(ptr " + f + co.SbCstr(argsb) + ")"
        )
        if buffered:
            sp := new_tmp(v)
            emit(v, sp + " = load ptr, ptr @stdout")
            t2b := new_tmp(v)
            emit(v, t2b + " = call i32 @fflush(ptr " + sp + ")")
        end
    end
    co.SbFree(fmt)
    co.SbFree(argsb)
end

// ll_param_is_ref
func param_is_ref(s &: sm.Sema, a &: at.Ast, sig: int, i: int): bool:
    decl := sm.SigAt(s, sig).decl
    if decl == 0:
        ret false
    end
    dn := at.Get(a, decl)
    if i >= dn.list.len():
        ret false
    end
    ret at.Get(a, dn.list.get(i)[0]).is_ref
end

// ll_emit_arg
func emit_arg(
    v &: Lv, s &: sm.Sema, a &: at.Ast, ab &: str.StringBuilder, arg: int, sig: int, i: int
):
    if param_is_ref(s, a, sig, i):
        addr := lv_addr_of(v, s, a, arg)
        co.SbPuts(ab, "ptr " + addr.ptr)
        ret
    end
    val := lv_expr(v, s, a, arg)
    sg := sm.SigAt(s, sig)
    pts := i < sg.params.len() ? sm.ToString(s, sg.params.get(i)[0]) : val.ts
    co.SbPuts(ab, ty_of(v, s, a, pts) + " " + conv(v, s, a, val, pts))
end

// ll_fill_defaults
func fill_defaults(
    v &: Lv, s &: sm.Sema, a &: at.Ast, ab &: str.StringBuilder, n: int, sig: int, first0: bool
):
    if sig == 0:
        ret
    end
    decl := sm.SigAt(s, sig).decl
    if decl == 0:
        ret
    end
    dn := at.Get(a, decl)
    np := dn.list.len()
    nn := at.Get(a, n)
    mut first := first0
    mut i := nn.list.len()
    until i < np:
        param := at.Get(a, dn.list.get(i)[0])
        if param.a != 0:
            if !first:
                co.SbPuts(ab, ", ")
            end
            emit_arg(v, s, a, ab, param.a, sig, i)
            first = false
        end
        i += 1
    end
end

// ll_call_user
func call_user(v &: Lv, s &: sm.Sema, a &: at.Ast, n: int, nm: str): Llv:
    fsym := sym_of(v, s, a, nm)
    if fsym == 0 || sm.SymAt(s, fsym).kind != sm.SYM_FUNC:
        lv_error(v, a, n, "call to unknown/unsupported function '" + nm + "'")
        ret poison(at.Get(a, n).type_str)
    end
    sig := pick_overload(v, s, a, fsym, n)
    ensure_fn(v, s, a, sm.SigAt(s, sig).decl, 0, v.pkg_scope)
    nn := at.Get(a, n)
    mut ab := co.SbNew()
    mut i := 0
    until i < nn.list.len():
        if i > 0:
            co.SbPuts(ab, ", ")
        end
        emit_arg(v, s, a, ab, nn.list.get(i)[0], sig, i)
        i += 1
    end
    fill_defaults(v, s, a, ab, n, sig, nn.list.len() == 0)
    argsx := co.SbCstr(ab)
    co.SbFree(ab)
    rts := sm.ToString(s, sm.SigAt(s, sig).ret_type)

    is_ext := sm.SigAt(s, sig).decl != 0 && at.Get(a, sm.SigAt(s, sig).decl).is_extern
    fname := is_ext ? nm : mangle(v, s, "", nm, sig)
    mut callty := ""
    if is_ext && sm.SigAt(s, sig).variadic:
        mut sp := co.SbNew()
        co.SbPutc(sp, 40)
        sg := sm.SigAt(s, sig)
        mut j := 0
        until j < sg.params.len():
            if j > 0:
                co.SbPuts(sp, ", ")
            end
            co.SbPuts(sp, ty_of(v, s, a, sm.ToString(s, sg.params.get(j)[0])))
            j += 1
        end
        co.SbPuts(sp, sg.params.len() > 0 ? ", ...)" : "...)")
        callty = " " + co.SbCstr(sp)
        co.SbFree(sp)
    end
    if str.Equals(rts, "void"):
        emit(v, "call void" + callty + " @" + fname + "(" + argsx + ")")
        ret make_llv("0", "void")
    end
    r := new_tmp(v)
    emit(
        v, r + " = call " + ty_of(v, s, a, rts) + callty + " @" + fname + "(" + argsx + ")"
    )
    ret make_llv(r, rts)
end

// ast_str_lit_len - -1 = not a foldable string literal.
func ast_str_lit_len(a &: at.Ast, n: int): i64:
    if n == 0:
        ret (0 - 1) as i64
    end
    nd := at.Get(a, n)
    if nd.kind != at.AST_LITERAL:
        ret (0 - 1) as i64
    end
    if nd.op != tok.TK_STRING && nd.op != tok.TK_TRIPLE_STRING && nd.op != tok.TK_RAW_STRING:
        ret (0 - 1) as i64
    end
    if nd.value_kind != tok.TV_STRING:
        ret (0 - 1) as i64
    end
    ret str.Len(nd.value_str) as i64
end

// ll_len_of
func len_of(v &: Lv, s &: sm.Sema, a &: at.Ast, n: int, arg: int): Llv:
    ts := at.Get(a, arg).type_str
    if is_slice(ts):
        val := lv_expr(v, s, a, arg)
        l := new_tmp(v)
        emit(v, l + " = extractvalue { ptr, i64 } " + val.ref + ", 1")
        ret make_llv(conv(v, s, a, make_llv(l, "i64"), "i32"), "i32")
    end
    if str.Len(ts) > 0 && idx_byte(ts, 91) >= 0:
        ret make_llv(co.I64Toa(array_dim(ts)), "i32")
    end
    if str.Len(ts) == 0 || !is_str(ts):
        lv_error(v, a, n, "len() of an unsupported type")
        ret poison("i32")
    end
    klen := ast_str_lit_len(a, arg)
    if klen >= (0 as i64):
        ret make_llv(co.I64Toa(klen), "i32")
    end
    val2 := lv_expr(v, s, a, arg)
    l2 := new_tmp(v)
    emit(v, l2 + " = call " + v.usize + " @strlen(ptr " + val2.ref + ")")
    ret make_llv(usize_to_i32(v, l2), "i32")
end

// ll_call_len
func call_len(v &: Lv, s &: sm.Sema, a &: at.Ast, n: int): Llv:
    ret len_of(v, s, a, n, at.Get(a, n).list.get(0)[0])
end

// ll_emit_call
func emit_call(
    v &: Lv, s &: sm.Sema, a &: at.Ast, n: int, sig: int, lead: str, fname: str, rts: str
): Llv:
    nn := at.Get(a, n)
    mut ab := co.SbNew()
    mut first := str.Len(lead) == 0
    if !first:
        co.SbPuts(ab, lead)
    end
    mut i := 0
    until i < nn.list.len():
        if !first:
            co.SbPuts(ab, ", ")
        end
        emit_arg(v, s, a, ab, nn.list.get(i)[0], sig, i)
        first = false
        i += 1
    end
    fill_defaults(v, s, a, ab, n, sig, first)
    argsx := co.SbCstr(ab)
    co.SbFree(ab)
    if str.Equals(rts, "void"):
        emit(v, "call void @" + fname + "(" + argsx + ")")
        ret make_llv("0", "void")
    end
    r := new_tmp(v)
    emit(v, r + " = call " + ty_of(v, s, a, rts) + " @" + fname + "(" + argsx + ")")
    ret make_llv(r, rts)
end

// ll_call_pkg
func call_pkg(
    v &: Lv, s &: sm.Sema, a &: at.Ast, n: int, pk: int, fname_: str
): Llv:
    py := sm.SymAt(s, pk)
    touch_pkg_named(v, s, a, py.pkgname)
    fs := sm.LookupLocal(s, py.members, fname_)
    if fs == 0 || sm.SymAt(s, fs).kind != sm.SYM_FUNC || sm.SymAt(s, fs).overloads.len() == 0:
        lv_error(v, a, n, "package function '" + fname_ + "' not found")
        ret poison(at.Get(a, n).type_str)
    end
    sig := pick_overload(v, s, a, fs, n)
    ensure_fn(v, s, a, sm.SigAt(s, sig).decl, 0, py.members)
    is_ext := sm.SigAt(s, sig).decl != 0 && at.Get(a, sm.SigAt(s, sig).decl).is_extern
    fname := is_ext ? fname_ : mangle(v, s, "", fname_, sig)
    ret emit_call(
        v, s, a, n, sig, "", fname, sm.ToString(s, sm.SigAt(s, sig).ret_type)
    )
end

// ll_call_str
func call_str(
    v &: Lv, s &: sm.Sema, a &: at.Ast, n: int, obj: int, m: str, out2 &: Llv
): bool:
    nn := at.Get(a, n)
    na := nn.list.len()
    if str.Equals(m, "len") && na == 0:
        klen := ast_str_lit_len(a, obj)
        if klen >= (0 as i64):
            out2 = make_llv(co.I64Toa(klen), "i32")
            ret true
        end
    end
    recv := lv_expr(v, s, a, obj).ref
    mut r := ""
    if str.Equals(m, "len"):
        l := new_tmp(v)
        emit(v, l + " = call " + v.usize + " @strlen(ptr " + recv + ")")
        out2 = make_llv(usize_to_i32(v, l), "i32")
        ret true
    end
    if str.Equals(m, "concat") && na == 1:
        arg0 := lv_expr(v, s, a, nn.list.get(0)[0]).ref
        r = new_tmp(v)
        need(v, LV_H_STRCAT)
        emit(
            v, r + " = call ptr @salam_ll_strcat(ptr " + recv + ", ptr " + arg0 + ")"
        )
        out2 = make_llv(r, "str")
        ret true
    end
    if str.Equals(m, "substr") && na == 2:
        st := conv(v, s, a, lv_expr(v, s, a, nn.list.get(0)[0]), "i32")
        ln := conv(v, s, a, lv_expr(v, s, a, nn.list.get(1)[0]), "i32")
        r = new_tmp(v)
        need(v, LV_H_SUBSTR)
        emit(
            v, r + " = call ptr @salam_ll_substr(ptr " + recv + ", i32 " + st + ", i32 " + ln + ")"
        )
        out2 = make_llv(r, "str")
        ret true
    end
    if str.Equals(m, "trim"):
        r = new_tmp(v)
        need(v, LV_H_TRIM)
        emit(v, r + " = call ptr @salam_ll_trim(ptr " + recv + ")")
        out2 = make_llv(r, "str")
        ret true
    end
    if str.Equals(m, "to_int"):
        x := new_tmp(v)
        r = new_tmp(v)
        emit(v, x + " = call i64 @strtol(ptr " + recv + ", ptr null, i32 10)")
        emit(v, r + " = trunc i64 " + x + " to i32")
        out2 = make_llv(r, "i32")
        ret true
    end
    if str.Equals(m, "to_float"):
        r = new_tmp(v)
        emit(v, r + " = call double @strtod(ptr " + recv + ", ptr null)")
        out2 = make_llv(r, "f64")
        ret true
    end
    if (
        str.Equals(m, "find") || str.Equals(m, "search") || str.Equals(m, "indexOf")
    ) && na == 1:
        arg1 := lv_expr(v, s, a, nn.list.get(0)[0]).ref
        p := new_tmp(v)
        pi := new_tmp(v)
        ri := new_tmp(v)
        d := new_tmp(v)
        o := new_tmp(v)
        nz := new_tmp(v)
        emit(v, p + " = call ptr @strstr(ptr " + recv + ", ptr " + arg1 + ")")
        emit(v, pi + " = ptrtoint ptr " + p + " to i64")
        emit(v, ri + " = ptrtoint ptr " + recv + " to i64")
        emit(v, d + " = sub i64 " + pi + ", " + ri)
        emit(v, o + " = trunc i64 " + d + " to i32")
        emit(v, nz + " = icmp eq ptr " + p + ", null")
        r = new_tmp(v)
        emit(v, r + " = select i1 " + nz + ", i32 -1, i32 " + o)
        out2 = make_llv(r, "i32")
        ret true
    end
    if str.Equals(m, "lower"):
        r = new_tmp(v)
        need(v, LV_H_LOWER)
        emit(v, r + " = call ptr @salam_ll_lower(ptr " + recv + ")")
        out2 = make_llv(r, "str")
        ret true
    end
    if str.Equals(m, "upper"):
        r = new_tmp(v)
        need(v, LV_H_UPPER)
        emit(v, r + " = call ptr @salam_ll_upper(ptr " + recv + ")")
        out2 = make_llv(r, "str")
        ret true
    end
    if str.Equals(m, "repeat") && na == 1:
        cnt := conv(v, s, a, lv_expr(v, s, a, nn.list.get(0)[0]), "i32")
        r = new_tmp(v)
        need(v, LV_H_REPEAT)
        emit(
            v, r + " = call ptr @salam_ll_repeat(ptr " + recv + ", i32 " + cnt + ")"
        )
        out2 = make_llv(r, "str")
        ret true
    end
    ret false
end

// ll_call_dyn
func call_dyn(
    v &: Lv, s &: sm.Sema, a &: at.Ast, n: int, obj: int, iface: str, mname: str
): Llv:
    ni := str.Len(iface)
    mut k := 0
    mut stop := false
    until k < ni && k < 159 && !stop:
        c := byte_at(iface, k)
        if c == 42 || c == 91:
            stop = true
        else:
            k += 1
        end
    end
    ib := str.Substr(iface, 0, k)
    isym := sym_of(v, s, a, ib)
    if isym == 0 || sm.SymAt(s, isym).kind != sm.SYM_INTERFACE:
        lv_error(v, a, n, "dynamic call on non-interface '" + ib + "'")
        ret poison(at.Get(a, n).type_str)
    end
    mut idx := 0
    mut slot := 0 - 1
    mut msig := 0
    isyms := sm.ScopeAt(s, sm.SymAt(s, isym).members).symbols
    mut m := 0
    until m < isyms.len():
        im := sm.SymAt(s, isyms.get(m)[0])
        if im.kind == sm.SYM_METHOD && im.overloads.len() > 0:
            if str.Equals(im.name, mname):
                slot = idx
                msig = im.overloads.get(0)[0]
                break
            end
            idx += 1
        end
        m += 1
    end
    if slot < 0:
        lv_error(v, a, n, "interface '" + ib + "' has no method '" + mname + "'")
        ret poison(at.Get(a, n).type_str)
    end

    dv := lv_expr(v, s, a, obj)
    data := new_tmp(v)
    vt := new_tmp(v)
    sl := new_tmp(v)
    fn := new_tmp(v)
    emit(v, data + " = extractvalue %dyn " + dv.ref + ", 0")
    emit(v, vt + " = extractvalue %dyn " + dv.ref + ", 1")
    emit(
        v, sl + " = getelementptr inbounds ptr, ptr " + vt + ", i64 " + co.I64Toa(slot as i64)
    )
    emit(v, fn + " = load ptr, ptr " + sl)

    mut ab := co.SbNew()
    co.SbPuts(ab, "ptr " + data)
    nn := at.Get(a, n)
    mut i := 0
    until i < nn.list.len():
        argi := nn.list.get(i)[0]
        val := lv_expr(v, s, a, argi)
        msig_ok := msig != 0 && i < sm.SigAt(s, msig).params.len()
        pt := msig_ok ? sm.ToString(s, sm.SigAt(s, msig).params.get(i)[0]) : val.ts
        co.SbPuts(ab, ", " + ty_of(v, s, a, pt) + " " + conv(v, s, a, val, pt))
        i += 1
    end
    argsx := co.SbCstr(ab)
    co.SbFree(ab)
    rts := sm.ToString(s, sm.SigAt(s, msig).ret_type)
    if str.Equals(rts, "void"):
        emit(v, "call void " + fn + "(" + argsx + ")")
        ret make_llv("0", "void")
    end
    r := new_tmp(v)
    emit(v, r + " = call " + ty_of(v, s, a, rts) + " " + fn + "(" + argsx + ")")
    ret make_llv(r, rts)
end

// ll_call_method
func call_method(v &: Lv, s &: sm.Sema, a &: at.Ast, n: int, callee: int): Llv:
    calleen := at.Get(a, callee)
    obj := calleen.a
    mname := calleen.name
    objn := at.Get(a, obj)
    ots := objn.type_str

    if str.StartsWith(ots, "dyn "):
        ret call_dyn(v, s, a, n, obj, str.Substr(ots, 4, str.Len(ots) - 4), mname)
    end

    if str.Equals(ots, "str"):
        mut o := Llv {}
        if call_str(v, s, a, n, obj, mname, o):
            ret o
        end
    end

    if str.Equals(mname, "len") && (is_slice(ots) || (str.Len(ots) > 0 && idx_byte(ots, 91) >= 0)):
        ret len_of(v, s, a, n, obj)
    end

    if objn.kind == at.AST_IDENTIFIER:
        pk := sym_of(v, s, a, objn.name)
        if pk != 0 && sm.SymAt(s, pk).kind == sm.SYM_PACKAGE:
            ret call_pkg(v, s, a, n, pk, mname)
        end
    end

    isptr := is_ptr_ts(ots)
    sname2 := isptr ? str.Substr(ots, 0, str.Len(ots) - 1) : ots
    ss := struct_sym(v, s, a, sname2)
    mut ms := 0
    if ss != 0:
        ms = sm.LookupLocal(s, sm.SymAt(s, ss).members, mname)
    end
    if ms != 0 && sm.SymAt(s, ms).kind == sm.SYM_METHOD && sm.SymAt(s, ms).overloads.len() > 0:
        sig := pick_overload(v, s, a, ms, n)
        ensure_fn(v, s, a, sm.SigAt(s, sig).decl, ss, v.pkg_scope)
        recv := isptr ? lv_expr(v, s, a, obj).ref : lv_addr_of(v, s, a, obj).ptr
        ret emit_call(
            v, s, a, n, sig, "ptr " + recv, mangle(v, s, sname2, mname, sig), sm.ToString(s, sm.SigAt(s, sig).ret_type)
        )
    end

    implsym := sym_of(v, s, a, sm.ImplOwnerKey(ots))
    if implsym != 0 && sm.SymAt(s, implsym).kind == sm.SYM_TYPEIMPL:
        im := sm.LookupLocal(s, sm.SymAt(s, implsym).members, mname)
        if im != 0 && sm.SymAt(s, im).kind == sm.SYM_METHOD && sm.SymAt(s, im).overloads.len() > 0:
            sig2 := pick_overload(v, s, a, im, n)
            ensure_fn(v, s, a, sm.SigAt(s, sig2).decl, implsym, v.pkg_scope)
            rv := lv_expr(v, s, a, obj)
            ret emit_call(
                v, s, a, n, sig2, ty_of(v, s, a, ots) + " " + rv.ref, mangle_ti(v, s, ots, mname, sig2),
                sm.ToString(s, sm.SigAt(s, sig2).ret_type)
            )
        end
    end

    lv_error(
        v, a, n, "method '" + mname + "' on type '" + ots + "' (or overloaded/builtin method)"
    )
    ret poison(at.Get(a, n).type_str)
end

// ll_call_indirect
func call_indirect(v &: Lv, s &: sm.Sema, a &: at.Ast, n: int, callee: int): Llv:
    fts := at.Get(a, callee).type_str
    env := lv_expr(v, s, a, callee)
    fn := new_tmp(v)
    emit(v, fn + " = load ptr, ptr " + env.ref)
    rts := func_ret(fts)
    mut pts := func_params(fts)
    defer pts.free()
    mut ab := co.SbNew()
    co.SbPuts(ab, "ptr " + env.ref)
    nn := at.Get(a, n)
    mut i := 0
    until i < nn.list.len():
        val := lv_expr(v, s, a, nn.list.get(i)[0])
        pt := i < pts.len() ? pts.get(i)[0] : val.ts
        co.SbPuts(ab, ", " + ty_of(v, s, a, pt) + " " + conv(v, s, a, val, pt))
        i += 1
    end
    argsx := co.SbCstr(ab)
    co.SbFree(ab)
    if str.Equals(rts, "void"):
        emit(v, "call void " + fn + "(" + argsx + ")")
        ret make_llv("0", "void")
    end
    r := new_tmp(v)
    emit(v, r + " = call " + ty_of(v, s, a, rts) + " " + fn + "(" + argsx + ")")
    ret make_llv(r, rts)
end

// ll_is_func_ts
func is_func_ts(ts: str): bool:
    ret str.StartsWith(ts, "func(")
end

// ll_call_intrinsic
func call_intrinsic(
    v &: Lv, s &: sm.Sema, a &: at.Ast, n: int, nm: str, out2 &: Llv
): bool:
    nn := at.Get(a, n)
    na := nn.list.len()
    a0 := na > 0 ? nn.list.get(0)[0] : 0
    mut r := ""
    if str.Equals(nm, "hash") && na == 1:
        r = new_tmp(v)
        if is_str(at.Get(a, a0).type_str):
            need(v, LV_H_STRHASH)
            emit(
                v, r + " = call i64 @salam_ll_strhash(ptr " + lv_expr(v, s, a, a0).ref + ")"
            )
        else:
            need(v, LV_H_INTHASH)
            emit(
                v, r + " = call i64 @salam_ll_inthash(i64 " + conv(v, s, a, lv_expr(v, s, a, a0), "u64") + ")"
            )
        end
        out2 = make_llv(r, "u64")
        ret true
    end
    if str.Equals(nm, "char_from_code") && na == 1:
        r = new_tmp(v)
        need(v, LV_H_CHARSTR)
        emit(
            v, r + " = call ptr @salam_ll_charstr(i32 " + conv(v, s, a, lv_expr(v, s, a, a0), "i32") + ")"
        )
        out2 = make_llv(r, "str")
        ret true
    end
    ret false
end

// ll_call
func lv_call(v &: Lv, s &: sm.Sema, a &: at.Ast, n: int): Llv:
    nn := at.Get(a, n)
    callee := nn.a
    if callee != 0 && at.KindOf(a, callee) == at.AST_MEMBER:
        ret call_method(v, s, a, n, callee)
    end
    if callee != 0 && at.KindOf(a, callee) == at.AST_IDENTIFIER:
        nm := at.Get(a, callee).name
        if str.Equals(nm, "print"):
            lv_lower_print(v, s, a, n, false, false)
            ret make_llv("0", "void")
        end
        if str.Equals(nm, "println"):
            lv_lower_print(v, s, a, n, true, false)
            ret make_llv("0", "void")
        end
        if str.Equals(nm, "printerr"):
            lv_lower_print(v, s, a, n, false, true)
            ret make_llv("0", "void")
        end
        if str.Equals(nm, "printerrln"):
            lv_lower_print(v, s, a, n, true, true)
            ret make_llv("0", "void")
        end
        if str.Equals(nm, "len") && nn.list.len() == 1:
            ret call_len(v, s, a, n)
        end
        if str.Equals(nm, "sizeof") && nn.list.len() == 1:
            t := at.Get(a, nn.list.get(0)[0]).type_str
            szp := new_tmp(v)
            sz := new_tmp(v)
            emit(
                v, szp + " = getelementptr " + ty_of(v, s, a, str.Len(t) > 0 ? t : "i32") + ", ptr null, i32 1"
            )
            emit(v, sz + " = ptrtoint ptr " + szp + " to " + v.usize)
            ret make_llv(sz, "size")
        end
        fsym := sym_of(v, s, a, nm)
        if fsym != 0 && sm.SymAt(s, fsym).kind == sm.SYM_FUNC:
            ret call_user(v, s, a, n, nm)
        end
        if fsym == 0:
            mut o := Llv {}
            if call_intrinsic(v, s, a, n, nm, o):
                ret o
            end
        end
        if is_func_ts(at.Get(a, callee).type_str):
            ret call_indirect(v, s, a, n, callee)
        end
        ret call_user(v, s, a, n, nm)
    end
    if callee != 0 && is_func_ts(at.Get(a, callee).type_str):
        ret call_indirect(v, s, a, n, callee)
    end
    lv_error(v, a, n, "method / package / indirect call")
    ret poison(nn.type_str)
end

// ll_addr_of (forward decls of ll_member_addr/ll_index_addr not needed - // Salam allows forward reference within the same file).
func lv_addr_of(v &: Lv, s &: sm.Sema, a &: at.Ast, n: int): LvAddr:
    k := at.KindOf(a, n)
    if k == at.AST_IDENTIFIER:
        nm := at.Get(a, n).name
        li := local_find(v, nm)
        if li >= 0:
            lvar := v.locals.get(li)[0]
            mut r := LvAddr {}
            r.ptr = lvar.ptr
            r.ts = lvar.ts
            ret r
        end
        if v.cur_lambda != 0:
            capn := at.Get(a, v.cur_lambda)
            mut ci := 0
            until ci < capn.captures.len():
                c := at.Get(a, capn.captures.get(ci)[0])
                if str.Equals(c.name, nm):
                    rr := new_tmp(v)
                    emit(
                        v, rr + " = getelementptr inbounds " + v.env_ty + ", ptr " + v.env_ref + ", i32 0, i32 " + co.I64Toa((ci + 1) as i64)
                    )
                    mut ra := LvAddr {}
                    ra.ptr = rr
                    ra.ts = c.type_str
                    ret ra
                end
                ci += 1
            end
        end
        if str.Len(v.self_ts) > 0:
            ss := struct_sym(v, s, a, v.self_ts)
            mut fs := 0
            idx := ss != 0 ? field_index(s, ss, nm, fs) : 0 - 1
            if idx >= 0:
                fts := sm.ToString(s, sm.SymAt(s, fs).ty)
                rr2 := new_tmp(v)
                emit(
                    v, rr2 + " = getelementptr inbounds " + struct_ltype(v.self_ts) + ", ptr " + v.this_ref + ", i32 0, i32 " + co.I64Toa(idx as i64)
                )
                mut ra2 := LvAddr {}
                ra2.ptr = rr2
                ra2.ts = fts
                ret ra2
            end
        end
        gi := global_find(v, nm)
        if gi >= 0:
            gv := v.globals.get(gi)[0]
            mut ra3 := LvAddr {}
            ra3.ptr = gv.ptr
            ra3.ts = gv.ts
            ret ra3
        end
        lv_error(v, a, n, "address of an unknown identifier '" + nm + "'")
        mut ra4 := LvAddr {}
        ra4.ptr = "null"
        nts := at.Get(a, n).type_str
        ra4.ts = str.Len(nts) > 0 ? nts : "i32"
        ret ra4
    end
    if k == at.AST_MEMBER:
        ret member_addr(v, s, a, n)
    end
    if k == at.AST_INDEX:
        ret index_addr(v, s, a, n)
    end
    val := lv_expr(v, s, a, n)
    p := "%agg." + co.I64Toa(v.tmp as i64)
    v.tmp += 1
    emit_alloca(v, p + " = alloca " + ty_of(v, s, a, val.ts))
    emit(v, "store " + ty_of(v, s, a, val.ts) + " " + val.ref + ", ptr " + p)
    mut ra5 := LvAddr {}
    ra5.ptr = p
    ra5.ts = val.ts
    ret ra5
end

// ll_member_addr
func member_addr(v &: Lv, s &: sm.Sema, a &: at.Ast, n: int): LvAddr:
    nn := at.Get(a, n)
    ots := at.Get(a, nn.a).type_str
    mut base := ""
    mut sname2 := ""
    if is_ptr_ts(ots):
        base = lv_expr(v, s, a, nn.a).ref
        sname2 = str.Substr(ots, 0, str.Len(ots) - 1)
    else:
        b := lv_addr_of(v, s, a, nn.a)
        base = b.ptr
        sname2 = ots
    end
    ss := struct_sym(v, s, a, sname2)
    mut fs := 0
    idx := ss != 0 ? field_index(s, ss, nn.name, fs) : 0 - 1
    if idx < 0:
        lv_error(
            v, a, n, "member '" + nn.name + "' of non-struct/unknown type '" + sname2 + "'"
        )
        mut ra := LvAddr {}
        ra.ptr = "null"
        ra.ts = str.Len(nn.type_str) > 0 ? nn.type_str : "i32"
        ret ra
    end
    fts := sm.ToString(s, sm.SymAt(s, fs).ty)
    r := new_tmp(v)
    emit(
        v, r + " = getelementptr inbounds " + struct_ltype(sname2) + ", ptr " + base + ", i32 0, i32 " + co.I64Toa(idx as i64)
    )
    mut ra2 := LvAddr {}
    ra2.ptr = r
    ra2.ts = fts
    ret ra2
end

// ll_index_addr
func index_addr(v &: Lv, s &: sm.Sema, a &: at.Ast, n: int): LvAddr:
    nn := at.Get(a, n)
    ots := at.Get(a, nn.a).type_str
    if is_slice(ots):
        ets := slice_elem(ots)
        sv := lv_expr(v, s, a, nn.a)
        data := new_tmp(v)
        emit(v, data + " = extractvalue { ptr, i64 } " + sv.ref + ", 0")
        idxv := conv(v, s, a, lv_expr(v, s, a, nn.b), "i64")
        r := new_tmp(v)
        emit(
            v, r + " = getelementptr inbounds " + ty_of(v, s, a, ets) + ", ptr " + data + ", i64 " + idxv
        )
        mut ra := LvAddr {}
        ra.ptr = r
        ra.ts = ets
        ret ra
    end
    if is_ptr_ts(ots):
        base := lv_expr(v, s, a, nn.a).ref
        ets2 := str.Substr(ots, 0, str.Len(ots) - 1)
        idxv2 := conv(v, s, a, lv_expr(v, s, a, nn.b), "i64")
        r2 := new_tmp(v)
        emit(
            v, r2 + " = getelementptr inbounds " + ty_of(v, s, a, ets2) + ", ptr " + base + ", i64 " + idxv2
        )
        mut ra2 := LvAddr {}
        ra2.ptr = r2
        ra2.ts = ets2
        ret ra2
    end
    b2 := lv_addr_of(v, s, a, nn.a)
    ets3 := array_elem(ots)
    idxv3 := conv(v, s, a, lv_expr(v, s, a, nn.b), "i64")
    r3 := new_tmp(v)
    emit(
        v, r3 + " = getelementptr inbounds " + ty_of(v, s, a, ots) + ", ptr " + b2.ptr + ", i64 0, i64 " + idxv3
    )
    mut ra3 := LvAddr {}
    ra3.ptr = r3
    ra3.ts = ets3
    ret ra3
end

// ll_load_addr
func load_addr(v &: Lv, s &: sm.Sema, a &: at.Ast, n: int): Llv:
    addr := lv_addr_of(v, s, a, n)
    r := new_tmp(v)
    emit(v, r + " = load " + ty_of(v, s, a, addr.ts) + ", ptr " + addr.ptr)
    ret make_llv(r, addr.ts)
end

// ll_struct_lit
func lv_struct_lit(v &: Lv, s &: sm.Sema, a &: at.Ast, n: int): Llv:
    nn := at.Get(a, n)
    sname2 := str.Len(nn.type_str) > 0 ? nn.type_str : nn.name
    ss := struct_sym(v, s, a, sname2)
    if ss == 0:
        lv_error(
            v, a, n, "struct literal of unknown/unsupported type '" + (str.Len(nn.name) > 0 ? nn.name : "?") + "'"
        )
        ret poison(nn.type_str)
    end
    sty := struct_ltype(sname2)
    mut cur := "zeroinitializer"
    mut idx := 0
    fsyms := sm.ScopeAt(s, sm.SymAt(s, ss).members).symbols
    mut i := 0
    until i < fsyms.len():
        f := sm.SymAt(s, fsyms.get(i)[0])
        if f.kind == sm.SYM_FIELD:
            fts := sm.ToString(s, f.ty)
            mut prov := 0
            mut j := 0
            until j < nn.list.len():
                fi := at.Get(a, nn.list.get(j)[0])
                if prov == 0 && str.Len(fi.name) > 0 && str.Equals(fi.name, f.name):
                    prov = nn.list.get(j)[0]
                end
                j += 1
            end
            mut val := ""
            if prov != 0:
                val = conv(v, s, a, lv_expr(v, s, a, at.Get(a, prov).a), fts)
            else f.decl != 0 && at.Get(a, f.decl).a != 0:
                val = conv(v, s, a, lv_expr(v, s, a, at.Get(a, f.decl).a), fts)
            else:
                val = zero_of(fts)
            end
            r := new_tmp(v)
            emit(
                v, r + " = insertvalue " + sty + " " + cur + ", " + ty_of(v, s, a, fts) + " " + val + ", " + co.I64Toa(idx as i64)
            )
            cur = r
            idx += 1
        end
        i += 1
    end
    ret make_llv(idx != 0 ? cur : "zeroinitializer", sname2)
end

// ll_array_lit
func lv_array_lit(v &: Lv, s &: sm.Sema, a &: at.Ast, n: int): Llv:
    nn := at.Get(a, n)
    ats := nn.type_str
    if str.Len(ats) == 0 || idx_byte(ats, 91) < 0:
        lv_error(v, a, n, "array literal without an array type")
        ret poison(ats)
    end
    ety := array_elem(ats)
    aty := ty_of(v, s, a, ats)
    lety := ty_of(v, s, a, ety)
    mut cur := "zeroinitializer"
    mut i := 0
    until i < nn.list.len():
        vv := conv(v, s, a, lv_expr(v, s, a, nn.list.get(i)[0]), ety)
        r := new_tmp(v)
        emit(
            v, r + " = insertvalue " + aty + " " + cur + ", " + lety + " " + vv + ", " + co.I64Toa(i as i64)
        )
        cur = r
        i += 1
    end
    ret make_llv(nn.list.len() > 0 ? cur : "zeroinitializer", ats)
end

// ll_slice_expr
func lv_slice_expr(v &: Lv, s &: sm.Sema, a &: at.Ast, n: int): Llv:
    nn := at.Get(a, n)
    sts := nn.type_str
    ets := slice_elem(sts)
    let2 := ty_of(v, s, a, ets)
    bts := at.Get(a, nn.a).type_str

    lo := nn.b != 0 ? conv(v, s, a, lv_expr(v, s, a, nn.b), "i64") : "0"
    mut data := ""
    mut blen := ""

    if is_slice(bts):
        bv := lv_expr(v, s, a, nn.a)
        bp := new_tmp(v)
        emit(v, bp + " = extractvalue { ptr, i64 } " + bv.ref + ", 0")
        blen = new_tmp(v)
        emit(v, blen + " = extractvalue { ptr, i64 } " + bv.ref + ", 1")
        data = new_tmp(v)
        emit(
            v, data + " = getelementptr inbounds " + let2 + ", ptr " + bp + ", i64 " + lo
        )
    else:
        b := lv_addr_of(v, s, a, nn.a)
        blen = co.I64Toa(array_dim(bts))
        data = new_tmp(v)
        emit(
            v, data + " = getelementptr inbounds " + ty_of(v, s, a, bts) + ", ptr " + b.ptr + ", i64 0, i64 " + lo
        )
    end

    hi := nn.c != 0 ? conv(v, s, a, lv_expr(v, s, a, nn.c), "i64") : blen
    len2 := new_tmp(v)
    emit(v, len2 + " = sub i64 " + hi + ", " + lo)

    a0 := new_tmp(v)
    a1 := new_tmp(v)
    emit(v, a0 + " = insertvalue { ptr, i64 } zeroinitializer, ptr " + data + ", 0")
    emit(v, a1 + " = insertvalue { ptr, i64 } " + a0 + ", i64 " + len2 + ", 1")
    ret make_llv(a1, sts)
end

// ll_lambda_value
func lv_lambda_value(v &: Lv, s &: sm.Sema, a &: at.Ast, n: int): Llv:
    emit_lambda(v, s, a, n)
    nd := at.Get(a, n)
    name := nd.name
    // "salam_lambda_" is 13 bytes; the index text follows it.
    idxtxt := str.Substr(name, 13, str.Len(name) - 13)
    envty := "%lam." + idxtxt + ".env"
    ncap := nd.captures.len()
    if ncap == 0:
        ret make_llv("@" + name + ".env", nd.type_str)
    end

    szp := new_tmp(v)
    sz := new_tmp(v)
    env := new_tmp(v)
    emit(v, szp + " = getelementptr " + envty + ", ptr null, i32 1")
    emit(v, sz + " = ptrtoint ptr " + szp + " to i64")
    emit(v, env + " = call ptr @malloc(i64 " + sz + ")")
    f0 := new_tmp(v)
    emit(
        v, f0 + " = getelementptr inbounds " + envty + ", ptr " + env + ", i32 0, i32 0"
    )
    emit(v, "store ptr @" + name + ", ptr " + f0)
    mut i := 0
    until i < ncap:
        c := at.Get(a, nd.captures.get(i)[0])
        cv := lv_expr(v, s, a, nd.captures.get(i)[0])
        fp := new_tmp(v)
        emit(
            v, fp + " = getelementptr inbounds " + envty + ", ptr " + env + ", i32 0, i32 " + co.I64Toa((i + 1) as i64)
        )
        emit(
            v, "store " + ty_of(v, s, a, c.type_str) + " " + conv(v, s, a, cv, c.type_str) + ", ptr " + fp
        )
        i += 1
    end
    ret make_llv(env, nd.type_str)
end

// ll_literal
func float_lit_text(f: f64): str:
    buf := co.Format1("%.17g", co.ArgFloat(f))
    n := str.Len(buf)
    mut hasmark := false
    mut i := 0
    until i < n && !hasmark:
        c := byte_at(buf, i)
        if c == 46 || c == 101 || c == 69 || c == 110 || c == 78:
            hasmark = true
        end
        i += 1
    end
    if !hasmark:
        ret buf + ".0"
    end
    ret buf
end

func lv_literal(v &: Lv, a &: at.Ast, n: int): Llv:
    nd := at.Get(a, n)
    if nd.op == tok.TK_INT:
        ts := str.Len(nd.type_str) > 0 ? nd.type_str : "i32"
        ret make_llv(co.I64Toa(nd.value_int as i64), ts)
    end
    if nd.op == tok.TK_FLOAT:
        ts2 := str.Len(nd.type_str) > 0 ? nd.type_str : "f64"
        ret make_llv(float_lit_text(nd.value_float), ts2)
    end
    if nd.op == tok.TK_STRING || nd.op == tok.TK_TRIPLE_STRING || nd.op == tok.TK_RAW_STRING || nd.op == tok.TK_UTF8_CHAR:
        ret make_llv(strconst(v, nd.value_str), "str")
    end
    if nd.op == tok.TK_CHAR:
        ret make_llv(co.I64Toa(nd.value_int as i64), "char")
    end
    if nd.op == tok.TK_KW_TRUE:
        ret make_llv("true", "bool")
    end
    if nd.op == tok.TK_KW_FALSE:
        ret make_llv("false", "bool")
    end
    if nd.op == tok.TK_KW_NULL:
        ret make_llv("null", str.Len(nd.type_str) > 0 ? nd.type_str : "i32*")
    end
    ret make_llv("0", "i32")
end

// ll_match_pat_eq
func match_pat_eq(
    v &: Lv, s &: sm.Sema, a &: at.Ast, subj: Llv, pat_head: int
): str:
    pv := lv_expr(v, s, a, pat_head)
    if is_str(subj.ts):
        c := new_tmp(v)
        r := new_tmp(v)
        emit(v, c + " = call i32 @strcmp(ptr " + subj.ref + ", ptr " + pv.ref + ")")
        emit(v, r + " = icmp eq i32 " + c + ", 0")
        ret r
    end
    cv := conv(v, s, a, pv, subj.ts)
    r2 := new_tmp(v)
    if is_float(subj.ts):
        emit(
            v, r2 + " = fcmp oeq " + ty_of(v, s, a, subj.ts) + " " + subj.ref + ", " + cv
        )
    else:
        emit(
            v, r2 + " = icmp eq " + ty_of(v, s, a, subj.ts) + " " + subj.ref + ", " + cv
        )
    end
    ret r2
end

// ll_match_variant_tag_cond
func match_variant_tag_cond(
    v &: Lv, s &: sm.Sema, a &: at.Ast, subj: Llv, tag: int
): str:
    t := new_tmp(v)
    r := new_tmp(v)
    emit(
        v, t + " = extractvalue " + ty_of(v, s, a, subj.ts) + " " + subj.ref + ", 0"
    )
    emit(v, r + " = icmp eq i32 " + t + ", " + co.I64Toa(tag as i64))
    ret r
end

// ll_match_arm_cond
func lv_match_arm_cond(
    v &: Lv, s &: sm.Sema, a &: at.Ast, arm: int, subj: Llv, is_variant: bool
): str:
    armn := at.Get(a, arm)
    if armn.op == tok.TK_KW_ELSE:
        ret "true"
    end
    mut acc := ""
    mut i := 0
    until i < armn.list.len():
        pat := at.Get(a, armn.list.get(i)[0])
        mut c := ""
        if is_variant:
            c = match_variant_tag_cond(v, s, a, subj, pat.value_int as int)
        else:
            c = match_pat_eq(v, s, a, subj, pat.a)
        end
        if str.Len(acc) == 0:
            acc = c
        else:
            r := new_tmp(v)
            emit(v, r + " = or i1 " + acc + ", " + c)
            acc = r
        end
        i += 1
    end
    ret str.Len(acc) > 0 ? acc : "false"
end

// ll_match_expr
func lv_match_expr(v &: Lv, s &: sm.Sema, a &: at.Ast, n: int): Llv:
    nn := at.Get(a, n)
    subj := lv_expr(v, s, a, nn.a)
    is_variant := str.StartsWith(subj.ts, "Variant<")
    rts := str.Len(nn.type_str) > 0 ? nn.type_str : "i32"
    resptr := "%mres." + co.I64Toa(v.tmp as i64)
    v.tmp += 1
    endL := new_lbl(v, "mend")
    fallbackL := new_lbl(v, "mtrap")
    saved_ptr := v.match_result_ptr
    saved_ts := v.match_result_ts
    saved_merge := v.match_merge_block
    emit_alloca(v, resptr + " = alloca " + ty_of(v, s, a, rts))
    v.match_result_ptr = resptr
    v.match_result_ts = rts
    v.match_merge_block = endL
    mut i := 0
    until i < nn.list.len():
        arm := nn.list.get(i)[0]
        cond := lv_match_arm_cond(v, s, a, arm, subj, is_variant)
        bodyL := new_lbl(v, "marm")
        nextL := (i + 1 < nn.list.len()) ? new_lbl(v, "mnext") : fallbackL
        emit_term(v, "br i1 " + cond + ", label %" + bodyL + ", label %" + nextL)
        emit_label(v, bodyL)
        lv_stmt(v, s, a, at.Get(a, arm).b)
        emit_term(v, "br label %" + endL)
        emit_label(v, nextL)
        i += 1
    end
    if nn.list.len() == 0:
        emit_term(v, "br label %" + fallbackL)
        emit_label(v, fallbackL)
    end
    emit(v, "call void @llvm.trap()")
    emit_term(v, "unreachable")
    emit_label(v, endL)
    v.match_result_ptr = saved_ptr
    v.match_result_ts = saved_ts
    v.match_merge_block = saved_merge
    r := new_tmp(v)
    emit(v, r + " = load " + ty_of(v, s, a, rts) + ", ptr " + resptr)
    ret make_llv(r, rts)
end

// ll_expr
func lv_expr(v &: Lv, s &: sm.Sema, a &: at.Ast, n: int): Llv:
    if n == 0:
        ret make_llv("0", "i32")
    end
    nd := at.Get(a, n)
    k := nd.kind
    if k == at.AST_LITERAL:
        ret lv_literal(v, a, n)
    end
    if k == at.AST_IDENTIFIER:
        addr := lv_addr_of(v, s, a, n)
        r := new_tmp(v)
        emit(v, r + " = load " + ty_of(v, s, a, addr.ts) + ", ptr " + addr.ptr)
        ret make_llv(r, addr.ts)
    end
    if k == at.AST_FUNC_ADDR:
        fsym := sym_of(v, s, a, nd.name)
        if fsym == 0 || sm.SymAt(s, fsym).kind != sm.SYM_FUNC || sm.SymAt(s, fsym).overloads.len() != 1:
            lv_error(v, a, n, "cannot take the address of '" + nd.name + "'")
            ret poison(str.Len(nd.type_str) > 0 ? nd.type_str : "ptr")
        end
        sig := sm.SymAt(s, fsym).overloads.get(0)[0]
        is_ext := sm.SigAt(s, sig).decl != 0 && at.Get(a, sm.SigAt(s, sig).decl).is_extern
        if !is_ext:
            ensure_fn(v, s, a, sm.SigAt(s, sig).decl, 0, v.pkg_scope)
        end
        fname := is_ext ? nd.name : mangle(v, s, "", nd.name, sig)
        ret make_llv("@" + fname, "void*")
    end
    if k == at.AST_THIS:
        if str.Len(v.this_ref) == 0:
            lv_error(v, a, n, "'this' outside a method")
            ret poison(nd.type_str)
        end
        if v.self_byval:
            r2 := new_tmp(v)
            emit(
                v, r2 + " = load " + ty_of(v, s, a, v.self_ts) + ", ptr " + v.this_ref
            )
            ret make_llv(r2, v.self_ts)
        end
        ret make_llv(v.this_ref, v.self_ts + "*")
    end
    if k == at.AST_BINARY:
        ret lv_binary(v, s, a, n)
    end
    if k == at.AST_MATCH:
        ret lv_match_expr(v, s, a, n)
    end
    if k == at.AST_VARIANT_BOX:
        vv := lv_expr(v, s, a, nd.a)
        ret make_llv(
            box_variant(v, s, a, vv, nd.value_int as int, nd.type_str), nd.type_str
        )
    end
    if k == at.AST_VARIANT_UNWRAP:
        vv2 := lv_expr(v, s, a, nd.a)
        ret unwrap_variant(
            v, s, a, vv2, str.Len(nd.type_str) > 0 ? nd.type_str : "i32"
        )
    end
    if k == at.AST_TERNARY:
        rt := str.Len(nd.type_str) > 0 ? nd.type_str : "i32"
        cond := as_i1(v, s, a, lv_expr(v, s, a, nd.a))
        thenL := new_lbl(v, "tern_then")
        elseL := new_lbl(v, "tern_else")
        tjoinL := new_lbl(v, "tern_tjoin")
        fjoinL := new_lbl(v, "tern_fjoin")
        endL := new_lbl(v, "tern_end")
        emit_term(v, "br i1 " + cond + ", label %" + thenL + ", label %" + elseL)
        emit_label(v, thenL)
        tv := conv(v, s, a, lv_expr(v, s, a, nd.b), rt)
        emit_term(v, "br label %" + tjoinL)
        emit_label(v, tjoinL)
        emit_term(v, "br label %" + endL)
        emit_label(v, elseL)
        fv := conv(v, s, a, lv_expr(v, s, a, nd.c), rt)
        emit_term(v, "br label %" + fjoinL)
        emit_label(v, fjoinL)
        emit_term(v, "br label %" + endL)
        emit_label(v, endL)
        r3 := new_tmp(v)
        emit(
            v, r3 + " = phi " + ty_of(v, s, a, rt) + " [ " + tv + ", %" + tjoinL + " ], [ " + fv + ", %" + fjoinL + " ]"
        )
        ret make_llv(r3, rt)
    end
    if k == at.AST_UNARY:
        ret lv_unary(v, s, a, n)
    end
    if k == at.AST_INCDEC:
        ret lv_incdec(v, s, a, n)
    end
    if k == at.AST_CAST:
        vv3 := lv_expr(v, s, a, nd.a)
        mut to_ts := ""
        if nd.ty != 0 && str.Len(at.Get(a, nd.ty).type_str) > 0:
            to_ts = at.Get(a, nd.ty).type_str
        else str.Len(nd.type_str) > 0:
            to_ts = nd.type_str
        else:
            to_ts = vv3.ts
        end
        ret make_llv(conv(v, s, a, vv3, to_ts), to_ts)
    end
    if k == at.AST_CALL:
        ret lv_call(v, s, a, n)
    end
    if k == at.AST_MEMBER:
        if nd.a != 0 && at.KindOf(a, nd.a) == at.AST_IDENTIFIER:
            e := enum_sym(v, s, a, at.Get(a, nd.a).name)
            if e != 0:
                m := sm.LookupLocal(s, sm.SymAt(s, e).members, nd.name)
                if m != 0 && sm.SymAt(s, m).kind == sm.SYM_ENUM_MEMBER:
                    ret make_llv(co.I64Toa(sm.SymAt(s, m).enum_value), "i32")
                end
            end
        end
        ret load_addr(v, s, a, n)
    end
    if k == at.AST_INDEX:
        if nd.a != 0 && str.Len(at.Get(a, nd.a).type_str) > 0:
            mut sname2 := ""
            oss := op_struct(v, s, a, at.Get(a, nd.a).type_str, sname2)
            if oss != 0:
                mut out2 := Llv {}
                if op_call(
                    v, s, a, nd.a, sname2, oss, "operator_index", nd.b, out2
                ):
                    ret out2
                end
            end
        end
        ret load_addr(v, s, a, n)
    end
    if k == at.AST_STRUCT_LIT:
        ret lv_struct_lit(v, s, a, n)
    end
    if k == at.AST_ARRAY_LIT:
        ret lv_array_lit(v, s, a, n)
    end
    if k == at.AST_SLICE:
        ret lv_slice_expr(v, s, a, n)
    end
    if k == at.AST_LAMBDA:
        ret lv_lambda_value(v, s, a, n)
    end
    lv_error(v, a, n, at.KindName(k) + " expression")
    ret poison(nd.type_str)
end

// ===== codegen_llvm_stmt.c (remainder) =====

// ll_vardecl
func lv_vardecl(v &: Lv, s &: sm.Sema, a &: at.Ast, n: int):
    nd := at.Get(a, n)
    ts := str.Len(nd.type_str) > 0 ? nd.type_str : "i32"
    ptr2 := "%v." + safe_name(nd.name) + "." + co.I64Toa(v.tmp as i64)
    v.tmp += 1
    emit_alloca(v, ptr2 + " = alloca " + ty_of(v, s, a, ts))
    local_add(v, nd.name, ptr2, ts)
    if nd.a != 0:
        vv := conv(v, s, a, lv_expr(v, s, a, nd.a), ts)
        emit(v, "store " + ty_of(v, s, a, ts) + " " + vv + ", ptr " + ptr2)
    end
end

// ll_compound_base
func compound_base(k: int): int:
    if k == tok.TK_PLUS_EQ:
        ret tok.TK_PLUS
    end
    if k == tok.TK_MINUS_EQ:
        ret tok.TK_MINUS
    end
    if k == tok.TK_STAR_EQ:
        ret tok.TK_STAR
    end
    if k == tok.TK_SLASH_EQ:
        ret tok.TK_SLASH
    end
    if k == tok.TK_PERCENT_EQ:
        ret tok.TK_PERCENT
    end
    if k == tok.TK_POWER_EQ:
        ret tok.TK_POWER
    end
    if k == tok.TK_AMP_EQ:
        ret tok.TK_AMP
    end
    if k == tok.TK_PIPE_EQ:
        ret tok.TK_PIPE
    end
    if k == tok.TK_CARET_EQ:
        ret tok.TK_CARET
    end
    if k == tok.TK_SHL_EQ:
        ret tok.TK_SHL
    end
    if k == tok.TK_SHR_EQ:
        ret tok.TK_SHR
    end
    ret tok.TK_EOF
end

// ll_assign
func lv_assign(v &: Lv, s &: sm.Sema, a &: at.Ast, n: int):
    nd := at.Get(a, n)
    tgt := nd.a
    tk := tgt != 0 ? at.KindOf(a, tgt) : 0 - 1
    if tgt == 0 || (
        tk != at.AST_IDENTIFIER && tk != at.AST_MEMBER && tk != at.AST_INDEX
    ):
        lv_error(v, a, n, "assignment to a non-lvalue")
        ret
    end

    if nd.op == tok.TK_ASSIGN && tk == at.AST_INDEX && lv_index_set(v, s, a, tgt, nd.b):
        ret
    end
    addr := lv_addr_of(v, s, a, tgt)
    ts := addr.ts
    mut rhs := ""
    if nd.op == tok.TK_ASSIGN:
        rhs = conv(v, s, a, lv_expr(v, s, a, nd.b), ts)
    else:
        base := compound_base(nd.op)
        if base == tok.TK_EOF:
            lv_error(v, a, n, "compound assignment operator")
            ret
        end
        bin := at.NewNode(a, at.AST_BINARY)
        at.SetOp(a, bin, base)
        at.SetTypeStr(a, bin, ts)
        mut bn := at.Get(a, bin)
        bn.a = tgt
        bn.b = nd.b
        at.Put(a, bin, bn)
        rhs = conv(v, s, a, lv_binary(v, s, a, bin), ts)
    end
    emit(v, "store " + ty_of(v, s, a, ts) + " " + rhs + ", ptr " + addr.ptr)
end

// (C: cg->locals.len = mark) - pop back to a saved local-scope mark.
func locals_trunc(v &: Lv, mark: int):
    until v.locals.len() > mark:
        _dropped := v.locals.pop()
    end
end

// ll_stmts_scoped
func stmts_scoped(v &: Lv, s &: sm.Sema, a &: at.Ast, block: int):
    mark := v.locals.len()
    bn := at.Get(a, block)
    mut i := 0
    until i < bn.list.len():
        lv_stmt(v, s, a, bn.list.get(i)[0])
        i += 1
    end
    locals_trunc(v, mark)
end

// ll_if
func lv_if(v &: Lv, s &: sm.Sema, a &: at.Ast, n: int):
    nd := at.Get(a, n)
    cond := as_i1(v, s, a, lv_expr(v, s, a, nd.a))
    thenL := new_lbl(v, "then")
    endL := new_lbl(v, "endif")
    elseL := nd.c != 0 ? new_lbl(v, "else") : endL
    emit_term(v, "br i1 " + cond + ", label %" + thenL + ", label %" + elseL)
    emit_label(v, thenL)
    stmts_scoped(v, s, a, nd.b)
    emit_term(v, "br label %" + endL)
    if nd.c != 0:
        emit_label(v, elseL)
        if at.KindOf(a, nd.c) == at.AST_IF:
            lv_stmt(v, s, a, nd.c)
        else:
            stmts_scoped(v, s, a, nd.c)
        end
        emit_term(v, "br label %" + endL)
    end
    emit_label(v, endL)
end

// ll_match_stmt
func lv_match_stmt(v &: Lv, s &: sm.Sema, a &: at.Ast, n: int):
    nd := at.Get(a, n)
    if nd.list.len() == 0:
        _discard := lv_expr(v, s, a, nd.a)
        ret
    end
    subj := lv_expr(v, s, a, nd.a)
    is_variant := str.StartsWith(subj.ts, "Variant<")
    endL := new_lbl(v, "mend")
    mut i := 0
    until i < nd.list.len():
        arm := nd.list.get(i)[0]
        cond := lv_match_arm_cond(v, s, a, arm, subj, is_variant)
        bodyL := new_lbl(v, "marm")
        nextL := (i + 1 < nd.list.len()) ? new_lbl(v, "mnext") : endL
        emit_term(v, "br i1 " + cond + ", label %" + bodyL + ", label %" + nextL)
        emit_label(v, bodyL)
        stmts_scoped(v, s, a, at.Get(a, arm).b)
        emit_term(v, "br label %" + endL)
        emit_label(v, nextL)
        i += 1
    end
end

// loop-stack push (see the file header for the protocol).
func loop_push(v &: Lv, brklbl: str, contlbl: str):
    if v.brk.len() == v.nloop:
        v.brk.push(brklbl)
        v.cont.push(contlbl)
    else:
        v.brk.set(v.nloop, brklbl)
        v.cont.set(v.nloop, contlbl)
    end
    v.nloop += 1
end

// ll_while
func lv_while(v &: Lv, s &: sm.Sema, a &: at.Ast, n: int):
    nd := at.Get(a, n)
    condL := new_lbl(v, "wcond")
    bodyL := new_lbl(v, "wbody")
    endL := new_lbl(v, "wend")
    emit_term(v, "br label %" + condL)
    emit_label(v, condL)
    emit_term(
        v, "br i1 " + as_i1(v, s, a, lv_expr(v, s, a, nd.a)) + ", label %" + bodyL + ", label %" + endL
    )
    emit_label(v, bodyL)
    if v.nloop >= 64:
        lv_error(v, a, n, "loop nesting too deep")
        ret
    end
    loop_push(v, endL, condL)
    stmts_scoped(v, s, a, nd.b)
    v.nloop -= 1
    emit_term(v, "br label %" + condL)
    emit_label(v, endL)
end

// ll_for
func lv_for(v &: Lv, s &: sm.Sema, a &: at.Ast, n: int):
    nd := at.Get(a, n)
    mark := v.locals.len()
    if nd.a != 0:
        lv_stmt(v, s, a, nd.a)
    end
    condL := new_lbl(v, "fcond")
    bodyL := new_lbl(v, "fbody")
    stepL := new_lbl(v, "fstep")
    endL := new_lbl(v, "fend")
    emit_term(v, "br label %" + condL)
    emit_label(v, condL)
    if nd.b != 0:
        emit_term(
            v, "br i1 " + as_i1(v, s, a, lv_expr(v, s, a, nd.b)) + ", label %" + bodyL + ", label %" + endL
        )
    else:
        emit_term(v, "br label %" + bodyL)
    end
    emit_label(v, bodyL)
    if v.nloop >= 64:
        lv_error(v, a, n, "loop nesting too deep")
        locals_trunc(v, mark)
        ret
    end
    loop_push(v, endL, stepL)
    stmts_scoped(v, s, a, nd.d)
    v.nloop -= 1
    emit_term(v, "br label %" + stepL)
    emit_label(v, stepL)
    if nd.c != 0:
        lv_stmt(v, s, a, nd.c)
    end
    emit_term(v, "br label %" + condL)
    emit_label(v, endL)
    locals_trunc(v, mark)
end

// ll_const_i64
func const_i64(a &: at.Ast, n: int, out2 &: i64): bool:
    if n == 0:
        ret false
    end
    nd := at.Get(a, n)
    if nd.kind != at.AST_LITERAL || nd.op != tok.TK_INT:
        ret false
    end
    out2 = nd.value_int as i64
    ret true
end

// ll_repeat
func lv_repeat(v &: Lv, s &: sm.Sema, a &: at.Ast, n: int):
    nd := at.Get(a, n)
    mut initv := ""
    mut boundv := ""
    mut stepv := ""
    mut dir := ""
    mut static_dir := false
    mut static_up := false
    if nd.c != 0:
        mut ci := 0 as i64
        mut cb := 0 as i64
        if const_i64(a, nd.a, ci) && const_i64(a, nd.c, cb):
            static_dir = true
            static_up = ci <= cb
            initv = co.I64Toa(ci)
            boundv = co.I64Toa(cb)
            if nd.d == 0:
                stepv = static_up ? "1" : "-1"
            else:
                mut cs := 0 as i64
                if const_i64(a, nd.d, cs):
                    stepv = co.I64Toa(static_up ? cs : (0 as i64) - cs)
                else:
                    raw := conv(v, s, a, lv_expr(v, s, a, nd.d), "i64")
                    if static_up:
                        stepv = raw
                    else:
                        stepv = new_tmp(v)
                        emit(v, stepv + " = sub i64 0, " + raw)
                    end
                end
            end
        else:
            initv = conv(v, s, a, lv_expr(v, s, a, nd.a), "i64")
            boundv = conv(v, s, a, lv_expr(v, s, a, nd.c), "i64")
            raw2 := nd.d != 0 ? conv(v, s, a, lv_expr(v, s, a, nd.d), "i64") : "1"
            neg := new_tmp(v)
            dir = new_tmp(v)
            emit(v, dir + " = icmp sle i64 " + initv + ", " + boundv)
            emit(v, neg + " = sub i64 0, " + raw2)
            stepv = new_tmp(v)
            emit(
                v, stepv + " = select i1 " + dir + ", i64 " + raw2 + ", i64 " + neg
            )
        end
    else:
        initv = "0"
        boundv = conv(v, s, a, lv_expr(v, s, a, nd.a), "i64")
        stepv = "1"
    end
    ctr := new_tmp(v)
    emit_alloca(v, ctr + " = alloca i64")
    emit(v, "store i64 " + initv + ", ptr " + ctr)
    mark := v.locals.len()
    mut bindp := ""
    iv_is64 := str.Len(nd.type_str) > 0 && str.Equals(nd.type_str, "i64")
    ivty := iv_is64 ? "i64" : "i32"
    if str.Len(nd.name) > 0:
        bindp = "%v." + safe_name(nd.name) + "." + co.I64Toa(v.tmp as i64)
        v.tmp += 1
        emit_alloca(v, bindp + " = alloca " + ivty)
        local_add(v, nd.name, bindp, ivty)
    end
    condL := new_lbl(v, "rcond")
    bodyL := new_lbl(v, "rbody")
    stepL := new_lbl(v, "rstep")
    endL := new_lbl(v, "rend")
    emit_term(v, "br label %" + condL)
    emit_label(v, condL)
    cv := new_tmp(v)
    emit(v, cv + " = load i64, ptr " + ctr)
    mut cmp := ""
    if nd.c != 0 && static_dir:
        cmp = new_tmp(v)
        emit(
            v, cmp + " = icmp " + (static_up ? "sle" : "sge") + " i64 " + cv + ", " + boundv
        )
    else nd.c != 0:
        le := new_tmp(v)
        ge := new_tmp(v)
        emit(v, le + " = icmp sle i64 " + cv + ", " + boundv)
        emit(v, ge + " = icmp sge i64 " + cv + ", " + boundv)
        cmp = new_tmp(v)
        emit(v, cmp + " = select i1 " + dir + ", i1 " + le + ", i1 " + ge)
    else:
        cmp = new_tmp(v)
        emit(v, cmp + " = icmp slt i64 " + cv + ", " + boundv)
    end
    emit_term(v, "br i1 " + cmp + ", label %" + bodyL + ", label %" + endL)
    emit_label(v, bodyL)
    if str.Len(bindp) > 0:
        if iv_is64:
            emit(v, "store i64 " + cv + ", ptr " + bindp)
        else:
            cvt := new_tmp(v)
            emit(v, cvt + " = trunc i64 " + cv + " to i32")
            emit(v, "store i32 " + cvt + ", ptr " + bindp)
        end
    end
    if v.nloop >= 64:
        lv_error(v, a, n, "loop nesting too deep")
        locals_trunc(v, mark)
        ret
    end
    loop_push(v, endL, stepL)
    stmts_scoped(v, s, a, nd.b)
    v.nloop -= 1
    emit_term(v, "br label %" + stepL)
    emit_label(v, stepL)
    cv2 := new_tmp(v)
    emit(v, cv2 + " = load i64, ptr " + ctr)
    inc := new_tmp(v)
    emit(v, inc + " = add i64 " + cv2 + ", " + stepv)
    emit(v, "store i64 " + inc + ", ptr " + ctr)
    emit_term(v, "br label %" + condL)
    emit_label(v, endL)
    locals_trunc(v, mark)
end

// ll_stmt
func lv_stmt(v &: Lv, s &: sm.Sema, a &: at.Ast, n: int):
    if n == 0 || v.term:
        ret
    end
    nd := at.Get(a, n)
    if v.debug && nd.begin_line != (0 as u32):
        v.cur_dbg = debug_location(v, nd.begin_line as int, nd.begin_col as int)
    end
    k := nd.kind
    if k == at.AST_BLOCK:
        lv_block(v, s, a, n)
        ret
    end
    if k == at.AST_VAR_DECL:
        lv_vardecl(v, s, a, n)
        ret
    end
    if k == at.AST_CONST_DECL:
        lv_vardecl(v, s, a, n)
        ret
    end
    if k == at.AST_ASSIGN:
        lv_assign(v, s, a, n)
        ret
    end
    if k == at.AST_EXPR_STMT:
        _discard := lv_expr(v, s, a, nd.a)
        ret
    end
    if k == at.AST_INCDEC:
        _discard2 := lv_expr(v, s, a, n)
        ret
    end
    if k == at.AST_RETURN:
        emit_return(v, s, a, nd.a)
        ret
    end
    if k == at.AST_IF:
        lv_if(v, s, a, n)
        ret
    end
    if k == at.AST_MATCH:
        lv_match_stmt(v, s, a, n)
        ret
    end
    if k == at.AST_UNTIL:
        lv_while(v, s, a, n)
        ret
    end
    if k == at.AST_FOR:
        lv_for(v, s, a, n)
        ret
    end
    if k == at.AST_REPEAT:
        lv_repeat(v, s, a, n)
        ret
    end
    if k == at.AST_DEFER:
        v.defers.push(nd.a)
        ret
    end
    if k == at.AST_BREAK:
        if v.nloop > 0:
            emit_term(v, "br label %" + v.brk.get(v.nloop - 1)[0])
        end
        ret
    end
    if k == at.AST_CONTINUE:
        if v.nloop > 0:
            emit_term(v, "br label %" + v.cont.get(v.nloop - 1)[0])
        end
        ret
    end
    lv_error(v, a, n, at.KindName(k) + " statement")
end

// ll_block
func lv_block(v &: Lv, s &: sm.Sema, a &: at.Ast, block: int):
    stmts_scoped(v, s, a, block)
end

// ll_block_top
func lv_block_top(v &: Lv, s &: sm.Sema, a &: at.Ast, block: int):
    bn := at.Get(a, block)
    mut i := 0
    until i < bn.list.len():
        lv_stmt(v, s, a, bn.list.get(i)[0])
        i += 1
    end
end

// ===========================================================================
// driver/llvm_toolchain.c (stage C - see the file-header note for why this,
// and not llvm_native.c's #ifdef SALAM_HAVE_LLVM body, is what's ported).
// Every private below is prefixed `nt_` (native toolchain) to keep it out of
// the `ll_*`/C-name-mirroring convention used for the LLVM-IR emitter.
// ===========================================================================

// opt_flag
func nt_opt_flag(l: int): str:
    if l == LV_OPT_O0:
        ret "-O0"
    end
    if l == LV_OPT_O1:
        ret "-O1"
    end
    if l == LV_OPT_O2:
        ret "-O2"
    end
    if l == LV_OPT_O3:
        ret "-O3"
    end
    if l == LV_OPT_OS:
        ret "-Os"
    end
    if l == LV_OPT_OZ:
        ret "-Oz"
    end
    ret "-O0"
end

// triple_is_windows / triple_is_wasm (llvm_toolchain.c: no host-OS fallback
// for an empty triple, unlike ll_target_is_windows a few hundred lines up - // an empty/default triple means "host default", and the C's `!win && !wasm`
// gate for appending `-lm` must stay true in that case).
func nt_triple_is_windows(t: str): bool:
    if str.Len(t) == 0:
        ret false
    end
    ret str.Contains(t, "windows") || str.Contains(t, "mingw") || str.Contains(t, "win32")
end

func nt_triple_is_wasm(t: str): bool:
    ret str.Len(t) > 0 && str.Contains(t, "wasm")
end

// sb_put_shell_arg. Windows branch: C-style double-quote escaping (only
// reachable when SALAM_OS_WINDOWS is compiled in, which this port's own
// WSL/Linux verification builds prune away, exactly like every other
// host-OS conditional in this file). POSIX branch: single-quote wrap with
// '\'' escaping.
func nt_shell_arg(v: str): str:
    if SALAM_OS_WINDOWS:
        mut out := "\""
        n := str.Len(v)
        mut i := 0
        until i < n:
            mut nbs := 0
            until i < n && byte_at(v, i) == 92:
                nbs += 1
                i += 1
            end
            if i == n:
                mut k := 0
                until k < nbs * 2:
                    out += "\\"
                    k += 1
                end
            else byte_at(v, i) == 34:
                mut k2 := 0
                until k2 < nbs * 2 + 1:
                    out += "\\"
                    k2 += 1
                end
                out += "\""
                i += 1
            else:
                mut k3 := 0
                until k3 < nbs:
                    out += "\\"
                    k3 += 1
                end
                out += str.Substr(v, i, 1)
                i += 1
            end
        end
        out += "\""
        ret out
    else:
        mut out2 := "'"
        n2 := str.Len(v)
        mut j := 0
        until j < n2:
            if byte_at(v, j) == 39:
                out2 += "'\\''"
            else:
                out2 += str.Substr(v, j, 1)
            end
            j += 1
        end
        out2 += "'"
        ret out2
    end
end

// to_tool_path. POSIX: passed through unchanged (the C's realpath() call is
// skipped - no Salam stdlib equivalent, and every caller in this port
// already hands a cwd-relative or absolute path that bash resolves fine on
// its own). Windows: `C:\foo\bar` -> `/mnt/c/foo/bar` for `wsl.exe -e bash`
// (drive-letter case-folded, backslashes flipped); a path with no drive
// prefix is passed through as-is. This branch is compile-time-pruned out on
// every build this port is verified against.
func nt_to_tool_path(host: str): str:
    if SALAM_OS_WINDOWS:
        n := str.Len(host)
        if n >= 2 && is_alpha_b(byte_at(host, 0)) && byte_at(host, 1) == 58:
            mut out := "/mnt/" + str.Lower(str.Substr(host, 0, 1))
            mut i := 2
            until i < n:
                c := byte_at(host, i)
                out += (c == 92) ? "/" : str.Substr(host, i, 1)
                i += 1
            end
            ret out
        end
        ret host
    else:
        ret host
    end
end

// resolve_tool - sm.FindBundledTool next to the running executable, else a
// bare fallback name resolved via PATH by the shell.
func nt_resolve_tool(bundled: str, fallback: str): str:
    mut out := ""
    if sm.FindBundledTool(bundled, out):
        ret nt_to_tool_path(out)
    end
    ret fallback
end

func nt_has_path_char(spec: str): bool:
    ret str.Contains(spec, "/") || str.Contains(spec, "\\") || str.Contains(spec, ".")
end

// emit_llvm_link
func nt_emit_llvm_link(spec: str, kind: str, windows: bool): str:
    if str.Len(spec) == 0:
        ret " -l" + nt_shell_arg(spec)
    end
    framework := str.Equals(kind, "framework")
    is_static := str.Equals(kind, "static")
    if framework:
        ret " -framework " + nt_shell_arg(spec)
    end
    if byte_at(spec, 0) == 45 || nt_has_path_char(spec):
        ret " " + nt_shell_arg(spec)
    end
    if is_static && !windows:
        ret " -Wl,-Bstatic -l" + nt_shell_arg(spec) + " -Wl,-Bdynamic"
    end
    ret " -l" + nt_shell_arg(spec)
end

// emit_tool_cmd - the tool-invocation line(s) appended after the script's
// IN/OUT/SYSROOT variable assignments. link_kinds shorter than link_libs
// (or absent) reads as "" per slot, same as the C's NULL kind.
func nt_emit_tool_cmd(opts: Options): str:
    clang_tool := nt_resolve_tool("clang", "clang-22")
    opt_tool := nt_resolve_tool("opt", "opt-22")
    lli_tool := nt_resolve_tool("lli", "lli-22")
    o_flag := nt_opt_flag(opts.opt_level)
    triple := opts.target_triple

    mut out := ""
    if opts.verify_module:
        out += "\"" + opt_tool + "\" -passes=verify -disable-output \"$IN\"\n"
    end

    if opts.output_mode == LV_OUT_ASM:
        out += "\"" + clang_tool + "\" " + o_flag
        if str.Len(triple) > 0:
            out += " --target=" + triple
        else opts.native_cpu:
            out += " -march=native"
        end
        out += " -S \"$IN\" -o \"$OUT\"\n"
    else opts.output_mode == LV_OUT_OBJ:
        out += "\"" + clang_tool + "\" " + o_flag
        if str.Len(triple) > 0:
            out += " --target=" + triple
        else opts.native_cpu:
            out += " -march=native"
        end
        out += " -c \"$IN\" -o \"$OUT\"\n"
    else opts.output_mode == LV_OUT_BITCODE:
        out += "\"" + opt_tool + "\" " + o_flag + " \"$IN\" -o \"$OUT\"\n"
    else opts.output_mode == LV_OUT_EXEC:
        win := nt_triple_is_windows(triple)
        wasm := nt_triple_is_wasm(triple)
        out += "\"" + clang_tool + "\" " + o_flag
        if str.Len(triple) > 0:
            out += " --target=" + triple
        else opts.native_cpu:
            out += " -march=native"
        end
        if opts.debug_info:
            out += " -g"
        end
        if str.Len(opts.sysroot) > 0:
            out += " --sysroot=\"$SYSROOT\""
        end
        if win:
            out += " -fuse-ld=lld"
        end
        out += " \"$IN\""
        mut li := 0
        until li < opts.link_libs.len():
            spec := opts.link_libs.get(li)[0]
            mut kind := ""
            if li < opts.link_kinds.len():
                kind = opts.link_kinds.get(li)[0]
            end
            out += nt_emit_llvm_link(spec, kind, win)
            li += 1
        end
        if !win && !wasm:
            out += " -lm"
        end
        out += " -o \"$OUT\"\n"
    else opts.output_mode == LV_OUT_JIT:
        if opts.opt_level != LV_OPT_O0:
            out += "\"" + opt_tool + "\" " + o_flag + " \"$IN\" -o - | \"" + lli_tool + "\" -\n"
        else:
            out += "\"" + lli_tool + "\" \"$IN\"\n"
        end
    else opts.output_mode == LV_OUT_IR:
        if opts.opt_level != LV_OPT_O0:
            out += "\"" + opt_tool + "\" " + o_flag + " -S \"$IN\" -o \"$IN\"\n"
        else !opts.verify_module:
            out += "true\n"
        end
    end
    ret out
end

// A quick "<tool> --version" PATH probe (redirected, exit code only).
func nt_probe_tool(tool: str): bool:
    mut cmd := "\"" + tool + "\" --version"
    if SALAM_OS_WINDOWS:
        cmd += " >NUL 2>&1"
    else:
        cmd += " >/dev/null 2>&1"
    end
    ret os.Run(cmd) == 0
end

// ===========================================================================
// PUBLIC API (rule E088: pub functions last). Mapping to the C surface:
//   OptionsDefault  = codegen_llvm_options_default
//   ErrorOf         = codegen_llvm_error
//   Run             = codegen_llvm_run
//   RunOpts         = codegen_llvm_run_opts (opts by value; OptionsDefault()
//                     plays the C NULL; src_path "" = NULL)
//   NativeAvailable/NativeRun = driver/llvm_toolchain.c's clang/opt/lli
//                     shell-out path (salam_llvm_toolchain's fallback
//                     branch - see the file-header note for why, not
//                     llvm_native.c's #ifdef SALAM_HAVE_LLVM body).
//   NativeBuildScript = no direct C equivalent - exposes emit_tool_cmd's
//                     generated script text for assertions without running
//                     a real toolchain.
// The remaining pubs re-export internals for tests_port/llvm_test.salam and
// stage B/C (the role of codegen_llvm_internal.h).
// ===========================================================================

// codegen_llvm_options_default
pub func OptionsDefault(): Options:
    ret Options {}
end

// codegen_llvm_error
pub func ErrorOf(o: Output): str:
    ret o.error
end

// Test/backend constructor mirroring codegen_llvm_run_opts' init block
// (no C equivalent; cross-package struct literals are impossible).
pub func NewLv(
    lgr: lg.Logger, module_name: str, entry: str, triple: str
): Lv:
    mut v := new_lv0()
    v.log = lgr
    v.module = module_name
    v.entry = str.Len(entry) > 0 ? entry : "main"
    v.ok = true
    v.triple = triple
    v.ptr_bits = target_ptr_bits_of(triple)
    v.usize = v.ptr_bits == 32 ? "i32" : "i64"
    ret v
end

pub func FreeLv(v &: Lv):
    free_lv(v)
end

