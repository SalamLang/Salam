@en "llvmbridge"
@fa "پل ال ال وی ام"
package llvmbridge

import str

if SALAM_HAVE_LLVM:
    import llvm

    pub func Available(): bool:
        ret llvm.Available()
    end

    pub func HostTriple(): str:
        ret llvm.DefaultTriple()
    end

    pub func Run(
        ll_path: str,
        opt_level: int,
        output_mode: int,
        output_file: str,
        target_triple: str,
        debug_info: bool,
        verify_module: bool,
        native_cpu: bool,
        sysroot: str,
        link_libs: Vector<str>,
        link_kinds: Vector<str>,
        lib_paths: Vector<str>,
        err &: str
    ): int:
        mut o := llvm.Options {}
        o.opt_level = opt_level
        o.output_mode = output_mode
        o.output_file = output_file
        o.target_triple = target_triple
        o.debug_info = debug_info
        o.verify_module = verify_module
        o.native_cpu = native_cpu
        o.sysroot = sysroot
        o.link_libs = link_libs
        o.link_kinds = link_kinds
        o.lib_paths = lib_paths
        r := llvm.Run(ll_path, o)
        if r.ok:
            ret 0
        end
        err = r.error
        ret 1
    end
else:
    pub func Available(): bool:
        ret false
    end

    pub func HostTriple(): str:
        ret ""
    end

    pub func Run(
        _ll_path: str,
        _opt_level: int,
        _output_mode: int,
        _output_file: str,
        _target_triple: str,
        _debug_info: bool,
        _verify_module: bool,
        _native_cpu: bool,
        _sysroot: str,
        _link_libs: Vector<str>,
        _link_kinds: Vector<str>,
        _lib_paths: Vector<str>,
        _err &: str
    ): int:
        ret 0 - 1
    end
end
