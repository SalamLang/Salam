// codegen_llvm_options_default
pub func OptionsDefault(): Options:
    ret Options {}
end

// codegen_llvm_error
pub func ErrorOf(o: Output): str:
    ret o.error
end

// Test/backend constructor mirroring codegen_llvm_run_opts' init block
// (no C equivalent; cross-package struct literals are impossible).
pub func NewLv(
    lgr: lg.Logger, module_name: str, entry: str, triple: str
): Lv:
    mut v := new_lv0()
    v.log = lgr
    v.module = module_name
    v.entry = str.Len(entry) > 0 ? entry : "main"
    v.ok = true
    v.triple = triple
    v.ptr_bits = target_ptr_bits_of(triple)
    v.usize = v.ptr_bits == 32 ? "i32" : "i64"
    ret v
end

pub func FreeLv(v &: Lv):
    free_lv(v)
end

