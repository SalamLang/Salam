package llvmgen

import str
import llvm.triple

include co "../sal_core.salam"
include at "../ast.salam"
include sm "../semantic/semantic.salam"

func dl_host(): str:
    ret triple.HostDatalayout()
end

func datalayout(t: str): str:
    ret triple.Datalayout(t)
end

func target_is_glibc_of(t: str): bool:
    ret triple.IsGlibc(t)
end

func resolve_glibc(triple: str): bool:
    if str.Len(triple) > 0: ret target_is_glibc_of(triple) end
    ret nt_host_is_glibc()
end

func target_is_windows_of(t: str): bool:
    ret triple.IsWindows(t)
end

func pl_widen(v &: Lv, src: str, dst: str): str:
    if v.ptr_bits <= 32:
        ret src
    end
    out_hg(v, "  " + dst + " = sext i32 " + src + " to " + v.usize + "\n")
    ret dst
end

func program_defines(a &: at.Ast, name: str): bool:
    total := at.Count(a)
    mut i := 1
    until i < total:
        n := at.Get(a, i)
        if n.kind == at.AST_FUNC_DEF and n.is_extern and n.a != 0 and str.Equals(n.name, name):
            ret true
        end
        i += 1
    end
    ret false
end

func declare_libc(v &: Lv, a &: at.Ast, name: str, proto: str):
    if program_defines(a, name):
        ret
    end
    out_g(v, proto)
end

func emit_prologue(v &: Lv, a &: at.Ast):
    u := v.usize
    out_g(
        v, "; Salam -> LLVM IR (textual). usize = " + u + " (" + (v.ptr_bits == 32 ? "32" : "64") + "-bit target).\n"
    )
    declare_libc(v, a, "printf", "declare i32 @printf(ptr, ...) nounwind\n")
    declare_libc(v, a, "dprintf", "declare i32 @dprintf(i32, ptr, ...) nounwind\n")
    declare_libc(v, a, "write", "declare " + u + " @write(i32, ptr, " + u + ") nounwind\n")
    declare_libc(
        v, a, "strlen", "declare " + u + " @strlen(ptr) nounwind willreturn memory(argmem: read)\n"
    )
    declare_libc(v, a, "strcmp", "declare i32 @strcmp(ptr, ptr) nounwind willreturn memory(argmem: read)\n")
    declare_libc(v, a, "malloc", "declare noalias ptr @malloc(" + u + ") nounwind allocsize(0)\n")
    if v.libc_glibc:
        out_g(v, "declare i32 @mallopt(i32, i32) nounwind\n")
    end
    declare_libc(
        v, a, "realloc", "declare noalias ptr @realloc(ptr, " + u + ") nounwind allocsize(1)\n"
    )
    declare_libc(
        v, a, "calloc", "declare noalias ptr @calloc(" + u + ", " + u + ") nounwind allocsize(0, 1)\n"
    )
    declare_libc(v, a, "free", "declare void @free(ptr) nounwind\n")
    declare_libc(v, a, "memset", "declare ptr @memset(ptr, i32, " + u + ") nounwind\n")
    declare_libc(v, a, "memcpy", "declare ptr @memcpy(ptr, ptr, " + u + ") nounwind\n")
    declare_libc(v, a, "memmove", "declare ptr @memmove(ptr, ptr, " + u + ") nounwind\n")
    out_g(v, "declare void @llvm.memset.p0." + u + "(ptr, i8, " + u + ", i1) nounwind\n")
    declare_libc(v, a, "abort", "declare void @abort() noreturn nounwind cold\n")
    declare_libc(v, a, "exit", "declare void @exit(i32) noreturn nounwind\n")
    declare_libc(v, a, "atexit", "declare i32 @atexit(ptr) nounwind\n")
    declare_libc(v, a, "fflush", "declare i32 @fflush(ptr) nounwind\n")
    declare_libc(v, a, "signal", "declare ptr @signal(i32, ptr) nounwind\n")
    declare_libc(v, a, "raise", "declare i32 @raise(i32) nounwind\n")
    declare_libc(v, a, isatty_name(v), "declare i32 @" + isatty_name(v) + "(i32) nounwind\n")
    declare_libc(v, a, "snprintf", "declare i32 @snprintf(ptr, " + u + ", ptr, ...) nounwind\n")
    declare_libc(v, a, "strtol", "declare " + ltype(v) + " @strtol(ptr, ptr, i32) nounwind\n")
    declare_libc(v, a, "strtod", "declare double @strtod(ptr, ptr) nounwind\n")
    declare_libc(v, a, "strstr", "declare ptr @strstr(ptr, ptr) nounwind willreturn memory(argmem: read)\n")
    out_g(v, "declare double @llvm.pow.f64(double, double)\n")
    out_g(v, "%dyn = type { ptr, ptr }\n")
end

func emit_substr(v &: Lv):
    u := v.usize
    out_hg(v, "define internal noalias ptr @salam_ll_substr(ptr %s, i32 %start, i32 %len) nounwind willreturn nofree {\nentry:\n")
    out_hg(v, "  %n = call " + u + " @strlen(ptr %s)\n")
    out_hg(v, "  %sneg = icmp slt i32 %start, 0\n")
    out_hg(v, "  %s0 = select i1 %sneg, i32 0, i32 %start\n")
    out_hg(v, "  %lneg = icmp slt i32 %len, 0\n")
    out_hg(v, "  %l0 = select i1 %lneg, i32 0, i32 %len\n")
    sw := pl_widen(v, "%s0", "%sw")
    lw := pl_widen(v, "%l0", "%lw")
    out_hg(v, "  %sbig = icmp ugt " + u + " " + sw + ", %n\n")
    out_hg(v, "  %so = select i1 %sbig, " + u + " %n, " + u + " " + sw + "\n")
    out_hg(v, "  %rem = sub " + u + " %n, %so\n")
    out_hg(v, "  %lbig = icmp ugt " + u + " " + lw + ", %rem\n")
    out_hg(v, "  %l = select i1 %lbig, " + u + " %rem, " + u + " " + lw + "\n")
    out_hg(v, "  %t = add " + u + " %l, 1\n")
    out_hg(v, "  %buf = call ptr @malloc(" + u + " %t)\n")
    out_hg(v, "  %src = getelementptr i8, ptr %s, " + u + " %so\n")
    out_hg(v, "  %c = call ptr @memcpy(ptr %buf, ptr %src, " + u + " %l)\n")
    out_hg(v, "  %e = getelementptr i8, ptr %buf, " + u + " %l\n")
    out_hg(v, "  store i8 0, ptr %e\n  ret ptr %buf\n}\n\n")
end

func emit_strcat(v &: Lv):
    u := v.usize
    out_hg(
        v, "define internal noalias ptr @salam_ll_strcat(ptr %a, ptr %b) nounwind willreturn nofree {\n" + "entry:\n" + "  %la = call " + u + " @strlen(ptr %a)\n" + "  %lb = call " + u + " @strlen(ptr %b)\n" + "  %sum = add " + u + " %la, %lb\n" + "  %tot = add " + u + " %sum, 1\n" + "  %buf = call ptr @malloc(" + u + " %tot)\n" + "  %c1 = call ptr @memcpy(ptr %buf, ptr %a, " + u + " %la)\n" + "  %end = getelementptr i8, ptr %buf, " + u + " %la\n" + "  %lb1 = add " + u + " %lb, 1\n" + "  %c2 = call ptr @memcpy(ptr %end, ptr %b, " + u + " %lb1)\n" + "  ret ptr %buf\n}\n\n"
    )
end

func emit_isws(v &: Lv):
    out_hg(
        v, "define internal i1 @salam_ll_isws(i8 %c) nounwind willreturn memory(none) {\n" + "entry:\n" + "  %s32 = icmp eq i8 %c, 32\n" + "  %s9 = icmp eq i8 %c, 9\n" + "  %s10 = icmp eq i8 %c, 10\n" + "  %s13 = icmp eq i8 %c, 13\n" + "  %o1 = or i1 %s32, %s9\n" + "  %o2 = or i1 %o1, %s10\n" + "  %o3 = or i1 %o2, %s13\n" + "  ret i1 %o3\n}\n\n"
    )
end

func emit_trim(v &: Lv):
    need(v, LV_H_ISWS)
    u := v.usize
    out_hg(
        v, "define internal noalias ptr @salam_ll_trim(ptr %s) nounwind willreturn nofree {\n" + "entry:\n" + "  %n = call " + u + " @strlen(ptr %s)\n" + "  br label %f\n" + "f:\n" + "  %a = phi " + u + " [ 0, %entry ], [ %an, %fbody ]\n" + "  %c1 = icmp ult " + u + " %a, %n\n" + "  br i1 %c1, label %fchk, label %b\n" + "fchk:\n" + "  %p1 = getelementptr i8, ptr %s, " + u + " %a\n" + "  %ch1 = load i8, ptr %p1\n" + "  %w1 = call i1 @salam_ll_isws(i8 %ch1)\n" + "  br i1 %w1, label %fbody, label %b\n" + "fbody:\n" + "  %an = add " + u + " %a, 1\n" + "  br label %f\n" + "b:\n" + "  br label %r\n" + "r:\n" + "  %e = phi " + u + " [ %n, %b ], [ %en, %rbody ]\n" + "  %c2 = icmp ugt " + u + " %e, %a\n" + "  br i1 %c2, label %rchk, label %done\n" + "rchk:\n" + "  %em1 = sub " + u + " %e, 1\n" + "  %p2 = getelementptr i8, ptr %s, " + u + " %em1\n" + "  %ch2 = load i8, ptr %p2\n" + "  %w2 = call i1 @salam_ll_isws(i8 %ch2)\n" + "  br i1 %w2, label %rbody, label %done\n" + "rbody:\n" + "  %en = sub " + u + " %e, 1\n" + "  br label %r\n" + "done:\n" + "  %len = sub " + u + " %e, %a\n" + "  %tot = add " + u + " %len, 1\n" + "  %buf = call ptr @malloc(" + u + " %tot)\n" + "  %src = getelementptr i8, ptr %s, " + u + " %a\n" + "  %cp = call ptr @memcpy(ptr %buf, ptr %src, " + u + " %len)\n" + "  %endp = getelementptr i8, ptr %buf, " + u + " %len\n" + "  store i8 0, ptr %endp\n" + "  ret ptr %buf\n}\n\n"
    )
end

func emit_repeat(v &: Lv):
    u := v.usize
    out_hg(v, "define internal noalias ptr @salam_ll_repeat(ptr %s, i32 %n) nounwind willreturn nofree {\nentry:\n")
    out_hg(v, "  %slen = call " + u + " @strlen(ptr %s)\n")
    nw := pl_widen(v, "%n", "%nw")
    out_hg(v, "  %nle0 = icmp sle i32 %n, 0\n")
    out_hg(v, "  %slen0 = icmp eq " + u + " %slen, 0\n")
    out_hg(v, "  %skip = or i1 %nle0, %slen0\n")
    out_hg(v, "  br i1 %skip, label %empty, label %compute\n")
    out_hg(v, "empty:\n")
    out_hg(v, "  %eb = call ptr @malloc(" + u + " 1)\n")
    out_hg(v, "  store i8 0, ptr %eb\n  ret ptr %eb\n")
    out_hg(v, "compute:\n")
    out_hg(v, "  %total = mul " + u + " %slen, " + nw + "\n")
    out_hg(v, "  %tot1 = add " + u + " %total, 1\n")
    out_hg(v, "  %buf = call ptr @malloc(" + u + " %tot1)\n")
    out_hg(v, "  %c0 = call ptr @memcpy(ptr %buf, ptr %s, " + u + " %slen)\n")
    out_hg(v, "  br label %loop\n")
    out_hg(v, "loop:\n")
    out_hg(
        v, "  %filled = phi " + u + " [ %slen, %compute ], [ %newfilled, %body ]\n"
    )
    out_hg(v, "  %done = icmp uge " + u + " %filled, %total\n")
    out_hg(v, "  br i1 %done, label %finish, label %body\n")
    out_hg(v, "body:\n")
    out_hg(v, "  %remain = sub " + u + " %total, %filled\n")
    out_hg(v, "  %lt = icmp ult " + u + " %filled, %remain\n")
    out_hg(
        v, "  %chunk = select i1 %lt, " + u + " %filled, " + u + " %remain\n"
    )
    out_hg(v, "  %dst = getelementptr i8, ptr %buf, " + u + " %filled\n")
    out_hg(
        v, "  %cc = call ptr @memcpy(ptr %dst, ptr %buf, " + u + " %chunk)\n"
    )
    out_hg(v, "  %newfilled = add " + u + " %filled, %chunk\n")
    out_hg(v, "  br label %loop\n")
    out_hg(v, "finish:\n")
    out_hg(v, "  %endp = getelementptr i8, ptr %buf, " + u + " %total\n")
    out_hg(v, "  store i8 0, ptr %endp\n  ret ptr %buf\n}\n\n")
end

func emit_case(v &: Lv, fname: str, lo: int, hi: int, delta: int):
    u := v.usize
    out_hg(
        v, "define internal noalias ptr @" + fname + "(ptr %s) nounwind willreturn nofree {\nentry:\n"
    )
    out_hg(v, "  %n = call " + u + " @strlen(ptr %s)\n")
    out_hg(v, "  %tot = add " + u + " %n, 1\n")
    out_hg(v, "  %buf = call ptr @malloc(" + u + " %tot)\n")
    out_hg(v, "  br label %loop\n")
    out_hg(v, "loop:\n")
    out_hg(v, "  %i = phi " + u + " [ 0, %entry ], [ %ni, %body ]\n")
    out_hg(v, "  %cont = icmp ult " + u + " %i, %n\n")
    out_hg(v, "  br i1 %cont, label %body, label %done\n")
    out_hg(v, "body:\n")
    out_hg(v, "  %sp = getelementptr i8, ptr %s, " + u + " %i\n")
    out_hg(v, "  %c = load i8, ptr %sp\n")
    out_hg(v, "  %ge = icmp sge i8 %c, " + co.I64Toa(lo as i64) + "\n")
    out_hg(v, "  %le = icmp sle i8 %c, " + co.I64Toa(hi as i64) + "\n")
    out_hg(v, "  %inrange = and i1 %ge, %le\n")
    out_hg(v, "  %c2 = add i8 %c, " + co.I64Toa(delta as i64) + "\n")
    out_hg(v, "  %oc = select i1 %inrange, i8 %c2, i8 %c\n")
    out_hg(v, "  %dp = getelementptr i8, ptr %buf, " + u + " %i\n")
    out_hg(v, "  store i8 %oc, ptr %dp\n")
    out_hg(v, "  %ni = add " + u + " %i, 1\n")
    out_hg(v, "  br label %loop\n")
    out_hg(v, "done:\n")
    out_hg(v, "  %ep = getelementptr i8, ptr %buf, " + u + " %n\n")
    out_hg(v, "  store i8 0, ptr %ep\n  ret ptr %buf\n}\n\n")
end

func emit_upper(v &: Lv):
    emit_case(v, "salam_ll_upper", 97, 122, 0 - 32)
end

func emit_lower(v &: Lv):
    emit_case(v, "salam_ll_lower", 65, 90, 32)
end

func emit_u8step(v &: Lv):
    u := v.usize
    out_hg(
        v, "define internal " + u + " @salam_ll_u8step(ptr %s, " + u + " %i, " + u + " %n) nounwind willreturn memory(argmem: read) {\n" + "entry:\n" + "  %p = getelementptr i8, ptr %s, " + u + " %i\n" + "  %b = load i8, ptr %p\n" + "  %ge192 = icmp uge i8 %b, -64\n" + "  %ge224 = icmp uge i8 %b, -32\n" + "  %ge240 = icmp uge i8 %b, -16\n" + "  %la = select i1 %ge192, " + u + " 2, " + u + " 1\n" + "  %lb = select i1 %ge224, " + u + " 3, " + u + " %la\n" + "  %len = select i1 %ge240, " + u + " 4, " + u + " %lb\n" + "  %e = add " + u + " %i, %len\n" + "  %over = icmp ugt " + u + " %e, %n\n" + "  %r = select i1 %over, " + u + " %n, " + u + " %e\n" + "  ret " + u + " %r\n}\n\n"
    )
end

func emit_u8adv(v &: Lv):
    need(v, LV_H_U8STEP)
    u := v.usize
    out_hg(
        v, "define internal " + u + " @salam_ll_u8adv(ptr %s, " + u + " %n, " + u + " %from, i32 %k) nounwind willreturn memory(argmem: read) {\n" + "entry:\n  br label %loop\n" + "loop:\n" + "  %i = phi " + u + " [ %from, %entry ], [ %ni, %body ]\n" + "  %c = phi i32 [ 0, %entry ], [ %nc, %body ]\n" + "  %more = icmp slt i32 %c, %k\n" + "  %inb = icmp ult " + u + " %i, %n\n" + "  %go = and i1 %more, %inb\n" + "  br i1 %go, label %body, label %done\n" + "body:\n" + "  %ni = call " + u + " @salam_ll_u8step(ptr %s, " + u + " %i, " + u + " %n)\n" + "  %nc = add i32 %c, 1\n" + "  br label %loop\n" + "done:\n  ret " + u + " %i\n}\n\n"
    )
end

func emit_u8cnt(v &: Lv):
    need(v, LV_H_U8STEP)
    u := v.usize
    out_hg(
        v, "define internal i32 @salam_ll_u8cnt(ptr %s, " + u + " %n) nounwind willreturn memory(argmem: read) {\n" + "entry:\n  br label %loop\n" + "loop:\n" + "  %i = phi " + u + " [ 0, %entry ], [ %ni, %body ]\n" + "  %c = phi i32 [ 0, %entry ], [ %nc, %body ]\n" + "  %inb = icmp ult " + u + " %i, %n\n" + "  br i1 %inb, label %body, label %done\n" + "body:\n" + "  %ni = call " + u + " @salam_ll_u8step(ptr %s, " + u + " %i, " + u + " %n)\n" + "  %nc = add i32 %c, 1\n" + "  br label %loop\n" + "done:\n  ret i32 %c\n}\n\n"
    )
end

func emit_asciidig(v &: Lv):
    u := v.usize
    out_hg(
        v, "define internal noalias ptr @salam_ll_asciidig(ptr %s) nounwind {" + "\n" + "entry:" + "\n" + "  %n = call " + u + " @strlen(ptr %s)" + "\n" + "  %tot = add " + u + " %n, 1" + "\n" + "  %b = call ptr @malloc(" + u + " %tot)" + "\n" + "  br label %loop" + "\n" + "loop:" + "\n" + "  %i = phi " + u + " [ 0, %entry ], [ %inext, %put ]" + "\n" + "  %k = phi " + u + " [ 0, %entry ], [ %knext, %put ]" + "\n" + "  %more = icmp ult " + u + " %i, %n" + "\n" + "  br i1 %more, label %body, label %done" + "\n" + "body:" + "\n" + "  %p0 = getelementptr i8, ptr %s, " + u + " %i" + "\n" + "  %b0 = load i8, ptr %p0" + "\n" + "  %ia = add " + u + " %i, 1" + "\n" + "  %has2 = icmp ult " + u + " %ia, %n" + "\n" + "  br i1 %has2, label %two, label %one" + "\n" + "two:" + "\n" + "  %p1 = getelementptr i8, ptr %s, " + u + " %ia" + "\n" + "  %b1 = load i8, ptr %p1" + "\n" + "  %isdb = icmp eq i8 %b0, -37" + "\n" + "  %isd9 = icmp eq i8 %b0, -39" + "\n" + "  %u1 = zext i8 %b1 to i32" + "\n" + "  %fa = sub i32 %u1, 176" + "\n" + "  %ar = sub i32 %u1, 160" + "\n" + "  %fain = icmp ult i32 %fa, 10" + "\n" + "  %arin = icmp ult i32 %ar, 10" + "\n" + "  %isfa = and i1 %isdb, %fain" + "\n" + "  %isar = and i1 %isd9, %arin" + "\n" + "  %sep0 = icmp eq i8 %b1, -85" + "\n" + "  %issep = and i1 %isd9, %sep0" + "\n" + "  %dv = select i1 %isfa, i32 %fa, i32 %ar" + "\n" + "  %dc = add i32 %dv, 48" + "\n" + "  %dc8 = trunc i32 %dc to i8" + "\n" + "  %isdig = or i1 %isfa, %isar" + "\n" + "  %ca = select i1 %issep, i8 46, i8 %b0" + "\n" + "  %c2 = select i1 %isdig, i8 %dc8, i8 %ca" + "\n" + "  %conv = or i1 %isdig, %issep" + "\n" + "  %st2 = select i1 %conv, " + u + " 2, " + u + " 1" + "\n" + "  br label %put" + "\n" + "one:" + "\n" + "  br label %put" + "\n" + "put:" + "\n" + "  %ch = phi i8 [ %c2, %two ], [ %b0, %one ]" + "\n" + "  %st = phi " + u + " [ %st2, %two ], [ 1, %one ]" + "\n" + "  %q = getelementptr i8, ptr %b, " + u + " %k" + "\n" + "  store i8 %ch, ptr %q" + "\n" + "  %knext = add " + u + " %k, 1" + "\n" + "  %inext = add " + u + " %i, %st" + "\n" + "  br label %loop" + "\n" + "done:" + "\n" + "  %e = getelementptr i8, ptr %b, " + u + " %k" + "\n" + "  store i8 0, ptr %e" + "\n" + "  ret ptr %b" + "\n" + "}" + "\n" + "\n"
    )
end

func emit_u8substr(v &: Lv):
    need(v, LV_H_U8ADV)
    u := v.usize
    out_hg(
        v, "define internal noalias ptr @salam_ll_u8substr(ptr %s, i32 %start, i32 %len) nounwind willreturn nofree {\n" + "entry:\n" + "  %n = call " + u + " @strlen(ptr %s)\n" + "  %sneg = icmp slt i32 %start, 0\n" + "  %st = select i1 %sneg, i32 0, i32 %start\n" + "  %lneg = icmp slt i32 %len, 0\n" + "  %ln = select i1 %lneg, i32 0, i32 %len\n" + "  %b0 = call " + u + " @salam_ll_u8adv(ptr %s, " + u + " %n, " + u + " 0, i32 %st)\n" + "  %b1 = call " + u + " @salam_ll_u8adv(ptr %s, " + u + " %n, " + u + " %b0, i32 %ln)\n" + "  %d = sub " + u + " %b1, %b0\n" + "  %t = add " + u + " %d, 1\n" + "  %buf = call ptr @malloc(" + u + " %t)\n" + "  %src = getelementptr i8, ptr %s, " + u + " %b0\n" + "  %c = call ptr @memcpy(ptr %buf, ptr %src, " + u + " %d)\n" + "  %e = getelementptr i8, ptr %buf, " + u + " %d\n" + "  store i8 0, ptr %e\n  ret ptr %buf\n}\n\n"
    )
end

func emit_u8find(v &: Lv):
    need(v, LV_H_U8CNT)
    u := v.usize
    out_hg(
        v, "define internal i32 @salam_ll_u8find(ptr %s, ptr %sub) nounwind willreturn memory(argmem: read) {\n" + "entry:\n" + "  %p = call ptr @strstr(ptr %s, ptr %sub)\n" + "  %nf = icmp eq ptr %p, null\n" + "  br i1 %nf, label %none, label %found\n" + "none:\n  ret i32 -1\n" + "found:\n" + "  %pi = ptrtoint ptr %p to " + u + "\n" + "  %si = ptrtoint ptr %s to " + u + "\n" + "  %off = sub " + u + " %pi, %si\n" + "  %c = call i32 @salam_ll_u8cnt(ptr %s, " + u + " %off)\n" + "  ret i32 %c\n}\n\n"
    )
end

func emit_strhash(v &: Lv):
    out_hg(
        v, "define internal i64 @salam_ll_strhash(ptr %s) nounwind willreturn memory(argmem: read) {\n" + "entry:\n  br label %loop\n" + "loop:\n" + "  %j = phi i64 [ 0, %entry ], [ %jn, %body ]\n" + "  %h = phi i64 [ 14695981039346656037, %entry ], [ %hn, %body ]\n" + "  %p = getelementptr i8, ptr %s, i64 %j\n" + "  %c8 = load i8, ptr %p\n" + "  %z = icmp eq i8 %c8, 0\n" + "  br i1 %z, label %done, label %body\n" + "body:\n" + "  %c = zext i8 %c8 to i64\n" + "  %hm = mul i64 %h, 1099511628211\n" + "  %hn = add i64 %hm, %c\n" + "  %jn = add i64 %j, 1\n" + "  br label %loop\n" + "done:\n  ret i64 %h\n}\n\n"
    )
end

func emit_inthash(v &: Lv):
    out_hg(
        v, "define internal i64 @salam_ll_inthash(i64 %x) nounwind willreturn memory(none) {\n" + "entry:\n" + "  %h0 = add i64 %x, 14695981039346656037\n" + "  %h1 = mul i64 %h0, 1099511628211\n" + "  %h2 = add i64 %h1, 1099511628211\n" + "  %h3 = mul i64 %h2, 1099511628211\n" + "  ret i64 %h3\n}\n\n"
    )
end

func emit_i64str(v &: Lv):
    u := v.usize
    out_hg(v, "@.sfmt.lld = private unnamed_addr constant [5 x i8] c\"%lld\\00\"\n")
    out_hg(
        v, "define internal noalias ptr @salam_ll_i64str(i64 %v) nounwind willreturn nofree {\n" + "entry:\n" + "  %b = call ptr @malloc(" + u + " 32)\n" + "  %r = call i32 (ptr, " + u + ", ptr, ...) @snprintf(ptr %b, " + u + " 32, ptr @.sfmt.lld, i64 %v)\n" + "  ret ptr %b\n}\n\n"
    )
end

func emit_u64str(v &: Lv):
    u := v.usize
    out_hg(v, "@.sfmt.llu = private unnamed_addr constant [5 x i8] c\"%llu\\00\"\n")
    out_hg(
        v, "define internal noalias ptr @salam_ll_u64str(i64 %v) nounwind willreturn nofree {\n" + "entry:\n" + "  %b = call ptr @malloc(" + u + " 32)\n" + "  %r = call i32 (ptr, " + u + ", ptr, ...) @snprintf(ptr %b, " + u + " 32, ptr @.sfmt.llu, i64 %v)\n" + "  ret ptr %b\n}\n\n"
    )
end

func emit_f64str(v &: Lv):
    u := v.usize
    out_hg(v, "@.sfmt.g = private unnamed_addr constant [3 x i8] c\"%g\\00\"\n")
    out_hg(
        v, "define internal noalias ptr @salam_ll_f64str(double %v) nounwind willreturn nofree {\n" + "entry:\n" + "  %b = call ptr @malloc(" + u + " 32)\n" + "  %r = call i32 (ptr, " + u + ", ptr, ...) @snprintf(ptr %b, " + u + " 32, ptr @.sfmt.g, double %v)\n" + "  ret ptr %b\n}\n\n"
    )
end

func emit_charstr(v &: Lv):
    out_hg(
        v, "define internal noalias ptr @salam_ll_charstr(i32 %c) nounwind willreturn nofree {\n" + "entry:\n" + "  %b = call ptr @malloc(" + v.usize + " 2)\n" + "  %t = trunc i32 %c to i8\n" + "  store i8 %t, ptr %b\n" + "  %p1 = getelementptr i8, ptr %b, i64 1\n" + "  store i8 0, ptr %p1\n" + "  ret ptr %b\n}\n\n"
    )
end

func onsig_helper(v &: Lv): str:
    if v.jit:
        ret ""
    end
    ret "define internal void @salam_out_onsig(i32 %s) nounwind {\n" + "entry:\n" + "  call void @salam_out_flush()\n" + "  %code = add i32 %s, 128\n" + "  call void @exit(i32 %code)\n" + "  ret void\n" + "}\n"
end

func wpre(v &: Lv, src2: str, dst: str): str:
    if str.Equals(v.usize, "i64"):
        ret ""
    end
    ret "  " + dst + " = trunc i64 " + src2 + " to " + v.usize + "\n"
end

func wref(v &: Lv, src2: str, dst: str): str:
    if str.Equals(v.usize, "i64"):
        ret src2
    end
    ret dst
end

func ltype(v &: Lv): str:
    if target_is_windows_of(v.triple):
        ret "i32"
    end
    ret v.usize
end

func isatty_name(v &: Lv): str:
    ret target_is_windows_of(v.triple) ? "_isatty" : "isatty"
end

func outbuf_extra(v &: Lv): str:
    u := v.usize
    mut slen := "  %n64 = zext " + u + " %n to i64\n"
    if str.Equals(u, "i64"):
        slen = "  %n64 = add i64 %n, 0\n"
    end
    ret "@salam_ob_tty = internal global i32 -1\n" + "@salam_ob_null = private unnamed_addr constant [7 x i8] c\"(null)\\00\"\n" + "define internal void @salam_out_flush_fd(i32 %fd) nounwind {\n" + "entry:\n" + "  %n = atomicrmw xchg ptr @salam_obn, i64 0 seq_cst\n" + "  %z = icmp eq i64 %n, 0\n" + "  br i1 %z, label %done, label %do\n" + "do:\n" + wpre(v, "%n", "%nw") + "  %r = call " + u + " @write(i32 %fd, ptr @salam_ob, " + u + " " + wref(v, "%n", "%nw") + ")\n" + "  br label %done\n" + "done:\n" + "  ret void\n" + "}\n" + "define internal void @salam_out_end1() nounwind {\n" + "entry:\n" + "  %t = load i32, ptr @salam_ob_tty\n" + "  %z = icmp eq i32 %t, 0\n" + "  br i1 %z, label %done, label %chk\n" + "chk:\n" + "  %neg = icmp slt i32 %t, 0\n" + "  br i1 %neg, label %init, label %fl\n" + "init:\n" + "  %a = call i32 @" + isatty_name(v) + "(i32 1)\n" + "  %nz = icmp ne i32 %a, 0\n" + "  %tv = zext i1 %nz to i32\n" + "  store i32 %tv, ptr @salam_ob_tty\n" + "  br i1 %nz, label %fl, label %done\n" + "fl:\n" + "  call void @salam_out_flush()\n" + "  br label %done\n" + "done:\n" + "  ret void\n" + "}\n" + "define internal void @salam_out_str(ptr %s0) nounwind {\n" + "entry:\n" + "  %isnull = icmp eq ptr %s0, null\n" + "  %s = select i1 %isnull, ptr @salam_ob_null, ptr %s0\n" + "  %n = call " + u + " @strlen(ptr %s)\n" + slen + "  call void @salam_out_write(ptr %s, i64 %n64)\n" + "  ret void\n" + "}\n" + "define internal void @salam_out_u64x(i64 %u0, i1 %neg) nounwind {\n" + "entry:\n" + "  %buf = alloca [24 x i8], align 1\n" + "  br label %loop\n" + "loop:\n" + "  %u = phi i64 [ %u0, %entry ], [ %q, %loop ]\n" + "  %pos = phi i64 [ 24, %entry ], [ %pos1, %loop ]\n" + "  %q = udiv i64 %u, 10\n" + "  %m = mul i64 %q, 10\n" + "  %d = sub i64 %u, %m\n" + "  %d8 = trunc i64 %d to i8\n" + "  %c = add i8 %d8, 48\n" + "  %pos1 = sub i64 %pos, 1\n" + "  %pp = getelementptr inbounds [24 x i8], ptr %buf, i64 0, i64 %pos1\n" + "  store i8 %c, ptr %pp\n" + "  %more = icmp ne i64 %q, 0\n" + "  br i1 %more, label %loop, label %sign\n" + "sign:\n" + "  br i1 %neg, label %minus, label %out\n" + "minus:\n" + "  %pos2 = sub i64 %pos1, 1\n" + "  %mp = getelementptr inbounds [24 x i8], ptr %buf, i64 0, i64 %pos2\n" + "  store i8 45, ptr %mp\n" + "  br label %out\n" + "out:\n" + "  %st = phi i64 [ %pos1, %sign ], [ %pos2, %minus ]\n" + "  %sp = getelementptr inbounds [24 x i8], ptr %buf, i64 0, i64 %st\n" + "  %len = sub i64 24, %st\n" + "  call void @salam_out_write(ptr %sp, i64 %len)\n" + "  ret void\n" + "}\n" + "define internal void @salam_out_i64(i64 %v) nounwind {\n" + "entry:\n" + "  %neg = icmp slt i64 %v, 0\n" + "  %nv = sub i64 0, %v\n" + "  %u = select i1 %neg, i64 %nv, i64 %v\n" + "  call void @salam_out_u64x(i64 %u, i1 %neg)\n" + "  ret void\n" + "}\n" + "define internal void @salam_out_u64(i64 %v) nounwind {\n" + "entry:\n" + "  call void @salam_out_u64x(i64 %v, i1 false)\n" + "  ret void\n" + "}\n" + "define internal void @salam_out_byte(i32 %c) nounwind {\n" + "entry:\n" + "  %b = alloca i8, align 1\n" + "  %t = trunc i32 %c to i8\n" + "  store i8 %t, ptr %b\n" + "  call void @salam_out_write(ptr %b, i64 1)\n" + "  ret void\n" + "}\n"
end

func emit_outbuf(v &: Lv):
    out_hg(
        v, "@salam_ob = internal global [65536 x i8] zeroinitializer\n" + "@salam_obn = internal global i64 0\n" + "declare void @llvm.memcpy.p0.p0.i64(ptr, ptr, i64, i1) nounwind\n" + "define internal void @salam_out_flush() nounwind {\n" + "entry:\n" + "  %n = atomicrmw xchg ptr @salam_obn, i64 0 seq_cst\n" + "  %z = icmp eq i64 %n, 0\n" + "  br i1 %z, label %done, label %do\n" + "do:\n" + wpre(v, "%n", "%nw") + "  %r = call " + v.usize + " @write(i32 1, ptr @salam_ob, " + v.usize + " " + wref(v, "%n", "%nw") + ")\n" + "  br label %done\n" + "done:\n" + "  ret void\n" + "}\n" + onsig_helper(v) + "define internal void @salam_out_write(ptr %s, i64 %n) nounwind {\n" + "entry:\n" + "  %obn = load i64, ptr @salam_obn\n" + "  %sum = add i64 %obn, %n\n" + "  %over = icmp ugt i64 %sum, 65536\n" + "  br i1 %over, label %flush, label %chk\n" + "flush:\n" + "  call void @salam_out_flush()\n" + "  br label %chk\n" + "chk:\n" + "  %big = icmp uge i64 %n, 65536\n" + "  br i1 %big, label %direct, label %copy\n" + "direct:\n" + wpre(v, "%n", "%ndw") + "  %rd = call " + v.usize + " @write(i32 1, ptr %s, " + v.usize + " " + wref(v, "%n", "%ndw") + ")\n" + "  ret void\n" + "copy:\n" + "  %obn2 = load i64, ptr @salam_obn\n" + "  %dst = getelementptr inbounds [65536 x i8], ptr @salam_ob, i64 0, i64 %obn2\n" + "  call void @llvm.memcpy.p0.p0.i64(ptr %dst, ptr %s, i64 %n, i1 false)\n" + "  %newn = add i64 %obn2, %n\n" + "  store i64 %newn, ptr @salam_obn\n" + "  ret void\n" + "}\n" + "@llvm.global_dtors = appending global [1 x { i32, ptr, ptr }] " + "[{ i32, ptr, ptr } { i32 65535, ptr @salam_out_flush, ptr null }]\n" + outbuf_extra(v) + "\n"
    )
end

func need(v &: Lv, which: int):
    if v.hneed.get(which):
        ret
    end
    v.hneed.set(which, true)
    if which == LV_H_SUBSTR:
        emit_substr(v)
    else which == LV_H_STRCAT:
        emit_strcat(v)
    else which == LV_H_ISWS:
        emit_isws(v)
    else which == LV_H_TRIM:
        emit_trim(v)
    else which == LV_H_STRHASH:
        emit_strhash(v)
    else which == LV_H_INTHASH:
        emit_inthash(v)
    else which == LV_H_I64STR:
        emit_i64str(v)
    else which == LV_H_U64STR:
        emit_u64str(v)
    else which == LV_H_F64STR:
        emit_f64str(v)
    else which == LV_H_CHARSTR:
        emit_charstr(v)
    else which == LV_H_OUTBUF:
        emit_outbuf(v)
    else which == LV_H_REPEAT:
        emit_repeat(v)
    else which == LV_H_UPPER:
        emit_upper(v)
    else which == LV_H_LOWER:
        emit_lower(v)
    else which == LV_H_U8STEP:
        emit_u8step(v)
    else which == LV_H_U8ADV:
        emit_u8adv(v)
    else which == LV_H_U8CNT:
        emit_u8cnt(v)
    else which == LV_H_U8SUBSTR:
        emit_u8substr(v)
    else which == LV_H_U8FIND:
        emit_u8find(v)
    else which == LV_H_ASCIIDIG:
        emit_asciidig(v)
    end
end

func toplevel(v &: Lv, s &: sm.Sema, a &: at.Ast, d: int):
    dn := at.Get(a, d)
    k := dn.kind
    if k == at.AST_FUNC_DEF:
        if dn.is_extern and dn.a == 0:
            ret
        end
        if dn.typarams.len() > 0:
            ret
        end
        emit_function(v, s, a, d, 0)
    else k == at.AST_STRUCT_DEF:
        if dn.typarams.len() > 0:
            ret
        end
        ssym := struct_sym(v, s, a, dn.name)
        repeat at.ChildCount(a, d) in i:
            m := at.Child(a, d, i)
            if at.KindOf(a, m) == at.AST_FUNC_DEF:
                emit_function(v, s, a, m, ssym)
            end
        end
    else k == at.AST_ENUM_DEF or k == at.AST_CONST_DECL or k == at.AST_VAR_DECL or k == at.AST_INTERFACE_DEF or k == at.AST_IMPL_DEF or k == at.AST_IMPORT or k == at.AST_LINK or k == at.AST_TYPE_ALIAS or k == at.AST_LAYOUT_BLOCK or k == at.AST_LAYOUT_COMPONENT:
        _k := k
    else:
        lv_error(
            v, a, d, "top-level " + at.KindName(k) + " (layout/unsupported)"
        )
    end
end
