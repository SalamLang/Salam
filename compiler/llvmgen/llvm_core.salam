package llvmgen

import str
import llvm.triple

include co "../sal_core.salam"
include at "../ast.salam"
include sm "../semantic/semantic.salam"

func dl_host(): str:
    ret triple.HostDatalayout()
end

func datalayout(t: str): str:
    ret triple.Datalayout(t)
end

func target_is_glibc_of(t: str): bool:
    ret triple.IsGlibc(t)
end

func resolve_glibc(triple: str): bool:
    if str.Len(triple) > 0: ret target_is_glibc_of(triple) end
    ret nt_host_is_glibc()
end

func target_is_windows_of(t: str): bool:
    ret triple.IsWindows(t)
end

func pl_widen(v &: Lv, src: str, dst: str): str:
    if v.ptr_bits <= 32:
        ret src
    end
    out_hg(v, "  " + dst + " = sext i32 " + src + " to " + v.usize + "\n")
    ret dst
end

func program_defines(a &: at.Ast, name: str): bool:
    total := at.Count(a)
    mut i := 1
    until i < total:
        n := at.Get(a, i)
        if n.kind == at.AST_FUNC_DEF and n.is_extern and n.a != 0 and str.Equals(n.name, name):
            ret true
        end
        i += 1
    end
    ret false
end

func declare_libc(v &: Lv, a &: at.Ast, name: str, proto: str):
    if program_defines(a, name):
        ret
    end
    out_g(v, proto)
end

func emit_prologue(v &: Lv, a &: at.Ast):
    u := v.usize
    out_g(
        v, "; Salam -> LLVM IR (textual). usize = " + u + " (" + (v.ptr_bits == 32 ? "32" : "64") + "-bit target).\n"
    )
    declare_libc(v, a, "printf", "declare i32 @printf(ptr, ...) nounwind\n")
    declare_libc(v, a, "dprintf", "declare i32 @dprintf(i32, ptr, ...) nounwind\n")
    declare_libc(v, a, "write", "declare " + u + " @write(i32, ptr, " + u + ") nounwind\n")
    declare_libc(
        v, a, "strlen", "declare " + u + " @strlen(ptr) nounwind willreturn memory(argmem: read)\n"
    )
    declare_libc(v, a, "strcmp", "declare i32 @strcmp(ptr, ptr) nounwind willreturn memory(argmem: read)\n")
    declare_libc(v, a, "malloc", "declare noalias ptr @malloc(" + u + ") nounwind allocsize(0)\n")
    if v.libc_glibc:
        out_g(v, "declare i32 @mallopt(i32, i32) nounwind\n")
    end
    declare_libc(
        v, a, "realloc", "declare noalias ptr @realloc(ptr, " + u + ") nounwind allocsize(1)\n"
    )
    declare_libc(
        v, a, "calloc", "declare noalias ptr @calloc(" + u + ", " + u + ") nounwind allocsize(0, 1)\n"
    )
    declare_libc(v, a, "free", "declare void @free(ptr) nounwind\n")
    declare_libc(v, a, "memset", "declare ptr @memset(ptr, i32, " + u + ") nounwind\n")
    declare_libc(v, a, "memcpy", "declare ptr @memcpy(ptr, ptr, " + u + ") nounwind\n")
    declare_libc(v, a, "memmove", "declare ptr @memmove(ptr, ptr, " + u + ") nounwind\n")
    out_g(v, "declare void @llvm.memset.p0." + u + "(ptr, i8, " + u + ", i1) nounwind\n")
    declare_libc(v, a, "abort", "declare void @abort() noreturn nounwind cold\n")
    declare_libc(v, a, "exit", "declare void @exit(i32) noreturn nounwind\n")
    declare_libc(v, a, "atexit", "declare i32 @atexit(ptr) nounwind\n")
    declare_libc(v, a, "fflush", "declare i32 @fflush(ptr) nounwind\n")
    declare_libc(v, a, "signal", "declare ptr @signal(i32, ptr) nounwind\n")
    declare_libc(v, a, "raise", "declare i32 @raise(i32) nounwind\n")
    declare_libc(v, a, isatty_name(v), "declare i32 @" + isatty_name(v) + "(i32) nounwind\n")
    if outbuf_yield(v):
        declare_libc(v, a, "sched_yield", "declare i32 @sched_yield() nounwind\n")
    end
    declare_libc(v, a, "snprintf", "declare i32 @snprintf(ptr, " + u + ", ptr, ...) nounwind\n")
    declare_libc(v, a, "strtol", "declare " + ltype(v) + " @strtol(ptr, ptr, i32) nounwind\n")
    declare_libc(v, a, "strtod", "declare double @strtod(ptr, ptr) nounwind\n")
    declare_libc(v, a, "strstr", "declare ptr @strstr(ptr, ptr) nounwind willreturn memory(argmem: read)\n")
    out_g(v, "declare double @llvm.pow.f64(double, double)\n")
    out_g(v, "%dyn = type { ptr, ptr }\n")
end

func emit_substr(v &: Lv):
    u := v.usize
    out_hg(v, "define internal noalias ptr @salam_ll_substr(ptr %s, i32 %start, i32 %len) nounwind willreturn nofree {\nentry:\n")
    out_hg(v, "  %n = call " + u + " @strlen(ptr %s)\n")
    out_hg(v, "  %sneg = icmp slt i32 %start, 0\n")
    out_hg(v, "  %s0 = select i1 %sneg, i32 0, i32 %start\n")
    out_hg(v, "  %lneg = icmp slt i32 %len, 0\n")
    out_hg(v, "  %l0 = select i1 %lneg, i32 0, i32 %len\n")
    sw := pl_widen(v, "%s0", "%sw")
    lw := pl_widen(v, "%l0", "%lw")
    out_hg(v, "  %sbig = icmp ugt " + u + " " + sw + ", %n\n")
    out_hg(v, "  %so = select i1 %sbig, " + u + " %n, " + u + " " + sw + "\n")
    out_hg(v, "  %rem = sub " + u + " %n, %so\n")
    out_hg(v, "  %lbig = icmp ugt " + u + " " + lw + ", %rem\n")
    out_hg(v, "  %l = select i1 %lbig, " + u + " %rem, " + u + " " + lw + "\n")
    out_hg(v, "  %t = add " + u + " %l, 1\n")
    out_hg(v, "  %buf = call ptr @malloc(" + u + " %t)\n")
    out_hg(v, "  %src = getelementptr i8, ptr %s, " + u + " %so\n")
    out_hg(v, "  %c = call ptr @memcpy(ptr %buf, ptr %src, " + u + " %l)\n")
    out_hg(v, "  %e = getelementptr i8, ptr %buf, " + u + " %l\n")
    out_hg(v, "  store i8 0, ptr %e\n  ret ptr %buf\n}\n\n")
end

func emit_strcat(v &: Lv):
    u := v.usize
    out_hg(
        v, ```
            define internal noalias ptr @salam_ll_strcat(ptr %a, ptr %b) nounwind willreturn nofree {
            entry:
              %la = call ${{ u }} @strlen(ptr %a)
              %lb = call ${{ u }} @strlen(ptr %b)
              %sum = add ${{ u }} %la, %lb
              %tot = add ${{ u }} %sum, 1
              %buf = call ptr @malloc(${{ u }} %tot)
              %c1 = call ptr @memcpy(ptr %buf, ptr %a, ${{ u }} %la)
              %end = getelementptr i8, ptr %buf, ${{ u }} %la
              %lb1 = add ${{ u }} %lb, 1
              %c2 = call ptr @memcpy(ptr %end, ptr %b, ${{ u }} %lb1)
              ret ptr %buf
            }


            ```
    )
end

func emit_isws(v &: Lv):
    out_hg(
        v, ```
            define internal i1 @salam_ll_isws(i8 %c) nounwind willreturn memory(none) {
            entry:
              %s32 = icmp eq i8 %c, 32
              %s9 = icmp eq i8 %c, 9
              %s10 = icmp eq i8 %c, 10
              %s13 = icmp eq i8 %c, 13
              %o1 = or i1 %s32, %s9
              %o2 = or i1 %o1, %s10
              %o3 = or i1 %o2, %s13
              ret i1 %o3
            }


            ```
    )
end

func emit_trim(v &: Lv):
    need(v, LV_H_ISWS)
    u := v.usize
    out_hg(
        v, ```
            define internal noalias ptr @salam_ll_trim(ptr %s) nounwind willreturn nofree {
            entry:
              %n = call ${{ u }} @strlen(ptr %s)
              br label %f
            f:
              %a = phi ${{ u }} [ 0, %entry ], [ %an, %fbody ]
              %c1 = icmp ult ${{ u }} %a, %n
              br i1 %c1, label %fchk, label %b
            fchk:
              %p1 = getelementptr i8, ptr %s, ${{ u }} %a
              %ch1 = load i8, ptr %p1
              %w1 = call i1 @salam_ll_isws(i8 %ch1)
              br i1 %w1, label %fbody, label %b
            fbody:
              %an = add ${{ u }} %a, 1
              br label %f
            b:
              br label %r
            r:
              %e = phi ${{ u }} [ %n, %b ], [ %en, %rbody ]
              %c2 = icmp ugt ${{ u }} %e, %a
              br i1 %c2, label %rchk, label %done
            rchk:
              %em1 = sub ${{ u }} %e, 1
              %p2 = getelementptr i8, ptr %s, ${{ u }} %em1
              %ch2 = load i8, ptr %p2
              %w2 = call i1 @salam_ll_isws(i8 %ch2)
              br i1 %w2, label %rbody, label %done
            rbody:
              %en = sub ${{ u }} %e, 1
              br label %r
            done:
              %len = sub ${{ u }} %e, %a
              %tot = add ${{ u }} %len, 1
              %buf = call ptr @malloc(${{ u }} %tot)
              %src = getelementptr i8, ptr %s, ${{ u }} %a
              %cp = call ptr @memcpy(ptr %buf, ptr %src, ${{ u }} %len)
              %endp = getelementptr i8, ptr %buf, ${{ u }} %len
              store i8 0, ptr %endp
              ret ptr %buf
            }


            ```
    )
end

func emit_repeat(v &: Lv):
    u := v.usize
    out_hg(v, "define internal noalias ptr @salam_ll_repeat(ptr %s, i32 %n) nounwind willreturn nofree {\nentry:\n")
    out_hg(v, "  %slen = call " + u + " @strlen(ptr %s)\n")
    nw := pl_widen(v, "%n", "%nw")
    out_hg(v, "  %nle0 = icmp sle i32 %n, 0\n")
    out_hg(v, "  %slen0 = icmp eq " + u + " %slen, 0\n")
    out_hg(v, "  %skip = or i1 %nle0, %slen0\n")
    out_hg(v, "  br i1 %skip, label %empty, label %compute\n")
    out_hg(v, "empty:\n")
    out_hg(v, "  %eb = call ptr @malloc(" + u + " 1)\n")
    out_hg(v, "  store i8 0, ptr %eb\n  ret ptr %eb\n")
    out_hg(v, "compute:\n")
    out_hg(v, "  %total = mul " + u + " %slen, " + nw + "\n")
    out_hg(v, "  %tot1 = add " + u + " %total, 1\n")
    out_hg(v, "  %buf = call ptr @malloc(" + u + " %tot1)\n")
    out_hg(v, "  %c0 = call ptr @memcpy(ptr %buf, ptr %s, " + u + " %slen)\n")
    out_hg(v, "  br label %loop\n")
    out_hg(v, "loop:\n")
    out_hg(
        v, "  %filled = phi " + u + " [ %slen, %compute ], [ %newfilled, %body ]\n"
    )
    out_hg(v, "  %done = icmp uge " + u + " %filled, %total\n")
    out_hg(v, "  br i1 %done, label %finish, label %body\n")
    out_hg(v, "body:\n")
    out_hg(v, "  %remain = sub " + u + " %total, %filled\n")
    out_hg(v, "  %lt = icmp ult " + u + " %filled, %remain\n")
    out_hg(
        v, "  %chunk = select i1 %lt, " + u + " %filled, " + u + " %remain\n"
    )
    out_hg(v, "  %dst = getelementptr i8, ptr %buf, " + u + " %filled\n")
    out_hg(
        v, "  %cc = call ptr @memcpy(ptr %dst, ptr %buf, " + u + " %chunk)\n"
    )
    out_hg(v, "  %newfilled = add " + u + " %filled, %chunk\n")
    out_hg(v, "  br label %loop\n")
    out_hg(v, "finish:\n")
    out_hg(v, "  %endp = getelementptr i8, ptr %buf, " + u + " %total\n")
    out_hg(v, "  store i8 0, ptr %endp\n  ret ptr %buf\n}\n\n")
end

func emit_case(v &: Lv, fname: str, lo: int, hi: int, delta: int):
    u := v.usize
    out_hg(
        v, ```
            define internal noalias ptr @${{ fname }}(ptr %s) nounwind willreturn nofree {
            entry:

            ```
    )
    out_hg(v, "  %n = call " + u + " @strlen(ptr %s)\n")
    out_hg(v, "  %tot = add " + u + " %n, 1\n")
    out_hg(v, "  %buf = call ptr @malloc(" + u + " %tot)\n")
    out_hg(v, "  br label %loop\n")
    out_hg(v, "loop:\n")
    out_hg(v, "  %i = phi " + u + " [ 0, %entry ], [ %ni, %body ]\n")
    out_hg(v, "  %cont = icmp ult " + u + " %i, %n\n")
    out_hg(v, "  br i1 %cont, label %body, label %done\n")
    out_hg(v, "body:\n")
    out_hg(v, "  %sp = getelementptr i8, ptr %s, " + u + " %i\n")
    out_hg(v, "  %c = load i8, ptr %sp\n")
    out_hg(v, "  %ge = icmp sge i8 %c, " + co.I64Toa(lo as i64) + "\n")
    out_hg(v, "  %le = icmp sle i8 %c, " + co.I64Toa(hi as i64) + "\n")
    out_hg(v, "  %inrange = and i1 %ge, %le\n")
    out_hg(v, "  %c2 = add i8 %c, " + co.I64Toa(delta as i64) + "\n")
    out_hg(v, "  %oc = select i1 %inrange, i8 %c2, i8 %c\n")
    out_hg(v, "  %dp = getelementptr i8, ptr %buf, " + u + " %i\n")
    out_hg(v, "  store i8 %oc, ptr %dp\n")
    out_hg(v, "  %ni = add " + u + " %i, 1\n")
    out_hg(v, "  br label %loop\n")
    out_hg(v, "done:\n")
    out_hg(v, "  %ep = getelementptr i8, ptr %buf, " + u + " %n\n")
    out_hg(v, "  store i8 0, ptr %ep\n  ret ptr %buf\n}\n\n")
end

func emit_upper(v &: Lv):
    emit_case(v, "salam_ll_upper", 97, 122, 0 - 32)
end

func emit_lower(v &: Lv):
    emit_case(v, "salam_ll_lower", 65, 90, 32)
end

func emit_u8step(v &: Lv):
    u := v.usize
    out_hg(
        v, ```
            define internal ${{ u }} @salam_ll_u8step(ptr %s, ${{ u }} %i, ${{ u }} %n) nounwind willreturn memory(argmem: read) {
            entry:
              %p = getelementptr i8, ptr %s, ${{ u }} %i
              %b = load i8, ptr %p
              %ge192 = icmp uge i8 %b, -64
              %ge224 = icmp uge i8 %b, -32
              %ge240 = icmp uge i8 %b, -16
              %la = select i1 %ge192, ${{ u }} 2, ${{ u }} 1
              %lb = select i1 %ge224, ${{ u }} 3, ${{ u }} %la
              %len = select i1 %ge240, ${{ u }} 4, ${{ u }} %lb
              %e = add ${{ u }} %i, %len
              %over = icmp ugt ${{ u }} %e, %n
              %r = select i1 %over, ${{ u }} %n, ${{ u }} %e
              ret ${{ u }} %r
            }


            ```
    )
end

func emit_u8adv(v &: Lv):
    need(v, LV_H_U8STEP)
    u := v.usize
    out_hg(
        v, ```
            define internal ${{ u }} @salam_ll_u8adv(ptr %s, ${{ u }} %n, ${{ u }} %from, i32 %k) nounwind willreturn memory(argmem: read) {
            entry:
              br label %loop
            loop:
              %i = phi ${{ u }} [ %from, %entry ], [ %ni, %body ]
              %c = phi i32 [ 0, %entry ], [ %nc, %body ]
              %more = icmp slt i32 %c, %k
              %inb = icmp ult ${{ u }} %i, %n
              %go = and i1 %more, %inb
              br i1 %go, label %body, label %done
            body:
              %ni = call ${{ u }} @salam_ll_u8step(ptr %s, ${{ u }} %i, ${{ u }} %n)
              %nc = add i32 %c, 1
              br label %loop
            done:
              ret ${{ u }} %i
            }


            ```
    )
end

func emit_u8cnt(v &: Lv):
    need(v, LV_H_U8STEP)
    u := v.usize
    out_hg(
        v, ```
            define internal i32 @salam_ll_u8cnt(ptr %s, ${{ u }} %n) nounwind willreturn memory(argmem: read) {
            entry:
              br label %loop
            loop:
              %i = phi ${{ u }} [ 0, %entry ], [ %ni, %body ]
              %c = phi i32 [ 0, %entry ], [ %nc, %body ]
              %inb = icmp ult ${{ u }} %i, %n
              br i1 %inb, label %body, label %done
            body:
              %ni = call ${{ u }} @salam_ll_u8step(ptr %s, ${{ u }} %i, ${{ u }} %n)
              %nc = add i32 %c, 1
              br label %loop
            done:
              ret i32 %c
            }


            ```
    )
end

func emit_asciidig(v &: Lv):
    u := v.usize
    out_hg(
        v, ```
            define internal noalias ptr @salam_ll_asciidig(ptr %s) nounwind {
            entry:
              %n = call ${{ u }} @strlen(ptr %s)
              %tot = add ${{ u }} %n, 1
              %b = call ptr @malloc(${{ u }} %tot)
              br label %loop
            loop:
              %i = phi ${{ u }} [ 0, %entry ], [ %inext, %put ]
              %k = phi ${{ u }} [ 0, %entry ], [ %knext, %put ]
              %more = icmp ult ${{ u }} %i, %n
              br i1 %more, label %body, label %done
            body:
              %p0 = getelementptr i8, ptr %s, ${{ u }} %i
              %b0 = load i8, ptr %p0
              %ia = add ${{ u }} %i, 1
              %has2 = icmp ult ${{ u }} %ia, %n
              br i1 %has2, label %two, label %one
            two:
              %p1 = getelementptr i8, ptr %s, ${{ u }} %ia
              %b1 = load i8, ptr %p1
              %isdb = icmp eq i8 %b0, -37
              %isd9 = icmp eq i8 %b0, -39
              %u1 = zext i8 %b1 to i32
              %fa = sub i32 %u1, 176
              %ar = sub i32 %u1, 160
              %fain = icmp ult i32 %fa, 10
              %arin = icmp ult i32 %ar, 10
              %isfa = and i1 %isdb, %fain
              %isar = and i1 %isd9, %arin
              %sep0 = icmp eq i8 %b1, -85
              %issep = and i1 %isd9, %sep0
              %dv = select i1 %isfa, i32 %fa, i32 %ar
              %dc = add i32 %dv, 48
              %dc8 = trunc i32 %dc to i8
              %isdig = or i1 %isfa, %isar
              %ca = select i1 %issep, i8 46, i8 %b0
              %c2 = select i1 %isdig, i8 %dc8, i8 %ca
              %conv = or i1 %isdig, %issep
              %st2 = select i1 %conv, ${{ u }} 2, ${{ u }} 1
              br label %put
            one:
              br label %put
            put:
              %ch = phi i8 [ %c2, %two ], [ %b0, %one ]
              %st = phi ${{ u }} [ %st2, %two ], [ 1, %one ]
              %q = getelementptr i8, ptr %b, ${{ u }} %k
              store i8 %ch, ptr %q
              %knext = add ${{ u }} %k, 1
              %inext = add ${{ u }} %i, %st
              br label %loop
            done:
              %e = getelementptr i8, ptr %b, ${{ u }} %k
              store i8 0, ptr %e
              ret ptr %b
            }


            ```
    )
end

func emit_u8substr(v &: Lv):
    need(v, LV_H_U8ADV)
    u := v.usize
    out_hg(
        v, ```
            define internal noalias ptr @salam_ll_u8substr(ptr %s, i32 %start, i32 %len) nounwind willreturn nofree {
            entry:
              %n = call ${{ u }} @strlen(ptr %s)
              %sneg = icmp slt i32 %start, 0
              %st = select i1 %sneg, i32 0, i32 %start
              %lneg = icmp slt i32 %len, 0
              %ln = select i1 %lneg, i32 0, i32 %len
              %b0 = call ${{ u }} @salam_ll_u8adv(ptr %s, ${{ u }} %n, ${{ u }} 0, i32 %st)
              %b1 = call ${{ u }} @salam_ll_u8adv(ptr %s, ${{ u }} %n, ${{ u }} %b0, i32 %ln)
              %d = sub ${{ u }} %b1, %b0
              %t = add ${{ u }} %d, 1
              %buf = call ptr @malloc(${{ u }} %t)
              %src = getelementptr i8, ptr %s, ${{ u }} %b0
              %c = call ptr @memcpy(ptr %buf, ptr %src, ${{ u }} %d)
              %e = getelementptr i8, ptr %buf, ${{ u }} %d
              store i8 0, ptr %e
              ret ptr %buf
            }


            ```
    )
end

func emit_u8find(v &: Lv):
    need(v, LV_H_U8CNT)
    u := v.usize
    out_hg(
        v, ```
            define internal i32 @salam_ll_u8find(ptr %s, ptr %sub) nounwind willreturn memory(argmem: read) {
            entry:
              %p = call ptr @strstr(ptr %s, ptr %sub)
              %nf = icmp eq ptr %p, null
              br i1 %nf, label %none, label %found
            none:
              ret i32 -1
            found:
              %pi = ptrtoint ptr %p to ${{ u }}
              %si = ptrtoint ptr %s to ${{ u }}
              %off = sub ${{ u }} %pi, %si
              %c = call i32 @salam_ll_u8cnt(ptr %s, ${{ u }} %off)
              ret i32 %c
            }


            ```
    )
end

func emit_strhash(v &: Lv):
    out_hg(
        v, ```
            define internal i64 @salam_ll_strhash(ptr %s) nounwind willreturn memory(argmem: read) {
            entry:
              br label %loop
            loop:
              %j = phi i64 [ 0, %entry ], [ %jn, %body ]
              %h = phi i64 [ 14695981039346656037, %entry ], [ %hn, %body ]
              %p = getelementptr i8, ptr %s, i64 %j
              %c8 = load i8, ptr %p
              %z = icmp eq i8 %c8, 0
              br i1 %z, label %done, label %body
            body:
              %c = zext i8 %c8 to i64
              %hm = mul i64 %h, 1099511628211
              %hn = add i64 %hm, %c
              %jn = add i64 %j, 1
              br label %loop
            done:
              ret i64 %h
            }


            ```
    )
end

func emit_inthash(v &: Lv):
    out_hg(
        v, ```
            define internal i64 @salam_ll_inthash(i64 %x) nounwind willreturn memory(none) {
            entry:
              %h0 = add i64 %x, 14695981039346656037
              %h1 = mul i64 %h0, 1099511628211
              %h2 = add i64 %h1, 1099511628211
              %h3 = mul i64 %h2, 1099511628211
              ret i64 %h3
            }


            ```
    )
end

func emit_i64str(v &: Lv):
    u := v.usize
    out_hg(v, "@.sfmt.lld = private unnamed_addr constant [5 x i8] c\"%lld\\00\"\n")
    out_hg(
        v, ```
            define internal noalias ptr @salam_ll_i64str(i64 %v) nounwind willreturn nofree {
            entry:
              %b = call ptr @malloc(${{ u }} 32)
              %r = call i32 (ptr, ${{ u }}, ptr, ...) @snprintf(ptr %b, ${{ u }} 32, ptr @.sfmt.lld, i64 %v)
              ret ptr %b
            }


            ```
    )
end

func emit_u64str(v &: Lv):
    u := v.usize
    out_hg(v, "@.sfmt.llu = private unnamed_addr constant [5 x i8] c\"%llu\\00\"\n")
    out_hg(
        v, ```
            define internal noalias ptr @salam_ll_u64str(i64 %v) nounwind willreturn nofree {
            entry:
              %b = call ptr @malloc(${{ u }} 32)
              %r = call i32 (ptr, ${{ u }}, ptr, ...) @snprintf(ptr %b, ${{ u }} 32, ptr @.sfmt.llu, i64 %v)
              ret ptr %b
            }


            ```
    )
end

func emit_f64str(v &: Lv):
    u := v.usize
    out_hg(v, "@.sfmt.g = private unnamed_addr constant [3 x i8] c\"%g\\00\"\n")
    out_hg(
        v, ```
            define internal noalias ptr @salam_ll_f64str(double %v) nounwind willreturn nofree {
            entry:
              %b = call ptr @malloc(${{ u }} 32)
              %r = call i32 (ptr, ${{ u }}, ptr, ...) @snprintf(ptr %b, ${{ u }} 32, ptr @.sfmt.g, double %v)
              ret ptr %b
            }


            ```
    )
end

func emit_charstr(v &: Lv):
    out_hg(
        v, ```
            define internal noalias ptr @salam_ll_charstr(i32 %c) nounwind willreturn nofree {
            entry:
              %b = call ptr @malloc(${{ v.usize }} 2)
              %t = trunc i32 %c to i8
              store i8 %t, ptr %b
              %p1 = getelementptr i8, ptr %b, i64 1
              store i8 0, ptr %p1
              ret ptr %b
            }


            ```
    )
end

func onsig_helper(v &: Lv): str:
    if v.jit:
        ret ""
    end
    ret ```
        define internal void @salam_out_onsig(i32 %s) nounwind {
        entry:
          call void @salam_out_flush_l()
          %code = add i32 %s, 128
          call void @exit(i32 %code)
          ret void
        }

        ```
end

func wpre(v &: Lv, src2: str, dst: str): str:
    if str.Equals(v.usize, "i64"):
        ret ""
    end
    ret "  " + dst + " = trunc i64 " + src2 + " to " + v.usize + "\n"
end

func wref(v &: Lv, src2: str, dst: str): str:
    if str.Equals(v.usize, "i64"):
        ret src2
    end
    ret dst
end

func ltype(v &: Lv): str:
    if target_is_windows_of(v.triple):
        ret "i32"
    end
    ret v.usize
end

func isatty_name(v &: Lv): str:
    ret target_is_windows_of(v.triple) ? "_isatty" : "isatty"
end

func outbuf_yield(v &: Lv): bool:
    ret not v.freestanding and not target_is_windows_of(v.triple)
end

func outbuf_arch(v &: Lv): str:
    dash := str.IndexOf(v.triple, "-")
    if dash < 0:
        ret v.triple
    end
    ret str.Substr(v.triple, 0, dash)
end

func outbuf_old_arm(v &: Lv): bool:
    arch := outbuf_arch(v)
    ret str.Equals(arch, "arm") or str.Equals(arch, "armeb") or str.StartsWith(arch, "armv4") or str.StartsWith(arch, "armv5")
end

func outbuf_lock(v &: Lv): str:
    mut spin := "  br label %try\n"
    if outbuf_yield(v):
        spin = ```
              %y = call i32 @sched_yield()
              br label %try

            ```
    end
    g := "@salam_ob_lk = internal global i32 0, align 4\n"
    if outbuf_old_arm(v) and not str.Contains(v.triple, "linux"):
        ret g + "define internal void @salam_out_lock() nounwind {\n" + "entry:\n" + "  ret void\n" + "}\n" + "define internal void @salam_out_unlock() nounwind {\n" + "entry:\n" + "  ret void\n" + "}\n"
    end
    if outbuf_old_arm(v):
        ret g + "define internal void @salam_out_lock() nounwind {\n" + "entry:\n" + "  br label %try\n" + "try:\n" + "  %cur = load volatile i32, ptr @salam_ob_lk, align 4\n" + "  %busy = icmp ne i32 %cur, 0\n" + "  br i1 %busy, label %wait, label %cas\n" + "cas:\n" + "  %kc = inttoptr i32 -61504 to ptr\n" + "  %r = call i32 %kc(i32 0, i32 1, ptr @salam_ob_lk)\n" + "  %ok = icmp eq i32 %r, 0\n" + "  br i1 %ok, label %done, label %wait\n" + "wait:\n" + spin + "done:\n" + "  ret void\n" + "}\n" + "define internal void @salam_out_unlock() nounwind {\n" + "entry:\n" + "  %mb = inttoptr i32 -61536 to ptr\n" + "  call void %mb()\n" + "  store volatile i32 0, ptr @salam_ob_lk, align 4\n" + "  ret void\n" + "}\n"
    end
    ret g + "define internal void @salam_out_lock() nounwind {\n" + "entry:\n" + "  br label %try\n" + "try:\n" + "  %old = atomicrmw xchg ptr @salam_ob_lk, i32 1 acquire, align 4\n" + "  %free = icmp eq i32 %old, 0\n" + "  br i1 %free, label %done, label %wait\n" + "wait:\n" + spin + "done:\n" + "  ret void\n" + "}\n" + "define internal void @salam_out_unlock() nounwind {\n" + "entry:\n" + "  store atomic i32 0, ptr @salam_ob_lk release, align 4\n" + "  ret void\n" + "}\n"
end

func outbuf_extra(v &: Lv): str:
    u := v.usize
    mut slen := "  %n64 = zext " + u + " %n to i64\n"
    if str.Equals(u, "i64"):
        slen = "  %n64 = add i64 %n, 0\n"
    end
    ret ```
        @salam_ob_tty = internal global i32 -1
        @salam_ob_null = private unnamed_addr constant [7 x i8] c"(null)\00"
        define internal void @salam_out_flush_fd_l(i32 %fd) nounwind {
        entry:
          %n = load i64, ptr @salam_obn
          %z = icmp eq i64 %n, 0
          br i1 %z, label %done, label %do
        do:
        ${{ wpre(v, "%n", "%nw") }}  %r = call ${{ u }} @write(i32 %fd, ptr @salam_ob, ${{ u }} ${{ wref(v, "%n", "%nw") }})
          store i64 0, ptr @salam_obn
          br label %done
        done:
          ret void
        }
        define internal void @salam_out_end1() nounwind {
        entry:
          %t = load i32, ptr @salam_ob_tty
          %z = icmp eq i32 %t, 0
          br i1 %z, label %done, label %chk
        chk:
          %neg = icmp slt i32 %t, 0
          br i1 %neg, label %init, label %fl
        init:
          %a = call i32 @${{ isatty_name(v) }}(i32 1)
          %nz = icmp ne i32 %a, 0
          %tv = zext i1 %nz to i32
          store i32 %tv, ptr @salam_ob_tty
          br i1 %nz, label %fl, label %done
        fl:
          call void @salam_out_flush_l()
          br label %done
        done:
          ret void
        }
        define internal void @salam_out_str(ptr %s0) nounwind {
        entry:
          %isnull = icmp eq ptr %s0, null
          %s = select i1 %isnull, ptr @salam_ob_null, ptr %s0
          %n = call ${{ u }} @strlen(ptr %s)
        ${{ slen }}  call void @salam_out_write(ptr %s, i64 %n64)
          ret void
        }
        define internal void @salam_out_u64x(i64 %u0, i1 %neg) nounwind {
        entry:
          %buf = alloca [24 x i8], align 1
          br label %loop
        loop:
          %u = phi i64 [ %u0, %entry ], [ %q, %loop ]
          %pos = phi i64 [ 24, %entry ], [ %pos1, %loop ]
          %q = udiv i64 %u, 10
          %m = mul i64 %q, 10
          %d = sub i64 %u, %m
          %d8 = trunc i64 %d to i8
          %c = add i8 %d8, 48
          %pos1 = sub i64 %pos, 1
          %pp = getelementptr inbounds [24 x i8], ptr %buf, i64 0, i64 %pos1
          store i8 %c, ptr %pp
          %more = icmp ne i64 %q, 0
          br i1 %more, label %loop, label %sign
        sign:
          br i1 %neg, label %minus, label %out
        minus:
          %pos2 = sub i64 %pos1, 1
          %mp = getelementptr inbounds [24 x i8], ptr %buf, i64 0, i64 %pos2
          store i8 45, ptr %mp
          br label %out
        out:
          %st = phi i64 [ %pos1, %sign ], [ %pos2, %minus ]
          %sp = getelementptr inbounds [24 x i8], ptr %buf, i64 0, i64 %st
          %len = sub i64 24, %st
          call void @salam_out_write(ptr %sp, i64 %len)
          ret void
        }
        define internal void @salam_out_i64(i64 %v) nounwind {
        entry:
          %neg = icmp slt i64 %v, 0
          %nv = sub i64 0, %v
          %u = select i1 %neg, i64 %nv, i64 %v
          call void @salam_out_u64x(i64 %u, i1 %neg)
          ret void
        }
        define internal void @salam_out_u64(i64 %v) nounwind {
        entry:
          call void @salam_out_u64x(i64 %v, i1 false)
          ret void
        }
        define internal void @salam_out_byte(i32 %c) nounwind {
        entry:
          %b = alloca i8, align 1
          %t = trunc i32 %c to i8
          store i8 %t, ptr %b
          call void @salam_out_write(ptr %b, i64 1)
          ret void
        }

        ```
end

func emit_outbuf(v &: Lv):
    out_hg(
        v, ```
            @salam_ob = internal global [65536 x i8] zeroinitializer
            @salam_obn = internal global i64 0
            declare void @llvm.memcpy.p0.p0.i64(ptr, ptr, i64, i1) nounwind
            define internal void @salam_out_flush_l() nounwind {
            entry:
              call void @salam_out_flush_fd_l(i32 1)
              ret void
            }
            ${{ outbuf_lock(v) }}define internal void @salam_out_flush() nounwind {
            entry:
              %n = load i64, ptr @salam_obn
              %z = icmp eq i64 %n, 0
              br i1 %z, label %done, label %do
            do:
              call void @salam_out_lock()
              call void @salam_out_flush_fd_l(i32 1)
              call void @salam_out_unlock()
              br label %done
            done:
              ret void
            }
            ${{ onsig_helper(v) }}define internal void @salam_out_write(ptr %s, i64 %n) nounwind {
            entry:
              %obn = load i64, ptr @salam_obn
              %sum = add i64 %obn, %n
              %over = icmp ugt i64 %sum, 65536
              br i1 %over, label %flush, label %chk
            flush:
              call void @salam_out_flush_l()
              br label %chk
            chk:
              %big = icmp uge i64 %n, 65536
              br i1 %big, label %direct, label %copy
            direct:
            ${{ wpre(v, "%n", "%ndw") }}  %rd = call ${{ v.usize }} @write(i32 1, ptr %s, ${{ v.usize }} ${{ wref(v, "%n", "%ndw") }})
              ret void
            copy:
              %obn2 = load i64, ptr @salam_obn
              %dst = getelementptr inbounds [65536 x i8], ptr @salam_ob, i64 0, i64 %obn2
              call void @llvm.memcpy.p0.p0.i64(ptr %dst, ptr %s, i64 %n, i1 false)
              %newn = add i64 %obn2, %n
              store i64 %newn, ptr @salam_obn
              ret void
            }
            @llvm.global_dtors = appending global [1 x { i32, ptr, ptr }] [{ i32, ptr, ptr } { i32 65535, ptr @salam_out_flush, ptr null }]
            ${{ outbuf_extra(v) }}

            ```
    )
end

func need(v &: Lv, which: int):
    if v.hneed.get(which):
        ret
    end
    v.hneed.set(which, true)
    if which == LV_H_SUBSTR:
        emit_substr(v)
    else which == LV_H_STRCAT:
        emit_strcat(v)
    else which == LV_H_ISWS:
        emit_isws(v)
    else which == LV_H_TRIM:
        emit_trim(v)
    else which == LV_H_STRHASH:
        emit_strhash(v)
    else which == LV_H_INTHASH:
        emit_inthash(v)
    else which == LV_H_I64STR:
        emit_i64str(v)
    else which == LV_H_U64STR:
        emit_u64str(v)
    else which == LV_H_F64STR:
        emit_f64str(v)
    else which == LV_H_CHARSTR:
        emit_charstr(v)
    else which == LV_H_OUTBUF:
        emit_outbuf(v)
    else which == LV_H_REPEAT:
        emit_repeat(v)
    else which == LV_H_UPPER:
        emit_upper(v)
    else which == LV_H_LOWER:
        emit_lower(v)
    else which == LV_H_U8STEP:
        emit_u8step(v)
    else which == LV_H_U8ADV:
        emit_u8adv(v)
    else which == LV_H_U8CNT:
        emit_u8cnt(v)
    else which == LV_H_U8SUBSTR:
        emit_u8substr(v)
    else which == LV_H_U8FIND:
        emit_u8find(v)
    else which == LV_H_ASCIIDIG:
        emit_asciidig(v)
    end
end

func toplevel(v &: Lv, s &: sm.Sema, a &: at.Ast, d: int):
    dn := at.Get(a, d)
    k := dn.kind
    if k == at.AST_FUNC_DEF:
        if dn.is_extern and dn.a == 0:
            ret
        end
        if dn.typarams.len() > 0:
            ret
        end
        emit_function(v, s, a, d, 0)
    else k == at.AST_STRUCT_DEF:
        if dn.typarams.len() > 0:
            ret
        end
        ssym := struct_sym(v, s, a, dn.name)
        repeat at.ChildCount(a, d) in i:
            m := at.Child(a, d, i)
            if at.KindOf(a, m) == at.AST_FUNC_DEF:
                emit_function(v, s, a, m, ssym)
            end
        end
    else k == at.AST_ENUM_DEF or k == at.AST_CONST_DECL or k == at.AST_VAR_DECL or k == at.AST_INTERFACE_DEF or k == at.AST_IMPL_DEF or k == at.AST_IMPORT or k == at.AST_LINK or k == at.AST_TYPE_ALIAS or k == at.AST_LAYOUT_BLOCK or k == at.AST_LAYOUT_COMPONENT:
        _k := k
    else:
        lv_error(
            v, a, d, "top-level " + at.KindName(k) + " (layout/unsupported)"
        )
    end
end
