package llvmgen

import str
import co "../sal_core.salam"
import sm "../semantic/semantic.salam"

func meta_add(v &: Lv, text: str): str:
    id := "!" + co.I64Toa(v.meta_n as i64)
    v.meta_n += 1
    out_meta(v, id + " = " + text + "\n")
    ret id
end

func tbaa_ensure_common(v &: Lv):
    if str.Len(v.tbaa_char) > 0:
        ret
    end
    root := meta_add(v, `!{!"salam-tbaa"}`)
    v.tbaa_char = meta_add(v, `!{!"salam bytes", ` + root + ", i64 0}")
end

func tbaa_suffix(v &: Lv, s &: sm.Sema, ts: str, is_field: bool): str:
    if str.Len(ts) == 0:
        ret ""
    end
    if is_ptr_ts(ts) || is_str(s, ts) || fn_prefix(ts) != 0:
        if !is_field:
            ret ""
        end
        if str.Len(v.tbaa_ptr_sfx) == 0:
            tbaa_ensure_common(v)
            pnode := meta_add(v, `!{!"any pointer", ` + v.tbaa_char + ", i64 0}")
            ptag := meta_add(v, "!{" + pnode + ", " + pnode + ", i64 0}")
            v.tbaa_ptr_sfx = ", !tbaa " + ptag
        end
        ret v.tbaa_ptr_sfx
    end
    if !(is_float(ts) || (is_int_ts(ts) && int_bits(v, ts) >= 16)):
        ret ""
    end
    if str.Len(v.tbaa_data_sfx) == 0:
        tbaa_ensure_common(v)
        dnode := meta_add(v, `!{!"salam data", ` + v.tbaa_char + ", i64 0}")
        dtag := meta_add(v, "!{" + dnode + ", " + dnode + ", i64 0}")
        v.tbaa_data_sfx = ", !tbaa " + dtag
    end
    ret v.tbaa_data_sfx
end

func di_escape(sx: str): str:
    n := str.Len(sx)
    mut b := co.SbNew()
    mut i := 0
    until i < n:
        c := byte_at(sx, i)
        if c == 92 || c == 34:
            co.SbPutc(b, 92)
        end
        co.SbPutc(b, c)
        i += 1
    end
    r := co.SbCstr(b)
    co.SbFree(b)
    ret r
end

func di_split_path(v &: Lv, path: str):
    if str.Len(path) == 0:
        v.src_file = v.module + ".salam"
        v.src_dir = "."
        ret
    end
    slash := last_byte(path, 47)
    bs := last_byte(path, 92)
    mut cut := slash
    if bs >= 0 && (slash < 0 || bs > slash):
        cut = bs
    end
    if cut >= 0:
        v.src_file = str.Substr(path, cut + 1, str.Len(path) - cut - 1)
        v.src_dir = str.Substr(path, 0, cut)
    else:
        v.src_file = path
        v.src_dir = "."
    end
end

func debug_init(v &: Lv, src_path: str):
    di_split_path(v, src_path)
    v.di_file = meta_add(
        v, `!DIFile(filename: "` + di_escape(v.src_file) + `", directory: "` + di_escape(v.src_dir) + `")`
    )
    v.di_cu = meta_add(
        v, "distinct !DICompileUnit(language: DW_LANG_C99, " + "file: " + v.di_file + `, producer: "salam", ` + "isOptimized: false, runtimeVersion: 0, " + "emissionKind: FullDebug)"
    )
    types := meta_add(v, "!{null}")
    v.di_subty = meta_add(v, "!DISubroutineType(types: " + types + ")")
    v.di_flag_dwarf = meta_add(v, `!{i32 7, !"Dwarf Version", i32 5}`)
    v.di_flag_debug = meta_add(v, `!{i32 2, !"Debug Info Version", i32 3}`)
end

func debug_subprogram(v &: Lv, name: str, line: int): str:
    sp := meta_add(
        v, `distinct !DISubprogram(name: "` + name + `", scope: ` + v.di_file + ", file: " + v.di_file + ", line: " + co.I64Toa(line as i64) + ", type: " + v.di_subty + ", scopeLine: " + co.I64Toa(line as i64) + ", spFlags: DISPFlagDefinition, unit: " + v.di_cu + ")"
    )
    v.cur_sp = sp
    ret sp
end

func debug_location(v &: Lv, line: int, col: int): str:
    if str.Len(v.cur_sp) == 0:
        ret ""
    end
    ret meta_add(
        v, "!DILocation(line: " + co.I64Toa(line as i64) + ", column: " + co.I64Toa(col as i64) + ", scope: " + v.cur_sp + ")"
    )
end

func debug_finalize(v &: Lv):
    if !v.debug && v.meta_n == 0:
        ret
    end
    out_g(v, "\n")
    if v.debug:
        out_g(
            v, "!llvm.module.flags = !{" + v.di_flag_dwarf + ", " + v.di_flag_debug + "}\n"
        )
        out_g(v, "!llvm.dbg.cu = !{" + v.di_cu + "}\n")
    end
    out_g(v, co.SbCstr(v.bmeta))
end
