package llvmgen

import str

include co "../sal_core.salam"
include tok "../token.salam"
include at "../ast.salam"
include sm "../semantic/semantic.salam"

const EXA_NONE := 0
const EXA_SYSV := 1
const EXA_WIN64 := 2
const EXA_AARCH64 := 3
const EXA_X86 := 4
const EXA_ARM := 5
const EXA_RV64 := 6

const EXM_NONE := 0
const EXM_REGS := 1
const EXM_BYVAL := 2
const EXM_COPY := 3

struct ExArg:
    pub mode: int = 0
    pub size: int = 0
    pub pieces: Vector<str> = Vector {}
    pub offs: Vector<int> = Vector {}
    pub align: int = 8
end

struct ExSig:
    pub params: Vector<str> = Vector {}
    pub refs: Vector<bool> = Vector {}
    pub rts: str = ""
    pub variadic: bool = false
end

func ex_sig_of(s &: sm.Sema, a &: at.Ast, sig: int): ExSig:
    sg := sm.SigAt(s, sig)
    mut x := ExSig {}
    repeat sg.params.len() in i:
        x.params.push(sm.ToString(s, sg.params.get(i)))
        x.refs.push(param_is_ref(s, a, sig, i))
    end
    x.rts = sm.ToString(s, sg.ret_type)
    x.variadic = sg.variadic
    ret x
end

func ex_sig_ptr(fts: str): ExSig:
    mut x := ExSig {}
    x.params = func_params(fts)
    repeat x.params.len():
        x.refs.push(false)
    end
    x.rts = func_ret(fts)
    ret x
end

func ex_sig_free(x &: ExSig):
    x.params.free()
    x.refs.free()
end

func ex_host_arch(): str:
    if SALAM_ARCH_X64:
        ret "x86_64"
    else SALAM_ARCH_ARM64:
        ret "aarch64"
    else SALAM_ARCH_X86:
        ret "i686"
    else SALAM_ARCH_ARM:
        ret "arm"
    else SALAM_ARCH_RISCV64:
        ret "riscv64"
    else:
        ret ""
    end
end

func ex_arch(v &: Lv): int:
    arch := str.Len(v.triple) > 0 ? outbuf_arch(v) : ex_host_arch()
    if v.ptr_bits != 64:
        if str.Equals(arch, "i386") or str.Equals(arch, "i486") or str.Equals(arch, "i586") or str.Equals(arch, "i686"):
            ret EXA_X86
        end
        if (str.StartsWith(arch, "arm") or str.StartsWith(arch, "thumb")) and not str.EndsWith(arch, "eb"):
            ret EXA_ARM
        end
        ret EXA_NONE
    end
    if str.Equals(arch, "riscv64"):
        ret EXA_RV64
    end
    if str.Equals(arch, "x86_64") or str.Equals(arch, "amd64"):
        if target_is_windows_of(v.triple):
            ret EXA_WIN64
        end
        ret EXA_SYSV
    end
    if str.Equals(arch, "aarch64") or str.Equals(arch, "arm64"):
        ret EXA_AARCH64
    end
    ret EXA_NONE
end

func ex_align_up(x: int, al: int): int:
    ret (x + al - 1) / al * al
end

func ex_scalar_size(v &: Lv, s &: sm.Sema, a &: at.Ast, ts: str): int:
    if is_str(s, ts) or is_ptr_ts(ts):
        ret v.ptr_bits / 8
    end
    if str.Equals(ts, "f32"):
        ret 4
    end
    if str.Equals(ts, "f64"):
        ret 8
    end
    if is_int_ts(ts):
        bits := int_bits(v, ts)
        if bits < 8:
            ret 1
        end
        ret bits / 8
    end
    esym := enum_sym(v, s, a, ts)
    if esym != 0:
        if sm.SymAt(s, esym).enum_val_kind == tok.TV_FLOAT:
            ret 8
        end
        ret 4
    end
    ret 0 - 1
end

func ex_layout(v &: Lv, s &: sm.Sema, a &: at.Ast, ts: str, align &: int): int:
    if str.Len(ts) == 0:
        ret 0 - 1
    end
    if is_slice(ts):
        align = 8
        ret 16
    end
    if is_array_ts(ts):
        mut ea := 1
        es := ex_layout(v, s, a, array_elem(ts), ea)
        if es < 0:
            ret 0 - 1
        end
        align = ea
        ret es * (array_dim(ts) as int)
    end
    sc := ex_scalar_size(v, s, a, ts)
    if sc >= 0:
        align = sc
        ret sc
    end
    ssym := struct_sym(v, s, a, ts)
    if ssym == 0 or sm.SymAt(s, ssym).members == 0:
        ret 0 - 1
    end
    syms := sm.ScopeAt(s, sm.SymAt(s, ssym).members).symbols
    mut off := 0
    mut mx := 1
    repeat syms.len() in i:
        f := sm.SymAt(s, syms.get(i))
        if f.kind == sm.SYM_FIELD:
            mut fa := 1
            fs := ex_layout(v, s, a, sm.ToString(s, f.ty), fa)
            if fs < 0:
                ret 0 - 1
            end
            off = ex_align_up(off, fa) + fs
            if fa > mx:
                mx = fa
            end
        end
    end
    align = mx
    ret ex_align_up(off, mx)
end

func ex_flat(
    v &: Lv, s &: sm.Sema, a &: at.Ast, ts: str, base: int, offs &: Vector<int>, cls &: Vector<int>, szs &: Vector<int>
): bool:
    if offs.len() > 64:
        ret false
    end
    if is_slice(ts):
        offs.push(base)
        cls.push(1)
        szs.push(8)
        offs.push(base + 8)
        cls.push(1)
        szs.push(8)
        ret true
    end
    if is_array_ts(ts):
        mut ea := 1
        es := ex_layout(v, s, a, array_elem(ts), ea)
        if es < 0:
            ret false
        end
        n := array_dim(ts) as int
        repeat n in k:
            if not ex_flat(v, s, a, array_elem(ts), base + k * es, offs, cls, szs):
                ret false
            end
        end
        ret true
    end
    sc := ex_scalar_size(v, s, a, ts)
    if sc >= 0:
        offs.push(base)
        szs.push(sc)
        if str.Equals(ts, "f32") or str.Equals(ts, "f64") or enum_backed_float(v, s, a, ts):
            cls.push(sc == 4 ? 2 : 3)
        else:
            cls.push(1)
        end
        ret true
    end
    ssym := struct_sym(v, s, a, ts)
    if ssym == 0 or sm.SymAt(s, ssym).members == 0:
        ret false
    end
    syms := sm.ScopeAt(s, sm.SymAt(s, ssym).members).symbols
    mut off := 0
    repeat syms.len() in i:
        f := sm.SymAt(s, syms.get(i))
        if f.kind == sm.SYM_FIELD:
            fts := sm.ToString(s, f.ty)
            mut fa := 1
            fs := ex_layout(v, s, a, fts, fa)
            if fs < 0:
                ret false
            end
            off = ex_align_up(off, fa)
            if not ex_flat(v, s, a, fts, base + off, offs, cls, szs):
                ret false
            end
            off += fs
        end
    end
    ret true
end

func ex_int_width(n: int): int:
    if n <= 1:
        ret 1
    end
    if n == 2:
        ret 2
    end
    if n <= 4:
        ret 4
    end
    ret 8
end

func ex_sysv(v &: Lv, s &: sm.Sema, a &: at.Ast, ts: str, size: int, r &: ExArg):
    if size > 16:
        r.mode = EXM_BYVAL
        ret
    end
    mut offs := Vector {} as Vector<int>
    mut cls := Vector {} as Vector<int>
    mut szs := Vector {} as Vector<int>
    if not ex_flat(v, s, a, ts, 0, offs, cls, szs):
        ret
    end
    nb := (size + 7) / 8
    repeat nb in eb:
        mut has_int := false
        mut nflt := 0
        mut ndbl := 0
        repeat offs.len() in k:
            if offs.get(k) / 8 == eb:
                if cls.get(k) == 1:
                    has_int = true
                else cls.get(k) == 2:
                    nflt += 1
                else:
                    ndbl += 1
                end
            end
        end
        mut ln := size - eb * 8
        if ln > 8:
            ln = 8
        end
        mut piece := ""
        if has_int or nflt + ndbl == 0:
            piece = "i" + co.I64Toa((ex_int_width(ln) * 8) as i64)
        else ndbl > 0:
            piece = "double"
        else nflt >= 2:
            piece = "double"
        else ln == 4:
            piece = "float"
        else:
            piece = "double"
        end
        r.pieces.push(piece)
        r.offs.push(eb * 8)
    end
    r.mode = EXM_REGS
end

func ex_aarch64(v &: Lv, s &: sm.Sema, a &: at.Ast, ts: str, size: int, r &: ExArg):
    if size <= 64:
        mut offs := Vector {} as Vector<int>
        mut cls := Vector {} as Vector<int>
        mut szs := Vector {} as Vector<int>
        if ex_flat(v, s, a, ts, 0, offs, cls, szs) and offs.len() >= 1 and offs.len() <= 4 and cls.get(0) != 1:
            mut same := true
            repeat cls.len() in k:
                if cls.get(k) != cls.get(0):
                    same = false
                end
            end
            if same:
                r.mode = EXM_REGS
                r.pieces.push("[" + co.I64Toa(offs.len() as i64) + " x " + (cls.get(0) == 2 ? "float" : "double") + "]")
                r.offs.push(0)
                ret
            end
        end
    end
    if size > 16:
        r.mode = EXM_COPY
        ret
    end
    r.mode = EXM_REGS
    r.pieces.push(size <= 8 ? "i64" : "[2 x i64]")
    r.offs.push(0)
end

func ex_is_win(v &: Lv): bool:
    ret str.Len(v.triple) > 0 ? target_is_windows_of(v.triple) : SALAM_OS_WINDOWS
end

func ex_hfa(v &: Lv, s &: sm.Sema, a &: at.Ast, ts: str, r &: ExArg): bool:
    mut offs := Vector {} as Vector<int>
    mut cls := Vector {} as Vector<int>
    mut szs := Vector {} as Vector<int>
    if not ex_flat(v, s, a, ts, 0, offs, cls, szs) or offs.len() < 1 or offs.len() > 4 or cls.get(0) == 1:
        ret false
    end
    repeat cls.len() in k:
        if cls.get(k) != cls.get(0):
            ret false
        end
    end
    r.mode = EXM_REGS
    r.pieces.push("[" + co.I64Toa(offs.len() as i64) + " x " + (cls.get(0) == 2 ? "float" : "double") + "]")
    r.offs.push(0)
    ret true
end

func ex_arm(v &: Lv, s &: sm.Sema, a &: at.Ast, ts: str, size: int, al: int, va: bool, r &: ExArg):
    if not va and ex_hfa(v, s, a, ts, r):
        ret
    end
    r.align = al > 4 ? 8 : 4
    if size > 64:
        r.mode = EXM_BYVAL
        ret
    end
    r.mode = EXM_REGS
    r.pieces.push("[" + co.I64Toa(((size + r.align - 1) / r.align) as i64) + " x i" + co.I64Toa((r.align * 8) as i64) + "]")
    r.offs.push(0)
end

func ex_rv_int(size: int, r &: ExArg):
    if size > 16:
        r.mode = EXM_COPY
        ret
    end
    r.mode = EXM_REGS
    r.pieces.push(size <= 8 ? "i64" : "[2 x i64]")
    r.offs.push(0)
end

func ex_rv(v &: Lv, s &: sm.Sema, a &: at.Ast, ts: str, size: int, fp: bool, r &: ExArg):
    if fp:
        mut offs := Vector {} as Vector<int>
        mut cls := Vector {} as Vector<int>
        mut szs := Vector {} as Vector<int>
        if ex_flat(v, s, a, ts, 0, offs, cls, szs) and (offs.len() == 1 or offs.len() == 2):
            mut nf := 0
            mut small := true
            repeat offs.len() in k:
                if cls.get(k) != 1:
                    nf += 1
                end
                if szs.get(k) > 8:
                    small = false
                end
            end
            if small and nf >= 1 and (offs.len() == 2 or nf == 1):
                repeat offs.len() in k2:
                    if cls.get(k2) == 2:
                        r.pieces.push("float")
                    else cls.get(k2) == 3:
                        r.pieces.push("double")
                    else:
                        r.pieces.push("i" + co.I64Toa((szs.get(k2) * 8) as i64))
                    end
                    r.offs.push(offs.get(k2))
                end
                r.mode = EXM_REGS
                ret
            end
        end
    end
    ex_rv_int(size, r)
end

func ex_classify(v &: Lv, s &: sm.Sema, a &: at.Ast, ts: str): ExArg:
    mut r := ExArg {}
    arch := ex_arch(v)
    if arch == EXA_NONE or is_ptr_ts(ts) or is_slice(ts) or is_array_ts(ts) or struct_sym(v, s, a, ts) == 0:
        ret r
    end
    if arch == EXA_X86:
        r.mode = EXM_BYVAL
        r.align = 4
        ret r
    end
    mut al := 1
    size := ex_layout(v, s, a, ts, al)
    if size <= 0:
        ret r
    end
    r.size = size
    if arch == EXA_WIN64:
        if size == 1 or size == 2 or size == 4 or size == 8:
            r.mode = EXM_REGS
            r.pieces.push("i" + co.I64Toa((size * 8) as i64))
            r.offs.push(0)
        else:
            r.mode = EXM_COPY
        end
        ret r
    end
    if arch == EXA_SYSV:
        ex_sysv(v, s, a, ts, size, r)
        ret r
    end
    if arch == EXA_ARM:
        ex_arm(v, s, a, ts, size, al, false, r)
        ret r
    end
    if arch == EXA_RV64:
        ex_rv(v, s, a, ts, size, true, r)
        ret r
    end
    ex_aarch64(v, s, a, ts, size, r)
    ret r
end

func ex_ret(v &: Lv, s &: sm.Sema, a &: at.Ast, sig: int): ExArg:
    sg := sm.SigAt(s, sig)
    ret ex_ret_ts(v, s, a, sm.ToString(s, sg.ret_type), sg.variadic)
end

func ex_ret_ts(v &: Lv, s &: sm.Sema, a &: at.Ast, ts: str, variadic: bool): ExArg:
    arch := ex_arch(v)
    if arch != EXA_X86 and arch != EXA_ARM:
        ret ex_classify(v, s, a, ts)
    end
    mut r := ExArg {}
    if is_ptr_ts(ts) or is_slice(ts) or is_array_ts(ts) or struct_sym(v, s, a, ts) == 0:
        ret r
    end
    mut al := 1
    size := ex_layout(v, s, a, ts, al)
    r.size = size
    if arch == EXA_X86 and not ex_is_win(v):
        r.mode = EXM_COPY
        ret r
    end
    if size <= 0:
        ret ExArg {}
    end
    if arch == EXA_ARM:
        if not variadic and ex_hfa(v, s, a, ts, r):
            ret r
        end
        if size <= 4:
            r.mode = EXM_REGS
            r.pieces.push("i32")
            r.offs.push(0)
        else:
            r.mode = EXM_COPY
        end
        ret r
    end
    mut offs := Vector {} as Vector<int>
    mut cls := Vector {} as Vector<int>
    mut szs := Vector {} as Vector<int>
    if ex_flat(v, s, a, ts, 0, offs, cls, szs) and offs.len() == 1 and cls.get(0) != 1 and szs.get(0) == size:
        r.mode = EXM_REGS
        r.pieces.push(size == 4 ? "float" : "double")
        r.offs.push(0)
        ret r
    end
    if size == 1 or size == 2 or size == 4 or size == 8:
        r.mode = EXM_REGS
        r.pieces.push("i" + co.I64Toa((size * 8) as i64))
        r.offs.push(0)
    else:
        r.mode = EXM_COPY
    end
    ret r
end

func ex_rv_param(v &: Lv, s &: sm.Sema, a &: at.Ast, x &: ExSig, j: int): ExArg:
    mut gl := 8
    mut fl := 8
    rm := ex_ret_ts(v, s, a, x.rts, x.variadic).mode
    if rm != EXM_NONE and rm != EXM_REGS:
        gl -= 1
    end
    mut out := ExArg {}
    repeat j + 1 in k:
        kts := x.params.get(k)
        mut e := ExArg {}
        if x.refs.get(k):
            gl -= 1
        else:
            e = ex_classify(v, s, a, kts)
            if e.mode == EXM_NONE:
                kty := ty_of(v, s, a, kts)
                if str.Equals(kty, "float") or str.Equals(kty, "double"):
                    if fl > 0:
                        fl -= 1
                    else:
                        gl -= 1
                    end
                else is_slice(kts):
                    gl -= 2
                else:
                    gl -= 1
                end
            else e.mode == EXM_REGS:
                mut nf := 0
                mut ni := 0
                each pc in e.pieces:
                    if str.Equals(pc, "float") or str.Equals(pc, "double"):
                        nf += 1
                    else str.Equals(pc, "[2 x i64]"):
                        ni += 2
                    else:
                        ni += 1
                    end
                end
                if nf > 0 and (nf > fl or (ni > 0 and ni > gl)):
                    mut w := ExArg {}
                    w.size = e.size
                    ex_rv_int(e.size, w)
                    e = w
                    gl -= e.mode == EXM_REGS and str.Equals(e.pieces.get(0), "[2 x i64]") ? 2 : 1
                else:
                    fl -= nf
                    gl -= ni
                end
            else:
                gl -= 1
            end
        end
        if k == j:
            out = e
        end
    end
    ret out
end

func ex_reg_need(e: ExArg, ni &: int, ns &: int):
    ni = 0
    ns = 0
    each pc in e.pieces:
        if str.Equals(pc, "float") or str.Equals(pc, "double"):
            ns += 1
        else:
            ni += 1
        end
    end
end

func ex_sysv_fits(e: ExArg, gi: int, fi: int): bool:
    mut ni := 0
    mut ns := 0
    ex_reg_need(e, ni, ns)
    ret (ni == 0 or ni <= gi) and (ns == 0 or ns <= fi)
end

func ex_sysv_take(v &: Lv, s &: sm.Sema, a &: at.Ast, ts: str, is_ref: bool, gi &: int, fi &: int):
    if is_ref:
        gi -= 1
        ret
    end
    ke := ex_classify(v, s, a, ts)
    if ke.mode == EXM_REGS:
        if ex_sysv_fits(ke, gi, fi):
            mut ni := 0
            mut ns := 0
            ex_reg_need(ke, ni, ns)
            gi -= ni
            fi -= ns
        end
    else ke.mode == EXM_NONE:
        kty := ty_of(v, s, a, ts)
        if str.Equals(kty, "float") or str.Equals(kty, "double"):
            fi -= 1
        else is_slice(ts):
            gi -= 2
        else:
            gi -= 1
        end
    end
end

func ex_sysv_fixed(v &: Lv, s &: sm.Sema, a &: at.Ast, x &: ExSig, upto: int, gi &: int, fi &: int):
    gi = 6
    fi = 8
    if ex_ret_ts(v, s, a, x.rts, x.variadic).mode == EXM_BYVAL:
        gi -= 1
    end
    repeat upto in k:
        ex_sysv_take(v, s, a, x.params.get(k), x.refs.get(k), gi, fi)
    end
end

func ex_param(v &: Lv, s &: sm.Sema, a &: at.Ast, sig: int, j: int): ExArg:
    arch := ex_arch(v)
    if arch != EXA_RV64 and arch != EXA_SYSV:
        ret ex_classify(v, s, a, sm.ToString(s, sm.SigAt(s, sig).params.get(j)))
    end
    if arch == EXA_SYSV:
        e := ex_classify(v, s, a, sm.ToString(s, sm.SigAt(s, sig).params.get(j)))
        if e.mode != EXM_REGS:
            ret e
        end
    end
    mut x := ex_sig_of(s, a, sig)
    r := ex_param_of(v, s, a, x, j)
    ex_sig_free(x)
    ret r
end

func ex_param_of(v &: Lv, s &: sm.Sema, a &: at.Ast, x &: ExSig, j: int): ExArg:
    if ex_arch(v) == EXA_RV64:
        ret ex_rv_param(v, s, a, x, j)
    end
    mut e := ex_classify(v, s, a, x.params.get(j))
    if e.mode != EXM_REGS or ex_arch(v) != EXA_SYSV:
        ret e
    end
    mut gi := 0
    mut fi := 0
    ex_sysv_fixed(v, s, a, x, j, gi, fi)
    if not ex_sysv_fits(e, gi, fi):
        e.mode = EXM_BYVAL
    end
    ret e
end

func ex_va_other(v &: Lv, s &: sm.Sema, a &: at.Ast, ts: str): ExArg:
    mut r := ExArg {}
    arch := ex_arch(v)
    if arch == EXA_X86:
        r.mode = EXM_BYVAL
        r.align = 4
        ret r
    end
    mut al := 1
    size := ex_layout(v, s, a, ts, al)
    if size <= 0:
        ret r
    end
    r.size = size
    if arch == EXA_ARM:
        ex_arm(v, s, a, ts, size, al, true, r)
    else arch == EXA_RV64:
        ex_rv(v, s, a, ts, size, false, r)
    end
    ret r
end

func ex_va_arg(v &: Lv, s &: sm.Sema, a &: at.Ast, sig: int, call: int, i: int, ts: str): ExArg:
    arch := ex_arch(v)
    if arch == EXA_NONE or arch == EXA_X86 or arch == EXA_ARM or arch == EXA_RV64:
        ret ex_va_other(v, s, a, ts)
    end
    mut e := ex_classify(v, s, a, ts)
    if e.mode != EXM_REGS:
        ret e
    end
    if arch == EXA_AARCH64 and target_is_windows_of(v.triple):
        mut w := ExArg {}
        w.size = e.size
        if e.size > 16:
            w.mode = EXM_COPY
            ret w
        end
        w.mode = EXM_REGS
        w.pieces.push("i64")
        w.offs.push(0)
        if e.size > 8:
            w.pieces.push("i64")
            w.offs.push(8)
        end
        ret w
    end
    if arch != EXA_SYSV:
        ret e
    end
    mut gi := 0
    mut fi := 0
    np := sm.SigAt(s, sig).params.len()
    mut x := ex_sig_of(s, a, sig)
    ex_sysv_fixed(v, s, a, x, np, gi, fi)
    ex_sig_free(x)
    if call != 0:
        cl := at.Get(a, call).list
        mut j := np
        until j < i:
            ex_sysv_take(v, s, a, at.Get(a, cl.get(j)).type_str, false, gi, fi)
            j += 1
        end
    end
    if not ex_sysv_fits(e, gi, fi):
        e.mode = EXM_BYVAL
    end
    ret e
end

func ex_param_text(e: ExArg, lty: str): str:
    if e.mode == EXM_REGS:
        mut b := co.SbNew()
        repeat e.pieces.len() in j:
            if j > 0:
                co.SbPuts(b, ", ")
            end
            co.SbPuts(b, e.pieces.get(j))
        end
        r := co.SbCstr(b)
        co.SbFree(b)
        ret r
    end
    if e.mode == EXM_BYVAL:
        ret "ptr byval(" + lty + ") align " + co.I64Toa(e.align as i64)
    end
    ret "ptr"
end

func ex_param_ty(v &: Lv, s &: sm.Sema, a &: at.Ast, sig: int, j: int, cname: str): str:
    if param_is_ref(s, a, sig, j):
        ret "ptr"
    end
    pex := ex_param(v, s, a, sig, j)
    if pex.mode == EXM_REGS:
        ret ex_param_text(pex, "")
    end
    if pex.mode != EXM_NONE:
        ret "ptr"
    end
    pty := ty_of(v, s, a, sm.ToString(s, sm.SigAt(s, sig).params.get(j)))
    if str.Equals(pty, "i64") and not str.Equals(v.usize, "i64") and libc_size_param(cname, j):
        ret v.usize
    end
    ret pty
end

func ex_va_callty(v &: Lv, s &: sm.Sema, a &: at.Ast, sig: int, cname: str): str:
    sg := sm.SigAt(s, sig)
    if not sg.variadic or not sig_is_extern(s, a, sig):
        ret ""
    end
    mut b := co.SbNew()
    co.SbPuts(b, " (")
    rmode := ex_ret(v, s, a, sig).mode
    if rmode != EXM_NONE and rmode != EXM_REGS:
        co.SbPuts(b, "ptr, ")
    end
    repeat sg.params.len() in j:
        co.SbPuts(b, ex_param_ty(v, s, a, sig, j, cname) + ", ")
    end
    co.SbPuts(b, "...)")
    r := co.SbCstr(b)
    co.SbFree(b)
    ret r
end

func ex_va_promote(v &: Lv, ty: str, ref2: str, sgn: bool, out_ty &: str): str:
    if str.Equals(ty, "float"):
        r := new_tmp(v)
        emit(v, r + " = fpext float " + ref2 + " to double")
        out_ty = "double"
        ret r
    end
    if str.Equals(ty, "i1") or str.Equals(ty, "i8") or str.Equals(ty, "i16"):
        r2 := new_tmp(v)
        emit(v, r2 + " = " + (sgn and not str.Equals(ty, "i1") ? "sext " : "zext ") + ty + " " + ref2 + " to i32")
        out_ty = "i32"
        ret r2
    end
    out_ty = ty
    ret ref2
end

func ex_ret_ty(e: ExArg): str:
    if e.mode == EXM_REGS:
        if e.pieces.len() == 1:
            ret e.pieces.get(0)
        end
        ret "{ " + e.pieces.get(0) + ", " + e.pieces.get(1) + " }"
    end
    ret "void"
end

func ex_sret_param(e: ExArg, lty: str): str:
    if e.mode == EXM_REGS:
        ret ""
    end
    ret "ptr sret(" + lty + ") align 8"
end

func ex_slot(v &: Lv, size: int): str:
    slot := new_tmp(v)
    emit_alloca(v, slot + " = alloca [" + co.I64Toa(ex_align_up(size, 16) as i64) + " x i8], align 16")
    ret slot
end

func ex_at(v &: Lv, slot: str, off: int): str:
    if off == 0:
        ret slot
    end
    p := new_tmp(v)
    emit(v, p + " = getelementptr i8, ptr " + slot + ", i64 " + co.I64Toa(off as i64))
    ret p
end

func ex_emit_arg(v &: Lv, ab &: str.StringBuilder, e: ExArg, lty: str, ref2: str):
    if e.mode == EXM_REGS:
        slot := ex_slot(v, e.size)
        emit(v, "store " + lty + " " + ref2 + ", ptr " + slot)
        repeat e.pieces.len() in j:
            if j > 0:
                co.SbPuts(ab, ", ")
            end
            p := ex_at(v, slot, e.offs.get(j))
            x := new_tmp(v)
            emit(v, x + " = load " + e.pieces.get(j) + ", ptr " + p)
            co.SbPuts(ab, e.pieces.get(j) + " " + x)
        end
        ret
    end
    slot2 := new_tmp(v)
    emit_alloca(v, slot2 + " = alloca " + lty + ", align 8")
    emit(v, "store " + lty + " " + ref2 + ", ptr " + slot2)
    if e.mode == EXM_BYVAL:
        co.SbPuts(ab, "ptr byval(" + lty + ") align " + co.I64Toa(e.align as i64) + " " + slot2)
    else:
        co.SbPuts(ab, "ptr " + slot2)
    end
end

func ex_emit_call(
    v &: Lv, s &: sm.Sema, a &: at.Ast, e: ExArg, rts: str, cc: str, callty: str, callee: str, argsx: str
): Llv:
    lty := ty_of(v, s, a, rts)
    res := new_tmp(v)
    if e.mode == EXM_REGS:
        slot := ex_slot(v, e.size)
        rty := ex_ret_ty(e)
        r := new_tmp(v)
        emit(v, r + " = call" + cc + " " + rty + callty + " " + callee + "(" + argsx + ")")
        if e.pieces.len() == 1:
            emit(v, "store " + rty + " " + r + ", ptr " + slot)
        else:
            repeat e.pieces.len() in j:
                x := new_tmp(v)
                emit(v, x + " = extractvalue " + rty + " " + r + ", " + co.I64Toa(j as i64))
                p := ex_at(v, slot, e.offs.get(j))
                emit(v, "store " + e.pieces.get(j) + " " + x + ", ptr " + p)
            end
        end
        emit(v, res + " = load " + lty + ", ptr " + slot)
        ret make_llv(res, rts)
    end
    slot2 := new_tmp(v)
    emit_alloca(v, slot2 + " = alloca " + lty + ", align 8")
    mut full := ex_sret_param(e, lty) + " " + slot2
    if str.Len(argsx) > 0:
        full = full + ", " + argsx
    end
    emit(v, "call" + cc + " void" + callty + " " + callee + "(" + full + ")")
    emit(v, res + " = load " + lty + ", ptr " + slot2)
    ret make_llv(res, rts)
end

func sig_is_extern(s &: sm.Sema, a &: at.Ast, sig: int): bool:
    ret sig != 0 and sm.SigAt(s, sig).decl != 0 and at.Get(a, sm.SigAt(s, sig).decl).is_extern
end

func ex_needs_abi(v &: Lv, s &: sm.Sema, a &: at.Ast, sig: int): bool:
    if ex_ret(v, s, a, sig).mode != EXM_NONE:
        ret true
    end
    repeat sm.SigAt(s, sig).params.len() in j:
        if not param_is_ref(s, a, sig, j) and ex_param(v, s, a, sig, j).mode != EXM_NONE:
            ret true
        end
    end
    ret false
end

func ex_call_cc(v &: Lv, s &: sm.Sema, a &: at.Ast, sig: int, fname: str): str:
    cc := StdcallCc(v, fname)
    if str.Len(cc) > 0 or not ex_needs_abi(v, s, a, sig):
        ret cc
    end
    ret " ccc"
end

func ex_thunk(v &: Lv, s &: sm.Sema, a &: at.Ast, sig: int, target: str, name: str, local: bool):
    sg := sm.SigAt(s, sig)
    rts := sm.ToString(s, sg.ret_type)
    lrt := ty_of(v, s, a, rts)
    rex := ex_ret(v, s, a, sig)
    mut hd := co.SbNew()
    mut body := co.SbNew()
    mut ab := co.SbNew()
    mut outer := lrt
    if rex.mode != EXM_NONE:
        outer = ex_ret_ty(rex)
    end
    co.SbPuts(hd, "define " + (local ? "internal " : "") + "ccc " + outer + " " + gsym(name) + "(")
    mut first := true
    if rex.mode == EXM_BYVAL or rex.mode == EXM_COPY:
        co.SbPuts(hd, ex_sret_param(rex, lrt) + " %sret")
        first = false
    end
    repeat sg.params.len() in j:
        idx := co.I64Toa(j as i64)
        pts := sm.ToString(s, sg.params.get(j))
        lty := ty_of(v, s, a, pts)
        if not first:
            co.SbPuts(hd, ", ")
        end
        first = false
        if j > 0:
            co.SbPuts(ab, ", ")
        end
        if param_is_ref(s, a, sig, j):
            co.SbPuts(hd, "ptr %p" + idx)
            co.SbPuts(ab, "ptr noundef nonnull %p" + idx)
            continue
        end
        e := ex_param(v, s, a, sig, j)
        if e.mode == EXM_NONE:
            co.SbPuts(hd, (str.Equals(lty, "i1") ? "i1 zeroext" : lty) + " %p" + idx)
            co.SbPuts(ab, lty + " %p" + idx)
            continue
        end
        if e.mode == EXM_REGS:
            co.SbPuts(body, "  %s" + idx + " = alloca [" + co.I64Toa(ex_align_up(e.size, 16) as i64) + " x i8], align 16\n")
            repeat e.pieces.len() in k:
                pn := "%p" + idx + "." + co.I64Toa(k as i64)
                if k > 0:
                    co.SbPuts(hd, ", ")
                end
                co.SbPuts(hd, e.pieces.get(k) + " " + pn)
                mut at_slot := "%s" + idx
                if e.offs.get(k) != 0:
                    at_slot = "%g" + idx + "." + co.I64Toa(k as i64)
                    co.SbPuts(body, "  " + at_slot + " = getelementptr i8, ptr %s" + idx + ", i64 " + co.I64Toa(e.offs.get(k) as i64) + "\n")
                end
                co.SbPuts(body, "  store " + e.pieces.get(k) + " " + pn + ", ptr " + at_slot + "\n")
            end
            co.SbPuts(body, "  %v" + idx + " = load " + lty + ", ptr %s" + idx + "\n")
        else:
            co.SbPuts(hd, ex_param_text(e, lty) + " %p" + idx)
            co.SbPuts(body, "  %v" + idx + " = load " + lty + ", ptr %p" + idx + "\n")
        end
        co.SbPuts(ab, lty + " %v" + idx)
    end
    co.SbPuts(hd, ") nounwind")
    if v.freestanding:
        co.SbPuts(hd, " \"no-builtins\"")
    end
    co.SbPuts(hd, " {\nentry:\n")
    argsx := co.SbCstr(ab)
    if str.Equals(lrt, "void"):
        co.SbPuts(body, "  call void " + gsym(target) + "(" + argsx + ")\n  ret void\n")
    else:
        co.SbPuts(body, "  %r = call " + lrt + " " + gsym(target) + "(" + argsx + ")\n")
        if rex.mode == EXM_NONE:
            co.SbPuts(body, "  ret " + lrt + " %r\n")
        else rex.mode == EXM_REGS:
            co.SbPuts(body, "  %rs = alloca [" + co.I64Toa(ex_align_up(rex.size, 16) as i64) + " x i8], align 16\n")
            co.SbPuts(body, "  store " + lrt + " %r, ptr %rs\n")
            co.SbPuts(body, "  %x = load " + outer + ", ptr %rs\n  ret " + outer + " %x\n")
        else:
            co.SbPuts(body, "  store " + lrt + " %r, ptr %sret\n  ret void\n")
        end
    end
    out_hg(v, co.SbCstr(hd) + co.SbCstr(body) + "}\n\n")
    co.SbFree(hd)
    co.SbFree(body)
    co.SbFree(ab)
end

func ex_addr_symbol(v &: Lv, s &: sm.Sema, a &: at.Ast, sig: int, fname: str): str:
    if not ex_needs_abi(v, s, a, sig):
        ret fname
    end
    name := "salam_cabi." + fname
    each done in v.stdthunks:
        if str.Equals(done, name):
            ret name
        end
    end
    v.stdthunks.push(name)
    ex_thunk(v, s, a, sig, fname, name, true)
    ret name
end
