package llvmgen

import str
import at "../ast.salam"
import sm "../semantic/semantic.salam"

func emit_defers_from(v &: Lv, s &: sm.Sema, a &: at.Ast, mark: int):
    mut i := v.defers.len()
    until i > mark:
        lv_stmt(v, s, a, v.defers.get(i - 1))
        i -= 1
    end
end

func emit_defers(v &: Lv, s &: sm.Sema, a &: at.Ast):
    emit_defers_from(v, s, a, 0)
end

func defers_trunc(v &: Lv, mark: int):
    until v.defers.len() > mark:
        _dropped := v.defers.pop()
    end
end

func emit_loop_exit_defers(v &: Lv, s &: sm.Sema, a &: at.Ast):
    if v.nloop > 0:
        emit_defers_from(v, s, a, v.loop_dmark.get(v.nloop - 1))
    end
end

func emit_return(v &: Lv, s &: sm.Sema, a &: at.Ast, value: int):
    if str.Len(v.match_result_ptr) > 0:
        if value != 0:
            val := conv(v, s, a, lv_expr(v, s, a, value), v.match_result_ts)
            emit(
                v, "store " + ty_of(v, s, a, v.match_result_ts) + " " + val + ", ptr " + v.match_result_ptr
            )
        end
        emit_term(v, "br label %" + v.match_merge_block)
        ret
    end
    if v.is_main:
        mut val := ""
        if value != 0:
            val = conv(v, s, a, lv_expr(v, s, a, value), "i32")
        end
        emit_defers(v, s, a)
        if v.single_threaded && !v.freestanding:
            need(v, LV_H_OUTBUF)
            emit(v, "call void @salam_out_flush()")
        end
        if value != 0:
            emit_term(v, "ret i32 " + val)
        else:
            emit_term(v, "ret i32 0")
        end
        ret
    end
    if str.Len(v.ret_ts) == 0 || str.Equals(v.ret_ts, "void"):
        emit_defers(v, s, a)
        emit_term(v, "ret void")
        ret
    end
    if value == 0:
        emit_defers(v, s, a)
        emit_term(v, "ret " + ty_of(v, s, a, v.ret_ts) + " " + zero_of(s, v.ret_ts))
        ret
    end
    val2 := conv(v, s, a, lv_expr(v, s, a, value), v.ret_ts)
    emit_defers(v, s, a)
    emit_term(v, "ret " + ty_of(v, s, a, v.ret_ts) + " " + val2)
end
