package llvmgen

import str
import at "../ast.salam"
import sm "../semantic/semantic.salam"

// ===== codegen_llvm_stmt.c (stage A slice - B must NOT re-port) =====

// ll_emit_defers_from - `defer` is scoped to the block it is written in: every
// nested block records the defer-stack depth it started at and replays anything
// registered above that mark on the way out, so a defer naming a block-local is
// lowered while that local's alloca is still a live name. `ret` replays the
// whole stack. See the long note in codegen/codegen_stmt.salam.
func emit_defers_from(v &: Lv, s &: sm.Sema, a &: at.Ast, mark: int):
    mut i := v.defers.len()
    until i > mark:
        lv_stmt(v, s, a, v.defers.get(i - 1))
        i -= 1
    end
end

// ll_emit_defers - LIFO defer replay (body statements come from lv_stmt).
func emit_defers(v &: Lv, s &: sm.Sema, a &: at.Ast):
    emit_defers_from(v, s, a, 0)
end

func defers_trunc(v &: Lv, mark: int):
    until v.defers.len() > mark:
        _dropped := v.defers.pop()
    end
end

// break/continue jump over the end of the loop body, so they run what the body
// registered before branching. lv_stmt is a no-op once the block has a
// terminator, so a body that ends in `ret` never emits these twice.
func emit_loop_exit_defers(v &: Lv, s &: sm.Sema, a &: at.Ast):
    if v.nloop > 0:
        emit_defers_from(v, s, a, v.loop_dmark.get(v.nloop - 1))
    end
end

// ll_emit_return
func emit_return(v &: Lv, s &: sm.Sema, a &: at.Ast, value: int):
    if str.Len(v.match_result_ptr) > 0:
        if value != 0:
            val := conv(v, s, a, lv_expr(v, s, a, value), v.match_result_ts)
            emit(
                v, "store " + ty_of(v, s, a, v.match_result_ts) + " " + val + ", ptr " + v.match_result_ptr
            )
        end
        emit_term(v, "br label %" + v.match_merge_block)
        ret
    end
    if v.is_main:
        mut val := ""
        if value != 0:
            val = conv(v, s, a, lv_expr(v, s, a, value), "i32")
        end
        emit_defers(v, s, a)
        // Flush the print buffer here rather than trusting the
        // llvm.global_dtors entry emit_outbuf registers. Whether that
        // destructor runs depends on the link - static musl through
        // in-process lld dropped it, and every literal-only println in the
        // program vanished with it while printf-formatted lines still showed
        // up. Returning from main is the one exit path codegen owns. Gated
        // the same way the buffer itself is - a Windows target never buffers
        // and has no `write` for the helper to call.
        if v.single_threaded:
            emit(v, "call void @salam_out_flush()")
        end
        if value != 0:
            emit_term(v, "ret i32 " + val)
        else:
            emit_term(v, "ret i32 0")
        end
        ret
    end
    if str.Len(v.ret_ts) == 0 || str.Equals(v.ret_ts, "void"):
        emit_defers(v, s, a)
        emit_term(v, "ret void")
        ret
    end
    // Falling off the end of a value-returning function (or a bare `ret`
    // inside one) leaves no expression to lower. lv_expr(0) hands back the
    // i32 literal 0, which is a parse error the moment the return type is an
    // aggregate - `ret %struct.xml__XMLNode 0`. Emit the type's own zero.
    if value == 0:
        emit_defers(v, s, a)
        emit_term(v, "ret " + ty_of(v, s, a, v.ret_ts) + " " + zero_of(s, v.ret_ts))
        ret
    end
    val2 := conv(v, s, a, lv_expr(v, s, a, value), v.ret_ts)
    emit_defers(v, s, a)
    emit_term(v, "ret " + ty_of(v, s, a, v.ret_ts) + " " + val2)
end
