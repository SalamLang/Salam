package llvmgen

import str
import os
import pth "../sal_path.salam"
import sm "../semantic/semantic.salam"
import lb "../llvm_bridge.salam"

func nt_host_lib_dir(): str:
    mut p := ""
    if !sm.FindBundledTool("clang", p):
        if !sm.FindPathTool("clang", p):
            ret ""
        end
    end
    bin := pth.PathDir(p)
    if str.Len(bin) == 0:
        ret ""
    end
    lib := pth.PathJoin(pth.PathDir(bin), "lib")
    if !os.Exists(lib):
        ret ""
    end
    ret nt_to_tool_path(lib)
end

func nt_opt_flag(l: int): str:
    if l == LV_OPT_O0:
        ret "-O0"
    end
    if l == LV_OPT_O1:
        ret "-O1"
    end
    if l == LV_OPT_O2:
        ret "-O2"
    end
    if l == LV_OPT_O3:
        ret "-O3"
    end
    if l == LV_OPT_OS:
        ret "-Os"
    end
    if l == LV_OPT_OZ:
        ret "-Oz"
    end
    ret "-O0"
end

func nt_triple_is_windows(t: str): bool:
    if str.Len(t) == 0:
        ret false
    end
    ret str.Contains(t, "windows") || str.Contains(t, "mingw") || str.Contains(t, "win32")
end

func nt_triple_is_wasm(t: str): bool:
    ret str.Len(t) > 0 && str.Contains(t, "wasm")
end

func nt_shell_arg(v: str): str:
    if SALAM_OS_WINDOWS:
        mut out := `"`
        n := str.Len(v)
        mut i := 0
        until i < n:
            mut nbs := 0
            until i < n && byte_at(v, i) == 92:
                nbs += 1
                i += 1
            end
            if i == n:
                mut k := 0
                until k < nbs * 2:
                    out += `\`
                    k += 1
                end
            else byte_at(v, i) == 34:
                mut k2 := 0
                until k2 < nbs * 2 + 1:
                    out += `\`
                    k2 += 1
                end
                out += `"`
                i += 1
            else:
                mut k3 := 0
                until k3 < nbs:
                    out += `\`
                    k3 += 1
                end
                out += str.Substr(v, i, 1)
                i += 1
            end
        end
        out += `"`
        ret out
    else:
        mut out2 := "'"
        n2 := str.Len(v)
        mut j := 0
        until j < n2:
            if byte_at(v, j) == 39:
                out2 += "'\\''"
            else:
                out2 += str.Substr(v, j, 1)
            end
            j += 1
        end
        out2 += "'"
        ret out2
    end
end

func nt_bat_percent_escape(s: str): str:
    ret str.Replace(s, "%", "%%")
end

func nt_win_native_cc(out &: str): bool:
    if SALAM_OS_WINDOWS:
        if sm.FindBundledTool("clang", out):
            ret true
        end
        ret sm.FindPathTool("clang", out)
    else:
        ret false
    end
end

func nt_to_tool_path(host: str): str:
    if SALAM_OS_WINDOWS:
        mut probe := ""
        if nt_win_native_cc(probe):
            ret host
        end
        n := str.Len(host)
        if n >= 2 && is_alpha_b(byte_at(host, 0)) && byte_at(host, 1) == 58:
            mut out := "/mnt/" + str.Lower(str.Substr(host, 0, 1))
            mut i := 2
            until i < n:
                c := byte_at(host, i)
                out += (c == 92) ? "/" : str.Substr(host, i, 1)
                i += 1
            end
            ret out
        end
        ret host
    else:
        ret host
    end
end

func nt_resolve_tool(bundled: str, fallback: str): str:
    mut out := ""
    if sm.FindBundledTool(bundled, out):
        ret nt_to_tool_path(out)
    end
    if str.Len(fallback) > 0 && sm.FindPathTool(fallback, out):
        ret out
    end
    if sm.FindPathTool(bundled, out):
        ret out
    end
    ret fallback
end

func nt_has_path_char(spec: str): bool:
    ret str.Contains(spec, "/") || str.Contains(spec, "\\") || str.Contains(spec, ".")
end

func nt_emit_llvm_link(spec: str, kind: str): str:
    if str.Len(spec) == 0:
        ret " -l" + nt_shell_arg(spec)
    end
    framework := str.Equals(kind, "framework")
    is_static := str.Equals(kind, "static")
    if framework:
        ret " -framework " + nt_shell_arg(spec)
    end
    if byte_at(spec, 0) == 45 || nt_has_path_char(spec):
        ret " " + nt_shell_arg(spec)
    end
    if is_static:
        ret " -l:lib" + nt_shell_arg(spec) + ".a"
    end
    ret " -l" + nt_shell_arg(spec)
end

func nt_emit_tool_cmd(opts: Options): str:
    clang_tool := nt_resolve_tool("clang", "clang-22")
    opt_tool := nt_resolve_tool("opt", "opt-22")
    lli_tool := nt_resolve_tool("lli", "lli-22")
    o_flag := nt_opt_flag(opts.opt_level)
    triple := opts.target_triple

    mut out := ""
    if opts.verify_module:
        out += `"` + opt_tool + "\" -passes=verify -disable-output \"$IN\"\n"
    end

    if opts.output_mode == LV_OUT_ASM:
        out += `"` + clang_tool + `" ` + o_flag
        if str.Len(triple) > 0:
            out += " --target=" + triple
        else opts.native_cpu:
            out += " -march=native"
        end
        out += " -S \"$IN\" -o \"$OUT\"\n"
    else opts.output_mode == LV_OUT_OBJ:
        out += `"` + clang_tool + `" ` + o_flag
        if str.Len(triple) > 0:
            out += " --target=" + triple
        else opts.native_cpu:
            out += " -march=native"
        end
        out += " -c \"$IN\" -o \"$OUT\"\n"
    else opts.output_mode == LV_OUT_BITCODE:
        out += `"` + opt_tool + `" ` + o_flag + " \"$IN\" -o \"$OUT\"\n"
    else opts.output_mode == LV_OUT_EXEC:
        win := nt_triple_is_windows(triple)
        wasm := nt_triple_is_wasm(triple)
        out += `"` + clang_tool + `" ` + o_flag
        if str.Len(triple) > 0:
            out += " --target=" + triple
        else opts.native_cpu:
            out += " -march=native"
        end
        if opts.debug_info:
            out += " -g"
        end
        if str.Len(opts.sysroot) > 0:
            out += ` --sysroot="$SYSROOT"`
        end
        if win:
            out += " -fuse-ld=lld"
        end
        repeat opts.lib_paths.len() in lp2:
            out += ` -L"` + opts.lib_paths.get(lp2) + `"`
        end
        out += ` "$IN"`
        repeat opts.link_libs.len() in li:
            spec := opts.link_libs.get(li)
            mut kind := ""
            if li < opts.link_kinds.len():
                kind = opts.link_kinds.get(li)
            end
            out += nt_emit_llvm_link(spec, kind)
        end
        if !win && !wasm:
            out += " -lm"
        end
        out += " -o \"$OUT\"\n"
    else opts.output_mode == LV_OUT_JIT:
        if opts.opt_level != LV_OPT_O0:
            out += `"` + opt_tool + `" ` + o_flag + ` "$IN" -o - | "` + lli_tool + "\" -\n"
        else:
            out += `"` + lli_tool + "\" \"$IN\"\n"
        end
    else opts.output_mode == LV_OUT_IR:
        if opts.opt_level != LV_OPT_O0:
            out += `"` + opt_tool + `" ` + o_flag + " -S \"$IN\" -o \"$IN\"\n"
        else !opts.verify_module:
            out += "true\n"
        end
    end
    ret out
end

func nt_host_triple(): str:
    embedded := lb.HostTriple()
    if str.Len(embedded) > 0:
        ret embedded
    end
    tool := nt_resolve_tool("clang", "clang-22")
    r := os.RunCapture(`"` + tool + `" -dumpmachine 2>/dev/null`)
    if r.code != 0:
        ret ""
    end
    ret str.Trim(r.out)
end

func nt_host_is_glibc(): bool:
    if SALAM_OS_LINUX:
        t := nt_host_triple()
        if str.Len(t) == 0:
            ret false
        end
        ret target_is_glibc_of(t)
    else:
        ret false
    end
end

func nt_probe_tool(tool: str): bool:
    mut cmd := `"` + tool + `" --version`
    if SALAM_OS_WINDOWS:
        cmd += " >NUL 2>&1"
    else:
        cmd += " >/dev/null 2>&1"
    end
    ret os.Run(cmd) == 0
end
