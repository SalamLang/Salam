pub struct Options:
    pub opt_level: int = 0
    pub debug_info: bool = false
    pub verify_module: bool = false
    pub native_cpu: bool = false
    pub release: bool = false
    pub fp_contract: bool = false
    pub output_mode: int = 0
    pub output_file: str = ""
    pub target_triple: str = ""
    pub link_libs: Vector<str> = Vector {}
    pub link_kinds: Vector<str> = Vector {}
    pub nlink: int = 0
    pub sysroot: str = ""
    pub lib_paths: Vector<str> = Vector {}
end

pub struct Output:
    pub module_name: str = ""
    pub ll_src: str = ""
    pub ok: bool = false
    pub error: str = ""
end

pub struct Llv:
    pub ref: str = ""
    pub ts: str = ""
end

pub struct LvAddr:
    pub ptr: str = ""
    pub ts: str = ""
    pub tbaa: str = ""
end

pub struct LvVar:
    pub name: str = ""
    pub ptr: str = ""
    pub ts: str = ""
    pub pkg: str = ""
    pub init: int = 0
end

pub struct LvStr:
    pub bytes: str = ""
    pub len: int = 0
    pub hash: u64 = 0 as u64
    pub gref: str = ""
end

pub struct Lv:
    pub log: lg.Logger = lg.New(2, false)
    pub module: str = ""
    pub entry: str = ""
    pub bg: str.StringBuilder = str.NewBuilder()
    pub bb: str.StringBuilder = str.NewBuilder()
    pub ba: str.StringBuilder = str.NewBuilder()
    pub bhg: str.StringBuilder = str.NewBuilder()
    pub bmeta: str.StringBuilder = str.NewBuilder()
    pub in_fn: bool = false
    pub tmp: int = 0
    pub lbl: int = 0
    pub term: bool = false
    pub locals: Vector<LvVar> = Vector {}
    pub strings: Vector<LvStr> = Vector {}
    pub ret_ts: str = ""
    pub is_main: bool = false
    pub brk: Vector<str> = Vector {}
    pub cont: Vector<str> = Vector {}
    pub loop_dmark: Vector<int> = Vector {}
    pub nloop: int = 0
    pub defers: Vector<int> = Vector {}
    pub self_ts: str = ""
    pub this_ref: str = ""
    pub self_byval: bool = false
    pub globals: Vector<LvVar> = Vector {}
    pub gdefer: Vector<int> = Vector {}
    pub extern_names: Vector<str> = Vector {}
    pub pkg_scope: int = 0
    pub sig_ix: Vector<int> = Vector {}
    pub emitted: Vector<str> = Vector {}
    pub pkg_touched: Vector<int> = Vector {}
    pub cur_lambda: int = 0
    pub env_ref: str = ""
    pub env_ty: str = ""
    pub lam_n: int = 0
    pub ok: bool = false
    pub first_error: str = ""
    pub debug: bool = false
    pub meta_n: int = 0
    pub tbaa_char: str = ""
    pub tbaa_data_sfx: str = ""
    pub tbaa_ptr_sfx: str = ""
    pub di_file: str = ""
    pub di_cu: str = ""
    pub di_subty: str = ""
    pub cur_sp: str = ""
    pub cur_dbg: str = ""
    pub di_flag_dwarf: str = ""
    pub di_flag_debug: str = ""
    pub src_file: str = ""
    pub src_dir: str = ""
    pub triple: str = ""
    pub libc_glibc: bool = false
    pub freestanding: bool = false
    pub usize: str = ""
    pub ptr_bits: int = 0
    pub optsize: bool = false
    pub minsize: bool = false
    pub nowrap: bool = false
    pub fp_contract: bool = false
    pub single_threaded: bool = false
    pub jit: bool = false
    pub hneed: Vector<bool> = Vector {}
    pub match_result_ptr: str = ""
    pub match_result_ts: str = ""
    pub match_merge_block: str = ""
end

inline func byte_at(sx: str, i: int): int: ret co.ByteAt(sx, i) end

func is_digit_b(c: int): bool:
    ret c >= 48 && c <= 57
end

func is_alnum_b(c: int): bool:
    ret (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122)
end

func is_alpha_b(c: int): bool:
    ret (c >= 65 && c <= 90) || (c >= 97 && c <= 122)
end

func hex2_lower(c: int): str:
    d := "0123456789abcdef"
    ret str.Substr(d, (c / 16) % 16, 1) + str.Substr(d, c % 16, 1)
end

func hex2_upper(c: int): str:
    d := "0123456789ABCDEF"
    ret str.Substr(d, (c / 16) % 16, 1) + str.Substr(d, c % 16, 1)
end

func idx_byte(sx: str, want: int): int:
    n := str.Len(sx)
    mut i := 0
    until i < n:
        if byte_at(sx, i) == want:
            ret i
        end
        i += 1
    end
    ret 0 - 1
end

func last_byte(sx: str, want: int): int:
    mut i := str.Len(sx) - 1
    until i >= 0:
        if byte_at(sx, i) == want:
            ret i
        end
        i -= 1
    end
    ret 0 - 1
end

func clamp255(msg: str): str:
    if str.Len(msg) > 255:
        ret str.Substr(msg, 0, 255)
    end
    ret msg
end

func out_g(v &: Lv, sx: str):
    co.SbPuts(v.bg, sx)
end

func out_b(v &: Lv, sx: str):
    if v.in_fn:
        co.SbPuts(v.bb, sx)
    else:
        co.SbPuts(v.bg, sx)
    end
end

func out_hg(v &: Lv, sx: str):
    co.SbPuts(v.bhg, sx)
end

func out_meta(v &: Lv, sx: str):
    co.SbPuts(v.bmeta, sx)
end

func out_al(v &: Lv, sx: str):
    if v.in_fn:
        co.SbPuts(v.ba, sx)
    else:
        out_b(v, sx)
    end
end

func new_lv0(): Lv:
    mut v := Lv {}
    v.locals = Vector {} as Vector<LvVar>
    v.strings = Vector {} as Vector<LvStr>
    v.brk = Vector {} as Vector<str>
    v.cont = Vector {} as Vector<str>
    v.loop_dmark = Vector {} as Vector<int>
    v.defers = Vector {} as Vector<int>
    v.globals = Vector {} as Vector<LvVar>
    v.gdefer = Vector {} as Vector<int>
    v.extern_names = Vector {} as Vector<str>
    v.emitted = Vector {} as Vector<str>
    v.pkg_touched = Vector {} as Vector<int>
    v.hneed = Vector {} as Vector<bool>
    repeat LV_H_COUNT with hi:
        _hi := hi
        v.hneed.push(false)
    end
    ret v
end

func free_lv(v &: Lv):
    str.BufFree(v.bg)
    str.BufFree(v.bb)
    str.BufFree(v.ba)
    str.BufFree(v.bhg)
    str.BufFree(v.bmeta)
    v.locals.free()
    v.strings.free()
    v.brk.free()
    v.cont.free()
    v.loop_dmark.free()
    v.defers.free()
    v.globals.free()
    v.gdefer.free()
    v.extern_names.free()
    v.emitted.free()
    v.pkg_touched.free()
    v.sig_ix.free()
    v.hneed.free()
end

func ts_is_string_enum(s &: sm.Sema, ts: str): bool:
    if str.Len(ts) == 0:
        ret false
    end
    esym := sm.LookupLocal(s, s.global, ts)
    ret esym != 0 && sm.SymAt(s, esym).kind == sm.SYM_ENUM && sm.SymAt(s, esym).enum_val_kind == tok.TV_STRING
end

func is_str(s &: sm.Sema, ts: str): bool:
    ret str.Equals(ts, "str") || str.Equals(ts, "uchar") || ts_is_string_enum(s, ts)
end

func is_bool(ts: str): bool:
    ret str.Equals(ts, "bool")
end

func is_float(ts: str): bool:
    ret str.Equals(ts, "f32") || str.Equals(ts, "f64")
end

func is_ptr_ts(ts: str): bool:
    n := str.Len(ts)
    ret n > 0 && byte_at(ts, n - 1) == 42
end

func is_array_ts(ts: str): bool:
    n := str.Len(ts)
    if n == 0 || byte_at(ts, n - 1) != 93:
        ret false
    end
    ret str.StartsWith(ts, "slice<") == false
end

func poison(ts: str): Llv:
    mut r := Llv {}
    r.ref = "0"
    r.ts = str.Len(ts) > 0 ? ts : "i32"
    ret r
end

func make_llv(ref2: str, ts: str): Llv:
    mut r := Llv {}
    r.ref = ref2
    r.ts = ts
    ret r
end
