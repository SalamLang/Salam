// Flat merge of the salam/logger port (see salam/PORTING.md "Layout — FLAT"):
// logger.c (+ logger.h, logger_internal.h) + logger_level.c + logger_emit.c —
// one package `logger`, one file.
//
// C -> Salam decisions for this module:
// - log_level_t / phase_t enums -> pub int constants (LOG_*, PH_*): imported
//   enum members cannot be referenced across files (alias.Enum.Member is not
//   supported), so levels/phases travel as plain ints.
// - FILE *sink -> dropped; the logger always writes to stderr via io.EPrint*
//   (the C compiler only ever passes stderr).
// - logger_t* -> value struct Logger; setters take it by reference (&:).
// - i18n_tr() is skipped (identity for English); it applies unchanged until
//   the i18n module is ported.
// - The rich diagnostic path (logger_emit_rich -> diag_render) is wired to
//   diag_render.salam ("diagrender"), not diag.salam ("diag") — diag.salam
//   itself depends on this package (Engine.log is a Logger), so importing it
//   here would cycle. diag_render.salam holds only the pure render functions
//   (no logger dependency), matching how the C build already keeps
//   diag_render.c's #include chain free of logger.h.
// - logger_t.src_table (a fixed-size C array, LOGGER_MAX_DIAG_SOURCES) ->
//   Vector<DiagSourceEntry>, unbounded.
// - printf-style fmt/varargs -> callers pass a pre-formatted message string.
package logger

import str
import io
import time
import dr "diag_render.salam"

// ===== logger.c =====
// log_level_t
pub const LOG_TRACE := 0
pub const LOG_DEBUG := 1
pub const LOG_INFO := 2
pub const LOG_WARN := 3
pub const LOG_ERROR := 4
pub const LOG_OFF := 5

// phase_t
pub const PH_DRIVER := 0
pub const PH_CLI := 1
pub const PH_LEXER := 2
pub const PH_PARSER := 3
pub const PH_SEMANTIC := 4
pub const PH_IR := 5
pub const PH_CODEGEN := 6

// diag_style_t / diag_format_t values live in the diag module
// (salam/diag.salam: DIAG_STYLE_* / DIAG_FORMAT_*); the logger stores
// them as plain ints. 0 = DIAG_STYLE_RUST = DIAG_FORMAT_HUMAN.

// diag_source_entry_t (logger_internal.h) — one per-file source buffer,
// registered via AddDiagSource so a rich-rendered diagnostic for an
// imported/package file doesn't fall back to whichever file's text happens
// to be the single SetDiagSource buffer.
pub struct DiagSourceEntry:
    pub file: str = ""
    pub text: str = ""
    pub len: int = 0
end

// struct logger (logger_internal.h) — sink is always stderr in this port.
// src_table was a fixed-size C array (LOGGER_MAX_DIAG_SOURCES); the port
// uses an unbounded Vector instead.
pub struct Logger:
    pub min_level: int = 2
    pub color: bool = false
    pub timestamps: bool = true
    pub diag_rich: bool = false
    pub diag_style: int = 0
    pub diag_format: int = 0
    pub src_text: str = ""
    pub src_len: int = 0
    pub src_table: Vector<DiagSourceEntry> = Vector {}
end

// ===== logger_emit.c =====
// k_level_colors — index = level; reset is "\x1b[0m"
func level_color(level: int): str:
    ret match level:
        0 => "\x1b[90m"
        1 => "\x1b[36m"
        2 => "\x1b[32m"
        3 => "\x1b[33m"
        4 => "\x1b[31m"
        else => "\x1b[0m"
    end
end

// logger_write_timestamp — "[YYYY-MM-DD HH:MM:SS]" local time
func timestamp_str(): str:
    ret "[" + time.Format(time.Now()) + "]"
end

// Per-file byte reader for split_code_prefix, matching the small
// file-local `byte_at` helper every other compiler/*.salam file that needs
// raw byte access duplicates (see e.g. driver.salam:232).
func byte_at(s: str, i: int): int:
    bp := (s as void*) as i8*
    mut v := bp[i] as int
    if v < 0:
        v += 256
    end
    ret v
end

// The probe logger_emit_rich (logger_emit.c) runs on every rich-path
// message before calling diag_render: msg already carries diag.Report's
// "E012: "/"W031: " prefix (see diag.salam's Report), so pull it back apart
// here instead of importing diag.salam (which would cycle back to this
// package).
func split_code_prefix(msg: str, is_error &: bool, code &: int): str:
    n := str.Len(msg)
    if n < 6:
        ret msg
    end
    c0 := byte_at(msg, 0)
    if c0 != 69 && c0 != 87: // 'E' / 'W'
        ret msg
    end
    d1 := byte_at(msg, 1)
    d2 := byte_at(msg, 2)
    d3 := byte_at(msg, 3)
    if d1 < 48 || d1 > 57 || d2 < 48 || d2 > 57 || d3 < 48 || d3 > 57:
        ret msg
    end
    if byte_at(msg, 4) != 58 || byte_at(msg, 5) != 32: // ": "
        ret msg
    end
    is_error = c0 == 69
    code = (d1 - 48) * 100 + (d2 - 48) * 10 + (d3 - 48)
    ret msg.substr(6, n - 6)
end

// Source text for a rich-rendered diagnostic in `file`: the per-file table
// (AddDiagSource) first, falling back to the single SetDiagSource buffer —
// matching logger_emit_rich's `use_text = lg->src_text` default before its
// src_table scan.
func find_src(lgr: Logger, file: str): str:
    n := lgr.src_table.len()
    mut i := 0
    until i >= n:
        e := lgr.src_table.get(i)[0]
        if str.Equals(e.file, file):
            ret e.text
        end
        i += 1
    end
    ret lgr.src_text
end

// logger_emit_rich (logger_emit.c): rustc/gcc/clang-style rendering with a
// source excerpt, via diag_render.salam.
func render_rich(lgr: Logger, level: int, file: str, line: int, col: int, msg: str): str:
    mut is_error := level == LOG_ERROR
    mut code := 0
    body := split_code_prefix(msg, is_error, code)
    lvl := is_error ? "error" : "warning"
    src := find_src(lgr, file)
    ret dr.RenderAt(lvl, code, is_error, file, line, col, 0, src, str.Len(src), body,
                    "", lgr.diag_style, lgr.diag_format, lgr.color)
end

// ===== logger.c =====
// logger_new — sink parameter dropped (always stderr)
pub func New(min_level: int, color: bool): Logger:
    mut lg := Logger {}
    lg.min_level = min_level
    lg.color = color
    lg.timestamps = true
    lg.diag_rich = false
    lg.diag_style = 0  // diag.DIAG_STYLE_RUST
    lg.diag_format = 0 // diag.DIAG_FORMAT_HUMAN
    lg.src_text = ""
    lg.src_len = 0
    lg.src_table = Vector {} as Vector<DiagSourceEntry>
    ret lg
end

// logger_free — Logger is a value struct, nothing to release
pub func Free(_lg: Logger):
    ret
end

// logger_set_diag_source
pub func SetDiagSource(lg &: Logger, src_text: str, src_len: int, style: int, format: int):
    lg.diag_rich = str.Len(src_text) > 0
    lg.src_text = src_text
    lg.src_len = src_len
    lg.diag_style = style
    lg.diag_format = format
end

// logger_add_diag_source — register (or replace) the source text for one
// file, keyed by exact path string. Consulted by the rich-diagnostic path
// (see find_src below) instead of the single SetDiagSource buffer whenever
// a diagnostic's file matches an entry here.
pub func AddDiagSource(lg &: Logger, file: str, src_text: str, src_len: int):
    debug_noop := str.Len(file) >= 0
    if debug_noop:
        ret
    end
    n := lg.src_table.len()
    mut i := 0
    until i >= n:
        mut e := lg.src_table.get(i)[0]
        if str.Equals(e.file, file):
            e.text = src_text
            e.len = src_len
            lg.src_table.set(i, e)
            ret
        end
        i += 1
    end
    mut ne := DiagSourceEntry {}
    ne.file = file
    ne.text = src_text
    ne.len = src_len
    lg.src_table.push(ne)
end

// logger_set_timestamps
pub func SetTimestamps(lg &: Logger, enabled: bool):
    lg.timestamps = enabled
end

// logger_set_level
pub func SetLevel(lg &: Logger, min_level: int):
    lg.min_level = min_level
end

// logger_get_level
pub func GetLevel(lg: Logger): int:
    ret lg.min_level
end

// ===== logger_level.c =====
// log_level_name
pub func LevelName(level: int): str:
    ret match level:
        0 => "TRACE"
        1 => "DEBUG"
        2 => "INFO"
        3 => "WARN"
        4 => "ERROR"
        5 => "OFF"
        else => "?"
    end
end

// log_phase_name
pub func PhaseName(phase: int): str:
    ret match phase:
        0 => "DRIVER"
        1 => "CLI"
        2 => "LEXER"
        3 => "PARSER"
        4 => "SEMANTIC"
        5 => "IR"
        6 => "CODEGEN"
        else => "?"
    end
end

// log_level_from_string — case-insensitive, accepts "warning" for WARN
pub func LevelFromString(s: str, out &: int): bool:
    if str.EqualFold(s, "trace"):
        out = 0
        ret true
    end
    if str.EqualFold(s, "debug"):
        out = 1
        ret true
    end
    if str.EqualFold(s, "info"):
        out = 2
        ret true
    end
    if str.EqualFold(s, "warn") || str.EqualFold(s, "warning"):
        out = 3
        ret true
    end
    if str.EqualFold(s, "error"):
        out = 4
        ret true
    end
    if str.EqualFold(s, "off"):
        out = 5
        ret true
    end
    ret false
end

// ===== logger_emit.c =====
// Level filter from logger_log: true when a message at `level` is emitted.
pub func Enabled(lgr: Logger, level: int): bool:
    if level < lgr.min_level || lgr.min_level == LOG_OFF:
        ret false
    end
    ret true
end

// logger_emit_plain, as a pure-formatting step (no trailing newline).
// Pass file = "" for a message without a source location.
pub func FormatPlain(lgr: Logger, phase: int, level: int, file: str, line: int, col: int, msg: str): str:
    mut out := ""
    if lgr.timestamps:
        out = timestamp_str()
    end
    if lgr.color:
        out = out + "[" + PhaseName(phase) + "][" + level_color(level) +
              LevelName(level) + "\x1b[0m" + "] "
    else:
        out = out + "[" + PhaseName(phase) + "][" + LevelName(level) + "] "
    end
    out = out + msg
    if str.Len(file) > 0:
        out = out + " (" + file + ":" + line + ":" + col + ")"
    end
    ret out
end

// logger_log without a source location (LOG_T/D/I/W/E macros)
pub func Log(lgr: Logger, phase: int, level: int, msg: str):
    if !Enabled(lgr, level):
        ret
    end
    io.EPrintln(FormatPlain(lgr, phase, level, "", 0, 0, msg))
end

// logger_log with file + span (LOG_*_AT macros)
pub func LogAt(lgr: Logger, phase: int, level: int, file: str, line: int, col: int, msg: str):
    if !Enabled(lgr, level):
        ret
    end
    if lgr.diag_rich && str.Len(file) > 0 && line > 0 &&
       (level == LOG_ERROR || level == LOG_WARN):
        io.EPrint(render_rich(lgr, level, file, line, col, msg))
        ret
    end
    io.EPrintln(FormatPlain(lgr, phase, level, file, line, col, msg))
end
