package lsp

import str
import os
import io

include pth "../sal_path.salam"
include co "../sal_core.salam"

func usage(): int:
    io.EPrintln("usage: salam lsp [--stdio] [--stdlib-path=DIR] [--messages=en|fa]")
    io.EPrintln("       salam lsp --analyze REQUEST.json")
    ret 2
end

func resolve_exe(argv0: str): str:
    if os.Exists("/proc/self/exe"):
        ret "/proc/self/exe"
    end
    if str.Contains(argv0, "/") and not pth.PathIsAbs(argv0):
        ret pth.PathJoin(os.Cwd(), argv0)
    end
    ret argv0
end

pub func Main(args: Vector<str>): int:
    mut i := 2
    n := args.len()
    until i < n:
        a := args.get(i)
        if str.Equals(a, "--analyze"):
            if i + 1 >= n:
                ret usage()
            end
            ret AnalyzeMain(args.get(i + 1))
        else str.Equals(a, "--stdio"):
            i += 1
            continue
        else str.StartsWith(a, "--stdlib-path="):
            g_stdlib = str.Substr(a, 14, str.Len(a) - 14)
        else str.StartsWith(a, "--messages="):
            g_messages = str.Substr(a, 11, str.Len(a) - 11)
        else str.Equals(a, "--version"):
            println "salam-lsp " + co.VERSION
            ret 0
        else str.Equals(a, "--help") or str.Equals(a, "-h"):
            _u := usage()
            ret 0
        else:
            ret usage()
        end
        i += 1
    end
    g_exe = resolve_exe(args.get(0))
    ret serve()
end
