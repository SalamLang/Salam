const DEBOUNCE_MS := 200

mut g_docs := Vector {} as Vector<Doc>
mut g_exe := "salam"
mut g_stdlib := ""
mut g_messages := "en"
mut g_defines := Vector {} as Vector<str>
mut g_fix_order := false
mut g_shutdown := false
mut g_req_path := ""
mut g_out_path := ""
mut g_analyses := 0
mut g_job_on := false
mut g_job_uri := ""
mut g_job_proc := process.Process {}
mut g_pending := Vector {} as Vector<Pending>
mut g_job_index := ""
mut g_client_name := ""
mut g_pull_diags := false

struct Doc:
    pub uri: str = ""
    pub path: str = ""
    pub text: str = ""
    pub version: int = 0
    pub dirty: bool = true
    pub open: bool = true
    pub has_snap: bool = false
    pub snap: value.Value = value.Value {}
end

struct Pending:
    pub id: str = ""
    pub method: str = ""
    pub uri: str = ""
    pub params: value.Value = value.Value {}
end

struct Hit:
    pub ok: bool = false
    pub decl: int = 0 - 1
    pub line: int = 0
    pub ch: int = 0
    pub eline: int = 0
    pub ech: int = 0
    pub ty: str = ""
end

func obj(v: value.Value, key: str): value.Value:
    if value.IsObject(v) and value.ObjectHas(v, key):
        ret value.ObjectGet(v, key)
    end
    ret value.ValueNull()
end

func arr_int(v: value.Value, i: int): int:
    if value.IsArray(v) and i < value.ArrayLen(v):
        ret value.AsInt(value.ArrayGet(v, i)) as int
    end
    ret 0
end

func hexval(c: int): int:
    if c >= 48 and c <= 57:
        ret c - 48
    else c >= 97 and c <= 102:
        ret c - 87
    else c >= 65 and c <= 70:
        ret c - 55
    end
    ret 0 - 1
end

func uri_to_path(uri: str): str:
    mut s := uri
    if str.StartsWith(s, "file://"):
        s = str.Substr(s, 7, str.Len(s) - 7)
    end
    mut sb := str.NewBuilder()
    n := str.Len(s)
    mut i := 0
    until i < n:
        c := byte_at(s, i)
        if c == 37 and i + 2 < n and hexval(byte_at(s, i + 1)) >= 0 and hexval(byte_at(s, i + 2)) >= 0:
            str.BufAppendChar(sb, hexval(byte_at(s, i + 1)) * 16 + hexval(byte_at(s, i + 2)))
            i += 3
        else:
            str.BufAppendChar(sb, c)
            i += 1
        end
    end
    mut p := str.BufStr(sb)
    str.BufFree(sb)
    if str.Len(p) >= 3 and byte_at(p, 0) == 47 and byte_at(p, 2) == 58:
        p = str.Substr(p, 1, str.Len(p) - 1)
    end
    ret p
end

func path_to_uri(path: str): str:
    mut sb := str.NewBuilder()
    str.BufAppend(sb, "file://")
    if str.Len(path) >= 2 and byte_at(path, 1) == 58:
        str.BufAppendChar(sb, 47)
    end
    n := str.Len(path)
    repeat n in i:
        c := byte_at(path, i)
        if (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 47 or c == 45 or c == 95 or c == 46 or c == 126 or c == 58:
            str.BufAppendChar(sb, c)
        else c == 92:
            str.BufAppendChar(sb, 47)
        else:
            str.BufAppendChar(sb, 37)
            str.BufAppendChar(sb, hexdig(c / 16) >= 97 ? hexdig(c / 16) - 32 : hexdig(c / 16))
            str.BufAppendChar(sb, hexdig(c % 16) >= 97 ? hexdig(c % 16) - 32 : hexdig(c % 16))
        end
    end
    out := str.BufStr(sb)
    str.BufFree(sb)
    ret out
end

func doc_index(uri: str): int:
    repeat g_docs.len() in i:
        if str.Equals(g_docs.get(i).uri, uri):
            ret i
        end
    end
    ret 0 - 1
end

func send_result(id: str, result: str):
    send_message("{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"result\":" + result + "}")
end

func send_error(id: str, code: int, msg: str):
    send_message("{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"error\":{\"code\":" + str.FromInt(code as i64) + ",\"message\":" + jq(msg) + "}}")
end

func send_notify(method: str, params: str):
    send_message("{\"jsonrpc\":\"2.0\",\"method\":" + jq(method) + ",\"params\":" + params + "}")
end

func log_client(level: int, msg: str):
    send_notify("window/logMessage", "{\"type\":" + str.FromInt(level as i64) + ",\"message\":" + jq(msg) + "}")
end

func apply_settings(v: value.Value):
    if not value.IsObject(v):
        ret
    end
    mut s := v
    if value.ObjectHas(v, "salam"):
        s = value.ObjectGet(v, "salam")
    end
    sp := vstr(s, "stdlibPath")
    if str.Len(sp) > 0:
        g_stdlib = sp
    end
    m := vstr(s, "messages")
    if str.Equals(m, "fa") or str.Equals(m, "en"):
        g_messages = m
    end
    if value.ObjectHas(s, "defines"):
        g_defines.clear()
        req_strs(s, "defines", g_defines)
    end
    if value.ObjectHas(s, "formatFixOrder"):
        g_fix_order = vbool(s, "formatFixOrder")
    end
    if value.ObjectHas(s, "index"):
        g_index_on = vbool(s, "index")
    end
    if value.ObjectHas(s, "indexMaxFiles"):
        g_index_max = vint(s, "indexMaxFiles", g_index_max)
    end
end

