    jw_kobj(j, "capabilities")
    jw_str(j, "positionEncoding", "utf-16")
    jw_kobj(j, "textDocumentSync")
    jw_bool(j, "openClose", true)
    jw_int(j, "change", 2)
    jw_kobj(j, "save")
    jw_bool(j, "includeText", false)
    jw_end_obj(j)
    jw_end_obj(j)
    jw_bool(j, "hoverProvider", true)
    jw_bool(j, "definitionProvider", true)
    jw_bool(j, "declarationProvider", true)
    jw_bool(j, "typeDefinitionProvider", true)
    jw_bool(j, "referencesProvider", true)
    jw_bool(j, "documentHighlightProvider", true)
    jw_bool(j, "documentSymbolProvider", true)
    jw_bool(j, "workspaceSymbolProvider", true)
    jw_bool(j, "foldingRangeProvider", true)
    jw_bool(j, "documentFormattingProvider", true)
    jw_bool(j, "documentRangeFormattingProvider", true)
    jw_kobj(j, "documentOnTypeFormattingProvider")
    jw_str(j, "firstTriggerCharacter", "\n")
    jw_end_obj(j)
    jw_kobj(j, "renameProvider")
    jw_bool(j, "prepareProvider", true)
    jw_end_obj(j)
    jw_kobj(j, "completionProvider")
    jw_karr(j, "triggerCharacters")
    jw_vstr(j, ".")
    jw_end_arr(j)
    jw_bool(j, "resolveProvider", false)
    jw_end_obj(j)
    jw_kobj(j, "signatureHelpProvider")
    jw_karr(j, "triggerCharacters")
