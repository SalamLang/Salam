    jw_kobj(j, "codeLensProvider")
    jw_bool(j, "resolveProvider", false)
    jw_end_obj(j)
    jw_kobj(j, "documentLinkProvider")
    jw_bool(j, "resolveProvider", false)
    jw_end_obj(j)
    jw_kobj(j, "workspace")
    jw_kobj(j, "workspaceFolders")
    jw_bool(j, "supported", true)
    jw_bool(j, "changeNotifications", true)
    jw_end_obj(j)
    jw_end_obj(j)
    jw_kobj(j, "semanticTokensProvider")
    jw_kobj(j, "legend")
    jw_karr(j, "tokenTypes")
    each tt in ["namespace", "type", "struct", "enum", "interface", "enumMember", "function", "method", "parameter", "variable", "property", "keyword", "string", "number", "comment", "operator", "class", "decorator"]:
        jw_vstr(j, tt)
    end
    jw_end_arr(j)
    jw_karr(j, "tokenModifiers")
