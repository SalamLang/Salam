package main

if SALAM_OS_WASM:
    include web "sal_web.salam"
else:
    import os
    include cl "cli/cli.salam"
end

func main:
    if SALAM_OS_WASM:
        _v := web.Version()
    else:
        args := os.Args()
        defer args.Free()
        code := cl.Run(args)
        ret code
    end
end
