package main

if SALAM_OS_WASM:
    import web "sal_web.salam"
else:
    import os
    import cl "cli/cli.salam"
end

func main:
    if SALAM_OS_WASM:
        _v := web.Version()
    else:
        args := os.Args()
        defer args.free()
        code := cl.Run(args)
        os.Exit(code)
    end
end
