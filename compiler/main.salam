// Port of compiler/src/salam.c - the ENTRY POINT of the entire self-hosted
// Salam compiler. salam.c is literally:
//
//   int main(int argc, char **argv) { return driver_main(argc, argv); }
//
// os.Args() (compiler/std/os/os.salam -> core/core.salam's salam_args())
// returns the SAME argv shape C gets: element 0 is the program's own path
// (salam_set_args(argc, argv) is called with the untouched argc/argv from
// codegen's generated `int main(int argc, char** argv)`, see
// codegen/codegen_decl.c). cl.Run(args) (salam/cli.salam) is the Salam port
// of cli_parse + driver_main's command switch combined, so this file is the
// direct analogue of salam.c: read argv, hand it to the CLI, exit with its
// result.
//
// The WebAssembly playground's entry lives here too, behind SALAM_OS_WASM.
// It was compiler/wasm_main.salam, which meant `salam build compiler/` saw
// two files defining `main` and could resolve the directory to neither.
// Both arms are condcomp-folded, imports included, so the two builds reach
// exactly what they reached before: a native build never touches
// sal_web.salam, and the browser build never pulls in the CLI - the same
// separation the C build got by compiling c/src/web only inside
// build-wasm.sh. build-wasm.sh turns the marker on by passing
// --target=wasm32-unknown-emscripten.
//
// The wasm entry itself does nothing: the browser calls the functions
// sal_web.salam exports directly through cwrap, and emcc is told
// IGNORE_MISSING_MAIN, but a program still needs a `main` to compile.
// Importing sal_web is what pulls in its `extern:` shims -
// salam_web_run_app and the rest - which survive DCE with their unmangled
// names, Salam's answer to EMSCRIPTEN_KEEPALIVE.
//
// No `pub` on main - a program entry point is never imported by another
// module, matching the convention used by every other *.salam program in
// this repo (compiler/tests/en/**/*.salam).
package main

if SALAM_OS_WASM:
    import web "sal_web.salam"
else:
    import os
    import cl "cli/cli.salam"
end

func main:
    if SALAM_OS_WASM:
        // Referenced so the import is not an unused one; the value is
        // discarded.
        _v := web.Version()
    else:
        args := os.Args()
        defer args.free()
        code := cl.Run(args)
        os.Exit(code)
    end
end
