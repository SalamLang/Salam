// Port of compiler/src/salam.c - the ENTRY POINT of the entire self-hosted
// Salam compiler. salam.c is literally:
//
//   int main(int argc, char **argv) { return driver_main(argc, argv); }
//
// os.Args() (compiler/std/os/os.salam -> core/core.salam's salam_args())
// returns the SAME argv shape C gets: element 0 is the program's own path
// (salam_set_args(argc, argv) is called with the untouched argc/argv from
// codegen's generated `int main(int argc, char** argv)`, see
// codegen/codegen_decl.c). cl.Run(args) (salam/cli.salam) is the Salam port
// of cli_parse + driver_main's command switch combined, so this file is the
// direct analogue of salam.c: read argv, hand it to the CLI, exit with its
// result.
//
// No `pub` on main - a program entry point is never imported by another
// module, matching the convention used by every other *.salam program in
// this repo (compiler/tests/en/**/*.salam).
package main

import os
import cl "cli.salam"

func main:
    args := os.Args()
    defer args.free()
    code := cl.Run(args)
    os.Exit(code)
end
