func is_ascii_upper(c: str): bool:
    ret c >= "A" and c <= "Z"
end

func is_ascii_lower(c: str): bool:
    ret c >= "a" and c <= "z"
end

func is_ascii_digit(c: str): bool:
    ret c >= "0" and c <= "9"
end

func is_ascii_letter(c: str): bool:
    ret is_ascii_upper(c) or is_ascii_lower(c)
end

func ascii_lower(s: str): str:
    mut out := ""
    repeat s.len() in i:
        c := s.Substr(i, 1)
        if is_ascii_upper(c):
            out += str.Lower(c)
        else:
            out += c
        end
    end
    ret out
end

func word_en_to_fa(word: str): str:
    w := ascii_lower(word)
    mut i := 0
    n := k_words.len() / 2
    until i < n:
        if str.Equals(k_words[i * 2], w):
            ret k_words[i * 2 + 1]
        end
        i++
    end
    ret ""
end

func word_fa_to_en(word: str): str:
    mut i := 0
    n := k_words.len() / 2
    until i < n:
        if str.Equals(k_words[i * 2 + 1], word):
            ret k_words[i * 2]
        end
        i++
    end
    ret ""
end

func split_en_identifier(name: str): Vector<str>:
    mut parts := Vector {} as Vector<str>
    mut cur := ""
    mut prev_lower := false
    repeat name.len() in i:
        c := name.Substr(i, 1)
        if c == "_":
            if cur.len() > 0:
                parts.Push(cur)
                cur = ""
            end
            prev_lower = false
        else is_ascii_upper(c):
            if prev_lower and cur.len() > 0:
                parts.Push(cur)
                cur = str.Lower(c)
            else:
                cur += str.Lower(c)
            end
            prev_lower = false
        else is_ascii_lower(c) or is_ascii_digit(c):
            cur += c
            prev_lower = is_ascii_lower(c)
        else:
            cur += c
            prev_lower = false
        end
    end
    if cur.len() > 0:
        parts.Push(cur)
    end
    ret parts
end

func translit_en_to_fa(s: str): str:
    // Simple deterministic transliteration for unknown tokens (offline).
    mut out := ""
    mut i := 0
    low := ascii_lower(s)
    until i < low.len():
        c := low.Substr(i, 1)
        if c == "a": out += "ا"
        else c == "b": out += "ب"
        else c == "c": out += "ک"
        else c == "d": out += "د"
        else c == "e": out += "ی"
        else c == "f": out += "ف"
        else c == "g": out += "گ"
        else c == "h": out += "ه"
        else c == "i": out += "ی"
        else c == "j": out += "ج"
        else c == "k": out += "ک"
        else c == "l": out += "ل"
        else c == "m": out += "م"
        else c == "n": out += "ن"
        else c == "o": out += "و"
        else c == "p": out += "پ"
        else c == "q": out += "ق"
        else c == "r": out += "ر"
        else c == "s": out += "س"
        else c == "t": out += "ت"
        else c == "u": out += "و"
        else c == "v": out += "و"
        else c == "w": out += "و"
        else c == "x": out += "کس"
        else c == "y": out += "ی"
        else c == "z": out += "ز"
        else c == "_": out += " "
        else c == " ": out += " "
        else: out += c
        end
        i++
    end
    ret out
end

func translit_fa_to_en(s: str): str:
    // Simple deterministic transliteration for unknown Persian tokens (offline).
    mut out := ""
    repeat s.len() in i:
        c := s.Substr(i, 1)
        if c == "ا" or c == "آ": out += "a"
        else c == "ب": out += "b"
        else c == "پ": out += "p"
        else c == "ت" or c == "ط": out += "t"
        else c == "ث" or c == "س" or c == "ص": out += "s"
        else c == "ج": out += "j"
        else c == "چ": out += "ch"
        else c == "ح" or c == "ه": out += "h"
        else c == "خ": out += "kh"
        else c == "د": out += "d"
        else c == "ذ" or c == "ز" or c == "ض" or c == "ظ": out += "z"
        else c == "ر": out += "r"
        else c == "ژ": out += "zh"
        else c == "ش": out += "sh"
        else c == "ع" or c == "ء": out += "a"
        else c == "غ": out += "gh"
        else c == "ف": out += "f"
        else c == "ق": out += "gh"
        else c == "ک" or c == "ك": out += "k"
        else c == "گ": out += "g"
        else c == "ل": out += "l"
        else c == "م": out += "m"
        else c == "ن": out += "n"
        else c == "و": out += "v"
        else c == "ی" or c == "ي": out += "i"
        else c == " " or c == "\u200C" or c == "_": out += "_"
        else: out += c
        end
    end
    ret out
end

pub func TranslateIdentifierEnToFa(name: str): str:
    // Whole-name dictionary hit first (e.g. get_or)
    whole := word_en_to_fa(name)
    if whole.len() > 0:
        ret whole
    end
    parts := split_en_identifier(name)
    defer parts.free()
    if parts.len() == 0:
        ret name
    end
    mut out := ""
    mut first := true
    each p in parts:
        mut fa := word_en_to_fa(p)
        if fa.len() == 0:
            fa = translit_en_to_fa(p)
        end
        if not first:
            out += " "
        end
        out += fa
        first = false
    end
    ret out
end

pub func TranslateIdentifierFaToEn(name: str): str:
    whole := word_fa_to_en(name)
    if whole.len() > 0:
        ret whole
    end
    // split by space / ZWNJ / underscore
    mut out := ""
    mut cur := ""
    mut first := true
    repeat name.len() in i:
        c := name.Substr(i, 1)
        if c == " " or c == "\u200C" or c == "_":
            if cur.len() > 0:
                mut en := word_fa_to_en(cur)
                if en.len() == 0:
                    en = translit_fa_to_en(cur)
                end
                if not first:
                    out += "_"
                end
                out += en
                first = false
                cur = ""
            end
        else:
            cur += c
        end
    end
    if cur.len() > 0:
        mut en := word_fa_to_en(cur)
        if en.len() == 0:
            en = translit_fa_to_en(cur)
        end
        if not first:
            out += "_"
        end
        out += en
    end
    if out.len() == 0:
        ret translit_fa_to_en(name)
    end
    ret out
end

pub func TranslateWord(text: str, to_fa: bool): str:
    if to_fa:
        ret TranslateIdentifierEnToFa(text)
    end
    ret TranslateIdentifierFaToEn(text)
end
