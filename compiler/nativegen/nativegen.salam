    pub allow_self: bool = false
    pub unr_grow: int = 0
    pub off_inlunr: bool = false
    pub off_chain: bool = false
    pub off_mph: bool = false
    pub off_dloop: bool = false
    pub off_lvec: bool = false
    pub off_selhoist: bool = false
    pub off_shoist: bool = false
    pub off_asplit: bool = false
    pub dom_ok: bool = false
    pub f_sret: bool = false
    pub nfuncs: int = 0
    pub asm: str.StringBuilder = str.NewBuilder()
    pub asm_fsym: Vector<int> = Vector {}
    pub asm_fpos: Vector<int> = Vector {}
    pub sy_live: Vector<bool> = Vector {}
    pub mc: Mc = Mc {}
end

func fail(g &: Ng, msg: str):
    if g.ok:
        g.ok = false
        mut line := 1
        mut i := 0
        until i < g.p and i < g.sn:
            if g.src[i] == (10 as u8):
                line += 1
            end
            i += 1
        end
        g.err = msg + " (IR line " + str.FromInt(line as i64) + ")"
    end
end

func tab_hash(p: u8*, s: int, l: int): int:
    mut h := 2166136261 as u32
    repeat l in i:
        h = (h ^ (p[s + i] as u32)) * (16777619 as u32)
    end
    ret (h & (0x7FFFFFFF as u32)) as int
end

func tab_init(t &: Tab, cap: int):
    t.slots.clear()
    repeat cap:
        t.slots.push(0 - 1)
    end
    t.mask = cap - 1
    t.n = 0
    t.off.clear()
    t.len.clear()
    t.hash.clear()
    t.bytes.clear()
end

func tab_eq(t &: Tab, id: int, p: u8*, s: int, l: int): bool:
    if t.len[id] != l:
        ret false
    end
    o := t.off[id]
    repeat l in i:
        if t.bytes[o + i] != p[s + i]:
            ret false
        end
    end
    ret true
end

func tab_grow(t &: Tab):
    cap := (t.mask + 1) * 2
    t.slots.clear()
    repeat cap:
        t.slots.push(0 - 1)
    end
    t.mask = cap - 1
    repeat t.n in id:
        mut j := t.hash[id] & t.mask
        until t.slots[j] >= 0:
            j = (j + 1) & t.mask
        end
        t.slots[j] = id
    end
end

func tab_get(t &: Tab, p: u8*, s: int, l: int): int:
    h := tab_hash(p, s, l)
    mut j := h & t.mask
    until true:
        id := t.slots[j]
        if id < 0:
            ret 0 - 1
        end
        if t.hash[id] == h and tab_eq(t, id, p, s, l):
            ret id
        end
        j = (j + 1) & t.mask
    end
end

func tab_add(t &: Tab, p: u8*, s: int, l: int): int:
    h := tab_hash(p, s, l)
    mut j := h & t.mask
    until true:
        id := t.slots[j]
        if id < 0:
            break
        end
        if t.hash[id] == h and tab_eq(t, id, p, s, l):
            ret id
        end
        j = (j + 1) & t.mask
    end
    nid := t.n
    t.off.push(t.bytes.len())
    t.len.push(l)
    t.hash.push(h)
    repeat l in i:
        t.bytes.push(p[s + i])
    end
    t.slots[j] = nid
    t.n += 1
    if t.n * 2 > t.mask:
        tab_grow(t)
    end
    ret nid
end

func sp(s: str): u8*:
    ret (s as void*) as u8*
end

func tab_adds(t &: Tab, s: str): int:
    ret tab_add(t, sp(s), 0, str.Len(s))
end

func tab_str(t &: Tab, id: int): str:
    mut b := str.NewBuilder()
    o := t.off[id]
    repeat t.len[id] in i:
        str.BufAppendChar(b, t.bytes[o + i] as int)
    end
    r := str.BufStr(b)
    str.BufFree(b)
    ret r
end

func align_up(x: int, a: int): int:
    if a <= 1:
        ret x
    end
    ret (x + a - 1) / a * a
end
