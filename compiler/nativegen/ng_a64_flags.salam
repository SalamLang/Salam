package nativegen

func a_cond(xcc: int, fk: int): int:
    switch xcc:
        X_E: ret 0 end
        X_NE: ret 1 end
        X_S: ret 4 end
        X_NS: ret 5 end
        X_O: ret 6 end
        X_NO: ret 7 end
        X_P: ret 6 end
        X_NP: ret 7 end
        X_L: ret 11 end
        X_GE: ret 10 end
        X_LE: ret 13 end
        X_G: ret 12 end
    end
    if fk == FK_FLOAT:
        switch xcc:
            X_B: ret 11 end
            X_AE: ret 10 end
            X_BE: ret 13 end
            X_A: ret 12 end
        end
    end
    if fk == FK_ADD:
        switch xcc:
            X_B: ret 2 end
            X_AE: ret 3 end
        end
    end
    if fk == FK_LOGIC:
        switch xcc:
            X_B: ret 16 end
            X_AE: ret 14 end
            X_BE: ret 0 end
            X_A: ret 1 end
        end
    end
    switch xcc:
        X_B: ret 3 end
        X_AE: ret 2 end
        X_BE: ret 9 end
        X_A: ret 8 end
    end
    ret 14
end

func flag_kind(g &: Ng, i: int): int:
    op := g.mc.op[i]
    if op == M_UCOMI:
        ret FK_FLOAT
    end
    if op == M_TEST_RR or op == M_TEST_RI or op == M_SHIFT_RI or op == M_SHIFT_RC:
        ret FK_LOGIC
    end
    if op == M_ALU_RR or op == M_ALU_RI or op == M_ALU_RM or op == M_ALU_MR or op == M_ALU_MI:
        c := g.mc.cc[i]
        if c == ALU_ADD:
            ret FK_ADD
        end
        if c == ALU_AND or c == ALU_OR or c == ALU_XOR:
            ret FK_LOGIC
        end
        ret FK_SUB
    end
    if op == M_UNARY and g.mc.cc[i] == UN_NEG:
        ret FK_SUB
    end
    if op == M_LCMPXCHG:
        ret FK_SUB
    end
    if op == M_LXADD:
        ret FK_ADD
    end
    ret 0 - 1
end

func is_flag_use(op: int): bool:
    ret op == M_JCC or op == M_SETCC or op == M_CMOV
end

func producer_kind(g &: Ng, i: int): int:
    mut j := i - 1
    until j >= 0:
        op := g.mc.op[j]
        if op == M_LABEL or op == M_CALL or op == M_CALLR:
            ret FK_SUB
        end
        k := flag_kind(g, j)
        if k >= 0:
            ret k
        end
        j--
    end
    ret FK_SUB
end

func flags_needed(g &: Ng, i: int): bool:
    mut j := i + 1
    n := g.mc.op.Len()
    until j < n:
        op := g.mc.op[j]
        if is_flag_use(op):
            ret true
        end
        if op == M_LABEL or op == M_JMP:
            ret true
        end
        if op == M_CALL or op == M_CALLR or op == M_RET or flag_kind(g, j) >= 0:
            ret false
        end
        j++
    end
    ret false
end
