package nativegen

func a_pro_mark(a &: A64, from: int, kind: int, val: int):
    n := a.w.Len() - from
    repeat n in i:
        a.pk.Push(i == n - 1 ? kind : 0)
        a.pv.Push(i == n - 1 ? val : 0)
    end
end

func a_prologue(g &: Ng, a &: A64):
    cf_begin(g)
    aw(a, 0xA9BF7BFD as i64)
    a_pro_mark(a, a.w.Len() - 1, 1, 0)
    cf_ev(g, a.w.Len(), CF_OFF, 16, 0)
    cf_ev(g, a.w.Len(), CF_REG, 29, 16)
    cf_ev(g, a.w.Len(), CF_REG, 30, 8)
    aw(a, 0x910003FD as i64)
    a_pro_mark(a, a.w.Len() - 1, 2, 0)
    cf_ev(g, a.w.Len(), CF_DEF, 29, 16)
    w0 := a.w.Len()
    if a.total >= 4096 and g.os == NG_OS_WINDOWS:
        a_mov_imm(a, AX15, (a.total / 16) as i64, true)
        arel(a, g.sym_chkstk, R_A64_CALL26, 0 as i64)
        g.sy_used[g.sym_chkstk] = true
        aw(a, 0x94000000 as i64)
        aw(a, 0xCB2F73FF as i64)
    else a.total > 0:
        a_addsub_imm(a, ASP, ASP, a.total as i64, true, false, true)
    end
    a_pro_mark(a, w0, 3, a.total)
    repeat a.ngp in k:
        w1 := a.w.Len()
        r := axr(g.mc.callee_used[k])
        a_ldst(a, 0xF9000000 as i64, r, 29, (0 - 8 * (k + 1)) as i64, 8)
        a_pro_mark(a, w1, 4, k)
        cf_ev(g, a.w.Len(), CF_REG, r, 16 + 8 * (k + 1))
    end
end

func a64_unwind_code(g &: Ng, a &: A64, codes &: Vector<int>, k: int, v: int):
    if k == 1:
        codes.Push(0x81)
    else k == 2:
        codes.Push(0xE1)
    else k == 3:
        q := v / 16
        if q < 32:
            codes.Push(q)
        else q < 2048:
            codes.Push(0xC0 | (q >> 8))
            codes.Push(q & 255)
        else:
            codes.Push(0xE0)
            codes.Push((q >> 16) & 255)
            codes.Push((q >> 8) & 255)
            codes.Push(q & 255)
        end
    else k == 4:
        x := axr(g.mc.callee_used[v]) - 19
        off := a.total - 8 * (v + 1)
        if x >= 0 and x < 16 and off >= 0 and off <= 504 and (off % 8) == 0:
            codes.Push(0xD0 | (x >> 2))
            codes.Push(((x & 3) << 6) | (off / 8))
        else:
            codes.Push(0xE3)
        end
    else:
        codes.Push(0xE3)
    end
end

func a64_unwind(g &: Ng, a &: A64, fsize: int):
    nins := fsize / 4
    if nins >= 262144:
        ret
    end
    mut codes := Vector {} as Vector<int>
    mut i := a.pk.Len() - 1
    until i >= 0:
        a64_unwind_code(g, a, codes, a.pk[i], a.pv[i])
        i--
    end
    codes.Push(0xE4)
    until (codes.Len() % 4) != 0:
        codes.Push(0xE4)
    end
    sec_align_to(g, SEC_XDATA, 4)
    xoff := g.s_xdata.Len()
    hdr := nins | ((codes.Len() / 4) << 27)
    repeat 4 in b:
        sec_put(g, SEC_XDATA, (hdr >> (8 * b)) & 255)
    end
    each c in codes:
        sec_put(g, SEC_XDATA, c)
    end
    codes.Free()
    sec_align_to(g, SEC_PDATA, 4)
    po := g.s_pdata.Len()
    add_reloc(g, SEC_PDATA, po, g.f_sym, R_ADDR32NB, 0 as i64)
    add_reloc(g, SEC_PDATA, po + 4, g.sym_xdata, R_ADDR32NB, xoff as i64)
    sec_pad(g, SEC_PDATA, 8)
end

func a_epilogue(g &: Ng, a &: A64):
    cf_ev(g, a.w.Len(), CF_REMEMBER, 0, 0)
    repeat a.ngp in k:
        r := axr(g.mc.callee_used[k])
        a_ldst(a, 0xF9400000 as i64, r, 29, (0 - 8 * (k + 1)) as i64, 8)
    end
    aw(a, 0x910003BF as i64)
    aw(a, 0xA8C17BFD as i64)
    cf_ev(g, a.w.Len(), CF_DEF, 31, 0)
    cf_ev(g, a.w.Len(), CF_SAME, 29, 0)
    cf_ev(g, a.w.Len(), CF_SAME, 30, 0)
    aw(a, 0xD65F03C0 as i64)
    cf_ev(g, a.w.Len(), CF_RESTORE_STATE, 0, 0)
end
