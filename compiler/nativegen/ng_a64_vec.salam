package nativegen

func a_vop3(op: int, sz: int): i64:
    switch op:
        0xFE: ret 0x4EA08400 end
        0xD4: ret 0x4EE08400 end
        0xFA: ret 0x6EA08400 end
        0xFB: ret 0x6EE08400 end
        0xDB: ret 0x4E201C00 end
        0xEB: ret 0x4EA01C00 end
        0xEF: ret 0x6E201C00 end
        0x76: ret 0x6EA08C00 end
        0x66: ret 0x4EA03400 end
        0x6C: ret 0x4EC03800 end
        0x60: ret 0x4E003800 end
        0x61: ret 0x4E403800 end
        0xFD: ret 0x4E608400 end
        0xF9: ret 0x6E608400 end
        0xD5: ret 0x4E609C00 end
        0x75: ret 0x6E608C00 end
        0x65: ret 0x4E603400 end
        0xD9: ret 0x6E602C00 end
        VOP_CMPEQ64: ret 0x6EE08C00 end
        VOP_CMPGT64: ret 0x4EE03400 end
        VOP_CMPHI64: ret 0x6EE03400 end
        VOP_CMPHI32: ret 0x6EA03400 end
        0xFC: ret 0x4E208400 end
        0xF8: ret 0x6E208400 end
        0x74: ret 0x6E208C00 end
        0x64: ret 0x4E203400 end
        0xDE: ret 0x6E206400 end
        0xDA: ret 0x6E206C00 end
        VOP_MUL32: ret 0x4EA09C00 end
        FO_ADD: ret sz == 4 ? (0x4E20D400 as i64) : (0x4E60D400 as i64) end
        FO_SUB: ret sz == 4 ? (0x4EA0D400 as i64) : (0x4EE0D400 as i64) end
        FO_MUL: ret sz == 4 ? (0x6E20DC00 as i64) : (0x6E60DC00 as i64) end
        FO_DIV: ret sz == 4 ? (0x6E20FC00 as i64) : (0x6E60FC00 as i64) end
    end
    ret -1
end

func a_vmov(a &: A64, d: int, n: int):
    if d != n:
        aw(a, (0x4EA01C00 as i64) | rd_rn_rm(d, n, n))
    end
end

func a_ins_s(a &: A64, d: int, k: int, n: int, j: int):
    aw(
        a,
        (0x6E000400 as i64) | ((((k << 3) | 4) as i64) << (16 as i64)) | (((j << 2) as i64) << (11 as i64)) | rd_rn_rm(
            d, n, 0
        )
    )
end

func a_dup_s(a &: A64, d: int, n: int, k: int):
    aw(a, (0x4E000400 as i64) | ((((k << 3) | 4) as i64) << (16 as i64)) | rd_rn_rm(d, n, 0))
end

func a_shuf(a &: A64, d: int, lo: int, hi: int, imm: int):
    s0 := imm & 3
    s1 := (imm >> 2) & 3
    s2 := (imm >> 4) & 3
    s3 := (imm >> 6) & 3
    if lo == hi and s0 == s1 and s1 == s2 and s2 == s3:
        a_dup_s(a, d, lo, s0)
        ret
    end
    if lo == hi and s0 == 2 and s1 == 3 and s2 == 2 and s3 == 3:
        aw(a, (0x4E180400 as i64) | rd_rn_rm(d, lo, 0))
        ret
    end
    a_vmov(a, AV25, lo)
    mut h := hi
    if hi == d:
        h = AV25
    end
    a_ins_s(a, d, 0, AV25, s0)
    a_ins_s(a, d, 1, AV25, s1)
    a_ins_s(a, d, 2, h, s2)
    a_ins_s(a, d, 3, h, s3)
end
