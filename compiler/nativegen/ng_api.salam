package nativegen

import str

pub func CompileFunction(g &: Ng):
    g.nfuncs += 1
    g.mc.n += g.i_op.len()
    ensure_terms(g)
    build_cfg(g)
    if g.opt and not g.off_sroa:
        _s := sroa(g)
    end
    mem2reg(g)
    if not g.ok:
        ret
    end
    simplify_phis(g)
    if g.opt:
        if not g.off_inline and inline_calls(g):
            ensure_terms(g)
            build_cfg(g)
            remap_all(g)
            simplify_phis(g)
            if not g.off_sroa and sroa(g):
                mem2reg(g)
                simplify_phis(g)
            end
        end
        optimize(g)
        cache_function(g)
    end
    if dump_wanted(g):
        dump_ir(g, "optimized")
    end
    isel_function(g)
    if not g.ok:
        ret
    end
    regalloc(g)
    if not g.ok:
        ret
    end
    encode_function(g)
    if g.emit_asm:
        asm_function(g)
    end
end

pub func WriteObject(g &: Ng, path: str): bool:
    if g.opt and not g.dce_done:
        gdce(g)
        g.dce_done = true
    end
    if g.os == NG_OS_WINDOWS:
        if not write_coff(g, path):
            fail(g, "native backend: cannot write " + path)
            ret false
        end
        ret true
    end
    if not write_elf(g, path):
        fail(g, "native backend: cannot write " + path)
        ret false
    end
    ret true
end

pub func New(os: int): Ng:
    mut g := Ng {}
    g.os = os
    kw_init(g)
    read_pass_switches(g)
    types_init(g)
    syms_init(g)
    repeat SEC_COUNT:
        g.sec_align.push(1)
    end
    ret g
end

pub func Run(g &: Ng, text: str): bool:
    g.src = sp(text)
    g.sn = str.Len(text)
    g.p = 0
    ParseModule(g)
    ret g.ok
end

pub func Error(g &: Ng): str:
    ret g.err
end

pub func Stats(g &: Ng): str:
    ret str.FromInt(g.nfuncs as i64) + " functions, " + str.FromInt(g.mc.n as i64) + " instructions, " + str.FromInt(g.s_ro.len() as i64) + " rodata, " + str.FromInt(g.s_data.len() as i64) + " data, " + str.FromInt(g.bss_size as i64) + " bss"
end
