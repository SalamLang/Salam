package nativegen

import str

k_r64 := ["rax", "rcx", "rdx", "rbx", "rsp", "rbp", "rsi", "rdi", "r8", "r9", "r10", "r11", "r12", "r13", "r14", "r15"]
k_r32 := ["eax", "ecx", "edx", "ebx", "esp", "ebp", "esi", "edi", "r8d", "r9d", "r10d", "r11d", "r12d", "r13d", "r14d", "r15d"]
k_r16 := ["ax", "cx", "dx", "bx", "sp", "bp", "si", "di", "r8w", "r9w", "r10w", "r11w", "r12w", "r13w", "r14w", "r15w"]
k_r8 := ["al", "cl", "dl", "bl", "spl", "bpl", "sil", "dil", "r8b", "r9b", "r10b", "r11b", "r12b", "r13b", "r14b", "r15b"]
k_ccn := ["o", "no", "b", "ae", "e", "ne", "be", "a", "s", "ns", "p", "np", "l", "ge", "le", "g"]
k_alun := ["add", "or", "adc", "sbb", "and", "sub", "xor", "cmp"]
k_shn := ["rol", "ror", "rcl", "rcr", "shl", "shr", "sal", "sar"]

func regname(r: int, sz: int): str:
    if r >= 16:
        ret "xmm" + (r - 16)
    end
    if r < 0:
        ret "?"
    end
    if sz == 8:
        ret k_r64[r]
    end
    if sz == 4:
        ret k_r32[r]
    end
    if sz == 2:
        ret k_r16[r]
    end
    ret k_r8[r]
end

func preg(g &: Ng, r: int): str:
    ret g.arch == NG_ARCH_X86 ? k_r32[r] : k_r64[r]
end

func psz(g &: Ng): int:
    ret g.arch == NG_ARCH_X86 ? 4 : 8
end

func ptr_kw(sz: int): str:
    if sz == 1: ret "BYTE PTR " end
    if sz == 2: ret "WORD PTR " end
    if sz == 4: ret "DWORD PTR " end
    if sz == 16: ret "XMMWORD PTR " end
    ret "QWORD PTR "
end

func disp_str(d: i64): str:
    if d == (0 as i64):
        ret ""
    end
    if d > (0 as i64):
        ret "+" + str.FromInt(d)
    end
    ret str.FromInt(d)
end

func asm_mem(g &: Ng, rm: RM, sz: int): str:
    mut p := ""
    if sz > 0:
        p = ptr_kw(sz)
    end
    if (rm.k == MK_RIP or rm.k == MK_GOT) and g.arch == NG_ARCH_X86:
        ret p + "[" + tab_str(g.syms, rm.sym) + disp_str(rm.d) + "]"
    end
    if rm.k == MK_RIP:
        ret p + "[rip+" + tab_str(g.syms, rm.sym) + disp_str(rm.d) + "]"
    end
    if rm.k == MK_GOT and g.os == NG_OS_WINDOWS:
        ret p + "[rip+" + tab_str(g.syms, rm.sym) + "]"
    end
    if rm.k == MK_GOT:
        ret p + "[rip+" + tab_str(g.syms, rm.sym) + "@GOTPCREL]"
    end
    mut s := p + "["
    mut first := true
    if rm.b >= 0:
        s += preg(g, rm.b)
        first = false
    end
    if rm.i >= 0:
        if not first:
            s += "+"
        end
        s += preg(g, rm.i)
        if rm.s > 1:
            s = s + "*" + rm.s
        end
        first = false
    end
    if first:
        s += str.FromInt(rm.d)
    else:
        s += disp_str(rm.d)
    end
    ret s + "]"
end

func asl(g &: Ng, line: str):
    str.BufAppend(g.asm, "    " + line + "\n")
end

func asm_label_name(g &: Ng, lbl: int): str:
    ret ".L" + str.FromInt(g.nfuncs as i64) + "_" + str.FromInt(lbl as i64)
end

func asm_sse(sz: int, base: str): str:
    ret base + (sz == 4 ? "ss" : "sd")
end

func asm_ret(g &: Ng):
    if g.f_popn > 0:
        asl(g, "ret " + g.f_popn)
        ret
    end
    asl(g, "ret")
end

func asm_epilogue(g &: Ng):
    ngp := ngp_count(g)
    if g.mc.fpo:
        if g.mc.fpo_pad > 0:
            asl(g, "add " + preg(g, RSP) + ", " + g.mc.fpo_pad)
        end
        mut kf := ngp - 1
        until kf >= 0:
            asl(g, "pop " + preg(g, g.mc.callee_used[kf]))
            kf--
        end
        asm_ret(g)
        ret
    end
    mut k2 := ngp
    until k2 + 1 < g.mc.callee_used.Len():
        asl(g, "movaps " + regname(g.mc.callee_used[k2], 16) + ", XMMWORD PTR [rbp-" + g.mc.callee_used[k2 + 1] + "]")
        k2 += 2
    end
    if ngp > 0:
        asl(g, "lea rsp, [rbp-" + (8 * ngp) + "]")
        mut k := ngp - 1
        until k >= 0:
            asl(g, "pop " + k_r64[g.mc.callee_used[k]])
            k--
        end
        asl(g, "pop rbp")
    else:
        asl(g, "leave")
    end
    asm_ret(g)
end

func yreg(r: int, y: bool): str:
    if y:
        ret "ymm" + (r - 16)
    end
    ret regname(r, 16)
end

func asm_vop_name(vc: int, sz: int): str:
    if vc == 0xD4: ret "paddq" end
    if vc == 0xFE: ret "paddd" end
    pn := vint_name(vc)
    if pn != "":
        ret pn
    end
    mut vn := "add"
    if vc == FO_MUL: vn = "mul" end
    if vc == FO_SUB: vn = "sub" end
    if vc == FO_DIV: vn = "div" end
    ret vn + (sz == 8 ? "pd" : "ps")
end

func vshift_reg_op(vc: int): bool:
    ret (vc >= 0xD1 and vc <= 0xD3) or vc == 0xE1 or vc == 0xE2 or (vc >= 0xF1 and vc <= 0xF3)
end

func vun_mem_size(c: int, y: bool): int:
    mut n := (c & 15) == 1 ? 4 : 8
    if y:
        n *= 2
    end
    ret n
end

func vun_name(c: int): str:
    if c == 0x1C or c == 0x1D or c == 0x1E:
        ret c == 0x1C ? "pabsb " : (c == 0x1D ? "pabsw " : "pabsd ")
    end
    ret "pmov" + ((c & 0x10) != 0 ? "zx" : "sx") + ((c & 15) == 0 ? "bw " : ((c & 15) == 1 ? "bd " : "wd "))
end

func asm_vex_ins(g &: Ng, i: int): bool:
    op := g.mc.op[i]
    sz := g.mc.sz[i]
    r0 := g.mc.r0[i]
    r1 := g.mc.r1[i]
    imm := g.mc.imm[i]
    y := g.mc.ymm[i]
    x0 := regname(r0, 16)
    x1 := regname(r1, 16)
    pw := y ? "YMMWORD PTR " : "XMMWORD PTR "
    switch op:
        M_FMOV_RR: asl(g, "vmovaps " + yreg(r0, y) + ", " + yreg(r1, y)) ret true end
        M_FLD: asl(g, "v" + asm_sse(sz, "mov") + " " + x0 + ", " + asm_mem(g, rm_of(g, i), sz)) ret true end
        M_FST: asl(g, "v" + asm_sse(sz, "mov") + " " + asm_mem(g, rm_of(g, i), sz) + ", " + x1) ret true end
        M_FOP_RR, M_FOP_RM:
            mut nm := "add"
            c := g.mc.cc[i]
            if c == FO_MUL: nm = "mul" end
            if c == FO_SUB: nm = "sub" end
            if c == FO_DIV: nm = "div" end
            if op == M_FOP_RR:
                asl(g, "v" + asm_sse(sz, nm) + " " + x0 + ", " + x0 + ", " + x1)
            else:
                asl(g, "v" + asm_sse(sz, nm) + " " + x0 + ", " + x0 + ", " + asm_mem(g, rm_of(g, i), sz))
            end
            ret true
        end
        M_SQRT: asl(g, "v" + asm_sse(sz, "sqrt") + " " + x0 + ", " + x0 + ", " + x1) ret true end
        M_UCOMI: asl(g, "v" + asm_sse(sz, "ucomi") + " " + x0 + ", " + x1) ret true end
        M_CVTSI2F: asl(g, "vcvtsi2" + (sz == 4 ? "ss " : "sd ") + x0 + ", " + x0 + ", " + regname(r1, g.mc.sz2[i])) ret true end
        M_CVTF2SI: asl(g, "vcvtt" + (sz == 4 ? "ss" : "sd") + "2si " + regname(r0, g.mc.sz2[i]) + ", " + x1) ret true end
        M_CVTF2F: asl(g, (sz == 8 ? "vcvtss2sd " : "vcvtsd2ss ") + x0 + ", " + x0 + ", " + x1) ret true end
        M_MOVQ_XG: asl(g, (sz == 8 ? "vmovq " : "vmovd ") + x0 + ", " + regname(r1, sz)) ret true end
        M_MOVQ_GX: asl(g, (sz == 8 ? "vmovq " : "vmovd ") + regname(r0, sz) + ", " + x1) ret true end
        M_XORPS:
            yx := y and r0 != r1
            asl(g, "vxorps " + yreg(r0, yx) + ", " + yreg(r0, yx) + ", " + yreg(r1, yx))
            ret true
        end
        M_ANDPS: asl(g, "vandps " + yreg(r0, y) + ", " + yreg(vex_src(g, i, r0), y) + ", " + yreg(r1, y)) ret true end
        M_VLD: asl(g, "vmovups " + yreg(r0, y) + ", " + pw + asm_mem(g, rm_of(g, i), 0)) ret true end
        M_VST: asl(g, "vmovups " + pw + asm_mem(g, rm_of(g, i), 0) + ", " + yreg(r1, y)) ret true end
        M_VOP_RR:
            vc := g.mc.cc[i]
            src := g.mc.mk[i] != MK_NONE ? pw + asm_mem(g, rm_of(g, i), 0) : (vshift_reg_op(vc) ? x1 : yreg(r1, y))
            asl(g, "v" + asm_vop_name(vc, sz) + " " + yreg(r0, y) + ", " + yreg(vex_src(g, i, r0), y) + ", " + src)
            ret true
        end
        M_SHUFPS: asl(g, "vshufps " + yreg(r0, y) + ", " + yreg(r0, y) + ", " + yreg(r1, y) + ", " + str.FromInt(imm)) ret true end
        M_UNPCKLPD: asl(g, "vunpcklpd " + yreg(r0, y) + ", " + yreg(r0, y) + ", " + yreg(r1, y)) ret true end
        M_PSHUFD: asl(g, "vpshufd " + yreg(r0, y) + ", " + yreg(r1, y) + ", " + str.FromInt(imm)) ret true end
        M_VSHI: asl(g, "v" + vshift_name(g.mc.cc[i], g.mc.sz2[i]) + " " + yreg(r0, y) + ", " + yreg(vex_src(g, i, r0), y) + ", " + str.FromInt(imm)) ret true end
        M_VBLEND:
            bs := g.mc.mk[i] != MK_NONE ? pw + asm_mem(g, rm_of(g, i), 0) : yreg(r1, y)
            asl(g, "vpblendvb " + yreg(r0, y) + ", " + yreg(vex_src(g, i, r0), y) + ", " + bs + ", " + yreg(g.mc.r2[i], y))
            ret true
        end
        M_VLD32: asl(g, "vmovd " + x0 + ", " + asm_mem(g, rm_of(g, i), 4)) ret true end
        M_VST32: asl(g, "vmovd " + asm_mem(g, rm_of(g, i), 4) + ", " + x1) ret true end
        M_VUN:
            c2 := g.mc.cc[i]
            if c2 == VUN_EXT:
                asl(g, "vextracti128 " + x0 + ", " + yreg(r1, true) + ", " + str.FromInt(imm))
                ret true
            end
            mut bn := "vpbroadcastd "
            if c2 == VUN_BCQ: bn = "vpbroadcastq " end
            if c2 == VUN_BCB: bn = "vpbroadcastb " end
            if c2 == VUN_BCW: bn = "vpbroadcastw " end
            if c2 == VUN_BCSS: bn = "vbroadcastss " end
            if c2 == VUN_BCSD: bn = "vbroadcastsd " end
            mut sx := x1
            if c2 == 0x1C or c2 == 0x1D or c2 == 0x1E:
                bn = c2 == 0x1C ? "vpabsb " : (c2 == 0x1D ? "vpabsw " : "vpabsd ")
                sx = yreg(r1, y)
            end
            if c2 >= 0x20 and c2 <= 0x35:
                bn = "vpmov" + ((c2 & 0x10) != 0 ? "zx" : "sx") + ((c2 & 15) == 0 ? "bw " : ((c2 & 15) == 1 ? "bd " : "wd "))
                if g.mc.mk[i] != MK_NONE:
                    sx = asm_mem(g, rm_of(g, i), vun_mem_size(c2, y))
                end
            end
            asl(g, bn + yreg(r0, y) + ", " + sx)
            ret true
        end
        M_VZU: asl(g, "vzeroupper") ret true end
    end
    ret false
end

func abs_pfx(g &: Ng, i: int, p: str): str:
    if g.arch == NG_ARCH_X86 and (g.mc.mk[i] == MK_RIP or g.mc.mk[i] == MK_GOT):
        ret p
    end
    ret ""
end

func asm_call_fix(g &: Ng, i: int):
    if g.arch == NG_ARCH_X86 and g.mc.sz2[i] > 0:
        asl(g, "sub esp, " + g.mc.sz2[i])
    end
end

func asm_ins_x86(g &: Ng, i: int):
    mut bad := Vector {} as Vector<int>
    defer bad.Free()
    x86_byte_regs(g, i, bad)
    if bad.Len() == 0:
        asm_ins(g, i)
        ret
    end
    mut tmp := Vector {} as Vector<int>
    defer tmp.Free()
    repeat bad.Len():
        tmp.push(x86_free_tmp(g, i, bad, tmp))
    end
    o0 := g.mc.r0[i]
    o1 := g.mc.r1[i]
    ob := g.mc.mb[i]
    oi := g.mc.mi[i]
    bi := g.mc.mk[i] == MK_BI
    repeat bad.Len() in k:
        asl(g, "xchg " + k_r32[bad[k]] + ", " + k_r32[tmp[k]])
        g.mc.r0[i] = x86_swap(g.mc.r0[i], tmp[k], bad[k])
        g.mc.r1[i] = x86_swap(g.mc.r1[i], tmp[k], bad[k])
        if bi:
            g.mc.mb[i] = x86_swap(g.mc.mb[i], tmp[k], bad[k])
            g.mc.mi[i] = x86_swap(g.mc.mi[i], tmp[k], bad[k])
        end
    end
    asm_ins(g, i)
    g.mc.r0[i] = o0
    g.mc.r1[i] = o1
    g.mc.mb[i] = ob
    g.mc.mi[i] = oi
    mut k2 := bad.Len() - 1
    until k2 >= 0:
        asl(g, "xchg " + k_r32[bad[k2]] + ", " + k_r32[tmp[k2]])
        k2--
    end
end

func asm_ins(g &: Ng, i: int):
    if g.mc.vex and asm_vex_ins(g, i):
        ret
    end
    op := g.mc.op[i]
    sz := g.mc.sz[i]
    r0 := g.mc.r0[i]
    r1 := g.mc.r1[i]
    imm := g.mc.imm[i]
    sz2 := g.mc.sz2[i]
    switch op:
        M_NOP, M_COPY: ret end
        M_LABEL:
            if i < g.mc.lalign.Len() and g.mc.lalign[i]:
                str.BufAppend(g.asm, "    .p2align 4,,10\n    .p2align 3\n")
            end
            str.BufAppend(g.asm, asm_label_name(g, g.mc.tgt[i]) + ":\n")
            ret
        end
        M_MOV_RR: asl(g, "mov " + regname(r0, sz) + ", " + regname(r1, sz)) ret end
        M_MOV_RI:
            if sz == 8 and not is_imm32(imm):
                asl(g, "movabs " + regname(r0, 8) + ", " + str.FromInt(imm))
            else sz == 8 and imm < (0 as i64):
                asl(g, "mov " + regname(r0, 8) + ", " + str.FromInt(imm))
            else:
                asl(g, "mov " + regname(r0, 4) + ", " + str.FromInt(imm & (0xFFFFFFFF as i64)))
            end
            ret
        end
        M_LD, M_LDGOT:
            if op == M_LDGOT and g.arch == NG_ARCH_X86:
                asl(g, "mov " + regname(r0, 4) + ", OFFSET " + tab_str(g.syms, g.mc.msym[i]) + disp_str(g.mc.md[i]))
                ret
            end
            if op == M_LDGOT and g.os == NG_OS_WINDOWS:
                asl(g, "lea " + regname(r0, 8) + ", " + asm_mem(g, rm_of(g, i), 0))
                ret
            end
            asl(g, abs_pfx(g, i, "{load} ") + "mov " + regname(r0, op == M_LDGOT ? 8 : sz) + ", " + asm_mem(g, rm_of(g, i), op == M_LDGOT ? 8 : sz))
            ret
        end
        M_X87:
            if g.mc.cc[i] == 2:
                asl(g, "fild " + asm_mem(g, rm_of(g, i), 8))
            else:
                asl(g, (g.mc.cc[i] == 1 ? "fstp " : "fld ") + asm_mem(g, rm_of(g, i), sz == 8 ? 8 : 4))
            end
            ret
        end
        M_LDZX: asl(g, "movzx " + regname(r0, 4) + ", " + asm_mem(g, rm_of(g, i), sz2)) ret end
        M_LDSX:
            if sz2 == 4:
                asl(g, "movsxd " + regname(r0, 8) + ", " + asm_mem(g, rm_of(g, i), 4))
            else:
                asl(g, "movsx " + regname(r0, sz) + ", " + asm_mem(g, rm_of(g, i), sz2))
            end
            ret
        end
        M_ST: asl(g, abs_pfx(g, i, "{store} ") + "mov " + asm_mem(g, rm_of(g, i), sz) + ", " + regname(r1, sz)) ret end
        M_STI: asl(g, "mov " + asm_mem(g, rm_of(g, i), sz) + ", " + str.FromInt(imm)) ret end
        M_LEA: asl(g, "lea " + regname(r0, psz(g)) + ", " + asm_mem(g, rm_of(g, i), 0)) ret end
        M_ALU_RR: asl(g, k_alun[g.mc.cc[i]] + " " + regname(r0, sz) + ", " + regname(r1, sz)) ret end
        M_ALU_RI: asl(g, k_alun[g.mc.cc[i]] + " " + regname(r0, sz) + ", " + str.FromInt(imm)) ret end
        M_ALU_RM: asl(g, k_alun[g.mc.cc[i]] + " " + regname(r0, sz) + ", " + asm_mem(g, rm_of(g, i), sz)) ret end
        M_ALU_MR: asl(g, k_alun[g.mc.cc[i]] + " " + asm_mem(g, rm_of(g, i), sz) + ", " + regname(r1, sz)) ret end
        M_ALU_MI: asl(g, k_alun[g.mc.cc[i]] + " " + asm_mem(g, rm_of(g, i), sz) + ", " + str.FromInt(imm)) ret end
        M_TEST_RR: asl(g, "test " + regname(r0, sz) + ", " + regname(r1, sz)) ret end
        M_TEST_RI: asl(g, "test " + regname(r0, sz) + ", " + str.FromInt(imm)) ret end
        M_IMUL_RR: asl(g, "imul " + regname(r0, sz) + ", " + (g.mc.mk[i] != MK_NONE ? asm_mem(g, rm_of(g, i), sz) : regname(r1, sz))) ret end
        M_IMUL_RRI: asl(g, "imul " + regname(r0, sz) + ", " + regname(r1, sz) + ", " + str.FromInt(imm)) ret end
        M_SHIFT_RI: asl(g, k_shn[g.mc.cc[i]] + " " + regname(r0, sz) + ", " + str.FromInt(imm)) ret end
        M_SHIFT_RC: asl(g, k_shn[g.mc.cc[i]] + " " + regname(r0, sz) + ", cl") ret end
        M_UNARY: asl(g, (g.mc.cc[i] == UN_NEG ? "neg " : "not ") + regname(r0, sz)) ret end
        M_CQO: asl(g, sz == 8 ? "cqo" : "cdq") ret end
        M_DIV: asl(g, ((g.mc.cc[i] & 1) == 1 ? "idiv " : "div ") + regname(r1, sz)) ret end
        M_MULHI: asl(g, (g.mc.cc[i] == 1 ? "imul " : "mul ") + regname(r1, psz(g))) ret end
        M_SETCC: asl(g, "set" + k_ccn[g.mc.cc[i]] + " " + regname(r0, 1)) ret end
        M_MOVZX_RR: asl(g, "movzx " + regname(r0, 4) + ", " + regname(r1, sz2)) ret end
        M_MOVSX_RR:
            if sz2 == 4:
                asl(g, "movsxd " + regname(r0, 8) + ", " + regname(r1, 4))
            else:
                asl(g, "movsx " + regname(r0, sz) + ", " + regname(r1, sz2))
            end
            ret
        end
        M_CMOV: asl(g, "cmov" + k_ccn[g.mc.cc[i]] + " " + regname(r0, sz) + ", " + (g.mc.mk[i] != MK_NONE ? asm_mem(g, rm_of(g, i), sz) : regname(r1, sz))) ret end
        M_JMP: asl(g, "jmp " + asm_label_name(g, g.mc.tgt[i])) ret end
        M_JCC: asl(g, "j" + k_ccn[g.mc.cc[i]] + " " + asm_label_name(g, g.mc.tgt[i])) ret end
        M_CALL:
            asl(g, "call " + tab_str(g.syms, g.mc.msym[i]))
            asm_call_fix(g, i)
            ret
        end
        M_CALLR:
            asl(g, "call " + regname(r1, psz(g)))
            asm_call_fix(g, i)
            ret
        end
        M_RET: asm_epilogue(g) ret end
        M_UD2: asl(g, "ud2") ret end
        M_XCHG: asl(g, "xchg " + asm_mem(g, rm_of(g, i), sz) + ", " + regname(r0, sz)) ret end
        M_LXADD: asl(g, "lock xadd " + asm_mem(g, rm_of(g, i), sz) + ", " + regname(r0, sz)) ret end
        M_LCMPXCHG: asl(g, "lock cmpxchg " + asm_mem(g, rm_of(g, i), sz) + ", " + regname(r1, sz)) ret end
        M_MFENCE: asl(g, "mfence") ret end
        M_FMOV_RR: asl(g, "movaps " + regname(r0, 16) + ", " + regname(r1, 16)) ret end
        M_FLD: asl(g, asm_sse(sz, "mov") + " " + regname(r0, 16) + ", " + asm_mem(g, rm_of(g, i), sz)) ret end
        M_FST: asl(g, asm_sse(sz, "mov") + " " + asm_mem(g, rm_of(g, i), sz) + ", " + regname(r1, 16)) ret end
        M_FOP_RR, M_FOP_RM:
            mut nm := "add"
            c := g.mc.cc[i]
            if c == FO_MUL: nm = "mul" end
            if c == FO_SUB: nm = "sub" end
            if c == FO_DIV: nm = "div" end
            if op == M_FOP_RR:
                asl(g, asm_sse(sz, nm) + " " + regname(r0, 16) + ", " + regname(r1, 16))
            else:
                asl(g, asm_sse(sz, nm) + " " + regname(r0, 16) + ", " + asm_mem(g, rm_of(g, i), sz))
            end
            ret
        end
        M_SQRT: asl(g, asm_sse(sz, "sqrt") + " " + regname(r0, 16) + ", " + regname(r1, 16)) ret end
        M_UCOMI: asl(g, asm_sse(sz, "ucomi") + " " + regname(r0, 16) + ", " + regname(r1, 16)) ret end
        M_CVTSI2F: asl(g, "cvtsi2" + (sz == 4 ? "ss " : "sd ") + regname(r0, 16) + ", " + regname(r1, sz2)) ret end
        M_CVTF2SI: asl(g, "cvtt" + (sz == 4 ? "ss" : "sd") + "2si " + regname(r0, sz2) + ", " + regname(r1, 16)) ret end
        M_CVTF2F: asl(g, (sz == 8 ? "cvtss2sd " : "cvtsd2ss ") + regname(r0, 16) + ", " + regname(r1, 16)) ret end
        M_MOVQ_XG: asl(g, (sz == 8 ? "movq " : "movd ") + regname(r0, 16) + ", " + regname(r1, sz)) ret end
        M_MOVQ_GX: asl(g, (sz == 8 ? "movq " : "movd ") + regname(r0, sz) + ", " + regname(r1, 16)) ret end
        M_VLD: asl(g, "movups " + regname(r0, 16) + ", " + asm_mem(g, rm_of(g, i), 16)) ret end
        M_VST: asl(g, "movups " + asm_mem(g, rm_of(g, i), 16) + ", " + regname(r1, 16)) ret end
        M_VOP_RR:
            mut vn := "add"
            vc := g.mc.cc[i]
            s1 := g.mc.mk[i] != MK_NONE ? asm_mem(g, rm_of(g, i), 16) : regname(r1, 16)
            if vc == FO_MUL: vn = "mul" end
            if vc == FO_SUB: vn = "sub" end
            if vc == FO_DIV: vn = "div" end
            if vc == 0xD4:
                asl(g, "paddq " + regname(r0, 16) + ", " + s1)
                ret
            end
            if vc == 0xFE:
                asl(g, "paddd " + regname(r0, 16) + ", " + s1)
                ret
            end
            pn := vint_name(vc)
            if pn != "":
                asl(g, pn + " " + regname(r0, 16) + ", " + s1)
                ret
            end
            asl(g, vn + (sz == 8 ? "pd " : "ps ") + regname(r0, 16) + ", " + s1)
            ret
        end
        M_SHUFPS: asl(g, "shufps " + regname(r0, 16) + ", " + regname(r1, 16) + ", " + str.FromInt(imm)) ret end
        M_UNPCKLPD: asl(g, "unpcklpd " + regname(r0, 16) + ", " + regname(r1, 16)) ret end
        M_PSHUFD: asl(g, "pshufd " + regname(r0, 16) + ", " + regname(r1, 16) + ", " + str.FromInt(imm)) ret end
        M_VSHI: asl(g, vshift_name(g.mc.cc[i], g.mc.sz2[i]) + " " + regname(r0, 16) + ", " + str.FromInt(imm)) ret end
        M_VUN:
            cu := g.mc.cc[i]
            asl(g, vun_name(cu) + regname(r0, 16) + ", " + (g.mc.mk[i] != MK_NONE ? asm_mem(g, rm_of(g, i), vun_mem_size(cu, false)) : regname(r1, 16)))
            ret
        end
        M_VBLEND:
            asl(g, "pblendvb " + regname(r0, 16) + ", " + (g.mc.mk[i] != MK_NONE ? asm_mem(g, rm_of(g, i), 16) : regname(r1, 16)) + ", xmm0")
            ret
        end
        M_VLD32: asl(g, "movd " + regname(r0, 16) + ", " + asm_mem(g, rm_of(g, i), 4)) ret end
        M_VST32: asl(g, "movd " + asm_mem(g, rm_of(g, i), 4) + ", " + regname(r1, 16)) ret end
        M_XORPS: asl(g, "xorps " + regname(r0, 16) + ", " + regname(r1, 16)) ret end
        M_ANDPS: asl(g, "andps " + regname(r0, 16) + ", " + regname(r1, 16)) ret end
    end
    asl(g, "# op " + op)
end

func asm_fast_exit(g &: Ng, name: str):
    sz := g.fx_w ? 8 : 4
    rn := regname(g.fx_reg, sz)
    if g.fx_imm == (0 as i64):
        asl(g, "test " + rn + ", " + rn)
    else:
        asl(g, "cmp " + rn + ", " + str.FromInt(g.fx_imm))
    end
    lbl := ".Lfx_" + name
    asl(g, "j" + k_ccn[inv_cc(g.fx_cc)] + " " + lbl)
    if g.fx_kind == 1:
        if g.fx_rimm == (0 as i64):
            asl(g, "xor eax, eax")
        else g.fx_rw and g.fx_rimm < (0 as i64):
            asl(g, "mov rax, " + str.FromInt(g.fx_rimm))
        else:
            asl(g, "mov eax, " + str.FromInt(g.fx_rimm))
        end
    else g.fx_kind == 2:
        asl(g, "mov rax, " + regname(g.fx_rreg, 8))
    end
    asm_ret(g)
    str.BufAppend(g.asm, lbl + ":\n")
end

func asm_alloc(g &: Ng, fsize: int):
    spr := preg(g, RSP)
    if g.os == NG_OS_WINDOWS and fsize >= 4096:
        asl(g, "mov eax, " + fsize)
        asl(g, "call " + tab_str(g.syms, g.sym_chkstk))
        asl(g, "sub " + spr + ", " + preg(g, 0))
    else:
        asl(g, "sub " + spr + ", " + fsize)
    end
end

func asm_function(g &: Ng):
    g.asm_fsym.push(g.f_sym)
    g.asm_fpos.push(str.BufLen(g.asm) as int)
    name := tab_str(g.syms, g.f_sym)
    str.BufAppend(g.asm, "\n    .text\n    .p2align 4\n")
    if not g.sy_local[g.f_sym]:
        str.BufAppend(g.asm, "    .globl " + name + "\n")
    end
    str.BufAppend(g.asm, "    .type " + name + ", @function\n" + name + ":\n")
    if g.fx_on:
        asm_fast_exit(g, name)
    end
    ngp := ngp_count(g)
    if g.mc.fpo:
        repeat ngp in kf:
            asl(g, "push " + preg(g, g.mc.callee_used[kf]))
        end
        if g.mc.fpo_pad > 0:
            asm_alloc(g, g.mc.fpo_pad)
        end
    else:
        asl(g, "push rbp")
        asl(g, "mov rbp, rsp")
        repeat ngp in k:
            asl(g, "push " + k_r64[g.mc.callee_used[k]])
        end
    end
    if g.mc.frame_size > 0 and not g.mc.fpo:
        asm_alloc(g, g.mc.frame_size)
    end
    mut k2 := ngp
    until k2 + 1 < g.mc.callee_used.Len():
        asl(g, "movaps XMMWORD PTR [rbp-" + g.mc.callee_used[k2 + 1] + "], " + regname(g.mc.callee_used[k2], 16))
        k2 += 2
    end
    repeat g.mc.op.Len() in i:
        if g.arch == NG_ARCH_X86:
            asm_ins_x86(g, i)
        else:
            asm_ins(g, i)
        end
    end
    str.BufAppend(g.asm, "    .size " + name + ", .-" + name + "\n")
end

func asm_section_name(sec: int): str:
    switch sec:
        SEC_RODATA: ret "    .section .rodata" end
        SEC_CONST: ret "    .section .rodata.salam,\"a\"" end
        SEC_DATA: ret "    .data" end
        SEC_BSS: ret "    .bss" end
        SEC_INIT: ret "    .section .init_array,\"aw\"" end
        SEC_FINI: ret "    .section .fini_array,\"aw\"" end
    end
    ret "    .text"
end

func sort_pairs(keys &: Vector<int>, vals &: Vector<int>):
    n := keys.Len()
    mut tk := Vector {} as Vector<int>
    mut tv := Vector {} as Vector<int>
    repeat n:
        tk.push(0)
        tv.push(0)
    end
    mut w := 1
    until w < n:
        mut lo := 0
        until lo < n:
            mid := lo + w < n ? lo + w : n
            hi := lo + 2 * w < n ? lo + 2 * w : n
            mut a := lo
            mut b := mid
            mut k := lo
            until k < hi:
                if a < mid and (b >= hi or keys[a] <= keys[b]):
                    tk[k] = keys[a]
                    tv[k] = vals[a]
                    a++
                else:
                    tk[k] = keys[b]
                    tv[k] = vals[b]
                    b++
                end
                k++
            end
            lo += 2 * w
        end
        repeat n in j:
            keys[j] = tk[j]
            vals[j] = tv[j]
        end
        w *= 2
    end
    tk.Free()
    tv.Free()
end

func asm_data(g &: Ng, sec: int):
    n := sec_len(g, sec)
    if n == 0:
        ret
    end
    str.BufAppend(g.asm, "\n" + asm_section_name(sec) + "\n    .p2align " + str.FromInt(log2i(g.sec_align[sec]) as i64) + "\n")
    mut soff := Vector {} as Vector<int>
    mut ssym := Vector {} as Vector<int>
    repeat g.sy_kind.Len() in s:
        if g.sy_def[s] and g.sy_sec[s] == sec:
            soff.push(g.sy_off[s])
            ssym.push(s)
        end
    end
    sort_pairs(soff, ssym)
    mut roff := Vector {} as Vector<int>
    mut rid := Vector {} as Vector<int>
    repeat g.r_sec.Len() in r:
        if g.r_sec[r] == sec:
            roff.push(g.r_off[r])
            rid.push(r)
        end
    end
    sort_pairs(roff, rid)
    mut pos := 0
    mut si := 0
    mut ri := 0
    until pos < n:
        until si < soff.Len() and soff[si] <= pos:
            s2 := ssym[si]
            nm := tab_str(g.syms, s2)
            if not g.sy_local[s2]:
                str.BufAppend(g.asm, "    .globl " + nm + "\n")
            end
            str.BufAppend(g.asm, nm + ":\n")
            si++
        end
        if ri < roff.Len() and roff[ri] == pos:
            r2 := rid[ri]
            r4 := g.r_type[r2] == R_ABS32
            asl(g, (r4 ? ".long " : ".quad ") + tab_str(g.syms, g.r_sym[r2]) + disp_str(g.r_add[r2]))
            pos += r4 ? 4 : 8
            ri++
            continue
        end
        mut stop := n
        if si < soff.Len() and soff[si] < stop:
            stop = soff[si]
        end
        if ri < roff.Len() and roff[ri] < stop:
            stop = roff[ri]
        end
        if sec == SEC_BSS:
            asl(g, ".zero " + (stop - pos))
            pos = stop
            continue
        end
        if stop > pos + 16:
            stop = pos + 16
        end
        mut line := ".byte "
        mut q := pos
        until q < stop:
            if q > pos:
                line += ","
            end
            line += sec_byte(g, sec, q)
            q++
        end
        asl(g, line)
        pos = stop
    end
    soff.Free()
    ssym.Free()
    roff.Free()
    rid.Free()
end

func log2i(v: int): int:
    mut n := 0
    until (1 << n) < v:
        n++
    end
    ret n
end

func write_text(path: str, text: str): bool:
    mut o := Ob {}
    p := sp(text)
    n := str_len_of(text)
    repeat n in i:
        o.b.push(p[i])
    end
    ok := write_file(path, o)
    o.b.Free()
    ret ok
end

func asm_live_text(g &: Ng, b &: str.StringBuilder):
    full := str.BufStr(g.asm)
    total := str.BufLen(g.asm) as int
    nf := g.asm_fsym.Len()
    if nf == 0:
        str.BufAppend(b, full)
        ret
    end
    if g.asm_fpos[0] > 0:
        str.BufAppend(b, str.SubstrIn(full, 0, g.asm_fpos[0]))
    end
    repeat nf in k:
        st := g.asm_fpos[k]
        en := k + 1 < nf ? g.asm_fpos[k + 1] : total
        fs := g.asm_fsym[k]
        if g.sy_live.Len() == 0 or (fs < g.sy_live.Len() and g.sy_live[fs]):
            str.BufAppend(b, str.SubstrIn(full, st, en - st))
        end
    end
end

func vint_name(vc: int): str:
    switch vc:
        0xFA: ret "psubd" end
        0xFB: ret "psubq" end
        0xDB: ret "pand" end
        0xDF: ret "pandn" end
        0xEB: ret "por" end
        0xEF: ret "pxor" end
        0x66: ret "pcmpgtd" end
        0x76: ret "pcmpeqd" end
        0x60: ret "punpcklbw" end
        0x61: ret "punpcklwd" end
        0x6C: ret "punpcklqdq" end
        0x6B: ret "packssdw" end
        0xF4: ret "pmuludq" end
        0xFC: ret "paddb" end
        0xFD: ret "paddw" end
        0xF6: ret "psadbw" end
        0xF9: ret "psubw" end
        0xD5: ret "pmullw" end
        0x75: ret "pcmpeqw" end
        0x65: ret "pcmpgtw" end
        0xD9: ret "psubusw" end
        0xF8: ret "psubb" end
        0x74: ret "pcmpeqb" end
        0x64: ret "pcmpgtb" end
        0xDE: ret "pmaxub" end
        0xDA: ret "pminub" end
        0x62: ret "punpckldq" end
        0x67: ret "packuswb" end
        0xD1: ret "psrlw" end
        0xD2: ret "psrld" end
        0xD3: ret "psrlq" end
        0xE1: ret "psraw" end
        0xE2: ret "psrad" end
        0xF1: ret "psllw" end
        0xF2: ret "pslld" end
        0xF3: ret "psllq" end
        0x3840: ret "pmulld" end
        0x3800: ret "pshufb" end
        0x3829: ret "pcmpeqq" end
        0x3838: ret "pminsb" end
        0x3839: ret "pminsd" end
        0x383A: ret "pminuw" end
        0x383B: ret "pminud" end
        0x383C: ret "pmaxsb" end
        0x383D: ret "pmaxsd" end
        0x383E: ret "pmaxuw" end
        0x383F: ret "pmaxud" end
        0xEA: ret "pminsw" end
        0xEE: ret "pmaxsw" end
    end
    ret ""
end

func vshift_name(opc: int, ext: int): str:
    if opc == 0x71:
        if ext == 2: ret "psrlw" end
        if ext == 4: ret "psraw" end
        ret "psllw"
    end
    if opc == 0x72:
        if ext == 2: ret "psrld" end
        if ext == 4: ret "psrad" end
        ret "pslld"
    end
    if ext == 2: ret "psrlq" end
    ret "psllq"
end

func asm_x86_helpers(g &: Ng):
    mut code := Vector {} as Vector<int>
    repeat 7 in k:
        nm := x86_helper_code(k, code)
        s := sym_named(g, nm)
        if g.sy_used[s] and not g.sy_def[s]:
            str.BufAppend(g.asm, "\n    .text\n    .p2align 4\n" + nm + ":\n")
            mut line := ""
            repeat code.Len() in q:
                line = line + (q % 16 == 0 ? ".byte " : ",") + str.FromInt(code[q] as i64)
                if q % 16 == 15 or q + 1 == code.Len():
                    asl(g, line)
                    line = ""
                end
            end
        end
    end
    code.Free()
end

pub func WriteAsm(g &: Ng, path: str): bool:
    if g.opt and not g.dce_done:
        gdce(g)
        g.dce_done = true
    end
    mut b := str.NewBuilder()
    str.BufAppend(b, "    .intel_syntax noprefix\n")
    asm_live_text(g, b)
    hold := g.asm
    g.asm = b
    if g.arch == NG_ARCH_X86:
        asm_x86_helpers(g)
    end
    asm_data(g, SEC_RODATA)
    asm_data(g, SEC_CONST)
    asm_data(g, SEC_DATA)
    asm_data(g, SEC_BSS)
    asm_data(g, SEC_INIT)
    asm_data(g, SEC_FINI)
    str.BufAppend(g.asm, "\n    .section .note.GNU-stack,\"\",@progbits\n")
    ok := write_text(path, str.BufStr(g.asm))
    mut done := g.asm
    g.asm = hold
    str.BufFree(done)
    ret ok
end
