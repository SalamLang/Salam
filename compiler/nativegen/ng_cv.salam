package nativegen

import str

const CV_SYMBOLS := 0xF1
const CV_LINES := 0xF2
const CV_STRINGS := 0xF3
const CV_CHECKSUMS := 0xF4

func cv_put16(v &: Vector<u8>, at: int, x: int):
    v[at] = (x & 255) as u8
    v[at + 1] = ((x >> 8) & 255) as u8
end

func cv_pad4(v &: Vector<u8>):
    until v.len() % 4 != 0:
        v.push(0 as u8)
    end
end

func cv_sub_begin(v &: Vector<u8>, kind: int): int:
    vb_le(v, kind as i64, 4)
    at := v.len()
    vb_le(v, 0 as i64, 4)
    ret at
end

func cv_sub_end(v &: Vector<u8>, at: int):
    vb_put32(v, at, (v.len() - at - 4) as i64)
    cv_pad4(v)
end

func cv_rec_begin(v &: Vector<u8>, kind: int): int:
    at := v.len()
    vb_le(v, 0 as i64, 2)
    vb_le(v, kind as i64, 2)
    ret at
end

func cv_rec_end(v &: Vector<u8>, at: int):
    cv_pad4(v)
    cv_put16(v, at, v.len() - at - 2)
end

func cv_secrel(g &: Ng, v &: Vector<u8>, sym: int, add: i64):
    add_reloc(g, SEC_CVSYM, v.len(), sym, R_CV_SECREL, add)
    vb_le(v, 0 as i64, 4)
    add_reloc(g, SEC_CVSYM, v.len(), sym, R_CV_SECTION, 0 as i64)
    vb_le(v, 0 as i64, 2)
end

func cv_machine(g &: Ng): int:
    if g.arch == NG_ARCH_A64: ret 0xF6 end
    if g.arch == NG_ARCH_X86: ret 0x03 end
    ret 0xD0
end

func cv_path(g &: Ng, fmd: int): str:
    nm := g.md_s1[fmd]
    d := g.md_s2[fmd]
    if str.Len(d) == 0 or str.StartsWith(nm, "/") or str.StartsWith(nm, "\\") or str.IndexOf(nm, ":") == 1:
        ret nm
    end
    sep := str.Contains(d, "\\") ? "\\" : "/"
    if str.EndsWith(d, sep):
        ret d + nm
    end
    ret d + sep + nm
end

func cv_file_of(g &: Ng, r: int): int:
    f := g.dl_file[r]
    ret f < 0 ? 0 - f : f
end

func cv_pc_secrel(g &: Ng, v &: Vector<u8>, k: int, pc: int):
    s := g.df_sym[k]
    if g.sy_def[s] and g.sy_sec[s] == SEC_TEXT:
        cv_secrel(g, v, s, (pc - g.sy_off[s]) as i64)
        ret
    end
    cv_secrel(g, v, g.cv_text, pc as i64)
end

func cv_fn_secrel(g &: Ng, v &: Vector<u8>, k: int):
    cv_pc_secrel(g, v, k, g.df_base[k])
end

func cv_basic(g &: Ng, md: int): int:
    bs := g.md_sz[md] / 8
    e := g.md_a[md]
    if e == 2:
        ret 0x30
    end
    if e == 4:
        ret bs == 4 ? 0x40 : (bs == 8 ? 0x41 : 0)
    end
    if e == 6 and bs == 1:
        ret 0x10
    end
    if e == 8 and bs == 1:
        ret 0x20
    end
    uns := e == 7 or e == 8
    switch bs:
        1: ret uns ? 0x69 : 0x68 end
        2: ret uns ? 0x73 : 0x72 end
        4: ret uns ? 0x75 : 0x74 end
        8: ret uns ? 0x77 : 0x76 end
    end
    ret 0
end

func cv_trec_begin(g &: Ng, kind: int): int:
    if g.s_cvtyp.len() == 0:
        vb_le(g.s_cvtyp, 4 as i64, 4)
    end
    at := g.s_cvtyp.len()
    vb_le(g.s_cvtyp, 0 as i64, 2)
    vb_le(g.s_cvtyp, kind as i64, 2)
    ret at
end

func cv_tpad(v &: Vector<u8>):
    until v.len() % 4 != 0:
        v.push((0xF0 + (4 - v.len() % 4)) as u8)
    end
end

func cv_trec_end(g &: Ng, at: int): int:
    cv_tpad(g.s_cvtyp)
    cv_put16(g.s_cvtyp, at, g.s_cvtyp.len() - at - 2)
    ix := 0x1000 + g.cv_nt
    g.cv_nt += 1
    ret ix
end

func cv_udt_name(g &: Ng, md: int): str:
    nm := g.md_s1[md]
    ret str.Len(nm) > 0 ? nm : "<anon>"
end

func cv_udt_tail(g &: Ng, md: int):
    vb_str(g.s_cvtyp, cv_udt_name(g, md))
    vb_str(g.s_cvtyp, "salam." + str.FromInt(md as i64))
end

func cv_fwd_struct(g &: Ng, md: int): int:
    if g.cv_tmap.has(md):
        ret g.cv_tmap.get(md)
    end
    if g.cv_fwd.has(md):
        ret g.cv_fwd.get(md)
    end
    at := cv_trec_begin(g, 0x1505)
    vb_le(g.s_cvtyp, 0 as i64, 2)
    vb_le(g.s_cvtyp, 0x280 as i64, 2)
    vb_le(g.s_cvtyp, 0 as i64, 12)
    cv_numeric(g.s_cvtyp, 0 as i64)
    cv_udt_tail(g, md)
    ix := cv_trec_end(g, at)
    g.cv_fwd.put(md, ix)
    ret ix
end

func cv_members(g &: Ng, md: int, want: int, out &: Vector<int>):
    el := g.md_el[md]
    if el < 0 or el >= g.md_kind.len() or g.md_kind[el] != 9:
        ret
    end
    repeat g.md_ln[el] in q:
        m := g.md_pool[g.md_l0[el] + q]
        if m >= 0 and m < g.md_kind.len() and g.md_kind[m] == want and (want != 6 or g.md_tag[m] == 0x0d):
            out.push(m)
        end
    end
end

func cv_struct(g &: Ng, md: int): int:
    if g.cv_tmap.has(md):
        ret g.cv_tmap.get(md)
    end
    mut ms := Vector {} as Vector<int>
    cv_members(g, md, 6, ms)
    mut tys := Vector {} as Vector<int>
    each m in ms:
        tys.push(cv_type(g, g.md_t[m]))
    end
    fl := cv_trec_begin(g, 0x1203)
    mut cnt := 0
    repeat ms.len() in k:
        if tys[k] == 0:
            continue
        end
        m2 := ms[k]
        vb_le(g.s_cvtyp, 0x150D as i64, 2)
        vb_le(g.s_cvtyp, 3 as i64, 2)
        vb_le(g.s_cvtyp, tys[k] as i64, 4)
        cv_numeric(g.s_cvtyp, (g.md_off[m2] / 8) as i64)
        vb_str(g.s_cvtyp, g.md_s1[m2])
        cv_tpad(g.s_cvtyp)
        cnt += 1
    end
    fi := cv_trec_end(g, fl)
    at := cv_trec_begin(g, 0x1505)
    vb_le(g.s_cvtyp, cnt as i64, 2)
    vb_le(g.s_cvtyp, 0x200 as i64, 2)
    vb_le(g.s_cvtyp, fi as i64, 4)
    vb_le(g.s_cvtyp, 0 as i64, 8)
    cv_numeric(g.s_cvtyp, (g.md_sz[md] / 8) as i64)
    cv_udt_tail(g, md)
    ix := cv_trec_end(g, at)
    g.cv_tmap.put(md, ix)
    ms.free()
    tys.free()
    ret ix
end

func cv_enum(g &: Ng, md: int): int:
    if g.cv_tmap.has(md):
        ret g.cv_tmap.get(md)
    end
    mut ms := Vector {} as Vector<int>
    cv_members(g, md, 12, ms)
    fl := cv_trec_begin(g, 0x1203)
    each m in ms:
        vb_le(g.s_cvtyp, 0x1502 as i64, 2)
        vb_le(g.s_cvtyp, 3 as i64, 2)
        cv_numeric(g.s_cvtyp, g.md_a[m] as i64)
        vb_str(g.s_cvtyp, g.md_s1[m])
        cv_tpad(g.s_cvtyp)
    end
    fi := cv_trec_end(g, fl)
    mut ut := 0x74
    switch g.md_sz[md] / 8:
        1: ut = 0x68 break end
        2: ut = 0x72 break end
        8: ut = 0x76 break end
    end
    at := cv_trec_begin(g, 0x1507)
    vb_le(g.s_cvtyp, ms.len() as i64, 2)
    vb_le(g.s_cvtyp, 0x200 as i64, 2)
    vb_le(g.s_cvtyp, ut as i64, 4)
    vb_le(g.s_cvtyp, fi as i64, 4)
    cv_udt_tail(g, md)
    ix := cv_trec_end(g, at)
    g.cv_tmap.put(md, ix)
    ms.free()
    ret ix
end

func cv_array(g &: Ng, md: int): int:
    if g.cv_tmap.has(md):
        ret g.cv_tmap.get(md)
    end
    et := cv_type(g, g.md_t[md])
    if et == 0:
        ret 0
    end
    at := cv_trec_begin(g, 0x1503)
    vb_le(g.s_cvtyp, et as i64, 4)
    vb_le(g.s_cvtyp, (g.wsz == 4 ? 0x75 : 0x77) as i64, 4)
    cv_numeric(g.s_cvtyp, (g.md_sz[md] / 8) as i64)
    g.s_cvtyp.push(0 as u8)
    ix := cv_trec_end(g, at)
    g.cv_tmap.put(md, ix)
    ret ix
end

func cv_pointer(g &: Ng, md: int): int:
    if g.cv_tmap.has(md):
        ret g.cv_tmap.get(md)
    end
    pt := g.md_t[md]
    simple := g.wsz == 4 ? 0x400 : 0x600
    if pt < 0 or pt >= g.md_kind.len():
        ret simple | 0x03
    end
    if g.md_kind[pt] == 5 and g.md_sz[pt] == 8 and (g.md_a[pt] == 6 or g.md_a[pt] == 8):
        ret simple | 0x70
    end
    mut tgt := 0
    mut p2 := pt
    repeat 8:
        if p2 < 0 or p2 >= g.md_kind.len() or g.md_kind[p2] != 6 or g.md_tag[p2] == 0x0f:
            break
        end
        p2 = g.md_t[p2]
    end
    if p2 >= 0 and p2 < g.md_kind.len() and g.md_kind[p2] == 7 and g.md_tag[p2] == 0x13:
        tgt = cv_fwd_struct(g, p2)
    else:
        tgt = cv_type(g, pt)
    end
    if tgt == 0:
        ret simple | 0x03
    end
    if tgt < 0x1000 and (tgt & 0xF00) == 0:
        ret simple | tgt
    end
    at := cv_trec_begin(g, 0x1002)
    vb_le(g.s_cvtyp, tgt as i64, 4)
    vb_le(g.s_cvtyp, ((g.wsz == 4 ? 0x0A : 0x0C) | ((g.wsz == 4 ? 4 : 8) << 13)) as i64, 4)
    ix := cv_trec_end(g, at)
    g.cv_tmap.put(md, ix)
    ret ix
end

func cv_type(g &: Ng, md0: int): int:
    mut md := md0
    repeat 8:
        if md < 0 or md >= g.md_kind.len():
            ret 0
        end
        k := g.md_kind[md]
        if k == 5:
            ret cv_basic(g, md)
        end
        if k == 6 and g.md_tag[md] == 0x0f:
            ret cv_pointer(g, md)
        end
        if k == 7 and g.md_tag[md] == 0x04:
            ret cv_enum(g, md)
        end
        if k == 7 and g.md_tag[md] == 0x13:
            ret cv_struct(g, md)
        end
        if k == 7 and g.md_tag[md] == 0x01:
            ret cv_array(g, md)
        end
        if k != 6:
            ret 0
        end
        md = g.md_t[md]
    end
    ret 0
end

func cv_reg(g &: Ng, dw: int, bs: int): int:
    if g.arch == NG_ARCH_X86:
        if dw >= 0 and dw < 8:
            ret 17 + dw
        end
        ret dw >= 21 and dw < 29 ? 154 + dw - 21 : 0
    end
    if g.arch == NG_ARCH_A64:
        if dw >= 0 and dw < 29:
            ret bs == 4 ? 10 + dw : 50 + dw
        end
        if dw == 29: ret 79 end
        if dw == 30: ret 80 end
        if dw == 31: ret 81 end
        if dw >= 64 and dw < 96:
            v := dw - 64
            ret bs == 4 ? 100 + v : (bs == 8 ? 140 + v : 180 + v)
        end
        ret 0
    end
    if dw >= 17 and dw < 33:
        x := dw - 17
        ret x < 8 ? 154 + x : 252 + x - 8
    end
    if dw < 0 or dw >= 16:
        ret 0
    end
    if dw >= 8:
        ret bs == 4 ? 360 + dw - 8 : 336 + dw - 8
    end
    k64 := [328, 331, 330, 329, 332, 333, 334, 335]
    k32 := [17, 19, 18, 20, 23, 24, 22, 21]
    ret bs == 4 ? k32[dw] : k64[dw]
end

func cv_frame_reg(g &: Ng, k: int): int:
    use_sp := k == 3
    if g.arch == NG_ARCH_X86:
        ret use_sp ? 21 : 22
    end
    if g.arch == NG_ARCH_A64:
        ret use_sp ? 81 : 79
    end
    ret use_sp ? 335 : 334
end

func cv_defrange(g &: Ng, v &: Vector<u8>, k: int, s0: int, e0: int, lk: int, lp: i64, lx: int, bs: int):
    cv_defrange_sub(g, v, k, s0, e0, lk, lp, lx, bs, 0 - 1)
end

func cv_defrange_sub(g &: Ng, v &: Vector<u8>, k: int, s0: int, e0: int, lk: int, lp: i64, lx: int, bs: int, sub: int):
    mut reg := 0
    mut off := 0 as i64
    mut rel := true
    if lk == 1:
        if bs > 8:
            ret
        end
        reg = cv_reg(g, lp as int, bs)
        rel = false
    else lk == 3 or lk == 8:
        reg = cv_frame_reg(g, lk)
        off = lp
    else lk == 6:
        reg = cv_reg(g, lp as int, 8)
        off = lx as i64
    end
    if reg == 0:
        ret
    end
    mut s := s0
    until s < e0:
        n := e0 - s < 0xFFFF ? e0 - s : 0xFFFF
        r := cv_rec_begin(v, rel ? 0x1145 : (sub >= 0 ? 0x1143 : 0x1141))
        vb_le(v, reg as i64, 2)
        if rel:
            vb_le(v, (sub >= 0 ? 1 | (sub << 4) : 0) as i64, 2)
            vb_le(v, off, 4)
        else sub >= 0:
            vb_le(v, 0 as i64, 2)
            vb_le(v, sub as i64, 4)
        else:
            vb_le(v, 0 as i64, 2)
        end
        cv_pc_secrel(g, v, k, s)
        vb_le(v, n as i64, 2)
        cv_rec_end(v, r)
        s = s + n
    end
end

func cv_numeric(v &: Vector<u8>, x: i64):
    if x >= (0 as i64) and x < (0x8000 as i64):
        vb_le(v, x, 2)
    else x >= (0 - 0x80000000 as i64) and x <= (0x7FFFFFFF as i64):
        vb_le(v, 0x8003 as i64, 2)
        vb_le(v, x, 4)
    else:
        vb_le(v, 0x8009 as i64, 2)
        vb_le(v, x, 8)
    end
end

func cv_locals(g &: Ng, v &: Vector<u8>, tys &: DvTypes, k: int):
    mut seen := HashMap {} as HashMap<int, int>
    repeat g.gv_md.len() in gv:
        if gv >= g.gv_df.len() or g.gv_df[gv] != k or g.gv_foff[gv] >= 0:
            continue
        end
        md := g.gv_md[gv]
        if seen.has(md):
            continue
        end
        h := gv < tys.le_head.len() ? tys.le_head[gv] : 0 - 1
        if not g.gv_mem[gv] and h < 0:
            continue
        end
        ty := cv_type(g, g.md_t[md])
        if ty == 0:
            continue
        end
        seen.put(md, 1)
        bs := dv_type_bytes(g, g.md_t[md])
        mut cst := not g.gv_mem[gv]
        mut e0 := h
        until cst and e0 >= 0:
            if g.le_k[e0] != 2 or g.le_p[e0] != g.le_p[h]:
                cst = false
            end
            e0 = tys.le_next[e0]
        end
        if cst:
            rc := cv_rec_begin(v, 0x1107)
            vb_le(v, ty as i64, 4)
            cv_numeric(v, g.le_p[h])
            vb_str(v, g.md_s1[md])
            cv_rec_end(v, rc)
            continue
        end
        r := cv_rec_begin(v, 0x113E)
        vb_le(v, ty as i64, 4)
        vb_le(v, (g.md_a[md] > 0 ? 1 : 0) as i64, 2)
        vb_str(v, g.md_s1[md])
        cv_rec_end(v, r)
        base := g.df_base[k]
        if g.gv_mem[gv]:
            cv_defrange(g, v, k, base, base + g.df_size[k], g.gv_mk[gv], g.gv_moff[gv], 0, bs)
            continue
        end
        mut e := h
        until e >= 0:
            cv_defrange(g, v, k, g.le_s[e], g.le_e[e], g.le_k[e], g.le_p[e], g.le_x[e], bs)
            e = tys.le_next[e]
        end
    end
    repeat g.gv_md.len() in fv:
        if fv >= g.gv_df.len() or g.gv_df[fv] != k or g.gv_foff[fv] < 0:
            continue
        end
        fmd := g.gv_md[fv]
        if seen.has(fmd):
            continue
        end
        fty := cv_type(g, g.md_t[fmd])
        if fty == 0:
            continue
        end
        seen.put(fmd, 1)
        fr := cv_rec_begin(v, 0x113E)
        vb_le(v, fty as i64, 4)
        vb_le(v, (g.md_a[fmd] > 0 ? 1 : 0) as i64, 2)
        vb_str(v, g.md_s1[fmd])
        cv_rec_end(v, fr)
        repeat g.gv_md.len() - fv in d0:
            q := fv + d0
            if q >= g.gv_df.len() or g.gv_df[q] != k or g.gv_md[q] != fmd or g.gv_foff[q] < 0 or g.gv_foff[q] >= 4096:
                continue
            end
            hq := q < tys.le_head.len() ? tys.le_head[q] : 0 - 1
            mut e3 := hq
            until e3 >= 0:
                cv_defrange_sub(g, v, k, g.le_s[e3], g.le_e[e3], g.le_k[e3], g.le_p[e3], g.le_x[e3], g.gv_fsz[q], g.gv_foff[q])
                e3 = tys.le_next[e3]
            end
        end
    end
    seen.free()
end

func cv_func_id(g &: Ng, spm: int): int:
    if g.cv_fid.has(spm):
        ret g.cv_fid.get(spm)
    end
    if g.cv_proc0 == 0:
        al := cv_trec_begin(g, 0x1201)
        vb_le(g.s_cvtyp, 0 as i64, 4)
        ali := cv_trec_end(g, al)
        pr := cv_trec_begin(g, 0x1008)
        vb_le(g.s_cvtyp, 0x03 as i64, 4)
        vb_le(g.s_cvtyp, 0 as i64, 4)
        vb_le(g.s_cvtyp, ali as i64, 4)
        g.cv_proc0 = cv_trec_end(g, pr)
    end
    at := cv_trec_begin(g, 0x1601)
    vb_le(g.s_cvtyp, 0 as i64, 4)
    vb_le(g.s_cvtyp, g.cv_proc0 as i64, 4)
    mut nm := g.md_s1[spm]
    if str.Len(nm) == 0:
        nm = "<inlined>"
    end
    vb_str(g.s_cvtyp, nm)
    ix := cv_trec_end(g, at)
    g.cv_fid.put(spm, ix)
    g.cv_il_id.push(ix)
    g.cv_il_sp.push(spm)
    ret ix
end

func cv_ba_uint(v &: Vector<u8>, x: int):
    if x < 0x80:
        v.push(x as u8)
    else x < 0x4000:
        v.push((0x80 | (x >> 8)) as u8)
        v.push((x & 255) as u8)
    else:
        v.push((0xC0 | ((x >> 24) & 0x1F)) as u8)
        v.push(((x >> 16) & 255) as u8)
        v.push(((x >> 8) & 255) as u8)
        v.push((x & 255) as u8)
    end
end

func cv_ba_sint(v &: Vector<u8>, x: int):
    cv_ba_uint(v, x >= 0 ? x << 1 : ((0 - x) << 1) | 1)
end

func cv_child_sites(t &: DbgTree, nd: int, out &: Vector<int>):
    mut c := t.kid[nd]
    until c >= 0:
        if t.kind[c] == 0:
            out.push(c)
        else:
            cv_child_sites(t, c, out)
        end
        c = t.sib[c]
    end
end

func cv_site_lines(g &: Ng, t &: DbgTree, nd: int, base: int, ann &: Vector<u8>):
    spm := t.sp[nd]
    fmd := g.md_file[spm]
    fi := fmd >= 0 ? dbg_file_index(g, fmd) : 0 - 1
    mut cur_line := g.md_line[spm]
    mut cur_off := 0
    mut r := t.iv0[nd]
    until r >= 0:
        s := t.ivs[r] - base
        e := t.ive[r] - base
        mut eo := Vector {} as Vector<int>
        mut el := Vector {} as Vector<int>
        mut kids := Vector {} as Vector<int>
        cv_child_sites(t, nd, kids)
        repeat g.dl_off.len() in q:
            o := g.dl_off[q] - base
            if o < s or o >= e or cv_file_of(g, q) != fi:
                continue
            end
            mut inkid := false
            each ch in kids:
                mut cr := t.iv0[ch]
                until cr >= 0:
                    if o + base >= t.ivs[cr] and o + base < t.ive[cr]:
                        inkid = true
                    end
                    cr = t.ivn[cr]
                end
            end
            if inkid:
                continue
            end
            if eo.len() > 0 and eo[eo.len() - 1] == o:
                el[el.len() - 1] = g.dl_line[q]
                continue
            end
            eo.push(o)
            el.push(g.dl_line[q])
        end
        each ch2 in kids:
            cl := g.md_line[g.lt_md[t.loc[ch2]]]
            mut cr2 := t.iv0[ch2]
            until cr2 >= 0:
                co := t.ivs[cr2] - base
                if co >= s and co < e:
                    mut pos := 0
                    until pos < eo.len() and eo[pos] < co:
                        pos += 1
                    end
                    if pos < eo.len() and eo[pos] == co:
                        el[pos] = cl
                    else:
                        eo.insert(pos, co)
                        el.insert(pos, cl)
                    end
                end
                cr2 = t.ivn[cr2]
            end
        end
        kids.free()
        if eo.len() == 0 or eo[0] > s:
            eo.insert(0, s)
            el.insert(0, cur_line)
        end
        repeat eo.len() in k:
            if el[k] != cur_line:
                ann.push(6 as u8)
                cv_ba_sint(ann, el[k] - cur_line)
                cur_line = el[k]
            end
            ann.push(3 as u8)
            cv_ba_uint(ann, eo[k] - cur_off)
            cur_off = eo[k]
        end
        ann.push(4 as u8)
        cv_ba_uint(ann, e - cur_off)
        eo.free()
        el.free()
        r = t.ivn[r]
    end
end

func cv_sites(g &: Ng, v &: Vector<u8>, t &: DbgTree, nd: int, base: int):
    if t.kind[nd] == 0 and t.iv0[nd] >= 0 and t.sp[nd] >= 0:
        fid := cv_func_id(g, t.sp[nd])
        r := cv_rec_begin(v, 0x114D)
        vb_le(v, 0 as i64, 4)
        vb_le(v, 0 as i64, 4)
        vb_le(v, fid as i64, 4)
        mut ann := Vector {} as Vector<u8>
        cv_site_lines(g, t, nd, base, ann)
        each b in ann:
            v.push(b)
        end
        ann.free()
        cv_rec_end(v, r)
        mut c := t.kid[nd]
        until c >= 0:
            cv_sites(g, v, t, c, base)
            c = t.sib[c]
        end
        re := cv_rec_begin(v, 0x114E)
        cv_rec_end(v, re)
        ret
    end
    mut c2 := t.kid[nd]
    until c2 >= 0:
        cv_sites(g, v, t, c2, base)
        c2 = t.sib[c2]
    end
end

func cv_inlines(g &: Ng, v &: Vector<u8>, k: int):
    mut t := DbgTree {}
    base := g.df_base[k]
    dt_build(g, t, base, base + g.df_size[k])
    repeat t.loc.len() in nd:
        if t.par[nd] < 0:
            cv_sites(g, v, t, nd, base)
        end
    end
end

func cv_top_sites(t &: DbgTree, nd: int, out &: Vector<int>):
    if t.kind[nd] == 0:
        out.push(nd)
        ret
    end
    mut c := t.kid[nd]
    until c >= 0:
        cv_top_sites(t, c, out)
        c = t.sib[c]
    end
end

func cv_lines(g &: Ng, v &: Vector<u8>, k: int):
    base := g.df_base[k]
    stop := base + g.df_size[k]
    mut ro := Vector {} as Vector<int>
    mut rl := Vector {} as Vector<int>
    mut rf := Vector {} as Vector<int>
    repeat g.dl_off.len() in r:
        if g.dl_off[r] >= base and g.dl_off[r] < stop:
            ro.push(g.dl_off[r])
            rl.push(g.dl_line[r])
            rf.push(cv_file_of(g, r))
        end
    end
    if ro.len() == 0:
        ro.free()
        rl.free()
        rf.free()
        ret
    end
    mut t := DbgTree {}
    dt_build(g, t, base, stop)
    mut tops := Vector {} as Vector<int>
    repeat t.loc.len() in nd:
        if t.par[nd] < 0:
            cv_top_sites(t, nd, tops)
        end
    end
    each st in tops:
        cmd := g.lt_md[t.loc[st]]
        cf := dbg_file_of(g, cmd)
        if cf < 0:
            continue
        end
        cfi := dbg_file_index(g, cf)
        cln := g.md_line[cmd]
        mut cr := t.iv0[st]
        until cr >= 0:
            repeat ro.len() in q0:
                if ro[q0] >= t.ivs[cr] and ro[q0] < t.ive[cr]:
                    rl[q0] = cln
                    rf[q0] = cfi
                end
            end
            cr = t.ivn[cr]
        end
    end
    tops.free()
    at := cv_sub_begin(v, CV_LINES)
    cv_fn_secrel(g, v, k)
    vb_le(v, 0 as i64, 2)
    vb_le(v, g.df_size[k] as i64, 4)
    mut r0 := 0
    until r0 < ro.len():
        f := rf[r0]
        mut r1 := r0
        until r1 + 1 < ro.len() and rf[r1 + 1] == f:
            r1 += 1
        end
        n := r1 - r0 + 1
        vb_le(v, (8 * (f - 1)) as i64, 4)
        vb_le(v, n as i64, 4)
        vb_le(v, (12 + 8 * n) as i64, 4)
        repeat n in q:
            r := r0 + q
            vb_le(v, (ro[r] - base) as i64, 4)
            vb_le(v, ((rl[r] & 0xFFFFFF) as i64) | (0x80000000 as i64), 4)
        end
        r0 = r1 + 1
    end
    cv_sub_end(v, at)
    ro.free()
    rl.free()
    rf.free()
end

func cv_emit(g &: Ng, ts: int, tys &: DvTypes):
    g.cv_text = ts
    mut v := Vector {} as Vector<u8>
    vb_le(v, 4 as i64, 4)
    sa := cv_sub_begin(v, CV_SYMBOLS)
    mut cu := ""
    repeat g.md_kind.len() in m:
        if str.Len(cu) == 0 and g.md_kind[m] == 3:
            cu = cv_path(g, m)
        end
    end
    r1 := cv_rec_begin(v, 0x1101)
    vb_le(v, 0 as i64, 4)
    vb_str(v, cu)
    cv_rec_end(v, r1)
    r2 := cv_rec_begin(v, 0x113C)
    vb_le(v, 0 as i64, 4)
    vb_le(v, cv_machine(g) as i64, 2)
    repeat 8:
        vb_le(v, 0 as i64, 2)
    end
    vb_str(v, "salam")
    cv_rec_end(v, r2)
    repeat g.df_sym.len() in k:
        spm := g.df_sp[k]
        s := g.df_sym[k]
        mut nm := g.md_s1[spm]
        if str.Len(nm) == 0:
            nm = tab_str(g.syms, s)
        end
        rp := cv_rec_begin(v, g.sy_local[s] ? 0x110F : 0x1110)
        repeat 3:
            vb_le(v, 0 as i64, 4)
        end
        vb_le(v, g.df_size[k] as i64, 4)
        vb_le(v, 0 as i64, 4)
        vb_le(v, g.df_size[k] as i64, 4)
        vb_le(v, 0 as i64, 4)
        cv_fn_secrel(g, v, k)
        v.push(0 as u8)
        vb_str(v, nm)
        cv_rec_end(v, rp)
        cv_locals(g, v, tys, k)
        cv_inlines(g, v, k)
        re := cv_rec_begin(v, 0x0006)
        cv_rec_end(v, re)
    end
    cv_sub_end(v, sa)
    repeat g.df_sym.len() in k2:
        cv_lines(g, v, k2)
    end
    if g.cv_il_id.len() > 0:
        il := cv_sub_begin(v, 0xF6)
        vb_le(v, 0 as i64, 4)
        repeat g.cv_il_id.len() in q:
            sp2 := g.cv_il_sp[q]
            fm := g.md_file[sp2]
            fx := fm >= 0 ? dbg_file_index(g, fm) : 1
            vb_le(v, g.cv_il_id[q] as i64, 4)
            vb_le(v, (8 * (fx - 1)) as i64, 4)
            vb_le(v, g.md_line[sp2] as i64, 4)
        end
        cv_sub_end(v, il)
    end
    mut strs := Vector {} as Vector<u8>
    strs.push(0 as u8)
    sc := cv_sub_begin(v, CV_CHECKSUMS)
    each fmd in g.dfiles:
        vb_le(v, strs.len() as i64, 4)
        vb_le(v, 0 as i64, 4)
        vb_str(strs, cv_path(g, fmd))
    end
    cv_sub_end(v, sc)
    st := cv_sub_begin(v, CV_STRINGS)
    each b in strs:
        v.push(b)
    end
    cv_sub_end(v, st)
    strs.free()
    g.s_cvsym = v
end
