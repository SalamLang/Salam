package nativegen

import str

struct DbgTree:
    pub map: HashMap<int, int> = HashMap {}
    pub lmap: HashMap<i64, int> = HashMap {}
    pub kind: Vector<int> = Vector {}
    pub bmd: Vector<int> = Vector {}
    pub ctx: Vector<int> = Vector {}
    pub loc: Vector<int> = Vector {}
    pub par: Vector<int> = Vector {}
    pub sp: Vector<int> = Vector {}
    pub iv0: Vector<int> = Vector {}
    pub iv1: Vector<int> = Vector {}
    pub kid: Vector<int> = Vector {}
    pub kid_last: Vector<int> = Vector {}
    pub sib: Vector<int> = Vector {}
    pub ivs: Vector<int> = Vector {}
    pub ive: Vector<int> = Vector {}
    pub ivn: Vector<int> = Vector {}
end

func md_grow(g &: Ng, n: int):
    until g.md_kind.Len() <= n:
        g.md_kind.Push(0)
        g.md_line.Push(0)
        g.md_scope.Push(0 - 1)
        g.md_file.Push(0 - 1)
        g.md_s1.Push("")
        g.md_s2.Push("")
        g.md_a.Push(0)
        g.md_t.Push(0 - 1)
        g.md_sz.Push(0)
        g.md_off.Push(0)
        g.md_tag.Push(0)
        g.md_el.Push(0 - 1)
        g.md_l0.Push(0)
        g.md_ln.Push(0)
    end
end

func find_in_line(g &: Ng, from: int, upto: int, w: str): int:
    n := str.Len(w)
    wp := sp(w)
    mut i := from
    until i + n <= upto:
        mut ok := true
        mut k := 0
        until k < n and ok:
            if g.src[i + k] != wp[k]:
                ok = false
            end
            k++
        end
        if ok:
            ret i + n
        end
        i++
    end
    ret 0 - 1
end

func num_at(g &: Ng, at: int): int:
    mut v := 0
    mut i := at
    until i < g.sn and g.src[i] >= (48 as u8) and g.src[i] <= (57 as u8):
        v = v * 10 + ((g.src[i] as int) - 48)
        i++
    end
    ret v
end

func qstr_at(g &: Ng, at: int): str:
    mut b := str.NewBuilder()
    mut i := at
    until i < g.sn and g.src[i] != (34 as u8):
        str.BufAppendChar(b, g.src[i] as int)
        i++
    end
    r := str.BufStr(b)
    str.BufFree(b)
    ret r
end

func dbg_tail(g &: Ng, p: int, e: int): int:
    mut q := e
    until q > p and (g.src[q - 1] == (32 as u8) or g.src[q - 1] == (123 as u8) or g.src[q - 1] == (13 as u8)):
        q--
    end
    mut d := q
    until d > p and g.src[d - 1] >= (48 as u8) and g.src[d - 1] <= (57 as u8):
        d--
    end
    if d == q or d - 7 < p:
        ret 0 - 1
    end
    if find_in_line(g, d - 7, d, " !dbg !") != d:
        ret 0 - 1
    end
    ret d
end

func prescan_dbg(g &: Ng):
    mut p := 0
    mut any := false
    until p < g.sn:
        mut e := p
        until e < g.sn and g.src[e] != (10 as u8):
            e++
        end
        if g.src[p] == (32 as u8) and dv_declare_line(g, p, e):
            p = e + 1
            continue
        end
        if g.src[p] == (32 as u8) or g.src[p] == (100 as u8) or g.src[p] == (64 as u8):
            at := dbg_tail(g, p, e)
            if at >= 0 and g.src[p] == (64 as u8):
                dv_global_line(g, p, e, num_at(g, at))
            end
            if at >= 0:
                g.dbg_eol.Put(e, num_at(g, at))
                mut z := at - 7
                if z > p and g.src[z - 1] == (44 as u8):
                    z--
                end
                until z < e and ((g.src[z] >= (48 as u8) and g.src[z] <= (57 as u8)) or z < at):
                    g.src[z] = 32 as u8
                    z++
                end
            end
        end
        if g.src[p] == (33 as u8) and p + 1 < e and g.src[p + 1] >= (48 as u8) and g.src[p + 1] <= (57 as u8):
            id := num_at(g, p + 1)
            loc := find_in_line(g, p, e, "!DILocation(")
            sub := find_in_line(g, p, e, "!DISubprogram(")
            fil := find_in_line(g, p, e, "!DIFile(")
            if find_in_line(g, p, e, "!DICompileUnit(") >= 0:
                any = true
            end
            dwv := find_in_line(g, p, e, "\"Dwarf Version\", i32 ")
            if dwv >= 0:
                g.dwarf_ver = num_at(g, dwv) >= 5 ? 5 : 4
            end
            if loc >= 0 or sub >= 0 or fil >= 0:
                md_grow(g, id)
            else:
                dv_md_line(g, id, p, e)
            end
            if loc >= 0:
                g.md_kind[id] = 1
                ln := find_in_line(g, p, e, "line: ")
                g.md_line[id] = ln >= 0 ? num_at(g, ln) : 0
                sc := find_in_line(g, p, e, "scope: !")
                g.md_scope[id] = sc >= 0 ? num_at(g, sc) : 0 - 1
            else sub >= 0:
                g.md_kind[id] = 2
                ln2 := find_in_line(g, p, e, " line: ")
                g.md_line[id] = ln2 >= 0 ? num_at(g, ln2) : 0
                fl := find_in_line(g, p, e, "file: !")
                g.md_file[id] = fl >= 0 ? num_at(g, fl) : 0 - 1
                nm := find_in_line(g, p, e, "name: \"")
                g.md_s1[id] = nm >= 0 ? qstr_at(g, nm) : ""
            else fil >= 0:
                g.md_kind[id] = 3
                fn := find_in_line(g, p, e, "filename: \"")
                g.md_s1[id] = fn >= 0 ? qstr_at(g, fn) : ""
                dr := find_in_line(g, p, e, "directory: \"")
                g.md_s2[id] = dr >= 0 ? qstr_at(g, dr) : ""
            end
        end
        p = e + 1
    end
    g.dbg_on = any
end

func line_dbg(g &: Ng): int:
    if not g.dbg_on:
        ret 0 - 1
    end
    mut e := g.p
    until e < g.sn and g.src[e] != (10 as u8):
        e++
    end
    if g.dbg_eol.Has(e):
        ret g.dbg_eol.Get(e)
    end
    ret 0 - 1
end

func dbg_file_of(g &: Ng, loc: int): int:
    if loc < 0 or loc >= g.md_kind.Len():
        ret 0 - 1
    end
    mut sc := loc
    if g.md_kind[loc] == 1:
        sc = g.md_scope[loc]
    end
    sc = md_up_sp(g, sc)
    if sc < 0:
        ret 0 - 1
    end
    ret g.md_file[sc]
end

func md_up_sp(g &: Ng, s0: int): int:
    mut sc := s0
    mut guard := 0
    until sc >= 0 and sc < g.md_kind.Len() and g.md_kind[sc] == 13 and guard < 4096:
        sc = g.md_scope[sc]
        guard++
    end
    if sc < 0 or sc >= g.md_kind.Len() or g.md_kind[sc] != 2:
        ret 0 - 1
    end
    ret sc
end

func dbg_file_index(g &: Ng, md: int): int:
    repeat g.dfiles.Len() in k:
        if g.dfiles[k] == md:
            ret k + 1
        end
    end
    g.dfiles.Push(md)
    ret g.dfiles.Len()
end

func dbg_loc(g &: Ng, md: int, at: int): int:
    if md < 0:
        ret 0 - 1
    end
    hi := (at + 1) as i64
    lo := (md as i64) ^ ((hi * (2654435761 as i64)) & (0x7fffffff as i64))
    key := (hi << (32 as i64)) | lo
    if g.lt_map.Has(key):
        ret g.lt_map.Get(key)
    end
    id := g.lt_md.Len()
    g.lt_md.Push(md)
    g.lt_at.Push(at)
    g.lt_map.Put(key, id)
    ret id
end

func dbg_rebase(g &: Ng, l: int, call: int): int:
    if l < 0:
        ret call
    end
    if call < 0:
        ret l
    end
    if g.lt_at[l] < 0:
        ret dbg_loc(g, g.lt_md[l], call)
    end
    ret dbg_loc(g, g.lt_md[l], dbg_rebase(g, g.lt_at[l], call))
end

func dbg_range(g &: Ng, off: int, loc: int):
    n := g.dr_off.Len()
    if n > 0 and g.dr_loc[n - 1] == loc and g.dr_off[n - 1] <= off:
        ret
    end
    if n > 0 and g.dr_off[n - 1] == off and g.dr_loc[n - 1] != 0 - 2:
        g.dr_loc[n - 1] = loc
        ret
    end
    g.dr_off.Push(off)
    g.dr_loc.Push(loc)
end

func dbg_row(g &: Ng, off: int, loc: int):
    dbg_range(g, off, loc)
    if loc >= 0:
        dbg_row_md(g, off, g.lt_md[loc])
    end
end

func dbg_row_md(g &: Ng, off: int, loc: int):
    if loc < 0 or loc >= g.md_kind.Len() or g.md_kind[loc] == 0 or g.md_kind[loc] == 3:
        ret
    end
    fmd := dbg_file_of(g, loc)
    if fmd < 0:
        ret
    end
    fi := dbg_file_index(g, fmd)
    ln := g.md_line[loc]
    n := g.dl_off.Len()
    mut pe := false
    if g.dbg_pe >= 0 and off > g.dbg_pe:
        pe = true
        g.dbg_pe = 0 - 1
    end
    lastf := n > 0 ? (g.dl_file[n - 1] < 0 ? 0 - g.dl_file[n - 1] : g.dl_file[n - 1]) : 0 - 1
    if n > 0 and g.dl_line[n - 1] == ln and lastf == fi:
        ret
    end
    if n > 0 and g.dl_off[n - 1] == off:
        g.dl_line[n - 1] = ln
        g.dl_file[n - 1] = g.dl_file[n - 1] < 0 ? 0 - fi : fi
        ret
    end
    g.dl_off.Push(off)
    g.dl_line.Push(ln)
    g.dl_file.Push(pe ? 0 - fi : fi)
end

func dbg_aw(g &: Ng): int:
    ret g.wsz == 4 ? 4 : 8
end

func dbg_addr(g &: Ng, sec: int, buf &: Vector<u8>, sym: int, add: i64):
    add_reloc(g, sec, buf.Len(), sym, dbg_aw(g) == 4 ? R_ABS32 : R_ABS64, add)
    vb_le(buf, 0 as i64, dbg_aw(g))
end

func dbg_words(g &: Ng, base: int, pos: Vector<int>, scale: int):
    if not g.dbg_on:
        ret
    end
    if g.f_sp >= 0:
        dbg_row_md(g, base, g.f_sp)
        dbg_range(g, base, 0 - 1)
        g.dbg_pe = base
    end
    repeat pos.Len() in i:
        if g.mc.op[i] != M_LABEL and g.mc.op[i] != M_NOP:
            dbg_row(g, base + scale * pos[i], g.mc.loc[i])
        end
    end
end

func dbg_func(g &: Ng, base: int, size: int):
    sp0 := g.f_sp
    g.dbg_pe = 0 - 1
    if not g.dbg_on or sp0 < 0 or sp0 >= g.md_kind.Len() or g.md_kind[sp0] != 2:
        ret
    end
    g.df_sym.Push(g.f_sym)
    g.df_sp.Push(sp0)
    g.df_size.Push(size)
    g.df_base.Push(base)
    if size > 0:
        g.dr_off.Push(base + size - 1)
        g.dr_loc.Push(0 - 2)
    end
end

func dbg_cut(v &: Vector<int>, n: int):
    until v.Len() > n:
        v.Pop()
    end
end

func dbg_new_off(starts: Vector<int>, ends: Vector<int>, syms: Vector<int>, newoff: Vector<int>, off: int): int:
    mut lo := 0
    mut hi := starts.Len() - 1
    mut best := 0 - 1
    until lo <= hi:
        mid := (lo + hi) / 2
        if starts[mid] <= off:
            best = mid
            lo = mid + 1
        else:
            hi = mid - 1
        end
    end
    if best < 0:
        ret 0 - 1
    end
    st := starts[best]
    if off >= ends[best] and off != st:
        ret 0 - 1
    end
    mut k := best
    until k >= 0 and starts[k] == st:
        if newoff[syms[k]] >= 0:
            ret newoff[syms[k]] + off - st
        end
        k--
    end
    ret 0 - 1
end

func dbg_remap(g &: Ng, starts: Vector<int>, ends: Vector<int>, syms: Vector<int>, newoff: Vector<int>):
    mut w := 0
    repeat g.dl_off.Len() in i:
        no := dbg_new_off(starts, ends, syms, newoff, g.dl_off[i])
        if no >= 0 and (w == 0 or no > g.dl_off[w - 1]):
            g.dl_off[w] = no
            g.dl_line[w] = g.dl_line[i]
            g.dl_file[w] = g.dl_file[i]
            w++
        end
    end
    dbg_cut(g.dl_off, w)
    dbg_cut(g.dl_line, w)
    dbg_cut(g.dl_file, w)
    mut w3 := 0
    repeat g.dr_off.Len() in i3:
        no3 := dbg_new_off(starts, ends, syms, newoff, g.dr_off[i3])
        if no3 < 0:
            continue
        end
        if w3 > 0 and no3 == g.dr_off[w3 - 1] and g.dr_loc[w3 - 1] != 0 - 2:
            g.dr_loc[w3 - 1] = g.dr_loc[i3]
            continue
        end
        if w3 == 0 or no3 > g.dr_off[w3 - 1]:
            g.dr_off[w3] = no3
            g.dr_loc[w3] = g.dr_loc[i3]
            w3++
        end
    end
    dbg_cut(g.dr_off, w3)
    dbg_cut(g.dr_loc, w3)
    mut w2 := 0
    mut dmap := Vector {} as Vector<int>
    repeat g.df_base.Len() in j:
        nb := dbg_new_off(starts, ends, syms, newoff, g.df_base[j])
        dmap.Push(nb >= 0 ? w2 : 0 - 1)
        if nb >= 0:
            g.df_base[w2] = nb
            g.df_sym[w2] = g.df_sym[j]
            g.df_sp[w2] = g.df_sp[j]
            g.df_size[w2] = g.df_size[j]
            w2++
        end
    end
    dbg_cut(g.df_base, w2)
    dbg_cut(g.df_sym, w2)
    dbg_cut(g.df_sp, w2)
    dbg_cut(g.df_size, w2)
    repeat g.gv_df.Len() in q:
        od := g.gv_df[q]
        g.gv_df[q] = (od >= 0 and od < dmap.Len()) ? dmap[od] : 0 - 1
    end
    dmap.Free()
    mut w4 := 0
    repeat g.le_s.Len() in i4:
        ns := dbg_new_off(starts, ends, syms, newoff, g.le_s[i4])
        if ns >= 0:
            g.le_e[w4] = ns + g.le_e[i4] - g.le_s[i4]
            g.le_s[w4] = ns
            g.le_gv[w4] = g.le_gv[i4]
            g.le_k[w4] = g.le_k[i4]
            g.le_p[w4] = g.le_p[i4]
            g.le_x[w4] = g.le_x[i4]
            w4++
        end
    end
    dbg_cut(g.le_s, w4)
    dbg_cut(g.le_e, w4)
    dbg_cut(g.le_gv, w4)
    dbg_cut(g.le_k, w4)
    dbg_cut(g.le_x, w4)
    until g.le_p.Len() > w4:
        g.le_p.Pop()
    end
end

func vb_uleb(v &: Vector<u8>, x0: i64):
    mut x := x0
    until true:
        mut b := (x & (127 as i64)) as int
        x >>= (7 as i64)
        if x != (0 as i64):
            b |= 128
        end
        v.Push(b as u8)
        if x == (0 as i64):
            break
        end
    end
end

func vb_sleb(v &: Vector<u8>, x0: i64):
    mut x := x0
    until true:
        b := (x & (127 as i64)) as int
        x >>= (7 as i64)
        done := (x == (0 as i64) and (b & 64) == 0) or (x == (0 - 1 as i64) and (b & 64) != 0)
        v.Push((done ? b : (b | 128)) as u8)
        if done:
            break
        end
    end
end

func vb_le(v &: Vector<u8>, x: i64, n: int):
    mut y := x
    repeat n:
        v.Push((y & (255 as i64)) as u8)
        y >>= (8 as i64)
    end
end

func vb_str(v &: Vector<u8>, s: str):
    p := sp(s)
    repeat str.Len(s) in i:
        v.Push(p[i])
    end
    v.Push(0 as u8)
end

func vb_put32(v &: Vector<u8>, at: int, x: i64):
    repeat 4 in k:
        v[at + k] = ((x >> ((8 * k) as i64)) & (255 as i64)) as u8
    end
end

func dbg_sec_name(g &: Ng, sec: int, nm: str): str:
    if g.dwarf_ver < 5 or (sec != SEC_DBGRANGES and sec != SEC_DBGLOC):
        ret nm
    end
    mo := sp(nm)[0] == (95 as u8)
    if sec == SEC_DBGRANGES:
        ret mo ? "__debug_rnglists" : ".debug_rnglists"
    end
    ret mo ? "__debug_loclists" : ".debug_loclists"
end

func dbg_list_head(g &: Ng, v &: Vector<u8>):
    if g.dwarf_ver >= 5 and v.Len() == 0:
        vb_le(v, 0 as i64, 4)
        vb_le(v, 5 as i64, 2)
        v.Push(dbg_aw(g) as u8)
        v.Push(0 as u8)
        vb_le(v, 0 as i64, 4)
    end
end

func dbg_list_close(g &: Ng, v &: Vector<u8>):
    if g.dwarf_ver >= 5:
        dbg_list_head(g, v)
        vb_put32(v, 0, (v.Len() - 4) as i64)
    else v.Len() == 0:
        dbg_list_end(g, v)
    end
end

func dbg_list_end(g &: Ng, v &: Vector<u8>):
    if g.dwarf_ver >= 5:
        v.Push(0 as u8)
        ret
    end
    vb_le(v, 0 as i64, dbg_aw(g))
    vb_le(v, 0 as i64, dbg_aw(g))
end

func dbg_range_ent(g &: Ng, v &: Vector<u8>, s: int, e: int):
    if g.dwarf_ver >= 5:
        v.Push(4 as u8)
        vb_uleb(v, s as i64)
        vb_uleb(v, e as i64)
        ret
    end
    vb_le(v, s as i64, dbg_aw(g))
    vb_le(v, e as i64, dbg_aw(g))
end

func dbg_loc_ent(g &: Ng, v &: Vector<u8>, s: int, e: int, x: Vector<u8>):
    if g.dwarf_ver >= 5:
        v.Push(4 as u8)
        vb_uleb(v, s as i64)
        vb_uleb(v, e as i64)
        vb_uleb(v, x.Len() as i64)
    else:
        vb_le(v, s as i64, dbg_aw(g))
        vb_le(v, e as i64, dbg_aw(g))
        vb_le(v, x.Len() as i64, 2)
    end
    each b in x:
        v.Push(b)
    end
end

func dbg_lowpc(g &: Ng, di &: Vector<u8>, sym: int, add: i64):
    if g.dwarf_ver < 5:
        dbg_addr(g, SEC_DBGINFO, di, sym, add)
        ret
    end
    if g.s_daddr.Len() == 0:
        vb_le(g.s_daddr, 0 as i64, 4)
        vb_le(g.s_daddr, 5 as i64, 2)
        g.s_daddr.Push(dbg_aw(g) as u8)
        g.s_daddr.Push(0 as u8)
    end
    if g.da_map.Has(add):
        vb_uleb(di, g.da_map.Get(add) as i64)
        ret
    end
    ix := (g.s_daddr.Len() - 8) / dbg_aw(g)
    g.da_map.Put(add, ix)
    dbg_addr(g, SEC_DBGADDR, g.s_daddr, sym, add)
    vb_uleb(di, ix as i64)
end

func dbg_addrx_forms(ab &: Vector<u8>):
    mut p := 0
    until p < ab.Len() and ab[p] != (0 as u8):
        p += 3
        until p + 1 < ab.Len() and (ab[p] != (0 as u8) or ab[p + 1] != (0 as u8)):
            if ab[p] == (0x11 as u8) and ab[p + 1] == (0x01 as u8):
                ab[p + 1] = 0x1b as u8
            end
            p += 2
        end
        p += 2
    end
end

func dbg_local_sym(g &: Ng, name: str, sec: int): int:
    s := sym_named(g, name)
    g.sy_kind[s] = SY_DATA
    g.sy_def[s] = true
    g.sy_local[s] = true
    g.sy_sec[s] = sec
    g.sy_off[s] = 0
    ret s
end

func dbg_sp_of(g &: Ng, md: int): int:
    if md < 0 or md >= g.md_kind.Len() or g.md_kind[md] != 1:
        ret 0 - 1
    end
    ret md_up_sp(g, g.md_scope[md])
end

func dt_new(t &: DbgTree, kind: int, x: int, bmd: int, cx: int, spm: int, par: int): int:
    id := t.loc.Len()
    t.loc.Push(x)
    t.par.Push(par)
    t.sp.Push(spm)
    t.kind.Push(kind)
    t.bmd.Push(bmd)
    t.ctx.Push(cx)
    t.iv0.Push(0 - 1)
    t.iv1.Push(0 - 1)
    t.kid.Push(0 - 1)
    t.kid_last.Push(0 - 1)
    t.sib.Push(0 - 1)
    if par >= 0:
        if t.kid_last[par] < 0:
            t.kid[par] = id
        else:
            t.sib[t.kid_last[par]] = id
        end
        t.kid_last[par] = id
    end
    ret id
end

func dt_lkey(cx: int, blk: int): i64:
    hi := (cx + 1) as i64
    lo := (blk as i64) ^ ((hi * (2654435761 as i64)) & (0x7fffffff as i64))
    ret (hi << (32 as i64)) | lo
end

func dt_leafloc(g &: Ng, t &: DbgTree, l: int): int:
    cx := g.lt_at[l]
    mut par := 0 - 1
    if cx >= 0:
        par = dt_node(g, t, cx, dbg_sp_of(g, g.lt_md[l]))
    end
    md := g.lt_md[l]
    if md < 0 or md >= g.md_kind.Len() or g.md_kind[md] != 1:
        ret par
    end
    mut chain := Vector {} as Vector<int>
    mut sc := g.md_scope[md]
    until sc >= 0 and sc < g.md_kind.Len() and g.md_kind[sc] == 13 and chain.Len() < 4096:
        chain.Push(sc)
        sc = g.md_scope[sc]
    end
    mut k := chain.Len() - 1
    until k >= 0:
        blk := chain[k]
        key := dt_lkey(cx, blk)
        if t.lmap.Has(key):
            par = t.lmap.Get(key)
        else:
            par = dt_new(t, 1, 0 - 1, blk, cx, 0 - 1, par)
            t.lmap.Put(key, par)
        end
        k--
    end
    chain.Free()
    ret par
end

func dt_node(g &: Ng, t &: DbgTree, x: int, spm: int): int:
    if t.map.Has(x):
        ret t.map.Get(x)
    end
    par := dt_leafloc(g, t, x)
    if spm < 0:
        ret par
    end
    if t.map.Has(x):
        ret t.map.Get(x)
    end
    id := dt_new(t, 0, x, 0 - 1, g.lt_at[x], spm, par)
    t.map.Put(x, id)
    ret id
end

func dt_add(t &: DbgTree, nd: int, s: int, e: int):
    last := t.iv1[nd]
    if last >= 0 and t.ive[last] == s:
        t.ive[last] = e
        ret
    end
    id := t.ivs.Len()
    t.ivs.Push(s)
    t.ive.Push(e)
    t.ivn.Push(0 - 1)
    if last < 0:
        t.iv0[nd] = id
    else:
        t.ivn[last] = id
    end
    t.iv1[nd] = id
end

func dt_build(g &: Ng, t &: DbgTree, fstart: int, fend: int):
    mut lo := 0
    mut hi := g.dr_off.Len()
    until lo < hi:
        mid := (lo + hi) / 2
        if g.dr_off[mid] < fstart:
            lo = mid + 1
        else:
            hi = mid
        end
    end
    mut i := lo
    until i < g.dr_off.Len() and g.dr_off[i] < fend and g.dr_loc[i] != 0 - 2:
        s := g.dr_off[i]
        mut e := fend
        if i + 1 < g.dr_off.Len():
            e = g.dr_loc[i + 1] == 0 - 2 ? g.dr_off[i + 1] + 1 : g.dr_off[i + 1]
        end
        if e > fend:
            e = fend
        end
        l := g.dr_loc[i]
        if l >= 0 and e > s:
            mut nd := dt_leafloc(g, t, l)
            until nd >= 0:
                dt_add(t, nd, s, e)
                nd = t.par[nd]
            end
        end
        i++
    end
end

func dt_own(t &: DbgTree, nd: int, abs: HashMap<int, int>): bool:
    ret t.iv0[nd] >= 0 and (t.kind[nd] == 1 or abs.Has(t.sp[nd]))
end

func dt_writes(t &: DbgTree, nd: int, abs: HashMap<int, int>): bool:
    if dt_own(t, nd, abs):
        ret true
    end
    mut c := t.kid[nd]
    until c >= 0:
        if dt_writes(t, c, abs):
            ret true
        end
        c = t.sib[c]
    end
    ret false
end

func dv_place(g &: Ng, t &: DbgTree, gv: int, abs: HashMap<int, int>): int:
    cx := g.gv_ctx[gv]
    md := g.gv_md[gv]
    mut sc := md >= 0 and md < g.md_kind.Len() ? g.md_scope[md] : 0 - 1
    mut guard := 0
    until sc >= 0 and sc < g.md_kind.Len() and g.md_kind[sc] == 13 and guard < 4096:
        key := dt_lkey(cx, sc)
        if t.lmap.Has(key) and dt_own(t, t.lmap.Get(key), abs):
            ret t.lmap.Get(key)
        end
        sc = g.md_scope[sc]
        guard++
    end
    if cx >= 0:
        if t.map.Has(cx) and dt_own(t, t.map.Get(cx), abs):
            ret t.map.Get(cx)
        end
        ret 0 - 2
    end
    ret 0 - 1
end

func dt_write(g &: Ng, t &: DbgTree, di &: Vector<u8>, nd: int, abs: HashMap<int, int>, ts: int, rs: int, tys &: DvTypes, fgv &: Vector<int>, vnode &: Vector<int>, lsym: int):
    if not dt_own(t, nd, abs):
        mut c0 := t.kid[nd]
        until c0 >= 0:
            dt_write(g, t, di, c0, abs, ts, rs, tys, fgv, vnode, lsym)
            c0 = t.sib[c0]
        end
        ret
    end
    f := t.iv0[nd]
    single := t.ivn[f] < 0
    mut nvars := Vector {} as Vector<int>
    repeat fgv.Len() in qi:
        if vnode[qi] == nd:
            nvars.Push(fgv[qi])
        end
    end
    mut kids := nvars.Len() > 0
    mut c1 := t.kid[nd]
    until c1 >= 0:
        if dt_writes(t, c1, abs):
            kids = true
        end
        c1 = t.sib[c1]
    end
    lex := t.kind[nd] == 1
    if lex:
        vb_uleb(di, (single ? (kids ? 25 : 27) : (kids ? 26 : 28)) as i64)
    else:
        vb_uleb(di, (single ? (kids ? 3 : 19) : (kids ? 4 : 20)) as i64)
        vb_le(di, abs.Get(t.sp[nd]) as i64, 4)
    end
    if single:
        dbg_lowpc(g, di, ts, t.ivs[f] as i64)
        vb_le(di, (t.ive[f] - t.ivs[f]) as i64, 8)
    else:
        add_reloc(g, SEC_DBGINFO, di.Len(), rs, R_ABS32, g.s_dranges.Len() as i64)
        vb_le(di, 0 as i64, 4)
        mut r := f
        until r >= 0:
            dbg_range_ent(g, g.s_dranges, t.ivs[r], t.ive[r])
            r = t.ivn[r]
        end
        dbg_list_end(g, g.s_dranges)
    end
    if not lex:
        cmd := g.lt_md[t.loc[nd]]
        cf := dbg_file_of(g, cmd)
        vb_uleb(di, (cf >= 0 ? dbg_file_index(g, cf) : 1) as i64)
        vb_uleb(di, g.md_line[cmd] as i64)
    end
    dv_write_fn_vars(g, tys, di, nvars, lsym)
    nvars.Free()
    mut c := t.kid[nd]
    until c >= 0:
        dt_write(g, t, di, c, abs, ts, rs, tys, fgv, vnode, lsym)
        c = t.sib[c]
    end
    if kids:
        di.Push(0 as u8)
    end
end

func dbg_emit(g &: Ng):
    if not g.dbg_on or g.dl_off.Len() == 0 and g.df_sym.Len() == 0:
        ret
    end
    ts := dbg_local_sym(g, ".Lsalam.text0", SEC_TEXT)
    ls := dbg_local_sym(g, ".Lsalam.dline0", SEC_DBGLINE)
    as0 := dbg_local_sym(g, ".Lsalam.dabbrev0", SEC_DBGABBREV)
    mut cu_file := 0 - 1
    repeat g.md_kind.Len() in m:
        if cu_file < 0 and g.md_kind[m] == 3:
            cu_file = m
        end
    end
    mut ab := g.s_dabbrev
    each x in [1, 0x11, 1, 0x25, 0x08, 0x13, 0x05, 0x03, 0x08, 0x1b, 0x08, 0x10, 0x17, 0x11, 0x01, 0x12, 0x07]:
        ab.Push(x as u8)
    end
    if g.dwarf_ver >= 5:
        ab.Push(0x73 as u8)
        ab.Push(0x17 as u8)
    end
    ab.Push(0 as u8)
    ab.Push(0 as u8)
    each y in [2, 0x2e, 1, 0x03, 0x08, 0x3a, 0x0f, 0x3b, 0x0f, 0x11, 0x01, 0x12, 0x07, 0x3f, 0x19, 0, 0]:
        ab.Push(y as u8)
    end
    each y3 in [3, 0x1d, 1, 0x31, 0x13, 0x11, 0x01, 0x12, 0x07, 0x58, 0x0f, 0x59, 0x0f, 0, 0]:
        ab.Push(y3 as u8)
    end
    each y4 in [4, 0x1d, 1, 0x31, 0x13, 0x55, 0x17, 0x58, 0x0f, 0x59, 0x0f, 0, 0]:
        ab.Push(y4 as u8)
    end
    each y5 in [5, 0x2e, 0, 0x03, 0x08, 0x3a, 0x0f, 0x3b, 0x0f, 0x3f, 0x19, 0x20, 0x0b, 0, 0]:
        ab.Push(y5 as u8)
    end
    each y6 in [6, 0x24, 0, 0x03, 0x08, 0x0b, 0x0f, 0x3e, 0x0b, 0, 0, 7, 0x0f, 0, 0x0b, 0x0f, 0x49, 0x13, 0, 0, 8, 0x0f, 0, 0x0b, 0x0f, 0, 0]:
        ab.Push(y6 as u8)
    end
    each y9 in [9, 0x13, 1, 0x03, 0x08, 0x0b, 0x0f, 0, 0, 10, 0x0d, 0, 0x03, 0x08, 0x49, 0x13, 0x38, 0x0f, 0, 0, 11, 0x01, 1, 0x49, 0x13, 0, 0, 12, 0x21, 0, 0x37, 0x0f, 0, 0]:
        ab.Push(y9 as u8)
    end
    repeat 2 in vk:
        tag := vk == 0 ? 0x34 : 0x05
        base := vk == 0 ? 13 : 16
        each z1 in [base, tag, 0, 0x03, 0x08, 0x3a, 0x0f, 0x3b, 0x0f, 0x49, 0x13, 0x02, 0x17, 0, 0]:
            ab.Push(z1 as u8)
        end
        each z2 in [base + 1, tag, 0, 0x03, 0x08, 0x3a, 0x0f, 0x3b, 0x0f, 0x49, 0x13, 0x02, 0x18, 0, 0]:
            ab.Push(z2 as u8)
        end
        each z3 in [base + 2, tag, 0, 0x03, 0x08, 0x3a, 0x0f, 0x3b, 0x0f, 0x49, 0x13, 0, 0]:
            ab.Push(z3 as u8)
        end
    end
    each z4 in [19, 0x1d, 0, 0x31, 0x13, 0x11, 0x01, 0x12, 0x07, 0x58, 0x0f, 0x59, 0x0f, 0, 0, 20, 0x1d, 0, 0x31, 0x13, 0x55, 0x17, 0x58, 0x0f, 0x59, 0x0f, 0, 0]:
        ab.Push(z4 as u8)
    end
    each z5 in [21, 0x2e, 0, 0x03, 0x08, 0x3a, 0x0f, 0x3b, 0x0f, 0x11, 0x01, 0x12, 0x07, 0x3f, 0x19, 0, 0]:
        ab.Push(z5 as u8)
    end
    each z6 in [22, 0x34, 0, 0x03, 0x08, 0x3a, 0x0f, 0x3b, 0x0f, 0x49, 0x13, 0x02, 0x18, 0, 0]:
        ab.Push(z6 as u8)
    end
    each z7 in [23, 0x04, 1, 0x03, 0x08, 0x0b, 0x0f, 0, 0, 24, 0x28, 0, 0x03, 0x08, 0x1c, 0x0d, 0, 0]:
        ab.Push(z7 as u8)
    end
    each z8 in [25, 0x0b, 1, 0x11, 0x01, 0x12, 0x07, 0, 0, 26, 0x0b, 1, 0x55, 0x17, 0, 0, 27, 0x0b, 0, 0x11, 0x01, 0x12, 0x07, 0, 0, 28, 0x0b, 0, 0x55, 0x17, 0, 0]:
        ab.Push(z8 as u8)
    end
    ab.Push(0 as u8)
    if g.dwarf_ver >= 5:
        dbg_addrx_forms(ab)
    end
    g.s_dabbrev = ab
    text_size := g.s_text.Len()
    mut di := Vector {} as Vector<u8>
    vb_le(di, 0 as i64, 4)
    vb_le(di, g.dwarf_ver as i64, 2)
    if g.dwarf_ver >= 5:
        di.Push(1 as u8)
        di.Push(dbg_aw(g) as u8)
    end
    add_reloc(g, SEC_DBGINFO, di.Len(), as0, R_ABS32, 0 as i64)
    vb_le(di, 0 as i64, 4)
    if g.dwarf_ver < 5:
        di.Push(dbg_aw(g) as u8)
    end
    vb_uleb(di, 1 as i64)
    vb_str(di, "salam")
    vb_le(di, 0x0c as i64, 2)
    vb_str(di, cu_file >= 0 ? g.md_s1[cu_file] : "")
    vb_str(di, cu_file >= 0 ? g.md_s2[cu_file] : "")
    add_reloc(g, SEC_DBGINFO, di.Len(), ls, R_ABS32, 0 as i64)
    vb_le(di, 0 as i64, 4)
    dbg_lowpc(g, di, ts, 0 as i64)
    vb_le(di, text_size as i64, 8)
    if g.dwarf_ver >= 5:
        das := dbg_local_sym(g, ".Lsalam.daddr0", SEC_DBGADDR)
        add_reloc(g, SEC_DBGINFO, di.Len(), das, R_ABS32, 8 as i64)
        vb_le(di, 0 as i64, 4)
    end
    rs := dbg_local_sym(g, ".Lsalam.dranges0", SEC_DBGRANGES)
    lsym := dbg_local_sym(g, ".Lsalam.dloc0", SEC_DBGLOC)
    dbg_list_head(g, g.s_dranges)
    dbg_list_head(g, g.s_dloc)
    mut tys := DvTypes {}
    dv_index_entries(g, tys)
    mut gcur := 0
    mut abs := HashMap {} as HashMap<int, int>
    repeat g.lt_md.Len() in l:
        if g.lt_at[l] < 0:
            continue
        end
        spa := dbg_sp_of(g, g.lt_md[l])
        if spa < 0 or abs.Has(spa):
            continue
        end
        abs.Put(spa, di.Len())
        vb_uleb(di, 5 as i64)
        vb_str(di, g.md_s1[spa])
        fa := g.md_file[spa]
        vb_uleb(di, (fa >= 0 ? dbg_file_index(g, fa) : 1) as i64)
        vb_uleb(di, g.md_line[spa] as i64)
        di.Push(1 as u8)
    end
    repeat g.df_sym.Len() in k:
        spm := g.df_sp[k]
        until gcur < g.gv_df.Len() and g.gv_df[gcur] < k:
            gcur++
        end
        mut fgv := Vector {} as Vector<int>
        until gcur < g.gv_df.Len() and g.gv_df[gcur] == k:
            fgv.Push(gcur)
            gcur++
        end
        mut t := DbgTree {}
        dt_build(g, t, g.df_base[k], g.df_base[k] + g.df_size[k])
        mut topv := Vector {} as Vector<int>
        mut vnode := Vector {} as Vector<int>
        each gq0 in fgv:
            pn := dv_place(g, t, gq0, abs)
            vnode.Push(pn)
            if pn == 0 - 1:
                topv.Push(gq0)
            end
        end
        mut kids := topv.Len() > 0
        repeat t.loc.Len() in nd0:
            if t.par[nd0] < 0 and dt_writes(t, nd0, abs):
                kids = true
            end
        end
        vb_uleb(di, (kids ? 2 : 21) as i64)
        mut nm := g.md_s1[spm]
        if str.Len(nm) == 0:
            nm = tab_str(g.syms, g.df_sym[k])
        end
        vb_str(di, nm)
        fm := g.md_file[spm]
        vb_uleb(di, (fm >= 0 ? dbg_file_index(g, fm) : 1) as i64)
        vb_uleb(di, g.md_line[spm] as i64)
        dbg_lowpc(g, di, ts, g.df_base[k] as i64)
        vb_le(di, g.df_size[k] as i64, 8)
        dv_write_fn_vars(g, tys, di, topv, lsym)
        topv.Free()
        repeat t.loc.Len() in nd:
            if t.par[nd] < 0:
                dt_write(g, t, di, nd, abs, ts, rs, tys, fgv, vnode, lsym)
            end
        end
        vnode.Free()
        fgv.Free()
        if kids:
            di.Push(0 as u8)
        end
    end
    dv_write_globals(g, tys, di)
    dv_types_flush(g, tys, di)
    di.Push(0 as u8)
    dbg_list_close(g, g.s_dloc)
    dbg_list_close(g, g.s_dranges)
    if g.s_daddr.Len() > 0:
        vb_put32(g.s_daddr, 0, (g.s_daddr.Len() - 4) as i64)
    end
    vb_put32(di, 0, (di.Len() - 4) as i64)
    g.s_dinfo = di
    v5 := g.dwarf_ver >= 5
    mut dl := Vector {} as Vector<u8>
    vb_le(dl, 0 as i64, 4)
    vb_le(dl, g.dwarf_ver as i64, 2)
    if v5:
        dl.Push(dbg_aw(g) as u8)
        dl.Push(0 as u8)
    end
    hl_at := dl.Len()
    vb_le(dl, 0 as i64, 4)
    hs := dl.Len()
    each z in [1, 1, 1, 0xfb, 14, 13, 0, 1, 1, 1, 1, 0, 0, 0, 1, 0, 0, 1]:
        dl.Push(z as u8)
    end
    mut dirs := Vector {} as Vector<str>
    mut dix := Vector {} as Vector<int>
    each fmd in g.dfiles:
        d := g.md_s2[fmd]
        mut found := 0 - 1
        repeat dirs.Len() in q:
            if str.Equals(dirs.Get(q), d):
                found = q
            end
        end
        if found < 0:
            dirs.Push(d)
            found = dirs.Len() - 1
        end
        dix.Push(found + 1)
    end
    if v5:
        each f5 in [1, 1, 0x08]:
            dl.Push(f5 as u8)
        end
        vb_uleb(dl, (dirs.Len() + 1) as i64)
        vb_str(dl, cu_file >= 0 ? g.md_s2[cu_file] : "")
    end
    each dd in dirs:
        vb_str(dl, dd)
    end
    if v5:
        each f6 in [2, 1, 0x08, 2, 0x0f]:
            dl.Push(f6 as u8)
        end
        vb_uleb(dl, (g.dfiles.Len() + 1) as i64)
        vb_str(dl, cu_file >= 0 ? g.md_s1[cu_file] : "")
        dl.Push(0 as u8)
    else:
        dl.Push(0 as u8)
    end
    repeat g.dfiles.Len() in fi:
        vb_str(dl, g.md_s1[g.dfiles[fi]])
        vb_uleb(dl, dix[fi] as i64)
        if not v5:
            vb_uleb(dl, 0 as i64)
            vb_uleb(dl, 0 as i64)
        end
    end
    if not v5:
        dl.Push(0 as u8)
    end
    vb_put32(dl, hl_at, (dl.Len() - hs) as i64)
    dl.Push(0 as u8)
    vb_uleb(dl, (dbg_aw(g) + 1) as i64)
    dl.Push(2 as u8)
    dbg_addr(g, SEC_DBGLINE, dl, ts, 0 as i64)
    mut cur_off := 0
    mut cur_line := 1
    mut cur_file := 1
    repeat g.dl_off.Len() in r:
        rf := g.dl_file[r] < 0 ? 0 - g.dl_file[r] : g.dl_file[r]
        if rf != cur_file:
            dl.Push(4 as u8)
            vb_uleb(dl, rf as i64)
            cur_file = rf
        end
        if g.dl_off[r] != cur_off:
            dl.Push(2 as u8)
            vb_uleb(dl, (g.dl_off[r] - cur_off) as i64)
            cur_off = g.dl_off[r]
        end
        if g.dl_line[r] != cur_line:
            dl.Push(3 as u8)
            vb_sleb(dl, (g.dl_line[r] - cur_line) as i64)
            cur_line = g.dl_line[r]
        end
        if g.dl_file[r] < 0:
            dl.Push(10 as u8)
        end
        dl.Push(1 as u8)
    end
    if text_size > cur_off:
        dl.Push(2 as u8)
        vb_uleb(dl, (text_size - cur_off) as i64)
    end
    dl.Push(0 as u8)
    vb_uleb(dl, 1 as i64)
    dl.Push(1 as u8)
    vb_put32(dl, 0, (dl.Len() - 4) as i64)
    g.s_dline = dl
    dirs.Free()
    dix.Free()
    if g.os == NG_OS_WINDOWS:
        cv_emit(g, ts, tys)
    end
end
