package nativegen

import os
import str

k_ng_opn := ["nop", "alloca", "load", "store", "addr", "add", "sub", "mul", "sdiv", "udiv", "srem", "urem", "and", "or", "xor", "shl", "lshr", "ashr", "fadd", "fsub", "fmul", "fdiv", "frem", "fneg", "icmp", "fcmp", "sext", "zext", "trunc", "ptrtoint", "inttoptr", "bitcast", "sitofp", "uitofp", "fptosi", "fptoui", "fpext", "fptrunc", "select", "phi", "call", "br", "cbr", "ret", "unreachable", "insertvalue", "extractvalue", "atomicrmw", "cmpxchg", "copy", "fence", "vbcast", "vredadd"]

func dvs(g &: Ng, v: int): str:
    if v < 0:
        ret "_"
    end
    k := g.v_kind[v]
    if k == VK_INT:
        ret "" + g.v_i[v]
    end
    if k == VK_FLT:
        ret "f" + g.v_i[v]
    end
    if k == VK_GLB:
        ret "@" + tab_str(g.syms, g.v_def[v]) + (g.v_i[v] != (0 as i64) ? "+" + g.v_i[v] : "")
    end
    if k == VK_UNDEF:
        ret "undef"
    end
    if k == VK_ZERO:
        ret "zero"
    end
    if k == VK_ARG:
        ret "%a" + g.v_i[v]
    end
    ret "%" + v
end

func dump_wanted(g &: Ng): bool:
    want := os.Env("SALAM_NG_DUMP")
    if want.len() == 0:
        ret false
    end
    ret want == tab_str(g.syms, g.f_sym)
end

func dump_ir(g &: Ng, tag: str):
    printerrln "== " + tag + " " + tab_str(g.syms, g.f_sym)
    each b in g.b_rpo:
        mut pr := ""
        repeat g.b_npred[b] in k:
            pr = pr + " b" + g.b_pred[g.b_ps[b] + k]
        end
        printerrln "b" + b + ": preds" + pr
        mut i := g.b_first[b]
        until i >= 0:
            op := g.i_op[i]
            mut line := "  "
            if g.i_res[i] >= 0:
                line = line + "%" + g.i_res[i] + " = "
            end
            line = line + k_ng_opn[op] + ((g.i_f[i] & IF_NSW) != 0 and op >= OP_ADD and op <= OP_ASHR ? " nsw" : "") + " t" + g.i_ty[i]
            m := val_mask(op)
            if (m & 1) != 0 or op == OP_CALL:
                line = line + " " + dvs(g, g.i_a[i])
            end
            if (m & 2) != 0:
                line = line + ", " + dvs(g, g.i_b[i])
            else op == OP_BR or op == OP_CBR:
                line = line + " b" + g.i_b[i]
            end
            if (m & 4) != 0:
                line = line + ", " + dvs(g, g.i_c[i])
            else op == OP_CBR:
                line = line + " b" + g.i_c[i]
            end
            if op == OP_ADDR:
                line = line + " *" + g.i_x[i] + " +" + g.i_d[i]
            else op == OP_ALLOCA:
                line = line + " T" + g.i_x[i]
            else op == OP_ICMP or op == OP_FCMP:
                line = line + " p" + g.i_x[i]
            else op == OP_INSV or op == OP_EXTV:
                line = line + " @" + g.i_d[i]
            end
            if op == OP_CALL:
                line = line + "("
                repeat g.i_pcount[i] in k2:
                    line = line + (k2 > 0 ? ", " : "") + dvs(g, g.pool[g.i_ps[i] + 3 * k2])
                end
                line = line + ")"
            else op == OP_PHI:
                repeat g.i_pcount[i] in k3:
                    line = line + " [" + dvs(g, g.pool[g.i_ps[i] + 2 * k3]) + ", b" + g.pool[g.i_ps[i] + 2 * k3 + 1] + "]"
                end
            end
            printerrln line
            i = g.i_next[i]
        end
    end
end

func verify_use(g &: Ng, v: int, ub: int, pos: int, order &: Vector<int>): bool:
    if v < 0 or g.v_kind[v] != VK_INS:
        ret true
    end
    d := g.v_def[v]
    if d < 0:
        ret false
    end
    db := g.i_blk[d]
    if db == ub:
        ret order[d] < pos
    end
    ret dominates(g, db, ub)
end

func verify_ssa(g &: Ng):
    build_cfg(g)
    build_dom(g)
    mut order := Vector {} as Vector<int>
    repeat g.i_op.len():
        order.push(0 - 1)
    end
    each b in g.b_rpo:
        mut n := 0
        mut i := g.b_first[b]
        until i >= 0:
            order[i] = n
            n += 1
            i = g.i_next[i]
        end
    end
    mut bad := 0 - 1
    each b2 in g.b_rpo:
        mut j := g.b_first[b2]
        until j >= 0 and bad < 0:
            op := g.i_op[j]
            if op == OP_PHI:
                ps := g.i_ps[j]
                repeat g.i_pcount[j] in q:
                    pb := g.pool[ps + 2 * q + 1]
                    pv := g.pool[ps + 2 * q]
                    if pb >= 0 and g.b_order[pb] >= 0 and not verify_use(g, pv, pb, 1000000000, order):
                        bad = j
                    end
                end
            else:
                m := val_mask(op)
                if (m & 1) != 0 and not verify_use(g, g.i_a[j], b2, order[j], order): bad = j end
                if (m & 2) != 0 and not verify_use(g, g.i_b[j], b2, order[j], order): bad = j end
                if (m & 4) != 0 and not verify_use(g, g.i_c[j], b2, order[j], order): bad = j end
                if op == OP_CALL:
                    ps2 := g.i_ps[j]
                    repeat g.i_pcount[j] in q2:
                        if not verify_use(g, g.pool[ps2 + 3 * q2], b2, order[j], order): bad = j end
                    end
                end
            end
            j = g.i_next[j]
        end
    end
    order.free()
    if bad >= 0:
        dump_ir(g, "unverified")
        fail(g, "native backend: SSA use not dominated by its definition in " + tab_str(g.syms, g.f_sym) + " at b" + str.FromInt(g.i_blk[bad] as i64))
    end
end

func read_pass_switches(g &: Ng):
    g.gvn_x = os.Env("SALAM_NG_GVN_SKIP")
    g.verify = os.Env("SALAM_NG_VERIFY").len() > 0
    mx := os.Env("SALAM_NG_GVN_MAX")
    if mx.len() > 0:
        g.gvn_max = str.ToInt(mx)
    end
    g.off_str = os.Env("SALAM_NG_OFF")
    g.off_base = os.Env("SALAM_NG_OFF_BASE")
    rg := os.Env("SALAM_NG_OFF_RANGE")
    if rg.len() > 0:
        cpos := str.IndexOf(rg, ":")
        if cpos > 0:
            g.off_lo = str.ToInt(str.Substr(rg, 0, cpos))
            g.off_hi = str.ToInt(str.Substr(rg, cpos + 1, str.Len(rg) - cpos - 1))
        end
    end
    set_off(g, g.off_str)
end

func set_off(g &: Ng, off: str):
    g.off_gvn = str.Contains(off, "gvn")
    g.off_ifc = str.Contains(off, "ifc")
    g.off_thread = str.Contains(off, "thread")
    g.off_inline = str.Contains(off, "inline")
    g.off_sroa = str.Contains(off, "sroa")
    g.off_slp = str.Contains(off, "slp")
    g.off_tailrec = str.Contains(off, "tailrec")
    g.off_unroll = str.Contains(off, "unroll")
    g.off_licm = str.Contains(off, "licm")
    g.off_split = str.Contains(off, "split")
    g.off_lsr = str.Contains(off, "lsr")
    g.off_lcse = str.Contains(off, "lcse")
    g.off_range = str.Contains(off, "range")
    g.off_rvec = str.Contains(off, "rvec")
    g.off_selfinl = str.Contains(off, "selfinl")
    g.off_idiom = str.Contains(off, "idiom")
    g.off_dbits = str.Contains(off, "dbits")
    g.off_lle = str.Contains(off, "lle")
    g.off_widen = str.Contains(off, "widen")
    g.off_unswitch = str.Contains(off, "unswitch")
    g.off_runroll = str.Contains(off, "runroll")
    g.off_iss = str.Contains(off, "iss")
    g.off_sink = str.Contains(off, "sink")
    g.off_mmchain = str.Contains(off, "mmchain")
    g.off_inl1 = str.Contains(off, "inl1")
    g.off_afwd = str.Contains(off, "afwd")
    g.off_lpro = str.Contains(off, "lpro")
    g.off_lsf = str.Contains(off, "lsf")
    g.off_scse = str.Contains(off, "scse")
    g.off_lpre = str.Contains(off, "lpre")
    g.off_dtest = str.Contains(off, "dtest")
    g.off_fch = str.Contains(off, "fch")
    g.off_p2div = str.Contains(off, "p2div")
    g.off_aggbonus = str.Contains(off, "aggbonus")
    g.off_lhoist = str.Contains(off, "lhoist")
    g.off_mlp = str.Contains(off, "mlp")
    g.off_ipcp = str.Contains(off, "ipcp")
    g.off_aload = str.Contains(off, "aload")
    g.off_belady = str.Contains(off, "belady")
end
