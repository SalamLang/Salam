package nativegen

func dv_val_loc(g &: Ng, v: int, blk: int, k &: int, p &: int, x &: int):
    k = 0
    p = 0
    x = 0
    if v < 0 or v >= g.v_kind.Len():
        ret
    end
    vk := g.v_kind[v]
    if vk == VK_INT:
        if not is_flt(g, g.v_ty[v]):
            k = 2
            p = g.v_i[v] as int
        end
        ret
    end
    if vk != VK_INS and vk != VK_ARG:
        ret
    end
    if v < g.vak.Len() and g.vak[v] != AK_NONE:
        ak := g.vak[v]
        if ak == AK_PTR and g.var_[v] >= VBASE:
            k = 4
            p = g.var_[v]
            x = g.vao[v]
        else ak == AK_FRAME and g.var_[v] >= 0:
            k = 5
            p = g.var_[v]
            x = g.vao[v]
        end
        ret
    end
    if v >= g.vv.Len():
        ret
    end
    mut r := g.vv[v]
    saved := g.cur_b
    g.cur_b = blk
    sr := split_lookup(g, v)
    g.cur_b = saved
    if sr >= 0:
        r = sr
    end
    if r >= VBASE:
        k = 1
        p = r
    end
end

func dv_live_at(ra &: Ra, v: int, pos: int): bool:
    if v >= ra.v_r0.Len():
        ret false
    end
    mut lo := ra.v_r0[v]
    mut hi := lo + ra.v_rn[v]
    until lo < hi:
        mid := (lo + hi) / 2
        if ra.rg_e[mid] < pos:
            lo = mid + 1
        else:
            hi = mid
        end
    end
    ret lo < ra.v_r0[v] + ra.v_rn[v] and ra.rg_s[lo] <= pos
end

func dv_mark(g &: Ng, head &: int, tail &: int, f: int, k: int, p: int, x: int):
    m := g.mk_fv.Len()
    g.mk_fv.Push(f)
    g.mk_k.Push(k)
    g.mk_p.Push(p)
    g.mk_x.Push(x)
    g.mk_next.Push(-1)
    if tail >= 0:
        g.mk_next[tail] = m
    else:
        head = m
    end
    tail = m
end

func dv_markers(g &: Ng, ra &: Ra):
    n := g.mc.op.Len()
    g.mc.dv.Clear()
    repeat n:
        g.mc.dv.Push(-1)
    end
    nf := g.fv_val.Len()
    if nf == 0 or g.me_idx.Len() == 0:
        ret
    end
    mut ck := Vector {} as Vector<int>
    mut cp := Vector {} as Vector<int>
    mut ek := Vector {} as Vector<int>
    mut ep := Vector {} as Vector<int>
    mut ext := Vector {} as Vector<bool>
    mut inact := Vector {} as Vector<bool>
    mut cx := Vector {} as Vector<int>
    repeat nf:
        cx.Push(0)
        ck.Push(0)
        cp.Push(0)
        ek.Push(0)
        ep.Push(0)
        ext.Push(false)
        inact.Push(false)
    end
    mut act := Vector {} as Vector<int>
    mut uses := Vector {} as Vector<int>
    mut defs := Vector {} as Vector<int>
    mut en := Vector {} as Vector<int>
    mut ea_ok := Vector {} as Vector<bool>
    repeat nf in f0:
        en.Push(dv_ea_of(g, g.fv_ent[f0]))
    end
    repeat g.ea_val.Len():
        ea_ok.Push(true)
    end
    mut in_entry := g.ea_val.Len() > 0 and g.mc.lorder.Len() > 0 and g.mc.lorder[0] == 0
    mut mc_cur := 0
    nme := g.me_idx.Len()
    each b in g.mc.lorder:
        bs := g.mc.bstart[b]
        be := g.mc.bend[b]
        if bs < 0 or be <= bs:
            in_entry = false
            continue
        end
        until mc_cur < nme and g.me_idx[mc_cur] < bs:
            mc_cur++
        end
        each fa in act:
            ck[fa] = 0
            ek[fa] = 0
            ext[fa] = false
            inact[fa] = false
        end
        act.Clear()
        if in_entry:
            dv_entry_params(g, en, mc_cur, be)
            repeat nf in fe:
                if en[fe] >= 0:
                    inact[fe] = true
                    act.Push(fe)
                end
            end
        end
        mut i := bs
        until i < be:
            mut head := -1
            mut tail := -1
            until mc_cur < nme and g.me_idx[mc_cur] == i:
                fx := g.me_fv[mc_cur]
                if fx < 0:
                    dv_mark(g, head, tail, -1, 0, 0, 0)
                    mc_cur++
                    continue
                end
                if in_entry:
                    dv_entry_event(g, en, fx, g.me_val[mc_cur])
                end
                mut kk := 0
                mut pp := 0
                mut xx := 0
                dv_val_loc(g, g.me_val[mc_cur], g.me_blk[mc_cur], kk, pp, xx)
                if kk != ck[fx] or pp != cp[fx]:
                    ext[fx] = false
                end
                ck[fx] = kk
                cp[fx] = pp
                cx[fx] = xx
                if not inact[fx]:
                    inact[fx] = true
                    act.Push(fx)
                end
                mc_cur++
            end
            mut w := 0
            repeat act.Len() in ai:
                f := act[ai]
                mut dk := ck[f]
                mut dp := cp[f]
                mut dx := cx[f]
                if dk == 1 or dk == 4:
                    if dv_live_at(ra, dp, 2 * i):
                        ext[f] = dp < g.mc.vloc.Len() and g.mc.vloc[dp] >= 0
                    else not ext[f]:
                        dk = 0
                    end
                end
                if dk == 0 and in_entry and en[f] >= 0 and ea_ok[en[f]]:
                    av := g.ea_val[en[f]]
                    ptr := av < g.vak.Len() and g.vak[av] == AK_PTR
                    dk = (g.ea_k[en[f]] == 1 ? 10 : 12) + (ptr ? 1 : 0)
                    dp = g.ea_p[en[f]]
                    dx = ptr ? g.vao[av] : 0
                end
                if dk != ek[f] or (dk != 0 and dp != ep[f]):
                    dv_mark(g, head, tail, f, dk, dp, dx)
                    ek[f] = dk
                    ep[f] = dp
                end
                if ck[f] == 0 and ek[f] == 0 and not (in_entry and en[f] >= 0):
                    inact[f] = false
                else:
                    act[w] = f
                    w++
                end
            end
            until act.Len() > w:
                _x := act.Pop()
            end
            g.mc.dv[i] = head
            op := g.mc.op[i]
            is_call := op == M_CALL or op == M_CALLR
            if in_entry:
                dv_entry_clobber(g, i, ea_ok, uses, defs)
            end
            mut need := false
            each fq in act:
                if ext[fq] and (ck[fq] == 1 or ck[fq] == 4):
                    need = true
                end
            end
            if need:
                mi_regs(g, i, uses, defs)
                each f2 in act:
                    if not ext[f2] or (ck[f2] != 1 and ck[f2] != 4):
                        continue
                    end
                    r := cp[f2]
                    ph := g.mc.vloc[r]
                    if is_call and is_caller_saved(g, ph):
                        ext[f2] = false
                        continue
                    end
                    if (op == M_COPY or op == M_FMOV_RR) and g.mc.r1[i] == r:
                        continue
                    end
                    each d in defs:
                        if d != r:
                            dph := d >= VBASE ? (d < g.mc.vloc.Len() ? g.mc.vloc[d] : -1) : d
                            if dph == ph:
                                ext[f2] = false
                            end
                        end
                    end
                end
            end
            i++
        end
        in_entry = false
    end
    en.Free()
    ea_ok.Free()
    ck.Free()
    cp.Free()
    ek.Free()
    ep.Free()
    ext.Free()
    inact.Free()
    cx.Free()
    act.Free()
    uses.Free()
    defs.Free()
end

func dv_entry_params(g &: Ng, en &: Vector<int>, from: int, be: int):
    mut seen := Vector {} as Vector<bool>
    repeat en.Len():
        seen.Push(false)
    end
    mut m := from
    until m < g.me_idx.Len() and g.me_idx[m] < be:
        f := g.me_fv[m]
        if f >= 0 and not seen[f]:
            seen[f] = true
            md := g.fv_var[f]
            if g.fv_ctx[f] < 0 and md >= 0 and md < g.md_a.Len() and g.md_a[md] > 0:
                ei := dv_ea_of(g, g.me_val[m])
                if ei >= 0:
                    en[f] = ei
                end
            end
        end
        m++
    end
    seen.Free()
end

func dv_entry_event(g &: Ng, en &: Vector<int>, f: int, val: int):
    en[f] = dv_ea_of(g, val)
    mut a := g.fv_par[f]
    mut guard := 0
    until a >= 0 and guard < 64:
        en[a] = -1
        a = g.fv_par[a]
        guard++
    end
end

func dv_self_copy(g &: Ng, i: int, ph: int): bool:
    op := g.mc.op[i]
    if op != M_COPY and op != M_MOV_RR and op != M_FMOV_RR:
        ret false
    end
    r := g.mc.r1[i]
    sph := r >= VBASE ? (r < g.mc.vloc.Len() ? g.mc.vloc[r] : -1) : r
    ret sph == ph
end

func dv_entry_clobber(
    g &: Ng, i: int, ea_ok &: Vector<bool>, uses &: Vector<int>, defs &: Vector<int>
):
    op := g.mc.op[i]
    if op == M_LABEL or op == M_NOP:
        ret
    end
    keep := op == M_COPY or op == M_MOV_RR or op == M_FMOV_RR or op == M_LD or op == M_FLD or
        op == M_ARM_SODD
    if keep:
        mi_regs(g, i, uses, defs)
    end
    repeat ea_ok.Len() in k:
        if not ea_ok[k] or g.ea_k[k] != 1:
            continue
        end
        if not keep:
            ea_ok[k] = false
            continue
        end
        each d in defs:
            dph := d >= VBASE ? (d < g.mc.vloc.Len() ? g.mc.vloc[d] : -1) : d
            if dph == g.ea_p[k] and not dv_self_copy(g, i, dph):
                ea_ok[k] = false
            end
        end
    end
end
