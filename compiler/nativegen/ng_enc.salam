package nativegen

pub struct Enc:
    pub code: Vector<u8> = Vector {}
    pub ioff: Vector<int> = Vector {}
    pub ilen: Vector<int> = Vector {}
    pub lbl_ins: Vector<int> = Vector {}
    pub br_ins: Vector<int> = Vector {}
    pub br_long: Vector<bool> = Vector {}
    pub pos: Vector<int> = Vector {}
    pub rel_off: Vector<int> = Vector {}
    pub rel_sym: Vector<int> = Vector {}
    pub rel_type: Vector<int> = Vector {}
    pub rel_add: Vector<i64> = Vector {}
    pub rel_ins: Vector<int> = Vector {}
    pub cur_ins: int = 0
end

pub struct RM:
    pub mem: bool = false
    pub reg: int = 0
    pub k: int = 0
    pub b: int = 0 - 1
    pub i: int = 0 - 1
    pub s: int = 1
    pub d: i64 = 0 as i64
    pub sym: int = 0 - 1
end

func eb(e &: Enc, b: int):
    e.code.push((b & 255) as u8)
end

func e32(e &: Enc, v: i64):
    mut x := v
    repeat 4:
        eb(e, (x & (255 as i64)) as int)
        x = x >> (8 as i64)
    end
end

func e64(e &: Enc, v: i64):
    mut x := v as u64
    repeat 8:
        eb(e, (x & (255 as u64)) as int)
        x = x >> (8 as u64)
    end
end

func erel(e &: Enc, sym: int, rtype: int, addend: i64):
    e.rel_off.push(e.code.len())
    e.rel_sym.push(sym)
    e.rel_type.push(rtype)
    e.rel_add.push(addend)
    e.rel_ins.push(e.cur_ins)
end

func hw(r: int): int:
    if r >= 16:
        ret r - 16
    end
    ret r
end

func fits8(v: i64): bool:
    ret v >= (0 - 128 as i64) and v <= (127 as i64)
end

func rm_reg(r: int): RM:
    ret RM { mem = false, reg = r }
end

func rm_of(g &: Ng, i: int): RM:
    k := g.mc.mk[i]
    if k == MK_FRAME:
        ret RM { mem = true, k = MK_BI, b = RBP, i = g.mc.mi[i], s = g.mc.ms[i], d = g.mc.md[i] - (g.mc.fs_off[g.mc.mb[i]] as i64) }
    end
    if k == MK_RIP or k == MK_GOT:
        ret RM { mem = true, k = k, sym = g.mc.msym[i], d = g.mc.md[i] }
    end
    ret RM { mem = true, k = MK_BI, b = g.mc.mb[i], i = g.mc.mi[i], s = g.mc.ms[i], d = g.mc.md[i] }
end

func scale_bits(s: int): int:
    if s == 2: ret 1 end
    if s == 4: ret 2 end
    if s == 8: ret 3 end
    ret 0
end

func enc(g &: Ng, e &: Enc, pfx: int, w: bool, opc: int, nopc: int, regf: int, rm: RM, byteop: int, immsz: int):
    if pfx == 0x66 or pfx == 0xF2 or pfx == 0xF3 or pfx == 0xF0:
        eb(e, pfx)
    else pfx == 0x66F0:
        eb(e, 0xF0)
        eb(e, 0x66)
    end
    rf := hw(regf)
    mut rex := 0
    if w:
        rex = rex | 8
    end
    if rf >= 8:
        rex = rex | 4
    end
    if rm.mem:
        if rm.k == MK_BI:
            if rm.i >= 0 and hw(rm.i) >= 8:
                rex = rex | 2
            end
            if rm.b >= 0 and hw(rm.b) >= 8:
                rex = rex | 1
            end
        end
    else:
        if hw(rm.reg) >= 8:
            rex = rex | 1
        end
        if (byteop & 1) != 0 and rm.reg >= 4 and rm.reg <= 7:
            rex = rex | 64
        end
    end
    if (byteop & 2) != 0 and regf >= 4 and regf <= 7:
        rex = rex | 64
    end
    if rex != 0:
        eb(e, 0x40 | (rex & 15))
    end
    if nopc >= 3:
        eb(e, (opc >> 16) & 255)
    end
    if nopc >= 2:
        eb(e, (opc >> 8) & 255)
    end
    eb(e, opc & 255)
    r3 := rf & 7
    if not rm.mem:
        eb(e, 0xC0 | (r3 << 3) | (hw(rm.reg) & 7))
        ret
    end
    if rm.k == MK_RIP or rm.k == MK_GOT:
        eb(e, (r3 << 3) | 5)
        if rm.k == MK_GOT:
            if g.os == NG_OS_WINDOWS:
                erel(e, rm.sym, R_PC32, rm.d - ((4 + immsz) as i64))
            else:
                erel(e, rm.sym, R_GOTPCRELX, rm.d - ((4 + immsz) as i64))
            end
        else:
            erel(e, rm.sym, R_PC32, rm.d - ((4 + immsz) as i64))
        end
        e32(e, 0 as i64)
        ret
    end
    b := rm.b
    d := rm.d
    if b < 0:
        mut ix := 4
        if rm.i >= 0:
            ix = hw(rm.i) & 7
        end
        eb(e, (r3 << 3) | 4)
        eb(e, (scale_bits(rm.s) << 6) | (ix << 3) | 5)
        e32(e, d)
        ret
    end
    hb := hw(b) & 7
    mut mode := 2
    if d == (0 as i64) and hb != 5:
        mode = 0
    else fits8(d):
        mode = 1
    end
    if rm.i >= 0 or hb == 4:
        mut ix2 := 4
        if rm.i >= 0:
            ix2 = hw(rm.i) & 7
        end
        eb(e, (mode << 6) | (r3 << 3) | 4)
        eb(e, (scale_bits(rm.s) << 6) | (ix2 << 3) | hb)
    else:
        eb(e, (mode << 6) | (r3 << 3) | hb)
    end
    if mode == 1:
        eb(e, (d & (255 as i64)) as int)
    else mode == 2:
        e32(e, d)
    end
end

func sse_pfx(sz: int): int:
    if sz == 4:
        ret 0xF3
    end
    ret 0xF2
end

func enc_ins(g &: Ng, e &: Enc, i: int):
    op := g.mc.op[i]
    sz := g.mc.sz[i]
    r0 := g.mc.r0[i]
    r1 := g.mc.r1[i]
    imm := g.mc.imm[i]
    w := sz == 8
    p16 := sz == 2 ? 0x66 : 0
    b8 := sz == 1
    switch op:
        M_NOP, M_LABEL, M_COPY: ret end
        M_MOV_RR:
            if b8:
                enc(g, e, 0, false, 0x88, 1, r1, rm_reg(r0), 3, 0)
            else:
                enc(g, e, p16, w, 0x89, 1, r1, rm_reg(r0), 0, 0)
            end
            ret
        end
        M_MOV_RI:
            if sz == 8 and not is_imm32(imm):
                h := hw(r0)
                eb(e, 0x48 | (h >= 8 ? 1 : 0))
                eb(e, 0xB8 + (h & 7))
                e64(e, imm)
            else sz == 8 and imm < (0 as i64):
                enc(g, e, 0, true, 0xC7, 1, 0, rm_reg(r0), 0, 4)
                e32(e, imm)
            else:
                h2 := hw(r0)
                if h2 >= 8:
                    eb(e, 0x41)
                end
                eb(e, 0xB8 + (h2 & 7))
                e32(e, imm)
            end
            ret
        end
        M_LD:
            enc(g, e, p16, w, 0x8B, 1, r0, rm_of(g, i), 0, 0)
            ret
        end
        M_LDGOT:
            enc(g, e, 0, true, 0x8B, 1, r0, rm_of(g, i), 0, 0)
            ret
        end
        M_LDZX:
            if g.mc.sz2[i] == 1:
                enc(g, e, 0, false, 0x0FB6, 2, r0, rm_of(g, i), 0, 0)
            else:
                enc(g, e, 0, false, 0x0FB7, 2, r0, rm_of(g, i), 0, 0)
            end
            ret
        end
        M_LDSX:
            s2 := g.mc.sz2[i]
            if s2 == 4:
                enc(g, e, 0, true, 0x63, 1, r0, rm_of(g, i), 0, 0)
            else s2 == 1:
                enc(g, e, 0, w, 0x0FBE, 2, r0, rm_of(g, i), 0, 0)
            else:
                enc(g, e, 0, w, 0x0FBF, 2, r0, rm_of(g, i), 0, 0)
            end
            ret
        end
        M_ST:
            if b8:
                enc(g, e, 0, false, 0x88, 1, r1, rm_of(g, i), 3, 0)
            else:
                enc(g, e, p16, w, 0x89, 1, r1, rm_of(g, i), 0, 0)
            end
            ret
        end
        M_STI:
            if b8:
                enc(g, e, 0, false, 0xC6, 1, 0, rm_of(g, i), 0, 1)
                eb(e, (imm & (255 as i64)) as int)
            else sz == 2:
                enc(g, e, 0x66, false, 0xC7, 1, 0, rm_of(g, i), 0, 2)
                eb(e, (imm & (255 as i64)) as int)
                eb(e, ((imm >> (8 as i64)) & (255 as i64)) as int)
            else:
                enc(g, e, 0, w, 0xC7, 1, 0, rm_of(g, i), 0, 4)
                e32(e, imm)
            end
            ret
        end
        M_LEA:
            enc(g, e, 0, true, 0x8D, 1, r0, rm_of(g, i), 0, 0)
            ret
        end
        M_ALU_RR:
            sub := g.mc.cc[i]
            if b8:
                enc(g, e, 0, false, sub << 3, 1, r1, rm_reg(r0), 3, 0)
            else:
                enc(g, e, p16, w, (sub << 3) | 1, 1, r1, rm_reg(r0), 0, 0)
            end
            ret
        end
        M_ALU_RI:
            sub2 := g.mc.cc[i]
            if b8:
                enc(g, e, 0, false, 0x80, 1, sub2, rm_reg(r0), 1, 1)
                eb(e, (imm & (255 as i64)) as int)
            else fits8(imm):
                enc(g, e, p16, w, 0x83, 1, sub2, rm_reg(r0), 0, 1)
                eb(e, (imm & (255 as i64)) as int)
            else sz == 2:
                enc(g, e, 0x66, false, 0x81, 1, sub2, rm_reg(r0), 0, 2)
                eb(e, (imm & (255 as i64)) as int)
                eb(e, ((imm >> (8 as i64)) & (255 as i64)) as int)
            else hw(r0) == 0:
                if w:
                    eb(e, 0x48)
                end
                eb(e, (sub2 << 3) | 5)
                e32(e, imm)
            else:
                enc(g, e, 0, w, 0x81, 1, sub2, rm_reg(r0), 0, 4)
                e32(e, imm)
            end
            ret
        end
        M_ALU_RM:
            sub3 := g.mc.cc[i]
            if b8:
                enc(g, e, 0, false, (sub3 << 3) | 2, 1, r0, rm_of(g, i), 3, 0)
            else:
                enc(g, e, p16, w, (sub3 << 3) | 3, 1, r0, rm_of(g, i), 0, 0)
            end
            ret
        end
        M_ALU_MR:
            sub4 := g.mc.cc[i]
            if b8:
                enc(g, e, 0, false, sub4 << 3, 1, r1, rm_of(g, i), 3, 0)
            else:
                enc(g, e, p16, w, (sub4 << 3) | 1, 1, r1, rm_of(g, i), 0, 0)
            end
            ret
        end
        M_ALU_MI:
            sub5 := g.mc.cc[i]
            if b8:
                enc(g, e, 0, false, 0x80, 1, sub5, rm_of(g, i), 0, 1)
                eb(e, (imm & (255 as i64)) as int)
            else fits8(imm):
                enc(g, e, p16, w, 0x83, 1, sub5, rm_of(g, i), 0, 1)
                eb(e, (imm & (255 as i64)) as int)
            else:
                enc(g, e, p16, w, 0x81, 1, sub5, rm_of(g, i), 0, 4)
                e32(e, imm)
            end
            ret
        end
        M_TEST_RR:
            if b8:
                enc(g, e, 0, false, 0x84, 1, r1, rm_reg(r0), 3, 0)
            else:
                enc(g, e, p16, w, 0x85, 1, r1, rm_reg(r0), 0, 0)
            end
            ret
        end
        M_TEST_RI:
            if b8:
                enc(g, e, 0, false, 0xF6, 1, 0, rm_reg(r0), 1, 1)
                eb(e, (imm & (255 as i64)) as int)
            else:
                enc(g, e, p16, w, 0xF7, 1, 0, rm_reg(r0), 0, 4)
                e32(e, imm)
            end
            ret
        end
        M_IMUL_RR:
            enc(g, e, p16, w, 0x0FAF, 2, r0, rm_reg(r1), 0, 0)
            ret
        end
        M_IMUL_RRI:
            if fits8(imm):
                enc(g, e, p16, w, 0x6B, 1, r0, rm_reg(r1), 0, 1)
                eb(e, (imm & (255 as i64)) as int)
            else:
                enc(g, e, p16, w, 0x69, 1, r0, rm_reg(r1), 0, 4)
                e32(e, imm)
            end
            ret
        end
        M_SHIFT_RI:
            sh := g.mc.cc[i]
            if imm == (1 as i64):
                enc(g, e, p16, w, b8 ? 0xD0 : 0xD1, 1, sh, rm_reg(r0), (b8 ? 1 : 0), 0)
            else:
                enc(g, e, p16, w, b8 ? 0xC0 : 0xC1, 1, sh, rm_reg(r0), (b8 ? 1 : 0), 1)
                eb(e, (imm & (255 as i64)) as int)
            end
            ret
        end
        M_SHIFT_RC:
            enc(g, e, p16, w, b8 ? 0xD2 : 0xD3, 1, g.mc.cc[i], rm_reg(r0), (b8 ? 1 : 0), 0)
            ret
        end
        M_UNARY:
            enc(g, e, p16, w, b8 ? 0xF6 : 0xF7, 1, g.mc.cc[i], rm_reg(r0), (b8 ? 1 : 0), 0)
            ret
        end
        M_CQO:
            if w:
                eb(e, 0x48)
            end
            eb(e, 0x99)
            ret
        end
        M_DIV:
            enc(g, e, p16, w, 0xF7, 1, g.mc.cc[i] == 1 ? 7 : 6, rm_reg(r1), 0, 0)
            ret
        end
        M_MULHI:
            enc(g, e, 0, true, 0xF7, 1, g.mc.cc[i] == 1 ? 5 : 4, rm_reg(r1), 0, 0)
            ret
        end
        M_SETCC:
            enc(g, e, 0, false, 0x0F90 + g.mc.cc[i], 2, 0, rm_reg(r0), 1, 0)
            ret
        end
        M_MOVZX_RR:
            if g.mc.sz2[i] == 1:
                enc(g, e, 0, false, 0x0FB6, 2, r0, rm_reg(r1), 1, 0)
            else:
                enc(g, e, 0, false, 0x0FB7, 2, r0, rm_reg(r1), 0, 0)
            end
            ret
        end
        M_MOVSX_RR:
            s3 := g.mc.sz2[i]
            if s3 == 4:
                enc(g, e, 0, true, 0x63, 1, r0, rm_reg(r1), 0, 0)
            else s3 == 1:
                enc(g, e, 0, w, 0x0FBE, 2, r0, rm_reg(r1), 1, 0)
            else:
                enc(g, e, 0, w, 0x0FBF, 2, r0, rm_reg(r1), 0, 0)
            end
            ret
        end
        M_CMOV:
            enc(g, e, 0, w, 0x0F40 + g.mc.cc[i], 2, r0, rm_reg(r1), 0, 0)
            ret
        end
        M_CALL:
            eb(e, 0xE8)
            erel(e, g.mc.msym[i], R_PLT32, 0 - 4 as i64)
            e32(e, 0 as i64)
            ret
        end
        M_CALLR:
            enc(g, e, 0, false, 0xFF, 1, 2, rm_reg(r1), 0, 0)
            ret
        end
        M_RET:
            enc_epilogue(g, e)
            ret
        end
        M_UD2:
            eb(e, 0x0F)
            eb(e, 0x0B)
            ret
        end
        M_XCHG:
            enc(g, e, p16, w, b8 ? 0x86 : 0x87, 1, r0, rm_of(g, i), (b8 ? 3 : 0), 0)
            ret
        end
        M_LXADD:
            enc(g, e, sz == 2 ? 0x66F0 : 0xF0, w, b8 ? 0x0FC0 : 0x0FC1, 2, r0, rm_of(g, i), (b8 ? 3 : 0), 0)
            ret
        end
        M_LCMPXCHG:
            enc(g, e, sz == 2 ? 0x66F0 : 0xF0, w, b8 ? 0x0FB0 : 0x0FB1, 2, r1, rm_of(g, i), (b8 ? 3 : 0), 0)
            ret
        end
        M_MFENCE:
            eb(e, 0x0F)
            eb(e, 0xAE)
            eb(e, 0xF0)
            ret
        end
        M_FMOV_RR:
            enc(g, e, 0, false, 0x0F28, 2, r0, rm_reg(r1), 0, 0)
            ret
        end
        M_FLD:
            enc(g, e, sse_pfx(sz), false, 0x0F10, 2, r0, rm_of(g, i), 0, 0)
            ret
        end
        M_FST:
            enc(g, e, sse_pfx(sz), false, 0x0F11, 2, r1, rm_of(g, i), 0, 0)
            ret
        end
        M_FOP_RR:
            enc(g, e, sse_pfx(sz), false, 0x0F00 + g.mc.cc[i], 2, r0, rm_reg(r1), 0, 0)
            ret
        end
        M_SQRT:
            enc(g, e, sse_pfx(sz), false, 0x0F51, 2, r0, rm_reg(r1), 0, 0)
            ret
        end
        M_FOP_RM:
            enc(g, e, sse_pfx(sz), false, 0x0F00 + g.mc.cc[i], 2, r0, rm_of(g, i), 0, 0)
            ret
        end
        M_UCOMI:
            enc(g, e, sz == 8 ? 0x66 : 0, false, 0x0F2E, 2, r0, rm_reg(r1), 0, 0)
            ret
        end
        M_CVTSI2F:
            enc(g, e, sse_pfx(sz), g.mc.sz2[i] == 8, 0x0F2A, 2, r0, rm_reg(r1), 0, 0)
            ret
        end
        M_CVTF2SI:
            enc(g, e, sse_pfx(sz), g.mc.sz2[i] == 8, 0x0F2C, 2, r0, rm_reg(r1), 0, 0)
            ret
        end
        M_CVTF2F:
            enc(g, e, sz == 8 ? 0xF3 : 0xF2, false, 0x0F5A, 2, r0, rm_reg(r1), 0, 0)
            ret
        end
        M_MOVQ_XG:
            enc(g, e, 0x66, sz == 8, 0x0F6E, 2, r0, rm_reg(r1), 0, 0)
            ret
        end
        M_MOVQ_GX:
            enc(g, e, 0x66, sz == 8, 0x0F7E, 2, r1, rm_reg(r0), 0, 0)
            ret
        end
        M_XORPS:
            enc(g, e, 0, false, 0x0F57, 2, r0, rm_reg(r1), 0, 0)
            ret
        end
        M_ANDPS:
            enc(g, e, 0, false, 0x0F54, 2, r0, rm_reg(r1), 0, 0)
            ret
        end
    end
    fail(g, "native backend: cannot encode machine op " + str_of_int(op))
end

func str_of_int(v: int): str:
    ret "" + v
end

func ngp_count(g &: Ng): int:
    mut n := 0
    each r in g.mc.callee_used:
        if r < 16:
            n += 1
        else:
            ret n
        end
    end
    ret n
end

func push_reg(e &: Enc, r: int):
    if r >= 8:
        eb(e, 0x41)
    end
    eb(e, 0x50 + (r & 7))
end

func pop_reg(e &: Enc, r: int):
    if r >= 8:
        eb(e, 0x41)
    end
    eb(e, 0x58 + (r & 7))
end

func enc_prologue(g &: Ng, e &: Enc):
    eb(e, 0x55)
    eb(e, 0x48)
    eb(e, 0x89)
    eb(e, 0xE5)
    ngp := ngp_count(g)
    repeat ngp in k:
        push_reg(e, g.mc.callee_used[k])
    end
    fsize := g.mc.frame_size
    if fsize > 0:
        if g.os == NG_OS_WINDOWS and fsize >= 4096:
            eb(e, 0xB8)
            e32(e, fsize as i64)
            eb(e, 0xE8)
            erel(e, g.sym_chkstk, R_PLT32, 0 - 4 as i64)
            g.sy_used[g.sym_chkstk] = true
            e32(e, 0 as i64)
            eb(e, 0x48)
            eb(e, 0x29)
            eb(e, 0xC4)
        else fits8(fsize as i64):
            eb(e, 0x48)
            eb(e, 0x83)
            eb(e, 0xEC)
            eb(e, fsize)
        else:
            eb(e, 0x48)
            eb(e, 0x81)
            eb(e, 0xEC)
            e32(e, fsize as i64)
        end
    end
    mut k2 := ngp
    until k2 + 1 < g.mc.callee_used.len():
        xr := g.mc.callee_used[k2]
        off := g.mc.callee_used[k2 + 1]
        enc(g, e, 0, false, 0x0F29, 2, xr, RM { mem = true, k = MK_BI, b = RBP, d = 0 - off as i64 }, 0, 0)
        k2 += 2
    end
end

func enc_epilogue(g &: Ng, e &: Enc):
    ngp := ngp_count(g)
    mut k2 := ngp
    until k2 + 1 < g.mc.callee_used.len():
        xr := g.mc.callee_used[k2]
        off := g.mc.callee_used[k2 + 1]
        enc(g, e, 0, false, 0x0F28, 2, xr, RM { mem = true, k = MK_BI, b = RBP, d = 0 - off as i64 }, 0, 0)
        k2 += 2
    end
    if ngp > 0:
        enc(g, e, 0, true, 0x8D, 1, RSP, RM { mem = true, k = MK_BI, b = RBP, d = 0 - (8 * ngp) as i64 }, 0, 0)
        mut k := ngp - 1
        until k >= 0:
            pop_reg(e, g.mc.callee_used[k])
            k -= 1
        end
        eb(e, 0x5D)
    else:
        eb(e, 0xC9)
    end
    eb(e, 0xC3)
end

func next_real(g &: Ng, i: int): int:
    mut j := i + 1
    n := g.mc.op.len()
    until j < n and (g.mc.op[j] == M_LABEL or g.mc.op[j] == M_NOP or g.mc.op[j] == M_COPY):
        j += 1
    end
    ret j
end

func label_between(g &: Ng, from: int, upto: int, lbl: int): bool:
    mut j := from + 1
    until j < upto:
        if g.mc.op[j] == M_LABEL and g.mc.tgt[j] == lbl:
            ret true
        end
        j += 1
    end
    ret false
end

func peephole_jumps(g &: Ng):
    n := g.mc.op.len()
    repeat n in i:
        op := g.mc.op[i]
        if op == M_JMP:
            nx := next_real(g, i)
            if label_between(g, i, nx, g.mc.tgt[i]):
                g.mc.op[i] = M_NOP
            end
        else op == M_JCC:
            j := next_real(g, i)
            if j < n and g.mc.op[j] == M_JMP:
                k := next_real(g, j)
                if label_between(g, j, k, g.mc.tgt[i]):
                    g.mc.cc[i] = inv_cc(g.mc.cc[i])
                    g.mc.tgt[i] = g.mc.tgt[j]
                    g.mc.op[j] = M_NOP
                end
            end
        end
    end
end

func encode_function(g &: Ng):
    peephole_jumps(g)
    mut e := Enc {}
    n := g.mc.op.len()
    repeat g.mc.nlabels:
        e.lbl_ins.push(0 - 1)
    end
    e.cur_ins = 0 - 1
    enc_prologue(g, e)
    prolen := e.code.len()
    repeat n in i:
        e.cur_ins = i
        e.ioff.push(e.code.len())
        op := g.mc.op[i]
        if op == M_LABEL:
            e.lbl_ins[g.mc.tgt[i]] = i
        else op == M_JMP or op == M_JCC:
            e.br_ins.push(i)
            e.br_long.push(false)
        else:
            enc_ins(g, e, i)
        end
        e.ilen.push(e.code.len() - e.ioff[i])
    end
    nb := e.br_ins.len()
    repeat n:
        e.pos.push(0)
    end
    mut changed := true
    until changed:
        changed = false
        mut p := prolen
        mut bi := 0
        repeat n in i2:
            e.pos[i2] = p
            if bi < nb and e.br_ins[bi] == i2:
                if e.br_long[bi]:
                    p += g.mc.op[i2] == M_JMP ? 5 : 6
                else:
                    p += 2
                end
                bi += 1
            else:
                p += e.ilen[i2]
            end
        end
        repeat nb in k:
            if not e.br_long[k]:
                bix := e.br_ins[k]
                li := e.lbl_ins[g.mc.tgt[bix]]
                if li < 0:
                    fail(g, "native backend: branch to undefined label")
                    ret
                end
                disp := e.pos[li] - (e.pos[bix] + 2)
                if disp < 0 - 128 or disp > 127:
                    e.br_long[k] = true
                    changed = true
                end
            end
        end
    end
    sec_align_to(g, SEC_TEXT, 16)
    base := g.s_text.len()
    g.sy_sec[g.f_sym] = SEC_TEXT
    g.sy_off[g.f_sym] = base
    repeat prolen in q:
        g.s_text.push(e.code[q])
    end
    mut bj := 0
    mut ri := 0
    nr := e.rel_off.len()
    until ri < nr and e.rel_ins[ri] < 0:
        add_reloc(g, SEC_TEXT, base + e.rel_off[ri], e.rel_sym[ri], e.rel_type[ri], e.rel_add[ri])
        ri += 1
    end
    repeat n in i3:
        if bj < nb and e.br_ins[bj] == i3:
            li2 := e.lbl_ins[g.mc.tgt[i3]]
            tpos := e.pos[li2]
            if e.br_long[bj]:
                if g.mc.op[i3] == M_JMP:
                    g.s_text.push(0xE9 as u8)
                    put32(g, tpos - (e.pos[i3] + 5))
                else:
                    g.s_text.push(0x0F as u8)
                    g.s_text.push((0x80 + g.mc.cc[i3]) as u8)
                    put32(g, tpos - (e.pos[i3] + 6))
                end
            else:
                if g.mc.op[i3] == M_JMP:
                    g.s_text.push(0xEB as u8)
                else:
                    g.s_text.push((0x70 + g.mc.cc[i3]) as u8)
                end
                g.s_text.push(((tpos - (e.pos[i3] + 2)) & 255) as u8)
            end
            bj += 1
            continue
        end
        st := e.ioff[i3]
        delta := base + e.pos[i3] - st
        until ri < nr and e.rel_ins[ri] == i3:
            add_reloc(g, SEC_TEXT, delta + e.rel_off[ri], e.rel_sym[ri], e.rel_type[ri], e.rel_add[ri])
            ri += 1
        end
        repeat e.ilen[i3] in q2:
            g.s_text.push(e.code[st + q2])
        end
    end
    g.sy_size[g.f_sym] = g.s_text.len() - base
    e.code.free()
    e.ioff.free()
    e.ilen.free()
    e.lbl_ins.free()
    e.br_ins.free()
    e.br_long.free()
    e.pos.free()
    e.rel_off.free()
    e.rel_sym.free()
    e.rel_type.free()
    e.rel_add.free()
    e.rel_ins.free()
end

func put32(g &: Ng, v: int):
    mut x := v
    repeat 4:
        g.s_text.push((x & 255) as u8)
        x = x >> 8
    end
end
