package nativegen

import str

const AK_NONE := 0
const AK_FRAME := 1
const AK_PTR := 2
const AK_ALLOCA := 3

k_sysv_gp := [7, 6, 2, 1, 8, 9]
k_win_gp := [1, 2, 8, 9]

func vcls_ty(g &: Ng, t: int): int:
    if is_flt(g, t):
        ret 1
    end
    ret 0
end

func asz(g &: Ng, t: int): int:
    if int_bits(g, t) > 32:
        ret 8
    end
    ret 4
end

func msz(g &: Ng, t: int): int:
    if t == T_I1:
        ret 1
    end
    ret tsize(g, t)
end

func fsz(t: int): int:
    if t == T_F32:
        ret 4
    end
    ret 8
end

func new_reg_ty(g &: Ng, t: int): int:
    ret vnew(g, vcls_ty(g, t))
end

func isel_init(g &: Ng):
    nv := g.v_kind.len()
    g.vv.clear()
    g.vsc.clear()
    g.vak.clear()
    g.var_.clear()
    g.vao.clear()
    g.v_mem.clear()
    repeat nv:
        g.vv.push(0 - 1)
        g.vsc.push(1)
        g.vak.push(AK_NONE)
        g.var_.push(0 - 1)
        g.vao.push(0)
        g.v_mem.push(0)
    end
    g.phit.clear()
    repeat g.i_op.len():
        g.phit.push(0 - 1)
    end
    count_uses(g)
    each b in g.b_rpo:
        mut i := g.b_first[b]
        until i >= 0:
            op := g.i_op[i]
            if op == OP_LOAD:
                a := g.i_a[i]
                if a >= 0:
                    g.v_mem[a] = g.v_mem[a] + 1
                end
            else op == OP_STORE:
                p := g.i_b[i]
                if p >= 0 and p != g.i_a[i]:
                    g.v_mem[p] = g.v_mem[p] + 1
                end
            end
            i = g.i_next[i]
        end
    end
end

func def_op(g &: Ng, v: int): int:
    if v < 0 or g.v_kind[v] != VK_INS:
        ret 0 - 1
    end
    d := g.v_def[v]
    if d < 0:
        ret 0 - 1
    end
    ret g.i_op[d]
end

func addr_only(g &: Ng, v: int): bool:
    ret def_op(g, v) == OP_ADDR and g.v_mem[v] == g.v_uses[v]
end

func fp_const(g &: Ng, bits: i64, sz: int): Mem:
    mut off := 0
    if sz == 4:
        fb := f32_bits_of(bits_f64(bits))
        if g.fpc4.has(fb):
            off = g.fpc4.get(fb)
        else:
            sec_align_to(g, SEC_RODATA, 4)
            off = g.s_ro.len()
            sec_le(g, SEC_RODATA, fb, 4)
            g.fpc4.put(fb, off)
        end
    else:
        if g.fpc.has(bits):
            off = g.fpc.get(bits)
        else:
            sec_align_to(g, SEC_RODATA, 8)
            off = g.s_ro.len()
            sec_le(g, SEC_RODATA, bits, 8)
            g.fpc.put(bits, off)
        end
    end
    ret Mem { k = MK_RIP, sym = g.sym_ro, d = off as i64 }
end

func raw_const(g &: Ng, bits: i64, sz: int): Mem:
    mut off := 0
    if g.fpcr.has(bits):
        off = g.fpcr.get(bits)
    else:
        sec_align_to(g, SEC_RODATA, 16)
        off = g.s_ro.len()
        sec_le(g, SEC_RODATA, bits, sz)
        sec_pad(g, SEC_RODATA, 16 - sz)
        g.fpcr.put(bits, off)
    end
    ret Mem { k = MK_RIP, sym = g.sym_ro, d = off as i64 }
end

func frame_mem(slot: int, d: i64): Mem:
    ret Mem { k = MK_FRAME, b = slot, d = d }
end

func use_reg(g &: Ng, v: int): int:
    k := g.v_kind[v]
    if k == VK_INS or k == VK_ARG:
        ak := g.vak[v]
        if ak == AK_ALLOCA:
            r := gpr(g)
            _l := e_rm(g, M_LEA, 8, r, frame_mem(g.var_[v], 0 as i64))
            ret r
        end
        if ak == AK_FRAME or ak == AK_PTR:
            r2 := gpr(g)
            _l2 := e_rm(g, M_LEA, 8, r2, agg_mem(g, v))
            ret r2
        end
        if addr_only(g, v):
            r3 := gpr(g)
            _l3 := e_rm(g, M_LEA, 8, r3, mem_of(g, v, 0 as i64))
            ret r3
        end
        r4 := g.vv[v]
        if r4 < 0:
            fail(g, "native backend: value used before its definition in " + tab_str(g.syms, g.f_sym))
            ret gpr(g)
        end
        ret r4
    end
    if k == VK_INT:
        if is_flt(g, g.v_ty[v]):
            ret float_reg(g, g.v_i[v], g.v_ty[v])
        end
        r5 := gpr(g)
        _m := e_movi(g, r5, g.v_i[v])
        ret r5
    end
    if k == VK_FLT:
        ret float_reg(g, g.v_i[v], g.v_ty[v])
    end
    if k == VK_GLB:
        r6 := gpr(g)
        s := g.v_def[v]
        if g.sy_def[s]:
            _l4 := e_rm(g, M_LEA, 8, r6, Mem { k = MK_RIP, sym = s, d = g.v_i[v] })
        else:
            _l5 := e_rm(g, M_LDGOT, 8, r6, Mem { k = MK_GOT, sym = s })
            if g.v_i[v] != (0 as i64):
                _a := e_alui(g, ALU_ADD, 8, r6, g.v_i[v])
            end
        end
        ret r6
    end
    if is_flt(g, g.v_ty[v]):
        r7 := xmm(g)
        _x := e_rr(g, M_XORPS, 8, r7, r7)
        ret r7
    end
    r8 := gpr(g)
    _z := e_movi(g, r8, 0 as i64)
    ret r8
end

func float_reg(g &: Ng, bits: i64, t: int): int:
    r := xmm(g)
    if bits == (0 as i64):
        _x := e_rr(g, M_XORPS, 8, r, r)
        ret r
    end
    sz := fsz(t)
    _l := e_rm(g, M_FLD, sz, r, fp_const(g, bits, sz))
    ret r
end

func move_into(g &: Ng, dst: int, v: int):
    k := g.v_kind[v]
    if k == VK_INT and not is_flt(g, g.v_ty[v]) and g.mc.vcls[dst] == 0:
        _m := e_movi(g, dst, g.v_i[v])
        ret
    end
    r := use_reg(g, v)
    _c := e_copy(g, dst, r)
end

func idx_reg(g &: Ng, v: int, t: int): int:
    if g.v_kind[v] == VK_INT:
        r := gpr(g)
        _m := e_ri(g, M_MOV_RI, 8, r, g.v_i[v])
        ret r
    end
    r2 := use_reg(g, v)
    bits := int_bits(g, t)
    if bits >= 64:
        ret r2
    end
    r3 := gpr(g)
    if bits == 1:
        i := e_rr(g, M_MOVZX_RR, 4, r3, r2)
        g.mc.sz2[i] = 1
        ret r3
    end
    i2 := e_rr(g, M_MOVSX_RR, 8, r3, r2)
    g.mc.sz2[i2] = bits / 8
    ret r3
end

func mem_of(g &: Ng, v: int, extra: i64): Mem:
    k := g.v_kind[v]
    if (k == VK_INS or k == VK_ARG) and g.vak[v] == AK_ALLOCA:
        ret frame_mem(g.var_[v], extra)
    end
    if k == VK_GLB:
        s := g.v_def[v]
        if g.sy_def[s]:
            ret Mem { k = MK_RIP, sym = s, d = g.v_i[v] + extra }
        end
        ret mem_bi(use_reg(g, v), extra)
    end
    if addr_only(g, v):
        d := g.v_def[v]
        mut m := mem_of(g, g.i_a[d], extra + g.i_d[d])
        if g.i_b[d] >= 0:
            ir := g.vv[v]
            sc := g.vsc[v]
            if (m.k == MK_BI or m.k == MK_FRAME) and m.i < 0:
                m.i = ir
                m.s = sc
            else:
                base := gpr(g)
                _l := e_rm(g, M_LEA, 8, base, m)
                m = Mem { k = MK_BI, b = base, i = ir, s = sc, d = 0 as i64 }
            end
        end
        if not is_imm32(m.d):
            fail(g, "native backend: address displacement too large")
        end
        ret m
    end
    ret mem_bi(use_reg(g, v), extra)
end

func agg_mem(g &: Ng, v: int): Mem:
    ak := g.vak[v]
    if ak == AK_FRAME:
        ret frame_mem(g.var_[v], g.vao[v] as i64)
    end
    if ak == AK_PTR:
        ret mem_bi(g.var_[v], g.vao[v] as i64)
    end
    t := g.v_ty[v]
    slot := new_slot(g, tsize(g, t), talign(g, t))
    m := frame_mem(slot, 0 as i64)
    if g.v_kind[v] == VK_ZERO:
        zero_fill(g, m, tsize(g, t))
    end
    ret m
end

func mem_add(m: Mem, k: int): Mem:
    mut r := m
    r.d = r.d + (k as i64)
    ret r
end

func lea_reg(g &: Ng, m: Mem): int:
    r := gpr(g)
    _l := e_rm(g, M_LEA, 8, r, m)
    ret r
end

func emit_copy(g &: Ng, dst: Mem, src: Mem, size: int):
    if size > 256:
        mut args := Vector {} as Vector<int>
        args.push(lea_reg(g, dst))
        args.push(lea_reg(g, src))
        cr := gpr(g)
        _m := e_movi(g, cr, size as i64)
        args.push(cr)
        _r := call_lib(g, g.sym_memcpy, args, 0 - 1)
        args.free()
        ret
    end
    mut off := 0
    until off < size:
        rem := size - off
        mut ch := 8
        if rem < 8:
            if rem >= 4:
                ch = 4
            else rem >= 2:
                ch = 2
            else:
                ch = 1
            end
        end
        t := gpr(g)
        if ch >= 4:
            _l := e_rm(g, M_LD, ch, t, mem_add(src, off))
        else:
            li := e_rm(g, M_LDZX, 4, t, mem_add(src, off))
            g.mc.sz2[li] = ch
        end
        _s := e_mr(g, M_ST, ch, mem_add(dst, off), t)
        off += ch
    end
end

func zero_fill(g &: Ng, dst: Mem, size: int):
    if size > 256:
        mut args := Vector {} as Vector<int>
        args.push(lea_reg(g, dst))
        zr := gpr(g)
        _z := e_movi(g, zr, 0 as i64)
        args.push(zr)
        cr := gpr(g)
        _m := e_movi(g, cr, size as i64)
        args.push(cr)
        _r := call_lib(g, g.sym_memset, args, 0 - 1)
        args.free()
        ret
    end
    mut off := 0
    until off < size:
        rem := size - off
        mut ch := 8
        if rem < 8:
            if rem >= 4:
                ch = 4
            else rem >= 2:
                ch = 2
            else:
                ch = 1
            end
        end
        i := mi_new(g, M_STI, ch)
        set_mem(g, i, mem_add(dst, off))
        off += ch
    end
end

func fill_bytes(g &: Ng, dst: Mem, size: int, byte: int):
    mut pat := 0 as i64
    repeat 8:
        pat = (pat << (8 as i64)) | ((byte & 255) as i64)
    end
    mut off := 0
    mut pr := 0 - 1
    until off < size:
        rem := size - off
        mut ch := 8
        if rem < 8:
            if rem >= 4:
                ch = 4
            else rem >= 2:
                ch = 2
            else:
                ch = 1
            end
        end
        if ch == 8:
            if pr < 0:
                pr = gpr(g)
                _m := e_ri(g, M_MOV_RI, 8, pr, pat)
            end
            _s := e_mr(g, M_ST, 8, mem_add(dst, off), pr)
        else:
            i := mi_new(g, M_STI, ch)
            set_mem(g, i, mem_add(dst, off))
            g.mc.imm[i] = pat & ((1 as i64 << ((ch * 8) as i64)) - (1 as i64))
        end
        off += ch
    end
end

func call_lib(g &: Ng, sym: int, args: Vector<int>, ret_cls: int): int:
    mut cls := Vector {} as Vector<int>
    each r in args:
        cls.push(g.mc.vcls[r])
    end
    mask := place_args(g, args, cls, false)
    i := mi_new(g, M_CALL, 8)
    g.mc.msym[i] = sym
    g.mc.imm[i] = mask
    g.mc.has_call = true
    g.sy_used[sym] = true
    cls.free()
    if ret_cls < 0:
        ret 0 - 1
    end
    r2 := vnew(g, ret_cls)
    if ret_cls == 1:
        _c := e_copy(g, r2, XMM0)
    else:
        _c2 := e_copy(g, r2, RAX)
    end
    ret r2
end

func place_args(g &: Ng, args: Vector<int>, cls: Vector<int>, vararg: bool): i64:
    mut mask := 0 as i64
    n := args.len()
    if g.os == NG_OS_WINDOWS:
        mut stk := 32
        repeat n in p:
            if p >= 4:
                r := args[p]
                if cls[p] == 1:
                    _s := e_mr(g, M_FST, 8, mem_bi(RSP, stk as i64), r)
                else:
                    _s2 := e_mr(g, M_ST, 8, mem_bi(RSP, stk as i64), r)
                end
                stk += 8
            end
        end
        if stk > g.mc.out_args:
            g.mc.out_args = stk
        end
        repeat n in p2:
            if p2 < 4:
                r2 := args[p2]
                if cls[p2] == 1:
                    _c := e_copy(g, XMM0 + p2, r2)
                    mask = mask | ((1 as i64) << ((XMM0 + p2) as i64))
                    if vararg:
                        gr := k_win_gp[p2]
                        _q := e_rr(g, M_MOVQ_GX, 8, gr, r2)
                        mask = mask | ((1 as i64) << (gr as i64))
                    end
                else:
                    gr2 := k_win_gp[p2]
                    _c2 := e_copy(g, gr2, r2)
                    mask = mask | ((1 as i64) << (gr2 as i64))
                end
            end
        end
        ret mask
    end
    mut gi := 0
    mut fi := 0
    mut stk2 := 0
    mut where := Vector {} as Vector<int>
    repeat n in p3:
        if cls[p3] == 1:
            if fi < 8:
                where.push(XMM0 + fi)
                fi += 1
            else:
                where.push(0 - 1 - stk2)
                stk2 += 8
            end
        else:
            if gi < 6:
                where.push(k_sysv_gp[gi])
                gi += 1
            else:
                where.push(0 - 1 - stk2)
                stk2 += 8
            end
        end
    end
    repeat n in p4:
        w := where[p4]
        if w < 0:
            off := 0 - 1 - w
            if cls[p4] == 1:
                _s3 := e_mr(g, M_FST, 8, mem_bi(RSP, off as i64), args[p4])
            else:
                _s4 := e_mr(g, M_ST, 8, mem_bi(RSP, off as i64), args[p4])
            end
        end
    end
    if stk2 > g.mc.out_args:
        g.mc.out_args = stk2
    end
    repeat n in p5:
        w2 := where[p5]
        if w2 >= 0:
            _c3 := e_copy(g, w2, args[p5])
            mask = mask | ((1 as i64) << (w2 as i64))
        end
    end
    if vararg:
        _m := e_movi(g, RAX, fi as i64)
        mask = mask | (1 as i64)
    end
    where.free()
    ret mask
end

func ext_arg(g &: Ng, r: int, t: int, sign: bool): int:
    bits := int_bits(g, t)
    if bits >= 32:
        ret r
    end
    r2 := gpr(g)
    mut op := M_MOVZX_RR
    if sign and bits > 1:
        op = M_MOVSX_RR
    end
    i := e_rr(g, op, 4, r2, r)
    g.mc.sz2[i] = bits <= 8 ? 1 : 2
    ret r2
end

func entry_args(g &: Ng):
    mut gi := 0
    mut fi := 0
    mut pos := 0
    if is_agg(g, g.f_ret):
        g.retp = gpr(g)
        if g.os == NG_OS_WINDOWS:
            _c := e_copy(g, g.retp, RCX)
            pos = 1
        else:
            _c2 := e_copy(g, g.retp, RDI)
            gi = 1
        end
    end
    mut stk := 16
    if g.os == NG_OS_WINDOWS:
        stk = 16 + 8 * pos
    end
    repeat g.f_args.len() in k:
        v := g.f_args[k]
        t := g.v_ty[v]
        mut cls := vcls_ty(g, t)
        agg := is_agg(g, t)
        if agg:
            cls = 0
        end
        r := vnew(g, cls)
        if g.os == NG_OS_WINDOWS:
            if pos < 4:
                if cls == 1:
                    _c3 := e_copy(g, r, XMM0 + pos)
                else:
                    _c4 := e_copy(g, r, k_win_gp[pos])
                end
            else:
                if cls == 1:
                    _l := e_rm(g, M_FLD, 8, r, mem_bi(RBP, stk as i64))
                else:
                    _l2 := e_rm(g, M_LD, 8, r, mem_bi(RBP, stk as i64))
                end
            end
            stk += 8
            pos += 1
        else:
            if cls == 1 and fi < 8:
                _c5 := e_copy(g, r, XMM0 + fi)
                fi += 1
            else cls == 0 and gi < 6:
                _c6 := e_copy(g, r, k_sysv_gp[gi])
                gi += 1
            else:
                if cls == 1:
                    _l3 := e_rm(g, M_FLD, 8, r, mem_bi(RBP, stk as i64))
                else:
                    _l4 := e_rm(g, M_LD, 8, r, mem_bi(RBP, stk as i64))
                end
                stk += 8
            end
        end
        if agg:
            g.vak[v] = AK_PTR
            g.var_[v] = r
            g.vao[v] = 0
        end
        g.vv[v] = r
    end
end

func setup_phis(g &: Ng):
    each b in g.b_rpo:
        mut i := g.b_first[b]
        until i >= 0 and g.i_op[i] == OP_PHI:
            r := g.i_res[i]
            t := g.i_ty[i]
            if is_agg(g, t):
                g.phit[i] = new_slot(g, tsize(g, t), talign(g, t))
                if r >= 0:
                    g.vak[r] = AK_FRAME
                    g.var_[r] = new_slot(g, tsize(g, t), talign(g, t))
                    g.vao[r] = 0
                end
            else:
                g.phit[i] = new_reg_ty(g, t)
                if r >= 0:
                    g.vv[r] = new_reg_ty(g, t)
                end
            end
            i = g.i_next[i]
        end
    end
end

func phi_copies(g &: Ng, b: int):
    repeat g.b_sn[b] in k:
        s := g.b_succ[g.b_ss[b] + k]
        mut i := g.b_first[s]
        until i >= 0 and g.i_op[i] == OP_PHI:
            ps := g.i_ps[i]
            repeat g.i_pn[i] in q:
                if g.pool[ps + 2 * q + 1] == b:
                    v := g.pool[ps + 2 * q]
                    t := g.i_ty[i]
                    if is_agg(g, t):
                        if g.v_kind[v] != VK_UNDEF:
                            emit_copy(g, frame_mem(g.phit[i], 0 as i64), agg_mem(g, v), tsize(g, t))
                        end
                    else g.v_kind[v] != VK_UNDEF:
                        move_into(g, g.phit[i], v)
                    end
                    break
                end
            end
            i = g.i_next[i]
        end
    end
end

func icmp_cc(p: int): int:
    switch p:
        CC_EQ: ret X_E end
        CC_NE: ret X_NE end
        CC_SLT: ret X_L end
        CC_SLE: ret X_LE end
        CC_SGT: ret X_G end
        CC_SGE: ret X_GE end
        CC_ULT: ret X_B end
        CC_ULE: ret X_BE end
        CC_UGT: ret X_A end
        CC_UGE: ret X_AE end
    end
    ret X_E
end

func swap_pred(p: int): int:
    switch p:
        CC_SLT: ret CC_SGT end
        CC_SLE: ret CC_SGE end
        CC_SGT: ret CC_SLT end
        CC_SGE: ret CC_SLE end
        CC_ULT: ret CC_UGT end
        CC_ULE: ret CC_UGE end
        CC_UGT: ret CC_ULT end
        CC_UGE: ret CC_ULE end
    end
    ret p
end

func emit_icmp(g &: Ng, i: int): int:
    mut a := g.i_a[i]
    mut b := g.i_b[i]
    mut p := g.i_x[i]
    if g.v_kind[a] == VK_INT and g.v_kind[b] != VK_INT:
        tmp := a
        a = b
        b = tmp
        p = swap_pred(p)
    end
    sz := msz(g, g.v_ty[a])
    ra := use_reg(g, a)
    if g.v_kind[b] == VK_INT and is_imm32(g.v_i[b]):
        if g.v_i[b] == (0 as i64) and (p == CC_EQ or p == CC_NE):
            _t := e_rr(g, M_TEST_RR, sz, ra, ra)
        else:
            mut imm := g.v_i[b]
            if sz == 1:
                imm = imm & (255 as i64)
            else sz == 2:
                imm = imm & (65535 as i64)
            end
            _c := e_alui(g, ALU_CMP, sz, ra, imm)
        end
    else:
        rb := use_reg(g, b)
        _c2 := e_alu(g, ALU_CMP, sz, ra, rb)
    end
    ret icmp_cc(p)
end

func fcmp_setup(g &: Ng, i: int): int:
    p := g.i_x[i]
    mut a := g.i_a[i]
    mut b := g.i_b[i]
    mut np := p
    if p == FC_OLT or p == FC_OLE or p == FC_UGT or p == FC_UGE:
        tmp := a
        a = b
        b = tmp
        if p == FC_OLT: np = FC_OGT end
        if p == FC_OLE: np = FC_OGE end
        if p == FC_UGT: np = FC_ULT end
        if p == FC_UGE: np = FC_ULE end
    end
    ra := use_reg(g, a)
    rb := use_reg(g, b)
    _u := e_rr(g, M_UCOMI, fsz(g.v_ty[a]), ra, rb)
    ret np
end

func fcmp_cc(np: int): int:
    switch np:
        FC_OGT: ret X_A end
        FC_OGE: ret X_AE end
        FC_ULT: ret X_B end
        FC_ULE: ret X_BE end
        FC_UEQ: ret X_E end
        FC_ONE: ret X_NE end
        FC_ORD: ret X_NP end
        FC_UNO: ret X_P end
    end
    ret 0 - 1
end

func fused_cond(g &: Ng, br: int): int:
    c := g.i_a[br]
    if c < 0 or g.v_kind[c] != VK_INS or g.v_uses[c] != 1:
        ret 0 - 1
    end
    d := g.v_def[c]
    if g.i_next[d] != br:
        ret 0 - 1
    end
    op := g.i_op[d]
    if op == OP_ICMP:
        ret d
    end
    if op == OP_FCMP:
        p := g.i_x[d]
        if p != FC_FALSE and p != FC_TRUE:
            ret d
        end
    end
    ret 0 - 1
end

func isel_cbr(g &: Ng, i: int, b: int):
    tb := g.i_b[i]
    fb := g.i_c[i]
    phi_copies(g, b)
    c := g.i_a[i]
    if g.v_kind[c] == VK_INT:
        if (g.v_i[c] & (1 as i64)) != (0 as i64):
            _j := e_jmp(g, tb)
        else:
            _j2 := e_jmp(g, fb)
        end
        ret
    end
    d := fused_cond(g, i)
    if d >= 0 and g.i_op[d] == OP_ICMP:
        cc := emit_icmp(g, d)
        _j3 := e_jcc(g, cc, tb)
        _j4 := e_jmp(g, fb)
        ret
    end
    if d >= 0:
        np := fcmp_setup(g, d)
        if np == FC_OEQ:
            _j5 := e_jcc(g, X_P, fb)
            _j6 := e_jcc(g, X_E, tb)
            _j7 := e_jmp(g, fb)
            ret
        end
        if np == FC_UNE:
            _j8 := e_jcc(g, X_P, tb)
            _j9 := e_jcc(g, X_NE, tb)
            _ja := e_jmp(g, fb)
            ret
        end
        _jb := e_jcc(g, fcmp_cc(np), tb)
        _jc := e_jmp(g, fb)
        ret
    end
    rc := use_reg(g, c)
    _t := e_rr(g, M_TEST_RR, 1, rc, rc)
    _jd := e_jcc(g, X_NE, tb)
    _je := e_jmp(g, fb)
end

func set_res(g &: Ng, i: int, r: int):
    v := g.i_res[i]
    if v >= 0:
        g.vv[v] = r
    end
end

func res_used(g &: Ng, i: int): bool:
    v := g.i_res[i]
    ret v >= 0 and g.v_uses[v] > 0
end

func isel_bin(g &: Ng, i: int):
    op := g.i_op[i]
    t := g.i_ty[i]
    mut a := g.i_a[i]
    mut b := g.i_b[i]
    sz := asz(g, t)
    comm := op == OP_ADD or op == OP_MUL or op == OP_AND or op == OP_OR or op == OP_XOR
    if comm and g.v_kind[a] == VK_INT and g.v_kind[b] != VK_INT:
        tmp := a
        a = b
        b = tmp
    end
    bimm := g.v_kind[b] == VK_INT and is_imm32(g.v_i[b])
    if op == OP_MUL:
        r := gpr(g)
        if bimm:
            ra := use_reg(g, a)
            mi := e_rr(g, M_IMUL_RRI, sz, r, ra)
            g.mc.imm[mi] = g.v_i[b]
        else:
            move_into(g, r, a)
            rb := use_reg(g, b)
            _m := e_rr(g, M_IMUL_RR, sz, r, rb)
        end
        set_res(g, i, r)
        ret
    end
    if op == OP_SUB and g.v_kind[a] == VK_INT and g.v_i[a] == (0 as i64):
        r2 := gpr(g)
        move_into(g, r2, b)
        _n := e_rr(g, M_UNARY, sz, r2, 0 - 1)
        g.mc.cc[g.mc.op.len() - 1] = UN_NEG
        set_res(g, i, r2)
        ret
    end
    mut sub := ALU_ADD
    if op == OP_SUB: sub = ALU_SUB end
    if op == OP_AND: sub = ALU_AND end
    if op == OP_OR: sub = ALU_OR end
    if op == OP_XOR: sub = ALU_XOR end
    r3 := gpr(g)
    move_into(g, r3, a)
    if bimm:
        _x := e_alui(g, sub, sz, r3, g.v_i[b])
    else:
        rb2 := use_reg(g, b)
        _y := e_alu(g, sub, sz, r3, rb2)
    end
    set_res(g, i, r3)
end

func ext_to32(g &: Ng, v: int, t: int, sign: bool): int:
    r := use_reg(g, v)
    bits := int_bits(g, t)
    if bits >= 32:
        ret r
    end
    r2 := gpr(g)
    mut op := M_MOVZX_RR
    if sign and bits > 1:
        op = M_MOVSX_RR
    end
    i := e_rr(g, op, 4, r2, r)
    g.mc.sz2[i] = bits <= 8 ? 1 : 2
    if bits == 1 and sign:
        n := e_rr(g, M_UNARY, 4, r2, 0 - 1)
        g.mc.cc[n] = UN_NEG
    end
    ret r2
end

func isel_div(g &: Ng, i: int):
    op := g.i_op[i]
    t := g.i_ty[i]
    sz := asz(g, t)
    sign := op == OP_SDIV or op == OP_SREM
    b := g.i_b[i]
    if not sign and g.v_kind[b] == VK_INT and g.v_i[b] > (0 as i64):
        bv := g.v_i[b]
        if (bv & (bv - (1 as i64))) == (0 as i64):
            mut sh := 0
            until ((1 as i64) << (sh as i64)) < bv:
                sh += 1
            end
            ra := ext_to32(g, g.i_a[i], t, false)
            r := gpr(g)
            _c := e_copy(g, r, ra)
            if op == OP_UDIV:
                if sh > 0:
                    s := e_ri(g, M_SHIFT_RI, sz, r, sh as i64)
                    g.mc.cc[s] = SH_SHR
                end
            else:
                if is_imm32(bv - (1 as i64)):
                    _a := e_alui(g, ALU_AND, sz, r, bv - (1 as i64))
                else:
                    m := gpr(g)
                    _mm := e_ri(g, M_MOV_RI, 8, m, bv - (1 as i64))
                    _aa := e_alu(g, ALU_AND, sz, r, m)
                end
            end
            set_res(g, i, r)
            ret
        end
    end
    ra2 := ext_to32(g, g.i_a[i], t, sign)
    rb := ext_to32(g, b, t, sign)
    _c2 := e_copy(g, RAX, ra2)
    if sign:
        _q := mi_new(g, M_CQO, sz)
    else:
        _z := e_ri(g, M_MOV_RI, 4, RDX, 0 as i64)
    end
    d := e_rr(g, M_DIV, sz, 0 - 1, rb)
    g.mc.cc[d] = sign ? 1 : 0
    r2 := gpr(g)
    if op == OP_SDIV or op == OP_UDIV:
        _c3 := e_copy(g, r2, RAX)
    else:
        _c4 := e_copy(g, r2, RDX)
    end
    set_res(g, i, r2)
end

func isel_shift(g &: Ng, i: int):
    op := g.i_op[i]
    t := g.i_ty[i]
    sz := asz(g, t)
    bits := int_bits(g, t)
    mut sub := SH_SHL
    mut ra := 0 - 1
    if op == OP_LSHR:
        sub = SH_SHR
        ra = ext_to32(g, g.i_a[i], t, false)
    else op == OP_ASHR:
        sub = SH_SAR
        ra = ext_to32(g, g.i_a[i], t, true)
    else:
        ra = use_reg(g, g.i_a[i])
    end
    r := gpr(g)
    _c := e_copy(g, r, ra)
    b := g.i_b[i]
    if g.v_kind[b] == VK_INT:
        n := (g.v_i[b] as int) & (bits - 1)
        if n != 0:
            s := e_ri(g, M_SHIFT_RI, sz, r, n as i64)
            g.mc.cc[s] = sub
        end
    else:
        rb := use_reg(g, b)
        _c2 := e_copy(g, RCX, rb)
        s2 := e_rr(g, M_SHIFT_RC, sz, r, 0 - 1)
        g.mc.cc[s2] = sub
    end
    set_res(g, i, r)
end

func isel_fbin(g &: Ng, i: int):
    op := g.i_op[i]
    t := g.i_ty[i]
    sz := fsz(t)
    if op == OP_FREM:
        mut args := Vector {} as Vector<int>
        args.push(use_reg(g, g.i_a[i]))
        args.push(use_reg(g, g.i_b[i]))
        mut nm := "fmod"
        if sz == 4:
            nm = "fmodf"
        end
        rr := call_lib(g, sym_named(g, nm), args, 1)
        g.sy_kind[sym_named(g, nm)] = SY_FUNC
        args.free()
        set_res(g, i, rr)
        ret
    end
    mut sub := FO_ADD
    if op == OP_FSUB: sub = FO_SUB end
    if op == OP_FMUL: sub = FO_MUL end
    if op == OP_FDIV: sub = FO_DIV end
    ra := use_reg(g, g.i_a[i])
    r := xmm(g)
    _c := e_copy(g, r, ra)
    rb := use_reg(g, g.i_b[i])
    f := e_rr(g, M_FOP_RR, sz, r, rb)
    g.mc.cc[f] = sub
    set_res(g, i, r)
end

func isel_cast(g &: Ng, i: int):
    op := g.i_op[i]
    st := g.i_x[i]
    dt := g.i_ty[i]
    a := g.i_a[i]
    if op == OP_PTRTOINT or op == OP_INTTOPTR or (op == OP_BITCAST and vcls_ty(g, st) == vcls_ty(g, dt)):
        set_res(g, i, use_reg(g, a))
        ret
    end
    if op == OP_BITCAST:
        ra := use_reg(g, a)
        if vcls_ty(g, dt) == 1:
            r := xmm(g)
            _q := e_rr(g, M_MOVQ_XG, fsz(dt), r, ra)
            set_res(g, i, r)
        else:
            r2 := gpr(g)
            _q2 := e_rr(g, M_MOVQ_GX, fsz(st), r2, ra)
            set_res(g, i, r2)
        end
        ret
    end
    if op == OP_TRUNC:
        ra2 := use_reg(g, a)
        if dt == T_I1:
            r3 := gpr(g)
            _c := e_copy(g, r3, ra2)
            _x := e_alui(g, ALU_AND, 4, r3, 1 as i64)
            set_res(g, i, r3)
        else:
            set_res(g, i, ra2)
        end
        ret
    end
    if op == OP_ZEXT or op == OP_SEXT:
        sb := int_bits(g, st)
        db := int_bits(g, dt)
        ra3 := use_reg(g, a)
        r4 := gpr(g)
        if op == OP_ZEXT:
            if sb >= 32:
                _m := e_rr(g, M_MOV_RR, 4, r4, ra3)
            else:
                z := e_rr(g, M_MOVZX_RR, 4, r4, ra3)
                g.mc.sz2[z] = sb <= 8 ? 1 : 2
            end
        else:
            dsz := db > 32 ? 8 : 4
            if sb == 1:
                z2 := e_rr(g, M_MOVZX_RR, 4, r4, ra3)
                g.mc.sz2[z2] = 1
                n := e_rr(g, M_UNARY, dsz, r4, 0 - 1)
                g.mc.cc[n] = UN_NEG
            else:
                s := e_rr(g, M_MOVSX_RR, dsz, r4, ra3)
                g.mc.sz2[s] = sb / 8
            end
        end
        set_res(g, i, r4)
        ret
    end
    if op == OP_SITOFP or op == OP_UITOFP:
        sb2 := int_bits(g, st)
        mut ri := 0 - 1
        mut isz := 4
        if op == OP_SITOFP:
            ri = ext_to32(g, a, st, true)
            if sb2 > 32:
                isz = 8
            end
        else:
            if sb2 < 64:
                rz := ext_to32(g, a, st, false)
                ri = gpr(g)
                _m2 := e_rr(g, M_MOV_RR, 4, ri, rz)
                isz = 8
            else:
                set_res(g, i, u64_to_f(g, use_reg(g, a), dt))
                ret
            end
        end
        r5 := xmm(g)
        cv := e_rr(g, M_CVTSI2F, fsz(dt), r5, ri)
        g.mc.sz2[cv] = isz
        set_res(g, i, r5)
        ret
    end
    if op == OP_FPTOSI or op == OP_FPTOUI:
        db2 := int_bits(g, dt)
        ra4 := use_reg(g, a)
        if op == OP_FPTOUI and db2 >= 64:
            set_res(g, i, f_to_u64(g, ra4, st))
            ret
        end
        r6 := gpr(g)
        cv2 := e_rr(g, M_CVTF2SI, fsz(st), r6, ra4)
        g.mc.sz2[cv2] = (db2 > 32 or op == OP_FPTOUI) ? 8 : 4
        set_res(g, i, r6)
        ret
    end
    if op == OP_FPEXT or op == OP_FPTRUNC:
        ra5 := use_reg(g, a)
        r7 := xmm(g)
        _cv := e_rr(g, M_CVTF2F, fsz(dt), r7, ra5)
        set_res(g, i, r7)
        ret
    end
    fail(g, "native backend: unsupported cast")
end

func u64_to_f(g &: Ng, ra: int, dt: int): int:
    r := xmm(g)
    big := new_label(g)
    done := new_label(g)
    _t := e_rr(g, M_TEST_RR, 8, ra, ra)
    _j := e_jcc(g, X_S, big)
    c := e_rr(g, M_CVTSI2F, fsz(dt), r, ra)
    g.mc.sz2[c] = 8
    _j2 := e_jmp(g, done)
    _l := e_label(g, big)
    h := gpr(g)
    _c1 := e_copy(g, h, ra)
    s := e_ri(g, M_SHIFT_RI, 8, h, 1 as i64)
    g.mc.cc[s] = SH_SHR
    lo := gpr(g)
    _c2 := e_copy(g, lo, ra)
    _a := e_alui(g, ALU_AND, 8, lo, 1 as i64)
    _o := e_alu(g, ALU_OR, 8, h, lo)
    c2 := e_rr(g, M_CVTSI2F, fsz(dt), r, h)
    g.mc.sz2[c2] = 8
    f := e_rr(g, M_FOP_RR, fsz(dt), r, r)
    g.mc.cc[f] = FO_ADD
    _l2 := e_label(g, done)
    ret r
end

func f_to_u64(g &: Ng, ra: int, st: int): int:
    sz := fsz(st)
    r := gpr(g)
    lim := xmm(g)
    mut bits := 0x43E0000000000000 as i64
    _l := e_rm(g, M_FLD, sz, lim, fp_const(g, bits, sz))
    big := new_label(g)
    done := new_label(g)
    _u := e_rr(g, M_UCOMI, sz, ra, lim)
    _j := e_jcc(g, X_AE, big)
    c := e_rr(g, M_CVTF2SI, sz, r, ra)
    g.mc.sz2[c] = 8
    _j2 := e_jmp(g, done)
    _lb := e_label(g, big)
    y := xmm(g)
    _cy := e_copy(g, y, ra)
    f := e_rr(g, M_FOP_RR, sz, y, lim)
    g.mc.cc[f] = FO_SUB
    c2 := e_rr(g, M_CVTF2SI, sz, r, y)
    g.mc.sz2[c2] = 8
    m := gpr(g)
    bits = 0 - 9223372036854775807 as i64
    bits = bits - (1 as i64)
    _mm := e_ri(g, M_MOV_RI, 8, m, bits)
    _x := e_alu(g, ALU_XOR, 8, r, m)
    _ld := e_label(g, done)
    ret r
end

func isel_load(g &: Ng, i: int):
    t := g.i_ty[i]
    a := g.i_a[i]
    if is_agg(g, t):
        r := g.i_res[i]
        slot := new_slot(g, tsize(g, t), talign(g, t))
        emit_copy(g, frame_mem(slot, 0 as i64), mem_of(g, a, 0 as i64), tsize(g, t))
        if r >= 0:
            g.vak[r] = AK_FRAME
            g.var_[r] = slot
            g.vao[r] = 0
        end
        ret
    end
    if not res_used(g, i) and (g.i_f[i] & IF_VOLATILE) == 0:
        ret
    end
    m := mem_of(g, a, 0 as i64)
    if is_flt(g, t):
        r2 := xmm(g)
        _l := e_rm(g, M_FLD, fsz(t), r2, m)
        set_res(g, i, r2)
        ret
    end
    r3 := gpr(g)
    sz := msz(g, t)
    if sz >= 4:
        _l2 := e_rm(g, M_LD, sz, r3, m)
    else:
        l := e_rm(g, M_LDZX, 4, r3, m)
        g.mc.sz2[l] = sz
    end
    set_res(g, i, r3)
end

func isel_store(g &: Ng, i: int):
    v := g.i_a[i]
    p := g.i_b[i]
    t := g.v_ty[v]
    if is_agg(g, t):
        k := g.v_kind[v]
        if k == VK_UNDEF:
            ret
        end
        m := mem_of(g, p, 0 as i64)
        if k == VK_ZERO:
            zero_fill(g, m, tsize(g, t))
            ret
        end
        emit_copy(g, m, agg_mem(g, v), tsize(g, t))
        ret
    end
    atomic := (g.i_f[i] & IF_ATOMIC) != 0
    if g.v_kind[v] == VK_INT and not is_flt(g, t) and is_imm32(g.v_i[v]) and not atomic:
        m2 := mem_of(g, p, 0 as i64)
        si := mi_new(g, M_STI, msz(g, t))
        set_mem(g, si, m2)
        g.mc.imm[si] = g.v_i[v]
        ret
    end
    r := use_reg(g, v)
    m3 := mem_of(g, p, 0 as i64)
    if is_flt(g, t):
        _s := e_mr(g, M_FST, fsz(t), m3, r)
        ret
    end
    if atomic:
        t2 := gpr(g)
        _c := e_copy(g, t2, r)
        _x := e_rm(g, M_XCHG, msz(g, t), t2, m3)
        ret
    end
    _s2 := e_mr(g, M_ST, msz(g, t), m3, r)
end

func isel_addr(g &: Ng, i: int):
    v := g.i_res[i]
    if v < 0 or g.v_uses[v] == 0:
        ret
    end
    idx := g.i_b[i]
    if addr_only(g, v):
        if idx >= 0:
            ir := idx_reg(g, idx, g.v_ty[idx])
            sc := g.i_x[i]
            if sc == 1 or sc == 2 or sc == 4 or sc == 8:
                g.vv[v] = ir
                g.vsc[v] = sc
            else:
                r := gpr(g)
                mi := e_rr(g, M_IMUL_RRI, 8, r, ir)
                g.mc.imm[mi] = sc as i64
                g.vv[v] = r
                g.vsc[v] = 1
            end
        end
        ret
    end
    mut m := mem_of(g, g.i_a[i], g.i_d[i])
    if idx >= 0:
        ir2 := idx_reg(g, idx, g.v_ty[idx])
        mut sc2 := g.i_x[i]
        mut irr := ir2
        if not (sc2 == 1 or sc2 == 2 or sc2 == 4 or sc2 == 8):
            irr = gpr(g)
            mi2 := e_rr(g, M_IMUL_RRI, 8, irr, ir2)
            g.mc.imm[mi2] = sc2 as i64
            sc2 = 1
        end
        if (m.k == MK_BI or m.k == MK_FRAME) and m.i < 0:
            m.i = irr
            m.s = sc2
        else:
            base := lea_reg(g, m)
            m = Mem { k = MK_BI, b = base, i = irr, s = sc2, d = 0 as i64 }
        end
    end
    r2 := gpr(g)
    if m.k == MK_BI and m.i < 0 and m.d == (0 as i64):
        _c := e_copy(g, r2, m.b)
    else:
        _l := e_rm(g, M_LEA, 8, r2, m)
    end
    g.vv[v] = r2
end

func isel_select(g &: Ng, i: int):
    t := g.i_ty[i]
    c := g.i_a[i]
    if is_agg(g, t):
        pa := lea_reg(g, agg_mem(g, g.i_b[i]))
        pb := lea_reg(g, agg_mem(g, g.i_c[i]))
        rc := use_reg(g, c)
        r := gpr(g)
        _c := e_copy(g, r, pb)
        _t := e_rr(g, M_TEST_RR, 1, rc, rc)
        cm := e_rr(g, M_CMOV, 8, r, pa)
        g.mc.cc[cm] = X_NE
        v := g.i_res[i]
        if v >= 0:
            g.vak[v] = AK_PTR
            g.var_[v] = r
            g.vao[v] = 0
        end
        ret
    end
    rt := use_reg(g, g.i_b[i])
    rf := use_reg(g, g.i_c[i])
    rc2 := use_reg(g, c)
    if is_flt(g, t):
        r2 := xmm(g)
        _c2 := e_copy(g, r2, rf)
        l := new_label(g)
        _t2 := e_rr(g, M_TEST_RR, 1, rc2, rc2)
        _j := e_jcc(g, X_E, l)
        _c3 := e_copy(g, r2, rt)
        _l := e_label(g, l)
        set_res(g, i, r2)
        ret
    end
    r3 := gpr(g)
    _c4 := e_copy(g, r3, rf)
    _t3 := e_rr(g, M_TEST_RR, 1, rc2, rc2)
    cm2 := e_rr(g, M_CMOV, asz(g, t), r3, rt)
    g.mc.cc[cm2] = X_NE
    set_res(g, i, r3)
end

func isel_insv(g &: Ng, i: int):
    t := g.i_ty[i]
    a := g.i_a[i]
    r := g.i_res[i]
    sz := tsize(g, t)
    mut slot := 0 - 1
    k := g.v_kind[a]
    if k == VK_INS and g.vak[a] == AK_FRAME and g.vao[a] == 0 and g.v_uses[a] == 1 and def_op(g, a) != OP_PHI:
        slot = g.var_[a]
    else:
        slot = new_slot(g, sz, talign(g, t))
        if k == VK_ZERO:
            zero_fill(g, frame_mem(slot, 0 as i64), sz)
        else k != VK_UNDEF:
            emit_copy(g, frame_mem(slot, 0 as i64), agg_mem(g, a), sz)
        end
    end
    store_field(g, frame_mem(slot, g.i_d[i]), g.i_b[i], g.i_x[i])
    if r >= 0:
        g.vak[r] = AK_FRAME
        g.var_[r] = slot
        g.vao[r] = 0
    end
end

func store_field(g &: Ng, m: Mem, v: int, ft: int):
    if is_agg(g, ft):
        kv := g.v_kind[v]
        if kv == VK_ZERO:
            zero_fill(g, m, tsize(g, ft))
        else kv != VK_UNDEF:
            emit_copy(g, m, agg_mem(g, v), tsize(g, ft))
        end
        ret
    end
    if g.v_kind[v] == VK_UNDEF:
        ret
    end
    if g.v_kind[v] == VK_INT and not is_flt(g, ft) and is_imm32(g.v_i[v]):
        si := mi_new(g, M_STI, msz(g, ft))
        set_mem(g, si, m)
        g.mc.imm[si] = g.v_i[v]
        ret
    end
    rv := use_reg(g, v)
    if is_flt(g, ft):
        _s := e_mr(g, M_FST, fsz(ft), m, rv)
    else:
        _s2 := e_mr(g, M_ST, msz(g, ft), m, rv)
    end
end

func isel_extv(g &: Ng, i: int):
    t := g.i_ty[i]
    a := g.i_a[i]
    r := g.i_res[i]
    off := g.i_d[i] as int
    if r < 0 or g.v_uses[r] == 0:
        ret
    end
    if is_agg(g, t):
        am := agg_mem(g, a)
        if am.k == MK_FRAME:
            g.vak[r] = AK_FRAME
            g.var_[r] = am.b
            g.vao[r] = (am.d as int) + off
        else:
            g.vak[r] = AK_PTR
            g.var_[r] = am.b
            g.vao[r] = (am.d as int) + off
        end
        ret
    end
    k := g.v_kind[a]
    if k == VK_ZERO or k == VK_UNDEF:
        if is_flt(g, t):
            r1 := xmm(g)
            _x := e_rr(g, M_XORPS, 8, r1, r1)
            set_res(g, i, r1)
        else:
            r2 := gpr(g)
            _m := e_movi(g, r2, 0 as i64)
            set_res(g, i, r2)
        end
        ret
    end
    m := mem_add(agg_mem(g, a), off)
    if is_flt(g, t):
        r3 := xmm(g)
        _l := e_rm(g, M_FLD, fsz(t), r3, m)
        set_res(g, i, r3)
        ret
    end
    r4 := gpr(g)
    sz := msz(g, t)
    if sz >= 4:
        _l2 := e_rm(g, M_LD, sz, r4, m)
    else:
        l := e_rm(g, M_LDZX, 4, r4, m)
        g.mc.sz2[l] = sz
    end
    set_res(g, i, r4)
end

func isel_call(g &: Ng, i: int):
    callee := g.i_a[i]
    mut sym := 0 - 1
    if g.v_kind[callee] == VK_GLB and g.v_i[callee] == (0 as i64):
        sym = g.v_def[callee]
    end
    ps := g.i_ps[i]
    na := g.i_pn[i]
    rt := g.i_ty[i]
    if sym >= 0 and isel_intrinsic(g, i, sym):
        ret
    end
    mut regs := Vector {} as Vector<int>
    mut cls := Vector {} as Vector<int>
    mut rslot := 0 - 1
    if is_agg(g, rt):
        rslot = new_slot(g, tsize(g, rt), talign(g, rt))
        regs.push(lea_reg(g, frame_mem(rslot, 0 as i64)))
        cls.push(0)
    end
    repeat na in k:
        v := g.pool[ps + 3 * k]
        fl := g.pool[ps + 3 * k + 1]
        aux := g.pool[ps + 3 * k + 2]
        t := g.v_ty[v]
        if (fl & IF_BYVAL) != 0 and aux >= 0:
            bs := new_slot(g, tsize(g, aux), talign(g, aux))
            emit_copy(g, frame_mem(bs, 0 as i64), mem_of(g, v, 0 as i64), tsize(g, aux))
            regs.push(lea_reg(g, frame_mem(bs, 0 as i64)))
            cls.push(0)
        else is_agg(g, t):
            regs.push(lea_reg(g, agg_mem(g, v)))
            cls.push(0)
        else is_flt(g, t):
            regs.push(use_reg(g, v))
            cls.push(1)
        else:
            r := use_reg(g, v)
            if int_bits(g, t) < 32:
                regs.push(ext_arg(g, r, t, (fl & IF_SEXT) != 0))
            else:
                regs.push(r)
            end
            cls.push(0)
        end
    end
    mut cr := 0 - 1
    if sym < 0:
        cr = use_reg(g, callee)
    end
    vararg := (g.i_f[i] & IF_VARARG) != 0
    mask := place_args(g, regs, cls, vararg)
    mut ci := 0 - 1
    if sym >= 0:
        ci = mi_new(g, M_CALL, 8)
        g.mc.msym[ci] = sym
        g.sy_used[sym] = true
        if g.sy_kind[sym] == SY_UNKNOWN:
            g.sy_kind[sym] = SY_FUNC
        end
    else:
        ci = e_rr(g, M_CALLR, 8, 0 - 1, cr)
    end
    g.mc.imm[ci] = mask
    g.mc.has_call = true
    regs.free()
    cls.free()
    v2 := g.i_res[i]
    if rslot >= 0:
        if v2 >= 0:
            g.vak[v2] = AK_FRAME
            g.var_[v2] = rslot
            g.vao[v2] = 0
        end
        ret
    end
    if rt == T_VOID or v2 < 0:
        ret
    end
    if is_flt(g, rt):
        r2 := xmm(g)
        _c := e_copy(g, r2, XMM0)
        g.vv[v2] = r2
    else:
        r3 := gpr(g)
        _c2 := e_copy(g, r3, RAX)
        g.vv[v2] = r3
    end
end

func call_arg(g &: Ng, i: int, k: int): int:
    ret g.pool[g.i_ps[i] + 3 * k]
end

func isel_intrinsic(g &: Ng, i: int, sym: int): bool:
    if sym == g.sym_i_trap:
        _u := mi_new(g, M_UD2, 0)
        ret true
    end
    if sym == g.sym_i_memcpy or sym == g.sym_i_memmove or sym == g.sym_i_memset:
        dst := call_arg(g, i, 0)
        src := call_arg(g, i, 1)
        ln := call_arg(g, i, 2)
        if g.v_kind[ln] == VK_INT and g.v_i[ln] <= (256 as i64):
            n := g.v_i[ln] as int
            if sym == g.sym_i_memset:
                if g.v_kind[src] == VK_INT:
                    fill_bytes(g, mem_of(g, dst, 0 as i64), n, g.v_i[src] as int)
                    ret true
                end
            else sym == g.sym_i_memcpy:
                emit_copy(g, mem_of(g, dst, 0 as i64), mem_of(g, src, 0 as i64), n)
                ret true
            end
        end
        mut args := Vector {} as Vector<int>
        args.push(use_reg(g, dst))
        if sym == g.sym_i_memset:
            args.push(ext_arg(g, use_reg(g, src), T_I8, false))
        else:
            args.push(use_reg(g, src))
        end
        args.push(use_reg(g, ln))
        mut target := g.sym_memcpy
        if sym == g.sym_i_memmove:
            target = g.sym_memmove
        else sym == g.sym_i_memset:
            target = g.sym_memset
        end
        _r := call_lib(g, target, args, 0 - 1)
        args.free()
        ret true
    end
    if sym == g.sym_i_pow:
        mut args2 := Vector {} as Vector<int>
        args2.push(use_reg(g, call_arg(g, i, 0)))
        args2.push(use_reg(g, call_arg(g, i, 1)))
        r := call_lib(g, g.sym_pow, args2, 1)
        args2.free()
        set_res(g, i, r)
        ret true
    end
    if g.sy_def[sym] or g.syms.len[sym] < 5:
        ret false
    end
    o := g.syms.off[sym]
    if g.syms.bytes[o] == (108 as u8) and g.syms.bytes[o + 1] == (108 as u8) and g.syms.bytes[o + 2] == (118 as u8) and g.syms.bytes[o + 3] == (109 as u8) and g.syms.bytes[o + 4] == (46 as u8):
        fail(g, "native backend: unsupported intrinsic @" + tab_str(g.syms, sym))
        ret true
    end
    ret false
end

func isel_rmw(g &: Ng, i: int):
    t := g.i_ty[i]
    sz := msz(g, t)
    m := mem_of(g, g.i_a[i], 0 as i64)
    rv := use_reg(g, g.i_b[i])
    op := g.i_x[i]
    r := gpr(g)
    if op == RMW_XCHG:
        _c := e_copy(g, r, rv)
        _x := e_rm(g, M_XCHG, sz, r, m)
    else op == RMW_ADD or op == RMW_SUB:
        _c2 := e_copy(g, r, rv)
        if op == RMW_SUB:
            n := e_rr(g, M_UNARY, sz < 4 ? 4 : sz, r, 0 - 1)
            g.mc.cc[n] = UN_NEG
        end
        _a := e_rm(g, M_LXADD, sz, r, m)
    else:
        loop := new_label(g)
        _l := e_rm(g, M_LD, sz < 4 ? 4 : sz, RAX, m)
        _lb := e_label(g, loop)
        tt := gpr(g)
        _c3 := e_copy(g, tt, RAX)
        mut sub := ALU_AND
        if op == RMW_OR: sub = ALU_OR end
        if op == RMW_XOR: sub = ALU_XOR end
        _o := e_alu(g, sub, 8, tt, rv)
        _cx := e_mr(g, M_LCMPXCHG, sz, m, tt)
        _j := e_jcc(g, X_NE, loop)
        _c4 := e_copy(g, r, RAX)
    end
    set_res(g, i, r)
end

func isel_cmpxchg(g &: Ng, i: int):
    t := g.i_ty[i]
    vt := field_ty(g, t, 0)
    sz := msz(g, vt)
    m := mem_of(g, g.i_a[i], 0 as i64)
    rc := use_reg(g, g.i_b[i])
    rn := use_reg(g, g.i_c[i])
    _c := e_copy(g, RAX, rc)
    _x := e_mr(g, M_LCMPXCHG, sz, m, rn)
    ok := gpr(g)
    _s := e_setcc(g, X_E, ok)
    slot := new_slot(g, tsize(g, t), talign(g, t))
    old := gpr(g)
    _c2 := e_copy(g, old, RAX)
    _st := e_mr(g, M_ST, sz, frame_mem(slot, 0 as i64), old)
    _st2 := e_mr(g, M_ST, 1, frame_mem(slot, field_off(g, t, 1) as i64), ok)
    v := g.i_res[i]
    if v >= 0:
        g.vak[v] = AK_FRAME
        g.var_[v] = slot
        g.vao[v] = 0
    end
end

func isel_ret(g &: Ng, i: int):
    a := g.i_a[i]
    mut mask := 0 as i64
    if a >= 0:
        t := g.v_ty[a]
        if is_agg(g, t):
            if g.v_kind[a] == VK_ZERO:
                zero_fill(g, mem_bi(g.retp, 0 as i64), tsize(g, t))
            else g.v_kind[a] != VK_UNDEF:
                emit_copy(g, mem_bi(g.retp, 0 as i64), agg_mem(g, a), tsize(g, t))
            end
            _c := e_copy(g, RAX, g.retp)
            mask = 1 as i64
        else is_flt(g, t):
            r := use_reg(g, a)
            _c2 := e_copy(g, XMM0, r)
            mask = (1 as i64) << (XMM0 as i64)
        else:
            if t == T_I1:
                r2 := use_reg(g, a)
                z := e_rr(g, M_MOVZX_RR, 4, RAX, r2)
                g.mc.sz2[z] = 1
            else:
                move_into(g, RAX, a)
            end
            mask = 1 as i64
        end
    end
    ri := mi_new(g, M_RET, 0)
    g.mc.imm[ri] = mask
end

func isel_ins(g &: Ng, i: int, b: int):
    op := g.i_op[i]
    switch op:
        OP_NOP, OP_PHI: ret end
        OP_ALLOCA:
            v := g.i_res[i]
            t := g.i_x[i]
            mut n := g.i_d[i] as int
            if n < 1:
                n = 1
            end
            mut al := talign(g, t)
            if al < 8 and tsize(g, t) * n >= 16:
                al = 8
            end
            slot := new_slot(g, tsize(g, t) * n, al)
            if v >= 0:
                g.vak[v] = AK_ALLOCA
                g.var_[v] = slot
            end
            ret
        end
        OP_LOAD: isel_load(g, i) ret end
        OP_STORE: isel_store(g, i) ret end
        OP_ADDR: isel_addr(g, i) ret end
        OP_ADD, OP_SUB, OP_MUL, OP_AND, OP_OR, OP_XOR:
            if res_used(g, i):
                isel_bin(g, i)
            end
            ret
        end
        OP_SDIV, OP_UDIV, OP_SREM, OP_UREM:
            if res_used(g, i):
                isel_div(g, i)
            end
            ret
        end
        OP_SHL, OP_LSHR, OP_ASHR:
            if res_used(g, i):
                isel_shift(g, i)
            end
            ret
        end
        OP_FADD, OP_FSUB, OP_FMUL, OP_FDIV, OP_FREM:
            if res_used(g, i):
                isel_fbin(g, i)
            end
            ret
        end
        OP_FNEG:
            if res_used(g, i):
                t2 := g.i_ty[i]
                sz := fsz(t2)
                ra := use_reg(g, g.i_a[i])
                r := xmm(g)
                _c := e_copy(g, r, ra)
                mk := xmm(g)
                mut bits := 0 - 9223372036854775807 as i64
                bits = bits - (1 as i64)
                if sz == 4:
                    bits = 0x80000000 as i64
                end
                _l := e_rm(g, M_FLD, 8, mk, raw_const(g, bits, 8))
                _x := e_rr(g, M_XORPS, 8, r, mk)
                set_res(g, i, r)
            end
            ret
        end
        OP_ICMP:
            if res_used(g, i) and not is_fused(g, i):
                cc := emit_icmp(g, i)
                r2 := gpr(g)
                _s := e_setcc(g, cc, r2)
                set_res(g, i, r2)
            end
            ret
        end
        OP_FCMP:
            if res_used(g, i) and not is_fused(g, i):
                isel_fcmp_val(g, i)
            end
            ret
        end
        OP_SEXT, OP_ZEXT, OP_TRUNC, OP_PTRTOINT, OP_INTTOPTR, OP_BITCAST, OP_SITOFP, OP_UITOFP, OP_FPTOSI, OP_FPTOUI, OP_FPEXT, OP_FPTRUNC:
            if res_used(g, i):
                isel_cast(g, i)
            end
            ret
        end
        OP_SELECT:
            if res_used(g, i):
                isel_select(g, i)
            end
            ret
        end
        OP_CALL: isel_call(g, i) ret end
        OP_BR:
            phi_copies(g, b)
            _j := e_jmp(g, g.i_b[i])
            ret
        end
        OP_CBR: isel_cbr(g, i, b) ret end
        OP_RET: isel_ret(g, i) ret end
        OP_UNREACH:
            _u := mi_new(g, M_UD2, 0)
            ret
        end
        OP_INSV: isel_insv(g, i) ret end
        OP_EXTV: isel_extv(g, i) ret end
        OP_RMW: isel_rmw(g, i) ret end
        OP_CMPXCHG: isel_cmpxchg(g, i) ret end
        OP_FENCE:
            _f := mi_new(g, M_MFENCE, 0)
            ret
        end
        OP_COPY:
            set_res(g, i, use_reg(g, g.i_a[i]))
            ret
        end
    end
    fail(g, "native backend: cannot select instruction op " + str.FromInt(op as i64))
end

func is_fused(g &: Ng, i: int): bool:
    nx := g.i_next[i]
    if nx < 0 or g.i_op[nx] != OP_CBR:
        ret false
    end
    ret fused_cond(g, nx) == i
end

func isel_fcmp_val(g &: Ng, i: int):
    p := g.i_x[i]
    r := gpr(g)
    if p == FC_FALSE or p == FC_TRUE:
        _m := e_movi(g, r, p == FC_TRUE ? (1 as i64) : (0 as i64))
        set_res(g, i, r)
        ret
    end
    np := fcmp_setup(g, i)
    if np == FC_OEQ or np == FC_UNE:
        t := gpr(g)
        if np == FC_OEQ:
            _s := e_setcc(g, X_E, r)
            _s2 := e_setcc(g, X_NP, t)
            _a := e_alu(g, ALU_AND, 4, r, t)
        else:
            _s3 := e_setcc(g, X_NE, r)
            _s4 := e_setcc(g, X_P, t)
            _o := e_alu(g, ALU_OR, 4, r, t)
        end
    else:
        _s5 := e_setcc(g, fcmp_cc(np), r)
    end
    set_res(g, i, r)
end

func isel_function(g &: Ng):
    mc_reset(g)
    isel_init(g)
    g.retp = 0 - 1
    nb := g.b_first.len()
    repeat nb:
        g.mc.bstart.push(0 - 1)
        g.mc.bend.push(0 - 1)
    end
    each b in g.b_rpo:
        g.mc.lorder.push(b)
    end
    setup_phis(g)
    each b2 in g.mc.lorder:
        g.mc.bstart[b2] = g.mc.op.len()
        _l := e_label(g, b2)
        if b2 == 0:
            entry_args(g)
        end
        mut i := g.b_first[b2]
        until i >= 0 and g.i_op[i] == OP_PHI:
            r := g.i_res[i]
            if r >= 0:
                t := g.i_ty[i]
                if is_agg(g, t):
                    emit_copy(g, frame_mem(g.var_[r], 0 as i64), frame_mem(g.phit[i], 0 as i64), tsize(g, t))
                else:
                    _c := e_copy(g, g.vv[r], g.phit[i])
                end
            end
            i = g.i_next[i]
        end
        until i >= 0 and g.ok:
            isel_ins(g, i, b2)
            i = g.i_next[i]
        end
        g.mc.bend[b2] = g.mc.op.len()
    end
end
