package nativegen

import str

const NG_COPY_MAX := 256

const AK_NONE := 0
const AK_FRAME := 1
const AK_PTR := 2
const AK_ALLOCA := 3

k_sysv_gp := [7, 6, 2, 1, 8, 9]
k_win_gp := [1, 2, 8, 9]
k_a64_gp := [0, 1, 2, 3, 5, 6, 7, 8]

func vcls_ty(g &: Ng, t: int): int:
    if is_flt(g, t) or is_vec(g, t):
        ret 1
    end
    ret 0
end

func asz(g &: Ng, t: int): int:
    if int_bits(g, t) > 32:
        ret 8
    end
    ret 4
end

func msz(g &: Ng, t: int): int:
    if t == T_I1:
        ret 1
    end
    ret tsize(g, t)
end

func fsz(t: int): int:
    if t == T_F32 or t == T_V4F32 or t == T_V8F32:
        ret 4
    end
    ret 8
end

func new_reg_ty(g &: Ng, t: int): int:
    r := vnew(g, vcls_ty(g, t))
    if is_vec(g, t):
        g.mc.vwide[r] = true
        g.mc.vymm[r] = is_ymm(g, t)
    end
    ret r
end

func wide_reg(g &: Ng): int:
    r := xmm(g)
    g.mc.vwide[r] = true
    g.mc.vymm[r] = g.isy
    ret r
end

func xwide(g &: Ng): int:
    r := xmm(g)
    g.mc.vwide[r] = true
    ret r
end

func isel_init(g &: Ng):
    nv := g.v_kind.Len()
    g.vv.Clear()
    g.vsc.Clear()
    g.vak.Clear()
    g.var_.Clear()
    g.vao.Clear()
    g.v_mem.Clear()
    g.vown.Clear()
    g.v_cu.Clear()
    g.lfold.Clear()
    repeat nv:
        g.lfold.Push(0 - 1)
        g.v_cu.Push(0)
        g.vown.Push(false)
        g.vv.Push(0 - 1)
        g.vsc.Push(1)
        g.vak.Push(AK_NONE)
        g.var_.Push(0 - 1)
        g.vao.Push(0)
        g.v_mem.Push(0)
    end
    g.phit.Clear()
    g.mc.vsrc.Clear()
    g.skipi.Clear()
    g.sret_to.Clear()
    g.rmw_of.Clear()
    g.rmw_v.Clear()
    g.izero.Clear()
    repeat g.i_op.Len():
        g.izero.Push(false)
        g.rmw_v.Push(0 - 1)
        g.phit.Push(0 - 1)
        g.skipi.Push(false)
        g.rmw_of.Push(0 - 1)
        g.sret_to.Push(0 - 1)
    end
    count_uses(g)
    compute_escape(g)
    build_dom(g)
    each b in g.b_rpo:
        mut i := g.b_first[b]
        until i >= 0:
            op := g.i_op[i]
            if op == OP_SELECT and is_vec(g, g.i_ty[i]):
                vabs_mark(g, i)
            end
            if op == OP_CBR or (op == OP_SELECT and sel_scalar(g, g.i_ty[i])):
                cu := g.i_a[i]
                if cu >= 0:
                    g.v_cu[cu] = g.v_cu[cu] + 1
                end
            end
            if op == OP_LOAD:
                a := g.i_a[i]
                if a >= 0:
                    g.v_mem[a] = g.v_mem[a] + 1
                end
            else op == OP_STORE:
                p := g.i_b[i]
                if p >= 0 and p != g.i_a[i]:
                    g.v_mem[p] = g.v_mem[p] + 1
                end
            else op == OP_CALL and not g.off_memaddr:
                count_inline_mem(g, i)
            end
            i = g.i_next[i]
        end
    end
    if g.opt and not g.off_selinc and (g.arch == NG_ARCH_X64 or g.arch == NG_ARCH_X86):
        each b2 in g.b_rpo:
            mut i2 := g.b_first[b2]
            until i2 >= 0:
                if g.i_op[i2] == OP_SELECT and sel_scalar(g, g.i_ty[i2]):
                    sel_inc_plan(g, i2)
                end
                i2 = g.i_next[i2]
            end
        end
    end
end

func count_inline_mem(g &: Ng, i: int):
    callee := g.i_a[i]
    if callee < 0 or g.v_kind[callee] != VK_GLB or g.v_i[callee] != (0 as i64) or g.i_pcount[i] < 3:
        ret
    end
    sy := g.v_def[callee]
    ln := call_arg(g, i, 2)
    if g.v_kind[ln] != VK_INT or g.v_i[ln] > (256 as i64):
        ret
    end
    d0 := call_arg(g, i, 0)
    s0 := call_arg(g, i, 1)
    if sy == g.sym_i_memset and g.v_kind[s0] == VK_INT and d0 >= 0:
        g.v_mem[d0] = g.v_mem[d0] + 1
    else sy == g.sym_i_memcpy and d0 >= 0 and s0 >= 0 and d0 != s0:
        g.v_mem[d0] = g.v_mem[d0] + 1
        g.v_mem[s0] = g.v_mem[s0] + 1
    end
end

func ins_ymm(g &: Ng, i: int): bool:
    if is_ymm(g, g.i_ty[i]):
        ret true
    end
    ret g.i_op[i] == OP_STORE and g.i_a[i] >= 0 and is_ymm(g, g.v_ty[g.i_a[i]])
end

func isel_ins(g &: Ng, i: int, b: int):
    g.isy = ins_ymm(g, i)
    isel_ins1(g, i, b)
    g.isy = false
end

func isel_ins1(g &: Ng, i: int, b: int):
    op := g.i_op[i]
    if is_vec(g, g.i_ty[i]) and not g.skipi[i] and isel_vec_ins(g, i):
        ret
    end
    if g.skipi[i]:
        if op == OP_RET:
            _c := e_copy(g, RAX, g.retp)
            ri := mi_new(g, M_RET, 0)
            g.mc.imm[ri] = 1 as i64
        end
        ret
    end
    switch op:
        OP_NOP, OP_PHI: ret end
        OP_ALLOCA:
            v := g.i_res[i]
            t := g.i_x[i]
            mut n := g.i_d[i] as int
            if n < 1:
                n = 1
            end
            mut al := talign(g, t)
            if al < 8 and tsize(g, t) * n >= 16:
                al = 8
            end
            slot := new_slot(g, tsize(g, t) * n, al)
            g.mc.fs_temp[slot] = v >= 0 and not g.v_esc[v]
            if v >= 0:
                g.vak[v] = AK_ALLOCA
                g.var_[v] = slot
            end
            ret
        end
        OP_LOAD: isel_load(g, i) ret end
        OP_STORE: isel_store(g, i) ret end
        OP_ADDR: isel_addr(g, i) ret end
        OP_ADD, OP_SUB, OP_MUL, OP_AND, OP_OR, OP_XOR:
            if (op == OP_SUB or op == OP_AND) and rot_cnt_user(g, i):
                g.skipi[i] = true
                ret
            end
            if op == OP_AND and and_test_ok(g, i):
                g.skipi[i] = true
                ret
            end
            if op == OP_MUL and mul_add_user(g, i):
                g.skipi[i] = true
                ret
            end
            if res_used(g, i):
                isel_bin(g, i)
            end
            ret
        end
        OP_SDIV, OP_UDIV, OP_SREM, OP_UREM:
            if res_used(g, i):
                isel_div(g, i)
            end
            ret
        end
        OP_SHL, OP_LSHR, OP_ASHR:
            if op == OP_SHL and mul_add_user(g, i):
                g.skipi[i] = true
                ret
            end
            if (op == OP_SHL or op == OP_LSHR) and rot_user(g, i):
                g.skipi[i] = true
                ret
            end
            if res_used(g, i):
                isel_shift(g, i)
            end
            ret
        end
        OP_FADD, OP_FSUB, OP_FMUL, OP_FDIV, OP_FREM:
            if res_used(g, i):
                isel_fbin(g, i)
            end
            ret
        end
        OP_FNEG:
            if res_used(g, i):
                t2 := g.i_ty[i]
                sz := fsz(t2)
                ra := use_reg(g, g.i_a[i])
                r := xmm(g)
                _c := e_copy(g, r, ra)
                mk := xmm(g)
                mut bits := 0 - 9223372036854775807 as i64
                bits--
                if sz == 4:
                    bits = 0x80000000 as i64
                end
                _l := e_rm(g, M_FLD, 8, mk, raw_const(g, bits, 8))
                _x := e_rr(g, M_XORPS, 8, r, mk)
                set_res(g, i, r)
            end
            ret
        end
        OP_ICMP, OP_CMP64:
            if res_used(g, i) and not is_fused(g, i):
                cc := emit_icmp(g, i)
                r2 := gpr(g)
                _s := e_setcc(g, cc, r2)
                set_res(g, i, r2)
            end
            ret
        end
        OP_FCMP:
            if res_used(g, i) and not is_fused(g, i):
                isel_fcmp_val(g, i)
            end
            ret
        end
        OP_SEXT, OP_ZEXT, OP_TRUNC, OP_PTRTOINT, OP_INTTOPTR, OP_BITCAST, OP_SITOFP, OP_UITOFP, OP_FPTOSI, OP_FPTOUI, OP_FPEXT, OP_FPTRUNC:
            if res_used(g, i):
                isel_cast(g, i)
            end
            ret
        end
        OP_SELECT:
            if res_used(g, i):
                isel_select(g, i)
            end
            ret
        end
        OP_CALL: isel_call(g, i) ret end
        OP_BR:
            split_copies(g, b)
            phi_copies(g, b)
            _j := e_jmp(g, g.i_b[i])
            ret
        end
        OP_CBR: isel_cbr(g, i, b) ret end
        OP_RET: isel_ret(g, i) ret end
        OP_ADC64:
            if res_used(g, i):
                isel_adc64(g, i)
            end
            ret
        end
        OP_DIV6432:
            if res_used(g, i):
                isel_div6432(g, i)
            end
            ret
        end
        OP_VREDH:
            if res_used(g, i):
                isel_vredh(g, i)
            end
            ret
        end
        OP_I64TOF:
            if res_used(g, i):
                fl := use_reg(g, g.i_a[i])
                fh := use_reg(g, g.i_b[i])
                fs := new_slot(g, 8, 8)
                _f1 := e_mr(g, M_ST, 4, frame_mem(fs, 0 as i64), fl)
                _f2 := e_mr(g, M_ST, 4, frame_mem(fs, 4 as i64), fh)
                fi := mi_new(g, M_X87, 8)
                set_mem(g, fi, frame_mem(fs, 0 as i64))
                g.mc.cc[fi] = 2
                set_res(g, i, x87_to_xmm(g, g.i_ty[i] == T_F64 ? 8 : 4))
            end
            ret
        end
        OP_MULHU:
            mra := use_reg(g, g.i_a[i])
            mrb := use_reg(g, g.i_b[i])
            _mc := e_copy(g, RAX, mra)
            mh := e_rr(g, M_MULHI, 8, 0 - 1, mrb)
            g.mc.cc[mh] = g.i_x[i] == 1 ? 1 : 0
            mres := gpr(g)
            _mr := e_copy(g, mres, RDX)
            set_res(g, i, mres)
            ret
        end
        OP_RETHI:
            rh := gpr(g)
            xr := g.i_x[i]
            _ch := e_copy(g, rh, xr == 1 ? RDX : (xr == 2 ? RBX : hi_reg(g)))
            set_res(g, i, rh)
            ret
        end
        OP_UNREACH:
            _u := mi_new(g, M_UD2, 0)
            ret
        end
        OP_INSV: isel_insv(g, i) ret end
        OP_EXTV: isel_extv(g, i) ret end
        OP_RMW: isel_rmw(g, i) ret end
        OP_CMPXCHG: isel_cmpxchg(g, i) ret end
        OP_FENCE:
            _f := mi_new(g, M_MFENCE, 0)
            ret
        end
        OP_COPY:
            set_res(g, i, use_reg(g, g.i_a[i]))
            ret
        end
        OP_VREDADD:
            if res_used(g, i):
                isel_vredadd(g, i)
            end
            ret
        end
        OP_VREDMM:
            if res_used(g, i):
                isel_vredmm(g, i)
            end
            ret
        end
        OP_VLANES:
            vt := g.i_ty[i]
            q := g.t_elem[vt] == T_I64
            mut m := q ? vec_const(g, 0 as i64, 1 as i64) : vec_const(
                g, (1 as i64) << (32 as i64), (3 as i64) << (32 as i64) | (2 as i64)
            )
            if g.isy:
                m = q ? vec_const32(g, 0 as i64, 1 as i64, 2 as i64, 3 as i64) : vec_const32(
                    g,
                    (1 as i64) << (32 as i64),
                    (3 as i64) << (32 as i64) | (2 as i64),
                    (5 as i64) << (32 as i64) | (4 as i64),
                    (7 as i64) << (32 as i64) | (6 as i64)
                )
            end
            rl := wide_reg(g)
            _vl := e_rm(g, M_VLD, 16, rl, m)
            set_res(g, i, rl)
            ret
        end
        OP_VREV:
            rv := wide_reg(g)
            sv := e_rr(g, M_PSHUFD, 16, rv, use_reg(g, g.i_a[i]))
            g.mc.imm[sv] = (g.i_x[i] != 0 ? g.i_x[i] : (tsize(
                g, g.t_elem[g.i_ty[i]]
            ) == 8 ? 0x4E : 0x1B)) as i64
            set_res(g, i, rv)
            ret
        end
        OP_VSADB:
            rs := vcopy(g, g.i_a[i])
            zs := wide_reg(g)
            _zz := e_rr(g, M_XORPS, 16, zs, zs)
            vop(g, 0xF6, rs, zs)
            set_res(g, i, rs)
            ret
        end
        OP_VBCAST:
            src := use_reg(g, g.i_a[i])
            if g.isy:
                set_res(g, i, ybcast(g, src, g.i_ty[i] == T_V8F32 ? VUN_BCSS : VUN_BCSD))
                ret
            end
            rb := wide_reg(g)
            _cb := e_copy(g, rb, src)
            if g.i_ty[i] == T_V4F32:
                sh := e_rr(g, M_SHUFPS, 4, rb, rb)
                g.mc.imm[sh] = 0 as i64
            else:
                _u := e_rr(g, M_UNPCKLPD, 8, rb, rb)
            end
            set_res(g, i, rb)
            ret
        end
    end
    fail(g, "native backend: cannot select instruction op " + str.FromInt(op as i64))
end

func is_fused(g &: Ng, i: int): bool:
    if g.i_res[i] >= 0 and cond_only(g, g.i_res[i]):
        ret true
    end
    u := cond_user(g, i)
    if u < 0:
        ret false
    end
    ret fused_cond(g, u) == i
end

func isel_fcmp_val(g &: Ng, i: int):
    p := g.i_x[i]
    r := gpr(g)
    if p == FC_FALSE or p == FC_TRUE:
        _m := e_movi(g, r, p == FC_TRUE ? (1 as i64) : (0 as i64))
        set_res(g, i, r)
        ret
    end
    np := fcmp_setup(g, i)
    if np == FC_OEQ or np == FC_UNE:
        t := gpr(g)
        if np == FC_OEQ:
            _s := e_setcc(g, X_E, r)
            _s2 := e_setcc(g, X_NP, t)
            _a := e_alu(g, ALU_AND, 4, r, t)
        else:
            _s3 := e_setcc(g, X_NE, r)
            _s4 := e_setcc(g, X_P, t)
            _o := e_alu(g, ALU_OR, 4, r, t)
        end
    else:
        _s5 := e_setcc(g, fcmp_cc(np), r)
    end
    set_res(g, i, r)
end

func isel_function(g &: Ng):
    mc_reset(g)
    isel_init(g)
    build_dom(g)
    g.retp = 0 - 1
    nb := g.b_first.Len()
    repeat nb:
        g.mc.bstart.Push(0 - 1)
        g.mc.bend.Push(0 - 1)
    end
    each b in g.b_rpo:
        g.mc.lorder.Push(b)
    end
    setup_phis(g)
    g.cur_b = 0 - 1
    g.dq_a.Clear()
    g.dq_b.Clear()
    g.dq_s.Clear()
    g.dq_q.Clear()
    g.dq_r.Clear()
    g.dq_blk.Clear()
    g.sp_val.Clear()
    g.lp_pre.Clear()
    g.b_lp.Clear()
    if g.opt and not g.off_split:
        split_plan(g)
    end
    if g.fv_val.Len() > 0:
        dv_isel_begin(g)
    end
    g.mc_loc = 0 - 1
    each b2 in g.mc.lorder:
        g.cur_b = b2
        g.mc.bstart[b2] = g.mc.op.Len()
        if g.fv_val.Len() > 0:
            dv_isel_block(g, b2)
        end
        _l := e_label(g, b2)
        if b2 == 0:
            entry_args(g)
        end
        mut i := g.b_first[b2]
        until i >= 0 and g.i_op[i] == OP_PHI:
            r := g.i_res[i]
            if r >= 0:
                t := g.i_ty[i]
                if is_agg(g, t):
                    emit_copy(
                        g,
                        frame_mem(g.var_[r], 0 as i64),
                        frame_mem(g.phit[i], 0 as i64),
                        tsize(g, t)
                    )
                end
            end
            i = g.i_next[i]
        end
        until i >= 0 and g.ok:
            g.mc_loc = g.i_dbg[i]
            isel_ins(g, i, b2)
            if g.fv_val.Len() > 0:
                dv_isel_after(g, i)
            end
            i = g.i_next[i]
        end
        g.mc.bend[b2] = g.mc.op.Len()
    end
end
