package nativegen

func isel_bin(g &: Ng, i: int):
    op := g.i_op[i]
    t := g.i_ty[i]
    if is_vec(g, t):
        isel_vint_add(g, i)
        ret
    end
    mut a := g.i_a[i]
    mut b := g.i_b[i]
    sz := asz(g, t)
    mut rx := 0 - 1
    mut rc := 0
    mut rcv := 0 - 1
    mut rleft := false
    if not g.off_rot and rot_parts(
        g, i, rx, rc, rcv, rleft
    ) and g.skipi[g.v_def[g.i_a[i]]] and g.skipi[g.v_def[g.i_b[i]]]:
        rr := gpr(g)
        move_into(g, rr, rx)
        if rcv < 0:
            e_shift(g, SH_ROR, sz, rr, rc)
        else:
            _rcc := e_copy(g, RCX, use_reg(g, rcv))
            rs := e_rr(g, M_SHIFT_RC, sz, rr, 0 - 1)
            g.mc.cc[rs] = rleft ? 0 : SH_ROR
        end
        set_res(g, i, rr)
        ret
    end
    comm := op == OP_ADD or op == OP_MUL or op == OP_AND or op == OP_OR or op == OP_XOR
    if comm and g.v_kind[a] == VK_INT and g.v_kind[b] != VK_INT:
        tmp := a
        a = b
        b = tmp
    end
    if comm and lf_mem(g, a) >= 0 and lf_mem(g, b) < 0:
        tmp2 := a
        a = b
        b = tmp2
    end
    lfb := lf_mem(g, b)
    a_deferred := g.v_kind[a] == VK_INS and g.skipi[g.v_def[a]]
    if lfb >= 0 and not a_deferred and
        (op == OP_ADD or op == OP_SUB or op == OP_AND or op == OP_OR or op == OP_XOR):
        mut subf := ALU_ADD
        if op == OP_SUB: subf = ALU_SUB end
        if op == OP_AND: subf = ALU_AND end
        if op == OP_OR: subf = ALU_OR end
        if op == OP_XOR: subf = ALU_XOR end
        rf := gpr(g)
        move_into(g, rf, a)
        mf := e_rm(g, M_ALU_RM, asz(g, t), rf, mem_of(g, g.i_a[lfb], 0 as i64))
        g.mc.cc[mf] = subf
        set_res(g, i, rf)
        ret
    end
    bimm := g.v_kind[b] == VK_INT and is_imm32(g.v_i[b])
    if op == OP_ADD and bimm and g.v_kind[a] == VK_INS and g.skipi[g.v_def[a]] and lea_mul_k(
        g, g.v_def[a]
    ) > 0:
        md := g.v_def[a]
        x := use_reg(g, g.i_a[md])
        rl := gpr(g)
        _l := e_rm(g, M_LEA, 8, rl, Mem {
            k = MK_BI,
            b = x,
            i = x,
            s = lea_mul_k(g, md) - 1,
            d = g.v_i[b]
        })
        set_res(g, i, rl)
        ret
    end
    if op == OP_ADD and not bimm:
        mut mo := 0 - 1
        mut other := 0 - 1
        if g.v_kind[a] == VK_INS and g.skipi[g.v_def[a]] and lea_mul_k(g, g.v_def[a]) > 0:
            mo = g.v_def[a]
            other = b
        else g.v_kind[b] == VK_INS and g.skipi[g.v_def[b]] and lea_mul_k(g, g.v_def[b]) > 0:
            mo = g.v_def[b]
            other = a
        end
        if mo >= 0:
            mut c := 0
            mut sc := 0
            lea_split(lea_mul_k(g, mo), c, sc)
            x2 := use_reg(g, g.i_a[mo])
            mut tr := x2
            if c > 1:
                tr = gpr(g)
                _lt := e_rm(g, M_LEA, 8, tr, Mem {
                    k = MK_BI,
                    b = x2,
                    i = x2,
                    s = c - 1,
                    d = 0 as i64
                })
            end
            ro := use_reg(g, other)
            rl2 := gpr(g)
            _l2 := e_rm(g, M_LEA, 8, rl2, Mem {
                k = MK_BI,
                b = ro,
                i = tr,
                s = sc,
                d = 0 as i64
            })
            set_res(g, i, rl2)
            ret
        end
    end
    if op == OP_MUL:
        r := gpr(g)
        if bimm and mul_small(g, r, use_reg(g, a), g.v_i[b]):
            set_res(g, i, r)
            ret
        end
        if bimm and g.v_i[b] == (2 as i64):
            ra2 := use_reg(g, a)
            _l2 := e_rm(g, M_LEA, 8, r, Mem {
                k = MK_BI,
                b = ra2,
                i = ra2,
                s = 1,
                d = 0 as i64
            })
            set_res(g, i, r)
            ret
        end
        if bimm:
            ra := use_reg(g, a)
            mi := e_rr(g, M_IMUL_RRI, sz, r, ra)
            g.mc.imm[mi] = g.v_i[b]
        else:
            mut ma := a
            mut mb := b
            if not g.off_mtie and dies_here(g, b, i) and not dies_here(g, a, i) and
                g.i_op[g.v_def[b]] == OP_LOAD:
                ma = b
                mb = a
            end
            move_into(g, r, ma)
            rb := ma == mb and not g.off_sqself ? r : use_reg(g, mb)
            _m := e_rr(g, M_IMUL_RR, sz, r, rb)
        end
        set_res(g, i, r)
        ret
    end
    if op == OP_SUB and g.v_kind[a] == VK_INT and g.v_i[a] == (0 as i64):
        r2 := gpr(g)
        move_into(g, r2, b)
        _n := e_rr(g, M_UNARY, sz, r2, 0 - 1)
        g.mc.cc[g.mc.op.Len() - 1] = UN_NEG
        set_res(g, i, r2)
        ret
    end
    if op == OP_ADD or op == OP_SUB:
        if bimm and not (op == OP_SUB and g.v_i[b] == (0 - 2147483647 as i64) - (1 as i64)):
            ra0 := use_reg(g, a)
            rl := gpr(g)
            mut dd := g.v_i[b]
            if op == OP_SUB:
                dd = 0 - dd
            end
            _l := e_rm(g, M_LEA, 8, rl, mem_bi(ra0, dd))
            set_res(g, i, rl)
            ret
        end
        if op == OP_ADD and g.v_kind[b] != VK_INT:
            ra1 := use_reg(g, a)
            rb1 := use_reg(g, b)
            rl2 := gpr(g)
            _l2 := e_rm(g, M_LEA, 8, rl2, Mem {
                k = MK_BI,
                b = ra1,
                i = rb1,
                s = 1,
                d = 0 as i64
            })
            set_res(g, i, rl2)
            ret
        end
    end
    if op == OP_AND and sz == 8 and g.v_kind[b] == VK_INT and g.v_i[b] == (4294967295 as i64):
        rz := gpr(g)
        _z := e_rr(g, M_MOV_RR, 4, rz, use_reg(g, a))
        set_res(g, i, rz)
        ret
    end
    mut sub := ALU_ADD
    if op == OP_SUB: sub = ALU_SUB end
    if op == OP_AND: sub = ALU_AND end
    if op == OP_OR: sub = ALU_OR end
    if op == OP_XOR: sub = ALU_XOR end
    r3 := gpr(g)
    move_into(g, r3, a)
    if bimm:
        _x := e_alui(g, sub, sz, r3, g.v_i[b])
    else:
        rb2 := use_reg(g, b)
        _y := e_alu(g, sub, sz, r3, rb2)
    end
    set_res(g, i, r3)
end

func ext_to32(g &: Ng, v: int, t: int, sign: bool): int:
    r := use_reg(g, v)
    bits := int_bits(g, t)
    if bits >= 32:
        ret r
    end
    r2 := gpr(g)
    mut op := M_MOVZX_RR
    if sign and bits > 1:
        op = M_MOVSX_RR
    end
    i := e_rr(g, op, 4, r2, r)
    g.mc.sz2[i] = bits <= 8 ? 1 : 2
    if bits == 1 and sign:
        n := e_rr(g, M_UNARY, 4, r2, 0 - 1)
        g.mc.cc[n] = UN_NEG
    end
    ret r2
end

func e_shift(g &: Ng, sub: int, sz: int, r: int, n: int):
    if n == 0:
        ret
    end
    s := e_ri(g, M_SHIFT_RI, sz, r, n as i64)
    g.mc.cc[s] = sub
end

func rot_unmask(g &: Ng, s: int, bits: int): int:
    if s < 0 or g.v_kind[s] != VK_INS:
        ret s
    end
    d := g.v_def[s]
    if g.i_op[d] == OP_AND and is_cint(g, g.i_b[d]) and g.v_i[g.i_b[d]] == ((bits - 1) as i64):
        ret g.i_a[d]
    end
    ret s
end

func rot_sub_of(g &: Ng, s0: int, bits: int): int:
    s := rot_unmask(g, s0, bits)
    if s < 0 or g.v_kind[s] != VK_INS:
        ret 0 - 1
    end
    d := g.v_def[s]
    if g.i_op[d] == OP_SUB and is_cint(g, g.i_a[d]) and g.v_i[g.i_a[d]] == (bits as i64):
        ret g.i_b[d]
    end
    ret 0 - 1
end

func rot_parts(g &: Ng, i: int, x &: int, c &: int, cv &: int, left &: bool): bool:
    op := g.i_op[i]
    if op != OP_OR and op != OP_XOR and op != OP_ADD:
        ret false
    end
    bits := int_bits(g, g.i_ty[i])
    if bits != 32 and bits != 64:
        ret false
    end
    repeat 2 in k:
        p := k == 0 ? g.i_a[i] : g.i_b[i]
        q := k == 0 ? g.i_b[i] : g.i_a[i]
        if p >= 0 and q >= 0 and g.v_kind[p] == VK_INS and g.v_kind[q] == VK_INS and
            g.v_uses[p] == 1 and g.v_uses[q] == 1:
            dp := g.v_def[p]
            dq := g.v_def[q]
            if g.i_op[dp] == OP_LSHR and g.i_op[dq] == OP_SHL and g.i_a[dp] == g.i_a[dq]:
                s1 := g.i_b[dp]
                s2 := g.i_b[dq]
                if is_cint(g, s1) and is_cint(g, s2):
                    c1 := g.v_i[s1]
                    c2 := g.v_i[s2]
                    if c1 > (0 as i64) and c2 > (0 as i64) and c1 + c2 == (bits as i64):
                        x = g.i_a[dp]
                        c = c1 as int
                        cv = 0 - 1
                        ret true
                    end
                else op == OP_OR and rot_sub_of(g, s2, bits) >= 0 and
                    rot_sub_of(g, s2, bits) == rot_unmask(g, s1, bits):
                    x = g.i_a[dp]
                    c = 0 - 1
                    cv = rot_unmask(g, s1, bits)
                    left = false
                    ret true
                else op == OP_OR and rot_sub_of(g, s1, bits) >= 0 and
                    rot_sub_of(g, s1, bits) == rot_unmask(g, s2, bits):
                    x = g.i_a[dp]
                    c = 0 - 1
                    cv = rot_unmask(g, s2, bits)
                    left = true
                    ret true
                end
            end
        end
    end
    ret false
end

func rot_user(g &: Ng, i: int): bool:
    r := g.i_res[i]
    if g.off_rot or r < 0 or g.v_uses[r] != 1:
        ret false
    end
    mut j := g.i_next[i]
    repeat 16:
        if j < 0:
            ret false
        end
        if uses_val(g, j, r):
            mut x := 0 - 1
            mut c := 0
            mut cv := 0 - 1
            mut left := false
            ret rot_parts(g, j, x, c, cv, left)
        end
        j = g.i_next[j]
    end
    ret false
end

func rot_cnt_user(g &: Ng, i: int): bool:
    r := g.i_res[i]
    if g.off_rot or r < 0 or g.v_uses[r] != 1:
        ret false
    end
    op := g.i_op[i]
    if not (op == OP_SUB and is_cint(g, g.i_a[i])) and not (op == OP_AND and is_cint(g, g.i_b[i])):
        ret false
    end
    mut j := g.i_next[i]
    repeat 16:
        if j < 0:
            ret false
        end
        if uses_val(g, j, r):
            jop := g.i_op[j]
            if (jop == OP_SHL or jop == OP_LSHR) and g.i_b[j] == r:
                ret rot_user(g, j)
            end
            if jop == OP_AND and g.i_a[j] == r:
                ret rot_cnt_user(g, j)
            end
            ret false
        end
        j = g.i_next[j]
    end
    ret false
end

func isel_shift(g &: Ng, i: int):
    op := g.i_op[i]
    t := g.i_ty[i]
    sz := asz(g, t)
    bits := int_bits(g, t)
    mut sub := SH_SHL
    mut ra := 0 - 1
    if op == OP_LSHR:
        sub = SH_SHR
        ra = ext_to32(g, g.i_a[i], t, false)
    else op == OP_ASHR:
        sub = SH_SAR
        ra = ext_to32(g, g.i_a[i], t, true)
    else:
        ra = use_reg(g, g.i_a[i])
    end
    r := gpr(g)
    _c := e_copy(g, r, ra)
    b := g.i_b[i]
    if g.v_kind[b] == VK_INT:
        n := (g.v_i[b] as int) & (bits - 1)
        if n != 0:
            s := e_ri(g, M_SHIFT_RI, sz, r, n as i64)
            g.mc.cc[s] = sub
        end
    else:
        rb := use_reg(g, b)
        _c2 := e_copy(g, RCX, rb)
        s2 := e_rr(g, M_SHIFT_RC, sz, r, 0 - 1)
        g.mc.cc[s2] = sub
    end
    set_res(g, i, r)
end

func isel_fbin(g &: Ng, i: int):
    op := g.i_op[i]
    t := g.i_ty[i]
    sz := fsz(t)
    if op == OP_FREM:
        mut args := Vector {} as Vector<int>
        args.Push(use_reg(g, g.i_a[i]))
        args.Push(use_reg(g, g.i_b[i]))
        mut nm := "fmod"
        if sz == 4:
            nm = "fmodf"
        end
        rr := call_lib(g, sym_named(g, nm), args, 1)
        g.sy_kind[sym_named(g, nm)] = SY_FUNC
        args.Free()
        set_res(g, i, rr)
        ret
    end
    mut sub := FO_ADD
    if op == OP_FSUB: sub = FO_SUB end
    if op == OP_FMUL: sub = FO_MUL end
    if op == OP_FDIV: sub = FO_DIV end
    if is_vec(g, t):
        rva := use_reg(g, g.i_a[i])
        rv := wide_reg(g)
        _cv := e_copy(g, rv, rva)
        rvb := use_reg(g, g.i_b[i])
        fv := e_rr(g, M_VOP_RR, sz, rv, rvb)
        g.mc.cc[fv] = sub
        set_res(g, i, rv)
        ret
    end
    mut a := g.i_a[i]
    mut b := g.i_b[i]
    if (op == OP_FADD or op == OP_FMUL) and g.v_kind[a] == VK_FLT and g.v_kind[b] != VK_FLT:
        tmp := a
        a = b
        b = tmp
    else (op == OP_FADD or op == OP_FMUL) and a != b and g.v_kind[a] == VK_INS and
        g.v_kind[b] == VK_INS and g.v_uses[b] == 1 and g.i_op[g.v_def[a]] != OP_PHI and
        (g.v_uses[a] > 1 or g.i_blk[g.v_def[a]] != g.i_blk[i]) and
        g.i_blk[g.v_def[b]] == g.i_blk[i]:
        tmp2 := a
        a = b
        b = tmp2
    end
    ra := use_reg(g, a)
    r := xmm(g)
    _c := e_copy(g, r, ra)
    if g.v_kind[b] == VK_FLT and g.v_i[b] != (0 as i64):
        f2 := e_rm(g, M_FOP_RM, sz, r, fp_const(g, g.v_i[b], sz))
        g.mc.cc[f2] = sub
        set_res(g, i, r)
        ret
    end
    mut rb := r
    if b != a:
        rb = use_reg(g, b)
    end
    f := e_rr(g, M_FOP_RR, sz, r, rb)
    g.mc.cc[f] = sub
    set_res(g, i, r)
end
