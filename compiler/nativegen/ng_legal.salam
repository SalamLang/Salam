pub struct Lg:
    pub lo: Vector<int> = Vector {}
    pub hi: Vector<int> = Vector {}
    pub ph_old: Vector<int> = Vector {}
    pub ph_lo: Vector<int> = Vector {}
    pub ph_hi: Vector<int> = Vector {}
    pub dm_a: Vector<int> = Vector {}
    pub dm_b: Vector<int> = Vector {}
    pub dm_sg: Vector<bool> = Vector {}
    pub dm_blk: Vector<int> = Vector {}
    pub dm_ql: Vector<int> = Vector {}
    pub dm_qh: Vector<int> = Vector {}
    pub dm_rl: Vector<int> = Vector {}
    pub dm_rh: Vector<int> = Vector {}
    pub slot: int = 0 - 1
end

func legalize64(g &: Ng):
    if dump_wanted(g):
        dump_ir(g, "prelegal")
    end
    mut l := Lg {}
    lg_grow(g, l)
    build_dom(g)
    lg_split_args(g, l)
    mut order := Vector {} as Vector<int>
    each b in g.b_rpo:
        mut i := g.b_first[b]
        until i >= 0:
            order.Push(i)
            i = g.i_next[i]
        end
    end
    repl_grow(g)
    each i2 in order:
        if g.i_op[i2] == OP_NOP:
            continue
        end
        remap_ins(g, i2)
        lg_one(g, l, i2)
        repl_grow(g)
        if not g.ok:
            break
        end
    end
    repeat l.ph_old.Len() in k:
        old := l.ph_old[k]
        ps := g.i_ps[old]
        n := g.i_pcount[old]
        p1 := l.ph_lo[k]
        p2 := l.ph_hi[k]
        g.i_ps[p1] = g.pool.Len()
        repeat n in q:
            mut lo := 0
            mut hi := 0
            lg_pair(g, l, resolve(g, g.pool[ps + 2 * q]), lo, hi)
            g.pool.Push(lo)
            g.pool.Push(g.pool[ps + 2 * q + 1])
        end
        g.i_ps[p2] = g.pool.Len()
        repeat n in q2:
            mut lo2 := 0
            mut hi2 := 0
            lg_pair(g, l, resolve(g, g.pool[ps + 2 * q2]), lo2, hi2)
            g.pool.Push(hi2)
            g.pool.Push(g.pool[ps + 2 * q2 + 1])
        end
        ins_unlink(g, old)
    end
    remap_all(g)
    order.Free()
    l.lo.Free()
    l.hi.Free()
    l.ph_old.Free()
    l.ph_lo.Free()
    l.ph_hi.Free()
    l.dm_a.Free()
    l.dm_b.Free()
    l.dm_sg.Free()
    l.dm_blk.Free()
    l.dm_ql.Free()
    l.dm_qh.Free()
    l.dm_rl.Free()
    l.dm_rh.Free()
end
