    0x53, 0x56, 0x8B, 0x74, 0x24, 0x0C, 0x8B, 0x44, 0x24, 0x10, 0x8B, 0x54, 0x24, 0x14, 0x8B, 0x5C,
    0x24, 0x18, 0x8B, 0x4C, 0x24, 0x1C, 0xF0, 0x0F, 0xC7, 0x0E, 0x5E, 0x5B, 0xC3
