package nativegen

import str
import mem

extern:
    func strtod(s: str, endp: void*): f64
end

const KW_DEFINE := 0
const KW_DECLARE := 1
const KW_TYPE := 2
const KW_GLOBAL := 3
const KW_CONSTANT := 4
const KW_INTERNAL := 5
const KW_PRIVATE := 6
const KW_ZEROINIT := 7
const KW_NULL := 8
const KW_UNDEF := 9
const KW_POISON := 10
const KW_TRUE := 11
const KW_FALSE := 12
const KW_TO := 13
const KW_LABEL := 14
const KW_X := 15
const KW_INBOUNDS := 16
const KW_PTR := 17
const KW_VOID := 18
const KW_FLOAT := 19
const KW_DOUBLE := 20
const KW_ALLOCA := 21
const KW_LOAD := 22
const KW_STORE := 23
const KW_GEP := 24
const KW_ADD := 25
const KW_SUB := 26
const KW_MUL := 27
const KW_SDIV := 28
const KW_UDIV := 29
const KW_SREM := 30
const KW_UREM := 31
const KW_AND := 32
const KW_OR := 33
const KW_XOR := 34
const KW_SHL := 35
const KW_LSHR := 36
const KW_ASHR := 37
const KW_FADD := 38
const KW_FSUB := 39
const KW_FMUL := 40
const KW_FDIV := 41
const KW_FREM := 42
const KW_FNEG := 43
const KW_ICMP := 44
const KW_FCMP := 45
const KW_SEXT := 46
const KW_ZEXT := 47
const KW_TRUNC := 48
const KW_PTRTOINT := 49
const KW_INTTOPTR := 50
const KW_BITCAST := 51
const KW_SITOFP := 52
const KW_UITOFP := 53
const KW_FPTOSI := 54
const KW_FPTOUI := 55
const KW_FPEXT := 56
const KW_FPTRUNC := 57
const KW_SELECT := 58
const KW_PHI := 59
const KW_CALL := 60
const KW_BR := 61
const KW_RET := 62
const KW_UNREACH := 63
const KW_INSV := 64
const KW_EXTV := 65
const KW_RMW := 66
const KW_CMPXCHG := 67
const KW_FENCE := 68
const KW_TAIL := 69
const KW_ATOMIC := 70
const KW_VOLATILE := 71
const KW_BYVAL := 72
const KW_SRET := 73
const KW_C := 74
const KW_EQ := 75
const KW_NE := 76
const KW_SLT := 77
const KW_SLE := 78
const KW_SGT := 79
const KW_SGE := 80
const KW_ULT := 81
const KW_ULE := 82
const KW_UGT := 83
const KW_UGE := 84
const KW_OEQ := 85
const KW_OGT := 86
const KW_OGE := 87
const KW_OLT := 88
const KW_OLE := 89
const KW_ONE := 90
const KW_ORD := 91
const KW_UEQ := 92
const KW_UNE := 93
const KW_UNO := 94
const KW_XCHG := 95
const KW_NORETURN := 96
const KW_TARGET := 97
const KW_SOURCE := 98
const KW_ATTRIBUTES := 99
const KW_APPENDING := 100
const KW_EXTERNAL := 101
const KW_MUSTTAIL := 102
const KW_NOTAIL := 103
const KW_WEAK := 104
const KW_SIGNEXT := 105
const KW_ZEROEXT := 106
const KW_NOINLINE := 107
const KW_ALWAYSINLINE := 108
const KW_NONNULL := 109

k_ng_kw := [
    "define", "declare", "type", "global", "constant", "internal", "private", "zeroinitializer", "null", "undef", "poison", "true", "false", "to", "label", "x", "inbounds", "ptr", "void", "float", "double", "alloca", "load", "store", "getelementptr", "add", "sub", "mul", "sdiv", "udiv", "srem", "urem", "and", "or", "xor", "shl", "lshr", "ashr", "fadd", "fsub", "fmul", "fdiv", "frem", "fneg", "icmp", "fcmp", "sext", "zext", "trunc", "ptrtoint", "inttoptr", "bitcast", "sitofp", "uitofp", "fptosi", "fptoui", "fpext", "fptrunc", "select", "phi", "call", "br", "ret", "unreachable", "insertvalue", "extractvalue", "atomicrmw", "cmpxchg", "fence", "tail", "atomic", "volatile", "byval", "sret", "c", "eq", "ne", "slt", "sle", "sgt", "sge", "ult", "ule", "ugt", "uge", "oeq", "ogt", "oge", "olt", "ole", "one", "ord", "ueq", "une", "uno", "xchg", "noreturn", "target", "source_filename", "attributes", "appending", "external", "musttail", "notail", "weak", "signext", "zeroext", "noinline", "alwaysinline", "nonnull"
]

func kw_init(g &: Ng):
    tab_init(g.kw, 512)
    repeat k_ng_kw.len() in i:
        _id := tab_adds(g.kw, k_ng_kw[i])
    end
end

func cur(g &: Ng): int:
    if g.p < g.sn:
        ret g.src[g.p] as int
    end
    ret 0 - 1
end

func at_off(g &: Ng, k: int): int:
    if g.p + k < g.sn:
        ret g.src[g.p + k] as int
    end
    ret 0 - 1
end

func is_idc(c: int): bool:
    ret (c >= 97 and c <= 122) or (c >= 65 and c <= 90) or (c >= 48 and c <= 57) or c == 95 or c == 46 or c == 36 or c == 45
end

func is_dig(c: int): bool:
    ret c >= 48 and c <= 57
end

func skip_ws(g &: Ng):
    until g.p < g.sn:
        c := g.src[g.p] as int
        if c == 32 or c == 9 or c == 10 or c == 13:
            g.p += 1
        else c == 59:
            until g.p < g.sn and g.src[g.p] != (10 as u8):
                g.p += 1
            end
        else:
            ret
        end
    end
end

func skip_sp(g &: Ng):
    until g.p < g.sn:
        c := g.src[g.p] as int
        if c == 32 or c == 9 or c == 13:
            g.p += 1
        else:
            ret
        end
    end
end

func skip_line(g &: Ng):
    until g.p < g.sn and g.src[g.p] != (10 as u8):
        g.p += 1
    end
    if g.p < g.sn:
        g.p += 1
    end
end

func at_eol(g &: Ng): bool:
    skip_sp(g)
    c := cur(g)
    ret c == 10 or c == 59 or c < 0
end

func eat(g &: Ng, c: int): bool:
    save := g.p
    skip_ws(g)
    if g.p < g.sn and (g.src[g.p] as int) == c:
        g.p += 1
        ret true
    end
    g.p = save
    ret false
end

func expect(g &: Ng, c: int):
    if not eat(g, c):
        fail(g, "native backend: expected byte " + str.FromInt(c as i64) + " at byte " + str.FromInt(g.p as i64) + " near '" + near(g) + "'")
    end
end

func near(g &: Ng): str:
    mut b := str.NewBuilder()
    mut i := g.p
    until i < g.sn and i < g.p + 60 and g.src[i] != (10 as u8):
        str.BufAppendChar(b, g.src[i] as int)
        i += 1
    end
    r := str.BufStr(b)
    str.BufFree(b)
    ret r
end

func word(g &: Ng): bool:
    skip_ws(g)
    g.ws = g.p
    until g.p < g.sn and is_idc(g.src[g.p] as int):
        g.p += 1
    end
    g.wl = g.p - g.ws
    ret g.wl > 0
end

func word_kw(g &: Ng): int:
    if not word(g):
        ret 0 - 1
    end
    ret tab_get(g.kw, g.src, g.ws, g.wl)
end

func peek_kw(g &: Ng): int:
    save := g.p
    k := word_kw(g)
    g.p = save
    ret k
end

func eat_kw(g &: Ng, k: int): bool:
    save := g.p
    if word_kw(g) == k:
        ret true
    end
    g.p = save
    ret false
end

func word_str(g &: Ng): str:
    mut b := str.NewBuilder()
    repeat g.wl in i:
        str.BufAppendChar(b, g.src[g.ws + i] as int)
    end
    r := str.BufStr(b)
    str.BufFree(b)
    ret r
end

func read_i64(g &: Ng): i64:
    skip_ws(g)
    mut neg := false
    if cur(g) == 45:
        neg = true
        g.p += 1
    end
    mut v := 0 as i64
    until g.p < g.sn and is_dig(g.src[g.p] as int):
        v = v * 10 + ((g.src[g.p] as int) - 48) as i64
        g.p += 1
    end
    if neg:
        ret 0 - v
    end
    ret v
end

func hexv(c: int): int:
    if c >= 48 and c <= 57:
        ret c - 48
    end
    if c >= 97 and c <= 102:
        ret c - 87
    end
    if c >= 65 and c <= 70:
        ret c - 55
    end
    ret 0 - 1
end

func read_float_bits(g &: Ng): i64:
    skip_ws(g)
    if cur(g) == 48 and (at_off(g, 1) == 120 or at_off(g, 1) == 88):
        g.p += 2
        mut v := 0 as u64
        until g.p < g.sn and hexv(g.src[g.p] as int) >= 0:
            v = (v << (4 as u64)) | (hexv(g.src[g.p] as int) as u64)
            g.p += 1
        end
        ret v as i64
    end
    s := g.p
    until g.p < g.sn and (is_idc(g.src[g.p] as int) or g.src[g.p] == (43 as u8)):
        g.p += 1
    end
    mut b := str.NewBuilder()
    mut i := s
    until i < g.p:
        str.BufAppendChar(b, g.src[i] as int)
        i += 1
    end
    txt := str.BufStr(b)
    str.BufFree(b)
    d := strtod(txt, null)
    ret f64_bits(d)
end

func f64_bits(d: f64): i64:
    p := mem.Allocate(8 as u64)
    fp := p as f64*
    fp[0] = d
    ip := p as i64*
    r := ip[0]
    mem.Free(p)
    ret r
end

func bits_f64(b: i64): f64:
    p := mem.Allocate(8 as u64)
    ip := p as i64*
    ip[0] = b
    fp := p as f64*
    r := fp[0]
    mem.Free(p)
    ret r
end

func f32_bits_of(d: f64): i64:
    p := mem.Allocate(8 as u64)
    fp := p as f32*
    fp[0] = d as f32
    ip := p as i32*
    r := (ip[0] as i64) & (0xFFFFFFFF as i64)
    mem.Free(p)
    ret r
end

func read_sigil_name(g &: Ng, sig: int): bool:
    skip_ws(g)
    if cur(g) != sig:
        ret false
    end
    g.p += 1
    g.ws = g.p
    until g.p < g.sn and is_idc(g.src[g.p] as int):
        g.p += 1
    end
    g.wl = g.p - g.ws
    ret g.wl > 0
end

func skip_balanced(g &: Ng):
    mut depth := 0
    until g.p < g.sn:
        c := g.src[g.p] as int
        if c == 40 or c == 91 or c == 123 or c == 60:
            depth += 1
        else c == 41 or c == 93 or c == 125 or c == 62:
            depth -= 1
            if depth == 0:
                g.p += 1
                ret
            end
        else c == 34:
            g.p += 1
            until g.p < g.sn and g.src[g.p] != (34 as u8):
                g.p += 1
            end
        end
        g.p += 1
    end
end
