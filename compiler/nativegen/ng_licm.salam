package nativegen

pub struct Lp:
    pub head: Vector<int> = Vector {}
    pub size: Vector<int> = Vector {}
    pub inl: Vector<int> = Vector {}
    pub wl: Vector<int> = Vector {}
    pub succ: Vector<int> = Vector {}
end

func lp_find(g &: Ng, l &: Lp):
    l.head.clear()
    l.size.clear()
    mut seen := Vector {} as Vector<bool>
    repeat g.b_first.len():
        seen.push(false)
    end
    each b in g.b_rpo:
        blk_succs(g, b, l.succ)
        each h in l.succ:
            if dominates(g, h, b) and not seen[h]:
                seen[h] = true
                l.head.push(h)
                l.size.push(0)
            end
        end
    end
    seen.free()
end

func lp_body(g &: Ng, l &: Lp, h: int, mark: int): int:
    l.wl.clear()
    l.inl[h] = mark
    mut n := 1
    repeat g.b_npred[h] in q:
        p := g.b_pred[g.b_ps[h] + q]
        if dominates(g, h, p) and l.inl[p] != mark:
            l.inl[p] = mark
            l.wl.push(p)
            n += 1
        end
    end
    until l.wl.len() > 0:
        b := l.wl.pop()
        repeat g.b_npred[b] in q2:
            p2 := g.b_pred[g.b_ps[b] + q2]
            if l.inl[p2] != mark and g.b_order[p2] >= 0:
                l.inl[p2] = mark
                l.wl.push(p2)
                n += 1
            end
        end
    end
    ret n
end

func lp_outside_pred(g &: Ng, l &: Lp, h: int, mark: int): int:
    mut out := 0 - 1
    repeat g.b_npred[h] in q:
        p := g.b_pred[g.b_ps[h] + q]
        if l.inl[p] != mark:
            if out >= 0 and out != p:
                ret 0 - 2
            end
            out = p
        end
    end
    ret out
end

func make_preheaders(g &: Ng, l &: Lp): bool:
    mut changed := false
    mut mark := 0
    each h in l.head:
        mark += 1
        _n := lp_body(g, l, h, mark)
        p := lp_outside_pred(g, l, h, mark)
        if p < 0:
            continue
        end
        pt := g.b_last[p]
        if pt < 0 or g.i_op[pt] != OP_CBR:
            continue
        end
        if g.i_b[pt] == g.i_c[pt]:
            continue
        end
        nb := new_blk(g)
        br := ins_new(g, OP_BR, T_VOID)
        g.i_b[br] = h
        ins_append(g, nb, br)
        replace_succ(g, pt, h, nb)
        mut i := g.b_first[h]
        until i >= 0 and g.i_op[i] == OP_PHI:
            ps := g.i_ps[i]
            repeat g.i_pcount[i] in k:
                if g.pool[ps + 2 * k + 1] == p:
                    g.pool[ps + 2 * k + 1] = nb
                end
            end
            i = g.i_next[i]
        end
        changed = true
    end
    ret changed
end

func lp_inv(g &: Ng, l &: Lp, v: int, mark: int): bool:
    if v < 0:
        ret true
    end
    k := g.v_kind[v]
    if k != VK_INS:
        ret true
    end
    d := g.v_def[v]
    b := g.i_blk[d]
    ret b >= 0 and l.inl[b] != mark
end

func hoistable(g &: Ng, l &: Lp, i: int, mark: int): bool:
    op := g.i_op[i]
    if not gvn_pure(op) or g.i_res[i] < 0:
        ret false
    end
    m := val_mask(op)
    if (m & 1) != 0 and not lp_inv(g, l, g.i_a[i], mark):
        ret false
    end
    if (m & 2) != 0 and not lp_inv(g, l, g.i_b[i], mark):
        ret false
    end
    if (m & 4) != 0 and not lp_inv(g, l, g.i_c[i], mark):
        ret false
    end
    ret true
end

func licm(g &: Ng): bool:
    build_dom(g)
    mut l := Lp {}
    repeat g.b_first.len():
        l.inl.push(0)
    end
    lp_find(g, l)
    if l.head.len() == 0:
        l.inl.free()
        ret false
    end
    if make_preheaders(g, l):
        build_cfg(g)
        build_dom(g)
        l.inl.clear()
        repeat g.b_first.len():
            l.inl.push(0)
        end
        lp_find(g, l)
    end
    mut mark := 1000000
    repeat l.head.len() in q:
        mark += 1
        l.size[q] = lp_body(g, l, l.head[q], mark)
    end
    mut ord := Vector {} as Vector<int>
    repeat l.head.len() in q2:
        ord.push(q2)
    end
    mut a := 1
    until a < ord.len():
        x := ord[a]
        mut j := a - 1
        until j >= 0 and l.size[ord[j]] > l.size[x]:
            ord[j + 1] = ord[j]
            j -= 1
        end
        ord[j + 1] = x
        a += 1
    end
    mut moved := false
    mut mk := 2000000
    each li in ord:
        h := l.head[li]
        mk += 1
        _s := lp_body(g, l, h, mk)
        p := lp_outside_pred(g, l, h, mk)
        if p < 0:
            continue
        end
        pt := g.b_last[p]
        if pt < 0 or g.i_op[pt] != OP_BR:
            continue
        end
        each b in g.b_rpo:
            if l.inl[b] != mk:
                continue
            end
            mut i := g.b_first[b]
            until i >= 0:
                nx := g.i_next[i]
                if hoistable(g, l, i, mk):
                    op := g.i_op[i]
                    ins_unlink(g, i)
                    g.i_op[i] = op
                    ins_before(g, pt, i)
                    moved = true
                end
                i = nx
            end
        end
    end
    ord.free()
    l.head.free()
    l.size.free()
    l.inl.free()
    l.wl.free()
    l.succ.free()
    ret moved
end

func loop_weights(g &: Ng):
    nb := g.b_first.len()
    g.b_wt.clear()
    repeat nb:
        g.b_wt.push(1)
    end
    mut l := Lp {}
    repeat nb:
        l.inl.push(0)
    end
    lp_find(g, l)
    mut mark := 0
    each h in l.head:
        mark += 1
        _n := lp_body(g, l, h, mark)
        repeat nb in b:
            if l.inl[b] == mark and g.b_wt[b] < 512:
                g.b_wt[b] = g.b_wt[b] * 8
            end
        end
    end
    l.head.free()
    l.size.free()
    l.inl.free()
    l.wl.free()
    l.succ.free()
end

func sp_bad(seen &: Vector<int>, mark: int, v: int):
    if v >= 0:
        seen[v] = mark
    end
end

func sp_note(g &: Ng, seen &: Vector<int>, mark: int, l &: Lp, lp: int, v: int):
    if v < 0 or seen[v] == mark or seen[v] == 0 - mark:
        ret
    end
    k := g.v_kind[v]
    if k != VK_INS and k != VK_ARG:
        ret
    end
    if is_agg(g, g.v_ty[v]):
        ret
    end
    if k == VK_INS:
        d := g.v_def[v]
        if d < 0 or g.i_op[d] == OP_ALLOCA or g.i_op[d] == OP_ADDR:
            ret
        end
        db := g.i_blk[d]
        if db < 0 or l.inl[db] == mark:
            ret
        end
    end
    if g.lp_cnt[lp] >= 12:
        ret
    end
    seen[v] = mark
    g.lp_cnt[lp] = g.lp_cnt[lp] + 1
    g.lpv_loop.push(lp)
    g.lpv_val.push(v)
end

func lp_pressure(g &: Ng, l &: Lp, mark: int, h: int, seen2 &: Vector<int>, stamp: int): int:
    mut n := 0
    mut i0 := g.b_first[h]
    until i0 >= 0 and g.i_op[i0] == OP_PHI:
        n += 1
        i0 = g.i_next[i0]
    end
    each b in g.b_rpo:
        if l.inl[b] != mark:
            continue
        end
        mut i := g.b_first[b]
        until i >= 0:
            m := val_mask(g.i_op[i])
            repeat 3 in k:
                mut v := 0 - 1
                if k == 0 and (m & 1) != 0: v = g.i_a[i] end
                if k == 1 and (m & 2) != 0: v = g.i_b[i] end
                if k == 2 and (m & 4) != 0: v = g.i_c[i] end
                if v >= 0 and seen2[v] != stamp and (g.v_kind[v] == VK_ARG or (g.v_kind[v] == VK_INS and l.inl[g.i_blk[g.v_def[v]]] != mark)):
                    seen2[v] = stamp
                    n += 1
                end
            end
            i = g.i_next[i]
        end
    end
    ret n
end

func split_plan(g &: Ng):
    nb := g.b_first.len()
    g.b_lp.clear()
    g.lp_pre.clear()
    g.lp_par.clear()
    g.lp_cnt.clear()
    g.lp_head.clear()
    g.lpv_loop.clear()
    g.lpv_val.clear()
    g.sp_loop.clear()
    g.sp_val.clear()
    g.sp_reg.clear()
    repeat nb:
        g.b_lp.push(0 - 1)
    end
    mut l := Lp {}
    repeat nb:
        l.inl.push(0)
    end
    lp_find(g, l)
    nl := l.head.len()
    mut sz := Vector {} as Vector<int>
    mut mark := 0
    repeat nl in q:
        mark += 1
        sz.push(lp_body(g, l, l.head[q], mark))
        g.lp_pre.push(0 - 1)
        g.lp_par.push(0 - 1)
        g.lp_cnt.push(0)
        g.lp_head.push(l.head[q])
    end
    repeat nl in q2:
        mark += 1
        _n := lp_body(g, l, l.head[q2], mark)
        repeat nb in b:
            if l.inl[b] == mark:
                cl := g.b_lp[b]
                if cl < 0 or sz[cl] > sz[q2]:
                    g.b_lp[b] = q2
                end
            end
        end
    end
    repeat nl in q3:
        h := l.head[q3]
        mut best := 0 - 1
        repeat nl in q4:
            if q4 != q3 and sz[q4] > sz[q3]:
                mark += 1
                _n2 := lp_body(g, l, l.head[q4], mark)
                if l.inl[h] == mark and (best < 0 or sz[q4] < sz[best]):
                    best = q4
                end
            end
        end
        g.lp_par[q3] = best
    end
    mut seen := Vector {} as Vector<int>
    repeat g.v_kind.len():
        seen.push(0)
    end
    repeat nl in q5:
        h2 := l.head[q5]
        mark += 1
        _n3 := lp_body(g, l, h2, mark)
        p := lp_outside_pred(g, l, h2, mark)
        if p < 0:
            continue
        end
        pt := g.b_last[p]
        if pt < 0 or g.i_op[pt] != OP_BR or g.i_b[pt] != h2:
            continue
        end
        mut seen2 := Vector {} as Vector<int>
        repeat g.v_kind.len():
            seen2.push(0)
        end
        live_n := lp_pressure(g, l, mark, h2, seen2, 1)
        seen2.free()
        if live_n <= 11:
            continue
        end
        g.lp_pre[q5] = p
        par := g.lp_par[q5]
        if par >= 0:
            mark += 1
            pm := mark
            _n4 := lp_body(g, l, l.head[par], pm)
            mark += 1
            _n5 := lp_body(g, l, h2, mark)
            each bp in g.b_rpo:
                if l.inl[bp] == pm:
                    mut ip := g.b_first[bp]
                    until ip >= 0:
                        opp := g.i_op[ip]
                        mp := val_mask(opp)
                        if (mp & 1) != 0: sp_bad(seen, 0 - mark, g.i_a[ip]) end
                        if (mp & 2) != 0: sp_bad(seen, 0 - mark, g.i_b[ip]) end
                        if (mp & 4) != 0: sp_bad(seen, 0 - mark, g.i_c[ip]) end
                        if opp == OP_CALL:
                            repeat g.i_pcount[ip] in kp:
                                sp_bad(seen, 0 - mark, g.pool[g.i_ps[ip] + 3 * kp])
                            end
                        else opp == OP_PHI:
                            repeat g.i_pcount[ip] in kp2:
                                sp_bad(seen, 0 - mark, g.pool[g.i_ps[ip] + 2 * kp2])
                            end
                        end
                        ip = g.i_next[ip]
                    end
                end
            end
        end
        each b2 in g.b_rpo:
            if l.inl[b2] != mark or g.b_lp[b2] != q5:
                continue
            end
            mut i := g.b_first[b2]
            until i >= 0:
                op := g.i_op[i]
                m := val_mask(op)
                if (m & 1) != 0: sp_note(g, seen, mark, l, q5, g.i_a[i]) end
                if (m & 2) != 0: sp_note(g, seen, mark, l, q5, g.i_b[i]) end
                if (m & 4) != 0: sp_note(g, seen, mark, l, q5, g.i_c[i]) end
                if op == OP_CALL:
                    repeat g.i_pcount[i] in k:
                        sp_note(g, seen, mark, l, q5, g.pool[g.i_ps[i] + 3 * k])
                    end
                else op == OP_PHI:
                    ps := g.i_ps[i]
                    repeat g.i_pcount[i] in k2:
                        pb := g.pool[ps + 2 * k2 + 1]
                        if pb >= 0 and l.inl[pb] == mark:
                            sp_note(g, seen, mark, l, q5, g.pool[ps + 2 * k2])
                        end
                    end
                end
                i = g.i_next[i]
            end
        end
    end
    seen.free()
    sz.free()
    l.head.free()
    l.size.free()
    l.inl.free()
    l.wl.free()
    l.succ.free()
end

func split_lookup(g &: Ng, v: int): int:
    if g.cur_b < 0 or g.sp_val.len() == 0:
        ret 0 - 1
    end
    mut lp := g.b_lp[g.cur_b]
    until lp >= 0:
        mut k := g.sp_val.len() - 1
        until k >= 0:
            if g.sp_val[k] == v and g.sp_loop[k] == lp:
                ret g.sp_reg[k]
            end
            k -= 1
        end
        lp = g.lp_par[lp]
    end
    ret 0 - 1
end

func ensure_preheaders(g &: Ng):
    build_dom(g)
    mut l := Lp {}
    repeat g.b_first.len():
        l.inl.push(0)
    end
    lp_find(g, l)
    if l.head.len() > 0 and make_preheaders(g, l):
        build_cfg(g)
    end
    l.head.free()
    l.size.free()
    l.inl.free()
    l.wl.free()
    l.succ.free()
end
