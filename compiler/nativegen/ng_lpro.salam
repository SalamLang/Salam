package nativegen

func lpro_safe(g &: Ng, a: int, t: int): bool:
    mut disp := 0 as i64
    r := addr_root(g, a, disp)
    if r < 0 or disp < (0 as i64) or disp >= (4096 as i64):
        ret false
    end
    if g.v_kind[r] == VK_ARG:
        k := g.v_i[r] as int
        ret k >= 0 and k < g.f_argf.len() and (g.f_argf[k] & IF_NONNULL) != 0
    end
    if g.v_kind[r] == VK_INS and g.i_op[g.v_def[r]] == OP_ALLOCA:
        d := g.v_def[r]
        n := g.i_d[d] < (1 as i64) ? (1 as i64) : g.i_d[d]
        ret disp + (tsize(g, t) as i64) <= (tsize(g, g.i_x[d]) as i64) * n
    end
    ret false
end

func lpro_scan(g &: Ng, l &: Lp, mk: int, a: int, c: int, calls &: Vector<int>): bool:
    calls.clear()
    each b in g.b_rpo:
        if l.inl[b] != mk:
            continue
        end
        mut i := g.b_first[b]
        until i >= 0:
            op := g.i_op[i]
            if op == OP_CALL:
                if not call_no_write(g, i):
                    calls.push(i)
                end
            else op == OP_STORE:
                sc := mem_cls(g, i)
                if (g.i_f[i] & (IF_VOLATILE | IF_ATOMIC)) != 0 or sc == 0 or sc == c:
                    ret false
                end
            else op == OP_RMW or op == OP_CMPXCHG or op == OP_FENCE:
                ret false
            else op == OP_LOAD and g.i_a[i] == a and (g.i_f[i] & (IF_VOLATILE | IF_ATOMIC)) != 0:
                ret false
            end
            i = g.i_next[i]
        end
    end
    ret calls.len() > 0 and calls.len() <= 4
end

func lpro_reload(g &: Ng, at: int, a: int, t: int, c: int, tmp: int):
    ld := ins_new(g, OP_LOAD, t)
    g.i_a[ld] = a
    g.i_c[ld] = c
    lv := new_res(g, ld)
    st := ins_new(g, OP_STORE, T_VOID)
    g.i_a[st] = lv
    g.i_b[st] = tmp
    ins_before(g, at, ld)
    ins_before(g, at, st)
end

func lpro_loop(g &: Ng, l &: Lp, mk: int, pt: int, calls &: Vector<int>, done &: Vector<int>): bool:
    done.clear()
    mut changed := false
    each b in g.b_rpo:
        if l.inl[b] != mk:
            continue
        end
        mut i := g.b_first[b]
        until i >= 0:
            nx := g.i_next[i]
            if g.i_op[i] == OP_LOAD and (g.i_f[i] & (IF_VOLATILE | IF_ATOMIC)) == 0:
                a := g.i_a[i]
                t := g.i_ty[i]
                c := mem_cls(g, i)
                mut seen := false
                each dv in done:
                    if dv == a:
                        seen = true
                    end
                end
                if not seen and c != 0 and not is_agg(g, t) and not is_vec(g, t) and lp_inv(g, l, a, mk) and lpro_safe(g, a, t) and lpro_scan(g, l, mk, a, c, calls):
                    done.push(a)
                    al := ins_new(g, OP_ALLOCA, T_PTR)
                    g.i_x[al] = t
                    g.i_d[al] = 1 as i64
                    tmp := new_res(g, al)
                    ins_before(g, g.b_first[0], al)
                    each b2 in g.b_rpo:
                        if l.inl[b2] == mk:
                            mut j := g.b_first[b2]
                            until j >= 0:
                                if g.i_op[j] == OP_LOAD and g.i_a[j] == a and g.i_ty[j] == t:
                                    g.i_a[j] = tmp
                                end
                                j = g.i_next[j]
                            end
                        end
                    end
                    lpro_reload(g, pt, a, t, c, tmp)
                    each cl in calls:
                        lpro_reload(g, g.i_next[cl], a, t, c, tmp)
                    end
                    changed = true
                end
            end
            i = nx
        end
    end
    ret changed
end

func lpro(g &: Ng): bool:
    build_dom(g)
    mut l := Lp {}
    repeat g.b_first.len():
        l.inl.push(0)
    end
    lp_find(g, l)
    if l.head.len() == 0:
        l.inl.free()
        ret false
    end
    if make_preheaders(g, l):
        build_cfg(g)
        build_dom(g)
        l.inl.clear()
        repeat g.b_first.len():
            l.inl.push(0)
        end
        lp_find(g, l)
    end
    mut calls := Vector {} as Vector<int>
    mut done := Vector {} as Vector<int>
    mut changed := false
    mut mk := 3000000
    each h in l.head:
        mk += 1
        _s := lp_body(g, l, h, mk)
        p := lp_outside_pred(g, l, h, mk)
        if p < 0:
            continue
        end
        pt := g.b_last[p]
        if pt < 0 or g.i_op[pt] != OP_BR:
            continue
        end
        if lpro_loop(g, l, mk, pt, calls, done):
            changed = true
        end
    end
    calls.free()
    done.free()
    l.head.free()
    l.size.free()
    l.inl.free()
    l.wl.free()
    l.succ.free()
    if changed:
        build_cfg(g)
        mem2reg(g)
        simplify_phis(g)
    end
    ret changed
end
