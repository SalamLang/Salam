package nativegen

const LV_NONE := 0
const LV_IDX := 1
const LV_ADDR := 2
const LV_VEC := 3
const LV_RED := 4
const LV_SKIP := 5
const LV_NARROW := 6
const LV_HOIST := 7
const LV_RIDX := 8
const LV_RADDR := 9
const LV_TAIL_MAX := 48

pub struct Lv:
    pub h: int = -1
    pub w: int = -1
    pub latch: int = -1
    pub pre: int = -1
    pub exitb: int = -1
    pub shape: int = 0
    pub ivp: int = -1
    pub ivn: int = -1
    pub divp: int = -1
    pub divn: int = -1
    pub rsum: int = -1
    pub rsum64: int = -1
    pub hpool: int = -1
    pub hp64: int = -1
    pub rinv: Vector<int> = Vector {}
    pub cmp: int = -1
    pub lim: int = -1
    pub sle: bool = false
    pub lane: int = 0
    pub vf: int = 0
    pub wide: bool = false
    pub cls: Vector<int> = Vector {}
    pub vmap: Vector<int> = Vector {}
    pub reds: Vector<int> = Vector {}
    pub rnext: Vector<int> = Vector {}
    pub rkind: Vector<int> = Vector {}
    pub vbody: int = -1
    pub vhead: int = -1
    pub vstart: int = -1
    pub viv_t: Vector<int> = Vector {}
    pub viv_v: Vector<int> = Vector {}
    pub viv_inc: Vector<int> = Vector {}
    pub lanes_v: Vector<int> = Vector {}
    pub rcmp: Vector<int> = Vector {}
    pub body: Vector<int> = Vector {}
    pub stores: Vector<int> = Vector {}
    pub loads: Vector<int> = Vector {}
    pub checks: Vector<int> = Vector {}
    pub bc_s: Vector<int> = Vector {}
    pub bc_v: Vector<int> = Vector {}
    pub inv: Vector<bool> = Vector {}
    pub hoist: Vector<int> = Vector {}
    pub hchecks: Vector<int> = Vector {}
    pub fi: bool = false
    pub hmap: Vector<int> = Vector {}
    pub nw: int = 0
    pub rlo: Vector<i64> = Vector {}
    pub rhi: Vector<i64> = Vector {}
    pub rkn: Vector<bool> = Vector {}
    pub navg: Vector<int> = Vector {}
    pub tail: bool = false
end

func lv_free(r &: Lv):
    r.cls.Free()
    r.vmap.Free()
    r.reds.Free()
    r.rnext.Free()
    r.rkind.Free()
    r.rcmp.Free()
    r.body.Free()
    r.stores.Free()
    r.loads.Free()
    r.checks.Free()
    r.bc_s.Free()
    r.bc_v.Free()
    r.inv.Free()
    r.rlo.Free()
    r.rhi.Free()
    r.rkn.Free()
    r.navg.Free()
end

func loop_vectorize(g &: Ng): bool:
    ensure_preheaders(g)
    count_uses(g)
    build_dom(g)
    mut l := Lp {}
    repeat g.b_first.Len():
        l.inl.Push(0)
    end
    lp_find(g, l)
    mut heads := Vector {} as Vector<int>
    each hh in l.head:
        heads.Push(hh)
    end
    mut changed := false
    mut mark := 8000000
    each h in heads:
        if changed:
            break
        end
        mark++
        _n := lp_body(g, l, h, mark)
        mut nw := g.off_vnarrow ? 0 : 8
        until not changed:
            mut r := Lv {}
            r.nw = nw
            if lv_match(g, l, mark, h, r):
                lv_transform(g, r)
                changed = true
            end
            lv_free(r)
            if nw == 0:
                break
            end
            nw = nw == 8 ? 16 : 0
        end
    end
    heads.Free()
    l.head.Free()
    l.size.Free()
    l.inl.Free()
    l.wl.Free()
    l.succ.Free()
    if changed:
        ensure_terms(g)
        build_cfg(g)
    end
    ret changed
end
