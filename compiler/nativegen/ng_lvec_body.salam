package nativegen

func lv_emit_body(g &: Ng, r &: Lv, ck: int, vb: int, vaccs &: Vector<int>):
    each i in r.body:
        op := g.i_op[i]
        res := g.i_res[i]
        c := res >= 0 ? r.cls[res] : LV_NONE
        if op == OP_STORE:
            nst := ins_new(g, OP_STORE, T_VOID)
            sv := g.i_a[i]
            if lv_cls(r, sv) == LV_NARROW:
                g.i_a[nst] = r.vmap[g.i_a[g.v_def[sv]]]
                g.i_f[nst] = IF_W8
            else:
                g.i_a[nst] = lv_vget(g, r, ck, sv, lv_vty(g.v_ty[sv], r.lane, r.wide))
            end
            g.i_b[nst] = r.vmap[g.i_b[i]]
            if lv_cls(r, g.i_b[i]) == LV_RADDR:
                g.i_a[nst] = lv_emit(
                    g, vb, OP_VREV, lv_vty(g.v_ty[sv], r.lane, r.wide), g.i_a[nst], -1
                )
                g.i_b[nst] = lv_rshift(g, r, vb, g.i_b[nst], tsize(g, g.v_ty[sv]))
            end
            g.i_c[nst] = g.i_c[i]
            ins_append(g, vb, nst)
            continue
        end
        if c == LV_SKIP or c == LV_NARROW or c == LV_HOIST:
            continue
        end
        if op == OP_SEXT and g.i_ty[i] == T_I64 and r.divp >= 0 and g.i_a[i] == g.i_res[r.divp]:
            r.vmap[res] = r.hp64
            continue
        end
        if c == LV_IDX or c == LV_ADDR or c == LV_RIDX or c == LV_RADDR:
            ni := ins_new(g, op, g.i_ty[i])
            g.i_a[ni] = g.i_a[i]
            g.i_b[ni] = g.i_b[i]
            g.i_c[ni] = g.i_c[i]
            g.i_x[ni] = g.i_x[i]
            g.i_d[ni] = g.i_d[i]
            g.i_f[ni] = 0
            if (op == OP_ADD or op == OP_SUB) and not g.off_lvnsw:
                g.i_f[ni] = g.i_f[i] & IF_NSW
            end
            if g.i_a[ni] >= 0 and lv_in(g, r, g.i_a[ni]) and r.vmap[g.i_a[ni]] >= 0: g.i_a[ni] = r.vmap[g.i_a[ni]] end
            if g.i_b[ni] >= 0 and lv_in(g, r, g.i_b[ni]) and r.vmap[g.i_b[ni]] >= 0: g.i_b[ni] = r.vmap[g.i_b[ni]] end
            g.i_a[ni] = lv_hm(r, g.i_a[ni])
            g.i_b[ni] = lv_hm(r, g.i_b[ni])
            r.vmap[res] = new_res(g, ni)
            ins_append(g, vb, ni)
            continue
        end
        if c == LV_RED:
            mut red_i := -1
            repeat r.rnext.Len() in k:
                if r.rnext[k] == i:
                    red_i = k
                end
            end
            if red_i < 0:
                continue
            end
            pv := g.i_res[r.reds[red_i]]
            vt2 := g.v_ty[vaccs[red_i]]
            rk2 := r.rkind[red_i]
            if rk2 >= 5:
                cvv := r.vmap[g.i_a[i]]
                one := lv_bcast(g, r, ck, const_int(g, T_I8, 1 as i64), T_V16I8)
                mut m1 := lv_emit(g, vb, OP_AND, T_V16I8, cvv, one)
                flip := g.i_a[i] < r.inv.Len() and r.inv[g.i_a[i]]
                if (rk2 == 6) != flip:
                    m1 = lv_emit(g, vb, OP_XOR, T_V16I8, m1, one)
                end
                sd := ins_new(g, OP_VSADB, T_V2I64)
                g.i_a[sd] = m1
                sdv := new_res(g, sd)
                ins_append(g, vb, sd)
                r.vmap[res] = lv_emit(g, vb, OP_ADD, T_V2I64, vaccs[red_i], sdv)
                continue
            end
            if rk2 != 0:
                xm := g.i_b[i] == pv ? g.i_c[i] : g.i_b[i]
                xvv := lv_vget(g, r, ck, xm, vt2)
                vc2 := ins_new(g, OP_ICMP, lv_vty(T_I1, r.lane, r.wide))
                g.i_a[vc2] = xvv
                g.i_b[vc2] = vaccs[red_i]
                g.i_x[vc2] = rk2 == 1 ? CC_SGT : (rk2 == 2 ? CC_SLT : (rk2 == 3 ? CC_UGT : CC_ULT))
                vcv := new_res(g, vc2)
                ins_append(g, vb, vc2)
                vs2 := ins_new(g, OP_SELECT, vt2)
                g.i_a[vs2] = vcv
                g.i_b[vs2] = xvv
                g.i_c[vs2] = vaccs[red_i]
                r.vmap[res] = new_res(g, vs2)
                ins_append(g, vb, vs2)
                continue
            end
            mut x := g.i_a[i] == pv ? g.i_b[i] : g.i_a[i]
            if not g.off_redinv and not is_flt(
                g, g.i_ty[i]
            ) and x >= 0 and g.v_kind[x] == VK_INS and g.v_uses[x] == 1 and lv_in(g, r, x):
                xd := g.v_def[x]
                if g.i_op[xd] == OP_ADD and g.i_ty[xd] == g.i_ty[i]:
                    if lv_inv(g, r, g.i_b[xd]) and not lv_inv(g, r, g.i_a[xd]):
                        r.rinv[red_i] = g.i_b[xd]
                        x = g.i_a[xd]
                    else lv_inv(g, r, g.i_a[xd]) and not lv_inv(g, r, g.i_b[xd]):
                        r.rinv[red_i] = g.i_a[xd]
                        x = g.i_b[xd]
                    end
                end
            end
            r.vmap[res] = lv_emit(
                g,
                vb,
                is_flt(g, g.i_ty[i]) ? OP_FADD : OP_ADD,
                vt2,
                vaccs[red_i],
                lv_vget(g, r, ck, x, vt2)
            )
            continue
        end
        if op == OP_LOAD:
            if g.i_ty[i] == T_I8 and r.lane != 1:
                continue
            end
            vt3 := lv_vty(g.i_ty[i], r.lane, r.wide)
            nl := ins_new(g, OP_LOAD, vt3)
            rev := lv_cls(r, g.i_a[i]) == LV_RADDR
            g.i_a[nl] = rev ? lv_rshift(
                g, r, vb, r.vmap[g.i_a[i]], tsize(g, g.i_ty[i])
            ) : r.vmap[g.i_a[i]]
            g.i_c[nl] = g.i_c[i]
            r.vmap[res] = new_res(g, nl)
            ins_append(g, vb, nl)
            if rev:
                r.vmap[res] = lv_emit(g, vb, OP_VREV, vt3, r.vmap[res], -1)
            end
            continue
        end
        if (op == OP_ZEXT or op == OP_SEXT or op == OP_TRUNC) and r.nw > 0 and
            lv_cls(r, g.i_a[i]) == LV_VEC:
            r.vmap[res] = r.vmap[g.i_a[i]]
            continue
        end
        if op == OP_ZEXT or op == OP_SEXT:
            ld := g.v_def[g.i_a[i]]
            nw := ins_new(g, OP_LOAD, vec_ty(r.nw == 16 ? T_I16 : T_I32, r.wide))
            g.i_a[nw] = r.vmap[g.i_a[ld]]
            g.i_c[nw] = g.i_c[ld]
            g.i_f[nw] = IF_W8
            g.i_x[nw] = tsize(g, g.i_ty[ld]) | (op == OP_SEXT ? 4 : 0)
            r.vmap[res] = new_res(g, nw)
            ins_append(g, vb, nw)
            continue
        end
        if r.nw == 8 and (op == OP_SHL or op == OP_LSHR):
            vtb := lv_nvt(r, g.i_ty[i])
            mut isavg := false
            each na in r.navg:
                if na == i:
                    isavg = true
                end
            end
            if isavg:
                r.vmap[res] = lv_navg(g, r, ck, i, vtb)
            else:
                r.vmap[res] = lv_nbyte_shift(
                    g, r, ck, op, lv_vget(g, r, ck, g.i_a[i], vtb), g.v_i[g.i_b[i]]
                )
            end
            continue
        end
        if (op == OP_SHL or op == OP_LSHR or op == OP_ASHR) and
            (not is_cint(g, g.i_b[i]) or (op == OP_ASHR and g.i_ty[i] == T_I64)):
            vts := lv_vty(g.i_ty[i], r.lane, r.wide)
            xv := lv_vget(g, r, ck, g.i_a[i], vts)
            if not g.off_vsign and op == OP_ASHR and g.i_ty[i] == T_I64 and is_cint(g, g.i_b[i]) and
                (g.v_i[g.i_b[i]] & (63 as i64)) == (63 as i64):
                v32 := vec_ty(T_I32, r.wide)
                hi := lv_emit(g, vb, OP_VREV, v32, xv, -1)
                g.i_x[g.v_def[hi]] = 0xF5
                sg := lv_emit(g, vb, OP_ASHR, v32, hi, const_int(g, T_I32, 31 as i64))
                r.vmap[res] = lv_emit(g, vb, OP_BITCAST, vts, sg, -1)
                g.i_x[g.v_def[r.vmap[res]]] = v32
                continue
            end
            bits := g.i_ty[i] == T_I64 ? 63 : 31
            mut cm := -1
            if is_cint(g, g.i_b[i]):
                cm = const_int(g, T_I64, g.v_i[g.i_b[i]])
            else:
                mut c64 := lv_hm(r, g.i_b[i])
                if g.v_ty[c64] != T_I64:
                    c64 = lv_emit_before(g, g.b_last[ck], OP_ZEXT, T_I64, c64, -1)
                    g.i_x[g.v_def[c64]] = g.v_ty[g.i_b[i]]
                end
                cm = lv_emit_before(
                    g, g.b_last[ck], OP_AND, T_I64, c64, const_int(g, T_I64, bits as i64)
                )
            end
            cv := lv_bcast(g, r, ck, cm, T_V2I64)
            if op == OP_ASHR and g.i_ty[i] == T_I64:
                t1 := lv_emit(g, vb, OP_LSHR, vts, xv, cv)
                ms := lv_emit_before(
                    g,
                    g.b_last[ck],
                    OP_LSHR,
                    T_I64,
                    const_int(g, T_I64, (1 as i64) << (63 as i64)),
                    cm
                )
                mv := lv_bcast(g, r, ck, ms, vts)
                x2 := lv_emit(g, vb, OP_XOR, vts, t1, mv)
                r.vmap[res] = lv_emit(g, vb, OP_SUB, vts, x2, mv)
            else:
                r.vmap[res] = lv_emit(g, vb, op, vts, xv, cv)
            end
            continue
        end
        mut swapsel := false
        if op == OP_SELECT and not lv_inv(
            g, r, g.i_a[i]
        ) and g.i_a[i] < r.inv.Len() and r.inv[g.i_a[i]]:
            swapsel = true
        end
        vt4 := lv_nvt(r, g.i_ty[i])
        opty := op == OP_ICMP ? lv_nvt(r, g.v_ty[g.i_a[i]]) : vt4
        ni2 := ins_new(g, op, vt4)
        g.i_x[ni2] = g.i_x[i]
        if op == OP_SELECT:
            cnd := g.i_a[i]
            if lv_inv(g, r, cnd):
                g.i_a[ni2] = lv_bmask(g, r, ck, cnd, vt4)
            else:
                g.i_a[ni2] = r.vmap[cnd]
            end
            g.i_b[ni2] = lv_vget(g, r, ck, swapsel ? g.i_c[i] : g.i_b[i], vt4)
            g.i_c[ni2] = lv_vget(g, r, ck, swapsel ? g.i_b[i] : g.i_c[i], vt4)
        else op == OP_SHL or op == OP_LSHR or op == OP_ASHR:
            g.i_a[ni2] = lv_vget(g, r, ck, g.i_a[i], vt4)
            g.i_b[ni2] = lv_hm(r, g.i_b[i])
        else g.i_ty[i] == T_I1 and op != OP_ICMP:
            g.i_a[ni2] = r.vmap[g.i_a[i]]
            if is_cint(g, g.i_b[i]):
                ones := new_val(g, VK_INT, T_I32, -1 as i64)
                g.i_b[ni2] = lv_bcast(g, r, ck, ones, vt4)
            else:
                g.i_b[ni2] = r.vmap[g.i_b[i]]
            end
        else:
            g.i_a[ni2] = lv_vget(g, r, ck, g.i_a[i], opty)
            g.i_b[ni2] = lv_vget(g, r, ck, g.i_b[i], opty)
        end
        if op == OP_ICMP and lv_sel_only(g, r, res):
            px := g.i_x[ni2]
            if px == CC_NE or px == CC_SGE or px == CC_SLE:
                g.i_x[ni2] = neg_cc(px)
                r.inv[res] = true
            end
        else op == OP_ICMP and lv_dm_user(g, r, res):
            g.i_x[ni2] = neg_cc(g.i_x[ni2])
        else lv_dm(g, r, i):
            g.i_op[ni2] = op == OP_AND ? OP_OR : OP_AND
            r.inv[res] = true
        end
        r.vmap[res] = new_res(g, ni2)
        ins_append(g, vb, ni2)
    end
end
