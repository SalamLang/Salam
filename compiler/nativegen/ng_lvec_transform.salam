package nativegen

func lv_tail_ok(g &: Ng, r &: Lv, vb: int): bool:
    if g.off_vtail or not r.wide or r.reds.Len() > 0 or r.divp >= 0 or lv_short(g, r):
        ret false
    end
    mut n := 0
    mut i := g.b_first[vb]
    until i >= 0:
        n++
        i = g.i_next[i]
    end
    ret n <= LV_TAIL_MAX
end

func lv_tail(g &: Ng, r &: Lv, vct: int, rb: int, viv: int, viv64: int, lim64: int, ivt: int): int:
    e0 := new_blk(g)
    e1 := new_blk(g)
    tb := new_blk(g)
    vf := r.vf
    vb := r.vbody
    hvf := vf / 2
    hfm := r.sle ? hvf - 2 : hvf - 1
    elim := lv_emit(g, e0, OP_SUB, T_I64, lim64, const_int(g, T_I64, hfm as i64))
    ec := lv_emit(g, e0, OP_ICMP, T_I1, viv64, elim)
    g.i_x[g.v_def[ec]] = CC_SLT
    et := ins_new(g, OP_CBR, T_VOID)
    g.i_a[et] = ec
    g.i_b[et] = e1
    g.i_c[et] = rb
    g.i_f[et] = IF_NOVEC
    ins_append(g, e0, et)
    ej := ins_new(g, OP_BR, T_VOID)
    g.i_b[ej] = tb
    ins_append(g, e1, ej)
    g.i_c[vct] = e0
    each i in r.body:
        res := g.i_res[i]
        if res >= 0 and res < r.vmap.Len():
            r.vmap[res] = -1
        end
    end
    r.vmap[g.i_res[r.ivp]] = viv
    r.wide = false
    r.vf = hvf
    r.vbody = tb
    r.tail = true
    mut none := Vector {} as Vector<int>
    lv_emit_body(g, r, e1, tb, none)
    none.Free()
    r.wide = true
    r.vf = vf
    r.vbody = vb
    r.tail = false
    ve := lv_emit(g, tb, OP_ADD, ivt, viv, const_int(g, ivt, hvf as i64))
    g.i_f[g.v_def[ve]] = IF_NSW
    bj := ins_new(g, OP_BR, T_VOID)
    g.i_b[bj] = rb
    ins_append(g, tb, bj)
    each tbk in [e0, e1, tb]:
        mut ti := g.b_first[tbk]
        until ti >= 0:
            g.lvu_grow++
            ti = g.i_next[ti]
        end
    end
    ret lv_phi(g, rb, ivt, viv, e0, ve, tb)
end

func lv_transform(g &: Ng, r &: Lv):
    h := r.h
    pre := r.pre
    g.i_f[g.b_last[h]] |= IF_NOVEC
    ivv := g.i_res[r.ivp]
    ivt := g.i_ty[r.ivp]
    start := phi_val_for(g, r.ivp, pre)
    ck := new_blk(g)
    vh := new_blk(g)
    vb := new_blk(g)
    r.vbody = vb
    rb := new_blk(g)
    ckt := ins_new(g, OP_CBR, T_VOID)
    ins_append(g, ck, ckt)
    replace_succ(g, g.b_last[pre], h, ck)
    if r.divp >= 0:
        hi0 := phi_val_for(g, r.divp, pre)
        r.rsum = lv_emit_before(g, ckt, OP_ADD, ivt, start, hi0)
        sl := lv_sext(g, ck, start)
        sh := lv_sext(g, ck, hi0)
        r.rsum64 = lv_emit_before(g, ckt, OP_ADD, T_I64, sl, sh)
        s1 := lv_emit_before(g, ckt, OP_ADD, T_I64, r.rsum64, const_int(g, T_I64, 1 as i64))
        r.lim = lv_emit_before(g, ckt, OP_ASHR, T_I64, s1, const_int(g, T_I64, 1 as i64))
    end
    lim64 := lv_sext(g, ck, r.lim)
    s64 := lv_sext(g, ck, start)
    vfm := r.sle ? r.vf - 2 : r.vf - 1
    vlim := lv_emit_before(g, ckt, OP_SUB, T_I64, lim64, const_int(g, T_I64, vfm as i64))
    mut cond := lv_emit_before(g, ckt, OP_ICMP, T_I1, s64, vlim)
    g.i_x[g.v_def[cond]] = CC_SLT
    mut ce := lim64
    if r.sle:
        ce = lv_emit_before(g, ckt, OP_ADD, T_I64, lim64, const_int(g, T_I64, 1 as i64))
    end
    r.hmap.Clear()
    repeat g.v_kind.Len():
        r.hmap.Push(-1)
    end
    each hl in r.hoist:
        nh := ins_new(g, OP_LOAD, g.i_ty[hl])
        g.i_a[nh] = lv_hm(r, g.i_a[hl])
        g.i_c[nh] = g.i_c[hl]
        ins_before(g, ckt, nh)
        hres := new_res(g, nh)
        repl_grow(g)
        until r.hmap.Len() >= g.v_kind.Len():
            r.hmap.Push(-1)
        end
        r.hmap[g.i_res[hl]] = hres
    end
    mut hq := 0
    until hq < r.hchecks.Len():
        mut s_lo := -1
        mut s_hi := -1
        lv_addr_range(g, r, ck, r.hchecks[hq], s64, ce, s_lo, s_hi)
        hl2 := r.hchecks[hq + 1]
        p0 := lv_emit_before(g, ckt, OP_PTRTOINT, T_I64, lv_hm(r, g.i_a[hl2]), -1)
        p1 := lv_emit_before(
            g, ckt, OP_ADD, T_I64, p0, const_int(g, T_I64, tsize(g, g.i_ty[hl2]) as i64)
        )
        h1 := lv_emit_before(g, ckt, OP_ICMP, T_I1, s_hi, p0)
        g.i_x[g.v_def[h1]] = CC_ULE
        h2 := lv_emit_before(g, ckt, OP_ICMP, T_I1, p1, s_lo)
        g.i_x[g.v_def[h2]] = CC_ULE
        h3 := lv_emit_before(g, ckt, OP_OR, T_I1, h1, h2)
        cond = lv_emit_before(g, ckt, OP_AND, T_I1, cond, h3)
        hq += 2
    end
    mut q := 0
    until q < r.checks.Len():
        mut a_lo := -1
        mut a_hi := -1
        mut b_lo := -1
        mut b_hi := -1
        lv_addr_range(g, r, ck, r.checks[q], s64, ce, a_lo, a_hi)
        lv_addr_range(g, r, ck, r.checks[q + 1], s64, ce, b_lo, b_hi)
        c1 := lv_emit_before(g, ckt, OP_ICMP, T_I1, a_hi, b_lo)
        g.i_x[g.v_def[c1]] = CC_ULE
        c2 := lv_emit_before(g, ckt, OP_ICMP, T_I1, b_hi, a_lo)
        g.i_x[g.v_def[c2]] = CC_ULE
        c3 := lv_emit_before(g, ckt, OP_OR, T_I1, c1, c2)
        cond = lv_emit_before(g, ckt, OP_AND, T_I1, cond, c3)
        q += 2
    end
    g.i_a[ckt] = cond
    g.i_b[ckt] = vh
    g.i_c[ckt] = h
    g.i_f[ckt] = IF_NOVEC
    r.vmap.Clear()
    r.inv.Clear()
    repeat g.v_kind.Len():
        r.vmap.Push(-1)
        r.inv.Push(false)
    end
    viv_phi := ins_new(g, OP_PHI, ivt)
    g.i_ps[viv_phi] = g.pool.Len()
    g.i_pcount[viv_phi] = 2
    g.pool.Push(start)
    g.pool.Push(ck)
    g.pool.Push(-1)
    g.pool.Push(vb)
    vpool := g.pool.Len() - 2
    viv := new_res(g, viv_phi)
    ins_append(g, vh, viv_phi)
    r.vhead = vh
    r.vstart = start
    r.rinv.Clear()
    mut vaccs := Vector {} as Vector<int>
    mut vpools := Vector {} as Vector<int>
    repeat r.reds.Len() in rk:
        rp := r.reds[rk]
        vt := r.rkind[rk] >= 5 ? T_V2I64 : lv_vty(g.i_ty[rp], r.lane, r.wide)
        mut a0 := new_val(g, VK_ZERO, vt, 0 as i64)
        if r.rkind[rk] != 0 and r.rkind[rk] < 5:
            a0 = lv_bcast(g, r, ck, phi_val_for(g, rp, pre), vt)
        end
        ap := ins_new(g, OP_PHI, vt)
        g.i_ps[ap] = g.pool.Len()
        g.i_pcount[ap] = 2
        g.pool.Push(a0)
        g.pool.Push(ck)
        g.pool.Push(-1)
        g.pool.Push(vb)
        vpools.Push(g.pool.Len() - 2)
        av := new_res(g, ap)
        ins_append(g, vh, ap)
        vaccs.Push(av)
        r.rinv.Push(-1)
        r.vmap[g.i_res[rp]] = av
    end
    viv64 := lv_sext_app(g, vh, viv)
    vc := lv_emit(g, vh, OP_ICMP, T_I1, viv64, vlim)
    g.i_x[g.v_def[vc]] = CC_SLT
    vct := ins_new(g, OP_CBR, T_VOID)
    g.i_a[vct] = vc
    g.i_b[vct] = vb
    g.i_c[vct] = rb
    g.i_f[vct] = g.off_lvunr or r.reds.Len() > 0 or lv_short(g, r) ? IF_NOVEC : IF_NOVEC | IF_LVRUN
    ins_append(g, vh, vct)
    r.vmap[ivv] = viv
    if r.divp >= 0:
        hph := ins_new(g, OP_PHI, T_I64)
        g.i_ps[hph] = g.pool.Len()
        g.i_pcount[hph] = 2
        g.pool.Push(lv_sext(g, ck, phi_val_for(g, r.divp, pre)))
        g.pool.Push(ck)
        g.pool.Push(-1)
        g.pool.Push(vb)
        r.hpool = g.pool.Len() - 2
        r.hp64 = new_res(g, hph)
        mut fp := g.b_first[vh]
        until fp >= 0 and g.i_op[fp] == OP_PHI:
            fp = g.i_next[fp]
        end
        ins_before(g, fp, hph)
        if ivt == T_I64:
            r.vmap[g.i_res[r.divp]] = r.hp64
        else:
            ht := lv_emit(g, vb, OP_TRUNC, ivt, r.hp64, -1)
            g.i_x[g.v_def[ht]] = T_I64
            r.vmap[g.i_res[r.divp]] = ht
        end
    end
    if r.shape == 0:
        ne := new_blk(g)
        nej := ins_new(g, OP_BR, T_VOID)
        g.i_b[nej] = r.exitb
        ins_append(g, ne, nej)
        replace_succ(g, g.b_last[h], r.exitb, ne)
        mut ep := g.b_first[r.exitb]
        until ep >= 0 and g.i_op[ep] == OP_PHI:
            lv_phi_repred(g, ep, h, ne)
            ep = g.i_next[ep]
        end
        r.exitb = ne
    end
    lv_emit_body(g, r, ck, vb, vaccs)
    vnext := lv_emit(g, vb, OP_ADD, ivt, viv, const_int(g, ivt, r.vf as i64))
    g.i_f[g.v_def[vnext]] = IF_NSW
    g.pool[vpool] = vnext
    if r.divp >= 0:
        hnext := lv_emit(g, vb, OP_SUB, T_I64, r.hp64, const_int(g, T_I64, r.vf as i64))
        g.pool[r.hpool] = hnext
    end
    repeat r.reds.Len() in k2:
        g.pool[vpools[k2]] = r.vmap[g.i_res[r.rnext[k2]]]
    end
    each vi in r.viv_inc:
        ins_append(g, vb, vi)
    end
    bj := ins_new(g, OP_BR, T_VOID)
    g.i_b[bj] = vh
    ins_append(g, vb, bj)
    mut xiv := viv
    if lv_tail_ok(g, r, vb):
        xiv = lv_tail(g, r, vct, rb, viv, viv64, lim64, ivt)
    end
    mut acc0 := Vector {} as Vector<int>
    repeat r.reds.Len() in k3:
        rp3 := r.reds[k3]
        mm := r.rkind[k3] != 0 and r.rkind[k3] < 5
        hs := ins_new(g, mm ? OP_VREDMM : OP_VREDADD, r.rkind[k3] >= 5 ? T_I64 : g.i_ty[rp3])
        g.i_a[hs] = vaccs[k3]
        g.i_x[hs] = r.rkind[k3]
        mut hv := new_res(g, hs)
        ins_append(g, rb, hs)
        if r.rkind[k3] >= 5 and g.i_ty[rp3] != T_I64:
            hv = lv_emit(g, rb, OP_TRUNC, g.i_ty[rp3], hv, -1)
        end
        if mm:
            acc0.Push(hv)
        else:
            init := phi_val_for(g, rp3, pre)
            mut fin := lv_emit(
                g, rb, is_flt(g, g.i_ty[rp3]) ? OP_FADD : OP_ADD, g.i_ty[rp3], init, hv
            )
            if r.rinv[k3] >= 0:
                rt := g.i_ty[rp3]
                mut cn := lv_emit(g, rb, OP_SUB, ivt, xiv, r.vstart)
                if ivt != rt:
                    cn = lv_emit(g, rb, rt == T_I64 ? OP_SEXT : OP_TRUNC, rt, cn, -1)
                    g.i_x[g.v_def[cn]] = ivt
                end
                ml := lv_emit(g, rb, OP_MUL, rt, cn, lv_hm(r, r.rinv[k3]))
                fin = lv_emit(g, rb, OP_ADD, rt, fin, ml)
            end
            acc0.Push(fin)
        end
    end
    mut skip := -1
    if r.shape == 1:
        rbj := ins_new(g, OP_BR, T_VOID)
        g.i_b[rbj] = h
        ins_append(g, rb, rbj)
    else:
        skip = new_blk(g)
        viv64b := lv_sext_app(g, rb, xiv)
        lim64b := r.lim
        mut lw := lim64b
        if g.v_ty[lim64b] != T_I64:
            lw = lv_sext_app(g, rb, lim64b)
        end
        rc := lv_emit(g, rb, OP_ICMP, T_I1, viv64b, lw)
        g.i_x[g.v_def[rc]] = r.sle ? CC_SLE : CC_SLT
        rct := ins_new(g, OP_CBR, T_VOID)
        g.i_a[rct] = rc
        g.i_b[rct] = h
        g.i_c[rct] = skip
        g.i_f[rct] = IF_NOVEC
        ins_append(g, rb, rct)
        sj := ins_new(g, OP_BR, T_VOID)
        g.i_b[sj] = r.exitb
        ins_append(g, skip, sj)
    end
    mut j := g.b_first[h]
    until j >= 0 and g.i_op[j] == OP_PHI:
        lv_phi_repred(g, j, pre, ck)
        mut nv := j == r.ivp ? xiv : phi_val_for(g, j, ck)
        if j == r.divp:
            nv = lv_emit_before(g, g.b_last[rb], OP_SUB, ivt, r.rsum, xiv)
        end
        repeat r.reds.Len() in k4:
            if r.reds[k4] == j:
                nv = acc0[k4]
            end
        end
        lv_phi_add(g, j, nv, rb)
        j = g.i_next[j]
    end
    if r.shape == 0:
        mut outs := Vector {} as Vector<int>
        mut repl := Vector {} as Vector<int>
        if g.i_res[r.ivn] >= 0:
            outs.Push(g.i_res[r.ivn])
            repl.Push(xiv)
        end
        repeat r.rnext.Len() in k5:
            outs.Push(g.i_res[r.rnext[k5]])
            repl.Push(acc0[k5])
        end
        each bi in r.body:
            if g.i_res[bi] >= 0 and
                (g.i_op[bi] == OP_TRUNC or g.i_op[bi] == OP_SEXT or g.i_op[bi] == OP_ZEXT) and
                g.i_a[bi] == g.i_res[r.ivn]:
                cv := ins_new(g, g.i_op[bi], g.i_ty[bi])
                dv_taint(g, bi)
                g.i_a[cv] = xiv
                g.i_x[cv] = g.i_x[bi]
                cvv := new_res(g, cv)
                ins_before(g, g.b_last[skip], cv)
                outs.Push(g.i_res[bi])
                repl.Push(cvv)
            end
        end
        repeat outs.Len() in k6:
            ov := outs[k6]
            np := ins_new(g, OP_PHI, g.v_ty[ov])
            g.i_ps[np] = g.pool.Len()
            g.i_pcount[np] = 2
            g.pool.Push(ov)
            g.pool.Push(h)
            g.pool.Push(repl[k6])
            g.pool.Push(skip)
            npv := new_res(g, np)
            first := g.b_first[r.exitb]
            if first >= 0:
                ins_before(g, first, np)
            else:
                ins_append(g, r.exitb, np)
            end
            lv_replace_uses(g, r, ov, npv, np)
        end
        outs.Free()
        repl.Free()
    end
    vaccs.Free()
    vpools.Free()
    acc0.Free()
end
