package nativegen

const RAX := 0
const RCX := 1
const RDX := 2
const RBX := 3
const RSP := 4
const RBP := 5
const RSI := 6
const RDI := 7
const R8 := 8
const R9 := 9
const R10 := 10
const R11 := 11
const R12 := 12
const R13 := 13
const R14 := 14
const R15 := 15
const XMM0 := 16
const XMM14 := 30
const XMM15 := 31
const VBASE := 32

const MK_NONE := 0
const MK_BI := 1
const MK_RIP := 2
const MK_FRAME := 3
const MK_GOT := 4
const MK_ARG := 5

const M_NOP := 0
const M_MOV_RR := 1
const M_MOV_RI := 2
const M_LD := 3
const M_LDZX := 4
const M_LDSX := 5
const M_ST := 6
const M_STI := 7
const M_LEA := 8
const M_ALU_RR := 9
const M_ALU_RI := 10
const M_ALU_RM := 11
const M_TEST_RR := 12
const M_TEST_RI := 13
const M_IMUL_RR := 14
const M_IMUL_RRI := 15
const M_SHIFT_RI := 16
const M_SHIFT_RC := 17
const M_UNARY := 18
const M_CQO := 19
const M_DIV := 20
const M_SETCC := 21
const M_MOVZX_RR := 22
const M_MOVSX_RR := 23
const M_CMOV := 24
const M_JMP := 25
const M_JCC := 26
const M_CALL := 27
const M_CALLR := 28
const M_RET := 29
const M_UD2 := 30
const M_XCHG := 31
const M_LXADD := 32
const M_LCMPXCHG := 33
const M_MFENCE := 34
const M_FMOV_RR := 35
const M_FLD := 36
const M_FST := 37
const M_FOP_RR := 38
const M_FOP_RM := 39
const M_UCOMI := 40
const M_CVTSI2F := 41
const M_CVTF2SI := 42
const M_CVTF2F := 43
const M_MOVQ_XG := 44
const M_MOVQ_GX := 45
const M_XORPS := 46
const M_COPY := 47
const M_LABEL := 48
const M_ALU_MI := 49
const M_ALU_MR := 50
const M_LDGOT := 51
const M_ANDPS := 52
const M_SQRT := 53
const M_MULHI := 54
const M_VLD := 55
const M_VST := 56
const M_VOP_RR := 57
const M_SHUFPS := 58
const M_UNPCKLPD := 59
const M_PSHUFD := 60
const M_VSHI := 61
const M_VLD32 := 62
const M_VST32 := 63
const M_X87 := 64
const M_ARM_SODD := 65

const ALU_ADD := 0
const ALU_OR := 1
const ALU_SBB := 3
const ALU_ADC := 2
const ALU_SBBCMP := 9
const ALU_ADDCMP := 10
const ALU_AND := 4
const ALU_SUB := 5
const ALU_XOR := 6
const ALU_CMP := 7

const SH_ROR := 1
const SH_SHL := 4
const SH_SHR := 5
const SH_SAR := 7

const UN_NOT := 2
const UN_NEG := 3

const X_O := 0
const X_NO := 1
const X_B := 2
const X_AE := 3
const X_E := 4
const X_NE := 5
const X_BE := 6
const X_A := 7
const X_S := 8
const X_NS := 9
const X_P := 10
const X_NP := 11
const X_L := 12
const X_GE := 13
const X_LE := 14
const X_G := 15

const FO_ADD := 88
const FO_MUL := 89
const FO_SUB := 92
const FO_DIV := 94

pub struct Mc:
    pub op: Vector<int> = Vector {}
    pub sz: Vector<int> = Vector {}
    pub sz2: Vector<int> = Vector {}
    pub r0: Vector<int> = Vector {}
    pub r1: Vector<int> = Vector {}
    pub imm: Vector<i64> = Vector {}
    pub mk: Vector<int> = Vector {}
    pub mb: Vector<int> = Vector {}
    pub mi: Vector<int> = Vector {}
    pub ms: Vector<int> = Vector {}
    pub md: Vector<i64> = Vector {}
    pub msym: Vector<int> = Vector {}
    pub cc: Vector<int> = Vector {}
    pub tgt: Vector<int> = Vector {}
    pub loc: Vector<int> = Vector {}
    pub dv: Vector<int> = Vector {}
    pub bstart: Vector<int> = Vector {}
    pub bend: Vector<int> = Vector {}
    pub lorder: Vector<int> = Vector {}
    pub nlabels: int = 0
    pub vcls: Vector<int> = Vector {}
    pub vloc: Vector<int> = Vector {}
    pub vslot: Vector<int> = Vector {}
    pub vhint: Vector<int> = Vector {}
    pub vphint: Vector<int> = Vector {}
    pub vwide: Vector<bool> = Vector {}
    pub vstart: Vector<int> = Vector {}
    pub vend: Vector<int> = Vector {}
    pub fs_size: Vector<int> = Vector {}
    pub fs_align: Vector<int> = Vector {}
    pub fs_off: Vector<int> = Vector {}
    pub fs_temp: Vector<bool> = Vector {}
    pub fs_alias: Vector<int> = Vector {}
    pub out_args: int = 0
    pub callee_used: Vector<int> = Vector {}
    pub frame_size: int = 0
    pub win_fp: int = 0
    pub pro_push: Vector<int> = Vector {}
    pub pro_alloc: int = 0
    pub pro_fp: int = 0
    pub pro_xmm: Vector<int> = Vector {}
    pub pro_len: int = 0
    pub has_call: bool = false
    pub fpo: bool = false
    pub dv_spb: i64 = 0
    pub lalign: Vector<bool> = Vector {}
    pub fpo_pad: int = 0
    pub fsave: int = 0
    pub n: int = 0
end

pub struct Mem:
    pub k: int = 0
    pub b: int = 0 - 1
    pub i: int = 0 - 1
    pub s: int = 1
    pub d: i64 = 0 as i64
    pub sym: int = 0 - 1
end

func mc_reset(g &: Ng):
    g.mc.op.clear()
    g.mc.sz.clear()
    g.mc.sz2.clear()
    g.mc.r0.clear()
    g.mc.r1.clear()
    g.mc.imm.clear()
    g.mc.mk.clear()
    g.mc.mb.clear()
    g.mc.mi.clear()
    g.mc.ms.clear()
    g.mc.md.clear()
    g.mc.msym.clear()
    g.mc.cc.clear()
    g.mc.tgt.clear()
    g.mc.loc.clear()
    g.mc.dv.clear()
    g.mc_dv = 0 - 1
    g.mc.bstart.clear()
    g.mc.bend.clear()
    g.mc.lorder.clear()
    g.mc.vcls.clear()
    g.mc.vloc.clear()
    g.mc.vslot.clear()
    g.mc.vhint.clear()
    g.mc.vphint.clear()
    g.mc.vwide.clear()
    g.mc.vstart.clear()
    g.mc.vend.clear()
    g.mc.fs_size.clear()
    g.mc.fs_align.clear()
    g.mc.fs_off.clear()
    g.mc.fs_temp.clear()
    g.mc.fs_alias.clear()
    g.mc.callee_used.clear()
    g.mc.out_args = 0
    g.mc.frame_size = 0
    g.mc.has_call = false
    g.mc.nlabels = g.b_first.len()
    repeat 32:
        g.mc.vcls.push(0)
        g.mc.vloc.push(0 - 1)
        g.mc.vslot.push(0 - 1)
        g.mc.vhint.push(0 - 1)
        g.mc.vphint.push(0 - 1)
        g.mc.vwide.push(false)
    end
    repeat 16 in k:
        g.mc.vcls[16 + k] = 1
    end
end

func vnew(g &: Ng, cls: int): int:
    v := g.mc.vcls.len()
    g.mc.vcls.push(cls)
    g.mc.vloc.push(0 - 1)
    g.mc.vslot.push(0 - 1)
    g.mc.vhint.push(0 - 1)
    g.mc.vphint.push(0 - 1)
    g.mc.vwide.push(false)
    ret v
end

func gpr(g &: Ng): int:
    ret vnew(g, 0)
end

func xmm(g &: Ng): int:
    ret vnew(g, 1)
end

func new_slot(g &: Ng, size: int, al: int): int:
    id := g.mc.fs_size.len()
    g.mc.fs_size.push(size)
    g.mc.fs_align.push(al)
    g.mc.fs_off.push(0)
    g.mc.fs_temp.push(true)
    g.mc.fs_alias.push(0 - 1)
    ret id
end

func new_label(g &: Ng): int:
    l := g.mc.nlabels
    g.mc.nlabels += 1
    ret l
end

func mi_new(g &: Ng, op: int, sz: int): int:
    i := g.mc.op.len()
    g.mc.op.push(op)
    g.mc.sz.push(sz)
    g.mc.sz2.push(0)
    g.mc.r0.push(0 - 1)
    g.mc.r1.push(0 - 1)
    g.mc.imm.push(0 as i64)
    g.mc.mk.push(MK_NONE)
    g.mc.mb.push(0 - 1)
    g.mc.mi.push(0 - 1)
    g.mc.ms.push(1)
    g.mc.md.push(0 as i64)
    g.mc.msym.push(0 - 1)
    g.mc.cc.push(0)
    g.mc.tgt.push(0 - 1)
    g.mc.loc.push(g.mc_loc)
    g.mc.dv.push(g.mc_dv)
    ret i
end

func set_mem(g &: Ng, i: int, m: Mem):
    g.mc.mk[i] = m.k
    g.mc.mb[i] = m.b
    g.mc.mi[i] = m.i
    g.mc.ms[i] = m.s
    g.mc.md[i] = m.d
    g.mc.msym[i] = m.sym
end

func mem_bi(b: int, d: i64): Mem:
    ret Mem { k = MK_BI, b = b, d = d }
end

func e_rr(g &: Ng, op: int, sz: int, r0: int, r1: int): int:
    i := mi_new(g, op, sz)
    g.mc.r0[i] = r0
    g.mc.r1[i] = r1
    ret i
end

func e_ri(g &: Ng, op: int, sz: int, r0: int, imm: i64): int:
    i := mi_new(g, op, sz)
    g.mc.r0[i] = r0
    g.mc.imm[i] = imm
    ret i
end

func e_rm(g &: Ng, op: int, sz: int, r0: int, m: Mem): int:
    i := mi_new(g, op, sz)
    g.mc.r0[i] = r0
    set_mem(g, i, m)
    ret i
end

func e_mr(g &: Ng, op: int, sz: int, m: Mem, r1: int): int:
    i := mi_new(g, op, sz)
    g.mc.r1[i] = r1
    set_mem(g, i, m)
    ret i
end

func e_copy(g &: Ng, dst: int, src: int): int:
    if dst == src:
        ret 0 - 1
    end
    i := e_rr(g, M_COPY, 8, dst, src)
    if dst >= VBASE and src < VBASE:
        if g.mc.vhint[dst] < 0:
            g.mc.vhint[dst] = src
        end
        if g.mc.vphint[dst] < 0:
            g.mc.vphint[dst] = src
        end
    end
    if src >= VBASE and dst < VBASE:
        if g.mc.vhint[src] < 0:
            g.mc.vhint[src] = dst
        end
        if g.mc.vphint[src] < 0:
            g.mc.vphint[src] = dst
        end
    end
    if dst >= VBASE and src >= VBASE:
        if g.mc.vhint[dst] < 0:
            g.mc.vhint[dst] = src
        end
        if g.mc.vhint[src] < 0:
            g.mc.vhint[src] = dst
        end
    end
    ret i
end

func e_movi(g &: Ng, r: int, v: i64): int:
    mut sz := 8
    if v >= (0 as i64) and v <= (0xFFFFFFFF as i64):
        sz = 4
    end
    ret e_ri(g, M_MOV_RI, sz, r, v)
end

func e_alu(g &: Ng, sub: int, sz: int, r0: int, r1: int): int:
    i := e_rr(g, M_ALU_RR, sz, r0, r1)
    g.mc.cc[i] = sub
    ret i
end

func e_alui(g &: Ng, sub: int, sz: int, r0: int, imm: i64): int:
    i := e_ri(g, M_ALU_RI, sz, r0, imm)
    g.mc.cc[i] = sub
    ret i
end

func e_jmp(g &: Ng, lbl: int): int:
    i := mi_new(g, M_JMP, 0)
    g.mc.tgt[i] = lbl
    ret i
end

func e_jcc(g &: Ng, cc: int, lbl: int): int:
    i := mi_new(g, M_JCC, 0)
    g.mc.cc[i] = cc
    g.mc.tgt[i] = lbl
    ret i
end

func e_label(g &: Ng, lbl: int): int:
    i := mi_new(g, M_LABEL, 0)
    g.mc.tgt[i] = lbl
    ret i
end

func e_setcc(g &: Ng, cc: int, r: int): int:
    i := mi_new(g, M_SETCC, 1)
    g.mc.r0[i] = r
    g.mc.cc[i] = cc
    ret i
end

func inv_cc(cc: int): int:
    ret cc ^ 1
end

func is_imm32(v: i64): bool:
    ret v >= (0 - 2147483648 as i64) and v <= (2147483647 as i64)
end

func reg_cls(r: int, g &: Ng): int:
    ret g.mc.vcls[r]
end

func mem_regs(g &: Ng, i: int, uses &: Vector<int>):
    k := g.mc.mk[i]
    if k == MK_BI:
        if g.mc.mb[i] >= 0:
            uses.push(g.mc.mb[i])
        end
        if g.mc.mi[i] >= 0:
            uses.push(g.mc.mi[i])
        end
    else k == MK_FRAME and g.mc.mi[i] >= 0:
        uses.push(g.mc.mi[i])
    end
end

func mi_regs(g &: Ng, i: int, uses &: Vector<int>, defs &: Vector<int>):
    uses.clear()
    defs.clear()
    op := g.mc.op[i]
    r0 := g.mc.r0[i]
    r1 := g.mc.r1[i]
    switch op:
        M_MOV_RR, M_COPY, M_MOVZX_RR, M_MOVSX_RR, M_FMOV_RR, M_CVTSI2F, M_CVTF2SI, M_CVTF2F, M_MOVQ_XG, M_MOVQ_GX, M_SQRT:
            uses.push(r1)
            defs.push(r0)
            break
        end
        M_ARM_SODD:
            uses.push(r1)
            if g.mc.cc[i] == 0:
                uses.push(r0)
            else:
                defs.push(r0)
            end
            break
        end
        M_MOV_RI, M_SETCC:
            defs.push(r0)
            if op == M_SETCC and g.mc.sz[i] > 1:
                uses.push(r0)
            end
            break
        end
        M_LD, M_LDZX, M_LDSX, M_LEA, M_FLD, M_LDGOT, M_VLD, M_VLD32:
            mem_regs(g, i, uses)
            defs.push(r0)
            break
        end
        M_ST, M_FST, M_VST, M_VST32:
            mem_regs(g, i, uses)
            uses.push(r1)
            break
        end
        M_STI, M_ALU_MI, M_X87:
            mem_regs(g, i, uses)
            break
        end
        M_ALU_MR:
            mem_regs(g, i, uses)
            uses.push(r1)
            break
        end
        M_PSHUFD:
            uses.push(r1)
            defs.push(r0)
            break
        end
        M_ALU_RR, M_IMUL_RR, M_FOP_RR, M_XORPS, M_ANDPS, M_VOP_RR, M_SHUFPS, M_UNPCKLPD:
            if r0 == r1 and (op == M_XORPS or (op == M_ALU_RR and g.mc.cc[i] == ALU_XOR)):
                defs.push(r0)
                break
            end
            uses.push(r0)
            uses.push(r1)
            if not (op == M_ALU_RR and (g.mc.cc[i] == ALU_CMP or g.mc.cc[i] == ALU_SBBCMP or g.mc.cc[i] == ALU_ADDCMP)):
                defs.push(r0)
            end
            break
        end
        M_ALU_RI, M_SHIFT_RI, M_UNARY, M_VSHI:
            uses.push(r0)
            if not (op == M_ALU_RI and (g.mc.cc[i] == ALU_CMP or g.mc.cc[i] == ALU_ADDCMP)):
                defs.push(r0)
            end
            break
        end
        M_ALU_RM, M_FOP_RM:
            mem_regs(g, i, uses)
            uses.push(r0)
            if not (op == M_ALU_RM and g.mc.cc[i] == ALU_CMP):
                defs.push(r0)
            end
            break
        end
        M_TEST_RR, M_UCOMI:
            uses.push(r0)
            uses.push(r1)
            break
        end
        M_TEST_RI:
            uses.push(r0)
            break
        end
        M_IMUL_RRI:
            uses.push(r1)
            defs.push(r0)
            break
        end
        M_SHIFT_RC:
            uses.push(r0)
            uses.push(RCX)
            defs.push(r0)
            break
        end
        M_CQO:
            uses.push(RAX)
            defs.push(RDX)
            break
        end
        M_DIV:
            uses.push(RAX)
            uses.push(RDX)
            uses.push(r1)
            defs.push(RAX)
            defs.push(RDX)
            break
        end
        M_MULHI:
            uses.push(RAX)
            uses.push(r1)
            defs.push(RAX)
            defs.push(RDX)
            break
        end
        M_CMOV:
            uses.push(r0)
            uses.push(r1)
            defs.push(r0)
            break
        end
        M_CALL, M_CALLR:
            if op == M_CALLR:
                uses.push(r1)
            end
            mask := g.mc.imm[i]
            repeat 32 in k:
                if ((mask >> (k as i64)) & (1 as i64)) != (0 as i64):
                    uses.push(k)
                end
            end
            break
        end
        M_RET:
            mask2 := g.mc.imm[i]
            repeat 32 in k2:
                if ((mask2 >> (k2 as i64)) & (1 as i64)) != (0 as i64):
                    uses.push(k2)
                end
            end
            break
        end
        M_XCHG, M_LXADD:
            mem_regs(g, i, uses)
            uses.push(r0)
            defs.push(r0)
            break
        end
        M_LCMPXCHG:
            mem_regs(g, i, uses)
            uses.push(r1)
            uses.push(RAX)
            defs.push(RAX)
            break
        end
    end
end
