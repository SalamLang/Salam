package nativegen

func fold_pass(g &: Ng, cfg_changed &: bool): bool:
    mut changed := false
    repl_grow(g)
    each b in g.b_rpo:
        mut i := g.b_first[b]
        until i >= 0:
            nx := g.i_next[i]
            remap_ins(g, i)
            op := g.i_op[i]
            mut ch := false
            if op == OP_LOAD:
                ch = fold_ro_load(g, i)
            end
            if op == OP_CALL:
                ch = fold_strlen(g, i) or fold_memcpy(g, i)
            end
            if not ch and (op == OP_SELECT or op == OP_AND):
                ch = byte_norm(g, i) or crange_select(g, i)
            end
            if op == OP_SREM or op == OP_UREM:
                ch = rem_rem(g, i)
            end
            if not ch and (op == OP_UREM or op == OP_UDIV):
                ch = udiv_pow2(g, i)
            end
            if not ch and (op == OP_SDIV or op == OP_SREM) and g.dom_ok:
                ch = exact_sdiv(g, i)
                if not ch:
                    ch = signed_to_unsigned(g, i)
                end
            end
            if ch:
                changed = true
            else op >= OP_SDIV and op <= OP_UREM and not g.off_range and fold_rem_range(g, i):
                ch = true
            else op >= OP_ADD and op <= OP_ASHR:
                ch = fold_bin(g, i)
                if ch:
                    g.i_f[i] &= (0 - 1 - IF_NSW)
                else op == OP_ADD or op == OP_SUB:
                    ch = add_reassoc(g, i)
                else op == OP_MUL:
                    ch = mul_reassoc(g, i)
                else (op == OP_XOR or op == OP_OR) and not g.off_bits:
                    ch = bit_simplify(g, i)
                end
                if not ch and (op == OP_SHL or op == OP_SUB) and not g.off_bits and g.i_op[i] == op:
                    ch = neg_fold(g, i)
                end
            else op == OP_ICMP:
                ch = fold_icmp(g, i)
                if not ch and g.dom_ok and g.i_op[i] == OP_ICMP:
                    ch = fold_icmp_range(g, i)
                end
                if not ch and g.i_op[i] == OP_ICMP:
                    ch = icmp_add_one(g, i)
                end
                if not ch and not g.off_zxcmp and g.i_op[i] == OP_ICMP:
                    ch = icmp_zext_narrow(g, i)
                end
            else op >= OP_SEXT and op <= OP_FPTRUNC:
                ch = fold_cast(g, i)
                if not ch and g.dom_ok and not g.off_range and
                    (g.i_op[i] == OP_SEXT or g.i_op[i] == OP_ZEXT):
                    ch = ext_trunc_range(g, i)
                end
                if not ch and not g.off_sxa and g.i_op[i] == OP_SEXT:
                    ch = sext_add(g, i)
                end
            else op == OP_SELECT:
                ch = fold_select(g, i)
                if not ch and g.i_op[i] == OP_SELECT:
                    ch = select_bool(g, i)
                end
                if not ch and g.i_op[i] == OP_SELECT and not g.off_bits:
                    ch = sign_select(g, i)
                end
                if not ch and g.i_op[i] == OP_SELECT and not g.off_selhoist:
                    ch = select_add_hoist(g, i)
                end
            else op == OP_ADDR:
                ch = fold_addr(g, i)
            else op == OP_EXTV:
                ch = fold_extv(g, i)
            else op == OP_INSV:
                ch = fold_insv_zero(g, i) or fold_insv_rebuild(g, i)
            else op == OP_FDIV:
                ch = fdiv_pow2(g, i)
            else op == OP_FMUL:
                ch = fmul_merge(g, i)
            else op == OP_CBR:
                if fold_cbr(g, i):
                    ch = true
                    cfg_changed = true
                else g.dom_ok and g.i_b[i] != g.i_c[i]:
                    mut kv := false
                    if dom_cond_known(g, g.i_a[i], g.i_blk[i], kv):
                        g.i_a[i] = const_int(g, T_I1, kv ? (1 as i64) : (0 as i64))
                        _fc := fold_cbr(g, i)
                        ch = true
                        cfg_changed = true
                    end
                end
            end
            if ch:
                changed = true
            end
            i = nx
        end
    end
    ret changed
end

func opt_rounds(g &: Ng):
    mut rounds := 0
    until rounds < 6:
        mut cfgc := false
        count_uses(g)
        build_dom(g)
        g.dom_ok = true
        mut changed := fold_pass(g, cfgc)
        g.dom_ok = false
        if cfgc:
            ensure_terms(g)
            build_cfg(g)
        end
        if merge_blocks(g):
            build_cfg(g)
            changed = true
        end
        if not g.off_thread and thread_jumps(g):
            build_cfg(g)
            changed = true
        end
        if not g.off_range and range_fold(g):
            changed = true
        end
        if sink_loads(g):
            changed = true
        end
        if not g.off_ifc and if_convert(g):
            build_cfg(g)
            changed = true
        end
        if changed:
            remap_all(g)
            simplify_phis(g)
        else:
            break
        end
        rounds++
    end
end

func optimize(g &: Ng):
    g.want_licm = false
    if not g.off_swt:
        mut ns := 0
        until ns < 8 and switch_tables(g):
            ns++
        end
    end
    opt_rounds(g)
    mut af := false
    if not g.off_afwd:
        af = agg_forward(g)
    end
    if (not g.off_aload and agg_scalarize(g)) or af:
        opt_rounds(g)
    end
    if not g.off_unroll:
        mut nu := 0
        until nu < 8 and unroll_loops(g):
            opt_rounds(g)
            nu++
        end
    end
    if not g.off_lpeel:
        mut npl := 0
        until npl < 8 and peel_loops(g):
            opt_rounds(g)
            npl++
        end
    end
    if not g.off_licm and licm(g):
        remap_all(g)
        opt_rounds(g)
    end
    if not g.off_lpro and lpro(g):
        opt_rounds(g)
    end
    if not g.off_spromo and spromo(g):
        opt_rounds(g)
    end
    if not g.off_unswitch:
        mut nu2 := 0
        mut uch := false
        mut urun := UswRun {}
        urun.budget = 4 * USW_MAX_SIZE
        until nu2 < (g.off_uswsel ? 4 : 8) and unswitch_loops(g, urun):
            nu2++
            uch = true
            opt_rounds(g)
        end
        urun.xs.Free()
        if uch and not g.off_licm and licm(g):
            remap_all(g)
            opt_rounds(g)
        end
    end
    if not g.off_iss:
        mut ni := 0
        mut ich := false
        until ni < 4 and index_split(g):
            ni++
            ich = true
        end
        if ich:
            simplify_phis(g)
            opt_rounds(g)
        end
    end
    mut gch := false
    if not g.off_gvn and gvn(g):
        gch = true
        mut cfg0 := false
        count_uses(g)
        if fold_pass(g, cfg0):
            remap_all(g)
        end
        if cfg0:
            ensure_terms(g)
            build_cfg(g)
            simplify_phis(g)
        end
        dce(g)
        if not g.off_ifc and if_convert(g):
            build_cfg(g)
            remap_all(g)
            simplify_phis(g)
            opt_rounds(g)
        end
    end
    if not g.off_aload:
        af1 := not g.off_afwd and agg_forward(g)
        sc1 := agg_scalarize(g)
        da1 := dead_allocas(g)
        if sc1 or da1 or af1:
            opt_rounds(g)
        end
    end
    if not g.off_lsf and local_store_fwd(g):
        opt_rounds(g)
    end
    if gch and not g.off_unroll:
        mut nu3 := 0
        until nu3 < 8 and unroll_loops(g):
            opt_rounds(g)
            nu3++
        end
    end
    if not g.off_lle:
        mut nl := 0
        mut lch := false
        until nl < 8 and loop_load_elim(g):
            nl++
            lch = true
        end
        if lch:
            simplify_phis(g)
            opt_rounds(g)
        end
    end
    if not g.off_dbits and demanded_bits(g):
        simplify_phis(g)
        opt_rounds(g)
    end
    if not g.off_idiom and copy_idiom(g):
        remap_all(g)
        simplify_phis(g)
        opt_rounds(g)
    end
    if not g.off_rvec and reduce_vectorize(g):
        remap_all(g)
        simplify_phis(g)
        opt_rounds(g)
    end
    if not g.off_lvec:
        dce(g)
        mut nlv := 0
        mut lvch := false
        until nlv < 8 and loop_vectorize(g):
            nlv++
            lvch = true
        end
        if lvch:
            remap_all(g)
            simplify_phis(g)
            opt_rounds(g)
        end
    end
    if not g.off_runroll:
        mut nr := 0
        mut rch := false
        until nr < 6 and runtime_unroll(g):
            nr++
            rch = true
        end
        if rch:
            simplify_phis(g)
            opt_rounds(g)
        end
    end
    if not g.off_widen and g.wsz == 8 and widen_ivs(g):
        opt_rounds(g)
        if not g.off_winv:
            g.want_licm = true
        end
    end
    if not g.off_lsr and lsr(g):
        simplify_phis(g)
        opt_rounds(g)
        if not g.off_licm and licm(g):
            remap_all(g)
            opt_rounds(g)
        end
    end
    if not g.off_slp:
        _v := slp(g)
    end
    if not g.off_p2div:
        _p2 := lower_pow2_divs(g)
    end
    mut gch2 := false
    if not g.off_gvn and gvn(g):
        gch2 = true
        mut cfg2 := false
        count_uses(g)
        if fold_pass(g, cfg2):
            remap_all(g)
        end
        if cfg2:
            ensure_terms(g)
            build_cfg(g)
            simplify_phis(g)
        end
    end
    if not g.off_aload:
        _sc2 := agg_scalarize(g)
        _da2 := dead_allocas(g)
    end
    if gch2 and not g.off_unroll:
        mut nu4 := 0
        until nu4 < 8 and unroll_loops(g):
            opt_rounds(g)
            nu4++
        end
        if nu4 > 0 and not g.off_lsf and local_store_fwd(g):
            opt_rounds(g)
        end
        if nu4 > 0 and gvn(g):
            mut cfg4 := false
            count_uses(g)
            if fold_pass(g, cfg4):
                remap_all(g)
            end
            if cfg4:
                ensure_terms(g)
                build_cfg(g)
                simplify_phis(g)
            end
        end
    end
    if g.want_licm and not g.off_licm:
        g.want_licm = false
        if licm(g):
            remap_all(g)
            opt_rounds(g)
        end
    end
    if not g.off_mlp and merge_load_phis(g):
        mut cfg3 := false
        count_uses(g)
        if fold_pass(g, cfg3):
            remap_all(g)
        end
    end
    if not g.off_llphi and loop_load_phis(g):
        mut cfg5 := false
        count_uses(g)
        if fold_pass(g, cfg5):
            remap_all(g)
        end
    end
    if not g.off_mmchain:
        _mm := mm_chain(g)
    end
    if not g.off_dse:
        _ds := dead_stores(g)
    end
    dce(g)
    if not g.off_dloop:
        mut ndl := 0
        until ndl < 8 and dead_loops(g):
            simplify_phis(g)
            dce(g)
            ndl++
        end
    end
    if not g.off_andbr and and_branches(g):
        dce(g)
    end
    if not g.off_sink:
        _sk := sink_pass(g)
    end
    if not g.off_fch:
        _fh := fcmp_const_hoist(g)
    end
    if not g.off_xsplit:
        _xs := exit_split(g)
    end
end
