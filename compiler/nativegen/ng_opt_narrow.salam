package nativegen

func p2_ins(g &: Ng, at: int, op: int, t: int, a: int, b: int): int:
    i := ins_new(g, op, t)
    g.i_a[i] = a
    g.i_b[i] = b
    ins_before(g, at, i)
    ret new_res(g, i)
end

func lower_pow2_divs(g &: Ng): bool:
    mut changed := false
    repl_grow(g)
    each b in g.b_rpo:
        mut i := g.b_first[b]
        until i >= 0:
            nx := g.i_next[i]
            op := g.i_op[i]
            if (op == OP_SDIV or op == OP_SREM) and g.i_res[i] >= 0 and is_cint(g, g.i_b[i]):
                t := g.i_ty[i]
                bits := int_bits(g, t)
                dv := norm_int(g, t, g.v_i[g.i_b[i]])
                if (bits == 32 or bits == 64) and dv > (1 as i64):
                    k := log2_exact(dv as u64)
                    if k >= 1 and k < bits - 1:
                        x := g.i_a[i]
                        ci := ins_new(g, OP_ICMP, T_I1)
                        g.i_a[ci] = x
                        g.i_b[ci] = const_int(g, t, 0 as i64)
                        g.i_x[ci] = CC_SLT
                        ins_before(g, i, ci)
                        cv := new_res(g, ci)
                        xb := p2_ins(g, i, OP_ADD, t, x, const_int(g, t, dv - (1 as i64)))
                        si := ins_new(g, OP_SELECT, t)
                        g.i_a[si] = cv
                        g.i_b[si] = xb
                        g.i_c[si] = x
                        ins_before(g, i, si)
                        sv := new_res(g, si)
                        mut r := -1
                        if op == OP_SDIV:
                            r = p2_ins(g, i, OP_ASHR, t, sv, const_int(g, t, k as i64))
                        else:
                            m := p2_ins(g, i, OP_AND, t, sv, const_int(g, t, (0 as i64) - dv))
                            r = p2_ins(g, i, OP_SUB, t, x, m)
                        end
                        repl_grow(g)
                        g.v_repl[g.i_res[i]] = r
                        ins_unlink(g, i)
                        changed = true
                    end
                end
            end
            i = nx
        end
    end
    if changed:
        remap_all(g)
    end
    ret changed
end

func nd_u32(g &: Ng, v: int, blk: int, min: i64): bool:
    mut lo := 0 as i64
    mut hi := 0 as i64
    ret val_range(g, v, blk, 0, lo, hi) and lo >= min and hi <= (0xFFFFFFFF as i64)
end

func nd_to32(g &: Ng, at: int, v: int): int:
    if is_cint(g, v):
        ret const_int(g, T_I32, norm_int(g, T_I64, g.v_i[v]))
    end
    r := p2_ins(g, at, OP_TRUNC, T_I32, v, -1)
    g.i_x[g.v_def[r]] = T_I64
    ret r
end

func narrow_div64(g &: Ng): bool:
    count_uses(g)
    build_dom(g)
    mut changed := false
    mut stk := Vector {} as Vector<int>
    repl_grow(g)
    each b in g.b_rpo:
        mut i := g.b_first[b]
        until i >= 0:
            nx := g.i_next[i]
            op := g.i_op[i]
            if (op == OP_UDIV or op == OP_UREM or op == OP_SDIV or op == OP_SREM) and
                g.i_ty[i] == T_I64 and g.i_res[i] >= 0:
                g.i_a[i] = resolve(g, g.i_a[i])
                g.i_b[i] = resolve(g, g.i_b[i])
            end
            if (op == OP_UDIV or op == OP_UREM or op == OP_SDIV or op == OP_SREM) and
                g.i_ty[i] == T_I64 and g.i_res[i] >= 0 and nd_u32(
                    g, g.i_a[i], b, 0 as i64
                ) and nd_u32(g, g.i_b[i], b, 1 as i64):
                a32 := nd_to32(g, i, g.i_a[i])
                b32 := nd_to32(g, i, g.i_b[i])
                q := p2_ins(
                    g, i, (op == OP_UDIV or op == OP_SDIV) ? OP_UDIV : OP_UREM, T_I32, a32, b32
                )
                r := p2_ins(g, i, OP_ZEXT, T_I64, q, -1)
                g.i_x[g.v_def[r]] = T_I32
                repl_grow(g)
                g.v_repl[g.i_res[i]] = r
                ins_unlink(g, i)
                changed = true
            else (op == OP_SDIV or op == OP_SREM) and g.i_ty[i] == T_I64 and g.i_res[i] >= 0 and
                nd_signfree(
                    g, i, b, stk
                ):
                g.i_op[i] = op == OP_SDIV ? OP_UDIV : OP_UREM
                changed = true
            else (op == OP_SITOFP or op == OP_UITOFP) and g.i_res[i] >= 0 and
                g.v_ty[g.i_a[i]] == T_I64 and nd_fits32(
                    g, resolve(g, g.i_a[i]), b, op == OP_SITOFP
                ):
                t32 := nd_to32(g, i, resolve(g, g.i_a[i]))
                f := p2_ins(g, i, OP_SITOFP, g.i_ty[i], t32, -1)
                g.i_x[g.v_def[f]] = T_I32
                repl_grow(g)
                g.v_repl[g.i_res[i]] = f
                ins_unlink(g, i)
                changed = true
            end
            i = nx
        end
    end
    stk.Free()
    if changed:
        remap_all(g)
    end
    ret changed
end

func nd_signfree(g &: Ng, i: int, blk: int, stk &: Vector<int>): bool:
    g.nd_budget = 400
    ret nd_nonneg(g, g.i_a[i], blk, 0, stk) and nd_nonneg(g, g.i_b[i], blk, 0, stk)
end

func nd_nonneg(g &: Ng, v: int, blk: int, depth: int, stk &: Vector<int>): bool:
    if v < 0:
        ret false
    end
    if is_cint(g, v):
        ret norm_int(g, g.v_ty[v], g.v_i[v]) >= (0 as i64)
    end
    if g.v_kind[v] != VK_INS or depth > 48 or g.nd_budget <= 0:
        ret false
    end
    g.nd_budget--
    each s in stk:
        if s == v:
            ret true
        end
    end
    mut lo := 0 as i64
    mut hi := 0 as i64
    if val_range(g, v, blk, 0, lo, hi) and lo >= (0 as i64):
        ret true
    end
    d := g.v_def[v]
    op := g.i_op[d]
    if op == OP_ZEXT:
        ret true
    end
    if op == OP_UREM:
        ret nd_nonneg(
            g, g.i_a[d], blk, depth + 1, stk
        ) or nd_nonneg(g, g.i_b[d], blk, depth + 1, stk)
    end
    if op == OP_LSHR:
        ret is_cint(g, g.i_b[d]) and g.v_i[g.i_b[d]] > (0 as i64)
    end
    if op == OP_AND:
        ret nd_nonneg(
            g, g.i_a[d], blk, depth + 1, stk
        ) or nd_nonneg(g, g.i_b[d], blk, depth + 1, stk)
    end
    if op == OP_SEXT:
        ret nd_nonneg(g, g.i_a[d], blk, depth + 1, stk)
    end
    if op == OP_SREM or op == OP_SDIV or op == OP_UDIV or
        ((op == OP_ADD or op == OP_MUL) and (g.i_f[d] & IF_NSW) != 0):
        ret nd_nonneg(
            g, g.i_a[d], blk, depth + 1, stk
        ) and nd_nonneg(g, g.i_b[d], blk, depth + 1, stk)
    end
    if op == OP_PHI:
        stk.Push(v)
        mut all := true
        repeat g.i_pcount[d] in q:
            if all and not nd_nonneg(g, g.pool[g.i_ps[d] + 2 * q], blk, depth + 1, stk):
                all = false
            end
        end
        _p := stk.Pop()
        ret all
    end
    ret false
end

func nd_fits32(g &: Ng, v: int, blk: int, signed: bool): bool:
    mut lo := 0 as i64
    mut hi := 0 as i64
    if not val_range(g, v, blk, 0, lo, hi):
        ret false
    end
    ret hi <= (2147483647 as i64) and lo >= (signed ? (-2147483648 as i64) : (0 as i64))
end
