package nativegen

func ro_clean(g &: Ng, sy: int): bool:
    until g.sy_clean.Len() <= sy:
        g.sy_clean.Push(0)
    end
    if g.sy_clean[sy] == 0:
        mut st := 1
        if g.sy_sec[sy] != SEC_BSS:
            lo := g.sy_off[sy]
            hi := lo + g.sy_size[sy]
            repeat g.r_sec.Len() in k:
                if g.r_sec[k] == g.sy_sec[sy] and g.r_off[k] + 8 > lo and g.r_off[k] < hi:
                    st = 2
                end
            end
        end
        g.sy_clean[sy] = st
    end
    ret g.sy_clean[sy] == 1
end

func ro_global(g &: Ng, a: int, off &: i64): int:
    if a < 0:
        ret 0 - 1
    end
    if g.v_kind[a] == VK_GLB:
        off = g.v_i[a]
        ret g.v_def[a]
    end
    if g.v_kind[a] == VK_INS:
        d := g.v_def[a]
        if g.i_op[d] == OP_ADDR and g.i_b[d] < 0:
            b := g.i_a[d]
            if b >= 0 and g.v_kind[b] == VK_GLB:
                off = g.v_i[b] + g.i_d[d]
                ret g.v_def[b]
            end
        end
    end
    ret 0 - 1
end

func fold_strlen(g &: Ng, i: int): bool:
    fv := g.i_a[i]
    if g.off_kstr or fv < 0 or g.v_kind[fv] != VK_GLB or g.v_def[fv] != g.sym_strlen or
        g.i_pcount[i] != 1 or g.i_res[i] < 0:
        ret false
    end
    mut off := 0 as i64
    sy := ro_global(g, g.pool[g.i_ps[i]], off)
    if sy < 0 or sy >= g.sy_ro.Len() or not g.sy_ro[sy] or g.sy_sec[sy] == SEC_BSS or
        off < (0 as i64) or not ro_clean(g, sy):
        ret false
    end
    lim := g.sy_size[sy]
    base := g.sy_off[sy]
    mut k := off as int
    until k < lim and sec_byte(g, g.sy_sec[sy], base + k) != 0:
        k++
    end
    if k >= lim:
        ret false
    end
    replace_res(g, i, cval(g, g.i_ty[i], (k - (off as int)) as i64))
    ret true
end

func fold_memcpy(g &: Ng, i: int): bool:
    fv := g.i_a[i]
    if g.off_kstr or fv < 0 or g.v_kind[fv] != VK_GLB or g.v_def[fv] != g.sym_memcpy or
        g.i_pcount[i] != 3 or (g.i_f[i] & IF_VARARG) != 0:
        ret false
    end
    ps := g.i_ps[i]
    d := g.pool[ps]
    sv := g.pool[ps + 3]
    n := g.pool[ps + 6]
    if d < 0 or sv < 0 or n < 0 or g.v_kind[n] != VK_INT or g.v_i[n] < (0 as i64) or
        g.v_i[n] > (64 as i64):
        ret false
    end
    nf := new_val(g, VK_GLB, T_PTR, 0 as i64)
    g.v_def[nf] = g.sym_i_memcpy
    g.sy_used[g.sym_i_memcpy] = true
    c := ins_new(g, OP_CALL, T_VOID)
    g.i_a[c] = nf
    g.i_x[c] = 0 - 1
    g.i_ps[c] = g.pool.Len()
    g.i_pcount[c] = 4
    each av in [d, sv, const_int(g, T_I64, g.v_i[n]), const_int(g, T_I1, 0 as i64)]:
        g.pool.Push(av)
        g.pool.Push(0)
        g.pool.Push(0 - 1)
    end
    ins_before(g, i, c)
    replace_res(g, i, d)
    ret true
end

func fold_ro_load(g &: Ng, i: int): bool:
    a := g.i_a[i]
    if (g.i_f[i] & (IF_VOLATILE | IF_ATOMIC)) != 0:
        ret false
    end
    mut off := 0 as i64
    sy := ro_global(g, a, off)
    if sy < 0 or sy >= g.sy_ro.Len() or not g.sy_ro[sy] or not ro_clean(g, sy):
        ret false
    end
    t := g.i_ty[i]
    if g.t_kind[t] != TK_INT or int_bits(g, t) < 8:
        ret false
    end
    sz := tsize(g, t)
    if off < (0 as i64) or off + (sz as i64) > (g.sy_size[sy] as i64):
        ret false
    end
    mut v := 0 as i64
    if g.sy_sec[sy] != SEC_BSS:
        base := g.sy_off[sy] + (off as int)
        mut k := sz - 1
        until k >= 0:
            v = (v << (8 as i64)) | (sec_byte(g, g.sy_sec[sy], base + k) as i64)
            k--
        end
    end
    replace_res(g, i, cval(g, t, v))
    ret true
end
