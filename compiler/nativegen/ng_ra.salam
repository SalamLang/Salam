func is_callee_saved(g &: Ng, r: int): bool:
    if g.arch == NG_ARCH_ARM:
        ret r >= 5 and r <= 12
    end
    if g.arch == NG_ARCH_A64 or g.arch == NG_ARCH_RV64:
        ret r >= 12 and r <= 15
    end
    if g.arch == NG_ARCH_X86:
        ret r == RBX or r == RBP or r == RSI or r == R10 or r == R11
    end
    if r == RBX or r == R12 or r == R13 or r == R14 or r == R15:
        ret true
    end
    if r == RBP and g.os != NG_OS_WINDOWS:
        ret true
    end
    if g.os == NG_OS_WINDOWS:
        if r == RSI or r == RDI:
            ret true
        end
        if r >= 22 and r <= 31:
            ret true
        end
    end
    ret false
end

func is_caller_saved(g &: Ng, r: int): bool:
    if r == RSP or (r == RBP and g.arch == NG_ARCH_X64):
        ret false
    end
    ret not is_callee_saved(g, r)
end

func ra_has_xmm0_blend(g &: Ng): bool:
    repeat g.mc.op.Len() in i:
        if g.mc.op[i] == M_VBLEND and g.mc.r2[i] < 0:
            ret true
        end
    end
    ret false
end

func regalloc(g &: Ng):
    mut ra := Ra {}
    nv := g.mc.vcls.Len()
    g.mc.vstart.Clear()
    g.mc.vend.Clear()
    repeat nv:
        g.mc.vstart.Push(0 - 1)
        g.mc.vend.Push(0 - 1)
    end
    loop_weights(g)
    ra.rs_on = g.opt and not g.off_rasp
    if ra.rs_on:
        rs_init(g, ra)
    end
    liveness(g, ra)
    if ra.rs_on:
        rs_build_occ(g, ra)
        rs_save(g, ra)
    end
    g.ra_x14 = g.opt and not g.off_xfree and g.arch == NG_ARCH_X64 and g.os != NG_OS_WINDOWS
    g.ra_x0l = ra_has_xmm0_blend(g)
    rm_scan(g, ra)
    linear_scan(g, ra)
    if ra.rs_on:
        rs_finalize(g, ra)
        if not rs_events(g, ra):
            rs_reset(g, ra)
            linear_scan(g, ra)
        end
    end
    coalesce_spills(g, ra)
    if g.opt and not g.off_cpspill:
        cp_spill(g, ra)
    end
    if g.fv_val.Len() > 0:
        dv_markers(g, ra)
    end
    rewrite(g, ra)
    g.mc_dv = 0 - 1
    color_slots(g)
    if g.opt and not g.off_scse:
        scratch_cse(g)
    end
    if g.opt and not g.off_shoist:
        spill_hoist(g)
    end
    if g.opt and not g.off_cpelim:
        copy_elim(g)
    end
    if g.opt and not g.off_stfwd:
        store_forward(g)
    end
    frame_layout(g)
    ra.fr_s.Free()
    ra.fr_e.Free()
    ra.fr_next.Free()
    ra.fr_head.Free()
    ra.fr_tail.Free()
    ra.fr_cur.Free()
    ra.oc_blk.Free()
    ra.oc_first.Free()
    ra.oc_last.Free()
    ra.oc_upex.Free()
    ra.oc_def.Free()
    ra.oc_fdef.Free()
    ra.oc_lu.Free()
    ra.oc_next.Free()
    ra.oc_head.Free()
    ra.oc_cur.Free()
    ra.li_blk.Free()
    ra.li_next.Free()
    ra.li_head.Free()
    ra.rg_s.Free()
    ra.rg_e.Free()
    ra.v_r0.Free()
    ra.v_rn.Free()
    ra.v_rc.Free()
    ra.mark.Free()
    ra.order.Free()
    ra.tmp.Free()
    ra.ts.Free()
    ra.te.Free()
    ra.active.Free()
    ra.inactive.Free()
    ra.free_until.Free()
    ra.uses.Free()
    ra.defs.Free()
    ra.wl.Free()
    ra.nuse.Free()
    ra.cp_head.Free()
    ra.cp_to.Free()
    ra.cp_next.Free()
    ra.rm_bad.Free()
    rs_free(ra)
end

func slot_loc(g &: Ng, s: int): int:
    if s >= 0 and s < g.mc.fs_alias.Len() and g.mc.fs_alias[s] >= 0:
        ret g.mc.fs_alias[s]
    end
    ret s
end
