    pub nsplit: int = 0
    pub maxsplit: int = 0
    pub nv0: int = 0
    pub sv_nfs: int = 0
    pub ov: Vector<int> = Vector {}
    pub opos: Vector<int> = Vector {}
    pub ow: Vector<int> = Vector {}
