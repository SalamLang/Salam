package nativegen

func slot_conflict(ra &: Ra, head &: Vector<int>, nxt &: Vector<int>, sa: int, sb: int): bool:
    mut x := head[sa]
    until x >= 0:
        mut y := head[sb]
        until y >= 0:
            if ranges_overlap(
                ra.rg_s, ra.rg_e, ra.v_r0[x], ra.v_rn[x], ra.rg_s, ra.rg_e, ra.v_r0[y], ra.v_rn[y]
            ):
                ret true
            end
            y = nxt[y]
        end
        x = nxt[x]
    end
    ret false
end

func coalesce_spills(g &: Ng, ra &: Ra):
    nv := g.mc.vcls.Len()
    ns := g.mc.fs_size.Len()
    mut head := Vector {} as Vector<int>
    mut nxt := Vector {} as Vector<int>
    repeat ns:
        head.Push(0 - 1)
    end
    repeat nv:
        nxt.Push(0 - 1)
    end
    mut v := VBASE
    until v < nv:
        sl := g.mc.vslot[v]
        if g.mc.vloc[v] < 0 and sl >= 0 and ra.v_rn[v] > 0 and
            (ra.pcn.Len() == 0 or v < ra.pcn.Len()):
            nxt[v] = head[sl]
            head[sl] = v
        end
        v++
    end
    n := g.mc.op.Len()
    mut ndef := Vector {} as Vector<int>
    repeat nv:
        ndef.Push(0)
    end
    repeat n in i0:
        mi_regs(g, i0, ra.uses, ra.defs)
        each dv in ra.defs:
            if dv >= VBASE:
                ndef[dv] = ndef[dv] + 1
            end
        end
    end
    repeat n in i:
        op := g.mc.op[i]
        if op != M_COPY and op != M_FMOV_RR:
            continue
        end
        a := g.mc.r0[i]
        b := g.mc.r1[i]
        if a < VBASE or b < VBASE or g.mc.vloc[a] >= 0 or g.mc.vloc[b] >= 0:
            continue
        end
        sa := g.mc.vslot[a]
        sb := g.mc.vslot[b]
        if sa < 0 or sb < 0 or sa == sb or g.mc.vwide[a] != g.mc.vwide[b] or
            g.mc.vymm[a] != g.mc.vymm[b] or head[sa] < 0 or head[sb] < 0:
            continue
        end
        same_val := ndef[a] == 1 and ndef[b] == 1 and nxt[a] < 0 and head[sa] == a
        if not same_val and slot_conflict(ra, head, nxt, sa, sb):
            continue
        end
        mut y := head[sb]
        mut last := 0 - 1
        until y >= 0:
            g.mc.vslot[y] = sa
            last = y
            y = nxt[y]
        end
        nxt[last] = head[sa]
        head[sa] = head[sb]
        head[sb] = 0 - 1
    end
    head.Free()
    nxt.Free()
    ndef.Free()
end

func cps_bad(bad &: Vector<int>, r: int, w: int):
    if r >= VBASE and r < bad.Len():
        bad[r] += w
    end
end

func cps_piece(ra &: Ra, v: int): bool:
    ret rs_is_split(ra, v) or (v < ra.par.Len() and ra.par[v] != v)
end

func cps_free(g &: Ng, ra &: Ra, v: int, s: int): bool:
    nv := g.mc.vcls.Len()
    mut u := VBASE
    until u < nv:
        if u != v and g.mc.vslot[u] == s and ra.v_rn[u] > 0:
            if ranges_overlap(
                ra.rg_s, ra.rg_e, ra.v_r0[v], ra.v_rn[v], ra.rg_s, ra.rg_e, ra.v_r0[u], ra.v_rn[u]
            ):
                ret false
            end
        end
        u++
    end
    ret true
end

func cp_spill(g &: Ng, ra &: Ra):
    nv := g.mc.vcls.Len()
    n := g.mc.op.Len()
    mut bad := Vector {} as Vector<int>
    mut wt := Vector {} as Vector<int>
    mut cps := Vector {} as Vector<int>
    repeat nv:
        bad.Push(0)
    end
    repeat n:
        wt.Push(1)
    end
    each b in g.mc.lorder:
        if g.mc.bstart[b] < 0:
            continue
        end
        mut k := g.mc.bstart[b]
        until k < g.mc.bend[b]:
            wt[k] = g.b_wt[b]
            k++
        end
    end
    repeat n in i:
        op := g.mc.op[i]
        r0 := g.mc.r0[i]
        r1 := g.mc.r1[i]
        if (op == M_COPY or op == M_FMOV_RR) and r0 >= VBASE and r1 >= VBASE and r0 != r1:
            cps.Push(i)
            continue
        end
        mi_regs(g, i, ra.uses, ra.defs)
        each x in ra.uses:
            cps_bad(bad, x, wt[i])
        end
        each y in ra.defs:
            cps_bad(bad, y, wt[i])
        end
    end
    mut sl := Vector {} as Vector<int>
    mut sw := Vector {} as Vector<int>
    mut v := VBASE
    until v < nv:
        if g.mc.vloc[v] < 0 or ra.v_rn[v] == 0 or cps_piece(ra, v):
            v++
            continue
        end
        sl.Clear()
        sw.Clear()
        each c in cps:
            if g.mc.r0[c] != v and g.mc.r1[c] != v:
                continue
            end
            p := g.mc.r0[c] == v ? g.mc.r1[c] : g.mc.r0[c]
            if g.mc.vloc[p] < 0 and g.mc.vslot[p] >= 0 and not cps_piece(ra, p) and
                g.mc.vcls[p] == g.mc.vcls[v] and g.mc.vwide[p] == g.mc.vwide[v] and
                g.mc.vymm[p] == g.mc.vymm[v]:
                mut f := 0 - 1
                repeat sl.Len() in q:
                    if sl[q] == g.mc.vslot[p]:
                        f = q
                    end
                end
                if f < 0:
                    sl.Push(g.mc.vslot[p])
                    sw.Push(0)
                    f = sl.Len() - 1
                end
                sw[f] += wt[c]
            end
        end
        mut best := 0 - 1
        repeat sl.Len() in q2:
            if best < 0 or sw[q2] > sw[best]:
                best = q2
            end
        end
        if best < 0:
            v++
            continue
        end
        s := sl[best]
        mut gain := 0 - bad[v]
        each c2 in cps:
            if g.mc.r0[c2] != v and g.mc.r1[c2] != v:
                continue
            end
            p2 := g.mc.r0[c2] == v ? g.mc.r1[c2] : g.mc.r0[c2]
            if g.mc.vloc[p2] < 0:
                gain += g.mc.vslot[p2] == s ? wt[c2] : 0 - wt[c2]
            else g.mc.vloc[p2] == g.mc.vloc[v]:
                gain -= wt[c2]
            end
        end
        if gain > 0 and cps_free(g, ra, v, s):
            g.mc.vloc[v] = 0 - 1
            g.mc.vslot[v] = s
        end
        v++
    end
    bad.Free()
    wt.Free()
    cps.Free()
    sl.Free()
    sw.Free()
end

func spill_vreg(g &: Ng, v: int):
    g.mc.vloc[v] = 0 - 1
    if g.mc.vslot[v] < 0:
        if g.mc.vymm[v]:
            g.mc.vslot[v] = new_slot(g, 32, 16)
        else g.mc.vwide[v]:
            g.mc.vslot[v] = new_slot(g, 16, 16)
        else:
            g.mc.vslot[v] = new_slot(g, 8, 8)
        end
        g.mc.fs_temp[g.mc.vslot[v]] = false
    end
end
