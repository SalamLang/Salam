package nativegen

func ranges_overlap(
    as_ &: Vector<int>,
    ae &: Vector<int>,
    a0: int,
    an: int,
    bs: Vector<int>,
    be: Vector<int>,
    b0: int,
    bn: int
): bool:
    mut i := a0
    mut j := b0
    until i < a0 + an and j < b0 + bn:
        if as_[i] <= be[j] and bs[j] <= ae[i]:
            ret true
        end
        if ae[i] < be[j]:
            i++
        else:
            j++
        end
    end
    ret false
end

func add_range(rs &: Vector<int>, re &: Vector<int>, s: int, e: int):
    rs.Push(s)
    re.Push(e)
end

func sort_merge(rs &: Vector<int>, re &: Vector<int>, from: int):
    n := rs.Len()
    mut a := from + 1
    until a < n:
        ks := rs[a]
        ke := re[a]
        mut j := a - 1
        until j >= from and rs[j] > ks:
            rs[j + 1] = rs[j]
            re[j + 1] = re[j]
            j--
        end
        rs[j + 1] = ks
        re[j + 1] = ke
        a++
    end
    mut w := from
    mut k := from
    until k < n:
        if w > from and rs[k] <= re[w - 1] + 1:
            if re[k] > re[w - 1]:
                re[w - 1] = re[k]
            end
        else:
            rs[w] = rs[k]
            re[w] = re[k]
            w++
        end
        k++
    end
    until rs.Len() > w:
        _a := rs.Pop()
        _b := re.Pop()
    end
end

func dominates(g &: Ng, a: int, b: int): bool:
    mut x := b
    repeat 100000:
        if x == a:
            ret true
        end
        if x == 0 or x < 0:
            ret false
        end
        x = g.b_idom[x]
    end
    ret false
end

func color_slots(g &: Ng):
    ns := g.mc.fs_size.Len()
    n := g.mc.op.Len()
    nb := g.b_first.Len()
    mut bs := Vector {} as Vector<int>
    mut be := Vector {} as Vector<int>
    repeat nb:
        bs.Push(0 - 1)
        be.Push(0 - 1)
    end
    mut posblk := Vector {} as Vector<int>
    mut curb := 0 - 1
    repeat n in i:
        if g.mc.op[i] == M_LABEL and g.mc.tgt[i] < nb:
            if curb >= 0:
                be[curb] = i - 1
            end
            curb = g.mc.tgt[i]
            bs[curb] = i
        end
        posblk.Push(curb)
    end
    if curb >= 0:
        be[curb] = n - 1
    end
    mut lhead := Vector {} as Vector<int>
    mut lmem_head := Vector {} as Vector<int>
    mut lmem_next := Vector {} as Vector<int>
    mut lmem_blk := Vector {} as Vector<int>
    mut mark := Vector {} as Vector<int>
    repeat nb:
        mark.Push(0 - 1)
    end
    mut wl := Vector {} as Vector<int>
    each b in g.b_rpo:
        repeat g.b_sn[b] in k:
            h := g.b_succ[g.b_ss[b] + k]
            if dominates(g, h, b):
                li := lhead.Len()
                lhead.Push(h)
                lmem_head.Push(0 - 1)
                mark[h] = li
                lmem_blk.Push(h)
                lmem_next.Push(lmem_head[li])
                lmem_head[li] = lmem_blk.Len() - 1
                wl.Clear()
                if b != h:
                    wl.Push(b)
                    mark[b] = li
                    lmem_blk.Push(b)
                    lmem_next.Push(lmem_head[li])
                    lmem_head[li] = lmem_blk.Len() - 1
                end
                until wl.Len() > 0:
                    x := wl.Pop()
                    repeat g.b_npred[x] in q:
                        pp := g.b_pred[g.b_ps[x] + q]
                        if mark[pp] != li:
                            mark[pp] = li
                            lmem_blk.Push(pp)
                            lmem_next.Push(lmem_head[li])
                            lmem_head[li] = lmem_blk.Len() - 1
                            wl.Push(pp)
                        end
                    end
                end
            end
        end
    end
    nl := lhead.Len()
    mut inloop := Vector {} as Vector<bool>
    repeat nl * nb:
        inloop.Push(false)
    end
    repeat nl in l0:
        mut hh := lmem_head[l0]
        until hh >= 0:
            inloop[l0 * nb + lmem_blk[hh]] = true
            hh = lmem_next[hh]
        end
    end
    mut ss := Vector {} as Vector<int>
    mut se := Vector {} as Vector<int>
    repeat ns:
        ss.Push(0 - 1)
        se.Push(0 - 1)
    end
    repeat n in i2:
        if g.mc.mk[i2] == MK_FRAME:
            sl := g.mc.mb[i2]
            if ss[sl] < 0:
                ss[sl] = i2
            end
            mut last := i2
            if g.mc.op[i2] == M_LEA:
                pb2 := posblk[i2]
                lim := pb2 >= 0 ? be[pb2] : n - 1
                mut q9 := i2 + 1
                last = lim
                until q9 <= lim:
                    if g.mc.op[q9] == M_CALL or g.mc.op[q9] == M_CALLR:
                        last = q9
                        break
                    end
                    q9++
                end
            end
            if last > se[sl]:
                se[sl] = last
            end
        end
    end
    mut rr_s := Vector {} as Vector<int>
    mut rr_e := Vector {} as Vector<int>
    mut r0 := Vector {} as Vector<int>
    mut rn := Vector {} as Vector<int>
    repeat ns:
        r0.Push(0)
        rn.Push(0)
    end
    mut cands := Vector {} as Vector<int>
    mut lhit := Vector {} as Vector<bool>
    repeat nl:
        lhit.Push(false)
    end
    repeat ns in sl2:
        if not g.mc.fs_temp[sl2] or ss[sl2] < 0:
            continue
        end
        start := rr_s.Len()
        add_range(rr_s, rr_e, ss[sl2], se[sl2])
        repeat nl in l1:
            lhit[l1] = false
        end
        mut i3 := ss[sl2]
        until i3 <= se[sl2]:
            if g.mc.mk[i3] == MK_FRAME and g.mc.mb[i3] == sl2:
                pb := posblk[i3]
                if pb >= 0:
                    repeat nl in l2:
                        if not lhit[l2] and inloop[l2 * nb + pb]:
                            lhit[l2] = true
                        end
                    end
                end
            end
            i3++
        end
        repeat nl in l3:
            if lhit[l3]:
                mut h3 := lmem_head[l3]
                until h3 >= 0:
                    lb := lmem_blk[h3]
                    if bs[lb] >= 0:
                        add_range(rr_s, rr_e, bs[lb], be[lb])
                    end
                    h3 = lmem_next[h3]
                end
            end
        end
        sort_merge(rr_s, rr_e, start)
        r0[sl2] = start
        rn[sl2] = rr_s.Len() - start
        cands.Push(sl2)
    end
    nc := cands.Len()
    mut a := 1
    until a < nc:
        key := cands[a]
        mut j := a - 1
        until j >= 0 and rr_s[r0[cands[j]]] > rr_s[r0[key]]:
            cands[j + 1] = cands[j]
            j--
        end
        cands[j + 1] = key
        a++
    end
    mut pslots := Vector {} as Vector<int>
    mut pr_s := Vector {} as Vector<int>
    mut pr_e := Vector {} as Vector<int>
    mut pr_0 := Vector {} as Vector<int>
    mut pr_n := Vector {} as Vector<int>
    each c in cands:
        mut pick := 0 - 1
        repeat pslots.Len() in q2:
            if pick < 0 and not ranges_overlap(
                pr_s, pr_e, pr_0[q2], pr_n[q2], rr_s, rr_e, r0[c], rn[c]
            ):
                pick = q2
            end
        end
        if pick < 0:
            pslots.Push(c)
            pr_0.Push(pr_s.Len())
            repeat rn[c] in t:
                pr_s.Push(rr_s[r0[c] + t])
                pr_e.Push(rr_e[r0[c] + t])
            end
            pr_n.Push(rn[c])
        else:
            root := pslots[pick]
            if g.mc.fs_size[c] > g.mc.fs_size[root]:
                g.mc.fs_size[root] = g.mc.fs_size[c]
            end
            if g.mc.fs_align[c] > g.mc.fs_align[root]:
                g.mc.fs_align[root] = g.mc.fs_align[c]
            end
            g.mc.fs_alias[c] = root
            st := pr_s.Len()
            repeat pr_n[pick] in t2:
                pr_s.Push(pr_s[pr_0[pick] + t2])
                pr_e.Push(pr_e[pr_0[pick] + t2])
            end
            repeat rn[c] in t3:
                pr_s.Push(rr_s[r0[c] + t3])
                pr_e.Push(rr_e[r0[c] + t3])
            end
            sort_merge(pr_s, pr_e, st)
            pr_0[pick] = st
            pr_n[pick] = pr_s.Len() - st
        end
    end
    bs.Free()
    be.Free()
    posblk.Free()
    lhead.Free()
    lmem_head.Free()
    lmem_next.Free()
    lmem_blk.Free()
    mark.Free()
    wl.Free()
    inloop.Free()
    ss.Free()
    se.Free()
    rr_s.Free()
    rr_e.Free()
    r0.Free()
    rn.Free()
    cands.Free()
    lhit.Free()
    pslots.Free()
    pr_s.Free()
    pr_e.Free()
    pr_0.Free()
    pr_n.Free()
end

func frame_layout(g &: Ng):
    g.mc.callee_used.Clear()
    mut used := Vector {} as Vector<bool>
    repeat 32:
        used.Push(false)
    end
    n := g.mc.op.Len()
    mut anyf := false
    repeat n in i:
        r0 := g.mc.r0[i]
        if r0 >= 0 and r0 < 32:
            used[r0] = true
        end
        if r0 >= 16 or g.mc.r1[i] >= 16:
            anyf = true
        end
    end
    mut ngp := 0
    repeat 16 in r:
        if used[r] and is_callee_saved(g, r):
            g.mc.callee_used.Push(r)
            ngp++
        end
    end
    ws := g.wsz == 4 ? 4 : 8
    g.mc.fsave = g.arch == NG_ARCH_ARM and anyf ? 24 : 0
    mut curo := ws * ngp + g.mc.fsave
    mut xs := Vector {} as Vector<int>
    repeat 16 in x:
        if used[16 + x] and is_callee_saved(g, 16 + x):
            xs.Push(16 + x)
        end
    end
    repeat g.mc.fs_size.Len() in s:
        if g.mc.fs_alias[s] >= 0:
            continue
        end
        sz := g.mc.fs_size[s]
        mut al := g.mc.fs_align[s]
        if al < 1:
            al = 1
        end
        if al > 16:
            al = 16
        end
        curo = align_up(curo + sz, al)
        g.mc.fs_off[s] = curo
    end
    repeat g.mc.fs_size.Len() in s2:
        if g.mc.fs_alias[s2] >= 0:
            g.mc.fs_off[s2] = g.mc.fs_off[g.mc.fs_alias[s2]]
        end
    end
    each xr in xs:
        curo = align_up(curo + 16, 16)
        g.mc.callee_used.Push(xr)
        g.mc.callee_used.Push(curo)
    end
    total := align_up(curo + g.mc.out_args, 16)
    g.mc.frame_size = total - ws * ngp
    if g.mc.frame_size < 0:
        g.mc.frame_size = 0
    end
    g.mc.fpo = false
    g.mc.fpo_pad = 0
    if (g.os != NG_OS_WINDOWS and g.arch == NG_ARCH_X64) or g.wsz == 4:
        g.mc.fpo = true
        mut alloc := ws + curo + g.mc.out_args - ws * ngp
        if curo == ws * ngp and g.mc.out_args == 0:
            alloc = 0
        end
        if alloc < 0:
            alloc = 0
        end
        alloc = align_up(alloc, ws)
        until (ws * ngp + alloc) % 16 != 16 - ws and (g.mc.has_call or alloc > 0):
            alloc += ws
        end
        g.mc.fpo_pad = alloc
        g.mc.frame_size = alloc
    end
    used.Free()
    xs.Free()
end
