package nativegen

func mi_clone(g &: Ng, o &: Mc, i: int): int:
    j := mi_new(g, o.op[i], o.sz[i])
    g.mc.sz2[j] = o.sz2[i]
    g.mc.r0[j] = o.r0[i]
    g.mc.r1[j] = o.r1[i]
    g.mc.r2[j] = o.r2[i]
    g.mc.imm[j] = o.imm[i]
    g.mc.mk[j] = o.mk[i]
    g.mc.mb[j] = o.mb[i]
    g.mc.mi[j] = o.mi[i]
    g.mc.ms[j] = o.ms[i]
    g.mc.md[j] = o.md[i]
    g.mc.msym[j] = o.msym[i]
    g.mc.cc[j] = o.cc[i]
    g.mc.tgt[j] = o.tgt[i]
    g.mc.loc[j] = o.loc[i]
    g.mc.dv[j] = g.mc_dv >= 0 ? g.mc_dv : o.dv[i]
    g.mc.ymm[j] = o.ymm[i]
    ret j
end

func spilled(g &: Ng, r: int): bool:
    ret r >= VBASE and g.mc.vloc[r] < 0
end

func phys(g &: Ng, r: int): int:
    if r >= VBASE:
        ret g.mc.vloc[r]
    end
    ret r
end

func rm_kind(g &: Ng, v: int): int:
    ret v >= 0 and v < g.rm_k.Len() ? g.rm_k[v] : 0
end

func rm_mem(g &: Ng, v: int): Mem:
    ret Mem { k = MK_RIP, sym = g.rm_sym[v], d = g.rm_d[v] }
end

func rm_free_use(op: int, r0: int, r1: int, r2: int, mk: int, cc: int, u: int, vex: bool): bool:
    if mk != MK_NONE or r1 != u or r0 == u:
        ret false
    end
    if op == M_COPY:
        ret not vex
    end
    if op == M_VOP_RR:
        ret not vshift_reg_op(cc)
    end
    ret op == M_VBLEND and r2 != u
end

func rm_cheap(g &: Ng, ra &: Ra, v: int): bool:
    ret rm_kind(g, v) == 1 and v < ra.rm_bad.Len() and ra.rm_bad[v] == 0
end

func rm_scan(g &: Ng, ra &: Ra):
    nv := g.mc.vcls.Len()
    g.rm_k.Clear()
    g.rm_sym.Clear()
    g.rm_d.Clear()
    ra.rm_bad.Clear()
    mut nd := Vector {} as Vector<int>
    mut cps := Vector {} as Vector<int>
    repeat nv:
        g.rm_k.Push(0)
        g.rm_sym.Push(-1)
        g.rm_d.Push(0 as i64)
        ra.rm_bad.Push(0)
        nd.Push(0)
        cps.Push(-1)
    end
    if not g.opt or g.off_remat or g.arch != NG_ARCH_X64:
        nd.Free()
        cps.Free()
        ret
    end
    n := g.mc.op.Len()
    mut vex := false
    repeat n in i0:
        if g.mc.ymm[i0] or (g.avx2 and (g.mc.op[i0] == M_VUN or g.mc.op[i0] == M_VBLEND)):
            vex = true
        end
    end
    repeat n in i:
        op := g.mc.op[i]
        if op == M_NOP or op == M_LABEL:
            continue
        end
        mi_regs(g, i, ra.uses, ra.defs)
        each d in ra.defs:
            if d >= VBASE and d < nv:
                nd[d] = nd[d] + 1
                if op == M_VLD and g.mc.mk[i] == MK_RIP and g.mc.msym[i] == g.sym_ro and
                    g.mc.r0[i] == d:
                    g.rm_k[d] = 1
                    g.rm_sym[d] = g.mc.msym[i]
                    g.rm_d[d] = g.mc.md[i]
                else op == M_XORPS and g.mc.r0[i] == d and g.mc.r1[i] == d:
                    g.rm_k[d] = 2
                else op == M_COPY and g.mc.r0[i] == d and g.mc.r1[i] >= VBASE and g.mc.r1[i] < nv:
                    g.rm_k[d] = 3
                    cps[d] = g.mc.r1[i]
                else:
                    g.rm_k[d] = 0
                end
            end
        end
    end
    repeat nv in v:
        if nd[v] != 1 or not g.mc.vwide[v]:
            g.rm_k[v] = 0
        end
    end
    repeat 4:
        repeat nv in v2:
            if g.rm_k[v2] == 3:
                c := cps[v2]
                k := g.rm_k[c]
                if k == 1 or k == 2:
                    g.rm_k[v2] = k
                    g.rm_sym[v2] = g.rm_sym[c]
                    g.rm_d[v2] = g.rm_d[c]
                else k == 0:
                    g.rm_k[v2] = 0
                end
            end
        end
    end
    repeat nv in v3:
        if g.rm_k[v3] == 3:
            g.rm_k[v3] = 0
        end
    end
    repeat n in i2:
        op2 := g.mc.op[i2]
        if op2 == M_NOP or op2 == M_LABEL:
            continue
        end
        mi_regs(g, i2, ra.uses, ra.defs)
        each u in ra.uses:
            if u >= VBASE and u < nv and g.rm_k[u] != 0 and not rm_free_use(
                op2, g.mc.r0[i2], g.mc.r1[i2], g.mc.r2[i2], g.mc.mk[i2], g.mc.cc[i2], u, vex
            ):
                ra.rm_bad[u] = ra.rm_bad[u] + 1
            end
        end
    end
    nd.Free()
    cps.Free()
end

func reload(g &: Ng, v: int, scratch: int):
    rk := rm_kind(g, v)
    if rk == 1:
        rl := e_rm(g, M_VLD, 16, scratch, rm_mem(g, v))
        g.mc.ymm[rl] = g.mc.vymm[v]
        ret
    end
    if rk == 2:
        _z := e_rr(g, M_XORPS, 16, scratch, scratch)
        ret
    end
    m := frame_mem(g.mc.vslot[v], 0 as i64)
    if g.mc.vwide[v]:
        lw := e_rm(g, M_VLD, 16, scratch, m)
        g.mc.ymm[lw] = g.mc.vymm[v]
    else g.mc.vcls[v] == 1:
        _l := e_rm(g, M_FLD, 8, scratch, m)
    else:
        _l2 := e_rm(g, M_LD, 8, scratch, m)
    end
end

func spill_store(g &: Ng, v: int, scratch: int):
    m := frame_mem(g.mc.vslot[v], 0 as i64)
    if g.mc.vwide[v]:
        sw := e_mr(g, M_VST, 16, m, scratch)
        g.mc.ymm[sw] = g.mc.vymm[v]
    else g.mc.vcls[v] == 1:
        _s := e_mr(g, M_FST, 8, m, scratch)
    else:
        _s2 := e_mr(g, M_ST, 8, m, scratch)
    end
end

func is_def_slot(op: int, cc: int): bool:
    switch op:
        M_MOV_RR, M_COPY, M_MOVZX_RR, M_MOVSX_RR, M_FMOV_RR, M_CVTSI2F, M_CVTF2SI, M_CVTF2F, M_MOVQ_XG, M_MOVQ_GX, M_SQRT, M_MOV_RI, M_SETCC, M_LD, M_LDZX, M_LDSX, M_LEA, M_FLD, M_LDGOT, M_IMUL_RR, M_FOP_RR, M_XORPS, M_ANDPS, M_UNARY, M_SHIFT_RI, M_SHIFT_RC, M_IMUL_RRI, M_CMOV, M_XCHG, M_LXADD, M_ALU_RM, M_FOP_RM, M_VLD, M_VOP_RR, M_SHUFPS, M_UNPCKLPD, M_PSHUFD, M_VSHI, M_VLD32, M_VUN, M_VBLEND:
            ret true
        end
        M_ALU_RR, M_ALU_RI:
            ret cc != ALU_CMP and cc != ALU_SBBCMP and cc != ALU_ADDCMP
        end
        M_ARM_SODD:
            ret cc == 1
        end
    end
    ret false
end

func is_use_r0_cc(op: int, cc: int): bool:
    if op == M_ARM_SODD:
        ret cc == 0
    end
    ret is_use_r0(op)
end

func is_use_r0(op: int): bool:
    switch op:
        M_MOV_RR, M_COPY, M_MOVZX_RR, M_MOVSX_RR, M_FMOV_RR, M_CVTSI2F, M_CVTF2SI, M_CVTF2F, M_MOVQ_XG, M_MOVQ_GX, M_SQRT, M_MOV_RI, M_SETCC, M_LD, M_LDZX, M_LDSX, M_LEA, M_FLD, M_LDGOT, M_IMUL_RRI, M_VLD, M_VLD32, M_PSHUFD, M_VUN, M_VZU:
            ret false
        end
    end
    ret true
end

func x86_live(g &: Ng, c: int, i: int): bool:
    mut v := VBASE
    n := g.mc.vloc.Len()
    until v < n:
        if g.mc.vloc[v] == c and g.mc.vstart[v] <= 2 * i + 1 and g.mc.vend[v] >= 2 * i:
            ret true
        end
        v++
    end
    ret false
end

func x86_borrow(g &: Ng, i: int, r0: int, r1: int, mb: int, mi: int, save &: bool): int:
    mut pick := -1
    each c in [RSI, RBX, RBP]:
        mut busy := false
        each x in [r0, r1, mb, mi]:
            if x >= 0 and not spilled(g, x) and phys(g, x) == c:
                busy = true
            end
        end
        if not busy:
            if not x86_live(g, c, i):
                save = false
                ret c
            end
            if pick < 0:
                pick = c
            end
        end
    end
    save = true
    ret pick
end

func rw_blend(g &: Ng, ra &: Ra, o &: Mc, i: int, rsp: bool):
    r0 := o.r0[i]
    r1 := o.r1[i]
    r2 := o.r2[i]
    mut p0 := phys(g, r0)
    mut p2 := phys(g, r2)
    s0 := spilled(g, r0)
    s1 := spilled(g, r1)
    if s0:
        p0 = XMM15
        reload(g, r0, XMM15)
    end
    mut bsave := false
    mut bsl := -1
    if spilled(g, r2):
        if r2 == r0:
            p2 = XMM15
        else g.ra_x14:
            p2 = xborrow(g, i, p0, s1 ? -1 : phys(g, r1), bsave)
            if bsave:
                bsl = xborrow_save(g, p2)
            end
            reload(g, r2, p2)
        else:
            p2 = XMM14
            reload(g, r2, XMM14)
        end
    end
    j := mi_clone(g, o, i)
    g.mc.r0[j] = p0
    g.mc.r2[j] = p2
    if r1 == r0:
        g.mc.r1[j] = p0
    else r1 == r2:
        g.mc.r1[j] = p2
    else s1:
        g.mc.r1[j] = -1
        set_mem(g, j, rm_kind(g, r1) == 1 ? rm_mem(g, r1) : frame_mem(g.mc.vslot[r1], 0 as i64))
    else:
        g.mc.r1[j] = phys(g, r1)
    end
    if s0:
        spill_store(g, r0, XMM15)
    end
    if bsl >= 0:
        xborrow_restore(g, p2, bsl)
    end
    if rsp:
        rs_def_store(g, ra, M_VBLEND, o.cc[i], r0)
    end
end

func xborrow(g &: Ng, i: int, a: int, b: int, save &: bool): int:
    mut pick := -1
    each x in k_xborrow:
        if x != a and x != b:
            if not x86_live(g, x, i):
                save = false
                ret x
            end
            if pick < 0:
                pick = x
            end
        end
    end
    save = true
    ret pick
end

func fn_has_ymm(g &: Ng): bool:
    each y in g.mc.vymm:
        if y:
            ret true
        end
    end
    ret false
end

func xborrow_save(g &: Ng, r: int): int:
    sl := new_slot(g, 32, 16)
    g.mc.fs_temp[sl] = false
    sw := e_mr(g, M_VST, 16, frame_mem(sl, 0 as i64), r)
    g.mc.ymm[sw] = fn_has_ymm(g)
    ret sl
end

func xborrow_restore(g &: Ng, r: int, sl: int):
    lw := e_rm(g, M_VLD, 16, r, frame_mem(sl, 0 as i64))
    g.mc.ymm[lw] = fn_has_ymm(g)
end

func spf_slot(g &: Ng, r: int): bool:
    ret r >= 0 and spilled(g, r) and g.mc.vcls[r] == 0 and rm_kind(g, r) == 0 and not g.mc.vwide[r]
end

func spf_try(g &: Ng, o &: Mc, i: int, op: int, r0: int, r1: int): bool:
    if g.off_spfold or o.mk[i] != MK_NONE or r0 < 0 or
        (g.arch != NG_ARCH_X64 and g.arch != NG_ARCH_X86):
        ret false
    end
    if (op == M_ALU_RI and o.cc[i] == ALU_CMP) or (op == M_TEST_RR and r0 == r1):
        if not spf_slot(g, r0):
            ret false
        end
        cm := mi_new(g, M_ALU_MI, o.sz[i])
        set_mem(g, cm, frame_mem(g.mc.vslot[r0], 0 as i64))
        g.mc.imm[cm] = op == M_ALU_RI ? o.imm[i] : (0 as i64)
        g.mc.cc[cm] = ALU_CMP
        ret true
    end
    if spilled(g, r0) or not spf_slot(g, r1) or g.mc.vcls[r0] != 0:
        ret false
    end
    if op == M_MOVZX_RR and (o.sz2[i] == 1 or o.sz2[i] == 2):
        lz := e_rm(g, M_LDZX, 4, phys(g, r0), frame_mem(g.mc.vslot[r1], 0 as i64))
        g.mc.sz2[lz] = o.sz2[i]
        ret true
    end
    if (op == M_CMOV or op == M_IMUL_RR) and r0 != r1 and o.sz[i] >= 4:
        fm := e_rm(g, op, o.sz[i], phys(g, r0), frame_mem(g.mc.vslot[r1], 0 as i64))
        g.mc.cc[fm] = o.cc[i]
        ret true
    end
    ret false
end

func rewrite(g &: Ng, ra &: Ra):
    mut o := mc_take(g)
    n := o.op.Len()
    mut bslot := -1
    mut dv_prev := -1
    mut dv_n0 := 0
    rsp := ra.pcn.Len() > 0
    repeat n in i:
        if rsp and i > 0 and o.op[i - 1] == M_LABEL:
            rs_emit(g, ra, ra.ev_d[i - 1])
        end
        op := o.op[i]
        g.mc_loc = o.loc[i]
        dv_pend := (i > 0 and g.mc.op.Len() == dv_n0) ? dv_prev : -1
        dv_prev = dv_join(g, dv_pend, o.dv[i])
        g.mc_dv = dv_prev
        dv_n0 = g.mc.op.Len()
        r0 := o.r0[i]
        r1 := o.r1[i]
        mb := o.mk[i] == MK_BI ? o.mb[i] : -1
        mi := (o.mk[i] == MK_BI or o.mk[i] == MK_FRAME) ? o.mi[i] : -1
        if rsp:
            rs_emit(g, ra, ra.ev_a[i])
            rs_emit(g, ra, ra.ev_b[i])
            rs_emit(g, ra, ra.ev_c[i])
            rs_set(g, ra, r0, i)
            rs_set(g, ra, r1, i)
            rs_set(g, ra, mb, i)
            rs_set(g, ra, mi, i)
            if op == M_VBLEND:
                rs_set(g, ra, o.r2[i], i)
            end
        end
        if op == M_COPY or op == M_FMOV_RR:
            s0 := spilled(g, r0)
            s1 := spilled(g, r1)
            p0 := phys(g, r0)
            p1 := phys(g, r1)
            fl := g.mc.vcls[r0] == 1 or g.mc.vcls[r1] == 1
            if s0 and s1 and g.mc.vslot[r0] == g.mc.vslot[r1]:
                continue
            end
            if s0 and s1:
                sc := fl ? XMM15 : R11
                reload(g, r1, sc)
                spill_store(g, r0, sc)
            else s1:
                reload(g, r1, p0)
            else s0:
                spill_store(g, r0, p1)
            else p0 != p1:
                mut mop := M_MOV_RR
                if fl:
                    mop = M_FMOV_RR
                end
                mm := e_rr(g, mop, 8, p0, p1)
                g.mc.ymm[mm] = g.mc.vymm[r0] or g.mc.vymm[r1]
            end
            if rsp:
                rs_def_store(g, ra, op, o.cc[i], r0)
            end
            continue
        end
        if op == M_VBLEND:
            rw_blend(g, ra, o, i, rsp)
            continue
        end
        if op == M_ALU_RR and o.mk[i] == MK_NONE and r0 >= 0 and r1 >= 0 and r0 != r1:
            f0 := spilled(g, r0)
            f1 := spilled(g, r1)
            if f1 and not f0 and g.mc.vcls[r1] == 0:
                ia := e_rm(g, M_ALU_RM, o.sz[i], phys(g, r0), frame_mem(g.mc.vslot[r1], 0 as i64))
                g.mc.cc[ia] = o.cc[i]
                if rsp:
                    rs_def_store(g, ra, op, o.cc[i], r0)
                end
                continue
            end
            if f0 and not f1 and g.mc.vcls[r0] == 0:
                ib := e_mr(g, M_ALU_MR, o.sz[i], frame_mem(g.mc.vslot[r0], 0 as i64), phys(g, r1))
                g.mc.cc[ib] = o.cc[i]
                continue
            end
        end
        if spf_try(g, o, i, op, r0, r1):
            if rsp and r0 >= 0 and op != M_ALU_RI and op != M_TEST_RR:
                rs_def_store(g, ra, op, o.cc[i], r0)
            end
            continue
        end
        rmf := op == M_VOP_RR and r1 >= 0 and spilled(g, r1) and r1 != mb and r1 != mi and
            rm_kind(g, r1) == 1 and rm_free_use(
                op, r0, r1, o.r2[i], o.mk[i], o.cc[i], r1, true
            )
        mut ngs := 0
        mut nxs := 0
        mut sr0 := -1
        mut sr1 := -1
        mut smb := -1
        mut smi := -1
        if spilled(g, mb):
            smb = R11
            ngs++
        end
        if spilled(g, mi):
            if mi == mb:
                smi = smb
            else:
                smi = ngs == 0 ? R11 : R10
                ngs++
            end
        end
        if spilled(g, r1) and r1 != mb and r1 != mi and not rmf:
            if g.mc.vcls[r1] == 1:
                sr1 = XMM15
                nxs++
            else:
                sr1 = ngs == 0 ? R11 : (ngs == 1 ? R10 : -2)
                ngs++
            end
        else r1 >= 0 and r1 == mb and spilled(g, r1):
            sr1 = smb
        else r1 >= 0 and r1 == mi and spilled(g, r1):
            sr1 = smi
        end
        if spilled(g, r0):
            if r0 == r1:
                sr0 = sr1
            else r0 == mb:
                sr0 = smb
            else r0 == mi:
                sr0 = smi
            else g.mc.vcls[r0] == 1:
                sr0 = nxs == 0 ? XMM15 : (g.ra_x14 ? -3 : XMM14)
                nxs++
            else:
                sr0 = ngs == 0 ? R11 : (ngs == 1 ? R10 : -2)
                ngs++
            end
        end
        mut s10 := R10
        mut bw := -1
        if g.arch == NG_ARCH_X86 and
            (smb == R10 or smi == R10 or sr0 == R10 or sr1 == R10 or sr0 == -2 or sr1 == -2):
            mut bsave := true
            s10 = x86_borrow(g, i, r0, r1, mb, mi, bsave)
            if s10 < 0:
                fail(g, "native backend: register allocator ran out of scratch registers")
                s10 = RSI
            end
            if bsave:
                bw = s10
                if bslot < 0:
                    bslot = new_slot(g, 4, 4)
                end
                _bs := e_mr(g, M_ST, 4, frame_mem(bslot, 0 as i64), bw)
            end
            if smb == R10: smb = s10 end
            if smi == R10: smi = s10 end
            if sr0 == R10: sr0 = s10 end
            if sr1 == R10: sr1 = s10 end
        end
        mut nmb := phys(g, mb)
        mut nmi := phys(g, mi)
        mut nms := o.ms[i]
        mut nmd := o.md[i]
        if smb >= 0:
            reload(g, mb, smb)
            nmb = smb
        end
        if smi >= 0:
            if smi != smb:
                reload(g, mi, smi)
            end
            nmi = smi
        end
        if sr0 == -2 or sr1 == -2:
            if o.mk[i] == MK_BI and smb == R11:
                _l := e_rm(g, M_LEA, 8, R11, Mem {
                    k = MK_BI,
                    b = nmb,
                    i = nmi,
                    s = nms,
                    d = nmd
                })
                nmb = R11
                nmi = -1
                nms = 1
                nmd = 0 as i64
                smi = -1
                if sr1 == -2:
                    sr1 = s10
                end
                if sr0 == -2:
                    sr0 = s10
                end
            else:
                fail(g, "native backend: register allocator ran out of scratch registers")
            end
        end
        mut xsl := -1
        if sr0 == -3:
            mut xsave := false
            sr0 = xborrow(g, i, sr1, sr1, xsave)
            if xsave:
                xsl = xborrow_save(g, sr0)
            end
        end
        if sr1 >= 0 and sr1 != smb and sr1 != smi:
            reload(g, r1, sr1)
        end
        if sr0 >= 0 and sr0 != sr1 and sr0 != smb and sr0 != smi and is_use_r0_cc(op, o.cc[i]):
            reload(g, r0, sr0)
        end
        j := mi_clone(g, o, i)
        if r0 >= 0:
            g.mc.r0[j] = sr0 >= 0 ? sr0 : phys(g, r0)
        end
        if r1 >= 0:
            g.mc.r1[j] = sr1 >= 0 ? sr1 : phys(g, r1)
        end
        if rmf:
            g.mc.r1[j] = -1
            set_mem(g, j, rm_mem(g, r1))
        end
        if o.mk[i] == MK_BI:
            g.mc.mb[j] = nmb
            g.mc.mi[j] = nmi
            g.mc.ms[j] = nms
            g.mc.md[j] = nmd
        else o.mk[i] == MK_FRAME and mi >= 0:
            g.mc.mi[j] = nmi
        end
        if sr0 >= 0 and is_def_slot(op, o.cc[i]):
            spill_store(g, r0, sr0)
        end
        if xsl >= 0:
            xborrow_restore(g, sr0, xsl)
        end
        if bw >= 0:
            _br := e_rm(g, M_LD, 4, bw, frame_mem(bslot, 0 as i64))
        end
        if rsp and r0 >= 0:
            rs_def_store(g, ra, op, o.cc[i], r0)
        end
    end
    if rsp:
        if n > 0 and o.op[n - 1] == M_LABEL:
            rs_emit(g, ra, ra.ev_d[n - 1])
        end
        rs_emit(g, ra, ra.ev_a[n])
        mut v := VBASE
        until v < ra.pcn.Len():
            if ra.pcn[v] > 0:
                g.mc.vloc[v] = -1
            end
            v++
        end
    end
    mc_free_arrays(o)
end
