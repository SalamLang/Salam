package nativegen

func sink_ok(op: int): bool:
    if op >= OP_ADD and op <= OP_ASHR:
        ret op != OP_SDIV and op != OP_UDIV and op != OP_SREM and op != OP_UREM
    end
    if op == OP_ADDR or op == OP_SELECT or op == OP_ICMP or op == OP_FCMP:
        ret true
    end
    ret op >= OP_SEXT and op <= OP_FPTRUNC
end

func sink_note(ub &: Vector<int>, v: int, b: int):
    if v < 0 or v >= ub.len():
        ret
    end
    if ub[v] == 0 - 1:
        ub[v] = b
    else ub[v] != b:
        ub[v] = 0 - 2
    end
end

func sink_round(g &: Ng, inner &: Vector<int>): bool:
    mut ub := Vector {} as Vector<int>
    repeat g.v_kind.len():
        ub.push(0 - 1)
    end
    each b in g.b_rpo:
        mut i := g.b_first[b]
        until i >= 0:
            op := g.i_op[i]
            if op == OP_PHI:
                ps := g.i_ps[i]
                repeat g.i_pcount[i] in q:
                    sink_note(ub, g.pool[ps + 2 * q], g.pool[ps + 2 * q + 1])
                end
            else op == OP_CALL:
                sink_note(ub, g.i_a[i], b)
                ps2 := g.i_ps[i]
                repeat g.i_pcount[i] in q2:
                    sink_note(ub, g.pool[ps2 + 3 * q2], b)
                end
            else:
                m := val_mask(op)
                if (m & 1) != 0: sink_note(ub, g.i_a[i], b) end
                if (m & 2) != 0: sink_note(ub, g.i_b[i], b) end
                if (m & 4) != 0: sink_note(ub, g.i_c[i], b) end
            end
            i = g.i_next[i]
        end
    end
    mut changed := false
    mut k := g.b_rpo.len() - 1
    until k >= 0:
        b2 := g.b_rpo[k]
        mut j := g.b_last[b2]
        until j >= 0:
            pv := g.i_prev[j]
            r := g.i_res[j]
            if r >= 0 and sink_ok(g.i_op[j]) and ub[r] >= 0 and ub[r] != b2:
                u := ub[r]
                if dominates(g, b2, u) and inner[u] == inner[b2] and g.b_order[u] >= 0:
                    mut at := g.b_first[u]
                    until at >= 0 and g.i_op[at] == OP_PHI:
                        at = g.i_next[at]
                    end
                    if at >= 0:
                        keep := g.i_op[j]
                        ins_unlink(g, j)
                        g.i_op[j] = keep
                        ins_before(g, at, j)
                        changed = true
                    end
                end
            end
            j = pv
        end
        k -= 1
    end
    ub.free()
    ret changed
end

func sink_pass(g &: Ng): bool:
    build_dom(g)
    nb := g.b_first.len()
    mut inner := Vector {} as Vector<int>
    mut isz := Vector {} as Vector<int>
    repeat nb:
        inner.push(0 - 1)
        isz.push(2147483647)
    end
    mut l := Lp {}
    repeat nb:
        l.inl.push(0)
    end
    lp_find(g, l)
    mut mark := 7000000
    each h in l.head:
        mark += 1
        n := lp_body(g, l, h, mark)
        repeat nb in b:
            if l.inl[b] == mark and n < isz[b]:
                isz[b] = n
                inner[b] = h
            end
        end
    end
    l.head.free()
    l.size.free()
    l.inl.free()
    l.wl.free()
    l.succ.free()
    mut changed := false
    repeat 4:
        if not sink_round(g, inner):
            break
        end
        changed = true
    end
    inner.free()
    isz.free()
    ret changed
end

func ab_is_const(g &: Ng, v: int, k: i64): bool:
    ret v >= 0 and g.v_kind[v] == VK_INT and (g.v_i[v] & (1 as i64)) == k
end

func ab_split(g &: Ng, b: int): int:
    t := g.b_last[b]
    if t < 0 or g.i_op[t] != OP_CBR or g.i_b[t] == g.i_c[t]:
        ret 0 - 1
    end
    c := g.i_a[t]
    if c < 0 or g.v_kind[c] != VK_INS or g.v_ty[c] != T_I1 or g.v_uses[c] != 1:
        ret 0 - 1
    end
    d := g.v_def[c]
    op := g.i_op[d]
    mut x := 0 - 1
    mut y := 0 - 1
    mut is_and := false
    if op == OP_AND or op == OP_OR:
        x = g.i_a[d]
        y = g.i_b[d]
        is_and = op == OP_AND
    else op == OP_SELECT and ab_is_const(g, g.i_c[d], 0 as i64):
        x = g.i_a[d]
        y = g.i_b[d]
        is_and = true
    else op == OP_SELECT and ab_is_const(g, g.i_b[d], 1 as i64):
        x = g.i_a[d]
        y = g.i_c[d]
    else:
        ret 0 - 1
    end
    if x < 0 or y < 0 or g.v_kind[x] == VK_INT or g.v_kind[y] == VK_INT:
        ret 0 - 1
    end
    tt := g.i_b[t]
    ff := g.i_c[t]
    nb := new_blk(g)
    nc := ins_new(g, OP_CBR, T_VOID)
    g.i_a[nc] = y
    g.i_b[nc] = tt
    g.i_c[nc] = ff
    g.i_dbg[nc] = g.i_dbg[t]
    ins_append(g, nb, nc)
    g.i_a[t] = x
    moved := is_and ? tt : ff
    kept := is_and ? ff : tt
    if is_and:
        g.i_b[t] = nb
    else:
        g.i_c[t] = nb
    end
    phi_repred(g, moved, b, nb, false)
    mut pi := g.b_first[kept]
    until pi >= 0 and g.i_op[pi] == OP_PHI:
        phi_add(g, pi, phi_val_for(g, pi, b), nb)
        pi = g.i_next[pi]
    end
    ret nb
end

func and_branches(g &: Ng): bool:
    count_uses(g)
    mut changed := false
    mut wl := Vector {} as Vector<int>
    each b in g.b_rpo:
        wl.push(b)
    end
    mut k := 0
    until k < wl.len():
        bc := wl[k]
        k += 1
        nb := ab_split(g, bc)
        if nb >= 0:
            changed = true
            wl.push(bc)
            wl.push(nb)
        end
    end
    wl.free()
    if changed:
        ensure_terms(g)
        build_cfg(g)
    end
    ret changed
end
