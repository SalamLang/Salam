package nativegen

const IF_W8 := 16384
const VOP_MUL32 := 0x1F4
const VOP_CMPEQ64 := 0x1E0
const VOP_CMPGT64 := 0x1E1
const VOP_CMPHI64 := 0x1E2
const VOP_CMPHI32 := 0x1E3
const VOP_PMULLD := 0x3840
const VOP_PSHUFB := 0x3800
const VOP_PCMPEQQ := 0x3829
const VUN_BCD := 0x58
const VUN_BCQ := 0x59
const VUN_BCB := 0x78
const VUN_BCW := 0x79
const VUN_BCSS := 0x18
const VUN_BCSD := 0x19
const VUN_EXT := 0x39

func v41(g &: Ng): bool:
    ret g.sse41 and not g.off_sse41 and g.arch == NG_ARCH_X64
end

func ybcast(g &: Ng, x: int, kind: int): int:
    d := wide_reg(g)
    m := e_rr(g, M_VUN, 32, d, x)
    g.mc.cc[m] = kind
    g.mc.ymm[m] = true
    ret d
end

func yext_hi(g &: Ng, src: int): int:
    hi := xwide(g)
    m := e_rr(g, M_VUN, 32, hi, src)
    g.mc.cc[m] = VUN_EXT
    g.mc.imm[m] = 1 as i64
    g.mc.ymm[m] = true
    ret hi
end

func ybcast_gpr(g &: Ng, r: int, q: bool, kind: int): int:
    x := xmm(g)
    _m := e_rr(g, M_MOVQ_XG, q ? 8 : 4, x, r)
    ret ybcast(g, x, kind)
end

func vop(g &: Ng, opc: int, dst: int, src: int):
    m := e_rr(g, M_VOP_RR, 8, dst, src)
    g.mc.cc[m] = opc
end

func vcopy(g &: Ng, v: int): int:
    r := wide_reg(g)
    _c := e_copy(g, r, use_reg(g, v))
    ret r
end

func rcopy(g &: Ng, src: int): int:
    r := wide_reg(g)
    _c := e_copy(g, r, src)
    ret r
end

func vbyte_opc(op: int): int:
    switch op:
        OP_ADD: ret 0xFC end
        OP_SUB: ret 0xF8 end
        OP_AND: ret 0xDB end
        OP_OR: ret 0xEB end
        OP_XOR: ret 0xEF end
    end
    ret 0 - 1
end

func isel_vbyte_bin(g &: Ng, i: int):
    r := vcopy(g, g.i_a[i])
    vop(g, vbyte_opc(g.i_op[i]), r, use_reg(g, g.i_b[i]))
    set_res(g, i, r)
end

func vbyte_ge(g &: Ng, x: int, y: int): int:
    r := vcopy(g, x)
    vop(g, 0xDE, r, use_reg(g, y))
    vop(g, 0x74, r, use_reg(g, x))
    ret r
end

func isel_vbyte_cmp(g &: Ng, i: int):
    p := g.i_x[i]
    a := g.i_a[i]
    b := g.i_b[i]
    mut r := 0 - 1
    mut neg := false
    switch p:
        CC_EQ, CC_NE:
            r = vcopy(g, a)
            vop(g, 0x74, r, use_reg(g, b))
            neg = p == CC_NE
            break
        end
        CC_SGT, CC_SLE:
            r = vcopy(g, a)
            vop(g, 0x64, r, use_reg(g, b))
            neg = p == CC_SLE
            break
        end
        CC_SLT, CC_SGE:
            r = vcopy(g, b)
            vop(g, 0x64, r, use_reg(g, a))
            neg = p == CC_SGE
            break
        end
        CC_UGE, CC_ULT:
            r = vbyte_ge(g, a, b)
            neg = p == CC_ULT
            break
        end
        CC_ULE, CC_UGT:
            r = vbyte_ge(g, b, a)
            neg = p == CC_UGT
            break
        end
    end
    if neg:
        vnot(g, r)
    end
    set_res(g, i, r)
end

func isel_vbcast_byte(g &: Ng, i: int):
    w := g.t_elem[g.i_ty[i]] == T_I16
    if vk_on(g) and is_cint(g, g.i_a[i]):
        set_res(g, i, vsplat_ld(g, g.v_i[g.i_a[i]], w ? 2 : 1))
        ret
    end
    if g.isy:
        set_res(g, i, ybcast_gpr(g, use_reg(g, g.i_a[i]), false, w ? VUN_BCW : VUN_BCB))
        ret
    end
    k := gpr(g)
    zx := e_rr(g, M_MOVZX_RR, 4, k, use_reg(g, g.i_a[i]))
    g.mc.sz2[zx] = w ? 2 : 1
    m := e_rr(g, M_IMUL_RRI, 4, k, k)
    g.mc.imm[m] = (w ? 0x00010001 : 0x01010101) as i64
    rb := wide_reg(g)
    _x := e_rr(g, M_MOVQ_XG, 4, rb, k)
    s := e_rr(g, M_PSHUFD, 16, rb, rb)
    g.mc.imm[s] = 0 as i64
    set_res(g, i, rb)
end

func vint_opc_e(op: int, e: int): int:
    if e == T_I16:
        switch op:
            OP_ADD: ret 0xFD end
            OP_SUB: ret 0xF9 end
            OP_MUL: ret 0xD5 end
        end
    end
    ret vint_opc(op, e == T_I64)
end

func vint_opc(op: int, q: bool): int:
    switch op:
        OP_ADD: ret q ? 0xD4 : 0xFE end
        OP_SUB: ret q ? 0xFB : 0xFA end
        OP_AND: ret 0xDB end
        OP_OR: ret 0xEB end
        OP_XOR: ret 0xEF end
    end
    ret 0 - 1
end

func vshi(g &: Ng, r: int, opc: int, ext: int, k: i64):
    s := mi_new(g, M_VSHI, 16)
    g.mc.r0[s] = r
    g.mc.cc[s] = opc
    g.mc.sz2[s] = ext
    g.mc.imm[s] = k
end

func isel_vshift(g &: Ng, i: int):
    op := g.i_op[i]
    e := g.t_elem[g.i_ty[i]]
    cb := g.i_b[i]
    r := vcopy(g, g.i_a[i])
    if g.v_kind[cb] == VK_INT:
        vshi(g, r, e == T_I64 ? 0x73 : (e == T_I16 ? 0x71 : 0x72), op == OP_SHL ? 6 : (op == OP_LSHR ? 2 : 4), g.v_i[cb])
        set_res(g, i, r)
        ret
    end
    lo := e == T_I64 ? 3 : (e == T_I16 ? 1 : 2)
    base := op == OP_SHL ? 0xF0 : (op == OP_LSHR ? 0xD0 : 0xE0)
    vop(g, base + lo, r, use_reg(g, cb))
    set_res(g, i, r)
end

func isel_vint_bin(g &: Ng, i: int):
    op := g.i_op[i]
    t := g.i_ty[i]
    if op == OP_SHL or op == OP_LSHR or op == OP_ASHR:
        isel_vshift(g, i)
        ret
    end
    mut a := g.i_a[i]
    mut b := g.i_b[i]
    if op != OP_SUB and dies_here(g, b, i) and not dies_here(g, a, i) and not (g.v_kind[a] == VK_INS and g.i_op[g.v_def[a]] == OP_PHI):
        tmp := a
        a = b
        b = tmp
    end
    r2 := vcopy(g, a)
    vop(g, vint_opc_e(op, g.t_elem[t]), r2, use_reg(g, b))
    set_res(g, i, r2)
end

func vshr64(g &: Ng, r: int, k: int):
    s := mi_new(g, M_VSHI, 16)
    g.mc.r0[s] = r
    g.mc.cc[s] = 0x73
    g.mc.sz2[s] = 2
    g.mc.imm[s] = k as i64
end

func isel_vmul32(g &: Ng, i: int):
    b := use_reg(g, g.i_b[i])
    lo := vcopy(g, g.i_a[i])
    if g.isy or v41(g):
        vop(g, VOP_PMULLD, lo, b)
        set_res(g, i, lo)
        ret
    end
    if g.arch == NG_ARCH_A64:
        vop(g, VOP_MUL32, lo, b)
        set_res(g, i, lo)
        ret
    end
    vop(g, 0xF4, lo, b)
    hi := vcopy(g, g.i_a[i])
    vshr64(g, hi, 32)
    bh := wide_reg(g)
    _c := e_copy(g, bh, b)
    vshr64(g, bh, 32)
    vop(g, 0xF4, hi, bh)
    s1 := e_rr(g, M_PSHUFD, 16, lo, lo)
    g.mc.imm[s1] = 8 as i64
    s2 := e_rr(g, M_PSHUFD, 16, hi, hi)
    g.mc.imm[s2] = 8 as i64
    vop(g, 0x62, lo, hi)
    set_res(g, i, lo)
end

func vnot(g &: Ng, r: int):
    ones := wide_reg(g)
    _c := e_copy(g, ones, r)
    vop(g, 0x76, ones, ones)
    vop(g, 0xEF, r, ones)
end

func vrep64(v: i64, bytes: int): i64:
    if bytes >= 8:
        ret v
    end
    mut w := (bytes * 8) as i64
    mut x := v & (((1 as i64) << w) - (1 as i64))
    until w < (64 as i64):
        x |= (x << w)
        w *= (2 as i64)
    end
    ret x
end

func vk_mem(g &: Ng, v: i64, bytes: int): Mem:
    x := vrep64(v, bytes)
    if g.isy:
        ret vec_const32(g, x, x, x, x)
    end
    ret vec_const(g, x, x)
end

func vk_on(g &: Ng): bool:
    ret g.arch == NG_ARCH_X64 and not g.off_vkpool
end

func vsplat_ld(g &: Ng, v: i64, bytes: int): int:
    r := wide_reg(g)
    _l := e_rm(g, M_VLD, 16, r, vk_mem(g, v, bytes))
    ret r
end

func vop_k(g &: Ng, opc: int, dst: int, v: i64):
    if not vk_on(g):
        vop(g, opc, dst, vsplat32(g, v))
        ret
    end
    m := e_rm(g, M_VOP_RR, 8, dst, vk_mem(g, v, 4))
    g.mc.cc[m] = opc
end

func vsplat32(g &: Ng, v: i64): int:
    k := gpr(g)
    _m := e_movi(g, k, v)
    if g.isy:
        ret ybcast_gpr(g, k, false, VUN_BCD)
    end
    r := wide_reg(g)
    _x := e_rr(g, M_MOVQ_XG, 4, r, k)
    s := e_rr(g, M_PSHUFD, 16, r, r)
    g.mc.imm[s] = 0 as i64
    ret r
end

func vxor_bias(g &: Ng, src: int): int:
    r := rcopy(g, src)
    vop_k(g, 0xEF, r, 0x80000000 as i64)
    ret r
end

func vcmp_eq(g &: Ng, e: int, a: int, b: int): int:
    r := vcopy(g, a)
    if e == T_I16:
        vop(g, 0x75, r, use_reg(g, b))
        ret r
    end
    if e == T_I64 and g.arch == NG_ARCH_A64:
        vop(g, VOP_CMPEQ64, r, use_reg(g, b))
        ret r
    end
    if e == T_I64 and v41(g):
        vop(g, VOP_PCMPEQQ, r, use_reg(g, b))
        ret r
    end
    vop(g, 0x76, r, use_reg(g, b))
    if e == T_I64:
        t := wide_reg(g)
        s := e_rr(g, M_PSHUFD, 16, t, r)
        g.mc.imm[s] = 0xB1 as i64
        vop(g, 0xDB, r, t)
    end
    ret r
end

func vcmp_gt(g &: Ng, e: int, a: int, b: int, uns: bool): int:
    if e == T_I16:
        if not uns:
            r := vcopy(g, a)
            vop(g, 0x65, r, use_reg(g, b))
            ret r
        end
        t := vcopy(g, a)
        vop(g, 0xD9, t, use_reg(g, b))
        z := wide_reg(g)
        _z := e_rr(g, M_XORPS, 16, z, z)
        vop(g, 0x75, t, z)
        vnot(g, t)
        ret t
    end
    if g.arch == NG_ARCH_A64 and (e == T_I64 or uns):
        r2 := vcopy(g, a)
        vop(g, e == T_I64 ? (uns ? VOP_CMPHI64 : VOP_CMPGT64) : VOP_CMPHI32, r2, use_reg(g, b))
        ret r2
    end
    if not uns:
        r3 := vcopy(g, a)
        vop(g, 0x66, r3, use_reg(g, b))
        ret r3
    end
    ba := vxor_bias(g, use_reg(g, a))
    vop(g, 0x66, ba, vxor_bias(g, use_reg(g, b)))
    ret ba
end

func vgt_regs(g &: Ng, e: int, ra: int, rb: int, uns: bool): int:
    if g.arch == NG_ARCH_A64 and (e == T_I64 or uns):
        r := rcopy(g, ra)
        vop(g, e == T_I64 ? (uns ? VOP_CMPHI64 : VOP_CMPGT64) : VOP_CMPHI32, r, rb)
        ret r
    end
    if not uns:
        r2 := rcopy(g, ra)
        vop(g, 0x66, r2, rb)
        ret r2
    end
    ba := vxor_bias(g, ra)
    vop(g, 0x66, ba, vxor_bias(g, rb))
    ret ba
end

func vblend_on(g &: Ng): bool:
    ret g.arch == NG_ARCH_X64 and not g.off_vblend and (g.avx2 or v41(g))
end

func vblend(g &: Ng, m: int, tv: int, fr: int):
    if g.avx2:
        mb := e_rr(g, M_VBLEND, 8, fr, tv)
        g.mc.r2[mb] = m
        ret
    end
    g.mc.vhint[m] = XMM0
    _c := e_copy(g, XMM0, m)
    _b := e_rr(g, M_VBLEND, 8, fr, tv)
end

func vmm_opc(e: int, mx: bool, uns: bool): int:
    if e == T_I32:
        ret mx ? (uns ? 0x383F : 0x383D) : (uns ? 0x383B : 0x3839)
    end
    if e == T_I16:
        ret mx ? (uns ? 0x383E : 0xEE) : (uns ? 0x383A : 0xEA)
    end
    if e == T_I8:
        ret mx ? (uns ? 0xDE : 0x383C) : (uns ? 0xDA : 0x3838)
    end
    ret 0 - 1
end

func vmm_step(g &: Ng, opc: int, a: int, b: int): int:
    r := rcopy(g, a)
    vop(g, opc, r, b)
    ret r
end

func vpick(g &: Ng, m: int, a: int, b: int): int:
    if v41(g) and vblend_on(g):
        r := rcopy(g, b)
        vblend(g, m, a, r)
        ret r
    end
    x := rcopy(g, m)
    vop(g, 0xDB, x, a)
    y := rcopy(g, m)
    vop(g, 0xDF, y, b)
    vop(g, 0xEB, x, y)
    ret x
end

func isel_vredmm(g &: Ng, i: int):
    a := g.i_a[i]
    e := g.t_elem[g.v_ty[a]]
    kind := g.i_x[i]
    uns := kind >= 3
    mx := kind == 1 or kind == 3
    mo := v41(g) ? vmm_opc(e, mx, uns) : 0 - 1
    mut acc := use_reg(g, a)
    if is_ymm(g, g.v_ty[a]):
        hi := yext_hi(g, acc)
        if mo >= 0:
            acc = vmm_step(g, mo, acc, hi)
        else:
            m0 := mx ? vgt_regs(g, e, acc, hi, uns) : vgt_regs(g, e, hi, acc, uns)
            acc = vpick(g, m0, acc, hi)
        end
    end
    repeat (e == T_I64 ? 1 : 2) in st:
        sh := wide_reg(g)
        s := e_rr(g, M_PSHUFD, 16, sh, acc)
        g.mc.imm[s] = (st == 0 ? 0x4E : 0xB1) as i64
        if mo >= 0:
            acc = vmm_step(g, mo, acc, sh)
            continue
        end
        m := mx ? vgt_regs(g, e, acc, sh, uns) : vgt_regs(g, e, sh, acc, uns)
        acc = vpick(g, m, acc, sh)
    end
    r := gpr(g)
    _m := e_rr(g, M_MOVQ_GX, e == T_I64 ? 8 : 4, r, acc)
    set_res(g, i, r)
end

func isel_vcmp(g &: Ng, i: int):
    p := g.i_x[i]
    a := g.i_a[i]
    b := g.i_b[i]
    e := g.t_elem[g.v_ty[a]]
    mut r := 0 - 1
    switch p:
        CC_EQ, CC_NE:
            r = vcmp_eq(g, e, a, b)
            break
        end
        CC_SGT, CC_SLE:
            r = vcmp_gt(g, e, a, b, false)
            break
        end
        CC_SLT, CC_SGE:
            r = vcmp_gt(g, e, b, a, false)
            break
        end
        CC_UGT, CC_ULE:
            r = vcmp_gt(g, e, a, b, true)
            break
        end
        CC_ULT, CC_UGE:
            r = vcmp_gt(g, e, b, a, true)
            break
        end
    end
    if p == CC_NE or p == CC_SLE or p == CC_SGE or p == CC_ULE or p == CC_UGE:
        vnot(g, r)
    end
    set_res(g, i, r)
end

func vneg_of(g &: Ng, v: int, x: int): bool:
    if v < 0 or g.v_kind[v] != VK_INS:
        ret false
    end
    d := g.v_def[v]
    ret g.i_op[d] == OP_SUB and g.i_b[d] == x and g.i_a[d] >= 0 and g.v_kind[g.i_a[d]] == VK_ZERO
end

func vabs_src(g &: Ng, i: int): int:
    if g.off_vabs or g.arch != NG_ARCH_X64:
        ret 0 - 1
    end
    e := g.t_elem[g.i_ty[i]]
    m := g.i_a[i]
    if (e != T_I32 and e != T_I16 and (e != T_I8 or not (g.avx2 or v41(g)))) or m < 0 or g.v_kind[m] != VK_INS:
        ret 0 - 1
    end
    d := g.v_def[m]
    if g.i_op[d] != OP_ICMP:
        ret 0 - 1
    end
    p := g.i_x[d]
    a := g.i_a[d]
    b := g.i_b[d]
    za := a >= 0 and g.v_kind[a] == VK_ZERO
    zb := b >= 0 and g.v_kind[b] == VK_ZERO
    plt := p == CC_SLT or p == CC_SLE
    pgt := p == CC_SGT or p == CC_SGE
    mut x := 0 - 1
    mut negfirst := false
    if zb and (plt or pgt):
        x = a
        negfirst = plt
    else za and (plt or pgt):
        x = b
        negfirst = pgt
    end
    if x < 0 or g.t_elem[g.v_ty[x]] != e:
        ret 0 - 1
    end
    neg := negfirst ? g.i_b[i] : g.i_c[i]
    pos := negfirst ? g.i_c[i] : g.i_b[i]
    if pos != x or not vneg_of(g, neg, x):
        ret 0 - 1
    end
    ret x
end

func vmm_of_sel(g &: Ng, i: int): int:
    m := g.i_a[i]
    if not v41(g) or m < 0 or g.v_kind[m] != VK_INS:
        ret 0 - 1
    end
    d := g.v_def[m]
    if g.i_op[d] != OP_ICMP:
        ret 0 - 1
    end
    p := g.i_x[d]
    up := p == CC_SGT or p == CC_SGE or p == CC_UGT or p == CC_UGE
    dn := p == CC_SLT or p == CC_SLE or p == CC_ULT or p == CC_ULE
    if not up and not dn:
        ret 0 - 1
    end
    uns := p == CC_UGT or p == CC_UGE or p == CC_ULT or p == CC_ULE
    e := g.t_elem[g.i_ty[i]]
    if g.i_b[i] == g.i_a[d] and g.i_c[i] == g.i_b[d]:
        ret vmm_opc(e, up, uns)
    end
    if g.i_b[i] == g.i_b[d] and g.i_c[i] == g.i_a[d]:
        ret vmm_opc(e, dn, uns)
    end
    ret 0 - 1
end

func vabs_mark(g &: Ng, i: int):
    if vmm_of_sel(g, i) >= 0 and g.v_uses[g.i_a[i]] == 1:
        g.skipi[g.v_def[g.i_a[i]]] = true
    end
    x := vabs_src(g, i)
    if x < 0:
        ret
    end
    m := g.i_a[i]
    if g.v_uses[m] == 1:
        g.skipi[g.v_def[m]] = true
    end
    each nv in [g.i_b[i], g.i_c[i]]:
        if nv != x and g.v_uses[nv] == 1:
            g.skipi[g.v_def[nv]] = true
        end
    end
end

func isel_vsel(g &: Ng, i: int):
    ax := vabs_src(g, i)
    if ax >= 0:
        e := g.t_elem[g.i_ty[i]]
        if not g.avx2 and not v41(g):
            sg := vcopy(g, ax)
            vshi(g, sg, e == T_I32 ? 0x72 : 0x71, 4, (e == T_I32 ? 31 : 15) as i64)
            rx := vcopy(g, ax)
            vop(g, 0xEF, rx, sg)
            vop(g, e == T_I32 ? 0xFA : 0xF9, rx, sg)
            set_res(g, i, rx)
            ret
        end
        ra := wide_reg(g)
        mu := e_rr(g, M_VUN, 32, ra, use_reg(g, ax))
        g.mc.cc[mu] = e == T_I32 ? 0x1E : (e == T_I16 ? 0x1D : 0x1C)
        set_res(g, i, ra)
        ret
    end
    m := g.i_a[i]
    bv := g.i_b[i]
    mo := vmm_of_sel(g, i)
    if mo >= 0:
        sw := dies_here(g, g.i_c[i], i) and not dies_here(g, bv, i)
        rr := vcopy(g, sw ? g.i_c[i] : bv)
        vop(g, mo, rr, use_reg(g, sw ? bv : g.i_c[i]))
        set_res(g, i, rr)
        ret
    end
    if vblend_on(g):
        rm := use_reg(g, m)
        rbv := use_reg(g, bv)
        rb := vcopy(g, g.i_c[i])
        vblend(g, rm, rbv, rb)
        set_res(g, i, rb)
        ret
    end
    mut r := 0 - 1
    if dies_here(g, bv, i) and bv != m:
        r = vcopy(g, bv)
        vop(g, 0xDB, r, use_reg(g, m))
    else:
        r = vcopy(g, m)
        vop(g, 0xDB, r, use_reg(g, bv))
    end
    t := vcopy(g, m)
    vop(g, 0xDF, t, use_reg(g, g.i_c[i]))
    vop(g, 0xEB, r, t)
    set_res(g, i, r)
end

func isel_vbcast_int(g &: Ng, i: int):
    q := g.t_elem[g.i_ty[i]] == T_I64
    if vk_on(g) and is_cint(g, g.i_a[i]):
        set_res(g, i, vsplat_ld(g, g.v_i[g.i_a[i]], q ? 8 : 4))
        ret
    end
    if g.isy:
        set_res(g, i, ybcast_gpr(g, use_reg(g, g.i_a[i]), q, q ? VUN_BCQ : VUN_BCD))
        ret
    end
    rb := wide_reg(g)
    _m := e_rr(g, M_MOVQ_XG, q ? 8 : 4, rb, use_reg(g, g.i_a[i]))
    if q:
        vop(g, 0x6C, rb, rb)
    else:
        s := e_rr(g, M_PSHUFD, 16, rb, rb)
        g.mc.imm[s] = 0 as i64
    end
    set_res(g, i, rb)
end

func ystore_w8(g &: Ng, i: int):
    r := vcopy(g, g.i_a[i])
    w := g.t_elem[g.v_ty[g.i_a[i]]] == T_I16
    vop_k(g, 0xDB, r, (w ? 0x00FF00FF : 255) as i64)
    hi := yext_hi(g, r)
    p1 := e_rr(g, M_VOP_RR, 8, r, hi)
    g.mc.cc[p1] = w ? 0x67 : 0x6B
    g.mc.ymm[p1] = false
    m := mem_of(g, g.i_b[i], 0 as i64)
    if w:
        s1 := e_mr(g, M_VST, 16, m, r)
        g.mc.ymm[s1] = false
        ret
    end
    p2 := e_rr(g, M_VOP_RR, 8, r, r)
    g.mc.cc[p2] = 0x67
    g.mc.ymm[p2] = false
    _s2 := e_mr(g, M_FST, 8, m, r)
end

func yload_w8(g &: Ng, i: int, m: Mem):
    w := (g.i_x[i] & 3) == 2 ? 2 : 1
    sgn := (g.i_x[i] & 4) != 0
    e16 := g.t_elem[g.i_ty[i]] == T_I16
    mut k := e16 ? 0x20 : (w == 2 ? 0x23 : 0x21)
    if not sgn:
        k += 0x10
    end
    d := wide_reg(g)
    mu := e_rm(g, M_VUN, 32, d, m)
    g.mc.cc[mu] = k
    g.mc.ymm[mu] = true
    set_res(g, i, d)
end

func isel_vstore_w8(g &: Ng, i: int):
    if is_ymm(g, g.v_ty[g.i_a[i]]):
        ystore_w8(g, i)
        ret
    end
    r := vcopy(g, g.i_a[i])
    if v41(g):
        w16 := g.t_elem[g.v_ty[g.i_a[i]]] == T_I16
        mp := w16 ? vec_const(g, 0x0E0C0A0806040200 as i64, 0 as i64) : vec_const(g, 0x0C080400 as i64, 0 as i64)
        ps := e_rm(g, M_VOP_RR, 8, r, mp)
        g.mc.cc[ps] = VOP_PSHUFB
        if w16:
            _f8 := e_mr(g, M_FST, 8, mem_of(g, g.i_b[i], 0 as i64), r)
        else:
            _f4 := e_mr(g, M_VST32, 4, mem_of(g, g.i_b[i], 0 as i64), r)
        end
        ret
    end
    if g.t_elem[g.v_ty[g.i_a[i]]] == T_I16:
        vop_k(g, 0xDB, r, 0x00FF00FF as i64)
        vop(g, 0x67, r, r)
        _s8 := e_mr(g, M_FST, 8, mem_of(g, g.i_b[i], 0 as i64), r)
        ret
    end
    k := gpr(g)
    _m := e_movi(g, k, 255 as i64)
    mk := wide_reg(g)
    _x := e_rr(g, M_MOVQ_XG, 4, mk, k)
    s := e_rr(g, M_PSHUFD, 16, mk, mk)
    g.mc.imm[s] = 0 as i64
    vop(g, 0xDB, r, mk)
    vop(g, 0x6B, r, r)
    vop(g, 0x67, r, r)
    _st := e_mr(g, M_VST32, 4, mem_of(g, g.i_b[i], 0 as i64), r)
end

func isel_vload_w8(g &: Ng, i: int, m: Mem):
    if is_ymm(g, g.i_ty[i]):
        yload_w8(g, i, m)
        ret
    end
    w := (g.i_x[i] & 3) == 2 ? 2 : 1
    sgn := (g.i_x[i] & 4) != 0
    r := wide_reg(g)
    if v41(g):
        mut kl := g.t_elem[g.i_ty[i]] == T_I16 ? 0x20 : (w == 2 ? 0x23 : 0x21)
        if not sgn:
            kl += 0x10
        end
        ml := e_rm(g, M_VUN, 16, r, m)
        g.mc.cc[ml] = kl
        set_res(g, i, r)
        ret
    end
    if g.t_elem[g.i_ty[i]] == T_I16:
        _l8 := e_rm(g, M_FLD, 8, r, m)
        if sgn:
            vop(g, 0x60, r, r)
            vshi(g, r, 0x71, 4, 8 as i64)
        else:
            z8 := wide_reg(g)
            _x8 := e_rr(g, M_XORPS, 8, z8, z8)
            vop(g, 0x60, r, z8)
        end
        set_res(g, i, r)
        ret
    end
    if w == 2:
        _l2 := e_rm(g, M_FLD, 8, r, m)
    else:
        _l := e_rm(g, M_VLD32, 4, r, m)
    end
    if sgn:
        if w == 1:
            vop(g, 0x60, r, r)
        end
        vop(g, 0x61, r, r)
        s := mi_new(g, M_VSHI, 16)
        g.mc.r0[s] = r
        g.mc.cc[s] = 0x72
        g.mc.sz2[s] = 4
        g.mc.imm[s] = (w == 1 ? 24 : 16) as i64
        set_res(g, i, r)
        ret
    end
    z := wide_reg(g)
    _x := e_rr(g, M_XORPS, 8, z, z)
    if w == 1:
        vop(g, 0x60, r, z)
    end
    vop(g, 0x61, r, z)
    set_res(g, i, r)
end
