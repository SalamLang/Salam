func nl_fail(l &: Nl, msg: str):
    if l.ok:
        l.ok = false
        l.err = msg
    end
end

func rd8(p: u8*, o: i64): int:
    ret p[o] as int
end

func rd16(p: u8*, o: i64): int:
    ret (p[o] as int) | ((p[o + (1 as i64)] as int) << 8)
end

func rd32(p: u8*, o: i64): i64:
    mut v := 0 as i64
    repeat 4 in k:
        v = v | ((p[o + (k as i64)] as i64) << ((8 * k) as i64))
    end
    ret v
end

func rd64(p: u8*, o: i64): i64:
    mut v := 0 as i64
    repeat 8 in k:
        v = v | ((p[o + (k as i64)] as i64) << ((8 * k) as i64))
    end
    ret v
end

func rd32be(p: u8*, o: i64): i64:
    mut v := 0 as i64
    repeat 4 in k:
        v = (v << (8 as i64)) | (p[o + (k as i64)] as i64)
    end
    ret v
end

func wr32(p: u8*, o: i64, v: i64):
    repeat 4 in k:
        p[o + (k as i64)] = ((v >> ((8 * k) as i64)) & (255 as i64)) as u8
    end
end

func wr64(p: u8*, o: i64, v: i64):
    repeat 8 in k:
        p[o + (k as i64)] = ((v >> ((8 * k) as i64)) & (255 as i64)) as u8
    end
end

func fptr(l &: Nl, f: int): u8*:
    ret l.f_ptr[f] as void* as u8*
end

func nl_hash(p: u8*, s: i64, n: int): int:
    mut h := 2166136261 as u32
    repeat n in i:
        h = (h ^ (p[s + (i as i64)] as u32)) * (16777619 as u32)
    end
    ret (h & (0x7FFFFFFF as u32)) as int
end

func nt_init(t &: NlTab, cap: int):
    t.slots.clear()
    repeat cap:
        t.slots.push(0 - 1)
    end
    t.mask = cap - 1
    t.n = 0
end

func nt_eq(t &: NlTab, id: int, p: u8*, s: i64, n: int): bool:
    if t.len[id] != n:
        ret false
    end
    o := t.off[id]
    repeat n in i:
        if t.bytes[o + i] != p[s + (i as i64)]:
            ret false
        end
    end
    ret true
end

func nt_grow(t &: NlTab):
    cap := (t.mask + 1) * 2
    t.slots.clear()
    repeat cap:
        t.slots.push(0 - 1)
    end
    t.mask = cap - 1
    repeat t.n in id:
        mut j := t.hash[id] & t.mask
        until t.slots[j] >= 0:
            j = (j + 1) & t.mask
        end
        t.slots[j] = id
    end
end

func nt_find(t &: NlTab, p: u8*, s: i64, n: int, add: bool): int:
    h := nl_hash(p, s, n)
    mut j := h & t.mask
    until true:
        id := t.slots[j]
        if id < 0:
            break
        end
        if t.hash[id] == h and nt_eq(t, id, p, s, n):
            ret id
        end
        j = (j + 1) & t.mask
    end
    if not add:
        ret 0 - 1
    end
    nid := t.n
    t.off.push(t.bytes.len())
    t.len.push(n)
    t.hash.push(h)
    repeat n in i:
        t.bytes.push(p[s + (i as i64)])
    end
    t.slots[j] = nid
    t.n += 1
    if t.n * 2 > t.mask:
        nt_grow(t)
    end
    ret nid
end

func cstr_len(p: u8*, s: i64, lim: i64): int:
    mut n := 0
    until s + (n as i64) < lim and p[s + (n as i64)] != (0 as u8):
        n += 1
    end
    ret n
end

func name_of(l &: Nl, id: int): str:
    mut b := str.NewBuilder()
    o := l.names.off[id]
    repeat l.names.len[id] in i:
        str.BufAppendChar(b, l.names.bytes[o + i] as int)
    end
    r := str.BufStr(b)
    str.BufFree(b)
    ret r
end

func name_id(l &: Nl, s: str): int:
    ret nt_find(l.names, (s as void*) as u8*, 0 as i64, str.Len(s), true)
end

func name_is(l &: Nl, id: int, s: str): bool:
    n := str.Len(s)
    if l.names.len[id] != n:
        ret false
    end
    p := (s as void*) as u8*
    o := l.names.off[id]
    repeat n in i:
        if l.names.bytes[o + i] != p[i]:
            ret false
        end
    end
    ret true
end

func name_starts(l &: Nl, id: int, s: str): bool:
    n := str.Len(s)
    if l.names.len[id] < n:
        ret false
    end
    p := (s as void*) as u8*
    o := l.names.off[id]
    repeat n in i:
        if l.names.bytes[o + i] != p[i]:
            ret false
        end
    end
    ret true
end

func align_to(x: i64, a: i64): i64:
    if a <= (1 as i64):
        ret x
    end
    ret (x + a - (1 as i64)) / a * a
end

func read_file(l &: Nl, path: str): int:
    f := fopen(path, "rb")
    if f == null:
        nl_fail(l, "cannot open " + path)
        ret 0 - 1
    end
    _s := fseek(f, 0 as i64, 2)
    n := ftell(f)
    _r := fseek(f, 0 as i64, 0)
    buf := malloc((n + (1 as i64)) as u64)
    got := fread(buf, 1 as u64, n as u64, f)
    _c := fclose(f)
    if (got as i64) != n:
        nl_fail(l, "cannot read " + path)
        ret 0 - 1
    end
    id := l.f_ptr.len()
    l.f_ptr.push(buf as i64)
    l.f_size.push(n)
    l.f_name.push(path)
    l.f_arch.push(false)
    l.f_long.push(0 - 1 as i64)
    ret id
end

pub func New(): Nl:
    mut l := Nl {}
    nt_init(l.names, 4096)
    ret l
end

pub func Error(l &: Nl): str:
    ret l.err
end

pub func AddInput(l &: Nl, path: str):
    add_input_as(l, path, false)
end

pub func AddInputAsNeeded(l &: Nl, path: str):
    add_input_as(l, path, true)
end

pub func SetWindows(l &: Nl):
    l.pe = true
end

pub func SetDynamic(l &: Nl, interp: str):
    l.dynamic = true
    if str.Len(interp) > 0:
        l.interp = interp
    end
end

pub func Link(l &: Nl, out: str): bool:
    if not l.ok:
        ret false
    end
    resolve(l)
    if not l.ok:
        ret false
    end
    if l.pe:
        pe_link(l, out)
        ret l.ok
    end
    if l.macho:
        macho_link(l, out)
        ret l.ok
    end
    mark_live(l)
    if l.mach == EM_386 and not l.dynamic:
        l.base = 0x08048000 as i64
    end
    if not l.strip:
        dbg_collect(l)
    end
    if l.dynamic:
        dyn_prepare(l)
        if not l.ok:
            ret false
        end
        place_dyn(l)
    else:
        place_all(l)
    end
    if not l.ok:
        ret false
    end
    if l.dynamic:
        apply_dyn(l)
    else:
        apply_relocs(l)
    end
    if not l.ok:
        ret false
    end
    ehh_build(l, l.out_ptr as void* as u8*)
    if not l.strip:
        dbg_build(l)
    end
    write_exe(l, out)
    ret l.ok
end

pub func Stats(l &: Nl): str:
    mut live := 0
    repeat l.s_live.len() in i:
        if l.s_live[i]:
            live += 1
        end
    end
    ret str.FromInt(l.o_file.len() as i64) + " objects, " + str.FromInt(live as i64) + " live sections, " + str.FromInt(l.g_name.len() as i64) + " symbols, " + str.FromInt(l.stat_relax as i64) + " GOT loads relaxed, " + str.FromInt(l.file_size) + " bytes"
end
