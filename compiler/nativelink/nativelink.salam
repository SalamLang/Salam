package nativelink

import str

extern:
    func fopen(path: str, mode: str): void*
    func fread(p: void*, sz: u64, n: u64, f: void*): u64
    func fwrite(p: void*, sz: u64, n: u64, f: void*): u64
    func fseek(f: void*, off: i64, whence: int): int
    func ftell(f: void*): i64
    func fclose(f: void*): int
    func malloc(n: u64): void*
    func free(p: void*)
    func chmod(path: str, mode: int): int
end

const NL_BASE := 0x400000
const NL_PAGE := 0x1000

const OC_NONE := 0 - 1
const EM_386 := 3
const EM_ARM := 40
const EM_X86_64 := 62
const EM_AARCH64 := 183
const EM_RISCV := 243
const OC_RODATA := 0
const OC_EHFRAME := 1
const OC_INIT := 2
const OC_TEXT := 3
const OC_FINI := 4
const OC_INITARR := 5
const OC_FINIARR := 6
const OC_DATA := 7
const OC_GOT := 8
const OC_BSS := 9
const OC_PLT := 10
const OC_DATAREL := 11
const OC_EHHDR := 12
const OC_COUNT := 13

const SY_UNDEF := 0
const SY_DEF := 1
const SY_ABS := 2
const SY_SHARED := 3

pub struct NlTab:
    pub slots: Vector<int> = Vector {}
    pub off: Vector<int> = Vector {}
    pub len: Vector<int> = Vector {}
    pub hash: Vector<int> = Vector {}
    pub bytes: Vector<u8> = Vector {}
    pub n: int = 0
    pub mask: int = 0
end

