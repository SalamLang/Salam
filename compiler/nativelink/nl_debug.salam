package nativelink

func dbg_out_index(l &: Nl, nm: int): int:
    repeat l.dg_name.len() in i:
        if l.dg_name[i] == nm:
            ret i
        end
    end
    l.dg_name.push(nm)
    l.dg_size.push(0 as i64)
    l.dg_base.push(0 as i64)
    ret l.dg_name.len() - 1
end

func dbg_collect(l &: Nl):
    mut olive := Vector {} as Vector<bool>
    repeat l.o_file.len():
        olive.push(false)
    end
    repeat l.s_obj.len() in s:
        l.s_dbg.push(0 - 1)
        if l.s_live[s]:
            olive[l.s_obj[s]] = true
        end
    end
    repeat l.s_obj.len() in s2:
        if not olive[l.s_obj[s2]] or l.s_type[s2] != 1 or (l.s_flags[s2] & (2 as i64)) != (0 as i64):
            continue
        end
        if not name_starts(l, l.s_name[s2], ".debug_"):
            continue
        end
        k := dbg_out_index(l, l.s_name[s2])
        off := align_to(l.dg_size[k], l.s_align[s2])
        l.s_addr[s2] = off
        l.s_dbg[s2] = k
        l.dg_size[k] = off + l.s_size[s2]
    end
    olive.free()
end

func dbg_build(l &: Nl):
    mut total := 0 as i64
    repeat l.dg_name.len() in k:
        l.dg_base[k] = total
        total = total + l.dg_size[k]
    end
    repeat total:
        l.dg_bytes.push(0 as u8)
    end
    buf := l.dg_bytes.data
    repeat l.s_obj.len() in s:
        k2 := l.s_dbg[s]
        if k2 < 0:
            continue
        end
        p := fptr(l, l.o_file[l.s_obj[s]])
        dst := l.dg_base[k2] + l.s_addr[s]
        src := l.s_off[s]
        repeat l.s_size[s] in q:
            buf[dst + q] = p[src + q]
        end
        r0 := l.s_rel0[s]
        repeat l.s_nrel[s] in j:
            r := r0 + j
            ty := l.r_type[r]
            os := l.r_sym[r]
            t := sym_sec(l, os)
            dead := t >= 0 and not l.s_live[t] and l.s_dbg[t] < 0
            v := dead ? (0 as i64) : sym_addr(l, os) + l.r_add[r]
            place := dst + l.r_off[r]
            if ty == 1:
                wr64(buf, place, v)
            else ty == 10 or ty == 11:
                wr32(buf, place, v)
            end
        end
    end
end

func dbg_collect_pe(l &: Nl):
    repeat l.s_obj.len() in s:
        l.s_dbg.push(0 - 1)
        if not l.o_coff[l.s_obj[s]] or l.s_drop[s] or l.s_off[s] <= (0 as i64):
            continue
        end
        if not name_starts(l, l.s_name[s], ".debug_"):
            continue
        end
        k := dbg_out_index(l, l.s_name[s])
        off := align_to(l.dg_size[k], l.s_align[s])
        l.s_addr[s] = off
        l.s_dbg[s] = k
        l.dg_size[k] = off + l.s_size[s]
    end
end

func dbg_build_pe(l &: Nl):
    mut total := 0 as i64
    repeat l.dg_name.len() in k:
        l.dg_base[k] = total
        total = total + l.dg_size[k]
    end
    repeat total:
        l.dg_bytes.push(0 as u8)
    end
    buf := l.dg_bytes.data
    repeat l.s_obj.len() in s:
        k2 := l.s_dbg[s]
        if k2 < 0:
            continue
        end
        p := fptr(l, l.o_file[l.s_obj[s]])
        dst := l.dg_base[k2] + l.s_addr[s]
        repeat l.s_size[s] in q:
            buf[dst + q] = p[l.s_off[s] + q]
        end
        r0 := l.s_rel0[s]
        repeat l.s_nrel[s] in j:
            r := r0 + j
            ty := l.r_type[r] - CR_BASE
            os := l.r_sym[r]
            place := dst + l.r_off[r]
            sv := pe_sym(l, os)
            if ty == 1:
                wr64(buf, place, sv + rd64(buf, place))
            else ty == 11:
                wr32(buf, place, sv + rd32s(buf, place))
            else ty == 3:
                wr32(buf, place, sv + rd32s(buf, place) - PE_BASE)
            end
        end
    end
end

func dbg_layout_pe(l &: Nl, va0: i64, raw0: i64): i64:
    mut va := va0
    mut raw := raw0
    repeat l.dg_name.len() in k:
        l.dg_va.push(va)
        l.dg_raw.push(raw)
        va = align_to(va + l.dg_size[k], 0x1000 as i64)
        raw = raw + align_to(l.dg_size[k], 0x200 as i64)
        nm := name_of(l, l.dg_name[k])
        if str.Len(nm) > 8:
            l.pe_stroff.push(l.pe_str.len() + 4)
            tb_cstr(l.pe_str, nm)
        else:
            l.pe_stroff.push(0 - 1)
        end
    end
    l.pe_strpos = raw
    ret va
end
