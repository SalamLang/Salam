package nativelink

const DS_INTERP := 0
const DS_GHASH := 1
const DS_DYNSYM := 2
const DS_DYNSTR := 3
const DS_VERSYM := 4
const DS_VERNEED := 5
const DS_RELA := 6
const DS_PLT := 7
const DS_DYNAMIC := 8
const DS_GOT := 9
const DS_COUNT := 10
const DK_NONE := 0
const DK_CALL := 1
const DK_GOT := 2
const DK_ABSW := 3
const DK_ABS32 := 4
const DK_ADDR := 5

pub struct Dyn:
    pub str: Vector<u8> = Vector {}
    pub sym_str: Vector<i64> = Vector {}
    pub lib_str: Vector<i64> = Vector {}
    pub vn_lib: Vector<int> = Vector {}
    pub vn_name: Vector<int> = Vector {}
    pub vn_str: Vector<i64> = Vector {}
    pub nrela: int = 0
    pub ndynent: int = 0
    pub soname_str: i64 = 0
end

func dyn_prepare(l &: Nl):
    if l.shared:
        if has_tls(l):
            nl_fail(
                l,
                "cannot link a shared library: thread-local variables are not supported in one yet"
            )
            ret
        end
        repeat l.g_name.Len() in eg:
            if l.expd.Has(eg):
                need_dyn(l, eg)
            end
        end
    end
    repeat l.s_obj.Len() in s:
        if not l.s_live[s] or l.s_oc[s] == OC_NONE:
            continue
        end
        r0 := l.s_rel0[s]
        repeat l.s_nrel[s] in k:
            r := r0 + k
            ty := l.r_type[r]
            os := l.r_sym[r]
            g := shared_g(l, os)
            tk := tls_got_kind(l, ty)
            if tk > 0:
                _ts := tls_slot(l, os, tk)
                if g >= 0:
                    need_dyn(l, g)
                end
                continue
            end
            if g >= 0 and l.mach == EM_AARCH64 and
                (ty == 562 or ty == 563 or ty == 564 or ty == 569):
                _td := tls_slot(l, os, TG_TP)
                need_dyn(l, g)
                continue
            end
            dk := dyn_kind(l, ty)
            if l.shared and so_abs_code(l, ty):
                nl_fail(
                    l,
                    "cannot link a shared library: an absolute address in code at " +
                        reloc_where(l, s, r) + " is not position independent"
                )
                ret
            end
            if g >= 0:
                obj := l.g_stype[g] == 1
                if l.shared and obj and dk != DK_GOT and dk != DK_ABSW:
                    nl_fail(
                        l,
                        "cannot link a shared library: shared variable '" + name_of(
                            l, l.g_name[g]
                        ) + "' is used without the GOT at " + reloc_where(l, s, r)
                    )
                    ret
                end
                if l.g_stype[g] == 6:
                    nl_fail(
                        l,
                        "thread-local symbol '" + name_of(
                            l, l.g_name[g]
                        ) +
                            "' from a shared library needs initial-exec or general-dynamic access at " +
                            reloc_where(l, s, r)
                    )
                    ret
                end
                if dk == DK_CALL:
                    if obj:
                        need_copy(l, g)
                    else:
                        need_plt(l, g)
                    end
                else dk == DK_GOT:
                    need_got(l, g)
                else dk == DK_ABSW:
                    if sec_writable(l, s) or l.shared:
                        need_dyn(l, g)
                        l.stat_dynrel++
                        if not sec_writable(l, s):
                            l.textrel = true
                        end
                    else obj:
                        need_copy(l, g)
                    else:
                        need_canon(l, g)
                    end
                else dk == DK_ADDR or (dk == DK_ABS32 and not l.pie):
                    if obj:
                        need_copy(l, g)
                    else l.shared:
                        need_plt(l, g)
                    else:
                        need_canon(l, g)
                    end
                else:
                    nl_fail(
                        l,
                        "unsupported relocation type " + str.FromInt(ty as i64) +
                            " against a shared library symbol at " + reloc_where(l, s, r)
                    )
                    ret
                end
            else:
                if dk == DK_ABSW:
                    if l.pie and is_addr_sym(l, os):
                        l.stat_dynrel++
                        if l.shared and not sec_writable(l, s):
                            l.textrel = true
                        end
                    end
                else dk == DK_ABS32:
                    if l.pie and is_addr_sym(l, os):
                        nl_fail(
                            l,
                            "a 32-bit absolute address cannot be used in a position-independent executable at " +
                                reloc_where(l, s, r)
                        )
                        ret
                    end
                else dk == DK_GOT:
                    if not dyn_got_relaxable(l, s, r):
                        g2 := l.os_glob[os]
                        if g2 >= 0:
                            need_got(l, g2)
                        else:
                            got_add(l, os)
                        end
                    end
                end
            end
        end
    end
    repeat l.got_sym.Len() in q:
        gs := l.got_sym[q]
        if l.got_tlsk.Has(q):
            if gs >= 0 and l.g_state[gs] == SY_SHARED and l.got_tlsk.Get(q) != TG_ZERO:
                l.stat_dynrel++
            end
            continue
        end
        if gs >= 0:
            if l.g_state[gs] == SY_SHARED or (l.pie and is_addr_g(l, gs)):
                l.stat_dynrel++
            end
        else l.pie and is_addr_sym(l, 0 - 1 - gs):
            l.stat_dynrel++
        end
    end
    mut plain := Vector {} as Vector<int>
    mut hashed := Vector {} as Vector<int>
    each dg in l.dyn_sym:
        if dyn_hashed(l, dg):
            hashed.Push(dg)
        else:
            plain.Push(dg)
        end
    end
    l.dyn_sym.Clear()
    each pg in plain:
        l.g_dyn[pg] = l.dyn_sym.Len() + 1
        l.dyn_sym.Push(pg)
    end
    l.dyn_hash0 = l.dyn_sym.Len() + 1
    if l.shared:
        gh_sort(l, hashed)
    end
    each hg in hashed:
        l.g_dyn[hg] = l.dyn_sym.Len() + 1
        l.dyn_sym.Push(hg)
    end
    plain.Free()
    hashed.Free()
end
