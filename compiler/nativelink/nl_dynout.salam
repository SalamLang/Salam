package nativelink

const DS_INTERP := 0
const DS_GHASH := 1
const DS_DYNSYM := 2
const DS_DYNSTR := 3
const DS_VERSYM := 4
const DS_VERNEED := 5
const DS_RELA := 6
const DS_PLT := 7
const DS_DYNAMIC := 8
const DS_GOT := 9
const DS_COUNT := 10

pub struct Dyn:
    pub str: Vector<u8> = Vector {}
    pub sym_str: Vector<i64> = Vector {}
    pub lib_str: Vector<i64> = Vector {}
    pub vn_lib: Vector<int> = Vector {}
    pub vn_name: Vector<int> = Vector {}
    pub vn_str: Vector<i64> = Vector {}
    pub nrela: int = 0
    pub ndynent: int = 0
end

func shared_g(l &: Nl, os: int): int:
    g := l.os_glob[os]
    if g >= 0 and l.g_state[g] == SY_SHARED:
        ret g
    end
    ret 0 - 1
end

func is_addr_sym(l &: Nl, os: int): bool:
    g := l.os_glob[os]
    if g >= 0:
        st := l.g_state[g]
        if st == SY_DEF:
            ret true
        end
        if st == SY_ABS:
            k := l.g_sec[g]
            ret k <= SYN_INIT_START and k != SYN_ZERO
        end
        ret false
    end
    ret l.os_sec[os] >= 0
end

func is_addr_g(l &: Nl, g: int): bool:
    st := l.g_state[g]
    if st == SY_DEF:
        ret true
    end
    if st == SY_ABS:
        k := l.g_sec[g]
        ret k <= SYN_INIT_START and k != SYN_ZERO
    end
    ret false
end

func need_dyn(l &: Nl, g: int):
    if l.g_dyn[g] < 0:
        l.g_dyn[g] = l.dyn_sym.len() + 1
        l.dyn_sym.push(g)
    end
end

func need_got(l &: Nl, g: int):
    if l.g_got[g] < 0:
        l.g_got[g] = l.got_sym.len()
        l.got_sym.push(g)
    end
    if l.g_state[g] == SY_SHARED:
        need_dyn(l, g)
    end
end

func need_plt(l &: Nl, g: int):
    if l.g_plt[g] < 0:
        l.g_plt[g] = l.plt_sym.len()
        l.plt_sym.push(g)
    end
    need_got(l, g)
end

func got_relaxable(l &: Nl, s: int, r: int): bool:
    ty := l.r_type[r]
    if ty == 9:
        ret false
    end
    os := l.r_sym[r]
    if shared_g(l, os) >= 0 or sym_sec(l, os) < 0:
        ret false
    end
    p := fptr(l, l.o_file[l.s_obj[s]])
    off := l.s_off[s] + l.r_off[r]
    ret off >= (2 as i64) and p[off - (2 as i64)] == (0x8b as u8)
end

func ver_index(d &: Dyn, lib: int, ver: int): int:
    if ver < 0:
        ret 1
    end
    repeat d.vn_lib.len() in k:
        if d.vn_lib[k] == lib and d.vn_name[k] == ver:
            ret k + 2
        end
    end
    d.vn_lib.push(lib)
    d.vn_name.push(ver)
    d.vn_str.push(0 as i64)
    ret d.vn_lib.len() + 1
end

func ds_put_name(d &: Dyn, l &: Nl, id: int): i64:
    at := d.str.len() as i64
    o := l.names.off[id]
    repeat l.names.len[id] in i:
        d.str.push(l.names.bytes[o + i])
    end
    d.str.push(0 as u8)
    ret at
end

func ds_put_str(d &: Dyn, s: str): i64:
    at := d.str.len() as i64
    p := (s as void*) as u8*
    repeat str.Len(s) in i:
        d.str.push(p[i])
    end
    d.str.push(0 as u8)
    ret at
end

func elf_hash(l &: Nl, id: int): i64:
    mut h := 0 as i64
    o := l.names.off[id]
    repeat l.names.len[id] in i:
        h = (h << (4 as i64)) + (l.names.bytes[o + i] as i64)
        gg := h & (0xf0000000 as i64)
        if gg != (0 as i64):
            h = h ^ (gg >> (24 as i64))
        end
        h = h & ((0 - 1 as i64) ^ gg)
    end
    ret h & (0xffffffff as i64)
end

func dyn_prepare(l &: Nl):
    repeat l.s_obj.len() in s:
        if not l.s_live[s] or l.s_oc[s] == OC_NONE:
            continue
        end
        r0 := l.s_rel0[s]
        repeat l.s_nrel[s] in k:
            r := r0 + k
            ty := l.r_type[r]
            os := l.r_sym[r]
            g := shared_g(l, os)
            if g >= 0:
                if ty == 2 or ty == 4:
                    if l.g_stype[g] == 1:
                        nl_fail(l, "the built-in linker does not make copy relocations; data symbol '" + name_of(l, l.g_name[g]) + "' from a shared library is used directly at " + reloc_where(l, s, r))
                        ret
                    end
                    need_plt(l, g)
                else ty == 9 or ty == 41 or ty == 42:
                    need_got(l, g)
                else ty == 1:
                    need_dyn(l, g)
                    l.stat_dynrel += 1
                else:
                    nl_fail(l, "unsupported relocation type " + str.FromInt(ty as i64) + " against a shared library symbol at " + reloc_where(l, s, r))
                    ret
                end
            else:
                if ty == 1:
                    if is_addr_sym(l, os):
                        l.stat_dynrel += 1
                    end
                else ty == 10 or ty == 11:
                    if is_addr_sym(l, os):
                        nl_fail(l, "a 32-bit absolute address cannot be used in a position-independent executable at " + reloc_where(l, s, r))
                        ret
                    end
                else ty == 9 or ty == 41 or ty == 42:
                    if not got_relaxable(l, s, r):
                        g2 := l.os_glob[os]
                        if g2 < 0:
                            nl_fail(l, l.o_label[l.s_obj[s]] + ": GOT reference to a local symbol is not supported")
                            ret
                        end
                        need_got(l, g2)
                    end
                end
            end
        end
    end
    repeat l.got_sym.len() in q:
        g3 := l.got_sym[q]
        if l.g_state[g3] == SY_SHARED or is_addr_g(l, g3):
            l.stat_dynrel += 1
        end
    end
end

func place_ds(l &: Nl, k: int, size: i64, al: i64, fpos &: i64):
    fpos = align_to(fpos, al)
    l.ds_off[k] = fpos
    l.ds_addr[k] = l.base + fpos
    l.ds_size[k] = size
    fpos = fpos + size
end

func dyn_tables(l &: Nl, d &: Dyn):
    d.str.push(0 as u8)
    repeat l.sl_file.len() in lb:
        d.lib_str.push(l.sl_used[lb] ? ds_put_str(d, l.sl_soname[lb]) : (0 as i64))
    end
    each g in l.dyn_sym:
        d.sym_str.push(ds_put_name(d, l, l.g_name[g]))
        _v := ver_index(d, l.g_lib[g], l.g_ver[g])
    end
    repeat d.vn_lib.len() in k:
        d.vn_str[k] = ds_put_name(d, l, d.vn_name[k])
    end
    mut nd := 0
    repeat l.sl_file.len() in lb2:
        if l.sl_used[lb2]:
            nd += 1
        end
    end
    d.ndynent = nd + 22
end

func place_dyn(l &: Nl):
    l.base = 0 as i64
    l.nphdr = 8
    ehh_reserve(l)
    mut d := Dyn {}
    dyn_tables(l, d)
    l.dstr_keep = d
    repeat OC_COUNT:
        l.oc_addr.push(0 as i64)
        l.oc_size.push(0 as i64)
        l.oc_fpos.push(0 as i64)
        l.oc_align.push(1 as i64)
    end
    repeat DS_COUNT:
        l.ds_off.push(0 as i64)
        l.ds_size.push(0 as i64)
        l.ds_addr.push(0 as i64)
    end
    repeat 3:
        l.seg_vaddr.push(0 as i64)
        l.seg_fpos.push(0 as i64)
        l.seg_fsz.push(0 as i64)
        l.seg_msz.push(0 as i64)
    end
    nsym := l.dyn_sym.len() + 1
    mut nvl := 0
    repeat l.sl_file.len() in lb:
        mut has := false
        each lv in d.vn_lib:
            if lv == lb:
                has = true
            end
        end
        if has:
            nvl += 1
        end
    end
    mut fpos := (64 + l.nphdr * 56) as i64
    place_ds(l, DS_INTERP, (str.Len(l.interp) + 1) as i64, 1 as i64, fpos)
    place_ds(l, DS_GHASH, 28 as i64, 8 as i64, fpos)
    place_ds(l, DS_DYNSYM, (24 * nsym) as i64, 8 as i64, fpos)
    place_ds(l, DS_DYNSTR, d.str.len() as i64, 1 as i64, fpos)
    place_ds(l, DS_VERSYM, (2 * nsym) as i64, 2 as i64, fpos)
    place_ds(l, DS_VERNEED, (16 * nvl + 16 * d.vn_lib.len()) as i64, 8 as i64, fpos)
    place_ds(l, DS_RELA, (24 * l.stat_dynrel) as i64, 8 as i64, fpos)
    place_class(l, OC_RODATA, fpos, false)
    place_class(l, OC_EHFRAME, fpos, false)
    ehh_place(l, fpos)
    l.seg_vaddr[0] = l.base
    l.seg_fsz[0] = fpos
    l.seg_msz[0] = fpos
    fpos = align_to(fpos, NL_PAGE as i64)
    rx := fpos
    place_class(l, OC_INIT, fpos, false)
    place_ds(l, DS_PLT, (16 * l.plt_sym.len()) as i64, 16 as i64, fpos)
    place_class(l, OC_TEXT, fpos, false)
    place_class(l, OC_FINI, fpos, false)
    l.seg_vaddr[1] = l.base + rx
    l.seg_fpos[1] = rx
    l.seg_fsz[1] = fpos - rx
    l.seg_msz[1] = fpos - rx
    fpos = align_to(fpos, NL_PAGE as i64)
    rw := fpos
    l.relro_lo = l.base + fpos
    place_class(l, OC_INITARR, fpos, false)
    place_class(l, OC_FINIARR, fpos, false)
    place_class(l, OC_DATAREL, fpos, false)
    place_ds(l, DS_DYNAMIC, (16 * d.ndynent) as i64, 8 as i64, fpos)
    place_ds(l, DS_GOT, (8 * l.got_sym.len()) as i64, 8 as i64, fpos)
    l.oc_addr[OC_GOT] = l.ds_addr[DS_GOT]
    l.oc_fpos[OC_GOT] = l.ds_off[DS_GOT]
    l.oc_size[OC_GOT] = l.ds_size[DS_GOT]
    l.relro_hi = l.base + fpos
    place_class(l, OC_DATA, fpos, false)
    file_end := fpos
    mut mem := fpos
    place_class(l, OC_BSS, mem, true)
    l.seg_vaddr[2] = l.base + rw
    l.seg_fpos[2] = rw
    l.seg_fsz[2] = file_end - rw
    l.seg_msz[2] = mem - rw
    l.file_size = file_end
    l.image_end = l.base + mem
    st := glob_find(l, "_start")
    l.entry = sym_addr_g(l, st)
end

func rela_add(l &: Nl, off: i64, ty: int, sym: int, add: i64):
    l.rd_off.push(off)
    l.rd_type.push(ty)
    l.rd_sym.push(sym)
    l.rd_add.push(add)
end

func target_addr(l &: Nl, os: int): i64:
    g := shared_g(l, os)
    if g >= 0:
        if l.g_plt[g] >= 0:
            ret l.ds_addr[DS_PLT] + ((16 * l.g_plt[g]) as i64)
        end
        ret 0
    end
    ret sym_addr(l, os)
end

func apply_dyn(l &: Nl):
    buf := malloc(l.file_size as u64) as u8*
    l.out_ptr = buf as i64
    repeat l.file_size in z:
        buf[z] = 0 as u8
    end
    repeat l.seg_fsz[1] in zz:
        buf[l.seg_fpos[1] + zz] = 0x90 as u8
    end
    repeat l.s_obj.len() in s:
        if not l.s_live[s] or l.s_fpos[s] < (0 as i64):
            continue
        end
        p := fptr(l, l.o_file[l.s_obj[s]])
        src := l.s_off[s]
        dst := l.s_fpos[s]
        repeat l.s_size[s] in k:
            buf[dst + k] = p[src + k]
        end
    end
    repeat l.s_obj.len() in s2:
        if not l.s_live[s2] or l.s_fpos[s2] < (0 as i64):
            continue
        end
        r0 := l.s_rel0[s2]
        repeat l.s_nrel[s2] in k2:
            r := r0 + k2
            ty := l.r_type[r]
            os := l.r_sym[r]
            place := l.s_fpos[s2] + l.r_off[r]
            pc := l.s_addr[s2] + l.r_off[r]
            a := l.r_add[r]
            g := shared_g(l, os)
            sv := target_addr(l, os)
            if ty == 0:
                continue
            end
            if ty == 1:
                if g >= 0:
                    rela_add(l, pc, 1, l.g_dyn[g], a)
                    wr64(buf, place, 0 as i64)
                else is_addr_sym(l, os):
                    rela_add(l, pc, 8, 0, sv + a)
                    wr64(buf, place, sv + a)
                else:
                    wr64(buf, place, sv + a)
                end
            else ty == 2 or ty == 4:
                v := sv + a - pc
                if not fits32s(v):
                    nl_fail(l, "relocation out of range at " + reloc_where(l, s2, r))
                    ret
                end
                wr32(buf, place, v)
            else ty == 10 or ty == 11:
                wr32(buf, place, sv + a)
            else ty == 24:
                wr64(buf, place, sv + a - pc)
            else ty == 9 or ty == 41 or ty == 42:
                g2 := l.os_glob[os]
                if g2 >= 0 and l.g_got[g2] >= 0 and not got_relaxable(l, s2, r):
                    ga := l.ds_addr[DS_GOT] + ((8 * l.g_got[g2]) as i64)
                    wr32(buf, place, ga + a - pc)
                else:
                    buf[place - (2 as i64)] = 0x8d as u8
                    wr32(buf, place, sv + a - pc)
                    l.stat_relax += 1
                end
            else:
                nl_fail(l, "unsupported relocation type " + str.FromInt(ty as i64) + " at " + reloc_where(l, s2, r))
                ret
            end
        end
    end
    repeat l.got_sym.len() in q:
        g3 := l.got_sym[q]
        slot := l.ds_addr[DS_GOT] + ((8 * q) as i64)
        sf := l.ds_off[DS_GOT] + ((8 * q) as i64)
        if l.g_state[g3] == SY_SHARED:
            rela_add(l, slot, 6, l.g_dyn[g3], 0 as i64)
        else is_addr_g(l, g3):
            v3 := sym_addr_g(l, g3)
            rela_add(l, slot, 8, 0, v3)
            wr64(buf, sf, v3)
        else:
            wr64(buf, sf, sym_addr_g(l, g3))
        end
    end
    repeat l.plt_sym.len() in q2:
        g4 := l.plt_sym[q2]
        at := l.ds_off[DS_PLT] + ((16 * q2) as i64)
        pa := l.ds_addr[DS_PLT] + ((16 * q2) as i64)
        slot2 := l.ds_addr[DS_GOT] + ((8 * l.g_got[g4]) as i64)
        buf[at] = 0xff as u8
        buf[at + (1 as i64)] = 0x25 as u8
        wr32(buf, at + (2 as i64), slot2 - (pa + (6 as i64)))
        repeat 10 in z2:
            buf[at + ((6 + z2) as i64)] = 0xcc as u8
        end
    end
    if l.rd_off.len() != l.stat_dynrel:
        nl_fail(l, "internal error: " + str.FromInt(l.rd_off.len() as i64) + " dynamic relocations written, " + str.FromInt(l.stat_dynrel as i64) + " reserved")
        ret
    end
    write_dyn_tables(l, buf)
end

func write_dyn_tables(l &: Nl, buf: u8*):
    d := l.dstr_keep
    ip := (l.interp as void*) as u8*
    repeat str.Len(l.interp) in k:
        buf[l.ds_off[DS_INTERP] + (k as i64)] = ip[k]
    end
    nsym := l.dyn_sym.len() + 1
    gh := l.ds_off[DS_GHASH]
    wr32(buf, gh, 1 as i64)
    wr32(buf, gh + (4 as i64), nsym as i64)
    wr32(buf, gh + (8 as i64), 1 as i64)
    wr32(buf, gh + (12 as i64), 6 as i64)
    wr64(buf, gh + (16 as i64), 0 as i64)
    wr32(buf, gh + (24 as i64), 0 as i64)
    ds := l.ds_off[DS_DYNSYM]
    vs := l.ds_off[DS_VERSYM]
    repeat l.dyn_sym.len() in k2:
        g := l.dyn_sym[k2]
        e := ds + ((24 * (k2 + 1)) as i64)
        wr32(buf, e, d.sym_str[k2])
        mut ty := l.g_stype[g]
        if ty == 0 or ty == 10:
            ty = 2
        end
        bind := l.g_strongref[g] ? 1 : 2
        buf[e + (4 as i64)] = ((bind << 4) | ty) as u8
        vi := l.g_ver[g] < 0 ? 1 : 0
        mut ix := vi
        if vi == 0:
            repeat d.vn_lib.len() in q:
                if d.vn_lib[q] == l.g_lib[g] and d.vn_name[q] == l.g_ver[g]:
                    ix = q + 2
                end
            end
        end
        buf[vs + ((2 * (k2 + 1)) as i64)] = (ix & 255) as u8
        buf[vs + ((2 * (k2 + 1)) as i64) + (1 as i64)] = ((ix >> 8) & 255) as u8
    end
    dst := l.ds_off[DS_DYNSTR]
    repeat d.str.len() in k3:
        buf[dst + (k3 as i64)] = d.str[k3]
    end
    mut vo := l.ds_off[DS_VERNEED]
    mut libs := Vector {} as Vector<int>
    repeat l.sl_file.len() in lb:
        mut cnt := 0
        each lv in d.vn_lib:
            if lv == lb:
                cnt += 1
            end
        end
        if cnt > 0:
            libs.push(lb)
        end
    end
    repeat libs.len() in li:
        lb2 := libs[li]
        mut cnt2 := 0
        each lv2 in d.vn_lib:
            if lv2 == lb2:
                cnt2 += 1
            end
        end
        wr32(buf, vo, (1 | (cnt2 << 16)) as i64)
        wr32(buf, vo + (4 as i64), d.lib_str[lb2])
        wr32(buf, vo + (8 as i64), 16 as i64)
        nxt := li + 1 < libs.len() ? (16 + 16 * cnt2) : 0
        wr32(buf, vo + (12 as i64), nxt as i64)
        mut ao := vo + (16 as i64)
        mut seen := 0
        repeat d.vn_lib.len() in q2:
            if d.vn_lib[q2] != lb2:
                continue
            end
            seen += 1
            wr32(buf, ao, elf_hash(l, d.vn_name[q2]))
            wr32(buf, ao + (4 as i64), ((q2 + 2) << 16) as i64)
            wr32(buf, ao + (8 as i64), d.vn_str[q2])
            wr32(buf, ao + (12 as i64), (seen < cnt2 ? 16 : 0) as i64)
            ao = ao + (16 as i64)
        end
        vo = ao
    end
    nvn := libs.len()
    l.vn_count = nvn
    libs.free()
    ro := l.ds_off[DS_RELA]
    mut ri := 0
    repeat 2 in pass:
        repeat l.rd_off.len() in k4:
            rel := l.rd_type[k4] == 8
            if (pass == 0) != rel:
                continue
            end
            e2 := ro + ((24 * ri) as i64)
            wr64(buf, e2, l.rd_off[k4])
            wr64(buf, e2 + (8 as i64), ((l.rd_sym[k4] as i64) << (32 as i64)) | (l.rd_type[k4] as i64))
            wr64(buf, e2 + (16 as i64), l.rd_add[k4])
            ri += 1
        end
    end
    mut nrel := 0
    repeat l.rd_type.len() in k5:
        if l.rd_type[k5] == 8:
            nrel += 1
        end
    end
    mut dp := l.ds_off[DS_DYNAMIC]
    repeat l.sl_file.len() in lb3:
        if l.sl_used[lb3]:
            dyn_ent(buf, dp, 1, d.lib_str[lb3])
        end
    end
    dyn_ent(buf, dp, 0x6ffffef5, l.ds_addr[DS_GHASH])
    dyn_ent(buf, dp, 5, l.ds_addr[DS_DYNSTR])
    dyn_ent(buf, dp, 6, l.ds_addr[DS_DYNSYM])
    dyn_ent(buf, dp, 10, l.ds_size[DS_DYNSTR])
    dyn_ent(buf, dp, 11, 24 as i64)
    dyn_ent(buf, dp, 21, 0 as i64)
    dyn_ent(buf, dp, 7, l.ds_addr[DS_RELA])
    dyn_ent(buf, dp, 8, l.ds_size[DS_RELA])
    dyn_ent(buf, dp, 9, 24 as i64)
    dyn_ent(buf, dp, 0x6ffffff9, nrel as i64)
    dyn_ent(buf, dp, 25, l.oc_addr[OC_INITARR])
    dyn_ent(buf, dp, 27, l.oc_size[OC_INITARR])
    dyn_ent(buf, dp, 26, l.oc_addr[OC_FINIARR])
    dyn_ent(buf, dp, 28, l.oc_size[OC_FINIARR])
    dyn_ent(buf, dp, 0x6ffffff0, l.ds_addr[DS_VERSYM])
    dyn_ent(buf, dp, 0x6ffffffe, l.ds_addr[DS_VERNEED])
    dyn_ent(buf, dp, 0x6fffffff, nvn as i64)
    dyn_ent(buf, dp, 30, 8 as i64)
    dyn_ent(buf, dp, 0x6ffffffb, (1 | 0x08000000) as i64)
    dyn_ent(buf, dp, 0, 0 as i64)
end

func dyn_ent(buf: u8*, dp &: i64, tag: int, val: i64):
    wr64(buf, dp, tag as i64)
    wr64(buf, dp + (8 as i64), val)
    dp = dp + (16 as i64)
end
