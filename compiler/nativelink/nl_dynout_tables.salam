package nativelink

func ver_index(d &: Dyn, lib: int, ver: int): int:
    if ver < 0:
        ret 1
    end
    repeat d.vn_lib.Len() in k:
        if d.vn_lib[k] == lib and d.vn_name[k] == ver:
            ret k + 2
        end
    end
    d.vn_lib.Push(lib)
    d.vn_name.Push(ver)
    d.vn_str.Push(0 as i64)
    ret d.vn_lib.Len() + 1
end

func ds_put_name(d &: Dyn, l &: Nl, id: int): i64:
    at := d.str.Len() as i64
    o := l.names.off[id]
    repeat l.names.len[id] in i:
        d.str.Push(l.names.bytes[o + i])
    end
    d.str.Push(0 as u8)
    ret at
end

func ds_put_str(d &: Dyn, s: str): i64:
    at := d.str.Len() as i64
    p := (s as void*) as u8*
    repeat str.Len(s) in i:
        d.str.Push(p[i])
    end
    d.str.Push(0 as u8)
    ret at
end

func elf_hash(l &: Nl, id: int): i64:
    mut h := 0 as i64
    o := l.names.off[id]
    repeat l.names.len[id] in i:
        h = (h << (4 as i64)) + (l.names.bytes[o + i] as i64)
        gg := h & (0xf0000000 as i64)
        if gg != (0 as i64):
            h ^= (gg >> (24 as i64))
        end
        h &= ((0 - 1 as i64) ^ gg)
    end
    ret h & (0xffffffff as i64)
end

func dr_relative(l &: Nl): int:
    switch l.mach:
        EM_AARCH64: ret 1027 end
        EM_ARM: ret 23 end
        EM_RISCV: ret 3 end
    end
    ret 8
end

func dr_globdat(l &: Nl): int:
    switch l.mach:
        EM_AARCH64: ret 1025 end
        EM_ARM: ret 21 end
        EM_RISCV: ret 2 end
    end
    ret 6
end

func dr_jslot(l &: Nl): int:
    switch l.mach:
        EM_AARCH64: ret 1026 end
        EM_ARM: ret 22 end
        EM_RISCV: ret 5 end
    end
    ret 7
end

func dr_abs(l &: Nl): int:
    switch l.mach:
        EM_AARCH64: ret 257 end
        EM_ARM: ret 2 end
        EM_RISCV: ret 2 end
    end
    ret 1
end

func dr_copy(l &: Nl): int:
    switch l.mach:
        EM_AARCH64: ret 1024 end
        EM_ARM: ret 20 end
        EM_RISCV: ret 4 end
    end
    ret 5
end

func dr_tls(l &: Nl, kind: int): int:
    m := l.mach
    if kind == TG_TP:
        switch m:
            EM_AARCH64: ret 1030 end
            EM_ARM: ret 19 end
            EM_RISCV: ret 11 end
            EM_386: ret 14 end
        end
        ret 18
    end
    if kind == TG_MOD:
        switch m:
            EM_AARCH64: ret 1028 end
            EM_ARM: ret 17 end
            EM_RISCV: ret 7 end
            EM_386: ret 35 end
        end
        ret 16
    end
    switch m:
        EM_AARCH64: ret 1029 end
        EM_ARM: ret 18 end
        EM_RISCV: ret 9 end
        EM_386: ret 36 end
    end
    ret 17
end

func dy_ws(l &: Nl): int:
    ret l.elf32 ? 4 : 8
end

func dy_symsz(l &: Nl): int:
    ret l.elf32 ? 16 : 24
end

func dy_relsz(l &: Nl): int:
    if l.dyn_rel:
        ret 8
    end
    ret l.elf32 ? 12 : 24
end

func dy_dynsz(l &: Nl): int:
    ret l.elf32 ? 8 : 16
end
