package nativelink

func glob_of(l &: Nl, name: int): int:
    until l.g_of_name.len() <= name:
        l.g_of_name.push(0 - 1)
    end
    mut g := l.g_of_name[name]
    if g < 0:
        g = l.g_name.len()
        l.g_name.push(name)
        l.g_state.push(SY_UNDEF)
        l.g_weak.push(false)
        l.g_sec.push(0 - 1)
        l.g_val.push(0 as i64)
        l.g_obj.push(0 - 1)
        l.g_strongref.push(false)
        l.g_firstref.push(0 - 1)
        l.g_got.push(0 - 1)
        l.g_of_name[name] = g
    end
    ret g
end

func glob_find(l &: Nl, s: str): int:
    n := nt_find(l.names, (s as void*) as u8*, 0 as i64, str.Len(s), false)
    if n < 0 or n >= l.g_of_name.len():
        ret 0 - 1
    end
    ret l.g_of_name[n]
end

func add_object(l &: Nl, f: int, base: i64, size: i64, label: str):
    p := fptr(l, f)
    if size < (64 as i64) or p[base] != (127 as u8) or p[base + (1 as i64)] != (69 as u8) or p[base + (2 as i64)] != (76 as u8) or p[base + (3 as i64)] != (70 as u8):
        nl_fail(l, label + ": not an ELF object")
        ret
    end
    if p[base + (4 as i64)] != (2 as u8) or p[base + (5 as i64)] != (1 as u8) or rd16(p, base + (16 as i64)) != 1 or rd16(p, base + (18 as i64)) != 62:
        nl_fail(l, label + ": not a 64-bit little-endian x86-64 relocatable object")
        ret
    end
    o := l.o_file.len()
    shoff := base + rd64(p, base + (0x28 as i64))
    shnum := rd16(p, base + (0x3C as i64))
    shstr := rd16(p, base + (0x3E as i64))
    l.o_file.push(f)
    l.o_base.push(base)
    l.o_label.push(label)
    sec0 := l.s_obj.len()
    l.o_sec0.push(sec0)
    l.o_nsec.push(shnum)
    sstr_off := base + rd64(p, shoff + ((shstr * 64) as i64) + (24 as i64))
    mut symtab := 0 - 1
    repeat shnum in i:
        sh := shoff + ((i * 64) as i64)
        nm_off := sstr_off + rd32(p, sh)
        nm := nt_find(l.names, p, nm_off, cstr_len(p, nm_off, l.f_size[f]), true)
        ty := rd32(p, sh + (4 as i64)) as int
        l.s_obj.push(o)
        l.s_name.push(nm)
        l.s_type.push(ty)
        l.s_flags.push(rd64(p, sh + (8 as i64)))
        l.s_off.push(base + rd64(p, sh + (24 as i64)))
        l.s_size.push(rd64(p, sh + (32 as i64)))
        mut al := rd64(p, sh + (48 as i64))
        if al < (1 as i64):
            al = 1 as i64
        end
        l.s_align.push(al)
        l.s_rel0.push(0)
        l.s_nrel.push(0)
        l.s_oc.push(OC_NONE)
        l.s_live.push(false)
        l.s_addr.push(0 as i64)
        l.s_fpos.push(0 as i64)
        if ty == 2:
            symtab = i
        end
        if ty == 17:
            nl_fail(l, label + ": section groups (COMDAT) are not supported yet")
        end
    end
    sym0 := l.os_sec.len()
    l.o_sym0.push(sym0)
    if symtab < 0:
        l.o_nsym.push(0)
    else:
        sh2 := shoff + ((symtab * 64) as i64)
        st_off := base + rd64(p, sh2 + (24 as i64))
        st_size := rd64(p, sh2 + (32 as i64))
        strl := rd32(p, sh2 + (40 as i64)) as int
        str_off := base + rd64(p, shoff + ((strl * 64) as i64) + (24 as i64))
        ns := (st_size / (24 as i64)) as int
        l.o_nsym.push(ns)
        repeat ns in k:
            e := st_off + ((k * 24) as i64)
            info := rd8(p, e + (4 as i64))
            bind := info >> 4
            shndx := rd16(p, e + (6 as i64))
            val := rd64(p, e + (8 as i64))
            mut sec := 0 - 1
            if shndx == 0xFFF1:
                sec = 0 - 2
            else shndx == 0xFFF2:
                nl_fail(l, label + ": common symbols are not supported yet")
            else shndx > 0 and shndx < 0xFF00:
                sec = sec0 + shndx
            end
            l.os_sec.push(sec)
            l.os_val.push(val)
            stype := info & 15
            mut snm := 0 - 1
            if (stype == 1 or stype == 2) and k > 0:
                no0 := str_off + rd32(p, e)
                ln0 := cstr_len(p, no0, l.f_size[f])
                if ln0 > 0:
                    snm = nt_find(l.names, p, no0, ln0, true)
                end
            end
            l.os_name.push(snm)
            l.os_type.push(stype | (bind << 4))
            l.os_size.push(rd64(p, e + (16 as i64)))
            mut gi := 0 - 1
            if bind != 0 and k > 0:
                no := str_off + rd32(p, e)
                ln := cstr_len(p, no, l.f_size[f])
                if ln > 0:
                    gi = glob_of(l, nt_find(l.names, p, no, ln, true))
                    sym_merge(l, gi, o, sec, val, bind == 2)
                end
            end
            l.os_glob.push(gi)
        end
    end
    repeat shnum in i2:
        sh3 := shoff + ((i2 * 64) as i64)
        if rd32(p, sh3 + (4 as i64)) == (4 as i64):
            tgt := sec0 + (rd32(p, sh3 + (44 as i64)) as int)
            ro := base + rd64(p, sh3 + (24 as i64))
            nr := (rd64(p, sh3 + (32 as i64)) / (24 as i64)) as int
            l.s_rel0[tgt] = l.r_off.len()
            l.s_nrel[tgt] = nr
            repeat nr in r:
                re := ro + ((r * 24) as i64)
                info2 := rd64(p, re + (8 as i64))
                l.r_off.push(rd64(p, re))
                l.r_type.push((info2 & (0xFFFFFFFF as i64)) as int)
                l.r_sym.push(sym0 + ((info2 >> (32 as i64)) as int))
                l.r_add.push(rd64(p, re + (16 as i64)))
            end
        end
    end
end

func sym_merge(l &: Nl, g: int, o: int, sec: int, val: i64, weak: bool):
    if sec == 0 - 1:
        if not weak:
            l.g_strongref[g] = true
        end
        if l.g_firstref[g] < 0:
            l.g_firstref[g] = o
        end
        ret
    end
    st := l.g_state[g]
    if st == SY_UNDEF:
        l.g_state[g] = sec == 0 - 2 ? SY_ABS : SY_DEF
        l.g_weak[g] = weak
        l.g_sec[g] = sec
        l.g_val[g] = val
        l.g_obj[g] = o
        ret
    end
    if weak:
        ret
    end
    if l.g_weak[g]:
        l.g_state[g] = sec == 0 - 2 ? SY_ABS : SY_DEF
        l.g_weak[g] = false
        l.g_sec[g] = sec
        l.g_val[g] = val
        l.g_obj[g] = o
        ret
    end
    nl_fail(l, "duplicate symbol '" + name_of(l, l.g_name[g]) + "' in " + l.o_label[l.g_obj[g]] + " and " + l.o_label[o])
end
