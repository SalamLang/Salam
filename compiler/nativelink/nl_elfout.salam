package nativelink

func phdr(buf: u8*, at: i64, ty: int, flags: int, off: i64, vaddr: i64, fsz: i64, msz: i64, al: i64):
    wr32(buf, at, ty as i64)
    wr32(buf, at + (4 as i64), flags as i64)
    wr64(buf, at + (8 as i64), off)
    wr64(buf, at + (16 as i64), vaddr)
    wr64(buf, at + (24 as i64), vaddr)
    wr64(buf, at + (32 as i64), fsz)
    wr64(buf, at + (40 as i64), msz)
    wr64(buf, at + (48 as i64), al)
end

func write_exe(l &: Nl, out: str):
    buf := l.out_ptr as void* as u8*
    buf[0] = 0x7f as u8
    buf[1] = 69 as u8
    buf[2] = 76 as u8
    buf[3] = 70 as u8
    buf[4] = 2 as u8
    buf[5] = 1 as u8
    buf[6] = 1 as u8
    wr32(buf, 16 as i64, (2 | (62 << 16)) as i64)
    wr32(buf, 20 as i64, 1 as i64)
    wr64(buf, 24 as i64, l.entry)
    wr64(buf, 32 as i64, 64 as i64)
    wr64(buf, 40 as i64, 0 as i64)
    wr32(buf, 48 as i64, 0 as i64)
    wr32(buf, 52 as i64, (64 | (56 << 16)) as i64)
    wr32(buf, 56 as i64, (4 | (64 << 16)) as i64)
    wr32(buf, 60 as i64, 0 as i64)
    ph := 64 as i64
    phdr(buf, ph, 1, 4, l.seg_fpos[0], l.seg_vaddr[0], l.seg_fsz[0], l.seg_msz[0], NL_PAGE as i64)
    phdr(buf, ph + (56 as i64), 1, 5, l.seg_fpos[1], l.seg_vaddr[1], l.seg_fsz[1], l.seg_msz[1], NL_PAGE as i64)
    phdr(buf, ph + (112 as i64), 1, 6, l.seg_fpos[2], l.seg_vaddr[2], l.seg_fsz[2], l.seg_msz[2], NL_PAGE as i64)
    phdr(buf, ph + (168 as i64), 0x6474e551, 6, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 16 as i64)
    f := fopen(out, "wb")
    if f == null:
        nl_fail(l, "cannot write " + out)
        ret
    end
    w := fwrite(buf as void*, 1 as u64, l.file_size as u64, f)
    _c := fclose(f)
    if (w as i64) != l.file_size:
        nl_fail(l, "cannot write " + out)
        ret
    end
    _m := chmod(out, 493 as u32)
end
