package nativelink

func mo_name16(h &: Vector<u8>, s: str):
    p := (s as void*) as u8*
    repeat 16 in i:
        h.Push(i < str.Len(s) ? p[i] : (0 as u8))
    end
end

func mo_sect(
    h &: Vector<u8>,
    sect: str,
    seg: str,
    addr: i64,
    size: i64,
    off: i64,
    al: i64,
    flags: i64,
    r1: int,
    r2: int
):
    mo_name16(h, sect)
    mo_name16(h, seg)
    tb_le(h, addr, 8)
    tb_le(h, size, 8)
    tb_le(h, off, 4)
    mut lg := 0
    until ((1 as i64) << (lg as i64)) < al:
        lg++
    end
    tb_le(h, lg as i64, 4)
    tb_le(h, 0 as i64, 4)
    tb_le(h, 0 as i64, 4)
    tb_le(h, flags, 4)
    tb_le(h, r1 as i64, 4)
    tb_le(h, r2 as i64, 4)
    tb_le(h, 0 as i64, 4)
end

func mo_seg(
    h &: Vector<u8>,
    name: str,
    vmaddr: i64,
    vmsize: i64,
    fileoff: i64,
    filesize: i64,
    prot: int,
    nsect: int,
    flags: int
):
    tb_le(h, 0x19 as i64, 4)
    tb_le(h, (72 + 80 * nsect) as i64, 4)
    mo_name16(h, name)
    tb_le(h, vmaddr, 8)
    tb_le(h, vmsize, 8)
    tb_le(h, fileoff, 8)
    tb_le(h, filesize, 8)
    tb_le(h, prot as i64, 4)
    tb_le(h, prot as i64, 4)
    tb_le(h, nsect as i64, 4)
    tb_le(h, flags as i64, 4)
end

func mo_count(l &: Nl, t &: Mo, ks: int[]): int:
    mut n := 0
    each k in ks:
        if mo_has(l, t, k):
            n++
        end
    end
    ret n
end
