package nativelink

import crypto

func mo_write(l &: Nl, t &: Mo, buf: u8*, out: str):
    mut rebase := Vector {} as Vector<u8>
    mut bind := Vector {} as Vector<u8>
    if l.mo_chained:
        rebase = mo_chained_fixups(l, t, buf)
        if not l.ok:
            ret
        end
    else:
        rebase = mo_rebase_ops(t)
        bind = mo_bind_ops(l, t)
    end
    mut strs := Vector {} as Vector<u8>
    strs.Push(32 as u8)
    strs.Push(0 as u8)
    dyl := mo_dylib_list(l)
    mut syms := Vector {} as Vector<u8>
    mut nsym := 0
    mut nimp := 0
    mut nloc := 0
    repeat l.os_sec.Len() in os:
        s := l.os_sec[os]
        if l.os_glob[os] >= 0 or l.os_name[os] < 0 or s < 0 or not l.s_live[s]:
            continue
        end
        tb_le(syms, tb_name(l, strs, l.os_name[os]), 4)
        syms.Push(0x0e as u8)
        syms.Push(mo_secno(l, t, s) as u8)
        tb_le(syms, 0 as i64, 2)
        tb_le(syms, mo_sym(l, os), 8)
        nsym++
        nloc++
    end
    repeat 2 in pass:
        repeat l.g_name.Len() in g:
            imp := l.g_state[g] == SY_UNDEF and l.g_common[g] == (0 as i64)
            def := l.g_state[g] == SY_DEF
            if (pass == 0 and not def) or (pass == 1 and not imp):
                continue
            end
            tb_le(syms, tb_name(l, strs, l.g_name[g]), 4)
            syms.Push((def ? 0x0f : 0x01) as u8)
            syms.Push((def ? mo_secno(l, t, l.g_sec[g]) : 0) as u8)
            tb_le(syms, (def ? 0 : ((mo_ordinal(l, g, dyl) & 255) << 8)) as i64, 2)
            tb_le(syms, def ? mo_sym_g(l, g) : (0 as i64), 8)
            nsym++
            if imp:
                nimp++
            end
        end
    end
    until (strs.Len() % 8) != 0:
        strs.Push(0 as u8)
    end
    mut ind := Vector {} as Vector<u8>
    each sg in t.stub_g:
        tb_le(ind, mo_imp_index(l, sg, nloc, nsym - nimp), 4)
    end
    each gk in t.got_k:
        if gk >= 0 and l.g_state[gk] == SY_UNDEF and l.g_common[gk] == (0 as i64):
            tb_le(ind, mo_imp_index(l, gk, nloc, nsym - nimp), 4)
        else:
            tb_le(ind, 0x80000000 as i64, 4)
        end
    end
    mut le := Vector {} as Vector<u8>
    rb_off := t.le_off
    each b in rebase:
        le.Push(b)
    end
    bd_off := t.le_off + (le.Len() as i64)
    each b2 in bind:
        le.Push(b2)
    end
    ex_off := t.le_off + (le.Len() as i64)
    mut ex_len := 0
    if l.shared or l.mo_chained:
        trie := mo_export_trie(l, t)
        ex_len = trie.Len()
        each b6 in trie:
            le.Push(b6)
        end
        until (le.Len() % 8) != 0:
            le.Push(0 as u8)
        end
        trie.Free()
    end
    sym_off := t.le_off + (le.Len() as i64)
    each b3 in syms:
        le.Push(b3)
    end
    dic_off := t.le_off + (le.Len() as i64)
    mut ndic := 0
    repeat l.dic_obj.Len() in dq:
        o2 := l.dic_obj[dq]
        a2 := l.dic_addr[dq]
        repeat l.o_nsec[o2] in sq:
            s3 := l.o_sec0[o2] + sq
            if l.s_live[s3] and a2 >= l.s_maddr[s3] and a2 < l.s_maddr[s3] + l.s_size[s3]:
                tb_le(le, l.s_addr[s3] + a2 - l.s_maddr[s3] - t.base, 4)
                tb_le(le, l.dic_len[dq] as i64, 2)
                tb_le(le, l.dic_kind[dq] as i64, 2)
                ndic++
            end
        end
    end
    ind_off := t.le_off + (le.Len() as i64)
    each b5 in ind:
        le.Push(b5)
    end
    str_off := t.le_off + (le.Len() as i64)
    each b4 in strs:
        le.Push(b4)
    end
    until (le.Len() % 16) != 0:
        le.Push(0 as u8)
    end
    cs_off := t.le_off + (le.Len() as i64)
    ident := basename_of(out)
    npages := ((cs_off + (4095 as i64)) / (4096 as i64)) as int
    cd_hdr := 88
    id_len := str.Len(ident) + 1
    cd_len := cd_hdr + id_len + 32 * npages
    cs_len := 12 + 8 + cd_len
    cs_pad := align_to(cs_len as i64, 16 as i64)
    le_size := (le.Len() as i64) + cs_pad
    mut h := Vector {} as Vector<u8>
    tb_le(h, 0xFEEDFACF as i64, 4)
    tb_le(h, (l.mach == EM_X86_64 ? 0x01000007 : 0x0100000C) as i64, 4)
    tb_le(h, (l.mach == EM_X86_64 ? 3 : 0) as i64, 4)
    tb_le(h, (l.shared ? 6 : 2) as i64, 4)
    tb_le(h, 0 as i64, 4)
    tb_le(h, 0 as i64, 4)
    mut mflags := l.shared ? 0x00100085 : 0x00200085
    if mo_has(l, t, MO_TVARS):
        mflags |= 0x00800000
    end
    tb_le(h, mflags as i64, 4)
    tb_le(h, 0 as i64, 4)
    mut ncmd := 0
    if not l.shared:
        mo_seg(h, "__PAGEZERO", 0 as i64, t.base, 0 as i64, 0 as i64, 0, 0, 0)
        ncmd++
    end
    ntext := mo_count(l, t, [MO_TEXT, MO_STUBS, MO_CSTR, MO_TCONST, MO_EH, MO_UNW])
    mo_seg(h, "__TEXT", t.base, t.text_end, 0 as i64, t.text_end, 5, ntext, 0)
    ncmd++
    if mo_has(l, t, MO_TEXT):
        mo_sect(
            h,
            "__text",
            "__TEXT",
            t.addr[MO_TEXT],
            t.size[MO_TEXT],
            t.fpos[MO_TEXT],
            t.align[MO_TEXT],
            0x80000400 as i64,
            0,
            0
        )
    end
    if mo_has(l, t, MO_STUBS):
        mo_sect(
            h,
            "__stubs",
            "__TEXT",
            t.addr[MO_STUBS],
            t.size[MO_STUBS],
            t.fpos[MO_STUBS],
            4 as i64,
            0x80000408 as i64,
            0,
            mo_stub_size(l) as int
        )
    end
    if mo_has(l, t, MO_CSTR):
        mo_sect(
            h,
            "__cstring",
            "__TEXT",
            t.addr[MO_CSTR],
            t.size[MO_CSTR],
            t.fpos[MO_CSTR],
            t.align[MO_CSTR],
            2 as i64,
            0,
            0
        )
    end
    if mo_has(l, t, MO_TCONST):
        mo_sect(
            h,
            "__const",
            "__TEXT",
            t.addr[MO_TCONST],
            t.size[MO_TCONST],
            t.fpos[MO_TCONST],
            t.align[MO_TCONST],
            0 as i64,
            0,
            0
        )
    end
    if mo_has(l, t, MO_EH):
        mo_sect(
            h,
            "__eh_frame",
            "__TEXT",
            t.addr[MO_EH],
            t.size[MO_EH],
            t.fpos[MO_EH],
            t.align[MO_EH],
            0x6800000B as i64,
            0,
            0
        )
    end
    if mo_has(l, t, MO_UNW):
        mo_sect(
            h,
            "__unwind_info",
            "__TEXT",
            t.addr[MO_UNW],
            t.size[MO_UNW],
            t.fpos[MO_UNW],
            4 as i64,
            0 as i64,
            0,
            0
        )
    end
    ndc := mo_count(l, t, [MO_GOT, MO_INIT, MO_CONST])
    mo_seg(
        h,
        "__DATA_CONST",
        t.base + t.dc_start,
        t.dc_end - t.dc_start,
        t.dc_start,
        t.dc_end - t.dc_start,
        3,
        ndc,
        16
    )
    ncmd++
    if mo_has(l, t, MO_GOT):
        mo_sect(
            h,
            "__got",
            "__DATA_CONST",
            t.addr[MO_GOT],
            t.size[MO_GOT],
            t.fpos[MO_GOT],
            8 as i64,
            6 as i64,
            t.stub_g.Len(),
            0
        )
    end
    if mo_has(l, t, MO_INIT):
        mo_sect(
            h,
            "__mod_init_func",
            "__DATA_CONST",
            t.addr[MO_INIT],
            t.size[MO_INIT],
            t.fpos[MO_INIT],
            8 as i64,
            9 as i64,
            0,
            0
        )
    end
    if mo_has(l, t, MO_CONST):
        mo_sect(
            h,
            "__const",
            "__DATA_CONST",
            t.addr[MO_CONST],
            t.size[MO_CONST],
            t.fpos[MO_CONST],
            t.align[MO_CONST],
            0 as i64,
            0,
            0
        )
    end
    nd := mo_count(l, t, [MO_DATA, MO_TVARS, MO_TDATA, MO_TBSS, MO_BSS])
    mo_seg(
        h,
        "__DATA",
        t.base + t.d_start,
        t.d_end - t.d_start,
        t.d_start,
        t.d_fend - t.d_start,
        3,
        nd,
        0
    )
    ncmd++
    if mo_has(l, t, MO_DATA):
        mo_sect(
            h,
            "__data",
            "__DATA",
            t.addr[MO_DATA],
            t.size[MO_DATA],
            t.fpos[MO_DATA],
            t.align[MO_DATA],
            0 as i64,
            0,
            0
        )
    end
    if mo_has(l, t, MO_TVARS):
        mo_sect(
            h,
            "__thread_vars",
            "__DATA",
            t.addr[MO_TVARS],
            t.size[MO_TVARS],
            t.fpos[MO_TVARS],
            t.align[MO_TVARS],
            0x13 as i64,
            0,
            0
        )
    end
    if mo_has(l, t, MO_TDATA):
        mo_sect(
            h,
            "__thread_data",
            "__DATA",
            t.addr[MO_TDATA],
            t.size[MO_TDATA],
            t.fpos[MO_TDATA],
            t.align[MO_TDATA],
            0x11 as i64,
            0,
            0
        )
    end
    if mo_has(l, t, MO_TBSS):
        mo_sect(
            h,
            "__thread_bss",
            "__DATA",
            t.addr[MO_TBSS],
            t.size[MO_TBSS],
            0 as i64,
            t.align[MO_TBSS],
            0x12 as i64,
            0,
            0
        )
    end
    if mo_has(l, t, MO_BSS):
        mo_sect(
            h,
            "__bss",
            "__DATA",
            t.addr[MO_BSS],
            t.size[MO_BSS],
            0 as i64,
            t.align[MO_BSS],
            1 as i64,
            0,
            0
        )
    end
    if l.dg_name.Len() > 0:
        mo_seg(h, "__DWARF", t.base + t.d_end, t.dw_vm, t.dw_off, t.dw_size, 1, l.dg_name.Len(), 0)
        ncmd++
        repeat l.dg_name.Len() in dk2:
            nm := name_of(l, l.dg_name[dk2])
            mo_sect(
                h,
                str.Substr(nm, 8, str.Len(nm) - 8),
                "__DWARF",
                t.base + t.d_end + l.dg_base[dk2],
                l.dg_size[dk2],
                t.dw_off + l.dg_base[dk2],
                1 as i64,
                0x02000000 as i64,
                0,
                0
            )
        end
    end
    mo_seg(
        h,
        "__LINKEDIT",
        t.base + t.d_end + t.dw_vm,
        align_to(le_size, t.page),
        t.le_off,
        le_size,
        1,
        0,
        0
    )
    ncmd++
    if l.mo_chained:
        tb_le(h, 0x80000034 as i64, 4)
        tb_le(h, 16 as i64, 4)
        tb_le(h, rb_off, 4)
        tb_le(h, rebase.Len() as i64, 4)
        tb_le(h, 0x80000033 as i64, 4)
        tb_le(h, 16 as i64, 4)
        tb_le(h, ex_off, 4)
        tb_le(h, ex_len as i64, 4)
        ncmd += 2
    else:
        tb_le(h, 0x80000022 as i64, 4)
        tb_le(h, 48 as i64, 4)
        tb_le(h, rb_off, 4)
        tb_le(h, rebase.Len() as i64, 4)
        tb_le(h, bd_off, 4)
        tb_le(h, bind.Len() as i64, 4)
        repeat 4:
            tb_le(h, 0 as i64, 4)
        end
        tb_le(h, ex_len > 0 ? ex_off : (0 as i64), 4)
        tb_le(h, ex_len as i64, 4)
        ncmd++
    end
    tb_le(h, 2 as i64, 4)
    tb_le(h, 24 as i64, 4)
    tb_le(h, sym_off, 4)
    tb_le(h, nsym as i64, 4)
    tb_le(h, str_off, 4)
    tb_le(h, strs.Len() as i64, 4)
    ncmd++
    tb_le(h, 0x0B as i64, 4)
    tb_le(h, 80 as i64, 4)
    tb_le(h, 0 as i64, 4)
    tb_le(h, nloc as i64, 4)
    tb_le(h, nloc as i64, 4)
    tb_le(h, (nsym - nimp - nloc) as i64, 4)
    tb_le(h, (nsym - nimp) as i64, 4)
    tb_le(h, nimp as i64, 4)
    repeat 6:
        tb_le(h, 0 as i64, 4)
    end
    tb_le(h, ind_off, 4)
    tb_le(h, (t.stub_g.Len() + t.got_k.Len()) as i64, 4)
    repeat 4:
        tb_le(h, 0 as i64, 4)
    end
    ncmd++
    if l.shared:
        isz := 24 + ((str.Len(l.soname) + 8) / 8) * 8
        tb_le(h, 0x0D as i64, 4)
        tb_le(h, isz as i64, 4)
        tb_le(h, 24 as i64, 4)
        tb_le(h, 1 as i64, 4)
        tb_le(h, 0x00010000 as i64, 4)
        tb_le(h, 0x00010000 as i64, 4)
        tb_cstr(h, l.soname)
    else:
        tb_le(h, 0x0E as i64, 4)
        tb_le(h, 32 as i64, 4)
        tb_le(h, 12 as i64, 4)
        tb_cstr(h, "/usr/lib/dyld")
    end
    until (h.Len() % 8) != 0:
        h.Push(0 as u8)
    end
    ncmd++
    tb_le(h, 0x1B as i64, 4)
    tb_le(h, 24 as i64, 4)
    mut uh := 0x5a17 as i64
    repeat 16 in u:
        uh = (uh * (1103515245 as i64) + (12345 as i64) +
            (cs_off >> ((u % 8) as i64))) & (0x7FFFFFFF as i64)
        h.Push((uh & (255 as i64)) as u8)
    end
    ncmd++
    tb_le(h, 0x32 as i64, 4)
    tb_le(h, 24 as i64, 4)
    tb_le(h, 1 as i64, 4)
    tb_le(h, l.mo_minos, 4)
    tb_le(h, l.mo_minos, 4)
    tb_le(h, 0 as i64, 4)
    ncmd++
    if not l.shared:
        ent := glob_find(l, "_main")
        tb_le(h, 0x80000028 as i64, 4)
        tb_le(h, 24 as i64, 4)
        tb_le(h, mo_sym_g(l, ent) - t.base, 8)
        tb_le(h, 0 as i64, 8)
        ncmd++
    end
    each dname in dyl:
        dsz := 24 + ((str.Len(dname) + 8) / 8) * 8
        tb_le(h, 0x0C as i64, 4)
        tb_le(h, dsz as i64, 4)
        tb_le(h, 24 as i64, 4)
        tb_le(h, 2 as i64, 4)
        tb_le(
            h, (str.Equals(dname, "/usr/lib/libSystem.B.dylib") ? 0x05270000 : 0x00010000) as i64,
            4
        )
        tb_le(h, 0x00010000 as i64, 4)
        tb_cstr(h, dname)
        until (h.Len() % 8) != 0:
            h.Push(0 as u8)
        end
        ncmd++
    end
    tb_le(h, 0x29 as i64, 4)
    tb_le(h, 16 as i64, 4)
    tb_le(h, dic_off, 4)
    tb_le(h, (8 * ndic) as i64, 4)
    ncmd++
    tb_le(h, 0x1D as i64, 4)
    tb_le(h, 16 as i64, 4)
    tb_le(h, cs_off, 4)
    tb_le(h, cs_len as i64, 4)
    ncmd++
    if (h.Len() as i64) > t.hdr:
        nl_fail(l, "Mach-O header does not fit")
        ret
    end
    put32_le(h, 16, ncmd as i64)
    put32_le(h, 20, (h.Len() - 32) as i64)
    repeat h.Len() in hb:
        buf[hb] = h[hb]
    end
    mut img := Vector {} as Vector<u8>
    repeat t.le_off in ib:
        img.Push(buf[ib])
    end
    each lb in le:
        img.Push(lb)
    end
    mut cs := Vector {} as Vector<u8>
    be32(cs, 0xFADE0CC0 as i64)
    be32(cs, cs_len as i64)
    be32(cs, 1 as i64)
    be32(cs, 0 as i64)
    be32(cs, 20 as i64)
    be32(cs, 0xFADE0C02 as i64)
    be32(cs, cd_len as i64)
    be32(cs, 0x20400 as i64)
    be32(cs, 0x20002 as i64)
    be32(cs, (cd_hdr + id_len) as i64)
    be32(cs, cd_hdr as i64)
    be32(cs, 0 as i64)
    be32(cs, npages as i64)
    be32(cs, cs_off)
    cs.Push(32 as u8)
    cs.Push(2 as u8)
    cs.Push(0 as u8)
    cs.Push(12 as u8)
    be32(cs, 0 as i64)
    be32(cs, 0 as i64)
    be32(cs, 0 as i64)
    be32(cs, 0 as i64)
    be64(cs, 0 as i64)
    be64(cs, 0 as i64)
    be64(cs, t.text_end)
    be64(cs, (l.shared ? 0 : 1) as i64)
    ip := (ident as void*) as u8*
    repeat str.Len(ident) in ic:
        cs.Push(ip[ic])
    end
    cs.Push(0 as u8)
    mut hsh := Vector {} as Vector<u8>
    repeat 32:
        hsh.Push(0 as u8)
    end
    repeat npages in pg:
        st := (pg * 4096) as i64
        mut n := 4096 as i64
        if st + n > cs_off:
            n = cs_off - st
        end
        crypto.Sha256Bytes(((img.data as i64) + st) as void*, n as int, hsh.data as void*)
        each hb2 in hsh:
            cs.Push(hb2)
        end
    end
    until (cs.Len() as i64) < cs_pad:
        cs.Push(0 as u8)
    end
    each cb in cs:
        img.Push(cb)
    end
    fh := fopen(out, "wb")
    if fh == null:
        nl_fail(l, "cannot write " + out)
        ret
    end
    w := fwrite(img.data as void*, 1 as u64, img.Len() as u64, fh)
    _c := fclose(fh)
    l.file_size = img.Len() as i64
    if (w as i64) != l.file_size:
        nl_fail(l, "cannot write " + out)
        ret
    end
    _m := chmod(out, 493)
    img.Free()
    cs.Free()
    hsh.Free()
    le.Free()
    h.Free()
end

func mo_secno(l &: Nl, t &: Mo, s: int): int:
    if s < 0:
        ret 0
    end
    k := t.out_k[s]
    mut n := 0
    each kk in [
        MO_TEXT, MO_STUBS, MO_CSTR, MO_TCONST, MO_EH, MO_UNW, MO_GOT, MO_INIT, MO_CONST, MO_DATA,
        MO_TVARS, MO_TDATA, MO_TBSS, MO_BSS
    ]:
        if mo_has(l, t, kk):
            n++
            if kk == k:
                ret n
            end
        end
    end
    ret 0
end

func put32_le(h &: Vector<u8>, at: int, v: i64):
    repeat 4 in k:
        h[at + k] = ((v >> ((8 * k) as i64)) & (255 as i64)) as u8
    end
end

func basename_of(p: str): str:
    mut i := str.Len(p) - 1
    pp := (p as void*) as u8*
    until i >= 0 and pp[i] != (47 as u8):
        i--
    end
    ret str.Substr(p, i + 1, str.Len(p) - i - 1)
end

func mo_imp_index(l &: Nl, g: int, nloc: int, first_imp: int): i64:
    mut k := first_imp
    repeat l.g_name.Len() in i:
        if l.g_state[i] == SY_UNDEF and l.g_common[i] == (0 as i64):
            if i == g:
                ret k
            end
            k++
        end
    end
    _n := nloc
    ret 0x80000000
end
