package nativelink

const PS_TEXT := 0
const PS_DATA := 1
const PS_RDATA := 2
const PS_PDATA := 3
const PS_XDATA := 4
const PS_BSS := 5
const PS_IDATA := 6
const PS_TLS := 7
const PS_RSRC := 8
const PS_RELOC := 9
const PS_COUNT := 10

const IT_SEC := 0
const IT_BYTES := 1
const IT_MARK := 2
const IT_ALIGN := 3

const SYN_PEMARK := -30
const SYN_ALIAS := -31

pub struct Pe:
    pub it_ps: Vector<int> = Vector {}
    pub it_kind: Vector<int> = Vector {}
    pub it_key: Vector<str> = Vector {}
    pub it_ord: Vector<int> = Vector {}
    pub it_val: Vector<i64> = Vector {}
    pub it_addr: Vector<i64> = Vector {}
    pub bytes: Vector<u8> = Vector {}
    pub ps_va: Vector<i64> = Vector {}
    pub ps_vsize: Vector<i64> = Vector {}
    pub ps_raw: Vector<i64> = Vector {}
    pub ps_rawsize: Vector<i64> = Vector {}
    pub breloc: Vector<i64> = Vector {}
    pub nsec: int = 0
    pub hdr_size: i64 = 0
    pub image_size: i64 = 0
    pub entry: i64 = 0
    pub btype: int = 10
    pub imp_va: i64 = 0
    pub imp_size: i64 = 0
    pub dbg_rva: i64 = 0
    pub exp_rva: i64 = 0
    pub exp_size: i64 = 0
end

func pe_link(l &: Nl, out: str):
    mut t := Pe {}
    if l.icf:
        split_sections(l)
        icf_run(l)
    end
    mut ord := sec_order(l)
    each s in ord:
        if l.o_coff[l.s_obj[s]]:
            pe_classify(l, t, s)
        end
    end
    ord.Free()
    if l.mach == EM_386:
        l.pe_base = (l.pe_dll ? 0x10000000 : 0x400000) as i64
    else l.pe_dll:
        l.pe_base = 0x180000000 as i64
    end
    mut cvs := Vector {} as Vector<int>
    mut pdb := ""
    if not l.strip:
        cvs = pdb_cv_secs(l)
    end
    if cvs.Len() > 0:
        pdb = pdb_path_of(out)
        pe_bytes(t, PS_RDATA, "zpdb", PDB_RSDS + 25 + str.Len(pdb), 0)
    end
    synth(l, "__ImageBase", SYN_EHDR)
    synth(l, "__image_base__", SYN_EHDR)
    synth(l, "___ImageBase", SYN_EHDR)
    synth(l, "___image_base__", SYN_EHDR)
    if l.pe_nrsrc > 1:
        nl_fail(
            l,
            "cannot link: more than one resource section (.rsrc) in the inputs; put all resources in one object"
        )
        ret
    end
    pe_frame(l, t)
    pe_commons(l, t)
    pe_aliases(l)
    check_undefined(l)
    if not l.ok:
        ret
    end
    if l.pe_dll:
        pe_exp_collect(l)
        if l.pe_exp.Len() > 0:
            pe_item(t, PS_RDATA, IT_ALIGN, "zex0", 0, 4 as i64)
            pe_bytes(t, PS_RDATA, "zexp", pe_exp_size(l), 0)
        end
    end
    if not l.strip:
        dbg_collect_pe(l)
    end
    pe_sort(t)
    pe_place(l, t)
    until l.ok and pe_th_plan(l, t):
        t.ps_va.Clear()
        t.ps_vsize.Clear()
        t.ps_raw.Clear()
        t.ps_rawsize.Clear()
        pe_place(l, t)
    end
    mut ename := l.pe_dll ? "DllMainCRTStartup" : (l.pe_gui ? "WinMainCRTStartup" : "mainCRTStartup")
    if l.mach == EM_386:
        ename = l.pe_dll ? "_DllMainCRTStartup@12" : "_" + ename
    end
    ent := glob_find(l, ename)
    if ent < 0 or l.g_state[ent] != SY_DEF:
        nl_fail(
            l,
            "cannot link: no entry point '" + ename + "' (is " +
                (l.pe_dll ? "dllcrt2.o" : "crt2.o") + " missing?)"
        )
        ret
    end
    t.entry = l.s_addr[l.g_sec[ent]] + l.g_val[ent] - l.pe_base
    mut fpos_of := Vector {} as Vector<i64>
    mut fp := t.hdr_size
    repeat PS_COUNT in k:
        fpos_of.Push(fp)
        if k != PS_BSS and k != PS_RELOC and t.ps_vsize[k] > (0 as i64):
            t.ps_raw[k] = fp
            t.ps_rawsize[k] = align_to(t.ps_vsize[k], 0x200 as i64)
            fp += t.ps_rawsize[k]
        end
    end
    total := fp
    buf := malloc((total + (0x200 as i64)) as u64) as u8*
    repeat total in z:
        buf[z] = 0 as u8
    end
    repeat t.it_ps.Len() in i:
        k2 := t.it_ps[i]
        if k2 == PS_BSS:
            continue
        end
        dst := fpos_of[k2] + (t.it_addr[i] - t.ps_va[k2])
        if t.it_kind[i] == IT_SEC:
            s2 := t.it_ord[i]
            if l.s_type[s2] != 8 and l.s_off[s2] > (0 as i64):
                p := fptr(l, l.o_file[l.s_obj[s2]])
                repeat l.s_size[s2] in b:
                    buf[dst + b] = p[l.s_off[s2] + b]
                end
            end
            if l.th_count.Has(s2):
                pe_th_write(l, buf, s2, dst)
            end
        else t.it_kind[i] == IT_BYTES:
            at := t.it_val[i] >> (32 as i64)
            n := t.it_val[i] & (0xFFFFFFFF as i64)
            repeat n in b2:
                buf[dst + b2] = t.bytes[(at + b2) as int]
            end
        end
    end
    pe_relocs(l, t, buf, fpos_of)
    if not l.ok:
        ret
    end
    pe_exp_fill(l, t, buf, fpos_of)
    if l.dg_name.Len() > 0:
        dbg_build_pe(l)
    end
    mut rel := Vector {} as Vector<u8>
    if l.mach == EM_386:
        t.btype = 3
    end
    pe_breloc_build(t, rel)
    t.ps_vsize[PS_RELOC] = rel.Len() as i64
    t.ps_raw[PS_RELOC] = fp
    t.ps_rawsize[PS_RELOC] = align_to(rel.Len() as i64, 0x200 as i64)
    t.image_size = align_to(t.ps_va[PS_RELOC] + (rel.Len() as i64), 0x1000 as i64)
    if l.dg_name.Len() > 0:
        t.image_size = dbg_layout_pe(l, t.image_size, fp + t.ps_rawsize[PS_RELOC])
    end
    mut g0 := 0 as i64
    mut g1 := 0 as i64
    if cvs.Len() > 0:
        g0 = pdb_guid(buf, total, 0)
        g1 = pdb_guid(buf, total, 1)
        pe_rsds(t, buf, fpos_of, g0, g1, pdb)
    end
    pe_write(l, t, buf, total, rel, out)
    if cvs.Len() > 0 and l.ok:
        mut sh := pe_sechdrs(l, t)
        if not pdb_write(l, t, cvs, sh, g0, g1, pdb):
            nl_fail(l, "cannot write " + pdb)
        end
        sh.Free()
    end
    cvs.Free()
    rel.Free()
    fpos_of.Free()
end
