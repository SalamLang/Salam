package nativelink

import str

pub struct WinRes:
    pub icon: str = ""
    pub manifest: str = ""
    pub version: str = ""
    pub company: str = ""
    pub description: str = ""
    pub product: str = ""
    pub copyright: str = ""
    pub file_name: str = ""
    pub dll: bool = false
end

struct RsList:
    pub rtype: Vector<int> = Vector {}
    pub rid: Vector<int> = Vector {}
    pub rdata: Vector<Vector<u8>> = Vector {}
end

func rs_has_version(r: WinRes): bool:
    ret str.Len(r.version) > 0 or str.Len(r.company) > 0 or str.Len(r.description) > 0 or str.Len(r.product) > 0 or str.Len(r.copyright) > 0
end

func rs_file(path: str, out &: Vector<u8>): bool:
    f := fopen(path, "rb")
    if f == null:
        ret false
    end
    n := file_size(f)
    if n < (0 as i64):
        _c0 := fclose(f)
        ret false
    end
    buf := malloc((n + (1 as i64)) as u64) as u8*
    got := fread(buf as void*, 1 as u64, n as u64, f)
    _c := fclose(f)
    repeat n in i:
        out.push(buf[i])
    end
    free(buf as void*)
    ret (got as i64) == n
end

func rv16(v &: Vector<u8>, o: int): int:
    ret (v[o] as int) | ((v[o + 1] as int) << 8)
end

func rv32(v &: Vector<u8>, o: int): i64:
    ret (rv16(v, o) as i64) | ((rv16(v, o + 2) as i64) << (16 as i64))
end

func rs_add(rl &: RsList, ty: int, id: int, data: Vector<u8>):
    rl.rtype.push(ty)
    rl.rid.push(id)
    rl.rdata.push(data)
end

func rs_icon(rl &: RsList, path: str, err &: str): bool:
    mut b := Vector {} as Vector<u8>
    if not rs_file(path, b):
        err = "cannot read icon " + path
        b.free()
        ret false
    end
    if b.len() < 6 or rv16(b, 0) != 0 or rv16(b, 2) != 1 or rv16(b, 4) == 0 or b.len() < 6 + 16 * rv16(b, 4):
        err = path + " is not a Windows .ico file"
        b.free()
        ret false
    end
    n := rv16(b, 4)
    mut grp := Vector {} as Vector<u8>
    tb_le(grp, 0 as i64, 2)
    tb_le(grp, 1 as i64, 2)
    tb_le(grp, n as i64, 2)
    repeat n in i:
        e := 6 + 16 * i
        size := rv32(b, e + 8)
        off := rv32(b, e + 12)
        if off + size > (b.len() as i64) or size <= (0 as i64):
            err = path + ": image " + str.FromInt((i + 1) as i64) + " lies outside the file"
            b.free()
            grp.free()
            ret false
        end
        mut img := Vector {} as Vector<u8>
        repeat size in k:
            img.push(b[(off + k) as int])
        end
        rs_add(rl, 3, i + 1, img)
        repeat 12 in q:
            grp.push(b[e + q])
        end
        tb_le(grp, (i + 1) as i64, 2)
    end
    rs_add(rl, 14, 1, grp)
    b.free()
    ret true
end

func rs_utf16(v &: Vector<u8>, s: str):
    p := (s as void*) as u8*
    n := str.Len(s)
    mut i := 0
    until i < n:
        c := p[i] as int
        mut cp := 0xFFFD
        mut k := 1
        if c < 0x80:
            cp = c
        else c >= 0xF0 and i + 3 < n and c < 0xF8:
            cp = ((c & 7) << 18) | (((p[i + 1] as int) & 63) << 12) | (((p[i + 2] as int) & 63) << 6) | ((p[i + 3] as int) & 63)
            k = 4
        else c >= 0xE0 and i + 2 < n and c < 0xF0:
            cp = ((c & 15) << 12) | (((p[i + 1] as int) & 63) << 6) | ((p[i + 2] as int) & 63)
            k = 3
        else c >= 0xC0 and i + 1 < n and c < 0xE0:
            cp = ((c & 31) << 6) | ((p[i + 1] as int) & 63)
            k = 2
        end
        if cp >= 0x10000:
            cp -= 0x10000
            tb_le(v, (0xD800 | (cp >> 10)) as i64, 2)
            tb_le(v, (0xDC00 | (cp & 0x3FF)) as i64, 2)
        else:
            tb_le(v, cp as i64, 2)
        end
        i += k
    end
    tb_le(v, 0 as i64, 2)
end

func rs_pad4(v &: Vector<u8>):
    until (v.len() % 4) != 0:
        v.push(0 as u8)
    end
end

func vs_begin(key: str, vlen: int, vtype: int): Vector<u8>:
    mut v := Vector {} as Vector<u8>
    tb_le(v, 0 as i64, 2)
    tb_le(v, vlen as i64, 2)
    tb_le(v, vtype as i64, 2)
    rs_utf16(v, key)
    rs_pad4(v)
    ret v
end

func vs_end(v &: Vector<u8>):
    n := v.len()
    v[0] = (n & 255) as u8
    v[1] = ((n >> 8) & 255) as u8
end

func vs_child(v &: Vector<u8>, c: Vector<u8>):
    rs_pad4(v)
    each x in c:
        v.push(x)
    end
    c.free()
end

func vs_string(key: str, val: str): Vector<u8>:
    mut w := Vector {} as Vector<u8>
    rs_utf16(w, val)
    mut v := vs_begin(key, w.len() / 2, 1)
    each x in w:
        v.push(x)
    end
    w.free()
    vs_end(v)
    ret v
end

func rs_ver_word(s: str, part: int): i64:
    mut idx := 0
    mut val := 0 as i64
    mut seen := false
    p := (s as void*) as u8*
    repeat str.Len(s) in i:
        c := p[i] as int
        if c == 46:
            idx++
        else c >= 48 and c <= 57:
            if idx == part:
                val = (val * (10 as i64) + ((c - 48) as i64)) & (0xFFFF as i64)
                seen = true
            end
        else:
            break
        end
    end
    ret seen ? val : (0 as i64)
end

func rs_stem(name: str): str:
    dot := str.LastIndex(name, ".")
    if dot > 0:
        ret str.Substr(name, 0, dot)
    end
    ret name
end

func rs_version(r: WinRes): Vector<u8>:
    vs := str.Len(r.version) > 0 ? r.version : "0.0.0.0"
    ms := (rs_ver_word(vs, 0) << (16 as i64)) | rs_ver_word(vs, 1)
    ls := (rs_ver_word(vs, 2) << (16 as i64)) | rs_ver_word(vs, 3)
    mut v := vs_begin("VS_VERSION_INFO", 52, 0)
    tb_le(v, 0xFEEF04BD as i64, 4)
    tb_le(v, 0x00010000 as i64, 4)
    tb_le(v, ms, 4)
    tb_le(v, ls, 4)
    tb_le(v, ms, 4)
    tb_le(v, ls, 4)
    tb_le(v, 0x3F as i64, 4)
    tb_le(v, 0 as i64, 4)
    tb_le(v, 0x00040004 as i64, 4)
    tb_le(v, (r.dll ? 2 : 1) as i64, 4)
    tb_le(v, 0 as i64, 4)
    tb_le(v, 0 as i64, 4)
    tb_le(v, 0 as i64, 4)
    stem := rs_stem(r.file_name)
    product := str.Len(r.product) > 0 ? r.product : stem
    mut tbl := vs_begin("040904B0", 0, 1)
    if str.Len(r.company) > 0:
        vs_child(tbl, vs_string("CompanyName", r.company))
    end
    vs_child(tbl, vs_string("FileDescription", str.Len(r.description) > 0 ? r.description : product))
    vs_child(tbl, vs_string("FileVersion", vs))
    vs_child(tbl, vs_string("InternalName", stem))
    if str.Len(r.copyright) > 0:
        vs_child(tbl, vs_string("LegalCopyright", r.copyright))
    end
    vs_child(tbl, vs_string("OriginalFilename", r.file_name))
    vs_child(tbl, vs_string("ProductName", product))
    vs_child(tbl, vs_string("ProductVersion", vs))
    vs_end(tbl)
    mut sfi := vs_begin("StringFileInfo", 0, 1)
    vs_child(sfi, tbl)
    vs_end(sfi)
    mut tr := vs_begin("Translation", 4, 0)
    tb_le(tr, 0x0409 as i64, 2)
    tb_le(tr, 0x04B0 as i64, 2)
    vs_end(tr)
    mut vfi := vs_begin("VarFileInfo", 0, 1)
    vs_child(vfi, tr)
    vs_end(vfi)
    vs_child(v, sfi)
    vs_child(v, vfi)
    vs_end(v)
    ret v
end

func rs_sort(rl &: RsList):
    n := rl.rtype.len()
    mut i := 1
    until i < n:
        mut j := i
        until j > 0 and (rl.rtype[j] < rl.rtype[j - 1] or (rl.rtype[j] == rl.rtype[j - 1] and rl.rid[j] < rl.rid[j - 1])):
            t := rl.rtype[j]
            rl.rtype[j] = rl.rtype[j - 1]
            rl.rtype[j - 1] = t
            d := rl.rid[j]
            rl.rid[j] = rl.rid[j - 1]
            rl.rid[j - 1] = d
            x := rl.rdata[j]
            rl.rdata[j] = rl.rdata[j - 1]
            rl.rdata[j - 1] = x
            j--
        end
        i++
    end
end

func rs_dir(v &: Vector<u8>, nids: int):
    tb_le(v, 0 as i64, 4)
    tb_le(v, 0 as i64, 4)
    tb_le(v, 0 as i64, 4)
    tb_le(v, 0 as i64, 2)
    tb_le(v, nids as i64, 2)
end

func rs_tree(rl &: RsList, relocs &: Vector<int>): Vector<u8>:
    n := rl.rtype.len()
    mut types := Vector {} as Vector<int>
    repeat n in i:
        if i == 0 or rl.rtype[i] != rl.rtype[i - 1]:
            types.push(i)
        end
    end
    nt := types.len()
    tdir := 16 + 8 * nt
    mut ndir_at := Vector {} as Vector<int>
    mut pos := tdir
    repeat nt in t:
        ndir_at.push(pos)
        tend := t + 1 < nt ? types[t + 1] : n
        pos += 16 + 8 * (tend - types[t])
    end
    ldir0 := pos
    de0 := ldir0 + 24 * n
    mut dat := Vector {} as Vector<int>
    mut dp := de0 + 16 * n
    repeat n in i2:
        dp = (dp + 7) / 8 * 8
        dat.push(dp)
        dp += rl.rdata[i2].len()
    end
    mut v := Vector {} as Vector<u8>
    rs_dir(v, nt)
    repeat nt in t2:
        tb_le(v, rl.rtype[types[t2]] as i64, 4)
        tb_le(v, (ndir_at[t2] as i64) | (0x80000000 as i64), 4)
    end
    repeat nt in t3:
        tend3 := t3 + 1 < nt ? types[t3 + 1] : n
        rs_dir(v, tend3 - types[t3])
        mut e := types[t3]
        until e < tend3:
            tb_le(v, rl.rid[e] as i64, 4)
            tb_le(v, ((ldir0 + 24 * e) as i64) | (0x80000000 as i64), 4)
            e++
        end
    end
    repeat n in i3:
        rs_dir(v, 1)
        tb_le(v, 0x409 as i64, 4)
        tb_le(v, (de0 + 16 * i3) as i64, 4)
    end
    repeat n in i4:
        relocs.push(v.len())
        tb_le(v, dat[i4] as i64, 4)
        tb_le(v, rl.rdata[i4].len() as i64, 4)
        tb_le(v, 0 as i64, 4)
        tb_le(v, 0 as i64, 4)
    end
    repeat n in i5:
        until v.len() < dat[i5]:
            v.push(0 as u8)
        end
        each x in rl.rdata[i5]:
            v.push(x)
        end
    end
    rs_pad4(v)
    types.free()
    ndir_at.free()
    dat.free()
    ret v
end

pub func ResEmpty(r: WinRes): bool:
    ret str.Len(r.icon) == 0 and str.Len(r.manifest) == 0 and not rs_has_version(r)
end

pub func ResMachine(arch: str): int:
    if str.Equals(arch, "i686") or str.Equals(arch, "i386"):
        ret 0x14C
    end
    if str.Equals(arch, "aarch64") or str.Equals(arch, "arm64"):
        ret 0xAA64
    end
    ret 0x8664
end

pub func WriteResObject(r: WinRes, machine: int, path: str, err &: str): bool:
    mut rl := RsList {}
    if str.Len(r.icon) > 0 and not rs_icon(rl, r.icon, err):
        ret false
    end
    if rs_has_version(r):
        rs_add(rl, 16, 1, rs_version(r))
    end
    if str.Len(r.manifest) > 0:
        mut mf := Vector {} as Vector<u8>
        if not rs_file(r.manifest, mf):
            err = "cannot read manifest " + r.manifest
            mf.free()
            ret false
        end
        rs_add(rl, 24, r.dll ? 2 : 1, mf)
    end
    rs_sort(rl)
    mut relocs := Vector {} as Vector<int>
    tree := rs_tree(rl, relocs)
    mut b := CoffB { mach = machine }
    s := cb_sec(b, ".rsrc", 0x40300040 as i64, tree)
    y := cb_sym(b, ".rsrc", s, 3)
    nb := imp_rt_addr32nb(machine)
    each ro in relocs:
        cb_rel(b, s, ro, nb, y)
    end
    mut obj := cb_bytes(b)
    mut ok := false
    f := fopen(path, "wb")
    if f != null:
        w := fwrite(obj.data as void*, 1 as u64, obj.len() as u64, f)
        _c := fclose(f)
        ok = (w as i64) == (obj.len() as i64)
    end
    if not ok:
        err = "cannot write " + path
    end
    each d in rl.rdata:
        d.free()
    end
    each d2 in b.sdata:
        d2.free()
    end
    b.sname.free()
    b.sflag.free()
    b.sdata.free()
    b.rsec.free()
    b.roff.free()
    b.rtype.free()
    b.rsym.free()
    b.yname.free()
    b.ysec.free()
    b.yclass.free()
    rl.rtype.free()
    rl.rid.free()
    rl.rdata.free()
    obj.free()
    relocs.free()
    ret ok
end
