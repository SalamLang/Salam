// Flat merge of the salam/parser port (see salam/PORTING.md "Layout - FLAT"):
// parser.c + parser.h + parser_internal.h + parser_cursor.c + parser_decl.c +
// parser_decl_var.c + parser_expr.c + parser_expr_primary.c + parser_ffi.c +
// parser_layout.c + parser_stmt.c + parser_type.c - one package `parser`,
// one file. Import alias for consumers: `ps`.
//
// C differences (per salam/PORTING.md):
// - parser_t -> struct Ps (private). The arena is gone; nodes live in a
//   caller-provided ast.Ast (`a &: at.Ast` threaded through every rule, the
//   way the C code threads `p->a`). ast_node_t* results are at.NodeId ints
//   (0 = C NULL).
// - parser_run -> Run(lgr, toks, a, out_program): fills `out_program` with
//   the AST_PROGRAM node id and returns !had_error, exactly like the C bool.
// - p_advance() drops its (rarely used) token return: call sites that needed
//   the token read p_peek() first, like the lexer port's adv()/advc() split.
// - p_comma_list (C function-pointer helper) is inlined at its two call
//   sites (led_call argument lists, parse_type_func parameter types).
// - p_name/p_munch_* return "<error>" like C; p_member_name returns "" where
//   the C returned NULL.
// - Error paths mirror LOG_E_AT(log, PH_PARSER, file, span,
//   i18n_tr("%s (near '%s')"), i18n_tr(msg), lexeme) through logger.LogAt +
//   core.Format2 (same i18n msgids, same final text).
// - The node mutation protocol from salam/ast.salam applies: every write is
//   get-copy -> mutate -> Put inside one helper, never across a call that
//   can add nodes.
package parser

import str
import co "sal_core.salam"
import tok "token.salam"
import at "ast.salam"
import lg "logger.salam"
import i18 "i18n.salam"

// ===== parser_internal.h =====
// #define P_MAX_DEPTH 128 (parser_cursor.c)
const PS_MAX_DEPTH := 128

// parser_t - token cursor + error state. The token stream is read through
// p.toks; the Ast is a separate `a &: at.Ast` parameter everywhere.
struct Ps:
    pub toks: tok.TokenStream = tok.StreamNew("")
    pub count: int = 0
    pub pos: int = 0
    pub file: str = ""
    pub lgr: lg.Logger = lg.New(2, false)
    pub had_error: bool = false
    pub panic: bool = false
    pub no_struct_lit: bool = false
    pub no_with_word: bool = false
    pub depth: int = 0
    pub angle_pending: int = 0
end

// ---------------------------------------------------------------------------
// Small shared helpers (no C equivalent: NodeId field writes need get/put).
// ---------------------------------------------------------------------------

func byte_at(s: str, i: int): int:
    bp := (s as void*) as i8*
    mut v := bp[i] as int
    if v < 0:
        v += 256
    end
    ret v
end

func ps_set_a(a &: at.Ast, id: int, v: int):
    mut n := at.Get(a, id)
    n.a = v
    at.Put(a, id, n)
end

func ps_set_b(a &: at.Ast, id: int, v: int):
    mut n := at.Get(a, id)
    n.b = v
    at.Put(a, id, n)
end

func ps_set_c(a &: at.Ast, id: int, v: int):
    mut n := at.Get(a, id)
    n.c = v
    at.Put(a, id, n)
end

func ps_set_d(a &: at.Ast, id: int, v: int):
    mut n := at.Get(a, id)
    n.d = v
    at.Put(a, id, n)
end

// ast_new(kind, &other->span): new node whose span is copied from `src`.
func mk_from_node(a &: at.Ast, kind: int, src: int): int:
    s := at.Get(a, src)
    id := at.NewNode(a, kind)
    at.SetSpan(
        a, id, s.begin_line, s.begin_col, s.begin_index, s.end_line, s.end_col, s.end_index, s.length
    )
    ret id
end

// n->span.end = src->span.end
func ps_end_from_node(a &: at.Ast, id: int, src: int):
    s := at.Get(a, src)
    mut n := at.Get(a, id)
    n.end_line = s.end_line
    n.end_col = s.end_col
    n.end_index = s.end_index
    at.Put(a, id, n)
end

// ===== parser_cursor.c =====

func is_comment_kind(k: int): bool:
    ret k == tok.TK_COMMENT_LINE || k == tok.TK_COMMENT_BLOCK
end

func skip_comments_from(p &: Ps, from: int): int:
    mut i := from
    until i < p.count - 1 && is_comment_kind(p.toks.toks.get(i)[0].kind):
        i += 1
    end
    ret i
end

func p_peek(p &: Ps): tok.Token:
    mut i := skip_comments_from(p, p.pos)
    if i >= p.count:
        i = p.count - 1
    end
    ret p.toks.toks.get(i)[0]
end

func p_peek2(p &: Ps): tok.Token:
    mut i := skip_comments_from(p, p.pos)
    if i < p.count - 1:
        i = skip_comments_from(p, i + 1)
    end
    if i >= p.count:
        i = p.count - 1
    end
    ret p.toks.toks.get(i)[0]
end

func p_prev(p &: Ps): tok.Token:
    mut i := 0
    if p.pos > 0:
        i = p.pos - 1
    end
    ret p.toks.toks.get(i)[0]
end

func p_at(p &: Ps, k: int): bool:
    ret p_peek(p).kind == k
end

func p_at_eof(p &: Ps): bool:
    ret p_peek(p).kind == tok.TK_EOF
end

// p_advance - the C token_t* return is dropped (call sites p_peek first).
func p_advance(p &: Ps):
    p.pos = skip_comments_from(p, p.pos)
    if p.pos < p.count - 1:
        p.pos += 1
        p.pos = skip_comments_from(p, p.pos)
    end
end

func p_match(p &: Ps, k: int): bool:
    if p_at(p, k):
        p_advance(p)
        ret true
    end
    ret false
end

func p_skip_terminators(p &: Ps):
    until p_at(p, tok.TK_STMT_END):
        p_advance(p)
    end
end

func p_error(p &: Ps, msg: str):
    if p.panic:
        ret
    end
    t := p_peek(p)
    // C: t->lexeme ? t->lexeme : "<eof>" - the lexer never emits a NULL
    // lexeme (EOF carries ""), so the fallback cannot trigger here.
    m := co.Format2(
        i18.Tr("%s (near '%s')"), co.ArgStr(i18.Tr(msg)), co.ArgStr(t.lexeme)
    )
    lg.LogAt(
        p.lgr, lg.PH_PARSER, lg.LOG_ERROR, p.file, t.begin_line as int, t.begin_col as int, m
    )
    p.had_error = true
    p.panic = true
end

func p_expect(p &: Ps, k: int, what: str): bool:
    if p_at(p, k):
        p_advance(p)
        ret true
    end
    p_error(p, co.Format1(i18.Tr("expected %s"), co.ArgStr(i18.Tr(what))))
    ret false
end

func p_close_angle(p &: Ps, what: str): bool:
    if p.angle_pending > 0:
        p.angle_pending -= 1
        ret true
    end
    if p_at(p, tok.TK_GT):
        p_advance(p)
        ret true
    end
    if p_at(p, tok.TK_SHR):
        p_advance(p)
        p.angle_pending += 1
        ret true
    end
    p_error(p, co.Format1(i18.Tr("expected %s"), co.ArgStr(i18.Tr(what))))
    ret false
end

func p_sync(p &: Ps):
    p.panic = false
    // Drop any half-consumed '>>' split so a malformed generic can't leak a
    // synthetic '>' into a later, unrelated one.
    p.angle_pending = 0
    until !p_at_eof(p):
        k := p_peek(p).kind
        if k == tok.TK_STMT_END:
            p_advance(p)
            ret
        end
        if k == tok.TK_KW_FUNC || k == tok.TK_KW_STRUCT || k == tok.TK_KW_ENUM || k == tok.TK_KW_TYPE || k == tok.TK_KW_CONST || k == tok.TK_KW_IMPORT || k == tok.TK_KW_LAYOUT || k == tok.TK_KW_IF || k == tok.TK_KW_UNTIL || k == tok.TK_KW_EACH || k == tok.TK_KW_REPEAT || k == tok.TK_KW_MATCH || k == tok.TK_KW_RET || k == tok.TK_RBRACE || k == tok.TK_KW_END:
            ret
        end
        p_advance(p)
    end
end

// p_mk - ast_new with the current token's span.
func p_mk(p &: Ps, a &: at.Ast, kind: int): int:
    t := p_peek(p)
    id := at.NewNode(a, kind)
    at.SetSpan(
        a, id, t.begin_line, t.begin_col, t.begin_index, t.end_line, t.end_col, t.end_index, t.length
    )
    ret id
end

// p_fin - n->span.end = p_prev(p)->span.end.
func p_fin(p &: Ps, a &: at.Ast, id: int):
    t := p_prev(p)
    mut n := at.Get(a, id)
    n.end_line = t.end_line
    n.end_col = t.end_col
    n.end_index = t.end_index
    at.Put(a, id, n)
end

func p_term(p &: Ps):
    if p_at(p, tok.TK_STMT_END):
        p_advance(p)
    end
end

// P_RULE macro - trace-level rule logging.
func p_rule(p &: Ps, nm: str):
    if lg.Enabled(p.lgr, lg.LOG_TRACE):
        t := p_peek(p)
        lg.LogAt(
            p.lgr, lg.PH_PARSER, lg.LOG_TRACE, p.file, t.begin_line as int, t.begin_col as int, "rule " + nm + " @ " + tok.KindName(t.kind)
        )
    end
end

func p_at_reserved_word(p &: Ps): bool:
    t := p_peek(p)
    if tok.IsKeyword(t.kind):
        ret true
    end
    if t.kind == tok.TK_AND || t.kind == tok.TK_OR:
        ret t.lexeme.len() > 0 && byte_at(t.lexeme, 0) >= 128
    end
    ret false
end

func p_name(p &: Ps, what: str): str:
    if p_at(p, tok.TK_IDENT):
        s := p_peek(p).lexeme
        p_advance(p)
        ret s
    end
    if p_at_reserved_word(p):
        p_error(
            p, co.Format1(
                i18.Tr("%s (reserved word cannot be used as a name)"), co.ArgStr(i18.Tr(what))
            )
        )
        p_advance(p)
        ret "<error>"
    end
    p_error(p, what)
    ret "<error>"
end

// "" stands in for the C NULL return.
func p_member_name(p &: Ps, what: str): str:
    if p_at(p, tok.TK_IDENT) || tok.IsKeyword(p_peek(p).kind):
        s := p_peek(p).lexeme
        p_advance(p)
        ret s
    end
    p_error(p, what)
    ret ""
end

func p_error_node(p &: Ps, a &: at.Ast): int:
    n := p_mk(p, a, at.AST_IDENTIFIER)
    at.SetName(a, n, "<error>")
    p_fin(p, a, n)
    ret n
end

func p_peekn(p &: Ps, k: int): tok.Token:
    mut i := skip_comments_from(p, p.pos)
    repeat k:
        if i < p.count - 1:
            i += 1
            i = skip_comments_from(p, i)
        end
    end
    if i >= p.count:
        i = p.count - 1
    end
    ret p.toks.toks.get(i)[0]
end

func p_ident_run_len(p &: Ps): int:
    mut m := 0
    mut line := 0 as u32
    mut have := false
    until p_peekn(p, m).kind == tok.TK_IDENT:
        l := p_peekn(p, m).begin_line
        if !have:
            line = l
            have = true
        else l != line:
            break
        end
        m += 1
    end
    ret m
end

func p_munch_name(p &: Ps): str:
    if !p_at(p, tok.TK_IDENT):
        ret p_name(p, "expected name")
    end
    mut b := ""
    mut first := true
    line := p_peek(p).begin_line
    until p_at(p, tok.TK_IDENT) && p_peek(p).begin_line == line:
        if !first:
            b = b + " "
        end
        b = b + p_peek(p).lexeme
        first = false
        p_advance(p)
    end
    ret b
end

func p_is_alias_word_keyword(k: int): bool:
    ret k == tok.TK_KW_WITH || k == tok.TK_KW_PACKAGE
end

/* 'with' normally merges into a multi-word member name ('cfg.retry with backoff'),
 * but a repeat header ends with 'with <index>', so the loop bound must stop the
 * merge there or 'repeat box.count with i' reads as the field 'count with i'. */
func p_at_mergeable_word(p &: Ps): bool:
    k := p_peek(p).kind
    if k == tok.TK_KW_WITH && p.no_with_word:
        ret false
    end
    ret k == tok.TK_IDENT || p_is_alias_word_keyword(k)
end

func p_at_mergeable_value_word(p &: Ps): bool:
    k := p_peek(p).kind
    ret k == tok.TK_IDENT || k == tok.TK_KW_PACKAGE
end

/* Only ':=' introduces a brand-new binding; plain '=' and the compound
 * assign operators always target an already-declared name, so they must
 * not stop a multi-word merge (e.g. 'thread result = 99', 'up seq = ...').
 * ':=' does stop it, since a bare identifier immediately followed by ':='
 * is starting its own declaration, not continuing the identifier before
 * it (e.g. '... - base\ny := ...' on one line). */
func tk_is_new_binding(k: int): bool:
    ret k == tok.TK_COLON_ASSIGN
end

func p_munch_value_name(p &: Ps): str:
    if !p_at(p, tok.TK_IDENT):
        ret p_name(p, "expected name")
    end
    line := p_peek(p).begin_line
    mut b := p_peek(p).lexeme
    p_advance(p)
    until p_at_mergeable_value_word(p) && p_peek(p).begin_line == line && !tk_is_new_binding(p_peek2(p).kind):
        b = b + " " + p_peek(p).lexeme
        p_advance(p)
    end
    ret b
end

func p_munch_member_name(p &: Ps, what: str): str:
    if !p_at_mergeable_word(p):
        ret p_member_name(p, what)
    end
    line := p_peek(p).begin_line
    mut b := p_peek(p).lexeme
    p_advance(p)
    until p_at_mergeable_word(p) && p_peek(p).begin_line == line:
        b = b + " " + p_peek(p).lexeme
        p_advance(p)
    end
    ret b
end

func parse_decl_name(p &: Ps): str:
    ret p_munch_name(p)
end

func p_recurse_enter(p &: Ps, what: str): bool:
    if p.depth >= PS_MAX_DEPTH:
        p_error(p, what)
        ret false
    end
    p.depth += 1
    ret true
end

func p_recurse_leave(p &: Ps):
    p.depth -= 1
end

// p_try_return_type - speculative ": Type" after a function header. Writes
// `out_type` and returns true only on success (C wrote *out_type).
func p_try_return_type(p &: Ps, a &: at.Ast, out_type &: int): bool:
    if !p_at(p, tok.TK_COLON):
        ret false
    end
    save_pos := p.pos
    colon_line := p_peek(p).begin_line
    p_advance(p)
    if p_peek(p).begin_line != colon_line:
        p.pos = save_pos
        ret false
    end
    save_panic := p.panic
    save_had_error := p.had_error
    p.panic = true
    t := parse_type(p, a)
    tname := at.Get(a, t).name
    valid_name := tname.len() > 0 && !str.Equals(tname, "<error>")
    if valid_name && (p_at(p, tok.TK_COLON) || p_at(p, tok.TK_STMT_END) || p_at_eof(p)):
        p.panic = save_panic
        out_type = t
        ret true
    end
    p.pos = save_pos
    p.panic = save_panic
    p.had_error = save_had_error
    ret false
end

// ===== parser_expr.c =====

func bp_pack(l: int, r: int): int:
    ret (l << 16) | r
end

func bp_left(w: int): int:
    ret w >> 16
end

func bp_right(w: int): int:
    ret w & 0xFFFF
end

func bp_of(k: int): int:
    if k == tok.TK_ASSIGN || k == tok.TK_PLUS_EQ || k == tok.TK_MINUS_EQ || k == tok.TK_STAR_EQ || k == tok.TK_SLASH_EQ || k == tok.TK_PERCENT_EQ || k == tok.TK_POWER_EQ || k == tok.TK_AMP_EQ || k == tok.TK_PIPE_EQ || k == tok.TK_CARET_EQ || k == tok.TK_SHL_EQ || k == tok.TK_SHR_EQ:
        ret bp_pack(10, 10)
    end
    if k == tok.TK_QUESTION:
        ret bp_pack(15, 14)
    end
    if k == tok.TK_OR:
        ret bp_pack(20, 21)
    end
    if k == tok.TK_AND:
        ret bp_pack(30, 31)
    end
    // Bitwise, C precedence: '|' looser than '^' looser than '&', all looser
    // than equality and tighter than logical '&&'.
    if k == tok.TK_PIPE:
        ret bp_pack(32, 33)
    end
    if k == tok.TK_CARET:
        ret bp_pack(34, 35)
    end
    if k == tok.TK_AMP:
        ret bp_pack(36, 37)
    end
    if k == tok.TK_EQ || k == tok.TK_NE:
        ret bp_pack(40, 41)
    end
    if k == tok.TK_LT || k == tok.TK_GT || k == tok.TK_LE || k == tok.TK_GE:
        ret bp_pack(50, 51)
    end
    // Shifts: tighter than comparison, looser than '+'/'-' (C precedence).
    if k == tok.TK_SHL || k == tok.TK_SHR:
        ret bp_pack(56, 57)
    end
    if k == tok.TK_PLUS || k == tok.TK_MINUS:
        ret bp_pack(60, 61)
    end
    if k == tok.TK_STAR || k == tok.TK_SLASH || k == tok.TK_PERCENT:
        ret bp_pack(70, 71)
    end
    if k == tok.TK_KW_AS:
        ret bp_pack(80, 81)
    end
    if k == tok.TK_POWER:
        ret bp_pack(100, 100)
    end
    if k == tok.TK_PLUS_PLUS || k == tok.TK_MINUS_MINUS:
        ret bp_pack(105, 105)
    end
    if k == tok.TK_LPAREN || k == tok.TK_LBRACKET || k == tok.TK_DOT:
        ret bp_pack(110, 111)
    end
    ret 0
end

func make_incdec(p &: Ps, a &: at.Ast, op: int, operand: int, prefix: bool): int:
    mut n := 0
    if operand != 0:
        n = mk_from_node(a, at.AST_INCDEC, operand)
    else:
        n = p_mk(p, a, at.AST_INCDEC)
    end
    mut nn := at.Get(a, n)
    nn.op = op
    nn.a = operand
    nn.is_prefix = prefix
    at.Put(a, n, nn)
    ret n
end

func make_binary(a &: at.Ast, op: int, l: int, r: int): int:
    n := mk_from_node(a, at.AST_BINARY, l)
    mut nn := at.Get(a, n)
    nn.op = op
    nn.a = l
    nn.b = r
    at.Put(a, n, nn)
    if r != 0:
        ps_end_from_node(a, n, r)
    end
    ret n
end

func parse_nud(p &: Ps, a &: at.Ast): int:
    k := p_peek(p).kind

    if k == tok.TK_NOT || k == tok.TK_MINUS || k == tok.TK_TILDE:
        n := p_mk(p, a, at.AST_UNARY)
        at.SetOp(a, n, k)
        p_advance(p)
        ps_set_a(a, n, parse_expr_bp(p, a, 90))
        p_fin(p, a, n)
        ret n
    end
    if k == tok.TK_PLUS_PLUS || k == tok.TK_MINUS_MINUS:
        start := p_peek(p)
        p_advance(p)
        operand := parse_expr_bp(p, a, 105)
        n := make_incdec(p, a, k, operand, true)
        mut nn := at.Get(a, n)
        nn.begin_line = start.begin_line
        nn.begin_col = start.begin_col
        nn.begin_index = start.begin_index
        at.Put(a, n, nn)
        ret n
    end
    ret parse_primary(p, a)
end

func led_call(p &: Ps, a &: at.Ast, lhs: int): int:
    call := mk_from_node(a, at.AST_CALL, lhs)
    ps_set_a(a, call, lhs)
    p_advance(p)

    lnode := at.Get(a, lhs)
    if lnode.kind == at.AST_IDENTIFIER && str.Equals(lnode.name, "sizeof"):
        at.AddChild(a, call, parse_type(p, a))
        p_expect(p, tok.TK_RPAREN, "')' after sizeof type")
        p_fin(p, a, call)
        ret call
    end
    // p_comma_list(p, call, TK_RPAREN, parse_expr) inlined:
    if !p_at(p, tok.TK_RPAREN):
        mut go := true
        until go:
            at.AddChild(a, call, parse_expr(p, a))
            go = p_match(p, tok.TK_COMMA)
        end
    end
    p_expect(p, tok.TK_RPAREN, "')' after arguments")
    p_fin(p, a, call)
    ret call
end

func led_index(p &: Ps, a &: at.Ast, lhs: int): int:
    p_advance(p)
    p_skip_terminators(p)

    mut lo := 0
    if !p_at(p, tok.TK_COLON):
        lo = parse_expr_bp(p, a, 0)
    end
    p_skip_terminators(p)

    if p_at(p, tok.TK_COLON):
        p_advance(p)
        p_skip_terminators(p)
        mut hi := 0
        if !p_at(p, tok.TK_RBRACKET):
            hi = parse_expr_bp(p, a, 0)
        end
        p_skip_terminators(p)
        p_expect(p, tok.TK_RBRACKET, "']' to close slice range 'a[lo:hi]'")
        sl := mk_from_node(a, at.AST_SLICE, lhs)
        mut sn := at.Get(a, sl)
        sn.a = lhs
        sn.b = lo
        sn.c = hi
        at.Put(a, sl, sn)
        p_fin(p, a, sl)
        ret sl
    end

    idx := mk_from_node(a, at.AST_INDEX, lhs)
    mut ix := at.Get(a, idx)
    ix.a = lhs
    ix.b = lo
    at.Put(a, idx, ix)
    p_expect(p, tok.TK_RBRACKET, "']' after index")
    p_fin(p, a, idx)
    ret idx
end

func led_member(p &: Ps, a &: at.Ast, lhs: int): int:
    m := mk_from_node(a, at.AST_MEMBER, lhs)
    ps_set_a(a, m, lhs)
    p_advance(p)

    at.SetName(a, m, p_munch_member_name(p, "expected member name after '.'"))
    p_fin(p, a, m)
    ret m
end

func led_cast(p &: Ps, a &: at.Ast, lhs: int): int:
    p_advance(p)
    cast := mk_from_node(a, at.AST_CAST, lhs)
    ps_set_a(a, cast, lhs)
    at.SetTypeNode(a, cast, parse_type(p, a))
    p_fin(p, a, cast)
    ret cast
end

func led_ternary(p &: Ps, a &: at.Ast, lhs: int, w: int): int:
    p_advance(p)
    mut n := 0
    if lhs != 0:
        n = mk_from_node(a, at.AST_TERNARY, lhs)
    else:
        n = p_mk(p, a, at.AST_TERNARY)
    end
    ps_set_a(a, n, lhs)
    ps_set_b(a, n, parse_expr_bp(p, a, 0))
    p_expect(p, tok.TK_COLON, "':' in conditional expression 'cond ? a : b'")
    ps_set_c(a, n, parse_expr_bp(p, a, bp_right(w)))
    p_fin(p, a, n)
    ret n
end

func led_assign(p &: Ps, a &: at.Ast, lhs: int, op: int, w: int): int:
    p_advance(p)
    mut n := 0
    if lhs != 0:
        n = mk_from_node(a, at.AST_ASSIGN, lhs)
    else:
        n = p_mk(p, a, at.AST_ASSIGN)
    end
    at.SetOp(a, n, op)
    ps_set_a(a, n, lhs)
    ps_set_b(a, n, parse_expr_bp(p, a, bp_right(w)))
    p_fin(p, a, n)
    ret n
end

func parse_led(p &: Ps, a &: at.Ast, lhs: int, op: int, w: int): int:
    if op == tok.TK_LPAREN:
        ret led_call(p, a, lhs)
    end
    if op == tok.TK_LBRACKET:
        ret led_index(p, a, lhs)
    end
    if op == tok.TK_DOT:
        ret led_member(p, a, lhs)
    end
    if op == tok.TK_KW_AS:
        ret led_cast(p, a, lhs)
    end
    if op == tok.TK_QUESTION:
        ret led_ternary(p, a, lhs, w)
    end
    if op == tok.TK_ASSIGN || op == tok.TK_PLUS_EQ || op == tok.TK_MINUS_EQ || op == tok.TK_STAR_EQ || op == tok.TK_SLASH_EQ || op == tok.TK_PERCENT_EQ || op == tok.TK_POWER_EQ || op == tok.TK_AMP_EQ || op == tok.TK_PIPE_EQ || op == tok.TK_CARET_EQ || op == tok.TK_SHL_EQ || op == tok.TK_SHR_EQ:
        ret led_assign(p, a, lhs, op, w)
    end
    if op == tok.TK_PLUS_PLUS || op == tok.TK_MINUS_MINUS:
        n := make_incdec(p, a, op, lhs, false)
        t := p_peek(p)
        mut nn := at.Get(a, n)
        nn.end_line = t.end_line
        nn.end_col = t.end_col
        nn.end_index = t.end_index
        at.Put(a, n, nn)
        p_advance(p)
        ret n
    end
    p_advance(p)
    rhs := parse_expr_bp(p, a, bp_right(w))
    ret make_binary(a, op, lhs, rhs)
end

func parse_expr_bp(p &: Ps, a &: at.Ast, min_bp: int): int:
    if !p_recurse_enter(p, "expression nested too deeply"):
        ret p_error_node(p, a)
    end
    mut lhs := parse_nud(p, a)
    until true:
        if p.panic:
            break
        end
        op := p_peek(p).kind
        w := bp_of(op)
        if bp_left(w) == 0 || bp_left(w) < min_bp:
            break
        end
        lhs = parse_led(p, a, lhs, op, w)
    end
    p_recurse_leave(p)
    ret lhs
end

func parse_expr(p &: Ps, a &: at.Ast): int:
    ret parse_expr_bp(p, a, 0)
end

// ===== parser_expr_primary.c =====

/* Every lambda parameter is mandatorily typed ('name: Type'), so a
 * parenthesized group can only be a lambda header if it fully matches that
 * shape. This tells '(' ... '):' apart from a grouped expression that
 * simply happens to precede a ':' (e.g. an 'if (a) || (b):' condition) by
 * speculatively parsing it and rolling back on any mismatch. */
func lambda_ahead(p &: Ps, a &: at.Ast): bool:
    if !p_at(p, tok.TK_LPAREN):
        ret false
    end
    save_pos := p.pos
    save_panic := p.panic
    save_had_error := p.had_error
    p.panic = true

    p_advance(p)
    mut ok := true
    if !p_at(p, tok.TK_RPAREN):
        mut go := true
        until go:
            if !p_at(p, tok.TK_IDENT):
                ok = false
                break
            end
            p_advance(p)
            if !p_at(p, tok.TK_COLON):
                ok = false
                break
            end
            parse_type_anno(p, a)
            go = p_match(p, tok.TK_COMMA)
        end
    end
    if ok:
        ok = p_at(p, tok.TK_RPAREN)
    end
    if ok:
        p_advance(p)
    end
    mut next_kind := tok.TK_EOF
    if ok:
        next_kind = p_peek(p).kind
    end
    is_lambda := ok && (next_kind == tok.TK_FAT_ARROW || next_kind == tok.TK_COLON)

    p.pos = save_pos
    p.panic = save_panic
    p.had_error = save_had_error
    ret is_lambda
end

// "" stands in for the C NULL (never hit: callers switch on the same kinds).
func builtin_callable_name(k: int): str:
    if k == tok.TK_KW_PRINT:
        ret "print"
    end
    if k == tok.TK_KW_PRINTLN:
        ret "println"
    end
    if k == tok.TK_KW_PRINTERR:
        ret "printerr"
    end
    if k == tok.TK_KW_PRINTERRLN:
        ret "printerrln"
    end
    if k == tok.TK_KW_INPUT:
        ret "input"
    end
    ret ""
end

func tk_is_literal_kind(k: int): bool:
    ret k == tok.TK_INT || k == tok.TK_FLOAT || k == tok.TK_STRING || k == tok.TK_TRIPLE_STRING || k == tok.TK_RAW_STRING || k == tok.TK_CHAR || k == tok.TK_UTF8_CHAR || k == tok.TK_KW_TRUE || k == tok.TK_KW_FALSE || k == tok.TK_KW_NULL
end

func parse_primary(p &: Ps, a &: at.Ast): int:
    t := p_peek(p)
    if tk_is_literal_kind(t.kind):
        n := p_mk(p, a, at.AST_LITERAL)
        at.SetOp(a, n, t.kind)
        at.SetTokenValue(a, n, t.value)
        at.SetName(a, n, t.lexeme)
        p_advance(p)
        p_fin(p, a, n)
        ret n
    end
    if t.kind == tok.TK_KW_THIS:
        n := p_mk(p, a, at.AST_THIS)
        p_advance(p)
        p_fin(p, a, n)
        ret n
    end
    if t.kind == tok.TK_KW_PRINT || t.kind == tok.TK_KW_PRINTLN || t.kind == tok.TK_KW_PRINTERR || t.kind == tok.TK_KW_PRINTERRLN || t.kind == tok.TK_KW_INPUT:
        n := p_mk(p, a, at.AST_IDENTIFIER)
        at.SetName(a, n, builtin_callable_name(t.kind))
        p_advance(p)
        p_fin(p, a, n)
        ret n
    end
    if t.kind == tok.TK_LPAREN:
        if lambda_ahead(p, a):
            ret parse_lambda(p, a)
        end
        p_advance(p)
        e := parse_expr(p, a)
        p_expect(p, tok.TK_RPAREN, "')'")
        ret e
    end
    if t.kind == tok.TK_LBRACKET:
        ret parse_array_lit(p, a)
    end
    if t.kind == tok.TK_KW_MATCH:
        ret parse_match(p, a)
    end
    if t.kind == tok.TK_AMP:
        n := p_mk(p, a, at.AST_FUNC_ADDR)
        p_advance(p)
        at.SetName(a, n, p_name(p, "expected a function name after '&'"))
        p_fin(p, a, n)
        ret n
    end
    if t.kind == tok.TK_IDENT:
        if p_peek2(p).kind == tok.TK_LBRACE && !p.no_struct_lit:
            ret parse_struct_lit(p, a)
        end
        if p_peek2(p).kind == tok.TK_DOT && p_peekn(p, 2).kind == tok.TK_IDENT && p_peekn(p, 3).kind == tok.TK_LBRACE && !p.no_struct_lit:
            ret parse_struct_lit(p, a)
        end
        n := p_mk(p, a, at.AST_IDENTIFIER)
        at.SetName(a, n, p_munch_value_name(p))
        p_fin(p, a, n)
        ret n
    end
    p_error(p, "expected an expression")
    n := p_mk(p, a, at.AST_IDENTIFIER)
    at.SetName(a, n, "<error>")
    if !p_at_eof(p):
        p_advance(p)
    end
    p_fin(p, a, n)
    ret n
end

func parse_lambda(p &: Ps, a &: at.Ast): int:
    n := p_mk(p, a, at.AST_LAMBDA)
    p_expect(p, tok.TK_LPAREN, "'(' to open lambda parameters")
    if !p_at(p, tok.TK_RPAREN):
        mut go := true
        until go:
            param := p_mk(p, a, at.AST_PARAM)
            pname := p_name(p, "expected parameter name")
            at.SetName(a, param, pname)
            if pname.len() == 0:
                break
            end
            at.SetTypeNode(a, param, parse_type_anno(p, a))
            p_fin(p, a, param)
            at.AddChild(a, n, param)
            go = p_match(p, tok.TK_COMMA)
        end
    end
    p_expect(p, tok.TK_RPAREN, "')' after lambda parameters")
    if p_at(p, tok.TK_COLON):
        ps_set_a(a, n, parse_block(p, a))
    else:
        p_expect(p, tok.TK_FAT_ARROW, "'=>' in lambda")
        e := parse_expr(p, a)
        mut blk := 0
        mut retn := 0
        if e != 0:
            blk = mk_from_node(a, at.AST_BLOCK, e)
            retn = mk_from_node(a, at.AST_RETURN, e)
        else:
            blk = p_mk(p, a, at.AST_BLOCK)
            retn = p_mk(p, a, at.AST_RETURN)
        end
        ps_set_a(a, retn, e)
        at.AddChild(a, blk, retn)
        ps_set_a(a, n, blk)
    end
    p_fin(p, a, n)
    ret n
end

func parse_array_lit(p &: Ps, a &: at.Ast): int:
    n := p_mk(p, a, at.AST_ARRAY_LIT)
    p_advance(p)

    p_skip_terminators(p)
    until !p_at(p, tok.TK_RBRACKET) && !p_at_eof(p):
        at.AddChild(a, n, parse_expr(p, a))
        p_match(p, tok.TK_COMMA)
        p_skip_terminators(p)
    end
    p_expect(p, tok.TK_RBRACKET, "']' to close array literal")
    p_fin(p, a, n)
    ret n
end

func parse_struct_lit(p &: Ps, a &: at.Ast): int:
    n := p_mk(p, a, at.AST_STRUCT_LIT)
    nm := p_peek(p).lexeme
    at.SetName(a, n, nm)
    p_advance(p)
    if p_at(p, tok.TK_DOT) && p_peek2(p).kind == tok.TK_IDENT:
        p_advance(p)
        at.SetName(a, n, nm + "." + p_peek(p).lexeme)
        p_advance(p)
    end
    p_expect(p, tok.TK_LBRACE, "'{' in struct literal")

    p_skip_terminators(p)
    until !p_at(p, tok.TK_RBRACE) && !p_at_eof(p):
        fi := p_mk(p, a, at.AST_FIELD_INIT)
        mut fname := ""
        if p_at(p, tok.TK_IDENT):
            fname = p_munch_name(p)
        else:
            fname = p_member_name(p, "expected field name in struct literal")
        end
        at.SetName(a, fi, fname)
        if fname.len() == 0:
            break
        end
        p_expect(p, tok.TK_ASSIGN, "'=' in field initializer")
        ps_set_a(a, fi, parse_expr(p, a))
        p_fin(p, a, fi)
        at.AddChild(a, n, fi)
        p_match(p, tok.TK_COMMA)
        p_skip_terminators(p)
    end
    p_expect(p, tok.TK_RBRACE, "'}' to close struct literal")
    p_fin(p, a, n)
    ret n
end

// ===== parser_stmt.c =====

func parse_cond_expr(p &: Ps, a &: at.Ast): int:
    saved := p.no_struct_lit
    p.no_struct_lit = true
    e := parse_expr(p, a)
    p.no_struct_lit = saved
    ret e
end

func fill_block_body(p &: Ps, a &: at.Ast, n: int):
    p_skip_terminators(p)
    until !p_at(p, tok.TK_KW_END) && !p_at(p, tok.TK_KW_ELSE) && !p_at_eof(p):
        p_skip_terminators(p)
        if p_at(p, tok.TK_KW_END) || p_at(p, tok.TK_KW_ELSE) || p_at_eof(p):
            break
        end
        s := parse_statement(p, a)
        if s != 0:
            at.AddChild(a, n, s)
        end
        if p.panic:
            p_sync(p)
        end
    end
end

func parse_block(p &: Ps, a &: at.Ast): int:
    p_rule(p, "block")
    if !p_recurse_enter(p, "block nested too deeply"):
        ret p_mk(p, a, at.AST_BLOCK)
    end
    n := p_mk(p, a, at.AST_BLOCK)
    p_expect(p, tok.TK_COLON, "':' to open block")
    fill_block_body(p, a, n)
    p_expect(p, tok.TK_KW_END, "'end' to close block")
    p_fin(p, a, n)
    p_recurse_leave(p)
    ret n
end

func parse_statement(p &: Ps, a &: at.Ast): int:
    p_rule(p, "statement")
    k := p_peek(p).kind
    if k == tok.TK_KW_PRINT || k == tok.TK_KW_PRINTLN || k == tok.TK_KW_PRINTERR || k == tok.TK_KW_PRINTERRLN:
        ret parse_print_stmt(p, a)
    end
    if k == tok.TK_KW_MUT:
        n := parse_var_decl(p, a)
        p_term(p)
        ret n
    end
    if k == tok.TK_KW_CONST:
        ret parse_const(p, a)
    end
    if k == tok.TK_KW_IF:
        ret parse_if(p, a)
    end
    if k == tok.TK_KW_UNTIL:
        ret parse_until(p, a)
    end
    if k == tok.TK_KW_EACH:
        ret parse_each(p, a)
    end
    if k == tok.TK_KW_REPEAT:
        ret parse_repeat(p, a)
    end
    if k == tok.TK_KW_MATCH:
        ret parse_match(p, a)
    end
    if k == tok.TK_KW_RET:
        ret parse_return(p, a)
    end
    if k == tok.TK_KW_DEFER:
        ret parse_defer(p, a)
    end
    if k == tok.TK_KW_BREAK:
        n := p_mk(p, a, at.AST_BREAK)
        p_advance(p)
        p_fin(p, a, n)
        p_term(p)
        ret n
    end
    if k == tok.TK_KW_CONTINUE:
        n := p_mk(p, a, at.AST_CONTINUE)
        p_advance(p)
        p_fin(p, a, n)
        p_term(p)
        ret n
    end
    if k == tok.TK_IDENT:
        m := p_ident_run_len(p)
        after := p_peekn(p, m).kind
        if after == tok.TK_COLON || after == tok.TK_COLON_ASSIGN:
            n := parse_bare_var_decl(p, a)
            p_term(p)
            ret n
        end
        // SALAM_FALLTHROUGH to the expression-statement default.
    end
    e := parse_expr(p, a)
    mut stmt := 0
    if e != 0 && at.KindOf(a, e) == at.AST_ASSIGN:
        stmt = e
    else:
        if e != 0:
            stmt = mk_from_node(a, at.AST_EXPR_STMT, e)
        else:
            stmt = p_mk(p, a, at.AST_EXPR_STMT)
        end
        ps_set_a(a, stmt, e)
    end
    p_term(p)
    ret stmt
end

func print_args_fully_parenthesized(p &: Ps): bool:
    if !p_at(p, tok.TK_LPAREN):
        ret false
    end
    mut depth := 0
    mut idx := 0
    until true:
        k := p_peekn(p, idx).kind
        if k == tok.TK_EOF:
            ret false
        end
        if k == tok.TK_LPAREN:
            depth += 1
        else k == tok.TK_RPAREN:
            depth -= 1
            if depth == 0:
                break
            end
        end
        idx += 1
    end
    after := p_peekn(p, idx + 1).kind
    ret after == tok.TK_STMT_END || after == tok.TK_KW_END || after == tok.TK_RBRACE || after == tok.TK_EOF
end

func parse_print_stmt(p &: Ps, a &: at.Ast): int:
    k := p_peek(p).kind
    call := p_mk(p, a, at.AST_CALL)
    callee := p_mk(p, a, at.AST_IDENTIFIER)
    at.SetName(a, callee, builtin_callable_name(k))
    ps_set_a(a, call, callee)
    p_advance(p)
    p_fin(p, a, callee)
    if print_args_fully_parenthesized(p):
        p_error(p, "print arguments must not be wrapped in parentheses; remove them")
    end
    if !p_at(p, tok.TK_STMT_END) && !p_at(p, tok.TK_KW_END) && !p_at(p, tok.TK_RBRACE) && !p_at_eof(p):
        mut go := true
        until go:
            at.AddChild(a, call, parse_expr(p, a))
            go = p_match(p, tok.TK_COMMA)
        end
    end
    p_fin(p, a, call)
    stmt := mk_from_node(a, at.AST_EXPR_STMT, call)
    ps_set_a(a, stmt, call)
    p_term(p)
    ret stmt
end

func parse_return(p &: Ps, a &: at.Ast): int:
    p_rule(p, "return_stmt")
    n := p_mk(p, a, at.AST_RETURN)
    p_advance(p)
    if !p_at(p, tok.TK_STMT_END) && !p_at(p, tok.TK_KW_END) && !p_at(p, tok.TK_KW_ELSE) && !p_at_eof(p):
        ps_set_a(a, n, parse_expr(p, a))
    end
    p_fin(p, a, n)
    p_term(p)
    ret n
end

func parse_defer(p &: Ps, a &: at.Ast): int:
    p_rule(p, "defer_stmt")
    if !p_recurse_enter(p, "statement nested too deeply"):
        ret p_mk(p, a, at.AST_DEFER)
    end
    n := p_mk(p, a, at.AST_DEFER)
    p_advance(p)
    ps_set_a(a, n, parse_statement(p, a))
    p_fin(p, a, n)
    p_recurse_leave(p)
    ret n
end

func parse_if_tail(p &: Ps, a &: at.Ast): int:
    if !p_recurse_enter(p, "if/else chain nested too deeply"):
        ret p_mk(p, a, at.AST_IF)
    end
    n := p_mk(p, a, at.AST_IF)
    ps_set_a(a, n, parse_cond_expr(p, a))
    b := p_mk(p, a, at.AST_BLOCK)
    ps_set_b(a, n, b)
    p_expect(p, tok.TK_COLON, "':' after if condition")
    fill_block_body(p, a, b)
    p_fin(p, a, b)
    p_skip_terminators(p)
    if p_match(p, tok.TK_KW_ELSE):
        p_match(p, tok.TK_KW_IF)
        if !p_at(p, tok.TK_COLON):
            ps_set_c(a, n, parse_if_tail(p, a))
        else:
            c := p_mk(p, a, at.AST_BLOCK)
            ps_set_c(a, n, c)
            p_expect(p, tok.TK_COLON, "':' after else")
            fill_block_body(p, a, c)
            p_expect(p, tok.TK_KW_END, "'end' to close if")
            p_fin(p, a, c)
        end
    else:
        p_expect(p, tok.TK_KW_END, "'end' to close if")
    end
    p_fin(p, a, n)
    p_recurse_leave(p)
    ret n
end

func parse_if(p &: Ps, a &: at.Ast): int:
    p_rule(p, "if_stmt")
    p_advance(p)
    ret parse_if_tail(p, a)
end

func tk_is_pattern_literal(k: int): bool:
    ret k == tok.TK_INT || k == tok.TK_FLOAT || k == tok.TK_STRING || k == tok.TK_TRIPLE_STRING || k == tok.TK_RAW_STRING || k == tok.TK_CHAR || k == tok.TK_UTF8_CHAR || k == tok.TK_KW_TRUE || k == tok.TK_KW_FALSE || k == tok.TK_KW_NULL
end

func parse_match_pattern(p &: Ps, a &: at.Ast): int:
    pat := p_mk(p, a, at.AST_MATCH_PATTERN)
    if tk_is_pattern_literal(p_peek(p).kind):
        t := p_peek(p)
        lit := p_mk(p, a, at.AST_LITERAL)
        at.SetOp(a, lit, t.kind)
        at.SetTokenValue(a, lit, t.value)
        at.SetName(a, lit, t.lexeme)
        p_advance(p)
        p_fin(p, a, lit)
        ps_set_a(a, pat, lit)
    else p_at(p, tok.TK_IDENT):
        line := p_peek(p).begin_line
        idn := p_mk(p, a, at.AST_IDENTIFIER)
        at.SetName(a, idn, p_peek(p).lexeme)
        p_advance(p)
        p_fin(p, a, idn)
        ps_set_a(a, pat, idn)
        if p_at(p, tok.TK_IDENT) && p_peek(p).begin_line == line:
            at.SetName(a, pat, p_peek(p).lexeme)
            p_advance(p)
        end
    else:
        p_error(p, "expected a pattern (literal, identifier, or type name) in match arm")
        ps_set_a(a, pat, p_error_node(p, a))
    end
    p_fin(p, a, pat)
    ret pat
end

func parse_match_arm(p &: Ps, a &: at.Ast): int:
    if !p_recurse_enter(p, "match arm nested too deeply"):
        ret p_mk(p, a, at.AST_MATCH_ARM)
    end
    arm := p_mk(p, a, at.AST_MATCH_ARM)
    if p_match(p, tok.TK_KW_ELSE):
        at.SetOp(a, arm, tok.TK_KW_ELSE)
    else:
        mut go := true
        until go:
            at.AddChild(a, arm, parse_match_pattern(p, a))
            go = p_match(p, tok.TK_COMMA)
        end
    end
    is_block := p_at(p, tok.TK_COLON)
    if is_block:
        ps_set_b(a, arm, parse_block(p, a))
    else:
        p_expect(p, tok.TK_FAT_ARROW, "'=>' in match arm")
        e := parse_expr(p, a)
        mut blk := 0
        mut es := 0
        if e != 0:
            blk = mk_from_node(a, at.AST_BLOCK, e)
            es = mk_from_node(a, at.AST_EXPR_STMT, e)
        else:
            blk = p_mk(p, a, at.AST_BLOCK)
            es = p_mk(p, a, at.AST_EXPR_STMT)
        end
        ps_set_a(a, es, e)
        at.AddChild(a, blk, es)
        ps_set_b(a, arm, blk)
    end
    p_fin(p, a, arm)
    if !is_block:
        p_term(p)
    end
    p_recurse_leave(p)
    ret arm
end

func parse_match(p &: Ps, a &: at.Ast): int:
    p_rule(p, "match_expr")
    if !p_recurse_enter(p, "match nested too deeply"):
        ret p_mk(p, a, at.AST_MATCH)
    end
    n := p_mk(p, a, at.AST_MATCH)
    p_advance(p)
    ps_set_a(a, n, parse_cond_expr(p, a))
    p_expect(p, tok.TK_COLON, "':' after match subject")
    p_skip_terminators(p)
    until !p_at(p, tok.TK_KW_END) && !p_at_eof(p):
        at.AddChild(a, n, parse_match_arm(p, a))
        p_skip_terminators(p)
        if p.panic:
            p_sync(p)
        end
    end
    p_expect(p, tok.TK_KW_END, "'end' to close match")
    p_fin(p, a, n)
    p_recurse_leave(p)
    ret n
end

func parse_until(p &: Ps, a &: at.Ast): int:
    p_rule(p, "until_stmt")
    n := p_mk(p, a, at.AST_UNTIL)
    p_advance(p)
    ps_set_a(a, n, parse_cond_expr(p, a))
    ps_set_b(a, n, parse_block(p, a))
    p_fin(p, a, n)
    ret n
end

/* Loop bounds stop before 'with' so the index binding stays visible: without
 * this a member access would swallow it ('repeat box.count with i' parsing as
 * the field 'count with i'). */
func parse_repeat_bound(p &: Ps, a &: at.Ast): int:
    saved := p.no_with_word
    p.no_with_word = true
    e := parse_cond_expr(p, a)
    p.no_with_word = saved
    ret e
end

func parse_repeat(p &: Ps, a &: at.Ast): int:
    p_rule(p, "repeat_stmt")
    n := p_mk(p, a, at.AST_REPEAT)
    p_advance(p)
    ps_set_a(a, n, parse_repeat_bound(p, a))
    if p_at(p, tok.TK_KW_TO):
        p_advance(p)
        ps_set_c(a, n, parse_repeat_bound(p, a))
    end
    if p_at(p, tok.TK_KW_STEP):
        p_advance(p)
        if at.Get(a, n).c == 0:
            p_error(p, "'by' in a repeat loop needs a 'to' bound before it")
        end
        ps_set_d(a, n, parse_repeat_bound(p, a))
    end
    if p_match(p, tok.TK_KW_WITH):
        at.SetName(a, n, p_name(p, "expected an index variable name after 'with'"))
    end
    ps_set_b(a, n, parse_block(p, a))
    p_fin(p, a, n)
    ret n
end

func parse_each(p &: Ps, a &: at.Ast): int:
    p_rule(p, "each_stmt")
    n := p_mk(p, a, at.AST_EACH)
    p_advance(p)
    if p_match(p, tok.TK_LPAREN):
        kn := p_mk(p, a, at.AST_IDENTIFIER)
        at.SetName(a, kn, p_name(p, "expected a binding name in 'each (key, value)'"))
        p_fin(p, a, kn)
        ps_set_c(a, n, kn)
        p_expect(p, tok.TK_COMMA, "',' between the two 'each' binding names")
        at.SetName(a, n, p_name(p, "expected the value binding name in 'each (key, value)'"))
        p_expect(p, tok.TK_RPAREN, "')' after the 'each' binding names")
    else:
        at.SetName(a, n, p_name(p, "expected a binding name after 'each'"))
    end
    p_expect(p, tok.TK_KW_IN, "'in' before the collection in an 'each' loop")
    ps_set_a(a, n, parse_cond_expr(p, a))
    ps_set_b(a, n, parse_block(p, a))
    p_fin(p, a, n)
    ret n
end

// ===== parser_type.c =====

func parse_array_dims(p &: Ps, a &: at.Ast, n: int):
    until p_match(p, tok.TK_LBRACKET):
        p_skip_terminators(p)

        if p_at(p, tok.TK_COLON):
            p_advance(p)
            p_skip_terminators(p)
            p_expect(p, tok.TK_RBRACKET, "']' to close slice type 'T[:]'")
            mut nn := at.Get(a, n)
            nn.is_slice = true
            at.Put(a, n, nn)
            ret
        end
        mut dim := 0
        if !p_at(p, tok.TK_RBRACKET):
            dim = parse_expr(p, a)
        end
        p_skip_terminators(p)
        p_expect(p, tok.TK_RBRACKET, "']' in array type")
        at.AddDim(a, n, dim)
    end
end

func parse_ptr_suffix(p &: Ps, a &: at.Ast, n: int):
    if p_match(p, tok.TK_STAR):
        mut nn := at.Get(a, n)
        nn.is_pointer = true
        at.Put(a, n, nn)
    end
end

func parse_type_dyn(p &: Ps, a &: at.Ast, n: int): int:
    p_advance(p)
    mut nn := at.Get(a, n)
    nn.is_dyn = true
    nn.name = p_peek(p).lexeme
    at.Put(a, n, nn)
    p_advance(p)
    parse_array_dims(p, a, n)
    parse_ptr_suffix(p, a, n)
    p_fin(p, a, n)
    ret n
end

func parse_type_func(p &: Ps, a &: at.Ast, n: int): int:
    at.SetName(a, n, "func")
    p_advance(p)
    p_expect(p, tok.TK_LPAREN, "'(' in function type")
    // p_comma_list(p, n, TK_RPAREN, parse_type) inlined:
    if !p_at(p, tok.TK_RPAREN):
        mut go := true
        until go:
            at.AddChild(a, n, parse_type(p, a))
            go = p_match(p, tok.TK_COMMA)
        end
    end
    p_expect(p, tok.TK_RPAREN, "')' in function type")
    if p_at(p, tok.TK_IDENT) || p_at(p, tok.TK_KW_FUNC):
        at.SetTypeNode(a, n, parse_type(p, a))
    end
    parse_ptr_suffix(p, a, n)
    p_fin(p, a, n)
    ret n
end

func parse_type_named(p &: Ps, a &: at.Ast, n: int): int:
    nm := p_name(p, "expected type name")
    at.SetName(a, n, nm)
    if nm.len() == 0:
        ret n
    end

    if p_at(p, tok.TK_DOT) && p_peek2(p).kind == tok.TK_IDENT:
        p_advance(p)
        at.SetName(a, n, nm + "." + p_peek(p).lexeme)
        p_advance(p)
    end

    if p_at(p, tok.TK_LT):
        p_advance(p)
        at.AddChild(a, n, parse_type(p, a))
        until p_match(p, tok.TK_COMMA):
            at.AddChild(a, n, parse_type(p, a))
        end
        p_close_angle(p, "'>' to close type arguments")
    end
    parse_array_dims(p, a, n)
    parse_ptr_suffix(p, a, n)
    p_fin(p, a, n)
    ret n
end

func parse_type(p &: Ps, a &: at.Ast): int:
    p_rule(p, "type")

    if !p_recurse_enter(p, "type nested too deeply"):
        ret p_mk(p, a, at.AST_TYPE)
    end
    mut n := p_mk(p, a, at.AST_TYPE)
    if p_at(p, tok.TK_KW_EXTERN) && p_peek2(p).kind == tok.TK_KW_FUNC:
        p_advance(p)
        n = parse_type_func(p, a, n)
        mut nn := at.Get(a, n)
        nn.is_extern = true
        at.Put(a, n, nn)
    else p_at(p, tok.TK_IDENT) && str.Equals(p_peek(p).lexeme, "dyn") && p_peek2(p).kind == tok.TK_IDENT:
        n = parse_type_dyn(p, a, n)
    else p_at(p, tok.TK_KW_FUNC):
        n = parse_type_func(p, a, n)
    else:
        n = parse_type_named(p, a, n)
    end
    p_recurse_leave(p)
    ret n
end

func parse_type_anno(p &: Ps, a &: at.Ast): int:
    p_expect(p, tok.TK_COLON, "':' before type")
    ret parse_type(p, a)
end

// ===== parser_decl_var.c =====

func demote_auto_type(a &: at.Ast, id: int):
    n := at.Get(a, id)
    if n.ty == 0:
        ret
    end
    t := at.Get(a, n.ty)
    if t.name.len() == 0 || t.is_pointer || t.is_dyn:
        ret
    end
    if t.list.len() != 0 || t.dims.len() != 0:
        ret
    end
    if str.Equals(t.name, "auto") || str.Equals(t.name, "\xD8\xAE\xD9\x88\xD8\xAF\xDA\xA9\xD8\xA7\xD8\xB1") || str.Equals(t.name, "\xD8\xAA\xD9\x84\xD9\x82\xD8\xA7\xD8\xA6\xD9\x8A"):
        at.SetTypeNode(a, id, 0)
    end
end

func parse_decl_tail(p &: Ps, a &: at.Ast, n: int):
    if p_match(p, tok.TK_COLON_ASSIGN):
        ps_set_a(a, n, parse_expr(p, a))
        ret
    end
    if p_at(p, tok.TK_COLON):
        at.SetTypeNode(a, n, parse_type_anno(p, a))
        demote_auto_type(a, n)
        if p_at(p, tok.TK_ASSIGN):
            p_error(p, "declarations with a type annotation were removed; use 'name := value' (or 'name := value as Type')")
            p_advance(p)
            ps_set_a(a, n, parse_expr(p, a))
        end
        ret
    end
    if p_at(p, tok.TK_ASSIGN):
        p_error(p, "use ':=' to declare a new variable ('name := value'); '=' only assigns to an existing one")
        p_advance(p)
        ps_set_a(a, n, parse_expr(p, a))
        ret
    end
    p_error(p, "expected ':=' and an initializer, or ': Type' for an uninitialized declaration")
end

func parse_var_decl(p &: Ps, a &: at.Ast): int:
    p_rule(p, "var_decl")
    n := p_mk(p, a, at.AST_VAR_DECL)
    is_mut := p_match(p, tok.TK_KW_MUT)
    nm := parse_decl_name(p)
    mut nn := at.Get(a, n)
    nn.is_mut = is_mut
    nn.name = nm
    if nm.len() == 0:
        nn.name = "<error>"
    end
    at.Put(a, n, nn)
    parse_decl_tail(p, a, n)
    p_fin(p, a, n)
    ret n
end

func parse_bare_var_decl(p &: Ps, a &: at.Ast): int:
    p_rule(p, "bare_var_decl")
    n := p_mk(p, a, at.AST_VAR_DECL)
    nm := parse_decl_name(p)
    mut nn := at.Get(a, n)
    nn.is_mut = false
    nn.name = nm
    if nm.len() == 0:
        nn.name = "<error>"
    end
    at.Put(a, n, nn)
    parse_decl_tail(p, a, n)
    p_fin(p, a, n)
    ret n
end

// ===== parser_decl.c =====

func parse_type_alias(p &: Ps, a &: at.Ast): int:
    p_rule(p, "type_alias")
    n := p_mk(p, a, at.AST_TYPE_ALIAS)
    p_advance(p)
    at.SetName(a, n, p_name(p, "expected alias name"))
    p_expect(p, tok.TK_ASSIGN, "'=' in type alias")
    at.SetTypeNode(a, n, parse_type(p, a))
    p_term(p)
    p_fin(p, a, n)
    ret n
end

func parse_const(p &: Ps, a &: at.Ast): int:
    p_rule(p, "const_decl")
    n := p_mk(p, a, at.AST_CONST_DECL)
    p_advance(p)
    at.SetName(a, n, p_name(p, "expected constant name"))
    if p_at(p, tok.TK_COLON):
        p_error(p, "constants with a type annotation were removed; use 'const NAME := value' (or 'const NAME := value as Type')")
        at.SetTypeNode(a, n, parse_type_anno(p, a))
        p_match(p, tok.TK_ASSIGN)
        ps_set_a(a, n, parse_expr(p, a))
        p_term(p)
        p_fin(p, a, n)
        ret n
    end
    if p_at(p, tok.TK_ASSIGN):
        p_error(p, "constants are declared with ':=' ('const NAME := value')")
        p_advance(p)
    else:
        p_expect(p, tok.TK_COLON_ASSIGN, "':=' in const declaration")
    end
    ps_set_a(a, n, parse_expr(p, a))
    p_term(p)
    p_fin(p, a, n)
    ret n
end

func parse_enum(p &: Ps, a &: at.Ast): int:
    p_rule(p, "enum_def")
    n := p_mk(p, a, at.AST_ENUM_DEF)
    p_advance(p)
    at.SetName(a, n, p_name(p, "expected enum name"))
    p_expect(p, tok.TK_COLON, "':' after enum name")
    p_skip_terminators(p)
    until !p_at(p, tok.TK_KW_END) && !p_at_eof(p):
        before := p.pos
        p_skip_terminators(p)
        if p_at(p, tok.TK_KW_END) || p_at_eof(p):
            break
        end
        m := p_mk(p, a, at.AST_ENUM_MEMBER)
        at.SetName(a, m, p_name(p, "expected enum member name"))
        if p_match(p, tok.TK_ASSIGN):
            ps_set_a(a, m, parse_expr(p, a))
        end
        p_fin(p, a, m)
        at.AddChild(a, n, m)

        if !p_match(p, tok.TK_COMMA):
            p_skip_terminators(p)
        end
        if p.panic:
            p_sync(p)
        end

        if p.pos == before && !p_at(p, tok.TK_KW_END) && !p_at_eof(p):
            p_advance(p)
        end
    end
    p_expect(p, tok.TK_KW_END, "'end' to close enum")
    p_fin(p, a, n)
    ret n
end

func parse_typarams(p &: Ps, a &: at.Ast, n: int):
    if !p_match(p, tok.TK_LT):
        ret
    end
    mut go := true
    until go:
        tp := p_name(p, "expected type parameter name")
        if tp.len() == 0:
            break
        end
        mut bound := ""
        if p_match(p, tok.TK_COLON):
            bound = p_name(p, "expected an interface name after ':' in type parameter bound")
        end
        at.AddTyparam(a, n, tp, bound)
        go = p_match(p, tok.TK_COMMA)
    end
    p_close_angle(p, "'>' to close type parameters")
end

func parse_interface_method(p &: Ps, a &: at.Ast): int:
    n := p_mk(p, a, at.AST_FUNC_DEF)
    p_advance(p)
    at.SetName(a, n, p_name(p, "expected method name in interface"))
    if p_match(p, tok.TK_LPAREN):
        parse_params(p, a, n)
        p_expect(p, tok.TK_RPAREN, "')' after parameters")
    end
    finish_untyped_params(p, a, n, false)
    if p_at(p, tok.TK_COLON):
        p_advance(p)
        at.SetTypeNode(a, n, parse_type(p, a))
    end
    p_term(p)
    p_fin(p, a, n)
    ret n
end

func parse_interface(p &: Ps, a &: at.Ast): int:
    p_rule(p, "interface_def")
    n := p_mk(p, a, at.AST_INTERFACE_DEF)
    p_advance(p)
    at.SetName(a, n, p_name(p, "expected interface name"))
    parse_typarams(p, a, n)
    p_expect(p, tok.TK_COLON, "':' after interface name")
    p_skip_terminators(p)
    until !p_at(p, tok.TK_KW_END) && !p_at_eof(p):
        p_skip_terminators(p)
        if p_at(p, tok.TK_KW_END) || p_at_eof(p):
            break
        end
        if p_at(p, tok.TK_KW_FUNC):
            m := parse_interface_method(p, a)
            if m != 0:
                at.AddChild(a, n, m)
            end
        else:
            p_error(p, "expected a method signature ('func ...') in interface")
            if !p_at_eof(p):
                p_advance(p)
            end
        end
        if p.panic:
            p_sync(p)
        end
    end
    p_expect(p, tok.TK_KW_END, "'end' to close interface")
    p_fin(p, a, n)
    ret n
end

func parse_impl(p &: Ps, a &: at.Ast): int:
    p_rule(p, "impl_def")
    n := p_mk(p, a, at.AST_IMPL_DEF)
    p_advance(p)
    at.SetName(a, n, p_name(p, "expected interface name after 'impl'"))
    p_expect(p, tok.TK_KW_ON, "'on' after interface name in impl block")
    at.SetTypeNode(a, n, parse_type(p, a))
    p_expect(p, tok.TK_COLON, "':' after impl target type")
    p_skip_terminators(p)
    until !p_at(p, tok.TK_KW_END) && !p_at_eof(p):
        p_skip_terminators(p)
        if p_at(p, tok.TK_KW_END) || p_at_eof(p):
            break
        end
        if p_at(p, tok.TK_KW_FUNC):
            m := parse_function(p, a, false)
            if m != 0:
                at.AddChild(a, n, m)
            end
        else:
            p_error(p, "expected a method ('func ...') in impl block")
            if !p_at_eof(p):
                p_advance(p)
            end
        end
        if p.panic:
            p_sync(p)
        end
    end
    p_expect(p, tok.TK_KW_END, "'end' to close impl block")
    p_fin(p, a, n)
    ret n
end

func parse_struct(p &: Ps, a &: at.Ast): int:
    p_rule(p, "struct_def")
    n := p_mk(p, a, at.AST_STRUCT_DEF)
    p_advance(p)
    at.SetName(a, n, p_name(p, "expected struct name"))
    parse_typarams(p, a, n)
    p_expect(p, tok.TK_COLON, "':' after struct name")
    p_skip_terminators(p)
    mut mpend := Vector {} as Vector<str>
    defer mpend.free()
    until !p_at(p, tok.TK_KW_END) && !p_at_eof(p):
        before := p.pos
        p_skip_terminators(p)
        parse_metas(p, mpend)
        if p_at(p, tok.TK_KW_END) || p_at_eof(p):
            break
        end
        mut m_pub := false
        if p_at(p, tok.TK_KW_PUB):
            m_pub = true
            p_advance(p)
        end
        mut member := 0
        if p_at(p, tok.TK_KW_FUNC):
            member = parse_function(p, a, false)
        else:
            member = parse_field(p, a)
        end
        if member != 0:
            mut mn := at.Get(a, member)
            mn.is_pub = m_pub
            at.Put(a, member, mn)
            repeat mpend.len() with i:
                at.AddAlias(a, member, mpend.get(i)[0])
            end
            at.AddChild(a, n, member)
        end
        mpend.clear()
        if p.panic:
            p_sync(p)
        end

        if p.pos == before && !p_at(p, tok.TK_KW_END) && !p_at_eof(p):
            p_advance(p)
        end
    end
    p_expect(p, tok.TK_KW_END, "'end' to close struct")
    p_fin(p, a, n)
    ret n
end

func parse_field(p &: Ps, a &: at.Ast): int:
    p_rule(p, "field")
    n := p_mk(p, a, at.AST_FIELD)

    mut nm := ""
    if p_at(p, tok.TK_IDENT):
        nm = parse_decl_name(p)
    else:
        nm = p_member_name(p, "expected field name")
    end
    at.SetName(a, n, nm)
    if nm.len() == 0:
        ret 0
    end
    at.SetTypeNode(a, n, parse_type_anno(p, a))
    if p_match(p, tok.TK_ASSIGN):
        ps_set_a(a, n, parse_expr(p, a))
    end
    p_term(p)
    p_fin(p, a, n)
    ret n
end

func parse_op_method_name(p &: Ps): str:
    k := p_peek(p).kind
    if k == tok.TK_PLUS:
        p_advance(p)
        ret "operator_add"
    end
    if k == tok.TK_MINUS:
        p_advance(p)
        ret "operator_sub"
    end
    if k == tok.TK_STAR:
        p_advance(p)
        ret "operator_mul"
    end
    if k == tok.TK_SLASH:
        p_advance(p)
        ret "operator_div"
    end
    if k == tok.TK_PERCENT:
        p_advance(p)
        ret "operator_mod"
    end
    if k == tok.TK_POWER:
        p_advance(p)
        ret "operator_pow"
    end
    if k == tok.TK_EQ:
        p_advance(p)
        ret "operator_eq"
    end
    if k == tok.TK_NE:
        p_advance(p)
        ret "operator_ne"
    end
    if k == tok.TK_LT:
        p_advance(p)
        ret "operator_lt"
    end
    if k == tok.TK_GT:
        p_advance(p)
        ret "operator_gt"
    end
    if k == tok.TK_LE:
        p_advance(p)
        ret "operator_le"
    end
    if k == tok.TK_GE:
        p_advance(p)
        ret "operator_ge"
    end
    if k == tok.TK_NOT:
        p_advance(p)
        ret "operator_not"
    end
    if k == tok.TK_LBRACKET:
        p_advance(p)
        p_expect(p, tok.TK_RBRACKET, "']' in operator[]")
        if p_at(p, tok.TK_ASSIGN):
            p_advance(p)
            ret "operator_index_set"
        end
        ret "operator_index"
    end
    p_error(p, "unsupported operator for overloading; allowed: + - * / % ** == != < > <= >= ! []")
    ret "operator_error"
end

func parse_function(p &: Ps, a &: at.Ast, allow_untyped: bool): int:
    p_rule(p, "function_def")
    n := p_mk(p, a, at.AST_FUNC_DEF)
    p_advance(p)
    if p_at(p, tok.TK_KW_OPERATOR):
        p_advance(p)
        at.SetName(a, n, parse_op_method_name(p))
    else p_at(p, tok.TK_IDENT):
        m := p_ident_run_len(p)
        after := p_peekn(p, m).kind
        if m >= 2 && after != tok.TK_LPAREN && after != tok.TK_LT:
            mut b := ""
            repeat m - 1 with i:
                if i != 0:
                    b = b + " "
                end
                b = b + p_peek(p).lexeme
                p_advance(p)
            end
            at.SetName(a, n, b)
        else:
            at.SetName(a, n, p_munch_name(p))
        end
    else:
        at.SetName(a, n, p_name(p, "expected function name or 'operator <op>'"))
    end
    parse_typarams(p, a, n)
    if p_match(p, tok.TK_LPAREN):
        parse_params(p, a, n)
        p_expect(p, tok.TK_RPAREN, "')' after parameters")
    end
    finish_untyped_params(p, a, n, allow_untyped)
    mut rt := 0
    if p_try_return_type(p, a, rt):
        at.SetTypeNode(a, n, rt)
    end
    ps_set_a(a, n, parse_block(p, a))
    p_fin(p, a, n)
    ret n
end

func parse_params(p &: Ps, a &: at.Ast, fn: int):
    if p_at(p, tok.TK_RPAREN):
        ret
    end
    mut go := true
    until go:
        param := p_mk(p, a, at.AST_PARAM)
        pname := parse_decl_name(p)
        at.SetName(a, param, pname)
        if pname.len() == 0:
            ret
        end
        if p_match(p, tok.TK_AMP):
            mut pn := at.Get(a, param)
            pn.is_ref = true
            at.Put(a, param, pn)
        end
        if p_at(p, tok.TK_COLON):
            at.SetTypeNode(a, param, parse_type_anno(p, a))
        end
        if p_match(p, tok.TK_ASSIGN):
            ps_set_a(a, param, parse_expr(p, a))
        end
        p_fin(p, a, param)
        at.AddChild(a, fn, param)
        go = p_match(p, tok.TK_COMMA)
    end
end

func finish_untyped_params(p &: Ps, a &: at.Ast, fn: int, allow_untyped: bool):
    mut next_ix := 0
    count := at.ChildCount(a, fn)
    repeat count with i:
        pid := at.Child(a, fn, i)
        pnode := at.Get(a, pid)
        if pnode.kind != at.AST_PARAM || pnode.ty != 0:
            continue
        end
        if !allow_untyped:
            p_error(p, "method and interface parameters must have explicit types")
            ret
        end
        tn := "__T" + next_ix
        next_ix += 1
        t := at.NewNode(a, at.AST_TYPE)
        at.SetSpan(
            a, t, pnode.begin_line, pnode.begin_col, pnode.begin_index, pnode.end_line, pnode.end_col,
            pnode.end_index, pnode.length
        )
        at.SetName(a, t, tn)
        at.SetTypeNode(a, pid, t)
        at.AddTyparam(a, fn, tn, "")
    end
end

func parse_top_level(p &: Ps, a &: at.Ast): int:
    p_rule(p, "top_level")

    mut is_pub := false
    if p_at(p, tok.TK_KW_PUB):
        is_pub = true
        p_advance(p)
    end
    mut is_deprecated := false
    if p_at(p, tok.TK_KW_DEPRECATED):
        is_deprecated = true
        p_advance(p)
    end
    mut is_inline := false
    mut is_noinline := false
    if p_at(p, tok.TK_KW_INLINE):
        is_inline = true
        p_advance(p)
    else p_at(p, tok.TK_KW_NOINLINE):
        is_noinline = true
        p_advance(p)
    end
    mut is_pure := false
    mut is_noret := false
    if p_at(p, tok.TK_KW_PURE):
        is_pure = true
        p_advance(p)
    else p_at(p, tok.TK_KW_NORET):
        is_noret = true
        p_advance(p)
    end
    mut any_mod := is_deprecated || is_inline || is_noinline || is_pure || is_noret
    if p_at(p, tok.TK_KW_PUB) || p_at(p, tok.TK_KW_DEPRECATED) || p_at(p, tok.TK_KW_INLINE) || p_at(p, tok.TK_KW_NOINLINE) || p_at(p, tok.TK_KW_PURE) || p_at(p, tok.TK_KW_NORET):
        p_error(p, "function modifiers must appear in this order: 'pub deprecated inline|noinline pure|noret func'")
        until p_at(p, tok.TK_KW_PUB) || p_at(p, tok.TK_KW_DEPRECATED) || p_at(p, tok.TK_KW_INLINE) || p_at(p, tok.TK_KW_NOINLINE) || p_at(p, tok.TK_KW_PURE) || p_at(p, tok.TK_KW_NORET):
            mk := p_peek(p).kind
            if mk == tok.TK_KW_PUB:
                is_pub = true
            else mk == tok.TK_KW_DEPRECATED:
                is_deprecated = true
            else mk == tok.TK_KW_INLINE:
                is_inline = true
            else mk == tok.TK_KW_NOINLINE:
                is_noinline = true
            else mk == tok.TK_KW_PURE:
                is_pure = true
            else:
                is_noret = true
            end
            p_advance(p)
        end
        any_mod = true
    end
    if any_mod && !p_at(p, tok.TK_KW_FUNC):
        p_error(p, "function modifiers ('deprecated', 'inline', 'noinline', 'pure', 'noret') are only allowed on a function definition")
    end
    mut n := 0
    k := p_peek(p).kind
    if k == tok.TK_KW_TYPE:
        n = parse_type_alias(p, a)
    else k == tok.TK_KW_CONST:
        n = parse_const(p, a)
    else k == tok.TK_KW_ENUM:
        n = parse_enum(p, a)
    else k == tok.TK_KW_STRUCT:
        n = parse_struct(p, a)
    else k == tok.TK_KW_INTERFACE:
        n = parse_interface(p, a)
    else k == tok.TK_KW_IMPL:
        n = parse_impl(p, a)
    else k == tok.TK_KW_FUNC:
        n = parse_function(p, a, true)
    else k == tok.TK_KW_LAYOUT:
        if is_pub:
            p_error(p, "'pub' cannot be applied to a layout block")
        end
        ret parse_layout_block(p, a)
    else k == tok.TK_KW_COMPONENT:
        if is_pub:
            p_error(p, "'pub' cannot be applied to a component")
        end
        ret parse_component(p, a)
    else k == tok.TK_KW_MUT:
        n = parse_var_decl(p, a)
        p_term(p)
    else k == tok.TK_IDENT:
        n = parse_bare_var_decl(p, a)
        p_term(p)
    else k == tok.TK_KW_PACKAGE:
        p_error(p, "'package' can be declared only once, and only as the very first statement in the file")
        if !p_at_eof(p):
            p_advance(p)
        end
        ret 0
    else:
        if is_pub:
            p_error(p, "expected a definition after 'pub'")
        else:
            p_error(p, "expected a top-level definition")
        end
        if !p_at_eof(p):
            p_advance(p)
        end
        ret 0
    end
    if n != 0:
        mut nn := at.Get(a, n)
        nn.is_pub = is_pub
        if nn.kind == at.AST_FUNC_DEF:
            nn.is_inline = is_inline
            nn.is_noinline = is_noinline
            nn.is_pure = is_pure
            nn.is_noret = is_noret
            nn.is_deprecated = is_deprecated
        end
        at.Put(a, n, nn)
    end
    ret n
end

// ===== parser_ffi.c =====

// "" stands in for the C NULL return.
func canon_link_kind(s: str): str:
    if str.Equals(s, "static"):
        ret "static"
    end
    if str.Equals(s, "dynamic"):
        ret "dynamic"
    end
    if str.Equals(s, "framework"):
        ret "framework"
    end
    if str.Equals(s, "ایستا"):
        ret "static"
    end
    if str.Equals(s, "پویا"):
        ret "dynamic"
    end
    if str.Equals(s, "چارچوب"):
        ret "framework"
    end
    ret ""
end

func parse_link_kind(p &: Ps): str:
    if p_at(p, tok.TK_IDENT):
        k := canon_link_kind(p_peek(p).lexeme)
        if k.len() > 0:
            p_advance(p)
            ret k
        end
    end
    ret ""
end

// try_link_directive - the kind is mandatory: a bare `link "x"` is still
// recognized here (by the TK_STRING branch below, so it produces a
// targeted error instead of a confusing "unknown identifier 'link'" from
// falling through to statement parsing), but parse_link_kind returning ""
// is now an error. Only one way to write this directive - mirrors
// c/src/parser/parser_ffi.c's try_link_directive (try_link_attr / @link(...)
// is gone from both sides, see that file's history).
func try_link_directive(p &: Ps, a &: at.Ast, prog: int): bool:
    if !(
        p_at(p, tok.TK_IDENT) && str.Equals(p_peek(p).lexeme, "link") && (
            p_peek2(p).kind == tok.TK_STRING || (
                p_peek2(p).kind == tok.TK_IDENT && canon_link_kind(p_peek2(p).lexeme).len() > 0
            )
        )
    ):
        ret false
    end
    ln := p_mk(p, a, at.AST_LINK)
    p_advance(p)
    kind := parse_link_kind(p)
    at.SetName(a, ln, kind)
    if kind.len() == 0:
        p_error(
            p, `'link' requires an explicit kind: write 'link static "..."', 'link dynamic "..."', or 'link framework "..."'`
        )
    end
    if p_at(p, tok.TK_STRING):
        at.SetTokenValue(a, ln, p_peek(p).value)
        p_advance(p)
    else:
        p_error(p, "expected a library-name string after 'link'")
    end
    p_term(p)
    p_fin(p, a, ln)
    at.AddChild(a, prog, ln)
    ret true
end

func parse_extern_func(p &: Ps, a &: at.Ast): int:
    n := p_mk(p, a, at.AST_FUNC_DEF)
    mut n0 := at.Get(a, n)
    n0.is_extern = true
    at.Put(a, n, n0)
    p_advance(p)
    at.SetName(a, n, p_name(p, "expected external function name"))
    p_expect(p, tok.TK_LPAREN, "'(' after external function name")
    if !p_at(p, tok.TK_RPAREN):
        mut go := true
        until go:
            if p_at(p, tok.TK_ELLIPSIS):
                mut nv := at.Get(a, n)
                nv.is_variadic = true
                at.Put(a, n, nv)
                p_advance(p)
                break
            end
            param := p_mk(p, a, at.AST_PARAM)
            pname := p_name(p, "expected parameter name")
            at.SetName(a, param, pname)
            if pname.len() == 0:
                break
            end
            if p_match(p, tok.TK_AMP):
                mut pn := at.Get(a, param)
                pn.is_ref = true
                at.Put(a, param, pn)
            end
            at.SetTypeNode(a, param, parse_type_anno(p, a))
            p_fin(p, a, param)
            at.AddChild(a, n, param)
            go = p_match(p, tok.TK_COMMA)
        end
    end
    p_expect(p, tok.TK_RPAREN, "')' after parameters")
    mut rt := 0
    if p_try_return_type(p, a, rt):
        at.SetTypeNode(a, n, rt)
    end

    if p_at(p, tok.TK_COLON):
        ps_set_a(a, n, parse_block(p, a))
    else:
        p_term(p)
    end
    p_fin(p, a, n)
    ret n
end

func parse_extern_var(p &: Ps, a &: at.Ast): int:
    n := p_mk(p, a, at.AST_VAR_DECL)
    mut n0 := at.Get(a, n)
    n0.is_extern = true
    if p_at(p, tok.TK_KW_MUT):
        n0.is_mut = true
        at.Put(a, n, n0)
        p_advance(p)
    else p_at(p, tok.TK_IDENT) && str.Equals(p_peek(p).lexeme, "var"):
        n0.is_mut = true
        at.Put(a, n, n0)
        p_advance(p)
    else:
        at.Put(a, n, n0)
    end
    at.SetName(a, n, p_name(p, "expected external variable name"))
    at.SetTypeNode(a, n, parse_type_anno(p, a))
    p_term(p)
    p_fin(p, a, n)
    ret n
end

func parse_extern_into(p &: Ps, a &: at.Ast, prog: int):
    p_advance(p)
    p_expect(p, tok.TK_COLON, "':' to open extern block")
    p_skip_terminators(p)
    until !p_at(p, tok.TK_KW_END) && !p_at_eof(p):
        p_skip_terminators(p)
        if p_at(p, tok.TK_KW_END) || p_at_eof(p):
            break
        end
        mut d := 0
        mut m_deprecated := false
        mut m_pure := false
        mut m_noret := false
        if p_at(p, tok.TK_KW_DEPRECATED):
            m_deprecated = true
            p_advance(p)
        end
        if p_at(p, tok.TK_KW_PURE):
            m_pure = true
            p_advance(p)
        else p_at(p, tok.TK_KW_NORET):
            m_noret = true
            p_advance(p)
        end
        if (m_deprecated || m_pure || m_noret) && !p_at(p, tok.TK_KW_FUNC):
            p_error(p, "extern function modifiers ('deprecated', 'pure', 'noret') must appear in this order: 'deprecated pure|noret func'")
        end
        if p_at(p, tok.TK_KW_PUB) || p_at(p, tok.TK_KW_INLINE) || p_at(p, tok.TK_KW_NOINLINE):
            p_error(p, "only 'deprecated', 'pure', or 'noret' may modify an extern function")
        end
        if p_at(p, tok.TK_KW_FUNC):
            d = parse_extern_func(p, a)
            if d != 0:
                mut dn := at.Get(a, d)
                dn.is_deprecated = m_deprecated
                dn.is_pure = m_pure
                dn.is_noret = m_noret
                at.Put(a, d, dn)
            end
        else p_at(p, tok.TK_KW_MUT) || p_at(p, tok.TK_IDENT):
            d = parse_extern_var(p, a)
        else:
            p_error(p, "expected 'func' or a variable in extern block")
            if !p_at_eof(p):
                p_advance(p)
            end
        end
        if d != 0:
            at.AddChild(a, prog, d)
        end
        if p.panic:
            p_sync(p)
        end
    end
    p_expect(p, tok.TK_KW_END, "'end' to close extern block")
    p_term(p)
end

// ===== parser_layout.c =====

func layout_body(p &: Ps, a &: at.Ast, parent: int):
    until !p_at(p, tok.TK_KW_END) && !p_at_eof(p):
        p_skip_terminators(p)
        if p_at(p, tok.TK_KW_END) || p_at_eof(p):
            break
        end
        if p_at(p, tok.TK_LAYOUT_ELEMENT):
            at.AddChild(a, parent, layout_element(p, a))
        else p_at(p, tok.TK_LAYOUT_ATTR_NAME):
            at.AddChild(a, parent, layout_attribute(p, a))
        else:
            p_error(p, "unexpected token inside layout block")
            if !p_at_eof(p):
                p_advance(p)
            end
        end
        if p.panic:
            p_sync(p)
        end
    end
end

func layout_element(p &: Ps, a &: at.Ast): int:
    p_rule(p, "layout_element")
    n := p_mk(p, a, at.AST_LAYOUT_ELEMENT)

    if !p_recurse_enter(p, "layout nested too deeply"):
        ret n
    end
    at.SetName(a, n, p_peek(p).lexeme)
    p_advance(p)
    p_expect(p, tok.TK_COLON, "':' after layout element name")
    p_skip_terminators(p)
    layout_body(p, a, n)
    p_expect(p, tok.TK_KW_END, "'end' to close layout element")
    p_fin(p, a, n)
    p_skip_terminators(p)
    p_recurse_leave(p)
    ret n
end

func layout_attribute(p &: Ps, a &: at.Ast): int:
    p_rule(p, "layout_attribute")
    n := p_mk(p, a, at.AST_LAYOUT_ATTR)
    at.SetName(a, n, p_peek(p).lexeme)
    p_advance(p)
    p_expect(p, tok.TK_ASSIGN, "'=' after layout attribute name")
    ps_set_a(a, n, parse_expr(p, a))
    p_fin(p, a, n)
    p_skip_terminators(p)
    ret n
end

func parse_layout_block(p &: Ps, a &: at.Ast): int:
    p_rule(p, "layout_block")
    n := p_mk(p, a, at.AST_LAYOUT_BLOCK)
    p_advance(p)
    p_expect(p, tok.TK_COLON, "':' after 'layout'")
    p_skip_terminators(p)
    layout_body(p, a, n)
    p_expect(p, tok.TK_KW_END, "'end' to close layout block")
    p_fin(p, a, n)
    ret n
end

func parse_component(p &: Ps, a &: at.Ast): int:
    p_rule(p, "component")
    n := p_mk(p, a, at.AST_LAYOUT_COMPONENT)
    p_advance(p)
    at.SetName(a, n, p_name(p, "expected component name"))
    if p_match(p, tok.TK_LPAREN):
        if !p_at(p, tok.TK_RPAREN):
            mut go := true
            until go:
                param := p_mk(p, a, at.AST_PARAM)
                pname := p_name(p, "expected component parameter name")
                at.SetName(a, param, pname)
                if pname.len() > 0 && p_match(p, tok.TK_ASSIGN):
                    ps_set_a(a, param, parse_expr(p, a))
                end
                p_fin(p, a, param)
                if pname.len() > 0:
                    at.AddChild(a, n, param)
                end
                go = p_match(p, tok.TK_COMMA)
            end
        end
        p_expect(p, tok.TK_RPAREN, "')' after component parameters")
    end
    p_expect(p, tok.TK_COLON, "':' after component header")
    p_skip_terminators(p)
    body := p_mk(p, a, at.AST_BLOCK)
    layout_body(p, a, body)
    p_expect(p, tok.TK_KW_END, "'end' to close component")
    p_fin(p, a, body)
    ps_set_a(a, n, body)
    p_fin(p, a, n)
    ret n
end

// ===== parser.c =====

func attach_pending(a &: at.Ast, target: int, pending &: Vector<str>):
    repeat pending.len() with i:
        at.AddAlias(a, target, pending.get(i)[0])
    end
    pending.clear()
end

func metas_have_lang(out: Vector<str>, lang: str): bool:
    mut i := 0
    until i + 1 < out.len():
        if str.Equals(out.get(i)[0], lang):
            ret true
        end
        i += 2
    end
    ret false
end

func parse_metas(p &: Ps, out &: Vector<str>):
    p_skip_terminators(p)
    until p_at(p, tok.TK_META):
        lang := p_peek(p).lexeme
        if metas_have_lang(out, lang):
            p_error(
                p, co.Format2(
                    i18.Tr(`duplicate '@%s' marker on one definition; give one marker several values instead: @%s "a" "b"`),
                    co.ArgStr(lang), co.ArgStr(lang)
                )
            )
        end
        p_advance(p)
        if p_at(p, tok.TK_STRING):
            until p_at(p, tok.TK_STRING):
                out.push(lang)
                out.push(p_peek(p).value.sval)
                p_advance(p)
            end
        else:
            p_error(p, "expected a string after '@' annotation")
        end
        p_skip_terminators(p)
    end
end

func parse_package(p &: Ps, a &: at.Ast, prog: int, pending &: Vector<str>): bool:
    if !p_at(p, tok.TK_KW_PACKAGE):
        ret false
    end
    p_advance(p)
    if p_at(p, tok.TK_IDENT) || p_at(p, tok.TK_KW_LAYOUT):
        at.SetName(a, prog, p_peek(p).lexeme)
        p_advance(p)
    else:
        p_error(p, "expected package name after 'package'")
    end
    attach_pending(a, prog, pending)
    p_term(p)
    ret true
end

func parse_top_level_item_into(p &: Ps, a &: at.Ast, dest: int, pending &: Vector<str>):
    p_skip_terminators(p)
    parse_metas(p, pending)
    if p_at_eof(p):
        ret
    end
    if p_at(p, tok.TK_KW_IMPORT):
        pending.clear()
        parse_imports_into(p, a, dest)
        ret
    end
    if p_at(p, tok.TK_KW_EXTERN):
        pending.clear()
        parse_extern_into(p, a, dest)
        ret
    end
    if try_link_directive(p, a, dest):
        pending.clear()
        ret
    end
    if p_at(p, tok.TK_KW_IF):
        pending.clear()
        at.AddChild(a, dest, parse_toplevel_if(p, a))
        ret
    end
    def := parse_top_level(p, a)
    if def != 0:
        attach_pending(a, def, pending)
        at.AddChild(a, dest, def)
    end
    pending.clear()
    if p.panic:
        p_sync(p)
    end
end

func fill_toplevel_block_body(p &: Ps, a &: at.Ast, n: int):
    mut pending := Vector {} as Vector<str>
    defer pending.free()
    p_skip_terminators(p)
    until !p_at(p, tok.TK_KW_END) && !p_at(p, tok.TK_KW_ELSE) && !p_at_eof(p):
        p_skip_terminators(p)
        if p_at(p, tok.TK_KW_END) || p_at(p, tok.TK_KW_ELSE) || p_at_eof(p):
            break
        end
        parse_top_level_item_into(p, a, n, pending)
        if p.panic:
            p_sync(p)
        end
    end
end

func parse_toplevel_if_tail(p &: Ps, a &: at.Ast): int:
    if !p_recurse_enter(p, "if/else chain nested too deeply"):
        ret p_mk(p, a, at.AST_IF)
    end
    n := p_mk(p, a, at.AST_IF)
    ps_set_a(a, n, parse_cond_expr(p, a))
    b := p_mk(p, a, at.AST_BLOCK)
    ps_set_b(a, n, b)
    p_expect(p, tok.TK_COLON, "':' after if condition")
    fill_toplevel_block_body(p, a, b)
    p_fin(p, a, b)
    p_skip_terminators(p)
    if p_match(p, tok.TK_KW_ELSE):
        p_match(p, tok.TK_KW_IF)
        if !p_at(p, tok.TK_COLON):
            ps_set_c(a, n, parse_toplevel_if_tail(p, a))
        else:
            c := p_mk(p, a, at.AST_BLOCK)
            ps_set_c(a, n, c)
            p_expect(p, tok.TK_COLON, "':' after else")
            fill_toplevel_block_body(p, a, c)
            p_expect(p, tok.TK_KW_END, "'end' to close if")
            p_fin(p, a, c)
        end
    else:
        p_expect(p, tok.TK_KW_END, "'end' to close if")
    end
    p_fin(p, a, n)
    p_recurse_leave(p)
    ret n
end

func parse_toplevel_if(p &: Ps, a &: at.Ast): int:
    p_rule(p, "toplevel_if_stmt")
    p_advance(p)
    ret parse_toplevel_if_tail(p, a)
end

func parse_program(p &: Ps, a &: at.Ast): int:
    p_rule(p, "program")
    prog := p_mk(p, a, at.AST_PROGRAM)
    at.SetName(a, prog, "main")

    mut pending := Vector {} as Vector<str>
    defer pending.free()
    p_skip_terminators(p)
    parse_metas(p, pending)
    parse_package(p, a, prog, pending)
    until !p_at_eof(p):
        parse_top_level_item_into(p, a, prog, pending)
    end
    p_fin(p, a, prog)
    ret prog
end

func p_at_string_import(p &: Ps): bool:
    ret p_at(p, tok.TK_STRING) || (p_at(p, tok.TK_IDENT) && p_peek2(p).kind == tok.TK_STRING)
end

func parse_string_import_entry(p &: Ps, a &: at.Ast): int:
    n := p_mk(p, a, at.AST_IMPORT)
    mut alias := ""
    if p_at(p, tok.TK_IDENT) && p_peek2(p).kind == tok.TK_STRING:
        alias = p_peek(p).lexeme
        p_advance(p)
    end
    if p_at(p, tok.TK_STRING):
        at.SetName(a, n, alias)
        at.SetTokenValue(a, n, p_peek(p).value)
        p_advance(p)
    else:
        p_error(p, "expected import path string")
    end
    p_fin(p, a, n)
    ret n
end

func parse_ident_import_entry(p &: Ps, a &: at.Ast): int:
    n := p_mk(p, a, at.AST_IMPORT)
    mut b := p_munch_name(p)
    until p_at(p, tok.TK_DOT):
        p_advance(p)
        b = b + "." + p_munch_name(p)
    end
    at.SetName(a, n, b)
    // n->value.kind = TV_NONE is the Node default.
    p_fin(p, a, n)
    ret n
end

func parse_imports_into(p &: Ps, a &: at.Ast, prog: int):
    p_advance(p)
    if p_at(p, tok.TK_LPAREN):
        p_error(p, `grouped imports are not supported; write import "a" "b"`)
        until !p_at(p, tok.TK_RPAREN) && !p_at_eof(p):
            p_advance(p)
        end
        p_match(p, tok.TK_RPAREN)
        p_term(p)
        ret
    end
    if p_at_string_import(p):
        at.AddChild(a, prog, parse_string_import_entry(p, a))
        until p_at_string_import(p):
            at.AddChild(a, prog, parse_string_import_entry(p, a))
        end
    else p_at(p, tok.TK_IDENT):
        at.AddChild(a, prog, parse_ident_import_entry(p, a))
    else:
        p_error(p, "expected import path string")
    end
    p_term(p)
end

// ---------------------------------------------------------------------------
// Public API (E088: pub section last)
// ---------------------------------------------------------------------------

// ===== parser.c =====
// parser_run - fills `out_program` with the AST_PROGRAM node id (into the
// caller's Ast made with at.NewAst()) and returns !had_error, like the C bool.
pub func Run(
    lgr: lg.Logger, toks: tok.TokenStream, a &: at.Ast, out_program &: int
): bool:
    mut p := Ps {}
    p.toks = toks
    p.count = tok.StreamCount(toks)
    p.pos = 0
    p.file = tok.StreamFile(toks)
    p.lgr = lgr
    lg.Log(lgr, lg.PH_PARSER, lg.LOG_INFO, "parsing " + p.count + " tokens")
    prog := parse_program(p, a)
    out_program = prog
    mut suffix := ""
    if p.had_error:
        suffix = i18.Tr(" (with errors)")
    end
    lg.Log(
        lgr, lg.PH_PARSER, lg.LOG_INFO, "parse complete: " + at.ChildCount(a, prog) + " top-level defs" + suffix
    )
    ret !p.had_error
end
