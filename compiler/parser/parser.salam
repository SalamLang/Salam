package parser

import tok "../token.salam"
import at "../ast.salam"
import lg "../logger.salam"
import co "../sal_core.salam"

const PS_MAX_DEPTH := 128

struct Ps:
    pub toks: tok.TokenStream = tok.StreamNew("")
    pub count: int = 0
    pub pos: int = 0
    pub file: str = ""
    pub lgr: lg.Logger = lg.New(2, false)
    pub had_error: bool = false
    pub err_at_eof: bool = false
    pub panic: bool = false
    pub no_struct_lit: bool = false
    pub no_with_word: bool = false
    pub depth: int = 0
    pub angle_pending: int = 0
end

inline func byte_at(s: str, i: int): int: ret co.ByteAt(s, i) end

func ps_set_a(a &: at.Ast, id: int, v: int):
    mut n := at.Get(a, id)
    n.a = v
    at.Put(a, id, n)
end

func ps_set_b(a &: at.Ast, id: int, v: int):
    mut n := at.Get(a, id)
    n.b = v
    at.Put(a, id, n)
end

func ps_set_c(a &: at.Ast, id: int, v: int):
    mut n := at.Get(a, id)
    n.c = v
    at.Put(a, id, n)
end

func ps_set_d(a &: at.Ast, id: int, v: int):
    mut n := at.Get(a, id)
    n.d = v
    at.Put(a, id, n)
end

func mk_from_node(a &: at.Ast, kind: int, src: int): int:
    s := at.Get(a, src)
    id := at.NewNode(a, kind)
    at.SetSpan(
        a, id, s.begin_line, s.begin_col, s.begin_index, s.end_line, s.end_col, s.end_index, s.length
    )
    ret id
end

func ps_end_from_node(a &: at.Ast, id: int, src: int):
    s := at.Get(a, src)
    mut n := at.Get(a, id)
    n.end_line = s.end_line
    n.end_col = s.end_col
    n.end_index = s.end_index
    at.Put(a, id, n)
end
