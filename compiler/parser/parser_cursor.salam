package parser

import str

include co "../sal_core.salam"
include tok "../token.salam"
include at "../ast.salam"
include lg "../logger.salam"
include i18 "../i18n.salam"

func is_comment_kind(k: int): bool:
    ret k == tok.TK_COMMENT_LINE or k == tok.TK_COMMENT_BLOCK
end

func skip_comments_from(p &: Ps, from: int): int:
    mut i := from
    until i < p.count - 1 and is_comment_kind(p.toks.toks.get(i).kind):
        i += 1
    end
    ret i
end

func p_peek(p &: Ps): tok.Token:
    mut i := skip_comments_from(p, p.pos)
    if i >= p.count:
        i = p.count - 1
    end
    ret p.toks.toks.get(i)
end

func p_peek2(p &: Ps): tok.Token:
    mut i := skip_comments_from(p, p.pos)
    if i < p.count - 1:
        i = skip_comments_from(p, i + 1)
    end
    if i >= p.count:
        i = p.count - 1
    end
    ret p.toks.toks.get(i)
end

func p_prev(p &: Ps): tok.Token:
    mut i := 0
    if p.pos > 0:
        i = p.pos - 1
    end
    ret p.toks.toks.get(i)
end

func p_list_next(p &: Ps, close: int): bool:
    if p_match(p, tok.TK_COMMA):
        ret not p_at(p, close)
    end
    ret not p.panic and not p_at(p, close) and not p_at_eof(p) and p.pos > 0 and p_peek(p).begin_line > p_prev(p).end_line
end

func p_at(p &: Ps, k: int): bool:
    ret p_peek(p).kind == k
end

func p_at_eof(p &: Ps): bool:
    ret p_peek(p).kind == tok.TK_EOF
end

func p_advance(p &: Ps):
    p.pos = skip_comments_from(p, p.pos)
    if p.pos < p.count - 1:
        p.pos += 1
        p.pos = skip_comments_from(p, p.pos)
    end
end

func p_match(p &: Ps, k: int): bool:
    if p_at(p, k):
        p_advance(p)
        ret true
    end
    ret false
end

func p_skip_terminators(p &: Ps):
    until p_at(p, tok.TK_STMT_END):
        p_advance(p)
    end
end

func p_error(p &: Ps, msg: str):
    if p.panic:
        ret
    end
    t := p_peek(p)
    mut m := ""
    if t.kind == tok.TK_EOF:
        m = co.Format1(i18.Tr("%s (at end of file)"), co.ArgStr(i18.Tr(msg)))
    else t.kind == tok.TK_STMT_END and not str.Equals(t.lexeme, ";"):
        m = co.Format1(i18.Tr("%s (at end of line)"), co.ArgStr(i18.Tr(msg)))
    else:
        m = co.Format2(
            i18.Tr("%s (near '%s')"), co.ArgStr(i18.Tr(msg)), co.ArgStr(t.lexeme)
        )
    end
    lg.LogAt(
        p.lgr, lg.PH_PARSER, lg.LOG_ERROR, p.file, t.begin_line as int, t.begin_col as int, m
    )
    if not p.had_error and t.kind == tok.TK_EOF:
        p.err_at_eof = true
    end
    p.had_error = true
    p.panic = true
end

func p_star_pair_kind(p &: Ps): int:
    t := p_peek(p)
    if t.kind != tok.TK_STAR:
        ret t.kind
    end
    t2 := p_peek2(p)
    if t2.begin_index != t.end_index:
        ret t.kind
    end
    if t2.kind == tok.TK_STAR:
        ret tok.TK_POWER
    end
    if t2.kind == tok.TK_STAR_EQ:
        ret tok.TK_POWER_EQ
    end
    ret t.kind
end

func p_error_at(p &: Ps, t: tok.Token, msg: str):
    lg.LogAt(
        p.lgr, lg.PH_PARSER, lg.LOG_ERROR, p.file, t.begin_line as int, t.begin_col as int, i18.Tr(msg)
    )
    p.had_error = true
end

func p_error_verbatim(p &: Ps, help: str, msg: str):
    if p.panic:
        ret
    end
    t := p_peek(p)
    lg.LogAtHelp(
        p.lgr, lg.PH_PARSER, lg.LOG_ERROR, p.file, t.begin_line as int, t.begin_col as int, help, msg
    )
    if not p.had_error and t.kind == tok.TK_EOF:
        p.err_at_eof = true
    end
    p.had_error = true
    p.panic = true
end

func p_expect(p &: Ps, k: int, what: str): bool:
    if p_at(p, k):
        p_advance(p)
        ret true
    end
    p_error(p, co.Format1(i18.Tr("expected %s"), co.ArgStr(i18.Tr(what))))
    ret false
end

func p_close_angle(p &: Ps, what: str): bool:
    if p.angle_pending > 0:
        p.angle_pending -= 1
        ret true
    end
    if p_at(p, tok.TK_GT):
        p_advance(p)
        ret true
    end
    if p_at(p, tok.TK_SHR):
        p_advance(p)
        p.angle_pending += 1
        ret true
    end
    p_error(p, co.Format1(i18.Tr("expected %s"), co.ArgStr(i18.Tr(what))))
    ret false
end

func p_sync(p &: Ps):
    p.panic = false
    p.angle_pending = 0
    until not p_at_eof(p):
        k := p_peek(p).kind
        if k == tok.TK_STMT_END:
            p_advance(p)
            ret
        end
        if k == tok.TK_KW_FUNC or k == tok.TK_KW_STRUCT or k == tok.TK_KW_ENUM or k == tok.TK_KW_TYPE or k == tok.TK_KW_CONST or k == tok.TK_KW_IMPORT or k == tok.TK_KW_INCLUDE or k == tok.TK_KW_EXTERN or k == tok.TK_KW_EXPORT or k == tok.TK_KW_LAYOUT or k == tok.TK_KW_IF or k == tok.TK_KW_UNTIL or k == tok.TK_KW_EACH or k == tok.TK_KW_REPEAT or k == tok.TK_KW_MATCH or k == tok.TK_KW_SWITCH or k == tok.TK_KW_RET or k == tok.TK_RBRACE or k == tok.TK_KW_END:
            ret
        end
        p_advance(p)
    end
end

func p_mk(p &: Ps, a &: at.Ast, kind: int): int:
    t := p_peek(p)
    id := at.NewNode(a, kind)
    at.SetSpan(
        a, id, t.begin_line, t.begin_col, t.begin_index, t.end_line, t.end_col, t.end_index, t.length
    )
    ret id
end

func p_fin(p &: Ps, a &: at.Ast, id: int):
    t := p_prev(p)
    mut n := at.Get(a, id)
    n.end_line = t.end_line
    n.end_col = t.end_col
    n.end_index = t.end_index
    at.Put(a, id, n)
end

func p_term(p &: Ps):
    if p_at(p, tok.TK_STMT_END):
        p_advance(p)
    end
end

func p_rule(p &: Ps, nm: str):
    if lg.Enabled(p.lgr, lg.LOG_TRACE):
        t := p_peek(p)
        lg.LogAt(
            p.lgr, lg.PH_PARSER, lg.LOG_TRACE, p.file, t.begin_line as int, t.begin_col as int, "rule " + nm + " @ " + tok.KindName(t.kind)
        )
    end
end

func p_at_reserved_word(p &: Ps): bool:
    t := p_peek(p)
    if tok.IsKeyword(t.kind):
        ret true
    end
    if t.kind == tok.TK_AND or t.kind == tok.TK_OR:
        ret t.lexeme.len() > 0 and byte_at(t.lexeme, 0) >= 128
    end
    ret false
end

func p_reserved_word_error(p &: Ps):
    t := p_peek(p)
    word := t.lexeme.len() > 0 ? t.lexeme : "<eof>"
    msg := co.Format1(
        i18.Tr("'%s' is a reserved word, so it cannot be used as a name"), co.ArgStr(word)
    )
    help := co.Format1(i18.Tr("pick a different name, for example '%s_'"), co.ArgStr(word))
    p_error_verbatim(p, help, msg)
end

func p_name(p &: Ps, what: str): str:
    if p_at(p, tok.TK_IDENT):
        s := p_peek(p).lexeme
        p_advance(p)
        ret s
    end
    if p_at_reserved_word(p):
        p_reserved_word_error(p)
        p_advance(p)
        ret "<error>"
    end
    p_error(p, what)
    ret "<error>"
end

func p_at_word_op(p &: Ps): bool:
    k := p_peek(p).kind
    if k != tok.TK_LT and k != tok.TK_GT and k != tok.TK_LE and k != tok.TK_GE and k != tok.TK_EQ and k != tok.TK_NE:
        ret false
    end
    lx := p_peek(p).lexeme
    ret lx.len() > 0 and byte_at(lx, 0) >= 128
end

func p_member_name(p &: Ps, what: str): str:
    if p_at(p, tok.TK_IDENT) or tok.IsKeyword(p_peek(p).kind) or p_at_word_op(p):
        s := p_peek(p).lexeme
        p_advance(p)
        ret s
    end
    p_error(p, what)
    ret ""
end

func p_error_node(p &: Ps, a &: at.Ast): int:
    n := p_mk(p, a, at.AST_IDENTIFIER)
    at.SetName(a, n, "<error>")
    p_fin(p, a, n)
    ret n
end

func p_peekn(p &: Ps, k: int): tok.Token:
    mut i := skip_comments_from(p, p.pos)
    repeat k:
        if i < p.count - 1:
            i += 1
            i = skip_comments_from(p, i)
        end
    end
    if i >= p.count:
        i = p.count - 1
    end
    ret p.toks.toks.get(i)
end

func p_ident_run_len(p &: Ps): int:
    mut m := 0
    mut line := 0 as u32
    mut have := false
    until p_peekn(p, m).kind == tok.TK_IDENT:
        l := p_peekn(p, m).begin_line
        if not have:
            line = l
            have = true
        else l != line:
            break
        end
        m += 1
    end
    ret m
end

func p_munch_name(p &: Ps): str:
    if not p_at(p, tok.TK_IDENT):
        ret p_name(p, "expected name")
    end
    mut b := ""
    mut first := true
    line := p_peek(p).begin_line
    until p_at(p, tok.TK_IDENT) and p_peek(p).begin_line == line:
        if not first:
            b = b + " "
        end
        b = b + p_peek(p).lexeme
        first = false
        p_advance(p)
    end
    p_note_multi_name(p, b)
    ret b
end

func p_note_multi_name(p &: Ps, name: str):
    if not str.Contains(name, " "):
        ret
    end
    repeat p.multi_names.len() in i:
        if str.Equals(p.multi_names.get(i), name):
            ret
        end
    end
    p.multi_names.push(name)
end

func tk_is_assign_op(k: int): bool:
    ret k == tok.TK_ASSIGN or k == tok.TK_PLUS_EQ or k == tok.TK_MINUS_EQ or k == tok.TK_STAR_EQ or k == tok.TK_SLASH_EQ or k == tok.TK_PERCENT_EQ or k == tok.TK_POWER_EQ or k == tok.TK_AMP_EQ or k == tok.TK_PIPE_EQ or k == tok.TK_CARET_EQ or k == tok.TK_SHL_EQ or k == tok.TK_SHR_EQ
end

func tk_wants_value(k: int): bool:
    if tk_is_assign_op(k) or k == tok.TK_COLON_ASSIGN:
        ret true
    end
    ret k >= tok.TK_PLUS and k <= tok.TK_GE
end

func p_value_run_words(p &: Ps, line: u32): int:
    mut n := 0
    until p_at_value_word_n(p, n) and p_peekn(p, n).begin_line == line:
        n += 1
    end
    ret n
end

func p_at_value_word_n(p &: Ps, n: int): bool:
    k := p_peekn(p, n).kind
    ret k == tok.TK_IDENT or k == tok.TK_KW_PACKAGE
end

func p_value_words_before_target(p &: Ps): int:
    line := p_peek(p).begin_line
    n := p_value_run_words(p, line)
    if n < 2 or not tk_is_assign_op(p_peekn(p, n).kind):
        ret n
    end
    mut j := 1
    until j < n - 1:
        mut cand := p_peekn(p, j).lexeme
        mut k := j + 1
        until k < n:
            cand = cand + " " + p_peekn(p, k).lexeme
            k += 1
        end
        repeat p.multi_names.len() in i:
            if str.Equals(p.multi_names.get(i), cand):
                ret j
            end
        end
        j += 1
    end
    ret n - 1
end

func p_is_alias_word_keyword(k: int): bool:
    ret k == tok.TK_KW_PACKAGE or k == tok.TK_KW_IN or k == tok.TK_KW_INPUT or k == tok.TK_KW_REPEAT or k == tok.TK_KW_COMPONENT
end

func p_at_mergeable_word(p &: Ps): bool:
    k := p_peek(p).kind
    if k == tok.TK_NOT:
        ret not str.Equals(p_peek(p).lexeme, "!")
    end
    if k == tok.TK_KW_IN and p.no_in_word:
        ret false
    end
    ret k == tok.TK_IDENT or p_is_alias_word_keyword(k)
end

func p_at_mergeable_value_word(p &: Ps): bool:
    k := p_peek(p).kind
    ret k == tok.TK_IDENT or k == tok.TK_KW_PACKAGE
end

func tk_is_new_binding(k: int): bool:
    ret k == tok.TK_COLON_ASSIGN
end

func p_munch_value_name(p &: Ps): str:
    if not p_at(p, tok.TK_IDENT):
        ret p_name(p, "expected name")
    end
    line := p_peek(p).begin_line
    mut limit := 0 - 1
    if p.pos > 0 and tk_wants_value(p_prev(p).kind):
        limit = p_value_words_before_target(p)
    end
    mut b := p_peek(p).lexeme
    mut taken := 1
    p_advance(p)
    until p_at_mergeable_value_word(p) and p_peek(p).begin_line == line and not tk_is_new_binding(p_peek2(p).kind) and (limit < 0 or taken < limit):
        b = b + " " + p_peek(p).lexeme
        taken += 1
        p_advance(p)
    end
    if limit < 0:
        p_note_multi_name(p, b)
    end
    ret b
end

func p_munch_member_name(p &: Ps, what: str): str:
    if not p_at_mergeable_word(p) and not tok.IsKeyword(p_peek(p).kind) and not p_at_word_op(p):
        ret p_member_name(p, what)
    end
    line := p_peek(p).begin_line
    mut b := p_peek(p).lexeme
    p_advance(p)
    until p_at_mergeable_word(p) and p_peek(p).begin_line == line:
        b = b + " " + p_peek(p).lexeme
        p_advance(p)
    end
    ret b
end

func parse_decl_name(p &: Ps): str:
    ret p_munch_name(p)
end

func p_recurse_enter(p &: Ps, what: str): bool:
    if p.depth >= PS_MAX_DEPTH:
        p_error(p, what)
        ret false
    end
    p.depth += 1
    ret true
end

func p_recurse_leave(p &: Ps):
    p.depth -= 1
end

func p_try_return_type(p &: Ps, a &: at.Ast, out_type &: int): bool:
    if not p_at(p, tok.TK_COLON):
        ret false
    end
    save_pos := p.pos
    colon_line := p_peek(p).begin_line
    p_advance(p)
    if p_peek(p).begin_line != colon_line:
        p.pos = save_pos
        ret false
    end
    save_panic := p.panic
    save_had_error := p.had_error
    p.panic = true
    p.ret_type = true
    t := parse_type(p, a)
    p.ret_type = false
    tname := at.Get(a, t).name
    valid_name := tname.len() > 0 and not str.Equals(tname, "<error>")
    if valid_name and (p_at(p, tok.TK_COLON) or p_at(p, tok.TK_STMT_END) or p_at_eof(p)):
        p.panic = save_panic
        out_type = t
        ret true
    end
    p.pos = save_pos
    p.panic = save_panic
    p.had_error = save_had_error
    ret false
end
