package parser

import str

include tok "../token.salam"
include at "../ast.salam"

struct FnMods:
    pub is_pub: bool = false
    pub is_deprecated: bool = false
    pub is_inline: bool = false
    pub is_noinline: bool = false
    pub is_pure: bool = false
    pub is_noret: bool = false
    pub is_mut: bool = false
    pub any: bool = false
end

func p_at_fn_mod(p &: Ps): bool:
    ret p_at(p, tok.TK_KW_PUB) or p_at(p, tok.TK_KW_DEPRECATED) or p_at(p, tok.TK_KW_INLINE) or p_at(p, tok.TK_KW_NOINLINE) or p_at(p, tok.TK_KW_PURE) or p_at(p, tok.TK_KW_NORET) or p_at_mut_func(p)
end

func absorb_misordered_mods(p &: Ps, m &: FnMods):
    p_error(p, "function modifiers must appear in this order: 'pub deprecated mut inline|noinline pure|noret func'")
    until p_at_fn_mod(p):
        mk := p_peek(p).kind
        if mk == tok.TK_KW_PUB:
            m.is_pub = true
        else mk == tok.TK_KW_DEPRECATED:
            m.is_deprecated = true
        else mk == tok.TK_KW_INLINE:
            m.is_inline = true
        else mk == tok.TK_KW_NOINLINE:
            m.is_noinline = true
        else mk == tok.TK_KW_PURE:
            m.is_pure = true
        else mk == tok.TK_KW_MUT:
            m.is_mut = true
        else:
            m.is_noret = true
        end
        p_advance(p)
    end
    m.any = true
end

func parse_fn_mods(p &: Ps): FnMods:
    mut m := FnMods {}
    if p_at(p, tok.TK_KW_PUB):
        m.is_pub = true
        p_advance(p)
    end
    if p_at(p, tok.TK_KW_DEPRECATED):
        m.is_deprecated = true
        p_advance(p)
    end
    if p_at_mut_func(p):
        m.is_mut = true
        p_advance(p)
    end
    if p_at(p, tok.TK_KW_INLINE):
        m.is_inline = true
        p_advance(p)
    else p_at(p, tok.TK_KW_NOINLINE):
        m.is_noinline = true
        p_advance(p)
    end
    if p_at(p, tok.TK_KW_PURE):
        m.is_pure = true
        p_advance(p)
    else p_at(p, tok.TK_KW_NORET):
        m.is_noret = true
        p_advance(p)
    end
    m.any = m.is_deprecated or m.is_inline or m.is_noinline or m.is_pure or m.is_noret or m.is_mut
    if p_at_fn_mod(p):
        absorb_misordered_mods(p, m)
    end
    if m.is_mut and m.is_pure:
        p_error(p, "a 'pure' method cannot be 'mut func': modifying 'this' is a side effect")
    end
    ret m
end

func apply_fn_mods(a &: at.Ast, n: int, m &: FnMods):
    if n == 0:
        ret
    end
    mut nn := at.Get(a, n)
    nn.is_pub = m.is_pub
    if nn.kind == at.AST_FUNC_DEF:
        nn.is_inline = m.is_inline
        nn.is_noinline = m.is_noinline
        nn.is_pure = m.is_pure
        nn.is_noret = m.is_noret
        nn.is_deprecated = m.is_deprecated
        nn.is_mut = m.is_mut
    end
    at.Put(a, n, nn)
end

func p_at_mut_func(p &: Ps): bool:
    if not p_at(p, tok.TK_KW_MUT):
        ret false
    end
    k := p_peek2(p).kind
    ret k == tok.TK_KW_FUNC or k == tok.TK_KW_INLINE or k == tok.TK_KW_NOINLINE or k == tok.TK_KW_PURE or k == tok.TK_KW_NORET
end

func reject_mut_mod(p &: Ps, m &: FnMods, msg: str):
    if m.is_mut:
        p_error(p, msg)
        m.is_mut = false
    end
end

func check_fn_mods_target(p &: Ps, m &: FnMods):
    if m.any and not p_at(p, tok.TK_KW_FUNC):
        p_error(p, "function modifiers ('deprecated', 'inline', 'noinline', 'pure', 'noret') are only allowed on a function definition")
    end
end

func distinct_this_to_self(a &: at.Ast, id: int):
    if id == 0:
        ret
    end
    mut n := at.Get(a, id)
    if n.kind == at.AST_THIS:
        n.kind = at.AST_IDENTIFIER
        n.name = "__self"
        at.Put(a, id, n)
        ret
    end
    distinct_this_to_self(a, n.a)
    distinct_this_to_self(a, n.b)
    distinct_this_to_self(a, n.c)
    distinct_this_to_self(a, n.d)
    repeat n.list.len() in i:
        distinct_this_to_self(a, n.list.get(i))
    end
    repeat n.dims.len() in j:
        distinct_this_to_self(a, n.dims.get(j))
    end
    repeat n.captures.len() in k:
        distinct_this_to_self(a, n.captures.get(k))
    end
end

func distinct_desugar_method(a &: at.Ast, f: int, tname: str, idx: int):
    fv := at.Get(a, f)
    self_param := mk_from_node(a, at.AST_PARAM, f)
    at.SetName(a, self_param, "__self")
    self_ty := mk_from_node(a, at.AST_TYPE, f)
    at.SetName(a, self_ty, tname)
    at.SetTypeNode(a, self_param, self_ty)
    mut nf := at.Get(a, f)
    mut params := Vector {} as Vector<int>
    params.push(self_param)
    repeat fv.list.len() in i:
        params.push(fv.list.get(i))
    end
    nf.list = params
    nf.name = "__" + tname + "__" + fv.name + "__" + str.FromInt(idx as i64)
    nf.is_pub = true
    at.Put(a, f, nf)
    distinct_this_to_self(a, fv.a)
end

func parse_distinct_body(p &: Ps, a &: at.Ast, tname: str):
    mut idx := 0
    p_skip_terminators(p)
    until not p_at(p, tok.TK_KW_END) and not p_at_eof(p):
        p_skip_terminators(p)
        if p_at(p, tok.TK_KW_END) or p_at_eof(p):
            break
        end
        mut mods := parse_fn_mods(p)
        reject_mut_mod(p, mods, "'mut func' is not allowed on a distinct type: its 'this' is a copy")
        if p_at(p, tok.TK_KW_FUNC):
            f := parse_function(p, a, false)
            if f != 0:
                apply_fn_mods(a, f, mods)
                distinct_desugar_method(a, f, tname, idx)
                idx += 1
                p.tail_defs.push(f)
            end
        else:
            p_error(p, "expected 'func' or 'end' in the body of a distinct type")
            if not p_at_eof(p):
                p_advance(p)
            end
        end
        if p.panic:
            p_sync(p)
        end
    end
    p_expect(p, tok.TK_KW_END, "'end' to close the type body")
    p_term(p)
end

func parse_type_alias(p &: Ps, a &: at.Ast): int:
    p_rule(p, "type_alias")
    n := p_mk(p, a, at.AST_TYPE_ALIAS)
    p_advance(p)
    tname := p_name(p, "expected alias name")
    at.SetName(a, n, tname)
    if p_match(p, tok.TK_COLON):
        at.SetOp(a, n, tok.TK_COLON)
        at.SetTypeNode(a, n, parse_type(p, a))
        parse_distinct_body(p, a, tname)
        p_fin(p, a, n)
        ret n
    end
    p_expect(p, tok.TK_ASSIGN, "'=' in type alias")
    at.SetTypeNode(a, n, parse_type(p, a))
    p_term(p)
    p_fin(p, a, n)
    ret n
end

func parse_const(p &: Ps, a &: at.Ast): int:
    p_rule(p, "const_decl")
    n := p_mk(p, a, at.AST_CONST_DECL)
    p_advance(p)
    at.SetName(a, n, p_name(p, "expected constant name"))
    if p_at(p, tok.TK_COLON):
        p_error(p, "constants with a type annotation were removed; use 'const NAME := value' (or 'const NAME := value as Type')")
        at.SetTypeNode(a, n, parse_type_anno(p, a))
        p_match(p, tok.TK_ASSIGN)
        ps_set_a(a, n, parse_expr(p, a))
        p_term(p)
        p_fin(p, a, n)
        ret n
    end
    if p_at(p, tok.TK_ASSIGN):
        p_error(p, "constants are declared with ':=' ('const NAME := value')")
        p_advance(p)
    else:
        p_expect(p, tok.TK_COLON_ASSIGN, "':=' in const declaration")
    end
    ps_set_a(a, n, parse_expr(p, a))
    p_term(p)
    p_fin(p, a, n)
    ret n
end

func parse_enum(p &: Ps, a &: at.Ast): int:
    p_rule(p, "enum_def")
    n := p_mk(p, a, at.AST_ENUM_DEF)
    en_kw := str.Equals(p_peek(p).lexeme, "enum")
    p_advance(p)
    at.SetName(a, n, p_name(p, "expected enum name"))
    parse_typarams(p, a, n)
    p_expect(p, tok.TK_COLON, "':' after enum name")
    p_skip_terminators(p)
    mut has_data := false
    until not p_at(p, tok.TK_KW_END) and not p_at_eof(p):
        before := p.pos
        p_skip_terminators(p)
        if p_at(p, tok.TK_KW_END) or p_at_eof(p):
            break
        end
        mut mmetas := Vector {} as Vector<str>
        if p_at(p, tok.TK_META):
            parse_metas(p, mmetas)
        end
        m := p_mk(p, a, at.AST_ENUM_MEMBER)
        at.SetName(a, m, p_munch_name(p))
        repeat mmetas.len() in mi:
            at.AddAlias(a, m, mmetas.get(mi))
        end
        mmetas.free()
        if p_at(p, tok.TK_LPAREN):
            has_data = true
            parse_enum_payload(p, a, m)
        end
        if p_match(p, tok.TK_ASSIGN):
            ps_set_a(a, m, parse_expr(p, a))
        end
        p_fin(p, a, m)
        at.AddChild(a, n, m)

        had_comma := p_match(p, tok.TK_COMMA)
        pos_before_sep := p.pos
        p_skip_terminators(p)
        had_sep := had_comma or p.pos != pos_before_sep
        if not had_sep and not p_at(p, tok.TK_KW_END) and not p_at_eof(p):
            p_error(p, "',' between enum members")
        end
        if p.panic:
            p_sync(p)
        end

        if p.pos == before and not p_at(p, tok.TK_KW_END) and not p_at_eof(p):
            p_advance(p)
        end
    end
    p_expect(p, tok.TK_KW_END, "'end' to close enum")
    p_fin(p, a, n)
    if has_data:
        ret desugar_data_enum(p, a, n, en_kw)
    end
    if at.TyparamCount(a, n) > 0:
        p_error_at(p, p_prev(p), "only an enum whose members carry data can have type parameters")
    end
    ret n
end

func parse_enum_payload(p &: Ps, a &: at.Ast, m: int):
    p_advance(p)
    p_skip_terminators(p)
    until not p_at(p, tok.TK_RPAREN) and not p_at_eof(p):
        f := p_mk(p, a, at.AST_FIELD)
        at.SetName(a, f, p_name(p, "expected a field name in the enum member's data"))
        at.SetTypeNode(a, f, parse_type_anno(p, a))
        mut fv := at.Get(a, f)
        fv.is_pub = true
        at.Put(a, f, fv)
        p_fin(p, a, f)
        at.AddChild(a, m, f)
        if p.panic:
            ret
        end
        p_skip_terminators(p)
        if not p_match(p, tok.TK_COMMA):
            break
        end
        p_skip_terminators(p)
    end
    p_expect(p, tok.TK_RPAREN, "')' to close the enum member's data")
end

func mk_type_named(a &: at.Ast, src: int, name: str): int:
    t := mk_from_node(a, at.AST_TYPE, src)
    at.SetName(a, t, name)
    ret t
end

func desugar_data_enum(p &: Ps, a &: at.Ast, n: int, en_kw: bool): int:
    ename := at.Get(a, n).name
    members := at.Get(a, n).list
    if members.len() < 2:
        p_error_at(p, p_prev(p), "an enum with data needs at least two members")
        repeat members.len() in k:
            mut mk := at.Get(a, members.get(k))
            mk.list = Vector {} as Vector<int>
            at.Put(a, members.get(k), mk)
        end
        ret n
    end
    al := mk_from_node(a, at.AST_TYPE_ALIAS, n)
    at.SetName(a, al, ename)
    tps := at.Get(a, n).typarams
    tbs := at.Get(a, n).typaram_bounds
    repeat tps.len() in ti:
        at.AddTyparam(a, al, tps.get(ti), tbs.get(ti))
    end
    vt := mk_type_named(a, n, en_kw ? "Variant" : "گوناگون")
    mut vtn := at.Get(a, vt)
    vtn.synthetic = true
    at.Put(a, vt, vtn)
    repeat members.len() in i:
        m := members.get(i)
        mv := at.Get(a, m)
        if mv.a != 0:
            p_error_at(p, p_prev(p), "an enum member with data cannot also have a '= value'")
        end
        sd := mk_from_node(a, at.AST_STRUCT_DEF, m)
        cname := "__" + ename + "__" + mv.name
        at.SetName(a, sd, cname)
        repeat mv.aliases.len() in ai:
            at.AddAlias(a, sd, mv.aliases.get(ai))
        end
        if mv.list.len() == 0:
            f := mk_from_node(a, at.AST_FIELD, m)
            at.SetName(a, f, "_unit")
            at.SetTypeNode(a, f, mk_type_named(a, m, en_kw ? "bool" : "منطقی"))
            lit := mk_from_node(a, at.AST_LITERAL, m)
            at.SetOp(a, lit, tok.TK_KW_FALSE)
            at.SetTokenValue(a, lit, tok.ValueBool(false))
            at.SetName(a, lit, "false")
            ps_set_a(a, f, lit)
            mut uf := at.Get(a, f)
            uf.is_pub = true
            at.Put(a, f, uf)
            at.AddChild(a, sd, f)
        else:
            repeat mv.list.len() in j:
                at.AddChild(a, sd, mv.list.get(j))
            end
        end
        repeat tps.len() in tj:
            at.AddTyparam(a, sd, tps.get(tj), tbs.get(tj))
        end
        mut sv := at.Get(a, sd)
        sv.is_pub = true
        sv.enum_payload = true
        at.Put(a, sd, sv)
        p.tail_defs.push(sd)
        ct := mk_type_named(a, m, cname)
        repeat tps.len() in tk:
            at.AddChild(a, ct, mk_type_named(a, m, tps.get(tk)))
        end
        at.AddChild(a, vt, ct)
    end
    at.SetTypeNode(a, al, vt)
    mut alv := at.Get(a, al)
    alv.enum_payload = true
    at.Put(a, al, alv)
    ret al
end

func parse_typarams(p &: Ps, a &: at.Ast, n: int):
    if not p_match(p, tok.TK_LT):
        ret
    end
    mut go := true
    until go:
        tp := p_name(p, "expected type parameter name")
        if tp.len() == 0:
            break
        end
        mut bound := ""
        if p_match(p, tok.TK_COLON):
            bound = p_name(p, "expected an interface name after ':' in type parameter bound")
            if bound.len() > 0 and p_at(p, tok.TK_DOT) and p_peek2(p).kind == tok.TK_IDENT:
                p_advance(p)
                bound = bound + "." + p_peek(p).lexeme
                p_advance(p)
            end
        end
        at.AddTyparam(a, n, tp, bound)
        go = p_match(p, tok.TK_COMMA)
    end
    p_close_angle(p, "'>' to close type parameters")
end

func parse_interface_method(p &: Ps, a &: at.Ast): int:
    n := p_mk(p, a, at.AST_FUNC_DEF)
    p_advance(p)
    at.SetName(a, n, p_name(p, "expected method name in interface"))
    if p_match(p, tok.TK_LPAREN):
        parse_params(p, a, n)
        p_expect(p, tok.TK_RPAREN, "')' after parameters")
    end
    finish_untyped_params(p, a, n, false)
    mut rt := 0
    if p_try_return_type(p, a, rt):
        at.SetTypeNode(a, n, rt)
    end
    if p_at(p, tok.TK_COLON):
        ps_set_a(a, n, parse_block(p, a))
        p_fin(p, a, n)
        ret n
    end
    p_term(p)
    p_fin(p, a, n)
    ret n
end

func parse_interface(p &: Ps, a &: at.Ast): int:
    p_rule(p, "interface_def")
    n := p_mk(p, a, at.AST_INTERFACE_DEF)
    p_advance(p)
    at.SetName(a, n, p_name(p, "expected interface name"))
    parse_typarams(p, a, n)
    p_expect(p, tok.TK_COLON, "':' after interface name")
    p_skip_terminators(p)
    mut ipend := Vector {} as Vector<str>
    defer ipend.free()
    until not p_at(p, tok.TK_KW_END) and not p_at_eof(p):
        p_skip_terminators(p)
        parse_metas(p, ipend)
        if p_at(p, tok.TK_KW_END) or p_at_eof(p):
            if ipend.len() > 0:
                p_error(p, "expected a definition after the '@' annotation")
            end
            break
        end
        mut imut := false
        if p_at_mut_func(p):
            imut = true
            p_advance(p)
        end
        if p_at(p, tok.TK_KW_FUNC):
            m := parse_interface_method(p, a)
            if m != 0:
                mut mv := at.Get(a, m)
                mv.is_mut = imut
                at.Put(a, m, mv)
                repeat ipend.len() in i:
                    at.AddAlias(a, m, ipend.get(i))
                end
                at.AddChild(a, n, m)
            end
            ipend.clear()
        else:
            p_error(p, "expected a method signature ('func ...') in interface")
            if not p_at_eof(p):
                p_advance(p)
            end
        end
        if p.panic:
            p_sync(p)
        end
    end
    p_expect(p, tok.TK_KW_END, "'end' to close interface")
    p_fin(p, a, n)
    ret n
end

func parse_impl(p &: Ps, a &: at.Ast): int:
    p_rule(p, "impl_def")
    n := p_mk(p, a, at.AST_IMPL_DEF)
    p_advance(p)
    iname := p_name(p, "expected interface name after 'impl'")
    at.SetName(a, n, iname)
    if iname.len() > 0 and p_at(p, tok.TK_DOT) and p_peek2(p).kind == tok.TK_IDENT:
        p_advance(p)
        at.SetName(a, n, iname + "." + p_peek(p).lexeme)
        p_advance(p)
    end
    p_expect(p, tok.TK_KW_ON, "'on' after interface name in impl block")
    at.SetTypeNode(a, n, parse_type(p, a))
    p_expect(p, tok.TK_COLON, "':' after impl target type")
    p_skip_terminators(p)
    until not p_at(p, tok.TK_KW_END) and not p_at_eof(p):
        p_skip_terminators(p)
        if p_at(p, tok.TK_KW_END) or p_at_eof(p):
            break
        end
        if p_at_mut_func(p):
            p_error(p, "'mut func' is not allowed in an impl block: 'this' is a copy there")
            p_advance(p)
        end
        if p_at(p, tok.TK_KW_FUNC):
            m := parse_function(p, a, false)
            if m != 0:
                at.AddChild(a, n, m)
            end
        else:
            p_error(p, "expected a method ('func ...') in impl block")
            if not p_at_eof(p):
                p_advance(p)
            end
        end
        if p.panic:
            p_sync(p)
        end
    end
    p_expect(p, tok.TK_KW_END, "'end' to close impl block")
    p_fin(p, a, n)
    ret n
end

func parse_struct(p &: Ps, a &: at.Ast): int:
    p_rule(p, "struct_def")
    n := p_mk(p, a, at.AST_STRUCT_DEF)
    p_advance(p)
    at.SetName(a, n, p_name(p, "expected struct name"))
    parse_typarams(p, a, n)
    p_expect(p, tok.TK_COLON, "':' after struct name")
    p_skip_terminators(p)
    mut mpend := Vector {} as Vector<str>
    defer mpend.free()
    until not p_at(p, tok.TK_KW_END) and not p_at_eof(p):
        before := p.pos
        p_skip_terminators(p)
        parse_metas(p, mpend)
        if p_at(p, tok.TK_KW_END) or p_at_eof(p):
            break
        end
        mut mmods := parse_fn_mods(p)
        if p_at(p, tok.TK_KW_CONST) or p_at_static_func(p):
            parse_static_member(p, a, n, mmods)
            mpend.clear()
            if p.panic:
                p_sync(p)
            end
            continue
        end
        check_fn_mods_target(p, mmods)
        mut member := 0
        if p_at(p, tok.TK_KW_FUNC):
            member = parse_function(p, a, false)
        else p_at_embed(p):
            member = parse_embed_field(p, a)
        else:
            member = parse_field(p, a)
        end
        if member != 0:
            apply_fn_mods(a, member, mmods)
            repeat mpend.len() in i:
                at.AddAlias(a, member, mpend.get(i))
            end
            at.AddChild(a, n, member)
        end
        mpend.clear()
        if p.panic:
            p_sync(p)
        end

        if p.pos == before and not p_at(p, tok.TK_KW_END) and not p_at_eof(p):
            p_advance(p)
        end
    end
    p_expect(p, tok.TK_KW_END, "'end' to close struct")
    p_fin(p, a, n)
    ret n
end

func p_at_static_func(p &: Ps): bool:
    if not p_at(p, tok.TK_IDENT) or p_peek2(p).kind != tok.TK_KW_FUNC:
        ret false
    end
    ret str.Equals(canon_link_kind(p_peek(p).lexeme), "static")
end

func static_member_name(sname: str, mname: str): str:
    ret "__" + sname + "__" + mname
end

func parse_static_member(p &: Ps, a &: at.Ast, sn: int, mods &: FnMods):
    sname := at.Get(a, sn).name
    mut m := 0
    if p_at(p, tok.TK_KW_CONST):
        if mods.any:
            p_error(p, "function modifiers ('deprecated', 'inline', 'noinline', 'pure', 'noret') are only allowed on a function definition")
        end
        m = parse_const(p, a)
    else:
        reject_mut_mod(p, mods, "'mut func' is not allowed on a static function: it has no 'this'")
        p_advance(p)
        m = parse_function(p, a, false)
        if m != 0:
            stp := at.Get(a, sn).typarams
            stb := at.Get(a, sn).typaram_bounds
            own := at.Get(a, m).typarams
            repeat stp.len() in ti:
                mut dup := false
                repeat own.len() in tj:
                    if str.Equals(own.get(tj), stp.get(ti)):
                        dup = true
                    end
                end
                if not dup:
                    at.AddTyparam(a, m, stp.get(ti), stb.get(ti))
                end
            end
        end
    end
    if m == 0:
        ret
    end
    apply_fn_mods(a, m, mods)
    mut mv := at.Get(a, m)
    mv.name = static_member_name(sname, mv.name)
    mv.is_static = true
    at.Put(a, m, mv)
    p.tail_defs.push(m)
end

func p_at_embed(p &: Ps): bool:
    if not p_at(p, tok.TK_IDENT) or p_peek2(p).kind != tok.TK_IDENT:
        ret false
    end
    w := p_peek(p).lexeme
    ret str.Equals(w, "use") or str.Equals(w, "شامل")
end

func parse_embed_field(p &: Ps, a &: at.Ast): int:
    p_rule(p, "embed_field")
    n := p_mk(p, a, at.AST_FIELD)
    p_advance(p)
    t := parse_type(p, a)
    tn := at.Get(a, t).name
    mut short := tn
    dot := str.IndexOf(tn, ".")
    if dot >= 0:
        short = str.Substr(tn, dot + 1, str.Len(tn) - dot - 1)
    end
    at.SetName(a, n, short)
    at.SetTypeNode(a, n, t)
    mut nv := at.Get(a, n)
    nv.is_embedded = true
    at.Put(a, n, nv)
    if not p.panic:
        p_term(p)
    end
    p_fin(p, a, n)
    ret n
end

func parse_field(p &: Ps, a &: at.Ast): int:
    p_rule(p, "field")
    n := p_mk(p, a, at.AST_FIELD)

    mut nm := ""
    if p_at(p, tok.TK_IDENT):
        nm = parse_decl_name(p)
    else:
        nm = p_member_name(p, "expected field name")
    end
    at.SetName(a, n, nm)
    if nm.len() == 0:
        ret 0
    end
    at.SetTypeNode(a, n, parse_type_anno(p, a))
    if p_match(p, tok.TK_ASSIGN):
        ps_set_a(a, n, parse_expr(p, a))
    end
    if not p.panic:
        p_term(p)
    end
    p_fin(p, a, n)
    ret n
end

func parse_op_method_name(p &: Ps): str:
    k := p_peek(p).kind
    if k == tok.TK_STAR and p_star_pair_kind(p) == tok.TK_POWER:
        p_advance(p)
        p_advance(p)
        ret "operator_pow"
    end
    if k == tok.TK_PLUS:
        p_advance(p)
        ret "operator_add"
    end
    if k == tok.TK_MINUS:
        p_advance(p)
        ret "operator_sub"
    end
    if k == tok.TK_STAR:
        p_advance(p)
        ret "operator_mul"
    end
    if k == tok.TK_SLASH:
        p_advance(p)
        ret "operator_div"
    end
    if k == tok.TK_PERCENT:
        p_advance(p)
        ret "operator_mod"
    end
    if k == tok.TK_POWER:
        p_advance(p)
        ret "operator_pow"
    end
    if k == tok.TK_EQ:
        p_advance(p)
        ret "operator_eq"
    end
    if k == tok.TK_NE:
        p_advance(p)
        ret "operator_ne"
    end
    if k == tok.TK_LT:
        p_advance(p)
        ret "operator_lt"
    end
    if k == tok.TK_GT:
        p_advance(p)
        ret "operator_gt"
    end
    if k == tok.TK_LE:
        p_advance(p)
        ret "operator_le"
    end
    if k == tok.TK_GE:
        p_advance(p)
        ret "operator_ge"
    end
    if k == tok.TK_NOT:
        p_advance(p)
        ret "operator_not"
    end
    if k == tok.TK_LBRACKET:
        p_advance(p)
        p_expect(p, tok.TK_RBRACKET, "']' in operator[]")
        if p_at(p, tok.TK_ASSIGN):
            p_advance(p)
            ret "operator_index_set"
        end
        ret "operator_index"
    end
    p_error(p, "this is not a Salam operator: only the built-in operators can be overloaded (+ - * / % ** == != < > <= >= not [] []=)")
    ret "operator_error"
end

func tk_is_op_method_start(k: int): bool:
    ret k == tok.TK_PLUS or k == tok.TK_MINUS or k == tok.TK_STAR or k == tok.TK_SLASH or k == tok.TK_PERCENT or k == tok.TK_POWER or k == tok.TK_EQ or k == tok.TK_NE or k == tok.TK_LT or k == tok.TK_GT or k == tok.TK_LE or k == tok.TK_GE or k == tok.TK_NOT or k == tok.TK_LBRACKET
end

func tk_is_non_overloadable_op(k: int): bool:
    ret k == tok.TK_AMP or k == tok.TK_PIPE or k == tok.TK_CARET or k == tok.TK_TILDE or k == tok.TK_SHL or k == tok.TK_SHR or k == tok.TK_AND or k == tok.TK_OR or k == tok.TK_PLUS_PLUS or k == tok.TK_MINUS_MINUS or k == tok.TK_ASSIGN
end

func p_at_old_operator_word(p &: Ps): bool:
    if not p_at(p, tok.TK_IDENT):
        ret false
    end
    w := p_peek(p).lexeme
    if not str.Equals(w, "operator") and not str.Equals(w, "کارور"):
        ret false
    end
    ret tk_is_op_method_start(p_peekn(p, 1).kind) or tk_is_non_overloadable_op(p_peekn(p, 1).kind)
end

func parse_function(p &: Ps, a &: at.Ast, allow_untyped: bool): int:
    p_rule(p, "function_def")
    n := p_mk(p, a, at.AST_FUNC_DEF)
    p_advance(p)
    if p_at_old_operator_word(p):
        p_error(p, "write an operator overload without 'operator', for example 'func +(other: T): T'")
        p_advance(p)
    end
    if tk_is_op_method_start(p_peek(p).kind) or (tk_is_non_overloadable_op(p_peek(p).kind) and not p_at_reserved_word(p)):
        opname := parse_op_method_name(p)
        at.SetName(a, n, opname)
        if opname != "operator_error" and not p_at(p, tok.TK_LPAREN) and not p_at(p, tok.TK_COLON) and p_peek(p).begin_index == p_prev(p).end_index:
            p_error(p, "this is not a Salam operator: only the built-in operators can be overloaded (+ - * / % ** == != < > <= >= not [] []=)")
        end
    else p_at(p, tok.TK_IDENT):
        m := p_ident_run_len(p)
        after := p_peekn(p, m).kind
        if m >= 2 and after != tok.TK_LPAREN and after != tok.TK_LT:
            mut b := ""
            repeat m - 1 in i:
                if i != 0:
                    b = b + " "
                end
                b = b + p_peek(p).lexeme
                p_advance(p)
            end
            at.SetName(a, n, b)
        else:
            at.SetName(a, n, p_munch_name(p))
        end
    else:
        at.SetName(a, n, p_name(p, "expected a function name or an operator"))
    end
    parse_typarams(p, a, n)
    if p_match(p, tok.TK_LPAREN):
        parse_params(p, a, n)
        p_expect(p, tok.TK_RPAREN, "')' after parameters")
    end
    finish_untyped_params(p, a, n, allow_untyped)
    mut rt := 0
    if p_try_return_type(p, a, rt):
        at.SetTypeNode(a, n, rt)
    end
    ps_set_a(a, n, parse_block(p, a))
    p_fin(p, a, n)
    ret n
end

func parse_params(p &: Ps, a &: at.Ast, fn: int):
    if p_at(p, tok.TK_RPAREN):
        ret
    end
    mut go := true
    until go:
        param := p_mk(p, a, at.AST_PARAM)
        pname := parse_decl_name(p)
        at.SetName(a, param, pname)
        if pname.len() == 0:
            ret
        end
        if p_match(p, tok.TK_AMP):
            mut pn := at.Get(a, param)
            pn.is_ref = true
            at.Put(a, param, pn)
        end
        if p_at(p, tok.TK_COLON):
            at.SetTypeNode(a, param, parse_type_anno(p, a))
        end
        if p_match(p, tok.TK_ASSIGN):
            ps_set_a(a, param, parse_expr(p, a))
        end
        p_fin(p, a, param)
        at.AddChild(a, fn, param)
        go = p_list_next(p, tok.TK_RPAREN)
    end
end

func finish_untyped_params(p &: Ps, a &: at.Ast, fn: int, allow_untyped: bool):
    mut next_ix := 0
    count := at.ChildCount(a, fn)
    repeat count in i:
        pid := at.Child(a, fn, i)
        pnode := at.Get(a, pid)
        if pnode.kind != at.AST_PARAM or pnode.ty != 0:
            continue
        end
        if not allow_untyped:
            p_error(p, "method and interface parameters must have explicit types")
            ret
        end
        tn := "__T" + next_ix
        next_ix += 1
        t := at.NewNode(a, at.AST_TYPE)
        at.SetSpan(
            a, t, pnode.begin_line, pnode.begin_col, pnode.begin_index, pnode.end_line, pnode.end_col, pnode.end_index, pnode.length
        )
        at.SetName(a, t, tn)
        at.SetTypeNode(a, pid, t)
        at.AddTyparam(a, fn, tn, "")
    end
end

func parse_top_level(p &: Ps, a &: at.Ast): int:
    p_rule(p, "top_level")

    mut mods := parse_fn_mods(p)
    is_pub := mods.is_pub
    reject_mut_mod(p, mods, "'mut func' is only allowed on methods inside a struct; a top-level function has no 'this'")
    check_fn_mods_target(p, mods)
    mut n := 0
    k := p_peek(p).kind
    if k == tok.TK_KW_TYPE:
        n = parse_type_alias(p, a)
    else k == tok.TK_KW_CONST:
        n = parse_const(p, a)
    else k == tok.TK_KW_ENUM:
        n = parse_enum(p, a)
    else k == tok.TK_KW_STRUCT:
        n = parse_struct(p, a)
    else k == tok.TK_KW_INTERFACE:
        n = parse_interface(p, a)
    else k == tok.TK_KW_IMPL:
        n = parse_impl(p, a)
    else k == tok.TK_KW_FUNC:
        n = parse_function(p, a, true)
    else k == tok.TK_KW_LAYOUT:
        if is_pub:
            p_error(p, "'pub' cannot be applied to a layout block")
        end
        ret parse_layout_block(p, a)
    else k == tok.TK_KW_COMPONENT:
        if is_pub:
            p_error(p, "'pub' cannot be applied to a component")
        end
        ret parse_component(p, a)
    else k == tok.TK_KW_MUT:
        n = parse_var_decl(p, a)
        p_term(p)
    else k == tok.TK_IDENT:
        n = parse_bare_var_decl(p, a)
        p_term(p)
    else k == tok.TK_KW_PACKAGE:
        p_error(p, "'package' can be declared only once, and only as the very first statement in the file")
        if not p_at_eof(p):
            p_advance(p)
        end
        ret 0
    else:
        if is_pub:
            p_error(p, "expected a definition after 'pub'")
        else:
            p_error(p, "expected a top-level definition")
        end
        if not p_at_eof(p):
            p_advance(p)
        end
        ret 0
    end
    apply_fn_mods(a, n, mods)
    ret n
end
