package parser

import str

include tok "../token.salam"
include at "../ast.salam"

func demote_auto_type(a &: at.Ast, id: int):
    n := at.Get(a, id)
    if n.ty == 0:
        ret
    end
    t := at.Get(a, n.ty)
    if t.name.len() == 0 or t.is_pointer or t.is_dyn:
        ret
    end
    if t.list.len() != 0 or at.Dims(a, t.ext).len() != 0:
        ret
    end
    if str.Equals(t.name, "auto") or str.Equals(t.name, "\xD8\xAE\xD9\x88\xD8\xAF\xDA\xA9\xD8\xA7\xD8\xB1") or str.Equals(t.name, "\xD8\xAA\xD9\x84\xD9\x82\xD8\xA7\xD8\xA6\xD9\x8A"):
        at.SetTypeNode(a, id, 0)
    end
end

func parse_decl_tail(p &: Ps, a &: at.Ast, n: int):
    if p_match(p, tok.TK_COLON_ASSIGN):
        ps_set_a(a, n, parse_expr(p, a))
        ret
    end
    if p_at(p, tok.TK_COLON):
        at.SetTypeNode(a, n, parse_type_anno(p, a))
        demote_auto_type(a, n)
        if p_at(p, tok.TK_ASSIGN):
            p_error(p, "declarations with a type annotation were removed; use 'name := value' (or 'name := value as Type')")
            p_advance(p)
            ps_set_a(a, n, parse_expr(p, a))
        end
        ret
    end
    if p_at(p, tok.TK_ASSIGN):
        p_error(p, "use ':=' to declare a new variable ('name := value'); '=' only assigns to an existing one")
        p_advance(p)
        ps_set_a(a, n, parse_expr(p, a))
        ret
    end
    p_error(p, "expected ':=' and an initializer, or ': Type' for an uninitialized declaration")
end

func parse_var_decl(p &: Ps, a &: at.Ast): int:
    p_rule(p, "var_decl")
    n := p_mk(p, a, at.AST_VAR_DECL)
    is_mut := p_match(p, tok.TK_KW_MUT)
    nm := parse_decl_name(p)
    mut nn := at.Get(a, n)
    nn.is_mut = is_mut
    nn.name = nm
    if nm.len() == 0:
        nn.name = "<error>"
    end
    at.Put(a, n, nn)
    parse_decl_tail(p, a, n)
    p_fin(p, a, n)
    ret n
end

func parse_bare_var_decl(p &: Ps, a &: at.Ast): int:
    p_rule(p, "bare_var_decl")
    n := p_mk(p, a, at.AST_VAR_DECL)
    nm := parse_decl_name(p)
    mut nn := at.Get(a, n)
    nn.is_mut = false
    nn.name = nm
    if nm.len() == 0:
        nn.name = "<error>"
    end
    at.Put(a, n, nn)
    parse_decl_tail(p, a, n)
    p_fin(p, a, n)
    ret n
end

func p_destructure_ahead(p &: Ps): bool:
    mut k := 0
    mut names := 0
    until true:
        if p_peekn(p, k).kind == tok.TK_KW_MUT:
            k += 1
        end
        line := p_peekn(p, k).begin_line
        mut m := 0
        until p_peekn(p, k + m).kind == tok.TK_IDENT and p_peekn(p, k + m).begin_line == line:
            m += 1
        end
        if m == 0:
            ret false
        end
        k += m
        names += 1
        if p_peekn(p, k).kind == tok.TK_COMMA:
            k += 1
        else:
            break
        end
    end
    ret names >= 2 and p_peekn(p, k).kind == tok.TK_COLON_ASSIGN
end

func parse_destructure(p &: Ps, a &: at.Ast): int:
    p_rule(p, "destructure_decl")
    n := p_mk(p, a, at.AST_DESTRUCT)
    mut go := true
    until go:
        d := p_mk(p, a, at.AST_VAR_DECL)
        is_mut := p_match(p, tok.TK_KW_MUT)
        nm := parse_decl_name(p)
        mut dv := at.Get(a, d)
        dv.is_mut = is_mut
        dv.name = nm
        if nm.len() == 0:
            dv.name = "<error>"
        end
        at.Put(a, d, dv)
        p_fin(p, a, d)
        at.AddChild(a, n, d)
        go = p_match(p, tok.TK_COMMA)
    end
    p_expect(p, tok.TK_COLON_ASSIGN, "':=' and a value after the names, as in 'q, r := divmod(a, b)'")
    ps_set_a(a, n, parse_expr_or_tuple(p, a))
    p_fin(p, a, n)
    ret n
end

func p_is_assign_target(a &: at.Ast, e: int): bool:
    k := at.KindOf(a, e)
    ret k == at.AST_IDENTIFIER or k == at.AST_MEMBER or k == at.AST_INDEX
end

func parse_destructure_assign(p &: Ps, a &: at.Ast, first: int): int:
    p_rule(p, "destructure_assign")
    n := mk_from_node(a, at.AST_DESTRUCT, first)
    at.SetOp(a, n, tok.TK_ASSIGN)
    at.AddChild(a, n, first)
    until p_match(p, tok.TK_COMMA):
        t := parse_expr_bp(p, a, 11)
        if not p_is_assign_target(a, t):
            p_error(p, "only a name, a field or an element can receive a value in 'a, b = x, y'")
        end
        at.AddChild(a, n, t)
    end
    p_expect(p, tok.TK_ASSIGN, "'=' and the new values after the targets, as in 'a, b = b, a'")
    ps_set_a(a, n, parse_expr_or_tuple(p, a))
    p_fin(p, a, n)
    ret n
end
