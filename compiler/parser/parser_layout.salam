package parser

import gui.style
import str

include tok "../token.salam"
include at "../ast.salam"

k_state_en := ["hover", "focus within", "focus", "active", "disabled", "checked", "invalid", "placeholder", "selection"]

k_state_fa := ["اشاره", "تمرکز درون", "تمرکز", "فشردن", "غیرفعال", "تیک\xE2\x80\x8Cخورده", "نامعتبر", "جای\xE2\x80\x8Cنوشته", "گزینش"]

func layout_body(p &: Ps, a &: at.Ast, parent: int):
    layout_body_ex(p, a, parent, false)
end

func layout_decl_ahead(p &: Ps): bool:
    if not p_at(p, tok.TK_IDENT):
        ret false
    end
    mut k := 1
    until p_peekn(p, k).kind == tok.TK_IDENT:
        k++
    end
    ret p_peekn(p, k).kind == tok.TK_COLON_ASSIGN
end

func state_loose(name: str): str:
    mut t := str.Replace(name, "\xE2\x80\x8C", "")
    t = str.Replace(t, "\xD9\x8A", "\xDB\x8C")
    t = str.Replace(t, "\xD9\x83", "\xDA\xA9")
    t = str.Replace(t, " ", "")
    t = str.Replace(t, "_", "")
    ret str.Replace(t, "-", "")
end

func state_block_name(name: str): str:
    key := state_loose(name)
    repeat len(k_state_en) in i:
        if str.Equals(key, state_loose(k_state_en[i])):
            ret k_state_en[i]
        end
        if str.Equals(key, state_loose(k_state_fa[i])):
            ret k_state_fa[i]
        end
    end
    ret ""
end

func state_has_prefix(name: str): bool:
    repeat len(k_state_en) in i:
        mut w := k_state_en[i]
        repeat 2:
            wl := str.Len(w)
            if str.Len(name) > wl + 1 and str.StartsWith(name, w):
                sep := byte_at(name, wl)
                if sep == 95 or sep == 32 or sep == 45:
                    ret true
                end
            end
            w = k_state_fa[i]
        end
    end
    ret false
end

func state_block_lower(a &: at.Ast, parent: int, el: int): bool:
    canon := state_block_name(at.Get(a, el).name)
    if str.Len(canon) == 0:
        ret false
    end
    at.SetName(a, el, canon)
    repeat at.ChildCount(a, el) in i:
        cid := at.Child(a, el, i)
        if at.KindOf(a, cid) != at.AST_LAYOUT_ATTR or state_has_prefix(at.Get(a, cid).name):
            ret false
        end
    end
    repeat at.ChildCount(a, el) in j:
        cid := at.Child(a, el, j)
        at.SetName(a, cid, canon + " " + at.Get(a, cid).name)
        at.AddChild(a, parent, cid)
    end
    ret true
end

func ifs_key(name: str): str:
    ret str.Lower(str.Replace(str.Replace(str.Trim(name), "_", " "), "-", " "))
end

func ifs_find(a &: at.Ast, kept: Vector<int>, key: str): int:
    repeat kept.Len() in j:
        kid := kept.Get(j)
        if at.KindOf(a, kid) == at.AST_LAYOUT_ATTR and str.Equals(ifs_key(at.Get(a, kid).name), key):
            ret kid
        end
    end
    ret 0
end

func ifs_declared_after(a &: at.Ast, parent: int, from: int, key: str): bool:
    repeat at.ChildCount(a, parent) in i:
        if i <= from:
            continue
        end
        oid := at.Child(a, parent, i)
        if at.KindOf(a, oid) == at.AST_LAYOUT_ATTR and str.Equals(ifs_key(at.Get(a, oid).name), key):
            ret true
        end
    end
    ret false
end

func ifs_ternary(a &: at.Ast, cond: int, thenv: int, elsev: int): int:
    n := mk_from_node(a, at.AST_TERNARY, cond)
    mut m := at.Get(a, n)
    m.a = at.Clone(a, cond)
    m.b = thenv
    m.c = elsev
    at.Put(a, n, m)
    ret n
end

func ifs_empty(a &: at.Ast, from: int): int:
    lit := mk_from_node(a, at.AST_LITERAL, from)
    at.SetOp(a, lit, tok.TK_STRING)
    mut tv := tok.ValueNone()
    tv.kind = tok.TV_STRING
    tv.sval = ""
    at.SetName(a, lit, "")
    at.SetTokenValue(a, lit, tv)
    mut ln := at.Get(a, lit)
    ln.synthetic = true
    at.Put(a, lit, ln)
    ret lit
end

func if_state_strip(name: str): str:
    prefixes := ["hover", "focus within", "focus", "active", "disabled", "checked", "invalid", "placeholder", "selection", "اشاره", "تمرکز درون", "تمرکز", "فشردن", "غیرفعال", "نامعتبر", "گزینش"]
    key := ifs_key(name)
    repeat len(prefixes) in i:
        pk := ifs_key(prefixes[i])
        if str.Len(key) > str.Len(pk) + 1 and str.StartsWith(key, pk + " "):
            ret str.Substr(key, str.Len(pk) + 1, str.Len(key) - str.Len(pk) - 1)
        end
    end
    ret key
end

func if_attr_is_style(a &: at.Ast, id: int): bool:
    if at.KindOf(a, id) != at.AST_LAYOUT_ATTR:
        ret false
    end
    ret style.PropByName(if_state_strip(at.Get(a, id).name)) >= 0
end

func if_block_style(a &: at.Ast, blk: int, nattr &: int): bool:
    repeat at.ChildCount(a, blk) in i:
        if not if_attr_is_style(a, at.Child(a, blk, i)):
            ret false
        end
        nattr++
    end
    ret true
end

func if_chain_style(a &: at.Ast, n: int): bool:
    mut nattr := 0
    mut cur := n
    until cur != 0:
        c := at.Get(a, cur)
        if not if_block_style(a, c.b, nattr):
            ret false
        end
        if c.c == 0:
            break
        end
        if at.KindOf(a, c.c) == at.AST_IF:
            cur = c.c
        else:
            if not if_block_style(a, c.c, nattr):
                ret false
            end
            break
        end
    end
    ret nattr > 0
end

func if_block_attr(a &: at.Ast, blk: int, key: str): int:
    repeat at.ChildCount(a, blk) in i:
        cid := at.Child(a, blk, i)
        if str.Equals(ifs_key(at.Get(a, cid).name), key):
            ret cid
        end
    end
    ret 0
end

func if_chain_has(a &: at.Ast, n: int, key: str): bool:
    mut cur := n
    until cur != 0:
        c := at.Get(a, cur)
        if if_block_attr(a, c.b, key) != 0:
            ret true
        end
        if c.c == 0:
            break
        end
        if at.KindOf(a, c.c) == at.AST_IF:
            cur = c.c
        else:
            ret if_block_attr(a, c.c, key) != 0
        end
    end
    ret false
end

func if_chain_value(a &: at.Ast, n: int, key: str, basev: int): int:
    if n == 0:
        ret basev != 0 ? at.Clone(a, basev) : 0
    end
    c := at.Get(a, n)
    if not if_chain_has(a, n, key):
        ret basev != 0 ? at.Clone(a, basev) : ifs_empty(a, c.a)
    end
    mut rest := 0
    if c.c == 0:
        rest = basev != 0 ? at.Clone(a, basev) : ifs_empty(a, c.a)
    else at.KindOf(a, c.c) == at.AST_IF:
        rest = if_chain_value(a, c.c, key, basev)
    else:
        hit := if_block_attr(a, c.c, key)
        if hit != 0:
            rest = at.Get(a, hit).a
        else:
            rest = basev != 0 ? at.Clone(a, basev) : ifs_empty(a, c.a)
        end
    end
    hit2 := if_block_attr(a, c.b, key)
    mut thenv := 0
    if hit2 != 0:
        thenv = at.Get(a, hit2).a
    else:
        thenv = basev != 0 ? at.Clone(a, basev) : ifs_empty(a, c.a)
    end
    ret ifs_ternary(a, c.a, thenv, rest)
end

func if_chain_keys(a &: at.Ast, n: int, keys &: Vector<str>, firsts &: Vector<int>):
    mut cur := n
    until cur != 0:
        c := at.Get(a, cur)
        mut blocks := Vector {} as Vector<int>
        blocks.Push(c.b)
        if c.c != 0 and at.KindOf(a, c.c) != at.AST_IF:
            blocks.Push(c.c)
        end
        repeat blocks.Len() in bi:
            repeat at.ChildCount(a, blocks.Get(bi)) in i:
                cid := at.Child(a, blocks.Get(bi), i)
                k := ifs_key(at.Get(a, cid).name)
                mut seen := false
                repeat keys.Len() in q:
                    if str.Equals(keys.Get(q), k):
                        seen = true
                    end
                end
                if not seen:
                    keys.Push(k)
                    firsts.Push(cid)
                end
            end
        end
        if c.c != 0 and at.KindOf(a, c.c) == at.AST_IF:
            cur = c.c
        else:
            cur = 0
        end
        blocks.Free()
    end
end

func if_block_mix(a &: at.Ast, blk: int, attrs &: bool, kids &: bool):
    repeat at.ChildCount(a, blk) in i:
        cid := at.Child(a, blk, i)
        k := at.KindOf(a, cid)
        if k == at.AST_LAYOUT_ATTR:
            if if_attr_is_style(a, cid):
                attrs = true
            end
        else k == at.AST_LAYOUT_ELEMENT or k == at.AST_EACH or k == at.AST_IF:
            kids = true
        end
    end
end

func if_std_prefix(name: str): str:
    words := str.Fields(if_state_strip(name))
    defer words.Free()
    tail := words.Len() > 0 and str.Len(words.Get(0)) > 0 and byte_at(words.Get(0), 0) >= 128
    mut k := words.Len() - 1
    until k >= 1:
        mut cand := ""
        repeat k in i:
            if i > 0:
                cand += " "
            end
            cand += tail ? words.Get(words.Len() - k + i) : words.Get(i)
        end
        if style.PropByName(cand) >= 0:
            ret cand
        end
        k--
    end
    ret ""
end

func if_legacy_attrs(p &: Ps, a &: at.Ast, n: int):
    mut cur := n
    until cur != 0:
        c := at.Get(a, cur)
        mut blocks := Vector {} as Vector<int>
        blocks.Push(c.b)
        if c.c != 0 and at.KindOf(a, c.c) != at.AST_IF:
            blocks.Push(c.c)
        end
        each blk in blocks:
            if blk == 0:
                continue
            end
            repeat at.ChildCount(a, blk) in i:
                cid := at.Child(a, blk, i)
                if at.KindOf(a, cid) != at.AST_LAYOUT_ATTR or if_attr_is_style(a, cid):
                    continue
                end
                an := at.Get(a, cid)
                sug := if_std_prefix(an.name)
                if str.Len(sug) == 0:
                    continue
                end
                lg.LogAt(
                    p.lgr, lg.PH_PARSER, lg.LOG_ERROR, p.file, an.begin_line as int, an.begin_col as int, co.Format2(
                        i18.Tr("E255: '%s' is not part of the Salam style standard, so an 'if' cannot change it; use '%s'"),
                        co.ArgStr(an.name), co.ArgStr(sug)
                    )
                )
                p.had_error = true
            end
        end
        blocks.Free()
        if c.c != 0 and at.KindOf(a, c.c) == at.AST_IF:
            cur = c.c
        else:
            cur = 0
        end
    end
end

func if_chain_mixed(a &: at.Ast, n: int): bool:
    mut attrs := false
    mut kids := false
    mut cur := n
    until cur != 0:
        c := at.Get(a, cur)
        if_block_mix(a, c.b, attrs, kids)
        if c.c == 0:
            break
        end
        if at.KindOf(a, c.c) == at.AST_IF:
            cur = c.c
        else:
            if_block_mix(a, c.c, attrs, kids)
            break
        end
    end
    ret attrs and kids
end

func if_attach_block(a &: at.Ast, blk: int, key: str, holder: int):
    repeat at.ChildCount(a, blk) in i:
        cid := at.Child(a, blk, i)
        if cid != holder and str.Equals(ifs_key(at.Get(a, cid).name), key):
            at.AddChild(a, holder, cid)
        end
    end
end

func if_chain_attach(a &: at.Ast, n: int, key: str, holder: int):
    mut cur := n
    until cur != 0:
        c := at.Get(a, cur)
        if_attach_block(a, c.b, key, holder)
        if c.c == 0:
            break
        end
        if at.KindOf(a, c.c) == at.AST_IF:
            cur = c.c
        else:
            if_attach_block(a, c.c, key, holder)
            break
        end
    end
end

func ifs_lower(p &: Ps, a &: at.Ast, parent: int):
    repeat at.ChildCount(a, parent) in mi:
        mid := at.Child(a, parent, mi)
        if at.KindOf(a, mid) == at.AST_IF and not if_chain_style(a, mid):
            env_revert_chain(a, mid, p.file)
            if_legacy_attrs(p, a, mid)
        end
        if at.KindOf(a, mid) == at.AST_IF and if_chain_mixed(a, mid):
            mn := at.Get(a, mid)
            lg.LogAt(
                p.lgr, lg.PH_PARSER, lg.LOG_ERROR, p.file, mn.begin_line as int, mn.begin_col as int, i18.Tr("E175: an 'if' cannot hold style attributes together with elements; split it into two 'if' blocks")
            )
            p.had_error = true
        end
    end
    mut found := false
    repeat at.ChildCount(a, parent) in i:
        cid0 := at.Child(a, parent, i)
        if at.KindOf(a, cid0) == at.AST_IF and if_chain_style(a, cid0):
            found = true
        end
    end
    if not found:
        ret
    end
    mut kept := Vector {} as Vector<int>
    repeat at.ChildCount(a, parent) in j:
        cid := at.Child(a, parent, j)
        if at.KindOf(a, cid) != at.AST_IF or not if_chain_style(a, cid):
            kept.Push(cid)
            continue
        end
        mut keys := Vector {} as Vector<str>
        mut firsts := Vector {} as Vector<int>
        if_chain_keys(a, cid, keys, firsts)
        env_note_chain(a, cid)
        repeat keys.Len() in k:
            bid := ifs_find(a, kept, keys.Get(k))
            if bid == 0 and ifs_declared_after(a, parent, j, keys.Get(k)):
                continue
            end
            basev := bid != 0 ? at.Get(a, bid).a : 0
            result := if_chain_value(a, cid, keys.Get(k), basev)
            if bid != 0:
                mut bn := at.Get(a, bid)
                bn.a = result
                at.Put(a, bid, bn)
                if_chain_attach(a, cid, keys.Get(k), bid)
            else:
                gid := firsts.Get(k)
                mut gn := at.Get(a, gid)
                gn.a = result
                at.Put(a, gid, gn)
                kept.Push(gid)
                if_chain_attach(a, cid, keys.Get(k), gid)
            end
        end
        keys.Free()
        firsts.Free()
    end
    mut pn := at.Get(a, parent)
    pn.list = kept
    at.Put(a, parent, pn)
end

func layout_body_ex(p &: Ps, a &: at.Ast, parent: int, stop_else: bool):
    layout_body_loop(p, a, parent, stop_else)
    ifs_lower(p, a, parent)
end

func layout_body_loop(p &: Ps, a &: at.Ast, parent: int, stop_else: bool):
    until not p_at(p, tok.TK_KW_END) and not p_at_eof(p) and not (stop_else and p_at(p, tok.TK_KW_ELSE)):
        before := p.pos
        p_skip_terminators(p)
        if p_at(p, tok.TK_KW_END) or p_at_eof(p) or (stop_else and p_at(p, tok.TK_KW_ELSE)):
            break
        end
        if p_at(p, tok.TK_KW_IF):
            n := p_mk(p, a, at.AST_IF)
            p_advance(p)
            layout_if_tail(p, a, n)
            at.AddChild(a, parent, n)
        else p_at(p, tok.TK_KW_EACH):
            at.AddChild(a, parent, layout_each(p, a))
        else p_at(p, tok.TK_KW_ELSE):
            p_error(p, "'else' without a matching 'if' in layout")
            p_advance(p)
        else p_at(p, tok.TK_LAYOUT_ELEMENT):
            el := layout_element(p, a)
            if not state_block_lower(a, parent, el):
                at.AddChild(a, parent, el)
            end
        else p_at(p, tok.TK_LAYOUT_ATTR_NAME):
            at.AddChild(a, parent, layout_attribute(p, a))
        else p_at(p, tok.TK_KW_MUT) or layout_decl_ahead(p):
            vd := parse_var_decl(p, a)
            env_reserved_node(p, a, vd)
            at.AddChild(a, parent, vd)
            p_skip_terminators(p)
        else:
            p_error(p, "unexpected token inside page block")
            if not p_at_eof(p):
                p_advance(p)
            end
        end
        if p.panic:
            p_sync(p)
        end
        if not p_ensure_progress(p, before):
            break
        end
    end
end

func layout_if_tail(p &: Ps, a &: at.Ast, n: int):
    env_rewrite_cond(p)
    ps_set_a(a, n, parse_expr(p, a))
    p_expect(p, tok.TK_COLON, "':' after the layout 'if' condition")
    p_skip_terminators(p)
    then_b := p_mk(p, a, at.AST_BLOCK)
    layout_body_ex(p, a, then_b, true)
    p_fin(p, a, then_b)
    ps_set_b(a, n, then_b)
    if p_match(p, tok.TK_KW_ELSE):
        if p_match(p, tok.TK_COLON):
            p_skip_terminators(p)
            else_b := p_mk(p, a, at.AST_BLOCK)
            layout_body_ex(p, a, else_b, false)
            p_fin(p, a, else_b)
            ps_set_c(a, n, else_b)
            p_expect(p, tok.TK_KW_END, "'end' to close the layout 'if'")
        else:
            _chained := p_match(p, tok.TK_KW_IF)
            m := p_mk(p, a, at.AST_IF)
            layout_if_tail(p, a, m)
            ps_set_c(a, n, m)
        end
    else:
        p_expect(p, tok.TK_KW_END, "'end' to close the layout 'if'")
    end
    p_fin(p, a, n)
    p_skip_terminators(p)
end

func layout_each(p &: Ps, a &: at.Ast): int:
    n := p_mk(p, a, at.AST_EACH)
    p_advance(p)
    if p_at(p, tok.TK_IDENT) and p_peek2(p).kind == tok.TK_COMMA:
        kn := p_mk(p, a, at.AST_IDENTIFIER)
        at.SetName(a, kn, p_peek(p).lexeme)
        p_advance(p)
        p_fin(p, a, kn)
        ps_set_c(a, n, kn)
        p_advance(p)
    end
    at.SetName(a, n, p_name(p, "expected a name after 'each' in layout"))
    env_reserved_node(p, a, n)
    if at.Get(a, n).c != 0:
        env_reserved_node(p, a, at.Get(a, n).c)
    end
    p_expect(p, tok.TK_KW_IN, "'in' before the collection, as in 'each item in items:'")
    ps_set_a(a, n, parse_expr(p, a))
    p_expect(p, tok.TK_COLON, "':' after the layout 'each' header")
    p_skip_terminators(p)
    body := p_mk(p, a, at.AST_BLOCK)
    layout_body_ex(p, a, body, false)
    p_fin(p, a, body)
    ps_set_b(a, n, body)
    p_expect(p, tok.TK_KW_END, "'end' to close the layout 'each'")
    p_fin(p, a, n)
    p_skip_terminators(p)
    ret n
end

func layout_element(p &: Ps, a &: at.Ast): int:
    p_rule(p, "layout_element")
    n := p_mk(p, a, at.AST_LAYOUT_ELEMENT)

    if not p_recurse_enter(p, "layout nested too deeply"):
        ret n
    end
    at.SetName(a, n, p_peek(p).lexeme)
    p_advance(p)
    p_expect(p, tok.TK_COLON, "':' after layout element name")
    p_skip_terminators(p)
    layout_body(p, a, n)
    p_expect(p, tok.TK_KW_END, "'end' to close layout element")
    p_fin(p, a, n)
    p_skip_terminators(p)
    p_recurse_leave(p)
    ret n
end

func layout_value_words(p &: Ps):
    k := p_peek(p).kind
    mut retag := false
    if k == tok.TK_KW_REPEAT and p_peek2(p).kind == tok.TK_LPAREN:
        retag = true
    end
    if k == tok.TK_NOT and p_peek2(p).kind == tok.TK_IDENT and str.Equals(p_peek2(p).lexeme, "allowed"):
        retag = true
    end
    if not retag:
        ret
    end
    i := skip_comments_from(p, p.pos)
    mut t := p.toks.toks.Get(i)
    t.kind = tok.TK_IDENT
    p.toks.toks.Set(i, t)
end

func layout_attribute(p &: Ps, a &: at.Ast): int:
    p_rule(p, "layout_attribute")
    n := p_mk(p, a, at.AST_LAYOUT_ATTR)
    at.SetName(a, n, p_peek(p).lexeme)
    p_advance(p)
    p_expect(p, tok.TK_ASSIGN, "'=' after layout attribute name")
    layout_value_words(p)
    first := parse_expr(p, a)
    if p_at(p, tok.TK_COMMA):
        lst := mk_from_node(a, at.AST_TUPLE, first)
        at.AddChild(a, lst, first)
        until p_match(p, tok.TK_COMMA):
            layout_value_words(p)
            at.AddChild(a, lst, parse_expr(p, a))
        end
        p_fin(p, a, lst)
        ps_set_a(a, n, lst)
    else:
        ps_set_a(a, n, first)
    end
    p_fin(p, a, n)
    p_skip_terminators(p)
    ret n
end

func parse_layout_block(p &: Ps, a &: at.Ast): int:
    p_rule(p, "layout_block")
    n := p_mk(p, a, at.AST_LAYOUT_BLOCK)
    p_advance(p)
    if not p_at(p, tok.TK_COLON):
        at.SetName(a, n, parse_decl_name(p))
        params := p_mk(p, a, at.AST_BLOCK)
        if p_match(p, tok.TK_LPAREN):
            parse_params(p, a, params)
            p_expect(p, tok.TK_RPAREN, "')' after layout parameters")
            env_reserved_params(p, a, params)
        end
        p_fin(p, a, params)
        ps_set_b(a, n, params)
    end
    p_expect(p, tok.TK_COLON, "':' after 'page'")
    p_skip_terminators(p)
    layout_body(p, a, n)
    p_expect(p, tok.TK_KW_END, "'end' to close page block")
    p_fin(p, a, n)
    ret n
end

func parse_component(p &: Ps, a &: at.Ast): int:
    p_rule(p, "component")
    n := p_mk(p, a, at.AST_LAYOUT_COMPONENT)
    p_advance(p)
    at.SetName(a, n, parse_decl_name(p))
    if p_match(p, tok.TK_LPAREN):
        parse_params(p, a, n)
        p_expect(p, tok.TK_RPAREN, "')' after component parameters")
        env_reserved_params(p, a, n)
    end
    p_expect(p, tok.TK_COLON, "':' after component header")
    p_skip_terminators(p)
    body := p_mk(p, a, at.AST_BLOCK)
    layout_body(p, a, body)
    p_expect(p, tok.TK_KW_END, "'end' to close component")
    p_fin(p, a, body)
    ps_set_a(a, n, body)
    p_fin(p, a, n)
    ret n
end
