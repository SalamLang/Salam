package parser

import str

include tok "../token.salam"
include at "../ast.salam"

func parse_array_dims(p &: Ps, a &: at.Ast, n: int):
    until p_match(p, tok.TK_LBRACKET):
        p_skip_terminators(p)

        if p_at(p, tok.TK_COLON):
            p_advance(p)
            p_skip_terminators(p)
            p_expect(p, tok.TK_RBRACKET, "']' to close slice type 'T[]'")
            mut nn := at.Get(a, n)
            nn.is_slice = true
            at.Put(a, n, nn)
            ret
        end
        if p_at(p, tok.TK_RBRACKET):
            p_advance(p)
            mut en := at.Get(a, n)
            en.is_slice = true
            at.Put(a, n, en)
            ret
        end
        dim := parse_expr(p, a)
        p_skip_terminators(p)
        p_expect(p, tok.TK_RBRACKET, "']' in array type")
        at.AddDim(a, n, dim)
    end
end

func p_star_pair_is_power(p &: Ps): bool:
    if not p_at(p, tok.TK_STAR) or p_star_pair_kind(p) != tok.TK_POWER:
        ret false
    end
    k := p_peekn(p, 2).kind
    ret k == tok.TK_INT or k == tok.TK_FLOAT or k == tok.TK_IDENT or k == tok.TK_LPAREN or k == tok.TK_MINUS
end

func parse_ptr_suffix(p &: Ps, a &: at.Ast, n: int):
    until not p_star_pair_is_power(p) and p_match(p, tok.TK_STAR):
        mut nn := at.Get(a, n)
        nn.is_pointer = true
        nn.ptr_depth += 1
        at.Put(a, n, nn)
    end
end

func p_at_star_run(p &: Ps, k: int): bool:
    ret p_peekn(p, k).kind == tok.TK_STAR
end

func parse_ptr_and_dims(p &: Ps, a &: at.Ast, n: int):
    until p_at_star_run(p, 0):
        mut k := 1
        until p_at_star_run(p, k):
            k += 1
        end
        if p_peekn(p, k).kind != tok.TK_LBRACKET:
            break
        end
        mut nn := at.Get(a, n)
        nn.elem_ptr_depth += 1
        at.Put(a, n, nn)
        p_advance(p)
    end
    parse_array_dims(p, a, n)
    parse_ptr_suffix(p, a, n)
end

func parse_type_dyn(p &: Ps, a &: at.Ast, n: int): int:
    p_advance(p)
    mut nn := at.Get(a, n)
    nn.is_dyn = true
    nn.name = p_peek(p).lexeme
    at.Put(a, n, nn)
    p_advance(p)
    if p_at(p, tok.TK_DOT) and p_peek2(p).kind == tok.TK_IDENT:
        p_advance(p)
        at.SetName(a, n, nn.name + "." + p_peek(p).lexeme)
        p_advance(p)
    end
    parse_ptr_and_dims(p, a, n)
    p_fin(p, a, n)
    ret n
end

func parse_type_func(p &: Ps, a &: at.Ast, n: int): int:
    at.SetName(a, n, "func")
    p_advance(p)
    p_expect(p, tok.TK_LPAREN, "'(' in function type")
    if not p_at(p, tok.TK_RPAREN):
        mut go := true
        until go:
            at.AddChild(a, n, parse_type(p, a))
            go = p_match(p, tok.TK_COMMA)
        end
    end
    p_expect(p, tok.TK_RPAREN, "')' in function type")
    if p_at(p, tok.TK_IDENT) or p_at(p, tok.TK_KW_FUNC):
        at.SetTypeNode(a, n, parse_type(p, a))
    end
    parse_ptr_suffix(p, a, n)
    p_fin(p, a, n)
    ret n
end

func pkg_words_before_dot(p &: Ps): int:
    line := p_peek(p).begin_line
    mut k := 0
    until k < 8 and p_peekn(p, k).kind == tok.TK_IDENT and p_peekn(p, k).begin_line == line:
        k += 1
    end
    if k > 0 and p_peekn(p, k).kind == tok.TK_DOT:
        ret k
    end
    ret 0
end

func parse_type_named(p &: Ps, a &: at.Ast, n: int): int:
    mut nm := p_name(p, "expected type name")
    extra := pkg_words_before_dot(p)
    repeat extra:
        nm = nm + " " + p_peek(p).lexeme
        p_advance(p)
    end
    at.SetName(a, n, nm)
    if nm.len() == 0:
        ret n
    end

    if p_at(p, tok.TK_DOT) and tok.IsKeyword(p_peek2(p).kind):
        p_advance(p)
        at.SetName(a, n, nm + "." + p_member_name(p, "expected a type name after '.'"))
    else p_at(p, tok.TK_DOT) and p_peek2(p).kind == tok.TK_IDENT:
        p_advance(p)
        line := p_peek(p).begin_line
        mut tname := p_peek(p).lexeme
        p_advance(p)
        until p_at(p, tok.TK_IDENT) and p_peek(p).begin_line == line and (p.ret_type or p_peek2(p).kind != tok.TK_COLON):
            tname = tname + " " + p_peek(p).lexeme
            p_advance(p)
        end
        at.SetName(a, n, nm + "." + tname)
    end

    if p_at(p, tok.TK_LT):
        p_advance(p)
        at.AddChild(a, n, parse_type(p, a))
        until p_match(p, tok.TK_COMMA):
            at.AddChild(a, n, parse_type(p, a))
        end
        p_close_angle(p, "'>' to close type arguments")
    end
    parse_ptr_and_dims(p, a, n)
    p_fin(p, a, n)
    ret n
end

func parse_type(p &: Ps, a &: at.Ast): int:
    p_rule(p, "type")

    if not p_recurse_enter(p, "type nested too deeply"):
        ret p_mk(p, a, at.AST_TYPE)
    end
    mut n := p_mk(p, a, at.AST_TYPE)
    if p_at(p, tok.TK_KW_EXTERN) and p_peek2(p).kind == tok.TK_KW_FUNC:
        p_advance(p)
        n = parse_type_func(p, a, n)
        mut nn := at.Get(a, n)
        nn.is_extern = true
        at.Put(a, n, nn)
    else p_at(p, tok.TK_IDENT) and (str.Equals(p_peek(p).lexeme, "dyn") or str.Equals(p_peek(p).lexeme, "dynamic")) and p_peek2(p).kind == tok.TK_IDENT:
        n = parse_type_dyn(p, a, n)
    else p_at(p, tok.TK_KW_FUNC):
        n = parse_type_func(p, a, n)
    else:
        n = parse_type_named(p, a, n)
    end
    p_recurse_leave(p)
    ret n
end

func parse_type_anno(p &: Ps, a &: at.Ast): int:
    p_expect(p, tok.TK_COLON, "':' before type")
    ret parse_type(p, a)
end
