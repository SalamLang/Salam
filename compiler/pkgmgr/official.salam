package pkgmgr

import os
import str
import compress
import archive
import net.http

include pth "../sal_path.salam"
include co "../sal_core.salam"

const OFFICIAL_RELEASES := "https://github.com/SalamLang/Salam/releases/download/"

k_pm_official := ["audio", "audio.aiff", "audio.au", "audio.codec", "audio.dsp", "audio.flac", "audio.midi", "audio.mp3", "audio.music", "audio.synth", "audio.tag", "audio.wav", "autograd", "aws", "data", "db.elasticsearch", "db.meilisearch", "db.opensearch", "db.postgres", "db.redis", "db.sqlite", "db.typesense", "excel", "ftp", "gguf", "google", "graphql", "grpc", "llm", "ml", "net.email", "net.http.middleware", "net.http.session", "net.http.swagger", "net.http.validate", "net.http2", "net.proxy", "net.socketio", "net.websocket", "nn", "npy", "onnx", "opencv", "optim", "rpc", "ssh", "telegram", "telegram.bot", "tensor", "webpush", "webview"]

mut g_pm_dev_packages := ""

func find_packages_asset(bare: str): str:
    r := http.GetWith("https://api.github.com/repos/SalamLang/Salam/releases?per_page=50", api_headers())
    if r.status != 200:
        ret ""
    end
    mut urls := Vector {} as Vector<str>
    defer urls.free()
    json_strings_after(r.body, "browser_download_url", urls)
    want := "/salam-packages-" + bare + ".tar.gz"
    repeat urls.len() in i:
        if str.EndsWith(urls.get(i), want):
            ret urls.get(i)
        end
    end
    ret ""
end

pub func IsOfficial(name: str): bool:
    repeat k_pm_official.len() in i:
        if str.Equals(k_pm_official[i], name):
            ret true
        end
    end
    ret false
end

pub func OfficialNames(): Vector<str>:
    mut out := Vector {} as Vector<str>
    repeat k_pm_official.len() in i:
        out.push(k_pm_official[i])
    end
    ret out
end

pub func OfficialVersion(): str:
    v := co.VERSION
    if str.StartsWith(v, "v"):
        ret v
    end
    ret "v" + v
end

pub func SetDevPackages(dir: str):
    g_pm_dev_packages = dir
end

pub func DevPackages(): str:
    e := os.Env("SALAM_PACKAGES")
    if str.Len(e) > 0:
        ret e
    end
    if str.Len(g_pm_dev_packages) > 0 and os.IsDir(g_pm_dev_packages):
        ret g_pm_dev_packages
    end
    ret ""
end

pub func OfficialDir(version: str): str:
    ret pth.PathJoin(PkgRoot(), "salam-packages@" + version)
end

pub func OfficialPackageDir(base: str, name: str): str:
    ret pth.PathJoin(base, str.Replace(name, ".", "/"))
end

pub func EnsureOfficial(version: str, why &: str): str:
    dev := DevPackages()
    if str.Len(dev) > 0:
        ret dev
    end
    if str.Len(version) == 0 or str.Contains(version, "/") or str.Contains(version, "\\") or str.Contains(version, ".."):
        why = "invalid official package version '" + version + "'"
        ret ""
    end
    dest := OfficialDir(version)
    if os.IsDir(dest):
        ret dest
    end
    bare := str.TrimPrefix(version, "v")
    mut releases := os.Env("SALAM_RELEASES_URL")
    if str.Len(releases) == 0:
        releases = OFFICIAL_RELEASES
    end
    mut url := releases + version + "/salam-packages-" + bare + ".tar.gz"
    mut r := http.GetBytesWith(url, api_headers())
    if r.status == 404 and str.Len(os.Env("SALAM_RELEASES_URL")) == 0:
        found := find_packages_asset(bare)
        if str.Len(found) > 0:
            compress.BufFree(r.body)
            url = found
            r = http.GetBytesWith(url, api_headers())
        end
    end
    mut body := r.body
    if r.status != 200:
        compress.BufFree(body)
        why = "cannot download the official packages for Salam " + bare + " from " + url + " (HTTP " + str.FromInt(r.status as i64) + ")"
        ret ""
    end
    mut ok := false
    mut tar := compress.GzipDecompressBuf(body, ok)
    compress.BufFree(body)
    tmp := dest + ".tmp" + str.FromInt(os.Pid() as i64)
    _clean := os.RemoveAll(tmp)
    if not ok or os.MkdirAll(tmp) != 0 or not archive.TarExtractAll(tar.data, tar.len, tmp):
        compress.BufFree(tar)
        _r1 := os.RemoveAll(tmp)
        why = "cannot unpack the official packages from " + url
        ret ""
    end
    compress.BufFree(tar)
    mut root := pth.PathJoin(tmp, "packages")
    if not os.IsDir(root):
        root = tmp
    end
    if os.Move(root, dest) != 0:
        _r2 := os.RemoveAll(tmp)
        why = "cannot move the official packages into " + dest
        ret ""
    end
    _r3 := os.RemoveAll(tmp)
    ret dest
end

pub func OfficialListed(importer_dir: str, name: str): bool:
    if not IsOfficial(name) or ensure_project(importer_dir) != RES_OK:
        ret false
    end
    repeat g_pm_mods.len() in i:
        if str.Equals(g_pm_mods.get(i), name):
            ret true
        end
    end
    ret false
end

pub func PackageBases(importer_dir: str): Vector<str>:
    mut out := Vector {} as Vector<str>
    dev := DevPackages()
    if str.Len(dev) > 0:
        out.push(dev)
    end
    if ensure_project(importer_dir) == RES_OK:
        repeat g_pm_mods.len() in i:
            if IsOfficial(g_pm_mods.get(i)) and str.Len(g_pm_vers.get(i)) > 0:
                d := OfficialDir(g_pm_vers.get(i))
                mut seen := false
                repeat out.len() in j:
                    if str.Equals(out.get(j), d):
                        seen = true
                    end
                end
                if not seen and os.IsDir(d):
                    out.push(d)
                end
            end
        end
    end
    ret out
end
