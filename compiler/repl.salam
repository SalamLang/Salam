// Flat single-file module (see salam/PORTING.md "Layout - FLAT").
// Port of compiler/src/driver/repl.c + repl_session.c (+ repl.h /
// repl_internal.h, declarations only). Package `repl`, alias `rp`.
// Replaces cli.salam's CMD_REPL/CMD_REPL_LAYOUT stub ("the interactive
// REPL is not ported yet (PORT-TODO)").
//
// Scope: driver_repl's whole interactive loop - readline with history and
// in-place line editing, the parser-driven "is this turn finished?" test
// (waits for the line that completes a block before running it), the
// session model repl_session.c holds - definitions bucketed and re-sorted
// into a legal program, statements accumulated in a synthesized main, a
// name typed twice REPLACING what it named before - and the layout-REPL's
// "render a `layout: ... end` block to HTML on every Enter" flow.
//
// The prompt is not a file: definitions arrive in whatever order the user
// thinks of them, statements accumulate one at a time, and a name typed
// twice means "I changed my mind", not "duplicate symbol". Salam compiles
// ahead of time, so a turn is not an eval: the session is re-rendered as
// one whole program and rebuilt on every turn, which is what makes
// bindings survive from one line to the next. Re-running the program also
// re-runs the output of the turns before it, so emit_output() prints only
// what the newest turn added.
//
// C -> Salam decisions:
// - repl_session_t's two parallel malloc'd arrays -> a `Session` struct of
//   Vector<Entry>/Vector<str>, passed `&:` instead of by pointer.
// - NOT in the C: a statement that re-binds a name an earlier statement
//   bound (`x := 5` then `x := "five"`) replaces that earlier statement in
//   place instead of being appended. Appending is what the C did, and it
//   reached sema as E001 "redefinition of 'x'", so a prompt could never
//   change a variable's type. See stmt_binding_name().
// - repl_hist[REPL_HIST_MAX] (fixed C array) -> a module-global
//   Vector<str> g_hist, still capped at REPL_HIST_MAX entries (oldest
//   evicted on overflow, same as the C's memmove-down-by-one), just without
//   a hand-rolled ring buffer.
// - char *buf / int len,pos (a hand-edited byte array) -> a plain `str`
//   line plus an int `pos` (byte offset), rebuilt via substr/concat on
//   every keystroke instead of memmove'd in place. Editing a REPL line is
//   never hot enough for the extra allocations to matter; this stays much
//   closer to idiomatic Salam than porting memmove byte-shuffling would.
// - repl_compile_pkg + repl_exec's own hand-rolled mini "compile these 7
//   runtime packages + the session, then cc/system() the result" linker
//   (RT_PKGS: mem/core/map/text/console/fs/thread) is NOT reproduced.
//   Instead exec_session() below writes the session to a real temp
//   .salam file and calls dr.Build() - the SAME full package-resolution
//   pipeline `salam build` itself uses. This is a deliberate improvement,
//   not a shortcut: it transitively resolves whatever the session actually
//   imports (any std package, not just a fixed list of 7), and it's far
//   less code since dr.Build already existed. It also gets rich
//   rustc-style diagnostics for free (build_impl calls
//   lg.SetDiagSource/AddDiagSource internally), where the C's repl_exec
//   only had plain logger_log output.
// - repl_readline's Win32 console / POSIX termios raw-input loops are
//   ported as win_readline/posix_readline below, gated the same way every
//   other OS-specific pair in this codebase is (`if SALAM_OS_WINDOWS:`).
//   Both share one non-tty fallback_readline (byte-at-a-time via getchar,
//   matching the C's fgets fallback - stops at EOF or '\n', strips a
//   trailing '\r', and - unlike io.Input()/salam_input() - distinguishes
//   "EOF with zero bytes read" (ok=false, like fgets returning NULL) from
//   an actual empty line (ok=true, ""), which the REPL's `for(;;)` loop
//   needs to know when to stop vs. just re-prompt).
// - INPUT_RECORD/KEY_EVENT_RECORD (wincontypes.h) are read through raw
//   byte offsets into a manually `mem.Allocate`d buffer (matching
//   interp.salam's ptr_load/ptr_store idiom) rather than an `extern
//   struct` binding, which this language doesn't have. Offsets were
//   computed by hand from the real header
//   (C:\msys64\mingw64\include\wincontypes.h on this repo's own dev
//   host) for the standard Win64 layout: EventType:u16@0,
//   KeyEvent.bKeyDown:i32@4, KeyEvent.wVirtualKeyCode:u16@10,
//   KeyEvent.uChar.AsciiChar:i8@14, sizeof(INPUT_RECORD)=20 (a 24-byte
//   buffer is allocated for headroom). See win_readline's own comment for
//   the layout derivation.
// - struct termios (bits/termios.h) is likewise read/written through raw
//   byte offsets rather than a real header include. UNLIKE the Windows
//   struct above, this layout is **glibc/Linux-specific** (x86_64 and
//   i386 share it; musl, macOS/BSD, and other libcs lay c_line/c_cc/NCCS
//   out differently and are NOT handled) - offset 0/4/8/12 = c_iflag/
//   c_oflag/c_cflag/c_lflag (tcflag_t, 4 bytes each), offset 16 = c_line
//   (1 byte), offset 17 = c_cc[NCCS=32], c_ispeed/c_ospeed follow at the
//   next 4-byte-aligned offsets (52/56), size 60. This mirrors how
//   driver.salam's bundled-musl-tcc detection is already POSIX-scoped to
//   "whatever this repo's own dev/CI environment provides" rather than
//   fully general; unlike that gap this one cannot be exercised or
//   verified at all on this repo's Windows dev host, so it is a
//   best-effort straight transcription of the C's raw/canon flag toggles
//   (BRKINT/ICRNL/INPCK/ISTRIP/IXON/CS8/ECHO/ICANON/IEXTEN/ISIG/VMIN/
//   VTIME/TCSAFLUSH) against those glibc offsets, not independently
//   tested. A non-glibc POSIX target would need its own offsets.
package repl

import os
import io
import str
import time
import mem
import lg "logger.salam"
import dr "driver/driver.salam"
import lp "langpack.salam"
import lx "lexer/lexer.salam"
import ps "parser/parser.salam"
import cc "condcomp.salam"
import sm "semantic/semantic.salam"
import lo "sal_layout/sal_layout.salam"
import dg "diag.salam"
import tok "token.salam"
import at "ast.salam"
import src "source.salam"
import i18 "i18n.salam"
import co "sal_core.salam"

// process spawn (system()) - same idiom driver.salam's own identical
// comment uses; no link needed, libc is always linked.
extern:
    func system(cmd: str): int
    func getchar(): int
end

if SALAM_OS_WINDOWS:
    // wincon.h / wincontypes.h - see the file header for the byte-offset
    // derivation this reads INPUT_RECORD/KEY_EVENT_RECORD through.
    extern:
        func GetStdHandle(nStdHandle: i32): void*
        func GetFileType(h: void*): i32
        func GetConsoleMode(h: void*, out_mode: void*): i32
        func SetConsoleMode(h: void*, mode: u32): i32
        func ReadConsoleInputA(h: void*, buf: void*, n: i32, out_read: void*): i32
        func _isatty(fd: int): int
    end
else:
    // termios.h / unistd.h - see the file header for the (glibc-only)
    // byte-offset derivation this reads/writes `struct termios` through.
    extern:
        func isatty(fd: int): int
        func tcgetattr(fd: int, buf: void*): int
        func tcsetattr(fd: int, action: int, buf: void*): int
        func read(fd: int, buf: void*, n: u64): i64
        func write(fd: int, buf: void*, n: u64): i64
    end
end

// REPL_HIST_MAX (repl.c)
const HIST_MAX := 200

// STD_INPUT_HANDLE (winbase.h): (DWORD)-10, passed as the i32 bit pattern
// GetStdHandle expects.
const STD_INPUT_HANDLE := 0 - 10
const FILE_TYPE_CHAR := 2
const ENABLE_PROCESSED_INPUT := 1
const KEY_EVENT := 1
const VK_RETURN := 13
const VK_BACK := 8
const VK_DELETE := 46 // 0x2E
const VK_LEFT := 37 // 0x25
const VK_RIGHT := 39 // 0x27
const VK_HOME := 36 // 0x24
const VK_END := 35 // 0x23
const VK_UP := 38 // 0x26
const VK_DOWN := 40 // 0x28

// TCSAFLUSH (termios.h)
const TCSAFLUSH := 2
// VMIN/VTIME indices into glibc's c_cc[NCCS] (bits/termios.h)
const CC_VTIME_IDX := 5
const CC_VMIN_IDX := 6
// Raw-mode flag masks (see file header for the octal->decimal derivation).
// Written as "the bits raw mode CLEARS" so cflag/lflag/iflag can be ANDed
// with these directly (`flag & IFLAG_KEEP_MASK`) instead of needing a `~`
// operator: each KEEP_MASK is precomputed as 0xFFFFFFFF minus the exact
// set of bits the C's `&= ~(...)` clears.
const IFLAG_CLEAR_BITS := 1330 // BRKINT|ICRNL|INPCK|ISTRIP|IXON
const IFLAG_KEEP_MASK := 4294965965 // ~IFLAG_CLEAR_BITS as u32
const LFLAG_CLEAR_BITS := 32779 // ECHO|ICANON|IEXTEN|ISIG
const LFLAG_KEEP_MASK := 4294934516 // ~LFLAG_CLEAR_BITS as u32
const CFLAG_CS8 := 48

// repl_kind_t (repl_internal.h) - the buckets, in the order the language
// demands they appear in a file: `package` first, then imports, then
// externs (E083), then globals (E085), then types (E087), then functions.
// A REPL user types definitions in whatever order the thought arrives, so
// the session sorts them back into a legal program on the way out instead
// of rejecting the input. RS_STMT is not a bucket: it is a statement,
// which lands in the synthesized main.
const RS_PKG := 0
const RS_IMPORT := 1
const RS_EXTERN := 2
const RS_GLOBAL := 3
const RS_TYPE := 4
const RS_DEF := 5
const RS_STMT := 6

// repl_hist[]/repl_nhist (repl.c) - module-global session history, shared
// across every readline() call in one `salam repl` run (matches the C's
// static array living for the process, reset only at the top of driver_repl
// via repl_nhist=0/frees, which Run() below reproduces on entry).
mut g_hist := Vector {} as Vector<str>

// repl_ctx_t's last_out/last_len - what the session printed on its last
// good run. Every turn re-runs the whole session, so this is what tells
// emit_output() which part of the output is replay and which part is news.
mut g_last_out := ""
mut g_has_last := false

// repl_entry_t
struct Entry:
    pub kind: int = 6
    pub name: str = "" // what this entry defines; "" when it names nothing
    pub text: str = "" // raw source, newline-terminated
end

// repl_session_t - what the prompt remembers between turns.
struct Session:
    pub defs: Vector<Entry> = Vector {}
    pub stmts: Vector<str> = Vector {}
    // The user wrote their own entry function, so no main is synthesized
    // and bare statements have nowhere to go.
    pub has_main: bool = false
end

// resolve_color / stderr_is_tty - private copies of driver.salam's own
// identically-named helpers (not reusable from here: driver.salam keeps
// them package-private, per the "driver.salam is read-only from here"
// convention cli.salam's own header already documents).
func stderr_is_tty(): bool:
    if SALAM_OS_WINDOWS:
        ret _isatty(2) != 0
    else:
        ret isatty(2) != 0
    end
end

func resolve_color(flag: int): bool:
    if flag == 1:
        ret true
    end
    if flag == 0:
        ret false
    end
    ret stderr_is_tty()
end

// Unsigned byte read from a str's bytes (idiom shared with driver.salam's
// own byte_at / diag.salam's ub).
func byte_at(s: str, i: int): int:
    bp := (s as void*) as i8*
    mut v := bp[i] as int
    if v < 0:
        v += 256
    end
    ret v
end

// repl_hist_push - append to session history, capped at HIST_MAX (oldest
// evicted), skipping a blank line or an exact repeat of the last entry.
func hist_push(line: str):
    if str.Len(line) == 0:
        ret
    end
    n := g_hist.len()
    if n > 0 && str.Equals(g_hist.get(n - 1), line):
        ret
    end
    if n == HIST_MAX:
        mut i := 0
        until i < HIST_MAX - 1:
            g_hist.set(i, g_hist.get(i + 1))
            i += 1
        end
        _p := g_hist.pop()
    end
    g_hist.push(line)
end

// repl_readline's non-tty fallback (both OS branches use the same fgets
// idiom in the C; ok=false only when EOF hits before any byte was read -
// same distinction fgets' NULL return makes, which io.Input()/salam_input()
// cannot make since both treat "EOF at once" and "" as identical).
func fallback_readline(prompt: str, ok &: bool): str:
    print prompt
    mut c := getchar()
    if c == 0 - 1:
        ok = false
        ret ""
    end
    mut b := str.NewBuilder()
    defer str.BufFree(b)
    until c != (0 - 1) && c != 10:
        if c != 13:
            str.BufAppendChar(b, c)
        end
        c = getchar()
    end
    ok = true
    ret str.BufStr(b)
end

if SALAM_OS_WINDOWS:
    // repl_readline (Win32 branch). INPUT_RECORD layout (see file header):
    // a 24-byte buffer, EventType:u16@0, KeyEvent.bKeyDown:i32@4,
    // KeyEvent.wVirtualKeyCode:u16@10, KeyEvent.uChar.AsciiChar:i8@14.
    func win_readline(prompt: str, ok &: bool): str:
        hIn := GetStdHandle(STD_INPUT_HANDLE)
        invalid := (hIn as i64) == (0 - 1)
        mut is_char := false
        if !invalid:
            is_char = GetFileType(hIn) == FILE_TYPE_CHAR
        end
        if invalid || !is_char:
            ret fallback_readline(prompt, ok)
        end

        mode_buf := mem.Allocate(4 as u64)
        _gm := GetConsoleMode(hIn, mode_buf)
        orig := (mode_buf as u32*)[0]
        mem.Free(mode_buf)
        _sm := SetConsoleMode(hIn, ENABLE_PROCESSED_INPUT as u32)

        print prompt
        mut line := ""
        mut pos := 0
        mut hi := g_hist.len()
        mut saved := ""
        rec := mem.Allocate(24 as u64)
        nread := mem.Allocate(4 as u64)
        ok = true
        mut done := false
        until !done:
            rc := ReadConsoleInputA(hIn, rec, 1 as i32, nread)
            if rc == 0:
                done = true
            else:
                base := rec as i64
                evtype := ((base + 0) as u16*)[0] as int
                keydown := ((base + 4) as i32*)[0]
                if evtype == KEY_EVENT && keydown != 0:
                    vk := ((base + 10) as u16*)[0] as int
                    ch := ((base + 14) as i8*)[0] as int
                    len := str.Len(line)
                    if vk == VK_RETURN:
                        println ""
                        done = true
                    else vk == VK_BACK && pos > 0:
                        line = line.substr(0, pos - 1) + line.substr(pos, len - pos)
                        pos -= 1
                        print "\r" + prompt + line + " " + "\r" + prompt + line.substr(0, pos)
                    else vk == VK_DELETE && pos < len:
                        line = line.substr(0, pos) + line.substr(pos + 1, len - pos - 1)
                        print "\r" + prompt + line + " " + "\r" + prompt + line.substr(0, pos)
                    else vk == VK_LEFT && pos > 0:
                        pos -= 1
                        print "\r" + prompt + line.substr(0, pos)
                    else vk == VK_RIGHT && pos < len:
                        pos += 1
                        print "\r" + prompt + line.substr(0, pos)
                    else vk == VK_HOME:
                        pos = 0
                        print "\r" + prompt
                    else vk == VK_END:
                        pos = len
                        print "\r" + prompt + line
                    else vk == VK_UP:
                        if hi == g_hist.len():
                            saved = line
                        end
                        if hi > 0:
                            hi -= 1
                            hline := g_hist.get(hi)
                            print "\r" + prompt + " ".repeat(len + 1) + "\r" + prompt + hline
                            line = hline
                            pos = str.Len(line)
                        end
                    else vk == VK_DOWN:
                        if hi < g_hist.len():
                            hi += 1
                            mut hline := saved
                            if hi < g_hist.len():
                                hline = g_hist.get(hi)
                            end
                            print "\r" + prompt + " ".repeat(len + 1) + "\r" + prompt + hline
                            line = hline
                            pos = str.Len(line)
                        end
                    else ch == 1:
                        pos = 0
                        print "\r" + prompt
                    else ch == 5:
                        pos = len
                        print "\r" + prompt + line
                    else ch == 21:
                        print "\r" + prompt + " ".repeat(len + 1) + "\r" + prompt
                        line = ""
                        pos = 0
                    else ch == 3 || (ch == 4 && len == 0):
                        println ""
                        ok = false
                        done = true
                    else ch >= 32 && ch < 256 && str.Len(line) < 4095:
                        line = line.substr(0, pos) + char_from_code(ch) + line.substr(pos, len - pos)
                        pos += 1
                        print "\r" + prompt + line + " " + "\r" + prompt + line.substr(0, pos)
                    end
                end
            end
        end
        mem.Free(rec)
        mem.Free(nread)
        _rm := SetConsoleMode(hIn, orig)
        ret line
    end
else:
    // repl_readline (POSIX branch). `struct termios` layout (see file
    // header): glibc-only, 60-byte buffer, c_iflag/c_oflag/c_cflag/
    // c_lflag:u32@0/4/8/12, c_cc[NCCS]@17 (VMIN@17+6, VTIME@17+5).
    func posix_readline(prompt: str, ok &: bool): str:
        if isatty(0) == 0:
            ret fallback_readline(prompt, ok)
        end
        orig := mem.Allocate(60 as u64)
        _gt := tcgetattr(0, orig)
        raw := mem.Allocate(60 as u64)
        mem.Copy(raw, orig, 60 as u64)
        iflag_p := raw as u32*
        cflag_p := ((raw as i64) + 8) as u32*
        lflag_p := ((raw as i64) + 12) as u32*
        iflag_p[0] = iflag_p[0] & (IFLAG_KEEP_MASK as u32)
        cflag_p[0] = cflag_p[0] | (CFLAG_CS8 as u32)
        lflag_p[0] = lflag_p[0] & (LFLAG_KEEP_MASK as u32)
        vmin_p := ((raw as i64) + 17 + CC_VMIN_IDX) as i8*
        vtime_p := ((raw as i64) + 17 + CC_VTIME_IDX) as i8*
        vmin_p[0] = 1 as i8
        vtime_p[0] = 0 as i8
        _st := tcsetattr(0, TCSAFLUSH, raw)
        mem.Free(raw)

        print prompt
        mut line := ""
        mut pos := 0
        mut hi := g_hist.len()
        mut saved := ""
        ok = true
        mut done := false
        until !done:
            cb := mem.Allocate(1 as u64)
            nr := read(0, cb, 1 as u64)
            mut c := 0 - 1
            if nr > (0 as i64):
                c = (cb as u8*)[0] as int
            end
            mem.Free(cb)
            len := str.Len(line)
            if nr <= (0 as i64):
                if len == 0:
                    ok = false
                end
                done = true
            else c == 13 || c == 10:
                print "\r\n"
                done = true
            else c == 127 || c == 8:
                if pos > 0:
                    line = line.substr(0, pos - 1) + line.substr(pos, len - pos)
                    pos -= 1
                    print "\b" + line.substr(pos, len - 1 - pos) + " " + "\b".repeat(len - pos)
                end
            else c == 1:
                print "\b".repeat(pos)
                pos = 0
            else c == 5:
                print line.substr(pos, len - pos)
                pos = len
            else c == 21:
                print "\b".repeat(pos) + " ".repeat(len) + "\b".repeat(len)
                line = ""
                pos = 0
            else c == 3 || (c == 4 && len == 0):
                print "\r\n"
                ok = false
                done = true
            else c == 27:
                s1b := mem.Allocate(1 as u64)
                n1 := read(0, s1b, 1 as u64)
                s1 := n1 > (0 as i64) ? ((s1b as u8*)[0] as int) : 0
                mem.Free(s1b)
                if n1 > (0 as i64) && s1 == 91: // '['
                    s2b := mem.Allocate(1 as u64)
                    n2 := read(0, s2b, 1 as u64)
                    s2 := n2 > (0 as i64) ? ((s2b as u8*)[0] as int) : 0
                    mem.Free(s2b)
                    if n2 > (0 as i64) && s2 == 65: // 'A' - up
                        if hi == g_hist.len():
                            saved = line
                        end
                        if hi > 0:
                            hi -= 1
                            hline := g_hist.get(hi)
                            print "\b".repeat(pos) + " ".repeat(len) + "\b".repeat(len) + hline
                            line = hline
                            pos = str.Len(line)
                        end
                    else s2 == 66: // 'B' - down
                        if hi < g_hist.len():
                            hi += 1
                            mut hline := saved
                            if hi < g_hist.len():
                                hline = g_hist.get(hi)
                            end
                            print "\b".repeat(pos) + " ".repeat(len) + "\b".repeat(len) + hline
                            line = hline
                            pos = str.Len(line)
                        end
                    else s2 == 67 && pos < len: // 'C' - right
                        print line.substr(pos, 1)
                        pos += 1
                    else s2 == 68 && pos > 0: // 'D' - left
                        print "\b"
                        pos -= 1
                    else s2 == 51: // '3' - possibly Delete (ESC [ 3 ~)
                        tb := mem.Allocate(1 as u64)
                        nt := read(0, tb, 1 as u64)
                        tch := nt > (0 as i64) ? ((tb as u8*)[0] as int) : 0
                        mem.Free(tb)
                        if nt > (0 as i64) && tch == 126 && pos < len: // '~'
                            line = line.substr(0, pos) + line.substr(pos + 1, len - pos - 1)
                            print line.substr(pos, len - 1 - pos) + " " + "\b".repeat(len - pos)
                        end
                    end
                end
            else c >= 32 && c < 256 && str.Len(line) < 4095:
                line = line.substr(0, pos) + char_from_code(c) + line.substr(pos, len - pos)
                pos += 1
                print line.substr(pos - 1, len + 1 - pos) + "\b".repeat(len - pos)
            end
        end
        _rt := tcsetattr(0, TCSAFLUSH, orig)
        mem.Free(orig)
        ret line
    end
end

// repl_readline dispatcher.
func readline(prompt: str, ok &: bool): str:
    if SALAM_OS_WINDOWS:
        ret win_readline(prompt, ok)
    else:
        ret posix_readline(prompt, ok)
    end
end

// ===========================================================================
// ===== repl_session.c =====
// ===========================================================================

// repl_skip_ws - index of the first byte at or after `i` that is neither a
// space nor a tab.
func skip_ws(s: str, i: int): int:
    n := str.Len(s)
    mut p := i
    until p < n:
        c := byte_at(s, p)
        if c != 32 && c != 9:
            ret p
        end
        p += 1
    end
    ret p
end

// Identifier bytes, non-ASCII included: fa/ar keywords and identifiers are
// UTF-8, and every continuation byte has the high bit set.
func ident_byte(c: int): bool:
    ret c >= 128 || c == 95 || (c >= 48 && c <= 57) || (c >= 97 && c <= 122) || (
        c >= 65 && c <= 90
    )
end

func word_len(s: str, i: int): int:
    n := str.Len(s)
    mut e := i
    until e < n && ident_byte(byte_at(s, e)):
        e += 1
    end
    ret e - i
end

// The whole first line, trimmed - the fallback name for a block whose
// subject cannot be read off its opener (`impl X on Y`, an extern block,
// an import). Retyping it verbatim then replaces it instead of colliding;
// a different one lives alongside it.
func line_as_name(line: str): str:
    p := skip_ws(line, 0)
    n := str.Len(line)
    mut e := p
    until e < n && byte_at(line, e) != 10 && byte_at(line, e) != 13:
        e += 1
    end
    until e > p && (byte_at(line, e - 1) == 32 || byte_at(line, e - 1) == 9):
        e -= 1
    end
    // The ':' that opens the block is not part of what the line names, and
    // reading "redefined impl Describe on int:." back is a wart. Dropped
    // on both sides of the comparison, so it costs nothing to match on.
    if e > p && byte_at(line, e - 1) == 58:
        e -= 1
    end
    ret str.Substr(line, p, e - p)
end

// A definition's subject: the identifier after the keyword, dots kept so
// two members of one type stay distinct.
func subject_name(s: str, after_kw: int): str:
    p := skip_ws(s, after_kw)
    n := str.Len(s)
    mut e := p
    until e < n:
        c := byte_at(s, e)
        dotted := c == 46 && e + 1 < n && ident_byte(byte_at(s, e + 1))
        if !ident_byte(c) && !dotted:
            break
        end
        e += 1
    end
    ret str.Substr(s, p, e - p)
end

func word_kind(pack: int, s: str, i: int, n: int): int:
    ret lp.LookupKeyword(pack, str.Substr(s, i, n))
end

func is_modifier(k: int): bool:
    ret k == tok.TK_KW_PUB || k == tok.TK_KW_INLINE || k == tok.TK_KW_NOINLINE || k == tok.TK_KW_PURE || k == tok.TK_KW_NORET || k == tok.TK_KW_DEPRECATED
end

func names_its_subject(k: int): bool:
    ret k == tok.TK_KW_FUNC || k == tok.TK_KW_STRUCT || k == tok.TK_KW_ENUM || k == tok.TK_KW_TYPE || k == tok.TK_KW_INTERFACE || k == tok.TK_KW_COMPONENT || k == tok.TK_KW_CONST
end

func kind_of_keyword(k: int): int:
    if k == tok.TK_KW_PACKAGE:
        ret RS_PKG
    end
    if k == tok.TK_KW_IMPORT:
        ret RS_IMPORT
    end
    if k == tok.TK_KW_EXTERN:
        ret RS_EXTERN
    end
    if k == tok.TK_KW_CONST:
        ret RS_GLOBAL
    end
    if k == tok.TK_KW_STRUCT || k == tok.TK_KW_ENUM || k == tok.TK_KW_TYPE || k == tok.TK_KW_INTERFACE || k == tok.TK_KW_COMPONENT || k == tok.TK_KW_IMPL:
        ret RS_TYPE
    end
    if k == tok.TK_KW_FUNC || k == tok.TK_KW_OPERATOR:
        ret RS_DEF
    end
    ret RS_STMT
end

// `text` with any leading `@lang "..."` marker lines removed. A marker
// line is one whose first non-blank byte is '@'; blank lines between a
// marker and its definition go with them.
func after_metas(text: str): str:
    n := str.Len(text)
    mut i := 0
    until i < n:
        ls := skip_ws(text, i)
        if ls >= n:
            ret ""
        end
        if byte_at(text, ls) != 64:
            ret str.Substr(text, i, n - i)
        end
        // Skip to just past this line's newline.
        mut e := ls
        until e < n && byte_at(text, e) != 10:
            e += 1
        end
        if e >= n:
            ret ""
        end
        i = e + 1
    end
    ret ""
end

// repl_classify - which bucket does `text` (the first line of a turn, or
// the whole block once it has been read) belong to, and what does it
// define? `name` gets the defined
// symbol, or the trimmed line itself when the entry names nothing a later
// redefinition could match on. Keywords are read through `pack`, so an
// fa/ar session classifies exactly like an en one.
func classify(pack: int, text: str, name &: str): int:
    // `@en "Name"` markers belong to the definition under them, so they
    // are stepped over here - and a turn that is nothing but markers is
    // still a definition, one whose first line has not been typed yet.
    line := after_metas(text)
    mut p := skip_ws(line, 0)
    name = ""
    ln := str.Len(line)
    if ln == 0:
        name = line_as_name(text)
        ret RS_DEF
    end
    if p + 1 < ln && byte_at(line, p) == 47 && (
        byte_at(line, p + 1) == 47 || byte_at(line, p + 1) == 42
    ):
        name = line_as_name(line)
        ret RS_DEF
    end
    // At most one pass per leading modifier, then the keyword decides.
    mut guard := 0
    until guard < 8:
        n := word_len(line, p)
        if n == 0:
            ret RS_STMT
        end
        k := word_kind(pack, line, p, n)
        if is_modifier(k):
            p = skip_ws(line, p + n)
            guard += 1
        else:
            // `link "..."` has no token of its own - it is parsed off the
            // identifier - so it is matched by spelling, English only.
            if k == tok.TK_IDENT && n == 4 && str.Equals(str.Substr(line, p, n), "link"):
                name = line_as_name(line)
                ret RS_IMPORT
            end
            kind := kind_of_keyword(k)
            if kind == RS_STMT:
                ret RS_STMT
            end
            if names_its_subject(k):
                name = subject_name(line, p + n)
            else k == tok.TK_KW_PACKAGE:
                name = "package"
            else:
                name = line_as_name(line)
            end
            if str.Len(name) == 0:
                name = line_as_name(line)
            end
            ret kind
        end
    end
    ret RS_STMT
end

// An `=` that assigns, as opposed to one inside ==, !=, <=, >=, +=, and
// friends. Struct literals (`Vec2 { x = 1 }`) count as assignment here,
// which only costs them the echo.
//
// ':' is NOT in this list, unlike in the C: there the ':' of `x := 1`
// disqualified a binding from counting as an assignment, so every binding
// turn was probed as `println x := 1` first - a wasted front-end pass, and
// one that threw away any adjustment turn_stmt had already made to the
// text (see the `mut` carry-over there).
func assign_prev_byte(c: int): bool:
    ret c == 61 || c == 33 || c == 60 || c == 62 || c == 43 || c == 45 || c == 42 || c == 47 || c == 37 || c == 38 || c == 124 || c == 94 || c == 126
end

func has_assignment(s: str, from: int): bool:
    n := str.Len(s)
    mut q := from
    until q < n:
        c := byte_at(s, q)
        nxt := q + 1 < n ? byte_at(s, q + 1) : 0
        prev := q == from ? 32 : byte_at(s, q - 1)
        if c == 61 && nxt != 61 && !assign_prev_byte(prev):
            ret true
        end
        q += 1
    end
    ret false
end

// repl_is_expr_line - is `line` a bare expression: no keyword opener, no
// assignment, one line? Those are questions, and the REPL answers them by
// printing the value instead of evaluating for effect.
func is_expr_line(pack: int, line: str): bool:
    p := skip_ws(line, 0)
    n := str.Len(line)
    if p >= n:
        ret false
    end
    mut nl := p
    until nl < n && byte_at(line, nl) != 10:
        nl += 1
    end
    if nl < n && skip_ws(line, nl + 1) < n:
        ret false
    end
    if p + 1 < n && byte_at(line, p) == 47 && (
        byte_at(line, p + 1) == 47 || byte_at(line, p + 1) == 42
    ):
        ret false
    end
    // A zero-length word is fine: an expression can open with a literal or
    // a sign (`"a" + "b"`, `-x`, `(1 + 2) * 3`). Only a keyword opener
    // rules it out - that is a statement, whatever follows.
    w := word_len(line, p)
    if w > 0 && tok.IsKeyword(word_kind(pack, line, p, w)):
        ret false
    end
    ret !has_assignment(line, p)
end

// The name a statement BINDS, "" when it binds nothing. `x := 1`,
// `mut x := 1` and `mut x: int = 1` all bind x; `x = 2` (plain
// assignment) and `xs.push(1)` bind nothing. Not in the C: the C
// accumulated statements append-only, so `x := 1` followed by
// `x := "one"` reached sema as a redefinition (E001) and the turn was
// rejected. At a prompt that second line means "x is a str from now on",
// so session_add_stmt below replaces the earlier binding in place
// (in place, not at the end, so the statements typed between the two
// still see an x).
func stmt_binding_name(pack: int, text: str): str:
    mut p := skip_ws(text, 0)
    mut n := word_len(text, p)
    if n == 0:
        ret ""
    end
    k := word_kind(pack, text, p, n)
    if k == tok.TK_KW_MUT:
        p = skip_ws(text, p + n)
        n = word_len(text, p)
        if n == 0:
            ret ""
        end
        if tok.IsKeyword(word_kind(pack, text, p, n)):
            ret ""
        end
    else tok.IsKeyword(k):
        ret ""
    end
    name := str.Substr(text, p, n)
    q := skip_ws(text, p + n)
    // `name :=` or the typed `name: T = ...`; anything else (`name =`,
    // `name.field = `, `name(...)`) is not a new binding.
    if q < str.Len(text) && byte_at(text, q) == 58:
        ret name
    end
    ret ""
end

// The "there is no candidate" entry - render()'s has_cand=false ignores
// its fields. A struct literal is not accepted as a call argument, so it
// gets a name here instead of being spelled out at every call site.
func no_cand(): Entry:
    e := Entry {}
    ret e
end

func starts_with_mut(pack: int, text: str): bool:
    p := skip_ws(text, 0)
    n := word_len(text, p)
    ret n > 0 && word_kind(pack, text, p, n) == tok.TK_KW_MUT
end

// `mut` in front of `text`, keeping its indentation.
func with_mut(pack: int, text: str): str:
    kw := lp.Spelling(pack, tok.TK_KW_MUT)
    p := skip_ws(text, 0)
    ret str.Substr(text, 0, p) + (str.Len(kw) > 0 ? kw : "mut") + " " + str.Substr(
        text, p, str.Len(text) - p
    )
end

func session_defines(s &: Session, name: str): bool:
    mut i := 0
    until i < s.defs.len():
        if str.Equals(s.defs.get(i).name, name):
            ret true
        end
        i += 1
    end
    ret false
end

// Does the session still define an entry function after this change?
func refresh_has_main(s &: Session, pack: int):
    entry := lp.Entry(pack)
    s.has_main = false
    mut i := 0
    until i < s.defs.len():
        e := s.defs.get(i)
        if e.kind == RS_DEF && str.Equals(e.name, entry):
            s.has_main = true
        end
        i += 1
    end
end

// repl_session_add - accepts an entry into the session. A definition with
// the same name as an existing one REPLACES it in place: redefining a
// function is the most ordinary thing a REPL user does.
func session_add(s &: Session, pack: int, kind: int, name: str, text: str):
    mut i := 0
    until i < s.defs.len():
        if str.Equals(s.defs.get(i).name, name):
            hit := Entry { kind = kind, name = name, text = text }
            s.defs.set(i, hit)
            refresh_has_main(s, pack)
            ret
        end
        i += 1
    end
    fresh := Entry { kind = kind, name = name, text = text }
    s.defs.push(fresh)
    refresh_has_main(s, pack)
end

// Index of the accumulated statement `text` rebinds, or -1 to append.
func stmt_replace_index(s &: Session, pack: int, text: str): int:
    nm := stmt_binding_name(pack, text)
    if str.Len(nm) == 0:
        ret 0 - 1
    end
    mut i := 0
    until i < s.stmts.len():
        if str.Equals(stmt_binding_name(pack, s.stmts.get(i)), nm):
            ret i
        end
        i += 1
    end
    ret 0 - 1
end

func session_add_stmt(s &: Session, pack: int, text: str):
    at_i := stmt_replace_index(s, pack, text)
    if at_i >= 0:
        s.stmts.set(at_i, text)
        ret
    end
    s.stmts.push(text)
end

// repl_session_undo - drops the newest statement, false when there is none.
func session_undo(s &: Session): bool:
    if s.stmts.len() == 0:
        ret false
    end
    _dropped := s.stmts.pop()
    ret true
end

func put_block(sb &: str.StringBuilder, text: str):
    n := str.Len(text)
    if n == 0:
        ret
    end
    str.BufAppend(sb, text)
    if byte_at(text, n - 1) != 10:
        str.BufAppendChar(sb, 10)
    end
end

func entry_is_pub(pack: int, text: str): bool:
    p := skip_ws(text, 0)
    n := word_len(text, p)
    ret n > 0 && word_kind(pack, text, p, n) == tok.TK_KW_PUB
end

// `pubsel` selects a pass over one bucket: -1 for everything, 0 for the
// private entries, 1 for the pub ones. Functions are emitted in two passes
// because a private function may not follow a pub one (E088), and the
// prompt has no business making the user care.
func put_bucket(
    sb &: str.StringBuilder, s &: Session, pack: int, kind: int, cand: Entry, has_cand: bool, pubsel: int
):
    mut i := 0
    until i < s.defs.len():
        e := s.defs.get(i)
        mut skip := e.kind != kind
        if !skip && pubsel >= 0 && entry_is_pub(pack, e.text) != (pubsel == 1):
            skip = true
        end
        if !skip && has_cand && str.Len(cand.name) > 0 && str.Equals(e.name, cand.name):
            skip = true
        end
        if !skip:
            put_block(sb, e.text)
        end
        i += 1
    end
    if has_cand && cand.kind == kind && (
        pubsel < 0 || entry_is_pub(pack, cand.text) == (pubsel == 1)
    ):
        put_block(sb, cand.text)
    end
end

// The statements of the synthesized main, with `cand` (an unaccepted
// statement) placed exactly where session_add_stmt would put it, so the
// program that gets checked is the program that gets kept.
func put_stmts(
    sb &: str.StringBuilder, s &: Session, pack: int, cand: Entry, has_cand: bool
):
    mut place := 0 - 1
    if has_cand && cand.kind == RS_STMT:
        place = stmt_replace_index(s, pack, cand.text)
    end
    mut i := 0
    until i < s.stmts.len():
        if i == place:
            put_block(sb, cand.text)
        else:
            put_block(sb, s.stmts.get(i))
        end
        i += 1
    end
    if has_cand && cand.kind == RS_STMT && place < 0:
        put_block(sb, cand.text)
    end
end

// repl_render - the session as one compilable program: buckets in file
// order, then a synthesized `func main:` holding every accepted statement.
// `cand` is an entry that has not been accepted yet (has_cand=false for
// the session alone); a candidate that redefines an existing name shadows
// it here too, so the check that follows sees the program the user is
// asking for rather than a duplicate-symbol error.
func render(s &: Session, pack: int, cand: Entry, has_cand: bool): str:
    mut sb := str.NewBuilder()
    mut k := 0
    until k < RS_DEF:
        put_bucket(sb, s, pack, k, cand, has_cand, 0 - 1)
        k += 1
    end
    put_bucket(sb, s, pack, RS_DEF, cand, has_cand, 0)
    put_bucket(sb, s, pack, RS_DEF, cand, has_cand, 1)
    if !s.has_main:
        kw_func := lp.Spelling(pack, tok.TK_KW_FUNC)
        kw_ret := lp.Spelling(pack, tok.TK_KW_RET)
        empty := s.stmts.len() == 0 && !(has_cand && cand.kind == RS_STMT)
        str.BufAppend(sb, str.Len(kw_func) > 0 ? kw_func : "func")
        str.BufAppend(sb, " " + lp.Entry(pack) + ":\n")
        put_stmts(sb, s, pack, cand, has_cand)
        // A function with an empty body is an error in this language, and a
        // session that is all definitions so far has nothing to put in main
        // yet. `ret 0` is what main returns anyway.
        if empty:
            str.BufAppend(sb, str.Len(kw_ret) > 0 ? kw_ret : "ret")
            str.BufAppend(sb, " 0\n")
        end
        str.BufAppend(sb, lp.EndSpelling(pack) + "\n")
    end
    out := str.BufStr(sb)
    str.BufFree(sb)
    ret out
end

// ===========================================================================
// ===== repl.c: checking, running and turns =================================
// ===========================================================================

// repl_incomplete - is the turn still unfinished? The parser decides: it
// is the only thing that knows a `match` arm from a struct field, and a
// block-opening ':' from the ':' in `f(n: int): int`. Counting colons and
// `end`s by hand - what this used to do - miscounted the moment a function
// took a typed parameter or named a return type, and the prompt then
// swallowed everything typed after it.
func incomplete(pack: int, src_text: str, as_stmt: bool): bool:
    // A statement is only legal inside a function, so it is probed inside
    // one - with a closing `end` appended. That `end` absorbs exactly the
    // one the block still owes: `each v in xs:` on its own leaves main
    // open (more input owed), while a block the user already closed
    // parses whole (the turn is finished). Probing a statement at top
    // level instead - what this did first - failed with "expected a
    // top-level definition", which is not an end-of-input error, so every
    // multi-line `if`/`each`/`until` ended after its first line.
    mut probe := src_text
    if as_stmt:
        kw_func := lp.Spelling(pack, tok.TK_KW_FUNC)
        probe = (str.Len(kw_func) > 0 ? kw_func : "func") + " " + lp.Entry(
            pack
        ) + ":\n" + src_text + lp.EndSpelling(pack) + "\n"
    end
    lgr := lg.New(lg.LOG_OFF, false)
    mut sf := src.New()
    sf.path = "<repl>"
    sf.text = probe
    sf.len = str.Len(probe)
    mut toks := tok.StreamNew(sf.path)
    mut a := at.NewAst()
    mut more := false
    if lx.Run(lgr, pack, sf, toks):
        more = ps.NeedsMore(lgr, toks, a)
    end
    at.FreeAst(a)
    tok.StreamFree(toks)
    ret more
end

// repl_read_block - reads continuation lines until the turn parses (or
// input ends). `as_stmt` picks the framing incomplete() probes in: the
// first line has already been classified by then, so the two callers know
// which one this turn is. `ok` is false when the user abandoned the block with
// `:abort` - without that escape a block that can never be completed (a
// typo in the word that closes it) would hold the prompt forever.
func read_block(pack: int, first: str, as_stmt: bool, ok &: bool): str:
    mut block := first + "\n"
    mut cont_ok := true
    ok = true
    until incomplete(pack, block, as_stmt) && cont_ok:
        cont := readline("  ... ", cont_ok)
        if cont_ok:
            if str.Equals(cont, ":abort"):
                println "abandoned."
                ok = false
                ret ""
            end
            block += cont + "\n"
            hist_push(cont)
        end
    end
    ret block
end

// compile_check - the front end only: lex, parse, prune, analyze (codegen
// is never reached - this is a dry-run gate before accepting a turn into
// the session, matching the C's own throwaway arena_t exactly). `quiet`
// decides whether the user sees the diagnostics - the echo probe below
// asks a question it does not want answered out loud.
func compile_check(opt &: dr.Dr, pack: int, test_src: str, quiet: bool): bool:
    lgr := lg.New(quiet ? lg.LOG_OFF : lg.LOG_ERROR, resolve_color(opt.color))
    mut sf := src.New()
    sf.path = "<repl>"
    sf.text = test_src
    sf.len = str.Len(test_src)
    if !quiet:
        lg.SetDiagSource(lgr, sf.text, sf.len, opt.diag_style, opt.diag_format)
    end
    mut toks := tok.StreamNew(sf.path)
    ok := lx.Run(lgr, pack, sf, toks)
    mut a := at.NewAst()
    mut prog := 0
    mut pok := ok
    if ok:
        pok = ps.Run(lgr, toks, a, prog)
    end
    tok.StreamFree(toks)
    table := cc.TableBuild("", opt.defines)
    mut cok := pok
    if pok:
        cok = cc.PruneProgram(a, lgr, sf.path, table, prog)
    end
    mut s := sm.New(lgr, sf.path, lp.Code(pack))
    sm.SetCc(s, table)
    mut sok := false
    if cok:
        sok = sm.Run(s, a, prog)
    end
    sm.Free(s)
    at.FreeAst(a)
    ret ok && pok && cok && sok
end

// What system() reported, in the words the user thinks in. libc hands
// back a wait status on POSIX - exit code 3 arrives as 768 - and the C
// printed that raw number, so a program that exited 3 said "exited with
// 768". Windows' system() returns the code itself.
func exit_note(rc: int): str:
    if SALAM_OS_WINDOWS:
        ret "[program exited with " + co.I64Toa(rc as i64) + "]"
    else:
        if rc < 0:
            ret "[could not run the program]"
        end
        sig := rc & 127
        if sig != 0:
            ret "[program killed by signal " + co.I64Toa(sig as i64) + "]"
        end
        ret "[program exited with " + co.I64Toa(((rc / 256) & 255) as i64) + "]"
    end
end

// repl_emit_output - prints what this run added. Everything the session
// printed on earlier turns comes out again byte for byte, so the common
// prefix is replay and only the tail is news; a program whose output
// changed (it reads a clock, a file, the network - or a statement the user
// just rebound) fails the prefix test and is shown whole rather than
// guessed at.
func emit_output(out: str):
    mut skip := 0
    if g_has_last && str.StartsWith(out, g_last_out):
        skip = str.Len(g_last_out)
    end
    if str.Len(out) > skip:
        print str.Substr(out, skip, str.Len(out) - skip)
    end
end

// exec_session - repl_exec, reworked to reuse dr.Build's own full
// package-resolution pipeline (see the file header's "C -> Salam decisions"
// note on why this is simpler AND more complete than the C's hand-rolled
// RT_PKGS mini-linker). `opt` is mutated in place (inputs/output/command),
// matching dr.Run()'s own established idiom of repurposing its `&: Dr` for
// a one-shot sub-build. `replay` is true for a turn - the run is captured
// so only what the newest statement added is printed - and false for an
// explicit :run, which hands the program the terminal itself.
func exec_session(opt &: dr.Dr, full_src: str, replay: bool): int:
    // Same "INFO is too noisy for a one-shot run" bump dr.Run() itself
    // applies before build_impl, so `:run`/a bare statement doesn't spam
    // the whole stdlib closure's parse/codegen INFO lines on every REPL
    // turn.
    if opt.log_level == lg.LOG_INFO:
        opt.log_level = lg.LOG_WARN
    end
    ts := time.NowMicros()
    tmp_src := os.TempDir() + "/salam-repl-" + ts + ".salam"
    tmp_out := os.TempDir() + "/salam-repl-" + ts + ".out"
    mut exe_suffix := ""
    if SALAM_OS_WINDOWS:
        exe_suffix = ".exe"
    else:
        exe_suffix = ""
    end
    tmp_exe := os.TempDir() + "/salam-repl-" + ts + exe_suffix
    if io.WriteFile(tmp_src, full_src) < 0:
        io.EPrintln("error: could not write a temp file for the session")
        ret 0 - 1
    end
    opt.inputs = Vector {} as Vector<str>
    opt.inputs.push(tmp_src)
    // Both fields, not just the list: this turn's file is the whole input,
    // and dr.Build hands `input` to the LLVM backend and `inputs` to the C
    // one.
    opt.input = tmp_src
    opt.output = tmp_exe
    opt.exe_path = ""
    opt.keep_c = false
    mut rc := dr.Build(opt)
    if rc == 0:
        exe := str.Len(opt.exe_path) > 0 ? opt.exe_path : tmp_exe
        mut cmdb := str.NewBuilder()
        if SALAM_OS_WINDOWS:
            // cmd.exe strips the outermost quote pair off everything after
            // /c, so the whole redirected command needs one more pair
            // around it for a temp path with a space in it to survive.
            if replay:
                str.BufAppendChar(cmdb, 34)
            end
        end
        str.BufAppendChar(cmdb, 34)
        if SALAM_OS_WINDOWS:
            str.BufAppend(cmdb, exe)
        else:
            if str.Contains(exe, "/"):
                str.BufAppend(cmdb, exe)
            else:
                str.BufAppend(cmdb, "./" + exe)
            end
        end
        str.BufAppendChar(cmdb, 34)
        if replay:
            str.BufAppend(cmdb, " > ")
            str.BufAppendChar(cmdb, 34)
            str.BufAppend(cmdb, tmp_out)
            str.BufAppendChar(cmdb, 34)
            str.BufAppend(cmdb, " 2>&1")
            if SALAM_OS_WINDOWS:
                str.BufAppendChar(cmdb, 34)
            end
        end
        cmdtext := str.BufStr(cmdb)
        str.BufFree(cmdb)
        io.Flush()
        rc = system(cmdtext)
        if replay:
            out := io.ReadFile(tmp_out)
            emit_output(out)
            if rc == 0:
                g_last_out = out
                g_has_last = true
            end
            _r0 := os.Remove(tmp_out)
        else:
            // An explicit :run keeps the program's own stdout and stdin -
            // a loop prints as it goes and `input()` can still ask a
            // question, neither of which survives a redirect to a file.
            // The cost is that this run's output was never read here, so
            // the next turn has no prefix to replay and shows everything.
            g_last_out = ""
            g_has_last = false
        end
        if rc != 0:
            println exit_note(rc)
        end
        _r2 := os.Remove(str.Len(opt.exe_path) > 0 ? opt.exe_path : tmp_exe)
    end
    _r1 := os.Remove(tmp_src)
    ret rc
end

// repl_echo_wrap - `expr` alone on a line is a question, so answer it: the
// REPL tries the turn as `println expr` first and keeps that form only if
// it compiles. A void call like `xs.push("a")` fails that check and runs
// as the plain statement it is. The expression is not parenthesized -
// print statements reject that outright - which is safe because it is the
// whole line.
func echo_wrap(pack: int, block: str): str:
    kw := lp.Spelling(pack, tok.TK_KW_PRINTLN)
    mut n := str.Len(block)
    until n > 0 && (byte_at(block, n - 1) == 10 || byte_at(block, n - 1) == 13):
        n -= 1
    end
    ret (str.Len(kw) > 0 ? kw : "println") + " " + str.Substr(block, 0, n) + "\n"
end

// repl_turn_def - a definition turn: check the session as it would be with
// this entry in it, then let it replace whatever it redefines.
func turn_def(
    opt &: dr.Dr, s &: Session, pack: int, kind: int, name: str, block: str
):
    again := session_defines(s, name)
    cand := Entry { kind = kind, name = name, text = block }
    if !compile_check(opt, pack, render(s, pack, cand, true), false):
        ret
    end
    session_add(s, pack, kind, name, block)
    if s.has_main && s.stmts.len() > 0:
        println "note: your own " + lp.Entry(pack) + " replaces the " + co.I64Toa(
            s.stmts.len() as i64
        ) + " statement(s) typed so far."
    end
    // An import or an extern block names nothing worth reading back.
    if kind == RS_PKG || kind == RS_IMPORT || kind == RS_EXTERN:
        println "ok."
    else:
        mut tail := ""
        if s.has_main:
            tail = " ':run' to execute."
        end
        println (again ? "redefined " : "defined ") + name + "." + tail
    end
end

// repl_turn_stmt - a statement turn: echo-probe it, check it, run it, and
// keep it only if all three worked.
func turn_stmt(opt &: dr.Dr, s &: Session, pack: int, block: str):
    mut cand := Entry { kind = RS_STMT, name = "", text = block }
    // Re-binding a name the session already bound `mut` keeps the `mut`:
    // the statements typed in between may well assign to it, and losing
    // their right to do so is not what "x is 5 now" asked for.
    old_i := stmt_replace_index(s, pack, block)
    if old_i >= 0 && starts_with_mut(pack, s.stmts.get(old_i)) && !starts_with_mut(
        pack, block
    ):
        cand.text = with_mut(pack, block)
    end
    if is_expr_line(pack, block):
        plain := cand.text
        cand.text = echo_wrap(pack, block)
        if !compile_check(opt, pack, render(s, pack, cand, true), true):
            cand.text = plain
        end
    end
    // Analyze before building, the same gate a def already goes through. A
    // rejected turn is then reported against "<repl>" instead of against a
    // temp file whose path is longer than the program and which is deleted
    // before the user could open it, and no backend or C compiler is
    // started for a turn that cannot survive the front end.
    src_text := render(s, pack, cand, true)
    if compile_check(opt, pack, src_text, false) && exec_session(opt, src_text, true) == 0:
        session_add_stmt(s, pack, cand.text)
    end
end

// repl_layout_exec - lex/parse/prune, then (regardless of sema's own
// result, matching the C's `if (ok) sema_run(...)` with the bool
// discarded) find and render a `layout: ... end` block to stdout.
func layout_exec(opt &: dr.Dr, pack: int, src_text: str):
    lgr := lg.New(lg.LOG_ERROR, resolve_color(opt.color))
    mut sf := src.New()
    sf.path = "<repl>"
    sf.text = src_text
    sf.len = str.Len(src_text)
    lg.SetDiagSource(lgr, sf.text, sf.len, opt.diag_style, opt.diag_format)
    mut toks := tok.StreamNew(sf.path)
    ok := lx.Run(lgr, pack, sf, toks)
    mut a := at.NewAst()
    mut prog := 0
    mut pok := ok
    if ok:
        pok = ps.Run(lgr, toks, a, prog)
    end
    tok.StreamFree(toks)
    mut cok := pok
    if pok:
        table := cc.TableBuild("", opt.defines)
        cok = cc.PruneProgram(a, lgr, sf.path, table, prog)
        if cok:
            mut s := sm.New(lgr, sf.path, lp.Code(pack))
            sm.SetCc(s, table)
            _sok := sm.Run(s, a, prog)
            sm.Free(s)
        end
    end
    if cok:
        lb := lo.FindLayout(a, prog)
        if lb != 0:
            mut diag_e := dg.New(lgr, lg.PH_CODEGEN)
            res := lo.Generate(lgr, diag_e, "<repl>", a, lb, false)
            if dg.ErrorCount(diag_e) == 0:
                print lo.Document(res, true, "", "", false)
            end
            dg.Free(diag_e)
        else:
            io.EPrintln("error: no layout block found")
        end
    end
    at.FreeAst(a)
end

// repl_layout_turn
func layout_turn(opt &: dr.Dr, pack: int, first_line: str, block: str):
    p := str.TrimLeft(first_line)
    if str.StartsWith(p, "layout") && (
        str.Len(p) == 6 || byte_at(p, 6) == 58 || byte_at(p, 6) == 32 || byte_at(p, 6) == 9
    ):
        layout_exec(opt, pack, block)
        ret
    end
    io.EPrintln("error: layout REPL only accepts 'layout: ... end' blocks")
end

// ===========================================================================
// ===== repl.c: commands ====================================================
// ===========================================================================

func help(is_layout: bool):
    if is_layout:
        println "Layout REPL commands:"
        println "  :clear  erase accumulated session"
        println "  :defs   show current session"
        println "  :quit   exit  (also: :q  quit  exit  q  Ctrl-D)"
        println "  :abort  at the '...' prompt, abandon the block being typed"
        println ""
        println "Type a 'layout: ... end' block to render HTML inline."
        println "Blocks can span multiple lines - the REPL waits until the block"
        println "parses (every ':' opener matched by an 'end') before running."
        println ""
        println "Root-level attributes: title, lang, dir"
        println "Common elements:  box  heading  p  link  image  input  button"
        println "Element attrs:    content  color  background  font-size  ..."
        println ""
        println `Example:`
        println `  layout: title = "Hi" box: heading: size = 1 content = "Hello" end end end`
        ret
    end
    println "Commands:"
    println "  :run        rebuild and run the whole session, showing all output"
    println "  :defs       print the session as one program"
    println "  :undo       drop the last statement"
    println "  :save FILE  write the session to FILE"
    println "  :load FILE  read FILE in as though it had been typed"
    println "  :clear      erase the session"
    println "  :quit       exit  (also: :q  quit  exit  q  Ctrl-D)"
    println "  :abort      at the '...' prompt, abandon the block being typed"
    println ""
    println "Definitions (func/struct/enum/type/const/import/extern) are kept and"
    println "sorted into a legal program; typing a name again redefines it."
    println "Statements accumulate in a synthesized main, so a variable bound on one"
    println "line is still there on the next, and binding it again changes it - to a"
    println "new value or to a new type. A bare expression is printed."
    println "Any block waits for the line that completes it (a matching 'end')."
    println ""
    println "Every turn re-runs the session from the top, so a statement with an"
    println "outside effect (writing a file, sending a request) happens again each"
    println "time. Only the new output is shown."
end

func save_session(s &: Session, pack: int, arg: str):
    path := str.TrimLeft(arg)
    if str.Len(path) == 0:
        println "usage: :save FILE"
        ret
    end
    text := render(s, pack, no_cand(), false)
    if io.WriteFile(path, text) < 0:
        println "could not write " + path
        ret
    end
    println "saved to " + path
end

// :load - the other half of :save. The file is read as though it had been
// typed: split into turns by the same "does this parse yet?" test the
// prompt uses, and each turn taken through the same def/statement path, so
// a definition replaces one of the same name and a statement joins main
// and runs. A turn that does not survive its check leaves the session
// alone, exactly as at the prompt, and the rest of the file still loads.
func load_session(opt &: dr.Dr, s &: Session, pack: int, is_layout: bool, arg: str):
    path := str.TrimLeft(arg)
    if str.Len(path) == 0:
        println "usage: :load FILE"
        ret
    end
    if !os.Exists(path):
        println "could not read " + path
        ret
    end
    text := io.ReadFile(path)
    lines := str.Split(text, "\n")
    mut block := ""
    mut turns := 0
    repeat lines.len() with i:
        line := lines.get(i)
        // A blank line outside a block is nothing; inside one it belongs to
        // the block being built.
        if str.Len(block) == 0 && str.Len(str.TrimLeft(line)) == 0:
            continue
        end
        block += line + "\n"
        mut name := ""
        kind := classify(pack, block, name)
        if incomplete(pack, block, !is_layout && kind == RS_STMT):
            continue
        end
        if is_layout:
            layout_turn(opt, pack, line, block)
        else kind != RS_STMT:
            turn_def(opt, s, pack, kind, name, block)
        else s.has_main:
            println lp.Entry(pack) + " is defined - ':run' to execute, ':clear' to start over."
        else:
            turn_stmt(opt, s, pack, block)
        end
        turns += 1
        block = ""
    end
    if str.Len(str.TrimLeft(block)) > 0:
        io.EPrintln("error: " + path + " ends in the middle of a block")
    end
    println "loaded " + path + " (" + co.I64Toa(turns as i64) + " turn(s))."
end

// `main()` typed at the prompt reads as "run it", the same shorthand the
// REPL has always accepted, in the session's own language.
func wants_run(pack: int, line: str): bool:
    entry := lp.Entry(pack)
    p := skip_ws(line, 0)
    ret str.StartsWith(str.Substr(line, p, str.Len(line) - p), entry + "()")
end

func is_save_cmd(line: str): bool:
    ret str.StartsWith(line, ":save") && (str.Len(line) == 5 || byte_at(line, 5) == 32)
end

func is_load_cmd(line: str): bool:
    ret str.StartsWith(line, ":load") && (str.Len(line) == 5 || byte_at(line, 5) == 32)
end

func cmd_run(opt &: dr.Dr, s &: Session, pack: int, is_layout: bool):
    if is_layout:
        println "layout REPL: type 'layout: ... end' blocks to render HTML."
        ret
    end
    if !s.has_main && s.stmts.len() == 0:
        println "nothing to run yet - type a statement, or define " + lp.Entry(pack) + "."
        ret
    end
    text := render(s, pack, no_cand(), false)
    _rc := exec_session(opt, text, false)
end

// driver_repl - the interactive loop.
pub func Run(opt &: dr.Dr): int:
    g_hist = Vector {} as Vector<str>
    g_last_out = ""
    g_has_last = false
    pack := lp.Load(opt.lang)
    if pack == lp.LP_NONE:
        io.EPrintln(
            co.Format1(i18.Tr("unknown language pack '%s'"), co.ArgStr(opt.lang))
        )
        ret 2
    end
    sm.SetStdlibRoot(opt.stdlib_path)
    sm.LayoutSchemaInit(opt.stdlib_path)
    // A turn is a fragment of a program still being written: a binding
    // whose first use is on the next line, a helper defined before its
    // caller. See sm.SetRelaxUnused.
    sm.SetRelaxUnused(true)
    is_layout := opt.command == dr.CMD_REPL_LAYOUT
    which := is_layout ? "layout" : "general"
    println "Salam " + which + " REPL (lang=" + opt.lang + "). ':help' for commands."
    mut ses := Session {}

    mut running := true
    until running:
        mut ok := false
        line := readline("salam> ", ok)
        if !ok:
            running = false
        else str.Len(line) == 0:
            _blank := 0 // blank line, just re-prompt
        else str.Equals(line, ":quit") || str.Equals(line, ":q") || str.Equals(line, "quit") || str.Equals(line, "exit") || str.Equals(line, "q"):
            running = false
        else str.Equals(line, ":help"):
            help(is_layout)
            hist_push(line)
        else str.Equals(line, ":clear"):
            ses = Session {}
            g_last_out = ""
            g_has_last = false
            println "session cleared."
            hist_push(line)
        else str.Equals(line, ":defs"):
            // render() always writes at least the synthesized main, so
            // "nothing typed yet" has to be recognized before it, not
            // from the rendered text being empty (it never is).
            if ses.defs.len() == 0 && ses.stmts.len() == 0:
                println "(empty)"
            else:
                print render(ses, pack, no_cand(), false)
            end
            hist_push(line)
        else str.Equals(line, ":undo"):
            println session_undo(ses) ? "dropped the last statement." : "no statement to drop."
            hist_push(line)
        else is_save_cmd(line):
            save_session(ses, pack, str.Substr(line, 5, str.Len(line) - 5))
            hist_push(line)
        else is_load_cmd(line):
            load_session(
                opt, ses, pack, is_layout, str.Substr(line, 5, str.Len(line) - 5)
            )
            hist_push(line)
        else str.Equals(line, ":run") || wants_run(pack, line):
            cmd_run(opt, ses, pack, is_layout)
            hist_push(line)
        else byte_at(line, 0) == 58:
            // Nothing in this language starts a statement with ':', so a
            // line that does is a command that was meant - and mistyped, or
            // typed where it does not apply (`:abort` belongs at the '...'
            // prompt). Saying so beats a parse error about ':'.
            if str.Equals(line, ":abort"):
                println "nothing to abandon - :abort answers the '  ... ' prompt."
            else:
                println co.Format1(
                    i18.Tr("unknown command '%s' - ':help' lists them."), co.ArgStr(line)
                )
            end
            hist_push(line)
        else:
            // Classified before the block is read: which framing the
            // turn completes in (a top-level definition, or a statement
            // inside main) is decided by its first line. A layout block
            // is top-level whatever `layout` classifies as.
            mut name := ""
            first_kind := classify(pack, line, name)
            mut blk_ok := true
            block := read_block(pack, line, !is_layout && first_kind == RS_STMT, blk_ok)
            if blk_ok:
                if is_layout:
                    layout_turn(opt, pack, line, block)
                else:
                    // Read again off the whole block: a turn that opens
                    // with `@en "..."` markers names what it defines on a
                    // later line, which only the finished block has.
                    kind := classify(pack, block, name)
                    if kind != RS_STMT:
                        turn_def(opt, ses, pack, kind, name, block)
                    else ses.has_main:
                        println lp.Entry(pack) + " is defined - ':run' to execute, ':clear' to start over."
                    else:
                        turn_stmt(opt, ses, pack, block)
                    end
                end
            end
            hist_push(line)
        end
    end
    println "bye."
    g_hist = Vector {} as Vector<str>
    ret 0
end
