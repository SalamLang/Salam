// Flat single-file module (see salam/PORTING.md "Layout - FLAT").
// File stem is sal_fmt (NOT fmt) because a file named fmt.salam would
// collide with the stdlib fmt module in the driver's salam_mod_<stem>.c
// naming - the package is still `fmt`.
//
// ===== port of compiler/src/fmt/ =====
// fmt_rules.c + fmt.c - the token-based reformatter behind `salam format`
// (indentation, spacing, comment preservation; the lexer runs with
// keep_comments=true, see lexer.RunEx).
//
// fmt_order.c (fmt_reorder_toplevel - the opt-in `--fix-order` pass) is NOT
// ported yet: it needs parser_run and sema_check_toplevel_order, and neither
// the parser nor the semantic module has been ported. Port it here once
// salam/parser.salam and salam/semantic.salam land.
//
// C differences:
// - fmt_ctx_t's fixed C arrays (ml_stack, paren_is_lambda, block_line,
//   in_match_arms, q_open) are pre-sized Vectors owned by Tokens() and freed
//   there; bool arrays hold int 0/1. Capacities and bound checks match the C
//   FMT_MAX_BRACKET/FMT_MAX_BLOCK limits exactly.
// - `const token_t *prev` (NULL until the first token) is has_prev +
//   prev_kind/prev_end_index copies - those are the only fields the C reads.
// - sb_t -> str.StringBuilder through core's Sb* wrappers.
// - fmt_source's arena/logger plumbing: the arena is gone; the token stream
//   is freed before returning.
// - fmt_style_t consumers can't build cross-package struct literals, so
//   StyleDefault()/NewStyle() are the constructors.
// - All span line/index fields (u32 in C) are compared as int (casts at the
//   token boundary); values are far below 2^31 so semantics are identical.
package fmt

import str
import co "sal_core.salam"
import src "source.salam"
import tok "token.salam"
import lg "logger.salam"
import lx "lexer/lexer.salam"
import ps "parser/parser.salam"
import at "ast.salam"

// fmt_internal.h / fmt.c
pub const FMT_INDENT_WIDTH := 4
const FMT_MAX_BRACKET := 256
const FMT_MAX_BLOCK := 256
const FMT_WRAP_WIDTH := 100

// fmt_style_t
// ord_item_t
struct OrdItem:
    pub node: int = 0
    pub phase: int = 0
    pub ustart: int = 0
    pub uend: int = 0
end

pub struct FmtStyle:
    pub tabs: bool = false
    pub width: int = 0
    // Strip everything the lexer treats as trivia: comments (line, block and
    // doc), indentation, and blank lines. Statement-terminating newlines are
    // NOT presentation and are always kept - TK_STMT_END is a real token, and
    // dropping it would weld statements together. Used to shrink the `std/`
    // tree that gets preloaded into the wasm playground.
    pub minify: bool = false
end

// fmt_ctx_t (st is carried alongside; the vectors are the C fixed arrays)
struct FmtCtx:
    pub st: FmtStyle = FmtStyle {}
    pub indent: int = 0
    pub bracket: int = 0
    pub angle: int = 0
    pub bracket_indent: int = 0
    pub ml_stack: Vector<int> = Vector {} // bool[FMT_MAX_BRACKET]
    pub paren_is_lambda: Vector<int> = Vector {} // bool[FMT_MAX_BRACKET]
    pub prev_close_was_lambda: bool = false
    pub ml_top: int = 0
    pub block_line: Vector<int> = Vector {} // uint32_t[FMT_MAX_BLOCK]
    pub in_match_arms: Vector<int> = Vector {} // bool[FMT_MAX_BLOCK]
    pub block_top: int = 0
    pub line_has_content: bool = false
    pub force_break: bool = false
    pub no_space_next: bool = false
    pub prev_gt_generic: bool = false
    pub q_open: Vector<int> = Vector {} // int[FMT_MAX_BRACKET + 1]
    pub stmt_head: int = 0 // token kind; TK_EOF = unset
    pub match_pending: bool = false
    pub open_colon_line: int = 0
    pub has_prev: bool = false // C: prev != NULL
    pub prev_kind: int = 0
    pub prev_end_index: int = 0
    pub prev_unary: bool = false
    pub prev_after_dot: bool = false
    pub prev_end_line: int = 0
end

// ===== fmt_rules.c =====
// fmt_is_value_end
// core/sb.c byte access, spelled the way every other ported file spells it.
inline func byte_at(s: str, i: int): int: ret co.ByteAt(s, i) end

func is_value_end(k: int): bool:
    ret k == tok.TK_IDENT || k == tok.TK_INT || k == tok.TK_FLOAT || k == tok.TK_STRING || k == tok.TK_TRIPLE_STRING || k == tok.TK_RAW_STRING || k == tok.TK_CHAR || k == tok.TK_UTF8_CHAR || k == tok.TK_RPAREN || k == tok.TK_RBRACKET || k == tok.TK_RBRACE || k == tok.TK_KW_TRUE || k == tok.TK_KW_FALSE || k == tok.TK_KW_NULL || k == tok.TK_KW_THIS
end

// fmt_is_open
func is_open(k: int): bool:
    ret k == tok.TK_LPAREN || k == tok.TK_LBRACKET || k == tok.TK_LBRACE
end

// fmt_is_close
func is_close(k: int): bool:
    ret k == tok.TK_RPAREN || k == tok.TK_RBRACKET || k == tok.TK_RBRACE
end

// fmt_gap_in_source (a's span.end.index / b's span.begin.index)
func gap_in_source(a_end_index: int, b_begin_index: int): bool:
    ret b_begin_index > a_end_index
end

// fmt_need_space - pk/p_end come from the previous token, ck/c_begin from
// the current one (the only token_t fields the C function reads).
func need_space(pk: int, p_end: int, ck: int, c_begin: int, prev_unary: bool): bool:
    if pk == tok.TK_DOT || ck == tok.TK_DOT:
        ret false
    end
    if ck == tok.TK_COMMA || ck == tok.TK_COLON || ck == tok.TK_SEMICOLON:
        ret false
    end
    if ck == tok.TK_RPAREN || ck == tok.TK_RBRACKET:
        ret false
    end
    if (ck == tok.TK_PLUS_PLUS || ck == tok.TK_MINUS_MINUS) && is_value_end(pk):
        ret false
    end
    if pk == tok.TK_LPAREN || pk == tok.TK_LBRACKET:
        ret false
    end
    if pk == tok.TK_LBRACE && ck == tok.TK_RBRACE:
        ret false
    end
    if prev_unary:
        ret false
    end
    if ck == tok.TK_LPAREN:
        ret !is_value_end(pk)
    end
    if ck == tok.TK_LBRACKET:
        ret !is_value_end(pk)
    end
    if pk == tok.TK_LT || pk == tok.TK_GT || ck == tok.TK_LT || ck == tok.TK_GT || pk == tok.TK_SHL || pk == tok.TK_SHR || ck == tok.TK_SHL || ck == tok.TK_SHR:
        ret gap_in_source(p_end, c_begin)
    end
    if pk == tok.TK_STAR || ck == tok.TK_STAR:
        ret gap_in_source(p_end, c_begin)
    end
    ret true
end

// fmt_is_prefix
func is_prefix(k: int, has_prev: bool, prev_kind: int): bool:
    if k == tok.TK_NOT || k == tok.TK_TILDE:
        ret true
    end
    if k == tok.TK_MINUS || k == tok.TK_STAR || k == tok.TK_AMP:
        ret !has_prev || !is_value_end(prev_kind)
    end
    if k == tok.TK_PLUS_PLUS || k == tok.TK_MINUS_MINUS:
        ret !has_prev || !is_value_end(prev_kind)
    end
    ret false
end

// ===== fmt.c =====
// fmt_emit_indent
func emit_indent(out &: str.StringBuilder, style: FmtStyle, indent0: int):
    mut indent := indent0
    if indent < 0:
        indent = 0
    end
    if style.minify:
        ret
    end
    if style.tabs:
        mut s := 0
        until s < indent:
            co.SbPutc(out, 9) // '\t'
            s += 1
        end
    else:
        mut s := 0
        until s < indent * style.width:
            co.SbPutc(out, 32) // ' '
            s += 1
        end
    end
end

// fmt_bracket_multiline
func bracket_multiline(ts: tok.TokenStream, open_idx: int): bool:
    o := tok.StreamAt(ts, open_idx)
    n := tok.StreamCount(ts)
    mut depth := 0
    mut i := open_idx
    until i < n:
        t := tok.StreamAt(ts, i)
        if t.kind == tok.TK_EOF:
            break
        end
        if is_open(t.kind):
            depth += 1
        else is_close(t.kind):
            depth -= 1
            if depth == 0:
                ret (t.end_line as int) > (o.begin_line as int)
            end
        end
        i += 1
    end
    ret false
end

// fmt_angle_is_generic
func angle_is_generic(ts: tok.TokenStream, lt_idx: int): bool:
    n := tok.StreamCount(ts)
    mut depth := 0
    mut steps := 0
    mut i := lt_idx
    until i < n && steps < 256:
        k := tok.StreamAt(ts, i).kind
        if k == tok.TK_LT:
            depth += 1
        else k == tok.TK_GT:
            depth -= 1
            if depth == 0:
                ret true
            end
        else k == tok.TK_SHR:
            // '>>' closes two generic levels at once (e.g. 'A<B<C>>').
            depth -= 2
            if depth <= 0:
                ret true
            end
        else k != tok.TK_IDENT && k != tok.TK_COMMA && k != tok.TK_DOT && k != tok.TK_STAR && k != tok.TK_AMP && k != tok.TK_LBRACKET && k != tok.TK_RBRACKET && k != tok.TK_COLON:
            ret false
        end
        i += 1
        steps += 1
    end
    ret false
end

// fmt_lambda_header_at - every lambda parameter is mandatorily typed
// ('name: Type'), so a '(' only opens a lambda header if its contents fully
// match that shape. Used to tell a lambda's parameter list apart from an
// unrelated grouped expression that simply happens to sit in front of a ':'
// (e.g. an 'if (a) || (b):' condition).
func lambda_header_at(ts: tok.TokenStream, open_idx: int): bool:
    n := tok.StreamCount(ts)
    mut i := open_idx + 1
    if i < n && tok.StreamAt(ts, i).kind == tok.TK_RPAREN:
        ret true
    end
    until true:
        if i >= n || tok.StreamAt(ts, i).kind != tok.TK_IDENT:
            ret false
        end
        i += 1
        if i >= n || tok.StreamAt(ts, i).kind != tok.TK_COLON:
            ret false
        end
        i += 1
        mut depth := 0
        until true:
            if i >= n:
                ret false
            end
            k := tok.StreamAt(ts, i).kind
            if k == tok.TK_EOF:
                ret false
            end
            if k == tok.TK_LT && angle_is_generic(ts, i):
                depth += 1
            else k == tok.TK_GT && depth > 0:
                depth -= 1
            else k == tok.TK_SHR && depth > 0:
                depth -= 2
                if depth < 0:
                    depth = 0
                end
            else is_open(k):
                depth += 1
            else is_close(k):
                if depth == 0:
                    ret k == tok.TK_RPAREN
                end
                depth -= 1
            else k == tok.TK_COMMA && depth == 0:
                i += 1
                break
            end
            i += 1
        end
    end
end

// fmt_head_modifier
func head_modifier(k: int): bool:
    ret k == tok.TK_KW_PUB || k == tok.TK_KW_INLINE || k == tok.TK_KW_NOINLINE || k == tok.TK_KW_PURE || k == tok.TK_KW_NORET || k == tok.TK_KW_DEPRECATED
end

// fmt_is_overload_symbol
func is_overload_symbol(k: int): bool:
    ret k == tok.TK_GT || k == tok.TK_PLUS || k == tok.TK_MINUS || k == tok.TK_STAR || k == tok.TK_SLASH || k == tok.TK_PERCENT || k == tok.TK_POWER || k == tok.TK_EQ || k == tok.TK_NE || k == tok.TK_LT || k == tok.TK_LE || k == tok.TK_GE || k == tok.TK_NOT
end

// fmt_head_annotates
func head_annotates(k: int): bool:
    ret k == tok.TK_IDENT || k == tok.TK_KW_MUT || k == tok.TK_KW_CONST || k == tok.TK_KW_THIS
end

// fmt_type_token
func type_token(k: int): bool:
    ret k == tok.TK_IDENT || k == tok.TK_DOT || k == tok.TK_STAR || k == tok.TK_AMP || k == tok.TK_LT || k == tok.TK_GT || k == tok.TK_SHR || k == tok.TK_LBRACKET || k == tok.TK_RBRACKET || k == tok.TK_LPAREN || k == tok.TK_RPAREN || k == tok.TK_COMMA || k == tok.TK_INT || k == tok.TK_KW_FUNC
end

// fmt_colon_is_annotation
func colon_is_annotation(ts: tok.TokenStream, colon_idx: int): bool:
    n := tok.StreamCount(ts)
    line := tok.StreamAt(ts, colon_idx).end_line as int
    mut saw_type := false
    mut is_func_type := false
    mut steps := 0
    mut j := colon_idx + 1
    until j < n && steps < 64:
        t := tok.StreamAt(ts, j)
        if (t.begin_line as int) > line:
            ret saw_type
        end
        if t.kind == tok.TK_COLON || t.kind == tok.TK_STMT_END || t.kind == tok.TK_EOF:
            ret saw_type
        end
        if t.kind == tok.TK_KW_FUNC && !saw_type:
            is_func_type = true
        end
        // salam's type grammar has no use for '(' except a function-pointer
        // type's own parameter list ('func(int): bool'); anywhere else a
        // '(' means this is actually a call expression (e.g. 'f(a)' or
        // 'x.f(a)', like a same-line if-branch body: 'if x: f(a, b)') and
        // this colon isn't a type annotation at all.
        if t.kind == tok.TK_LPAREN && !is_func_type:
            ret false
        end
        if !type_token(t.kind):
            ret false
        end
        saw_type = true
        j += 1
        steps += 1
    end
    ret false
end

// fmt_step_stmt_end
func step_stmt_end(c &: FmtCtx, out &: str.StringBuilder, t: tok.Token, cur_ml: bool):
    if c.bracket > 0:
        if cur_ml:
            c.force_break = true
        end
        ret
    end
    if c.line_has_content && str.StartsWith(t.lexeme, ";"):
        co.SbPuts(out, "; ")
        c.no_space_next = true
        c.has_prev = true
        c.prev_kind = t.kind
        c.prev_end_index = t.end_index as int
        c.prev_end_line = t.end_line as int
        c.stmt_head = tok.TK_EOF
        ret
    end
    if c.line_has_content:
        co.SbPutc(out, 10) // '\n'
        c.line_has_content = false
    end
    c.force_break = false
    c.open_colon_line = 0
    c.q_open[0] = 0
    c.stmt_head = tok.TK_EOF
    c.match_pending = false
end

// fmt_step_break_before
func step_break_before(
    c &: FmtCtx, out &: str.StringBuilder, t: tok.Token, k: int, cur_ml: bool
):
    if c.bracket > 0 && is_close(k) && cur_ml:
        if c.bracket_indent > 0:
            c.bracket_indent -= 1
        end
        if c.line_has_content:
            co.SbPutc(out, 10)
            c.line_has_content = false
        end
        c.force_break = false
    end
    if c.force_break && c.line_has_content:
        co.SbPutc(out, 10)
        c.line_has_content = false
        c.force_break = false
    end
    if c.open_colon_line != 0 && c.line_has_content && (t.begin_line as int) > c.open_colon_line:
        co.SbPutc(out, 10)
        c.line_has_content = false
    end
    c.open_colon_line = 0
    if c.bracket == 0 && c.prev_gt_generic && c.line_has_content && (t.begin_line as int) > c.prev_end_line:
        co.SbPutc(out, 10)
        c.line_has_content = false
        c.force_break = false
        c.q_open[0] = 0
        c.stmt_head = tok.TK_EOF
        c.match_pending = false
    end
end

// fmt_in_match_arms
func in_match_arms_now(c &: FmtCtx): bool:
    ret c.block_top > 0 && c.block_top <= FMT_MAX_BLOCK && c.in_match_arms[c.block_top - 1] != 0
end

// fmt_step_dedent
func step_dedent(c &: FmtCtx, out &: str.StringBuilder, t: tok.Token, k: int):
    if k == tok.TK_KW_ELSE && in_match_arms_now(c):
        ret
    end
    if c.bracket == 0 && c.angle == 0 && (k == tok.TK_KW_END || k == tok.TK_KW_ELSE):
        if c.block_top > 0 && c.block_top <= FMT_MAX_BLOCK && c.line_has_content && (t.begin_line as int) > c.block_line[c.block_top - 1]:
            co.SbPutc(out, 10)
            c.line_has_content = false
            c.force_break = false
        end
        if c.block_top > 0:
            c.block_top -= 1
        end
        if c.indent > 0:
            c.indent -= 1
        end
    end
end

// fmt_step_leading
func step_leading(c &: FmtCtx, out &: str.StringBuilder, t: tok.Token, k: int):
    if !c.line_has_content:
        if !c.st.minify && c.bracket == 0 && c.has_prev && (t.begin_line as int) > c.prev_end_line + 1:
            co.SbPutc(out, 10)
        end
        emit_indent(out, c.st, c.indent + c.bracket_indent)
    else !c.no_space_next:
        mut need := need_space(
            c.prev_kind, c.prev_end_index, k, t.begin_index as int, c.prev_unary
        )
        if c.prev_gt_generic && (k == tok.TK_LPAREN || k == tok.TK_LBRACKET):
            need = false
        end
        // A name right after '.' is always a member/method reference, even
        // if it happens to collide with a statement keyword (e.g. the
        // 'repeat' loop keyword doubling as a method name in 's.repeat(n)')
        // - it should never get keyword-style spacing before '('.
        if k == tok.TK_LPAREN && c.prev_after_dot:
            need = false
        end
        if k == tok.TK_COLON && c.bracket <= FMT_MAX_BRACKET && c.q_open[c.bracket] > 0:
            need = true
        end
        if need:
            co.SbPutc(out, 32)
        end
    end
    c.no_space_next = false
    c.prev_gt_generic = false
end

// fmt_current_column - bytes emitted since the last newline in the output
// buffer, used to wrap long multiline bracket contents (see the TK_COMMA
// case below) instead of reflowing an unbounded number of elements onto a
// single line.
func current_column(out &: str.StringBuilder): int:
    n := co.SbLen(out) as int
    if n == 0:
        ret 0
    end
    p := out.data as i8*
    mut i := n
    until i <= 0 || p[i - 1] == 10:
        i -= 1
    end
    ret n - i
end

// fmt_step_state_after
func step_state_after(
    c &: FmtCtx, out &: str.StringBuilder, t: tok.Token, k: int, ts: tok.TokenStream, i: int
):
    if c.bracket == 0 && k == tok.TK_KW_END:
        c.stmt_head = tok.TK_EOF
    else c.bracket == 0 && k == tok.TK_KW_ELSE:
        c.stmt_head = tok.TK_KW_ELSE
    end
    if c.stmt_head == tok.TK_EOF && c.bracket == 0 && k != tok.TK_KW_END && k != tok.TK_COLON && k != tok.TK_COMMENT_LINE && k != tok.TK_COMMENT_BLOCK && !head_modifier(k):
        c.stmt_head = k
    end

    if k == tok.TK_KW_MATCH && c.bracket == 0:
        c.match_pending = true
    end

    if k == tok.TK_COMMA && c.ml_top > 0 && c.ml_top <= FMT_MAX_BRACKET && c.ml_stack[c.ml_top - 1] != 0 && current_column(out) >= FMT_WRAP_WIDTH:
        c.force_break = true
    end

    if k == tok.TK_QUESTION && c.bracket <= FMT_MAX_BRACKET:
        c.q_open[c.bracket] = c.q_open[c.bracket] + 1
    end
    if k == tok.TK_COLON && c.bracket <= FMT_MAX_BRACKET && c.q_open[c.bracket] > 0:
        c.q_open[c.bracket] = c.q_open[c.bracket] - 1
    else c.bracket == 0 && c.angle == 0 && k == tok.TK_COLON:
        mut opener := false
        was_match_subject := c.match_pending
        was_in_match_arms := in_match_arms_now(c)
        if c.has_prev && c.prev_kind == tok.TK_RPAREN && c.prev_close_was_lambda:
            opener = true
        else was_match_subject:
            opener = true
        else was_in_match_arms:
            opener = true
        else head_annotates(c.stmt_head):
            opener = false
        else:
            opener = !colon_is_annotation(ts, i)
        end
        if opener:
            c.indent += 1
            c.open_colon_line = t.end_line as int
            if c.block_top < FMT_MAX_BLOCK:
                c.block_line[c.block_top] = t.begin_line as int
                c.in_match_arms[c.block_top] = was_match_subject ? 1 : 0
            end
            c.block_top += 1
            if c.has_prev && c.prev_kind == tok.TK_KW_ELSE && !was_in_match_arms:
                c.force_break = true
            end
            c.stmt_head = tok.TK_EOF
            c.match_pending = false
        end
    end

    if k == tok.TK_LT && c.has_prev && is_value_end(c.prev_kind) && !gap_in_source(c.prev_end_index, t.begin_index as int) && angle_is_generic(ts, i):
        c.angle += 1
    else k == tok.TK_GT && c.angle > 0:
        c.angle -= 1
        c.prev_gt_generic = true
    end

    if is_open(k):
        ml := bracket_multiline(ts, i)
        prev_is_value := c.has_prev && (is_value_end(c.prev_kind) || is_overload_symbol(c.prev_kind))
        is_lambda := k == tok.TK_LPAREN && !prev_is_value && lambda_header_at(ts, i)
        if c.ml_top < FMT_MAX_BRACKET:
            c.ml_stack[c.ml_top] = ml ? 1 : 0
            c.paren_is_lambda[c.ml_top] = is_lambda ? 1 : 0
        end
        c.ml_top += 1
        c.bracket += 1
        if c.bracket <= FMT_MAX_BRACKET:
            c.q_open[c.bracket] = 0
        end
        if ml:
            c.bracket_indent += 1
            c.force_break = true
        end
    else is_close(k):
        c.prev_close_was_lambda = k == tok.TK_RPAREN && c.ml_top > 0 && c.ml_top <= FMT_MAX_BRACKET && c.paren_is_lambda[c.ml_top - 1] != 0
        if c.ml_top > 0:
            c.ml_top -= 1
        end
        if c.bracket > 0:
            if c.bracket <= FMT_MAX_BRACKET:
                c.q_open[c.bracket] = 0
            end
            c.bracket -= 1
        end
    end

    c.prev_unary = is_prefix(k, c.has_prev, c.prev_kind)
    if k == tok.TK_COMMENT_LINE:
        c.force_break = true
    end
end

// ===== port of compiler/src/fmt/fmt_order.c =====
func ord_is_modifier_kind(k: int): bool:
    ret k == tok.TK_KW_PUB || k == tok.TK_KW_DEPRECATED || k == tok.TK_KW_INLINE || k == tok.TK_KW_NOINLINE || k == tok.TK_KW_PURE || k == tok.TK_KW_NORET
end

// Right-trim trailing whitespace/newlines from a raw [start,end) range.
func ord_rtrim_end(text: str, start: int, end0: int): int:
    mut e := end0
    until e > start:
        c := byte_at(text, e - 1)
        if c != 32 && c != 9 && c != 13 && c != 10:
            break
        end
        e -= 1
    end
    ret e
end

func ord_line_is_blank(text: str, a: int, b: int): bool:
    mut i := a
    until i < b:
        c := byte_at(text, i)
        if c != 32 && c != 9 && c != 13:
            ret false
        end
        i += 1
    end
    ret true
end

/*
 * True if the line [a,b) is a '//' comment or an '@lang "..."' annotation
 * line. Sets maybe_block if the line looks like it could open or close a block
 * comment - the caller treats that as "don't know, don't touch" rather than
 * guessing where the comment really begins.
 */
func ord_line_is_comment_or_meta(text: str, a: int, b: int, maybe_block &: bool): bool:
    mut i := a
    until i < b && (byte_at(text, i) == 32 || byte_at(text, i) == 9):
        i += 1
    end
    if i + 1 < b && byte_at(text, i) == 47 && byte_at(text, i + 1) == 47:
        ret true
    end
    if i < b && byte_at(text, i) == 64:
        ret true
    end
    mut j := a
    until j + 1 < b:
        if (byte_at(text, j) == 47 && byte_at(text, j + 1) == 42) || (byte_at(text, j) == 42 && byte_at(text, j + 1) == 47):
            maybe_block = true
            ret false
        end
        j += 1
    end
    ret false
end

func ord_prev_line_start(text: str, pos: int): int:
    if pos < 2:
        ret 0
    end
    mut i := pos - 1
    if byte_at(text, i) != 10:
        ret pos
    end
    if i == 0:
        ret 0
    end
    i -= 1
    until i > 0 && byte_at(text, i - 1) != 10:
        i -= 1
    end
    ret i
end

/*
 * Walk backward from `begin` (a line start) over a blank-line-free run of
 * immediately preceding comment/@meta lines, so those travel with the
 * declaration when it moves. Stops at the first blank or non-trivia line.
 */
func ord_scan_leading_trivia(text: str, begin: int, bail &: bool): int:
    mut cur := begin
    until true:
        if cur == 0:
            break
        end
        pstart := ord_prev_line_start(text, cur)
        pend := cur - 1
        if ord_line_is_blank(text, pstart, pend):
            break
        end
        mut maybe_block := false
        if !ord_line_is_comment_or_meta(text, pstart, pend, maybe_block):
            if maybe_block:
                bail = true
            end
            break
        end
        if pstart == cur:
            break
        end
        cur = pstart
    end
    ret cur
end

// Extend forward past a trailing same-line '// comment' so it is not orphaned
// when the declaration in front of it moves.
func ord_extend_trailing_comment(text: str, len0: int, end0: int): int:
    mut i := end0
    until i < len0 && (byte_at(text, i) == 32 || byte_at(text, i) == 9):
        i += 1
    end
    if i + 1 < len0 && byte_at(text, i) == 47 && byte_at(text, i + 1) == 47:
        until i < len0 && byte_at(text, i) != 10:
            i += 1
        end
        ret i
    end
    ret end0
end

func ord_is_entry_point(a &: at.Ast, d: int, entry: str): bool:
    n := at.Get(a, d)
    if d == 0 || n.kind != at.AST_FUNC_DEF || str.Len(n.name) == 0:
        ret false
    end
    if str.Equals(n.name, "main"):
        ret true
    end
    ret str.Len(entry) > 0 && str.Equals(n.name, entry)
end

func ord_is_movable(a &: at.Ast, d: int, entry: str): bool:
    if d == 0:
        ret false
    end
    n := at.Get(a, d)
    if n.synthetic:
        ret false
    end
    // Member of an 'extern: end' block; no wrapper span exists to relocate
    // it out of.
    if n.is_extern:
        ret false
    end
    /*
     * The entry point is conventionally last regardless of visibility and is
     * exempt from the pub-ordering rule - matching check_pub_order's own
     * exemption - so it is never relocated either.
     */
    if ord_is_entry_point(a, d, entry):
        ret false
    end
    ret at.ToplevelOrderPhase(a, d) != at.AST_ORDER_NONE
end

func ord_adjusted_begin(toks: tok.TokenStream, tok_idx: int): int:
    mut i := tok_idx
    until i > 0 && ord_is_modifier_kind(tok.StreamAt(toks, i - 1).kind):
        i -= 1
    end
    ret tok.StreamAt(toks, i).begin_index as int
end

/*
 * An AST_IMPORT node's span starts *after* its 'import' keyword, because the
 * parser consumes the keyword before building any entry - unlike AST_LINK,
 * whose node is created while the cursor still sits on 'link'. On top of that
 * one `import "a" "b" "c"` statement yields three sibling nodes sharing that
 * single keyword.
 *
 * Both fall out of one observation: an entry begins a new import *statement*
 * exactly when the token in front of it is the keyword. That identifies the
 * statement's true start, and every following entry that is not so preceded is
 * a continuation to fold into the same movable unit.
 */
func ord_import_starts_statement(toks: tok.TokenStream, tok_idx: int): bool:
    ret tok_idx > 0 && tok.StreamAt(toks, tok_idx - 1).kind == tok.TK_KW_IMPORT
end

func ord_find_token_for_begin(toks: tok.TokenStream, cursor &: int, begin_index: int): int:
    n := tok.StreamCount(toks)
    mut i := cursor
    until i < n:
        if (tok.StreamAt(toks, i).begin_index as int) == begin_index:
            cursor = i
            ret i
        end
        i += 1
    end
    ret n
end

func ord_sort_key(a &: at.Ast, it: OrdItem): int:
    mut secondary := 0
    if it.phase == at.AST_ORDER_FUNC && at.Get(a, it.node).is_pub:
        secondary = 1
    end
    ret it.phase * 2 + secondary
end

// Stable insertion sort (small n, and stability is what keeps declarations in
// their original relative order inside one phase).
func ord_stable_sort(a &: at.Ast, items &: Vector<OrdItem>):
    n := items.len()
    mut i := 1
    until i < n:
        key := items.get(i)
        kkey := ord_sort_key(a, key)
        mut j := i
        until j > 0 && ord_sort_key(a, items.get(j - 1)) > kkey:
            items.set(j, items.get(j - 1))
            j -= 1
        end
        items.set(j, key)
        i += 1
    end
end

/*
 * Hoist a misplaced `package` line to the top of the file.
 *
 * This one cannot be done with the rest: a package below the first statement
 * is rejected by the *parser* ("only as the very first statement"), so there
 * is no tree left to reorder. It therefore runs on the token stream, before
 * any parse is attempted, and rewrites the text so the parse can succeed.
 *
 * Only `@meta` annotations may legitimately precede a package declaration, so
 * anything else in front of the keyword means it is misplaced.
 */
func ord_hoist_package(text: str, len0: int, toks: tok.TokenStream, out &: str.StringBuilder): bool:
    n := tok.StreamCount(toks)
    mut kw := n
    mut i := 0
    until i < n:
        k := tok.StreamAt(toks, i).kind
        if k == tok.TK_KW_PACKAGE:
            kw = i
            break
        end
        if k != tok.TK_META && k != tok.TK_STMT_END && k != tok.TK_EOF:
            // A real statement came first - any package below it is misplaced.
            mut j := i
            until j < n:
                if tok.StreamAt(toks, j).kind == tok.TK_KW_PACKAGE:
                    kw = j
                    break
                end
                j += 1
            end
            break
        end
        i += 1
    end
    if kw >= n:
        ret false
    end
    // Already ahead of everything but annotations: nothing to do.
    mut only_meta := true
    mut m := 0
    until m < kw:
        k2 := tok.StreamAt(toks, m).kind
        if k2 != tok.TK_META && k2 != tok.TK_STMT_END:
            only_meta = false
            break
        end
        m += 1
    end
    if only_meta:
        ret false
    end
    if kw + 1 >= n:
        ret false
    end
    mut bail := false
    ustart := ord_scan_leading_trivia(text, tok.StreamAt(toks, kw).begin_index as int, bail)
    if bail:
        ret false
    end
    mut uend := tok.StreamAt(toks, kw + 1).end_index as int
    uend = ord_rtrim_end(text, ustart, uend)
    uend = ord_extend_trailing_comment(text, len0, uend)
    if uend <= ustart:
        ret false
    end
    /*
     * Insert in front of the first real declaration rather than at byte 0: a
     * file normally opens with a licence banner, and a package line shoved
     * above that reads as though it belongs to nothing. The banner is a block
     * comment, which ord_scan_leading_trivia deliberately refuses to walk
     * into, so the first declaration's own leading `//` comments are the
     * boundary - the package lands after the banner and before that
     * declaration's comment, where a hand-written one would.
     */
    /*
     * Skip a leading block-comment banner, if there is one. It cannot be found
     * by walking backward from the first declaration the way everything else
     * here does: ord_scan_leading_trivia refuses to enter a block comment on
     * purpose, so it stops at the banner rather than stepping over it.
     * Scanning forward from the top instead is unambiguous - the banner is
     * whatever block comment the file opens with.
     */
    mut ins := 0
    mut p := 0
    until p < len0 && (byte_at(text, p) == 32 || byte_at(text, p) == 9 || byte_at(text, p) == 13 || byte_at(text, p) == 10):
        p += 1
    end
    if p + 1 < len0 && byte_at(text, p) == 47 && byte_at(text, p + 1) == 42:
        mut q := p + 2
        until q + 1 < len0 && !(byte_at(text, q) == 42 && byte_at(text, q + 1) == 47):
            q += 1
        end
        if q + 1 < len0:
            q += 2
            until q < len0 && byte_at(text, q) != 10:
                q += 1
            end
            if q < len0:
                q += 1
            end
            until q < len0 && (byte_at(text, q) == 13 || byte_at(text, q) == 10):
                q += 1
            end
            if q < ustart:
                ins = q
            end
        end
    end
    co.SbPuts(out, str.Substr(text, 0, ins))
    co.SbPuts(out, str.Substr(text, ustart, uend - ustart))
    co.SbPuts(out, "\n\n")
    co.SbPuts(out, str.Substr(text, ins, ustart - ins))
    // Skip the blank line the moved block left behind.
    mut after := uend
    until after < len0 && (byte_at(text, after) == 32 || byte_at(text, after) == 9 || byte_at(text, after) == 13):
        after += 1
    end
    if after < len0 && byte_at(text, after) == 10:
        after += 1
    end
    co.SbPuts(out, str.Substr(text, after, len0 - after))
    ret true
end

func ord_push(items &: Vector<OrdItem>, node: int, phase: int, ustart: int, uend: int):
    items.push(OrdItem { node = node, phase = phase, ustart = ustart, uend = uend })
end

/*
 * fmt_reorder_toplevel - rewrite `sfile` with its top-level declarations in
 * canonical order, writing the result to `out`. Returns false (and copies the
 * text through unchanged) when the file cannot be lexed or parsed.
 */

// ---------------------------------------------------------------------------
// Public API (E088: pub section last)
// ---------------------------------------------------------------------------

// fmt_style_default
pub func StyleDefault(): FmtStyle:
    ret FmtStyle { tabs = false, width = FMT_INDENT_WIDTH }
end

// Constructor for non-default styles (cross-package struct literals are not
// supported); mirrors the driver's `style.tabs = opt->fmt_tabs; style.width =
// opt->fmt_indent_width` assignments.
pub func NewStyle(tabs: bool, width: int, minify: bool): FmtStyle:
    ret FmtStyle { tabs = tabs, width = width, minify = minify }
end

// fmt_tokens
pub func Tokens(ts: tok.TokenStream, style: FmtStyle, out &: str.StringBuilder):
    mut c := FmtCtx {}
    c.st = style
    defer c.ml_stack.free()
    defer c.paren_is_lambda.free()
    defer c.block_line.free()
    defer c.in_match_arms.free()
    defer c.q_open.free()
    mut z := 0
    until z < FMT_MAX_BRACKET:
        c.ml_stack.push(0)
        c.paren_is_lambda.push(0)
        c.block_line.push(0)
        c.in_match_arms.push(0)
        c.q_open.push(0)
        z += 1
    end
    c.q_open.push(0) // q_open has FMT_MAX_BRACKET + 1 slots

    n := tok.StreamCount(ts)
    mut i := 0
    until i < n:
        t := tok.StreamAt(ts, i)
        k := t.kind
        cur_ml := c.ml_top > 0 && c.ml_top <= FMT_MAX_BRACKET && c.ml_stack[c.ml_top - 1] != 0
        if k == tok.TK_EOF:
            break
        end
        if k == tok.TK_STMT_END:
            step_stmt_end(c, out, t, cur_ml)
            i += 1
            continue
        end
        // Comments are dropped before any state is touched, so they cannot
        // leave a force_break or a stale `prev` behind. A block comment that
        // spanned a newline already had its own TK_STMT_END emitted after it
        // by the lexer (scan_block_comment), so the statement boundary it
        // created survives even though the comment text does not.
        if c.st.minify && (k == tok.TK_COMMENT_LINE || k == tok.TK_COMMENT_BLOCK):
            i += 1
            continue
        end

        step_break_before(c, out, t, k, cur_ml)
        step_dedent(c, out, t, k)
        step_leading(c, out, t, k)

        if k == tok.TK_META:
            co.SbPutc(out, 64) // '@'
        end
        co.SbPuts(out, t.lexeme)
        c.line_has_content = true

        step_state_after(c, out, t, k, ts, i)
        c.prev_after_dot = c.has_prev && c.prev_kind == tok.TK_DOT
        c.has_prev = true
        c.prev_kind = k
        c.prev_end_index = t.end_index as int
        c.prev_end_line = t.end_line as int
        i += 1
    end
    if c.line_has_content:
        co.SbPutc(out, 10)
    end
end

// fmt_source - lexes with keep_comments=true (the formatter's lexing mode)
// and formats the token stream. Returns false when the lexer reported errors
// (out is left untouched, like the C version).
pub func Source(
    lgr: lg.Logger, pack: int, sfile: src.SourceFile, style: FmtStyle, out &: str.StringBuilder
): bool:
    mut toks := tok.StreamNew(sfile.path)
    ok := lx.RunEx(lgr, pack, sfile, true, toks)
    if !ok:
        tok.StreamFree(toks)
        ret false
    end
    Tokens(toks, style, out)
    tok.StreamFree(toks)
    ret true
end

/*
 * Salam Programming Language (2024-2026)
 *
 *   +-------------------+
 *   |     S A L A M     |
 *   +-------------------+
 *
 * Designed by Seyyed Ali Mohammadiyeh and the Salam Team
 * Born from a decade of language design experience (since 2018)
 *
 * Repository: https://github.com/SalamLang/Salam
 *
 */

/*
 * fmt_reorder_toplevel - rewrite `sfile` with its top-level declarations in
 * canonical order, writing the result to `out`. Returns false (and copies the
 * text through unchanged) when the file cannot be lexed or parsed.
 */
pub func ReorderToplevel(
    lgr: lg.Logger, pack: int, sfile: src.SourceFile, entry: str, out &: str.StringBuilder
): bool:
    mut text := sfile.text
    mut len0 := sfile.len

    mut toks := tok.StreamNew(sfile.path)
    if !lx.Run(lgr, pack, sfile, toks):
        co.SbPuts(out, text)
        tok.StreamFree(toks)
        ret false
    end

    /*
     * Runs before the parse, not after: a misplaced package is a *parse*
     * error, so leaving it in place would mean there is no tree to reorder and
     * every other fix in this file would be skipped too.
     */
    mut hoisted := co.SbNew()
    if ord_hoist_package(text, len0, toks, hoisted):
        htext := co.SbCstr(hoisted)
        mut hfile := src.New()
        hfile.path = sfile.path
        hfile.text = htext
        hfile.len = str.Len(htext)
        mut htoks := tok.StreamNew(sfile.path)
        if lx.Run(lgr, pack, hfile, htoks):
            tok.StreamFree(toks)
            toks = htoks
            text = htext
            len0 = str.Len(htext)
        else:
            tok.StreamFree(htoks)
        end
    end
    co.SbFree(hoisted)

    mut a := at.NewAst()
    mut program := 0
    if !ps.Run(lgr, toks, a, program) || program == 0:
        co.SbPuts(out, text)
        tok.StreamFree(toks)
        at.FreeAst(a)
        ret false
    end

    /*
     * Build the flat sequence of top-level "slots": either a movable
     * declaration with its true, trivia-inclusive text span, or a barrier
     * (extern member, top-level 'if', the entry point, or anything this scan
     * cannot confidently classify) that always stays exactly where it is.
     */
    mut items := Vector {} as Vector<OrdItem>
    prog := at.Get(a, program)
    mut tok_cursor := 0
    repeat prog.list.len() with li:
        d := prog.list.get(li)
        if d == 0 || at.Get(a, d).synthetic:
            continue
        end
        if !ord_is_movable(a, d, entry):
            ord_push(items, d, at.AST_ORDER_NONE, 0, 0)
            continue
        end
        tok_idx := ord_find_token_for_begin(toks, tok_cursor, at.Get(a, d).begin_index as int)
        if tok_idx >= tok.StreamCount(toks):
            ord_push(items, d, at.AST_ORDER_NONE, 0, 0)
            continue
        end
        if at.Get(a, d).kind == at.AST_IMPORT && !ord_import_starts_statement(toks, tok_idx):
            /*
             * A continuation entry of `import "a" "b"`: it has no keyword of
             * its own, so it cannot be a unit. Stretch the statement's unit
             * over it instead, and let it travel as one piece.
             */
            if items.len() > 0 && items.get(items.len() - 1).phase == at.AST_ORDER_IMPORT:
                mut prev := items.get(items.len() - 1)
                mut e := ord_rtrim_end(text, prev.ustart, at.Get(a, d).end_index as int)
                e = ord_extend_trailing_comment(text, len0, e)
                if e > prev.uend:
                    prev.uend = e
                    items.set(items.len() - 1, prev)
                end
                continue
            end
            ord_push(items, d, at.AST_ORDER_NONE, 0, 0)
            continue
        end
        mut adj_begin := ord_adjusted_begin(toks, tok_idx)
        if at.Get(a, d).kind == at.AST_IMPORT:
            adj_begin = tok.StreamAt(toks, tok_idx - 1).begin_index as int
        end
        mut bail := false
        ustart := ord_scan_leading_trivia(text, adj_begin, bail)
        if bail:
            ord_push(items, d, at.AST_ORDER_NONE, 0, 0)
            continue
        end
        /*
         * A node's end can land at column 1 of the FOLLOWING line (a
         * statement-terminator artifact), which would otherwise make this
         * item's extracted text quietly swallow the blank line separating it
         * from whatever comes next. Normalise back to its own content first.
         */
        mut uend := ord_rtrim_end(text, ustart, at.Get(a, d).end_index as int)
        uend = ord_extend_trailing_comment(text, len0, uend)
        ord_push(items, d, at.ToplevelOrderPhase(a, d), ustart, uend)
    end

    /*
     * Walk maximal runs of movable items, reordering each run in place -
     * verbatim text, never touching anything outside a run that actually needs
     * to change.
     */
    mut result := co.SbNew()
    mut cursor := 0
    mut r := 0
    until r < items.len():
        if items.get(r).phase == at.AST_ORDER_NONE:
            r += 1
            continue
        end
        run_start := r
        mut run_end := r
        until run_end + 1 < items.len() && items.get(run_end + 1).phase != at.AST_ORDER_NONE:
            run_end += 1
        end
        run_len := run_end - run_start + 1

        mut sorted := Vector {} as Vector<OrdItem>
        mut k := 0
        until k < run_len:
            sorted.push(items.get(run_start + k))
            k += 1
        end
        ord_stable_sort(a, sorted)

        mut changed := false
        mut c2 := 0
        until c2 < run_len:
            if sorted.get(c2).node != items.get(run_start + c2).node:
                changed = true
                break
            end
            c2 += 1
        end

        if changed:
            region_start := items.get(run_start).ustart
            region_end := items.get(run_end).uend
            co.SbPuts(result, str.Substr(text, cursor, region_start - cursor))
            mut w := 0
            until w < run_len:
                pstart := sorted.get(w).ustart
                pend := ord_rtrim_end(text, pstart, sorted.get(w).uend)
                co.SbPuts(result, str.Substr(text, pstart, pend - pstart))
                if w + 1 < run_len:
                    co.SbPuts(result, "\n\n")
                end
                w += 1
            end
            cursor = region_end
        end
        sorted.free()
        r = run_end + 1
    end
    co.SbPuts(result, str.Substr(text, cursor, len0 - cursor))

    co.SbPuts(out, co.SbCstr(result))
    co.SbFree(result)
    items.free()
    tok.StreamFree(toks)
    at.FreeAst(a)
    ret true
end
