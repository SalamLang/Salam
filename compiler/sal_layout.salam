// Flat port of compiler/src/layout's GENERATOR half (see salam/PORTING.md
// "Layout - FLAT"): layout_expand.c + layout_gen.c + layout_gen_element.c +
// layout_gen_value.c + layout_internal.h - one package `layout`, one file.
// File stem is sal_layout (NOT layout.salam): `layout` is a stdlib module
// name and would collide in the driver's salam_mod_<stem>.c naming.
// Import alias for consumers: `lo`.
//
// registry.c + schema.c are NOT here: semantic stage 5d already ported them
// into salam/semantic.salam (sema_layout.c needs them). This module reads
// the registry through the pub accessors added there (LayoutElemLookup /
// LayoutElemTag / LayoutElemKind / LayoutAttrLookup / LayoutAttrOut /
// LayoutAttrDest / LayoutAttrVtype / LayoutAttrAllowed / LayoutDynValue /
// LayoutMapColor) - the C linked both .c files against the same globals.
// layout_map_length/layout_map_unit (registry.c) were NOT in the 5d slice
// (sema treats VT_LENGTH as always-ok), so they are ported HERE, on top of
// sm.LayoutDynValue("unit", …).
//
// C differences (per salam/PORTING.md):
// - ast_node_t* -> NodeId ints into the shared at.Ast (0 = C NULL);
//   includes are lexed/parsed into the SAME Ast, like the shared C arena.
// - sb_t buffers -> plain `str` accumulation; arena_strdup/sb_free drop out.
// - const char* NULL vs "" is significant in layout_gen_element.c
//   (content/class/source/src/type/condition/selector), so each carries an
//   explicit has_* bool; "" alone plays NULL only where the C never stores
//   an empty string (registry lookups, dyn values, class names).
// - layout_result_t* -> pub struct Result returned by value.
// - LWARN -> dg.Report with a pre-formatted i18.Tr'd body (the C
//   diag_report i18n_tr's the format itself).
// - The LOG_* calls keep the C texts; messages are pre-formatted with
//   co.Format (the reference comparison strips logger lines anyway).
// - djb2() (layout_gen_value.c) is dead code in the C module - not ported.
// - comp_t/loaded_t vectors -> parallel Vectors in LoExpand; frame_t ->
//   LoFrame with a `present` flag standing in for the C NULL frame.
// - LoExpand's log/pack/cctab field defaults are throwaways overwritten by
//   Expand (same pattern as semantic.Sema); the default cctab is freed
//   before the caller's table is stored.
package layout

import str
import co "sal_core.salam"
import tok "token.salam"
import src "source.salam"
import lg "logger.salam"
import dg "diag.salam"
import i18 "i18n.salam"
import lp "langpack.salam"
import lx "lexer.salam"
import at "ast.salam"
import ps "parser.salam"
import cc "condcomp.salam"
import sm "semantic.salam"
import mn "minify.salam"

// LX_EXPAND_MAX_DEPTH (layout_expand.c)
const K_LO_MAX_DEPTH := 64
// LAYOUT_LEN_MAX_TOKENS (registry.c layout_map_length)
const K_LO_LEN_MAX_TOKENS := 24
// normalize_unit_phrase's char norm[128] / joined[128] caps (registry.c)
const K_LO_UNIT_CAP := 128
// layout_elem_type_t / layout_attr_dest_t / layout_value_type_t values
// (registry.h; K_LO_-prefixed - semantic.salam owns the unprefixed consts
// and package consts share one flat namespace).
const K_LO_LE_SINGLE := 0
const K_LO_LE_MOTHER := 1
const K_LO_LA_CONTENT := 0
const K_LO_LA_CLASS := 1
const K_LO_LA_HTML := 2
const K_LO_LA_STYLE := 3
const K_LO_LA_DIR := 4
const K_LO_LA_LANG := 5
const K_LO_LA_SOURCE := 6
const K_LO_LA_CSS := 7
const K_LO_LA_META := 8
const K_LO_VT_COLOR := 6
const K_LO_VT_DIR := 7
const K_LO_VT_LANG := 8
const K_LO_VT_ENUM := 9
const K_LO_VT_LENGTH := 10

// layout_result_t (layout_gen.h). "" plays the C NULL/empty string - the C
// generator always returns non-NULL fields.
pub struct Result:
    pub html: str = ""
    pub css: str = ""
    pub js: str = ""
    pub head: str = ""
    pub title: str = "Salam Page"
    pub lang: str = "en"
    pub dir: str = "ltr"
end

// expand_t (layout_expand.c): comps/loaded as parallel vectors.
struct LoExpand:
    pub log: lg.Logger = lg.New(5, false)
    pub pack: lp.Langpack = lp.Load("en")
    pub cctab: cc.Table = cc.TableBuild("", Vector {} as Vector<str>)
    pub errors: int = 0
    pub comp_name: Vector<str> = Vector {}
    pub comp_def: Vector<int> = Vector {}
    pub comp_dir: Vector<str> = Vector {}
    pub comp_mother: Vector<bool> = Vector {}
    pub loaded_path: Vector<str> = Vector {}
    pub loaded_prog: Vector<int> = Vector {}
    pub loaded_dir: Vector<str> = Vector {}
end

// frame_t (layout_expand.c); present=false is the C NULL frame pointer.
struct LoFrame:
    pub present: bool = false
    pub names: Vector<str> = Vector {}
    pub vals: Vector<int> = Vector {}
    pub content: Vector<int> = Vector {}
end

// layout_ctx_t (layout_internal.h); sb_t sinks are plain strs.
struct LoCtx:
    pub log: lg.Logger = lg.New(5, false)
    pub file: str = ""
    pub html: str = ""
    pub css: str = ""
    pub js: str = ""
    pub head: str = ""
    pub title: str = "Salam Page"
    pub lang: str = "en"
    pub dir: str = "ltr"
    pub css_seen: Vector<str> = Vector {}
    pub cls_keys: Vector<str> = Vector {}
    pub cls_names: Vector<str> = Vector {}
    pub cls_next: int = 0
    pub indent: int = 0
    pub compact: bool = false
end

// ---------------------------------------------------------------------------
// Byte access (same helper as the sibling module ports).
// ---------------------------------------------------------------------------
func byte_at(s: str, i: int): int:
    bp := (s as void*) as i8*
    mut v := bp[i] as int
    if v < 0:
        v += 256
    end
    ret v
end

// &node->span rebuilt as a co.SrcSpan (for diag reports).
func span_of(a &: at.Ast, id: int): co.SrcSpan:
    n := at.Get(a, id)
    ret co.MakeSpan(
        co.MakePos(n.begin_line, n.begin_col, n.begin_index), co.MakePos(n.end_line, n.end_col, n.end_index),
        n.length
    )
end

// Copies src's span fields onto dst (ast_new's span argument).
func copy_span(a &: at.Ast, dst: int, from: int):
    n := at.Get(a, from)
    at.SetSpan(
        a, dst, n.begin_line, n.begin_col, n.begin_index, n.end_line, n.end_col, n.end_index, n.length
    )
end

// ===========================================================================
// ===== layout_expand.c =====
// ===========================================================================

// is_include_attr - the C checks the en + fa spellings only.
func is_include_attr(n: str): bool:
    ret str.Equals(n, "include") || str.Equals(n, "بگنجان")
end

// is_content_word
func is_content_word(n: str): bool:
    ret str.Equals(n, "content") || str.Equals(n, "محتوا")
end

// dir_of - path prefix before the last '/' or '\\', "" if none.
func lo_dir_of(path: str): str:
    mut cut := 0 - 1
    n := str.Len(path)
    repeat n with i:
        b := byte_at(path, i)
        if b == 47 || b == 92:
            cut = i
        end
    end
    if cut < 0:
        ret ""
    end
    ret str.Substr(path, 0, cut)
end

// mk_str - a synthetic string literal node carrying span_from's span.
func mk_str(a &: at.Ast, s: str, span_from: int): int:
    n := at.NewNode(a, at.AST_LITERAL)
    copy_span(a, n, span_from)
    at.SetOp(a, n, tok.TK_STRING)
    at.SetName(a, n, s)
    mut v := tok.ValueNone()
    v.kind = tok.TV_STRING
    v.sval = s
    at.SetTokenValue(a, n, v)
    ret n
end

// node_text
func node_text(a &: at.Ast, vid: int): str:
    if vid == 0:
        ret ""
    end
    v := at.Get(a, vid)
    if v.kind == at.AST_IDENTIFIER:
        ret v.name
    end
    if v.kind == at.AST_LITERAL:
        if v.op == tok.TK_STRING || v.op == tok.TK_TRIPLE_STRING:
            ret v.value_str
        end
        if v.op == tok.TK_INT:
            ret co.U64Toa(v.value_int)
        end
        if v.op == tok.TK_FLOAT:
            ret co.Format1("%g", co.ArgFloat(v.value_float))
        end
        if v.op == tok.TK_KW_TRUE:
            ret "true"
        end
        if v.op == tok.TK_KW_FALSE:
            ret "false"
        end
        ret v.name
    end
    ret ""
end

// frame_lookup - bound value node id (may be 0 = C NULL binding).
func frame_lookup(f &: LoFrame, name: str, found &: bool): int:
    found = false
    if !f.present:
        ret 0
    end
    repeat f.names.len() with i:
        if str.Equals(f.names.get(i)[0], name):
            found = true
            ret f.vals.get(i)[0]
        end
    end
    ret 0
end

// frame_set
func frame_set(f &: LoFrame, name: str, val: int):
    repeat f.names.len() with i:
        if str.Equals(f.names.get(i)[0], name):
            f.vals.set(i, val)
            ret
        end
    end
    f.names.push(name)
    f.vals.push(val)
end

// interpolate - replaces {param} spans bound in the frame.
func interpolate(a &: at.Ast, s: str, f &: LoFrame): str:
    if !f.present || str.IndexOf(s, "{") < 0:
        ret s
    end
    mut out := ""
    mut changed := false
    n := str.Len(s)
    mut p := 0
    until p < n:
        if byte_at(s, p) == 123:
            close := str.IndexFrom(s, "}", p)
            if close >= 0:
                key := str.Substr(s, p + 1, close - (p + 1))
                mut found := false
                bound := frame_lookup(f, key, found)
                if found:
                    out += node_text(a, bound)
                    changed = true
                    p = close + 1
                    continue
                end
            end
        end
        out += str.Substr(s, p, 1)
        p += 1
    end
    if changed:
        ret out
    end
    ret s
end

// subst_value
func subst_value(a &: at.Ast, vid: int, f &: LoFrame): int:
    if vid == 0 || !f.present:
        ret vid
    end
    v := at.Get(a, vid)
    if v.kind == at.AST_IDENTIFIER:
        mut found := false
        bound := frame_lookup(f, v.name, found)
        if found:
            if bound != 0:
                ret bound
            end
            ret mk_str(a, "", vid)
        end
    end
    if v.kind == at.AST_LITERAL && (v.op == tok.TK_STRING || v.op == tok.TK_TRIPLE_STRING):
        interp := interpolate(a, v.value_str, f)
        if !str.Equals(interp, v.value_str):
            ret mk_str(a, interp, vid)
        end
    end
    ret vid
end

// find_comp - index into ex.comp_*, -1 = C NULL.
func find_comp(ex &: LoExpand, name: str): int:
    repeat ex.comp_name.len() with i:
        if str.Equals(ex.comp_name.get(i)[0], name):
            ret i
        end
    end
    ret 0 - 1
end

// body_has_content_sink
func body_has_content_sink(a &: at.Ast, node: int): bool:
    repeat at.ChildCount(a, node) with i:
        cid := at.Child(a, node, i)
        c := at.Get(a, cid)
        if c.kind != at.AST_LAYOUT_ELEMENT:
            continue
        end
        if is_content_word(c.name):
            ret true
        end
        if body_has_content_sink(a, cid):
            ret true
        end
    end
    ret false
end

// register_components
func register_components(ex &: LoExpand, a &: at.Ast, program: int, dir: str):
    repeat at.ChildCount(a, program) with i:
        did := at.Child(a, program, i)
        d := at.Get(a, did)
        if d.kind != at.AST_LAYOUT_COMPONENT:
            continue
        end
        if find_comp(ex, d.name) >= 0:
            lg.Log(
                ex.log, lg.PH_DRIVER, lg.LOG_WARN, co.Format1(
                    "duplicate component '%s' ignored", co.ArgStr(d.name)
                )
            )
            continue
        end
        repeat at.ChildCount(a, did) with j:
            p := at.Get(a, at.Child(a, did, j))
            if p.kind == at.AST_PARAM && is_content_word(p.name):
                lg.Log(
                    ex.log, lg.PH_DRIVER, lg.LOG_ERROR, co.Format1(
                        "component '%s': 'content' is reserved and cannot be a parameter", co.ArgStr(d.name)
                    )
                )
                ex.errors += 1
            end
        end
        mut mother := false
        if d.a != 0:
            mother = body_has_content_sink(a, d.a)
        end
        ex.comp_name.push(d.name)
        ex.comp_def.push(did)
        ex.comp_dir.push(dir)
        ex.comp_mother.push(mother)
        lg.Log(
            ex.log, lg.PH_DRIVER, lg.LOG_DEBUG, co.Format2(
                "registered component '%s' (%s)", co.ArgStr(d.name), co.ArgStr(mother ? "mother" : "single")
            )
        )
    end
end

// find_layout_block
func find_layout_block(a &: at.Ast, program: int): int:
    repeat at.ChildCount(a, program) with i:
        did := at.Child(a, program, i)
        if at.KindOf(a, did) == at.AST_LAYOUT_BLOCK:
            ret did
        end
    end
    ret 0
end

// has_component_def
func has_component_def(a &: at.Ast, program: int): bool:
    repeat at.ChildCount(a, program) with i:
        if at.KindOf(a, at.Child(a, program, i)) == at.AST_LAYOUT_COMPONENT:
            ret true
        end
    end
    ret false
end

// find_loaded - index into ex.loaded_*, -1 = C NULL.
func find_loaded(ex &: LoExpand, path: str): int:
    repeat ex.loaded_path.len() with i:
        if str.Equals(ex.loaded_path.get(i)[0], path):
            ret i
        end
    end
    ret 0 - 1
end

// load_include - returns the loaded index, -1 when unreadable/unparsable
// (the C returned NULL; the failed entry stays cached with prog == 0).
func load_include(ex &: LoExpand, a &: at.Ast, path: str): int:
    cached := find_loaded(ex, path)
    if cached >= 0:
        if ex.loaded_prog.get(cached)[0] != 0:
            ret cached
        end
        ret 0 - 1
    end
    li := ex.loaded_path.len()
    ex.loaded_path.push(path)
    ex.loaded_prog.push(0)
    ex.loaded_dir.push(lo_dir_of(path))
    mut sf := src.New()
    if !src.Load(path, sf):
        lg.Log(
            ex.log, lg.PH_DRIVER, lg.LOG_ERROR, co.Format1("cannot read included layout '%s'", co.ArgStr(path))
        )
        ex.errors += 1
        ret 0 - 1
    end
    mut toks := tok.StreamNew(path)
    _l := lx.Run(ex.log, ex.pack, sf, toks)
    mut prog := 0
    _p := ps.Run(ex.log, toks, a, prog)
    tok.StreamFree(toks)
    if prog != 0:
        _c := cc.PruneProgram(a, ex.log, path, ex.cctab, prog)
    end
    if prog == 0:
        lg.Log(
            ex.log, lg.PH_DRIVER, lg.LOG_ERROR, co.Format1("cannot parse included layout '%s'", co.ArgStr(path))
        )
        ex.errors += 1
        ret 0 - 1
    end
    ex.loaded_prog.set(li, prog)
    lg.Log(
        ex.log, lg.PH_DRIVER, lg.LOG_INFO, co.Format1("included layout %s", co.ArgStr(path))
    )
    ret li
end

// collect - register components of a program and scan its layout bodies.
func collect(ex &: LoExpand, a &: at.Ast, program: int, dir: str, depth: int):
    register_components(ex, a, program, dir)
    repeat at.ChildCount(a, program) with i:
        did := at.Child(a, program, i)
        d := at.Get(a, did)
        if d.kind == at.AST_LAYOUT_BLOCK:
            scan_includes(ex, a, did, dir, depth)
        else d.kind == at.AST_LAYOUT_COMPONENT:
            scan_includes(ex, a, d.a, dir, depth)
        end
    end
end

// scan_includes
func scan_includes(
    ex &: LoExpand, a &: at.Ast, container: int, dir: str, depth: int
):
    if container == 0 || depth > K_LO_MAX_DEPTH:
        ret
    end
    repeat at.ChildCount(a, container) with i:
        iid := at.Child(a, container, i)
        item := at.Get(a, iid)
        if item.kind == at.AST_LAYOUT_ATTR && is_include_attr(item.name):
            mut spec := ""
            mut has_spec := false
            if item.a != 0:
                av := at.Get(a, item.a)
                if av.kind == at.AST_LITERAL && av.value_kind == tok.TV_STRING:
                    spec = av.value_str
                    has_spec = true
                end
            end
            if !has_spec:
                continue
            end
            path := sm.ResolveImport(dir, spec)
            if find_loaded(ex, path) < 0:
                l := load_include(ex, a, path)
                if l >= 0:
                    collect(
                        ex, a, ex.loaded_prog.get(l)[0], ex.loaded_dir.get(l)[0], depth + 1
                    )
                end
            end
        else item.kind == at.AST_LAYOUT_ELEMENT:
            scan_includes(ex, a, iid, dir, depth)
        end
    end
end

// expand_component
func expand_component(
    ex &: LoExpand, a &: at.Ast, out &: Vector<int>, invocation: int, ci: int, caller &: LoFrame, dir: str,
    depth: int
):
    comp_name := ex.comp_name.get(ci)[0]
    if depth > K_LO_MAX_DEPTH:
        lg.Log(
            ex.log, lg.PH_DRIVER, lg.LOG_ERROR, co.Format1(
                "component '%s' nested too deeply (cyclic invocation?)", co.ArgStr(comp_name)
            )
        )
        ex.errors += 1
        ret
    end
    mut fr := LoFrame { present = true }
    defer fr.names.free()
    defer fr.vals.free()
    defer fr.content.free()
    comp_def := ex.comp_def.get(ci)[0]

    repeat at.ChildCount(a, comp_def) with i:
        pid := at.Child(a, comp_def, i)
        p := at.Get(a, pid)
        if p.kind == at.AST_PARAM:
            frame_set(fr, p.name, p.a)
        end
    end

    mut got_content := false
    repeat at.ChildCount(a, invocation) with i2:
        aid := at.Child(a, invocation, i2)
        an := at.Get(a, aid)
        if an.kind == at.AST_LAYOUT_ATTR:
            if is_content_word(an.name):
                txt := at.NewNode(a, at.AST_LAYOUT_ATTR)
                copy_span(a, txt, aid)
                at.SetName(a, txt, "content")
                sub := subst_value(a, an.a, caller)
                mut tn := at.Get(a, txt)
                tn.a = sub
                at.Put(a, txt, tn)
                fr.content.push(txt)
                got_content = true
            else:
                frame_set(fr, an.name, subst_value(a, an.a, caller))
            end
        else an.kind == at.AST_LAYOUT_ELEMENT:
            before := fr.content.len()
            mut cvec := fr.content
            expand_item(ex, a, cvec, aid, caller, dir, depth)
            fr.content = cvec
            if fr.content.len() > before:
                got_content = true
            end
        end
    end
    if !ex.comp_mother.get(ci)[0] && got_content:
        lg.Log(
            ex.log, lg.PH_DRIVER, lg.LOG_ERROR, co.Format1(
                "component '%s' does not accept content (it has no `content:` placeholder)", co.ArgStr(comp_name)
            )
        )
        ex.errors += 1
    end
    body := at.Get(a, comp_def).a
    expand_items(ex, a, out, body, fr, ex.comp_dir.get(ci)[0], depth + 1)
end

// expand_item
func expand_item(
    ex &: LoExpand, a &: at.Ast, out &: Vector<int>, iid: int, fr &: LoFrame, dir: str, depth: int
):
    item := at.Get(a, iid)
    if item.kind == at.AST_LAYOUT_ATTR:
        if is_include_attr(item.name):
            vid := subst_value(a, item.a, fr)
            mut spec := ""
            mut has_spec := false
            if vid != 0:
                v := at.Get(a, vid)
                if v.kind == at.AST_LITERAL && v.value_kind == tok.TV_STRING:
                    spec = v.value_str
                    has_spec = true
                end
            end
            if !has_spec:
                lg.Log(
                    ex.log, lg.PH_DRIVER, lg.LOG_ERROR, "include path must be a string"
                )
                ex.errors += 1
                ret
            end
            path := sm.ResolveImport(dir, spec)
            mut l := find_loaded(ex, path)
            if l < 0:
                l = load_include(ex, a, path)
            end
            if l >= 0 && ex.loaded_prog.get(l)[0] != 0:
                lprog := ex.loaded_prog.get(l)[0]
                lb := find_layout_block(a, lprog)
                if lb != 0:
                    mut none := LoFrame {}
                    expand_items(
                        ex, a, out, lb, none, ex.loaded_dir.get(l)[0], depth + 1
                    )
                    none.names.free()
                    none.vals.free()
                    none.content.free()
                else !has_component_def(a, lprog):
                    lg.Log(
                        ex.log, lg.PH_DRIVER, lg.LOG_WARN, co.Format1(
                            "included file '%s' has no layout block", co.ArgStr(path)
                        )
                    )
                end
            end
            ret
        end

        attr := at.Clone(a, iid)
        sub := subst_value(a, item.a, fr)
        mut an := at.Get(a, attr)
        an.a = sub
        at.Put(a, attr, an)
        out.push(attr)
        ret
    end
    if item.kind == at.AST_LAYOUT_ELEMENT:
        ci := find_comp(ex, item.name)
        if ci >= 0:
            expand_component(ex, a, out, iid, ci, fr, dir, depth)
            ret
        end

        if fr.present && is_content_word(item.name):
            if fr.content.len() > 0:
                repeat fr.content.len() with i:
                    out.push(fr.content.get(i)[0])
                end
            else:
                expand_items(ex, a, out, iid, fr, dir, depth)
            end
            ret
        end

        el := at.NewNode(a, at.AST_LAYOUT_ELEMENT)
        copy_span(a, el, iid)
        at.SetName(a, el, item.name)
        repeat item.aliases.len() with i2:
            at.AddAlias(a, el, item.aliases.get(i2)[0])
        end
        mut kids := Vector {} as Vector<int>
        expand_items(ex, a, kids, iid, fr, dir, depth)
        mut en := at.Get(a, el)
        mut old := en.list
        en.list = kids
        at.Put(a, el, en)
        old.free()
        out.push(el)
        ret
    end

    out.push(iid)
end

// expand_items
func expand_items(
    ex &: LoExpand, a &: at.Ast, out &: Vector<int>, container: int, fr &: LoFrame, dir: str, depth: int
):
    if depth > K_LO_MAX_DEPTH:
        lg.Log(
            ex.log, lg.PH_DRIVER, lg.LOG_ERROR, "layout include/component nesting too deep"
        )
        ex.errors += 1
        ret
    end
    repeat at.ChildCount(a, container) with i:
        expand_item(ex, a, out, at.Child(a, container, i), fr, dir, depth)
    end
end

// ===========================================================================
// ===== layout_gen_value.c =====
// ===========================================================================

// html_line - one line of HTML output (pre-formatted by the caller).
func html_line(cx &: LoCtx, s: str):
    if !cx.compact:
        ind := cx.indent
        repeat ind with i:
            cx.html += "  "
        end
    end
    cx.html += s
    if !cx.compact:
        cx.html += "\n"
    end
end

// hyphenate - '_' and ' ' -> '-'.
func hyphenate(s: str): str:
    ret str.Replace(str.Replace(s, "_", "-"), " ", "-")
end

// sb_put_html_escaped / html_escape
func html_escape(s: str): str:
    mut out := ""
    n := str.Len(s)
    repeat n with i:
        b := byte_at(s, i)
        if b == 38:
            out += "&amp;"
        else b == 60:
            out += "&lt;"
        else b == 62:
            out += "&gt;"
        else b == 34:
            out += "&quot;"
        else b == 39:
            out += "&#39;"
        else:
            out += str.Substr(s, i, 1)
        end
    end
    ret out
end

// val_str
func val_str(a &: at.Ast, vid: int): str:
    if vid == 0:
        ret ""
    end
    v := at.Get(a, vid)
    if v.kind == at.AST_LITERAL:
        if v.op == tok.TK_STRING || v.op == tok.TK_TRIPLE_STRING:
            ret v.value_str
        end
        if v.op == tok.TK_INT:
            ret co.U64Toa(v.value_int)
        end
        if v.op == tok.TK_FLOAT:
            ret co.Format1("%g", co.ArgFloat(v.value_float))
        end
        if v.op == tok.TK_KW_TRUE:
            ret "true"
        end
        if v.op == tok.TK_KW_FALSE:
            ret "false"
        end
        ret v.name
    end
    if v.kind == at.AST_IDENTIFIER:
        ret v.name
    end
    if v.kind == at.AST_CALL:
        mut fn := "fn"
        if v.a != 0 && at.KindOf(a, v.a) == at.AST_IDENTIFIER:
            fn = at.Get(a, v.a).name
        end
        mut out := fn + "("
        repeat at.ChildCount(a, vid) with i:
            argid := at.Child(a, vid, i)
            arg := at.Get(a, argid)
            if i > 0:
                out += ", "
            end
            if arg.kind == at.AST_LITERAL && (arg.op == tok.TK_STRING || arg.op == tok.TK_TRIPLE_STRING):
                out += "\"" + val_str(a, argid) + "\""
            else:
                out += val_str(a, argid)
            end
        end
        ret out + ")"
    end
    ret ""
end

// class_seq_name - a, b, …, z, aa, ab, … (bijective base-26).
func class_seq_name(n: int): str:
    mut out := ""
    mut x := n + 1
    until x > 0:
        x -= 1
        out = char_from_code(97 + x % 26) + out
        x /= 26
    end
    ret out
end

// class_for_key
func class_for_key(cx &: LoCtx, key: str): str:
    repeat cx.cls_keys.len() with i:
        if str.Equals(cx.cls_keys.get(i)[0], key):
            ret cx.cls_names.get(i)[0]
        end
    end
    name := class_seq_name(cx.cls_next)
    cx.cls_next += 1
    cx.cls_keys.push(key)
    cx.cls_names.push(name)
    ret name
end

// emit_rule - de-duplicated CSS rule sink.
func emit_rule(cx &: LoCtx, rule: str):
    repeat cx.css_seen.len() with i:
        if str.Equals(cx.css_seen.get(i)[0], rule):
            ret
        end
    end
    cx.css_seen.push(rule)
    cx.css += rule
    if !cx.compact:
        cx.css += "\n"
    end
end

// css_decl
func css_decl(compact: bool, prop: str, val: str): str:
    if compact:
        ret prop + ":" + val + ";"
    end
    ret prop + ": " + val + "; "
end

// css_rule
func css_rule(compact: bool, sel: str, body: str): str:
    if compact:
        mut n := str.Len(body)
        until n > 0 && byte_at(body, n - 1) == 32:
            n -= 1
        end
        if n > 0 && byte_at(body, n - 1) == 59:
            n -= 1
        end
        ret sel + "{" + str.Substr(body, 0, n) + "}"
    end
    ret sel + " { " + body + " }"
end

// is_bool_attr
func is_bool_attr(n: str): bool:
    ret str.Equals(n, "required") || str.Equals(n, "checked") || str.Equals(n, "disabled") || str.Equals(n, "hidden") || str.Equals(n, "selected") || str.Equals(n, "multiple")
end

// ===========================================================================
// ===== registry.c value-mapping slice not ported with 5d =====
// (layout_map_length + normalize_unit_phrase + tokenize_ws + scan_number +
// layout_attr_value_map - the generator-side pieces)
// ===========================================================================

// is_ws (registry.c: ' ' and '\t' only)
func lo_is_ws(b: int): bool:
    ret b == 32 || b == 9
end

// scan_number - [+-]digits[.digits]; out_end = first byte past the number.
func scan_number(s: str, start: int, out_end &: int): bool:
    n := str.Len(s)
    mut p := start
    if p < n && (byte_at(s, p) == 43 || byte_at(s, p) == 45):
        p += 1
    end
    mut dig := false
    until p < n && byte_at(s, p) >= 48 && byte_at(s, p) <= 57:
        p += 1
        dig = true
    end
    if p < n && byte_at(s, p) == 46:
        mut q := p + 1
        until q < n && byte_at(s, q) >= 48 && byte_at(s, q) <= 57:
            q += 1
        end
        if q > p + 1:
            p = q
        end
    end
    if !dig:
        ret false
    end
    out_end = p
    ret true
end

// normalize_unit_phrase - ZWNJ -> space, Arabic yeh/kaf -> Persian, ws
// collapse, ASCII lowercase; capped at 128 bytes like the C char buffer.
func norm_unit_phrase(s: str, pos: int, length: int): str:
    mut out := ""
    mut oi := 0
    mut prev_space := false
    mut q := pos
    qend := pos + length
    until q < qend && oi < K_LO_UNIT_CAP - 1:
        rem := qend - q
        b0 := byte_at(s, q)
        if rem >= 3 && b0 == 0xE2 && byte_at(s, q + 1) == 0x80 && byte_at(s, q + 2) == 0x8C:
            if !prev_space:
                out += " "
                oi += 1
                prev_space = true
            end
            q += 3
            continue
        end
        if rem >= 2 && b0 == 0xD9 && (byte_at(s, q + 1) == 0x8A || byte_at(s, q + 1) == 0x83):
            if oi + 2 >= K_LO_UNIT_CAP - 1:
                break
            end
            if byte_at(s, q + 1) == 0x8A:
                out += "ی"
            else:
                out += "ک"
            end
            oi += 2
            prev_space = false
            q += 2
            continue
        end
        if lo_is_ws(b0):
            if !prev_space:
                out += " "
                oi += 1
                prev_space = true
            end
            q += 1
            continue
        end
        if b0 >= 65 && b0 <= 90:
            out += char_from_code(b0 + 32)
        else:
            out += str.Substr(s, q, 1)
        end
        oi += 1
        prev_space = false
        q += 1
    end
    ret out
end

// lookup_unit_span - normalized phrase -> canonical unit ("" = C NULL).
func lookup_unit_span(s: str, pos: int, length: int): str:
    ret sm.LayoutDynValue("unit", norm_unit_phrase(s, pos, length))
end

// layout_map_length - canonicalize "<number> <unit words>" runs.
func map_length(v: str): str:
    if str.Len(v) == 0:
        ret v
    end
    // tokenize_ws
    mut tstart := Vector {} as Vector<int>
    mut tlen := Vector {} as Vector<int>
    defer tstart.free()
    defer tlen.free()
    n := str.Len(v)
    mut p := 0
    mut bailed := false
    until p < n:
        until p < n && lo_is_ws(byte_at(v, p)):
            p += 1
        end
        if p >= n:
            break
        end
        if tstart.len() == K_LO_LEN_MAX_TOKENS:
            bailed = true
            break
        end
        s0 := p
        until p < n && !lo_is_ws(byte_at(v, p)):
            p += 1
        end
        tstart.push(s0)
        tlen.push(p - s0)
    end
    ntok := bailed ? 0 : tstart.len()
    if ntok == 0:
        ret v
    end

    mut out := ""
    mut i := 0
    until i < ntok:
        tp := tstart.get(i)[0]
        tl := tlen.get(i)[0]
        tend := tp + tl
        if str.Len(out) > 0:
            out += " "
        end
        mut numend := 0
        ok := scan_number(v, tp, numend)
        if !ok || numend > tend:
            out += str.Substr(v, tp, tl)
            i += 1
            continue
        end
        attached := tend - numend
        mut canon := ""
        mut consumed := 1
        if attached > 0:
            canon = lookup_unit_span(v, numend, attached)
        else i + 2 < ntok:
            l1 := tlen.get(i + 1)[0]
            l2 := tlen.get(i + 2)[0]
            if l1 + 1 + l2 < K_LO_UNIT_CAP:
                joined := str.Substr(v, tstart.get(i + 1)[0], l1) + " " + str.Substr(v, tstart.get(i + 2)[0], l2)
                canon = lookup_unit_span(joined, 0, str.Len(joined))
                if str.Len(canon) > 0:
                    consumed = 3
                end
            end
        end
        if str.Len(canon) == 0 && attached == 0 && i + 1 < ntok:
            canon = lookup_unit_span(
                v, tstart.get(i + 1)[0], tlen.get(i + 1)[0]
            )
            if str.Len(canon) > 0:
                consumed = 2
            end
        end
        if str.Len(canon) == 0 && attached == 0:
            canon = "px"
            consumed = 1
        end
        if str.Len(canon) == 0:
            out += str.Substr(v, tp, tl)
            i += 1
            continue
        end
        out += str.Substr(v, tp, numend - tp)
        out += canon
        i += consumed
    end
    ret out
end

// layout_attr_value_map - ai is the sm.LayoutAttrLookup index (-1 = no def).
func attr_value_map(ai: int, value: str): str:
    if ai < 0:
        ret value
    end
    v := i18.LayoutValue(value)
    vt := sm.LayoutAttrVtype(ai)
    if vt == K_LO_VT_COLOR:
        c := sm.LayoutMapColor(v)
        ret str.Len(c) > 0 ? c : v
    end
    if vt == K_LO_VT_DIR:
        c := sm.LayoutDynValue("dir", v)
        ret str.Len(c) > 0 ? c : v
    end
    if vt == K_LO_VT_LANG:
        c := sm.LayoutDynValue("lang", v)
        ret str.Len(c) > 0 ? c : v
    end
    if vt == K_LO_VT_ENUM:
        c := sm.LayoutDynValue(sm.LayoutAttrAllowed(ai), v)
        ret str.Len(c) > 0 ? c : v
    end
    if vt == K_LO_VT_LENGTH:
        ret map_length(v)
    end
    ret value
end

// ===========================================================================
// ===== layout_gen_element.c =====
// ===========================================================================

// repeat_count
func repeat_count(a &: at.Ast, el: int): i64:
    repeat at.ChildCount(a, el) with i:
        aid := at.Child(a, el, i)
        an := at.Get(a, aid)
        if an.kind == at.AST_LAYOUT_ATTR && str.Equals(an.name, "repeat") && an.a != 0:
            av := at.Get(a, an.a)
            if av.kind == at.AST_LITERAL && av.value_kind == tok.TV_INT:
                r := av.value_int as i64
                ret r < 1 ? 1 as i64 : r
            end
        end
    end
    ret 1 as i64
end

// gen_children
func gen_children(
    cx &: LoCtx, diag &: dg.Engine, a &: at.Ast, el: int, klass: str, has_klass: bool
):
    parent := at.Get(a, el).name
    repeat at.ChildCount(a, el) with i:
        cid := at.Child(a, el, i)
        if at.KindOf(a, cid) == at.AST_LAYOUT_ELEMENT:
            gen_element_n(cx, diag, a, cid, parent, klass, has_klass)
        end
    end
end

// has_child_elements
func has_child_elements(a &: at.Ast, el: int): bool:
    repeat at.ChildCount(a, el) with i:
        if at.KindOf(a, at.Child(a, el, i)) == at.AST_LAYOUT_ELEMENT:
            ret true
        end
    end
    ret false
end

// quote_css_value_if_needed
func quote_css_value_if_needed(value: str): str:
    if str.IndexOf(value, " ") < 0:
        ret value
    end
    n := str.Len(value)
    repeat n with i:
        b := byte_at(value, i)
        if b >= 48 && b <= 57:
            ret value
        end
    end
    ret "\"" + value + "\""
end

// gen_element_n - repeat-aware element emitter (layout_internal.h export).
func gen_element_n(
    cx &: LoCtx, diag &: dg.Engine, a &: at.Ast, el: int, parent: str, parent_class: str, parent_has_class: bool
):
    nrep := repeat_count(a, el)
    mut i := 0 as i64
    until i < nrep:
        gen_element(cx, diag, a, el, parent, parent_class, parent_has_class)
        i += 1 as i64
    end
end

// gen_element
func gen_element(
    cx &: LoCtx, diag &: dg.Engine, a &: at.Ast, el: int, _parent: str, parent_class: str, parent_has_class: bool
):
    name := at.Get(a, el).name
    di := sm.LayoutElemLookup(name)
    if di < 0:
        dg.Report(
            diag, dg.SEV_WARNING, 2, cx.file, span_of(a, el), co.Format1(
                i18.Tr("unrecognized layout element '%s' (rendered as <div>)"), co.ArgStr(name)
            )
        )
    end
    mut ltype := K_LO_LE_MOTHER
    if di >= 0:
        ltype = sm.LayoutElemKind(di)
    end
    mut tag := "div"
    if di >= 0 && str.Len(sm.LayoutElemTag(di)) > 0:
        tag = sm.LayoutElemTag(di)
    end

    if str.Equals(name, "heading"):
        mut sz := 1 as i64
        repeat at.ChildCount(a, el) with hi:
            aid := at.Child(a, el, hi)
            an := at.Get(a, aid)
            if an.kind == at.AST_LAYOUT_ATTR && str.Equals(an.name, "size") && an.a != 0:
                av := at.Get(a, an.a)
                if av.kind == at.AST_LITERAL && av.value_kind == tok.TV_INT:
                    sz = av.value_int as i64
                end
            end
        end
        if sz < 1:
            sz = 1
        end
        if sz > 6:
            sz = 6
        end
        tag = "h" + co.U64Toa(sz as u64)
    end
    lg.Log(
        cx.log, lg.PH_CODEGEN, lg.LOG_TRACE, co.Format2("layout <%s> -> <%s>", co.ArgStr(name), co.ArgStr(tag))
    )
    if str.Equals(name, "meta"):
        mut nmattr := ""
        mut has_nm := false
        mut prop := ""
        mut has_prop := false
        mut cont := ""
        mut has_cont := false
        mut charset := ""
        mut has_charset := false
        mut http_equiv := ""
        mut has_he := false
        repeat at.ChildCount(a, el) with mi:
            aid := at.Child(a, el, mi)
            an := at.Get(a, aid)
            if an.kind != at.AST_LAYOUT_ATTR:
                continue
            end
            v := val_str(a, an.a)
            if str.Equals(an.name, "name"):
                nmattr = v
                has_nm = true
            else str.Equals(an.name, "property"):
                prop = v
                has_prop = true
            else str.Equals(an.name, "content"):
                cont = v
                has_cont = true
            else str.Equals(an.name, "charset"):
                charset = v
                has_charset = true
            else str.Equals(an.name, "http_equiv"):
                http_equiv = v
                has_he = true
            end
        end
        cx.head += cx.compact ? "<meta" : "  <meta"
        if has_charset:
            cx.head += " charset=\"" + html_escape(charset) + "\""
        end
        if has_nm:
            cx.head += " name=\"" + html_escape(nmattr) + "\""
        end
        if has_prop:
            cx.head += " property=\"" + html_escape(prop) + "\""
        end
        if has_he:
            cx.head += " http-equiv=\"" + html_escape(http_equiv) + "\""
        end
        if has_cont:
            cx.head += " content=\"" + html_escape(cont) + "\""
        end
        cx.head += cx.compact ? ">" : ">\n"
        ret
    end
    if str.Equals(name, "head_link"):
        mut rel := ""
        mut has_rel := false
        mut href := ""
        mut has_href := false
        mut type_ := ""
        mut has_type_ := false
        mut cross := ""
        mut has_cross := false
        mut sizes := ""
        mut has_sizes := false
        mut as_ := ""
        mut has_as := false
        mut media_ := ""
        mut has_media := false
        repeat at.ChildCount(a, el) with li:
            aid := at.Child(a, el, li)
            an := at.Get(a, aid)
            if an.kind != at.AST_LAYOUT_ATTR:
                continue
            end
            v := val_str(a, an.a)
            if str.Equals(an.name, "rel"):
                rel = v
                has_rel = true
            else str.Equals(an.name, "href"):
                href = v
                has_href = true
            else str.Equals(an.name, "type"):
                type_ = v
                has_type_ = true
            else str.Equals(an.name, "crossorigin"):
                cross = v
                has_cross = true
            else str.Equals(an.name, "sizes"):
                sizes = v
                has_sizes = true
            else str.Equals(an.name, "as"):
                as_ = v
                has_as = true
            else str.Equals(an.name, "media"):
                media_ = v
                has_media = true
            end
        end
        cx.head += cx.compact ? "<link" : "  <link"
        if has_rel:
            cx.head += " rel=\"" + html_escape(rel) + "\""
        end
        if has_href:
            cx.head += " href=\"" + html_escape(href) + "\""
        end
        if has_type_:
            cx.head += " type=\"" + html_escape(type_) + "\""
        end
        if has_as:
            cx.head += " as=\"" + html_escape(as_) + "\""
        end
        if has_sizes:
            cx.head += " sizes=\"" + html_escape(sizes) + "\""
        end
        if has_media:
            cx.head += " media=\"" + html_escape(media_) + "\""
        end
        if has_cross:
            cx.head += " crossorigin=\"" + html_escape(cross) + "\""
        end
        cx.head += cx.compact ? ">" : ">\n"
        ret
    end
    mut attrs := ""
    mut css := ""
    mut hover := ""
    mut focus := ""
    mut active := ""
    mut before := ""
    mut after := ""
    mut content := ""
    mut has_content := false
    mut userclass := ""
    mut has_userclass := false
    mut source := ""
    mut has_source := false
    mut srcv := ""
    mut has_src := false
    mut type_val := ""
    mut has_type := false
    mut condition := ""
    mut has_condition := false
    mut selector := ""
    mut has_selector := false
    repeat at.ChildCount(a, el) with ai0:
        aid := at.Child(a, el, ai0)
        an := at.Get(a, aid)
        if an.kind != at.AST_LAYOUT_ATTR:
            continue
        end
        nm := an.name
        v := val_str(a, an.a)
        if str.Equals(nm, "condition"):
            condition = v
            has_condition = true
            continue
        end
        if str.Equals(nm, "selector"):
            selector = v
            has_selector = true
            continue
        end
        if str.StartsWith(nm, "hover_"):
            hover += css_decl(
                cx.compact, hyphenate(str.Substr(nm, 6, str.Len(nm) - 6)), v
            )
            continue
        end
        if str.StartsWith(nm, "focus_"):
            focus += css_decl(
                cx.compact, hyphenate(str.Substr(nm, 6, str.Len(nm) - 6)), v
            )
            continue
        end
        if str.StartsWith(nm, "active_"):
            active += css_decl(
                cx.compact, hyphenate(str.Substr(nm, 7, str.Len(nm) - 7)), v
            )
            continue
        end
        if str.StartsWith(nm, "before_"):
            rest := str.Substr(nm, 7, str.Len(nm) - 7)
            if str.Equals(rest, "content"):
                before += css_decl(cx.compact, "content", "\"" + v + "\"")
            else:
                before += css_decl(cx.compact, hyphenate(rest), v)
            end
            continue
        end
        if str.StartsWith(nm, "after_"):
            rest := str.Substr(nm, 6, str.Len(nm) - 6)
            if str.Equals(rest, "content"):
                after += css_decl(cx.compact, "content", "\"" + v + "\"")
            else:
                after += css_decl(cx.compact, hyphenate(rest), v)
            end
            continue
        end
        if str.Len(nm) >= 2 && byte_at(nm, 0) == 111 && byte_at(nm, 1) == 110:
            attrs += " " + nm + "=\"" + html_escape(v) + "\""
            continue
        end
        if str.Equals(name, "canvas") && (str.Equals(nm, "width") || str.Equals(nm, "height")):
            attrs += " " + nm + "=\"" + html_escape(v) + "\""
            continue
        end
        ai := sm.LayoutAttrLookup(nm)
        dest := ai >= 0 ? sm.LayoutAttrDest(ai) : K_LO_LA_CSS
        if dest == K_LO_LA_CONTENT:
            content = v
            has_content = true
        else dest == K_LO_LA_CLASS:
            userclass = v
            has_userclass = true
        else dest == K_LO_LA_STYLE:
            attrs += " style=\"" + html_escape(v) + "\""
        else dest == K_LO_LA_DIR:
            attrs += " dir=\"" + attr_value_map(ai, v) + "\""
        else dest == K_LO_LA_LANG:
            attrs += " lang=\"" + attr_value_map(ai, v) + "\""
        else dest == K_LO_LA_SOURCE:
            source = v
            has_source = true
        else dest == K_LO_LA_HTML:
            if str.Equals(nm, "src"):
                srcv = v
                has_src = true
            else str.Equals(nm, "type"):
                type_val = attr_value_map(ai, v)
                has_type = true
            else str.Equals(nm, "condition"):
                condition = v
                has_condition = true
            else is_bool_attr(nm) && str.Equals(v, "true"):
                attrs += " " + sm.LayoutAttrOut(ai)
            else:
                attrs += " " + sm.LayoutAttrOut(ai) + "=\"" + html_escape(attr_value_map(ai, v)) + "\""
            end
        else dest == K_LO_LA_CSS:
            mut prop := hyphenate(nm)
            if ai >= 0 && str.Len(sm.LayoutAttrOut(ai)) > 0:
                prop = sm.LayoutAttrOut(ai)
            end
            mapped := attr_value_map(ai, v)
            css += css_decl(cx.compact, prop, quote_css_value_if_needed(mapped))
        end
        // K_LO_LA_META: nothing
    end
    has_css := str.Len(css) > 0
    needs_class := has_css || str.Len(hover) > 0 || str.Len(focus) > 0 || str.Len(active) > 0 || str.Len(before) > 0 || str.Len(after) > 0
    mut klass := userclass
    mut has_klass := has_userclass
    if needs_class && !has_klass:
        sep := char_from_code(31)
        key := css + sep + hover + sep + focus + sep + active + sep + before + sep + after
        klass = class_for_key(cx, key)
        has_klass = true
    end

    if str.Equals(name, "media"):
        sel := parent_has_class ? parent_class : "body"
        cond := has_condition ? condition : "all"
        inner := css_rule(cx.compact, "." + sel, css)
        if cx.compact:
            emit_rule(cx, "@media " + cond + "{" + inner + "}")
        else:
            emit_rule(cx, "@media " + cond + " { " + inner + " }")
        end
        ret
    end
    if str.Equals(name, "style"):
        if has_content:
            cx.css += cx.compact ? mn.Css(content) : content
            if !cx.compact:
                cx.css += "\n"
            end
        end
        ret
    end
    if str.Equals(name, "global"):
        emit_rule(cx, css_rule(cx.compact, has_selector ? selector : "*", css))
        ret
    end
    if str.Equals(name, "script"):
        if has_src:
            html_line(cx, "<script src=\"" + html_escape(srcv) + "\"></script>")
        else has_content:
            cx.js += cx.compact ? mn.Js(content) : content
            cx.js += cx.compact ? " " : "\n"
        end
        ret
    end

    if has_css:
        emit_rule(cx, css_rule(cx.compact, "." + klass, css))
    end
    if str.Len(hover) > 0:
        emit_rule(cx, css_rule(cx.compact, "." + klass + ":hover", hover))
    end
    if str.Len(focus) > 0:
        emit_rule(cx, css_rule(cx.compact, "." + klass + ":focus", focus))
    end
    if str.Len(active) > 0:
        emit_rule(cx, css_rule(cx.compact, "." + klass + ":active", active))
    end
    if str.Len(before) > 0:
        emit_rule(cx, css_rule(cx.compact, "." + klass + "::before", before))
    end
    if str.Len(after) > 0:
        emit_rule(cx, css_rule(cx.compact, "." + klass + "::after", after))
    end
    classattr := has_klass ? " class=\"" + klass + "\"" : ""
    esc := has_content ? html_escape(content) : ""

    if str.Equals(name, "link"):
        href := has_source ? html_escape(source) : "#"
        if has_child_elements(a, el):
            html_line(cx, "<a href=\"" + href + "\"" + classattr + attrs + ">")
            cx.indent += 1
            if has_content:
                html_line(cx, esc)
            end
            gen_children(cx, diag, a, el, klass, has_klass)
            cx.indent -= 1
            html_line(cx, "</a>")
        else:
            html_line(
                cx, "<a href=\"" + href + "\"" + classattr + attrs + ">" + esc + "</a>"
            )
        end
        ret
    end
    if str.Equals(name, "image"):
        html_line(
            cx, "<img src=\"" + (has_source ? html_escape(source) : "") + "\"" + classattr + attrs + " alt=\"" + esc + "\" />"
        )
        ret
    end
    if str.Equals(name, "input"):
        if has_type && str.Equals(type_val, "textarea"):
            html_line(
                cx, "<textarea" + classattr + attrs + ">" + esc + "</textarea>"
            )
        else:
            html_line(
                cx, "<input" + (has_type ? " type=\"" + type_val + "\"" : "") + classattr + attrs + " />"
            )
        end
        ret
    end

    if str.Equals(name, "canvas"):
        html_line(cx, "<canvas" + classattr + attrs + "></canvas>")
        ret
    end
    if str.Equals(name, "iframe"):
        html_line(
            cx, "<iframe" + classattr + attrs + (has_src ? " src=\"" + html_escape(srcv) + "\"" : "") + "></iframe>"
        )
        ret
    end
    if ltype == K_LO_LE_SINGLE:
        html_line(cx, "<" + tag + classattr + attrs + " />")
        ret
    end
    if has_child_elements(a, el):
        html_line(cx, "<" + tag + classattr + attrs + ">")
        cx.indent += 1
        if has_content:
            html_line(cx, esc)
        end
        gen_children(cx, diag, a, el, klass, has_klass)
        cx.indent -= 1
        html_line(cx, "</" + tag + ">")
    else:
        html_line(
            cx, "<" + tag + classattr + attrs + ">" + esc + "</" + tag + ">"
        )
    end
end

// ===========================================================================
// Public API (mirrors layout_expand.h + layout_gen.h; consumed by
// driver/layout_build.c).
// ===========================================================================

// Constructor for Result - cross-package struct literals are a parse error
// (salam/PORTING.md), so consumers build one through this instead of
// `lo.Result {}`.
pub func NewResult(): Result:
    ret Result {}
end

// find_layout (driver/layout_build.c) / find_layout_block (layout_expand.c):
// first AST_LAYOUT_BLOCK child of the program, 0 = none.
pub func FindLayout(a &: at.Ast, program: int): int:
    ret find_layout_block(a, program)
end

// layout_localize_names (layout_gen.c) - canonicalize element/attr
// spellings through the i18n layout-word registry, recursively.
pub func LocalizeNames(a &: at.Ast, node: int):
    if node == 0:
        ret
    end
    n := at.Get(a, node)
    if n.kind == at.AST_LAYOUT_ELEMENT || n.kind == at.AST_LAYOUT_ATTR:
        at.SetName(a, node, i18.LayoutWord(n.name))
    end
    repeat at.ChildCount(a, node) with i:
        LocalizeNames(a, at.Child(a, node, i))
    end
end

// layout_expand - component registration + include loading + expansion of
// the program's layout block in place. Returns the error count (size_t).
pub func Expand(
    log: lg.Logger, pack: lp.Langpack, ct: cc.Table, a &: at.Ast, program: int, base_dir: str
): int:
    mut ex := LoExpand {}
    defer ex.comp_name.free()
    defer ex.comp_def.free()
    defer ex.comp_dir.free()
    defer ex.comp_mother.free()
    defer ex.loaded_path.free()
    defer ex.loaded_prog.free()
    defer ex.loaded_dir.free()
    mut deftab := ex.cctab
    cc.TableFree(deftab)
    ex.log = log
    ex.pack = pack
    ex.cctab = ct
    lb := find_layout_block(a, program)
    if lb == 0:
        ret 0
    end
    collect(ex, a, program, base_dir, 0)
    mut items := Vector {} as Vector<int>
    mut none := LoFrame {}
    defer none.names.free()
    defer none.vals.free()
    defer none.content.free()
    expand_items(ex, a, items, lb, none, base_dir, 0)
    mut lbn := at.Get(a, lb)
    mut old := lbn.list
    defer old.free()
    lbn.list = items
    at.Put(a, lb, lbn)
    lg.Log(
        log, lg.PH_DRIVER, lg.LOG_INFO, co.Format2(
            "layout expand: %zu component(s), %zu included file(s)", co.ArgUint(ex.comp_name.len() as u64),
            co.ArgUint(ex.loaded_path.len() as u64)
        )
    )
    errors := ex.errors
    ret errors
end

// layout_generate - layout block AST -> Result (html/css/js/head + title/
// lang/dir). `diag` collects the W002 "rendered as <div>" warnings.
pub func Generate(
    log: lg.Logger, diag &: dg.Engine, file: str, a &: at.Ast, layout_block: int, compact: bool
): Result:
    mut cx := LoCtx {}
    defer cx.css_seen.free()
    defer cx.cls_keys.free()
    defer cx.cls_names.free()
    cx.log = log
    cx.file = file
    cx.compact = compact
    LocalizeNames(a, layout_block)
    lg.Log(log, lg.PH_CODEGEN, lg.LOG_INFO, "generating layout output")

    mut body_repeat := 1 as i64
    repeat at.ChildCount(a, layout_block) with i:
        iid := at.Child(a, layout_block, i)
        item := at.Get(a, iid)
        if item.kind != at.AST_LAYOUT_ATTR:
            continue
        end
        v := val_str(a, item.a)
        if str.Equals(item.name, "title"):
            cx.title = v
        else str.Equals(item.name, "lang"):
            l := sm.LayoutDynValue("lang", i18.LayoutValue(v))
            if str.Len(l) > 0:
                cx.lang = l
            end
        else str.Equals(item.name, "dir"):
            d := sm.LayoutDynValue("dir", i18.LayoutValue(v))
            if str.Len(d) > 0:
                cx.dir = d
            end
        else str.Equals(item.name, "repeat"):
            if item.a != 0:
                av := at.Get(a, item.a)
                if av.kind == at.AST_LITERAL && av.value_kind == tok.TV_INT:
                    r := av.value_int as i64
                    body_repeat = r < 1 ? 1 as i64 : r
                end
            end
        else str.Equals(item.name, "favicon"):
            if compact:
                cx.head += "<link rel=\"icon\" href=\"" + html_escape(v) + "\">"
            else:
                cx.head += "  <link rel=\"icon\" href=\"" + html_escape(v) + "\">\n"
            end
        end
    end

    mut r0 := 0 as i64
    until r0 < body_repeat:
        repeat at.ChildCount(a, layout_block) with i2:
            iid := at.Child(a, layout_block, i2)
            item := at.Get(a, iid)
            if item.kind == at.AST_LAYOUT_ATTR:
                if str.Equals(item.name, "content"):
                    html_line(cx, html_escape(val_str(a, item.a)))
                else !str.Equals(item.name, "title") && !str.Equals(item.name, "lang") && !str.Equals(item.name, "dir") && !str.Equals(item.name, "repeat") && !str.Equals(item.name, "favicon"):
                    lg.Log(
                        log, lg.PH_CODEGEN, lg.LOG_TRACE, co.Format1(
                            "ignoring document attribute '%s'", co.ArgStr(item.name)
                        )
                    )
                end
            else item.kind == at.AST_LAYOUT_ELEMENT:
                gen_element_n(cx, diag, a, iid, "layout", "", false)
            end
        end
        r0 += 1 as i64
    end
    mut r := Result {}
    r.html = cx.html
    r.css = cx.css
    r.js = cx.js
    r.head = cx.head
    r.title = cx.title
    r.lang = cx.lang
    r.dir = cx.dir
    lg.Log(
        log, lg.PH_CODEGEN, lg.LOG_INFO, co.Format3(
            "layout: %zu bytes HTML, %zu bytes CSS, %zu bytes JS", co.ArgUint(str.Len(r.html) as u64),
            co.ArgUint(str.Len(r.css) as u64), co.ArgUint(str.Len(r.js) as u64)
        )
    )
    ret r
end

// layout_document - full HTML document around a Result. "" hrefs play the
// C NULL (no stylesheet/script link).
pub func Document(
    r: Result, inl: bool, css_href: str, js_href: str, compact: bool
): str:
    mut d := ""
    if compact:
        d += "<!doctype html><html lang=\""
        d += r.lang
        d += "\" dir=\""
        d += r.dir
        d += "\"><head><meta charset=\"utf-8\">"
        d += "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">"
        d += "<title>"
        d += html_escape(r.title)
        d += "</title>"
        if str.Len(r.head) > 0:
            d += r.head
        end
        if inl:
            if str.Len(r.css) > 0:
                d += "<style>"
                d += r.css
                d += "</style>"
            end
        else str.Len(css_href) > 0:
            d += "<link rel=\"stylesheet\" href=\""
            d += css_href
            d += "\">"
        end
        d += "</head><body>"
        d += r.html
        if inl:
            if str.Len(r.js) > 0:
                d += "<script>"
                d += r.js
                d += "</script>"
            end
        else str.Len(js_href) > 0:
            d += "<script src=\""
            d += js_href
            d += "\"></script>"
        end
        d += "</body></html>"
    else:
        d += "<!doctype html>\n"
        d += "<html lang=\""
        d += r.lang
        d += "\" dir=\""
        d += r.dir
        d += "\">\n"
        d += "<head>\n"
        d += "  <meta charset=\"utf-8\">\n"
        d += "  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n"
        d += "  <title>"
        d += html_escape(r.title)
        d += "</title>\n"
        if str.Len(r.head) > 0:
            d += r.head
        end
        if inl:
            if str.Len(r.css) > 0:
                d += "  <style>\n"
                d += r.css
                d += "  </style>\n"
            end
        else str.Len(css_href) > 0:
            d += "  <link rel=\"stylesheet\" href=\""
            d += css_href
            d += "\">\n"
        end
        d += "</head>\n<body>\n"
        d += r.html
        if inl:
            if str.Len(r.js) > 0:
                d += "  <script>\n"
                d += r.js
                d += "  </script>\n"
            end
        else str.Len(js_href) > 0:
            d += "  <script src=\""
            d += js_href
            d += "\"></script>\n"
        end
        d += "</body>\n</html>\n"
    end
    ret d
end
