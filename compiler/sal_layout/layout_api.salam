func expand_block(ex &: LoExpand, log: lg.Logger, a &: at.Ast, program: int, lb: int, base_dir: str): int:
    collect(ex, a, program, base_dir, 0)
    lo_bub_reset(a, program)
    lo_bub_page_handlers(ex, a, lb)
    li_analyze(ex, a, program, lb)
    mut items := Vector {} as Vector<int>
    mut none := LoFrame { page = true }
    defer frame_free(none)
    lo_page_decls(a, program, lb, none)
    expand_items(ex, a, items, lb, none, base_dir, 0)
    mut lbn := at.Get(a, lb)
    mut old := lbn.list
    defer old.Free()
    lbn.list = items
    at.Put(a, lb, lbn)
    lg.Log(
        log, lg.PH_DRIVER, lg.LOG_INFO, co.Format4(
            "layout expand: %zu component%s, %zu included file%s", co.ArgUint(ex.comp_name.Len() as u64), co.ArgStr(plural_suffix(ex.comp_name.Len())), co.ArgUint(ex.loaded_path.Len() as u64), co.ArgStr(plural_suffix(ex.loaded_path.Len()))
        )
    )
    errors := ex.errors
    ret errors
end

func lo_page_decls(a &: at.Ast, program: int, lb: int, fr &: LoFrame):
    mut hoist := Vector {} as Vector<int>
    defer hoist.Free()
    repeat at.ChildCount(a, lb) in i:
        sid := at.Child(a, lb, i)
        if at.KindOf(a, sid) != at.AST_VAR_DECL:
            continue
        end
        sd := at.Get(a, sid)
        init := subst_value(a, sd.a, fr)
        if li_kind(sid) == LI_DERIVED:
            fr.present = true
            frame_set(fr, sd.name, init)
            fr.derived.Push(sd.name)
            continue
        end
        g := at.NewNode(a, at.AST_VAR_DECL)
        copy_span(a, g, sid)
        mut gn := at.Get(a, g)
        gn.name = sd.name
        gn.a = init
        gn.ty = sd.ty
        gn.is_mut = sd.is_mut
        at.Put(a, g, gn)
        hoist.Push(g)
    end
    if hoist.Len() == 0:
        ret
    end
    mut pn := at.Get(a, program)
    mut list := Vector {} as Vector<int>
    mut placed := false
    each item in pn.list:
        ph := at.ToplevelOrderPhase(a, item)
        if not placed and (ph == at.AST_ORDER_TYPEDEF or ph == at.AST_ORDER_FUNC or item == lb):
            each h in hoist:
                list.Push(h)
            end
            placed = true
        end
        list.Push(item)
    end
    if not placed:
        each h2 in hoist:
            list.Push(h2)
        end
    end
    mut old := pn.list
    pn.list = list
    at.Put(a, program, pn)
    old.Free()
end

pub func NewResult(): Result:
    ret Result {}
end

pub func FindLayout(a &: at.Ast, program: int): int:
    ret find_layout_block(a, program)
end

pub func LocalizeNames(a &: at.Ast, node: int):
    sm.LayoutResolve(a, node)
end

pub func Expand(
    log: lg.Logger, pack: lp.Langpack, ct: cc.Table, a &: at.Ast, program: int, base_dir: str
): int:
    mut ex := LoExpand {}
    defer ex.comp_name.Free()
    defer ex.comp_def.Free()
    defer ex.comp_dir.Free()
    defer ex.comp_mother.Free()
    defer ex.loaded_path.Free()
    defer ex.loaded_prog.Free()
    defer ex.loaded_dir.Free()
    mut deftab := ex.cctab
    cc.TableFree(deftab)
    ex.log = log
    ex.pack = pack
    ex.cctab = ct
    lb := find_layout_block(a, program)
    if lb == 0:
        ret 0
    end
    if not g_lo_web_state:
        li_reset()
    end
    ret expand_block(ex, log, a, program, lb, base_dir)
end

pub func ExpandPage(
    log: lg.Logger, pack: lp.Langpack, ct: cc.Table, a &: at.Ast, program: int, base_dir: str
): int:
    g_lo_wi_mark.Clear()
    g_lo_ws_inst.Clear()
    g_lo_ws_decl.Clear()
    g_lo_ws_css = ""
    g_lo_wi_kind.Clear()
    g_lo_ws_type.Clear()
    g_lo_ws_lit.Clear()
    g_lo_ws_ids.Clear()
    g_lo_ws_kind.Clear()
    li_reset()
    g_lo_each_depth = 0
    g_lo_web_state = true
    r := Expand(log, pack, ct, a, program, base_dir)
    g_lo_web_state = false
    ret r
end

pub func ExpandBlock(
    log: lg.Logger, pack: lp.Langpack, ct: cc.Table, a &: at.Ast, program: int, lb: int, base_dir: str
): int:
    mut ex := LoExpand {}
    defer ex.comp_name.Free()
    defer ex.comp_def.Free()
    defer ex.comp_dir.Free()
    defer ex.comp_mother.Free()
    defer ex.loaded_path.Free()
    defer ex.loaded_prog.Free()
    defer ex.loaded_dir.Free()
    mut deftab := ex.cctab
    cc.TableFree(deftab)
    ex.log = log
    ex.pack = pack
    ex.cctab = ct
    ret expand_block(ex, log, a, program, lb, base_dir)
end


pub func Generate(
    log: lg.Logger, diag &: dg.Engine, file: str, a &: at.Ast, layout_block: int, compact: bool, lang_code: str
): Result:
    mut cx := LoCtx {}
    cx.css = style.BaseCss()
    defer cx.css_seen.Free()
    defer cx.cls_keys.Free()
    defer cx.cls_names.Free()
    defer cx.gen_nodes.Free()
    defer cx.gen_names.Free()
    cx.log = log
    cx.file = file
    cx.compact = compact
    if str.Equals(lang_code, "fa"):
        cx.lang = "fa"
        cx.dir = "rtl"
    end
    sm.LayoutResolve(a, layout_block)
    lg.Log(log, lg.PH_CODEGEN, lg.LOG_INFO, "generating layout output")

    mut body_repeat := 1 as i64
    repeat at.ChildCount(a, layout_block) in i:
        iid := at.Child(a, layout_block, i)
        item := at.Get(a, iid)
        if item.kind != at.AST_LAYOUT_ATTR:
            continue
        end
        v := val_str(a, item.a)
        dyn := str.IndexOf(v, char_from_code(2)) >= 0
        if str.Equals(item.name, "title"):
            cx.title = v
        else str.Equals(item.name, "lang"):
            if dyn:
                cx.lang = v
            else:
                l := sm.LayoutDynValue("lang", i18.LayoutValue(v))
                if str.Len(l) > 0:
                    cx.lang = l
                end
            end
        else str.Equals(item.name, "dir"):
            if dyn:
                cx.dir = v
            else:
                d := sm.LayoutDynValue("dir", i18.LayoutValue(v))
                if str.Len(d) > 0:
                    cx.dir = d
                end
            end
        else str.Equals(item.name, "repeat"):
            if not dyn and item.a != 0:
                av := at.Get(a, item.a)
                if av.kind == at.AST_LITERAL and av.value_kind == tok.TV_INT:
                    r := av.value_int as i64
                    body_repeat = r < 1 ? 1 as i64 : r
                end
            end
        else str.Equals(item.name, "favicon"):
            if compact:
                cx.head += `<link rel="icon" href="` + html_escape(v) + `">`
            else:
                cx.head += `  <link rel="icon" href="` + html_escape(v) + "\">\n"
            end
        end
    end

    root_ei := sm.LayoutElemLookup("page")
    if root_ei >= 0:
        mut rla := LoAttrs {}
        defer lo_free_attrs(rla)
        lo_collect_attrs(cx, a, layout_block, root_ei, "body", rla)
        mut rklass := ""
        r_has := lo_class_for(cx, rla, rklass)
        if r_has and (str.Len(rla.css) > 0 or str.Len(rla.hover) > 0 or str.Len(rla.focus) > 0 or str.Len(rla.focus_within) > 0 or str.Len(rla.active) > 0 or str.Len(rla.disabled) > 0 or str.Len(rla.checked) > 0 or str.Len(rla.invalid) > 0 or str.Len(rla.placeholder) > 0 or str.Len(rla.selection) > 0 or str.Len(rla.before) > 0 or str.Len(rla.after) > 0):
            lo_emit_rules(cx, rla, rklass)
        else:
            if str.Len(rla.css) > 0:
                emit_rule(cx, css_rule(cx.compact, "body", rla.css))
            end
            if str.Len(rla.hover) > 0:
                emit_rule(cx, css_rule(cx.compact, "body:hover", rla.hover))
            end
            if str.Len(rla.focus) > 0:
                emit_rule(cx, css_rule(cx.compact, "body:focus", rla.focus))
            end
            if str.Len(rla.focus_within) > 0:
                emit_rule(cx, css_rule(cx.compact, "body:focus-within", rla.focus_within))
            end
            if str.Len(rla.active) > 0:
                emit_rule(cx, css_rule(cx.compact, "body:active", rla.active))
            end
            if str.Len(rla.disabled) > 0:
                emit_rule(cx, css_rule(cx.compact, "body:disabled", rla.disabled))
            end
            if str.Len(rla.checked) > 0:
                emit_rule(cx, css_rule(cx.compact, "body:checked", rla.checked))
            end
            if str.Len(rla.invalid) > 0:
                emit_rule(cx, css_rule(cx.compact, "body:invalid", rla.invalid))
            end
            if str.Len(rla.placeholder) > 0:
                emit_rule(cx, css_rule(cx.compact, "body::placeholder", rla.placeholder))
            end
            if str.Len(rla.selection) > 0:
                emit_rule(cx, css_rule(cx.compact, "body::selection", rla.selection))
            end
            if str.Len(rla.before) > 0:
                emit_rule(cx, css_rule(cx.compact, "body::before", rla.before))
            end
            if str.Len(rla.after) > 0:
                emit_rule(cx, css_rule(cx.compact, "body::after", rla.after))
            end
        end
        classattr := ""
        if r_has and rla.has_dynclass:
            classattr = ` class="` + rklass + " " + rla.dynclass + `"`
        else r_has:
            classattr = ` class="` + rklass + `"`
        else rla.has_dynclass:
            classattr = ` class="` + rla.dynclass + `"`
        end
        cx.body_attr = rla.first + classattr + rla.rest
    end

    mut r0 := 0 as i64
    until r0 < body_repeat:
        repeat at.ChildCount(a, layout_block) in i2:
            iid := at.Child(a, layout_block, i2)
            item := at.Get(a, iid)
            if item.kind == at.AST_LAYOUT_ATTR:
                if str.Equals(item.name, "content"):
                    html_line(cx, html_escape(val_str(a, item.a)))
                else not str.Equals(item.name, "title") and not str.Equals(item.name, "lang") and not str.Equals(item.name, "dir") and not str.Equals(item.name, "repeat") and not str.Equals(item.name, "favicon"):
                    lg.Log(
                        log, lg.PH_CODEGEN, lg.LOG_TRACE, co.Format1(
                            "ignoring document attribute '%s'", co.ArgStr(item.name)
                        )
                    )
                end
            else item.kind == at.AST_LAYOUT_ELEMENT:
                gen_element_n(cx, diag, a, iid, "", false)
            else item.kind == at.AST_IF or item.kind == at.AST_EACH:
                gen_control(cx, diag, a, iid, "", false)
            end
        end
        r0++
    end
    gen_std_finish(cx, diag, a)
    mut r := Result {}
    r.html = cx.html
    r.css = cx.css
    r.js = cx.js
    r.head = cx.head
    r.title = cx.title
    r.lang = cx.lang
    r.dir = cx.dir
    r.body_attr = cx.body_attr
    lg.Log(
        log, lg.PH_CODEGEN, lg.LOG_INFO, co.Format3(
            "layout: %zu bytes HTML, %zu bytes CSS, %zu bytes JS", co.ArgUint(str.Len(r.html) as u64), co.ArgUint(str.Len(r.css) as u64), co.ArgUint(str.Len(r.js) as u64)
        )
    )
    ret r
end

pub func Document(
    r: Result, inl: bool, css_href: str, js_href: str, compact: bool
): str:
    mut d := ""
    if compact:
        d += `<!doctype html><html lang="`
        d += r.lang
        d += `" dir="`
        d += r.dir
        d += `"><head><meta charset="utf-8">`
        d += `<meta name="viewport" content="width=device-width, initial-scale=1">`
        d += "<title>"
        d += html_escape(r.title)
        d += "</title>"
        if str.Len(r.head) > 0:
            d += r.head
        end
        if inl:
            if str.Len(r.css) > 0:
                d += "<style>"
                d += r.css
                d += "</style>"
            end
        else str.Len(css_href) > 0:
            d += `<link rel="stylesheet" href="`
            d += css_href
            d += `">`
        end
        d += "</head><body"
        d += r.body_attr
        d += ">"
        d += r.html
        if inl:
            if str.Len(r.js) > 0:
                d += "<script>"
                d += r.js
                d += "</script>"
            end
        else str.Len(js_href) > 0:
            d += `<script src="`
            d += js_href
            d += `"></script>`
        end
        d += "</body></html>"
    else:
        d += "<!doctype html>\n"
        d += `<html lang="`
        d += r.lang
        d += `" dir="`
        d += r.dir
        d += "\">\n"
        d += "<head>\n"
        d += "  <meta charset=\"utf-8\">\n"
        d += "  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n"
        d += "  <title>"
        d += html_escape(r.title)
        d += "</title>\n"
        if str.Len(r.head) > 0:
            d += r.head
        end
        if inl:
            if str.Len(r.css) > 0:
                d += "  <style>\n"
                d += r.css
                d += "  </style>\n"
            end
        else str.Len(css_href) > 0:
            d += `  <link rel="stylesheet" href="`
            d += css_href
            d += "\">\n"
        end
        d += "</head>\n<body"
        d += r.body_attr
        d += ">\n"
        d += r.html
        if inl:
            if str.Len(r.js) > 0:
                d += "  <script>\n"
                d += r.js
                d += "  </script>\n"
            end
        else str.Len(js_href) > 0:
            d += `  <script src="`
            d += js_href
            d += "\"></script>\n"
        end
        d += "</body>\n</html>\n"
    end
    ret d
end
