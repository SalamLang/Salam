mut g_lo_ev_seq := 0

func lo_ev_fresh_name(): str:
    g_lo_ev_seq++
    ret "__sl_ev_" + co.U64Toa(g_lo_ev_seq as u64)
end

func lo_ev_new_param(a &: at.Ast, name: str, from: int): int:
    id := at.NewNode(a, at.AST_PARAM)
    copy_span(a, id, from)
    at.SetName(a, id, name)
    ret id
end

func lo_ev_new_block(a &: at.Ast, items: Vector<int>, from: int): int:
    blk := at.NewNode(a, at.AST_BLOCK)
    copy_span(a, blk, from)
    mut bn := at.Get(a, blk)
    mut old := bn.list
    bn.list = items
    at.Put(a, blk, bn)
    old.Free()
    ret blk
end

func lo_ev_new_expr_stmt(a &: at.Ast, expr: int, from: int): int:
    sid := at.NewNode(a, at.AST_EXPR_STMT)
    copy_span(a, sid, from)
    mut sn := at.Get(a, sid)
    sn.a = expr
    at.Put(a, sid, sn)
    ret sid
end

func lo_ev_hoist_expr(a &: at.Ast, expr: int, ids &: Vector<int>, want_event: bool): str:
    fid := at.NewNode(a, at.AST_FUNC_DEF)
    copy_span(a, fid, expr)
    name := lo_ev_fresh_name()
    mut params := Vector {} as Vector<int>
    if want_event:
        params.Push(lo_ev_new_param(a, "event", expr))
    end
    mut items := Vector {} as Vector<int>
    items.Push(
        lo_ev_new_expr_stmt(a, at.Clone(a, expr), expr)
    )
    body := lo_ev_new_block(a, items, expr)
    mut fn := at.Get(a, fid)
    fn.name = name
    fn.list = params
    fn.a = body
    at.Put(a, fid, fn)
    ids.Push(fid)
    if want_event:
        ret lo_ev_call_text(name, 1)
    end
    ret lo_ev_call_text(name, 0)
end

func lo_ev_call_text(name: str, nparams: int): str:
    if nparams <= 0:
        ret name + "()"
    end
    ret name + "(event)"
end

func lo_ev_is_simple_member(a &: at.Ast, nid: int): bool:
    if nid == 0:
        ret false
    end
    n := at.Get(a, nid)
    if n.kind == at.AST_IDENTIFIER:
        ret true
    end
    if n.kind == at.AST_MEMBER and str.Len(n.name) > 0:
        ret lo_ev_is_simple_member(a, n.a)
    end
    ret false
end

func lo_ev_is_simple_expr(a &: at.Ast, nid: int): bool:
    if nid == 0:
        ret false
    end
    n := at.Get(a, nid)
    if n.kind == at.AST_IDENTIFIER or n.kind == at.AST_LITERAL:
        ret true
    end
    if n.kind == at.AST_MEMBER and str.Len(n.name) > 0:
        ret lo_ev_is_simple_expr(a, n.a)
    end
    if n.kind == at.AST_CALL:
        if not lo_ev_is_simple_expr(a, n.a):
            ret false
        end
        mut ok := true
        repeat n.list.Len() in i:
            if not lo_ev_is_simple_expr(a, n.list.Get(i)):
                ok = false
            end
        end
        ret ok
    end
    ret false
end

func lo_ev_expr_text(a &: at.Ast, nid: int): str:
    if nid == 0:
        ret ""
    end
    n := at.Get(a, nid)
    if n.kind == at.AST_IDENTIFIER:
        ret n.name
    end
    if n.kind == at.AST_MEMBER:
        base := lo_ev_expr_text(a, n.a)
        if str.Len(base) == 0:
            ret ""
        end
        ret base + "." + n.name
    end
    ret ""
end

func lo_ev_shadowed(name: str): bool:
    each line in k_lo_ev_dom_names:
        padded := " " + line + " "
        if padded.Find(" " + name + " ") >= 0:
            ret true
        end
    end
    ret false
end

func lo_window_member(name: str): bool:
    if name.StartsWith("on") and str.Equals(str.Lower(name), name):
        ret true
    end
    each line in k_lo_ev_window_names:
        padded := " " + line + " "
        if padded.Find(" " + name + " ") >= 0:
            ret true
        end
    end
    ret false
end

func lo_ev_target(name: str): str:
    if lo_window_member(name):
        ret "window.salamOn['" + name + "']"
    end
    ret "window['" + name + "']"
end

func lo_ev_attr_text(name: str, nparams: int): str:
    if str.IndexOf(name, " ") < 0 and not lo_ev_shadowed(name) and not lo_window_member(name):
        ret lo_ev_call_text(name, nparams)
    end
    if nparams <= 0:
        ret lo_ev_target(name) + "()"
    end
    ret lo_ev_target(name) + "(event)"
end

func lo_ev_attr_id(ei: int, name: str): int:
    mut key := sm.LayoutAttrKeyFor(ei, name)
    if str.Len(key) == 0:
        key = name
    end
    ret sm.LayoutAttrFor(ei, key)
end

func lo_ev_vtype(ei: int, name: str): int:
    ai := lo_ev_attr_id(ei, name)
    if ai < 0:
        ret -1
    end
    ret sm.LayoutAttrVtype(ai)
end

func lo_ev_is_submit(ei: int, name: str): bool:
    ai := lo_ev_attr_id(ei, name)
    ret ai >= 0 and str.Equals(sm.LayoutAttrOut(ai), "onsubmit")
end

func lo_ev_prog_func_params(a &: at.Ast, prog: int, name: str): int:
    repeat at.ChildCount(a, prog) in i:
        did := at.Child(a, prog, i)
        d := at.Get(a, did)
        if d.kind == at.AST_FUNC_DEF and str.Equals(d.name, name):
            mut n := 0
            repeat d.list.Len() in pi:
                if at.KindOf(a, d.list.Get(pi)) == at.AST_PARAM:
                    n++
                end
            end
            ret n
        end
    end
    ret -1
end

func lo_ev_str_param(a &: at.Ast, params: Vector<int>): bool:
    mut found := 0
    mut n := 0
    repeat params.Len() in i:
        if at.KindOf(a, params.Get(i)) == at.AST_PARAM:
            n++
            found = params.Get(i)
        end
    end
    if n != 1:
        ret false
    end
    ty := at.Get(a, found).ty
    if ty == 0:
        ret false
    end
    tn := at.Get(a, ty).name
    ret str.Equals(tn, "str") or str.Equals(tn, "رشته")
end

func lo_ev_value_call(name: str): str:
    ret name + "(event.target.value || '')"
end

func lo_ev_value_attr(name: str): str:
    if str.IndexOf(name, " ") >= 0 or lo_ev_shadowed(name) or lo_window_member(name):
        ret lo_ev_target(name) + "(event.target.value || '')"
    end
    ret lo_ev_value_call(name)
end

func lo_ev_prog_func_str(a &: at.Ast, prog: int, name: str): bool:
    repeat at.ChildCount(a, prog) in i:
        d := at.Get(a, at.Child(a, prog, i))
        if d.kind == at.AST_FUNC_DEF and str.Equals(d.name, name):
            ret lo_ev_str_param(a, d.list)
        end
    end
    ret false
end

func lo_ev_hoist_lambda(a &: at.Ast, lam: int, ids &: Vector<int>): str:
    l := at.Get(a, lam)
    fid := at.NewNode(a, at.AST_FUNC_DEF)
    copy_span(a, fid, lam)
    name := lo_ev_fresh_name()
    mut params := Vector {} as Vector<int>
    mut nparams := 0
    repeat l.list.Len() in pi:
        params.Push(l.list.Get(pi))
        if at.KindOf(a, l.list.Get(pi)) == at.AST_PARAM:
            nparams++
        end
    end
    mut fn := at.Get(a, fid)
    fn.name = name
    fn.list = params
    fn.a = l.a
    at.Put(a, fid, fn)
    ids.Push(fid)
    if lo_ev_str_param(a, l.list):
        ret lo_ev_value_call(name)
    end
    ret lo_ev_call_text(name, nparams)
end

func lo_ev_rewrite_attr(
    a &: at.Ast, prog: int, attr: int, ei: int, ids &: Vector<int>, names &: Vector<str>
):
    an := at.Get(a, attr)
    if str.Len(an.name) == 0 or an.a == 0:
        ret
    end
    vt := lo_ev_vtype(ei, an.name)
    if vt != sm.VT_CODE:
        ret
    end
    v := at.Get(a, an.a)
    if v.kind == at.AST_LITERAL:
        ret
    end
    if sm.ResolveStyleAttr(an.name).ok:
        if v.kind == at.AST_LITERAL or v.kind == at.AST_BINARY or v.kind == at.AST_UNARY:
            ret
        end
        if v.kind == at.AST_IDENTIFIER and lo_ev_prog_func_params(a, prog, v.name) < 0:
            ret
        end
    end
    mut call_text := ""
    mut attr_text := ""
    // Event payload/propagation contract (source-level, partial):
    // - Hoisted expression/lambda handlers are normalized to callbacks that may receive a single `event` argument (see call_text/arity below).
    // - Identifier/member handlers preserve the referenced function/member signature contract (no implicit payload injection).
    // - Salam component `emit`/`stop` bubbling is rewritten in layout expansion (layout_bubble) and is separate from DOM/native UI event propagation.
    // - DOM/native propagation phase, capture, stopPropagation/preventDefault/defaultPrevented, key/pointer modifiers, target/currentTarget,
    //   and lifecycle attach/detach timing are runtime/toolchain responsibilities and not fully encoded in generated source today.
    // TODO(runtime/toolchain): define a stable cross-target event payload object shape and propagation controls (capture/once/passive/stop/preventDefault),
    //   including mount/update/unmount handler (re)binding and cleanup hooks for dynamic keyed regions. Web/native parity must be validated at runtime.
    // TODO(runtime): preserve richer payload metadata (target/currentTarget, modifiers, phase, defaultPrevented) when host runtimes expose it.
    if v.kind == at.AST_LAMBDA:
        call_text = lo_ev_hoist_lambda(a, an.a, ids)
        attr_text = call_text
    else v.kind == at.AST_IDENTIFIER:
        mut np := lo_ev_prog_func_params(a, prog, v.name)
        if np < 0:
            sm.NoteHandlerName(attr, v.name)
            np = 0
        end
        call_text = lo_ev_call_text(v.name, np)
        attr_text = lo_ev_attr_text(v.name, np)
        if np == 1 and lo_ev_prog_func_str(a, prog, v.name):
            call_text = lo_ev_value_call(v.name)
            attr_text = lo_ev_value_attr(v.name)
        end
    else v.kind == at.AST_MEMBER and lo_ev_is_simple_member(a, an.a):
        expr := lo_ev_expr_text(a, an.a)
        if str.Len(expr) == 0:
            ret
        end
        call_text = lo_ev_call_text(expr, 0)
        attr_text = call_text
    else v.kind == at.AST_CALL:
        if lo_ev_is_simple_member(a, v.a) and v.list.Len() == 0:
            expr := lo_ev_expr_text(a, v.a)
            if str.Len(expr) == 0:
                ret
            end
            if at.KindOf(a, v.a) == at.AST_IDENTIFIER:
                mut np2 := lo_ev_prog_func_params(a, prog, expr)
                if np2 < 0:
                    np2 = 0
                end
                call_text = lo_ev_call_text(expr, np2)
                attr_text = lo_ev_attr_text(expr, np2)
                if np2 == 1 and lo_ev_prog_func_str(a, prog, expr):
                    call_text = lo_ev_value_call(expr)
                    attr_text = lo_ev_value_attr(expr)
                end
            else:
                call_text = expr + "()"
                attr_text = call_text
            end
        else if lo_ev_is_simple_expr(a, v.a):
            call_text = lo_ev_hoist_expr(a, an.a, ids, true)
            attr_text = call_text
        else:
            call_text = lo_ev_hoist_expr(a, an.a, ids, true)
            attr_text = call_text
        end
    else v.kind == at.AST_BINARY or v.kind == at.AST_UNARY or v.kind == at.AST_TERNARY or
        v.kind == at.AST_INDEX or v.kind == at.AST_LITERAL:
        call_text = lo_ev_hoist_expr(a, an.a, ids, true)
        attr_text = call_text
    else:
        call_text = lo_ev_hoist_expr(a, an.a, ids, true)
        attr_text = call_text
    end
    names.Push(call_text)
    if lo_ev_is_submit(ei, an.name):
        attr_text = K_LO_EV_NO_RELOAD + attr_text
    end
    mut n2 := at.Get(a, attr)
    n2.a = mk_str(a, attr_text, attr)
    at.Put(a, attr, n2)
end

func lo_ev_walk(
    a &: at.Ast, prog: int, container: int, ei: int, ids &: Vector<int>, names &: Vector<str>
):
    repeat at.ChildCount(a, container) in i:
        cid := at.Child(a, container, i)
        k := at.KindOf(a, cid)
        if k == at.AST_LAYOUT_ATTR:
            lo_ev_rewrite_attr(a, prog, cid, ei, ids, names)
        else k == at.AST_LAYOUT_ELEMENT:
            lo_ev_walk(a, prog, cid, sm.LayoutElemOf(a, cid), ids, names)
        else k == at.AST_IF:
            lo_ev_walk_if(a, prog, cid, ei, ids, names)
        else k == at.AST_EACH:
            n := at.Get(a, cid)
            lo_ev_walk(a, prog, n.b, ei, ids, names)
        end
    end
end

func lo_ev_walk_if(
    a &: at.Ast, prog: int, nid: int, ei: int, ids &: Vector<int>, names &: Vector<str>
):
    n := at.Get(a, nid)
    lo_ev_walk(a, prog, n.b, ei, ids, names)
    if n.c != 0:
        if at.KindOf(a, n.c) == at.AST_IF:
            lo_ev_walk_if(a, prog, n.c, ei, ids, names)
        else:
            lo_ev_walk(a, prog, n.c, ei, ids, names)
        end
    end
end

pub func WindowMember(name: str): bool:
    ret lo_window_member(name)
end

pub func ResetEventNames():
    g_lo_ev_seq = 0
end

pub func HoistEventHandlers(a &: at.Ast, prog: int): Vector<str>:
    mut names := Vector {} as Vector<str>
    sm.ClearHandlerNotes()
    if prog == 0:
        ret names
    end
    mut ids := Vector {} as Vector<int>
    repeat at.ChildCount(a, prog) in i:
        did := at.Child(a, prog, i)
        d := at.Get(a, did)
        if d.kind == at.AST_LAYOUT_BLOCK and not d.view_glue:
            lo_ev_walk(a, prog, did, -1, ids, names)
        end
    end
    if ids.Len() == 0:
        ids.Free()
        ret names
    end
    mut pn := at.Get(a, prog)
    mut list := Vector {} as Vector<int>
    repeat pn.list.Len() in k:
        list.Push(pn.list.Get(k))
    end
    repeat ids.Len() in e:
        list.Push(ids.Get(e))
    end
    mut old := pn.list
    pn.list = list
    at.Put(a, prog, pn)
    old.Free()
    ids.Free()
    ret names
end
