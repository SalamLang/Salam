package layout

import str

include pth "../sal_path.salam"
include co "../sal_core.salam"
include tok "../token.salam"
include src "../source.salam"
include lg "../logger.salam"
include lx "../lexer/lexer.salam"
include at "../ast.salam"
include ps "../parser/parser.salam"
include cc "../condcomp.salam"
include sm "../semantic/semantic.salam"
include i18 "../i18n.salam"

func is_include_attr(n: str): bool:
    ret str.Equals(n, "include") or str.Equals(n, "بگنجان")
end

func is_content_word(n: str): bool:
    ret str.Equals(n, "content") or str.Equals(n, "children") or str.Equals(n, "محتوا") or str.Equals(n, "slot") or str.Equals(n, "جایگاه")
end

func is_slot_placeholder_name(n: str): bool:
    ret str.Equals(n, "content") or str.Equals(n, "محتوا") or str.Equals(n, "slot") or str.Equals(n, "جایگاه")
end

func is_default_slot_name(name: str): bool:
    ret str.Len(name) == 0 or str.Equals(name, "default") or str.Equals(name, "content") or str.Equals(name, "children") or str.Equals(name, "محتوا")
end

func slot_attr_name(a &: at.Ast, nid: int): str:
    if nid == 0:
        ret ""
    end
    // Prefer explicit slot-routing attrs (`slot`/`جایگاه`), then provider/placeholder name (`name`/`نام`).
    // `name` is only treated as slot metadata for slot placeholder/provider nodes; regular elements must
    // route via `slot`/`جایگاه` to avoid leaking/conflicting with HTML `name` attributes.
    // Provider/routing attrs must be simple literal/text values; dynamic names are treated as unknown at expansion time.
    is_placeholder := false
    if at.KindOf(a, nid) == at.AST_LAYOUT_ELEMENT:
        is_placeholder = is_slot_placeholder_name(at.Get(a, nid).name)
    end
    repeat at.ChildCount(a, nid) in i:
        cid := at.Child(a, nid, i)
        c := at.Get(a, cid)
        if c.kind == at.AST_LAYOUT_ATTR and (str.Equals(c.name, "slot") or str.Equals(c.name, "جایگاه")):
            t := node_text(a, c.a)
            if str.Len(t) > 0:
                ret t
            end
        end
    end
    if not is_placeholder:
        ret ""
    end
    repeat at.ChildCount(a, nid) in i:
        cid := at.Child(a, nid, i)
        c := at.Get(a, cid)
        if c.kind == at.AST_LAYOUT_ATTR and (str.Equals(c.name, "name") or str.Equals(c.name, "نام")):
            t := node_text(a, c.a)
            if str.Len(t) > 0:
                ret t
            end
        end
    end
    ret ""
end

func slot_strip_routing_attrs(a &: at.Ast, nid: int): int:
    // Clone an element/slot node while removing slot-routing metadata attrs so
    // routing hints do not leak into generated output.
    // Regular content elements: strip only `slot`/`جایگاه` (preserve HTML `name`).
    // Slot placeholder/provider wrappers: strip routing/provider metadata attrs.
    if nid == 0:
        ret 0
    end
    cp := at.Clone(a, nid)
    if at.KindOf(a, nid) != at.AST_LAYOUT_ELEMENT:
        ret cp
    end
    is_placeholder := is_slot_placeholder_name(at.Get(a, nid).name)
    mut kept := Vector {} as Vector<int>
    repeat at.ChildCount(a, nid) in i:
        cid := at.Child(a, nid, i)
        c := at.Get(a, cid)
        if c.kind == at.AST_LAYOUT_ATTR:
            if str.Equals(c.name, "slot") or str.Equals(c.name, "جایگاه"):
                continue
            end
            if is_placeholder and (str.Equals(c.name, "name") or str.Equals(c.name, "نام")):
                continue
            end
        end
        kept.Push(at.Clone(a, cid))
    end
    mut cn := at.Get(a, cp)
    mut old := cn.list
    cn.list = kept
    at.Put(a, cp, cn)
    old.Free()
    ret cp
end

func slot_provider_kind(a &: at.Ast, nid: int): int:
    // 0: not a provider, 1: default provider wrapper, 2: named provider wrapper
    if nid == 0 or at.KindOf(a, nid) != at.AST_LAYOUT_ELEMENT:
        ret 0
    end
    n := at.Get(a, nid)
    if not is_slot_placeholder_name(n.name):
        ret 0
    end
    sname := slot_attr_name(a, nid)
    if is_default_slot_name(sname):
        ret 1
    end
    ret 2
end

func lo_dir_of(path: str): str:
    ret pth.PathDir(path)
end

func mk_str(a &: at.Ast, s: str, span_from: int): int:
    n := at.NewNode(a, at.AST_LITERAL)
    copy_span(a, n, span_from)
    at.SetOp(a, n, tok.TK_STRING)
    at.SetName(a, n, s)
    mut v := tok.ValueNone()
    v.kind = tok.TV_STRING
    v.sval = s
    at.SetTokenValue(a, n, v)
    ret n
end

func node_text(a &: at.Ast, vid: int): str:
    if vid == 0:
        ret ""
    end
    v := at.Get(a, vid)
    if v.kind == at.AST_IDENTIFIER:
        ret v.name
    end
    if v.kind == at.AST_LITERAL:
        if v.op == tok.TK_STRING or v.op == tok.TK_TRIPLE_STRING or v.op == tok.TK_RAW_STRING:
            ret v.value_str
        end
        if v.op == tok.TK_INT:
            ret co.U64Toa(v.value_int)
        end
        if v.op == tok.TK_FLOAT:
            ret co.Format1("%g", co.ArgFloat(v.value_float))
        end
        if v.op == tok.TK_KW_TRUE:
            ret "true"
        end
        if v.op == tok.TK_KW_FALSE:
            ret "false"
        end
        ret v.name
    end
    ret ""
end

func frame_lookup(f &: LoFrame, name: str, found &: bool): int:
    found = false
    if not f.present:
        ret 0
    end
    each sh in f.shadow:
        if str.Equals(sh, name):
            ret 0
        end
    end
    repeat f.names.Len() in i:
        if str.Equals(f.names.Get(i), name):
            found = true
            ret f.vals.Get(i)
        end
    end
    ret 0
end

func frame_cut(f &: LoFrame, mark: int):
    until f.shadow.Len() > mark:
        _x := f.shadow.Pop()
    end
end

func frame_is_derived(f &: LoFrame, name: str): bool:
    each d in f.derived:
        if str.Equals(d, name):
            ret true
        end
    end
    ret false
end

func frame_derive(a &: at.Ast, f &: LoFrame, body: int):
    if body == 0:
        ret
    end
    repeat at.ChildCount(a, body) in i:
        sid := at.Child(a, body, i)
        if at.KindOf(a, sid) != at.AST_VAR_DECL or li_kind(sid) != LI_DERIVED:
            continue
        end
        sd := at.Get(a, sid)
        frame_set(f, sd.name, subst_value(a, sd.a, f))
        f.derived.Push(sd.name)
    end
end

func frame_free(f &: LoFrame):
    f.names.Free()
    f.vals.Free()
    f.content.Free()
    repeat f.slot_nodes.Len() in i:
        mut v := f.slot_nodes.Get(i)
        v.Free()
    end
    f.slot_names.Free()
    f.slot_nodes.Free()
    f.slot_provided.Free()
    f.derived.Free()
    f.shadow.Free()
end

func frame_slot_index(f &: LoFrame, name: str): int:
    repeat f.slot_names.Len() in i:
        if str.Equals(f.slot_names.Get(i), name):
            ret i
        end
    end
    ret 0 - 1
end

func frame_ensure_slot(f &: LoFrame, name: str): int:
    i := frame_slot_index(f, name)
    if i >= 0:
        ret i
    end
    f.slot_names.Push(name)
    f.slot_nodes.Push(Vector {} as Vector<int>)
    f.slot_provided.Push(false)
    ret f.slot_names.Len() - 1
end

func frame_mark_slot(f &: LoFrame, name: str):
    i := frame_ensure_slot(f, name)
    f.slot_provided.Set(i, true)
end

func frame_push_slot(f &: LoFrame, name: str, nid: int):
    i := frame_ensure_slot(f, name)
    mut v := f.slot_nodes.Get(i)
    v.Push(nid)
    f.slot_nodes.Set(i, v)
    f.slot_provided.Set(i, true)
end

func frame_slot_items(f &: LoFrame, name: str, out &: Vector<int>): bool:
    i := frame_slot_index(f, name)
    if i < 0 or not f.slot_provided.Get(i):
        ret false
    end
    v := f.slot_nodes.Get(i)
    repeat v.Len() in j:
        out.Push(v.Get(j))
    end
    ret true
end

func frame_has_any_content(f &: LoFrame): bool:
    if f.content.Len() > 0:
        ret true
    end
    repeat f.slot_provided.Len() in i:
        if f.slot_provided.Get(i):
            ret true
        end
    end
    ret false
end

func frame_set(f &: LoFrame, name: str, val: int):
    repeat f.names.Len() in i:
        if str.Equals(f.names.Get(i), name):
            f.vals.Set(i, val)
            ret
        end
    end
    f.names.Push(name)
    f.vals.Push(val)
end

func interpolate(a &: at.Ast, s: str, f &: LoFrame): str:
    if not f.present or str.IndexOf(s, "{") < 0:
        ret s
    end
    mut out := ""
    mut changed := false
    n := str.Len(s)
    mut p := 0
    until p < n:
        if byte_at(s, p) == 123:
            close := str.IndexFrom(s, "}", p)
            if close >= 0:
                key := str.Substr(s, p + 1, close - (p + 1))
                mut found := false
                bound := frame_lookup(f, key, found)
                if found:
                    out += node_text(a, bound)
                    changed = true
                    p = close + 1
                    continue
                end
            end
        end
        out += str.Substr(s, p, 1)
        p++
    end
    if changed:
        ret out
    end
    ret s
end

func subst_value(a &: at.Ast, vid: int, f &: LoFrame): int:
    if vid == 0 or not f.present:
        ret vid
    end
    v := at.Get(a, vid)
    if v.kind == at.AST_IDENTIFIER:
        mut found := false
        bound := frame_lookup(f, v.name, found)
        if found:
            if bound != 0:
                if lo_is_state_ref(a, bound) or frame_is_derived(f, v.name):
                    ret at.Clone(a, bound)
                end
                ret bound
            end
            ret mk_str(a, "", vid)
        end
    end
    if v.kind == at.AST_LITERAL and (v.op == tok.TK_STRING or v.op == tok.TK_TRIPLE_STRING or v.op == tok.TK_RAW_STRING):
        interp := interpolate(a, v.value_str, f)
        if not str.Equals(interp, v.value_str):
            ret mk_str(a, interp, vid)
        end
    end
    k := v.kind
    if k == at.AST_LAMBDA:
        mark := f.shadow.Len()
        repeat v.list.Len() in li:
            if at.KindOf(a, v.list.Get(li)) == at.AST_PARAM:
                f.shadow.Push(at.Get(a, v.list.Get(li)).name)
            end
        end
        nbody := subst_block(a, v.a, f)
        frame_cut(f, mark)
        if nbody == v.a:
            ret vid
        end
        cp := at.NewNode(a, at.AST_LAMBDA)
        mut cn := v
        cn.a = nbody
        mut params := Vector {} as Vector<int>
        repeat v.list.Len() in pi:
            params.Push(v.list.Get(pi))
        end
        cn.list = params
        cn.ext = 0
        at.Put(a, cp, cn)
        ret cp
    end
    if k == at.AST_BINARY or k == at.AST_UNARY or k == at.AST_TERNARY or k == at.AST_INDEX or k == at.AST_MEMBER or k == at.AST_CALL or k == at.AST_CAST or k == at.AST_ASSIGN or k == at.AST_INCDEC or k == at.AST_SLICE or k == at.AST_ARRAY_LIT or k == at.AST_STRUCT_LIT or k == at.AST_FIELD_INIT:
        na := k == at.AST_CALL ? subst_callee(a, v.a, f) : subst_value(a, v.a, f)
        nb := subst_value(a, v.b, f)
        nc := subst_value(a, v.c, f)
        mut args := Vector {} as Vector<int>
        mut changed := na != v.a or nb != v.b or nc != v.c
        repeat v.list.Len() in i:
            arg := v.list.Get(i)
            sa := subst_value(a, arg, f)
            if sa != arg:
                changed = true
            end
            args.Push(sa)
        end
        if not changed:
            args.Free()
            ret vid
        end
        cp := at.NewNode(a, k)
        mut cn := v
        cn.a = na
        cn.b = nb
        cn.c = nc
        cn.list = args
        cn.ext = 0
        at.Put(a, cp, cn)
        repeat at.Dims(a, v.ext).Len() in d:
            at.AddDim(a, cp, at.Dims(a, v.ext).Get(d))
        end
        ret cp
    end
    ret vid
end

func subst_callee(a &: at.Ast, cid: int, f &: LoFrame): int:
    if cid == 0:
        ret cid
    end
    c := at.Get(a, cid)
    if c.kind == at.AST_MEMBER:
        ret subst_value(a, cid, f)
    end
    if c.kind != at.AST_IDENTIFIER:
        ret cid
    end
    mut found := false
    bound := frame_lookup(f, c.name, found)
    if not found or bound == 0:
        ret cid
    end
    bk := at.KindOf(a, bound)
    if bk == at.AST_LAMBDA or bk == at.AST_IDENTIFIER:
        ret at.Clone(a, bound)
    end
    ret cid
end

func subst_missing_callback(a &: at.Ast, sid: int, f &: LoFrame): bool:
    if not f.present:
        ret false
    end
    call := lo_bub_stmt_call(a, sid)
    if call == 0:
        ret false
    end
    c := at.Get(a, call)
    if c.a == 0 or at.KindOf(a, c.a) != at.AST_IDENTIFIER:
        ret false
    end
    mut found := false
    bound := frame_lookup(f, at.Get(a, c.a).name, found)
    ret found and bound == 0
end

func subst_stmt(a &: at.Ast, nid: int, f &: LoFrame): int:
    if nid == 0:
        ret 0
    end
    n := at.Get(a, nid)
    if n.kind == at.AST_BLOCK:
        ret subst_block(a, nid, f)
    end
    if n.kind == at.AST_VAR_DECL:
        na := subst_value(a, n.a, f)
        if na == n.a:
            ret nid
        end
        cp := at.NewNode(a, at.AST_VAR_DECL)
        mut cn := n
        cn.a = na
        at.Put(a, cp, cn)
        ret cp
    end
    if n.kind == at.AST_EXPR_STMT or n.kind == at.AST_RETURN or n.kind == at.AST_DEFER or n.kind == at.AST_BREAK or n.kind == at.AST_CONTINUE:
        na := subst_value(a, n.a, f)
        if na == n.a:
            ret nid
        end
        cp := at.NewNode(a, n.kind)
        mut cn := n
        cn.a = na
        at.Put(a, cp, cn)
        ret cp
    end
    if n.kind == at.AST_ASSIGN or n.kind == at.AST_INCDEC or n.kind == at.AST_CALL:
        ret subst_value(a, nid, f)
    end
    if n.kind == at.AST_IF:
        na := subst_value(a, n.a, f)
        nb := subst_stmt(a, n.b, f)
        nc := subst_stmt(a, n.c, f)
        if na == n.a and nb == n.b and nc == n.c:
            ret nid
        end
        cp := at.NewNode(a, at.AST_IF)
        mut cn := n
        cn.a = na
        cn.b = nb
        cn.c = nc
        at.Put(a, cp, cn)
        ret cp
    end
    if n.kind == at.AST_UNTIL:
        na := subst_value(a, n.a, f)
        nb := subst_stmt(a, n.b, f)
        if na == n.a and nb == n.b:
            ret nid
        end
        cp := at.NewNode(a, at.AST_UNTIL)
        mut cn := n
        cn.a = na
        cn.b = nb
        at.Put(a, cp, cn)
        ret cp
    end
    if n.kind == at.AST_EACH:
        na := subst_value(a, n.a, f)
        mark := f.shadow.Len()
        f.shadow.Push(n.name)
        if n.c != 0 and at.KindOf(a, n.c) == at.AST_IDENTIFIER:
            f.shadow.Push(at.Get(a, n.c).name)
        end
        nb := subst_stmt(a, n.b, f)
        frame_cut(f, mark)
        if na == n.a and nb == n.b:
            ret nid
        end
        cp := at.NewNode(a, at.AST_EACH)
        mut cn := n
        cn.a = na
        cn.b = nb
        at.Put(a, cp, cn)
        ret cp
    end
    if n.kind == at.AST_REPEAT:
        na := subst_value(a, n.a, f)
        nc := subst_value(a, n.c, f)
        nd := subst_value(a, n.d, f)
        rmark := f.shadow.Len()
        if str.Len(n.name) > 0:
            f.shadow.Push(n.name)
        end
        nb := subst_stmt(a, n.b, f)
        frame_cut(f, rmark)
        if na == n.a and nc == n.c and nd == n.d and nb == n.b:
            ret nid
        end
        cp := at.NewNode(a, at.AST_REPEAT)
        mut cn := n
        cn.a = na
        cn.c = nc
        cn.d = nd
        cn.b = nb
        at.Put(a, cp, cn)
        ret cp
    end
    ret nid
end

func subst_block(a &: at.Ast, nid: int, f &: LoFrame): int:
    if nid == 0:
        ret 0
    end
    n := at.Get(a, nid)
    mut changed := false
    mut items := Vector {} as Vector<int>
    mark := f.shadow.Len()
    repeat n.list.Len() in i:
        child := n.list.Get(i)
        if subst_missing_callback(a, child, f):
            changed = true
            continue
        end
        s := subst_stmt(a, child, f)
        if s != child:
            changed = true
        end
        items.Push(s)
        if at.KindOf(a, child) == at.AST_VAR_DECL:
            f.shadow.Push(at.Get(a, child).name)
        end
    end
    frame_cut(f, mark)
    if not changed:
        items.Free()
        ret nid
    end
    cp := at.NewNode(a, at.AST_BLOCK)
    mut cn := n
    cn.list = items
    at.Put(a, cp, cn)
    ret cp
end

func find_comp(ex &: LoExpand, name: str): int:
    repeat ex.comp_name.Len() in i:
        if lp.IdentEqual(ex.comp_name.Get(i), name):
            ret i
        end
    end
    ret 0 - 1
end

func body_has_content_sink(a &: at.Ast, node: int): bool:
    repeat at.ChildCount(a, node) in i:
        cid := at.Child(a, node, i)
        k := at.KindOf(a, cid)
        if k == at.AST_LAYOUT_ELEMENT:
            c := at.Get(a, cid)
            if is_slot_placeholder_name(c.name):
                ret true
            end
            if body_has_content_sink(a, cid):
                ret true
            end
        else k == at.AST_EACH:
            if body_has_content_sink(a, at.Get(a, cid).b):
                ret true
            end
        else k == at.AST_IF:
            n := at.Get(a, cid)
            if body_has_content_sink(a, n.b):
                ret true
            end
            if n.c != 0 and body_has_content_sink(a, n.c):
                ret true
            end
        end
    end
    ret false
end

func register_components(ex &: LoExpand, a &: at.Ast, program: int, dir: str):
    repeat at.ChildCount(a, program) in i:
        did := at.Child(a, program, i)
        d := at.Get(a, did)
        if d.kind != at.AST_LAYOUT_COMPONENT:
            continue
        end
        if find_comp(ex, d.name) >= 0:
            lg.Log(
                ex.log, lg.PH_DRIVER, lg.LOG_WARN, co.Format1(
                    i18.Tr("duplicate component '%s' ignored"), co.ArgStr(d.name)
                )
            )
            continue
        end
        repeat at.ChildCount(a, did) in j:
            p := at.Get(a, at.Child(a, did, j))
            if p.kind == at.AST_PARAM and is_content_word(p.name):
                lg.Log(
                    ex.log, lg.PH_DRIVER, lg.LOG_ERROR, co.Format1(
                        i18.Tr("component '%s': '%s' is reserved and cannot be a parameter"), co.ArgStr(d.name),
                        co.ArgStr(p.name)
                    )
                )
                ex.errors++
            end
        end
        mut mother := false
        if d.a != 0:
            mother = body_has_content_sink(a, d.a)
        end
        ex.comp_name.Push(d.name)
        ex.comp_def.Push(did)
        ex.comp_dir.Push(dir)
        ex.comp_mother.Push(mother)
        lg.Log(
            ex.log, lg.PH_DRIVER, lg.LOG_DEBUG, co.Format2(
                "registered component '%s' (%s)", co.ArgStr(d.name), co.ArgStr(mother ? "mother" : "single")
            )
        )
    end
end

func find_layout_block(a &: at.Ast, program: int): int:
    repeat at.ChildCount(a, program) in i:
        did := at.Child(a, program, i)
        if at.KindOf(a, did) == at.AST_LAYOUT_BLOCK and str.Len(at.Get(a, did).name) == 0:
            ret did
        end
    end
    ret 0
end

func has_component_def(a &: at.Ast, program: int): bool:
    repeat at.ChildCount(a, program) in i:
        if at.KindOf(a, at.Child(a, program, i)) == at.AST_LAYOUT_COMPONENT:
            ret true
        end
    end
    ret false
end

func find_loaded(ex &: LoExpand, path: str): int:
    repeat ex.loaded_path.Len() in i:
        if str.Equals(ex.loaded_path.Get(i), path):
            ret i
        end
    end
    ret 0 - 1
end

func load_include(ex &: LoExpand, a &: at.Ast, path: str): int:
    cached := find_loaded(ex, path)
    if cached >= 0:
        if ex.loaded_prog.Get(cached) != 0:
            ret cached
        end
        ret 0 - 1
    end
    li := ex.loaded_path.Len()
    ex.loaded_path.Push(path)
    ex.loaded_prog.Push(0)
    ex.loaded_dir.Push(lo_dir_of(path))
    mut sf := src.New()
    if not src.Load(path, sf):
        lg.Log(
            ex.log, lg.PH_DRIVER, lg.LOG_ERROR, co.Format1(i18.Tr("cannot read included layout '%s'"), co.ArgStr(path))
        )
        ex.errors++
        ret 0 - 1
    end
    mut toks := tok.StreamNew(path)
    _l := lx.Run(ex.log, ex.pack, sf, toks)
    mut prog := 0
    _p := ps.Run(ex.log, toks, a, prog)
    tok.StreamFree(toks)
    if prog != 0:
        _c := cc.PruneProgram(a, ex.log, path, ex.cctab, prog)
    end
    if prog == 0:
        lg.Log(
            ex.log, lg.PH_DRIVER, lg.LOG_ERROR, co.Format1(i18.Tr("cannot parse included layout '%s'"), co.ArgStr(path))
        )
        ex.errors++
        ret 0 - 1
    end
    ex.loaded_prog.Set(li, prog)
    lg.Log(
        ex.log, lg.PH_DRIVER, lg.LOG_INFO, co.Format1("included layout %s", co.ArgStr(path))
    )
    ret li
end

func collect(ex &: LoExpand, a &: at.Ast, program: int, dir: str, depth: int):
    register_components(ex, a, program, dir)
    repeat at.ChildCount(a, program) in i:
        did := at.Child(a, program, i)
        d := at.Get(a, did)
        if d.kind == at.AST_LAYOUT_BLOCK:
            scan_includes(ex, a, did, dir, depth)
        else d.kind == at.AST_LAYOUT_COMPONENT:
            scan_includes(ex, a, d.a, dir, depth)
        end
    end
end

func scan_includes(
    ex &: LoExpand, a &: at.Ast, container: int, dir: str, depth: int
):
    if container == 0 or depth > K_LO_MAX_DEPTH:
        ret
    end
    repeat at.ChildCount(a, container) in i:
        iid := at.Child(a, container, i)
        item := at.Get(a, iid)
        if item.kind == at.AST_LAYOUT_ATTR and is_include_attr(item.name):
            mut spec := ""
            mut has_spec := false
            if item.a != 0:
                av := at.Get(a, item.a)
                if av.kind == at.AST_LITERAL and av.value_kind == tok.TV_STRING:
                    spec = av.value_str
                    has_spec = true
                end
            end
            if not has_spec:
                continue
            end
            path := sm.ResolveImport(dir, spec)
            if find_loaded(ex, path) < 0:
                l := load_include(ex, a, path)
                if l >= 0:
                    collect(
                        ex, a, ex.loaded_prog.Get(l), ex.loaded_dir.Get(l), depth + 1
                    )
                end
            end
        else item.kind == at.AST_LAYOUT_ELEMENT:
            scan_includes(ex, a, iid, dir, depth)
        else item.kind == at.AST_EACH:
            scan_includes(ex, a, item.b, dir, depth)
        else item.kind == at.AST_IF:
            scan_includes(ex, a, item.b, dir, depth)
            mut else_n := item.c
            until else_n == 0:
                if at.KindOf(a, else_n) == at.AST_IF:
                    en := at.Get(a, else_n)
                    scan_includes(ex, a, en.b, dir, depth)
                    else_n = en.c
                else:
                    scan_includes(ex, a, else_n, dir, depth)
                    else_n = 0
                end
            end
        end
    end
end

func comp_param_type(a &: at.Ast, comp_def: int, name: str): int:
    repeat at.ChildCount(a, comp_def) in i:
        pid := at.Child(a, comp_def, i)
        p := at.Get(a, pid)
        if p.kind == at.AST_PARAM and str.Equals(p.name, name):
            ret p.ty
        end
    end
    ret 0
end

func comp_has_param(a &: at.Ast, comp_def: int, name: str): bool:
    repeat at.ChildCount(a, comp_def) in i:
        pid := at.Child(a, comp_def, i)
        p := at.Get(a, pid)
        if p.kind == at.AST_PARAM and str.Equals(p.name, name):
            ret true
        end
    end
    ret false
end

func lit_value_category(a &: at.Ast, nid: int): int:
    if nid == 0:
        ret 0
    end
    n := at.Get(a, nid)
    if n.kind != at.AST_LITERAL:
        ret 0
    end
    if n.op == tok.TK_KW_TRUE or n.op == tok.TK_KW_FALSE:
        ret 1
    end
    if n.value_kind == tok.TV_STRING:
        ret 2
    end
    if n.op == tok.TK_INT or n.value_kind == tok.TV_INT:
        ret 3
    end
    if n.op == tok.TK_FLOAT or n.value_kind == tok.TV_FLOAT:
        ret 4
    end
    ret 0
end

func lit_category_name(cat: int): str:
    if cat == 1:
        ret "a bool"
    end
    if cat == 2:
        ret "a string"
    end
    if cat == 3:
        ret "an integer"
    end
    if cat == 4:
        ret "a float"
    end
    ret "a value"
end

func check_component_arg_type(
    ex &: LoExpand, a &: at.Ast, comp_def: int, comp_name: str, param_name: str, value: int
):
    ty := comp_param_type(a, comp_def, param_name)
    if ty == 0:
        ret
    end
    tn := at.Get(a, ty)
    kind := sm.TypePrimKindFromName(tn.name, "")
    if kind < 0:
        ret
    end
    cat := lit_value_category(a, value)
    if cat == 0:
        ret
    end
    mut ok := true
    if kind == sm.TY_BOOL:
        ok = cat == 1
    else kind == sm.TY_STR:
        ok = cat == 2
    else (kind >= sm.TY_I8 and kind <= sm.TY_USIZE) or kind == sm.TY_SIZE:
        ok = cat == 3
    else kind == sm.TY_F32 or kind == sm.TY_F64:
        ok = cat == 3 or cat == 4
    else:
        ret
    end
    if not ok:
        lg.Log(
            ex.log, lg.PH_DRIVER, lg.LOG_ERROR, co.Format4(
                i18.Tr("component '%s' parameter '%s' expects '%s', got %s"), co.ArgStr(comp_name),
                co.ArgStr(param_name), co.ArgStr(tn.name), co.ArgStr(lit_category_name(cat))
            )
        )
        ex.errors++
    end
end

func expand_component(
    ex &: LoExpand, a &: at.Ast, out &: Vector<int>, invocation: int, ci: int, caller &: LoFrame,
    dir: str, depth: int
):
    comp_name := ex.comp_name.Get(ci)
    if depth > K_LO_MAX_DEPTH:
        lg.Log(
            ex.log, lg.PH_DRIVER, lg.LOG_ERROR, co.Format1(
                i18.Tr("component '%s' nested too deeply (cyclic invocation?)"), co.ArgStr(comp_name)
            )
        )
        ex.errors++
        ret
    end
    mut fr := LoFrame { present = true }
    defer frame_free(fr)
    comp_def := ex.comp_def.Get(ci)

    repeat at.ChildCount(a, comp_def) in i:
        pid := at.Child(a, comp_def, i)
        p := at.Get(a, pid)
        if p.kind == at.AST_PARAM:
            frame_set(fr, p.name, p.a)
        end
    end

    mut got_content := false
    mut got_content_attr := false
    mut got_content_children := false
    mut got_named_children := false
    mut ev_names := Vector {} as Vector<str>
    defer ev_names.Free()
    mut ev_fns := Vector {} as Vector<int>
    defer ev_fns.Free()
    mut bound_params := Vector {} as Vector<str>
    defer bound_params.Free()
    mut named_seen := Vector {} as Vector<str>
    defer named_seen.Free()
    repeat at.ChildCount(a, invocation) in i2:
        aid := at.Child(a, invocation, i2)
        an := at.Get(a, aid)
        if an.kind == at.AST_LAYOUT_ATTR:
            if lo_bub_is_handler(an.name):
                ev := lo_bub_event(an.name)
                mut dup_ev := false
                repeat ev_names.Len() in ei:
                    if lp.IdentEqual(ev_names.Get(ei), ev):
                        dup_ev = true
                    end
                end
                if dup_ev:
                    lg.Log(
                        ex.log, lg.PH_DRIVER, lg.LOG_ERROR, co.Format2(
                            i18.Tr("component '%s' receives handler '%s' more than once"), co.ArgStr(comp_name),
                            co.ArgStr(an.name)
                        )
                    )
                    ex.errors++
                else:
                    ev_names.Push(ev)
                    ev_fns.Push(lo_bub_value(ex, a, subst_value(a, an.a, caller)))
                end
            else is_content_word(an.name):
                // Treat content/children attrs as default slot content.
                // Named slot routing via attrs is not supported; slot providers use element form.
                slot_name := ""
                if str.Equals(an.name, "slot") or str.Equals(an.name, "جایگاه"):
                    slot_name = slot_attr_name(a, aid)
                    if not is_default_slot_name(slot_name) and str.Len(slot_name) > 0:
                        lg.Log(
                            ex.log, lg.PH_DRIVER, lg.LOG_ERROR, co.Format2(
                                i18.Tr("component '%s': named slot '%s' must be provided as a slot element, not as an attribute"),
                                co.ArgStr(comp_name), co.ArgStr(slot_name)
                            )
                        )
                        ex.errors++
                        continue
                    end
                end
                if is_default_slot_name(slot_name):
                    if got_content_attr:
                        lg.Log(
                            ex.log, lg.PH_DRIVER, lg.LOG_ERROR, co.Format1(
                                i18.Tr("component '%s' receives content twice; use either the content attribute or content children, not both"),
                                co.ArgStr(comp_name)
                            )
                        )
                        ex.errors++
                    else:
                        txt := at.NewNode(a, at.AST_LAYOUT_ATTR)
                        copy_span(a, txt, aid)
                        at.SetName(a, txt, "content")
                        sub := subst_value(a, an.a, caller)
                        mut tn := at.Get(a, txt)
                        tn.a = sub
                        at.Put(a, txt, tn)
                        fr.content.Push(txt)
                        got_content = true
                        got_content_attr = true
                    end
                end
            else:
                mut dup_param := false
                repeat bound_params.Len() in bi:
                    if str.Equals(bound_params.Get(bi), an.name):
                        dup_param = true
                    end
                end
                if dup_param:
                    lg.Log(
                        ex.log, lg.PH_DRIVER, lg.LOG_ERROR, co.Format2(
                            i18.Tr("component '%s' parameter '%s' is provided more than once"), co.ArgStr(comp_name),
                            co.ArgStr(an.name)
                        )
                    )
                    ex.errors++
                else:
                    bound_params.Push(an.name)
                    sub_val := lo_bub_value(ex, a, subst_value(a, an.a, caller))
                    if not comp_has_param(a, comp_def, an.name):
                        lg.Log(
                            ex.log, lg.PH_DRIVER, lg.LOG_ERROR, co.Format2(
                                i18.Tr("component '%s' has no parameter '%s'"), co.ArgStr(comp_name),
                                co.ArgStr(an.name)
                            )
                        )
                        ex.errors++
                    else:
                        check_component_arg_type(ex, a, comp_def, comp_name, an.name, sub_val)
                        frame_set(fr, an.name, sub_val)
                    end
                end
            end
        else an.kind == at.AST_LAYOUT_ELEMENT:
            pk := slot_provider_kind(a, aid)
            if pk == 1:
                // Default slot provider wrapper: contributes to default/content slot.
                mut has_scoped_meta := false
                repeat at.ChildCount(a, aid) in sai:
                    sac := at.Get(a, at.Child(a, aid, sai))
                    if sac.kind == at.AST_LAYOUT_ATTR and not str.Equals(sac.name, "slot") and not str.Equals(sac.name, "جایگاه") and not str.Equals(sac.name, "name") and not str.Equals(sac.name, "نام"):
                        has_scoped_meta = true
                    end
                end
                if has_scoped_meta:
                    lg.Log(
                        ex.log, lg.PH_DRIVER, lg.LOG_WARN, co.Format1(
                            i18.Tr("component '%s': default slot provider has extra attributes treated as scoped slot parameter/binding metadata; full semantics require runtime/toolchain validation"),
                            co.ArgStr(comp_name)
                        )
                    )
                end
                before := fr.content.Len()
                expand_items(ex, a, fr.content, aid, caller, dir, depth)
                if fr.content.Len() > before:
                    got_content = true
                    got_content_children = true
                else:
                    // Explicit empty provider still marks default slot as provided.
                    frame_mark_slot(fr, "default")
                    got_content = true
                    got_content_children = true
                end
            else pk == 2:
                sname := slot_attr_name(a, aid)
                mut dup_named := false
                repeat named_seen.Len() in ni:
                    if str.Equals(named_seen.Get(ni), sname):
                        dup_named = true
                    end
                end
                if dup_named:
                    lg.Log(
                        ex.log, lg.PH_DRIVER, lg.LOG_ERROR, co.Format2(
                            i18.Tr("component '%s' receives named slot '%s' more than once"), co.ArgStr(comp_name),
                            co.ArgStr(sname)
                        )
                    )
                    ex.errors++
                    continue
                end
                mut has_scoped_meta2 := false
                repeat at.ChildCount(a, aid) in sai2:
                    sac2 := at.Get(a, at.Child(a, aid, sai2))
                    if sac2.kind == at.AST_LAYOUT_ATTR and not str.Equals(sac2.name, "slot") and not str.Equals(sac2.name, "جایگاه") and not str.Equals(sac2.name, "name") and not str.Equals(sac2.name, "نام"):
                        has_scoped_meta2 = true
                    end
                end
                if has_scoped_meta2:
                    lg.Log(
                        ex.log, lg.PH_DRIVER, lg.LOG_WARN, co.Format2(
                            i18.Tr("component '%s': named slot provider '%s' has extra attributes treated as scoped slot parameter/binding metadata; full semantics require runtime/toolchain validation"),
                            co.ArgStr(comp_name), co.ArgStr(sname)
                        )
                    )
                end
                named_seen.Push(sname)
                mut svec := Vector {} as Vector<int>
                expand_items(ex, a, svec, aid, caller, dir, depth)
                i := frame_ensure_slot(fr, sname)
                if svec.Len() > 0:
                    mut cur := fr.slot_nodes.Get(i)
                    repeat svec.Len() in si:
                        cur.Push(svec.Get(si))
                    end
                    fr.slot_nodes.Set(i, cur)
                    fr.slot_provided.Set(i, true)
                    got_content = true
                    got_named_children = true
                else:
                    // Explicit named provider with empty/fallback-only content marks slot provided.
                    // TODO(runtime): scoped slot params/bindings on provider wrappers need toolchain validation.
                    fr.slot_provided.Set(i, true)
                    got_content = true
                    got_named_children = true
                end
                svec.Free()
            else:
                // Only explicit `slot`/`جایگاه` attrs route regular elements to named slots.
                // `name`/`نام` on non-placeholder elements is preserved as a normal HTML attr.
                routed_name := ""
                mut routed_dynamic := false
                repeat at.ChildCount(a, aid) in ri:
                    rcid := at.Child(a, aid, ri)
                    rc := at.Get(a, rcid)
                    if rc.kind == at.AST_LAYOUT_ATTR and (str.Equals(rc.name, "slot") or str.Equals(rc.name, "جایگاه")):
                        t := node_text(a, rc.a)
                        if str.Len(t) > 0:
                            routed_name = t
                        else:
                            routed_dynamic = true
                        end
                    end
                end
                if routed_dynamic and str.Len(routed_name) == 0:
                    lg.Log(
                        ex.log, lg.PH_DRIVER, lg.LOG_ERROR, co.Format1(
                            i18.Tr("component '%s': slot routing attribute must be a fixed text value"),
                            co.ArgStr(comp_name)
                        )
                    )
                    ex.errors++
                    continue
                end
                if not is_default_slot_name(routed_name) and (str.Len(routed_name) > 0):
                    // Child explicitly targets a named slot via slot attr.
                    // Multiple children may contribute to the same named slot.
                    mut tmp := Vector {} as Vector<int>
                    mut cvec2 := Vector {} as Vector<int>
                    stripped := slot_strip_routing_attrs(a, aid)
                    expand_item(ex, a, cvec2, stripped, caller, dir, depth)
                    repeat cvec2.Len() in ti:
                        tmp.Push(cvec2.Get(ti))
                    end
                    cvec2.Free()
                    i2s := frame_ensure_slot(fr, routed_name)
                    mut cur2 := fr.slot_nodes.Get(i2s)
                    repeat tmp.Len() in ti2:
                        cur2.Push(tmp.Get(ti2))
                    end
                    fr.slot_nodes.Set(i2s, cur2)
                    fr.slot_provided.Set(i2s, true)
                    got_content = true
                    got_named_children = true
                    tmp.Free()
                else:
                    before := fr.content.Len()
                    mut cvec := fr.content
                    expand_item(ex, a, cvec, aid, caller, dir, depth)
                    fr.content = cvec
                    if fr.content.Len() > before:
                        got_content = true
                        got_content_children = true
                    end
                end
            end
        else an.kind == at.AST_IF or an.kind == at.AST_EACH:
            before2 := fr.content.Len()
            expand_item(ex, a, fr.content, aid, caller, dir, depth)
            if fr.content.Len() > before2:
                got_content = true
                got_content_children = true
            end
        end
    end
    // Default content precedence: attribute and child/default providers cannot both supply content.
    // Named slots are independent and may coexist with default content.
    if got_content_attr and got_content_children:
        lg.Log(
            ex.log, lg.PH_DRIVER, lg.LOG_ERROR, co.Format1(
                i18.Tr("component '%s' receives content twice; use either the content attribute or content children, not both"),
                co.ArgStr(comp_name)
            )
        )
        ex.errors++
    end
    _gnc := got_named_children
    repeat at.ChildCount(a, comp_def) in pi:
        pid := at.Child(a, comp_def, pi)
        p := at.Get(a, pid)
        if p.kind != at.AST_PARAM or is_content_word(p.name):
            continue
        end
        if p.a != 0:
            continue
        end
        mut provided := false
        repeat bound_params.Len() in bi2:
            if str.Equals(bound_params.Get(bi2), p.name):
                provided = true
            end
        end
        if not provided:
            lg.Log(
                ex.log, lg.PH_DRIVER, lg.LOG_ERROR, co.Format2(
                    i18.Tr("component '%s' is missing required parameter '%s'"), co.ArgStr(comp_name),
                    co.ArgStr(p.name)
                )
            )
            ex.errors++
        end
    end
    ev_mark := lo_bub_mark()
    defer lo_bub_pop(ev_mark)
    repeat ev_names.Len() in evi:
        lo_bub_push(ev_names.Get(evi), ev_fns.Get(evi))
    end
    if not ex.comp_mother.Get(ci) and frame_has_any_content(fr):
        lg.Log(
            ex.log, lg.PH_DRIVER, lg.LOG_ERROR, co.Format1(
                i18.Tr("component '%s' does not accept content (it has no `content:` placeholder)"),
                co.ArgStr(comp_name)
            )
        )
        ex.errors++
    end
    body := at.Get(a, comp_def).a
    web := g_lo_web_state and not g_lo_native_scopes
    if not g_lo_native_scopes and not web:
        if li_has_storage(a, body):
            lg.Log(
                ex.log, lg.PH_DRIVER, lg.LOG_ERROR, co.Format1(
                    i18.Tr("component '%s' has variables that change, which work only in pages built with 'salam page build' or --ui=native; keep the value in a mutable global instead"),
                    co.ArgStr(comp_name)
                )
            )
            ex.errors++
        end
        frame_derive(a, fr, body)
        expand_items(ex, a, out, body, fr, ex.comp_dir.Get(ci), depth + 1)
        ret
    end
    if web and not li_has_storage(a, body):
        frame_derive(a, fr, body)
        expand_items(ex, a, out, body, fr, ex.comp_dir.Get(ci), depth + 1)
        ret
    end
    wi := g_lo_wi_mark.Len()
    multi := web and g_lo_each_depth > 0
    if web:
        g_lo_wi_mark.Push(0)
        g_lo_wi_kind.Push(multi ? WS_MULTI : WS_SINGLE)
    end
    mark := at.NewNode(a, at.AST_IF)
    copy_span(a, mark, invocation)
    blk := at.NewNode(a, at.AST_BLOCK)
    copy_span(a, blk, invocation)
    mut kids := Vector {} as Vector<int>
    mut sj := 0
    repeat at.ChildCount(a, body) in bi:
        sid := at.Child(a, body, bi)
        if at.KindOf(a, sid) != at.AST_VAR_DECL:
            continue
        end
        sd := at.Get(a, sid)
        kind := li_kind(sid)
        if kind == LI_DERIVED:
            frame_set(fr, sd.name, subst_value(a, sd.a, fr))
            fr.derived.Push(sd.name)
            continue
        end
        mut gi := 0
        if web:
            gi = lo_web_state_index(ex, a, ci, sid)
            g_lo_ws_kind.Push(kind)
        else:
            gi = lo_state_index(ex, a, ci, sj, sid, kind)
        end
        sj++
        decl := at.NewNode(a, at.AST_VAR_DECL)
        copy_span(a, decl, sid)
        init := subst_value(a, sd.a, fr)
        mut dn := at.Get(a, decl)
        dn.name = sd.name
        dn.a = init
        dn.value_int = gi as u64
        dn.synthetic = true
        at.Put(a, decl, dn)
        kids.Push(decl)
        if web:
            g_lo_ws_decl.Push(decl)
            if multi:
                frame_set(fr, sd.name, ws_cur_ref(a, gi, wi, sid))
            else:
                frame_set(fr, sd.name, lo_ident(a, "__salam_ws_" + co.U64Toa(gi as u64), sid))
            end
        else:
            frame_set(fr, sd.name, lo_state_ref(a, gi, ci, sid))
        end
    end
    expand_items(ex, a, kids, body, fr, ex.comp_dir.Get(ci), depth + 1)
    mut bn := at.Get(a, blk)
    mut oldl := bn.list
    bn.list = kids
    at.Put(a, blk, bn)
    oldl.Free()
    mut mn := at.Get(a, mark)
    mn.name = "__salam_component"
    mn.synthetic = true
    mn.value_int = ci as u64
    mn.a = mk_str(a, multi ? lo_mark("wsin", wi) : "", invocation)
    mn.b = blk
    at.Put(a, mark, mn)
    if web:
        g_lo_wi_mark.Set(wi, mark)
    end
    out.Push(mark)
end

func lo_has_decls(a &: at.Ast, body: int): bool:
    if body == 0:
        ret false
    end
    repeat at.ChildCount(a, body) in i:
        if at.KindOf(a, at.Child(a, body, i)) == at.AST_VAR_DECL:
            ret true
        end
    end
    ret false
end

func lo_is_state_ref(a &: at.Ast, nid: int): bool:
    n := at.Get(a, nid)
    if n.kind == at.AST_IDENTIFIER:
        ret str.StartsWith(n.name, "__salam_ws_")
    end
    ret n.kind == at.AST_INDEX and n.synthetic
end

func lo_web_state_index(ex &: LoExpand, a &: at.Ast, ci: int, sid: int): int:
    sd := at.Get(a, sid)
    mut lit := ""
    ty := lo_state_type(a, ex.comp_def.Get(ci), sd.a, lit)
    if ty == 0 and str.Len(lit) == 0:
        lg.Log(
            ex.log, lg.PH_DRIVER, lg.LOG_ERROR, co.Format2(
                i18.Tr("component '%s': give the variable '%s' a type, as in 'items := Vector {} as Vector<str>'"),
                co.ArgStr(ex.comp_name.Get(ci)), co.ArgStr(sd.name)
            )
        )
        ex.errors++
        lit = "int"
    end
    g_lo_ws_inst.Push(g_lo_wi_mark.Len() - 1)
    g_lo_ws_type.Push(ty)
    g_lo_ws_lit.Push(lit)
    ret g_lo_ws_inst.Len() - 1
end

func lo_ident(a &: at.Ast, name: str, from: int): int:
    id := at.NewNode(a, at.AST_IDENTIFIER)
    copy_span(a, id, from)
    at.SetName(a, id, name)
    ret id
end

func lo_state_ref(a &: at.Ast, gi: int, ci: int, from: int): int:
    ix := at.NewNode(a, at.AST_INDEX)
    copy_span(a, ix, from)
    mut n := at.Get(a, ix)
    n.a = lo_ident(a, "__salam_st_" + co.U64Toa(gi as u64), from)
    n.b = lo_ident(a, "__salam_k_" + co.U64Toa(ci as u64), from)
    n.synthetic = true
    at.Put(a, ix, n)
    ret ix
end

func lo_state_type(a &: at.Ast, comp_def: int, init: int, lit &: str): int:
    lit = ""
    if init == 0:
        ret 0
    end
    v := at.Get(a, init)
    if v.kind == at.AST_LITERAL:
        if v.value_kind == tok.TV_INT:
            lit = "int"
        else v.value_kind == tok.TV_FLOAT:
            lit = "f64"
        else v.value_kind == tok.TV_STRING:
            lit = "str"
        else v.value_kind == tok.TV_BOOL:
            lit = "bool"
        end
        ret 0
    end
    if v.kind == at.AST_UNARY and v.a != 0 and at.KindOf(a, v.a) == at.AST_LITERAL:
        ret lo_state_type(a, comp_def, v.a, lit)
    end
    if v.kind == at.AST_CAST and v.ty != 0:
        ret v.ty
    end
    if v.kind == at.AST_IDENTIFIER:
        ret comp_param_type(a, comp_def, v.name)
    end
    ret 0
end

func lo_state_index(ex &: LoExpand, a &: at.Ast, ci: int, j: int, sid: int, kind: int): int:
    mut seen := 0
    repeat g_lo_st_comp.Len() in i:
        if g_lo_st_comp.Get(i) == ci:
            if seen == j:
                ret i
            end
            seen++
        end
    end
    sd := at.Get(a, sid)
    mut lit := ""
    ty := lo_state_type(a, ex.comp_def.Get(ci), sd.a, lit)
    if ty == 0 and str.Len(lit) == 0:
        lg.Log(
            ex.log, lg.PH_DRIVER, lg.LOG_ERROR, co.Format2(
                i18.Tr("component '%s': give the variable '%s' a type, as in 'items := Vector {} as Vector<str>'"),
                co.ArgStr(ex.comp_name.Get(ci)), co.ArgStr(sd.name)
            )
        )
        ex.errors++
        lit = "int"
    end
    g_lo_st_comp.Push(ci)
    g_lo_st_kind.Push(kind)
    g_lo_st_name.Push(sd.name)
    g_lo_st_type.Push(ty)
    g_lo_st_lit.Push(lit)
    ret g_lo_st_comp.Len() - 1
end

func expand_item(
    ex &: LoExpand, a &: at.Ast, out &: Vector<int>, iid: int, fr &: LoFrame, dir: str, depth: int
):
    item := at.Get(a, iid)
    if item.kind == at.AST_LAYOUT_ATTR:
        if is_include_attr(item.name):
            vid := subst_value(a, item.a, fr)
            mut spec := ""
            mut has_spec := false
            if vid != 0:
                v := at.Get(a, vid)
                if v.kind == at.AST_LITERAL and v.value_kind == tok.TV_STRING:
                    spec = v.value_str
                    has_spec = true
                end
            end
            if not has_spec:
                lg.Log(
                    ex.log, lg.PH_DRIVER, lg.LOG_ERROR, i18.Tr("include path must be a string")
                )
                ex.errors++
                ret
            end
            path := sm.ResolveImport(dir, spec)
            mut l := find_loaded(ex, path)
            if l < 0:
                l = load_include(ex, a, path)
            end
            if l >= 0 and ex.loaded_prog.Get(l) != 0:
                lprog := ex.loaded_prog.Get(l)
                lb := find_layout_block(a, lprog)
                if lb != 0:
                    mut none := LoFrame {}
                    expand_items(
                        ex, a, out, lb, none, ex.loaded_dir.Get(l), depth + 1
                    )
                    frame_free(none)
                else not has_component_def(a, lprog):
                    lg.Log(
                        ex.log, lg.PH_DRIVER, lg.LOG_WARN, co.Format1(
                            i18.Tr("included file '%s' has no layout block"), co.ArgStr(path)
                        )
                    )
                end
            end
            ret
        end

        if lo_bub_is_handler(item.name):
            if not lo_bub_is_page_attr(iid):
                lg.Log(
                    ex.log, lg.PH_DRIVER, lg.LOG_ERROR, co.Format1(
                        i18.Tr("'%s' handles an event that a component sends; write it where the component is used, or at the top of the page block"),
                        co.ArgStr(item.name)
                    )
                )
                ex.errors++
            end
            ret
        end
        attr := at.Clone(a, iid)
        sub := lo_bub_value(ex, a, subst_value(a, item.a, fr))
        mut an := at.Get(a, attr)
        an.a = sub
        at.Put(a, attr, an)
        out.Push(attr)
        ret
    end
    if item.kind == at.AST_LAYOUT_ELEMENT:
        ci := find_comp(ex, item.name)
        if ci >= 0:
            expand_component(ex, a, out, iid, ci, fr, dir, depth)
            ret
        end

        if fr.present and not fr.page and is_slot_placeholder_name(item.name):
            sname := slot_attr_name(a, iid)
            if is_default_slot_name(sname):
                // Default slot precedence: explicit default slot provider/content first,
                // otherwise fallback to unnamed/default-routed children collected in content.
                mut tmpd := Vector {} as Vector<int>
                if frame_slot_items(fr, "", tmpd) or frame_slot_items(fr, "default", tmpd) or frame_slot_items(fr, "content", tmpd) or frame_slot_items(fr, "children", tmpd) or frame_slot_items(fr, "محتوا", tmpd):
                    repeat tmpd.Len() in ti:
                        out.Push(at.Clone(a, tmpd.Get(ti)))
                    end
                    tmpd.Free()
                    ret
                end
                tmpd.Free()
                if fr.content.Len() > 0:
                    repeat fr.content.Len() in i:
                        out.Push(at.Clone(a, fr.content.Get(i)))
                    end
                    ret
                end
            else:
                mut named := Vector {} as Vector<int>
                if frame_slot_items(fr, sname, named):
                    repeat named.Len() in ni:
                        out.Push(at.Clone(a, named.Get(ni)))
                    end
                    named.Free()
                    ret
                end
                named.Free()
                // Named slot not provided: render fallback content of the placeholder, if any.
            end
            // Fallback/default placeholder content: expand children but do not emit routing attrs.
            // Scoped slot parameter bindings on placeholders/providers are not representable in generated output yet.
            // TODO(runtime): capture and forward scoped slot bindings/params once toolchain/runtime contracts exist.
            mut fb := Vector {} as Vector<int>
            expand_items(ex, a, fb, iid, fr, dir, depth)
            repeat fb.Len() in fi:
                out.Push(fb.Get(fi))
            end
            fb.Free()
            ret
        end

        el := at.NewNode(a, at.AST_LAYOUT_ELEMENT)
        copy_span(a, el, iid)
        at.SetName(a, el, item.name)
        repeat at.Aliases(a, item.ext).Len() in i2:
            at.AddAlias(a, el, at.Aliases(a, item.ext).Get(i2))
        end
        mut kids := Vector {} as Vector<int>
        expand_items(ex, a, kids, iid, fr, dir, depth)
        mut en := at.Get(a, el)
        mut old := en.list
        en.list = kids
        at.Put(a, el, en)
        old.Free()
        out.Push(el)
        ret
    end
    if item.kind == at.AST_IF:
        out.Push(expand_if(ex, a, iid, fr, dir, depth))
        ret
    end
    if item.kind == at.AST_VAR_DECL:
        if not li_known(iid):
            lg.Log(
                ex.log, lg.PH_DRIVER, lg.LOG_ERROR, co.Format1(
                    i18.Tr("'%s' is declared inside an element, 'if' or 'each'; declare it at the top of the component or the page block"),
                    co.ArgStr(item.name)
                )
            )
            ex.errors++
        end
        ret
    end
    if item.kind == at.AST_EACH:
        cp := at.NewNode(a, at.AST_EACH)
        copy_span(a, cp, iid)
        mut cn := at.Get(a, cp)
        cn.name = item.name
        cn.c = item.c
        cn.a = subst_value(a, item.a, fr)
        mark := fr.shadow.Len()
        if str.Len(item.name) > 0:
            fr.shadow.Push(item.name)
        end
        if item.c != 0 and at.KindOf(a, item.c) == at.AST_IDENTIFIER:
            fr.shadow.Push(at.Get(a, item.c).name)
        end
        g_lo_each_depth++
        cn.b = expand_container(ex, a, item.b, fr, dir, depth)
        g_lo_each_depth--
        until fr.shadow.Len() > mark:
            _sh := fr.shadow.Pop()
        end
        at.Put(a, cp, cn)
        out.Push(cp)
        ret
    end

    out.Push(iid)
end

func expand_container(ex &: LoExpand, a &: at.Ast, cid: int, fr &: LoFrame, dir: str, depth: int): int:
    blk := at.NewNode(a, at.AST_BLOCK)
    copy_span(a, blk, cid)
    mut kids := Vector {} as Vector<int>
    expand_items(ex, a, kids, cid, fr, dir, depth)
    mut bn := at.Get(a, blk)
    mut old := bn.list
    bn.list = kids
    at.Put(a, blk, bn)
    old.Free()
    ret blk
end

func expand_if(ex &: LoExpand, a &: at.Ast, iid: int, fr &: LoFrame, dir: str, depth: int): int:
    item := at.Get(a, iid)
    cp := at.NewNode(a, at.AST_IF)
    copy_span(a, cp, iid)
    cond := subst_value(a, item.a, fr)
    then_b := expand_container(ex, a, item.b, fr, dir, depth)
    mut else_b := 0
    if item.c != 0:
        if at.KindOf(a, item.c) == at.AST_IF:
            else_b = expand_if(ex, a, item.c, fr, dir, depth)
        else:
            else_b = expand_container(ex, a, item.c, fr, dir, depth)
        end
    end
    mut cn := at.Get(a, cp)
    cn.a = cond
    cn.b = then_b
    cn.c = else_b
    at.Put(a, cp, cn)
    ret cp
end

func expand_items(
    ex &: LoExpand, a &: at.Ast, out &: Vector<int>, container: int, fr &: LoFrame, dir: str, depth: int
):
    if depth > K_LO_MAX_DEPTH:
        lg.Log(
            ex.log, lg.PH_DRIVER, lg.LOG_ERROR, i18.Tr("layout include/component nesting too deep")
        )
        ex.errors++
        ret
    end
    repeat at.ChildCount(a, container) in i:
        expand_item(ex, a, out, at.Child(a, container, i), fr, dir, depth)
    end
end
