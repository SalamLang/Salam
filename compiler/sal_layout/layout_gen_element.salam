package layout

import str
import co "../sal_core.salam"
import tok "../token.salam"
import lg "../logger.salam"
import dg "../diag.salam"
import i18 "../i18n.salam"
import at "../ast.salam"
import sm "../semantic/semantic.salam"
import mn "../minify.salam"

// ===========================================================================
// ===== layout_gen_element.c =====
// ===========================================================================

// repeat_count
func repeat_count(a &: at.Ast, el: int): i64:
    repeat at.ChildCount(a, el) with i:
        aid := at.Child(a, el, i)
        an := at.Get(a, aid)
        if an.kind == at.AST_LAYOUT_ATTR && str.Equals(an.name, "repeat") && an.a != 0:
            av := at.Get(a, an.a)
            if av.kind == at.AST_LITERAL && av.value_kind == tok.TV_INT:
                r := av.value_int as i64
                ret r < 1 ? 1 as i64 : r
            end
        end
    end
    ret 1
end

// gen_children
func gen_children(
    cx &: LoCtx, diag &: dg.Engine, a &: at.Ast, el: int, klass: str, has_klass: bool
):
    parent := at.Get(a, el).name
    repeat at.ChildCount(a, el) with i:
        cid := at.Child(a, el, i)
        if at.KindOf(a, cid) == at.AST_LAYOUT_ELEMENT:
            gen_element_n(cx, diag, a, cid, parent, klass, has_klass)
        end
    end
end

// has_child_elements
func has_child_elements(a &: at.Ast, el: int): bool:
    repeat at.ChildCount(a, el) with i:
        if at.KindOf(a, at.Child(a, el, i)) == at.AST_LAYOUT_ELEMENT:
            ret true
        end
    end
    ret false
end

// quote_css_value_if_needed
func quote_css_value_if_needed(value: str): str:
    if str.IndexOf(value, " ") < 0:
        ret value
    end
    n := str.Len(value)
    repeat n with i:
        b := byte_at(value, i)
        if b >= 48 && b <= 57:
            ret value
        end
    end
    ret `"` + value + `"`
end

// gen_element_n - repeat-aware element emitter (layout_internal.h export).
func gen_element_n(
    cx &: LoCtx, diag &: dg.Engine, a &: at.Ast, el: int, parent: str, parent_class: str, parent_has_class: bool
):
    nrep := repeat_count(a, el)
    mut i := 0 as i64
    until i < nrep:
        gen_element(cx, diag, a, el, parent, parent_class, parent_has_class)
        i += 1 as i64
    end
end

// gen_element
func gen_element(
    cx &: LoCtx, diag &: dg.Engine, a &: at.Ast, el: int, _parent: str, parent_class: str, parent_has_class: bool
):
    name := at.Get(a, el).name
    di := sm.LayoutElemLookup(name)
    if di < 0:
        dg.Report(
            diag, dg.SEV_WARNING, 2, cx.file, span_of(a, el), co.Format1(
                i18.Tr("unrecognized layout element '%s' (rendered as <div>)"), co.ArgStr(name)
            )
        )
    end
    mut ltype := K_LO_LE_MOTHER
    if di >= 0:
        ltype = sm.LayoutElemKind(di)
    end
    mut tag := "div"
    if di >= 0 && str.Len(sm.LayoutElemTag(di)) > 0:
        tag = sm.LayoutElemTag(di)
    end

    if str.Equals(name, "heading"):
        mut sz := 1 as i64
        repeat at.ChildCount(a, el) with hi:
            aid := at.Child(a, el, hi)
            an := at.Get(a, aid)
            if an.kind == at.AST_LAYOUT_ATTR && str.Equals(an.name, "size") && an.a != 0:
                av := at.Get(a, an.a)
                if av.kind == at.AST_LITERAL && av.value_kind == tok.TV_INT:
                    sz = av.value_int as i64
                end
            end
        end
        if sz < 1:
            sz = 1
        end
        if sz > 6:
            sz = 6
        end
        tag = "h" + co.U64Toa(sz as u64)
    end
    lg.Log(
        cx.log, lg.PH_CODEGEN, lg.LOG_TRACE, co.Format2("layout <%s> -> <%s>", co.ArgStr(name), co.ArgStr(tag))
    )
    if str.Equals(name, "meta"):
        mut nmattr := ""
        mut has_nm := false
        mut prop := ""
        mut has_prop := false
        mut cont := ""
        mut has_cont := false
        mut charset := ""
        mut has_charset := false
        mut http_equiv := ""
        mut has_he := false
        repeat at.ChildCount(a, el) with mi:
            aid := at.Child(a, el, mi)
            an := at.Get(a, aid)
            if an.kind != at.AST_LAYOUT_ATTR:
                continue
            end
            v := val_str(a, an.a)
            if str.Equals(an.name, "name"):
                nmattr = v
                has_nm = true
            else str.Equals(an.name, "property"):
                prop = v
                has_prop = true
            else str.Equals(an.name, "content"):
                cont = v
                has_cont = true
            else str.Equals(an.name, "charset"):
                charset = v
                has_charset = true
            else str.Equals(an.name, "http_equiv"):
                http_equiv = v
                has_he = true
            end
        end
        cx.head += cx.compact ? "<meta" : "  <meta"
        if has_charset:
            cx.head += ` charset="` + html_escape(charset) + `"`
        end
        if has_nm:
            cx.head += ` name="` + html_escape(nmattr) + `"`
        end
        if has_prop:
            cx.head += ` property="` + html_escape(prop) + `"`
        end
        if has_he:
            cx.head += ` http-equiv="` + html_escape(http_equiv) + `"`
        end
        if has_cont:
            cx.head += ` content="` + html_escape(cont) + `"`
        end
        cx.head += cx.compact ? ">" : ">\n"
        ret
    end
    if str.Equals(name, "head_link"):
        mut rel := ""
        mut has_rel := false
        mut href := ""
        mut has_href := false
        mut type_ := ""
        mut has_type_ := false
        mut cross := ""
        mut has_cross := false
        mut sizes := ""
        mut has_sizes := false
        mut as_ := ""
        mut has_as := false
        mut media_ := ""
        mut has_media := false
        repeat at.ChildCount(a, el) with li:
            aid := at.Child(a, el, li)
            an := at.Get(a, aid)
            if an.kind != at.AST_LAYOUT_ATTR:
                continue
            end
            v := val_str(a, an.a)
            if str.Equals(an.name, "rel"):
                rel = v
                has_rel = true
            else str.Equals(an.name, "href"):
                href = v
                has_href = true
            else str.Equals(an.name, "type"):
                type_ = v
                has_type_ = true
            else str.Equals(an.name, "crossorigin"):
                cross = v
                has_cross = true
            else str.Equals(an.name, "sizes"):
                sizes = v
                has_sizes = true
            else str.Equals(an.name, "as"):
                as_ = v
                has_as = true
            else str.Equals(an.name, "media"):
                media_ = v
                has_media = true
            end
        end
        cx.head += cx.compact ? "<link" : "  <link"
        if has_rel:
            cx.head += ` rel="` + html_escape(rel) + `"`
        end
        if has_href:
            cx.head += ` href="` + html_escape(href) + `"`
        end
        if has_type_:
            cx.head += ` type="` + html_escape(type_) + `"`
        end
        if has_as:
            cx.head += ` as="` + html_escape(as_) + `"`
        end
        if has_sizes:
            cx.head += ` sizes="` + html_escape(sizes) + `"`
        end
        if has_media:
            cx.head += ` media="` + html_escape(media_) + `"`
        end
        if has_cross:
            cx.head += ` crossorigin="` + html_escape(cross) + `"`
        end
        cx.head += cx.compact ? ">" : ">\n"
        ret
    end
    mut attrs := ""
    mut css := ""
    mut hover := ""
    mut focus := ""
    mut active := ""
    mut before := ""
    mut after := ""
    mut content := ""
    mut has_content := false
    mut userclass := ""
    mut has_userclass := false
    mut source := ""
    mut has_source := false
    mut srcv := ""
    mut has_src := false
    mut type_val := ""
    mut has_type := false
    mut condition := ""
    mut has_condition := false
    mut selector := ""
    mut has_selector := false
    repeat at.ChildCount(a, el) with ai0:
        aid := at.Child(a, el, ai0)
        an := at.Get(a, aid)
        if an.kind != at.AST_LAYOUT_ATTR:
            continue
        end
        nm := an.name
        v := val_str(a, an.a)
        if str.Equals(nm, "condition"):
            condition = v
            has_condition = true
            continue
        end
        if str.Equals(nm, "selector"):
            selector = v
            has_selector = true
            continue
        end
        if str.StartsWith(nm, "hover_"):
            hover += css_decl(
                cx.compact, hyphenate(str.Substr(nm, 6, str.Len(nm) - 6)), v
            )
            continue
        end
        if str.StartsWith(nm, "focus_"):
            focus += css_decl(
                cx.compact, hyphenate(str.Substr(nm, 6, str.Len(nm) - 6)), v
            )
            continue
        end
        if str.StartsWith(nm, "active_"):
            active += css_decl(
                cx.compact, hyphenate(str.Substr(nm, 7, str.Len(nm) - 7)), v
            )
            continue
        end
        if str.StartsWith(nm, "before_"):
            rest := str.Substr(nm, 7, str.Len(nm) - 7)
            if str.Equals(rest, "content"):
                before += css_decl(cx.compact, "content", `"` + v + `"`)
            else:
                before += css_decl(cx.compact, hyphenate(rest), v)
            end
            continue
        end
        if str.StartsWith(nm, "after_"):
            rest := str.Substr(nm, 6, str.Len(nm) - 6)
            if str.Equals(rest, "content"):
                after += css_decl(cx.compact, "content", `"` + v + `"`)
            else:
                after += css_decl(cx.compact, hyphenate(rest), v)
            end
            continue
        end
        if str.Len(nm) >= 2 && byte_at(nm, 0) == 111 && byte_at(nm, 1) == 110:
            attrs += " " + nm + `="` + html_escape(v) + `"`
            continue
        end
        if str.Equals(name, "canvas") && (str.Equals(nm, "width") || str.Equals(nm, "height")):
            attrs += " " + nm + `="` + html_escape(v) + `"`
            continue
        end
        ai := sm.LayoutAttrLookup(nm)
        dest := ai >= 0 ? sm.LayoutAttrDest(ai) : K_LO_LA_CSS
        if dest == K_LO_LA_CONTENT:
            content = v
            has_content = true
        else dest == K_LO_LA_CLASS:
            userclass = v
            has_userclass = true
        else dest == K_LO_LA_STYLE:
            attrs += ` style="` + html_escape(v) + `"`
        else dest == K_LO_LA_DIR:
            attrs += ` dir="` + attr_value_map(ai, v) + `"`
        else dest == K_LO_LA_LANG:
            attrs += ` lang="` + attr_value_map(ai, v) + `"`
        else dest == K_LO_LA_SOURCE:
            source = v
            has_source = true
        else dest == K_LO_LA_HTML:
            if str.Equals(nm, "src"):
                srcv = v
                has_src = true
            else str.Equals(nm, "type"):
                type_val = attr_value_map(ai, v)
                has_type = true
            else str.Equals(nm, "condition"):
                condition = v
                has_condition = true
            else is_bool_attr(nm) && str.Equals(v, "true"):
                attrs += " " + sm.LayoutAttrOut(ai)
            else:
                attrs += " " + sm.LayoutAttrOut(ai) + `="` + html_escape(attr_value_map(ai, v)) + `"`
            end
        else dest == K_LO_LA_CSS:
            mut prop := hyphenate(nm)
            if ai >= 0 && str.Len(sm.LayoutAttrOut(ai)) > 0:
                prop = sm.LayoutAttrOut(ai)
            end
            mapped := attr_value_map(ai, v)
            css += css_decl(cx.compact, prop, quote_css_value_if_needed(mapped))
        end
        // K_LO_LA_META: nothing
    end
    has_css := str.Len(css) > 0
    needs_class := has_css || str.Len(hover) > 0 || str.Len(focus) > 0 || str.Len(active) > 0 || str.Len(before) > 0 || str.Len(after) > 0
    mut klass := userclass
    mut has_klass := has_userclass
    if needs_class && !has_klass:
        sep := char_from_code(31)
        key := css + sep + hover + sep + focus + sep + active + sep + before + sep + after
        klass = class_for_key(cx, key)
        has_klass = true
    end

    if str.Equals(name, "media"):
        sel := parent_has_class ? parent_class : "body"
        cond := has_condition ? condition : "all"
        inner := css_rule(cx.compact, "." + sel, css)
        if cx.compact:
            emit_rule(cx, "@media " + cond + "{" + inner + "}")
        else:
            emit_rule(cx, "@media " + cond + " { " + inner + " }")
        end
        ret
    end
    if str.Equals(name, "style"):
        if has_content:
            cx.css += cx.compact ? mn.Css(content) : content
            if !cx.compact:
                cx.css += "\n"
            end
        end
        ret
    end
    if str.Equals(name, "global"):
        emit_rule(cx, css_rule(cx.compact, has_selector ? selector : "*", css))
        ret
    end
    if str.Equals(name, "script"):
        if has_src:
            html_line(cx, `<script src="` + html_escape(srcv) + `"></script>`)
        else has_content:
            cx.js += cx.compact ? mn.Js(content) : content
            cx.js += cx.compact ? " " : "\n"
        end
        ret
    end

    if has_css:
        emit_rule(cx, css_rule(cx.compact, "." + klass, css))
    end
    if str.Len(hover) > 0:
        emit_rule(cx, css_rule(cx.compact, "." + klass + ":hover", hover))
    end
    if str.Len(focus) > 0:
        emit_rule(cx, css_rule(cx.compact, "." + klass + ":focus", focus))
    end
    if str.Len(active) > 0:
        emit_rule(cx, css_rule(cx.compact, "." + klass + ":active", active))
    end
    if str.Len(before) > 0:
        emit_rule(cx, css_rule(cx.compact, "." + klass + "::before", before))
    end
    if str.Len(after) > 0:
        emit_rule(cx, css_rule(cx.compact, "." + klass + "::after", after))
    end
    classattr := has_klass ? ` class="` + klass + `"` : ""
    esc := has_content ? html_escape(content) : ""

    if str.Equals(name, "link"):
        href := has_source ? html_escape(source) : "#"
        if has_child_elements(a, el):
            html_line(cx, `<a href="` + href + `"` + classattr + attrs + ">")
            cx.indent += 1
            if has_content:
                html_line(cx, esc)
            end
            gen_children(cx, diag, a, el, klass, has_klass)
            cx.indent -= 1
            html_line(cx, "</a>")
        else:
            html_line(
                cx, `<a href="` + href + `"` + classattr + attrs + ">" + esc + "</a>"
            )
        end
        ret
    end
    if str.Equals(name, "image"):
        html_line(
            cx, `<img src="` + (has_source ? html_escape(source) : "") + `"` + classattr + attrs + ` alt="` + esc + `" />`
        )
        ret
    end
    if str.Equals(name, "input"):
        if has_type && str.Equals(type_val, "textarea"):
            html_line(
                cx, "<textarea" + classattr + attrs + ">" + esc + "</textarea>"
            )
        else:
            html_line(
                cx, "<input" + (has_type ? ` type="` + type_val + `"` : "") + classattr + attrs + " />"
            )
        end
        ret
    end

    if str.Equals(name, "canvas"):
        html_line(cx, "<canvas" + classattr + attrs + "></canvas>")
        ret
    end
    if str.Equals(name, "iframe"):
        html_line(
            cx, "<iframe" + classattr + attrs + (has_src ? ` src="` + html_escape(srcv) + `"` : "") + "></iframe>"
        )
        ret
    end
    if ltype == K_LO_LE_SINGLE:
        html_line(cx, "<" + tag + classattr + attrs + " />")
        ret
    end
    if has_child_elements(a, el):
        html_line(cx, "<" + tag + classattr + attrs + ">")
        cx.indent += 1
        if has_content:
            html_line(cx, esc)
        end
        gen_children(cx, diag, a, el, klass, has_klass)
        cx.indent -= 1
        html_line(cx, "</" + tag + ">")
    else:
        html_line(
            cx, "<" + tag + classattr + attrs + ">" + esc + "</" + tag + ">"
        )
    end
end

// plural_suffix: "" for a count of exactly 1, "s" otherwise.
func plural_suffix(n: int): str:
    ret n == 1 ? "" : "s"
end
