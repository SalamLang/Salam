package layout

import str

include co "../sal_core.salam"
include tok "../token.salam"
include at "../ast.salam"
include sm "../semantic/semantic.salam"

func html_line(cx &: LoCtx, s: str):
    if not cx.compact:
        ind := cx.indent
        repeat ind:
            cx.html += "  "
        end
    end
    cx.html += s
    if not cx.compact:
        cx.html += "\n"
    end
end

func hyphenate(s: str): str:
    ret str.Replace(str.Replace(s, "_", "-"), " ", "-")
end

func html_escape(s: str): str:
    mut out := ""
    n := str.Len(s)
    repeat n in i:
        b := byte_at(s, i)
        if b == 38:
            out += "&amp;"
        else b == 60:
            out += "&lt;"
        else b == 62:
            out += "&gt;"
        else b == 34:
            out += "&quot;"
        else b == 39:
            out += "&#39;"
        else:
            out += str.Substr(s, i, 1)
        end
    end
    ret out
end

func css_string(s: str): str:
    mut out := `"`
    n := str.Len(s)
    repeat n in i:
        b := byte_at(s, i)
        if b == 34 or b == 92:
            out += "\\" + str.Substr(s, i, 1)
        else b == 10 or b == 13 or b == 12:
            out += "\\a "
        else b == 60:
            out += "\\3c "
        else b == 62:
            out += "\\3e "
        else:
            out += str.Substr(s, i, 1)
        end
    end
    ret out + `"`
end

func val_str(a &: at.Ast, vid: int): str:
    if vid == 0:
        ret ""
    end
    v := at.Get(a, vid)
    if v.kind == at.AST_LITERAL:
        if v.op == tok.TK_STRING or v.op == tok.TK_TRIPLE_STRING or v.op == tok.TK_RAW_STRING or v.value_kind == tok.TV_STRING:
            ret v.value_str
        end
        if v.op == tok.TK_INT:
            ret co.U64Toa(v.value_int) + sm.LayoutNumUnit(v.name)
        end
        if v.op == tok.TK_FLOAT:
            ret co.Format1("%g", co.ArgFloat(v.value_float)) + sm.LayoutNumUnit(v.name)
        end
        if v.op == tok.TK_KW_TRUE:
            ret "true"
        end
        if v.op == tok.TK_KW_FALSE:
            ret "false"
        end
        ret v.name
    end
    if v.kind == at.AST_IDENTIFIER:
        ret v.name
    end
    if v.kind == at.AST_CALL:
        mut fn := "fn"
        if v.a != 0 and at.KindOf(a, v.a) == at.AST_IDENTIFIER:
            fn = at.Get(a, v.a).name
        end
        mut out := fn + "("
        repeat at.ChildCount(a, vid) in i:
            argid := at.Child(a, vid, i)
            arg := at.Get(a, argid)
            if i > 0:
                out += ", "
            end
            if arg.kind == at.AST_LITERAL and (arg.op == tok.TK_STRING or arg.op == tok.TK_TRIPLE_STRING or arg.op == tok.TK_RAW_STRING):
                out += `"` + val_str(a, argid) + `"`
            else:
                out += val_str(a, argid)
            end
        end
        ret out + ")"
    end
    ret ""
end

func class_seq_name(n: int): str:
    mut out := ""
    mut x := n + 1
    until x > 0:
        x -= 1
        out = char_from_code(97 + x % 26) + out
        x /= 26
    end
    ret out
end

func class_for_key(cx &: LoCtx, key: str): str:
    repeat cx.cls_keys.len() in i:
        if str.Equals(cx.cls_keys.get(i), key):
            ret cx.cls_names.get(i)
        end
    end
    name := g_lo_cls_prefix + class_seq_name(cx.cls_next)
    cx.cls_next += 1
    cx.cls_keys.push(key)
    cx.cls_names.push(name)
    ret name
end

func emit_rule(cx &: LoCtx, rule: str):
    repeat cx.css_seen.len() in i:
        if str.Equals(cx.css_seen.get(i), rule):
            ret
        end
    end
    cx.css_seen.push(rule)
    cx.css += rule
    if not cx.compact:
        cx.css += "\n"
    end
end

func css_decl(compact: bool, prop: str, val: str): str:
    if compact:
        ret prop + ":" + val + ";"
    end
    ret prop + ": " + val + "; "
end

func css_rule(compact: bool, sel: str, body: str): str:
    if compact:
        mut n := str.Len(body)
        until n > 0 and byte_at(body, n - 1) == 32:
            n -= 1
        end
        if n > 0 and byte_at(body, n - 1) == 59:
            n -= 1
        end
        ret sel + "{" + str.Substr(body, 0, n) + "}"
    end
    ret sel + " { " + body + " }"
end

func is_bool_attr(n: str): bool:
    ret str.Equals(n, "required") or str.Equals(n, "checked") or str.Equals(n, "disabled") or str.Equals(n, "hidden") or str.Equals(n, "selected") or str.Equals(n, "multiple")
end
