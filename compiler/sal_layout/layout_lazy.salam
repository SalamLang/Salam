package layout

import str

include co "../sal_core.salam"
include tok "../token.salam"
include at "../ast.salam"

const K_LO_LAZY_MARK := "<!--salam-lazy:"
const K_LO_PAGE_MARK := "<!--salam-page:"

mut g_lo_lazy_count := 0
mut g_lo_lazy := Vector {} as Vector<LoLazy>

struct LoLazy:
    pub region: int = 0
    pub cond: int = 0
    pub text: str = ""
    pub pieces: Vector<int> = Vector {}
end

func lo_lazy_hash(text: str): str:
    mask := 4294967295 as u64
    mut h := 2166136261 as u64
    repeat str.Len(text) in i:
        h = ((h ^ (byte_at(text, i) as u64)) * (16777619 as u64)) & mask
    end
    digits := "0123456789abcdef"
    mut out := ""
    mut shift := 28
    until shift >= 0:
        out += str.Substr(digits, ((h >> (shift as u64)) & (15 as u64)) as int, 1)
        shift -= 4
    end
    ret out
end

func lo_lazy_names(a &: at.Ast, nid: int, name: str): bool:
    if nid == 0:
        ret false
    end
    n := at.Get(a, nid)
    if n.kind == at.AST_LITERAL and n.value_kind == tok.TV_STRING and str.Equals(n.value_str, name):
        ret true
    end
    if lo_lazy_names(a, n.a, name) or lo_lazy_names(a, n.b, name) or lo_lazy_names(a, n.c, name):
        ret true
    end
    repeat n.list.Len() in i:
        if lo_lazy_names(a, n.list.Get(i), name):
            ret true
        end
    end
    ret false
end

func lo_lazy_piece(a &: at.Ast, stmt: int): int:
    n := at.Get(a, stmt)
    if n.kind != at.AST_ASSIGN or n.a == 0 or n.b == 0:
        ret 0
    end
    target := at.Get(a, n.a)
    if target.kind != at.AST_IDENTIFIER or not str.Equals(target.name, "__salam_h"):
        ret 0
    end
    mut v := at.Get(a, n.b)
    mut id := n.b
    if v.kind == at.AST_BINARY and v.a != 0 and str.Equals(at.Get(a, v.a).name, "__salam_h"):
        id = v.b
        v = at.Get(a, id)
    end
    if v.kind != at.AST_LITERAL or v.value_kind != tok.TV_STRING:
        ret 0
    end
    ret id
end

func lo_lazy_literal(a &: at.Ast, nid: int, value: str):
    at.SetName(a, nid, value)
    mut v := tok.ValueNone()
    v.kind = tok.TV_STRING
    v.sval = value
    at.SetTokenValue(a, nid, v)
end

func lo_lazy_branch(a &: at.Ast, branch: int, region: int):
    n := at.Get(a, branch)
    if n.b == 0 or at.KindOf(a, n.b) != at.AST_BLOCK or at.ChildCount(a, n.b) == 0:
        ret
    end
    mut pieces := Vector {} as Vector<int>
    mut text := str.NewBuilder()
    defer str.BufFree(text)
    repeat at.ChildCount(a, n.b) in i:
        piece := lo_lazy_piece(a, at.Child(a, n.b, i))
        if piece == 0:
            pieces.Free()
            ret
        end
        pieces.Push(piece)
        str.BufAppend(text, at.Get(a, piece).value_str)
    end
    g_lo_lazy.Push(
        LoLazy { region = region, cond = n.a, text = str.Clone(str.BufStr(text)), pieces = pieces }
    )
end

func lo_lazy_walk(a &: at.Ast, nid: int, region: int):
    if nid == 0:
        ret
    end
    n := at.Get(a, nid)
    if n.kind == at.AST_IF:
        lo_lazy_branch(a, nid, region)
    end
    lo_lazy_walk(a, n.b, region)
    lo_lazy_walk(a, n.c, region)
    repeat n.list.Len() in i:
        lo_lazy_walk(a, n.list.Get(i), region)
    end
end

func lo_lazy_runtime(): str:
    ret `var __salam_pages = {};
var __salam_page_wait = {};
var __salam_page_back = null;
var __salam_page_start = typeof location === "undefined" ? "" : __salam_page_here();
if (typeof window !== "undefined") {
    window.addEventListener("popstate", function (e) {
        __salam_page_back = e.state && typeof e.state.x === "number" ? e.state : null;
    });
}
function __salam_page_restore() {
    var want = __salam_page_back, now = history.state;
    if (want && now && now.x === want.x && now.y === want.y) {
        window.scrollTo(want.x, want.y);
    }
}
function __salam_page_here() {
    var p = __salam_rt_here(), q = p.indexOf("?");
    p = q < 0 ? p : p.slice(0, q);
    return p.length > 1 && p.charAt(p.length - 1) === "/" ? p.slice(0, -1) : p;
}
function __salam_page_text(from, to) {
    var box = document.createElement("div");
    for (var n = from; n && n !== to; n = n.nextSibling) {
        if (!(n.nodeType === 8 && n.data.indexOf("salam-page:") === 0)) {
            box.appendChild(n.cloneNode(true));
        }
    }
    return box.innerHTML;
}
function __salam_page_seed() {
    if (typeof document === "undefined" || !document.body) {
        return;
    }
    var w = document.createTreeWalker(document.body, NodeFilter.SHOW_COMMENT), c, found = [];
    while ((c = w.nextNode())) {
        if (c.data.indexOf("salam-page:") === 0) {
            found.push(c);
        }
    }
    for (var i = 0; i < found.length; i++) {
        var open = found[i].previousSibling;
        if (open && open.nodeType === 8 && /^salam:\d+$/.test(open.data)) {
            __salam_pages[found[i].data.slice(11)] = __salam_page_text(found[i], __salam_end(open));
        }
    }
}
function __salam_page(i, html, s, e) {
    var m = /^<!--salam-lazy:([0-9a-f]{8}):([\s\S]*)-->$/.exec(html);
    if (!m) {
        return html;
    }
    var hash = m[1];
    if (__salam_pages[hash] !== undefined) {
        return __salam_pages[hash];
    }
    if (window.__salam_base === undefined && s.nextSibling !== e && document.getElementById("__salam")) {
        __salam_pages[hash] = __salam_page_text(s.nextSibling, e);
        return null;
    }
    __salam_page_load(i, hash, m[2]);
    return null;
}
function __salam_page_load(i, hash, path) {
    if (__salam_page_wait[hash]) {
        return;
    }
    __salam_page_wait[hash] = true;
    var url = __salam_rt_base + encodeURI(path === "/" ? "/" : path + "/");
    fetch(url, { credentials: "same-origin" }).then(function (r) {
        if (!r.ok) {
            throw new Error("HTTP " + r.status);
        }
        return r.text();
    }).then(function (text) {
        var open = "<!--salam:" + i + "-->", a = text.indexOf(open);
        var b = a < 0 ? -1 : text.indexOf("<!--/salam:" + i + "-->", a);
        var body = b < 0 ? "" : text.slice(a + open.length, b).replace("<!--salam-page:" + hash + "-->", "");
        if (b < 0 || __salam_call_hash(body) !== hash) {
            throw new Error("the page on the server is from another build");
        }
        __salam_pages[hash] = body;
        delete __salam_page_wait[hash];
        salamWsTouch(i);
        setTimeout(__salam_page_restore, 0);
    }).catch(function (x) {
        delete __salam_page_wait[hash];
        var here = __salam_page_here();
        if (here !== path) {
            return;
        }
        if (here !== __salam_page_start) {
            location.reload();
        } else if (typeof console !== "undefined" && console.error) {
            console.error("salam: cannot load " + url, x);
        }
    });
}
__salam_page_seed();
`
end

pub func LazyScan(a &: at.Ast, prog: int):
    g_lo_lazy_count = 0
    g_lo_lazy.Clear()
    if prog == 0 or not RoutesActive() or RoutesHash():
        ret
    end
    prefix := "__salam_view_"
    repeat at.ChildCount(a, prog) in i:
        d := at.Get(a, at.Child(a, prog, i))
        if d.kind == at.AST_FUNC_DEF and str.StartsWith(d.name, prefix):
            tail := str.Substr(d.name, str.Len(prefix), str.Len(d.name) - str.Len(prefix))
            lo_lazy_walk(a, d.a, tail.ToInt())
        end
    end
end

pub func LazyCut(a &: at.Ast, region: int, path: str, html: str): str:
    if str.Len(html) == 0 or str.Contains(html, "<!--salam"):
        ret ""
    end
    each found in g_lo_lazy:
        if found.region != region or not str.Equals(found.text, html) or
            not lo_lazy_names(a, found.cond, path):
            continue
        end
        hash := lo_lazy_hash(html)
        repeat found.pieces.Len() in k:
            lo_lazy_literal(
                a, found.pieces.Get(k), k == 0 ? K_LO_LAZY_MARK + hash + ":" + path + "-->" : ""
            )
        end
        g_lo_lazy_count++
        ret K_LO_PAGE_MARK + hash + "-->"
    end
    ret ""
end
