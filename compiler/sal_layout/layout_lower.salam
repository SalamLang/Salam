package layout

import str
import gui.style

include co "../sal_core.salam"
include tok "../token.salam"
include lg "../logger.salam"
include dg "../diag.salam"
include lp "../langpack.salam"
include at "../ast.salam"
include cc "../condcomp.salam"
include src "../source.salam"
include sm "../semantic/semantic.salam"
include lx "../lexer/lexer.salam"
include ps "../parser/parser.salam"
include i18 "../i18n.salam"

const SL_TEXT := 1
const SL_ATTR := 2
const SL_URL := 3
const SL_CSS := 4
const SL_BOOL := 5
const SL_CSSURL := 6
const SL_IF := 7
const SL_EACH := 8
const SL_BAD := 9
const SL_STD := 10

mut g_lo_env_nodes := Vector {} as Vector<int>
mut g_lo_env_injected := false
mut g_lo_em_lb := Vector {} as Vector<int>
mut g_lo_em_attr := Vector {} as Vector<int>
mut g_lo_em_query := Vector {} as Vector<str>
mut g_lo_em_val := Vector {} as Vector<int>

struct LoSlot:
    pub kind: int = 0
    pub expr: int = 0
    pub out: str = ""
    pub item: str = ""
    pub key: int = 0
    pub loop: int = 0
    pub prop: int = 0
    pub state: int = 0
end

struct LoLower:
    pub prog: int = 0
    pub slots: Vector<LoSlot> = Vector {}
    pub shadow: Vector<str> = Vector {}
    pub funcs: Vector<str> = Vector {}
    pub loop: int = 0
    pub web: str = "web"
end

func lo_mark(tag: str, n: int): str:
    ret char_from_code(2) + "salam-" + tag + "-" + co.U64Toa(n as u64) + char_from_code(3)
end

func lo_in_shadow(lw &: LoLower, name: str): bool:
    repeat lw.shadow.Len() in i:
        if str.Equals(lw.shadow.Get(i), name):
            ret true
        end
    end
    ret false
end

func lo_is_prog_func(lw &: LoLower, name: str): bool:
    repeat lw.funcs.Len() in i:
        if str.Equals(lw.funcs.Get(i), name):
            ret true
        end
    end
    ret false
end

func lo_refs_runtime(lw &: LoLower, a &: at.Ast, nid: int): bool:
    if nid == 0:
        ret false
    end
    n := at.Get(a, nid)
    if n.kind == at.AST_IDENTIFIER:
        ret lo_in_shadow(lw, n.name) or lo_is_mut_global(lw, a, n.name)
    end
    if n.kind == at.AST_CALL:
        if n.a != 0 and at.KindOf(a, n.a) == at.AST_IDENTIFIER:
            if lo_is_prog_func(lw, at.Get(a, n.a).name):
                ret true
            end
        else:
            ret true
        end
        repeat n.list.Len() in i:
            if lo_refs_runtime(lw, a, n.list.Get(i)):
                ret true
            end
        end
        if lo_refs_runtime(lw, a, n.a) or lo_refs_runtime(lw, a, n.b) or lo_refs_runtime(lw, a, n.c) or lo_refs_runtime(lw, a, n.d):
            ret true
        end
        ret false
    end
    if n.kind == at.AST_MEMBER or n.kind == at.AST_INDEX or n.kind == at.AST_SLICE:
        ret true
    end
    if lo_refs_runtime(lw, a, n.a) or lo_refs_runtime(lw, a, n.b) or lo_refs_runtime(lw, a, n.c) or lo_refs_runtime(lw, a, n.d):
        ret true
    end
    repeat n.list.Len() in i:
        if lo_refs_runtime(lw, a, n.list.Get(i)):
            ret true
        end
    end
    ret false
end

func lo_slot_kind(el: int, ei: int, name: str): int:
    if el == 0:
        if str.Equals(name, "title") or str.Equals(name, "content"):
            ret SL_TEXT
        end
        if str.Equals(name, "lang") or str.Equals(name, "dir"):
            ret SL_ATTR
        end
        if str.Equals(name, "favicon"):
            ret SL_URL
        end
        ret SL_ATTR
    end
    if sm.LayoutPseudoPrefixLen(name) > 0:
        ret SL_BAD
    end
    mut key := sm.LayoutAttrKey(name)
    if str.Len(key) == 0:
        key = name
    end
    ai := sm.LayoutAttrFor(ei, key)
    if ai < 0:
        ret SL_ATTR
    end
    dest := sm.LayoutAttrDest(ai)
    vt := sm.LayoutAttrVtype(ai)
    if ei >= 0 and str.Equals(sm.LayoutElemGenerator(ei), "font_face"):
        if str.Equals(key, "url"):
            ret SL_CSSURL
        end
        if str.Equals(key, "weight") or str.Equals(key, "style") or str.Equals(key, "display") or str.Equals(key, "range"):
            ret SL_CSS
        end
        if dest == sm.LA_CONTENT or dest == sm.LA_SOURCE:
            ret SL_CSS
        end
        ret SL_CSS
    end
    if vt == sm.VT_CODE:
        ret SL_BAD
    end
    if dest == sm.LA_CONTENT:
        k := ei >= 0 ? sm.LayoutElemKind(ei) : sm.LK_NORMAL
        g := ei >= 0 ? sm.LayoutElemGenerator(ei) : ""
        if k == sm.LK_RAW or str.Equals(g, "style") or str.Equals(g, "script"):
            ret SL_BAD
        end
        ret SL_TEXT
    end
    if dest == sm.LA_SOURCE:
        ret SL_URL
    end
    if dest == sm.LA_CLASS:
        ret SL_ATTR
    end
    if dest == sm.LA_DIR or dest == sm.LA_LANG:
        ret SL_ATTR
    end
    if dest == sm.LA_CSS or dest == sm.LA_HTML_OR_CSS:
        if vt == sm.VT_URL or vt == sm.VT_ABS_URL or vt == sm.VT_REL_URL:
            ret SL_CSSURL
        end
        ret SL_CSS
    end
    if dest == sm.LA_STYLE:
        ret SL_CSS
    end
    if dest == sm.LA_HTML or dest == sm.LA_META:
        if vt == sm.VT_BOOL or vt == sm.VT_BOOL_ENUM:
            ret SL_BOOL
        end
        if vt == sm.VT_URL or vt == sm.VT_ABS_URL or vt == sm.VT_REL_URL:
            ret SL_URL
        end
        ret SL_ATTR
    end
    if vt == sm.VT_ENUM or vt == sm.VT_DIR or vt == sm.VT_LANG:
        ret SL_ATTR
    end
    ret SL_ATTR
end

func lo_bool_out(ei: int, name: str): str:
    mut key := sm.LayoutAttrKey(name)
    if str.Len(key) == 0:
        key = name
    end
    ai := sm.LayoutAttrFor(ei, key)
    if ai >= 0 and str.Len(sm.LayoutAttrOut(ai)) > 0 and str.IndexOf(sm.LayoutAttrOut(ai), "*") < 0:
        ret sm.LayoutAttrOut(ai)
    end
    ret hyphenate(key)
end

func lo_add_slot(lw &: LoLower, a &: at.Ast, from: int, sl0: LoSlot): int:
    idx := lw.slots.Len()
    mut sl := sl0
    sl.loop = lw.loop
    lw.slots.Push(sl)
    tag := sl.kind == SL_BAD ? "bad" : "dyn"
    ret mk_str(a, lo_mark(tag, idx), from)
end

func lo_list_runtime(lw &: LoLower, a &: at.Ast, nid: int): int:
    if nid == 0:
        ret 0
    end
    n := at.Get(a, nid)
    if n.kind == at.AST_TUPLE or n.kind == at.AST_ARRAY_LIT:
        repeat at.ChildCount(a, nid) in i:
            r := lo_list_runtime(lw, a, at.Child(a, nid, i))
            if r != 0:
                ret nid
            end
        end
        ret 0
    end
    if n.kind == at.AST_IDENTIFIER and lo_is_mut_global(lw, a, n.name):
        ret nid
    end
    ret lo_refs_runtime(lw, a, nid) ? nid : 0
end

func lo_is_mut_global(lw &: LoLower, a &: at.Ast, name: str): bool:
    if lw.prog == 0:
        ret false
    end
    repeat at.ChildCount(a, lw.prog) in i:
        d := at.Get(a, at.Child(a, lw.prog, i))
        if d.kind == at.AST_VAR_DECL and d.is_mut and str.Equals(d.name, name):
            ret true
        end
    end
    ret false
end

func lo_cat(a &: at.Ast, l: int, r: int, from: int): int:
    n := at.NewNode(a, at.AST_BINARY)
    copy_span(a, n, from)
    mut m := at.Get(a, n)
    m.op = tok.TK_PLUS
    m.a = l
    m.b = r
    at.Put(a, n, m)
    ret n
end

func lo_std_text(lw &: LoLower, a &: at.Ast, nid: int, from: int): int:
    n := at.Get(a, nid)
    if n.kind == at.AST_TERNARY:
        t := at.NewNode(a, at.AST_TERNARY)
        copy_span(a, t, from)
        mut tm := at.Get(a, t)
        tm.a = n.a
        tm.b = lo_std_text(lw, a, n.b, from)
        tm.c = lo_std_text(lw, a, n.c, from)
        at.Put(a, t, tm)
        ret t
    end
    if n.kind != at.AST_TUPLE and n.kind != at.AST_ARRAY_LIT and lo_list_runtime(lw, a, nid) != 0:
        ret nid
    end
    if n.kind == at.AST_TUPLE or n.kind == at.AST_ARRAY_LIT:
        mut out := mk_str(a, n.kind == at.AST_ARRAY_LIT ? "[" : "", from)
        repeat at.ChildCount(a, nid) in i:
            if i > 0:
                out = lo_cat(a, out, mk_str(a, ", ", from), from)
            end
            out = lo_cat(a, out, lo_std_text(lw, a, at.Child(a, nid, i), from), from)
        end
        if n.kind == at.AST_ARRAY_LIT:
            out = lo_cat(a, out, mk_str(a, "]", from), from)
        end
        ret out
    end
    if lo_list_runtime(lw, a, nid) != 0:
        ret lo_cat(a, mk_str(a, "", from), nid, from)
    end
    ret mk_str(a, sm.LayoutListText(a, lw.prog, nid, ""), from)
end

func lo_std_slot(lw &: LoLower, a &: at.Ast, attr: int, el: int, vid: int): bool:
    if sm.LayoutNativeTarget() or el == 0:
        ret false
    end
    sa := sm.ResolveStyleAttr(at.Get(a, attr).name)
    if not sa.ok:
        ret false
    end
    mark := lo_add_slot(lw, a, vid, LoSlot { kind = SL_STD, expr = lo_std_text(lw, a, vid, vid), prop = sa.prop, state = sa.state })
    mut n1 := at.Get(a, attr)
    n1.a = mark
    at.Put(a, attr, n1)
    ret true
end

func lo_native_list_text(lw &: LoLower, a &: at.Ast, vid: int, prop: int): str:
    mut out := ""
    repeat at.ChildCount(a, vid) in i:
        cid := at.Child(a, vid, i)
        mut item := cid
        if at.KindOf(a, cid) != at.AST_LITERAL:
            lit := sm.LayoutFoldLiteral(a, lw.prog, cid, lw.shadow)
            if lit != 0:
                item = lit
            end
        end
        if i > 0:
            out += ", "
        end
        out += sm.StyleAttrTextFor(a, item, prop)
    end
    ret out
end

func lo_list_value(lw &: LoLower, a &: at.Ast, attr: int, el: int, ei: int, vid: int):
    an := at.Get(a, attr).name
    mut k := lo_slot_kind(el, ei, an)
    dyn := lo_list_runtime(lw, a, vid)
    if dyn != 0 and lo_std_slot(lw, a, attr, el, vid):
        ret
    end
    if dyn != 0:
        if k == SL_IF or k == SL_EACH:
            k = SL_ATTR
        end
        if k == SL_BAD or k == SL_BOOL:
            mut key := sm.LayoutAttrKey(an)
            if str.Len(key) == 0:
                key = an
            end
            ai := sm.LayoutAttrFor(ei, key)
            if sm.LayoutPseudoPrefixLen(an) > 0:
                k = SL_CSS
            else ai >= 0 and sm.LayoutAttrDest(ai) == sm.LA_CONTENT:
                ek := ei >= 0 ? sm.LayoutElemKind(ei) : sm.LK_NORMAL
                eg := ei >= 0 ? sm.LayoutElemGenerator(ei) : ""
                if ek != sm.LK_RAW and not str.Equals(eg, "style") and not str.Equals(eg, "script"):
                    k = SL_TEXT
                else:
                    k = SL_ATTR
                end
            else ai >= 0 and sm.LayoutAttrDest(ai) == sm.LA_SOURCE:
                k = SL_URL
            else ai >= 0 and (sm.LayoutAttrDest(ai) == sm.LA_CSS or sm.LayoutAttrDest(ai) == sm.LA_STYLE):
                vt := sm.LayoutAttrVtype(ai)
                k = (vt == sm.VT_URL or vt == sm.VT_ABS_URL or vt == sm.VT_REL_URL) ? SL_CSSURL : SL_CSS
            else ai >= 0 and sm.LayoutAttrDest(ai) == sm.LA_HTML_OR_CSS:
                vt := sm.LayoutAttrVtype(ai)
                k = (vt == sm.VT_URL or vt == sm.VT_ABS_URL or vt == sm.VT_REL_URL) ? SL_CSSURL : SL_CSS
            else ai >= 0 and (sm.LayoutAttrVtype(ai) == sm.VT_BOOL or sm.LayoutAttrVtype(ai) == sm.VT_BOOL_ENUM):
                k = SL_BOOL
            else:
                k = SL_ATTR
            end
        end
        mut sl := LoSlot { kind = k, expr = vid }
        if k == SL_BOOL:
            sl.out = lo_bool_out(ei, an)
        end
        mark := lo_add_slot(lw, a, vid, sl)
        mut n1 := at.Get(a, attr)
        n1.a = mark
        at.Put(a, attr, n1)
        ret
    end
    mut lit_name := an
    if el != 0 and ei >= 0:
        mut key := sm.LayoutAttrKey(an)
        if str.Len(key) == 0:
            key = an
        end
        ai := sm.LayoutAttrFor(ei, key)
        if ai >= 0 and sm.LayoutAttrDest(ai) == sm.LA_CLASS:
            lit_name = "class"
        end
    end
    mut text := sm.LayoutListText(a, lw.prog, vid, lit_name)
    sa := sm.ResolveStyleAttr(an)
    if sm.UiTarget() == sm.UI_NATIVE and sa.ok and at.Get(a, vid).kind == at.AST_TUPLE:
        text = lo_native_list_text(lw, a, vid, sa.prop)
    end
    if str.Len(text) == 0:
        ret
    end
    folded := mk_str(a, text, vid)
    mut fl := at.Get(a, folded)
    fl.synthetic = true
    at.Put(a, folded, fl)
    mut n2 := at.Get(a, attr)
    n2.a = folded
    at.Put(a, attr, n2)
end

func lo_text_branch(lw &: LoLower, a &: at.Ast, nid: int): int:
    if nid == 0:
        ret nid
    end
    n := at.Get(a, nid)
    if n.kind == at.AST_TERNARY:
        mut m := n
        m.b = lo_text_branch(lw, a, n.b)
        m.c = lo_text_branch(lw, a, n.c)
        at.Put(a, nid, m)
        ret nid
    end
    if n.kind == at.AST_IDENTIFIER and not lo_refs_runtime(lw, a, nid) and sm.LayoutFoldLiteral(a, lw.prog, nid, lw.shadow) == 0:
        ret mk_str(a, n.name, nid)
    end
    if n.kind == at.AST_LITERAL and n.op == tok.TK_INT:
        ret mk_str(a, co.U64Toa(n.value_int) + sm.LayoutNumUnit(n.name), nid)
    end
    if n.kind == at.AST_LITERAL and n.op == tok.TK_FLOAT:
        ret mk_str(a, co.Format1("%g", co.ArgFloat(n.value_float)) + sm.LayoutNumUnit(n.name), nid)
    end
    ret nid
end

func lo_value(lw &: LoLower, a &: at.Ast, attr: int, el: int, ei: int):
    an := at.Get(a, attr)
    mut vid := an.a
    if vid == 0:
        ret
    end
    v := at.Get(a, vid)
    if v.kind == at.AST_LITERAL:
        ret
    end
    if v.kind == at.AST_TUPLE or v.kind == at.AST_ARRAY_LIT:
        lo_list_value(lw, a, attr, el, ei, vid)
        ret
    end
    mut empty_fb := false
    if v.kind == at.AST_TERNARY and sm.LayoutHasEmptyFallback(a, vid):
        empty_fb = true
        vid = lo_text_branch(lw, a, vid)
    end
    lit := sm.LayoutFoldLiteral(a, lw.prog, vid, lw.shadow)
    if lit != 0:
        if empty_fb:
            mut ln := at.Get(a, lit)
            ln.synthetic = true
            at.Put(a, lit, ln)
        end
        mut n1 := at.Get(a, attr)
        n1.a = lit
        at.Put(a, attr, n1)
        ret
    end
    if not lo_refs_runtime(lw, a, vid):
        ret
    end
    if lo_std_slot(lw, a, attr, el, vid):
        ret
    end
    if sm.LayoutNativeTarget() and sm.ResolveStyleAttr(an.name).ok:
        vid = lo_std_text(lw, a, vid, vid)
    end
    mut k := lo_slot_kind(el, ei, an.name)
    if k == SL_IF or k == SL_EACH:
        k = SL_ATTR
    end
    if k == SL_BAD:
        mut key := sm.LayoutAttrKey(an.name)
        if str.Len(key) == 0:
            key = an.name
        end
        ai := sm.LayoutAttrFor(ei, key)
        if sm.LayoutPseudoPrefixLen(an.name) > 0:
            k = SL_CSS
        else ai >= 0 and sm.LayoutAttrDest(ai) == sm.LA_CONTENT:
            ek := ei >= 0 ? sm.LayoutElemKind(ei) : sm.LK_NORMAL
            eg := ei >= 0 ? sm.LayoutElemGenerator(ei) : ""
            if ek != sm.LK_RAW and not str.Equals(eg, "style") and not str.Equals(eg, "script"):
                k = SL_TEXT
            else:
                k = SL_ATTR
            end
        else ai >= 0 and sm.LayoutAttrDest(ai) == sm.LA_SOURCE:
            k = SL_URL
        else ai >= 0 and (sm.LayoutAttrDest(ai) == sm.LA_CSS or sm.LayoutAttrDest(ai) == sm.LA_STYLE):
            vt := sm.LayoutAttrVtype(ai)
            k = (vt == sm.VT_URL or vt == sm.VT_ABS_URL or vt == sm.VT_REL_URL) ? SL_CSSURL : SL_CSS
        else ai >= 0 and sm.LayoutAttrDest(ai) == sm.LA_HTML_OR_CSS:
            vt := sm.LayoutAttrVtype(ai)
            k = (vt == sm.VT_URL or vt == sm.VT_ABS_URL or vt == sm.VT_REL_URL) ? SL_CSSURL : SL_CSS
        else ai >= 0 and (sm.LayoutAttrVtype(ai) == sm.VT_BOOL or sm.LayoutAttrVtype(ai) == sm.VT_BOOL_ENUM):
            k = SL_BOOL
        else:
            k = SL_ATTR
        end
    end
    mut sl := LoSlot { kind = k, expr = vid }
    if k == SL_BOOL:
        sl.out = lo_bool_out(ei, an.name)
    end
    mark := lo_add_slot(lw, a, vid, sl)
    mut n2 := at.Get(a, attr)
    n2.a = mark
    at.Put(a, attr, n2)
end

func lo_walk(lw &: LoLower, a &: at.Ast, container: int, el: int, ei: int):
    repeat at.ChildCount(a, container) in i:
        cid := at.Child(a, container, i)
        k := at.KindOf(a, cid)
        if k == at.AST_LAYOUT_ATTR:
            lo_value(lw, a, cid, el, ei)
        else k == at.AST_LAYOUT_ELEMENT:
            lo_walk(lw, a, cid, cid, sm.LayoutElemOf(a, cid))
        else k == at.AST_IF:
            lo_walk_if(lw, a, cid, el, ei)
        else k == at.AST_EACH:
            n := at.Get(a, cid)
            sl := LoSlot { kind = SL_EACH, expr = n.a, item = n.name, key = n.c }
            mark := lo_add_slot(lw, a, cid, sl)
            mut nn := at.Get(a, cid)
            nn.a = mark
            at.Put(a, cid, nn)
            lw.shadow.Push(n.name)
            if n.c != 0:
                lw.shadow.Push(at.Get(a, n.c).name)
            end
            lw.loop++
            lo_walk(lw, a, n.b, el, ei)
            lw.loop--
            _p1 := lw.shadow.Pop()
            if n.c != 0:
                _p2 := lw.shadow.Pop()
            end
        end
    end
end

func lo_walk_if(lw &: LoLower, a &: at.Ast, nid: int, el: int, ei: int):
    n := at.Get(a, nid)
    if n.synthetic and str.Equals(n.name, "__salam_component"):
        if not str.StartsWith(val_str(a, n.a), "<!--salam:"):
            lo_walk(lw, a, n.b, el, ei)
        end
        ret
    end
    sl := LoSlot { kind = SL_IF, expr = n.a }
    mark := lo_add_slot(lw, a, nid, sl)
    mut nn := at.Get(a, nid)
    nn.a = mark
    at.Put(a, nid, nn)
    lo_walk(lw, a, n.b, el, ei)
    if n.c != 0:
        if at.KindOf(a, n.c) == at.AST_IF:
            lo_walk_if(lw, a, n.c, el, ei)
        else:
            lo_walk(lw, a, n.c, el, ei)
        end
    end
end

func lo_parse_text(log: lg.Logger, a &: at.Ast, text: str, path: str): int:
    mut sf := src.New()
    sf.path = path
    sf.text = text
    sf.len = text.Len()
    quiet := lg.New(lg.LOG_OFF, false)
    mut toks := tok.StreamNew(path)
    ok := lx.Run(quiet, lp.Load("en"), sf, toks)
    mut prog := 0
    if ok:
        _ps := ps.Run(quiet, toks, a, prog)
    end
    tok.StreamFree(toks)
    if prog == 0:
        lg.Log(log, lg.PH_DRIVER, lg.LOG_ERROR, i18.Tr("internal: could not build the runtime layout function"))
    end
    ret prog
end

func lo_web_call(lw &: LoLower, fn_name: str, arg: str): str:
    ret lw.web + "." + fn_name + "(_salam_b, " + arg + ")\n"
end

func lo_slot_writer(kind: int): str:
    if kind == SL_URL:
        ret "PageUrl"
    end
    if kind == SL_CSS:
        ret "PageCss"
    end
    if kind == SL_CSSURL:
        ret "PageCssUrl"
    end
    ret "PageText"
end

func lo_marker_at(doc: str, p: int, tag &: str, num &: int): int:
    close := str.IndexFrom(doc, char_from_code(3), p)
    if close < 0:
        ret 0 - 1
    end
    inner := str.Substr(doc, p + 1, close - p - 1)
    if not str.StartsWith(inner, "salam-"):
        ret 0 - 1
    end
    rest := str.Substr(inner, 6, str.Len(inner) - 6)
    dash := str.IndexOf(rest, "-")
    if dash < 0:
        tag = rest
        num = 0 - 1
    else:
        tag = str.Substr(rest, 0, dash)
        num = str.Substr(rest, dash + 1, str.Len(rest) - dash - 1).ToInt()
    end
    ret close + 1
end

func lo_build_source(lw &: LoLower, doc: str, chunks &: Vector<str>): str:
    mut body := "mut _salam_b := " + lw.web + ".PageBegin()\n"
    repeat lw.slots.Len() in bi:
        bs := lw.slots.Get(bi)
        if bs.kind == SL_BAD and bs.loop == 0:
            body += "_salam_v" + co.U64Toa(bi as u64) + " := __salam_dyn_" + co.U64Toa(bi as u64) + "\n"
        end
    end
    mut p := 0
    mut start := 0
    mut seq := 0
    n := str.Len(doc)
    stx := char_from_code(2)
    until p < n:
        q := str.IndexFrom(doc, stx, p)
        if q < 0:
            break
        end
        mut tag := ""
        mut num := 0
        after := lo_marker_at(doc, q, tag, num)
        if after < 0:
            p = q + 1
            continue
        end
        if q > start:
            body += lo_web_call(lw, "PageStatic", "__salam_chunk_" + co.U64Toa(chunks.Len() as u64))
            chunks.Push(str.Substr(doc, start, q - start))
        end
        if (str.Equals(tag, "dyn") or str.Equals(tag, "bad")) and num >= 0 and num < lw.slots.Len():
            sl := lw.slots.Get(num)
            vname := "_salam_v" + co.U64Toa(num as u64)
            if sl.kind == SL_IF:
                body += "if __salam_dyn_" + co.U64Toa(num as u64) + ":\n"
            else sl.kind == SL_EACH:
                mut head := "each "
                if sl.key != 0:
                    head += "__salam_key_" + co.U64Toa(num as u64) + ", "
                end
                body += head + "__salam_item_" + co.U64Toa(num as u64) + " in __salam_dyn_" + co.U64Toa(num as u64) + ":\n"
            else sl.kind == SL_STD:
                seq++
                lvname := vname + "_" + co.U64Toa(seq as u64)
                body += lvname + " := __salam_dyn_" + co.U64Toa(num as u64) + "\n"
                body += lo_web_call(lw, "PageStyle", co.I64Toa(sl.prop as i64) + ", " + co.I64Toa(sl.state as i64) + ", " + lvname)
            else sl.kind == SL_BAD:
                if sl.loop > 0:
                    body += vname + " := __salam_dyn_" + co.U64Toa(num as u64) + "\n"
                end
            else sl.kind == SL_BOOL:
                seq++
                lvname := vname + "_" + co.U64Toa(seq as u64)
                body += lvname + " := __salam_dyn_" + co.U64Toa(num as u64) + "\n"
                body += "if " + lvname + ":\n"
                body += lo_web_call(lw, "PageStatic", "__salam_chunk_" + co.U64Toa(chunks.Len() as u64))
                chunks.Push(" " + sl.out)
                body += "end\n"
            else:
                seq++
                lvname := vname + "_" + co.U64Toa(seq as u64)
                body += lvname + " := __salam_dyn_" + co.U64Toa(num as u64) + "\n"
                body += lo_web_call(lw, lo_slot_writer(sl.kind), lvname)
            end
        else str.Equals(tag, "else"):
            body += "else:\n"
        else str.Equals(tag, "end"):
            body += "end\n"
        end
        p = after
        start = after
    end
    if start < n:
        body += lo_web_call(lw, "PageStatic", "__salam_chunk_" + co.U64Toa(chunks.Len() as u64))
        chunks.Push(str.Substr(doc, start, n - start))
    end
    body += "ret " + lw.web + ".PageEnd(_salam_b)\n"
    ret "import " + lw.web + "\n\npure func __salam_view(): str:\n" + body + "end\n"
end

func lo_placeholder_num(name: str, prefix: str): int:
    if not str.StartsWith(name, prefix):
        ret 0 - 1
    end
    mut stop := str.Len(prefix)
    until stop < str.Len(name) and byte_at(name, stop) >= 48 and byte_at(name, stop) <= 57:
        stop++
    end
    ret str.Substr(name, str.Len(prefix), stop - str.Len(prefix)).ToInt()
end

func lo_splice(lw &: LoLower, a &: at.Ast, nid: int, chunks: Vector<str>, from: int): int:
    if nid == 0:
        ret 0
    end
    n := at.Get(a, nid)
    if n.kind == at.AST_IDENTIFIER:
        c := lo_placeholder_num(n.name, "__salam_chunk_")
        if c >= 0 and c < chunks.Len():
            ret mk_str(a, chunks.Get(c), from)
        end
        d := lo_placeholder_num(n.name, "__salam_dyn_")
        if d >= 0 and d < lw.slots.Len():
            ret lw.slots.Get(d).expr
        end
        ret nid
    end
    mut m := at.Get(a, nid)
    m.a = lo_splice(lw, a, n.a, chunks, from)
    m.b = lo_splice(lw, a, n.b, chunks, from)
    m.c = lo_splice(lw, a, n.c, chunks, from)
    m.d = lo_splice(lw, a, n.d, chunks, from)
    repeat n.list.Len() in i:
        m.list.Set(i, lo_splice(lw, a, n.list.Get(i), chunks, from))
    end
    if n.kind == at.AST_EACH:
        it := lo_placeholder_num(n.name, "__salam_item_")
        if it >= 0 and it < lw.slots.Len():
            sl := lw.slots.Get(it)
            m.name = sl.item
            if sl.key != 0:
                m.c = sl.key
            end
        end
    end
    if n.kind == at.AST_EXPR_STMT or n.kind == at.AST_RETURN:
        m.view_glue = true
    end
    if n.kind == at.AST_VAR_DECL and str.Equals(n.name, "_salam_b"):
        m.view_glue = true
    end
    at.Put(a, nid, m)
    ret nid
end

func lo_span_tree(a &: at.Ast, nid: int, from: int, base: int):
    if nid < base:
        ret
    end
    n := at.Get(a, nid)
    copy_span(a, nid, from)
    lo_span_tree(a, n.a, from, base)
    lo_span_tree(a, n.b, from, base)
    lo_span_tree(a, n.c, from, base)
    lo_span_tree(a, n.d, from, base)
    lo_span_tree(a, n.ty, from, base)
    repeat n.list.Len() in i:
        lo_span_tree(a, n.list.Get(i), from, base)
    end
end

func lo_glue_slot(a &: at.Ast, nid: int): int:
    if nid == 0:
        ret 0 - 1
    end
    n := at.Get(a, nid)
    if n.kind == at.AST_IDENTIFIER:
        ret lo_placeholder_num(n.name, "_salam_v")
    end
    if n.kind == at.AST_BLOCK:
        ret 0 - 1
    end
    mut r := lo_glue_slot(a, n.a)
    if r < 0:
        r = lo_glue_slot(a, n.b)
    end
    if r < 0:
        repeat n.list.Len() in i:
            if r < 0:
                r = lo_glue_slot(a, n.list.Get(i))
            end
        end
    end
    ret r
end

func lo_fix_glue_spans(lw &: LoLower, a &: at.Ast, nid: int, base: int):
    if nid == 0:
        ret
    end
    n := at.Get(a, nid)
    if n.kind == at.AST_BLOCK:
        repeat n.list.Len() in i:
            lo_fix_glue_spans(lw, a, n.list.Get(i), base)
        end
        ret
    end
    if n.kind == at.AST_IF or n.kind == at.AST_EACH or n.kind == at.AST_EXPR_STMT:
        k := lo_glue_slot(a, n.kind == at.AST_EXPR_STMT ? nid : n.a)
        if k >= 0 and k < lw.slots.Len():
            lo_span_tree_shallow(a, nid, lw.slots.Get(k).expr, base)
        end
    end
    if n.kind == at.AST_IF or n.kind == at.AST_EACH:
        lo_fix_glue_spans(lw, a, n.b, base)
        lo_fix_glue_spans(lw, a, n.c, base)
    end
end

func lo_span_tree_shallow(a &: at.Ast, nid: int, from: int, base: int):
    if nid < base:
        ret
    end
    n := at.Get(a, nid)
    copy_span(a, nid, from)
    if n.kind == at.AST_BLOCK:
        ret
    end
    lo_span_tree_shallow(a, n.a, from, base)
    if n.kind != at.AST_IF and n.kind != at.AST_EACH:
        lo_span_tree_shallow(a, n.b, from, base)
        repeat n.list.Len() in i:
            lo_span_tree_shallow(a, n.list.Get(i), from, base)
        end
    end
end

func lo_collect_funcs(lw &: LoLower, a &: at.Ast, prog: int):
    repeat at.ChildCount(a, prog) in i:
        d := at.Get(a, at.Child(a, prog, i))
        if d.kind == at.AST_FUNC_DEF and str.Len(d.name) > 0:
            lw.funcs.Push(d.name)
        end
    end
end

func lo_shadow_globals(lw &: LoLower, a &: at.Ast, prog: int):
    repeat at.ChildCount(a, prog) in i:
        d := at.Get(a, at.Child(a, prog, i))
        if d.kind == at.AST_VAR_DECL and d.is_mut and str.Len(d.name) > 0:
            lw.shadow.Push(d.name)
        end
    end
end

func lo_lower_one(
    log: lg.Logger, pack: lp.Langpack, ct: cc.Table, a &: at.Ast, prog: int, lb: int, file: str, imp &: int, fragment: bool
): int:
    g_lo_root_file = file
    g_lo_expand_errors += ExpandBlock(log, pack, ct, a, prog, lb, lo_dir_of(file))
    if str.Equals(lp.Code(pack), "en"):
        g_lo_expand_errors += sm.LayoutSpellingLower(log, a, prog, lb, file)
    end
    sm.LayoutResolve(a, lb)
    mut lw := LoLower { prog = prog }
    lw.web = lo_web_pkg(pack)
    defer lw.slots.Free()
    defer lw.shadow.Free()
    defer lw.funcs.Free()
    lo_collect_funcs(lw, a, prog)
    lbn := at.Get(a, lb)
    if lbn.b != 0:
        repeat at.ChildCount(a, lbn.b) in pi:
            lw.shadow.Push(at.Get(a, at.Child(a, lbn.b, pi)).name)
        end
    end
    native := str.Equals(lbn.name, NATIVE_PAGE_VIEW)
    if native:
        lo_shadow_globals(lw, a, prog)
    end
    lo_walk(lw, a, lb, 0, 0 - 1)
    mut quiet := dg.NewDefault(0, false, 0)
    g_lo_cls_prefix = fragment ? hyphenate(str.Lower(lbn.name)) + "-" : ""
    r := Generate(log, quiet, file, a, lb, true, lp.Code(pack))
    g_lo_cls_prefix = ""
    mut doc := ""
    if fragment:
        if str.Len(r.css) > 0:
            doc = "<style>" + r.css + "</style>"
        end
        doc += r.html
        if str.Len(r.js) > 0:
            doc += "<script>" + r.js + "</script>"
        end
    else:
        doc = Document(r, true, "", "", true)
    end
    mut chunks := Vector {} as Vector<str>
    defer chunks.Free()
    text := lo_build_source(lw, doc, chunks)
    base := at.Count(a)
    sp := lo_parse_text(log, a, text, file)
    if sp == 0:
        ret 0
    end
    mut fid := 0
    repeat at.ChildCount(a, sp) in ci:
        cid := at.Child(a, sp, ci)
        ck := at.KindOf(a, cid)
        if ck == at.AST_IMPORT and imp == 0:
            imp = cid
        else ck == at.AST_FUNC_DEF:
            fid = cid
        end
    end
    if fid == 0:
        ret 0
    end
    fnode := at.Get(a, fid)
    body := lo_splice(lw, a, fnode.a, chunks, lb)
    lo_span_tree(a, fid, lb, base)
    lo_fix_glue_spans(lw, a, body, base)
    mut fn := at.Get(a, fid)
    fn.name = lbn.name
    fn.a = body
    fn.is_pure = not native
    mut params := Vector {} as Vector<int>
    if lbn.b != 0:
        repeat at.ChildCount(a, lbn.b) in pj:
            params.Push(at.Child(a, lbn.b, pj))
        end
    end
    mut oldp := fn.list
    fn.list = params
    oldp.Free()
    fn.file_boundary = true
    at.Put(a, fid, fn)
    if fn.ty != 0 and str.Equals(lp.Code(pack), "fa"):
        at.SetName(a, fn.ty, "رشته")
    end
    mut lbm := at.Get(a, lb)
    lbm.view_glue = true
    at.Put(a, lb, lbm)
    ret fid
end

func lo_all_typed(a &: at.Ast, cid: int): bool:
    mut n := 0
    repeat at.ChildCount(a, cid) in i:
        p := at.Get(a, at.Child(a, cid, i))
        if p.kind == at.AST_PARAM:
            if p.ty == 0:
                ret false
            end
            n++
        end
    end
    ret n > 0
end

func lo_fragment_block(a &: at.Ast, cid: int): int:
    c := at.Get(a, cid)
    lb := at.NewNode(a, at.AST_LAYOUT_BLOCK)
    copy_span(a, lb, cid)
    params := at.NewNode(a, at.AST_BLOCK)
    copy_span(a, params, cid)
    repeat at.ChildCount(a, cid) in i:
        pid := at.Child(a, cid, i)
        if at.KindOf(a, pid) == at.AST_PARAM:
            at.AddChild(a, params, at.Clone(a, pid))
        end
    end
    if c.a != 0:
        repeat at.ChildCount(a, c.a) in j:
            at.AddChild(a, lb, at.Clone(a, at.Child(a, c.a, j)))
        end
    end
    mut ln := at.Get(a, lb)
    ln.name = c.name
    ln.b = params
    at.Put(a, lb, ln)
    ret lb
end

func lo_web_pkg(pack: lp.Langpack): str:
    ret str.Equals(lp.Code(pack), "fa") ? "وب" : "web"
end

func lo_has_import(a &: at.Ast, prog: int, name: str): bool:
    repeat at.ChildCount(a, prog) in i:
        d := at.Get(a, at.Child(a, prog, i))
        if d.kind == at.AST_IMPORT and str.Equals(d.name, name):
            ret true
        end
    end
    ret false
end

func lo_has_lambda(a &: at.Ast, nid: int): bool:
    if nid == 0:
        ret false
    end
    n := at.Get(a, nid)
    if n.kind == at.AST_LAMBDA:
        ret true
    end
    if lo_has_lambda(a, n.a) or lo_has_lambda(a, n.b) or lo_has_lambda(a, n.c) or lo_has_lambda(a, n.d):
        ret true
    end
    each c in n.list:
        if lo_has_lambda(a, c):
            ret true
        end
    end
    ret false
end

func lo_env_decl_text(): str:
    mut t := "mut envx_dark := false\nmut envx_light := true\nmut envx_touch := false\nmut envx_mouse := true\n"
    t += "mut envx_reduced := false\nmut envx_contrast := false\nmut envx_rtl := false\nmut envx_ltr := true\n"
    t += "mut envx_w := 1024\nmut envx_h := 768\nmut envx_compact := false\nmut envx_regular := true\nmut envx_wide := false\n"
    t += "mut envx_landscape := true\nmut envx_portrait := false\n"
    ret t
end

func lo_em_rules(a &: at.Ast, owner: int, compact: bool): str:
    sel := char_from_code(29)
    mut out := ""
    repeat g_lo_em_lb.Len() in i:
        if g_lo_em_lb.Get(i) != owner:
            continue
        end
        sa := sm.ResolveStyleAttr(at.Get(a, g_lo_em_attr.Get(i)).name)
        if not sa.ok:
            continue
        end
        mut v := style.Value {}
        text := sm.StyleAttrTextFor(a, g_lo_em_val.Get(i), sa.prop)
        if not style.Parse(sa.prop, text, v):
            continue
        end
        decl := style.Css(sa.prop, v)
        q := g_lo_em_query.Get(i)
        ssel := sel + lo_state_suffix(sa.state)
        if compact:
            out += "@media " + q + "{" + ssel + "{" + decl + "}}"
        else:
            out += "@media " + q + " { " + ssel + " { " + decl + "; } }"
        end
    end
    ret out
end

func lo_em_reset():
    g_lo_em_lb.Clear()
    g_lo_em_attr.Clear()
    g_lo_em_query.Clear()
    g_lo_em_val.Clear()
end

func lo_em_static(a &: at.Ast, prog: int, id: int): bool:
    if id == 0:
        ret false
    end
    n := at.Get(a, id)
    if n.kind == at.AST_LITERAL:
        ret true
    end
    if n.kind == at.AST_UNARY:
        ret lo_em_static(a, prog, n.a)
    end
    if n.kind == at.AST_TUPLE or n.kind == at.AST_ARRAY_LIT:
        repeat at.ChildCount(a, id) in i:
            if not lo_em_static(a, prog, at.Child(a, id, i)):
                ret false
            end
        end
        ret true
    end
    if n.kind == at.AST_IDENTIFIER:
        if str.StartsWith(n.name, "__salam") or str.StartsWith(n.name, "envx_"):
            ret false
        end
        repeat at.ChildCount(a, prog) in j:
            d := at.Get(a, at.Child(a, prog, j))
            if (d.kind == at.AST_VAR_DECL or d.kind == at.AST_CONST_DECL) and str.Equals(d.name, n.name):
                ret false
            end
        end
        ret true
    end
    ret false
end

func lo_em_group(q: str): str:
    if str.StartsWith(q, "(") and str.EndsWith(q, ")") and str.IndexOf(q, ") and (") < 0 and str.IndexOf(q, ") or (") < 0:
        ret q
    end
    ret "(" + q + ")"
end

func lo_em_word(name: str): str:
    if str.Equals(name, "envx_compact"):
        ret "(width < 600px)"
    end
    if str.Equals(name, "envx_regular"):
        ret "(600px <= width <= 1024px)"
    end
    if str.Equals(name, "envx_wide"):
        ret "(width > 1024px)"
    end
    if str.Equals(name, "envx_landscape"):
        ret "(orientation: landscape)"
    end
    if str.Equals(name, "envx_portrait"):
        ret "(orientation: portrait)"
    end
    if str.Equals(name, "envx_dark"):
        ret "(prefers-color-scheme: dark)"
    end
    if str.Equals(name, "envx_light"):
        ret "(prefers-color-scheme: light)"
    end
    if str.Equals(name, "envx_touch"):
        ret "(pointer: coarse)"
    end
    if str.Equals(name, "envx_mouse"):
        ret "(pointer: fine)"
    end
    if str.Equals(name, "envx_reduced"):
        ret "(prefers-reduced-motion: reduce)"
    end
    if str.Equals(name, "envx_contrast"):
        ret "(prefers-contrast: more)"
    end
    ret ""
end

func lo_em_side(a &: at.Ast, id: int): str:
    n := at.Get(a, id)
    if n.kind == at.AST_IDENTIFIER and str.Equals(n.name, "envx_w"):
        ret "width"
    end
    if n.kind == at.AST_IDENTIFIER and str.Equals(n.name, "envx_h"):
        ret "height"
    end
    if n.kind == at.AST_LITERAL and n.value_kind == tok.TV_INT:
        ret co.U64Toa(n.value_int) + "px"
    end
    ret ""
end

func lo_em_query(a &: at.Ast, id: int): str:
    if id == 0:
        ret ""
    end
    n := at.Get(a, id)
    if n.kind == at.AST_IDENTIFIER:
        ret lo_em_word(n.name)
    end
    if n.kind == at.AST_UNARY and n.op == tok.TK_NOT:
        q := lo_em_query(a, n.a)
        ret str.Len(q) > 0 ? "not " + lo_em_group(q) : ""
    end
    if n.kind != at.AST_BINARY:
        ret ""
    end
    if n.op == tok.TK_AND or n.op == tok.TK_OR:
        l := lo_em_query(a, n.a)
        r := lo_em_query(a, n.b)
        if str.Len(l) == 0 or str.Len(r) == 0:
            ret ""
        end
        ret lo_em_group(l) + (n.op == tok.TK_AND ? " and " : " or ") + lo_em_group(r)
    end
    mut op := ""
    if n.op == tok.TK_LT:
        op = " < "
    else n.op == tok.TK_GT:
        op = " > "
    else n.op == tok.TK_LE:
        op = " <= "
    else n.op == tok.TK_GE:
        op = " >= "
    end
    l2 := lo_em_side(a, n.a)
    r2 := lo_em_side(a, n.b)
    if str.Len(op) == 0 or str.Len(l2) == 0 or str.Len(r2) == 0:
        if n.op == tok.TK_EQ and str.Len(l2) > 0 and str.Len(r2) > 0:
            if str.EndsWith(r2, "px") and not str.EndsWith(l2, "px"):
                ret "(" + l2 + ": " + r2 + ")"
            end
        end
        ret ""
    end
    if str.EndsWith(l2, "px") == str.EndsWith(r2, "px"):
        ret ""
    end
    ret "(" + l2 + op + r2 + ")"
end

func lo_em_decls(a &: at.Ast, nid: int, names &: Vector<str>):
    if nid == 0:
        ret
    end
    n := at.Get(a, nid)
    if (n.kind == at.AST_VAR_DECL or n.kind == at.AST_EACH or n.kind == at.AST_PARAM) and str.Len(n.name) > 0:
        names.Push(n.name)
    end
    if n.kind == at.AST_EACH and n.c != 0 and at.KindOf(a, n.c) == at.AST_IDENTIFIER:
        names.Push(at.Get(a, n.c).name)
    end
    if n.kind == at.AST_LAYOUT_ATTR:
        ret
    end
    lo_em_decls(a, n.b, names)
    lo_em_decls(a, n.c, names)
    repeat n.list.Len() in i:
        lo_em_decls(a, n.list.Get(i), names)
    end
end

func lo_em_names_hit(a &: at.Ast, id: int, names: Vector<str>): bool:
    if id == 0:
        ret false
    end
    n := at.Get(a, id)
    if n.kind == at.AST_IDENTIFIER:
        each d in names:
            if str.Equals(d, n.name):
                ret true
            end
        end
        ret false
    end
    if lo_em_names_hit(a, n.a, names) or lo_em_names_hit(a, n.b, names):
        ret true
    end
    repeat n.list.Len() in i:
        if lo_em_names_hit(a, n.list.Get(i), names):
            ret true
        end
    end
    ret false
end

func lo_em_value_ok(a &: at.Ast, prog: int, id: int, names: Vector<str>, prop: int): bool:
    if not lo_em_static(a, prog, id):
        ret false
    end
    if lo_em_names_hit(a, id, names):
        ret false
    end
    mut v := style.Value {}
    ret style.Parse(prop, sm.StyleAttrTextFor(a, id, prop), v)
end

func lo_em_owner(a &: at.Ast, prog: int, owner: int, names: Vector<str>):
    mut kept := Vector {} as Vector<int>
    mut changed := false
    repeat at.ChildCount(a, owner) in i:
        aid := at.Child(a, owner, i)
        an := at.Get(a, aid)
        if an.kind != at.AST_LAYOUT_ATTR or an.a == 0 or at.KindOf(a, an.a) != at.AST_TERNARY or not sm.ResolveStyleAttr(an.name).ok:
            kept.Push(aid)
            continue
        end
        sa0 := sm.ResolveStyleAttr(an.name)
        mut queries := Vector {} as Vector<str>
        mut vals := Vector {} as Vector<int>
        mut cur := an.a
        mut ok := true
        mut blocked := ""
        until at.KindOf(a, cur) == at.AST_TERNARY:
            t := at.Get(a, cur)
            q := lo_em_query(a, t.a)
            if str.Len(q) == 0:
                ok = false
                break
            end
            empty := sm.LayoutHasEmptyFallback(a, cur) and str.Len(val_str(a, t.b)) == 0
            if not empty and not lo_em_value_ok(a, prog, t.b, names, sa0.prop):
                ok = false
                break
            end
            if not empty:
                queries.Push(str.Len(blocked) > 0 ? lo_em_group(q) + " and " + blocked : q)
                vals.Push(t.b)
            end
            nq := "not " + lo_em_group(q)
            blocked = str.Len(blocked) > 0 ? lo_em_group(blocked) + " and " + lo_em_group(nq) : nq
            cur = t.c
        end
        base_empty := sm.LayoutHasEmptyFallback(a, an.a) and str.Len(val_str(a, cur)) == 0
        if ok and not base_empty and not lo_em_value_ok(a, prog, cur, names, sa0.prop):
            ok = false
        end
        if ok and sa0.state != 0 and str.Len(lo_state_suffix(sa0.state)) == 0:
            ok = false
        end
        if not ok:
            queries.Free()
            vals.Free()
            kept.Push(aid)
            continue
        end
        mut k := queries.Len() - 1
        until k >= 0:
            g_lo_em_lb.Push(owner)
            g_lo_em_attr.Push(aid)
            g_lo_em_query.Push(queries.Get(k))
            g_lo_em_val.Push(vals.Get(k))
            k--
        end
        queries.Free()
        vals.Free()
        changed = true
        if base_empty:
            continue
        end
        mut n2 := at.Get(a, aid)
        n2.a = cur
        at.Put(a, aid, n2)
        kept.Push(aid)
    end
    if changed:
        mut bn := at.Get(a, owner)
        mut old := bn.list
        bn.list = kept
        at.Put(a, owner, bn)
        old.Free()
    else:
        kept.Free()
    end
end

func lo_em_walk(a &: at.Ast, prog: int, nid: int, names: Vector<str>):
    if nid == 0:
        ret
    end
    n := at.Get(a, nid)
    if n.kind == at.AST_LAYOUT_ELEMENT:
        lo_em_owner(a, prog, nid, names)
    end
    if n.kind == at.AST_IF or n.kind == at.AST_EACH:
        lo_em_walk(a, prog, n.b, names)
        lo_em_walk(a, prog, n.c, names)
        ret
    end
    if n.kind != at.AST_LAYOUT_ELEMENT and n.kind != at.AST_LAYOUT_BLOCK and n.kind != at.AST_BLOCK:
        ret
    end
    m := at.Get(a, nid)
    repeat m.list.Len() in i:
        lo_em_walk(a, prog, m.list.Get(i), names)
    end
end

func lo_env_media(a &: at.Ast, prog: int):
    lb := find_layout_block(a, prog)
    if lb == 0:
        ret
    end
    mut names := Vector {} as Vector<str>
    defer names.Free()
    lo_em_decls(a, lb, names)
    lo_em_owner(a, prog, lb, names)
    lo_em_walk(a, prog, lb, names)
end

func lo_env_inject(log: lg.Logger, a &: at.Ast, prog: int):
    if prog == 0 or not ps.EnvInProgram(a, prog):
        ret
    end
    if not sm.LayoutNativeTarget():
        lo_env_media(a, prog)
        if not ps.EnvInProgram(a, prog):
            ret
        end
    end
    repeat at.ChildCount(a, prog) in i:
        d := at.Get(a, at.Child(a, prog, i))
        if d.kind == at.AST_VAR_DECL and str.Equals(d.name, "envx_w"):
            ret
        end
    end
    snippet := ln_parse(log, a, lo_env_decl_text(), "<salam-env>", lp.Load("en"))
    if snippet == 0:
        ret
    end
    repeat at.ChildCount(a, snippet) in j:
        sid := at.Child(a, snippet, j)
        at.AddChild(a, prog, sid)
        g_lo_env_nodes.Push(sid)
        g_lo_env_injected = true
    end
end

func lo_env_order(a &: at.Ast, prog: int):
    if g_lo_env_nodes.Len() == 0:
        ret
    end
    mut mine := Vector {} as Vector<int>
    defer mine.Free()
    mut rest := Vector {} as Vector<int>
    defer rest.Free()
    repeat at.ChildCount(a, prog) in i:
        id := at.Child(a, prog, i)
        mut is_mine := false
        each e in g_lo_env_nodes:
            if e == id:
                is_mine = true
            end
        end
        if is_mine:
            mine.Push(id)
        else:
            rest.Push(id)
        end
    end
    mut order := Vector {} as Vector<int>
    defer order.Free()
    each id in rest:
        kd := at.KindOf(a, id)
        if kd == at.AST_IMPORT or kd == at.AST_LINK or (kd == at.AST_FUNC_DEF and at.Get(a, id).is_extern):
            order.Push(id)
        end
    end
    each id in mine:
        if at.KindOf(a, id) == at.AST_IMPORT:
            order.Push(id)
        end
    end
    each id in mine:
        if at.KindOf(a, id) == at.AST_VAR_DECL and not str.Equals(at.Get(a, id).name, "envx_hook"):
            order.Push(id)
        end
    end
    each id in rest:
        kd := at.KindOf(a, id)
        if not (kd == at.AST_IMPORT or kd == at.AST_LINK or (kd == at.AST_FUNC_DEF and at.Get(a, id).is_extern)):
            order.Push(id)
        end
    end
    each id in mine:
        kd := at.KindOf(a, id)
        if kd != at.AST_IMPORT and kd != at.AST_VAR_DECL:
            order.Push(id)
        end
    end
    each id in mine:
        if str.Equals(at.Get(a, id).name, "envx_hook"):
            order.Push(id)
        end
    end
    mut pn := at.Get(a, prog)
    pn.list = Vector {} as Vector<int>
    each id in order:
        pn.list.Push(id)
    end
    at.Put(a, prog, pn)
    g_lo_env_nodes.Clear()
end

func lo_prepare_views(log: lg.Logger, pack: lp.Langpack, ct: cc.Table, a &: at.Ast, prog: int, file: str): int:
    if prog == 0:
        ret 0
    end
    mut views := Vector {} as Vector<int>
    defer views.Free()
    repeat at.ChildCount(a, prog) in i:
        did := at.Child(a, prog, i)
        d := at.Get(a, did)
        if d.kind == at.AST_LAYOUT_BLOCK and str.Len(d.name) > 0 and not d.view_glue:
            views.Push(did)
        end
    end
    mut frags := Vector {} as Vector<int>
    defer frags.Free()
    repeat at.ChildCount(a, prog) in ci:
        cid := at.Child(a, prog, ci)
        c := at.Get(a, cid)
        if c.kind == at.AST_LAYOUT_COMPONENT and not c.view_glue and lo_all_typed(a, cid) and not lo_has_decls(a, c.a) and not lo_has_lambda(a, c.a):
            frags.Push(cid)
        end
    end
    if views.Len() == 0 and frags.Len() == 0:
        ret 0
    end
    mut imp := 0
    mut fns := Vector {} as Vector<int>
    defer fns.Free()
    repeat views.Len() in v:
        fid := lo_lower_one(log, pack, ct, a, prog, views.Get(v), file, imp, false)
        if fid != 0:
            fns.Push(fid)
        end
    end
    repeat frags.Len() in fi:
        cid2 := frags.Get(fi)
        mut cn := at.Get(a, cid2)
        cn.view_glue = true
        at.Put(a, cid2, cn)
        flb := lo_fragment_block(a, cid2)
        fid2 := lo_lower_one(log, pack, ct, a, prog, flb, file, imp, true)
        if fid2 != 0:
            fns.Push(fid2)
        end
    end
    mut pn := at.Get(a, prog)
    mut list := Vector {} as Vector<int>
    if imp != 0 and not lo_has_import(a, prog, lo_web_pkg(pack)):
        list.Push(imp)
    end
    repeat pn.list.Len() in k:
        list.Push(pn.list.Get(k))
    end
    repeat fns.Len() in f:
        list.Push(fns.Get(f))
    end
    mut old := pn.list
    pn.list = list
    at.Put(a, prog, pn)
    old.Free()
    ret fns.Len()
end

pub func PrepareViews(log: lg.Logger, pack: lp.Langpack, ct: cc.Table, a &: at.Ast, prog: int, file: str): int:
    lo_env_inject(log, a, prog)
    r := lo_prepare_views(log, pack, ct, a, prog, file)
    if prog != 0:
        lo_env_order(a, prog)
    end
    ret r
end
