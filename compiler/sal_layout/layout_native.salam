pub const NATIVE_PAGE_VIEW := "__salam_page"

struct LnNames:
    pub kw_func: str = "func"
    pub kw_end: str = "end"
    pub kw_if: str = "if"
    pub kw_else: str = "else"
    pub kw_each: str = "each"
    pub kw_in: str = "in"
    pub kw_ret: str = "ret"
    pub kw_mut: str = "mut"
    pub kw_as: str = "as"
    pub kw_import: str = "import"
    pub kw_true: str = "true"
    pub kw_false: str = "false"
    pub sep: str = ", "
    pub entry: str = "main"
    pub import_ui: str = "gui.ui"
    pub import_style: str = "gui.style"
    pub ui: str = "ui"
    pub style: str = "style"
    pub builder: str = "Builder"
    pub patch: str = "Patch"
    pub no_patches: str = "NoPatches"
    pub run: str = "RunPage"
    pub open: str = "Open"
    pub close: str = "Close"
    pub set: str = "Set"
    pub set_text: str = "SetText"
    pub id: str = "Id"
    pub attr: str = "Attr"
    pub bool_attr: str = "BoolAttr"
    pub text: str = "Text"
    pub on: str = "On"
    pub title: str = "Title"
    pub lang: str = "Lang"
    pub dir: str = "Dir"
    pub scope: str = "Scope"
    pub keyed: str = "KeyedScope"
    pub key: str = "Key"
    pub reactive: str = "Reactive"
    pub instance: str = "Instance"
    pub fresh: str = "Fresh"
    pub site: str = "ScopeSite"
    pub touch: str = "TouchInstance"
    pub vec: str = "Vector"
    pub len: str = "len"
    pub push: str = "push"
    pub t_int: str = "int"
    pub t_i64: str = "i64"
    pub t_f64: str = "f64"
    pub t_str: str = "str"
    pub t_bool: str = "bool"
end

struct LnGen:
    pub lw: LoLower = LoLower {}
    pub cx: LoCtx = LoCtx {}
    pub out: str = ""
    pub depth: int = 1
    pub nm: LnNames = LnNames {}
    pub a_node: int = 0
    pub rx: LnReact = LnReact {}
    pub in_comp: int = 0
    pub row_keys: Vector<int> = Vector {}
end

func ln_names(pack: lp.Langpack): LnNames:
    mut n := LnNames {}
    if not str.Equals(lp.Code(pack), "fa"):
        ret n
    end
    n.import_ui = "رابط گرافیکی.رابط کاربری"
    n.import_style = "رابط گرافیکی.سبک"
    n.ui = "رابط کاربری"
    n.style = "سبک"
    n.builder = "سازنده‌صفحه"
    n.patch = "وصله عنصر"
    n.no_patches = "بی وصله"
    n.run = "اجرای صفحه"
    n.open = "گشودن عنصر"
    n.close = "بستن عنصر"
    n.set = "تنظیم سبک"
    n.set_text = "تنظیم سبک متنی"
    n.id = "شناسه عنصر"
    n.attr = "ویژگی عنصر"
    n.bool_attr = "ویژگی دودویی عنصر"
    n.text = "متن فرزند"
    n.on = "رسیدگی رخداد"
    n.title = "عنوان صفحه"
    n.lang = "زبان صفحه"
    n.dir = "جهت صفحه"
    n.scope = "دامنه واکنشی"
    n.keyed = "دامنه کلیددار"
    n.key = "کلید عنصر"
    n.reactive = "راه اندازی واکنش"
    n.instance = "نمونه بخش"
    n.fresh = "نمونه تازه"
    n.site = "جایگاه دامنه"
    n.touch = "لمس نمونه"
    n.vec = "وکتور"
    n.len = "طول"
    n.push = "بیفزا"
    n.t_int = "صحیح"
    n.t_i64 = "صحیح۶۴"
    n.t_f64 = "اعشار۶۴"
    n.t_str = "رشته"
    n.t_bool = "منطقی"
    n.entry = lp.Entry(pack)
    ret n
end

func ln_is_word_start(b: int): bool:
    ret (b >= 65 and b <= 90) or (b >= 97 and b <= 122) or b == 95
end

func ln_is_word(b: int): bool:
    ret ln_is_word_start(b) or (b >= 48 and b <= 57)
end

func ln_to_fa(text: str, fa: lp.Langpack): str:
    en := lp.Load("en")
    n := str.Len(text)
    mut out := str.NewBuilder()
    mut in_str := false
    mut i := 0
    until i < n:
        b := byte_at(text, i)
        if in_str:
            str.BufAppendChar(out, b)
            if b == 92 and i + 1 < n:
                i++
                str.BufAppendChar(out, byte_at(text, i))
            else b == 34:
                in_str = false
            end
            i++
            continue
        end
        if b == 34:
            in_str = true
            str.BufAppendChar(out, b)
            i++
            continue
        end
        if b == 44:
            str.BufAppend(out, "،")
            i++
            continue
        end
        if ln_is_word_start(b) and (i == 0 or not ln_is_word(byte_at(text, i - 1))):
            mut j := i
            until j < n and ln_is_word(byte_at(text, j)):
                j++
            end
            word := str.Substr(text, i, j - i)
            k := lp.LookupKeyword(en, word)
            sp := k != tok.TK_IDENT ? lp.Spelling(fa, k) : ""
            str.BufAppend(out, str.Len(sp) > 0 ? sp : word)
            i = j
            continue
        end
        str.BufAppendChar(out, b)
        i++
    end
    r := str.BufStr(out)
    str.BufFree(out)
    ret r
end

func ln_find_page(a &: at.Ast, prog: int): int:
    repeat at.ChildCount(a, prog) in i:
        did := at.Child(a, prog, i)
        d := at.Get(a, did)
        if d.kind == at.AST_LAYOUT_BLOCK and str.Len(d.name) == 0 and not d.view_glue:
            ret did
        end
    end
    ret 0
end

func ln_has_main(a &: at.Ast, prog: int, pack: lp.Langpack): bool:
    repeat at.ChildCount(a, prog) in i:
        d := at.Get(a, at.Child(a, prog, i))
        if d.kind == at.AST_FUNC_DEF and (str.Equals(d.name, "main") or lp.IdentEqual(d.name, lp.Entry(pack))):
            ret true
        end
    end
    ret false
end

func ln_handler_name(call: str): str:
    p := str.IndexOf(call, "(")
    if p <= 0:
        ret ""
    end
    if str.Equals(str.Substr(call, p, str.Len(call) - p), "()"):
        ret str.Substr(call, 0, p)
    end
    ret ""
end

func ln_quote(s: str): str:
    mut out := "\""
    repeat str.Len(s) in i:
        b := byte_at(s, i)
        if b == 34 or b == 92:
            out += "\\"
            out += str.Substr(s, i, 1)
        else b == 10:
            out += "\\n"
        else b == 13:
            out += "\\r"
        else b == 9:
            out += "\\t"
        else:
            out += str.Substr(s, i, 1)
        end
    end
    ret out + "\""
end

func ln_parse(log: lg.Logger, a &: at.Ast, text: str, path: str, pack: lp.Langpack): int:
    mut sf := src.New()
    sf.path = path
    sf.text = text
    sf.len = text.len()
    quiet := lg.New(lg.LOG_OFF, false)
    mut toks := tok.StreamNew(path)
    ok := lx.Run(quiet, pack, sf, toks)
    mut prog := 0
    if ok:
        _ps := ps.Run(quiet, toks, a, prog)
    end
    tok.StreamFree(toks)
    if prog == 0:
        lg.Log(log, lg.PH_DRIVER, lg.LOG_ERROR, "internal: could not build the native page program")
    end
    ret prog
end

func ln_line(g &: LnGen, text: str):
    mut pad := ""
    repeat g.depth:
        pad += "    "
    end
    g.out += pad + text + "\n"
end

func ln_call(g &: LnGen, method: str, args: str):
    ln_line(g, "__salam_b." + method + "(" + args + ")")
end

func ln_dyn_num(v: str): int:
    if not is_dyn(v):
        ret 0 - 1
    end
    p := str.IndexOf(v, char_from_code(2))
    mut tag := ""
    mut num := 0 - 1
    _e := lo_marker_at(v, p, tag, num)
    ret num
end

func ln_dyn_name(n: int): str:
    ret "__salam_dyn_" + co.U64Toa(n as u64)
end

func ln_str_expr(v: str): str:
    n := ln_dyn_num(v)
    if n >= 0:
        ret "(\"\" + " + ln_dyn_name(n) + ")"
    end
    ret ln_quote(v)
end

func ln_bool_expr(g &: LnGen, v: str): str:
    n := ln_dyn_num(v)
    if n >= 0:
        ret ln_dyn_name(n)
    end
    ret str.Equals(v, "false") ? g.nm.kw_false : g.nm.kw_true
end


func ln_event_name(out: str): str:
    if str.StartsWith(out, "on") and str.Len(out) > 2:
        ret str.Substr(out, 2, str.Len(out) - 2)
    end
    ret out
end

func ln_state_const(state: int): str:
    names := ["STATE_BASE", "STATE_HOVER", "STATE_FOCUS", "STATE_FOCUS_WITHIN", "STATE_ACTIVE", "STATE_DISABLED", "STATE_CHECKED", "STATE_INVALID", "STATE_PLACEHOLDER", "STATE_SELECTION"]
    if state < 0 or state >= len(names):
        ret "STATE_BASE"
    end
    ret names[state]
end

func ln_style_attrs(g &: LnGen, a &: at.Ast, el: int):
    repeat at.ChildCount(a, el) in i:
        aid := at.Child(a, el, i)
        an := at.Get(a, aid)
        if an.kind != at.AST_LAYOUT_ATTR or str.Len(an.name) == 0:
            continue
        end
        mut prop := 0
        mut state := 0
        if not sm.StyleAttrOf(aid, prop, state):
            continue
        end
        v := val_str(a, an.a)
        state_expr := g.nm.ui + "." + ln_state_const(state)
        ln_call(g, g.nm.set_text, state_expr + g.nm.sep + co.I64Toa(prop as i64) + g.nm.sep + ln_str_expr(v))
    end
end

func ln_attrs(g &: LnGen, a &: at.Ast, el: int, ei: int, tag: str):
    repeat at.ChildCount(a, el) in i:
        aid := at.Child(a, el, i)
        an := at.Get(a, aid)
        if an.kind != at.AST_LAYOUT_ATTR or str.Len(an.name) == 0:
            continue
        end
        nm := an.name
        mut sprop := 0
        mut sstate := 0
        if sm.StyleAttrOf(aid, sprop, sstate):
            continue
        end
        if sm.LayoutPseudoPrefixLen(nm) > 0:
            continue
        end
        if str.Equals(nm, "repeat"):
            continue
        end
        mut key := sm.LayoutAttrKey(nm)
        if str.Len(key) == 0:
            key = nm
        end
        ai := sm.LayoutAttrFor(ei, key)
        if ai < 0:
            continue
        end
        dest := sm.LayoutAttrDest(ai)
        vt := sm.LayoutAttrVtype(ai)
        if vt == sm.VT_CODE:
            num := ln_dyn_num(val_str(a, an.a))
            if num < 0 or num >= g.lw.slots.len():
                continue
            end
            ev := ln_quote(ln_event_name(sm.LayoutAttrOut(ai)))
            if at.KindOf(a, g.lw.slots.get(num).expr) == at.AST_LAMBDA:
                ln_call(g, g.nm.on, ev + g.nm.sep + ln_dyn_name(num))
            else:
                ln_call(g, g.nm.on, ev + g.nm.sep + "(): " + ln_dyn_name(num) + "() " + g.nm.kw_end)
            end
            continue
        end
        v := val_str(a, an.a)
        if dest == sm.LA_HTML:
            mut out := sm.LayoutAttrOut(ai)
            if str.IndexOf(out, "*") >= 0:
                out = hyphenate(nm)
            end
            if vt == sm.VT_BOOL or (vt == sm.VT_BOOL_ENUM and (str.Equals(v, "true") or str.Equals(v, "false") or is_dyn(v))):
                ln_call(g, g.nm.bool_attr, ln_quote(out) + g.nm.sep + ln_bool_expr(g, v))
            else str.Equals(out, "id"):
                ln_call(g, g.nm.id, ln_str_expr(v))
            else str.Equals(out, "data-key"):
                ln_call(g, g.nm.key, ln_str_expr(v))
            else:
                mv := is_dyn(v) ? v : attr_value_map(ai, v)
                ln_call(g, g.nm.attr, ln_quote(out) + g.nm.sep + ln_str_expr(mv))
            end
        else dest == sm.LA_SOURCE:
            ln_call(g, g.nm.attr, ln_quote(str.Equals(tag, "a") ? "href" : "src") + g.nm.sep + ln_str_expr(v))
        else dest == sm.LA_CLASS:
            ln_call(g, g.nm.attr, ln_quote("class") + g.nm.sep + ln_str_expr(v))
        else dest == sm.LA_DIR or dest == sm.LA_LANG:
            mv2 := is_dyn(v) ? v : attr_value_map(ai, v)
            ln_call(g, g.nm.attr, ln_quote(sm.LayoutAttrOut(ai)) + g.nm.sep + ln_str_expr(mv2))
        else dest == sm.LA_HTML_OR_CSS:
            out := sm.LayoutAttrOut(ai)
            if lo_all_digits(v):
                ln_call(g, g.nm.attr, ln_quote(out) + g.nm.sep + ln_quote(v))
            else:
                mv3 := is_dyn(v) ? v : attr_value_map(ai, v)
                ln_call(g, g.nm.attr, ln_quote(out) + g.nm.sep + ln_str_expr(mv3))
            end
        else dest == sm.LA_CSS:
            mut prop := sm.LayoutAttrOut(ai)
            if str.Len(prop) == 0:
                prop = hyphenate(key)
            end
            mv4 := is_dyn(v) ? v : attr_value_map(ai, v)
            ln_call(g, g.nm.attr, ln_quote(prop) + g.nm.sep + ln_str_expr(mv4))
        else dest == sm.LA_STYLE:
            ln_call(g, g.nm.attr, ln_quote("style") + g.nm.sep + ln_str_expr(v))
        end
    end
    if ei < 0:
        ret
    end
    ekey := sm.LayoutElemKey(ei)
    repeat sm.LayoutAttrCount() in d:
        if not sm.LayoutAttrHasDefault(d) or not sm.LayoutCsvHas(sm.LayoutAttrScope(d), ekey):
            continue
        end
        if sm.LayoutAttrDest(d) == sm.LA_HTML:
            ln_call(g, g.nm.attr, ln_quote(sm.LayoutAttrOut(d)) + g.nm.sep + ln_quote(sm.LayoutAttrDefault(d)))
        end
    end
end

func ln_pre_events(g &: LnGen, a &: at.Ast, container: int, ei: int):
    repeat at.ChildCount(a, container) in i:
        cid := at.Child(a, container, i)
        k := at.KindOf(a, cid)
        if k == at.AST_LAYOUT_ATTR:
            an := at.Get(a, cid)
            if an.a == 0 or str.Len(an.name) == 0:
                continue
            end
            mut key := sm.LayoutAttrKey(an.name)
            if str.Len(key) == 0:
                key = an.name
            end
            ai := sm.LayoutAttrFor(ei, key)
            if ai < 0 or sm.LayoutAttrVtype(ai) != sm.VT_CODE:
                continue
            end
            vk := at.KindOf(a, an.a)
            if vk != at.AST_LAMBDA and vk != at.AST_IDENTIFIER:
                continue
            end
            idx := g.lw.slots.len()
            g.lw.slots.push(LoSlot { kind = SL_TEXT, expr = an.a })
            mut n2 := at.Get(a, cid)
            n2.a = mk_str(a, lo_mark("dyn", idx), cid)
            at.Put(a, cid, n2)
        else k == at.AST_LAYOUT_ELEMENT:
            ln_pre_events(g, a, cid, sm.LayoutElemOf(a, cid))
        else k == at.AST_IF:
            ln_pre_events_if(g, a, cid, ei)
        else k == at.AST_EACH:
            ln_pre_events(g, a, at.Get(a, cid).b, ei)
        end
    end
end

func ln_pre_events_if(g &: LnGen, a &: at.Ast, nid: int, ei: int):
    n := at.Get(a, nid)
    ln_pre_events(g, a, n.b, ei)
    if n.c != 0:
        if at.KindOf(a, n.c) == at.AST_IF:
            ln_pre_events_if(g, a, n.c, ei)
        else:
            ln_pre_events(g, a, n.c, ei)
        end
    end
end

func ln_repeat_count(a &: at.Ast, el: int): i64:
    repeat at.ChildCount(a, el) in i:
        aid := at.Child(a, el, i)
        an := at.Get(a, aid)
        if an.kind == at.AST_LAYOUT_ATTR and str.Equals(an.name, "repeat") and an.a != 0:
            av := at.Get(a, an.a)
            if av.kind == at.AST_LITERAL and av.value_kind == tok.TV_INT:
                r := av.value_int as i64
                ret r < 1 ? 1 as i64 : r
            end
        end
    end
    ret 1
end

func ln_element_n(g &: LnGen, a &: at.Ast, el: int):
    nrep := ln_repeat_count(a, el)
    mut i := 0 as i64
    until i < nrep:
        ln_element(g, a, el)
        i++
    end
end

func ln_items(g &: LnGen, a &: at.Ast, container: int):
    repeat at.ChildCount(a, container) in i:
        cid := at.Child(a, container, i)
        k := at.KindOf(a, cid)
        if k == at.AST_LAYOUT_ELEMENT:
            ln_element_n(g, a, cid)
        else k == at.AST_IF:
            if ln_rx_is_comp(a, cid):
                ln_comp(g, a, cid)
            else:
                ln_if_scoped(g, a, cid)
            end
        else k == at.AST_EACH:
            ln_each_scoped(g, a, cid)
        end
    end
end

func ln_scope_open(g &: LnGen, site: int):
    ln_line(g, "__salam_b." + g.nm.scope + "(" + co.U64Toa(site as u64) + g.nm.sep + "(__salam_b: " + g.nm.ui + "." + g.nm.builder + "):")
    g.depth++
end

func ln_refs_state(a &: at.Ast, nid: int): bool:
    if nid == 0:
        ret false
    end
    n := at.Get(a, nid)
    if n.kind == at.AST_IDENTIFIER:
        ret str.StartsWith(n.name, "__salam_st_") or str.StartsWith(n.name, "__salam_k_")
    end
    if ln_refs_state(a, n.a) or ln_refs_state(a, n.b) or ln_refs_state(a, n.c) or ln_refs_state(a, n.d):
        ret true
    end
    repeat n.list.len() in i:
        if ln_refs_state(a, n.list.get(i)):
            ret true
        end
    end
    ret false
end

func ln_key_attr(g &: LnGen, a &: at.Ast, el: int, want: str): int:
    ei := sm.LayoutElemOf(a, el)
    repeat at.ChildCount(a, el) in i:
        aid := at.Child(a, el, i)
        an := at.Get(a, aid)
        if an.kind != at.AST_LAYOUT_ATTR or str.Len(an.name) == 0 or an.a == 0:
            continue
        end
        mut key := sm.LayoutAttrKey(an.name)
        if str.Len(key) == 0:
            key = an.name
        end
        ai := sm.LayoutAttrFor(ei, key)
        if ai < 0 or not str.Equals(sm.LayoutAttrOut(ai), want):
            continue
        end
        num := ln_dyn_num(val_str(a, an.a))
        if num >= 0 and num < g.lw.slots.len():
            ex := g.lw.slots.get(num).expr
            if ln_refs_state(a, ex):
                ret 0
            end
            ret ex
        end
        ret an.a
    end
    ret 0
end

func ln_row_key(g &: LnGen, a &: at.Ast, container: int): int:
    repeat at.ChildCount(a, container) in i:
        cid := at.Child(a, container, i)
        k := at.KindOf(a, cid)
        if k == at.AST_LAYOUT_ELEMENT:
            mut key := ln_key_attr(g, a, cid, "data-key")
            if key == 0:
                key = ln_key_attr(g, a, cid, "id")
            end
            ret key
        end
        if k == at.AST_IF and ln_rx_is_comp(a, cid):
            ret ln_row_key(g, a, at.Get(a, cid).b)
        end
    end
    ret 0
end

func ln_key_open(g &: LnGen, a &: at.Ast, site: int, key_expr: int):
    kv := at.Get(a, key_expr)
    mut ks := ""
    if kv.kind == at.AST_LITERAL:
        ks = ln_quote(val_str(a, key_expr))
    else:
        idx := g.lw.slots.len()
        g.lw.slots.push(LoSlot { kind = SL_TEXT, expr = at.Clone(a, key_expr) })
        ks = "(\"\" + " + ln_dyn_name(idx) + ")"
    end
    ln_line(g, "__salam_b." + g.nm.keyed + "(" + co.U64Toa(site as u64) + g.nm.sep + ks + g.nm.sep + "(__salam_b: " + g.nm.ui + "." + g.nm.builder + "):")
    g.depth++
end

func ln_scope_close(g &: LnGen):
    g.depth--
    ln_line(g, g.nm.kw_end + ")")
end

func ln_if_scoped(g &: LnGen, a &: at.Ast, nid: int):
    mut deps := Vector {} as Vector<int>
    defer deps.free()
    if g.in_comp == 0:
        ln_rx_cond(g.rx, g.lw, a, nid, deps)
    end
    if deps.len() == 0:
        ln_if(g, a, nid)
        ret
    end
    ln_scope_open(g, ln_rx_site(g.rx, 0 - 1, deps))
    ln_if(g, a, nid)
    ln_scope_close(g)
end

func ln_each_scoped(g &: LnGen, a &: at.Ast, nid: int):
    mut deps := Vector {} as Vector<int>
    defer deps.free()
    if g.in_comp == 0:
        ln_rx_markers(g.rx, g.lw, a, val_str(a, at.Get(a, nid).a), deps)
    end
    if deps.len() == 0:
        ln_each(g, a, nid)
        ret
    end
    ln_scope_open(g, ln_rx_site(g.rx, 0 - 1, deps))
    ln_each(g, a, nid)
    ln_scope_close(g)
end

func ln_is_render(gi: int): bool:
    ret gi < g_lo_st_kind.len() and g_lo_st_kind.get(gi) == LI_RENDER
end

func ln_comp_has_stores(a &: at.Ast, blk: int, render: bool): bool:
    repeat at.ChildCount(a, blk) in j:
        sid := at.Child(a, blk, j)
        if at.KindOf(a, sid) == at.AST_VAR_DECL and ln_is_render(at.Get(a, sid).value_int as int) == render:
            ret true
        end
    end
    ret false
end

func ln_comp_stores(g &: LnGen, a &: at.Ast, blk: int, kname: str, render: bool):
    repeat at.ChildCount(a, blk) in j:
        sid := at.Child(a, blk, j)
        if at.KindOf(a, sid) != at.AST_VAR_DECL:
            continue
        end
        sd := at.Get(a, sid)
        if ln_is_render(sd.value_int as int) != render:
            continue
        end
        gs := co.U64Toa(sd.value_int)
        idx := g.lw.slots.len()
        g.lw.slots.push(LoSlot { kind = SL_TEXT, expr = sd.a })
        store := "__salam_st_" + gs
        tmp := "__salam_i_" + gs
        ln_line(g, tmp + " := " + ln_dyn_name(idx))
        ln_line(g, g.nm.kw_if + " " + kname + " < " + store + "." + g.nm.len + "():")
        ln_line(g, "    " + store + "[" + kname + "] = " + tmp)
        ln_line(g, g.nm.kw_else + ":")
        ln_line(g, "    " + store + "." + g.nm.push + "(" + tmp + ")")
        ln_line(g, g.nm.kw_end)
    end
end

func ln_comp(g &: LnGen, a &: at.Ast, nid: int):
    n := at.Get(a, nid)
    ci := n.value_int as int
    mut deps := Vector {} as Vector<int>
    defer deps.free()
    ln_rx_tree(g.rx, g.lw, a, n.b, deps)
    mut has_state := false
    repeat at.ChildCount(a, n.b) in i:
        if at.KindOf(a, at.Child(a, n.b, i)) == at.AST_VAR_DECL:
            has_state = true
        end
    end
    if deps.len() == 0 and not has_state:
        g.in_comp++
        ln_items(g, a, n.b)
        g.in_comp--
        ret
    end
    site := ln_rx_site(g.rx, has_state ? ci : 0 - 1, deps)
    mut row_key := 0
    if g.row_keys.len() > 0:
        row_key = g.row_keys.get(g.row_keys.len() - 1)
    end
    if row_key != 0:
        ln_key_open(g, a, site, row_key)
    else:
        ln_scope_open(g, site)
    end
    if has_state:
        if not ln_rx_comp_has_state(g.rx, ci):
            g.rx.st_comps.push(ci)
        end
        cs := co.U64Toa(ci as u64)
        kname := "__salam_k_" + cs
        ln_line(g, kname + " := __salam_b." + g.nm.instance + "(" + cs + ")")
        if ln_comp_has_stores(a, n.b, false):
            ln_line(g, g.nm.kw_if + " __salam_b." + g.nm.fresh + "():")
            g.depth++
            ln_comp_stores(g, a, n.b, kname, false)
            g.depth--
            ln_line(g, g.nm.kw_end)
        end
        ln_comp_stores(g, a, n.b, kname, true)
    end
    g.in_comp++
    ln_items(g, a, n.b)
    g.in_comp--
    ln_scope_close(g)
end

func ln_if(g &: LnGen, a &: at.Ast, nid: int):
    n := at.Get(a, nid)
    num := ln_dyn_num(val_str(a, n.a))
    ln_line(g, g.nm.kw_if + " " + ln_dyn_name(num) + ":")
    g.depth++
    ln_items(g, a, n.b)
    g.depth--
    if n.c != 0:
        ln_line(g, g.nm.kw_else + ":")
        g.depth++
        if at.KindOf(a, n.c) == at.AST_IF:
            ln_if(g, a, n.c)
        else:
            ln_items(g, a, n.c)
        end
        g.depth--
    end
    ln_line(g, g.nm.kw_end)
end

func ln_each(g &: LnGen, a &: at.Ast, nid: int):
    n := at.Get(a, nid)
    num := ln_dyn_num(val_str(a, n.a))
    ns := co.U64Toa(num as u64)
    mut head := g.nm.kw_each + " "
    if n.c != 0:
        head += "__salam_key_" + ns + g.nm.sep
    end
    head += "__salam_item_" + ns + " " + g.nm.kw_in + " " + ln_dyn_name(num) + ":"
    ln_line(g, head)
    g.depth++
    g.row_keys.push(ln_row_key(g, a, n.b))
    ln_items(g, a, n.b)
    _rk := g.row_keys.pop()
    g.depth--
    ln_line(g, g.nm.kw_end)
end

func ln_element(g &: LnGen, a &: at.Ast, el: int):
    ei := sm.LayoutElemOf(a, el)
    mut kind := sm.LK_NORMAL
    mut tag := "div"
    mut ekey := "box"
    mut gen := ""
    mut in_head := false
    if ei >= 0:
        kind = sm.LayoutElemKind(ei)
        if str.Len(sm.LayoutElemTag(ei)) > 0:
            tag = sm.LayoutElemTag(ei)
        end
        ekey = sm.LayoutElemKey(ei)
        gen = sm.LayoutElemGenerator(ei)
        in_head = sm.LayoutElemInHead(ei)
    end
    mut la := LoAttrs {}
    defer lo_free_attrs(la)
    lo_collect_attrs(g.cx, a, el, ei, tag, la)
    if str.Len(la.gen) > 0:
        gen = la.gen
    end
    if str.Equals(gen, "global") or str.Equals(gen, "media"):
        ret
    end
    if str.Equals(gen, "style") or str.Equals(gen, "script") or str.Equals(gen, "font_face") or in_head:
        ret
    end
    if str.Equals(gen, "heading"):
        mut sv := ""
        mut sz := 1
        if lo_attr_get(la, "size", sv) and str.Len(sv) > 0:
            sz = lo_atoi(sv)
        end
        if sz < 1:
            sz = 1
        end
        if sz > 6:
            sz = 6
        end
        tag = "h" + co.U64Toa(sz as u64)
        ekey = tag
    end
    if kind == sm.LK_VIRTUAL:
        ln_items(g, a, el)
        ret
    end
    mut deps := Vector {} as Vector<int>
    defer deps.free()
    if g.in_comp == 0:
        ln_rx_own(g.rx, g.lw, a, el, deps)
    end
    if deps.len() > 0:
        ln_scope_open(g, ln_rx_site(g.rx, 0 - 1, deps))
    end
    ln_call(g, g.nm.open, ln_quote(ekey))
    g.depth++
    ln_style_attrs(g, a, el)
    ln_attrs(g, a, el, ei, tag)
    if la.has_content and kind != sm.LK_VOID:
        ln_call(g, g.nm.text, ln_str_expr(la.content))
    end
    if kind != sm.LK_VOID and kind != sm.LK_RAW:
        ln_items(g, a, el)
    end
    g.depth--
    ln_call(g, g.nm.close, "")
    if deps.len() > 0:
        ln_scope_close(g)
    end
end

func ln_page_settings(g &: LnGen, a &: at.Ast, lb: int, pack: lp.Langpack):
    mut have_lang := false
    mut have_dir := false
    page_ei := sm.LayoutElemLookup("page")
    repeat at.ChildCount(a, lb) in i:
        iid := at.Child(a, lb, i)
        item := at.Get(a, iid)
        if item.kind != at.AST_LAYOUT_ATTR:
            continue
        end
        v := val_str(a, item.a)
        if str.Equals(item.name, "title"):
            ln_call(g, g.nm.title, ln_str_expr(v))
        else str.Equals(item.name, "lang"):
            l := is_dyn(v) ? v : sm.LayoutDynValue("lang", i18.LayoutValue(v))
            ln_call(g, g.nm.lang, ln_str_expr(str.Len(l) > 0 ? l : v))
            have_lang = true
        else str.Equals(item.name, "dir"):
            d := is_dyn(v) ? v : sm.LayoutDynValue("dir", i18.LayoutValue(v))
            ln_call(g, g.nm.dir, ln_str_expr(str.Len(d) > 0 ? d : v))
            have_dir = true
        else:
            mut key := sm.LayoutAttrKey(item.name)
            if str.Len(key) == 0:
                key = item.name
            end
            ai := sm.LayoutAttrFor(page_ei, key)
            if ai >= 0 and sm.LayoutAttrVtype(ai) == sm.VT_CODE:
                num := ln_dyn_num(v)
                if num >= 0 and num < g.lw.slots.len():
                    ev := ln_quote(ln_event_name(sm.LayoutAttrOut(ai)))
                    if at.KindOf(a, g.lw.slots.get(num).expr) == at.AST_LAMBDA:
                        ln_call(g, g.nm.on, ev + g.nm.sep + ln_dyn_name(num))
                    else:
                        ln_call(g, g.nm.on, ev + g.nm.sep + "(): " + ln_dyn_name(num) + "() " + g.nm.kw_end)
                    end
                end
            end
        end
    end
    if str.Equals(lp.Code(pack), "fa"):
        if not have_lang:
            ln_call(g, g.nm.lang, ln_quote("fa"))
        end
        if not have_dir:
            ln_call(g, g.nm.dir, ln_quote("rtl"))
        end
    end
    ln_style_attrs(g, a, lb)
    repeat at.ChildCount(a, lb) in j:
        jid := at.Child(a, lb, j)
        jt := at.Get(a, jid)
        if jt.kind == at.AST_LAYOUT_ATTR and str.Equals(jt.name, "content"):
            ln_call(g, g.nm.text, ln_str_expr(val_str(a, jt.a)))
        end
    end
end

func ln_state_type(g &: LnGen, gi: int): str:
    lit := g_lo_st_lit.get(gi)
    if str.Equals(lit, "int"):
        ret g.nm.t_int
    end
    if str.Equals(lit, "f64"):
        ret g.nm.t_f64
    end
    if str.Equals(lit, "str"):
        ret g.nm.t_str
    end
    if str.Equals(lit, "bool"):
        ret g.nm.t_bool
    end
    ret "__salam_type_" + co.U64Toa(gi as u64)
end

func ln_rx_source(g &: LnGen): str:
    n := g.nm
    words := ln_rx_words(g.rx)
    mut s := ""
    repeat words in w:
        s += n.kw_mut + " " + ln_rx_word_name(w) + " := 0 " + n.kw_as + " " + n.t_i64 + "\n"
    end
    repeat g_lo_st_comp.len() in gi:
        if ln_rx_comp_has_state(g.rx, g_lo_st_comp.get(gi)):
            s += n.kw_mut + " __salam_st_" + co.U64Toa(gi as u64) + " := " + n.vec + " {} " + n.kw_as + " " + n.vec + "<" + ln_state_type(g, gi) + ">\n"
        end
    end
    s += "\n" + n.kw_func + " __salam_take(__salam_w: " + n.t_int + "): " + n.t_i64 + ":\n"
    s += "    " + n.kw_mut + " __salam_t := 0 " + n.kw_as + " " + n.t_i64 + "\n"
    repeat words in w2:
        wn := ln_rx_word_name(w2)
        s += "    " + n.kw_if + " __salam_w == " + co.U64Toa(w2 as u64) + ":\n"
        s += "        __salam_t = " + wn + "\n"
        s += "        " + wn + " = 0\n"
        s += "    " + n.kw_end + "\n"
    end
    s += "    " + n.kw_ret + " __salam_t\n" + n.kw_end + "\n\n"
    s += n.kw_func + " __salam_sites():\n"
    s += "    " + n.ui + "." + n.site + "(0" + n.sep + "0 - 1" + n.sep + "0" + n.sep + "0)\n"
    repeat g.rx.site_comp.len() in si:
        mut masks := Vector {} as Vector<int>
        repeat words:
            masks.push(0)
        end
        repeat g.rx.dep_site.len() in di:
            if g.rx.dep_site.get(di) == si:
                id := g.rx.dep_id.get(di)
                wi := id / LN_RX_BITS
                masks.set(wi, masks.get(wi) | ln_rx_mask(id))
            end
        end
        comp := g.rx.site_comp.get(si)
        cs := comp < 0 ? "0 - 1" : co.U64Toa(comp as u64)
        mut any := false
        repeat words in w3:
            if masks.get(w3) != 0:
                any = true
                s += "    " + n.ui + "." + n.site + "(" + co.U64Toa(si as u64) + n.sep + cs + n.sep + co.U64Toa(w3 as u64) + n.sep + co.U64Toa(masks.get(w3) as u64) + ")\n"
            end
        end
        if not any and comp >= 0:
            s += "    " + n.ui + "." + n.site + "(" + co.U64Toa(si as u64) + n.sep + cs + n.sep + "0" + n.sep + "0)\n"
        end
        masks.free()
    end
    s += n.kw_end + "\n\n"
    s += n.kw_func + " __salam_marks():\n"
    repeat g.rx.ids.len() in id2:
        s += "    " + ln_rx_word_name(id2 / LN_RX_BITS) + " |= " + co.U64Toa(ln_rx_mask(id2) as u64) + "\n"
    end
    each ci in g.rx.st_comps:
        cs2 := co.U64Toa(ci as u64)
        s += "    " + n.ui + "." + n.touch + "(" + cs2 + n.sep + "__salam_k_" + cs2 + ")\n"
    end
    s += "    " + ln_rx_word_name(0) + " |= 0\n"
    s += n.kw_end + "\n\n"
    ret s
end

func ln_source(g &: LnGen, with_main: bool): str:
    n := g.nm
    mut s := n.kw_import + " " + n.import_ui + "\n\n"
    s += ln_rx_source(g)
    rline := "    __salam_b." + n.reactive + "(" + co.U64Toa(ln_rx_words(g.rx) as u64) + n.sep + "(__salam_w: " + n.t_int + "): " + n.kw_ret + " __salam_take(__salam_w) " + n.kw_end + n.sep + "(): __salam_sites() " + n.kw_end + ")\n"
    s += n.kw_func + " " + NATIVE_PAGE_VIEW + "(__salam_b: " + n.ui + "." + n.builder + "):\n" + rline + g.out + n.kw_end + "\n\n"
    if with_main:
        s += n.kw_func + " " + n.entry + ":\n"
        s += "    " + n.ui + "." + n.run + "((): " + n.kw_ret + " " + n.ui + "." + n.no_patches + "() " + n.kw_end + n.sep + "(__salam_b: " + n.ui + "." + n.builder + "): " + NATIVE_PAGE_VIEW + "(__salam_b) " + n.kw_end + ")\n"
        s += n.kw_end + "\n"
    end
    ret s
end

pub func PrepareNativePage(log: lg.Logger, pack: lp.Langpack, ct: cc.Table, a &: at.Ast, prog: int, file: str): bool:
    if prog == 0:
        ret false
    end
    lb := ln_find_page(a, prog)
    if lb == 0:
        ret false
    end
    g_lo_st_comp.clear()
    g_lo_st_name.clear()
    g_lo_st_type.clear()
    g_lo_st_lit.clear()
    g_lo_st_kind.clear()
    li_reset()
    g_lo_native_scopes = true
    _ex := ExpandBlock(log, pack, ct, a, prog, lb, lo_dir_of(file))
    g_lo_native_scopes = false
    sm.LayoutResolve(a, lb)
    mut g := LnGen {}
    defer ln_rx_free(g.rx)
    defer g.lw.slots.free()
    defer g.lw.shadow.free()
    defer g.lw.funcs.free()
    defer g.row_keys.free()
    g.lw.prog = prog
    g.nm = ln_names(pack)
    g.cx.log = log
    g.cx.file = file
    g.cx.compact = true
    lo_collect_funcs(g.lw, a, prog)
    lo_shadow_globals(g.lw, a, prog)
    page_ei := sm.LayoutElemLookup("page")
    ln_pre_events(g, a, lb, page_ei)
    lo_walk(g.lw, a, lb, 0, 0 - 1)
    ln_rx_init(g.rx, a, prog)
    mut rdeps := Vector {} as Vector<int>
    ln_rx_own(g.rx, g.lw, a, lb, rdeps)
    _root := ln_rx_site(g.rx, 0 - 1, rdeps)
    rdeps.free()
    ln_page_settings(g, a, lb, pack)
    ln_items(g, a, lb)
    is_fa := str.Equals(lp.Code(pack), "fa")
    mut text := ln_source(g, not ln_has_main(a, prog, pack))
    if is_fa:
        text = ln_to_fa(text, pack)
    end
    if os.Env("SALAM_NATIVE_DUMP").len() > 0:
        println text
    end
    base := at.Count(a)
    sp := ln_parse(log, a, text, file, is_fa ? pack : lp.Load("en"))
    if sp == 0:
        ret false
    end
    mut chunks := Vector {} as Vector<str>
    defer chunks.free()
    mut pn := at.Get(a, prog)
    mut list := Vector {} as Vector<int>
    repeat at.ChildCount(a, sp) in ci:
        cid := at.Child(a, sp, ci)
        if at.KindOf(a, cid) == at.AST_IMPORT and not lo_has_import(a, prog, at.Get(a, cid).name):
            list.push(cid)
        end
    end
    mut gvars := Vector {} as Vector<int>
    defer gvars.free()
    repeat at.ChildCount(a, sp) in cv:
        vid := at.Child(a, sp, cv)
        if at.KindOf(a, vid) == at.AST_VAR_DECL:
            ln_rx_fix_types(a, vid)
            lo_span_tree(a, vid, lb, base)
            gvars.push(vid)
        end
    end
    mut placed := false
    repeat pn.list.len() in k:
        item := pn.list.get(k)
        ph := at.ToplevelOrderPhase(a, item)
        if not placed and (ph == at.AST_ORDER_VAR or ph == at.AST_ORDER_TYPEDEF or ph == at.AST_ORDER_FUNC):
            each gv in gvars:
                list.push(gv)
            end
            placed = true
        end
        list.push(item)
    end
    if not placed:
        each gv2 in gvars:
            list.push(gv2)
        end
    end
    repeat at.ChildCount(a, sp) in cj:
        cid2 := at.Child(a, sp, cj)
        if at.KindOf(a, cid2) != at.AST_FUNC_DEF:
            continue
        end
        fnode := at.Get(a, cid2)
        if str.Equals(fnode.name, "__salam_marks"):
            blk := at.Get(a, fnode.a)
            repeat blk.list.len() in ti:
                g.rx.tmpl.push(blk.list.get(ti))
            end
            continue
        end
        if str.Equals(fnode.name, NATIVE_PAGE_VIEW):
            body := lo_splice(g.lw, a, fnode.a, chunks, lb)
            mut fn2 := at.Get(a, cid2)
            fn2.a = body
            at.Put(a, cid2, fn2)
            lo_fix_glue_spans(g.lw, a, body, base)
        end
        lo_span_tree(a, cid2, lb, base)
        mut fn3 := at.Get(a, cid2)
        fn3.file_boundary = true
        at.Put(a, cid2, fn3)
        list.push(cid2)
    end
    mut old := pn.list
    pn.list = list
    at.Put(a, prog, pn)
    old.free()
    ln_rx_mark_program(g.rx, a, prog)
    mut lbm := at.Get(a, lb)
    lbm.view_glue = true
    at.Put(a, lb, lbm)
    mut pn2 := at.Get(a, prog)
    mut kept := Vector {} as Vector<int>
    repeat pn2.list.len() in ck:
        cdid := pn2.list.get(ck)
        if at.KindOf(a, cdid) != at.AST_LAYOUT_COMPONENT:
            kept.push(cdid)
        end
    end
    mut old2 := pn2.list
    pn2.list = kept
    at.Put(a, prog, pn2)
    old2.free()
    lg.Log(log, lg.PH_DRIVER, lg.LOG_INFO, "page " + file + " compiled for a native window")
    ret true
end
