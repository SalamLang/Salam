package layout

import str

include i18 "../i18n.salam"
include sm "../semantic/semantic.salam"

func map_length(v: str): str:
    ret sm.LayoutMapLength(v, true)
end

func attr_value_map(ai: int, value: str): str:
    if ai < 0:
        ret value
    end
    if sm.LayoutAttrVtype(ai) == sm.VT_LENGTH:
        ret map_length(i18.LayoutValue(value))
    end
    ret sm.LayoutMapValue(ai, value)
end
