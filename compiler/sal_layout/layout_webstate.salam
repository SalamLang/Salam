package layout

import os
import str

include co "../sal_core.salam"
include tok "../token.salam"
include lg "../logger.salam"
include dg "../diag.salam"
include at "../ast.salam"
include lp "../langpack.salam"
include sm "../semantic/semantic.salam"

const WS_SINGLE := 0
const WS_MULTI := 1
const WS_REGION := 2

mut g_lo_ws_std := false
mut g_lo_dev_names := ""

struct WsUse:
    pub url: bool = false
    pub css: bool = false
    pub std: bool = false
    pub opt: bool = false
end

struct WsCtx:
    pub owner: Vector<int> = Vector {}
    pub done: Vector<bool> = Vector {}
    pub dep_inst: Vector<int> = Vector {}
    pub dep_id: Vector<int> = Vector {}
    pub ekey_num: Vector<int> = Vector {}
    pub ekey_expr: Vector<int> = Vector {}
    pub ctl: Vector<int> = Vector {}
    pub multi: Vector<int> = Vector {}
    pub wsd_inst: Vector<int> = Vector {}
    pub wsd_n: Vector<int> = Vector {}
    pub rm_at: Vector<int> = Vector {}
    pub rm_num: Vector<int> = Vector {}
    pub rm_ok: Vector<bool> = Vector {}
    pub rm_dyn: Vector<str> = Vector {}
    pub rm_cur: Vector<str> = Vector {}
    pub rm_pm: Vector<int> = Vector {}
end

func ws_free(c &: WsCtx):
    c.owner.Free()
    c.done.Free()
    c.dep_inst.Free()
    c.dep_id.Free()
    c.ekey_num.Free()
    c.ekey_expr.Free()
    c.ctl.Free()
    c.multi.Free()
    c.wsd_inst.Free()
    c.wsd_n.Free()
end

func ws_name(n: int): str:
    ret "__salam_ws_" + co.U64Toa(n as u64)
end

func ws_kind(i: int): int:
    if i >= 0 and i < g_lo_wi_kind.Len():
        ret g_lo_wi_kind.Get(i)
    end
    ret WS_SINGLE
end

func ws_has_multi_inst(): bool:
    each k in g_lo_wi_kind:
        if k == WS_MULTI:
            ret true
        end
    end
    ret false
end

func ws_placeholder(i: int): str:
    s := co.U64Toa(i as u64)
    ret "<!--salam:" + s + "--><!--/salam:" + s + "-->"
end

func ws_int(a &: at.Ast, v: int, from: int): int:
    n := at.NewNode(a, at.AST_LITERAL)
    copy_span(a, n, from)
    at.SetOp(a, n, tok.TK_INT)
    at.SetName(a, n, co.U64Toa(v as u64))
    at.SetTokenValue(a, n, tok.ValueInt(v as u64))
    ret n
end

func ws_call1(a &: at.Ast, fname: str, v: int, from: int): int:
    call := at.NewNode(a, at.AST_CALL)
    copy_span(a, call, from)
    mut args := Vector {} as Vector<int>
    args.Push(ws_int(a, v, from))
    mut cn := at.Get(a, call)
    cn.a = lo_ident(a, fname, from)
    mut old := cn.list
    cn.list = args
    at.Put(a, call, cn)
    old.Free()
    ret call
end

func ws_cur_ref(a &: at.Ast, gi: int, wi: int, from: int): int:
    ix := at.NewNode(a, at.AST_INDEX)
    copy_span(a, ix, from)
    mut n := at.Get(a, ix)
    n.a = lo_ident(a, ws_name(gi), from)
    n.b = ws_call1(a, "salamWsCur", wi, from)
    n.synthetic = true
    at.Put(a, ix, n)
    ret ix
end

func ws_touch_stmt(a &: at.Ast, inst: int, from: int): int:
    call := ws_call1(a, "salamWsTouch", inst, from)
    st := at.NewNode(a, at.AST_EXPR_STMT)
    copy_span(a, st, from)
    mut sn := at.Get(a, st)
    sn.a = call
    at.Put(a, st, sn)
    ret st
end

func ws_mark_index(nid: int): int:
    repeat g_lo_wi_mark.Len() in i:
        if g_lo_wi_mark.Get(i) == nid:
            ret i
        end
    end
    ret -1
end

func ws_owner_of(wc &: WsCtx, inst0: int): int:
    mut inst := inst0
    if ws_kind(inst) == WS_MULTI:
        inst = inst < wc.owner.Len() ? wc.owner.Get(inst) : -1
    end
    ret inst
end

func ws_note(
    r &: LnReact, wc &: WsCtx, a &: at.Ast, target: int, locals: Vector<str>, insts &: Vector<int>
):
    root := ln_rx_root(a, target)
    if root == 0:
        ret
    end
    name := at.Get(a, root).name
    if str.StartsWith(name, "__salam_ws_"):
        n := str.Substr(name, 11, str.Len(name) - 11).ToInt()
        if n >= 0 and n < g_lo_ws_inst.Len():
            if n < g_lo_ws_kind.Len() and g_lo_ws_kind.Get(n) != LI_STATE:
                ret
            end
            inst := ws_owner_of(wc, g_lo_ws_inst.Get(n))
            if inst >= 0:
                ln_rx_add(insts, inst)
            end
            repeat wc.wsd_n.Len() in k:
                if wc.wsd_n.Get(k) == n:
                    ln_rx_add(insts, wc.wsd_inst.Get(k))
                end
            end
        end
        ret
    end
    if ln_rx_local(locals, name):
        ret
    end
    repeat r.ids.Len() in i:
        if str.Equals(r.ids.Get(i), name):
            repeat wc.dep_id.Len() in k:
                if wc.dep_id.Get(k) == i:
                    ln_rx_add(insts, wc.dep_inst.Get(k))
                end
            end
        end
    end
end

func ws_writes(
    r &: LnReact, wc &: WsCtx, a &: at.Ast, nid: int, locals: Vector<str>, insts &: Vector<int>
):
    if nid == 0:
        ret
    end
    n := at.Get(a, nid)
    if n.kind == at.AST_BLOCK or n.kind == at.AST_LAMBDA:
        ret
    end
    if n.kind == at.AST_ASSIGN or n.kind == at.AST_INCDEC:
        ws_note(r, wc, a, n.a, locals, insts)
    end
    if n.kind == at.AST_CALL and n.a != 0:
        callee := at.Get(a, n.a)
        if callee.kind == at.AST_MEMBER:
            mut ro := false
            each m in k_ln_rx_readonly:
                if str.Equals(m, callee.name):
                    ro = true
                end
            end
            if not ro:
                ws_note(r, wc, a, callee.a, locals, insts)
            end
        end
        repeat n.list.Len() in i:
            arg := n.list.Get(i)
            if ln_rx_root(a, arg) == 0:
                continue
            end
            mut refp := -1
            if callee.kind == at.AST_IDENTIFIER:
                refp = ln_rx_ref_param(r, a, callee.name, i)
                if refp < 0:
                    refp = 1
                end
            else callee.kind == at.AST_LAMBDA:
                refp = 0
            end
            if refp != 0 and not (callee.kind == at.AST_MEMBER and ln_rx_ro_name(callee.name)):
                ws_note(r, wc, a, arg, locals, insts)
            end
        end
    end
    ws_writes(r, wc, a, n.a, locals, insts)
    ws_writes(r, wc, a, n.b, locals, insts)
    ws_writes(r, wc, a, n.c, locals, insts)
    ws_writes(r, wc, a, n.d, locals, insts)
    repeat n.list.Len() in j:
        ws_writes(r, wc, a, n.list.Get(j), locals, insts)
    end
end

func ws_block(r &: LnReact, wc &: WsCtx, a &: at.Ast, blk: int, locals0: Vector<str>):
    mut locals := ln_rx_clone_locals(locals0)
    defer locals.Free()
    b := at.Get(a, blk)
    mut items := Vector {} as Vector<int>
    mut changed := false
    repeat b.list.Len() in i:
        sid := b.list.Get(i)
        mut insts := Vector {} as Vector<int>
        ws_writes(r, wc, a, sid, locals, insts)
        each inst in insts:
            items.Push(ws_touch_stmt(a, inst, sid))
            changed = true
        end
        insts.Free()
        items.Push(sid)
        s := at.Get(a, sid)
        if s.kind == at.AST_VAR_DECL and str.Len(s.name) > 0:
            locals.Push(s.name)
        end
        ws_visit(r, wc, a, sid, locals)
    end
    if changed:
        mut bn := at.Get(a, blk)
        mut old := bn.list
        bn.list = items
        at.Put(a, blk, bn)
        old.Free()
    else:
        items.Free()
    end
end

func ws_visit(r &: LnReact, wc &: WsCtx, a &: at.Ast, nid: int, locals0: Vector<str>):
    if nid == 0:
        ret
    end
    n := at.Get(a, nid)
    if n.kind == at.AST_BLOCK:
        ws_block(r, wc, a, nid, locals0)
        ret
    end
    if n.kind == at.AST_LAMBDA:
        mut locals := ln_rx_clone_locals(locals0)
        defer locals.Free()
        ln_rx_params(a, nid, locals)
        ws_visit(r, wc, a, n.a, locals)
        ret
    end
    if n.kind == at.AST_EACH or n.kind == at.AST_REPEAT:
        mut locals2 := ln_rx_clone_locals(locals0)
        defer locals2.Free()
        if str.Len(n.name) > 0:
            locals2.Push(n.name)
        end
        if n.kind == at.AST_EACH and n.c != 0 and at.KindOf(a, n.c) == at.AST_IDENTIFIER:
            locals2.Push(at.Get(a, n.c).name)
        end
        ws_visit(r, wc, a, n.a, locals0)
        ws_visit(r, wc, a, n.b, locals2)
        if n.kind == at.AST_REPEAT:
            ws_visit(r, wc, a, n.c, locals0)
            ws_visit(r, wc, a, n.d, locals0)
        end
        ret
    end
    ws_visit(r, wc, a, n.a, locals0)
    ws_visit(r, wc, a, n.b, locals0)
    ws_visit(r, wc, a, n.c, locals0)
    ws_visit(r, wc, a, n.d, locals0)
    repeat n.list.Len() in i:
        ws_visit(r, wc, a, n.list.Get(i), locals0)
    end
end

func ws_func(r &: LnReact, wc &: WsCtx, a &: at.Ast, fid: int):
    f := at.Get(a, fid)
    if f.a == 0:
        ret
    end
    mut locals := Vector {} as Vector<str>
    defer locals.Free()
    ln_rx_params(a, fid, locals)
    ws_visit(r, wc, a, f.a, locals)
end

func ws_mark_program(r &: LnReact, wc &: WsCtx, a &: at.Ast, prog: int):
    repeat at.ChildCount(a, prog) in i:
        did := at.Child(a, prog, i)
        k := at.KindOf(a, did)
        if k == at.AST_FUNC_DEF:
            ws_func(r, wc, a, did)
        else k == at.AST_STRUCT_DEF:
            repeat at.ChildCount(a, did) in j:
                mid := at.Child(a, did, j)
                if at.KindOf(a, mid) == at.AST_FUNC_DEF:
                    ws_func(r, wc, a, mid)
                end
            end
        end
    end
end

func ws_reads(r &: LnReact, a &: at.Ast, nid: int): bool:
    mut out := Vector {} as Vector<int>
    ln_rx_scan(r, a, nid, out)
    got := out.Len() > 0
    out.Free()
    ret got
end

func ws_counts_runs(a &: at.Ast, nid: int): bool:
    if nid == 0:
        ret false
    end
    n := at.Get(a, nid)
    if n.kind == at.AST_LAMBDA:
        ret false
    end
    if n.kind == at.AST_CALL and n.a != 0 and at.KindOf(a, n.a) == at.AST_MEMBER:
        m := at.Get(a, n.a).name
        if str.Equals(m, "ScopeRuns") or str.Equals(m, "شمار اجرای دامنه"):
            ret true
        end
    end
    if ws_counts_runs(a, n.a) or ws_counts_runs(a, n.b) or ws_counts_runs(a, n.c):
        ret true
    end
    repeat n.list.Len() in i:
        if ws_counts_runs(a, n.list.Get(i)):
            ret true
        end
    end
    ret false
end

func ws_own_reads(r &: LnReact, a &: at.Ast, nid: int): bool:
    n := at.Get(a, nid)
    if n.kind == at.AST_LAYOUT_ELEMENT:
        repeat at.ChildCount(a, nid) in i:
            cid := at.Child(a, nid, i)
            if at.KindOf(a, cid) == at.AST_LAYOUT_ATTR:
                v := at.Get(a, cid).a
                if ws_reads(r, a, v) or ws_counts_runs(a, v):
                    ret true
                end
            end
        end
        ret false
    end
    if n.kind == at.AST_EACH:
        ret ws_reads(r, a, n.a)
    end
    if n.kind == at.AST_IF:
        if ws_reads(r, a, n.a):
            ret true
        end
        if n.c != 0 and at.KindOf(a, n.c) == at.AST_IF:
            ret ws_own_reads(r, a, n.c)
        end
    end
    ret false
end

func ws_region(a &: at.Ast, item: int): int:
    mark := at.NewNode(a, at.AST_IF)
    copy_span(a, mark, item)
    blk := at.NewNode(a, at.AST_BLOCK)
    copy_span(a, blk, item)
    at.AddChild(a, blk, item)
    mut mn := at.Get(a, mark)
    mn.name = "__salam_component"
    mn.synthetic = true
    mn.a = mk_str(a, "", item)
    mn.b = blk
    at.Put(a, mark, mn)
    g_lo_wi_mark.Push(mark)
    g_lo_wi_kind.Push(WS_REGION)
    ret mark
end

func ws_regions(r &: LnReact, a &: at.Ast, container: int):
    repeat at.ChildCount(a, container) in i:
        cid := at.Child(a, container, i)
        k := at.KindOf(a, cid)
        if k == at.AST_LAYOUT_ELEMENT or k == at.AST_EACH or
            (k == at.AST_IF and not ln_rx_is_comp(a, cid)):
            if ws_own_reads(r, a, cid):
                mark := ws_region(a, cid)
                mut cn := at.Get(a, container)
                cn.list.Set(i, mark)
                at.Put(a, container, cn)
            else k == at.AST_LAYOUT_ELEMENT:
                ws_regions(r, a, cid)
            end
        end
    end
end

func ws_order_in(wc &: WsCtx, a &: at.Ast, nid: int, order &: Vector<int>):
    if nid == 0:
        ret
    end
    if ln_rx_is_comp(a, nid):
        idx := ws_mark_index(nid)
        if idx >= 0 and ws_kind(idx) != WS_MULTI:
            ws_order(wc, a, idx, order)
            ret
        end
    end
    n := at.Get(a, nid)
    ws_order_in(wc, a, n.b, order)
    ws_order_in(wc, a, n.c, order)
    repeat n.list.Len() in i:
        ws_order_in(wc, a, n.list.Get(i), order)
    end
end

func ws_order(wc &: WsCtx, a &: at.Ast, i: int, order &: Vector<int>):
    if wc.done.Get(i):
        ret
    end
    wc.done.Set(i, true)
    m := g_lo_wi_mark.Get(i)
    if m == 0 or ws_kind(i) == WS_MULTI:
        ret
    end
    ws_order_in(wc, a, at.Get(a, m).b, order)
    order.Push(i)
end

func ws_owned(wc &: WsCtx, a &: at.Ast, nid: int, owner: int):
    if nid == 0:
        ret
    end
    if ln_rx_is_comp(a, nid):
        idx := ws_mark_index(nid)
        if idx < 0 or ws_kind(idx) != WS_MULTI:
            ret
        end
        wc.owner.Set(idx, owner)
    end
    n := at.Get(a, nid)
    ws_owned(wc, a, n.b, owner)
    ws_owned(wc, a, n.c, owner)
    repeat n.list.Len() in i:
        ws_owned(wc, a, n.list.Get(i), owner)
    end
end

func ws_has_multi(a &: at.Ast, nid: int): bool:
    if nid == 0:
        ret false
    end
    if ln_rx_is_comp(a, nid):
        ret ws_kind(ws_mark_index(nid)) == WS_MULTI
    end
    n := at.Get(a, nid)
    if ws_has_multi(a, n.b) or ws_has_multi(a, n.c):
        ret true
    end
    repeat n.list.Len() in i:
        if ws_has_multi(a, n.list.Get(i)):
            ret true
        end
    end
    ret false
end

func ws_deps_in(r &: LnReact, lw &: LoLower, a &: at.Ast, nid: int, out &: Vector<int>):
    if nid == 0:
        ret
    end
    n := at.Get(a, nid)
    if n.kind == at.AST_LAYOUT_ATTR:
        if n.a != 0:
            ln_rx_markers(r, lw, a, val_str(a, n.a), out)
        end
        ret
    end
    if n.kind == at.AST_VAR_DECL:
        ln_rx_scan(r, a, n.a, out)
        ret
    end
    if ln_rx_is_comp(a, nid):
        if ws_kind(ws_mark_index(nid)) != WS_MULTI:
            ret
        end
    else n.kind == at.AST_IF or n.kind == at.AST_EACH:
        ln_rx_markers(r, lw, a, val_str(a, n.a), out)
    end
    ws_deps_in(r, lw, a, n.b, out)
    ws_deps_in(r, lw, a, n.c, out)
    repeat n.list.Len() in i:
        ws_deps_in(r, lw, a, n.list.Get(i), out)
    end
end

func ws_ws_scan(a &: at.Ast, nid: int, out &: Vector<int>):
    if nid == 0:
        ret
    end
    n := at.Get(a, nid)
    if n.kind == at.AST_LAMBDA:
        ret
    end
    if n.kind == at.AST_IDENTIFIER:
        if str.StartsWith(n.name, "__salam_ws_"):
            ln_rx_add(out, str.Substr(n.name, 11, str.Len(n.name) - 11).ToInt())
        end
        ret
    end
    ws_ws_scan(a, n.a, out)
    ws_ws_scan(a, n.b, out)
    ws_ws_scan(a, n.c, out)
    ws_ws_scan(a, n.d, out)
    repeat n.list.Len() in i:
        ws_ws_scan(a, n.list.Get(i), out)
    end
end

func ws_ws_markers(lw &: LoLower, a &: at.Ast, v: str, out &: Vector<int>):
    stx := char_from_code(2)
    mut p := 0
    until true:
        q := str.IndexFrom(v, stx, p)
        if q < 0:
            break
        end
        mut tag := ""
        mut num := 0
        after := lo_marker_at(v, q, tag, num)
        if after < 0:
            p = q + 1
            continue
        end
        if num >= 0 and num < lw.slots.Len():
            ws_ws_scan(a, lw.slots.Get(num).expr, out)
        end
        p = after
    end
end

func ws_ws_deps_in(lw &: LoLower, a &: at.Ast, nid: int, out &: Vector<int>):
    if nid == 0:
        ret
    end
    n := at.Get(a, nid)
    if n.kind == at.AST_LAYOUT_ATTR:
        if n.a != 0:
            ws_ws_markers(lw, a, val_str(a, n.a), out)
        end
        ret
    end
    if n.kind == at.AST_VAR_DECL:
        if n.a != 0:
            ws_ws_markers(lw, a, val_str(a, n.a), out)
        end
        ret
    end
    if ln_rx_is_comp(a, nid):
        if ws_kind(ws_mark_index(nid)) != WS_MULTI:
            ret
        end
    else n.kind == at.AST_IF or n.kind == at.AST_EACH:
        ws_ws_markers(lw, a, val_str(a, n.a), out)
    end
    ws_ws_deps_in(lw, a, n.b, out)
    ws_ws_deps_in(lw, a, n.c, out)
    repeat n.list.Len() in i:
        ws_ws_deps_in(lw, a, n.list.Get(i), out)
    end
end

func ws_refs_state(lw &: LoLower, a &: at.Ast, nid: int): bool:
    if nid == 0:
        ret false
    end
    n := at.Get(a, nid)
    if n.kind == at.AST_IDENTIFIER:
        if str.StartsWith(n.name, "__salam_ws_") or str.Equals(n.name, "salamWsCur"):
            ret true
        end
        ret lo_is_mut_global(lw, a, n.name)
    end
    if ws_refs_state(lw, a, n.a) or ws_refs_state(lw, a, n.b) or ws_refs_state(lw, a, n.c) or
        ws_refs_state(lw, a, n.d):
        ret true
    end
    repeat n.list.Len() in i:
        if ws_refs_state(lw, a, n.list.Get(i)):
            ret true
        end
    end
    ret false
end

func ws_key_param(lw &: LoLower, a &: at.Ast, ex: int): int:
    if ex == 0:
        ret 0
    end
    mut id := ex
    if at.KindOf(a, id) == at.AST_INDEX:
        id = at.Get(a, id).a
    end
    if id == 0 or at.KindOf(a, id) != at.AST_IDENTIFIER:
        ret 0
    end
    nm := at.Get(a, id).name
    if not str.StartsWith(nm, "__salam_ws_"):
        ret 0
    end
    n := str.Substr(nm, 11, str.Len(nm) - 11).ToInt()
    if n < 0 or n >= g_lo_ws_decl.Len() or not ws_is_render(n):
        ret 0
    end
    init := at.Get(a, g_lo_ws_decl.Get(n)).a
    if init == 0 or ws_refs_state(lw, a, init):
        ret 0
    end
    ret init
end

func ws_key_attr(lw &: LoLower, a &: at.Ast, el: int): int:
    repeat at.ChildCount(a, el) in i:
        aid := at.Child(a, el, i)
        an := at.Get(a, aid)
        if an.kind != at.AST_LAYOUT_ATTR or an.a == 0 or not lo_row_key_name(an.name):
            continue
        end
        num := ln_dyn_num(val_str(a, an.a))
        if num >= 0 and num < lw.slots.Len():
            ex := lw.slots.Get(num).expr
            // Keyed-each lifecycle/parity contract (webstate, source-level):
            // - Prefer static or otherwise stable keys for reconciliation identity.
            // - Runtime/state-dependent key expressions are rejected here to avoid excessive churn/remounts without runtime lifecycle guarantees.
            // - When no stable key is found, lowering falls back to the each key variable or synthetic index (see ws_keys/ws_ekey usage), which is weaker for moves.
            // TODO(runtime/toolchain): support stable derived/dynamic keys with explicit mount/update/unmount/cleanup hook semantics and uniqueness validation,
            //   and align behavior with native keyed scopes for cross-target parity.
            if ws_refs_state(lw, a, ex):
                ret ws_key_param(lw, a, ex)
            end
            ret ex
        end
        // Literal/non-dynamic attribute values are treated as stable enough for keyed rows at source level.
        ret an.a
    end
    ret 0
end

func ws_row_key(lw &: LoLower, a &: at.Ast, body: int): int:
    if body == 0:
        ret 0
    end
    repeat at.ChildCount(a, body) in i:
        cid := at.Child(a, body, i)
        k := at.KindOf(a, cid)
        if k == at.AST_LAYOUT_ELEMENT:
            key := ws_key_attr(lw, a, cid)
            if key != 0:
                ret key
            end
            continue
        end
        if (k == at.AST_IF and ln_rx_is_comp(a, cid)) or k == at.AST_LAYOUT_BLOCK:
            key2 := ws_row_key(
                lw, a, at.KindOf(a, cid) == at.AST_LAYOUT_BLOCK ? cid : at.Get(a, cid).b
            )
            if key2 != 0:
                ret key2
            end
        else k == at.AST_IF:
            // Transparent control wrappers in expanded output: search branches conservatively.
            key3 := ws_row_key(lw, a, at.Get(a, cid).b)
            if key3 != 0:
                ret key3
            end
            c := at.Get(a, cid).c
            if c != 0:
                if at.KindOf(a, c) == at.AST_IF:
                    key4 := ws_row_key(lw, a, c)
                    if key4 != 0:
                        ret key4
                    end
                else:
                    key5 := ws_row_key(lw, a, c)
                    if key5 != 0:
                        ret key5
                    end
                end
            end
        end
    end
    ret 0
end

func ws_keys(lw &: LoLower, wc &: WsCtx, a &: at.Ast, nid: int):
    if nid == 0:
        ret
    end
    n := at.Get(a, nid)
    if ln_rx_is_comp(a, nid) and ws_kind(ws_mark_index(nid)) != WS_MULTI:
        ret
    end
    if n.kind == at.AST_EACH and ws_has_multi(a, n.b):
        num := ln_dyn_num(val_str(a, n.a))
        if num >= 0 and num < lw.slots.Len():
            mut key := ws_row_key(lw, a, n.b)
            if key == 0:
                mut sl := lw.slots.Get(num)
                if sl.key != 0 and at.KindOf(a, sl.key) == at.AST_IDENTIFIER and str.Equals(
                    at.Get(a, sl.key).name, "_"
                ):
                    sl.key = 0
                end
                if sl.key == 0:
                    if n.c != 0 and at.KindOf(a, n.c) == at.AST_IDENTIFIER and not str.Equals(
                        at.Get(a, n.c).name, "_"
                    ):
                        sl.key = n.c
                    else:
                        sl.key = lo_ident(a, "__salam_ix_" + co.U64Toa(num as u64), nid)
                    end
                    lw.slots.Set(num, sl)
                end
                key = sl.key
            end
            wc.ekey_num.Push(num)
            wc.ekey_expr.Push(key)
        end
    end
    ws_keys(lw, wc, a, n.b)
    ws_keys(lw, wc, a, n.c)
    repeat n.list.Len() in i:
        ws_keys(lw, wc, a, n.list.Get(i))
    end
end

func ws_ekey(wc &: WsCtx, num: int): int:
    repeat wc.ekey_num.Len() in i:
        if wc.ekey_num.Get(i) == num:
            ret wc.ekey_expr.Get(i)
        end
    end
    ret 0
end

func ws_ids(a &: at.Ast, nid: int):
    if nid == 0:
        ret
    end
    n := at.Get(a, nid)
    if n.kind == at.AST_LAYOUT_ATTR:
        mut key := sm.LayoutAttrKey(n.name)
        if str.Len(key) == 0:
            key = n.name
        end
        if n.a != 0 and str.Equals(key, "id") and at.KindOf(a, n.a) == at.AST_LITERAL:
            v := at.Get(a, n.a)
            if v.value_kind == tok.TV_STRING:
                mut seen := false
                each old in g_lo_ws_ids:
                    if str.Equals(old, v.value_str):
                        seen = true
                    end
                end
                if not seen:
                    g_lo_ws_ids.Push(v.value_str)
                end
            end
        end
        ret
    end
    ws_ids(a, n.b)
    ws_ids(a, n.c)
    repeat n.list.Len() in i:
        ws_ids(a, n.list.Get(i))
    end
end

func ws_slot(lw &: LoLower, expr: int): str:
    idx := lw.slots.Len()
    lw.slots.Push(LoSlot { kind = SL_TEXT, expr = expr })
    ret ln_dyn_name(idx)
end

func ws_chunk(chunks &: Vector<str>, text: str): str:
    line := "__salam_h += __salam_chunk_" + co.U64Toa(chunks.Len() as u64) + "\n"
    chunks.Push(text)
    ret line
end

func ws_text(wc &: WsCtx, chunks &: Vector<str>, text: str): str:
    if wc.multi.Len() == 0:
        ret ws_chunk(chunks, text)
    end
    pat := "=\"__sl_ev_"
    mut out := ""
    mut p := 0
    n := str.Len(text)
    guarded := "=\"" + K_LO_EV_NO_RELOAD + "__sl_ev_"
    until p < n:
        mut q := str.IndexFrom(text, pat, p)
        g := str.IndexFrom(text, guarded, p)
        if g >= 0 and (q < 0 or g < q):
            q = g
        end
        if q < 0:
            break
        end
        out += ws_chunk(chunks, str.Substr(text, p, q + 2 - p))
        each mi in wc.multi:
            ms := co.U64Toa(mi as u64)
            out += "__salam_h += \"salamWsAt(" + ms + ",\" + salamWsCur(" + ms + ") + \");\"\n"
        end
        p = q + 2
    end
    if p < n:
        out += ws_chunk(chunks, str.Substr(text, p, n - p))
    end
    ret out
end

func ws_is_render(n: int): bool:
    ret n < g_lo_ws_kind.Len() and g_lo_ws_kind.Get(n) == LI_RENDER
end

func ws_inst_has(inst: int, render: bool): bool:
    repeat g_lo_ws_inst.Len() in n:
        if g_lo_ws_inst.Get(n) == inst and ws_is_render(n) == render:
            ret true
        end
    end
    ret false
end

func ws_stores(lw &: LoLower, a &: at.Ast, nm: LnNames, inst: int, tn: str, render: bool): str:
    mut s := ""
    repeat g_lo_ws_inst.Len() in n:
        if g_lo_ws_inst.Get(n) != inst or ws_is_render(n) != render:
            continue
        end
        decl := g_lo_ws_decl.Get(n)
        wn := ws_name(n)
        tmp := "__salam_i_" + co.U64Toa(n as u64)
        s += tmp + " := " + ws_slot(lw, at.Clone(a, at.Get(a, decl).a)) + "\n"
        s += "if " + tn + " < " + wn + "." + nm.len + "():\n"
        s += wn + "[" + tn + "] = " + tmp + "\n"
        s += "else:\n"
        s += wn + "." + nm.push + "(" + tmp + ")\n"
        s += "end\n"
    end
    ret s
end

func ws_enter(lw &: LoLower, wc &: WsCtx, a &: at.Ast, nm: LnNames, inst: int): str:
    is := co.U64Toa(inst as u64)
    mut parts := ""
    each mi in wc.multi:
        if str.Len(parts) > 0:
            parts += " + \"/\" + "
        end
        parts += "(\"\" + salamWsCur(" + co.U64Toa(mi as u64) + "))"
    end
    each en in wc.ctl:
        if en < 0:
            continue
        end
        ke := ws_ekey(wc, en)
        if ke == 0:
            continue
        end
        if str.Len(parts) > 0:
            parts += " + \"/\" + "
        end
        parts += "(\"\" + " + ws_slot(lw, at.Clone(a, ke)) + ")"
    end
    if str.Len(parts) == 0:
        parts = "\"\""
    end
    tn := "__salam_t_" + is
    mut s := "salamWsSlot(" + is + ", " + parts + ")\n"
    s += tn + " := salamWsCur(" + is + ")\n"
    if ws_inst_has(inst, false):
        s += "if salamWsFresh():\n"
        s += ws_stores(lw, a, nm, inst, tn, false)
        s += "end\n"
    end
    s += ws_stores(lw, a, nm, inst, tn, true)
    ret s
end

func ws_rm_off(wc &: WsCtx):
    repeat wc.rm_ok.Len() in k:
        wc.rm_ok[k] = false
    end
end

func ws_rm_token(ns: str): str:
    ret char_from_code(1) + "D" + ns + char_from_code(1)
end

func ws_rm_close(
    num: int, ok: bool, memo: int, fixed: str, dyns: str, curs: str, seg: str
): str:
    soh := char_from_code(1)
    ens := soh + "E" + soh
    ene := soh + "e" + soh
    mut enter := ""
    mut rest := ""
    mut p := 0
    n := str.Len(seg)
    until p < n:
        q := str.IndexFrom(seg, ens, p)
        if q < 0:
            rest += str.Substr(seg, p, n - p)
            break
        end
        rest += str.Substr(seg, p, q - p)
        r := str.IndexFrom(seg, ene, q + 3)
        if r < 0:
            rest += str.Substr(seg, q + 3, n - q - 3)
            break
        end
        enter += str.Substr(seg, q + 3, r - q - 3)
        p = r + 3
    end
    mut names := Vector {} as Vector<str>
    mut kinds := Vector {} as Vector<str>
    mut d := 0
    dn := str.Len(dyns)
    until d < dn:
        c := str.IndexFrom(dyns, ",", d)
        if c < 0:
            break
        end
        kinds.Push(str.Substr(dyns, d, 1))
        names.Push(str.Substr(dyns, d + 1, c - d - 1))
        d = c + 1
    end
    repeat names.Len() in k:
        rest = str.Replace(rest, ws_rm_token(names[k]), (ok ? "__salam_v_" : "__salam_dyn_") + names[k])
    end
    if not ok:
        names.Free()
        kinds.Free()
        ret enter + rest
    end
    if memo >= 0:
        is := co.U64Toa(memo as u64)
        mut m := str.Replace(enter, "salamWsSlot(" + is + ", ", "salamWsMemo(" + is + ", ")
        mut late := ""
        repeat names.Len() in k:
            v := "__salam_v_" + names[k]
            if str.IndexOf(fixed, "," + names[k] + ",") >= 0:
                late += v + " := __salam_dyn_" + names[k] + "\n"
                continue
            end
            m += v + " := __salam_dyn_" + names[k] + "\n"
            if str.Equals(kinds[k], "b"):
                m += "salamWsArgB(" + v + ")\n"
            else:
                m += "salamWsArgS(" + ws_key_text(kinds[k], v) + ")\n"
            end
        end
        names.Free()
        kinds.Free()
        m += "if salamWsSame():\n"
        m += "__salam_h = salamWsGot()\n"
        m += "else:\n"
        m += late
        m += rest
        m += "salamWsSave(__salam_h)\n"
        m += "end\n"
        ret m
    end
    ns := co.U64Toa(num as u64)
    mk := "__salam_mk_" + ns
    mut s := enter
    mut key := "\"\""
    mut first := "-1"
    mut c2 := 0
    cn := str.Len(curs)
    until c2 < cn:
        c := str.IndexFrom(curs, ",", c2)
        if c < 0:
            break
        end
        cur1 := "salamWsCur(" + str.Substr(curs, c2, c - c2) + ")"
        if str.Equals(first, "-1"):
            first = cur1
        end
        key += " + \",\" + " + cur1
        c2 = c + 1
    end
    repeat names.Len() in k:
        s += "__salam_v_" + names[k] + " := __salam_dyn_" + names[k] + "\n"
        if str.Equals(kinds[k], "b"):
            key += " + (__salam_v_" + names[k] + " ? \"1\" : \"0\")"
        else:
            key += " + salamWsMk(" + ws_key_text(kinds[k], "__salam_v_" + names[k]) + ")"
        end
    end
    names.Free()
    kinds.Free()
    s += mk + " := " + key + "\n"
    s += "if salamWsHit(" + ns + ", " + first + ", " + mk + "):\n"
    s += "__salam_h = salamWsGot()\n"
    s += "else:\n"
    s += rest
    s += "salamWsPut(" + ns + ", " + first + ", " + mk + ", __salam_h)\n"
    s += "end\n"
    ret s
end

func ws_has_each_key(wc &: WsCtx): bool:
    each en in wc.ctl:
        if en >= 0 and ws_ekey(wc, en) != 0:
            ret true
        end
    end
    ret false
end

func ws_pm_key_name(wc &: WsCtx, a &: at.Ast, name: str): bool:
    each en in wc.ctl:
        if en < 0:
            continue
        end
        ke := ws_ekey(wc, en)
        if ke != 0 and at.KindOf(a, ke) == at.AST_IDENTIFIER and str.Equals(at.Get(a, ke).name, name):
            ret true
        end
    end
    ret false
end

func ws_pm_stable(lw &: LoLower, wc &: WsCtx, a &: at.Ast, nid: int, inst: int): bool:
    if nid == 0:
        ret true
    end
    n := at.Get(a, nid)
    if n.kind == at.AST_LAMBDA or n.kind == at.AST_MEMBER or n.kind == at.AST_INDEX:
        ret false
    end
    if n.kind == at.AST_IDENTIFIER:
        if not str.StartsWith(n.name, "__salam_ws_"):
            ret false
        end
        k := str.Substr(n.name, 11, str.Len(n.name) - 11).ToInt()
        if k < 0 or k >= g_lo_ws_inst.Len() or g_lo_ws_inst.Get(k) != inst or not ws_is_render(k):
            ret false
        end
        init := at.Get(a, g_lo_ws_decl.Get(k)).a
        ret init != 0 and at.KindOf(a, init) == at.AST_IDENTIFIER and
            ws_pm_key_name(wc, a, at.Get(a, init).name)
    end
    if n.kind == at.AST_CALL:
        if n.a == 0 or at.KindOf(a, n.a) != at.AST_IDENTIFIER or
            not str.Equals(at.Get(a, n.a).name, "salamWsCur") or n.list.Len() != 1:
            ret false
        end
        arg := at.Get(a, n.list.Get(0))
        ret arg.kind == at.AST_LITERAL and arg.name.ToInt() == inst
    end
    if not ws_pm_stable(lw, wc, a, n.a, inst) or not ws_pm_stable(lw, wc, a, n.b, inst) or
        not ws_pm_stable(lw, wc, a, n.c, inst) or not ws_pm_stable(lw, wc, a, n.d, inst):
        ret false
    end
    repeat n.list.Len() in i:
        if not ws_pm_stable(lw, wc, a, n.list.Get(i), inst):
            ret false
        end
    end
    ret true
end

func ws_pm_fixed(lw &: LoLower, wc &: WsCtx, a &: at.Ast, inst: int, dyns: str): str:
    mut out := ","
    if inst < 0:
        ret out
    end
    mut d := 0
    dn := str.Len(dyns)
    until d < dn:
        c := str.IndexFrom(dyns, ",", d)
        if c < 0:
            break
        end
        name := str.Substr(dyns, d + 1, c - d - 1)
        num := name.ToInt()
        if num >= 0 and num < lw.slots.Len() and ws_pm_stable(lw, wc, a, lw.slots.Get(num).expr, inst):
            out += name + ","
        end
        d = c + 1
    end
    ret out
end

func ws_may_be_null(a &: at.Ast, sl: LoSlot): bool:
    if sl.req or
        (sl.kind != SL_TEXT and sl.kind != SL_ATTR and sl.kind != SL_URL and
            sl.kind != SL_URL_TEXT):
        ret false
    end
    k := at.KindOf(a, sl.expr)
    ret k == at.AST_IDENTIFIER or k == at.AST_MEMBER or k == at.AST_INDEX or k == at.AST_CALL or
        k == at.AST_TERNARY or k == at.AST_MATCH
end

func ws_key_text(kind: str, v: str): str:
    if str.Equals(kind, "o"):
        ret "(salamWsHas(" + v + ") ? \"\" + salamWsVal(" + v + ") : \"\\x01\")"
    end
    ret "\"\" + " + v
end

func ws_view_source(
    lw &: LoLower,
    wc &: WsCtx,
    a &: at.Ast,
    nm: LnNames,
    i: int,
    doc: str,
    chunks &: Vector<str>,
    wu &: WsUse
): str:
    wc.ctl.Clear()
    wc.multi.Clear()
    wc.rm_at.Clear()
    wc.rm_num.Clear()
    wc.rm_ok.Clear()
    wc.rm_dyn.Clear()
    wc.rm_cur.Clear()
    wc.rm_pm.Clear()
    mut body := "mut __salam_h := \"\"\n"
    if ws_kind(i) == WS_SINGLE:
        repeat g_lo_ws_inst.Len() in rn:
            if g_lo_ws_inst.Get(rn) == i and ws_is_render(rn):
                body += ws_name(rn) + " = " + ws_slot(
                    lw, at.Clone(a, at.Get(a, g_lo_ws_decl.Get(rn)).a)
                ) + "\n"
            end
        end
    else ws_kind(i) == WS_REGION:
        repeat g_lo_ws_inst.Len() in rn:
            if g_lo_ws_inst.Get(rn) == i and ws_is_render(rn):
                body += ws_name(rn) + " = " + ws_slot(
                    lw, at.Clone(a, at.Get(a, g_lo_ws_decl.Get(rn)).a)
                ) + "\n"
            end
        end
    end
    mut p := 0
    mut start := 0
    n := str.Len(doc)
    stx := char_from_code(2)
    until p < n:
        q := str.IndexFrom(doc, stx, p)
        if q < 0:
            break
        end
        mut tag := ""
        mut num := 0
        after := lo_marker_at(doc, q, tag, num)
        if after < 0:
            p = q + 1
            continue
        end
        mut cutp := q
        mut head := ""
        mut tail := ""
        mut did_cut := false
        mut opt := false
        if str.Equals(tag, "dyn") and num >= 0 and num < lw.slots.Len():
            os := lw.slots.Get(num)
            keyed := q >= 10 and str.Equals(str.Substr(doc, q - 10, 10), "data-key=\"")
            opt = not keyed and ws_may_be_null(a, os)
            if opt:
                did_cut = lo_opt_cut(doc, os.kind, q, after, start, cutp, head, tail)
            end
        end
        if cutp > start:
            body += ws_text(wc, chunks, str.Substr(doc, start, cutp - start))
        end
        if (str.Equals(tag, "dyn") or str.Equals(tag, "bad")) and num >= 0 and num < lw.slots.Len():
            sl := lw.slots.Get(num)
            ns := co.U64Toa(num as u64)
            mut dn := "__salam_dyn_" + ns
            if wc.rm_at.Len() > 0:
                if str.Equals(tag, "bad") or sl.kind == SL_IF or sl.kind == SL_EACH or
                    sl.kind == SL_STD:
                    ws_rm_off(wc)
                else:
                    dn = ws_rm_token(ns)
                    top := wc.rm_dyn.Len() - 1
                    wc.rm_dyn[top] = wc.rm_dyn[top] + (sl.kind == SL_BOOL ? "b" : (opt ? "o" : "t")) +
                        ns + ","
                end
            end
            if opt:
                wu.opt = true
                body += "__salam_ov_" + ns + " := " + dn + "\n"
                body += "if salamWsHas(__salam_ov_" + ns + "):\n"
                if did_cut:
                    body += ws_text(wc, chunks, head)
                end
                dn = "salamWsVal(__salam_ov_" + ns + ")"
            end
            switch sl.kind:
                SL_IF:
                    body += "if " + dn + ":\n"
                    wc.ctl.Push(-1)
                    break
                end
                SL_EACH:
                    mut head := "each "
                    if sl.key != 0:
                        head += "__salam_key_" + ns + ", "
                    end
                    body += head + "__salam_item_" + ns + " in " + dn + ":\n"
                    body += "__salam_ro_" + ns + " := __salam_h\n__salam_h = \"\"\nsalamWsRowIn()\n"
                    wc.ctl.Push(num)
                    wc.rm_at.Push(str.Len(body))
                    wc.rm_num.Push(num)
                    wc.rm_ok.Push(true)
                    wc.rm_dyn.Push("")
                    mut cur := ""
                    each mi in wc.multi:
                        cur += co.U64Toa(mi as u64) + ","
                    end
                    wc.rm_cur.Push(cur)
                    wc.rm_pm.Push(-1)
                    break
                end
                SL_BAD:
                    break
                end
                SL_BOOL:
                    body += "if " + dn + ":\n"
                    body += ws_chunk(chunks, " " + sl.out)
                    body += "end\n"
                    break
                end
                SL_URL:
                    wu.url = true
                    body += "__salam_h += salamWsUrl(\"\" + " + dn + ")\n"
                    break
                end
                SL_STD:
                    wu.std = true
                    g_lo_ws_std = true
                    body += "__salam_h += salamWsStyle(" + co.I64Toa(
                        sl.prop as i64
                    ) + ", " + co.I64Toa(
                        sl.state as i64
                    ) + ", \"\" + " + dn + ")\n"
                    break
                end
                SL_CSS, SL_CSSURL:
                    wu.css = true
                    body += "__salam_h += salamWsCss(\"\" + " + dn + ")\n"
                    break
                end
                else:
                    body += "__salam_h += salamWsHtml(\"\" + " + dn + ")\n"
                end
            end
            if opt:
                if did_cut and str.Len(tail) > 0:
                    body += ws_text(wc, chunks, tail)
                end
                body += "end\n"
            end
        else str.Equals(tag, "else"):
            body += "else:\n"
        else str.Equals(tag, "end"):
            if wc.ctl.Len() > 0 and wc.ctl.Get(wc.ctl.Len() - 1) >= 0:
                en := co.U64Toa(wc.ctl.Get(wc.ctl.Len() - 1) as u64)
                if wc.rm_at.Len() > 0:
                    at0 := wc.rm_at.Pop()
                    rn := wc.rm_num.Pop()
                    ok := wc.rm_ok.Pop()
                    dl := wc.rm_dyn.Pop()
                    cl := wc.rm_cur.Pop()
                    pm := wc.rm_pm.Pop()
                    fixed := ws_pm_fixed(lw, wc, a, pm, dl)
                    body = str.Substr(body, 0, at0) + ws_rm_close(
                        rn, ok, pm, fixed, dl, cl, str.Substr(body, at0, str.Len(body) - at0)
                    )
                end
                body += "__salam_h = __salam_ro_" + en + " + salamWsRowOut(__salam_h)\n"
            end
            body += "end\n"
            if wc.ctl.Len() > 0:
                _c := wc.ctl.Pop()
            end
        else str.Equals(tag, "wsin") and num >= 0:
            if wc.rm_at.Len() > 0:
                if ws_inst_has(num, false):
                    ws_rm_off(wc)
                end
                top2 := wc.rm_cur.Len() - 1
                wc.rm_cur[top2] = wc.rm_cur[top2] + co.U64Toa(num as u64) + ","
                if wc.rm_pm[top2] == -1 and wc.multi.Len() == 0 and ws_has_each_key(wc) and
                    not ws_inst_has(num, false):
                    wc.rm_pm[top2] = num
                else:
                    wc.rm_pm[top2] = -2
                end
                body += char_from_code(1) + "E" + char_from_code(1) + ws_enter(lw, wc, a, nm, num) +
                    char_from_code(1) + "e" + char_from_code(1)
            else:
                body += ws_enter(lw, wc, a, nm, num)
            end
            wc.multi.Push(num)
        else str.Equals(tag, "wsout"):
            if wc.multi.Len() > 0:
                _m := wc.multi.Pop()
            end
        end
        p = after
        start = after
        if did_cut:
            start += str.Len(tail)
            p = start
        end
    end
    if start < n:
        body += ws_text(wc, chunks, str.Substr(doc, start, n - start))
    end
    ret "func __salam_view_" + co.U64Toa(i as u64) + "(): " + nm.t_str + ":\n" + body +
        "ret __salam_h\nend\n\n"
end

func ws_type_text(nm: LnNames, n: int): str:
    lit := n < g_lo_ws_lit.Len() ? g_lo_ws_lit.Get(n) : ""
    if str.Equals(lit, "int"):
        ret nm.t_int
    end
    if str.Equals(lit, "f64"):
        ret nm.t_f64
    end
    if str.Equals(lit, "str"):
        ret nm.t_str
    end
    if str.Equals(lit, "bool"):
        ret nm.t_bool
    end
    ret "__salam_wtype_" + co.U64Toa(n as u64)
end

func ws_synthetic_type(a &: at.Ast, nid: int):
    if nid == 0:
        ret
    end
    mut n := at.Get(a, nid)
    if n.kind == at.AST_TYPE:
        n.synthetic = true
        at.Put(a, nid, n)
    end
    ws_synthetic_type(a, n.ty)
    ws_synthetic_type(a, n.a)
    ws_synthetic_type(a, n.b)
    ws_synthetic_type(a, n.c)
    repeat n.list.Len() in i:
        ws_synthetic_type(a, n.list.Get(i))
    end
end

func ws_fix_types(a &: at.Ast, nid: int):
    if nid == 0:
        ret
    end
    n := at.Get(a, nid)
    if n.kind == at.AST_TYPE and str.StartsWith(n.name, "__salam_wtype_"):
        gi := str.Substr(n.name, 14, str.Len(n.name) - 14).ToInt()
        if gi >= 0 and gi < g_lo_ws_type.Len() and g_lo_ws_type.Get(gi) != 0:
            cp := at.Clone(a, g_lo_ws_type.Get(gi))
            at.Put(a, nid, at.Get(a, cp))
            mut cn := at.Get(a, cp)
            cn.list = Vector {} as Vector<int>
            cn.ext = 0
            at.Put(a, cp, cn)
            ws_synthetic_type(a, nid)
        end
        ret
    end
    ws_fix_types(a, n.ty)
    ws_fix_types(a, n.a)
    ws_fix_types(a, n.b)
    ws_fix_types(a, n.c)
    repeat n.list.Len() in i:
        ws_fix_types(a, n.list.Get(i))
    end
end

func ws_constant_init(a &: at.Ast, nid: int): bool:
    if nid == 0:
        ret false
    end
    n := at.Get(a, nid)
    if n.kind == at.AST_UNARY:
        ret ws_constant_init(a, n.a)
    end
    ret n.kind == at.AST_LITERAL and n.value_kind != tok.TV_STRING
end

func ws_zero_global(a &: at.Ast, vid: int):
    mut vn := at.Get(a, vid)
    late := vn.a
    if late == 0 or at.KindOf(a, late) != at.AST_CAST or at.KindOf(
        a, at.Get(a, late).a
    ) != at.AST_LITERAL:
        ret
    end
    vn.ty = at.Get(a, late).ty
    vn.a = 0
    at.Put(a, vid, vn)
end

func ws_header(lw &: LoLower, a &: at.Ast, nm: LnNames, count: int, wu: WsUse): str:
    s := nm.t_str
    mut t := ""
    if not g_lo_ssr:
        t += "extern:\n"
        t += "    func salamWsHtml(__salam_s: " + s + "): " + s + "\n"
        if wu.url:
            t += "    func salamWsUrl(__salam_s: " + s + "): " + s + "\n"
        end
        if wu.css:
            t += "    func salamWsCss(__salam_s: " + s + "): " + s + "\n"
        end
        if wu.std:
            t += "    func salamWsStyle(__salam_p: " + nm.t_int + ", __salam_t: " + nm.t_int +
                ", __salam_s: " + s + "): " + s + "\n"
        end
        t += "    func salamWsTouch(__salam_i: " + nm.t_int + ")\n"
        t += "    func salamWsRow(__salam_o: " + nm.t_bool + "): " + s + "\n"
        t += "    func salamWsRowIn()\n"
        t += "    func salamWsRowOut(__salam_s: " + s + "): " + s + "\n"
        t += "    func salamWsHit(__salam_i: " + nm.t_int + ", __salam_c: " + nm.t_int + ", __salam_k: " + s + "): " +
            nm.t_bool + "\n"
        t += "    func salamWsGot(): " + s + "\n"
        t += "    func salamWsPut(__salam_i: " + nm.t_int + ", __salam_c: " + nm.t_int + ", __salam_k: " + s +
            ", __salam_v: " + s + ")\n"
        t += "    func salamWsMk(__salam_s: " + s + "): " + s + "\n"
        if ws_has_multi_inst():
            t += "    func salamWsMemo(__salam_i: " + nm.t_int + ", __salam_k: " + s + ")\n"
            t += "    func salamWsArgB(__salam_v: " + nm.t_bool + ")\n"
            t += "    func salamWsArgS(__salam_v: " + s + ")\n"
            t += "    func salamWsSame(): " + nm.t_bool + "\n"
            t += "    func salamWsSave(__salam_s: " + s + ")\n"
        end
        if ws_has_multi_inst():
            t += "    func salamWsCur(__salam_i: " + nm.t_int + "): " + nm.t_int + "\n"
            t += "    func salamWsSlot(__salam_i: " + nm.t_int + ", __salam_k: " + s + ")\n"
            t += "    func salamWsFresh(): " + nm.t_bool + "\n"
        end
        t += "end\n\n"
    end
    if wu.opt:
        t += "func salamWsHas<T>(__salam_o: T?): " + nm.t_bool +
            ":\n    ret __salam_o.present\nend\n\n"
        t += "func salamWsHas<T>(_o: T): " + nm.t_bool + ":\n    ret true\nend\n\n"
        t += "func salamWsVal<T>(__salam_o: T?): T:\n    ret __salam_o.value\nend\n\n"
        t += "func salamWsVal<T>(__salam_o: T): T:\n    ret __salam_o\nend\n\n"
    end
    repeat g_lo_ws_inst.Len() in n:
        if ws_kind(g_lo_ws_inst.Get(n)) == WS_MULTI:
            t += "mut " + ws_name(n) + " := " + nm.vec + " {} as " + nm.vec + "<" +
                ws_type_text(nm, n) + ">\n"
            continue
        end
        decl := g_lo_ws_decl.Get(n)
        if ws_constant_init(a, at.Get(a, decl).a):
            t += "mut " + ws_name(n) + " := " + ws_slot(lw, at.Clone(a, at.Get(a, decl).a)) + "\n"
        else:
            t += "mut " + ws_name(n) + " := 0 as " + ws_type_text(nm, n) + "\n"
        end
    end
    t += "\n"
    repeat count in i:
        if ws_kind(i) != WS_SINGLE:
            continue
        end
        t += "func __salam_init_" + co.U64Toa(i as u64) + "():\n"
        repeat g_lo_ws_inst.Len() in n2:
            if g_lo_ws_inst.Get(n2) == i:
                decl2 := g_lo_ws_decl.Get(n2)
                t += "    " + ws_name(n2) + " = " + ws_slot(
                    lw, at.Clone(a, at.Get(a, decl2).a)
                ) + "\n"
            end
        end
        t += "end\n\n"
    end
    ret t
end

func ws_insert(list &: Vector<int>, a &: at.Ast, items: Vector<int>, min_phase: int):
    mut out := Vector {} as Vector<int>
    mut placed := false
    each item in list:
        ph := at.ToplevelOrderPhase(a, item)
        if not placed and ph >= min_phase:
            each x in items:
                out.Push(x)
            end
            placed = true
        end
        out.Push(item)
    end
    if not placed:
        each x2 in items:
            out.Push(x2)
        end
    end
    list.Clear()
    each y in out:
        list.Push(y)
    end
    out.Free()
end

func ws_dev_ident(name: str): bool:
    if str.Len(name) == 0 or str.StartsWith(name, "__"):
        ret false
    end
    repeat str.Len(name) in i:
        c := str.CharAt(name, i)
        digit := str.Contains("0123456789", c)
        alpha := str.Contains("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_", c)
        if not alpha and not (digit and i > 0):
            ret false
        end
    end
    ret true
end

func ws_dev_snippet(): str:
    names := str.Split(g_lo_dev_names, ",")
    mut get := ""
    mut set := ""
    each n in names:
        get += "o." + n + "=" + n + ";"
        set += "if(__salamFit(o." + n + "," + n + ")){" + n + "=o." + n + ";}"
    end
    mut t := "function __salamFit(x,y){if(typeof x!==typeof y){return false;}if(Array.isArray(x)!==Array.isArray(y)){return false;}"
    t += "if(Array.isArray(x)){if(x.length>0&&y.length>0){return __salamFit(x[0],y[0]);}return true;}"
    t += "if(x&&y&&typeof x===\"object\"){return Object.keys(x).sort().join()===Object.keys(y).sort().join();}return true;}\n"
    t += "window.__salamDev={get:function(){var o={};" + get +
        "return o;},set:function(o){if(!o){return;}" + set + "}};\n"
    t += "if(window.__salamDevRestore){try{window.__salamDev.set(window.__salamDevRestore);}catch(x){}window.__salamDevRestore=null;}\n"
    ret t
end

pub func WebStateCount(): int:
    ret g_lo_wi_mark.Len()
end

pub func WebStateKind(i: int): int:
    ret ws_kind(i)
end

pub func WebStateIds(): Vector<str>:
    ret g_lo_ws_ids
end

pub func WebStateCss(): str:
    ret g_lo_ws_css
end

pub func PrepareWebState(log: lg.Logger, pack: lp.Langpack, a &: at.Ast, prog: int, file: str): int:
    if prog == 0:
        ret 0
    end
    lo_em_reset()
    g_lo_em_keep = true
    lo_env_inject(log, a, prog)
    lb := find_layout_block(a, prog)
    if lb == 0:
        ret 0
    end
    mut lw := LoLower { prog = prog }
    defer lw.slots.Free()
    defer lw.shadow.Free()
    defer lw.funcs.Free()
    lo_collect_funcs(lw, a, prog)
    lo_shadow_globals(lw, a, prog)
    repeat g_lo_ws_inst.Len() in n:
        lw.shadow.Push(ws_name(n))
    end
    mut r := LnReact {}
    defer ln_rx_free(r)
    ln_rx_init(r, a, prog)
    g_lo_dev_names = ""
    if str.Len(os.Env("SALAM_DEV_HMR")) > 0:
        each sn in r.states:
            if ws_dev_ident(sn):
                g_lo_dev_names += (str.Len(g_lo_dev_names) > 0 ? "," : "") + sn
            end
        end
    end
    if r.states.Len() > 0 or ws_counts_runs(a, lb):
        ws_regions(r, a, lb)
    end
    count := g_lo_wi_mark.Len()
    if count == 0:
        ret 0
    end
    nm := ln_names(pack)
    is_fa := str.Equals(lp.Code(pack), "fa")
    mut wc := WsCtx {}
    defer ws_free(wc)
    repeat count:
        wc.owner.Push(-1)
        wc.done.Push(false)
    end
    mut order := Vector {} as Vector<int>
    defer order.Free()
    repeat count in oi:
        ws_order(wc, a, oi, order)
    end
    mut chunks := Vector {} as Vector<str>
    defer chunks.Free()
    mut wu := WsUse {}
    mut views := ""
    mut quiet := dg.NewDefault(0, false, 0)
    lw.live = true
    each i in order:
        m := g_lo_wi_mark.Get(i)
        body := at.Get(a, m).b
        sm.LayoutResolve(a, body)
        lo_walk(lw, a, body, 0, -1)
        ws_owned(wc, a, body, i)
        mut deps := Vector {} as Vector<int>
        ws_deps_in(r, lw, a, body, deps)
        each d in deps:
            wc.dep_inst.Push(i)
            wc.dep_id.Push(d)
        end
        deps.Free()
        mut wdeps := Vector {} as Vector<int>
        ws_ws_deps_in(lw, a, body, wdeps)
        each wd in wdeps:
            if wd >= 0 and wd < g_lo_ws_inst.Len() and ws_owner_of(wc, g_lo_ws_inst.Get(wd)) != i:
                wc.wsd_inst.Push(i)
                wc.wsd_n.Push(wd)
            end
        end
        wdeps.Free()
        ws_keys(lw, wc, a, body)
        ws_ids(a, body)
        vb := at.NewNode(a, at.AST_LAYOUT_BLOCK)
        copy_span(a, vb, m)
        at.SetName(a, vb, "__salam_view_" + co.U64Toa(i as u64))
        gen_std_view_page(a, lb, vb)
        mut kept := Vector {} as Vector<int>
        repeat at.ChildCount(a, body) in c:
            cid := at.Child(a, body, c)
            if at.KindOf(a, cid) != at.AST_VAR_DECL:
                kept.Push(cid)
                at.AddChild(a, vb, cid)
            end
        end
        sm.LayoutResolve(a, vb)
        g_lo_cls_prefix = "s" + co.U64Toa(i as u64) + "-"
        g_lo_skip_base = true
        res := Generate(log, quiet, file, a, vb, true, lp.Code(pack))
        g_lo_skip_base = false
        g_lo_cls_prefix = ""
        g_lo_ws_css += res.css
        views += ws_view_source(lw, wc, a, nm, i, res.html, chunks, wu)
        mut bn := at.Get(a, body)
        mut oldk := bn.list
        bn.list = kept
        at.Put(a, body, bn)
        oldk.Free()
        mut mn := at.Get(a, m)
        mn.a = mk_str(a, ws_placeholder(i), m)
        at.Put(a, m, mn)
    end
    dg.Free(quiet)
    ws_mark_program(r, wc, a, prog)
    mut text := ws_header(lw, a, nm, count, wu) + views
    if is_fa:
        text = ln_to_fa(text, pack)
    end
    base := at.Count(a)
    sp := ln_parse(log, a, text, file, is_fa ? pack : lp.Load("en"))
    if sp == 0:
        ret 0
    end
    mut front := Vector {} as Vector<int>
    defer front.Free()
    mut gvars := Vector {} as Vector<int>
    defer gvars.Free()
    mut funcs := Vector {} as Vector<int>
    defer funcs.Free()
    repeat at.ChildCount(a, sp) in ci:
        cid := at.Child(a, sp, ci)
        cn := at.Get(a, cid)
        if cn.kind == at.AST_VAR_DECL:
            ws_fix_types(a, cid)
            _vs := lo_splice(lw, a, cid, chunks, lb)
            lo_span_tree(a, cid, lb, base)
            ws_zero_global(a, cid)
            gvars.Push(cid)
        else cn.kind == at.AST_FUNC_DEF and cn.a != 0:
            fbody := lo_splice(lw, a, cn.a, chunks, lb)
            mut fn := at.Get(a, cid)
            fn.a = fbody
            at.Put(a, cid, fn)
            lo_fix_glue_spans(lw, a, fbody, base)
            lo_span_tree(a, cid, lb, base)
            mut fn2 := at.Get(a, cid)
            fn2.file_boundary = funcs.Len() == 0
            at.Put(a, cid, fn2)
            funcs.Push(cid)
        else:
            lo_span_tree(a, cid, lb, base)
            front.Push(cid)
        end
    end
    mut pn := at.Get(a, prog)
    mut list := Vector {} as Vector<int>
    repeat pn.list.Len() in li:
        list.Push(pn.list.Get(li))
    end
    ws_insert(list, a, front, at.AST_ORDER_CONST)
    ws_insert(list, a, gvars, at.AST_ORDER_VAR)
    each f in funcs:
        list.Push(f)
    end
    mut oldl := pn.list
    pn.list = list
    at.Put(a, prog, pn)
    oldl.Free()
    ret count
end

pub func WebStateCacheRuntime(): str:
    ret `var __salam_hydrating = false;
var __salam_calls = {};
var __salam_call_seen = {};
(function () {
    if (typeof document === "undefined" || !document.getElementById) {
        return;
    }
    var el = document.getElementById("__salam");
    if (!el) {
        return;
    }
    try {
        var st = JSON.parse(el.textContent);
        window.__salam_state = st;
        __salam_calls = st && st.calls ? st.calls : {};
        __salam_hydrating = true;
    } catch (x) {
        if (typeof console !== "undefined" && console.warn) {
            console.warn("salam: the embedded page state is not valid, the page renders from scratch");
        }
    }
})();
function __salam_call_hash(text) {
    var h = 2166136261;
    var bytes = unescape(encodeURIComponent(String(text)));
    for (var i = 0; i < bytes.length; i++) {
        h ^= bytes.charCodeAt(i);
        h = Math.imul(h, 16777619) >>> 0;
    }
    return ("00000000" + h.toString(16)).slice(-8);
}
function __salam_call_key(name, args) {
    var base = name + ":" + __salam_call_hash(args);
    var n = __salam_call_seen[base] || 0;
    __salam_call_seen[base] = n + 1;
    return base + ":" + n;
}
function __salam_call_cache_get(key) {
    if (!Object.prototype.hasOwnProperty.call(__salam_calls, key)) {
        return undefined;
    }
    var value = __salam_calls[key];
    delete __salam_calls[key];
    return value;
}
window.__salam_call_key = __salam_call_key;
window.__salam_call_cache_get = __salam_call_cache_get;
`
end

pub func WebStateRuntime(views: Vector<str>, inits: Vector<str>): str:
    mut s := "var __salam_views = ["
    repeat views.Len() in i:
        if i > 0:
            s += ", "
        end
        s += views.Get(i)
    end
    s += "];\nvar __salam_inits = ["
    repeat inits.Len() in j:
        if j > 0:
            s += ", "
        end
        s += inits.Get(j)
    end
    s += "];\n"
    if g_lo_ws_std:
        s += StyleRuntimeJs()
    end
    // TODO(runtime,lifecycle): expose explicit mount/update/unmount/cleanup hook points
    // (per-region/per-keyed-node) aligned with native lifecycle model when host APIs exist.
    // Hook placeholders (optional host integration): window.__salam_lifecycle = { mount, update, unmount, cleanup }
    // Current source-level behavior: regions emit markers and best-effort cleanup on DOM removal; per-keyed-node hooks remain runtime/toolchain-dependent.
    if os.Env("SALAM_UI_TRACE").Len() > 0:
        s += "window.__salam_trace = true;\n"
    end
    s += `window.__salam_runs = 0;
window.__salam_inplace = 0;
var __salam_dirty = [];
var __salam_queued = false;
var __salam_marks = {};
var __salam_cur = {};
var __salam_slots = new Map();
var __salam_free = {};
var __salam_next = {};
var __salam_rendering = "";
var __salam_seen = new Map();
var __salam_wasfresh = false;
var __salam_ready = {};
var __salam_last = {};
var __salam_marked = false;
var __salam_rows = {};
var __salam_keep = [];
var __salam_keeping = false;
var __salam_rf = {};
var __salam_rowbuf = null;
var __salam_rowdep = 0;
var __salam_mm = {};
var __salam_gen = 0;
var __salam_got = "";
var __salam_tabs = {};
var __salam_tab = null;
var __salam_tab_r = null;
var __salam_tab_i = -1;
var __salam_ent = null;
var __salam_argi = 0;
var __salam_miss = false;
var __salam_okc = new Map();
var __salam_pfx = "";
var __salam_pfx_i = -1;
var __salam_pfx_r = null;
var __salam_scnt = {};
var __salam_seen_n = 0;
function __salam_strip(list) {
    var box = document.createElement("div");
    for (var a = 0; a < list.length; a++) {
        box.appendChild(list[a].cloneNode(true));
    }
    var w = document.createTreeWalker(box, NodeFilter.SHOW_COMMENT), c, starts = [];
    while ((c = w.nextNode())) {
        if (/^salam:\d+$/.test(c.data)) {
            starts.push(c);
        }
    }
    for (var k = 0; k < starts.length; k++) {
        var st = starts[k], en = st.parentNode ? __salam_end(st) : null;
        while (en && st.nextSibling && st.nextSibling !== en) {
            st.parentNode.removeChild(st.nextSibling);
        }
    }
    return box;
}
function __salam_check(i, s, e, fresh) {
    var old = [], n = s.nextSibling;
    while (n && n !== e) {
        old.push(n);
        n = n.nextSibling;
    }
    if (!old.length) {
        return;
    }
    if (!__salam_strip(old).isEqualNode(__salam_strip(fresh))) {
        if (typeof console !== "undefined" && console.warn) {
            console.warn("salam: hydration mismatch in region " + i + ", it is rendered again from the state");
        }
    }
}
function salamWsHtml(s) {
    s = String(s);
    if (!/[&<>"'\u0001\u0003\u0004]/.test(s)) {
        return s;
    }
    return s.replace(/[&<>"'\u0001\u0003\u0004]/g, function (c) {
        return c === "&" ? "&amp;" : c === "<" ? "&lt;" : c === ">" ? "&gt;" : c === "\"" ? "&quot;" : c === "'" ? "&#39;" : "&#" + c.charCodeAt(0) + ";";
    });
}
function salamWsUrl(s) {
    var t = String(s).replace(/[\u0000- ]/g, "").toLowerCase();
    return /^(javascript|vbscript|data):/.test(t) ? "#" : salamWsHtml(s);
}
function salamWsCss(s) {
    return salamWsHtml(String(s).replace(/[;{}<>\r\n]/g, ""));
