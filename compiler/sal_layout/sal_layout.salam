package layout

import co "../sal_core.salam"

import lg "../logger.salam"

import lp "../langpack.salam"

import at "../ast.salam"

import cc "../condcomp.salam"

const K_LO_MAX_DEPTH := 64

const K_LO_LEN_MAX_TOKENS := 24

const K_LO_UNIT_CAP := 128

const K_LO_LE_SINGLE := 0

const K_LO_LE_MOTHER := 1

const K_LO_LA_CONTENT := 0

const K_LO_LA_CLASS := 1

const K_LO_LA_HTML := 2

const K_LO_LA_STYLE := 3

const K_LO_LA_DIR := 4

const K_LO_LA_LANG := 5

const K_LO_LA_SOURCE := 6

const K_LO_LA_CSS := 7

const K_LO_LA_META := 8

const K_LO_VT_COLOR := 6

const K_LO_VT_DIR := 7

const K_LO_VT_LANG := 8

const K_LO_VT_ENUM := 9

const K_LO_VT_LENGTH := 10

struct LoExpand:
    pub log: lg.Logger = lg.New(5, false)
    pub pack: lp.Langpack = lp.Load("en")
    pub cctab: cc.Table = cc.TableBuild("", Vector {} as Vector<str>)
    pub errors: int = 0
    pub comp_name: Vector<str> = Vector {}
    pub comp_def: Vector<int> = Vector {}
    pub comp_dir: Vector<str> = Vector {}
    pub comp_mother: Vector<bool> = Vector {}
    pub loaded_path: Vector<str> = Vector {}
    pub loaded_prog: Vector<int> = Vector {}
    pub loaded_dir: Vector<str> = Vector {}
end

struct LoFrame:
    pub present: bool = false
    pub names: Vector<str> = Vector {}
    pub vals: Vector<int> = Vector {}
    pub content: Vector<int> = Vector {}
end

struct LoCtx:
    pub log: lg.Logger = lg.New(5, false)
    pub file: str = ""
    pub html: str = ""
    pub css: str = ""
    pub js: str = ""
    pub head: str = ""
    pub title: str = "Salam Page"
    pub lang: str = "en"
    pub dir: str = "ltr"
    pub css_seen: Vector<str> = Vector {}
    pub cls_keys: Vector<str> = Vector {}
    pub cls_names: Vector<str> = Vector {}
    pub cls_next: int = 0
    pub indent: int = 0
    pub compact: bool = false
end

pub struct Result:
    pub html: str = ""
    pub css: str = ""
    pub js: str = ""
    pub head: str = ""
    pub title: str = "Salam Page"
    pub lang: str = "en"
    pub dir: str = "ltr"
end

inline func byte_at(s: str, i: int): int: ret co.ByteAt(s, i) end

func span_of(a &: at.Ast, id: int): co.SrcSpan:
    n := at.Get(a, id)
    ret co.MakeSpan(
        co.MakePos(n.begin_line, n.begin_col, n.begin_index), co.MakePos(n.end_line, n.end_col, n.end_index), n.length
    )
end

func copy_span(a &: at.Ast, dst: int, from: int):
    n := at.Get(a, from)
    at.SetSpan(
        a, dst, n.begin_line, n.begin_col, n.begin_index, n.end_line, n.end_col, n.end_index, n.length
    )
end
