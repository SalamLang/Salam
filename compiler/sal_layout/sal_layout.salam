inline func byte_at(s: str, i: int): int: ret co.ByteAt(s, i) end

func span_of(a &: at.Ast, id: int): co.SrcSpan:
    n := at.Get(a, id)
    ret co.MakeSpan(
        co.MakePos(n.begin_line, n.begin_col, n.begin_index),
        co.MakePos(n.end_line, n.end_col, n.end_index),
        n.length
    )
end

func copy_span(a &: at.Ast, dst: int, from: int):
    n := at.Get(a, from)
    at.SetSpan(
        a,
        dst,
        n.begin_line,
        n.begin_col,
        n.begin_index,
        n.end_line,
        n.end_col,
        n.end_index,
        n.length
    )
end
