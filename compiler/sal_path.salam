package salpath

import str
import mem

include co "sal_core.salam"

const K_PATH_SEP := 47
const K_PATH_BACKSEP := 92
const K_PATH_DOT := 46
const K_PATH_COLON := 58

inline func byte_at(s: str, i: int): int: ret co.ByteAt(s, i) end

func is_sep(b: int): bool:
    ret b == K_PATH_SEP or b == K_PATH_BACKSEP
end

func collapse_double_sep(p: str): str:
    mut sb := str.NewBuilder()
    mut last := 0
    repeat str.Len(p) in i:
        b := byte_at(p, i)
        if i < 2 or b != K_PATH_SEP or last != K_PATH_SEP:
            str.BufAppendChar(sb, b)
            last = b
        end
    end
    out := str.BufStr(sb)
    str.BufFree(sb)
    ret out
end

func cut_range(q: str, lo: int, hi: int): str:
    mut sb := str.NewBuilder()
    repeat str.Len(q) in i:
        if i < lo or i >= hi:
            str.BufAppendChar(sb, byte_at(q, i))
        end
    end
    out := str.BufStr(sb)
    str.BufFree(sb)
    mem.Free(q as void*)
    ret out
end

func trimmed_len(dir: str): int:
    mut n := str.Len(dir)
    until n > 1 and is_sep(
        byte_at(dir, n - 1)
    ) and not (n == 3 and byte_at(dir, 1) == K_PATH_COLON):
        n--
    end
    ret n
end

func buf_append_slashed(sb &: str.StringBuilder, p: str, lo: int, hi: int):
    mut i := lo
    until i < hi:
        b := byte_at(p, i)
        if b == K_PATH_BACKSEP:
            str.BufAppendChar(sb, K_PATH_SEP)
        else:
            str.BufAppendChar(sb, b)
        end
        i++
    end
end

func slashed_range(p: str, lo: int, hi: int): str:
    mut sb := str.NewBuilder()
    buf_append_slashed(sb, p, lo, hi)
    out := str.BufStr(sb)
    str.BufFree(sb)
    ret out
end

func last_sep(p: str): int:
    mut cut := -1
    repeat str.Len(p) in i:
        if is_sep(byte_at(p, i)):
            cut = i
        end
    end
    ret cut
end

pub func PathIsSep(b: int): bool:
    ret is_sep(b)
end

pub func PathIsAbs(p: str): bool:
    n := str.Len(p)
    if n == 0:
        ret false
    end
    b0 := byte_at(p, 0)
    if is_sep(b0):
        ret true
    end
    if n >= 2 and byte_at(p, 1) == K_PATH_COLON:
        if (b0 >= 65 and b0 <= 90) or (b0 >= 97 and b0 <= 122):
            ret true
        end
    end
    ret false
end

pub func PathToSlash(p: str): str:
    if not str.Contains(p, "\\"):
        ret p
    end
    mut sb := str.NewBuilder()
    repeat str.Len(p) in i:
        b := byte_at(p, i)
        if b == K_PATH_BACKSEP:
            str.BufAppendChar(sb, K_PATH_SEP)
        else:
            str.BufAppendChar(sb, b)
        end
    end
    out := str.BufStr(sb)
    str.BufFree(sb)
    ret out
end

pub func PathTrimSep(p: str): str:
    ret str.Substr(p, 0, trimmed_len(p))
end

pub func PathBase(p: str): str:
    cut := last_sep(p)
    if cut < 0:
        ret str.Clone(p)
    end
    ret str.Substr(p, cut + 1, str.Len(p) - cut - 1)
end

pub func PathStem(p: str): str:
    b := PathBase(p)
    dot := str.LastIndex(b, ".")
    if dot >= 0:
        ret str.Substr(b, 0, dot)
    end
    ret b
end

pub func PathDir(p: str): str:
    cut := last_sep(p)
    if cut < 0:
        ret ""
    end
    ret slashed_range(p, 0, cut)
end

pub func PathJoin(dir: str, name0: str): str:
    n := str.Len(name0)
    mut off := 0
    until off < n and is_sep(byte_at(name0, off)):
        off++
    end
    if str.Len(dir) == 0:
        ret slashed_range(name0, off, n)
    end
    dn := trimmed_len(dir)
    mut sb := str.NewBuilder()
    buf_append_slashed(sb, dir, 0, dn)
    if off < n and not is_sep(byte_at(dir, dn - 1)):
        str.BufAppendChar(sb, K_PATH_SEP)
    end
    buf_append_slashed(sb, name0, off, n)
    out := str.BufStr(sb)
    str.BufFree(sb)
    ret out
end

pub func PathNormalize(p: str): str:
    slashed := PathToSlash(p)
    mut q := collapse_double_sep(slashed)
    if (slashed as void*) != (p as void*):
        mem.Free(slashed as void*)
    end
    until str.Len(q) >= 2 and byte_at(q, 0) == K_PATH_DOT and byte_at(q, 1) == K_PATH_SEP:
        q = cut_range(q, 0, 2)
    end
    mut idx := str.IndexOf(q, "/./")
    until idx >= 0:
        q = cut_range(q, idx + 1, idx + 3)
        idx = str.IndexOf(q, "/./")
    end
    mut dd := str.IndexOf(q, "/../")
    until dd >= 0:
        mut segstart := 0
        mut k := dd - 1
        until k >= 0:
            if byte_at(q, k) == K_PATH_SEP:
                segstart = k + 1
                break
            end
            k--
        end
        seg := str.Substr(q, segstart, dd - segstart)
        keep := str.Len(seg) == 0 or str.Equals(seg, "..") or str.Contains(seg, ":")
        mem.Free(seg as void*)
        if keep:
            dd = str.IndexFrom(q, "/../", dd + 1)
            continue
        end
        q = cut_range(q, segstart, dd + 4)
        dd = str.IndexOf(q, "/../")
    end
    ret q
end
