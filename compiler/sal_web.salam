package web

import io
import str
import mem

include lg "logger.salam"
include i18 "i18n.salam"
include lp "langpack.salam"
include src "source.salam"
include tok "token.salam"
include at "ast.salam"
include ps "parser/parser.salam"
include cc "condcomp.salam"
include sm "semantic/semantic.salam"
include lx "lexer/lexer.salam"
include ip "interp/interp.salam"
include lo "sal_layout/sal_layout.salam"
include dg "diag.salam"
include x "xml.salam"
include cg "codegen/codegen.salam"
include lv "llvmgen/llvmgen.salam"
include tr "cli/cli_translate.salam"
include dr "driver/driver.salam"

mut g_wb_schema_ready := false
mut g_wb_failed := false
mut g_wb_reply := ""
mut g_wb_replied := false

struct FrontEnd:
    pub ok: bool = false
    pub a: at.Ast = at.Ast {}
    pub program: int = 0
    pub s: sm.Sema = sm.Sema {}
    pub entry: str = ""
    pub diag: str = ""
end

func ensure_schema():
    lo.ReuseGeneratorOutput(true)
    dr.ReuseStdScripts(true)
    lo.SetSingleFile(true)
    sm.LayoutForgetReported()
    if not g_wb_schema_ready:
        sm.LayoutSchemaInit(sm.GetStdlibRoot())
        g_wb_schema_ready = true
    end
end

func src_from_string(source: str): src.SourceFile:
    mut sf := src.New()
    sf.path = "main.salam"
    sf.text = source
    sf.len = str.Len(source)
    ret sf
end

func front_end(lgr &: lg.Logger, lang: str, source: str): FrontEnd:
    mut r := FrontEnd {}
    i18.SetLang(lang)
    sm.SetStdlibRoot("")
    pack := lp.Load(lang)
    if pack == lp.LP_NONE:
        r.diag = str.Clone(i18.Tr("unknown language pack"))
        ret r
    end
    r.entry = lp.Entry(pack)
    sf := src_from_string(source)
    lg.SetDiagSource(lgr, sf.text, sf.len, dg.DIAG_STYLE_RUST, dg.DIAG_FORMAT_HUMAN)
    lg.SetCapture(true)

    mut toks := tok.StreamNew(sf.path)
    lok := lx.Run(lgr, pack, sf, toks)
    mut a := at.NewAst()
    mut prog := 0
    mut pok := ps.Run(lgr, toks, a, prog)
    tok.StreamFree(toks)

    mut table := cc.TableBuild("", cc.InterpDefines(Vector {} as Vector<str>))
    cc.TableSetPack(table, pack)
    if not cc.PruneProgram(a, lgr, sf.path, table, prog):
        pok = false
    end

    _eerr := lo.Expand(lgr, pack, table, a, prog, "")
    _vw := lo.PrepareViews(lgr, pack, table, a, prog, sf.path)
    mut s := sm.New(lgr, sf.path, lp.Code(pack))
    sm.SetCc(s, table)
    sok := sm.Run(s, a, prog)
    lg.SetCapture(false)

    r.a = a
    r.program = prog
    sm.Free(r.s)
    r.s = s
    if not lok or not pok or not sok:
        rendered := lg.Captured()
        r.diag = str.Clone(str.Len(rendered) > 0 ? rendered : i18.Tr("compilation failed"))
        ret r
    end
    r.ok = true
    ret r
end

func reply(out: str): str:
    if g_wb_replied:
        mem.Free(g_wb_reply as void*)
    end
    g_wb_reply = out
    g_wb_replied = true
    ret out
end

export:
    func salam_web_run_app(source: str, lang: str): str:
        ret reply(RunApp(source, lang))
    end

    func salam_web_build_layout(source: str, lang: str): str:
        ret reply(BuildLayout(source, lang))
    end

    func salam_web_emit(source: str, lang: str, phase: str): str:
        ret reply(Emit(source, lang, phase))
    end

    func salam_web_version(): str:
        ret Version()
    end

    func salam_web_syntax_ok(source: str, lang: str): str:
        ret reply(SyntaxOk(source, lang))
    end

    func salam_web_translate(source: str, target_lang: str): str:
        ret reply(Translate(source, target_lang))
    end

    func salam_web_std_cache(source: str, lang: str, path: str): str:
        ret reply(StdCache(source, lang, path))
    end

    func salam_web_last_failed(): int:
        ret LastFailed() ? 1 : 0
    end
end

func page_without_entry(source: str, lang: str): bool:
    i18.SetLang(lang)
    pack := lp.Load(lang)
    if pack == lp.LP_NONE:
        ret false
    end
    mut lgr := lg.New(lg.LOG_OFF, false)
    sf := src_from_string(source)
    mut toks := tok.StreamNew(sf.path)
    lok := lx.Run(lgr, pack, sf, toks)
    mut a := at.NewAst()
    mut prog := 0
    pok := ps.Run(lgr, toks, a, prog)
    tok.StreamFree(toks)
    mut table := cc.TableBuild("", Vector {} as Vector<str>)
    cc.TableSetPack(table, pack)
    mut found := false
    if lok and pok and cc.PruneProgram(
        a, lgr, sf.path, table, prog
    ) and lo.FindLayout(a, prog) != 0:
        found = true
        entry := lp.Entry(pack)
        repeat at.ChildCount(a, prog) in i:
            item := at.Get(a, at.Child(a, prog, i))
            if item.kind == at.AST_FUNC_DEF and lp.IdentEqual(item.name, entry):
                found = false
            end
        end
    end
    at.FreeAst(a)
    cc.TableFree(table)
    lg.Free(lgr)
    ret found
end

func build_page(source: str, lang: str): dr.SourcePage:
    i18.SetLang(lang)
    sm.SetStdlibRoot("")
    src.ForgetLoaded()
    ensure_schema()
    mut page := dr.PageFromSource(src_from_string(source), lang)
    if page.no_page:
        page.diag = i18.Tr(
            "this program has no layout block; " + "use a `layout:` block to build an HTML page"
        )
    end
    if not page.ok:
        g_wb_failed = true
    end
    ret page
end

func page_diag(diag: str): str:
    ret str.Clone(diag)
end

func free_page(page &: dr.SourcePage):
    if page.ok:
        lo.FreeResult(page.result)
    end
end

func end_line(b &: str.StringBuilder):
    if str.BufLen(b) == (0 as i64):
        ret
    end
    text := str.BufStr(b)
    if not str.EndsWith(text, "\n"):
        str.BufAppend(b, "\n")
    end
    mem.Free(text as void*)
end

func emit_page_part(source: str, lang: str, phase: str): str:
    mut page := build_page(source, lang)
    if not page.ok:
        ret page_diag(page.diag)
    end
    defer free_page(page)
    res := page.result
    if str.Equals(phase, "css"):
        ret str.Clone(res.css)
    end
    if str.Equals(phase, "js"):
        ret str.Clone(res.js)
    end
    css_href := str.Len(res.css) > 0 ? "style.css" : ""
    js_href := str.Len(res.js) > 0 ? "script.js" : ""
    ret lo.Document(res, false, css_href, js_href, false)
end

pub func Translate(source: str, target_lang: str): str:
    if str.Len(target_lang) == 0:
        ret str.Clone(source)
    end
    target := lp.Load(target_lang)
    if target == lp.LP_NONE:
        ret str.Clone(source)
    end
    fallback := lp.Load("en")
    sf := src_from_string(source)
    srcpack := lx.Detect(sf, fallback)
    if srcpack == target:
        ret str.Clone(source)
    end
    mut lgr := lg.New(lg.LOG_OFF, false)
    defer lg.Free(lgr)
    mut std_root := sm.GetStdlibRoot()
    if str.Len(std_root) == 0:
        std_root = "/std"
    end
    mut out := ""
    ok := tr.translate_source(lgr, srcpack, target, std_root, sf, out)
    if not ok or str.Len(out) == 0:
        ret str.Clone(source)
    end
    ret out
end

pub func RunApp(source: str, lang: str): str:
    g_wb_failed = false
    src.ForgetLoaded()
    if page_without_entry(source, lang):
        g_wb_failed = true
        ret str.Clone(
            i18.Tr(
                "this program is a web page and has no 'main' function to run; switch to Layout mode to see it"
            )
        )
    end
    mut lgr := lg.New(lg.LOG_WARN, false)
    defer lg.Free(lgr)
    mut fe := front_end(lgr, lang, source)
    if not fe.ok:
        g_wb_failed = true
        sm.DropDiagSources(fe.s)
        sm.Free(fe.s)
        at.FreeAst(fe.a)
        ret fe.diag
    end

    mut opts := ip.NewOptions()
    opts.capture = true
    opts.lang = lang
    opts.timeout_ms = 3000
    mut vm := ip.New(lgr, fe.entry, opts)
    _rc := ip.Run(vm, fe.a, fe.s, fe.program)

    mut b := str.NewBuilder()
    defer str.BufFree(b)
    str.BufAppend(b, vm.out_text)
    if str.Len(vm.err_text) > 0:
        end_line(b)
        str.BufAppend(b, vm.err_text)
    end
    fail_text := ip.FailText(vm)
    if str.Len(fail_text) > 0:
        g_wb_failed = true
        end_line(b)
        str.BufAppend(b, fail_text)
        str.BufAppend(b, "\n")
    end
    warn_text := dg.RenderAll(
        fe.s.diag, source, str.Len(source), dg.DIAG_STYLE_RUST, dg.DIAG_FORMAT_HUMAN, false
    )
    if str.Len(warn_text) > 0:
        end_line(b)
        str.BufAppend(b, warn_text)
    end

    ip.Free(vm)
    sm.DropDiagSources(fe.s)
    sm.Free(fe.s)
    at.FreeAst(fe.a)
    ret str.BufStr(b)
end

pub func BuildLayout(source: str, lang: str): str:
    g_wb_failed = false
    mut page := build_page(source, lang)
    if not page.ok:
        ret page_diag(page.diag)
    end
    defer free_page(page)
    ret lo.Document(page.result, true, "", "", false)
end

pub func StdCache(source: str, lang: str, path: str): str:
    g_wb_failed = false
    mut page := build_page(source, lang)
    if not page.ok:
        ret page_diag(page.diag)
    end
    free_page(page)
    cache := dr.StdScriptCache()
    if str.Len(cache) == 0:
        g_wb_failed = true
        ret str.Clone("the std module cache is empty or does not read back")
    end
    if io.WriteFile(path, cache) != str.Len(cache):
        g_wb_failed = true
        ret str.Clone("the std module cache could not be written")
    end
    ret str.Clone("")
end

pub func Emit(source: str, lang: str, phase: str): str:
    g_wb_failed = false
    if str.Equals(phase, "html") or str.Equals(phase, "css") or str.Equals(phase, "js"):
        ret emit_page_part(source, lang, phase)
    end
    src.ForgetLoaded()
    i18.SetLang(lang)
    sm.SetStdlibRoot("")
    mut lgr := lg.New(lg.LOG_WARN, false)
    defer lg.Free(lgr)
    pack := lp.Load(lang)
    if pack == lp.LP_NONE:
        g_wb_failed = true
        ret str.Clone(i18.Tr("unknown language pack"))
    end
    entry := lp.Entry(pack)
    sf := src_from_string(source)
    lg.SetDiagSource(lgr, sf.text, sf.len, dg.DIAG_STYLE_RUST, dg.DIAG_FORMAT_HUMAN)
    lg.SetCapture(true)

    mut toks := tok.StreamNew(sf.path)
    lok := lx.Run(lgr, pack, sf, toks)
    if str.Equals(phase, "tokens"):
        lg.SetCapture(false)
        mut w := x.New()
        x.Decl(w)
        tok.TokensToXml(w, toks)
        r := x.Str(w)
        x.Free(w)
        tok.StreamFree(toks)
        ret r
    end

    mut a := at.NewAst()
    mut prog := 0
    mut pok := ps.Run(lgr, toks, a, prog)
    tok.StreamFree(toks)
    mut table := cc.TableBuild("", Vector {} as Vector<str>)
    cc.TableSetPack(table, pack)
    if not cc.PruneProgram(a, lgr, sf.path, table, prog):
        pok = false
    end
    if str.Equals(phase, "ast"):
        lg.SetCapture(false)
        mut w := x.New()
        x.Decl(w)
        at.ToXml(w, a, prog)
        r := x.Str(w)
        x.Free(w)
        cc.TableFree(table)
        at.FreeAst(a)
        ret r
    end

    ensure_schema()
    _eerr := lo.Expand(lgr, pack, table, a, prog, "")
    _vw := lo.PrepareViews(lgr, pack, table, a, prog, sf.path)
    mut s := sm.New(lgr, sf.path, lp.Code(pack))
    sm.SetCc(s, table)
    sok := sm.Run(s, a, prog)
    if str.Equals(phase, "symbols"):
        lg.SetCapture(false)
        mut w := x.New()
        x.Decl(w)
        sm.SymbolsToXml(w, s)
        r := x.Str(w)
        x.Free(w)
        sm.DropDiagSources(s)
        sm.Free(s)
        at.FreeAst(a)
        ret r
    end

    lg.SetCapture(false)
    if not lok or not pok or not sok:
        g_wb_failed = true
        rendered := lg.Captured()
        r := str.Clone(str.Len(rendered) > 0 ? rendered : i18.Tr("compilation failed"))
        sm.DropDiagSources(s)
        sm.Free(s)
        at.FreeAst(a)
        ret r
    end

    if str.Equals(phase, "c"):
        cgo := cg.Run(lgr, s, a, prog, "main", false, false, "main.salam", entry, "", false)
        mut b := str.NewBuilder()
        defer str.BufFree(b)
        if str.Len(cgo.h_src) > 0:
            str.BufAppend(b, "/* ===== salam_mod_main.h ===== */\n")
            str.BufAppend(b, cgo.h_src)
            str.BufAppend(b, "\n")
            mem.Free(cgo.h_src as void*)
        end
        if str.Len(cgo.c_src) > 0:
            str.BufAppend(b, "/* ===== salam_mod_main.c ===== */\n")
            str.BufAppend(b, cgo.c_src)
            mem.Free(cgo.c_src as void*)
        end
        sm.DropDiagSources(s)
        sm.Free(s)
        at.FreeAst(a)
        ret str.BufStr(b)
    end

    if str.Equals(phase, "llvm"):
        llo := lv.Run(lgr, s, a, prog, "main", entry)
        mut b := str.NewBuilder()
        defer str.BufFree(b)
        if not llo.ok:
            str.BufAppend(b, "; note: the LLVM backend supports a subset of Salam.\n; ")
            str.BufAppend(b, str.Len(llo.error) > 0 ? llo.error : "unsupported construct")
            str.BufAppend(b, "\n\n")
        end
        if str.Len(llo.ll_src) > 0:
            str.BufAppend(b, llo.ll_src)
            mem.Free(llo.ll_src as void*)
        else llo.ok:
            str.BufAppend(b, "; (no IR produced)\n")
        end
        sm.DropDiagSources(s)
        sm.Free(s)
        at.FreeAst(a)
        ret str.BufStr(b)
    end

    g_wb_failed = true
    r := str.Clone(i18.Tr("compilation failed"))
    sm.DropDiagSources(s)
    sm.Free(s)
    at.FreeAst(a)
    ret r
end

pub func LastFailed(): bool:
    ret g_wb_failed
end

pub func Version(): str:
    ret "Salam WebAssembly playground"
end

pub func SyntaxOk(source: str, lang: str): str:
    i18.SetLang(lang)
    sm.SetStdlibRoot("")
    pack := lp.Load(lang)
    if pack == lp.LP_NONE:
        ret str.Clone("-1")
    end
    mut lgr := lg.New(lg.LOG_OFF, false)
    defer lg.Free(lgr)
    sf := src_from_string(source)

    mut toks := tok.StreamNew(sf.path)
    lok := lx.Run(lgr, pack, sf, toks)
    if not lok:
        tok.StreamFree(toks)
        ret str.Clone("0")
    end

    mut a := at.NewAst()
    mut prog := 0
    pok := ps.Run(lgr, toks, a, prog)
    tok.StreamFree(toks)
    at.FreeAst(a)
    ret str.Clone(pok ? "1" : "0")
end
