package web

import str

include lg "logger.salam"
include i18 "i18n.salam"
include lp "langpack.salam"
include src "source.salam"
include tok "token.salam"
include at "ast.salam"
include ps "parser/parser.salam"
include cc "condcomp.salam"
include sm "semantic/semantic.salam"
include lx "lexer/lexer.salam"
include ip "interp/interp.salam"
include lo "sal_layout/sal_layout.salam"
include dg "diag.salam"
include x "xml.salam"
include cg "codegen/codegen.salam"
include lv "llvmgen/llvmgen.salam"

mut g_wb_schema_ready := false
mut g_wb_failed := false

struct FrontEnd:
    pub ok: bool = false
    pub a: at.Ast = at.NewAst()
    pub program: int = 0
    pub s: sm.Sema = sm.New(lg.New(lg.LOG_OFF, false), "", "en")
    pub entry: str = ""
    pub diag: str = ""
end

func ensure_schema():
    if not g_wb_schema_ready:
        sm.LayoutSchemaInit(sm.GetStdlibRoot())
        g_wb_schema_ready = true
    end
end

func src_from_string(source: str): src.SourceFile:
    mut sf := src.New()
    sf.path = "main.salam"
    sf.text = source
    sf.len = str.Len(source)
    ret sf
end

func front_end(lgr: lg.Logger, lang: str, source: str): FrontEnd:
    mut r := FrontEnd {}
    i18.SetLang(lang)
    sm.SetStdlibRoot("")
    pack := lp.Load(lang)
    if pack == lp.LP_NONE:
        r.diag = i18.Tr("unknown language pack")
        ret r
    end
    r.entry = lp.Entry(pack)
    sf := src_from_string(source)
    lg.SetDiagSource(lgr, sf.text, sf.len, dg.DIAG_STYLE_RUST, dg.DIAG_FORMAT_HUMAN)
    lg.SetCapture(true)

    mut toks := tok.StreamNew(sf.path)
    lok := lx.Run(lgr, pack, sf, toks)
    mut a := at.NewAst()
    mut prog := 0
    mut pok := ps.Run(lgr, toks, a, prog)
    tok.StreamFree(toks)

    table := cc.TableBuild("", Vector {} as Vector<str>)
    cc.TableSetPack(table, pack)
    if not cc.PruneProgram(a, lgr, sf.path, table, prog):
        pok = false
    end

    _eerr := lo.Expand(lgr, pack, table, a, prog, "")
    _vw := lo.PrepareViews(lgr, pack, table, a, prog, sf.path)
    mut s := sm.New(lgr, sf.path, lp.Code(pack))
    sm.SetCc(s, table)
    sok := sm.Run(s, a, prog)
    lg.SetCapture(false)

    r.a = a
    r.program = prog
    r.s = s
    if not lok or not pok or not sok:
        rendered := lg.Captured() + dg.RenderAll(
            s.diag, sf.text, sf.len, dg.DIAG_STYLE_RUST, dg.DIAG_FORMAT_HUMAN, false
        )
        r.diag = str.Len(rendered) > 0 ? rendered : i18.Tr("compilation failed")
        ret r
    end
    r.ok = true
    ret r
end

export:
    func salam_web_run_app(source: str, lang: str): str:
        ret RunApp(source, lang)
    end

    func salam_web_build_layout(source: str, lang: str): str:
        ret BuildLayout(source, lang)
    end

    func salam_web_emit(source: str, lang: str, phase: str): str:
        ret Emit(source, lang, phase)
    end

    func salam_web_version(): str:
        ret Version()
    end

    func salam_web_syntax_ok(source: str, lang: str): str:
        ret SyntaxOk(source, lang)
    end

    func salam_web_last_failed(): int:
        ret LastFailed() ? 1 : 0
    end
end

pub func RunApp(source: str, lang: str): str:
    g_wb_failed = false
    lgr := lg.New(lg.LOG_WARN, false)
    fe := front_end(lgr, lang, source)
    if not fe.ok:
        g_wb_failed = true
        d := fe.diag
        sm.Free(fe.s)
        at.FreeAst(fe.a)
        ret d
    end

    mut opts := ip.NewOptions()
    opts.capture = true
    opts.lang = lang
    opts.timeout_ms = 3000
    mut vm := ip.New(lgr, fe.entry, opts)
    _rc := ip.Run(vm, fe.a, fe.s, fe.program)

    mut result := vm.out_text
    if str.Len(vm.err_text) > 0:
        if str.Len(result) > 0 and not str.EndsWith(result, "\n"):
            result += "\n"
        end
        result += vm.err_text
    end
    fail_text := ip.FailText(vm)
    if str.Len(fail_text) > 0:
        g_wb_failed = true
        if str.Len(result) > 0 and not str.EndsWith(result, "\n"):
            result += "\n"
        end
        result += fail_text + "\n"
    end
    warn_text := dg.RenderAll(
        fe.s.diag, source, str.Len(source), dg.DIAG_STYLE_RUST, dg.DIAG_FORMAT_HUMAN, false
    )
    if str.Len(warn_text) > 0:
        if str.Len(result) > 0 and not str.EndsWith(result, "\n"):
            result += "\n"
        end
        result += warn_text
    end

    ip.Free(vm)
    sm.Free(fe.s)
    at.FreeAst(fe.a)
    ret result
end

pub func BuildLayout(source: str, lang: str): str:
    g_wb_failed = false
    ensure_schema()
    lgr := lg.New(lg.LOG_WARN, false)
    fe := front_end(lgr, lang, source)
    if not fe.ok:
        g_wb_failed = true
        d := fe.diag
        sm.Free(fe.s)
        at.FreeAst(fe.a)
        ret d
    end

    lb := lo.FindLayout(fe.a, fe.program)
    if lb == 0:
        g_wb_failed = true
        sm.Free(fe.s)
        at.FreeAst(fe.a)
        ret i18.Tr(
            "this program has no layout block; " + "use a `layout:` block to build an HTML page"
        )
    end

    mut diag_e := dg.New(lgr, lg.PH_CODEGEN)
    res := lo.Generate(lgr, diag_e, "main.salam", fe.a, lb, false)
    mut result := ""
    if dg.HasErrors(diag_e):
        g_wb_failed = true
        rendered := dg.RenderAll(
            diag_e, source, str.Len(source), dg.DIAG_STYLE_RUST, dg.DIAG_FORMAT_HUMAN, false
        )
        result = str.Len(rendered) > 0 ? rendered : i18.Tr("layout build failed")
    else:
        result = lo.Document(res, true, "", "", false)
    end
    dg.Free(diag_e)
    sm.Free(fe.s)
    at.FreeAst(fe.a)
    ret result
end

pub func Emit(source: str, lang: str, phase: str): str:
    g_wb_failed = false
    i18.SetLang(lang)
    sm.SetStdlibRoot("")
    lgr := lg.New(lg.LOG_WARN, false)
    pack := lp.Load(lang)
    if pack == lp.LP_NONE:
        g_wb_failed = true
        ret i18.Tr("unknown language pack")
    end
    entry := lp.Entry(pack)
    sf := src_from_string(source)
    lg.SetDiagSource(lgr, sf.text, sf.len, dg.DIAG_STYLE_RUST, dg.DIAG_FORMAT_HUMAN)
    lg.SetCapture(true)

    mut toks := tok.StreamNew(sf.path)
    lok := lx.Run(lgr, pack, sf, toks)
    if str.Equals(phase, "tokens"):
        lg.SetCapture(false)
        mut w := x.New()
        x.Decl(w)
        tok.TokensToXml(w, toks)
        r := x.Str(w)
        x.Free(w)
        tok.StreamFree(toks)
        ret r
    end

    mut a := at.NewAst()
    mut prog := 0
    mut pok := ps.Run(lgr, toks, a, prog)
    tok.StreamFree(toks)
    table := cc.TableBuild("", Vector {} as Vector<str>)
    cc.TableSetPack(table, pack)
    if not cc.PruneProgram(a, lgr, sf.path, table, prog):
        pok = false
    end
    if str.Equals(phase, "ast"):
        lg.SetCapture(false)
        mut w := x.New()
        x.Decl(w)
        at.ToXml(w, a, prog)
        r := x.Str(w)
        x.Free(w)
        cc.TableFree(table)
        at.FreeAst(a)
        ret r
    end

    ensure_schema()
    _eerr := lo.Expand(lgr, pack, table, a, prog, "")
    _vw := lo.PrepareViews(lgr, pack, table, a, prog, sf.path)
    mut s := sm.New(lgr, sf.path, lp.Code(pack))
    sm.SetCc(s, table)
    sok := sm.Run(s, a, prog)
    if str.Equals(phase, "symbols"):
        lg.SetCapture(false)
        mut w := x.New()
        x.Decl(w)
        sm.SymbolsToXml(w, s)
        r := x.Str(w)
        x.Free(w)
        sm.Free(s)
        at.FreeAst(a)
        ret r
    end

    lg.SetCapture(false)
    if not lok or not pok or not sok:
        g_wb_failed = true
        rendered := lg.Captured() + dg.RenderAll(
            s.diag, sf.text, sf.len, dg.DIAG_STYLE_RUST, dg.DIAG_FORMAT_HUMAN, false
        )
        r := str.Len(rendered) > 0 ? rendered : i18.Tr("compilation failed")
        sm.Free(s)
        at.FreeAst(a)
        ret r
    end

    if str.Equals(phase, "html") or str.Equals(phase, "css") or str.Equals(phase, "js"):
        ensure_schema()
        lb := lo.FindLayout(a, prog)
        if lb == 0:
            g_wb_failed = true
            sm.Free(s)
            at.FreeAst(a)
            ret i18.Tr(
                "this program has no layout block; " + "use a `layout:` block to build an HTML page"
            )
        end
        mut diag_e := dg.New(lgr, lg.PH_CODEGEN)
        res := lo.Generate(lgr, diag_e, "main.salam", a, lb, false)
        if dg.HasErrors(diag_e):
            g_wb_failed = true
            rendered := dg.RenderAll(
                diag_e, sf.text, sf.len, dg.DIAG_STYLE_RUST, dg.DIAG_FORMAT_HUMAN, false
            )
            r := str.Len(rendered) > 0 ? rendered : i18.Tr("layout build failed")
            dg.Free(diag_e)
            sm.Free(s)
            at.FreeAst(a)
            ret r
        end
        css_href := str.Len(res.css) > 0 ? "style.css" : ""
        js_href := str.Len(res.js) > 0 ? "script.js" : ""
        mut part := ""
        if str.Equals(phase, "html"):
            part = lo.Document(res, false, css_href, js_href, false)
        else str.Equals(phase, "css"):
            part = res.css
        else:
            part = res.js
        end
        dg.Free(diag_e)
        sm.Free(s)
        at.FreeAst(a)
        ret part
    end

    if str.Equals(phase, "c"):
        cgo := cg.Run(lgr, s, a, prog, "main", false, false, "main.salam", entry, "")
        mut b := ""
        if str.Len(cgo.h_src) > 0:
            b += "/* ===== salam_mod_main.h ===== */\n"
            b += cgo.h_src
            b += "\n"
        end
        if str.Len(cgo.c_src) > 0:
            b += "/* ===== salam_mod_main.c ===== */\n"
            b += cgo.c_src
        end
        sm.Free(s)
        at.FreeAst(a)
        ret b
    end

    if str.Equals(phase, "llvm"):
        llo := lv.Run(lgr, s, a, prog, "main", entry)
        mut b := ""
        if not llo.ok:
            b += "; note: the LLVM backend supports a subset of Salam.\n; "
            b += str.Len(llo.error) > 0 ? llo.error : "unsupported construct"
            b += "\n\n"
        end
        if str.Len(llo.ll_src) > 0:
            b += llo.ll_src
        else llo.ok:
            b += "; (no IR produced)\n"
        end
        sm.Free(s)
        at.FreeAst(a)
        ret b
    end

    g_wb_failed = true
    r := i18.Tr("compilation failed")
    sm.Free(s)
    at.FreeAst(a)
    ret r
end

pub func LastFailed(): bool:
    ret g_wb_failed
end

pub func Version(): str:
    ret "Salam WebAssembly playground"
end

pub func SyntaxOk(source: str, lang: str): str:
    i18.SetLang(lang)
    sm.SetStdlibRoot("")
    pack := lp.Load(lang)
    if pack == lp.LP_NONE:
        ret "-1"
    end
    lgr := lg.New(lg.LOG_OFF, false)
    sf := src_from_string(source)

    mut toks := tok.StreamNew(sf.path)
    lok := lx.Run(lgr, pack, sf, toks)
    if not lok:
        tok.StreamFree(toks)
        ret "0"
    end

    mut a := at.NewAst()
    mut prog := 0
    pok := ps.Run(lgr, toks, a, prog)
    tok.StreamFree(toks)
    at.FreeAst(a)
    ret pok ? "1" : "0"
end
