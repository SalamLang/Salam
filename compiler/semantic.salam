// dce_reset - the C took the arena; the port's vectors own their storage.
pub func DceReset():
    g_sm_dce_edge_from.free()
    g_sm_dce_edge_to.free()
    g_sm_dce_roots.free()
    g_sm_dce_reach.free()
    g_sm_dce_edge_from = Vector {} as Vector<str>
    g_sm_dce_edge_to = Vector {} as Vector<str>
    g_sm_dce_roots = Vector {} as Vector<str>
    g_sm_dce_reach = Vector {} as Vector<str>
    g_sm_dce_enabled = false
    g_sm_dce_init = true
end

// dce_enable
pub func DceEnable():
    g_sm_dce_enabled = true
end

// dce_disable
pub func DceDisable():
    g_sm_dce_enabled = false
end

// dce_enabled
pub func DceEnabled(): bool:
    ret g_sm_dce_enabled
end

// dce_mark_root
pub func DceMarkRoot(pkg: str, fn: str):
    dce_mark_root(pkg, fn)
end

// dce_note_call
pub func DceNoteCall(
    caller_pkg: str, caller_fn: str, callee_pkg: str, callee_fn: str
):
    dce_note_call(caller_pkg, caller_fn, callee_pkg, callee_fn)
end

// dce_finish - roots -> reachable closure over the recorded call edges.
pub func DceFinish():
    if !g_sm_dce_init:
        ret
    end
    g_sm_dce_reach.free()
    g_sm_dce_reach = Vector {} as Vector<str>
    mut worklist := Vector {} as Vector<str>
    defer worklist.free()
    repeat g_sm_dce_roots.len() with i:
        k := g_sm_dce_roots.get(i)[0]
        if dce_key_in(g_sm_dce_reach, k):
            continue
        end
        g_sm_dce_reach.push(k)
        worklist.push(k)
    end
    until worklist.len() > 0:
        cur := worklist.get(worklist.len() - 1)[0]
        _p := worklist.pop()
        repeat g_sm_dce_edge_from.len() with j:
            if !str.Equals(g_sm_dce_edge_from.get(j)[0], cur):
                continue
            end
            dst := g_sm_dce_edge_to.get(j)[0]
            if dce_key_in(g_sm_dce_reach, dst):
                continue
            end
            g_sm_dce_reach.push(dst)
            worklist.push(dst)
        end
    end
end

// dce_reachable
pub func DceReachable(pkg: str, fn: str): bool:
    if !g_sm_dce_init:
        ret true
    end
    ret dce_key_in(g_sm_dce_reach, dce_key(pkg, fn))
end

// sema_lvalue_mutable (sema_stmt.c) - thin wrapper over the write
// classifier; the C declares it in sema_internal.h but nothing calls it,
// so the port exposes it here for backend waves instead of as a dead
// private helper.
pub func LvalueMutable(
    sm &: Sema, a &: at.Ast, n: int, is_lvalue &: bool
): bool:
    mut root := 0
    v := sema_classify_write(sm, a, n, root)
    is_lvalue = v != LV_NOT_LVALUE
    ret v == LV_OK
end
