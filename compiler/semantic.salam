// ===== handle type aliases =====
pub type TypeId = int
pub type ScopeId = int
pub type SymId = int
pub type SigId = int

// ===== types.h =====
// struct type_t. `decl` (void* in C, symbol_t* in practice) is a SymId.
// For TY_FUNC, `elem` is the return type and `length != 0` marks an extern
// ("externfunc") signature, exactly like the C.
pub struct Type:
    pub kind: int = 0
    pub elem: int = TYPE_NONE
    pub length: i64 = 0 as i64
    pub pointee: int = TYPE_NONE
    pub key: int = TYPE_NONE
    pub decl: int = 0
    pub name: str = ""
    pub params: Vector<int> = Vector {} // TypeIds (func params / variant members)
end

// ===== symbol.h =====
// func_sig_t. C field `ret` -> ret_type (keyword). decl is an at.NodeId,
// owner a SymId; params holds TypeIds.
pub struct Sig:
    pub params: Vector<int> = Vector {}
    pub required: int = 0
    pub ret_type: int = TYPE_NONE
    pub ret_span: co.SrcSpan = co.EmptySpan()
    pub ret_int_span: co.SrcSpan = co.EmptySpan()
    pub ret_int_seen: bool = false
    pub ret_float_seen: bool = false
    pub decl: int = 0
    pub owner: int = 0
    pub mangled: str = ""
    pub variadic: bool = false
    pub infer_ret: bool = false
    pub ret_weak: bool = false
    pub ret_widened: bool = false
    pub checked: bool = false
    pub in_check: bool = false
end

// struct symbol_t. C field `type` -> ty (keyword). decl is an at.NodeId;
// overloads holds SigIds; members/home are ScopeIds; generic_args TypeIds.
pub struct Symbol:
    pub kind: int = 0
    pub name: str = ""
    pub ty: int = TYPE_NONE
    pub is_mut: bool = false
    pub is_ref: bool = false
    pub is_pub: bool = false
    pub used: bool = false
    pub mutated: bool = false
    pub decl: int = 0
    pub overloads: Vector<int> = Vector {}
    pub members: int = 0
    pub enum_value: i64 = 0 as i64
    pub has_ival: bool = false
    pub ival: i64 = 0 as i64
    pub pkgname: str = ""
    pub generic_base: str = ""
    pub generic_args: Vector<int> = Vector {}
    pub home: int = 0
end

// The value of a compile-time-constant expression, or CV_NONE when it has
// none. Filled in by sema_const_eval (the sema_fold.c section).
pub struct ConstVal:
    pub kind: int = CV_NONE
    pub i: i64 = 0 as i64
    pub f: f64 = 0.0
    pub b: bool = false
end

// struct scope_t. C field `func` -> fn (keyword; a SigId). The hash index
// (hindex/hcap) is dropped - lookups scan `symbols` linearly.
pub struct Scope:
    pub kind: int = 0
    pub parent: int = 0
    pub symbols: Vector<int> = Vector {} // SymIds
    pub self_type: int = TYPE_NONE
    pub fn: int = 0
    pub label: str = ""
    pub aux: int = 0
    pub lang: str = ""
end

// ===== sema_internal.h =====
// lambda_ctx_t (the `prev` chain becomes the Sema.lam stack)
pub struct LambdaCtx:
    pub boundary: int = 0 // ScopeId
    pub node: int = 0 // at.NodeId
end

// match_yield_t. C fields `ret`/`type` -> ret_node/ty (keywords).
pub struct MatchYield:
    pub ret_node: int = 0 // at.NodeId of the yielding ret/expr
    pub ty: int = TYPE_NONE // TypeId
end

// ===== builtins.h =====
// salam_builtin_t. C field `ret` -> ret_type (keyword).
pub struct Builtin:
    pub name: str = ""
    pub runtime: str = ""
    pub nargs: int = 0
    pub ret_type: str = ""
    pub arg: str = ""
end

// sema_t + type_ctx_t merged (see file header for every representation
// change). Always create through New() - a bare `Sema {}` has empty tables.
pub struct Sema:
    // arena_t *a - dropped (Vector ownership); logger_t*/diag_engine_t*:
    pub log: lg.Logger = lg.New(2, false)
    pub diag: dg.Engine = dg.NewDefault(2, false, 4) // phase 4 = PH_SEMANTIC
    pub file: str = ""
    pub lang: str = "en"
    // type_ctx_t tc (prims are types[0..TY_F64]; arrays/ptrs intern lists):
    pub types: Vector<Type> = Vector {}
    pub arrays_intern: Vector<int> = Vector {} // TypeIds of TY_ARRAY types
    pub ptrs_intern: Vector<int> = Vector {} // TypeIds of TY_PTR types
    // symbol/scope/signature storage (slot 0 = sentinel = C NULL):
    pub scopes: Vector<Scope> = Vector {}
    pub syms: Vector<Symbol> = Vector {}
    pub sigs: Vector<Sig> = Vector {}
    pub global: int = 0 // ScopeId
    pub cur: int = 0 // ScopeId
    pub self_type: int = TYPE_NONE
    pub cur_func: int = 0 // SigId (C: func_sig_t *cur_func)
    pub loop_depth: int = 0
    pub dir: str = ""
    pub imported: Vector<str> = Vector {}
    pub pkg: str = ""
    // vec_t *pkg_cache ([path, symbol] pairs) -> parallel vectors:
    pub pkg_cache_paths: Vector<str> = Vector {}
    pub pkg_cache_syms: Vector<int> = Vector {} // SymIds
    pub loading: Vector<str> = Vector {}
    pub program: int = 0 // at.NodeId
    pub pending: Vector<int> = Vector {} // at.NodeIds (generic instantiations)
    pub expected: int = TYPE_NONE
    pub lam: Vector<LambdaCtx> = Vector {} // lambda_ctx_t *lam (stack)
    pub gen_pkg: int = 0 // ScopeId
    pub prelude: int = 0 // ScopeId
    pub prelude_tried: bool = false
    pub in_pkg: bool = false
    pub relax_unused: bool = false
    pub requal: bool = false
    pub each_n: int = 0
    // const cc_table_t *cc -> value copy (field renamed: alias clash).
    // has_cc mirrors "cc != NULL"; replace via SetCc().
    pub cctab: cc.Table = cc.TableBuild("", Vector {} as Vector<str>)
    pub has_cc: bool = false
    pub match_arm_depth: int = 0
    pub match_yield_expected: int = TYPE_NONE
    // vec_t *match_yield_collect -> vector + active flag:
    pub match_yield_active: bool = false
    pub match_yield_collect: Vector<MatchYield> = Vector {}
end

// ---------------------------------------------------------------------------
// Low-level shared helpers (no direct C equivalent).
// ---------------------------------------------------------------------------

// Unsigned byte read from a str (same idiom as the parser/diag ports).
func byte_at(s: str, i: int): int:
    bp := (s as void*) as i8*
    mut v := bp[i] as int
    if v < 0:
        v += 256
    end
    ret v
end

// Table accessors - Vector<T> is a value struct, so every WRITE is
// get-copy -> mutate -> put-back (the ast.salam mutation protocol).
func ty_at(s &: Sema, t: int): Type:
    if t < 0 || t >= s.types.len():
        ret s.types.get(TY_ERROR)[0]
    end
    ret s.types.get(t)[0]
end

func ty_put(s &: Sema, t: int, v: Type):
    s.types.set(t, v)
end

func scope_at(s &: Sema, sc: int): Scope:
    ret s.scopes.get(sc)[0]
end

func scope_put(s &: Sema, sc: int, v: Scope):
    s.scopes.set(sc, v)
end

func sym_at(s &: Sema, id: int): Symbol:
    ret s.syms.get(id)[0]
end

func sym_put(s &: Sema, id: int, v: Symbol):
    s.syms.set(id, v)
end

func sig_at(s &: Sema, id: int): Sig:
    ret s.sigs.get(id)[0]
end

func sig_put(s &: Sema, id: int, v: Sig):
    s.sigs.set(id, v)
end

// &node->span - rebuild a co.SrcSpan from the node's inlined span fields.
func span_of(a &: at.Ast, id: int): co.SrcSpan:
    n := at.Get(a, id)
    ret co.MakeSpan(
        co.MakePos(n.begin_line, n.begin_col, n.begin_index), co.MakePos(n.end_line, n.end_col, n.end_index),
        n.length
    )
end

// lang[0] as an unsigned byte, 0 for "".
func lang0(lang: str): int:
    if str.Len(lang) == 0:
        ret 0
    end
    ret byte_at(lang, 0)
end

// dir_of (sema.c) - path prefix before the last '/' or '\\', "" if none.
func dir_of(path: str): str:
    mut cut := 0 - 1
    n := str.Len(path)
    repeat n with i:
        b := byte_at(path, i)
        if b == 47 || b == 92:
            cut = i
        end
    end
    if cut < 0:
        ret ""
    end
    ret str.Substr(path, 0, cut)
end

// ===== sema_internal.h (SERR / SWARN) =====
// diag_report(s->diag, SEV_*, code, s->file, span, ...). `msg` is the final
// pre-formatted body: call sites use co.FormatN(i18.Tr(fmt), ...).
func serr(s &: Sema, code: int, sp: co.SrcSpan, msg: str):
    mut e := s.diag
    dg.Report(e, dg.SEV_ERROR, code, s.file, sp, msg)
    s.diag = e
end

func swarn(s &: Sema, code: int, sp: co.SrcSpan, msg: str):
    if s.requal:
        ret
    end
    mut e := s.diag
    dg.Report(e, dg.SEV_WARNING, code, s.file, sp, msg)
    s.diag = e
end

// ===== types.c =====

// type_prim - primitive ids equal their kind values (pre-seeded by New;
// the Sema is unused here but kept for C call-site parity).
func type_prim(_s &: Sema, kind: int): int:
    if kind < 0 || kind > TY_F64:
        ret TY_ERROR
    end
    ret kind
end

// type_array - interned on (elem, length).
func type_array(s &: Sema, elem: int, length: i64): int:
    repeat s.arrays_intern.len() with i:
        tid := s.arrays_intern.get(i)[0]
        t := ty_at(s, tid)
        if t.elem == elem && t.length == length:
            ret tid
        end
    end
    mut nt := Type { kind = TY_ARRAY }
    nt.elem = elem
    nt.length = length
    id := s.types.len()
    s.types.push(nt)
    s.arrays_intern.push(id)
    ret id
end

// type_slice - NOT interned (matches the C).
func type_slice(s &: Sema, elem: int): int:
    mut nt := Type { kind = TY_SLICE }
    nt.elem = elem
    id := s.types.len()
    s.types.push(nt)
    ret id
end

// type_ptr - interned on pointee.
func type_ptr(s &: Sema, pointee: int): int:
    repeat s.ptrs_intern.len() with i:
        tid := s.ptrs_intern.get(i)[0]
        t := ty_at(s, tid)
        if t.pointee == pointee:
            ret tid
        end
    end
    mut nt := Type { kind = TY_PTR }
    nt.pointee = pointee
    id := s.types.len()
    s.types.push(nt)
    s.ptrs_intern.push(id)
    ret id
end

func type_struct(s &: Sema, decl_sym: int, name: str): int:
    mut nt := Type { kind = TY_STRUCT }
    nt.decl = decl_sym
    nt.name = name
    id := s.types.len()
    s.types.push(nt)
    ret id
end

func type_enum(s &: Sema, decl_sym: int, name: str): int:
    mut nt := Type { kind = TY_ENUM }
    nt.decl = decl_sym
    nt.name = name
    id := s.types.len()
    s.types.push(nt)
    ret id
end

func type_dyn(s &: Sema, iface_decl: int, name: str): int:
    mut nt := Type { kind = TY_DYN }
    nt.decl = iface_decl
    nt.name = name
    id := s.types.len()
    s.types.push(nt)
    ret id
end

// type_kv (static helper for map/map_iter)
func type_kv(s &: Sema, kind: int, key: int, val: int): int:
    mut nt := Type { kind = kind }
    nt.key = key
    nt.elem = val
    id := s.types.len()
    s.types.push(nt)
    ret id
end

func type_map(s &: Sema, key: int, val: int): int:
    ret type_kv(s, TY_MAP, key, val)
end

func type_map_iter(s &: Sema, key: int, val: int): int:
    ret type_kv(s, TY_MAP_ITER, key, val)
end

func type_vec(s &: Sema, elem: int): int:
    mut nt := Type { kind = TY_VEC }
    nt.elem = elem
    id := s.types.len()
    s.types.push(nt)
    ret id
end

func type_file(s &: Sema): int:
    mut nt := Type { kind = TY_FILE }
    nt.name = "File"
    id := s.types.len()
    s.types.push(nt)
    ret id
end

// type_func - `elem` holds the return type; params are copied.
func type_func_new(s &: Sema, ret_t: int, params: Vector<int>): int:
    mut nt := Type { kind = TY_FUNC }
    nt.elem = ret_t
    repeat params.len() with i:
        nt.params.push(params.get(i)[0])
    end
    id := s.types.len()
    s.types.push(nt)
    ret id
end

// type_variant - members deduplicated with type_equiv, order kept.
func type_variant_new(s &: Sema, members: Vector<int>): int:
    mut nt := Type { kind = TY_VARIANT }
    repeat members.len() with i:
        m := members.get(i)[0]
        mut dup := false
        repeat nt.params.len() with j:
            if type_equiv(s, nt.params.get(j)[0], m):
                dup = true
                break
            end
        end
        if !dup:
            nt.params.push(m)
        end
    end
    id := s.types.len()
    s.types.push(nt)
    ret id
end

// type_variant_tag - member index in the variant, -1 if absent.
func type_variant_tag(s &: Sema, variant: int, member: int): int:
    if variant < 0:
        ret 0 - 1
    end
    tv := ty_at(s, variant)
    if tv.kind != TY_VARIANT:
        ret 0 - 1
    end
    repeat tv.params.len() with i:
        if type_equiv(s, tv.params.get(i)[0], member):
            ret i
        end
    end
    ret 0 - 1
end

// prim_fold (types.c) - one UTF-8 unit, folding Arabic/Farsi yeh (D9 8A /
// DB 8C -> 0x101) and kaf (D9 83 / DA A9 -> 0x102). Also used for su_fold
// (sema_util.c), which is byte-identical in the C.
func prim_fold(s: str, i &: int): int:
    n := str.Len(s)
    if i >= n:
        ret 0
    end
    b0 := byte_at(s, i)
    if i + 1 < n:
        b1 := byte_at(s, i + 1)
        if (b0 == 217 && b1 == 138) || (b0 == 219 && b1 == 140):
            i += 2
            ret 257
        end
        if (b0 == 217 && b1 == 131) || (b0 == 218 && b1 == 169):
            i += 2
            ret 258
        end
    end
    i += 1
    ret b0
end

// prim_name_eq (types.c)
func prim_name_eq(a: str, b: str): bool:
    mut ia := 0
    mut ib := 0
    mut eq := false
    mut done := false
    until !done:
        ka := prim_fold(a, ia)
        kb := prim_fold(b, ib)
        if ka != kb:
            eq = false
            done = true
        else ka == 0:
            eq = true
            done = true
        end
    end
    ret eq
end

// type_prim_kind_from_name - lang "" = the C NULL (match any language row).
func type_prim_kind_from_name(name: str, lang: str): int:
    if str.Len(name) == 0:
        ret 0 - 1
    end
    mut want := 0
    if str.Len(lang) >= 2:
        b0 := byte_at(lang, 0)
        b1 := byte_at(lang, 1)
        if b0 == 102 && b1 == 97:
            want = L_FA
        else b0 == 101 && b1 == 110:
            want = L_EN
        else b0 == 97 && b1 == 114:
            want = L_AR
        end
    end
    repeat K_SM_PRIM_COUNT with i:
        if prim_name_eq(name, k_sm_prim_names[i]):
            if want == 0 || k_sm_prim_langs[i] == want:
                ret k_sm_prim_kinds[i]
            end
        end
    end
    ret 0 - 1
end

// type_is_error - the C also treats a NULL type as error.
func type_is_error(s &: Sema, t: int): bool:
    if t < 0:
        ret true
    end
    ret ty_at(s, t).kind == TY_ERROR
end

func type_is_integer(s &: Sema, t: int): bool:
    if t < 0:
        ret false
    end
    k := ty_at(s, t).kind
    ret k >= TY_I8 && k <= TY_SIZE
end

func type_is_float(s &: Sema, t: int): bool:
    if t < 0:
        ret false
    end
    k := ty_at(s, t).kind
    ret k == TY_F32 || k == TY_F64
end

func type_is_numeric(s &: Sema, t: int): bool:
    ret type_is_integer(s, t) || type_is_float(s, t)
end

func type_is_signed(s &: Sema, t: int): bool:
    if t < 0:
        ret false
    end
    k := ty_at(s, t).kind
    ret k >= TY_I8 && k <= TY_I64
end

// int_rank (types.c)
func int_rank(k: int): int:
    if k == TY_I8 || k == TY_U8:
        ret 1
    end
    if k == TY_I16 || k == TY_U16:
        ret 2
    end
    if k == TY_I32 || k == TY_U32:
        ret 3
    end
    if k == TY_I64 || k == TY_U64 || k == TY_SIZE:
        ret 4
    end
    ret 0
end

// type_equiv
func type_equiv(s &: Sema, ta: int, tb: int): bool:
    if ta == tb:
        ret true
    end
    if ta < 0 || tb < 0:
        ret false
    end
    va := ty_at(s, ta)
    vb := ty_at(s, tb)
    if va.kind != vb.kind:
        ret false
    end
    k := va.kind
    if k == TY_ARRAY:
        ret va.length == vb.length && type_equiv(s, va.elem, vb.elem)
    end
    if k == TY_SLICE:
        ret type_equiv(s, va.elem, vb.elem)
    end
    if k == TY_PTR:
        ret type_equiv(s, va.pointee, vb.pointee)
    end
    if k == TY_MAP || k == TY_MAP_ITER:
        ret type_equiv(s, va.key, vb.key) && type_equiv(s, va.elem, vb.elem)
    end
    if k == TY_VEC:
        ret type_equiv(s, va.elem, vb.elem)
    end
    if k == TY_STRUCT || k == TY_ENUM || k == TY_DYN:
        if va.decl == vb.decl:
            ret true
        end
        ret str.Len(va.name) > 0 && str.Len(vb.name) > 0 && str.Equals(va.name, vb.name)
    end
    if k == TY_FUNC:
        if !type_equiv(s, va.elem, vb.elem):
            ret false
        end
        if va.params.len() != vb.params.len():
            ret false
        end
        repeat va.params.len() with i:
            if !type_equiv(s, va.params.get(i)[0], vb.params.get(i)[0]):
                ret false
            end
        end
        ret true
    end
    if k == TY_VARIANT:
        if va.params.len() != vb.params.len():
            ret false
        end
        repeat va.params.len() with i2:
            if !type_equiv(s, va.params.get(i2)[0], vb.params.get(i2)[0]):
                ret false
            end
        end
        ret true
    end
    ret true
end

// type_implicit (static in types.c)
func type_implicit(s &: Sema, src: int, dst: int): bool:
    if src < 0 || dst < 0:
        ret false
    end
    sk := ty_at(s, src).kind
    dk := ty_at(s, dst).kind
    if sk == TY_NULL && dk == TY_PTR:
        ret true
    end
    if sk == TY_ENUM && dk == TY_I32:
        ret true
    end
    if sk == TY_UCHAR && dk == TY_STR:
        ret true
    end
    if dk == TY_DYN && sk == TY_STRUCT:
        ret true
    end
    if dk == TY_VARIANT && sk != TY_VARIANT && type_variant_tag(s, dst, src) >= 0:
        ret true
    end
    if type_is_signed(s, src) && type_is_signed(s, dst):
        ret int_rank(sk) <= int_rank(dk)
    end
    if type_is_integer(s, src) && !type_is_signed(s, src) && type_is_integer(s, dst) && !type_is_signed(s, dst):
        ret int_rank(sk) <= int_rank(dk)
    end
    if type_is_integer(s, src) && type_is_float(s, dst):
        ret true
    end
    if sk == TY_F32 && dk == TY_F64:
        ret true
    end
    ret false
end

func type_assignable(s &: Sema, dst: int, src: int): bool:
    if type_is_error(s, dst) || type_is_error(s, src):
        ret true
    end
    if type_equiv(s, dst, src):
        ret true
    end
    ret type_implicit(s, src, dst)
end

func type_castable(s &: Sema, dst: int, src: int): bool:
    if type_is_error(s, dst) || type_is_error(s, src):
        ret true
    end
    if type_equiv(s, dst, src):
        ret true
    end
    dk := ty_at(s, dst).kind
    sk := ty_at(s, src).kind
    if dk == TY_PTR && sk == TY_PTR:
        ret true
    end
    if (dk == TY_STR && sk == TY_PTR) || (dk == TY_PTR && sk == TY_STR):
        ret true
    end
    if (dk == TY_STR && sk == TY_UCHAR) || (dk == TY_UCHAR && sk == TY_STR):
        ret true
    end
    if (dk == TY_PTR && type_is_integer(s, src)) || (sk == TY_PTR && type_is_integer(s, dst)):
        ret true
    end
    if (dk == TY_FUNC && sk == TY_PTR) || (dk == TY_PTR && sk == TY_FUNC):
        ret true
    end
    sn := type_is_numeric(s, src) || sk == TY_BOOL || sk == TY_CHAR || sk == TY_ENUM
    dn := type_is_numeric(s, dst) || dk == TY_BOOL || dk == TY_CHAR || dk == TY_ENUM
    if sn && dn:
        ret true
    end
    ret false
end

// type_common_arith - TYPE_NONE where the C returned NULL.
func type_common_arith(s &: Sema, ta: int, tb: int): int:
    if !type_is_numeric(s, ta) || !type_is_numeric(s, tb):
        ret TYPE_NONE
    end
    ka := ty_at(s, ta).kind
    kb := ty_at(s, tb).kind
    if ka == TY_F64 || kb == TY_F64:
        ret type_prim(s, TY_F64)
    end
    if ka == TY_F32 || kb == TY_F32:
        ret type_prim(s, TY_F32)
    end
    sa := type_is_signed(s, ta)
    sb := type_is_signed(s, tb)
    if sa != sb:
        ret TYPE_NONE
    end
    if int_rank(ka) >= int_rank(kb):
        ret ta
    end
    ret tb
end

// type_to_string. PORT-NOTE: the C clamps at 128/160/256-byte buffers; this
// port does not truncate (identical output for all sane type shapes).
func type_to_string(s &: Sema, t: int): str:
    if t < 0:
        ret "<null>"
    end
    v := ty_at(s, t)
    k := v.kind
    if k == TY_ERROR:
        ret "<error>"
    end
    if k == TY_VOID:
        ret "void"
    end
    if k == TY_BOOL:
        ret "bool"
    end
    if k == TY_CHAR:
        ret "char"
    end
    if k == TY_STR:
        ret "str"
    end
    if k == TY_UCHAR:
        ret "uchar"
    end
    if k == TY_NULL:
        ret "null"
    end
    if k == TY_I8:
        ret "i8"
    end
    if k == TY_I16:
        ret "i16"
    end
    if k == TY_I32:
        ret "i32"
    end
    if k == TY_I64:
        ret "i64"
    end
    if k == TY_U8:
        ret "u8"
    end
    if k == TY_U16:
        ret "u16"
    end
    if k == TY_U32:
        ret "u32"
    end
    if k == TY_U64:
        ret "u64"
    end
    if k == TY_SIZE:
        ret "size"
    end
    if k == TY_F32:
        ret "f32"
    end
    if k == TY_F64:
        ret "f64"
    end
    if k == TY_STRUCT || k == TY_ENUM:
        if str.Len(v.name) > 0:
            ret v.name
        end
        ret "<anon>"
    end
    if k == TY_DYN:
        if str.Len(v.name) > 0:
            ret "dyn " + v.name
        end
        ret "dyn <anon>"
    end
    if k == TY_PTR:
        ret type_to_string(s, v.pointee) + "*"
    end
    if k == TY_ARRAY:
        mut dims := ""
        mut cur := t
        until cur >= 0 && ty_at(s, cur).kind == TY_ARRAY:
            cv := ty_at(s, cur)
            if cv.length != 0:
                dims = dims + "[" + cv.length + "]"
            else:
                dims = dims + "[]"
            end
            cur = cv.elem
        end
        ret type_to_string(s, cur) + dims
    end
    if k == TY_MAP || k == TY_MAP_ITER:
        head := k == TY_MAP ? "HashMap" : "MapIter"
        ret head + "<" + type_to_string(s, v.key) + ", " + type_to_string(s, v.elem) + ">"
    end
    if k == TY_VEC:
        ret "Vector<" + type_to_string(s, v.elem) + ">"
    end
    if k == TY_SLICE:
        ret "slice<" + type_to_string(s, v.elem) + ">"
    end
    if k == TY_FILE:
        ret "File"
    end
    if k == TY_FUNC:
        mut out := v.length != 0 ? "externfunc(" : "func("
        repeat v.params.len() with i:
            if i > 0:
                out = out + ", "
            end
            out = out + type_to_string(s, v.params.get(i)[0])
        end
        ret out + ") " + type_to_string(s, v.elem)
    end
    if k == TY_VARIANT:
        mut out2 := "Variant<"
        repeat v.params.len() with i2:
            if i2 > 0:
                out2 = out2 + ", "
            end
            out2 = out2 + type_to_string(s, v.params.get(i2)[0])
        end
        ret out2 + ">"
    end
    ret "<?>"
end

// ===== symbol.c =====

// scope_new - inherits self_type and the enclosing function from the parent.
func scope_new(s &: Sema, kind: int, parent: int): int:
    mut sc := Scope { kind = kind }
    sc.parent = parent
    if parent != 0:
        p := scope_at(s, parent)
        sc.self_type = p.self_type
        sc.fn = p.fn
    end
    id := s.scopes.len()
    s.scopes.push(sc)
    ret id
end

func symbol_new(s &: Sema, kind: int, name: str): int:
    mut sy := Symbol { kind = kind }
    sy.name = name
    id := s.syms.len()
    s.syms.push(sy)
    ret id
end

// scope_lookup_local - linear scan (the C hash index is a perf-only detail).
func scope_lookup_local(s &: Sema, sc: int, name: str): int:
    scv := scope_at(s, sc)
    repeat scv.symbols.len() with i:
        id := scv.symbols.get(i)[0]
        if str.Equals(sym_at(s, id).name, name):
            ret id
        end
    end
    ret 0
end

// scope_lookup_where - walks parents; each level also tries its aux scope.
func scope_lookup_where(s &: Sema, sc: int, name: str, where &: int): int:
    mut cur := sc
    until cur != 0:
        found := scope_lookup_local(s, cur, name)
        if found != 0:
            where = cur
            ret found
        end
        curv := scope_at(s, cur)
        if curv.aux != 0:
            found2 := scope_lookup_where(s, curv.aux, name, where)
            if found2 != 0:
                ret found2
            end
        end
        cur = curv.parent
    end
    ret 0
end

func scope_lookup(s &: Sema, sc: int, name: str): int:
    mut w := 0 // discarded out-param (the C passed NULL)
    ret scope_lookup_where(s, sc, name, w)
end

// scope_define - 0 on success, the EXISTING SymId on duplicate (the C
// returned NULL on success / the existing symbol_t*).
func scope_define(s &: Sema, sc: int, sym: int): int:
    name := sym_at(s, sym).name
    existing := scope_lookup_local(s, sc, name)
    if existing != 0:
        ret existing
    end
    mut scv := scope_at(s, sc)
    scv.symbols.push(sym)
    scope_put(s, sc, scv)
    ret 0
end

// type_code (static in symbol.c) - compact per-type mangling codes.
func type_code(s &: Sema, t: int): str:
    if t < 0:
        ret "v"
    end
    v := ty_at(s, t)
    k := v.kind
    if k == TY_VOID:
        ret "v"
    end
    if k == TY_BOOL:
        ret "b"
    end
    if k == TY_CHAR:
        ret "c"
    end
    if k == TY_STR:
        ret "s"
    end
    if k == TY_UCHAR:
        ret "uc"
    end
    if k == TY_NULL:
        ret "n"
    end
    if k == TY_I8:
        ret "i8"
    end
    if k == TY_I16:
        ret "i16"
    end
    if k == TY_I32:
        ret "i32"
    end
    if k == TY_I64:
        ret "i64"
    end
    if k == TY_U8:
        ret "u8"
    end
    if k == TY_U16:
        ret "u16"
    end
    if k == TY_U32:
        ret "u32"
    end
    if k == TY_U64:
        ret "u64"
    end
    if k == TY_SIZE:
        ret "size"
    end
    if k == TY_F32:
        ret "f32"
    end
    if k == TY_F64:
        ret "f64"
    end
    if k == TY_STRUCT || k == TY_ENUM:
        if str.Len(v.name) > 0:
            ret v.name
        end
        ret "T"
    end
    if k == TY_PTR:
        ret "P" + type_code(s, v.pointee)
    end
    if k == TY_ARRAY:
        ret "A" + v.length + type_code(s, v.elem)
    end
    ret "x"
end

// mangle_func - struct_name "" = the C NULL. PORT-NOTE: the C clamps at a
// 512-byte buffer; not replicated.
func mangle_func(
    s &: Sema, struct_name: str, fn_name: str, param_types: Vector<int>
): str:
    mut out := ""
    if str.Len(struct_name) > 0:
        out = "S_" + struct_name + "_"
    end
    out = out + fn_name + "__"
    if param_types.len() > 0:
        repeat param_types.len() with i:
            if i > 0:
                out = out + "_"
            end
            out = out + type_code(s, param_types.get(i)[0])
        end
    else:
        out = out + "void"
    end
    ret out
end

// impl_owner_key
func impl_owner_key(typestr: str): str:
    ret "impl@" + typestr
end

// ===== sema_util.c =====

// sema_ty
func sema_ty(s &: Sema, k: int): int:
    ret type_prim(s, k)
end

// sema_err_ty
func sema_err_ty(s &: Sema): int:
    ret type_prim(s, TY_ERROR)
end

// sema_decorate - stamps the node's type_str for the XML dumps/backends.
func sema_decorate(s &: Sema, a &: at.Ast, n: int, t: int): int:
    if n != 0:
        at.SetTypeStr(a, n, type_to_string(s, t))
    end
    ret t
end

// sema_vec_str - synthesizes a `Vector<str>` type node and resolves it.
// PORT-NOTE: resolves through the generic machinery (collections prelude);
// until the 5b/5c stubs are real it reports "unknown type" and yields error.
func sema_vec_str(s &: Sema, a &: at.Ast, sp: co.SrcSpan): int:
    tn := at.NewNode(a, at.AST_TYPE)
    at.SetName(a, tn, "Vector")
    at.SetSpan(
        a, tn, sp.begin.line, sp.begin.col, sp.begin.index, sp.finish.line, sp.finish.col, sp.finish.index,
        sp.length
    )
    mut tv := at.Get(a, tn)
    tv.synthetic = true
    at.Put(a, tn, tv)
    e := at.NewNode(a, at.AST_TYPE)
    at.SetName(a, e, "str")
    at.SetSpan(
        a, e, sp.begin.line, sp.begin.col, sp.begin.index, sp.finish.line, sp.finish.col, sp.finish.index,
        sp.length
    )
    mut ev := at.Get(a, e)
    ev.synthetic = true
    at.Put(a, e, ev)
    at.AddChild(a, tn, e)
    ret sema_resolve_type(s, a, tn)
end

// struct_sym_of - the SymId behind a struct (or pointer-to-struct) type.
func struct_sym_of(s &: Sema, t: int): int:
    if t < 0:
        ret 0
    end
    v := ty_at(s, t)
    if v.kind == TY_STRUCT:
        ret v.decl
    end
    if v.kind == TY_PTR && v.pointee >= 0:
        pv := ty_at(s, v.pointee)
        if pv.kind == TY_STRUCT:
            ret pv.decl
        end
    end
    ret 0
end

// su_zwnj - zero-width non-joiner (E2 80 8C) at byte offset i.
func su_zwnj(s: str, i: int): bool:
    if i + 2 >= str.Len(s):
        ret false
    end
    ret byte_at(s, i) == 226 && byte_at(s, i + 1) == 128 && byte_at(s, i + 2) == 140
end

// The "skip ZWNJ and spaces" loop from su_ident_eq.
func su_skip(s: str, i &: int):
    n := str.Len(s)
    mut go := true
    until go:
        go = false
        if i < n && byte_at(s, i) == 32:
            i += 1
            go = true
        else su_zwnj(s, i):
            i += 3
            go = true
        end
    end
end

// su_ident_eq - identifier equality ignoring spaces/ZWNJ and folding
// yeh/kaf variants (su_fold is byte-identical to prim_fold).
func su_ident_eq(a: str, b: str): bool:
    mut ia := 0
    mut ib := 0
    mut eq := false
    mut done := false
    until !done:
        su_skip(a, ia)
        su_skip(b, ib)
        ka := prim_fold(a, ia)
        kb := prim_fold(b, ib)
        if ka != kb:
            eq = false
            done = true
        else ka == 0:
            eq = true
            done = true
        end
    end
    ret eq
end

// intrinsic_canon over k_sm_intr_types.
func intrinsic_type_canon(name: str): str:
    if str.Len(name) == 0:
        ret name
    end
    repeat K_SM_INTR_TYPE_COUNT with i:
        if su_ident_eq(name, k_sm_intr_types[i * 3]) || su_ident_eq(name, k_sm_intr_types[i * 3 + 1]):
            ret k_sm_intr_types[i * 3 + 2]
        end
    end
    ret name
end

// intrinsic_canon over k_sm_intr_methods.
func intrinsic_method_canon(name: str): str:
    if str.Len(name) == 0:
        ret name
    end
    repeat K_SM_INTR_METHOD_COUNT with i:
        if su_ident_eq(name, k_sm_intr_methods[i * 3]) || su_ident_eq(name, k_sm_intr_methods[i * 3 + 1]):
            ret k_sm_intr_methods[i * 3 + 2]
        end
    end
    ret name
end

// intrinsic_lang_form over the types table ("" = C NULL).
func intrinsic_type_lang_form(en_name: str, lang: str): str:
    if lang0(lang) == 0 || lang0(lang) == 101:
        ret ""
    end
    repeat K_SM_INTR_TYPE_COUNT with i:
        if str.Equals(k_sm_intr_types[i * 3 + 2], en_name):
            if lang0(lang) == 102:
                ret k_sm_intr_types[i * 3]
            end
            ret k_sm_intr_types[i * 3 + 1]
        end
    end
    ret ""
end

// intrinsic_lang_form over the methods table.
func intrinsic_method_lang_form(en_name: str, lang: str): str:
    if lang0(lang) == 0 || lang0(lang) == 101:
        ret ""
    end
    repeat K_SM_INTR_METHOD_COUNT with i:
        if str.Equals(k_sm_intr_methods[i * 3 + 2], en_name):
            if lang0(lang) == 102:
                ret k_sm_intr_methods[i * 3]
            end
            ret k_sm_intr_methods[i * 3 + 1]
        end
    end
    ret ""
end

// check_lang_form
func check_lang_form(s &: Sema, want: str, used: str, sp: co.SrcSpan):
    if str.Len(want) == 0 || su_ident_eq(used, want):
        ret
    end
    mut msg := "identifier '%s' must be Arabic in an Arabic file"
    if lang0(s.lang) == 102:
        msg = "identifier '%s' must be Persian in a Persian file"
    end
    serr(s, 1, sp, co.Format1(i18.Tr(msg), co.ArgStr(used)))
end

// sema_check_intrinsic_type_lang
func sema_check_intrinsic_type_lang(s &: Sema, used: str, sp: co.SrcSpan):
    if lang0(s.lang) == 0 || lang0(s.lang) == 101 || str.Len(used) == 0:
        ret
    end
    canon := intrinsic_type_canon(used)
    want := intrinsic_type_lang_form(canon, s.lang)
    check_lang_form(s, want, used, sp)
end

// sema_check_intrinsic_method_lang
func sema_check_intrinsic_method_lang(
    s &: Sema, used: str, canon: str, sp: co.SrcSpan
):
    if lang0(s.lang) == 0 || lang0(s.lang) == 101 || str.Len(used) == 0 || str.Len(canon) == 0:
        ret
    end
    want := intrinsic_method_lang_form(canon, s.lang)
    check_lang_form(s, want, used, sp)
end

// alias_for_lang - aliases is a flattened [lang, name, lang, name, ...]
// vector (node.aliases); "" = the C NULL.
func alias_for_lang(aliases: Vector<str>, lang: str): str:
    mut i := 0
    until i + 1 < aliases.len():
        if str.Equals(aliases.get(i)[0], lang):
            ret aliases.get(i + 1)[0]
        end
        i += 2
    end
    ret ""
end

// aliases_have
func aliases_have(aliases: Vector<str>, lang: str, name: str): bool:
    mut i := 0
    until i + 1 < aliases.len():
        if str.Equals(aliases.get(i)[0], lang) && su_ident_eq(aliases.get(i + 1)[0], name):
            ret true
        end
        i += 2
    end
    ret false
end

// scope_member_canon
func scope_member_canon(
    s &: Sema, a &: at.Ast, members: int, name: str, sp: co.SrcSpan
): str:
    mut lang := s.lang
    if str.Len(lang) == 0:
        lang = i18.Lang()
    end
    if str.Len(name) == 0 || members == 0:
        ret name
    end
    if !str.Equals(lang, "en"):
        msc := scope_at(s, members)
        repeat msc.symbols.len() with i:
            m := sym_at(s, msc.symbols.get(i)[0])
            if m.decl == 0:
                continue
            end
            dn := at.Get(a, m.decl)
            if aliases_have(dn.aliases, lang, name):
                ret m.name
            end
        end
    end
    if lang0(s.lang) != 0 && lang0(s.lang) != 101:
        direct := scope_lookup_local(s, members, name)
        if direct != 0:
            d := sym_at(s, direct)
            if d.decl != 0:
                dn2 := at.Get(a, d.decl)
                if !dn2.synthetic:
                    check_lang_form(
                        s, alias_for_lang(dn2.aliases, s.lang), name, sp
                    )
                end
            end
        end
    end
    ret name
end

// pkg_member_canon - also marks the package binding used.
func pkg_member_canon(
    s &: Sema, a &: at.Ast, pk: int, name: str, sp: co.SrcSpan
): str:
    mut p := sym_at(s, pk)
    p.used = true
    sym_put(s, pk, p)
    ret scope_member_canon(s, a, p.members, name, sp)
end

// local_canon
func local_canon(s &: Sema, a &: at.Ast, name: str, sp: co.SrcSpan): str:
    ret scope_member_canon(s, a, s.global, name, sp)
end

// sema_pure_fn - the current function's decl node when it is `pure`.
func sema_pure_fn(s &: Sema, a &: at.Ast): int:
    if s.cur_func != 0:
        sg := sig_at(s, s.cur_func)
        if sg.decl != 0:
            dnode := at.Get(a, sg.decl)
            if dnode.is_pure:
                ret sg.decl
            end
        end
    end
    ret 0
end

// ===== sema_type.c =====

// resolve_array_dim
func resolve_array_dim(s &: Sema, a &: at.Ast, dim: int): i64:
    if dim == 0:
        ret 0 as i64
    end
    n := at.Get(a, dim)
    sp := span_of(a, dim)
    if n.kind == at.AST_LITERAL && n.value_kind == tok.TV_INT:
        ret n.value_int as i64
    end
    if n.kind == at.AST_IDENTIFIER:
        cs := scope_lookup(s, s.cur, n.name)
        if cs != 0:
            csv := sym_at(s, cs)
            if csv.kind == SYM_CONST && csv.has_ival:
                ret csv.ival
            end
        end
        serr(s, 11, sp, i18.Tr("array size must be a constant integer"))
        ret 0 as i64
    end
    if n.kind == at.AST_MEMBER && n.a != 0 && at.KindOf(a, n.a) == at.AST_IDENTIFIER:
        pk := scope_lookup(s, s.cur, at.Get(a, n.a).name)
        if pk != 0 && sym_at(s, pk).kind == SYM_PACKAGE:
            mname := pkg_member_canon(s, a, pk, n.name, sp)
            pkv := sym_at(s, pk)
            cs2 := scope_lookup_local(s, pkv.members, mname)
            if cs2 == 0:
                serr(
                    s, 16, sp, co.Format2(
                        i18.Tr("package '%s' has no exported member '%s'"), co.ArgStr(pkv.name), co.ArgStr(mname)
                    )
                )
                ret 0 as i64
            end
            c2 := sym_at(s, cs2)
            if !c2.is_pub:
                serr(
                    s, 17, sp, co.Format2(
                        i18.Tr("'%s' is not exported by package '%s' (mark it 'pub')"), co.ArgStr(mname),
                        co.ArgStr(pkv.name)
                    )
                )
                ret 0 as i64
            end
            if c2.kind == SYM_CONST && c2.has_ival:
                ret c2.ival
            end
        end
        serr(s, 11, sp, i18.Tr("array size must be a constant integer"))
        ret 0 as i64
    end
    serr(s, 11, sp, i18.Tr("array size must be a constant integer"))
    ret 0 as i64
end

// sema_resolve_type - AST type node -> TypeId. Mutates the node's name to
// its canonical (English) form like the C, and decorates type_str.
func sema_resolve_type(s &: Sema, a &: at.Ast, tnode: int): int:
    if tnode == 0:
        ret sema_ty(s, TY_VOID)
    end
    tn := at.Get(a, tnode)
    sp := span_of(a, tnode)
    mut base := 0

    if tn.is_dyn:
        iface := scope_lookup(s, s.cur, tn.name)
        mut ok := iface != 0
        if ok:
            if sym_at(s, iface).kind != SYM_INTERFACE:
                ok = false
            end
        end
        if !ok:
            serr(
                s, 1, sp, co.Format1(
                    i18.Tr("'%s' is not an interface (required after 'dyn')"), co.ArgStr(tn.name)
                )
            )
            ret sema_err_ty(s)
        end
        mut dt := type_dyn(s, iface, tn.name)
        mut di := tn.dims.len()
        until di > 0:
            di -= 1
            dt = type_array(s, dt, resolve_array_dim(s, a, tn.dims.get(di)[0]))
        end
        if tn.is_pointer:
            dt = type_ptr(s, dt)
        end
        ret dt
    end

    mut name := tn.name
    dot := str.IndexOf(name, ".")
    if dot >= 0:
        // package-qualified type "pkg.Type" (C: char pname[64] truncation)
        mut pl := dot
        if pl > 63:
            pl = 63
        end
        pname := str.Substr(name, 0, pl)
        mut tname := str.Substr(name, dot + 1, str.Len(name) - dot - 1)
        pk2 := scope_lookup(s, s.cur, pname)
        mut pk2_ok := pk2 != 0
        if pk2_ok:
            if sym_at(s, pk2).kind != SYM_PACKAGE:
                pk2_ok = false
            end
        end
        if !pk2_ok:
            serr(
                s, 1, sp, co.Format2(
                    i18.Tr("unknown package '%s' in type '%s'"), co.ArgStr(pname), co.ArgStr(name)
                )
            )
            ret sema_err_ty(s)
        end
        tname = pkg_member_canon(s, a, pk2, tname, sp)
        tsym := scope_lookup_local(s, sym_at(s, pk2).members, tname)
        mut tks := 0 - 1
        if tsym != 0:
            tks = sym_at(s, tsym).kind
        end
        if tsym == 0 || (tks != SYM_STRUCT && tks != SYM_ENUM && tks != SYM_ALIAS):
            serr(
                s, 1, sp, co.Format2(
                    i18.Tr("package '%s' has no exported type '%s'"), co.ArgStr(pname), co.ArgStr(tname)
                )
            )
            ret sema_err_ty(s)
        end
        tsv := sym_at(s, tsym)
        if !tsv.is_pub:
            serr(
                s, 17, sp, co.Format2(
                    i18.Tr("'%s' is not exported by package '%s' (mark it 'pub')"), co.ArgStr(tname),
                    co.ArgStr(pname)
                )
            )
            ret sema_err_ty(s)
        end
        if tks == SYM_STRUCT && tsv.decl != 0 && at.TyparamCount(a, tsv.decl) > 0:
            if tn.list.len() == 0:
                serr(
                    s, 1, sp, co.Format1(
                        i18.Tr("generic type '%s' requires type arguments"), co.ArgStr(name)
                    )
                )
                ret sema_err_ty(s)
            end
            save_cur := s.cur
            save_gp := s.gen_pkg
            pkm := sym_at(s, pk2).members
            s.cur = pkm
            s.gen_pkg = pkm
            inst := g_instantiate_struct(s, a, tsv.decl, tn.list, sp)
            s.cur = save_cur
            s.gen_pkg = save_gp
            if inst != 0:
                base = sym_at(s, inst).ty
            else:
                base = sema_err_ty(s)
            end
            if tn.is_pointer:
                base = type_ptr(s, base)
            end
            ret base
        end
        base = tsv.ty
        if tn.is_pointer:
            base = type_ptr(s, base)
        end
        ret base
    end

    if str.Len(name) > 0 && type_prim_kind_from_name(name, "") < 0:
        orig := name
        name = intrinsic_type_canon(local_canon(s, a, name, sp))
        at.SetName(a, tnode, name)
        if !tn.synthetic:
            sema_check_intrinsic_type_lang(s, orig, sp)
        end
    end

    if str.Len(name) > 0 && str.Equals(name, "func"):
        mut ptypes := Vector {} as Vector<int>
        repeat tn.list.len() with fi:
            ptypes.push(sema_resolve_type(s, a, tn.list.get(fi)[0]))
        end
        mut ret_t := sema_ty(s, TY_VOID)
        if tn.ty != 0:
            ret_t = sema_resolve_type(s, a, tn.ty)
        end
        base = type_func_new(s, ret_t, ptypes)
        ptypes.free()
        if tn.is_extern:
            mut bt := ty_at(s, base)
            bt.length = 1 as i64
            ty_put(s, base, bt)
        end
        if tn.is_pointer:
            base = type_ptr(s, base)
        end
        sema_decorate(s, a, tnode, base)
        ret base
    end

    mut pkk := 0 - 1
    if str.Len(name) > 0:
        pkk = type_prim_kind_from_name(name, "")
    end

    if str.Len(name) > 0 && str.Equals(name, "File"):
        base = type_file(s)
    else str.Len(name) > 0 && str.Equals(name, "Variant"):
        if tn.list.len() < 2:
            serr(
                s, 1, sp, co.Format1(
                    i18.Tr("'Variant' requires at least 2 type arguments (got %zu)"), co.ArgUint(tn.list.len() as u64)
                )
            )
            base = sema_err_ty(s)
        else:
            mut members := Vector {} as Vector<int>
            mut vn := tn.list.len()
            if vn > 64:
                vn = 64
            end
            repeat vn with vi:
                m := sema_resolve_type(s, a, tn.list.get(vi)[0])
                if m >= 0:
                    if ty_at(s, m).kind == TY_VARIANT:
                        serr(
                            s, 1, sp, i18.Tr("'Variant' cannot contain another 'Variant' as a member")
                        )
                    end
                end
                members.push(m)
            end
            base = type_variant_new(s, members)
            members.free()
        end
    else pkk >= 0:
        base = type_prim(s, pkk)
    else generic_template(s, a, name, SYM_STRUCT) != 0:
        gt := generic_template(s, a, name, SYM_STRUCT)
        gtv := sym_at(s, gt)
        save_gp2 := s.gen_pkg
        if gtv.home != 0:
            s.gen_pkg = gtv.home
        end
        inst2 := g_instantiate_struct(s, a, gtv.decl, tn.list, sp)
        s.gen_pkg = save_gp2
        if inst2 != 0:
            base = sym_at(s, inst2).ty
        else:
            base = sema_err_ty(s)
        end
    else:
        mut sym := 0
        if str.Len(name) > 0:
            sym = scope_lookup(s, s.cur, name)
        end
        mut home := 0
        if sym != 0:
            home = sym_at(s, sym).home
        end
        if sym == 0 && str.Len(name) > 0:
            sema_load_prelude(s, a)
            if s.prelude != 0:
                sym = scope_lookup_local(s, s.prelude, name)
                home = s.prelude
            end
        end
        mut handled := false
        if sym != 0:
            sv := sym_at(s, sym)
            if sv.decl != 0 && at.TyparamCount(a, sv.decl) > 0:
                handled = true
                if tn.list.len() == 0:
                    serr(
                        s, 1, sp, co.Format1(
                            i18.Tr("generic type '%s' requires type arguments"), co.ArgStr(name)
                        )
                    )
                    base = sema_err_ty(s)
                else:
                    save_gp3 := s.gen_pkg
                    if home != 0:
                        s.gen_pkg = home
                    end
                    inst3 := g_instantiate_struct(s, a, sv.decl, tn.list, sp)
                    s.gen_pkg = save_gp3
                    if inst3 != 0:
                        base = sym_at(s, inst3).ty
                    else:
                        base = sema_err_ty(s)
                    end
                end
            else sv.kind == SYM_STRUCT || sv.kind == SYM_ENUM || sv.kind == SYM_ALIAS:
                handled = true
                base = sv.ty
            end
        end
        if !handled:
            nm := str.Len(name) > 0 ? name : "?"
            serr(s, 1, sp, co.Format1(i18.Tr("unknown type '%s'"), co.ArgStr(nm)))
            base = sema_err_ty(s)
        end
    end

    mut ai := tn.dims.len()
    until ai > 0:
        ai -= 1
        base = type_array(s, base, resolve_array_dim(s, a, tn.dims.get(ai)[0]))
    end
    if tn.is_slice:
        base = type_slice(s, base)
    end
    if tn.is_pointer:
        base = type_ptr(s, base)
    end
    sema_decorate(s, a, tnode, base)
    ret base
end

// ===== builtins.c =====

// salam_builtin_lookup - index into the k_sm_builtin_* arrays, -1 = C NULL.
func builtin_lookup(name: str): int:
    repeat K_SM_BUILTIN_COUNT with i:
        if str.Equals(k_sm_builtin_names[i], name):
            ret i
        end
    end
    ret 0 - 1
end

// salam_version_code - SALAM_VERSION "maj.min.pat" -> maj*10000+min*100+pat.
func version_code(): int:
    v := co.VERSION
    n := str.Len(v)
    mut parts := [0, 0, 0] as int[3]
    mut pi := 0
    mut i := 0
    until i < n:
        b := byte_at(v, i)
        if b >= 48 && b <= 57:
            parts[pi] = parts[pi] * 10 + (b - 48)
        else b == 46:
            if pi < 2:
                pi += 1
            else:
                break
            end
        else:
            break
        end
        i += 1
    end
    ret parts[0] * 10000 + parts[1] * 100 + parts[2]
end

// salam_builtin_global_const - rewrites the node into a literal in place.
func builtin_global_const(a &: at.Ast, id: int, name: str, is_str &: bool): bool:
    if str.Equals(name, "SALAM_VERSION"):
        mut n := at.Get(a, id)
        n.kind = at.AST_LITERAL
        n.op = tok.TK_STRING
        n.value_kind = tok.TV_STRING
        n.value_str = co.VERSION
        n.a = 0
        n.b = 0
        n.synthetic = false
        at.Put(a, id, n)
        is_str = true
        ret true
    end
    if str.Equals(name, "SALAM_VERSION_CODE"):
        mut n2 := at.Get(a, id)
        n2.kind = at.AST_LITERAL
        n2.op = tok.TK_INT
        n2.value_kind = tok.TV_INT
        n2.value_int = version_code() as u64
        n2.value_float = 0.0
        n2.value_str = ""
        n2.a = 0
        n2.b = 0
        n2.synthetic = false
        at.Put(a, id, n2)
        is_str = false
        ret true
    end
    ret false
end

// ===========================================================================
// ===== sema.c (stdlib root, sysroots, bundled tools) =====
// ===========================================================================

// file_exists - the C fopen("rb") probe (which also opens directories on
// Linux); os.Exists is access()-based and matches that behavior.
func file_exists(p: str): bool:
    ret os.Exists(p)
end

func root_has_std(root: str): bool:
    if str.Len(root) > 0:
        ret file_exists(root + "/std/core/core.salam")
    end
    ret file_exists("std/core/core.salam")
end

// derive_root - accepts either the root itself or its std/ subdirectory.
func derive_root(path: str): str:
    if file_exists(path + "/std/core/core.salam"):
        ret path
    end
    if file_exists(path + "/core/core.salam"):
        mut out := path
        mut e := str.Len(out)
        until e > 0 && (byte_at(out, e - 1) == 47 || byte_at(out, e - 1) == 92):
            e -= 1
        end
        out = str.Substr(out, 0, e)
        mut cut := 0 - 1
        repeat str.Len(out) with i:
            b := byte_at(out, i)
            if b == 47 || b == 92:
                cut = i
            end
        end
        if cut >= 0:
            ret str.Substr(out, 0, cut)
        end
        ret ""
    end
    ret path
end

func path_is_absolute(p: str): bool:
    if str.Len(p) == 0:
        ret false
    end
    b0 := byte_at(p, 0)
    if b0 == 47 || b0 == 92:
        ret true
    end
    if str.Len(p) >= 2 && byte_at(p, 1) == 58 && ((b0 >= 65 && b0 <= 90) || (b0 >= 97 && b0 <= 122)):
        ret true
    end
    ret false
end

// get_exe_dir - PORT-NOTE: the C reads /proc/self/exe (or the platform
// equivalent); the port derives the directory from os.Args()[0]. Only a
// fallback path (explicit roots / SALAM_STD are consulted first).
func get_exe_dir(out &: str): bool:
    args := os.Args()
    defer args.free()
    if args.len() == 0:
        ret false
    end
    a0 := args.get(0)[0]
    mut cut := 0 - 1
    repeat str.Len(a0) with i:
        b := byte_at(a0, i)
        if b == 47 || b == 92:
            cut = i
        end
    end
    if cut < 0:
        ret false
    end
    out = str.Substr(a0, 0, cut)
    ret true
end

func has_prefix_at(s0: str, at0: int, pre: str): bool:
    pl := str.Len(pre)
    if at0 + pl > str.Len(s0):
        ret false
    end
    ret str.Equals(str.Substr(s0, at0, pl), pre)
end

// One salam.cfg line of read_cfg_stdlib: "stdlib[_path] = <value>".
func parse_cfg_line(line: str, out &: str): bool:
    n := str.Len(line)
    mut p := 0
    until p < n && (byte_at(line, p) == 32 || byte_at(line, p) == 9):
        p += 1
    end
    if p < n && (byte_at(line, p) == 35 || byte_at(line, p) == 59):
        ret false
    end
    mut key := 0 - 1
    if has_prefix_at(line, p, "stdlib_path"):
        key = p + 11
    else has_prefix_at(line, p, "stdlib"):
        key = p + 6
    end
    if key < 0:
        ret false
    end
    until key < n && (byte_at(line, key) == 32 || byte_at(line, key) == 9):
        key += 1
    end
    if key >= n || byte_at(line, key) != 61:
        ret false
    end
    key += 1
    until key < n && (byte_at(line, key) == 32 || byte_at(line, key) == 9):
        key += 1
    end
    mut e := n
    until e > key:
        b := byte_at(line, e - 1)
        if b == 10 || b == 13 || b == 32 || b == 9:
            e -= 1
        else:
            break
        end
    end
    if e <= key:
        ret false
    end
    out = str.Substr(line, key, e - key)
    ret true
end

func read_cfg_stdlib(cfg: str, out &: str): bool:
    if !file_exists(cfg) || os.IsDir(cfg):
        ret false
    end
    text := os.ReadFile(cfg)
    n := str.Len(text)
    mut ls := 0
    until ls < n:
        mut le := ls
        until le < n && byte_at(text, le) != 10:
            le += 1
        end
        if parse_cfg_line(str.Substr(text, ls, le - ls), out):
            ret true
        end
        ls = le + 1
    end
    ret false
end

func resolve_stdlib_root(explicit_path: str): str:
    if str.Len(explicit_path) > 0:
        ret derive_root(explicit_path)
    end
    env := os.Env("SALAM_STD")
    if str.Len(env) > 0:
        r := derive_root(env)
        if root_has_std(r):
            ret r
        end
    end
    mut exedir := ""
    if get_exe_dir(exedir):
        mut val := ""
        if read_cfg_stdlib(exedir + "/salam.cfg", val):
            mut abs_val := val
            if !path_is_absolute(val):
                abs_val = exedir + "/" + val
            end
            r2 := derive_root(abs_val)
            if root_has_std(r2):
                ret r2
            end
        end
        // Dev checkout layout (post self-host restructure): std/ lives at the
        // repo root, a sibling of compiler/ (where this binary lives) - so
        // "../std" (candidate "..") is the primary case now, not "compiler".
        rel := [".", "..", "../share/salam", "../lib/salam"] as str[4]
        repeat 4 with i:
            cand := exedir + "/" + rel[i]
            if root_has_std(cand):
                ret cand
            end
        end
    end
    // #ifdef SALAM_STDLIB_PREFIX (configure-time install prefix): no port
    // equivalent; installed layouts are covered by the exe-relative paths.
    ret ""
end

// salam_set_stdlib_root / salam_get_stdlib_root
func set_stdlib_root_impl(root: str):
    g_sm_stdlib_root = resolve_stdlib_root(root)
    g_sm_stdlib_resolved = true
end

func get_stdlib_root(): str:
    if !g_sm_stdlib_resolved:
        set_stdlib_root_impl("")
    end
    ret g_sm_stdlib_root
end

func mingw_sysroot_subdir(triple: str): str:
    if str.Len(triple) == 0:
        ret ""
    end
    win := str.Contains(triple, "windows") || str.Contains(triple, "mingw") || str.Contains(triple, "win32")
    gnu := str.Contains(triple, "gnu") || str.Contains(triple, "mingw")
    if !win || !gnu:
        ret ""
    end
    if str.Contains(triple, "x86_64") || str.Contains(triple, "amd64"):
        ret "x86_64-w64-mingw32"
    end
    if str.Contains(triple, "aarch64") || str.Contains(triple, "arm64"):
        ret "aarch64-w64-mingw32"
    end
    if str.Contains(triple, "i686") || str.Contains(triple, "i386") || str.Contains(triple, "i586") || str.Contains(triple, "x86"):
        ret "i686-w64-mingw32"
    end
    if str.Contains(triple, "armv7") || str.Contains(triple, "arm"):
        ret "armv7-w64-mingw32"
    end
    ret ""
end

func sysroot_looks_valid(dir: str): bool:
    ret file_exists(dir + "/include/windows.h")
end

// ===========================================================================
// ===== sema.c (import path resolution) =====
// ===========================================================================

// path_normalize - EXACTLY the C: strips leading "./" pairs and collapses
// "/./"; ".." is deliberately NOT collapsed (import dedup keys depend on
// this - see salam/PORTING.md "Layout - FLAT").
func path_normalize(p: str): str:
    mut q := p
    until str.Len(q) >= 2 && byte_at(q, 0) == 46 && byte_at(q, 1) == 47:
        q = str.Substr(q, 2, str.Len(q) - 2)
    end
    mut idx := str.IndexOf(q, "/./")
    until idx >= 0:
        q = str.Substr(q, 0, idx + 1) + str.Substr(q, idx + 3, str.Len(q) - idx - 3)
        idx = str.IndexOf(q, "/./")
    end
    ret q
end

// norm_ident - ZWNJ (E2 80 8C) -> space, Arabic yeh (D9 8A) -> Farsi yeh
// (DB 8C), Arabic kaf (D9 83) -> Farsi kaf (DA A9).
func norm_ident(s0: str): str:
    n := str.Len(s0)
    mut need := false
    mut i := 0
    until i < n:
        b0 := byte_at(s0, i)
        if b0 == 226 && i + 2 < n && byte_at(s0, i + 1) == 128 && byte_at(s0, i + 2) == 140:
            need = true
            break
        end
        if b0 == 217 && i + 1 < n && (byte_at(s0, i + 1) == 138 || byte_at(s0, i + 1) == 131):
            need = true
            break
        end
        i += 1
    end
    if !need:
        ret s0
    end
    mut out := ""
    mut j := 0
    until j < n:
        c0 := byte_at(s0, j)
        mut c1 := 0
        if j + 1 < n:
            c1 = byte_at(s0, j + 1)
        end
        if c0 == 226 && c1 == 128 && j + 2 < n && byte_at(s0, j + 2) == 140:
            out = out + " "
            j += 3
        else c0 == 217 && c1 == 138:
            out = out + "ی"
            j += 2
        else c0 == 217 && c1 == 131:
            out = out + "ک"
            j += 2
        else:
            out = out + str.Substr(s0, j, 1)
            j += 1
        end
    end
    ret out
end

// index_pkg_file - scans a std package file's pre-`package` header for
// @en/@fa/@ar "alias" annotations and records (lang, alias, canon) rows.
func index_pkg_file(path: str, canon: str):
    mut sf := src.New()
    if !src.Load(path, sf):
        ret
    end
    txt := sf.text
    n := sf.len
    mut limit := str.IndexOf(txt, "package ")
    if limit < 0:
        limit = n
    end
    mut i := 0
    until i + 4 < limit && g_sm_seg_n < K_SM_SEG_MAX:
        if byte_at(txt, i) != 64:
            i += 1
            continue
        end
        b1 := byte_at(txt, i + 1)
        b2 := byte_at(txt, i + 2)
        mut lang := ""
        if b1 == 101 && b2 == 110:
            lang = "en"
        else b1 == 102 && b2 == 97:
            lang = "fa"
        else b1 == 97 && b2 == 114:
            lang = "ar"
        end
        if str.Len(lang) == 0:
            i += 1
            continue
        end
        mut cur := i + 3
        until g_sm_seg_n < K_SM_SEG_MAX:
            mut q := cur
            until q < n && (byte_at(txt, q) == 32 || byte_at(txt, q) == 9):
                q += 1
            end
            if q >= n || byte_at(txt, q) != 34 || q >= limit:
                break
            end
            mut e := 0 - 1
            mut k := q + 1
            until k < n:
                if byte_at(txt, k) == 34:
                    e = k
                    break
                end
                k += 1
            end
            if e < 0:
                break
            end
            g_sm_seg_lang.push(lang)
            g_sm_seg_alias.push(norm_ident(str.Substr(txt, q + 1, e - q - 1)))
            g_sm_seg_canon.push(canon)
            g_sm_seg_n += 1
            cur = e + 1
        end
        if cur > i + 3:
            i = cur - 1
        end
        i += 1
    end
end

func scan_std_dir(base: str, depth: int):
    entries := os.ListDir(base)
    defer entries.free()
    repeat entries.len() with i:
        e := entries.get(i)[0]
        pf := base + "/" + e + "/" + e + ".salam"
        if file_exists(pf):
            index_pkg_file(pf, e)
        end
        if depth > 0:
            scan_std_dir(base + "/" + e, depth - 1)
        end
    end
end

func build_seg_index(root: str):
    g_sm_seg_lang.clear()
    g_sm_seg_alias.clear()
    g_sm_seg_canon.clear()
    g_sm_seg_n = 0
    mut base := "std"
    if str.Len(root) > 0:
        base = root + "/std"
    end
    scan_std_dir(base, 2)
    g_sm_seg_root = root
end

// seg_to_canon - "" = the C NULL.
func seg_to_canon(root: str, seg: str, lang: str): str:
    if g_sm_seg_n < 0 || !str.Equals(g_sm_seg_root, root):
        build_seg_index(root)
    end
    ns := norm_ident(seg)
    repeat g_sm_seg_n with i:
        if str.Equals(g_sm_seg_lang.get(i)[0], lang) && str.Equals(g_sm_seg_alias.get(i)[0], ns):
            ret g_sm_seg_canon.get(i)[0]
        end
    end
    ret ""
end

// resolve_ident_import - dotted package name via the alias index; "" = NULL.
func resolve_ident_import(root: str, dotted: str, lang: str): str:
    n := str.Len(dotted)
    mut spec := ""
    mut last := ""
    mut pos := 0
    until pos < n:
        mut dot := str.IndexFrom(dotted, ".", pos)
        if dot >= n:
            dot = 0 - 1 // some IndexFrom impls return len; normalize to -1
        end
        seglen := dot >= 0 ? dot - pos : n - pos
        seg := str.Substr(dotted, pos, seglen)
        canon := seg_to_canon(root, seg, lang)
        if str.Len(canon) == 0:
            ret ""
        end
        if str.Len(spec) > 0:
            spec = spec + "/"
        end
        spec = spec + canon
        last = canon
        if dot < 0:
            break
        end
        pos = dot + 1
    end
    if str.Len(last) == 0:
        ret ""
    end
    if str.Len(root) > 0:
        ret root + "/std/" + spec + "/" + last + ".salam"
    end
    ret "std/" + spec + "/" + last + ".salam"
end

// resolve_ident_direct - dotted segments used verbatim; "" = NULL.
func resolve_ident_direct(root: str, dotted: str): str:
    n := str.Len(dotted)
    mut spec := ""
    mut last := ""
    mut pos := 0
    until pos < n:
        mut dot := str.IndexFrom(dotted, ".", pos)
        if dot >= n:
            dot = 0 - 1
        end
        seglen := dot >= 0 ? dot - pos : n - pos
        seg := str.Substr(dotted, pos, seglen)
        if str.Len(spec) > 0:
            spec = spec + "/"
        end
        spec = spec + seg
        last = seg
        if dot < 0:
            break
        end
        pos = dot + 1
    end
    if str.Len(last) == 0:
        ret ""
    end
    mut out := "std/" + spec + "/" + last + ".salam"
    if str.Len(root) > 0:
        out = root + "/std/" + spec + "/" + last + ".salam"
    end
    if file_exists(out):
        ret out
    end
    ret ""
end

func resolve_user_string(dir: str, spec: str): str:
    has_ext := str.Contains(spec, ".salam")
    mut p := spec
    if str.Len(dir) > 0:
        p = dir + "/" + spec
    end
    if !has_ext:
        p = p + ".salam"
    end
    ret path_normalize(p)
end

// salam_resolve_import - always returns a path (possibly nonexistent).
func resolve_import(dir: str, spec: str): str:
    root := get_stdlib_root()
    has_ext := str.Contains(spec, ".salam")
    if has_ext:
        mut p := spec
        if str.Len(dir) > 0:
            p = dir + "/" + spec
        end
        ret path_normalize(p)
    end
    mut last := spec
    sl := str.LastIndex(spec, "/")
    if sl >= 0:
        last = str.Substr(spec, sl + 1, str.Len(spec) - sl - 1)
    end
    mut p2 := "std/" + spec + "/" + last + ".salam"
    if str.Len(root) > 0:
        p2 = root + "/std/" + spec + "/" + last + ".salam"
    end
    if !file_exists(p2):
        loc := resolve_ident_import(root, spec, i18.Lang())
        if str.Len(loc) > 0:
            ret loc
        end
    end
    ret p2
end

// salam_resolve_import_node - "" = the C NULL (not found).
func resolve_import_node(a &: at.Ast, dir: str, imp: int, lang: str): str:
    n := at.Get(a, imp)
    if n.value_kind == tok.TV_STRING:
        ret resolve_user_string(dir, n.value_str)
    end
    if str.Len(n.name) > 0:
        root := get_stdlib_root()
        mut use_lang := "en"
        if str.Len(lang) > 0:
            use_lang = lang
        end
        aliased := resolve_ident_import(root, n.name, use_lang)
        if str.Len(aliased) > 0:
            ret aliased
        end
        if str.Equals(use_lang, "en"):
            direct := resolve_ident_direct(root, n.name)
            if str.Len(direct) > 0:
                ret direct
            end
        end
        ret ""
    end
    ret ""
end

// import_local_name - the name an import binds in the current scope.
func import_local_name(a &: at.Ast, imp: int, spec: str): str:
    n := at.Get(a, imp)
    if n.value_kind != tok.TV_STRING:
        mut nm := spec
        if str.Len(n.name) > 0:
            nm = n.name
        end
        dot := str.LastIndex(nm, ".")
        if dot >= 0:
            ret str.Substr(nm, dot + 1, str.Len(nm) - dot - 1)
        end
        ret nm
    end
    if str.Len(n.name) > 0:
        ret n.name
    end
    seg := base_of(spec)
    dot2 := str.IndexOf(seg, ".salam")
    if dot2 >= 0:
        ret str.Substr(seg, 0, dot2)
    end
    ret seg
end

// base_of - the path component after the last '/' or '\\'.
func base_of(path: str): str:
    mut cut := 0 - 1
    repeat str.Len(path) with i:
        b := byte_at(path, i)
        if b == 47 || b == 92:
            cut = i
        end
    end
    if cut < 0:
        ret path
    end
    ret str.Substr(path, cut + 1, str.Len(path) - cut - 1)
end

// salam_package_files - the directory auto-merge list: when the file's stem
// equals its directory's name, every sibling *.salam joins the package.
// out[0] is main_path; out[1..] are sorted (insertion sort like the C).
func package_files(main_path: str): Vector<str>:
    mut out := Vector {} as Vector<str>
    out.push(main_path)
    dir := dir_of(main_path)
    mainbase := base_of(main_path)
    dot := str.LastIndex(mainbase, ".")
    stemlen := dot >= 0 ? dot : str.Len(mainbase)
    mut dirseg := ""
    if str.Len(dir) > 0:
        dirseg = base_of(dir)
    end
    if str.Len(dirseg) != stemlen || !str.Equals(dirseg, str.Substr(mainbase, 0, stemlen)):
        ret out
    end
    mut dbuf := "."
    if str.Len(dir) > 0:
        dbuf = dir
    end
    entries := os.ListDir(dbuf)
    defer entries.free()
    repeat entries.len() with i:
        nm := entries.get(i)[0]
        // POSIX branch of the C: only the ".salam" suffix is checked
        // (directories named *.salam would be included too).
        if str.Len(nm) <= 6 || !str.EndsWith(nm, ".salam"):
            continue
        end
        if str.Equals(nm, mainbase):
            continue
        end
        if out.len() >= K_SM_PKG_FILES_MAX:
            continue
        end
        out.push(dbuf + "/" + nm)
    end
    mut i2 := 2
    until i2 < out.len():
        key := out.get(i2)[0]
        mut j := i2 - 1
        until j >= 1 && str.Compare(out.get(j)[0], key) > 0:
            out.set(j + 1, out.get(j)[0])
            j -= 1
        end
        out.set(j + 1, key)
        i2 += 1
    end
    ret out
end

// import_spec_of ("" = the C NULL)
func import_spec_of(n: at.Node): str:
    if n.value_kind == tok.TV_STRING:
        ret n.value_str
    end
    ret n.name
end

// salam_merge_program - appends src's decls to dst, skipping duplicate
// imports/links; the first appended node gets file_boundary = true.
func merge_program(a &: at.Ast, dst: int, srcprog: int):
    mut marked := false
    sl := at.Get(a, srcprog).list
    repeat sl.len() with i:
        did := sl.get(i)[0]
        d := at.Get(a, did)
        if d.kind == at.AST_IMPORT:
            spec := import_spec_of(d)
            mut dup := false
            dl := at.Get(a, dst).list
            repeat dl.len() with j:
                e := at.Get(a, dl.get(j)[0])
                if e.kind == at.AST_IMPORT:
                    es := import_spec_of(e)
                    if str.Len(spec) > 0 && str.Len(es) > 0 && str.Equals(spec, es):
                        dup = true
                        break
                    end
                end
            end
            if dup:
                continue
            end
        else d.kind == at.AST_LINK:
            mut lib := ""
            if d.value_kind == tok.TV_STRING:
                lib = d.value_str
            end
            mut dup2 := false
            if str.Len(lib) > 0:
                dl2 := at.Get(a, dst).list
                repeat dl2.len() with j2:
                    e2 := at.Get(a, dl2.get(j2)[0])
                    if e2.kind == at.AST_LINK:
                        mut el := ""
                        if e2.value_kind == tok.TV_STRING:
                            el = e2.value_str
                        end
                        if str.Len(el) > 0 && str.Equals(lib, el):
                            dup2 = true
                            break
                        end
                    end
                end
            end
            if dup2:
                continue
            end
        end
        if !marked:
            mut dm := at.Get(a, did)
            dm.file_boundary = true
            at.Put(a, did, dm)
            marked = true
        end
        at.AddChild(a, dst, did)
    end
end

// ===========================================================================
// ===== sema_order.c =====
// ===========================================================================

func safe_name(a &: at.Ast, d: int): str:
    if d == 0:
        ret "?"
    end
    nm := at.Get(a, d).name
    if str.Len(nm) > 0:
        ret nm
    end
    ret "?"
end

// check_pub_order - rule E088; restarts at every merged file boundary.
func check_pub_order(s &: Sema, a &: at.Ast, list: Vector<int>):
    entry := lp.EntryFor(s.lang)
    mut first_pub := 0
    repeat list.len() with i:
        did := list.get(i)[0]
        if did == 0:
            continue
        end
        d := at.Get(a, did)
        if d.file_boundary:
            first_pub = 0
        end
        if d.synthetic || d.kind != at.AST_FUNC_DEF:
            continue
        end
        if d.is_extern && d.a == 0:
            continue // body-less prototype, not a real def
        end
        // main/entry is exempt from the pub-ordering rule.
        if str.Len(d.name) > 0 && (
            str.Equals(d.name, "main") || (str.Len(entry) > 0 && str.Equals(d.name, entry))
        ):
            continue
        end
        if d.is_pub:
            if first_pub == 0:
                first_pub = did
            end
        else first_pub != 0:
            serr(
                s, 88, span_of(a, did), co.Format3(
                    i18.Tr("function '%s' must appear before 'pub' function '%s' (line %u): once a 'pub' function starts the public section, only other 'pub' functions may follow it, so callers can scan the end of the file for the public API"),
                    co.ArgStr(safe_name(a, did)), co.ArgStr(safe_name(a, first_pub)), co.ArgUint(at.Get(a, first_pub).begin_line as u64)
                )
            )
        end
    end
end

// sema_check_toplevel_order - import -> const -> var -> type -> func, with
// phase tracking restarting at merged-file boundaries.
func sema_check_toplevel_order(s &: Sema, a &: at.Ast, program: int):
    mut max_phase := at.AST_ORDER_IMPORT
    mut first_of := [0, 0, 0, 0, 0] as int[5]
    mut have_first := [false, false, false, false, false] as bool[5]

    prog := at.Get(a, program)
    repeat prog.list.len() with i:
        did := prog.list.get(i)[0]
        if did == 0:
            continue
        end
        d := at.Get(a, did)
        if d.file_boundary:
            max_phase = at.AST_ORDER_IMPORT
            repeat 5 with z:
                first_of[z] = 0
                have_first[z] = false
            end
        end
        if d.synthetic:
            continue
        end
        p := at.ToplevelOrderPhase(a, did)
        if p == at.AST_ORDER_NONE:
            continue
        end
        if !have_first[p]:
            have_first[p] = true
            first_of[p] = did
        end
        if p < max_phase:
            mut blocker := 0
            mut k := p + 1
            until k <= max_phase:
                if have_first[k]:
                    blocker = first_of[k]
                    break
                end
                k += 1
            end
            if blocker == 0:
                blocker = did
            end
            bline := at.Get(a, blocker).begin_line as u64
            sp := span_of(a, did)
            if p == at.AST_ORDER_IMPORT:
                serr(
                    s, 83, sp, co.Format2(
                        i18.Tr("'import' must appear before any other top-level statement, right after the package declaration; '%s' (line %u) already starts the rest of the file"),
                        co.ArgStr(safe_name(a, blocker)), co.ArgUint(bline)
                    )
                )
            else p == at.AST_ORDER_CONST:
                if max_phase >= at.AST_ORDER_TYPEDEF:
                    serr(
                        s, 84, sp, co.Format3(
                            i18.Tr("constant '%s' must be declared before any function or type definition; move it up near the top of the file with the other constants, above '%s' (line %u)"),
                            co.ArgStr(safe_name(a, did)), co.ArgStr(safe_name(a, blocker)), co.ArgUint(bline)
                        )
                    )
                else:
                    serr(
                        s, 86, sp, co.Format3(
                            i18.Tr("constant '%s' must be declared before global variables; move it above the variable section, before '%s' (line %u)"),
                            co.ArgStr(safe_name(a, did)), co.ArgStr(safe_name(a, blocker)), co.ArgUint(bline)
                        )
                    )
                end
            else p == at.AST_ORDER_VAR:
                serr(
                    s, 85, sp, co.Format3(
                        i18.Tr("global variable '%s' must be declared before any function or type definition; move it up near the top of the file, above '%s' (line %u)"),
                        co.ArgStr(safe_name(a, did)), co.ArgStr(safe_name(a, blocker)), co.ArgUint(bline)
                    )
                )
            else p == at.AST_ORDER_TYPEDEF:
                serr(
                    s, 87, sp, co.Format3(
                        i18.Tr("'%s' must be declared before any function definition; keep type, struct, enum, interface and impl declarations grouped above the functions, above '%s' (line %u)"),
                        co.ArgStr(safe_name(a, did)), co.ArgStr(safe_name(a, blocker)), co.ArgUint(bline)
                    )
                )
            end
        else p > max_phase:
            max_phase = p
        end
    end

    check_pub_order(s, a, prog.list)
    repeat prog.list.len() with j:
        did2 := prog.list.get(j)[0]
        if did2 == 0:
            continue
        end
        d2 := at.Get(a, did2)
        if !d2.synthetic && d2.kind == at.AST_IMPL_DEF:
            check_pub_order(s, a, d2.list)
        end
    end
end

func sema_check_toplevel_order_in_file(
    s &: Sema, a &: at.Ast, program: int, file: str
):
    save_file := s.file
    s.file = file
    sema_check_toplevel_order(s, a, program)
    s.file = save_file
end

// ===========================================================================
// ===== sema_decl.c =====
// ===========================================================================

// block_has_valued_ret - true when any non-lambda descendant is `ret <expr>`.
func block_has_valued_ret(a &: at.Ast, nid: int): bool:
    if nid == 0:
        ret false
    end
    n := at.Get(a, nid)
    if n.kind == at.AST_LAMBDA:
        ret false
    end
    if n.kind == at.AST_RETURN && n.a != 0:
        ret true
    end
    if block_has_valued_ret(a, n.a):
        ret true
    end
    if block_has_valued_ret(a, n.b):
        ret true
    end
    if block_has_valued_ret(a, n.c):
        ret true
    end
    if block_has_valued_ret(a, n.d):
        ret true
    end
    repeat n.list.len() with i:
        if block_has_valued_ret(a, n.list.get(i)[0]):
            ret true
        end
    end
    ret false
end

// build_sig - resolves a function declaration into a Sig record.
// owner 0 = the C NULL (free function).
func build_sig(s &: Sema, a &: at.Ast, fnid: int, owner: int): int:
    sigid := s.sigs.len()
    s.sigs.push(Sig {})
    fn := at.Get(a, fnid)
    mut ret_t := sema_ty(s, TY_VOID)
    if fn.ty != 0:
        ret_t = sema_resolve_type(s, a, fn.ty)
    end
    mut params := Vector {} as Vector<int>
    defer params.free()
    mut required := 0
    mut seen_default := false
    repeat fn.list.len() with i:
        pid := fn.list.get(i)[0]
        param := at.Get(a, pid)
        pt := sema_resolve_type(s, a, param.ty)
        params.push(pt)
        if param.a != 0:
            seen_default = true
        else !seen_default:
            required += 1
        end
    end
    mut owner_name := ""
    if owner != 0:
        owner_name = sym_at(s, owner).name
    end
    mut sg := sig_at(s, sigid)
    sg.ret_type = ret_t
    sg.decl = fnid
    sg.owner = owner
    sg.variadic = fn.is_variadic
    if fn.ty == 0 && !fn.is_extern && !fn.is_noret && fn.a != 0 && block_has_valued_ret(a, fn.a):
        sg.infer_ret = true
    end
    sg.required = required
    repeat params.len() with pi:
        sg.params.push(params.get(pi)[0])
    end
    sg.mangled = mangle_func(s, owner_name, fn.name, params)
    sig_put(s, sigid, sg)
    ret sigid
end

// get_or_make_func - the existing func/method symbol, or a fresh one. C
// quirk kept: when the name is taken by a non-function symbol, the new
// symbol is returned even though scope_define left it out of the scope.
func get_or_make_func(s &: Sema, sc: int, name: str, kind: int): int:
    sym := scope_lookup_local(s, sc, name)
    if sym != 0:
        k := sym_at(s, sym).kind
        if k == SYM_FUNC || k == SYM_METHOD:
            ret sym
        end
    end
    sym2 := symbol_new(s, kind, name)
    _dup := scope_define(s, sc, sym2)
    ret sym2
end

func link_spec_is_path(spec: str): bool:
    repeat str.Len(spec) with i:
        b := byte_at(spec, i)
        if b == 47 || b == 92:
            ret true
        end
    end
    exts := [".a", ".so", ".dll", ".lib", ".dylib"] as str[5]
    n := str.Len(spec)
    repeat 5 with j:
        el := str.Len(exts[j])
        if n > el && str.EndsWith(spec, exts[j]):
            ret true
        end
    end
    ret false
end

func check_link(s &: Sema, a &: at.Ast, did: int):
    d := at.Get(a, did)
    sp := span_of(a, did)
    mut spec := ""
    if d.value_kind == tok.TV_STRING:
        spec = d.value_str
    end
    if str.Len(spec) == 0:
        serr(s, 57, sp, i18.Tr("link directive needs a library name or path"))
        ret
    end
    if str.Len(d.name) > 0 && str.Equals(d.name, "framework"):
        ret
    end
    if byte_at(spec, 0) == 45:
        ret
    end
    if !link_spec_is_path(spec):
        ret
    end
    b0 := byte_at(spec, 0)
    mut absolute := b0 == 47 || b0 == 92
    if !absolute && str.Len(spec) >= 2 && byte_at(spec, 1) == 58 && ((b0 >= 65 && b0 <= 90) || (b0 >= 97 && b0 <= 122)):
        absolute = true
    end
    mut full := spec
    if !absolute && str.Len(s.dir) > 0:
        full = s.dir + "/" + spec
    end
    if file_exists(full):
        ret
    end
    if !str.Equals(full, spec):
        serr(
            s, 57, sp, co.Format2(
                i18.Tr("linked library not found: '%s' (resolved to '%s')"), co.ArgStr(spec), co.ArgStr(full)
            )
        )
    else:
        serr(
            s, 57, sp, co.Format1(
                i18.Tr("linked library not found: '%s'"), co.ArgStr(spec)
            )
        )
    end
end

// sema_collect - two passes: type names first, then members/sigs/globals.
// 5c note: the program list can GROW during pass 2 (generic instantiation
// appends synthetic instances), so both loops read children live via
// at.Child/ChildCount - a snapshot Vector header would dangle on realloc.
// Appended instances are synthetic and skipped, exactly like the C.
func sema_collect(s &: Sema, a &: at.Ast, program: int):
    mut i := 0
    until i < at.ChildCount(a, program):
        did := at.Child(a, program, i)
        i += 1
        d := at.Get(a, did)
        if d.synthetic:
            continue
        end
        if d.kind == at.AST_STRUCT_DEF:
            sym := symbol_new(s, SYM_STRUCT, d.name)
            mut c_type_name := d.name
            if str.Len(s.pkg) > 0 && !str.Equals(s.pkg, "main"):
                c_type_name = s.pkg + "_" + d.name
            end
            members := scope_new(s, SCOPE_STRUCT, s.global)
            mut msc := scope_at(s, members)
            msc.label = d.name
            scope_put(s, members, msc)
            mut sv := sym_at(s, sym)
            sv.decl = did
            sv.is_pub = d.is_pub
            sv.pkgname = s.pkg
            sv.ty = type_struct(s, sym, c_type_name)
            sv.members = members
            sv.home = s.global
            sym_put(s, sym, sv)
            if scope_define(s, s.global, sym) != 0:
                serr(
                    s, 1, span_of(a, did), co.Format1(i18.Tr("redefinition of '%s'"), co.ArgStr(d.name))
                )
            end
        else d.kind == at.AST_ENUM_DEF:
            sym2 := symbol_new(s, SYM_ENUM, d.name)
            mut c_enum_name := d.name
            if str.Len(s.pkg) > 0 && !str.Equals(s.pkg, "main"):
                c_enum_name = s.pkg + "_" + d.name
            end
            members2 := scope_new(s, SCOPE_STRUCT, s.global)
            mut sv2 := sym_at(s, sym2)
            sv2.decl = did
            sv2.is_pub = d.is_pub
            sv2.ty = type_enum(s, sym2, c_enum_name)
            sv2.members = members2
            sym_put(s, sym2, sv2)
            if scope_define(s, s.global, sym2) != 0:
                serr(
                    s, 1, span_of(a, did), co.Format1(i18.Tr("redefinition of '%s'"), co.ArgStr(d.name))
                )
            end
        else d.kind == at.AST_TYPE_ALIAS:
            sym3 := symbol_new(s, SYM_ALIAS, d.name)
            mut sv3 := sym_at(s, sym3)
            sv3.decl = did
            sv3.is_pub = d.is_pub
            sym_put(s, sym3, sv3)
            _ad := scope_define(s, s.global, sym3)
        else d.kind == at.AST_INTERFACE_DEF:
            sym4 := symbol_new(s, SYM_INTERFACE, d.name)
            members4 := scope_new(s, SCOPE_STRUCT, s.global)
            mut msc4 := scope_at(s, members4)
            msc4.label = d.name
            scope_put(s, members4, msc4)
            mut sv4 := sym_at(s, sym4)
            sv4.decl = did
            sv4.is_pub = d.is_pub
            sv4.members = members4
            sym_put(s, sym4, sv4)
            if scope_define(s, s.global, sym4) != 0:
                serr(
                    s, 1, span_of(a, did), co.Format1(i18.Tr("redefinition of '%s'"), co.ArgStr(d.name))
                )
            end
        end
    end

    mut i2 := 0
    until i2 < at.ChildCount(a, program):
        did := at.Child(a, program, i2)
        i2 += 1
        d := at.Get(a, did)
        if d.synthetic:
            continue
        end
        if d.kind == at.AST_LINK:
            check_link(s, a, did)
        else d.kind == at.AST_TYPE_ALIAS:
            asym := scope_lookup_local(s, s.global, d.name)
            if asym != 0:
                at2 := sema_resolve_type(s, a, d.ty)
                mut av := sym_at(s, asym)
                av.ty = at2
                sym_put(s, asym, av)
            end
        else d.kind == at.AST_STRUCT_DEF:
            if d.list.len() == 0:
                serr(
                    s, 58, span_of(a, did), co.Format1(
                        i18.Tr("empty struct '%s' (declare at least one field or method)"), co.ArgStr(d.name)
                    )
                )
            end
            if d.typarams.len() > 0:
                continue
            end
            ssym := scope_lookup_local(s, s.global, d.name)
            if ssym == 0 || sym_at(s, ssym).members == 0:
                continue // defensive: redefinition collided with a non-struct
            end
            repeat d.list.len() with j:
                mid := d.list.get(j)[0]
                m := at.Get(a, mid)
                if m.kind == at.AST_FIELD:
                    f := symbol_new(s, SYM_FIELD, m.name)
                    ft := sema_resolve_type(s, a, m.ty)
                    mut fv := sym_at(s, f)
                    fv.ty = ft
                    fv.decl = mid
                    fv.is_pub = m.is_pub
                    sym_put(s, f, fv)
                    if ft >= 0 && ty_at(s, ft).kind == TY_DYN:
                        tname := ty_at(s, ft).name
                        serr(
                            s, 2, span_of(a, mid), co.Format3(
                                i18.Tr("field '%s': a `dyn` value cannot yet be a struct field; make '%s' generic (`<T: %s>`) or store the data another way"),
                                co.ArgStr(m.name), co.ArgStr(d.name), co.ArgStr(str.Len(tname) > 0 ? tname : "Iface")
                            )
                        )
                    end
                    if scope_define(s, sym_at(s, ssym).members, f) != 0:
                        serr(
                            s, 27, span_of(a, mid), co.Format2(
                                i18.Tr("duplicate field '%s' in struct '%s'"), co.ArgStr(m.name), co.ArgStr(d.name)
                            )
                        )
                    end
                else m.kind == at.AST_FUNC_DEF:
                    mm := get_or_make_func(
                        s, sym_at(s, ssym).members, m.name, SYM_METHOD
                    )
                    sig := build_sig(s, a, mid, ssym)
                    mut mv := sym_at(s, mm)
                    if mv.decl == 0:
                        mv.decl = mid
                    end
                    if m.is_pub:
                        mv.is_pub = true
                    end
                    mv.overloads.push(sig)
                    mv.ty = sym_at(s, ssym).ty
                    sym_put(s, mm, mv)
                end
            end
        else d.kind == at.AST_INTERFACE_DEF:
            if d.list.len() == 0:
                serr(
                    s, 58, span_of(a, did), co.Format1(
                        i18.Tr("empty interface '%s' (declare at least one method)"), co.ArgStr(d.name)
                    )
                )
            end
            isym := scope_lookup_local(s, s.global, d.name)
            if isym == 0 || sym_at(s, isym).members == 0:
                continue
            end
            repeat d.list.len() with j2:
                mid2 := d.list.get(j2)[0]
                m2 := at.Get(a, mid2)
                if m2.kind != at.AST_FUNC_DEF:
                    continue
                end
                mm2 := get_or_make_func(
                    s, sym_at(s, isym).members, m2.name, SYM_METHOD
                )
                sig2 := build_sig(s, a, mid2, isym)
                mut mv2 := sym_at(s, mm2)
                if mv2.decl == 0:
                    mv2.decl = mid2
                end
                mv2.overloads.push(sig2)
                sym_put(s, mm2, mv2)
            end
        else d.kind == at.AST_IMPL_DEF:
            tt := sema_resolve_type(s, a, d.ty)
            if tt < 0 || ty_at(s, tt).kind == TY_ERROR:
                continue
            end
            ts := type_to_string(s, tt)
            at.SetTypeStr(a, d.ty, ts)
            key := impl_owner_key(ts)
            mut owner := scope_lookup_local(s, s.global, key)
            if owner == 0:
                owner = symbol_new(s, SYM_TYPEIMPL, key)
                omembers := scope_new(s, SCOPE_STRUCT, s.global)
                mut osc := scope_at(s, omembers)
                osc.label = ts
                scope_put(s, omembers, osc)
                mut ov := sym_at(s, owner)
                ov.ty = tt
                ov.members = omembers
                sym_put(s, owner, ov)
                _od := scope_define(s, s.global, owner)
            end
            iface := scope_lookup(s, s.global, d.name)
            mut iface_ok := iface != 0
            if iface_ok && sym_at(s, iface).kind != SYM_INTERFACE:
                iface_ok = false
            end
            if !iface_ok:
                serr(
                    s, 1, span_of(a, did), co.Format1(
                        i18.Tr("'%s' in `impl ... on ...` is not an interface"), co.ArgStr(d.name)
                    )
                )
            end
            repeat d.list.len() with j3:
                mid3 := d.list.get(j3)[0]
                m3 := at.Get(a, mid3)
                if m3.kind != at.AST_FUNC_DEF:
                    continue
                end
                mm3 := get_or_make_func(
                    s, sym_at(s, owner).members, m3.name, SYM_METHOD
                )
                sig3 := build_sig(s, a, mid3, owner)
                mut mv3 := sym_at(s, mm3)
                if mv3.decl == 0:
                    mv3.decl = mid3
                end
                mv3.overloads.push(sig3)
                mv3.ty = sym_at(s, owner).ty
                sym_put(s, mm3, mv3)
            end
        else d.kind == at.AST_ENUM_DEF:
            if d.list.len() == 0:
                serr(
                    s, 58, span_of(a, did), co.Format1(
                        i18.Tr("empty enum '%s' (declare at least one member)"), co.ArgStr(d.name)
                    )
                )
            end
            esym := scope_lookup_local(s, s.global, d.name)
            if esym == 0 || sym_at(s, esym).members == 0:
                continue
            end
            mut next := 0 as i64
            repeat d.list.len() with j4:
                mid4 := d.list.get(j4)[0]
                m4 := at.Get(a, mid4)
                em := symbol_new(s, SYM_ENUM_MEMBER, m4.name)
                if m4.a != 0:
                    ma := at.Get(a, m4.a)
                    if ma.kind == at.AST_LITERAL && ma.value_kind == tok.TV_INT:
                        next = ma.value_int as i64
                    end
                end
                mut ev := sym_at(s, em)
                ev.enum_value = next
                ev.ty = sym_at(s, esym).ty
                sym_put(s, em, ev)
                next = next + (1 as i64)
                if scope_define(s, sym_at(s, esym).members, em) != 0:
                    serr(
                        s, 1, span_of(a, mid4), co.Format1(
                            i18.Tr("duplicate enum member '%s'"), co.ArgStr(m4.name)
                        )
                    )
                end
            end
        else d.kind == at.AST_FUNC_DEF:
            fsym := get_or_make_func(s, s.global, d.name, SYM_FUNC)
            mut fv2 := sym_at(s, fsym)
            if fv2.decl == 0:
                fv2.decl = did
            end
            if str.Len(fv2.pkgname) == 0:
                fv2.pkgname = s.pkg
            end
            if fv2.home == 0:
                fv2.home = s.global
            end
            if d.is_pub:
                fv2.is_pub = true
            end
            sym_put(s, fsym, fv2)
            if d.typarams.len() > 0:
                continue
            end
            fsig := build_sig(s, a, did, 0)
            mut fv3 := sym_at(s, fsym)
            fv3.overloads.push(fsig)
            sym_put(s, fsym, fv3)
        else d.kind == at.AST_VAR_DECL || d.kind == at.AST_CONST_DECL:
            g := symbol_new(
                s, d.kind == at.AST_CONST_DECL ? SYM_CONST : SYM_VAR, d.name
            )
            mut gt := TYPE_NONE
            if d.ty != 0:
                gt = sema_resolve_type(s, a, d.ty)
            end
            mut gv := sym_at(s, g)
            gv.ty = gt
            gv.is_mut = d.is_mut
            gv.is_pub = d.is_pub
            gv.decl = did
            if d.kind == at.AST_CONST_DECL && d.a != 0:
                da := at.Get(a, d.a)
                if da.kind == at.AST_LITERAL && da.value_kind == tok.TV_INT:
                    gv.has_ival = true
                    gv.ival = da.value_int as i64
                end
            end
            sym_put(s, g, gv)
            if scope_define(s, s.global, g) != 0:
                serr(
                    s, 1, span_of(a, did), co.Format1(
                        i18.Tr("redefinition of global '%s'"), co.ArgStr(d.name)
                    )
                )
            end
        end
    end
end

// find_sig - the SigId among fsym's overloads whose decl is `decl`.
func find_sig(s &: Sema, fsym: int, decl: int): int:
    if fsym == 0:
        ret 0
    end
    fv := sym_at(s, fsym)
    repeat fv.overloads.len() with i:
        sgid := fv.overloads.get(i)[0]
        if sig_at(s, sgid).decl == decl:
            ret sgid
        end
    end
    ret 0
end

// check_function - declaration-level checks + (5d-stubbed) body checking.
func check_function(s &: Sema, a &: at.Ast, fnid: int, owner: int, sigid: int):
    if sigid != 0:
        mut sg0 := sig_at(s, sigid)
        if sg0.checked:
            ret
        end
        sg0.checked = true
        sg0.in_check = true
        sig_put(s, sigid, sg0)
    end
    fn := at.Get(a, fnid)
    fsp := span_of(a, fnid)
    if fn.is_noret && sigid != 0:
        sgn := sig_at(s, sigid)
        if !sgn.infer_ret && sgn.ret_type >= 0 && ty_at(s, sgn.ret_type).kind != TY_VOID:
            serr(
                s, 12, fsp, co.Format1(
                    i18.Tr("'noret' function '%s' cannot declare a return type: it never returns"), co.ArgStr(fn.name)
                )
            )
        end
    end
    if fn.is_noret && fn.is_pure:
        serr(
            s, 12, fsp, co.Format1(
                i18.Tr("'%s' cannot be both 'pure' and 'noret': a pure function must return"), co.ArgStr(fn.name)
            )
        )
    end
    if fn.is_pure && sigid != 0:
        sgp := sig_at(s, sigid)
        if !sgp.infer_ret && sgp.ret_type >= 0 && ty_at(s, sgp.ret_type).kind == TY_VOID:
            serr(
                s, 12, fsp, co.Format1(
                    i18.Tr("'pure' function '%s' must return a value: a pure function without a result has no effect"),
                    co.ArgStr(fn.name)
                )
            )
        end
    end
    if fn.is_pure:
        repeat fn.list.len() with pi:
            prm := at.Get(a, fn.list.get(pi)[0])
            if prm.kind == at.AST_PARAM && prm.is_ref:
                serr(
                    s, 12, fsp, co.Format2(
                        i18.Tr("'pure' function '%s' cannot take reference parameter '%s': writing through it would be a side effect"),
                        co.ArgStr(fn.name), co.ArgStr(prm.name)
                    )
                )
                break
            end
        end
    end
    mut home := 0
    if owner == 0:
        fs := scope_lookup_local(s, s.global, fn.name)
        if fs != 0:
            home = sym_at(s, fs).home
        end
    end
    mut parent := s.global
    if owner != 0:
        parent = sym_at(s, owner).members
    else home != 0:
        parent = home
    end
    sc := scope_new(s, SCOPE_FUNC, parent)
    mut scv := scope_at(s, sc)
    scv.label = fn.name
    scv.fn = sigid
    scope_put(s, sc, scv)
    saved_cur := s.cur
    saved_self := s.self_type
    saved_func := s.cur_func
    saved_gp := s.gen_pkg
    saved_loop := s.loop_depth
    s.loop_depth = 0
    s.cur = sc
    s.cur_func = sigid
    if home != 0:
        s.gen_pkg = home
    end
    mut seen_default := false
    repeat fn.list.len() with di:
        pid := fn.list.get(di)[0]
        param := at.Get(a, pid)
        if param.a == 0:
            if seen_default:
                serr(
                    s, 64, span_of(a, pid), co.Format1(
                        i18.Tr("parameter '%s' without a default value cannot follow a parameter with one"),
                        co.ArgStr(param.name)
                    )
                )
            end
            continue
        end
        seen_default = true
        if fn.is_extern:
            serr(
                s, 64, span_of(a, pid), co.Format1(
                    i18.Tr("extern parameter '%s' cannot have a default value"), co.ArgStr(param.name)
                )
            )
        end
        mut pt := TYPE_NONE
        mut have_sig_pt := false
        if sigid != 0:
            sgd := sig_at(s, sigid)
            if di < sgd.params.len():
                pt = sgd.params.get(di)[0]
                have_sig_pt = true
            end
        end
        if !have_sig_pt:
            pt = sema_resolve_type(s, a, param.ty)
        end
        pak := at.KindOf(a, param.a)
        if pak == at.AST_STRUCT_LIT && pt >= 0 && ty_at(s, pt).kind == TY_STRUCT:
            s.expected = pt
        else pak == at.AST_LITERAL && pt >= 0:
            s.expected = pt
        end
        dt := sema_check_expr(s, a, param.a)
        if pt >= 0 && dt >= 0 && !type_assignable(s, pt, dt):
            serr(
                s, 2, span_of(a, pid), co.Format3(
                    i18.Tr("default for parameter '%s': cannot assign '%s' to '%s'"), co.ArgStr(param.name),
                    co.ArgStr(type_to_string(s, dt)), co.ArgStr(type_to_string(s, pt))
                )
            )
        end
    end
    if owner != 0:
        ow := sym_at(s, owner)
        if ow.kind == SYM_TYPEIMPL:
            s.self_type = ow.ty
        else:
            s.self_type = type_ptr(s, ow.ty)
        end
        mut scv2 := scope_at(s, sc)
        scv2.self_type = s.self_type
        scope_put(s, sc, scv2)
        th := symbol_new(s, SYM_PARAM, "this")
        mut thv := sym_at(s, th)
        thv.ty = s.self_type
        sym_put(s, th, thv)
        _td := scope_define(s, sc, th)
    else:
        s.self_type = TYPE_NONE
    end
    repeat fn.list.len() with pi2:
        pid2 := fn.list.get(pi2)[0]
        param2 := at.Get(a, pid2)
        psym := symbol_new(s, SYM_PARAM, param2.name)
        mut pv2 := TYPE_NONE
        mut have2 := false
        if sigid != 0:
            sge := sig_at(s, sigid)
            if pi2 < sge.params.len():
                pv2 = sge.params.get(pi2)[0]
                have2 = true
            end
        end
        if !have2:
            pv2 = sema_resolve_type(s, a, param2.ty)
        end
        mut pvv := sym_at(s, psym)
        pvv.ty = pv2
        pvv.is_mut = false
        pvv.is_ref = param2.is_ref
        pvv.decl = pid2
        sym_put(s, psym, pvv)
        if scope_define(s, sc, psym) != 0:
            serr(
                s, 1, span_of(a, pid2), co.Format1(
                    i18.Tr("duplicate parameter '%s'"), co.ArgStr(param2.name)
                )
            )
        end
    end
    lg.Log(
        s.log, lg.PH_SEMANTIC, lg.LOG_DEBUG, "enter function '" + fn.name + "'" + (owner != 0 ? i18.Tr(" (method)") : "")
    )
    if fn.a != 0 && at.KindOf(a, fn.a) == at.AST_BLOCK && at.ChildCount(a, fn.a) == 0:
        serr(
            s, 61, fsp, co.Format1(
                i18.Tr("empty function '%s' (its body must contain at least one statement)"), co.ArgStr(fn.name)
            )
        )
    end
    errs0 := dg.ErrorCount(s.diag)
    if fn.a != 0:
        sema_check_block(s, a, fn.a)
    end
    if fn.a != 0 && sigid != 0:
        sgw := sig_at(s, sigid)
        if sgw.ret_widened:
            if dg.ErrorCount(s.diag) == errs0:
                saved_rq := s.requal
                mut rounds := 0
                s.requal = true
                mut sgl := sig_at(s, sigid)
                until sgl.ret_widened && rounds < 3:
                    sgl.ret_widened = false
                    sig_put(s, sigid, sgl)
                    rounds += 1
                    lg.Log(
                        s.log, lg.PH_SEMANTIC, lg.LOG_DEBUG, "re-check '" + fn.name + "' with widened return type '" + type_to_string(s, sig_at(s, sigid).ret_type) + "'"
                    )
                    sema_check_block(s, a, fn.a)
                    sgl = sig_at(s, sigid)
                end
                s.requal = saved_rq
            else:
                mut sgc := sig_at(s, sigid)
                sgc.ret_widened = false
                sig_put(s, sigid, sgc)
            end
        end
    end
    if fn.a != 0 && sigid != 0 && fn.ty != 0:
        sgf := sig_at(s, sigid)
        if type_is_float(s, sgf.ret_type) && sgf.ret_int_seen && !sgf.ret_float_seen:
            rstr := type_to_string(s, sgf.ret_type)
            serr(
                s, 67, sgf.ret_int_span, co.Format3(
                    i18.Tr("function '%s' declares return type '%s' but every 'ret' returns an integer; return a '%s' value or declare an integer return type"),
                    co.ArgStr(fn.name), co.ArgStr(rstr), co.ArgStr(rstr)
                )
            )
        end
    end
    if fn.a != 0 && sigid != 0:
        sgt := sig_at(s, sigid)
        if sgt.ret_type >= 0 && ty_at(s, sgt.ret_type).kind != TY_VOID && !type_is_error(s, sgt.ret_type) && !fn.is_noret && !fn.is_extern && !sema_stmt_terminates(s, a, fn.a):
            swarn(
                s, 71, fsp, co.Format2(
                    i18.Tr("function '%s' can fall off its end without returning a '%s' value; add a final 'ret'"),
                    co.ArgStr(fn.name), co.ArgStr(type_to_string(s, sgt.ret_type))
                )
            )
        end
    end
    lg.Log(
        s.log, lg.PH_SEMANTIC, lg.LOG_DEBUG, "exit function '" + fn.name + "'"
    )
    if fn.a != 0:
        check_unused_params(s, a, sc, fnid) // wave 5d: the E062 loop, defined below
    end
    s.cur = saved_cur
    s.self_type = saved_self
    s.cur_func = saved_func
    s.gen_pkg = saved_gp
    s.loop_depth = saved_loop
    if sigid != 0:
        mut sgz := sig_at(s, sigid)
        sgz.in_check = false
        sgz.infer_ret = false
        sig_put(s, sigid, sgz)
    end
end

// sema_check_function_now - on-demand checking (used by 5c's call checker).
func sema_check_function_now(s &: Sema, a &: at.Ast, sigid: int):
    if sigid == 0:
        ret
    end
    sg := sig_at(s, sigid)
    if sg.decl == 0:
        ret
    end
    check_function(s, a, sg.decl, sg.owner, sigid)
end

// sema_check_unused_funcs - E066, only when the program has an entry point.
func sema_check_unused_funcs(s &: Sema, a &: at.Ast):
    entry := lp.EntryFor(s.lang)
    gsc := scope_at(s, s.global)
    mut has_entry := false
    repeat gsc.symbols.len() with i:
        f := sym_at(s, gsc.symbols.get(i)[0])
        if f.kind == SYM_FUNC && str.Len(f.name) > 0 && (str.Equals(f.name, "main") || str.Equals(f.name, entry)):
            has_entry = true
            break
        end
    end
    if !has_entry:
        ret
    end
    repeat gsc.symbols.len() with i2:
        f2 := sym_at(s, gsc.symbols.get(i2)[0])
        if f2.kind != SYM_FUNC || f2.used || f2.is_pub:
            continue
        end
        if f2.decl == 0:
            continue
        end
        dn := at.Get(a, f2.decl)
        if dn.synthetic || dn.is_extern:
            continue
        end
        if str.Len(f2.name) == 0 || byte_at(f2.name, 0) == 95:
            continue
        end
        if str.Equals(f2.name, "main") || str.Equals(f2.name, entry):
            continue
        end
        serr(
            s, 66, span_of(a, f2.decl), co.Format1(
                i18.Tr("unused function '%s' (call it, mark it 'pub', or prefix its name with '_')"),
                co.ArgStr(f2.name)
            )
        )
    end
end

// check_toplevel - per-declaration checking pass.
func check_toplevel(s &: Sema, a &: at.Ast, did: int):
    d := at.Get(a, did)
    if d.kind == at.AST_FUNC_DEF:
        fsym := scope_lookup_local(s, s.global, d.name)
        check_function(s, a, did, 0, find_sig(s, fsym, did))
    else d.kind == at.AST_STRUCT_DEF:
        ssym := scope_lookup_local(s, s.global, d.name)
        if ssym == 0:
            ret
        end
        repeat d.list.len() with j:
            mid := d.list.get(j)[0]
            m := at.Get(a, mid)
            if m.kind == at.AST_FUNC_DEF:
                msym := scope_lookup_local(s, sym_at(s, ssym).members, m.name)
                check_function(s, a, mid, ssym, find_sig(s, msym, mid))
            else m.kind == at.AST_FIELD && m.a != 0:
                f := scope_lookup_local(s, sym_at(s, ssym).members, m.name)
                mut ftv := TYPE_NONE
                if f != 0:
                    ftv = sym_at(s, f).ty
                end
                mut vt := TYPE_NONE
                if f != 0 && stamp_empty_intrinsic(s, a, m.a, ftv):
                    vt = ftv
                else:
                    mak := at.KindOf(a, m.a)
                    if f != 0 && mak == at.AST_STRUCT_LIT && ftv >= 0 && ty_at(s, ftv).kind == TY_STRUCT:
                        s.expected = ftv
                    else f != 0 && mak == at.AST_LITERAL:
                        s.expected = ftv
                    end
                    vt = sema_check_expr(s, a, m.a)
                end
                if f != 0 && !type_assignable(s, ftv, vt):
                    serr(
                        s, 2, span_of(a, mid), co.Format3(
                            i18.Tr("default for field '%s': cannot assign '%s' to '%s'"), co.ArgStr(m.name),
                            co.ArgStr(type_to_string(s, vt)), co.ArgStr(type_to_string(s, ftv))
                        )
                    )
                end
            end
        end
    else d.kind == at.AST_IMPL_DEF:
        tt := sema_resolve_type(s, a, d.ty)
        if tt < 0:
            ret
        end
        owner := scope_lookup_local(
            s, s.global, impl_owner_key(type_to_string(s, tt))
        )
        if owner == 0:
            ret
        end
        repeat d.list.len() with j2:
            mid2 := d.list.get(j2)[0]
            if at.KindOf(a, mid2) != at.AST_FUNC_DEF:
                continue
            end
            m2 := at.Get(a, mid2)
            msym2 := scope_lookup_local(s, sym_at(s, owner).members, m2.name)
            check_function(s, a, mid2, owner, find_sig(s, msym2, mid2))
        end
    else d.kind == at.AST_VAR_DECL || d.kind == at.AST_CONST_DECL:
        g := scope_lookup_local(s, s.global, d.name)
        t := sema_check_var_decl(s, a, did)
        if g != 0 && sym_at(s, g).ty == TYPE_NONE:
            mut gv := sym_at(s, g)
            gv.ty = t
            sym_put(s, g, gv)
        end
    else d.kind == at.AST_LAYOUT_BLOCK:
        sema_check_layout(s, a, did, "")
    end
end

// lint_lang_types - primitive type names must match the file's language.
func lint_lang_types(s &: Sema, a &: at.Ast, nid: int):
    if nid == 0:
        ret
    end
    n := at.Get(a, nid)
    if n.kind == at.AST_TYPE && str.Len(n.name) > 0 && type_prim_kind_from_name(n.name, "") >= 0 && type_prim_kind_from_name(n.name, s.lang) < 0:
        fa := lang0(s.lang) == 102
        ar := lang0(s.lang) == 97
        mut msg := "type name '%s' must be English in an English file"
        if fa:
            msg = "type name '%s' must be Persian in a Persian file"
        else ar:
            msg = "type name '%s' must be Arabic in an Arabic file"
        end
        serr(s, 1, span_of(a, nid), co.Format1(i18.Tr(msg), co.ArgStr(n.name)))
    end
    lint_lang_types(s, a, n.ty)
    lint_lang_types(s, a, n.a)
    lint_lang_types(s, a, n.b)
    lint_lang_types(s, a, n.c)
    lint_lang_types(s, a, n.d)
    repeat n.list.len() with i:
        lint_lang_types(s, a, n.list.get(i)[0])
    end
    repeat n.dims.len() with i2:
        lint_lang_types(s, a, n.dims.get(i2)[0])
    end
end

// sema_check_pass - lang lint, per-decl checks, then pending generic
// instantiations (pending grows while iterating; 5c pushes into it).
func sema_check_pass(s &: Sema, a &: at.Ast, program: int):
    // 5c note: live child reads - generic instantiation appends synthetic
    // instances to the program list while the second loop runs (they are
    // skipped there and handled through s.pending, like the C).
    mut i := 0
    until i < at.ChildCount(a, program):
        did := at.Child(a, program, i)
        i += 1
        mut d := at.Get(a, did)
        d.origin_lang = s.lang
        at.Put(a, did, d)
        if d.synthetic:
            continue
        end
        lint_lang_types(s, a, did)
    end
    mut i2 := 0
    until i2 < at.ChildCount(a, program):
        did2 := at.Child(a, program, i2)
        i2 += 1
        d2 := at.Get(a, did2)
        if d2.synthetic || d2.typarams.len() > 0:
            continue
        end
        check_toplevel(s, a, did2)
    end
    mut pi := 0
    until pi < s.pending.len():
        did3 := s.pending.get(pi)[0]
        save_lang := s.lang
        ol := at.Get(a, did3).origin_lang
        if str.Len(ol) > 0:
            s.lang = ol
        end
        check_toplevel(s, a, did3)
        s.lang = save_lang
        pi += 1
    end
end

// ===========================================================================
// ===== sema.c (package loading, imports, prelude, symbol XML) =====
// ===========================================================================

// A zeroed ast_node_t on the C stack (error-span carrier for internal loads).
func scratch_import_node(a &: at.Ast): int:
    id := at.NewNode(a, at.AST_IMPORT)
    mut n := at.Get(a, id)
    n.synthetic = true
    at.Put(a, id, n)
    ret id
end

func pkg_cache_get(s &: Sema, path: str): int:
    repeat s.pkg_cache_paths.len() with i:
        if str.Equals(s.pkg_cache_paths.get(i)[0], path):
            ret s.pkg_cache_syms.get(i)[0]
        end
    end
    ret 0
end

// load_package - source -> lexer -> parser -> condcomp prune -> order check
// -> sibling-file merge -> recursive sema; returns the package SymId (0 =
// the C NULL on failure). E008 covers both cycles and missing files.
func load_package(s &: Sema, a &: at.Ast, path: str, imp: int): int:
    cached := pkg_cache_get(s, path)
    if cached != 0:
        ret cached
    end
    repeat s.loading.len() with li:
        if str.Equals(s.loading.get(li)[0], path):
            serr(
                s, 8, span_of(a, imp), co.Format1(
                    i18.Tr("circular import detected: '%s'"), co.ArgStr(path)
                )
            )
            ret 0
        end
    end
    mut sf := src.New()
    if !src.Load(path, sf):
        serr(
            s, 8, span_of(a, imp), co.Format1(i18.Tr("import not found: '%s'"), co.ArgStr(path))
        )
        ret 0
    end
    mut s_log := s.log
    lg.AddDiagSource(s_log, path, sf.text, sf.len)
    s.log = s_log
    mut fb := lp.Load(i18.Lang())
    if fb == lp.LP_NONE:
        fb = lp.Load("en")
    end
    pack := lx.Detect(sf, fb)
    mut toks := tok.StreamNew(path)
    _lx_ok := lx.Run(s.log, pack, sf, toks)
    mut prog := 0
    _ps_ok := ps.Run(s.log, toks, a, prog)
    tok.StreamFree(toks)
    _cc_ok := cc.PruneProgram(a, s.log, path, s.cctab, prog)
    sema_check_toplevel_order_in_file(s, a, prog, path)

    files := package_files(path)
    defer files.free()
    mut fi := 1
    until fi < files.len():
        fpath := files.get(fi)[0]
        mut fsf := src.New()
        if src.Load(fpath, fsf):
            mut s_log2 := s.log
            lg.AddDiagSource(s_log2, fpath, fsf.text, fsf.len)
            s.log = s_log2
            mut ftoks := tok.StreamNew(fpath)
            _f1 := lx.Run(s.log, pack, fsf, ftoks)
            mut fprog := 0
            _f2 := ps.Run(s.log, ftoks, a, fprog)
            tok.StreamFree(ftoks)
            _f3 := cc.PruneProgram(a, s.log, fpath, s.cctab, fprog)
            sema_check_toplevel_order_in_file(s, a, fprog, fpath)
            merge_program(a, prog, fprog)
        end
        fi += 1
    end
    lg.Log(s.log, lg.PH_SEMANTIC, lg.LOG_DEBUG, "resolving package " + path)

    prog_name := at.Get(a, prog).name
    pkgscope := scope_new(s, SCOPE_GLOBAL, 0)
    mut pgv := scope_at(s, pkgscope)
    pgv.label = prog_name
    pgv.lang = lp.Code(pack)
    scope_put(s, pkgscope, pgv)
    save_global := s.global
    save_cur := s.cur
    save_dir := s.dir
    save_pkg := s.pkg
    save_lang := s.lang
    save_file := s.file
    save_prog := s.program
    save_pending := s.pending
    save_in_pkg := s.in_pkg
    s.in_pkg = true
    s.global = pkgscope
    s.cur = pkgscope
    s.dir = dir_of(path)
    s.pkg = str.Len(prog_name) > 0 ? prog_name : "main"
    s.lang = lp.Code(pack)
    s.file = path
    s.program = prog
    s.pending = Vector {} as Vector<int>
    s.loading.push(path)
    load_imports(s, a, prog)
    sema_collect(s, a, prog)
    sema_check_pass(s, a, prog)
    _lp0 := s.loading.pop()
    s.in_pkg = save_in_pkg
    s.global = save_global
    s.cur = save_cur
    s.dir = save_dir
    s.pkg = save_pkg
    s.lang = save_lang
    s.file = save_file
    s.program = save_prog
    s.pending.free()
    s.pending = save_pending
    pk := symbol_new(s, SYM_PACKAGE, prog_name)
    mut pkv := sym_at(s, pk)
    pkv.members = pkgscope
    pkv.pkgname = str.Len(prog_name) > 0 ? prog_name : "main"
    pkv.decl = prog
    sym_put(s, pk, pkv)
    s.pkg_cache_paths.push(path)
    s.pkg_cache_syms.push(pk)
    ret pk
end

// load_import_file - resolves one AST_IMPORT and binds the package under
// its local name, its canonical name and any same-language aliases.
func load_import_file(s &: Sema, a &: at.Ast, imp: int):
    n := at.Get(a, imp)
    mut spec := n.name
    if n.value_kind == tok.TV_STRING && str.Len(n.value_str) > 0:
        spec = n.value_str
    end
    if str.Len(spec) == 0:
        ret
    end
    sp := span_of(a, imp)
    path := resolve_import_node(a, s.dir, imp, s.lang)
    if str.Len(path) == 0:
        serr(
            s, 8, sp, co.Format1(
                i18.Tr("standard library package '%s' not found"), co.ArgStr(spec)
            )
        )
        ret
    end
    at.SetTypeStr(a, imp, path)
    pk := load_package(s, a, path, imp)
    if pk == 0:
        ret
    end
    pkv := sym_at(s, pk)
    local := norm_ident(import_local_name(a, imp, spec))
    bind := symbol_new(s, SYM_PACKAGE, local)
    mut bv := sym_at(s, bind)
    bv.members = pkv.members
    bv.pkgname = pkv.pkgname
    bv.decl = pkv.decl
    sym_put(s, bind, bv)
    if scope_lookup_local(s, s.cur, local) != 0:
        serr(
            s, 1, sp, co.Format1(i18.Tr("duplicate import name '%s'"), co.ArgStr(local))
        )
    else:
        _b1 := scope_define(s, s.cur, bind)
    end
    if str.Len(pkv.pkgname) > 0 && !str.Equals(pkv.pkgname, local) && scope_lookup_local(s, s.cur, pkv.pkgname) == 0:
        mut pkgname_ok := lang0(s.lang) == 0 || lang0(s.lang) == 101
        if !pkgname_ok && pkv.decl != 0:
            want := alias_for_lang(at.Get(a, pkv.decl).aliases, s.lang)
            pkgname_ok = str.Len(want) == 0 || str.Equals(want, pkv.pkgname)
        end
        if pkgname_ok:
            cb := symbol_new(s, SYM_PACKAGE, pkv.pkgname)
            mut cbv := sym_at(s, cb)
            cbv.members = pkv.members
            cbv.pkgname = pkv.pkgname
            cbv.decl = pkv.decl
            sym_put(s, cb, cbv)
            _b2 := scope_define(s, s.cur, cb)
        end
    end
    if pkv.decl != 0:
        al := at.Get(a, pkv.decl).aliases
        mut ai := 0
        until ai + 1 < al.len():
            if str.Equals(al.get(ai)[0], s.lang):
                alias := norm_ident(al.get(ai + 1)[0])
                if str.Len(alias) > 0 && !str.Equals(alias, local) && scope_lookup_local(s, s.cur, alias) == 0:
                    b2 := symbol_new(s, SYM_PACKAGE, alias)
                    mut b2v := sym_at(s, b2)
                    b2v.members = pkv.members
                    b2v.pkgname = pkv.pkgname
                    b2v.decl = pkv.decl
                    sym_put(s, b2, b2v)
                    _b3 := scope_define(s, s.cur, b2)
                end
            end
            ai += 2
        end
    end
end

func load_imports(s &: Sema, a &: at.Ast, program: int):
    pl := at.Get(a, program).list
    repeat pl.len() with i:
        did := pl.get(i)[0]
        if at.KindOf(a, did) == at.AST_IMPORT:
            load_import_file(s, a, did)
        end
    end
end

// sema_check_unused_imports - E082, only when the program has an entry.
func sema_check_unused_imports(s &: Sema, a &: at.Ast):
    entry := lp.EntryFor(s.lang)
    gsc := scope_at(s, s.global)
    mut has_entry := false
    repeat gsc.symbols.len() with i:
        f := sym_at(s, gsc.symbols.get(i)[0])
        if f.kind == SYM_FUNC && str.Len(f.name) > 0 && (str.Equals(f.name, "main") || str.Equals(f.name, entry)):
            has_entry = true
            break
        end
    end
    if !has_entry:
        ret
    end
    pl := at.Get(a, s.program).list
    repeat pl.len() with i2:
        iid := pl.get(i2)[0]
        imp := at.Get(a, iid)
        if imp.kind != at.AST_IMPORT:
            continue
        end
        spec := import_spec_of(imp)
        if str.Len(spec) == 0:
            continue
        end
        local := norm_ident(import_local_name(a, iid, spec))
        if str.Len(local) == 0 || byte_at(local, 0) == 95:
            continue
        end
        bind := scope_lookup_local(s, s.global, local)
        if bind == 0:
            continue
        end
        bv := sym_at(s, bind)
        if bv.kind != SYM_PACKAGE || bv.used:
            continue
        end
        serr(
            s, 82, span_of(a, iid), co.Format1(
                i18.Tr("unused import '%s' (use one of its members, or prefix the name with '_')"), co.ArgStr(local)
            )
        )
    end
end

// sema_load_prelude - loads the collections package once and remembers its
// member scope (replaces the 5a stub; sema.c).
func sema_load_prelude(s &: Sema, a &: at.Ast):
    if s.prelude != 0 || s.prelude_tried:
        ret
    end
    s.prelude_tried = true
    if str.Equals(s.pkg, "collections"):
        ret
    end
    path := resolve_import("", "collections")
    if str.Len(path) == 0:
        ret
    end
    imp := scratch_import_node(a)
    pk := load_package(s, a, path, imp)
    if pk != 0:
        s.prelude = sym_at(s, pk).members
    end
end

// ===== sema.c (symbol XML dump) =====

func sym_kind_name(k: int): str:
    if k == SYM_VAR:
        ret "var"
    end
    if k == SYM_CONST:
        ret "const"
    end
    if k == SYM_PARAM:
        ret "param"
    end
    if k == SYM_FIELD:
        ret "field"
    end
    if k == SYM_FUNC:
        ret "function"
    end
    if k == SYM_METHOD:
        ret "method"
    end
    if k == SYM_STRUCT:
        ret "struct"
    end
    if k == SYM_ENUM:
        ret "enum"
    end
    if k == SYM_ALIAS:
        ret "alias"
    end
    if k == SYM_ENUM_MEMBER:
        ret "enum_member"
    end
    if k == SYM_PACKAGE:
        ret "package"
    end
    if k == SYM_INTERFACE:
        ret "interface"
    end
    if k == SYM_TYPEIMPL:
        ret "typeimpl"
    end
    ret "?"
end

func emit_sig(w &: x.Writer, s &: Sema, sigid: int):
    sg := sig_at(s, sigid)
    x.Open(w, "overload")
    x.Attr(w, "mangled", sg.mangled)
    x.Attr(w, "returns", type_to_string(s, sg.ret_type))
    x.Open(w, "params")
    repeat sg.params.len() with i:
        x.Leaf(w, "param", type_to_string(s, sg.params.get(i)[0]))
    end
    x.Close(w)
    x.Close(w)
end

func emit_symbol(w &: x.Writer, s &: Sema, symid: int):
    sv := sym_at(s, symid)
    x.Open(w, "symbol")
    x.Attr(w, "kind", sym_kind_name(sv.kind))
    x.Attr(w, "name", sv.name)
    if sv.ty != TYPE_NONE && sv.kind != SYM_STRUCT && sv.kind != SYM_ENUM && sv.kind != SYM_FUNC && sv.kind != SYM_METHOD:
        x.Attr(w, "type", type_to_string(s, sv.ty))
    end
    if sv.kind == SYM_VAR || sv.kind == SYM_CONST:
        x.Attr(w, "mut", sv.is_mut ? "true" : "false")
    end
    if sv.kind == SYM_ENUM_MEMBER:
        x.AttrInt(w, "value", sv.enum_value)
    end
    if sv.kind == SYM_FUNC || sv.kind == SYM_METHOD:
        repeat sv.overloads.len() with i:
            emit_sig(w, s, sv.overloads.get(i)[0])
        end
    end
    if sv.members != 0:
        x.Open(w, "members")
        msc := scope_at(s, sv.members)
        repeat msc.symbols.len() with i2:
            emit_symbol(w, s, msc.symbols.get(i2)[0])
        end
        x.Close(w)
    end
    x.Close(w)
end

// ===========================================================================
// FORMER "STUBS FOR LATER STAGES" SECTION - all bodies are real now:
// 5c filled sema_check_expr / stamp_empty_intrinsic / generic_template /
// g_instantiate_struct; 5d filled sema_check_match, sema_check_block,
// sema_check_var_decl, sema_check_layout, sema_stmt_terminates and
// check_unused_params (plus the dce hooks further down).
// ===========================================================================

// sema_check_expr (sema_expr.c, 5c) - full expression type checking.
// Returns the expression's TypeId (never TYPE_NONE except through the
// still-stubbed match checker).
func sema_check_expr(s &: Sema, a &: at.Ast, nid: int): int:
    if nid == 0:
        ret sema_ty(s, TY_VOID)
    end
    k := at.KindOf(a, nid)
    if k != at.AST_LITERAL && k != at.AST_STRUCT_LIT && k != at.AST_ARRAY_LIT && k != at.AST_CALL && k != at.AST_TERNARY && k != at.AST_MATCH:
        s.expected = TYPE_NONE
    end
    sp := span_of(a, nid)
    if k == at.AST_LITERAL:
        n := at.Get(a, nid)
        exp := s.expected
        s.expected = TYPE_NONE
        mut t := sema_err_ty(s)
        if n.op == tok.TK_INT:
            u := n.value_int
            if exp >= 0 && type_is_integer(s, exp) && int_lit_fits(u, ty_at(s, exp).kind):
                t = exp
            else u <= 2147483647 as u64:
                t = sema_ty(s, TY_I32)
            else u <= 9223372036854775807 as u64:
                t = sema_ty(s, TY_I64)
            else:
                t = sema_ty(s, TY_U64)
            end
        else n.op == tok.TK_FLOAT:
            t = exp >= 0 && type_is_float(s, exp) ? exp : sema_ty(s, TY_F64)
        else n.op == tok.TK_STRING || n.op == tok.TK_TRIPLE_STRING || n.op == tok.TK_RAW_STRING:
            t = sema_ty(s, TY_STR)
        else n.op == tok.TK_CHAR:
            t = sema_ty(s, TY_CHAR)
        else n.op == tok.TK_UTF8_CHAR:
            t = sema_ty(s, TY_UCHAR)
        else n.op == tok.TK_KW_TRUE || n.op == tok.TK_KW_FALSE:
            t = sema_ty(s, TY_BOOL)
        else n.op == tok.TK_KW_NULL:
            t = sema_ty(s, TY_NULL)
        end
        ret sema_decorate(s, a, nid, t)
    end
    if k == at.AST_IDENTIFIER:
        mut name := at.Get(a, nid).name
        mut sym := scope_lookup(s, s.cur, name)
        if sym == 0:
            c := local_canon(s, a, name, sp)
            if !str.Equals(c, name):
                name = c
                at.SetName(a, nid, c)
                sym = scope_lookup(s, s.cur, name)
            end
        end
        if sym == 0:
            mut is_str_lit := false
            if builtin_global_const(a, nid, name, is_str_lit):
                ret sema_decorate(
                    s, a, nid, is_str_lit ? sema_ty(s, TY_STR) : sema_ty(s, TY_I32)
                )
            end
        end
        if sym == 0:
            serr(
                s, 1, sp, co.Format1(i18.Tr("unknown identifier '%s'"), co.ArgStr(name))
            )
            ret sema_decorate(s, a, nid, sema_err_ty(s))
        end
        sv := sym_at(s, sym)
        if sv.kind == SYM_FUNC || sv.kind == SYM_METHOD:
            serr(
                s, 1, sp, co.Format1(
                    i18.Tr("function '%s' used as a value"), co.ArgStr(name)
                )
            )
            ret sema_decorate(s, a, nid, sema_err_ty(s))
        end
        if sv.kind == SYM_STRUCT || sv.kind == SYM_ENUM:
            serr(
                s, 1, sp, co.Format1(
                    i18.Tr("type '%s' used as a value"), co.ArgStr(name)
                )
            )
            ret sema_decorate(s, a, nid, sema_err_ty(s))
        end
        mut svm := sym_at(s, sym)
        svm.used = true
        sym_put(s, sym, svm)
        if s.lam.len() > 0 && (svm.kind == SYM_VAR || svm.kind == SYM_PARAM):
            top := s.lam.get(s.lam.len() - 1)[0]
            if !defined_within(s, s.cur, top.boundary, name) && scope_lookup_local(s, s.global, name) == 0:
                record_capture(s, a, nid, svm.ty)
            end
        end
        if svm.kind == SYM_PARAM && svm.is_ref:
            mut nv := at.Get(a, nid)
            nv.is_ref = true
            at.Put(a, nid, nv)
        end
        ret sema_decorate(s, a, nid, svm.ty)
    end
    if k == at.AST_FUNC_ADDR:
        mut fname := at.Get(a, nid).name
        mut fsym := scope_lookup(s, s.cur, fname)
        if fsym == 0:
            c2 := local_canon(s, a, fname, sp)
            if !str.Equals(c2, fname):
                fname = c2
                at.SetName(a, nid, c2)
                fsym = scope_lookup(s, s.cur, fname)
            end
        end
        if fsym == 0:
            serr(
                s, 1, sp, co.Format1(
                    i18.Tr("unknown identifier '%s'"), co.ArgStr(fname)
                )
            )
            ret sema_decorate(s, a, nid, sema_err_ty(s))
        end
        fsv := sym_at(s, fsym)
        if fsv.kind == SYM_METHOD:
            serr(
                s, 72, sp, co.Format1(
                    i18.Tr("'%s' is a method, not a free function; '&' cannot address it"), co.ArgStr(fname)
                )
            )
            ret sema_decorate(s, a, nid, sema_err_ty(s))
        end
        if fsv.kind != SYM_FUNC:
            serr(
                s, 72, sp, co.Format2(
                    i18.Tr("'&%s' requires a function, '%s' is not one"), co.ArgStr(fname), co.ArgStr(fname)
                )
            )
            ret sema_decorate(s, a, nid, sema_err_ty(s))
        end
        mut only_generic := false
        if fsv.overloads.len() == 1:
            sg0 := sig_at(s, fsv.overloads.get(0)[0])
            if sg0.decl != 0 && at.TyparamCount(a, sg0.decl) > 0:
                only_generic = true
            end
        end
        if fsv.overloads.len() == 0 || only_generic:
            serr(
                s, 73, sp, co.Format1(
                    i18.Tr("cannot take the address of generic function '%s'"), co.ArgStr(fname)
                )
            )
            ret sema_decorate(s, a, nid, sema_err_ty(s))
        end
        if fsv.overloads.len() > 1:
            serr(
                s, 74, sp, co.Format2(
                    i18.Tr("function '%s' is ambiguous for '&' (%zu overloads exist)"), co.ArgStr(fname),
                    co.ArgUint(fsv.overloads.len() as u64)
                )
            )
            ret sema_decorate(s, a, nid, sema_err_ty(s))
        end
        mut fsm := sym_at(s, fsym)
        fsm.used = true
        sym_put(s, fsym, fsm)
        dce_mark_root(s.pkg, fsm.name)
        ret sema_decorate(s, a, nid, type_ptr(s, sema_ty(s, TY_VOID)))
    end
    if k == at.AST_THIS:
        if s.self_type < 0:
            serr(s, 14, sp, i18.Tr("'this' used outside a method"))
            ret sema_decorate(s, a, nid, sema_err_ty(s))
        end
        ret sema_decorate(s, a, nid, s.self_type)
    end
    if k == at.AST_BINARY:
        bt := check_binary(s, a, nid)
        sema_fold_expr(s, a, nid)
        ret bt
    end
    if k == at.AST_TERNARY:
        ret check_ternary(s, a, nid)
    end
    if k == at.AST_MATCH:
        ret sema_check_match(s, a, nid, true, s.expected)
    end
    if k == at.AST_UNARY:
        n2 := at.Get(a, nid)
        o := sema_check_expr(s, a, n2.a)
        ssym := struct_sym_of(s, o)
        if ssym != 0:
            mut mname := ""
            if n2.op == tok.TK_MINUS:
                mname = "operator_sub"
            else n2.op == tok.TK_NOT:
                mname = "operator_not"
            end
            if str.Len(mname) > 0:
                ovl := sema_try_op_overload(s, a, nid, ssym, mname, TYPE_NONE)
                if ovl != TYPE_NONE:
                    ret sema_decorate(s, a, nid, ovl)
                end
            end
        end
        if n2.op == tok.TK_NOT:
            if ty_at(s, o).kind != TY_BOOL && !type_is_error(s, o):
                serr(s, 21, sp, i18.Tr("operator '!' requires a bool operand"))
            end
            bt2 := sema_decorate(s, a, nid, sema_ty(s, TY_BOOL))
            sema_fold_expr(s, a, nid)
            ret bt2
        end
        if n2.op == tok.TK_TILDE:
            if !type_is_integer(s, o) && !type_is_error(s, o):
                serr(
                    s, 21, sp, i18.Tr("operator '~' requires an integer operand")
                )
            end
            ut := sema_decorate(s, a, nid, o)
            sema_fold_expr(s, a, nid)
            ret ut
        end
        if !type_is_numeric(s, o) && !type_is_error(s, o):
            serr(s, 21, sp, i18.Tr("unary '-' requires a numeric operand"))
        end
        ut2 := sema_decorate(s, a, nid, o)
        sema_fold_expr(s, a, nid)
        ret ut2
    end
    if k == at.AST_INCDEC:
        n3 := at.Get(a, nid)
        o2 := sema_check_expr(s, a, n3.a)
        opname := n3.op == tok.TK_PLUS_PLUS ? "'++'" : "'--'"
        mut wroot := 0
        verdict := sema_classify_write(s, a, n3.a, wroot)
        if verdict == LV_NOT_LVALUE:
            serr(
                s, 13, sp, co.Format1(
                    i18.Tr("operator %s requires an assignable operand"), co.ArgStr(opname)
                )
            )
        else verdict == LV_CONST:
            serr(
                s, 13, sp, co.Format2(
                    i18.Tr("cannot apply %s to '%s': a 'const' binding is fully immutable"), co.ArgStr(opname),
                    co.ArgStr(wroot != 0 ? sym_at(s, wroot).name : "target")
                )
            )
        else verdict == LV_IMMUTABLE:
            serr(
                s, 13, sp, co.Format2(
                    i18.Tr("cannot apply %s to immutable variable '%s'; declare it 'mut'"), co.ArgStr(opname),
                    co.ArgStr(wroot != 0 ? sym_at(s, wroot).name : "target")
                )
            )
        else:
            sema_check_pure_write(s, a, n3.a, sp)
        end
        if !type_is_numeric(s, o2) && !type_is_error(s, o2):
            serr(
                s, 21, sp, co.Format1(
                    i18.Tr("operator %s requires a numeric operand"), co.ArgStr(opname)
                )
            )
        end
        ret sema_decorate(s, a, nid, o2)
    end
    if k == at.AST_CAST:
        n4 := at.Get(a, nid)
        mut target := TYPE_NONE
        if n4.ty != 0:
            target = sema_resolve_type(s, a, n4.ty)
        end
        if target >= 0 && n4.a != 0:
            ak := at.KindOf(a, n4.a)
            if ak == at.AST_ARRAY_LIT || ak == at.AST_STRUCT_LIT || ak == at.AST_LITERAL || ak == at.AST_CALL:
                s.expected = target
            end
        end
        o3 := sema_check_expr(s, a, n4.a)
        s.expected = TYPE_NONE
        if target < 0:
            ret sema_decorate(s, a, nid, o3)
        end
        if type_assignable(s, target, o3):
            ret sema_decorate(s, a, nid, target)
        end
        if !type_castable(s, target, o3):
            serr(
                s, 23, sp, co.Format2(
                    i18.Tr("cannot cast '%s' to '%s'"), co.ArgStr(type_to_string(s, o3)), co.ArgStr(type_to_string(s, target))
                )
            )
        end
        ret sema_decorate(s, a, nid, target)
    end
    if k == at.AST_CALL:
        ret check_call(s, a, nid)
    end
    if k == at.AST_MEMBER:
        ret check_member(s, a, nid)
    end
    if k == at.AST_INDEX:
        n5 := at.Get(a, nid)
        arr := sema_check_expr(s, a, n5.a)
        idx := sema_check_expr(s, a, n5.b)
        ssym2 := struct_sym_of(s, arr)
        if ssym2 != 0:
            ovl2 := sema_try_op_overload(
                s, a, nid, ssym2, "operator_index", idx
            )
            if ovl2 != TYPE_NONE:
                ret sema_decorate(s, a, nid, ovl2)
            end
        end
        if !type_is_error(s, idx) && !type_is_integer(s, idx):
            serr(
                s, 21, sp, co.Format1(
                    i18.Tr("array index must be an integer, got '%s'"), co.ArgStr(type_to_string(s, idx))
                )
            )
        end
        av := ty_at(s, arr)
        if av.kind == TY_ARRAY:
            ret sema_decorate(s, a, nid, av.elem)
        end
        if av.kind == TY_SLICE:
            ret sema_decorate(s, a, nid, av.elem)
        end
        if av.kind == TY_PTR:
            ret sema_decorate(s, a, nid, av.pointee)
        end
        if av.kind == TY_STR:
            ret sema_decorate(s, a, nid, sema_ty(s, TY_CHAR))
        end
        if !type_is_error(s, arr):
            serr(
                s, 21, sp, co.Format1(
                    i18.Tr("cannot index non-array type '%s'"), co.ArgStr(type_to_string(s, arr))
                )
            )
        end
        ret sema_decorate(s, a, nid, sema_err_ty(s))
    end
    if k == at.AST_SLICE:
        n6 := at.Get(a, nid)
        base := sema_check_expr(s, a, n6.a)
        if n6.b != 0:
            lo := sema_check_expr(s, a, n6.b)
            if !type_is_error(s, lo) && !type_is_integer(s, lo):
                serr(
                    s, 21, sp, co.Format1(
                        i18.Tr("slice bound must be an integer, got '%s'"), co.ArgStr(type_to_string(s, lo))
                    )
                )
            end
        end
        if n6.c != 0:
            hi := sema_check_expr(s, a, n6.c)
            if !type_is_error(s, hi) && !type_is_integer(s, hi):
                serr(
                    s, 21, sp, co.Format1(
                        i18.Tr("slice bound must be an integer, got '%s'"), co.ArgStr(type_to_string(s, hi))
                    )
                )
            end
        end
        bk := ty_at(s, base).kind
        if bk == TY_ARRAY || bk == TY_SLICE:
            ret sema_decorate(s, a, nid, type_slice(s, ty_at(s, base).elem))
        end
        if !type_is_error(s, base):
            serr(
                s, 21, sp, co.Format1(
                    i18.Tr("cannot slice non-array type '%s'"), co.ArgStr(type_to_string(s, base))
                )
            )
        end
        ret sema_decorate(s, a, nid, sema_err_ty(s))
    end
    if k == at.AST_ARRAY_LIT:
        ret check_array_lit(s, a, nid)
    end
    if k == at.AST_STRUCT_LIT:
        ret check_struct_lit(s, a, nid)
    end
    if k == at.AST_LAMBDA:
        ret check_lambda(s, a, nid)
    end
    if k == at.AST_VARIANT_UNWRAP:
        n7 := at.Get(a, nid)
        mut mt := sema_err_ty(s)
        if n7.ty != 0:
            mt = sema_resolve_type(s, a, n7.ty)
        end
        _vu := sema_check_expr(s, a, n7.a)
        ret sema_decorate(s, a, nid, mt)
    end
    ret sema_decorate(s, a, nid, sema_err_ty(s))
end

// ===========================================================================
// ===== sema_match.c (5d) =====
// ===========================================================================

// sal_catf onto a 256-byte buffer (the exhaustiveness message builders):
// appends min(len, room-1) bytes and returns off + that, exactly like the C.
func sm_catf256(buf &: str, off: int, piece: str): int:
    if off >= 256:
        ret off
    end
    n := str.Len(piece)
    room := 256 - off
    mut wrote := n
    if wrote >= room:
        wrote = room - 1
    end
    buf = buf + str.Substr(piece, 0, wrote)
    ret off + wrote
end

// rewrite_tail_expr - bare tail expression of a block arm -> synthetic ret.
// (The C `s` param only supplied the arena; dropped here.)
func rewrite_tail_expr(a &: at.Ast, block: int):
    if block == 0 || at.ChildCount(a, block) == 0:
        ret
    end
    lasti := at.ChildCount(a, block) - 1
    last := at.Child(a, block, lasti)
    if at.KindOf(a, last) != at.AST_EXPR_STMT:
        ret
    end
    rid := new_node_at(a, at.AST_RETURN, span_of(a, last))
    mut rv := at.Get(a, rid)
    rv.synthetic = true
    rv.a = at.Get(a, last).a
    at.Put(a, rid, rv)
    mut bv := at.Get(a, block)
    bv.list.set(lasti, rid)
    at.Put(a, block, bv)
end

// types_comparable
func types_comparable(s &: Sema, ta: int, tb: int): bool:
    if type_is_error(s, ta) || type_is_error(s, tb):
        ret true
    end
    if type_equiv(s, ta, tb):
        ret true
    end
    ret type_is_numeric(s, ta) && type_is_numeric(s, tb) && type_common_arith(s, ta, tb) >= 0
end

// check_match_pattern - resolved Variant member tag (>= 0) or -1 (value
// pattern / error). The C pt_out param was always NULL and is dropped.
func check_match_pattern(
    s &: Sema, a &: at.Ast, pat: int, subj: int, subj_is_variant: bool, subj_is_enum: bool
): int:
    pv := at.Get(a, pat)
    psp := span_of(a, pat)
    if subj_is_variant:
        if at.KindOf(a, pv.a) != at.AST_IDENTIFIER:
            serr(
                s, 76, psp, i18.Tr("expected a type-name pattern to match a Variant subject")
            )
            ret 0 - 1
        end
        pt := sema_resolve_type(s, a, pv.a)
        if type_is_error(s, pt):
            ret 0 - 1
        end
        tag := type_variant_tag(s, subj, pt)
        if tag < 0:
            serr(
                s, 75, psp, co.Format2(
                    i18.Tr("match arm pattern type '%s' is not a member of '%s'"), co.ArgStr(type_to_string(s, pt)),
                    co.ArgStr(type_to_string(s, subj))
                )
            )
        end
        at.SetTypeStr(a, pat, type_to_string(s, pt))
        mut pv2 := at.Get(a, pat)
        pv2.value_kind = tok.TV_INT
        pv2.value_int = (tag < 0 ? 0 : tag) as u64
        at.Put(a, pat, pv2)
        ret tag
    end

    if str.Len(pv.name) > 0:
        serr(
            s, 77, psp, co.Format1(
                i18.Tr("value pattern used on a non-Variant match subject of type '%s'; a type-name pattern (with an optional binding) is only valid when matching a Variant"),
                co.ArgStr(type_to_string(s, subj))
            )
        )
    end

    ak := at.KindOf(a, pv.a)
    if ak == at.AST_LITERAL:
        s.expected = subj
        pt2 := sema_check_expr(s, a, pv.a)
        s.expected = TYPE_NONE
        if !types_comparable(s, subj, pt2):
            serr(
                s, 21, psp, co.Format2(
                    i18.Tr("cannot compare '%s' and '%s'"), co.ArgStr(type_to_string(s, subj)), co.ArgStr(type_to_string(s, pt2))
                )
            )
        end
    else ak == at.AST_IDENTIFIER:
        if subj_is_enum:
            syd := ty_at(s, subj).decl
            pname := at.Get(a, pv.a).name
            mut m := 0
            if syd != 0 && sym_at(s, syd).members != 0:
                m = scope_lookup_local(s, sym_at(s, syd).members, pname)
            end
            if m == 0:
                serr(
                    s, 16, span_of(a, pv.a), co.Format2(
                        i18.Tr("enum '%s' has no member '%s'"), co.ArgStr(syd != 0 ? sym_at(s, syd).name : "?"),
                        co.ArgStr(pname)
                    )
                )
            else:
                mem := new_node_at(a, at.AST_MEMBER, span_of(a, pv.a))
                idn := new_node_at(a, at.AST_IDENTIFIER, span_of(a, pv.a))
                mut iv := at.Get(a, idn)
                iv.synthetic = true
                iv.name = sym_at(s, syd).name
                at.Put(a, idn, iv)
                mut mv := at.Get(a, mem)
                mv.synthetic = true
                mv.a = idn
                mv.name = pname
                at.Put(a, mem, mv)
                mut pv3 := at.Get(a, pat)
                pv3.a = mem
                at.Put(a, pat, pv3)
                _mt := sema_check_expr(s, a, mem)
            end
        else:
            pt3 := sema_check_expr(s, a, pv.a)
            if !types_comparable(s, subj, pt3):
                serr(
                    s, 21, psp, co.Format2(
                        i18.Tr("cannot compare '%s' and '%s'"), co.ArgStr(type_to_string(s, subj)), co.ArgStr(type_to_string(s, pt3))
                    )
                )
            end
        end
    end
    ret 0 - 1
end

// sema_check_match. The C's per-arm heap vec of match_yield_t and the
// arm_yields vec-of-vecs become flat parallel vectors (yr_rets/yr_tys) with
// per-arm [offset,count) windows - same data, no nested Vector generics.
func sema_check_match(
    s &: Sema, a &: at.Ast, nid: int, is_expr: bool, expected: int
): int:
    exp := expected
    s.expected = TYPE_NONE
    subj := sema_check_expr(s, a, at.Get(a, nid).a)
    mut nv0 := at.Get(a, nid)
    nv0.match_is_expr = is_expr
    at.Put(a, nid, nv0)

    subj_is_variant := subj >= 0 && ty_at(s, subj).kind == TY_VARIANT
    subj_is_enum := subj >= 0 && ty_at(s, subj).kind == TY_ENUM
    mut has_wildcard := false

    mut arm_types := Vector {} as Vector<int>
    defer arm_types.free()
    mut arm_yoff := Vector {} as Vector<int> // -1 = C NULL collect
    defer arm_yoff.free()
    mut arm_ycnt := Vector {} as Vector<int>
    defer arm_ycnt.free()
    mut yr_rets := Vector {} as Vector<int>
    defer yr_rets.free()
    mut yr_tys := Vector {} as Vector<int>
    defer yr_tys.free()
    mut seen_members := Vector {} as Vector<int> // SymIds
    defer seen_members.free()
    mut seen_tags := Vector {} as Vector<int>
    defer seen_tags.free()

    mut ai := 0
    until ai < at.ChildCount(a, nid):
        arm := at.Child(a, nid, ai)
        ai += 1
        mut arm_ty := TYPE_NONE
        mut coll_off := 0 - 1
        mut coll_cnt := 0

        if at.Get(a, arm).op == tok.TK_KW_ELSE:
            has_wildcard = true
        else:
            mut pi := 0
            until pi < at.ChildCount(a, arm):
                pat := at.Child(a, arm, pi)
                pi += 1
                tag := check_match_pattern(
                    s, a, pat, subj, subj_is_variant, subj_is_enum
                )
                if subj_is_variant:
                    if tag >= 0:
                        mut dup := false
                        repeat seen_tags.len() with k:
                            if seen_tags.get(k)[0] == tag:
                                dup = true
                                break
                            end
                        end
                        if dup:
                            serr(
                                s, 78, span_of(a, pat), i18.Tr("duplicate match arm pattern")
                            )
                        else:
                            seen_tags.push(tag)
                        end
                        if !dup && str.Len(at.Get(a, pat).name) > 0 && at.ChildCount(a, arm) == 1:
                            psp2 := span_of(a, pat)
                            decl := new_node_at(a, at.AST_VAR_DECL, psp2)
                            unwrap := new_node_at(
                                a, at.AST_VARIANT_UNWRAP, psp2
                            )
                            mut uv := at.Get(a, unwrap)
                            uv.synthetic = true
                            uv.a = at.Clone(a, at.Get(a, nid).a)
                            uv.ty = at.Get(a, pat).a
                            at.Put(a, unwrap, uv)
                            mut dv := at.Get(a, decl)
                            dv.synthetic = true
                            dv.name = at.Get(a, pat).name
                            dv.a = unwrap
                            at.Put(a, decl, dv)
                            armb := at.Get(a, arm).b
                            mut bv := at.Get(a, armb)
                            mut newlist := Vector {} as Vector<int>
                            newlist.push(decl)
                            repeat bv.list.len() with k2:
                                newlist.push(bv.list.get(k2)[0])
                            end
                            mut old := bv.list
                            bv.list = newlist
                            at.Put(a, armb, bv)
                            old.free()
                        end
                    end
                else subj_is_enum && at.KindOf(a, at.Get(a, pat).a) == at.AST_MEMBER:
                    syd2 := ty_at(s, subj).decl
                    pname2 := at.Get(a, at.Get(a, pat).a).name
                    mut m2 := 0
                    if syd2 != 0 && sym_at(s, syd2).members != 0:
                        m2 = scope_lookup_local(
                            s, sym_at(s, syd2).members, pname2
                        )
                    end
                    if m2 != 0:
                        mut dup2 := false
                        repeat seen_members.len() with k3:
                            if seen_members.get(k3)[0] == m2:
                                dup2 = true
                                break
                            end
                        end
                        if dup2:
                            serr(
                                s, 78, span_of(a, pat), co.Format1(
                                    i18.Tr("duplicate match arm pattern '%s'"), co.ArgStr(pname2)
                                )
                            )
                        else:
                            seen_members.push(m2)
                        end
                    end
                end
            end
            if at.ChildCount(a, arm) > 1:
                repeat at.ChildCount(a, arm) with pi2:
                    pat2 := at.Child(a, arm, pi2)
                    if str.Len(at.Get(a, pat2).name) > 0:
                        serr(
                            s, 76, span_of(a, pat2), i18.Tr("a match arm with multiple patterns cannot bind a name; use a single-pattern arm to bind, e.g. 'i32 n =>'")
                        )
                    end
                end
            end
        end

        if is_expr:
            rewrite_tail_expr(a, at.Get(a, arm).b)
        end

        if is_expr:
            saved_depth := s.match_arm_depth
            saved_yexp := s.match_yield_expected
            saved_vec := s.match_yield_collect
            saved_act := s.match_yield_active
            s.match_yield_collect = Vector {} as Vector<MatchYield>
            s.match_arm_depth = saved_depth + 1
            s.match_yield_expected = exp
            s.match_yield_active = true
            sema_check_block(s, a, at.Get(a, arm).b)
            mut collected := s.match_yield_collect
            s.match_arm_depth = saved_depth
            s.match_yield_expected = saved_yexp
            s.match_yield_collect = saved_vec
            s.match_yield_active = saved_act

            if collected.len() == 0:
                serr(
                    s, 81, span_of(a, arm), i18.Tr("'match' used as an expression must have arms that all produce a value")
                )
                arm_ty = sema_err_ty(s)
            else:
                mut t0 := collected.get(0)[0].ty
                mut ok := true
                mut yi := 1
                until yi < collected.len():
                    yt := collected.get(yi)[0].ty
                    yi += 1
                    if type_equiv(s, t0, yt):
                        continue
                    end
                    if type_is_numeric(s, t0) && type_is_numeric(s, yt):
                        c := type_common_arith(s, t0, yt)
                        if c >= 0:
                            t0 = c
                            continue
                        end
                    end
                    ok = false
                end
                if !ok:
                    serr(
                        s, 81, span_of(a, arm), i18.Tr("match arm produces different types on different code paths")
                    )
                    arm_ty = sema_err_ty(s)
                else:
                    arm_ty = t0
                end
            end
            coll_off = yr_rets.len()
            coll_cnt = collected.len()
            repeat collected.len() with ci:
                y := collected.get(ci)[0]
                yr_rets.push(y.ret_node)
                yr_tys.push(y.ty)
            end
            collected.free()
        else:
            sema_check_block(s, a, at.Get(a, arm).b)
        end

        arm_types.push(arm_ty)
        arm_yoff.push(coll_off)
        arm_ycnt.push(coll_cnt)
    end

    if !has_wildcard && subj_is_enum && ty_at(s, subj).decl != 0:
        syid := ty_at(s, subj).decl
        sy := sym_at(s, syid)
        mut total := 0
        if sy.members != 0:
            msc5 := scope_at(s, sy.members)
            total = msc5.symbols.len()
        end
        if seen_members.len() < total:
            msyms := scope_at(s, sy.members).symbols
            mut buf := ""
            mut o := 0
            mut mi := 0
            until mi < msyms.len() && o < 224:
                mid := msyms.get(mi)[0]
                mut covered := false
                repeat seen_members.len() with k4:
                    if seen_members.get(k4)[0] == mid:
                        covered = true
                        break
                    end
                end
                if !covered:
                    o = sm_catf256(
                        buf, o, (o > 0 ? ", " : "") + sym_at(s, mid).name
                    )
                end
                mi += 1
            end
            if mi < msyms.len():
                o = sm_catf256(buf, o, ", ...")
            end
            swarn(
                s, 80, span_of(a, nid), co.Format3(
                    i18.Tr("non-exhaustive match on enum '%s': missing member%s %s"), co.ArgStr(sy.name),
                    co.ArgStr(plural_suffix(total - seen_members.len())), co.ArgStr(buf)
                )
            )
        end
    end
    if !has_wildcard && subj_is_variant:
        vparams := ty_at(s, subj).params
        total2 := vparams.len()
        if seen_tags.len() < total2:
            mut buf2 := ""
            mut o2 := 0
            mut ti := 0
            until ti < total2 && o2 < 224:
                mut covered2 := false
                repeat seen_tags.len() with k5:
                    if seen_tags.get(k5)[0] == ti:
                        covered2 = true
                        break
                    end
                end
                if !covered2:
                    o2 = sm_catf256(
                        buf2, o2, (o2 > 0 ? ", " : "") + type_to_string(s, vparams.get(ti)[0])
                    )
                end
                ti += 1
            end
            if ti < total2:
                o2 = sm_catf256(buf2, o2, ", ...")
            end
            serr(
                s, 79, span_of(a, nid), co.Format3(
                    i18.Tr("non-exhaustive match on Variant '%s': missing case%s for %s"), co.ArgStr(type_to_string(s, subj)),
                    co.ArgStr(plural_suffix(total2 - seen_tags.len())), co.ArgStr(buf2)
                )
            )
        end
    end

    if !is_expr:
        ret sema_decorate(s, a, nid, sema_ty(s, TY_VOID))
    end

    mut first := TYPE_NONE
    mut all_equiv := true
    mut unified := TYPE_NONE
    repeat arm_types.len() with k6:
        t := arm_types.get(k6)[0]
        if t < 0 || type_is_error(s, t):
            continue
        end
        if first < 0:
            first = t
            continue
        end
        if !type_equiv(s, first, t):
            all_equiv = false
        end
    end

    if first < 0:
        unified = sema_err_ty(s)
    else all_equiv:
        unified = first
    else:
        mut acc := TYPE_NONE
        mut numeric_ok := true
        repeat arm_types.len() with k7:
            t2 := arm_types.get(k7)[0]
            if t2 < 0 || type_is_error(s, t2):
                continue
            end
            if acc < 0:
                acc = t2
                continue
            end
            c2 := type_common_arith(s, acc, t2)
            if c2 < 0:
                numeric_ok = false
                break
            end
            acc = c2
        end
        if numeric_ok && acc >= 0:
            unified = acc
        else:
            mut vmem := Vector {} as Vector<int>
            repeat arm_types.len() with k8:
                t3 := arm_types.get(k8)[0]
                if t3 < 0 || type_is_error(s, t3):
                    continue
                end
                mut dup3 := false
                repeat vmem.len() with j8:
                    if type_equiv(s, vmem.get(j8)[0], t3):
                        dup3 = true
                        break
                    end
                end
                if dup3:
                    continue
                end
                if vmem.len() >= 64:
                    serr(
                        s, 1, span_of(a, nid), i18.Tr("match expression has too many distinct arm types (max 64)")
                    )
                    break
                end
                vmem.push(t3)
            end
            unified = type_variant_new(s, vmem)
            vmem.free()
        end
    end

    if ty_at(s, unified).kind == TY_VARIANT:
        repeat arm_types.len() with k9:
            att := arm_types.get(k9)[0]
            yoff := arm_yoff.get(k9)[0]
            if att < 0 || type_is_error(s, att) || yoff < 0:
                continue
            end
            tag2 := type_variant_tag(s, unified, att)
            if tag2 < 0:
                continue
            end
            repeat arm_ycnt.get(k9)[0] with yi2:
                rid2 := yr_rets.get(yoff + yi2)[0]
                na := coerce_to_variant(s, a, unified, at.Get(a, rid2).a, tag2)
                mut rv2 := at.Get(a, rid2)
                rv2.a = na
                at.Put(a, rid2, rv2)
            end
        end
    end

    at.SetTypeStr(a, nid, type_to_string(s, unified))
    ret sema_decorate(s, a, nid, unified)
end

// ===========================================================================
// ===== sema_stmt.c (5d) - statements/blocks/each lowering =====
// (The lvalue slice - analyze_lvalue/sema_classify_write/sema_check_pure_write
// - was ported in 5c further down; do not re-port.)
// ===========================================================================

// define_local
func define_local(s &: Sema, a &: at.Ast, did: int, kind: int, t: int):
    d := at.Get(a, did)
    symid := symbol_new(s, kind, d.name)
    mut sv := sym_at(s, symid)
    sv.ty = t
    sv.is_mut = d.is_mut
    sv.decl = did
    sym_put(s, symid, sv)
    if scope_define(s, s.cur, symid) != 0:
        serr(
            s, 1, span_of(a, did), co.Format1(i18.Tr("redefinition of '%s'"), co.ArgStr(d.name))
        )
    end
end

// ea_node .. ea_binary - synthetic-node builders for the `each` lowering.
func ea_node(a &: at.Ast, kind: int, sp: co.SrcSpan): int:
    id := new_node_at(a, kind, sp)
    mut nv := at.Get(a, id)
    nv.synthetic = true
    at.Put(a, id, nv)
    ret id
end

func ea_ident(a &: at.Ast, name: str, sp: co.SrcSpan): int:
    id := ea_node(a, at.AST_IDENTIFIER, sp)
    at.SetName(a, id, name)
    ret id
end

func ea_int(a &: at.Ast, v: u64, sp: co.SrcSpan): int:
    id := ea_node(a, at.AST_LITERAL, sp)
    mut nv := at.Get(a, id)
    nv.op = tok.TK_INT
    nv.value_kind = tok.TV_INT
    nv.value_int = v
    at.Put(a, id, nv)
    ret id
end

func ea_decl(
    a &: at.Ast, name: str, init: int, is_mut: bool, sp: co.SrcSpan
): int:
    id := ea_node(a, at.AST_VAR_DECL, sp)
    mut nv := at.Get(a, id)
    nv.name = name
    nv.a = init
    nv.is_mut = is_mut
    at.Put(a, id, nv)
    ret id
end

func ea_mcall(
    a &: at.Ast, recv: str, method: str, arg: int, sp: co.SrcSpan
): int:
    mem := ea_node(a, at.AST_MEMBER, sp)
    mut mv := at.Get(a, mem)
    mv.a = ea_ident(a, recv, sp)
    mv.name = method
    at.Put(a, mem, mv)
    call := ea_node(a, at.AST_CALL, sp)
    mut cv := at.Get(a, call)
    cv.a = mem
    at.Put(a, call, cv)
    if arg != 0:
        at.AddChild(a, call, arg)
    end
    ret call
end

func ea_index(a &: at.Ast, base: int, idx: int, sp: co.SrcSpan): int:
    id := ea_node(a, at.AST_INDEX, sp)
    mut nv := at.Get(a, id)
    nv.a = base
    nv.b = idx
    at.Put(a, id, nv)
    ret id
end

func ea_binary(a &: at.Ast, op: int, l: int, r: int, sp: co.SrcSpan): int:
    id := ea_node(a, at.AST_BINARY, sp)
    mut nv := at.Get(a, id)
    nv.op = op
    nv.a = l
    nv.b = r
    at.Put(a, id, nv)
    ret id
end

// each_finish - the AST_EACH node is rewritten in place into a synthetic
// AST_BLOCK holding [seq_decl?, for] and re-checked as a block.
func each_finish(s &: Sema, a &: at.Ast, nid: int, seq_decl: int, fr: int):
    mut nv := at.Get(a, nid)
    nv.kind = at.AST_BLOCK
    nv.name = ""
    nv.a = 0
    nv.b = 0
    nv.c = 0
    nv.d = 0
    nv.synthetic = true
    nv.list.clear()
    at.Put(a, nid, nv)
    if seq_decl != 0:
        at.AddChild(a, nid, seq_decl)
    end
    at.AddChild(a, nid, fr)
    sema_check_block(s, a, nid)
end

// check_each - types the iterable, then desugars into an AST_FOR.
func check_each(s &: Sema, a &: at.Ast, nid: int):
    sp := span_of(a, nid)
    n0 := at.Get(a, nid)
    it := sema_check_expr(s, a, n0.a)
    an := at.Get(a, n0.a)
    if an.kind == at.AST_ARRAY_LIT && an.list.len() == 0:
        serr(
            s, 68, span_of(a, n0.a), i18.Tr("'each' over an empty array literal: the loop body can never run")
        )
    end
    if type_is_error(s, it):
        ret
    end
    have_key := n0.c != 0
    mut keyname := ""
    if have_key:
        keyname = at.Get(a, n0.c).name
    end
    valname := n0.name
    body := n0.b
    s.each_n += 1
    id := s.each_n
    itv := ty_at(s, it)
    mut vec_like := itv.kind == TY_VEC
    mut map_like := itv.kind == TY_MAP

    if itv.kind == TY_STRUCT && itv.decl != 0:
        isym := sym_at(s, itv.decl)
        if str.Equals(isym.generic_base, "Vector"):
            vec_like = true
        end
        if str.Equals(isym.generic_base, "HashMap"):
            map_like = true
        end
    end

    if !vec_like && !map_like && itv.kind != TY_ARRAY && itv.kind != TY_SLICE:
        serr(
            s, 65, span_of(a, n0.a), co.Format1(
                i18.Tr("each cannot iterate a value of type '%s'"), co.ArgStr(type_to_string(s, it))
            )
        )
        ret
    end
    if map_like && !have_key:
        serr(
            s, 65, sp, i18.Tr("iterating a HashMap needs two bindings: each (key, value) in map")
        )
        ret
    end
    if (itv.kind == TY_ARRAY || itv.kind == TY_SLICE) && itv.elem >= 0 && ty_at(s, itv.elem).kind == TY_ARRAY:
        serr(
            s, 65, sp, i18.Tr("each over a multi-dimensional array is not supported; use repeat with an index")
        )
        ret
    end

    mut seq := ""
    mut seq_decl := 0
    if an.kind == at.AST_IDENTIFIER:
        seq = an.name
    else:
        seq = "__ea" + id
        seq_decl = ea_decl(a, seq, n0.a, false, sp)
    end

    if map_like:
        itn := "__ei" + id
        fr := ea_node(a, at.AST_FOR, sp)
        mut fv := at.Get(a, fr)
        fv.a = ea_decl(a, itn, ea_mcall(a, seq, "iter", 0, sp), true, sp)
        fv.b = ea_mcall(a, itn, "has_next", 0, sp)
        post := ea_node(a, at.AST_EXPR_STMT, sp)
        mut pv := at.Get(a, post)
        pv.a = ea_mcall(a, itn, "next", 0, sp)
        at.Put(a, post, pv)
        fv.c = post
        blk := ea_node(a, at.AST_BLOCK, sp)
        at.AddChild(
            a, blk, ea_decl(
                a, keyname, ea_mcall(a, itn, "key", 0, sp), false, have_key ? span_of(a, n0.c) : sp
            )
        )
        at.AddChild(
            a, blk, ea_decl(
                a, valname, ea_mcall(a, itn, "value", 0, sp), false, sp
            )
        )
        repeat at.ChildCount(a, body) with bi:
            at.AddChild(a, blk, at.Child(a, body, bi))
        end
        fv.d = blk
        at.Put(a, fr, fv)
        each_finish(s, a, nid, seq_decl, fr)
        ret
    end

    idx := "__ei" + id
    fr2 := ea_node(a, at.AST_FOR, sp)
    mut fv2 := at.Get(a, fr2)
    fv2.a = ea_decl(a, idx, ea_int(a, 0 as u64, sp), true, sp)
    mut lenx := 0
    if vec_like:
        lenx = ea_mcall(a, seq, "len", 0, sp)
    else:
        lenx = ea_node(a, at.AST_CALL, sp)
        mut lv := at.Get(a, lenx)
        lv.a = ea_ident(a, "len", sp)
        at.Put(a, lenx, lv)
        at.AddChild(a, lenx, ea_ident(a, seq, sp))
    end
    fv2.b = ea_binary(a, tok.TK_LT, ea_ident(a, idx, sp), lenx, sp)
    asn := ea_node(a, at.AST_ASSIGN, sp)
    mut av := at.Get(a, asn)
    av.op = tok.TK_ASSIGN
    av.a = ea_ident(a, idx, sp)
    av.b = ea_binary(
        a, tok.TK_PLUS, ea_ident(a, idx, sp), ea_int(a, 1 as u64, sp), sp
    )
    at.Put(a, asn, av)
    fv2.c = asn
    blk2 := ea_node(a, at.AST_BLOCK, sp)
    if have_key:
        at.AddChild(
            a, blk2, ea_decl(
                a, keyname, ea_ident(a, idx, sp), false, span_of(a, n0.c)
            )
        )
    end
    mut elem := 0
    if vec_like:
        elem = ea_index(
            a, ea_mcall(a, seq, "get", ea_ident(a, idx, sp), sp), ea_int(a, 0 as u64, sp), sp
        )
    else:
        elem = ea_index(a, ea_ident(a, seq, sp), ea_ident(a, idx, sp), sp)
    end
    at.AddChild(a, blk2, ea_decl(a, valname, elem, false, sp))
    repeat at.ChildCount(a, body) with bi2:
        at.AddChild(a, blk2, at.Child(a, body, bi2))
    end
    fv2.d = blk2
    at.Put(a, fr2, fv2)
    each_finish(s, a, nid, seq_decl, fr2)
end

// check_stmt - the C switch becomes an if/else chain; the C mid-case
// `break`s become `ret`s.
func check_stmt(s &: Sema, a &: at.Ast, nid: int):
    if nid == 0:
        ret
    end
    k := at.KindOf(a, nid)
    sp := span_of(a, nid)
    if k == at.AST_BLOCK:
        sema_check_block(s, a, nid)
        ret
    end
    if k == at.AST_MATCH:
        _mt := sema_check_match(s, a, nid, false, TYPE_NONE)
        ret
    end
    if k == at.AST_VAR_DECL:
        t := sema_check_var_decl(s, a, nid)
        define_local(s, a, nid, SYM_VAR, t)
        ret
    end
    if k == at.AST_CONST_DECL:
        t2 := sema_check_var_decl(s, a, nid)
        n := at.Get(a, nid) // re-read: var_decl may hoist an `as T` cast
        symid := symbol_new(s, SYM_CONST, n.name)
        mut sv := sym_at(s, symid)
        sv.ty = t2
        sv.is_mut = false
        sv.decl = nid
        if n.a != 0:
            av := at.Get(a, n.a)
            if av.kind == at.AST_LITERAL && av.value_kind == tok.TV_INT:
                sv.has_ival = true
                sv.ival = av.value_int as i64
            end
        end
        sym_put(s, symid, sv)
        if scope_define(s, s.cur, symid) != 0:
            serr(
                s, 1, sp, co.Format1(i18.Tr("redefinition of '%s'"), co.ArgStr(n.name))
            )
        end
        ret
    end
    if k == at.AST_ASSIGN:
        n2 := at.Get(a, nid)
        tt := sema_check_expr(s, a, n2.a)
        if tt >= 0 && n2.b != 0 && at.KindOf(a, n2.b) == at.AST_LITERAL:
            s.expected = tt
        end
        vt := sema_check_expr(s, a, n2.b)
        mut wroot := 0
        if n2.a != 0 && at.KindOf(a, n2.a) == at.AST_INDEX:
            ia := at.Get(a, n2.a).a
            if ia != 0 && str.Equals(at.Get(a, ia).type_str, "str"):
                serr(
                    s, 13, sp, i18.Tr("strings are immutable: cannot assign to an index of a 'str'")
                )
            end
        end
        verdict := sema_classify_write(s, a, n2.a, wroot)
        if verdict == LV_NOT_LVALUE:
            serr(s, 13, sp, i18.Tr("assignment target is not assignable"))
        else verdict == LV_CONST:
            serr(
                s, 13, sp, co.Format1(
                    i18.Tr("cannot assign to '%s': a 'const' binding is fully immutable, including its elements and fields"),
                    co.ArgStr(wroot != 0 ? sym_at(s, wroot).name : "target")
                )
            )
        else verdict == LV_IMMUTABLE:
            serr(
                s, 13, sp, co.Format1(
                    i18.Tr("cannot reassign immutable variable '%s'; declare it 'mut' to reassign it, or assign to its elements or fields instead"),
                    co.ArgStr(wroot != 0 ? sym_at(s, wroot).name : "target")
                )
            )
        else:
            sema_check_pure_write(s, a, n2.a, sp)
        end

        if n2.op == tok.TK_ASSIGN && n2.a != 0 && at.KindOf(a, n2.a) == at.AST_INDEX:
            ia2 := at.Get(a, n2.a).a
            mut bts := ""
            if ia2 != 0:
                bts = at.Get(a, ia2).type_str
            end
            if str.Len(bts) > 0:
                mut tmp := scope_lookup(s, s.cur, bts)
                if tmp == 0:
                    bl := str.Len(bts)
                    if bl > 1 && byte_at(bts, bl - 1) == 42:
                        tmp = scope_lookup(
                            s, s.cur, str.Substr(bts, 0, bl - 1)
                        )
                    end
                end
                if tmp != 0 && sym_at(s, tmp).kind == SYM_STRUCT:
                    m := scope_lookup_local(
                        s, sym_at(s, tmp).members, "operator_index_set"
                    )
                    if m != 0 && sym_at(s, m).kind == SYM_METHOD:
                        ret
                    end
                end
            end
        end

        if n2.op != tok.TK_ASSIGN && tt >= 0 && ty_at(s, tt).kind == TY_STRUCT:
            base_op := sema_compound_base(n2.op)
            mname := sema_op_method(base_op)
            if str.Len(mname) > 0:
                ssym := struct_sym_of(s, tt)
                if ssym != 0:
                    ovl := sema_try_op_overload(s, a, nid, ssym, mname, vt)
                    if ovl != TYPE_NONE:
                        ret
                    end
                end
            end
        end

        if n2.op == tok.TK_PLUS_EQ && tt >= 0 && ty_at(s, tt).kind == TY_STR && sema_type_is_stringable(s, vt):
            ret
        end

        mut op_valid := true
        if n2.op != tok.TK_ASSIGN && tt >= 0 && !type_is_error(s, tt) && !type_is_error(s, vt):
            base_op2 := sema_compound_base(n2.op)
            if base_op2 == tok.TK_POWER:
                pow_res := type_prim(s, TY_F64)
                if !type_is_numeric(s, tt) || !type_is_numeric(s, vt):
                    serr(
                        s, 21, sp, i18.Tr("operator '**' requires numeric operands")
                    )
                    op_valid = false
                else !type_assignable(s, tt, pow_res):
                    serr(
                        s, 2, sp, co.Format2(
                            i18.Tr("cannot assign '%s' to '%s'"), co.ArgStr(type_to_string(s, pow_res)),
                            co.ArgStr(type_to_string(s, tt))
                        )
                    )
                    op_valid = false
                end
            else base_op2 != tok.TK_EOF:
                mut c := TYPE_NONE
                if ty_at(s, tt).kind != TY_STRUCT:
                    c = type_common_arith(s, tt, vt)
                end
                if c < 0:
                    serr(
                        s, 21, sp, co.Format2(
                            i18.Tr("operator cannot be applied to '%s' and '%s'"), co.ArgStr(type_to_string(s, tt)),
                            co.ArgStr(type_to_string(s, vt))
                        )
                    )
                    op_valid = false
                else base_op2 == tok.TK_PERCENT && !type_is_integer(s, c):
                    serr(
                        s, 21, sp, co.Format0(
                            i18.Tr("operator '%%' requires integer operands")
                        )
                    )
                    op_valid = false
                else sema_tk_is_bitwise(base_op2) && (!type_is_integer(s, tt) || !type_is_integer(s, vt)):
                    serr(
                        s, 21, sp, i18.Tr("bitwise operator requires integer operands")
                    )
                    op_valid = false
                end
            end
        end
        if op_valid && !type_assignable(s, tt, vt):
            serr(
                s, 2, sp, co.Format2(
                    i18.Tr("cannot assign '%s' to '%s'"), co.ArgStr(type_to_string(s, vt)), co.ArgStr(type_to_string(s, tt))
                )
            )
        else op_valid && n2.op == tok.TK_ASSIGN && tt >= 0 && ty_at(s, tt).kind == TY_VARIANT && vt >= 0 && ty_at(s, vt).kind != TY_VARIANT:
            tag := type_variant_tag(s, tt, vt)
            if tag >= 0:
                nb := coerce_to_variant(s, a, tt, at.Get(a, nid).b, tag)
                mut nv := at.Get(a, nid)
                nv.b = nb
                at.Put(a, nid, nv)
            end
        end
        ret
    end
    if k == at.AST_IF:
        n3 := at.Get(a, nid)
        c3 := sema_check_expr(s, a, n3.a)
        csp := span_of(a, n3.a)
        if ty_at(s, c3).kind != TY_BOOL && !type_is_error(s, c3):
            serr(
                s, 21, csp, co.Format1(
                    i18.Tr("if condition must be bool, got '%s'"), co.ArgStr(type_to_string(s, c3))
                )
            )
        end
        mut cv3 := false
        if sema_const_bool(s, a, n3.a, cv3):
            if !cv3:
                serr(
                    s, 68, csp, i18.Tr("'if' condition is always false: its body can never run")
                )
            else n3.c != 0:
                serr(
                    s, 68, csp, i18.Tr("'if' condition is always true: the 'else' branch can never run")
                )
            else:
                serr(
                    s, 68, csp, i18.Tr("'if' condition is always true: remove the redundant 'if'")
                )
            end
        end
        if n3.b != 0 && at.KindOf(a, n3.b) == at.AST_BLOCK && at.ChildCount(a, n3.b) == 0:
            serr(
                s, 60, span_of(a, n3.b), i18.Tr("empty 'if' branch (it must contain at least one statement)")
            )
        end
        check_stmt(s, a, n3.b)
        if n3.c != 0:
            if at.KindOf(a, n3.c) == at.AST_BLOCK && at.ChildCount(a, n3.c) == 0:
                serr(
                    s, 60, span_of(a, n3.c), i18.Tr("empty 'else' branch (it must contain at least one statement)")
                )
            end
            check_stmt(s, a, n3.c)
        end
        ret
    end
    if k == at.AST_UNTIL:
        n4 := at.Get(a, nid)
        c4 := sema_check_expr(s, a, n4.a)
        if ty_at(s, c4).kind != TY_BOOL && !type_is_error(s, c4):
            serr(
                s, 21, span_of(a, n4.a), co.Format1(
                    i18.Tr("until condition must be bool, got '%s'"), co.ArgStr(type_to_string(s, c4))
                )
            )
        end
        mut cv4 := false
        if sema_const_bool(s, a, n4.a, cv4) && !cv4:
            serr(
                s, 68, span_of(a, n4.a), i18.Tr("'until' condition is always false: the loop body can never run")
            )
        end
        s.loop_depth += 1
        check_stmt(s, a, n4.b)
        s.loop_depth -= 1
        ret
    end
    if k == at.AST_REPEAT:
        n5 := at.Get(a, nid)
        c5 := sema_check_expr(s, a, n5.a)
        if !type_is_numeric(s, c5) && !type_is_error(s, c5):
            serr(
                s, 63, span_of(a, n5.a), co.Format1(
                    i18.Tr("repeat count must be a number, got '%s'"), co.ArgStr(type_to_string(s, c5))
                )
            )
        end
        if n5.c == 0:
            an5 := at.Get(a, n5.a)
            mut cv5 := ConstVal {}
            mut zero5 := false
            mut neg5 := false
            if sema_const_eval(s, a, n5.a, cv5):
                zero5 = (cv5.kind == CV_INT && cv5.i == 0 as i64) || (cv5.kind == CV_FLOAT && cv5.f == 0.0)
                neg5 = (cv5.kind == CV_INT && cv5.i < 0 as i64) || (cv5.kind == CV_FLOAT && cv5.f < 0.0)
            else (
                an5.kind == at.AST_UNARY && an5.op == tok.TK_MINUS && an5.a != 0 && at.KindOf(a, an5.a) == at.AST_LITERAL
            ):
                // `-<lit>` that stayed un-folded (an unsigned or overflowing
                // literal) is still a negative count.
                neg5 = true
            end
            if zero5:
                serr(
                    s, 68, span_of(a, n5.a), i18.Tr("'repeat' count is the constant 0: the loop body can never run")
                )
            else neg5:
                serr(
                    s, 68, span_of(a, n5.a), i18.Tr("'repeat' count is a negative constant: the loop body can never run")
                )
            end
        end
        mut iv_need64 := ty_at(s, c5).kind == TY_I64 || ty_at(s, c5).kind == TY_U64
        if n5.c != 0:
            e5 := sema_check_expr(s, a, n5.c)
            if !type_is_numeric(s, e5) && !type_is_error(s, e5):
                serr(
                    s, 63, span_of(a, n5.c), co.Format1(
                        i18.Tr("repeat range bound must be a number, got '%s'"), co.ArgStr(type_to_string(s, e5))
                    )
                )
            end
            if ty_at(s, e5).kind == TY_I64 || ty_at(s, e5).kind == TY_U64:
                iv_need64 = true
            end
        end
        if n5.d != 0:
            st5 := sema_check_expr(s, a, n5.d)
            if !type_is_numeric(s, st5) && !type_is_error(s, st5):
                serr(
                    s, 63, span_of(a, n5.d), co.Format1(
                        i18.Tr("repeat step must be a number, got '%s'"), co.ArgStr(type_to_string(s, st5))
                    )
                )
            end
            dn5 := at.Get(a, n5.d)
            if dn5.kind == at.AST_LITERAL && dn5.value_kind == tok.TV_INT && dn5.value_int == 0 as u64:
                serr(
                    s, 63, span_of(a, n5.d), i18.Tr("repeat step must be a positive number (the direction comes from the bounds)")
                )
            end
            if dn5.kind == at.AST_UNARY && dn5.op == tok.TK_MINUS:
                serr(
                    s, 63, span_of(a, n5.d), i18.Tr("repeat step must be a positive number (the direction comes from the bounds)")
                )
            end
            if ty_at(s, st5).kind == TY_I64 || ty_at(s, st5).kind == TY_U64:
                iv_need64 = true
            end
        end
        ivty := sema_ty(s, iv_need64 ? TY_I64 : TY_I32)
        _dt := sema_decorate(s, a, nid, ivty)
        saved5 := s.cur
        if str.Len(n5.name) > 0:
            sc5 := scope_new(s, SCOPE_BLOCK, s.cur)
            iv5 := symbol_new(s, SYM_VAR, n5.name)
            mut ivv := sym_at(s, iv5)
            ivv.ty = ivty
            ivv.is_mut = false
            ivv.decl = nid
            sym_put(s, iv5, ivv)
            _sd := scope_define(s, sc5, iv5)
            s.cur = sc5
        end
        s.loop_depth += 1
        check_stmt(s, a, n5.b)
        s.loop_depth -= 1
        s.cur = saved5
        ret
    end
    if k == at.AST_EACH:
        check_each(s, a, nid)
        ret
    end
    if k == at.AST_FOR:
        n6 := at.Get(a, nid)
        sc6 := scope_new(s, SCOPE_BLOCK, s.cur)
        saved6 := s.cur
        s.cur = sc6
        if n6.a != 0:
            check_stmt(s, a, n6.a)
        end
        if n6.b != 0:
            c6 := sema_check_expr(s, a, n6.b)
            if ty_at(s, c6).kind != TY_BOOL && !type_is_error(s, c6):
                serr(
                    s, 21, span_of(a, n6.b), co.Format1(
                        i18.Tr("for condition must be bool, got '%s'"), co.ArgStr(type_to_string(s, c6))
                    )
                )
            end
        end
        if n6.c != 0:
            check_stmt(s, a, n6.c)
        end
        s.loop_depth += 1
        check_stmt(s, a, n6.d)
        s.loop_depth -= 1
        s.cur = saved6
        ret
    end
    if k == at.AST_RETURN:
        n7 := at.Get(a, nid)
        if s.match_arm_depth > 0 && s.match_yield_active:
            saved_exp := s.expected
            s.expected = s.match_yield_expected
            mut yvt := 0
            if n7.a != 0:
                yvt = sema_check_expr(s, a, n7.a)
            else:
                yvt = sema_ty(s, TY_VOID)
            end
            s.expected = saved_exp
            s.match_yield_collect.push(MatchYield { ret_node = nid, ty = yvt })
            ret
        end
        if s.cur_func != 0:
            sgn := sig_at(s, s.cur_func)
            if sgn.decl != 0:
                dn7 := at.Get(a, sgn.decl)
                if dn7.is_noret && str.Len(dn7.name) > 0:
                    serr(
                        s, 12, sp, co.Format1(
                            i18.Tr("'noret' function '%s' cannot contain 'ret': it never returns"), co.ArgStr(dn7.name)
                        )
                    )
                end
            end
        end
        if s.cur_func != 0 && sig_at(s, s.cur_func).infer_ret:
            mut ivt := 0
            if n7.a != 0:
                ivt = sema_check_expr(s, a, n7.a)
            else:
                ivt = sema_ty(s, TY_VOID)
            end
            mut sgi := sig_at(s, s.cur_func)
            sgi.ret_type = ivt
            sgi.ret_span = sp
            sgi.ret_weak = n7.a != 0 && at.KindOf(a, n7.a) == at.AST_LITERAL && at.Get(a, n7.a).op == tok.TK_INT
            sgi.infer_ret = false
            sig_put(s, s.cur_func, sgi)
            ret
        end
        mut retty := 0
        if s.cur_func != 0:
            retty = sig_at(s, s.cur_func).ret_type
        else:
            retty = sema_ty(s, TY_VOID)
        end
        if n7.a != 0:
            s.expected = retty
            vt7 := sema_check_expr(s, a, n7.a)
            s.expected = TYPE_NONE
            if s.cur_func != 0 && type_is_float(s, retty):
                if type_is_integer(s, vt7):
                    mut sgf := sig_at(s, s.cur_func)
                    if !sgf.ret_int_seen:
                        sgf.ret_int_span = sp
                    end
                    sgf.ret_int_seen = true
                    sig_put(s, s.cur_func, sgf)
                else type_is_float(s, vt7):
                    mut sgf2 := sig_at(s, s.cur_func)
                    sgf2.ret_float_seen = true
                    sig_put(s, s.cur_func, sgf2)
                end
            end
            if ty_at(s, retty).kind == TY_VOID:
                serr(
                    s, 49, sp, i18.Tr("cannot return a value from a void function")
                )
            else !type_assignable(s, retty, vt7):
                mut inferred := false
                if s.cur_func != 0:
                    sgd := sig_at(s, s.cur_func)
                    if sgd.decl != 0 && at.Get(a, sgd.decl).ty == 0:
                        inferred = true
                    end
                end
                if inferred && s.lam.len() == 0 && sig_at(s, s.cur_func).ret_weak && type_is_numeric(s, retty) && type_is_numeric(s, vt7):
                    mut sgw := sig_at(s, s.cur_func)
                    sgw.ret_type = vt7
                    sgw.ret_span = sp
                    sgw.ret_weak = at.KindOf(a, n7.a) == at.AST_LITERAL && at.Get(a, n7.a).op == tok.TK_INT
                    sgw.ret_widened = true
                    sig_put(s, s.cur_func, sgw)
                else inferred:
                    sgd2 := sig_at(s, s.cur_func)
                    serr(
                        s, 2, sp, co.Format4(
                            i18.Tr("conflicting inferred return types for '%s': an earlier 'ret' (line %u) produces '%s', this one produces '%s'; annotate the function's return type explicitly"),
                            co.ArgStr(at.Get(a, sgd2.decl).name), co.ArgUint(sgd2.ret_span.begin.line as u64),
                            co.ArgStr(type_to_string(s, retty)), co.ArgStr(type_to_string(s, vt7))
                        )
                    )
                else:
                    serr(
                        s, 2, sp, co.Format2(
                            i18.Tr("return type mismatch: expected '%s', got '%s'"), co.ArgStr(type_to_string(s, retty)),
                            co.ArgStr(type_to_string(s, vt7))
                        )
                    )
                end
            else ty_at(s, retty).kind == TY_DYN:
                na7 := coerce_to_dyn(s, a, retty, at.Get(a, nid).a, vt7)
                mut nv7 := at.Get(a, nid)
                nv7.a = na7
                at.Put(a, nid, nv7)
            else ty_at(s, retty).kind == TY_VARIANT && ty_at(s, vt7).kind != TY_VARIANT:
                tag7 := type_variant_tag(s, retty, vt7)
                if tag7 >= 0:
                    na8 := coerce_to_variant(
                        s, a, retty, at.Get(a, nid).a, tag7
                    )
                    mut nv8 := at.Get(a, nid)
                    nv8.a = na8
                    at.Put(a, nid, nv8)
                end
            end
        else ty_at(s, retty).kind != TY_VOID:
            serr(
                s, 48, sp, co.Format1(
                    i18.Tr("missing return value; function returns '%s'"), co.ArgStr(type_to_string(s, retty))
                )
            )
        end
        ret
    end
    if k == at.AST_DEFER:
        da := at.Get(a, nid).a
        if da != 0:
            check_stmt(s, a, da)
        end
        ret
    end
    if k == at.AST_BREAK || k == at.AST_CONTINUE:
        if s.loop_depth == 0:
            serr(
                s, 37, sp, co.Format1(
                    i18.Tr("'%s' outside of a loop"), co.ArgStr(
                        k == at.AST_BREAK ? "break" : "continue"
                    )
                )
            )
        end
        ret
    end
    if k == at.AST_EXPR_STMT:
        _et := sema_check_expr(s, a, at.Get(a, nid).a)
        ret
    end
    if k == at.AST_INCDEC:
        _it := sema_check_expr(s, a, nid)
        ret
    end
end

// sema_check_block
func sema_check_block(s &: Sema, a &: at.Ast, block: int):
    sc := scope_new(s, SCOPE_BLOCK, s.cur)
    saved := s.cur
    s.cur = sc
    lg.Log(
        s.log, lg.PH_SEMANTIC, lg.LOG_DEBUG, "enter block scope (" + at.ChildCount(a, block) + " stmts)"
    )
    mut i := 0
    until i < at.ChildCount(a, block):
        check_stmt(s, a, at.Child(a, block, i))
        i += 1
    end
    if !s.requal:
        mut j := 0
        until j + 1 < at.ChildCount(a, block):
            if sema_stmt_terminates(s, a, at.Child(a, block, j)):
                serr(
                    s, 70, span_of(a, at.Child(a, block, j + 1)), i18.Tr("unreachable code: the previous statement always exits this block")
                )
                break
            end
            j += 1
        end
    end

    scv := scope_at(s, sc)
    repeat scv.symbols.len() with si:
        v := sym_at(s, scv.symbols.get(si)[0])
        if v.kind == SYM_VAR && !v.used && v.decl != 0 && str.Len(v.name) > 0 && byte_at(v.name, 0) != 95:
            serr(
                s, 59, span_of(a, v.decl), co.Format1(
                    i18.Tr("unused variable '%s' (prefix with '_' if intentional)"), co.ArgStr(v.name)
                )
            )
        else v.kind == SYM_VAR && v.is_mut && !v.mutated && v.decl != 0 && !at.Get(a, v.decl).synthetic && str.Len(v.name) > 0 && byte_at(v.name, 0) != 95:
            serr(
                s, 69, span_of(a, v.decl), co.Format1(
                    i18.Tr("variable '%s' is declared 'mut' but never mutated; remove 'mut' or declare it 'const'"),
                    co.ArgStr(v.name)
                )
            )
        end
    end
    s.cur = saved
    lg.Log(s.log, lg.PH_SEMANTIC, lg.LOG_DEBUG, "exit block scope")
end

// sema_check_var_decl (sema_stmt.c, 5d) - shared by local and global
// declarations. Handles the `x := v as T` type hoist, HashMap/Vector
// literal early-outs, dyn/Variant coercion of the initializer.
func sema_check_var_decl(s &: Sema, a &: at.Ast, nid: int): int:
    sp := span_of(a, nid)
    mut n := at.Get(a, nid)
    if n.ty == 0 && n.a != 0 && at.KindOf(a, n.a) == at.AST_CAST:
        cv := at.Get(a, n.a)
        ck := at.KindOf(a, cv.a)
        if cv.ty != 0 && (
            ck == at.AST_ARRAY_LIT || ck == at.AST_STRUCT_LIT || ck == at.AST_LITERAL
        ):
            n.ty = cv.ty
            n.a = cv.a
            at.Put(a, nid, n)
        end
    end
    n = at.Get(a, nid)
    mut declared := TYPE_NONE
    if n.ty != 0:
        declared = sema_resolve_type(s, a, n.ty)
    end

    if n.a != 0 && at.KindOf(a, n.a) == at.AST_STRUCT_LIT && str.Len(at.Get(a, n.a).name) > 0:
        orig := at.Get(a, n.a).name
        at.SetName(a, n.a, intrinsic_type_canon(orig))
        sema_check_intrinsic_type_lang(s, orig, span_of(a, n.a))
    end

    if declared >= 0 && ty_at(s, declared).kind == TY_MAP && n.a != 0 && at.KindOf(a, n.a) == at.AST_STRUCT_LIT && str.Equals(at.Get(a, n.a).name, "HashMap"):
        tstr := type_to_string(s, declared)
        at.SetTypeStr(a, n.a, tstr)
        at.SetTypeStr(a, nid, tstr)
        ret declared
    end

    if declared >= 0 && ty_at(s, declared).kind == TY_VEC && n.a != 0 && at.KindOf(a, n.a) == at.AST_STRUCT_LIT && str.Equals(at.Get(a, n.a).name, "Vector"):
        tstr2 := type_to_string(s, declared)
        at.SetTypeStr(a, n.a, tstr2)
        at.SetTypeStr(a, nid, tstr2)
        ret declared
    end

    if declared >= 0 && ty_at(s, declared).kind == TY_STRUCT && n.a != 0 && at.KindOf(a, n.a) == at.AST_STRUCT_LIT && str.Len(at.Get(a, n.a).name) > 0:
        lname := at.Get(a, n.a).name
        if generic_template(s, a, lname, SYM_STRUCT) != 0 || scope_lookup(s, s.global, lname) == 0:
            at.SetName(a, n.a, ty_at(s, declared).name)
        end
    end

    if declared >= 0 && n.a != 0:
        ak := at.KindOf(a, n.a)
        if ak == at.AST_CALL || ak == at.AST_LITERAL || ak == at.AST_ARRAY_LIT || ak == at.AST_TERNARY || ak == at.AST_MATCH:
            s.expected = declared
        end
    end
    mut initt := TYPE_NONE
    if n.a != 0:
        initt = sema_check_expr(s, a, n.a)
    end
    mut t := TYPE_NONE
    if declared >= 0 && initt >= 0:
        if !type_assignable(s, declared, initt):
            serr(
                s, 2, sp, co.Format3(
                    i18.Tr("cannot assign '%s' to '%s' in declaration of '%s'"), co.ArgStr(type_to_string(s, initt)),
                    co.ArgStr(type_to_string(s, declared)), co.ArgStr(n.name)
                )
            )
        end
        if ty_at(s, declared).kind == TY_DYN:
            na := coerce_to_dyn(s, a, declared, at.Get(a, nid).a, initt)
            mut nv := at.Get(a, nid)
            nv.a = na
            at.Put(a, nid, nv)
        end
        if ty_at(s, declared).kind == TY_VARIANT && ty_at(s, initt).kind != TY_VARIANT:
            tag := type_variant_tag(s, declared, initt)
            if tag >= 0:
                na2 := coerce_to_variant(s, a, declared, at.Get(a, nid).a, tag)
                mut nv2 := at.Get(a, nid)
                nv2.a = na2
                at.Put(a, nid, nv2)
            end
        end
        t = declared
    else declared >= 0:
        t = declared
    else initt >= 0:
        t = initt
    else:
        serr(
            s, 1, sp, co.Format1(
                i18.Tr("cannot infer type of '%s' (no type or initializer)"), co.ArgStr(n.name)
            )
        )
        t = sema_err_ty(s)
    end
    at.SetTypeStr(a, nid, type_to_string(s, t))
    ret t
end

// ===========================================================================
// ===== layout/registry.c + schema.c (the slice sema_layout.c needs, 5d) =====
// The registry tables are the g_sm_lay_* module globals; "" plays the C
// NULL string everywhere (or_null collapsed empties at load time).
// ===========================================================================

// layout_elem_lookup - index into g_sm_lay_elem_*, -1 = C NULL.
func lay_elem_lookup(name: str): int:
    repeat g_sm_lay_elem_name.len() with i:
        if str.Equals(g_sm_lay_elem_name.get(i)[0], name):
            ret i
        end
    end
    ret 0 - 1
end

// layout_attr_lookup - index into g_sm_lay_attr_*, -1 = C NULL.
func lay_attr_lookup(name: str): int:
    repeat g_sm_lay_attr_name.len() with i:
        if str.Equals(g_sm_lay_attr_name.get(i)[0], name):
            ret i
        end
    end
    ret 0 - 1
end

// layout_registry_add_value (cap LAYOUT_DYN_VAL_MAX like the C).
func lay_add_value(group: str, spelling: str, canonical: str):
    if str.Len(group) == 0 || str.Len(spelling) == 0 || str.Len(canonical) == 0:
        ret
    end
    if g_sm_lay_val_group.len() >= K_SM_LAY_VAL_MAX:
        ret
    end
    g_sm_lay_val_group.push(group)
    g_sm_lay_val_spell.push(spelling)
    g_sm_lay_val_canon.push(canonical)
end

// dyn_value - "" = C NULL.
func lay_dyn_value(group: str, v: str): str:
    repeat g_sm_lay_val_group.len() with i:
        if str.Equals(g_sm_lay_val_group.get(i)[0], group) && str.Equals(g_sm_lay_val_spell.get(i)[0], v):
            ret g_sm_lay_val_canon.get(i)[0]
        end
    end
    ret ""
end

// csv_has / csv_contains (identical in registry.c and sema_layout.c).
func lay_csv_has(csv: str, v: str): bool:
    if str.Len(csv) == 0 || str.Len(v) == 0:
        ret false
    end
    vl := str.Len(v)
    mut p := 0
    n := str.Len(csv)
    until p <= n:
        comma := str.IndexFrom(csv, ",", p)
        mut l := 0
        if comma >= 0:
            l = comma - p
        else:
            l = n - p
        end
        if l == vl && str.Equals(str.Substr(csv, p, l), v):
            ret true
        end
        if comma < 0:
            break
        end
        p = comma + 1
    end
    ret false
end

func lay_all_digits(v: str): bool:
    if str.Len(v) == 0:
        ret false
    end
    repeat str.Len(v) with i:
        b := byte_at(v, i)
        if b < 48 || b > 57:
            ret false
        end
    end
    ret true
end

func lay_is_int(v: str): bool:
    mut p := 0
    if str.Len(v) > 0 && (byte_at(v, 0) == 43 || byte_at(v, 0) == 45):
        p = 1
    end
    ret lay_all_digits(str.Substr(v, p, str.Len(v) - p))
end

func lay_is_float(v: str): bool:
    mut p := 0
    if str.Len(v) > 0 && (byte_at(v, 0) == 43 || byte_at(v, 0) == 45):
        p = 1
    end
    mut dig := false
    mut dot := false
    n := str.Len(v)
    until p < n:
        b := byte_at(v, p)
        if b >= 48 && b <= 57:
            dig = true
        else b == 46 && !dot:
            dot = true
        else:
            ret false
        end
        p += 1
    end
    ret dig
end

func lay_is_email(v: str): bool:
    atp := str.IndexOf(v, "@")
    if atp <= 0:
        ret false
    end
    dot := str.IndexFrom(v, ".", atp + 1)
    ret dot >= 0 && dot + 1 < str.Len(v)
end

func lay_is_url(v: str): bool:
    if str.StartsWith(v, "http://") || str.StartsWith(v, "https://") || str.StartsWith(v, "mailto:"):
        ret true
    end
    if str.Len(v) == 0:
        ret false
    end
    b0 := byte_at(v, 0)
    if b0 == 47 || b0 == 35 || b0 == 46:
        ret true
    end
    mut has_sep := false
    repeat str.Len(v) with i:
        b := byte_at(v, i)
        if b == 32 || b == 9 || b == 34 || b == 39 || b == 60 || b == 62:
            ret false
        end
        if b == 46 || b == 47:
            has_sep = true
        end
    end
    ret has_sep
end

// color_is_css_function
func lay_color_is_css_fn(v: str): bool:
    ret str.StartsWith(v, "var(") || str.StartsWith(v, "rgb(") || str.StartsWith(v, "rgba(") || str.StartsWith(v, "hsl(") || str.StartsWith(v, "hsla(") || str.StartsWith(v, "hwb(") || str.StartsWith(v, "lab(") || str.StartsWith(v, "lch(") || str.StartsWith(v, "oklab(") || str.StartsWith(v, "oklch(") || str.StartsWith(v, "color-mix(")
end

// layout_map_color - "" = C NULL.
func lay_map_color(v: str): str:
    if str.Len(v) == 0:
        ret lay_dyn_value("color", v)
    end
    if byte_at(v, 0) == 35:
        ret v
    end
    if lay_color_is_css_fn(v):
        ret v
    end
    if str.Equals(v, "currentColor") || str.Equals(v, "currentcolor"):
        ret "currentColor"
    end
    ret lay_dyn_value("color", v)
end

func lay_map_dir(v: str): str:
    ret lay_dyn_value("dir", v)
end

func lay_map_lang(v: str): str:
    ret lay_dyn_value("lang", v)
end

// layout_value_type_name
func lay_value_type_name(vt: int): str:
    if vt == VT_STRING:
        ret i18.Tr("a string")
    end
    if vt == VT_INT:
        ret i18.Tr("an integer")
    end
    if vt == VT_FLOAT:
        ret i18.Tr("a number")
    end
    if vt == VT_BOOL:
        ret i18.Tr("'true' or 'false'")
    end
    if vt == VT_EMAIL:
        ret i18.Tr("an email address")
    end
    if vt == VT_URL:
        ret i18.Tr("a URL")
    end
    if vt == VT_COLOR:
        ret i18.Tr("a color")
    end
    if vt == VT_DIR:
        ret i18.Tr("a text direction")
    end
    if vt == VT_LANG:
        ret i18.Tr("a language")
    end
    if vt == VT_ENUM:
        ret i18.Tr("one of the allowed values")
    end
    if vt == VT_LENGTH:
        ret i18.Tr("a length")
    end
    ret i18.Tr("a value")
end

// layout_attr_value_ok
func lay_attr_value_ok(ai: int, value: str): bool:
    if ai < 0:
        ret true
    end
    v := i18.LayoutValue(value)
    vt := g_sm_lay_attr_vtype.get(ai)[0]
    if vt == VT_STRING:
        ret true
    end
    if vt == VT_INT:
        ret lay_is_int(v)
    end
    if vt == VT_FLOAT:
        ret lay_is_float(v)
    end
    if vt == VT_BOOL:
        ret str.Equals(v, "true") || str.Equals(v, "false")
    end
    if vt == VT_EMAIL:
        ret lay_is_email(v)
    end
    if vt == VT_URL:
        ret lay_is_url(v)
    end
    if vt == VT_COLOR:
        ret str.Len(lay_map_color(v)) > 0
    end
    if vt == VT_DIR:
        ret str.Len(lay_map_dir(v)) > 0
    end
    if vt == VT_LANG:
        ret str.Len(lay_map_lang(v)) > 0
    end
    if vt == VT_ENUM:
        allowed := g_sm_lay_attr_allowed.get(ai)[0]
        ret lay_csv_has(allowed, v) || str.Len(lay_dyn_value(allowed, v)) > 0
    end
    ret true // VT_LENGTH and unknown
end

// ===== schema.c loaders =====

// kind_of
func schema_kind_of(k: str): int:
    if str.Len(k) == 0:
        ret LE_MOTHER
    end
    if str.Equals(k, "Single") || str.Equals(k, "single"):
        ret LE_SINGLE
    end
    if str.Equals(k, "Single2Mother") || str.Equals(k, "single2mother"):
        ret LE_SINGLE2MOTHER
    end
    if str.Equals(k, "Mother2Single") || str.Equals(k, "mother2single"):
        ret LE_MOTHER2SINGLE
    end
    ret LE_MOTHER
end

// dest_of
func schema_dest_of(d: str): int:
    if str.Len(d) == 0:
        ret LA_HTML
    end
    if str.Equals(d, "content"):
        ret LA_CONTENT
    end
    if str.Equals(d, "class"):
        ret LA_CLASS
    end
    if str.Equals(d, "style"):
        ret LA_STYLE
    end
    if str.Equals(d, "dir"):
        ret LA_DIR
    end
    if str.Equals(d, "lang"):
        ret LA_LANG
    end
    if str.Equals(d, "source"):
        ret LA_SOURCE
    end
    if str.Equals(d, "css"):
        ret LA_CSS
    end
    if str.Equals(d, "meta"):
        ret LA_META
    end
    ret LA_HTML
end

// vtype_of
func schema_vtype_of(t: str): int:
    if str.Len(t) == 0:
        ret VT_STRING
    end
    if str.Equals(t, "int"):
        ret VT_INT
    end
    if str.Equals(t, "float"):
        ret VT_FLOAT
    end
    if str.Equals(t, "bool"):
        ret VT_BOOL
    end
    if str.Equals(t, "email"):
        ret VT_EMAIL
    end
    if str.Equals(t, "url"):
        ret VT_URL
    end
    if str.Equals(t, "color"):
        ret VT_COLOR
    end
    if str.Equals(t, "dir"):
        ret VT_DIR
    end
    if str.Equals(t, "lang"):
        ret VT_LANG
    end
    if str.Equals(t, "enum"):
        ret VT_ENUM
    end
    if str.Equals(t, "length"):
        ret VT_LENGTH
    end
    ret VT_STRING
end

// field_atom - "" = C NULL.
func schema_field_atom(a &: at.Ast, lit: int, field: str): str:
    repeat at.ChildCount(a, lit) with i:
        fi := at.Child(a, lit, i)
        fv := at.Get(a, fi)
        if !str.Equals(fv.name, field) || fv.a == 0:
            continue
        end
        av := at.Get(a, fv.a)
        if av.kind == at.AST_LITERAL && av.value_kind == tok.TV_STRING:
            ret av.value_str
        end
        if av.kind == at.AST_MEMBER && str.Len(av.name) > 0:
            ret av.name
        end
        ret ""
    end
    ret ""
end

// field_csv - "" = C NULL (empty strings collapse like the C).
func schema_field_csv(a &: at.Ast, lit: int, field: str): str:
    repeat at.ChildCount(a, lit) with i:
        fi := at.Child(a, lit, i)
        fv := at.Get(a, fi)
        if !str.Equals(fv.name, field) || fv.a == 0:
            continue
        end
        av := at.Get(a, fv.a)
        if av.kind == at.AST_LITERAL && av.value_kind == tok.TV_STRING:
            ret av.value_str
        end
        if av.kind == at.AST_ARRAY_LIT:
            mut out := ""
            repeat at.ChildCount(a, fv.a) with j:
                ev := at.Get(a, at.Child(a, fv.a, j))
                if ev.kind == at.AST_LITERAL && ev.value_kind == tok.TV_STRING:
                    if str.Len(out) > 0:
                        out = out + ","
                    end
                    out = out + ev.value_str
                end
            end
            ret out
        end
        ret ""
    end
    ret ""
end

// register_name_spellings - every en/fa/ar alias of the decl node.
func schema_register_words(a &: at.Ast, did: int, canon: str):
    d := at.Get(a, did)
    mut i := 0
    until i + 1 < d.aliases.len():
        lang := d.aliases.get(i)[0]
        spelling := d.aliases.get(i + 1)[0]
        if str.Equals(lang, "en") || str.Equals(lang, "fa") || str.Equals(lang, "ar"):
            i18.RegisterLayoutWord(lang, spelling, canon)
        end
        i += 2
    end
end

// lex+parse one schema file into a scratch Ast; returns the program id
// (0 = unreadable/unparsable, mirroring the C early returns).
func schema_parse_file(a &: at.Ast, path: str): int:
    mut sf := src.New()
    if !src.Load(path, sf):
        ret 0
    end
    quiet := lg.New(lg.LOG_OFF, false)
    mut toks := tok.StreamNew(path)
    _l := lx.Run(quiet, lp.Load("en"), sf, toks)
    mut prog := 0
    _p := ps.Run(quiet, toks, a, prog)
    tok.StreamFree(toks)
    ret prog
end

// load_file (elements)
func schema_load_elem_file(path: str):
    mut a := at.NewAst()
    prog := schema_parse_file(a, path)
    if prog == 0:
        at.FreeAst(a)
        ret
    end
    mut i := 0
    until i < at.ChildCount(a, prog) && g_sm_lay_elem_name.len() < K_SM_SCHEMA_MAX:
        did := at.Child(a, prog, i)
        i += 1
        d := at.Get(a, did)
        if d.kind != at.AST_CONST_DECL || d.a == 0 || at.KindOf(a, d.a) != at.AST_STRUCT_LIT:
            continue
        end
        lit := d.a
        mut name := schema_field_atom(a, lit, "name")
        if str.Len(name) == 0:
            name = alias_for_lang(d.aliases, "en")
        end
        mut gen := schema_field_atom(a, lit, "generated_name")
        if str.Len(gen) == 0:
            gen = schema_field_atom(a, lit, "tag")
        end
        if str.Len(name) == 0:
            continue
        end
        mut parents := schema_field_csv(a, lit, "parents")
        if str.Len(parents) == 0:
            parents = schema_field_csv(a, lit, "parentElements")
        end
        g_sm_lay_elem_name.push(name)
        g_sm_lay_elem_tag.push(gen)
        g_sm_lay_elem_type.push(
            schema_kind_of(
                schema_field_atom(
                    a, lit, "kind"
                )
            )
        )
        g_sm_lay_elem_parents.push(parents)
        g_sm_lay_elem_required.push(schema_field_csv(a, lit, "required"))
        schema_register_words(a, did, name)
    end
    at.FreeAst(a)
end

// load_attr_file (attributes + style share the table and its cap)
func schema_load_attr_file(path: str):
    mut a := at.NewAst()
    prog := schema_parse_file(a, path)
    if prog == 0:
        at.FreeAst(a)
        ret
    end
    mut i := 0
    until i < at.ChildCount(a, prog) && g_sm_lay_attr_name.len() < K_SM_SCHEMA_MAX:
        did := at.Child(a, prog, i)
        i += 1
        d := at.Get(a, did)
        if d.kind != at.AST_CONST_DECL || d.a == 0 || at.KindOf(a, d.a) != at.AST_STRUCT_LIT:
            continue
        end
        lit := d.a
        mut name := schema_field_atom(a, lit, "name")
        if str.Len(name) == 0:
            name = alias_for_lang(d.aliases, "en")
        end
        if str.Len(name) == 0:
            continue
        end
        g_sm_lay_attr_name.push(name)
        g_sm_lay_attr_out.push(schema_field_atom(a, lit, "generated_name"))
        g_sm_lay_attr_dest.push(
            schema_dest_of(schema_field_atom(a, lit, "destination"))
        )
        g_sm_lay_attr_vtype.push(
            schema_vtype_of(schema_field_atom(a, lit, "value_type"))
        )
        g_sm_lay_attr_allowed.push(schema_field_csv(a, lit, "allowed"))
        schema_register_words(a, did, name)
    end
    at.FreeAst(a)
end

// load_value_file (values)
func schema_load_value_file(path: str):
    mut a := at.NewAst()
    prog := schema_parse_file(a, path)
    if prog == 0:
        at.FreeAst(a)
        ret
    end
    mut i := 0
    until i < at.ChildCount(a, prog):
        did := at.Child(a, prog, i)
        i += 1
        d := at.Get(a, did)
        if d.kind != at.AST_CONST_DECL || d.a == 0 || at.KindOf(a, d.a) != at.AST_STRUCT_LIT:
            continue
        end
        lit := d.a
        gen := schema_field_atom(a, lit, "generated_value")
        group := schema_field_atom(a, lit, "group")
        if str.Len(gen) == 0 || str.Len(group) == 0:
            continue
        end
        lay_add_value(group, gen, gen)
        mut j := 0
        until j + 1 < d.aliases.len():
            lang := d.aliases.get(j)[0]
            spelling := d.aliases.get(j + 1)[0]
            j += 2
            if str.Equals(lang, "en"):
                lay_add_value(group, spelling, gen)
                i18.RegisterLayoutValue("*", spelling, gen)
            else str.Equals(lang, "fa") || str.Equals(lang, "ar"):
                lay_add_value(group, spelling, gen)
                i18.RegisterLayoutValue(lang, spelling, gen)
            end
        end
    end
    at.FreeAst(a)
end

// list_schema_files - *.salam entries of one directory (readdir order),
// capped at SCHEMA_MAX_ELEMS files like the C.
func schema_list_files(dir: str): Vector<str>:
    mut out := Vector {} as Vector<str>
    mut names := os.ListDir(dir)
    defer names.free()
    repeat names.len() with i:
        nm := names.get(i)[0]
        if str.EndsWith(nm, ".salam") && str.Len(nm) > 6 && out.len() < K_SM_SCHEMA_MAX:
            out.push(dir + "/" + nm)
        end
    end
    ret out
end

// layout_schema_init
func layout_schema_init(root: str):
    mut base := "std/layout"
    if str.Len(root) > 0:
        base = root + "/std/layout"
    end
    mut ef := schema_list_files(base + "/elements")
    defer ef.free()
    repeat ef.len() with i:
        schema_load_elem_file(ef.get(i)[0])
    end
    mut af := schema_list_files(base + "/attributes")
    defer af.free()
    repeat af.len() with j:
        schema_load_attr_file(af.get(j)[0])
    end
    mut stf := schema_list_files(base + "/style")
    defer stf.free()
    repeat stf.len() with k:
        schema_load_attr_file(stf.get(k)[0])
    end
    mut vf := schema_list_files(base + "/values")
    defer vf.free()
    repeat vf.len() with l:
        schema_load_value_file(vf.get(l)[0])
    end
end

// ===========================================================================
// ===== sema_layout.c (5d) =====
// ===========================================================================

// layout_localize_names (layout_gen.c) - canonicalizes element/attribute
// spellings through the i18n layout-word registry, recursively.
func layout_localize_names(a &: at.Ast, nid: int):
    if nid == 0:
        ret
    end
    n := at.Get(a, nid)
    if n.kind == at.AST_LAYOUT_ELEMENT || n.kind == at.AST_LAYOUT_ATTR:
        at.SetName(a, nid, i18.LayoutWord(n.name))
    end
    repeat at.ChildCount(a, nid) with i:
        layout_localize_names(a, at.Child(a, nid, i))
    end
end

// attr_string - true when the attribute's value is a string literal.
func lay_attr_string(a &: at.Ast, attr: int, out &: str): bool:
    v := at.Get(a, attr).a
    if v == 0:
        ret false
    end
    vv := at.Get(a, v)
    if vv.kind == at.AST_LITERAL && vv.value_kind == tok.TV_STRING:
        out = vv.value_str
        ret true
    end
    ret false
end

// elem_attr - child AST_LAYOUT_ATTR named `name`, 0 = C NULL.
func lay_elem_attr(a &: at.Ast, el: int, name: str): int:
    repeat at.ChildCount(a, el) with i:
        cid := at.Child(a, el, i)
        c := at.Get(a, cid)
        if c.kind == at.AST_LAYOUT_ATTR && str.Equals(c.name, name):
            ret cid
        end
    end
    ret 0
end

// subtree_has_id
func lay_subtree_has_id(a &: at.Ast, el: int): bool:
    repeat at.ChildCount(a, el) with i:
        cid := at.Child(a, el, i)
        if at.KindOf(a, cid) != at.AST_LAYOUT_ELEMENT:
            continue
        end
        if lay_elem_attr(a, cid, "id") != 0 || lay_subtree_has_id(a, cid):
            ret true
        end
    end
    ret false
end

// check_repeat - E019.
func lay_check_repeat(s &: Sema, a &: at.Ast, element: int):
    if lay_elem_attr(a, element, "repeat") == 0:
        ret
    end
    elname := at.Get(a, element).name
    if lay_elem_attr(a, element, "id") != 0:
        serr(
            s, 19, span_of(a, element), co.Format1(
                i18.Tr("element '%s' cannot use 'repeat' together with 'id'"), co.ArgStr(elname)
            )
        )
    else lay_subtree_has_id(a, element):
        serr(
            s, 19, span_of(a, element), co.Format1(
                i18.Tr("element '%s' has 'repeat' but a nested element has an 'id'"), co.ArgStr(elname)
            )
        )
    end
end

// check_attr - E018.
func lay_check_attr(s &: Sema, a &: at.Ast, attr: int):
    name := at.Get(a, attr).name
    if str.Len(name) == 0:
        ret
    end
    ai := lay_attr_lookup(name)
    if ai < 0:
        ret
    end
    mut v := ""
    if !lay_attr_string(a, attr, v):
        ret
    end
    if !lay_attr_value_ok(ai, v):
        serr(
            s, 18, span_of(a, attr), co.Format3(
                i18.Tr("invalid value for '%s': '%s' is not %s"), co.ArgStr(name), co.ArgStr(v), co.ArgStr(
                    lay_value_type_name(
                        g_sm_lay_attr_vtype.get(ai)[0]
                    )
                )
            )
        )
    end
end

// check_required - E005 (the "%.*s" keeps the C csv-slice formatting).
func lay_check_required(s &: Sema, a &: at.Ast, element: int, ei: int):
    if ei < 0:
        ret
    end
    req := g_sm_lay_elem_required.get(ei)[0]
    if str.Len(req) == 0:
        ret
    end
    elname := at.Get(a, element).name
    n := str.Len(req)
    mut p := 0
    until p <= n:
        comma := str.IndexFrom(req, ",", p)
        mut l := 0
        if comma >= 0:
            l = comma - p
        else:
            l = n - p
        end
        piece := str.Substr(req, p, l)
        mut found := false
        repeat at.ChildCount(a, element) with i:
            c := at.Get(a, at.Child(a, element, i))
            if c.kind == at.AST_LAYOUT_ATTR && str.Equals(c.name, piece):
                found = true
                break
            end
        end
        if !found:
            serr(
                s, 5, span_of(a, element), co.Format3(
                    i18.Tr("element '%s' is missing required attribute '%.*s'"), co.ArgStr(elname), co.ArgInt(l as i64),
                    co.ArgStr(str.Substr(req, p, n - p))
                )
            )
        end
        if comma < 0:
            break
        end
        p = comma + 1
    end
end

// sema_check_layout - parent "" plays the C NULL.
func sema_check_layout(s &: Sema, a &: at.Ast, nid: int, parent: str):
    k := at.KindOf(a, nid)
    if k == at.AST_LAYOUT_BLOCK:
        layout_localize_names(a, nid)
        lg.Log(
            s.log, lg.PH_SEMANTIC, lg.LOG_DEBUG, i18.Tr("validating layout block")
        )
        if lay_elem_attr(a, nid, "repeat") != 0 && lay_subtree_has_id(a, nid):
            serr(
                s, 19, span_of(a, nid), i18.Tr("layout uses 'repeat' but a nested element has an 'id'")
            )
        end
        repeat at.ChildCount(a, nid) with i:
            cid := at.Child(a, nid, i)
            ck := at.KindOf(a, cid)
            if ck == at.AST_LAYOUT_ELEMENT:
                sema_check_layout(s, a, cid, "layout")
            else ck == at.AST_LAYOUT_ATTR:
                lay_check_attr(s, a, cid)
            end
        end
        ret
    end
    if k == at.AST_LAYOUT_ELEMENT:
        elname := at.Get(a, nid).name
        ei := lay_elem_lookup(elname)
        if ei < 0:
            swarn(
                s, 2, span_of(a, nid), co.Format1(
                    i18.Tr("unrecognized layout element '%s' (ignored)"), co.ArgStr(elname)
                )
            )
        else:
            parents := g_sm_lay_elem_parents.get(ei)[0]
            if str.Len(parents) > 0 && !lay_csv_has(parents, parent):
                serr(
                    s, 4, span_of(a, nid), co.Format2(
                        i18.Tr("element '%s' cannot be placed inside '%s'"), co.ArgStr(elname), co.ArgStr(str.Len(parent) > 0 ? parent : "<root>")
                    )
                )
            end
            lay_check_required(s, a, nid, ei)
        end
        lay_check_repeat(s, a, nid)
        repeat at.ChildCount(a, nid) with i2:
            cid2 := at.Child(a, nid, i2)
            ck2 := at.KindOf(a, cid2)
            if ck2 == at.AST_LAYOUT_ELEMENT:
                sema_check_layout(s, a, cid2, elname)
            else ck2 == at.AST_LAYOUT_ATTR:
                lay_check_attr(s, a, cid2)
            end
        end
        ret
    end
end

// loopless_break (sema_stmt.c, 5d) - a `break` not swallowed by a nested
// loop, looking through blocks/ifs/matches.
func loopless_break(a &: at.Ast, nid: int): bool:
    if nid == 0:
        ret false
    end
    n := at.Get(a, nid)
    if n.kind == at.AST_BREAK:
        ret true
    end
    if n.kind == at.AST_BLOCK:
        repeat at.ChildCount(a, nid) with i:
            if loopless_break(a, at.Child(a, nid, i)):
                ret true
            end
        end
        ret false
    end
    if n.kind == at.AST_IF:
        ret loopless_break(a, n.b) || loopless_break(a, n.c)
    end
    if n.kind == at.AST_MATCH:
        repeat at.ChildCount(a, nid) with j:
            arm := at.Child(a, nid, j)
            if loopless_break(a, at.Get(a, arm).b):
                ret true
            end
        end
        ret false
    end
    ret false
end

// sema_stmt_terminates (sema_stmt.c, 5d) - W071 termination analysis.
func sema_stmt_terminates(s &: Sema, a &: at.Ast, nid: int): bool:
    if nid == 0:
        ret false
    end
    n := at.Get(a, nid)
    if n.kind == at.AST_RETURN || n.kind == at.AST_BREAK || n.kind == at.AST_CONTINUE:
        ret true
    end
    if n.kind == at.AST_BLOCK:
        repeat at.ChildCount(a, nid) with i:
            if sema_stmt_terminates(s, a, at.Child(a, nid, i)):
                ret true
            end
        end
        ret false
    end
    if n.kind == at.AST_IF:
        ret n.c != 0 && sema_stmt_terminates(s, a, n.b) && sema_stmt_terminates(s, a, n.c)
    end
    if n.kind == at.AST_UNTIL:
        ret n.a != 0 && at.KindOf(a, n.a) == at.AST_LITERAL && at.Get(a, n.a).op == tok.TK_KW_TRUE && !loopless_break(a, n.b)
    end
    if n.kind == at.AST_MATCH:
        mut has_else := false
        if at.ChildCount(a, nid) == 0:
            ret false
        end
        repeat at.ChildCount(a, nid) with j:
            arm := at.Child(a, nid, j)
            if at.Get(a, arm).op == tok.TK_KW_ELSE:
                has_else = true
            end
            if !sema_stmt_terminates(s, a, at.Get(a, arm).b):
                ret false
            end
        end
        ret has_else
    end
    if n.kind == at.AST_EXPR_STMT:
        c := n.a
        if c != 0 && at.KindOf(a, c) == at.AST_CALL:
            ca := at.Get(a, c).a
            if ca != 0 && at.KindOf(a, ca) == at.AST_IDENTIFIER:
                symid := scope_lookup(s, s.cur, at.Get(a, ca).name)
                if symid != 0:
                    sv := sym_at(s, symid)
                    if sv.kind == SYM_FUNC && sv.overloads.len() == 1:
                        sg := sig_at(s, sv.overloads.get(0)[0])
                        if sg.decl != 0 && at.Get(a, sg.decl).is_noret:
                            ret true
                        end
                    end
                end
            end
        end
        ret false
    end
    ret false
end

// stamp_empty_intrinsic (sema_call.c, 5c) - stamps `Vector {}`/`HashMap {}`
// empty literals with the intrinsic target type (TY_VEC/TY_MAP only; the
// generic-struct collections take the check_struct_lit path).
func stamp_empty_intrinsic(s &: Sema, a &: at.Ast, val: int, target: int): bool:
    if val == 0 || target < 0:
        ret false
    end
    n := at.Get(a, val)
    if n.kind != at.AST_STRUCT_LIT || str.Len(n.name) == 0:
        ret false
    end
    sp := span_of(a, val)
    orig := n.name
    at.SetName(a, val, intrinsic_type_canon(orig))
    sema_check_intrinsic_type_lang(s, orig, sp)
    vname := at.Get(a, val).name
    tk := ty_at(s, target).kind
    if (tk == TY_VEC && str.Equals(vname, "Vector")) || (tk == TY_MAP && str.Equals(vname, "HashMap")):
        at.SetTypeStr(a, val, type_to_string(s, target))
        _sd := sema_decorate(s, a, val, target)
        ret true
    end
    ret false
end

// The E062 unused-parameter loop at the end of check_function
// (sema_decl.c) - live now that 5d's body checks set Symbol.used.
func check_unused_params(s &: Sema, a &: at.Ast, sc: int, _fn: int):
    scv := scope_at(s, sc)
    repeat scv.symbols.len() with i:
        p := sym_at(s, scv.symbols.get(i)[0])
        if p.kind == SYM_PARAM && !p.used && p.decl != 0 && str.Len(p.name) > 0 && byte_at(p.name, 0) != 95 && !str.Equals(p.name, "this"):
            serr(
                s, 62, span_of(a, p.decl), co.Format1(
                    i18.Tr("unused parameter '%s' (prefix with '_' if intentional)"), co.ArgStr(p.name)
                )
            )
        end
    end
end

// generic_template (sema_generic.c, 5c) - a visible symbol of `kind` whose
// decl still carries type parameters; 0 = C NULL. (5c note: gained the
// `a` parameter - the C read sym->decl->typarams directly.)
func generic_template(s &: Sema, a &: at.Ast, name: str, kind: int): int:
    if str.Len(name) == 0:
        ret 0
    end
    sym := scope_lookup(s, s.cur, name)
    if sym == 0:
        ret 0
    end
    sv := sym_at(s, sym)
    if sv.kind == kind && sv.decl != 0 && at.TyparamCount(a, sv.decl) > 0:
        ret sym
    end
    ret 0
end

// g_instantiate_struct (sema_generic.c, 5c) - instantiates a generic struct
// template for the given type-argument nodes; returns the instance SymId
// (cached per instance name in the global scope); 0 = C NULL.
func g_instantiate_struct(
    s &: Sema, a &: at.Ast, tmpl: int, targ_nodes: Vector<int>, sp: co.SrcSpan
): int:
    tn := at.Get(a, tmpl)
    if targ_nodes.len() != tn.typarams.len():
        serr(
            s, 1, sp, co.Format4(
                i18.Tr("generic '%s' expects %zu type argument%s, got %zu"), co.ArgStr(tn.name), co.ArgUint(tn.typarams.len() as u64),
                co.ArgStr(plural_suffix(tn.typarams.len())), co.ArgUint(targ_nodes.len() as u64)
            )
        )
        ret 0
    end
    mut argtypes := Vector {} as Vector<int>
    defer argtypes.free()
    repeat targ_nodes.len() with i:
        argtypes.push(sema_resolve_type(s, a, targ_nodes.get(i)[0]))
    end
    iname := g_instance_name(s, tn.name, argtypes)
    existing := scope_lookup_local(s, s.global, iname)
    if existing != 0:
        ret existing
    end
    save_lang := s.lang
    if str.Len(tn.origin_lang) > 0:
        s.lang = tn.origin_lang
    end
    g_check_bounds(s, a, tmpl, argtypes, sp)
    inst := at.Clone(a, tmpl)
    mut iv := at.Get(a, inst)
    iv.name = iname
    iv.synthetic = true
    at.Put(a, inst, iv)
    g_subst(a, inst, tn.typarams, targ_nodes)
    mut iv2 := at.Get(a, inst)
    iv2.typarams.clear()
    at.Put(a, inst, iv2)
    at.AddChild(a, s.program, inst)
    sym := symbol_new(s, SYM_STRUCT, iname)
    members := scope_new(s, SCOPE_STRUCT, s.global)
    mut msc := scope_at(s, members)
    msc.label = iname
    msc.aux = s.gen_pkg
    scope_put(s, members, msc)
    mut sv := sym_at(s, sym)
    sv.decl = inst
    sv.ty = type_struct(s, sym, iname)
    sv.members = members
    sv.home = s.gen_pkg
    sv.generic_base = tn.name
    repeat argtypes.len() with gi:
        sv.generic_args.push(argtypes.get(gi)[0])
    end
    sym_put(s, sym, sv)
    _sd := scope_define(s, s.global, sym)
    repeat at.ChildCount(a, inst) with j:
        mid := at.Child(a, inst, j)
        m := at.Get(a, mid)
        if m.kind == at.AST_FIELD:
            f := symbol_new(s, SYM_FIELD, m.name)
            ftt := sema_resolve_type(s, a, m.ty)
            mut fv := sym_at(s, f)
            fv.ty = ftt
            fv.decl = mid
            fv.is_pub = m.is_pub
            sym_put(s, f, fv)
            _fd := scope_define(s, members, f)
        else m.kind == at.AST_FUNC_DEF:
            mm := get_or_make_func(s, members, m.name, SYM_METHOD)
            sig := build_sig(s, a, mid, sym)
            mut mv := sym_at(s, mm)
            if m.is_pub:
                mv.is_pub = true
            end
            mv.overloads.push(sig)
            mv.ty = sym_at(s, sym).ty
            sym_put(s, mm, mv)
        end
    end
    s.pending.push(inst)
    s.lang = save_lang
    ret sym
end

// ===========================================================================
// ===== sema_generic.c (5c) =====
// ===========================================================================

// Creates a synthetic-capable node carrying `sp` (ast_new(kind, span)).
func new_node_at(a &: at.Ast, kind: int, sp: co.SrcSpan): int:
    id := at.NewNode(a, kind)
    at.SetSpan(
        a, id, sp.begin.line, sp.begin.col, sp.begin.index, sp.finish.line, sp.finish.col, sp.finish.index,
        sp.length
    )
    ret id
end

// g_sanitize - type string -> identifier-safe instance-name fragment.
func g_sanitize(ts: str): str:
    mut out := ""
    n := str.Len(ts)
    repeat n with i:
        b := byte_at(ts, i)
        if b == 42:
            out = out + "_ptr"
        else b == 91:
            out = out + "_arr"
        else b == 60 || b == 44:
            out = out + "_"
        else b == 62 || b == 32 || b == 93:
            continue
        else:
            out = out + str.Substr(ts, i, 1)
        end
    end
    ret out
end

// g_subst - rewrites every AST_TYPE named after a type parameter into a
// clone of the matching argument node. The C shared the clone's list/dims
// vectors; the port copies the child NodeIds into fresh vectors (same
// reads, no double-free on FreeAst).
func g_subst(a &: at.Ast, nid: int, params: Vector<str>, args: Vector<int>):
    if nid == 0:
        ret
    end
    n := at.Get(a, nid)
    g_subst(a, n.ty, params, args)
    g_subst(a, n.a, params, args)
    g_subst(a, n.b, params, args)
    g_subst(a, n.c, params, args)
    g_subst(a, n.d, params, args)
    repeat n.list.len() with i:
        g_subst(a, n.list.get(i)[0], params, args)
    end
    repeat n.dims.len() with i2:
        g_subst(a, n.dims.get(i2)[0], params, args)
    end
    if n.kind == at.AST_TYPE && str.Len(n.name) > 0:
        repeat params.len() with pi:
            if !str.Equals(n.name, params.get(pi)[0]):
                continue
            end
            ccid := at.Clone(a, args.get(pi)[0])
            cc := at.Get(a, ccid)
            mut nv := at.Get(a, nid)
            ptr := nv.is_pointer || cc.is_pointer
            nv.name = cc.name
            nv.list.free()
            nv.list = Vector {} as Vector<int>
            repeat cc.list.len() with k:
                nv.list.push(cc.list.get(k)[0])
            end
            nv.is_pointer = ptr
            nv.is_dyn = cc.is_dyn
            mut merged := Vector {} as Vector<int>
            repeat cc.dims.len() with k2:
                merged.push(cc.dims.get(k2)[0])
            end
            repeat nv.dims.len() with k3:
                merged.push(nv.dims.get(k3)[0])
            end
            nv.dims.free()
            nv.dims = merged
            at.Put(a, nid, nv)
            break
        end
    end
end

// g_instance_name - "Base_arg1_arg2" (the C clamps at 512 bytes; not
// replicated per the file-header conventions).
func g_instance_name(s &: Sema, base: str, argtypes: Vector<int>): str:
    mut out := base
    repeat argtypes.len() with i:
        out = out + "_" + g_sanitize(type_to_string(s, argtypes.get(i)[0]))
    end
    ret out
end

// g_type_to_ast - synthesizes an AST_TYPE node describing `t`.
func g_type_to_ast(s &: Sema, a &: at.Ast, t: int, sp: co.SrcSpan): int:
    nid := new_node_at(a, at.AST_TYPE, sp)
    mut nv := at.Get(a, nid)
    nv.synthetic = true
    at.Put(a, nid, nv)
    if t < 0:
        at.SetName(a, nid, "void")
        ret nid
    end
    v := ty_at(s, t)
    if v.kind == TY_PTR && v.pointee >= 0:
        p := g_type_to_ast(s, a, v.pointee, sp)
        mut pv := at.Get(a, p)
        pv.is_pointer = true
        at.Put(a, p, pv)
        ret p
    end
    if v.kind == TY_VEC:
        at.SetName(a, nid, "Vector")
        at.AddChild(a, nid, g_type_to_ast(s, a, v.elem, sp))
        ret nid
    end
    if v.kind == TY_MAP:
        at.SetName(a, nid, "HashMap")
        at.AddChild(a, nid, g_type_to_ast(s, a, v.key, sp))
        at.AddChild(a, nid, g_type_to_ast(s, a, v.elem, sp))
        ret nid
    end
    at.SetName(a, nid, type_to_string(s, t))
    ret nid
end

// iface_satisfied - structural interface conformance for generic bounds
// and dyn coercion.
func iface_satisfied(
    s &: Sema, _a &: at.Ast, concrete: int, iface_name: str, tparam: str, sp: co.SrcSpan
): bool:
    iface := scope_lookup(s, s.global, iface_name)
    mut iface_ok := iface != 0
    if iface_ok && sym_at(s, iface).kind != SYM_INTERFACE:
        iface_ok = false
    end
    if !iface_ok:
        serr(
            s, 1, sp, co.Format2(
                i18.Tr("bound '%s' on type parameter '%s' is not an interface"), co.ArgStr(iface_name),
                co.ArgStr(tparam)
            )
        )
        ret false
    end
    mut members := 0
    if concrete >= 0 && ty_at(s, concrete).kind == TY_STRUCT && ty_at(s, concrete).decl != 0:
        members = sym_at(s, ty_at(s, concrete).decl).members
    else concrete >= 0:
        owner := scope_lookup(
            s, s.global, impl_owner_key(type_to_string(s, concrete))
        )
        if owner != 0:
            members = sym_at(s, owner).members
        end
    end
    if members == 0:
        serr(
            s, 2, sp, co.Format2(
                i18.Tr("'%s' does not satisfy '%s': no struct definition or `impl` block provides its methods"),
                co.ArgStr(type_to_string(s, concrete)), co.ArgStr(iface_name)
            )
        )
        ret false
    end
    mut all_ok := true
    ifm := scope_at(s, sym_at(s, iface).members)
    repeat ifm.symbols.len() with i:
        im := sym_at(s, ifm.symbols.get(i)[0])
        if im.kind != SYM_METHOD || im.overloads.len() == 0:
            continue
        end
        want := sig_at(s, im.overloads.get(0)[0])
        smx := scope_lookup_local(s, members, im.name)
        mut have_m := smx != 0
        if have_m && sym_at(s, smx).kind != SYM_METHOD:
            have_m = false
        end
        if !have_m:
            serr(
                s, 2, sp, co.Format3(
                    i18.Tr("'%s' does not implement interface '%s': missing method '%s'"), co.ArgStr(type_to_string(s, concrete)),
                    co.ArgStr(iface_name), co.ArgStr(im.name)
                )
            )
            all_ok = false
            continue
        end
        smv := sym_at(s, smx)
        mut sig_ok := false
        repeat smv.overloads.len() with k:
            have := sig_at(s, smv.overloads.get(k)[0])
            if have.params.len() != want.params.len():
                continue
            end
            mut pm := true
            repeat want.params.len() with p:
                if !type_equiv(s, have.params.get(p)[0], want.params.get(p)[0]):
                    pm = false
                    break
                end
            end
            if pm && type_equiv(s, have.ret_type, want.ret_type):
                sig_ok = true
                break
            end
        end
        if !sig_ok:
            serr(
                s, 2, sp, co.Format3(
                    i18.Tr("'%s' implements method '%s' with a signature that does not match interface '%s'"),
                    co.ArgStr(type_to_string(s, concrete)), co.ArgStr(im.name), co.ArgStr(iface_name)
                )
            )
            all_ok = false
        end
    end
    ret all_ok
end

// g_check_bounds - validates `<T: Iface>` bounds at instantiation.
func g_check_bounds(
    s &: Sema, a &: at.Ast, tmpl: int, argtypes: Vector<int>, sp: co.SrcSpan
):
    repeat at.TyparamCount(a, tmpl) with i:
        if i >= argtypes.len():
            break
        end
        bound := at.TyparamBound(a, tmpl, i)
        if str.Len(bound) > 0:
            _ok := iface_satisfied(
                s, a, argtypes.get(i)[0], bound, at.Typaram(a, tmpl, i), sp
            )
        end
    end
end

// coerce_to_dyn - wraps `expr` in a synthetic AST_CAST when the expected
// type is a dyn interface; returns the (possibly new) node id.
func coerce_to_dyn(
    s &: Sema, a &: at.Ast, expected: int, expr: int, etype: int
): int:
    if expected < 0 || ty_at(s, expected).kind != TY_DYN || expr == 0:
        ret expr
    end
    if etype < 0 || ty_at(s, etype).kind != TY_STRUCT:
        ret expr
    end
    ename := ty_at(s, expected).name
    _ok := iface_satisfied(s, a, etype, ename, ename, span_of(a, expr))
    box := new_node_at(a, at.AST_CAST, span_of(a, expr))
    mut bv := at.Get(a, box)
    bv.a = expr
    bv.synthetic = true
    bv.type_str = type_to_string(s, expected)
    at.Put(a, box, bv)
    ret box
end

// coerce_to_variant - wraps `expr` in an AST_VARIANT_BOX carrying the tag.
func coerce_to_variant(
    s &: Sema, a &: at.Ast, variant: int, expr: int, tag: int
): int:
    box := new_node_at(a, at.AST_VARIANT_BOX, span_of(a, expr))
    mut bv := at.Get(a, box)
    bv.a = expr
    bv.synthetic = true
    bv.type_str = type_to_string(s, variant)
    bv.value_kind = tok.TV_INT
    bv.value_int = tag as u64
    at.Put(a, box, bv)
    ret box
end

func coerce_args_to_dyn(
    s &: Sema, a &: at.Ast, call: int, argtypes: Vector<int>, sigid: int
):
    if sigid == 0:
        ret
    end
    sg := sig_at(s, sigid)
    mut i := 0
    until i < at.ChildCount(a, call) && i < sg.params.len() && i < argtypes.len():
        pt := sg.params.get(i)[0]
        if pt >= 0 && ty_at(s, pt).kind == TY_DYN:
            arg := at.Child(a, call, i)
            nb := coerce_to_dyn(s, a, pt, arg, argtypes.get(i)[0])
            mut cn := at.Get(a, call)
            cn.list.set(i, nb)
            at.Put(a, call, cn)
        end
        i += 1
    end
end

func coerce_args_to_variant(
    s &: Sema, a &: at.Ast, call: int, argtypes: Vector<int>, sigid: int
):
    if sigid == 0:
        ret
    end
    sg := sig_at(s, sigid)
    mut i := 0
    until i < at.ChildCount(a, call) && i < sg.params.len() && i < argtypes.len():
        pt := sg.params.get(i)[0]
        att := argtypes.get(i)[0]
        if pt >= 0 && ty_at(s, pt).kind == TY_VARIANT && att >= 0 && ty_at(s, att).kind != TY_VARIANT:
            tag := type_variant_tag(s, pt, att)
            if tag >= 0:
                arg := at.Child(a, call, i)
                nb := coerce_to_variant(s, a, pt, arg, tag)
                mut cn := at.Get(a, call)
                cn.list.set(i, nb)
                at.Put(a, call, cn)
            end
        end
        i += 1
    end
end

// g_instantiate_func - like g_instantiate_struct for generic functions.
func g_instantiate_func(
    s &: Sema, a &: at.Ast, tmpl: int, targ_nodes: Vector<int>, sp: co.SrcSpan
): int:
    tn := at.Get(a, tmpl)
    if targ_nodes.len() != tn.typarams.len():
        serr(
            s, 1, sp, co.Format4(
                i18.Tr("generic '%s' expects %zu type argument%s, got %zu"), co.ArgStr(tn.name), co.ArgUint(tn.typarams.len() as u64),
                co.ArgStr(plural_suffix(tn.typarams.len())), co.ArgUint(targ_nodes.len() as u64)
            )
        )
        ret 0
    end
    mut argtypes := Vector {} as Vector<int>
    defer argtypes.free()
    repeat targ_nodes.len() with i:
        argtypes.push(sema_resolve_type(s, a, targ_nodes.get(i)[0]))
    end
    iname := g_instance_name(s, tn.name, argtypes)
    existing := scope_lookup_local(s, s.global, iname)
    if existing != 0:
        ret existing
    end
    save_lang := s.lang
    if str.Len(tn.origin_lang) > 0:
        s.lang = tn.origin_lang
    end
    g_check_bounds(s, a, tmpl, argtypes, sp)
    inst := at.Clone(a, tmpl)
    mut iv := at.Get(a, inst)
    iv.name = iname
    iv.synthetic = true
    at.Put(a, inst, iv)
    g_subst(a, inst, tn.typarams, targ_nodes)
    mut iv2 := at.Get(a, inst)
    iv2.typarams.clear()
    at.Put(a, inst, iv2)
    at.AddChild(a, s.program, inst)
    fsym := get_or_make_func(s, s.global, iname, SYM_FUNC)
    mut fv := sym_at(s, fsym)
    if fv.home == 0:
        fv.home = s.gen_pkg
    end
    sym_put(s, fsym, fv)
    fsig := build_sig(s, a, inst, 0)
    mut fv2 := sym_at(s, fsym)
    fv2.overloads.push(fsig)
    sym_put(s, fsym, fv2)
    s.pending.push(inst)
    s.lang = save_lang
    ret fsym
end

// g_unify - matches a template parameter's type NODE against a concrete
// argument type to bind type parameter `T`; TYPE_NONE = the C NULL.
func g_unify(s &: Sema, a &: at.Ast, pty: int, att: int, tname: str): int:
    if pty == 0 || att < 0:
        ret TYPE_NONE
    end
    p := at.Get(a, pty)
    if str.Len(p.name) == 0:
        ret TYPE_NONE
    end
    pn := intrinsic_type_canon(p.name)
    v := ty_at(s, att)
    if str.Equals(p.name, tname) && p.dims.len() == 0:
        if p.is_pointer:
            if v.kind == TY_PTR:
                ret v.pointee
            end
            ret TYPE_NONE
        end
        ret att
    end
    if str.Equals(pn, "Vector") && v.kind == TY_VEC && p.list.len() >= 1:
        ret g_unify(s, a, p.list.get(0)[0], v.elem, tname)
    end
    if str.Equals(pn, "HashMap") && v.kind == TY_MAP:
        mut u := TYPE_NONE
        if p.list.len() >= 1:
            u = g_unify(s, a, p.list.get(0)[0], v.key, tname)
        end
        if u < 0 && p.list.len() >= 2:
            u = g_unify(s, a, p.list.get(1)[0], v.elem, tname)
        end
        ret u
    end
    if p.list.len() > 0 && v.kind == TY_STRUCT && v.decl != 0:
        isym := sym_at(s, v.decl)
        if str.Len(isym.generic_base) > 0 && str.Equals(isym.generic_base, p.name):
            mut k := p.list.len()
            if isym.generic_args.len() < k:
                k = isym.generic_args.len()
            end
            repeat k with i:
                u2 := g_unify(
                    s, a, p.list.get(i)[0], isym.generic_args.get(i)[0], tname
                )
                if u2 >= 0:
                    ret u2
                end
            end
        end
    end
    ret TYPE_NONE
end

// g_localize_instance - re-materializes a generic instance type in the
// current global scope (used for cross-package instance return types).
func g_localize_instance(s &: Sema, a &: at.Ast, t: int, sp: co.SrcSpan): int:
    if t < 0 || ty_at(s, t).kind != TY_STRUCT || ty_at(s, t).decl == 0:
        ret t
    end
    isym := sym_at(s, ty_at(s, t).decl)
    if str.Len(isym.generic_base) == 0 || str.Len(isym.name) == 0:
        ret t
    end
    if scope_lookup_local(s, s.global, isym.name) != 0:
        ret t
    end
    tnid := new_node_at(a, at.AST_TYPE, sp)
    mut tv := at.Get(a, tnid)
    tv.name = isym.generic_base
    tv.synthetic = true
    at.Put(a, tnid, tv)
    repeat isym.generic_args.len() with i:
        at.AddChild(a, tnid, g_type_to_ast(s, a, isym.generic_args.get(i)[0], sp))
    end
    lt := sema_resolve_type(s, a, tnid)
    if lt >= 0 && ty_at(s, lt).kind == TY_STRUCT:
        ret lt
    end
    ret t
end

// g_infer_call - infers a generic function's type arguments at a call site
// and instantiates it; 0 = the C NULL.
func g_infer_call(
    s &: Sema, a &: at.Ast, tsym: int, argtypes: Vector<int>, sp: co.SrcSpan, expected: int
): int:
    tmpl := sym_at(s, tsym).decl
    tv := at.Get(a, tmpl)
    mut required := 0
    mut total := 0
    mut seen_default := false
    repeat tv.list.len() with i:
        param := at.Get(a, tv.list.get(i)[0])
        if param.kind != at.AST_PARAM:
            continue
        end
        total += 1
        if param.a != 0:
            seen_default = true
        else !seen_default:
            required += 1
        end
    end
    if argtypes.len() < required || (!tv.is_variadic && argtypes.len() > total):
        tname := sym_at(s, tsym).name
        if tv.is_variadic:
            serr(
                s, 12, sp, co.Format4(
                    i18.Tr("'%s' expects at least %zu argument%s, got %zu"), co.ArgStr(tname), co.ArgUint(required as u64),
                    co.ArgStr(plural_suffix(required)), co.ArgUint(argtypes.len() as u64)
                )
            )
        else required == total:
            serr(
                s, 12, sp, co.Format4(
                    i18.Tr("'%s' expects %zu argument%s, got %zu"), co.ArgStr(tname), co.ArgUint(total as u64),
                    co.ArgStr(plural_suffix(total)), co.ArgUint(argtypes.len() as u64)
                )
            )
        else:
            serr(
                s, 12, sp, co.Format4(
                    i18.Tr("'%s' expects %zu to %zu arguments, got %zu"), co.ArgStr(tname), co.ArgUint(required as u64),
                    co.ArgUint(total as u64), co.ArgUint(argtypes.len() as u64)
                )
            )
        end
        ret 0
    end
    mut targ_nodes := Vector {} as Vector<int>
    repeat tv.typarams.len() with t:
        tpn := tv.typarams.get(t)[0]
        mut bound := TYPE_NONE
        mut pi := 0
        until pi < tv.list.len() && pi < argtypes.len():
            p := at.Get(a, tv.list.get(pi)[0])
            if p.kind == at.AST_PARAM:
                u := g_unify(s, a, p.ty, argtypes.get(pi)[0], tpn)
                if u >= 0:
                    bound = u
                    break
                end
            end
            pi += 1
        end
        if bound < 0 && expected >= 0 && tv.ty != 0:
            bound = g_unify(s, a, tv.ty, expected, tpn)
        end
        if bound < 0:
            mut pi2 := argtypes.len()
            until pi2 < tv.list.len():
                p2 := at.Get(a, tv.list.get(pi2)[0])
                if p2.kind == at.AST_PARAM && p2.a != 0 && p2.ty != 0 && str.Equals(at.Get(a, p2.ty).name, tpn):
                    bound = sema_check_expr(s, a, p2.a)
                    if bound >= 0:
                        break
                    end
                end
                pi2 += 1
            end
        end
        if bound < 0:
            serr(
                s, 1, sp, co.Format2(
                    i18.Tr("cannot infer type parameter '%s' of generic function '%s'"), co.ArgStr(tpn),
                    co.ArgStr(tv.name)
                )
            )
            targ_nodes.free()
            ret 0
        end
        targ_nodes.push(g_type_to_ast(s, a, bound, sp))
    end
    g_result := g_instantiate_func(s, a, tmpl, targ_nodes, sp)
    targ_nodes.free()
    ret g_result
end

// ===========================================================================
// ===== sema_fold.c (5c) =====
// ===========================================================================

func fold_i64_max(): i64:
    ret 9223372036854775807
end

func fold_i64_min(): i64:
    ret (0 - 9223372036854775807) - 1
end

// lit_int - the node is an int literal whose value fits in i64.
func lit_int(a &: at.Ast, nid: int, out &: i64): bool:
    if nid == 0:
        ret false
    end
    n := at.Get(a, nid)
    if n.kind != at.AST_LITERAL || n.op != tok.TK_INT:
        ret false
    end
    u := n.value_int
    uns := str.Len(n.type_str) > 0 && (byte_at(n.type_str, 0) == 117 || str.Equals(n.type_str, "size"))
    if uns && u > fold_i64_max() as u64:
        ret false
    end
    out = u as i64
    ret true
end

func lit_flt(a &: at.Ast, nid: int, out &: f64): bool:
    if nid == 0:
        ret false
    end
    n := at.Get(a, nid)
    if n.kind != at.AST_LITERAL:
        ret false
    end
    if n.op == tok.TK_FLOAT:
        out = n.value_float
        ret true
    end
    if n.op == tok.TK_INT:
        mut v := 0 as i64
        if !lit_int(a, nid, v):
            ret false
        end
        out = v as f64
        ret true
    end
    ret false
end

func lit_bool(a &: at.Ast, nid: int, out &: bool): bool:
    if nid == 0:
        ret false
    end
    n := at.Get(a, nid)
    if n.kind != at.AST_LITERAL:
        ret false
    end
    if n.op == tok.TK_KW_TRUE:
        out = true
        ret true
    end
    if n.op == tok.TK_KW_FALSE:
        out = false
        ret true
    end
    ret false
end

func lit_str(a &: at.Ast, nid: int): bool:
    if nid == 0:
        ret false
    end
    n := at.Get(a, nid)
    ret n.kind == at.AST_LITERAL && (
        n.op == tok.TK_STRING || n.op == tok.TK_TRIPLE_STRING || n.op == tok.TK_RAW_STRING
    ) && n.value_kind == tok.TV_STRING
end

// fold_done - rewrites the node into a literal in place.
func fold_done(a &: at.Ast, nid: int, op: int):
    mut n := at.Get(a, nid)
    n.kind = at.AST_LITERAL
    n.op = op
    n.a = 0
    n.b = 0
    n.synthetic = false
    at.Put(a, nid, n)
end

func fold_int(a &: at.Ast, nid: int, v: i64):
    mut n := at.Get(a, nid)
    n.value_kind = tok.TV_INT
    n.value_int = v as u64
    at.Put(a, nid, n)
    fold_done(a, nid, tok.TK_INT)
end

func fold_flt(a &: at.Ast, nid: int, v: f64):
    mut n := at.Get(a, nid)
    n.value_kind = tok.TV_FLOAT
    n.value_float = v
    at.Put(a, nid, n)
    fold_done(a, nid, tok.TK_FLOAT)
end

func fold_bool(a &: at.Ast, nid: int, v: bool):
    mut n := at.Get(a, nid)
    n.value_kind = tok.TV_BOOL
    n.value_bool = v
    at.Put(a, nid, n)
    fold_done(a, nid, v ? tok.TK_KW_TRUE : tok.TK_KW_FALSE)
end

func add_ok(va: i64, vb: i64): bool:
    if vb > 0:
        ret va <= fold_i64_max() - vb
    end
    ret va >= fold_i64_min() - vb
end

func sub_ok(va: i64, vb: i64): bool:
    if vb > 0:
        ret va >= fold_i64_min() + vb
    end
    ret va <= fold_i64_max() + vb
end

func mul_ok(va: i64, vb: i64): bool:
    if va == 0 || vb == 0:
        ret true
    end
    if va == (0 - 1):
        ret vb != fold_i64_min()
    end
    if vb == (0 - 1):
        ret va != fold_i64_min()
    end
    if va > 0:
        if vb > 0:
            ret va <= fold_i64_max() / vb
        end
        ret vb >= fold_i64_min() / va
    end
    if vb > 0:
        ret va >= fold_i64_min() / vb
    end
    ret va >= fold_i64_max() / vb
end

// flt_finite - NaN/inf probe without giant literals: only 0, NaN and the
// infinities satisfy v*0.5 == v.
func flt_finite(v: f64): bool:
    if v != v:
        ret false
    end
    if v * 0.5 == v && v != 0.0:
        ret false
    end
    ret true
end

// fold_result_is_int - folding only happens for these decorated types.
func fold_result_is_int(a &: at.Ast, nid: int): bool:
    ts := at.Get(a, nid).type_str
    if str.Len(ts) == 0:
        ret false
    end
    ret str.Equals(ts, "i8") || str.Equals(ts, "i16") || str.Equals(ts, "i32") || str.Equals(ts, "i64") || str.Equals(ts, "u8") || str.Equals(ts, "u16") || str.Equals(ts, "u32") || str.Equals(ts, "u64") || str.Equals(ts, "char")
end

func fold_binary_int(s &: Sema, a &: at.Ast, nid: int, va: i64, vb: i64):
    op := at.Get(a, nid).op
    if op == tok.TK_PLUS:
        if fold_result_is_int(a, nid) && add_ok(va, vb):
            fold_int(a, nid, va + vb)
        end
        ret
    end
    if op == tok.TK_MINUS:
        if fold_result_is_int(a, nid) && sub_ok(va, vb):
            fold_int(a, nid, va - vb)
        end
        ret
    end
    if op == tok.TK_STAR:
        if fold_result_is_int(a, nid) && mul_ok(va, vb):
            fold_int(a, nid, va * vb)
        end
        ret
    end
    if op == tok.TK_SLASH || op == tok.TK_PERCENT:
        if vb == 0:
            serr(
                s, 21, span_of(a, nid), i18.Tr("division by zero in constant expression")
            )
            ret
        end
        if !fold_result_is_int(a, nid):
            ret
        end
        if va == fold_i64_min() && vb == (0 - 1):
            ret
        end
        fold_int(a, nid, op == tok.TK_SLASH ? va / vb : va % vb)
        ret
    end
    if op == tok.TK_EQ:
        fold_bool(a, nid, va == vb)
        ret
    end
    if op == tok.TK_NE:
        fold_bool(a, nid, va != vb)
        ret
    end
    if op == tok.TK_LT:
        fold_bool(a, nid, va < vb)
        ret
    end
    if op == tok.TK_GT:
        fold_bool(a, nid, va > vb)
        ret
    end
    if op == tok.TK_LE:
        fold_bool(a, nid, va <= vb)
        ret
    end
    if op == tok.TK_GE:
        fold_bool(a, nid, va >= vb)
        ret
    end
    if op == tok.TK_AMP:
        if fold_result_is_int(a, nid):
            fold_int(a, nid, ((va as u64) & (vb as u64)) as i64)
        end
        ret
    end
    if op == tok.TK_PIPE:
        if fold_result_is_int(a, nid):
            fold_int(a, nid, ((va as u64) | (vb as u64)) as i64)
        end
        ret
    end
    if op == tok.TK_CARET:
        if fold_result_is_int(a, nid):
            fold_int(a, nid, ((va as u64) ^ (vb as u64)) as i64)
        end
        ret
    end
    if op == tok.TK_SHL:
        if fold_result_is_int(a, nid) && vb >= 0 && vb < 64:
            fold_int(a, nid, ((va as u64) << (vb as int)) as i64)
        end
        ret
    end
    if op == tok.TK_SHR:
        if fold_result_is_int(a, nid) && vb >= 0 && vb < 64:
            fold_int(a, nid, va >> (vb as int))
        end
        ret
    end
end

func fold_binary_flt(a &: at.Ast, nid: int, fa: f64, fb: f64):
    n := at.Get(a, nid)
    op := n.op
    mut r := 0.0
    if op == tok.TK_PLUS:
        r = fa + fb
    else op == tok.TK_MINUS:
        r = fa - fb
    else op == tok.TK_STAR:
        r = fa * fb
    else op == tok.TK_SLASH:
        if fb == 0.0:
            ret
        end
        r = fa / fb
    else op == tok.TK_EQ:
        fold_bool(a, nid, fa == fb)
        ret
    else op == tok.TK_NE:
        fold_bool(a, nid, fa != fb)
        ret
    else op == tok.TK_LT:
        fold_bool(a, nid, fa < fb)
        ret
    else op == tok.TK_GT:
        fold_bool(a, nid, fa > fb)
        ret
    else op == tok.TK_LE:
        fold_bool(a, nid, fa <= fb)
        ret
    else op == tok.TK_GE:
        fold_bool(a, nid, fa >= fb)
        ret
    else:
        ret
    end
    if !flt_finite(r):
        ret
    end
    ts := n.type_str
    if !str.Equals(ts, "f32") && !str.Equals(ts, "f64"):
        ret
    end
    fold_flt(a, nid, r)
end

// FOLD_STR_REPEAT_MAX_BYTES = 1 << 20
func fold_binary_str_repeat(a &: at.Ast, nid: int, strid: int, count: i64):
    sv := at.Get(a, strid).value_str
    sl := str.Len(sv) as i64
    mut c := count
    if c < 0:
        c = 0 as i64
    end
    total := (sl as u64) * (c as u64)
    if total > 1048576 as u64:
        ret
    end
    mut n := at.Get(a, nid)
    n.value_kind = tok.TV_STRING
    n.value_str = str.Repeat(sv, c as int)
    at.Put(a, nid, n)
    fold_done(a, nid, tok.TK_STRING)
end

func fold_binary_str(a &: at.Ast, nid: int):
    n := at.Get(a, nid)
    sa := at.Get(a, n.a).value_str
    sb := at.Get(a, n.b).value_str
    mut nv := at.Get(a, nid)
    nv.value_kind = tok.TV_STRING
    nv.value_str = str.Concat(sa, sb)
    at.Put(a, nid, nv)
    fold_done(a, nid, tok.TK_STRING)
end

func fold_binary(s &: Sema, a &: at.Ast, nid: int):
    n := at.Get(a, nid)
    mut ia := 0 as i64
    mut ib := 0 as i64
    mut fa := 0.0
    mut fb := 0.0
    mut ba := false
    mut bb := false
    if n.op == tok.TK_AND || n.op == tok.TK_OR:
        if lit_bool(a, n.a, ba) && lit_bool(a, n.b, bb):
            fold_bool(a, nid, n.op == tok.TK_AND ? (ba && bb) : (ba || bb))
        end
        ret
    end
    if lit_int(a, n.a, ia) && lit_int(a, n.b, ib):
        fold_binary_int(s, a, nid, ia, ib)
        ret
    end
    if lit_flt(a, n.a, fa) && lit_flt(a, n.b, fb) && (at.Get(a, n.a).op == tok.TK_FLOAT || at.Get(a, n.b).op == tok.TK_FLOAT):
        fold_binary_flt(a, nid, fa, fb)
        ret
    end
    if lit_bool(a, n.a, ba) && lit_bool(a, n.b, bb):
        if n.op == tok.TK_EQ:
            fold_bool(a, nid, ba == bb)
        else n.op == tok.TK_NE:
            fold_bool(a, nid, ba != bb)
        end
        ret
    end
    if n.op == tok.TK_PLUS && lit_str(a, n.a) && lit_str(a, n.b) && str.Equals(n.type_str, "str"):
        fold_binary_str(a, nid)
        ret
    end
    if n.op == tok.TK_STAR && str.Equals(n.type_str, "str"):
        if lit_str(a, n.a) && lit_int(a, n.b, ia):
            fold_binary_str_repeat(a, nid, n.a, ia)
        else lit_str(a, n.b) && lit_int(a, n.a, ia):
            fold_binary_str_repeat(a, nid, n.b, ia)
        end
    end
end

func fold_unary(a &: at.Ast, nid: int):
    n := at.Get(a, nid)
    mut iv := 0 as i64
    mut bv := false
    if n.op == tok.TK_MINUS:
        if lit_int(a, n.a, iv) && iv != fold_i64_min() && fold_result_is_int(a, nid):
            fold_int(a, nid, 0 - iv)
            ret
        end
        if n.a != 0:
            an := at.Get(a, n.a)
            if an.kind == at.AST_LITERAL && an.op == tok.TK_FLOAT:
                fold_flt(a, nid, 0.0 - an.value_float)
            end
        end
        ret
    end
    if n.op == tok.TK_NOT && lit_bool(a, n.a, bv):
        fold_bool(a, nid, !bv)
    end
    if n.op == tok.TK_TILDE && lit_int(a, n.a, iv) && fold_result_is_int(a, nid):
        fold_int(a, nid, (~(iv as u64)) as i64)
    end
end

// sema_fold_expr - compile-time constant folding entry point.
func sema_fold_expr(s &: Sema, a &: at.Ast, nid: int):
    if nid == 0:
        ret
    end
    k := at.KindOf(a, nid)
    if k == at.AST_BINARY:
        fold_binary(s, a, nid)
    else k == at.AST_UNARY:
        fold_unary(a, nid)
    end
end

// ===== constant-expression evaluation =====
//
// sema_fold_expr above rewrites a node into a literal, and it only fires
// when the operands already *are* literals. That is enough for `1 > 2` but
// it stops at a named `const`, so the dead-branch checks that read the
// folded node saw an identifier and gave up. sema_const_eval answers the
// same question without rewriting anything: it walks the expression, looks
// consts up in the scope chain, and evaluates their initializers too.
//
// It is a query, so it reports nothing and marks nothing used - a check
// that merely asks whether a loop is dead must not change what else the
// program diagnoses.
//
// Soundness rule: every arithmetic result must fit the node's own type, or
// the answer is "unknown". A u8 expression that wraps at run time is not
// folded here, because saying "always false" about a wrapped value that is
// actually true would turn a diagnostic into a false accusation. Missing a
// dead loop is fine; inventing one is not.

// The CV_* kinds and ConstVal live with the other constants and structs at
// the top of the file (Salam wants them declared before any function).
// CONST_EVAL_MAX_DEPTH = 32

func cv_type_str(a &: at.Ast, nid: int): str:
    n := at.Get(a, nid)
    if str.Len(n.type_str) > 0:
        ret n.type_str
    end
    if n.ty != 0:
        ret at.Get(a, n.ty).name
    end
    ret ""
end

// cv_int_range - the value range of an integer type_str. u64/size are
// capped at i64 max because lit_int already refuses anything above it.
func cv_int_range(ts: str, lo &: i64, hi &: i64): bool:
    if str.Equals(ts, "i8"):
        lo = 0 - 128
        hi = 127 as i64
        ret true
    end
    if str.Equals(ts, "i16"):
        lo = 0 - 32768
        hi = 32767 as i64
        ret true
    end
    if str.Equals(ts, "i32"):
        lo = 0 - 2147483648
        hi = 2147483647 as i64
        ret true
    end
    if str.Equals(ts, "i64"):
        lo = fold_i64_min()
        hi = fold_i64_max()
        ret true
    end
    if str.Equals(ts, "u8"):
        lo = 0 as i64
        hi = 255 as i64
        ret true
    end
    if str.Equals(ts, "u16"):
        lo = 0 as i64
        hi = 65535 as i64
        ret true
    end
    if str.Equals(ts, "u32"):
        lo = 0 as i64
        hi = 4294967295 as i64
        ret true
    end
    if str.Equals(ts, "u64") || str.Equals(ts, "size"):
        lo = 0 as i64
        hi = fold_i64_max()
        ret true
    end
    ret false
end

func cv_fits(ts: str, v: i64): bool:
    mut lo := 0 as i64
    mut hi := 0 as i64
    if !cv_int_range(ts, lo, hi):
        ret false
    end
    ret v >= lo && v <= hi
end

func cv_is_float_ts(ts: str): bool:
    ret str.Equals(ts, "f64")
end

func cv_as_flt(v &: ConstVal): f64:
    if v.kind == CV_FLOAT:
        ret v.f
    end
    ret v.i as f64
end

func cv_set_int(out &: ConstVal, v: i64):
    out.kind = CV_INT
    out.i = v
    out.f = 0.0
    out.b = false
end

func cv_set_flt(out &: ConstVal, v: f64):
    out.kind = CV_FLOAT
    out.i = 0 as i64
    out.f = v
    out.b = false
end

func cv_set_bool(out &: ConstVal, v: bool):
    out.kind = CV_BOOL
    out.i = 0 as i64
    out.f = 0.0
    out.b = v
end

func const_binary_int(
    a &: at.Ast, nid: int, va: i64, vb: i64, out &: ConstVal
): bool:
    op := at.Get(a, nid).op
    mut r := 0 as i64
    if op == tok.TK_EQ:
        cv_set_bool(out, va == vb)
        ret true
    else op == tok.TK_NE:
        cv_set_bool(out, va != vb)
        ret true
    else op == tok.TK_LT:
        cv_set_bool(out, va < vb)
        ret true
    else op == tok.TK_GT:
        cv_set_bool(out, va > vb)
        ret true
    else op == tok.TK_LE:
        cv_set_bool(out, va <= vb)
        ret true
    else op == tok.TK_GE:
        cv_set_bool(out, va >= vb)
        ret true
    else op == tok.TK_PLUS:
        if !add_ok(va, vb):
            ret false
        end
        r = va + vb
    else op == tok.TK_MINUS:
        if !sub_ok(va, vb):
            ret false
        end
        r = va - vb
    else op == tok.TK_STAR:
        if !mul_ok(va, vb):
            ret false
        end
        r = va * vb
    else op == tok.TK_SLASH || op == tok.TK_PERCENT:
        if vb == 0 as i64 || (va == fold_i64_min() && vb == (0 - 1)):
            ret false
        end
        r = op == tok.TK_SLASH ? va / vb : va % vb
    else op == tok.TK_AMP:
        r = ((va as u64) & (vb as u64)) as i64
    else op == tok.TK_PIPE:
        r = ((va as u64) | (vb as u64)) as i64
    else op == tok.TK_CARET:
        r = ((va as u64) ^ (vb as u64)) as i64
    else op == tok.TK_SHL:
        if vb < 0 as i64 || vb >= 64 as i64:
            ret false
        end
        r = ((va as u64) << (vb as int)) as i64
    else op == tok.TK_SHR:
        if vb < 0 as i64 || vb >= 64 as i64:
            ret false
        end
        r = va >> (vb as int)
    else:
        ret false
    end
    if !cv_fits(cv_type_str(a, nid), r):
        ret false
    end
    cv_set_int(out, r)
    ret true
end

func const_binary_flt(
    a &: at.Ast, nid: int, fa: f64, fb: f64, out &: ConstVal
): bool:
    op := at.Get(a, nid).op
    mut r := 0.0
    if op == tok.TK_EQ:
        cv_set_bool(out, fa == fb)
        ret true
    else op == tok.TK_NE:
        cv_set_bool(out, fa != fb)
        ret true
    else op == tok.TK_LT:
        cv_set_bool(out, fa < fb)
        ret true
    else op == tok.TK_GT:
        cv_set_bool(out, fa > fb)
        ret true
    else op == tok.TK_LE:
        cv_set_bool(out, fa <= fb)
        ret true
    else op == tok.TK_GE:
        cv_set_bool(out, fa >= fb)
        ret true
    else op == tok.TK_PLUS:
        r = fa + fb
    else op == tok.TK_MINUS:
        r = fa - fb
    else op == tok.TK_STAR:
        r = fa * fb
    else op == tok.TK_SLASH:
        if fb == 0.0:
            ret false
        end
        r = fa / fb
    else:
        ret false
    end
    // f32 arithmetic rounds narrower than this f64 math, so only f64
    // results are exact enough to claim as constants.
    if !flt_finite(r) || !cv_is_float_ts(cv_type_str(a, nid)):
        ret false
    end
    cv_set_flt(out, r)
    ret true
end

func const_binary(
    s &: Sema, a &: at.Ast, nid: int, out &: ConstVal, depth: int
): bool:
    n := at.Get(a, nid)
    mut va := ConstVal {}
    mut vb := ConstVal {}
    if n.a == 0 || n.b == 0:
        ret false
    end
    // Short-circuit: `false && f()` is false however unknown f() is.
    if n.op == tok.TK_AND || n.op == tok.TK_OR:
        if !const_eval(s, a, n.a, va, depth) || va.kind != CV_BOOL:
            ret false
        end
        if n.op == tok.TK_AND && !va.b:
            cv_set_bool(out, false)
            ret true
        end
        if n.op == tok.TK_OR && va.b:
            cv_set_bool(out, true)
            ret true
        end
        if !const_eval(s, a, n.b, vb, depth) || vb.kind != CV_BOOL:
            ret false
        end
        cv_set_bool(out, vb.b)
        ret true
    end
    if !const_eval(s, a, n.a, va, depth) || !const_eval(s, a, n.b, vb, depth):
        ret false
    end
    if va.kind == CV_BOOL || vb.kind == CV_BOOL:
        if va.kind != CV_BOOL || vb.kind != CV_BOOL:
            ret false
        end
        if n.op == tok.TK_EQ:
            cv_set_bool(out, va.b == vb.b)
            ret true
        end
        if n.op == tok.TK_NE:
            cv_set_bool(out, va.b != vb.b)
            ret true
        end
        ret false
    end
    if va.kind == CV_INT && vb.kind == CV_INT:
        ret const_binary_int(a, nid, va.i, vb.i, out)
    end
    ret const_binary_flt(a, nid, cv_as_flt(va), cv_as_flt(vb), out)
end

func const_unary(
    s &: Sema, a &: at.Ast, nid: int, out &: ConstVal, depth: int
): bool:
    n := at.Get(a, nid)
    mut v := ConstVal {}
    if n.a == 0 || !const_eval(s, a, n.a, v, depth):
        ret false
    end
    if n.op == tok.TK_NOT:
        if v.kind != CV_BOOL:
            ret false
        end
        cv_set_bool(out, !v.b)
        ret true
    end
    if n.op == tok.TK_MINUS:
        if v.kind == CV_FLOAT:
            cv_set_flt(out, 0.0 - v.f)
            ret true
        end
        if v.kind != CV_INT || v.i == fold_i64_min():
            ret false
        end
        if !cv_fits(cv_type_str(a, nid), 0 - v.i):
            ret false
        end
        cv_set_int(out, 0 - v.i)
        ret true
    end
    if n.op == tok.TK_TILDE:
        if v.kind != CV_INT:
            ret false
        end
        r := (~(v.i as u64)) as i64
        if !cv_fits(cv_type_str(a, nid), r):
            ret false
        end
        cv_set_int(out, r)
        ret true
    end
    ret false
end

func const_cast(
    s &: Sema, a &: at.Ast, nid: int, out &: ConstVal, depth: int
): bool:
    n := at.Get(a, nid)
    mut v := ConstVal {}
    if n.a == 0 || !const_eval(s, a, n.a, v, depth):
        ret false
    end
    ts := cv_type_str(a, nid)
    if str.Len(ts) == 0:
        ret false
    end
    if str.Equals(ts, "bool"):
        if v.kind != CV_BOOL:
            ret false
        end
        cv_set_bool(out, v.b)
        ret true
    end
    if cv_is_float_ts(ts):
        if v.kind == CV_BOOL:
            ret false
        end
        cv_set_flt(out, cv_as_flt(v))
        ret true
    end
    if v.kind == CV_BOOL:
        ret false
    end
    if v.kind == CV_FLOAT:
        // A cast that would wrap or round is not a value we can claim.
        if v.f != ((v.f as i64) as f64):
            ret false
        end
        if !cv_fits(ts, v.f as i64):
            ret false
        end
        cv_set_int(out, v.f as i64)
        ret true
    end
    if !cv_fits(ts, v.i):
        ret false
    end
    cv_set_int(out, v.i)
    ret true
end

// const_eval_sym - the value a `const` binding was declared with.
func const_eval_sym(
    s &: Sema, a &: at.Ast, symid: int, out &: ConstVal, depth: int
): bool:
    if symid == 0:
        ret false
    end
    sv := sym_at(s, symid)
    if sv.kind != SYM_CONST || sv.is_mut:
        ret false
    end
    if sv.decl != 0:
        init := at.Get(a, sv.decl).a
        if init != 0 && const_eval(s, a, init, out, depth):
            ret true
        end
    end
    if sv.has_ival:
        cv_set_int(out, sv.ival)
        ret true
    end
    ret false
end

// const_eval_member - a `pkg.NAME` reference to an exported const.
func const_eval_member(
    s &: Sema, a &: at.Ast, nid: int, out &: ConstVal, depth: int
): bool:
    n := at.Get(a, nid)
    if n.a == 0 || at.KindOf(a, n.a) != at.AST_IDENTIFIER || str.Len(n.name) == 0:
        ret false
    end
    pk := scope_lookup(s, s.cur, at.Get(a, n.a).name)
    if pk == 0:
        ret false
    end
    pkv := sym_at(s, pk)
    if pkv.kind != SYM_PACKAGE || pkv.members == 0:
        ret false
    end
    cs := scope_lookup_local(s, pkv.members, n.name)
    if cs == 0 || !sym_at(s, cs).is_pub:
        ret false
    end
    ret const_eval_sym(s, a, cs, out, depth)
end

func const_eval(
    s &: Sema, a &: at.Ast, nid: int, out &: ConstVal, depth: int
): bool:
    if nid == 0 || depth >= 32:
        ret false
    end
    d := depth + 1
    k := at.KindOf(a, nid)
    if k == at.AST_LITERAL:
        n := at.Get(a, nid)
        if n.op == tok.TK_KW_TRUE:
            cv_set_bool(out, true)
            ret true
        end
        if n.op == tok.TK_KW_FALSE:
            cv_set_bool(out, false)
            ret true
        end
        if n.op == tok.TK_INT:
            mut v := 0 as i64
            if !lit_int(a, nid, v):
                ret false
            end
            cv_set_int(out, v)
            ret true
        end
        if n.op == tok.TK_FLOAT:
            cv_set_flt(out, n.value_float)
            ret true
        end
        ret false
    end
    if k == at.AST_IDENTIFIER:
        ret const_eval_sym(s, a, scope_lookup(s, s.cur, at.Get(a, nid).name), out, d)
    end
    if k == at.AST_MEMBER:
        ret const_eval_member(s, a, nid, out, d)
    end
    if k == at.AST_UNARY:
        ret const_unary(s, a, nid, out, d)
    end
    if k == at.AST_BINARY:
        ret const_binary(s, a, nid, out, d)
    end
    if k == at.AST_CAST:
        ret const_cast(s, a, nid, out, d)
    end
    if k == at.AST_TERNARY:
        n2 := at.Get(a, nid)
        mut c := ConstVal {}
        if !const_eval(s, a, n2.a, c, d) || c.kind != CV_BOOL:
            ret false
        end
        ret const_eval(s, a, c.b ? n2.b : n2.c, out, d)
    end
    ret false
end

// sema_const_eval - the compile-time value of an expression, if it has one.
func sema_const_eval(s &: Sema, a &: at.Ast, nid: int, out &: ConstVal): bool:
    ret const_eval(s, a, nid, out, 0)
end

// sema_const_bool - the same, narrowed to a bool condition.
func sema_const_bool(s &: Sema, a &: at.Ast, nid: int, out &: bool): bool:
    mut v := ConstVal {}
    if !const_eval(s, a, nid, v, 0) || v.kind != CV_BOOL:
        ret false
    end
    out = v.b
    ret true
end

// ===========================================================================
// ===== sema_expr.c (5c) =====
// ===========================================================================

func tk_is_arith(k: int): bool:
    ret k == tok.TK_PLUS || k == tok.TK_MINUS || k == tok.TK_STAR || k == tok.TK_SLASH || k == tok.TK_PERCENT
end

// sema_tk_is_bitwise (shared with 5d's sema_stmt).
func sema_tk_is_bitwise(k: int): bool:
    ret k == tok.TK_AMP || k == tok.TK_PIPE || k == tok.TK_CARET || k == tok.TK_SHL || k == tok.TK_SHR
end

func int_lit_fits(u: u64, k: int): bool:
    if k == TY_I8:
        ret u <= 127 as u64
    end
    if k == TY_I16:
        ret u <= 32767 as u64
    end
    if k == TY_I32:
        ret u <= 2147483647 as u64
    end
    if k == TY_I64:
        ret u <= 9223372036854775807 as u64
    end
    if k == TY_U8:
        ret u <= 255 as u64
    end
    if k == TY_U16:
        ret u <= 65535 as u64
    end
    if k == TY_U32:
        ret u <= 4294967295 as u64
    end
    if k == TY_U64 || k == TY_SIZE:
        ret true
    end
    ret false
end

// sema_type_is_stringable - `+`-concatenation operand rule.
func sema_type_is_stringable(s &: Sema, t: int): bool:
    k := ty_at(s, t).kind
    ret k == TY_STR || k == TY_UCHAR || k == TY_BOOL || k == TY_CHAR || type_is_numeric(s, t)
end

func tk_is_cmp(k: int): bool:
    ret k == tok.TK_LT || k == tok.TK_GT || k == tok.TK_LE || k == tok.TK_GE
end

func tk_is_eq(k: int): bool:
    ret k == tok.TK_EQ || k == tok.TK_NE
end

// sema_op_method - "" = the C NULL (no operator method for this token).
func sema_op_method(k: int): str:
    if k == tok.TK_PLUS:
        ret "operator_add"
    end
    if k == tok.TK_MINUS:
        ret "operator_sub"
    end
    if k == tok.TK_STAR:
        ret "operator_mul"
    end
    if k == tok.TK_SLASH:
        ret "operator_div"
    end
    if k == tok.TK_PERCENT:
        ret "operator_mod"
    end
    if k == tok.TK_POWER:
        ret "operator_pow"
    end
    if k == tok.TK_EQ:
        ret "operator_eq"
    end
    if k == tok.TK_NE:
        ret "operator_ne"
    end
    if k == tok.TK_LT:
        ret "operator_lt"
    end
    if k == tok.TK_GT:
        ret "operator_gt"
    end
    if k == tok.TK_LE:
        ret "operator_le"
    end
    if k == tok.TK_GE:
        ret "operator_ge"
    end
    ret ""
end

// sema_compound_base - TK_EOF = the C "not a compound assignment".
func sema_compound_base(k: int): int:
    if k == tok.TK_PLUS_EQ:
        ret tok.TK_PLUS
    end
    if k == tok.TK_MINUS_EQ:
        ret tok.TK_MINUS
    end
    if k == tok.TK_STAR_EQ:
        ret tok.TK_STAR
    end
    if k == tok.TK_SLASH_EQ:
        ret tok.TK_SLASH
    end
    if k == tok.TK_PERCENT_EQ:
        ret tok.TK_PERCENT
    end
    if k == tok.TK_POWER_EQ:
        ret tok.TK_POWER
    end
    if k == tok.TK_AMP_EQ:
        ret tok.TK_AMP
    end
    if k == tok.TK_PIPE_EQ:
        ret tok.TK_PIPE
    end
    if k == tok.TK_CARET_EQ:
        ret tok.TK_CARET
    end
    if k == tok.TK_SHL_EQ:
        ret tok.TK_SHL
    end
    if k == tok.TK_SHR_EQ:
        ret tok.TK_SHR
    end
    ret tok.TK_EOF
end

// sema_try_op_overload - TYPE_NONE = the C NULL (no such operator method);
// rhs_type TYPE_NONE = unary (no argument pushed).
func sema_try_op_overload(
    s &: Sema, a &: at.Ast, n: int, ssym: int, mname: str, rhs_type: int
): int:
    m := scope_lookup_local(s, sym_at(s, ssym).members, mname)
    if m == 0 || sym_at(s, m).kind != SYM_METHOD:
        ret TYPE_NONE
    end
    mut otys := Vector {} as Vector<int>
    defer otys.free()
    if rhs_type != TYPE_NONE:
        otys.push(rhs_type)
    end
    sig := resolve_overload(s, a, m, otys, span_of(a, n), mname)
    if sig == 0:
        ret TYPE_NONE
    end
    ret sig_at(s, sig).ret_type
end

func is_int_lit(a &: at.Ast, nid: int): bool:
    if nid == 0:
        ret false
    end
    n := at.Get(a, nid)
    ret n.kind == at.AST_LITERAL && n.op == tok.TK_INT
end

func check_binary(s &: Sema, a &: at.Ast, nid: int): int:
    n := at.Get(a, nid)
    sp := span_of(a, nid)
    l_lit := is_int_lit(a, n.a)
    r_lit := is_int_lit(a, n.b)
    mut l := TYPE_NONE
    mut r := TYPE_NONE
    if r_lit && !l_lit:
        l = sema_check_expr(s, a, n.a)
        if type_is_integer(s, l):
            s.expected = l
        end
        r = sema_check_expr(s, a, n.b)
    else l_lit && !r_lit:
        r = sema_check_expr(s, a, n.b)
        if type_is_integer(s, r):
            s.expected = r
        end
        l = sema_check_expr(s, a, n.a)
    else:
        l = sema_check_expr(s, a, n.a)
        r = sema_check_expr(s, a, n.b)
    end
    op := n.op
    if type_is_error(s, l) || type_is_error(s, r):
        ret sema_decorate(s, a, nid, sema_err_ty(s))
    end

    ssym := struct_sym_of(s, l)
    if ssym != 0:
        if op == tok.TK_NE:
            m_ne := scope_lookup_local(s, sym_at(s, ssym).members, "operator_ne")
            mut ne_is_method := m_ne != 0
            if ne_is_method && sym_at(s, m_ne).kind != SYM_METHOD:
                ne_is_method = false
            end
            if !ne_is_method:
                ov := sema_try_op_overload(s, a, nid, ssym, "operator_eq", r)
                if ov != TYPE_NONE:
                    mut nv := at.Get(a, nid)
                    nv.synthetic = true
                    at.Put(a, nid, nv)
                    ret sema_decorate(s, a, nid, sema_ty(s, TY_BOOL))
                end
            end
        end
        mname := sema_op_method(op)
        if str.Len(mname) > 0:
            ov2 := sema_try_op_overload(s, a, nid, ssym, mname, r)
            if ov2 != TYPE_NONE:
                ret sema_decorate(s, a, nid, ov2)
            end
        end
    end
    if op == tok.TK_POWER:
        if !type_is_numeric(s, l) || !type_is_numeric(s, r):
            serr(s, 21, sp, i18.Tr("operator '**' requires numeric operands"))
        end
        ret sema_decorate(s, a, nid, sema_ty(s, TY_F64))
    end
    if op == tok.TK_AND || op == tok.TK_OR:
        if ty_at(s, l).kind != TY_BOOL || ty_at(s, r).kind != TY_BOOL:
            serr(s, 21, sp, i18.Tr("logical operator requires bool operands"))
        end
        ret sema_decorate(s, a, nid, sema_ty(s, TY_BOOL))
    end
    if tk_is_arith(op):
        lk := ty_at(s, l).kind
        rk := ty_at(s, r).kind
        if op == tok.TK_PLUS && (
            lk == TY_STR || rk == TY_STR || lk == TY_UCHAR || rk == TY_UCHAR
        ):
            if sema_type_is_stringable(s, l) && sema_type_is_stringable(s, r):
                ret sema_decorate(s, a, nid, sema_ty(s, TY_STR))
            end
            serr(
                s, 21, sp, co.Format2(
                    i18.Tr("operator '+' on a string requires the other operand to be a string, number, bool, or char (got '%s' and '%s')"),
                    co.ArgStr(type_to_string(s, l)), co.ArgStr(type_to_string(s, r))
                )
            )
            ret sema_decorate(s, a, nid, sema_err_ty(s))
        end
        if op == tok.TK_STAR && (lk == TY_STR || rk == TY_STR):
            if (lk == TY_STR && type_is_integer(s, r)) || (rk == TY_STR && type_is_integer(s, l)):
                ret sema_decorate(s, a, nid, sema_ty(s, TY_STR))
            end
            serr(
                s, 21, sp, co.Format2(
                    i18.Tr("operator '*' on a string requires the other operand to be an integer (got '%s' and '%s')"),
                    co.ArgStr(type_to_string(s, l)), co.ArgStr(type_to_string(s, r))
                )
            )
            ret sema_decorate(s, a, nid, sema_err_ty(s))
        end
        c := type_common_arith(s, l, r)
        if c < 0:
            serr(
                s, 21, sp, co.Format2(
                    i18.Tr("operator cannot be applied to '%s' and '%s'"), co.ArgStr(type_to_string(s, l)),
                    co.ArgStr(type_to_string(s, r))
                )
            )
            ret sema_decorate(s, a, nid, sema_err_ty(s))
        end
        if op == tok.TK_PERCENT && !type_is_integer(s, c):
            serr(
                s, 21, sp, co.Format0(i18.Tr("operator '%%' requires integer operands"))
            )
        end
        ret sema_decorate(s, a, nid, c)
    end
    if sema_tk_is_bitwise(op):
        if !type_is_integer(s, l) || !type_is_integer(s, r):
            serr(
                s, 21, sp, co.Format2(
                    i18.Tr("bitwise operator requires integer operands (got '%s' and '%s')"), co.ArgStr(type_to_string(s, l)),
                    co.ArgStr(type_to_string(s, r))
                )
            )
            ret sema_decorate(s, a, nid, sema_err_ty(s))
        end
        // Shifts keep the left operand's (promoted) type; the other bitwise
        // operators take the common integer type of both operands.
        if op == tok.TK_SHL || op == tok.TK_SHR:
            lt := type_common_arith(s, l, l)
            ret sema_decorate(s, a, nid, lt >= 0 ? lt : l)
        end
        c2 := type_common_arith(s, l, r)
        if c2 < 0 || !type_is_integer(s, c2):
            serr(
                s, 21, sp, co.Format2(
                    i18.Tr("bitwise operator cannot be applied to '%s' and '%s'"), co.ArgStr(type_to_string(s, l)),
                    co.ArgStr(type_to_string(s, r))
                )
            )
            ret sema_decorate(s, a, nid, sema_err_ty(s))
        end
        ret sema_decorate(s, a, nid, c2)
    end
    if tk_is_cmp(op) || tk_is_eq(op):
        mut cok := false
        if type_is_numeric(s, l) && type_is_numeric(s, r) && type_common_arith(s, l, r) >= 0:
            cok = true
        else type_equiv(s, l, r):
            cok = true
        else tk_is_eq(op) && (
            (ty_at(s, l).kind == TY_NULL && ty_at(s, r).kind == TY_PTR) || (ty_at(s, r).kind == TY_NULL && ty_at(s, l).kind == TY_PTR)
        ):
            cok = true
        end
        if !cok:
            serr(
                s, 21, sp, co.Format2(
                    i18.Tr("cannot compare '%s' and '%s'"), co.ArgStr(type_to_string(s, l)), co.ArgStr(type_to_string(s, r))
                )
            )
        end
        ret sema_decorate(s, a, nid, sema_ty(s, TY_BOOL))
    end
    ret sema_decorate(s, a, nid, sema_err_ty(s))
end

func check_ternary(s &: Sema, a &: at.Ast, nid: int): int:
    n := at.Get(a, nid)
    exp := s.expected
    s.expected = TYPE_NONE
    c := sema_check_expr(s, a, n.a)
    if ty_at(s, c).kind != TY_BOOL && !type_is_error(s, c):
        serr(
            s, 21, span_of(a, n.a), co.Format1(
                i18.Tr("'?:' condition must be bool, got '%s'"), co.ArgStr(type_to_string(s, c))
            )
        )
    end
    t_lit := is_int_lit(a, n.b)
    f_lit := is_int_lit(a, n.c)
    mut tt := TYPE_NONE
    mut tf := TYPE_NONE
    if f_lit && !t_lit:
        s.expected = exp
        tt = sema_check_expr(s, a, n.b)
        s.expected = type_is_integer(s, tt) ? tt : exp
        tf = sema_check_expr(s, a, n.c)
    else t_lit && !f_lit:
        s.expected = exp
        tf = sema_check_expr(s, a, n.c)
        s.expected = type_is_integer(s, tf) ? tf : exp
        tt = sema_check_expr(s, a, n.b)
    else:
        s.expected = exp
        tt = sema_check_expr(s, a, n.b)
        s.expected = exp
        tf = sema_check_expr(s, a, n.c)
    end
    s.expected = TYPE_NONE
    if type_is_error(s, tt) || type_is_error(s, tf):
        ret sema_decorate(s, a, nid, sema_err_ty(s))
    end
    if type_equiv(s, tt, tf):
        ret sema_decorate(s, a, nid, tt)
    end
    if type_is_numeric(s, tt) && type_is_numeric(s, tf):
        common := type_common_arith(s, tt, tf)
        if common >= 0:
            ret sema_decorate(s, a, nid, common)
        end
    end
    if ty_at(s, tt).kind == TY_NULL && ty_at(s, tf).kind == TY_PTR:
        ret sema_decorate(s, a, nid, tf)
    end
    if ty_at(s, tf).kind == TY_NULL && ty_at(s, tt).kind == TY_PTR:
        ret sema_decorate(s, a, nid, tt)
    end
    serr(
        s, 21, span_of(a, nid), co.Format2(
            i18.Tr("'?:' branches have mismatched types '%s' and '%s'"), co.ArgStr(type_to_string(s, tt)),
            co.ArgStr(type_to_string(s, tf))
        )
    )
    ret sema_decorate(s, a, nid, sema_err_ty(s))
end

func check_member(s &: Sema, a &: at.Ast, nid: int): int:
    n := at.Get(a, nid)
    sp := span_of(a, nid)
    if n.a != 0 && at.KindOf(a, n.a) == at.AST_IDENTIFIER:
        pk := scope_lookup(s, s.cur, at.Get(a, n.a).name)
        if pk != 0 && sym_at(s, pk).kind == SYM_PACKAGE:
            mname := pkg_member_canon(s, a, pk, n.name, sp)
            at.SetName(a, nid, mname)
            pkv := sym_at(s, pk)
            m := scope_lookup_local(s, pkv.members, mname)
            if m == 0:
                serr(
                    s, 16, sp, co.Format2(
                        i18.Tr("package '%s' has no exported member '%s'"), co.ArgStr(pkv.name), co.ArgStr(mname)
                    )
                )
                ret sema_decorate(s, a, nid, sema_err_ty(s))
            end
            mv := sym_at(s, m)
            if !mv.is_pub:
                serr(
                    s, 17, sp, co.Format2(
                        i18.Tr("'%s' is not exported by package '%s' (mark it 'pub')"), co.ArgStr(mname),
                        co.ArgStr(pkv.name)
                    )
                )
                ret sema_decorate(s, a, nid, sema_err_ty(s))
            end
            if mv.kind == SYM_FUNC:
                serr(
                    s, 17, sp, co.Format2(
                        i18.Tr("function '%s.%s' used as a value (call it)"), co.ArgStr(pkv.name), co.ArgStr(mname)
                    )
                )
                ret sema_decorate(s, a, nid, sema_err_ty(s))
            end
            _da := sema_decorate(s, a, n.a, pkv.ty)
            ret sema_decorate(s, a, nid, mv.ty)
        end
    end

    if n.a != 0 && at.KindOf(a, n.a) == at.AST_IDENTIFIER:
        sy := scope_lookup(s, s.cur, at.Get(a, n.a).name)
        if sy != 0 && sym_at(s, sy).kind == SYM_ENUM:
            syv := sym_at(s, sy)
            _de := sema_decorate(s, a, n.a, syv.ty)
            mut m2 := 0
            if syv.members != 0:
                m2 = scope_lookup_local(s, syv.members, n.name)
            end
            if m2 == 0:
                serr(
                    s, 16, sp, co.Format2(
                        i18.Tr("enum '%s' has no member '%s'"), co.ArgStr(syv.name), co.ArgStr(n.name)
                    )
                )
            end
            ret sema_decorate(s, a, nid, syv.ty)
        end
    end
    objt := sema_check_expr(s, a, n.a)
    if type_is_error(s, objt):
        ret sema_decorate(s, a, nid, sema_err_ty(s))
    end
    ssym := struct_sym_of(s, objt)
    if ssym == 0:
        serr(
            s, 29, sp, co.Format1(
                i18.Tr("member access on non-struct type '%s'"), co.ArgStr(type_to_string(s, objt))
            )
        )
        ret sema_decorate(s, a, nid, sema_err_ty(s))
    end
    ssv := sym_at(s, ssym)
    fname := scope_member_canon(s, a, ssv.members, n.name, sp)
    at.SetName(a, nid, fname)
    f := scope_lookup_local(s, ssv.members, fname)
    if f == 0:
        serr(
            s, 16, sp, co.Format2(
                i18.Tr("no field '%s' in struct '%s'"), co.ArgStr(fname), co.ArgStr(ssv.name)
            )
        )
        ret sema_decorate(s, a, nid, sema_err_ty(s))
    end
    fv := sym_at(s, f)
    if fv.kind == SYM_METHOD:
        serr(
            s, 17, sp, co.Format1(
                i18.Tr("method '%s' used as a value (call it)"), co.ArgStr(fname)
            )
        )
        ret sema_decorate(s, a, nid, sema_err_ty(s))
    end
    if !fv.is_pub && struct_sym_of(s, s.self_type) != ssym:
        serr(
            s, 17, sp, co.Format2(
                i18.Tr("field '%s' is private in struct '%s' (mark it 'pub')"), co.ArgStr(fname), co.ArgStr(ssv.name)
            )
        )
    end
    ret sema_decorate(s, a, nid, fv.ty)
end

// ===========================================================================
// ===== sema_stmt.c (5c slice): lvalue classification + pure-write check =====
// (Ported here because AST_INCDEC needs them; 5d's statement checker reuses
// these - do NOT port them again.)
// ===========================================================================

// analyze_lvalue (lvalue_info_t flattened into three out-params).
func analyze_lvalue(
    s &: Sema, a &: at.Ast, nid: int, is_lv &: bool, is_proj &: bool, root &: int
):
    if nid == 0:
        ret
    end
    n := at.Get(a, nid)
    if n.kind == at.AST_IDENTIFIER:
        symid := scope_lookup(s, s.cur, n.name)
        if symid == 0:
            ret
        end
        is_lv = true
        root = symid
        ret
    end
    if n.kind == at.AST_THIS:
        is_lv = true
        ret
    end
    if n.kind == at.AST_MEMBER || n.kind == at.AST_INDEX:
        analyze_lvalue(s, a, n.a, is_lv, is_proj, root)
        if is_lv:
            is_proj = true
        end
    end
end

// sema_classify_write - LV_* verdict; also marks mutated roots like the C.
func sema_classify_write(s &: Sema, a &: at.Ast, nid: int, root_out &: int): int:
    mut is_lv := false
    mut is_proj := false
    mut root := 0
    analyze_lvalue(s, a, nid, is_lv, is_proj, root)
    root_out = root
    if !is_lv:
        ret LV_NOT_LVALUE
    end
    if root != 0 && sym_at(s, root).kind == SYM_CONST:
        ret LV_CONST
    end
    if is_proj:
        if root != 0:
            mut rv := sym_at(s, root)
            if rv.is_mut || rv.is_ref:
                rv.mutated = true
                sym_put(s, root, rv)
            end
        end
        ret LV_OK
    end
    if root == 0:
        ret LV_OK
    end
    mut rv2 := sym_at(s, root)
    if rv2.is_mut || rv2.is_ref:
        rv2.mutated = true
        sym_put(s, root, rv2)
        ret LV_OK
    end
    ret LV_IMMUTABLE
end

func pure_param_escapes(s &: Sema, t: int): bool:
    if t < 0:
        ret false
    end
    k := ty_at(s, t).kind
    ret k == TY_PTR || k == TY_VEC || k == TY_MAP || k == TY_SLICE
end

// sema_check_pure_write - E013 diagnostics for writes inside `pure` funcs.
func sema_check_pure_write(s &: Sema, a &: at.Ast, target: int, sp: co.SrcSpan):
    fn := sema_pure_fn(s, a)
    if fn == 0:
        ret
    end
    mut root := target
    mut below := 0
    until root != 0 && (
        at.KindOf(a, root) == at.AST_MEMBER || at.KindOf(a, root) == at.AST_INDEX
    ):
        below = root
        root = at.Get(a, root).a
    end
    if root == 0 || at.KindOf(a, root) != at.AST_IDENTIFIER:
        ret
    end
    rname := at.Get(a, root).name
    if str.Len(rname) == 0:
        ret
    end
    mut where := 0
    symid := scope_lookup_where(s, s.cur, rname, where)
    if symid == 0:
        ret
    end
    sv := sym_at(s, symid)
    fname := at.Get(a, fn).name
    if sv.kind == SYM_PACKAGE && below != 0 && at.KindOf(a, below) == at.AST_MEMBER:
        bname := at.Get(a, below).name
        serr(
            s, 13, sp, co.Format2(
                i18.Tr("'pure' function '%s' cannot assign to global '%s': writing a global variable is a side effect"),
                co.ArgStr(fname), co.ArgStr(str.Len(bname) > 0 ? bname : rname)
            )
        )
        ret
    end
    if sv.kind == SYM_VAR && where != 0 && scope_at(s, where).kind == SCOPE_GLOBAL:
        serr(
            s, 13, sp, co.Format2(
                i18.Tr("'pure' function '%s' cannot assign to global '%s': writing a global variable is a side effect"),
                co.ArgStr(fname), co.ArgStr(rname)
            )
        )
        ret
    end
    if sv.kind == SYM_PARAM && target != root && pure_param_escapes(s, sv.ty):
        serr(
            s, 13, sp, co.Format2(
                i18.Tr("'pure' function '%s' cannot write through parameter '%s': the write is visible to the caller"),
                co.ArgStr(fname), co.ArgStr(rname)
            )
        )
    end
end

// ===========================================================================
// ===== sema_lit.c (5c) =====
// ===========================================================================

func finish_struct_lit(s &: Sema, a &: at.Ast, nid: int, ssym: int): int:
    sp := span_of(a, nid)
    ssv := sym_at(s, ssym)

    repeat at.ChildCount(a, nid) with i:
        fid := at.Child(a, nid, i)
        fsp := span_of(a, fid)
        fnm := scope_member_canon(s, a, ssv.members, at.Get(a, fid).name, fsp)
        at.SetName(a, fid, fnm)
        f := scope_lookup_local(s, ssv.members, fnm)
        mut fty := TYPE_NONE
        mut is_field := false
        if f != 0:
            fvv := sym_at(s, f)
            if fvv.kind == SYM_FIELD:
                is_field = true
                fty = fvv.ty
            end
        end
        mut vt := TYPE_NONE
        if is_field && stamp_empty_intrinsic(s, a, at.Get(a, fid).a, fty):
            vt = fty
        else:
            vt = sema_check_expr(s, a, at.Get(a, fid).a)
        end
        if !is_field:
            serr(
                s, 16, fsp, co.Format2(
                    i18.Tr("struct '%s' has no field '%s'"), co.ArgStr(ssv.name), co.ArgStr(fnm)
                )
            )
        else !type_assignable(s, fty, vt):
            serr(
                s, 2, fsp, co.Format3(
                    i18.Tr("field '%s': cannot assign '%s' to '%s'"), co.ArgStr(fnm), co.ArgStr(type_to_string(s, vt)),
                    co.ArgStr(type_to_string(s, fty))
                )
            )
        else fty >= 0 && ty_at(s, fty).kind == TY_DYN:
            nb := coerce_to_dyn(s, a, fty, at.Get(a, fid).a, vt)
            mut fnode := at.Get(a, fid)
            fnode.a = nb
            at.Put(a, fid, fnode)
        else fty >= 0 && ty_at(s, fty).kind == TY_VARIANT && vt >= 0 && ty_at(s, vt).kind != TY_VARIANT:
            tag := type_variant_tag(s, fty, vt)
            if tag >= 0:
                nb2 := coerce_to_variant(s, a, fty, at.Get(a, fid).a, tag)
                mut fnode2 := at.Get(a, fid)
                fnode2.a = nb2
                at.Put(a, fid, fnode2)
            end
        end
        if f != 0:
            _df := sema_decorate(s, a, fid, sym_at(s, f).ty)
        end
    end

    msc := scope_at(s, ssv.members)
    repeat msc.symbols.len() with i2:
        f2 := sym_at(s, msc.symbols.get(i2)[0])
        if f2.kind != SYM_FIELD:
            continue
        end
        if f2.decl != 0 && at.Get(a, f2.decl).a != 0:
            continue // field has a default value
        end
        mut provided := false
        repeat at.ChildCount(a, nid) with j:
            fj := at.Get(a, at.Child(a, nid, j))
            if str.Len(fj.name) > 0 && str.Equals(fj.name, f2.name):
                provided = true
                break
            end
        end
        if !provided:
            serr(
                s, 28, sp, co.Format2(
                    i18.Tr("struct literal '%s' requires field '%s'"), co.ArgStr(ssv.name), co.ArgStr(f2.name)
                )
            )
        end
    end
    ret sema_decorate(s, a, nid, ssv.ty)
end

func resolve_pkg_struct_lit(s &: Sema, a &: at.Ast, nid: int, name: str, dot: int): int:
    sp := span_of(a, nid)
    mut pl := dot
    if pl > 63:
        pl = 63
    end
    pname := str.Substr(name, 0, pl)
    mut tname := str.Substr(name, dot + 1, str.Len(name) - dot - 1)
    pk := scope_lookup(s, s.cur, pname)
    mut pk_ok := pk != 0
    if pk_ok:
        if sym_at(s, pk).kind != SYM_PACKAGE:
            pk_ok = false
        end
    end
    if !pk_ok:
        serr(
            s, 1, sp, co.Format2(
                i18.Tr("unknown package '%s' in struct literal '%s'"), co.ArgStr(pname), co.ArgStr(name)
            )
        )
        ret 0
    end
    tname = pkg_member_canon(s, a, pk, tname, sp)
    tsym := scope_lookup_local(s, sym_at(s, pk).members, tname)
    mut tsym_ok := tsym != 0
    if tsym_ok:
        if sym_at(s, tsym).kind != SYM_STRUCT:
            tsym_ok = false
        end
    end
    if !tsym_ok:
        serr(
            s, 1, sp, co.Format2(
                i18.Tr("package '%s' has no exported struct '%s'"), co.ArgStr(pname), co.ArgStr(tname)
            )
        )
        ret 0
    end
    tsv := sym_at(s, tsym)
    if !tsv.is_pub:
        serr(
            s, 17, sp, co.Format2(
                i18.Tr("'%s' is not exported by package '%s' (mark it 'pub')"), co.ArgStr(tname), co.ArgStr(pname)
            )
        )
        ret 0
    end
    at.SetName(a, nid, tname)
    ret tsym
end

func check_struct_lit(s &: Sema, a &: at.Ast, nid: int): int:
    sp := span_of(a, nid)
    name0 := at.Get(a, nid).name
    dot := str.IndexOf(name0, ".")
    if dot >= 0:
        s.expected = TYPE_NONE
        ssym := resolve_pkg_struct_lit(s, a, nid, name0, dot)
        if ssym == 0:
            ret sema_decorate(s, a, nid, sema_err_ty(s))
        end
        ret finish_struct_lit(s, a, nid, ssym)
    end
    if str.Len(at.Get(a, nid).name) > 0:
        orig := at.Get(a, nid).name
        at.SetName(a, nid, intrinsic_type_canon(local_canon(s, a, orig, sp)))
        sema_check_intrinsic_type_lang(s, orig, sp)
    end
    exp := s.expected
    s.expected = TYPE_NONE
    mut name := at.Get(a, nid).name
    if exp >= 0 && ty_at(s, exp).kind == TY_STRUCT && str.Len(name) > 0 && (
        generic_template(s, a, name, SYM_STRUCT) != 0 || scope_lookup(s, s.global, name) == 0
    ):
        name = ty_at(s, exp).name
        at.SetName(a, nid, name)
    end
    if str.Len(name) == 0:
        serr(s, 1, sp, i18.Tr("cannot infer the struct type of this literal"))
        ret sema_decorate(s, a, nid, sema_err_ty(s))
    end
    ssym := scope_lookup(s, s.global, name)
    mut is_struct := ssym != 0
    if is_struct && sym_at(s, ssym).kind != SYM_STRUCT:
        is_struct = false
    end
    if !is_struct && at.ChildCount(a, nid) == 0:
        mut tmpl := generic_template(s, a, name, SYM_STRUCT)
        if tmpl == 0:
            sema_load_prelude(s, a)
            if s.prelude != 0:
                psym := scope_lookup_local(s, s.prelude, name)
                if psym != 0:
                    pv := sym_at(s, psym)
                    if pv.kind == SYM_STRUCT && pv.decl != 0 && at.TyparamCount(a, pv.decl) > 0:
                        tmpl = psym
                    end
                end
            end
        end
        if tmpl != 0:
            td := sym_at(s, tmpl).decl
            mut targs := ""
            repeat at.TyparamCount(a, td) with ti:
                if ti > 0:
                    targs = targs + ", "
                end
                targs = targs + at.Typaram(a, td, ti)
            end
            serr(
                s, 71, sp, co.Format4(
                    i18.Tr("cannot infer the type arguments of '%s'; write '%s {} as %s<%s>'"), co.ArgStr(name),
                    co.ArgStr(name), co.ArgStr(name), co.ArgStr(targs)
                )
            )
            ret sema_decorate(s, a, nid, sema_err_ty(s))
        end
    end
    if !is_struct:
        serr(
            s, 1, sp, co.Format1(i18.Tr("unknown struct '%s'"), co.ArgStr(name))
        )
        ret sema_decorate(s, a, nid, sema_err_ty(s))
    end
    ret finish_struct_lit(s, a, nid, ssym)
end

func check_array_lit(s &: Sema, a &: at.Ast, nid: int): int:
    sp := span_of(a, nid)
    exp := s.expected
    s.expected = TYPE_NONE
    mut exp_elem := TYPE_NONE
    if exp >= 0 && ty_at(s, exp).kind == TY_ARRAY:
        exp_elem = ty_at(s, exp).elem
    end
    if at.ChildCount(a, nid) == 0:
        if exp_elem >= 0:
            ret sema_decorate(s, a, nid, type_array(s, exp_elem, 0 as i64))
        end
        serr(
            s, 52, sp, i18.Tr("cannot infer the type of an empty array; write 'items := [] as Type[]'")
        )
        ret sema_decorate(s, a, nid, sema_err_ty(s))
    end

    if exp_elem >= 0 && ty_at(s, exp_elem).kind == TY_DYN:
        repeat at.ChildCount(a, nid) with i:
            eid := at.Child(a, nid, i)
            t := sema_check_expr(s, a, eid)
            nb := coerce_to_dyn(s, a, exp_elem, eid, t)
            mut nv := at.Get(a, nid)
            nv.list.set(i, nb)
            at.Put(a, nid, nv)
        end
        ret sema_decorate(
            s, a, nid, type_array(s, exp_elem, at.ChildCount(a, nid) as i64)
        )
    end
    mut elem := sema_check_expr(s, a, at.Child(a, nid, 0))
    mut i2 := 1
    until i2 < at.ChildCount(a, nid):
        t2 := sema_check_expr(s, a, at.Child(a, nid, i2))
        if !type_equiv(s, elem, t2):
            c := type_common_arith(s, elem, t2)
            if c >= 0:
                elem = c
            else:
                serr(s, 56, sp, i18.Tr("array elements have incompatible types"))
            end
        end
        i2 += 1
    end
    ret sema_decorate(
        s, a, nid, type_array(s, elem, at.ChildCount(a, nid) as i64)
    )
end

// defined_within - name resolvable between `start` and `boundary` inclusive.
func defined_within(s &: Sema, start: int, boundary: int, name: str): bool:
    mut p := start
    until p != 0:
        if scope_lookup_local(s, p, name) != 0:
            ret true
        end
        if p == boundary:
            break
        end
        p = scope_at(s, p).parent
    end
    ret false
end

// record_capture - notes a captured outer variable on every enclosing
// lambda that does not define it itself.
func record_capture(s &: Sema, a &: at.Ast, id: int, t: int):
    cts := type_to_string(s, t)
    name := at.Get(a, id).name
    mut li := s.lam.len() - 1
    until li >= 0:
        lc := s.lam.get(li)[0]
        if defined_within(s, s.cur, lc.boundary, name):
            break
        end
        caps := at.Get(a, lc.node).captures
        mut seen := false
        repeat caps.len() with i:
            if str.Equals(at.Get(a, caps.get(i)[0]).name, name):
                seen = true
                break
            end
        end
        if !seen:
            cap := new_node_at(a, at.AST_IDENTIFIER, span_of(a, id))
            mut cv := at.Get(a, cap)
            cv.name = name
            cv.type_str = cts
            at.Put(a, cap, cv)
            at.AddCapture(a, lc.node, cap)
        end
        li -= 1
    end
end

// check_lambda - parameters get a fresh SCOPE_FUNC; the body is checked
// with an inference-only Sig (a Sema-owned slot standing in for the C's
// stack-local func_sig_t).
func check_lambda(s &: Sema, a &: at.Ast, nid: int): int:
    sc := scope_new(s, SCOPE_FUNC, s.cur)
    saved_cur := s.cur
    saved_func := s.cur_func
    saved_self := s.self_type
    saved_mad := s.match_arm_depth
    saved_myexp := s.match_yield_expected
    saved_myact := s.match_yield_active
    s.cur = sc
    s.self_type = TYPE_NONE
    s.lam.push(LambdaCtx { boundary = sc, node = nid })
    s.match_arm_depth = 0
    s.match_yield_expected = TYPE_NONE
    s.match_yield_active = false
    mut nv := at.Get(a, nid)
    nv.captures.clear()
    at.Put(a, nid, nv)
    mut ptypes := Vector {} as Vector<int>
    defer ptypes.free()
    repeat at.ChildCount(a, nid) with i:
        pid := at.Child(a, nid, i)
        param := at.Get(a, pid)
        ps := symbol_new(s, SYM_PARAM, param.name)
        pt := sema_resolve_type(s, a, param.ty)
        mut psv := sym_at(s, ps)
        psv.ty = pt
        psv.is_ref = param.is_ref
        sym_put(s, ps, psv)
        at.SetTypeStr(a, pid, type_to_string(s, pt))
        if scope_define(s, sc, ps) != 0:
            serr(
                s, 1, span_of(a, pid), co.Format1(
                    i18.Tr("duplicate parameter '%s'"), co.ArgStr(param.name)
                )
            )
        end
        ptypes.push(pt)
    end

    sigid := s.sigs.len()
    s.sigs.push(Sig {})
    mut sg := sig_at(s, sigid)
    sg.ret_type = sema_ty(s, TY_VOID)
    sg.infer_ret = true
    repeat ptypes.len() with pi:
        sg.params.push(ptypes.get(pi)[0])
    end
    sig_put(s, sigid, sg)
    s.cur_func = sigid
    mut scv := scope_at(s, sc)
    scv.fn = sigid
    scope_put(s, sc, scv)
    body := at.Get(a, nid).a
    if body != 0:
        sema_check_block(s, a, body)
    end
    lret := sig_at(s, sigid).ret_type
    s.cur = saved_cur
    s.cur_func = saved_func
    s.self_type = saved_self
    _lp := s.lam.pop()
    s.match_arm_depth = saved_mad
    s.match_yield_expected = saved_myexp
    s.match_yield_active = saved_myact
    ft := type_func_new(s, lret, ptypes)
    ret sema_decorate(s, a, nid, ft)
end

// ===========================================================================
// ===== sema_call.c (5c) =====
// ===========================================================================

// ===== dce.c (5d) =====
// The C module state is the g_sm_dce_* globals; dce_reset(arena) becomes
// DceReset() (no arena - vectors own their storage). dce_enabled() defaults
// to false, so a plain `sema.Run` build behaves exactly like before.

// dce_key - "%s::%s"
func dce_key(pkg: str, fn: str): str:
    ret pkg + "::" + fn
end

// key_in
func dce_key_in(v: Vector<str>, key: str): bool:
    repeat v.len() with i:
        if str.Equals(v.get(i)[0], key):
            ret true
        end
    end
    ret false
end

// dce_note_call
func dce_note_call(
    caller_pkg: str, caller_fn: str, callee_pkg: str, callee_fn: str
):
    if !g_sm_dce_enabled || !g_sm_dce_init:
        ret
    end
    if str.Len(caller_fn) == 0:
        dce_mark_root(callee_pkg, callee_fn)
        ret
    end
    g_sm_dce_edge_from.push(dce_key(caller_pkg, caller_fn))
    g_sm_dce_edge_to.push(dce_key(callee_pkg, callee_fn))
end

// dce_mark_root
func dce_mark_root(pkg: str, fn: str):
    if !g_sm_dce_enabled || !g_sm_dce_init:
        ret
    end
    k := dce_key(pkg, fn)
    if !dce_key_in(g_sm_dce_roots, k):
        g_sm_dce_roots.push(k)
    end
end

// dce_caller_rooted (sema_call.c)
func dce_caller_rooted(s &: Sema, a &: at.Ast): bool:
    if s.cur_func == 0:
        ret true
    end
    sg := sig_at(s, s.cur_func)
    if sg.owner != 0:
        ret true
    end
    if sg.decl == 0:
        ret true
    end
    d := at.Get(a, sg.decl)
    if d.typarams.len() > 0:
        ret true
    end
    if d.is_extern:
        ret true
    end
    if d.synthetic:
        ret true
    end
    ret false
end

// dce_note (sema_call.c) - 5d note: gained the `a` param (dce_caller_rooted
// reads the current function's decl node).
func dce_note(s &: Sema, a &: at.Ast, callee_pkg: str, callee_fn: str):
    if !g_sm_dce_enabled:
        ret
    end
    if dce_caller_rooted(s, a):
        dce_mark_root(callee_pkg, callee_fn)
        ret
    end
    dce_note_call(
        s.pkg, at.Get(a, sig_at(s, s.cur_func).decl).name, callee_pkg, callee_fn
    )
end

// sig ? sig->ret : err_ty(s) - always re-reads the Sig (check_function_now
// may have replaced an inferred return type).
func sig_ret_or_err(s &: Sema, sigid: int): int:
    if sigid == 0:
        ret sema_err_ty(s)
    end
    ret sig_at(s, sigid).ret_type
end

// ro_found - post-match bookkeeping for a resolved overload.
func ro_found(
    s &: Sema, a &: at.Ast, sigid: int, sp: co.SrcSpan, what: str
): int:
    sg := sig_at(s, sigid)
    if sg.decl != 0 && at.Get(a, sg.decl).is_deprecated:
        swarn(
            s, 13, sp, co.Format1(
                i18.Tr("call to deprecated function '%s'"), co.ArgStr(what)
            )
        )
    end
    if sg.infer_ret:
        if sg.in_check:
            serr(
                s, 12, sp, co.Format1(
                    i18.Tr("cannot infer the return type of recursive function '%s'; annotate its return type"),
                    co.ArgStr(what)
                )
            )
        else:
            sema_check_function_now(s, a, sigid)
        end
    end
    pf := sema_pure_fn(s, a)
    if pf != 0:
        sg2 := sig_at(s, sigid)
        if sg2.decl != 0 && !at.Get(a, sg2.decl).is_pure:
            serr(
                s, 12, sp, co.Format2(
                    i18.Tr("'pure' function '%s' cannot call '%s': only 'pure' functions may be called from a pure function"),
                    co.ArgStr(at.Get(a, pf).name), co.ArgStr(what)
                )
            )
        end
    end
    ret sigid
end

// resolve_overload - exact pass, then assignable pass, then diagnostics.
// 0 = the C NULL (no match; errors already reported).
func resolve_overload(
    s &: Sema, a &: at.Ast, fsym: int, argtypes: Vector<int>, sp: co.SrcSpan, what: str
): int:
    fv := sym_at(s, fsym)
    mut best := 0
    mut nmatch := 0

    repeat fv.overloads.len() with i:
        sgid := fv.overloads.get(i)[0]
        sg := sig_at(s, sgid)
        if argtypes.len() < sg.required:
            continue
        end
        if !sg.variadic && argtypes.len() > sg.params.len():
            continue
        end
        mut nfix := argtypes.len()
        if sg.params.len() < nfix:
            nfix = sg.params.len()
        end
        mut ok := true
        repeat nfix with j:
            if !type_equiv(s, sg.params.get(j)[0], argtypes.get(j)[0]):
                ok = false
                break
            end
        end
        if ok:
            best = sgid
            nmatch += 1
        end
    end
    if nmatch == 1:
        ret ro_found(s, a, best, sp, what)
    end
    if nmatch > 1:
        serr(
            s, 12, sp, co.Format2(
                i18.Tr("ambiguous call to '%s' (%zu candidates)"), co.ArgStr(what), co.ArgUint(nmatch as u64)
            )
        )
        ret 0
    end

    repeat fv.overloads.len() with i2:
        sgid2 := fv.overloads.get(i2)[0]
        sg2 := sig_at(s, sgid2)
        if argtypes.len() < sg2.required:
            continue
        end
        if !sg2.variadic && argtypes.len() > sg2.params.len():
            continue
        end
        mut nfix2 := argtypes.len()
        if sg2.params.len() < nfix2:
            nfix2 = sg2.params.len()
        end
        mut ok2 := true
        repeat nfix2 with j2:
            if !type_assignable(s, sg2.params.get(j2)[0], argtypes.get(j2)[0]):
                ok2 = false
                break
            end
        end
        if ok2:
            best = sgid2
            nmatch += 1
        end
    end
    if nmatch == 1:
        ret ro_found(s, a, best, sp, what)
    end
    if nmatch > 1:
        serr(
            s, 12, sp, co.Format2(
                i18.Tr("ambiguous call to '%s' (%zu candidates)"), co.ArgStr(what), co.ArgUint(nmatch as u64)
            )
        )
        ret 0
    end
    if fv.overloads.len() == 1:
        sg3 := sig_at(s, fv.overloads.get(0)[0])
        if argtypes.len() < sg3.required || (!sg3.variadic && argtypes.len() > sg3.params.len()):
            if sg3.variadic:
                serr(
                    s, 12, sp, co.Format4(
                        i18.Tr("'%s' expects at least %zu argument%s, got %zu"), co.ArgStr(what), co.ArgUint(sg3.required as u64),
                        co.ArgStr(plural_suffix(sg3.required)), co.ArgUint(argtypes.len() as u64)
                    )
                )
            else sg3.required == sg3.params.len():
                serr(
                    s, 12, sp, co.Format4(
                        i18.Tr("'%s' expects %zu argument%s, got %zu"), co.ArgStr(what), co.ArgUint(sg3.params.len() as u64),
                        co.ArgStr(plural_suffix(sg3.params.len())), co.ArgUint(argtypes.len() as u64)
                    )
                )
            else:
                serr(
                    s, 12, sp, co.Format4(
                        i18.Tr("'%s' expects %zu to %zu arguments, got %zu"), co.ArgStr(what), co.ArgUint(sg3.required as u64),
                        co.ArgUint(sg3.params.len() as u64), co.ArgUint(argtypes.len() as u64)
                    )
                )
            end
            ret 0
        end
        mut nfix3 := argtypes.len()
        if sg3.params.len() < nfix3:
            nfix3 = sg3.params.len()
        end
        repeat nfix3 with j3:
            if !type_assignable(s, sg3.params.get(j3)[0], argtypes.get(j3)[0]):
                serr(
                    s, 12, sp, co.Format3(
                        i18.Tr("argument %zu: cannot pass '%s' to '%s'"), co.ArgUint((j3 + 1) as u64),
                        co.ArgStr(type_to_string(s, argtypes.get(j3)[0])), co.ArgStr(type_to_string(s, sg3.params.get(j3)[0]))
                    )
                )
                ret 0
            end
        end
    end
    serr(
        s, 12, sp, co.Format3(
            i18.Tr("no matching overload for '%s' with %zu argument%s"), co.ArgStr(what), co.ArgUint(argtypes.len() as u64),
            co.ArgStr(plural_suffix(argtypes.len()))
        )
    )
    ret 0
end

// mark_ref_args - arguments bound to `&:` parameters count as mutations.
func mark_ref_args(s &: Sema, a &: at.Ast, call: int, sigid: int):
    if sigid == 0:
        ret
    end
    sg := sig_at(s, sigid)
    if sg.decl == 0:
        ret
    end
    dl := at.Get(a, sg.decl).list
    mut i := 0
    until i < at.ChildCount(a, call) && i < dl.len():
        p := at.Get(a, dl.get(i)[0])
        if p.kind == at.AST_PARAM && p.is_ref:
            argid := at.Child(a, call, i)
            if argid != 0:
                arg := at.Get(a, argid)
                if arg.kind == at.AST_IDENTIFIER && str.Len(arg.name) > 0:
                    symid := scope_lookup(s, s.cur, arg.name)
                    if symid != 0:
                        mut sv := sym_at(s, symid)
                        sv.mutated = true
                        sym_put(s, symid, sv)
                    end
                end
            end
        end
        i += 1
    end
end

// try_impl_call - method provided by an `impl ... on <type>` block.
// TYPE_NONE = the C NULL ("not an impl call"); errors return err_ty.
func try_impl_call(
    s &: Sema, a &: at.Ast, n: int, callee: int, objt: int, argtypes: Vector<int>
): int:
    owner := scope_lookup(
        s, s.global, impl_owner_key(type_to_string(s, objt))
    )
    if owner == 0:
        ret TYPE_NONE
    end
    m := scope_lookup_local(s, sym_at(s, owner).members, at.Get(a, callee).name)
    if m == 0 || sym_at(s, m).kind != SYM_METHOD:
        ret TYPE_NONE
    end
    sig := resolve_overload(
        s, a, m, argtypes, span_of(a, n), at.Get(a, callee).name
    )
    mark_ref_args(s, a, n, sig)
    _dc := sema_decorate(s, a, callee, sym_at(s, m).ty)
    ret sema_decorate(s, a, n, sig_ret_or_err(s, sig))
end

func check_pure_recv_mut(s &: Sema, a &: at.Ast, n: int, m: str):
    pf := sema_pure_fn(s, a)
    if pf != 0:
        serr(
            s, 12, span_of(a, n), co.Format2(
                i18.Tr("'pure' function '%s' cannot call '%s': it modifies its receiver"), co.ArgStr(at.Get(a, pf).name),
                co.ArgStr(m)
            )
        )
    end
end

func check_pure_builtin(s &: Sema, a &: at.Ast, n: int, nm: str):
    pf := sema_pure_fn(s, a)
    if pf == 0 || str.Len(nm) == 0:
        ret
    end
    impure := [
        "print", "println", "printerr", "printerrln", "input", "open", "args", "listdir", "spawn", "callhandler",
        "join"
    ] as str[11]
    repeat 11 with i:
        if str.Equals(nm, impure[i]):
            serr(
                s, 12, span_of(a, n), co.Format2(
                    i18.Tr("'pure' function '%s' cannot call '%s': it has side effects"), co.ArgStr(at.Get(a, pf).name),
                    co.ArgStr(nm)
                )
            )
            ret
        end
    end
end

// check_call - the whole call checker (special forms, function values,
// print-family builtins, overloads, generics, package calls, intrinsic
// collection/File/str methods, dyn dispatch, struct methods).
func check_call(s &: Sema, a &: at.Ast, n: int): int:
    callee := at.Get(a, n).a
    call_expected := s.expected
    s.expected = TYPE_NONE
    sp := span_of(a, n)

    mut ckind := 0 - 1
    if callee != 0:
        ckind = at.KindOf(a, callee)
    end
    if ckind == at.AST_IDENTIFIER:
        check_pure_builtin(s, a, n, at.Get(a, callee).name)
    end

    if ckind == at.AST_IDENTIFIER && str.Equals(at.Get(a, callee).name, "spawn"):
        if at.ChildCount(a, n) != 1 || at.KindOf(a, at.Child(a, n, 0)) != at.AST_IDENTIFIER:
            serr(s, 12, sp, i18.Tr("spawn(func) takes a single function name"))
            ret sema_decorate(s, a, n, sema_ty(s, TY_I64))
        end
        fnid := at.Child(a, n, 0)
        fname := at.Get(a, fnid).name
        fsym := scope_lookup(s, s.cur, fname)
        mut is_fn := fsym != 0
        if is_fn && sym_at(s, fsym).kind != SYM_FUNC:
            is_fn = false
        end
        if !is_fn:
            serr(
                s, 12, sp, co.Format1(
                    i18.Tr("spawn argument '%s' is not a function"), co.ArgStr(fname)
                )
            )
            ret sema_decorate(s, a, n, sema_ty(s, TY_I64))
        end
        mut fsv := sym_at(s, fsym)
        fsv.used = true
        sym_put(s, fsym, fsv)
        dce_mark_root(s.pkg, fname)
        mut sok := false
        fsv2 := sym_at(s, fsym)
        repeat fsv2.overloads.len() with i:
            sg := sig_at(s, fsv2.overloads.get(i)[0])
            if sg.params.len() == 0 && sg.ret_type >= 0 && ty_at(s, sg.ret_type).kind == TY_VOID:
                sok = true
            end
        end
        if !sok:
            serr(
                s, 12, sp, i18.Tr("spawn requires a function taking no arguments and returning nothing")
            )
        end
        _d1 := sema_decorate(s, a, fnid, sema_ty(s, TY_VOID))
        _d2 := sema_decorate(s, a, callee, sema_ty(s, TY_VOID))
        ret sema_decorate(s, a, n, sema_ty(s, TY_I64))
    end

    if ckind == at.AST_IDENTIFIER && str.Equals(at.Get(a, callee).name, "funcptr"):
        if at.ChildCount(a, n) != 1 || at.KindOf(a, at.Child(a, n, 0)) != at.AST_IDENTIFIER:
            serr(s, 12, sp, i18.Tr("funcptr(func) takes a single function name"))
            ret sema_decorate(s, a, n, sema_ty(s, TY_I64))
        end
        fnid2 := at.Child(a, n, 0)
        fname2 := at.Get(a, fnid2).name
        fsym2 := scope_lookup(s, s.cur, fname2)
        mut is_fn2 := fsym2 != 0
        if is_fn2 && sym_at(s, fsym2).kind != SYM_FUNC:
            is_fn2 = false
        end
        if !is_fn2:
            serr(
                s, 12, sp, co.Format1(
                    i18.Tr("funcptr argument '%s' is not a function"), co.ArgStr(fname2)
                )
            )
            ret sema_decorate(s, a, n, sema_ty(s, TY_I64))
        end
        mut fsv3 := sym_at(s, fsym2)
        fsv3.used = true
        sym_put(s, fsym2, fsv3)
        dce_mark_root(s.pkg, fname2)
        _d3 := sema_decorate(s, a, fnid2, sema_ty(s, TY_VOID))
        _d4 := sema_decorate(s, a, callee, sema_ty(s, TY_VOID))
        ret sema_decorate(s, a, n, sema_ty(s, TY_I64))
    end

    if ckind == at.AST_IDENTIFIER && str.Equals(at.Get(a, callee).name, "callhandler"):
        if at.ChildCount(a, n) != 2:
            serr(
                s, 12, sp, i18.Tr("callhandler(fn, arg) takes a function pointer and an i64 argument")
            )
            ret sema_decorate(s, a, n, sema_ty(s, TY_VOID))
        end
        _c1 := sema_check_expr(s, a, at.Child(a, n, 0))
        _c2 := sema_check_expr(s, a, at.Child(a, n, 1))
        _d5 := sema_decorate(s, a, callee, sema_ty(s, TY_VOID))
        ret sema_decorate(s, a, n, sema_ty(s, TY_VOID))
    end

    if ckind == at.AST_IDENTIFIER && str.Equals(at.Get(a, callee).name, "sizeof"):
        if at.ChildCount(a, n) != 1 || at.KindOf(a, at.Child(a, n, 0)) != at.AST_TYPE:
            serr(s, 12, sp, i18.Tr("sizeof(Type) takes a single type operand"))
            ret sema_decorate(s, a, n, sema_ty(s, TY_SIZE))
        end
        opid := at.Child(a, n, 0)
        ot := sema_resolve_type(s, a, opid)
        _d6 := sema_decorate(s, a, opid, ot)
        _d7 := sema_decorate(s, a, callee, sema_ty(s, TY_VOID))
        ret sema_decorate(s, a, n, sema_ty(s, TY_SIZE))
    end

    mut argtypes := Vector {} as Vector<int>
    defer argtypes.free()
    repeat at.ChildCount(a, n) with ai:
        argtypes.push(sema_check_expr(s, a, at.Child(a, n, ai)))
    end

    // Calls through a function-typed value (variable/param/const/expr).
    mut ft := TYPE_NONE
    if ckind == at.AST_IDENTIFIER:
        fvid := scope_lookup(s, s.cur, at.Get(a, callee).name)
        if fvid != 0:
            fvv := sym_at(s, fvid)
            if fvv.ty >= 0 && ty_at(s, fvv.ty).kind == TY_FUNC && (
                fvv.kind == SYM_VAR || fvv.kind == SYM_PARAM || fvv.kind == SYM_CONST
            ):
                ft = fvv.ty
                mut fvm := sym_at(s, fvid)
                fvm.used = true
                sym_put(s, fvid, fvm)
            end
        end
    else callee != 0 && ckind != at.AST_MEMBER:
        ct := sema_check_expr(s, a, callee)
        if ct >= 0 && ty_at(s, ct).kind == TY_FUNC:
            ft = ct
        end
    end
    if ft >= 0:
        _d8 := sema_decorate(s, a, callee, ft)
        pf := sema_pure_fn(s, a)
        if pf != 0:
            serr(
                s, 12, sp, co.Format1(
                    i18.Tr("'pure' function '%s' cannot call a function value: its purity cannot be verified"),
                    co.ArgStr(at.Get(a, pf).name)
                )
            )
        end
        ftv := ty_at(s, ft)
        if argtypes.len() != ftv.params.len():
            serr(
                s, 12, sp, co.Format3(
                    i18.Tr("function value takes %zu argument%s, got %zu"), co.ArgUint(ftv.params.len() as u64),
                    co.ArgStr(plural_suffix(ftv.params.len())), co.ArgUint(argtypes.len() as u64)
                )
            )
        else:
            repeat argtypes.len() with fi:
                if !type_assignable(
                    s, ftv.params.get(fi)[0], argtypes.get(fi)[0]
                ):
                    serr(
                        s, 2, sp, co.Format3(
                            i18.Tr("argument %zu: cannot pass '%s' to '%s'"), co.ArgUint((fi + 1) as u64),
                            co.ArgStr(type_to_string(s, argtypes.get(fi)[0])), co.ArgStr(type_to_string(s, ftv.params.get(fi)[0]))
                        )
                    )
                end
            end
        end
        ret sema_decorate(s, a, n, ftv.elem)
    end

    if ckind == at.AST_IDENTIFIER:
        mut nm := at.Get(a, callee).name
        if str.Equals(nm, "print") || str.Equals(nm, "println") || str.Equals(nm, "printerr") || str.Equals(nm, "printerrln"):
            _d9 := sema_decorate(s, a, callee, sema_ty(s, TY_VOID))
            ret sema_decorate(s, a, n, sema_ty(s, TY_VOID))
        end
        if str.Equals(nm, "input"):
            _da2 := sema_decorate(s, a, callee, sema_ty(s, TY_STR))
            ret sema_decorate(s, a, n, sema_ty(s, TY_STR))
        end
        if str.Equals(nm, "hash") && argtypes.len() == 1:
            _db2 := sema_decorate(s, a, callee, sema_ty(s, TY_VOID))
            ret sema_decorate(s, a, n, sema_ty(s, TY_U64))
        end
        if str.Equals(nm, "open"):
            if argtypes.len() != 2:
                serr(s, 12, sp, i18.Tr("open(path, mode) takes 2 args"))
            end
            _dc2 := sema_decorate(s, a, callee, sema_ty(s, TY_VOID))
            ret sema_decorate(s, a, n, type_ptr(s, type_file(s)))
        end
        if str.Equals(nm, "env"):
            if argtypes.len() != 1:
                serr(s, 12, sp, i18.Tr("env(name) takes 1 arg"))
            end
            _dd2 := sema_decorate(s, a, callee, sema_ty(s, TY_VOID))
            ret sema_decorate(s, a, n, sema_ty(s, TY_STR))
        end
        if str.Equals(nm, "args"):
            if argtypes.len() != 0:
                serr(s, 12, sp, i18.Tr("args() takes no arguments"))
            end
            _de2 := sema_decorate(s, a, callee, sema_ty(s, TY_VOID))
            ret sema_decorate(s, a, n, sema_vec_str(s, a, sp))
        end
        if str.Equals(nm, "lang"):
            if argtypes.len() != 0:
                serr(s, 12, sp, i18.Tr("lang() takes no arguments"))
            end
            _df2 := sema_decorate(s, a, callee, sema_ty(s, TY_VOID))
            ret sema_decorate(s, a, n, sema_ty(s, TY_STR))
        end
        if str.Equals(nm, "listdir"):
            if argtypes.len() != 1:
                serr(
                    s, 12, sp, co.Format1(i18.Tr("%s takes 1 argument"), co.ArgStr(nm))
                )
            end
            _dg2 := sema_decorate(s, a, callee, sema_ty(s, TY_VOID))
            ret sema_decorate(s, a, n, sema_vec_str(s, a, sp))
        end
        mut sym := scope_lookup(s, s.cur, nm)
        if sym == 0:
            c := local_canon(s, a, nm, sp)
            if !str.Equals(c, nm):
                nm = c
                at.SetName(a, callee, c)
                sym = scope_lookup(s, s.cur, nm)
            end
        end
        mut sym_callable := sym != 0
        if sym_callable:
            sk := sym_at(s, sym).kind
            if sk != SYM_FUNC && sk != SYM_METHOD:
                sym_callable = false
            end
        end
        if !sym_callable:
            if str.Equals(nm, "len") && argtypes.len() == 1:
                ak := ty_at(s, argtypes.get(0)[0]).kind
                if ak == TY_ARRAY || ak == TY_SLICE || ak == TY_STR:
                    _dh2 := sema_decorate(s, a, callee, sema_ty(s, TY_VOID))
                    ret sema_decorate(s, a, n, sema_ty(s, TY_I32))
                end
            end
            if str.Equals(nm, "char_code") && argtypes.len() == 1 && ty_at(s, argtypes.get(0)[0]).kind == TY_STR:
                _di2 := sema_decorate(s, a, callee, sema_ty(s, TY_VOID))
                ret sema_decorate(s, a, n, sema_ty(s, TY_I32))
            end
            bi := builtin_lookup(nm)
            if bi >= 0:
                bnargs := k_sm_builtin_nargs[bi]
                barg := k_sm_builtin_arg[bi]
                bret := k_sm_builtin_ret[bi]
                if bnargs >= 0 && argtypes.len() != bnargs:
                    serr(
                        s, 12, sp, co.Format4(
                            i18.Tr("builtin '%s' takes %d argument%s, got %zu"), co.ArgStr(nm), co.ArgInt(bnargs as i64),
                            co.ArgStr(plural_suffix(bnargs)), co.ArgUint(argtypes.len() as u64)
                        )
                    )
                end
                if !str.Equals(barg, "*"):
                    bak := type_prim_kind_from_name(barg, "")
                    repeat argtypes.len() with bj:
                        if !type_assignable(
                            s, sema_ty(s, bak), argtypes.get(bj)[0]
                        ):
                            serr(
                                s, 2, sp, co.Format3(
                                    i18.Tr("builtin '%s' expects '%s', got '%s'"), co.ArgStr(nm), co.ArgStr(barg),
                                    co.ArgStr(
                                        type_to_string(
                                            s, argtypes.get(bj)[0]
                                        )
                                    )
                                )
                            )
                        end
                    end
                end
                _dj2 := sema_decorate(s, a, callee, sema_ty(s, TY_VOID))
                ret sema_decorate(
                    s, a, n, sema_ty(s, type_prim_kind_from_name(bret, ""))
                )
            end
            serr(
                s, 12, sp, co.Format1(
                    i18.Tr("call to undefined function '%s'"), co.ArgStr(nm)
                )
            )
            ret sema_decorate(s, a, n, sema_err_ty(s))
        end

        mut symv := sym_at(s, sym)
        symv.used = true
        sym_put(s, sym, symv)
        dce_note(s, a, str.Len(symv.pkgname) > 0 ? symv.pkgname : s.pkg, nm)
        if symv.kind == SYM_FUNC && symv.decl != 0 && at.TyparamCount(a, symv.decl) > 0:
            inst := g_infer_call(s, a, sym, argtypes, sp, call_expected)
            if inst == 0:
                ret sema_decorate(s, a, n, sema_err_ty(s))
            end
            sym = inst
            at.SetName(a, callee, sym_at(s, inst).name)
            // NOTE: `nm` (the written name) is kept for error messages.
        end
        sig := resolve_overload(s, a, sym, argtypes, sp, nm)
        mark_ref_args(s, a, n, sig)
        coerce_args_to_dyn(s, a, n, argtypes, sig)
        coerce_args_to_variant(s, a, n, argtypes, sig)
        _dk2 := sema_decorate(s, a, callee, sym_at(s, sym).ty)
        if sig == 0:
            ret sema_decorate(s, a, n, sema_err_ty(s))
        end
        ret sema_decorate(
            s, a, n, g_localize_instance(s, a, sig_ret_or_err(s, sig), sp)
        )
    end

    if ckind == at.AST_MEMBER && at.Get(a, callee).a != 0 && at.KindOf(a, at.Get(a, callee).a) == at.AST_IDENTIFIER:
        pk := scope_lookup(s, s.cur, at.Get(a, at.Get(a, callee).a).name)
        if pk != 0 && sym_at(s, pk).kind == SYM_PACKAGE:
            csp := span_of(a, callee)
            fname3 := pkg_member_canon(s, a, pk, at.Get(a, callee).name, csp)
            at.SetName(a, callee, fname3)
            pkv := sym_at(s, pk)
            fn := scope_lookup_local(s, pkv.members, fname3)
            mut fn_ok := fn != 0
            if fn_ok && sym_at(s, fn).kind != SYM_FUNC:
                fn_ok = false
            end
            if !fn_ok:
                serr(
                    s, 12, sp, co.Format2(
                        i18.Tr("package '%s' has no exported function '%s'"), co.ArgStr(pkv.name), co.ArgStr(fname3)
                    )
                )
                ret sema_decorate(s, a, n, sema_err_ty(s))
            end
            fnv := sym_at(s, fn)
            if !fnv.is_pub:
                serr(
                    s, 17, sp, co.Format2(
                        i18.Tr("'%s' is not exported by package '%s' (mark it 'pub')"), co.ArgStr(fname3),
                        co.ArgStr(pkv.name)
                    )
                )
                ret sema_decorate(s, a, n, sema_err_ty(s))
            end
            mut fnm := sym_at(s, fn)
            fnm.used = true
            sym_put(s, fn, fnm)
            dce_note(s, a, pkv.pkgname, fname3)

            if fnm.decl != 0 && at.TyparamCount(a, fnm.decl) > 0:
                save_cur := s.cur
                save_gp := s.gen_pkg
                s.cur = pkv.members
                s.gen_pkg = pkv.members
                inst2 := g_infer_call(s, a, fn, argtypes, sp, call_expected)
                s.cur = save_cur
                s.gen_pkg = save_gp
                if inst2 == 0:
                    ret sema_decorate(s, a, n, sema_err_ty(s))
                end
                mut cv := at.Get(a, callee)
                cv.kind = at.AST_IDENTIFIER
                cv.name = sym_at(s, inst2).name
                at.Put(a, callee, cv)
                sig2 := resolve_overload(s, a, inst2, argtypes, sp, fname3)
                mark_ref_args(s, a, n, sig2)
                _dl2 := sema_decorate(s, a, callee, sym_at(s, inst2).ty)
                if sig2 == 0:
                    ret sema_decorate(s, a, n, sema_err_ty(s))
                end
                ret sema_decorate(
                    s, a, n, g_localize_instance(s, a, sig_ret_or_err(s, sig2), sp)
                )
            end
            sig3 := resolve_overload(s, a, fn, argtypes, sp, fname3)
            mark_ref_args(s, a, n, sig3)
            _dm2 := sema_decorate(s, a, at.Get(a, callee).a, pkv.ty)
            _dn2 := sema_decorate(s, a, callee, sym_at(s, fn).ty)
            if sig3 == 0:
                ret sema_decorate(s, a, n, sema_err_ty(s))
            end
            ret sema_decorate(
                s, a, n, g_localize_instance(s, a, sig_ret_or_err(s, sig3), sp)
            )
        end
    end

    if ckind == at.AST_MEMBER:
        objt := sema_check_expr(s, a, at.Get(a, callee).a)
        if type_is_error(s, objt):
            ret sema_decorate(s, a, n, sema_err_ty(s))
        end
        // any method call through a member chain marks the root mutated
        mut root := at.Get(a, callee).a
        until root != 0 && (
            at.KindOf(a, root) == at.AST_MEMBER || at.KindOf(a, root) == at.AST_INDEX
        ):
            root = at.Get(a, root).a
        end
        if root != 0 && at.KindOf(a, root) == at.AST_IDENTIFIER && str.Len(at.Get(a, root).name) > 0:
            rsym := scope_lookup(s, s.cur, at.Get(a, root).name)
            if rsym != 0:
                mut rv := sym_at(s, rsym)
                rv.mutated = true
                sym_put(s, rsym, rv)
            end
        end

        csp2 := span_of(a, callee)
        ov := ty_at(s, objt)
        mut is_file_ptr := false
        if ov.kind == TY_PTR && ov.pointee >= 0 && ty_at(s, ov.pointee).kind == TY_FILE:
            is_file_ptr = true
        end
        if str.Len(at.Get(a, callee).name) > 0 && (
            ov.kind == TY_MAP || ov.kind == TY_MAP_ITER || ov.kind == TY_VEC || ov.kind == TY_STR || ov.kind == TY_ARRAY || ov.kind == TY_SLICE || is_file_ptr
        ):
            orig := at.Get(a, callee).name
            at.SetName(a, callee, intrinsic_method_canon(orig))
            sema_check_intrinsic_method_lang(
                s, orig, at.Get(a, callee).name, csp2
            )
        end

        if ov.kind == TY_MAP:
            m := at.Get(a, callee).name
            _do2 := sema_decorate(s, a, callee, objt)
            if str.Equals(m, "put"):
                check_pure_recv_mut(s, a, n, m)
                if argtypes.len() != 2:
                    serr(s, 12, sp, i18.Tr("put(key,value) takes 2 args"))
                end
                ret sema_decorate(s, a, n, sema_ty(s, TY_VOID))
            end
            if str.Equals(m, "get"):
                if argtypes.len() != 1:
                    serr(s, 12, sp, i18.Tr("get(key) takes 1 arg"))
                end
                ret sema_decorate(s, a, n, ov.elem)
            end
            if str.Equals(m, "has"):
                if argtypes.len() != 1:
                    serr(s, 12, sp, i18.Tr("has(key) takes 1 arg"))
                end
                ret sema_decorate(s, a, n, sema_ty(s, TY_BOOL))
            end
            if str.Equals(m, "remove"):
                check_pure_recv_mut(s, a, n, m)
                if argtypes.len() != 1:
                    serr(s, 12, sp, i18.Tr("remove(key) takes 1 arg"))
                end
                ret sema_decorate(s, a, n, sema_ty(s, TY_BOOL))
            end
            if str.Equals(m, "size"):
                ret sema_decorate(s, a, n, sema_ty(s, TY_I32))
            end
            if str.Equals(m, "iter"):
                ret sema_decorate(s, a, n, type_map_iter(s, ov.key, ov.elem))
            end
            serr(
                s, 17, sp, co.Format1(i18.Tr("HashMap has no method '%s'"), co.ArgStr(m))
            )
            ret sema_decorate(s, a, n, sema_err_ty(s))
        end
        if ov.kind == TY_MAP_ITER:
            m2 := at.Get(a, callee).name
            _dp2 := sema_decorate(s, a, callee, objt)
            if str.Equals(m2, "has_next"):
                ret sema_decorate(s, a, n, sema_ty(s, TY_BOOL))
            end
            if str.Equals(m2, "key"):
                ret sema_decorate(s, a, n, ov.key)
            end
            if str.Equals(m2, "value"):
                ret sema_decorate(s, a, n, ov.elem)
            end
            if str.Equals(m2, "next"):
                ret sema_decorate(s, a, n, sema_ty(s, TY_VOID))
            end
            serr(
                s, 17, sp, co.Format1(i18.Tr("MapIter has no method '%s'"), co.ArgStr(m2))
            )
            ret sema_decorate(s, a, n, sema_err_ty(s))
        end

        if ov.kind == TY_VEC:
            m3 := at.Get(a, callee).name
            _dq2 := sema_decorate(s, a, callee, objt)
            if ov.elem >= 0 && ty_at(s, ov.elem).kind == TY_DYN && (str.Equals(m3, "push") || str.Equals(m3, "set")):
                vi := str.Equals(m3, "push") ? 0 : 1
                if vi < at.ChildCount(a, n) && vi < argtypes.len():
                    nb := coerce_to_dyn(
                        s, a, ov.elem, at.Child(a, n, vi), argtypes.get(vi)[0]
                    )
                    mut cn := at.Get(a, n)
                    cn.list.set(vi, nb)
                    at.Put(a, n, cn)
                end
            end
            if str.Equals(m3, "push"):
                check_pure_recv_mut(s, a, n, m3)
                if argtypes.len() != 1:
                    serr(s, 12, sp, i18.Tr("push(value) takes 1 arg"))
                end
                ret sema_decorate(s, a, n, sema_ty(s, TY_VOID))
            end
            if str.Equals(m3, "pop"):
                check_pure_recv_mut(s, a, n, m3)
                ret sema_decorate(s, a, n, ov.elem)
            end
            if str.Equals(m3, "get"):
                if argtypes.len() != 1:
                    serr(s, 12, sp, i18.Tr("get(index) takes 1 arg"))
                end
                ret sema_decorate(s, a, n, type_ptr(s, ov.elem))
            end
            if str.Equals(m3, "set"):
                check_pure_recv_mut(s, a, n, m3)
                if argtypes.len() != 2:
                    serr(s, 12, sp, i18.Tr("set(index,value) takes 2 args"))
                end
                ret sema_decorate(s, a, n, sema_ty(s, TY_VOID))
            end
            if str.Equals(m3, "len"):
                ret sema_decorate(s, a, n, sema_ty(s, TY_I32))
            end
            if str.Equals(m3, "cap"):
                ret sema_decorate(s, a, n, sema_ty(s, TY_I32))
            end
            if str.Equals(m3, "free"):
                check_pure_recv_mut(s, a, n, m3)
                ret sema_decorate(s, a, n, sema_ty(s, TY_VOID))
            end
            serr(
                s, 17, sp, co.Format1(i18.Tr("Vector has no method '%s'"), co.ArgStr(m3))
            )
            ret sema_decorate(s, a, n, sema_err_ty(s))
        end

        if is_file_ptr:
            m4 := at.Get(a, callee).name
            _dr2 := sema_decorate(s, a, callee, objt)
            pf2 := sema_pure_fn(s, a)
            if pf2 != 0:
                serr(
                    s, 12, sp, co.Format2(
                        i18.Tr("'pure' function '%s' cannot call '%s': it has side effects"), co.ArgStr(at.Get(a, pf2).name),
                        co.ArgStr(m4)
                    )
                )
            end
            if str.Equals(m4, "read"):
                if argtypes.len() != 1:
                    serr(s, 12, sp, i18.Tr("read(size) takes 1 arg"))
                end
                ret sema_decorate(s, a, n, sema_ty(s, TY_STR))
            end
            if str.Equals(m4, "readline"):
                ret sema_decorate(s, a, n, sema_ty(s, TY_STR))
            end
            if str.Equals(m4, "write"):
                if argtypes.len() != 1:
                    serr(s, 12, sp, i18.Tr("write(data) takes 1 arg"))
                end
                ret sema_decorate(s, a, n, sema_ty(s, TY_I32))
            end
            if str.Equals(m4, "seek"):
                if argtypes.len() != 2:
                    serr(s, 12, sp, i18.Tr("seek(offset,whence) takes 2 args"))
                end
                ret sema_decorate(s, a, n, sema_ty(s, TY_I32))
            end
            if str.Equals(m4, "close"):
                ret sema_decorate(s, a, n, sema_ty(s, TY_VOID))
            end
            serr(
                s, 17, sp, co.Format1(i18.Tr("File has no method '%s'"), co.ArgStr(m4))
            )
            ret sema_decorate(s, a, n, sema_err_ty(s))
        end

        if ov.kind == TY_STR:
            m5 := at.Get(a, callee).name
            _ds2 := sema_decorate(s, a, callee, objt)
            if str.Equals(m5, "len"):
                ret sema_decorate(s, a, n, sema_ty(s, TY_I32))
            end
            if str.Equals(m5, "concat"):
                if argtypes.len() != 1:
                    serr(s, 12, sp, i18.Tr("concat(other) takes 1 arg"))
                end
                ret sema_decorate(s, a, n, sema_ty(s, TY_STR))
            end
            if str.Equals(m5, "substr"):
                if argtypes.len() != 2:
                    serr(s, 12, sp, i18.Tr("substr(start,len) takes 2 args"))
                end
                ret sema_decorate(s, a, n, sema_ty(s, TY_STR))
            end
            if str.Equals(m5, "find") || str.Equals(m5, "search") || str.Equals(m5, "indexOf"):
                if argtypes.len() != 1:
                    serr(
                        s, 12, sp, co.Format1(
                            i18.Tr("%s(sub) takes 1 arg"), co.ArgStr(m5)
                        )
                    )
                end
                ret sema_decorate(s, a, n, sema_ty(s, TY_I32))
            end
            if str.Equals(m5, "split"):
                if argtypes.len() != 1:
                    serr(s, 12, sp, i18.Tr("split(delim) takes 1 arg"))
                end
                ret sema_decorate(s, a, n, sema_vec_str(s, a, sp))
            end
            if str.Equals(m5, "trim"):
                ret sema_decorate(s, a, n, sema_ty(s, TY_STR))
            end
            if str.Equals(m5, "to_int"):
                ret sema_decorate(s, a, n, sema_ty(s, TY_I32))
            end
            if str.Equals(m5, "to_float"):
                ret sema_decorate(s, a, n, sema_ty(s, TY_F64))
            end
            if str.Equals(m5, "lower") || str.Equals(m5, "upper"):
                if argtypes.len() != 0:
                    serr(
                        s, 12, sp, co.Format1(
                            i18.Tr("%s() takes no args"), co.ArgStr(m5)
                        )
                    )
                end
                ret sema_decorate(s, a, n, sema_ty(s, TY_STR))
            end
            if str.Equals(m5, "repeat"):
                if argtypes.len() != 1:
                    serr(s, 12, sp, i18.Tr("repeat(n) takes 1 arg"))
                end
                ret sema_decorate(s, a, n, sema_ty(s, TY_STR))
            end
            ric := try_impl_call(s, a, n, callee, objt, argtypes)
            if ric != TYPE_NONE:
                ret ric
            end
            serr(
                s, 17, sp, co.Format1(i18.Tr("str has no method '%s'"), co.ArgStr(m5))
            )
            ret sema_decorate(s, a, n, sema_err_ty(s))
        end

        if ov.kind == TY_ARRAY || ov.kind == TY_SLICE:
            m6 := at.Get(a, callee).name
            _dt2 := sema_decorate(s, a, callee, objt)
            if str.Equals(m6, "len"):
                ret sema_decorate(s, a, n, sema_ty(s, TY_I32))
            end
            ric2 := try_impl_call(s, a, n, callee, objt, argtypes)
            if ric2 != TYPE_NONE:
                ret ric2
            end
            serr(
                s, 17, sp, co.Format1(i18.Tr("array has no method '%s'"), co.ArgStr(m6))
            )
            ret sema_decorate(s, a, n, sema_err_ty(s))
        end

        mut dynt := TYPE_NONE
        if ov.kind == TY_DYN:
            dynt = objt
        else ov.kind == TY_PTR && ov.pointee >= 0 && ty_at(s, ov.pointee).kind == TY_DYN:
            dynt = ov.pointee
        end
        if dynt >= 0 && ty_at(s, dynt).decl != 0:
            iface := ty_at(s, dynt).decl
            _du2 := sema_decorate(s, a, callee, objt)
            if str.Equals(at.Get(a, callee).name, "free"):
                ret sema_decorate(s, a, n, sema_ty(s, TY_VOID))
            end
            im := scope_member_canon(
                s, a, sym_at(s, iface).members, at.Get(a, callee).name, csp2
            )
            at.SetName(a, callee, im)
            md := scope_lookup_local(s, sym_at(s, iface).members, im)
            mut md_ok := md != 0
            if md_ok && sym_at(s, md).kind != SYM_METHOD:
                md_ok = false
            end
            if !md_ok:
                serr(
                    s, 17, sp, co.Format2(
                        i18.Tr("interface '%s' has no method '%s'"), co.ArgStr(sym_at(s, iface).name),
                        co.ArgStr(im)
                    )
                )
                ret sema_decorate(s, a, n, sema_err_ty(s))
            end
            sig4 := resolve_overload(s, a, md, argtypes, sp, im)
            mark_ref_args(s, a, n, sig4)
            coerce_args_to_dyn(s, a, n, argtypes, sig4)
            coerce_args_to_variant(s, a, n, argtypes, sig4)
            ret sema_decorate(s, a, n, sig_ret_or_err(s, sig4))
        end
        ssym := struct_sym_of(s, objt)
        if ssym == 0:
            ric3 := try_impl_call(s, a, n, callee, objt, argtypes)
            if ric3 != TYPE_NONE:
                ret ric3
            end
            serr(
                s, 29, sp, co.Format1(
                    i18.Tr("method call on non-struct type '%s'"), co.ArgStr(type_to_string(s, objt))
                )
            )
            ret sema_decorate(s, a, n, sema_err_ty(s))
        end
        ssv := sym_at(s, ssym)
        orig_method_name := at.Get(a, callee).name
        at.SetName(
            a, callee, scope_member_canon(s, a, ssv.members, orig_method_name, csp2)
        )
        if scope_lookup_local(s, ssv.members, at.Get(a, callee).name) == 0:
            intr := intrinsic_method_canon(at.Get(a, callee).name)
            if !str.Equals(intr, at.Get(a, callee).name) && scope_lookup_local(s, ssv.members, intr) != 0:
                at.SetName(a, callee, intr)
            end
        end
        if scope_lookup_local(s, ssv.members, at.Get(a, callee).name) != 0:
            sema_check_intrinsic_method_lang(
                s, orig_method_name, at.Get(a, callee).name, csp2
            )
        end
        mname := at.Get(a, callee).name
        m7 := scope_lookup_local(s, ssv.members, mname)

        mut is_func_field := false
        if m7 != 0:
            m7v := sym_at(s, m7)
            if m7v.kind == SYM_FIELD && m7v.ty >= 0 && ty_at(s, m7v.ty).kind == TY_FUNC:
                is_func_field = true
            end
        end
        if is_func_field:
            m7v2 := sym_at(s, m7)
            fft := m7v2.ty
            if !m7v2.is_pub && struct_sym_of(s, s.self_type) != ssym:
                serr(
                    s, 17, sp, co.Format2(
                        i18.Tr("field '%s' is private in struct '%s' (mark it 'pub')"), co.ArgStr(mname),
                        co.ArgStr(ssv.name)
                    )
                )
            end
            _dv2 := sema_decorate(s, a, callee, fft)
            pf3 := sema_pure_fn(s, a)
            if pf3 != 0:
                serr(
                    s, 12, sp, co.Format1(
                        i18.Tr("'pure' function '%s' cannot call a function value: its purity cannot be verified"),
                        co.ArgStr(at.Get(a, pf3).name)
                    )
                )
            end
            fftv := ty_at(s, fft)
            if argtypes.len() != fftv.params.len():
                serr(
                    s, 12, sp, co.Format3(
                        i18.Tr("function value takes %zu argument%s, got %zu"), co.ArgUint(fftv.params.len() as u64),
                        co.ArgStr(plural_suffix(fftv.params.len())), co.ArgUint(argtypes.len() as u64)
                    )
                )
            else:
                repeat argtypes.len() with gi:
                    if !type_assignable(
                        s, fftv.params.get(gi)[0], argtypes.get(gi)[0]
                    ):
                        serr(
                            s, 2, sp, co.Format3(
                                i18.Tr("argument %zu: cannot pass '%s' to '%s'"), co.ArgUint((gi + 1) as u64),
                                co.ArgStr(
                                    type_to_string(
                                        s, argtypes.get(gi)[0]
                                    )
                                ), co.ArgStr(
                                    type_to_string(
                                        s, fftv.params.get(gi)[0]
                                    )
                                )
                            )
                        )
                    end
                end
            end
            ret sema_decorate(s, a, n, fftv.elem)
        end
        mut m7_ok := m7 != 0
        if m7_ok && sym_at(s, m7).kind != SYM_METHOD:
            m7_ok = false
        end
        if !m7_ok:
            serr(
                s, 17, sp, co.Format2(
                    i18.Tr("no method '%s' for type '%s'"), co.ArgStr(mname), co.ArgStr(ssv.name)
                )
            )
            ret sema_decorate(s, a, n, sema_err_ty(s))
        end
        if !sym_at(s, m7).is_pub && struct_sym_of(s, s.self_type) != ssym:
            serr(
                s, 17, sp, co.Format2(
                    i18.Tr("method '%s' is private in struct '%s' (mark it 'pub')"), co.ArgStr(mname),
                    co.ArgStr(ssv.name)
                )
            )
        end
        sig5 := resolve_overload(s, a, m7, argtypes, sp, mname)
        mark_ref_args(s, a, n, sig5)
        coerce_args_to_dyn(s, a, n, argtypes, sig5)
        coerce_args_to_variant(s, a, n, argtypes, sig5)
        _dw2 := sema_decorate(s, a, callee, sym_at(s, m7).ty)
        if sig5 == 0:
            ret sema_decorate(s, a, n, sema_err_ty(s))
        end
        ret sema_decorate(
            s, a, n, g_localize_instance(s, a, sig_ret_or_err(s, sig5), sp)
        )
    end
    _dx2 := sema_check_expr(s, a, callee)
    serr(s, 12, sp, i18.Tr("expression is not callable"))
    ret sema_decorate(s, a, n, sema_err_ty(s))
end

// plural_suffix: "" for a count of exactly 1, "s" otherwise. Not a direct
// port of any one C function - each diagnostic call site below has its own
// static `plural_suffix` in the corresponding sema_*.c file; this is the
// single shared copy for the merged Salam file.
func plural_suffix(n: int): str:
    ret n == 1 ? "" : "s"
end

// ===========================================================================
// >>> 5b/5c/5d INSERTION POINT: add all new PRIVATE functions ABOVE this
// >>> banner (and new pub functions below, inside the PUBLIC API section).
// ===========================================================================

// ===========================================================================
// PUBLIC API (rule E088: every function from here on must be pub).
// PascalCase per PORTING.md, C module prefixes dropped.
// ===========================================================================

// sema_run_cached's state initialization as a constructor (the C had no
// sema_new; 5b's Run/RunCached will build on this). Seeds the primitive
// type table and the sentinel scope/symbol/sig slots, creates the global
// scope. lang "" defaults to "en" like the C.
pub func New(lgr: lg.Logger, file: str, lang: str): Sema:
    mut s := Sema {}
    s.log = lgr
    s.diag = dg.New(lgr, lg.PH_SEMANTIC)
    s.file = file
    if str.Len(lang) > 0:
        s.lang = lang
    else:
        s.lang = "en"
    end
    repeat TY_F64 + 1 with k:
        s.types.push(Type { kind = k })
    end
    s.scopes.push(Scope {})
    s.syms.push(Symbol {})
    s.sigs.push(Sig {})
    g := scope_new(s, SCOPE_GLOBAL, 0)
    mut gv := scope_at(s, g)
    gv.lang = s.lang
    scope_put(s, g, gv)
    s.global = g
    s.cur = g
    s.dir = dir_of(file)
    s.pkg = "main"
    ret s
end

// Releases every vector owned by the Sema (no C equivalent; arena freed all).
pub func Free(sm &: Sema):
    repeat sm.types.len() with i0:
        mut t := sm.types.get(i0)[0]
        t.params.free()
    end
    sm.types.free()
    sm.arrays_intern.free()
    sm.ptrs_intern.free()
    repeat sm.scopes.len() with i1:
        mut sc := sm.scopes.get(i1)[0]
        sc.symbols.free()
    end
    sm.scopes.free()
    repeat sm.syms.len() with i2:
        mut sy := sm.syms.get(i2)[0]
        sy.overloads.free()
        sy.generic_args.free()
    end
    sm.syms.free()
    repeat sm.sigs.len() with i3:
        mut sg := sm.sigs.get(i3)[0]
        sg.params.free()
    end
    sm.sigs.free()
    sm.imported.free()
    sm.pkg_cache_paths.free()
    sm.pkg_cache_syms.free()
    sm.loading.free()
    sm.pending.free()
    sm.lam.free()
    sm.match_yield_collect.free()
    mut tbl := sm.cctab
    cc.TableFree(tbl)
    mut e := sm.diag
    dg.Free(e)
    sm.diag = e
end

// Installs the condcomp table (sema_run's `cc` parameter); frees the
// default table built by the Sema literal.
pub func SetCc(sm &: Sema, table: cc.Table):
    mut old := sm.cctab
    cc.TableFree(old)
    sm.cctab = table
    sm.has_cc = true
end

// --- types.c ---

// type_prim
pub func Prim(sm &: Sema, kind: int): int:
    ret type_prim(sm, kind)
end

// type_array
pub func ArrayOf(sm &: Sema, elem: int, length: i64): int:
    ret type_array(sm, elem, length)
end

// type_slice
pub func SliceOf(sm &: Sema, elem: int): int:
    ret type_slice(sm, elem)
end

// type_ptr
pub func PtrTo(sm &: Sema, pointee: int): int:
    ret type_ptr(sm, pointee)
end

// type_struct
pub func StructType(sm &: Sema, decl_sym: int, name: str): int:
    ret type_struct(sm, decl_sym, name)
end

// type_enum
pub func EnumType(sm &: Sema, decl_sym: int, name: str): int:
    ret type_enum(sm, decl_sym, name)
end

// type_dyn
pub func DynType(sm &: Sema, iface_decl: int, name: str): int:
    ret type_dyn(sm, iface_decl, name)
end

// type_map
pub func MapOf(sm &: Sema, key: int, val: int): int:
    ret type_map(sm, key, val)
end

// type_map_iter
pub func MapIterOf(sm &: Sema, key: int, val: int): int:
    ret type_map_iter(sm, key, val)
end

// type_vec
pub func VecOf(sm &: Sema, elem: int): int:
    ret type_vec(sm, elem)
end

// type_file
pub func FileType(sm &: Sema): int:
    ret type_file(sm)
end

// type_func - params are TypeIds; the vector is copied (caller keeps it).
pub func FuncType(sm &: Sema, ret_t: int, params: Vector<int>): int:
    ret type_func_new(sm, ret_t, params)
end

// type_variant
pub func VariantOf(sm &: Sema, members: Vector<int>): int:
    ret type_variant_new(sm, members)
end

// type_variant_tag
pub func VariantTag(sm &: Sema, variant: int, member: int): int:
    ret type_variant_tag(sm, variant, member)
end

// type_prim_kind_from_name - lang "" = the C NULL (any language).
pub func PrimKindFromName(name: str, lang: str): int:
    ret type_prim_kind_from_name(name, lang)
end

pub func IsError(sm &: Sema, t: int): bool:
    ret type_is_error(sm, t)
end

pub func IsInteger(sm &: Sema, t: int): bool:
    ret type_is_integer(sm, t)
end

pub func IsFloat(sm &: Sema, t: int): bool:
    ret type_is_float(sm, t)
end

pub func IsNumeric(sm &: Sema, t: int): bool:
    ret type_is_numeric(sm, t)
end

pub func IsSigned(sm &: Sema, t: int): bool:
    ret type_is_signed(sm, t)
end

// type_equiv
pub func Equiv(sm &: Sema, a: int, b: int): bool:
    ret type_equiv(sm, a, b)
end

// type_assignable
pub func Assignable(sm &: Sema, dst: int, src: int): bool:
    ret type_assignable(sm, dst, src)
end

// type_castable
pub func Castable(sm &: Sema, dst: int, src: int): bool:
    ret type_castable(sm, dst, src)
end

// type_common_arith - TYPE_NONE where the C returned NULL.
pub func CommonArith(sm &: Sema, a: int, b: int): int:
    ret type_common_arith(sm, a, b)
end

// type_to_string
pub func ToString(sm &: Sema, t: int): str:
    ret type_to_string(sm, t)
end

// Raw record reads (backends/tests; TypeAt clamps bad ids to TY_ERROR).
pub func TypeAt(sm &: Sema, t: int): Type:
    ret ty_at(sm, t)
end

pub func TypeCount(sm &: Sema): int:
    ret sm.types.len()
end

// --- symbol.c ---

// scope_new
pub func NewScope(sm &: Sema, kind: int, parent: int): int:
    ret scope_new(sm, kind, parent)
end

// symbol_new
pub func NewSymbol(sm &: Sema, kind: int, name: str): int:
    ret symbol_new(sm, kind, name)
end

// scope_define - 0 on success, the existing SymId on duplicate.
pub func Define(sm &: Sema, sc: int, sym: int): int:
    ret scope_define(sm, sc, sym)
end

// scope_lookup_local
pub func LookupLocal(sm &: Sema, sc: int, name: str): int:
    ret scope_lookup_local(sm, sc, name)
end

// scope_lookup
pub func Lookup(sm &: Sema, sc: int, name: str): int:
    ret scope_lookup(sm, sc, name)
end

// scope_lookup_where
pub func LookupWhere(sm &: Sema, sc: int, name: str, where &: int): int:
    ret scope_lookup_where(sm, sc, name, where)
end

pub func ScopeAt(sm &: Sema, sc: int): Scope:
    ret scope_at(sm, sc)
end

pub func ScopePut(sm &: Sema, sc: int, v: Scope):
    scope_put(sm, sc, v)
end

pub func SymAt(sm &: Sema, id: int): Symbol:
    ret sym_at(sm, id)
end

pub func SymPut(sm &: Sema, id: int, v: Symbol):
    sym_put(sm, id, v)
end

// func_sig_t allocation (arena_alloc in the C; sigs are built field by
// field via SigAt/SigPut).
pub func NewSig(sm &: Sema): int:
    id := sm.sigs.len()
    sm.sigs.push(Sig {})
    ret id
end

pub func SigAt(sm &: Sema, id: int): Sig:
    ret sig_at(sm, id)
end

pub func SigPut(sm &: Sema, id: int, v: Sig):
    sig_put(sm, id, v)
end

// vec_push(&sym->overloads, sig)
pub func AddOverload(sm &: Sema, sym: int, sig: int):
    mut sy := sym_at(sm, sym)
    sy.overloads.push(sig)
    sym_put(sm, sym, sy)
end

// mangle_func - struct_name "" = the C NULL.
pub func MangleFunc(
    sm &: Sema, struct_name: str, fn_name: str, param_types: Vector<int>
