// sema_run - the whole-program check entry. The Sema must come from New()
// (plus SetCc for the condcomp table). Returns ok (= no errors); errors,
// warnings and diagnostics stay readable through sm.diag, the symbol table
// through sm.global + the 5a accessors, packages through PackageCount/At.
pub func Run(sm &: Sema, a &: at.Ast, program: int): bool:
    prog := at.Get(a, program)
    sm.program = program
    if str.Len(prog.name) > 0:
        sm.pkg = prog.name
    else:
        sm.pkg = "main"
    end
    lg.Log(
        sm.log, lg.PH_SEMANTIC, lg.LOG_INFO, "analyzing " + prog.list.len() + " top-level definitions"
    )
    load_imports(sm, a, program)
    if !str.Equals(sm.pkg, "core"):
        corep := resolve_import("", "core")
        if str.Len(corep) > 0:
            cimp := scratch_import_node(a)
            _core := load_package(sm, a, corep, cimp)
        end
    end
    sema_collect(sm, a, program)
    sema_check_toplevel_order(sm, a, program)
    sema_check_pass(sm, a, program)
    if !sm.in_pkg && !sm.relax_unused:
        sema_check_unused_funcs(sm, a)
        sema_check_unused_imports(sm, a)
    end
    ecount := dg.ErrorCount(sm.diag)
    wcount := dg.WarningCount(sm.diag)
    lg.Log(
        sm.log, lg.PH_SEMANTIC, lg.LOG_INFO, "analysis complete: " + ecount + " error" + plural_suffix(ecount) + ", " + wcount + " warning" + plural_suffix(wcount)
    )
    ret dg.ErrorCount(sm.diag) == 0
end

// sema_run_cached - PORT-NOTE: the C shared_pkg_cache pointer cannot cross
// Sema instances here (SymIds/ScopeIds are Sema-local); the package cache
// always lives in sm.pkg_cache_paths/syms, so this equals Run.
pub func RunCached(sm &: Sema, a &: at.Ast, program: int): bool:
    ret Run(sm, a, program)
end

// sema_result_t.packages - every load_package result, in load order.
pub func PackageCount(sm &: Sema): int:
    ret sm.pkg_cache_syms.len()
end

pub func PackageAt(sm &: Sema, i: int): int:
    ret sm.pkg_cache_syms.get(i)[0]
end

// symbols_to_xml - <symbols> with diagnostics then the global symbol tree.
pub func SymbolsToXml(w &: x.Writer, sm &: Sema):
    x.Open(w, "symbols")
    x.AttrInt(w, "errors", dg.ErrorCount(sm.diag) as i64)
    x.AttrInt(w, "warnings", dg.WarningCount(sm.diag) as i64)
    repeat dg.Count(sm.diag) with i:
        d := dg.ItemAt(sm.diag, i)
        x.Open(w, "diagnostic")
        x.Attr(w, "severity", d.sev == dg.SEV_ERROR ? "error" : "warning")
        x.AttrInt(w, "code", d.code as i64)
        x.AttrInt(w, "line", d.span.begin.line as i64)
        x.AttrInt(w, "col", d.span.begin.col as i64)
        x.Attr(w, "message", d.body)
        x.Close(w)
    end
    gsc := scope_at(sm, sm.global)
    repeat gsc.symbols.len() with i2:
        emit_symbol(w, sm, gsc.symbols.get(i2)[0])
    end
    x.Close(w)
end

