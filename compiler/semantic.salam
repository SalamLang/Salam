// 5d public API - layout schema init (driver hook) + dce.c surface.
// ===========================================================================

// layout_schema_init (layout/schema.c) - loads the std layout schema
// (elements/attributes/style/values) into the registry the layout checks
// read. The C driver calls this once at startup with the stdlib root;
// callers of Run that check layout blocks must do the same.
pub func LayoutSchemaInit(root: str):
    layout_schema_init(root)
end

// ---------------------------------------------------------------------------
// Layout registry accessors (added for the layout-generator port,
// salam/sal_layout.salam). The registry tables (layout/registry.c) live in
// this module because sema_layout.c needs them; the C layout generator
// linked against the same globals. Each accessor is a thin pub wrapper over
// the private lay_* slice above - indices replace the C's def pointers
// (-1 = C NULL), "" plays the C NULL string.
// ---------------------------------------------------------------------------

// layout_elem_lookup - element index, -1 = unknown.
pub func LayoutElemLookup(name: str): int:
