end

// salam_get_stdlib_root
pub func GetStdlibRoot(): str:
    ret get_stdlib_root()
end

// salam_find_sysroot - true and `out` set when a MinGW sysroot was found.
pub func FindSysroot(triple: str, out &: str): bool:
    sub := mingw_sysroot_subdir(triple)
    if str.Len(sub) == 0:
        ret false
    end
    env := os.Env("SALAM_SYSROOTS")
    if str.Len(env) > 0:
        cand := env + "/" + sub
        if sysroot_looks_valid(cand):
            out = cand
            ret true
        end
    end
    root := get_stdlib_root()
    if str.Len(root) > 0:
        cand2 := root + "/sysroots/" + sub
        if sysroot_looks_valid(cand2):
            out = cand2
            ret true
        end
    end
    mut exedir := ""
    if get_exe_dir(exedir):
        rel := [
            "sysroots", "../share/salam/sysroots", "../lib/salam/sysroots"
        ] as str[3]
        repeat 3 with i:
            cand3 := exedir + "/" + rel[i] + "/" + sub
            if sysroot_looks_valid(cand3):
                out = cand3
                ret true
            end
        end
    end
    ret false
end

// salam_find_bundled_tool - looks for `name` next to the executable.
pub func FindBundledTool(name: str, out &: str): bool:
    if str.Len(name) == 0:
        ret false
    end
    mut exedir := ""
    if !get_exe_dir(exedir):
        ret false
    end
    rel := [
        "", "bin", "toolchain/bin", "../toolchain/bin", "../lib/salam/toolchain/bin", "mingw64/bin",
        "llvm/bin", "tcc"
    ] as str[8]
    repeat 8 with i:
        mut cand := exedir + "/" + name + K_SM_EXE_SUFFIX
        if str.Len(rel[i]) > 0:
            cand = exedir + "/" + rel[i] + "/" + name + K_SM_EXE_SUFFIX
        end
        if os.Exists(cand) && !os.IsDir(cand):
            out = cand
            ret true
        end
    end
    ret false
end

// salam_find_path_tool - FindBundledTool's $PATH counterpart. The bundled
// lookup only ever matches a toolchain shipped inside the install tree, so
// on a plain source checkout - or any install that ships no compiler - it
// finds nothing and the caller falls through to its "tcc" sentinel,
// shelling out to a compiler that need not exist even on a host with clang
// or gcc installed.
pub func FindPathTool(name: str, out &: str): bool:
    if str.Len(name) == 0:
        ret false
    end
    path := os.Env("PATH")
    if str.Len(path) == 0:
        ret false
    end
    sep := K_SM_PATH_SEP
    mut rest := path
    until str.Len(rest) > 0:
        mut seg := rest
        idx := str.IndexOf(rest, sep)
        if idx >= 0:
            seg = str.Substr(rest, 0, idx)
            rest = str.Substr(rest, idx + 1, str.Len(rest) - idx - 1)
        else:
            rest = ""
        end
        if str.Len(seg) > 0:
            cand := seg + "/" + name + K_SM_EXE_SUFFIX
            if os.Exists(cand) && !os.IsDir(cand):
                out = cand
                ret true
            end
        end
    end
    ret false
end

