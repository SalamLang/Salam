// ===========================================================================
// PUBLIC API (rule E088: every function from here on must be pub).
// PascalCase per PORTING.md, C module prefixes dropped.
// ===========================================================================

// sema_run_cached's state initialization as a constructor (the C had no
// sema_new; 5b's Run/RunCached will build on this). Seeds the primitive
// type table and the sentinel scope/symbol/sig slots, creates the global
// scope. lang "" defaults to "en" like the C.
pub func New(lgr: lg.Logger, file: str, lang: str): Sema:
    mut s := Sema {}
    s.log = lgr
    s.diag = dg.New(lgr, lg.PH_SEMANTIC)
    s.file = file
    if str.Len(lang) > 0:
        s.lang = lang
    else:
        s.lang = "en"
    end
    repeat TY_F64 + 1 with k:
        s.types.push(Type { kind = k })
    end
    s.scopes.push(Scope {})
    s.syms.push(Symbol {})
    s.sigs.push(Sig {})
    g := scope_new(s, SCOPE_GLOBAL, 0)
    mut gv := scope_at(s, g)
    gv.lang = s.lang
    scope_put(s, g, gv)
    s.global = g
    s.cur = g
    s.dir = dir_of(file)
    s.pkg = "main"
    // Same pickup Rebind does below. The C reads the process-wide switch in
    // sema_run_cached, which every analysis goes through; here New and
    // Rebind are two doors into the same place, and the REPL - the only
    // caller that sets the switch - comes through this one.
    s.relax_unused = g_sm_relax_unused
    ret s
end

// Re-points one Sema at the next file of a build instead of building a new
// one, so every imported package is loaded/parsed/analyzed once per build
// rather than once per importer (the C gets this from sema_run_cached's
// shared_pkg_cache: there symbols are arena pointers that outlive each
// sema_t, here they are SymIds into syms/scopes/sigs, so the Sema itself is
// what has to persist).
//
// KEEPS the symbol/type/scope storage, the package cache and the prelude.
// RESETS everything per-file and installs a FRESH global scope, matching the
// C where each sema_run has its own scope tree over a shared symbol arena.
// Returns the new global ScopeId: the caller must hand it back via
// RebindScope before codegen, which resolves names through s.global.
//
// The caller must also keep ONE at.Ast alive for the whole build - cached
// package symbols hold NodeIds into the tree they were parsed from.
pub func Rebind(sm &: Sema, file: str, lang: str): int:
    sm.diag = dg.New(sm.log, lg.PH_SEMANTIC)
    sm.file = file
    if str.Len(lang) > 0:
        sm.lang = lang
    else:
        sm.lang = "en"
    end
    g := scope_new(sm, SCOPE_GLOBAL, 0)
    mut gv := scope_at(sm, g)
    gv.lang = sm.lang
    scope_put(sm, g, gv)
    sm.global = g
    sm.cur = g
    sm.dir = dir_of(file)
    sm.pkg = "main"
    sm.self_type = TYPE_NONE
    sm.cur_func = 0
    sm.loop_depth = 0
    sm.program = 0
    sm.expected = TYPE_NONE
    sm.gen_pkg = 0
    sm.in_pkg = false
    sm.relax_unused = g_sm_relax_unused
    sm.requal = false
    sm.each_n = 0
    sm.match_arm_depth = 0
    sm.match_yield_expected = TYPE_NONE
    sm.match_yield_active = false
    sm.imported.clear()
    sm.loading.clear()
    sm.pending.clear()
    sm.lam.clear()
    sm.match_yield_collect.clear()
    ret g
end

// Restores the per-file view recorded by Rebind. Codegen resolves top-level
// names through s.global/s.pkg, so a shared Sema must be pointed back at the
// right file's scope before generating that file's C.
pub func RebindScope(sm &: Sema, scope: int, pkg: str, file: str):
    sm.global = scope
    sm.cur = scope
    sm.pkg = pkg
    sm.file = file
    sm.dir = dir_of(file)
end

// Releases every vector owned by the Sema (no C equivalent; arena freed all).
pub func Free(sm &: Sema):
    repeat sm.types.len() with i0:
        mut t := sm.types.get(i0)[0]
        t.params.free()
    end
    sm.types.free()
    sm.arrays_intern.free()
    sm.ptrs_intern.free()
    repeat sm.scopes.len() with i1:
        mut sc := sm.scopes.get(i1)[0]
        sc.symbols.free()
    end
    sm.scopes.free()
    repeat sm.syms.len() with i2:
        mut sy := sm.syms.get(i2)[0]
        sy.overloads.free()
        sy.generic_args.free()
    end
    sm.syms.free()
    repeat sm.sigs.len() with i3:
        mut sg := sm.sigs.get(i3)[0]
        sg.params.free()
    end
    sm.sigs.free()
    sm.imported.free()
    sm.pkg_cache_paths.free()
    sm.pkg_cache_syms.free()
    sm.loading.free()
    sm.pending.free()
    sm.lam.free()
    sm.match_yield_collect.free()
    mut tbl := sm.cctab
    cc.TableFree(tbl)
    mut e := sm.diag
    dg.Free(e)
    sm.diag = e
end

// Installs the condcomp table (sema_run's `cc` parameter); frees the
// default table built by the Sema literal.
pub func SetCc(sm &: Sema, table: cc.Table):
    mut old := sm.cctab
    cc.TableFree(old)
    sm.cctab = table
    sm.has_cc = true
end

