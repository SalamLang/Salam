pub func BuiltinAt(i: int): Builtin:
    mut b := Builtin {}
    if i < 0 || i >= K_SM_BUILTIN_COUNT:
        ret b
    end
    b.name = k_sm_builtin_names[i]
    b.runtime = k_sm_builtin_runtime[i]
    b.nargs = k_sm_builtin_nargs[i]
    b.ret_type = k_sm_builtin_ret[i]
    b.arg = k_sm_builtin_arg[i]
    ret b
end

