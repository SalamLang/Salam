pub func FindSysroot(triple: str, out &: str): bool:
    sub := mingw_sysroot_subdir(triple)
    if str.Len(sub) == 0:
        ret false
    end
    env := os.Env("SALAM_SYSROOTS")
    if str.Len(env) > 0:
        cand := pth.PathJoin(env, sub)
        if sysroot_looks_valid(cand):
            out = cand
            ret true
        end
    end
    root := get_stdlib_root()
    if str.Len(root) > 0:
        cand2 := pth.PathJoin(pth.PathJoin(root, "sysroots"), sub)
        if sysroot_looks_valid(cand2):
            out = cand2
            ret true
        end
    end
    mut exedir := ""
    if get_exe_dir(exedir):
        rel := [
            "sysroots", "../share/salam/sysroots", "../lib/salam/sysroots"
        ]
        repeat 3 with i:
            cand3 := pth.PathJoin(pth.PathJoin(exedir, rel[i]), sub)
            if sysroot_looks_valid(cand3):
                out = cand3
                ret true
            end
        end
    end
    ret false
end

pub func FindBundledTool(name: str, out &: str): bool:
    if str.Len(name) == 0:
        ret false
    end
    mut exedir := ""
    if !get_exe_dir(exedir):
        ret false
    end
    rel := [
        "", "bin", "toolchain/bin", "../toolchain/bin", "../lib/salam/toolchain/bin", "mingw64/bin", "llvm/bin", "tcc"
    ]
    repeat 8 with i:
        cand := pth.PathJoin(pth.PathJoin(exedir, rel[i]), name + K_SM_EXE_SUFFIX)
        if os.Exists(cand) && !os.IsDir(cand):
            out = cand
            ret true
        end
    end
    ret false
end

pub func FindPathTool(name: str, out &: str): bool:
    if str.Len(name) == 0:
        ret false
    end
    path := os.Env("PATH")
    if str.Len(path) == 0:
        ret false
    end
    sep := K_SM_PATH_SEP
    mut rest := path
    until str.Len(rest) > 0:
        mut seg := rest
        idx := str.IndexOf(rest, sep)
        if idx >= 0:
            seg = str.Substr(rest, 0, idx)
            rest = str.Substr(rest, idx + 1, str.Len(rest) - idx - 1)
        else:
            rest = ""
        end
        if str.Len(seg) > 0:
            cand := pth.PathJoin(seg, name + K_SM_EXE_SUFFIX)
            if os.Exists(cand) && !os.IsDir(cand):
                out = cand
                ret true
            end
        end
    end
    ret false
end

