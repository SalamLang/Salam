    ret g_sm_lay_elem_tag.get(i)[0]
end

// layout_elem_def_t.type (LE_* value: 0 Single, 1 Mother, ...).
pub func LayoutElemKind(i: int): int:
    ret g_sm_lay_elem_type.get(i)[0]
end

// layout_attr_lookup - attribute index, -1 = unknown.
pub func LayoutAttrLookup(name: str): int:
    ret lay_attr_lookup(name)
end

// layout_attr_def_t.out ("" = C NULL).
pub func LayoutAttrOut(i: int): str:
    ret g_sm_lay_attr_out.get(i)[0]
end

// layout_attr_def_t.dest (LA_* value).
pub func LayoutAttrDest(i: int): int:
    ret g_sm_lay_attr_dest.get(i)[0]
end

// layout_attr_def_t.vtype (VT_* value).
pub func LayoutAttrVtype(i: int): int:
    ret g_sm_lay_attr_vtype.get(i)[0]
end

// layout_attr_def_t.allowed ("" = C NULL).
pub func LayoutAttrAllowed(i: int): str:
    ret g_sm_lay_attr_allowed.get(i)[0]
end

// registry.c dyn_value - canonical spelling for (group, v), "" = C NULL.
// The layout generator uses it for the "dir"/"lang"/"unit" groups and for
// VT_ENUM allowed-group mapping (layout_attr_value_map).
pub func LayoutDynValue(group: str, v: str): str:
    ret lay_dyn_value(group, v)
end

// layout_map_color - "" = C NULL (needed by layout_attr_value_map's
// VT_COLOR arm in the generator).
pub func LayoutMapColor(v: str): str:
    ret lay_map_color(v)
end

// sema_set_relax_unused - turn the "you declared it and never used it"
// family of errors (unused variable / unused `mut` / unused function /
// unused import) off for every later analysis in this process.
//
// Only the REPL sets this. A turn is a slice of a program still being
// typed: `mut xs := Vector {}` is a complete, correct thought whose first
// use arrives on the next line, and a helper `func` is worth defining
// several turns before it is called. Rejecting those is right in a source
// file and useless at a prompt.
// (`on` would read better than `relax` here, but it is the keyword that
// binds an impl block to its type, so it cannot be a parameter name.)
pub func SetRelaxUnused(relax: bool):
    g_sm_relax_unused = relax
end

// dce_reset - the C took the arena; the port's vectors own their storage.
pub func DceReset():
    g_sm_dce_edge_from.free()
    g_sm_dce_edge_to.free()
    g_sm_dce_roots.free()
    g_sm_dce_reach.free()
    g_sm_dce_edge_from = Vector {} as Vector<str>
    g_sm_dce_edge_to = Vector {} as Vector<str>
    g_sm_dce_roots = Vector {} as Vector<str>
    g_sm_dce_reach = Vector {} as Vector<str>
    g_sm_dce_enabled = false
    g_sm_dce_init = true
end

// dce_enable
pub func DceEnable():
    g_sm_dce_enabled = true
end

// dce_disable
pub func DceDisable():
    g_sm_dce_enabled = false
end

// dce_enabled
pub func DceEnabled(): bool:
    ret g_sm_dce_enabled
end

// dce_mark_root
pub func DceMarkRoot(pkg: str, fn: str):
    dce_mark_root(pkg, fn)
end

// dce_note_call
pub func DceNoteCall(
    caller_pkg: str, caller_fn: str, callee_pkg: str, callee_fn: str
):
    dce_note_call(caller_pkg, caller_fn, callee_pkg, callee_fn)
end

// dce_finish - roots -> reachable closure over the recorded call edges.
pub func DceFinish():
    if !g_sm_dce_init:
        ret
    end
    g_sm_dce_reach.free()
    g_sm_dce_reach = Vector {} as Vector<str>
    mut worklist := Vector {} as Vector<str>
    defer worklist.free()
    repeat g_sm_dce_roots.len() with i:
        k := g_sm_dce_roots.get(i)[0]
        if dce_key_in(g_sm_dce_reach, k):
            continue
        end
        g_sm_dce_reach.push(k)
        worklist.push(k)
    end
    until worklist.len() > 0:
        cur := worklist.get(worklist.len() - 1)[0]
        _p := worklist.pop()
        repeat g_sm_dce_edge_from.len() with j:
            if !str.Equals(g_sm_dce_edge_from.get(j)[0], cur):
                continue
            end
            dst := g_sm_dce_edge_to.get(j)[0]
            if dce_key_in(g_sm_dce_reach, dst):
                continue
            end
            g_sm_dce_reach.push(dst)
            worklist.push(dst)
        end
    end
end

// dce_reachable
pub func DceReachable(pkg: str, fn: str): bool:
    if !g_sm_dce_init:
        ret true
    end
    ret dce_key_in(g_sm_dce_reach, dce_key(pkg, fn))
end

// sema_lvalue_mutable (sema_stmt.c) - thin wrapper over the write
// classifier; the C declares it in sema_internal.h but nothing calls it,
// so the port exposes it here for backend waves instead of as a dead
// private helper.
pub func LvalueMutable(
    sm &: Sema, a &: at.Ast, n: int, is_lvalue &: bool
): bool:
    mut root := 0
    v := sema_classify_write(sm, a, n, root)
    is_lvalue = v != LV_NOT_LVALUE
    ret v == LV_OK
end
