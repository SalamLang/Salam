package semantic

import str

include co "../sal_core.salam"
include tok "../token.salam"
include at "../ast.salam"
include i18 "../i18n.salam"

func sema_cast_target_is_context_dependent(s &: Sema, a &: at.Ast, aid: int, target: int): bool:
    if aid == 0:
        ret false
    end
    an := at.Get(a, aid)
    if an.kind == at.AST_ARRAY_LIT:
        if at.ChildCount(a, aid) == 0:
            ret true
        end
        ret target >= 0 and ty_at(s, target).kind == TY_ARRAY and ty_at(s, target).elem >= 0 and ty_at(s, ty_at(s, target).elem).kind == TY_DYN
    end
    if an.kind == at.AST_STRUCT_LIT or an.kind == at.AST_CALL:
        ret true
    end
    if an.kind == at.AST_VARIANT_BOX and an.synthetic:
        ret true
    end
    if an.kind == at.AST_LITERAL:
        ret an.op == tok.TK_INT or an.op == tok.TK_FLOAT
    end
    ret false
end

func func_addr_target_ok(s &: Sema, a &: at.Ast, sym: int, fname: str, sp: co.SrcSpan): bool:
    fsv := sym_at(s, sym)
    mut only_generic := false
    if fsv.overloads.len() == 1:
        sg0 := sig_at(s, fsv.overloads.get(0))
        if sg0.decl != 0 and at.TyparamCount(a, sg0.decl) > 0:
            only_generic = true
        end
    end
    if fsv.overloads.len() == 0 or only_generic:
        serr(
            s, 73, sp, co.Format1(
                i18.Tr("cannot take the address of generic function '%s'"), co.ArgStr(fname)
            )
        )
        ret false
    end
    if fsv.overloads.len() > 1:
        serr(
            s, 74, sp, co.Format2(
                i18.Tr("function '%s' is ambiguous as a value (%zu overloads exist)"), co.ArgStr(fname), co.ArgUint(fsv.overloads.len() as u64)
            )
        )
        ret false
    end
    ret true
end

func check_cast_in_context(
    s &: Sema, a &: at.Ast, inner: int, sp: co.SrcSpan, want: int, target: int, o3: int
):
    if want < 0 or target < 0 or s.in_derive:
        ret
    end
    if type_is_error(s, want) or type_is_error(s, target) or type_is_error(s, o3):
        ret
    end
    if not type_equiv(s, want, target):
        serr(
            s, 94, sp, co.Format2(
                i18.Tr(
                    "an explicit cast here must produce '%s', the type this position requires, not '%s'"
                ), co.ArgStr(type_disp(s, want)), co.ArgStr(type_disp(s, target))
            )
        )
        ret
    end
    same_class := type_equiv(s, want, o3) or (type_is_integer(s, want) and type_is_integer(s, o3))
    if same_class and (type_assignable(s, want, o3) or widens_nonneg(s, a, inner, want, o3)):
        serr(
            s, 93, sp, co.Format1(
                i18.Tr("useless cast: this position already requires '%s'; remove the cast"), co.ArgStr(type_disp(s, want))
            )
        )
    end
end

func input_var_prompt(s &: Sema, a &: at.Ast, nid: int, name: str, sp: co.SrcSpan): bool:
    mut head := "input "
    if not str.StartsWith(name, head):
        head = "ورودی "
        if not str.StartsWith(name, head):
            ret false
        end
    end
    mut rest := str.Substr(name, str.Len(head), str.Len(name) - str.Len(head))
    if scope_lookup(s, s.cur, rest) == 0:
        rest = local_canon(s, a, rest, sp)
        if scope_lookup(s, s.cur, rest) == 0:
            ret false
        end
    end
    mut cn := at.Get(a, nid)
    cn.name = "input"
    cn.list = Vector {} as Vector<int>
    callee := at.NewNode(a, at.AST_IDENTIFIER)
    at.Put(a, callee, cn)
    cn.name = rest
    arg := at.NewNode(a, at.AST_IDENTIFIER)
    at.Put(a, arg, cn)
    mut n := at.Get(a, nid)
    n.kind = at.AST_CALL
    n.name = ""
    n.a = callee
    n.list = Vector {} as Vector<int>
    n.list.push(arg)
    at.Put(a, nid, n)
    ret true
end

func sema_check_expr(s &: Sema, a &: at.Ast, nid: int): int:
    if nid == 0:
        ret sema_ty(s, TY_VOID)
    end
    k := at.KindOf(a, nid)
    if k != at.AST_LITERAL and k != at.AST_STRUCT_LIT and k != at.AST_ARRAY_LIT and k != at.AST_CALL and k != at.AST_TERNARY and k != at.AST_MATCH and k != at.AST_MEMBER:
        s.expected = TYPE_NONE
    end
    cast_ctx := s.cast_ctx
    s.cast_ctx = TYPE_NONE
    sp := span_of(a, nid)
    if k == at.AST_LITERAL:
        n := at.Get(a, nid)
        exp := s.expected
        s.expected = TYPE_NONE
        mut t := sema_err_ty(s)
        if n.op == tok.TK_INT:
            u := n.value_int
            if exp >= 0 and type_is_integer(s, exp) and int_lit_fits(u, ty_at(s, exp).kind):
                t = exp
            else u <= 2147483647 as u64:
                t = sema_ty(s, TY_I32)
            else u <= 9223372036854775807 as u64:
                t = sema_ty(s, TY_I64)
            else str.StartsWith(n.type_str, "i"):
                sv := u as i64
                t = sema_ty(s, sv >= (0 - 2147483648) as i64 ? TY_I32 : TY_I64)
            else:
                t = sema_ty(s, TY_U64)
            end
        else n.op == tok.TK_FLOAT:
            t = exp >= 0 and type_is_float(s, exp) ? exp : sema_ty(s, TY_F64)
        else n.op == tok.TK_STRING or n.op == tok.TK_TRIPLE_STRING or n.op == tok.TK_RAW_STRING:
            t = sema_ty(s, TY_STR)
        else n.op == tok.TK_CHAR:
            t = sema_ty(s, TY_CHAR)
        else n.op == tok.TK_UTF8_CHAR:
            t = sema_ty(s, TY_UCHAR)
        else n.op == tok.TK_KW_TRUE or n.op == tok.TK_KW_FALSE:
            t = sema_ty(s, TY_BOOL)
        else n.op == tok.TK_KW_NULL:
            t = sema_ty(s, TY_NULL)
        end
        if exp >= 0 and type_distinct_sym(s, exp) != 0 and t >= 0 and ty_at(s, t).kind == ty_at(s, exp).kind:
            t = exp
        end
        ret sema_decorate(s, a, nid, t)
    end
    if k == at.AST_IDENTIFIER and at.Get(a, nid).unwrap_subj:
        ret sema_decorate(s, a, nid, at.Get(a, nid).sema_type)
    end
    if k == at.AST_IDENTIFIER:
        mut name := at.Get(a, nid).name
        if at.NameIsErr(name):
            ret sema_decorate(s, a, nid, sema_err_ty(s))
        end
        mut sym := scope_lookup(s, s.cur, name)
        if sym == 0:
            c := local_canon(s, a, name, sp)
            if not str.Equals(c, name):
                name = c
                at.SetName(a, nid, c)
                sym = scope_lookup(s, s.cur, name)
            end
        end
        if sym == 0:
            mut is_str_lit := false
            if builtin_global_const(a, nid, name, is_str_lit):
                ret sema_check_expr(s, a, nid)
            end
        end
        if sym == 0 and input_var_prompt(s, a, nid, name, sp):
            ret sema_check_expr(s, a, nid)
        end
        if sym == 0:
            serr(
                s, 1, sp, co.Format1(i18.Tr("unknown identifier '%s'"), co.ArgStr(name))
            )
            ret sema_decorate(s, a, nid, sema_err_ty(s))
        end
        sv := sym_at(s, sym)
        if sv.kind == SYM_METHOD:
            serr(
                s, 1, sp, co.Format1(
                    i18.Tr("method '%s' used as a value (call it)"), co.ArgStr(name)
                )
            )
            ret sema_decorate(s, a, nid, sema_err_ty(s))
        end
        if sv.kind == SYM_FUNC:
            if not func_addr_target_ok(s, a, sym, name, sp):
                ret sema_decorate(s, a, nid, sema_err_ty(s))
            end
            mut fvs := sym_at(s, sym)
            fvs.used = true
            sym_put(s, sym, fvs)
            dce_mark_root(s.pkg, fvs.name)
            mut fvn := at.Get(a, nid)
            fvn.func_value = true
            at.Put(a, nid, fvn)
            ret sema_decorate(s, a, nid, sema_ty(s, TY_I64))
        end
        if sv.kind == SYM_STRUCT or sv.kind == SYM_ENUM:
            serr(
                s, 1, sp, co.Format1(
                    i18.Tr("type '%s' used as a value"), co.ArgStr(name)
                )
            )
            ret sema_decorate(s, a, nid, sema_err_ty(s))
        end
        mut svm := sym_at(s, sym)
        svm.used = true
        sym_put(s, sym, svm)
        if s.lam.len() > 0 and (svm.kind == SYM_VAR or svm.kind == SYM_PARAM):
            top := s.lam.get(s.lam.len() - 1)
            if not defined_within(s, s.cur, top.boundary, name) and scope_lookup_local(s, s.global, name) == 0:
                record_capture(s, a, nid, svm.ty)
            end
        end
        if svm.kind == SYM_PARAM and svm.is_ref:
            mut nv := at.Get(a, nid)
            nv.is_ref = true
            at.Put(a, nid, nv)
        end
        if svm.ty < 0 and (svm.kind == SYM_VAR or svm.kind == SYM_CONST) and svm.home == s.global:
            serr(
                s, 97, sp, co.Format1(
                    i18.Tr("global '%s' is used before its declaration; move it above this line"), co.ArgStr(name)
                )
            )
            ret sema_decorate(s, a, nid, sema_err_ty(s))
        end
        ret sema_decorate(s, a, nid, svm.ty)
    end
    if k == at.AST_FUNC_ADDR:
        mut fname := at.Get(a, nid).name
        if at.NameIsErr(fname):
            ret sema_decorate(s, a, nid, sema_err_ty(s))
        end
        pkgid := at.Get(a, nid).a
        if pkgid != 0 and at.KindOf(a, pkgid) == at.AST_IDENTIFIER:
            pname := at.Get(a, pkgid).name
            pk := scope_lookup(s, s.cur, pname)
            if pk == 0 or sym_at(s, pk).kind != SYM_PACKAGE:
                serr(
                    s, 1, sp, co.Format3(
                        i18.Tr("unknown package '%s' in '&%s.%s'"), co.ArgStr(pname), co.ArgStr(pname), co.ArgStr(fname)
                    )
                )
                ret sema_decorate(s, a, nid, sema_err_ty(s))
            end
            pkv2 := sym_at(s, pk)
            fname = pkg_member_canon(s, a, pk, fname, sp)
            at.SetName(a, nid, fname)
            m3 := scope_lookup_local(s, pkv2.members, fname)
            if m3 == 0 or sym_at(s, m3).kind != SYM_FUNC:
                serr(
                    s, 72, sp, co.Format2(
                        i18.Tr("'&%s.%s' requires a function"), co.ArgStr(pkv2.name), co.ArgStr(fname)
                    )
                )
                ret sema_decorate(s, a, nid, sema_err_ty(s))
            end
            mv3 := sym_at(s, m3)
            if not mv3.is_pub:
                serr(
                    s, 17, sp, co.Format2(
                        i18.Tr("'%s' is not exported by package '%s' (mark it 'pub')"), co.ArgStr(fname), co.ArgStr(pkv2.name)
                    )
                )
                ret sema_decorate(s, a, nid, sema_err_ty(s))
            end
            if not func_addr_target_ok(s, a, m3, fname, sp):
                ret sema_decorate(s, a, nid, sema_err_ty(s))
            end
            mut mv3u := sym_at(s, m3)
            mv3u.used = true
            sym_put(s, m3, mv3u)
            dce_mark_root(
                str.Len(mv3u.pkgname) > 0 ? mv3u.pkgname : pkv2.name, mv3u.name
            )
            _dpa := sema_decorate(s, a, pkgid, pkv2.ty)
            ret sema_decorate(s, a, nid, type_ptr(s, sema_ty(s, TY_VOID)))
        end
        mut fsym := scope_lookup(s, s.cur, fname)
        if fsym == 0:
            c2 := local_canon(s, a, fname, sp)
            if not str.Equals(c2, fname):
                fname = c2
                at.SetName(a, nid, c2)
                fsym = scope_lookup(s, s.cur, fname)
            end
        end
        if fsym == 0:
            serr(
                s, 1, sp, co.Format1(
                    i18.Tr("unknown identifier '%s'"), co.ArgStr(fname)
                )
            )
            ret sema_decorate(s, a, nid, sema_err_ty(s))
        end
        fsv := sym_at(s, fsym)
        if fsv.kind == SYM_METHOD:
            serr(
                s, 72, sp, co.Format1(
                    i18.Tr("'%s' is a method, not a free function; '&' cannot address it"), co.ArgStr(fname)
                )
            )
            ret sema_decorate(s, a, nid, sema_err_ty(s))
        end
        if fsv.kind != SYM_FUNC:
            serr(
                s, 72, sp, co.Format2(
                    i18.Tr("'&%s' requires a function, '%s' is not one"), co.ArgStr(fname), co.ArgStr(fname)
                )
            )
            ret sema_decorate(s, a, nid, sema_err_ty(s))
        end
        if not func_addr_target_ok(s, a, fsym, fname, sp):
            ret sema_decorate(s, a, nid, sema_err_ty(s))
        end
        mut fsm := sym_at(s, fsym)
        fsm.used = true
        sym_put(s, fsym, fsm)
        dce_mark_root(s.pkg, fsm.name)
        ret sema_decorate(s, a, nid, type_ptr(s, sema_ty(s, TY_VOID)))
    end
    if k == at.AST_THIS:
        if s.self_type < 0:
            serr(s, 14, sp, i18.Tr("'this' used outside a method"))
            ret sema_decorate(s, a, nid, sema_err_ty(s))
        end
        ret sema_decorate(s, a, nid, s.self_type)
    end
    if k == at.AST_BINARY:
        bt := check_binary(s, a, nid)
        sema_fold_expr(s, a, nid)
        ret bt
    end
    if k == at.AST_TERNARY:
        tt := check_ternary(s, a, nid)
        sema_fold_expr(s, a, nid)
        ret tt
    end
    if k == at.AST_MATCH:
        ret sema_check_match(s, a, nid, true, s.expected)
    end
    if k == at.AST_UNARY:
        n2 := at.Get(a, nid)
        o := sema_check_expr(s, a, n2.a)
        du := distinct_try_unary(s, a, nid, o)
        if du != TYPE_NONE:
            ret du
        end
        ssym := struct_sym_of(s, o)
        if ssym != 0:
            mut mname := ""
            if n2.op == tok.TK_MINUS:
                mname = "operator_sub"
            else n2.op == tok.TK_NOT:
                mname = "operator_not"
            end
            if str.Len(mname) > 0:
                ovl := sema_try_op_overload(s, a, nid, ssym, mname, TYPE_NONE)
                if ovl != TYPE_NONE:
                    ret sema_decorate(s, a, nid, ovl)
                end
            end
        end
        if n2.op == tok.TK_NOT:
            if ty_at(s, o).kind != TY_BOOL and not type_is_error(s, o):
                serr(s, 21, sp, i18.Tr("operator 'not' requires a bool operand"))
            end
            bt2 := sema_decorate(s, a, nid, sema_ty(s, TY_BOOL))
            sema_fold_expr(s, a, nid)
            ret bt2
        end
        if n2.op == tok.TK_TILDE:
            if not type_is_integer(s, o) and not type_is_error(s, o):
                serr(
                    s, 21, sp, i18.Tr("operator '~' requires an integer operand")
                )
            end
            ut := sema_decorate(s, a, nid, o)
            sema_fold_expr(s, a, nid)
            ret ut
        end
        if not type_is_numeric(s, o) and not type_is_error(s, o):
            serr(s, 21, sp, i18.Tr("unary '-' requires a numeric operand"))
        end
        ut2 := sema_decorate(s, a, nid, o)
        sema_fold_expr(s, a, nid)
        ret ut2
    end
    if k == at.AST_INCDEC:
        n3 := at.Get(a, nid)
        o2 := sema_check_expr(s, a, n3.a)
        opname := n3.op == tok.TK_PLUS_PLUS ? "'++'" : "'--'"
        mut wroot := 0
        verdict := sema_classify_write(s, a, n3.a, wroot)
        if verdict == LV_NOT_LVALUE:
            serr(
                s, 13, sp, co.Format1(
                    i18.Tr("operator %s requires an assignable operand"), co.ArgStr(opname)
                )
            )
        else verdict == LV_CONST:
            serr(
                s, 13, sp, co.Format2(
                    i18.Tr("cannot apply %s to '%s': a 'const' binding is fully immutable"), co.ArgStr(opname), co.ArgStr(wroot != 0 ? sym_at(s, wroot).name : "target")
                )
            )
        else verdict == LV_IMMUTABLE:
            serr(
                s, 13, sp, co.Format2(
                    i18.Tr("cannot apply %s to immutable variable '%s'; declare it 'mut'"), co.ArgStr(opname), co.ArgStr(wroot != 0 ? sym_at(s, wroot).name : "target")
                )
            )
        else:
            sema_check_pure_write(s, a, n3.a, sp)
            sema_check_mut_write(s, a, n3.a, sp)
        end
        if not type_is_numeric(s, o2) and not type_is_error(s, o2):
            serr(
                s, 21, sp, co.Format1(
                    i18.Tr("operator %s requires a numeric operand"), co.ArgStr(opname)
                )
            )
        end
        ret sema_decorate(s, a, nid, o2)
    end
    if k == at.AST_CAST:
        n4 := at.Get(a, nid)
        mut target := TYPE_NONE
        if n4.ty != 0:
            target = sema_resolve_type(s, a, n4.ty)
        end
        if target >= 0 and n4.a != 0:
            ak := at.KindOf(a, n4.a)
            if ak == at.AST_ARRAY_LIT or ak == at.AST_STRUCT_LIT or ak == at.AST_LITERAL or ak == at.AST_CALL:
                s.expected = target
            end
        end
        o3 := sema_check_expr(s, a, n4.a)
        s.expected = TYPE_NONE
        if target < 0:
            ret sema_decorate(s, a, nid, o3)
        end
        check_cast_in_context(s, a, n4.a, sp, cast_ctx, target, o3)
        if ty_at(s, target).kind == TY_DYN and o3 >= 0 and ty_at(s, o3).kind == TY_STRUCT:
            _dynok := iface_satisfied(
                s, a, o3, ty_at(s, target).name, ty_at(s, target).name, sp
            )
        end
        if target >= 0 and not type_is_error(s, o3) and ty_at(s, target).kind == TY_VARIANT and ty_at(s, o3).kind != TY_VARIANT:
            vtag := type_variant_tag(s, target, o3)
            if vtag >= 0:
                mut bx := at.Get(a, nid)
                bx.kind = at.AST_VARIANT_BOX
                bx.ty = 0
                bx.synthetic = true
                bx.value_kind = tok.TV_INT
                bx.value_int = vtag as u64
                at.Put(a, nid, bx)
                ret sema_decorate(s, a, nid, target)
            end
        end
        if type_assignable(s, target, o3):
            if not type_is_error(s, o3) and not s.in_derive and type_equiv(s, target, o3) and not sema_cast_target_is_context_dependent(s, a, n4.a, target) and not (type_distinct_sym(s, target) != 0 and at.KindOf(a, n4.a) == at.AST_LITERAL):
                serr(
                    s, 93, sp, co.Format1(
                        i18.Tr("useless cast: this expression already has type '%s'; remove the cast"), co.ArgStr(type_disp(s, target))
                    ) + alias_note(s, a, n4.ty)
                )
            end
            ct := sema_decorate(s, a, nid, target)
            sema_fold_expr(s, a, nid)
            ret ct
        end
        zero_fn := n4.synthetic and not type_is_error(s, o3) and target >= 0 and ty_at(s, o3).kind == TY_NULL and ty_at(s, target).kind == TY_FUNC
        if not type_castable(s, target, o3) and not zero_fn:
            serr(
                s, 23, sp, co.Format2(
                    i18.Tr("cannot cast '%s' to '%s'"), co.ArgStr(type_disp(s, o3)), co.ArgStr(type_disp(s, target))
                ) + alias_note(s, a, n4.ty)
            )
        end
        ct := sema_decorate(s, a, nid, target)
        sema_fold_expr(s, a, nid)
        ret ct
    end
    if k == at.AST_CALL:
        ret check_call(s, a, nid)
    end
    if k == at.AST_MEMBER:
        ret check_member(s, a, nid)
    end
    if k == at.AST_TRY:
        serr(
            s, 12, sp, i18.Tr("'?' must be the whole value of its statement: 'x := f()?', 'x = f()?', 'f()?' or 'ret f()?'")
        )
        _tt := sema_check_expr(s, a, at.Get(a, nid).a)
        ret sema_decorate(s, a, nid, sema_err_ty(s))
    end
    if k == at.AST_INDEX:
        n5 := at.Get(a, nid)
        arr := sema_check_expr(s, a, n5.a)
        idx := sema_check_expr(s, a, n5.b)
        ssym2 := ty_at(s, arr).kind == TY_STRUCT ? struct_sym_of(s, arr) : 0
        if ssym2 != 0:
            ovl2 := sema_try_op_overload(
                s, a, nid, ssym2, "operator_index", idx
            )
            if ovl2 != TYPE_NONE:
                ret sema_decorate(s, a, nid, ovl2)
            end
        end
        if not type_is_error(s, idx) and not type_is_integer(s, idx):
            serr(
                s, 21, sp, co.Format1(
                    i18.Tr("array index must be an integer, got '%s'"), co.ArgStr(type_disp(s, idx))
                )
            )
        end
        av := ty_at(s, arr)
        if av.kind == TY_ARRAY:
            ib := at.Get(a, n5.b)
            if ib.kind == at.AST_LITERAL and ib.value_kind == tok.TV_INT:
                iv := ib.value_int as i64
                if iv < (0 as i64) or iv >= av.length:
                    serr(
                        s, 21, sp, co.Format2(
                            i18.Tr("index %d is out of bounds for an array of length %d"), co.ArgInt(iv), co.ArgInt(av.length)
                        )
                    )
                end
            end
            ret sema_decorate(s, a, nid, av.elem)
        end
        if av.kind == TY_SLICE:
            ret sema_decorate(s, a, nid, av.elem)
        end
        if av.kind == TY_PTR:
            ret sema_decorate(s, a, nid, av.pointee)
        end
        if av.kind == TY_STR:
            ret sema_decorate(s, a, nid, sema_ty(s, TY_CHAR))
        end
        if not type_is_error(s, arr):
            serr(
                s, 21, sp, co.Format1(
                    i18.Tr("cannot index non-array type '%s'"), co.ArgStr(type_disp(s, arr))
                )
            )
        end
        ret sema_decorate(s, a, nid, sema_err_ty(s))
    end
    if k == at.AST_SLICE:
        n6 := at.Get(a, nid)
        base := sema_check_expr(s, a, n6.a)
        if n6.b != 0:
            lo := sema_check_expr(s, a, n6.b)
            if not type_is_error(s, lo) and not type_is_integer(s, lo):
                serr(
                    s, 21, sp, co.Format1(
                        i18.Tr("slice bound must be an integer, got '%s'"), co.ArgStr(type_disp(s, lo))
                    )
                )
            end
        end
        if n6.c != 0:
            hi := sema_check_expr(s, a, n6.c)
            if not type_is_error(s, hi) and not type_is_integer(s, hi):
                serr(
                    s, 21, sp, co.Format1(
                        i18.Tr("slice bound must be an integer, got '%s'"), co.ArgStr(type_disp(s, hi))
                    )
                )
            end
        end
        bk := ty_at(s, base).kind
        if bk == TY_ARRAY or bk == TY_SLICE:
            mut root := n6.a
            until root != 0 and (at.KindOf(a, root) == at.AST_MEMBER or at.KindOf(a, root) == at.AST_INDEX or at.KindOf(a, root) == at.AST_SLICE):
                root = at.Get(a, root).a
            end
            if root != 0 and at.KindOf(a, root) == at.AST_IDENTIFIER:
                rsym := scope_lookup(s, s.cur, at.Get(a, root).name)
                if rsym != 0:
                    mut rv := sym_at(s, rsym)
                    if rv.is_mut or rv.is_ref:
                        rv.mutated = true
                        sym_put(s, rsym, rv)
                    end
                end
            end
            ret sema_decorate(s, a, nid, type_slice(s, ty_at(s, base).elem))
        end
        if not type_is_error(s, base):
            serr(
                s, 21, sp, co.Format1(
                    i18.Tr("cannot slice non-array type '%s'"), co.ArgStr(type_disp(s, base))
                )
            )
        end
        ret sema_decorate(s, a, nid, sema_err_ty(s))
    end
    if k == at.AST_ARRAY_LIT:
        ret check_array_lit(s, a, nid)
    end
    if k == at.AST_STRUCT_LIT:
        ret check_struct_lit(s, a, nid)
    end
    if k == at.AST_LAMBDA:
        ret check_lambda(s, a, nid)
    end
    if k == at.AST_VARIANT_UNWRAP:
        n7 := at.Get(a, nid)
        mut mt := sema_err_ty(s)
        if n7.ty != 0:
            mt = sema_resolve_type(s, a, n7.ty)
        end
        _vu := sema_check_expr(s, a, n7.a)
        ret sema_decorate(s, a, nid, mt)
    end
    if k == at.AST_ASSIGN:
        n8 := at.Get(a, nid)
        _al := sema_check_expr(s, a, n8.a)
        _ar := sema_check_expr(s, a, n8.b)
        serr(
            s, 13, sp, i18.Tr("an assignment cannot be used as a value; to compare two values write '==' (or 'eq') instead of '='")
        )
        ret sema_decorate(s, a, nid, sema_err_ty(s))
    end
    ret sema_decorate(s, a, nid, sema_err_ty(s))
end
