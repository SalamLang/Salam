package semantic

import str

include co "../sal_core.salam"
include tok "../token.salam"
include at "../ast.salam"
include i18 "../i18n.salam"
include lp "../langpack.salam"

func check_enum_static_call(
    s &: Sema, a &: at.Ast, n: int, callee: int, esym: int, argtypes: Vector<int>, sp: co.SrcSpan
): int:
    m := at.Get(a, callee).name
    _de := sema_decorate(s, a, at.Get(a, callee).a, sym_at(s, esym).ty)

    if str.Equals(enum_builtin_canon(s, m), "Count"):
        if argtypes.len() != 0:
            serr(s, 12, sp, i18.Tr("Count() takes no arguments"))
        end
        mems := scope_at(s, sym_at(s, esym).members).symbols
        mut cnt := 0
        repeat mems.len() in i:
            if sym_at(s, mems.get(i)).kind == SYM_ENUM_MEMBER:
                cnt += 1
            end
        end
        mut nv := at.Get(a, n)
        nv.kind = at.AST_LITERAL
        nv.op = tok.TK_INT
        nv.value_kind = tok.TV_INT
        nv.value_int = cnt as u64
        nv.a = 0
        nv.b = 0
        nv.synthetic = false
        at.Put(a, n, nv)
        ret sema_decorate(s, a, n, sema_ty(s, TY_I32))
    end

    if str.Equals(m, "FromString") or str.Equals(m, "Names"):
        is_fs := str.Equals(m, "FromString")
        et := sym_at(s, esym).ty
        fn := is_fs ? sema_derive_enum_fromstring(s, a, et) : sema_derive_enum_names(s, a, et)
        if str.Len(fn) == 0:
            ret sema_decorate(s, a, n, sema_err_ty(s))
        end
        if is_fs and (
            argtypes.len() != 2 or ty_at(s, argtypes.get(0)).kind != TY_STR or ty_at(s, argtypes.get(1)).kind != TY_BOOL
        ):
            serr(s, 12, sp, i18.Tr("FromString(name, ok) takes a str and a bool ref"))
        end
        if not is_fs and argtypes.len() != 0:
            serr(s, 12, sp, i18.Tr("Names() takes no arguments"))
        end
        mut cv := at.Get(a, callee)
        cv.kind = at.AST_IDENTIFIER
        cv.name = fn
        cv.synthetic = true
        at.Put(a, callee, cv)
        _df := sema_decorate(s, a, callee, sema_ty(s, TY_VOID))
        fsym := scope_lookup_local(s, s.global, fn)
        mut sig := 0
        if fsym != 0:
            mut fv := sym_at(s, fsym)
            fv.used = true
            sym_put(s, fsym, fv)
            if fv.overloads.len() > 0:
                sig = fv.overloads.get(0)
            end
        end
        dce_mark_root(s.pkg, fn)
        mark_ref_args(s, a, n, sig)
        rt := sig != 0 ? sig_ret_or_err(s, sig) : et
        ret sema_decorate(s, a, n, rt)
    end

    serr(
        s, 16, sp, co.Format2(
            i18.Tr("enum '%s' has no member '%s'"), co.ArgStr(sym_at(s, esym).name), co.ArgStr(m)
        ) + sema_suggest(s, a, sym_at(s, esym).members, m, SUGGEST_ANY, false)
    )
    ret sema_decorate(s, a, n, sema_err_ty(s))
end

func in_entry_main(s &: Sema, a &: at.Ast): bool:
    if s.cur_func == 0:
        ret false
    end
    sg := sig_at(s, s.cur_func)
    if sg.owner != 0 or sg.decl == 0:
        ret false
    end
    nm := at.Get(a, sg.decl).name
    entry := lp.EntryFor(s.lang)
    if not str.Equals(nm, "main") and not (str.Len(entry) > 0 and str.Equals(nm, entry)):
        ret false
    end
    fs := scope_lookup_local(s, s.global, nm)
    ret fs != 0 and str.Equals(sym_at(s, fs).pkgname, "main")
end

func check_call(s &: Sema, a &: at.Ast, n: int): int:
    callee := at.Get(a, n).a
    call_expected := s.expected
    s.expected = TYPE_NONE
    sp := span_of(a, n)

    mut ckind := 0 - 1
    if callee != 0:
        ckind = at.KindOf(a, callee)
    end
    if ckind == at.AST_MEMBER:
        erw := enum_ctor_rewrite(s, a, n, call_expected)
        if erw == 2:
            ret sema_decorate(s, a, n, sema_err_ty(s))
        end
        if erw == 1:
            s.expected = call_expected
            ret sema_check_expr(s, a, n)
        end
        srw := static_member_rewrite(s, a, callee)
        if srw == 2:
            ret sema_decorate(s, a, n, sema_err_ty(s))
        end
        ckind = at.KindOf(a, callee)
    end
    if ckind == at.AST_IDENTIFIER:
        check_pure_builtin(s, a, n, at.Get(a, callee).name)
    end

    if ckind == at.AST_IDENTIFIER and str.Equals(at.Get(a, callee).name, "spawn"):
        nargs := at.ChildCount(a, n)
        has_arg := nargs == 2
        if (nargs != 1 and nargs != 2) or at.KindOf(a, at.Child(a, n, 0)) != at.AST_IDENTIFIER:
            serr(s, 12, sp, i18.Tr("spawn(func) or spawn(func, arg) takes a function name first"))
            ret sema_decorate(s, a, n, sema_ty(s, TY_I64))
        end
        fnid := at.Child(a, n, 0)
        fname := at.Get(a, fnid).name
        fsym := scope_lookup(s, s.cur, fname)
        mut is_fn := fsym != 0
        if is_fn and sym_at(s, fsym).kind != SYM_FUNC:
            is_fn = false
        end
        if not is_fn:
            serr(
                s, 12, sp, co.Format1(
                    i18.Tr("spawn argument '%s' is not a function"), co.ArgStr(fname)
                )
            )
            ret sema_decorate(s, a, n, sema_ty(s, TY_I64))
        end
        mut fsv := sym_at(s, fsym)
        fsv.used = true
        sym_put(s, fsym, fsv)
        dce_mark_root(s.pkg, fname)
        mut argt := TYPE_NONE
        if has_arg:
            argt = sema_check_expr(s, a, at.Child(a, n, 1))
        end
        mut sok := false
        mut want := TYPE_NONE
        fsv2 := sym_at(s, fsym)
        repeat fsv2.overloads.len() in i:
            sg := sig_at(s, fsv2.overloads.get(i))
            if sg.ret_type >= 0 and ty_at(s, sg.ret_type).kind == TY_VOID:
                if not has_arg:
                    if sg.params.len() == 0:
                        sok = true
                    end
                else:
                    if sg.params.len() == 1 and ty_at(s, sg.params.get(0)).kind == TY_PTR:
                        if want == TYPE_NONE:
                            want = sg.params.get(0)
                        end
                        if argt != TYPE_NONE and type_assignable(s, sg.params.get(0), argt):
                            sok = true
                        end
                    end
                end
            end
        end
        if not sok:
            if not has_arg:
                serr(
                    s, 12, sp, i18.Tr("spawn requires a function taking no arguments and returning nothing")
                )
            else:
                if want == TYPE_NONE:
                    serr(
                        s, 12, sp, i18.Tr("spawn(func, arg) requires a function taking one pointer argument and returning nothing")
                    )
                else:
                    serr(
                        s, 12, sp, co.Format2(
                            i18.Tr("spawn argument: cannot pass '%s' to '%s'"), co.ArgStr(type_disp(s, argt)), co.ArgStr(type_disp(s, want))
                        )
                    )
                end
            end
        end
        _d1 := sema_decorate(s, a, fnid, sema_ty(s, TY_VOID))
        _d2 := sema_decorate(s, a, callee, sema_ty(s, TY_VOID))
        ret sema_decorate(s, a, n, sema_ty(s, TY_I64))
    end

    if ckind == at.AST_IDENTIFIER and atomic_arity(at.Get(a, callee).name) > 0 and scope_lookup(
        s, s.cur, at.Get(a, callee).name
    ) == 0:
        aname := at.Get(a, callee).name
        want := atomic_arity(aname)
        if at.ChildCount(a, n) != want:
            serr(
                s, 12, sp, co.Format4(
                    i18.Tr("'%s' expects %zu argument%s, got %zu"), co.ArgStr(aname), co.ArgUint(want as u64), co.ArgStr(plural_suffix(want)), co.ArgUint(at.ChildCount(a, n) as u64)
                )
            )
            ret sema_decorate(s, a, n, sema_ty(s, TY_I64))
        end
        cellty := type_ptr(s, sema_ty(s, TY_I64))
        repeat at.ChildCount(a, n) in ai:
            aty := sema_check_expr(s, a, at.Child(a, n, ai))
            mut wty := sema_ty(s, TY_I64)
            if ai == 0:
                wty = cellty
            end
            if aty != TYPE_NONE and not type_assignable(s, wty, aty):
                serr(
                    s, 12, sp, co.Format3(
                        i18.Tr("argument %zu: cannot pass '%s' to '%s'"), co.ArgUint((ai + 1) as u64), co.ArgStr(type_disp(s, aty)), co.ArgStr(type_disp(s, wty))
                    )
                )
            end
        end
        _da := sema_decorate(s, a, callee, sema_ty(s, TY_VOID))
        if str.Equals(aname, "atomic_store"):
            ret sema_decorate(s, a, n, sema_ty(s, TY_VOID))
        end
        if str.Equals(aname, "atomic_cas"):
            ret sema_decorate(s, a, n, sema_ty(s, TY_BOOL))
        end
        ret sema_decorate(s, a, n, sema_ty(s, TY_I64))
    end

    if ckind == at.AST_IDENTIFIER and str.Equals(at.Get(a, callee).name, "callhandler"):
        if at.ChildCount(a, n) != 2:
            serr(
                s, 12, sp, i18.Tr("callhandler(fn, arg) takes a function pointer and an i64 argument")
            )
            ret sema_decorate(s, a, n, sema_ty(s, TY_VOID))
        end
        _c1 := sema_check_expr(s, a, at.Child(a, n, 0))
        _c2 := sema_check_expr(s, a, at.Child(a, n, 1))
        _d5 := sema_decorate(s, a, callee, sema_ty(s, TY_VOID))
        ret sema_decorate(s, a, n, sema_ty(s, TY_VOID))
    end

    if ckind == at.AST_IDENTIFIER and str.Equals(at.Get(a, callee).name, "sizeof"):
        if at.ChildCount(a, n) != 1 or at.KindOf(a, at.Child(a, n, 0)) != at.AST_TYPE:
            serr(s, 12, sp, i18.Tr("sizeof(Type) takes a single type operand"))
            ret sema_decorate(s, a, n, sema_ty(s, TY_USIZE))
        end
        opid := at.Child(a, n, 0)
        op_type := sema_resolve_type(s, a, opid)
        _d6 := sema_decorate(s, a, opid, op_type)
        _d7 := sema_decorate(s, a, callee, sema_ty(s, TY_VOID))
        ret sema_decorate(s, a, n, sema_ty(s, TY_USIZE))
    end

    if ckind == at.AST_IDENTIFIER and str.Equals(at.Get(a, callee).name, "jsonenc"):
        ret check_json_builtin(s, a, n, true, sp)
    end
    if ckind == at.AST_IDENTIFIER and str.Equals(at.Get(a, callee).name, "jsondec"):
        ret check_json_builtin(s, a, n, false, sp)
    end
    if ckind == at.AST_IDENTIFIER and str.Equals(at.Get(a, callee).name, "jsonschema"):
        ret check_json_schema_builtin(s, a, n, sp)
    end

    mut argtypes := Vector {} as Vector<int>
    defer argtypes.free()
    repeat at.ChildCount(a, n) in ai:
        argtypes.push(sema_check_expr(s, a, at.Child(a, n, ai)))
    end

    mut ft := TYPE_NONE
    if ckind == at.AST_IDENTIFIER:
        fvid := scope_lookup(s, s.cur, at.Get(a, callee).name)
        if fvid != 0:
            fvv := sym_at(s, fvid)
            if fvv.ty >= 0 and ty_at(s, fvv.ty).kind == TY_FUNC and (
                fvv.kind == SYM_VAR or fvv.kind == SYM_PARAM or fvv.kind == SYM_CONST
            ):
                ft = fvv.ty
                mut fvm := sym_at(s, fvid)
                fvm.used = true
                sym_put(s, fvid, fvm)
                if s.lam.len() > 0 and (fvv.kind == SYM_VAR or fvv.kind == SYM_PARAM):
                    ctop := s.lam.get(s.lam.len() - 1)
                    cname := at.Get(a, callee).name
                    if not defined_within(s, s.cur, ctop.boundary, cname) and scope_lookup_local(s, s.global, cname) == 0:
                        record_capture(s, a, callee, fvv.ty)
                    end
                end
            end
        end
    else callee != 0 and ckind != at.AST_MEMBER:
        ct := sema_check_expr(s, a, callee)
        if ct >= 0 and ty_at(s, ct).kind == TY_FUNC:
            ft = ct
        end
    end
    if ft >= 0:
        _d8 := sema_decorate(s, a, callee, ft)
        pf := sema_pure_fn(s, a)
        if pf != 0:
            serr(
                s, 12, sp, co.Format1(
                    i18.Tr("'pure' function '%s' cannot call a function value: its purity cannot be verified"), co.ArgStr(at.Get(a, pf).name)
                )
            )
        end
        ftv := ty_at(s, ft)
        if argtypes.len() != ftv.params.len():
            serr(
                s, 12, sp, co.Format3(
                    i18.Tr("function value takes %zu argument%s, got %zu"), co.ArgUint(ftv.params.len() as u64), co.ArgStr(plural_suffix(ftv.params.len())), co.ArgUint(argtypes.len() as u64)
                )
            )
        else:
            repeat argtypes.len() in fi:
                if not type_assignable(
                    s, ftv.params.get(fi), argtypes.get(fi)
                ):
                    serr(
                        s, 2, sp, co.Format3(
                            i18.Tr("argument %zu: cannot pass '%s' to '%s'"), co.ArgUint((fi + 1) as u64), co.ArgStr(type_disp(s, argtypes.get(fi))), co.ArgStr(type_disp(s, ftv.params.get(fi)))
                        )
                    )
                end
            end
        end
        ret sema_decorate(s, a, n, ftv.elem)
    end

    if ckind == at.AST_IDENTIFIER:
        mut nm := at.Get(a, callee).name
        if str.Equals(nm, "print") or str.Equals(nm, "println") or str.Equals(nm, "printerr") or str.Equals(nm, "printerrln"):
            repeat argtypes.len() in pi:
                tid := argtypes.get(pi)
                if tid >= 0:
                    pk := ty_at(s, tid).kind
                    if pk == TY_VOID:
                        serr(
                            s, 2, sp, i18.Tr("cannot print a value of type 'void' - this expression produces no value")
                        )
                    else pk == TY_ARRAY or pk == TY_STRUCT or pk == TY_MAP or pk == TY_MAP_ITER or pk == TY_VEC or pk == TY_FILE or pk == TY_FUNC or pk == TY_SLICE or pk == TY_VARIANT:
                        if not derive_print_arg(s, a, n, pi, tid):
                            serr(
                                s, 2, sp, co.Format1(
                                    i18.Tr("cannot print value of type '%s' directly - print its elements or fields instead"), co.ArgStr(type_disp(s, tid))
                                )
                            )
                        end
                    else pk == TY_PTR:
                        pte := ty_at(s, tid).pointee
                        if pte >= 0 and ty_at(s, pte).kind != TY_VOID:
                            serr(
                                s, 2, sp, co.Format2(
                                    i18.Tr("cannot print a pointer of type '%s' - add '[0]' to print the '%s' it points to"), co.ArgStr(type_disp(s, tid)), co.ArgStr(type_disp(s, pte))
                                )
                            )
                        else:
                            serr(
                                s, 2, sp, co.Format1(
                                    i18.Tr("cannot print a pointer of type '%s' - print what it points to instead"), co.ArgStr(type_disp(s, tid))
                                )
                            )
                        end
                    end
                end
            end
            _d9 := sema_decorate(s, a, callee, sema_ty(s, TY_VOID))
            ret sema_decorate(s, a, n, sema_ty(s, TY_VOID))
        end
        if str.Equals(nm, "input"):
            if argtypes.len() == 1 and argtypes.get(0) >= 0 and ty_at(s, argtypes.get(0)).kind != TY_STR and not type_is_error(s, argtypes.get(0)):
                serr(
                    s, 2, sp, co.Format3(
                        i18.Tr("argument %zu: cannot pass '%s' to '%s'"), co.ArgUint(1 as u64), co.ArgStr(type_disp(s, argtypes.get(0))), co.ArgStr(type_disp(s, sema_ty(s, TY_STR)))
                    )
                )
            end
            _da2 := sema_decorate(s, a, callee, sema_ty(s, TY_STR))
            ret sema_decorate(s, a, n, sema_ty(s, TY_STR))
        end
        if str.Equals(nm, "hash") and argtypes.len() == 1:
            _db2 := sema_decorate(s, a, callee, sema_ty(s, TY_VOID))
            ret sema_decorate(s, a, n, sema_ty(s, TY_U64))
        end
        if str.Equals(nm, "open"):
            if argtypes.len() != 2:
                serr(s, 12, sp, i18.Tr("open(path, mode) takes 2 args"))
            end
            _dc2 := sema_decorate(s, a, callee, sema_ty(s, TY_VOID))
            ret sema_decorate(s, a, n, type_ptr(s, type_file(s)))
        end
        if str.Equals(nm, "env"):
            if argtypes.len() != 1:
                serr(s, 12, sp, i18.Tr("env(name) takes 1 arg"))
            end
            _dd2 := sema_decorate(s, a, callee, sema_ty(s, TY_VOID))
            ret sema_decorate(s, a, n, sema_ty(s, TY_STR))
        end
        if str.Equals(nm, "args"):
            if argtypes.len() != 0:
                serr(s, 12, sp, i18.Tr("args() takes no arguments"))
            end
            _de2 := sema_decorate(s, a, callee, sema_ty(s, TY_VOID))
            ret sema_decorate(s, a, n, sema_vec_str(s, a, sp))
        end
        if str.Equals(nm, "lang"):
            if argtypes.len() != 0:
                serr(s, 12, sp, i18.Tr("lang() takes no arguments"))
            end
            _df2 := sema_decorate(s, a, callee, sema_ty(s, TY_VOID))
            ret sema_decorate(s, a, n, sema_ty(s, TY_STR))
        end
        if str.Equals(nm, "listdir"):
            if argtypes.len() != 1:
                serr(
                    s, 12, sp, co.Format1(i18.Tr("%s takes 1 argument"), co.ArgStr(nm))
                )
            end
            _dg2 := sema_decorate(s, a, callee, sema_ty(s, TY_VOID))
            ret sema_decorate(s, a, n, sema_vec_str(s, a, sp))
        end
        mut sym := scope_lookup(s, s.cur, nm)
        if sym == 0:
            c := local_canon(s, a, nm, sp)
            if not str.Equals(c, nm):
                nm = c
                at.SetName(a, callee, c)
                sym = scope_lookup(s, s.cur, nm)
            end
        end
        mut sym_callable := sym != 0
        if sym_callable:
            sk := sym_at(s, sym).kind
            if sk != SYM_FUNC and sk != SYM_METHOD:
                sym_callable = false
            end
        end
        if not sym_callable:
            if str.Equals(nm, "len") and argtypes.len() == 1:
                ak := ty_at(s, argtypes.get(0)).kind
                if ak == TY_ARRAY or ak == TY_SLICE or ak == TY_STR:
                    _dh2 := sema_decorate(s, a, callee, sema_ty(s, TY_VOID))
                    ret sema_decorate(s, a, n, sema_ty(s, TY_I32))
                end
            end
            if str.Equals(nm, "char_code") and argtypes.len() == 1 and ty_at(s, argtypes.get(0)).kind == TY_STR:
                _di2 := sema_decorate(s, a, callee, sema_ty(s, TY_VOID))
                ret sema_decorate(s, a, n, sema_ty(s, TY_I32))
            end
            bi := builtin_lookup(nm)
            if bi >= 0:
                bnargs := k_sm_builtin_nargs[bi]
                barg := k_sm_builtin_arg[bi]
                bret := k_sm_builtin_ret[bi]
                if bnargs >= 0 and argtypes.len() != bnargs:
                    serr(
                        s, 12, sp, co.Format4(
                            i18.Tr("builtin '%s' takes %d argument%s, got %zu"), co.ArgStr(nm), co.ArgInt(bnargs as i64), co.ArgStr(plural_suffix(bnargs)), co.ArgUint(argtypes.len() as u64)
                        )
                    )
                end
                if not str.Equals(barg, "*"):
                    bak := type_prim_kind_from_name(barg, "")
                    repeat argtypes.len() in bj:
                        if not type_assignable(
                            s, sema_ty(s, bak), argtypes.get(bj)
                        ):
                            serr(
                                s, 2, sp, co.Format3(
                                    i18.Tr("builtin '%s' expects '%s', got '%s'"), co.ArgStr(nm), co.ArgStr(barg), co.ArgStr(
                                        type_to_string(
                                            s, argtypes.get(bj)
                                        )
                                    )
                                )
                            )
                        end
                    end
                end
                _dj2 := sema_decorate(s, a, callee, sema_ty(s, TY_VOID))
                ret sema_decorate(
                    s, a, n, sema_ty(s, type_prim_kind_from_name(bret, ""))
                )
            end
            split_at := str.LastIndex(nm, " ")
            if split_at > 0:
                tail := str.Substr(nm, split_at + 1, str.Len(nm) - split_at - 1)
                tsym := scope_lookup(s, s.cur, tail)
                if tsym != 0 and sym_at(s, tsym).kind == SYM_FUNC:
                    serr(
                        s, 12, sp, co.Format2(
                            i18.Tr(
                                "call to undefined function '%s': words next to each other are read as one name; if '%s(...)' is a separate call, start it on a new line or put the value before it in parentheses"
                            ), co.ArgStr(nm), co.ArgStr(tail)
                        )
                    )
                    ret sema_decorate(s, a, n, sema_err_ty(s))
                end
            end
            serr(
                s, 12, sp, co.Format1(
                    i18.Tr("call to undefined function '%s'"), co.ArgStr(nm)
                )
            )
            ret sema_decorate(s, a, n, sema_err_ty(s))
        end

        mut symv := sym_at(s, sym)
        symv.used = true
        sym_put(s, sym, symv)
        dce_note(s, a, str.Len(symv.pkgname) > 0 ? symv.pkgname : s.pkg, nm)
        if symv.kind == SYM_FUNC and symv.decl != 0 and at.TyparamCount(a, symv.decl) > 0:
            inst := g_infer_call(s, a, sym, argtypes, sp, call_expected)
            if inst == 0:
                ret sema_decorate(s, a, n, sema_err_ty(s))
            end
            sym = inst
            at.SetName(a, callee, sym_at(s, inst).name)
        end
        sig := resolve_overload(s, a, sym, argtypes, sp, nm)
        mark_ref_args(s, a, n, sig)
        coerce_args_to_dyn(s, a, n, argtypes, sig)
        coerce_args_to_variant(s, a, n, argtypes, sig)
        _dk2 := sema_decorate(s, a, callee, sym_at(s, sym).ty)
        if sig == 0:
