            intr := intrinsic_method_canon(at.Get(a, callee).name)
            if not str.Equals(intr, at.Get(a, callee).name) and scope_lookup_local(s, ssv.members, intr) != 0:
                at.SetName(a, callee, intr)
            end
        end
        if not via_alias and scope_lookup_local(s, ssv.members, at.Get(a, callee).name) != 0:
            sema_check_intrinsic_method_lang(
                s, orig_method_name, at.Get(a, callee).name, csp2
            )
        end
        mname := at.Get(a, callee).name
        m7 := scope_lookup_local(s, ssv.members, mname)

        mut is_func_field := false
        if m7 != 0:
            m7v := sym_at(s, m7)
            if m7v.kind == SYM_FIELD and m7v.ty >= 0 and ty_at(s, m7v.ty).kind == TY_FUNC:
                is_func_field = true
            end
        end
        if is_func_field:
            m7v2 := sym_at(s, m7)
            fft := m7v2.ty
            if not m7v2.is_pub and not sema_in_struct(s, ssym):
                serr(
                    s, 17, sp, co.Format2(
                        i18.Tr("field '%s' is private in struct '%s' (mark it 'pub')"), co.ArgStr(mname), co.ArgStr(ssv.name)
                    )
                )
            end
            _dv2 := sema_decorate(s, a, callee, fft)
            pf3 := sema_pure_fn(s, a)
            if pf3 != 0:
                serr(
                    s, 12, sp, co.Format1(
                        i18.Tr("'pure' function '%s' cannot call a function value: its purity cannot be verified"), co.ArgStr(at.Get(a, pf3).name)
                    )
                )
            end
            fftv := ty_at(s, fft)
            if argtypes.len() != fftv.params.len():
                serr(
                    s, 12, sp, co.Format3(
                        i18.Tr("function value takes %zu argument%s, got %zu"), co.ArgUint(fftv.params.len() as u64), co.ArgStr(plural_suffix(fftv.params.len())), co.ArgUint(argtypes.len() as u64)
                    )
                )
            else:
                repeat argtypes.len() in gi:
                    if not type_assignable(
                        s, fftv.params.get(gi), argtypes.get(gi)
                    ):
                        serr(
                            s, 2, sp, co.Format3(
                                i18.Tr("argument %zu: cannot pass '%s' to '%s'"), co.ArgUint((gi + 1) as u64), co.ArgStr(
                                    type_to_string(
                                        s, argtypes.get(gi)
                                    )
                                ), co.ArgStr(
                                    type_to_string(
                                        s, fftv.params.get(gi)
                                    )
                                )
                            )
                        )
                    end
                end
            end
            ret sema_decorate(s, a, n, fftv.elem)
        end
        mut m7_ok := m7 != 0
        if m7_ok and sym_at(s, m7).kind != SYM_METHOD:
            m7_ok = false
        end
        if not m7_ok:
            ric4 := try_impl_call(s, a, n, callee, objt, argtypes)
            if ric4 != TYPE_NONE:
                ret ric4
            end
            if scope_lookup_local(s, static_home(s, ssym), static_member_name(ssv.name, mname)) != 0:
                serr(
                    s, 17, sp, co.Format3(
                        i18.Tr("'%s' is static: call it as %s.%s(...)"), co.ArgStr(mname), co.ArgStr(ssv.name), co.ArgStr(mname)
                    )
                )
                ret sema_decorate(s, a, n, sema_err_ty(s))
            end
            serr(
                s, 17, sp, co.Format2(
                    i18.Tr("no method '%s' for type '%s'"), co.ArgStr(mname), co.ArgStr(ssv.name)
                )
            )
            ret sema_decorate(s, a, n, sema_err_ty(s))
        end
        if not sym_at(s, m7).is_pub and not sema_in_struct(s, ssym):
            serr(
                s, 17, sp, co.Format2(
                    i18.Tr("method '%s' is private in struct '%s' (mark it 'pub')"), co.ArgStr(mname), co.ArgStr(ssv.name)
                )
            )
        end
        sig5 := resolve_overload(s, a, m7, argtypes, sp, mname)
        sema_check_mut_call(s, a, at.Get(a, callee).a, sig5, mname, sp)
        mark_ref_args(s, a, n, sig5)
        coerce_args_to_dyn(s, a, n, argtypes, sig5)
        coerce_args_to_variant(s, a, n, argtypes, sig5)
        _dw2 := sema_decorate(s, a, callee, sym_at(s, m7).ty)
        if sig5 == 0:
            ret sema_decorate(s, a, n, sema_err_ty(s))
        end
        ret sema_decorate(
            s, a, n, g_localize_instance(s, a, sig_ret_or_err(s, sig5), sp)
        )
    end
    _dx2 := sema_check_expr(s, a, callee)
    serr(s, 12, sp, i18.Tr("expression is not callable"))
    ret sema_decorate(s, a, n, sema_err_ty(s))
end

func plural_suffix(n: int): str:
    ret n == 1 ? "" : "s"
end
