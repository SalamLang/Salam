package semantic

import str
import co "../sal_core.salam"
import at "../ast.salam"
import tok "../token.salam"
import i18 "../i18n.salam"

pub struct DiVar:
    pub name: str = ""
    pub decl: int = 0
    pub inited: bool = false
end

pub struct Di:
    pub vars: Vector<DiVar> = Vector {}
    pub filled: Vector<str> = Vector {}
end

func di_find(d &: Di, name: str): int:
    if str.Len(name) == 0:
        ret 0 - 1
    end
    mut i := d.vars.len()
    until i > 0:
        i -= 1
        if d.vars.get(i).name == name:
            ret i
        end
    end
    ret 0 - 1
end

func di_drop_to(d &: Di, mark: int):
    until d.vars.len() > mark:
        _dropped := d.vars.pop()
    end
end

func di_set_inited(d &: Di, idx: int, v: bool):
    mut e := d.vars.get(idx)
    e.inited = v
    d.vars.set(idx, e)
end

func di_mark(d &: Di, name: str):
    idx := di_find(d, name)
    if idx >= 0:
        di_set_inited(d, idx, true)
    end
end

func di_is_filled(d &: Di, name: str): bool:
    if str.Len(name) == 0:
        ret false
    end
    repeat d.filled.len() with i:
        if d.filled.get(i) == name:
            ret true
        end
    end
    ret false
end

func di_root_of(a &: at.Ast, nid: int): int:
    mut cur := nid
    until cur != 0:
        k := at.KindOf(a, cur)
        if k != at.AST_MEMBER && k != at.AST_INDEX && k != at.AST_SLICE:
            ret cur
        end
        cur = at.Get(a, cur).a
    end
    ret cur
end

func di_scan_filled(d &: Di, a &: at.Ast, nid: int):
    if nid == 0:
        ret
    end
    n := at.Get(a, nid)
    if n.kind == at.AST_ASSIGN && n.a != 0 && at.KindOf(a, n.a) != at.AST_IDENTIFIER:
        root := di_root_of(a, n.a)
        if root != 0 && at.KindOf(a, root) == at.AST_IDENTIFIER:
            rn := at.Get(a, root).name
            if str.Len(rn) > 0:
                d.filled.push(rn)
            end
        end
    end
    di_scan_filled(d, a, n.a)
    di_scan_filled(d, a, n.b)
    di_scan_filled(d, a, n.c)
    di_scan_filled(d, a, n.d)
    repeat at.ChildCount(a, nid) with i:
        di_scan_filled(d, a, at.Child(a, nid, i))
    end
end

func di_declare(d &: Di, a &: at.Ast, nid: int):
    n := at.Get(a, nid)
    mut v := DiVar {}
    v.name = n.name
    v.decl = nid
    v.inited = n.a != 0 || di_is_filled(d, n.name)
    d.vars.push(v)
end

func di_read(s &: Sema, d &: Di, a &: at.Ast, nid: int):
    n := at.Get(a, nid)
    idx := di_find(d, n.name)
    if idx < 0:
        ret
    end
    if d.vars.get(idx).inited:
        ret
    end
    line := at.Get(a, d.vars.get(idx).decl).begin_line as u64
    serr(
        s, 89, span_of(a, nid), co.Format2(
            i18.Tr("'%s' is read before it is given a value (declared on line %u); give it a value with ':=', or assign to it on every path that reaches here"), co.ArgStr(n.name), co.ArgUint(line)
        )
    )
    di_set_inited(d, idx, true)
end

func di_snap(d &: Di, n: int): Vector<int>:
    mut out := Vector {} as Vector<int>
    repeat n with i:
        if d.vars.get(i).inited:
            out.push(1)
        else:
            out.push(0)
        end
    end
    ret out
end

func di_load(d &: Di, buf &: Vector<int>, n: int):
    repeat n with i:
        di_set_inited(d, i, buf.get(i) != 0)
    end
end

func di_arm(s &: Sema, d &: Di, a &: at.Ast, nid: int, base &: Vector<int>, n: int): Vector<int>:
    di_load(d, base, n)
    di_stmt(s, d, a, nid)
    di_drop_to(d, n)
    ret di_snap(d, n)
end

func di_if(s &: Sema, d &: Di, a &: at.Ast, nid: int):
    n := at.Get(a, nid)
    di_expr(s, d, a, n.a)
    nv := d.vars.len()
    mut base := di_snap(d, nv)
    mut th := di_arm(s, d, a, n.b, base, nv)
    th_live := !sema_stmt_terminates(s, a, n.b)
    mut el := Vector {} as Vector<int>
    mut el_live := true
    if n.c != 0:
        el = di_arm(s, d, a, n.c, base, nv)
        el_live = !sema_stmt_terminates(s, a, n.c)
    else:
        repeat nv with i:
            el.push(base.get(i))
        end
    end
    di_load(d, base, nv)
    repeat nv with i:
        mut got := false
        if th_live && el_live:
            got = th.get(i) != 0 && el.get(i) != 0
        else if th_live:
            got = th.get(i) != 0
        else if el_live:
            got = el.get(i) != 0
        end
        if got:
            di_set_inited(d, i, true)
        end
    end
    base.free()
    th.free()
    el.free()
end

func di_match(s &: Sema, d &: Di, a &: at.Ast, nid: int):
    n := at.Get(a, nid)
    di_expr(s, d, a, n.a)
    nv := d.vars.len()
    mut base := di_snap(d, nv)
    mut acc := di_snap(d, 0)
    repeat nv:
        acc.push(1)
    end
    mut has_else := false
    mut any_live := false
    repeat at.ChildCount(a, nid) with j:
        arm := at.Child(a, nid, j)
        body := at.Get(a, arm).b
        if at.Get(a, arm).op == tok.TK_KW_ELSE:
            has_else = true
        end
        mut st := di_arm(s, d, a, body, base, nv)
        if !sema_stmt_terminates(s, a, body):
            any_live = true
            repeat nv with k:
                if st.get(k) == 0:
                    acc.set(k, 0)
                end
            end
        end
        st.free()
    end
    di_load(d, base, nv)
    if has_else && any_live:
        repeat nv with i:
            if acc.get(i) != 0:
                di_set_inited(d, i, true)
            end
        end
    end
    base.free()
    acc.free()
end

func di_loop(s &: Sema, d &: Di, a &: at.Ast, cond: int, body: int, post: int):
    di_expr(s, d, a, cond)
    nv := d.vars.len()
    mut base := di_snap(d, nv)
    di_stmt(s, d, a, body)
    di_drop_to(d, nv)
    di_stmt(s, d, a, post)
    di_drop_to(d, nv)
    di_load(d, base, nv)
    base.free()
end

func di_for(s &: Sema, d &: Di, a &: at.Ast, nid: int):
    n := at.Get(a, nid)
    mark := d.vars.len()
    di_stmt(s, d, a, n.a)
    di_loop(s, d, a, n.b, n.d, n.c)
    di_drop_to(d, mark)
end

func di_repeat(s &: Sema, d &: Di, a &: at.Ast, nid: int):
    n := at.Get(a, nid)
    di_expr(s, d, a, n.a)
    di_expr(s, d, a, n.c)
    di_expr(s, d, a, n.d)
    di_loop(s, d, a, 0, n.b, 0)
end

func di_call(s &: Sema, d &: Di, a &: at.Ast, nid: int):
    di_expr(s, d, a, at.Get(a, nid).a)
    repeat at.ChildCount(a, nid) with i:
        arg := at.Child(a, nid, i)
        if arg != 0 && at.Get(a, arg).ref_arg:
            mut root := arg
            mut rk := at.KindOf(a, root)
            until rk == at.AST_MEMBER || rk == at.AST_INDEX || rk == at.AST_SLICE:
                rn := at.Get(a, root)
                di_expr(s, d, a, rn.b)
                di_expr(s, d, a, rn.c)
                root = rn.a
                if root == 0:
                    break
                end
                rk = at.KindOf(a, root)
            end
            if root != 0 && at.KindOf(a, root) == at.AST_IDENTIFIER:
                di_mark(d, at.Get(a, root).name)
            else:
                di_expr(s, d, a, root)
            end
        else:
            di_expr(s, d, a, arg)
        end
    end
end

func di_assign(s &: Sema, d &: Di, a &: at.Ast, nid: int):
    n := at.Get(a, nid)
    di_expr(s, d, a, n.b)
    if n.a == 0:
        ret
    end
    if at.KindOf(a, n.a) == at.AST_IDENTIFIER:
        if n.op != tok.TK_ASSIGN:
            di_read(s, d, a, n.a)
        end
        di_mark(d, at.Get(a, n.a).name)
        ret
    end
    mut cur := n.a
    mut k := at.KindOf(a, cur)
    until k == at.AST_MEMBER || k == at.AST_INDEX || k == at.AST_SLICE:
        cn := at.Get(a, cur)
        di_expr(s, d, a, cn.b)
        di_expr(s, d, a, cn.c)
        if cn.a == 0:
            ret
        end
        cur = cn.a
        k = at.KindOf(a, cur)
    end
    if k == at.AST_IDENTIFIER:
        di_mark(d, at.Get(a, cur).name)
        ret
    end
    di_expr(s, d, a, cur)
end

func di_block(s &: Sema, d &: Di, a &: at.Ast, nid: int):
    mark := d.vars.len()
    repeat at.ChildCount(a, nid) with i:
        di_stmt(s, d, a, at.Child(a, nid, i))
    end
    di_drop_to(d, mark)
end

func di_expr(s &: Sema, d &: Di, a &: at.Ast, nid: int):
    if nid == 0:
        ret
    end
    k := at.KindOf(a, nid)
    if k == at.AST_IDENTIFIER:
        di_read(s, d, a, nid)
        ret
    end
    if k == at.AST_LAMBDA || k == at.AST_FUNC_ADDR:
        ret
    end
    if k == at.AST_CALL:
        di_call(s, d, a, nid)
        ret
    end
    if k == at.AST_MATCH:
        di_match(s, d, a, nid)
        ret
    end
    if k == at.AST_BLOCK:
        di_block(s, d, a, nid)
        ret
    end
    n := at.Get(a, nid)
    di_expr(s, d, a, n.a)
    di_expr(s, d, a, n.b)
    di_expr(s, d, a, n.c)
    di_expr(s, d, a, n.d)
    repeat at.ChildCount(a, nid) with i:
        di_expr(s, d, a, at.Child(a, nid, i))
    end
end

func di_stmt(s &: Sema, d &: Di, a &: at.Ast, nid: int):
    if nid == 0:
        ret
    end
    k := at.KindOf(a, nid)
    if k == at.AST_BLOCK:
        di_block(s, d, a, nid)
    else k == at.AST_VAR_DECL || k == at.AST_CONST_DECL:
        di_expr(s, d, a, at.Get(a, nid).a)
        di_declare(d, a, nid)
    else k == at.AST_ASSIGN:
        di_assign(s, d, a, nid)
    else k == at.AST_IF:
        di_if(s, d, a, nid)
    else k == at.AST_MATCH:
        di_match(s, d, a, nid)
    else k == at.AST_UNTIL:
        di_loop(s, d, a, at.Get(a, nid).a, at.Get(a, nid).b, 0)
    else k == at.AST_FOR:
        di_for(s, d, a, nid)
    else k == at.AST_REPEAT:
        di_repeat(s, d, a, nid)
    else k == at.AST_EACH:
        di_expr(s, d, a, at.Get(a, nid).a)
        di_loop(s, d, a, 0, at.Get(a, nid).b, 0)
    else k == at.AST_DEFER || k == at.AST_BREAK || k == at.AST_CONTINUE:
        ret
    else:
        di_expr(s, d, a, nid)
    end
end

pub func SemaCheckDefiniteInit(s &: Sema, a &: at.Ast, fnid: int):
    if fnid == 0:
        ret
    end
    body := at.Get(a, fnid).a
    if body == 0:
        ret
    end
    mut d := Di {}
    di_scan_filled(d, a, body)
    di_stmt(s, d, a, body)
    d.vars.free()
    d.filled.free()
end
