package semantic

import str
import at "../ast.salam"

// ===== sema_derive_enum.c =====
//
// `.name()`, `FromString`, and `Names()` on a user enum: reflection the
// compiler can't write once and for all (no runtime type info exists), so
// it's derived per concrete enum, the same treatment sema_derive_json.salam
// gives json.Marshal/Unmarshal - generate Salam source, parse it, install it
// as a synthetic top-level declaration. Every backend already knows how to
// emit an `if`/`else` chain, a member comparison, and a Vector push, so none
// of them need to know this pass exists.
//
// `Count()` needs no derived function at all - the call site in
// sema_checkcall.salam folds it straight to an int literal, the member
// count being known at compile time.

// The three derivable enum operations. Kept as an int discriminant rather
// than a function value passed around - matching the codebase's existing
// derive_json_one, which branches on a plain `enc: bool` instead - because
// this codebase's self-hosted style keeps derivers as ordinary branches, not
// first-class functions.
const ENUM_OP_NAME := 0
const ENUM_OP_FROMSTRING := 1
const ENUM_OP_NAMES := 2

func derive_enum_name(s &: Sema, prefix: str, t: int): str:
    ret prefix + derive_key(type_to_string(s, t))
end

// derive_enum_one - shared by the three derivers below. Claims the name
// before the body is generated (a struct/enum that refers to itself would
// otherwise ask for the same function again while it is still mid-derive),
// generates the body, parses it, and installs it as a synthetic top-level
// declaration. "" when `t` isn't a derivable enum - an empty enum is
// already rejected at the declaration itself, so this is just defensive.
func derive_enum_one(s &: Sema, a &: at.Ast, t: int, prefix: str, op: int): str:
    if t < 0 || s.program == 0:
        ret ""
    end
    esym := ty_at(s, t).decl
    if esym == 0 || sym_at(s, esym).members == 0:
        ret ""
    end
    if scope_at(s, sym_at(s, esym).members).symbols.len() == 0:
        ret ""
    end
    fname := derive_enum_name(s, prefix, t)
    if derive_registry_find(s, fname) != 0:
        ret fname
    end
    if scope_lookup_local(s, s.global, fname) != 0:
        ret ""
    end
    derive_registry_claim(s, fname)
    mut text := ""
    if op == ENUM_OP_NAME:
        text = name_source(s, esym, fname)
    else op == ENUM_OP_FROMSTRING:
        text = fromstring_source(s, esym, fname)
    else:
        text = names_source(s, esym, fname)
    end
    if str.Len(text) == 0:
        derive_registry_drop(s, derive_registry_find(s, fname))
        ret ""
    end
    prog := derive_parse(s, a, text, "<derived>")
    mut fn := 0
    if prog != 0:
        fn = derive_install_all(s, a, prog, fname, sym_at(s, esym).home)
    end
    if fn == 0:
        derive_registry_drop(s, derive_registry_find(s, fname))
        ret ""
    end
    slot := derive_registry_find(s, fname)
    s.derived_decls.set(slot - 1, fn)
    ret fname
end

func name_source(s &: Sema, esym: int, fname: str): str:
    ev := sym_at(s, esym)
    en := ev.name
    mut out := "func " + fname + "(_v: " + en + "): str:\n"
    mems := scope_at(s, ev.members).symbols
    repeat mems.len() with i:
        m := sym_at(s, mems.get(i))
        if m.kind != SYM_ENUM_MEMBER:
            continue
        end
        out = out + "    if _v == " + en + "." + m.name + ": ret \"" + m.name + "\" end\n"
    end
    // Unreachable for any value that actually came from this enum - every
    // member is covered above - but the function still needs a fallthrough
    // return to satisfy "does this function always return".
    ret out + "    ret \"\"\nend\n"
end

func fromstring_source(s &: Sema, esym: int, fname: str): str:
    ev := sym_at(s, esym)
    en := ev.name
    mut first_member := ""
    mut out := "func " + fname + "(_s: str, _ok &: bool): " + en + ":\n"
    mems := scope_at(s, ev.members).symbols
    repeat mems.len() with i:
        m := sym_at(s, mems.get(i))
        if m.kind != SYM_ENUM_MEMBER:
            continue
        end
        if str.Len(first_member) == 0:
            first_member = m.name
        end
        out = out + "    if _s == \"" + m.name + "\": _ok = true ret " + en + "." + m.name + " end\n"
    end
    // No name matched: report failure via _ok and hand back an arbitrary
    // member (the first one declared) so the return type is satisfied - the
    // caller is required to check _ok before trusting the value, exactly
    // like every other ok&:bool-style fallible call in the stdlib.
    ret out + "    _ok = false\n    ret " + en + "." + first_member + "\nend\n"
end

func names_source(s &: Sema, esym: int, fname: str): str:
    ev := sym_at(s, esym)
    mut out := "func " + fname + "(): Vector<str>:\n"
    out = out + "    mut _v := Vector {} as Vector<str>\n"
    mems := scope_at(s, ev.members).symbols
    repeat mems.len() with i:
        m := sym_at(s, mems.get(i))
        if m.kind != SYM_ENUM_MEMBER:
            continue
        end
        out = out + "    _v.push(\"" + m.name + "\")\n"
    end
    ret out + "    ret _v\nend\n"
end

// sema_derive_enum_name -> func _enum_name_T(_v: T): str
func sema_derive_enum_name(s &: Sema, a &: at.Ast, t: int): str:
    ret derive_enum_one(s, a, t, "_enum_name_", ENUM_OP_NAME)
end

// sema_derive_enum_fromstring -> func _enum_fromstring_T(_s: str, _ok &: bool): T
func sema_derive_enum_fromstring(s &: Sema, a &: at.Ast, t: int): str:
    ret derive_enum_one(s, a, t, "_enum_fromstring_", ENUM_OP_FROMSTRING)
end

// sema_derive_enum_names -> func _enum_names_T(): Vector<str>
func sema_derive_enum_names(s &: Sema, a &: at.Ast, t: int): str:
    ret derive_enum_one(s, a, t, "_enum_names_", ENUM_OP_NAMES)
end
