package semantic

import str

include co "../sal_core.salam"
include tok "../token.salam"
include at "../ast.salam"
include i18 "../i18n.salam"

func enum_case_split(name: str, ename &: str, mname &: str): bool:
    if not str.StartsWith(name, "__"):
        ret false
    end
    rest := str.Substr(name, 2, str.Len(name) - 2)
    idx := str.IndexOf(rest, "__")
    if idx <= 0:
        ret false
    end
    ename = str.Substr(rest, 0, idx)
    mname = str.Substr(rest, idx + 2, str.Len(rest) - idx - 2)
    ret true
end

func enum_data_sym(s &: Sema, t: int): int:
    if t < 0:
        ret 0
    end
    tv := ty_at(s, t)
    if tv.kind != TY_VARIANT:
        ret 0
    end
    if tv.decl != 0 and sym_at(s, tv.decl).enum_data:
        ret tv.decl
    end
    if tv.params.len() == 0:
        ret 0
    end
    p0 := ty_at(s, tv.params.get(0))
    if p0.kind != TY_STRUCT or p0.decl == 0 or not sym_at(s, p0.decl).enum_case:
        ret 0
    end
    mut en := ""
    mut mn := ""
    if not enum_case_split(enum_case_base(s, p0.decl), en, mn):
        ret 0
    end
    h := sym_at(s, p0.decl).home
    es := scope_lookup_local(s, h != 0 ? h : s.global, en)
    if es != 0 and sym_at(s, es).enum_data:
        ret es
    end
    ret 0
end

func enum_case_base(s &: Sema, cs: int): str:
    gb := sym_at(s, cs).generic_base
    ret str.Len(gb) > 0 ? gb : sym_at(s, cs).name
end

func enum_case_member(s &: Sema, cs: int): str:
    mut en := ""
    mut mn := ""
    if enum_case_split(enum_case_base(s, cs), en, mn):
        ret mn
    end
    ret sym_at(s, cs).name
end

func enum_is_generic(s &: Sema, a &: at.Ast, esym: int): bool:
    d := sym_at(s, esym).decl
    ret d != 0 and at.TyparamCount(a, d) > 0
end

func enum_case_struct(s &: Sema, vt: int, i: int): int:
    if vt < 0 or i < 0 or ty_at(s, vt).kind != TY_VARIANT or i >= ty_at(s, vt).params.len():
        ret 0
    end
    ret ty_at(s, ty_at(s, vt).params.get(i)).decl
end

func enum_case_count(s &: Sema, vt: int): int:
    if vt < 0 or ty_at(s, vt).kind != TY_VARIANT:
        ret 0
    end
    ret ty_at(s, vt).params.len()
end

func enum_case_index(s &: Sema, a &: at.Ast, vt: int, mname: str): int:
    repeat enum_case_count(s, vt) in i:
        cs := enum_case_struct(s, vt, i)
        if cs != 0 and str.Equals(enum_case_member(s, cs), mname):
            ret i
        end
    end
    repeat enum_case_count(s, vt) in j:
        cs2 := enum_case_struct(s, vt, j)
        if cs2 != 0 and sym_at(s, cs2).decl != 0:
            al := at.Get(a, sym_at(s, cs2).decl).aliases
            mut k := 0
            until k + 1 < al.len():
                if su_ident_eq(al.get(k + 1), mname):
                    ret j
                end
                k += 2
            end
        end
    end
    ret 0 - 1
end

func enum_case_fields(s &: Sema, a &: at.Ast, cs: int, out &: Vector<str>):
    d := sym_at(s, cs).decl
    if d == 0:
        ret
    end
    dn := at.Get(a, d)
    repeat dn.list.len() in i:
        f := at.Get(a, dn.list.get(i))
        if f.kind == at.AST_FIELD and not str.Equals(f.name, "_unit"):
            out.push(f.name)
        end
    end
end

func enum_data_target(s &: Sema, a &: at.Ast, obj: int, qual &: str): int:
    qual = ""
    if obj == 0:
        ret 0
    end
    o := at.Get(a, obj)
    if o.kind == at.AST_IDENTIFIER:
        sy := scope_lookup(s, s.cur, o.name)
        if sy != 0 and sym_at(s, sy).kind == SYM_ALIAS and sym_at(s, sy).enum_data:
            ret sy
        end
        ret 0
    end
    if o.kind != at.AST_MEMBER or o.a == 0 or at.KindOf(a, o.a) != at.AST_IDENTIFIER:
        ret 0
    end
    pk := scope_lookup(s, s.cur, at.Get(a, o.a).name)
    if pk == 0 or sym_at(s, pk).kind != SYM_PACKAGE:
        ret 0
    end
    es := scope_lookup_local(s, sym_at(s, pk).members, pkg_member_canon(s, a, pk, o.name, span_of(a, obj)))
    if es == 0 or sym_at(s, es).kind != SYM_ALIAS or not sym_at(s, es).enum_data:
        ret 0
    end
    qual = at.Get(a, o.a).name + "."
    ret es
end

func preset_type_node(a &: at.Ast, sp: co.SrcSpan, t: int): int:
    tn := new_node_at(a, at.AST_TYPE, sp)
    mut tv := at.Get(a, tn)
    tv.sema_type = t
    at.Put(a, tn, tv)
    ret tn
end

func enum_make_value(s &: Sema, a &: at.Ast, nid: int, qual: str, vt: int, cs: int, args: Vector<int>):
    sp := span_of(a, nid)
    mut fields := Vector {} as Vector<str>
    defer fields.free()
    enum_case_fields(s, a, cs, fields)
    generic := str.Len(sym_at(s, cs).generic_base) > 0
    lit := new_node_at(a, at.AST_STRUCT_LIT, sp)
    at.SetName(a, lit, generic ? sym_at(s, cs).generic_base : qual + sym_at(s, cs).name)
    repeat args.len() in i:
        if i < fields.len():
            fi := new_node_at(a, at.AST_FIELD_INIT, span_of(a, args.get(i)))
            at.SetName(a, fi, fields.get(i))
            mut fv := at.Get(a, fi)
            fv.a = args.get(i)
            at.Put(a, fi, fv)
            at.AddChild(a, lit, fi)
        end
    end
    mut inner := lit
    if generic:
        inner = new_node_at(a, at.AST_CAST, sp)
        mut iv := at.Get(a, inner)
        iv.a = lit
        at.Put(a, inner, iv)
        at.SetTypeNode(a, inner, preset_type_node(a, sp, sym_at(s, cs).ty))
    end
    mut nv := at.Get(a, nid)
    nv.kind = at.AST_CAST
    nv.a = inner
    nv.b = 0
    nv.c = 0
    nv.op = 0
    nv.name = ""
    nv.list = Vector {} as Vector<int>
    at.Put(a, nid, nv)
    at.SetTypeNode(a, nid, preset_type_node(a, sp, vt))
end

func enum_ctor_type(s &: Sema, a &: at.Ast, esym: int, expected: int, what: str, sp: co.SrcSpan): int:
    if not enum_is_generic(s, a, esym):
        ret sym_at(s, esym).ty
    end
    if expected >= 0 and enum_data_sym(s, expected) == esym:
        ret expected
    end
    serr(
        s, 12, sp, co.Format3(
            i18.Tr("cannot tell which '%s' '%s' builds; give it a type, e.g. 'x := ... as %s<...>' or return it from a function"), co.ArgStr(sym_at(s, esym).name), co.ArgStr(what), co.ArgStr(sym_at(s, esym).name)
        )
    )
    ret TYPE_NONE
end

func enum_ctor_rewrite(s &: Sema, a &: at.Ast, n: int, expected: int): int:
    callee := at.Get(a, n).a
    if callee == 0 or at.KindOf(a, callee) != at.AST_MEMBER:
        ret 0
    end
    cv := at.Get(a, callee)
    mut qual := ""
    esym := enum_data_target(s, a, cv.a, qual)
    if esym == 0:
        ret 0
    end
    sp := span_of(a, n)
    if str.Equals(enum_builtin_canon(s, cv.name), "Count") and at.ChildCount(a, n) == 0:
        mut nv := at.Get(a, n)
        nv.kind = at.AST_LITERAL
        nv.op = tok.TK_INT
        nv.value_kind = tok.TV_INT
        nv.value_int = at.Get(a, at.Get(a, sym_at(s, esym).decl).ty).list.len() as u64
        nv.a = 0
        nv.b = 0
        nv.list = Vector {} as Vector<int>
        at.Put(a, n, nv)
        ret 1
    end
    vt := enum_ctor_type(s, a, esym, expected, sym_at(s, esym).name + "." + cv.name, sp)
    if vt == TYPE_NONE:
        ret 2
    end
    ci := enum_case_index(s, a, vt, cv.name)
    if ci < 0:
        serr(
            s, 16, sp, co.Format2(
                i18.Tr("enum '%s' has no member '%s'"), co.ArgStr(sym_at(s, esym).name), co.ArgStr(cv.name)
            )
        )
        ret 2
    end
    cs := enum_case_struct(s, vt, ci)
    mut fields := Vector {} as Vector<str>
    defer fields.free()
    enum_case_fields(s, a, cs, fields)
    nargs := at.ChildCount(a, n)
    if nargs != fields.len():
        serr(
            s, 12, sp, co.Format4(
                i18.Tr("'%s' takes %zu value%s, got %zu"), co.ArgStr(sym_at(s, esym).name + "." + cv.name), co.ArgUint(fields.len() as u64), co.ArgStr(plural_suffix(fields.len())), co.ArgUint(nargs as u64)
            )
        )
        ret 2
    end
    mut args := Vector {} as Vector<int>
    defer args.free()
    repeat nargs in i:
        args.push(at.Child(a, n, i))
    end
    enum_make_value(s, a, n, qual, vt, cs, args)
    ret 1
end

func enum_value_rewrite(s &: Sema, a &: at.Ast, nid: int, expected: int): int:
    nv := at.Get(a, nid)
    mut qual := ""
    esym := enum_data_target(s, a, nv.a, qual)
    if esym == 0:
        ret 0
    end
    sp := span_of(a, nid)
    vt := enum_ctor_type(s, a, esym, expected, sym_at(s, esym).name + "." + nv.name, sp)
    if vt == TYPE_NONE:
        ret 2
    end
    ci := enum_case_index(s, a, vt, nv.name)
    if ci < 0:
        serr(
            s, 16, sp, co.Format2(
                i18.Tr("enum '%s' has no member '%s'"), co.ArgStr(sym_at(s, esym).name), co.ArgStr(nv.name)
            )
        )
        ret 2
    end
    cs := enum_case_struct(s, vt, ci)
    mut fields := Vector {} as Vector<str>
    defer fields.free()
    enum_case_fields(s, a, cs, fields)
    if fields.len() > 0:
        serr(
            s, 12, sp, co.Format3(
                i18.Tr("'%s.%s' carries data: build it with %s(...)"), co.ArgStr(sym_at(s, esym).name), co.ArgStr(nv.name), co.ArgStr(sym_at(s, esym).name + "." + nv.name)
            )
        )
        ret 2
    end
    mut args := Vector {} as Vector<int>
    defer args.free()
    enum_make_value(s, a, nid, qual, vt, cs, args)
    ret 1
end

func enum_pattern_prepare(s &: Sema, a &: at.Ast, arm: int, pat: int, vt: int): bool:
    esym := enum_data_sym(s, vt)
    pv := at.Get(a, pat)
    if pv.a == 0 or at.KindOf(a, pv.a) != at.AST_IDENTIFIER:
        ret true
    end
    psp := span_of(a, pat)
    mname := at.Get(a, pv.a).name
    ci := enum_case_index(s, a, vt, mname)
    if ci < 0:
        serr(
            s, 16, psp, co.Format2(
                i18.Tr("enum '%s' has no member '%s'"), co.ArgStr(sym_at(s, esym).name), co.ArgStr(mname)
            )
        )
        ret false
    end
    cs := enum_case_struct(s, vt, ci)
    mut pav := at.Get(a, pv.a)
    pav.sema_type = sym_at(s, cs).ty
    at.Put(a, pv.a, pav)
    if not pv.enum_payload:
        ret true
    end
    mut fields := Vector {} as Vector<str>
    defer fields.free()
    enum_case_fields(s, a, cs, fields)
    if pv.list.len() != fields.len():
        serr(
            s, 76, psp, co.Format4(
                i18.Tr("'%s.%s' holds %zu value%s; bind each one, or '_' to skip it"), co.ArgStr(sym_at(s, esym).name), co.ArgStr(mname), co.ArgUint(fields.len() as u64), co.ArgStr(plural_suffix(fields.len()))
            )
        )
        ret false
    end
    if str.Len(pv.name) > 0:
        serr(
            s, 76, psp, i18.Tr("a pattern cannot both bind its fields and name the whole value")
        )
        ret false
    end
    hidden := "__pb" + str.FromInt(pat as i64)
    mut decls := Vector {} as Vector<int>
    defer decls.free()
    repeat fields.len() in i:
        b := pv.list.get(i)
        bname := at.Get(a, b).name
        if str.Equals(bname, "_"):
            continue
        end
        bsp := span_of(a, b)
        src := new_node_at(a, at.AST_IDENTIFIER, bsp)
        at.SetName(a, src, hidden)
        mem := new_node_at(a, at.AST_MEMBER, bsp)
        at.SetName(a, mem, fields.get(i))
        mut mv := at.Get(a, mem)
        mv.a = src
        at.Put(a, mem, mv)
        decl := new_node_at(a, at.AST_VAR_DECL, bsp)
        mut dv := at.Get(a, decl)
        dv.name = bname
        dv.a = mem
        dv.enum_payload = true
        at.Put(a, decl, dv)
        decls.push(decl)
    end
    mut pv2 := at.Get(a, pat)
    pv2.name = hidden
    pv2.list = Vector {} as Vector<int>
    pv2.enum_payload = false
    at.Put(a, pat, pv2)
    armb := at.Get(a, arm).b
    mut bv := at.Get(a, armb)
    mut nl := Vector {} as Vector<int>
    repeat decls.len() in k:
        nl.push(decls.get(k))
    end
    repeat bv.list.len() in k2:
        nl.push(bv.list.get(k2))
    end
    old := bv.list
    bv.list = nl
    at.Put(a, armb, bv)
    old.free()
    ret true
end

func enum_data_disp(s &: Sema, t: int): str:
    es := enum_data_sym(s, t)
    if es != 0:
        if str.Len(ty_at(s, t).name) > 0:
            ret ty_at(s, t).name
        end
        ret sym_at(s, es).name
    end
    if t >= 0 and ty_at(s, t).kind == TY_STRUCT and ty_at(s, t).decl != 0 and sym_at(s, ty_at(s, t).decl).enum_case:
        mut en := ""
        mut mn := ""
        if enum_case_split(enum_case_base(s, ty_at(s, t).decl), en, mn):
            ret en + "." + mn
        end
    end
    ret ""
end

func enum_data_spelling(s &: Sema, vt: int): str:
    esym := enum_data_sym(s, vt)
    mut base := sym_at(s, esym).name
    home := sym_at(s, esym).home
    if home != 0 and home != s.global:
        pkg := derive_pkg_name_of(s, home)
        if str.Len(pkg) > 0:
            base = pkg + "." + base
        end
    end
    cs0 := enum_case_struct(s, vt, 0)
    if cs0 == 0 or sym_at(s, cs0).generic_args.len() == 0:
        ret base
    end
    gargs := sym_at(s, cs0).generic_args
    mut out := base + "<"
    repeat gargs.len() in i:
        sp1 := derive_type_spelling(s, gargs.get(i))
        if str.Len(sp1) == 0:
            ret ""
        end
        out = out + (i > 0 ? ", " : "") + sp1
    end
    ret out + ">"
end

func enum_data_body(s &: Sema, a &: at.Ast, vt: int, sp: co.SrcSpan): str:
    mut out := DV_IND + "mut " + DV_BUF + " := \"\"\n" + DV_IND + "match " + DV_PARAM + ":\n"
    ind2 := DV_IND + DV_IND
    ind3 := ind2 + DV_IND
    repeat enum_case_count(s, vt) in i:
        cs := enum_case_struct(s, vt, i)
        mname := enum_case_member(s, cs)
        mut fields := Vector {} as Vector<str>
        enum_case_fields(s, a, cs, fields)
        out = out + ind2 + mname + " _c:\n"
        if fields.len() == 0:
            out = out + ind3 + DV_BUF + " = " + DV_BUF + " + \"" + mname + "\"\n"
        else:
            out = out + ind3 + DV_BUF + " = " + DV_BUF + " + \"" + mname + "(\"\n"
            repeat fields.len() in j:
                f := scope_lookup_local(s, sym_at(s, cs).members, fields.get(j))
                sep := j == 0 ? "" : ", "
                out = out + ind3 + DV_BUF + " = " + DV_BUF + " + \"" + sep + fields.get(j) + " = \"\n"
                out = out + DV_IND + DV_IND + derive_append(s, a, sym_at(s, f).ty, "_c." + fields.get(j), sp)
            end
            out = out + ind3 + DV_BUF + " = " + DV_BUF + " + \")\"\n"
        end
        out = out + ind2 + "end\n"
        fields.free()
    end
    ret out + DV_IND + "end\n"
end

func enum_data_eq_possible(s &: Sema, vt: int, depth: int): bool:
    repeat enum_case_count(s, vt) in i:
        cs := enum_case_struct(s, vt, i)
        if cs == 0 or not derive_eq_possible(s, sym_at(s, cs).ty, depth + 1):
            ret false
        end
    end
    ret true
end

func enum_data_eq_source(s &: Sema, vt: int, fname: str): str:
    spelling := enum_data_spelling(s, vt)
    if str.Len(spelling) == 0:
        ret ""
    end
    mut out := "func " + fname + "(_a: " + spelling + ", _b: " + spelling + "): bool:\n"
    out = out + DV_IND + "match _a:\n"
    ind2 := DV_IND + DV_IND
    ind3 := ind2 + DV_IND
    ind4 := ind3 + DV_IND
    repeat enum_case_count(s, vt) in i:
        mname := enum_case_member(s, enum_case_struct(s, vt, i))
        out = out + ind2 + mname + " _x:\n"
        out = out + ind3 + "match _b:\n"
        out = out + ind4 + mname + " _y:\n"
        out = out + ind4 + DV_IND + "ret _x == _y\n"
        out = out + ind4 + "end\n"
        if enum_case_count(s, vt) > 1:
            out = out + ind4 + "else:\n"
            out = out + ind4 + DV_IND + "ret false\n"
            out = out + ind4 + "end\n"
        end
        out = out + ind3 + "end\n"
        out = out + ind2 + "end\n"
    end
    ret out + DV_IND + "end\n" + DV_IND + "ret false\nend\n"
end

func derive_enum_eq(s &: Sema, a &: at.Ast, t: int): str:
    esym := enum_data_sym(s, t)
    if esym == 0 or s.program == 0 or not enum_data_eq_possible(s, t, 0):
        ret ""
    end
    fname := derive_eq_name(s, t)
    if derive_registry_find(s, fname) != 0:
        ret fname
    end
    if scope_lookup_local(s, s.global, fname) != 0:
        ret ""
    end
    derive_registry_claim(s, fname)
    src := enum_data_eq_source(s, t, fname)
    if str.Len(src) == 0:
        derive_registry_drop(s, derive_registry_find(s, fname))
        ret ""
    end
    prog := derive_parse(s, a, src, "<derived>")
    mut fn := 0
    if prog != 0:
        fn = derive_install_all(s, a, prog, fname, 0)
    end
    if fn == 0:
        derive_registry_drop(s, derive_registry_find(s, fname))
        ret ""
    end
    slot := derive_registry_find(s, fname)
    s.derived_decls.set(slot - 1, fn)
    ret fname
end

func g_instantiate_enum(s &: Sema, a &: at.Ast, esym: int, targ_nodes: Vector<int>, sp: co.SrcSpan, home: int): int:
    d := at.Get(a, sym_at(s, esym).decl)
    if targ_nodes.len() != d.typarams.len():
        serr(
            s, 1, sp, co.Format4(
                i18.Tr("generic '%s' expects %zu type argument%s, got %zu"), co.ArgStr(d.name), co.ArgUint(d.typarams.len() as u64), co.ArgStr(plural_suffix(d.typarams.len())), co.ArgUint(targ_nodes.len() as u64)
            )
        )
        ret sema_err_ty(s)
    end
    mut disp := sym_at(s, esym).name + "<"
    mut argtypes := Vector {} as Vector<int>
    defer argtypes.free()
    repeat targ_nodes.len() in i:
        tt := sema_resolve_type(s, a, targ_nodes.get(i))
        if type_is_error(s, tt):
            ret sema_err_ty(s)
        end
        argtypes.push(tt)
        disp = disp + (i > 0 ? ", " : "") + type_to_string(s, tt)
    end
    disp = disp + ">"
    tnode := at.Clone(a, d.ty)
    rargs := g_resolved_targs(a, targ_nodes, argtypes)
    g_subst(a, tnode, d.typarams, rargs)
    rargs.free()
    save_cur := s.cur
    save_gp := s.gen_pkg
    if home != 0:
        s.cur = home
        s.gen_pkg = home
    end
    vt := sema_resolve_type(s, a, tnode)
    s.cur = save_cur
    s.gen_pkg = save_gp
    if vt >= 0 and ty_at(s, vt).kind == TY_VARIANT:
        mut tv := ty_at(s, vt)
        tv.decl = esym
        tv.name = disp
        ty_put(s, vt, tv)
    end
    ret vt
end

func derive_enum_data_name(s &: Sema, a &: at.Ast, t: int): str:
    esym := enum_data_sym(s, t)
    spelling := derive_type_spelling(s, t)
    if esym == 0 or s.program == 0 or str.Len(spelling) == 0:
        ret ""
    end
    fname := "_nameof_" + derive_key(type_to_string(s, t))
    if derive_registry_find(s, fname) != 0:
        ret fname
    end
    if scope_lookup_local(s, s.global, fname) != 0:
        ret ""
    end
    derive_registry_claim(s, fname)
    mut src := "func " + fname + "(_v: " + spelling + "): str:\n" + DV_IND + "ret match _v:\n"
    repeat enum_case_count(s, t) in i:
        mname := enum_case_member(s, enum_case_struct(s, t, i))
        src = src + DV_IND + DV_IND + mname + " _c => \"" + mname + "\"\n"
    end
    src = src + DV_IND + "end\nend\n"
    prog := derive_parse(s, a, src, "<derived>")
    mut fn := 0
    if prog != 0:
        fn = derive_install_all(s, a, prog, fname, 0)
    end
    if fn == 0:
        derive_registry_drop(s, derive_registry_find(s, fname))
        ret ""
    end
    slot := derive_registry_find(s, fname)
    s.derived_decls.set(slot - 1, fn)
    ret fname
end
