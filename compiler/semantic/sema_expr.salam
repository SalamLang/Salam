package semantic

import str

include co "../sal_core.salam"
include tok "../token.salam"
include at "../ast.salam"
include i18 "../i18n.salam"

func tk_is_arith(k: int): bool:
    ret k == tok.TK_PLUS or k == tok.TK_MINUS or k == tok.TK_STAR or k == tok.TK_SLASH or k == tok.TK_PERCENT
end

func sema_tk_is_bitwise(k: int): bool:
    ret k == tok.TK_AMP or k == tok.TK_PIPE or k == tok.TK_CARET or k == tok.TK_SHL or k == tok.TK_SHR
end

func int_lit_fits(u: u64, k: int): bool:
    if k == TY_I8:
        ret u <= 127 as u64
    end
    if k == TY_I16:
        ret u <= 32767 as u64
    end
    if k == TY_I32:
        ret u <= 2147483647 as u64
    end
    if k == TY_I64 or k == TY_SIZE:
        ret u <= 9223372036854775807 as u64
    end
    if k == TY_U8:
        ret u <= 255 as u64
    end
    if k == TY_U16:
        ret u <= 65535 as u64
    end
    if k == TY_U32:
        ret u <= 4294967295 as u64
    end
    if k == TY_U64 or k == TY_USIZE:
        ret true
    end
    ret false
end

func sema_type_is_stringable(s &: Sema, t: int): bool:
    k := ty_at(s, t).kind
    ret k == TY_STR or k == TY_UCHAR or k == TY_BOOL or k == TY_CHAR or type_is_numeric(s, t)
end

func tk_is_cmp(k: int): bool:
    ret k == tok.TK_LT or k == tok.TK_GT or k == tok.TK_LE or k == tok.TK_GE
end

func tk_is_eq(k: int): bool:
    ret k == tok.TK_EQ or k == tok.TK_NE
end

func sema_op_method(k: int): str:
    if k == tok.TK_PLUS:
        ret "operator_add"
    end
    if k == tok.TK_MINUS:
        ret "operator_sub"
    end
    if k == tok.TK_STAR:
        ret "operator_mul"
    end
    if k == tok.TK_SLASH:
        ret "operator_div"
    end
    if k == tok.TK_PERCENT:
        ret "operator_mod"
    end
    if k == tok.TK_POWER:
        ret "operator_pow"
    end
    if k == tok.TK_EQ:
        ret "operator_eq"
    end
    if k == tok.TK_NE:
        ret "operator_ne"
    end
    if k == tok.TK_LT:
        ret "operator_lt"
    end
    if k == tok.TK_GT:
        ret "operator_gt"
    end
    if k == tok.TK_LE:
        ret "operator_le"
    end
    if k == tok.TK_GE:
        ret "operator_ge"
    end
    ret ""
end

func sema_compound_base(k: int): int:
    if k == tok.TK_PLUS_EQ:
        ret tok.TK_PLUS
    end
    if k == tok.TK_MINUS_EQ:
        ret tok.TK_MINUS
    end
    if k == tok.TK_STAR_EQ:
        ret tok.TK_STAR
    end
    if k == tok.TK_SLASH_EQ:
        ret tok.TK_SLASH
    end
    if k == tok.TK_PERCENT_EQ:
        ret tok.TK_PERCENT
    end
    if k == tok.TK_POWER_EQ:
        ret tok.TK_POWER
    end
    if k == tok.TK_AMP_EQ:
        ret tok.TK_AMP
    end
    if k == tok.TK_PIPE_EQ:
        ret tok.TK_PIPE
    end
    if k == tok.TK_CARET_EQ:
        ret tok.TK_CARET
    end
    if k == tok.TK_SHL_EQ:
        ret tok.TK_SHL
    end
    if k == tok.TK_SHR_EQ:
        ret tok.TK_SHR
    end
    ret tok.TK_EOF
end

func sema_try_op_overload(
    s &: Sema, a &: at.Ast, n: int, ssym: int, mname: str, rhs_type: int
): int:
    m := scope_lookup_local(s, sym_at(s, ssym).members, mname)
    if m == 0 or sym_at(s, m).kind != SYM_METHOD:
        ret TYPE_NONE
    end
    mut otys := Vector {} as Vector<int>
    defer otys.free()
    if rhs_type != TYPE_NONE:
        otys.push(rhs_type)
    end
    sig := resolve_overload(s, a, m, otys, span_of(a, n), mname)
    if sig == 0:
        ret TYPE_NONE
    end
    ret sig_at(s, sig).ret_type
end

func is_int_lit(a &: at.Ast, nid: int): bool:
    if nid == 0:
        ret false
    end
    n := at.Get(a, nid)
    ret n.kind == at.AST_LITERAL and n.op == tok.TK_INT
end

func check_binary(s &: Sema, a &: at.Ast, nid: int): int:
    n := at.Get(a, nid)
    sp := span_of(a, nid)
    l_lit := is_int_lit(a, n.a)
    r_lit := is_int_lit(a, n.b)
    mut l := TYPE_NONE
    mut r := TYPE_NONE
    if r_lit and not l_lit:
        l = sema_check_expr(s, a, n.a)
        if type_is_integer(s, l):
            s.expected = l
        end
        r = sema_check_expr(s, a, n.b)
    else l_lit and not r_lit:
        r = sema_check_expr(s, a, n.b)
        if type_is_integer(s, r):
            s.expected = r
        end
        l = sema_check_expr(s, a, n.a)
    else:
        l = sema_check_expr(s, a, n.a)
        r = sema_check_expr(s, a, n.b)
    end
    op := n.op
    if type_is_error(s, l) or type_is_error(s, r):
        ret sema_decorate(s, a, nid, sema_err_ty(s))
    end
    db := distinct_try_binary(s, a, nid, l, r)
    if db != TYPE_NONE:
        ret db
    end

    ssym := struct_sym_of(s, l)
    if ssym != 0:
        if op == tok.TK_NE:
            m_ne := scope_lookup_local(s, sym_at(s, ssym).members, "operator_ne")
            mut ne_is_method := m_ne != 0
            if ne_is_method and sym_at(s, m_ne).kind != SYM_METHOD:
                ne_is_method = false
            end
            if not ne_is_method:
                ov := sema_try_op_overload(s, a, nid, ssym, "operator_eq", r)
                if ov != TYPE_NONE:
                    mut nv := at.Get(a, nid)
                    nv.synthetic = true
                    at.Put(a, nid, nv)
                    ret sema_decorate(s, a, nid, sema_ty(s, TY_BOOL))
                end
            end
        end
        mname := sema_op_method(op)
        if str.Len(mname) > 0:
            ov2 := sema_try_op_overload(s, a, nid, ssym, mname, r)
            if ov2 != TYPE_NONE:
                ret sema_decorate(s, a, nid, ov2)
            end
        end
        if (op == tok.TK_EQ or op == tok.TK_NE) and type_equiv(s, l, r):
            fname := derive_struct_eq(s, a, l, sp)
            if str.Len(fname) > 0:
                derive_rewrite_eq(s, a, nid, fname, op == tok.TK_NE)
                ret sema_decorate(s, a, nid, sema_ty(s, TY_BOOL))
            end
            serr(
                s, 21, sp, co.Format1(
                    i18.Tr("values of type '%s' cannot be compared field by field; define operator_eq on the struct"), co.ArgStr(type_disp(s, l))
                )
            )
            ret sema_decorate(s, a, nid, sema_err_ty(s))
        end
    end
    if op == tok.TK_POWER:
        if not type_is_numeric(s, l) or not type_is_numeric(s, r):
            serr(s, 21, sp, i18.Tr("operator '**' requires numeric operands"))
        end
        ret sema_decorate(s, a, nid, sema_ty(s, TY_F64))
    end
    if op == tok.TK_AND or op == tok.TK_OR:
        if ty_at(s, l).kind != TY_BOOL or ty_at(s, r).kind != TY_BOOL:
            serr(s, 21, sp, i18.Tr("logical operator requires bool operands"))
        end
        ret sema_decorate(s, a, nid, sema_ty(s, TY_BOOL))
    end
    if tk_is_arith(op):
        lk := ty_at(s, l).kind
        rk := ty_at(s, r).kind
        if op == tok.TK_PLUS and (
            lk == TY_STR or rk == TY_STR or lk == TY_UCHAR or rk == TY_UCHAR
        ):
            if sema_type_is_stringable(s, l) and sema_type_is_stringable(s, r):
                ret sema_decorate(s, a, nid, sema_ty(s, TY_STR))
            end
            serr(
                s, 21, sp, co.Format2(
                    i18.Tr("operator '+' on a string requires the other operand to be a string, number, bool, or char (got '%s' and '%s')"), co.ArgStr(type_disp(s, l)), co.ArgStr(type_disp(s, r))
                )
            )
            ret sema_decorate(s, a, nid, sema_err_ty(s))
        end
        if op == tok.TK_STAR and (lk == TY_STR or rk == TY_STR):
            if (lk == TY_STR and type_is_integer(s, r)) or (rk == TY_STR and type_is_integer(s, l)):
                ret sema_decorate(s, a, nid, sema_ty(s, TY_STR))
            end
            serr(
                s, 21, sp, co.Format2(
                    i18.Tr("operator '*' on a string requires the other operand to be an integer (got '%s' and '%s')"), co.ArgStr(type_disp(s, l)), co.ArgStr(type_disp(s, r))
                )
            )
            ret sema_decorate(s, a, nid, sema_err_ty(s))
        end
        c := type_common_arith(s, l, r)
        if c < 0:
            serr(
                s, 21, sp, co.Format2(
                    i18.Tr("operator cannot be applied to '%s' and '%s'"), co.ArgStr(type_disp(s, l)), co.ArgStr(type_disp(s, r))
                )
            )
            ret sema_decorate(s, a, nid, sema_err_ty(s))
        end
        if op == tok.TK_PERCENT and not type_is_integer(s, c):
            serr(
                s, 21, sp, co.Format0(i18.Tr("operator '%%' requires integer operands"))
            )
        end
        ret sema_decorate(s, a, nid, c)
    end
    if sema_tk_is_bitwise(op):
        if not type_is_integer(s, l) or not type_is_integer(s, r):
            serr(
                s, 21, sp, co.Format2(
                    i18.Tr("bitwise operator requires integer operands (got '%s' and '%s')"), co.ArgStr(type_disp(s, l)), co.ArgStr(type_disp(s, r))
                )
            )
            ret sema_decorate(s, a, nid, sema_err_ty(s))
        end
        if op == tok.TK_SHL or op == tok.TK_SHR:
            lt := type_common_arith(s, l, l)
            rt := lt >= 0 ? lt : l
            mut cnt := 0 as i64
            if lit_int(a, n.b, cnt):
                width := fold_ts_bits(type_to_string(s, rt))
                if cnt < 0 or cnt >= (width as i64):
                    serr(
                        s, 21, sp, co.Format2(
                            i18.Tr("shift count %d is outside the width of '%s'"), co.ArgInt(cnt), co.ArgStr(type_disp(s, rt))
                        )
                    )
                end
            end
            ret sema_decorate(s, a, nid, rt)
        end
        c2 := type_common_arith(s, l, r)
        if c2 < 0 or not type_is_integer(s, c2):
            serr(
                s, 21, sp, co.Format2(
                    i18.Tr("bitwise operator cannot be applied to '%s' and '%s'"), co.ArgStr(type_disp(s, l)), co.ArgStr(type_disp(s, r))
                )
            )
            ret sema_decorate(s, a, nid, sema_err_ty(s))
        end
        ret sema_decorate(s, a, nid, c2)
    end
    if tk_is_eq(op) and enum_data_sym(s, l) != 0 and type_equiv(s, l, r):
        efn := derive_enum_eq(s, a, l)
        if str.Len(efn) > 0:
            derive_rewrite_eq(s, a, nid, efn, op == tok.TK_NE)
            ret sema_decorate(s, a, nid, sema_ty(s, TY_BOOL))
        end
        serr(
            s, 21, sp, co.Format1(
                i18.Tr("values of enum '%s' cannot be compared: a member holds data without '=='"), co.ArgStr(type_disp(s, l))
            )
        )
        ret sema_decorate(s, a, nid, sema_err_ty(s))
    end
    if tk_is_cmp(op) or tk_is_eq(op):
        mut cok := false
        if type_is_numeric(s, l) and type_is_numeric(s, r) and type_common_arith(s, l, r) >= 0:
            cok = true
        else type_equiv(s, l, r) or types_text_pair(s, l, r):
            cok = true
        else tk_is_eq(op) and (
            (ty_at(s, l).kind == TY_NULL and ty_at(s, r).kind == TY_PTR) or (ty_at(s, r).kind == TY_NULL and ty_at(s, l).kind == TY_PTR)
        ):
            cok = true
        end
        if cok and not sema_kind_is_comparable(ty_at(s, l).kind):
            cok = false
        end
        if not cok:
            serr(
                s, 21, sp, co.Format2(
                    i18.Tr("cannot compare '%s' and '%s'"), co.ArgStr(type_disp(s, l)), co.ArgStr(type_disp(s, r))
                )
            )
        end
        ret sema_decorate(s, a, nid, sema_ty(s, TY_BOOL))
    end
    ret sema_decorate(s, a, nid, sema_err_ty(s))
end

func sema_kind_is_comparable(k: int): bool:
    ret k == TY_BOOL or k == TY_CHAR or k == TY_UCHAR or k == TY_STR or k == TY_PTR or k == TY_NULL or k == TY_ENUM or k == TY_FUNC or k == TY_I8 or k == TY_I16 or k == TY_I32 or k == TY_I64 or k == TY_U8 or k == TY_U16 or k == TY_U32 or k == TY_U64 or k == TY_USIZE or k == TY_SIZE or k == TY_F32 or k == TY_F64
end

func check_ternary(s &: Sema, a &: at.Ast, nid: int): int:
    n := at.Get(a, nid)
    exp := s.expected
    s.expected = TYPE_NONE
    c := sema_check_expr(s, a, n.a)
    if ty_at(s, c).kind != TY_BOOL and not type_is_error(s, c):
        serr(
            s, 21, span_of(a, n.a), co.Format1(
                i18.Tr("'?:' condition must be bool, got '%s'"), co.ArgStr(type_disp(s, c))
            )
        )
    end
    t_lit := is_int_lit(a, n.b)
    f_lit := is_int_lit(a, n.c)
    mut tt := TYPE_NONE
    mut tf := TYPE_NONE
    if f_lit and not t_lit:
        s.expected = exp
        tt = sema_check_expr(s, a, n.b)
        s.expected = type_is_integer(s, tt) ? tt : exp
        tf = sema_check_expr(s, a, n.c)
    else t_lit and not f_lit:
        s.expected = exp
        tf = sema_check_expr(s, a, n.c)
        s.expected = type_is_integer(s, tf) ? tf : exp
        tt = sema_check_expr(s, a, n.b)
    else:
        s.expected = exp
        tt = sema_check_expr(s, a, n.b)
        s.expected = exp
        tf = sema_check_expr(s, a, n.c)
    end
    s.expected = TYPE_NONE
    if type_is_error(s, tt) or type_is_error(s, tf):
        ret sema_decorate(s, a, nid, sema_err_ty(s))
    end
    if type_equiv(s, tt, tf):
        ret sema_decorate(s, a, nid, tt)
    end
    if type_is_numeric(s, tt) and type_is_numeric(s, tf):
        common := type_common_arith(s, tt, tf)
        if common >= 0:
            ret sema_decorate(s, a, nid, common)
        end
    end
    if ty_at(s, tt).kind == TY_NULL and ty_at(s, tf).kind == TY_PTR:
        ret sema_decorate(s, a, nid, tf)
    end
    if ty_at(s, tf).kind == TY_NULL and ty_at(s, tt).kind == TY_PTR:
        ret sema_decorate(s, a, nid, tt)
    end
    serr(
        s, 21, span_of(a, nid), co.Format2(
            i18.Tr("'?:' branches have mismatched types '%s' and '%s'"), co.ArgStr(type_disp(s, tt)), co.ArgStr(type_disp(s, tf))
        )
    )
    ret sema_decorate(s, a, nid, sema_err_ty(s))
end

func resolve_enum_member(s &: Sema, a &: at.Ast, nid: int, sy: int): int:
    n := at.Get(a, nid)
    sp := span_of(a, nid)
    syv := sym_at(s, sy)
    _de := sema_decorate(s, a, n.a, syv.ty)
    mut m2 := 0
    if syv.members != 0:
        m2 = scope_lookup_local(s, syv.members, n.name)
    end
    if m2 == 0:
        serr(
            s, 16, sp, co.Format2(
                i18.Tr("enum '%s' has no member '%s'"), co.ArgStr(syv.name), co.ArgStr(n.name)
            ) + sema_suggest(s, a, syv.members, n.name, SUGGEST_ANY, false)
        )
    end
    ret sema_decorate(s, a, nid, syv.ty)
end

func check_member(s &: Sema, a &: at.Ast, nid: int): int:
    exp0 := s.expected
    s.expected = TYPE_NONE
    erw := enum_value_rewrite(s, a, nid, exp0)
    if erw == 2:
        ret sema_decorate(s, a, nid, sema_err_ty(s))
    end
    if erw == 1:
        ret sema_check_expr(s, a, nid)
    end
    srw := static_member_rewrite(s, a, nid)
    if srw == 2:
        ret sema_decorate(s, a, nid, sema_err_ty(s))
    end
    if srw == 1:
        ret sema_check_expr(s, a, nid)
    end
    n := at.Get(a, nid)
    sp := span_of(a, nid)
    if n.a != 0 and at.KindOf(a, n.a) == at.AST_IDENTIFIER:
        pk := scope_lookup(s, s.cur, at.Get(a, n.a).name)
        if pk != 0 and sym_at(s, pk).kind == SYM_PACKAGE:
            mname := pkg_member_canon(s, a, pk, n.name, sp)
            at.SetName(a, nid, mname)
            pkv := sym_at(s, pk)
            m := scope_lookup_local(s, pkv.members, mname)
            if m == 0:
                serr(
                    s, 16, sp, co.Format2(
                        i18.Tr("package '%s' has no exported member '%s'"), co.ArgStr(pkv.name), co.ArgStr(mname)
                    ) + sema_suggest(s, a, pkv.members, mname, SUGGEST_ANY, true)
                )
                ret sema_decorate(s, a, nid, sema_err_ty(s))
            end
            mv := sym_at(s, m)
            if not mv.is_pub:
                serr(
                    s, 17, sp, co.Format2(
                        i18.Tr("'%s' is not exported by package '%s' (mark it 'pub')"), co.ArgStr(mname), co.ArgStr(pkv.name)
                    )
                )
                ret sema_decorate(s, a, nid, sema_err_ty(s))
            end
            if mv.kind == SYM_FUNC:
                if not func_addr_target_ok(s, a, m, mname, sp):
                    ret sema_decorate(s, a, nid, sema_err_ty(s))
                end
                mut mvu := sym_at(s, m)
                mvu.used = true
                sym_put(s, m, mvu)
                dce_mark_root(
                    str.Len(mvu.pkgname) > 0 ? mvu.pkgname : pkv.name, mvu.name
                )
                _dp := sema_decorate(s, a, n.a, pkv.ty)
                mut fvn2 := at.Get(a, nid)
                fvn2.func_value = true
                at.Put(a, nid, fvn2)
                ret sema_decorate(s, a, nid, sema_ty(s, TY_I64))
            end
            if mv.kind == SYM_ENUM or mv.kind == SYM_STRUCT:
                serr(
                    s, 1, sp, co.Format2(
                        i18.Tr("type '%s.%s' used as a value"), co.ArgStr(pkv.name), co.ArgStr(mname)
                    )
                )
                ret sema_decorate(s, a, nid, sema_err_ty(s))
            end
            _da := sema_decorate(s, a, n.a, pkv.ty)
            ret sema_decorate(s, a, nid, mv.ty)
        end
    end

    if n.a != 0 and at.KindOf(a, n.a) == at.AST_IDENTIFIER:
        sy := scope_lookup(s, s.cur, at.Get(a, n.a).name)
        if sy != 0 and sym_at(s, sy).kind == SYM_ENUM:
            ret resolve_enum_member(s, a, nid, sy)
        end
        if sy != 0 and sym_at(s, sy).kind == SYM_ALIAS:
            aty := sym_at(s, sy).ty
            if aty >= 0 and ty_at(s, aty).kind == TY_ENUM and ty_at(s, aty).decl != 0:
                esym := ty_at(s, aty).decl
                at.SetName(a, n.a, sym_at(s, esym).name)
                ret resolve_enum_member(s, a, nid, esym)
            end
        end
    end

    if n.a != 0 and at.KindOf(a, n.a) == at.AST_MEMBER:
        an := at.Get(a, n.a)
        if an.a != 0 and at.KindOf(a, an.a) == at.AST_IDENTIFIER:
            pk2 := scope_lookup(s, s.cur, at.Get(a, an.a).name)
            if pk2 != 0 and sym_at(s, pk2).kind == SYM_PACKAGE:
                pk2v := sym_at(s, pk2)
                mname2 := pkg_member_canon(s, a, pk2, an.name, span_of(a, n.a))
                at.SetName(a, n.a, mname2)
                m3 := scope_lookup_local(s, pk2v.members, mname2)
                if m3 != 0 and sym_at(s, m3).kind == SYM_ENUM:
                    ret resolve_enum_member(s, a, nid, m3)
                end
            end
        end
    end

    objt := sema_check_expr(s, a, n.a)
    if type_is_error(s, objt):
        ret sema_decorate(s, a, nid, sema_err_ty(s))
    end
    ssym := struct_sym_of(s, objt)
    if ssym == 0:
        serr(
            s, 29, sp, co.Format1(
                i18.Tr("member access on non-struct type '%s'"), co.ArgStr(type_disp(s, objt))
            )
        )
        ret sema_decorate(s, a, nid, sema_err_ty(s))
    end
    ssv := sym_at(s, ssym)
    fname := scope_member_canon(s, a, ssv.members, n.name, sp)
    at.SetName(a, nid, fname)
    f := scope_lookup_local(s, ssv.members, fname)
    if f == 0:
        pr := embed_promote(s, a, nid, ssym, fname)
        if pr == 1:
            ret check_member(s, a, nid)
        end
        if pr == 2:
            ret sema_decorate(s, a, nid, sema_err_ty(s))
        end
        serr(
            s, 16, sp, co.Format2(
                i18.Tr("no field '%s' in struct '%s'"), co.ArgStr(fname), co.ArgStr(ssv.name)
            )
        )
        ret sema_decorate(s, a, nid, sema_err_ty(s))
    end
    fv := sym_at(s, f)
    if fv.kind == SYM_METHOD:
        serr(
            s, 17, sp, co.Format1(
                i18.Tr("method '%s' used as a value (call it)"), co.ArgStr(fname)
            )
        )
        ret sema_decorate(s, a, nid, sema_err_ty(s))
    end
    if not fv.is_pub and not sema_in_struct(s, ssym) and not s.in_derive:
        serr(
            s, 17, sp, co.Format2(
                i18.Tr("field '%s' is private in struct '%s' (mark it 'pub')"), co.ArgStr(fname), co.ArgStr(ssv.name)
            )
        )
    end
    ret sema_decorate(s, a, nid, fv.ty)
end
