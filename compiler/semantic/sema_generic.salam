package semantic

import str

include co "../sal_core.salam"
include tok "../token.salam"
include at "../ast.salam"
include i18 "../i18n.salam"
include cc "../condcomp.salam"

func new_node_at(a &: at.Ast, kind: int, sp: co.SrcSpan): int:
    id := at.NewNode(a, kind)
    at.SetSpan(
        a, id, sp.begin.line, sp.begin.col, sp.begin.index, sp.finish.line, sp.finish.col, sp.finish.index, sp.length
    )
    ret id
end

func g_sanitize(ts: str): str:
    mut out := ""
    n := str.Len(ts)
    repeat n in i:
        b := byte_at(ts, i)
        if b == 42:
            out = out + "_ptr"
        else b == 91:
            out = out + "_arr"
        else b == 60 or b == 44:
            out = out + "_"
        else b == 62 or b == 32 or b == 93:
            continue
        else:
            out = out + str.Substr(ts, i, 1)
        end
    end
    ret out
end

func g_subst(a &: at.Ast, nid: int, params: Vector<str>, args: Vector<int>):
    if nid == 0:
        ret
    end
    n := at.Get(a, nid)
    g_subst(a, n.ty, params, args)
    g_subst(a, n.a, params, args)
    g_subst(a, n.b, params, args)
    g_subst(a, n.c, params, args)
    g_subst(a, n.d, params, args)
    repeat n.list.len() in i:
        g_subst(a, n.list.get(i), params, args)
    end
    repeat n.dims.len() in i2:
        g_subst(a, n.dims.get(i2), params, args)
    end
    if n.kind == at.AST_TYPE and str.Len(n.name) > 0:
        repeat params.len() in pi:
            if not str.Equals(n.name, params.get(pi)):
                continue
            end
            ccid := at.Clone(a, args.get(pi))
            cc := at.Get(a, ccid)
            mut nv := at.Get(a, nid)
            cc_depth := cc.ptr_depth != 0 ? cc.ptr_depth : (cc.is_pointer ? 1 : 0)
            n_depth := nv.ptr_depth != 0 ? nv.ptr_depth : (nv.is_pointer ? 1 : 0)
            depth := n_depth + cc_depth
            nv.name = cc.name
            nv.list.free()
            nv.list = Vector {} as Vector<int>
            repeat cc.list.len() in k:
                nv.list.push(cc.list.get(k))
            end
            nv.ptr_depth = depth
            nv.is_pointer = depth > 0
            nv.elem_ptr_depth += cc.elem_ptr_depth
            nv.is_dyn = cc.is_dyn
            nv.ty = cc.ty
            nv.is_extern = cc.is_extern
            nv.is_variadic = cc.is_variadic
            if cc.is_slice:
                nv.is_slice = true
            end
            if n_depth == 0 and nv.dims.len() == 0 and nv.elem_ptr_depth == 0 and not nv.is_slice:
                nv.sema_type = cc.sema_type
            else cc_depth == 0 and cc.dims.len() == 0 and cc.elem_ptr_depth == 0:
                nv.sema_base_type = cc.sema_type
            end
            mut merged := Vector {} as Vector<int>
            repeat cc.dims.len() in k2:
                merged.push(cc.dims.get(k2))
            end
            repeat nv.dims.len() in k3:
                merged.push(nv.dims.get(k3))
            end
            nv.dims.free()
            nv.dims = merged
            at.Put(a, nid, nv)
            break
        end
    end
    if n.kind == at.AST_STRUCT_LIT and n.ty == 0 and n.list.len() == 0 and str.Len(n.name) > 0:
        repeat params.len() in pj:
            if str.Equals(n.name, params.get(pj)):
                mut lv := at.Get(a, nid)
                lv.ty = at.Clone(a, args.get(pj))
                lv.name = at.Get(a, lv.ty).name
                at.Put(a, nid, lv)
                break
            end
        end
    end
end

func zero_lit_into(a &: at.Ast, nid: int, op: int, v: tok.TokenValue, text: str, as_cast: bool):
    if as_cast:
        lit := new_node_at(a, at.AST_LITERAL, span_of(a, nid))
        at.SetOp(a, lit, op)
        at.SetTokenValue(a, lit, v)
        at.SetName(a, lit, text)
        mut cv := at.Get(a, nid)
        cv.kind = at.AST_CAST
        cv.a = lit
        cv.name = ""
        cv.synthetic = true
        at.Put(a, nid, cv)
        ret
    end
    mut lv := at.Get(a, nid)
    lv.kind = at.AST_LITERAL
    lv.ty = 0
    lv.name = text
    at.Put(a, nid, lv)
    at.SetOp(a, nid, op)
    at.SetTokenValue(a, nid, v)
end

func enum_ref_base(s &: Sema, a &: at.Ast, esym: int, sp: co.SrcSpan): int:
    nm := sym_at(s, esym).name
    if scope_lookup(s, s.cur, nm) == esym:
        base := new_node_at(a, at.AST_IDENTIFIER, sp)
        at.SetName(a, base, nm)
        ret base
    end
    mut sc := s.cur
    until sc != 0:
        scv := scope_at(s, sc)
        repeat scv.symbols.len() in i:
            pv := sym_at(s, scv.symbols.get(i))
            if pv.kind == SYM_PACKAGE and pv.members != 0 and scope_lookup_local(s, pv.members, nm) == esym:
                pid := new_node_at(a, at.AST_IDENTIFIER, sp)
                at.SetName(a, pid, pv.name)
                base := new_node_at(a, at.AST_MEMBER, sp)
                mut bv := at.Get(a, base)
                bv.a = pid
                bv.name = nm
                at.Put(a, base, bv)
                ret base
            end
        end
        sc = scv.parent
    end
    ret 0
end

func str_enum_zero(s &: Sema, a &: at.Ast, nid: int, tt: int): int:
    esym := ty_at(s, tt).decl
    if ty_at(s, tt).enum_val_kind != tok.TV_STRING or esym == 0 or sym_at(s, esym).members == 0:
        ret TYPE_NONE
    end
    sp := span_of(a, nid)
    msc := scope_at(s, sym_at(s, esym).members)
    repeat msc.symbols.len() in i:
        m := sym_at(s, msc.symbols.get(i))
        if m.kind != SYM_ENUM_MEMBER:
            continue
        end
        base := enum_ref_base(s, a, esym, sp)
        if base == 0:
            serr(
                s, 1, sp, co.Format1(
                    i18.Tr("enum '%s' is not visible here, so '{}' cannot name its first member; import its package"), co.ArgStr(type_disp(s, tt))
                )
            )
            ret sema_decorate(s, a, nid, sema_err_ty(s))
        end
        mut mv := at.Get(a, nid)
        mv.kind = at.AST_MEMBER
        mv.a = base
        mv.ty = 0
        mv.name = m.name
        mv.list = Vector {} as Vector<int>
        at.Put(a, nid, mv)
        ret sema_check_expr(s, a, nid)
    end
    ret TYPE_NONE
end

func check_type_param_zero(s &: Sema, a &: at.Ast, nid: int): int:
    tt := sema_resolve_type(s, a, at.Get(a, nid).ty)
    if tt < 0 or ty_at(s, tt).kind == TY_ERROR:
        ret sema_decorate(s, a, nid, sema_err_ty(s))
    end
    k := ty_at(s, tt).kind
    if k == TY_STRUCT:
        ssym := ty_at(s, tt).decl
        if ssym != 0 and sym_at(s, ssym).members != 0:
            sp := span_of(a, nid)
            msc := scope_at(s, sym_at(s, ssym).members)
            repeat msc.symbols.len() in fi:
                f := sym_at(s, msc.symbols.get(fi))
                if f.kind != SYM_FIELD or f.ty < 0:
                    continue
                end
                if f.decl != 0 and at.Get(a, f.decl).a != 0:
                    continue
                end
                if ty_at(s, f.ty).kind == TY_ARRAY:
                    continue
                end
                tnode := new_node_at(a, at.AST_TYPE, sp)
                mut tv := at.Get(a, tnode)
                tv.sema_type = f.ty
                tv.name = type_to_string(s, f.ty)
                at.Put(a, tnode, tv)
                zv := new_node_at(a, at.AST_STRUCT_LIT, sp)
                mut zvv := at.Get(a, zv)
                zvv.ty = tnode
                zvv.name = tv.name
                zvv.synthetic = true
                at.Put(a, zv, zvv)
                init := new_node_at(a, at.AST_FIELD_INIT, sp)
                at.SetName(a, init, f.name)
                mut iv := at.Get(a, init)
                iv.a = zv
                at.Put(a, init, iv)
                at.AddChild(a, nid, init)
            end
            mut sv := at.Get(a, nid)
            sv.name = ty_at(s, tt).name
            sv.synthetic = true
            at.Put(a, nid, sv)
            s.expected = TYPE_NONE
            ret finish_struct_lit(s, a, nid, ssym)
        end
        s.expected = tt
        ret TYPE_NONE
    end
    if k == TY_VEC or k == TY_MAP:
        inner := new_node_at(a, at.AST_STRUCT_LIT, span_of(a, nid))
        at.SetName(a, inner, k == TY_VEC ? "Vector" : "HashMap")
        mut cv := at.Get(a, nid)
        cv.kind = at.AST_CAST
        cv.a = inner
        cv.name = ""
        at.Put(a, nid, cv)
        ret sema_check_expr(s, a, nid)
    end
    if k == TY_ENUM:
        ez := str_enum_zero(s, a, nid, tt)
        if ez != TYPE_NONE:
            ret ez
        end
    end
    dist := type_distinct_sym(s, tt) != 0
    if k == TY_STR:
        zero_lit_into(a, nid, tok.TK_STRING, tok.ValueStr(""), `""`, dist)
    else k == TY_BOOL:
        zero_lit_into(a, nid, tok.TK_KW_FALSE, tok.ValueBool(false), "false", dist)
    else type_is_integer(s, tt) or k == TY_CHAR or k == TY_UCHAR or k == TY_ENUM:
        zero_lit_into(a, nid, tok.TK_INT, tok.ValueInt(0 as u64), "0", k != TY_I32 or dist)
    else type_is_float(s, tt):
        zero_lit_into(a, nid, tok.TK_FLOAT, tok.ValueFloat(0.0), "0.0", k != TY_F64 or dist)
    else k == TY_PTR or k == TY_FUNC:
        zero_lit_into(a, nid, tok.TK_KW_NULL, tok.ValueNone(), "null", true)
    else:
        serr(
            s, 1, span_of(a, nid), co.Format1(
                i18.Tr("type '%s' has no zero value to build with '{}'"), co.ArgStr(type_disp(s, tt))
            )
        )
        ret sema_decorate(s, a, nid, sema_err_ty(s))
    end
    ret sema_check_expr(s, a, nid)
end

func g_resolved_targs(a &: at.Ast, targ_nodes: Vector<int>, argtypes: Vector<int>): Vector<int>:
    mut out := Vector {} as Vector<int>
    repeat targ_nodes.len() in i:
        cid := at.Clone(a, targ_nodes.get(i))
        if i < argtypes.len() and argtypes.get(i) >= 0:
            mut cv := at.Get(a, cid)
            cv.sema_type = argtypes.get(i)
            at.Put(a, cid, cv)
        end
        out.push(cid)
    end
    ret out
end

func g_instance_name(s &: Sema, base: str, argtypes: Vector<int>): str:
    mut out := base
    repeat argtypes.len() in i:
        at_i := argtypes.get(i)
        tn := type_distinct_sym(s, at_i) != 0 ? ty_at(s, at_i).name : type_to_string(s, at_i)
        out = out + "_" + g_sanitize(tn)
    end
    ret out
end

func g_type_to_ast(s &: Sema, a &: at.Ast, t: int, sp: co.SrcSpan): int:
    nid := g_type_to_ast_bare(s, a, t, sp)
    if t >= 0:
        mut nv := at.Get(a, nid)
        nv.sema_type = t
        at.Put(a, nid, nv)
    end
    ret nid
end

func g_type_to_ast_bare(s &: Sema, a &: at.Ast, t: int, sp: co.SrcSpan): int:
    nid := new_node_at(a, at.AST_TYPE, sp)
    mut nv := at.Get(a, nid)
    nv.synthetic = true
    at.Put(a, nid, nv)
    if t < 0:
        at.SetName(a, nid, "void")
        ret nid
    end
    v := ty_at(s, t)
    if v.kind == TY_PTR and v.pointee >= 0:
        p := g_type_to_ast(s, a, v.pointee, sp)
        mut pv := at.Get(a, p)
        pv.ptr_depth += 1
        pv.is_pointer = true
        at.Put(a, p, pv)
        ret p
    end
    if v.kind == TY_VEC:
        at.SetName(a, nid, "Vector")
        at.AddChild(a, nid, g_type_to_ast(s, a, v.elem, sp))
        ret nid
    end
    if v.kind == TY_MAP:
        at.SetName(a, nid, "HashMap")
        at.AddChild(a, nid, g_type_to_ast(s, a, v.key, sp))
        at.AddChild(a, nid, g_type_to_ast(s, a, v.elem, sp))
        ret nid
    end
    at.SetName(a, nid, type_to_string(s, t))
    ret nid
end

func iface_satisfied(
    s &: Sema, _a &: at.Ast, concrete: int, iface_name: str, tparam: str, sp: co.SrcSpan
): bool:
    mut why := ""
    iface := sema_lookup_iface(s, _a, iface_name, sp, why)
    if iface == 0:
        if str.Len(why) > 0:
            serr(
                s, 1, sp, co.Format3(
                    i18.Tr("bound '%s' on type parameter '%s': %s"), co.ArgStr(iface_name), co.ArgStr(tparam), co.ArgStr(why)
                )
            )
        else:
            serr(
                s, 1, sp, co.Format2(
                    i18.Tr("bound '%s' on type parameter '%s' is not an interface"), co.ArgStr(iface_name), co.ArgStr(tparam)
                )
            )
        end
        ret false
    end
    mut members := 0
    mut impl_members := 0
    if concrete >= 0:
        owner := find_impl_owner(s, type_to_string(s, concrete))
        if owner != 0:
            impl_members = sym_at(s, owner).members
        end
    end
    if concrete >= 0 and ty_at(s, concrete).kind == TY_STRUCT and ty_at(s, concrete).decl != 0:
        members = sym_at(s, ty_at(s, concrete).decl).members
    else:
        members = impl_members
        impl_members = 0
    end
    if members == 0:
        serr(
            s, 2, sp, co.Format2(
                i18.Tr("'%s' does not satisfy '%s': no struct definition or `impl` block provides its methods"), co.ArgStr(type_disp(s, concrete)), co.ArgStr(iface_name)
            )
        )
        ret false
    end
    mut all_ok := true
    ifm := scope_at(s, sym_at(s, iface).members)
    repeat ifm.symbols.len() in i:
        im := sym_at(s, ifm.symbols.get(i))
        if im.kind != SYM_METHOD or im.overloads.len() == 0:
            continue
        end
        want := sig_at(s, im.overloads.get(0))
        mut smx := scope_lookup_local(s, members, im.name)
        mut have_m := smx != 0
        if have_m and sym_at(s, smx).kind != SYM_METHOD:
            have_m = false
        end
        if not have_m and impl_members != 0:
            smx = scope_lookup_local(s, impl_members, im.name)
            have_m = smx != 0
            if have_m and sym_at(s, smx).kind != SYM_METHOD:
                have_m = false
            end
        end
        if not have_m:
            serr(
                s, 2, sp, co.Format3(
                    i18.Tr("'%s' does not implement interface '%s': missing method '%s'"), co.ArgStr(type_disp(s, concrete)), co.ArgStr(iface_name), co.ArgStr(im.name)
                )
            )
            all_ok = false
            continue
        end
        smv := sym_at(s, smx)
        mut sig_ok := false
        repeat smv.overloads.len() in k:
            have := sig_at(s, smv.overloads.get(k))
            if have.params.len() != want.params.len():
                continue
            end
            mut pm := true
            repeat want.params.len() in p:
                if not type_equiv(s, have.params.get(p), want.params.get(p)):
                    pm = false
                    break
                end
            end
            if pm and type_equiv(s, have.ret_type, want.ret_type):
                sig_ok = true
                if have.decl != 0 and want.decl != 0 and at.Get(_a, have.decl).is_mut and not at.Get(_a, want.decl).is_mut:
                    serr(
                        s, 2, sp, co.Format3(
                            i18.Tr("'%s' implements '%s' as 'mut func', but interface '%s' declares it without 'mut'; add 'mut' to the interface method"), co.ArgStr(type_disp(s, concrete)), co.ArgStr(im.name), co.ArgStr(iface_name)
                        )
                    )
                    all_ok = false
                end
                break
            end
        end
        if not sig_ok:
            serr(
                s, 2, sp, co.Format3(
                    i18.Tr("'%s' implements method '%s' with a signature that does not match interface '%s'"), co.ArgStr(type_disp(s, concrete)), co.ArgStr(im.name), co.ArgStr(iface_name)
                )
            )
            all_ok = false
        end
    end
    ret all_ok
end

func g_check_bounds(
    s &: Sema, a &: at.Ast, tmpl: int, argtypes: Vector<int>, sp: co.SrcSpan
):
    repeat at.TyparamCount(a, tmpl) in i:
        if i >= argtypes.len():
            break
        end
        bound := at.TyparamBound(a, tmpl, i)
        if str.Len(bound) > 0:
            _ok := iface_satisfied(
                s, a, argtypes.get(i), bound, at.Typaram(a, tmpl, i), sp
            )
        end
    end
end

func coerce_to_dyn(
    s &: Sema, a &: at.Ast, expected: int, expr: int, etype: int
): int:
    if expected < 0 or ty_at(s, expected).kind != TY_DYN or expr == 0:
        ret expr
    end
    if etype < 0 or ty_at(s, etype).kind != TY_STRUCT:
        ret expr
    end
    ename := ty_at(s, expected).name
    _ok := iface_satisfied(s, a, etype, ename, ename, span_of(a, expr))
    box := new_node_at(a, at.AST_CAST, span_of(a, expr))
    mut bv := at.Get(a, box)
    bv.a = expr
    bv.synthetic = true
    bv.type_str = type_to_string(s, expected)
    at.Put(a, box, bv)
    ret box
end

func coerce_to_variant(
    s &: Sema, a &: at.Ast, variant: int, expr: int, tag: int
): int:
    box := new_node_at(a, at.AST_VARIANT_BOX, span_of(a, expr))
    mut bv := at.Get(a, box)
    bv.a = expr
    bv.synthetic = true
    bv.type_str = type_to_string(s, variant)
    bv.value_kind = tok.TV_INT
    bv.value_int = tag as u64
    at.Put(a, box, bv)
    ret box
end

func coerce_args_to_dyn(
    s &: Sema, a &: at.Ast, call: int, argtypes: Vector<int>, sigid: int
):
    if sigid == 0:
        ret
    end
    sg := sig_at(s, sigid)
    mut i := 0
    until i < at.ChildCount(a, call) and i < sg.params.len() and i < argtypes.len():
        pt := sg.params.get(i)
        if pt >= 0 and ty_at(s, pt).kind == TY_DYN:
            arg := at.Child(a, call, i)
            nb := coerce_to_dyn(s, a, pt, arg, argtypes.get(i))
            mut cn := at.Get(a, call)
            cn.list.set(i, nb)
            at.Put(a, call, cn)
        end
        i += 1
    end
end

func coerce_args_to_variant(
    s &: Sema, a &: at.Ast, call: int, argtypes: Vector<int>, sigid: int
):
    if sigid == 0:
        ret
    end
    sg := sig_at(s, sigid)
    mut i := 0
    until i < at.ChildCount(a, call) and i < sg.params.len() and i < argtypes.len():
        pt := sg.params.get(i)
        att := argtypes.get(i)
        if pt >= 0 and ty_at(s, pt).kind == TY_VARIANT and att >= 0 and ty_at(s, att).kind != TY_VARIANT:
            tag := type_variant_tag(s, pt, att)
            if tag >= 0:
                arg := at.Child(a, call, i)
                nb := coerce_to_variant(s, a, pt, arg, tag)
                mut cn := at.Get(a, call)
                cn.list.set(i, nb)
                at.Put(a, call, cn)
            end
        end
        i += 1
    end
end

func coerce_args_to_slice(
    s &: Sema, a &: at.Ast, call: int, argtypes: Vector<int>, sigid: int
):
    if sigid == 0:
        ret
    end
    sg := sig_at(s, sigid)
    mut i := 0
    until i < at.ChildCount(a, call) and i < sg.params.len() and i < argtypes.len():
        pt := sg.params.get(i)
        if array_fits_slice(s, pt, argtypes.get(i)) and not param_is_ref(s, a, sigid, i):
            arg := at.Child(a, call, i)
            sl := new_node_at(a, at.AST_SLICE, span_of(a, arg))
            mut sv := at.Get(a, sl)
            sv.a = arg
            sv.synthetic = true
            at.Put(a, sl, sv)
            _ds := sema_decorate(s, a, sl, pt)
            mut root := arg
            until root != 0 and (at.KindOf(a, root) == at.AST_MEMBER or at.KindOf(a, root) == at.AST_INDEX or at.KindOf(a, root) == at.AST_SLICE):
                root = at.Get(a, root).a
            end
            if root != 0 and at.KindOf(a, root) == at.AST_IDENTIFIER:
                rsym := scope_lookup(s, s.cur, at.Get(a, root).name)
                if rsym != 0:
                    mut rv := sym_at(s, rsym)
                    if rv.is_mut or rv.is_ref:
                        rv.mutated = true
                        sym_put(s, rsym, rv)
                    end
                end
            end
            mut cn := at.Get(a, call)
            cn.list.set(i, sl)
            at.Put(a, call, cn)
        end
        i += 1
    end
end

func g_instantiate_func(
    s &: Sema, a &: at.Ast, tmpl: int, targ_nodes: Vector<int>, sp: co.SrcSpan
): int:
    tn := at.Get(a, tmpl)
    if targ_nodes.len() != tn.typarams.len():
        serr(
            s, 1, sp, co.Format4(
                i18.Tr("generic '%s' expects %zu type argument%s, got %zu"), co.ArgStr(tn.name), co.ArgUint(tn.typarams.len() as u64), co.ArgStr(plural_suffix(tn.typarams.len())), co.ArgUint(targ_nodes.len() as u64)
            )
        )
        ret 0
    end
    mut argtypes := Vector {} as Vector<int>
    defer argtypes.free()
    repeat targ_nodes.len() in i:
        argtypes.push(g_check_targ(s, a, sema_resolve_type(s, a, targ_nodes.get(i)), sp))
    end
    iname := g_instance_name(s, tn.name, argtypes)
    existing := scope_lookup_local(s, s.global, iname)
    if existing != 0:
        ret existing
    end
    save_lang := s.lang
    if str.Len(tn.origin_lang) > 0:
        s.lang = tn.origin_lang
    end
    g_check_bounds(s, a, tmpl, argtypes, sp)
    inst := at.Clone(a, tmpl)
    mut iv := at.Get(a, inst)
    iv.name = iname
    iv.synthetic = true
    iv.home_pkg = derive_pkg_name_of(s, s.gen_pkg != 0 ? s.gen_pkg : s.global)
    at.Put(a, inst, iv)
    rargs := g_resolved_targs(a, targ_nodes, argtypes)
    g_subst(a, inst, tn.typarams, rargs)
    rargs.free()
    mut iv2 := at.Get(a, inst)
    iv2.typarams.clear()
    at.Put(a, inst, iv2)
    at.AddChild(a, s.program, inst)
    fsym := get_or_make_func(s, s.global, iname, SYM_FUNC)
    mut fv := sym_at(s, fsym)
    if fv.home == 0:
        fv.home = s.gen_pkg
    end
    sym_put(s, fsym, fv)
    fsig := build_sig(s, a, inst, 0)
    mut fv2 := sym_at(s, fsym)
    fv2.overloads.push(fsig)
    sym_put(s, fsym, fv2)
    s.pending.push(inst)
    s.lang = save_lang
    ret fsym
end

func g_unify(s &: Sema, a &: at.Ast, pty: int, att: int, tname: str): int:
    if pty == 0 or att < 0:
        ret TYPE_NONE
    end
    p := at.Get(a, pty)
    if str.Len(p.name) == 0:
        ret TYPE_NONE
    end
    pn := intrinsic_type_canon(p.name)
    v := ty_at(s, att)
    if str.Equals(p.name, tname) and p.dims.len() == 0:
        if p.is_slice:
            if v.kind == TY_SLICE or v.kind == TY_ARRAY:
                ret v.elem
            end
            ret TYPE_NONE
        end
        if p.is_pointer:
            if v.kind == TY_PTR:
                ret v.pointee
            end
            ret TYPE_NONE
        end
        ret att
    end
    if str.Equals(pn, "Vector") and v.kind == TY_VEC and p.list.len() >= 1:
        ret g_unify(s, a, p.list.get(0), v.elem, tname)
    end
    if str.Equals(pn, "HashMap") and v.kind == TY_MAP:
        mut u := TYPE_NONE
        if p.list.len() >= 1:
            u = g_unify(s, a, p.list.get(0), v.key, tname)
        end
        if u < 0 and p.list.len() >= 2:
            u = g_unify(s, a, p.list.get(1), v.elem, tname)
        end
        ret u
    end
    if p.list.len() > 0 and v.kind == TY_VARIANT and enum_data_sym(s, att) != 0:
        esn := sym_at(s, enum_data_sym(s, att)).name
        mut pbase := p.name
        pdot := str.IndexOf(pbase, ".")
        if pdot >= 0:
            pbase = str.Substr(pbase, pdot + 1, str.Len(pbase) - pdot - 1)
        end
        cs0 := enum_case_struct(s, att, 0)
        if str.Equals(pbase, esn) and cs0 != 0:
            eargs := sym_at(s, cs0).generic_args
            mut k2 := p.list.len()
            if eargs.len() < k2:
                k2 = eargs.len()
            end
            repeat k2 in i2:
                u3 := g_unify(s, a, p.list.get(i2), eargs.get(i2), tname)
                if u3 >= 0:
                    ret u3
                end
            end
        end
    end
    if p.list.len() > 0 and v.kind == TY_STRUCT and v.decl != 0:
        isym := sym_at(s, v.decl)
        if str.Len(isym.generic_base) > 0 and (str.Equals(isym.generic_base, p.name) or str.Equals(isym.generic_base, pn)):
            mut k := p.list.len()
            if isym.generic_args.len() < k:
                k = isym.generic_args.len()
            end
            repeat k in i:
                u2 := g_unify(
                    s, a, p.list.get(i), isym.generic_args.get(i), tname
                )
                if u2 >= 0:
                    ret u2
                end
            end
        end
    end
    ret TYPE_NONE
end

func g_localize_instance(s &: Sema, a &: at.Ast, t: int, sp: co.SrcSpan): int:
    if t < 0 or ty_at(s, t).kind != TY_STRUCT or ty_at(s, t).decl == 0:
        ret t
    end
    isym := sym_at(s, ty_at(s, t).decl)
    if str.Len(isym.generic_base) == 0 or str.Len(isym.name) == 0:
        ret t
    end
    if scope_lookup_local(s, s.global, isym.name) != 0:
        ret t
    end
    tnid := new_node_at(a, at.AST_TYPE, sp)
    mut tv := at.Get(a, tnid)
    tv.name = isym.generic_base
    tv.synthetic = true
    at.Put(a, tnid, tv)
    repeat isym.generic_args.len() in i:
        at.AddChild(a, tnid, g_type_to_ast(s, a, isym.generic_args.get(i), sp))
    end
    lt_at := sema_resolve_type(s, a, tnid)
    if lt_at >= 0 and ty_at(s, lt_at).kind == TY_STRUCT:
        ret lt_at
    end
    ret t
end

func g_infer_call(
    s &: Sema, a &: at.Ast, tsym: int, argtypes: Vector<int>, sp: co.SrcSpan, expected: int
): int:
    tmpl := sym_at(s, tsym).decl
    tv := at.Get(a, tmpl)
    mut required := 0
    mut total := 0
    mut seen_default := false
    repeat tv.list.len() in i:
        param := at.Get(a, tv.list.get(i))
        if param.kind != at.AST_PARAM:
            continue
        end
        total += 1
        if param.a != 0:
            seen_default = true
        else not seen_default:
            required += 1
        end
    end
    if argtypes.len() < required or (not tv.is_variadic and argtypes.len() > total):
        tname := sym_at(s, tsym).name
        if tv.is_variadic:
            serr(
                s, 12, sp, co.Format4(
                    i18.Tr("'%s' expects at least %zu argument%s, got %zu"), co.ArgStr(tname), co.ArgUint(required as u64), co.ArgStr(plural_suffix(required)), co.ArgUint(argtypes.len() as u64)
                )
            )
        else required == total:
            serr(
                s, 12, sp, co.Format4(
                    i18.Tr("'%s' expects %zu argument%s, got %zu"), co.ArgStr(tname), co.ArgUint(total as u64), co.ArgStr(plural_suffix(total)), co.ArgUint(argtypes.len() as u64)
                )
            )
        else:
            serr(
                s, 12, sp, co.Format4(
                    i18.Tr("'%s' expects %zu to %zu arguments, got %zu"), co.ArgStr(tname), co.ArgUint(required as u64), co.ArgUint(total as u64), co.ArgUint(argtypes.len() as u64)
                )
            )
        end
        ret 0
    end
    mut targ_nodes := Vector {} as Vector<int>
    repeat tv.typarams.len() in t:
        tpn := tv.typarams.get(t)
        mut bound := TYPE_NONE
        mut pi := 0
        until pi < tv.list.len() and pi < argtypes.len():
            p := at.Get(a, tv.list.get(pi))
            if p.kind == at.AST_PARAM:
                u := g_unify(s, a, p.ty, argtypes.get(pi), tpn)
                if u >= 0:
                    bound = u
                    break
                end
            end
            pi += 1
        end
        if bound < 0 and expected >= 0 and tv.ty != 0:
            bound = g_unify(s, a, tv.ty, expected, tpn)
        end
        if bound < 0:
            mut pi2 := argtypes.len()
            until pi2 < tv.list.len():
                p2 := at.Get(a, tv.list.get(pi2))
                if p2.kind == at.AST_PARAM and p2.a != 0 and p2.ty != 0 and str.Equals(at.Get(a, p2.ty).name, tpn):
                    bound = sema_check_expr(s, a, p2.a)
                    if bound >= 0:
                        break
                    end
                end
                pi2 += 1
            end
        end
        if bound < 0:
            serr(
                s, 1, sp, co.Format2(
                    i18.Tr("cannot infer type parameter '%s' of generic function '%s'"), co.ArgStr(tpn), co.ArgStr(tv.name)
                )
            )
            targ_nodes.free()
            ret 0
        end
        targ_nodes.push(g_type_to_ast(s, a, bound, sp))
    end
    g_result := g_instantiate_func(s, a, tmpl, targ_nodes, sp)
    targ_nodes.free()
    ret g_result
end

func g_check_targ(s &: Sema, _a &: at.Ast, t: int, sp: co.SrcSpan): int:
    if t >= 0 and ty_at(s, t).kind == TY_ARRAY:
        serr(
            s, 98, sp, co.Format1(
                i18.Tr("a fixed array ('%s') cannot be a type argument; wrap it in a struct or use a slice"), co.ArgStr(type_disp(s, t))
            )
        )
        ret sema_err_ty(s)
    end
    ret t
end
