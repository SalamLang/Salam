package semantic

import str

include co "../sal_core.salam"
include tok "../token.salam"
include at "../ast.salam"
include i18 "../i18n.salam"
include lg "../logger.salam"
include lp "../langpack.salam"
include src "../source.salam"

pub const IFCHAIN_CODE := 145

mut g_ic_seen := HashMap {} as HashMap<str, bool>
mut g_ic_lib := HashMap {} as HashMap<str, bool>

struct IcSeq:
    pub stmt: Vector<int> = Vector {}
    pub cond: Vector<int> = Vector {}
    pub body: Vector<int> = Vector {}
    pub ok: Vector<bool> = Vector {}
    pub key: Vector<str> = Vector {}
    pub subj: Vector<int> = Vector {}
    pub lab_from: Vector<int> = Vector {}
    pub lab_to: Vector<int> = Vector {}
    pub first_of_stmt: Vector<bool> = Vector {}
    pub last_of_stmt: Vector<bool> = Vector {}
    pub tail_else: Vector<int> = Vector {}
    pub labels: Vector<int> = Vector {}
end

func ic_free(q &: IcSeq):
    q.stmt.free()
    q.cond.free()
    q.body.free()
    q.ok.free()
    q.key.free()
    q.subj.free()
    q.lab_from.free()
    q.lab_to.free()
    q.first_of_stmt.free()
    q.last_of_stmt.free()
    q.tail_else.free()
    q.labels.free()
end

func ic_clear(q &: IcSeq):
    q.stmt.clear()
    q.cond.clear()
    q.body.clear()
    q.ok.clear()
    q.key.clear()
    q.subj.clear()
    q.lab_from.clear()
    q.lab_to.clear()
    q.first_of_stmt.clear()
    q.last_of_stmt.clear()
    q.tail_else.clear()
    q.labels.clear()
end

func ic_library_file(file: str): bool:
    if g_ic_lib.has(file):
        ret g_ic_lib.get(file)
    end
    root := get_stdlib_root()
    mut lib := false
    if str.Len(root) > 0:
        lib = str.StartsWith(file, root + "/std/")
    else:
        lib = str.StartsWith(file, "std/")
    end
    g_ic_lib.put(file, lib)
    ret lib
end

func ic_type_ok(ts: str): bool:
    switch ts:
        "i8", "i16", "i32", "i64", "u8", "u16", "u32", "u64", "usize", "size", "char", "uchar", "str":
            ret true
        end
    end
    ret false
end

func ic_const_sym(s &: Sema, a &: at.Ast, nid: int): int:
    n := at.Get(a, nid)
    if n.kind == at.AST_IDENTIFIER:
        sid := scope_lookup(s, s.cur, n.name)
        if sid != 0 and sym_at(s, sid).kind == SYM_CONST and not sym_at(s, sid).is_mut:
            ret sid
        end
        ret 0
    end
    if n.kind == at.AST_MEMBER and n.a != 0 and at.KindOf(a, n.a) == at.AST_IDENTIFIER:
        pk := scope_lookup(s, s.cur, at.Get(a, n.a).name)
        if pk != 0 and sym_at(s, pk).kind == SYM_PACKAGE:
            m := scope_lookup_local(s, sym_at(s, pk).members, n.name)
            if m != 0 and sym_at(s, m).kind == SYM_CONST and not sym_at(s, m).is_mut:
                ret m
            end
        end
    end
    ret 0
end

func ic_label_id(s &: Sema, a &: at.Ast, nid: int): str:
    n := at.Get(a, nid)
    mut lit := nid
    mut sid := 0
    if n.kind != at.AST_LITERAL:
        sid = ic_const_sym(s, a, nid)
        if sid == 0:
            ret ""
        end
        lit = const_ref_node(s, a, nid)
        if lit == 0 or at.KindOf(a, lit) != at.AST_LITERAL:
            ret "k" + sid
        end
    end
    ln := at.Get(a, lit)
    if ln.op == tok.TK_STRING or ln.op == tok.TK_RAW_STRING or ln.op == tok.TK_TRIPLE_STRING:
        ret "s" + ln.value_str
    end
    if ln.op == tok.TK_INT or ln.op == tok.TK_CHAR or ln.op == tok.TK_UTF8_CHAR:
        ret "i" + ln.value_int
    end
    ret ""
end

func ic_const_ok(s &: Sema, a &: at.Ast, nid: int): bool:
    n := at.Get(a, nid)
    if not ic_type_ok(n.type_str):
        ret false
    end
    if n.kind == at.AST_LITERAL:
        ret n.op == tok.TK_INT or n.op == tok.TK_CHAR or n.op == tok.TK_UTF8_CHAR or n.op == tok.TK_STRING or n.op == tok.TK_RAW_STRING or n.op == tok.TK_TRIPLE_STRING
    end
    ret ic_const_sym(s, a, nid) != 0
end

func ic_arith_op(op: int): bool:
    switch op:
        tok.TK_PLUS, tok.TK_MINUS, tok.TK_STAR, tok.TK_SLASH, tok.TK_PERCENT, tok.TK_AMP, tok.TK_PIPE, tok.TK_CARET:
            ret true
        end
    end
    ret false
end

func ic_key(s &: Sema, a &: at.Ast, nid: int): str:
    if nid == 0:
        ret ""
    end
    n := at.Get(a, nid)
    if n.kind == at.AST_IDENTIFIER:
        sid := scope_lookup(s, s.cur, n.name)
        if sid == 0 or sym_at(s, sid).kind == SYM_CONST:
            ret ""
        end
        ret "v" + sid
    end
    if n.kind == at.AST_THIS:
        ret "this"
    end
    if n.kind == at.AST_LITERAL:
        if n.op == tok.TK_INT or n.op == tok.TK_CHAR or n.op == tok.TK_UTF8_CHAR:
            ret "#" + n.value_int
        end
        ret ""
    end
    if n.kind == at.AST_MEMBER:
        ka := ic_key(s, a, n.a)
        if str.Len(ka) == 0:
            ret ""
        end
        ret ka + "." + n.name
    end
    if n.kind == at.AST_INDEX:
        ka := ic_key(s, a, n.a)
        kb := ic_key(s, a, n.b)
        if str.Len(ka) == 0 or str.Len(kb) == 0:
            ret ""
        end
        ret ka + "[" + kb + "]"
    end
    if n.kind == at.AST_CAST:
        ka := ic_key(s, a, n.a)
        if str.Len(ka) == 0 or str.Len(n.type_str) == 0:
            ret ""
        end
        ret "(" + ka + " as " + n.type_str + ")"
    end
    if n.kind == at.AST_BINARY and ic_arith_op(n.op):
        ka := ic_key(s, a, n.a)
        kb := ic_key(s, a, n.b)
        if str.Len(ka) == 0 or str.Len(kb) == 0:
            ret ""
        end
        ret "(" + ka + " " + n.op + " " + kb + ")"
    end
    if n.kind == at.AST_UNARY and (n.op == tok.TK_MINUS or n.op == tok.TK_TILDE):
        ka := ic_key(s, a, n.a)
        if str.Len(ka) == 0:
            ret ""
        end
        ret "(u" + n.op + " " + ka + ")"
    end
    ret ""
end

func ic_subject_ok(a &: at.Ast, nid: int): bool:
    n := at.Get(a, nid)
    if n.kind == at.AST_LITERAL:
        ret false
    end
    ret ic_type_ok(n.type_str)
end

func ic_eq_atom(s &: Sema, a &: at.Ast, q &: IcSeq, subj: int, cst: int, cur_key &: str, cur_subj &: int): bool:
    if not ic_subject_ok(a, subj) or not ic_const_ok(s, a, cst):
        ret false
    end
    k := ic_key(s, a, subj)
    if str.Len(k) == 0:
        ret false
    end
    if str.Len(cur_key) == 0:
        cur_key = k
        cur_subj = subj
    else not str.Equals(cur_key, k):
        ret false
    end
    q.labels.push(cst)
    ret true
end

func ic_atoms(s &: Sema, a &: at.Ast, q &: IcSeq, nid: int, cur_key &: str, cur_subj &: int): bool:
    n := at.Get(a, nid)
    if n.kind != at.AST_BINARY:
        ret false
    end
    if n.op == tok.TK_OR:
        ret ic_atoms(s, a, q, n.a, cur_key, cur_subj) and ic_atoms(s, a, q, n.b, cur_key, cur_subj)
    end
    if n.op != tok.TK_EQ:
        ret false
    end
    mark := q.labels.len()
    if ic_eq_atom(s, a, q, n.a, n.b, cur_key, cur_subj):
        ret true
    end
    if ic_eq_atom(s, a, q, n.b, n.a, cur_key, cur_subj):
        ret true
    end
    until q.labels.len() > mark:
        q.labels.pop()
    end
    ret false
end

func ic_add_link(s &: Sema, a &: at.Ast, q &: IcSeq, stmt: int, cond: int, body: int, first: bool):
    q.stmt.push(stmt)
    q.cond.push(cond)
    q.body.push(body)
    q.first_of_stmt.push(first)
    q.last_of_stmt.push(false)
    q.tail_else.push(0)
    lo := q.labels.len()
    mut key := ""
    mut subj := 0
    good := ic_atoms(s, a, q, cond, key, subj)
    if not good:
        until q.labels.len() > lo:
            q.labels.pop()
        end
        key = ""
        subj = 0
    end
    q.ok.push(good)
    q.key.push(key)
    q.subj.push(subj)
    q.lab_from.push(lo)
    q.lab_to.push(q.labels.len())
end

func ic_break_escapes(a &: at.Ast, nid: int, depth: int): bool:
    if nid == 0:
        ret false
    end
    n := at.Get(a, nid)
    if n.kind == at.AST_BREAK:
        ret at.BreakLevels(a, nid) > depth
    end
    if n.kind == at.AST_FUNC_DEF or n.kind == at.AST_LAMBDA:
        ret false
    end
    mut d := depth
    if n.kind == at.AST_UNTIL or n.kind == at.AST_FOR or n.kind == at.AST_REPEAT or n.kind == at.AST_EACH or n.kind == at.AST_SWITCH:
        d = depth + 1
    end
    if ic_break_escapes(a, n.a, d) or ic_break_escapes(a, n.b, d) or ic_break_escapes(a, n.c, d) or ic_break_escapes(a, n.d, d):
        ret true
    end
    repeat n.list.len() in i:
        if ic_break_escapes(a, n.list.get(i), d):
            ret true
        end
    end
    ret false
end

func ic_all_ws(text: str, b: int, e: int): bool:
    mut i := b
    until i < e:
        c := byte_at(text, i)
        if c != 32 and c != 9 and c != 10 and c != 13:
            ret false
        end
        i += 1
    end
    ret true
end

func ic_has_comment(text: str, b: int, e: int): bool:
    if e <= b:
        ret false
    end
    piece := str.Substr(text, b, e - b)
    ret str.Contains(piece, "//") or str.Contains(piece, "/*")
end

func ic_line_start(text: str, pos: int): int:
    mut p := pos
    until p > 0 and byte_at(text, p - 1) != 10:
        p -= 1
    end
    ret p
end

func ic_trim_end(text: str, b: int, e: int): int:
    mut p := e
    until p > b and (byte_at(text, p - 1) == 32 or byte_at(text, p - 1) == 9 or byte_at(text, p - 1) == 10 or byte_at(text, p - 1) == 13):
        p -= 1
    end
    ret p
end

func ic_indent_body(piece: str, lead: str, unit: str): str:
    mut out := lead
    mut pos := 0
    n := str.Len(piece)
    mut first := true
    until pos <= n:
        nl := str.IndexFrom(piece, "\n", pos)
        mut line_end := nl
        if nl < 0:
            line_end = n
        end
        mut line := str.Substr(piece, pos, line_end - pos)
        if str.EndsWith(line, "\r"):
            line = str.Substr(line, 0, str.Len(line) - 1)
        end
        if first:
            out = out + line
            first = false
        else str.Len(line) > 0:
            out = out + "\n" + unit + line
        else:
            out = out + "\n"
        end
        if nl < 0:
            break
        end
        pos = nl + 1
    end
    ret out
end

func ic_body_range(a &: at.Ast, text: str, body: int, rb &: int, re &: int): bool:
    cnt := at.ChildCount(a, body)
    if cnt == 0:
        ret false
    end
    fn := at.Get(a, at.Child(a, body, 0))
    ln := at.Get(a, at.Child(a, body, cnt - 1))
    rb = fn.begin_index as int
    re = ic_trim_end(text, rb, ln.end_index as int)
    ret rb < re and re <= str.Len(text)
end

func ic_balanced_end(text: str, b: int, e0: int): int:
    n := str.Len(text)
    mut depth := 0
    mut i := b
    until i < e0:
        c := byte_at(text, i)
        if c == 34 or c == 39:
            i += 1
            until i < e0 and byte_at(text, i) != c:
                if byte_at(text, i) == 92:
                    i += 1
                end
                i += 1
            end
        else c == 40 or c == 91:
            depth += 1
        else c == 41 or c == 93:
            depth -= 1
            if depth < 0:
                ret 0 - 1
            end
        end
        i += 1
    end
    mut e := e0
    until depth > 0:
        if e >= n:
            ret 0 - 1
        end
        c2 := byte_at(text, e)
        if c2 == 41 or c2 == 93:
            depth -= 1
            e += 1
        else c2 == 32 or c2 == 9:
            e += 1
        else:
            ret 0 - 1
        end
    end
    ret e
end

func ic_expr_text(a &: at.Ast, text: str, nid: int, out &: str): bool:
    n := at.Get(a, nid)
    b := n.begin_index as int
    e := n.end_index as int
    if b < 0 or e <= b or e > str.Len(text):
        ret false
    end
    fixed := ic_balanced_end(text, b, e)
    if fixed < 0:
        ret false
    end
    out = str.Substr(text, b, fixed - b)
    ret true
end

func ic_if_start(text: str, at_cond: int, kw_if: str): int:
    mut p := at_cond
    until p > 0 and (byte_at(text, p - 1) == 32 or byte_at(text, p - 1) == 9):
        p -= 1
    end
    k := str.Len(kw_if)
    if p < k or not str.Equals(str.Substr(text, p - k, k), kw_if):
        ret 0 - 1
    end
    ret p - k
end

func ic_try_fix(s &: Sema, a &: at.Ast, q &: IcSeq, i: int, j: int, f &: lg.Fix): bool:
    if not q.first_of_stmt.get(i) or not q.last_of_stmt.get(j - 1):
        ret false
    end
    text := src.Peek(s.file)
    tn := str.Len(text)
    if tn == 0:
        ret false
    end
    kw_if := kw_spell(s, s.file, tok.TK_KW_IF)
    run_b := ic_if_start(text, at.Get(a, q.stmt.get(i)).begin_index as int, kw_if)
    if run_b < 0:
        ret false
    end
    last_stmt := q.stmt.get(j - 1)
    run_e := ic_trim_end(text, run_b, at.Get(a, last_stmt).end_index as int)
    if run_b < 0 or run_e > tn or run_b >= run_e:
        ret false
    end
    ls := ic_line_start(text, run_b)
    if not ic_all_ws(text, ls, run_b):
        ret false
    end
    lead := str.Substr(text, ls, run_b - ls)
    subj := q.subj.get(i)
    sn := at.Get(a, subj)
    mut subj_text := ""
    if not ic_expr_text(a, text, subj, subj_text):
        ret false
    end
    if sn.kind == at.AST_BINARY or sn.kind == at.AST_CAST or sn.kind == at.AST_UNARY:
        subj_text = "(" + subj_text + ")"
    end
    mut unit := "    "
    if str.IndexOf(lead, "\t") >= 0:
        unit = "\t"
    end
    pack := FilePack(s, s.file)
    fa := pack == lp.LP_FA
    kw_switch := kw_spell(s, s.file, tok.TK_KW_SWITCH)
    kw_end := kw_spell(s, s.file, tok.TK_KW_END)
    kw_else := kw_spell(s, s.file, tok.TK_KW_ELSE)
    kw_break := kw_spell(s, s.file, tok.TK_KW_BREAK)
    comma := fa ? "\xD8\x8C " : ", "
    mut out := kw_switch + " " + subj_text + ":"
    mut cursor := run_b
    mut k := i
    until k < j:
        body := q.body.get(k)
        mut rb := 0
        mut re := 0
        if not ic_body_range(a, text, body, rb, re):
            ret false
        end
        if rb < cursor or ic_break_escapes(a, body, 0):
            ret false
        end
        piece := str.Substr(text, rb, re - rb)
        if str.Contains(piece, "\"\"\"") or str.Contains(piece, "`"):
            ret false
        end
        if ic_has_comment(text, cursor, rb):
            ret false
        end
        ln0 := ic_line_start(text, rb)
        if ln0 <= ic_line_start(text, at.Get(a, q.cond.get(k)).begin_index as int) or not ic_all_ws(text, ln0, rb):
            ret false
        end
        mut labels := ""
        mut li := q.lab_from.get(k)
        until li < q.lab_to.get(k):
            mut ltxt := ""
            if not ic_expr_text(a, text, q.labels.get(li), ltxt):
                ret false
            end
            if str.Len(labels) > 0:
                labels = labels + comma
            end
            labels = labels + ltxt
            li += 1
        end
        out = out + "\n" + lead + unit + labels + ":\n" + ic_indent_body(piece, lead + unit + unit, unit)
        last_arm := k == j - 1 and q.tail_else.get(k) == 0
        if not sema_stmt_terminates(s, a, body) and not last_arm:
            out = out + "\n" + lead + unit + unit + kw_break
        end
        out = out + "\n" + lead + unit + kw_end
        cursor = re
        k += 1
    end
    tail := q.tail_else.get(j - 1)
    if tail != 0:
        mut rb2 := 0
        mut re2 := 0
        if not ic_body_range(a, text, tail, rb2, re2):
            ret false
        end
        if rb2 < cursor or ic_break_escapes(a, tail, 0):
            ret false
        end
        piece2 := str.Substr(text, rb2, re2 - rb2)
        if str.Contains(piece2, "\"\"\"") or str.Contains(piece2, "`"):
            ret false
        end
        if ic_has_comment(text, cursor, rb2):
            ret false
        end
        ln1 := ic_line_start(text, rb2)
        if ln1 <= ic_line_start(text, cursor) or not ic_all_ws(text, ln1, rb2):
            ret false
        end
        out = out + "\n" + lead + unit + kw_else + ":\n" + ic_indent_body(piece2, lead + unit + unit, unit) + "\n" + lead + unit + kw_end
        cursor = re2
    end
    if ic_has_comment(text, cursor, run_e):
        ret false
    end
    out = out + "\n" + lead + kw_end
    f.index = run_b
    f.length = run_e - run_b
    f.text = out
    f.title = co.Format1(i18.Tr("Rewrite as a '%s' statement"), co.ArgStr(kw_switch))
    f.mode = lg.FIX_RANGE
    f.preferred = false
    f.safe = false
    ret true
end

func ic_labels_distinct(s &: Sema, a &: at.Ast, q &: IcSeq, i: int, j: int): bool:
    mut seen := HashMap {} as HashMap<str, bool>
    defer seen.free()
    mut k := i
    until k < j:
        mut li := q.lab_from.get(k)
        until li < q.lab_to.get(k):
            id := ic_label_id(s, a, q.labels.get(li))
            if str.Len(id) == 0:
                ret false
            end
            if seen.has(id):
                ret false
            end
            seen.put(id, true)
            li += 1
        end
        k += 1
    end
    ret true
end

func ic_subject_text(a &: at.Ast, nid: int): str:
    n := at.Get(a, nid)
    if n.kind == at.AST_IDENTIFIER:
        ret n.name
    end
    if n.kind == at.AST_THIS:
        ret "this"
    end
    if n.kind == at.AST_MEMBER:
        ret ic_subject_text(a, n.a) + "." + n.name
    end
    if n.kind == at.AST_INDEX:
        ret ic_subject_text(a, n.a) + "[" + ic_subject_text(a, n.b) + "]"
    end
    if n.kind == at.AST_LITERAL:
        ret n.name
    end
    if n.kind == at.AST_CAST:
        ret ic_subject_text(a, n.a) + " as " + n.type_str
    end
    ret "..."
end

func ic_report(s &: Sema, a &: at.Ast, q &: IcSeq, i: int, j: int, stop: int):
    first := at.Get(a, q.cond.get(i))
    seen_key := s.file + ":" + first.begin_index
    if g_ic_seen.has(seen_key):
        ret
    end
    g_ic_seen.put(seen_key, true)
    mut sp := span_of(a, q.cond.get(i))
    if first.end_index > first.begin_index:
        sp.length = first.end_index - first.begin_index
    end
    subj := ic_subject_text(a, q.subj.get(i))
    kw_switch := kw_spell(s, s.file, tok.TK_KW_SWITCH)
    mut help := co.Format2(
        i18.Tr("group them as '%s %s:' with one label per constant"), co.ArgStr(kw_switch), co.ArgStr(subj)
    )
    if stop >= 0:
        help = help + ". " + co.Format2(
            i18.Tr("The run stops at line %d because that test is not a plain comparison of '%s'."), co.ArgInt(at.Get(a, q.cond.get(stop)).begin_line as i64), co.ArgStr(subj)
        )
    end
    mut fx := fix_at(sp)
    if ic_labels_distinct(s, a, q, i, j) and ic_try_fix(s, a, q, i, j, fx):
        fx.rec = 0
        fx.safe = g_sm_ifchain == 3
        fx.preferred = g_sm_ifchain == 3
        queue_fix(fx)
    end
    msg := co.Format2(
        i18.Tr("%d consecutive comparisons of '%s' against constants could be a switch"), co.ArgInt((j - i) as i64), co.ArgStr(subj)
    )
    if g_sm_ifchain == 2:
        serr_help(s, IFCHAIN_CODE, sp, msg, help)
    else:
        swarn_help(s, IFCHAIN_CODE, sp, msg, help)
    end
end

func ic_flush(s &: Sema, a &: at.Ast, q &: IcSeq):
    n := q.stmt.len()
    mut i := 0
    until i < n:
        if not q.ok.get(i):
            i += 1
            continue
        end
        mut j := i + 1
        until j < n and q.ok.get(j) and str.Equals(q.key.get(j), q.key.get(i)):
            j += 1
        end
        if j - i >= g_sm_ifchain_min:
            mut stop := 0 - 1
            if j < n:
                stop = j
            end
            ic_report(s, a, q, i, j, stop)
        end
        i = j
    end
    ic_clear(q)
end

func ic_unroll(s &: Sema, a &: at.Ast, q &: IcSeq, st: int): bool:
    mut cur := st
    mut first := true
    mut all_term := true
    mut guard := 0
    until cur != 0 and guard < 100000:
        n := at.Get(a, cur)
        ic_add_link(s, a, q, st, n.a, n.b, first)
        first = false
        if not sema_stmt_terminates(s, a, n.b):
            all_term = false
        end
        nxt := n.c
        if nxt != 0 and at.KindOf(a, nxt) == at.AST_IF:
            cur = nxt
        else:
            last := q.stmt.len() - 1
            q.last_of_stmt.set(last, true)
            if nxt != 0:
                q.tail_else.set(last, nxt)
                all_term = false
            end
            cur = 0
        end
        guard += 1
    end
    ret all_term
end

pub func SemaIfChainReset():
    g_ic_seen.free()
    g_ic_seen = HashMap {} as HashMap<str, bool>
end

pub func SemaCheckIfChains(s &: Sema, a &: at.Ast, block: int):
    if g_sm_ifchain == 0 or s.requal or s.in_derive or ic_library_file(s.file):
        ret
    end
    cnt := at.ChildCount(a, block)
    if cnt == 0:
        ret
    end
    mut q := IcSeq {}
    defer ic_free(q)
    repeat cnt in i:
        st := at.Child(a, block, i)
        if at.KindOf(a, st) != at.AST_IF or at.Get(a, st).synthetic:
            ic_flush(s, a, q)
            continue
        end
        exclusive := ic_unroll(s, a, q, st)
        if not exclusive:
            ic_flush(s, a, q)
        end
    end
    ic_flush(s, a, q)
end
