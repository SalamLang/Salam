package semantic

import str

include co "../sal_core.salam"
include tok "../token.salam"
include at "../ast.salam"
include i18 "../i18n.salam"
include lg "../logger.salam"

pub const IFCHAIN_CODE := 145

const IC_EQ := 0
const IC_RANGE := 0 - 1

mut g_ic_seen := HashMap {} as HashMap<str, bool>
mut g_ic_lib := HashMap {} as HashMap<str, bool>

struct IcSeq:
    pub stmt: Vector<int> = Vector {}
    pub cond: Vector<int> = Vector {}
    pub body: Vector<int> = Vector {}
    pub ok: Vector<bool> = Vector {}
    pub key: Vector<str> = Vector {}
    pub subj: Vector<int> = Vector {}
    pub lab_from: Vector<int> = Vector {}
    pub lab_to: Vector<int> = Vector {}
    pub first_of_stmt: Vector<bool> = Vector {}
    pub last_of_stmt: Vector<bool> = Vector {}
    pub tail_else: Vector<int> = Vector {}
    pub labels: Vector<int> = Vector {}
    pub lab_kind: Vector<int> = Vector {}
    pub lab_hi: Vector<int> = Vector {}
end

struct IcAtom:
    pub ok: bool = false
    pub key: str = ""
    pub subj: int = 0
    pub kind: int = 0
    pub cst: int = 0
end

func ic_free(q &: IcSeq):
    q.stmt.free()
    q.cond.free()
    q.body.free()
    q.ok.free()
    q.key.free()
    q.subj.free()
    q.lab_from.free()
    q.lab_to.free()
    q.first_of_stmt.free()
    q.last_of_stmt.free()
    q.tail_else.free()
    q.labels.free()
    q.lab_kind.free()
    q.lab_hi.free()
end

func ic_clear(q &: IcSeq):
    q.stmt.clear()
    q.cond.clear()
    q.body.clear()
    q.ok.clear()
    q.key.clear()
    q.subj.clear()
    q.lab_from.clear()
    q.lab_to.clear()
    q.first_of_stmt.clear()
    q.last_of_stmt.clear()
    q.tail_else.clear()
    q.labels.clear()
    q.lab_kind.clear()
    q.lab_hi.clear()
end

func ic_labels_truncate(q &: IcSeq, n: int):
    until q.labels.len() > n:
        q.labels.pop()
        q.lab_kind.pop()
        q.lab_hi.pop()
    end
end

func ic_library_file(file: str): bool:
    if g_ic_lib.has(file):
        ret g_ic_lib.get(file)
    end
    root := get_stdlib_root()
    mut lib := false
    if str.Len(root) > 0:
        lib = str.StartsWith(file, root + "/std/")
    else:
        lib = str.StartsWith(file, "std/")
    end
    g_ic_lib.put(file, lib)
    ret lib
end

func ic_int_type(ts: str): bool:
    switch ts:
        "i8", "i16", "i32", "i64", "u8", "u16", "u32", "u64", "usize", "size":
            ret true
        end
    end
    ret false
end

func ic_type_ok(ts: str): bool:
    ret ic_int_type(ts) or str.Equals(ts, "char") or str.Equals(ts, "uchar") or str.Equals(ts, "str")
end

func ic_order_op(op: int): bool:
    ret op == tok.TK_LT or op == tok.TK_LE or op == tok.TK_GT or op == tok.TK_GE
end

func ic_flip(kind: int): int:
    switch kind:
        tok.TK_LT:
            ret tok.TK_GT
        end
        tok.TK_GT:
            ret tok.TK_LT
        end
        tok.TK_LE:
            ret tok.TK_GE
        end
        tok.TK_GE:
            ret tok.TK_LE
        end
    end
    ret kind
end

func ic_const_sym(s &: Sema, a &: at.Ast, nid: int): int:
    n := at.Get(a, nid)
    if n.kind == at.AST_IDENTIFIER:
        sid := scope_lookup(s, s.cur, n.name)
        if sid != 0 and sym_at(s, sid).kind == SYM_CONST and not sym_at(s, sid).is_mut:
            ret sid
        end
        ret 0
    end
    if n.kind == at.AST_MEMBER and n.a != 0 and at.KindOf(a, n.a) == at.AST_IDENTIFIER:
        pk := scope_lookup(s, s.cur, at.Get(a, n.a).name)
        if pk != 0 and sym_at(s, pk).kind == SYM_PACKAGE:
            m := scope_lookup_local(s, sym_at(s, pk).members, n.name)
            if m != 0 and sym_at(s, m).kind == SYM_CONST and not sym_at(s, m).is_mut:
                ret m
            end
        end
    end
    ret 0
end

func ic_enum_sym(s &: Sema, a &: at.Ast, subj: int): int:
    ts := at.Get(a, subj).type_str
    if str.Len(ts) == 0:
        ret 0
    end
    sid := scope_lookup(s, s.cur, ts)
    if sid == 0 or sym_at(s, sid).kind != SYM_ENUM or sym_at(s, sid).enum_data:
        ret 0
    end
    ret sid
end

func ic_enum_member(s &: Sema, a &: at.Ast, esym: int, nid: int): int:
    n := at.Get(a, nid)
    if n.kind != at.AST_MEMBER or n.a == 0 or at.KindOf(a, n.a) != at.AST_IDENTIFIER:
        ret 0
    end
    if scope_lookup(s, s.cur, at.Get(a, n.a).name) != esym:
        ret 0
    end
    m := scope_lookup_local(s, sym_at(s, esym).members, n.name)
    if m != 0 and sym_at(s, m).kind == SYM_ENUM_MEMBER:
        ret m
    end
    ret 0
end

func ic_enum_total(s &: Sema, esym: int): int:
    syms := scope_at(s, sym_at(s, esym).members).symbols
    mut total := 0
    repeat syms.len() in i:
        if sym_at(s, syms.get(i)).kind == SYM_ENUM_MEMBER:
            total++
        end
    end
    ret total
end

func ic_label_id(s &: Sema, a &: at.Ast, nid: int): str:
    n := at.Get(a, nid)
    if n.kind == at.AST_MEMBER and n.a != 0 and at.KindOf(a, n.a) == at.AST_IDENTIFIER:
        root := scope_lookup(s, s.cur, at.Get(a, n.a).name)
        if root != 0 and sym_at(s, root).kind == SYM_ENUM:
            m := ic_enum_member(s, a, root, nid)
            ret m != 0 ? "m" + m : ""
        end
    end
    mut lit := nid
    if n.kind != at.AST_LITERAL:
        sid := ic_const_sym(s, a, nid)
        if sid == 0:
            ret ""
        end
        lit = const_ref_node(s, a, nid)
        if lit == 0 or at.KindOf(a, lit) != at.AST_LITERAL:
            ret "k" + sid
        end
    end
    ln := at.Get(a, lit)
    if ln.op == tok.TK_STRING or ln.op == tok.TK_RAW_STRING or ln.op == tok.TK_TRIPLE_STRING:
        ret "s" + ln.value_str
    end
    if ln.op == tok.TK_INT or ln.op == tok.TK_CHAR or ln.op == tok.TK_UTF8_CHAR:
        ret "i" + ln.value_int
    end
    ret ""
end

func ic_const_ok(s &: Sema, a &: at.Ast, nid: int): bool:
    n := at.Get(a, nid)
    if not ic_type_ok(n.type_str):
        ret false
    end
    if n.kind == at.AST_LITERAL:
        ret n.op == tok.TK_INT or n.op == tok.TK_CHAR or n.op == tok.TK_UTF8_CHAR or n.op == tok.TK_STRING or n.op == tok.TK_RAW_STRING or n.op == tok.TK_TRIPLE_STRING
    end
    ret ic_const_sym(s, a, nid) != 0
end

func ic_arith_op(op: int): bool:
    switch op:
        tok.TK_PLUS, tok.TK_MINUS, tok.TK_STAR, tok.TK_SLASH, tok.TK_PERCENT, tok.TK_AMP, tok.TK_PIPE, tok.TK_CARET:
            ret true
        end
    end
    ret false
end

func ic_key(s &: Sema, a &: at.Ast, nid: int): str:
    if nid == 0:
        ret ""
    end
    n := at.Get(a, nid)
    if n.kind == at.AST_IDENTIFIER:
        sid := scope_lookup(s, s.cur, n.name)
        if sid == 0 or sym_at(s, sid).kind == SYM_CONST:
            ret ""
        end
        ret "v" + sid
    end
    if n.kind == at.AST_THIS:
        ret "this"
    end
    if n.kind == at.AST_LITERAL:
        if n.op == tok.TK_INT or n.op == tok.TK_CHAR or n.op == tok.TK_UTF8_CHAR:
            ret "#" + n.value_int
        end
        ret ""
    end
    if n.kind == at.AST_MEMBER:
        ka := ic_key(s, a, n.a)
        ret str.Len(ka) == 0 ? "" : ka + "." + n.name
    end
    if n.kind == at.AST_INDEX:
        ka := ic_key(s, a, n.a)
        kb := ic_key(s, a, n.b)
        ret str.Len(ka) == 0 or str.Len(kb) == 0 ? "" : ka + "[" + kb + "]"
    end
    if n.kind == at.AST_CAST:
        ka := ic_key(s, a, n.a)
        ret str.Len(ka) == 0 or str.Len(n.type_str) == 0 ? "" : "(" + ka + " as " + n.type_str + ")"
    end
    if n.kind == at.AST_BINARY and ic_arith_op(n.op):
        ka := ic_key(s, a, n.a)
        kb := ic_key(s, a, n.b)
        ret str.Len(ka) == 0 or str.Len(kb) == 0 ? "" : "(" + ka + " " + n.op + " " + kb + ")"
    end
    if n.kind == at.AST_UNARY and (n.op == tok.TK_MINUS or n.op == tok.TK_TILDE):
        ka := ic_key(s, a, n.a)
        ret str.Len(ka) == 0 ? "" : "(u" + n.op + " " + ka + ")"
    end
    ret ""
end

func ic_subject_ok(a &: at.Ast, nid: int, esym: int): bool:
    if at.Get(a, nid).kind == at.AST_LITERAL:
        ret false
    end
    ret esym != 0 or ic_type_ok(at.Get(a, nid).type_str)
end

func ic_side(s &: Sema, a &: at.Ast, subj: int, cst: int, kind: int): IcAtom:
    mut r := IcAtom {}
    esym := ic_enum_sym(s, a, subj)
    if not ic_subject_ok(a, subj, esym):
        ret r
    end
    if esym != 0:
        if kind != IC_EQ or ic_enum_member(s, a, esym, cst) == 0:
            ret r
        end
    else:
        if not ic_const_ok(s, a, cst):
            ret r
        end
        if kind != IC_EQ and not ic_int_type(at.Get(a, subj).type_str):
            ret r
        end
    end
    key := ic_key(s, a, subj)
    if str.Len(key) == 0:
        ret r
    end
    r.ok = true
    r.key = key
    r.subj = subj
    r.kind = kind
    r.cst = cst
    ret r
end

func ic_pair(s &: Sema, a &: at.Ast, x: int, y: int, kind: int): IcAtom:
    r := ic_side(s, a, x, y, kind)
    if r.ok:
        ret r
    end
    ret ic_side(s, a, y, x, ic_flip(kind))
end

func ic_is_str_equals(s &: Sema, a &: at.Ast, call: int): bool:
    callee := at.Get(a, at.Get(a, call).a)
    if callee.kind != at.AST_MEMBER or callee.a == 0 or at.KindOf(a, callee.a) != at.AST_IDENTIFIER:
        ret false
    end
    pk := scope_lookup(s, s.cur, at.Get(a, callee.a).name)
    if pk == 0 or sym_at(s, pk).kind != SYM_PACKAGE or not str.Equals(sym_at(s, pk).pkgname, "str"):
        ret false
    end
    m := scope_lookup_local(s, sym_at(s, pk).members, callee.name)
    ret m != 0 and str.Equals(sym_at(s, m).name, "Equals")
end

func ic_cmp(s &: Sema, a &: at.Ast, nid: int): IcAtom:
    n := at.Get(a, nid)
    if n.kind == at.AST_BINARY:
        if n.op == tok.TK_EQ:
            ret ic_pair(s, a, n.a, n.b, IC_EQ)
        end
        if ic_order_op(n.op):
            ret ic_pair(s, a, n.a, n.b, n.op)
        end
    else n.kind == at.AST_CALL and n.list.len() == 2 and ic_is_str_equals(s, a, nid):
        ret ic_pair(s, a, n.list.get(0), n.list.get(1), IC_EQ)
    end
    ret IcAtom {}
end

func ic_range(s &: Sema, a &: at.Ast, l: IcAtom, r: IcAtom, lo &: int, hi &: int): bool:
    if l.kind == tok.TK_GE and r.kind == tok.TK_LE:
        lo = l.cst
        hi = r.cst
    else l.kind == tok.TK_LE and r.kind == tok.TK_GE:
        lo = r.cst
        hi = l.cst
    else:
        ret false
    end
    mut lv := 0 as i64
    mut hv := 0 as i64
    if fold_operand_int(s, a, lo, lv) and fold_operand_int(s, a, hi, hv) and lv > hv:
        ret false
    end
    ret true
end

func ic_commit(q &: IcSeq, ac: IcAtom, hi: int, cur_key &: str, cur_subj &: int): bool:
    if str.Len(cur_key) == 0:
        cur_key = ac.key
        cur_subj = ac.subj
    else not str.Equals(cur_key, ac.key):
        ret false
    end
    q.labels.push(ac.cst)
    q.lab_kind.push(ac.kind)
    q.lab_hi.push(hi)
    ret true
end

func ic_atoms(s &: Sema, a &: at.Ast, q &: IcSeq, nid: int, cur_key &: str, cur_subj &: int): bool:
    n := at.Get(a, nid)
    if n.kind == at.AST_BINARY and n.op == tok.TK_OR:
        ret ic_atoms(s, a, q, n.a, cur_key, cur_subj) and ic_atoms(s, a, q, n.b, cur_key, cur_subj)
    end
    if n.kind == at.AST_BINARY and n.op == tok.TK_AND:
        l := ic_cmp(s, a, n.a)
        r := ic_cmp(s, a, n.b)
        mut lo := 0
        mut hi := 0
        if not (l.ok and r.ok and str.Equals(l.key, r.key) and ic_range(s, a, l, r, lo, hi)):
            ret false
        end
        mut ac := l
        ac.kind = IC_RANGE
        ac.cst = lo
        ret ic_commit(q, ac, hi, cur_key, cur_subj)
    end
    single := ic_cmp(s, a, nid)
    ret single.ok and ic_commit(q, single, 0, cur_key, cur_subj)
end

func ic_add_link(s &: Sema, a &: at.Ast, q &: IcSeq, stmt: int, cond: int, body: int, first: bool):
    q.stmt.push(stmt)
    q.cond.push(cond)
    q.body.push(body)
    q.first_of_stmt.push(first)
    q.last_of_stmt.push(false)
    q.tail_else.push(0)
    lo := q.labels.len()
    mut key := ""
    mut subj := 0
    good := ic_atoms(s, a, q, cond, key, subj)
    if not good:
        ic_labels_truncate(q, lo)
        key = ""
        subj = 0
    end
    q.ok.push(good)
    q.key.push(key)
    q.subj.push(subj)
    q.lab_from.push(lo)
    q.lab_to.push(q.labels.len())
end

func ic_labels_distinct(s &: Sema, a &: at.Ast, q &: IcSeq, i: int, j: int): bool:
    mut seen := HashMap {} as HashMap<str, bool>
    defer seen.free()
    mut k := i
    until k < j:
        mut li := q.lab_from.get(k)
        until li < q.lab_to.get(k):
            if q.lab_kind.get(li) == IC_EQ:
                id := ic_label_id(s, a, q.labels.get(li))
                if str.Len(id) == 0 or seen.has(id):
                    ret false
                end
                seen.put(id, true)
            end
            li++
        end
        k++
    end
    ret true
end

func ic_subject_text(a &: at.Ast, nid: int, lang: str): str:
    n := at.Get(a, nid)
    if n.kind == at.AST_IDENTIFIER:
        ret written_name(a, nid)
    end
    if n.kind == at.AST_THIS:
        ret code_lang("this", lang)
    end
    if n.kind == at.AST_MEMBER:
        ret ic_subject_text(a, n.a, lang) + "." + written_name(a, nid)
    end
    if n.kind == at.AST_INDEX:
        ret ic_subject_text(a, n.a, lang) + "[" + ic_subject_text(a, n.b, lang) + "]"
    end
    if n.kind == at.AST_LITERAL:
        ret n.name
    end
    if n.kind == at.AST_CAST:
        ret ic_subject_text(a, n.a, lang) + " " + code_lang("as", lang) + " " + type_text_disp(n.type_str)
    end
    ret "..."
end

func ic_queue_fix(fx: lg.Fix, imp: lg.Fix, drop: bool):
    mut primary := fx
    primary.safe = g_sm_ifchain == 3
    primary.preferred = g_sm_ifchain == 3
    queue_fix(primary)
    if drop:
        mut extra := imp
        extra.safe = primary.safe
        extra.preferred = primary.preferred
        queue_fix(extra)
    end
end

func ic_report(s &: Sema, a &: at.Ast, q &: IcSeq, i: int, j: int, stop: int):
    first := at.Get(a, q.cond.get(i))
    seen_key := s.file + ":" + first.begin_index
    if g_ic_seen.has(seen_key):
        ret
    end
    g_ic_seen.put(seen_key, true)
    mut sp := span_of(a, q.cond.get(i))
    if first.end_index > first.begin_index:
        sp.length = first.end_index - first.begin_index
    end
    subj := ic_subject_text(a, q.subj.get(i), s.lang)
    kw_switch := kw_spell(s, s.file, tok.TK_KW_SWITCH)
    mut help := co.Format2(
        i18.Tr("group them as '%s %s:' with one label per constant"), co.ArgStr(kw_switch), co.ArgStr(subj)
    )
    if stop >= 0:
        help = help + ". " + co.Format2(
            i18.Tr("The run stops at line %d because that test is not a plain comparison of '%s'."), co.ArgInt(at.Get(a, q.cond.get(stop)).begin_line as i64), co.ArgStr(subj)
        )
    end
    mut fx := fix_at(sp)
    mut imp := fix_at(sp)
    mut drop := false
    if ic_labels_distinct(s, a, q, i, j) and ic_try_fix(s, a, q, i, j, fx, imp, drop):
        ic_queue_fix(fx, imp, drop)
    end
    msg := co.Format2(
        i18.Tr("%d consecutive comparisons of '%s' against constants could be a switch"), co.ArgInt((j - i) as i64), co.ArgStr(subj)
    )
    if g_sm_ifchain == 2:
        serr_help(s, IFCHAIN_CODE, sp, msg, help)
    else:
        swarn_help(s, IFCHAIN_CODE, sp, msg, help)
    end
end

func ic_flush(s &: Sema, a &: at.Ast, q &: IcSeq):
    n := q.stmt.len()
    mut i := 0
    until i < n:
        if not q.ok.get(i):
            i++
            continue
        end
        mut j := i + 1
        until j < n and q.ok.get(j) and str.Equals(q.key.get(j), q.key.get(i)):
            j++
        end
        if j - i >= g_sm_ifchain_min:
            ic_report(s, a, q, i, j, j < n ? j : 0 - 1)
        end
        i = j
    end
    ic_clear(q)
end

func ic_unroll(s &: Sema, a &: at.Ast, q &: IcSeq, st: int): bool:
    mut cur := st
    mut first := true
    mut all_term := true
    mut guard := 0
    until cur != 0 and guard < 100000:
        n := at.Get(a, cur)
        ic_add_link(s, a, q, st, n.a, n.b, first)
        first = false
        if not sema_stmt_terminates(s, a, n.b):
            all_term = false
        end
        nxt := n.c
        if nxt != 0 and at.KindOf(a, nxt) == at.AST_IF:
            cur = nxt
        else:
            last := q.stmt.len() - 1
            q.last_of_stmt.set(last, true)
            if nxt != 0:
                q.tail_else.set(last, nxt)
                all_term = false
            end
            cur = 0
        end
        guard++
    end
    ret all_term
end

pub func SemaIfChainReset():
    g_ic_seen.free()
    g_ic_seen = HashMap {} as HashMap<str, bool>
end

pub func SemaCheckIfChains(s &: Sema, a &: at.Ast, block: int):
    if g_sm_ifchain == 0 or s.requal or s.in_derive or ic_library_file(s.file):
        ret
    end
    cnt := at.ChildCount(a, block)
    if cnt == 0:
        ret
    end
    mut q := IcSeq {}
    defer ic_free(q)
    repeat cnt in i:
        st := at.Child(a, block, i)
        if at.KindOf(a, st) != at.AST_IF or at.Get(a, st).synthetic:
            ic_flush(s, a, q)
            continue
        end
        if not ic_unroll(s, a, q, st):
            ic_flush(s, a, q)
        end
    end
    ic_flush(s, a, q)
end
