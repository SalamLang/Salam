package semantic

import str

include co "../sal_core.salam"
include tok "../token.salam"
include at "../ast.salam"
include lg "../logger.salam"
include i18 "../i18n.salam"

func layout_localize_names(a &: at.Ast, nid: int):
    if nid == 0:
        ret
    end
    n := at.Get(a, nid)
    if n.kind == at.AST_LAYOUT_ELEMENT or n.kind == at.AST_LAYOUT_ATTR:
        at.SetName(a, nid, i18.LayoutWord(n.name))
    end
    repeat at.ChildCount(a, nid) in i:
        layout_localize_names(a, at.Child(a, nid, i))
    end
end

func lay_attr_string(a &: at.Ast, attr: int, out &: str): bool:
    v := at.Get(a, attr).a
    if v == 0:
        ret false
    end
    vv := at.Get(a, v)
    if vv.kind == at.AST_LITERAL and vv.value_kind == tok.TV_STRING:
        out = vv.value_str
        ret true
    end
    ret false
end

func lay_elem_attr(a &: at.Ast, el: int, name: str): int:
    repeat at.ChildCount(a, el) in i:
        cid := at.Child(a, el, i)
        c := at.Get(a, cid)
        if c.kind == at.AST_LAYOUT_ATTR and str.Equals(c.name, name):
            ret cid
        end
    end
    ret 0
end

func lay_subtree_has_id(a &: at.Ast, el: int): bool:
    repeat at.ChildCount(a, el) in i:
        cid := at.Child(a, el, i)
        if at.KindOf(a, cid) != at.AST_LAYOUT_ELEMENT:
            continue
        end
        if lay_elem_attr(a, cid, "id") != 0 or lay_subtree_has_id(a, cid):
            ret true
        end
    end
    ret false
end

func lay_check_repeat(s &: Sema, a &: at.Ast, element: int):
    if lay_elem_attr(a, element, "repeat") == 0:
        ret
    end
    elname := at.Get(a, element).name
    if lay_elem_attr(a, element, "id") != 0:
        serr(
            s, 19, span_of(a, element), co.Format1(
                i18.Tr("element '%s' cannot use 'repeat' together with 'id'"), co.ArgStr(elname)
            )
        )
    else lay_subtree_has_id(a, element):
        serr(
            s, 19, span_of(a, element), co.Format1(
                i18.Tr("element '%s' has 'repeat' but a nested element has an 'id'"), co.ArgStr(elname)
            )
        )
    end
end

func lay_check_attr(s &: Sema, a &: at.Ast, attr: int):
    name := at.Get(a, attr).name
    if str.Len(name) == 0:
        ret
    end
    ai := lay_attr_lookup(name)
    if ai < 0:
        ret
    end
    mut v := ""
    if not lay_attr_string(a, attr, v):
        ret
    end
    if not lay_attr_value_ok(ai, v):
        serr(
            s, 18, span_of(a, attr), co.Format3(
                i18.Tr("invalid value for '%s': '%s' is not %s"), co.ArgStr(name), co.ArgStr(v), co.ArgStr(
                    lay_value_type_name(
                        g_sm_lay_attr_vtype.get(ai)
                    )
                )
            )
        )
    end
end

func lay_check_required(s &: Sema, a &: at.Ast, element: int, ei: int):
    if ei < 0:
        ret
    end
    req := g_sm_lay_elem_required.get(ei)
    if str.Len(req) == 0:
        ret
    end
    elname := at.Get(a, element).name
    n := str.Len(req)
    mut p := 0
    until p <= n:
        comma := str.IndexFrom(req, ",", p)
        mut l := 0
        if comma >= 0:
            l = comma - p
        else:
            l = n - p
        end
        piece := str.Substr(req, p, l)
        mut found := false
        repeat at.ChildCount(a, element) in i:
            c := at.Get(a, at.Child(a, element, i))
            if c.kind == at.AST_LAYOUT_ATTR and str.Equals(c.name, piece):
                found = true
                break
            end
        end
        if not found:
            serr(
                s, 5, span_of(a, element), co.Format3(
                    i18.Tr("element '%s' is missing required attribute '%.*s'"), co.ArgStr(elname), co.ArgInt(l as i64), co.ArgStr(str.Substr(req, p, n - p))
                )
            )
        end
        if comma < 0:
            break
        end
        p = comma + 1
    end
end

func sema_check_layout(s &: Sema, a &: at.Ast, nid: int, parent: str):
    k := at.KindOf(a, nid)
    if k == at.AST_LAYOUT_BLOCK:
        layout_localize_names(a, nid)
        lg.Log(
            s.log, lg.PH_SEMANTIC, lg.LOG_DEBUG, i18.Tr("validating layout block")
        )
        if lay_elem_attr(a, nid, "repeat") != 0 and lay_subtree_has_id(a, nid):
            serr(
                s, 19, span_of(a, nid), i18.Tr("layout uses 'repeat' but a nested element has an 'id'")
            )
        end
        repeat at.ChildCount(a, nid) in i:
            cid := at.Child(a, nid, i)
            ck := at.KindOf(a, cid)
            if ck == at.AST_LAYOUT_ELEMENT:
                sema_check_layout(s, a, cid, "layout")
            else ck == at.AST_LAYOUT_ATTR:
                lay_check_attr(s, a, cid)
            end
        end
        ret
    end
    if k == at.AST_LAYOUT_ELEMENT:
        elname := at.Get(a, nid).name
        ei := lay_elem_lookup(elname)
        if ei < 0:
            swarn(
                s, 2, span_of(a, nid), co.Format1(
                    i18.Tr("unrecognized layout element '%s' (ignored)"), co.ArgStr(elname)
                )
            )
        else:
            parents := g_sm_lay_elem_parents.get(ei)
            if str.Len(parents) > 0 and not lay_csv_has(parents, parent):
                serr(
                    s, 4, span_of(a, nid), co.Format2(
                        i18.Tr("element '%s' cannot be placed inside '%s'"), co.ArgStr(elname), co.ArgStr(str.Len(parent) > 0 ? parent : "<root>")
                    )
                )
            end
            lay_check_required(s, a, nid, ei)
        end
        lay_check_repeat(s, a, nid)
        repeat at.ChildCount(a, nid) in i2:
            cid2 := at.Child(a, nid, i2)
            ck2 := at.KindOf(a, cid2)
            if ck2 == at.AST_LAYOUT_ELEMENT:
                sema_check_layout(s, a, cid2, elname)
            else ck2 == at.AST_LAYOUT_ATTR:
                lay_check_attr(s, a, cid2)
            end
        end
        ret
    end
end

func loopless_break(a &: at.Ast, nid: int): bool:
    if nid == 0:
        ret false
    end
    n := at.Get(a, nid)
    if n.kind == at.AST_BREAK:
        ret true
    end
    if n.kind == at.AST_BLOCK:
        repeat at.ChildCount(a, nid) in i:
            if loopless_break(a, at.Child(a, nid, i)):
                ret true
            end
        end
        ret false
    end
    if n.kind == at.AST_IF:
        ret loopless_break(a, n.b) or loopless_break(a, n.c)
    end
    if n.kind == at.AST_MATCH:
        repeat at.ChildCount(a, nid) in j:
            arm := at.Child(a, nid, j)
            if loopless_break(a, at.Get(a, arm).b):
                ret true
            end
        end
        ret false
    end
    ret false
end

func node_flag_set(v &: Vector<bool>, id: int):
    until v.len() <= id:
        v.push(false)
    end
    v.set(id, true)
end

func node_flag(v: Vector<bool>, id: int): bool:
    ret id > 0 and id < v.len() and v.get(id)
end

func note_noret_call(s &: Sema, a &: at.Ast, call: int, sig: int):
    if sig <= 0:
        ret
    end
    sg := sig_at(s, sig)
    if sg.decl != 0 and at.At(a, sg.decl).is_noret:
        node_flag_set(s.noret_calls, call)
    end
end

func fn_body_terminates(s &: Sema, a &: at.Ast, body: int): bool:
    saved := s.term_covers_all
    s.term_covers_all = true
    r := sema_stmt_terminates(s, a, body)
    s.term_covers_all = saved
    ret r
end

func arm_terminates(s &: Sema, a &: at.Ast, body: int): bool:
    ret sema_stmt_terminates(s, a, body) and not loopless_break(a, body)
end

func sema_stmt_terminates(s &: Sema, a &: at.Ast, nid: int): bool:
    if nid == 0:
        ret false
    end
    n := at.Get(a, nid)
    if n.kind == at.AST_RETURN or n.kind == at.AST_BREAK or n.kind == at.AST_CONTINUE:
        ret true
    end
    if n.kind == at.AST_BLOCK:
        repeat at.ChildCount(a, nid) in i:
            if sema_stmt_terminates(s, a, at.Child(a, nid, i)):
                ret true
            end
        end
        ret false
    end
    if n.kind == at.AST_IF:
        ret n.c != 0 and sema_stmt_terminates(s, a, n.b) and sema_stmt_terminates(s, a, n.c)
    end
    if n.kind == at.AST_UNTIL:
        ret n.a != 0 and at.KindOf(a, n.a) == at.AST_LITERAL and at.Get(a, n.a).op == tok.TK_KW_TRUE and not loopless_break(a, n.b)
    end
    if n.kind == at.AST_MATCH or n.kind == at.AST_SWITCH:
        if at.ChildCount(a, nid) == 0 or (n.kind == at.AST_SWITCH and not s.term_covers_all):
            ret false
        end
        if not node_flag(s.exhaustive, nid) and not (s.term_covers_all and node_flag(s.covers_all, nid)):
            ret false
        end
        falls := n.kind == at.AST_SWITCH
        mut next_ok := false
        mut j := at.ChildCount(a, nid) - 1
        until j >= 0:
            body := at.At(a, at.Child(a, nid, j)).b
            mut ok := arm_terminates(s, a, body)
            if not ok and falls and next_ok and not loopless_break(a, body):
                ok = true
            end
            if not ok:
                ret false
            end
            next_ok = true
            j -= 1
        end
        ret true
    end
    if n.kind == at.AST_EXPR_STMT:
        ret n.a != 0 and node_flag(s.noret_calls, n.a)
    end
    ret false
end

func stamp_empty_intrinsic(s &: Sema, a &: at.Ast, val: int, target: int): bool:
    if val == 0 or target < 0:
        ret false
    end
    n := at.Get(a, val)
    if n.kind != at.AST_STRUCT_LIT or str.Len(n.name) == 0:
        ret false
    end
    sp := span_of(a, val)
    canon_intrinsic_lit(s, a, val, intrinsic_type_canon(n.name), sp)
    vname := at.Get(a, val).name
    tk := ty_at(s, target).kind
    if (tk == TY_VEC and str.Equals(vname, "Vector")) or (tk == TY_MAP and str.Equals(vname, "HashMap")):
        at.SetTypeStr(a, val, type_to_string(s, target))
        _sd := sema_decorate(s, a, val, target)
        ret true
    end
    ret false
end

func check_unused_params(s &: Sema, a &: at.Ast, sc: int, _fn: int):
    scv := scope_at(s, sc)
    repeat scv.symbols.len() in i:
        p := sym_at(s, scv.symbols.get(i))
        if p.kind == SYM_PARAM and not p.used and p.decl != 0 and str.Len(p.name) > 0 and byte_at(p.name, 0) != 95 and not at.NameIsErr(p.name) and not str.Equals(p.name, "this") and not at.WasPruned(a, s.file, p.name):
            serr(
                s, 62, span_of(a, p.decl), co.Format1(
                    i18.Tr("unused parameter '%s': the function body never uses it; remove it from the signature and from every call, or use it in the body; start the name with '_' only when the signature is fixed, for example a callback passed to another function"), co.ArgStr(p.name)
                )
            )
        end
    end
end

func generic_template(s &: Sema, a &: at.Ast, name: str, kind: int): int:
    if str.Len(name) == 0:
        ret 0
    end
    sym := scope_lookup(s, s.cur, name)
    if sym == 0:
        ret 0
    end
    sv := sym_at(s, sym)
    if sv.kind == kind and sv.decl != 0 and at.TyparamCount(a, sv.decl) > 0:
        ret sym
    end
    ret 0
end

func generic_template_shadowed(s &: Sema, a &: at.Ast, name: str, kind: int): int:
    if str.Len(name) == 0:
        ret 0
    end
    sema_load_prelude(s, a)
    if s.prelude == 0:
        ret 0
    end
    psym := scope_lookup_local(s, s.prelude, name)
    if psym == 0:
        ret 0
    end
    pv := sym_at(s, psym)
    if pv.kind == kind and pv.decl != 0 and at.TyparamCount(a, pv.decl) > 0:
        ret psym
    end
    ret 0
end

func g_instantiate_struct(
    s &: Sema, a &: at.Ast, tmpl: int, targ_nodes: Vector<int>, sp: co.SrcSpan
): int:
    tn := at.Get(a, tmpl)
    if targ_nodes.len() != tn.typarams.len():
        serr(
            s, 1, sp, co.Format4(
                i18.Tr("generic '%s' expects %zu type argument%s, got %zu"), co.ArgStr(tn.name), co.ArgUint(tn.typarams.len() as u64), co.ArgStr(plural_suffix(tn.typarams.len())), co.ArgUint(targ_nodes.len() as u64)
            )
        )
        ret 0
    end
    mut argtypes := Vector {} as Vector<int>
    defer argtypes.free()
    repeat targ_nodes.len() in i:
        argtypes.push(g_check_targ(s, a, sema_resolve_type(s, a, targ_nodes.get(i)), sp))
    end
    iname := g_instance_name(s, tn.name, argtypes)
    existing := scope_lookup_local(s, s.global, iname)
    if existing != 0:
        ret existing
    end
    save_lang := s.lang
    if str.Len(tn.origin_lang) > 0:
        s.lang = tn.origin_lang
    end
    g_check_bounds(s, a, tmpl, argtypes, sp)
    inst := at.Clone(a, tmpl)
    mut iv := at.Get(a, inst)
    iv.name = iname
    iv.synthetic = true
    iv.home_pkg = derive_pkg_name_of(s, s.gen_pkg != 0 ? s.gen_pkg : s.global)
    at.Put(a, inst, iv)
    rargs := g_resolved_targs(a, targ_nodes, argtypes)
    g_subst(a, inst, tn.typarams, rargs)
    rargs.free()
    mut iv2 := at.Get(a, inst)
    iv2.typarams.clear()
    at.Put(a, inst, iv2)
    at.AddChild(a, s.program, inst)
    sym := symbol_new(s, SYM_STRUCT, iname)
    members := scope_new(s, SCOPE_STRUCT, s.global)
    mut msc := scope_at(s, members)
    msc.label = iname
    msc.aux = s.gen_pkg
    scope_put(s, members, msc)
    mut sv := sym_at(s, sym)
    sv.decl = inst
    sv.ty = type_struct(s, sym, iname)
    sv.members = members
    sv.home = s.gen_pkg
    sv.enum_case = tn.enum_payload
    sv.generic_base = tn.name
    repeat argtypes.len() in gi:
        sv.generic_args.push(argtypes.get(gi))
    end
    sym_put(s, sym, sv)
    _sd := scope_define(s, s.global, sym)
    repeat at.ChildCount(a, inst) in j:
        mid := at.Child(a, inst, j)
        m := at.Get(a, mid)
        if m.kind == at.AST_FIELD:
            f := symbol_new(s, SYM_FIELD, m.name)
            ftt := sema_resolve_type(s, a, m.ty)
            mut fv := sym_at(s, f)
            fv.ty = ftt
            fv.decl = mid
            fv.is_pub = m.is_pub
            sym_put(s, f, fv)
            _fd := scope_define(s, members, f)
        else m.kind == at.AST_FUNC_DEF:
            mm := get_or_make_func(s, members, m.name, SYM_METHOD)
            sig := build_sig(s, a, mid, sym)
            mut mv := sym_at(s, mm)
            if mv.decl == 0:
                mv.decl = mid
            end
            if m.is_pub:
                mv.is_pub = true
            end
            mv.overloads.push(sig)
            mv.ty = sym_at(s, sym).ty
            sym_put(s, mm, mv)
        end
    end
    s.pending.push(inst)
    s.lang = save_lang
    ret sym
end
