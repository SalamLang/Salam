package semantic

import str
import os
import gui.style

include co "../sal_core.salam"
include tok "../token.salam"
include at "../ast.salam"
include lg "../logger.salam"
include i18 "../i18n.salam"

mut g_lay_sp_comps := Vector {} as Vector<str>
mut g_lay_known_comps := Vector {} as Vector<str>
mut g_lay_outside_comps := Vector {} as Vector<str>

mut g_lay_sp_hit_node := Vector {} as Vector<int>

mut g_lay_sp_hit_off := Vector {} as Vector<str>

mut g_lay_sp_path := ""

mut g_lay_sp_reported := Vector {} as Vector<str>

mut g_lay_locals := Vector {} as Vector<str>

mut g_lay_bare_seen := HashMap {} as HashMap<str, bool>

struct LayCheck:
    pub stack: Vector<int> = Vector {}
    pub ids: Vector<str> = Vector {}
    pub ref_vals: Vector<str> = Vector {}
    pub ref_nodes: Vector<int> = Vector {}
    pub ref_names: Vector<str> = Vector {}
    pub doc_unique: Vector<int> = Vector {}
    pub comps: Vector<str> = Vector {}
    pub unexpanded: bool = false
    pub runtime: bool = false
    pub in_each: int = 0
    pub cls_names: Vector<str> = Vector {}
    pub cls_sigs: Vector<str> = Vector {}
    pub cls_nodes: Vector<int> = Vector {}
end

func lay_pseudo_index(name: str, plen &: int): int:
    lay_ensure()
    if str.Len(lay_attr_key_exact(name)) > 0:
        plen = 0
        ret 0 - 1
    end
    prefixes := [
        "hover", "focus", "active", "before", "after", "اشاره", "تمرکز", "فشردن",
        "پیش\xE2\x80\x8Cاز", "پس\xE2\x80\x8Cاز"
    ]
    repeat len(prefixes) in i:
        p := prefixes[i]
        pl := str.Len(p)
        if str.Len(name) > pl + 1 and str.StartsWith(name, p):
            sep := byte_at(name, pl)
            if sep == 95 or sep == 32 or sep == 45:
                plen = pl + 1
                ret i % 5
            end
        end
    end
    plen = 0
    ret 0 - 1
end

func lay_pseudo_prefix_len(name: str): int:
    mut pl := 0
    _i := lay_pseudo_index(name, pl)
    ret pl
end

func lay_pseudo_canon(name: str): str:
    canon := ["hover", "focus", "active", "before", "after"]
    mut pl := 0
    i := lay_pseudo_index(name, pl)
    ret i >= 0 ? canon[i] : ""
end

func lay_pseudo_rest_key(rest: str): str:
    if str.Equals(lay_loose(rest), "content"):
        ret "content"
    end
    ret lay_attr_key_exact(rest)
end

func lay_attr_text(a &: at.Ast, attr: int, out &: str): bool:
    v := at.Get(a, attr).a
    if v == 0:
        ret false
    end
    vv := at.Get(a, v)
    if vv.kind == at.AST_LITERAL:
        if vv.value_kind == tok.TV_STRING:
            out = vv.value_str
            ret true
        end
        if vv.op == tok.TK_INT:
            out = co.U64Toa(vv.value_int) + LayoutNumUnit(vv.name)
            ret true
        end
        if vv.op == tok.TK_FLOAT:
            out = co.Format1("%g", co.ArgFloat(vv.value_float)) + LayoutNumUnit(vv.name)
            ret true
        end
        if vv.op == tok.TK_KW_TRUE:
            out = "true"
            ret true
        end
        if vv.op == tok.TK_KW_FALSE:
            out = "false"
            ret true
        end
        ret false
    end
    if vv.kind == at.AST_IDENTIFIER:
        out = vv.name
        ret true
    end
    ret false
end

func lay_elem_attr(a &: at.Ast, el: int, name: str): int:
    repeat at.ChildCount(a, el) in i:
        cid := at.Child(a, el, i)
        c := at.Get(a, cid)
        if c.kind == at.AST_LAYOUT_ATTR and str.Equals(c.name, name):
            ret cid
        end
    end
    ret 0
end

func lay_subtree_has_id(a &: at.Ast, el: int): bool:
    repeat at.ChildCount(a, el) in i:
        cid := at.Child(a, el, i)
        if at.KindOf(a, cid) != at.AST_LAYOUT_ELEMENT:
            continue
        end
        if lay_elem_attr(a, cid, "id") != 0 or lay_subtree_has_id(a, cid):
            ret true
        end
    end
    ret false
end

func lay_localize_attr(a &: at.Ast, attr: int):
    name := at.Get(a, attr).name
    sa := ResolveStyleAttr(name)
    if sa.ok and not StyleAttrIsEvent(a, attr):
        states := [
            "", "hover_", "focus_", "focus_within_", "active_", "disabled_", "checked_", "invalid_",
            "placeholder_", "selection_"
        ]
        canon := states[sa.state] + style.PropName(sa.prop)
        if not str.Equals(canon, name):
            at.SetName(a, attr, canon)
        end
        ret
    end
    key := lay_attr_key_exact(name)
    if str.Len(key) > 0:
        if not str.Equals(key, name):
            at.SetName(a, attr, key)
        end
        ret
    end
    mut rest := ""
    pkey := lay_attr_pattern_match(name, rest)
    if str.Len(pkey) > 0:
        ai := lay_attr_for(0 - 1, pkey)
        if ai >= 0:
            out := g_lay_attrs.Get(ai).out
            star := str.IndexOf(out, "*")
            if star >= 0:
                at.SetName(
                    a,
                    attr,
                    str.Substr(out, 0, star) + str.Lower(
                        str.Replace(str.Replace(rest, " ", "-"), "_", "-")
                    )
                )
            end
        end
        ret
    end
    pl := lay_pseudo_prefix_len(name)
    if pl > 0:
        prest := lay_pseudo_rest_key(str.Substr(name, pl, str.Len(name) - pl))
        if str.Len(prest) > 0:
            at.SetName(a, attr, lay_pseudo_canon(name) + "_" + prest)
        end
    end
end

func lay_when_ok(a &: at.Ast, el: int, e: LayElem): bool:
    aid := lay_elem_attr(a, el, e.when_attr)
    if aid == 0:
        ret false
    end
    if str.Len(e.when_value) == 0:
        mut tv := ""
        if lay_attr_text(a, aid, tv):
            ret not str.Equals(tv, "false")
        end
        ret true
    end
    mut v := ""
    if not lay_attr_text(a, aid, v):
        ret false
    end
    if str.Equals(v, e.when_value):
        ret true
    end
    mv := i18.LayoutValue(v)
    ret str.Equals(mv, e.when_value) or str.Equals(lay_loose(mv), lay_loose(e.when_value))
end

func lay_context_score(a &: at.Ast, el: int, ei: int, stack: Vector<int>): int:
    e := g_lay_elems.Get(ei)
    mut score := 0
    n := stack.Len()
    if str.Len(e.parents) > 0:
        if n == 0 or not lay_list_has_elem(e.parents, stack.Get(n - 1)):
            ret 0 - 1
        end
        score++
    end
    if str.Len(e.path) > 0:
        mut parts := str.Split(e.path, ",")
        defer parts.Free()
        if parts.Len() > n:
            ret 0 - 1
        end
        repeat parts.Len() in k:
            si := stack.Get(n - 1 - k)
            if si < 0 or not str.Equals(g_lay_elems.Get(si).key, parts.Get(k)):
                ret 0 - 1
            end
        end
        score += parts.Len()
    end
    if str.Len(e.ancestors) > 0:
        mut found := false
        repeat n in j:
            if lay_list_has_elem(e.ancestors, stack.Get(j)):
                found = true
            end
        end
        if not found:
            ret 0 - 1
        end
        score++
    end
    if str.Len(e.when_attr) > 0:
        if not lay_when_ok(a, el, e):
            ret 0 - 1
        end
        score += 2
    end
    ret score
end

func lay_resolve_elem(a &: at.Ast, el: int, stack: Vector<int>): int:
    n := at.Get(a, el)
    if n.op > 0 and n.op <= g_lay_elems.Len():
        ret n.op - 1
    end
    mut cands := lay_elem_candidates(n.name)
    defer cands.Free()
    k := lay_elem_by_key(n.name)
    if k >= 0:
        mut seen := false
        repeat cands.Len() in i:
            if cands.Get(i) == k:
                seen = true
            end
        end
        if not seen:
            cands.Push(k)
        end
    end
    if cands.Len() == 0:
        ret 0 - 1
    end
    if cands.Len() == 1:
        ret cands.Get(0)
    end
    mut best := 0 - 1
    mut best_score := 0 - 1
    mut fallback := 0 - 1
    repeat cands.Len() in ci:
        c := cands.Get(ci)
        if fallback < 0 and not schema_has_context(g_lay_elems.Get(c)):
            fallback = c
        end
        sc := lay_context_score(a, el, c, stack)
        if sc > best_score:
            best = c
            best_score = sc
        end
    end
    if best >= 0:
        ret best
    end
    if fallback >= 0:
        ret fallback
    end
    ret cands.Get(0)
end

func lay_resolve_control(a &: at.Ast, nid: int, stack &: Vector<int>):
    n := at.Get(a, nid)
    lay_resolve_walk(a, n.b, stack)
    if n.kind == at.AST_IF and n.c != 0:
        if at.KindOf(a, n.c) == at.AST_IF:
            lay_resolve_control(a, n.c, stack)
        else:
            lay_resolve_walk(a, n.c, stack)
        end
    end
end

func lay_resolve_walk(a &: at.Ast, nid: int, stack &: Vector<int>):
    repeat at.ChildCount(a, nid) in i:
        cid := at.Child(a, nid, i)
        if at.KindOf(a, cid) == at.AST_LAYOUT_ATTR:
            lay_localize_attr(a, cid)
        end
    end
    repeat at.ChildCount(a, nid) in j:
        cid := at.Child(a, nid, j)
        ck := at.KindOf(a, cid)
        if ck == at.AST_IF or ck == at.AST_EACH:
            lay_resolve_control(a, cid, stack)
            continue
        end
        if ck != at.AST_LAYOUT_ELEMENT:
            continue
        end
        mut own_ids := Vector {} as Vector<int>
        mut own_names := Vector {} as Vector<str>
        repeat at.ChildCount(
            a, cid
        ) in m:
            gid := at.Child(a, cid, m)
            if at.KindOf(a, gid) == at.AST_LAYOUT_ATTR:
                own_ids.Push(gid)
                own_names.Push(at.Get(a, gid).name)
                lay_localize_attr(a, gid)
            end
        end
        ei := lay_resolve_elem(a, cid, stack)
        if ei >= 0:
            repeat own_ids.Len() in oi:
                ogid := own_ids.Get(oi)
                cur := at.Get(a, ogid).name
                orig := own_names.Get(oi)
                if str.Equals(cur, orig):
                    continue
                end
                at.SetName(a, ogid, orig)
                osa := ResolveStyleAttr(orig)
                if osa.ok and StyleAttrIsOwnEnum(a, ogid, ei, osa):
                    at.SetName(a, ogid, lay_attr_key_for(ei, orig))
                else:
                    at.SetName(a, ogid, cur)
                end
            end
            at.SetName(a, cid, g_lay_elems.Get(ei).key)
            at.SetOp(a, cid, ei + 1)
        end
        own_ids.Free()
        own_names.Free()
        stack.Push(ei)
        lay_resolve_walk(a, cid, stack)
        _p := stack.Pop()
    end
end

func layout_resolve(a &: at.Ast, lb: int):
    if lb == 0:
        ret
    end
    lay_ensure()
    mut stack := Vector {} as Vector<int>
    defer stack.Free()
    stack.Push(lay_elem_by_key("page"))
    lay_resolve_walk(a, lb, stack)
    // TODO(language): enforce Persian-only element/attribute keywords in Persian files and English-only in English files.
    // layout_resolve currently canonicalizes via aliases without file-language context and does not preserve original spellings,
    // so keyword-language rejection needs schema alias language metadata and/or original-name tracking.
end

func lay_has_sep(name: str): bool:
    ret str.IndexOf(name, "_") >= 0 or str.IndexOf(name, "-") >= 0
end

func lay_official_base(name: str): str:
    sa := ResolveStyleAttr(name)
    if sa.ok and sa.state == STYLE_STATE_BASE:
        ret style.PropName(sa.prop)
    end
    ret lay_attr_key_exact(name)
end

func lay_official_attr(name: str): str:
    if not lay_has_sep(name):
        ret ""
    end
    mut rest := ""
    st := style_state_prefix(name, rest)
    base := lay_official_base(rest)
    if str.Len(base) == 0:
        ret ""
    end
    states := [
        "", "hover ", "focus ", "focus within ", "active ", "disabled ", "checked ", "invalid ",
        "placeholder ", "selection "
    ]
    official := states[st] + base
    if lay_has_sep(official) or str.Equals(official, name) or not str.Contains(official, " "):
        ret ""
    end
    ret official
end

func lay_is_comp(name: str): bool:
    l := lay_loose(name)
    repeat g_lay_sp_comps.Len() in i:
        if str.Equals(g_lay_sp_comps.Get(i), name) or str.Equals(
            lay_loose(g_lay_sp_comps.Get(i)), l
        ):
            ret true
        end
    end
    ret false
end

func lay_official_elem(name: str): str:
    if not lay_has_sep(name) or lay_is_comp(name):
        ret ""
    end
    if lay_elem_lookup(name) < 0:
        ret ""
    end
    sp := lay_elem_spelling(name)
    if not str.Contains(sp, " "):
        ret ""
    end
    ret sp
end

func lay_source_is(a &: at.Ast, nid: int, path: str, text: str): bool:
    n := at.Get(a, nid)
    if str.Len(path) == 0 or n.end_index <= n.begin_index:
        ret false
    end
    if not str.Equals(path, g_style_src_path):
        g_style_src_path = path
        g_style_src_text = os.ReadFile(path)
    end
    b := n.begin_index as int
    nl := str.Len(text)
    if b < 0 or b + nl > str.Len(g_style_src_text):
        ret false
    end
    ret str.Equals(str.Substr(g_style_src_text, b, nl), text)
end

func lay_written_as(a &: at.Ast, nid: int, path: str): bool:
    ret lay_source_is(a, nid, path, at.Get(a, nid).name)
end

func lay_spelling_path(a &: at.Ast, nid: int): str:
    path := at.Get(a, nid).src_file
    if str.Len(path) == 0:
        ret g_lay_sp_path
    end
    ret path
end

func lay_spelling_first(a &: at.Ast, nid: int, path: str): bool:
    n := at.Get(a, nid)
    key := path + ":" + n.begin_line + ":" + n.begin_col
    repeat g_lay_sp_reported.Len() in i:
        if str.Equals(g_lay_sp_reported.Get(i), key):
            ret false
        end
    end
    g_lay_sp_reported.Push(key)
    ret true
end

func lay_spelling_report(a &: at.Ast, nid: int, official: str, verify: bool):
    n := at.Get(a, nid)
    mut path := n.src_file
    if str.Len(path) == 0:
        path = g_lay_sp_path
    end
    if verify and not lay_written_as(a, nid, path):
        ret
    end
    g_lay_sp_hit_node.Push(nid)
    g_lay_sp_hit_off.Push(official)
end

func lay_spelling_attr(a &: at.Ast, aid: int):
    name := at.Get(a, aid).name
    official := lay_official_attr(name)
    if str.Len(official) == 0:
        ret
    end
    path := lay_spelling_path(a, aid)
    if lay_source_is(a, aid, path, name):
        lay_spelling_report(a, aid, official, false)
        ret
    end
    mut rest := ""
    st := style_state_prefix(name, rest)
    if st != STYLE_STATE_BASE and lay_source_is(a, aid, path, rest):
        written := lay_official_attr(rest)
        if str.Len(written) > 0:
            lay_spelling_report(a, aid, written, false)
        end
    end
end

func lay_spelling_folded(a &: at.Ast, aid: int):
    repeat at.ChildCount(a, aid) in q:
        folded := at.Child(a, aid, q)
        if at.KindOf(a, folded) == at.AST_LAYOUT_ATTR:
            lay_spelling_attr(a, folded)
            lay_spelling_folded(a, folded)
        end
    end
end

func lay_spelling_walk(a &: at.Ast, nid: int, owner_official: bool):
    repeat at.ChildCount(a, nid) in i:
        cid := at.Child(a, nid, i)
        ck := at.KindOf(a, cid)
        if ck == at.AST_LAYOUT_ATTR:
            if owner_official:
                lay_spelling_attr(a, cid)
                lay_spelling_folded(a, cid)
            end
        else ck == at.AST_IF or ck == at.AST_EACH:
            lay_spelling_control(a, cid, owner_official)
        else ck == at.AST_LAYOUT_ELEMENT:
            nm := at.Get(a, cid).name
            official := lay_official_elem(nm)
            if str.Len(official) > 0:
                lay_spelling_report(a, cid, official, false)
            end
            lay_spelling_walk(a, cid, not lay_is_comp(nm) and lay_elem_lookup(nm) >= 0)
        end
    end
end

func lay_spelling_control(a &: at.Ast, nid: int, owner_official: bool):
    n := at.Get(a, nid)
    lay_spelling_walk(a, n.b, owner_official)
    if n.kind == at.AST_IF and n.c != 0:
        if at.KindOf(a, n.c) == at.AST_IF:
            lay_spelling_control(a, n.c, owner_official)
        else:
            lay_spelling_walk(a, n.c, owner_official)
        end
    end
end

func lay_collect_spelling(s &: Sema, a &: at.Ast, body: int):
    if body == 0:
        ret
    end
    g_lay_sp_comps.Clear()
    g_lay_sp_hit_node.Clear()
    g_lay_sp_hit_off.Clear()
    g_lay_sp_path = s.file
    if s.program != 0:
        repeat at.ChildCount(a, s.program) in pi:
            pid := at.Child(a, s.program, pi)
            if at.KindOf(a, pid) == at.AST_LAYOUT_COMPONENT:
                g_lay_sp_comps.Push(at.Get(a, pid).name)
            end
        end
    end
    each kn in g_lay_known_comps:
        g_lay_sp_comps.Push(kn)
    end
    lay_spelling_walk(a, body, true)
end

func lay_check_spelling(s &: Sema, a &: at.Ast, body: int):
    lay_collect_spelling(s, a, body)
    repeat g_lay_sp_hit_node.Len() in i:
        nid := g_lay_sp_hit_node.Get(i)
        n := at.Get(a, nid)
        mut path := n.src_file
        if str.Len(path) == 0:
            path = s.file
        end
        if FilePack(s, path) != 1:
            continue
        end
        if not lay_spelling_first(a, nid, path):
            continue
        end
        serr_help(
            s,
            235,
            span_of(a, nid),
            co.Format1(
                i18.Tr(
                    "'%s' is an official page name, and an English file writes it with spaces, not '_' or '-'"
                ),
                co.ArgStr(n.name)
            ),
            co.Format1(i18.Tr("write '%s'"), co.ArgStr(g_lay_sp_hit_off.Get(i)))
        )
    end
end

func lay_token_display(t: str): str:
    if str.Len(t) > 0 and byte_at(t, 0) == 35:
        ret t
    end
    ei := lay_elem_by_key(t)
    ret ei >= 0 ? lay_elem_display(ei) : t
end

func lay_list_display(csv: str, sep: str, reverse: bool): str:
    mut parts := str.Split(csv, ",")
    defer parts.Free()
    mut out := ""
    n := parts.Len()
    repeat n in i:
        t := parts.Get(reverse ? n - 1 - i : i)
        if str.Len(out) > 0:
            out += sep
        end
        out += lay_token_display(t)
    end
    ret out
end

func lay_effective_parent(stack: Vector<int>, from: int): int:
    mut i := from
    until i >= 0:
        pi := stack.Get(i)
        if pi < 0:
            ret 0 - 1
        end
        if not lay_csv_has(g_lay_elems.Get(pi).children, "#transparent"):
            ret pi
        end
        i--
    end
    ret 0 - 1
end

func lay_accepts_text(ei: int): bool:
    e := g_lay_elems.Get(ei)
    if e.kind == LK_VOID:
        ret false
    end
    if str.Len(e.children) == 0:
        ret true
    end
    ret lay_csv_has(e.children, "text") or lay_csv_has(
        e.children, "#phrasing"
    ) or lay_csv_has(e.children, "#flow") or lay_csv_has(
        e.children, "#transparent"
    )
end

func lay_check_placement(s &: Sema, a &: at.Ast, el: int, ei: int, ck &: LayCheck):
    e := g_lay_elems.Get(ei)
    stack := ck.stack
    n := stack.Len()
    parent := n > 0 ? stack.Get(n - 1) : 0 - 1
    if str.Len(e.parents) > 0 and parent >= 0 and not lay_list_has_elem(e.parents, parent):
        serr(
            s,
            4,
            span_of(a, el),
            co.Format2(
                i18.Tr("element '%s' cannot be placed inside '%s'"),
                co.ArgStr(lay_elem_display(ei)),
                co.ArgStr(lay_elem_display(parent))
            )
        )
        ret
    end
    if str.Len(e.path) > 0 and lay_context_score(a, el, ei, stack) < 0:
        serr(
            s,
            117,
            span_of(a, el),
            co.Format2(
                i18.Tr("element '%s' must be placed inside '%s'"),
                co.ArgStr(lay_elem_display(ei)),
                co.ArgStr(lay_list_display(e.path, " > ", true))
            )
        )
        ret
    end
    if str.Len(e.ancestors) > 0:
        mut found := false
        repeat n in j:
            if lay_list_has_elem(e.ancestors, stack.Get(j)):
                found = true
            end
        end
        if not found:
            serr(
                s,
                117,
                span_of(a, el),
                co.Format2(
                    i18.Tr("element '%s' must be placed inside '%s'"),
                    co.ArgStr(lay_elem_display(ei)),
                    co.ArgStr(lay_list_display(e.ancestors, "' or '", false))
                )
            )
            ret
        end
    end
    if parent < 0:
        ret
    end
    pe := g_lay_elems.Get(parent)
    if pe.kind == LK_VOID or pe.kind == LK_RAW:
        serr(
            s,
            118,
            span_of(a, el),
            co.Format2(
                i18.Tr("element '%s' cannot contain child elements such as '%s'"),
                co.ArgStr(lay_elem_display(parent)),
                co.ArgStr(lay_elem_display(ei))
            )
        )
        ret
    end
    repeat n in d:
        outer := stack.Get(d)
        if outer >= 0 and lay_list_has_elem(g_lay_elems.Get(outer).forbidden_desc, ei):
            serr(
                s,
                116,
                span_of(a, el),
                co.Format2(
                    i18.Tr("element '%s' cannot appear anywhere inside '%s'"),
                    co.ArgStr(lay_elem_display(ei)),
                    co.ArgStr(lay_elem_display(outer))
                )
            )
            ret
        end
    end
    if e.kind == LK_VIRTUAL:
        ret
    end
    if lay_list_has_elem(pe.forbidden, ei):
        serr(
            s,
            115,
            span_of(a, el),
            co.Format2(
                i18.Tr("element '%s' is not allowed directly inside '%s'"),
                co.ArgStr(lay_elem_display(ei)),
                co.ArgStr(lay_elem_display(parent))
            )
        )
        ret
    end
    if lay_list_has_elem(pe.children, ei):
        ret
    end
    eff := lay_effective_parent(stack, n - 1)
    if eff < 0:
        ret
    end
    ee := g_lay_elems.Get(eff)
    if eff != parent and lay_list_has_elem(ee.forbidden, ei):
        serr(
            s,
            115,
            span_of(a, el),
            co.Format2(
                i18.Tr("element '%s' is not allowed directly inside '%s'"),
                co.ArgStr(lay_elem_display(ei)),
                co.ArgStr(lay_elem_display(eff))
            )
        )
        ret
    end
    if str.Len(ee.children) > 0 and not lay_list_has_elem(ee.children, ei):
        serr(
            s,
            115,
            span_of(a, el),
            co.Format2(
                i18.Tr("element '%s' is not allowed directly inside '%s'"),
                co.ArgStr(lay_elem_display(ei)),
                co.ArgStr(lay_elem_display(eff))
            )
        )
    end
end

func lay_attr_value_is_quoted_string(a &: at.Ast, aid: int): bool:
    vid := at.Get(a, aid).a
    if vid == 0:
        ret false
    end
    v := at.Get(a, vid)
    ret v.kind == at.AST_LITERAL and v.value_kind == tok.TV_STRING and not v.synthetic
end

func lay_size_token(t: str): bool:
    ret css_is_dim(
        t, css_length_units()
    ) or css_is_dim(t, "%") or (lay_is_float(t) and not str.Equals(t, ""))
end

func lay_quoted_size(text: str): bool:
    vt := str.Trim(text)
    if lay_size_token(vt):
        ret true
    end
    mut parts := str.Fields(vt)
    defer parts.Free()
    repeat parts.Len() in qi:
        if lay_size_token(str.Trim(parts.Get(qi))):
            ret true
        end
    end
    ret false
end

func lay_has_empty_fallback(a &: at.Ast, nid: int): bool:
    if nid != 0 and at.KindOf(a, nid) == at.AST_LITERAL:
        w := at.Get(a, nid)
        ret w.synthetic and w.value_kind == tok.TV_STRING and str.Len(w.value_str) == 0
    end
    if nid == 0 or at.KindOf(a, nid) != at.AST_TERNARY:
        ret false
    end
    n := at.Get(a, nid)
    if n.c != 0 and at.KindOf(a, n.c) == at.AST_LITERAL:
        l := at.Get(a, n.c)
        if l.synthetic and l.value_kind == tok.TV_STRING and str.Len(l.value_str) == 0:
            ret true
        end
    end
    ret lay_has_empty_fallback(a, n.b) or lay_has_empty_fallback(a, n.c)
end

func lay_text_branch(s &: Sema, a &: at.Ast, nid: int): int:
    if nid == 0:
        ret nid
    end
    n := at.Get(a, nid)
    if n.kind == at.AST_TERNARY:
        mut m := n
        m.b = lay_text_branch(s, a, n.b)
        m.c = lay_text_branch(s, a, n.c)
        at.Put(a, nid, m)
        ret nid
    end
    if n.kind == at.AST_IDENTIFIER and scope_lookup(
        s, s.cur, n.name
    ) <= 0 and lay_const_sym(s, n.name) == 0:
        ret lay_mk_literal(a, nid, LayVal { kind = LV_STR, s = n.name })
    end
    if n.kind == at.AST_LITERAL and n.op == tok.TK_INT:
        ret lay_mk_literal(
            a, nid, LayVal { kind = LV_STR, s = co.U64Toa(n.value_int) + LayoutNumUnit(n.name) }
        )
    end
    if n.kind == at.AST_LITERAL and n.op == tok.TK_FLOAT:
        ret lay_mk_literal(
            a,
            nid,
            LayVal {
                kind = LV_STR,
                s = co.Format1("%g", co.ArgFloat(n.value_float)) + LayoutNumUnit(n.name)
            }
        )
    end
    ret nid
end

func lay_check_style_attr(
    s &: Sema, a &: at.Ast, aid: int, _ei: int, name: str, sa: StyleAttr, runtime: bool
): bool:
    mut vid := at.Get(a, aid).a
    if vid == 0:
        ret false
    end
    if lay_has_empty_fallback(a, vid):
        vid = lay_text_branch(s, a, vid)
    end
    v := at.Get(a, vid)
    quoted := lay_attr_value_is_quoted_string(a, aid)
    mut numtext := ""
    mut skipfold := false
    empty_fallback := lay_has_empty_fallback(a, vid)
    src_marks := StyleSourceHasFaMarks(a, vid)
    if lay_native_target():
        if v.kind == at.AST_IDENTIFIER and lay_const_sym(s, v.name) != 0:
            ret false
        end
        if lay_list_runtime(s, a, vid) != 0:
            ret false
        end
    else:
        if v.kind == at.AST_LITERAL and v.value_kind == tok.TV_STRING and
            StyleTextIsRuntime(v.value_str):
            style_attr_remember_dyn(a, aid, sa.prop, sa.state)
            ret true
        end
        if lay_list_runtime(s, a, vid) != 0:
            if runtime:
                style_attr_remember_dyn(a, aid, sa.prop, sa.state)
            else:
                _folded := lay_fold_attr(s, a, aid, 0 - 1, false)
            end
            ret true
        end
        if StyleNumText(a, vid, numtext):
            skipfold = true
        end
        if not skipfold and
            not (v.kind == at.AST_BINARY and (v.op == tok.TK_PLUS or v.op == tok.TK_MINUS) and
                (style.Info(sa.prop).items & 2) != 0 and not lay_has_string(a, vid, 0)):
            if not lay_fold_attr(s, a, aid, 0 - 1, runtime):
                ret true
            end
            vid = at.Get(a, aid).a
        end
    end
    mut text := StyleAttrTextFor(a, vid, sa.prop)
    if skipfold:
        text = numtext
    end
    if str.Len(text) == 0 and empty_fallback:
        ret true
    end
    if lay_native_target() and str.IndexOf(text, char_from_code(2)) >= 0:
        ret true
    end
    if quoted and lay_quoted_size(text):
        serr(
            s,
            18,
            span_of(a, aid),
            co.Format2(
                i18.Tr("invalid value for '%s': write the size %s without quotes"),
                co.ArgStr(lay_attr_display(name)),
                co.ArgStr(text)
            )
        )
        ret true
    end
    if FilePack(s, at.Get(a, aid).src_file) != 2 and (src_marks or StyleTextHasFaMarks(text)):
        serr(
            s,
            18,
            span_of(a, vid),
            co.Format3(
                i18.Tr("invalid value for '%s': '%s' is not %s"),
                co.ArgStr(name),
                co.ArgStr(text),
                co.ArgStr(
                    i18.Tr(
                        "a value written with English digits and marks (this is an English file)"
                    )
                )
            )
        )
        ret true
    end
    mut val := style.Value {}
    if not style.Parse(sa.prop, text, val):
        serr(
            s,
            18,
            span_of(a, vid),
            co.Format3(
                i18.Tr("invalid value for '%s': '%s' is not %s"),
                co.ArgStr(name),
                co.ArgStr(text),
                co.ArgStr(style.Error(sa.prop, text))
            )
        )
        ret true
    end
    lit := lay_mk_literal(a, vid, LayVal { kind = LV_STR, s = text })
    mut an := at.Get(a, aid)
    an.a = lit
    at.Put(a, aid, an)
    style_attr_remember(a, aid, sa.prop, sa.state, style.Css(sa.prop, val))
    ret true
end

func lay_warn_not_standard(s &: Sema, a &: at.Ast, aid: int, key: str):
    mut v := ""
    if not lay_attr_text(a, aid, v):
        ret
    end
    hint := StyleStandardHint(key, i18.LayoutValue(v))
    mut msg := ""
    if str.Len(hint) > 0:
        msg = co.Format2(
            i18.Tr("'%s' is not part of the Salam style standard; use '%s' instead"),
            co.ArgStr(key),
            co.ArgStr(hint)
        )
    else:
        msg = co.Format1(i18.Tr("'%s' is not part of the Salam style standard"), co.ArgStr(key))
    end
    if lay_native_target():
        serr(s, UI_STANDARD_ERROR_CODE, span_of(a, aid), msg)
    else:
        swarn(s, UI_STANDARD_WARN_CODE, span_of(a, aid), msg)
    end
end

func lay_source_slice(a &: at.Ast, nid: int, path: str): str:
    n := at.Get(a, nid)
    if str.Len(path) == 0 or n.end_index <= n.begin_index:
        ret ""
    end
    if not lay_source_is(a, nid, path, ""):
        ret ""
    end
    b := n.begin_index as int
    e := n.end_index as int
    if b < 0 or e > str.Len(g_style_src_text):
        ret ""
    end
    ret str.Substr(g_style_src_text, b, e - b)
end

func lay_bare_value_report(s &: Sema, a &: at.Ast, nid: int, word: str):
    n := at.Get(a, nid)
    path := n.src_file
    seen_key := path + ":" + str.FromInt(n.begin_index as i64)
    if g_lay_bare_seen.Has(seen_key):
        ret
    end
    g_lay_bare_seen.Put(seen_key, true)
    slice := lay_source_slice(a, nid, path)
    mut quoted := `"` + word + `"`
    if str.Len(slice) > 0 and str.IndexOf(slice, "\"") < 0 and str.IndexOf(slice, "\n") < 0 and
        str.IndexOf(slice, ",") < 0:
        quoted = `"` + slice + `"`
        mut f := fix_at(span_of(a, nid))
        f.file = path
        f.length = str.Len(slice)
        f.title = i18.Tr("Write the value in quotes")
        f.text = quoted
        f.preferred = true
        f.safe = true
        queue_fix(f)
    end
    msg := co.Format1(
        i18.Tr("the word '%s' is a value, not a name; write it in quotes"), co.ArgStr(word)
    )
    help := co.Format1(i18.Tr("write %s"), co.ArgStr(quoted))
    if lay_strict_values(s):
        serr_help(s, LAYOUT_BARE_VALUE_CODE, span_of(a, nid), msg, help)
    else:
        swarn_help(s, LAYOUT_BARE_VALUE_CODE, span_of(a, nid), msg, help)
    end
end

func lay_strict_values(s &: Sema): bool:
    if g_sm_strict_values:
        ret true
    end
    dir := pth.PathDir(s.file)
    repeat g_sm_strict_dirs.Len() in i:
        if str.Equals(g_sm_strict_dirs.Get(i), dir):
            ret g_sm_strict_ans.Get(i)
        end
    end
    root := pm.FindProjectRoot(dir)
    enabled := str.Len(root) > 0 and pm.ReadBoolSetting(root, "build", "strict-values")
    g_sm_strict_dirs.Push(dir)
    g_sm_strict_ans.Push(enabled)
    ret enabled
end

func lay_collect_locals(a &: at.Ast, nid: int):
    repeat at.ChildCount(a, nid) in i:
        cid := at.Child(a, nid, i)
        k := at.KindOf(a, cid)
        if k == at.AST_VAR_DECL:
            g_lay_locals.Push(at.Get(a, cid).name)
        else k == at.AST_LAYOUT_ELEMENT:
            lay_collect_locals(a, cid)
        else k == at.AST_EACH:
            en := at.Get(a, cid)
            if str.Len(en.name) > 0:
                g_lay_locals.Push(en.name)
            end
            if en.c != 0:
                g_lay_locals.Push(at.Get(a, en.c).name)
            end
            lay_collect_locals(a, en.b)
        else k == at.AST_IF:
            n := at.Get(a, cid)
            lay_collect_locals(a, n.b)
            if n.c != 0:
                lay_collect_locals(a, n.c)
            end
        end
    end
end

func lay_is_local(name: str): bool:
    each l in g_lay_locals:
        if str.Equals(l, name):
            ret true
        end
    end
    ret false
end

func lay_bare_value_walk(s &: Sema, a &: at.Ast, nid: int):
    if nid == 0:
        ret
    end
    n := at.Get(a, nid)
    if n.kind == at.AST_IDENTIFIER:
        if scope_lookup(s, s.cur, n.name) <= 0 and not lay_is_local(n.name):
            lay_bare_value_report(s, a, nid, n.name)
        end
        ret
    end
    if n.kind == at.AST_LITERAL:
        if n.value_kind == tok.TV_STRING and not n.synthetic and str.StartsWith(
            n.value_str, "#"
        ) and str.Len(n.src_file) > 0 and lay_source_is(a, nid, n.src_file, n.value_str):
            lay_bare_value_report(s, a, nid, n.value_str)
        end
        ret
    end
    if n.kind == at.AST_TUPLE or n.kind == at.AST_ARRAY_LIT:
        repeat at.ChildCount(a, nid) in i:
            lay_bare_value_walk(s, a, at.Child(a, nid, i))
        end
        ret
    end
    if n.kind == at.AST_TERNARY:
        lay_bare_value_walk(s, a, n.b)
        lay_bare_value_walk(s, a, n.c)
    end
end

func lay_null_attr(s &: Sema, a &: at.Ast, aid: int, ei: int, name: str): bool:
    vid := at.Get(a, aid).a
    if vid == 0 or at.KindOf(a, vid) != at.AST_LITERAL or at.Get(a, vid).op != tok.TK_KW_NULL:
        ret false
    end
    mut key := lay_attr_key_for(ei, name)
    if str.Len(key) == 0:
        key = name
    end
    if ei >= 0 and lay_csv_has(g_lay_elems.Get(ei).required, key):
        serr_help(
            s,
            300,
            span_of(a, vid),
            co.Format2(
                i18.Tr("'%s' on '%s' is required and cannot be null"),
                co.ArgStr(lay_attr_display(key)),
                co.ArgStr(lay_elem_display(ei))
            ),
            i18.Tr(
                "give it a value: '.UnwrapOr(default)', '.Unwrap()', or use '.value' inside 'if x.IsSome():'"
            )
        )
        ret true
    end
    if not ResolveStyleAttr(name).ok and lay_attr_for(ei, key) < 0 and
        lay_pseudo_prefix_len(name) == 0:
        ret false
    end
    lit := lay_mk_literal(a, vid, LayVal { kind = LV_STR, s = "" })
    mut ln := at.Get(a, lit)
    ln.synthetic = true
    at.Put(a, lit, ln)
    mut an := at.Get(a, aid)
    an.a = lit
    at.Put(a, aid, an)
    ret true
end

func lay_check_attrs(s &: Sema, a &: at.Ast, el: int, ei: int, ck &: LayCheck):
    e := g_lay_elems.Get(ei)
    mut seen := Vector {} as Vector<str>
    defer seen.Free()
    mut decls := Vector {} as Vector<str>
    defer decls.Free()
    mut klass := ""
    mut klass_node := 0
    mut has_text := false
    repeat at.ChildCount(a, el) in i:
        aid := at.Child(a, el, i)
        if at.KindOf(a, aid) != at.AST_LAYOUT_ATTR:
            continue
        end
        name := at.Get(a, aid).name
        if str.Len(name) == 0:
            continue
        end
        mut dkey := name
        dsa := ResolveStyleAttr(name)
        if dsa.ok:
            dkey = "style " + str.FromInt(dsa.state as i64) + " " + str.FromInt(dsa.prop as i64)
        end
        mut dup := false
        repeat seen.Len() in k:
            if str.Equals(seen.Get(k), dkey):
                dup = true
            end
        end
        if dup:
            serr(
                s,
                114,
                span_of(a, aid),
                co.Format2(
                    i18.Tr("duplicate attribute '%s' on '%s'"),
                    co.ArgStr(lay_attr_display(name)),
                    co.ArgStr(lay_elem_display(ei))
                )
            )
            continue
        end
        seen.Push(dkey)
        if lay_null_attr(s, a, aid, ei, name):
            continue
        end
        if not lay_is_handler(name) and not StyleAttrIsEvent(a, aid):
            lay_bare_value_walk(s, a, at.Get(a, aid).a)
        end
        if lay_is_handler(name) and str.Len(
            str.Trim(
                str.Substr(
                    name, lay_handler_prefix_len(name), str.Len(name) - lay_handler_prefix_len(name)
                )
            )
        ) == 0:
            serr(s, 18, span_of(a, aid), i18.Tr("event handler name is missing the event"))
            continue
        end
        sa := ResolveStyleAttr(name)
        if sa.ok and not StyleAttrIsEvent(a, aid) and not StyleAttrIsIntrinsicSize(
            a, aid, ei, sa
        ) and not StyleAttrIsOwnEnum(a, aid, ei, sa) and lay_check_style_attr(
            s, a, aid, ei, name, sa, ck.runtime
        ):
            if str.Len(StyleAttrCss(a, aid)) > 0:
                decls.Push(name + "=" + StyleAttrCss(a, aid))
            end
            continue
        end
        mut key := lay_attr_key_for(ei, name)
        if str.Len(key) == 0:
            key = name
        end
        pl := lay_pseudo_prefix_len(name)
        mut ai := lay_attr_for(ei, key)
        mut pseudo_content := false
        if ai < 0 and pl > 0:
            key = str.Substr(name, pl, str.Len(name) - pl)
            if str.Equals(key, "content"):
                pseudo_content = true
            else:
                ai = lay_attr_for(ei, key)
                if ai >= 0 and g_lay_attrs.Get(ai).dest != LA_CSS:
                    ai = 0 - 1
                end
            end
        end
        if pseudo_content:
            if not e.styled:
                serr(
                    s,
                    113,
                    span_of(a, aid),
                    co.Format2(
                        i18.Tr("attribute '%s' is not allowed on '%s'"),
                        co.ArgStr(name),
                        co.ArgStr(lay_elem_display(ei))
                    )
                )
            else:
                mut pv := ""
                if lay_attr_text(a, aid, pv):
                    decls.Push(name + "=" + pv)
                end
            end
            continue
        end
        if ai < 0:
            if lay_attr_known(key):
                serr(
                    s,
                    113,
                    span_of(a, aid),
                    co.Format2(
                        i18.Tr("attribute '%s' is not allowed on '%s'"),
                        co.ArgStr(lay_attr_display(key)),
                        co.ArgStr(lay_elem_display(ei))
                    )
                )
            else:
                mut cands := lay_attr_names_for(ei)
                hint := lay_suggest_from(name, cands)
                cands.Free()
                serr(
                    s,
                    112,
                    span_of(a, aid),
                    co.Format3(
                        i18.Tr("unknown attribute '%s' on '%s'%s"),
                        co.ArgStr(name),
                        co.ArgStr(lay_elem_display(ei)),
                        co.ArgStr(hint)
                    )
                )
            end
            continue
        end
        av := g_lay_attrs.Get(ai)
        lay_check_native_attr(s, a, aid, ai, key)
        if av.dest == LA_CSS or (av.dest == LA_HTML_OR_CSS and style.PropByName(key) < 0):
            lay_warn_not_standard(s, a, aid, key)
        end
        if (av.dest == LA_CSS or pl > 0) and not e.styled:
            serr(
                s,
                113,
                span_of(a, aid),
                co.Format2(
                    i18.Tr("attribute '%s' is not allowed on '%s'"),
                    co.ArgStr(lay_attr_display(name)),
                    co.ArgStr(lay_elem_display(ei))
                )
            )
            continue
        end
        if av.dest == LA_CONTENT:
            has_text = true
        end
        if av.vtype == VT_CODE and not lay_check_event_attr(s, a, aid, name):
            continue
        end
        if not lay_fold_attr(s, a, aid, ai, ck.runtime):
            continue
        end
        if str.Equals(e.key, "heading") and str.Equals(key, "size") and at.KindOf(
            a, at.Get(a, aid).a
        ) != at.AST_LITERAL:
            serr(
                s,
                132,
                span_of(a, aid),
                co.Format2(
                    i18.Tr(
                        "'%s' on '%s' must be known at compile time; choose between fixed values with 'if' instead"
                    ),
                    co.ArgStr(lay_attr_display(key)),
                    co.ArgStr(lay_elem_display(ei))
                )
            )
            continue
        end
        mut v := ""
        if not lay_attr_text(a, aid, v):
            continue
        end
        if str.IndexOf(v, char_from_code(2)) >= 0:
            if str.IndexOf(v, "salam-bad-") >= 0 or
                (str.Equals(e.key, "heading") and str.Equals(key, "size")):
                serr(
                    s,
                    132,
                    span_of(a, aid),
                    co.Format2(
                        i18.Tr(
                            "'%s' on '%s' must be known at compile time; choose between fixed values with 'if' instead"
                        ),
                        co.ArgStr(lay_attr_display(key)),
                        co.ArgStr(lay_elem_display(ei))
                    )
                )
            else str.Equals(key, "id") and ck.in_each > 0:
                ck.ids.Push(v)
            end
            continue
        end
        if str.Equals(key, "id") and ck.in_each > 0:
            serr(
                s,
                134,
                span_of(a, aid),
                co.Format2(
                    i18.Tr(
                        "element '%s' inside 'each' has the fixed id '%s', which would repeat; build the id from the item instead"
                    ),
                    co.ArgStr(lay_elem_display(ei)),
                    co.ArgStr(v)
                )
            )
            continue
        end
        if (av.vtype == VT_URL or av.vtype == VT_ABS_URL) and lay_url_runs_code(v):
            serr(
                s,
                18,
                span_of(a, aid),
                co.Format2(
                    i18.Tr(
                        "invalid value for '%s': '%s' could run code; use an http, https, mailto, tel or relative address"
                    ),
                    co.ArgStr(lay_attr_display(key)),
                    co.ArgStr(v)
                )
            )
            continue
        end
        if (av.dest == LA_CSS or av.dest == LA_HTML_OR_CSS) and not lay_css_value_safe(v):
            serr(
                s,
                18,
                span_of(a, aid),
                co.Format3(
                    i18.Tr("invalid value for '%s': '%s' is not %s"),
                    co.ArgStr(lay_attr_display(key)),
                    co.ArgStr(v),
                    co.ArgStr(i18.Tr("a CSS value (no '{', '}', ';', '<', '>' or line breaks)"))
                )
            )
            continue
        end
        if lay_attr_value_is_quoted_string(a, aid):
            mut quoted_size := av.vtype == VT_LENGTH or av.vtype == VT_ULENGTH
            // keep check below; percentages/bare tokens may be quoted if needed syntactically
            if quoted_size:
                mut parts := str.Fields(v)
                defer parts.Free()
                if parts.Len() == 1:
                    qt := str.Trim(parts.Get(0))
                    if not (css_is_dim(qt, css_length_units()) or lay_is_float(qt)):
                        quoted_size = false
                    end
                else:
                    quoted_size = false
                end
            end
            if not quoted_size and av.vtype == VT_CSS:
                mut parts := str.Fields(v)
                defer parts.Free()
                if parts.Len() == 1:
                    qt := str.Trim(parts.Get(0))
                    if css_is_dim(qt, css_length_units()) or lay_is_float(qt):
                        quoted_size = true
                    end
                end
            end
            if quoted_size:
                serr(
                    s,
                    18,
                    span_of(a, aid),
                    co.Format2(
                        i18.Tr("invalid value for '%s': write the size %s without quotes"),
                        co.ArgStr(lay_attr_display(key)),
                        co.ArgStr(v)
                    )
                )
                continue
            end
        end
        is_fa_layout := FilePack(s, at.Get(a, aid).src_file) == 2
        g_lay_css_en_only = not is_fa_layout
        g_lay_val_fa_only = is_fa_layout
        value_ok := lay_attr_value_ok(ai, v)
        g_lay_css_en_only = false
        g_lay_val_fa_only = false
        // TODO(language): reject layout attribute/element keywords (names) written in the wrong language for the file.
        // Value-language checks above cover dynamic/registered values; full keyword enforcement needs original spellings
        // and alias-language metadata through resolve/check paths. Also ensure style-resolved/gui.style parsing paths
        // honor file-language restrictions where applicable.
        if not value_ok:
            mut vhint := ""
            if av.vtype == VT_ENUM or av.vtype == VT_BOOL_ENUM or av.vtype == VT_DIR or
                av.vtype == VT_LANG:
                vcands := lay_value_candidates(av.vtype, av.allowed)
                vhint = lay_suggest_from(v, vcands)
                vcands.Free()
            end
            serr(
                s,
                18,
                span_of(a, aid),
                co.Format4(
                    i18.Tr("invalid value for '%s': '%s' is not %s%s"),
                    co.ArgStr(lay_attr_display(key)),
                    co.ArgStr(v),
                    co.ArgStr(
                        av.vtype == VT_CSS ? lay_css_describe(
                            av.allowed
                        ) : lay_value_type_name(av.vtype)
                    ),
                    co.ArgStr(vhint)
                )
            )
            continue
        end
        if av.open and av.vtype == VT_ENUM and str.Equals(key, "type") and str.Len(
            lay_dyn_value(av.allowed, v)
        ) == 0:
            near := lay_open_enum_typo(av.allowed, v)
            if str.Len(near) > 0:
                swarn_help(
                    s,
                    LAYOUT_TYPE_TYPO_CODE,
                    span_of(a, aid),
                    co.Format1(i18.Tr("'%s' is not a known input type"), co.ArgStr(v)),
                    co.Format1(i18.Tr("did you mean type = \"%s\"?"), co.ArgStr(near))
                )
            end
        end
        if av.dest == LA_CONTENT and lay_raw_text_escapes(e, v):
            serr(
                s,
                18,
                span_of(a, aid),
                co.Format1(
                    i18.Tr(
                        "the body of '%s' cannot contain '</style' or '</script': it would end the element early"
                    ),
                    co.ArgStr(lay_elem_display(ei))
                )
            )
            continue
        end
        if av.dest == LA_CLASS:
            klass = v
            klass_node = aid
        else pl > 0 or av.dest == LA_CSS or (av.dest == LA_HTML_OR_CSS and not lay_all_digits(v)):
            decls.Push(name + "=" + v)
        end
        if str.Equals(key, "id"):
            mut dupid := false
            repeat ck.ids.Len() in q:
                if str.Equals(ck.ids.Get(q), v):
                    dupid = true
                end
            end
            if dupid:
                serr(
                    s, 122, span_of(a, aid), co.Format1(i18.Tr("duplicate id '%s'"), co.ArgStr(v))
                )
            else:
                ck.ids.Push(v)
                if not ck.runtime:
                    s.layout_ids.Push(v)
                end
            end
        end
        if av.vtype == VT_IDREF:
            mut refs := str.Fields(v)
            repeat refs.Len() in r:
                ck.ref_vals.Push(refs.Get(r))
                ck.ref_nodes.Push(aid)
                ck.ref_names.Push(lay_attr_display(key))
            end
            refs.Free()
        end
    end
    if str.Len(klass) > 0 and decls.Len() > 0 and not str.Equals(
        e.generator, "media"
    ) and not str.Equals(
        e.generator, "global"
    ):
        lay_check_class_styles(s, a, el, ei, klass, klass_node, decls, ck)
    end
    if has_text and not lay_accepts_text(ei):
        serr(
            s,
            119,
            span_of(a, el),
            co.Format1(
                i18.Tr("element '%s' cannot contain text"), co.ArgStr(lay_elem_display(ei))
            )
        )
    end
    if str.Len(e.required) == 0:
        ret
    end
    mut req := str.Split(e.required, ",")
    defer req.Free()
    repeat req.Len() in ri:
        piece := req.Get(ri)
        if str.Len(piece) == 0 or lay_elem_attr(a, el, piece) != 0:
            continue
        end
        shown := lay_attr_display(piece)
        serr(
            s,
            5,
            span_of(a, el),
            co.Format3(
                i18.Tr("element '%s' is missing required attribute '%.*s'"),
                co.ArgStr(lay_elem_display(ei)),
                co.ArgInt(str.Len(shown) as i64),
                co.ArgStr(shown)
            )
        )
    end
end

func lay_style_sig(decls &: Vector<str>): str:
    mut items := Vector {} as Vector<str>
    defer items.Free()
    n := decls.Len()
    repeat n in i:
        items.Push(decls.Get(i))
    end
    repeat n in i:
        mut j := i
        until j > 0 and str.Compare(items.Get(j - 1), items.Get(j)) > 0:
            tmp := items.Get(j)
            items.Set(j, items.Get(j - 1))
            items.Set(j - 1, tmp)
            j--
        end
    end
    mut out := ""
    repeat n in k:
        out += items.Get(k) + char_from_code(31)
    end
    ret out
end

func lay_check_class_styles(
    s &: Sema,
    a &: at.Ast,
    el: int,
    ei: int,
    klass: str,
    klass_node: int,
    decls &: Vector<str>,
    ck &: LayCheck
):
    sig := lay_style_sig(decls)
    repeat ck.cls_names.Len() in i:
        if not str.Equals(ck.cls_names.Get(i), klass):
            continue
        end
        if str.Equals(ck.cls_sigs.Get(i), sig):
            ret
        end
        other := ck.cls_nodes.Get(i)
        serr_help(
            s,
            136,
            span_of(a, klass_node),
            co.Format4(
                i18.Tr(
                    "class '%s' on '%s' has different styles from the '%s' at line %d that uses the same class; give one of them its own class or make their styles the same"
                ),
                co.ArgStr(klass),
                co.ArgStr(lay_elem_display(ei)),
                co.ArgStr(lay_elem_display(at.Get(a, other).op - 1)),
                co.ArgInt(span_of(a, other).begin.line as i64)
            ),
            i18.Tr(
                "in a component used more than once, remove 'class' so each element gets its own generated class"
            )
        )
        ret
    end
    ck.cls_names.Push(klass)
    ck.cls_sigs.Push(sig)
    ck.cls_nodes.Push(el)
end

func lay_check_repeat(s &: Sema, a &: at.Ast, element: int, shown: str):
    if lay_elem_attr(a, element, "repeat") == 0:
        ret
    end
    if lay_elem_attr(a, element, "id") != 0:
        serr(
            s,
            19,
            span_of(a, element),
            co.Format1(
                i18.Tr("element '%s' cannot use 'repeat' together with 'id'"), co.ArgStr(shown)
            )
        )
    else lay_subtree_has_id(a, element):
        serr(
            s,
            19,
            span_of(a, element),
            co.Format1(
                i18.Tr("element '%s' has 'repeat' but a nested element has an 'id'"),
                co.ArgStr(shown)
            )
        )
    end
end

func lay_is_component(ck: LayCheck, name: str): bool:
    repeat ck.comps.Len() in i:
        if su_ident_eq(ck.comps.Get(i), name):
            ret true
        end
    end
    ret false
end

func lay_handler_prefix_len(name: str): int:
    if str.StartsWith(name, "on ") and str.Len(name) > 3:
        ret 3
    end
    fa := "هنگام"
    n := str.Len(fa)
    if str.StartsWith(name, fa) and str.Len(name) > n + 1:
        if byte_at(name, n) == 32:
            ret n + 1
        end
        if str.Len(name) > n + 3 and byte_at(name, n) == 226 and byte_at(name, n + 1) == 128 and
            byte_at(name, n + 2) == 140:
            ret n + 3
        end
    end
    ret 0
end

func lay_is_handler(name: str): bool:
    ret lay_handler_prefix_len(name) > 0
end

func lay_state_name(name: str): bool:
    mut rest := ""
    st := style_state_prefix(name + " x", rest)
    ret st != STYLE_STATE_BASE and str.Equals(rest, "x")
end

func lay_check_state_block(s &: Sema, a &: at.Ast, nid: int, name: str): bool:
    mut rest := ""
    if not lay_state_name(name):
        ret false
    end
    mut holds := true
    repeat at.ChildCount(a, nid) in i:
        cid := at.Child(a, nid, i)
        k := at.KindOf(a, cid)
        mut inner := ""
        if k == at.AST_LAYOUT_ELEMENT:
            if style_state_prefix(at.Get(a, cid).name + " x", rest) != STYLE_STATE_BASE:
                inner = at.Get(a, cid).name
            end
        else k == at.AST_LAYOUT_ATTR:
            mut r2 := ""
            an := at.Get(a, cid).name
            if style_state_prefix(an, r2) != STYLE_STATE_BASE:
                inner = str.Replace(str.Substr(an, 0, str.Len(an) - str.Len(r2) - 1), "_", " ")
            end
        end
        if str.Len(inner) > 0:
            serr(
                s,
                231,
                span_of(a, cid),
                co.Format2(
                    i18.Tr(
                        "state blocks cannot be nested: '%s' inside '%s'; write the state prefix on each attribute instead"
                    ),
                    co.ArgStr(inner),
                    co.ArgStr(name)
                )
            )
        else k != at.AST_LAYOUT_ATTR and holds:
            holds = false
            serr(
                s,
                230,
                span_of(a, cid),
                co.Format1(
                    i18.Tr(
                        "a '%s' block holds style attributes only; move elements and conditions out of it"
                    ),
                    co.ArgStr(name)
                )
            )
        end
    end
    ret true
end

func lay_check_children(s &: Sema, a &: at.Ast, nid: int, ck &: LayCheck):
    mut sib := Vector {} as Vector<int>
    defer sib.Free()
    repeat at.ChildCount(a, nid) in i:
        cid := at.Child(a, nid, i)
        ckind := at.KindOf(a, cid)
        if ckind == at.AST_IF or ckind == at.AST_EACH:
            lay_check_control(s, a, cid, ck)
            continue
        end
        if ckind != at.AST_LAYOUT_ELEMENT:
            continue
        end
        cn := at.Get(a, cid)
        if not lay_is_component(ck, cn.name) and lay_check_state_block(s, a, cid, cn.name):
            continue
        end
        if lay_is_component(ck, cn.name):
            ck.stack.Push(0 - 1)
            lay_check_children(s, a, cid, ck)
            _pc := ck.stack.Pop()
            continue
        end
        ei := cn.op - 1
        if ei < 0:
            if ck.unexpanded:
                swarn(
                    s,
                    2,
                    span_of(a, cid),
                    co.Format1(
                        i18.Tr("unrecognized layout element '%s' (ignored)"), co.ArgStr(cn.name)
                    )
                )
            else:
                lay_report_unknown(s, a, cid, cn.name)
            end
            ck.stack.Push(0 - 1)
            lay_check_children(s, a, cid, ck)
            _pu := ck.stack.Pop()
            continue
        end
        e := g_lay_elems.Get(ei)
        if str.Equals(e.key, "text area"):
            swarn_help(
                s,
                LAYOUT_TEXTAREA_CODE,
                span_of(a, cid),
                co.Format1(
                    i18.Tr("the '%s' element is deprecated and will be removed"), co.ArgStr(cn.name)
                ),
                i18.Tr("write an 'input' with type = \"textarea\" instead")
            )
        end
        lay_check_native_elem(s, a, cid, ei)
        lay_check_placement(s, a, cid, ei, ck)
        lay_check_attrs(s, a, cid, ei, ck)
        if str.Equals(e.generator, "font_face"):
            lay_check_font(s, a, cid)
        end
        lay_check_repeat(s, a, cid, lay_elem_display(ei))
        if str.Equals(e.unique, "parent"):
            mut again := false
            repeat sib.Len() in k:
                if sib.Get(k) == ei:
                    again = true
                end
            end
            if again:
                serr(
                    s,
                    120,
                    span_of(a, cid),
                    co.Format2(
                        i18.Tr("element '%s' can appear only once inside '%s'"),
                        co.ArgStr(lay_elem_display(ei)),
                        co.ArgStr(
                            ck.stack.Len() > 0 and ck.stack.Get(
                                ck.stack.Len() - 1
                            ) >= 0 ? lay_elem_display(
                                ck.stack.Get(ck.stack.Len() - 1)
                            ) : "page"
                        )
                    )
                )
            end
        else str.Equals(e.unique, "document"):
            mut again2 := false
            repeat ck.doc_unique.Len() in k2:
                if ck.doc_unique.Get(k2) == ei:
                    again2 = true
                end
            end
            if again2:
                serr(
                    s,
                    120,
                    span_of(a, cid),
                    co.Format1(
                        i18.Tr("element '%s' can appear only once in a layout"),
                        co.ArgStr(lay_elem_display(ei))
                    )
                )
            else:
                ck.doc_unique.Push(ei)
            end
        end
        if e.first and sib.Len() > 0:
            pidx := ck.stack.Len() > 0 ? ck.stack.Get(ck.stack.Len() - 1) : 0 - 1
            serr(
                s,
                125,
                span_of(a, cid),
                co.Format2(
                    i18.Tr("element '%s' must be the first element inside '%s'"),
                    co.ArgStr(lay_elem_display(ei)),
                    co.ArgStr(pidx >= 0 ? lay_elem_display(pidx) : "page")
                )
            )
        end
        if e.kind != LK_VIRTUAL and not lay_list_has_elem("#script-supporting", ei):
            sib.Push(ei)
        end
        ck.stack.Push(ei)
        lay_check_children(s, a, cid, ck)
        _pe := ck.stack.Pop()
    end
end

func lay_report_unknown(s &: Sema, a &: at.Ast, cid: int, name: str):
    sp := span_of(a, cid)
    repeat dg.Count(s.diag) in i:
        d := dg.ItemAt(s.diag, i)
        if d.code == 111 and d.sev == dg.SEV_ERROR and str.Equals(
            d.file, s.file
        ) and d.span.begin.line == sp.begin.line and d.span.begin.col == sp.begin.col:
            ret
        end
    end
    mut names := lay_elem_names()
    mut hint := lay_suggest_from(name, names)
    names.Free()
    each oc in g_lay_outside_comps:
        if str.Equals(oc, name):
            hint += co.Format1(
                i18.Tr(
                    " (a pub component '%s' exists in the project outside components/; move it to components/ or include it)"
                ),
                co.ArgStr(name)
            )
            break
        end
    end
    serr(
        s,
        111,
        sp,
        co.Format2(
            i18.Tr("unknown layout element '%s'%s"), co.ArgStr(name), co.ArgStr(hint)
        )
    )
end

func lay_is_slot_placeholder(name: str): bool:
    ret str.Equals(
        name, "content"
    ) or str.Equals(name, "محتوا") or str.Equals(name, "slot") or str.Equals(name, "جایگاه")
end

func lay_comp_slot_name(a &: at.Ast, el: int): str:
    repeat at.ChildCount(a, el) in i:
        cid := at.Child(a, el, i)
        c := at.Get(a, cid)
        if c.kind == at.AST_LAYOUT_ATTR and (str.Equals(
            c.name, "name"
        ) or str.Equals(c.name, "نام") or str.Equals(c.name, "slot") or str.Equals(
            c.name, "جایگاه"
        )):
            mut v := ""
            if lay_attr_text(a, cid, v):
                ret v
            end
        end
    end
    ret ""
end

func lay_comp_has_slot_name_attr(a &: at.Ast, el: int): bool:
    repeat at.ChildCount(a, el) in i:
        cid := at.Child(a, el, i)
        c := at.Get(a, cid)
        if c.kind == at.AST_LAYOUT_ATTR and (str.Equals(
            c.name, "name"
        ) or str.Equals(c.name, "نام") or str.Equals(c.name, "slot") or str.Equals(
            c.name, "جایگاه"
        )):
            ret true
        end
    end
    ret false
end

func lay_comp_check_control(s &: Sema, a &: at.Ast, nid: int, ck &: LayCheck):
    n := at.Get(a, nid)
    if n.kind == at.AST_EACH:
        if n.a == 0:
            serr(s, 18, span_of(a, nid), i18.Tr("'each' is missing the collection to iterate over"))
        end
        if str.Len(n.name) == 0:
            serr(s, 18, span_of(a, nid), i18.Tr("'each' is missing the item variable name"))
        end
        if n.c != 0 and at.KindOf(a, n.c) != at.AST_IDENTIFIER:
            serr(s, 18, span_of(a, n.c), i18.Tr("'each' key must be a variable name"))
        end
        if n.c == 0:
            swarn(
                s,
                138,
                span_of(a, nid),
                i18.Tr(
                    "'each' has no key; add a stable key for better update/reconciliation parity and lifecycle cleanup identity"
                )
            )
            // Keyed-each/lifecycle contract (source-level): without a key, lowering may fall back to index/positional identity depending on target lowering.
            // TODO(runtime/toolchain): validate key stability/uniqueness and define mount/update/unmount/cleanup hook semantics for dynamic lists.
            // Cross-target parity: webstate and native keyed reconciliation must agree on identity, reorder/reuse behavior, and handler lifecycle timing.
        end
        if n.b == 0:
            serr(s, 18, span_of(a, nid), i18.Tr("'each' has no body"))
        else:
            lay_comp_check_items(s, a, n.b, ck)
        end
        ret
    end
    if n.kind == at.AST_IF and n.a == 0:
        serr(s, 18, span_of(a, nid), i18.Tr("'if' is missing its condition"))
    end
    if n.b != 0:
        lay_comp_check_items(s, a, n.b, ck)
    end
    if n.kind == at.AST_IF and n.c != 0:
        if at.KindOf(a, n.c) == at.AST_IF:
            lay_comp_check_control(s, a, n.c, ck)
        else:
            lay_comp_check_items(s, a, n.c, ck)
        end
    end
end

func lay_comp_slot_valid_name(sn: str): bool:
    if str.Len(sn) == 0:
        ret false
    end
    // Conservative: reject whitespace/control-ish separators in slot names.
    if str.IndexOf(sn, " ") >= 0 or str.IndexOf(sn, "\t") >= 0 or str.IndexOf(sn, "\n") >= 0 or
        str.IndexOf(sn, "\r") >= 0:
        ret false
    end
    ret true
end

func lay_comp_check_items(s &: Sema, a &: at.Ast, nid: int, ck &: LayCheck):
    if nid == 0:
        ret
    end
    mut slot_names := Vector {} as Vector<str>
    defer slot_names.Free()
    repeat at.ChildCount(a, nid) in i:
        cid := at.Child(a, nid, i)
        k := at.KindOf(a, cid)
        if k == at.AST_IF or k == at.AST_EACH:
            lay_comp_check_control(s, a, cid, ck)
            continue
        end
        if k == at.AST_LAYOUT_ATTR:
            name := at.Get(a, cid).name
            if not lay_is_handler(name) and not StyleAttrIsEvent(a, cid) and
                str.Len(name) > 0:
                lay_bare_value_walk(s, a, at.Get(a, cid).a)
            end
            if lay_is_handler(name):
                if str.Len(
                    str.Trim(
                        str.Substr(
                            name,
                            lay_handler_prefix_len(name),
                            str.Len(name) - lay_handler_prefix_len(name)
                        )
                    )
                ) == 0:
                    serr(s, 18, span_of(a, cid), i18.Tr("event handler name is missing the event"))
                end
            end
            continue
        end
        if k != at.AST_LAYOUT_ELEMENT:
            continue
        end
        cn := at.Get(a, cid)
        if not lay_is_component(ck, cn.name) and lay_check_state_block(s, a, cid, cn.name):
            continue
        end
        if lay_is_slot_placeholder(cn.name):
            mut sn := lay_comp_slot_name(a, cid)
            has_slot_name_attr := lay_comp_has_slot_name_attr(a, cid)
            if str.Len(sn) == 0:
                if has_slot_name_attr:
                    serr(s, 18, span_of(a, cid), i18.Tr("slot name must be a fixed text value"))
                end
                sn = "default"
            end
            if not lay_comp_slot_valid_name(sn):
                serr(
                    s,
                    18,
                    span_of(a, cid),
                    co.Format1(
                        i18.Tr("invalid slot name '%s'"), co.ArgStr(sn)
                    )
                )
            end
            mut dup_slot := false
            repeat slot_names.Len() in si:
                if str.Equals(slot_names.Get(si), sn):
                    dup_slot = true
                end
            end
            if dup_slot:
                serr(
                    s,
                    114,
                    span_of(a, cid),
                    co.Format1(
                        i18.Tr("duplicate slot placeholder '%s' in component"), co.ArgStr(sn)
                    )
                )
            else:
                slot_names.Push(sn)
            end
            // Slot placeholders may contain fallback content and/or named slot metadata attrs.
            mut has_scoped_slot_meta := false
            repeat at.ChildCount(a, cid) in sai:
                said := at.Child(a, cid, sai)
                san := at.Get(a, said)
                if san.kind == at.AST_LAYOUT_ATTR:
                    if not str.Equals(
                        san.name, "name"
                    ) and not str.Equals(san.name, "نام") and not str.Equals(
                        san.name, "slot"
                    ) and not str.Equals(
                        san.name, "جایگاه"
                    ):
                        has_scoped_slot_meta = true
                    end
                end
            end
            if has_scoped_slot_meta:
                swarn(
                    s,
                    139,
                    span_of(a, cid),
                    co.Format1(
                        i18.Tr(
                            "slot placeholder '%s' has extra attributes treated as scoped slot parameters/bindings metadata; full semantics require runtime/toolchain validation"
                        ),
                        co.ArgStr(sn)
                    )
                )
            end
            // Slot/scoped-slot contract (source-level): extra non-routing attrs on placeholders/providers are treated as binding metadata only.
            // TODO(toolchain/runtime): validate named-slot forwarding targets, scoped slot parameter declarations/bindings, typing, and web/native invocation parity.
            lay_comp_check_items(s, a, cid, ck)
            continue
        end
        // Component invocations inside component bodies: basic slot-routing/content-form diagnostics.
        if lay_is_component(ck, cn.name):
            mut provided_named := Vector {} as Vector<str>
            defer provided_named.Free()
            mut has_default_attr := false
            mut has_default_children := false
            mut has_named_children := false
            repeat at.ChildCount(a, cid) in jn:
                kid := at.Child(a, cid, jn)
                kk := at.KindOf(a, kid)
                if kk == at.AST_LAYOUT_ATTR:
                    an := at.Get(a, kid).name
                    if str.Equals(an, "content") or str.Equals(
                        an, "children"
                    ) or str.Equals(an, "محتوا"):
                        has_default_attr = true
                    end
                    if str.Equals(an, "slot") or str.Equals(an, "جایگاه"):
                        mut sv := ""
                        if not lay_attr_text(a, kid, sv):
                            serr(
                                s,
                                18,
                                span_of(a, kid),
                                i18.Tr("slot routing attribute must be a fixed text value")
                            )
                        else sv != "default" and sv != "content" and sv != "children" and
                            sv != "محتوا" and str.Len(sv) > 0:
                            serr(
                                s,
                                18,
                                span_of(a, kid),
                                co.Format1(
                                    i18.Tr(
                                        "named slot '%s' must be provided as a slot element, not as an attribute"
                                    ),
                                    co.ArgStr(sv)
                                )
                            )
                        end
                    end
                else kk == at.AST_LAYOUT_ELEMENT:
                    if lay_is_slot_placeholder(at.Get(a, kid).name):
                        mut psn := lay_comp_slot_name(a, kid)
                        has_name_attr := lay_comp_has_slot_name_attr(a, kid)
                        if str.Len(psn) == 0:
                            if has_name_attr:
                                serr(
                                    s,
                                    18,
                                    span_of(a, kid),
                                    i18.Tr("slot name must be a fixed text value")
                                )
                            end
                            psn = "default"
                        end
                        if not lay_comp_slot_valid_name(psn):
                            serr(
                                s,
                                18,
                                span_of(a, kid),
                                co.Format1(
                                    i18.Tr("invalid slot name '%s'"), co.ArgStr(psn)
                                )
                            )
                        end
                        if str.Equals(psn, "default") or str.Equals(psn, "content") or str.Equals(
                            psn, "children"
                        ) or str.Equals(psn, "محتوا"):
                            has_default_children = true
                        else:
                            has_named_children = true
                            mut seenp := false
                            repeat provided_named.Len() in pni:
                                if str.Equals(provided_named.Get(pni), psn):
                                    seenp = true
                                end
                            end
                            if seenp:
                                serr(
                                    s,
                                    114,
                                    span_of(a, kid),
                                    co.Format1(
                                        i18.Tr("component receives named slot '%s' more than once"),
                                        co.ArgStr(psn)
                                    )
                                )
                            else:
                                provided_named.Push(psn)
                            end
                        end
                    else:
                        rsn := lay_comp_slot_name(a, kid)
                        if str.Len(rsn) > 0 and not lay_comp_slot_valid_name(rsn):
                            serr(
                                s,
                                18,
                                span_of(a, kid),
                                co.Format1(
                                    i18.Tr("invalid slot name '%s'"), co.ArgStr(rsn)
                                )
                            )
                        end
                        if str.Len(rsn) == 0:
                            mut has_route_attr := false
                            repeat at.ChildCount(a, kid) in rai:
                                raid := at.Child(a, kid, rai)
                                ran := at.Get(a, raid)
                                if ran.kind == at.AST_LAYOUT_ATTR and (str.Equals(
                                    ran.name, "slot"
                                ) or str.Equals(
                                    ran.name, "جایگاه"
                                )):
                                    has_route_attr = true
                                end
                            end
                            if has_route_attr:
                                serr(
                                    s,
                                    18,
                                    span_of(a, kid),
                                    i18.Tr("slot routing attribute must be a fixed text value")
                                )
                            else:
                                has_default_children = true
                            end
                        else rsn == "default" or rsn == "content" or rsn == "children" or
                            rsn == "محتوا":
                            has_default_children = true
                        else:
                            has_named_children = true
                        end
                        // TODO(toolchain): verify routed named slots exist on the target component definition when signatures are available.
                        // TODO(runtime): propagate slot payload/binding metadata for scoped slot params when supported.
                    end
                else kk == at.AST_IF or kk == at.AST_EACH:
                    has_default_children = true
                end
            end
            if has_default_attr and has_default_children:
                serr(
                    s,
                    114,
                    span_of(a, cid),
                    co.Format1(
                        i18.Tr(
                            "component '%s' receives content twice; use either the content attribute or content children, not both"
                        ),
                        co.ArgStr(cn.name)
                    )
                )
            end
            _hnc := has_named_children
        end
        if not lay_is_component(ck, cn.name) and not lay_state_name(cn.name) and lay_resolve_elem(
            a, cid, ck.stack
        ) < 0:
            if ck.unexpanded:
                swarn(
                    s,
                    2,
                    span_of(a, cid),
                    co.Format1(
                        i18.Tr("unrecognized layout element '%s' (ignored)"), co.ArgStr(cn.name)
                    )
                )
            else:
                lay_report_unknown(s, a, cid, cn.name)
            end
        end
        repeat at.ChildCount(a, cid) in j:
            aid := at.Child(a, cid, j)
            if at.KindOf(a, aid) == at.AST_LAYOUT_ATTR:
                aname := at.Get(a, aid).name
                if lay_is_handler(aname):
                    if str.Len(
                        str.Trim(
                            str.Substr(
                                aname,
                                lay_handler_prefix_len(aname),
                                str.Len(aname) - lay_handler_prefix_len(aname)
                            )
                        )
                    ) == 0:
                        serr(
                            s,
                            18,
                            span_of(a, aid),
                            i18.Tr("event handler name is missing the event")
                        )
                    end
                end
            end
        end
        lay_comp_check_items(s, a, cid, ck)
    end
end

func lay_check_pascal_name(s &: Sema, a &: at.Ast, nid: int):
    d := at.Get(a, nid)
    if not d.is_pub or lay_pascal_ok(d.name):
        ret
    end
    serr(
        s,
        290,
        span_of(a, nid),
        co.Format2(
            i18.Tr("pub component name \"%s\" must be written %s"),
            co.ArgStr(d.name),
            co.ArgStr(lay_pascal_suggest(d.name))
        )
    )
end

func sema_check_layout_component(s &: Sema, a &: at.Ast, nid: int):
    if at.KindOf(a, nid) == at.AST_LAYOUT_COMPONENT:
        lay_check_pascal_name(s, a, nid)
    end
    if at.KindOf(a, nid) != at.AST_LAYOUT_COMPONENT or s.program == 0:
        ret
    end
    lay_ensure()
    mut ck := LayCheck {}
    defer ck.stack.Free()
    defer ck.comps.Free()
    repeat at.ChildCount(a, s.program) in pi:
        pid := at.Child(a, s.program, pi)
        if at.KindOf(a, pid) == at.AST_LAYOUT_COMPONENT:
            ck.comps.Push(at.Get(a, pid).name)
        end
    end
    each kn in g_lay_known_comps:
        ck.comps.Push(kn)
    end
    g_lay_locals.Clear()
    lay_collect_locals(a, at.Get(a, nid).a)
    lay_check_spelling(s, a, at.Get(a, nid).a)
    ck.unexpanded = lay_tree_has_include(a, at.Get(a, nid).a)
    ck.stack.Push(lay_elem_by_key("page"))
    lay_comp_check_items(s, a, at.Get(a, nid).a, ck)
end

func lay_tree_has_include(a &: at.Ast, nid: int): bool:
    repeat at.ChildCount(a, nid) in i:
        cid := at.Child(a, nid, i)
        k := at.KindOf(a, cid)
        if k == at.AST_LAYOUT_ATTR:
            nm := at.Get(a, cid).name
            if str.Equals(nm, "include") or str.Equals(lay_attr_key(nm), "include"):
                ret true
            end
        else k == at.AST_LAYOUT_ELEMENT:
            if lay_tree_has_include(a, cid):
                ret true
            end
        else k == at.AST_EACH:
            if lay_tree_has_include(a, at.Get(a, cid).b):
                ret true
            end
        else k == at.AST_IF:
            n := at.Get(a, cid)
            if lay_tree_has_include(a, n.b):
                ret true
            end
            if n.c != 0 and lay_tree_has_include(a, n.c):
                ret true
            end
        end
    end
    ret false
end

func sema_check_layout(s &: Sema, a &: at.Ast, nid: int, _parent: str):
    if at.KindOf(a, nid) != at.AST_LAYOUT_BLOCK:
        ret
    end
    lbnode := at.Get(a, nid)
    if str.Len(lbnode.name) > 0 and not lbnode.view_glue:
        ret
    end
    lay_ensure()
    s.has_layout_block = true
    lg.Log(
        s.log, lg.PH_SEMANTIC, lg.LOG_DEBUG, i18.Tr("validating page block")
    )
    mut ck := LayCheck {}
    defer ck.stack.Free()
    defer ck.ids.Free()
    defer ck.ref_vals.Free()
    defer ck.ref_nodes.Free()
    defer ck.ref_names.Free()
    defer ck.doc_unique.Free()
    defer ck.comps.Free()
    defer ck.cls_names.Free()
    defer ck.cls_sigs.Free()
    defer ck.cls_nodes.Free()
    if s.program != 0:
        repeat at.ChildCount(a, s.program) in pi:
            pid := at.Child(a, s.program, pi)
            if at.KindOf(a, pid) == at.AST_LAYOUT_COMPONENT:
                ck.comps.Push(at.Get(a, pid).name)
            end
        end
    end
    each kn in g_lay_known_comps:
        ck.comps.Push(kn)
    end
    ck.unexpanded = lay_tree_has_include(a, nid)
    ck.runtime = lbnode.view_glue
    if not g_lay_schema_reported:
        g_lay_schema_reported = true
        repeat g_lay_schema_errors.Len() in se:
            swarn(
                s,
                124,
                span_of(a, nid),
                co.Format1(
                    i18.Tr("layout schema problem: %s"), co.ArgStr(g_lay_schema_errors.Get(se))
                )
            )
        end
    end
    g_lay_locals.Clear()
    lay_collect_locals(a, nid)
    lay_check_spelling(s, a, nid)
    layout_resolve(a, nid)
    root := lay_elem_by_key("page")
    if lay_elem_attr(a, nid, "repeat") != 0 and lay_subtree_has_id(a, nid):
        serr(
            s, 19, span_of(a, nid), i18.Tr("layout uses 'repeat' but a nested element has an 'id'")
        )
    end
    if root >= 0:
        lay_check_attrs(s, a, nid, root, ck)
    end
    ck.stack.Push(root)
    lay_check_children(s, a, nid, ck)
    repeat ck.ref_vals.Len() in r:
        want := ck.ref_vals.Get(r)
        mut ok := false
        repeat ck.ids.Len() in q:
            if str.Equals(ck.ids.Get(q), want):
                ok = true
            end
        end
        if not ok and not ck.unexpanded:
            serr(
                s,
                121,
                span_of(a, ck.ref_nodes.Get(r)),
                co.Format2(
                    i18.Tr("'%s' refers to id '%s', but no element has that id"),
                    co.ArgStr(ck.ref_names.Get(r)),
                    co.ArgStr(want)
                )
            )
        end
    end
end

func lay_raw_text_escapes(e: LayElem, v: str): bool:
    if e.kind != LK_RAW and not str.Equals(e.generator, "style") and not str.Equals(
        e.generator, "script"
    ):
        ret false
    end
    low := str.Lower(v)
    ret str.IndexOf(low, "</style") >= 0 or str.IndexOf(low, "</script") >= 0
end

func lay_css_value_safe(v: str): bool:
    repeat str.Len(v) in i:
        b := byte_at(v, i)
        if b == 123 or b == 125 or b == 59 or b == 60 or b == 62 or b == 10 or b == 13:
            ret false
        end
    end
    ret true
end

func lay_url_runs_code(v: str): bool:
    sl := lay_url_scheme_len(str.Trim(v))
    if sl == 0:
        ret false
    end
    scheme := str.Lower(str.Substr(str.Trim(v), 0, sl))
    if str.Equals(scheme, "javascript") or str.Equals(scheme, "vbscript"):
        ret true
    end
    ret str.Equals(scheme, "data") and not lay_is_abs_url(str.Trim(v))
end

func lay_take_ids(ck &: LayCheck, base: int, seen &: Vector<str>):
    mut added := Vector {} as Vector<str>
    defer added.Free()
    until ck.ids.Len() > base:
        added.Push(ck.ids.Pop())
    end
    each id in added:
        mut have := false
        each old in seen:
            if str.Equals(old, id):
                have = true
            end
        end
        if not have:
            seen.Push(id)
        end
    end
end

func lay_check_control(s &: Sema, a &: at.Ast, nid: int, ck &: LayCheck):
    n := at.Get(a, nid)
    if n.kind == at.AST_IF and n.synthetic and str.Equals(n.name, "__salam_component"):
        saved := ck.runtime
        ck.runtime = true
        lay_check_children(s, a, n.b, ck)
        ck.runtime = saved
        ret
    end
    if not ck.runtime:
        serr(
            s,
            133,
            span_of(a, nid),
            i18.Tr(
                "'if' and 'each' inside a page need runtime values; declare a runtime page such as 'page Home(user: str):'"
            )
        )
        ret
    end
    if n.kind == at.AST_EACH:
        if n.a == 0:
            serr(s, 18, span_of(a, nid), i18.Tr("'each' is missing the collection to iterate over"))
        end
        if str.Len(n.name) == 0:
            serr(s, 18, span_of(a, nid), i18.Tr("'each' is missing the item variable name"))
        end
        if n.c != 0 and at.KindOf(a, n.c) != at.AST_IDENTIFIER:
            serr(s, 18, span_of(a, n.c), i18.Tr("'each' key must be a variable name"))
        end
        if n.c == 0:
            swarn(
                s,
                138,
                span_of(a, nid),
                i18.Tr(
                    "'each' has no key; add a stable key for better update/reconciliation parity and lifecycle cleanup identity"
                )
            )
            // Keyed-each/lifecycle contract (source-level): without a key, lowering may fall back to index/positional identity depending on target lowering.
            // TODO(runtime/toolchain): enforce key stability/uniqueness and mount/update/unmount/cleanup hook semantics for dynamic lists.
            // Cross-target parity: webstate and native keyed reconciliation must agree on identity, reorder/reuse behavior, and handler lifecycle timing.
        end
        if n.b == 0:
            serr(s, 18, span_of(a, nid), i18.Tr("'each' has no body"))
            ret
        end
        ck.in_each++
        lay_check_children(s, a, n.b, ck)
        ck.in_each--
        ret
    end
    if n.a == 0:
        serr(s, 18, span_of(a, nid), i18.Tr("'if' is missing its condition"))
    end
    base := ck.ids.Len()
    mut seen := Vector {} as Vector<str>
    defer seen.Free()
    if n.b != 0:
        lay_check_children(s, a, n.b, ck)
    end
    lay_take_ids(ck, base, seen)
    if n.c != 0:
        if at.KindOf(a, n.c) == at.AST_IF:
            lay_check_control(s, a, n.c, ck)
        else:
            lay_check_children(s, a, n.c, ck)
        end
    end
    lay_take_ids(ck, base, seen)
    each id in seen:
        ck.ids.Push(id)
    end
end

pub func LayoutNumUnit(lexeme: str): str:
    n := str.Len(lexeme)
    if n > 2 and byte_at(lexeme, n - 2) == 217 and byte_at(lexeme, n - 1) == 170:
        ret "%"
    end
    if n > 1 and byte_at(lexeme, 0) == 48 and
        (byte_at(lexeme, 1) == 120 or byte_at(lexeme, 1) == 88 or byte_at(lexeme, 1) == 98 or
            byte_at(lexeme, 1) == 111):
        ret ""
    end
    mut i := n
    until i > 0:
        b := byte_at(lexeme, i - 1)
        if (b >= 97 and b <= 122) or (b >= 65 and b <= 90) or b == 37:
            i--
        else:
            break
        end
    end
    if i == 0 or i == n:
        ret ""
    end
    b0 := byte_at(lexeme, i - 1)
    if not ((b0 >= 48 and b0 <= 57) or b0 >= 128 or b0 == 46):
        ret ""
    end
    ret str.Substr(lexeme, i, n - i)
end

pub func LayoutHasEmptyFallback(a &: at.Ast, nid: int): bool:
    ret lay_has_empty_fallback(a, nid)
end

pub func LayoutSpellingLower(log: lg.Logger, a &: at.Ast, prog: int, body: int, file: str): int:
    lay_ensure()
    g_lay_sp_comps.Clear()
    g_lay_sp_hit_node.Clear()
    g_lay_sp_hit_off.Clear()
    g_lay_sp_path = file
    if prog != 0:
        repeat at.ChildCount(a, prog) in pi:
            pid := at.Child(a, prog, pi)
            if at.KindOf(a, pid) == at.AST_LAYOUT_COMPONENT:
                g_lay_sp_comps.Push(at.Get(a, pid).name)
            end
        end
    end
    each kn in g_lay_known_comps:
        g_lay_sp_comps.Push(kn)
    end
    lay_spelling_walk(a, body, true)
    mut reported := 0
    repeat g_lay_sp_hit_node.Len() in i:
        n := at.Get(a, g_lay_sp_hit_node.Get(i))
        if not lay_spelling_first(
            a, g_lay_sp_hit_node.Get(i), lay_spelling_path(a, g_lay_sp_hit_node.Get(i))
        ):
            continue
        end
        reported++
        msg := co.Format1(
            i18.Tr(
                "'%s' is an official page name, and an English file writes it with spaces, not '_' or '-'"
            ),
            co.ArgStr(n.name)
        )
        help := co.Format1(i18.Tr("write '%s'"), co.ArgStr(g_lay_sp_hit_off.Get(i)))
        lg.LogAtHelp(
            log,
            lg.PH_SEMANTIC,
            lg.LOG_ERROR,
            file,
            n.begin_line as int,
            n.begin_col as int,
            help,
            "E235: " + msg
        )
    end
    ret reported
end

pub func lay_pascal_ok(name: str): bool:
    n := str.Len(name)
    if n == 0 or byte_at(name, 0) >= 128:
        ret true
    end
    c0 := byte_at(name, 0)
    if c0 < 65 or c0 > 90:
        ret false
    end
    repeat n in i:
        if byte_at(name, i) == 95:
            ret false
        end
    end
    ret true
end

pub func lay_pascal_suggest(name: str): str:
    mut out := ""
    mut up := true
    repeat str.Len(name) in i:
        ch := str.Substr(name, i, 1)
        if byte_at(name, i) == 95:
            up = true
            continue
        end
        if up:
            out += str.Upper(ch)
            up = false
        else:
            out += ch
        end
    end
    ret out
end
