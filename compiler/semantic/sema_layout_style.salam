package semantic

import str
import os
import gui.style

include co "../sal_core.salam"
include tok "../token.salam"
include at "../ast.salam"
include i18 "../i18n.salam"

pub const UI_STANDARD_WARN_CODE := 171

pub const UI_STANDARD_ERROR_CODE := 170

pub const STYLE_STATE_BASE := 0

pub const STYLE_STATE_HOVER := 1

pub const STYLE_STATE_FOCUS := 2

pub const STYLE_STATE_FOCUS_WITHIN := 3

pub const STYLE_STATE_ACTIVE := 4

pub const STYLE_STATE_DISABLED := 5

pub const STYLE_STATE_CHECKED := 6

pub const STYLE_STATE_INVALID := 7

pub const STYLE_STATE_PLACEHOLDER := 8

pub const STYLE_STATE_SELECTION := 9

mut g_style_attr_ast := Vector {} as Vector<int>

mut g_style_attr_node := Vector {} as Vector<int>

mut g_style_attr_prop := Vector {} as Vector<int>

mut g_style_attr_state := Vector {} as Vector<int>

mut g_style_attr_css := Vector {} as Vector<str>

mut g_style_quote_strs := false

mut g_style_src_path := ""

mut g_style_src_text := ""

mut g_style_dyn_ast := Vector {} as Vector<int>

mut g_style_dyn_node := Vector {} as Vector<int>

mut g_style_dyn_prop := Vector {} as Vector<int>

mut g_style_dyn_state := Vector {} as Vector<int>

struct StyleAttr:
    pub ok: bool = false
    pub prop: int = 0
    pub state: int = STYLE_STATE_BASE
    pub is_static: bool = false
    pub value: style.Value = style.Value {}
    pub expr: int = 0
    pub err: str = ""
end

func style_attr_remember(a &: at.Ast, attr: int, prop: int, state: int, css: str):
    g_style_attr_ast.Push(a.uid)
    g_style_attr_node.Push(attr)
    g_style_attr_prop.Push(prop)
    g_style_attr_state.Push(state)
    g_style_attr_css.Push(css)
end

func style_attr_remember_dyn(a &: at.Ast, attr: int, prop: int, state: int):
    g_style_dyn_ast.Push(a.uid)
    g_style_dyn_node.Push(attr)
    g_style_dyn_prop.Push(prop)
    g_style_dyn_state.Push(state)
end

func style_state_word(name: str, w: str): int:
    wl := str.Len(w)
    if str.Len(name) <= wl + 1 or not str.StartsWith(name, w):
        ret 0
    end
    sep := byte_at(name, wl)
    if sep == 95 or sep == 32 or sep == 45:
        ret wl + 1
    end
    if sep == 226 and str.Len(name) > wl + 3 and byte_at(
        name, wl + 1
    ) == 128 and byte_at(name, wl + 2) == 140:
        ret wl + 3
    end
    ret 0
end

func style_state_words(fa: bool): Vector<str>:
    mut out := Vector {} as Vector<str>
    if fa:
        out.Push("اشاره")
        out.Push("تمرکز درون")
        out.Push("تمرکز")
        out.Push("فشردن")
        out.Push("غیرفعال")
        out.Push("تیک\xE2\x80\x8Cخورده")
        out.Push("نامعتبر")
        out.Push("جای\xE2\x80\x8Cنوشته")
        out.Push("گزینش")
    else:
        out.Push("hover")
        out.Push("focus within")
        out.Push("focus")
        out.Push("active")
        out.Push("disabled")
        out.Push("checked")
        out.Push("invalid")
        out.Push("placeholder")
        out.Push("selection")
    end
    ret out
end

func style_state_prefix(name: str, rest &: str): int:
    prefixes := [
        "hover", "focus within", "focus", "active", "disabled", "checked", "invalid", "placeholder",
        "selection"
    ]
    states := [
        STYLE_STATE_HOVER, STYLE_STATE_FOCUS_WITHIN, STYLE_STATE_FOCUS, STYLE_STATE_ACTIVE,
        STYLE_STATE_DISABLED, STYLE_STATE_CHECKED, STYLE_STATE_INVALID, STYLE_STATE_PLACEHOLDER,
        STYLE_STATE_SELECTION
    ]
    fa_prefixes := [
        "اشاره", "تمرکز درون", "تمرکز", "فشردن", "غیرفعال", "تیک\xE2\x80\x8Cخورده", "نامعتبر",
        "جای\xE2\x80\x8Cنوشته", "گزینش"
    ]
    repeat len(prefixes) in i:
        mut skip := style_state_word(name, prefixes[i])
        if skip == 0:
            skip = style_state_word(name, str.Replace(prefixes[i], " ", "_"))
        end
        if skip == 0:
            skip = style_state_word(name, str.Replace(prefixes[i], " ", "-"))
        end
        if skip == 0:
            skip = style_state_word(name, fa_prefixes[i])
        end
        if skip == 0:
            skip = style_state_word(name, str.Replace(fa_prefixes[i], " ", "_"))
        end
        if skip > 0:
            rest = str.Substr(name, skip, str.Len(name) - skip)
            ret states[i]
        end
    end
    rest = name
    ret STYLE_STATE_BASE
end

func style_attr_group_text(a &: at.Ast, nid: int): str:
    mut text := ""
    repeat at.ChildCount(a, nid) in i:
        if i > 0:
            text += ", "
        end
        text += style_attr_item_text(a, at.Child(a, nid, i))
    end
    ret text
end

func style_attr_item_text(a &: at.Ast, nid: int): str:
    if nid == 0:
        ret ""
    end
    n := at.Get(a, nid)
    if n.kind == at.AST_ARRAY_LIT:
        ret "[" + style_attr_group_text(a, nid) + "]"
    end
    if n.kind == at.AST_LITERAL and n.value_kind == tok.TV_STRING:
        if g_style_quote_strs and not str.StartsWith(n.value_str, "\""):
            ret "\"" + n.value_str + "\""
        end
        ret n.value_str
    end
    if n.kind == at.AST_BINARY and (n.op == tok.TK_PLUS or n.op == tok.TK_MINUS):
        ret style_attr_item_text(a, n.a) + (n.op == tok.TK_PLUS ? " + " : " - ") +
            style_attr_item_text(a, n.b)
    end
    if n.kind == at.AST_LITERAL and n.op == tok.TK_INT:
        ret co.U64Toa(n.value_int) + LayoutNumUnit(n.name)
    end
    if n.kind == at.AST_LITERAL and n.op == tok.TK_FLOAT:
        ret co.Format1("%g", co.ArgFloat(n.value_float)) + LayoutNumUnit(n.name)
    end
    if n.kind == at.AST_LITERAL and n.op == tok.TK_KW_TRUE:
        ret "true"
    end
    if n.kind == at.AST_LITERAL and n.op == tok.TK_KW_FALSE:
        ret "false"
    end
    if n.kind == at.AST_UNARY and n.op == tok.TK_MINUS:
        ret "-" + style_attr_item_text(a, n.a)
    end
    if n.kind == at.AST_IDENTIFIER:
        ret n.name
    end
    if n.kind == at.AST_CALL and n.a != 0 and at.KindOf(a, n.a) == at.AST_IDENTIFIER:
        mut call := at.Get(a, n.a).name + "("
        repeat at.ChildCount(a, nid) in i:
            argid := at.Child(a, nid, i)
            if i > 0:
                call += ", "
            end
            arg := at.Get(a, argid)
            if arg.kind == at.AST_LITERAL and arg.value_kind == tok.TV_STRING and
                not str.StartsWith(
                    arg.value_str, "#"
                ):
                call += `"` + arg.value_str + `"`
            else:
                call += style_attr_item_text(a, argid)
            end
        end
        ret call + ")"
    end
    ret ""
end

func style_loose(name: str): str:
    mut t := str.Replace(name, "\xE2\x80\x8C", "")
    t = str.Replace(t, "\xD9\x8A", "\xDB\x8C")
    t = str.Replace(t, "\xD9\x83", "\xDA\xA9")
    t = str.Replace(t, " ", "")
    t = str.Replace(t, "_", "")
    ret str.Lower(t)
end

func style_prop_loose(name: str): int:
    mut ascii := true
    each b in name.Bytes():
        if (b as int) >= 128:
            ascii = false
        end
    end
    if ascii:
        ret 0 - 1
    end
    want := style_loose(name)
    repeat style.PROP_COUNT in i:
        info := style.Info(i)
        if str.Equals(style_loose(info.name), want) or str.Equals(style_loose(info.fa), want):
            ret i
        end
    end
    ret 0 - 1
end

func style_num_eval(a &: at.Ast, nid: int, out &: f64): bool:
    if nid == 0:
        ret false
    end
    n := at.Get(a, nid)
    if n.kind == at.AST_LITERAL and n.op == tok.TK_INT and str.Len(LayoutNumUnit(n.name)) == 0:
        out = n.value_int as f64
        ret true
    end
    if n.kind == at.AST_LITERAL and n.op == tok.TK_FLOAT and str.Len(LayoutNumUnit(n.name)) == 0:
        out = n.value_float
        ret true
    end
    if n.kind == at.AST_UNARY and n.op == tok.TK_MINUS:
        mut x := 0.0
        if not style_num_eval(a, n.a, x):
            ret false
        end
        out = 0.0 - x
        ret true
    end
    if n.kind == at.AST_BINARY and
        (n.op == tok.TK_PLUS or n.op == tok.TK_MINUS or n.op == tok.TK_STAR or
            n.op == tok.TK_SLASH):
        mut l := 0.0
        mut r := 0.0
        if not style_num_eval(a, n.a, l) or not style_num_eval(a, n.b, r):
            ret false
        end
        if n.op == tok.TK_PLUS:
            out = l + r
        else n.op == tok.TK_MINUS:
            out = l - r
        else n.op == tok.TK_STAR:
            out = l * r
        else:
            if r == 0.0:
                ret false
            end
            out = l / r
        end
        ret true
    end
    ret false
end

func style_has_fa_marks(text: str): bool:
    mut inq := false
    mut prev := 0
    each ch in text.Bytes():
        b := ch as int
        if b == 34:
            inq = not inq
        end
        if not inq and
            ((prev == 219 and b >= 176 and b <= 185) or (prev == 217 and b >= 160 and b <= 171) or
                (prev == 216 and b == 140)):
            ret true
        end
        prev = b
    end
    ret false
end

func style_source_marks(a &: at.Ast, nid: int): bool:
    n := at.Get(a, nid)
    if n.synthetic or str.Len(n.src_file) == 0 or n.end_index <= n.begin_index:
        ret false
    end
    if not str.Equals(n.src_file, g_style_src_path):
        g_style_src_path = n.src_file
        g_style_src_text = os.ReadFile(n.src_file)
    end
    b := n.begin_index as int
    e := n.end_index as int
    if e > str.Len(g_style_src_text) or b < 0:
        ret false
    end
    ret style_has_fa_marks(str.Substr(g_style_src_text, b, e - b))
end

pub func StyleAttrOf(a &: at.Ast, attr: int, prop &: int, state &: int): bool:
    repeat g_style_attr_node.Len() in i:
        if g_style_attr_node[i] == attr and g_style_attr_ast[i] == a.uid:
            prop = g_style_attr_prop[i]
            state = g_style_attr_state[i]
            ret true
        end
    end
    ret false
end

pub func StyleAttrTextFor(a &: at.Ast, vid: int, prop: int): str:
    g_style_quote_strs = (style.Info(prop).items & 512) != 0
    t := StyleAttrText(a, vid)
    g_style_quote_strs = false
    ret t
end

pub func StyleAttrText(a &: at.Ast, vid: int): str:
    if vid == 0:
        ret ""
    end
    n := at.Get(a, vid)
    if n.kind != at.AST_TUPLE:
        ret style_attr_item_text(a, vid)
    end
    ret style_attr_group_text(a, vid)
end

pub func ResolveStyleAttr(name: str): StyleAttr:
    mut sa := StyleAttr {}
    mut rest := ""
    sa.state = style_state_prefix(name, rest)
    sa.prop = style.PropByName(rest)
    if sa.prop < 0:
        sa.prop = style_prop_loose(rest)
    end
    sa.ok = sa.prop >= 0
    ret sa
end

pub func StyleAttrParseStatic(prop: int, text: str, out &: style.Value): bool:
    ret style.Parse(prop, text, out)
end

pub func StyleAttrError(prop: int, text: str): str:
    ret style.Error(prop, text)
end

pub func StyleStandardHint(key: str, value: str): str:
    if str.Equals(key, "display"):
        if str.Equals(value, "flex") or str.Equals(value, "grid"):
            ret "layout = " + value
        end
        if str.Equals(value, "none"):
            ret "visible = false"
        end
        ret "layout"
    end
    if str.Equals(key, "flex-direction") or str.Equals(key, "flex_direction"):
        ret "layout"
    end
    if str.Equals(key, "position"):
        ret "position"
    end
    if str.Equals(key, "float") or str.Equals(key, "clear"):
        ret "layout = row"
    end
    if str.Equals(key, "visibility"):
        ret "visible"
    end
    if str.Equals(key, "box-shadow") or str.Equals(key, "box_shadow"):
        ret "shadow"
    end
    if str.Equals(key, "transform"):
        ret "translate, rotate, scale, skew"
    end
    if str.Equals(key, "text-decoration") or str.Equals(key, "text_decoration"):
        ret "decoration"
    end
    if str.Equals(key, "text-transform") or str.Equals(key, "text_transform"):
        ret "transform text"
    end
    if str.Equals(key, "white-space") or str.Equals(key, "white_space"):
        ret "white space"
    end
    ret ""
end

pub func StyleAttrCss(a &: at.Ast, attr: int): str:
    repeat g_style_attr_node.Len() in i:
        if g_style_attr_node[i] == attr and g_style_attr_ast[i] == a.uid:
            ret g_style_attr_css[i]
        end
    end
    ret ""
end

pub func StyleAttrDynOf(a &: at.Ast, attr: int, prop &: int, state &: int): bool:
    repeat g_style_dyn_node.Len() in i:
        if g_style_dyn_node[i] == attr and g_style_dyn_ast[i] == a.uid:
            prop = g_style_dyn_prop[i]
            state = g_style_dyn_state[i]
            ret true
        end
    end
    ret false
end

pub func StyleTextIsRuntime(text: str): bool:
    ret str.IndexOf(text, char_from_code(2)) >= 0
end

pub func StyleStaticText(prop: int, text: str): str:
    if (style.Info(prop).items & 512) != 0 and not str.StartsWith(text, "\"") and
        not str.StartsWith(text, "["):
        ret "\"" + text + "\""
    end
    ret text
end

pub func StyleAttrIsIntrinsicSize(a &: at.Ast, aid: int, ei: int, sa: StyleAttr): bool:
    if ei < 0 or sa.state != 0 or lay_native_target():
        ret false
    end
    tag := g_lay_elems.Get(ei).tag
    if not str.Equals(tag, "img") and not str.Equals(
        tag, "canvas"
    ) and not str.Equals(tag, "video"):
        ret false
    end
    pname := style.Info(sa.prop).name
    if not str.Equals(pname, "width") and not str.Equals(pname, "height"):
        ret false
    end
    vid := at.Get(a, aid).a
    if vid == 0:
        ret false
    end
    v := at.Get(a, vid)
    ret v.kind == at.AST_LITERAL and v.op == tok.TK_INT and str.Len(LayoutNumUnit(v.name)) == 0
end

pub func StyleAttrIsOwnEnum(a &: at.Ast, aid: int, ei: int, sa: StyleAttr): bool:
    if ei < 0 or sa.state != 0:
        ret false
    end
    vid := at.Get(a, aid).a
    if vid == 0:
        ret false
    end
    v := at.Get(a, vid)
    if not (v.kind == at.AST_LITERAL and v.value_kind == tok.TV_STRING and not v.synthetic):
        ret false
    end
    key := lay_attr_key(at.Get(a, aid).name)
    if str.Len(key) == 0:
        ret false
    end
    ai := lay_attr_for(ei, key)
    if ai < 0:
        ret false
    end
    own := g_lay_attrs.Get(ai)
    ret own.vtype == VT_ENUM and own.dest != LA_CSS and own.dest != LA_HTML_OR_CSS
end

pub func StyleAttrIsEvent(a &: at.Ast, aid: int): bool:
    key := lay_attr_key_exact(at.Get(a, aid).name)
    if str.Len(key) == 0:
        ret false
    end
    ai := lay_attr_for(0 - 1, key)
    if ai < 0 or g_lay_attrs.Get(ai).vtype != VT_CODE:
        ret false
    end
    vid := at.Get(a, aid).a
    if vid == 0:
        ret false
    end
    v := at.Get(a, vid)
    if v.kind == at.AST_LAMBDA:
        ret true
    end
    ret v.kind == at.AST_LITERAL and v.value_kind == tok.TV_STRING and str.IndexOf(
        v.value_str, "("
    ) >= 0
end

pub func StyleNumText(a &: at.Ast, nid: int, out &: str): bool:
    mut x := 0.0
    if at.KindOf(a, nid) != at.AST_BINARY or not style_num_eval(a, nid, x):
        ret false
    end
    out = co.Format1("%.10g", co.ArgFloat(x))
    ret true
end

pub func StyleTextHasFaMarks(text: str): bool:
    ret style_has_fa_marks(text)
end

pub func StyleSourceHasFaMarks(a &: at.Ast, nid: int): bool:
    ret style_source_marks(a, nid)
end

pub func StyleAttrSpelling(name: str, fa: bool): str:
    sa := ResolveStyleAttr(name)
    if not sa.ok:
        ret ""
    end
    prop := fa ? style.PropFaName(sa.prop) : style.PropName(sa.prop)
    if sa.state == STYLE_STATE_BASE:
        ret prop
    end
    order := [
        STYLE_STATE_HOVER, STYLE_STATE_FOCUS_WITHIN, STYLE_STATE_FOCUS, STYLE_STATE_ACTIVE,
        STYLE_STATE_DISABLED, STYLE_STATE_CHECKED, STYLE_STATE_INVALID, STYLE_STATE_PLACEHOLDER,
        STYLE_STATE_SELECTION
    ]
    words := style_state_words(fa)
    defer words.Free()
    repeat len(order) in i:
        if order[i] == sa.state:
            ret words.Get(i) + " " + prop
        end
    end
    ret ""
end

pub func StyleValueSpelling(attr: str, words: str, fa: bool): str:
    sa := ResolveStyleAttr(attr)
    if not sa.ok:
        ret ""
    end
    kw := style.KeywordByName(words)
    if kw > 0:
        mine := style.PropKeywords(sa.prop)
        defer mine.Free()
        each k in mine:
            if k == kw:
                ret fa ? style.KeywordFaName(kw) : style.KeywordName(kw)
            end
        end
        if kw >= style.KW_LINEAR and kw <= style.KW_EASE_IN_OUT and
            (style.Info(sa.prop).items & (1 << style.ITEM_EASE)) != 0:
            ret fa ? style.KeywordFaName(kw) : style.KeywordName(kw)
        end
    end
    if (style.Info(sa.prop).items & (1 << style.ITEM_COLOR)) == 0:
        ret ""
    end
    lay_ensure()
    canon := lay_dyn_value("color", words)
    if str.Len(canon) == 0 or not fa:
        ret canon
    end
    spelled := lay_value_spell_fa("color", canon)
    mut probe := style.Value {}
    if str.Len(spelled) == 0 or not style.Parse(style.P_COLOR, spelled, probe):
        ret ""
    end
    ret spelled
end
