package semantic

import str

include co "../sal_core.salam"
include at "../ast.salam"
include i18 "../i18n.salam"

pub const UI_WEB_ONLY_CODE := 165

pub const UI_NATIVE_SKIP_CODE := 166

func lay_native_target(): bool:
    ret g_sm_ui_target == UI_NATIVE
end

func lay_check_native_elem(s &: Sema, a &: at.Ast, el: int, ei: int):
    if not lay_native_target():
        ret
    end
    e := g_lay_elems.Get(ei)
    if e.native == LN_WEB_ONLY:
        serr(
            s, UI_WEB_ONLY_CODE, span_of(a, el), co.Format1(
                i18.Tr("'%s' works only on the web; wrap it in 'if SALAM_UI_WEB:' or remove it for the native target"), co.ArgStr(lay_elem_display(ei))
            )
        )
    else e.native == LN_SKIP:
        swarn(
            s, UI_NATIVE_SKIP_CODE, span_of(a, el), co.Format1(
                i18.Tr("'%s' is web page metadata and is ignored by the native target"), co.ArgStr(lay_elem_display(ei))
            )
        )
    end
end

func lay_check_native_attr(s &: Sema, a &: at.Ast, aid: int, ai: int, key: str):
    if not lay_native_target():
        ret
    end
    av := g_lay_attrs.Get(ai)
    if av.native == LN_WEB_ONLY:
        serr(
            s, UI_WEB_ONLY_CODE, span_of(a, aid), co.Format1(
                i18.Tr("attribute '%s' works only on the web; wrap its element in 'if SALAM_UI_WEB:' or remove it for the native target"), co.ArgStr(lay_attr_display(key))
            )
        )
    else av.native == LN_SKIP:
        swarn(
            s, UI_NATIVE_SKIP_CODE, span_of(a, aid), co.Format1(
                i18.Tr("attribute '%s' only matters on the web and is ignored by the native target"), co.ArgStr(lay_attr_display(key))
            )
        )
    end
end

pub func SetUiTarget(target: int):
    g_sm_ui_target = target
end

pub func UiTarget(): int:
    ret g_sm_ui_target
end
