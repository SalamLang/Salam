package semantic

import str

include co "../sal_core.salam"
include tok "../token.salam"
include at "../ast.salam"

func lay_when_find_attr(a &: at.Ast, nid: int, kept: Vector<int>, name: str): int:
    repeat at.ChildCount(a, nid) in m:
        oid := at.Child(a, nid, m)
        if at.KindOf(a, oid) == at.AST_LAYOUT_ATTR and str.Equals(at.Get(a, oid).name, name):
            ret oid
        end
    end
    repeat kept.Len() in i:
        cid := kept.Get(i)
        if at.KindOf(a, cid) == at.AST_LAYOUT_ATTR and str.Equals(at.Get(a, cid).name, name):
            ret cid
        end
    end
    ret 0
end

func lay_when_ternary(a &: at.Ast, cond: int, thenv: int, elsev: int): int:
    n := at.NewNode(a, at.AST_TERNARY)
    src := at.Get(a, cond)
    at.SetSpan(a, n, src.begin_line, src.begin_col, src.begin_index, src.end_line, src.end_col, src.end_index, src.length)
    mut m := at.Get(a, n)
    m.a = at.Clone(a, cond)
    m.b = thenv
    m.c = elsev
    at.Put(a, n, m)
    ret n
end

func lay_when_block_ok(a &: at.Ast, wid: int): bool:
    repeat at.ChildCount(a, wid) in i:
        if at.KindOf(a, at.Child(a, wid, i)) != at.AST_LAYOUT_ATTR:
            ret false
        end
    end
    ret true
end

func lay_when_lower(a &: at.Ast, nid: int):
    mut found := false
    repeat at.ChildCount(a, nid) in i:
        if at.KindOf(a, at.Child(a, nid, i)) == at.AST_LAYOUT_WHEN:
            found = true
        end
    end
    if not found:
        ret
    end
    mut kept := Vector {} as Vector<int>
    repeat at.ChildCount(a, nid) in j:
        cid := at.Child(a, nid, j)
        if at.KindOf(a, cid) != at.AST_LAYOUT_WHEN:
            kept.Push(cid)
            continue
        end
        if not lay_when_block_ok(a, cid):
            kept.Push(cid)
            continue
        end
        cond := at.Get(a, cid).a
        repeat at.ChildCount(a, cid) in k:
            gid := at.Child(a, cid, k)
            lay_localize_attr(a, gid)
            g := at.Get(a, gid)
            bid := lay_when_find_attr(a, nid, kept, g.name)
            if bid != 0:
                bv := at.Get(a, bid).a
                mut bn := at.Get(a, bid)
                bn.a = lay_when_ternary(a, cond, g.a, bv)
                at.Put(a, bid, bn)
            else:
                empty := lay_mk_literal(a, cond, LayVal { kind = LV_STR, s = "" })
                mut gn := at.Get(a, gid)
                gn.a = lay_when_ternary(a, cond, g.a, empty)
                at.Put(a, gid, gn)
                kept.Push(gid)
            end
        end
    end
    mut parent := at.Get(a, nid)
    parent.list = kept
    at.Put(a, nid, parent)
end
