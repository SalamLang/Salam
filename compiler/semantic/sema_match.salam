package semantic

import str

include co "../sal_core.salam"
include tok "../token.salam"
include at "../ast.salam"
include i18 "../i18n.salam"

func sm_catf256(buf &: str, off: int, piece: str): int:
    if off >= 256:
        ret off
    end
    n := str.Len(piece)
    room := 256 - off
    mut wrote := n
    if wrote >= room:
        wrote = room - 1
    end
    buf = buf + str.Substr(piece, 0, wrote)
    ret off + wrote
end

func rewrite_tail_expr(a &: at.Ast, block: int):
    if block == 0 || at.ChildCount(a, block) == 0:
        ret
    end
    lasti := at.ChildCount(a, block) - 1
    last := at.Child(a, block, lasti)
    if at.KindOf(a, last) != at.AST_EXPR_STMT:
        ret
    end
    rid := new_node_at(a, at.AST_RETURN, span_of(a, last))
    mut rv := at.Get(a, rid)
    rv.synthetic = true
    rv.a = at.Get(a, last).a
    at.Put(a, rid, rv)
    mut bv := at.Get(a, block)
    bv.list.set(lasti, rid)
    at.Put(a, block, bv)
end

func types_comparable(s &: Sema, ta: int, tb: int): bool:
    if type_is_error(s, ta) || type_is_error(s, tb):
        ret true
    end
    if type_equiv(s, ta, tb):
        ret true
    end
    ret type_is_numeric(s, ta) && type_is_numeric(s, tb) && type_common_arith(s, ta, tb) >= 0
end

func check_match_pattern(
    s &: Sema, a &: at.Ast, pat: int, subj: int, subj_is_variant: bool, subj_is_enum: bool
): int:
    pv := at.Get(a, pat)
    psp := span_of(a, pat)
    if subj_is_variant:
        if at.KindOf(a, pv.a) != at.AST_IDENTIFIER:
            serr(
                s, 76, psp, i18.Tr("expected a type-name pattern to match a Variant subject")
            )
            ret 0 - 1
        end
        pt := sema_resolve_type(s, a, pv.a)
        if type_is_error(s, pt):
            ret 0 - 1
        end
        tag := type_variant_tag(s, subj, pt)
        if tag < 0:
            serr(
                s, 75, psp, co.Format2(
                    i18.Tr("match arm pattern type '%s' is not a member of '%s'"), co.ArgStr(type_disp(s, pt)), co.ArgStr(type_disp(s, subj))
                )
            )
        end
        at.SetTypeStr(a, pat, type_to_string(s, pt))
        mut pv2 := at.Get(a, pat)
        pv2.value_kind = tok.TV_INT
        pv2.value_int = (tag < 0 ? 0 : tag) as u64
        at.Put(a, pat, pv2)
        ret tag
    end

    if str.Len(pv.name) > 0:
        serr(
            s, 77, psp, co.Format1(
                i18.Tr("value pattern used on a non-Variant match subject of type '%s'; a type-name pattern (with an optional binding) is only valid when matching a Variant"), co.ArgStr(type_disp(s, subj))
            )
        )
    end

    ak := at.KindOf(a, pv.a)
    if ak == at.AST_LITERAL:
        s.expected = subj
        pt2 := sema_check_expr(s, a, pv.a)
        s.expected = TYPE_NONE
        if !types_comparable(s, subj, pt2):
            serr(
                s, 21, psp, co.Format2(
                    i18.Tr("cannot compare '%s' and '%s'"), co.ArgStr(type_disp(s, subj)), co.ArgStr(type_disp(s, pt2))
                )
            )
        end
    else ak == at.AST_IDENTIFIER:
        if subj_is_enum:
            syd := ty_at(s, subj).decl
            pname := at.Get(a, pv.a).name
            mut m := 0
            if syd != 0 && sym_at(s, syd).members != 0:
                m = scope_lookup_local(s, sym_at(s, syd).members, pname)
            end
            if m == 0:
                serr(
                    s, 16, span_of(a, pv.a), co.Format2(
                        i18.Tr("enum '%s' has no member '%s'"), co.ArgStr(syd != 0 ? sym_at(s, syd).name : "?"), co.ArgStr(pname)
                    )
                )
            else:
                mem := new_node_at(a, at.AST_MEMBER, span_of(a, pv.a))
                idn := new_node_at(a, at.AST_IDENTIFIER, span_of(a, pv.a))
                mut iv := at.Get(a, idn)
                iv.synthetic = true
                iv.name = sym_at(s, syd).name
                at.Put(a, idn, iv)
                mut mv := at.Get(a, mem)
                mv.synthetic = true
                mv.a = idn
                mv.name = pname
                at.Put(a, mem, mv)
                mut pv3 := at.Get(a, pat)
                pv3.a = mem
                at.Put(a, pat, pv3)
                _mt := sema_check_expr(s, a, mem)
            end
        else:
            pt3 := sema_check_expr(s, a, pv.a)
            if !types_comparable(s, subj, pt3):
                serr(
                    s, 21, psp, co.Format2(
                        i18.Tr("cannot compare '%s' and '%s'"), co.ArgStr(type_disp(s, subj)), co.ArgStr(type_disp(s, pt3))
                    )
                )
            end
        end
    end
    ret 0 - 1
end

func sema_check_match(
    s &: Sema, a &: at.Ast, nid: int, is_expr: bool, expected: int
): int:
    exp := expected
    s.expected = TYPE_NONE
    subj := sema_check_expr(s, a, at.Get(a, nid).a)
    mut nv0 := at.Get(a, nid)
    nv0.match_is_expr = is_expr
    at.Put(a, nid, nv0)

    subj_is_variant := subj >= 0 && ty_at(s, subj).kind == TY_VARIANT
    subj_is_enum := subj >= 0 && ty_at(s, subj).kind == TY_ENUM
    mut has_wildcard := false

    mut arm_types := Vector {} as Vector<int>
    defer arm_types.free()
    mut arm_yoff := Vector {} as Vector<int>
    defer arm_yoff.free()
    mut arm_ycnt := Vector {} as Vector<int>
    defer arm_ycnt.free()
    mut yr_rets := Vector {} as Vector<int>
    defer yr_rets.free()
    mut yr_tys := Vector {} as Vector<int>
    defer yr_tys.free()
    mut seen_members := Vector {} as Vector<int>
    defer seen_members.free()
    mut seen_tags := Vector {} as Vector<int>
    defer seen_tags.free()

    mut ai := 0
    until ai < at.ChildCount(a, nid):
        arm := at.Child(a, nid, ai)
        ai += 1
        mut arm_ty := TYPE_NONE
        mut coll_off := 0 - 1
        mut coll_cnt := 0

        struct_arm_prepare(s, a, arm, subj)
        tags_mark := seen_tags.len()
        mems_mark := seen_members.len()
        if at.Get(a, arm).op == tok.TK_KW_ELSE:
            has_wildcard = has_wildcard || at.Get(a, arm).c == 0
        else:
            mut pi := 0
            until pi < at.ChildCount(a, arm):
                pat := at.Child(a, arm, pi)
                pi += 1
                if subj_is_variant && enum_data_sym(s, subj) != 0 && !enum_pattern_prepare(s, a, arm, pat, subj):
                    continue
                end
                tag := check_match_pattern(
                    s, a, pat, subj, subj_is_variant, subj_is_enum
                )
                if subj_is_variant:
                    if tag >= 0:
                        mut dup := false
                        repeat seen_tags.len() in k:
                            if seen_tags.get(k) == tag:
                                dup = true
                                break
                            end
                        end
                        if dup:
                            serr(
                                s, 78, span_of(a, pat), i18.Tr("duplicate match arm pattern")
                            )
                        else:
                            seen_tags.push(tag)
                        end
                        if !dup && str.Len(at.Get(a, pat).name) > 0 && at.ChildCount(a, arm) == 1:
                            psp2 := span_of(a, pat)
                            decl := new_node_at(a, at.AST_VAR_DECL, psp2)
                            unwrap := new_node_at(
                                a, at.AST_VARIANT_UNWRAP, psp2
                            )
                            mut uv := at.Get(a, unwrap)
                            uv.synthetic = true
                            uv.unwrap_subj = true
                            uv.a = at.Clone(a, at.Get(a, nid).a)
                            uv.ty = at.Get(a, pat).a
                            at.Put(a, unwrap, uv)
                            mut dv := at.Get(a, decl)
                            dv.synthetic = true
                            dv.name = at.Get(a, pat).name
                            dv.a = unwrap
                            at.Put(a, decl, dv)
                            armb := at.Get(a, arm).b
                            mut bv := at.Get(a, armb)
                            mut newlist := Vector {} as Vector<int>
                            newlist.push(decl)
                            repeat bv.list.len() in k2:
                                newlist.push(bv.list.get(k2))
                            end
                            mut old := bv.list
                            bv.list = newlist
                            at.Put(a, armb, bv)
                            old.free()
                        end
                    end
                else subj_is_enum && at.KindOf(a, at.Get(a, pat).a) == at.AST_MEMBER:
                    syd2 := ty_at(s, subj).decl
                    pname2 := at.Get(a, at.Get(a, pat).a).name
                    mut m2 := 0
                    if syd2 != 0 && sym_at(s, syd2).members != 0:
                        m2 = scope_lookup_local(
                            s, sym_at(s, syd2).members, pname2
                        )
                    end
                    if m2 != 0:
                        mut dup2 := false
                        repeat seen_members.len() in k3:
                            if seen_members.get(k3) == m2:
                                dup2 = true
                                break
                            end
                        end
                        if dup2:
                            serr(
                                s, 78, span_of(a, pat), co.Format1(
                                    i18.Tr("duplicate match arm pattern '%s'"), co.ArgStr(pname2)
                                )
                            )
                        else:
                            seen_members.push(m2)
                        end
                    end
                end
            end
            if at.ChildCount(a, arm) > 1:
                repeat at.ChildCount(a, arm) in pi2:
                    pat2 := at.Child(a, arm, pi2)
                    if str.Len(at.Get(a, pat2).name) > 0:
                        serr(
                            s, 76, span_of(a, pat2), i18.Tr("a match arm with multiple patterns cannot bind a name; use a single-pattern arm to bind, e.g. 'i32 n =>'")
                        )
                    end
                end
            end
        end
        if at.Get(a, arm).c != 0:
            until seen_tags.len() > tags_mark:
                _pt := seen_tags.pop()
            end
            until seen_members.len() > mems_mark:
                _pm := seen_members.pop()
            end
            match_guard_check(s, a, arm)
        end

        if is_expr:
            rewrite_tail_expr(a, at.Get(a, arm).b)
        end

        if is_expr:
            saved_depth := s.match_arm_depth
            saved_yexp := s.match_yield_expected
            saved_vec := s.match_yield_collect
            saved_act := s.match_yield_active
            s.match_yield_collect = Vector {} as Vector<MatchYield>
            s.match_arm_depth = saved_depth + 1
            s.match_yield_expected = exp
            s.match_yield_active = true
            sema_check_block(s, a, at.Get(a, arm).b)
            mut collected := s.match_yield_collect
            s.match_arm_depth = saved_depth
            s.match_yield_expected = saved_yexp
            s.match_yield_collect = saved_vec
            s.match_yield_active = saved_act

            if collected.len() == 0:
                serr(
                    s, 81, span_of(a, arm), i18.Tr("'match' used as an expression must have arms that all produce a value")
                )
                arm_ty = sema_err_ty(s)
            else:
                mut t0 := collected.get(0).ty
                mut ok := true
                mut yi := 1
                until yi < collected.len():
                    yt := collected.get(yi).ty
                    yi += 1
                    if type_equiv(s, t0, yt):
                        continue
                    end
                    if type_is_numeric(s, t0) && type_is_numeric(s, yt):
                        c := type_common_arith(s, t0, yt)
                        if c >= 0:
                            t0 = c
                            continue
                        end
                    end
                    ok = false
                end
                if !ok:
                    serr(
                        s, 81, span_of(a, arm), i18.Tr("match arm produces different types on different code paths")
                    )
                    arm_ty = sema_err_ty(s)
                else:
                    arm_ty = t0
                end
            end
            coll_off = yr_rets.len()
            coll_cnt = collected.len()
            repeat collected.len() in ci:
                y := collected.get(ci)
                yr_rets.push(y.ret_node)
                yr_tys.push(y.ty)
            end
            collected.free()
        else:
            sema_check_block(s, a, at.Get(a, arm).b)
        end

        arm_types.push(arm_ty)
        arm_yoff.push(coll_off)
        arm_ycnt.push(coll_cnt)
    end

    if !has_wildcard && subj_is_enum && ty_at(s, subj).decl != 0:
        syid := ty_at(s, subj).decl
        sy := sym_at(s, syid)
        mut total := 0
        if sy.members != 0:
            msc5 := scope_at(s, sy.members)
            total = msc5.symbols.len()
        end
        if seen_members.len() < total:
            msyms := scope_at(s, sy.members).symbols
            mut buf := ""
            mut o := 0
            mut mi := 0
            until mi < msyms.len() && o < 224:
                mid := msyms.get(mi)
                mut covered := false
                repeat seen_members.len() in k4:
                    if seen_members.get(k4) == mid:
                        covered = true
                        break
                    end
                end
                if !covered:
                    o = sm_catf256(
                        buf, o, (o > 0 ? ", " : "") + sym_at(s, mid).name
                    )
                end
                mi += 1
            end
            if mi < msyms.len():
                o = sm_catf256(buf, o, ", ...")
            end
            serr(
                s, 80, span_of(a, nid), co.Format3(
                    i18.Tr("non-exhaustive match on enum '%s': missing member%s %s"), co.ArgStr(sy.name), co.ArgStr(plural_suffix(total - seen_members.len())), co.ArgStr(buf)
                )
            )
        end
    end
    if !has_wildcard && subj_is_variant && !at.Get(a, nid).synthetic:
        vparams := ty_at(s, subj).params
        total2 := vparams.len()
        if seen_tags.len() < total2:
            mut buf2 := ""
            mut o2 := 0
            mut ti := 0
            until ti < total2 && o2 < 224:
                mut covered2 := false
                repeat seen_tags.len() in k5:
                    if seen_tags.get(k5) == ti:
                        covered2 = true
                        break
                    end
                end
                if !covered2:
                    ced := enum_data_disp(s, vparams.get(ti))
                    o2 = sm_catf256(
                        buf2, o2, (o2 > 0 ? ", " : "") + (str.Len(ced) > 0 ? ced : type_to_string(s, vparams.get(ti)))
                    )
                end
                ti += 1
            end
            if ti < total2:
                o2 = sm_catf256(buf2, o2, ", ...")
            end
            if enum_data_sym(s, subj) != 0:
                serr(
                    s, 79, span_of(a, nid), co.Format3(
                        i18.Tr("non-exhaustive match on enum '%s': missing member%s %s (or add an 'else' arm)"), co.ArgStr(type_disp(s, subj)), co.ArgStr(plural_suffix(total2 - seen_tags.len())), co.ArgStr(buf2)
                    )
                )
            else:
                serr(
                    s, 79, span_of(a, nid), co.Format3(
                        i18.Tr("non-exhaustive match on Variant '%s': missing case%s for %s"), co.ArgStr(type_disp(s, subj)), co.ArgStr(plural_suffix(total2 - seen_tags.len())), co.ArgStr(buf2)
                    )
                )
            end
        end
    end

    if !is_expr:
        ret sema_decorate(s, a, nid, sema_ty(s, TY_VOID))
    end

    mut first := TYPE_NONE
    mut all_equiv := true
    mut unified := TYPE_NONE
    repeat arm_types.len() in k6:
        t := arm_types.get(k6)
        if t < 0 || type_is_error(s, t):
            continue
        end
        if first < 0:
            first = t
            continue
        end
        if !type_equiv(s, first, t):
            all_equiv = false
        end
    end

    if first < 0:
        unified = sema_err_ty(s)
    else all_equiv:
        unified = first
    else:
        mut acc := TYPE_NONE
        mut numeric_ok := true
        repeat arm_types.len() in k7:
            t2 := arm_types.get(k7)
            if t2 < 0 || type_is_error(s, t2):
                continue
            end
            if acc < 0:
                acc = t2
                continue
            end
            c2 := type_common_arith(s, acc, t2)
            if c2 < 0:
                numeric_ok = false
                break
            end
            acc = c2
        end
        if numeric_ok && acc >= 0:
            unified = acc
        else:
            mut vmem := Vector {} as Vector<int>
            repeat arm_types.len() in k8:
                t3 := arm_types.get(k8)
                if t3 < 0 || type_is_error(s, t3):
                    continue
                end
                mut dup3 := false
                repeat vmem.len() in j8:
                    if type_equiv(s, vmem.get(j8), t3):
                        dup3 = true
                        break
                    end
                end
                if dup3:
                    continue
                end
                if vmem.len() >= 64:
                    serr(
                        s, 1, span_of(a, nid), i18.Tr("match expression has too many distinct arm types (max 64)")
                    )
                    break
                end
                vmem.push(t3)
            end
            unified = type_variant_new(s, vmem)
            vmem.free()
        end
    end

    if ty_at(s, unified).kind == TY_VARIANT:
        repeat arm_types.len() in k9:
            att := arm_types.get(k9)
            yoff := arm_yoff.get(k9)
            if att < 0 || type_is_error(s, att) || yoff < 0:
                continue
            end
            tag2 := type_variant_tag(s, unified, att)
            if tag2 < 0:
                continue
            end
            repeat arm_ycnt.get(k9) in yi2:
                rid2 := yr_rets.get(yoff + yi2)
                na := coerce_to_variant(s, a, unified, at.Get(a, rid2).a, tag2)
                mut rv2 := at.Get(a, rid2)
                rv2.a = na
                at.Put(a, rid2, rv2)
            end
        end
    end

    at.SetTypeStr(a, nid, type_to_string(s, unified))
    ret sema_decorate(s, a, nid, unified)
end

func guard_subst(a &: at.Ast, nid: int, names: Vector<str>, inits: Vector<int>, used &: Vector<int>, depth: int):
    if nid == 0 || depth > 32:
        ret
    end
    n := at.Get(a, nid)
    if n.kind == at.AST_IDENTIFIER:
        repeat names.len() in i:
            if str.Equals(names.get(i), n.name):
                used.push(i)
                cl := at.Clone(a, inits.get(i))
                at.Put(a, nid, at.Get(a, cl))
                guard_subst(a, nid, names, inits, used, depth + 1)
                ret
            end
        end
        ret
    end
    if n.kind == at.AST_LAMBDA:
        ret
    end
    guard_subst(a, n.a, names, inits, used, depth)
    guard_subst(a, n.b, names, inits, used, depth)
    guard_subst(a, n.c, names, inits, used, depth)
    guard_subst(a, n.d, names, inits, used, depth)
    repeat n.list.len() in j:
        guard_subst(a, n.list.get(j), names, inits, used, depth)
    end
end

func match_guard_check(s &: Sema, a &: at.Ast, arm: int):
    guard := at.Get(a, arm).c
    body := at.Get(a, at.Get(a, arm).b).list
    mut names := Vector {} as Vector<str>
    mut inits := Vector {} as Vector<int>
    mut decls := Vector {} as Vector<int>
    mut used := Vector {} as Vector<int>
    defer names.free()
    defer inits.free()
    defer decls.free()
    defer used.free()
    repeat body.len() in i:
        d := at.Get(a, body.get(i))
        if d.kind != at.AST_VAR_DECL || !(d.synthetic || d.enum_payload):
            break
        end
        names.push(d.name)
        inits.push(d.a)
        decls.push(body.get(i))
    end
    guard_subst(a, guard, names, inits, used, 0)
    if used.len() > 0:
        armb := at.Get(a, arm).b
        mut bv := at.Get(a, armb)
        mut nl := Vector {} as Vector<int>
        repeat decls.len() in k:
            nl.push(bv.list.get(k))
        end
        repeat names.len() in u:
            mut hit := false
            repeat used.len() in u2:
                if used.get(u2) == u:
                    hit = true
                end
            end
            if !hit || byte_at(names.get(u), 0) == 95:
                continue
            end
            dsp := span_of(a, decls.get(u))
            ref := new_node_at(a, at.AST_IDENTIFIER, dsp)
            at.SetName(a, ref, names.get(u))
            dis := new_node_at(a, at.AST_VAR_DECL, dsp)
            mut disv := at.Get(a, dis)
            disv.name = "_"
            disv.a = ref
            disv.synthetic = true
            at.Put(a, dis, disv)
            nl.push(dis)
        end
        repeat bv.list.len() - decls.len() in k2:
            nl.push(bv.list.get(decls.len() + k2))
        end
        old := bv.list
        bv.list = nl
        at.Put(a, armb, bv)
        old.free()
    end
    gt := sema_check_expr(s, a, guard)
    if !type_is_error(s, gt) && ty_at(s, gt).kind != TY_BOOL:
        serr(
            s, 2, span_of(a, guard), co.Format1(
                i18.Tr("a match guard must be a bool, not '%s'"), co.ArgStr(type_disp(s, gt))
            )
        )
    end
end

func sp_binary(a &: at.Ast, sp: co.SrcSpan, op: int, x: int, y: int): int:
    b := new_node_at(a, at.AST_BINARY, sp)
    mut bv := at.Get(a, b)
    bv.op = op
    bv.a = x
    bv.b = y
    at.Put(a, b, bv)
    ret b
end

func sp_member(a &: at.Ast, sp: co.SrcSpan, base: int, field: str): int:
    m := new_node_at(a, at.AST_MEMBER, sp)
    at.SetName(a, m, field)
    mut mv := at.Get(a, m)
    mv.a = base
    at.Put(a, m, mv)
    ret m
end

func sp_base(a &: at.Ast, sp: co.SrcSpan, hidden: str, subj: int): int:
    id := new_node_at(a, at.AST_IDENTIFIER, sp)
    if str.Len(hidden) > 0:
        at.SetName(a, id, hidden)
        ret id
    end
    mut iv := at.Get(a, id)
    iv.name = "__msubject"
    iv.unwrap_subj = true
    iv.sema_type = subj
    at.Put(a, id, iv)
    ret id
end

func struct_arm_prepare(s &: Sema, a &: at.Ast, arm: int, subj: int):
    armv := at.Get(a, arm)
    if armv.op == tok.TK_KW_ELSE || armv.list.len() == 0:
        ret
    end
    mut any := false
    repeat armv.list.len() in i:
        if at.Get(a, armv.list.get(i)).op == tok.TK_LBRACE:
            any = true
        end
    end
    if !any:
        ret
    end
    pat := armv.list.get(0)
    pv := at.Get(a, pat)
    sp := span_of(a, pat)
    if armv.list.len() != 1:
        serr(s, 76, sp, i18.Tr("a pattern with '{ ... }' must be the only pattern of its arm"))
        ret
    end
    pname := pv.a != 0 ? at.Get(a, pv.a).name : ""
    mut hidden := ""
    mut owner := 0
    esym := enum_data_sym(s, subj)
    if esym != 0:
        ci := enum_case_index(s, subj, pname)
        if ci < 0:
            serr(
                s, 16, sp, co.Format2(
                    i18.Tr("enum '%s' has no member '%s'"), co.ArgStr(sym_at(s, esym).name), co.ArgStr(pname)
                )
            )
            ret
        end
        owner = enum_case_struct(s, subj, ci)
        hidden = "__pb" + str.FromInt(pat as i64)
    else:
        owner = struct_sym_of(s, subj)
        if owner == 0 || subj < 0 || ty_at(s, subj).kind != TY_STRUCT:
            serr(
                s, 76, sp, co.Format1(
                    i18.Tr("a '{ ... }' pattern needs a struct or an enum with data to match, not '%s'"), co.ArgStr(type_disp(s, subj))
                )
            )
            ret
        end
        oname := sym_at(s, owner).name
        mut short := pname
        pdot := str.IndexOf(short, ".")
        if pdot >= 0:
            short = str.Substr(short, pdot + 1, str.Len(short) - pdot - 1)
        end
        if !str.Equals(short, oname) && !str.Equals(short, sym_at(s, owner).generic_base):
            serr(
                s, 75, sp, co.Format2(
                    i18.Tr("pattern '%s' does not match the subject's type '%s'"), co.ArgStr(pname), co.ArgStr(type_disp(s, subj))
                )
            )
            mut bad := at.Get(a, arm)
            bad.op = tok.TK_KW_ELSE
            bad.list = Vector {} as Vector<int>
            at.Put(a, arm, bad)
            ret
        end
    end
    mut tests := 0
    mut decls := Vector {} as Vector<int>
    defer decls.free()
    repeat pv.list.len() in j:
        fi := at.Get(a, pv.list.get(j))
        fsp := span_of(a, pv.list.get(j))
        f := scope_lookup_local(s, sym_at(s, owner).members, fi.name)
        if f == 0 || sym_at(s, f).kind != SYM_FIELD || str.Equals(fi.name, "_unit"):
            serr(
                s, 16, fsp, co.Format2(
                    i18.Tr("'%s' has no field '%s'"), co.ArgStr(pname), co.ArgStr(fi.name)
                )
            )
            continue
        end
        if fi.a != 0:
            cmp := sp_binary(a, fsp, tok.TK_EQ, sp_member(a, fsp, sp_base(a, fsp, hidden, subj), fi.name), fi.a)
            tests = tests == 0 ? cmp : sp_binary(a, fsp, tok.TK_AND, tests, cmp)
            continue
        end
        decl := new_node_at(a, at.AST_VAR_DECL, fsp)
        mut dv := at.Get(a, decl)
        dv.name = fi.name
        dv.a = sp_member(a, fsp, sp_base(a, fsp, hidden, subj), fi.name)
        dv.enum_payload = true
        at.Put(a, decl, dv)
        decls.push(decl)
    end
    armb := at.Get(a, arm).b
    mut bv := at.Get(a, armb)
    mut nl := Vector {} as Vector<int>
    repeat decls.len() in k:
        nl.push(decls.get(k))
    end
    repeat bv.list.len() in k2:
        nl.push(bv.list.get(k2))
    end
    old := bv.list
    bv.list = nl
    at.Put(a, armb, bv)
    old.free()
    mut pv2 := at.Get(a, pat)
    pv2.op = 0
    pv2.list = Vector {} as Vector<int>
    mut av := at.Get(a, arm)
    if str.Len(hidden) > 0:
        pv2.name = hidden
    else:
        av.op = tok.TK_KW_ELSE
        av.list = Vector {} as Vector<int>
    end
    at.Put(a, pat, pv2)
    if tests != 0:
        av.c = av.c == 0 ? tests : sp_binary(a, sp, tok.TK_AND, tests, av.c)
    end
    at.Put(a, arm, av)
end
