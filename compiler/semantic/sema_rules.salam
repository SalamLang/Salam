package semantic

import str

include co "../sal_core.salam"
include at "../ast.salam"
include i18 "../i18n.salam"
include lp "../langpack.salam"
include tok "../token.salam"

const RULE_SEARCH_MAX := 16

func rule_field_canon(a &: at.Ast, did: int, name: str): str:
    d := at.Get(a, did)
    repeat d.list.len() in i:
        m := at.Get(a, d.list.get(i))
        if m.kind != at.AST_FIELD:
            continue
        end
        al := at.Aliases(a, m.ext)
        if su_ident_eq(m.name, name) or aliases_have(al, "en", name) or aliases_have(al, "fa", name):
            ret m.name
        end
    end
    ret ""
end

func rule_field_node(a &: at.Ast, did: int, name: str): int:
    d := at.Get(a, did)
    repeat d.list.len() in i:
        mid := d.list.get(i)
        m := at.Get(a, mid)
        if m.kind == at.AST_FIELD and str.Equals(m.name, name):
            ret mid
        end
    end
    ret 0
end

func rule_field_suggest(a &: at.Ast, did: int, name: str): str:
    mut cands := Vector {} as Vector<str>
    defer cands.free()
    d := at.Get(a, did)
    repeat d.list.len() in i:
        m := at.Get(a, d.list.get(i))
        if m.kind == at.AST_FIELD:
            cands.push(m.name)
        end
    end
    ret sema_suggest_list(name, cands)
end

func struct_rules_resolve_all(s &: Sema, a &: at.Ast, program: int):
    save_file := s.file
    repeat at.ChildCount(a, program) in i:
        did := at.Child(a, program, i)
        if at.KindOf(a, did) == at.AST_STRUCT_DEF and not at.Get(a, did).synthetic:
            if at.Rules(a, at.Get(a, did).ext).len() > 0:
                _sf := sema_use_decl_file(s, a, did)
                struct_rules_resolve(s, a, did)
            end
        end
    end
    s.file = save_file
end

func struct_rules_resolve(s &: Sema, a &: at.Ast, did: int):
    d := at.Get(a, did)
    rules := at.Rules(a, d.ext)
    repeat rules.len() in i:
        rid := rules.get(i)
        r := at.Get(a, rid)
        mut ok := str.Len(r.name) > 0
        repeat r.list.len() in j:
            nid := r.list.get(j)
            nm := at.Get(a, nid).name
            canon := rule_field_canon(a, did, nm)
            if str.Len(canon) == 0:
                serr(
                    s, 160, span_of(a, nid), co.Format2(
                        i18.Tr("unknown field '%s' in a rule of struct '%s'"), co.ArgStr(nm), co.ArgStr(d.name)
                    ) + rule_field_suggest(a, did, nm)
                )
                ok = false
            else:
                at.SetName(a, nid, canon)
            end
        end
        if not ok:
            at.SetName(a, rid, "")
        end
    end
end

func rule_is_needs(r: at.Node): bool:
    ret str.Equals(r.name, "needs")
end

func rule_names(a &: at.Ast, r: at.Node): str:
    mut out := ""
    repeat r.list.len() in i:
        if i > 0:
            out = out + ", "
        end
        out = out + "'" + at.Get(a, r.list.get(i)).name + "'"
    end
    ret out
end

func rule_plain_names(a &: at.Ast, r: at.Node, start: int): str:
    fa := str.Equals(i18.Lang(), "fa")
    mut out := ""
    mut i := start
    until i < r.list.len():
        if i > start:
            out = out + (fa ? "، " : ", ")
        end
        out = out + at.Get(a, r.list.get(i)).name
        i += 1
    end
    ret out
end

func rule_is_plain_value(a &: at.Ast, nid: int): bool:
    k := at.KindOf(a, nid)
    if k == at.AST_LITERAL:
        ret true
    end
    if k == at.AST_UNARY or k == at.AST_CAST:
        ret rule_is_plain_value(a, at.Get(a, nid).a)
    end
    ret false
end

func rule_root_ok(s &: Sema, a &: at.Ast, nid: int): bool:
    mut cur := nid
    until cur != 0 and at.KindOf(a, cur) == at.AST_MEMBER:
        cur = at.Get(a, cur).a
    end
    if cur == 0 or at.KindOf(a, cur) != at.AST_IDENTIFIER:
        ret false
    end
    sy := scope_lookup(s, s.cur, at.Get(a, cur).name)
    if sy == 0:
        ret true
    end
    k := sym_at(s, sy).kind
    ret k == SYM_ENUM or k == SYM_ALIAS or k == SYM_PACKAGE
end

func rule_const_init(s &: Sema, a &: at.Ast, nid: int): int:
    n := at.Get(a, nid)
    mut sy := 0
    if n.kind == at.AST_IDENTIFIER:
        sy = scope_lookup(s, s.cur, n.name)
    else n.kind == at.AST_MEMBER and n.a != 0 and at.KindOf(a, n.a) == at.AST_IDENTIFIER:
        pk := scope_lookup(s, s.cur, at.Get(a, n.a).name)
        if pk != 0 and sym_at(s, pk).kind == SYM_PACKAGE and sym_at(s, pk).members != 0:
            sy = scope_lookup_local(s, sym_at(s, pk).members, n.name)
        end
    end
    if sy == 0 or sym_at(s, sy).kind != SYM_CONST or sym_at(s, sy).is_mut or sym_at(s, sy).decl == 0:
        ret 0
    end
    ret at.Get(a, sym_at(s, sy).decl).a
end

func rule_value_key_at(s &: Sema, a &: at.Ast, nid: int, fty: int, names_ok: bool, depth: int): str:
    if nid == 0 or depth > 16:
        ret ""
    end
    n := at.Get(a, nid)
    if names_ok:
        init := rule_const_init(s, a, nid)
        if init != 0:
            ret rule_value_key_at(s, a, init, fty, true, depth + 1)
        end
    end
    if fty >= 0 and ty_at(s, fty).kind == TY_ENUM:
        if n.kind != at.AST_MEMBER or (names_ok and not rule_root_ok(s, a, nid)):
            ret ""
        end
        esym := ty_at(s, fty).decl
        if esym == 0 or sym_at(s, esym).members == 0:
            ret ""
        end
        em := enum_member_find(s, a, sym_at(s, esym).members, nid)
        ret em == 0 ? "" : "e" + sym_at(s, em).name
    end
    if n.kind == at.AST_LITERAL and n.value_kind == tok.TV_STRING:
        ret "s" + n.value_str
    end
    if n.kind == at.AST_UNARY and n.op == tok.TK_MINUS:
        inner := rule_value_key_at(s, a, n.a, fty, names_ok, depth + 1)
        if str.Len(inner) == 0 or (byte_at(inner, 0) != 105 and byte_at(inner, 0) != 102):
            ret ""
        end
        body := str.Substr(inner, 1, str.Len(inner) - 1)
        if str.Equals(body, "0") or str.Equals(body, "0.0"):
            ret inner
        end
        ret str.Substr(inner, 0, 1) + "-" + body
    end
    if not names_ok and not rule_is_plain_value(a, nid):
        ret ""
    end
    mut cv := ConstVal {}
    if not const_eval(s, a, nid, cv, 0):
        ret ""
    end
    if cv.kind == CV_BOOL:
        ret cv.b ? "b1" : "b0"
    end
    if fty >= 0 and type_is_float(s, fty):
        ret "f" + cv_as_flt(cv)
    end
    if cv.kind == CV_INT:
        ret "i" + cv.i
    end
    if cv.kind == CV_FLOAT:
        ret "f" + cv.f
    end
    ret ""
end

func rule_value_key(s &: Sema, a &: at.Ast, nid: int, fty: int, names_ok: bool): str:
    ret rule_value_key_at(s, a, nid, fty, names_ok, 0)
end

func rule_default_key(s &: Sema, a &: at.Ast, ssym: int, f: int, fty: int): str:
    fd := sym_at(s, f).decl
    if fd == 0 or at.Get(a, fd).a == 0:
        ret ""
    end
    save := s.cur
    owner := scope_at(s, sym_at(s, ssym).members).parent
    if owner != 0:
        s.cur = owner
    end
    key := rule_value_key(s, a, at.Get(a, fd).a, fty, true)
    s.cur = save
    ret key
end

func rule_value_body(key: str): str:
    ret str.Substr(key, 1, str.Len(key) - 1)
end

func rule_value_plain(key: str): str:
    if str.Equals(key, "b1"):
        ret "true"
    end
    if str.Equals(key, "b0"):
        ret "false"
    end
    ret rule_value_body(key)
end

func rule_value_show(key: str): str:
    fa := str.Equals(i18.Lang(), "fa")
    if str.Equals(key, "b1"):
        ret fa ? "درست" : "true"
    end
    if str.Equals(key, "b0"):
        ret fa ? "نادرست" : "false"
    end
    if str.Len(key) > 0 and byte_at(key, 0) == 115:
        ret "\"" + rule_value_body(key) + "\""
    end
    ret rule_value_body(key)
end

func rule_cond_type(s &: Sema, a &: at.Ast, did: int, r: at.Node): int:
    ssym := scope_lookup_local(s, s.global, at.Get(a, did).name)
    if ssym == 0 or sym_at(s, ssym).members == 0 or r.list.len() == 0:
        ret TYPE_NONE
    end
    f := scope_lookup_local(s, sym_at(s, ssym).members, at.Get(a, r.list.get(0)).name)
    ret f == 0 ? TYPE_NONE : sym_at(s, f).ty
end

func rule_text(s &: Sema, a &: at.Ast, r: at.Node, fty: int): str:
    fa := str.Equals(i18.Lang(), "fa")
    head := fa ? "قاعده " : "rule "
    if rule_is_needs(r):
        mut cond := ""
        if r.a != 0:
            shown := rule_value_show(rule_value_key(s, a, r.a, fty, false))
            cond = (fa ? " برابر " : " == ") + shown
        end
        ret head + at.Get(a, r.list.get(0)).name + cond + (fa ? " نیازمند " : " needs ") + rule_plain_names(a, r, 1)
    end
    ret head + lp.RuleGroupWord(r.name, fa) + "(" + rule_plain_names(a, r, 0) + ")"
end

func rule_holds(op: str, first: bool, rest_all: bool, count: int, total: int): bool:
    if str.Equals(op, "needs"):
        ret not first or rest_all
    end
    if str.Equals(op, "allornone"):
        ret count == 0 or count == total
    end
    if str.Equals(op, "oneof"):
        ret count == 1
    end
    if str.Equals(op, "anyof"):
        ret count >= 1
    end
    ret count <= 1
end

func rule_lit_has(a &: at.Ast, nid: int, name: str): bool:
    repeat at.ChildCount(a, nid) in i:
        if str.Equals(at.Get(a, at.Child(a, nid, i)).name, name):
            ret true
        end
    end
    ret false
end

func rule_lit_value(a &: at.Ast, nid: int, name: str): int:
    repeat at.ChildCount(a, nid) in i:
        fi := at.Get(a, at.Child(a, nid, i))
        if str.Equals(fi.name, name):
            ret fi.a
        end
    end
    ret 0
end

func rule_struct_name(s &: Sema, ssym: int): str:
    sv := sym_at(s, ssym)
    ret str.Len(sv.generic_base) > 0 ? type_disp(s, sv.ty) : sv.name
end

func rule_check_value(s &: Sema, a &: at.Ast, nid: int, ssym: int, r: at.Node, sp: co.SrcSpan):
    sv := sym_at(s, ssym)
    name := at.Get(a, r.list.get(0)).name
    f := scope_lookup_local(s, sv.members, name)
    if f == 0:
        ret
    end
    fty := sym_at(s, f).ty
    provided := rule_lit_has(a, nid, name)
    val := provided ? rule_lit_value(a, nid, name) : at.Get(a, sym_at(s, f).decl).a
    if val == 0:
        ret
    end
    want := rule_value_key(s, a, r.a, fty, false)
    got := provided ? rule_value_key(s, a, val, fty, true) : rule_default_key(s, a, ssym, f, fty)
    if str.Len(want) == 0 or (str.Len(got) > 0 and not str.Equals(got, want)):
        ret
    end
    shown := rule_value_show(want)
    help := co.Format1(i18.Tr("the struct declares: %s"), co.ArgStr(rule_text(s, a, r, fty)))
    mut i := 1
    until i < r.list.len():
        tgt := at.Get(a, r.list.get(i)).name
        if not rule_lit_has(a, nid, tgt):
            if str.Len(got) > 0:
                serr_help(
                    s, 159, sp, co.Format4(
                        i18.Tr("struct literal '%s' has '%s' equal to %s, which needs '%s'"), co.ArgStr(rule_struct_name(s, ssym)), co.ArgStr(name), co.ArgStr(shown), co.ArgStr(tgt)
                    ), help
                )
            else:
                serr_help(
                    s, 159, sp, co.Format4(
                        i18.Tr("struct literal '%s' must set '%s' because '%s' may equal %s (its value is not a constant)"), co.ArgStr(rule_struct_name(s, ssym)), co.ArgStr(tgt), co.ArgStr(name), co.ArgStr(shown)
                    ), help
                )
            end
        end
        i += 1
    end
end

func rule_report(s &: Sema, a &: at.Ast, nid: int, sname: str, r: at.Node, sp: co.SrcSpan):
    help := co.Format1(i18.Tr("the struct declares: %s"), co.ArgStr(rule_text(s, a, r, TYPE_NONE)))
    if rule_is_needs(r):
        first := at.Get(a, r.list.get(0)).name
        mut i := 1
        until i < r.list.len():
            want := at.Get(a, r.list.get(i)).name
            if not rule_lit_has(a, nid, want):
                serr_help(
                    s, 159, sp, co.Format3(
                        i18.Tr("struct literal '%s' sets '%s', which needs '%s'"), co.ArgStr(sname), co.ArgStr(first), co.ArgStr(want)
                    ), help
                )
            end
            i += 1
        end
        ret
    end
    mut fmt := "struct literal '%s' can set at most one of %s"
    if str.Equals(r.name, "allornone"):
        fmt = "struct literal '%s' must set all or none of %s"
    else str.Equals(r.name, "oneof"):
        fmt = "struct literal '%s' must set exactly one of %s"
    else str.Equals(r.name, "anyof"):
        fmt = "struct literal '%s' must set at least one of %s"
    end
    serr_help(s, 159, sp, co.Format2(i18.Tr(fmt), co.ArgStr(sname), co.ArgStr(rule_names(a, r))), help)
end

func check_struct_rules(s &: Sema, a &: at.Ast, nid: int, ssym: int, sp: co.SrcSpan):
    if s.in_derive or at.Get(a, nid).synthetic:
        ret
    end
    sv := sym_at(s, ssym)
    if sv.decl == 0:
        ret
    end
    rules := at.Rules(a, at.Get(a, sv.decl).ext)
    repeat rules.len() in i:
        r := at.Get(a, rules.get(i))
        if str.Len(r.name) == 0 or r.list.len() == 0:
            continue
        end
        if r.a != 0:
            rule_check_value(s, a, nid, ssym, r, sp)
            continue
        end
        mut count := 0
        mut rest_all := true
        repeat r.list.len() in j:
            has := rule_lit_has(a, nid, at.Get(a, r.list.get(j)).name)
            if has:
                count += 1
            else j > 0:
                rest_all = false
            end
        end
        first := rule_lit_has(a, nid, at.Get(a, r.list.get(0)).name)
        if not rule_holds(r.name, first, rest_all, count, r.list.len()):
            rule_report(s, a, nid, rule_struct_name(s, ssym), r, sp)
        end
    end
end

func rule_shape_ok(s &: Sema, a &: at.Ast, did: int, rid: int): bool:
    d := at.Get(a, did)
    r := at.Get(a, rid)
    if not rule_is_needs(r) and r.list.len() < 2:
        serr(s, 160, span_of(a, rid), i18.Tr("this rule needs at least two fields"))
        ret false
    end
    mut ok := true
    if r.a != 0 and at.Typarams(a, d.ext).len() == 0:
        fty := rule_cond_type(s, a, did, r)
        key := rule_value_key(s, a, r.a, fty, false)
        if fty != TYPE_NONE and at.KindOf(a, r.a) == at.AST_LITERAL:
            s.expected = fty
        end
        vt := sema_check_expr(s, a, r.a)
        float_ok := fty != TYPE_NONE and type_is_float(s, fty) and vt >= 0 and type_is_float(s, vt)
        if str.Len(key) == 0 or (at.KindOf(a, r.a) == at.AST_MEMBER and not rule_root_ok(s, a, r.a)):
            serr(s, 160, span_of(a, r.a), i18.Tr("the value in a rule must be a literal or a plain enum member"))
            ok = false
        else fty != TYPE_NONE and not float_ok and not type_assignable(s, fty, vt):
            serr(
                s, 160, span_of(a, r.a), co.Format3(
                    i18.Tr("rule value for field '%s': cannot assign '%s' to '%s'"), co.ArgStr(at.Get(a, r.list.get(0)).name), co.ArgStr(type_disp(s, vt)), co.ArgStr(type_disp(s, fty))
                )
            )
            ok = false
        end
    end
    repeat r.list.len() in i:
        nid := r.list.get(i)
        nm := at.Get(a, nid).name
        repeat i in j:
            if str.Equals(at.Get(a, r.list.get(j)).name, nm):
                serr(s, 160, span_of(a, nid), co.Format1(i18.Tr("field '%s' appears twice in this rule"), co.ArgStr(nm)))
                ok = false
            end
        end
        fid := rule_field_node(a, did, nm)
        if d.is_pub and fid != 0 and not at.Get(a, fid).is_pub:
            serr(
                s, 160, span_of(a, nid), co.Format2(
                    i18.Tr("a rule in pub struct '%s' cannot name private field '%s' (mark it 'pub')"), co.ArgStr(d.name), co.ArgStr(nm)
                )
            )
            ok = false
        end
    end
    ret ok
end

func rule_index(names: Vector<str>, name: str): int:
    repeat names.len() in i:
        if str.Equals(names.get(i), name):
            ret i
        end
    end
    ret 0 - 1
end

func rule_mask_holds(a &: at.Ast, r: at.Node, names: Vector<str>, mask: int): bool:
    mut count := 0
    mut rest_all := true
    repeat r.list.len() in j:
        ix := rule_index(names, at.Get(a, r.list.get(j)).name)
        if ((mask >> ix) & 1) == 1:
            count += 1
        else j > 0:
            rest_all = false
        end
    end
    first_ix := rule_index(names, at.Get(a, r.list.get(0)).name)
    ret rule_holds(r.name, ((mask >> first_ix) & 1) == 1, rest_all, count, r.list.len())
end

func rules_note_refs(s &: Sema, a &: at.Ast, did: int):
    d := at.Get(a, did)
    ssym := scope_lookup_local(s, s.global, d.name)
    if ssym == 0 or sym_at(s, ssym).members == 0:
        ret
    end
    mems := sym_at(s, ssym).members
    rules := at.Rules(a, d.ext)
    repeat rules.len() in i:
        r := at.Get(a, rules.get(i))
        repeat r.list.len() in j:
            nid := r.list.get(j)
            note_ref(nid, scope_lookup_local(s, mems, at.Get(a, nid).name))
        end
    end
end

func struct_rules_validate(s &: Sema, a &: at.Ast, did: int):
    d := at.Get(a, did)
    rules := at.Rules(a, d.ext)
    if rules.len() == 0:
        ret
    end
    rules_note_refs(s, a, did)
    mut live := Vector {} as Vector<int>
    defer live.free()
    mut names := Vector {} as Vector<str>
    defer names.free()
    repeat rules.len() in i:
        rid := rules.get(i)
        r := at.Get(a, rid)
        if str.Len(r.name) == 0 or not rule_shape_ok(s, a, did, rid) or r.a != 0:
            continue
        end
        live.push(rid)
        repeat r.list.len() in j:
            nm := at.Get(a, r.list.get(j)).name
            if rule_index(names, nm) < 0:
                names.push(nm)
            end
        end
    end
    if live.len() == 0 or names.len() > RULE_SEARCH_MAX:
        ret
    end
    mut required := 0
    repeat names.len() in n:
        if at.Get(a, rule_field_node(a, did, names.get(n))).a == 0:
            required = required | (1 << n)
        end
    end
    limit := 1 << names.len()
    mut fails := Vector {} as Vector<bool>
    defer fails.free()
    repeat live.len():
        fails.push(false)
    end
    mut solvable := false
    mut mask := 0
    until mask < limit:
        if (mask & required) == required:
            mut all_hold := true
            repeat live.len() in k:
                if not rule_mask_holds(a, at.Get(a, live.get(k)), names, mask):
                    all_hold = false
                    fails.set(k, true)
                end
            end
            if all_hold:
                solvable = true
            end
        end
        mask += 1
    end
    if not solvable:
        serr(s, 161, span_of(a, did), co.Format1(i18.Tr("no literal of struct '%s' can satisfy its rules"), co.ArgStr(d.name)))
        ret
    end
    repeat live.len() in w:
        if not fails.get(w):
            swarn(s, 159, span_of(a, live.get(w)), i18.Tr("this rule can never fail, so it has no effect"))
        end
    end
end

func rule_decl_of(s &: Sema, sym: int): int:
    ret sym_at(s, sym).decl
end

func rule_optional_field_decl(a &: at.Ast, did: int, name: str): bool:
    rules := at.Rules(a, at.Get(a, did).ext)
    repeat rules.len() in i:
        r := at.Get(a, rules.get(i))
        repeat r.list.len() in j:
            if str.Equals(at.Get(a, r.list.get(j)).name, name):
                fid := rule_field_node(a, did, name)
                ret fid != 0 and at.Get(a, fid).a != 0
            end
        end
    end
    ret false
end

func rule_key_of(s &: Sema, a &: at.Ast, sym: int, name: str, sp: co.SrcSpan): str:
    f := scope_lookup_local(s, sym_at(s, sym).members, name)
    if f == 0:
        ret ""
    end
    fa := jd_attr_of(s, a, f, sp)
    ret fa.skip or not fa.ok ? "" : fa.name
end

func rule_keys(s &: Sema, a &: at.Ast, sym: int, r: at.Node, sp: co.SrcSpan): Vector<str>:
    mut keys := Vector {} as Vector<str>
    repeat r.list.len() in i:
        key := rule_key_of(s, a, sym, at.Get(a, r.list.get(i)).name, sp)
        if str.Len(key) == 0:
            keys.clear()
            ret keys
        end
        keys.push(key)
    end
    ret keys
end

func jd_flag_for(s &: Sema, a &: at.Ast, sym: int, flags: Vector<str>, key: str, sp: co.SrcSpan): str:
    mems := scope_at(s, sym_at(s, sym).members).symbols
    mut n := 0
    repeat mems.len() in i:
        f := mems.get(i)
        if sym_at(s, f).kind == SYM_FIELD:
            fa := jd_attr_of(s, a, f, sp)
            if fa.ok and not fa.skip:
                if str.Equals(fa.name, key):
                    ret flags.get(n)
                end
                n += 1
            end
        end
    end
    ret ""
end

func rule_quoted_keys(keys: Vector<str>): str:
    mut out := ""
    repeat keys.len() in i:
        out = out + (i > 0 ? ", " : "") + "'" + keys.get(i) + "'"
    end
    ret out
end

func rule_value_code(s &: Sema, key: str, fty: int): str:
    if str.Equals(key, "b1"):
        ret "true"
    end
    if str.Equals(key, "b0"):
        ret "false"
    end
    body := rule_value_body(key)
    c := byte_at(key, 0)
    if c == 115:
        ret jd_quote(body)
    end
    if c == 101:
        ret derive_type_spelling(s, fty) + "." + body
    end
    ret body
end

func jd_dec_value_rule(s &: Sema, a &: at.Ast, sym: int, r: at.Node, keys: Vector<str>, flags: Vector<str>, sp: co.SrcSpan): str:
    name := at.Get(a, r.list.get(0)).name
    f := scope_lookup_local(s, sym_at(s, sym).members, name)
    fty := sym_at(s, f).ty
    want := rule_value_key(s, a, r.a, fty, false)
    if str.Len(want) == 0:
        ret ""
    end
    code := rule_value_code(s, want, fty)
    trig := jd_flag_for(s, a, sym, flags, keys.get(0), sp)
    same := JD_OUT + "." + derive_ident(name) + " == " + code
    mut test := "(" + trig + " and " + same + ")"
    if str.Equals(rule_default_key(s, a, sym, f, fty), want):
        test = "(" + trig + " == false or " + same + ")"
    end
    mut out := ""
    mut i := 1
    until i < keys.len():
        flag := jd_flag_for(s, a, sym, flags, keys.get(i), sp)
        out = out + JIND + "if " + JD_STRICT + " and " + test + " and " + flag + " == false:\n"
        out = out + jd_fail(JIND + JIND, "key '" + keys.get(0) + "' equal to " + rule_value_plain(want) + " needs key '" + keys.get(i) + "'", JD_START)
        out = out + JIND + "end\n"
        i += 1
    end
    ret out
end

func jd_dec_rule(s &: Sema, a &: at.Ast, sym: int, r: at.Node, flags: Vector<str>, sp: co.SrcSpan): str:
    mut keys := rule_keys(s, a, sym, r, sp)
    defer keys.free()
    if keys.len() == 0:
        ret ""
    end
    mut out := ""
    if r.a != 0:
        ret jd_dec_value_rule(s, a, sym, r, keys, flags, sp)
    end
    if rule_is_needs(r):
        first := jd_flag_for(s, a, sym, flags, keys.get(0), sp)
        mut i := 1
        until i < keys.len():
            flag := jd_flag_for(s, a, sym, flags, keys.get(i), sp)
            out = out + JIND + "if " + JD_STRICT + " and " + first + " and " + flag + " == false:\n"
            out = out + jd_fail(JIND + JIND, "key '" + keys.get(0) + "' needs key '" + keys.get(i) + "'", JD_START)
            out = out + JIND + "end\n"
            i += 1
        end
        ret out
    end
    mut count := ""
    repeat keys.len() in j:
        count = count + (j > 0 ? " + " : "") + "(" + jd_flag_for(s, a, sym, flags, keys.get(j), sp) + " ? 1 : 0)"
    end
    mut test := "(" + count + ") > 1"
    mut msg := "at most one of the keys " + rule_quoted_keys(keys) + " can be set"
    if str.Equals(r.name, "allornone"):
        test = "(" + count + ") != 0 and (" + count + ") != " + keys.len()
        msg = "set all or none of the keys " + rule_quoted_keys(keys)
    else str.Equals(r.name, "oneof"):
        test = "(" + count + ") != 1"
        msg = "set exactly one of the keys " + rule_quoted_keys(keys)
    else str.Equals(r.name, "anyof"):
        test = "(" + count + ") == 0"
        msg = "set at least one of the keys " + rule_quoted_keys(keys)
    end
    out = out + JIND + "if " + JD_STRICT + " and " + test + ":\n"
    out = out + jd_fail(JIND + JIND, msg, JD_START)
    ret out + JIND + "end\n"
end

func jd_dec_rules(s &: Sema, a &: at.Ast, sym: int, flags: Vector<str>, sp: co.SrcSpan): str:
    decl := rule_decl_of(s, sym)
    if decl == 0:
        ret ""
    end
    rules := at.Rules(a, at.Get(a, decl).ext)
    mut out := ""
    repeat rules.len() in i:
        r := at.Get(a, rules.get(i))
        if str.Len(r.name) > 0 and r.list.len() > 0:
            out = out + jd_dec_rule(s, a, sym, r, flags, sp)
        end
    end
    ret out
end

func js_rule_optional_key(s &: Sema, a &: at.Ast, sym: int, key: str, sp: co.SrcSpan): bool:
    decl := rule_decl_of(s, sym)
    if decl == 0 or at.Rules(a, at.Get(a, decl).ext).len() == 0:
        ret false
    end
    mems := scope_at(s, sym_at(s, sym).members).symbols
    repeat mems.len() in i:
        f := mems.get(i)
        if sym_at(s, f).kind == SYM_FIELD and str.Equals(jd_attr_of(s, a, f, sp).name, key):
            ret rule_optional_field_decl(a, decl, sym_at(s, f).name)
        end
    end
    ret false
end

func js_required_set(keys: Vector<str>, from_i: int, to_i: int): str:
    mut out := "{\"required\":["
    mut i := from_i
    until i < to_i:
        out = out + (i > from_i ? "," : "") + js_qs(keys.get(i))
        i += 1
    end
    ret out + "]}"
end

func js_one_each(keys: Vector<str>): str:
    mut out := ""
    repeat keys.len() in i:
        out = out + (i > 0 ? "," : "") + js_required_set(keys, i, i + 1)
    end
    ret out
end

func js_pairs(keys: Vector<str>): str:
    mut out := ""
    repeat keys.len() in i:
        mut j := i + 1
        until j < keys.len():
            pair := "{\"required\":[" + js_qs(keys.get(i)) + "," + js_qs(keys.get(j)) + "]}"
            out = out + (str.Len(out) > 0 ? "," : "") + pair
            j += 1
        end
    end
    ret out
end

func js_dep_add(dep_keys &: Vector<str>, dep_vals &: Vector<str>, key: str, want: str):
    repeat dep_keys.len() in i:
        if str.Equals(dep_keys.get(i), key):
            if not str.Contains(dep_vals.get(i), js_qs(want)):
                dep_vals.set(i, dep_vals.get(i) + "," + js_qs(want))
            end
            ret
        end
    end
    dep_keys.push(key)
    dep_vals.push(js_qs(want))
end

func js_value_rule(s &: Sema, a &: at.Ast, sym: int, r: at.Node, keys: Vector<str>, sp: co.SrcSpan): str:
    f := scope_lookup_local(s, sym_at(s, sym).members, at.Get(a, r.list.get(0)).name)
    fty := sym_at(s, f).ty
    want := rule_value_key(s, a, r.a, fty, false)
    if str.Len(want) == 0:
        ret ""
    end
    c := byte_at(want, 0)
    body := rule_value_body(want)
    mut lit := body
    if c == 115 or c == 101:
        lit = js_qs(body)
    else str.Equals(want, "b1"):
        lit = "true"
    else str.Equals(want, "b0"):
        lit = "false"
    end
    if jd_attr_of(s, a, f, sp).as_string:
        lit = js_qs(rule_value_plain(want))
    end
    mut cond := "{\"properties\":{" + js_qs(keys.get(0)) + ":{\"const\":" + lit + "}}"
    if not str.Equals(rule_default_key(s, a, sym, f, fty), want):
        cond = cond + ",\"required\":[" + js_qs(keys.get(0)) + "]"
    end
    ret "{\"if\":" + cond + "},\"then\":" + js_required_set(keys, 1, keys.len()) + "}"
end

func js_rules(s &: Sema, a &: at.Ast, sym: int, sp: co.SrcSpan): str:
    decl := rule_decl_of(s, sym)
    if decl == 0:
        ret ""
    end
    rules := at.Rules(a, at.Get(a, decl).ext)
    if rules.len() == 0:
        ret ""
    end
    mut dep_keys := Vector {} as Vector<str>
    defer dep_keys.free()
    mut dep_vals := Vector {} as Vector<str>
    defer dep_vals.free()
    mut groups := ""
    repeat rules.len() in i:
        r := at.Get(a, rules.get(i))
        if str.Len(r.name) == 0 or r.list.len() == 0:
            continue
        end
        mut keys := rule_keys(s, a, sym, r, sp)
        defer keys.free()
        if keys.len() == 0:
            continue
        end
        if r.a != 0:
            part := js_value_rule(s, a, sym, r, keys, sp)
            if str.Len(part) > 0:
                groups = groups + (str.Len(groups) > 0 ? "," : "") + part
            end
        else rule_is_needs(r):
            mut k := 1
            until k < keys.len():
                js_dep_add(dep_keys, dep_vals, keys.get(0), keys.get(k))
                k += 1
            end
        else str.Equals(r.name, "allornone"):
            repeat keys.len() in x:
                repeat keys.len() in y:
                    if x != y:
                        js_dep_add(dep_keys, dep_vals, keys.get(x), keys.get(y))
                    end
                end
            end
        else:
            mut part := "{\"anyOf\":[" + js_one_each(keys) + "]}"
            if str.Equals(r.name, "oneof"):
                part = "{\"oneOf\":[" + js_one_each(keys) + "]}"
            else str.Equals(r.name, "atmostone"):
                part = "{\"not\":{\"anyOf\":[" + js_pairs(keys) + "]}}"
            end
            groups = groups + (str.Len(groups) > 0 ? "," : "") + part
        end
    end
    mut out := ""
    if dep_keys.len() > 0:
        out = out + ",\"dependentRequired\":{"
        repeat dep_keys.len() in d:
            out = out + (d > 0 ? "," : "") + js_qs(dep_keys.get(d)) + ":[" + dep_vals.get(d) + "]"
        end
        out = out + "}"
    end
    if str.Len(groups) > 0:
        out = out + ",\"allOf\":[" + groups + "]"
    end
    ret out
end
