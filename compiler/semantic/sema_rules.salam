package semantic

import str

include co "../sal_core.salam"
include at "../ast.salam"
include i18 "../i18n.salam"
include lp "../langpack.salam"

const RULE_SEARCH_MAX := 16

func rule_field_canon(a &: at.Ast, did: int, name: str): str:
    d := at.Get(a, did)
    repeat d.list.len() in i:
        m := at.Get(a, d.list.get(i))
        if m.kind != at.AST_FIELD:
            continue
        end
        al := at.Aliases(a, m.ext)
        if su_ident_eq(m.name, name) or aliases_have(al, "en", name) or aliases_have(al, "fa", name):
            ret m.name
        end
    end
    ret ""
end

func rule_field_node(a &: at.Ast, did: int, name: str): int:
    d := at.Get(a, did)
    repeat d.list.len() in i:
        mid := d.list.get(i)
        m := at.Get(a, mid)
        if m.kind == at.AST_FIELD and str.Equals(m.name, name):
            ret mid
        end
    end
    ret 0
end

func rule_field_suggest(a &: at.Ast, did: int, name: str): str:
    mut cands := Vector {} as Vector<str>
    defer cands.free()
    d := at.Get(a, did)
    repeat d.list.len() in i:
        m := at.Get(a, d.list.get(i))
        if m.kind == at.AST_FIELD:
            cands.push(m.name)
        end
    end
    ret sema_suggest_list(name, cands)
end

func struct_rules_resolve(s &: Sema, a &: at.Ast, did: int):
    d := at.Get(a, did)
    rules := at.Rules(a, d.ext)
    repeat rules.len() in i:
        rid := rules.get(i)
        r := at.Get(a, rid)
        mut ok := str.Len(r.name) > 0
        repeat r.list.len() in j:
            nid := r.list.get(j)
            nm := at.Get(a, nid).name
            canon := rule_field_canon(a, did, nm)
            if str.Len(canon) == 0:
                serr(
                    s, 160, span_of(a, nid), co.Format2(
                        i18.Tr("unknown field '%s' in a rule of struct '%s'"), co.ArgStr(nm), co.ArgStr(d.name)
                    ) + rule_field_suggest(a, did, nm)
                )
                ok = false
            else:
                at.SetName(a, nid, canon)
            end
        end
        if not ok:
            at.SetName(a, rid, "")
        end
    end
end

func rule_is_needs(r: at.Node): bool:
    ret str.Equals(r.name, "needs")
end

func rule_names(a &: at.Ast, r: at.Node): str:
    mut out := ""
    repeat r.list.len() in i:
        if i > 0:
            out = out + ", "
        end
        out = out + "'" + at.Get(a, r.list.get(i)).name + "'"
    end
    ret out
end

func rule_plain_names(a &: at.Ast, r: at.Node, start: int): str:
    fa := str.Equals(i18.Lang(), "fa")
    mut out := ""
    mut i := start
    until i < r.list.len():
        if i > start:
            out = out + (fa ? "، " : ", ")
        end
        out = out + at.Get(a, r.list.get(i)).name
        i += 1
    end
    ret out
end

func rule_text(a &: at.Ast, r: at.Node): str:
    fa := str.Equals(i18.Lang(), "fa")
    head := fa ? "قاعده " : "rule "
    if rule_is_needs(r):
        ret head + at.Get(a, r.list.get(0)).name + (fa ? " نیازمند " : " needs ") + rule_plain_names(a, r, 1)
    end
    ret head + lp.RuleGroupWord(r.name, fa) + "(" + rule_plain_names(a, r, 0) + ")"
end

func rule_holds(op: str, first: bool, rest_all: bool, count: int, total: int): bool:
    if str.Equals(op, "needs"):
        ret not first or rest_all
    end
    if str.Equals(op, "allornone"):
        ret count == 0 or count == total
    end
    if str.Equals(op, "oneof"):
        ret count == 1
    end
    if str.Equals(op, "anyof"):
        ret count >= 1
    end
    ret count <= 1
end

func rule_lit_has(a &: at.Ast, nid: int, name: str): bool:
    repeat at.ChildCount(a, nid) in i:
        if str.Equals(at.Get(a, at.Child(a, nid, i)).name, name):
            ret true
        end
    end
    ret false
end

func rule_report(s &: Sema, a &: at.Ast, nid: int, sname: str, r: at.Node, sp: co.SrcSpan):
    help := co.Format1(i18.Tr("the struct declares: %s"), co.ArgStr(rule_text(a, r)))
    if rule_is_needs(r):
        first := at.Get(a, r.list.get(0)).name
        mut i := 1
        until i < r.list.len():
            want := at.Get(a, r.list.get(i)).name
            if not rule_lit_has(a, nid, want):
                serr_help(
                    s, 159, sp, co.Format3(
                        i18.Tr("struct literal '%s' sets '%s', which needs '%s'"), co.ArgStr(sname), co.ArgStr(first), co.ArgStr(want)
                    ), help
                )
            end
            i += 1
        end
        ret
    end
    mut fmt := "struct literal '%s' can set at most one of %s"
    if str.Equals(r.name, "allornone"):
        fmt = "struct literal '%s' must set all or none of %s"
    else str.Equals(r.name, "oneof"):
        fmt = "struct literal '%s' must set exactly one of %s"
    else str.Equals(r.name, "anyof"):
        fmt = "struct literal '%s' must set at least one of %s"
    end
    serr_help(s, 159, sp, co.Format2(i18.Tr(fmt), co.ArgStr(sname), co.ArgStr(rule_names(a, r))), help)
end

func check_struct_rules(s &: Sema, a &: at.Ast, nid: int, ssym: int, sp: co.SrcSpan):
    if s.in_derive or at.Get(a, nid).synthetic:
        ret
    end
    sv := sym_at(s, ssym)
    if sv.decl == 0:
        ret
    end
    rules := at.Rules(a, at.Get(a, sv.decl).ext)
    repeat rules.len() in i:
        r := at.Get(a, rules.get(i))
        if str.Len(r.name) == 0 or r.list.len() == 0:
            continue
        end
        mut count := 0
        mut rest_all := true
        repeat r.list.len() in j:
            has := rule_lit_has(a, nid, at.Get(a, r.list.get(j)).name)
            if has:
                count += 1
            else j > 0:
                rest_all = false
            end
        end
        first := rule_lit_has(a, nid, at.Get(a, r.list.get(0)).name)
        if not rule_holds(r.name, first, rest_all, count, r.list.len()):
            rule_report(s, a, nid, sv.name, r, sp)
        end
    end
end

func rule_shape_ok(s &: Sema, a &: at.Ast, did: int, rid: int): bool:
    d := at.Get(a, did)
    r := at.Get(a, rid)
    if not rule_is_needs(r) and r.list.len() < 2:
        serr(s, 160, span_of(a, rid), i18.Tr("this rule needs at least two fields"))
        ret false
    end
    mut ok := true
    repeat r.list.len() in i:
        nid := r.list.get(i)
        nm := at.Get(a, nid).name
        repeat i in j:
            if str.Equals(at.Get(a, r.list.get(j)).name, nm):
                serr(s, 160, span_of(a, nid), co.Format1(i18.Tr("field '%s' appears twice in this rule"), co.ArgStr(nm)))
                ok = false
            end
        end
        fid := rule_field_node(a, did, nm)
        if d.is_pub and fid != 0 and not at.Get(a, fid).is_pub:
            serr(
                s, 160, span_of(a, nid), co.Format2(
                    i18.Tr("a rule in pub struct '%s' cannot name private field '%s' (mark it 'pub')"), co.ArgStr(d.name), co.ArgStr(nm)
                )
            )
            ok = false
        end
    end
    ret ok
end

func rule_index(names: Vector<str>, name: str): int:
    repeat names.len() in i:
        if str.Equals(names.get(i), name):
            ret i
        end
    end
    ret 0 - 1
end

func rule_mask_holds(a &: at.Ast, r: at.Node, names: Vector<str>, mask: int): bool:
    mut count := 0
    mut rest_all := true
    repeat r.list.len() in j:
        ix := rule_index(names, at.Get(a, r.list.get(j)).name)
        if ((mask >> ix) & 1) == 1:
            count += 1
        else j > 0:
            rest_all = false
        end
    end
    first_ix := rule_index(names, at.Get(a, r.list.get(0)).name)
    ret rule_holds(r.name, ((mask >> first_ix) & 1) == 1, rest_all, count, r.list.len())
end

func rules_note_refs(s &: Sema, a &: at.Ast, did: int):
    d := at.Get(a, did)
    ssym := scope_lookup_local(s, s.global, d.name)
    if ssym == 0 or sym_at(s, ssym).members == 0:
        ret
    end
    mems := sym_at(s, ssym).members
    rules := at.Rules(a, d.ext)
    repeat rules.len() in i:
        r := at.Get(a, rules.get(i))
        repeat r.list.len() in j:
            nid := r.list.get(j)
            note_ref(nid, scope_lookup_local(s, mems, at.Get(a, nid).name))
        end
    end
end

func struct_rules_validate(s &: Sema, a &: at.Ast, did: int):
    d := at.Get(a, did)
    rules := at.Rules(a, d.ext)
    if rules.len() == 0:
        ret
    end
    rules_note_refs(s, a, did)
    mut live := Vector {} as Vector<int>
    defer live.free()
    mut names := Vector {} as Vector<str>
    defer names.free()
    repeat rules.len() in i:
        rid := rules.get(i)
        r := at.Get(a, rid)
        if str.Len(r.name) == 0 or not rule_shape_ok(s, a, did, rid):
            continue
        end
        live.push(rid)
        repeat r.list.len() in j:
            nm := at.Get(a, r.list.get(j)).name
            if rule_index(names, nm) < 0:
                names.push(nm)
            end
        end
    end
    if live.len() == 0 or names.len() > RULE_SEARCH_MAX:
        ret
    end
    mut required := 0
    repeat names.len() in n:
        if at.Get(a, rule_field_node(a, did, names.get(n))).a == 0:
            required = required | (1 << n)
        end
    end
    limit := 1 << names.len()
    mut fails := Vector {} as Vector<bool>
    defer fails.free()
    repeat live.len():
        fails.push(false)
    end
    mut solvable := false
    mut mask := 0
    until mask < limit:
        if (mask & required) == required:
            mut all_hold := true
            repeat live.len() in k:
                if not rule_mask_holds(a, at.Get(a, live.get(k)), names, mask):
                    all_hold = false
                    fails.set(k, true)
                end
            end
            if all_hold:
                solvable = true
            end
        end
        mask += 1
    end
    if not solvable:
        serr(s, 161, span_of(a, did), co.Format1(i18.Tr("no literal of struct '%s' can satisfy its rules"), co.ArgStr(d.name)))
        ret
    end
    repeat live.len() in w:
        if not fails.get(w):
            swarn(s, 159, span_of(a, live.get(w)), i18.Tr("this rule can never fail, so it has no effect"))
        end
    end
end
