package semantic

import str

include co "../sal_core.salam"
include at "../ast.salam"
include i18 "../i18n.salam"

func static_member_name(sname: str, mname: str): str:
    ret "__" + sname + "__" + mname
end

func static_owner_of(s &: Sema, fname: str): int:
    if not str.StartsWith(fname, "__"):
        ret 0
    end
    rest := str.Substr(fname, 2, str.Len(fname) - 2)
    idx := str.IndexOf(rest, "__")
    if idx <= 0:
        ret 0
    end
    sy := scope_lookup(s, s.cur, str.Substr(rest, 0, idx))
    if sy != 0 and sym_at(s, sy).kind == SYM_STRUCT:
        ret sy
    end
    ret 0
end

func sema_in_struct(s &: Sema, ssym: int): bool:
    ret struct_sym_of(s, s.self_type) == ssym or (ssym != 0 and s.static_owner == ssym)
end

func static_home(s &: Sema, ssym: int): int:
    h := sym_at(s, ssym).home
    ret h != 0 ? h : s.global
end

func static_missing(s &: Sema, ssym: int, mname: str, sp: co.SrcSpan):
    sv := sym_at(s, ssym)
    if sv.members != 0 and scope_lookup_local(s, sv.members, mname) != 0:
        serr(
            s, 16, sp, co.Format2(
                i18.Tr("'%s' is not static: use it on a value of struct '%s'"), co.ArgStr(mname), co.ArgStr(sv.name)
            )
        )
        ret
    end
    serr(
        s, 16, sp, co.Format2(
            i18.Tr("struct '%s' has no static member '%s'"), co.ArgStr(sv.name), co.ArgStr(mname)
        )
    )
end

func static_member_rewrite(s &: Sema, a &: at.Ast, nid: int): int:
    n := at.Get(a, nid)
    if n.kind != at.AST_MEMBER or n.a == 0:
        ret 0
    end
    sp := span_of(a, nid)
    obj := at.Get(a, n.a)
    if obj.kind == at.AST_IDENTIFIER:
        sy := scope_lookup(s, s.cur, obj.name)
        if sy == 0 or sym_at(s, sy).kind != SYM_STRUCT:
            ret 0
        end
        mname := static_member_name(sym_at(s, sy).name, n.name)
        m := scope_lookup_local(s, static_home(s, sy), mname)
        if m == 0:
            static_missing(s, sy, n.name, sp)
            ret 2
        end
        if not sym_at(s, m).is_pub and not sema_in_struct(s, sy):
            serr(
                s, 17, sp, co.Format2(
                    i18.Tr("static member '%s' is private in struct '%s' (mark it 'pub')"), co.ArgStr(n.name), co.ArgStr(sym_at(s, sy).name)
                )
            )
        end
        mut nv := at.Get(a, nid)
        nv.kind = at.AST_IDENTIFIER
        nv.name = mname
        nv.a = 0
        at.Put(a, nid, nv)
        ret 1
    end
    if obj.kind != at.AST_MEMBER or obj.a == 0 or at.KindOf(a, obj.a) != at.AST_IDENTIFIER:
        ret 0
    end
    pk := scope_lookup(s, s.cur, at.Get(a, obj.a).name)
    if pk == 0 or sym_at(s, pk).kind != SYM_PACKAGE:
        ret 0
    end
    pkv := sym_at(s, pk)
    sname := pkg_member_canon(s, a, pk, obj.name, span_of(a, n.a))
    st := scope_lookup_local(s, pkv.members, sname)
    if st == 0 or sym_at(s, st).kind != SYM_STRUCT:
        ret 0
    end
    mname2 := static_member_name(sname, n.name)
    m2 := scope_lookup_local(s, pkv.members, mname2)
    if m2 == 0:
        static_missing(s, st, n.name, sp)
        ret 2
    end
    if not sym_at(s, m2).is_pub:
        serr(
            s, 17, sp, co.Format2(
                i18.Tr("static member '%s' of struct '%s' is not exported (mark it 'pub')"), co.ArgStr(n.name), co.ArgStr(sname)
            )
        )
        ret 2
    end
    mut nv2 := at.Get(a, nid)
    nv2.a = obj.a
    nv2.name = mname2
    at.Put(a, nid, nv2)
    ret 1
end
