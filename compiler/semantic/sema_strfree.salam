package semantic

import str

include co "../sal_core.salam"
include at "../ast.salam"
include tok "../token.salam"

pub const SF_MARK := "__own_free"
pub const SF_MARK_VEC := "__own_free_vec"
pub const SF_MARK_MAP := "__own_free_map"
pub const SF_MARK_LAM := "__own_free_lam"

pub struct SfCand:
    pub name: str = ""
    pub decl: int = 0
    pub blk: int = 0
    pub idx: int = 0
    pub use: int = 0
    pub ok: bool = true
    pub kind: int = 0
    pub acc: bool = false
    pub keep: bool = false
    pub fresh: bool = false
    pub nasg: int = 0
end

func sf_is_concat(a &: at.Ast, nid: int): bool:
    if nid == 0:
        ret false
    end
    n := at.At(a, nid)
    ret n.kind == at.AST_BINARY and n.op == tok.TK_PLUS and str.Equals(n.type_str, "str")
end

func sf_find(cs &: Vector<SfCand>, name: str): int:
    repeat cs.len() in i:
        if str.Equals(cs.get(i).name, name):
            ret i
        end
    end
    ret 0 - 1
end

func sf_kill(cs &: Vector<SfCand>, name: str):
    i := sf_find(cs, name)
    repeat cs.len() in j:
        mut c := cs.get(j)
        if j == i or (c.acc and str.Equals(c.name, name)):
            c.ok = false
            cs.set(j, c)
        end
    end
end

func sf_has_decl(cs &: Vector<SfCand>, d: int): bool:
    repeat cs.len() in i:
        if cs.get(i).decl == d:
            ret true
        end
    end
    ret false
end

func sf_cont_kind(ts: str): int:
    if ow_is_vec(ts):
        ret 1
    end
    if ow_is_map(ts):
        ret 2
    end
    ret 0
end

func sf_empty_lit(a &: at.Ast, init: int): bool:
    mut e := init
    until e != 0 and at.KindOf(a, e) == at.AST_CAST:
        e = at.At(a, e).a
    end
    if e == 0 or at.KindOf(a, e) != at.AST_STRUCT_LIT:
        ret false
    end
    repeat at.ChildCount(a, e) in i:
        c := at.Child(a, e, i)
        if c != 0 and at.KindOf(a, c) == at.AST_FIELD_INIT:
            ret false
        end
    end
    ret true
end

func sf_fresh_init(s &: Sema, a &: at.Ast, init: int): bool:
    if sf_is_concat(a, init):
        ret true
    end
    if init == 0:
        ret false
    end
    if at.KindOf(a, init) == at.AST_LAMBDA:
        ret at.Captures(a, at.At(a, init).ext).len() > 0
    end
    ts := at.At(a, init).type_str
    if sf_cont_kind(ts) != 0:
        ret sf_empty_lit(a, init) or (at.KindOf(a, init) == at.AST_CALL and su_call_fresh(s, a, init))
    end
    ret at.KindOf(a, init) == at.AST_CALL and str.Equals(ts, "str") and su_call_fresh(s, a, init)
end

func sf_collect(s &: Sema, a &: at.Ast, nid: int, arm: bool, cs &: Vector<SfCand>, seen &: Vector<str>, dup &: Vector<str>):
    if nid == 0:
        ret
    end
    k := at.KindOf(a, nid)
    if k == at.AST_VAR_DECL or k == at.AST_CONST_DECL or k == at.AST_PARAM or k == at.AST_REPEAT:
        nm := at.At(a, nid).name
        if str.Len(nm) > 0:
            mut hit := false
            repeat seen.len() in i:
                if str.Equals(seen.get(i), nm):
                    hit = true
                end
            end
            if hit:
                dup.push(nm)
            else:
                seen.push(nm)
            end
        end
    end
    if k == at.AST_BLOCK and not arm:
        repeat at.ChildCount(a, nid) in j:
            c := at.Child(a, nid, j)
            if c != 0 and at.KindOf(a, c) == at.AST_VAR_DECL and not sf_has_decl(cs, c):
                ci0 := at.At(a, c).a
                if at.At(a, c).is_mut and ci0 != 0 and str.Equals(at.At(a, ci0).type_str, "str"):
                    cs.push(SfCand { name = at.At(a, c).name, decl = c, blk = nid, idx = j, kind = 3, acc = true, fresh = sf_fresh_init(s, a, ci0) })
                else sf_fresh_init(s, a, ci0):
                    ck := sf_cont_kind(at.At(a, ci0).type_str)
                    if ck != 0 or not at.At(a, c).is_mut:
                        cs.push(SfCand { name = at.At(a, c).name, decl = c, blk = nid, idx = j, kind = ck })
                    end
                end
            end
        end
    end
    na := at.At(a, nid).a
    nb := at.At(a, nid).b
    nc := at.At(a, nid).c
    nd := at.At(a, nid).d
    sf_collect(s, a, na, k == at.AST_MATCH_ARM, cs, seen, dup)
    sf_collect(s, a, nb, k == at.AST_MATCH_ARM, cs, seen, dup)
    sf_collect(s, a, nc, k == at.AST_MATCH_ARM, cs, seen, dup)
    sf_collect(s, a, nd, k == at.AST_MATCH_ARM, cs, seen, dup)
    repeat at.ChildCount(a, nid) in m:
        sf_collect(s, a, at.Child(a, nid, m), false, cs, seen, dup)
    end
end

func sf_is_print(a &: at.Ast, callee: int): bool:
    if callee == 0 or at.KindOf(a, callee) != at.AST_IDENTIFIER:
        ret false
    end
    nm := at.At(a, callee).name
    ret str.Equals(nm, "print") or str.Equals(nm, "println") or str.Equals(nm, "printerr") or str.Equals(nm, "printerrln")
end

func sf_assigned(a &: at.Ast, pm &: HashMap<int, int>, r: int): bool:
    mut cur := r
    until true:
        p := su_parent(pm, cur)
        if p == 0:
            ret false
        end
        k := at.KindOf(a, p)
        if k == at.AST_ASSIGN:
            ret at.At(a, p).a == cur
        end
        if (k == at.AST_MEMBER or k == at.AST_INDEX) and at.At(a, p).a == cur:
            cur = p
            continue
        end
        ret false
    end
end

func sf_calls_in(a &: at.Ast, nid: int, out &: Vector<int>):
    if nid == 0:
        ret
    end
    k := at.KindOf(a, nid)
    if k == at.AST_LAMBDA or k == at.AST_BLOCK or k == at.AST_MATCH:
        ret
    end
    if k == at.AST_CALL:
        out.push(nid)
    end
    na := at.At(a, nid).a
    nb := at.At(a, nid).b
    nc := at.At(a, nid).c
    nd := at.At(a, nid).d
    sf_calls_in(a, na, out)
    sf_calls_in(a, nb, out)
    sf_calls_in(a, nc, out)
    sf_calls_in(a, nd, out)
    repeat at.ChildCount(a, nid) in i:
        sf_calls_in(a, at.Child(a, nid, i), out)
    end
end

func sf_writes_any(a &: at.Ast, nid: int, names: Vector<str>): bool:
    if nid == 0:
        ret false
    end
    k := at.KindOf(a, nid)
    if k == at.AST_LAMBDA:
        ret false
    end
    if k == at.AST_ASSIGN or k == at.AST_INCDEC:
        r := ow_path_root(a, at.At(a, nid).a)
        repeat names.len() in i:
            if str.Equals(r, names.get(i)):
                ret true
            end
        end
    end
    if at.At(a, nid).ref_arg:
        r2 := ow_path_root(a, nid)
        repeat names.len() in j:
            if str.Equals(r2, names.get(j)):
                ret true
            end
        end
    end
    na := at.At(a, nid).a
    nb := at.At(a, nid).b
    nc := at.At(a, nid).c
    nd := at.At(a, nid).d
    if sf_writes_any(a, na, names) or sf_writes_any(a, nb, names) or sf_writes_any(a, nc, names) or sf_writes_any(a, nd, names):
        ret true
    end
    repeat at.ChildCount(a, nid) in m:
        if sf_writes_any(a, at.Child(a, nid, m), names):
            ret true
        end
    end
    ret false
end

func sf_hoist_stmt(s &: Sema, a &: at.Ast, blk: int, idx: int): int:
    st := at.Child(a, blk, idx)
    if st == 0:
        ret 0
    end
    sk := at.KindOf(a, st)
    if sk != at.AST_EXPR_STMT and sk != at.AST_VAR_DECL and sk != at.AST_ASSIGN and sk != at.AST_RETURN:
        ret 0
    end
    mut calls := Vector {} as Vector<int>
    sf_calls_in(a, st, calls)
    mut added := 0
    repeat calls.len() in ci:
        call := calls.get(ci)
        repeat at.ChildCount(a, call) in ai:
            lam := at.Child(a, call, ai)
            if lam == 0 or at.KindOf(a, lam) != at.AST_LAMBDA or at.Captures(a, at.At(a, lam).ext).len() == 0:
                continue
            end
            if su_arg_effect(s, a, call, ai + 1) != SU_READ:
                continue
            end
            mut names := Vector {} as Vector<str>
            caps := at.Captures(a, at.At(a, lam).ext)
            repeat caps.len() in q:
                names.push(at.At(a, caps.get(q)).name)
            end
            blocked := sf_writes_any(a, st, names)
            names.free()
            if blocked:
                continue
            end
            sp := span_of(a, lam)
            lts := at.At(a, lam).type_str
            lst := at.At(a, lam).sema_type
            nm := "__lam" + str.FromInt(lam as i64)
            decl := ea_decl(a, nm, lam, false, sp)
            mut dv := at.Get(a, decl)
            dv.type_str = lts
            dv.sema_type = lst
            at.Put(a, decl, dv)
            idn := ea_ident(a, nm, sp)
            mut iv := at.Get(a, idn)
            iv.type_str = lts
            iv.sema_type = lst
            at.Put(a, idn, iv)
            mut cv := at.Get(a, call)
            cv.list.set(ai, idn)
            at.Put(a, call, cv)
            mut bv := at.Get(a, blk)
            bv.list.insert(idx, decl)
            at.Put(a, blk, bv)
            added += 1
        end
    end
    calls.free()
    ret added
end

func sf_pure_call(s &: Sema, a &: at.Ast, call: int): bool:
    d := su_call_decl(s, call)
    if d != 0:
        ret at.At(a, d).is_pure
    end
    callee := at.At(a, call).a
    if callee == 0 or at.KindOf(a, callee) != at.AST_MEMBER:
        ret false
    end
    recv := at.At(a, callee).a
    ret recv != 0 and str.Equals(at.At(a, recv).type_str, "str")
end

func sf_expr_pure(s &: Sema, a &: at.Ast, nid: int): bool:
    if nid == 0:
        ret true
    end
    k := at.KindOf(a, nid)
    if k == at.AST_LITERAL or k == at.AST_IDENTIFIER or k == at.AST_THIS:
        ret true
    end
    n := at.At(a, nid)
    if k == at.AST_MEMBER or k == at.AST_UNARY or k == at.AST_CAST:
        ret sf_expr_pure(s, a, n.a)
    end
    if k == at.AST_INDEX or k == at.AST_BINARY:
        ret sf_expr_pure(s, a, n.a) and sf_expr_pure(s, a, n.b)
    end
    if k == at.AST_TERNARY:
        ret sf_expr_pure(s, a, n.a) and sf_expr_pure(s, a, n.b) and sf_expr_pure(s, a, n.c)
    end
    if k == at.AST_CALL:
        if not sf_pure_call(s, a, nid) or not sf_expr_pure(s, a, n.a):
            ret false
        end
        repeat at.ChildCount(a, nid) in i:
            c := at.Child(a, nid, i)
            if not sf_expr_pure(s, a, c) or at.At(a, c).ref_arg:
                ret false
            end
        end
        ret true
    end
    ret false
end

func sf_is_pkg_ident(s &: Sema, a &: at.Ast, nid: int): bool:
    if nid == 0 or at.KindOf(a, nid) != at.AST_IDENTIFIER:
        ret false
    end
    pk := scope_lookup(s, s.global, at.At(a, nid).name)
    ret pk != 0 and sym_at(s, pk).kind == SYM_PACKAGE
end

func sf_local_ident(s &: Sema, a &: at.Ast, nid: int): bool:
    if nid == 0 or at.KindOf(a, nid) != at.AST_IDENTIFIER:
        ret false
    end
    pk := scope_lookup(s, s.global, at.At(a, nid).name)
    ret pk == 0 or sym_at(s, pk).kind != SYM_VAR
end

func sf_has_unsafe(a &: at.Ast, nid: int): bool:
    if nid == 0:
        ret false
    end
    k := at.KindOf(a, nid)
    if k == at.AST_LAMBDA or k == at.AST_FUNC_ADDR or at.At(a, nid).ref_arg:
        ret true
    end
    if sf_has_unsafe(a, at.At(a, nid).a) or sf_has_unsafe(a, at.At(a, nid).b) or sf_has_unsafe(a, at.At(a, nid).c) or sf_has_unsafe(a, at.At(a, nid).d):
        ret true
    end
    repeat at.ChildCount(a, nid) in i:
        if sf_has_unsafe(a, at.Child(a, nid, i)):
            ret true
        end
    end
    ret false
end

func sf_before_ok(s &: Sema, a &: at.Ast, x: int, level: int): bool:
    if x == 0:
        ret true
    end
    if level == 0:
        ret sf_expr_pure(s, a, x)
    end
    if at.KindOf(a, x) == at.AST_LITERAL:
        ret true
    end
    ret level == 1 and sf_local_ident(s, a, x)
end

func sf_callee_ok(s &: Sema, a &: at.Ast, callee: int, level: int): bool:
    if callee == 0:
        ret false
    end
    if level == 0:
        ret sf_expr_pure(s, a, callee)
    end
    k := at.KindOf(a, callee)
    if k == at.AST_IDENTIFIER:
        ret true
    end
    if k != at.AST_MEMBER:
        ret false
    end
    obj := at.At(a, callee).a
    ret sf_is_pkg_ident(s, a, obj) or (level == 1 and sf_local_ident(s, a, obj))
end

func sf_tmp_cands(a &: at.Ast, nid: int, out &: Vector<int>):
    if nid == 0:
        ret
    end
    k := at.KindOf(a, nid)
    n := at.At(a, nid)
    if k == at.AST_CALL:
        out.push(nid)
        sf_tmp_cands(a, n.a, out)
        repeat at.ChildCount(a, nid) in i:
            sf_tmp_cands(a, at.Child(a, nid, i), out)
        end
        ret
    end
    if k == at.AST_MEMBER or k == at.AST_UNARY or k == at.AST_CAST or k == at.AST_TERNARY:
        sf_tmp_cands(a, n.a, out)
        ret
    end
    if k == at.AST_INDEX:
        sf_tmp_cands(a, n.a, out)
        sf_tmp_cands(a, n.b, out)
        ret
    end
    if k == at.AST_BINARY:
        sf_tmp_cands(a, n.a, out)
        if n.op != tok.TK_AND and n.op != tok.TK_OR:
            sf_tmp_cands(a, n.b, out)
        end
    end
end

func sf_tmp_arg_ok(s &: Sema, a &: at.Ast, call: int, ai: int): bool:
    t := at.Child(a, call, ai)
    if t == 0 or sf_is_print(a, at.At(a, call).a):
        ret false
    end
    if not sf_is_concat(a, t):
        if at.KindOf(a, t) != at.AST_CALL or not str.Equals(at.At(a, t).type_str, "str") or not su_call_fresh(s, a, t):
            ret false
        end
    end
    ret su_arg_effect(s, a, call, ai + 1) == SU_READ
end

func sf_tmp_valid(s &: Sema, a &: at.Ast, pm &: HashMap<int, int>, st: int, t: int): bool:
    mut strict := 0
    if not sf_expr_pure(s, a, t):
        strict = sf_has_unsafe(a, t) ? 2 : 1
    end
    mut cur := t
    mut steps := 0
    until steps < 64:
        steps += 1
        p := su_parent(pm, cur)
        if p == 0:
            ret false
        end
        pn := at.At(a, p)
        k := pn.kind
        if p == st:
            if k == at.AST_IF or k == at.AST_VAR_DECL or k == at.AST_RETURN or k == at.AST_EXPR_STMT:
                ret pn.a == cur
            end
            if k == at.AST_ASSIGN:
                ret pn.b == cur and sf_before_ok(s, a, pn.a, strict)
            end
            ret false
        end
        if k == at.AST_CALL:
            if pn.a == cur or not sf_callee_ok(s, a, pn.a, strict):
                ret false
            end
            mut seen := false
            repeat at.ChildCount(a, p) in i:
                c := at.Child(a, p, i)
                if c == cur:
                    seen = true
                end
                if not seen and not sf_before_ok(s, a, c, strict):
                    ret false
                end
            end
        else k == at.AST_BINARY:
            if pn.op == tok.TK_AND or pn.op == tok.TK_OR:
                if pn.a != cur:
                    ret false
                end
            else pn.b == cur and not sf_before_ok(s, a, pn.a, strict):
                ret false
            end
        else k == at.AST_INDEX:
            if pn.b == cur and not sf_before_ok(s, a, pn.a, strict):
                ret false
            end
            if pn.a != cur and pn.b != cur:
                ret false
            end
        else k == at.AST_UNARY or k == at.AST_CAST or k == at.AST_MEMBER or k == at.AST_TERNARY:
            if pn.a != cur:
                ret false
            end
        else:
            ret false
        end
        cur = p
    end
    ret false
end

func sf_tmp_hoist(s &: Sema, a &: at.Ast, blk: int, idx: int): int:
    st := at.Child(a, blk, idx)
    if st == 0:
        ret 0
    end
    sk := at.KindOf(a, st)
    if sk != at.AST_EXPR_STMT and sk != at.AST_VAR_DECL and sk != at.AST_ASSIGN and sk != at.AST_RETURN and sk != at.AST_IF:
        ret 0
    end
    root := sk == at.AST_ASSIGN ? at.At(a, st).b : at.At(a, st).a
    mut calls := Vector {} as Vector<int>
    sf_tmp_cands(a, root, calls)
    mut cands := Vector {} as Vector<int>
    mut cslot := Vector {} as Vector<int>
    repeat calls.len() in ci:
        call := calls.get(ci)
        repeat at.ChildCount(a, call) in ai:
            if sf_tmp_arg_ok(s, a, call, ai):
                cands.push(call)
                cslot.push(ai)
            end
        end
    end
    calls.free()
    if cands.len() == 0:
        cands.free()
        cslot.free()
        ret 0
    end
    mut pm := HashMap {} as HashMap<int, int>
    su_par_build(a, st, 0, pm)
    mut ts := Vector {} as Vector<int>
    repeat cands.len() in ti:
        ts.push(at.Child(a, cands.get(ti), cslot.get(ti)))
    end
    mut added := 0
    repeat cands.len() in q:
        call := cands.get(q)
        ai := cslot.get(q)
        t := ts.get(q)
        mut nested := false
        mut ancestor := su_parent(pm, t)
        until ancestor != 0 and ancestor != st:
            repeat ts.len() in w:
                if ts.get(w) == ancestor:
                    nested = true
                end
            end
            ancestor = su_parent(pm, ancestor)
        end
        if nested or not sf_tmp_valid(s, a, pm, st, t):
            continue
        end
        sp := span_of(a, t)
        tts := at.At(a, t).type_str
        tst := at.At(a, t).sema_type
        nm := "__tmp" + str.FromInt(t as i64)
        decl := ea_decl(a, nm, t, false, sp)
        mut dv := at.Get(a, decl)
        dv.type_str = tts
        dv.sema_type = tst
        at.Put(a, decl, dv)
        idn := ea_ident(a, nm, sp)
        mut iv := at.Get(a, idn)
        iv.type_str = tts
        iv.sema_type = tst
        at.Put(a, idn, iv)
        mut cv := at.Get(a, call)
        cv.list.set(ai, idn)
        at.Put(a, call, cv)
        pos := idx + added
        mut bv := at.Get(a, blk)
        bv.list.insert(pos, decl)
        at.Put(a, blk, bv)
        added += 1
        added += sf_tmp_hoist(s, a, blk, pos)
    end
    pm.free()
    cands.free()
    cslot.free()
    ts.free()
    ret added
end

func sf_elif_hoist(s &: Sema, a &: at.Ast, st: int):
    if st == 0 or at.KindOf(a, st) != at.AST_IF:
        ret
    end
    mut cur := st
    until cur != 0:
        e := at.At(a, cur).c
        if e == 0 or at.KindOf(a, e) != at.AST_IF:
            ret
        end
        blk := ea_node(a, at.AST_BLOCK, span_of(a, e))
        at.AddChild(a, blk, e)
        if sf_tmp_hoist(s, a, blk, 0) > 0:
            mut cv := at.Get(a, cur)
            cv.c = blk
            at.Put(a, cur, cv)
            ret
        end
        cur = e
    end
end

func sf_hoist(s &: Sema, a &: at.Ast, nid: int, arm: bool):
    if nid == 0:
        ret
    end
    k := at.KindOf(a, nid)
    if k == at.AST_LAMBDA:
        ret
    end
    if k == at.AST_BLOCK and not arm:
        mut j := at.ChildCount(a, nid)
        until j > 0:
            j -= 1
            hl := sf_hoist_stmt(s, a, nid, j)
            th := sf_tmp_hoist(s, a, nid, j + hl)
            sf_elif_hoist(s, a, at.Child(a, nid, j + hl + th))
        end
    end
    na := at.At(a, nid).a
    nb := at.At(a, nid).b
    nc := at.At(a, nid).c
    nd := at.At(a, nid).d
    sf_hoist(s, a, na, k == at.AST_MATCH_ARM)
    sf_hoist(s, a, nb, k == at.AST_MATCH_ARM)
    sf_hoist(s, a, nc, k == at.AST_MATCH_ARM)
    sf_hoist(s, a, nd, k == at.AST_MATCH_ARM)
    repeat at.ChildCount(a, nid) in m:
        sf_hoist(s, a, at.Child(a, nid, m), false)
    end
end

func sf_insert(a &: at.Ast, c: SfCand):
    useid := c.use
    idn := at.NewNode(a, at.AST_IDENTIFIER)
    mut iv := at.Get(a, useid)
    iv.list = Vector {} as Vector<int>
    iv.ext = 0
    iv.synthetic = true
    iv.ref_arg = false
    iv.ref_arg_ptr = false
    at.Put(a, idn, iv)
    es := at.NewNode(a, at.AST_EXPR_STMT)
    mut ev := at.Get(a, c.decl)
    ev.kind = at.AST_EXPR_STMT
    is_lam := at.At(a, c.decl).a != 0 and at.KindOf(a, at.At(a, c.decl).a) == at.AST_LAMBDA
    ev.name = c.kind == 1 ? SF_MARK_VEC : (c.kind == 2 ? SF_MARK_MAP : (is_lam ? SF_MARK_LAM : SF_MARK))
    ev.synthetic = true
    ev.a = idn
    ev.b = 0
    ev.c = 0
    ev.d = 0
    ev.ty = 0
    ev.type_str = ""
    ev.list = Vector {} as Vector<int>
    ev.ext = 0
    at.Put(a, es, ev)
    df := at.NewNode(a, at.AST_DEFER)
    mut dv := at.Get(a, es)
    dv.kind = at.AST_DEFER
    dv.name = ""
    dv.a = es
    dv.list = Vector {} as Vector<int>
    dv.ext = 0
    at.Put(a, df, dv)
    mut bv := at.Get(a, c.blk)
    pos := c.idx + 1
    if pos >= bv.list.len():
        bv.list.push(df)
    else:
        bv.list.insert(pos, df)
    end
    at.Put(a, c.blk, bv)
    if is_lam:
        mut dl := at.Get(a, c.decl)
        dl.stack_env = true
        at.Put(a, c.decl, dl)
    end
end

func sf_typed(a &: at.Ast, id: int, ts: str, st: int):
    mut v := at.Get(a, id)
    v.type_str = ts
    v.sema_type = st
    at.Put(a, id, v)
end

func sf_acc_flag(c: SfCand): str:
    ret "__own" + str.FromInt(c.decl as i64)
end

func sf_flag_ident(s &: Sema, a &: at.Ast, name: str, sp: co.SrcSpan): int:
    id := ea_ident(a, name, sp)
    sf_typed(a, id, "bool", sema_ty(s, TY_BOOL))
    ret id
end

func sf_bool_lit(s &: Sema, a &: at.Ast, val: bool, sp: co.SrcSpan): int:
    id := ea_node(a, at.AST_LITERAL, sp)
    mut v := at.Get(a, id)
    v.op = val ? tok.TK_KW_TRUE : tok.TK_KW_FALSE
    v.value_kind = tok.TV_BOOL
    v.value_bool = val
    v.value_int = val ? 1 as u64 : 0 as u64
    v.type_str = "bool"
    v.sema_type = sema_ty(s, TY_BOOL)
    at.Put(a, id, v)
    ret id
end

func sf_free_if(s &: Sema, a &: at.Ast, c: SfCand, sp: co.SrcSpan): int:
    un := at.Get(a, c.use)
    idn := ea_ident(a, c.name, sp)
    sf_typed(a, idn, un.type_str, un.sema_type)
    mk := ea_node(a, at.AST_EXPR_STMT, sp)
    mut mv := at.Get(a, mk)
    mv.name = SF_MARK
    mv.a = idn
    at.Put(a, mk, mv)
    blk := ea_node(a, at.AST_BLOCK, sp)
    at.AddChild(a, blk, mk)
    ifn := ea_node(a, at.AST_IF, sp)
    mut iv := at.Get(a, ifn)
    iv.a = sf_flag_ident(s, a, sf_acc_flag(c), sp)
    iv.b = blk
    at.Put(a, ifn, iv)
    ret ifn
end

func sf_insert_acc(s &: Sema, a &: at.Ast, c: SfCand):
    sp := span_of(a, c.decl)
    fd := ea_decl(a, sf_acc_flag(c), sf_bool_lit(s, a, c.fresh, sp), true, sp)
    sf_typed(a, fd, "bool", sema_ty(s, TY_BOOL))
    mut df := 0
    if not c.keep:
        df = ea_node(a, at.AST_DEFER, sp)
        mut dv := at.Get(a, df)
        dv.a = sf_free_if(s, a, c, sp)
        at.Put(a, df, dv)
    end
    mut bv := at.Get(a, c.blk)
    pos := c.idx + 1
    if pos >= bv.list.len():
        bv.list.push(fd)
    else:
        bv.list.insert(pos, fd)
    end
    if df != 0:
        if pos + 1 >= bv.list.len():
            bv.list.push(df)
        else:
            bv.list.insert(pos + 1, df)
        end
    end
    at.Put(a, c.blk, bv)
end

func sf_fresh_rhs(s &: Sema, a &: at.Ast, e: int): bool:
    if e == 0:
        ret false
    end
    if sf_is_concat(a, e):
        ret true
    end
    ret at.KindOf(a, e) == at.AST_CALL and str.Equals(at.At(a, e).type_str, "str") and su_call_fresh(s, a, e)
end

func sf_acc_assign_ok(s &: Sema, a &: at.Ast, pm &: HashMap<int, int>, p: int, name: str): bool:
    n := at.At(a, p)
    if n.b == 0 or (n.op != tok.TK_ASSIGN and n.op != tok.TK_PLUS_EQ):
        ret false
    end
    blk := su_parent(pm, p)
    if blk == 0 or at.KindOf(a, blk) != at.AST_BLOCK:
        ret false
    end
    bp := su_parent(pm, blk)
    if bp != 0 and at.KindOf(a, bp) == at.AST_MATCH_ARM:
        ret false
    end
    if n.op == tok.TK_PLUS_EQ:
        ret str.Equals(at.At(a, n.b).type_str, "str")
    end
    mut inner := Vector {} as Vector<int>
    su_collect_refs(a, n.b, name, inner)
    reads := inner.len() > 0
    inner.free()
    ret not reads or sf_fresh_rhs(s, a, n.b)
end

func sf_acc_eval(s &: Sema, a &: at.Ast, pm &: HashMap<int, int>, body: int, c: SfCand): SfCand:
    mut r2 := c
    mut refs := Vector {} as Vector<int>
    su_collect_refs(a, body, c.name, refs)
    repeat refs.len() in ri:
        r := refs.get(ri)
        if r2.use == 0:
            r2.use = r
        end
        rn := at.At(a, r)
        if su_in_lambda(a, pm, r) or rn.ref_arg or rn.ref_arg_ptr:
            r2.ok = false
            continue
        end
        p := su_parent(pm, r)
        if p != 0 and at.KindOf(a, p) == at.AST_ASSIGN and at.At(a, p).a == r:
            r2.nasg += 1
            if not sf_acc_assign_ok(s, a, pm, p, c.name):
                r2.ok = false
            end
            continue
        end
        cl := su_classify(s, a, pm, r)
        if cl == SU_RET:
            r2.keep = true
        else cl != SU_READ:
            r2.ok = false
        end
    end
    refs.free()
    if r2.nasg == 0:
        r2.ok = false
    end
    ret r2
end

func sf_acc_rewrite(s &: Sema, a &: at.Ast, pm &: HashMap<int, int>, body: int, c: SfCand):
    mut refs := Vector {} as Vector<int>
    su_collect_refs(a, body, c.name, refs)
    flag := sf_acc_flag(c)
    repeat refs.len() in ri:
        r := refs.get(ri)
        p := su_parent(pm, r)
        if p == 0 or at.KindOf(a, p) != at.AST_ASSIGN or at.At(a, p).a != r:
            continue
        end
        blk := su_parent(pm, p)
        sp := span_of(a, p)
        rn := at.Get(a, r)
        pn := at.Get(a, p)
        mut rhs := pn.b
        mut fresh := false
        if pn.op == tok.TK_PLUS_EQ:
            lhs2 := ea_ident(a, c.name, sp)
            sf_typed(a, lhs2, rn.type_str, rn.sema_type)
            rhs = ea_binary(a, tok.TK_PLUS, lhs2, rhs, sp)
            sf_typed(a, rhs, "str", rn.sema_type)
            fresh = true
        else:
            fresh = sf_fresh_rhs(s, a, rhs)
        end
        mut pre := Vector {} as Vector<int>
        mut newb := rhs
        if at.KindOf(a, rhs) != at.AST_LITERAL:
            nm := "__ac" + str.FromInt(p as i64)
            rts := at.At(a, rhs).type_str
            rst := at.At(a, rhs).sema_type
            d := ea_decl(a, nm, rhs, false, sp)
            sf_typed(a, d, rts, rst)
            idn := ea_ident(a, nm, sp)
            sf_typed(a, idn, rts, rst)
            pre.push(d)
            newb = idn
        end
        cu := SfCand { name = c.name, decl = c.decl, use = r }
        pre.push(sf_free_if(s, a, cu, sp))
        mut pw := at.Get(a, p)
        pw.b = newb
        pw.op = tok.TK_ASSIGN
        at.Put(a, p, pw)
        post := ea_node(a, at.AST_ASSIGN, sp)
        mut qv := at.Get(a, post)
        qv.op = tok.TK_ASSIGN
        qv.a = sf_flag_ident(s, a, flag, sp)
        qv.b = sf_bool_lit(s, a, fresh, sp)
        qv.type_str = "bool"
        qv.sema_type = sema_ty(s, TY_BOOL)
        at.Put(a, post, qv)
        mut bv := at.Get(a, blk)
        mut pos := 0
        repeat bv.list.len() in q:
            if bv.list.get(q) == p:
                pos = q
            end
        end
        repeat pre.len() in w:
            bv.list.insert(pos + w, pre.get(w))
        end
        after := pos + pre.len() + 1
        if after >= bv.list.len():
            bv.list.push(post)
        else:
            bv.list.insert(after, post)
        end
        at.Put(a, blk, bv)
        pre.free()
    end
    refs.free()
end

pub func SemaAutoFreeStrings(s &: Sema, a &: at.Ast, fnid: int):
    if g_sm_ownership == 0 or fnid == 0 or s.in_derive or s.requal:
        ret
    end
    body := at.At(a, fnid).a
    if body == 0:
        ret
    end
    sf_hoist(s, a, body, false)
    mut cs := Vector {} as Vector<SfCand>
    mut seen := Vector {} as Vector<str>
    mut dup := Vector {} as Vector<str>
    repeat at.ChildCount(a, fnid) in p:
        pc := at.Child(a, fnid, p)
        if pc != 0 and at.KindOf(a, pc) == at.AST_PARAM:
            seen.push(at.At(a, pc).name)
        end
    end
    sf_collect(s, a, body, false, cs, seen, dup)
    if cs.len() == 0:
        cs.free()
        seen.free()
        dup.free()
        ret
    end
    repeat dup.len() in d:
        sf_kill(cs, dup.get(d))
    end
    mut pm := HashMap {} as HashMap<int, int>
    su_par_build(a, body, 0, pm)
    repeat cs.len() in ci:
        mut c := cs.get(ci)
        if c.ok and c.acc:
            c = sf_acc_eval(s, a, pm, body, c)
            cs.set(ci, c)
        else c.ok:
            mut refs := Vector {} as Vector<int>
            su_collect_refs(a, body, c.name, refs)
            repeat refs.len() in ri:
                r := refs.get(ri)
                if c.use == 0:
                    c.use = r
                end
                cl := su_classify(s, a, pm, r)
                if su_in_lambda(a, pm, r) or not (cl == SU_READ or (c.kind != 0 and cl == SU_GROW)) or sf_assigned(a, pm, r):
                    c.ok = false
                end
            end
            refs.free()
            cs.set(ci, c)
        end
    end
    mut i := cs.len()
    until i > 0:
        i -= 1
        c := cs.get(i)
        if c.ok and c.use != 0:
            if c.acc:
                sf_insert_acc(s, a, c)
            else:
                sf_insert(a, c)
            end
        end
    end
    repeat cs.len() in ai:
        ac := cs.get(ai)
        if ac.ok and ac.use != 0 and ac.acc:
            sf_acc_rewrite(s, a, pm, body, ac)
        end
    end
    pm.free()
    cs.free()
    seen.free()
    dup.free()
end
