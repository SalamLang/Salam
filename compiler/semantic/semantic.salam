pub type TypeId = int
pub type ScopeId = int
pub type SymId = int
pub type SigId = int

pub struct Type:
    pub kind: int = 0
    pub elem: int = TYPE_NONE
    pub length: i64 = 0 as i64
    pub pointee: int = TYPE_NONE
    pub key: int = TYPE_NONE
    pub decl: int = 0
    pub name: str = ""
    pub params: Vector<int> = Vector {}
    pub enum_val_kind: int = 0
    pub distinct: int = 0
    pub base: int = TYPE_NONE
end

pub struct Sig:
    pub params: Vector<int> = Vector {}
    pub required: int = 0
    pub ret_type: int = TYPE_NONE
    pub ret_span: co.SrcSpan = co.EmptySpan()
    pub ret_int_span: co.SrcSpan = co.EmptySpan()
    pub ret_int_seen: bool = false
    pub ret_float_seen: bool = false
    pub decl: int = 0
    pub owner: int = 0
    pub mangled: str = ""
    pub variadic: bool = false
    pub infer_ret: bool = false
    pub ret_weak: bool = false
    pub ret_widened: bool = false
    pub checked: bool = false
    pub in_check: bool = false
end

pub struct Symbol:
    pub kind: int = 0
    pub name: str = ""
    pub ty: int = TYPE_NONE
    pub is_mut: bool = false
    pub is_ref: bool = false
    pub is_pub: bool = false
    pub used: bool = false
    pub mutated: bool = false
    pub loop_bind: bool = false
    pub decl: int = 0
    pub overloads: Vector<int> = Vector {}
    pub members: int = 0
    pub enum_value: i64 = 0 as i64
    pub enum_val_kind: int = 0
    pub enum_value_f: f64 = 0.0
    pub enum_value_str: str = ""
    pub has_ival: bool = false
    pub ival: i64 = 0 as i64
    pub pkgname: str = ""
    pub generic_base: str = ""
    pub generic_args: Vector<int> = Vector {}
    pub home: int = 0
    pub enum_data: bool = false
    pub enum_case: bool = false
    pub slice_of: str = ""
end

pub struct ConstVal:
    pub kind: int = CV_NONE
    pub i: i64 = 0 as i64
    pub f: f64 = 0.0
    pub b: bool = false
end

pub struct Scope:
    pub kind: int = 0
    pub parent: int = 0
    pub symbols: Vector<int> = Vector {}
    pub self_type: int = TYPE_NONE
    pub fn: int = 0
    pub label: str = ""
    pub aux: int = 0
    pub lang: str = ""
end

pub struct LambdaCtx:
    pub boundary: int = 0
    pub node: int = 0
end

pub struct MatchYield:
    pub ret_node: int = 0
    pub ty: int = TYPE_NONE
end

pub struct Builtin:
    pub name: str = ""
    pub runtime: str = ""
    pub nargs: int = 0
    pub ret_type: str = ""
    pub arg: str = ""
end

pub struct Sema:
    pub log: lg.Logger = lg.New(2, false)
    pub diag: dg.Engine = dg.NewDefault(2, false, 4)
    pub file: str = ""
    pub lang: str = "en"
    pub fpack_file: Vector<str> = Vector {}
    pub fpack_code: Vector<int> = Vector {}
    pub types: Vector<Type> = Vector {}
    pub arrays_intern: Vector<int> = Vector {}
    pub ptrs_intern: Vector<int> = Vector {}
    pub scopes: Vector<Scope> = Vector {}
    pub syms: Vector<Symbol> = Vector {}
    pub sigs: Vector<Sig> = Vector {}
    pub global: int = 0
    pub cur: int = 0
    pub self_type: int = TYPE_NONE
    pub static_owner: int = 0
    pub cur_func: int = 0
    pub loop_depth: int = 0
    pub switch_depth: int = 0
    pub dir: str = ""
    pub imported: Vector<str> = Vector {}
    pub pkg: str = ""
    pub pkg_cache_paths: Vector<str> = Vector {}
    pub pkg_cache_syms: Vector<int> = Vector {}
    pub loading: Vector<str> = Vector {}
    pub program: int = 0
    pub pending: Vector<int> = Vector {}
    pub noret_calls: Vector<bool> = Vector {}
    pub exhaustive: Vector<bool> = Vector {}
    pub covers_all: Vector<bool> = Vector {}
    pub term_covers_all: bool = false
    pub expected: int = TYPE_NONE
    pub cast_ctx: int = TYPE_NONE
    pub lam: Vector<LambdaCtx> = Vector {}
    pub gen_pkg: int = 0
    pub prelude: int = 0
    pub prelude_tried: bool = false
    pub in_pkg: bool = false
    pub in_generic_inst: bool = false
    pub derived_scopes: Vector<int> = Vector {}
    pub derived_names: Vector<str> = Vector {}
    pub derived_decls: Vector<int> = Vector {}
    pub derive_bridge: int = 0
    pub derive_bridge_home: int = 0
    pub derive_bridge_global: int = 0
    pub in_derive: bool = false
    pub relax_unused: bool = false
    pub skip_lang: bool = false
    pub requal: bool = false
    pub each_n: int = 0
    pub cctab: cc.Table = cc.TableBuild("", Vector {} as Vector<str>)
    pub has_cc: bool = false
    pub match_arm_depth: int = 0
    pub match_yield_expected: int = TYPE_NONE
    pub match_yield_active: bool = false
    pub match_yield_collect: Vector<MatchYield> = Vector {}
end
