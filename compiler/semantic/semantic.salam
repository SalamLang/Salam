// SetRelaxUnused.
mut g_sm_relax_unused := false
// builtins.c's -dNAME=VALUE table (g_cli_consts), as parallel vectors: name,
// the token kind the value lexes as, and one slot per value shape. The C
// holds these in a fixed pool because name resolution has no allocator to
// hand down; here the vectors own their storage and SetConsts replaces the
// lot. op is tok.TK_INT | TK_FLOAT | TK_STRING | TK_KW_TRUE | TK_KW_FALSE.
mut g_sm_const_name := Vector {} as Vector<str>
mut g_sm_const_op := Vector {} as Vector<int>
mut g_sm_const_int := Vector {} as Vector<u64>
mut g_sm_const_neg := Vector {} as Vector<bool>
mut g_sm_const_float := Vector {} as Vector<f64>
mut g_sm_const_str := Vector {} as Vector<str>
// The moment this build started, for SALAM_BUILD_DATE; filled in on first
// use so a program that never mentions it pays nothing.
mut g_sm_build_date := ""
// g_seg_aliases[512] + g_seg_alias_n + g_seg_alias_root as parallel vectors
// (lang, alias, canon); n = -1 means "index not built yet" like the C.
mut g_sm_seg_lang := Vector {} as Vector<str>
mut g_sm_seg_alias := Vector {} as Vector<str>
mut g_sm_seg_canon := Vector {} as Vector<str>
mut g_sm_seg_n := 0 - 1
mut g_sm_seg_root := ""

