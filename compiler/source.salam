package source

import io
import os
import mem
import str
import filepath

mut g_src_loaded := Vector {} as Vector<str>
mut g_src_digest := Vector {} as Vector<str>
mut g_src_overlay := HashMap {} as HashMap<str, str>
mut g_src_error := ""
mut g_src_shared := HashMap {} as HashMap<str, str>

pub struct SourceFile:
    pub path: str = ""
    pub text: str = ""
    pub len: int = 0
    pub nul_at: int = -1
end

func has_bom(text: str): bool:
    ret str.StartsWith(text, "\xEF\xBB\xBF")
end

func drop_bom(text: str):
    n := text.Len()
    p := text as void*
    _moved := mem.MemMove(p, ((p as i64) + (3 as i64)) as void*, (n - 2) as u64)
end

func share_text(path: str, text: str): str:
    if str.Len(text) == 0:
        ret text
    end
    if not g_src_shared.Has(path):
        g_src_shared.Put(str.Clone(path), text)
        ret text
    end
    old := g_src_shared.Get(path)
    if str.Equals(old, text):
        mem.Free(text as void*)
        ret old
    end
    g_src_shared.Put(path, text)
    ret text
end

pub func DigestFeed(p: void*, n: int, h1 &: u64, h2 &: u64):
    bp := p as u8*
    mask := 4294967295 as u64
    mut a := h1
    mut b := h2
    repeat n in i:
        c := bp[i] as u64
        a = ((a ^ c) * (16777619 as u64)) & mask
        b = ((b * (33 as u64)) + c) & mask
    end
    h1 = a
    h2 = b
end

pub func DigestSeed(h1 &: u64, h2 &: u64):
    h1 = 2166136261 as u64
    h2 = 5381 as u64
end

pub func DigestFormat(n: i64, h1: u64, h2: u64): str:
    ret str.FromInt(n) + ":" + str.FromInt(h1 as i64) + "-" + str.FromInt(h2 as i64)
end

pub func DigestText(text: str): str:
    mut h1 := 0 as u64
    mut h2 := 0 as u64
    DigestSeed(h1, h2)
    n := text.Len()
    DigestFeed(text as void*, n, h1, h2)
    ret DigestFormat(n as i64, h1, h2)
end

pub func New(): SourceFile:
    ret SourceFile {}
end

pub func SetOverlay(path: str, text: str):
    g_src_overlay.Put(filepath.Clean(path), text)
end

pub func HasOverlay(path: str): bool:
    ret g_src_overlay.Size() > 0 and g_src_overlay.Has(filepath.Clean(path))
end

pub func LoadShared(path: str, sf &: SourceFile): bool:
    if not Load(path, sf):
        ret false
    end
    sf.text = share_text(path, sf.text)
    ret true
end

pub func Load(path: str, sf &: SourceFile): bool:
    if g_src_overlay.Size() > 0:
        key := filepath.Clean(path)
        if g_src_overlay.Has(key):
            otext := str.Clone(g_src_overlay.Get(key))
            sf.path = path
            sf.text = otext
            sf.len = otext.Len()
            sf.nul_at = -1
            g_src_loaded.Push(path)
            g_src_digest.Push(DigestText(otext))
            ret true
        end
    end
    g_src_error = ""
    if not os.Exists(path):
        g_src_error = "no such file"
        ret false
    end
    if os.IsDir(path):
        g_src_error = "it is a directory"
        ret false
    end
    f := os.Open(path, "rb")
    if f == null:
        g_src_error = "permission denied or the file cannot be opened"
        ret false
    end
    f.Close()
    size := os.FileSize(path)
    text := io.ReadFile(path)
    g_src_digest.Push(size == (text.Len() as i64) ? DigestText(text) : str.Clone("-"))
    mut want := size
    if has_bom(text):
        want = size - (3 as i64)
        drop_bom(text)
    end
    sf.path = path
    sf.text = text
    sf.len = text.Len()
    sf.nul_at = -1
    if size >= (0 as i64) and want > (sf.len as i64):
        sf.nul_at = sf.len
    end
    g_src_loaded.Push(path)
    ret true
end

pub func ForgetLoaded():
    repeat g_src_digest.Len() in i:
        mem.Free(g_src_digest.Get(i) as void*)
    end
    g_src_digest.Clear()
    g_src_loaded.Clear()
end

pub func ReadError(): str:
    ret g_src_error
end

pub func Peek(path: str): str:
    if g_src_overlay.Size() > 0:
        key := filepath.Clean(path)
        if g_src_overlay.Has(key):
            ret share_text(path, str.Clone(g_src_overlay.Get(key)))
        end
    end
    if not os.Exists(path) or os.IsDir(path):
        ret ""
    end
    text := io.ReadFile(path)
    if has_bom(text):
        drop_bom(text)
    end
    ret share_text(path, text)
end

pub func LoadedPaths(): Vector<str>:
    ret g_src_loaded
end

pub func LoadedDigests(): Vector<str>:
    ret g_src_digest
end

pub func Free(sf &: SourceFile):
    if sf.len > 0:
        mem.Free(sf.text as void*)
    end
    sf.text = ""
    sf.len = 0
end
