package source

import io
import os
import mem

pub struct SourceFile:
    pub path: str = ""
    pub text: str = ""
    pub len: int = 0
end

pub func New(): SourceFile:
    ret SourceFile {}
end

pub func Load(path: str, sf &: SourceFile): bool:
    if !os.Exists(path) || os.IsDir(path):
        ret false
    end
    text := io.ReadFile(path)
    sf.path = path
    sf.text = text
    sf.len = text.len()
    ret true
end

pub func Free(sf &: SourceFile):
    if sf.len > 0:
        mem.Free(sf.text as void*)
    end
    sf.text = ""
    sf.len = 0
end
