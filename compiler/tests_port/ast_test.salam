// Smoke test for salam/ast (port of compiler/src/ast) and
// salam/token/token_xml.salam (port of compiler/src/token/token_xml.c).
// Expected XML bytes derived by hand-tracing ast_xml.c / token_xml.c against
// the xml writer semantics (also see tests_port/xml_test.salam).
// Run from the repo root:
//   SALAM_STD=$PWD/compiler ./bin/salam run salam/tests_port/ast_test.salam
import testing
import os
import at "../ast.salam"
import tok "../token.salam"
import x "../xml.salam"

// <location> block as ast_loc emits it (ind = indent of <location>).
func loc_block(ind: str, bl: int, bc: int, bi: int, el: int, ec: int): str:
    mut s := ind + "<location>\n"
    s += ind + "  <begin_line>" + bl + "</begin_line>\n"
    s += ind + "  <begin_column>" + bc + "</begin_column>\n"
    s += ind + "  <begin_index>" + bi + "</begin_index>\n"
    s += ind + "  <end_line>" + el + "</end_line>\n"
    s += ind + "  <end_column>" + ec + "</end_column>\n"
    s += ind + "</location>\n"
    ret s
end

// <location> block as tokens_to_xml emits it (fixed indent, no begin_index).
func tok_loc_block(bl: int, bc: int, el: int, ec: int): str:
    mut s := "    <location>\n"
    s += "      <begin_line>" + bl + "</begin_line>\n"
    s += "      <begin_column>" + bc + "</begin_column>\n"
    s += "      <end_line>" + el + "</end_line>\n"
    s += "      <end_column>" + ec + "</end_column>\n"
    s += "    </location>\n"
    ret s
end

func main:
    // --- kind constants (must match ast_kind_t in C exactly) ---
    testing.AssertEqInt(at.AST_PROGRAM, 0)
    testing.AssertEqInt(at.AST_IMPORT, 1)
    testing.AssertEqInt(at.AST_TYPE_ALIAS, 3)
    testing.AssertEqInt(at.AST_FUNC_DEF, 5)
    testing.AssertEqInt(at.AST_ENUM_MEMBER, 12)
    testing.AssertEqInt(at.AST_BLOCK, 13)
    testing.AssertEqInt(at.AST_VAR_DECL, 14)
    testing.AssertEqInt(at.AST_RETURN, 21)
    testing.AssertEqInt(at.AST_EXPR_STMT, 25)
    testing.AssertEqInt(at.AST_BINARY, 26)
    testing.AssertEqInt(at.AST_LITERAL, 30)
    testing.AssertEqInt(at.AST_INDEX, 36)
    testing.AssertEqInt(at.AST_SLICE, 37)
    testing.AssertEqInt(at.AST_LAMBDA, 39)
    testing.AssertEqInt(at.AST_ARRAY_LIT, 40)
    testing.AssertEqInt(at.AST_TYPE, 43)
    testing.AssertEqInt(at.AST_MATCH, 48)
    testing.AssertEqInt(at.AST_VARIANT_UNWRAP, 52)
    testing.AssertEqInt(at.AST_COUNT, 53)

    // --- KindName (strings from k_ast_names in ast.c) ---
    testing.AssertEqStr(at.KindName(at.AST_PROGRAM), "Program")
    testing.AssertEqStr(at.KindName(at.AST_TYPE_ALIAS), "TypeAlias")
    testing.AssertEqStr(at.KindName(at.AST_FUNC_DEF), "FunctionDef")
    testing.AssertEqStr(at.KindName(at.AST_VAR_DECL), "VariableDecl")
    testing.AssertEqStr(at.KindName(at.AST_ASSIGN), "Assignment")
    testing.AssertEqStr(at.KindName(at.AST_IF), "IfStmt")
    testing.AssertEqStr(at.KindName(at.AST_BINARY), "BinaryExpr")
    testing.AssertEqStr(at.KindName(at.AST_INCDEC), "IncDecExpr")
    testing.AssertEqStr(at.KindName(at.AST_MEMBER), "MemberAccess")
    testing.AssertEqStr(at.KindName(at.AST_INDEX), "ArrayAccess")
    testing.AssertEqStr(at.KindName(at.AST_SLICE), "SliceExpr")
    testing.AssertEqStr(at.KindName(at.AST_LAMBDA), "Lambda")
    testing.AssertEqStr(at.KindName(at.AST_ARRAY_LIT), "ArrayLiteral")
    testing.AssertEqStr(at.KindName(at.AST_LAYOUT_ATTR), "LayoutAttribute")
    testing.AssertEqStr(at.KindName(at.AST_MATCH), "MatchExpr")
    testing.AssertEqStr(at.KindName(at.AST_VARIANT_UNWRAP), "VariantUnwrap")
    testing.AssertEqStr(at.KindName(at.AST_COUNT), "Unknown")
    testing.AssertEqStr(at.KindName(0 - 1), "Unknown")

    // --- build: program -> func -> block -> [var decl, return binary] ---
    mut tr := at.NewAst()
    testing.AssertEqInt(at.Count(tr), 1) // id 0 = sentinel

    prog := at.NewNode(tr, at.AST_PROGRAM)
    testing.AssertEqInt(prog, 1)

    fn := at.NewNode(tr, at.AST_FUNC_DEF)
    at.SetName(tr, fn, "main")
    at.SetSpan(tr, fn, 1 as u32, 1 as u32, 0 as u32, 5 as u32, 3 as u32,
               42 as u32, 42 as u32)
    mut fnode := at.Get(tr, fn)
    fnode.is_pub = true
    at.Put(tr, fn, fnode)

    rt := at.NewNode(tr, at.AST_TYPE)
    at.SetName(tr, rt, "int")
    at.SetTypeNode(tr, fn, rt)

    p := at.NewNode(tr, at.AST_PARAM)
    at.SetName(tr, p, "n")
    pt := at.NewNode(tr, at.AST_TYPE)
    at.SetName(tr, pt, "int")
    at.SetTypeNode(tr, p, pt)
    at.AddChild(tr, fn, p)

    body := at.NewNode(tr, at.AST_BLOCK)
    mut fn2 := at.Get(tr, fn)
    fn2.a = body
    at.Put(tr, fn, fn2)

    vd := at.NewNode(tr, at.AST_VAR_DECL)
    at.SetName(tr, vd, "s")
    slit := at.NewNode(tr, at.AST_LITERAL)
    at.SetOp(tr, slit, tok.TK_STRING)
    at.SetTokenValue(tr, slit, tok.ValueStr("hi"))
    mut vnode := at.Get(tr, vd)
    vnode.a = slit
    at.Put(tr, vd, vnode)
    at.AddChild(tr, body, vd)

    rst := at.NewNode(tr, at.AST_RETURN)
    at.AddChild(tr, body, rst)

    bin := at.NewNode(tr, at.AST_BINARY)
    at.SetOp(tr, bin, tok.TK_PLUS)
    lit1 := at.NewNode(tr, at.AST_LITERAL)
    at.SetOp(tr, lit1, tok.TK_INT)
    at.SetTokenValue(tr, lit1, tok.ValueInt(2 as u64))
    lit2 := at.NewNode(tr, at.AST_LITERAL)
    at.SetOp(tr, lit2, tok.TK_INT)
    at.SetTokenValue(tr, lit2, tok.ValueInt(40 as u64))
    mut bnode := at.Get(tr, bin)
    bnode.a = lit1
    bnode.b = lit2
    at.Put(tr, bin, bnode)
    mut rnode := at.Get(tr, rst)
    rnode.a = bin
    at.Put(tr, rst, rnode)

    at.AddChild(tr, prog, fn)

    // --- structure assertions ---
    testing.AssertEqInt(at.KindOf(tr, prog), at.AST_PROGRAM)
    testing.AssertEqInt(at.KindOf(tr, fn), at.AST_FUNC_DEF)
    testing.AssertEqInt(at.ChildCount(tr, prog), 1)
    testing.AssertEqInt(at.Child(tr, prog, 0), fn)
    testing.AssertEqInt(at.ChildCount(tr, fn), 1) // params list
    testing.AssertEqInt(at.Child(tr, fn, 0), p)
    testing.AssertEqInt(at.ChildCount(tr, body), 2)
    testing.AssertEqInt(at.Child(tr, body, 0), vd)
    testing.AssertEqInt(at.Child(tr, body, 1), rst)
    testing.AssertEqInt(at.ChildCount(tr, rst), 0)
    got_fn := at.Get(tr, fn)
    testing.AssertEqStr(got_fn.name, "main")
    testing.AssertTrue(got_fn.is_pub)
    testing.AssertEqInt(got_fn.begin_line as int, 1)
    testing.AssertEqInt(got_fn.end_col as int, 3)
    testing.AssertEqInt(got_fn.end_index as int, 42)
    testing.AssertEqInt(got_fn.length as int, 42)
    testing.AssertEqInt(got_fn.ty, rt)
    testing.AssertEqInt(got_fn.a, body)

    // --- values ---
    v1 := at.ValueOf(tr, lit1)
    testing.AssertEqInt(v1.kind, tok.TV_INT)
    testing.AssertEqInt(v1.ival as int, 2)
    vs := at.ValueOf(tr, slit)
    testing.AssertEqInt(vs.kind, tok.TV_STRING)
    testing.AssertEqStr(vs.sval, "hi")

    // --- StrLitLen (ast_str_lit_len) ---
    testing.AssertEqInt(at.StrLitLen(tr, slit) as int, 2)
    testing.AssertEqInt(at.StrLitLen(tr, lit1) as int, 0 - 1) // int literal
    testing.AssertEqInt(at.StrLitLen(tr, bin) as int, 0 - 1)  // not a literal
    testing.AssertEqInt(at.StrLitLen(tr, 0) as int, 0 - 1)    // none

    // --- SetTypeStr ---
    tn := at.NewNode(tr, at.AST_TYPE)
    at.SetTypeStr(tr, tn, "int[3]")
    got_tn := at.Get(tr, tn)
    testing.AssertEqStr(got_tn.type_str, "int[3]")

    // --- dims / captures / typarams / aliases ---
    dimn := at.NewNode(tr, at.AST_LITERAL)
    at.AddDim(tr, tn, dimn)
    testing.AssertEqInt(at.DimCount(tr, tn), 1)
    testing.AssertEqInt(at.Dim(tr, tn, 0), dimn)

    lam := at.NewNode(tr, at.AST_LAMBDA)
    at.AddCapture(tr, lam, lit1)
    testing.AssertEqInt(at.CaptureCount(tr, lam), 1)
    testing.AssertEqInt(at.Capture(tr, lam, 0), lit1)

    gfn := at.NewNode(tr, at.AST_FUNC_DEF)
    at.AddTyparam(tr, gfn, "T", "Shape")
    at.AddTyparam(tr, gfn, "U", "")
    testing.AssertEqInt(at.TyparamCount(tr, gfn), 2)
    testing.AssertEqStr(at.Typaram(tr, gfn, 0), "T")
    testing.AssertEqStr(at.TyparamBound(tr, gfn, 0), "Shape")
    testing.AssertEqStr(at.Typaram(tr, gfn, 1), "U")
    testing.AssertEqStr(at.TyparamBound(tr, gfn, 1), "")

    imp := at.NewNode(tr, at.AST_IMPORT)
    at.AddAlias(tr, imp, "m")
    testing.AssertEqInt(at.AliasCount(tr, imp), 1)
    testing.AssertEqStr(at.Alias(tr, imp, 0), "m")

    // AddChild with id 0 is a no-op (C: ast_add skips NULL)
    at.AddChild(tr, imp, 0)
    testing.AssertEqInt(at.ChildCount(tr, imp), 0)

    // --- ToplevelOrderPhase (ast_toplevel_order_phase) ---
    testing.AssertEqInt(at.ToplevelOrderPhase(tr, imp), at.AST_ORDER_IMPORT)
    cn := at.NewNode(tr, at.AST_CONST_DECL)
    testing.AssertEqInt(at.ToplevelOrderPhase(tr, cn), at.AST_ORDER_CONST)
    testing.AssertEqInt(at.ToplevelOrderPhase(tr, vd), at.AST_ORDER_VAR)
    sd := at.NewNode(tr, at.AST_STRUCT_DEF)
    testing.AssertEqInt(at.ToplevelOrderPhase(tr, sd), at.AST_ORDER_TYPEDEF)
    testing.AssertEqInt(at.ToplevelOrderPhase(tr, fn), at.AST_ORDER_FUNC)
    testing.AssertEqInt(at.ToplevelOrderPhase(tr, body), at.AST_ORDER_NONE)
    ev := at.NewNode(tr, at.AST_VAR_DECL)
    mut evn := at.Get(tr, ev)
    evn.is_extern = true
    at.Put(tr, ev, evn)
    testing.AssertEqInt(at.ToplevelOrderPhase(tr, ev), at.AST_ORDER_IMPORT)
    ef := at.NewNode(tr, at.AST_FUNC_DEF) // extern func without body
    mut efn := at.Get(tr, ef)
    efn.is_extern = true
    at.Put(tr, ef, efn)
    testing.AssertEqInt(at.ToplevelOrderPhase(tr, ef), at.AST_ORDER_IMPORT)
    mut efn2 := at.Get(tr, ef) // extern func WITH body -> plain func phase
    efn2.a = body
    at.Put(tr, ef, efn2)
    testing.AssertEqInt(at.ToplevelOrderPhase(tr, ef), at.AST_ORDER_FUNC)

    // --- Clone (ast_clone): deep, independent copy ---
    cb := at.Clone(tr, bin)
    testing.AssertTrue(cb != bin)
    testing.AssertEqInt(at.KindOf(tr, cb), at.AST_BINARY)
    cbn := at.Get(tr, cb)
    testing.AssertEqInt(cbn.op, tok.TK_PLUS)
    testing.AssertTrue(cbn.a != lit1)
    testing.AssertTrue(cbn.b != lit2)
    cv1 := at.ValueOf(tr, cbn.a)
    testing.AssertEqInt(cv1.ival as int, 2)
    at.SetTokenValue(tr, lit1, tok.ValueInt(7 as u64)) // mutate original
    cv2 := at.ValueOf(tr, cbn.a)
    testing.AssertEqInt(cv2.ival as int, 2) // clone unaffected
    at.SetTokenValue(tr, lit1, tok.ValueInt(2 as u64)) // restore for XML
    cby := at.Clone(tr, body) // list children clone
    testing.AssertEqInt(at.ChildCount(tr, cby), 2)
    testing.AssertTrue(at.Child(tr, cby, 1) != rst)
    testing.AssertEqInt(at.KindOf(tr, at.Child(tr, cby, 1)), at.AST_RETURN)
    ct := at.Clone(tr, tn) // dims clone
    testing.AssertEqInt(at.DimCount(tr, ct), 1)
    testing.AssertTrue(at.Dim(tr, ct, 0) != dimn)
    cg := at.Clone(tr, gfn) // typaram strings clone
    testing.AssertEqStr(at.Typaram(tr, cg, 0), "T")
    testing.AssertEqStr(at.TyparamBound(tr, cg, 0), "Shape")
    testing.AssertEqInt(at.Clone(tr, 0), 0)

    // --- XML dump (must be byte-identical to the C --emit-ast-xml body) ---
    mut w := x.New()
    x.Decl(w)
    at.ToXml(w, tr, prog)
    got := x.Str(w)

    mut exp := "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n"
    exp += "<node kind=\"Program\">\n"
    exp += loc_block("  ", 0, 0, 0, 0, 0)
    exp += "  <defs>\n"
    exp += "    <node kind=\"FunctionDef\" name=\"main\" pub=\"true\">\n"
    exp += loc_block("      ", 1, 1, 0, 5, 3)
    exp += "      <return_type>\n"
    exp += "        <node kind=\"Type\" name=\"int\">\n"
    exp += loc_block("          ", 0, 0, 0, 0, 0)
    exp += "        </node>\n"
    exp += "      </return_type>\n"
    exp += "      <params>\n"
    exp += "        <node kind=\"Param\" name=\"n\">\n"
    exp += loc_block("          ", 0, 0, 0, 0, 0)
    exp += "          <type>\n"
    exp += "            <node kind=\"Type\" name=\"int\">\n"
    exp += loc_block("              ", 0, 0, 0, 0, 0)
    exp += "            </node>\n"
    exp += "          </type>\n"
    exp += "        </node>\n"
    exp += "      </params>\n"
    exp += "      <body>\n"
    exp += "        <node kind=\"Block\">\n"
    exp += loc_block("          ", 0, 0, 0, 0, 0)
    exp += "          <statements>\n"
    exp += "            <node kind=\"VariableDecl\" name=\"s\" mut=\"false\">\n"
    exp += loc_block("              ", 0, 0, 0, 0, 0)
    exp += "              <init>\n"
    exp += "                <node kind=\"Literal\" op=\"STRING_LITERAL\">\n"
    exp += loc_block("                  ", 0, 0, 0, 0, 0)
    exp += "                  <value kind=\"string\">hi</value>\n"
    exp += "                </node>\n"
    exp += "              </init>\n"
    exp += "            </node>\n"
    exp += "            <node kind=\"ReturnStmt\">\n"
    exp += loc_block("              ", 0, 0, 0, 0, 0)
    exp += "              <value>\n"
    exp += "                <node kind=\"BinaryExpr\" op=\"PLUS\">\n"
    exp += loc_block("                  ", 0, 0, 0, 0, 0)
    exp += "                  <left>\n"
    exp += "                    <node kind=\"Literal\" op=\"INT_LITERAL\">\n"
    exp += loc_block("                      ", 0, 0, 0, 0, 0)
    exp += "                      <value kind=\"int\">2</value>\n"
    exp += "                    </node>\n"
    exp += "                  </left>\n"
    exp += "                  <right>\n"
    exp += "                    <node kind=\"Literal\" op=\"INT_LITERAL\">\n"
    exp += loc_block("                      ", 0, 0, 0, 0, 0)
    exp += "                      <value kind=\"int\">40</value>\n"
    exp += "                    </node>\n"
    exp += "                  </right>\n"
    exp += "                </node>\n"
    exp += "              </value>\n"
    exp += "            </node>\n"
    exp += "          </statements>\n"
    exp += "        </node>\n"
    exp += "      </body>\n"
    exp += "    </node>\n"
    exp += "  </defs>\n"
    exp += "</node>\n"

    testing.AssertEqStr(got, exp)
    x.Free(w)
    at.FreeAst(tr)

    // --- tokens_to_xml (token_xml.salam) ---
    mut ts := tok.StreamNew("demo.salam")
    mut t1 := tok.New(tok.TK_INT, "42")
    t1.begin_line = 1 as u32
    t1.begin_col = 5 as u32
    t1.end_line = 1 as u32
    t1.end_col = 7 as u32
    t1.value = tok.ValueInt(42 as u64)
    tok.StreamPush(ts, t1)
    mut t2 := tok.New(tok.TK_FLOAT, "2.5")
    t2.value = tok.ValueFloat(2.5)
    tok.StreamPush(ts, t2)
    mut t3 := tok.New(tok.TK_LAYOUT_ELEMENT, "box")
    t3.layout_mode = true
    tok.StreamPush(ts, t3)
    tok.StreamPush(ts, tok.New(tok.TK_EOF, ""))

    mut w2 := x.New()
    tok.TokensToXml(w2, ts)
    tgot := x.Str(w2)

    mut texp := "<tokens source=\"demo.salam\" count=\"4\">\n"
    texp += "  <token>\n"
    texp += "    <base>token_t</base>\n"
    texp += "    <type>INT_LITERAL</type>\n"
    texp += "    <source>42</source>\n"
    texp += "    <value kind=\"int\">42</value>\n"
    texp += tok_loc_block(1, 5, 1, 7)
    texp += "  </token>\n"
    texp += "  <token>\n"
    texp += "    <base>token_t</base>\n"
    texp += "    <type>FLOAT_LITERAL</type>\n"
    texp += "    <source>2.5</source>\n"
    texp += "    <value kind=\"float\">2.5</value>\n"
    texp += tok_loc_block(0, 0, 0, 0)
    texp += "  </token>\n"
    texp += "  <token mode=\"layout\">\n"
    texp += "    <base>token_t</base>\n"
    texp += "    <type>LAYOUT_ELEMENT</type>\n"
    texp += "    <source>box</source>\n"
    texp += tok_loc_block(0, 0, 0, 0)
    texp += "  </token>\n"
    texp += "  <token>\n"
    texp += "    <base>token_t</base>\n"
    texp += "    <type>EOF</type>\n"
    texp += "    <source></source>\n"
    texp += tok_loc_block(0, 0, 0, 0)
    texp += "  </token>\n"
    texp += "</tokens>\n"

    testing.AssertEqStr(tgot, texp)
    x.Free(w2)
    tok.StreamFree(ts)

    os.Exit(testing.Summary())
end
