end

func test_flag_llvm_opts():
    mut opt := dr.NewOptions()
    mut args := Vector {} as Vector<str>
    args.push("llvm")
    args.push("a.salam")
    args.push("-O2")
    args.push("--emit-obj")
    args.push("--verify-ir")
    args.push("--native-cpu")
    args.push("--target=wasm32-wasi")
    testing.AssertTrue(parse(args, opt))
    testing.AssertEqInt(opt.llvm_opt_level, 2)
    testing.AssertEqInt(opt.llvm_emit, 2)
    testing.AssertTrue(opt.llvm_verify)
    testing.AssertTrue(opt.llvm_native_cpu)
    testing.AssertEqStr(opt.llvm_target, "wasm32-wasi")
    free_opt(opt)
end

func test_flag_llvm_jit_vs_interp_jit():
    mut opt := dr.NewOptions()
    testing.AssertTrue(parse(va3("llvm", "a.salam", "--jit"), opt))
    testing.AssertEqInt(opt.llvm_emit, 5)
    testing.AssertFalse(opt.interp)
    free_opt(opt)

    mut opt2 := dr.NewOptions()
    testing.AssertTrue(parse(va3("build", "a.salam", "--jit"), opt2))
    testing.AssertTrue(opt2.interp)
    free_opt(opt2)
end

func test_flag_js_and_layout_and_run_modes():
    mut opt := dr.NewOptions()
    mut args := Vector {} as Vector<str>
    args.push("js")
    args.push("a.salam")
    args.push("--no-minify")
    args.push("--no-js-minify-names")
    testing.AssertTrue(parse(args, opt))
    testing.AssertTrue(opt.no_minify)
    testing.AssertTrue(opt.no_js_minify_names)
    free_opt(opt)

    mut opt2 := dr.NewOptions()
    testing.AssertTrue(parse(va3("layout", "build", "--inline"), opt2))
    testing.AssertTrue(opt2.inline_mode)
    free_opt(opt2)

    mut opt3 := dr.NewOptions()
    testing.AssertTrue(parse(va2("web", "--split"), opt3))
    testing.AssertTrue(opt3.split)
    free_opt(opt3)
end

func test_flag_version_short_gated_on_command():
    mut opt := dr.NewOptions()
    testing.AssertTrue(parse(va2("version", "--short"), opt))
    testing.AssertTrue(opt.version_short)
    free_opt(opt)
end

func test_flag_unknown_option():
    mut opt := dr.NewOptions()
    testing.AssertFalse(parse(va2("build", "--bogus-flag"), opt))
    free_opt(opt)
end

func test_usage_text_presence():
    text := cl.UsageText()
    testing.AssertContains(text, "Usage:")
    testing.AssertContains(text, "Commands:")
    testing.AssertContains(text, "--output=FILE")
    testing.AssertContains(text, "salam llvm <file>")
    testing.AssertContains(text, "Inspect options:")
end

func test_version_text():
    short := cl.VersionText(true)
    testing.AssertEqStr(short, co.VERSION + "\n")
    full := cl.VersionText(false)
    testing.AssertContains(full, "salam " + co.VERSION)
    testing.AssertContains(full, "commit:")
end

func test_run_missing_inputs_rc2():
    home := os.Cwd()
    empty := os.TempDir() + "/salam_cli_noinput"
    _mk := os.Mkdir(empty)
    _cd := os.Chdir(empty)
    testing.AssertEqInt(cl.Run(va2("salam", "build")), 2)
    testing.AssertEqInt(cl.Run(va2("salam", "obj")), 2)
    testing.AssertEqInt(cl.Run(va2("salam", "llvm")), 2)
    testing.AssertEqInt(cl.Run(va2("salam", "js")), 2)
    testing.AssertEqInt(cl.Run(va3("salam", "layout", "build")), 2)
    testing.AssertEqInt(cl.Run(va2("salam", "web")), 2)
    _back := os.Chdir(home)
    _rm := os.RemoveAll(empty)
end

func test_run_unknown_flag_rc2():
    testing.AssertEqInt(cl.Run(va3("salam", "build", "--nope")), 2)
end

func test_run_no_input_inspect_rc2():
    testing.AssertEqInt(cl.Run(va1("salam")), 0)
end

func test_run_unknown_command_rc2():
    testing.AssertEqInt(cl.Run(va2("salam", "myfile.salam")), 2)
    testing.AssertEqInt(cl.Run(va2("salam", "frobnicate")), 2)
end

func main:
    test_subcommand_build()
    test_subcommand_obj()
    test_subcommand_llvm()
    test_subcommand_js()
    test_subcommand_run()
    test_subcommand_exec_and_jit()
    test_subcommand_debug()
    test_subcommand_memcheck()
    test_subcommand_new()
    test_subcommand_format()
    test_subcommand_help_and_version()
    test_subcommand_web()
    test_subcommand_layout()
    test_subcommand_cli()
    test_repl_rejects_positionals()
    test_bare_file_is_unknown_command()
    test_inspect_command()

    test_positional_run_then_run_args()
    test_positional_new_second_arg_errors()
    test_positional_build_multiple_inputs()
    test_positional_inspect_second_file_errors()

    test_flag_output()
    test_flag_o_short()
    test_flag_o_missing_value()
    test_flag_cc_and_stdlib_path()
    test_flag_keep_temp_debug_info_asan()
    test_flag_release_clears_safe()
    test_safe_default_pushes_salam_safe()
    test_flag_defines()
    test_flag_check_recursive_tabs()
    test_flag_spaces_after_tabs()
    test_flag_indent_tab()
    test_flag_indent_width()
    test_flag_indent_invalid()
    test_flag_fix_order()
    test_flag_lang()
    test_flag_xml_out()
    test_flag_emit_ast_and_symbol_xml()
    test_flag_color()
    test_flag_error_style_and_format()
    test_flag_log_level()
    test_flag_llvm_opts()
    test_flag_llvm_jit_vs_interp_jit()
    test_flag_js_and_layout_and_run_modes()
    test_flag_version_short_gated_on_command()
    test_flag_unknown_option()

    test_usage_text_presence()
    test_version_text()

    test_run_missing_inputs_rc2()
    test_run_unknown_flag_rc2()
    test_run_no_input_inspect_rc2()
    test_run_unknown_command_rc2()

    os.Exit(testing.Summary())
end
