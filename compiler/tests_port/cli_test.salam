func test_repl_rejects_positionals():
    mut opt := dr.NewOptions()
    testing.AssertFalse(parse(va2("cli", "layout"), opt))
    free_opt(opt)

    mut opt2 := dr.NewOptions()
    testing.AssertFalse(parse(va2("cli", "app.salam"), opt2))
    free_opt(opt2)

    mut opt3 := dr.NewOptions()
    testing.AssertFalse(parse(va2("layout", "page.salam"), opt3))
    free_opt(opt3)
end

