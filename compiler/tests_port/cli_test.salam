    mut args := Vector {} as Vector<str>
    args.push("format")
    args.push("--tabs")
    args.push("--spaces")
    testing.AssertTrue(parse(args, opt))
    testing.AssertFalse(opt.fmt_tabs)
    free_opt(opt)
end

