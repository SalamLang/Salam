import cl "../cli/cli.salam"
import co "../sal_core.salam"
import dr "../driver/driver.salam"
import testing
import os
import str

func va0(): Vector<str>:
    ret Vector {}
end

func va1(a: str): Vector<str>:
    mut v := Vector {} as Vector<str>
    v.push(a)
    ret v
end

func va2(a: str, b: str): Vector<str>:
    mut v := Vector {} as Vector<str>
    v.push(a)
    v.push(b)
    ret v
end

func va3(a: str, b: str, c: str): Vector<str>:
    mut v := Vector {} as Vector<str>
    v.push(a)
    v.push(b)
    v.push(c)
    ret v
end

func va4(a: str, b: str, c: str, d: str): Vector<str>:
    mut v := Vector {} as Vector<str>
    v.push(a)
    v.push(b)
    v.push(c)
    v.push(d)
    ret v
end

func parse(extra: Vector<str>, out &: dr.Dr): bool:
    defer extra.free()
    mut args := Vector {} as Vector<str>
    defer args.free()
    args.push("salam")
    repeat extra.len() with i:
        args.push(extra.get(i))
    end
    ok := cl.ParseArgs(args, out)
    ret ok
end

func free_opt(opt &: dr.Dr):
    opt.inputs.free()
    opt.run_args.free()
    opt.defines.free()
end

func test_subcommand_build():
    mut opt := dr.NewOptions()
    testing.AssertTrue(parse(va2("build", "a.salam"), opt))
    testing.AssertEqInt(opt.command, dr.CMD_BUILD)
    testing.AssertEqStr(opt.input, "a.salam")
    testing.AssertEqInt(opt.inputs.len(), 1)
    free_opt(opt)
end

