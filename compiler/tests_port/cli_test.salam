func test_subcommand_run():
    mut opt := dr.NewOptions()
    testing.AssertTrue(parse(va2("run", "a.salam"), opt))
    testing.AssertEqInt(opt.command, dr.CMD_RUN)
    testing.AssertFalse(opt.interp)
    free_opt(opt)
end

func test_subcommand_exec_and_jit():
    mut opt := dr.NewOptions()
    testing.AssertTrue(parse(va2("exec", "a.salam"), opt))
    testing.AssertEqInt(opt.command, dr.CMD_RUN)
    testing.AssertTrue(opt.interp)
    free_opt(opt)

    mut opt2 := dr.NewOptions()
    testing.AssertTrue(parse(va2("jit", "a.salam"), opt2))
    testing.AssertEqInt(opt2.command, dr.CMD_RUN)
    testing.AssertTrue(opt2.interp)
    free_opt(opt2)
end

