// Smoke test for the cli module port (salam/cli.salam), stage 8c - the
// final wave of the self-hosting port. Unit-level asserts on: argv parsing
// (every flag -> the right Dr field), subcommand detection (the full
// cli_dispatch_command table), help/version text presence, and error
// handling for bad args (unknown flag, missing file, invalid option
// values). The real end-to-end gate (build salam/main.salam itself with
// the reference compiler, then use the resulting self-hosted binary to
// build/exec real test files) is a manual verification step documented in
// the stage-8c report, mirroring how driver_run.salam/etc. do it for
// earlier stages - cli's own gate IS that main.salam links and runs.

import cl "../cli.salam"
import dr "../driver.salam"
import testing
import os
import str

// ---------------------------------------------------------------------------
// Small helpers: build a Vector<str> shaped like C's argv (index 0 = program
// name, matching os.Args()' contract that main.salam relies on).
// ---------------------------------------------------------------------------
func va0(): Vector<str>:
    ret Vector {} as Vector<str>
end

func va1(a: str): Vector<str>:
    mut v := Vector {} as Vector<str>
    v.push(a)
    ret v
end

func va2(a: str, b: str): Vector<str>:
    mut v := Vector {} as Vector<str>
    v.push(a)
    v.push(b)
    ret v
end

func va3(a: str, b: str, c: str): Vector<str>:
    mut v := Vector {} as Vector<str>
    v.push(a)
    v.push(b)
    v.push(c)
    ret v
end

func va4(a: str, b: str, c: str, d: str): Vector<str>:
    mut v := Vector {} as Vector<str>
    v.push(a)
    v.push(b)
    v.push(c)
    v.push(d)
    ret v
end

// Builds "salam" + extra (frees extra), parses into a fresh Dr, returns
// whether ParseArgs succeeded.
func parse(extra: Vector<str>, out &: dr.Dr): bool:
    defer extra.free()
    mut args := Vector {} as Vector<str>
    defer args.free()
    args.push("salam")
    repeat extra.len() with i:
        args.push(extra.get(i)[0])
    end
    ok := cl.ParseArgs(args, out)
    ret ok
end

func free_opt(opt &: dr.Dr):
    opt.inputs.free()
    opt.run_args.free()
    opt.defines.free()
end

// ---------------------------------------------------------------------------
// Subcommand detection (cli_subcmd.c's cli_dispatch_command table)
// ---------------------------------------------------------------------------
func test_subcommand_build():
    mut opt := dr.NewOptions()
    testing.AssertTrue(parse(va2("build", "a.salam"), opt))
    testing.AssertEqInt(opt.command, dr.CMD_BUILD)
    testing.AssertEqStr(opt.input, "a.salam")
    testing.AssertEqInt(opt.inputs.len(), 1)
    free_opt(opt)
end

func test_subcommand_obj():
    mut opt := dr.NewOptions()
    testing.AssertTrue(parse(va2("obj", "a.salam"), opt))
    testing.AssertEqInt(opt.command, dr.CMD_OBJ)
    free_opt(opt)
end

func test_subcommand_llvm():
    mut opt := dr.NewOptions()
    testing.AssertTrue(parse(va2("llvm", "a.salam"), opt))
    testing.AssertEqInt(opt.command, dr.CMD_LLVM)
    free_opt(opt)

    mut opt2 := dr.NewOptions()
    testing.AssertTrue(parse(va2("emit-llvm", "a.salam"), opt2))
    testing.AssertEqInt(opt2.command, dr.CMD_LLVM)
    free_opt(opt2)
end

