end

func test_flag_keep_temp_debug_info_asan():
    mut opt := dr.NewOptions()
    mut args := Vector {} as Vector<str>
    args.push("build")
    args.push("a.salam")
    args.push("--keep-temp")
    args.push("-g")
    args.push("--asan")
    testing.AssertTrue(parse(args, opt))
    testing.AssertTrue(opt.keep_temp)
    testing.AssertTrue(opt.debug_info)
    testing.AssertTrue(opt.asan)
