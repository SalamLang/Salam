func test_flag_release_clears_safe():
    mut opt := dr.NewOptions()
    testing.AssertTrue(parse(va3("build", "a.salam", "--release"), opt))
    testing.AssertFalse(opt.safe)
    mut found := false
    repeat opt.defines.len() with i:
        if str.Equals(opt.defines.get(i), "SALAM_SAFE"):
            found = true
        end
    end
    testing.AssertFalse(found)
    free_opt(opt)
end

func test_safe_default_pushes_salam_safe():
    mut opt := dr.NewOptions()
    testing.AssertTrue(parse(va2("build", "a.salam"), opt))
    testing.AssertTrue(opt.safe)
    mut found := false
    repeat opt.defines.len() with i:
        if str.Equals(opt.defines.get(i), "SALAM_SAFE"):
            found = true
        end
    end
    testing.AssertTrue(found)
    free_opt(opt)
end

func test_flag_defines():
    mut opt := dr.NewOptions()
    mut args := Vector {} as Vector<str>
    args.push("build")
    args.push("a.salam")
    args.push("-DFOO")
    args.push("--define=BAR")
    testing.AssertTrue(parse(args, opt))
    testing.AssertEqInt(opt.defines.len(), 3)
    testing.AssertEqStr(opt.defines.get(0), "FOO")
    testing.AssertEqStr(opt.defines.get(1), "BAR")
    testing.AssertEqStr(opt.defines.get(2), "SALAM_SAFE")
    free_opt(opt)
end

