func test_subcommand_help_and_version():
    mut opt := dr.NewOptions()
    testing.AssertTrue(parse(va1("help"), opt))
    testing.AssertEqInt(opt.command, dr.CMD_HELP)
    free_opt(opt)

    mut opt2 := dr.NewOptions()
    testing.AssertTrue(parse(va1("version"), opt2))
    testing.AssertEqInt(opt2.command, dr.CMD_VERSION)
    free_opt(opt2)

    // No args at all -> CMD_HELP (cmd == NULL in the C).
    mut opt3 := dr.NewOptions()
    testing.AssertTrue(parse(va0(), opt3))
    testing.AssertEqInt(opt3.command, dr.CMD_HELP)
    free_opt(opt3)
end

func test_subcommand_web():
    mut opt := dr.NewOptions()
    testing.AssertTrue(parse(va2("web", "page.salam"), opt))
    testing.AssertEqInt(opt.command, dr.CMD_WEB)
    free_opt(opt)
end

func test_subcommand_layout():
    // "layout build <files>" -> CMD_LAYOUT_BUILD
    mut opt := dr.NewOptions()
    testing.AssertTrue(parse(va3("layout", "build", "page.salam"), opt))
    testing.AssertEqInt(opt.command, dr.CMD_LAYOUT_BUILD)
    testing.AssertEqStr(opt.input, "page.salam")
    free_opt(opt)

    // Bare "layout" -> CMD_REPL_LAYOUT
    mut opt2 := dr.NewOptions()
    testing.AssertTrue(parse(va1("layout"), opt2))
    testing.AssertEqInt(opt2.command, dr.CMD_REPL_LAYOUT)
    free_opt(opt2)
end

func test_subcommand_cli():
    // "cli build <files>" / "cli obj <files>" -> CMD_BUILD / CMD_OBJ
    mut opt := dr.NewOptions()
    testing.AssertTrue(parse(va3("cli", "build", "a.salam"), opt))
    testing.AssertEqInt(opt.command, dr.CMD_BUILD)
    free_opt(opt)

    mut opt2 := dr.NewOptions()
    testing.AssertTrue(parse(va3("cli", "obj", "a.salam"), opt2))
    testing.AssertEqInt(opt2.command, dr.CMD_OBJ)
    free_opt(opt2)

    // Bare "cli" -> CMD_REPL
    mut opt3 := dr.NewOptions()
    testing.AssertTrue(parse(va1("cli"), opt3))
    testing.AssertEqInt(opt3.command, dr.CMD_REPL)
    free_opt(opt3)
end

func test_bare_file_is_inspect():
    mut opt := dr.NewOptions()
    testing.AssertTrue(parse(va1("myfile.salam"), opt))
    testing.AssertEqInt(opt.command, dr.CMD_INSPECT)
    testing.AssertEqStr(opt.input, "myfile.salam")
    free_opt(opt)
end

// ---------------------------------------------------------------------------
// Positional-argument routing (cli_options.c's cli_positional)
// ---------------------------------------------------------------------------
func test_positional_run_then_run_args():
    mut opt := dr.NewOptions()
    testing.AssertTrue(parse(va3("run", "prog.salam", "argone"), opt))
    testing.AssertEqStr(opt.input, "prog.salam")
    testing.AssertEqInt(opt.run_args.len(), 1)
    testing.AssertEqStr(opt.run_args.get(0)[0], "argone")
    free_opt(opt)
end

func test_positional_new_second_arg_errors():
    mut opt := dr.NewOptions()
    testing.AssertFalse(parse(va3("new", "proj1", "proj2"), opt))
    free_opt(opt)
end

func test_positional_build_multiple_inputs():
    mut opt := dr.NewOptions()
    testing.AssertTrue(parse(va3("build", "a.salam", "b.salam"), opt))
    testing.AssertEqInt(opt.inputs.len(), 2)
    testing.AssertEqStr(opt.inputs.get(0)[0], "a.salam")
    testing.AssertEqStr(opt.inputs.get(1)[0], "b.salam")
    testing.AssertEqStr(opt.input, "a.salam")
    free_opt(opt)
end

func test_positional_inspect_second_file_errors():
    mut opt := dr.NewOptions()
    testing.AssertFalse(parse(va2("a.salam", "b.salam"), opt))
    free_opt(opt)
end

// ---------------------------------------------------------------------------
// Flag parsing (cli_options.c's cli_parse_options) - every flag -> field.
// ---------------------------------------------------------------------------
func test_flag_output():
    mut opt := dr.NewOptions()
    testing.AssertTrue(parse(va3("build", "a.salam", "--output=app"), opt))
    testing.AssertEqStr(opt.output, "app")
    free_opt(opt)
end

func test_flag_o_short():
    mut opt := dr.NewOptions()
    testing.AssertTrue(parse(va4("build", "a.salam", "-o", "app2"), opt))
    testing.AssertEqStr(opt.output, "app2")
    free_opt(opt)
end

func test_flag_o_missing_value():
    mut opt := dr.NewOptions()
    testing.AssertFalse(parse(va3("build", "a.salam", "-o"), opt))
    free_opt(opt)
end

func test_flag_cc_and_stdlib_path():
    mut opt := dr.NewOptions()
    args := va4("build", "a.salam", "--cc=gcc", "--stdlib-path=/std")
    testing.AssertTrue(parse(args, opt))
    testing.AssertEqStr(opt.cc, "gcc")
    testing.AssertEqStr(opt.stdlib_path, "/std")
    free_opt(opt)
end

func test_flag_keep_c_debug_info_asan():
    mut opt := dr.NewOptions()
    mut args := Vector {} as Vector<str>
    args.push("build")
    args.push("a.salam")
    args.push("--keep-c")
    args.push("-g")
    args.push("--asan")
    testing.AssertTrue(parse(args, opt))
    testing.AssertTrue(opt.keep_c)
    testing.AssertTrue(opt.debug_info)
    testing.AssertTrue(opt.asan)
    free_opt(opt)
end

func test_flag_release_clears_safe():
    mut opt := dr.NewOptions()
    testing.AssertTrue(parse(va3("build", "a.salam", "--release"), opt))
    testing.AssertFalse(opt.safe)
    // --release => safe ends up false => cli.c's post-parse step must NOT
    // push SALAM_SAFE.
    mut found := false
    repeat opt.defines.len() with i:
        if str.Equals(opt.defines.get(i)[0], "SALAM_SAFE"):
            found = true
        end
    end
    testing.AssertFalse(found)
    free_opt(opt)
end

func test_safe_default_pushes_salam_safe():
    mut opt := dr.NewOptions()
    testing.AssertTrue(parse(va2("build", "a.salam"), opt))
    testing.AssertTrue(opt.safe)
    mut found := false
    repeat opt.defines.len() with i:
        if str.Equals(opt.defines.get(i)[0], "SALAM_SAFE"):
            found = true
        end
    end
    testing.AssertTrue(found)
    free_opt(opt)
end

func test_flag_defines():
    mut opt := dr.NewOptions()
    mut args := Vector {} as Vector<str>
    args.push("build")
    args.push("a.salam")
    args.push("-DFOO")
    args.push("--define=BAR")
    testing.AssertTrue(parse(args, opt))
    testing.AssertEqInt(opt.defines.len(), 3) // FOO, BAR, then SALAM_SAFE appended
    testing.AssertEqStr(opt.defines.get(0)[0], "FOO")
    testing.AssertEqStr(opt.defines.get(1)[0], "BAR")
    testing.AssertEqStr(opt.defines.get(2)[0], "SALAM_SAFE")
    free_opt(opt)
end

func test_flag_check_recursive_tabs():
    mut opt := dr.NewOptions()
    mut args := Vector {} as Vector<str>
    args.push("format")
    args.push("--check")
    args.push("-r")
    args.push("--tabs")
    testing.AssertTrue(parse(args, opt))
    testing.AssertTrue(opt.fmt_check)
    testing.AssertTrue(opt.fmt_recursive)
    testing.AssertTrue(opt.fmt_tabs)
    free_opt(opt)
end

func test_flag_spaces_after_tabs():
