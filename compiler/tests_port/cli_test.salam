func test_flag_error_style_and_format():
    mut opt := dr.NewOptions()
    testing.AssertTrue(parse(va3("inspect", "a.salam", "--error-style=gcc"), opt))
    testing.AssertEqInt(opt.diag_style, 1)
    free_opt(opt)

    mut opt2 := dr.NewOptions()
    testing.AssertFalse(parse(va3("inspect", "a.salam", "--error-style=bogus"), opt2))
    free_opt(opt2)

    mut opt3 := dr.NewOptions()
    testing.AssertTrue(parse(va3("inspect", "a.salam", "--error-format=json"), opt3))
    testing.AssertEqInt(opt3.diag_format, 1)
    free_opt(opt3)

    mut opt4 := dr.NewOptions()
    testing.AssertFalse(parse(va3("inspect", "a.salam", "--error-format=bogus"), opt4))
    free_opt(opt4)
end

