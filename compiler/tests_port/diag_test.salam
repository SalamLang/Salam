// Smoke test for the diag module port (salam/diag/*.salam).
// Expected strings are derived by hand from the C renderers in
// compiler/src/diag/ (diag_render_source.c, diag_render_format.c, diag.c)
// and must stay byte-identical to what the C fprintf'ed.

import dg "../diag.salam"
import str
import testing
import os

// rust style: single-line span, multi-char caret, [E012] code
func test_rust_basic():
    src := "x := 1\ny := oops\n"
    got := dg.RenderAt(
        "error", 12, true, "t.salam", 2, 6, 4, src, str.Len(src), "undefined variable", "", dg.DIAG_STYLE_RUST,
        dg.DIAG_FORMAT_HUMAN, false
    )
    testing.AssertEqStr(
        got, "error[E012]: undefined variable\n" + " --> t.salam:2:6\n" + "  |\n" + "2 | y := oops\n" + "  |      ^^^^\n" + "  |\n"
    )
end

// rust style: single-char caret (length 1), warning code
func test_rust_single_caret():
    src := "boom()\n"
    got := dg.RenderAt(
        "warning", 7, false, "w.salam", 1, 1, 1, src, str.Len(src), "odd call", "", 0, 0, false
    )
    testing.AssertEqStr(
        got, "warning[W007]: odd call\n" + " --> w.salam:1:1\n" + "  |\n" + "1 | boom()\n" + "  | ^\n" + "  |\n"
    )
end

// rust style: 2-digit line number widens the gutter to 2 columns
func test_rust_gutter_2digit():
    mut src := ""
    repeat 9:
        src = src + "filler\n"
    end
    src = src + "ab cd efg\n" + "x\n" + "y\n"
    got := dg.RenderAt(
        "error", 99, true, "f.salam", 10, 4, 2, src, str.Len(src), "msg", "", 0, 0, false
    )
    testing.AssertEqStr(
        got, "error[E099]: msg\n" + " --> f.salam:10:4\n" + "   |\n" + "10 | ab cd efg\n" + "   |    ^^\n" + "   |\n"
    )
end

// rust style: 3-digit line number widens the gutter to 3 columns
func test_rust_gutter_3digit():
    mut src := ""
    repeat 99:
        src = src + "filler\n"
    end
    src = src + "zzz := 1\n"
    got := dg.RenderAt(
        "error", 1, true, "f.salam", 100, 1, 3, src, str.Len(src), "bad", "", 0, 0, false
    )
    testing.AssertEqStr(
        got, "error[E001]: bad\n" + " --> f.salam:100:1\n" + "    |\n" + "100 | zzz := 1\n" + "    | ^^^\n" + "    |\n"
    )
end

// rust style: tabs expand to 4-column stops in both excerpt and caret line
func test_rust_tab_expansion():
    src := "\tif x:\n"
    got := dg.RenderAt(
        "error", 3, true, "f.salam", 1, 2, 2, src, str.Len(src), "tab", "", 0, 0, false
    )
    testing.AssertEqStr(
        got, "error[E003]: tab\n" + " --> f.salam:1:2\n" + "  |\n" + "1 |     if x:\n" + "  |     ^^\n" + "  |\n"
    )
end

// rust style: caret math is byte-based, so a 2-byte UTF-8 char spanned with
// length 2 gets two carets (exactly what the C byte-oriented code does)
func test_rust_utf8_bytes():
    src := "é := 1\n"
    got := dg.RenderAt(
        "error", 4, true, "f.salam", 1, 1, 2, src, str.Len(src), "enc", "", 0, 0, false
    )
    testing.AssertEqStr(
        got, "error[E004]: enc\n" + " --> f.salam:1:1\n" + "  |\n" + "1 | é := 1\n" + "  | ^^\n" + "  |\n"
    )
end

// rust style: trailing "= help:" line
func test_rust_help():
    src := "q\n"
    got := dg.RenderAt(
        "error", 5, true, "h.salam", 1, 1, 1, src, str.Len(src), "bad q", "use p instead", 0, 0, false
    )
    testing.AssertEqStr(
        got, "error[E005]: bad q\n" + " --> h.salam:1:1\n" + "  |\n" + "1 | q\n" + "  | ^\n" + "  |\n" + "  | = help: use p instead\n"
    )
end

// rust style: file but no span (the C NULL-span path), with help
func test_rust_no_span():
    got := dg.RenderAt(
        "error", 9, true, "d.salam", 0, 0, 0, "", 0, "cannot open", "check path", 0, 0, false
    )
    testing.AssertEqStr(
        got, "error[E009]: cannot open\n" + " --> d.salam\n" + "   = help: check path\n"
    )
end

// rust style: no file and code 0 -> a bare "error: msg" line
func test_rust_no_file():
    got := dg.RenderAt(
        "error", 0, true, "", 0, 0, 0, "", 0, "boom", "", 0, 0, false
    )
    testing.AssertEqStr(got, "error: boom\n")
end

// rust style with color: exact ANSI sequences from diag_internal.h
func test_rust_color():
    src := "x\n"
    got := dg.RenderAt(
        "error", 1, true, "t.salam", 1, 1, 1, src, str.Len(src), "m", "", 0, 0, true
    )
    testing.AssertEqStr(
        got, "\x1b[1;31merror[E001]\x1b[0m: \x1b[1mm\x1b[0m\n" + " \x1b[34m-->\x1b[0m t.salam:1:1\n" + "\x1b[1;34m  |\x1b[0m\n" + "\x1b[1;34m1 |\x1b[0m x\n" + "\x1b[1;34m  |\x1b[0m \x1b[1;31m^\x1b[0m\n" + "\x1b[1;34m  |\x1b[0m\n"
    )
end

// gcc style: header line, 4-space excerpt, ^~~~ caret, note line
func test_gcc():
    src := "ab cdefg h\n"
    got := dg.RenderAt(
        "error", 33, true, "a.salam", 1, 3, 5, src, str.Len(src), "boom", "try x", dg.DIAG_STYLE_GCC,
        0, false
    )
    testing.AssertEqStr(
        got, "a.salam:1:3: error: boom [E033]\n" + "    ab cdefg h\n" + "      ^~~~~\n" + "  note: try x\n"
    )
end

// clang style: caret, "| message" echo line, "= help" line
func test_clang():
    src := "abcdefgh\n"
    got := dg.RenderAt(
        "warning", 7, false, "c.salam", 1, 4, 3, src, str.Len(src), "odd", "hint", dg.DIAG_STYLE_CLANG,
        0, false
    )
    testing.AssertEqStr(
        got, "c.salam:1:4: warning: odd [W007]\n" + "    abcdefgh\n" + "       ^~~\n" + "       | odd\n" + "       = hint\n"
    )
end

// json format: escaping and the optional fields
func test_json():
    src := "x := 1\ny := oops\n"
    got := dg.RenderAt(
        "error", 12, true, "t.salam", 2, 6, 4, src, str.Len(src), "undefined \"variable\"", "", 0, dg.DIAG_FORMAT_JSON,
        false
    )
    testing.AssertEqStr(
        got, "{\"level\":\"error\",\"code\":\"E012\",\"message\":\"undefined \\\"variable\\\"\",\"file\":\"t.salam\",\"line\":2,\"column\":6,\"length\":4}\n"
    )
    // no code / no file / no span -> only level and message
    got2 := dg.RenderAt(
        "warning", 0, false, "", 0, 0, 0, "", 0, "tab\there", "", 0, dg.DIAG_FORMAT_JSON, false
    )
    testing.AssertEqStr(
        got2, "{\"level\":\"warning\",\"message\":\"tab\\there\"}\n"
    )
end

// xml format: entity escaping in message, attributes for the span
func test_xml():
    got := dg.RenderAt(
        "error", 8, true, "t.salam", 3, 1, 2, "", 0, "a < b & c", "", 0, dg.DIAG_FORMAT_XML, false
    )
    testing.AssertEqStr(
        got, "<diagnostic level=\"error\" code=\"E008\" file=\"t.salam\" line=\"3\" column=\"1\" length=\"2\"><message>a &lt; b &amp; c</message></diagnostic>\n"
    )
    got2 := dg.RenderAt(
        "warning", 0, false, "", 0, 0, 0, "", 0, "ok", "\"h\"", 0, dg.DIAG_FORMAT_XML, false
    )
    testing.AssertEqStr(
        got2, "<diagnostic level=\"warning\"><message>ok</message><help>&quot;h&quot;</help></diagnostic>\n"
    )
end

// diag_style_from_string / diag_format_from_string (case-insensitive)
func test_from_string():
    mut o := -1
    testing.AssertTrue(dg.StyleFromString("rust", o))
    testing.AssertEqInt(o, dg.DIAG_STYLE_RUST)
    testing.AssertTrue(dg.StyleFromString("GCC", o))
    testing.AssertEqInt(o, dg.DIAG_STYLE_GCC)
    testing.AssertTrue(dg.StyleFromString("Clang", o))
    testing.AssertEqInt(o, dg.DIAG_STYLE_CLANG)
    o = -1
    testing.AssertFalse(dg.StyleFromString("weird", o))
    testing.AssertEqInt(o, -1)

    testing.AssertTrue(dg.FormatFromString("human", o))
    testing.AssertEqInt(o, dg.DIAG_FORMAT_HUMAN)
    testing.AssertTrue(dg.FormatFromString("JSON", o))
    testing.AssertEqInt(o, dg.DIAG_FORMAT_JSON)
    testing.AssertTrue(dg.FormatFromString("xml", o))
    testing.AssertEqInt(o, dg.DIAG_FORMAT_XML)
    o = -1
    testing.AssertFalse(dg.FormatFromString("", o))
    testing.AssertEqInt(o, -1)
end

// the engine: diag_report's plain "E012: body" message format + counters
func test_engine_report():
    // 5 = lg.LOG_OFF (silence the logging side channel), 4 = lg.PH_SEMANTIC
    mut eng := dg.NewDefault(5, false, 4)
    testing.AssertFalse(dg.HasErrors(eng))

    span := dg.SpanAt(2, 6, 12, 4)
    dg.Report(eng, dg.SEV_ERROR, 12, "t.salam", span, "undefined variable")
    dg.Report(eng, dg.SEV_WARNING, 5, "t.salam", span, "unused thing")
    dg.ReportNoSpan(eng, dg.SEV_ERROR, 71, "t.salam", "file vanished")

    testing.AssertTrue(dg.HasErrors(eng))
    testing.AssertEqInt(dg.ErrorCount(eng), 2)
    testing.AssertEqInt(dg.WarningCount(eng), 1)
    testing.AssertEqInt(dg.Count(eng), 3)

    d0 := dg.ItemAt(eng, 0)
    testing.AssertEqStr(d0.message, "E012: undefined variable")
    testing.AssertEqStr(d0.body, "undefined variable")
    testing.AssertEqInt(d0.sev, dg.SEV_ERROR)
    testing.AssertEqInt(d0.code, 12)
    testing.AssertEqStr(d0.file, "t.salam")
    testing.AssertEqInt(d0.span.begin.line as int, 2)
    testing.AssertEqInt(d0.span.begin.col as int, 6)
    testing.AssertEqInt(d0.span.length as int, 4)

    d1 := dg.ItemAt(eng, 1)
    testing.AssertEqStr(d1.message, "W005: unused thing")
    d2 := dg.ItemAt(eng, 2)
    testing.AssertEqStr(d2.message, "E071: file vanished")
    testing.AssertEqInt(d2.span.begin.line as int, 0)

    // Render (span-taking) and RenderAll against the same source
    src := "x := 1\ny := oops\n"
    r := dg.Render(
        "error", d0.code, true, d0.file, d0.span, src, str.Len(src), d0.body, "", dg.DIAG_STYLE_RUST,
        dg.DIAG_FORMAT_HUMAN, false
    )
    testing.AssertEqStr(
        r, "error[E012]: undefined variable\n" + " --> t.salam:2:6\n" + "  |\n" + "2 | y := oops\n" + "  |      ^^^^\n" + "  |\n"
    )

    all := dg.RenderAll(
        eng, src, str.Len(src), dg.DIAG_STYLE_RUST, dg.DIAG_FORMAT_HUMAN, false
    )
    testing.AssertEqStr(
        all, "error[E012]: undefined variable\n" + " --> t.salam:2:6\n" + "  |\n" + "2 | y := oops\n" + "  |      ^^^^\n" + "  |\n" + "warning[W005]: unused thing\n" + " --> t.salam:2:6\n" + "  |\n" + "2 | y := oops\n" + "  |      ^^^^\n" + "  |\n" + "error[E071]: file vanished\n" + " --> t.salam\n"
    )

    dg.Free(eng)
end

// the "E012: " prefix parser the logger's rich path needs
func test_split_code_prefix():
    mut ise := false
    mut cd := 0
    b := dg.SplitCodePrefix("E012: expected 'end'", ise, cd)
    testing.AssertEqStr(b, "expected 'end'")
    testing.AssertTrue(ise)
    testing.AssertEqInt(cd, 12)

    ise = true
    b2 := dg.SplitCodePrefix("W123: odd token", ise, cd)
    testing.AssertEqStr(b2, "odd token")
    testing.AssertFalse(ise)
    testing.AssertEqInt(cd, 123)

    // no prefix: message returned unchanged, out-params untouched
    ise = true
    cd = -1
    b3 := dg.SplitCodePrefix("plain message", ise, cd)
    testing.AssertEqStr(b3, "plain message")
    testing.AssertTrue(ise)
    testing.AssertEqInt(cd, -1)
    b4 := dg.SplitCodePrefix("E12: short", ise, cd)
    testing.AssertEqStr(b4, "E12: short")
end

func main:
    test_rust_basic()
    test_rust_single_caret()
    test_rust_gutter_2digit()
    test_rust_gutter_3digit()
    test_rust_tab_expansion()
    test_rust_utf8_bytes()
    test_rust_help()
    test_rust_no_span()
    test_rust_no_file()
    test_rust_color()
    test_gcc()
    test_clang()
    test_json()
    test_xml()
    test_from_string()
    test_engine_report()
    test_split_code_prefix()
    os.Exit(testing.Summary())
end
