// Cross-module diamond test for the FLAT layout (salam/PORTING.md).
// One main imports ast + token + diag + core directly, while ast also pulls
// token/xml/core transitively and diag pulls logger/core transitively.
// Under the old per-directory layout this was impossible: the compiler dedups
// imports by the UNNORMALIZED path string, so any shared module reached
// through two different relative paths was compiled and linked twice
// ("defined twice"). With the flat layout every import composes to the same
// key from every importer.
import testing
import os
import at "../ast.salam"
import tok "../token.salam"
import dg "../diag.salam"
import co "../sal_core.salam"

func main:
    // core, imported directly AND transitively via token/ast/diag
    testing.AssertEqStr(co.U64Toa(42 as u64), "42")
    testing.AssertEqStr(co.Format2("%s:%d", co.ArgStr("f"), co.ArgInt(7 as i64)), "f:7")

    // token, imported directly AND transitively via ast
    testing.AssertEqStr(tok.KindName(tok.TK_EOF), "EOF")
    testing.AssertTrue(tok.IsKeyword(tok.TK_KW_FUNC))

    // ast (pulls token + xml + core)
    mut tr := at.NewAst()
    lit := at.NewNode(tr, at.AST_LITERAL)
    at.SetOp(tr, lit, tok.TK_INT)
    at.SetTokenValue(tr, lit, tok.ValueInt(42 as u64))
    v := at.ValueOf(tr, lit)
    testing.AssertEqInt(v.kind, tok.TV_INT)
    testing.AssertEqInt(v.ival as int, 42)
    testing.AssertEqStr(at.KindName(at.AST_LITERAL), "Literal")
    at.FreeAst(tr)

    // diag (pulls logger + core); span built via core directly this time —
    // the diamond the old layout could not express.
    mut eng := dg.NewDefault(5, false, 4) // 5 = LOG_OFF, 4 = PH_SEMANTIC
    b := co.MakePos(1 as u32, 1 as u32, 0 as u32)
    f := co.MakePos(1 as u32, 2 as u32, 1 as u32)
    span := co.MakeSpan(b, f, 1 as u32)
    dg.Report(eng, dg.SEV_ERROR, 12, "d.salam", span, "boom")
    testing.AssertTrue(dg.HasErrors(eng))
    testing.AssertEqInt(dg.ErrorCount(eng), 1)
    d0 := dg.ItemAt(eng, 0)
    testing.AssertEqStr(d0.message, "E012: boom")
    testing.AssertEqStr(
        dg.RenderAt("error", 0, true, "", 0, 0, 0, "", 0, "boom", "", 0, 0, false),
        "error: boom\n")
    dg.Free(eng)

    os.Exit(testing.Summary())
end
