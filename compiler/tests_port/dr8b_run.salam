// Stage-8b smoke/gate driver: exercises dr.Llvm/dr.Js/dr.LayoutBuild/dr.Web
// (the four backends this stage replaced from stubs) exactly the way the
// eventual CLI would, so their output can be diffed against HEAD `bin/salam
// llvm|js|layout build|web <file>`.
//
// Usage: dr8b_run <llvm|js|layout|web> <file> [output] [--inline]
package main

import os
import io
import str
import dr "../driver.salam"

func main:
    args := os.Args()
    defer args.free()
    if args.len() < 3:
        io.EPrintln("usage: dr8b_run <llvm|js|layout|web> <file> [output] [--inline]")
        os.Exit(2)
    end
    mode := args[1]
    file := args[2]
    mut output := ""
    mut inline_mode := false
    mut ai := 3
    until ai < args.len():
        if str.Equals(args[ai], "--inline"):
            inline_mode = true
        else:
            output = args[ai]
        end
        ai += 1
    end

    mut opt := dr.NewOptions()
    opt.inputs.push(file)
    opt.input = file
    opt.output = output
    opt.inline_mode = inline_mode
    stdroot := os.Env("SALAM_STD")
    if str.Len(stdroot) > 0:
        opt.stdlib_path = stdroot
    end

    mut rc := 0
    if str.Equals(mode, "llvm"):
        rc = dr.Llvm(opt)
    else str.Equals(mode, "js"):
        rc = dr.Js(opt)
    else str.Equals(mode, "layout"):
        rc = dr.LayoutBuild(opt)
    else str.Equals(mode, "web"):
        rc = dr.Web(opt)
    else:
        io.EPrintln("unknown mode " + mode)
        rc = 2
    end
    opt.inputs.free()
    opt.run_args.free()
    opt.defines.free()
    os.Exit(rc)
end
