// End-to-end gate runner for the driver port (stage 8a): invokes the REAL
// ported dr.Build / dr.Run / dr.Exec exactly like the eventual CLI would,
// so its output can be diffed against HEAD `bin/salam build`/`salam exec`.
//
// Usage:
//   driver_run build <file.salam> <output_path> [--keep-c]
//       -> dr.Build(): compiles+links a real executable at <output_path>
//          (or, with --keep-c, writes salam_mod_<module>.{c,h} into the
//          current directory and does not delete them; <output_path> is
//          still required as an arg but the link step's result is ignored
//          for the keep-c case since we only care about the generated C).
//   driver_run exec <file.salam>
//       -> dr.Exec(): runs the file directly through the interpreter,
//          printing to real stdout/stderr, exiting with ip.Run's rc.
//
// This mirrors driver_build/driver_interp's real option shape (Vector
// inputs/defines, safe=true default -> SALAM_SAFE define, same as cli.c
// would set) rather than re-deriving a simplified pipeline.
package main

import os
import io
import str
import dr "../driver.salam"

func main:
    args := os.Args()
    defer args.free()
    if args.len() < 3:
        io.EPrintln("usage: driver_run <build|exec> <file.salam> [output_path] [--keep-c]")
        os.Exit(2)
    end
    mode := args[1]
    path := args[2]

    if str.Equals(mode, "exec"):
        mut opt := dr.NewOptions()
        opt.input = path
        rc := dr.Exec(opt)
        opt.inputs.free()
        opt.run_args.free()
        opt.defines.free()
        os.Exit(rc)
    end

    if str.Equals(mode, "build"):
        mut keep := false
        if args.len() > 4 && str.Equals(args[4], "--keep-c"):
            keep = true
        end
        output := args.len() > 3 ? args[3] : "/tmp/salam_driver_run_default_out"
        mut opt := dr.NewOptions()
        opt.inputs.push(path)
        opt.output = output
        opt.keep_c = keep
        // cli.c pushes SALAM_SAFE onto opt.defines after parsing, whenever
        // the final resolved `safe` (default true) holds - replicate that
        // one step here since no cli wave exists yet to do it for us.
        if opt.safe:
            opt.defines.push("SALAM_SAFE")
        end
        rc := dr.Build(opt)
        io.EPrintln("exe_path=" + opt.exe_path)
        opt.inputs.free()
        opt.run_args.free()
        opt.defines.free()
        os.Exit(rc)
    end

    io.EPrintln("unknown mode: " + mode)
    os.Exit(2)
end
