package main

import os
import io
import str
import dr "../driver/driver.salam"

func main:
    args := os.Args()
    defer args.free()
    if args.len() < 3:
        io.EPrintln("usage: driver_run <build|exec> <file.salam> [output_path] [--keep-temp]")
        os.Exit(2)
    end
    mode := args[1]
    path := args[2]

    if str.Equals(mode, "exec"):
        mut opt := dr.NewOptions()
        opt.input = path
        rc := dr.Exec(opt)
        opt.inputs.free()
        opt.run_args.free()
        opt.defines.free()
        os.Exit(rc)
    end

    if str.Equals(mode, "build"):
        mut keep := false
        if args.len() > 4 && str.Equals(args[4], "--keep-temp"):
            keep = true
        end
        output := args.len() > 3 ? args[3] : "/tmp/salam_driver_run_default_out"
        mut opt := dr.NewOptions()
        opt.inputs.push(path)
        opt.output = output
        opt.keep_temp = keep
        if opt.safe:
            opt.defines.push("SALAM_SAFE")
        end
        rc := dr.Build(opt)
        io.EPrintln("exe_path=" + opt.exe_path)
        opt.inputs.free()
        opt.run_args.free()
        opt.defines.free()
        os.Exit(rc)
    end

    io.EPrintln("unknown mode: " + mode)
    os.Exit(2)
end
