// Smoke test for the driver module port (salam/driver.salam), stage 8a.
// Unit-level asserts on option defaults, module/dir naming, DCE wiring
// exposure, and temp-file/basename conventions. The real end-to-end gate
// (build a real executable / run via the interpreter and diff against
// HEAD `bin/salam`) lives in tests_port/driver_run.salam.

import dr "../driver.salam"
import testing
import os
import io
import str

func test_command_consts():
    testing.AssertEqInt(dr.CMD_INSPECT, 0)
    testing.AssertEqInt(dr.CMD_BUILD, 1)
    testing.AssertEqInt(dr.CMD_OBJ, 2)
    testing.AssertEqInt(dr.CMD_LLVM, 3)
    testing.AssertEqInt(dr.CMD_JS, 4)
    testing.AssertEqInt(dr.CMD_RUN, 5)
    testing.AssertEqInt(dr.CMD_LAYOUT_BUILD, 6)
    testing.AssertEqInt(dr.CMD_WEB, 7)
    testing.AssertEqInt(dr.CMD_DEBUG, 8)
    testing.AssertEqInt(dr.CMD_MEMCHECK, 9)
    testing.AssertEqInt(dr.CMD_NEW, 10)
    testing.AssertEqInt(dr.CMD_FMT, 11)
    testing.AssertEqInt(dr.CMD_REPL, 12)
    testing.AssertEqInt(dr.CMD_REPL_LAYOUT, 13)
    testing.AssertEqInt(dr.CMD_HELP, 14)
    testing.AssertEqInt(dr.CMD_VERSION, 15)
end

func test_option_defaults():
    opt := dr.NewOptions()
    defer opt.inputs.free()
    defer opt.run_args.free()
    defer opt.defines.free()
    testing.AssertEqInt(opt.command, dr.CMD_INSPECT)
    testing.AssertEqStr(opt.input, "")
    testing.AssertEqStr(opt.lang, "en")
    testing.AssertEqInt(opt.log_level, 2)
    testing.AssertFalse(opt.emit_tokens_xml)
    testing.AssertFalse(opt.emit_ast_xml)
    testing.AssertFalse(opt.emit_symbol_xml)
    testing.AssertEqStr(opt.xml_out, "")
    testing.AssertEqInt(opt.color, 0 - 1)
    testing.AssertEqStr(opt.output, "")
    testing.AssertEqStr(opt.cc, "tcc")
    testing.AssertFalse(opt.keep_c)
    testing.AssertTrue(opt.safe)
    testing.AssertFalse(opt.debug_info)
    testing.AssertFalse(opt.asan)
    testing.AssertFalse(opt.interp)
    testing.AssertEqStr(opt.stdlib_path, "")
    testing.AssertEqStr(opt.exe_path, "")
    testing.AssertEqInt(opt.inputs.len(), 0)
    testing.AssertEqInt(opt.run_args.len(), 0)
    testing.AssertEqInt(opt.defines.len(), 0)
    testing.AssertEqInt(opt.fmt_indent_width, 4)
    testing.AssertFalse(opt.llvm_verify)
    testing.AssertEqStr(opt.llvm_target, "")
    testing.AssertFalse(opt.version_short)
end

func test_module_of():
    testing.AssertEqStr(dr.ModuleOf("foo.salam"), "foo")
    testing.AssertEqStr(dr.ModuleOf("a/b/foo.salam"), "foo")
    testing.AssertEqStr(dr.ModuleOf("a\\b\\foo.salam"), "foo")
    testing.AssertEqStr(dr.ModuleOf("foo"), "foo")
    testing.AssertEqStr(dr.ModuleOf("dir/mem.salam"), "mem")
end

func test_dir_of():
    testing.AssertEqStr(dr.DirOf("foo.salam"), "")
    testing.AssertEqStr(dr.DirOf("a/b/foo.salam"), "a/b")
    testing.AssertEqStr(dr.DirOf("a\\b\\foo.salam"), "a\\b")
    testing.AssertEqStr(dr.DirOf("/x/y/z.salam"), "/x/y")
end

func test_resolve_color():
    testing.AssertTrue(dr.ResolveColor(1))
    testing.AssertFalse(dr.ResolveColor(0))
    // -1 (auto) resolves to a bool either way (isatty probe); just check it
    // doesn't crash and returns a well-formed bool by using it in a branch.
    mut ok := false
    if dr.ResolveColor(0 - 1):
        ok = true
    else:
        ok = true
    end
    testing.AssertTrue(ok)
end

// Build() with a nonexistent input reports failure (rc != 0) without
// crashing - exercises option wiring (inputs/defines Vectors, command
// dispatch) end to end without needing a real C toolchain invocation to
// succeed.
func test_build_missing_input():
    mut opt := dr.NewOptions()
    defer opt.inputs.free()
    defer opt.run_args.free()
    defer opt.defines.free()
    opt.inputs.push("this_file_does_not_exist_12345.salam")
    opt.output = "/tmp/salam_driver_test_missing_out"
    rc := dr.Build(opt)
    testing.AssertTrue(rc != 0)
end

// Exec() with a nonexistent input also fails cleanly (rc == 2, matching
// driver_interp's "cannot read source file" -> exit 2).
func test_exec_missing_input():
    mut opt := dr.NewOptions()
    defer opt.inputs.free()
    defer opt.run_args.free()
    defer opt.defines.free()
    opt.input = "this_file_does_not_exist_67890.salam"
    rc := dr.Exec(opt)
    testing.AssertEqInt(rc, 2)
end

// The 4 backends (Llvm/Js/LayoutBuild/Web) were stubs in stage 8a; stage 8b
// replaced them with real ports. They must still report failure (rather
// than silently doing nothing or crashing) when called with no input at
// all - this is real behavior now, not stub behavior (see the LayoutBuild/
// Web PORT-NOTEs: a defensive "no input" guard was added to each since
// there's no CLI layer yet to enforce that precondition upstream).
func test_backends_report_failure_on_no_input():
    mut opt1 := dr.NewOptions()
    defer opt1.inputs.free()
    defer opt1.run_args.free()
    defer opt1.defines.free()
    testing.AssertTrue(dr.Llvm(opt1) != 0)

    mut opt2 := dr.NewOptions()
    defer opt2.inputs.free()
    defer opt2.run_args.free()
    defer opt2.defines.free()
    testing.AssertTrue(dr.Js(opt2) != 0)

    mut opt3 := dr.NewOptions()
    defer opt3.inputs.free()
    defer opt3.run_args.free()
    defer opt3.defines.free()
    testing.AssertTrue(dr.LayoutBuild(opt3) != 0)

    mut opt4 := dr.NewOptions()
    defer opt4.inputs.free()
    defer opt4.run_args.free()
    defer opt4.defines.free()
    testing.AssertTrue(dr.Web(opt4) != 0)
end

// A real tiny program through dr.Llvm(): default options mean llvm_emit ==
// LV_OUT_IR (0) and opt_level == O0/verify == false, so NativeRun's
// toolchain shell-out is SKIPPED entirely (matching driver_llvm's own "ir
// mode && !verify && opt_level==O0" skip) - this exercises the front end +
// lv.RunOpts + file-write path without needing a working clang/opt/lli on
// PATH (a Gate-2-style corpus run, exercised separately, DOES need those;
// see the report for the corpus numbers).
func test_llvm_real_program():
    path := "compiler/tests_port/tmp_dr/dt_llvm_hello.salam"
    _w := io.WriteFile(path, "func main:\n    println 1 + 2\nend\n")
    outp := "compiler/tests_port/tmp_dr/dt_llvm_hello.ll"
    mut opt := dr.NewOptions()
    defer opt.inputs.free()
    defer opt.run_args.free()
    defer opt.defines.free()
    opt.inputs.push(path)
    opt.input = path
    opt.output = outp
    rc := dr.Llvm(opt)
    testing.AssertEqInt(rc, 0)
    ll := io.ReadFile(outp)
    testing.AssertContains(ll, "define")
    testing.AssertContains(ll, "ModuleID")
    _r1 := os.Remove(path)
    _r2 := os.Remove(outp)
end

// A real tiny program through dr.Js(): default options minify, so the
// bundle is a single-line IIFE - assert on structural markers rather than
// exact mangled names (the jsgen-wave's own gates already prove exact
// content byte-for-byte; this is a driver-level wiring smoke test).
func test_js_real_program():
    path := "compiler/tests_port/tmp_dr/dt_js_hello.salam"
    _w := io.WriteFile(path, "func main:\n    println 1 + 2\nend\n")
    outp := "compiler/tests_port/tmp_dr/dt_js_hello.js"
    mut opt := dr.NewOptions()
    defer opt.inputs.free()
    defer opt.run_args.free()
    defer opt.defines.free()
    opt.inputs.push(path)
    opt.input = path
    opt.output = outp
    rc := dr.Js(opt)
    testing.AssertEqInt(rc, 0)
    js := io.ReadFile(outp)
    testing.AssertContains(js, "use strict")
    testing.AssertContains(js, "DOMContentLoaded")
    _r1 := os.Remove(path)
    _r2 := os.Remove(outp)
end

// A real layout program through dr.LayoutBuild(): asserts the produced
// HTML contains the recognized <h1>/title content (a schema-recognition
// regression would silently render everything as <div>, which is exactly
// the bug this test would have caught during development - see the
// report's "Web/LayoutSchemaInit" subtlety).
func test_layout_real_program():
    path := "compiler/tests_port/tmp_dr/dt_layout_hello.salam"
    _w := io.WriteFile(
        path, "layout:\n    title = \"T\"\n    box:\n        heading: size = 1 content = \"Hi\" end\n    end\nend\n"
    )
    mut opt := dr.NewOptions()
    defer opt.inputs.free()
    defer opt.run_args.free()
    defer opt.defines.free()
    opt.inputs.push(path)
    rc := dr.LayoutBuild(opt)
    testing.AssertEqInt(rc, 0)
    outp := "dt_layout_hello.html"
    html := io.ReadFile(outp)
    testing.AssertContains(html, "<h1")
    testing.AssertContains(html, "<title>T</title>")
    _r1 := os.Remove(path)
    _r2 := os.Remove(outp)
end

// A layout + <script src="*.salam"> page through dr.Web(): the script's
// compiled JS must be bundled INTO the page (not left as a literal
// <script src=...> tag), and the layout element schema must be resolved
// (same LayoutSchemaInit subtlety as the layout test above).
func test_web_real_program():
    pagep := "compiler/tests_port/tmp_dr/dt_web_page.salam"
    scriptp := "compiler/tests_port/tmp_dr/dt_web_script.salam"
    _w1 := io.WriteFile(scriptp, "func main:\n    println \"script ran\"\nend\n")
    _w2 := io.WriteFile(
        pagep, "layout:\n    title = \"W\"\n    box:\n        heading: size = 1 content = \"Hi\" end\n    end\n    script: src = \"dt_web_script.salam\" end\nend\n"
    )
    mut opt := dr.NewOptions()
    defer opt.inputs.free()
    defer opt.run_args.free()
    defer opt.defines.free()
    opt.inputs.push(pagep)
    rc := dr.Web(opt)
    testing.AssertEqInt(rc, 0)
    outp := "dt_web_page.html"
    html := io.ReadFile(outp)
    testing.AssertContains(html, "<h1")
    testing.AssertContains(html, "script ran")
    testing.AssertFalse(str.Contains(html, "src=\"dt_web_script.salam\""))
    _r1 := os.Remove(pagep)
    _r2 := os.Remove(scriptp)
    _r3 := os.Remove(outp)
end

// LlvmBuild() sets opt.llvm_emit from opt.command BEFORE calling Llvm() - // build_impl's own --target redirect calls this wrapper, not a bare
// Llvm(), for exactly this reason (see the PORT-NOTE above build_impl).
// Exercised here through Obj() with a real (bogus but non-empty)
// llvm_target so the CMD_OBJ->LV_OUT_OBJ wiring is provably reached
// without needing a real cross sysroot to succeed.
func test_llvm_build_sets_emit_mode():
    mut opt := dr.NewOptions()
    defer opt.inputs.free()
    defer opt.run_args.free()
    defer opt.defines.free()
    opt.command = dr.CMD_OBJ
    opt.llvm_target = "bogus-target-triple"
    rc := dr.LlvmBuild(opt)
    // A nonexistent triple's sysroot/toolchain lookup fails, but the
    // field-wiring itself must still have happened before that failure.
    testing.AssertEqInt(opt.llvm_emit, 2) // lv.LV_OUT_OBJ
    testing.AssertTrue(rc != 0)
end

// Debug()/Memcheck() guard clauses (no input; tcc+asan unsupported) - // asserted without needing a real gdb/lldb/valgrind on PATH.
func test_debug_memcheck_guards():
    mut opt1 := dr.NewOptions()
    defer opt1.inputs.free()
    defer opt1.run_args.free()
    defer opt1.defines.free()
    testing.AssertEqInt(dr.Debug(opt1), 2)

    mut opt2 := dr.NewOptions()
    defer opt2.inputs.free()
    defer opt2.run_args.free()
    defer opt2.defines.free()
    testing.AssertEqInt(dr.Memcheck(opt2), 2)

    mut opt3 := dr.NewOptions()
    defer opt3.inputs.free()
    defer opt3.run_args.free()
    defer opt3.defines.free()
    opt3.inputs.push("compiler/tests_port/tmp_dr/dt_llvm_hello.salam")
    testing.AssertEqStr(opt3.cc, "tcc")
    testing.AssertEqInt(dr.Memcheck(opt3), 2) // tcc can't do ASan
end

// embed_sysroot.c's MaterializeSysroot - no real embedded sysroot blob
// exists anywhere in this repo to test against (see the module's own
// header note: unreachable without SALAM_HAVE_LLVM, ported for source
// fidelity only). A full build-a-tar/parse-it-back test isn't possible with
// `str` (see the PORT-NOTE on test_materialize_sysroot below), so only the
// short-tar fast-path is verified.

// PORT-NOTE (pre-existing, found post-restructure, unrelated to the path
// move): Salam's `str` is NUL-terminated C-string-backed - str.Len()/BufStr
// truncate at the first embedded 0x00 byte (verified directly: appending
// "AB" + NUL + "CD" and reading back via str.BufStr/str.Len yields length 2,
// not 5). A real USTAR tar archive is full of NUL padding bytes, so it can
// never survive a round-trip through `str` intact - this makes a full
// build-a-tar-in-a-str/parse-it-back test impossible to write faithfully
// with the current `str` type (would need a byte-safe Vector<u8> buffer
// type throughout MaterializeSysroot/untar to fix properly, which is a
// bigger change than this test file should make unilaterally). This is not
// a driver.salam regression: MaterializeSysroot/untar are themselves only
// reachable behind SALAM_HAVE_LLVM (unset in this build), so the module's
// own header already documents this path as "ported for source fidelity
// only" - dead code today, not exercised by any real build. Scoped down to
// what CAN be verified without embedded NULs: the short-tar fast-path.
func test_materialize_sysroot():
    mut out := ""
    ok := dr.MaterializeSysroot("dt_test_sysroot", "too short", out)
    testing.AssertFalse(ok) // str.Len(tar) < 512 -> false, no NUL bytes involved
end

func main:
    os.MkdirAll("compiler/tests_port/tmp_dr")
    test_command_consts()
    test_option_defaults()
    test_module_of()
    test_dir_of()
    test_resolve_color()
    test_build_missing_input()
    test_exec_missing_input()
    test_backends_report_failure_on_no_input()
    test_llvm_real_program()
    test_js_real_program()
    test_layout_real_program()
    test_web_real_program()
    test_llvm_build_sets_emit_mode()
    test_debug_memcheck_guards()
    test_materialize_sysroot()
    os.Exit(testing.Summary())
end
