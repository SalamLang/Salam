import os
import io

include co "../sal_core.salam"
include src "../source.salam"
include lg "../logger.salam"
include lp "../langpack.salam"
include lx "../lexer/lexer.salam"
include sf "../sal_fmt.salam"

func main:
    args := os.Args()
    defer args.free()
    if args.len() < 2:
        io.EPrintln("usage: fmt_run <file.salam>")
        ret 2
    end
    path := args[1]
    mut sfile := src.New()
    if not src.Load(path, sfile):
        io.EPrintln("cannot read source file '" + path + "'")
        ret 2
    end
    lgr := lg.New(lg.LOG_OFF, false)
    pack := lx.Detect(sfile, lp.Load("en"))
    mut out := co.SbNew()
    ok := sf.Source(lgr, pack, sfile, sf.StyleDefault(), out)
    if not ok:
        co.SbFree(out)
        io.EPrintln("cannot format '" + path + "': fix the lexical errors first")
        ret 1
    end
    print co.SbCstr(out)
    co.SbFree(out)
end
