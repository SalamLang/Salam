// Smoke test for salam/sal_fmt (port of compiler/src/fmt: fmt.c +
// fmt_rules.c - the token-based reformatter behind `salam format`).
// Every expected string below was produced by the C formatter built from
// the current compiler/src (run on the same snippet), so these asserts pin
// byte-identical behavior: block indentation, operator spacing (including
// the gap-preserving '*'/'<'/'>' rules), comment preservation, blank-line
// collapsing, if/else chains, match arms, multiline brackets, layout
// blocks, lambdas, ternaries, tabs style, Persian sources, and idempotence
// (format(format(x)) == format(x)).
// Run from the repo root:
//   SALAM_STD=$PWD/compiler ./bin/salam run salam/tests_port/fmt_test.salam
import testing
import os
import co "../sal_core.salam"
import src "../source.salam"
import lg "../logger.salam"
import lp "../langpack.salam"
import lx "../lexer.salam"
import sf "../sal_fmt.salam"

// driver_fmt/fmt_one_file: detect the language pack, then fmt_source with
// keep_comments lexing. Returns "" when the lexer reports errors.
func fmt_with(snippet: str, style_tabs: bool, width: int): str:
    lgr := lg.New(lg.LOG_OFF, false)
    mut sfile := src.New()
    sfile.path = "<snippet>"
    sfile.text = snippet
    sfile.len = snippet.len()
    pack := lx.Detect(sfile, lp.Load("en"))
    mut out := co.SbNew()
    ok := sf.Source(lgr, pack, sfile, sf.NewStyle(style_tabs, width), out)
    mut res := ""
    if ok:
        res = co.SbCstr(out)
    end
    co.SbFree(out)
    ret res
end

func fmt_of(snippet: str): str:
    ret fmt_with(snippet, false, sf.FMT_INDENT_WIDTH)
end

// format + idempotence in one: asserts fmt(snippet) == want AND
// fmt(want) == want (a second pass changes nothing - also exactly what
// `salam format --check` relies on).
func check(snippet: str, want: str):
    got := fmt_of(snippet)
    testing.AssertEqStr(got, want)
    again := fmt_of(got)
    testing.AssertEqStr(again, want)
end

func main:
    // StyleDefault mirrors fmt_style_default(): spaces, width 4
    st := sf.StyleDefault()
    testing.AssertFalse(st.tabs)
    testing.AssertEqInt(st.width, 4)

    // block indentation
    check(
        "func main:\nprintln \"hi\"\nend\n", "func main:\n    println \"hi\"\nend\n"
    )

    // operator spacing: ':='/'+'/'/'/'%' always spaced; '*' keeps the
    // source gap (pointer-type ambiguity), so a*b stays tight
    check(
        "x:=1+2\ny   :=   a*b\nz := 1+2*3\nw := c  /  d   %   e\n", "x := 1 + 2\ny := a*b\nz := 1 + 2*3\nw := c / d % e\n"
    )

    // comment preservation: leading //, trailing //, /* block */
    check(
        "// leading comment\nfunc main:\n    x := 1 // trailing comment\n" + "    /* block\n       comment */\n    println x\nend\n",
        "// leading comment\nfunc main:\n    x := 1 // trailing comment\n" + "    /* block\n       comment */\n    println x\nend\n"
    )

    // blank-line handling: runs of blank lines collapse to one
    check(
        "func a:\nend\n\n\n\nfunc b:\nend\n", "func a:\nend\n\nfunc b:\nend\n"
    )

    // if / else-cond / else chain (each 'else' dedents then re-indents)
    check(
        "func f(n: int): int:\nif n > 0:\nret 1\nelse n == 0:\nret 0\n" + "else:\nret 0-1\nend\nend\n",
        "func f(n: int): int:\n    if n > 0:\n        ret 1\n" + "    else n == 0:\n        ret 0\n    else:\n        ret 0 - 1\n" + "    end\nend\n"
    )

    // match arms: arms indent once; the 'else' arm does NOT dedent
    check(
        "func main:\ng := match s / 10:\n10, 9 => \"A\"\n8 => \"B\"\n" + "else => \"F\"\nend\nprintln g\nend\n",
        "func main:\n    g := match s / 10:\n        10, 9 => \"A\"\n" + "        8 => \"B\"\n        else => \"F\"\n    end\n    println g\nend\n"
    )

    // multiline brackets reflow onto one indented line; generics stay tight
    check(
        "xs := [\n1,\n2,\n3\n]\nm := HashMap {} as HashMap<str, int>\n" + "v := Vector {} as Vector<Vector<int>>\n",
        "xs := [\n    1, 2, 3\n]\nm := HashMap {} as HashMap<str, int>\n" + "v := Vector {} as Vector<Vector<int>>\n"
    )

    // layout blocks indent like general blocks; same-line element bodies stay
    check(
        "layout:\ntitle = \"My Page\"\nbox:\npadding = \"20px\"\n" + "paragraph: content = \"Hello\" end\nend\nend\n",
        "layout:\n    title = \"My Page\"\n    box:\n        padding = \"20px\"\n" + "        paragraph: content = \"Hello\" end\n    end\nend\n"
    )

    // struct: annotation colons ('balance: int') don't open blocks
    check(
        "struct Account:\npub balance: int = 0\npub func deposit(n: int):\n" + "this.balance = this.balance + n\nend\nend\n",
        "struct Account:\n    pub balance: int = 0\n" + "    pub func deposit(n: int):\n        this.balance = this.balance + n\n" + "    end\nend\n"
    )

    // lambdas, block lambdas, ternary ':', keyword-named method call,
    // bitwise operators
    check(
        "f := (x: int) => x * 2\ng := (a: int, b: Vector<int>): \nret a\nend\n" + "cond := n > 0 ? \"pos\" : \"neg\"\ns2 := s.repeat(3)\n" + "mut flags := 0\nflags |= 1 << 3\non := (flags >> 2) & 1\n",
        "f := (x: int) => x * 2\ng := (a: int, b: Vector<int>):\n    ret a\nend\n" + "cond := n > 0 ? \"pos\" : \"neg\"\ns2 := s.repeat(3)\n" + "mut flags := 0\nflags |= 1 << 3\non := (flags >> 2) & 1\n"
    )

    // loop keywords
    check(
        "until   i < n:\ni += 1\nend\nrepeat 3:\nprintln \"hi\"\nend\n" + "each (k, v2) in m:\nprintln k, v2\nend\n",
        "until i < n:\n    i += 1\nend\nrepeat 3:\n    println \"hi\"\nend\n" + "each (k, v2) in m:\n    println k, v2\nend\n"
    )

    // Persian source (fa langpack via the marker comment); '>' keeps its
    // source gap, ZWNJ identifiers pass through untouched in fmt mode
    check(
        "// زبان: فارسی\nتابع اصلی:\nچاپ \"سلام\"\nالف := 1\nاگر الف>0:\n" + "چاپ \"بله\"\nوگرنه:\nچاپ \"خیر\"\nتمام\nتمام\n",
        "// زبان: فارسی\nتابع اصلی:\n    چاپ \"سلام\"\n    الف := 1\n" + "    اگر الف>0:\n        چاپ \"بله\"\n    وگرنه:\n" + "        چاپ \"خیر\"\n    تمام\nتمام\n"
    )

    // tabs style (driver --tabs): one '\t' per level
    testing.AssertEqStr(
        fmt_with("func main:\nprintln \"hi\"\nend\n", true, 4), "func main:\n\tprintln \"hi\"\nend\n"
    )

    // lexical errors -> Source returns false ("" here), like the C bool
    testing.AssertEqStr(fmt_of("x := \"unterminated\n"), "")

    os.Exit(testing.Summary())
end
