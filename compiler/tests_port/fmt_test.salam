import testing

include co "../sal_core.salam"
include src "../source.salam"
include lg "../logger.salam"
include lp "../langpack.salam"
include lx "../lexer/lexer.salam"
include sf "../sal_fmt.salam"

func fmt_with(snippet: str, style_tabs: bool, width: int): str:
    lgr := lg.New(lg.LOG_OFF, false)
    mut sfile := src.New()
    sfile.path = "<snippet>"
    sfile.text = snippet
    sfile.len = snippet.len()
    pack := lx.Detect(sfile, lp.Load("en"))
    mut out := co.SbNew()
    ok := sf.Source(lgr, pack, sfile, sf.NewStyle(style_tabs, width, false), out)
    mut res := ""
    if ok:
        res = co.SbCstr(out)
    end
    co.SbFree(out)
    ret res
end

func fmt_of(snippet: str): str:
    ret fmt_with(snippet, false, sf.FMT_INDENT_WIDTH)
end

func check(snippet: str, want: str):
    got := fmt_of(snippet)
    testing.AssertEqStr(got, want)
    again := fmt_of(got)
    testing.AssertEqStr(again, want)
end

func main:
    st := sf.StyleDefault()
    testing.AssertFalse(st.tabs)
    testing.AssertEqInt(st.width, 4)

    check(
        "struct R:\n    pub type: str = \"\"\n    pub mut: int = 0\n        pub if: bool = false\n        end\n\n        pub func main:\n            println 1\n        end\n", "struct R:\n    pub type: str = \"\"\n    pub mut: int = 0\n    pub if: bool = false\nend\n\npub func main:\n    println 1\nend\n"
    )

    check(
        "// زبان: فارسی\nروال جمع(الف: صحیح،ب: صحیح): صحیح:\nبرگشت الف+ب\nپایان\n", "// زبان: فارسی\nروال جمع(الف: صحیح، ب: صحیح): صحیح:\n    برگشت الف + ب\nپایان\n"
    )

    check(
        "func main:\nprintln \"hi\"\nend\n", "func main:\n    println \"hi\"\nend\n"
    )

    check(
        "x:=1+2\ny   :=   a*b\nz := 1+2*3\nw := c  /  d   %   e\n", "x := 1 + 2\ny := a*b\nz := 1 + 2*3\nw := c / d % e\n"
    )

    check(
        ```
            // leading comment
            func main:
                x := 1 // trailing comment
                /* block
                   comment */
                println x
            end

            ```, "// leading comment\nfunc main:\n    x := 1 // trailing comment\n" + "    /* block\n       comment */\n    println x\nend\n"
    )

    check(
        "func a:\nend\n\n\n\nfunc b:\nend\n", "func a:\nend\n\nfunc b:\nend\n"
    )

    check(
        ```
            func f(n: int): int:
            if n > 0:
            ret 1
            else n == 0:
            ret 0
            else:
            ret 0-1
            end
            end

            ```, "func f(n: int): int:\n    if n > 0:\n        ret 1\n" + "    else n == 0:\n        ret 0\n    else:\n        ret 0 - 1\n" + "    end\nend\n"
    )

    check(
        ```
            func main:
            g := match s / 10:
            10, 9: "A" end
            8: "B" end
            else: "F" end
            end
            println g
            end

            ```, "func main:\n    g := match s / 10:\n        10, 9: \"A\" end\n" + "        8: \"B\" end\n        else: \"F\" end\n    end\n    println g\nend\n"
    )

    check(
        ```
            xs := [
            1,
            2,
            3
            ]
            m := HashMap {} as HashMap<str, int>
            v := Vector {} as Vector<Vector<int>>

            ```, "xs := [\n    1, 2, 3\n]\nm := HashMap {} as HashMap<str, int>\n" + "v := Vector {} as Vector<Vector<int>>\n"
    )

    check(
        ```
            layout:
            title = "My Page"
            box:
            padding = "20px"
            paragraph: content = "Hello" end
            end
            end

            ```, "layout:\n    title = \"My Page\"\n    box:\n        padding = \"20px\"\n" + "        paragraph: content = \"Hello\" end\n    end\nend\n"
    )

    check(
        ```
            struct Account:
            pub balance: int = 0
            pub func deposit(n: int):
            this.balance = this.balance + n
            end
            end

            ```, "struct Account:\n    pub balance: int = 0\n" + "    pub func deposit(n: int):\n        this.balance = this.balance + n\n" + "    end\nend\n"
    )

    check(
        "f := (x: int): ret x * 2 end\ng := (a: int, b: Vector<int>): \nret a\nend\n" + "cond := n > 0 ? \"pos\" : \"neg\"\ns2 := s.repeat(3)\n" + "mut flags := 0\nflags |= 1 << 3\non := (flags >> 2) & 1\n", ```
            f := (x: int): ret x * 2 end
            g := (a: int, b: Vector<int>):
                ret a
            end
            cond := n > 0 ? "pos" : "neg"
            s2 := s.repeat(3)
            mut flags := 0
            flags |= 1 << 3
            on := (flags >> 2) & 1

            ```
    )

    check(
        ```
            until   i < n:
            i += 1
            end
            repeat 3:
            println "hi"
            end
            each k, v2 in m:
            println k, v2
            end

            ```, "until i < n:\n    i += 1\nend\nrepeat 3:\n    println \"hi\"\nend\n" + "each k, v2 in m:\n    println k, v2\nend\n"
    )

    check(
        ```
            // زبان: فارسی
            روال ریشه:
            سرچاپ "سلام"
            الف := 1
            اگر الف>0:
            سرچاپ "بله"
            وگرنه:
            سرچاپ "خیر"
            پایان
            پایان

            ```, "// زبان: فارسی\nروال ریشه:\n    سرچاپ \"سلام\"\n    الف := 1\n" + "    اگر الف>0:\n        سرچاپ \"بله\"\n    وگرنه:\n" + "        سرچاپ \"خیر\"\n    پایان\nپایان\n"
    )

    check(
        ```
            package p
            import str
            link dynamic "m"
            const A := 1
            const B := 2
            mut n := 0
            struct S:
            end
            func f:
            end

            ```, "package p\n\nimport str\n\nlink dynamic \"m\"\n\nconst A := 1\nconst B := 2\n\n" + "mut n := 0\n\nstruct S:\nend\n\nfunc f:\nend\n"
    )

    check(
        "pub const A := 1\n\npub const B := 2\nconst C := 3\n@en \"F\"\npub func F:\nend\n", "pub const A := 1\n\npub const B := 2\n\nconst C := 3\n\n@en \"F\"\npub func F:\nend\n"
    )

    check(
        "struct C:\npub static func Make(): C:\nret C {}\nend\nstatic func Salt(): int:\nret 1\nend\nend\n", ```
            struct C:
                pub static func Make(): C:
                    ret C {}
                end
                static func Salt(): int:
                    ret 1
                end
            end

            ```
    )

    check(
        "xs := [\n100, 101, 102, 103, 104, 105, 106, 107, 108, 109,\n110, 111, 112, 113, 114, 115, 116, 117, 118, 119, 120, 121, 122, 123, 124, 125, 126, 127, 128, 129\n]\n", "xs := [\n    100, 101, 102, 103, 104, 105, 106, 107, 108, 109, 110, 111, 112, 113, 114, 115, 116, 117, 118,\n    119, 120, 121, 122, 123, 124, 125, 126, 127, 128, 129\n]\n"
    )

    testing.AssertEqStr(
        fmt_with("func main:\nprintln \"hi\"\nend\n", true, 4), "func main:\n\tprintln \"hi\"\nend\n"
    )

    testing.AssertEqStr(fmt_of("x := \"unterminated\n"), "")

    ret testing.Summary()
end
