include tok "../token.salam"

import testing

include i18 "../i18n.salam"
include co "../sal_core.salam"
include lp "../langpack.salam"

func test_load():
    testing.AssertEqInt(lp.Load("en"), lp.LP_EN)
    testing.AssertEqInt(lp.Load("fa"), lp.LP_FA)
    testing.AssertEqInt(lp.Load("de"), lp.LP_NONE)
    testing.AssertEqInt(lp.Load(""), lp.LP_NONE)
    testing.AssertEqStr(lp.Code(lp.LP_EN), "en")
    testing.AssertEqStr(lp.Code(lp.LP_FA), "fa")
    testing.AssertEqStr(lp.Code(lp.LP_NONE), "")
    lp.Free(lp.LP_EN)
end

func test_entry_names():
    testing.AssertEqStr(lp.Entry(lp.LP_EN), "main")
    testing.AssertEqStr(lp.Entry(lp.LP_FA), "ریشه")
    testing.AssertEqStr(lp.EntryFor("fa"), "ریشه")
    testing.AssertEqStr(lp.EntryFor("en"), "main")
    testing.AssertEqStr(lp.EntryFor("xx"), "main")
end

func test_end_spelling():
    testing.AssertEqStr(lp.EndSpelling(lp.Load("en")), "end")
    testing.AssertEqStr(lp.EndSpelling(lp.Load("fa")), "پایان")
    testing.AssertEqStr(lp.EndSpelling(lp.LP_NONE), "end")
end

func test_keywords_en():
    en := lp.Load("en")
    spellings := [
        "func", "ret", "if", "else", "until", "on", "mut", "const", "type", "struct", "enum", "end", "import", "as", "true", "false", "null", "this", "break", "continue", "layout", "package", "print", "println", "printerr", "printerrln", "input", "defer", "extern", "interface", "pub", "inline", "noinline", "pure", "noret", "deprecated", "component", "repeat", "impl", "to", "by", "each", "in", "match", "include"
    ]
    kinds := [
        tok.TK_KW_FUNC, tok.TK_KW_RET, tok.TK_KW_IF, tok.TK_KW_ELSE, tok.TK_KW_UNTIL, tok.TK_KW_ON, tok.TK_KW_MUT, tok.TK_KW_CONST, tok.TK_KW_TYPE, tok.TK_KW_STRUCT, tok.TK_KW_ENUM, tok.TK_KW_END, tok.TK_KW_IMPORT, tok.TK_KW_AS, tok.TK_KW_TRUE, tok.TK_KW_FALSE, tok.TK_KW_NULL, tok.TK_KW_THIS, tok.TK_KW_BREAK, tok.TK_KW_CONTINUE, tok.TK_KW_LAYOUT, tok.TK_KW_PACKAGE, tok.TK_KW_PRINT, tok.TK_KW_PRINTLN, tok.TK_KW_PRINTERR, tok.TK_KW_PRINTERRLN, tok.TK_KW_INPUT, tok.TK_KW_DEFER, tok.TK_KW_EXTERN, tok.TK_KW_INTERFACE, tok.TK_KW_PUB, tok.TK_KW_INLINE, tok.TK_KW_NOINLINE, tok.TK_KW_PURE, tok.TK_KW_NORET, tok.TK_KW_DEPRECATED, tok.TK_KW_COMPONENT, tok.TK_KW_REPEAT, tok.TK_KW_IMPL, tok.TK_KW_TO, tok.TK_KW_STEP, tok.TK_KW_EACH, tok.TK_KW_IN, tok.TK_KW_MATCH, tok.TK_KW_INCLUDE
    ]
    n := len(spellings)
    repeat n in i:
        testing.AssertEqInt(lp.LookupKeyword(en, spellings[i]), kinds[i])
    end
    testing.AssertEqInt(lp.LookupKeyword(en, "funcx"), tok.TK_IDENT)
    testing.AssertEqInt(lp.LookupKeyword(en, "End"), tok.TK_IDENT)
    testing.AssertEqInt(lp.LookupKeyword(en, "eq"), tok.TK_EQ)
    testing.AssertEqInt(lp.LookupKeyword(en, "neq"), tok.TK_NE)
    testing.AssertEqInt(lp.LookupKeyword(en, ""), tok.TK_IDENT)
    testing.AssertEqInt(lp.LookupKeyword(en, "روال"), tok.TK_IDENT)
end

func test_keywords_fa():
    fa := lp.Load("fa")
    testing.AssertEqInt(lp.LookupKeyword(fa, "روال"), tok.TK_KW_FUNC)
    testing.AssertEqInt(lp.LookupKeyword(fa, "برگشت"), tok.TK_KW_RET)
    testing.AssertEqInt(lp.LookupKeyword(fa, "اگر"), tok.TK_KW_IF)
    testing.AssertEqInt(lp.LookupKeyword(fa, "وگرنه"), tok.TK_KW_ELSE)
    testing.AssertEqInt(lp.LookupKeyword(fa, "تا"), tok.TK_KW_UNTIL)
    testing.AssertEqInt(lp.LookupKeyword(fa, "بر"), tok.TK_KW_ON)
    testing.AssertEqInt(lp.LookupKeyword(fa, "ناپایا"), tok.TK_KW_MUT)
    testing.AssertEqInt(lp.LookupKeyword(fa, "پایا"), tok.TK_KW_CONST)
    testing.AssertEqInt(lp.LookupKeyword(fa, "گونه"), tok.TK_KW_TYPE)
    testing.AssertEqInt(lp.LookupKeyword(fa, "ساختار"), tok.TK_KW_STRUCT)
    testing.AssertEqInt(lp.LookupKeyword(fa, "جداشمار"), tok.TK_KW_ENUM)
    testing.AssertEqInt(lp.LookupKeyword(fa, "پایان"), tok.TK_KW_END)
    testing.AssertEqInt(lp.LookupKeyword(fa, "واردسازی"), tok.TK_KW_IMPORT)
    testing.AssertEqInt(lp.LookupKeyword(fa, "برگردان"), tok.TK_KW_AS)
    testing.AssertEqInt(lp.LookupKeyword(fa, "درست"), tok.TK_KW_TRUE)
    testing.AssertEqInt(lp.LookupKeyword(fa, "نادرست"), tok.TK_KW_FALSE)
    testing.AssertEqInt(lp.LookupKeyword(fa, "پوچ"), tok.TK_KW_NULL)
    testing.AssertEqInt(lp.LookupKeyword(fa, "این"), tok.TK_KW_THIS)
    testing.AssertEqInt(lp.LookupKeyword(fa, "بشکن"), tok.TK_KW_BREAK)
    testing.AssertEqInt(lp.LookupKeyword(fa, "گذر"), tok.TK_KW_CONTINUE)
    testing.AssertEqInt(lp.LookupKeyword(fa, "چیدمان"), tok.TK_KW_LAYOUT)
    testing.AssertEqInt(lp.LookupKeyword(fa, "بسته"), tok.TK_KW_PACKAGE)
    testing.AssertEqInt(lp.LookupKeyword(fa, "چاپ"), tok.TK_KW_PRINT)
    testing.AssertEqInt(lp.LookupKeyword(fa, "سرچاپ"), tok.TK_KW_PRINTLN)
    testing.AssertEqInt(lp.LookupKeyword(fa, "نادرست\xE2\x80\x8Cچاپ"), tok.TK_KW_PRINTERR)
    testing.AssertEqInt(lp.LookupKeyword(fa, "نادرست\xE2\x80\x8Cسرچاپ"), tok.TK_KW_PRINTERRLN)
    testing.AssertEqInt(lp.LookupKeyword(fa, "ورودی"), tok.TK_KW_INPUT)
    testing.AssertEqInt(lp.LookupKeyword(fa, "دیرکن"), tok.TK_KW_DEFER)
    testing.AssertEqInt(lp.LookupKeyword(fa, "کارور"), tok.TK_IDENT)
    testing.AssertEqInt(lp.LookupKeyword(fa, "درون\xE2\x80\x8Cداد"), tok.TK_KW_EXTERN)
    testing.AssertEqInt(lp.LookupKeyword(fa, "برون\xE2\x80\x8Cداد"), tok.TK_KW_EXPORT)
    testing.AssertEqInt(lp.LookupKeyword(fa, "فراخوانه"), tok.TK_IDENT)
    testing.AssertEqInt(lp.LookupKeyword(fa, "میانجی"), tok.TK_KW_INTERFACE)
    testing.AssertEqInt(lp.LookupKeyword(fa, "همگانی"), tok.TK_KW_PUB)
    testing.AssertEqInt(lp.LookupKeyword(fa, "درخط"), tok.TK_KW_INLINE)
    testing.AssertEqInt(lp.LookupKeyword(fa, "نادرخط"), tok.TK_KW_NOINLINE)
    testing.AssertEqInt(lp.LookupKeyword(fa, "ناب"), tok.TK_KW_PURE)
    testing.AssertEqInt(lp.LookupKeyword(fa, "نابرگشت"), tok.TK_KW_NORET)
    testing.AssertEqInt(lp.LookupKeyword(fa, "بی\xE2\x80\x8Cکاره"), tok.TK_KW_DEPRECATED)
    testing.AssertEqInt(lp.LookupKeyword(fa, "بخش"), tok.TK_KW_COMPONENT)
    testing.AssertEqInt(lp.LookupKeyword(fa, "تکرار"), tok.TK_KW_REPEAT)
    testing.AssertEqInt(lp.LookupKeyword(fa, "کاربست"), tok.TK_KW_IMPL)
    testing.AssertEqInt(lp.LookupKeyword(fa, "هر"), tok.TK_KW_EACH)
    testing.AssertEqInt(lp.LookupKeyword(fa, "در"), tok.TK_KW_IN)
    testing.AssertEqInt(lp.LookupKeyword(fa, "فراخوانی"), tok.TK_KW_INCLUDE)
    testing.AssertEqInt(lp.LookupKeyword(fa, "همخوان"), tok.TK_KW_MATCH)
    testing.AssertEqInt(lp.LookupKeyword(fa, "و"), tok.TK_AND)
    testing.AssertEqInt(lp.LookupKeyword(fa, "یا"), tok.TK_OR)
    testing.AssertEqInt(lp.LookupKeyword(fa, "برابر"), tok.TK_EQ)
    testing.AssertEqInt(lp.LookupKeyword(fa, "نابرابر"), tok.TK_NE)
    testing.AssertEqInt(lp.LookupKeyword(fa, "نا\xE2\x80\x8Cبرابر"), tok.TK_NE)
    testing.AssertEqInt(lp.LookupKeyword(fa, "سلام"), tok.TK_IDENT)
    testing.AssertEqInt(lp.LookupKeyword(fa, "func"), tok.TK_IDENT)
end

func test_keywords_fa_removed():
    fa := lp.Load("fa")
    testing.AssertEqInt(lp.LookupKeyword(fa, "با"), tok.TK_IDENT)
    testing.AssertEqInt(lp.LookupKeyword(fa, "گام"), tok.TK_IDENT)
    testing.AssertEqInt(lp.LookupKeyword(fa, "از"), tok.TK_IDENT)
    testing.AssertEqInt(lp.LookupKeyword(fa, "کارکرد"), tok.TK_IDENT)
    testing.AssertEqInt(lp.LookupKeyword(fa, "تاهنگام"), tok.TK_IDENT)
    testing.AssertEqInt(lp.LookupKeyword(lp.Load("en"), "while"), tok.TK_IDENT)
end

func test_keywords_fa_repeat_header():
    fa := lp.Load("fa")
    testing.AssertEqInt(lp.LookupKeywordIn(fa, "تا", false), tok.TK_KW_UNTIL)
    testing.AssertEqInt(lp.LookupKeywordIn(fa, "تا", true), tok.TK_KW_TO)
    testing.AssertEqInt(lp.LookupKeywordIn(fa, "هر", true), tok.TK_KW_STEP)
    testing.AssertEqInt(lp.LookupKeywordIn(fa, "هر", false), tok.TK_KW_EACH)
    testing.AssertEqInt(lp.LookupKeywordIn(fa, "در", true), tok.TK_KW_IN)
    en := lp.Load("en")
    testing.AssertEqInt(lp.LookupKeywordIn(en, "until", true), tok.TK_KW_UNTIL)
    testing.AssertEqInt(lp.LookupKeywordIn(en, "to", false), tok.TK_KW_TO)
    testing.AssertEqInt(lp.LookupKeywordIn(en, "by", true), tok.TK_KW_STEP)
    testing.AssertEqInt(lp.LookupKeywordIn(en, "each", true), tok.TK_KW_EACH)
    testing.AssertEqStr(lp.Spelling(fa, tok.TK_KW_STEP), "هر")
    testing.AssertEqStr(lp.Spelling(en, tok.TK_KW_STEP), "by")
    testing.AssertEqStr(lp.Spelling(fa, tok.TK_KW_TO), "تا")
    testing.AssertEqStr(lp.Spelling(fa, tok.TK_KW_UNTIL), "تا")
end

func test_keywords_fa_loose():
    fa := lp.Load("fa")
    testing.AssertEqInt(lp.LookupKeyword(fa, "نادرست چاپ"), tok.TK_KW_PRINTERR)
    testing.AssertEqInt(lp.LookupKeyword(fa, "نادرست\xE2\x80\x8C چاپ"), tok.TK_KW_PRINTERR)
    testing.AssertEqInt(lp.LookupKeyword(fa, "نادرست سرچاپ"), tok.TK_KW_PRINTERRLN)
    testing.AssertEqInt(lp.LookupKeyword(fa, "درخ\xE2\x80\x8Cط"), tok.TK_KW_INLINE)
    testing.AssertEqInt(lp.LookupKeyword(fa, "وارد\xE2\x80\x8Cسازی"), tok.TK_KW_IMPORT)
    testing.AssertEqInt(lp.LookupKeyword(fa, "میانج\xD9\x8A"), tok.TK_KW_INTERFACE)
    testing.AssertEqInt(lp.LookupKeyword(fa, "\xD9\x83ارور"), tok.TK_IDENT)
end

func test_canon_word():
    en := lp.Load("en")
    fa := lp.Load("fa")
    testing.AssertEqStr(lp.CanonWord(fa, "پیوند"), "link")
    testing.AssertEqStr(lp.CanonWord(fa, "ایستا"), "static")
    testing.AssertEqStr(lp.CanonWord(fa, "پویا"), "dynamic")
    testing.AssertEqStr(lp.CanonWord(fa, "چارچوب"), "framework")
    testing.AssertEqStr(lp.CanonWord(fa, "گونه"), "")
    testing.AssertEqStr(lp.CanonWord(en, "link"), "")
    testing.AssertEqStr(lp.CanonWord(fa, "پیوندها"), "")
end

func test_lang_selection():
    testing.AssertEqStr(i18.Lang(), "en")
    i18.SetLang("fa")
    testing.AssertEqStr(i18.Lang(), "fa")
    i18.SetLang("de")
    testing.AssertEqStr(i18.Lang(), "en")
    i18.SetLang("")
    testing.AssertEqStr(i18.Lang(), "en")
end

func test_tr():
    i18.SetLang("en")
    testing.AssertEqStr(i18.Tr("error"), "error")
    testing.AssertEqStr(i18.Tr("unknown type '%s'"), "unknown type '%s'")

    i18.SetLang("fa")
    testing.AssertEqStr(i18.Tr("error"), "خطا")
    testing.AssertEqStr(i18.Tr("warning"), "هشدار")
    testing.AssertEqStr(i18.Tr("note"), "یادداشت")
    testing.AssertEqStr(i18.Tr("help"), "راهنما")
    testing.AssertEqStr(i18.Tr("LEXER"), "واژه‌کاو")
    testing.AssertEqStr(i18.Tr("unknown type '%s'"), "گونه ناشناخته '%s'")
    testing.AssertEqStr(i18.Tr("redefinition of '%s'"), "تعریف دوباره‌ی '%s'")
    testing.AssertEqStr(
        i18.Tr("salam: no input file\n\n"), "salam: فایل ورودی داده نشده است\n\n"
    )
    testing.AssertEqStr(i18.Tr("no such msgid"), "no such msgid")
    testing.AssertEqStr(i18.Tr(""), "")

    i18.SetLang("en")
end

func test_layout_words():
    i18.SetLang("fa")
    testing.AssertEqStr(i18.LayoutWord("دکمه"), "دکمه")
    i18.RegisterLayoutWord("fa", "دکمه", "button")
    i18.RegisterLayoutWord("fa", "جعبه بزرگ", "bigbox")
    testing.AssertEqStr(i18.LayoutWord("دکمه"), "button")
    testing.AssertEqStr(i18.LayoutWord("جعبه\xE2\x80\x8Cبزرگ"), "bigbox")
    testing.AssertEqStr(i18.LayoutWord("جعبهبزرگ"), "bigbox")
    testing.AssertEqStr(i18.LayoutWord("ناشناخته"), "ناشناخته")
    i18.SetLang("en")
end

func test_layout_values():
    i18.SetLang("fa")
    testing.AssertEqStr(i18.LayoutValue("قرمز"), "قرمز")
    i18.RegisterLayoutValue("fa", "قرمز", "red")
    i18.RegisterLayoutValue("*", "آبی", "blue")
    testing.AssertEqStr(i18.LayoutValue("قرمز"), "red")
    testing.AssertEqStr(i18.LayoutValue("آبی"), "blue")
    testing.AssertEqStr(i18.LayoutValue("قر\xE2\x80\x8Cمز"), "قر\xE2\x80\x8Cمز")
    i18.SetLang("en")
    testing.AssertEqStr(i18.LayoutValue("قرمز"), "قرمز")
    testing.AssertEqStr(i18.LayoutValue("آبی"), "blue")
end

func t(x: str): str:
    ret "\x01" + x + "\x02"
end

func test_localize_types_fa():
    i18.SetLang("fa")
    testing.AssertEqStr(i18.LocalizeTypes("cannot cast '" + t("str") + "' to '" + t("i32") + "'"), "cannot cast 'رشته' to 'صحیح'")
    testing.AssertEqStr(i18.LocalizeTypes("type '" + t("int") + "' and '" + t("u32") + "'"), "type 'صحیح' and 'طبیعی'")
    testing.AssertEqStr(i18.LocalizeTypes("got '" + t("f64") + "' and '" + t("void*") + "'"), "got 'اعشار۶۴' and 'تهی*'")
    testing.AssertEqStr(i18.LocalizeTypes("expected '" + t("Vector_str") + "'"), "expected 'وکتور<رشته>'")
    testing.AssertEqStr(i18.LocalizeTypes("'" + t("HashMap<str, Vector<i32>>") + "'"), "'نگاشت<رشته, وکتور<صحیح>>'")
    testing.AssertEqStr(i18.LocalizeTypes("'" + t("HashMap_str_Vector_i64") + "'"), "'نگاشت<رشته, وکتور<صحیح۶۴>>'")
    testing.AssertEqStr(i18.LocalizeTypes("'" + t("Vector<Age>") + "' and '" + t("Age*") + "'"), "'وکتور<Age>' and 'Age*'")
    testing.AssertEqStr(i18.LocalizeTypes("no field 'size' in struct 'Buf'"), "no field 'size' in struct 'Buf'")
    testing.AssertEqStr(i18.LocalizeTypes("use 'name := value'"), "use 'name := value'")
    testing.AssertEqStr(i18.LocalizeTypes("آرگومان 1: '" + t("i32") + "' at line 12"), "آرگومان ۱: 'صحیح' at line ۱۲")
    testing.AssertEqStr(i18.LocalizeTypes("i32-backed value 'x2' size 64"), "i32-backed value 'x2' size ۶۴")
    testing.AssertEqStr(i18.LocalizeTypes("no markers at all"), "no markers at all")
    i18.SetLang("en")
end

func test_localize_types_en():
    i18.SetLang("en")
    testing.AssertEqStr(i18.LocalizeTypes("cannot cast '" + t("str") + "' to '" + t("i32") + "'"), "cannot cast 'str' to 'i32'")
    testing.AssertEqStr(i18.LocalizeTypes("expected '" + t("Vector_str") + "', got '" + t("HashMap_str_i32") + "'"), "expected 'Vector<str>', got 'HashMap<str, i32>'")
    testing.AssertEqStr(i18.LocalizeTypes("unused variable 'my_var' at line 12"), "unused variable 'my_var' at line 12")
end

func test_tr_fa_diagnostics():
    i18.SetLang("fa")
    testing.AssertEqStr(
        i18.Tr("useless cast: this expression already has type '%s'; remove the cast"), "تبدیل بی‌فایده: این عبارت از پیش گونه‌ی '%s' را دارد؛ تبدیل را حذف کنید"
    )
    testing.AssertEqStr(
        i18.Tr("'break %s' must name 1 up to the number of enclosing loops and switches"), "'بشکن %s' باید عددی از ۱ تا تعداد حلقه‌ها و ترابردهای دربرگیرنده باشد"
    )
    i18.SetLang("en")
    testing.AssertEqStr(
        i18.Tr("useless cast: this expression already has type '%s'; remove the cast"), "useless cast: this expression already has type '%s'; remove the cast"
    )
end

func test_translation_arguments():
    testing.AssertEqStr(i18.CheckTranslations(), "")
    i18.SetLang("fa")
    got := co.Format3(
        i18.Tr("non-exhaustive match on enum '%s': missing member%s %s"), co.ArgStr("Color"), co.ArgStr("s"), co.ArgStr("Green, Blue")
    )
    testing.AssertEqStr(got, "همخوان ناقص روی جداشمار 'Color': عضو(های) Green, Blue پوشش داده نشده است")
    got2 := co.Format4(
        i18.Tr("analysis complete: %zu error%s, %zu warning%s"), co.ArgUint(2 as u64), co.ArgStr("s"), co.ArgUint(1 as u64), co.ArgStr("")
    )
    testing.AssertEqStr(got2, "تحلیل کامل شد: 2 خطا، 1 هشدار")
    testing.AssertEqStr(i18.LocalizeTypes(got2), "تحلیل کامل شد: ۲ خطا، ۱ هشدار")
    i18.SetLang("en")
end

func main:
    test_load()
    test_entry_names()
    test_end_spelling()
    test_keywords_en()
    test_keywords_fa()
    test_keywords_fa_removed()
    test_keywords_fa_repeat_header()
    test_keywords_fa_loose()
    test_canon_word()
    test_lang_selection()
    test_tr()
    test_layout_words()
    test_layout_values()
    test_localize_types_fa()
    test_localize_types_en()
    test_tr_fa_diagnostics()
    test_translation_arguments()
    ret testing.Summary()
end
