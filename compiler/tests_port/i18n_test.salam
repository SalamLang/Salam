// Smoke test for the i18n and langpack module ports
// (salam/i18n.salam, salam/langpack.salam).
import tok "../token.salam"
import i18 "../i18n.salam"
import lp "../langpack.salam"
import testing
import os

// --------------------------- langpack ------------------------------------

func test_load():
    testing.AssertEqInt(lp.Load("en"), lp.LP_EN)
    testing.AssertEqInt(lp.Load("fa"), lp.LP_FA)
    testing.AssertEqInt(lp.Load("ar"), lp.LP_AR)
    // unknown codes -> LP_NONE (C returns NULL)
    testing.AssertEqInt(lp.Load("de"), lp.LP_NONE)
    testing.AssertEqInt(lp.Load(""), lp.LP_NONE)
    testing.AssertEqStr(lp.Code(lp.LP_EN), "en")
    testing.AssertEqStr(lp.Code(lp.LP_FA), "fa")
    testing.AssertEqStr(lp.Code(lp.LP_AR), "ar")
    testing.AssertEqStr(lp.Code(lp.LP_NONE), "")
    lp.Free(lp.LP_EN)
end

func test_entry_names():
    testing.AssertEqStr(lp.Entry(lp.LP_EN), "main")
    // exact C byte sequences (k_entry_fa / k_entry_ar in langpack_data.c);
    // note the ar entry point contains U+06CC Farsi Yeh (\xDB\x8C), not
    // U+064A Arabic Yeh - asserted via \x escapes to pin the bytes.
    testing.AssertEqStr(lp.Entry(lp.LP_FA), "\xD8\xA7\xD8\xB5\xD9\x84\xDB\x8C")
    testing.AssertEqStr(
        lp.Entry(lp.LP_AR), "\xD8\xA7\xD9\x84\xD8\xB1\xD8\xA6\xDB\x8C\xD8\xB3\xDB\x8C\xD8\xA9"
    )
    testing.AssertEqStr(lp.EntryFor("fa"), "اصلی")
    testing.AssertEqStr(lp.EntryFor("en"), "main")
    // unknown code -> "main" (C ternary fallback)
    testing.AssertEqStr(lp.EntryFor("xx"), "main")
end

func test_end_spelling():
    testing.AssertEqStr(lp.EndSpelling(lp.Load("en")), "end")
    testing.AssertEqStr(lp.EndSpelling(lp.Load("fa")), "تمام")
    testing.AssertEqStr(lp.EndSpelling(lp.Load("ar")), "نهاية")
    // no pack -> the "end" fallback of langpack_end_spelling()
    testing.AssertEqStr(lp.EndSpelling(lp.LP_NONE), "end")
end

func test_keywords_en():
    en := lp.Load("en")
    // every entry of k_lang_en[] (langpack_data.c), same order
    spellings := [
        "func", "ret", "if", "else", "until", "on", "mut", "const", "type", "struct", "enum", "end",
        "import", "as", "true", "false", "null", "this", "break", "continue", "layout", "package", "print",
        "println", "printerr", "printerrln", "input", "defer", "operator", "extern", "interface", "pub",
        "inline", "noinline", "pure", "noret", "deprecated", "component", "repeat", "impl", "to", "by",
        "each", "in", "with", "match"
    ] as str[46]
    kinds := [
        tok.TK_KW_FUNC, tok.TK_KW_RET, tok.TK_KW_IF, tok.TK_KW_ELSE, tok.TK_KW_UNTIL, tok.TK_KW_ON, tok.TK_KW_MUT,
        tok.TK_KW_CONST, tok.TK_KW_TYPE, tok.TK_KW_STRUCT, tok.TK_KW_ENUM, tok.TK_KW_END, tok.TK_KW_IMPORT,
        tok.TK_KW_AS, tok.TK_KW_TRUE, tok.TK_KW_FALSE, tok.TK_KW_NULL, tok.TK_KW_THIS, tok.TK_KW_BREAK,
        tok.TK_KW_CONTINUE, tok.TK_KW_LAYOUT, tok.TK_KW_PACKAGE, tok.TK_KW_PRINT, tok.TK_KW_PRINTLN,
        tok.TK_KW_PRINTERR, tok.TK_KW_PRINTERRLN, tok.TK_KW_INPUT, tok.TK_KW_DEFER, tok.TK_KW_OPERATOR,
        tok.TK_KW_EXTERN, tok.TK_KW_INTERFACE, tok.TK_KW_PUB, tok.TK_KW_INLINE, tok.TK_KW_NOINLINE, tok.TK_KW_PURE,
        tok.TK_KW_NORET, tok.TK_KW_DEPRECATED, tok.TK_KW_COMPONENT, tok.TK_KW_REPEAT, tok.TK_KW_IMPL,
        tok.TK_KW_TO, tok.TK_KW_STEP, tok.TK_KW_EACH, tok.TK_KW_IN, tok.TK_KW_WITH, tok.TK_KW_MATCH
    ] as int[46]
    n := len(spellings)
    repeat n with i:
        testing.AssertEqInt(lp.LookupKeyword(en, spellings[i]), kinds[i])
    end
    // non-keywords -> TK_IDENT
    testing.AssertEqInt(lp.LookupKeyword(en, "funcx"), tok.TK_IDENT)
    testing.AssertEqInt(lp.LookupKeyword(en, "End"), tok.TK_IDENT)
    testing.AssertEqInt(lp.LookupKeyword(en, ""), tok.TK_IDENT)
    // Persian keywords are not English keywords
    testing.AssertEqInt(lp.LookupKeyword(en, "تابع"), tok.TK_IDENT)
end

func test_keywords_fa():
    fa := lp.Load("fa")
    testing.AssertEqInt(lp.LookupKeyword(fa, "تابع"), tok.TK_KW_FUNC)
    testing.AssertEqInt(lp.LookupKeyword(fa, "بازگشت"), tok.TK_KW_RET)
    testing.AssertEqInt(lp.LookupKeyword(fa, "اگر"), tok.TK_KW_IF)
    testing.AssertEqInt(lp.LookupKeyword(fa, "وگرنه"), tok.TK_KW_ELSE)
    testing.AssertEqInt(lp.LookupKeyword(fa, "تاوقتی"), tok.TK_KW_UNTIL)
    testing.AssertEqInt(lp.LookupKeyword(fa, "متغیر"), tok.TK_KW_MUT)
    testing.AssertEqInt(lp.LookupKeyword(fa, "ثابت"), tok.TK_KW_CONST)
    testing.AssertEqInt(lp.LookupKeyword(fa, "ساختار"), tok.TK_KW_STRUCT)
    testing.AssertEqInt(lp.LookupKeyword(fa, "تمام"), tok.TK_KW_END)
    testing.AssertEqInt(lp.LookupKeyword(fa, "واردکردن"), tok.TK_KW_IMPORT)
    testing.AssertEqInt(lp.LookupKeyword(fa, "بعنوان"), tok.TK_KW_AS)
    testing.AssertEqInt(lp.LookupKeyword(fa, "درست"), tok.TK_KW_TRUE)
    testing.AssertEqInt(lp.LookupKeyword(fa, "نادرست"), tok.TK_KW_FALSE)
    testing.AssertEqInt(lp.LookupKeyword(fa, "بنویس"), tok.TK_KW_PRINT)
    testing.AssertEqInt(lp.LookupKeyword(fa, "چاپ"), tok.TK_KW_PRINTLN)
    testing.AssertEqInt(lp.LookupKeyword(fa, "بسته"), tok.TK_KW_PACKAGE)
    testing.AssertEqInt(lp.LookupKeyword(fa, "عمومی"), tok.TK_KW_PUB)
    testing.AssertEqInt(lp.LookupKeyword(fa, "درون‌خطی"), tok.TK_KW_INLINE)
    testing.AssertEqInt(lp.LookupKeyword(fa, "تکرار"), tok.TK_KW_REPEAT)
    testing.AssertEqInt(lp.LookupKeyword(fa, "تا"), tok.TK_KW_TO)
    testing.AssertEqInt(lp.LookupKeyword(fa, "گام"), tok.TK_KW_STEP)
    testing.AssertEqInt(lp.LookupKeyword(fa, "هر"), tok.TK_KW_EACH)
    testing.AssertEqInt(lp.LookupKeyword(fa, "در"), tok.TK_KW_IN)
    testing.AssertEqInt(lp.LookupKeyword(fa, "با"), tok.TK_KW_WITH)
    testing.AssertEqInt(lp.LookupKeyword(fa, "تطبیق"), tok.TK_KW_MATCH)
    // the Persian pack also spells the logical operators
    testing.AssertEqInt(lp.LookupKeyword(fa, "و"), tok.TK_AND)
    testing.AssertEqInt(lp.LookupKeyword(fa, "یا"), tok.TK_OR)
    // misses
    testing.AssertEqInt(lp.LookupKeyword(fa, "سلام"), tok.TK_IDENT)
    testing.AssertEqInt(lp.LookupKeyword(fa, "func"), tok.TK_IDENT)
end

func test_keywords_fa_loose():
    fa := lp.Load("fa")
    // space inserted: "تا وقتی" strips to the spelling "تاوقتی" (until);
    // the standalone keyword "تا" (to) never matches the full ident
    testing.AssertEqInt(lp.LookupKeyword(fa, "تا وقتی"), tok.TK_KW_UNTIL)
    // space instead of the ZWNJ of "درون‌خطی"
    testing.AssertEqInt(lp.LookupKeyword(fa, "درون خطی"), tok.TK_KW_INLINE)
    // ZWNJ inserted where the table has none: "وارد‌کردن"
    testing.AssertEqInt(lp.LookupKeyword(fa, "وارد\xE2\x80\x8Cکردن"), tok.TK_KW_IMPORT)
    // Arabic Yeh (U+064A) typed instead of Farsi Yeh (U+06CC)
    testing.AssertEqInt(lp.LookupKeyword(fa, "تاوقت\xD9\x8A"), tok.TK_KW_UNTIL)
    // Arabic Kaf (U+0643) typed instead of Keheh (U+06A9): "تکرار"
    testing.AssertEqInt(lp.LookupKeyword(fa, "ت\xD9\x83رار"), tok.TK_KW_REPEAT)
end

func test_keywords_ar():
    ar := lp.Load("ar")
    testing.AssertEqInt(lp.LookupKeyword(ar, "دالة"), tok.TK_KW_FUNC)
    testing.AssertEqInt(lp.LookupKeyword(ar, "أرجع"), tok.TK_KW_RET)
    testing.AssertEqInt(lp.LookupKeyword(ar, "إذا"), tok.TK_KW_IF)
    testing.AssertEqInt(lp.LookupKeyword(ar, "وإلا"), tok.TK_KW_ELSE)
    testing.AssertEqInt(lp.LookupKeyword(ar, "بينما"), tok.TK_KW_UNTIL)
    testing.AssertEqInt(lp.LookupKeyword(ar, "متغير"), tok.TK_KW_MUT)
    testing.AssertEqInt(lp.LookupKeyword(ar, "ثابت"), tok.TK_KW_CONST)
    testing.AssertEqInt(lp.LookupKeyword(ar, "بنية"), tok.TK_KW_STRUCT)
    testing.AssertEqInt(lp.LookupKeyword(ar, "نهاية"), tok.TK_KW_END)
    testing.AssertEqInt(lp.LookupKeyword(ar, "استيراد"), tok.TK_KW_IMPORT)
    testing.AssertEqInt(lp.LookupKeyword(ar, "صواب"), tok.TK_KW_TRUE)
    testing.AssertEqInt(lp.LookupKeyword(ar, "خطأ"), tok.TK_KW_FALSE)
    testing.AssertEqInt(lp.LookupKeyword(ar, "اكتب"), tok.TK_KW_PRINT)
    testing.AssertEqInt(lp.LookupKeyword(ar, "اطبع"), tok.TK_KW_PRINTLN)
    testing.AssertEqInt(lp.LookupKeyword(ar, "حزمة"), tok.TK_KW_PACKAGE)
    testing.AssertEqInt(lp.LookupKeyword(ar, "عام"), tok.TK_KW_PUB)
    testing.AssertEqInt(lp.LookupKeyword(ar, "كرر"), tok.TK_KW_REPEAT)
    testing.AssertEqInt(lp.LookupKeyword(ar, "إلى"), tok.TK_KW_TO)
    testing.AssertEqInt(lp.LookupKeyword(ar, "خطوة"), tok.TK_KW_STEP)
    testing.AssertEqInt(lp.LookupKeyword(ar, "كل"), tok.TK_KW_EACH)
    testing.AssertEqInt(lp.LookupKeyword(ar, "في"), tok.TK_KW_IN)
    testing.AssertEqInt(lp.LookupKeyword(ar, "مع"), tok.TK_KW_WITH)
    testing.AssertEqInt(lp.LookupKeyword(ar, "طابق"), tok.TK_KW_MATCH)
    testing.AssertEqInt(lp.LookupKeyword(ar, "و"), tok.TK_AND)
    testing.AssertEqInt(lp.LookupKeyword(ar, "أو"), tok.TK_OR)
    // misses
    testing.AssertEqInt(lp.LookupKeyword(ar, "مرحبا"), tok.TK_IDENT)
    testing.AssertEqInt(lp.LookupKeyword(ar, "until"), tok.TK_IDENT)
end

func test_keywords_ar_loose():
    ar := lp.Load("ar")
    // Farsi Yeh (U+06CC) typed instead of Arabic Yeh (U+064A): "بينما"
    testing.AssertEqInt(lp.LookupKeyword(ar, "ب\xDB\x8Cنما"), tok.TK_KW_UNTIL)
    // Keheh (U+06A9) typed instead of Arabic Kaf (U+0643): "اكتب"
    testing.AssertEqInt(lp.LookupKeyword(ar, "ا\xDA\xA9تب"), tok.TK_KW_PRINT)
end

func test_canon_word():
    en := lp.Load("en")
    fa := lp.Load("fa")
    ar := lp.Load("ar")
    // k_ctx_fa
    testing.AssertEqStr(lp.CanonWord(fa, "پیوند"), "link")
    testing.AssertEqStr(lp.CanonWord(fa, "ایستا"), "static")
    testing.AssertEqStr(lp.CanonWord(fa, "پویا"), "dynamic")
    testing.AssertEqStr(lp.CanonWord(fa, "چارچوب"), "framework")
    testing.AssertEqStr(lp.CanonWord(fa, "گونه"), "kind")
    // k_ctx_ar
    testing.AssertEqStr(lp.CanonWord(ar, "رابط"), "link")
    testing.AssertEqStr(lp.CanonWord(ar, "ساكن"), "static")
    testing.AssertEqStr(lp.CanonWord(ar, "ديناميكي"), "dynamic")
    testing.AssertEqStr(lp.CanonWord(ar, "إطار"), "framework")
    testing.AssertEqStr(lp.CanonWord(ar, "صنف"), "kind")
    // en has no contextual table (C returns NULL -> "" here); misses too
    testing.AssertEqStr(lp.CanonWord(en, "link"), "")
    testing.AssertEqStr(lp.CanonWord(fa, "پیوندها"), "")
end

// ----------------------------- i18n --------------------------------------

func test_lang_selection():
    // default language is English
    testing.AssertEqStr(i18.Lang(), "en")
    i18.SetLang("fa")
    testing.AssertEqStr(i18.Lang(), "fa")
    i18.SetLang("ar")
    testing.AssertEqStr(i18.Lang(), "ar")
    // anything else falls back to English (C else-branch)
    i18.SetLang("de")
    testing.AssertEqStr(i18.Lang(), "en")
    i18.SetLang("")
    testing.AssertEqStr(i18.Lang(), "en")
end

func test_tr():
    // English: identity, even for known msgids
    i18.SetLang("en")
    testing.AssertEqStr(i18.Tr("error"), "error")
    testing.AssertEqStr(i18.Tr("unknown type '%s'"), "unknown type '%s'")

    // Persian column of k_msgs[]
    i18.SetLang("fa")
    testing.AssertEqStr(i18.Tr("error"), "خطا")
    testing.AssertEqStr(i18.Tr("warning"), "هشدار")
    testing.AssertEqStr(i18.Tr("note"), "یادداشت")
    testing.AssertEqStr(i18.Tr("help"), "راهنما")
    testing.AssertEqStr(i18.Tr("LEXER"), "واژه‌کاو")
    testing.AssertEqStr(i18.Tr("unknown type '%s'"), "نوع ناشناخته '%s'")
    testing.AssertEqStr(i18.Tr("redefinition of '%s'"), "تعریف دوباره‌ی '%s'")
    testing.AssertEqStr(
        i18.Tr("salam: no input file\n\n"), "salam: فایل ورودی داده نشده است\n\n"
    )
    // unknown msgid -> msgid (fallback)
    testing.AssertEqStr(i18.Tr("no such msgid"), "no such msgid")
    testing.AssertEqStr(i18.Tr(""), "")

    // Arabic column of k_msgs[]
    i18.SetLang("ar")
    testing.AssertEqStr(i18.Tr("error"), "خطأ")
    testing.AssertEqStr(i18.Tr("warning"), "تحذير")
    testing.AssertEqStr(i18.Tr("note"), "ملاحظة")
    testing.AssertEqStr(i18.Tr("help"), "مساعدة")
    testing.AssertEqStr(i18.Tr("LEXER"), "المحلّل اللفظي")
    testing.AssertEqStr(i18.Tr("unknown type '%s'"), "نوع غير معروف '%s'")
    testing.AssertEqStr(i18.Tr("redefinition of '%s'"), "إعادة تعريف '%s'")
    testing.AssertEqStr(
        i18.Tr("salam: no input file\n\n"), "salam: لم يُعطَ ملف إدخال\n\n"
    )
    testing.AssertEqStr(i18.Tr("no such msgid"), "no such msgid")

    i18.SetLang("en")
end

func test_layout_words():
    i18.SetLang("fa")
    // nothing registered yet: identity
    testing.AssertEqStr(i18.LayoutWord("دکمه"), "دکمه")
    i18.RegisterLayoutWord("fa", "دکمه", "button")
    i18.RegisterLayoutWord("fa", "جعبه بزرگ", "bigbox")
    i18.RegisterLayoutWord("ar", "زر", "button")
    // exact match, active language only
    testing.AssertEqStr(i18.LayoutWord("دکمه"), "button")
    testing.AssertEqStr(i18.LayoutWord("زر"), "زر") // ar entry, fa active
    // loose match: ZWNJ in the lookup where the alias has a space
    testing.AssertEqStr(i18.LayoutWord("جعبه\xE2\x80\x8Cبزرگ"), "bigbox")
    // and the alias' space may be dropped entirely
    testing.AssertEqStr(i18.LayoutWord("جعبهبزرگ"), "bigbox")
    // unknown -> identity
    testing.AssertEqStr(i18.LayoutWord("ناشناخته"), "ناشناخته")
    i18.SetLang("ar")
    testing.AssertEqStr(i18.LayoutWord("زر"), "button")
    testing.AssertEqStr(i18.LayoutWord("دکمه"), "دکمه") // fa entry, ar active
    i18.SetLang("en")
end

func test_layout_values():
    i18.SetLang("fa")
    testing.AssertEqStr(i18.LayoutValue("قرمز"), "قرمز")
    i18.RegisterLayoutValue("fa", "قرمز", "red")
    i18.RegisterLayoutValue("*", "آبی", "blue") // wildcard language
    testing.AssertEqStr(i18.LayoutValue("قرمز"), "red")
    testing.AssertEqStr(i18.LayoutValue("آبی"), "blue")
    // values have no loose pass: a ZWNJ makes it miss
    testing.AssertEqStr(i18.LayoutValue("قر\xE2\x80\x8Cمز"), "قر\xE2\x80\x8Cمز")
    i18.SetLang("en")
    // fa-only entry no longer applies, wildcard still does
    testing.AssertEqStr(i18.LayoutValue("قرمز"), "قرمز")
    testing.AssertEqStr(i18.LayoutValue("آبی"), "blue")
end

func main:
    test_load()
    test_entry_names()
    test_end_spelling()
    test_keywords_en()
    test_keywords_fa()
    test_keywords_fa_loose()
    test_keywords_ar()
    test_keywords_ar_loose()
    test_canon_word()
    test_lang_selection()
    test_tr()
    test_layout_words()
    test_layout_values()
    os.Exit(testing.Summary())
end
