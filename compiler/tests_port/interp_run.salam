// Equivalence-gate runner for the interp port (see salam/PORTING.md's
// interp row / stage B report). Mirrors the C driver's `driver_interp`
// (compiler/src/driver/driver.c) — i.e. what `salam exec <file> --lang=<L>`
// actually does — closely enough that piping this binary's stdout+stderr
// (merged) is comparable to the reference binary's, matching the repo's own
// exec-test convention (compiler/tools/bash/run-tests.sh: `"$SALAM" exec
// "$f" --no-color --log-level=error --lang="$lang"`, output captured via
// `2>&1`, exit code NOT checked, .out compared as an exact string).
//
// Usage: interp_run <file.salam> [lang]   (lang defaults to "en")
package main

import os
import io
import co "../sal_core.salam"
import tok "../token.salam"
import src "../source.salam"
import lp "../langpack.salam"
import lx "../lexer.salam"
import at "../ast.salam"
import ps "../parser.salam"
import cc "../condcomp.salam"
import sm "../semantic.salam"
import lg "../logger.salam"
import i18 "../i18n.salam"
import ip "../interp.salam"

func main:
    args := os.Args()
    defer args.free()
    if args.len() < 2:
        io.EPrintln("usage: interp_run <file.salam> [lang]")
        os.Exit(2)
    end
    path := args[1]
    lang := args.len() > 2 ? args[2] : "en"

    // --log-level=error --no-color
    quiet := lg.New(lg.LOG_ERROR, false)
    i18.SetLang(lang)
    sm.LayoutSchemaInit(sm.GetStdlibRoot())

    base := lp.Load(lang)
    if base == lp.LP_NONE:
        lg.Log(quiet, lg.PH_DRIVER, lg.LOG_ERROR,
               co.Format1(i18.Tr("unknown language pack '%s'"), co.ArgStr(lang)))
        os.Exit(2)
    end
    entry := lp.Entry(base)

    mut sf := src.New()
    if !src.Load(path, sf):
        lg.Log(quiet, lg.PH_DRIVER, lg.LOG_ERROR,
               co.Format1(i18.Tr("cannot read source file '%s'"), co.ArgStr(path)))
        os.Exit(2)
    end
    modpack := lx.Detect(sf, base)
    mut toks := tok.StreamNew(path)
    lok := lx.Run(quiet, modpack, sf, toks)
    mut a := at.NewAst()
    mut prog := 0
    pok := ps.Run(quiet, toks, a, prog)
    tok.StreamFree(toks)
    mut s := sm.New(quiet, path, lp.Code(modpack))
    sm.SetCc(s, cc.TableBuild("", Vector {} as Vector<str>))
    _ck := cc.PruneProgram(a, quiet, path, s.cctab, prog)
    sok := sm.Run(s, a, prog)
    if !lok || !pok || !sok:
        lg.Log(quiet, lg.PH_DRIVER, lg.LOG_ERROR,
               i18.Tr("build aborted: errors in source"))
        sm.Free(s)
        at.FreeAst(a)
        os.Exit(1)
    end

    mut opts := ip.NewOptions()
    opts.capture = false
    opts.lang = lang
    mut vm := ip.New(quiet, entry, opts)
    rc := ip.Run(vm, a, s, prog)
    ip.Free(vm)
    sm.Free(s)
    at.FreeAst(a)
    os.Exit(rc)
end
