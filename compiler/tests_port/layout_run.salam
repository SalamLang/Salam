package main

import os
import io
import str

include pth "../sal_path.salam"
include tok "../token.salam"
include src "../source.salam"
include lg "../logger.salam"
include dg "../diag.salam"
include i18 "../i18n.salam"
include lp "../langpack.salam"
include lx "../lexer/lexer.salam"
include at "../ast.salam"
include ps "../parser/parser.salam"
include cc "../condcomp.salam"
include sm "../semantic/semantic.salam"
include lo "../sal_layout/sal_layout.salam"

func module_of(path: str): str:
    ret pth.PathStem(path)
end

func dir_of(path: str): str:
    ret pth.PathDir(path)
end

func write_file(path: str, content: str): bool:
    n := io.WriteFile(path, content)
    ret n == str.Len(content)
end

func main:
    args := os.Args()
    defer args.Free()
    mut argi := 1
    mut inline_mode := false
    if args.Len() > argi and str.Equals(args[argi], "inline"):
        inline_mode = true
        argi++
    end
    if args.Len() <= argi:
        io.EPrintln("usage: layout_run [inline] <file1.salam> [file2.salam ...]")
        ret 2
    end

    i18.SetLang("en")
    sm.LayoutSchemaInit(sm.GetStdlibRoot())

    quiet := lg.New(lg.LOG_OFF, false)
    mut diag := dg.NewDefault(2, false, 6)
    mut rc := 0
    minify_ws := true

    n_inputs := args.Len() - argi
    multi := n_inputs > 1

    mut modules := Vector {} as Vector<str>
    mut htmls := Vector {} as Vector<str>
    mut csss := Vector {} as Vector<str>
    mut jss := Vector {} as Vector<str>
    mut heads := Vector {} as Vector<str>
    mut titles := Vector {} as Vector<str>
    mut langs := Vector {} as Vector<str>
    mut dirs := Vector {} as Vector<str>
    defer modules.Free()
    defer htmls.Free()
    defer csss.Free()
    defer jss.Free()
    defer heads.Free()
    defer titles.Free()
    defer langs.Free()
    defer dirs.Free()

    mut i := argi
    until i < args.Len():
        path := args[i]
        i++
        mut sf := src.New()
        if not src.Load(path, sf):
            io.EPrintln("cannot read source file '" + path + "'")
            rc = 2
            continue
        end
        pack := lx.Detect(sf, lp.Load("en"))
        mut toks := tok.StreamNew(path)
        _lok := lx.Run(quiet, pack, sf, toks)
        mut a := at.NewAst()
        mut prog := 0
        _pok := ps.Run(quiet, toks, a, prog)
        tok.StreamFree(toks)
        table := cc.TableBuild("", Vector {} as Vector<str>)
        _ck := cc.PruneProgram(a, quiet, path, table, prog)

        base_dir := dir_of(path)
        eerr := lo.Expand(quiet, pack, table, a, prog, base_dir)
        if eerr > 0:
            rc = 1
        end
        mut s := sm.New(quiet, path, lp.Code(pack))
        sm.SetCc(s, table)
        _sok := sm.Run(s, a, prog)

        lb := lo.FindLayout(a, prog)
        if lb == 0:
            io.EPrintln(path + " has no layout block")
            sm.Free(s)
            at.FreeAst(a)
            continue
        end
        r := lo.Generate(quiet, diag, path, a, lb, minify_ws, lp.Code(pack))
        modules.Push(module_of(path))
        htmls.Push(r.html)
        csss.Push(r.css)
        jss.Push(r.js)
        heads.Push(r.head)
        titles.Push(r.title)
        langs.Push(r.lang)
        dirs.Push(r.dir)
        sm.Free(s)
        at.FreeAst(a)
    end

    if dg.HasErrors(diag):
        rc = 1
    end

    mut mcss := ""
    mut mjs := ""
    repeat modules.Len() in oi:
        mod := modules.Get(oi)
        mut r := lo.NewResult()
        r.html = htmls.Get(oi)
        r.css = csss.Get(oi)
        r.js = jss.Get(oi)
        r.head = heads.Get(oi)
        r.title = titles.Get(oi)
        r.lang = langs.Get(oi)
        r.dir = dirs.Get(oi)
        html_path := mod + ".html"
        if inline_mode:
            _w := write_file(html_path, lo.Document(r, true, "", "", minify_ws))
        else multi:
            _w := write_file(
                html_path, lo.Document(r, false, "style.css", "script.js", minify_ws)
            )
            if str.Len(r.css) > 0:
                mcss += r.css
            end
            if str.Len(r.js) > 0:
                mjs += r.js
            end
        else:
            css_href := str.Len(r.css) > 0 ? mod + ".css" : ""
            js_href := str.Len(r.js) > 0 ? mod + ".js" : ""
            _w := write_file(
                html_path, lo.Document(r, false, css_href, js_href, minify_ws)
            )
            if str.Len(css_href) > 0:
                _w1 := write_file(css_href, r.css)
            end
            if str.Len(js_href) > 0:
                _w2 := write_file(js_href, r.js)
            end
        end
    end
    if multi and not inline_mode:
        if str.Len(mcss) > 0:
            _w3 := write_file("style.css", mcss)
        end
        if str.Len(mjs) > 0:
            _w4 := write_file("script.js", mjs)
        end
    end
    dg.Free(diag)
    ret rc
end
