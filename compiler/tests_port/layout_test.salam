// Smoke test for salam/sal_layout (port of compiler/src/layout's generator:
// layout_expand.c + layout_gen*.c). Builds each snippet through the real
// pipeline (source -> lex -> parse -> condcomp -> lo.Expand -> sm.Run ->
// lo.Generate) and asserts the exact generated HTML/CSS/JS/head strings.
// Expected values were hand-traced from the C source AND cross-checked
// against HEAD `bin/salam layout build` for every case marked [C-verified]
// (compact/minified mode, the CLI default) - see tests_port/layout_run.salam
// for the larger, fully-automated byte-compare gate against the whole
// compiler/tests/{en,fa,ar}/layout(+examples) corpus.
package main

import str
import os
import testing
import tok "../token.salam"
import src "../source.salam"
import lg "../logger.salam"
import dg "../diag.salam"
import i18 "../i18n.salam"
import lp "../langpack.salam"
import lx "../lexer.salam"
import at "../ast.salam"
import ps "../parser.salam"
import cc "../condcomp.salam"
import sm "../semantic.salam"
import lo "../sal_layout.salam"

quiet := lg.New(lg.LOG_OFF, false)

// Runs one layout source through the full pipeline and returns the
// generated Result (compact mode, matching the CLI default / the C
// binary's `layout build` without --no-minify).
func gen(source_text: str): lo.Result:
    mut sf := src.New()
    sf.path = "<test>"
    sf.text = source_text
    sf.len = str.Len(source_text)
    pack := lx.Detect(sf, lp.Load("en"))
    mut toks := tok.StreamNew("<test>")
    _lok := lx.Run(quiet, pack, sf, toks)
    mut a := at.NewAst()
    mut prog := 0
    _pok := ps.Run(quiet, toks, a, prog)
    tok.StreamFree(toks)
    table := cc.TableBuild("", Vector {} as Vector<str>)
    _ck := cc.PruneProgram(a, quiet, "<test>", table, prog)
    _eerr := lo.Expand(quiet, pack, table, a, prog, "")
    mut s := sm.New(quiet, "<test>", lp.Code(pack))
    sm.SetCc(s, table)
    _sok := sm.Run(s, a, prog)
    lb := lo.FindLayout(a, prog)
    mut diag := dg.NewDefault(2, false, 6) // PH_CODEGEN
    r := lo.Generate(quiet, diag, "<test>", a, lb, true)
    dg.Free(diag)
    sm.Free(s)
    at.FreeAst(a)
    ret r
end

func basic_element_cases:
    r1 := gen("layout:\n    heading: size = 3 content = \"Title\" end\nend\n")
    testing.AssertEqStr(r1.html, "<h3>Title</h3>")
    testing.AssertEqStr(r1.css, "")
    testing.AssertEqStr(r1.title, "Salam Page")
    testing.AssertEqStr(r1.lang, "en")
    testing.AssertEqStr(r1.dir, "ltr")

    // heading size clamps to [1, 6].
    r2 := gen(
        "layout:\n    heading: size = 0 content = \"A\" end\n" + "    heading: size = 9 content = \"B\" end\nend\n"
    )
    testing.AssertEqStr(r2.html, "<h1>A</h1><h6>B</h6>")

    // Unrecognized element name -> rendered as <div>, W002 warning recorded
    // (the diag object is internal to gen(); we only assert the fallback
    // tag here - the byte-compare gate exercises the W002 text itself).
    r3 := gen("layout:\n    frobnicate: content = \"x\" end\nend\n")
    testing.AssertEqStr(r3.html, "<div>x</div>")

    // No child elements -> single-line open/content/close; with children ->
    // nested/indented in non-compact mode (compact drops indentation/newlines).
    r4 := gen("layout:\n    box:\n        paragraph: content = \"p\" end\n    end\nend\n")
    testing.AssertEqStr(r4.html, "<div><p>p</p></div>")
end

func css_class_cases:
    // [C-verified] plain css props get one generated class; class sequence
    // starts at "a" and increments per NEW distinct (css,hover,focus,
    // active,before,after) key, in element-emission order.
    r := gen(
        "layout:\n    box:\n        padding = \"10px\"\n        color = \"red\"\n" + "        hover_color = \"blue\"\n" + "        heading: size = 2 content = \"Hi\" end\n" + "        paragraph: content = \"world\" hover_color = \"green\" end\n" + "    end\nend\n"
    )
    testing.AssertEqStr(r.html, `<div class="a"><h2>Hi</h2><p class="b">world</p></div>`)
    testing.AssertEqStr(r.css, ".a{padding:10px;color:red}.a:hover{color:blue}.b:hover{color:green}")

    // Explicit class= (LA_CLASS) is used as-is; no auto class generated.
    r2 := gen("layout:\n    box: class = \"myclass\" color = \"red\" end\nend\n")
    testing.AssertEqStr(r2.html, `<div class="myclass"></div>`)
    testing.AssertEqStr(r2.css, ".myclass{color:red}")

    // Same (css,hover,...) key reuses the same generated class.
    r3 := gen("layout:\n    box: color = \"red\" end\n    box: color = \"red\" end\nend\n")
    testing.AssertEqStr(r3.html, `<div class="a"></div><div class="a"></div>`)
    testing.AssertEqStr(r3.css, ".a{color:red}")
end

func pseudo_and_length_cases:
    // before_/after_ "content" gets quoted; other before_/after_ props are
    // hyphenated ('_'/' ' -> '-'). [C-verified]
    r := gen(
        "layout:\n    box:\n        before_content = \"*\"\n" + "        after_content = \"!\"\n" + "        focus_color = \"green\"\n" + "        active_color = \"navy\"\n    end\nend\n"
    )
    testing.AssertEqStr(r.html, `<div class="a"></div>`)
    testing.AssertEqStr(
        r.css, ".a:focus{color:green}.a:active{color:navy}" + `.a::before{content:"*"}.a::after{content:"!"}`
    )

    // Length values: bare numbers default to px; "N unit" / attached unit
    // both canonicalize; multi-word unit phrases (e.g. "em" spellings) fall
    // through untouched if unrecognized. [C-verified against length_*.salam]
    r2 := gen("layout:\n    box: width = \"10\" height = \"2 em\" end\nend\n")
    testing.AssertEqStr(r2.css, ".a{width:10px;height:2em}")
end

func media_style_script_global_cases:
    // style/global/script/media all run the SAME attrs+class pass as normal
    // elements before their special dispatch (bug-for-bug with the C):
    // "global" below still consumes a class-sequence slot even though its
    // own rule uses the raw selector, not the generated class name.
    // [C-verified]
    r := gen(
        "layout:\n" + "    style: content = \"body{color:red}\" end\n" + "    global: selector = \".x\" color = \"red\" end\n" + "    box: width = \"10 px\" end\n" + "    media: condition = \"(max-width: 600px)\" color = \"blue\" end\n" + "    script: content = \"console.log(1)\" end\nend\n"
    )
    testing.AssertEqStr(r.html, `<div class="b"></div>`)
    testing.AssertEqStr(
        r.css, "body{color:red}.x{color:red}.b{width:10px}" + "@media (max-width: 600px){.body{color:blue}}"
    )
    testing.AssertEqStr(r.js, "console.log(1) ")

    // media nested inside a classed parent uses the PARENT's class as the
    // @media inner selector instead of the literal "body" fallback.
    r2 := gen(
        "layout:\n    box:\n        color = \"red\"\n" + "        media: color = \"blue\" end\n    end\nend\n"
    )
    testing.AssertEqStr(r2.css, ".a{color:red}@media all{.a{color:blue}}")
end

func special_elements_cases:
    // meta/head_link go to `head`, not `html`; attribute order follows the
    // C's fixed field order, empty ("" = C NULL) fields are omitted.
    r := gen(
        "layout:\n    meta: name = \"description\" content = \"hi \\\"there\\\"\" end\n" + "    head_link: rel = \"preload\" href = \"/a.css\" as = \"style\" end\nend\n"
    )
    testing.AssertEqStr(
        r.head, `<meta name="description" content="hi &quot;there&quot;">` + `<link rel="preload" href="/a.css" as="style">`
    )
    testing.AssertEqStr(r.html, "")

    // link/image/input(text+textarea)/canvas/iframe html shapes.
    r2 := gen(
        "layout:\n" + "    link: source = \"/p\" content = \"go\" end\n" + "    image: source = \"/i.png\" content = \"alt text\" end\n" + "    input: type = \"textarea\" content = \"hello\" end\n" + "    input: type = \"text\" required = true end\n" + "    canvas: width = \"100\" height = \"50\" end\n" + "    iframe: src = \"/f\" end\nend\n"
    )
    testing.AssertEqStr(
        r2.html, `<a href="/p">go</a>` + `<img src="/i.png" alt="alt text" />` + "<textarea>hello</textarea>" + `<input type="text" required />` + `<canvas width="100" height="50"></canvas>` + `<iframe src="/f"></iframe>`
    )

    // link with child elements renders as an open/close <a> instead of the
    // single-line form.
    r3 := gen("layout:\n    link: source = \"/x\"\n        paragraph: content = \"y\" end\n    end\nend\n")
    testing.AssertEqStr(r3.html, `<a href="/x"><p>y</p></a>`)
end

func document_attrs_cases:
    // title/lang/dir/favicon/repeat are document-level attrs; localized
    // lang/dir words (fa "farsi"/"right to left") map through i18n + the
    // registry's dyn-value table.
    r := gen(
        "layout:\n    title = \"T\"\n    lang = \"farsi\"\n" + "    dir = \"right to left\"\n    favicon = \"/f.ico\"\n" + "    heading: size = 1 content = \"H\" end\nend\n"
    )
    testing.AssertEqStr(r.title, "T")
    testing.AssertEqStr(r.lang, "fa")
    testing.AssertEqStr(r.dir, "rtl")
    testing.AssertEqStr(r.head, `<link rel="icon" href="/f.ico">`)
    testing.AssertEqStr(r.html, "<h1>H</h1>")

    // repeat= at the document root duplicates the WHOLE body N times.
    r2 := gen("layout:\n    repeat = 3\n    paragraph: content = \"x\" end\nend\n")
    testing.AssertEqStr(r2.html, "<p>x</p><p>x</p><p>x</p>")

    // repeat= on an element duplicates just that element (independently
    // re-evaluated/re-classed each time, per gen_element_n).
    r3 := gen("layout:\n    paragraph: repeat = 2 content = \"y\" end\nend\n")
    testing.AssertEqStr(r3.html, "<p>y</p><p>y</p>")

    // A `content` attribute directly on the layout root is escaped and
    // emitted as its own HTML line (rare document-level content sink).
    r4 := gen("layout:\n    content = \"a & b\"\nend\n")
    testing.AssertEqStr(r4.html, "a &amp; b")
end

func document_wrap_cases:
    r := gen("layout:\n    title = \"Wrap\"\n    box: color = \"red\" end\nend\n")
    // Document() emits an <a>/<script src> whenever an href STRING is
    // given, regardless of whether r.css/r.js are actually non-empty (the
    // C's `else if (css_href)`/`else if (js_href)` only test the pointer,
    // not the content) - this is the multi-page driver mode, where every
    // page unconditionally links the shared style.css/script.js.
    compact_href := lo.Document(r, false, "s.css", "s.js", true)
    testing.AssertEqStr(
        compact_href, `<!doctype html><html lang="en" dir="ltr"><head>` + `<meta charset="utf-8">` + `<meta name="viewport" content="width=device-width, initial-scale=1">` + `<title>Wrap</title><link rel="stylesheet" href="s.css">` + `</head><body><div class="a"></div>` + `<script src="s.js"></script></body></html>`
    )
    compact_inline := lo.Document(r, true, "", "", true)
    testing.AssertEqStr(
        compact_inline, `<!doctype html><html lang="en" dir="ltr"><head>` + `<meta charset="utf-8">` + `<meta name="viewport" content="width=device-width, initial-scale=1">` + `<title>Wrap</title><style>.a{color:red}</style>` + `</head><body><div class="a"></div></body></html>`
    )
    // Non-compact mode wraps with newlines/2-space indentation and no href
    // when both css_href/js_href are "".
    plain := lo.Document(r, false, "", "", false)
    testing.AssertEqStr(
        plain, "<!doctype html>\n<html lang=\"en\" dir=\"ltr\">\n<head>\n" + "  <meta charset=\"utf-8\">\n" + "  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n" + "  <title>Wrap</title>\n</head>\n<body>\n<div class=\"a\"></div>" + "</body>\n</html>\n"
    )
end

func include_component_cases:
    // components: params bind by name, {name} interpolates inside string
    // literals, `content:` is a placeholder sink filled by the invocation's
    // child elements (a "mother" component); a component without a
    // `content:` sink is "single" and rejects invocation content (an error,
    // not asserted here - see the byte-compare gate for E-code coverage).
    r := gen(
        "component card(title = \"T\", body = \"B\"):\n" + "    box:\n" + "        heading: size = 3 content = \"{title}\" end\n" + "        paragraph: content = \"{body}\" end\n" + "    end\nend\n" + "layout:\n    card: title = \"Hi\" end\n    card: end\nend\n"
    )
    testing.AssertEqStr(
        r.html, "<div><h3>Hi</h3><p>B</p></div><div><h3>T</h3><p>B</p></div>"
    )

    // mother component: content: sink placed inside the wrapper, invocation
    // children become the sink's content.
    r2 := gen(
        "component panel():\n    box:\n        content: end\n    end\nend\n" + "layout:\n    panel:\n        paragraph: content = \"inside\" end\n    end\nend\n"
    )
    testing.AssertEqStr(r2.html, "<div><p>inside</p></div>")
end

func main:
    i18.SetLang("en")
    sm.LayoutSchemaInit(sm.GetStdlibRoot())
    basic_element_cases()
    css_class_cases()
    pseudo_and_length_cases()
    media_style_script_global_cases()
    special_elements_cases()
    document_attrs_cases()
    document_wrap_cases()
    include_component_cases()
    os.Exit(testing.Summary())
end
