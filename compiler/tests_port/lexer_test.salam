// Smoke test for salam/lexer.salam (port of compiler/src/lexer/).
// Covers: numbers in all bases, float forms, strings + escapes, UTF-8
// idents, Persian keyword recognition, operators (<<= >> **= ...), comments
// (skipped and kept), spans (line/col/index), statement-end synthesis,
// layout-mode tokens, and language detection.
package main

import os
import testing
import str
import src "../source.salam"
import tok "../token.salam"
import lg "../logger.salam"
import lp "../langpack.salam"
import lx "../lexer.salam"

// Lex `text` with the pack for `code`; fills ts, returns lexer_run's bool.
func lex_into(text: str, code: str, keep: bool, ts &: tok.TokenStream): bool:
    mut sf := src.New()
    sf.path = "test.salam"
    sf.text = text
    sf.len = str.Len(text)
    quiet := lg.New(lg.LOG_OFF, false)
    ret lx.RunEx(quiet, lp.Load(code), sf, keep, ts)
end

func kind_at(ts: tok.TokenStream, i: int): int:
    t := tok.StreamAt(ts, i)
    ret t.kind
end

func main:
    // ---- numbers: all bases -------------------------------------------
    mut ts := tok.StreamNew("t")
    ok := lex_into("255 0xFF 0b1010 0o17 1_000", "en", false, ts)
    testing.AssertTrue(ok)
    // 5 ints + STMT_END + EOF
    testing.AssertEqInt(tok.StreamCount(ts), 7)
    repeat 5 with i:
        testing.AssertEqInt(kind_at(ts, i), tok.TK_INT)
    end
    t0 := tok.StreamAt(ts, 0)
    testing.AssertEqInt(t0.value.kind, tok.TV_INT)
    testing.AssertEqInt64(t0.value.ival as i64, 255 as i64)
    t1 := tok.StreamAt(ts, 1)
    testing.AssertEqInt64(t1.value.ival as i64, 255 as i64)
    t2 := tok.StreamAt(ts, 2)
    testing.AssertEqInt64(t2.value.ival as i64, 10 as i64)
    t3 := tok.StreamAt(ts, 3)
    testing.AssertEqInt64(t3.value.ival as i64, 15 as i64)
    t4 := tok.StreamAt(ts, 4)
    testing.AssertEqInt64(t4.value.ival as i64, 1000 as i64)
    testing.AssertEqStr(t4.lexeme, "1_000")
    testing.AssertEqInt(kind_at(ts, 5), tok.TK_STMT_END)
    testing.AssertEqInt(kind_at(ts, 6), tok.TK_EOF)
    tok.StreamFree(ts)

    // ---- floats: forms + values ---------------------------------------
    mut ts2 := tok.StreamNew("t")
    ok2 := lex_into("3.14 .5 1e10 2.5e-3 1E+4 7f", "en", false, ts2)
    testing.AssertTrue(ok2)
    repeat 6 with i:
        testing.AssertEqInt(kind_at(ts2, i), tok.TK_FLOAT)
    end
    f0 := tok.StreamAt(ts2, 0)
    testing.AssertEqInt(f0.value.kind, tok.TV_FLOAT)
    testing.AssertEqFloat(f0.value.fval, 3.14, 0.000001)
    f1 := tok.StreamAt(ts2, 1)
    testing.AssertEqFloat(f1.value.fval, 0.5, 0.000001)
    f2 := tok.StreamAt(ts2, 2)
    testing.AssertEqFloat(f2.value.fval, 10000000000.0, 1.0)
    f3 := tok.StreamAt(ts2, 3)
    testing.AssertEqFloat(f3.value.fval, 0.0025, 0.0000001)
    f5 := tok.StreamAt(ts2, 5)
    testing.AssertEqFloat(f5.value.fval, 7.0, 0.000001)
    tok.StreamFree(ts2)

    // ---- Persian digits normalize into values -------------------------
    mut ts3 := tok.StreamNew("t")
    _ok3 := lex_into("\xdb\xb4\xdb\xb2", "en", false, ts3) // ۴۲
    testing.AssertEqInt(kind_at(ts3, 0), tok.TK_INT)
    p0 := tok.StreamAt(ts3, 0)
    testing.AssertEqInt64(p0.value.ival as i64, 42 as i64)
    tok.StreamFree(ts3)

    // ---- integer overflow reported ------------------------------------
    mut ts4 := tok.StreamNew("t")
    ok4 := lex_into("99999999999999999999999999", "en", false, ts4)
    testing.AssertFalse(ok4)
    tok.StreamFree(ts4)

    // ---- strings + escapes --------------------------------------------
    mut ts5 := tok.StreamNew("t")
    ok5 := lex_into("\"a\\n\\t\\x41\\u0645b\" \"\"\"tri\nple\"\"\" `raw\\n`", "en", false, ts5)
    testing.AssertTrue(ok5)
    testing.AssertEqInt(kind_at(ts5, 0), tok.TK_STRING)
    s0 := tok.StreamAt(ts5, 0)
    testing.AssertEqInt(s0.value.kind, tok.TV_STRING)
    testing.AssertEqStr(s0.value.sval, "a\n\tA\xd9\x85b")
    testing.AssertEqInt(kind_at(ts5, 1), tok.TK_TRIPLE_STRING)
    s1 := tok.StreamAt(ts5, 1)
    testing.AssertEqStr(s1.value.sval, "tri\nple")
    testing.AssertEqInt(kind_at(ts5, 2), tok.TK_RAW_STRING)
    s2 := tok.StreamAt(ts5, 2)
    testing.AssertEqStr(s2.value.sval, "raw\\n") // raw: backslash-n stays
    tok.StreamFree(ts5)

    // ---- char + unicode char literals ----------------------------------
    mut ts6 := tok.StreamNew("t")
    ok6 := lex_into("'A' '\\n' '\\x41' u\"\\U0001F600\" u'\xd9\x85'", "en", false, ts6)
    testing.AssertTrue(ok6)
    c0 := tok.StreamAt(ts6, 0)
    testing.AssertEqInt(c0.kind, tok.TK_CHAR)
    testing.AssertEqInt(c0.value.kind, tok.TV_CHAR)
    testing.AssertEqInt64(c0.value.ival as i64, 65 as i64)
    c1 := tok.StreamAt(ts6, 1)
    testing.AssertEqInt64(c1.value.ival as i64, 10 as i64)
    c2 := tok.StreamAt(ts6, 2)
    testing.AssertEqInt64(c2.value.ival as i64, 65 as i64)
    c3 := tok.StreamAt(ts6, 3)
    testing.AssertEqInt(c3.kind, tok.TK_UTF8_CHAR)
    testing.AssertEqStr(c3.value.sval, "\xf0\x9f\x98\x80") // 😀 bytes
    c4 := tok.StreamAt(ts6, 4)
    testing.AssertEqInt(c4.kind, tok.TK_UTF8_CHAR)
    testing.AssertEqStr(c4.value.sval, "\xd9\x85")
    tok.StreamFree(ts6)

    // ---- UTF-8 identifier + true/false values -------------------------
    mut ts7 := tok.StreamNew("t")
    ok7 := lex_into("\xd8\xb3\xd9\x84\xd8\xa7\xd9\x85 := true", "en", false, ts7)
    testing.AssertTrue(ok7)
    i0 := tok.StreamAt(ts7, 0)
    testing.AssertEqInt(i0.kind, tok.TK_IDENT)
    testing.AssertEqStr(i0.lexeme, "\xd8\xb3\xd9\x84\xd8\xa7\xd9\x85")
    testing.AssertEqInt(kind_at(ts7, 1), tok.TK_COLON_ASSIGN)
    b0 := tok.StreamAt(ts7, 2)
    testing.AssertEqInt(b0.kind, tok.TK_KW_TRUE)
    testing.AssertEqInt(b0.value.kind, tok.TV_BOOL)
    testing.AssertEqBool(b0.value.bval, true)
    tok.StreamFree(ts7)

    // ---- Persian keyword recognition (fa pack) -------------------------
    // "تابع" = func, "بازگشت" = ret, "تمام" = end
    mut ts8 := tok.StreamNew("t")
    ok8 := lex_into("\xd8\xaa\xd8\xa7\xd8\xa8\xd8\xb9 f: \xd8\xa8\xd8\xa7\xd8\xb2\xda\xaf\xd8\xb4\xd8\xaa \xdb\xb1 \xd8\xaa\xd9\x85\xd8\xa7\xd9\x85", "fa", false, ts8)
    testing.AssertTrue(ok8)
    testing.AssertEqInt(kind_at(ts8, 0), tok.TK_KW_FUNC)
    testing.AssertEqInt(kind_at(ts8, 1), tok.TK_IDENT)
    testing.AssertEqInt(kind_at(ts8, 2), tok.TK_COLON)
    testing.AssertEqInt(kind_at(ts8, 3), tok.TK_KW_RET)
    testing.AssertEqInt(kind_at(ts8, 4), tok.TK_INT)
    testing.AssertEqInt(kind_at(ts8, 5), tok.TK_KW_END)
    tok.StreamFree(ts8)

    // ---- operators incl. shifts/power compounds ------------------------
    mut ts9 := tok.StreamNew("t")
    ok9 := lex_into("a <<= 1 >> 2 >>= 3 **= x ** y ++ -- => ... & && &= | || |= ^ ^= ~ != ! <= < >= >", "en", false, ts9)
    testing.AssertTrue(ok9)
    testing.AssertEqInt(kind_at(ts9, 1), tok.TK_SHL_EQ)
    testing.AssertEqInt(kind_at(ts9, 3), tok.TK_SHR)
    testing.AssertEqInt(kind_at(ts9, 5), tok.TK_SHR_EQ)
    testing.AssertEqInt(kind_at(ts9, 7), tok.TK_POWER_EQ)
    testing.AssertEqInt(kind_at(ts9, 9), tok.TK_POWER)
    testing.AssertEqInt(kind_at(ts9, 11), tok.TK_PLUS_PLUS)
    testing.AssertEqInt(kind_at(ts9, 12), tok.TK_MINUS_MINUS)
    testing.AssertEqInt(kind_at(ts9, 13), tok.TK_FAT_ARROW)
    testing.AssertEqInt(kind_at(ts9, 14), tok.TK_ELLIPSIS)
    testing.AssertEqInt(kind_at(ts9, 15), tok.TK_AMP)
    testing.AssertEqInt(kind_at(ts9, 16), tok.TK_AND)
    testing.AssertEqInt(kind_at(ts9, 17), tok.TK_AMP_EQ)
    testing.AssertEqInt(kind_at(ts9, 18), tok.TK_PIPE)
    testing.AssertEqInt(kind_at(ts9, 19), tok.TK_OR)
    testing.AssertEqInt(kind_at(ts9, 20), tok.TK_PIPE_EQ)
    testing.AssertEqInt(kind_at(ts9, 21), tok.TK_CARET)
    testing.AssertEqInt(kind_at(ts9, 22), tok.TK_CARET_EQ)
    testing.AssertEqInt(kind_at(ts9, 23), tok.TK_TILDE)
    testing.AssertEqInt(kind_at(ts9, 24), tok.TK_NE)
    testing.AssertEqInt(kind_at(ts9, 25), tok.TK_NOT)
    testing.AssertEqInt(kind_at(ts9, 26), tok.TK_LE)
    testing.AssertEqInt(kind_at(ts9, 27), tok.TK_LT)
    testing.AssertEqInt(kind_at(ts9, 28), tok.TK_GE)
    testing.AssertEqInt(kind_at(ts9, 29), tok.TK_GT)
    tok.StreamFree(ts9)

    // ---- comments: skipped by default, kept with keep_comments ---------
    mut ts10 := tok.StreamNew("t")
    ok10 := lex_into("a // line comment   \n/* block */ b", "en", false, ts10)
    testing.AssertTrue(ok10)
    testing.AssertEqInt(kind_at(ts10, 0), tok.TK_IDENT)
    testing.AssertEqInt(kind_at(ts10, 1), tok.TK_STMT_END)
    testing.AssertEqInt(kind_at(ts10, 2), tok.TK_IDENT)
    testing.AssertEqInt(kind_at(ts10, 3), tok.TK_STMT_END)
    testing.AssertEqInt(kind_at(ts10, 4), tok.TK_EOF)
    tok.StreamFree(ts10)

    mut ts11 := tok.StreamNew("t")
    ok11 := lex_into("a // line comment   \n/* block */ b", "en", true, ts11)
    testing.AssertTrue(ok11)
    testing.AssertEqInt(kind_at(ts11, 1), tok.TK_COMMENT_LINE)
    cl := tok.StreamAt(ts11, 1)
    testing.AssertEqStr(cl.lexeme, "// line comment") // right-trimmed
    testing.AssertEqInt(kind_at(ts11, 3), tok.TK_COMMENT_BLOCK)
    cb := tok.StreamAt(ts11, 3)
    testing.AssertEqStr(cb.lexeme, "/* block */")
    tok.StreamFree(ts11)

    // ---- spans: line/col/index ------------------------------------------
    mut ts12 := tok.StreamNew("t")
    ok12 := lex_into("ab cd\n  ef", "en", false, ts12)
    testing.AssertTrue(ok12)
    sp0 := tok.StreamAt(ts12, 0) // "ab" at 1:1
    testing.AssertEqInt(sp0.begin_line as int, 1)
    testing.AssertEqInt(sp0.begin_col as int, 1)
    testing.AssertEqInt(sp0.begin_index as int, 0)
    testing.AssertEqInt(sp0.end_col as int, 3)
    testing.AssertEqInt(sp0.length as int, 2)
    sp1 := tok.StreamAt(ts12, 1) // "cd" at 1:4
    testing.AssertEqInt(sp1.begin_line as int, 1)
    testing.AssertEqInt(sp1.begin_col as int, 4)
    sp2 := tok.StreamAt(ts12, 2) // STMT_END is emitted AFTER the newline
    testing.AssertEqInt(sp2.kind, tok.TK_STMT_END)
    testing.AssertEqStr(sp2.lexeme, "\\n")
    testing.AssertEqInt(sp2.begin_line as int, 2) // C: lx_adv('\n') first
    testing.AssertEqInt(sp2.begin_col as int, 1)
    testing.AssertEqInt(sp2.begin_index as int, 6)
    sp3 := tok.StreamAt(ts12, 3) // "ef" at 2:3
    testing.AssertEqInt(sp3.begin_line as int, 2)
    testing.AssertEqInt(sp3.begin_col as int, 3)
    testing.AssertEqInt(sp3.begin_index as int, 8)
    tok.StreamFree(ts12)

    // ---- statement-end suppression rules --------------------------------
    // No STMT_END after a continuing token (open paren / operator / comma).
    mut ts13 := tok.StreamNew("t")
    ok13 := lex_into("(1 +\n2)\n", "en", false, ts13)
    testing.AssertTrue(ok13)
    // ( 1 + 2 ) STMT_END EOF - no terminator inside the group
    testing.AssertEqInt(tok.StreamCount(ts13), 7)
    testing.AssertEqInt(kind_at(ts13, 4), tok.TK_RPAREN)
    testing.AssertEqInt(kind_at(ts13, 5), tok.TK_STMT_END)
    tok.StreamFree(ts13)

    // EOF without trailing newline still synthesizes STMT_END.
    mut ts14 := tok.StreamNew("t")
    ok14 := lex_into("x", "en", false, ts14)
    testing.AssertTrue(ok14)
    testing.AssertEqInt(kind_at(ts14, 1), tok.TK_STMT_END)
    testing.AssertEqInt(kind_at(ts14, 2), tok.TK_EOF)
    tok.StreamFree(ts14)

    // ---- layout mode ----------------------------------------------------
    mut ts15 := tok.StreamNew("t")
    ok15 := lex_into("layout:\n  title = \"My Page\"\n  header:\n    color = blue\n  end\nend\n", "en", false, ts15)
    testing.AssertTrue(ok15)
    testing.AssertEqInt(kind_at(ts15, 0), tok.TK_KW_LAYOUT)
    testing.AssertEqInt(kind_at(ts15, 1), tok.TK_COLON)
    testing.AssertEqInt(kind_at(ts15, 2), tok.TK_STMT_END)
    la := tok.StreamAt(ts15, 3)
    testing.AssertEqInt(la.kind, tok.TK_LAYOUT_ATTR_NAME)
    testing.AssertEqStr(la.lexeme, "title")
    testing.AssertEqBool(la.layout_mode, true)
    testing.AssertEqInt(kind_at(ts15, 4), tok.TK_ASSIGN)
    testing.AssertEqInt(kind_at(ts15, 5), tok.TK_STRING)
    testing.AssertEqInt(kind_at(ts15, 6), tok.TK_STMT_END)
    le := tok.StreamAt(ts15, 7)
    testing.AssertEqInt(le.kind, tok.TK_LAYOUT_ELEMENT)
    testing.AssertEqStr(le.lexeme, "header")
    tok.StreamFree(ts15)

    // ---- ';' is a lexical error ------------------------------------------
    mut ts16 := tok.StreamNew("t")
    ok16 := lex_into("a; b", "en", false, ts16)
    testing.AssertFalse(ok16)
    tok.StreamFree(ts16)

    // ---- language detection ----------------------------------------------
    testing.AssertEqStr(lx.MarkerCode("// lang: en\n", 12), "en")
    mfa := "// \xd8\xb2\xd8\xa8\xd8\xa7\xd9\x86: \xd9\x81\xd8\xa7\xd8\xb1\xd8\xb3\xdb\x8c\n"
    testing.AssertEqStr(lx.MarkerCode(mfa, str.Len(mfa)), "fa")
    testing.AssertEqStr(lx.MarkerCode("no marker here\n", 15), "")

    mut sfd := src.New()
    sfd.path = "d.salam"
    sfd.text = "\xd8\xaa\xd8\xa7\xd8\xa8\xd8\xb9 f: \xd8\xaa\xd9\x85\xd8\xa7\xd9\x85\n"
    sfd.len = str.Len(sfd.text)
    testing.AssertEqInt(lx.Detect(sfd, lp.Load("en")), lp.LP_FA)

    mut sfe := src.New()
    sfe.path = "e.salam"
    sfe.text = "func f: ret 1 end\n"
    sfe.len = str.Len(sfe.text)
    testing.AssertEqInt(lx.Detect(sfe, lp.Load("en")), lp.LP_EN)

    os.Exit(testing.Summary())
end
