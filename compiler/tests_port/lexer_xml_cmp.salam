// End-to-end equivalence runner for the lexer port: lex a file and print the
// same XML the C compiler emits for `salam <file> --emit-tokens-xml`
// (xml decl + <tokens> dump, written to stdout).
//
// Usage: lexer_xml_cmp <file.salam> [lang]
//   lang: optional fixed langpack code (en/fa/ar); default = detect,
//   mirroring the C driver (langpack_detect with the --lang pack, default
//   "en", as fallback).
package main

import os
import io
import x "../xml.salam"
import tok "../token.salam"
import src "../source.salam"
import lg "../logger.salam"
import lp "../langpack.salam"
import lx "../lexer.salam"

func main:
    args := os.Args()
    defer args.free()
    if args.len() < 2:
        io.EPrintln("usage: lexer_xml_cmp <file.salam> [lang]")
        os.Exit(2)
    end
    path := args[1]
    mut sf := src.New()
    if !src.Load(path, sf):
        io.EPrintln("cannot read " + path)
        os.Exit(2)
    end
    mut pack := 0
    if args.len() > 2:
        pack = lp.Load(args[2])
    else:
        pack = lx.Detect(sf, lp.Load("en"))
    end
    quiet := lg.New(lg.LOG_OFF, false)
    mut ts := tok.StreamNew(path)
    defer tok.StreamFree(ts)
    _ok := lx.Run(quiet, pack, sf, ts)
    mut w := x.New()
    defer x.Free(w)
    x.Decl(w)
    tok.TokensToXml(w, ts)
    print x.Str(w)
end
