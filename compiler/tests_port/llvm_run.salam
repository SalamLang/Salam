// Stage-B verification runner: single-file source -> lex -> parse ->
// condcomp -> sema -> lv.RunOpts, writing the generated .ll to a file.
// Mirrors the exact pipeline already proven byte-exact against HEAD
// `bin/salam llvm` on the "empty main" fixture in llvm_test.salam.
//
// Usage: llvm_run <file.salam> <module> <out.ll>
package main

import os
import io
import tok "../token.salam"
import src "../source.salam"
import lg "../logger.salam"
import lp "../langpack.salam"
import lx "../lexer.salam"
import at "../ast.salam"
import ps "../parser.salam"
import cc "../condcomp.salam"
import sm "../semantic.salam"
import lv "../llvm.salam"

func main:
    args := os.Args()
    defer args.free()
    if args.len() < 4:
        io.EPrintln("usage: llvm_run <file.salam> <module> <out.ll>")
        os.Exit(2)
    end
    path := args[1]
    module := args[2]
    outp := args[3]

    quiet := lg.New(lg.LOG_OFF, false)
    mut sf := src.New()
    if !src.Load(path, sf):
        io.EPrintln("cannot read " + path)
        os.Exit(2)
    end
    pack := lx.Detect(sf, lp.Load("en"))
    mut toks := tok.StreamNew(path)
    _lok := lx.Run(quiet, pack, sf, toks)
    mut a := at.NewAst()
    mut prog := 0
    _pok := ps.Run(quiet, toks, a, prog)
    tok.StreamFree(toks)
    mut s := sm.New(quiet, path, lp.Code(pack))
    sm.SetCc(s, cc.TableBuild("", Vector {} as Vector<str>))
    _ck := cc.PruneProgram(a, quiet, path, s.cctab, prog)
    sok := sm.Run(s, a, prog)
    if !sok:
        io.EPrintln("sema failed for " + path)
        os.Exit(1)
    end

    o := lv.RunOpts(
        quiet, s, a, prog, module, lp.Entry(pack), lv.OptionsDefault(), path
    )
    _w := os.WriteFile(outp, o.ll_src)
    if !o.ok:
        io.EPrintln("LLVM backend: " + o.error)
        os.Exit(1)
    end
    os.Exit(0)
end
