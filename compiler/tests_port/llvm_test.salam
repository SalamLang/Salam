// Smoke test for the salam/llvm.salam port, stage A scope:
// LLVM type strings for every Salam type, global/function declaration IR
// lines, module header/target lines, and the low-level text helpers that
// don't need a live Sema/Ast (mangling, string constants, layout arithmetic).
// Expected text is derived from compiler/src/llvm/*.c AND cross-checked
// against a WSL-built reference `salam llvm` run on tiny fixtures (see the
// investigation notes in salam/PORTING.md's llvm row for the exact commands
// and reference .ll excerpts stage B/C should keep matching).
package main

import str
import os
import testing
import tok "../token.salam"
import src "../source.salam"
import lg "../logger.salam"
import lp "../langpack.salam"
import lx "../lexer.salam"
import at "../ast.salam"
import ps "../parser.salam"
import cc "../condcomp.salam"
import sm "../semantic.salam"
import lv "../llvm.salam"

// Runs one throwaway fixture through the full lex->parse->sema->lv.RunOpts
// pipeline (same recipe as the bottom of this file) and returns the
// generated Output for substring assertions. Caller doesn't free a2/s2 —
// acceptable in a short-lived test process (os.Exit at the end).
func run_fixture(quiet: lg.Logger, stem: str, src_text: str): lv.Output:
    fixture := "compiler/tests_port/tmp_lv/" + stem + ".salam"
    _w := os.WriteFile(fixture, src_text)
    mut sf := src.New()
    testing.AssertMsg(src.Load(fixture, sf), "src.Load failed for " + stem)
    pack := lx.Detect(sf, lp.Load("en"))
    mut toks := tok.StreamNew(fixture)
    _lok := lx.Run(quiet, pack, sf, toks)
    mut a2 := at.NewAst()
    mut prog := 0
    _pok := ps.Run(quiet, toks, a2, prog)
    tok.StreamFree(toks)
    mut s2 := sm.New(quiet, fixture, lp.Code(pack))
    sm.SetCc(s2, cc.TableBuild("", Vector {} as Vector<str>))
    _ck := cc.PruneProgram(a2, quiet, fixture, s2.cctab, prog)
    sok := sm.Run(s2, a2, prog)
    testing.AssertMsg(sok, "sema failed for " + stem)
    o := lv.RunOpts(quiet, s2, a2, prog, stem, lp.Entry(pack), lv.OptionsDefault(),
                    fixture)
    _rm := os.Remove(fixture)
    ret o
end

func main:
    quiet := lg.New(lg.LOG_OFF, false)

    // --- ll_target_ptr_bits / ll_target_is_windows / ll_datalayout ---
    testing.AssertEqInt(lv.TargetPtrBits("x86_64-pc-linux-gnu"), 64)
    testing.AssertEqInt(lv.TargetPtrBits("i686-pc-windows-gnu"), 32)
    testing.AssertEqInt(lv.TargetPtrBits("aarch64-apple-darwin"), 64)
    testing.AssertEqInt(lv.TargetPtrBits("wasm32-wasi"), 32)
    testing.AssertEqInt(lv.TargetPtrBits("riscv64-unknown-linux"), 64)

    testing.AssertTrue(lv.TargetIsWindows("x86_64-pc-windows-msvc"))
    testing.AssertTrue(lv.TargetIsWindows("x86_64-w64-mingw32"))
    testing.AssertFalse(lv.TargetIsWindows("x86_64-unknown-linux-gnu"))

    testing.AssertEqStr(lv.DatalayoutOf("x86_64-pc-linux-gnu"),
                        "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-" +
                        "i128:128-f80:128-n8:16:32:64-S128")
    testing.AssertEqStr(lv.DatalayoutOf("x86_64-w64-windows-gnu"),
                        "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-" +
                        "i128:128-f80:128-n8:16:32:64-S128")
    testing.AssertEqStr(lv.DatalayoutOf("aarch64-apple-darwin"),
                        "e-m:o-i64:64-i128:128-n32:64-S128")
    testing.AssertEqStr(lv.DatalayoutOf("riscv64-unknown-linux-gnu"),
                        "e-m:e-p:64:64-i64:64-i128:128-n32:64-S128")
    testing.AssertEqStr(lv.DatalayoutOf("i686-pc-linux-gnu"),
                        "e-m:e-p:32:32-p270:32:32-p271:32:32-p272:64:64-" +
                        "i128:128-f64:32:64-f80:32-n8:16:32-S128")
    testing.AssertEqStr(lv.DatalayoutOf("thumbv7-unknown-unknown"), "")

    // --- ll_safe_name ---
    testing.AssertEqStr(lv.SafeNameOf("plain_Name.42"), "plain_Name.42")
    testing.AssertEqStr(lv.SafeNameOf("a b"), "a_b")
    testing.AssertEqStr(lv.SafeNameOf(""), "_")
    testing.AssertEqStr(lv.SafeNameOf("سلام"), "________")

    // --- ll_struct_ltype ---
    testing.AssertEqStr(lv.StructLtypeOf("Point"), "%struct.Point")
    testing.AssertEqStr(lv.StructLtypeOf("A_B"), "%struct.A__B")
    testing.AssertEqStr(lv.StructLtypeOf("9x"), "%struct._9x")

    // --- ll_array_dim / ll_array_elem ---
    testing.AssertEqInt(lv.ArrayDimOf("i32[3]") as i32, 3)
    testing.AssertEqInt(lv.ArrayDimOf("f64") as i32, 0)
    testing.AssertEqStr(lv.ArrayElemOf("i32[3]"), "i32")
    testing.AssertEqStr(lv.ArrayElemOf("i32[2][3]"), "i32[3]")

    // --- ll_is_slice_ts / ll_slice_elem ---
    testing.AssertTrue(lv.IsSliceTs("slice<i32>"))
    testing.AssertFalse(lv.IsSliceTs("i32[3]"))
    testing.AssertEqStr(lv.SliceElemOf("slice<i32>"), "i32")
    testing.AssertEqStr(lv.SliceElemOf("slice<Vector<int>>"), "Vector<int>")

    // --- ll_func_ret / ll_func_params ---
    testing.AssertEqStr(lv.FuncRetOf("func(i32, f64) bool"), "bool")
    testing.AssertEqStr(lv.FuncRetOf("func() void"), "void")
    testing.AssertEqStr(lv.FuncRetOf("i32"), "void")
    mut fp := lv.FuncParamsOf("func(i32, f64) bool")
    testing.AssertEqInt(fp.len(), 2)
    testing.AssertEqStr(fp.get(0)[0], "i32")
    testing.AssertEqStr(fp.get(1)[0], "f64")
    fp.free()
    mut fp0 := lv.FuncParamsOf("func() void")
    testing.AssertEqInt(fp0.len(), 0)
    fp0.free()

    // --- ll_zero ---
    testing.AssertEqStr(lv.ZeroOf("str"), "null")
    testing.AssertEqStr(lv.ZeroOf("i32*"), "null")
    testing.AssertEqStr(lv.ZeroOf("bool"), "false")
    testing.AssertEqStr(lv.ZeroOf("f64"), "0.0")
    testing.AssertEqStr(lv.ZeroOf("i32"), "0")
    testing.AssertEqStr(lv.ZeroOf("SomeStruct"), "zeroinitializer")

    // --- ll_is_int / ll_is_signed ---
    testing.AssertTrue(lv.IsIntTs("u64"))
    testing.AssertFalse(lv.IsIntTs("f64"))
    testing.AssertTrue(lv.IsSignedTs("i32"))
    testing.AssertFalse(lv.IsSignedTs("u32"))
    testing.AssertFalse(lv.IsSignedTs("bool"))
    testing.AssertFalse(lv.IsSignedTs("char"))

    // --- ll_variant_members / ll_variant_cname / ll_variant_tag_of ---
    mut vm := lv.VariantMembersOf("Variant<i32, f64, str>")
    testing.AssertEqInt(vm.len(), 3)
    testing.AssertEqStr(vm.get(0)[0], "i32")
    testing.AssertEqStr(vm.get(1)[0], "f64")
    testing.AssertEqStr(vm.get(2)[0], "str")
    vm.free()
    testing.AssertEqStr(lv.VariantCnameOf("Variant<i32, f64, str>"),
                        "%_Salam_variant_i32_f64_str")
    testing.AssertEqInt(lv.VariantTagOf("Variant<i32, f64, str>", "f64"), 1)
    testing.AssertEqInt(lv.VariantTagOf("Variant<i32, f64, str>", "bool"),
                       0 - 1)

    // --- module + fn state, ll_new_tmp / ll_new_lbl / ll_strconst ---
    mut a := at.NewAst()
    defer at.FreeAst(a)
    mut s := sm.New(quiet, "t.salam", "en")
    defer sm.Free(s)

    mut v := lv.NewLv(quiet, "t", "main", "")
    testing.AssertEqInt(v.ptr_bits, 64)
    testing.AssertEqStr(v.usize, "i64")
    testing.AssertTrue(v.ok)

    testing.AssertEqStr(lv.NewTmp(v), "%t0")
    testing.AssertEqStr(lv.NewTmp(v), "%t1")
    testing.AssertEqStr(lv.NewLbl(v, "then"), "L0_then")
    testing.AssertEqStr(lv.NewLbl(v, "else"), "L1_else")

    r1 := lv.StrConst(v, "hi")
    r2 := lv.StrConst(v, "hi")
    r3 := lv.StrConst(v, "bye")
    testing.AssertEqStr(r1, "@.str.0")
    testing.AssertEqStr(r2, "@.str.0")
    testing.AssertEqStr(r3, "@.str.1")

    // --- locals ---
    lv.LocalAddV(v, "x", "%p.x", "i32")
    xi := lv.LocalFind(v, "x")
    testing.AssertTrue(xi >= 0)
    testing.AssertEqStr(lv.LocalAt(v, xi).ptr, "%p.x")
    testing.AssertEqInt(lv.LocalFind(v, "nope"), 0 - 1)

    // --- ll_ty over TypeAt() primitives (Sema pre-seeds TY_VOID..TY_F64) ---
    testing.AssertEqStr(lv.TyOf(v, s, a, "void"), "void")
    testing.AssertEqStr(lv.TyOf(v, s, a, "bool"), "i1")
    testing.AssertEqStr(lv.TyOf(v, s, a, "char"), "i8")
    testing.AssertEqStr(lv.TyOf(v, s, a, "i8"), "i8")
    testing.AssertEqStr(lv.TyOf(v, s, a, "i16"), "i16")
    testing.AssertEqStr(lv.TyOf(v, s, a, "i32"), "i32")
    testing.AssertEqStr(lv.TyOf(v, s, a, "i64"), "i64")
    testing.AssertEqStr(lv.TyOf(v, s, a, "u8"), "i8")
    testing.AssertEqStr(lv.TyOf(v, s, a, "u64"), "i64")
    testing.AssertEqStr(lv.TyOf(v, s, a, "size"), "i64")
    testing.AssertEqStr(lv.TyOf(v, s, a, "f32"), "float")
    testing.AssertEqStr(lv.TyOf(v, s, a, "f64"), "double")
    testing.AssertEqStr(lv.TyOf(v, s, a, "str"), "ptr")
    testing.AssertEqStr(lv.TyOf(v, s, a, "uchar"), "ptr")
    testing.AssertEqStr(lv.TyOf(v, s, a, "i32*"), "ptr")
    testing.AssertEqStr(lv.TyOf(v, s, a, "i32[3]"), "[3 x i32]")
    testing.AssertEqStr(lv.TyOf(v, s, a, "slice<i32>"), "{ ptr, i64 }")
    testing.AssertEqStr(lv.TyOf(v, s, a, "dyn Shape"), "%dyn")
    testing.AssertEqStr(lv.TyOf(v, s, a, "Variant<i32, f64>"),
                        "%_Salam_variant_i32_f64")
    testing.AssertEqStr(lv.TyOf(v, s, a, "Unknown"), "ptr")

    // --- ll_conv (through the ref-based public wrapper) ---
    testing.AssertEqStr(lv.ConvRef(v, s, a, "%t9", "i32", "i32"), "%t9")
    tconv := lv.ConvRef(v, s, a, "5", "i32", "i64")
    testing.AssertTrue(str.StartsWith(tconv, "%t"))

    // --- ll_common ---
    testing.AssertEqStr(lv.CommonTs(v, "i32", "f64"), "f64")
    testing.AssertEqStr(lv.CommonTs(v, "i32", "i64"), "i64")
    testing.AssertEqStr(lv.CommonTs(v, "u32", "i32"), "u32")

    // --- ll_mangle ---
    testing.AssertEqStr(lv.MangleOf(v, s, "", "main", 0), "main")
    testing.AssertEqStr(lv.MangleOf(v, s, "", "helper", 0), "salam_helper")

    // --- ll_zero / ll_array_elem round trip for globals-style init text ---
    testing.AssertEqStr(lv.ZeroOf(lv.ArrayElemOf("i32[3]")), "0")

    lv.FreeLv(v)

    // --- full pipeline: source -> lex -> parse -> condcomp -> sema ->
    // lv.RunOpts, cross-checked against a WSL-built HEAD `salam llvm`
    // reference run on the identical fixture (see PORTING.md's llvm row).
    // Stage A owns the module header/prologue/decls/struct-types/externs/
    // globals; the function BODY is the documented stage-B stub surface
    // (empty main here has only an implicit `ret 0`, so the C and the
    // stub happen to agree byte-for-byte on this one fixture).
    os.Mkdir("compiler/tests_port/tmp_lv")
    fixture := "compiler/tests_port/tmp_lv/t1.salam"
    _w := os.WriteFile(fixture, "func main:\n    ret\nend\n")

    mut sf := src.New()
    testing.AssertTrue(src.Load(fixture, sf))
    pack := lx.Detect(sf, lp.Load("en"))
    mut toks := tok.StreamNew(fixture)
    _lok := lx.Run(quiet, pack, sf, toks)
    mut a2 := at.NewAst()
    defer at.FreeAst(a2)
    mut prog := 0
    _pok := ps.Run(quiet, toks, a2, prog)
    tok.StreamFree(toks)
    mut s2 := sm.New(quiet, fixture, lp.Code(pack))
    sm.SetCc(s2, cc.TableBuild("", Vector {} as Vector<str>))
    _ck := cc.PruneProgram(a2, quiet, fixture, s2.cctab, prog)
    sok := sm.Run(s2, a2, prog)
    testing.AssertTrue(sok)

    o := lv.RunOpts(quiet, s2, a2, prog, "t1", lp.Entry(pack),
                    lv.OptionsDefault(), fixture)
    testing.AssertTrue(o.ok)
    testing.AssertEqStr(o.module_name, "t1")
    testing.AssertContains(o.ll_src, "; ModuleID = 't1'\n")
    testing.AssertContains(o.ll_src, "source_filename = \"t1.salam\"\n")
    testing.AssertContains(o.ll_src,
        "; Salam -> LLVM IR (textual). usize = i64 (64-bit target).\n")
    testing.AssertContains(o.ll_src,
        "declare i32 @printf(ptr, ...) nounwind\n")
    testing.AssertContains(o.ll_src,
        "declare double @llvm.pow.f64(double, double)\n")
    testing.AssertContains(o.ll_src, "%dyn = type { ptr, ptr }\n")
    testing.AssertContains(o.ll_src,
        "define void @salam_panic(ptr %arg0) noreturn nounwind {")
    testing.AssertContains(o.ll_src, "define i32 @main() nounwind {")
    testing.AssertContains(o.ll_src, "ret i32 0")

    sm.Free(s2)
    _rm := os.Remove(fixture)

    // =======================================================================
    // Stage B: expression/statement emission (lv_expr/lv_block_top/lv_stmt
    // and the private helpers they dispatch to). Expected IR text derived
    // from careful reading of codegen_llvm_expr.c/codegen_llvm_stmt.c AND
    // cross-checked against the WSL reference `salam llvm` build (see the
    // llvm row of PORTING.md for the fixture-corpus byte-diff results).
    // =======================================================================

    // --- arithmetic + bitwise + shift ops ---
    src1 := "func main:\n" +
            "    a := 6\n" +
            "    b := a + 2\n" +
            "    c := a - 2\n" +
            "    d := a * 2\n" +
            "    e := a / 2\n" +
            "    f := a % 4\n" +
            "    g := a & 3\n" +
            "    h := a | 8\n" +
            "    ii := a ^ 1\n" +
            "    j := a << 2\n" +
            "    k := a >> 1\n" +
            "    l := ~a\n" +
            "    println b, c, d, e, f, g, h, ii, j, k, l\n" +
            "end\n"
    o1 := run_fixture(quiet, "b_bit1", src1)
    testing.AssertMsg(o1.ok, "b_bit1.ok false: " + o1.error)
    testing.AssertContains(o1.ll_src, "= add nsw i32 ")
    testing.AssertContains(o1.ll_src, "= sub nsw i32 ")
    testing.AssertContains(o1.ll_src, "= mul nsw i32 ")
    testing.AssertContains(o1.ll_src, "= sdiv i32 ")
    testing.AssertContains(o1.ll_src, "= srem i32 ")
    testing.AssertContains(o1.ll_src, "= and i32 ")
    testing.AssertContains(o1.ll_src, "= or i32 ")
    testing.AssertContains(o1.ll_src, "= xor i32 ")
    testing.AssertContains(o1.ll_src, "= shl i32 ")
    testing.AssertContains(o1.ll_src, "= ashr i32 ")

    // --- comparisons (int) ---
    src2 := "func main:\n" +
            "    x := 3\n" +
            "    y := 5\n" +
            "    println x == y, x != y, x < y, x > y, x <= y, x >= y\n" +
            "end\n"
    o2 := run_fixture(quiet, "b_cmp1", src2)
    testing.AssertMsg(o2.ok, "b_cmp1.ok false: " + o2.error)
    testing.AssertContains(o2.ll_src, "icmp eq i32 ")
    testing.AssertContains(o2.ll_src, "icmp ne i32 ")
    testing.AssertContains(o2.ll_src, "icmp slt i32 ")
    testing.AssertContains(o2.ll_src, "icmp sgt i32 ")
    testing.AssertContains(o2.ll_src, "icmp sle i32 ")
    testing.AssertContains(o2.ll_src, "icmp sge i32 ")

    // --- comparisons (float) ---
    src2b := "func main:\n" +
             "    x := 1.5\n" +
             "    y := 2.5\n" +
             "    println x < y, x == y\n" +
             "end\n"
    o2b := run_fixture(quiet, "b_cmpf1", src2b)
    testing.AssertMsg(o2b.ok, "b_cmpf1.ok false: " + o2b.error)
    testing.AssertContains(o2b.ll_src, "fcmp olt double ")
    testing.AssertContains(o2b.ll_src, "fcmp oeq double ")

    // --- if / else-if / else lowering ---
    src3 := "func classify(n: int): str:\n" +
            "    if n < 0:\n" +
            "        ret \"neg\"\n" +
            "    else n == 0:\n" +
            "        ret \"zero\"\n" +
            "    else:\n" +
            "        ret \"pos\"\n" +
            "    end\n" +
            "end\n" +
            "func main:\n" +
            "    println classify(5)\n" +
            "end\n"
    o3 := run_fixture(quiet, "b_if1", src3)
    testing.AssertMsg(o3.ok, "b_if1.ok false: " + o3.error)
    testing.AssertContains(o3.ll_src, "L0_then:")
    testing.AssertContains(o3.ll_src, "L1_endif:")
    testing.AssertContains(o3.ll_src, "L2_else:")
    testing.AssertContains(o3.ll_src, "br i1 ")

    // --- until (while) loop with break/continue ---
    src4 := "func main:\n" +
            "    mut i := 0\n" +
            "    mut t := 0\n" +
            "    until i < 10:\n" +
            "        if i == 3:\n" +
            "            i += 1\n" +
            "            continue\n" +
            "        end\n" +
            "        if i == 8:\n" +
            "            break\n" +
            "        end\n" +
            "        t += i\n" +
            "        i += 1\n" +
            "    end\n" +
            "    println t\n" +
            "end\n"
    o4 := run_fixture(quiet, "b_while1", src4)
    testing.AssertMsg(o4.ok, "b_while1.ok false: " + o4.error)
    testing.AssertContains(o4.ll_src, "wcond:")
    testing.AssertContains(o4.ll_src, "wbody:")
    testing.AssertContains(o4.ll_src, "wend:")

    // --- repeat loop lowering (counter alloca + rcond/rbody/rstep/rend) ---
    src5 := "func main:\n" +
            "    mut s := 0\n" +
            "    repeat 5 with i:\n" +
            "        s += i\n" +
            "    end\n" +
            "    println s\n" +
            "end\n"
    o5 := run_fixture(quiet, "b_rep1", src5)
    testing.AssertMsg(o5.ok, "b_rep1.ok false: " + o5.error)
    testing.AssertContains(o5.ll_src, "rcond:")
    testing.AssertContains(o5.ll_src, "rbody:")
    testing.AssertContains(o5.ll_src, "rstep:")
    testing.AssertContains(o5.ll_src, "rend:")
    testing.AssertContains(o5.ll_src, "alloca i64")

    // --- struct field GEP + array index GEP ---
    src6 := "struct Point:\n" +
            "    pub x: int = 0\n" +
            "    pub y: int = 0\n" +
            "end\n" +
            "func main:\n" +
            "    mut p := Point { x = 3, y = 4 }\n" +
            "    p.x = p.x + 1\n" +
            "    println p.x + p.y\n" +
            "    arr := [1, 2, 3] as int[3]\n" +
            "    println arr[1]\n" +
            "end\n"
    o6 := run_fixture(quiet, "b_struct1", src6)
    testing.AssertMsg(o6.ok, "b_struct1.ok false: " + o6.error)
    testing.AssertContains(o6.ll_src, "%struct.Point = type { i32, i32 }")
    testing.AssertContains(o6.ll_src,
        "getelementptr inbounds %struct.Point, ptr")
    testing.AssertContains(o6.ll_src, "getelementptr inbounds [3 x i32], ptr")

    // --- calling convention: user function + overload mangling ---
    src7 := "func add(a: int, b: int): int:\n" +
            "    ret a + b\n" +
            "end\n" +
            "func main:\n" +
            "    println add(2, 3)\n" +
            "end\n"
    o7 := run_fixture(quiet, "b_call1", src7)
    testing.AssertMsg(o7.ok, "b_call1.ok false: " + o7.error)
    testing.AssertContains(o7.ll_src,
        "define internal i32 @salam_add_i32_i32(i32 %arg0, i32 %arg1)")
    testing.AssertContains(o7.ll_src, "call i32 @salam_add_i32_i32(i32 ")

    // --- match (expr form): arm branches + phi-via-alloca result ---
    src8 := "func main:\n" +
            "    n := 2\n" +
            "    grade := match n:\n" +
            "        1 => \"a\"\n" +
            "        2 => \"b\"\n" +
            "        else => \"c\"\n" +
            "    end\n" +
            "    println grade\n" +
            "end\n"
    o8 := run_fixture(quiet, "b_match1", src8)
    testing.AssertMsg(o8.ok, "b_match1.ok false: " + o8.error)
    testing.AssertContains(o8.ll_src, "marm:")
    testing.AssertContains(o8.ll_src, "mtrap:")
    testing.AssertContains(o8.ll_src, "mend:")
    testing.AssertContains(o8.ll_src, "call void @llvm.trap()")
    testing.AssertContains(o8.ll_src, "unreachable")

    // --- string concat op ---
    src9 := "func main:\n" +
            "    a := \"foo\"\n" +
            "    b := \"bar\"\n" +
            "    c := a + b\n" +
            "    println c\n" +
            "end\n"
    o9 := run_fixture(quiet, "b_str1", src9)
    testing.AssertMsg(o9.ok, "b_str1.ok false: " + o9.error)
    testing.AssertContains(o9.ll_src, "call ptr @salam_ll_strcat(ptr ")
    testing.AssertContains(o9.ll_src,
        "define internal noalias ptr @salam_ll_strcat")

    // --- casts: narrow / widen / int<->float ---
    src10 := "func main:\n" +
             "    a := 250 as int as u8\n" +
             "    b := 3 as f64\n" +
             "    fv := 3.9\n" +
             "    c := fv as int\n" +
             "    println a, b, c\n" +
             "end\n"
    o10 := run_fixture(quiet, "b_cast1", src10)
    testing.AssertMsg(o10.ok, "b_cast1.ok false: " + o10.error)
    testing.AssertContains(o10.ll_src, "trunc i32 ")
    testing.AssertContains(o10.ll_src, "sitofp i32 ")
    testing.AssertContains(o10.ll_src, "fptosi double ")

    // --- ternary + short-circuit && / || ---
    src11 := "func main:\n" +
             "    a := true\n" +
             "    b := false\n" +
             "    x := a && b\n" +
             "    y := a || b\n" +
             "    z := 3 > 1 ? 10 : 20\n" +
             "    println x, y, z\n" +
             "end\n"
    o11 := run_fixture(quiet, "b_tern1", src11)
    testing.AssertMsg(o11.ok, "b_tern1.ok false: " + o11.error)
    testing.AssertContains(o11.ll_src, "sc_rhs")
    testing.AssertContains(o11.ll_src, "sc_short")
    testing.AssertContains(o11.ll_src, "tern_then")
    testing.AssertContains(o11.ll_src, "tern_else")
    testing.AssertContains(o11.ll_src, "= phi i1 [ false, %")
    testing.AssertContains(o11.ll_src, "= phi i1 [ true, %")

    // --- incdec + defer ordering ---
    src12 := "func f(): int:\n" +
             "    mut n := 0\n" +
             "    defer n++\n" +
             "    n = 5\n" +
             "    ret n\n" +
             "end\n" +
             "func main:\n" +
             "    println f()\n" +
             "end\n"
    o12 := run_fixture(quiet, "b_defer1", src12)
    testing.AssertMsg(o12.ok, "b_defer1.ok false: " + o12.error)
    testing.AssertContains(o12.ll_src, "= add nsw i32 ")

    // ===== stage C: native toolchain glue (llvm_native.c / =====
    // ===== driver/llvm_toolchain.c) =====

    // --- NativeAvailable: this port is verified under WSL, which always
    // has clang/opt/lli on PATH (see PORTING.md's llvm row) ---
    testing.AssertTrue(lv.NativeAvailable())

    // --- default Options (no triple, no links, O0): the exact "native:
    // clang %s -lm -o %s" convention driver_llvm's own log line names ---
    mut optsA := lv.OptionsDefault()
    optsA.output_mode = lv.LV_OUT_EXEC
    optsA.output_file = "a.out"
    scriptA := lv.NativeBuildScript("a.ll", optsA)
    testing.AssertContains(scriptA, "IN='a.ll'\n")
    testing.AssertContains(scriptA, "OUT='a.out'\n")
    testing.AssertContains(scriptA, "-O0 \"$IN\" -lm -o \"$OUT\"\n")
    testing.AssertFalse(str.Contains(scriptA, "--target="))
    testing.AssertFalse(str.Contains(scriptA, "-fuse-ld=lld"))
    testing.AssertFalse(str.Contains(scriptA, "SYSROOT="))

    // --- windows target: -fuse-ld=lld, no -lm ---
    mut optsW := lv.OptionsDefault()
    optsW.output_mode = lv.LV_OUT_EXEC
    optsW.output_file = "a.exe"
    optsW.target_triple = "x86_64-w64-windows-gnu"
    scriptW := lv.NativeBuildScript("a.ll", optsW)
    testing.AssertContains(scriptW, "--target=x86_64-w64-windows-gnu")
    testing.AssertContains(scriptW, "-fuse-ld=lld")
    testing.AssertFalse(str.Contains(scriptW, "-lm"))

    // --- wasm target: no -fuse-ld=lld, no -lm (the driver's documented
    // "wasm: clang --target=wasm32-wasi ..." variant) ---
    mut optsWasm := lv.OptionsDefault()
    optsWasm.output_mode = lv.LV_OUT_EXEC
    optsWasm.output_file = "a.wasm"
    optsWasm.target_triple = "wasm32-wasi"
    scriptWasm := lv.NativeBuildScript("a.ll", optsWasm)
    testing.AssertContains(scriptWasm, "--target=wasm32-wasi")
    testing.AssertFalse(str.Contains(scriptWasm, "-fuse-ld=lld"))
    testing.AssertFalse(str.Contains(scriptWasm, "-lm"))

    // --- opt level, debug_info, sysroot, verify_module ---
    mut optsO := lv.OptionsDefault()
    optsO.output_mode = lv.LV_OUT_EXEC
    optsO.output_file = "a.out"
    optsO.opt_level = lv.LV_OPT_O2
    optsO.debug_info = true
    optsO.sysroot = "/opt/sysroot"
    optsO.verify_module = true
    scriptO := lv.NativeBuildScript("a.ll", optsO)
    testing.AssertContains(scriptO, "-passes=verify -disable-output \"$IN\"\n")
    testing.AssertContains(scriptO, "-O2")
    testing.AssertContains(scriptO, " -g")
    testing.AssertContains(scriptO, "SYSROOT='/opt/sysroot'\n")
    testing.AssertContains(scriptO, "--sysroot=\"$SYSROOT\"")

    // --- link_libs / link_kinds: bare name, "-lname"-shaped, framework,
    // static, and a path/dotted spec take four different code paths ---
    mut optsL := lv.OptionsDefault()
    optsL.output_mode = lv.LV_OUT_EXEC
    optsL.output_file = "a.out"
    optsL.link_libs.push("sqlite3")
    optsL.link_kinds.push("")
    optsL.link_libs.push("Cocoa")
    optsL.link_kinds.push("framework")
    optsL.link_libs.push("m")
    optsL.link_kinds.push("static")
    optsL.link_libs.push("./vendor/libfoo.a")
    optsL.link_kinds.push("")
    scriptL := lv.NativeBuildScript("a.ll", optsL)
    testing.AssertContains(scriptL, " -l'sqlite3'")
    testing.AssertContains(scriptL, " -framework 'Cocoa'")
    testing.AssertContains(scriptL, " -Wl,-Bstatic -l'm' -Wl,-Bdynamic")
    testing.AssertContains(scriptL, " './vendor/libfoo.a'")

    // static + windows must NOT get -Wl,-Bstatic/-Bdynamic (only non-win)
    mut optsLW := lv.OptionsDefault()
    optsLW.output_mode = lv.LV_OUT_EXEC
    optsLW.output_file = "a.exe"
    optsLW.target_triple = "x86_64-w64-windows-gnu"
    optsLW.link_libs.push("m")
    optsLW.link_kinds.push("static")
    scriptLW := lv.NativeBuildScript("a.ll", optsLW)
    testing.AssertFalse(str.Contains(scriptLW, "-Wl,-Bstatic"))
    testing.AssertContains(scriptLW, " -l'm'")

    // --- other output modes: ASM/OBJ use clang -S/-c; BITCODE uses opt;
    // JIT pipes through opt|lli (or bare lli at O0); IR re-optimizes
    // in place (or "true" as a no-op at O0 without verify) ---
    mut optsAsm := lv.OptionsDefault()
    optsAsm.output_mode = lv.LV_OUT_ASM
    optsAsm.output_file = "a.s"
    scriptAsm := lv.NativeBuildScript("a.ll", optsAsm)
    testing.AssertContains(scriptAsm, "-S \"$IN\" -o \"$OUT\"\n")

    mut optsObj := lv.OptionsDefault()
    optsObj.output_mode = lv.LV_OUT_OBJ
    optsObj.output_file = "a.o"
    scriptObj := lv.NativeBuildScript("a.ll", optsObj)
    testing.AssertContains(scriptObj, "-c \"$IN\" -o \"$OUT\"\n")

    mut optsBc := lv.OptionsDefault()
    optsBc.output_mode = lv.LV_OUT_BITCODE
    optsBc.output_file = "a.bc"
    scriptBc := lv.NativeBuildScript("a.ll", optsBc)
    testing.AssertContains(scriptBc, "opt")
    testing.AssertContains(scriptBc, "\"$IN\" -o \"$OUT\"\n")

    mut optsJit0 := lv.OptionsDefault()
    optsJit0.output_mode = lv.LV_OUT_JIT
    scriptJit0 := lv.NativeBuildScript("a.ll", optsJit0)
    testing.AssertContains(scriptJit0, "lli")
    testing.AssertContains(scriptJit0, "\"$IN\"\n")
    testing.AssertFalse(str.Contains(scriptJit0, "OUT="))

    mut optsJit2 := lv.OptionsDefault()
    optsJit2.output_mode = lv.LV_OUT_JIT
    optsJit2.opt_level = lv.LV_OPT_O2
    scriptJit2 := lv.NativeBuildScript("a.ll", optsJit2)
    testing.AssertContains(scriptJit2, "-o - | ")
    testing.AssertContains(scriptJit2, "lli")

    mut optsIr0 := lv.OptionsDefault()
    optsIr0.output_mode = lv.LV_OUT_IR
    scriptIr0 := lv.NativeBuildScript("a.ll", optsIr0)
    testing.AssertContains(scriptIr0, "true\n")
    testing.AssertFalse(str.Contains(scriptIr0, "OUT="))

    mut optsIr2 := lv.OptionsDefault()
    optsIr2.output_mode = lv.LV_OUT_IR
    optsIr2.opt_level = lv.LV_OPT_O3
    scriptIr2 := lv.NativeBuildScript("a.ll", optsIr2)
    testing.AssertContains(scriptIr2, "-O3 -S \"$IN\" -o \"$IN\"\n")

    // --- real link + run, end to end, through NativeRun itself (not just
    // the script builder) — a tiny hand-written .ll compiled and executed
    // via clang, confirming NativeRun's rc + file-cleanup contract ---
    ll_ok_src := "; ModuleID = 'nrun_ok'\n" +
        "@.str.0 = private unnamed_addr constant [5 x i8] c\"hi!\\0A\\00\"\n" +
        "declare i32 @printf(ptr, ...)\n" +
        "define i32 @main() {\n" +
        "entry:\n" +
        "  %r = call i32 (ptr, ...) @printf(ptr @.str.0)\n" +
        "  ret i32 0\n" +
        "}\n"
    ll_ok_path := "compiler/tests_port/tmp_lv/nrun_ok.ll"
    exe_ok_path := "compiler/tests_port/tmp_lv/nrun_ok_exe"
    _wok := os.WriteFile(ll_ok_path, ll_ok_src)
    mut optsRun := lv.OptionsDefault()
    optsRun.output_mode = lv.LV_OUT_EXEC
    optsRun.output_file = exe_ok_path
    rc_ok := lv.NativeRun(quiet, ll_ok_path, optsRun)
    testing.AssertEqInt(rc_ok, 0)
    testing.AssertFalse(os.Exists(ll_ok_path + ".run.sh"))
    testing.AssertEqStr(os.Output(exe_ok_path), "hi!\n")
    _rmok1 := os.Remove(ll_ok_path)
    _rmok2 := os.Remove(exe_ok_path)

    // invalid IR -> clang fails -> nonzero rc, no crash
    ll_bad_path := "compiler/tests_port/tmp_lv/nrun_bad.ll"
    exe_bad_path := "compiler/tests_port/tmp_lv/nrun_bad_exe"
    _wbad := os.WriteFile(ll_bad_path, "this is not valid llvm ir\n")
    mut optsBad := lv.OptionsDefault()
    optsBad.output_mode = lv.LV_OUT_EXEC
    optsBad.output_file = exe_bad_path
    rc_bad := lv.NativeRun(quiet, ll_bad_path, optsBad)
    testing.AssertTrue(rc_bad != 0)
    testing.AssertFalse(os.Exists(exe_bad_path))
    _rmbad := os.Remove(ll_bad_path)

    os.Exit(testing.Summary())
end
