// Smoke test for the logger module port (salam/logger.salam).

import lg "../logger.salam"
import testing
import os

func test_level_names():
    testing.AssertEqStr(lg.LevelName(lg.LOG_TRACE), "TRACE")
    testing.AssertEqStr(lg.LevelName(lg.LOG_DEBUG), "DEBUG")
    testing.AssertEqStr(lg.LevelName(lg.LOG_INFO), "INFO")
    testing.AssertEqStr(lg.LevelName(lg.LOG_WARN), "WARN")
    testing.AssertEqStr(lg.LevelName(lg.LOG_ERROR), "ERROR")
    testing.AssertEqStr(lg.LevelName(lg.LOG_OFF), "OFF")
    testing.AssertEqStr(lg.LevelName(99), "?")
end

func test_phase_names():
    testing.AssertEqStr(lg.PhaseName(lg.PH_DRIVER), "DRIVER")
    testing.AssertEqStr(lg.PhaseName(lg.PH_CLI), "CLI")
    testing.AssertEqStr(lg.PhaseName(lg.PH_LEXER), "LEXER")
    testing.AssertEqStr(lg.PhaseName(lg.PH_PARSER), "PARSER")
    testing.AssertEqStr(lg.PhaseName(lg.PH_SEMANTIC), "SEMANTIC")
    testing.AssertEqStr(lg.PhaseName(lg.PH_IR), "IR")
    testing.AssertEqStr(lg.PhaseName(lg.PH_CODEGEN), "CODEGEN")
    testing.AssertEqStr(lg.PhaseName(42), "?")
end

func test_level_from_string():
    mut out := -1
    testing.AssertTrue(lg.LevelFromString("trace", out))
    testing.AssertEqInt(out, lg.LOG_TRACE)
    testing.AssertTrue(lg.LevelFromString("debug", out))
    testing.AssertEqInt(out, lg.LOG_DEBUG)
    testing.AssertTrue(lg.LevelFromString("info", out))
    testing.AssertEqInt(out, lg.LOG_INFO)
    testing.AssertTrue(lg.LevelFromString("warn", out))
    testing.AssertEqInt(out, lg.LOG_WARN)
    testing.AssertTrue(lg.LevelFromString("warning", out))
    testing.AssertEqInt(out, lg.LOG_WARN)
    testing.AssertTrue(lg.LevelFromString("error", out))
    testing.AssertEqInt(out, lg.LOG_ERROR)
    testing.AssertTrue(lg.LevelFromString("off", out))
    testing.AssertEqInt(out, lg.LOG_OFF)
    // case-insensitive, like the C strcasecmp/_stricmp path
    testing.AssertTrue(lg.LevelFromString("ERROR", out))
    testing.AssertEqInt(out, lg.LOG_ERROR)
    testing.AssertTrue(lg.LevelFromString("Warning", out))
    testing.AssertEqInt(out, lg.LOG_WARN)
    // unknown names are rejected and leave out untouched
    out = -1
    testing.AssertFalse(lg.LevelFromString("verbose", out))
    testing.AssertEqInt(out, -1)
    testing.AssertFalse(lg.LevelFromString("", out))
end

func test_state():
    mut logger := lg.New(lg.LOG_INFO, false)
    testing.AssertEqInt(lg.GetLevel(logger), lg.LOG_INFO)
    lg.SetLevel(logger, lg.LOG_ERROR)
    testing.AssertEqInt(lg.GetLevel(logger), lg.LOG_ERROR)
    testing.AssertTrue(logger.timestamps)
    lg.SetTimestamps(logger, false)
    testing.AssertFalse(logger.timestamps)
    testing.AssertFalse(logger.diag_rich)
    lg.SetDiagSource(logger, "func main: end", 14, 0, 0) // 0 = diag.DIAG_STYLE_RUST / diag.DIAG_FORMAT_HUMAN
    testing.AssertTrue(logger.diag_rich)
    testing.AssertEqInt(logger.src_len, 14)
    lg.SetDiagSource(logger, "", 0, 0, 0)
    testing.AssertFalse(logger.diag_rich)
    lg.Free(logger)
end

func test_filtering():
    mut logger := lg.New(lg.LOG_WARN, false)
    testing.AssertFalse(lg.Enabled(logger, lg.LOG_TRACE))
    testing.AssertFalse(lg.Enabled(logger, lg.LOG_DEBUG))
    testing.AssertFalse(lg.Enabled(logger, lg.LOG_INFO))
    testing.AssertTrue(lg.Enabled(logger, lg.LOG_WARN))
    testing.AssertTrue(lg.Enabled(logger, lg.LOG_ERROR))
    lg.SetLevel(logger, lg.LOG_TRACE)
    testing.AssertTrue(lg.Enabled(logger, lg.LOG_TRACE))
    testing.AssertTrue(lg.Enabled(logger, lg.LOG_ERROR))
    // LOG_OFF silences everything, even LOG_OFF-level probes
    lg.SetLevel(logger, lg.LOG_OFF)
    testing.AssertFalse(lg.Enabled(logger, lg.LOG_ERROR))
    testing.AssertFalse(lg.Enabled(logger, lg.LOG_OFF))
end

func test_format_plain():
    mut logger := lg.New(lg.LOG_TRACE, false)
    lg.SetTimestamps(logger, false)
    testing.AssertEqStr(
        lg.FormatPlain(logger, lg.PH_DRIVER, lg.LOG_ERROR, "", 0, 0, "build aborted: errors in source"),
        "[DRIVER][ERROR] build aborted: errors in source")
    testing.AssertEqStr(
        lg.FormatPlain(logger, lg.PH_LEXER, lg.LOG_WARN, "main.salam", 3, 7, "W123: odd token"),
        "[LEXER][WARN] W123: odd token (main.salam:3:7)")
    // colored: level name wrapped in the ANSI color for the level
    logger.color = true
    testing.AssertEqStr(
        lg.FormatPlain(logger, lg.PH_SEMANTIC, lg.LOG_INFO, "", 0, 0, "checked"),
        "[SEMANTIC][\x1b[32mINFO\x1b[0m] checked")
    testing.AssertEqStr(
        lg.FormatPlain(logger, lg.PH_CODEGEN, lg.LOG_ERROR, "", 0, 0, "boom"),
        "[CODEGEN][\x1b[31mERROR\x1b[0m] boom")
end

func main:
    test_level_names()
    test_phase_names()
    test_level_from_string()
    test_state()
    test_filtering()
    test_format_plain()

    // Real emission demo: timestamped lines on stderr, exactly like the C
    // logger ("[2026-…][DRIVER][ERROR] …"). TRACE/DEBUG are filtered out.
    logger := lg.New(lg.LOG_INFO, false)
    lg.Log(logger, lg.PH_DRIVER, lg.LOG_TRACE, "invisible trace")
    lg.Log(logger, lg.PH_DRIVER, lg.LOG_DEBUG, "invisible debug")
    lg.Log(logger, lg.PH_DRIVER, lg.LOG_INFO, "build started")
    lg.Log(logger, lg.PH_LEXER, lg.LOG_WARN, "W031: suspicious character")
    lg.LogAt(logger, lg.PH_PARSER, lg.LOG_ERROR, "app.salam", 12, 5, "E012: expected 'end'")
    lg.Log(logger, lg.PH_DRIVER, lg.LOG_ERROR, "build aborted: errors in source")

    os.Exit(testing.Summary())
end
