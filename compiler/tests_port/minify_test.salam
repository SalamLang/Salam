// Smoke test for salam/minify (port of compiler/src/minify/minify.c).
// Expected strings derived by hand-tracing minify.c; every case marked
// [C-verified] was additionally run through the C binary itself
// (`bin/salam layout build` with the snippet as style/script content - // compact minify is on by default) and the output matched byte-for-byte.
// The e2e block at the bottom repeats that comparison live.
import mn "../minify.salam"
import testing
import io
import os

func js_cases:
    // Basic whitespace collapse: only word-word (and pair) gaps keep a space.
    testing.AssertEqStr(mn.Js("var x = 1 ;"), "var x=1;")
    testing.AssertEqStr(mn.Js("  a"), "a")
    testing.AssertEqStr(mn.Js(""), "")
    testing.AssertEqStr(mn.Js("   \n\t  "), "")

    // Line + block comments stripped; joins never glue tokens ambiguously.
    testing.AssertEqStr(mn.Js("a = 1; // note\nb = 2;"), "a=1;b=2;")
    testing.AssertEqStr(mn.Js("a /* c */ + b"), "a+b")
    testing.AssertEqStr(mn.Js("a /* x */ b"), "a b")
    // [C-verified] "1 .toString(); a/*x*/+b; e /*y*/ f;" -> digit-dot space
    // kept, comment joins re-space word-word only.
    testing.AssertEqStr(
        mn.Js("1 .toString(); a/*x*/+b; e /*y*/ f;"), "1 .toString();a+b;e f;"
    )
    // [C-verified] comment-only lines vanish, word-word newline -> one space,
    // trailing whitespace trimmed.
    testing.AssertEqStr(mn.Js("a = b\n// only comment\n\n\nc = d  "), "a=b c=d")
    // Unterminated block comment swallows the rest (strstr NULL -> n).
    testing.AssertEqStr(mn.Js("a /* xx"), "a")

    // Strings: contents (spaces, escapes) preserved byte-for-byte.
    testing.AssertEqStr(
        mn.Js("let s = \"a  b \\\" c\";"), "let s=\"a  b \\\" c\";"
    )
    testing.AssertEqStr(mn.Js("s = 'a\\\\' + 'b'"), "s='a\\\\'+'b'")
    // Unterminated string: copied to end of input, no crash.
    testing.AssertEqStr(mn.Js("let s = 'abc"), "let s='abc")
    // Trailing lone backslash inside a string (i + 1 == n edge).
    testing.AssertEqStr(mn.Js("s='a\\"), "s='a\\")

    // Template literals: body AND ${ } holes preserved verbatim
    // (nested templates included). [C-verified]
    testing.AssertEqStr(
        mn.Js("let u = `x ${ a + `in ${ q } er` } y`; typeof /a[/]b/gi;"), "let u=`x ${ a + `in ${ q } er` } y`;typeof/a[/]b/gi;"
    )
    testing.AssertEqStr(mn.Js("t = `a\\`b  c`;"), "t=`a\\`b  c`;")

    // Regex vs division. [C-verified] cases from the C binary:
    testing.AssertEqStr(
        mn.Js("return /ab/.test(s); // tail comment"), "return/ab/.test(s);"
    )
    testing.AssertEqStr(
        mn.Js("let s = 'a  b'; let t = (a) / c; d = x /e/ f;"), "let s='a  b';let t=(a)/c;d=x/e/f;"
    )
    testing.AssertEqStr(
        mn.Js("if (a) /re/.test(b); else /s w/i.test(c);"), "if(a)/re/.test(b);else/s w/i.test(c);"
    )
    // Start of file: regex allowed.
    testing.AssertEqStr(mn.Js("/^x/.test(s)"), "/^x/.test(s)")
    // '[' class: '/' inside [ ] does not close the regex.
    testing.AssertEqStr(mn.Js("r = /[/]/g;"), "r=/[/]/g;")
    // Keyword must be a whole word: "creturn" is an identifier -> division.
    testing.AssertEqStr(mn.Js("x = creturn / a / 2"), "x=creturn/a/2")
    // "in" is in the kw list -> regex position, inner space preserved.
    testing.AssertEqStr(mn.Js("x in /a b/"), "x in/a b/")
    // Unclosed regex stops at newline; the copied prefix then re-minifies.
    testing.AssertEqStr(mn.Js("a = /x\ny/"), "a=/x y/")

    // Operator-pair protection: a space survives only when gluing would form
    // ++ -- ** => ?? ?. .. etc. [C-verified] "a++ + b; i + ++j; a ** b; c * *d;"
    testing.AssertEqStr(
        mn.Js("a++ + b; i + ++j; a ** b; c * *d;"), "a++ +b;i+ ++j;a**b;c* *d;"
    )
    testing.AssertEqStr(mn.Js("a - -b"), "a- -b")
    testing.AssertEqStr(mn.Js("a = > b"), "a= >b")
    testing.AssertEqStr(mn.Js("x => y"), "x=>y")
    testing.AssertEqStr(mn.Js("a ? ?b : c"), "a? ?b:c")
    testing.AssertEqStr(mn.Js("a ? .b : c"), "a? .b:c")
    // '/' before a comment starter must keep the space ("/ /" and "/ *").
    testing.AssertEqStr(mn.Js("a / /b/ .c"), "a/ /b/.c")
end

func css_cases:
    // Rule punctuation swallows surrounding whitespace; last ';' of a block
    // is dropped before '}'. [C-verified]
    testing.AssertEqStr(
        mn.Css("body { margin : 0 ; color: red; } .x { width: calc( 100% - 10px ) ; }"), "body{margin:0;color:red}.x{width:calc(100% - 10px)}"
    )
    // calc(): interior spaces around operators preserved, spaces hugging the
    // parens dropped (the whole point of the paren_depth branch).
    // (the trailing ';' survives - it is only dropped in front of a '}')
    testing.AssertEqStr(mn.Css("w: calc( 1px + 2em ) ;"), "w:calc(1px + 2em);")
    // Combinators/comma eat both sides. [C-verified]
    testing.AssertEqStr(
        mn.Css("h1 > p + a ~ b , c { x : y ; }"), "h1>p+a~b,c{x:y}"
    )
    // Only ONE trailing ';' is dropped at '}'. [C-verified]
    testing.AssertEqStr(mn.Css(".a{b:c;;}  .d  {}"), ".a{b:c;}.d{}")
    // Comment removal emits no glue: a space is kept on BOTH sides
    // ("a  b", faithful C quirk - prevc is the already-emitted ' ').
    // [C-verified]
    testing.AssertEqStr(mn.Css("a /* x */ b{}"), "a  b{}")
    // @media: inside '(' … ')' the {}:;,>+~ trimming is disabled, so the
    // spaces around ':' survive. [C-verified]
    testing.AssertEqStr(
        mn.Css("@media ( min-width : 600px ) { .a { color : red } }"), "@media (min-width : 600px){.a{color:red}}"
    )
    // Strings keep their bytes; url(...) keeps interior spacing. [C-verified]
    testing.AssertEqStr(
        mn.Css(".a { content : \"a  b\" ; background : url( (x) \"q\" y ) }"), ".a{content:\"a  b\";background:url((x) \"q\" y)}"
    )
    // Escapes inside CSS strings.
    testing.AssertEqStr(
        mn.Css(".a { content : 'x\\'y  z' }"), ".a{content:'x\\'y  z'}"
    )
    // Unterminated comment swallows the rest.
    testing.AssertEqStr(mn.Css("a{ /* x"), "a{")
    testing.AssertEqStr(mn.Css(""), "")
    testing.AssertEqStr(mn.Css("  \n "), "")
end

// End-to-end: run the C minifier via `bin/salam layout build` (compact minify
// is the default) on the same snippets and require byte identity with the
// port. Layout emits exactly minify_css(content) to the .css file and
// minify_js(content) + " " to the .js file (layout_gen_element.c).
func e2e_case:
    if !os.Exists("bin/salam"):
        println "minify_test: skipping e2e (bin/salam not found; run from repo root)"
        ret
    end
    c1 := "body { margin : 0 ; color : red ; } .x { width : calc( 100% - 10px ) ; }"
    j1 := "function add (a, b) { /* sum */ return a + b; } let re = /ab c/g;"
    base := "tmp_minify_e2e"
    mut lsrc := "layout:\n    title = \"T\"\n    style:\n        content = \""
    lsrc += c1
    lsrc += "\"\n    end\n    script:\n        content = \""
    lsrc += j1
    lsrc += "\"\n    end\nend\n"
    // layout build writes its outputs into the CWD (basename of the input),
    // so run the whole thing from inside salam/tests_port/.
    cwd0 := os.Cwd()
    _cd1 := os.Chdir("compiler/tests_port")
    wr := io.WriteFile(base + ".salam", lsrc)
    testing.AssertEqInt(wr, lsrc.len()) // WriteFile returns the byte count
    code := os.Run("../../bin/salam layout build " + base + ".salam > /dev/null 2>&1")
    testing.AssertEqInt(code, 0)
    css := io.ReadFile(base + ".css")
    js := io.ReadFile(base + ".js")
    testing.AssertEqStr(mn.Css(c1), css)
    testing.AssertEqStr(mn.Js(j1) + " ", js)
    _r1 := os.Remove(base + ".salam")
    _r2 := os.Remove(base + ".css")
    _r3 := os.Remove(base + ".js")
    _r4 := os.Remove(base + ".html")
    _cd2 := os.Chdir(cwd0)
end

func main:
    js_cases()
    css_cases()
    e2e_case()
    os.Exit(testing.Summary())
end
