package main

import os
import io

include x "../xml.salam"
include tok "../token.salam"
include src "../source.salam"
include lg "../logger.salam"
include lp "../langpack.salam"
include lx "../lexer/lexer.salam"
include at "../ast.salam"
include ps "../parser/parser.salam"

func main:
    args := os.Args()
    defer args.free()
    if args.len() < 2:
        io.EPrintln("usage: parser_xml_cmp <file.salam> [lang]")
        os.Exit(2)
    end
    path := args[1]
    mut sf := src.New()
    if !src.Load(path, sf):
        io.EPrintln("cannot read " + path)
        os.Exit(2)
    end
    mut pack := 0
    if args.len() > 2:
        pack = lp.Load(args[2])
    else:
        pack = lx.Detect(sf, lp.Load("en"))
    end
    quiet := lg.New(lg.LOG_OFF, false)
    mut ts := tok.StreamNew(path)
    defer tok.StreamFree(ts)
    lok := lx.Run(quiet, pack, sf, ts)
    mut a := at.NewAst()
    defer at.FreeAst(a)
    mut prog := 0
    pok := ps.Run(quiet, ts, a, prog)
    mut w := x.New()
    defer x.Free(w)
    x.Decl(w)
    at.ToXml(w, a, prog)
    print x.Str(w)
    if !lok || !pok:
        os.Exit(1)
    end
end
