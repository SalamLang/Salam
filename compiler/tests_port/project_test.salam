import testing
import os
import str

include pm "../pkgmgr/pkgmgr.salam"

func write_project(name: str, text: str): str:
    dir := os.TempDir() + "/salam-project-test-" + name
    _rm := os.RemoveAll(dir)
    _mk := os.MkdirAll(dir)
    _w := os.WriteFile(dir + "/salam.toml", text)
    ret dir
end

func has_issue(issues: Vector<str>, want: str): bool:
    each item in issues:
        if str.Equals(item, want):
            ret true
        end
    end
    ret false
end

func test_clean_file_has_no_issues():
    dir := write_project(
        "clean",
        "[package]\nname = \"x\"\n\n[app]\nid = \"app.x\"\nname = \"X\"\nversion = \"1.0.0\"\nbuild = 3\npermissions = [\"camera\"]\n\n[android]\nmin_sdk = 26\n\n[windows]\ncompany = \"Me\"\n"
    )
    mut issues := Vector {} as Vector<str>
    pm.ProjectIssues(dir, issues)
    testing.AssertEqInt(issues.Len(), 0)
    _rm := os.RemoveAll(dir)
end

func test_unknown_wrong_type_and_secret_keys():
    dir := write_project(
        "bad",
        "[app]\nid = \"app.x\"\nbuild = \"seven\"\ncolour = \"red\"\n\n[android]\nkeystore_pass = \"hunter2\"\nmin_sdk = 26\n\n[ios]\nteam = 5\n\n[app.mobile]\nicon = \"a.png\"\n"
    )
    mut issues := Vector {} as Vector<str>
    pm.ProjectIssues(dir, issues)
    testing.AssertEqInt(issues.Len(), 4)
    testing.AssertTrue(has_issue(issues, "type\tapp\tbuild\ti"))
    testing.AssertTrue(has_issue(issues, "unknown\tapp\tcolour\t"))
    testing.AssertTrue(has_issue(issues, "secret\tandroid\tkeystore_pass\t"))
    testing.AssertTrue(has_issue(issues, "type\tios\tteam\ts"))
    _rm := os.RemoveAll(dir)
end

func test_app_values_reach_the_project_info():
    dir := write_project(
        "info",
        "[package]\nname = \"p\"\nversion = \"0.1.0\"\n\n[app]\nname = \"Shown\"\nversion = \"2.0.0\"\nauthor = \"Me\"\ndescription = \"d\"\ncopyright = \"c\"\nicon = \"a.ico\"\n"
    )
    mut info := pm.PkgInfo {}
    testing.AssertTrue(pm.ReadPackageInfo(dir, info))
    testing.AssertTrue(info.has_app)
    testing.AssertEqStr(info.app_name, "Shown")
    testing.AssertEqStr(info.app_version, "2.0.0")
    testing.AssertEqStr(info.app_author, "Me")
    testing.AssertEqStr(info.app_copyright, "c")
    testing.AssertEqStr(info.app_icon, "a.ico")
    _rm := os.RemoveAll(dir)
end

func main(): int:
    test_clean_file_has_no_issues()
    test_unknown_wrong_type_and_secret_keys()
    test_app_values_reach_the_project_info()
    ret testing.Summary()
end
