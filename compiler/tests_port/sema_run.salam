package main

import os
import io
import str

include x "../xml.salam"
include tok "../token.salam"
include src "../source.salam"
include lg "../logger.salam"
include dg "../diag.salam"
include i18 "../i18n.salam"
include lp "../langpack.salam"
include lx "../lexer/lexer.salam"
include at "../ast.salam"
include ps "../parser/parser.salam"
include cc "../condcomp.salam"
include sm "../semantic/semantic.salam"

func main:
    args := os.Args()
    defer args.free()
    if args.len() < 2:
        io.EPrintln("usage: sema_run <file.salam>")
        ret 2
    end
    path := args[1]

    i18.SetLang("en")
    sm.LayoutSchemaInit(sm.GetStdlibRoot())

    mut sf := src.New()
    if not src.Load(path, sf):
        ret 2
    end
    quiet := lg.New(lg.LOG_OFF, false)
    pack := lx.Detect(sf, lp.Load("en"))

    mut toks := tok.StreamNew(path)
    lok := lx.Run(quiet, pack, sf, toks)
    mut a := at.NewAst()
    defer at.FreeAst(a)
    mut prog := 0
    mut pok := ps.Run(quiet, toks, a, prog)
    tok.StreamFree(toks)

    mut s := sm.New(quiet, path, lp.Code(pack))
    sm.SetCc(s, cc.TableBuild("", Vector {} as Vector<str>))
    if not cc.PruneProgram(a, quiet, path, s.cctab, prog):
        pok = false
    end
    sok := sm.Run(s, a, prog)

    mut w := x.New()
    x.Decl(w)
    sm.SymbolsToXml(w, s)
    print x.Str(w)
    x.Free(w)

    rendered := dg.RenderAll(
        s.diag, sf.text, sf.len, dg.DIAG_STYLE_RUST, dg.DIAG_FORMAT_HUMAN, false
    )
    if str.Len(rendered) > 0:
        io.EPrint(rendered)
    end

    sm.Free(s)
    if not lok or not pok or not sok:
        ret 1
    end
end
