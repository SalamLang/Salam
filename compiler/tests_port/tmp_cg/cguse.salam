// Importer for tmp_cg/cgutil.salam (a package module, not `main`): the
// driver's DCE reachability filter (compiler/src/driver/build.c) prunes
// every top-level function not transitively called from an entry point, so
// cgutil.salam must be built/compared THROUGH a real importer - never
// standalone - for the codegen byte-diff gate to see real function bodies.
// Calls every pub symbol in cgutil.salam (incl. UseHidden, which reaches
// the private `hidden` helper) so DCE keeps the whole module.
import util "cgutil.salam"

func main:
    mut q := util.MkPair(1, 2)
    util.Bump(q)
    arr := [1, 2, 3] as i32[3]
    println util.Sum(arr[:]), util.Twice(q.first), util.Sq(2.0)
    println util.UseHidden(3), util.Old(), q.second
end
