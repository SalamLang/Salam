package util

mut g_cg_seen := 0

pub type Id = int

pub struct Pair:
    pub first: int = 0
    pub second: int = 0
end

pub struct Box:
    pub items: Pair = Pair {}
end

func hidden(x: int): int:
    ret x + 1
end

pub func MkPair(x: int, y: int): Pair:
    ret Pair { first = x, second = y }
end

pub inline func Twice(x: int): int:
    ret x * 2
end

pub func Sum(view: i32[:]): int:
    mut t := 0
    each v in view:
        t += v
    end
    ret t
end

pub pure func Sq(x: f64): f64:
    ret x * x
end

pub deprecated func Old(): int:
    ret 1
end

pub func UseHidden(x: int): int:
    g_cg_seen = g_cg_seen + 1
    ret hidden(x)
end

pub func Bump(c &: Pair):
    c.first = c.first + 1
end
