import math
func add(a: int, b: int): int:
    ret a + b
end
func apply(f: func (int) int, x: int): int:
    ret f(x)
end
func main:
    println add(2, 3)
    double := (x: int): ret x * 2 end
    println double(21)
    println apply((x: int): ret x + 100 end, 5)
    println math.Sqrt(16.0)
    println math.Floor(3.7)
end
