func classify(n: int): str:
    if n < 0: ret "neg"
    else n == 0: ret "zero"
    else: ret "pos"
    end
end
func main:
    println classify(0 - 1), classify(0), classify(5)
    mut i := 0
    mut total := 0
    until i < 5:
        total = total + i
        i = i + 1
    end
    println total
    repeat 3 with k:
        println "r", k
    end
    repeat 1 to 5:
        println "once"
    end
    mut sum := 0
    repeat 0 to 20 by 2:
        sum = sum + 1
    end
    println sum
    mut j := 0
    until j < 10:
        j = j + 1
        if j == 3: continue end
        if j == 6: break end
        println "j", j
    end
end
