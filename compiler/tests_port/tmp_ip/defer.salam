func work():
    defer println "first-deferred-runs-last"
    defer println "second-deferred-runs-first"
    println "body"
end
func main:
    mut n := 10
    n += 5
    n *= 2
    n -= 3
    println n
    mut k := 0
    k++
    ++k
    println k, k--, k
    work()
end
