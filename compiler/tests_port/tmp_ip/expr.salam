func main:
    println 2 + 3 * 4
    println (2 + 3) * 4
    println 2 ** 10
    println 7 / 2
    println 7 % 2
    println 0 - 7
    println 5 & 3, 5 | 2, 5 ^ 1, ~0
    println 1 << 4, 256 >> 4
    println true ? "yes" : "no"
    println 3.9 as int
    println (0 - 2.9) as int
    println 65 as char
    println "ab" * 3
    println "n=" + 3
    println !true, !false
end
