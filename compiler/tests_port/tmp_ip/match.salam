func describe(n: int): str:
    ret match n:
        1, 2: "small" end
        3: "three" end
        else: "big" end
    end
end
func main:
    println describe(1), describe(3), describe(9)
    mut v := 21 as Variant<i32, str>
    label := match v:
        i32 x: "int " + x end
        str s: "text " + s end
    end
    println label
    v = "offline"
    label2 := match v:
        i32 x: "int " + x end
        str s: "text " + s end
    end
    println label2
end
