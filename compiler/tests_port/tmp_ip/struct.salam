struct Point:
    pub x: int = 0
    pub y: int = 0
    pub func sum(): int:
        ret this.x + this.y
    end
    pub func operator_add(o: Point): Point:
        ret Point { x = this.x + o.x, y = this.y + o.y }
    end
end
func main:
    p := Point { x = 3, y = 4 }
    println p.x, p.y, p.sum()
    q := p + Point { x = 1, y = 1 }
    println q.x, q.y
    a := [10, 20, 30, 40]
    println a[0], a[3]
    mid := a[1:3]
    println mid[0], mid[1], len(mid)
    s := "hello"
    println s[0], s[4]
end
