package demo5c

enum Color:
    Red, Green = 5, Blue
end

struct Point:
    pub x: int = 0
    pub y: int = 0
    pub func sum(): int:
        ret this.x + this.y
    end
end

struct Wrap:
    pub n: int = 2 * 3
    pub f: f64 = 1 + 2.5
    pub s2: str = "x" * 3
    pub b: bool = 1 < 2
    pub c: char = "abc"[1]
    pub t: int = true ? 10 : 20
    pub m: i64 = (5 as i64) << 3
    pub e: int = Color.Green as int
    pub w: u8 = 250 as u8
    pub k: i64 = ~(1 as i64)
    pub o4: f64 = add(1.5, 2.5)
    pub o5: int = add(3, 4)
    pub o6: int = 5 << 3
end

struct Req:
    pub q1: int
    pub q2: int = 5
end

struct Holder:
    pub r2: Req = Req { q1 = 1 }
    pub v: Vector<i32> = Vector {}
    pub h: HashMap<str, i32> = HashMap {}
end

struct VHold:
    pub val: Variant<i32, str>
end

struct VUse:
    pub w2: VHold = VHold { val = "boxed" }
end

func vuse(_v: Vector<i32>): int:
    ret 0
end

func add(p: int, q: int): int:
    ret p + q
end

func add(p: f64, q: f64): f64:
    ret p + q
end

func pick(v: int = add(1, 2)): int:
    ret v
end

func identity<T>(v2: T): T:
    ret v2
end

func useid(x: int = identity(42)): int:
    ret x
end

func pick2(w2: int = pick()): int:
    ret w2
end
