package main

import str
import os
import testing
import wb "../sal_web.salam"

func run_app_prints_output:
    r := wb.RunApp("func main:\n    println \"hi\"\nend\n", "en")
    testing.AssertContains(r, "hi")
end

func run_app_evaluates_arithmetic:
    r := wb.RunApp("func main:\n    println 2 + 3\nend\n", "en")
    testing.AssertContains(r, "5")
end

func run_app_reports_sema_error:
    r := wb.RunApp("func main:\n    println wobble\nend\n", "en")
    testing.AssertContains(r, "wobble")
end

func run_app_parse_failure_falls_back:
    r := wb.RunApp("func main:\n    println \"hi\"\n", "en")
    testing.AssertTrue(str.Len(r) > 0)
end

func run_app_unknown_lang:
    r := wb.RunApp("func main:\nend\n", "xx")
    testing.AssertEqStr(r, "unknown language pack")
end

func build_layout_renders_html_document:
    r := wb.BuildLayout(
        "layout:\n    box:\n        paragraph: content = \"hi\" end\n    end\nend\n", "en"
    )
    testing.AssertContains(r, "<!doctype html")
    testing.AssertContains(r, "hi")
end

func build_layout_without_layout_block:
    r := wb.BuildLayout("func main:\n    println \"hi\"\nend\n", "en")
    testing.AssertContains(r, "no layout block")
end

func build_layout_unknown_lang:
    r := wb.BuildLayout("func main:\nend\n", "xx")
    testing.AssertEqStr(r, "unknown language pack")
end

func emit_tokens_phase:
    r := wb.Emit("func main:\n    println \"hi\"\nend\n", "en", "tokens")
    testing.AssertContains(r, "<tokens")
    testing.AssertContains(r, "<?xml")
end

func emit_ast_phase:
    r := wb.Emit("func main:\n    println \"hi\"\nend\n", "en", "ast")
    testing.AssertContains(r, "<node")
end

func emit_symbols_phase_ok:
    r := wb.Emit("func main:\n    println \"hi\"\nend\n", "en", "symbols")
    testing.AssertContains(r, "<symbols")
    testing.AssertContains(r, `errors="0"`)
end

func emit_symbols_phase_reports_even_on_error:
    r := wb.Emit("func main:\n    println wobble\nend\n", "en", "symbols")
    testing.AssertContains(r, "<symbols")
end

func emit_c_phase:
    r := wb.Emit("func main:\n    println \"hi\"\nend\n", "en", "c")
    testing.AssertContains(r, "salam_mod_main.h")
    testing.AssertContains(r, "salam_mod_main.c")
end

func emit_llvm_phase:
    r := wb.Emit("func main:\n    x := 1 + 2\n    println x\nend\n", "en", "llvm")
    testing.AssertTrue(str.Len(r) > 0)
end

func emit_html_css_js_phases:
    src := "layout:\n    box:\n        paragraph: content = \"hi\" end\n    end\nend\n"
    html := wb.Emit(src, "en", "html")
    testing.AssertContains(html, "hi")
    css := wb.Emit(src, "en", "css")
    testing.AssertEqStr(css, "")
    js := wb.Emit(src, "en", "js")
    testing.AssertEqStr(js, "")
end

func emit_html_phase_no_layout_block:
    r := wb.Emit("func main:\n    println \"hi\"\nend\n", "en", "html")
    testing.AssertContains(r, "no layout block")
end

func emit_unknown_phase_after_successful_compile:
    r := wb.Emit("func main:\n    println \"hi\"\nend\n", "en", "bogus")
    testing.AssertEqStr(r, "compilation failed")
end

func emit_unknown_lang:
    r := wb.Emit("func main:\nend\n", "xx", "tokens")
    testing.AssertEqStr(r, "unknown language pack")
end

func version_string:
    testing.AssertEqStr(wb.Version(), "Salam WebAssembly playground")
end

func main:
    run_app_prints_output()
    run_app_evaluates_arithmetic()
    run_app_reports_sema_error()
    run_app_parse_failure_falls_back()
    run_app_unknown_lang()
    build_layout_renders_html_document()
    build_layout_without_layout_block()
    build_layout_unknown_lang()
    emit_tokens_phase()
    emit_ast_phase()
    emit_symbols_phase_ok()
    emit_symbols_phase_reports_even_on_error()
    emit_c_phase()
    emit_llvm_phase()
    emit_html_css_js_phases()
    emit_html_phase_no_layout_block()
    emit_unknown_phase_after_successful_compile()
    emit_unknown_lang()
    version_string()
    os.Exit(testing.Summary())
end
