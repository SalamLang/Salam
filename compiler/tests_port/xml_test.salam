// Smoke test for salam/xml (port of compiler/src/xml).
// Expected bytes derived by hand-tracing xml.c / xml_emit.c.
import x "../xml.salam"
import testing
import os

func main:
    mut w := x.New()
    x.Decl(w)

    x.Open(w, "tokens")
    x.Attr(w, "file", "a<b>.salam")
    x.AttrInt(w, "count", 2 as i64)

    x.Open(w, "token")
    x.Attr(w, "kind", "STRING")
    x.Text(w, "he said \"hi\" & <bye>")
    x.Close(w)

    x.Open(w, "meta")
    x.Attr(w, "note", "it's")
    x.LeafInt(w, "line", 12 as i64)
    x.Leaf(w, "word", "سلام<تست>")
    x.Open(w, "flag")
    x.Close(w) // <flag /> - no children, no text
    x.Close(w) // </meta> - children, not inlined

    x.Close(w) // </tokens>

    got := x.Str(w)
    x.Free(w)

    mut expected := "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n"
    expected += "<tokens file=\"a&lt;b&gt;.salam\" count=\"2\">\n"
    expected += "  <token kind=\"STRING\">he said &quot;hi&quot; &amp; &lt;bye&gt;</token>\n"
    expected += "  <meta note=\"it&apos;s\">\n"
    expected += "    <line>12</line>\n"
    expected += "    <word>سلام&lt;تست&gt;</word>\n"
    expected += "    <flag />\n"
    expected += "  </meta>\n"
    expected += "</tokens>\n"

    testing.AssertEqStr(got, expected)

    // Text outside any open element is a no-op (xml_text depth guard).
    mut w2 := x.New()
    x.Text(w2, "ignored")
    testing.AssertEqStr(x.Str(w2), "")
    x.Free(w2)

    os.Exit(testing.Summary())
end
