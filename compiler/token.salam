// token_kind_t / token_value_kind_t (see file header for why not enums)
pub type TokenKind = int
pub type TokenValueKind = int

// token_value_t (union replaced by typed fields; see file header)
pub struct TokenValue:
    pub kind: TokenValueKind = 0 // TV_NONE
    pub ival: u64 = 0            // TV_INT payload; TV_CHAR codepoint
    pub fval: f64 = 0.0          // TV_FLOAT payload
    pub sval: str = ""           // TV_STRING payload
    pub bval: bool = false       // TV_BOOL payload
end

// token_t — span fields inlined from core/span.h (src_span_t):
//   begin/end are src_pos_t { line, col, index }, plus length (all u32).
pub struct Token:
    pub kind: TokenKind = 0 // TK_EOF
    pub lexeme: str = ""
    pub begin_line: u32 = 0
    pub begin_col: u32 = 0
    pub begin_index: u32 = 0
    pub end_line: u32 = 0
    pub end_col: u32 = 0
    pub end_index: u32 = 0
    pub length: u32 = 0
    pub value: TokenValue = TokenValue {}
    pub layout_mode: bool = false
end

// struct token_stream { vec_t v; const char *file; }
pub struct TokenStream:
    pub toks: Vector<Token> = Vector {}
    pub file: str = ""
end

// Constructor (cross-package struct literals are not supported, so every
// consumer builds tokens through this; remaining fields default to zero).
pub func New(kind: TokenKind, lexeme: str): Token:
    ret Token { kind = kind, lexeme = lexeme }
end

// token_kind_name()
pub func KindName(kind: TokenKind): str:
    if kind < 0 || kind >= TK_COUNT:
        ret "UNKNOWN"
    end
    ret k_token_names[kind]
end

// tk_is_keyword()
pub func IsKeyword(kind: TokenKind): bool:
    ret kind >= TK_KW_FUNC && kind <= TK_KW_MATCH
end

// Convenience constructors for token_value_t payloads (the C lexer fills
// the union by hand; these keep call sites tidy).
pub func ValueNone(): TokenValue:
    ret TokenValue {}
end

pub func ValueInt(i: u64): TokenValue:
    ret TokenValue { kind = TV_INT, ival = i }
end

pub func ValueFloat(f: f64): TokenValue:
    ret TokenValue { kind = TV_FLOAT, fval = f }
end

pub func ValueStr(s: str): TokenValue:
    ret TokenValue { kind = TV_STRING, sval = s }
end

pub func ValueChar(codepoint: u64): TokenValue:
    ret TokenValue { kind = TV_CHAR, ival = codepoint }
end

pub func ValueBool(b: bool): TokenValue:
    ret TokenValue { kind = TV_BOOL, bval = b }
end

// token_stream_new()
pub func StreamNew(file: str): TokenStream:
    ret TokenStream { file = file }
end

// token_stream_push()
pub func StreamPush(ts &: TokenStream, tok: Token):
    ts.toks.push(tok)
end

// token_stream_count()
pub func StreamCount(ts: TokenStream): int:
    ret ts.toks.len()
end

// token_stream_at()
pub func StreamAt(ts: TokenStream, i: int): Token:
    ret ts.toks[i]
end

// token_stream_file()
pub func StreamFile(ts: TokenStream): str:
    ret ts.file
end

// No C equivalent (the arena is freed wholesale there); frees the Vector.
pub func StreamFree(ts &: TokenStream):
    ts.toks.free()
end

// ===== token_xml.c =====
// The --emit-tokens-xml dump.
// - token_value_to_xml (static) is inlined into TokensToXml (E088: the pub
//   section must stay last, so no private helper here).
// - sal_u64toa -> core U64Toa; sal_snprintf "%g" -> core Format1("%g", ...),
//   which delegates to libc snprintf exactly like C.
// tokens_to_xml — byte-compatible with the C emitter (the driver adds
// xml.Decl() and writes the file).
pub func TokensToXml(w &: x.Writer, ts: TokenStream):
    x.Open(w, "tokens")
    x.Attr(w, "source", StreamFile(ts))
    x.AttrInt(w, "count", StreamCount(ts) as i64)
    repeat StreamCount(ts) with i:
        t := StreamAt(ts, i)
        x.Open(w, "token")
        if t.layout_mode:
            x.Attr(w, "mode", "layout")
        end
        x.Leaf(w, "base", "token_t")
        x.Leaf(w, "type", KindName(t.kind))
        x.Leaf(w, "source", t.lexeme)
        // token_value_to_xml, inlined (TV_NONE emits nothing)
        if t.value.kind == TV_INT:
            x.Open(w, "value")
            x.Attr(w, "kind", "int")
            x.Text(w, co.U64Toa(t.value.ival))
            x.Close(w)
        else t.value.kind == TV_FLOAT:
            x.Open(w, "value")
            x.Attr(w, "kind", "float")
            x.Text(w, co.Format1("%g", co.ArgFloat(t.value.fval)))
            x.Close(w)
        else t.value.kind == TV_STRING:
            x.Open(w, "value")
            x.Attr(w, "kind", "string")
            x.Text(w, t.value.sval)
            x.Close(w)
        else t.value.kind == TV_CHAR:
            x.Open(w, "value")
            x.Attr(w, "kind", "char")
            x.Text(w, co.U64Toa(t.value.ival))
            x.Close(w)
        else t.value.kind == TV_BOOL:
            x.Open(w, "value")
            x.Attr(w, "kind", "bool")
            x.Text(w, t.value.bval ? "true" : "false")
            x.Close(w)
        end
        x.Open(w, "location")
        x.LeafInt(w, "begin_line", t.begin_line as i64)
        x.LeafInt(w, "begin_column", t.begin_col as i64)
        x.LeafInt(w, "end_line", t.end_line as i64)
        x.LeafInt(w, "end_column", t.end_col as i64)
        x.Close(w)
        x.Close(w)
    end
    x.Close(w)
end
