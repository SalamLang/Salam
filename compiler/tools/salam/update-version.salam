// salam run tools/salam/update-version.salam 0.2.5

import os
import str

func is_digit_str(c: str): bool:
    ret str.IsDigit(char_code(c))
end

func is_valid_version(v: str): bool:
    if v.len() == 0: ret false end
    parts := str.Split(v, ".")
    if parts.len() < 2: ret false end
    mut ok := true
    each part in parts:
        if part.len() == 0:
            ok = false
        else:
            repeat part.len() with i:
                if is_digit_str(part.substr(i, 1)) == false: ok = false end
            end
        end
    end
    ret ok
end

func main:
    args := os.Args()
    if args.len() < 2:
        println "usage: salam run tools/salam/update-version.salam <new-version>"
        println "example: salam run tools/salam/update-version.salam 0.2.5"
        os.Exit(1)
    end

    new_version := args.get(1)[0]
    if is_valid_version(new_version) == false:
        println "error: invalid version", new_version, "(expected dotted digits, e.g. 0.2.5)"
        os.Exit(1)
    end

    if os.Exists("../VERSION") == false:
        println "error: ../VERSION not found - run this from the compiler/ directory"
        os.Exit(1)
    end

    old_version := str.Trim(os.ReadFile("../VERSION"))
    if old_version == new_version:
        println "already at version", new_version, "- nothing to do"
        os.Exit(0)
    end

    sites := [
        "../VERSION",
        "src/core/build_info.h",
        "tools/bash/build-release.sh",
        "std/web/web.salam",
        "tests/en/general/web_util.salam",
        "tests/fa/general/web_util.salam",
        "tests/en/general/strconcat.salam",
        "tests/en/general/strconcat.out",
        "../examples/en/data/concat_plus.salam",
        "../books/en/intro-programming/chapters/01-getting-started.tex"
    ]

    println "bumping Salam version", old_version, "->", new_version
    println ""

    mut updated := 0
    mut skipped := 0
    each path in sites:
        if os.Exists(path) == false:
            println "  skip (missing):", path
            skipped = skipped + 1
        else:
            content := os.ReadFile(path)
            replaced := str.Replace(content, old_version, new_version)
            if replaced == content:
                println "  skip (no match):", path
                skipped = skipped + 1
            else:
                os.WriteFile(path, replaced)
                println "  updated:", path
                updated = updated + 1
            end
        end
    end

    println ""
    println "done:", updated, "file(s) updated,", skipped, "skipped"
    if skipped > 0:
        println "review the skipped files by hand, they may reference the version differently"
    end
end
