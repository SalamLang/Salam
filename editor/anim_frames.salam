// anim_frames - recover the frames hidden inside one finished output string.
//
// The browser runs the interpreter to completion and hands back a single
// string, so there is nothing to stream; the frames have to be found in the
// text afterwards. Two boundaries are recognised:
//
//   1. Terminal control codes - "\x1b[2J" (clear) or "\x1b[H" (cursor home),
//      the donut.c idiom, plus form feed and the "\x1bc" reset. Every other
//      escape sequence is stripped, so colour codes never reach the pane as
//      literal garbage.
//   2. A numbered header line - "-- frame 0", "-- frame 1", ... Guarded hard,
//      because a program that merely counts is not an animation: at least
//      MIN_FRAMES headers, integers strictly increasing, and at least
//      MIN_BODY lines per frame.
//
// The result is exposed as Count()/At(); Clean() is the whole output with the
// escape sequences removed, which is what the pane shows when the output turns
// out not to be an animation at all.

package anim_frames

const MAX_FRAMES := 512
const MAX_PFX := 16
const MIN_FRAMES := 3
const MIN_BODY := 3

mut g_count := 0
mut g_trunc := false
mut g_clean := ""

mut frames: str[MAX_FRAMES]
mut mstart: int[MAX_FRAMES]
mut mnum: int[MAX_FRAMES]
mut pfx: str[MAX_PFX]
mut pfxn: int[MAX_PFX]

func cc(s: str, i: int): int: ret s[i] as int end

func is_digit(c: int): bool: ret c >= 48 && c <= 57 end

func has_text(s: str): bool:
    n := s.len()
    mut i := 0
    until i < n:
        if cc(s, i) > 32: ret true end
        i = i + 1
    end
    ret false
end

func find_from(s: str, sub: str, from: int): int:
    n := s.len()
    if from >= n: ret 0 - 1 end
    idx := s.substr(from, n - from).find(sub)
    if idx < 0: ret 0 - 1 end
    ret from + idx
end

func line_end(s: str, from: int): int:
    j := find_from(s, "\n", from)
    if j < 0: ret s.len() end
    ret j
end

func count_lines(s: str): int:
    n := s.len()
    mut total := 1
    mut i := 0
    until i < n:
        if cc(s, i) == 10: total = total + 1 end
        i = i + 1
    end
    ret total
end

func trim_right(s: str): str:
    mut e := s.len()
    until e > 0 && cc(s, e - 1) <= 32:
        e = e - 1
    end
    ret s.substr(0, e)
end

// esc_end - index just past the escape sequence that starts at i.
func esc_end(s: str, i: int): int:
    n := s.len()
    if i + 1 >= n: ret n end
    if cc(s, i + 1) != 91: ret i + 2 end
    mut j := i + 2
    until j < n && (cc(s, j) < 64 || cc(s, j) > 126):
        j = j + 1
    end
    if j < n: ret j + 1 end
    ret n
end

// esc_is_home - does the sequence at [i, e) start a fresh screen?
func esc_is_home(s: str, i: int, e: int): bool:
    if e - i < 2: ret false end
    last := cc(s, e - 1)
    if cc(s, i + 1) != 91: ret last == 99 end
    if last == 72 || last == 102: ret true end
    if last != 74: ret false end
    p := s.substr(i + 2, e - i - 3)
    ret p == "2" || p == "3"
end

func push_frame(buf: str):
    g_clean = g_clean + buf
    if has_text(buf) == false: ret end
    if g_count >= MAX_FRAMES:
        g_trunc = true
        ret
    end
    frames[g_count] = buf
    g_count = g_count + 1
end

// scan_controls - strip every escape sequence, cutting a frame wherever the
// program cleared the screen or homed the cursor. Also fills g_clean, which is
// what the pane shows when there is no animation to play.
func scan_controls(src: str):
    n := src.len()
    mut buf := ""
    mut i := 0
    until i < n:
        c := cc(src, i)
        if c == 27:
            e := esc_end(src, i)
            if esc_is_home(src, i, e):
                push_frame(buf)
                buf = ""
            end
            i = e
        else c == 12:
            push_frame(buf)
            buf = ""
            i = i + 1
        else c == 13:
            i = i + 1
        else:
            buf = buf + src.substr(i, 1)
            i = i + 1
        end
    end
    push_frame(buf)
end

func clear_pfx():
    mut i := 0
    until i < MAX_PFX:
        pfx[i] = ""
        pfxn[i] = 0
        i = i + 1
    end
end

// num_start - where the trailing run of digits begins, or -1.
func num_start(line: str): int:
    n := line.len()
    if n == 0: ret 0 - 1 end
    mut j := n
    until j > 0 && is_digit(cc(line, j - 1)):
        j = j - 1
    end
    if j == n: ret 0 - 1 end
    if n - j > 9: ret 0 - 1 end
    ret j
end

// marker_prefix - "-- frame 12" -> "-- frame ", anything else -> "".
func marker_prefix(line: str): str:
    j := num_start(line)
    if j <= 0: ret "" end
    p := line.substr(0, j)
    if has_text(p) == false: ret "" end
    ret p
end

func note_prefix(p: str):
    mut i := 0
    until i < MAX_PFX:
        if pfx[i] == p:
            pfxn[i] = pfxn[i] + 1
            ret
        end
        if pfx[i] == "":
            pfx[i] = p
            pfxn[i] = 1
            ret
        end
        i = i + 1
    end
end

func scan_prefixes(src: str):
    clear_pfx()
    n := src.len()
    mut ls := 0
    until ls < n:
        le := line_end(src, ls)
        p := marker_prefix(trim_right(src.substr(ls, le - ls)))
        if p != "": note_prefix(p) end
        ls = le + 1
    end
end

// next_prefix - the rarest candidate not tried yet, and mark it tried.
//
// Rarest first, because a frame header appears once per frame while the body
// lines inside a frame appear many times over. "-- frame 3" (6 of them) has to
// be tried before "  row 3" (30 of them), or every body line becomes a frame
// and the MIN_BODY check throws the whole animation away.
func next_prefix(): str:
    mut best := ""
    mut bn := 0
    mut bi := 0 - 1
    mut i := 0
    until i < MAX_PFX:
        if pfx[i] != "" && pfxn[i] >= MIN_FRAMES && (bi < 0 || pfxn[i] < bn):
            bn = pfxn[i]
            best = pfx[i]
            bi = i
        end
        i = i + 1
    end
    if bi >= 0: pfxn[bi] = 0 end
    ret best
end

func collect_markers(src: str, p: str): int:
    g_trunc = false
    n := src.len()
    mut k := 0
    mut ls := 0
    until ls < n && k < MAX_FRAMES:
        le := line_end(src, ls)
        line := trim_right(src.substr(ls, le - ls))
        if marker_prefix(line) == p:
            mstart[k] = ls
            mnum[k] = NumAt(line, num_start(line))
            k = k + 1
        end
        ls = le + 1
    end
    if k >= MAX_FRAMES: g_trunc = true end
    ret k
end

func nums_increase(k: int): bool:
    mut i := 1
    until i < k:
        if mnum[i] <= mnum[i - 1]: ret false end
        i = i + 1
    end
    ret true
end

func build_marker_frames(src: str, k: int): bool:
    mut i := 0
    until i < k:
        st := i == 0 ? 0 : mstart[i]
        en := i + 1 < k ? mstart[i + 1] : src.len()
        seg := src.substr(st, en - st)
        if count_lines(seg) < MIN_BODY: ret false end
        frames[i] = seg
        i = i + 1
    end
    g_count = k
    ret true
end

func try_prefix(src: str, p: str): bool:
    k := collect_markers(src, p)
    if k < MIN_FRAMES: ret false end
    if nums_increase(k) == false: ret false end
    ret build_marker_frames(src, k)
end

func try_markers(src: str):
    scan_prefixes(src)
    mut tries := 0
    until tries < MAX_PFX:
        p := next_prefix()
        if p == "": ret end
        if try_prefix(src, p): ret end
        tries = tries + 1
    end
end

func pad_to(s: str, target: int): str:
    mut out := s
    mut l := count_lines(s)
    until l < target:
        out = out + "\n"
        l = l + 1
    end
    ret out
end

// pad_frames - give every frame the same height so swapping one for the next
// never resizes the pane or nudges the scroll position.
func pad_frames():
    mut tallest := 0
    mut i := 0
    until i < g_count:
        l := count_lines(frames[i])
        if l > tallest: tallest = l end
        i = i + 1
    end
    i = 0
    until i < g_count:
        frames[i] = pad_to(frames[i], tallest)
        i = i + 1
    end
end

// Split - find the frames in one program output. Try the control codes first,
// fall back to numbered headers, and leave Count() below 2 when the output is
// just text.
@fa "بشکاف"
@ar "قسم"
pub func Split(src: str):
    g_clean = ""
    g_count = 0
    g_trunc = false
    scan_controls(src)
    if g_count < 2:
        g_count = 0
        try_markers(g_clean)
    end
    if g_count >= 2: pad_frames() end
end

@fa "تعداد"
@ar "العدد"
pub func Count(): int: ret g_count end

@fa "فریم"
@ar "إطار"
pub func At(i: int): str: ret frames[i] end

// Clean - the whole output with escape sequences removed.
@fa "پاک"
@ar "نظیف"
pub func Clean(): str: ret g_clean end

// Truncated - were there more frames than MAX_FRAMES? Shown as a "+" on the
// frame counter, so a capped animation never passes for a complete one.
@fa "بریده شده"
@ar "مقتطع"
pub func Truncated(): bool: ret g_trunc end

// NumAt - the integer starting at `from`, skipping anything that is not a
// digit. Also how the player reads the scrubber's value back.
@fa "عدد در"
@ar "رقم عند"
pub func NumAt(s: str, from: int): int:
    n := s.len()
    mut v := 0
    mut i := from
    until i < n:
        c := cc(s, i)
        if is_digit(c): v = v * 10 + (c - 48) end
        i = i + 1
    end
    ret v
end
