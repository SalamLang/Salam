// ---- End of vocabulary ----------------------------------------------------

// Block stack used while scanning the text before the caret. One letter per
// open block: L = the layout: block, E = a layout element, C = a code block
// (func, if, loop, or an event listener lambda inside a layout element).
mut stack := ""
// True while the scan is inside a /* ... */ comment that spans lines.
mut in_block := false
// State at the end of the last cleaned line: 0 = code, 1 = unterminated
// string, 2 = line comment.
mut tail := 0

func cc(s: str, i: int): int: ret s[i] as int end

func is_word(c: int): bool:
    ret (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95 or c >= 128
end

func is_space(c: int): bool: ret c == 32 or c == 9 or c == 13 end

func lower(s: str): str:
    mut out := ""
    mut i := 0
    until i < s.len():
        c := cc(s, i)
        if c >= 65 and c <= 90:
            out = out + char_from_code(c + 32)
        else:
            out = out + s.substr(i, 1)
        end
        i += 1
    end
    ret out
end

func trim(s: str): str:
    mut a := 0
    mut b := s.len()
    until a < b and is_space(cc(s, a)):
        a += 1
    end
    until b > a and is_space(cc(s, b - 1)):
        b -= 1
    end
    ret s.substr(a, b - a)
end

func starts(s: str, p: str): bool:
    if p.len() == 0: ret true end
    if s.len() < p.len(): ret false end
    ret s.substr(0, p.len()) == p
end

// Returns the line with comments removed and string contents replaced by "".
// Sets tail for an unterminated string or a line comment at the end.
func clean_line(line: str): str:
    mut out := ""
    n := line.len()
    mut i := 0
    tail = 0
    until i < n and tail != 2:
        c := cc(line, i)
        nx := i + 1 < n ? cc(line, i + 1) : 0
        if in_block:
            if c == 42 and nx == 47:
                in_block = false
                i += 2
            else:
                i += 1
            end
        else c == 47 and nx == 47:
            tail = 2
        else c == 47 and nx == 42:
            in_block = true
            i += 2
        else c == 34 or c == 39 or c == 96:
            mut j := i + 1
            mut closed := false
            until j < n and closed == false:
                if cc(line, j) == 92:
                    j += 2
                else cc(line, j) == c:
                    closed = true
                    j += 1
                else:
                    j += 1
                end
            end
            if closed == false:
                tail = 1
            end
            out = out + "\"\""
            i = j
        else:
            out = out + line.substr(i, 1)
            i += 1
        end
    end
    ret out
end

func first_word(t: str): str:
    mut j := 0
    until j < t.len() and is_word(cc(t, j)):
        j += 1
    end
    ret t.substr(0, j)
end

func is_end_word(t: str): bool:
    ret t == "end" or t == "پایان" or t == "تمام"
end

func is_layout_word(w: str): bool:
    ret w == "layout" or w == "چیدمان"
end

func is_else_word(w: str): bool:
    ret w == "else" or w == "وگرنه"
end

func top(): str:
    n := stack.len()
    if n == 0: ret "" end
    ret stack.substr(n - 1, 1)
end

func push(kind: str):
    stack = stack + kind
end

func pop():
    n := stack.len()
    if n > 0: stack = stack.substr(0, n - 1) end
end

// `name = (...):` opens an event listener body, which is code.
func is_lambda_line(t: str): bool:
    eq := t.find("=")
    if eq < 0: ret false end
    rest := trim(t.substr(eq + 1, t.len() - eq - 1))
    ret starts(rest, "(")
end

func process_line(line: str):
    t := trim(clean_line(line))
    if t.len() == 0: ret end
    if is_end_word(t):
        pop()
        ret
    end
    if cc(t, t.len() - 1) != 58: ret end
    w := first_word(t)
    if is_else_word(w): ret end
    if is_layout_word(w):
        push("L")
        ret
    end
    if top() == "L" or top() == "E":
        if is_lambda_line(t):
            push("C")
        else:
            push("E")
        end
        ret
    end
    push("C")
end

func kw_count(fa: bool): int:
    if fa: ret len(KW_FA) end
    ret len(KW_EN)
end

func kw_at(fa: bool, i: int): str:
    if fa: ret KW_FA[i] end
    ret KW_EN[i]
end

func tag_count(fa: bool): int:
    if fa: ret len(TAG_FA) end
    ret len(TAG_EN)
end

func tag_at(fa: bool, i: int): str:
    if fa: ret TAG_FA[i] end
    ret TAG_EN[i]
end

func attr_count(fa: bool): int:
    if fa: ret len(ATTR_FA) end
    ret len(ATTR_EN)
end

func attr_at(fa: bool, i: int): str:
    if fa: ret ATTR_FA[i] end
    ret ATTR_EN[i]
end

// Appends one "kind label" item, newline-separated, to out.
func add(out: str, n: int, kind: str, label: str): str:
    if n == 0: ret kind + label end
    ret out + "\n" + kind + label
end

// Start of the identifier-like word that ends at pos (byte offset).
pub func WordStart(src: str, pos: int): int:
    mut i := pos
    until i > 0 and is_word(cc(src, i - 1)):
        i -= 1
    end
    ret i
end

// End of the word that contains pos (byte offset).
pub func WordEnd(src: str, pos: int): int:
    mut i := pos
    until i < src.len() and is_word(cc(src, i)):
        i += 1
    end
    ret i
end

// Whether completion applies at pos, and in which vocabulary.
pub func Mode(src: str, pos: int): int:
    ws := WordStart(src, pos)
    mut ls := 0
    mut k := 0
    until k < ws:
        if cc(src, k) == 10: ls = k + 1 end
        k += 1
    end
    stack = ""
    in_block = false
    mut i := 0
    until i < ls:
        mut e := i
        until e < ls - 1 and cc(src, e) != 10:
            e += 1
        end
        process_line(src.substr(i, e - i))
        i = e + 1
    end
    code := trim(clean_line(src.substr(ls, ws - ls)))
    if in_block or tail != 0: ret MODE_NONE end
    if code.len() > 0:
        last := cc(code, code.len() - 1)
        if last == 61 or last == 46: ret MODE_NONE end
    end
    if top() == "" or top() == "C": ret MODE_CODE end
    ret MODE_LAYOUT
end

// Matching items as one string: one item per line, each item is a kind
// letter (k = keyword, t = element, a = attribute) followed by its label.
pub func Build(prefix: str, mode: int, lang: str): str:
    p := lower(prefix)
    fa := lang == "fa"
    mut out := ""
    mut n := 0
    if mode == MODE_CODE:
        mut i := 0
        until i < kw_count(fa) and n < MAX_ITEMS:
            w := kw_at(fa, i)
            if starts(lower(w), p):
                out = add(out, n, "k", w)
                n += 1
            end
            i += 1
        end
    else mode == MODE_LAYOUT:
        mut i := 0
        until i < tag_count(fa) and n < MAX_ITEMS:
            w := tag_at(fa, i)
            if starts(lower(w), p):
                out = add(out, n, "t", w)
                n += 1
            end
            i += 1
        end
        i = 0
        until i < attr_count(fa) and n < MAX_ITEMS:
            w := attr_at(fa, i)
            if starts(lower(w), p):
                out = add(out, n, "a", w)
                n += 1
            end
            i += 1
        end
    end
    ret out
end

pub func Count(list: str): int:
    if list.len() == 0: ret 0 end
    mut n := 1
    mut i := 0
    until i < list.len():
        if cc(list, i) == 10: n += 1 end
        i += 1
    end
    ret n
end

pub func Item(list: str, idx: int): str:
    mut k := 0
    mut start := 0
    mut i := 0
    until i < list.len():
        if cc(list, i) == 10:
            if k == idx: ret list.substr(start, i - start) end
            k += 1
            start = i + 1
        end
        i += 1
    end
    ret list.substr(start, list.len() - start)
end

// Kind letter of an item: k, t or a.
pub func Kind(item: str): str: ret item.substr(0, 1) end

pub func Label(item: str): str: ret item.substr(1, item.len() - 1) end

// Text that replaces the typed prefix when an item is chosen.
pub func Insert(item: str): str:
    label := Label(item)
    k := Kind(item)
    if k == "t": ret label + ":" end
    if k == "a": ret label + " = " end
    ret label
end
