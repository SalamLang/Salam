/*
 * Salam Programming Language (2024-2026)
 *
 *   +-------------------+
 *   |     S A L A M     |
 *   +-------------------+
 *
 * Designed by Seyyed Ali Mohammadiyeh and the Salam Team
 * Born from a decade of language design experience (since 2018)
 *
 * Repository: https://github.com/SalamLang/Salam
 *
 */


const ACCENT := "#ff7a18"
const ON_ACCENT := "#2a1402"
const BG := "light dark(#f4f6fa, #0f1115)"
const PANEL := "light dark(#ffffff, #161922)"
const PANEL_2 := "light dark(#eef1f6, #1d2230)"
const BORDER := "light dark(#d8dde7, #2a3040)"
const FG := "light dark(#1b2030, #e6e9ef)"
const MUTED := "light dark(#5f6878, #9aa4b8)"
const EDITOR_BG := "light dark(#ffffff, #1e1e1e)"
const EDITOR_FG := "light dark(#1b2030, #d4d4d4)"
const SHADOW := "#0000004d"

const STATE_CSS := `:root[data-theme="light"] { color-scheme: light; }
:root[data-theme="dark"] { color-scheme: dark; }
:root {
  --accent: #ff7a18;
  --accent-text: light-dark(#a34a00, #ff7a18);
  --accent-2: light-dark(#1d4ed8, #1e90ff);
  --danger: light-dark(#b91c1c, #ff5c5c);
  --warn: light-dark(#8a6100, #e0a92b);
  --on-accent: #2a1402;
  --bg: light-dark(#f4f6fa, #0f1115);
  --panel: light-dark(#ffffff, #161922);
  --border: light-dark(#d8dde7, #2a3040);
  --fg: light-dark(#1b2030, #e6e9ef);
  --muted: light-dark(#5f6878, #9aa4b8);
  --editor-bg: light-dark(#ffffff, #1e1e1e);
  --editor-fg: light-dark(#1b2030, #d4d4d4);
  --t-comment: light-dark(#008000, #6a9955);
  --t-keyword: light-dark(#0000ff, #569cd6);
  --t-type: light-dark(#267f99, #4ec9b0);
  --t-string: light-dark(#a31515, #ce9178);
  --t-number: light-dark(#098658, #b5cea8);
  --t-op: light-dark(#af00db, #c586c0);
  --t-func: light-dark(#795e26, #dcdcaa);
  --shadow: light-dark(rgb(20 30 60 / 18%), rgb(0 0 0 / 35%));
}
main.split { grid-template-columns: var(--col-a, 1fr) 6px 1fr; }
.logo-mark { display: inline-block; mask-image: url(assets/logo.svg); mask-position: center; mask-size: contain; mask-repeat: no-repeat; }
.icon-mark.mk-copy { mask-image: url(assets/copy.svg); mask-position: center; mask-size: contain; mask-repeat: no-repeat; }
.icon-mark.mk-check { mask-image: url(assets/check.svg); mask-position: center; mask-size: contain; mask-repeat: no-repeat; }
.icon-btn.copied { color: var(--accent-text); border-color: var(--accent); }
.icon-btn.copied .mk-copy { display: none; }
.icon-btn.copied .mk-check { display: inline-block; }
.seg-btn.active, .seg-btn.active:hover { background: var(--accent); color: var(--on-accent); font-weight: 600; }
.toggle.on { color: var(--fg); border-color: var(--accent); }
.toggle.on .dot { background: var(--accent); box-shadow: 0 0 7px var(--accent); }
.dropdown.open .dd-caret { transform: rotate(180deg); }
.gutter.dragging { background: var(--accent); }
.anim-btn.on { color: var(--accent-text); border-color: var(--accent); }
.anim-bar.raw .anim-tr { display: none; }
.status.busy { color: var(--accent-2); }
.status.ok { color: var(--accent-text); }
.status.err { color: var(--danger); }
.code[dir="rtl"], .hl[dir="rtl"] { direction: rtl; text-align: right; }
.code, .hl { tab-size: 4; resize: none; }
.hl .c { color: var(--t-comment); }
.hl .k { color: var(--t-keyword); }
.hl .t { color: var(--t-type); }
.hl .s { color: var(--t-string); }
.hl .n { color: var(--t-number); }
.hl .o { color: var(--t-op); }
.ln-inner { will-change: transform; }
.ln-row { position: relative; padding-inline: 16px 9px; text-align: end; }
.ln-row.cur { color: var(--fg); }
.ln-row.err { color: var(--danger); font-weight: 600; pointer-events: auto; cursor: help; }
.ln-row.warn { color: var(--warn); font-weight: 600; pointer-events: auto; cursor: help; }
.ln-row.err::before, .ln-row.warn::before { content: ""; position: absolute; inset-inline-start: 5px; top: 50%; width: 7px; height: 7px; margin-top: -3.5px; border-radius: 50%; background: var(--warn); }
.ln-row.err::before { background: var(--danger); }
.output { overflow-wrap: anywhere; }
.output.error { color: var(--danger); }
.output.codeview { direction: ltr; text-align: left; white-space: pre; }
.output.xml .xb { color: var(--t-op); }
.output.xml .xt { color: var(--t-keyword); }
.output.xml .xa { color: var(--t-type); }
.output.xml .xv { color: var(--t-string); }
.output.xml .xc { color: var(--t-comment); font-style: italic; }
.output.xml .xp { color: var(--t-comment); }
.output.ir .ik { color: var(--t-keyword); }
.output.ir .it { color: var(--t-type); }
.output.ir .is { color: var(--t-string); }
.output.ir .in { color: var(--t-number); }
.output.ir .ic { color: var(--t-comment); font-style: italic; }
.output.ir .ig { color: var(--accent); }
.output.ir .il { color: var(--accent-2); }
.output.ir .im { color: var(--muted); }
.output.ir .ilbl { color: var(--accent-2); font-weight: 600; }
.output.ir .io { color: var(--t-op); }
.output.clang .cm { color: var(--t-comment); font-style: italic; }
.output.clang .cpp { color: var(--accent); }
.output.clang .cs, .output.clang .cl { color: var(--t-string); }
.output.clang .cn { color: var(--t-number); }
.output.clang .ck { color: var(--t-keyword); }
.output.clang .ct { color: var(--t-type); }
.output.clang .co { color: var(--t-op); }
.output.clang .cf { color: var(--t-func); }
.dd-item { display: flex; align-items: center; gap: 8px; padding: 8px 12px; border-radius: 7px; cursor: pointer; font-size: 14px; color: var(--fg); white-space: nowrap; }
.dd-item:hover, .dd-item.focus { background: var(--accent); color: var(--on-accent); }
.dd-item.sel { color: var(--accent-text); font-weight: 600; }
.dd-item.sel:hover, .dd-item.sel.focus { color: var(--on-accent); }
.dd-item.custom { font-style: italic; }
.dd-item.is-web { background: color-mix(in srgb, var(--accent) 9%, transparent); }
.dd-item.is-web:hover, .dd-item.is-web.focus { background: var(--accent); }
.dd-text { flex: 1 1 auto; }
.ic { flex: 0 0 auto; vertical-align: middle; opacity: .85; }
.ic.web { color: var(--accent-text); opacity: 1; }
.dd-item:hover .ic, .dd-item.focus .ic { color: var(--on-accent); opacity: 1; }
.dd-head { display: block; padding: 9px 12px 4px; font-size: 11px; font-weight: 700; letter-spacing: .05em; text-transform: uppercase; color: var(--muted); cursor: default; pointer-events: none; }
.dd-head:not(:first-child) { margin-top: 5px; border-top: 1px solid var(--border); padding-top: 9px; }
.dd-head.web { color: var(--accent-text); }
.dd-badge { margin-inline-start: auto; font-size: 10px; font-weight: 700; letter-spacing: .04em; color: var(--accent-text); border: 1px solid var(--accent-text); border-radius: 5px; padding: 1px 6px; }
.dd-item:hover .dd-badge, .dd-item.focus .dd-badge { color: var(--on-accent); border-color: var(--on-accent); }
.ac-item { display: inline-flex; align-items: center; gap: 6px; flex: 0 0 auto; padding: 4px 10px; border-radius: 999px; border: 1px solid var(--border); background: var(--editor-bg); color: var(--fg); font-family: monospace; font-size: 13px; white-space: nowrap; cursor: pointer; user-select: none; }
.ac-item b { font-weight: 600; }
.ac-item i { font-style: normal; font-size: 11px; color: var(--muted); }
.ac-item:hover { border-color: var(--accent); }
.ac-item.sel { background: var(--accent); border-color: var(--accent); color: var(--on-accent); }
.ac-item.sel i { color: var(--on-accent); }
.menu-toggle .bar { transition: transform .3s cubic-bezier(.4, 0, .2, 1), opacity .2s ease; }
.menu-toggle .bar + .bar { margin-top: 5px; }
body.menu-open .menu-toggle .bar:nth-child(1) { transform: translateY(7px) rotate(45deg); }
body.menu-open .menu-toggle .bar:nth-child(2) { opacity: 0; }
body.menu-open .menu-toggle .bar:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
body.menu-open .scrim { opacity: 1; visibility: visible; display: block; }
body.menu-open { overflow: hidden; }
.scrim { visibility: hidden; transition: opacity .25s ease, visibility .25s ease; }
@media (max-width: 900px) {
  main.split { grid-template-columns: 1fr; grid-template-rows: var(--row-a, 1fr) 6px 1fr; }
  .gutter { cursor: row-resize; }
}
@media (max-width: 1024px) {
  body .menu-toggle { display: inline-flex; }
  body .toolbar { padding: 10px 14px; }
  body .controls { position: fixed; inset-block: 0; inset-inline-end: 0; z-index: 80; width: min(330px, 86vw); margin: 0; flex-direction: column; align-items: stretch; flex-wrap: nowrap; gap: 14px; padding: 78px 18px calc(24px + env(safe-area-inset-bottom)); background: var(--panel); border-inline-start: 1px solid var(--border); box-shadow: -14px 0 44px var(--shadow); overflow-y: auto; transform: translateX(110%); transition: transform .3s cubic-bezier(.4, 0, .2, 1); }
  :root[dir="rtl"] .controls { box-shadow: 14px 0 44px var(--shadow); transform: translateX(-110%); }
  body.menu-open .controls, :root[dir="rtl"] body.menu-open .controls { transform: translateX(0); }
  .controls .seg { display: flex; width: 100%; }
  .controls .seg-btn { flex: 1 1 0; justify-content: center; padding: 11px 12px; font-size: 15px; }
  .controls .dropdown { width: 100%; }
  .controls .dd-button, .controls .toggle, .controls .run-btn { width: 100%; justify-content: center; padding: 12px 14px; font-size: 15px; }
  .controls .dd-list { position: static; min-width: 0; max-height: 42vh; margin-top: 8px; box-shadow: none; inset: auto; }
}
`

page:
    include = "ui.salam"
    title = "ویرایشگر آنلاین سلام | Salam Playground"
    lang = "english"
    dir = "left to right"
    favicon = "assets/icon.svg"

    meta: name = "description" content = "زبان برنامه‌نویسی سلام را همین حالا در مرورگر امتحان کنید: بنویسید، اجرا کنید و نتیجه را ببینید. بدون نصب، به فارسی، انگلیسی و عربی. Try the Salam programming language live in your browser. Salam supports English, Persian (Farsi), and Arabic and compiles to native code and WebAssembly." end
    meta: name = "application-name" content = "Salam Playground" end
    meta: name = "apple-mobile-web-app-title" content = "Salam Playground" end
    meta: name = "author" content = "SalamLang" end
    meta: name = "generator" content = "Salam" end
    meta: name = "google" content = "notranslate" end
    meta: name = "robots" content = "index, follow, max-image-preview:large, max-snippet:-1" end
    meta: name = "theme-color" content = "#ff7a18" end
    meta: name = "color-scheme" content = "dark light" end
    meta: property = "og:type" content = "website" end
    meta: property = "og:url" content = "https://editor.salamlang.ir/" end
    meta: property = "og:site_name" content = "ویرایشگر آنلاین سلام" end
    meta: property = "og:title" content = "ویرایشگر آنلاین سلام" end
    meta: property = "og:description" content = "زبان برنامه‌نویسی سلام را همین حالا در مرورگر امتحان کنید: بنویسید، اجرا کنید و نتیجه را ببینید. بدون نصب، به فارسی، انگلیسی و عربی." end
    meta: property = "og:locale" content = "fa_IR" end
    meta: property = "og:locale:alternate" content = "en_US" end
    meta: property = "og:image" content = "https://editor.salamlang.ir/assets/og-editor.png" end
    meta: property = "og:image:secure_url" content = "https://editor.salamlang.ir/assets/og-editor.png" end
    meta: property = "og:image:type" content = "image/png" end
    meta: property = "og:image:width" content = "1200" end
    meta: property = "og:image:height" content = "630" end
    meta: property = "og:image:alt" content = "ویرایشگر آنلاین سلام: زبان برنامه‌نویسی متن‌باز" end
    meta: name = "twitter:card" content = "summary_large_image" end
    meta: name = "twitter:title" content = "ویرایشگر آنلاین سلام" end
    meta: name = "twitter:description" content = "زبان برنامه‌نویسی سلام را همین حالا در مرورگر امتحان کنید: بنویسید، اجرا کنید و نتیجه را ببینید. بدون نصب، به فارسی، انگلیسی و عربی." end
    meta: name = "twitter:image" content = "https://editor.salamlang.ir/assets/og-editor.png" end
    meta: name = "twitter:image:alt" content = "ویرایشگر آنلاین سلام: زبان برنامه‌نویسی متن‌باز" end

    head_link: rel = "canonical" href = "https://editor.salamlang.ir/" end
    head_link: rel = "icon" href = "favicon.ico" sizes = "48x48" end
    head_link: rel = "icon" href = "assets/icon-192.png" type = "image/png" sizes = "192x192" end
    head_link: rel = "apple-touch-icon" href = "assets/apple-touch-icon.png" sizes = "180x180" end
    head_link: rel = "manifest" href = "site.webmanifest" end


    background = BG
    color = FG
    font = "Vazirmatn", system, sans
    accent = ACCENT
    height = 100vh

    font:
        name = "Vazirmatn"
        url = "assets/fonts/Vazirmatn-Variable.woff2"
        display = swap
    end

    style:
        content = STATE_CSS
    end

    Toolbar:
        Brand: name = "Salam Playground" end
        MenuToggle:
            MenuBar: end
            MenuBar: end
            MenuBar: end
        end
        Controls:
            Segmented: name = "mode-seg" text = "Mode" views = false
                SegButton: value = "app" text = "App" views = false only = "" end
                SegButton: value = "layout" text = "Layout" views = false only = "" end
            end
            Segmented: name = "lang-seg" text = "Language" views = false
                SegButton: value = "en" text = "English" views = false only = "" end
                SegButton: value = "fa" text = "فارسی" views = false only = "" end
            end
            box:
                id = "examples"
                class = "dropdown"
                DropdownButton: end
                DropdownList: end
            end
            Toggle: name = "theme" hint = "Theme" active = false
                span: class = "theme-ico" font size = 15 line height = 1 content = "◐" end
                span: class = "theme-lbl" content = "Auto" end
            end
            Toggle: name = "autorun" hint = "Auto-run" active = true
                Dot: end
                span: data view = "autorun" content = "Auto-run" end
            end
            RunButton: end
        end
    end

    Scrim: end

    main:
        id = "main-split"
        class = "split"
        layout = grid
        grow = 1
        min height = 0
        columns = fr(1), 6, fr(1)
        rows = fr(1)
        Pane: cls = "pane editor-pane"
            PaneHead:
                span: data view = "editor" content = "Editor" end
                IconButton: name = "copy-code" end
            end
            box:
                id = "edwrap"
                class = "editor-wrap"
                grow = 1
                min height = 0
                overflow = hidden
                background = EDITOR_BG
                box:
                    id = "ln"
                    class = "ln"
                    aria hidden = "true"
                    position = absolute
                    top = 0
                    bottom = 0
                    start = 0
                    width = 40
                    layer = 3
                    overflow = hidden
                    background = EDITOR_BG
                    border end = 1, solid, BORDER
                    font = "JetBrains Mono", "Fira Code", "Cascadia Code", "Consolas", "Vazirmatn", mono
                    font size = 14
                    line height = 1.6
                    color = MUTED
                    interactive = false
                    selectable = false
                    box:
                        id = "ln-inner"
                        class = "ln-inner"
                        position = absolute
                        top = 0
                        left = 0
                        right = 0
                        padding top = 14
                    end
                end
                box:
                    id = "hl"
                    class = "hl"
                    layout = flow
                    aria hidden = "true"
                    position = absolute
                    inset = 0
                    padding = 14, 16
                    padding start = 54
                    font = "JetBrains Mono", "Fira Code", "Cascadia Code", "Consolas", "Vazirmatn", mono
                    font size = 14
                    line height = 1.6
                    white space = keep
                    wrap text = false
                    overflow = hidden
                    layer = 1
                    interactive = false
                    color = EDITOR_FG
                    direction = ltr
                end
                box:
                    input:
                        id = "code"
                        class = "code"
                        type = "textarea"
                        aria label = "Code editor"
                        aria controls = "ac"
                        aria autocomplete = "list"
                        spellcheck = "false"
                        autocapitalize = "off"
                        autocorrect = "off"
                        autocomplete = "off"
                        placeholder = ""
                        position = absolute
                        inset = 0
                        padding = 14, 16
                        padding start = 54
                        margin = 0
                        font = "JetBrains Mono", "Fira Code", "Cascadia Code", "Consolas", "Vazirmatn", mono
                        font size = 14
                        line height = 1.6
                        white space = keep
                        wrap text = false
                        overflow = auto
                        layer = 2
                        background = transparent
                        color = transparent
                        caret = EDITOR_FG
                        direction = ltr
                        border = 0, none, transparent
                        radius = 0
                        width = 100%
                        height = 100%
                        focus outline = none
                        selection background = "#ff7a184d"
                    end
                end
            end
            box:
                id = "ac"
                class = "ac"
                role = "listbox"
                aria label = "Suggestions"
                dir = "ltr"
                hidden = true
                layout = row
                align = center
                gap = 6
                grow = 0
                overflow x = auto
                padding = 6, 8
                background = PANEL
                border top = 1, solid, BORDER
                scrollbar = none
            end
        end
        Gutter: end
        Pane: cls = "pane result-pane"
            PaneHead:
                Segmented: name = "view-seg" text = "Output view" views = true
                    SegButton: value = "run" text = "Run" views = true only = "" end
                    SegButton: value = "html" text = "HTML" views = true only = "layout" end
                    SegButton: value = "css" text = "CSS" views = true only = "layout" end
                    SegButton: value = "js" text = "JS" views = true only = "layout" end
                end
                HeadEnd:
                    span:
                        id = "status"
                        class = "status"
                        role = "status"
                        aria live = "polite"
                        aria atomic = "true"
                        font size = 12
                        color = MUTED
                    end
                    IconButton: name = "copy-out" end
                end
            end
            AnimBar:
                AnimButton: name = "anim-prev" hint = "Previous frame" text = "⏮" tr = true active = false end
                AnimButton: name = "anim-play" hint = "Play" text = "▶" tr = true active = false end
                AnimButton: name = "anim-next" hint = "Next frame" text = "⏭" tr = true active = false end
                input:
                    id = "anim-range"
                    class = "anim-range anim-tr"
                    type = "range"
                    value = "0"
                    grow = 1
                    min width = 70
                    height = 26
                    margin = 0
                    accent = ACCENT
                    cursor = pointer
                end
                span:
                    id = "anim-count"
                    class = "anim-count anim-tr"
                    grow = 0
                    font = "JetBrains Mono", "Fira Code", "Cascadia Code", "Consolas", "Vazirmatn", mono
                    font size = 12
                    color = MUTED
                    wrap text = false
                end
                AnimButton: name = "anim-speed" hint = "Speed" text = "12 fps" tr = true active = false end
                AnimButton: name = "anim-loop" hint = "Loop" text = "⟲" tr = true active = true end
                AnimButton: name = "anim-raw" hint = "Raw" text = "Raw" tr = false active = false end
            end
            box:
                id = "output"
                class = "output"
                layout = flow
                role = "region"
                aria label = "Output"
                grow = 1
                margin = 0
                padding = 14, 16
                overflow = auto
                font = "JetBrains Mono", "Fira Code", "Cascadia Code", "Consolas", "Vazirmatn", mono
                font size = 14
                line height = 1.6
                white space = keep
                wrap text = true
                color = FG
                background = EDITOR_BG
            end
            iframe:
                id = "preview"
                class = "preview"
                title = "Preview"
                sandbox = "allow-scripts"
                hidden = true
                grow = 1
                width = 100%
                border = 0, none, transparent
                background = "#ffffff"
            end
        end
    end

    script: src = "app.salam"
    end

    script: type = "application/ld+json"
        content = "{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Organization\",\"@id\":\"https://www.salamlang.ir/#org\",\"name\":\"SalamLang\",\"url\":\"https://www.salamlang.ir/\",\"logo\":\"https://editor.salamlang.ir/assets/icon-512.png\",\"sameAs\":[\"https://github.com/SalamLang\"]},{\"@type\":\"WebSite\",\"@id\":\"https://editor.salamlang.ir/#site\",\"url\":\"https://editor.salamlang.ir/\",\"name\":\"ویرایشگر آنلاین سلام\",\"alternateName\":\"Salam Playground\",\"inLanguage\":[\"fa\",\"en\"],\"publisher\":{\"@id\":\"https://www.salamlang.ir/#org\"}},{\"@type\":\"WebApplication\",\"@id\":\"https://editor.salamlang.ir/#app\",\"name\":\"ویرایشگر آنلاین سلام\",\"alternateName\":\"Salam Playground\",\"url\":\"https://editor.salamlang.ir/\",\"description\":\"Online editor and playground for the Salam programming language. Write, run and share Salam code in the browser.\",\"applicationCategory\":\"DeveloperApplication\",\"operatingSystem\":\"Any\",\"browserRequirements\":\"Requires JavaScript and WebAssembly\",\"inLanguage\":[\"fa\",\"en\"],\"image\":\"https://editor.salamlang.ir/assets/og-editor.png\",\"publisher\":{\"@id\":\"https://www.salamlang.ir/#org\"}}]}"
    end
    script:
        content = "if (\"serviceWorker\" in navigator) { addEventListener(\"load\", function () { navigator.serviceWorker.register(\"./sw.js\").catch(function () {}); }); }"
    end
end
