package page_parts

import str

const BODY_START := "</head>\n<body"
const STYLE_OPEN := "  <style>\n"
const STYLE_CLOSE := "  </style>\n"
const STYLE_LINK := "  <link rel=\"stylesheet\" href=\"style.css\">\n"
const SCRIPT_OPEN := "  <script>\n"
const DOC_END := "</body>\n</html>\n"

pub struct Parts:
    pub html: str = ""
    pub css: str = ""
    pub js: str = ""
end

func find_from(s: str, sub: str, from: int): int:
    n := s.Len()
    if from >= n: ret -1 end
    rest := s.Substr(from, n - from)
    idx := rest.Find(sub)
    if idx < 0: ret -1 end
    ret from + idx
end

func find_last(s: str, sub: str): int:
    mut last := -1
    mut at := s.Find(sub)
    until at >= 0:
        last = at
        at = find_from(s, sub, at + 1)
    end
    ret last
end

func closing(name: str): str: ret "</" + name + ">\n" end

pub func Split(doc: str): Parts:
    close := closing("script")
    link := "  <script src=\"script.js\">" + close
    mut r := Parts { html = doc }
    body := doc.Find(BODY_START)
    if body < 0: ret r end
    mut head := doc.Substr(0, body)
    mut rest := doc.Substr(body, doc.Len() - body)

    tail := "  " + close + DOC_END
    if str.EndsWith(rest, tail):
        open := rest.Find(SCRIPT_OPEN)
        if open >= 0:
            from := open + SCRIPT_OPEN.Len()
            r.js = rest.Substr(from, rest.Len() - tail.Len() - from)
            rest = rest.Substr(0, open) + link + DOC_END
        end
    end

    if str.EndsWith(head, STYLE_CLOSE):
        open := find_last(head, STYLE_OPEN)
        if open >= 0:
            from := open + STYLE_OPEN.Len()
            r.css = head.Substr(from, head.Len() - STYLE_CLOSE.Len() - from)
            head = head.Substr(0, open) + STYLE_LINK
        end
    end

    r.html = head + rest
    ret r
end
