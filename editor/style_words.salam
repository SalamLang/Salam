        122: ret fa ? "ابتدا\nوسط\nانتها\nهم‌تراز\nچپ\nراست" : "start\ncenter\nend\njustify\nleft\nright" end
        123: ret fa ? "هیچ\nزیرخط\nروخط\nخط خورده" : "none\nunderline\noverline\nstrike" end
        125: ret fa ? "توپر\nخط چین\nنقطه چین\nدوخطی\nموجی" : "solid\ndashed\ndotted\ndouble\nwavy" end
        126: ret fa ? "خودکار" : "auto" end
        127: ret fa ? "هیچ\nبزرگ\nکوچک\nحرف اول بزرگ" : "none\nupper\nlower\ncapitalize" end
        129: ret fa ? "هیچ" : "none" end
        131: ret fa ? "خودکار\nراست به چپ\nچپ به راست" : "auto\nrtl\nltr" end
        132: ret fa ? "عادی\nحفظ" : "normal\nkeep" end
        133: ret fa ? "هیچ" : "none" end
        134: ret fa ? "هیچ" : "none" end
        135: ret fa ? "هیچ" : "none" end
        136: ret fa ? "همه" : "all" end
        138: ret fa ? "خودکار\nهیچ\nکشیدن افقی\nکشیدن عمودی\nبزرگ‌نمایی" : "auto\nnone\npan x\npan y\npinch" end
    end
    ret ""
end

pub func States(fa: bool): str:
    if fa:
        ret "اشاره\nتمرکز درون\nتمرکز\nفشردن\nغیرفعال\nتیک‌خورده\nنامعتبر\nجای‌نوشته\nگزینش"
    end
    ret "hover\nfocus within\nfocus\nactive\ndisabled\nchecked\ninvalid\nplaceholder\nselection"
end

pub func Find(name: str): int:
    repeat Count() in i:
        if Name(i, false) == name or Name(i, true) == name:
            ret i
        end
    end
    ret -1
end
