pub component Toolbar:
    header:
        layout = row
        align = center
        justify = between
        gap = 14
        padding = 10, 16
        grow = 0
        background = PANEL
        border bottom = 1, solid, BORDER
        content: end
    end
end

pub component Brand(name: str):
    link:
        class = "brand"
        source = "."
        layout = row
        align = center
        gap = 10
        decoration = none
        radius = 4
        transition = 150ms
        hover opacity = 0.85
        focus outline = 2, solid, FG
        focus outline offset = 4
        span:
            class = "logo-mark"
            width = 30
            height = 30
            grow = 0
            background = ACCENT
        end
        heading:
            class = "brand-name"
            size = 1
            data view = "title"
            margin = 0
            font size = 15
            font weight = semibold
            line height = 1.2
            color = FG
            wrap text = false
            content = name
        end
    end
end

pub component Controls:
    box:
        id = "controls"
        class = "controls"
        layout = row
        align = center
        gap = 10
        wrap = true
        content: end
    end
end

pub component MenuToggle:
    button:
        id = "menu-toggle"
        class = "menu-toggle"
        type = "button"
        aria label = "Menu"
        aria controls = "controls"
        aria expanded = "false"
        layout = column
        width = 42
        height = 42
        padding = 0
        align = center
        justify = center
        layer = 90
        background = PANEL_2
        border = 1, solid, BORDER
        radius = 9
        hover border color = ACCENT
        content: end
    end
end

pub component MenuBar:
    span:
        class = "bar"
        width = 20
        height = 2
        radius = 2
        grow = 0
        background = FG
    end
end

pub component Scrim:
    box:
        id = "scrim"
        class = "scrim"
        aria hidden = "true"
        position = fixed
        inset = 0
        layer = 70
        background = "#00000073"
        opacity = 0
    end
end

pub component Segmented(name: str, text: str, views: bool):
    box:
        id = name
        class = views ? "seg views" : "seg"
        role = "group"
        aria label = text
        layout = row
        background = PANEL_2
        border = 1, solid, BORDER
        radius = 8
        overflow x = views ? "auto" : "hidden"
        overflow y = hidden
        max width = 100%
        content: end
    end
end

pub component SegButton(value: str, text: str, views: bool, only: str):
    button:
        class = views ? "seg-btn seg-sm" : "seg-btn"
        type = "button"
        data value = value
        data only = only
        aria pressed = "false"
        border = 0, none, transparent
        radius = 0
        padding = views ? "5, 10" : "7, 14"
        background = transparent
        color = MUTED
        font size = views ? 12.5 : 14
        wrap text = false
        cursor = pointer
        transition = 150ms
        hover color = FG
        content = text
    end
end

pub component Toggle(name: str, hint: str, active: bool):
    button:
        id = name
        type = "button"
        title = hint
        aria pressed = active ? "true" : "false"
        class = active ? "toggle on" : "toggle"
        layout = row
        align = center
        gap = 7
        padding = 7, 12
        background = PANEL_2
        color = MUTED
        border = 1, solid, BORDER
        radius = 8
        font size = 13
        cursor = pointer
        transition = 150ms
        hover color = FG
        content: end
    end
end

pub component Dot:
    span:
        class = "dot"
        width = 8
        height = 8
        grow = 0
        radius = 50%
        background = MUTED
        transition = 150ms
    end
end

component Caption(text: str, key: str, cls: str):
    span:
        class = cls
        content = text
    end
end

pub component DropdownButton:
    button:
        id = "dd-button"
        class = "dd-button"
        type = "button"
        aria haspopup = "menu"
        aria expanded = "false"
        layout = row
        align = center
        gap = 6
        padding = 7, 12
        background = PANEL_2
        color = FG
        border = 1, solid, BORDER
        radius = 8
        font size = 14
        cursor = pointer
        hover border color = ACCENT
        span:
            id = "dd-label"
            layout = row
            align = center
            gap = 7
        end
        span:
            class = "dd-caret"
            color = MUTED
            font size = 11
            transition = 150ms
            content = "▾"
        end
    end
end

pub component DropdownList:
    list:
        id = "dd-list"
        class = "dd-list"
        role = "menu"
        tabindex = "0"
        hidden = true
        position = absolute
        top = 100% + 5
        start = 0
        margin = 0
        padding = 5
        min width = 210
        max height = 340
        overflow = auto
        layer = 60
        background = PANEL
        border = 1, solid, BORDER
        radius = 10
        shadow = 0, 10, 30, 0, SHADOW
    end
end

pub component RunButton:
    button:
        id = "run"
        class = "run-btn"
        type = "button"
        disabled = true
        layout = row
        align = center
        gap = 8
        padding = 8, 18
        background = ACCENT
        color = ON_ACCENT
        radius = 8
        font size = 15
        font weight = bold
        cursor = pointer
        transition = 150ms
        hover brightness = 1.08
        disabled opacity = 0.5
        disabled cursor = wait
        span: font size = 12 content = "▶" end
        span: data view = "run" content = "Run" end
    end
end

pub component Pane(cls: str):
    section:
        class = cls
        min width = 0
        min height = 0
        content: end
    end
end

pub component PaneHead:
    box:
        class = "pane-head"
        layout = row
        align = center
        justify = between
        gap = 10
        grow = 0
        padding = 8, 14
        font size = 13
        color = MUTED
        background = PANEL
        border bottom = 1, solid, BORDER
        content: end
    end
end

pub component HeadEnd:
    box:
        layout = row
        align = center
        gap = 10
        grow = 0
        content: end
    end
end

pub component IconButton(name: str):
    button:
        id = name
        class = "icon-btn"
        type = "button"
        layout = row
        align = center
        gap = 6
        grow = 0
        padding = 4, 9
        background = PANEL_2
        color = MUTED
        border = 1, solid, BORDER
        radius = 7
        font size = 12
        line height = 1
        cursor = pointer
        transition = 150ms
        hover color = FG
        hover border color = ACCENT
        active translate = 0, 1
        span: class = "icon-mark mk-copy" width = 14 height = 14 grow = 0 background = "currentColor" end
        span: class = "icon-mark mk-check" width = 14 height = 14 grow = 0 background = "currentColor" visible = false end
        span: class = "icon-btn-lbl" data view = "copy" content = "Copy" end
    end
end

pub component Gutter:
    box:
        id = "gutter"
        class = "gutter"
        role = "separator"
        aria orientation = "vertical"
        aria valuenow = "50"
        aria valuemin = "0"
        aria valuemax = "100"
        tabindex = "0"
        title = "Drag to resize, double-click to reset"
        layer = 5
        background = BORDER
        cursor = move
        selectable = false
        transition = 150ms
        hover background = ACCENT
    end
end

pub component AnimBar:
    box:
        id = "anim-bar"
        class = "anim-bar"
        hidden = true
        layout = row
        align = center
        gap = 8
        grow = 0
        padding = 7, 12
        direction = ltr
        background = PANEL
        border bottom = 1, solid, BORDER
        content: end
    end
end

pub component AnimButton(name: str, hint: str, text: str, tr: bool, active: bool):
    button:
        id = name
        class = tr ? (active ? "anim-btn anim-tr on" : "anim-btn anim-tr") : "anim-btn"
        type = "button"
        title = hint
        layout = row
        align = center
        justify = center
        grow = 0
        min width = 30
        height = 26
        padding x = 8
        background = PANEL_2
        color = MUTED
        border = 1, solid, BORDER
        radius = 7
        font size = 12
        line height = 1
        cursor = pointer
        transition = 150ms
        hover color = FG
        hover border color = ACCENT
        active translate = 0, 1
        content = text
    end
end
