import gui.ui
import str

mut count := 0
mut name := ""
mut dark := false
mut items := Vector {} as Vector<str>

func esc(s: str): str:
    ret str.Replace(str.Replace(str.Replace(s, "&", "&amp;"), "<", "&lt;"), ">", "&gt;")
end

func view(): str:
    mut b := str.NewBuilder()
    str.BufAppend(b, `<!doctype html><html lang="en" dir="ltr"><head><meta charset="utf-8"><title>Salam native UI</title><style>
body{font-family:sans-serif;margin:0;background:#f3f5f9;color:#223}
body.dark{background:#1c1f26;color:#e8e8f0}
header{background:linear-gradient(90deg,#3557c5,#7a3fc5);color:white;padding:16px 24px}
h1{margin:0;font-size:24px}
main{display:flex;gap:16px;padding:16px;flex-wrap:wrap}
.card{background:white;border-radius:10px;padding:16px;box-shadow:0 2px 8px rgba(0,0,0,.15);width:280px;transition:background-color 200ms}
body.dark .card{background:#2a2f3a}
.card:hover{background:#eef3ff}
body.dark .card:hover{background:#333a4a}
button{padding:6px 14px;border-radius:6px;border:1px solid #3557c5;background:#3557c5;color:white;margin-right:6px}
button:hover{background:#2443a8}
button:active{background:#1a3388}
.count{font-size:40px;font-weight:bold;margin:8px 0}
input[type=text]{width:100%;box-sizing:border-box}
li{margin:2px 0}
.fa{direction:rtl;text-align:right}
</style></head><body`)
    if dark:
        str.BufAppend(b, ` class="dark"`)
    end
    str.BufAppend(b, `><header><h1>Salam native UI</h1></header><main><section class="card"><h2>Counter</h2><div class="count" id="count">` + count + `</div><button id="inc" onclick="inc()">Add</button><button id="dec" onclick="dec()">Less</button></section><section class="card"><h2>Greeting</h2><input id="name" type="text" placeholder="Your name" oninput="named(event)"><p id="hello">Hello, ` + esc(name.Len() > 0 ? name : "friend") + `!</p><label><input id="dark" type="checkbox" onchange="theme(event)"`)
    if dark:
        str.BufAppend(b, ` checked`)
    end
    str.BufAppend(b, `> Dark theme</label></section><section class="card"><h2>List</h2><button id="add" onclick="add()">Add item</button><ul>`)
    each it in items:
        str.BufAppend(b, `<li>` + esc(it) + `</li>`)
    end
    str.BufAppend(b, `</ul></section><section class="card fa"><h2>سلام دنیا</h2><p>این پنجره را خود سلام می‌کشد: چیدمان، متن فارسی و رویدادها.</p><a href="https://salamlang.ir">salamlang.ir</a></section></main></body></html>`)
    r := str.BufStr(b)
    str.BufFree(b)
    ret r
end

func main:
    ui.Handle("inc", ():
        count++
        println "count", count
    end)
    ui.Handle("dec", ():
        count--
        println "count", count
    end)
    ui.Handle("named", ():
        name = ui.CurrentEvent().value
        println "name", name
    end)
    ui.Handle("theme", ():
        dark = ui.CurrentEvent().checked
        println "dark", dark
    end)
    ui.Handle("add", ():
        items.Push("Item " + (items.Len() + 1))
        println "items", items.Len()
    end)
    ui.RunWith((): ret view() end, ui.Options { width = 960.0, height = 560.0 })
    println "closed after", ui.FrameCount(), "frames"
    items.Free()
end
