import io
import mem
import str
import os.desktop.desktop
import os.desktop.paths

func main:
    println "=== App paths example ==="
    app_id := "com.salamlang.native-desktop-demo"

    cfg := desktop.GetConfigDir()
    cache := desktop.GetCacheDir()
    data := desktop.GetDataDir()
    state := desktop.GetStateDir()
    logd := desktop.GetLogDir()
    defer mem.Free(cfg as void*)
    defer mem.Free(cache as void*)
    defer mem.Free(data as void*)
    defer mem.Free(state as void*)
    defer mem.Free(logd as void*)

    println "config_base: " + cfg
    println "cache_base: " + cache
    println "data_base: " + data
    println "state_base: " + state
    println "log_base: " + logd

    acfg := desktop.GetAppConfigDir(app_id)
    acache := desktop.GetAppCacheDir(app_id)
    adata := desktop.GetAppDataDirFor(app_id)
    astate := desktop.GetAppStateDir(app_id)
    alog := desktop.GetAppLogDir(app_id)
    arun := desktop.GetAppRuntimeDir(app_id)
    defer mem.Free(acfg as void*)
    defer mem.Free(acache as void*)
    defer mem.Free(adata as void*)
    defer mem.Free(astate as void*)
    defer mem.Free(alog as void*)
    defer mem.Free(arun as void*)

    println "app_config: " + acfg
    println "app_cache: " + acache
    println "app_data: " + adata
    println "app_state: " + astate
    println "app_log: " + alog
    println "app_runtime: " + arun

    // Ensure directories exist (safe/idempotent).
    ok := paths.EnsureAppDirs(app_id)
    println "ensure_app_dirs: " + (ok ? "yes" : "no")

    recent := paths.RecentDirs()
    defer recent.Free()
    println "recent/useful dirs: " + str.FromInt(recent.Len() as i64)
    repeat recent.Len() in i:
        println " - " + recent.Get(i)
    end
end
