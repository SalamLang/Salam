import io
import mem
import str
import time
import os.desktop.appearance
import os.desktop.accessibility
import os.desktop.capabilities

func main:
    println "=== Appearance & accessibility example ==="
    println "appearance: " + (capabilities.SupportsAppearance() ? "yes" : "no") + " - " + capabilities.AppearanceNote()
    println "accessibility: " + (capabilities.SupportsAccessibilityPrefs() ? "yes" : "no") + " - " + capabilities.AccessibilityNote()

    a := appearance.Get()
    defer mem.Free(a.theme as void*)
    defer mem.Free(a.accent_color as void*)
    defer mem.Free(a.source as void*)
    println "theme: " + a.theme
    println "prefers_dark: " + (a.prefers_dark ? "yes" : "no")
    println "accent_color: " + a.accent_color
    println "appearance_source: " + a.source

    acc := accessibility.Get()
    defer mem.Free(acc.note as void*)
    println "high_contrast: " + (acc.high_contrast ? "yes" : "no") + " (known=" + (acc.high_contrast_known ? "yes" : "no") + ")"
    println "reduced_motion: " + (acc.reduced_motion ? "yes" : "no") + " (known=" + (acc.reduced_motion_known ? "yes" : "no") + ")"
    println "screen_reader_hint: " + (acc.screen_reader_hint ? "yes" : "no")
    println "a11y_note: " + acc.note

    // Polling-based watcher example (no native change events).
    mut w := appearance.NewWatcher()
    mut polls := 0
    until polls < 3:
        changed := w.Poll()
        if changed:
            println "appearance changed -> theme=" + w.last.theme + " accent=" + w.last.accent_color
        else:
            println "poll " + str.FromInt(polls as i64) + ": no change"
        end
        time.SleepMs(250)
        polls++
    end
end
