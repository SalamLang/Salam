import os.applog.applog
import str

func main():
    path := applog.InitDefault("salam-example")
    defer str.Free(path)
    applog.Info("application started")
    applog.Warn("example warning")
    applog.Error("example error (logged)")
    applog.Close()
    println "log path:"
    println path
end
