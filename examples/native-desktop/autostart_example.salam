import io
import os.autostart
import os.desktop
import str

func main:
    println "=== Autostart example ==="
    println "platform: " + desktop.Platform()
    println "supported: " + (autostart.Supported() ? "yes" : "no")
    println "note: " + desktop.AutoStartNote()

    if not autostart.Supported():
        println "Autostart is not supported on this platform."
        ret
    end

    app_id := "com.salamlang.native-desktop-example"
    app_name := "Salam Native Desktop Example"
    exec_path := "/usr/bin/salam" // replace with your installed app path

    mut args := Vector {} as Vector<str>
    args.Push("--minimized")

    println "current status: " + autostart.Status(app_id)

    // Enable registers a per-user login item/startup entry (HKCU Run, LaunchAgent, or XDG autostart).
    if autostart.Enable(app_id, app_name, exec_path, args):
        println "enabled: " + (autostart.IsEnabled(app_id) ? "yes" : "no")
    else:
        println "enable failed (permissions or platform backend issue)"
    end

    // Disable removes the registration. Kept explicit so examples are safe to adapt.
    if autostart.Disable(app_id):
        println "disabled, status: " + autostart.Status(app_id)
    else:
        println "disable failed or entry was not present"
    end

    args.Free()
end
