import io
import mem
import str
import os.desktop.desktop
import os.desktop.capabilities

func main:
    println "=== Desktop info & capabilities example ==="
    capabilities.PrintSummary()

    host := desktop.Hostname()
    defer mem.Free(host as void*)
    println "hostname: " + host

    exe := desktop.ExecutablePath()
    exedir := desktop.ExecutableDir()
    defer mem.Free(exe as void*)
    defer mem.Free(exedir as void*)
    println "executable: " + exe
    println "executable_dir: " + exedir

    locale := desktop.SystemLocale()
    tz := desktop.SystemTimezone()
    theme := desktop.SystemTheme()
    de := desktop.DesktopEnvironment()
    defer mem.Free(locale as void*)
    defer mem.Free(tz as void*)
    defer mem.Free(theme as void*)
    defer mem.Free(de as void*)
    println "locale: " + locale
    println "timezone: " + tz
    println "theme: " + theme
    println "desktop_environment: " + de
    println "prefers_dark_mode: " + (desktop.PrefersDarkMode() ? "yes" : "no")

    browser := desktop.GetDefaultBrowser()
    mail := desktop.GetDefaultMailClient()
    defer mem.Free(browser as void*)
    defer mem.Free(mail as void*)
    println "default_browser: " + browser
    println "default_mail_client: " + mail

    disp := desktop.GetDisplayInfo()
    defer mem.Free(disp as void*)
    if disp.Len() > 0:
        println "display_info:"
        println disp
    else:
        println "display_info: (unavailable)"
    end

    st := capabilities.GetStatus("theme")
    defer mem.Free(st.feature as void*)
    defer mem.Free(st.reason as void*)
    println "theme capability: " + (st.supported ? "yes" : "no") + " - " + st.reason
end
