 * Salam Programming Language (2024-2026)
 */

import os.diagnostics.diagnostics
import os.updater.updater
import str

func main():
    println updater.Note()
    println "compare 1.2.0 vs 1.1.9:"
    if updater.IsNewer("1.2.0", "1.1.9"):
        println "newer"
    else:
        println "not newer"
    end
    info := updater.CheckFromStrings("1.0.0", "1.2.3", "https://example.invalid/app", "release notes", false)
    if info.available:
        println "update available"
    end

    println diagnostics.Note()
    report := diagnostics.CollectPathsReport("salam-example")
    println report
    str.Free(report)

    // Bundle creation is local-only and best-effort.
    res := diagnostics.CreateBundle(diagnostics.BundleOptions { app_id = "salam-example", app_name = "Example", app_version = "0.1.0" })
    if res.ok:
        println "bundle:"
        println res.path
    else:
        println res.note
    end
end
