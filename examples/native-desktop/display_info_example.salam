import io
import mem
import str
import os.desktop.display
import os.desktop.capabilities

func main:
    println "=== Display / screen information example ==="
    st := capabilities.GetStatus("display")
    defer mem.Free(st.feature as void*)
    defer mem.Free(st.reason as void*)
    println "display supported: " + (st.supported ? "yes" : "no")
    println "note: " + st.reason

    scale := display.ScaleFactor()
    println "scale_factor: " + str.FromFloat(scale)

    res := display.PrimaryResolution()
    println "primary_resolution: " + str.FromInt(res.width as i64) + "x" + str.FromInt(res.height as i64)

    wa := display.WorkArea()
    println "work_area: " + str.FromInt(wa.x as i64) + "," + str.FromInt(wa.y as i64) + " " + str.FromInt(wa.width as i64) + "x" + str.FromInt(wa.height as i64)

    snap := display.Snapshot()
    defer mem.Free(snap.source as void*)
    defer mem.Free(snap.note as void*)
    println "source: " + snap.source
    println "monitors: " + str.FromInt(snap.monitors.Len() as i64)
    println "primary_index: " + str.FromInt(snap.primary_index as i64)

    mut i := 0
    n := snap.monitors.Len()
    until i < n:
        m := snap.monitors.Get(i)
        println "- monitor[" + str.FromInt(i as i64) + "] id=" + m.id + " name=" + m.name + " primary=" + (m.primary ? "yes" : "no") + " " + str.FromInt(m.width_px as i64) + "x" + str.FromInt(m.height_px as i64)
        i++
    end
end
