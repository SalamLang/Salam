import io
import mem
import str
import gui.drop
import gui.drag

func main:
    println "=== Drag source initiation abstractions (best-effort) ==="
    println "drag source supported: " + (drag.Supported() ? "yes" : "no")
    println "note: " + drag.Note()

    // Payload helpers
    mut files := Vector {} as Vector<str>
    files.Push("/tmp/example-a.txt")
    files.Push("/tmp/example-b.png")
    p_files := drag.NewFilesPayload(files)
    println "files payload: " + drag.PayloadSummary(p_files)

    p_text := drag.NewTextPayload("Hello from Salam drag source")
    println "text payload: " + drag.PayloadSummary(p_text)

    p_uri := drag.NewURIPayload("https://salamlang.ir")
    println "uri payload: " + drag.PayloadSummary(p_uri)

    p_img := drag.NewImagePathPayload("/tmp/image.png", "image/png")
    println "image payload: " + drag.PayloadSummary(p_img)

    // Start drag (requires a native handle/toolkit integration in real apps).
    // On Linux, may delegate to external helpers (dragon/ripdrag) when available.
    // native := window.NativeHandle()
    // ok := drag.StartDragFiles(native, files)
    // ok2 := drop.StartDragText(native, "copied text") // convenience wrapper in gui.drop
    println "gui.drop wrappers: DragSourceSupported/StartDragFiles/StartDragText/StartDragURI/StartDragImagePath"
    println "last_error (if attempted): " + drag.LastError()

    p_files.files.Free()
    mem.Free(p_text.text as void*)
    mem.Free(p_uri.uri as void*)
    mem.Free(p_img.image_path as void*)
    mem.Free(p_img.mime as void*)
    files.Free()

    println "Example complete (compile-oriented; actual drag start depends on host integration)."
end
