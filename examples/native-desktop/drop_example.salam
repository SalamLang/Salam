import gui.drop
import gui.webview
import io
import os.desktop
import str

func describe_event(e: drop.DropEvent): str:
    mut s := "drop at (" + str.FromInt(e.x as i64) + "," + str.FromInt(e.y as i64) + ")"
    if (e.data.kind & drop.KIND_FILE) != 0:
        s = s + " files=" + str.FromInt(e.data.files.Len() as i64)
    end
    if (e.data.kind & drop.KIND_TEXT) != 0 and e.data.text.Len() > 0:
        s = s + " text"
    end
    if (e.data.kind & drop.KIND_URI) != 0 and e.data.uri.Len() > 0:
        s = s + " uri"
    end
    ret s
end

func main:
    println "=== Drag & drop example (conceptual/webview integration) ==="
    println "drag_drop support: " + (desktop.SupportsDragDrop() ? "yes" : "no")
    println "note: " + desktop.DragDropNote()

    // This example is compile-oriented and shows handler wiring. A real app typically
    // obtains a native window/widget handle from gui.webview or a platform window API
    // and passes it to gui.drop.Enable/SetHandlers.

    mut handlers := drop.DropHandlers {}

    handlers.on_enter = (e: drop.DropEvent):
        println "drag enter: " + describe_event(e)
        mut out := e
        out.accepted = true
        out.selected_effect = drop.EFFECT_COPY
        ret out
    end

    handlers.on_over = (e: drop.DropEvent):
        mut out := e
        out.accepted = true
        out.selected_effect = (e.allowed_effects & drop.EFFECT_COPY) != 0 ? drop.EFFECT_COPY : drop.EFFECT_NONE
        ret out
    end

    handlers.on_leave = ():
        println "drag leave"
    end

    handlers.on_drop = (e: drop.DropEvent):
        println "dropped: " + describe_event(e)
        if (e.data.kind & drop.KIND_FILE) != 0:
            repeat e.data.files.Len() in i:
                println "  file: " + e.data.files.Get(i)
            end
        end
        if e.data.text.Len() > 0:
            println "  text: " + e.data.text
        end
        if e.data.uri.Len() > 0:
            println "  uri: " + e.data.uri
        end
    end

    // Conceptual integration point:
    //   webview.Init(...)
    //   w := webview.Open(...)
    //   native := w.NativeHandle() // when exposed by the host binding
    //   drop.SetHandlers(native, handlers)
    //   ok := drop.Enable(native)
    // For now we demonstrate local dispatch helpers and keep the example compile-oriented.
    mut files := Vector {} as Vector<str>
    files.Push("/tmp/example.txt")
    sample := drop.NewFileEvent(120, 80, files, drop.EFFECT_ALL)
    println "sample event: " + describe_event(sample)
    files.Free()

    println "handlers configured (ready to attach to a native handle)"

    // Drag-source initiation abstractions (best-effort, separate from drop targets).
    println "drag-source supported: " + (drop.DragSourceSupported() ? "yes" : "no")
    println "drag-source note: " + drop.DragSourceNote()
    // drop.StartDragFiles(native, files) / drop.StartDragText(native, "text") / drop.StartDragURI / drop.StartDragImagePath
end
