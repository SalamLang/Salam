import io
import mem
import str
import os
import filepath
import os.desktop.desktop
import os.desktop.paths
import os.desktop.recent
import os.desktop.associations
import os.shell.open

func main:
    app_id := "salam.native.desktop.demo"

    println "=== Native desktop file/OS features (best-effort) ==="

    // App paths and dialog path helpers
    state := paths.AppStateDir(app_id)
    recent_files_store := paths.RecentFilesPath(app_id)
    recent_dirs_store := paths.RecentDirsPath(app_id)
    def_dialog := paths.DefaultDialogPath("")
    defer mem.Free(state as void*)
    defer mem.Free(recent_files_store as void*)
    defer mem.Free(recent_dirs_store as void*)
    defer mem.Free(def_dialog as void*)
    println "app_state_dir: " + state
    println "recent_files_store: " + recent_files_store
    println "recent_dirs_store: " + recent_dirs_store
    println "default_dialog_path: " + def_dialog

    // Recent files/directories tracking (app-local, portable)
    home := desktop.HomeDir()
    defer mem.Free(home as void*)
    _ = desktop.AddRecentDirectory(app_id, home, 10)
    example_file := filepath.Join(home, "example.txt")
    _ = recent.AddFile(app_id, example_file, 10)
    mem.Free(example_file as void*)

    dirs := desktop.RecentDirectories(app_id, 5)
    files := desktop.RecentFiles(app_id, 5)
    defer dirs.Free()
    defer files.Free()
    println "recent_directories: " + str.FromInt(dirs.Len() as i64)
    println "recent_files: " + str.FromInt(files.Len() as i64)
    println "recent note: " + recent.Note()

    // File association / default app query helpers (best-effort per platform)
    info := desktop.QueryFileAssociation(".txt")
    defer mem.Free(info.ext as void*)
    defer mem.Free(info.mime as void*)
    defer mem.Free(info.handler as void*)
    defer mem.Free(info.note as void*)
    println "assoc .txt mime: " + info.mime
    println "assoc .txt handler: " + (info.handler.Len() > 0 ? info.handler : "(unknown)")
    println "assoc supported: " + (info.supported ? "yes" : "no")
    println "assoc note: " + info.note

    // Registration helper is conservative and platform-guarded (Linux user-level .desktop/xdg-mime when available).
    // reg := desktop.RegisterFileAssociation(".salam", app_id, "Salam Demo", "/usr/bin/salam %f")
    // println "register supported: " + (reg.supported ? "yes" : "no")

    // Open with / reveal robustness
    // _ = desktop.OpenWith("code", "/path/to/file.txt")
    println "open-with helper: desktop.OpenWith(app, path) / open.OpenWith(app, path)"
    println "reveal robustness: falls back to parent folder when target missing (best-effort)"

    // Trash metadata (where feasible)
    meta := desktop.TrashInfo(home)
    defer mem.Free(meta.original_path as void*)
    defer mem.Free(meta.trash_path as void*)
    defer mem.Free(meta.info_path as void*)
    defer mem.Free(meta.note as void*)
    println "trash metadata supported: " + (meta.supported ? "yes" : "no")
    println "trash info path: " + (meta.info_path.Len() > 0 ? meta.info_path : "(n/a)")
    println "trash note: " + meta.note

    // File dialog/filter/path helpers (best-effort; dialog APIs are in gui.webview package)
    mut exts := Vector {} as Vector<str>
    exts.Push("txt")
    exts.Push("md")
    pattern := paths.BuildFilterPattern(exts)
    exts.Free()
    suggested := filepath.Join(paths.DefaultDialogPath(""), "notes.txt")
    println "dialog filter pattern: " + pattern
    println "suggested_save_path: " + suggested
    mem.Free(pattern as void*)
    mem.Free(suggested as void*)

    println "Done. Most operations are best-effort and depend on host desktop tools/platform support."
end
