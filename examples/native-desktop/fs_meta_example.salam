import fs.meta
import os
import io
import str

func main():
    path := "/tmp/salam-meta-example.txt"
    _n := io.WriteFile(path, "hello")
    m := meta.Get(path)
    if m.exists:
        println "exists"
        println meta.FormatMode(m.mode)
    end
    println meta.CanRead(path)
    println meta.CanWrite(path)
    _r := os.Remove(path)
end
