import os.lockfile
import gui.webview
import str

func main():
    lk := lockfile.WithAppLock("salam-example", "demo.lock", true)
    if lk.acquired:
        println "lock acquired"
    else:
        println "lock not acquired"
    end

    // webview storage helpers (package webview).
    st := webview.OpenStorage("salam-example")
    webview.StorageSet(st, "greeting", "hello")
    webview.SaveStorage(st)
    v := webview.StorageGet(st, "greeting", "")
    println v
    webview.CloseStorage(st)
    str.Free(v)

    lockfile.Release(lk)
end
