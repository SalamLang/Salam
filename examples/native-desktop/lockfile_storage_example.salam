import os.lockfile
import gui.webview.storage
import str

func main():
    lk := lockfile.WithAppLock("salam-example", "demo.lock", true)
    if lk.acquired:
        println "lock acquired"
    else:
        println "lock not acquired"
    end

    st := storage.Open("salam-example")
    storage.Set(st, "greeting", "hello")
    storage.Save(st)
    v := storage.Get(st, "greeting", "")
    println v
    storage.Close(st)
    str.Free(v)

    lockfile.Release(lk)
end
