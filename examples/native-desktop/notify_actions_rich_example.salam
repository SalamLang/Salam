import io
import mem
import str
import gui.notify
import os.desktop.capabilities

func main:
    println "=== Rich notifications & actions example ==="
    println "notifications: " + (capabilities.SupportsNotifications() ? "yes" : "no")
    println "notification_actions: " + (capabilities.SupportsNotificationActions() ? "yes" : "no")
    println "rich_notifications: " + (capabilities.SupportsRichNotifications() ? "yes" : "no")
    println "note: " + capabilities.NotificationsNote()
    println "module note: " + notify.CapabilitiesNote()

    if notify.RequestPermission().denied:
        println "permission denied: " + notify.PermissionStatus().reason
        ret
    end

    notify.OnClick(
        (id: str): println "clicked: " + id end
    )
    notify.OnAction(
        (id: str, action: str): println "action: " + id + " -> " + action end
    )

    mut actions := Vector {} as Vector<notify.Action>
    actions.Push(notify.NewAction("open", "Open"))
    actions.Push(notify.NewAction("dismiss", "Dismiss"))

    note := notify.Rich("Build finished", "Artifacts are ready to inspect.", "Salam desktop", "", "")
    mut n := note
    n.category = str.Clone("build")
    n.tag = str.Clone("salambuild")
    n.progress = 100
    n.actions = actions
    n.data = str.Clone("{\"kind\":\"build\",\"ok\":true}")

    id := notify.Show(n)
    if id.Len() == 0:
        println "show failed (backend unavailable or limited)"
    else:
        println "shown: " + id
        // Best-effort update/close demonstration.
        mut n2 := n
        n2.id = id
        n2.body = str.Clone("Updated: rich fields are API-level and backend-dependent.")
        _upd := notify.Update(n2)
        _closed := notify.Close(id)
        mem.Free(id as void*)
    end

    notify.CloseAll()
    println "done"
end
