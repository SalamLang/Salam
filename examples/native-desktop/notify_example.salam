import gui.notify
import io
import mem
import os.desktop
import str

func main:
    println "=== Native notifications example ==="
    desktop.PrintSummary()

    if notify.RequestPermission().granted == false:
        println "Notifications are not permitted: " + notify.PermissionStatus().reason
        ret
    end

    notify.OnClick((id: str):
        println "notification clicked: " + id
    end)

    notify.OnAction((id: str, action: str):
        println "notification action: " + id + " -> " + action
    end)

    mut note := notify.Notification {
        title = "Salam desktop",
        subtitle = "Hello from std/gui/notify",
        body = "This is a compile-oriented native notification example.",
        sound = "message",
        urgency = "normal",
        timeout_ms = 5000
    }

    id := notify.Show(note)
    if id.Len() == 0:
        println "Failed to show notification (backend may be unavailable)."
    else:
        println "Shown notification id: " + id

        // Update replaces the shown notification with new content.
        mut updated := note
        updated.id = id
        updated.body = "Updated body: notification APIs are working."
        if notify.Update(updated):
            println "Updated notification: " + id
        else:
            println "Update returned false (platform may not support in-place replacement)."
        end

        // Close is best-effort on some platforms.
        _closed := notify.Close(id)
        mem.Free(id as void*)
    end

    notify.CloseAll()
    println "done"
end
