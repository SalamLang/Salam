import io
import mem
import str
import os
import os.desktop.desktop
import os.shell.open

func main:
    println "=== Open / reveal / trash example ==="
    println "open capability: " + desktop.Reason("open")

    // Safe demonstrations (best-effort, may depend on host desktop tools).
    home := desktop.HomeDir()
    defer mem.Free(home as void*)
    println "home: " + home

    // Open a URL (best-effort; comment out if running headless).
    // ok := desktop.OpenURL("https://salamlang.ir")
    // println "open_url: " + (ok ? "yes" : "no")

    // Reveal/open home folder using desktop helpers and shell.open helpers.
    ok_folder := desktop.OpenFolder(home)
    println "desktop.OpenFolder(home): " + (ok_folder ? "attempted" : "failed")

    ok_reveal := open.ShowInFolder(home)
    println "open.ShowInFolder(home): " + (ok_reveal ? "attempted" : "failed")

    // Open-with (best-effort; app name/path is platform-specific)
    // _ = desktop.OpenWith("code", "/path/to/file.txt")
    // _ = open.OpenWith("TextEdit", "/path/to/file.txt")
    println "open-with helpers: desktop.OpenWith(app, path), open.OpenWith(app, path)"

    // Default handler queries
    browser := desktop.GetDefaultBrowser()
    handler := desktop.GetDefaultHandler("text/plain")
    defer mem.Free(browser as void*)
    defer mem.Free(handler as void*)
    println "default_browser: " + browser
    println "handler(text/plain): " + handler

    // Trash metadata (best-effort, non-destructive)
    meta := open.TrashInfo(home)
    defer mem.Free(meta.original_path as void*)
    defer mem.Free(meta.trash_path as void*)
    defer mem.Free(meta.info_path as void*)
    defer mem.Free(meta.note as void*)
    println "trash_metadata.supported: " + (meta.supported ? "yes" : "no")
    println "trash_metadata.note: " + meta.note

    println "Note: Trash/OpenURL actions are environment-dependent and intentionally conservative in this example."
end
