import io
import os.desktop
import os.service
import str

func main:
    println "=== Service / user-agent example ==="
    println "service support: " + (service.Supported() ? "yes" : "no")
    println "note: " + desktop.ServiceNote()

    if not service.Supported():
        println "Services/agents are not supported on this platform."
        ret
    end

    mut spec := service.Spec {
        id = "com.salamlang.native-desktop-agent",
        name = "Salam Native Desktop Agent",
        description = "Example background user agent managed by std/os/service",
        exec = "/usr/bin/salam",
        working_dir = "",
        kind = service.Kind.UserAgent,
        run_at_load = true,
        keep_alive = false
    }
    spec.args.Push("run")
    spec.args.Push("agent")

    println "is installed: " + (service.IsInstalled(spec.id, spec.kind) ? "yes" : "no")
    println "status: " + service.Status(spec.id, spec.kind)

    // Install writes the platform unit/plist/registration. System services may require privileges.
    if service.Install(spec):
        println "installed: " + service.Status(spec.id, spec.kind)
    else:
        println "install failed (permissions, unsupported kind, or backend error)"
    end

    // Start/Stop behavior differs by platform and kind (Windows UserAgent runs at login).
    if service.Start(spec.id, spec.kind):
        println "start requested"
    else:
        println "start not performed (may be unsupported for this kind)"
    end

    println "status after start attempt: " + service.Status(spec.id, spec.kind)

    _stopped := service.Stop(spec.id, spec.kind)
    if service.Uninstall(spec.id, spec.kind):
        println "uninstalled, status: " + service.Status(spec.id, spec.kind)
    else:
        println "uninstall failed or entry was not present"
    end

    spec.args.Free()
end
