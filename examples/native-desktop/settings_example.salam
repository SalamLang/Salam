import io
import mem
import os.settings
import str

func main:
    println "=== Settings store example ==="

    // Store is saved under the platform config directory for this app id.
    mut store := settings.Init("com.salamlang.native-desktop-example")
    defer settings.Free(store)

    println "settings path: " + settings.Path(store)

    // Simple keys
    settings.Set(store, "theme", "dark")
    settings.Set(store, "language", "en")

    // Sectioned keys (written as [window] groups in the properties file)
    settings.SetSection(store, "window", "width", "1200")
    settings.SetSection(store, "window", "height", "800")
    settings.SetSection(store, "window", "maximized", "true")

    saved := settings.Save(store)
    println "saved: " + (saved ? "yes" : "no")

    // Read back with defaults
    theme := settings.Get(store, "theme", "light")
    width := settings.GetIntSection(store, "window", "width", 640)
    maximized := settings.GetBoolSection(store, "window", "maximized", false)
    missing := settings.Get(store, "missing.key", "fallback")

    println "theme=" + theme
    println "window.width=" + str.FromInt(width)
    println "window.maximized=" + (maximized ? "true" : "false")
    println "missing=" + missing

    keys := settings.Keys(store)
    defer keys.Free()
    println "keys count: " + str.FromInt(keys.Len() as i64)

    // Cleanup example key (does not remove the file)
    _removed := settings.DeleteSection(store, "window", "maximized")
    _saved2 := settings.Save(store)
end
