import io
import mem
import str
import os.desktop.sysinfo
import os.desktop.capabilities

func main:
    println "=== System information example ==="
    st := capabilities.GetStatus("sysinfo")
    defer mem.Free(st.feature as void*)
    defer mem.Free(st.reason as void*)
    println "sysinfo supported: " + (st.supported ? "yes" : "no")
    println "note: " + st.reason

    info := sysinfo.GetInfo()
    defer mem.Free(info.os as void*)
    defer mem.Free(info.os_name as void*)
    defer mem.Free(info.os_version as void*)
    defer mem.Free(info.arch as void*)
    defer mem.Free(info.hostname as void*)
    defer mem.Free(info.username as void*)

    println "os: " + info.os
    println "os_name: " + info.os_name
    println "os_version: " + info.os_version
    println "arch: " + info.arch
    println "hostname: " + info.hostname
    println "username: " + info.username
    println "cpu_count: " + str.FromInt(info.cpu_count as i64)
    println "memory_total_bytes: " + str.FromInt(info.memory_total_bytes)
    println "memory_available_bytes: " + str.FromInt(info.memory_available_bytes)
end
