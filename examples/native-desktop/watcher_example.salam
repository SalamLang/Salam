import io
import mem
import str
import os
import filepath
import fs.watcher

func main:
    println "=== Polling directory watcher example ==="

    root := filepath.Join(os.TempDir(), "salam-watch-demo")
    _mk := os.MkdirAll(root)
    println "watch root: " + root

    mut w := watcher.New(root, true)
    defer watcher.Free(w)
    watcher.Snapshot(w)

    // Simulate a change (create a file)
    p := filepath.Join(root, "hello.txt")
    _w := io.WriteFile(p, "hello")
    println "created file: " + p

    events := watcher.Poll(w)
    defer events.Free()
    println "events: " + str.FromInt(events.Len() as i64)
    repeat events.Len() in i:
        e := events.Get(i)
        mut kind := "modified"
        if e.kind == watcher.EventKind.Created: kind = "created"
        else e.kind == watcher.EventKind.Deleted: kind = "deleted"
        end
        println " - " + kind + ": " + e.path
    end

    // Cleanup (best-effort)
    _r := os.Remove(p)
    _rr := os.RemoveAll(root)
    mem.Free(p as void*)
    mem.Free(root as void*)
end
