/*
 * Salam Programming Language (2024-2026)
 *
 * Conceptual webview menu/edit-actions example (best-effort).
 */

import gui.webview

func main():
    cfg := webview.Config { id = "ir.salamlang.example.menu", name = "Menu Example" }
    webview.Init(cfg)

    win := webview.Open(
        webview.WindowOptions {
            label = "main", title = "Menu Example", width = 900, height = 700, html = "<html><body contenteditable='true'><h1>Edit me</h1></body></html>"
        }
    )

    m := webview.DefaultMenu("Menu Example")
    webview.SetMenu(win, m.items)

    webview.OnMenu(
        (id: str): if webview.IsEditAction(id): _ok := webview.ApplyEditAction(win, id) else id == webview.ACTION_QUIT: _q := webview.QuitApp() end end
    )

    // webview.Run() blocks in a real desktop session.
    _ = win
end
