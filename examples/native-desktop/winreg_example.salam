import io
import mem
import os.desktop
import os.winreg
import str

func main:
    println "=== Windows Registry example ==="
    println "registry supported: " + (winreg.IsSupported() ? "yes" : "no")
    println "note: " + desktop.RegistryNote()

    if not SALAM_OS_WINDOWS:
        println "This example is Windows-only; skipping registry operations on " + desktop.Platform() + "."
        ret
    end

    if SALAM_OS_WINDOWS:
        root := winreg.HKCU
        path := "Software\\SalamLang\\NativeDesktopExample"

        // Create/open a key for writing.
        mut key := winreg.CreateKey(root, path, winreg.KEY_WRITE | winreg.KEY_READ)
        if not key.ok:
            println "Failed to create/open registry key."
            ret
        end

        _s := winreg.SetString(key, "Greeting", "سلام")
        _d := winreg.SetDword(key, "Enabled", 1 as u32)
        _q := winreg.SetQword(key, "Counter", 42)

        name := winreg.GetString(key, "Greeting")
        if name.ok:
            println "Greeting=" + name.value
            mem.Free(name.value as void*)
        end

        enabled := winreg.GetInt(key, "Enabled")
        if enabled.ok:
            println "Enabled=" + str.FromInt(enabled.value)
        end

        values := winreg.ListValues(key)
        println "values: " + str.FromInt(values.Len() as i64)
        values.Free()

        _dv := winreg.DeleteValue(key, "Counter")
        winreg.Close(key)

        // Cleanup demo key (best-effort).
        _dk := winreg.DeleteKey(root, path)
        _parent_cleanup := winreg.DeleteKey(root, "Software\\SalamLang")
        println "registry demo complete"
    end
end
