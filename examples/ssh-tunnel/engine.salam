package engine

import os
import env
import str
import sync
import gui.ui
import os.shell
import os.process
import os.desktop
import net.dns
import net.tcp
import net.tunnel

include "profile.salam"
include "helper.salam"
include "resolver.salam"
include "remote.salam"

pub const PHASE_IDLE := 0
pub const PHASE_SSH := 1
pub const PHASE_ADMIN := 2
pub const PHASE_UP := 3
pub const PHASE_RECONNECT := 4
pub const PHASE_CLOSING := 5

mut _lock := sync.NewMutex()
mut _shared := Snapshot {}
mut _want_stop := false
mut _job := profile.Profile {}
mut _upstream := ""

pub struct Snapshot:
    pub phase: int = 0
    pub message: str = ""
    pub exit_ip: str = ""
    pub dns_server: str = ""
    pub udp_state: str = ""
    pub udp_note: str = ""
    pub since: i64 = 0 as i64
    pub up: i64 = 0 as i64
    pub down: i64 = 0 as i64
    pub active: i64 = 0 as i64
    pub dns: i64 = 0 as i64
    pub broken: bool = false
end

func set_phase(phase: int, message: str):
    mut s := CurrentSnapshot()
    s.phase = phase
    s.message = message
    Publish(s)
end

func stop_wanted(): bool:
    sync.Lock(_lock)
    w := _want_stop
    sync.Unlock(_lock)
    ret w
end

func free_port(): int:
    srv := tcp.BindOn("127.0.0.1", 0)
    if not tcp.Ok(srv):
        ret 0
    end
    port := tcp.Port(srv)
    tcp.CloseServer(srv)
    ret port
end

func resolve_server(host: str): str:
    if tunnel.IsIP(host):
        ret host
    end
    found := dns.LookupA(host)
    if found.Len() == 0:
        ret ""
    end
    ret found[0]
end

func ssh_command(pr: profile.Profile, ip: str, socks_port: int): process.Command:
    mut cmd := process.NewCommand("/usr/bin/ssh")
    cmd.Arg("-F")
    cmd.Arg("/dev/null")
    cmd.Arg("-N")
    cmd.Arg("-D")
    cmd.Arg("127.0.0.1:" + str.FromInt(socks_port as i64))
    cmd.Arg("-p")
    cmd.Arg(pr.port)
    cmd.Arg("-l")
    cmd.Arg(pr.user)
    mut options := Vector {} as Vector<str>
    options.Push("HostKeyAlias=" + pr.host)
    options.Push("UserKnownHostsFile=\"" + profile.KnownHostsPath() + "\"")
    options.Push("StrictHostKeyChecking=accept-new")
    options.Push("ExitOnForwardFailure=yes")
    options.Push("ServerAliveInterval=10")
    options.Push("ServerAliveCountMax=3")
    options.Push("ConnectTimeout=20")
    options.Push("NumberOfPasswordPrompts=1")
    options.Push("ControlMaster=yes")
    options.Push("ControlPath=\"" + profile.ControlPath() + "\"")
    if pr.password.Len() > 0:
        options.Push("PreferredAuthentications=password,keyboard-interactive")
    end
    each o in options:
        cmd.Arg("-o")
        cmd.Arg(o)
    end
    cmd.Arg("--")
    cmd.Arg(ip)
    if pr.password.Len() > 0:
        cmd.Env("SSH_ASKPASS", desktop.ExecutablePath())
        cmd.Env("SSH_ASKPASS_REQUIRE", "force")
        cmd.Env("SALAM_TUNNEL_ASKPASS", "1")
        cmd.Env("SALAM_TUNNEL_PASSWORD", pr.password)
    else:
        cmd.Env("SSH_ASKPASS_REQUIRE", "never")
    end
    cmd.stdin_mode = 2
    cmd.stdout_mode = 2
    cmd.stderr_mode = 1
    ret cmd
end

func last_line(text: str, fallback: str): str:
    mut out := fallback
    each line in str.Split(text, "\n"):
        clean := line.Trim()
        if clean.Len() > 0 and not clean.StartsWith("Warning:"):
            out = clean
        end
    end
    ret out
end

func open_ssh(pr: profile.Profile, ip: str, port: int, why &: str): process.Child:
    _old := os.Remove(profile.ControlPath())
    mut child := process.Launch(ssh_command(pr, ip, port))
    if not child.ok:
        why = "cannot start /usr/bin/ssh"
        ret child
    end
    mut errors := ""
    deadline := sync.NowMs() + (60000 as i64)
    until sync.NowMs() < deadline and not stop_wanted():
        chunk := child.ReadErrAvailable(0)
        errors += chunk.data
        if not child.Poll():
            tail := child.ReadErrFor(200)
            why = last_line(errors + tail.data, "ssh stopped")
            ret child
        end
        if tcp.WaitListening("127.0.0.1", port, 300):
            found := resolver.Pick(port)
            if found.Len() > 0:
                _upstream = found
                why = ""
                ret child
            end
            why = stop_wanted() ? "cancelled" : "no DNS server answered through the server (is TCP forwarding allowed?)"
            close_ssh(child)
            ret child
        end
    end
    why = stop_wanted() ? "cancelled" : last_line(errors, "the server did not answer in time")
    close_ssh(child)
    ret child
end

func close_ssh(child &: process.Child):
    if child.ok and child.Poll():
        _t := child.Terminate()
        st := child.Wait(2000)
        if st.timed_out:
            _k := child.Kill()
            _w := child.Wait(2000)
        end
    end
end

func shell_quote(text: str): str:
    ret "'" + str.Replace(text, "'", "'\\''") + "'"
end

func run_as_admin(args: Vector<str>, prompt: str): str:
    mut line := shell_quote(desktop.ExecutablePath())
    each a in args:
        line = line + " " + shell_quote(a)
    end
    line += " > /dev/null 2>&1 &"
    escaped := str.Replace(str.Replace(line, "\\", "\\\\"), "\"", "\\\"")
    script := "do shell script \"" + escaped + "\" with prompt \"" + prompt +
        "\" with administrator privileges"
    mut cmd := process.NewCommand("/usr/bin/osascript")
    cmd.Arg("-e")
    cmd.Arg(script)
    r := process.RunCommand(cmd, "", 180000)
    if not r.started:
        ret "cannot run osascript"
    end
    if r.timed_out:
        ret "the administrator prompt timed out"
    end
    if not r.status.Success():
        ret "administrator permission was not given"
    end
    ret ""
end

func read_status(): str:
    if not os.Exists(helper.STATUS_FILE):
        ret ""
    end
    ret os.ReadFile(helper.STATUS_FILE)
end

func number_of(text: str, key: str): i64:
    v := profile.ValueOf(text, key)
    p := v as u8*
    mut n := 0 as i64
    repeat v.Len() in i:
        c := p[i] as int
        if c < ('0' as int) or c > ('9' as int):
            break
        end
        n = n * (10 as i64) + ((c - ('0' as int)) as i64)
    end
    ret n
end

func helper_running(): bool:
    text := read_status()
    ret profile.ValueOf(text, "state") == "up" and helper.ProcessAlive(profile.ValueOf(text, "pid"))
end

func wait_helper(old_beat: str): str:
    deadline := sync.NowMs() + (15000 as i64)
    until sync.NowMs() < deadline:
        text := read_status()
        if profile.ValueOf(text, "beat") != old_beat:
            state := profile.ValueOf(text, "state")
            if state == "up":
                ret ""
            end
            if state == "error":
                ret profile.ValueOf(text, "message")
            end
        end
        sync.SleepMs(200)
    end
    ret "the tunnel helper did not start"
end

func stop_helper():
    _w := os.WriteFile(profile.StopPath(), "stop\n")
    deadline := sync.NowMs() + (8000 as i64)
    until sync.NowMs() < deadline and helper_running():
        sync.SleepMs(200)
    end
end

func public_ip(): str:
    mut cmd := process.NewCommand("/usr/bin/curl")
    cmd.Arg("-fsS")
    cmd.Arg("--max-time")
    cmd.Arg("15")
    cmd.Arg("https://api.ipify.org")
    r := process.RunCommand(cmd, "", 20000)
    ret r.status.Success() ? r.stdout.Trim() : ""
end

func check_exit_ip():
    mut found := ""
    repeat 3:
        if found.Len() == 0 and CurrentSnapshot().phase == PHASE_UP:
            found = public_ip()
        end
    end
    mut s := CurrentSnapshot()
    if s.phase != PHASE_UP:
        ret
    end
    s.exit_ip = found.Len() > 0 ? found : "unknown"
    Publish(s)
end

func finish(message: str):
    Publish(Snapshot { phase = PHASE_IDLE, message = message, broken = NeedsRepair() })
end

func engine_run():
    pr := _job
    set_phase(PHASE_SSH, "Signing in to " + pr.host)
    ip := resolve_server(pr.host)
    if ip.Len() == 0:
        finish("Cannot find the address of " + pr.host)
        ret
    end
    port := free_port()
    mut why := ""
    mut ssh := open_ssh(pr, ip, port, why)
    if why.Len() > 0 and why != "cancelled" and not why.Includes("denied") and not stop_wanted():
        set_phase(PHASE_SSH, "The server is slow, trying again")
        ssh.Close()
        why = ""
        ssh = open_ssh(pr, ip, port, why)
    end
    if why.Len() > 0:
        finish(why == "cancelled" ? "" : why)
        ret
    end
    mut relay := "-"
    mut relay_note := ""
    if pr.udp:
        set_phase(PHASE_SSH, "Preparing the UDP relay")
        installed := remote.Install(relay_note)
        if installed.Len() > 0:
            relay = installed
        end
    end
    set_phase(PHASE_ADMIN, "Waiting for your administrator password")
    _r := os.Remove(profile.StopPath())
    old_beat := profile.ValueOf(read_status(), "beat")
    mut args := Vector {} as Vector<str>
    args.Push("--helper")
    args.Push(ip)
    args.Push(str.FromInt(port as i64))
    args.Push(str.FromInt(os.Pid() as i64))
    args.Push(profile.StopPath())
    args.Push(_upstream)
    args.Push(relay)
    args.Push(profile.ControlPath())
    mut failed := run_as_admin(
        args, "Salam Tunnel needs permission to route this Mac through your server."
    )
    if failed.Len() == 0:
        failed = wait_helper(old_beat)
    end
    if failed.Len() > 0 or stop_wanted():
        stop_helper()
        close_ssh(ssh)
        finish(failed)
        ret
    end
    Publish(Snapshot { phase = PHASE_UP, since = sync.NowMs(), udp_note = relay_note })
    _c := spawn(check_exit_ip)
    mut ended := ""
    mut beat := ""
    mut beat_at := sync.NowMs()
    mut delay := 1000
    mut next_try := 0 as i64
    until not stop_wanted() and ended.Len() == 0:
        sync.SleepMs(500)
        text := read_status()
        fresh := profile.ValueOf(text, "beat")
        if fresh != beat:
            beat = fresh
            beat_at = sync.NowMs()
        end
        if profile.ValueOf(text, "state") != "up":
            ended = "The tunnel stopped " + profile.ValueOf(text, "message")
        else sync.NowMs() - beat_at > (10000 as i64) and not helper_running():
            ended = "The tunnel helper stopped unexpectedly"
        end
        mut s := CurrentSnapshot()
        s.up = number_of(text, "up")
        s.down = number_of(text, "down")
        s.active = number_of(text, "active")
        s.dns_server = profile.ValueOf(text, "resolver")
        s.udp_state = profile.ValueOf(text, "udp")
        s.dns = number_of(text, "dns")
        if ssh.ok:
            _drain := ssh.ReadErrAvailable(0)
        end
        if not ssh.ok or not ssh.Poll():
            s.phase = PHASE_RECONNECT
            if sync.NowMs() >= next_try and not stop_wanted():
                Publish(s)
                mut again := ""
                ssh.Close()
                ssh = open_ssh(pr, ip, port, again)
                if again.Len() == 0:
                    s.phase = PHASE_UP
                    s.message = ""
                    delay = 1000
                    Publish(s)
                    _again := spawn(check_exit_ip)
                else:
                    ssh.ok = false
                    s.message = again
                    next_try = sync.NowMs() + (delay as i64)
                    delay = delay < 15000 ? delay * 2 : delay
                end
            end
        else:
            s.phase = PHASE_UP
        end
        Publish(s)
    end
    set_phase(PHASE_CLOSING, "Restoring your network")
    stop_helper()
    close_ssh(ssh)
    finish(ended)
end

func engine_repair_run():
    mut args := Vector {} as Vector<str>
    args.Push("--repair")
    failed := run_as_admin(args, "Salam Tunnel needs permission to restore your DNS settings.")
    deadline := sync.NowMs() + (8000 as i64)
    until sync.NowMs() < deadline and failed.Len() == 0 and os.Exists(helper.DNS_FILE):
        sync.SleepMs(200)
    end
    finish(failed.Len() > 0 ? failed : "Network settings restored")
end

pub func CurrentSnapshot(): Snapshot:
    sync.Lock(_lock)
    copy := _shared
    sync.Unlock(_lock)
    ret copy
end

pub func Publish(s: Snapshot):
    sync.Lock(_lock)
    _shared = s
    sync.Unlock(_lock)
    ui.Invalidate()
end

pub func RequestStop():
    sync.Lock(_lock)
    _want_stop = true
    sync.Unlock(_lock)
end

pub func NeedsRepair(): bool:
    ret os.Exists(helper.DNS_FILE) and not helper_running()
end

pub func StopOrphans():
    mut args := Vector {} as Vector<str>
    args.Push("-f")
    args.Push("ssh .*UserKnownHostsFile=\"" + profile.KnownHostsPath())
    _r := shell.Run("/usr/bin/pkill", args)
end

pub func StartTunnel(pr: profile.Profile):
    sync.Lock(_lock)
    _want_stop = false
    sync.Unlock(_lock)
    set_phase(PHASE_SSH, "Starting")
    _job = pr
    _t := spawn(engine_run)
end

pub func StartRepair():
    set_phase(PHASE_CLOSING, "Restoring your network")
    _t := spawn(engine_repair_run)
end

pub func AskPass(): int:
    args := os.Args()
    prompt := args.Len() > 1 ? args.Get(1) : ""
    if not prompt.Includes("assword"):
        ret 1
    end
    println env.Get("SALAM_TUNNEL_PASSWORD")
    ret 0
end
