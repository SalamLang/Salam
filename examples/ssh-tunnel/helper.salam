package helper

import os
import str
import fs
import sync
import os.signal
import net.tun
import net.tunnel
import net.socks
import net.udprelay
import os.process

include "profile.salam"
include "resolver.salam"
include "host.salam"

mut _udp_wanted := false
mut _relay := udprelay.Client {}
mut _socks_port := 0
mut _relay_port := 0

func dial_relay(): i64:
    mut client := socks.NewClient("127.0.0.1", _socks_port)
    client.timeout_ms = 20000
    ret socks.DialConn(client, "127.0.0.1", _relay_port).fd
end

func pause(set: void*, arrived: void*): int:
    if SALAM_OS_WINDOWS:
        sync.SleepMs(1000)
        _unused := set == arrived
        ret 0
    else:
        ret signal.WaitTimeout(set, arrived, 1000)
    end
end

func number(text: str): int:
    p := text as u8*
    mut n := 0
    repeat text.Len() in i:
        c := p[i] as int
        if c < ('0' as int) or c > ('9' as int) or n > 100000000:
            ret 0
        end
        n = n * 10 + (c - ('0' as int))
    end
    ret n
end

func prepare_state_dir():
    if not os.Exists(host.StateDir()):
        _m := os.Mkdir(host.StateDir())
    end
    _c := fs.Chmod(host.StateDir(), 493)
end

func write_status(state: str, message: str, st: tun.Stats):
    udp_state := not _udp_wanted ? "off" : (_relay.Ready() ? "on" : "waiting")
    text := "state=" + state + "\nmessage=" + str.Replace(
        message, "\n", " "
    ) + "\npid=" + str.FromInt(
        os.Pid() as i64
    ) + "\nbeat=" + str.FromInt(
        sync.NowMs()
    ) + "\nup=" + str.FromInt(st.bytes_up) + "\ndown=" + str.FromInt(
        st.bytes_down
    ) + "\nactive=" + str.FromInt(st.active) + "\ntotal=" + str.FromInt(
        st.connections
    ) + "\ndns=" + str.FromInt(
        st.dns_queries
    ) + "\nresolver=" + resolver.Current() + "\nudp=" + udp_state + "\n"
    next := host.StatusFile() + ".new"
    _w := os.WriteFile(next, text)
    _m := os.Move(next, host.StatusFile())
    _c := fs.Chmod(host.StatusFile(), 420)
end

func helper_options(server_ip: str, socks_port: int): tun.Options:
    mut blocked := Vector {} as Vector<int>
    blocked.Push(443)
    mut exclude := Vector {} as Vector<str>
    exclude.Push(server_ip)
    mut client := socks.NewClient("127.0.0.1", socks_port)
    client.timeout_ms = 20000
    proxy := tunnel.ProxyDialer {
        upstream = tunnel.DirectDialer {}, hop = socks.NewConnector(client)
    }
    ret tun.Options {
        dialer = resolver.Failover { inner = proxy },
        exclude = exclude,
        upstream = resolver.PLACEHOLDER + ":53",
        idle_ms = 900000,
        sniff = false,
        relay_udp = _udp_wanted,
        udp = _relay,
        udp_blocked = blocked
    }
end

pub func RunHelper(
    server_ip: str,
    socks_port: int,
    parent: str,
    stop_file: str,
    first_dns: str,
    relay_port: int,
    token_file: str
): int:
    prepare_state_dir()
    if socks_port == 0 or not profile.IsName(server_ip, ".") or not profile.IsName(first_dns, "."):
        write_status("error", "bad helper arguments", tun.Stats {})
        ret 2
    end
    set := signal.NewSet()
    if not SALAM_OS_WINDOWS:
        _a := signal.AddSignal(set, 1)
        _b := signal.AddSignal(set, 2)
        _c := signal.AddSignal(set, 15)
        _d := signal.Block(set)
    end
    host.RestoreDns()
    host.DropRoute(server_ip)
    if relay_port > 0:
        _udp_wanted = true
        _socks_port = socks_port
        _relay_port = relay_port
        _relay = udprelay.NewSocketClient(
            (): ret dial_relay() end, os.ReadFile(token_file).Trim()
        )
    end
    resolver.Use(first_dns)
    session := tun.Start(helper_options(server_ip, socks_port))
    if not session.ok:
        write_status("error", session.error, tun.Stats {})
        ret 1
    end
    if not host.TakeOverDns(session.dns):
        host.RestoreDns()
        tun.Stop(session)
        write_status("error", "could not change the system DNS servers", tun.Stats {})
        ret 1
    end
    resolver.Watch(socks_port, 20000)
    arrived := signal.NewSet()
    mut ticks := 0
    mut go := true
    until go:
        write_status("up", session.name, tun.SessionStats(session))
        got := pause(set, arrived)
        ticks++
        if got > 0 or os.Exists(stop_file) or not process.Alive(number(parent)):
            go = false
        else ticks % 5 == 0:
            host.KeepServerRoute(server_ip)
        end
    end
    last := tun.SessionStats(session)
    host.RestoreDns()
    tun.Stop(session)
    host.DropRoute(server_ip)
    write_status("stopped", "", last)
    ret 0
end

pub func RunRepair(): int:
    prepare_state_dir()
    host.RestoreDns()
    write_status("stopped", "", tun.Stats {})
    ret 0
end
