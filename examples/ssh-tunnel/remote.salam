package remote

import mem
import str
import os
import fs
import os.desktop
import os.process

include "profile.salam"
include "sshcmd.salam"

const FOLDER := ".salam-tunnel"
const PREFIX := "salam-udprelay-linux-"

func local_binary(arch: str): str:
    folder := desktop.ExecutableDir()
    inside := folder + "/../Resources/" + PREFIX + arch
    if os.Exists(inside):
        ret inside
    end
    beside := folder + "/" + PREFIX + arch
    ret os.Exists(beside) ? beside : ""
end

func fingerprint(data: Vector<u8>): str:
    mut h := 1469598103934665603 as i64
    repeat data.Len() in i:
        h = (h ^ (data[i] as i64)) * (1099511628211 as i64)
    end
    digits := "0123456789abcdef"
    mut out := ""
    repeat 16 in k:
        shift := (60 - k * 4) as i64
        out += digits.Substr(((h >> shift) & (15 as i64)) as int, 1)
    end
    ret out
end

func run(pr: profile.Profile, ip: str, command: str): process.RunResult:
    cmd := sshcmd.Target(sshcmd.Base(pr), ip, command)
    ret process.RunCommand(cmd, "", 90000)
end

func upload(pr: profile.Profile, ip: str, data: Vector<u8>, target: str): bool:
    script := "umask 077 && mkdir -p " + FOLDER + " && cat > " + target + ".new && chmod 700 " +
        target + ".new && mv " + target + ".new " + target
    mut cmd := sshcmd.Target(sshcmd.Base(pr), ip, script)
    cmd.stdin_mode = 1
    cmd.stdout_mode = 2
    cmd.stderr_mode = 2
    mut child := process.Launch(cmd)
    if not child.ok:
        ret false
    end
    n := data.Len()
    buf := mem.Allocate(n as u64) as u8*
    repeat n in i:
        buf[i] = data[i]
    end
    sent := child.WriteBytes(buf as void*, n)
    mem.Free(buf as void*)
    child.CloseStdin()
    status := child.Wait(120000)
    if status.timed_out:
        _k := child.Kill()
        _w := child.Wait(2000)
    end
    child.Close()
    ret sent and status.Success()
end

pub func Install(pr: profile.Profile, ip: str, why &: str): str:
    system := run(pr, ip, "uname -sm")
    if not system.started or not system.status.Success():
        why = "cannot ask the server what it runs"
        ret ""
    end
    kind := system.stdout.Trim()
    mut arch := ""
    if kind == "Linux x86_64":
        arch = "x86_64"
    else kind == "Linux aarch64":
        arch = "aarch64"
    else:
        why = "UDP needs a Linux server on x86_64 or aarch64"
        ret ""
    end
    path := local_binary(arch)
    if path.Len() == 0:
        why = "this build has no relay program for " + arch
        ret ""
    end
    data := fs.ReadAllBytes(path)
    if data.Len() == 0:
        why = "cannot read the relay program"
        ret ""
    end
    target := FOLDER + "/udprelay-" + fingerprint(data)
    present := run(pr, ip, "test -x " + target)
    if present.started and present.status.Success():
        ret target
    end
    if not upload(pr, ip, data, target):
        why = "could not copy the relay to the server"
        ret ""
    end
    ret target
end
