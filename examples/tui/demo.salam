import term
import tui

mut last_key := "none"
mut seconds := 0

struct App:
    pub use tui.BaseWidget

    pub func render(buf: tui.Buffer, bounds: tui.Rect):
        bar := tui.Style { reverse = true }
        top := tui.Rect { x = bounds.x, y = bounds.y, width = bounds.width, height = 1 }
        buf.fill(top, " ", bar)
        buf.put_str(bounds.x + 1, bounds.y, "tui demo", bar)
        status := "key: " + last_key + " | " + bounds.width + "x" + bounds.height + " | " + seconds + "s | Tab/arrows focus, Enter press, q quit"
        buf.put_str(bounds.x + 1, bounds.bottom() - 1, status, tui.Style { dim = true })
    end
end

struct Body:
    pub use tui.BaseWidget
    pub presses: int = 0

    pub func handle_event(event: tui.Event): bool:
        if event.is_key(term.KeyEnter) or event.is_key(term.KeySpace):
            this.presses++
            ret true
        end
        ret false
    end

    pub func render(buf: tui.Buffer, bounds: tui.Rect):
        buf.put_str(bounds.x + 1, bounds.y, "presses: " + this.presses, tui.StyleDefault)
    end
end

func describe(k: term.Key): str:
    if k.code == term.KeyChar:
        if k.ctrl:
            ret "Ctrl+" + k.ch
        end
        ret k.ch
    end
    names := [term.KeyEnter, term.KeyTab, term.KeySpace, term.KeyBackspace, term.KeyEscape, term.KeyUp, term.KeyDown, term.KeyLeft, term.KeyRight]
    labels := ["Enter", "Tab", "Space", "Backspace", "Esc", "Up", "Down", "Left", "Right"]
    repeat len(names) in i:
        if names[i] == k.code:
            ret labels[i]
        end
    end
    ret "key " + k.code
end

func arrange(screen: tui.Screen, left: int, right: int, bottom: int):
    w := screen.buffer.width
    h := screen.buffer.height - 3
    half := w / 2
    top_h := h - h / 3
    screen.widget(left).SetBounds(tui.Rect { x = 1, y = 2, width = half - 1, height = top_h })
    screen.widget(right).SetBounds(tui.Rect { x = half + 1, y = 2, width = w - half - 2, height = top_h })
    screen.widget(bottom).SetBounds(tui.Rect { x = 1, y = 2 + top_h, width = w - 2, height = h - top_h })
end

func framed(screen &: tui.Screen, label: str): int:
    body := screen.add(tui.RootId, Body {})
    mut frame := tui.Panel { border = tui.BorderStyle.Single, title = label, takes_focus = true, focus_style = tui.Style { fg = tui.Green } }
    frame.add(screen.widget(body))
    ret screen.add(tui.RootId, frame)
end

func main:
    if not term.IsTTY(term.StdinFd) or not term.IsTerminal():
        printerrln "demo: needs an interactive terminal"
        ret 1
    end

    root := App {} as dyn tui.Widget
    mut screen := tui.NewTerminalScreen(root)
    screen.tick_ms = 1000
    screen.set_keymap(tui.NewDefaultKeymap())
    left := framed(screen, "Left")
    right := framed(screen, "Right")
    bottom := framed(screen, "Bottom")

    screen.start()
    defer screen.close()

    arrange(screen, left, right, bottom)
    screen.present()

    mut ev := tui.Event {}
    until screen.next_event(ev):
        consumed := screen.dispatch(ev)
        if ev.kind == tui.ResizeEvent:
            arrange(screen, left, right, bottom)
        end
        if ev.kind == tui.TickEvent:
            seconds++
        end
        if ev.kind == tui.KeyEvent:
            last_key = describe(ev.key)
        end
        if ev.kind == tui.TickEvent or ev.kind == tui.KeyEvent:
            screen.dirty = true
        end
        if not consumed:
            if ev.is_char("q") or ev.is_ctrl("c"):
                screen.stop()
            end
        end
        screen.present()
    end
    ret 0
end
