import tui

struct Hello:
    pub use tui.BaseWidget

    pub func render(buf: tui.Buffer, bounds: tui.Rect):
        buf.put_str(2, 1, "Hello from tui!", tui.Style { bold = true })
        buf.put_str(2, 3, "Screen size: " + bounds.width + "x" + bounds.height, tui.StyleDefault)
        buf.put_str(2, 4, "Press q to quit.", tui.StyleDefault)
    end
end

func main:
    mut screen := tui.NewTerminalScreen(Hello {})
    screen.start()
    defer screen.Close()

    screen.present()
    mut ev := tui.Event {}
    until screen.next_event(ev):
        if not screen.dispatch(ev) and ev.is_char("q"):
            screen.stop()
        end
        screen.present()
    end
end
