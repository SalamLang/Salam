import tui

struct Hello:
    pub use tui.BaseWidget

    pub func render(buf: tui.Buffer, bounds: tui.Rect):
        buf.PutStr(2, 1, "Hello from tui!", tui.Style { bold = true })
        buf.PutStr(2, 3, "Screen size: " + bounds.width + "x" + bounds.height, tui.StyleDefault)
        buf.PutStr(2, 4, "Press q to quit.", tui.StyleDefault)
    end
end

func main:
    mut screen := tui.NewTerminalScreen(Hello {})
    screen.Start()
    defer screen.Close()

    screen.Present()
    mut ev := tui.Event {}
    until screen.NextEvent(ev):
        if not screen.Dispatch(ev) and ev.IsChar("q"):
            screen.Stop()
        end
        screen.Present()
    end
end
