import conv
import str

component Calculator:
    display := "0"
    stored := 0.0 as f64
    pending := ""
    fresh := true

    box:
        width = 300
        padding = 20
        gap = 14
        radius = 18
        background = #111318
        shadow = 0, 10, 30, #00000055

        box:
            padding = 18, 16
            radius = 12
            background = #1b1e26
            min height = 70
            paragraph:
                text align = end
                font size = 40
                font weight = bold
                color = white
                id = "disp"
                content = display
            end
        end

        box:
            layout = row
            gap = 10
            button:
                grow = 1
                height = 56
                radius = 12
                font size = 22
                background = #ef4444
                color = white
                hover background = #dc2626
                click = ():
                    display = "0"
                    stored = 0.0
                    pending = ""
                    fresh = true
                end
                id = "clear"
                content = "C"
            end
            button:
                grow = 1
                height = 56
                radius = 12
                font size = 22
                background = #2563eb
                color = white
                hover background = #1d4ed8
                click = ():
                    cur := conv.ParseFloatOr(display, 0.0)
                    if pending != "" and not fresh:
                        mut result := 0.0
                        if pending == "+": result = stored + cur end
                        if pending == "-": result = stored - cur end
                        if pending == "*": result = stored * cur end
                        if pending == "/":
                            if cur == 0.0: result = 0.0 else:
                                result = stored / cur
                            end
                        end
                        stored = result
                        display = conv.FormatFloatShort(result)
                    end
                    if pending == "" or fresh:
                        stored = cur
                    end
                    pending = "/"
                    fresh = true
                end
                id = "div"
                content = "÷"
            end
        end

        box:
            layout = row
            gap = 10
            button:
                grow = 1
                height = 56
                radius = 12
                font size = 22
                background = #2a2f3a
                color = white
                hover background = #3a4150
                click = ():
                    if fresh or display == "0": display = "7" fresh = false else:
                        display += "7"
                    end
                end
                id = "d7"
                content = "7"
            end
            button:
                grow = 1
                height = 56
                radius = 12
                font size = 22
                background = #2a2f3a
                color = white
                hover background = #3a4150
                click = ():
                    if fresh or display == "0": display = "8" fresh = false else:
                        display += "8"
                    end
                end
                id = "d8"
                content = "8"
            end
            button:
                grow = 1
                height = 56
                radius = 12
                font size = 22
                background = #2a2f3a
                color = white
                hover background = #3a4150
                click = ():
                    if fresh or display == "0": display = "9" fresh = false else:
                        display += "9"
                    end
                end
                id = "d9"
                content = "9"
            end
            button:
                grow = 1
                height = 56
                radius = 12
                font size = 22
                background = #2563eb
                color = white
                hover background = #1d4ed8
                click = ():
                    cur := conv.ParseFloatOr(display, 0.0)
                    if pending != "" and not fresh:
                        mut result := 0.0
                        if pending == "+": result = stored + cur end
                        if pending == "-": result = stored - cur end
                        if pending == "*": result = stored * cur end
                        if pending == "/":
                            if cur == 0.0: result = 0.0 else:
                                result = stored / cur
                            end
                        end
                        stored = result
                        display = conv.FormatFloatShort(result)
                    end
                    if pending == "" or fresh:
                        stored = cur
                    end
                    pending = "*"
                    fresh = true
                end
                id = "mul"
                content = "×"
            end
        end

        box:
            layout = row
            gap = 10
            button:
                grow = 1
                height = 56
                radius = 12
                font size = 22
                background = #2a2f3a
                color = white
                hover background = #3a4150
                click = ():
                    if fresh or display == "0": display = "4" fresh = false else:
                        display += "4"
                    end
                end
                id = "d4"
                content = "4"
            end
            button:
                grow = 1
                height = 56
                radius = 12
                font size = 22
                background = #2a2f3a
                color = white
                hover background = #3a4150
                click = ():
                    if fresh or display == "0": display = "5" fresh = false else:
                        display += "5"
                    end
                end
                id = "d5"
                content = "5"
            end
            button:
                grow = 1
                height = 56
                radius = 12
                font size = 22
                background = #2a2f3a
                color = white
                hover background = #3a4150
                click = ():
                    if fresh or display == "0": display = "6" fresh = false else:
                        display += "6"
                    end
                end
                id = "d6"
                content = "6"
            end
            button:
                grow = 1
                height = 56
                radius = 12
                font size = 22
                background = #2563eb
                color = white
                hover background = #1d4ed8
                click = ():
                    cur := conv.ParseFloatOr(display, 0.0)
                    if pending != "" and not fresh:
                        mut result := 0.0
                        if pending == "+": result = stored + cur end
                        if pending == "-": result = stored - cur end
                        if pending == "*": result = stored * cur end
                        if pending == "/":
                            if cur == 0.0: result = 0.0 else:
                                result = stored / cur
                            end
                        end
                        stored = result
                        display = conv.FormatFloatShort(result)
                    end
                    if pending == "" or fresh:
                        stored = cur
                    end
                    pending = "-"
                    fresh = true
                end
                id = "sub"
                content = "−"
            end
        end

        box:
            layout = row
            gap = 10
            button:
                grow = 1
                height = 56
                radius = 12
                font size = 22
                background = #2a2f3a
                color = white
                hover background = #3a4150
                click = ():
                    if fresh or display == "0": display = "1" fresh = false else:
                        display += "1"
                    end
                end
                id = "d1"
                content = "1"
            end
            button:
                grow = 1
                height = 56
                radius = 12
                font size = 22
                background = #2a2f3a
                color = white
                hover background = #3a4150
                click = ():
                    if fresh or display == "0": display = "2" fresh = false else:
                        display += "2"
                    end
                end
                id = "d2"
                content = "2"
            end
            button:
                grow = 1
                height = 56
                radius = 12
                font size = 22
                background = #2a2f3a
                color = white
                hover background = #3a4150
                click = ():
                    if fresh or display == "0": display = "3" fresh = false else:
                        display += "3"
                    end
                end
                id = "d3"
                content = "3"
            end
            button:
                grow = 1
                height = 56
                radius = 12
                font size = 22
                background = #2563eb
                color = white
                hover background = #1d4ed8
                click = ():
                    cur := conv.ParseFloatOr(display, 0.0)
                    if pending != "" and not fresh:
                        mut result := 0.0
                        if pending == "+": result = stored + cur end
                        if pending == "-": result = stored - cur end
                        if pending == "*": result = stored * cur end
                        if pending == "/":
                            if cur == 0.0: result = 0.0 else:
                                result = stored / cur
                            end
                        end
                        stored = result
                        display = conv.FormatFloatShort(result)
                    end
                    if pending == "" or fresh:
                        stored = cur
                    end
                    pending = "+"
                    fresh = true
                end
                id = "add"
                content = "+"
            end
        end

        box:
            layout = row
            gap = 10
            button:
                grow = 2
                height = 56
                radius = 12
                font size = 22
                background = #2a2f3a
                color = white
                hover background = #3a4150
                click = ():
                    if fresh or display == "0": display = "0" fresh = false else:
                        display += "0"
                    end
                end
                id = "d0"
                content = "0"
            end
            button:
                grow = 1
                height = 56
                radius = 12
                font size = 22
                background = #2a2f3a
                color = white
                hover background = #3a4150
                click = ():
                    if fresh:
                        display = "0."
                        fresh = false
                    else:
                        if not str.Contains(display, "."):
                            display += "."
                        end
                    end
                end
                id = "dot"
                content = "."
            end
            button:
                grow = 1
                height = 56
                radius = 12
                font size = 22
                background = #16a34a
                color = white
                hover background = #15803d
                click = ():
                    if pending != "":
                        cur := conv.ParseFloatOr(display, 0.0)
                        mut result := 0.0
                        mut bad := false
                        if pending == "+": result = stored + cur end
                        if pending == "-": result = stored - cur end
                        if pending == "*": result = stored * cur end
                        if pending == "/":
                            if cur == 0.0:
                                bad = true
                            else:
                                result = stored / cur
                            end
                        end
                        if bad:
                            display = "Error"
                            stored = 0.0
                        else:
                            display = conv.FormatFloatShort(result)
                            stored = result
                        end
                        pending = ""
                        fresh = true
                    end
                end
                id = "eq"
                content = "="
            end
        end
    end
end

page:
    title = "Salam Calculator"
    box:
        align = center
        justify = center
        padding = 24
        Calculator: end
    end
end
