component Bubble(who: str, text: str):
    box:
        max width = 70%
        padding y = 8 padding x = 12
        radius = 12
        background = #e5e7eb
        paragraph: font size = 12 opacity = 0.7 content = who end
        paragraph: content = text end
    end
end

component Chat:
    log := Vector {} as Vector<str>
    draft := ""
    box:
        padding = 16
        gap = 8
        heading: size = 2 content = "Chat" end
        box:
            gap = 8
            padding = 8
            radius = 8
            border width = 1 border style = solid border color = #e5e7eb
            overflow = auto
            max height = 360
            list:
                each line in log:
                    item:
                        key = line
                        Bubble: who = "Echo" text = line end
                    end
                end
            end
        end
        box:
            layout = row
            gap = 8
            input:
                id = "draft"
                grow = 1
                padding y = 8 padding x = 12
                radius = 6
                border width = 1 border style = solid border color = #d1d5db
                focus border width = 1 focus border style = solid focus border color = #2563eb
                input = (v: str): draft = v end
            end
            button:
                id = "send"
                padding y = 8 padding x = 16
                radius = 6
                background = #2563eb
                color = white
                hover background = #1d4ed8
                click = (): log.Push("You said: " + draft) println "sent " + draft draft = "" end
                content = "Send"
            end
        end
    end
end

page:
    title = "Chat"
    Chat: end
end
