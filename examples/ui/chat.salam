component Bubble(who: str, text: str):
    box:
        max width = 70%
        padding = 8, 12
        radius = 12
        background = #e5e7eb
        paragraph: font size = 12 opacity = 0.7 content = who end
        paragraph: content = text end
    end
end

component Chat:
    log := Vector {} as Vector<str>
    who := Vector {} as Vector<str>
    draft := ""
    box:
        padding = 16
        gap = 8
        heading: size = 2 content = "Chat" end
        box:
            gap = 8
            padding = 8
            radius = 8
            border = 1, solid, #e5e7eb
            overflow = auto
            max height = 360
            if log.Len() == 0:
                paragraph: color = #6b7280 content = "Say something." end
            end
            each i, line in log:
                Bubble: key = i who = who.Get(i) text = line end
            end
        end
        box:
            layout = row
            gap = 8
            input:
                id = "draft"
                grow = 1
                padding = 8, 12
                radius = 6
                border = 1, solid, #d1d5db
                focus border = 1, solid, #2563eb
                input = (v: str): draft = v end
            end
            button:
                id = "send"
                padding = 8, 16
                radius = 6
                background = #2563eb
                color = white
                hover background = #1d4ed8
                click = ():
                    if draft.Len() > 0:
                        log.Push(draft)
                        who.Push("You")
                        log.Push("You said: " + draft)
                        who.Push("Echo")
                        println "sent " + draft
                        draft = ""
                    end
                end
                content = "Send"
            end
        end
    end
end

page:
    title = "Chat"
    Chat: end
end
