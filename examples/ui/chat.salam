component Bubble(who: str, text: str):
    box:
        max width = 70%
        padding = 8, 12
        radius = 12
        background = #e5e7eb
        margin start = 0
        if who == "You":
            margin start = 48
            background = #2563eb
            color = #ffffff
        end
        paragraph: font size = 12 opacity = 0.7 content = who end
        paragraph: content = text end
    end
end

component Chat:
    lines := Vector {} as Vector<str>
    senders := Vector {} as Vector<str>
    box:
        padding = 16
        gap = 8
        heading: size = 2 content = "Chat" end
        box:
            gap = 8
            padding = 8
            radius = 8
            border = 1, solid, #e5e7eb
            overflow = auto
            max height = 360
            list:
                each i, line in lines:
                    item:
                        key = i
                        Bubble: who = senders.Get(i) text = line end
                    end
                end
            end
        end
        box:
            layout = row
            wrap = true
            gap = 8
            button:
                id = "hello"
                padding = 8, 16
                radius = 6
                background = #2563eb
                color = white
                hover background = #1d4ed8
                click = ():
                    lines.Push("Hello")
                    senders.Push("You")
                    lines.Push("You said: Hello")
                    senders.Push("Echo")
                    println "sent Hello"
                end
                content = "Hello"
            end
            button:
                id = "how"
                padding = 8, 16
                radius = 6
                background = #2563eb
                color = white
                hover background = #1d4ed8
                click = ():
                    lines.Push("How are you?")
                    senders.Push("You")
                    lines.Push("You said: How are you?")
                    senders.Push("Echo")
                    println "sent How are you?"
                end
                content = "How are you?"
            end
            button:
                id = "thanks"
                padding = 8, 16
                radius = 6
                background = #2563eb
                color = white
                hover background = #1d4ed8
                click = ():
                    lines.Push("Thanks")
                    senders.Push("You")
                    lines.Push("You said: Thanks")
                    senders.Push("Echo")
                    println "sent Thanks"
                end
                content = "Thanks"
            end
        end
    end
end

page:
    title = "Chat"
    Chat: end
end
