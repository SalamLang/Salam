component Stat(label: str, amount: str):
    box:
        grow = 1
        padding = 16
        radius = 10
        shadow = 0, 1, 3, #00000026
        hover shadow = 0, 4, 12, #00000033
        transition = 200ms, ease out
        paragraph: color = #6b7280 font size = 14 content = label end
        paragraph: font size = 28 font weight = bold content = amount end
    end
end

component Bar(label: str, share: int):
    box:
        layout = row
        align = center
        gap = 8
        paragraph: width = 64 content = label end
        box:
            grow = 1
            height = 12
            radius = 6
            background = #e5e7eb
            box: width = share + "%" height = 12 radius = 6 background = #2563eb end
        end
        paragraph: width = 48 text align = right content = share + "%" end
    end
end

component Dashboard:
    days := 7
    box:
        padding = 24
        gap = 16
        box:
            layout = row
            align = center
            justify = between
            heading: size = 1 content = "Overview" end
            box:
                layout = row
                gap = 8
                button:
                    id = "week"
                    padding = 6, 14
                    radius = 6
                    if days == 7:
                        background = #2563eb
                        color = #ffffff
                    end
                    click = (): days = 7 println "range 7" end
                    content = "7 days"
                end
                button:
                    id = "month"
                    padding = 6, 14
                    radius = 6
                    if days == 30:
                        background = #2563eb
                        color = #ffffff
                    end
                    click = (): days = 30 println "range 30" end
                    content = "30 days"
                end
            end
        end
        box:
            layout = row
            wrap = true
            gap = 12
            Stat: label = "Visitors" amount = days == 7 ? "1,204" : "5,310" end
            Stat: label = "Orders" amount = days == 7 ? "86" : "402" end
            Stat: label = "Refunds" amount = days == 7 ? "3" : "19" end
        end
        box:
            padding = 16
            gap = 10
            radius = 10
            border = 1, solid, #e5e7eb
            heading: size = 3 content = "Traffic by source" end
            Bar: label = "Search" share = days == 7 ? 52 : 47 end
            Bar: label = "Direct" share = days == 7 ? 28 : 31 end
            Bar: label = "Social" share = days == 7 ? 20 : 22 end
        end
    end
end

page:
    title = "Dashboard"
    Dashboard: end
end
