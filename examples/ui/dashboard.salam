component Stat(label: str, value: str):
    box:
        grow = 1
        padding = 16
        radius = 10
        shadow = 0, 1, 3, #00000026
        hover shadow = 0, 4, 12, #00000033
        transition = 200ms, ease out
        paragraph: color = #6b7280 font size = 14 content = label end
        paragraph: font size = 28 font weight = bold content = value end
    end
end

component Dashboard:
    range := 7
    box:
        padding = 24
        gap = 16
        box:
            layout = row
            align = center
            justify = between
            heading: size = 1 content = "Overview" end
            box:
                layout = row
                gap = 8
                button: id = "week" padding y = 6 padding x = 14 radius = 6 click = (): range = 7 println "range 7" end content = "7 days" end
                button: id = "month" padding y = 6 padding x = 14 radius = 6 click = (): range = 30 println "range 30" end content = "30 days" end
            end
        end
        box:
            layout = row
            wrap = true
            gap = 12
            Stat: label = "Visitors" value = range == 7 ? "1,204" : "5,310" end
            Stat: label = "Orders" value = range == 7 ? "86" : "402" end
            Stat: label = "Refunds" value = range == 7 ? "3" : "19" end
        end
        box:
            padding = 16
            gap = 8
            radius = 10
            border width = 1 border style = solid border color = #e5e7eb
            heading: size = 3 content = "Traffic by source" end
            paragraph: content = "Search " + (range == 7 ? "52%" : "47%") end
            paragraph: content = "Direct " + (range == 7 ? "28%" : "31%") end
            paragraph: content = "Social " + (range == 7 ? "20%" : "22%") end
        end
    end
end

page:
    title = "Dashboard"
    Dashboard: end
end
