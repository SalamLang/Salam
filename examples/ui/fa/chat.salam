تابع قسمت پیام(پیام: رشته، ک: صحیح): رشته:
    برگشت پیام.بشکاف("|").بگیر(ک)
پایان

بخش حباب(فرستنده: رشته، متن: رشته):
    جعبه:
        بیشینه عرض = 70%
        فاصله = 8، 12
        گردی = 12
        پس‌زمینه = "#e5e7eb"
        فضا ابتدا = 0
        اگر فرستنده برابر "شما":
            فضا ابتدا = 48
            پس‌زمینه = "#2563eb"
            رنگ = "#ffffff"
        پایان
        پاراگراف:
            اندازه قلم = 12
            شفافیت = 0.7
            محتوا = فرستنده
        پایان
        پاراگراف:
            محتوا = متن
        پایان
    پایان
پایان

بخش گفتگو:
    پیام‌ها := وکتور {} برگردان وکتور<رشته>
    پیش‌نویس := ""
    جعبه:
        فاصله = 16
        شکاف = 8
        سرتیتر:
            اندازه = 2
            محتوا = "گفتگو"
        پایان
        جعبه:
            شکاف = 8
            فاصله = 8
            گردی = 8
            کادر = 1، "توپر"، "#e5e7eb"
            سرریز = "خودکار"
            بیشینه ارتفاع = 360
            فهرست:
                هر ی، پیام در پیام‌ها:
                    مورد:
                        کلید = ی
                        حباب:
                            فرستنده = قسمت پیام(پیام، 0)
                            متن = قسمت پیام(پیام، 1)
                        پایان
                    پایان
                پایان
            پایان
        پایان
        جعبه:
            چیدمان = "ردیف"
            شکاف = 8
            ورودی:
                شناسه = "draft"
                رشد = 1
                فاصله = 8، 12
                گردی = 6
                کادر = 1، "توپر"، "#d1d5db"
                تمرکز:
                    کادر = 1، "توپر"، "#2563eb"
                پایان
                پیوند = پیش‌نویس
            پایان
            دکمه:
                شناسه = "send"
                فاصله = 8، 16
                گردی = 6
                پس‌زمینه = "#2563eb"
                رنگ = "سفید"
                اشاره:
                    پس‌زمینه = "#1d4ed8"
                پایان
                کلیک = ():
                    اگر پیش‌نویس.طول() بزرگتر ۰:
                        پیام‌ها.بیفزا("شما|" + پیش‌نویس)
                        پیام‌ها.بیفزا("پژواک|شما گفتید: " + پیش‌نویس)
                        سرچاپ "فرستاده شد " + پیش‌نویس
                        پیش‌نویس = ""
                    پایان
                پایان
                محتوا = "ارسال"
            پایان
        پایان
    پایان
پایان

صفحه:
    عنوان = "گفتگو"
    گفتگو: پایان
پایان
