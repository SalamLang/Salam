بخش آمار(برچسب: رشته، مقدار: رشته):
    جعبه:
        رشد = 1
        فاصله = 16
        گردی = 10
        سایه = 0، 1، 3، #00000026
        گذار = 200ms، نرم انتها
        اشاره:
            سایه = 0، 4، 12، #00000033
        پایان
        پاراگراف:
            رنگ = #6b7280
            اندازه قلم = 14
            محتوا = برچسب
        پایان
        پاراگراف:
            اندازه قلم = 28
            وزن قلم = 700
            محتوا = مقدار
        پایان
    پایان
پایان

بخش نوار(برچسب: رشته، سهم: صحیح):
    جعبه:
        چیدمان = ردیف
        تراز = وسط
        شکاف = 8
        پاراگراف:
            عرض = 64
            محتوا = برچسب
        پایان
        جعبه:
            رشد = 1
            ارتفاع = 12
            گردی = 6
            پس‌زمینه = #e5e7eb
            جعبه:
                عرض = سهم + "%"
                ارتفاع = 12
                گردی = 6
                پس‌زمینه = #2563eb
            پایان
        پایان
        پاراگراف:
            عرض = 48
            تراز متن = انتها
            محتوا = سهم + "%"
        پایان
    پایان
پایان

بخش داشبورد:
    روز := ۷
    جعبه:
        فاصله = 24
        شکاف = 16
        جعبه:
            چیدمان = ردیف
            تراز = وسط
            چینش = میان
            سرتیتر:
                اندازه = 1
                محتوا = "نمای کلی"
            پایان
            جعبه:
                چیدمان = ردیف
                شکاف = 8
                دکمه:
                    شناسه = "week"
                    فاصله = 6، 14
                    گردی = 6
                    اگر روز برابر ۷:
                        پس‌زمینه = #2563eb
                        رنگ = #ffffff
                    پایان
                    کلیک = (): روز = ۷ سرچاپ "بازه ۷" پایان
                    محتوا = "۷ روز"
                پایان
                دکمه:
                    شناسه = "month"
                    فاصله = 6، 14
                    گردی = 6
                    اگر روز برابر ۳۰:
                        پس‌زمینه = #2563eb
                        رنگ = #ffffff
                    پایان
                    کلیک = (): روز = ۳۰ سرچاپ "بازه ۳۰" پایان
                    محتوا = "۳۰ روز"
                پایان
            پایان
        پایان
        جعبه:
            چیدمان = ردیف
            پیچش = درست
            شکاف = 12
            آمار:
                برچسب = "بازدیدکننده"
                مقدار = (روز برابر ۷) ? "۱٬۲۰۴" : "۵٬۳۱۰"
            پایان
            آمار:
                برچسب = "سفارش"
                مقدار = (روز برابر ۷) ? "۸۶" : "۴۰۲"
            پایان
            آمار:
                برچسب = "بازگشت"
                مقدار = (روز برابر ۷) ? "۳" : "۱۹"
            پایان
        پایان
        جعبه:
            فاصله = 16
            شکاف = 8
            گردی = 10
            کادر = 1، توپر، #e5e7eb
            سرتیتر:
                اندازه = 3
                محتوا = "ترافیک بر پایه منبع"
            پایان
            نوار:
                برچسب = "جستجو"
                سهم = (روز برابر ۷) ? ۵۲ : ۴۷
            پایان
            نوار:
                برچسب = "مستقیم"
                سهم = (روز برابر ۷) ? ۲۸ : ۳۱
            پایان
            نوار:
                برچسب = "شبکه‌های اجتماعی"
                سهم = (روز برابر ۷) ? ۲۰ : ۲۲
            پایان
        پایان
    پایان
پایان

صفحه:
    عنوان = "داشبورد"
    داشبورد: پایان
پایان
