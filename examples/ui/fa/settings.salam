بخش بخش‌تنظیم(نام: رشته):
    جعبه:
        شکاف = 8
        فاصله = 16
        گردی = 10
        کادر = 1، توپر، #e5e7eb
        سرتیتر:
            اندازه = 3
            محتوا = نام
        پایان
        محتوا: پایان
    پایان
پایان

بخش تنظیم‌ها:
    کاربر := "آرش"
    تیره := نادرست
    اعلان := درست
    اندازه := ۱۶
    جعبه:
        فاصله = 24
        شکاف = 16
        بیشینه عرض = 520
        فضا = 0، خودکار
        پس‌زمینه = #f9fafb
        رنگ = #111827
        اگر تیره:
            پس‌زمینه = #111827
            رنگ = #f9fafb
        پایان
        سرتیتر:
            اندازه = 1
            محتوا = "تنظیم‌ها"
        پایان
        بخش‌تنظیم:
            نام = "نمایه"
            ورودی:
                شناسه = "name"
                فاصله = 8، 12
                گردی = 6
                کادر = 1، توپر، #d1d5db
                تمرکز:
                    کادر = 1، توپر، #2563eb
                پایان
                ورودی = (v: رشته): کاربر = v سرچاپ "نام " + کاربر پایان
            پایان
            پاراگراف:
                محتوا = "سلام، " + کاربر
            پایان
        پایان
        بخش‌تنظیم:
            نام = "ظاهر"
            جعبه:
                چیدمان = ردیف
                تراز = وسط
                شکاف = 8
                ورودی:
                    شناسه = "dark"
                    نوع = تیک
                    رنگ تاکید = #2563eb
                    تیک خورده = تیره
                    تغییر = ():
                        تیره = تیره برابر نادرست
                        سرچاپ "تیره " + تیره
                    پایان
                پایان
                پاراگراف:
                    محتوا = "پوسته تیره"
                پایان
            پایان
            جعبه:
                چیدمان = ردیف
                تراز = وسط
                شکاف = 8
                دکمه:
                    شناسه = "smaller"
                    فاصله = 4، 12
                    کلیک = ():
                        اندازه--
                        سرچاپ "اندازه " + اندازه
                    پایان
                    محتوا = "کوچک"
                پایان
                پاراگراف:
                    اندازه قلم = اندازه
                    محتوا = "اندازه متن " + اندازه
                پایان
                دکمه:
                    شناسه = "larger"
                    فاصله = 4، 12
                    کلیک = ():
                        اندازه++
                        سرچاپ "اندازه " + اندازه
                    پایان
                    محتوا = "بزرگ"
                پایان
            پایان
        پایان
        بخش‌تنظیم:
            نام = "اعلان‌ها"
            جعبه:
                چیدمان = ردیف
                تراز = وسط
                شکاف = 8
                ورودی:
                    شناسه = "notify"
                    نوع = تیک
                    رنگ تاکید = #2563eb
                    تیک خورده = اعلان
                    تغییر = ():
                        اعلان = اعلان برابر نادرست
                        سرچاپ "اعلان " + اعلان
                    پایان
                پایان
                پاراگراف:
                    محتوا = "اعلان‌ها"
                پایان
            پایان
        پایان
    پایان
پایان

صفحه:
    عنوان = "تنظیم‌ها"
    تنظیم‌ها: پایان
پایان
