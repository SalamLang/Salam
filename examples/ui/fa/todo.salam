بخش کار(نام: رشته):
    عنوان := نام
    انجام := نادرست
    جعبه:
        چیدمان = ردیف
        تراز = وسط
        شکاف = 8
        فاصله = 8، 12
        گردی = 6
        گذار = 150ms، نرم انتها
        اشاره:
            پس‌زمینه = #eef4ff
        پایان
        اگر انجام:
            پس‌زمینه = #f3f4f6
        پایان
        دکمه:
            شناسه = "toggle-" + نام
            فاصله = 4، 10
            گردی = 6
            کلیک = ():
                انجام = انجام برابر نادرست
                سرچاپ "تغییر " + عنوان
            پایان
            محتوا = "انجام"
        پایان
        پاراگراف:
            رشد = 1
            شفافیت = 1
            محتوا = نام
            اگر انجام:
                رنگ = #9ca3af
                شفافیت = 0.6
            پایان
        پایان
    پایان
پایان

بخش فهرست کار:
    نام‌ها := وکتور {} برگردان وکتور<رشته>
    پیش‌نویس := ""
    جعبه:
        فاصله = 24
        شکاف = 12
        بیشینه عرض = 480
        فضا = 0، خودکار
        سرتیتر: اندازه = 1 محتوا = "کارها" پایان
        جعبه:
            چیدمان = ردیف
            شکاف = 8
            ورودی:
                شناسه = "draft"
                رشد = 1
                فاصله = 8، 12
                گردی = 6
                کادر = 1، توپر، #d1d5db
                تمرکز:
                    کادر = 1، توپر، #2563eb
                پایان
                جانگهدار = "چه باید کرد؟"
                پیوند = پیش‌نویس
            پایان
            دکمه:
                شناسه = "add"
                فاصله = 8، 16
                گردی = 6
                پس‌زمینه = #2563eb
                رنگ = سفید
                اشاره:
                    پس‌زمینه = #1d4ed8
                پایان
                کلیک = ():
                    اگر پیش‌نویس.طول() بزرگتر ۰:
                        نام‌ها.بیفزا("" + پیش‌نویس)
                        سرچاپ "افزوده شد " + پیش‌نویس
                        پیش‌نویس = ""
                    پایان
                پایان
                محتوا = "افزودن"
            پایان
        پایان
        فهرست:
            هر برچسب در نام‌ها:
                مورد:
                    کلید = برچسب
                    کار: نام = برچسب پایان
                پایان
            پایان
        پایان
    پایان
پایان

صفحه:
    عنوان = "کارها"
    فهرست کار: پایان
پایان
