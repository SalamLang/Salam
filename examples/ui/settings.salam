component Section(name: str):
    box:
        gap = 8
        padding = 16
        radius = 10
        border = 1, solid, #e5e7eb
        heading:
            size = 3
            content = name
        end
        content: end
    end
end

component Settings:
    name := "Ada"
    dark := false
    notify := true
    size := 16
    box:
        padding = 24
        gap = 16
        max width = 520
        margin = 0, auto
        background = #f9fafb
        color = #111827
        if dark:
            background = #111827
            color = #f9fafb
        end
        heading:
            size = 1
            content = "Settings"
        end
        Section:
            name = "Profile"
            input:
                id = "name"
                padding = 8, 12
                radius = 6
                border = 1, solid, #d1d5db
                focus:
                    border = 1, solid, #2563eb
                end
                input = (v: str): name = v println "name is " + name end
            end
            paragraph:
                content = "Hello, " + name
            end
        end
        Section:
            name = "Appearance"
            box:
                layout = "row"
                align = "center"
                gap = 8
                input:
                    id = "dark"
                    type = "checkbox"
                    accent = "#2563eb"
                    checked = dark
                    change = (): dark = not dark println "dark " + dark end
                end
                paragraph:
                    content = dark ? "Dark theme" : "Light theme"
                end
            end
            box:
                layout = "row"
                align = "center"
                gap = 8
                button:
                    id = "smaller"
                    padding = 4, 12
                    click = (): size-- println "size " + size end
                    content = "A-"
                end
                paragraph:
                    font size = size
                    content = "Text size " + size
                end
                button:
                    id = "larger"
                    padding = 4, 12
                    click = (): size++ println "size " + size end
                    content = "A+"
                end
            end
        end
        Section:
            name = "Notifications"
            box:
                layout = "row"
                align = "center"
                gap = 8
                input:
                    id = "notify"
                    type = "checkbox"
                    accent = "#2563eb"
                    checked = notify
                    change = (): notify = not notify println "notify " + notify end
                end
                paragraph:
                    content = notify ? "Notifications are on" : "Notifications are off"
                end
            end
        end
    end
end

page:
    title = "Settings"
    Settings: end
end
