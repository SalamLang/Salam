component Section(name: str):
    box:
        gap = 8
        padding = 16
        radius = 10
        border width = 1 border style = solid border color = #e5e7eb
        heading: size = 3 content = name end
        content: end
    end
end

component Settings:
    name := "Ada"
    dark := false
    notify := true
    size := 16
    box:
        padding = 24
        gap = 16
        max width = 520
        margin x = auto
        heading: size = 1 content = "Settings" end
        Section: name = "Profile"
            input:
                id = "name"
                padding y = 8 padding x = 12
                radius = 6
                border width = 1 border style = solid border color = #d1d5db
                focus border width = 1 focus border style = solid focus border color = #2563eb
                input = (v: str): name = v println "name is " + name end
            end
            paragraph: content = "Hello, " + name end
        end
        Section: name = "Appearance"
            box:
                layout = row
                align = center
                gap = 8
                input: id = "dark" type = "checkbox" accent = #2563eb change = (): dark = not dark println "dark " + dark end end
                paragraph: content = dark ? "Dark theme" : "Light theme" end
            end
            box:
                layout = row
                align = center
                gap = 8
                button: id = "smaller" padding y = 4 padding x = 12 click = (): size-- println "size " + size end content = "A-" end
                paragraph: content = "Text size " + size end
                button: id = "larger" padding y = 4 padding x = 12 click = (): size++ println "size " + size end content = "A+" end
            end
        end
        Section: name = "Notifications"
            box:
                layout = row
                align = center
                gap = 8
                input: id = "notify" type = "checkbox" accent = #2563eb change = (): notify = not notify println "notify " + notify end end
                paragraph: content = notify ? "Notifications are on" : "Notifications are off" end
            end
        end
    end
end

page:
    title = "Settings"
    Settings: end
end
