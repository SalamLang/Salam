component Row(label: str, done: bool, toggle, remove):
    box:
        layout = row
        align = center
        gap = 8
        padding = 8, 12
        radius = 6
        hover background = #eef4ff
        transition = 150ms, ease out
        button: id = "toggle-" + label padding = 4, 10 radius = 6 click = toggle content = done ? "Undo" : "Done" end
        if done:
            paragraph: grow = 1 color = #9ca3af decoration = strike content = label end
        else:
            paragraph: grow = 1 color = #111827 content = label end
        end
        button: id = "remove-" + label padding = 4, 10 radius = 6 color = #dc2626 hover background = #fee2e2 click = remove content = "Delete" end
    end
end

component Todo:
    names := Vector {} as Vector<str>
    marks := Vector {} as Vector<bool>
    draft := ""
    box:
        padding = 24
        gap = 12
        max width = 480
        margin = 0, auto
        heading: size = 1 content = "Todo" end
        box:
            layout = row
            gap = 8
            input:
                id = "draft"
                grow = 1
                padding = 8, 12
                radius = 6
                border = 1, solid, #d1d5db
                focus border = 1, solid, #2563eb
                placeholder = "What needs doing?"
                input = (v: str): draft = v end
            end
            button:
                id = "add"
                padding = 8, 16
                radius = 6
                background = #2563eb
                color = white
                hover background = #1d4ed8
                click = ():
                    if draft.Len() > 0:
                        names.Push(draft)
                        marks.Push(false)
                        println "added " + draft
                        draft = ""
                    end
                end
                content = "Add"
            end
        end
        if names.Len() == 0:
            paragraph: color = #6b7280 content = "Nothing to do." end
        end
        each i, name in names:
            Row:
                key = name
                label = name
                done = marks.Get(i)
                toggle = (): marks.Set(i, not marks.Get(i)) println "toggled " + name end
                remove = (): names.RemoveAt(i) marks.RemoveAt(i) println "removed " + name end
            end
        end
        paragraph: color = #6b7280 content = names.Len() + " tasks" end
    end
end

page:
    title = "Todo"
    Todo: end
end
