component Task(name: str):
    done := false
    box:
        layout = "row"
        align = "center"
        gap = 8
        padding = 8, 12
        radius = 6
        transition = 150ms, ease out
        hover:
            background = "#eef4ff"
        end
        if done:
            background = #f3f4f6
        end
        button:
            id = "toggle-" + name
            padding = 4, 10
            radius = 6
            click = (): done = not done println "toggled " + name end
            content = done ? "Undo" : "Done"
        end
        paragraph:
            grow = 1
            opacity = 1
            content = name
            if done:
                color = #9ca3af
                opacity = 0.6
            end
        end
    end
end

component Todo:
    names := Vector {} as Vector<str>
    draft := ""
    box:
        padding = 24
        gap = 12
        max width = 480
        margin = 0, auto
        heading:
            size = 1
            content = "Todo"
        end
        box:
            layout = "row"
            gap = 8
            input:
                id = "draft"
                grow = 1
                padding = 8, 12
                radius = 6
                border = 1, solid, #d1d5db
                focus:
                    border = 1, solid, #2563eb
                end
                placeholder = "What needs doing?"
                bind = draft
            end
            button:
                id = "add"
                padding = 8, 16
                radius = 6
                background = "#2563eb"
                color = "white"
                hover:
                    background = "#1d4ed8"
                end
                click = ():
                    if draft.Len() > 0:
                        names.Push("" + draft)
                        println "added " + draft
                        draft = ""
                    end
                end
                content = "Add"
            end
        end
        list:
            each label in names:
                item:
                    key = label
                    Task:
                        name = label
                    end
                end
            end
        end
    end
end

page:
    title = "Todo"
    Todo: end
end
