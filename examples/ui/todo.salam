component Task(name: str):
    done := false
    box:
        layout = row
        align = center
        gap = 8
        padding y = 8 padding x = 12
        radius = 6
        hover background = #eef4ff
        transition = 150ms, ease
        button:
            id = "toggle-" + name
            padding y = 4 padding x = 10
            radius = 6
            click = (): done = not done println "toggled " + name end
            content = done ? "Undo" : "Done"
        end
        paragraph: grow = 1 content = done ? "Done: " + name : name end
    end
end

component Todo:
    names := Vector {} as Vector<str>
    draft := ""
    box:
        padding = 24
        gap = 12
        max width = 480
        margin x = auto
        heading: size = 1 content = "Todo" end
        box:
            layout = row
            gap = 8
            input:
                id = "draft"
                grow = 1
                padding y = 8 padding x = 12
                radius = 6
                border width = 1 border style = solid border color = #d1d5db
                focus border width = 1 focus border style = solid focus border color = #2563eb
                placeholder = "What needs doing?"
                input = (v: str): draft = v end
            end
            button:
                id = "add"
                padding y = 8 padding x = 16
                radius = 6
                background = #2563eb
                color = white
                hover background = #1d4ed8
                click = (): names.Push(draft) println "added " + draft draft = "" end
                content = "Add"
            end
        end
        list:
            each name in names:
                item:
                    key = name
                    Task: name = name end
                end
            end
        end
    end
end

page:
    title = "Todo"
    Todo: end
end
