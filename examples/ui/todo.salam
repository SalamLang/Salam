component Task(name: str):
    title := name
    done := false
    box:
        layout = row
        align = center
        gap = 8
        padding = 8, 12
        radius = 6
        hover background = #eef4ff
        transition = 150ms, ease out
        if done:
            background = #f3f4f6
        end
        button:
            id = "toggle-" + name
            padding = 4, 10
            radius = 6
            click = (): done = not done println "toggled " + title end
            content = done ? "Undo" : "Done"
        end
        paragraph:
            grow = 1
            opacity = 1
            content = name
            if done:
                color = #9ca3af
                opacity = 0.6
            end
        end
    end
end

component Todo:
    names := Vector {} as Vector<str>
    next := 1
    box:
        padding = 24
        gap = 12
        max width = 480
        margin = 0, auto
        heading: size = 1 content = "Todo" end
        button:
            id = "add"
            padding = 8, 16
            radius = 6
            background = #2563eb
            color = white
            hover background = #1d4ed8
            click = ():
                names.Push("task" + next)
                println "added task" + next
                next++
            end
            content = "Add a task"
        end
        list:
            each label in names:
                item:
                    key = label
                    Task: name = label end
                end
            end
        end
    end
end

page:
    title = "Todo"
    Todo: end
end
