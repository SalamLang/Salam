package main

import net.vpn
import flag
import io
import os
import net.doh
import net.tunnel

func pick_node(fs &: flag.FlagSet): tunnel.Node:
    mut nodes := Vector {} as Vector<tunnel.Node>
    if flag.GetStr(fs, "link").len() > 0:
        nodes.push(tunnel.ParseLink(flag.GetStr(fs, "link")))
    end
    if flag.GetStr(fs, "sub").len() > 0:
        nodes = tunnel.ParseSubscription(io.ReadFile(flag.GetStr(fs, "sub"))).nodes
    end
    index := flag.GetInt(fs, "node") as int
    if index < 1 or index > nodes.len(): ret tunnel.Node { error = "no node " + index + " (found " + nodes.len() + ")" } end
    ret nodes[index - 1]
end

func rest_args(): Vector<str>:
    mut out := Vector {} as Vector<str>
    all := os.Args()
    each i, a in all:
        if i > 0: out.push(a) end
    end
    ret out
end

func resolver(name: str): doh.Resolver:
    mut servers := Vector {} as Vector<doh.Server>
    servers.push(name == "google" ? doh.Google() : doh.Cloudflare())
    ret doh.NewResolver(servers)
end

func main:
    mut fs := flag.New("client", "local mixed proxy (SOCKS4/5 + HTTP) in front of a vless/vmess/trojan/ss server")
    flag.AddInt(fs, "listen", "l", 1080, "local port")
    flag.AddStr(fs, "link", "", "", "share link (vless://, vmess://, trojan://, ss://)")
    flag.AddStr(fs, "sub", "s", "", "subscription file (base64 or plain links)")
    flag.AddInt(fs, "node", "n", 1, "which node of the subscription to use")
    flag.AddStr(fs, "config", "c", "", "v2ray style JSON config (replaces link/sub)")
    flag.AddBool(fs, "global", "g", false, "send everything through the proxy (no Iran preset)")
    flag.AddStr(fs, "doh", "", "", "resolve names over DoH: cloudflare or google")
    flag.AddBool(fs, "fragment", "f", false, "split the TLS ClientHello into small pieces")
    flag.AddInt(fs, "stats", "", 10, "print traffic stats every N seconds")
    flag.AddInt(fs, "duration", "", 0, "exit after N seconds (0 = until Ctrl-C)")
    if not flag.Parse(fs, rest_args()) or flag.HelpWanted(fs):
        println flag.Error(fs)
        println flag.Usage(fs)
        ret 2
    end
    mut opts := vpn.Options { fragment = flag.GetBool(fs, "fragment") }
    if flag.GetStr(fs, "doh").len() > 0:
        opts.use_doh = true
        opts.resolver = resolver(flag.GetStr(fs, "doh"))
    end
    vpn.RegisterWith(opts)

    if flag.GetStr(fs, "config").len() > 0:
        ret vpn.RunConfig(flag.GetStr(fs, "config"), flag.GetInt(fs, "stats") as int, flag.GetInt(fs, "duration") as int)
    end
    node := pick_node(fs)
    if not node.valid:
        printerrln "client:", node.error
        ret 1
    end
    println "using", tunnel.NodeLabel(node)
    mut router := tunnel.IranRouter("direct", "proxy")
    if flag.GetBool(fs, "global"): router = tunnel.NewRouter("proxy") end
    mut dialer := tunnel.NewRouterDialer(router)
    tunnel.RouterDialerAdd(dialer, "direct", tunnel.Direct())
    tunnel.RouterDialerAdd(dialer, "proxy", vpn.DialerFromNode(node))
    stats := tunnel.NewStats()
    mixed := tunnel.InboundConfig { tag = "mixed-in", protocol = "mixed", port = flag.GetInt(fs, "listen") as int }
    l := vpn.Start(mixed, dialer, stats)
    println "listening on port", l.port
    vpn.Wait(stats, flag.GetInt(fs, "stats") as int, flag.GetInt(fs, "duration") as int)
    vpn.Stop(l)
    println "bye,", vpn.Summary(stats)
    ret 0
end
