{
  "log": {"loglevel": "warning"},
  "inbounds": [
    {"tag": "mixed-in", "listen": "127.0.0.1", "port": 1080, "protocol": "mixed"}
  ],
  "outbounds": [
    {
      "tag": "proxy",
      "protocol": "vless",
      "settings": {"vnext": [{"address": "vpn.example.com", "port": 443, "users": [{"id": "b831381d-6324-4d53-ad4f-8cda48b30811", "encryption": "none"}]}]},
      "streamSettings": {
        "network": "ws",
        "security": "tls",
        "tlsSettings": {"serverName": "vpn.example.com"},
        "wsSettings": {"path": "/ray"}
      }
    },
    {"tag": "direct", "protocol": "freedom"},
    {"tag": "block", "protocol": "blackhole"}
  ],
  "routing": {
    "defaultOutbound": "proxy",
    "rules": [
      {"type": "field", "domain": ["suffix:ir"], "outboundTag": "direct"},
      {"type": "field", "ip": ["geoip:private"], "outboundTag": "direct"},
      {"type": "field", "port": "25", "outboundTag": "block"}
    ]
  }
}
