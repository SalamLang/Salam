package core

import atomic
import pool
import sync
import term
import str
import encoding.json
import net.tcp
import net.trojan
import net.transport
import net.tunnel

include "registry.salam"

extern:
    func signal(sig: int, handler: void*): void*
end

mut _stop := atomic.NewFlag(false)

pub struct Listener:
    pub inbound: transport.Listener = transport.Listener {}
    pub settings: transport.Settings = transport.Settings {}
    pub proto: dyn tunnel.InboundProtocol = tunnel.NullProtocol {}
    pub handler: dyn tunnel.Handler = tunnel.ForwardHandler {}
    pub running: atomic.Flag = atomic.Flag {}
    pub workers: pool.Pool = pool.Pool {}
    pub port: int = 0
    pub tag: str = ""
    pub trojan: trojan.Server = trojan.Server {}
end

export:
    func _on_signal(_sig: int):
        atomic.Set(_stop, true)
    end
end

func _serve_conn(raw: transport.Conn, l: Listener):
    mut c := raw
    if not transport.Upgrade(c, l.settings):
        transport.Close(c)
        ret
    end
    s := transport.AsStream(c)
    s.SetDeadline(15000)
    sess := l.proto.Handshake(s)
    if not sess.ok:
        s.Close()
        ret
    end
    s.SetDeadline(0)
    l.handler.Handle(s, sess)
end

func _accept_loop(l: Listener):
    until atomic.Get(l.running):
        mut raw := transport.AcceptRaw(l.inbound)
        if not raw.open: continue end
        if not atomic.Get(l.running):
            transport.Close(raw)
            break
        end
        pool.Submit(l.workers, (): _serve_conn(raw, l) end)
    end
end

func _trojan_listen(cfg: trojan.ServerConfig, port: int, s: transport.Settings): trojan.Server:
    if s.tls: ret trojan.Serve(cfg, port) end
    if s.network == "ws": ret trojan.ServeWS(cfg, port) end
    ret trojan.ServePlain(cfg, port)
end

func _trojan_server(ib: tunnel.InboundConfig, s: transport.Settings): Listener:
    mut cfg := trojan.NewServerConfig(s.cert_file, s.key_file)
    clients := json.Items(json.Get(ib.settings, "clients"))
    defer clients.free()
    repeat clients.len() in i:
        trojan.AddPassword(cfg, json.Get(clients[i], "password"))
    end
    fb := json.Items(json.Get(ib.settings, "fallbacks"))
    defer fb.free()
    if fb.len() > 0:
        dest := tunnel.ParseAddr(json.Get(fb[0], "dest"))
        trojan.SetFallback(cfg, dest.host, dest.port)
    end
    srv := _trojan_listen(cfg, ib.port, s)
    ret Listener { trojan = srv, port = trojan.ServerPort(srv), tag = ib.tag }
end

pub func Start(ib: tunnel.InboundConfig, dialer: dyn tunnel.Dialer, stats: tunnel.Stats): Listener:
    s := registry.StreamSettings(ib.stream_settings)
    if ib.protocol == "trojan": ret _trojan_server(ib, s) end
    proto := tunnel.CreateInbound(ib)
    mut h := tunnel.NewForwarder(dialer, proto)
    h.stats = stats
    inb := transport.Listen(ib.port, s)
    mut l := Listener { inbound = inb, settings = s, proto = proto, handler = h, tag = ib.tag }
    l.port = transport.ListenerPort(inb)
    l.running = atomic.NewFlag(true)
    l.workers = pool.NewElastic(2 as i64, 512 as i64, 1024 as i64)
    pool.Submit(l.workers, (): _accept_loop(l) end)
    ret l
end

pub func StartAll(c: tunnel.Config, stats: tunnel.Stats): Vector<Listener>:
    dialer := tunnel.BuildDialer(c)
    mut out := Vector {} as Vector<Listener>
    repeat c.inbounds.len() in i:
        out.push(Start(c.inbounds[i], dialer, stats))
    end
    ret out
end

pub func Ok(l: Listener): bool:
    if l.trojan.ok: ret true end
    ret transport.ListenerOk(l.inbound)
end

pub func Stop(l: Listener):
    if l.trojan.ok: trojan.Stop(l.trojan) ret end
    atomic.Set(l.running, false)
    wake := tcp.Dial("127.0.0.1", l.port)
    if tcp.ConnOk(wake): tcp.Close(wake) end
    transport.CloseListener(l.inbound)
end

pub func Summary(st: tunnel.Stats): str:
    ret "up " + term.FormatBytes(st.Up()) + "  down " + term.FormatBytes(st.Down()) + "  conns " + st.Total() + "  active " + st.Active() + "  failed " + st.Failed()
end

pub func Wait(st: tunnel.Stats, every: int, limit: int):
    _p1 := signal(2, &_on_signal)
    _p2 := signal(15, &_on_signal)
    mut t := 0
    until not atomic.Get(_stop) and (limit <= 0 or t < limit):
        sync.SleepMs(1000)
        t++
        if every > 0 and t % every == 0: println "[" + t + "s] " + Summary(st) end
    end
end

pub func RunConfig(path: str, every: int, limit: int): int:
    cfg := tunnel.LoadConfig(path)
    errs := tunnel.ValidateConfig(cfg)
    each e in errs: printerrln "config:", e end
    if errs.len() > 0: ret 1 end
    stats := tunnel.NewStats()
    listeners := StartAll(cfg, stats)
    mut failed := false
    each l in listeners:
        if Ok(l):
            println l.tag, "listening on port", l.port
        else:
            printerrln l.tag, "could not listen (port in use or bad certificate?)"
            failed = true
        end
    end
    if failed: ret 1 end
    Wait(stats, every, limit)
    each l in listeners: Stop(l) end
    println "bye,", Summary(stats)
    ret 0
end
