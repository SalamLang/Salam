package main

import net.vpn
import io
import mem
import os
import pool
import compress
import str
import net.dns
import net.doh
import net.socks
import net.httpproxy
import net.tcp
import net.transport
import net.tunnel

include "testcert.salam"

const UUID := "b831381d-6324-4d53-ad4f-8cda48b30811"
const SIZES := [1, 1000, 16384, 65536]

mut failures := 0
mut echo_srv := tcp.Server {}
mut site_srv := tcp.Server {}
mut workers := pool.Pool {}
mut doh_srv := tcp.Server {}
mut doh_queries := 0

func echo_conn(c: tcp.Conn):
    buf := mem.Allocate(65536 as u64)
    until true:
        n := tcp.ReadBytes(c, buf, 65536)
        if n <= 0: break end
        if tcp.WriteBytes(c, buf, n) < n: break end
    end
    mem.Free(buf)
    tcp.Close(c)
end

func echo_loop():
    until true:
        c := tcp.Accept(echo_srv)
        if not tcp.ConnOk(c): break end
        pool.Submit(workers, (): echo_conn(c) end)
    end
end

func site_conn(c: tcp.Conn):
    _head := tcp.Read(c, 1024)
    tcp.Write(c, "HTTP/1.1 200 OK\r\nContent-Length: 14\r\nConnection: close\r\n\r\nhello, website")
    tcp.Close(c)
end

func site_loop():
    until true:
        c := tcp.Accept(site_srv)
        if not tcp.ConnOk(c): break end
        pool.Submit(workers, (): site_conn(c) end)
    end
end

func doh_head_end(b: u8*, n: int): int:
    repeat n - 3 in i:
        if b[i] == 13 and b[i + 1] == 10 and b[i + 2] == 13 and b[i + 3] == 10: ret i end
    end
    ret 0 - 1
end

func doh_content_length(b: u8*, hend: int): int:
    raw := mem.AllocateZeroed((hend + 1) as u64)
    mem.Copy(raw, b as void*, hend as u64)
    head := str.Lower(raw as str)
    at := head.find("content-length:")
    if at < 0: ret 0 end
    rest := head.substr(at + 15, head.len() - at - 15)
    mut e := rest.find("\r\n")
    if e < 0: e = rest.len() end
    ret str.Trim(rest.substr(0, e)).to_int()
end

func doh_conn(c: tcp.Conn):
    buf := mem.AllocateZeroed(8192 as u64) as u8*
    mut got := 0
    mut hend := 0 - 1
    mut need := 0
    until true:
        n := tcp.ReadBytes(c, (buf as i64 + got) as void*, 8192 - got)
        if n <= 0: break end
        got += n
        if hend < 0:
            hend = doh_head_end(buf, got)
            if hend >= 0: need = doh_content_length(buf, hend) end
        end
        if hend >= 0 and got >= hend + 4 + need: break end
    end
    if hend >= 0 and need > 0:
        q := dns.Decode((buf as i64 + hend + 4) as void*, need)
        qn := q.questions.items.get(0)
        mut recs := Vector {} as Vector<dns.Record>
        if qn.name == "doh.test" and qn.qtype == dns.TypeA:
            recs.push(dns.Record { name = "doh.test", rtype = dns.TypeA, rclass = 1, ttl = 60, data = "127.0.0.1" })
        end
        doh_queries++
        mut reply := doh.EncodeResponse(q.id, qn.name, qn.qtype, 0, recs)
        head := "HTTP/1.1 200 OK\r\nContent-Type: application/dns-message\r\nConnection: close\r\nContent-Length: " + str.FromInt(reply.len as i64) + "\r\n\r\n"
        tcp.Write(c, head)
        tcp.WriteBytes(c, reply.data, reply.len)
        compress.BufFree(reply)
    end
    mem.Free(buf as void*)
    tcp.Close(c)
end

func doh_loop():
    until true:
        c := tcp.Accept(doh_srv)
        if not tcp.ConnOk(c): break end
        pool.Submit(workers, (): doh_conn(c) end)
    end
end

func pattern(n: int, seed: int): str:
    mut b := mem.AllocateZeroed((n + 1) as u64) as u8*
    repeat n in i:
        b[i] = (65 + (i * 7 + seed) % 26) as u8
    end
    ret b as str
end

func echo_check(s: dyn tunnel.Stream): int:
    mut total := 0
    each k, n in SIZES:
        want := pattern(n, k)
        if not tunnel.WriteAll(s, want): ret 0 - 1 end
        got := mem.AllocateZeroed((n + 1) as u64)
        defer mem.Free(got)
        if not tunnel.ReadFull(s, got, n): ret 0 - 1 end
        if (got as str) != want: ret 0 - 1 end
        total += n
    end
    ret total
end

func report(label: str, bytes: int):
    if bytes < 0:
        println label, "FAILED"
        failures++
    else:
        println label, "echo ok,", bytes, "bytes"
    end
end

func via_socks(port: int): int:
    s := tunnel.DialTcp("127.0.0.1", port, 5000)
    if not s.Ok(): ret 0 - 1 end
    r := socks.ClientHandshake(s, socks.Client { version = 5 }, socks.CmdConnect, "127.0.0.1", tcp.Port(echo_srv))
    if not r.ok: ret 0 - 1 end
    s.SetDeadline(10000)
    n := echo_check(s)
    s.Close()
    ret n
end

func via_http(port: int): int:
    s := tunnel.DialTcp("127.0.0.1", port, 5000)
    if not s.Ok(): ret 0 - 1 end
    r := httpproxy.ClientHandshake(s, httpproxy.Client {}, "127.0.0.1", tcp.Port(echo_srv))
    if not r.ok: ret 0 - 1 end
    s.SetDeadline(10000)
    n := echo_check(s)
    s.Close()
    ret n
end

func local_proxy(node: tunnel.Node, stats: tunnel.Stats): vpn.Listener:
    mut dialer := tunnel.NewRouterDialer(tunnel.NewRouter("proxy"))
    tunnel.RouterDialerAdd(dialer, "proxy", vpn.DialerFromNode(node))
    ret vpn.Start(tunnel.InboundConfig { tag = "local", protocol = "mixed" }, dialer, stats)
end

func link_node(n: tunnel.Node): tunnel.Node:
    ret tunnel.ParseLink(tunnel.NodeToLink(n))
end

func tls_stream(network: str, path: str, crt: str, key: str): str:
    mut ws := ""
    if network == "ws": ws = `,"wsSettings":{"path":"` + path + `"}` end
    ret `{"network":"` + network + `","security":"tls","tlsSettings":{"certificates":[{"certificateFile":"` + crt + `","keyFile":"` + key + `"}]}` + ws + `}`
end

func server_config(crt: str, key: str, site: int): str:
    users := `{"clients":[{"id":"` + UUID + `"}]}`
    ib := (tag: str, proto: str, settings: str, stream: str):
        mut m := `{"tag":"` + tag + `","port":0,"protocol":"` + proto + `","settings":` + settings
        if stream.len() > 0: m += `,"streamSettings":` + stream end
        ret m + "}"
    end
    mut all := Vector {} as Vector<str>
    all.push(ib("vless-tcp", "vless", users, ""))
    all.push(ib("vless-wss", "vless", users, tls_stream("ws", "/v", crt, key)))
    all.push(ib("vmess-tcp", "vmess", users, ""))
    all.push(ib("vmess-ws", "vmess", users, `{"network":"ws","wsSettings":{"path":"/m"}}`))
    all.push(ib("trojan-tls", "trojan", `{"clients":[{"password":"hunter2"}],"fallbacks":[{"dest":"127.0.0.1:` + site + `"}]}`, tls_stream("tcp", "", crt, key)))
    all.push(ib("ss-tcp", "shadowsocks", `{"method":"aes-256-gcm","password":"s3cret"}`, ""))
    mut text := `{"inbounds":[`
    each i, m in all:
        if i > 0: text += "," end
        text += m
    end
    ret text + `],"outbounds":[{"tag":"direct","protocol":"freedom"}]}`
end

func main:
    dir := os.TempDir() + "/vpn-selftest-" + os.Pid()
    os.MkdirAll(dir)
    crt := dir + "/server.crt"
    key := dir + "/server.key"
    io.WriteFile(crt, testcert.CRT)
    io.WriteFile(key, testcert.KEY)

    workers = pool.NewElastic(2 as i64, 64 as i64, 64 as i64)
    doh_srv = tcp.Bind(0)
    _doh_t := spawn(doh_loop)
    mut doh_server := doh.NewServer("mock", doh.KindDoH, "http://127.0.0.1:" + tcp.Port(doh_srv) + "/dns-query")
    doh_server.addrs.push("127.0.0.1")
    mut doh_list := Vector {} as Vector<doh.Server>
    doh_list.push(doh_server)
    doh_resolver := doh.NewResolver(doh_list)
    vpn.RegisterWith(vpn.Options { fragment = true, use_doh = true, resolver = doh_resolver })
    echo_srv = tcp.Bind(0)
    site_srv = tcp.Bind(0)
    _echo_t := spawn(echo_loop)
    _site_t := spawn(site_loop)

    server_stats := tunnel.NewStats()
    cfg := tunnel.ParseConfig(server_config(crt, key, tcp.Port(site_srv)))
    servers := vpn.StartAll(cfg, server_stats)
    println "server inbounds:", servers.len()

    cases := [
        tunnel.Node { protocol = "vless", uuid = UUID, network = "tcp" }, tunnel.Node { protocol = "vless", uuid = UUID, network = "ws", path = "/v", tls = true, security = "tls", sni = "localhost", allow_insecure = true },
        tunnel.Node { protocol = "vmess", uuid = UUID, method = "auto", network = "tcp" }, tunnel.Node { protocol = "vmess", uuid = UUID, method = "chacha20-poly1305", network = "ws", path = "/m" },
        tunnel.Node { protocol = "trojan", password = "hunter2", network = "tcp", tls = true, security = "tls", sni = "localhost", allow_insecure = true },
        tunnel.Node { protocol = "ss", method = "aes-256-gcm", password = "s3cret", network = "tcp" }
    ]
    names := ["vless over tcp", "vless over ws+tls", "vmess over tcp", "vmess over ws", "trojan over tls", "shadowsocks over tcp"]
    each i, c in cases:
        mut n := c
        n.host = "127.0.0.1"
        n.port = servers[i].port
        n.valid = true
        stats := tunnel.NewStats()
        proxy := local_proxy(link_node(n), stats)
        report(names[i], via_socks(proxy.port))
        if i == 0: report("vless over tcp, http connect", via_http(proxy.port)) end
        vpn.Stop(proxy)
    end

    wrong := tunnel.Node { protocol = "vless", uuid = "00000000-0000-4000-8000-000000000001", network = "tcp", host = "127.0.0.1", port = servers[0].port, valid = true }
    bad := local_proxy(wrong, tunnel.NewStats())
    println "vless unknown user:", via_socks(bad.port) < 0 ? "rejected" : "ACCEPTED"
    vpn.Stop(bad)

    probe := transport.Dial("127.0.0.1", servers[4].port, transport.Settings { tls = true, allow_insecure = true, sni = "localhost" })
    probe_s := transport.AsStream(probe)
    tunnel.WriteAll(probe_s, "GET / HTTP/1.1\r\nHost: example.org\r\n\r\n")
    reply := tunnel.ReadUntil(probe_s, "website", 4096)
    println "trojan probe without password:", reply.ends_with("hello, website") ? "served the website" : "FAILED"
    probe_s.Close()

    named := tunnel.Node { protocol = "vless", uuid = UUID, network = "tcp", host = "doh.test", port = servers[0].port, valid = true }
    viadoh := local_proxy(named, tunnel.NewStats())
    report("vless to a name resolved over doh", via_socks(viadoh.port))
    vpn.Stop(viadoh)
    mut geo := tunnel.NewRouter("proxy")
    mut loop_rule := tunnel.NewRule("direct")
    tunnel.RuleCidr(loop_rule, "127.0.0.0/8")
    tunnel.RouterAdd(geo, loop_rule)
    tunnel.SetResolver(geo, vpn.DohResolver { resolver = doh_resolver, ipv6 = false }, 60000 as i64)
    println "cidr rule on a domain:", geo.MatchHost("doh.test", 80), geo.MatchHost("missing.test", 80)
    println "doh queries answered:", doh_queries > 0

    ir := tunnel.IranRouter("direct", "proxy")
    println "iran router:", ir.MatchHost("divar.ir", 443), ir.MatchHost("192.168.1.10", 80), ir.MatchHost("digikala.com", 443), ir.MatchHost("example.com", 443)

    each l in servers: vpn.Stop(l) end
    tcp.CloseServer(echo_srv)
    tcp.CloseServer(doh_srv)
    tcp.CloseServer(site_srv)
    os.RemoveAll(dir)
    println "failures:", failures
    ret failures
end
