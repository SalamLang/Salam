package main

import net.vpn
import flag
import os

func rest_args(): Vector<str>:
    mut out := Vector {} as Vector<str>
    each i, a in os.Args():
        if i > 0: out.push(a) end
    end
    ret out
end

func main:
    mut fs := flag.New("server", "one binary for vless, vmess, trojan and shadowsocks servers, driven by a v2ray style JSON config")
    flag.AddStr(fs, "config", "c", "", "JSON config file")
    flag.AddInt(fs, "stats", "", 10, "print traffic stats every N seconds")
    flag.AddInt(fs, "duration", "", 0, "exit after N seconds (0 = until Ctrl-C)")
    if not flag.Parse(fs, rest_args()) or flag.HelpWanted(fs) or flag.GetStr(fs, "config").len() == 0:
        println flag.Error(fs)
        println flag.Usage(fs)
        ret 2
    end
    vpn.RegisterWith(vpn.Options {})
    ret vpn.RunConfig(flag.GetStr(fs, "config"), flag.GetInt(fs, "stats") as int, flag.GetInt(fs, "duration") as int)
end
