package main

import flag
import os

include "registry.salam"
include "core.salam"

func rest_args(): Vector<str>:
    mut out := Vector {} as Vector<str>
    each i, a in os.Args():
        if i > 1: out.push(a) end
    end
    ret out
end

func main:
    mut fs := flag.New("vpn", "v2ray style runner: `vpn run -c config.json` starts every inbound and outbound in the file")
    flag.AddStr(fs, "config", "c", "", "JSON config file")
    flag.AddInt(fs, "stats", "", 10, "print traffic stats every N seconds")
    flag.AddInt(fs, "duration", "", 0, "exit after N seconds (0 = until Ctrl-C)")
    if os.Args().len() < 2 or os.Args()[1] != "run":
        println "usage: vpn run -c config.json"
        ret 2
    end
    if not flag.Parse(fs, rest_args()) or flag.HelpWanted(fs) or flag.GetStr(fs, "config").len() == 0:
        println flag.Error(fs)
        println flag.Usage(fs)
        ret 2
    end
    registry.Install(registry.Options {})
    ret core.RunConfig(flag.GetStr(fs, "config"), flag.GetInt(fs, "stats") as int, flag.GetInt(fs, "duration") as int)
end
