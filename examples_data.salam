        code_fa = "تابع ریشه:\n    عبارت := \"salam azad multi platform\"\n    ناپایا کلمات := عبارت.بشکاف(\" \")\n    ناپایا سرنام := \"\"\n    تکرار کلمات.طول() در i:\n        ک := کلمات.بگیر(i)\n        سرنام = سرنام + ک.زیررشته(0, 1)\n    پایان\n    سرچاپ عبارت, \"->\", سرنام\nپایان\n"
