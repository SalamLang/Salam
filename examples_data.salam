        code_fa = "تابع به دودویی(ن: صحیح): رشته:\n    اگر ن == 0: برگشت \"0\" پایان\n    ناپایا ایکس := ن\n    ناپایا بیتها := \"\"\n    تا ایکس > 0:\n        بیتها = \"\" + (ایکس % 2) + بیتها\n        ایکس = ایکس / 2\n    پایان\n    برگشت بیتها\nپایان\n\nتابع ریشه:\n    اعداد := [0, 5, 10, 255]\n    تکرار 4 در i:\n        سرچاپ اعداد[i], \"در مبنای دو =\", به دودویی(اعداد[i])\n    پایان\nپایان\n"
