        code_fa = "تابع ریشه:\n    ن := 100\n    ناپایا مجموع := 0\n    تکرار 1 تا ن در i: مجموع = مجموع + i پایان\n    فرمول := ن * (ن + 1) / 2\n    سرچاپ \"مجموع حلقه =\", مجموع\n    سرچاپ \"مجموع فرمول =\", فرمول\nپایان\n"
