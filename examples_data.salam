        title_en = "Struct: Rectangle"
        title_fa = "ساختار: مستطیل"
        code_en = "struct Rect:\n    pub w: f64 = 0.0\n    pub h: f64 = 0.0\n    pub func area(): f64: ret this.w * this.h end\n    pub func perimeter(): f64: ret 2.0 * (this.w + this.h) end\nend\n\nfunc main:\n    r := Rect { w = 4.0, h = 3.0 }\n    println \"area =\", r.area()\n    println \"perimeter =\", r.perimeter()\nend\n"
        code_fa = "ساختار مستطیل:\n    طول: اعشار۶۴ = 0.0\n    عرض: اعشار۶۴ = 0.0\n    همگانی تابع مساحت(): اعشار۶۴: برگشت این.طول * این.عرض پایان\n    همگانی تابع محیط(): اعشار۶۴: برگشت 2.0 * (این.طول + این.عرض) پایان\nپایان\n\nتابع ریشه:\n    ر := مستطیل { طول = 4.0, عرض = 3.0 }\n    سرچاپ \"مساحت =\", ر.مساحت()\n    سرچاپ \"محیط =\", ر.محیط()\nپایان\n"
    },
    Example {
        id = "wordcount"
        mode = "app"
        title_en = "Word count (HashMap)"
        title_fa = "شمارش کلمات"
        code_en = "func main:\n    text := \"the cat the dog the bird\"\n    mut words := text.split(\" \")\n    mut counts := HashMap {} as HashMap<str, int> repeat words.len() in i: w := words.get(i)\n    if counts.has(w): counts.put(w, counts.get(w) + 1)\n    else:\n        counts.put(w, 1)\n    end\nend\nmut it := counts.iter()\nuntil it.has_next():\n    println it.key(), \"->\", it.value()\n    it.next()\nend\nend\n"
        code_fa = "تابع ریشه:\n    متن := \"گربه سگ گربه پرنده گربه\"\n    ناپایا کلمات := متن.بشکاف(\" \")\n    ناپایا آمار := نگاشت {} برگردان نگاشت<رشته, صحیح> تکرار کلمات.طول() در i: ک := کلمات.بگیر(i)\n    اگر آمار.دارد(ک): آمار.درج(ک, آمار.بگیر(ک) + 1)\n    وگرنه:\n        آمار.درج(ک, 1)\n    پایان\nپایان\nناپایا پیمایه := آمار.پیمایش()\nتا پیمایه.داردبعدی():\n    سرچاپ پیمایه.کلید(), \"->\", پیمایه.مقدار()\n    پیمایه.بعدی()\nپایان\nپایان\n"
    },
