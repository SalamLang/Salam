        code_fa = "تابع ریشه:\n    س := \"Salam\"\n    ناپایا ر := \"\"\n    ناپایا i := س.طول() - 1\n    تا i >= 0:\n        ر = ر.پیوست(س.زیررشته(i, 1))\n        i = i - 1\n    پایان\n    سرچاپ \"وارونه‌ی\", س, \"می‌شود\", ر\nپایان\n"
