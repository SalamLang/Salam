        code_en = "func main:\n    mut n := 27\n    mut steps := 0\n    println \"Collatz from\", n\n    until n != 1:\n        if n % 2 == 0: n = n / 2\n        else:\n            n = 3 * n + 1\n        end\n        steps = steps + 1\n    end\n    println \"reached 1 in\", steps, \"steps\"\nend\n"
        code_fa = "تابع ریشه:\n    ناپایا ن := 27\n    ناپایا گامها := 0\n    سرچاپ \"کولاتز از\", ن\n    تا ن != 1:\n        اگر ن % 2 == 0: ن = ن / 2\n        وگرنه:\n            ن = 3 * ن + 1\n        پایان\n        گامها = گامها + 1\n    پایان\n    سرچاپ \"در\", گامها, \"گام به ۱ رسید\"\nپایان\n"
