    Example {
        id = "leap_year"
        mode = "app"
        title_en = "Leap year"
        title_fa = "سال کبیسه"
        code_en = "func is leap(y: int): bool:\n    if y % 400 == 0: ret true\n    else y % 100 == 0: ret false\n    else:\n        ret y % 4 == 0\n    end\nend\n\nfunc main:\n    years := [1900, 2000, 2012, 2021, 2024]\n    repeat 5 in i:\n        if is leap(years[i]): println years[i], \"is a leap year\"\n        else:\n            println years[i], \"is not a leap year\"\n        end\n    end\nend\n"
        code_fa = "تابع کبیسه است(سال: صحیح): منطقی:\n    اگر سال % 400 == 0: برگشت درست پایان\n    اگر سال % 100 == 0: برگشت نادرست پایان\n    برگشت سال % 4 == 0\nپایان\n\nتابع ریشه:\n    سالها := [1900, 2000, 2012, 2021, 2024]\n    تکرار 5 در i:\n        اگر کبیسه است(سالها[i]): سرچاپ سالها[i], \"کبیسه است\"\n        وگرنه:\n            سرچاپ سالها[i], \"کبیسه نیست\"\n        پایان\n    پایان\nپایان\n"
    },
    Example {
        id = "palindrome"
        mode = "app"
        title_en = "Palindrome number"
        title_fa = "عدد متقارن"
        code_en = "func is palindrome(n: int): bool:\n    mut x := n\n    mut rev := 0\n    until x > 0:\n        rev = rev * 10 + x % 10\n        x = x / 10\n    end\n    ret rev == n\nend\n\nfunc main:\n    nums := [121, 123, 1221, 13]\n    repeat 4 in i:\n        if is palindrome(nums[i]): println nums[i], \"is a palindrome\"\n        else:\n            println nums[i], \"is not a palindrome\"\n        end\n    end\nend\n"
        code_fa = "تابع متقارن است(ن: صحیح): منطقی:\n    ناپایا ایکس := ن\n    ناپایا برعکس := 0\n    تا ایکس > 0:\n        برعکس = برعکس * 10 + ایکس % 10\n        ایکس = ایکس / 10\n    پایان\n    برگشت برعکس == ن\nپایان\n\nتابع ریشه:\n    اعداد := [121, 123, 1221, 13]\n    تکرار 4 در i:\n        اگر متقارن است(اعداد[i]): سرچاپ اعداد[i], \"متقارن است\"\n        وگرنه:\n            سرچاپ اعداد[i], \"متقارن نیست\"\n        پایان\n    پایان\nپایان\n"
    },
    Example {
        id = "digit_sum"
        mode = "app"
        title_en = "Digit sum"
        title_fa = "جمع ارقام"
        code_en = "func digit sum(n: int): int:\n    mut x := n\n    mut s := 0\n    until x > 0:\n        s = s + x % 10\n        x = x / 10\n    end\n    ret s\nend\n\nfunc main:\n    println \"digit sum of 12345 =\", digit sum(12345)\n    println \"digit sum of 99 =\", digit sum(99)\nend\n"
        code_fa = "تابع جمع ارقام(ن: صحیح): صحیح:\n    ناپایا ایکس := ن\n    ناپایا مجموع := 0\n    تا ایکس > 0:\n        مجموع = مجموع + ایکس % 10\n        ایکس = ایکس / 10\n    پایان\n    برگشت مجموع\nپایان\n\nتابع ریشه:\n    سرچاپ \"جمع ارقام ۱۲۳۴۵ =\", جمع ارقام(12345)\n    سرچاپ \"جمع ارقام ۹۹ =\", جمع ارقام(99)\nپایان\n"
