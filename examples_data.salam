        title_en = "Factorial"
        title_fa = "فاکتوریل"
        code_en = "func fact(n: int): int:\n    if n <= 1: ret 1 end\n    ret n * fact(n - 1)\nend\n\nfunc main:\n    repeat 1 to 6 in i:\n        println i, \"! =\", fact(i)\n    end\nend\n"
        code_fa = "تابع فاکتوریل(ن: صحیح): صحیح:\n    اگر ن <= 1: برگشت 1 پایان\n    برگشت ن * فاکتوریل(ن - 1)\nپایان\n\nتابع ریشه:\n    تکرار 1 تا 6 در i:\n        سرچاپ i, \"! =\", فاکتوریل(i)\n    پایان\nپایان\n"
    },
    Example {
        id = "fibonacci"
        mode = "app"
        title_en = "Fibonacci"
        title_fa = "فیبوناچی"
        code_en = "func fib(n: int): int:\n    if n < 2: ret n end\n    ret fib(n - 1) + fib(n - 2)\nend\n\nfunc main:\n    mut line := \"\"\n    repeat 12 in i: line = line + fib(i) + \" \" end\n    println \"Fibonacci:\", line\nend\n"
        code_fa = "تابع فیب(ن: صحیح): صحیح:\n    اگر ن < 2: برگشت ن پایان\n    برگشت فیب(ن - 1) + فیب(ن - 2)\nپایان\n\nتابع ریشه:\n    ناپایا خط := \"\"\n    تکرار 12 در i: خط = خط + فیب(i) + \" \" پایان\n    سرچاپ \"فیبوناچی:\", خط\nپایان\n"
    },
    Example {
        id = "primes"
        mode = "app"
        title_en = "Primes"
        title_fa = "اعداد اول"
        code_en = "func is prime(n: int): bool:\n    if n < 2: ret false end\n    mut i := 2\n    until i * i <= n:\n        if n % i == 0: ret false end\n        i = i + 1\n    end\n    ret true\nend\n\nfunc main:\n    mut line := \"\"\n    repeat 2 to 30 in n:\n        if is prime(n): line = line + n + \" \" end\n    end\n    println \"Primes up to 30:\", line\nend\n"
        code_fa = "تابع اول است(ن: صحیح): منطقی:\n    اگر ن < 2: برگشت نادرست پایان\n    ناپایا i := 2\n    تا i * i <= ن:\n        اگر ن % i == 0: برگشت نادرست پایان\n        i = i + 1\n    پایان\n    برگشت درست\nپایان\n\nتابع ریشه:\n    ناپایا خط := \"\"\n    تکرار 2 تا 30 در ن:\n        اگر اول است(ن): خط = خط + ن + \" \" پایان\n    پایان\n    سرچاپ \"اعداد اول تا ۳۰:\", خط\nپایان\n"
    },
    Example {
        id = "gcd"
        mode = "app"
        title_en = "GCD"
        title_fa = "ب.م.م"
        code_en = "func gcd(a: int, b: int): int:\n    mut x := a\n    mut y := b\n    until y != 0:\n        t := y\n        y = x % y\n        x = t\n    end\n    ret x\nend\n\nfunc main:\n    println \"gcd(48, 36) =\", gcd(48, 36)\n    println \"gcd(17, 5) =\", gcd(17, 5)\nend\n"
        code_fa = "تابع بمم(الف: صحیح, ب: صحیح): صحیح:\n    ناپایا ایکس := الف\n    ناپایا ایگرگ := ب\n    تا ایگرگ != 0:\n        ت := ایگرگ\n        ایگرگ = ایکس % ایگرگ\n        ایکس = ت\n    پایان\n    برگشت ایکس\nپایان\n\nتابع ریشه:\n    سرچاپ \"ب.م.م ۴۸ و ۳۶ =\", بمم(48, 36)\n    سرچاپ \"ب.م.م ۱۷ و ۵ =\", بمم(17, 5)\nپایان\n"
    },
    Example {
        id = "bubblesort"
        mode = "app"
        title_en = "Bubble sort"
        title_fa = "مرتب‌سازی حبابی"
        code_en = "func main:\n    mut a := [5, 2, 8, 1, 9, 3]\n    repeat 6 in i:\n        repeat 5 - i in j:\n            if a[j] > a[j + 1]:\n                t := a[j]\n                a[j] = a[j + 1]\n                a[j + 1] = t\n            end\n        end\n    end\n    mut line := \"\"\n    repeat 6 in k: line = line + a[k] + \" \" end\n    println \"Sorted:\", line\nend\n"
        code_fa = "تابع ریشه:\n    ناپایا آ := [5, 2, 8, 1, 9, 3]\n    تکرار 6 در i:\n        تکرار 5 - i در ج:\n            اگر آ[ج] > آ[ج + 1]:\n                ت := آ[ج]\n                آ[ج] = آ[ج + 1]\n                آ[ج + 1] = ت\n            پایان\n        پایان\n    پایان\n    ناپایا خط := \"\"\n    تکرار 6 در ک: خط = خط + آ[ک] + \" \" پایان\n    سرچاپ \"مرتب‌شده:\", خط\nپایان\n"
    },
