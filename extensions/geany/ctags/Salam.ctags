--langdef=Salam
--map-Salam=+.salam
--kinddef-Salam=f,function,functions
--kinddef-Salam=s,struct,structs
--kinddef-Salam=e,enum,enums
--kinddef-Salam=i,interface,interfaces
--kinddef-Salam=c,component,components
--kinddef-Salam=p,page,pages
--kinddef-Salam=t,type,type aliases
--regex-Salam=/^[ \t]*((pub|inline|noinline|pure|همگانی|درخط|نادرخط|ناب)[ \t]+)*(func|تابع)[ \t]+([^(:<]+)/\4/f/{exclusive}
--regex-Salam=/^[ \t]*((pub|همگانی)[ \t]+)?(struct|ساختار)[ \t]+([^(:<]+)/\4/s/{exclusive}
--regex-Salam=/^[ \t]*((pub|همگانی)[ \t]+)?(enum|جداشمار)[ \t]+([^(:<]+)/\4/e/{exclusive}
--regex-Salam=/^[ \t]*((pub|همگانی)[ \t]+)?(interface|میانجی)[ \t]+([^(:<]+)/\4/i/{exclusive}
--regex-Salam=/^[ \t]*((pub|همگانی)[ \t]+)?(component|بخش)[ \t]+([^(:<]+)/\4/c/{exclusive}
--regex-Salam=/^[ \t]*((pub|همگانی)[ \t]+)?(page|صفحه)[ \t]+([^(:<]+)/\4/p/{exclusive}
--regex-Salam=/^[ \t]*((pub|همگانی)[ \t]+)?(type|گونه)[ \t]+([^= \t]+)/\4/t/{exclusive}
