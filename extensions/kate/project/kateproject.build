{
  "build": "salam build",
  "clean": "",
  "install": "",
  "targets": [
    {
      "name": "build",
      "build_cmd": "salam build"
    },
    {
      "name": "check",
      "build_cmd": "salam check ."
    },
    {
      "name": "build for web",
      "build_cmd": "salam build . --platform=web"
    },
    {
      "name": "run",
      "build_cmd": "salam run"
    }
  ]
}
