# Optional key bindings for Salam in nano. Hand written; salam.nanorc is generated.
# F5 runs the project in the current directory, F6 builds it, F7 builds it for
# the web, F8 runs the linter (salam check), F9 formats the buffer.
# Run and build output opens in a new buffer; ^X closes it.
# Include this file before salam.nanorc, or after it in the same rc file.

bind F5 "{execute}{flipnewbuffer}salam run{enter}" main
bind F6 "{execute}{flipnewbuffer}salam build --log-level=error{enter}" main
bind F7 "{execute}{flipnewbuffer}salam build --platform=web --log-level=error{enter}" main
bind F8 linter main
bind F9 formatter main
