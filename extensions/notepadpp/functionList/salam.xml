<?xml version="1.0" encoding="UTF-8" ?>
<NotepadPlus>
    <functionList>
        <parser
            displayName="Salam"
            id="salam_syntax"
            commentExpr="(?x)
                (?s:/\*.*?\*/)
              | (?m-s://.*?$)
            "
        >
            <function
                mainExpr="^[ \t]*(?:(?:pub|inline|noinline|pure|همگانی|درخط|نادرخط|ناب)[ \t]+)*(?:func|struct|enum|interface|component|page|تابع|ساختار|جداشمار|میانجی|بخش|صفحه)[ \t]+[^(:&lt;\r\n]+"
            >
                <functionName>
                    <nameExpr expr="(?:func|struct|enum|interface|component|page|تابع|ساختار|جداشمار|میانجی|بخش|صفحه)[ \t]+[^(:&lt;\r\n]+" />
                </functionName>
            </function>
        </parser>
    </functionList>
</NotepadPlus>
