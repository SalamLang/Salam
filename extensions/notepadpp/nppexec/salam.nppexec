// NppExec scripts for Salam. In NppExec, open Execute NppExec Script (F6),
// paste one script, press Save and give it the name in its heading.
// In Console Output Filters, set the Highlight mask to %FILE%:%LINE%:*
// so a double click on an error jumps to its line.

// ---- Salam Run ----
NPP_SAVE
cd "$(CURRENT_DIRECTORY)"
salam run "$(FILE_NAME)" --log-level=error --error-style=gcc

// ---- Salam Build ----
NPP_SAVE
cd "$(CURRENT_DIRECTORY)"
salam build "$(FILE_NAME)" --log-level=error --error-style=gcc

// ---- Salam Check ----
NPP_SAVE
cd "$(CURRENT_DIRECTORY)"
salam check "$(FILE_NAME)" --error-style=gcc

// ---- Salam Format ----
NPP_SAVE
cd "$(CURRENT_DIRECTORY)"
salam format "$(FILE_NAME)"
NPP_MENUCOMMAND File\Reload from Disk

// ---- Salam Build for web ----
NPP_SAVE
cd "$(CURRENT_DIRECTORY)"
salam build "$(FILE_NAME)" --platform=web --log-level=error --error-style=gcc

// ---- Salam Serve ----
NPP_SAVE
cd "$(CURRENT_DIRECTORY)"
NPP_RUN cmd /k salam run "$(FILE_NAME)" --platform=web
