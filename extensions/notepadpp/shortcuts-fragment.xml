<?xml version="1.0" encoding="UTF-8" ?>
<NotepadPlus>
    <UserDefinedCommands>
        <Command name="Salam: Run" Ctrl="yes" Alt="no" Shift="no" Key="116">cmd /k cd /d "$(CURRENT_DIRECTORY)" &amp;&amp; salam run "$(FULL_CURRENT_PATH)" --log-level=error</Command>
        <Command name="Salam: Build" Ctrl="yes" Alt="no" Shift="no" Key="117">cmd /k cd /d "$(CURRENT_DIRECTORY)" &amp;&amp; salam build "$(FULL_CURRENT_PATH)" --log-level=error --error-style=gcc</Command>
        <Command name="Salam: Check" Ctrl="yes" Alt="no" Shift="no" Key="118">cmd /k cd /d "$(CURRENT_DIRECTORY)" &amp;&amp; salam check "$(FULL_CURRENT_PATH)" --error-style=gcc</Command>
        <Command name="Salam: Format" Ctrl="yes" Alt="no" Shift="no" Key="119">cmd /c cd /d "$(CURRENT_DIRECTORY)" &amp;&amp; salam format "$(FULL_CURRENT_PATH)"</Command>
        <Command name="Salam: Build for web" Ctrl="yes" Alt="no" Shift="no" Key="120">cmd /k cd /d "$(CURRENT_DIRECTORY)" &amp;&amp; salam build "$(FULL_CURRENT_PATH)" --platform=web --log-level=error --error-style=gcc</Command>
        <Command name="Salam: Serve (live reload)" Ctrl="yes" Alt="no" Shift="yes" Key="116">cmd /k cd /d "$(CURRENT_DIRECTORY)" &amp;&amp; salam run "$(FULL_CURRENT_PATH)" --platform=web</Command>
        <Command name="Salam: Run project" Ctrl="no" Alt="no" Shift="no" Key="0">cmd /k cd /d "$(CURRENT_DIRECTORY)" &amp;&amp; salam run</Command>
        <Command name="Salam: New project" Ctrl="no" Alt="no" Shift="no" Key="0">cmd /k cd /d "$(CURRENT_DIRECTORY)" &amp;&amp; salam init</Command>
    </UserDefinedCommands>
</NotepadPlus>
