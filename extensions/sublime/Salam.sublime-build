{
    "selector": "source.salam",
    "file_regex": "^(.+?):([0-9]+):([0-9]+): (?:error|warning): (.*)$",
    "working_dir": "${file_path}",
    "target": "salam_run",
    "variants": [
        {
            "name": "Run (interpreter)",
            "target": "exec",
            "shell_cmd": "salam exec \"${file}\" --error-style=gcc"
        },
        {
            "name": "Build and Run",
            "target": "exec",
            "shell_cmd": "salam run \"${file}\" --error-style=gcc"
        },
        {
            "name": "Build (chosen platform)",
            "target": "salam_build"
        },
        {
            "name": "Build Executable",
            "target": "exec",
            "shell_cmd": "salam build \"${file}\" --error-style=gcc"
        },
        {
            "name": "Build Project",
            "target": "exec",
            "working_dir": "${folder}",
            "shell_cmd": "salam build --error-style=gcc"
        },
        {
            "name": "Build Project for All Platforms",
            "target": "exec",
            "working_dir": "${folder}",
            "shell_cmd": "salam build --platform=all --error-style=gcc"
        },
        {
            "name": "Build Web Page",
            "target": "exec",
            "shell_cmd": "salam build \"${file}\" --platform=web --error-style=gcc"
        },
        {
            "name": "Compile to JavaScript",
            "target": "exec",
            "shell_cmd": "salam build \"${file}\" --platform=js --error-style=gcc"
        },
        {
            "name": "Check (no run)",
            "target": "exec",
            "shell_cmd": "salam inspect \"${file}\" --emit-symbol --xml-out=/dev/null --error-style=gcc --log-level=error",
            "windows": {
                "shell_cmd": "salam inspect \"${file}\" --emit-symbol --xml-out=NUL --error-style=gcc --log-level=error"
            }
        },
        {
            "name": "Format",
            "target": "exec",
            "shell_cmd": "salam format \"${file}\" --error-style=gcc"
        },
        {
            "name": "Check Formatting",
            "target": "exec",
            "shell_cmd": "salam format --check \"${file}\" --error-style=gcc"
        },
        {
            "name": "Show Tokens (XML)",
            "target": "exec",
            "shell_cmd": "salam inspect \"${file}\" --emit-tokens --error-style=gcc"
        },
        {
            "name": "Show AST (XML)",
            "target": "exec",
            "shell_cmd": "salam inspect \"${file}\" --emit-ast --error-style=gcc"
        }
    ]
}
