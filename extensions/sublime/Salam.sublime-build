{
    // Build systems for the Salam programming language.
    //
    // "salam" must be on PATH. If it is not, either add it, or copy this file
    // to Packages/User/ and replace every "salam" below with an absolute path.
    //
    // --error-style=gcc turns the compiler's Rust-style diagnostics into the
    // one-line "file:line:col: error: message" form that file_regex reads.
    "selector": "source.salam",
    "file_regex": "^(.+?):([0-9]+):([0-9]+): (?:error|warning): (.*)$",
    "working_dir": "${file_path}",
    "shell_cmd": "salam exec \"${file}\" --error-style=gcc",
    "variants": [
        {
            "name": "Run (interpreter)",
            "shell_cmd": "salam exec \"${file}\" --error-style=gcc"
        },
        {
            "name": "Build and Run",
            "shell_cmd": "salam run \"${file}\" --error-style=gcc"
        },
        {
            "name": "Build Executable",
            "shell_cmd": "salam build \"${file}\" --error-style=gcc"
        },
        {
            "name": "Build Project",
            "working_dir": "${folder}",
            "shell_cmd": "salam build --error-style=gcc"
        },
        {
            "name": "Check (no run)",
            "shell_cmd": "salam inspect \"${file}\" --emit-symbol-xml --xml-out=/dev/null --error-style=gcc --log-level=error"
        },
        {
            "name": "Format",
            "shell_cmd": "salam format \"${file}\" --error-style=gcc"
        },
        {
            "name": "Check Formatting",
            "shell_cmd": "salam format --check \"${file}\" --error-style=gcc"
        },
        {
            "name": "Show Tokens (XML)",
            "shell_cmd": "salam inspect \"${file}\" --emit-tokens-xml --error-style=gcc"
        },
        {
            "name": "Show AST (XML)",
            "shell_cmd": "salam inspect \"${file}\" --emit-ast-xml --error-style=gcc"
        },
        {
            "name": "Build Web Page",
            "shell_cmd": "salam web \"${file}\" --error-style=gcc"
        },
        {
            "name": "Compile to JavaScript",
            "shell_cmd": "salam js \"${file}\" --error-style=gcc"
        }
    ]
}
