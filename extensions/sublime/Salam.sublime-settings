{

    "tab_size": 4,
    "translate_tabs_to_spaces": true,
    "trim_trailing_white_space_on_save": true,
    "ensure_newline_at_eof_on_save": true,
    "smart_indent": true,
    "auto_indent": true,

    "compiler_path": "salam",

    // Subcommand Run uses for a single file outside a project: "exec" or "run".
    "run_command": "exec",

    // What the status bar shows for a Salam file.
    "status_block_chain": true,
    "status_platform": true,

    "language_pack": "auto",

    "format_indent": "4",

    "format_on_save": false,

    "stdlib_path": "",

    // Seconds a single compiler run may take before it is killed. Formatting
    // holds the UI thread while it waits, so this is what stops a stalled
    // compiler from freezing the editor or a save.
    "timeout_seconds": 60,

    // Style check for if-chains that could be a switch (W145): "off" or "warn".
    "switch_lint": "off",

    // Minimum number of if-cases to report when switch_lint is enabled.
    "switch_lint_min": 4
}
