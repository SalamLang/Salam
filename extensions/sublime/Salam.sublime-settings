{
    // Settings applied to Salam source files, plus the options this package's
    // own commands read. Override them in Packages/User/Salam.sublime-settings.

    // --- editor behaviour for .salam buffers ---
    "tab_size": 4,
    "translate_tabs_to_spaces": true,
    "trim_trailing_white_space_on_save": true,
    "ensure_newline_at_eof_on_save": true,
    "smart_indent": true,
    "auto_indent": true,

    // --- package options ---

    // Path to the compiler. A bare name is looked up on PATH.
    "compiler_path": "salam",

    // Keyword language pack passed as --lang: "auto", "en", "fa" or "ar".
    // "auto" reads a //! lang: directive, then falls back to detecting
    // Persian or Arabic script in the file.
    "language_pack": "auto",

    // Indentation handed to `salam format --indent`: "tab", or 1-16 spaces.
    "format_indent": "4",

    // Reformat the buffer with `salam format` every time it is saved.
    "format_on_save": false,

    // Root directory for std/... imports, passed as --stdlib-path.
    // Empty means let the compiler find it.
    "stdlib_path": ""
}
