{

    "tab_size": 4,
    "translate_tabs_to_spaces": true,
    "trim_trailing_white_space_on_save": true,
    "ensure_newline_at_eof_on_save": true,
    "smart_indent": true,
    "auto_indent": true,

    "compiler_path": "salam",

    "language_pack": "auto",

    "format_indent": "4",

    "format_on_save": false,

    "stdlib_path": "",

    // Seconds a single compiler run may take before it is killed. Formatting
    // holds the UI thread while it waits, so this is what stops a stalled
    // compiler from freezing the editor or a save.
    "timeout_seconds": 60
}
