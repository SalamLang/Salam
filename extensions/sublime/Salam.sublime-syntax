%YAML 1.2
---
# Generated by extensions/tools/gen_syntaxes.salam
name: Salam
scope: source.salam
version: 2

file_extensions:
  - salam

first_line_match: '^//!'

variables:
  ids: 'A-Za-z_\x{0600}-\x{06FF}\x{0750}-\x{077F}\x{08A0}-\x{08FF}\x{FB50}-\x{FDFF}\x{FE70}-\x{FEFF}\x{200C}\x{200D}'
  idc: 'A-Za-z0-9_\x{0600}-\x{06FF}\x{0750}-\x{077F}\x{08A0}-\x{08FF}\x{FB50}-\x{FDFF}\x{FE70}-\x{FEFF}\x{200C}\x{200D}'
  ident: '[{{ids}}][{{idc}}]*'
  nbb: '(?<![{{idc}}])'
  nba: '(?![{{idc}}])'
  d: '[0-9\x{0660}-\x{0669}\x{06F0}-\x{06F9}]'
  dc: '0-9\x{0660}-\x{0669}\x{06F0}-\x{06F9}_'

contexts:
  main:
    - include: directives
    - include: comments
    - include: annotations
    - include: strings
    - include: numbers
    - include: definitions
    - include: keywords
    - include: layout-element
    - include: function-call
    - include: member
    - include: operators
    - include: punctuation

  directives:
    - match: '//!'
      scope: punctuation.definition.comment.salam
      push:
        - meta_scope: comment.line.directive.salam
        - match: '$\n?'
          pop: true
        - match: '\b(?:version|title|mode|lang|name|dir)\b'
          scope: keyword.other.directive.salam
        - match: '\|'
          scope: punctuation.separator.directive.salam

  comments:
    - match: '/\*'
      scope: punctuation.definition.comment.begin.salam
      push:
        - meta_scope: comment.block.salam
        - match: '\*/'
          scope: punctuation.definition.comment.end.salam
          pop: true
    - match: '//'
      scope: punctuation.definition.comment.salam
      push:
        - meta_scope: comment.line.double-slash.salam
        - match: '$\n?'
          pop: true

  annotations:
    - match: '(@)([A-Za-z_][{{idc}}]*)'
      captures:
        1: punctuation.definition.annotation.salam
        2: storage.modifier.annotation.salam

  strings:
    - match: '"""'
      scope: punctuation.definition.string.begin.salam
      push:
        - meta_scope: string.quoted.triple.salam
        - match: '"""'
          scope: punctuation.definition.string.end.salam
          pop: true
        - include: string-escapes
    - match: '"'
      scope: punctuation.definition.string.begin.salam
      push:
        - meta_scope: string.quoted.double.salam
        - match: '"'
          scope: punctuation.definition.string.end.salam
          pop: true
        - match: '\n'
          scope: invalid.illegal.newline.salam
          pop: true
        - include: string-escapes
    - match: '`'
      scope: punctuation.definition.string.begin.salam
      push:
        - meta_scope: string.quoted.raw.salam
        - match: '`'
          scope: punctuation.definition.string.end.salam
          pop: true
    - match: '{{nbb}}u?''(\\(?:x[0-9A-Fa-f]{2}|u\{[0-9A-Fa-f]+\}|u[0-9A-Fa-f]{4}|.)|[^''\\])'''
      scope: string.quoted.single.salam

  string-escapes:
    - match: '\\(?:x[0-9A-Fa-f]{2}|u\{[0-9A-Fa-f]+\}|u[0-9A-Fa-f]{4}|[0abfnrtv"''\\])'
      scope: constant.character.escape.salam
    - match: '\\.'
      scope: invalid.illegal.unknown-escape.salam

  numbers:
    - match: '{{nbb}}(?:{{d}}[{{dc}}]*\.{{d}}[{{dc}}]*(?:[eE][+-]?{{d}}[{{dc}}]*)?|{{d}}[{{dc}}]*[eE][+-]?{{d}}[{{dc}}]*)f?{{nba}}'
      scope: constant.numeric.float.salam
    - match: '{{nbb}}0[xX][0-9A-Fa-f][0-9A-Fa-f_]*{{nba}}'
      scope: constant.numeric.integer.hexadecimal.salam
    - match: '{{nbb}}0[bB][01][01_]*{{nba}}'
      scope: constant.numeric.integer.binary.salam
    - match: '{{nbb}}0[oO][0-7][0-7_]*{{nba}}'
      scope: constant.numeric.integer.octal.salam
    - match: '{{nbb}}{{d}}[{{dc}}]*f?{{nba}}'
      scope: constant.numeric.integer.decimal.salam

  definitions:
    - match: '({{nbb}}(?:func|تابع|دالة){{nba}})\s+({{ident}})'
      captures:
        1: storage.type.function.salam keyword.declaration.function.salam
        2: entity.name.function.salam
    - match: '({{nbb}}(?:interface|component|package|struct|ساختار|شمارش|مولفه|تعداد|واجهة|type|enum|بسته|واسط|بنية|حزمة|مكون|نوع){{nba}})\s+({{ident}})'
      captures:
        1: storage.type.salam keyword.declaration.type.salam
        2: entity.name.type.salam

  keywords:
    - match: '{{nbb}}(?:continue|repeat|بازگشت|تاوقتی|until|break|defer|match|while|وگرنه|ادامه|تعلیق|تکرار|تطبیق|بينما|نهاية|else|each|with|تمام|بشکن|أرجع|وإلا|اكسر|واصل|خطوة|طابق|ret|end|اگر|گام|إذا|أجل|كرر|إلى|if|to|by|in|تا|هر|در|با|كل|في|مع){{nba}}'
      scope: keyword.control.salam
    - match: '{{nbb}}(?:یا|أو|و){{nba}}'
      scope: keyword.operator.word.salam
    - match: '{{nbb}}(?:غیردرون‌خطی|deprecated|پیاده‌سازی|interface|component|بی‌بازگشت|operator|noinline|واردکردن|درون‌خطی|package|استيراد|غيرمضمن|struct|import|layout|extern|inline|ساختار|بعنوان|لايرجع|const|noret|متغیر|شمارش|عملگر|خارجی|عمومی|منسوخ|مولفه|متغير|تعداد|بوصفه|خارجي|واجهة|مهجور|تنفيذ|func|type|enum|pure|impl|تابع|ثابت|صفحه|بسته|واسط|خالص|دالة|بنية|صفحة|حزمة|عامل|مضمن|مكون|mut|pub|نوع|على|عام|نقي|on|as|بر){{nba}}'
      scope: storage.type.salam
    - match: '{{nbb}}(?:printerrln|printerr|خطابنویس|println|اكتبخطأ|اطبعخطأ|خطاچاپ|print|input|بنویس|بخوان|اكتب|اطبع|اقرأ|چاپ){{nba}}'
      scope: support.function.builtin.salam
    - match: '{{nbb}}_{1,2}{{nba}}'
      scope: support.function.builtin.salam
    - match: '{{nbb}}(?:نادرست|false|true|null|درست|صواب|پوچ|خطأ|عدم){{nba}}'
      scope: constant.language.salam
    - match: '{{nbb}}(?:this|این|هذا){{nba}}'
      scope: variable.language.this.salam
    - match: '{{nbb}}(?:خودکار|تلقائي|auto){{nba}}'
      scope: storage.type.auto.salam
    - match: '{{nbb}}(?:طبیعی۱۶|طبیعی۳۲|طبیعی۶۴|طبیعی16|طبیعی32|طبیعی64|اعشار۳۲|اعشار۶۴|اعشار32|اعشار64|يونيكود|طبيعي١٦|طبيعي٣٢|طبيعي٦٤|طبيعي16|طبيعي32|طبيعي64|یونیکد|صحیح۱۶|صحیح۳۲|صحیح۶۴|صحیح16|صحیح32|صحیح64|طبیعی۸|طبیعی8|اندازه|صحيح١٦|صحيح٣٢|صحيح٦٤|صحيح16|صحيح32|صحيح64|طبيعي٨|طبيعي8|عشري٣٢|عشري٦٤|عشري32|عشري64|uchar|float|منطقی|نویسه|صحیح۸|صحیح8|طبیعی|اعشار|منطقي|صحيح٨|صحيح8|طبيعي|void|bool|char|uint|size|رشته|صحیح|فراغ|صحيح|عشري|str|i16|i32|int|i64|u16|u32|u64|f32|f64|تهی|حرف|حجم|i8|u8|نص){{nba}}'
      scope: storage.type.primitive.salam
    - match: '{{nbb}}(?:پیمایشگرنگاشت|مكررخريطة|HashMap|MapIter|گوناگون|Variant|Vector|پرونده|وکتور|نگاشت|خريطة|متنوع|متجه|File|ملف){{nba}}'
      scope: support.class.builtin.salam
    - match: '{{nbb}}(?:%%CONTEXTUAL%%){{nba}}'
      scope: keyword.other.salam

  layout-element:
    - match: '^\s*(?!(?:غیردرون‌خطی|deprecated|پیاده‌سازی|printerrln|interface|component|بی‌بازگشت|continue|operator|noinline|واردکردن|درون‌خطی|printerr|خطابنویس|package|استيراد|غيرمضمن|println|اكتبخطأ|اطبعخطأ|repeat|بازگشت|تاوقتی|struct|import|layout|extern|inline|ساختار|بعنوان|لايرجع|نادرست|خطاچاپ|until|break|defer|match|while|وگرنه|ادامه|تعلیق|تکرار|تطبیق|بينما|نهاية|const|noret|متغیر|شمارش|عملگر|خارجی|عمومی|منسوخ|مولفه|متغير|تعداد|بوصفه|خارجي|واجهة|مهجور|تنفيذ|false|print|input|بنویس|بخوان|else|each|with|تمام|بشکن|أرجع|وإلا|اكسر|واصل|خطوة|طابق|func|type|enum|pure|impl|تابع|ثابت|صفحه|بسته|واسط|خالص|دالة|بنية|صفحة|حزمة|عامل|مضمن|مكون|true|null|درست|صواب|this|اكتب|اطبع|اقرأ|ret|end|اگر|گام|إذا|أجل|كرر|إلى|mut|pub|نوع|على|عام|نقي|پوچ|خطأ|عدم|این|هذا|چاپ|if|to|by|in|تا|هر|در|با|كل|في|مع|on|as|بر|یا|أو|و){{nba}})({{ident}})\s*(:)\s*$'
      captures:
        1: entity.name.tag.layout.salam
        2: punctuation.section.block.begin.salam

  function-call:
    - match: '({{ident}})\s*(?=\()'
      scope: variable.function.salam

  member:
    - match: '(?<=\.)\s*(?:خواندن خط|داردبعدی|يوجدتالي|has_next|قراءةسطر|readline|به اعشار|to_float|دربیاور|جابجایی|زیررشته|به صحیح|إلىصحيح|إلىعشري|آزادکن|remove|اندازه|پیمایش|التالي|خواندن|انتقال|concat|substr|پیراست|to_int|بیفزا|ارجاع|بنشان|ظرفیت|تكرار|مفتاح|مقدار|value|قراءة|نوشتن|كتابة|write|close|پیوست|بشکاف|split|push|أخرج|بگیر|احصل|مرجع|free|دارد|يحوي|احذف|size|iter|کلید|قيمة|بعدی|next|read|seek|ببند|أغلق|مقطع|بیاب|ابحث|find|trim|أضف|pop|get|ref|عين|set|طول|len|سعة|cap|حرر|درج|put|has|حذف|حجم|key|دمج|قسم|شذب|ضع){{nba}}'
      scope: support.function.builtin.salam
    - match: '(?<=\.)\s*({{ident}})'
      scope: variable.other.member.salam

  operators:
    - match: '=>'
      scope: keyword.operator.arrow.salam
    - match: '\.\.\.'
      scope: keyword.operator.spread.salam
    - match: '==|!=|<=|>=|<|>'
      scope: keyword.operator.comparison.salam
    - match: '\^\^=|\+=|-=|\*=|/=|%='
      scope: keyword.operator.assignment.augmented.salam
    - match: '&&|\|\||!'
      scope: keyword.operator.logical.salam
    - match: ':='
      scope: keyword.operator.assignment.salam
    - match: '\^\^|[+\-*/%]'
      scope: keyword.operator.arithmetic.salam
    - match: '&'
      scope: keyword.operator.reference.salam
    - match: '='
      scope: keyword.operator.assignment.salam
    - match: '\?'
      scope: keyword.operator.ternary.salam

  punctuation:
    - match: ','
      scope: punctuation.separator.salam
    - match: ':'
      scope: punctuation.separator.salam
    - match: '\.'
      scope: punctuation.accessor.salam
    - match: '[()]'
      scope: punctuation.section.parens.salam
    - match: '[\[\]]'
      scope: punctuation.section.brackets.salam
    - match: '[{}]'
      scope: punctuation.section.braces.salam
