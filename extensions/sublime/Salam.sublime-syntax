%YAML 1.2
---
# Generated by extensions/tools/gen_syntaxes.salam
name: Salam
scope: source.salam
version: 2

file_extensions:
  - salam

first_line_match: '^//!'

variables:
  ids: 'A-Za-z_\x{0600}-\x{06FF}\x{0750}-\x{077F}\x{08A0}-\x{08FF}\x{FB50}-\x{FDFF}\x{FE70}-\x{FEFF}\x{200C}\x{200D}'
  idc: 'A-Za-z0-9_\x{0600}-\x{06FF}\x{0750}-\x{077F}\x{08A0}-\x{08FF}\x{FB50}-\x{FDFF}\x{FE70}-\x{FEFF}\x{200C}\x{200D}'
  ident: '[{{ids}}][{{idc}}]*'
  nbb: '(?<![{{idc}}])'
  nba: '(?![{{idc}}])'
  d: '[0-9\x{0660}-\x{0669}\x{06F0}-\x{06F9}]'
  dc: '0-9\x{0660}-\x{0669}\x{06F0}-\x{06F9}_'

contexts:
  main:
    - include: directives
    - include: comments
    - include: annotations
    - include: strings
    - include: numbers
    - include: definitions
    - include: keywords
    - include: layout-element
    - include: function-call
    - include: member
    - include: operators
    - include: punctuation

  directives:
    - match: '//!'
      scope: punctuation.definition.comment.salam
      push:
        - meta_scope: comment.line.directive.salam
        - match: '$\n?'
          pop: true
        - match: '\b(?:version|title|mode|lang|name|dir)\b'
          scope: keyword.other.directive.salam
        - match: '\|'
          scope: punctuation.separator.directive.salam

  comments:
    - match: '/\*'
      scope: punctuation.definition.comment.begin.salam
      push:
        - meta_scope: comment.block.salam
        - match: '\*/'
          scope: punctuation.definition.comment.end.salam
          pop: true
    - match: '//'
      scope: punctuation.definition.comment.salam
      push:
        - meta_scope: comment.line.double-slash.salam
        - match: '$\n?'
          pop: true

  annotations:
    - match: '(@)([A-Za-z_][{{idc}}]*)'
      captures:
        1: punctuation.definition.annotation.salam
        2: storage.modifier.annotation.salam

  strings:
    - match: '"""'
      scope: punctuation.definition.string.begin.salam
      push:
        - meta_scope: string.quoted.triple.salam
        - match: '"""'
          scope: punctuation.definition.string.end.salam
          pop: true
        - include: string-escapes
    - match: '"'
      scope: punctuation.definition.string.begin.salam
      push:
        - meta_scope: string.quoted.double.salam
        - match: '"'
          scope: punctuation.definition.string.end.salam
          pop: true
        - match: '\n'
          scope: invalid.illegal.newline.salam
          pop: true
        - include: string-escapes
    - match: '`'
      scope: punctuation.definition.string.begin.salam
      push:
        - meta_scope: string.quoted.raw.salam
        - match: '`'
          scope: punctuation.definition.string.end.salam
          pop: true
    - match: '{{nbb}}u?''(\\(?:x[0-9A-Fa-f]{2}|u\{[0-9A-Fa-f]+\}|u[0-9A-Fa-f]{4}|.)|[^''\\])'''
      scope: string.quoted.single.salam

  string-escapes:
    - match: '\\(?:x[0-9A-Fa-f]{2}|u\{[0-9A-Fa-f]+\}|u[0-9A-Fa-f]{4}|[0abfnrtv"''\\])'
      scope: constant.character.escape.salam
    - match: '\\.'
      scope: invalid.illegal.unknown-escape.salam

  numbers:
    - match: '{{nbb}}(?:{{d}}[{{dc}}]*\.{{d}}[{{dc}}]*(?:[eE][+-]?{{d}}[{{dc}}]*)?|{{d}}[{{dc}}]*[eE][+-]?{{d}}[{{dc}}]*)f?{{nba}}'
      scope: constant.numeric.float.salam
    - match: '{{nbb}}0[xX][0-9A-Fa-f][0-9A-Fa-f_]*{{nba}}'
      scope: constant.numeric.integer.hexadecimal.salam
    - match: '{{nbb}}0[bB][01][01_]*{{nba}}'
      scope: constant.numeric.integer.binary.salam
    - match: '{{nbb}}0[oO][0-7][0-7_]*{{nba}}'
      scope: constant.numeric.integer.octal.salam
    - match: '{{nbb}}{{d}}[{{dc}}]*f?{{nba}}'
      scope: constant.numeric.integer.decimal.salam

  definitions:
    - match: '({{nbb}}(?:func|روال){{nba}})\s+({{ident}})'
      captures:
        1: storage.type.function.salam keyword.declaration.function.salam
        2: entity.name.function.salam
    - match: '({{nbb}}(?:interface|component|package|جداشمار|struct|ساختار|میانجی|type|enum|گونه|بسته|بخش){{nba}})\s+({{ident}})'
      captures:
        1: storage.type.salam keyword.declaration.type.salam
        2: entity.name.type.salam

  keywords:
    - match: '{{nbb}}(?:continue|repeat|همخوان|until|break|defer|match|برگشت|وگرنه|پایان|دیرکن|تکرار|else|each|with|بشکن|ret|end|اگر|گذر|if|to|by|in|تا|هر|از){{nba}}'
      scope: keyword.control.salam
    - match: '{{nbb}}(?:نابرابر|برابر|یا|و){{nba}}'
      scope: keyword.operator.word.salam
    - match: '{{nbb}}(?:deprecated|interface|component|operator|noinline|واردسازی|فراخوانه|package|جداشمار|برگردان|نابرگشت|بی‌کاره|struct|import|layout|extern|inline|ناپایا|ساختار|چیدمان|میانجی|همگانی|نادرخط|کاربست|const|noret|کارور|func|type|enum|pure|impl|روال|پایا|گونه|بسته|درخط|mut|pub|ناب|بخش|on|as|بر){{nba}}'
      scope: storage.type.salam
    - match: '{{nbb}}(?:نادرست‌سرچاپ|printerrln|نادرست‌چاپ|printerr|println|print|input|سرچاپ|ورودی|چاپ){{nba}}'
      scope: support.function.builtin.salam
    - match: '{{nbb}}_{1,2}{{nba}}'
      scope: support.function.builtin.salam
    - match: '{{nbb}}(?:نادرست|false|true|null|درست|پوچ){{nba}}'
      scope: constant.language.salam
    - match: '{{nbb}}(?:this|این){{nba}}'
      scope: variable.language.this.salam
    - match: '{{nbb}}(?:خودکار|تلقائي|auto){{nba}}'
      scope: storage.type.auto.salam
    - match: '{{nbb}}(?:طبیعی۱۶|طبیعی۳۲|طبیعی۶۴|طبیعی16|طبیعی32|طبیعی64|اعشار۳۲|اعشار۶۴|اعشار32|اعشار64|یونیکد|صحیح۱۶|صحیح۳۲|صحیح۶۴|صحیح16|صحیح32|صحیح64|طبیعی۸|طبیعی8|اندازه|uchar|float|منطقی|نویسه|صحیح۸|صحیح8|طبیعی|اعشار|void|bool|char|uint|size|رشته|صحیح|str|i16|i32|int|i64|u16|u32|u64|f32|f64|تهی|i8|u8){{nba}}'
      scope: storage.type.primitive.salam
    - match: '{{nbb}}(?:پیمایشگرنگاشت|HashMap|MapIter|گوناگون|Variant|Vector|پرونده|وکتور|نگاشت|File){{nba}}'
      scope: support.class.builtin.salam
    - match: '{{nbb}}(?:framework|dynamic|static|چارچوب|پیوند|ایستا|link|پویا|dyn){{nba}}'
      scope: keyword.other.salam

  layout-element:
    - match: '^\s*(?!(?:نادرست‌سرچاپ|deprecated|printerrln|نادرست‌چاپ|interface|component|continue|operator|noinline|واردسازی|فراخوانه|printerr|package|جداشمار|برگردان|نابرگشت|بی‌کاره|println|نابرابر|repeat|همخوان|struct|import|layout|extern|inline|ناپایا|ساختار|چیدمان|میانجی|همگانی|نادرخط|کاربست|نادرست|until|break|defer|match|برگشت|وگرنه|پایان|دیرکن|تکرار|const|noret|کارور|false|print|input|سرچاپ|ورودی|برابر|else|each|with|بشکن|func|type|enum|pure|impl|روال|پایا|گونه|بسته|درخط|true|null|درست|this|ret|end|اگر|گذر|mut|pub|ناب|بخش|پوچ|این|چاپ|if|to|by|in|تا|هر|از|on|as|بر|یا|و){{nba}})({{ident}})\s*(:)\s*$'
      captures:
        1: entity.name.tag.layout.salam
        2: punctuation.section.block.begin.salam

  function-call:
    - match: '({{ident}})\s*(?=\()'
      scope: variable.function.salam

  member:
    - match: '(?<=\.)\s*(?:خواندن خط|داردبعدی|has_next|readline|به اعشار|to_float|دربیاور|جابجایی|زیررشته|به صحیح|آزادکن|remove|اندازه|پیمایش|خواندن|concat|substr|پیراست|to_int|بیفزا|ارجاع|بنشان|ظرفیت|مقدار|value|نوشتن|write|close|پیوست|بشکاف|split|push|بگیر|free|دارد|size|iter|کلید|بعدی|next|read|seek|ببند|بیاب|find|trim|pop|get|ref|set|طول|len|cap|درج|put|has|حذف|key){{nba}}'
      scope: support.function.builtin.salam
    - match: '(?<=\.)\s*({{ident}})'
      scope: variable.other.member.salam

  operators:
    - match: '=>'
      scope: keyword.operator.arrow.salam
    - match: '\.\.\.'
      scope: keyword.operator.spread.salam
    - match: '==|!=|<=|>=|<|>'
      scope: keyword.operator.comparison.salam
    - match: '\^\^=|\+=|-=|\*=|/=|%='
      scope: keyword.operator.assignment.augmented.salam
    - match: '&&|\|\||!'
      scope: keyword.operator.logical.salam
    - match: ':='
      scope: keyword.operator.assignment.salam
    - match: '\^\^|[+\-*/%]'
      scope: keyword.operator.arithmetic.salam
    - match: '&'
      scope: keyword.operator.reference.salam
    - match: '='
      scope: keyword.operator.assignment.salam
    - match: '\?'
      scope: keyword.operator.ternary.salam

  punctuation:
    - match: ','
      scope: punctuation.separator.salam
    - match: ':'
      scope: punctuation.separator.salam
    - match: '\.'
      scope: punctuation.accessor.salam
    - match: '[()]'
      scope: punctuation.section.parens.salam
    - match: '[\[\]]'
      scope: punctuation.section.brackets.salam
    - match: '[{}]'
      scope: punctuation.section.braces.salam
