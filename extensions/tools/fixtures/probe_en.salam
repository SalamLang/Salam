// comment
link static "m"
func demo(n: int):
    if n > 42:
        println "hello"
    end
    match n:
        0: println "zero" end
        else: println "other" end
    end
end
page:
    box:
        width = 50%
        height = 12px
        color = #3366aa
        gap = 1.5em
        padding = 2rem, 1fr
        left = 50vw
        delay = 200ms
        fade = 0.3s
        transition = 150ms, ease out
        turn = 45deg
        spin = 0.5turn
        shade = #fff
        tint = #ffff
        edge = #3366aa80
    end
end
