// comment
پیوند ایستا "m"
تابع نمایش(ع: صحیح۳۲):
    اگر ع > ۱۲۳:
        سرچاپ "سلام"
    پایان
    همخوان ع:
        0: سرچاپ "صفر" پایان
        وگرنه: سرچاپ "دیگر" پایان
    پایان
پایان
صفحه:
    جعبه:
        عرض = ۵۰٪
        ارتفاع = ۱۲px
        رنگ = #3366aa
        شکاف = ۱.۵em
        فاصله = ۲rem ، ۱fr
        چپ = ۵۰vw
        تاخیر = ۲۰۰ms
        محو = ۰.۳s
        گذار = ۱۵۰ms ، ease out
        چرخش = ۴۵deg
        گردش = ۰.۵turn
        سایه = #fff
        پرده = #ffff
        لبه = #3366aa80
    پایان
پایان
