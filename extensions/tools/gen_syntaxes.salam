import str
import os
import sort
import encoding.json

LANGPACK_SRC := "compiler/langpack.salam"
SEMANTIC_SRC := "compiler/semantic/semantic.salam"
EXT_DIR := "extensions"
SNIPPETS_SRC := "extensions/vscode/snippets/salam.code-snippets"

ONIG_IDS := "A-Za-z_\\x{0600}-\\x{06FF}\\x{0750}-\\x{077F}\\x{08A0}-\\x{08FF}\\x{FB50}-\\x{FDFF}\\x{FE70}-\\x{FEFF}\\x{200C}\\x{200D}"
ONIG_IDC := "A-Za-z0-9_\\x{0600}-\\x{06FF}\\x{0750}-\\x{077F}\\x{08A0}-\\x{08FF}\\x{FB50}-\\x{FDFF}\\x{FE70}-\\x{FEFF}\\x{200C}\\x{200D}"

EL_IDS := "[:alpha:]_؀-ۿݐ-ݿࢠ-ࣿﭐ-﷿ﹰ-﻿‌‍"
EL_IDC := "[:alnum:]_؀-ۿݐ-ݿࢠ-ࣿﭐ-﷿ﹰ-﻿‌‍"

ONIG_DIGIT := "0-9\\x{0660}-\\x{0669}\\x{06F0}-\\x{06F9}"
VIM_DIGIT := "0-9\\u0660-\\u0669\\u06f0-\\u06f9"
EL_DIGIT := "0-9٠-٩۰-۹"

VIM_ISKEYWORD := "@,48-57,_,192-255"

TK_FUNC := 10
TK_RET := 11
TK_IF := 12
TK_ELSE := 13
TK_UNTIL := 14
TK_ON := 15
TK_MUT := 16
TK_CONST := 17
TK_TYPE := 18
TK_STRUCT := 19
TK_ENUM := 20
TK_END := 21
TK_IMPORT := 22
TK_AS := 23
TK_TRUE := 24
TK_FALSE := 25
TK_NULL := 26
TK_THIS := 27
TK_BREAK := 28
TK_CONTINUE := 29
TK_LAYOUT := 30
TK_PACKAGE := 31
TK_PRINT := 32
TK_PRINTLN := 33
TK_PRINTERR := 34
TK_PRINTERRLN := 35
TK_INPUT := 36
TK_DEFER := 37
TK_OPERATOR := 38
TK_EXTERN := 39
TK_INTERFACE := 40
TK_PUB := 41
TK_INLINE := 42
TK_NOINLINE := 43
TK_PURE_FN := 44
TK_NORET := 45
TK_DEPRECATED := 46
TK_COMPONENT := 47
TK_REPEAT := 48
TK_IMPL := 49
TK_TO := 50
TK_STEP := 51
TK_EACH := 52
TK_IN := 53
TK_WITH := 54
TK_MATCH := 55
TK_SWITCH := 110
TK_EQ := 62
TK_NE := 63
TK_AND := 68
TK_OR := 69

CONTROL_KINDS := [
    TK_IF, TK_ELSE, TK_UNTIL, TK_END, TK_RET, TK_BREAK, TK_CONTINUE, TK_DEFER, TK_REPEAT, TK_TO, TK_STEP, TK_EACH, TK_IN, TK_WITH, TK_MATCH, TK_SWITCH
]

STORAGE_KINDS := [
    TK_FUNC, TK_ON, TK_MUT, TK_CONST, TK_TYPE, TK_STRUCT, TK_ENUM, TK_IMPORT, TK_AS, TK_LAYOUT, TK_PACKAGE, TK_OPERATOR, TK_EXTERN, TK_INTERFACE, TK_PUB, TK_INLINE, TK_NOINLINE, TK_PURE_FN, TK_NORET, TK_DEPRECATED, TK_COMPONENT, TK_IMPL
]

CONST_KINDS := [TK_TRUE, TK_FALSE, TK_NULL]

THIS_KINDS := [TK_THIS]

IO_KINDS := [TK_PRINT, TK_PRINTLN, TK_PRINTERR, TK_PRINTERRLN, TK_INPUT]

LOGICAL_KINDS := [TK_AND, TK_OR, TK_EQ, TK_NE]

CONDITIONAL_KINDS := [TK_IF, TK_ELSE, TK_MATCH, TK_SWITCH]

LOOP_KINDS := [TK_UNTIL, TK_REPEAT, TK_EACH]

STATEMENT_KINDS := [
    TK_RET, TK_END, TK_BREAK, TK_CONTINUE, TK_DEFER, TK_TO, TK_STEP, TK_IN, TK_WITH
]

STRUCTURE_KINDS := [TK_TYPE, TK_STRUCT, TK_ENUM, TK_INTERFACE, TK_COMPONENT]

STORAGECLASS_KINDS := [
    TK_MUT, TK_CONST, TK_EXTERN, TK_PUB, TK_INLINE, TK_NOINLINE, TK_PURE_FN, TK_NORET, TK_DEPRECATED
]

INCLUDE_KINDS := [TK_IMPORT, TK_PACKAGE]

KEYWORD_KINDS := [TK_ON, TK_AS, TK_LAYOUT, TK_OPERATOR, TK_IMPL]

BOOLEAN_KINDS := [TK_TRUE, TK_FALSE]

NULL_KINDS := [TK_NULL]

BLOCK_OPEN_KINDS := [
    TK_FUNC, TK_IF, TK_UNTIL, TK_ON, TK_TYPE, TK_STRUCT, TK_ENUM, TK_LAYOUT, TK_EXTERN, TK_INTERFACE, TK_COMPONENT, TK_REPEAT, TK_IMPL, TK_EACH, TK_MATCH, TK_SWITCH
]

END_KINDS := [TK_END]

ELSE_KINDS := [TK_ELSE]

FUNC_DEF_KINDS := [TK_FUNC]

TYPE_DEF_KINDS := [TK_TYPE, TK_STRUCT, TK_ENUM, TK_PACKAGE, TK_INTERFACE, TK_COMPONENT]

AUTO_WORDS := ["auto", "خودکار", "تلقائي"]

DYN_WORDS := ["dyn"]

DIRECTIVE_WORDS := ["mode", "title", "lang", "dir", "name", "version"]

SUBLIME_SYNTAX_TPL := `%YAML 1.2
---
# Generated by extensions/tools/gen_syntaxes.salam
name: Salam
scope: source.salam
version: 2

file_extensions:
  - salam

first_line_match: '^//!'

variables:
  ids: '%%IDS%%'
  idc: '%%IDC%%'
  ident: '[{{ids}}][{{idc}}]*'
  nbb: '(?<![{{idc}}])'
  nba: '(?![{{idc}}])'
  d: '[%%DIGIT%%]'
  dc: '%%DIGIT%%_'

contexts:
  main:
    - include: directives
    - include: comments
    - include: annotations
    - include: strings
    - include: numbers
    - include: definitions
    - include: keywords
    - include: layout-element
    - include: function-call
    - include: member
    - include: operators
    - include: punctuation

  directives:
    - match: '//!'
      scope: punctuation.definition.comment.salam
      push:
        - meta_scope: comment.line.directive.salam
        - match: '$\n?'
          pop: true
        - match: '\b(?:%%DIRECTIVES%%)\b'
          scope: keyword.other.directive.salam
        - match: '\|'
          scope: punctuation.separator.directive.salam

  comments:
    - match: '/\*'
      scope: punctuation.definition.comment.begin.salam
      push:
        - meta_scope: comment.block.salam
        - match: '\*/'
          scope: punctuation.definition.comment.end.salam
          pop: true
    - match: '//'
      scope: punctuation.definition.comment.salam
      push:
        - meta_scope: comment.line.double-slash.salam
        - match: '$\n?'
          pop: true

  annotations:
    - match: '(@)([A-Za-z_][{{idc}}]*)'
      captures:
        1: punctuation.definition.annotation.salam
        2: storage.modifier.annotation.salam

  strings:
    - match: '"""'
      scope: punctuation.definition.string.begin.salam
      push:
        - meta_scope: string.quoted.triple.salam
        - match: '"""'
          scope: punctuation.definition.string.end.salam
          pop: true
        - include: string-escapes
    - match: '"'
      scope: punctuation.definition.string.begin.salam
      push:
        - meta_scope: string.quoted.double.salam
        - match: '"'
          scope: punctuation.definition.string.end.salam
          pop: true
        - match: '\n'
          scope: invalid.illegal.newline.salam
          pop: true
        - include: string-escapes
    - match: '%%BT%%'
      scope: punctuation.definition.string.begin.salam
      push:
        - meta_scope: string.quoted.raw.salam
        - match: '%%BT%%'
          scope: punctuation.definition.string.end.salam
          pop: true
    - match: '{{nbb}}u?''(\\(?:x[0-9A-Fa-f]{2}|u\{[0-9A-Fa-f]+\}|u[0-9A-Fa-f]{4}|.)|[^''\\])'''
      scope: string.quoted.single.salam

  string-escapes:
    - match: '\\(?:x[0-9A-Fa-f]{2}|u\{[0-9A-Fa-f]+\}|u[0-9A-Fa-f]{4}|[0abfnrtv"''\\])'
      scope: constant.character.escape.salam
    - match: '\\.'
      scope: invalid.illegal.unknown-escape.salam

  numbers:
    - match: '{{nbb}}(?:{{d}}[{{dc}}]*\.{{d}}[{{dc}}]*(?:[eE][+-]?{{d}}[{{dc}}]*)?|{{d}}[{{dc}}]*[eE][+-]?{{d}}[{{dc}}]*)f?{{nba}}'
      scope: constant.numeric.float.salam
    - match: '{{nbb}}0[xX][0-9A-Fa-f][0-9A-Fa-f_]*{{nba}}'
      scope: constant.numeric.integer.hexadecimal.salam
    - match: '{{nbb}}0[bB][01][01_]*{{nba}}'
      scope: constant.numeric.integer.binary.salam
    - match: '{{nbb}}0[oO][0-7][0-7_]*{{nba}}'
      scope: constant.numeric.integer.octal.salam
    - match: '{{nbb}}{{d}}[{{dc}}]*f?{{nba}}'
      scope: constant.numeric.integer.decimal.salam

  definitions:
    - match: '({{nbb}}(?:%%FUNCDEF%%){{nba}})\s+({{ident}})'
      captures:
        1: storage.type.function.salam keyword.declaration.function.salam
        2: entity.name.function.salam
    - match: '({{nbb}}(?:%%TYPEDEF%%){{nba}})\s+({{ident}})'
      captures:
        1: storage.type.salam keyword.declaration.type.salam
        2: entity.name.type.salam

  keywords:
    - match: '{{nbb}}(?:%%CONTROL%%){{nba}}'
      scope: keyword.control.salam
    - match: '{{nbb}}(?:%%LOGICAL%%){{nba}}'
      scope: keyword.operator.word.salam
    - match: '{{nbb}}(?:%%STORAGE%%){{nba}}'
      scope: storage.type.salam
    - match: '{{nbb}}(?:%%IO%%){{nba}}'
      scope: support.function.builtin.salam
    - match: '{{nbb}}_{1,2}{{nba}}'
      scope: support.function.builtin.salam
    - match: '{{nbb}}(?:%%CONSTS%%){{nba}}'
      scope: constant.language.salam
    - match: '{{nbb}}(?:%%THIS%%){{nba}}'
      scope: variable.language.this.salam
    - match: '{{nbb}}(?:%%AUTO%%){{nba}}'
      scope: storage.type.auto.salam
    - match: '{{nbb}}(?:%%TYPES%%){{nba}}'
      scope: storage.type.primitive.salam
    - match: '{{nbb}}(?:%%INTRTYPES%%){{nba}}'
      scope: support.class.builtin.salam
    - match: '{{nbb}}(?:%%CONTEXTUAL%%){{nba}}'
      scope: keyword.other.salam

  layout-element:
    - match: '^\s*(?!(?:%%ALLKW%%){{nba}})({{ident}})\s*(:)\s*$'
      captures:
        1: entity.name.tag.layout.salam
        2: punctuation.section.block.begin.salam

  function-call:
    - match: '({{ident}})\s*(?=\()'
      scope: variable.function.salam

  member:
    - match: '(?<=\.)\s*(?:%%INTRMETHODS%%){{nba}}'
      scope: support.function.builtin.salam
    - match: '(?<=\.)\s*({{ident}})'
      scope: variable.other.member.salam

  operators:
    - match: '=>'
      scope: keyword.operator.arrow.salam
    - match: '\.\.\.'
      scope: keyword.operator.spread.salam
    - match: '==|!=|<=|>=|<|>'
      scope: keyword.operator.comparison.salam
    - match: '\^\^=|\+=|-=|\*=|/=|%='
      scope: keyword.operator.assignment.augmented.salam
    - match: '&&|\|\||!'
      scope: keyword.operator.logical.salam
    - match: ':='
      scope: keyword.operator.assignment.salam
    - match: '\^\^|[+\-*/%]'
      scope: keyword.operator.arithmetic.salam
    - match: '&'
      scope: keyword.operator.reference.salam
    - match: '='
      scope: keyword.operator.assignment.salam
    - match: '\?'
      scope: keyword.operator.ternary.salam

  punctuation:
    - match: ','
      scope: punctuation.separator.salam
    - match: ':'
      scope: punctuation.separator.salam
    - match: '\.'
      scope: punctuation.accessor.salam
    - match: '[()]'
      scope: punctuation.section.parens.salam
    - match: '[\[\]]'
      scope: punctuation.section.brackets.salam
    - match: '[{}]'
      scope: punctuation.section.braces.salam
`

SUBLIME_INDENT_TPL := `<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated by extensions/tools/gen_syntaxes.salam -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>name</key>
	<string>Indentation Rules</string>
	<key>scope</key>
	<string>source.salam</string>
	<key>settings</key>
	<dict>
				<key>increaseIndentPattern</key>
		<string>:\s*(//.*)?$</string>
				<key>decreaseIndentPattern</key>
		<string>^\s*(?:(?:%%END%%)\s*$|(?:%%ELSE%%)(?:\s|:))</string>
	</dict>
</dict>
</plist>
`

