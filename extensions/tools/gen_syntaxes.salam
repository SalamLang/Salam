NANO_TPL := `# Generated by extensions/tools/gen_syntaxes.salam

syntax salam "\.salam$"
comment "//"

formatter salam format
linter salam inspect --emit-symbol --xml-out=/dev/null --error-style=gcc --log-level=error

color brightblue "\<(%%N_CONTROL%%)\>"
color blue "\<(%%N_STORAGE%%)\>"
color cyan "\<(%%N_TYPES%%)\>"
color brightcyan "\<(%%N_INTRTYPES%%)\>"
color brightmagenta "\<(%%N_IO%%)\>"
color brightred "\<(%%N_CONSTS%%)\>"
color brightred "\<(%%N_THIS%%)\>"
color blue "\<(%%N_CONTEXTUAL%%)\>"
color brightblue "\<(%%N_LOGICAL%%)\>"

color yellow "\<[%%N_DIGIT%%][%%N_DIGIT%%_]*(\.[%%N_DIGIT%%][%%N_DIGIT%%_]*)?([eE][+-]?[%%N_DIGIT%%]+)?f?\>"
color yellow "\<0[xX][0-9A-Fa-f][0-9A-Fa-f_]*\>"
color yellow "\<0[bB][01][01_]*\>"
color yellow "\<0[oO][0-7][0-7_]*\>"

color brightyellow "@[A-Za-z_][A-Za-z0-9_]*"

color green ""(\\.|[^"\\])*""
color green "%%BT%%[^%%BT%%]*%%BT%%"
color green "'(\\.|[^'\\])'"

color brightblack "//.*"
color brightblack start="/\*" end="\*/"
color brightwhite,blue "TODO|FIXME|XXX|HACK|NOTE"

color ,red "[[:space:]]+$"
`

MICRO_TPL := `# Generated by extensions/tools/gen_syntaxes.salam
---
filetype: salam

detect:
  filename: "\\.salam$"

rules:
  - preproc: '^[[:space:]]*//!.*$'

  - constant.number: "\\b[0-9][0-9_]*(\\.[0-9][0-9_]*)?([eE][+-]?[0-9]+)?f?"
  - constant.number: "\\b0[xX][0-9A-Fa-f][0-9A-Fa-f_]*"
  - constant.number: "\\b0[bB][01][01_]*"
  - constant.number: "\\b0[oO][0-7][0-7_]*"
  - constant.number: '[%%M_NONASCII_DIGIT%%][%%M_NONASCII_DIGIT%%_]*(\.[%%M_NONASCII_DIGIT%%][%%M_NONASCII_DIGIT%%_]*)?'

%%M_KEYWORD_RULES%%
  - preproc: '@[A-Za-z_][A-Za-z0-9_]*'
  - symbol.operator: '[-+*/%=<>!&|^?]'
  - symbol.brackets: "[(){}\\[\\]]"

  - constant.string:
      start: '"'
      end: '"'
      skip: "\\\\."
      rules:
        - constant.specialChar: "\\\\."

  - constant.string:
      start: '%%BT%%'
      end: '%%BT%%'
      rules: []

  - constant.string:
      start: "'"
      end: "'"
      skip: "\\\\."
      rules:
        - constant.specialChar: "\\\\."

  - comment:
      start: '//'
      end: '$'
      rules:
        - todo: '(TODO|FIXME|XXX|HACK|NOTE):?'

  - comment:
      start: "/\\*"
      end: "\\*/"
      rules:
        - todo: '(TODO|FIXME|XXX|HACK|NOTE):?'
`

VSCODE_TPL := `{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Salam",
  "scopeName": "source.salam",
  "_generatedBy": "extensions/tools/gen_syntaxes.salam",
  "patterns": [
    { "include": "#directives" },
    { "include": "#comments" },
    { "include": "#meta-annotations" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#definitions" },
    { "include": "#keywords" },
    { "include": "#layout-element" },
    { "include": "#function-call" },
    { "include": "#member" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "directives": {
      "patterns": [
        {
          "name": "comment.line.directive.salam",
          "begin": "//!",
          "beginCaptures": { "0": { "name": "punctuation.definition.comment.salam" } },
          "end": "$",
          "patterns": [
            { "match": "\\b(%%DIRECTIVES%%)\\b", "name": "keyword.other.directive.salam" },
            { "match": "\\|", "name": "punctuation.separator.directive.salam" }
          ]
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.block.salam",
          "begin": "/\\*",
          "beginCaptures": { "0": { "name": "punctuation.definition.comment.salam" } },
          "end": "\\*/",
          "endCaptures": { "0": { "name": "punctuation.definition.comment.salam" } }
        },
        {
          "name": "comment.line.double-slash.salam",
          "begin": "//",
          "beginCaptures": { "0": { "name": "punctuation.definition.comment.salam" } },
          "end": "$"
        }
      ]
    },
    "meta-annotations": {
      "patterns": [
        {
          "match": "(@)([A-Za-z_][%%IDC%%]*)",
          "captures": {
            "1": { "name": "punctuation.definition.annotation.salam" },
            "2": { "name": "storage.modifier.annotation.salam" }
          }
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.salam",
          "begin": "%%TQ%%",
          "end": "%%TQ%%",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.salam" } },
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.salam" } },
          "patterns": [{ "include": "#string-escapes" }]
        },
        {
          "name": "string.quoted.double.salam",
          "begin": "\"",
          "end": "\"",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.salam" } },
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.salam" } },
          "patterns": [
            { "include": "#string-escapes" },
            { "name": "invalid.illegal.newline.salam", "match": "\\n" }
          ]
        },
        {
          "name": "string.quoted.raw.salam",
          "begin": "%%BT%%",
          "end": "%%BT%%",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.salam" } },
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.salam" } }
        },
        {
          "name": "string.quoted.single.salam",
          "match": "%%NBB%%u?'(\\\\(?:x[0-9A-Fa-f]{2}|u\\{[0-9A-Fa-f]+\\}|u[0-9A-Fa-f]{4}|.)|[^'\\\\])'"
        }
      ]
    },
    "string-escapes": {
      "patterns": [
        {
          "name": "constant.character.escape.salam",
          "match": "\\\\(?:x[0-9A-Fa-f]{2}|u\\{[0-9A-Fa-f]+\\}|u[0-9A-Fa-f]{4}|[0abfnrtv\"'\\\\])"
        },
        { "name": "invalid.illegal.unknown-escape.salam", "match": "\\\\." }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.salam",
          "match": "%%NBB%%(?:[%%DIGIT%%][%%DIGIT%%_]*\\.[%%DIGIT%%][%%DIGIT%%_]*(?:[eE][+-]?[%%DIGIT%%][%%DIGIT%%_]*)?|[%%DIGIT%%][%%DIGIT%%_]*[eE][+-]?[%%DIGIT%%][%%DIGIT%%_]*)f?%%NBA%%"
        },
        { "name": "constant.numeric.hex.salam", "match": "%%NBB%%0[xX][0-9A-Fa-f][0-9A-Fa-f_]*%%NBA%%" },
        { "name": "constant.numeric.binary.salam", "match": "%%NBB%%0[bB][01][01_]*%%NBA%%" },
        { "name": "constant.numeric.octal.salam", "match": "%%NBB%%0[oO][0-7][0-7_]*%%NBA%%" },
        { "name": "constant.numeric.integer.salam", "match": "%%NBB%%[%%DIGIT%%][%%DIGIT%%_]*f?%%NBA%%" }
      ]
    },
    "definitions": {
      "patterns": [
        {
          "match": "(%%NBB%%(?:%%FUNCDEF%%)%%NBA%%)\\s+(%%IDENT%%)",
          "captures": {
            "1": { "name": "storage.type.function.salam keyword.declaration.function.salam" },
            "2": { "name": "entity.name.function.salam" }
          }
        },
        {
          "match": "(%%NBB%%(?:%%TYPEDEF%%)%%NBA%%)\\s+(%%IDENT%%)",
          "captures": {
            "1": { "name": "storage.type.salam keyword.declaration.type.salam" },
            "2": { "name": "entity.name.type.salam" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.control.salam", "match": "%%NBB%%(?:%%CONTROL%%)%%NBA%%" },
        { "name": "keyword.operator.logical.salam", "match": "%%NBB%%(?:%%LOGICAL%%)%%NBA%%" },
        { "name": "storage.type.salam", "match": "%%NBB%%(?:%%STORAGE%%)%%NBA%%" },
        { "name": "support.function.builtin.salam", "match": "%%NBB%%(?:%%IO%%)%%NBA%%" },
        { "name": "support.function.builtin.print.salam", "match": "%%NBB%%_{1,2}%%NBA%%" },
        { "name": "constant.language.salam", "match": "%%NBB%%(?:%%CONSTS%%)%%NBA%%" },
        { "name": "variable.language.this.salam", "match": "%%NBB%%(?:%%THIS%%)%%NBA%%" },
        { "name": "storage.type.auto.salam", "match": "%%NBB%%(?:%%AUTO%%)%%NBA%%" },
        { "name": "support.type.primitive.salam", "match": "%%NBB%%(?:%%TYPES%%)%%NBA%%" },
        { "name": "support.class.builtin.salam", "match": "%%NBB%%(?:%%INTRTYPES%%)%%NBA%%" },
        { "name": "keyword.other.salam", "match": "%%NBB%%(?:%%CONTEXTUAL%%)%%NBA%%" }
      ]
    },
    "layout-element": {
      "patterns": [
        {
          "match": "^\\s*(?!(?:%%ALLKW%%)%%NBA%%)(%%IDENT%%)\\s*(:)\\s*$",
          "captures": {
            "1": { "name": "entity.name.tag.layout.salam" },
            "2": { "name": "punctuation.section.layout.salam" }
          }
        }
      ]
    },
    "function-call": {
      "patterns": [
        { "match": "(%%IDENT%%)\\s*(?=\\()", "name": "entity.name.function.call.salam" }
      ]
    },
    "member": {
      "patterns": [
        { "match": "(?<=\\.)\\s*(?:%%INTRMETHODS%%)%%NBA%%", "name": "support.function.builtin.salam" },
        { "match": "(?<=\\.)\\s*(%%IDENT%%)", "name": "variable.other.member.salam" }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.arrow.salam", "match": "=>" },
        { "name": "keyword.operator.spread.salam", "match": "\\.\\.\\." },
        { "name": "keyword.operator.comparison.salam", "match": "==|!=|<=|>=|<|>" },
        { "name": "keyword.operator.assignment.compound.salam", "match": "\\^\\^=|\\+=|-=|\\*=|/=|%=" },
        { "name": "keyword.operator.logical.salam", "match": "&&|\\|\\||!" },
        { "name": "keyword.operator.arithmetic.salam", "match": "\\^\\^|[+\\-*/%]" },
        { "name": "keyword.operator.reference.salam", "match": "&" },
        { "name": "keyword.operator.assignment.salam", "match": "=" },
        { "name": "keyword.operator.ternary.salam", "match": "\\?" }
      ]
    },
    "punctuation": {
      "patterns": [
        { "name": "punctuation.separator.salam", "match": "[,:]" },
        { "name": "punctuation.accessor.salam", "match": "\\." },
        { "name": "meta.brace.round.salam", "match": "[()]" },
        { "name": "meta.brace.square.salam", "match": "[\\[\\]]" },
        { "name": "meta.brace.curly.salam", "match": "[{}]" }
      ]
    }
  }
}
`

GEANY_TPL := `# Generated by extensions/tools/gen_syntaxes.salam

[styling=C]

[keywords]
primary=%%G_PRIMARY%%
secondary=%%G_SECONDARY%%
docComment=TODO FIXME XXX HACK NOTE

[lexer_properties=C]

[settings]
lexer_filetype=C
extension=salam
comment_single=//
comment_open=/*
comment_close=*/
comment_use_indent=true
tag_parser=C
mime_type=text/x-salam

[indentation]
width=4
type=0

[build_settings]
error_regex=([^:]+):([0-9]+):([0-9]+): (?:error|warning):
FT_00_LB=_Compile
FT_00_CM=salam build "%f" --error-style=gcc
FT_00_WD=
FT_01_LB=_Check
FT_01_CM=salam inspect "%f" --emit-symbol --xml-out=/dev/null --error-style=gcc --log-level=error
FT_01_WD=
FT_02_LB=_Format
FT_02_CM=salam format "%f" --error-style=gcc
FT_02_WD=
EX_00_LB=_Execute
EX_00_CM=salam exec "%f" --error-style=gcc
EX_00_WD=
`

struct Lex:
    pub control: Vector<str> = Vector {}
    pub storage: Vector<str> = Vector {}
    pub consts: Vector<str> = Vector {}
    pub receiver: Vector<str> = Vector {}
    pub io: Vector<str> = Vector {}
    pub logical: Vector<str> = Vector {}
    pub contextual: Vector<str> = Vector {}
    pub autos: Vector<str> = Vector {}
    pub types: Vector<str> = Vector {}
    pub intrTypes: Vector<str> = Vector {}
    pub intrMethods: Vector<str> = Vector {}
    pub funcDef: Vector<str> = Vector {}
    pub typeDef: Vector<str> = Vector {}
    pub endWords: Vector<str> = Vector {}
    pub elseWords: Vector<str> = Vector {}
    pub conditional: Vector<str> = Vector {}
    pub loops: Vector<str> = Vector {}
    pub statement: Vector<str> = Vector {}
    pub structure: Vector<str> = Vector {}
    pub storageClass: Vector<str> = Vector {}
    pub includes: Vector<str> = Vector {}
    pub keywords: Vector<str> = Vector {}
    pub booleans: Vector<str> = Vector {}
    pub nulls: Vector<str> = Vector {}
    pub blockOpen: Vector<str> = Vector {}
end

struct Snippet:
    pub name: str = ""
    pub prefix: str = ""
    pub body: str = ""
    pub desc: str = ""
end

func is_ident_byte(c: char): bool:
    if c >= 'a' && c <= 'z': ret true end
    if c >= 'A' && c <= 'Z': ret true end
    if c >= '0' && c <= '9': ret true end
    ret c == '_'
end

func find_from(s: str, sub: str, start: int): int:
    if start >= s.len(): ret 0 - 1 end
    rest := s.substr(start, s.len() - start)
    k := rest.find(sub)
    if k < 0: ret 0 - 1 end
    ret start + k
end

func strip_comments(src: str): str:
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    n := src.len()
    mut i := 0
    mut inStr := false
    until i < n:
        c := src[i]
        if inStr:
            str.BufAppendChar(sb, c as i32)
            if c == '\\' && i + 1 < n:
                str.BufAppendChar(sb, src[i + 1] as i32)
                i += 2
                continue
            end
            if c == '"': inStr = false end
            i += 1
            continue
        end
        if c == '"':
            inStr = true
            str.BufAppendChar(sb, c as i32)
            i += 1
            continue
        end
        if c == '/' && i + 1 < n && src[i + 1] == '/':
            until i < n && src[i] != '\n':
                i += 1
            end
            continue
        end
        str.BufAppendChar(sb, c as i32)
        i += 1
    end
    ret str.BufStr(sb)
end

func array_body(clean: str, name: str): str:
    n := clean.len()
    mut from := 0
    until from < n:
        p := find_from(clean, name, from)
        if p < 0: ret "" end
        from = p + 1
        after := p + name.len()
        if p > 0 && is_ident_byte(clean[p - 1]): continue end
        if after < n && is_ident_byte(clean[after]): continue end

        mut i := after
        until i < n && (clean[i] == ' ' || clean[i] == '\t'): i += 1 end
        if i + 1 < n && clean[i] == ':' && clean[i + 1] == '=':
            i += 2
        else i < n && clean[i] == '=':
            i += 1
        else:
            continue
        end
        until i < n && (clean[i] == ' ' || clean[i] == '\t' || clean[i] == '\n'): i += 1 end
        if i >= n || clean[i] != '[': continue end

        start := i + 1
        mut depth := 1
        mut j := start
        until j < n && depth > 0:
            c := clean[j]
            if c == '"':
                j += 1
                until j < n && clean[j] != '"':
                    if clean[j] == '\\': j += 1 end
                    j += 1
                end
                j += 1
                continue
            end
            if c == '[': depth += 1 end
            if c == ']': depth -= 1 end
            j += 1
        end
        if depth != 0: ret "" end
        ret clean.substr(start, j - 1 - start)
    end
    ret ""
end

func parse_strings(body: str): Vector<str>:
    mut out := Vector {} as Vector<str>
    n := body.len()
    mut i := 0
    until i < n:
        if body[i] != '"':
            i += 1
            continue
        end
        mut sb := str.NewBuilder()
        i += 1
        until i < n && body[i] != '"':
            if body[i] == '\\' && i + 1 < n:
                str.BufAppendChar(sb, body[i + 1] as i32)
                i += 2
                continue
            end
            str.BufAppendChar(sb, body[i] as i32)
            i += 1
        end
        i += 1
        out.push(str.BufStr(sb))
        str.BufFree(sb)
    end
    ret out
end

func parse_ints(body: str): Vector<int>:
    mut out := Vector {} as Vector<int>
    n := body.len()
    mut i := 0
    until i < n:
        c := body[i]
        if c < '0' || c > '9':
            i += 1
            continue
        end
        mut v := 0
        until i < n && body[i] >= '0' && body[i] <= '9':
            v = v * 10 + ((body[i] as i32) - 48)
            i += 1
        end
        out.push(v)
    end
    ret out
end

func read_strings(clean: str, name: str): Vector<str>:
    body := array_body(clean, name)
    if body == "":
        printerrln "gen_syntaxes: array '" + name + "' not found"
        os.Exit(1)
    end
    ret parse_strings(body)
end

func read_ints(clean: str, name: str): Vector<int>:
    body := array_body(clean, name)
    if body == "":
        printerrln "gen_syntaxes: array '" + name + "' not found"
        os.Exit(1)
    end
    ret parse_ints(body)
end

func contains_str(v: Vector<str>, s: str): bool:
    repeat v.len() with i:
        if v.get(i) == s:
            ret true
        end
    end
    ret false
end

func push_unique(v &: Vector<str>, s: str):
    if s == "":
        ret
    end
    if contains_str(v, s):
        ret
    end
    v.push(s)
end

func words_for_kinds(spells: Vector<str>, kinds: Vector<int>, want: int[:], out &: Vector<str>):
    n := spells.len()
    if kinds.len() < n:
        printerrln "gen_syntaxes: keyword spelling/kind tables disagree in length"
        os.Exit(1)
    end
    repeat n with i:
        k := kinds.get(i)
        mut hit := false
        repeat len(want) with w:
            if want[w] == k:
                hit = true
            end
        end
        if hit:
            push_unique(out, spells.get(i))
        end
    end
end

func push_all(src: Vector<str>, out &: Vector<str>):
    repeat src.len() with i:
        push_unique(out, src.get(i))
    end
end

func push_arr(src: str[:], out &: Vector<str>):
    repeat len(src) with i:
        push_unique(out, src[i])
    end
end

func read_source(path: str): str:
    text := os.ReadFile(path)
    if text == "":
        printerrln "gen_syntaxes: cannot read " + path + " (run me from the repository root)"
        os.Exit(1)
    end
    ret strip_comments(text)
end

func collect(spellEn: Vector<str>, kindEn: Vector<int>, spellFa: Vector<str>, kindFa: Vector<int>, want: int[:]): Vector<str>:
    mut v := Vector {} as Vector<str>
    words_for_kinds(spellEn, kindEn, want, v)
    words_for_kinds(spellFa, kindFa, want, v)
    ret v
end

func build_lex(): Lex:
    lp := read_source(LANGPACK_SRC)
    sm := read_source(SEMANTIC_SRC)

    spellEn := read_strings(lp, "k_kw_spell_en")
    kindEn := read_ints(lp, "k_kw_kind_en")
    spellFa := read_strings(lp, "k_kw_spell_fa")
    kindFa := read_ints(lp, "k_kw_kind_fa")

    mut control := Vector {} as Vector<str>
    words_for_kinds(spellEn, kindEn, CONTROL_KINDS[:], control)
    words_for_kinds(spellFa, kindFa, CONTROL_KINDS[:], control)

    mut storage := Vector {} as Vector<str>
    words_for_kinds(spellEn, kindEn, STORAGE_KINDS[:], storage)
    words_for_kinds(spellFa, kindFa, STORAGE_KINDS[:], storage)

    mut consts := Vector {} as Vector<str>
    words_for_kinds(spellEn, kindEn, CONST_KINDS[:], consts)
    words_for_kinds(spellFa, kindFa, CONST_KINDS[:], consts)

    mut receiver := Vector {} as Vector<str>
    words_for_kinds(spellEn, kindEn, THIS_KINDS[:], receiver)
    words_for_kinds(spellFa, kindFa, THIS_KINDS[:], receiver)

    mut io := Vector {} as Vector<str>
    words_for_kinds(spellEn, kindEn, IO_KINDS[:], io)
    words_for_kinds(spellFa, kindFa, IO_KINDS[:], io)

    mut logical := Vector {} as Vector<str>
    words_for_kinds(spellEn, kindEn, LOGICAL_KINDS[:], logical)
    words_for_kinds(spellFa, kindFa, LOGICAL_KINDS[:], logical)

    mut funcDef := Vector {} as Vector<str>
    words_for_kinds(spellEn, kindEn, FUNC_DEF_KINDS[:], funcDef)
    words_for_kinds(spellFa, kindFa, FUNC_DEF_KINDS[:], funcDef)

    mut typeDef := Vector {} as Vector<str>
    words_for_kinds(spellEn, kindEn, TYPE_DEF_KINDS[:], typeDef)
    words_for_kinds(spellFa, kindFa, TYPE_DEF_KINDS[:], typeDef)

    mut endWords := Vector {} as Vector<str>
    words_for_kinds(spellEn, kindEn, END_KINDS[:], endWords)
    words_for_kinds(spellFa, kindFa, END_KINDS[:], endWords)

    mut elseWords := Vector {} as Vector<str>
    words_for_kinds(spellEn, kindEn, ELSE_KINDS[:], elseWords)
    words_for_kinds(spellFa, kindFa, ELSE_KINDS[:], elseWords)

    mut contextual := Vector {} as Vector<str>
    push_all(read_strings(lp, "k_ctx_canon_fa"), contextual)
    push_all(read_strings(lp, "k_ctx_spell_fa"), contextual)
    push_arr(DYN_WORDS[:], contextual)

    mut autos := Vector {} as Vector<str>
    push_arr(AUTO_WORDS[:], autos)

    mut types := Vector {} as Vector<str>
    push_all(read_strings(sm, "k_sm_prim_names"), types)

    mut intrTypes := Vector {} as Vector<str>
    push_all(read_strings(sm, "k_sm_intr_types"), intrTypes)

    mut intrMethods := Vector {} as Vector<str>
    push_all(read_strings(sm, "k_sm_intr_methods"), intrMethods)

    mut out := Lex {}
    out.control = control
    out.storage = storage
    out.consts = consts
    out.receiver = receiver
    out.io = io
    out.logical = logical
    out.contextual = contextual
    out.autos = autos
    out.types = types
    out.intrTypes = intrTypes
    out.intrMethods = intrMethods
    out.funcDef = funcDef
    out.typeDef = typeDef
    out.endWords = endWords
    out.elseWords = elseWords
    out.conditional = collect(spellEn, kindEn, spellFa, kindFa, CONDITIONAL_KINDS[:])
    out.loops = collect(spellEn, kindEn, spellFa, kindFa, LOOP_KINDS[:])
    out.statement = collect(spellEn, kindEn, spellFa, kindFa, STATEMENT_KINDS[:])
    out.structure = collect(spellEn, kindEn, spellFa, kindFa, STRUCTURE_KINDS[:])
    out.storageClass = collect(spellEn, kindEn, spellFa, kindFa, STORAGECLASS_KINDS[:])
    out.includes = collect(spellEn, kindEn, spellFa, kindFa, INCLUDE_KINDS[:])
    out.keywords = collect(spellEn, kindEn, spellFa, kindFa, KEYWORD_KINDS[:])
    out.booleans = collect(spellEn, kindEn, spellFa, kindFa, BOOLEAN_KINDS[:])
    out.nulls = collect(spellEn, kindEn, spellFa, kindFa, NULL_KINDS[:])
    out.blockOpen = collect(spellEn, kindEn, spellFa, kindFa, BLOCK_OPEN_KINDS[:])
    ret out
end

func sorted_desc(words: Vector<str>): Vector<str>:
    mut sorted := Vector {} as Vector<str>
    repeat words.len() with i:
        sorted.push(words.get(i))
    end
    sort.StableSortBy(sorted, (a: str, b: str) => str.CharCount(a) > str.CharCount(b))
    ret sorted
end

func alt(words: Vector<str>): str:
    ret str.Join(sorted_desc(words), "|")
end

func onig_nbb(): str:
    ret "(?<![" + ONIG_IDC + "])"
end

func onig_nba(): str:
    ret "(?![" + ONIG_IDC + "])"
end

func alt_arr(words: str[:]): str:
    mut v := Vector {} as Vector<str>
    repeat len(words) with i:
        v.push(words[i])
    end
    ret alt(v)
end

func single_words(words: Vector<str>): Vector<str>:
    mut v := Vector {} as Vector<str>
    repeat words.len() with i:
        w := words.get(i)
        if w.find(" ") < 0:
            v.push(w)
        end
    end
    ret v
end

func all_keywords(lx: Lex): Vector<str>:
    mut v := Vector {} as Vector<str>
    push_all(lx.control, v)
    push_all(lx.storage, v)
    push_all(lx.consts, v)
    push_all(lx.receiver, v)
    push_all(lx.io, v)
    push_all(lx.logical, v)
    ret v
end

func parent_dir(path: str): str:
    mut cut := 0 - 1
    repeat path.len() with i:
        if path[i] == '/':
            cut = i
        end
    end
    if cut <= 0:
        ret ""
    end
    ret path.substr(0, cut)
end

func write_out(path: str, body: str):
    d := parent_dir(path)
    if d != "":
        os.MkdirAll(d)
    end
    if os.WriteFile(path, body) < 0:
        printerrln "gen_syntaxes: cannot write " + path
        os.Exit(1)
    end
    println "  " + path
end

func emit_sublime_syntax(lx: Lex): str:
    mut s := SUBLIME_SYNTAX_TPL
    s = str.Replace(s, "%%BT%%", "\x60")
    s = str.Replace(s, "%%IDS%%", ONIG_IDS)
    s = str.Replace(s, "%%IDC%%", ONIG_IDC)
    s = str.Replace(s, "%%DIGIT%%", ONIG_DIGIT)
    s = str.Replace(s, "%%DIRECTIVES%%", alt_arr(DIRECTIVE_WORDS[:]))
    s = str.Replace(s, "%%FUNCDEF%%", alt(lx.funcDef))
    s = str.Replace(s, "%%TYPEDEF%%", alt(lx.typeDef))
    s = str.Replace(s, "%%CONTROL%%", alt(lx.control))
    s = str.Replace(s, "%%LOGICAL%%", alt(lx.logical))
    s = str.Replace(s, "%%STORAGE%%", alt(lx.storage))
    s = str.Replace(s, "%%IO%%", alt(lx.io))
    s = str.Replace(s, "%%CONSTS%%", alt(lx.consts))
    s = str.Replace(s, "%%THIS%%", alt(lx.receiver))
    s = str.Replace(s, "%%AUTO%%", alt(lx.autos))
    s = str.Replace(s, "%%TYPES%%", alt(lx.types))
    s = str.Replace(s, "%%INTRTYPES%%", alt(lx.intrTypes))
    s = str.Replace(s, "%%INTRMETHODS%%", alt(lx.intrMethods))
    s = str.Replace(s, "%%CONTEXTUAL%%", alt(lx.contextual))
    s = str.Replace(s, "%%ALLKW%%", alt(all_keywords(lx)))
    ret s
end

func emit_sublime_indent(lx: Lex): str:
    mut s := SUBLIME_INDENT_TPL
    s = str.Replace(s, "%%END%%", alt(lx.endWords))
    s = str.Replace(s, "%%ELSE%%", alt(lx.elseWords))
    ret s
end

func hex_val(c: char): int:
    if c >= '0' && c <= '9':
        ret (c as i32) - 48
    end
    if c >= 'a' && c <= 'f':
        ret (c as i32) - 87
    end
    if c >= 'A' && c <= 'F':
        ret (c as i32) - 55
    end
    ret 0
end

func json_strings(arrayJson: str): Vector<str>:
    mut out := Vector {} as Vector<str>
    n := arrayJson.len()
    mut i := 0
    until i < n:
        if arrayJson[i] != '"':
            i += 1
            continue
        end
        mut sb := str.NewBuilder()
        i += 1
        until i < n && arrayJson[i] != '"':
            if arrayJson[i] != '\\':
                str.BufAppendChar(sb, arrayJson[i] as i32)
                i += 1
                continue
            end
            if i + 1 >= n:
                break
            end
            e := arrayJson[i + 1]
            i += 2
            if e == 'n':
                str.BufAppendChar(sb, 10)
            else e == 't':
                str.BufAppendChar(sb, 9)
            else e == 'r':
                str.BufAppendChar(sb, 13)
            else e == 'b':
                str.BufAppendChar(sb, 8)
            else e == 'f':
                str.BufAppendChar(sb, 12)
            else e == 'u':
                mut cp := 0
                repeat 4 with k:
                    if i + k < n:
                        cp = cp * 16 + hex_val(arrayJson[i + k])
                    end
                end
                i += 4
                str.BufAppendCp(sb, cp)
            else:
                str.BufAppendChar(sb, e as i32)
            end
        end
        i += 1
        out.push(str.BufStr(sb))
        str.BufFree(sb)
    end
    ret out
end

func read_snippets(): Vector<Snippet>:
    text := os.ReadFile(SNIPPETS_SRC)
    if text == "":
        printerrln "gen_syntaxes: cannot read " + SNIPPETS_SRC
        os.Exit(1)
    end
    names := json.Keys(text)
    mut out := Vector {} as Vector<Snippet>
    repeat names.len() with i:
        name := names.get(i)
        obj := json.Get(text, name)
        lines := json_strings(json.Get(obj, "body"))
        mut s := Snippet {}
        s.name = name
        s.prefix = json.Get(obj, "prefix")
        s.desc = json.Get(obj, "description")
        s.body = str.Join(lines, "\n")
        if s.prefix == "":
            printerrln "gen_syntaxes: snippet '" + name + "' has no prefix"
            os.Exit(1)
        end
        out.push(s)
    end
    ret out
end

func emit_sublime_completions(snips: Vector<Snippet>): str:
    mut items := Vector {} as Vector<str>
    repeat snips.len() with i:
        s := snips.get(i)
        trigger := s.prefix + "\t" + s.desc
        items.push("    {\"trigger\": \"" + json.Escape(trigger) + "\", \"contents\": \"" + json.Escape(s.body) + "\"}")
    end
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    str.BufAppend(sb, "// Generated by extensions/tools/gen_syntaxes.salam\n")
    str.BufAppend(sb, "{\n")
    str.BufAppend(sb, "  \"scope\": \"source.salam - comment - string\",\n")
    str.BufAppend(sb, "  \"completions\": [\n")
    str.BufAppend(sb, str.Join(items, ",\n"))
    str.BufAppend(sb, "\n  ]\n}\n")
    ret str.BufStr(sb)
end

func emit_ultisnips(snips: Vector<Snippet>): str:
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    str.BufAppend(sb, "# Generated by extensions/tools/gen_syntaxes.salam\n")
    repeat snips.len() with i:
        s := snips.get(i)
        str.BufAppend(sb, "\nsnippet " + s.prefix + " \"" + s.desc + "\" b\n")
        str.BufAppend(sb, s.body)
        str.BufAppend(sb, "\nendsnippet\n")
    end
    ret str.BufStr(sb)
end

func emit_yasnippet(s: Snippet): str:
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    str.BufAppend(sb, "# -*- mode: snippet -*-\n")
    str.BufAppend(sb, "# name: " + s.name + "\n")
    str.BufAppend(sb, "# key: " + s.prefix + "\n")
    str.BufAppend(sb, "# --\n")
    str.BufAppend(sb, s.body)
    str.BufAppend(sb, "\n")
    ret str.BufStr(sb)
end

func vim_alt(words: Vector<str>): str:
    mut sorted := Vector {} as Vector<str>
    repeat words.len() with i:
        sorted.push(words.get(i))
    end
    sort.StableSortBy(sorted, (a: str, b: str) => str.CharCount(a) > str.CharCount(b))
    ret str.Join(sorted, "\\|")
end

func vim_alt_arr(words: str[:]): str:
    mut v := Vector {} as Vector<str>
    repeat len(words) with i:
        v.push(words[i])
    end
    ret vim_alt(v)
end

func has_joiner(w: str): bool:
    n := w.len()
    mut i := 0
    until i + 2 < n:
        if (w[i] as i32) == 226 && (w[i + 1] as i32) == 128:
            c := w[i + 2] as i32
            if c == 140 || c == 141:
                ret true
            end
        end
        i += 1
    end
    ret false
end

func plain_words(words: Vector<str>): Vector<str>:
    mut v := Vector {} as Vector<str>
    repeat words.len() with i:
        if !has_joiner(words.get(i)):
            v.push(words.get(i))
        end
    end
    ret v
end

func joined_words(words: Vector<str>): Vector<str>:
    mut v := Vector {} as Vector<str>
    repeat words.len() with i:
        if has_joiner(words.get(i)):
            v.push(words.get(i))
        end
    end
    ret v
end

func vim_joined_rule(group: str, words: Vector<str>): str:
    j := joined_words(words)
    if j.len() == 0:
        ret ""
    end
    ret "syn match " + group + " \"\\<\\%(" + vim_alt(j) + "\\)\\>\"\n"
end

func vim_words(words: Vector<str>): str:
    ret str.Join(words, " ")
end

func emit_vim_syntax(lx: Lex): str:
    mut s := VIM_SYNTAX_TPL
    s = str.Replace(s, "%%BT%%", "\x60")
    mut joined := str.NewBuilder()
    defer str.BufFree(joined)
    str.BufAppend(joined, vim_joined_rule("salamConditional", lx.conditional))
    str.BufAppend(joined, vim_joined_rule("salamRepeat", lx.loops))
    str.BufAppend(joined, vim_joined_rule("salamStatement", lx.statement))
    str.BufAppend(joined, vim_joined_rule("salamStorageClass", lx.storageClass))
    str.BufAppend(joined, vim_joined_rule("salamKeyword", lx.keywords))
    str.BufAppend(joined, vim_joined_rule("salamFuncDecl", lx.funcDef))
    str.BufAppend(joined, vim_joined_rule("salamStructure", lx.structure))
    str.BufAppend(joined, vim_joined_rule("salamInclude", lx.includes))
    str.BufAppend(joined, vim_joined_rule("salamBoolean", lx.booleans))
    str.BufAppend(joined, vim_joined_rule("salamNull", lx.nulls))
    str.BufAppend(joined, vim_joined_rule("salamThis", lx.receiver))
    str.BufAppend(joined, vim_joined_rule("salamType", lx.types))
    str.BufAppend(joined, vim_joined_rule("salamType", lx.autos))
    str.BufAppend(joined, vim_joined_rule("salamBuiltinType", lx.intrTypes))
    str.BufAppend(joined, vim_joined_rule("salamBuiltin", lx.io))
    str.BufAppend(joined, vim_joined_rule("salamOperatorWord", lx.logical))
    str.BufAppend(joined, vim_joined_rule("salamContextual", lx.contextual))
    s = str.Replace(s, "%%JOINED%%", str.TrimRight(str.BufStr(joined)))
    s = str.Replace(s, "%%ISKEYWORD%%", VIM_ISKEYWORD)
    s = str.Replace(s, "%%DIGIT%%", VIM_DIGIT)
    s = str.Replace(s, "%%CONDITIONAL%%", vim_words(plain_words(lx.conditional)))
    s = str.Replace(s, "%%LOOP%%", vim_words(plain_words(lx.loops)))
    s = str.Replace(s, "%%STATEMENT%%", vim_words(plain_words(lx.statement)))
    s = str.Replace(s, "%%STORAGECLASS%%", vim_words(plain_words(lx.storageClass)))
    s = str.Replace(s, "%%STRUCTURE%%", vim_words(plain_words(lx.structure)))
    s = str.Replace(s, "%%INCLUDE%%", vim_words(plain_words(lx.includes)))
    s = str.Replace(s, "%%KEYWORD%%", vim_words(plain_words(lx.keywords)))
    s = str.Replace(s, "%%FUNCDEF%%", vim_words(plain_words(lx.funcDef)))
    s = str.Replace(s, "%%BOOLEAN%%", vim_words(plain_words(lx.booleans)))
    s = str.Replace(s, "%%NULL%%", vim_words(plain_words(lx.nulls)))
    s = str.Replace(s, "%%THIS%%", vim_words(plain_words(lx.receiver)))
    s = str.Replace(s, "%%TYPES%%", vim_words(plain_words(lx.types)))
    s = str.Replace(s, "%%AUTO%%", vim_words(plain_words(lx.autos)))
    s = str.Replace(s, "%%INTRTYPES%%", vim_words(plain_words(lx.intrTypes)))
    s = str.Replace(s, "%%IO%%", vim_words(plain_words(lx.io)))
    s = str.Replace(s, "%%LOGICAL%%", vim_words(plain_words(lx.logical)))
    s = str.Replace(s, "%%CONTEXTUAL%%", vim_words(plain_words(lx.contextual)))
    s = str.Replace(s, "%%DIRECTIVES%%", vim_alt_arr(DIRECTIVE_WORDS[:]))
    s = str.Replace(s, "%%INTRMETHODS%%", vim_alt(lx.intrMethods))
    s = str.Replace(s, "%%ALLKW%%", vim_alt(all_keywords(lx)))
    ret s
end

func emit_vim_indent(lx: Lex): str:
    mut s := VIM_INDENT_TPL
    s = str.Replace(s, "%%END%%", vim_alt(lx.endWords))
    s = str.Replace(s, "%%ELSE%%", vim_alt(lx.elseWords))
    ret s
end

func emit_vim_ftplugin(lx: Lex): str:
    mut s := VIM_FTPLUGIN_TPL
    s = str.Replace(s, "%%ISKEYWORD%%", VIM_ISKEYWORD)
    s = str.Replace(s, "%%MATCHSTART%%", vim_alt(lx.blockOpen))
    s = str.Replace(s, "%%MATCHMIDDLE%%", vim_alt(lx.elseWords))
    s = str.Replace(s, "%%MATCHEND%%", vim_alt(lx.endWords))
    ret s
end

func el_list(words: Vector<str>): str:
    mut v := Vector {} as Vector<str>
    repeat words.len() with i:
        v.push("\"" + words.get(i) + "\"")
    end
    ret str.Join(v, " ")
end

func el_list_arr(words: str[:]): str:
    mut v := Vector {} as Vector<str>
    repeat len(words) with i:
        v.push("\"" + words[i] + "\"")
    end
    ret str.Join(v, " ")
end

func emit_emacs_mode(lx: Lex, version: str): str:
    mut s := EMACS_MODE_TPL
    s = str.Replace(s, "%%BT%%", "\x60")
    s = str.Replace(s, "%%TQE%%", "\\\"\\\"\\\"")
    s = str.Replace(s, "%%VERSION%%", version)
    s = str.Replace(s, "%%ELIDC%%", EL_IDC)
    s = str.Replace(s, "%%ELIDS%%", EL_IDS)
    s = str.Replace(s, "%%ELDIGIT%%", EL_DIGIT)
    s = str.Replace(s, "%%CONDITIONAL%%", el_list(lx.conditional))
    s = str.Replace(s, "%%LOOP%%", el_list(lx.loops))
    s = str.Replace(s, "%%STATEMENT%%", el_list(lx.statement))
    s = str.Replace(s, "%%STORAGECLASS%%", el_list(lx.storageClass))
    s = str.Replace(s, "%%KEYWORD%%", el_list(lx.keywords))
    s = str.Replace(s, "%%FUNCDEF%%", el_list(lx.funcDef))
    s = str.Replace(s, "%%STRUCTURE%%", el_list(lx.structure))
    s = str.Replace(s, "%%INCLUDE%%", el_list(lx.includes))
    s = str.Replace(s, "%%BOOLEAN%%", el_list(lx.booleans))
    s = str.Replace(s, "%%NULL%%", el_list(lx.nulls))
    s = str.Replace(s, "%%THIS%%", el_list(lx.receiver))
    s = str.Replace(s, "%%TYPES%%", el_list(lx.types))
    s = str.Replace(s, "%%AUTO%%", el_list(lx.autos))
    s = str.Replace(s, "%%INTRTYPES%%", el_list(lx.intrTypes))
    s = str.Replace(s, "%%IO%%", el_list(lx.io))
    s = str.Replace(s, "%%LOGICAL%%", el_list(lx.logical))
    s = str.Replace(s, "%%CONTEXTUAL%%", el_list(lx.contextual))
    s = str.Replace(s, "%%DIRECTIVES%%", el_list_arr(DIRECTIVE_WORDS[:]))
    s = str.Replace(s, "%%INTRMETHODS%%", el_list(lx.intrMethods))
    s = str.Replace(s, "%%END%%", el_list(lx.endWords))
    s = str.Replace(s, "%%ELSE%%", el_list(lx.elseWords))
    s = str.Replace(s, "%%ALLKW%%", el_list(all_keywords(lx)))
    ret s
end

func xml_words(words: Vector<str>): str:
    mut v := Vector {} as Vector<str>
    repeat words.len() with i:
        v.push("\n      <item>" + words.get(i) + "</item>")
    end
    ret str.Join(v, "") + "\n    "
end

func xml_words_arr(words: str[:]): str:
    mut v := Vector {} as Vector<str>
    repeat len(words) with i:
        v.push(words[i])
    end
    ret xml_words(v)
end

func xml_escape(s: str): str:
    mut out := str.Replace(s, "&", "&amp;")
    out = str.Replace(out, "<", "&lt;")
    out = str.Replace(out, ">", "&gt;")
    out = str.Replace(out, "\"", "&quot;")
    ret out
end

func fill_common(tpl: str, lx: Lex): str:
    mut s := tpl
    s = str.Replace(s, "%%BT%%", "\x60")
    s = str.Replace(s, "%%NBB%%", xml_escape(onig_nbb()))
    s = str.Replace(s, "%%NBA%%", xml_escape(onig_nba()))
    s = str.Replace(s, "%%IDENT%%", xml_escape("[" + ONIG_IDS + "][" + ONIG_IDC + "]*"))
    s = str.Replace(s, "%%IDS%%", xml_escape(ONIG_IDS))
    s = str.Replace(s, "%%IDC%%", xml_escape(ONIG_IDC))
    s = str.Replace(s, "%%DIGIT%%", xml_escape(ONIG_DIGIT))
    s = str.Replace(s, "%%A_CONTROL%%", xml_escape(alt(lx.control)))
    s = str.Replace(s, "%%A_STORAGE%%", xml_escape(alt(lx.storage)))
    s = str.Replace(s, "%%A_IO%%", xml_escape(alt(lx.io)))
    s = str.Replace(s, "%%A_CONSTS%%", xml_escape(alt(lx.consts)))
    s = str.Replace(s, "%%A_THIS%%", xml_escape(alt(lx.receiver)))
    s = str.Replace(s, "%%A_TYPES%%", xml_escape(alt(lx.types)))
    s = str.Replace(s, "%%A_INTRTYPES%%", xml_escape(alt(lx.intrTypes)))
    s = str.Replace(s, "%%A_AUTO%%", xml_escape(alt(lx.autos)))
    s = str.Replace(s, "%%A_CONTEXTUAL%%", xml_escape(alt(lx.contextual)))
    s = str.Replace(s, "%%A_LOGICAL%%", xml_escape(alt(lx.logical)))
    s = str.Replace(s, "%%A_FUNCDEF%%", xml_escape(alt(lx.funcDef)))
    s = str.Replace(s, "%%A_TYPEDEF%%", xml_escape(alt(lx.typeDef)))
    ret s
end

func emit_kate(lx: Lex): str:
    mut s := fill_common(KATE_TPL, lx)
    s = str.Replace(s, "%%L_CONTROL%%", xml_words(lx.control))
    s = str.Replace(s, "%%L_STORAGE%%", xml_words(lx.storage))
    s = str.Replace(s, "%%L_IO%%", xml_words(lx.io))
    s = str.Replace(s, "%%L_CONSTS%%", xml_words(lx.consts))
    s = str.Replace(s, "%%L_THIS%%", xml_words(lx.receiver))
    s = str.Replace(s, "%%L_TYPES%%", xml_words(lx.types))
    s = str.Replace(s, "%%L_INTRTYPES%%", xml_words(lx.intrTypes))
    s = str.Replace(s, "%%L_CONTEXTUAL%%", xml_words(lx.contextual))
    s = str.Replace(s, "%%L_LOGICAL%%", xml_words(lx.logical))
    s = str.Replace(s, "%%L_DIRECTIVES%%", xml_words_arr(DIRECTIVE_WORDS[:]))
    s = str.Replace(s, "%%L_FUNCDEF%%", xml_words(lx.funcDef))
    s = str.Replace(s, "%%L_TYPEDEF%%", xml_words(lx.typeDef))
    ret s
end

func emit_gtksourceview(lx: Lex): str:
    ret fill_common(GTK_LANG_TPL, lx)
end

func is_ascii_word(w: str): bool:
    repeat w.len() with i:
        if (w[i] as i32) > 127:
            ret false
        end
    end
    ret true
end

func ascii_only(words: Vector<str>): Vector<str>:
    mut v := Vector {} as Vector<str>
    repeat words.len() with i:
        if is_ascii_word(words.get(i)):
            v.push(words.get(i))
        end
    end
    ret v
end

func non_ascii_only(words: Vector<str>): Vector<str>:
    mut v := Vector {} as Vector<str>
    repeat words.len() with i:
        if !is_ascii_word(words.get(i)):
            v.push(words.get(i))
        end
    end
    ret v
end

func join_space(words: Vector<str>): str:
    ret str.Join(words, " ")
end

func join_semi(words: Vector<str>): str:
    ret str.Join(words, ";")
end

func emit_notepadpp(lx: Lex): str:
    mut s := NPP_TPL
    s = str.Replace(s, "%%BT%%", "\x60")
    s = str.Replace(s, "%%K_CONTROL%%", join_space(lx.control))
    s = str.Replace(s, "%%K_STORAGE%%", join_space(lx.storage))
    s = str.Replace(s, "%%K_TYPES%%", join_space(lx.types))
    s = str.Replace(s, "%%K_IO%%", join_space(lx.io))
    mut c5 := Vector {} as Vector<str>
    push_all(lx.consts, c5)
    push_all(lx.receiver, c5)
    s = str.Replace(s, "%%K_CONSTS%%", join_space(c5))
    s = str.Replace(s, "%%K_INTRTYPES%%", join_space(lx.intrTypes))
    mut c7 := Vector {} as Vector<str>
    push_all(lx.contextual, c7)
    push_all(lx.logical, c7)
    push_all(lx.autos, c7)
    s = str.Replace(s, "%%K_CONTEXTUAL%%", join_space(c7))
    s = str.Replace(s, "%%K_INTRMETHODS%%", join_space(single_words(lx.intrMethods)))
    ret s
end

func emit_jetbrains(lx: Lex): str:
    mut s := JETBRAINS_TPL
    mut kw := Vector {} as Vector<str>
    push_all(lx.control, kw)
    push_all(lx.storage, kw)
    push_all(lx.contextual, kw)
    push_all(lx.logical, kw)
    s = str.Replace(s, "%%J_KEYWORDS%%", join_semi(kw))
    mut ty := Vector {} as Vector<str>
    push_all(lx.types, ty)
    push_all(lx.autos, ty)
    push_all(lx.intrTypes, ty)
    s = str.Replace(s, "%%J_TYPES%%", join_semi(ty))
    mut bi := Vector {} as Vector<str>
    push_all(lx.io, bi)
    push_all(single_words(lx.intrMethods), bi)
    s = str.Replace(s, "%%J_BUILTINS%%", join_semi(bi))
    mut co := Vector {} as Vector<str>
    push_all(lx.consts, co)
    push_all(lx.receiver, co)
    s = str.Replace(s, "%%J_CONSTS%%", join_semi(co))
    ret s
end

func emit_nano(lx: Lex): str:
    mut s := NANO_TPL
    s = str.Replace(s, "%%BT%%", "\x60")
    s = str.Replace(s, "%%N_DIGIT%%", EL_DIGIT)
    s = str.Replace(s, "%%N_CONTROL%%", alt(lx.control))
    s = str.Replace(s, "%%N_STORAGE%%", alt(lx.storage))
    s = str.Replace(s, "%%N_TYPES%%", alt(lx.types))
    s = str.Replace(s, "%%N_INTRTYPES%%", alt(lx.intrTypes))
    s = str.Replace(s, "%%N_IO%%", alt(lx.io))
    s = str.Replace(s, "%%N_CONSTS%%", alt(lx.consts))
    s = str.Replace(s, "%%N_THIS%%", alt(lx.receiver))
    mut ctx := Vector {} as Vector<str>
    push_all(lx.contextual, ctx)
    push_all(lx.autos, ctx)
    s = str.Replace(s, "%%N_CONTEXTUAL%%", alt(ctx))
    s = str.Replace(s, "%%N_LOGICAL%%", alt(lx.logical))
    ret s
end

func micro_line(group: str, words: Vector<str>, ascii: bool): str:
    body := str.Join(words, "|")
    if ascii:
        ret "  - " + group + ": \"\\\\b(" + body + ")\\\\b\""
    end
    ret "  - " + group + ": '(" + body + ")'"
end

func micro_chunks(group: str, words: Vector<str>, ascii: bool, out &: Vector<str>):
    if words.len() == 0:
        ret
    end
    sorted := sorted_desc(words)
    mut cur := Vector {} as Vector<str>
    mut width := 0
    repeat sorted.len() with i:
        w := sorted.get(i)
        if width > 0 && width + w.len() + 1 > 150:
            out.push(micro_line(group, cur, ascii))
            cur = Vector {} as Vector<str>
            width = 0
        end
        cur.push(w)
        width += w.len() + 1
    end
    if cur.len() > 0:
        out.push(micro_line(group, cur, ascii))
    end
end

func micro_rules(group: str, words: Vector<str>, out &: Vector<str>):
    micro_chunks(group, ascii_only(words), true, out)
    micro_chunks(group, non_ascii_only(words), false, out)
end

func emit_micro(lx: Lex): str:
    mut s := MICRO_TPL
    s = str.Replace(s, "%%BT%%", "\x60")
    s = str.Replace(s, "%%M_NONASCII_DIGIT%%", "\u0660-\u0669\u06f0-\u06f9")

    mut ctx := Vector {} as Vector<str>
    push_all(lx.contextual, ctx)
    push_all(lx.autos, ctx)

    mut rules := Vector {} as Vector<str>
    micro_rules("identifier.class", lx.types, rules)
    micro_rules("identifier.class", lx.intrTypes, rules)
    micro_rules("statement", lx.control, rules)
    micro_rules("statement", lx.storage, rules)
    micro_rules("statement", ctx, rules)
    micro_rules("symbol.operator", lx.logical, rules)
    micro_rules("identifier", lx.io, rules)
    micro_rules("constant", lx.consts, rules)
    micro_rules("constant", lx.receiver, rules)
    s = str.Replace(s, "%%M_KEYWORD_RULES%%", str.Join(rules, "\n"))
    ret s
end

func emit_vscode_grammar(lx: Lex): str:
    mut s := VSCODE_TPL
    s = str.Replace(s, "%%BT%%", "\x60")
    s = str.Replace(s, "%%TQ%%", "\\\"\\\"\\\"")
    s = str.Replace(s, "%%NBB%%", json.Escape(onig_nbb()))
    s = str.Replace(s, "%%NBA%%", json.Escape(onig_nba()))
    s = str.Replace(s, "%%IDENT%%", json.Escape("[" + ONIG_IDS + "][" + ONIG_IDC + "]*"))
    s = str.Replace(s, "%%IDC%%", json.Escape(ONIG_IDC))
    s = str.Replace(s, "%%DIGIT%%", json.Escape(ONIG_DIGIT))
    s = str.Replace(s, "%%DIRECTIVES%%", alt_arr(DIRECTIVE_WORDS[:]))
    s = str.Replace(s, "%%FUNCDEF%%", json.Escape(alt(lx.funcDef)))
    s = str.Replace(s, "%%TYPEDEF%%", json.Escape(alt(lx.typeDef)))
    s = str.Replace(s, "%%CONTROL%%", json.Escape(alt(lx.control)))
    s = str.Replace(s, "%%LOGICAL%%", json.Escape(alt(lx.logical)))
    s = str.Replace(s, "%%STORAGE%%", json.Escape(alt(lx.storage)))
    s = str.Replace(s, "%%IO%%", json.Escape(alt(lx.io)))
    s = str.Replace(s, "%%CONSTS%%", json.Escape(alt(lx.consts)))
    s = str.Replace(s, "%%THIS%%", json.Escape(alt(lx.receiver)))
    s = str.Replace(s, "%%AUTO%%", json.Escape(alt(lx.autos)))
    s = str.Replace(s, "%%TYPES%%", json.Escape(alt(lx.types)))
    s = str.Replace(s, "%%INTRTYPES%%", json.Escape(alt(lx.intrTypes)))
    s = str.Replace(s, "%%INTRMETHODS%%", json.Escape(alt(lx.intrMethods)))
    s = str.Replace(s, "%%CONTEXTUAL%%", json.Escape(alt(lx.contextual)))
    s = str.Replace(s, "%%ALLKW%%", json.Escape(alt(all_keywords(lx))))
    ret json.IndentWith(json.Minify(s), "  ") + "\n"
end

func emit_geany(lx: Lex): str:
    mut s := GEANY_TPL
    mut primary := Vector {} as Vector<str>
    push_all(lx.control, primary)
    push_all(lx.storage, primary)
    push_all(lx.contextual, primary)
    push_all(lx.logical, primary)
    push_all(lx.consts, primary)
    push_all(lx.receiver, primary)
    push_all(lx.io, primary)
    s = str.Replace(s, "%%G_PRIMARY%%", join_space(primary))
    mut secondary := Vector {} as Vector<str>
    push_all(lx.types, secondary)
    push_all(lx.autos, secondary)
    push_all(lx.intrTypes, secondary)
    s = str.Replace(s, "%%G_SECONDARY%%", join_space(secondary))
    ret s
end

func main:
    lx := build_lex()
    println "salam editor syntaxes"
    write_out(EXT_DIR + "/sublime/Salam.sublime-syntax", emit_sublime_syntax(lx))
    write_out(EXT_DIR + "/sublime/Indentation Rules.tmPreferences", emit_sublime_indent(lx))
    write_out(EXT_DIR + "/sublime/Comments.tmPreferences", SUBLIME_COMMENTS_TPL)
    write_out(EXT_DIR + "/sublime/Symbol List.tmPreferences", SUBLIME_SYMBOLS_TPL)

    write_out(EXT_DIR + "/vim/syntax/salam.vim", emit_vim_syntax(lx))
    write_out(EXT_DIR + "/vim/indent/salam.vim", emit_vim_indent(lx))
    write_out(EXT_DIR + "/vim/ftplugin/salam.vim", emit_vim_ftplugin(lx))

    version := str.TrimRight(os.ReadFile("VERSION"))
    write_out(EXT_DIR + "/emacs/salam-mode.el", emit_emacs_mode(lx, version))

    write_out(EXT_DIR + "/vscode/syntaxes/salam.tmLanguage.json", emit_vscode_grammar(lx))
    write_out(EXT_DIR + "/kate/salam.xml", emit_kate(lx))
    write_out(EXT_DIR + "/gtksourceview/salam.lang", emit_gtksourceview(lx))

    write_out(EXT_DIR + "/notepadpp/salam.xml", emit_notepadpp(lx))
    write_out(EXT_DIR + "/jetbrains/Salam.xml", emit_jetbrains(lx))
    write_out(EXT_DIR + "/geany/filetypes.Salam.conf", emit_geany(lx))
    write_out(EXT_DIR + "/nano/salam.nanorc", emit_nano(lx))
    write_out(EXT_DIR + "/micro/salam.yaml", emit_micro(lx))

    snips := read_snippets()
    write_out(EXT_DIR + "/sublime/Salam.sublime-completions", emit_sublime_completions(snips))
    write_out(EXT_DIR + "/vim/UltiSnips/salam.snippets", emit_ultisnips(snips))
    repeat snips.len() with i:
        s := snips.get(i)
        write_out(EXT_DIR + "/emacs/snippets/salam-mode/" + s.prefix, emit_yasnippet(s))
    end
end
