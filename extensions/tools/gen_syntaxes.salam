VIM_SYNTAX_TPL := `" Vim syntax file - Language: Salam
" Generated by extensions/tools/gen_syntaxes.salam

if exists('b:current_syntax')
  finish
endif

let s:cpo_save = &cpo
set cpo&vim

syn iskeyword %%ISKEYWORD%%

syn case match
syn sync minlines=60 maxlines=400

syn keyword salamConditional  %%CONDITIONAL%%
syn keyword salamRepeat       %%LOOP%%
syn keyword salamStatement    %%STATEMENT%%
syn keyword salamStorageClass %%STORAGECLASS%%
syn keyword salamKeyword      %%KEYWORD%%
syn keyword salamBoolean      %%BOOLEAN%%
syn keyword salamNull         %%NULL%%
syn keyword salamThis         %%THIS%%
syn keyword salamType         %%TYPES%%
syn keyword salamType         %%AUTO%%
syn keyword salamBuiltinType  %%INTRTYPES%%
syn keyword salamBuiltin      %%IO%%
syn keyword salamOperatorWord %%LOGICAL%%
syn keyword salamContextual   %%CONTEXTUAL%%
%%JOINED%%

syn keyword salamFuncDecl  %%FUNCDEF%% nextgroup=salamFunctionName skipwhite
syn keyword salamStructure %%STRUCTURE%% nextgroup=salamTypeName skipwhite
syn keyword salamInclude   %%INCLUDE%% nextgroup=salamModuleName skipwhite

syn match salamFunctionName contained "\k\+"
syn match salamTypeName     contained "\k\+"
syn match salamModuleName   contained "\k\+\%(\.\k\+\)*"

syn match salamNumber "\<[%%DIGIT%%][%%DIGIT%%_]*f\=\>"
syn match salamNumber "\<0[xX]\x[0-9A-Fa-f_]*\>"
syn match salamNumber "\<0[bB][01][01_]*\>"
syn match salamNumber "\<0[oO]\o[0-7_]*\>"
syn match salamFloat  "\<[%%DIGIT%%][%%DIGIT%%_]*[eE][+-]\=[%%DIGIT%%][%%DIGIT%%_]*f\=\>"
syn match salamFloat  "\<[%%DIGIT%%][%%DIGIT%%_]*\.[%%DIGIT%%][%%DIGIT%%_]*\%([eE][+-]\=[%%DIGIT%%][%%DIGIT%%_]*\)\=f\=\>"

syn match salamAnnotation "@[A-Za-z_]\k*"
syn match salamLayoutElement "^\s*\%(\%(%%ALLKW%%\)\>\)\@!\zs\k\+\ze\s*:\s*$"

syn match salamOperator "=>\|\.\.\.\|:=\|==\|!=\|<=\|>=\|&&\|||\|\^\^=\|[-+*/%]=\|[-+*/%<>=!&?]"
syn match salamDelimiter "[(){}\[\],;]"

syn match salamEscape      contained "\\\%(x\x\x\|u{\x\+}\|u\x\{4}\|[0abfnrtv\"'\\]\)"
syn match salamEscapeError contained "\\\%(x\x\x\|u{\x\+}\|u\x\{4}\|[0abfnrtv\"'\\]\)\@!."

syn region salamString start=+"+ skip=+\\\\\|\\"+ end=+"+ oneline
      \ contains=salamEscape,salamEscapeError,@Spell
syn region salamRawString start=+%%BT%%+ end=+%%BT%%+ contains=@Spell
syn region salamTripleString start=+"""+ end=+"""+ keepend
      \ contains=salamEscape,salamEscapeError,@Spell
syn match  salamCharacter "u\='\%(\\\%(x\x\x\|u{\x\+}\|u\x\{4}\|.\)\|[^'\\]\)'"

syn match salamFunctionCall "\k\+\ze\s*("
syn match salamBuiltinMethod "\.\@<=\%(%%INTRMETHODS%%\)\>"

syn keyword salamTodo contained TODO FIXME XXX NOTE HACK
syn region  salamBlockComment start="/\*" end="\*/" contains=salamTodo,@Spell fold
syn region  salamComment start="//" end="$" keepend oneline contains=salamTodo,@Spell
syn match   salamDirectiveKey contained "\<\%(%%DIRECTIVES%%\)\>"
syn match   salamDirectiveSep contained "|"
syn region  salamDirective start="//!" end="$" keepend oneline
      \ contains=salamDirectiveKey,salamDirectiveSep,@Spell

hi def link salamConditional   Conditional
hi def link salamRepeat        Repeat
hi def link salamStatement     Statement
hi def link salamStorageClass  StorageClass
hi def link salamStructure     Structure
hi def link salamInclude       Include
hi def link salamKeyword       Keyword
hi def link salamFuncDecl      Keyword
hi def link salamContextual    Keyword
hi def link salamBoolean       Boolean
hi def link salamNull          Constant
hi def link salamThis          Identifier
hi def link salamType          Type
hi def link salamBuiltinType   Type
hi def link salamTypeName      Type
hi def link salamFunctionName  Function
hi def link salamFunctionCall  Function
hi def link salamBuiltin       Function
hi def link salamBuiltinMethod Function
hi def link salamModuleName    Identifier
hi def link salamLayoutElement Identifier
hi def link salamComment       Comment
hi def link salamBlockComment  Comment
hi def link salamTodo          Todo
hi def link salamDirective     PreProc
hi def link salamDirectiveKey  Special
hi def link salamDirectiveSep  Delimiter
hi def link salamAnnotation    PreProc
hi def link salamString        String
hi def link salamTripleString  String
hi def link salamRawString     String
hi def link salamCharacter     Character
hi def link salamEscape        SpecialChar
hi def link salamEscapeError   Error
hi def link salamNumber        Number
hi def link salamFloat         Float
hi def link salamOperator      Operator
hi def link salamOperatorWord  Operator
hi def link salamDelimiter     Delimiter

let b:current_syntax = 'salam'

let &cpo = s:cpo_save
unlet s:cpo_save
`

VIM_INDENT_TPL := `" Vim indent file - Language: Salam
" Generated by extensions/tools/gen_syntaxes.salam

if exists('b:did_indent')
  finish
endif
let b:did_indent = 1

let s:cpo_save = &cpo
set cpo&vim

setlocal indentexpr=GetSalamIndent()
setlocal indentkeys=0{,0},!^F,o,O,e,0=end,<:>
setlocal nolisp
setlocal nosmartindent

let b:undo_indent = 'setlocal indentexpr< indentkeys< lisp< smartindent<'

if exists('*GetSalamIndent')
  let &cpo = s:cpo_save
  unlet s:cpo_save
  finish
endif

let s:open_block = ':\s*\%(//.*\)\=$'
let s:close_block = '^\s*\%(%%END%%\)\s*$'
let s:else_block = '^\s*\%(%%ELSE%%\)\%(\s\|:\)'

function! s:Code(lnum) abort
  let l:line = getline(a:lnum)
  let l:line = substitute(l:line, '"""\%(.\{-}\)"""', '""', 'g')
  let l:line = substitute(l:line, '"\%(\\.\|[^"\\]\)*"', '""', 'g')
  let l:line = substitute(l:line, "'\\%(\\\\.\\|[^'\\\\]\\)*'", "''", 'g')
  let l:line = substitute(l:line, '//.*$', '', '')
  return substitute(l:line, '\s\+$', '', '')
endfunction

function! s:PrevCode(lnum) abort
  let l:lnum = prevnonblank(a:lnum - 1)
  while l:lnum > 0 && s:Code(l:lnum) =~# '^\s*$'
    let l:lnum = prevnonblank(l:lnum - 1)
  endwhile
  return l:lnum
endfunction

function! GetSalamIndent() abort
  let l:prev = s:PrevCode(v:lnum)
  if l:prev == 0
    return 0
  endif

  let l:shift = shiftwidth()
  let l:indent = indent(l:prev)
  let l:prevcode = s:Code(l:prev)

  if l:prevcode =~# s:open_block
    let l:indent += l:shift
  endif

  let l:curcode = s:Code(v:lnum)
  if l:curcode =~# s:close_block || l:curcode =~# s:else_block
    let l:indent -= l:shift
  endif

  return l:indent < 0 ? 0 : l:indent
endfunction

let &cpo = s:cpo_save
unlet s:cpo_save
`

VIM_FTPLUGIN_TPL := `" Vim filetype plugin - Language: Salam
" Generated by extensions/tools/gen_syntaxes.salam

if exists('b:did_ftplugin')
  finish
endif
let b:did_ftplugin = 1

let s:cpo_save = &cpo
set cpo&vim

setlocal commentstring=//\ %s
setlocal comments=s1:/*,mb:*,ex:*/,://
setlocal suffixesadd=.salam
setlocal includeexpr=substitute(v:fname,'\\.','/','g')
setlocal formatoptions-=t
setlocal formatoptions+=croqlj

setlocal expandtab
setlocal shiftwidth=4
setlocal softtabstop=4
setlocal tabstop=4

compiler salam

if exists('loaded_matchit') && !exists('b:match_words')
  let b:match_ignorecase = 0
  let b:match_words = '\<\%(%%MATCHSTART%%\)\>:\<\%(%%MATCHMIDDLE%%\)\>:\<\%(%%MATCHEND%%\)\>'
endif

let b:undo_ftplugin = 'setlocal commentstring< comments< suffixesadd<'
      \ . ' includeexpr< formatoptions< expandtab< shiftwidth< softtabstop< tabstop<'
      \ . ' | unlet! b:match_words b:match_ignorecase'

let &cpo = s:cpo_save
unlet s:cpo_save
`

EMACS_MODE_TPL := `;;; salam-mode.el --- Major mode for the Salam programming language -*- lexical-binding: t; -*-

;; Author: The Salam Team
;; URL: https://github.com/SalamLang/Salam
;; Version: %%VERSION%%
;; Package-Requires: ((emacs "26.1"))
;; Keywords: languages salam
;; SPDX-License-Identifier: MIT

;;; Commentary:

;; Generated by extensions/tools/gen_syntaxes.salam

;;; Code:

(defvar compilation-error-regexp-alist)
(defvar compilation-error-regexp-alist-alist)
(defvar yas-snippet-dirs)

(defgroup salam nil
  "Support for the Salam programming language."
  :group 'languages
  :prefix "salam-")

(defcustom salam-compiler "salam"
  "Path to the Salam compiler.  A bare name is looked up on ‘exec-path’."
  :type 'string
  :group 'salam)

(defcustom salam-lang "auto"
  "Keyword pack passed to the compiler as --lang.
\"auto\" reads a //! lang: directive, then falls back to detecting the
script the buffer is written in."
  :type '(choice (const "auto") (const "en") (const "fa"))
  :group 'salam)

(defcustom salam-indent-offset 4
  "Number of columns one level of indentation adds."
  :type 'integer
  :group 'salam)

(defcustom salam-format-indent "4"
  "Indentation handed to ‘salam format --indent’: \"tab\", or 1 to 16."
  :type 'string
  :group 'salam)

(defcustom salam-format-on-save nil
  "Reformat the buffer with ‘salam format’ before every save."
  :type 'boolean
  :group 'salam)

(defcustom salam-stdlib-path ""
  "Root directory for std/... imports, passed as --stdlib-path.
An empty string lets the compiler find it."
  :type 'string
  :group 'salam)

(defcustom salam-run-command "exec"
  "Subcommand ‘salam-run’ uses.
\"exec\" is the tree-walking interpreter and needs no C toolchain."
  :type '(choice (const "exec") (const "run"))
  :group 'salam)

(defconst salam-conditional-keywords '(%%CONDITIONAL%%))
(defconst salam-loop-keywords '(%%LOOP%%))
(defconst salam-statement-keywords '(%%STATEMENT%%))
(defconst salam-storage-keywords '(%%STORAGECLASS%%))
(defconst salam-other-keywords '(%%KEYWORD%%))
(defconst salam-function-keywords '(%%FUNCDEF%%))
(defconst salam-structure-keywords '(%%STRUCTURE%%))
(defconst salam-include-keywords '(%%INCLUDE%%))
(defconst salam-boolean-keywords '(%%BOOLEAN%%))
(defconst salam-null-keywords '(%%NULL%%))
(defconst salam-this-keywords '(%%THIS%%))
(defconst salam-type-keywords '(%%TYPES%%))
(defconst salam-auto-keywords '(%%AUTO%%))
(defconst salam-builtin-type-keywords '(%%INTRTYPES%%))
(defconst salam-builtin-keywords '(%%IO%%))
(defconst salam-word-operators '(%%LOGICAL%%))
(defconst salam-contextual-keywords '(%%CONTEXTUAL%%))
(defconst salam-directive-keywords '(%%DIRECTIVES%%))
(defconst salam-builtin-methods '(%%INTRMETHODS%%))
(defconst salam-end-keywords '(%%END%%))
(defconst salam-else-keywords '(%%ELSE%%))
(defconst salam-all-keywords '(%%ALLKW%%))

(defconst salam--ident-chars "[%%ELIDC%%]"
  "Character class matching one identifier character, Arabic script included.")

(defconst salam--ident (concat "[%%ELIDS%%]" salam--ident-chars "*")
  "Regexp matching a whole identifier.")

(defconst salam--digit "[%%ELDIGIT%%]"
  "Character class matching one digit, Persian and Arabic-Indic included.")

(defun salam--words (words)
  "Return a regexp matching any of WORDS as a whole word."
  (concat "\\<" (regexp-opt words) "\\>"))

(defvar salam-mode-syntax-table
  (let ((table (make-syntax-table)))
    (modify-syntax-entry ?/ ". 124" table)
    (modify-syntax-entry ?* ". 23b" table)
    (modify-syntax-entry ?\n ">" table)
    (modify-syntax-entry ?\" "\"" table)
    (modify-syntax-entry ?\\ "\\" table)
    (modify-syntax-entry ?%%BT%% "\"" table)
    (modify-syntax-entry ?' "." table)
    (modify-syntax-entry ?_ "w" table)
    (modify-syntax-entry ?@ "." table)
    (modify-syntax-entry '(?\u0600 . ?\u06ff) "w" table)
    (modify-syntax-entry '(?\u0750 . ?\u077f) "w" table)
    (modify-syntax-entry '(?\u08a0 . ?\u08ff) "w" table)
    (modify-syntax-entry '(?\ufb50 . ?\ufdff) "w" table)
    (modify-syntax-entry '(?\ufe70 . ?\ufeff) "w" table)
    (modify-syntax-entry ?\u200c "w" table)
    (modify-syntax-entry ?\u200d "w" table)
    table)
  "Syntax table for ‘salam-mode’.")

(defun salam--propertize (start end)
  "Mark every %%TQE%% between START and END as a generic string fence.
Without this the first two quotes of %%TQE%% read as an empty string and the
third opens one, which would mis-colour the rest of the buffer."
  (goto-char start)
  (while (search-forward "%%TQE%%" end t)
    (let ((open (- (point) 3)))
      (put-text-property open (1+ open) 'syntax-table (string-to-syntax "|"))
      (put-text-property (1+ open) (point) 'syntax-table (string-to-syntax ".")))))

(defvar salam-font-lock-keywords
  (list
   (list (concat "^\\s-*\\(//!\\)\\(.*\\)$")
         '(1 font-lock-preprocessor-face t)
         '(2 font-lock-preprocessor-face t))
   (list (concat "\\(" (salam--words salam-function-keywords) "\\)\\s-+\\(" salam--ident "\\)")
         '(1 font-lock-keyword-face)
         '(2 font-lock-function-name-face))
   (list (concat "\\(" (salam--words salam-structure-keywords) "\\)\\s-+\\(" salam--ident "\\)")
         '(1 font-lock-keyword-face)
         '(2 font-lock-type-face))
   (list (concat "\\(" (salam--words salam-include-keywords) "\\)\\s-+\\([^ \t\n]+\\)")
         '(1 font-lock-keyword-face)
         '(2 font-lock-constant-face))
   (cons "@[A-Za-z_][A-Za-z0-9_]*" 'font-lock-preprocessor-face)
   (cons (salam--words salam-conditional-keywords) 'font-lock-keyword-face)
   (cons (salam--words salam-loop-keywords) 'font-lock-keyword-face)
   (cons (salam--words salam-statement-keywords) 'font-lock-keyword-face)
   (cons (salam--words salam-storage-keywords) 'font-lock-keyword-face)
   (cons (salam--words salam-other-keywords) 'font-lock-keyword-face)
   (cons (salam--words salam-contextual-keywords) 'font-lock-keyword-face)
   (cons (salam--words salam-word-operators) 'font-lock-keyword-face)
   (cons (salam--words salam-boolean-keywords) 'font-lock-constant-face)
   (cons (salam--words salam-null-keywords) 'font-lock-constant-face)
   (cons (salam--words salam-this-keywords) 'font-lock-builtin-face)
   (cons (salam--words salam-type-keywords) 'font-lock-type-face)
   (cons (salam--words salam-auto-keywords) 'font-lock-type-face)
   (cons (salam--words salam-builtin-type-keywords) 'font-lock-type-face)
   (cons (salam--words salam-builtin-keywords) 'font-lock-builtin-face)
   (cons (concat "\\.\\(" (regexp-opt salam-builtin-methods) "\\)\\>") '(1 font-lock-builtin-face))
   (cons (concat "\\(" salam--ident "\\)\\s-*(") '(1 font-lock-function-name-face))
   (cons (concat "\\<" salam--digit "[" "%%ELDIGIT%%" "_]*\\(\\." salam--digit "[%%ELDIGIT%%_]*\\)?\\(?:[eE][+-]?" salam--digit "+\\)?f?\\>")
         'font-lock-constant-face)
   (cons "\\<0[xX][0-9A-Fa-f][0-9A-Fa-f_]*\\>" 'font-lock-constant-face)
   (cons "\\<0[bB][01][01_]*\\>" 'font-lock-constant-face)
   (cons "\\<0[oO][0-7][0-7_]*\\>" 'font-lock-constant-face)
   (cons "u?'\\(?:\\\\.\\|[^'\\\\]\\)'" 'font-lock-string-face))
  "Font lock rules for ‘salam-mode’.")

(defun salam--line-code (&optional position)
  "Return the current line with strings and comments blanked out.
With POSITION, use the line holding that buffer position."
  (save-excursion
    (when position (goto-char position))
    (let ((line (buffer-substring-no-properties
                 (line-beginning-position) (line-end-position))))
      (setq line (replace-regexp-in-string "\"\"\".*?\"\"\"" "\"\"" line))
      (setq line (replace-regexp-in-string "\"\\(?:\\\\.\\|[^\"\\\\]\\)*\"" "\"\"" line))
      (setq line (replace-regexp-in-string "'\\(?:\\\\.\\|[^'\\\\]\\)*'" "''" line))
      (setq line (replace-regexp-in-string "//.*$" "" line))
      (string-trim-right line))))

(defun salam--previous-code-line ()
  "Move point to the closest line above that carries code.
Return nil when there is none."
  (let ((found nil))
    (while (and (not found) (zerop (forward-line -1)))
      (unless (string-match-p "\\%%BT%%[ \t]*\\'" (salam--line-code))
        (setq found t)))
    found))

(defun salam-indent-line ()
  "Indent the current line according to the block structure."
  (interactive)
  (let* ((opens-block "[ \t]*:[ \t]*\\'")
         (closes (concat "\\%%BT%%[ \t]*" (regexp-opt salam-end-keywords) "[ \t]*\\'"))
         (dedents (concat "\\%%BT%%[ \t]*" (regexp-opt salam-else-keywords) "\\(?:[ \t]\\|:\\)"))
         (current (salam--line-code))
         (target
          (save-excursion
            (if (not (salam--previous-code-line))
                0
              (let ((indent (current-indentation))
                    (previous (salam--line-code)))
                (when (string-match-p opens-block previous)
                  (setq indent (+ indent salam-indent-offset)))
                indent)))))
    (when (or (string-match-p closes current) (string-match-p dedents current))
      (setq target (- target salam-indent-offset)))
    (indent-line-to (max target 0))))

(defun salam--detect-lang ()
  "Return the keyword pack this buffer is written in: \"en\" or \"fa\"."
  (if (member salam-lang '("en" "fa"))
      salam-lang
    (save-excursion
      (goto-char (point-min))
      (let ((head (buffer-substring-no-properties
                   (point-min) (min (point-max) (+ (point-min) 4000)))))
        (cond
         ((string-match "\\(?:lang\\|LANG\\|\u0632\u0628\u0627\u0646\\)[ \t]*:[ \t]*\\([A-Za-z][A-Za-z]\\)" head)
          (downcase (match-string 1 head)))
         ((>= (length (replace-regexp-in-string "[^\u0600-\u06ff\ufb50-\ufeff]" "" head)) 3) "fa")
         (t "en"))))))

(defun salam--common-args ()
  "Return the compiler options every invocation carries."
  (append (list (concat "--lang=" (salam--detect-lang)))
          (unless (string-empty-p salam-stdlib-path)
            (list (concat "--stdlib-path=" salam-stdlib-path)))))

(defun salam--null-device ()
  "Return the platform's bit bucket."
  (if (memq system-type '(windows-nt ms-dos)) "NUL" "/dev/null"))

(defun salam--compile (args)
  "Run the compiler with ARGS through ‘compile’."
  (let ((compile-command
         (mapconcat #'shell-quote-argument (cons salam-compiler args) " ")))
    (compile compile-command)))

(defun salam--current-file ()
  "Return the buffer's file, saving it first so the compiler reads this text.
Signals when the buffer has never been written, which would otherwise build a
command line containing nil."
  (unless (buffer-file-name)
    (user-error "This buffer has no file; save it before running the compiler"))
  (when (buffer-modified-p)
    (save-buffer))
  (buffer-file-name))

(defun salam-run ()
  "Run the current buffer's file."
  (interactive)
  (salam--compile (append (list salam-run-command (salam--current-file) "--error-style=gcc")
                          (salam--common-args))))

(defun salam-build ()
  "Compile the current buffer's file to an executable."
  (interactive)
  (salam--compile (append (list "build" (salam--current-file) "--error-style=gcc")
                          (salam--common-args))))

(defun salam-check ()
  "Type-check the current buffer's file without running it."
  (interactive)
  (salam--compile (append (list "inspect" (salam--current-file)
                                "--emit-symbol"
                                (concat "--xml-out=" (salam--null-device))
                                "--error-style=gcc"
                                "--log-level=error")
                          (salam--common-args))))

(defun salam-format-buffer ()
  "Reformat the buffer with ‘salam format’, keeping point where it is."
  (interactive)
  (let* ((temporary (make-temp-file "salam-fmt-" nil ".salam"))
         (original (buffer-substring-no-properties (point-min) (point-max)))
         (arguments (append (list "format" temporary
                                  (concat "--indent=" salam-format-indent)
                                  "--error-style=gcc")
                            (salam--common-args))))
    (unwind-protect
        (progn
          (let ((coding-system-for-write 'utf-8-unix))
            (write-region original nil temporary nil 'quiet))
          (with-temp-buffer
            (let ((status (apply #'call-process salam-compiler nil t nil arguments)))
              (unless (eq status 0)
                (error "salam format failed: %s" (string-trim (buffer-string))))))
          (let ((formatted (with-temp-buffer
                             (insert-file-contents temporary)
                             (buffer-string))))
            (unless (string= formatted original)
              (let ((line (line-number-at-pos))
                    (column (current-column)))
                (erase-buffer)
                (insert formatted)
                (goto-char (point-min))
                (forward-line (1- line))
                (move-to-column column)))))
      (delete-file temporary))))

(defun salam--format-on-save ()
  "Reformat before saving when ‘salam-format-on-save’ is non-nil."
  (when salam-format-on-save
    (salam-format-buffer)))

(defvar salam-mode-map
  (let ((map (make-sparse-keymap)))
    (define-key map (kbd "C-c C-r") #'salam-run)
    (define-key map (kbd "C-c C-b") #'salam-build)
    (define-key map (kbd "C-c C-c") #'salam-check)
    (define-key map (kbd "C-c C-f") #'salam-format-buffer)
    map)
  "Keymap for ‘salam-mode’.")

(defconst salam--imenu-expression
  (list (list "Function"
              (concat "^[ \t]*\\(?:\\w+[ \t]+\\)*" (salam--words salam-function-keywords)
                      "[ \t]+\\(" salam--ident "\\)")
              1)
        (list "Type"
              (concat "^[ \t]*\\(?:\\w+[ \t]+\\)*" (salam--words salam-structure-keywords)
                      "[ \t]+\\(" salam--ident "\\)")
              1))
  "Imenu patterns for ‘salam-mode’.")

(define-derived-mode salam-mode prog-mode "Salam"
  "Major mode for editing Salam source code.

\\{salam-mode-map}"
  :syntax-table salam-mode-syntax-table
  (setq-local font-lock-defaults '(salam-font-lock-keywords))
  (setq-local syntax-propertize-function #'salam--propertize)
  (setq-local comment-start "// ")
  (setq-local comment-end "")
  (setq-local comment-start-skip "\\(?://+\\|/\\*+\\)\\s *")
  (setq-local indent-line-function #'salam-indent-line)
  (setq-local indent-tabs-mode nil)
  (setq-local tab-width salam-indent-offset)
  (setq-local electric-indent-chars (append electric-indent-chars '(?:)))
  (setq-local imenu-generic-expression salam--imenu-expression)
  (setq-local require-final-newline t)
  (setq-local bidi-paragraph-direction 'left-to-right)
  (add-hook 'before-save-hook #'salam--format-on-save nil t))

(add-to-list 'auto-mode-alist '("\\.salam\\'" . salam-mode))

(with-eval-after-load 'compile
  (add-to-list 'compilation-error-regexp-alist-alist
               '(salam "^\\(.+?\\):\\([0-9]+\\):\\([0-9]+\\): \\(?:\\(error\\)\\|\\(warning\\)\\|note\\): "
                       1 2 3 (5 . 4)))
  (add-to-list 'compilation-error-regexp-alist 'salam))

(with-eval-after-load 'yasnippet
  (let ((directory (expand-file-name
                    "snippets"
                    (file-name-directory (or load-file-name buffer-file-name "")))))
    (when (file-directory-p directory)
      (add-to-list 'yas-snippet-dirs directory t))))

(provide 'salam-mode)

;;; salam-mode.el ends here
`

KATE_TPL := `<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated by extensions/tools/gen_syntaxes.salam -->
<!DOCTYPE language SYSTEM "language.dtd">
<language name="Salam" section="Sources" version="1" kateversion="5.62"
          extensions="*.salam" mimetype="text/x-salam"
          author="The Salam Team" license="MIT" indenter="normal">
  <highlighting>
    <list name="control">%%L_CONTROL%%</list>
    <list name="storage">%%L_STORAGE%%</list>
    <list name="builtins">%%L_IO%%</list>
    <list name="constants">%%L_CONSTS%%</list>
    <list name="receiver">%%L_THIS%%</list>
    <list name="types">%%L_TYPES%%</list>
    <list name="intrinsics">%%L_INTRTYPES%%</list>
    <list name="contextual">%%L_CONTEXTUAL%%</list>
    <list name="wordoperators">%%L_LOGICAL%%</list>
    <list name="directives">%%L_DIRECTIVES%%</list>
    <list name="funcdef">%%L_FUNCDEF%%</list>
    <list name="typedef">%%L_TYPEDEF%%</list>

    <contexts>
      <context name="Normal" attribute="Normal Text" lineEndContext="#stay">
        <StringDetect attribute="Directive" context="Directive" String="//!"/>
        <Detect2Chars attribute="Comment" context="LineComment" char="/" char1="/"/>
        <Detect2Chars attribute="Comment" context="BlockComment" char="/" char1="*" beginRegion="Comment"/>
        <StringDetect attribute="String" context="TripleString" String="&quot;&quot;&quot;"/>
        <DetectChar attribute="String" context="String" char="&quot;"/>
        <DetectChar attribute="String" context="RawString" char="%%BT%%"/>
        <RegExpr attribute="Char" String="u?'(\\(x[0-9A-Fa-f]{2}|u\{[0-9A-Fa-f]+\}|u[0-9A-Fa-f]{4}|.)|[^'\\])'"/>
        <RegExpr attribute="Annotation" String="@[A-Za-z_][%%IDC%%]*"/>
        <keyword attribute="Keyword" String="funcdef" context="FunctionName"/>
        <keyword attribute="Keyword" String="typedef" context="TypeName"/>
        <keyword attribute="Control Flow" String="control"/>
        <keyword attribute="Keyword" String="storage"/>
        <keyword attribute="Keyword" String="contextual"/>
        <keyword attribute="Operator" String="wordoperators"/>
        <keyword attribute="Built-in" String="builtins"/>
        <keyword attribute="Constant" String="constants"/>
        <keyword attribute="Built-in" String="receiver"/>
        <keyword attribute="Data Type" String="types"/>
        <keyword attribute="Data Type" String="intrinsics"/>
        <RegExpr attribute="Float" String="%%NBB%%(?:[%%DIGIT%%][%%DIGIT%%_]*\.[%%DIGIT%%][%%DIGIT%%_]*(?:[eE][+-]?[%%DIGIT%%][%%DIGIT%%_]*)?|[%%DIGIT%%][%%DIGIT%%_]*[eE][+-]?[%%DIGIT%%][%%DIGIT%%_]*)f?%%NBA%%"/>
        <RegExpr attribute="Number" String="%%NBB%%0[xX][0-9A-Fa-f][0-9A-Fa-f_]*%%NBA%%"/>
        <RegExpr attribute="Number" String="%%NBB%%0[bB][01][01_]*%%NBA%%"/>
        <RegExpr attribute="Number" String="%%NBB%%0[oO][0-7][0-7_]*%%NBA%%"/>
        <RegExpr attribute="Number" String="%%NBB%%[%%DIGIT%%][%%DIGIT%%_]*f?%%NBA%%"/>
        <AnyChar attribute="Symbol" String="+-*/%&lt;&gt;=!&amp;|^?:,.()[]{}"/>
      </context>

      <context name="FunctionName" attribute="Normal Text" lineEndContext="#pop" fallthroughContext="#pop">
        <DetectSpaces/>
        <RegExpr attribute="Function" String="%%IDENT%%" context="#pop"/>
      </context>

      <context name="TypeName" attribute="Normal Text" lineEndContext="#pop" fallthroughContext="#pop">
        <DetectSpaces/>
        <RegExpr attribute="Data Type" String="%%IDENT%%" context="#pop"/>
      </context>

      <context name="Directive" attribute="Directive" lineEndContext="#pop">
        <keyword attribute="Directive Key" String="directives"/>
      </context>

      <context name="LineComment" attribute="Comment" lineEndContext="#pop">
        <DetectSpaces/>
        <IncludeRules context="##Alerts"/>
      </context>

      <context name="BlockComment" attribute="Comment" lineEndContext="#stay">
        <DetectSpaces/>
        <Detect2Chars attribute="Comment" context="#pop" char="*" char1="/" endRegion="Comment"/>
        <IncludeRules context="##Alerts"/>
      </context>

      <context name="String" attribute="String" lineEndContext="#pop">
        <RegExpr attribute="Escape" String="\\(x[0-9A-Fa-f]{2}|u\{[0-9A-Fa-f]+\}|u[0-9A-Fa-f]{4}|[0abfnrtv&quot;'\\])"/>
        <RegExpr attribute="Escape Error" String="\\."/>
        <DetectChar attribute="String" context="#pop" char="&quot;"/>
      </context>

      <context name="TripleString" attribute="String" lineEndContext="#stay">
        <RegExpr attribute="Escape" String="\\(x[0-9A-Fa-f]{2}|u\{[0-9A-Fa-f]+\}|u[0-9A-Fa-f]{4}|[0abfnrtv&quot;'\\])"/>
        <StringDetect attribute="String" context="#pop" String="&quot;&quot;&quot;"/>
      </context>

      <context name="RawString" attribute="String" lineEndContext="#stay">
        <DetectChar attribute="String" context="#pop" char="%%BT%%"/>
      </context>
    </contexts>

    <itemDatas>
      <itemData name="Normal Text"  defStyleNum="dsNormal"/>
      <itemData name="Keyword"      defStyleNum="dsKeyword"/>
      <itemData name="Control Flow" defStyleNum="dsControlFlow"/>
      <itemData name="Data Type"    defStyleNum="dsDataType"/>
      <itemData name="Built-in"     defStyleNum="dsBuiltIn"/>
      <itemData name="Constant"     defStyleNum="dsConstant"/>
      <itemData name="Function"     defStyleNum="dsFunction"/>
      <itemData name="Number"       defStyleNum="dsDecVal"/>
      <itemData name="Float"        defStyleNum="dsFloat"/>
      <itemData name="String"       defStyleNum="dsString"/>
      <itemData name="Char"         defStyleNum="dsChar"/>
      <itemData name="Escape"       defStyleNum="dsSpecialChar"/>
      <itemData name="Escape Error" defStyleNum="dsError"/>
      <itemData name="Comment"      defStyleNum="dsComment"/>
      <itemData name="Directive"    defStyleNum="dsPreprocessor"/>
      <itemData name="Directive Key" defStyleNum="dsAttribute"/>
      <itemData name="Annotation"   defStyleNum="dsAttribute"/>
      <itemData name="Operator"     defStyleNum="dsOperator"/>
      <itemData name="Symbol"       defStyleNum="dsOperator"/>
    </itemDatas>
  </highlighting>

  <general>
    <comments>
      <comment name="singleLine" start="//" position="afterwhitespace"/>
      <comment name="multiLine" start="/*" end="*/" region="Comment"/>
    </comments>
    <keywords casesensitive="1"/>
  </general>
</language>
`

GTK_LANG_TPL := `<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated by extensions/tools/gen_syntaxes.salam -->
<language id="salam" name="Salam" version="2.0" _section="Source">
  <metadata>
    <property name="mimetypes">text/x-salam</property>
    <property name="globs">*.salam</property>
    <property name="line-comment-start">//</property>
    <property name="block-comment-start">/*</property>
    <property name="block-comment-end">*/</property>
  </metadata>

  <styles>
    <style id="comment"        name="Comment"        map-to="def:comment"/>
    <style id="directive"      name="Directive"      map-to="def:preprocessor"/>
    <style id="annotation"     name="Annotation"     map-to="def:preprocessor"/>
    <style id="string"         name="String"         map-to="def:string"/>
    <style id="escape"         name="Escape"         map-to="def:special-char"/>
    <style id="char"           name="Character"      map-to="def:character"/>
    <style id="number"         name="Number"         map-to="def:decimal"/>
    <style id="float"          name="Float"          map-to="def:floating-point"/>
    <style id="keyword"        name="Keyword"        map-to="def:keyword"/>
    <style id="storage"        name="Storage"        map-to="def:keyword"/>
    <style id="type"           name="Type"           map-to="def:type"/>
    <style id="builtin"        name="Builtin"        map-to="def:builtin"/>
    <style id="constant"       name="Constant"       map-to="def:special-constant"/>
    <style id="function"       name="Function"       map-to="def:function"/>
    <style id="operator"       name="Operator"       map-to="def:operator"/>
  </styles>

  <definitions>
    <define-regex id="ident">[%%IDS%%][%%IDC%%]*</define-regex>

    <context id="line-comment" style-ref="comment" end-at-line-end="true" class="comment" class-disabled="no-spell-check">
      <start>//(?!!)</start>
      <include>
        <context ref="def:in-line-comment"/>
      </include>
    </context>

    <context id="directive" style-ref="directive" end-at-line-end="true" class="comment">
      <start>//!</start>
    </context>

    <context id="block-comment" style-ref="comment" class="comment" class-disabled="no-spell-check">
      <start>/\*</start>
      <end>\*/</end>
      <include>
        <context ref="def:in-comment"/>
      </include>
    </context>

    <context id="triple-string" style-ref="string" class="string" class-disabled="no-spell-check">
      <start>"""</start>
      <end>"""</end>
      <include>
        <context ref="escape"/>
      </include>
    </context>

    <context id="string" style-ref="string" end-at-line-end="true" class="string" class-disabled="no-spell-check">
      <start>"</start>
      <end>"</end>
      <include>
        <context ref="escape"/>
      </include>
    </context>

    <context id="raw-string" style-ref="string" class="string" class-disabled="no-spell-check">
      <start>%%BT%%</start>
      <end>%%BT%%</end>
    </context>

    <context id="escape" style-ref="escape">
      <match>\\(x[0-9A-Fa-f]{2}|u\{[0-9A-Fa-f]+\}|u[0-9A-Fa-f]{4}|[0abfnrtv"'\\])</match>
    </context>

    <context id="char" style-ref="char">
      <match>u?'(\\(x[0-9A-Fa-f]{2}|u\{[0-9A-Fa-f]+\}|u[0-9A-Fa-f]{4}|.)|[^'\\])'</match>
    </context>

    <context id="annotation" style-ref="annotation">
      <match>@[A-Za-z_][%%IDC%%]*</match>
    </context>

    <context id="float" style-ref="float">
      <match>%%NBB%%(?:[%%DIGIT%%][%%DIGIT%%_]*\.[%%DIGIT%%][%%DIGIT%%_]*(?:[eE][+-]?[%%DIGIT%%][%%DIGIT%%_]*)?|[%%DIGIT%%][%%DIGIT%%_]*[eE][+-]?[%%DIGIT%%][%%DIGIT%%_]*)f?%%NBA%%</match>
    </context>

    <context id="number" style-ref="number">
      <match>%%NBB%%(?:0[xX][0-9A-Fa-f][0-9A-Fa-f_]*|0[bB][01][01_]*|0[oO][0-7][0-7_]*|[%%DIGIT%%][%%DIGIT%%_]*f?)%%NBA%%</match>
    </context>

    <context id="function-definition">
      <match>(%%NBB%%(?:%%A_FUNCDEF%%)%%NBA%%)\s+(\%{ident})</match>
      <include>
        <context sub-pattern="1" style-ref="storage"/>
        <context sub-pattern="2" style-ref="function"/>
      </include>
    </context>

    <context id="type-definition">
      <match>(%%NBB%%(?:%%A_TYPEDEF%%)%%NBA%%)\s+(\%{ident})</match>
      <include>
        <context sub-pattern="1" style-ref="storage"/>
        <context sub-pattern="2" style-ref="type"/>
      </include>
    </context>

    <context id="control" style-ref="keyword">
      <match>%%NBB%%(?:%%A_CONTROL%%)%%NBA%%</match>
    </context>

    <context id="storage-keywords" style-ref="storage">
      <match>%%NBB%%(?:%%A_STORAGE%%)%%NBA%%</match>
    </context>

    <context id="contextual" style-ref="storage">
      <match>%%NBB%%(?:%%A_CONTEXTUAL%%)%%NBA%%</match>
    </context>

    <context id="word-operator" style-ref="operator">
      <match>%%NBB%%(?:%%A_LOGICAL%%)%%NBA%%</match>
    </context>

    <context id="builtin" style-ref="builtin">
      <match>%%NBB%%(?:%%A_IO%%)%%NBA%%</match>
    </context>

    <context id="constant" style-ref="constant">
      <match>%%NBB%%(?:%%A_CONSTS%%)%%NBA%%</match>
    </context>

    <context id="receiver" style-ref="builtin">
      <match>%%NBB%%(?:%%A_THIS%%)%%NBA%%</match>
    </context>

    <context id="type-names" style-ref="type">
      <match>%%NBB%%(?:%%A_TYPES%%|%%A_INTRTYPES%%|%%A_AUTO%%)%%NBA%%</match>
    </context>

    <context id="salam" class="no-spell-check">
      <include>
        <context ref="directive"/>
        <context ref="line-comment"/>
        <context ref="block-comment"/>
        <context ref="triple-string"/>
        <context ref="string"/>
        <context ref="raw-string"/>
        <context ref="char"/>
        <context ref="annotation"/>
        <context ref="float"/>
        <context ref="number"/>
        <context ref="function-definition"/>
        <context ref="type-definition"/>
        <context ref="control"/>
        <context ref="storage-keywords"/>
        <context ref="contextual"/>
        <context ref="word-operator"/>
        <context ref="builtin"/>
        <context ref="constant"/>
        <context ref="receiver"/>
        <context ref="type-names"/>
      </include>
    </context>
  </definitions>
</language>
`

