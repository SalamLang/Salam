</dict>
</plist>
`

SUBLIME_SYMBOLS_TPL := `<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated by extensions/tools/gen_syntaxes.salam -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
