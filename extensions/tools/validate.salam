package main

import sc "syntaxcheck.salam"
import str
import os
import fmt

const NAME_WIDTH := 52

func note(where: str, detail: str):
    println "  " + fmt.PadRight(where, NAME_WIDTH) + " " + detail
end

func main:
    if !os.IsDir("extensions"):
        printerrln "run me from the repository root"
        os.Exit(2)
    end

    println "editor syntax files"
    note("extensions/vscode/syntaxes/salam.tmLanguage.json",
         sc.CheckTextMate("extensions/vscode/syntaxes/salam.tmLanguage.json"))
    note("extensions/sublime/Salam.sublime-syntax",
         sc.CheckSublimeSyntax("extensions/sublime/Salam.sublime-syntax"))
    note("extensions/kate/salam.xml", sc.CheckKate("extensions/kate/salam.xml"))
    note("extensions/gtksourceview/salam.lang",
         sc.CheckGtkSourceView("extensions/gtksourceview/salam.lang"))
    note("extensions/micro/salam.yaml", sc.CheckMicro("extensions/micro/salam.yaml"))
    note("extensions/nano/salam.nanorc", sc.CheckNano("extensions/nano/salam.nanorc"))
    note("extensions/geany/filetypes.Salam.conf",
         sc.CheckIni("extensions/geany/filetypes.Salam.conf", "keywords", "settings"))
    note("every generated file", sc.CheckGeneratedFiles())

    note("extensions/notepadpp/salam.xml", sc.CheckXmlParses("extensions/notepadpp/salam.xml"))
    note("extensions/jetbrains/Salam.xml", sc.CheckXmlParses("extensions/jetbrains/Salam.xml"))

    note("extensions/sublime/Comments.tmPreferences",
         sc.CheckPlist("extensions/sublime/Comments.tmPreferences"))
    note("extensions/sublime/Indentation Rules.tmPreferences",
         sc.CheckPlist("extensions/sublime/Indentation Rules.tmPreferences"))
    note("extensions/sublime/Symbol List.tmPreferences",
         sc.CheckPlist("extensions/sublime/Symbol List.tmPreferences"))

    mut jsons := Vector {} as Vector<str>
    jsons.push("extensions/sublime/Salam.sublime-build")
    jsons.push("extensions/sublime/Salam.sublime-settings")
    jsons.push("extensions/sublime/Default.sublime-commands")
    jsons.push("extensions/sublime/Salam.sublime-completions")
    jsons.push("extensions/sublime/messages.json")
    jsons.push("extensions/vscode/package.json")
    jsons.push("extensions/vscode/language-configuration.json")
    jsons.push("extensions/vscode/snippets/salam.code-snippets")
    mut i := 0
    until i < jsons.len():
        note(jsons.get(i), sc.CheckJsonParses(jsons.get(i)))
        i += 1
    end
    jsons.free()

    if sc.FailureCount() > 0:
        println ""
        println str.FromInt(sc.FailureCount() as i64) + " problem(s):"
        mut k := 0
        until k < sc.FailureCount():
            println "  " + sc.FailureAt(k)
            k += 1
        end
        os.Exit(1)
    end
    println ""
    println "all editor syntax files are valid"
    os.Exit(0)
end
