include util "util.salam"

component Card:
    n := 0
    box:
        id = "card"
        padding = 8, 16
        button: id = "go" content = "Go" click = (): n++ end end
        paragraph:
            content = n
        end
    end
end

page:
    Card: end
end

struct Point:
    pub x: int = 0
    pub func get(): int:
        ret this.x
    end
end

func main(): int:
    total := 0
    each i, v in vals:
        if v > 1:
            total += v
        else:
            println i
        end
    end
    ret 0
end
