endif

let b:undo_ftplugin = 'setlocal commentstring< comments< suffixesadd<'
      \ . ' includeexpr< formatoptions< expandtab< shiftwidth< softtabstop< tabstop<'
      \ . ' | unlet! b:match_words b:match_ignorecase'

let &cpo = s:cpo_save
unlet s:cpo_save
