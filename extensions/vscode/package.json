{
  "name": "salam-programming-language",
  "displayName": "Salam Programming Language",
  "description": "Language support for Salam (English & Persian): diagnostics as you type, completion, hover, go to definition, references, rename, outline, semantic highlighting and formatting through the Salam language server, plus snippets and build/run integration.",
  "version": "0.5.7",
  "publisher": "salamlanguage",
  "license": "MIT",
  "icon": "icons/salam-icon.png",
  "galleryBanner": {
    "color": "#0B3D2E",
    "theme": "dark"
  },
  "homepage": "https://github.com/SalamLang/Salam",
  "repository": {
    "type": "git",
    "url": "https://github.com/SalamLang/Salam.git",
    "directory": "extensions/vscode"
  },
  "bugs": {
    "url": "https://github.com/SalamLang/Salam/issues"
  },
  "engines": {
    "vscode": "^1.92.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Formatters",
    "Linters"
  ],
  "keywords": [
    "salam",
    "salamlang",
    "persian",
    "farsi",
    "programming language"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "node -e \"require('fs').mkdirSync('out',{recursive:true})\" && salam js src/extension.salam --output=out/extension.js && bun run bundle",
    "compile": "node -e \"require('fs').mkdirSync('out',{recursive:true})\" && salam js src/extension.salam --output=out/extension.js --no-minify --no-js-minify-names",
    "gen-grammar": "cd ../.. && salam exec extensions/tools/gen_syntaxes.salam --timeout=180000",
    "package": "vsce package --no-dependencies",
    "publish": "vsce publish --no-dependencies",
    "bundle": "bun build out/extension.js --target=node --format=cjs --external=vscode --outfile=out/extension.bundle.js && node -e \"require('fs').renameSync('out/extension.bundle.js','out/extension.js')\""
  },
  "devDependencies": {
    "@vscode/vsce": "^4.0.0"
  },
  "contributes": {
    "languages": [
      {
        "id": "salam",
        "aliases": [
          "Salam",
          "salam"
        ],
        "extensions": [
          ".salam"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/salam-file.svg",
          "dark": "./icons/salam-file.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "salam",
        "scopeName": "source.salam",
        "path": "./syntaxes/salam.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "salam",
        "path": "./snippets/salam.code-snippets"
      }
    ],
    "configuration": {
      "title": "Salam",
      "properties": {
        "salam.compilerPath": {
          "type": "string",
          "default": "salam",
          "markdownDescription": "Path to the `salam` compiler executable. If `salam` is on your `PATH`, the default is fine; otherwise set an absolute path."
        },
        "salam.languagePack": {
          "type": "string",
          "enum": [
            "auto",
            "en",
            "fa"
          ],
          "enumDescriptions": [
            "Detect from the file content (Persian script or lang directive)",
            "English keyword pack",
            "Persian keyword pack"
          ],
          "default": "auto",
          "description": "Language pack passed to salam (--lang). 'auto' inspects the file."
        },
        "salam.run.command": {
          "type": "string",
          "enum": [
            "run",
            "exec"
          ],
          "enumDescriptions": [
            "Compile with the C backend and run the executable (needs a C toolchain)",
            "Run with the tree-walking interpreter (no C toolchain required)"
          ],
          "default": "exec",
          "description": "Which salam subcommand the 'Run File' action uses."
        },
        "salam.build.target": {
          "type": "string",
          "default": "",
          "markdownDescription": "Optional LLVM target triple for cross-compilation, passed as `--target` to `salam build` (e.g. `x86_64-pc-windows-msvc`, `wasm32-wasi`). When set, `build` uses the LLVM backend instead of the C backend and needs the LLVM toolchain (clang/llc, plus lld for Windows). Leave empty for a host-native build. Note: the LLVM cross path compiles a single file only (no stdlib auto-include)."
        },
        "salam.format.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable the document formatter (uses 'salam format')."
        },
        "salam.format.indent": {
          "type": "string",
          "default": "4",
          "markdownDescription": "Indentation passed to `salam format --indent`: `tab`, or a number of spaces (1-16)."
        },
        "salam.stdlibPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Optional root directory for `std/...` imports, passed as `--stdlib-path`. Leave empty to use the compiler default."
        },
        "salam.lsp.enable": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Run the Salam language server (`salam lsp`) for diagnostics, completion, hover, navigation, rename and formatting. Needs Salam 0.5.8 or newer."
        },
        "salam.lsp.messages": {
          "type": "string",
          "enum": [
            "auto",
            "en",
            "fa"
          ],
          "enumDescriptions": [
            "Follow the VS Code display language",
            "English messages",
            "Persian messages"
          ],
          "default": "auto",
          "description": "Language of diagnostic messages and hover text from the language server."
        },
        "salam.lsp.formatFixOrder": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Let formatting reorder top-level declarations into the order the compiler requires, like `salam format` does by default."
        },
        "salam.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace the communication between VS Code and the Salam language server."
        },
        "salam.lsp.index": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Analyze every Salam file in the workspace in the background, so references, rename, call hierarchy and code lens reach files that are not open. Skipped for workspaces with more than `salam.lsp.indexMaxFiles` Salam files."
        },
        "salam.lsp.indexMaxFiles": {
          "type": "number",
          "default": 400,
          "description": "Largest number of Salam files the background index will analyze."
        }
      }
    },
    "commands": [
      {
        "command": "salam.run",
        "title": "Salam: Run File",
        "category": "Salam",
        "icon": "$(play)"
      },
      {
        "command": "salam.build",
        "title": "Salam: Build Executable",
        "category": "Salam",
        "icon": "$(tools)"
      },
      {
        "command": "salam.exec",
        "title": "Salam: Run with Interpreter",
        "category": "Salam"
      },
      {
        "command": "salam.format",
        "title": "Salam: Format Document",
        "category": "Salam"
      },
      {
        "command": "salam.emitTokens",
        "title": "Salam: Show Token Stream (XML)",
        "category": "Salam"
      },
      {
        "command": "salam.emitAst",
        "title": "Salam: Show AST (XML)",
        "category": "Salam"
      },
      {
        "command": "salam.newProject",
        "title": "Salam: New Project…",
        "category": "Salam"
      },
      {
        "command": "salam.restartServer",
        "title": "Salam: Restart Language Server",
        "category": "Salam"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "salam.run",
          "when": "resourceLangId == salam",
          "group": "navigation@1"
        }
      ],
      "editor/context": [
        {
          "command": "salam.run",
          "when": "resourceLangId == salam",
          "group": "salam@1"
        },
        {
          "command": "salam.build",
          "when": "resourceLangId == salam",
          "group": "salam@2"
        }
      ],
      "explorer/context": [
        {
          "command": "salam.run",
          "when": "resourceLangId == salam",
          "group": "salam@1"
        }
      ],
      "commandPalette": [
        {
          "command": "salam.run",
          "when": "resourceLangId == salam"
        },
        {
          "command": "salam.build",
          "when": "resourceLangId == salam"
        },
        {
          "command": "salam.exec",
          "when": "resourceLangId == salam"
        },
        {
          "command": "salam.format",
          "when": "resourceLangId == salam"
        },
        {
          "command": "salam.emitTokens",
          "when": "resourceLangId == salam"
        },
        {
          "command": "salam.emitAst",
          "when": "resourceLangId == salam"
        },
        {
          "command": "salam.newProject"
        }
      ]
    },
    "breakpoints": [
      {
        "language": "salam"
      }
    ],
    "debuggers": [
      {
        "type": "salam",
        "label": "Salam",
        "languages": [
          "salam"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "The .salam file (or project folder) to build with debug information and run.",
                "default": "${file}"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Command-line arguments for the program.",
                "default": []
              },
              "cwd": {
                "type": "string",
                "description": "Working directory of the program.",
                "default": "${fileDirname}"
              },
              "stopAtBeginningOfMainSubprogram": {
                "type": "boolean",
                "description": "Stop at the start of main (gdb).",
                "default": false
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Stop at the program entry (lldb-dap).",
                "default": false
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "salam",
            "request": "launch",
            "name": "Debug Salam file",
            "program": "${file}"
          }
        ],
        "configurationSnippets": [
          {
            "label": "Salam: Debug file",
            "description": "Build the current file with debug information and debug it",
            "body": {
              "type": "salam",
              "request": "launch",
              "name": "Debug Salam file",
              "program": "^\"\\${file}\""
            }
          }
        ]
      }
    ]
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
