// Generates the Salam TextMate grammar (source.salam).
// Ported from scripts/gen-grammar.js: builds the same nested grammar
// structure (keyword lists -> kw() word-boundary alternation -> a
// patterns/repository tree), hand-serializes it to compact JSON text via
// the jStr/jFieldStr/jFieldRaw/jObj/jArr helpers below, then reindents it
// with json.IndentWith to match `JSON.stringify(grammar, null, 2)`.
// Run: salam exec scripts/gen_grammar.salam > syntaxes/salam.tmLanguage.json

import str
import json
import sort

// Unicode ranges for Arabic/Persian identifier chars (Arabic, Arabic
// Supplement, Arabic Extended-A, Arabic Presentation Forms A/B, ZWNJ/ZWJ),
// composed the same way as UNI/IDC/IDS/IDENT/NBB/NBA in gen-grammar.js.
IDC := "A-Za-z0-9_\\x{0600}-\\x{06FF}\\x{0750}-\\x{077F}\\x{08A0}-\\x{08FF}\\x{FB50}-\\x{FDFF}\\x{FE70}-\\x{FEFF}\\x{200C}\\x{200D}"
IDENT := "[A-Za-z_\\x{0600}-\\x{06FF}\\x{0750}-\\x{077F}\\x{08A0}-\\x{08FF}\\x{FB50}-\\x{FDFF}\\x{FE70}-\\x{FEFF}\\x{200C}\\x{200D}][A-Za-z0-9_\\x{0600}-\\x{06FF}\\x{0750}-\\x{077F}\\x{08A0}-\\x{08FF}\\x{FB50}-\\x{FDFF}\\x{FE70}-\\x{FEFF}\\x{200C}\\x{200D}]*"
NBB := "(?<![A-Za-z0-9_\\x{0600}-\\x{06FF}\\x{0750}-\\x{077F}\\x{08A0}-\\x{08FF}\\x{FB50}-\\x{FDFF}\\x{FE70}-\\x{FEFF}\\x{200C}\\x{200D}])"
NBA := "(?![A-Za-z0-9_\\x{0600}-\\x{06FF}\\x{0750}-\\x{077F}\\x{08A0}-\\x{08FF}\\x{FB50}-\\x{FDFF}\\x{FE70}-\\x{FEFF}\\x{200C}\\x{200D}])"

// ===== JSON text builders (compact; json.IndentWith reflows it later) =====

func jStr(s: str): str:
    ret "\"".concat(json.Escape(s)).concat("\"")
end

func jFieldStr(key: str, value: str): str:
    ret jStr(key).concat(":").concat(jStr(value))
end

func jFieldRaw(key: str, valueJson: str): str:
    ret jStr(key).concat(":").concat(valueJson)
end

func jObj(fields: Vector<str>): str:
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    str.BufAppendChar(sb, 123)
    repeat fields.len() with i:
        if i > 0: str.BufAppendChar(sb, 44) end
        str.BufAppend(sb, fields.get(i)[0])
    end
    str.BufAppendChar(sb, 125)
    ret str.BufStr(sb)
end

func jArr(items: Vector<str>): str:
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    str.BufAppendChar(sb, 91)
    repeat items.len() with i:
        if i > 0: str.BufAppendChar(sb, 44) end
        str.BufAppend(sb, items.get(i)[0])
    end
    str.BufAppendChar(sb, 93)
    ret str.BufStr(sb)
end

// ===== kw(): sort words by (Unicode) char count descending, stable, then
// wrap in a word-boundary alternation, mirroring gen-grammar.js's kw(). =====

func kwRegex(words: Vector<str>): str:
    mut sorted := Vector {} as Vector<str>
    repeat words.len() with i:
        sorted.push(words.get(i)[0])
    end
    sort.StableSortBy(sorted, (a: str, b: str) => str.CharCount(a) > str.CharCount(b))
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    str.BufAppend(sb, NBB)
    str.BufAppend(sb, "(?:")
    repeat sorted.len() with i:
        if i > 0: str.BufAppendChar(sb, 124) end
        str.BufAppend(sb, sorted.get(i)[0])
    end
    str.BufAppend(sb, ")")
    str.BufAppend(sb, NBA)
    ret str.BufStr(sb)
end

// ===== keyword word lists (English/Persian/Arabic), same content as
// CONTROL/LOGICAL/STORAGE/IO/CONSTS/THIS/AUTO/CONTEXTUAL/TYPES/
// FUNC_DEF_KW/TYPE_DEF_KW in gen-grammar.js =====

func vec_control(): Vector<str>:
    mut v := Vector {} as Vector<str>
    v.push("if") v.push("else") v.push("until") v.push("each") v.push("in") v.push("with")
    v.push("ret") v.push("break") v.push("continue") v.push("repeat") v.push("to") v.push("by")
    v.push("defer") v.push("end") v.push("اگر") v.push("وگرنه") v.push("تاوقتی") v.push("هر")
    v.push("در") v.push("با") v.push("بازگشت") v.push("بشکن") v.push("ادامه") v.push("تکرار")
    v.push("تا") v.push("گام") v.push("تعلیق") v.push("تمام") v.push("إذا") v.push("وإلا")
    v.push("بينما") v.push("كل") v.push("في") v.push("مع") v.push("أرجع") v.push("اكسر")
    v.push("واصل") v.push("كرر") v.push("إلى") v.push("خطوة") v.push("أجل") v.push("نهاية")
    ret v
end

func vec_logical(): Vector<str>:
    mut v := Vector {} as Vector<str>
    v.push("و") v.push("یا") v.push("أو")
    ret v
end

func vec_storage(): Vector<str>:
    mut v := Vector {} as Vector<str>
    v.push("func") v.push("mut") v.push("const") v.push("type") v.push("struct") v.push("enum")
    v.push("interface") v.push("impl") v.push("on") v.push("بر") v.push("على") v.push("package")
    v.push("import") v.push("as") v.push("pub") v.push("inline") v.push("noinline") v.push("pure")
    v.push("noret") v.push("deprecated") v.push("component") v.push("layout") v.push("operator") v.push("extern")
    v.push("تابع") v.push("متغیر") v.push("ثابت") v.push("نوع") v.push("ساختار") v.push("شمارش")
    v.push("واسط") v.push("پیاده‌سازی") v.push("بسته") v.push("واردکردن") v.push("بعنوان") v.push("عمومی")
    v.push("درون‌خطی") v.push("غیردرون‌خطی") v.push("خالص") v.push("بی‌بازگشت") v.push("منسوخ") v.push("مولفه")
    v.push("صفحه") v.push("عملگر") v.push("خارجی") v.push("دالة") v.push("متغير") v.push("بنية")
    v.push("تعداد") v.push("واجهة") v.push("تنفيذ") v.push("حزمة") v.push("استيراد") v.push("بوصفه")
    v.push("عام") v.push("مضمن") v.push("غيرمضمن") v.push("نقي") v.push("لايرجع") v.push("مهجور")
    v.push("مكون") v.push("صفحة") v.push("عامل") v.push("خارجي")
    ret v
end

func vec_io(): Vector<str>:
    mut v := Vector {} as Vector<str>
    v.push("printerrln") v.push("printerr") v.push("println") v.push("print") v.push("input") v.push("خطاچاپ")
    v.push("خطابنویس") v.push("چاپ") v.push("بنویس") v.push("بخوان") v.push("اطبعخطأ") v.push("اكتبخطأ")
    v.push("اطبع") v.push("اكتب") v.push("اقرأ")
    ret v
end

func vec_consts(): Vector<str>:
    mut v := Vector {} as Vector<str>
    v.push("true") v.push("false") v.push("null") v.push("درست") v.push("نادرست") v.push("پوچ")
    v.push("صواب") v.push("خطأ") v.push("عدم")
    ret v
end

func vec_this(): Vector<str>:
    mut v := Vector {} as Vector<str>
    v.push("this") v.push("این") v.push("هذا")
    ret v
end

func vec_auto(): Vector<str>:
    mut v := Vector {} as Vector<str>
    v.push("auto") v.push("خودکار") v.push("تلقائي")
    ret v
end

func vec_contextual(): Vector<str>:
    mut v := Vector {} as Vector<str>
    v.push("link") v.push("static") v.push("dynamic") v.push("framework") v.push("kind") v.push("dyn")
    v.push("پیوند") v.push("ایستا") v.push("پویا") v.push("چارچوب") v.push("گونه") v.push("رابط")
    v.push("ساكن") v.push("ديناميكي") v.push("إطار") v.push("صنف")
    ret v
end

func vec_types(): Vector<str>:
    mut v := Vector {} as Vector<str>
    v.push("i8") v.push("i16") v.push("i32") v.push("i64") v.push("u8") v.push("u16")
    v.push("u32") v.push("u64") v.push("f32") v.push("f64") v.push("isize") v.push("usize")
    v.push("bool") v.push("str") v.push("char") v.push("void") v.push("صحیح۸") v.push("صحیح۱۶")
    v.push("صحیح۳۲") v.push("صحیح۶۴") v.push("اعشار۳۲") v.push("اعشار۶۴") v.push("رشته") v.push("منطقی")
    v.push("بایت") v.push("کاراکتر") v.push("صحيح٨") v.push("صحيح١٦") v.push("صحيح٣٢") v.push("صحيح٦٤")
    v.push("صحيح") v.push("طبيعي٨") v.push("طبيعي١٦") v.push("طبيعي٣٢") v.push("طبيعي٦٤") v.push("طبيعي")
    v.push("عشري٣٢") v.push("عشري٦٤") v.push("عشري") v.push("نص") v.push("منطقي") v.push("حرف")
    v.push("فراغ") v.push("يونيكود")
    ret v
end

func vec_func_def_kw(): Vector<str>:
    mut v := Vector {} as Vector<str>
    v.push("func") v.push("تابع") v.push("دالة")
    ret v
end

func vec_type_def_kw(): Vector<str>:
    mut v := Vector {} as Vector<str>
    v.push("type") v.push("struct") v.push("enum") v.push("interface") v.push("component") v.push("package")
    v.push("نوع") v.push("ساختار") v.push("شمارش") v.push("واسط") v.push("مولفه") v.push("بسته")
    v.push("بنية") v.push("تعداد") v.push("واجهة") v.push("مكون") v.push("حزمة")
    ret v
end


// ===== grammar assembly: mirrors the `grammar` object literal in
// gen-grammar.js field-for-field, key order preserved. =====

func buildGrammar(controlRe: str, logicalRe: str, storageRe: str, ioRe: str, constsRe: str, thisRe: str, autoRe: str, typesRe: str, contextualRe: str, funcDefRe: str, typeDefRe: str): str:
    mut f0 := Vector {} as Vector<str>
    f0.push(jFieldStr("match", "\\b(mode|title|lang|dir|name|version)\\b"))
    f0.push(jFieldStr("name", "keyword.other.directive.salam"))
    o1 := jObj(f0)
    mut f2 := Vector {} as Vector<str>
    f2.push(jFieldStr("match", "\\|"))
    f2.push(jFieldStr("name", "punctuation.separator.directive.salam"))
    o3 := jObj(f2)
    mut a4 := Vector {} as Vector<str>
    a4.push(o1)
    a4.push(o3)
    r5 := jArr(a4)
    mut f6 := Vector {} as Vector<str>
    f6.push(jFieldStr("name", "punctuation.definition.comment.salam"))
    o7 := jObj(f6)
    mut f8 := Vector {} as Vector<str>
    f8.push(jFieldRaw("0", o7))
    o9 := jObj(f8)
    mut f10 := Vector {} as Vector<str>
    f10.push(jFieldStr("name", "comment.line.directive.salam"))
    f10.push(jFieldStr("begin", "//!"))
    f10.push(jFieldRaw("beginCaptures", o9))
    f10.push(jFieldStr("end", "$"))
    f10.push(jFieldRaw("patterns", r5))
    o11 := jObj(f10)
    mut a12 := Vector {} as Vector<str>
    a12.push(o11)
    r13 := jArr(a12)
    mut f14 := Vector {} as Vector<str>
    f14.push(jFieldRaw("patterns", r13))
    o15 := jObj(f14)
    directives := o15

    mut f16 := Vector {} as Vector<str>
    f16.push(jFieldStr("name", "punctuation.definition.comment.salam"))
    o17 := jObj(f16)
    mut f18 := Vector {} as Vector<str>
    f18.push(jFieldRaw("0", o17))
    o19 := jObj(f18)
    mut f20 := Vector {} as Vector<str>
    f20.push(jFieldStr("name", "punctuation.definition.comment.salam"))
    o21 := jObj(f20)
    mut f22 := Vector {} as Vector<str>
    f22.push(jFieldRaw("0", o21))
    o23 := jObj(f22)
    mut f24 := Vector {} as Vector<str>
    f24.push(jFieldStr("name", "comment.block.salam"))
    f24.push(jFieldStr("begin", "/\\*"))
    f24.push(jFieldRaw("beginCaptures", o19))
    f24.push(jFieldStr("end", "\\*/"))
    f24.push(jFieldRaw("endCaptures", o23))
    o25 := jObj(f24)
    mut f26 := Vector {} as Vector<str>
    f26.push(jFieldStr("name", "punctuation.definition.comment.salam"))
    o27 := jObj(f26)
    mut f28 := Vector {} as Vector<str>
    f28.push(jFieldRaw("0", o27))
    o29 := jObj(f28)
    mut f30 := Vector {} as Vector<str>
    f30.push(jFieldStr("name", "comment.line.double-slash.salam"))
    f30.push(jFieldStr("begin", "//"))
    f30.push(jFieldRaw("beginCaptures", o29))
    f30.push(jFieldStr("end", "$"))
    o31 := jObj(f30)
    mut a32 := Vector {} as Vector<str>
    a32.push(o25)
    a32.push(o31)
    r33 := jArr(a32)
    mut f34 := Vector {} as Vector<str>
    f34.push(jFieldRaw("patterns", r33))
    o35 := jObj(f34)
    comments := o35

    mut f36 := Vector {} as Vector<str>
    f36.push(jFieldStr("name", "punctuation.definition.annotation.salam"))
    o37 := jObj(f36)
    mut f38 := Vector {} as Vector<str>
    f38.push(jFieldStr("name", "storage.modifier.annotation.salam"))
    o39 := jObj(f38)
    mut f40 := Vector {} as Vector<str>
    f40.push(jFieldRaw("1", o37))
    f40.push(jFieldRaw("2", o39))
    o41 := jObj(f40)
    mut f42 := Vector {} as Vector<str>
    f42.push(jFieldRaw("match", jStr("(@)([A-Za-z_][".concat(IDC).concat("]*)"))))
    f42.push(jFieldRaw("captures", o41))
    o43 := jObj(f42)
    mut a44 := Vector {} as Vector<str>
    a44.push(o43)
    r45 := jArr(a44)
    mut f46 := Vector {} as Vector<str>
    f46.push(jFieldRaw("patterns", r45))
    o47 := jObj(f46)
    metaAnnotations := o47

    mut f48 := Vector {} as Vector<str>
    f48.push(jFieldStr("name", "punctuation.definition.string.begin.salam"))
    o49 := jObj(f48)
    mut f50 := Vector {} as Vector<str>
    f50.push(jFieldRaw("0", o49))
    o51 := jObj(f50)
    mut f52 := Vector {} as Vector<str>
    f52.push(jFieldStr("name", "punctuation.definition.string.end.salam"))
    o53 := jObj(f52)
    mut f54 := Vector {} as Vector<str>
    f54.push(jFieldRaw("0", o53))
    o55 := jObj(f54)
    mut f56 := Vector {} as Vector<str>
    f56.push(jFieldStr("include", "#string-escapes"))
    o57 := jObj(f56)
    mut a58 := Vector {} as Vector<str>
    a58.push(o57)
    r59 := jArr(a58)
    mut f60 := Vector {} as Vector<str>
    f60.push(jFieldStr("name", "string.quoted.triple.salam"))
    f60.push(jFieldStr("begin", "\"\"\""))
    f60.push(jFieldStr("end", "\"\"\""))
    f60.push(jFieldRaw("beginCaptures", o51))
    f60.push(jFieldRaw("endCaptures", o55))
    f60.push(jFieldRaw("patterns", r59))
    o61 := jObj(f60)
    mut f62 := Vector {} as Vector<str>
    f62.push(jFieldStr("name", "punctuation.definition.string.begin.salam"))
    o63 := jObj(f62)
    mut f64 := Vector {} as Vector<str>
    f64.push(jFieldRaw("0", o63))
    o65 := jObj(f64)
    mut f66 := Vector {} as Vector<str>
    f66.push(jFieldStr("name", "punctuation.definition.string.end.salam"))
    o67 := jObj(f66)
    mut f68 := Vector {} as Vector<str>
    f68.push(jFieldRaw("0", o67))
    o69 := jObj(f68)
    mut f70 := Vector {} as Vector<str>
    f70.push(jFieldStr("include", "#string-escapes"))
    o71 := jObj(f70)
    mut f72 := Vector {} as Vector<str>
    f72.push(jFieldStr("name", "invalid.illegal.newline.salam"))
    f72.push(jFieldStr("match", "\\n"))
    o73 := jObj(f72)
    mut a74 := Vector {} as Vector<str>
    a74.push(o71)
    a74.push(o73)
    r75 := jArr(a74)
    mut f76 := Vector {} as Vector<str>
    f76.push(jFieldStr("name", "string.quoted.double.salam"))
    f76.push(jFieldStr("begin", "\""))
    f76.push(jFieldStr("end", "\""))
    f76.push(jFieldRaw("beginCaptures", o65))
    f76.push(jFieldRaw("endCaptures", o69))
    f76.push(jFieldRaw("patterns", r75))
    o77 := jObj(f76)
    mut f78 := Vector {} as Vector<str>
    f78.push(jFieldStr("name", "punctuation.definition.string.begin.salam"))
    o79 := jObj(f78)
    mut f80 := Vector {} as Vector<str>
    f80.push(jFieldRaw("0", o79))
    o81 := jObj(f80)
    mut f82 := Vector {} as Vector<str>
    f82.push(jFieldStr("name", "punctuation.definition.string.end.salam"))
    o83 := jObj(f82)
    mut f84 := Vector {} as Vector<str>
    f84.push(jFieldRaw("0", o83))
    o85 := jObj(f84)
    mut f86 := Vector {} as Vector<str>
    f86.push(jFieldStr("name", "string.quoted.raw.salam"))
    f86.push(jFieldStr("begin", "`"))
    f86.push(jFieldStr("end", "`"))
    f86.push(jFieldRaw("beginCaptures", o81))
    f86.push(jFieldRaw("endCaptures", o85))
    o87 := jObj(f86)
    mut f88 := Vector {} as Vector<str>
    f88.push(jFieldStr("name", "string.quoted.single.salam"))
    f88.push(jFieldRaw("match", jStr(NBB.concat("u?'(\\\\(?:x[0-9A-Fa-f]{2}|u\\{[0-9A-Fa-f]+\\}|u[0-9A-Fa-f]{4}|.)|[^'\\\\])'"))))
    o89 := jObj(f88)
    mut a90 := Vector {} as Vector<str>
    a90.push(o61)
    a90.push(o77)
    a90.push(o87)
    a90.push(o89)
    r91 := jArr(a90)
    mut f92 := Vector {} as Vector<str>
    f92.push(jFieldRaw("patterns", r91))
    o93 := jObj(f92)
    stringsRepo := o93

    mut f94 := Vector {} as Vector<str>
    f94.push(jFieldStr("name", "constant.character.escape.salam"))
    f94.push(jFieldStr("match", "\\\\(?:x[0-9A-Fa-f]{2}|u\\{[0-9A-Fa-f]+\\}|u[0-9A-Fa-f]{4}|[0abfnrtv\"'\\\\])"))
    o95 := jObj(f94)
    mut f96 := Vector {} as Vector<str>
    f96.push(jFieldStr("name", "invalid.illegal.unknown-escape.salam"))
    f96.push(jFieldStr("match", "\\\\."))
    o97 := jObj(f96)
    mut a98 := Vector {} as Vector<str>
    a98.push(o95)
    a98.push(o97)
    r99 := jArr(a98)
    mut f100 := Vector {} as Vector<str>
    f100.push(jFieldRaw("patterns", r99))
    o101 := jObj(f100)
    stringEscapes := o101

    mut f102 := Vector {} as Vector<str>
    f102.push(jFieldStr("name", "constant.numeric.float.salam"))
    f102.push(jFieldRaw("match", jStr(NBB.concat("(?:[0-9][0-9_]*\\.[0-9][0-9_]*(?:[eE][+-]?[0-9][0-9_]*)?|[0-9][0-9_]*[eE][+-]?[0-9][0-9_]*)f?").concat(NBA))))
    o103 := jObj(f102)
    mut f104 := Vector {} as Vector<str>
    f104.push(jFieldStr("name", "constant.numeric.hex.salam"))
    f104.push(jFieldRaw("match", jStr(NBB.concat("0[xX][0-9A-Fa-f][0-9A-Fa-f_]*").concat(NBA))))
    o105 := jObj(f104)
    mut f106 := Vector {} as Vector<str>
    f106.push(jFieldStr("name", "constant.numeric.binary.salam"))
    f106.push(jFieldRaw("match", jStr(NBB.concat("0[bB][01][01_]*").concat(NBA))))
    o107 := jObj(f106)
    mut f108 := Vector {} as Vector<str>
    f108.push(jFieldStr("name", "constant.numeric.octal.salam"))
    f108.push(jFieldRaw("match", jStr(NBB.concat("0[oO][0-7][0-7_]*").concat(NBA))))
    o109 := jObj(f108)
    mut f110 := Vector {} as Vector<str>
    f110.push(jFieldStr("name", "constant.numeric.integer.salam"))
    f110.push(jFieldRaw("match", jStr(NBB.concat("[0-9][0-9_]*f?").concat(NBA))))
    o111 := jObj(f110)
    mut a112 := Vector {} as Vector<str>
    a112.push(o103)
    a112.push(o105)
    a112.push(o107)
    a112.push(o109)
    a112.push(o111)
    r113 := jArr(a112)
    mut f114 := Vector {} as Vector<str>
    f114.push(jFieldRaw("patterns", r113))
    o115 := jObj(f114)
    numbersRepo := o115

    mut f116 := Vector {} as Vector<str>
    f116.push(jFieldStr("name", "storage.type.function.salam keyword.declaration.function.salam"))
    o117 := jObj(f116)
    mut f118 := Vector {} as Vector<str>
    f118.push(jFieldStr("name", "entity.name.function.salam"))
    o119 := jObj(f118)
    mut f120 := Vector {} as Vector<str>
    f120.push(jFieldRaw("1", o117))
    f120.push(jFieldRaw("2", o119))
    o121 := jObj(f120)
    mut f122 := Vector {} as Vector<str>
    f122.push(jFieldRaw("match", jStr("(".concat(funcDefRe).concat(")\\s+(").concat(IDENT).concat(")"))))
    f122.push(jFieldRaw("captures", o121))
    o123 := jObj(f122)
    mut f124 := Vector {} as Vector<str>
    f124.push(jFieldStr("name", "storage.type.salam keyword.declaration.type.salam"))
    o125 := jObj(f124)
    mut f126 := Vector {} as Vector<str>
    f126.push(jFieldStr("name", "entity.name.type.salam"))
    o127 := jObj(f126)
