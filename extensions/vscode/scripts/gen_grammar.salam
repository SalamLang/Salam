func main:
    controlRe := kwRegex(vec_control())
    logicalRe := kwRegex(vec_logical())
    storageRe := kwRegex(vec_storage())
    ioRe := kwRegex(vec_io())
    constsRe := kwRegex(vec_consts())
    thisRe := kwRegex(vec_this())
    autoRe := kwRegex(vec_auto())
    typesRe := kwRegex(vec_types())
    contextualRe := kwRegex(vec_contextual())
    funcDefRe := kwRegex(vec_func_def_kw())
    typeDefRe := kwRegex(vec_type_def_kw())

    compact := buildGrammar(controlRe, logicalRe, storageRe, ioRe, constsRe, thisRe, autoRe, typesRe, contextualRe, funcDefRe, typeDefRe)
    pretty := json.IndentWith(compact, "  ")
    println pretty
end
