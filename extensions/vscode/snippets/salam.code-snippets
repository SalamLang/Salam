{
  "Entry point (main)": {
    "prefix": [
      "main",
      "تابع اصلی"
    ],
    "body": [
      "func main:",
      "\t$0",
      "end"
    ],
    "description": "Program entry point"
  },
  "Function": {
    "prefix": [
      "func",
      "تابع"
    ],
    "body": [
      "func ${1:name}(${2:params}) : ${3:ret_type}:",
      "\t$0",
      "end"
    ],
    "description": "Function declaration with return type"
  },
  "Function (no return type)": {
    "prefix": [
      "funcv",
      "تابع بدون خروجی"
    ],
    "body": [
      "func ${1:name}(${2:params}):",
      "\t$0",
      "end"
    ],
    "description": "Function declaration without a return type"
  },
  "Public function": {
    "prefix": [
      "pubfunc",
      "تابع همگانی"
    ],
    "body": [
      "pub func ${1:name}(${2:params}) : ${3:ret_type}:",
      "\t$0",
      "end"
    ],
    "description": "Public function declaration"
  },
  "Method (on type)": {
    "prefix": [
      "method",
      "متد"
    ],
    "body": [
      "func ${1:Type}.${2:name}(${3:params}) : ${4:ret_type}:",
      "\t$0",
      "end"
    ],
    "description": "Method declaration on a type"
  },
  "If": {
    "prefix": [
      "if",
      "اگر"
    ],
    "body": [
      "if ${1:condition}:",
      "\t$0",
      "end"
    ],
    "description": "If statement"
  },
  "If / else": {
    "prefix": [
      "ifelse",
      "اگر وگرنه"
    ],
    "body": [
      "if ${1:condition}:",
      "\t$2",
      "else:",
      "\t$0",
      "end"
    ],
    "description": "If / else statement"
  },
  "If / else if / else": {
    "prefix": [
      "ifelif",
      "اگر وگرنه اگر"
    ],
    "body": [
      "if ${1:condition}:",
      "\t$2",
      "else ${3:other_condition}:",
      "\t$4",
      "else:",
      "\t$0",
      "end"
    ],
    "description": "If / else-if / else chain"
  },
  "Match": {
    "prefix": [
      "match",
      "همخوان"
    ],
    "body": [
      "match ${1:value}:",
      "\t${2:pattern}:",
      "\t\t$3",
      "\telse:",
      "\t\t$0",
      "end"
    ],
    "description": "Match expression/statement"
  },
  "Switch": {
    "prefix": [
      "switch",
      "ترابرد"
    ],
    "body": [
      "switch ${1:value}:",
      "\t${2:case}:",
      "\t\t$3",
      "\telse:",
      "\t\t$0",
      "end"
    ],
    "description": "Switch statement"
  },
  "Until (conditional loop)": {
    "prefix": [
      "until",
      "تا"
    ],
    "body": [
      "until ${1:condition}:",
      "\t$0",
      "end"
    ],
    "description": "Conditional loop (runs while the condition holds)"
  },
  "Each (array/vector)": {
    "prefix": [
      "each",
      "هر"
    ],
    "body": [
      "each ${1:item} in ${2:items}:",
      "\t$0",
      "end"
    ],
    "description": "Iterate the elements of an array or vector"
  },
  "Each with index": {
    "prefix": [
      "eachi",
      "هر با نمایه"
    ],
    "body": [
      "each ${1:i}, ${2:item} in ${3:items}:",
      "\t$0",
      "end"
    ],
    "description": "Iterate with an index binding"
  },
  "Each (hashmap)": {
    "prefix": [
      "eachkv",
      "هر کلید مقدار"
    ],
    "body": [
      "each ${1:key}, ${2:value} in ${3:map}:",
      "\t$0",
      "end"
    ],
    "description": "Iterate the entries of a HashMap"
  },
  "Repeat N": {
    "prefix": [
      "repeat",
      "تکرار"
    ],
    "body": [
      "repeat ${1:n}:",
      "\t$0",
      "end"
    ],
    "description": "Counted repeat loop"
  },
  "Repeat N with index": {
    "prefix": [
      "repeati",
      "تکرار با نمایه"
    ],
    "body": [
      "repeat ${1:n} in ${2:i}:",
      "\t$0",
      "end"
    ],
    "description": "Counted repeat loop with an index binding"
  },
  "Repeat range": {
    "prefix": [
      "repeatrange",
      "تکرار بازه"
    ],
    "body": [
      "repeat ${1:1} to ${2:10}${3: by ${4:2}} in ${5:i}:",
      "\t$0",
      "end"
    ],
    "description": "Repeat over an inclusive range with an optional step"
  },
  "Break": {
    "prefix": [
      "break",
      "بشکن"
    ],
    "body": [
      "break"
    ],
    "description": "Break out of the current loop"
  },
  "Continue": {
    "prefix": [
      "continue",
      "گذر"
    ],
    "body": [
      "continue"
    ],
    "description": "Continue to the next loop iteration"
  },
  "Return": {
    "prefix": [
      "ret",
      "برگشت"
    ],
    "body": [
      "ret ${1:value}"
    ],
    "description": "Return a value"
  },
  "Defer": {
    "prefix": [
      "defer",
      "دیرکن"
    ],
    "body": [
      "defer ${1:expr}"
    ],
    "description": "Defer execution until scope exit"
  },
  "Variable": {
    "prefix": [
      "var",
      "متغیر"
    ],
    "body": [
      "${1:name} := ${2:value}"
    ],
    "description": "Immutable variable declaration with inference"
  },
  "Mutable variable": {
    "prefix": [
      "mut",
      "ناپایا"
    ],
    "body": [
      "mut ${1:name} := ${2:value}"
    ],
    "description": "Mutable variable declaration with inference"
  },
  "Typed mutable variable": {
    "prefix": [
      "muttyped",
      "ناپایا گونه‌دار"
    ],
    "body": [
      "mut ${1:name} : ${2:type} = ${3:value}"
    ],
    "description": "Mutable variable with explicit type"
  },
  "Constant": {
    "prefix": [
      "const",
      "پایا"
    ],
    "body": [
      "const ${1:NAME} := ${2:value}"
    ],
    "description": "Constant declaration"
  },
  "Struct": {
    "prefix": [
      "struct",
      "ساختار"
    ],
    "body": [
      "struct ${1:Name}:",
      "\t${2:field} : ${3:type} = ${4:value}",
      "\t$0",
      "end"
    ],
    "description": "Struct definition"
  },
  "Struct (with methods)": {
    "prefix": [
      "structm",
      "ساختار با متد"
    ],
    "body": [
      "struct ${1:Name}:",
      "\t${2:field} : ${3:type} = ${4:value}",
      "",
      "\tfunc ${5:method}() : ${6:ret_type}:",
      "\t\t$0",
      "\tend",
      "end"
    ],
    "description": "Struct definition with a method"
  },
  "Enum": {
    "prefix": [
      "enum",
      "جداشمار"
    ],
    "body": [
      "enum ${1:Name}:",
      "\t${2:Variant}",
      "\t$0",
      "end"
    ],
    "description": "Enum definition"
  },
  "Type alias": {
    "prefix": [
      "type",
      "گونه"
    ],
    "body": [
      "type ${1:Name} = ${2:Target}"
    ],
    "description": "Type alias"
  },
  "Interface": {
    "prefix": [
      "interface",
      "میانجی"
    ],
    "body": [
      "interface ${1:Name}:",
      "\tfunc ${2:method}(${3:params}) : ${4:ret_type}",
      "\t$0",
      "end"
    ],
    "description": "Interface (behavioral contract)"
  },
  "Impl block": {
    "prefix": [
      "impl",
      "کاربست"
    ],
    "body": [
      "impl ${1:Interface} on ${2:Type}:",
      "\t$0",
      "end"
    ],
    "description": "Interface implementation block"
  },
  "Component": {
    "prefix": [
      "component",
      "بخش"
    ],
    "body": [
      "component ${1:Name}(${2:params}):",
      "\t$0",
      "end"
    ],
    "description": "Reusable layout component"
  },
  "Layout page": {
    "prefix": [
      "layout",
      "صفحه"
    ],
    "body": [
      "layout:",
      "\ttitle = \"${1:My Page}\"",
      "\t$0",
      "end"
    ],
    "description": "Layout (web page) block"
  },
  "Import": {
    "prefix": [
      "import",
      "واردسازی"
    ],
    "body": [
      "import ${1:io}"
    ],
    "description": "Import a library by name"
  },
  "Import as": {
    "prefix": [
      "importas",
      "واردسازی به عنوان"
    ],
    "body": [
      "import ${1:module} as ${2:alias}"
    ],
    "description": "Import a library with an alias"
  },
  "Include": {
    "prefix": [
      "include",
      "فراخوانی"
    ],
    "body": [
      "include \"${1:util}.salam\""
    ],
    "description": "Include one of your own source files"
  },
  "Package": {
    "prefix": [
      "package",
      "بسته"
    ],
    "body": [
      "package ${1:name}"
    ],
    "description": "Declare package/module name"
  },
  "Extern block": {
    "prefix": [
      "extern",
      "درون‌داد"
    ],
    "body": [
      "extern:",
      "\tfunc ${1:symbol}(${2:args}) : ${3:ret}",
      "\t$0",
      "end"
    ],
    "description": "FFI extern block"
  },
  "Export block": {
    "prefix": [
      "export",
      "برون‌داد"
    ],
    "body": [
      "export:",
      "\tfunc ${1:symbol}(${2:args}) : ${3:ret}:",
      "\t\t$0",
      "\tend",
      "end"
    ],
    "description": "Export Salam functions to C under their plain name"
  },
  "Try / catch": {
    "prefix": [
      "try",
      "تلاش"
    ],
    "body": [
      "try:",
      "\t$1",
      "catch ${2:err}:",
      "\t$0",
      "end"
    ],
    "description": "Try/catch error handling"
  },
  "Throw": {
    "prefix": [
      "throw",
      "پرتاب خطا"
    ],
    "body": [
      "throw ${1:error}"
    ],
    "description": "Throw an error"
  },
  "Print": {
    "prefix": [
      "print",
      "چاپ"
    ],
    "body": [
      "print ${1:\"text\"}"
    ],
    "description": "Print to stdout"
  },
  "Print line": {
    "prefix": [
      "println",
      "سرچاپ"
    ],
    "body": [
      "println ${1:\"text\"}"
    ],
    "description": "Print a line to stdout"
  },
  "Print formatted": {
    "prefix": [
      "printfmt",
      "چاپ قالبی"
    ],
    "body": [
      "println \"${1:text} {${2:value}}\""
    ],
    "description": "Print a formatted string with interpolation"
  },
  "Vector": {
    "prefix": [
      "vector",
      "وکتور"
    ],
    "body": [
      "mut ${1:v} := Vector {} as Vector<${2:type}>",
      "$0"
    ],
    "description": "Create a typed Vector"
  },
  "HashMap": {
    "prefix": [
      "hashmap",
      "نگاشت"
    ],
    "body": [
      "mut ${1:m} := HashMap {} as HashMap<${2:K}, ${3:V}>",
      "$0"
    ],
    "description": "Create a typed HashMap"
  },
  "For-each over vector": {
    "prefix": [
      "foreachvec",
      "پیمایش وکتور"
    ],
    "body": [
      "each ${1:item} in ${2:vec}:",
      "\t$0",
      "end"
    ],
    "description": "Iterate over a Vector"
  },
  "Doc comment (en/fa)": {
    "prefix": [
      "doc",
      "توضیح"
    ],
    "body": [
      "@en \"${1:English description}\"",
      "@fa \"${2:توضیح فارسی}\""
    ],
    "description": "Bilingual documentation annotations"
  },
  "Block comment": {
    "prefix": [
      "comment",
      "یادداشت"
    ],
    "body": [
      "/*",
      " * $0",
      " */"
    ],
    "description": "Block comment"
  },
  "TODO comment": {
    "prefix": "todo",
    "body": [
      "// TODO: $0"
    ],
    "description": "TODO comment"
  },
  "FIXME comment": {
    "prefix": "fixme",
    "body": [
      "// FIXME: $0"
    ],
    "description": "FIXME comment"
  },
  "Else if": {
    "prefix": [
      "elif",
      "elseif",
      "وگرنه اگر"
    ],
    "body": [
      "else ${1:condition}:",
      "\t$0"
    ],
    "description": "Else-if branch (inside if block)"
  },
  "Else": {
    "prefix": [
      "else",
      "وگرنه"
    ],
    "body": [
      "else:",
      "\t$0"
    ],
    "description": "Else branch (inside if/match/switch block)"
  },
  "Match arm": {
    "prefix": [
      "case",
      "حالت"
    ],
    "body": [
      "${1:pattern}:",
      "\t$0"
    ],
    "description": "Match/switch case arm"
  },
  "Function with doc (en/fa)": {
    "prefix": [
      "funcdoc",
      "تابع مستند"
    ],
    "body": [
      "@en \"${1:Description}\"",
      "@fa \"${2:توضیح}\"",
      "func ${3:name}(${4:params}) : ${5:ret_type}:",
      "\t$0",
      "end"
    ],
    "description": "Documented function declaration"
  },
  "Struct field": {
    "prefix": [
      "field",
      "فیلد"
    ],
    "body": [
      "${1:name} : ${2:type} = ${3:value}"
    ],
    "description": "Struct field declaration"
  }
}
