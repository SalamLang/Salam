/*
 * Salam Programming Language - VS Code extension host API interop.
 *
 * Project-local (not std/): this is a wrapper around one specific product's
 * API, not a general-purpose language facility, so it lives with the
 * extension that uses it rather than in the stdlib.
 *
 * Pure vocabulary layer over std/node's generic FFI (GetProp, SetProp,
 * the CallN/NewN/InvokeN family) - no extern declarations and no low-level
 * JS-bridging logic of its own, so there is exactly one place (std/node)
 * that knows how to reach into an arbitrary JS value.
 */

package vscode

import node

vsc := node.Require("vscode")

func vsc_ns(name: str): i64: ret node.GetProp(vsc, name) end

// ---- output channel / terminal --------------------------------------------

@fa "ساخت کانال خروجی"
@ar "إنشاء قناة الإخراج"
pub func CreateOutputChannel(name: str): i64: ret node.CallS1(vsc_ns("window"), "createOutputChannel", name) end

@fa "افزودن خط"
@ar "إضافة سطر"
pub func AppendLine(ch: i64, text: str): node.CallS1(ch, "appendLine", text) end

@fa "نمایش کانال"
@ar "عرض القناة"
pub func ShowOutputChannel(ch: i64): node.CallB1(ch, "show", true) end

@fa "ساخت پایانه"
@ar "إنشاء الطرفية"
pub func CreateTerminal(name: str): i64: ret node.CallS1(vsc_ns("window"), "createTerminal", name) end

@fa "نمایش پایانه"
@ar "عرض الطرفية"
pub func ShowTerminal(term: i64): node.CallB1(term, "show", true) end

@fa "ارسال متن"
@ar "إرسال النص"
pub func SendText(term: i64, text: str): node.CallS1(term, "sendText", text) end

@fa "پایانه پایان یافته"
@ar "انتهت الطرفية"
pub func TerminalHasExited(term: i64): bool: ret !node.IsNullish(node.GetProp(term, "exitStatus")) end

@fa "هنگام بستن پایانه"
@ar "عند إغلاق الطرفية"
pub func OnDidCloseTerminal(cb: func (i64)): i64: ret node.CallFn1(vsc_ns("window"), "onDidCloseTerminal", cb) end

@fa "دور انداختن"
@ar "التخلص"
pub func Dispose(h: i64): node.Call0(h, "dispose") end

// ---- configuration ------------------------------------------------------

@fa "پیکربندی"
@ar "التكوين"
pub func GetConfiguration(section: str): i64: ret node.CallS1(vsc_ns("workspace"), "getConfiguration", section) end

@fa "پیکربندی رشته"
@ar "تكوين نصي"
pub func ConfigGetStr(cfg: i64, key: str, def: str): str: ret node.ToStr(node.CallS2(cfg, "get", key, def)) end

@fa "پیکربندی منطقی"
@ar "تكوين منطقي"
pub func ConfigGetBool(cfg: i64, key: str, def: bool): bool: ret node.ToBool(node.CallSB1(cfg, "get", key, def)) end

// ---- commands ------------------------------------------------------------

@fa "ثبت فرمان"
@ar "تسجيل الأمر"
pub func RegisterCommand(id: str, cb: func ()): i64: ret node.CallSFn0(vsc_ns("commands"), "registerCommand", id, cb) end

@fa "اجرای فرمان"
@ar "تنفيذ الأمر"
pub func ExecuteCommand0(id: str): i64: ret node.CallS1(vsc_ns("commands"), "executeCommand", id) end

@fa "اجرای فرمان با رشته"
@ar "تنفيذ الأمر بنص"
pub func ExecuteCommandS1(id: str, arg: str): i64: ret node.CallS2(vsc_ns("commands"), "executeCommand", id, arg) end

@fa "اجرای فرمان تنظیمات"
@ar "تنفيذ أمر الإعدادات"
pub func OpenSettings(settingId: str): node.CallS2(vsc_ns("commands"), "executeCommand", "workbench.action.openSettings", settingId) end

// ---- window / editor / document ------------------------------------------

@fa "ویرایشگر فعال"
@ar "المحرر النشط"
pub func ActiveTextEditor(): i64: ret node.GetProp(vsc_ns("window"), "activeTextEditor") end

@fa "سند ویرایشگر"
@ar "مستند المحرر"
pub func EditorDocument(editor: i64): i64: ret node.GetProp(editor, "document") end

@fa "متن سند"
@ar "نص المستند"
pub func DocumentGetText(doc: i64): str: ret node.ToStr(node.Call0(doc, "getText")) end

@fa "شناسه زبان سند"
@ar "معرف لغة المستند"
pub func DocumentLanguageId(doc: i64): str: ret node.GetStr(doc, "languageId") end

@fa "سند کثیف است"
@ar "المستند متسخ"
pub func DocumentIsDirty(doc: i64): bool: ret node.GetBool(doc, "isDirty") end

@fa "ذخیره سند"
@ar "حفظ المستند"
pub func DocumentSave(doc: i64): i64: ret node.Call0(doc, "save") end

@fa "مسیر فایل سند"
@ar "مسار ملف المستند"
pub func DocumentUriFsPath(doc: i64): str: ret node.GetStr(node.GetProp(doc, "uri"), "fsPath") end

@fa "تعداد خط سند"
@ar "عدد أسطر المستند"
pub func DocumentLineCount(doc: i64): i64: ret node.GetNum(doc, "lineCount") as i64 end

@fa "خط سند در"
@ar "سطر المستند عند"
pub func DocumentLineAt(doc: i64, n: i64): i64: ret node.CallV1(doc, "lineAt", n) end

@fa "متن خط"
@ar "نص السطر"
pub func LineText(line: i64): str: ret node.GetStr(line, "text") end

// ---- messages --------------------------------------------------------

@fa "نمایش پیام هشدار"
@ar "عرض رسالة تحذير"
pub func ShowWarningMessage(msg: str): i64: ret node.CallS1(vsc_ns("window"), "showWarningMessage", msg) end

@fa "نمایش پیام خطا"
@ar "عرض رسالة خطأ"
pub func ShowErrorMessage(msg: str): i64: ret node.CallS1(vsc_ns("window"), "showErrorMessage", msg) end

@fa "نمایش پیام خطا با کنش"
@ar "عرض رسالة خطأ بإجراء"
pub func ShowErrorMessageAction(msg: str, action: str): i64: ret node.CallS2(vsc_ns("window"), "showErrorMessage", msg, action) end

// ---- formatting provider / TextEdit / Range -------------------------------

@fa "ثبت ارائه‌دهنده قالب‌بندی سند"
@ar "تسجيل مزود تنسيق المستند"
pub func RegisterDocumentFormattingEditProvider(languageId: str, provideFn: func (i64) i64): i64:
    langs := vsc_ns("languages")
    selector := node.NewObject()
    node.SetStr(selector, "language", languageId)
    node.SetStr(selector, "scheme", "file")
    provider := node.NewObject()
    node.SetPropFn1R(provider, "provideDocumentFormattingEdits", (doc: i64): ret provideFn(doc) end)
    ret node.CallV2(langs, "registerDocumentFormattingEditProvider", selector, provider)
end

@fa "بازه تازه"
@ar "نطاق جديد"
pub func NewRange(startLine: i64, startChar: i64, endLine: i64, endChar: i64): i64:
    ret node.New4(node.GetProp(vsc, "Range"), startLine, startChar, endLine, endChar)
end

@fa "جایگزینی ویرایش متن"
@ar "استبدال تحرير النص"
pub func TextEditReplace(range: i64, newText: str): i64: ret node.CallVS1(node.GetProp(vsc, "TextEdit"), "replace", range, newText) end

@fa "سند متنی باز کن"
@ar "افتح مستند نصي"
pub func OpenTextDocumentContent(content: str, language: str): i64:
    opts := node.NewObject()
    node.SetStr(opts, "content", content)
    node.SetStr(opts, "language", language)
    ret node.CallV1(vsc_ns("workspace"), "openTextDocument", opts)
end

@fa "نمایش سند متنی"
@ar "عرض المستند النصي"
pub func ShowTextDocumentPreview(doc: i64): i64:
    opts := node.NewObject()
    node.SetBool(opts, "preview", true)
    ret node.CallV2(vsc_ns("window"), "showTextDocument", doc, opts)
end

// ---- input box / quick pick ------------------------------------------

@fa "جعبه ورودی نمایش بده"
@ar "عرض صندوق الإدخال"
pub func ShowInputBox(prompt: str, placeHolder: str): i64:
    opts := node.NewObject()
    node.SetStr(opts, "prompt", prompt)
    node.SetStr(opts, "placeHolder", placeHolder)
    ret node.CallV1(vsc_ns("window"), "showInputBox", opts)
end

@fa "انتخاب سریع نمایش بده"
@ar "عرض الاختيار السريع"
pub func ShowQuickPick(items: i64, placeHolder: str): i64:
    opts := node.NewObject()
    node.SetStr(opts, "placeHolder", placeHolder)
    ret node.CallV2(vsc_ns("window"), "showQuickPick", items, opts)
end

// ---- extension context -----------------------------------------------

@fa "پیوست کردن قابل حذف"
@ar "إلحاق قابل للتصرف"
pub func ContextSubscriptionsPush(ctx: i64, disposable: i64): node.CallV1(node.GetProp(ctx, "subscriptions"), "push", disposable) end

// ---- promises -----------------------------------------------------------

@fa "پیوست کردن سپس"
@ar "إلحاق ثم"
pub func Then1(promise: i64, onFulfilled: func (i64)): i64: ret node.CallFn1(promise, "then", onFulfilled) end
