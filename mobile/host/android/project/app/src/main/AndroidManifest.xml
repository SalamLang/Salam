<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SalamApp"
        android:hasCode="true"
        android:extractNativeLibs="true">

        <activity
            android:name="ir.salamlang.host.SalamActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustNothing"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|uiMode|density|locale|layoutDirection|fontScale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="ir.salamlang.host.SalamFiles"
            android:authorities="${applicationId}.salamfiles"
            android:exported="false"
            android:grantUriPermissions="true" />

        <receiver android:name="ir.salamlang.host.NotifyReceiver" android:exported="false" />
    </application>
</manifest>
