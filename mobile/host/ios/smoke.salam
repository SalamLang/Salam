import fs
import os

func tapped():
    println "smoke tapped"
    fs.WriteText(os.Env("HOME") + "/tapped.txt", "tapped")
end

page:
    title = "Smoke"
    button:
        id = "hit"
        height = 600
        click = tapped
        content = "Tap"
    end
end
