@en "dsp"
@fa "پردازش سیگنال"
package dsp

import math

@en "Complex"
@fa "مختلط"
pub struct Complex:
    @en "re"
    @fa "حقیقی"
    pub re: f64 = 0.0
    @en "im"
    @fa "موهومی"
    pub im: f64 = 0.0
end

func _swap(p: f64*, i: int, j: int):
    t := p[i]
    p[i] = p[j]
    p[j] = t
end

func _bitrev(re: f64*, im: f64*, n: int):
    mut j := 0
    mut i := 1
    until i < n:
        mut bit := n >> 1
        until (j & bit) != 0:
            j = j ^ bit
            bit = bit >> 1
        end
        j = j | bit
        if i < j:
            _swap(re, i, j)
            _swap(im, i, j)
        end
        i += 1
    end
end

func _transform(re: f64*, im: f64*, n: int, sign: f64):
    _bitrev(re, im, n)
    mut span := 2
    until span <= n:
        half := span / 2
        ang := sign * 2.0 * math.PI / (span as f64)
        mut base := 0
        until base < n:
            mut k := 0
            until k < half:
                a := ang * (k as f64)
                wr := math.Cos(a)
                wi := math.Sin(a)
                i0 := base + k
                i1 := i0 + half
                xr := re[i1]
                xi := im[i1]
                vr := xr * wr - xi * wi
                vi := xr * wi + xi * wr
                ur := re[i0]
                ui := im[i0]
                re[i0] = ur + vr
                im[i0] = ui + vi
                re[i1] = ur - vr
                im[i1] = ui - vi
                k += 1
            end
            base += span
        end
        span = span << 1
    end
end

@en "IsPow2"
@fa "توان دو است"
pub func IsPow2(n: int): bool:
    ret n > 0 and (n & (n - 1)) == 0
end

@en "NextPow2"
@fa "توان دو بعدی"
pub func NextPow2(n: int): int:
    if n <= 1:
        ret 1
    end
    mut v := 1
    until v < n:
        v = v << 1
        if v >= 1073741824:
            break
        end
    end
    ret v
end

@en "CAdd"
@fa "جمع مختلط"
pub func CAdd(a: Complex, b: Complex): Complex:
    ret Complex { re = a.re + b.re, im = a.im + b.im }
end

@en "CSub"
@fa "تفریق مختلط"
pub func CSub(a: Complex, b: Complex): Complex:
    ret Complex { re = a.re - b.re, im = a.im - b.im }
end

@en "CMul"
@fa "ضرب مختلط"
pub func CMul(a: Complex, b: Complex): Complex:
    ret Complex { re = a.re * b.re - a.im * b.im, im = a.re * b.im + a.im * b.re }
end

@en "CScale"
@fa "مقیاس مختلط"
pub func CScale(a: Complex, k: f64): Complex:
    ret Complex { re = a.re * k, im = a.im * k }
end

@en "CConj"
@fa "همیوغ مختلط"
pub func CConj(a: Complex): Complex:
    ret Complex { re = a.re, im = 0.0 - a.im }
end

@en "CAbs"
@fa "اندازه مختلط"
pub func CAbs(a: Complex): f64:
    ret math.Hypot(a.re, a.im)
end

@en "CArg"
@fa "زاویه مختلط"
pub func CArg(a: Complex): f64:
    ret math.Atan2(a.im, a.re)
end

@en "CFromPolar"
@fa "مختلط از قطبی"
pub func CFromPolar(mag: f64, angle: f64): Complex:
    ret Complex { re = mag * math.Cos(angle), im = mag * math.Sin(angle) }
end

@en "FFT"
@fa "تبدیل فوریه"
pub func FFT(re: f64*, im: f64*, n: int): bool:
    if not IsPow2(n):
        ret false
    end
    _transform(re, im, n, -1.0)
    ret true
end

@en "IFFT"
@fa "تبدیل فوریه وارون"
pub func IFFT(re: f64*, im: f64*, n: int): bool:
    if not IsPow2(n):
        ret false
    end
    _transform(re, im, n, 1.0)
    inv := 1.0 / (n as f64)
    mut i := 0
    until i < n:
        re[i] = re[i] * inv
        im[i] = im[i] * inv
        i += 1
    end
    ret true
end

@en "FFTVec"
@fa "تبدیل فوریه برداری"
pub func FFTVec(re &: Vector<f64>, im &: Vector<f64>): bool:
    n := re.len()
    if n == 0 or im.len() != n or not IsPow2(n):
        ret false
    end
    ret FFT(re.ref(0), im.ref(0), n)
end

@en "IFFTVec"
@fa "تبدیل فوریه وارون برداری"
pub func IFFTVec(re &: Vector<f64>, im &: Vector<f64>): bool:
    n := re.len()
    if n == 0 or im.len() != n or not IsPow2(n):
        ret false
    end
    ret IFFT(re.ref(0), im.ref(0), n)
end

@en "Magnitude"
@fa "اندازه"
pub func Magnitude(re: f64*, im: f64*, n: int): Vector<f64>:
    mut out := Vector {} as Vector<f64>
    mut i := 0
    until i < n:
        out.push(math.Hypot(re[i], im[i]))
        i += 1
    end
    ret out
end

@en "Phase"
@fa "فاز"
pub func Phase(re: f64*, im: f64*, n: int): Vector<f64>:
    mut out := Vector {} as Vector<f64>
    mut i := 0
    until i < n:
        out.push(math.Atan2(im[i], re[i]))
        i += 1
    end
    ret out
end

@en "PowerSpectrum"
@fa "طیف توان"
pub func PowerSpectrum(re: f64*, im: f64*, n: int): Vector<f64>:
    mut out := Vector {} as Vector<f64>
    mut i := 0
    until i < n:
        out.push(re[i] * re[i] + im[i] * im[i])
        i += 1
    end
    ret out
end

@en "BinFrequency"
@fa "بسامد خانه"
pub func BinFrequency(bin: int, n: int, rate: int): f64:
    if n <= 0:
        ret 0.0
    end
    ret (bin as f64) * (rate as f64) / (n as f64)
end

@en "PeakBin"
@fa "خانه اوج"
pub func PeakBin(mags: Vector<f64>): int:
    if mags.len() == 0:
        ret -1
    end
    mut best := 0
    mut hi := mags.get(0)
    mut i := 1
    until i < mags.len():
        v := mags.get(i)
        if v > hi:
            hi = v
            best = i
        end
        i += 1
    end
    ret best
end
