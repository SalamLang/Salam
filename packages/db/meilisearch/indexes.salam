package meilisearch

@en "Index"
@fa "نمایه"
pub struct Index:
    @en "uid"
    @fa "شناسه یکتا"
    pub uid: str = ""
    @en "primary_key"
    @fa "کلید اصلی"
    pub primary_key: str = ""
    @en "created_at"
    @fa "زمان ساخت"
    pub created_at: str = ""
    @en "updated_at"
    @fa "زمان تغییر"
    pub updated_at: str = ""
end

@en "IndexPage"
@fa "صفحه نمایه"
pub struct IndexPage:
    @en "results"
    @fa "نتیجه‌ها"
    pub results: Vector<Index> = Vector {} as Vector<Index>
    @en "offset"
    @fa "جابجایی"
    pub offset: i64 = 0
    @en "limit"
    @fa "حد"
    pub limit: i64 = 0
    @en "total"
    @fa "کل"
    pub total: i64 = 0
end

@en "IndexStats"
@fa "آمار نمایه"
pub struct IndexStats:
    @en "number_of_documents"
    @fa "تعداد سندها"
    pub number_of_documents: i64 = 0
    @en "raw_document_db_size"
    @fa "اندازه خام سندها"
    pub raw_document_db_size: i64 = 0
    @en "avg_document_size"
    @fa "میانگین اندازه سند"
    pub avg_document_size: i64 = 0
    @en "is_indexing"
    @fa "نمایه‌سازی جاری"
    pub is_indexing: bool = false
    @en "number_of_embeddings"
    @fa "تعداد بردارها"
    pub number_of_embeddings: i64 = 0
    @en "number_of_embedded_documents"
    @fa "تعداد سندهای جاسازی‌شده"
    pub number_of_embedded_documents: i64 = 0
    @en "field_distribution"
    @fa "توزیع فیلد"
    pub field_distribution: str = ""
    @en "index_size"
    @fa "اندازه نمایه"
    pub index_size: i64 = 0
    @en "used_index_size"
    @fa "اندازه به کار رفته نمایه"
    pub used_index_size: i64 = 0
    @en "internal_database_sizes"
    @fa "اندازه پایگاه‌های درونی"
    pub internal_database_sizes: str = ""
end

@en "IndexSwap"
@fa "جابجایی نمایه"
pub struct IndexSwap:
    @en "first"
    @fa "نخست"
    pub first: str = ""
    @en "second"
    @fa "دوم"
    pub second: str = ""
    @en "rename"
    @fa "تغییر نام"
    pub rename: bool = false
end

@en "Field"
@fa "فیلد"
pub struct Field:
    @en "name"
    @fa "نام"
    pub name: str = ""
    @en "displayed"
    @fa "نمایشی"
    pub displayed: bool = false
    @en "searchable"
    @fa "قابل جستجو"
    pub searchable: bool = false
    @en "sortable"
    @fa "قابل مرتب‌سازی"
    pub sortable: bool = false
    @en "distinct"
    @fa "متمایز"
    pub distinct: bool = false
    @en "filterable"
    @fa "قابل فیلتر"
    pub filterable: bool = false
    @en "ranking_rule"
    @fa "قاعده رتبه‌بندی"
    pub ranking_rule: str = ""
    @en "localized"
    @fa "محلی"
    pub localized: str = ""
    @en "raw"
    @fa "خام"
    pub raw: str = ""
end

@en "FieldsQuery"
@fa "پرسش فیلدها"
pub struct FieldsQuery:
    @en "offset"
    @fa "جابجایی"
    pub offset: int = -1
    @en "limit"
    @fa "حد"
    pub limit: int = -1
    @en "attribute_patterns"
    @fa "الگوهای ویژگی"
    pub attribute_patterns: Vector<str> = Vector {} as Vector<str>
    @en "filter"
    @fa "فیلتر"
    pub filter: str = ""
end

@en "FieldPage"
@fa "صفحه فیلد"
pub struct FieldPage:
    @en "results"
    @fa "نتیجه‌ها"
    pub results: Vector<Field> = Vector {} as Vector<Field>
    @en "offset"
    @fa "جابجایی"
    pub offset: i64 = 0
    @en "limit"
    @fa "حد"
    pub limit: i64 = 0
    @en "total"
    @fa "کل"
    pub total: i64 = 0
end

func _enabled(item: str, key: str): bool:
    ret _get_bool(_get_raw(item, key), "enabled")
end

func _field(item: str): Field:
    ret Field {
        name = _get_str(item, "name"), displayed = _enabled(item, "displayed"), searchable = _enabled(item, "searchable"),
        sortable = _enabled(item, "sortable"), distinct = _enabled(item, "distinct"), filterable = _enabled(item, "filterable"),
        ranking_rule = _get_raw(item, "rankingRule"), localized = _get_raw(item, "localized"), raw = item
    }
end

func _index(body: str): Index:
    ret Index {
        uid = _get_str(body, "uid"), primary_key = _get_str(body, "primaryKey"), created_at = _get_str(body, "createdAt"),
        updated_at = _get_str(body, "updatedAt")
    }
end

func _index_stats(body: str): IndexStats:
    ret IndexStats {
        number_of_documents = _get_i64(body, "numberOfDocuments", 0 as i64), raw_document_db_size = _get_i64(body, "rawDocumentDbSize", 0 as i64),
        avg_document_size = _get_i64(body, "avgDocumentSize", 0 as i64), is_indexing = _get_bool(body, "isIndexing"),
        number_of_embeddings = _get_i64(body, "numberOfEmbeddings", 0 as i64),
        number_of_embedded_documents = _get_i64(body, "numberOfEmbeddedDocuments", 0 as i64),
        field_distribution = _get_raw(body, "fieldDistribution"), index_size = _get_i64(body, "indexSize", 0 as i64),
        used_index_size = _get_i64(body, "usedIndexSize", 0 as i64), internal_database_sizes = _get_raw(body, "internalDatabaseSizes")
    }
end

func _ipath(uid: str): str:
    ret "/indexes/" + _esc(uid)
end

func _paging(offset: int, limit: int): str:
    mut keys := Vector {} as Vector<str>
    mut vals := Vector {} as Vector<str>
    if offset > 0:
        keys.push("offset")
        vals.push(conv.FormatInt(offset as i64))
    end
    if limit > 0:
        keys.push("limit")
        vals.push(conv.FormatInt(limit as i64))
    end
    ret _query(keys, vals)
end

@en "CreateIndex"
@fa "ایجاد نمایه"
pub func CreateIndex(c: Client, uid: str, primary_key: str, err &: Error): TaskInfo:
    mut m := Vector {} as Vector<str>
    m.push(json.Member("uid", uid))
    if primary_key.len() > 0:
        m.push(json.Member("primaryKey", primary_key))
    end
    ret _task_info(_call(c, "POST", "/indexes", json.Object(m), err))
end

@en "GetIndex"
@fa "دریافت نمایه"
pub func GetIndex(c: Client, uid: str, err &: Error): Index:
    body := _call(c, "GET", _ipath(uid), "", err)
    if not Ok(err): ret Index {} end
    ret _index(body)
end

@en "ListIndexes"
@fa "فهرست نمایه‌ها"
pub func ListIndexes(c: Client, offset: int, limit: int, err &: Error): IndexPage:
    body := _call(c, "GET", "/indexes" + _paging(offset, limit), "", err)
    mut out := IndexPage {
        offset = _get_i64(body, "offset", 0 as i64), limit = _get_i64(body, "limit", 0 as i64),
        total = _get_i64(body, "total", 0 as i64)
    }
    each item in _elements(_get_raw(body, "results")):
        out.results.push(_index(item))
    end
    ret out
end

@en "UpdateIndex"
@fa "به‌روزرسانی نمایه"
pub func UpdateIndex(c: Client, uid: str, primary_key: str, err &: Error): TaskInfo:
    mut m := Vector {} as Vector<str>
    m.push(json.Member("primaryKey", primary_key))
    ret _task_info(_call(c, "PATCH", _ipath(uid), json.Object(m), err))
end

@en "RenameIndex"
@fa "تغییر نام نمایه"
pub func RenameIndex(c: Client, uid: str, new_uid: str, err &: Error): TaskInfo:
    mut m := Vector {} as Vector<str>
    m.push(json.Member("uid", new_uid))
    ret _task_info(_call(c, "PATCH", _ipath(uid), json.Object(m), err))
end

@en "DeleteIndex"
@fa "حذف نمایه"
pub func DeleteIndex(c: Client, uid: str, err &: Error): TaskInfo:
    ret _task_info(_call(c, "DELETE", _ipath(uid), "", err))
end

@en "SwapIndexes"
@fa "جابجایی نمایه‌ها"
pub func SwapIndexes(c: Client, swaps: Vector<IndexSwap>, err &: Error): TaskInfo:
    mut items := Vector {} as Vector<str>
    each s in swaps:
        mut pair := Vector {} as Vector<str>
        pair.push(s.first)
        pair.push(s.second)
        mut m := Vector {} as Vector<str>
        m.push(json.MemberRaw("indexes", _strs_json(pair)))
        if s.rename:
            m.push(json.MemberBool("rename", true))
        end
        items.push(json.Object(m))
    end
    ret _task_info(_call(c, "POST", "/swap-indexes", json.Array(items), err))
end

@en "GetIndexStats"
@fa "دریافت آمار نمایه"
pub func GetIndexStats(c: Client, uid: str, err &: Error): IndexStats:
    ret _index_stats(_call(c, "GET", _ipath(uid) + "/stats", "", err))
end

@en "CompactIndex"
@fa "فشرده‌سازی نمایه"
pub func CompactIndex(c: Client, uid: str, err &: Error): TaskInfo:
    ret _task_info(_call(c, "POST", _ipath(uid) + "/compact", "", err))
end

@en "ListFields"
@fa "فهرست فیلدها"
pub func ListFields(c: Client, uid: str, q: FieldsQuery, err &: Error): FieldPage:
    mut m := Vector {} as Vector<str>
    if q.offset >= 0: m.push(json.MemberInt("offset", q.offset as i64)) end
    if q.limit >= 0: m.push(json.MemberInt("limit", q.limit as i64)) end
    mut f := Vector {} as Vector<str>
    if q.attribute_patterns.len() > 0:
        f.push(json.MemberRaw("attributePatterns", _strs_json(q.attribute_patterns)))
    end
    t := str.TrimRight(q.filter)
    if t.len() > 2 and t.substr(0, 1) == "{":
        f.push(str.TrimRight(t.substr(1, t.len() - 2)))
    end
    if f.len() > 0: m.push(json.MemberRaw("filter", json.Object(f))) end
    body := _call(c, "POST", _ipath(uid) + "/fields", json.Object(m), err)
    mut out := FieldPage {
        offset = _get_i64(body, "offset", 0 as i64), limit = _get_i64(body, "limit", 0 as i64),
        total = _get_i64(body, "total", 0 as i64)
    }
    each item in _elements(_get_raw(body, "results")):
        out.results.push(_field(item))
    end
    ret out
end
