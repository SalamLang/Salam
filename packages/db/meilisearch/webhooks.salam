package meilisearch

@en "Webhook"
@fa "وب هوک"
pub struct Webhook:
    @en "uuid"
    @fa "شناسه جهانی"
    pub uuid: str = ""
    @en "url"
    @fa "نشانی"
    pub url: str = ""
    @en "headers"
    @fa "سرآیندها"
    pub headers: str = ""
    @en "is_editable"
    @fa "قابل ویرایش"
    pub is_editable: bool = false
end

func _webhook(body: str): Webhook:
    ret Webhook {
        uuid = _get_str(body, "uuid"), url = _get_str(body, "url"), headers = _get_raw(body, "headers"),
        is_editable = _get_bool(body, "isEditable")
    }
end

func _webhook_body(url: str, headers: str): str:
    mut m := Vector {} as Vector<str>
    _str_member(m, "url", url)
    _raw_member(m, "headers", headers)
    ret json.Object(m)
end

@en "ListWebhooks"
@fa "فهرست وب هوک‌ها"
pub func ListWebhooks(c: Client, err &: Error): Vector<Webhook>:
    mut out := Vector {} as Vector<Webhook>
    body := _call(c, "GET", "/webhooks", "", err)
    each item in _elements(_get_raw(body, "results")):
        out.push(_webhook(item))
    end
    ret out
end

@en "CreateWebhook"
@fa "ایجاد وب هوک"
pub func CreateWebhook(c: Client, url: str, headers: str, err &: Error): Webhook:
    body := _call(c, "POST", "/webhooks", _webhook_body(url, headers), err)
    if not Ok(err): ret Webhook {} end
    ret _webhook(body)
end

@en "GetWebhook"
@fa "دریافت وب هوک"
pub func GetWebhook(c: Client, uuid: str, err &: Error): Webhook:
    body := _call(c, "GET", "/webhooks/" + _esc(uuid), "", err)
    if not Ok(err): ret Webhook {} end
    ret _webhook(body)
end

@en "UpdateWebhook"
@fa "به‌روزرسانی وب هوک"
pub func UpdateWebhook(c: Client, uuid: str, url: str, headers: str, err &: Error): Webhook:
    body := _call(c, "PATCH", "/webhooks/" + _esc(uuid), _webhook_body(url, headers), err)
    if not Ok(err): ret Webhook {} end
    ret _webhook(body)
end

@en "DeleteWebhook"
@fa "حذف وب هوک"
pub func DeleteWebhook(c: Client, uuid: str, err &: Error): bool:
    _call(c, "DELETE", "/webhooks/" + _esc(uuid), "", err)
    ret Ok(err)
end
