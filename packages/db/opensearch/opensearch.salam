@en "opensearch"
@fa "اپن سرچ"
package opensearch

import mem
import str
import encoding

@en "VERSION"
@fa "نسخه کارخواه"
pub const VERSION := "1.0.0"

@en "DEFAULT_URL"
@fa "نشانی پیش‌فرض"
pub const DEFAULT_URL := "http://localhost:9200"

@en "DEFAULT_PORT"
@fa "درگاه پیش‌فرض"
pub const DEFAULT_PORT := 9200

@en "DEAD_NODE_MS"
@fa "مهلت گره از کار افتاده"
pub const DEAD_NODE_MS := 60000

@en "REFRESH_TRUE"
@fa "تازه‌سازی فوری"
pub const REFRESH_TRUE := "true"

@en "REFRESH_WAIT_FOR"
@fa "تازه‌سازی با انتظار"
pub const REFRESH_WAIT_FOR := "wait_for"

@en "REFRESH_FALSE"
@fa "بدون تازه‌سازی"
pub const REFRESH_FALSE := "false"

@en "SERVICE_ES"
@fa "سرویس دامنه"
pub const SERVICE_ES := "es"

@en "SERVICE_AOSS"
@fa "سرویس بی‌سرور"
pub const SERVICE_AOSS := "aoss"

struct _OsNode:
    pub host: str = ""
    pub port: int = 9200
    pub secure: bool = false
    pub ok: bool = false
    pub prefix: str = ""
    pub host_header: str = ""
    pub url: str = ""
end

struct _OsState:
    pub nodes: Vector<_OsNode> = Vector {}
    pub cursor: int = 0
    pub dead_until: Vector<i64> = Vector {}
    pub auth: str = ""
    pub extra_headers: str = ""
    pub ca_file: str = ""
    pub insecure: bool = false
    pub timeout_ms: int = 30000
    pub max_retries: int = 3
    pub aws_region: str = ""
    pub aws_service: str = ""
    pub aws_access_key: str = ""
    pub aws_secret_key: str = ""
    pub aws_session_token: str = ""
    pub aws_time: i64 = 0
    pub changes: i64 = 0
    pub status: int = 0
    pub err: str = ""
    pub err_type: str = ""
    pub err_reason: str = ""
    pub config_err: str = ""
end

@en "Config"
@fa "پیکربندی"
pub struct Config:
    pub nodes: Vector<str> = Vector {}
    pub username: str = ""
    pub password: str = ""
    pub bearer: str = ""
    pub ca_file: str = ""
    pub insecure: bool = false
    pub timeout_ms: int = 30000
    pub max_retries: int = 3
    pub headers: HashMap<str, str> = HashMap {} as HashMap<str, str>
    pub aws_region: str = ""
    pub aws_service: str = ""
    pub aws_access_key: str = ""
    pub aws_secret_key: str = ""
    pub aws_session_token: str = ""
end

@en "Client"
@fa "کارخواه"
pub struct Client:
    pub handle: void* = null
end

@en "Response"
@fa "پاسخ"
pub struct Response:
    pub status: int = 0
    pub ok: bool = false
    pub body: str = ""
    pub error: str = ""
    pub error_type: str = ""
    pub error_reason: str = ""
end

@en "Options"
@fa "گزینه‌ها"
pub struct Options:
    pub refresh: str = ""
    pub routing: str = ""
    pub pipeline: str = ""
    pub timeout: str = ""
    pub wait_for_active_shards: str = ""
    pub conflicts: str = ""
    pub if_seq_no: i64 = -1
    pub if_primary_term: i64 = -1
    pub retry_on_conflict: int = -1
    pub version: i64 = -1
    pub version_type: str = ""
    pub require_alias: bool = false
end

@en "WriteResult"
@fa "نتیجه نوشتن"
pub struct WriteResult:
    pub ok: bool = false
    pub status: int = 0
    pub index: str = ""
    pub id: str = ""
    pub result: str = ""
    pub version: i64 = 0
    pub seq_no: i64 = -1
    pub primary_term: i64 = 0
    pub shards_total: int = 0
    pub shards_successful: int = 0
    pub error: str = ""
end

@en "Document"
@fa "سند"
pub struct Document:
    pub found: bool = false
    pub index: str = ""
    pub id: str = ""
    pub version: i64 = 0
    pub seq_no: i64 = -1
    pub primary_term: i64 = 0
    pub routing: str = ""
    pub source: str = ""
    pub fields: str = ""
    pub error: str = ""
end

@en "Hit"
@fa "یافته"
pub struct Hit:
    pub index: str = ""
    pub id: str = ""
    pub score: f64 = 0.0
    pub source: str = ""
    pub sort: str = ""
    pub highlight: str = ""
    pub fields: str = ""
    pub inner_hits: str = ""
    pub matched_queries: str = ""
    pub raw: str = ""
end

@en "SearchResult"
@fa "نتیجه جستجو"
pub struct SearchResult:
    pub ok: bool = false
    pub status: int = 0
    pub took: i64 = 0
    pub timed_out: bool = false
    pub total: i64 = 0
    pub total_relation: str = ""
    pub max_score: f64 = 0.0
    pub hits: Vector<Hit> = Vector {}
    pub aggregations: str = ""
    pub suggest: str = ""
    pub scroll_id: str = ""
    pub pit_id: str = ""
    pub raw: str = ""
    pub error: str = ""
end

@en "SearchRequest"
@fa "درخواست جستجو"
pub struct SearchRequest:
    pub query: str = ""
    pub from: int = -1
    pub size: int = -1
    pub sort: Vector<str> = Vector {}
    pub source: Vector<str> = Vector {}
    pub source_excludes: Vector<str> = Vector {}
    pub no_source: bool = false
    pub fields: Vector<str> = Vector {}
    pub docvalue_fields: Vector<str> = Vector {}
    pub aggs: str = ""
    pub highlight: str = ""
    pub post_filter: str = ""
    pub collapse: str = ""
    pub suggest: str = ""
    pub rescore: str = ""
    pub script_fields: str = ""
    pub search_after: str = ""
    pub pit_id: str = ""
    pub pit_keep_alive: str = ""
    pub track_total_hits: str = ""
    pub track_scores: bool = false
    pub min_score: str = ""
    pub timeout: str = ""
    pub explain: bool = false
    pub version: bool = false
    pub seq_no_primary_term: bool = false
    pub ext: str = ""
    pub extra: Vector<str> = Vector {}
end

@en "Bucket"
@fa "سطل"
pub struct Bucket:
    pub key: str = ""
    pub key_as_string: str = ""
    pub doc_count: i64 = 0
    pub raw: str = ""
end

@en "Bulk"
@fa "دسته‌ای"
pub struct Bulk:
    pub lines: Vector<str> = Vector {}
    pub count: int = 0
end

@en "BulkItem"
@fa "قلم دسته‌ای"
pub struct BulkItem:
    pub action: str = ""
    pub index: str = ""
    pub id: str = ""
    pub status: int = 0
    pub ok: bool = false
    pub result: str = ""
    pub version: i64 = 0
    pub error_type: str = ""
    pub error_reason: str = ""
end

@en "BulkResult"
@fa "نتیجه دسته‌ای"
pub struct BulkResult:
    pub ok: bool = false
    pub status: int = 0
    pub took: i64 = 0
    pub errors: bool = false
    pub succeeded: int = 0
    pub failed: int = 0
    pub items: Vector<BulkItem> = Vector {}
    pub error: str = ""
end

@en "Info"
@fa "اطلاعات"
pub struct Info:
    pub ok: bool = false
    pub name: str = ""
    pub cluster_name: str = ""
    pub cluster_uuid: str = ""
    pub version: str = ""
    pub distribution: str = ""
    pub build_type: str = ""
    pub lucene_version: str = ""
    pub minimum_wire_compatibility_version: str = ""
    pub tagline: str = ""
end

@en "Health"
@fa "سلامت"
pub struct Health:
    pub ok: bool = false
    pub cluster_name: str = ""
    pub status: str = ""
    pub timed_out: bool = false
    pub nodes: int = 0
    pub data_nodes: int = 0
    pub active_primary_shards: int = 0
    pub active_shards: int = 0
    pub relocating_shards: int = 0
    pub initializing_shards: int = 0
    pub unassigned_shards: int = 0
    pub pending_tasks: int = 0
    pub active_shards_percent: f64 = 0.0
end

@en "IndexInfo"
@fa "اطلاعات نمایه"
pub struct IndexInfo:
    pub health: str = ""
    pub status: str = ""
    pub index: str = ""
    pub uuid: str = ""
    pub primaries: int = 0
    pub replicas: int = 0
    pub docs_count: i64 = 0
    pub docs_deleted: i64 = 0
    pub store_size: str = ""
end

@en "DefaultConfig"
@fa "پیکربندی پیش‌فرض"
pub func DefaultConfig(): Config:
    mut cfg := Config {}
    cfg.nodes.push(DEFAULT_URL)
    ret cfg
end

@en "NewClient"
@fa "کارخواه تازه"
pub func NewClient(cfg: Config): Client:
    st := mem.AllocateZeroed(sizeof(_OsState) as u64) as _OsState*
    st[0] = _OsState {}
    st[0].ca_file = cfg.ca_file
    st[0].insecure = cfg.insecure
    st[0].timeout_ms = cfg.timeout_ms
    st[0].max_retries = cfg.max_retries < 0 ? 0 : cfg.max_retries
    st[0].aws_region = cfg.aws_region
    st[0].aws_service = cfg.aws_service.len() > 0 ? cfg.aws_service : SERVICE_ES
    st[0].aws_access_key = cfg.aws_access_key
    st[0].aws_secret_key = cfg.aws_secret_key
    st[0].aws_session_token = cfg.aws_session_token
    mut nodes := Vector {} as Vector<_OsNode>
    mut user := cfg.username
    mut pass := cfg.password
    each raw in cfg.nodes:
        each part in raw.split(","):
            u := str.Trim(part)
            if u.len() == 0: continue end
            node := _os_parse_node(u, user, pass)
            if not node.ok:
                st[0].config_err = "the node url could not be parsed: " + u
                continue
            end
            nodes.push(node)
        end
    end
    if nodes.len() == 0 and st[0].config_err.len() == 0:
        nodes.push(_os_parse_node(DEFAULT_URL, user, pass))
    end
    if cfg.aws_region.len() > 0 and cfg.aws_access_key.len() == 0:
        st[0].config_err = "aws signing needs an access key and a secret key"
    end
    mut dead := Vector {} as Vector<i64>
    repeat nodes.len():
        dead.push(0 as i64)
    end
    st[0].nodes = nodes
    st[0].dead_until = dead
    if cfg.aws_region.len() == 0:
        st[0].auth = _os_auth_header(user, pass, cfg.bearer)
    end
    mut extra := str.NewBuilder()
    defer str.BufFree(extra)
    each name, val in cfg.headers:
        str.BufAppend(extra, name)
        str.BufAppend(extra, ": ")
        str.BufAppend(extra, val)
        str.BufAppend(extra, "\r\n")
    end
    st[0].extra_headers = str.BufStr(extra)
    ret Client { handle = st as void* }
end

@en "Connect"
@fa "اتصال"
pub func Connect(url: str): Client:
    mut cfg := Config {}
    cfg.nodes.push(url)
    ret NewClient(cfg)
end

@en "ConnectAuth"
@fa "اتصال با رمز"
pub func ConnectAuth(url: str, username: str, password: str): Client:
    mut cfg := Config { username = username, password = password }
    cfg.nodes.push(url)
    ret NewClient(cfg)
end

@en "ConnectInsecure"
@fa "اتصال بدون وارسی گواهی"
pub func ConnectInsecure(url: str, username: str, password: str): Client:
    mut cfg := Config { username = username, password = password, insecure = true }
    cfg.nodes.push(url)
    ret NewClient(cfg)
end

@en "ConnectAWS"
@fa "اتصال آمازون"
pub func ConnectAWS(
    url: str, region: str, service: str, access_key: str, secret_key: str, session_token: str
): Client:
    mut cfg := Config {
        aws_region = region, aws_service = service, aws_access_key = access_key, aws_secret_key = secret_key,
        aws_session_token = session_token
    }
    cfg.nodes.push(url)
    ret NewClient(cfg)
end

@en "Ok"
@fa "معتبر"
pub func Ok(c: Client): bool:
    if c.handle == null: ret false end
    st := _os_st(c)
    ret st[0].config_err.len() == 0 and st[0].nodes.len() > 0
end

@en "Error"
@fa "خطا"
pub func Error(c: Client): str:
    if c.handle == null: ret str.Clone("no client") end
    st := _os_st(c)
    if st[0].err.len() > 0: ret str.Clone(st[0].err) end
    ret str.Clone(st[0].config_err)
end

@en "ErrorType"
@fa "نوع خطا"
pub func ErrorType(c: Client): str:
    if c.handle == null: ret str.Clone("") end
    ret str.Clone(_os_st(c)[0].err_type)
end

@en "ErrorReason"
@fa "علت خطا"
pub func ErrorReason(c: Client): str:
    if c.handle == null: ret str.Clone("") end
    ret str.Clone(_os_st(c)[0].err_reason)
end

@en "Status"
@fa "وضعیت"
pub func Status(c: Client): int:
    if c.handle == null: ret 0 end
    ret _os_st(c)[0].status
end

@en "Nodes"
@fa "گره‌ها"
pub func Nodes(c: Client): Vector<str>:
    mut out := Vector {} as Vector<str>
    if c.handle == null: ret out end
    each n in _os_st(c)[0].nodes:
        out.push(str.Clone(n.url))
    end
    ret out
end

@en "AuthHeader"
@fa "سرآیند احراز"
pub func AuthHeader(c: Client): str:
    if c.handle == null: ret str.Clone("") end
    ret str.Clone(_os_st(c)[0].auth)
end

@en "SetSigningTime"
@fa "تنظیم زمان امضا"
pub func SetSigningTime(c: Client, epoch: i64):
    if c.handle == null: ret end
    _os_st(c)[0].aws_time = epoch
end

@en "Close"
@fa "بستن"
pub func Close(c &: Client):
    if c.handle == null: ret end
    mem.Free(c.handle)
    c.handle = null
end

@en "Perform"
@fa "انجام"
pub func Perform(c: Client, method: str, path: str, body: str): Response:
    ret _os_do(c, method, path, body, "application/json")
end

@en "PerformNdjson"
@fa "انجام چندخطی"
pub func PerformNdjson(c: Client, method: str, path: str, body: str): Response:
    ret _os_do(c, method, path, body, "application/x-ndjson")
end

@en "PerformText"
@fa "انجام متنی"
pub func PerformText(c: Client, method: str, path: str, body: str, content_type: str): Response:
    ret _os_do(c, method, path, body, content_type)
end

@en "EncodeBasic"
@fa "کدگذاری پایه"
pub func EncodeBasic(username: str, password: str): str:
    ret encoding.Base64Encode(username + ":" + password)
end
