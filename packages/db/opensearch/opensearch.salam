@en "DefaultConfig"
@fa "پیکربندی پیش‌فرض"
pub func DefaultConfig(): Config:
    mut cfg := Config {}
    cfg.nodes.push(DEFAULT_URL)
    ret cfg
end

@en "NewClient"
@fa "کارخواه تازه"
pub func NewClient(cfg: Config): Client:
    st := mem.AllocateZeroed(sizeof(_OsState) as u64) as _OsState*
    st[0] = _OsState {}
    st[0].ca_file = cfg.ca_file
    st[0].insecure = cfg.insecure
    st[0].timeout_ms = cfg.timeout_ms
    st[0].max_retries = cfg.max_retries < 0 ? 0 : cfg.max_retries
    st[0].aws_region = cfg.aws_region
    st[0].aws_service = cfg.aws_service.len() > 0 ? cfg.aws_service : SERVICE_ES
    st[0].aws_access_key = cfg.aws_access_key
    st[0].aws_secret_key = cfg.aws_secret_key
    st[0].aws_session_token = cfg.aws_session_token
    mut nodes := Vector {} as Vector<_OsNode>
    mut user := cfg.username
    mut pass := cfg.password
    each raw in cfg.nodes:
        each part in raw.split(","):
            u := str.Trim(part)
            if u.len() == 0: continue end
            node := _os_parse_node(u, user, pass)
            if not node.ok:
                st[0].config_err = "the node url could not be parsed: " + u
                continue
            end
            nodes.push(node)
        end
    end
    if nodes.len() == 0 and st[0].config_err.len() == 0:
        nodes.push(_os_parse_node(DEFAULT_URL, user, pass))
    end
    if cfg.aws_region.len() > 0 and cfg.aws_access_key.len() == 0:
        st[0].config_err = "aws signing needs an access key and a secret key"
    end
    mut dead := Vector {} as Vector<i64>
    repeat nodes.len():
        dead.push(0 as i64)
    end
    st[0].nodes = nodes
    st[0].dead_until = dead
    if cfg.aws_region.len() == 0:
        st[0].auth = _os_auth_header(user, pass, cfg.bearer)
    end
    mut extra := str.NewBuilder()
    defer str.BufFree(extra)
    each name, val in cfg.headers:
        str.BufAppend(extra, name)
        str.BufAppend(extra, ": ")
        str.BufAppend(extra, val)
        str.BufAppend(extra, "\r\n")
    end
    st[0].extra_headers = str.BufStr(extra)
    ret Client { handle = st as void* }
end

@en "Connect"
@fa "اتصال"
pub func Connect(url: str): Client:
    mut cfg := Config {}
    cfg.nodes.push(url)
    ret NewClient(cfg)
end

@en "ConnectAuth"
@fa "اتصال با رمز"
pub func ConnectAuth(url: str, username: str, password: str): Client:
    mut cfg := Config { username = username, password = password }
    cfg.nodes.push(url)
    ret NewClient(cfg)
end

@en "ConnectInsecure"
@fa "اتصال بدون وارسی گواهی"
pub func ConnectInsecure(url: str, username: str, password: str): Client:
    mut cfg := Config { username = username, password = password, insecure = true }
    cfg.nodes.push(url)
    ret NewClient(cfg)
end

@en "ConnectAWS"
@fa "اتصال آمازون"
pub func ConnectAWS(
    url: str, region: str, service: str, access_key: str, secret_key: str, session_token: str
): Client:
    mut cfg := Config {
        aws_region = region, aws_service = service, aws_access_key = access_key, aws_secret_key = secret_key,
        aws_session_token = session_token
    }
    cfg.nodes.push(url)
    ret NewClient(cfg)
end

@en "Ok"
@fa "معتبر"
pub func Ok(c: Client): bool:
    if c.handle == null: ret false end
    st := _os_st(c)
    ret st[0].config_err.len() == 0 and st[0].nodes.len() > 0
end

@en "Error"
@fa "خطا"
pub func Error(c: Client): str:
    if c.handle == null: ret str.Clone("no client") end
    st := _os_st(c)
    if st[0].err.len() > 0: ret str.Clone(st[0].err) end
    ret str.Clone(st[0].config_err)
end

@en "ErrorType"
@fa "نوع خطا"
pub func ErrorType(c: Client): str:
    if c.handle == null: ret str.Clone("") end
    ret str.Clone(_os_st(c)[0].err_type)
end

@en "ErrorReason"
@fa "علت خطا"
pub func ErrorReason(c: Client): str:
    if c.handle == null: ret str.Clone("") end
    ret str.Clone(_os_st(c)[0].err_reason)
end

@en "Status"
@fa "وضعیت"
pub func Status(c: Client): int:
    if c.handle == null: ret 0 end
    ret _os_st(c)[0].status
end

@en "Nodes"
@fa "گره‌ها"
pub func Nodes(c: Client): Vector<str>:
    mut out := Vector {} as Vector<str>
    if c.handle == null: ret out end
    each n in _os_st(c)[0].nodes:
        out.push(str.Clone(n.url))
    end
    ret out
end

@en "AuthHeader"
@fa "سرآیند احراز"
pub func AuthHeader(c: Client): str:
    if c.handle == null: ret str.Clone("") end
    ret str.Clone(_os_st(c)[0].auth)
end

@en "SetSigningTime"
@fa "تنظیم زمان امضا"
pub func SetSigningTime(c: Client, epoch: i64):
    if c.handle == null: ret end
    _os_st(c)[0].aws_time = epoch
end

@en "Close"
@fa "بستن"
pub func Close(c &: Client):
    if c.handle == null: ret end
    mem.Free(c.handle)
    c.handle = null
end

@en "Perform"
@fa "انجام"
pub func Perform(c: Client, method: str, path: str, body: str): Response:
    ret _os_do(c, method, path, body, "application/json")
end

@en "PerformNdjson"
@fa "انجام چندخطی"
pub func PerformNdjson(c: Client, method: str, path: str, body: str): Response:
    ret _os_do(c, method, path, body, "application/x-ndjson")
end

@en "PerformText"
@fa "انجام متنی"
pub func PerformText(c: Client, method: str, path: str, body: str, content_type: str): Response:
    ret _os_do(c, method, path, body, content_type)
end

@en "EncodeBasic"
@fa "کدگذاری پایه"
pub func EncodeBasic(username: str, password: str): str:
    ret encoding.Base64Encode(username + ":" + password)
end
