@en "opensearch"
@fa "اپن سرچ"
package opensearch

import mem
import str
import encoding

@en "VERSION"
@fa "نسخه کارخواه"
pub const VERSION := "1.0.0"

@en "DEFAULT_URL"
@fa "نشانی پیش‌فرض"
pub const DEFAULT_URL := "http://localhost:9200"

@en "DEFAULT_PORT"
@fa "درگاه پیش‌فرض"
pub const DEFAULT_PORT := 9200

@en "DEAD_NODE_MS"
@fa "مهلت گره از کار افتاده"
pub const DEAD_NODE_MS := 60000

@en "REFRESH_TRUE"
@fa "تازه‌سازی فوری"
pub const REFRESH_TRUE := "true"

@en "REFRESH_WAIT_FOR"
@fa "تازه‌سازی با انتظار"
pub const REFRESH_WAIT_FOR := "wait_for"

@en "REFRESH_FALSE"
@fa "بدون تازه‌سازی"
pub const REFRESH_FALSE := "false"

@en "SERVICE_ES"
@fa "سرویس دامنه"
pub const SERVICE_ES := "es"

@en "SERVICE_AOSS"
@fa "سرویس بی‌سرور"
pub const SERVICE_AOSS := "aoss"

struct _OsNode:
    pub host: str = ""
    pub port: int = 9200
    pub secure: bool = false
    pub ok: bool = false
    pub prefix: str = ""
    pub host_header: str = ""
    pub url: str = ""
end

struct _OsState:
    pub nodes: Vector<_OsNode> = Vector {}
    pub cursor: int = 0
    pub dead_until: Vector<i64> = Vector {}
    pub auth: str = ""
    pub extra_headers: str = ""
    pub ca_file: str = ""
    pub insecure: bool = false
    pub timeout_ms: int = 30000
    pub max_retries: int = 3
    pub aws_region: str = ""
    pub aws_service: str = ""
    pub aws_access_key: str = ""
    pub aws_secret_key: str = ""
    pub aws_session_token: str = ""
    pub aws_time: i64 = 0
    pub changes: i64 = 0
    pub status: int = 0
    pub err: str = ""
    pub err_type: str = ""
    pub err_reason: str = ""
    pub config_err: str = ""
end

