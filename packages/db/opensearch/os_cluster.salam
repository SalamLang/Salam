@en "SimulatePipeline"
@fa "شبیه‌سازی خط لوله"
pub func SimulatePipeline(c: Client, id: str, docs: Vector<str>): Vector<str>:
    mut out := Vector {} as Vector<str>
    mut wrapped := Vector {} as Vector<str>
    each d in docs:
        wrapped.push(_os_one("_source", d))
    end
    r := Perform(c, "POST", "/_ingest/pipeline/" + _os_seg(id) + "/_simulate", _os_one("docs", _os_arr(wrapped)))
    if not r.ok: ret out end
    each d in _os_items(_os_jraw(r.body, "docs")):
        out.push(_os_path_raw(d, "doc._source"))
    end
    ret out
end

