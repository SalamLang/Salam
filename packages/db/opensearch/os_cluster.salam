@en "CreateSnapshot"
@fa "ایجاد تصویر لحظه‌ای"
pub func CreateSnapshot(c: Client, repo: str, snapshot: str, indices: str, wait: bool): bool:
    mut q := Vector {} as Vector<str>
    if wait: _os_qadd(q, "wait_for_completion", "true") end
    mut m := Vector {} as Vector<str>
    if indices.len() > 0: m.push(_os_m("indices", json.Str(indices))) end
    m.push(_os_m("include_global_state", "false"))
    r := Perform(c, "PUT", "/_snapshot/" + _os_seg(repo) + "/" + _os_seg(snapshot) + _os_qs(q), _os_obj(m))
    if not r.ok: ret false end
    if not wait: ret true end
    ret _os_path(r.body, "snapshot.state") == "SUCCESS"
end

@en "GetSnapshot"
@fa "دریافت تصویر لحظه‌ای"
pub func GetSnapshot(c: Client, repo: str, snapshot: str): str:
    r := Perform(c, "GET", "/_snapshot/" + _os_seg(repo) + "/" + _os_idx(snapshot), "")
    if not r.ok: ret str.Clone("") end
    ret r.body
end

@en "Snapshots"
@fa "تصویرهای لحظه‌ای"
pub func Snapshots(c: Client, repo: str): Vector<str>:
    mut out := Vector {} as Vector<str>
    r := Perform(c, "GET", "/_snapshot/" + _os_seg(repo) + "/_all", "")
    if not r.ok: ret out end
    each s in _os_items(_os_jraw(r.body, "snapshots")):
        out.push(_os_jstr(s, "snapshot"))
    end
    ret out
end

@en "SnapshotStatus"
@fa "وضعیت تصویر لحظه‌ای"
pub func SnapshotStatus(c: Client, repo: str, snapshot: str): str:
    r := Perform(c, "GET", "/_snapshot/" + _os_seg(repo) + "/" + _os_seg(snapshot) + "/_status", "")
    if not r.ok: ret str.Clone("") end
    ret r.body
end

@en "DeleteSnapshot"
@fa "حذف تصویر لحظه‌ای"
pub func DeleteSnapshot(c: Client, repo: str, snapshot: str): bool:
    ret _os_ack(Perform(c, "DELETE", "/_snapshot/" + _os_seg(repo) + "/" + _os_seg(snapshot), ""))
end

@en "RestoreSnapshot"
@fa "بازیابی تصویر لحظه‌ای"
pub func RestoreSnapshot(c: Client, repo: str, snapshot: str, body: str, wait: bool): bool:
    mut q := Vector {} as Vector<str>
    if wait: _os_qadd(q, "wait_for_completion", "true") end
    r := Perform(c, "POST", "/_snapshot/" + _os_seg(repo) + "/" + _os_seg(snapshot) + "/_restore" + _os_qs(q), body)
    ret r.ok
end

