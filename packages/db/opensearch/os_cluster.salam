package opensearch

import str
import encoding.json

@en "TaskInfo"
@fa "اطلاعات کار"
pub struct TaskInfo:
    pub ok: bool = false
    pub id: str = ""
    pub completed: bool = false
    pub action: str = ""
    pub description: str = ""
    pub status: str = ""
    pub response: str = ""
    pub error: str = ""
end

func _os_health(r: Response): Health:
    if r.body.len() == 0: ret Health {} end
    b := r.body
    ret Health {
        ok = r.ok, cluster_name = _os_jstr(b, "cluster_name"), status = _os_jstr(b, "status"),
        timed_out = _os_jbool(b, "timed_out"), nodes = _os_int(_os_jraw(b, "number_of_nodes")),
        data_nodes = _os_int(_os_jraw(b, "number_of_data_nodes")), active_primary_shards = _os_int(_os_jraw(b, "active_primary_shards")),
        active_shards = _os_int(_os_jraw(b, "active_shards")), relocating_shards = _os_int(_os_jraw(b, "relocating_shards")),
        initializing_shards = _os_int(_os_jraw(b, "initializing_shards")), unassigned_shards = _os_int(_os_jraw(b, "unassigned_shards")),
        pending_tasks = _os_int(_os_jraw(b, "number_of_pending_tasks")), active_shards_percent = _os_f64(_os_jraw(b, "active_shards_percent_as_number"))
    }
end

func _os_task_seg(id: str): str:
    ret str.Replace(_os_seg(id), "%3A", ":")
end

func _os_task(r: Response, id: str): TaskInfo:
    mut t := TaskInfo { ok = r.ok, id = id, error = r.error }
    if r.body.len() == 0: ret t end
    task := _os_jraw(r.body, "task")
    t.completed = _os_jbool(r.body, "completed")
    t.action = _os_jstr(task, "action")
    t.description = _os_jstr(task, "description")
    t.status = _os_jraw(task, "status")
    t.response = _os_jraw(r.body, "response")
    err := _os_jraw(r.body, "error")
    if err.len() > 0:
        t.error = _os_jstr(err, "type") + ": " + _os_jstr(err, "reason")
        t.ok = false
    end
    ret t
end

@en "GetInfo"
@fa "دریافت اطلاعات"
pub func GetInfo(c: Client): Info:
    r := Perform(c, "GET", "/", "")
    if not r.ok: ret Info {} end
    v := _os_jraw(r.body, "version")
    ret Info {
        ok = true, name = _os_jstr(r.body, "name"), cluster_name = _os_jstr(r.body, "cluster_name"),
        cluster_uuid = _os_jstr(r.body, "cluster_uuid"), version = _os_jstr(v, "number"),
        distribution = _os_jstr(v, "distribution"), build_type = _os_jstr(v, "build_type"),
        lucene_version = _os_jstr(v, "lucene_version"), minimum_wire_compatibility_version = _os_jstr(v, "minimum_wire_compatibility_version"),
        tagline = _os_jstr(r.body, "tagline")
    }
end

@en "Ping"
@fa "پینگ"
pub func Ping(c: Client): bool:
    ret Perform(c, "HEAD", "/", "").status == 200
end

@en "ClusterHealth"
@fa "سلامت خوشه"
pub func ClusterHealth(c: Client): Health:
    ret _os_health(Perform(c, "GET", "/_cluster/health", ""))
end

@en "WaitForStatus"
@fa "انتظار وضعیت"
pub func WaitForStatus(c: Client, index: str, status: str, timeout: str): Health:
    mut q := Vector {} as Vector<str>
    _os_qadd(q, "wait_for_status", status)
    _os_qadd(q, "timeout", timeout)
    mut path := "/_cluster/health"
    if index.len() > 0: path = path + "/" + _os_idx(index) end
    ret _os_health(Perform(c, "GET", path + _os_qs(q), ""))
end

