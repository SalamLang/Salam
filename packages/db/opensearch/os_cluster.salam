@en "Cat"
@fa "فهرست"
pub func Cat(c: Client, what: str): Vector<str>:
    mut path := "/_cat/" + what
    path = path + (path.find("?") >= 0 ? "&" : "?") + "format=json"
    r := Perform(c, "GET", path, "")
    if not r.ok: ret Vector {} end
    ret _os_items(r.body)
end

@en "CatText"
@fa "فهرست متنی"
pub func CatText(c: Client, what: str): str:
    mut path := "/_cat/" + what
    path = path + (path.find("?") >= 0 ? "&" : "?") + "v=true&format=text"
    r := Perform(c, "GET", path, "")
    if not r.ok: ret str.Clone("") end
    ret r.body
end

@en "Plugins"
@fa "افزونه‌ها"
pub func Plugins(c: Client): Vector<str>:
    mut out := Vector {} as Vector<str>
    each row in Cat(c, "plugins"):
        comp := _os_jstr(row, "component")
        if comp.len() == 0: continue end
        mut seen := false
        each s in out:
            if s == comp:
                seen = true
                break
            end
        end
        if not seen: out.push(comp) end
    end
    ret out
end

@en "HasPlugin"
@fa "دارای افزونه"
pub func HasPlugin(c: Client, name: str): bool:
    each p in Plugins(c):
        if p == name: ret true end
    end
    ret false
end

@en "GetTask"
@fa "دریافت کار"
pub func GetTask(c: Client, task_id: str): TaskInfo:
    ret _os_task(Perform(c, "GET", "/_tasks/" + _os_task_seg(task_id), ""), task_id)
end

@en "WaitTask"
@fa "انتظار کار"
pub func WaitTask(c: Client, task_id: str, timeout: str): TaskInfo:
    mut q := Vector {} as Vector<str>
    _os_qadd(q, "wait_for_completion", "true")
    _os_qadd(q, "timeout", timeout)
    ret _os_task(Perform(c, "GET", "/_tasks/" + _os_task_seg(task_id) + _os_qs(q), ""), task_id)
end

@en "CancelTask"
@fa "لغو کار"
pub func CancelTask(c: Client, task_id: str): bool:
    ret Perform(c, "POST", "/_tasks/" + _os_task_seg(task_id) + "/_cancel", "").ok
end

@en "ListTasks"
@fa "فهرست کارها"
pub func ListTasks(c: Client, actions: str): str:
    mut q := Vector {} as Vector<str>
    _os_qadd(q, "actions", actions)
    _os_qadd(q, "detailed", "true")
    r := Perform(c, "GET", "/_tasks" + _os_qs(q), "")
    if not r.ok: ret str.Clone("") end
    ret r.body
end

@en "PutRepository"
@fa "تنظیم مخزن"
pub func PutRepository(c: Client, name: str, kind: str, settings: str): bool:
    body := _os_two("type", json.Str(kind), "settings", _os_body_or_empty(settings))
    ret _os_ack(Perform(c, "PUT", "/_snapshot/" + _os_seg(name), body))
end

