@en "PutClusterSettings"
@fa "تنظیم تنظیمات خوشه"
pub func PutClusterSettings(c: Client, persistent: str, transient: str): bool:
    mut m := Vector {} as Vector<str>
    if persistent.len() > 0: m.push(_os_m("persistent", persistent)) end
    if transient.len() > 0: m.push(_os_m("transient", transient)) end
    ret _os_ack(Perform(c, "PUT", "/_cluster/settings", _os_obj(m)))
end

