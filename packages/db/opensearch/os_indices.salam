@en "CreateDataStream"
@fa "ایجاد جریان داده"
pub func CreateDataStream(c: Client, name: str): bool:
    ret _os_ack(Perform(c, "PUT", "/_data_stream/" + _os_seg(name), ""))
end

@en "DeleteDataStream"
@fa "حذف جریان داده"
pub func DeleteDataStream(c: Client, name: str): bool:
    ret _os_ack(Perform(c, "DELETE", "/_data_stream/" + _os_seg(name), ""))
end

@en "DataStreams"
@fa "جریان‌های داده"
pub func DataStreams(c: Client): Vector<str>:
    mut out := Vector {} as Vector<str>
    r := Perform(c, "GET", "/_data_stream", "")
    if not r.ok: ret out end
    each ds in _os_items(_os_jraw(r.body, "data_streams")):
        out.push(_os_jstr(ds, "name"))
    end
    ret out
end

@en "Rollover"
@fa "چرخش نمایه"
pub func Rollover(c: Client, alias: str, conditions: str): str:
    mut body := ""
    if conditions.len() > 0: body = _os_one("conditions", conditions) end
    r := Perform(c, "POST", "/" + _os_seg(alias) + "/_rollover", body)
    if not r.ok: ret str.Clone("") end
    ret _os_jstr(r.body, "new_index")
end

@en "Analyze"
@fa "تحلیل متن"
pub func Analyze(c: Client, index: str, analyzer: str, text: str): Vector<str>:
    mut out := Vector {} as Vector<str>
    body := _os_two("analyzer", json.Str(analyzer.len() > 0 ? analyzer : "standard"), "text", json.Str(text))
    r := Perform(c, "POST", _os_ipath(index, "/_analyze"), body)
    if not r.ok: ret out end
    each t in _os_items(_os_jraw(r.body, "tokens")):
        out.push(_os_jstr(t, "token"))
    end
    ret out
end

@en "CatIndices"
@fa "فهرست نمایه‌ها"
pub func CatIndices(c: Client, pattern: str): Vector<IndexInfo>:
    mut out := Vector {} as Vector<IndexInfo>
    mut path := "/_cat/indices"
    if pattern.len() > 0: path = path + "/" + _os_idx(pattern) end
    r := Perform(c, "GET", path + "?format=json&bytes=b&s=index", "")
    if not r.ok: ret out end
    each row in _os_items(r.body):
        out.push(
            IndexInfo {
                health = _os_jstr(row, "health"), status = _os_jstr(row, "status"), index = _os_jstr(row, "index"),
                uuid = _os_jstr(row, "uuid"), primaries = _os_int(_os_jstr(row, "pri")), replicas = _os_int(_os_jstr(row, "rep")),
                docs_count = _os_i64(_os_jstr(row, "docs.count")), docs_deleted = _os_i64(_os_jstr(row, "docs.deleted")),
                store_size = _os_jstr(row, "store.size")
            }
        )
    end
    ret out
end

@en "Property"
@fa "ویژگی"
pub func Property(name: str, kind: str): str:
    ret _os_m(name, _os_one("type", json.Str(kind)))
end

@en "PropertyWith"
@fa "ویژگی با گزینه"
pub func PropertyWith(name: str, kind: str, extra: str): str:
    ret _os_m(name, AddMember(extra, "type", json.Str(kind)))
end

@en "Properties"
@fa "ویژگی‌ها"
pub func Properties(props: Vector<str>): str:
    ret _os_obj(props)
end
