@en "AliasAction"
@fa "کنش نام مستعار"
pub func AliasAction(action: str, index: str, alias: str): str:
    ret _os_one(action, _os_two("index", json.Str(index), "alias", json.Str(alias)))
end

@en "UpdateAliases"
@fa "به‌روزرسانی نام‌های مستعار"
pub func UpdateAliases(c: Client, actions: Vector<str>): bool:
    ret _os_ack(Perform(c, "POST", "/_aliases", _os_one("actions", _os_arr(actions))))
end

@en "SwapAlias"
@fa "جابجایی نام مستعار"
pub func SwapAlias(c: Client, alias: str, old_index: str, new_index: str): bool:
    mut acts := Vector {} as Vector<str>
    acts.push(AliasAction("remove", old_index, alias))
    acts.push(AliasAction("add", new_index, alias))
    ret UpdateAliases(c, acts)
end

@en "PutIndexTemplate"
@fa "تنظیم الگوی نمایه"
pub func PutIndexTemplate(c: Client, name: str, body: str): bool:
    ret _os_ack(Perform(c, "PUT", "/_index_template/" + _os_seg(name), body))
end

@en "IndexTemplate"
@fa "الگوی نمایه"
pub func IndexTemplate(patterns: Vector<str>, settings: str, properties: str, priority: int): str:
    mut tpl := Vector {} as Vector<str>
    if settings.len() > 0: tpl.push(_os_m("settings", settings)) end
    if properties.len() > 0: tpl.push(_os_m("mappings", _os_one("properties", properties))) end
    mut m := Vector {} as Vector<str>
    m.push(_os_m("index_patterns", _os_strs(patterns)))
    m.push(_os_m("template", _os_obj(tpl)))
    if priority > 0: m.push(_os_m("priority", str.FromInt(priority as i64))) end
    ret _os_obj(m)
end

@en "GetIndexTemplate"
@fa "دریافت الگوی نمایه"
pub func GetIndexTemplate(c: Client, name: str): str:
    r := Perform(c, "GET", "/_index_template/" + _os_seg(name), "")
    if not r.ok: ret str.Clone("") end
    ret r.body
