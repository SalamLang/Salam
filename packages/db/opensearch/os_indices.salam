package opensearch

import str
import encoding.json

func _os_ack(r: Response): bool:
    if not r.ok: ret false end
    if json.Has(r.body, "acknowledged"): ret _os_jbool(r.body, "acknowledged") end
    ret true
end

func _os_ipath(index: str, rest: str): str:
    if index.len() == 0: ret str.Clone(rest) end
    ret "/" + _os_idx(index) + rest
end

@en "CreateIndex"
@fa "ایجاد نمایه"
pub func CreateIndex(c: Client, name: str, body: str): bool:
    ret _os_ack(Perform(c, "PUT", "/" + _os_seg(name), body))
end

@en "CreateIndexWith"
@fa "ایجاد نمایه با تنظیمات"
pub func CreateIndexWith(c: Client, name: str, shards: int, replicas: int, properties: str): bool:
    mut idx := Vector {} as Vector<str>
    if shards > 0: idx.push(_os_m("number_of_shards", str.FromInt(shards as i64))) end
    if replicas >= 0: idx.push(_os_m("number_of_replicas", str.FromInt(replicas as i64))) end
    mut m := Vector {} as Vector<str>
    if idx.len() > 0: m.push(_os_m("settings", _os_one("index", _os_obj(idx)))) end
    if properties.len() > 0: m.push(_os_m("mappings", _os_one("properties", properties))) end
    ret CreateIndex(c, name, _os_obj(m))
end

@en "DeleteIndex"
@fa "حذف نمایه"
pub func DeleteIndex(c: Client, name: str): bool:
    ret _os_ack(Perform(c, "DELETE", "/" + _os_idx(name), ""))
end

@en "DeleteIndexIfExists"
@fa "حذف نمایه موجود"
pub func DeleteIndexIfExists(c: Client, name: str): bool:
    r := Perform(c, "DELETE", "/" + _os_idx(name) + "?ignore_unavailable=true", "")
    ret r.ok or r.status == 404
end

@en "IndexExists"
@fa "وجود نمایه"
pub func IndexExists(c: Client, name: str): bool:
    ret Perform(c, "HEAD", "/" + _os_idx(name), "").status == 200
end

@en "GetIndex"
@fa "دریافت نمایه"
pub func GetIndex(c: Client, name: str): str:
    r := Perform(c, "GET", "/" + _os_idx(name), "")
    if not r.ok: ret str.Clone("") end
    ret r.body
end

