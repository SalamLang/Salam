@en "ForceMerge"
@fa "ادغام اجباری"
pub func ForceMerge(c: Client, index: str, max_segments: int): bool:
    mut q := Vector {} as Vector<str>
    if max_segments > 0: _os_qadd(q, "max_num_segments", str.FromInt(max_segments as i64)) end
    ret Perform(c, "POST", _os_ipath(index, "/_forcemerge") + _os_qs(q), "").ok
end

