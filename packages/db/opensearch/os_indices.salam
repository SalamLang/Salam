@en "AliasIndices"
@fa "نمایه‌های نام مستعار"
pub func AliasIndices(c: Client, alias: str): Vector<str>:
    r := Perform(c, "GET", "/_alias/" + _os_seg(alias), "")
    if not r.ok: ret Vector {} end
