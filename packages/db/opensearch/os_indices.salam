@en "GetSetting"
@fa "دریافت یک تنظیم"
pub func GetSetting(c: Client, index: str, name: str): str:
    r := Perform(c, "GET", "/" + _os_seg(index) + "/_settings/" + _os_seg(name) + "?flat_settings=true", "")
    if not r.ok: ret str.Clone("") end
    ret _os_jstr(_os_jraw(_os_jraw(r.body, index), "settings"), name)
end

@en "PutSettings"
@fa "تنظیم تنظیمات"
pub func PutSettings(c: Client, index: str, settings: str): bool:
