@en "PutAliasFiltered"
@fa "افزودن نام مستعار پالایش شده"
pub func PutAliasFiltered(c: Client, index: str, alias: str, filter: str, is_write_index: bool): bool:
    mut m := Vector {} as Vector<str>
    if filter.len() > 0: m.push(_os_m("filter", filter)) end
    if is_write_index: m.push(_os_m("is_write_index", "true")) end
    ret _os_ack(Perform(c, "PUT", "/" + _os_idx(index) + "/_alias/" + _os_seg(alias), _os_obj(m)))
end

