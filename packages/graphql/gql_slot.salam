package graphql

import encoding.value

@en "ResolverSlot"
@fa "شکاف حل‌کننده"
pub struct ResolverSlot:
    @en "busy"
    @fa "مشغول"
    pub busy: bool = false
    @en "parent"
    @fa "والد"
    pub parent: value.Value = value.Value {}
    @en "args"
    @fa "آرگومان‌ها"
    pub args: value.Value = value.Value {}
    @en "ctx"
    @fa "زمینه"
    pub ctx: value.Value = value.Value {}
    @en "fieldName"
    @fa "نام فیلد"
    pub fieldName: str = ""
    @en "parentType"
    @fa "نوع والد"
    pub parentType: str = ""
    @en "result"
    @fa "نتیجه"
    pub result: value.Value = value.Value {}
    @en "resolved"
    @fa "حل‌شده"
    pub resolved: bool = false
    @en "failed"
    @fa "ناموفق"
    pub failed: bool = false
    @en "message"
    @fa "پیام"
    pub message: str = ""
end

@en "SlotTable"
@fa "جدول شکاف"
pub struct GqlSlotTable:
    @en "items"
    @fa "شکاف‌ها"
    pub items: Vector<ResolverSlot> = Vector {}
end
