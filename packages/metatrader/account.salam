package metatrader

import net.http

@en "GetAccountInfo"
@fa "دریافت اطلاعات حساب"
pub func GetAccountInfo(): AccountInfo:
    mut out := AccountInfo {}
    r := _get_raw("/account_info", http.NewHeaders())
    if not _check(r): ret out end
    _decode(r, out)
    ret out
end

@en "GetTerminalInfo"
@fa "دریافت اطلاعات ترمینال"
pub func GetTerminalInfo(): TerminalInfo:
    mut out := TerminalInfo {}
    r := _get_raw("/terminal_info", http.NewHeaders())
    if not _check(r): ret out end
    _decode(r, out)
    ret out
end
