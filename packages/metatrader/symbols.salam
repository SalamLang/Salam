package metatrader

import net.http
import encoding.json

struct symbolSelectRequest:
    symbol: str = ""
    enable: bool = false
end

@en "SymbolsTotal"
@fa "تعداد نمادها"
pub func SymbolsTotal(): int:
    mut out := 0
    r := _get_raw("/symbols_total", http.NewHeaders())
    if not _check(r): ret out end
    _decode(r, out)
    ret out
end

@en "SymbolsGet"
@fa "دریافت نمادها"
pub func SymbolsGet(): Vector<SymbolInfo>:
    mut out := Vector {} as Vector<SymbolInfo>
    r := _get_raw("/symbols_get", http.NewHeaders())
    if not _check(r): ret out end
    _decode(r, out)
    ret out
end

@en "SymbolsGetGroup"
@fa "دریافت نمادها با گروه"
pub func SymbolsGetGroup(group: str): Vector<SymbolInfo>:
    mut out := Vector {} as Vector<SymbolInfo>
    mut params := HashMap {} as HashMap<str, str>
    params.put("group", group)
    r := _get_raw("/symbols_get", params)
    if not _check(r): ret out end
    _decode(r, out)
    ret out
end

@en "GetSymbolInfo"
@fa "دریافت اطلاعات نماد"
pub func GetSymbolInfo(symbol: str): SymbolInfo:
    mut out := SymbolInfo {}
    mut params := HashMap {} as HashMap<str, str>
    params.put("symbol", symbol)
    r := _get_raw("/symbol_info", params)
    if not _check(r): ret out end
    _decode(r, out)
    ret out
end

@en "SymbolInfoTick"
@fa "نوسان نماد"
pub func SymbolInfoTick(symbol: str): Tick:
    mut out := Tick {}
    mut params := HashMap {} as HashMap<str, str>
    params.put("symbol", symbol)
    r := _get_raw("/symbol_info_tick", params)
    if not _check(r): ret out end
    _decode(r, out)
    ret out
end

@en "SymbolSelect"
@fa "انتخاب نماد"
pub func SymbolSelect(symbol: str, enable: bool): bool:
    req := symbolSelectRequest { symbol = symbol, enable = enable }
    r := _post_raw("/symbol_select", json.Marshal(req))
    ret _check(r)
end
