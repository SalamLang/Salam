    pub external_id: str = ""
end

@en "TradeDeal"
@fa "معامله انجام شده"
pub struct TradeDeal:
    pub ticket: i64 = 0 as i64
    pub order: i64 = 0 as i64
    pub time: i64 = 0 as i64
    pub time_msc: i64 = 0 as i64
    pub deal_type: int = 0
    pub entry: int = 0
