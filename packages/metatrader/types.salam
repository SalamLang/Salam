package metatrader

@en "LastErrorInfo"
@fa "اطلاعات آخرین خطا"
pub struct LastErrorInfo:
    pub code: int = 1
    pub description: str = "ok"
end

@en "VersionInfo"
@fa "اطلاعات نسخه"
pub struct VersionInfo:
    pub terminal_version: int = 0
    pub build: int = 0
    pub build_release_date: str = ""
end

@en "AccountInfo"
@fa "اطلاعات حساب"
pub struct AccountInfo:
    pub login: i64 = 0 as i64
    pub trade_mode: int = 0
    pub leverage: i64 = 0 as i64
    pub limit_orders: int = 0
    pub margin_so_mode: int = 0
    pub trade_allowed: bool = false
    pub trade_expert: bool = false
    pub margin_mode: int = 0
    pub currency_digits: int = 0
    pub fifo_close: bool = false
    pub balance: f64 = 0.0
    pub credit: f64 = 0.0
    pub profit: f64 = 0.0
    pub equity: f64 = 0.0
    pub margin: f64 = 0.0
    pub margin_free: f64 = 0.0
    pub margin_level: f64 = 0.0
    pub margin_so_call: f64 = 0.0
    pub margin_so_so: f64 = 0.0
    pub margin_initial: f64 = 0.0
    pub margin_maintenance: f64 = 0.0
    pub assets: f64 = 0.0
    pub liabilities: f64 = 0.0
    pub commission_blocked: f64 = 0.0
    pub name: str = ""
    pub server: str = ""
    pub currency: str = ""
    pub company: str = ""
end

@en "TerminalInfo"
@fa "اطلاعات ترمینال"
pub struct TerminalInfo:
    pub community_account: bool = false
    pub community_connection: bool = false
    pub connected: bool = false
    pub dlls_allowed: bool = false
    pub trade_allowed: bool = false
    pub tradeapi_disabled: bool = false
    pub email_enabled: bool = false
    pub ftp_enabled: bool = false
    pub notifications_enabled: bool = false
    pub mqid: bool = false
    pub build: int = 0
    pub maxbars: int = 0
    pub codepage: int = 0
    pub ping_last: int = 0
    pub community_balance: f64 = 0.0
    pub retransmission: f64 = 0.0
    pub company: str = ""
    pub name: str = ""
    pub language: str = ""
    pub path: str = ""
    pub data_path: str = ""
    pub commondata_path: str = ""
end

