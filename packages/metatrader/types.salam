@en "Tick"
@fa "نوسان قیمت"
pub struct Tick:
    pub time: i64 = 0 as i64
    pub bid: f64 = 0.0
    pub ask: f64 = 0.0
    pub last: f64 = 0.0
    pub volume: i64 = 0 as i64
    pub time_msc: i64 = 0 as i64
    pub flags: int = 0
    pub volume_real: f64 = 0.0
end

@en "Rate"
@fa "کندل قیمت"
pub struct Rate:
    pub time: i64 = 0 as i64
    pub open: f64 = 0.0
    pub high: f64 = 0.0
    pub low: f64 = 0.0
    pub close: f64 = 0.0
    pub tick_volume: i64 = 0 as i64
    pub spread: int = 0
    pub real_volume: i64 = 0 as i64
end

@en "BookInfo"
@fa "سطح دفتر سفارش"
pub struct BookInfo:
    pub book_type: int = 0
    pub price: f64 = 0.0
    pub volume: i64 = 0 as i64
    pub volume_dbl: f64 = 0.0
end

@en "TradeRequest"
@fa "درخواست معامله"
pub struct TradeRequest:
    pub action: int = 0
    pub magic: i64 = 0 as i64
    pub order: i64 = 0 as i64
    pub symbol: str = ""
    pub volume: f64 = 0.0
    pub price: f64 = 0.0
    pub stoplimit: f64 = 0.0
    pub sl: f64 = 0.0
    pub tp: f64 = 0.0
    pub deviation: int = 0
    pub order_type: int = 0
    pub type_filling: int = 0
    pub type_time: int = 0
    pub expiration: i64 = 0 as i64
    pub comment: str = ""
    pub position: i64 = 0 as i64
    pub position_by: i64 = 0 as i64
end

@en "OrderCheckResult"
@fa "نتیجه بررسی سفارش"
pub struct OrderCheckResult:
    pub retcode: int = 0
    pub balance: f64 = 0.0
    pub equity: f64 = 0.0
    pub profit: f64 = 0.0
    pub margin: f64 = 0.0
    pub margin_free: f64 = 0.0
    pub margin_level: f64 = 0.0
    pub comment: str = ""
    pub request: TradeRequest = TradeRequest {}
end

@en "OrderSendResult"
@fa "نتیجه ارسال سفارش"
pub struct OrderSendResult:
    pub retcode: int = 0
    pub deal: i64 = 0 as i64
    pub order: i64 = 0 as i64
    pub volume: f64 = 0.0
    pub price: f64 = 0.0
    pub bid: f64 = 0.0
    pub ask: f64 = 0.0
    pub comment: str = ""
    pub request_id: int = 0
    pub retcode_external: int = 0
    pub request: TradeRequest = TradeRequest {}
end

@en "TradeOrder"
@fa "سفارش معاملاتی"
pub struct TradeOrder:
    pub ticket: i64 = 0 as i64
    pub time_setup: i64 = 0 as i64
    pub time_setup_msc: i64 = 0 as i64
    pub time_done: i64 = 0 as i64
    pub time_done_msc: i64 = 0 as i64
    pub time_expiration: i64 = 0 as i64
    pub order_type: int = 0
    pub type_time: int = 0
    pub type_filling: int = 0
    pub state: int = 0
    pub magic: i64 = 0 as i64
    pub position_id: i64 = 0 as i64
    pub position_by_id: i64 = 0 as i64
    pub reason: int = 0
    pub volume_initial: f64 = 0.0
    pub volume_current: f64 = 0.0
    pub price_open: f64 = 0.0
    pub sl: f64 = 0.0
    pub tp: f64 = 0.0
    pub price_current: f64 = 0.0
    pub price_stoplimit: f64 = 0.0
    pub symbol: str = ""
    pub comment: str = ""
    pub external_id: str = ""
end

