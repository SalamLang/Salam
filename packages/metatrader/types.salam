    pub position_id: i64 = 0 as i64
    pub reason: int = 0
    pub volume: f64 = 0.0
    pub price: f64 = 0.0
    pub commission: f64 = 0.0
    pub swap: f64 = 0.0
    pub profit: f64 = 0.0
    pub fee: f64 = 0.0
    pub symbol: str = ""
    pub comment: str = ""
    pub external_id: str = ""
end
