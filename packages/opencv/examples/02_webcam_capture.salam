import opencv

func main:
    cam := opencv.OpenCamera(0)
    if not cam.ok():
        println "could not open camera 0 -", opencv.LastError()
        ret 1
    end
    println "camera open - press 'q' or Esc to quit"

    mut running := true
    until running:
        frame := cam.read()
        if not frame.ok():
            println "frame read failed -", opencv.LastError()
            running = false
        else:
            edges := frame.to_gray().canny(50.0, 150.0)
            opencv.Imshow("Camera", frame)
            opencv.Imshow("Edges", edges)
            frame.free()
            edges.free()

            key := opencv.WaitKey(1)
            if key == 113 or key == 27:
                running = false
            end
        end
    end

    cam.close()
    opencv.DestroyAllWindows()
    ret 0
end
