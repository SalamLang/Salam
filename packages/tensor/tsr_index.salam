package tensor

func _bstrides(x &: Tensor, rank: int, out &: Vector<int>):
    out.clear()
    xr := x.rank()
    mut own := Vector {} as Vector<int>
    repeat xr: own.push(0) end
    mut s := 1
    mut i := xr - 1
    until i >= 0:
        own.set(i, s)
        s = s * x.shape.get(i)
        i -= 1
    end
    repeat rank in d:
        xi := d - (rank - xr)
        if xi < 0 or x.shape.get(xi) == 1:
            out.push(0)
        else:
            out.push(own.get(xi))
        end
    end
    own.free()
end

func _can_expand(x &: Tensor, shape &: Vector<int>): bool:
    r := shape.len()
    xr := x.rank()
    if xr > r: ret false end
    repeat xr in i:
        d := x.shape.get(i)
        if d != 1 and d != shape.get(i + r - xr): ret false end
    end
    ret true
end

func _cmp(a &: Tensor, b &: Tensor, op: int): Tensor:
    mut shape := Vector {} as Vector<int>
    if not BroadcastShape(a, b, shape):
        shape.free()
        ret Empty()
    end
    mut ea := Expand(a, shape)
    mut eb := Expand(b, shape)
    out := Zeros(shape)
    shape.free()
    n := out.numel()
    pa := ea.data.data
    pb := eb.data.data
    po := out.data.data
    one := 1.0 as f32
    if op == 0:
        repeat n in k: if pa[k] > pb[k]: po[k] = one end end
    else op == 1:
        repeat n in k: if pa[k] >= pb[k]: po[k] = one end end
    else op == 2:
        repeat n in k: if pa[k] < pb[k]: po[k] = one end end
    else op == 3:
        repeat n in k: if pa[k] <= pb[k]: po[k] = one end end
    else op == 4:
        repeat n in k: if pa[k] == pb[k]: po[k] = one end end
    else:
        repeat n in k: if pa[k] != pb[k]: po[k] = one end end
    end
    ea.free()
    eb.free()
    ret out
end

func _cmp_scalar(x &: Tensor, s: f64, op: int): Tensor:
    mut t := Scalar(s)
    out := _cmp(x, t, op)
    t.free()
    ret out
end

func _split_axis(x &: Tensor, axis: int, outer &: int, inner &: int):
    outer = 1
    inner = 1
    repeat x.rank() in i:
        if i < axis: outer = outer * x.shape.get(i)
        else i > axis: inner = inner * x.shape.get(i) end
    end
end

func _tri(x &: Tensor, diagonal: int, lower: bool): Tensor:
    if x.rank() < 2: ret Empty() end
    cols := x.shape.get(x.rank() - 1)
    rows := x.shape.get(x.rank() - 2)
    planes := x.numel() / (rows * cols)
    out := Clone(x)
    po := out.data.data
    zero := 0.0 as f32
    repeat planes in p:
        base := p * rows * cols
        repeat rows in i:
            repeat cols in j:
                keep := lower ? j <= i + diagonal : j >= i + diagonal
                if not keep: po[base + i * cols + j] = zero end
            end
        end
    end
    ret out
end

@en "BroadcastShape"
@fa "شکل پخش"
pub func BroadcastShape(a &: Tensor, b &: Tensor, out &: Vector<int>): bool:
    out.clear()
    ra := a.rank()
    rb := b.rank()
    r := ra > rb ? ra : rb
    repeat r in i:
        ia := i - (r - ra)
        ib := i - (r - rb)
        da := ia < 0 ? 1 : a.shape.get(ia)
        db := ib < 0 ? 1 : b.shape.get(ib)
        if da != db and da != 1 and db != 1:
            out.clear()
            ret false
        end
        out.push(da == 1 ? db : da)
    end
    ret true
end

@en "Expand"
@fa "گسترش"
pub func Expand(x &: Tensor, shape &: Vector<int>): Tensor:
    if x.is_empty() or not _can_expand(x, shape): ret Empty() end
    r := shape.len()
    mut st := Vector {} as Vector<int>
    _bstrides(x, r, st)
    out := Zeros(shape)
    n := out.numel()
    px := x.data.data
    po := out.data.data
    mut idx := Vector {} as Vector<int>
    repeat r: idx.push(0) end
    mut off := 0
    repeat n in k:
        po[k] = px[off]
        mut d := r - 1
        mut carry := true
        until carry and d >= 0:
            idx.set(d, idx.get(d) + 1)
            off += st.get(d)
            if idx.get(d) < shape.get(d):
                carry = false
            else:
                off -= st.get(d) * shape.get(d)
                idx.set(d, 0)
                d -= 1
            end
        end
    end
    idx.free()
    st.free()
    ret out
end

@en "Greater"
@fa "بزرگتر"
pub func Greater(a &: Tensor, b &: Tensor): Tensor: ret _cmp(a, b, 0) end

@en "GreaterEqual"
@fa "بزرگتر مساوی"
pub func GreaterEqual(a &: Tensor, b &: Tensor): Tensor: ret _cmp(a, b, 1) end

@en "Less"
@fa "کوچکتر"
pub func Less(a &: Tensor, b &: Tensor): Tensor: ret _cmp(a, b, 2) end

@en "LessEqual"
@fa "کوچکتر مساوی"
pub func LessEqual(a &: Tensor, b &: Tensor): Tensor: ret _cmp(a, b, 3) end

@en "EqualMask"
@fa "ماسک برابری"
pub func EqualMask(a &: Tensor, b &: Tensor): Tensor: ret _cmp(a, b, 4) end

@en "NotEqualMask"
@fa "ماسک نابرابری"
pub func NotEqualMask(a &: Tensor, b &: Tensor): Tensor: ret _cmp(a, b, 5) end

@en "GreaterScalar"
@fa "بزرگتر از عدد"
pub func GreaterScalar(x &: Tensor, s: f64): Tensor: ret _cmp_scalar(x, s, 0) end

@en "LessScalar"
@fa "کوچکتر از عدد"
pub func LessScalar(x &: Tensor, s: f64): Tensor: ret _cmp_scalar(x, s, 2) end

@en "EqualScalar"
@fa "یکسان با عدد"
pub func EqualScalar(x &: Tensor, s: f64): Tensor: ret _cmp_scalar(x, s, 4) end

@en "Where"
@fa "کجا"
pub func Where(cond &: Tensor, a &: Tensor, b &: Tensor): Tensor:
    mut s1 := Vector {} as Vector<int>
    if not BroadcastShape(cond, a, s1):
        s1.free()
        ret Empty()
    end
    mut tmp := Zeros(s1)
    mut shape := Vector {} as Vector<int>
    ok := BroadcastShape(tmp, b, shape)
    tmp.free()
    s1.free()
    if not ok:
        shape.free()
        ret Empty()
    end
    mut ec := Expand(cond, shape)
    mut ea := Expand(a, shape)
    mut eb := Expand(b, shape)
    out := Zeros(shape)
    shape.free()
    n := out.numel()
    pc := ec.data.data
    pa := ea.data.data
    pb := eb.data.data
    po := out.data.data
    zero := 0.0 as f32
    repeat n in k: po[k] = pc[k] != zero ? pa[k] : pb[k] end
    ec.free()
    ea.free()
    eb.free()
    ret out
end

@en "MaskedFill"
@fa "پرکردن ماسک‌شده"
pub func MaskedFill(x &: Tensor, mask &: Tensor, value: f64): Tensor:
    mut em := Expand(mask, x.shape)
    if em.is_empty(): ret Empty() end
    out := Clone(x)
    n := out.numel()
    pm := em.data.data
    po := out.data.data
    v := value as f32
    zero := 0.0 as f32
    repeat n in k: if pm[k] != zero: po[k] = v end end
    em.free()
    ret out
end

@en "IndexSelect"
@fa "انتخاب نمایه"
pub func IndexSelect(x &: Tensor, axis: int, ids &: Vector<int>): Tensor:
    if x.is_empty() or axis < 0 or axis >= x.rank(): ret Empty() end
    len := x.shape.get(axis)
    repeat ids.len() in i:
        if ids.get(i) < 0 or ids.get(i) >= len: ret Empty() end
    end
    mut outer := 1
    mut inner := 1
    _split_axis(x, axis, outer, inner)
    mut shape := Vector {} as Vector<int>
    repeat x.rank() in i: shape.push(i == axis ? ids.len() : x.shape.get(i)) end
    out := Zeros(shape)
    shape.free()
    m := ids.len()
    px := x.data.data
    po := out.data.data
    repeat outer in o:
        repeat m in t:
            src := (o * len + ids.get(t)) * inner
            dst := (o * m + t) * inner
            repeat inner in k: po[dst + k] = px[src + k] end
        end
    end
    ret out
end

@en "TakeRows"
@fa "گرفتن ردیف‌ها"
pub func TakeRows(x &: Tensor, ids &: Vector<int>): Tensor: ret IndexSelect(x, 0, ids) end

@en "Gather"
@fa "گردآوری"
pub func Gather(x &: Tensor, axis: int, idx &: Tensor): Tensor:
    if x.is_empty() or idx.is_empty() or axis < 0 or axis >= x.rank() or idx.rank() != x.rank(): ret Empty() end
    repeat x.rank() in i:
        if i != axis and idx.shape.get(i) != x.shape.get(i): ret Empty() end
    end
    mut outer := 1
    mut inner := 1
    _split_axis(x, axis, outer, inner)
    lx := x.shape.get(axis)
    li := idx.shape.get(axis)
    out := Zeros(idx.shape)
    px := x.data.data
    pi := idx.data.data
    po := out.data.data
    repeat outer in o:
        repeat li in j:
            repeat inner in k:
                at := (o * li + j) * inner + k
                mut id := pi[at] as int
                if id < 0: id = 0 end
                if id >= lx: id = lx - 1 end
                po[at] = px[(o * lx + id) * inner + k]
            end
        end
    end
    ret out
end

@en "ScatterAddRows"
@fa "پراکندن جمعی ردیف‌ها"
pub func ScatterAddRows(dst &: Tensor, ids &: Vector<int>, src &: Tensor): bool:
    if dst.rank() != 2 or src.rank() != 2 or src.dim(1) != dst.dim(1) or src.dim(0) != ids.len(): ret false end
    w := dst.dim(1)
    rows := dst.dim(0)
    pd := dst.data.data
    ps := src.data.data
    repeat ids.len() in i:
        r := ids.get(i)
        if r < 0 or r >= rows: continue end
        repeat w in k: pd[r * w + k] += ps[i * w + k] end
    end
    ret true
end

@en "OneHot"
@fa "یک‌داغ"
pub func OneHot(ids &: Vector<int>, classes: int): Tensor:
    n := ids.len()
    out := Zeros2(n, classes)
    po := out.data.data
    one := 1.0 as f32
    repeat n in i:
        c := ids.get(i)
        if c >= 0 and c < classes: po[i * classes + c] = one end
    end
    ret out
end

@en "TopK"
@fa "کِی برتر"
pub func TopK(x &: Tensor, k: int, largest: bool, idx_out &: Tensor): Tensor:
    if x.is_empty() or k < 1: ret Empty() end
    width := x.shape.get(x.rank() - 1)
    if k > width: ret Empty() end
    rows := x.numel() / width
    mut shape := Vector {} as Vector<int>
    repeat x.rank() in i: shape.push(i == x.rank() - 1 ? k : x.shape.get(i)) end
    out := Zeros(shape)
    idx_out.free()
    idx_out = Zeros(shape)
    shape.free()
    px := x.data.data
    po := out.data.data
    pi := idx_out.data.data
    repeat rows in r:
        base := r * width
        obase := r * k
        mut taken := Vector {} as Vector<bool>
        repeat width: taken.push(false) end
        repeat k in t:
            mut best := 0 - 1
            repeat width in c:
                if taken.get(c): continue end
                if best < 0: best = c
                else largest and px[base + c] > px[base + best]: best = c
                else not largest and px[base + c] < px[base + best]: best = c end
            end
            taken.set(best, true)
            po[obase + t] = px[base + best]
            pi[obase + t] = best as f32
        end
        taken.free()
    end
    ret out
end

@en "Tril"
@fa "مثلث پایین"
pub func Tril(x &: Tensor, diagonal: int): Tensor: ret _tri(x, diagonal, true) end

@en "Triu"
@fa "مثلث بالا"
pub func Triu(x &: Tensor, diagonal: int): Tensor: ret _tri(x, diagonal, false) end

@en "Cumsum"
@fa "جمع تجمعی"
pub func Cumsum(x &: Tensor, axis: int): Tensor:
    if x.is_empty() or axis < 0 or axis >= x.rank(): ret Empty() end
    mut outer := 1
    mut inner := 1
    _split_axis(x, axis, outer, inner)
    len := x.shape.get(axis)
    out := Clone(x)
    po := out.data.data
    repeat outer in o:
        repeat inner in i:
            mut acc := 0.0 as f32
            repeat len in t:
                at := (o * len + t) * inner + i
                acc += po[at]
                po[at] = acc
            end
        end
    end
    ret out
end
