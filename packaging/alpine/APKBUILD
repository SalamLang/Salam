# Contributor: Seyyed Ali Mohammadiyeh (Max Base) <MaxBaseCode@gmail.com>
# Maintainer: Seyyed Ali Mohammadiyeh (Max Base) <MaxBaseCode@gmail.com>
pkgname=salam
pkgver=@VERSION@
pkgrel=0
pkgdesc="General-purpose systems programming language with a built-in DSL"
url="https://github.com/SalamLang/Salam"
arch="x86_64"
license="GPL-3.0-or-later"
# The musl build is fully static: no libc is loaded at run time. It carries no
# embedded LLVM either, so no JIT and no cross-compiling.
depends=""
options="!check !strip !tracedeps"
source="salam-$pkgver-linux-x86_64-musl.tar.gz::$url/releases/download/v$pkgver/salam-$pkgver-linux-x86_64-musl.tar.gz"
builddir="$srcdir/salam-linux-x86_64-musl"

package() {
	install -Dm755 "$builddir"/salam "$pkgdir"/usr/lib/salam/salam

	install -dm755 "$pkgdir"/usr/lib/salam/std
	cp -a "$builddir"/std/. "$pkgdir"/usr/lib/salam/std/
	find "$pkgdir"/usr/lib/salam/std -type d -exec chmod 755 {} +
	find "$pkgdir"/usr/lib/salam/std -type f -exec chmod 644 {} +

	install -dm755 "$pkgdir"/usr/bin
	cat > "$pkgdir"/usr/bin/salam <<'EOF'
#!/bin/sh
SALAM_HOME=/usr/lib/salam
export SALAM_STD="${SALAM_STD:-$SALAM_HOME/std}"
exec "$SALAM_HOME/salam" "$@"
EOF
	chmod 755 "$pkgdir"/usr/bin/salam

	install -Dm644 "$builddir"/LICENSE "$pkgdir"/usr/share/licenses/salam/LICENSE
}

sha512sums="
@SHA512_LINUX_MUSL@  salam-@VERSION@-linux-x86_64-musl.tar.gz
"
