#!/usr/bin/env bash
set -euo pipefail

[ -n "${ASDF_INSTALL_VERSION:-}" ] || {
	echo "ASDF_INSTALL_VERSION is not set" >&2
	exit 1
}
[ -n "${ASDF_DOWNLOAD_PATH:-}" ] || {
	echo "ASDF_DOWNLOAD_PATH is not set" >&2
	exit 1
}

version=$ASDF_INSTALL_VERSION

case "$(uname -s)" in
Darwin) os=macos ;;
Linux) os=linux ;;
*)
	echo "salam: unsupported OS $(uname -s)" >&2
	exit 1
	;;
esac

case "$(uname -m)" in
x86_64 | amd64) arch=x86_64 ;;
arm64 | aarch64) arch=aarch64 ;;
armv7l | armv6l) arch=armhf ;;
i386 | i686) arch=i686 ;;
*)
	echo "salam: unsupported architecture $(uname -m)" >&2
	exit 1
	;;
esac

if [ "$os" = macos ]; then
	[ "$arch" = aarch64 ] || {
		echo "salam: macOS builds are published for Apple Silicon only" >&2
		exit 1
	}
	slug=macos-arm64
else
	slug=linux-$arch
fi

base="https://github.com/SalamLang/Salam/releases/download/v$version"
tarball="salam-$version-$slug.tar.gz"
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

echo "salam $version: downloading $tarball"
curl -fsSL -o "$tmp/$tarball" "$base/$tarball"

if curl -fsSL -o "$tmp/$tarball.sha256" "$base/$tarball.sha256" 2>/dev/null; then
	(cd "$tmp" && if command -v sha256sum >/dev/null 2>&1; then
		sha256sum -c "$tarball.sha256"
	else
		shasum -a 256 -c "$tarball.sha256"
	fi)
else
	echo "salam: no published checksum for $tarball; skipping verification" >&2
fi

mkdir -p "$ASDF_DOWNLOAD_PATH"
tar -xzf "$tmp/$tarball" -C "$ASDF_DOWNLOAD_PATH" --strip-components=1
