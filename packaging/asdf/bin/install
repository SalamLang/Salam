#!/usr/bin/env bash
set -euo pipefail

[ "${ASDF_INSTALL_TYPE:-version}" = version ] || {
	echo "salam: only tagged versions can be installed, not ${ASDF_INSTALL_TYPE}" >&2
	exit 1
}
[ -n "${ASDF_INSTALL_PATH:-}" ] || {
	echo "ASDF_INSTALL_PATH is not set" >&2
	exit 1
}
[ -n "${ASDF_DOWNLOAD_PATH:-}" ] || {
	echo "ASDF_DOWNLOAD_PATH is not set" >&2
	exit 1
}

libdir=$ASDF_INSTALL_PATH/lib/salam
mkdir -p "$libdir" "$ASDF_INSTALL_PATH/bin"

cp "$ASDF_DOWNLOAD_PATH/salam" "$libdir/salam"
chmod 755 "$libdir/salam"
cp -R "$ASDF_DOWNLOAD_PATH/std" "$libdir/std"
[ -d "$ASDF_DOWNLOAD_PATH/sysroots" ] && cp -R "$ASDF_DOWNLOAD_PATH/sysroots" "$libdir/sysroots"

# asdf puts a shim on PATH, and the compiler works out where std/ lives from
# its own path, so the shim has to hand it over explicitly.
cat >"$ASDF_INSTALL_PATH/bin/salam" <<EOF
#!/bin/sh
SALAM_HOME="$libdir"
export SALAM_STD="\${SALAM_STD:-\$SALAM_HOME/std}"
exec "\$SALAM_HOME/salam" "\$@"
EOF
chmod 755 "$ASDF_INSTALL_PATH/bin/salam"

"$ASDF_INSTALL_PATH/bin/salam" version >/dev/null
echo "salam $ASDF_INSTALL_VERSION installed"
