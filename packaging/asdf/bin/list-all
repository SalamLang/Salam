#!/usr/bin/env bash
set -euo pipefail

curl -fsSL \
	${GITHUB_API_TOKEN:+-H "Authorization: token $GITHUB_API_TOKEN"} \
	"https://api.github.com/repos/SalamLang/Salam/releases?per_page=100" |
	grep -o '"tag_name": *"v[^"]*"' |
	sed 's/.*"v\([^"]*\)"/\1/' |
	grep -v -- '-nightly-' |
	sort -t. -k1,1n -k2,2n -k3,3n |
	tr '\n' ' '
