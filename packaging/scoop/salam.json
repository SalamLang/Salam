{
  "version": "@VERSION@",
  "description": "General-purpose systems programming language with a built-in DSL",
  "homepage": "https://github.com/SalamLang/Salam",
  "license": "GPL-3.0-or-later",
  "architecture": {
    "64bit": {
      "url": "https://github.com/SalamLang/Salam/releases/download/v@VERSION@/salam-@VERSION@-windows-x86_64.zip",
      "hash": "@SHA256_WINDOWS_X86_64@",
      "extract_dir": "salam-windows"
    },
    "32bit": {
      "url": "https://github.com/SalamLang/Salam/releases/download/v@VERSION@/salam-@VERSION@-windows-i686.zip",
      "hash": "@SHA256_WINDOWS_I686@",
      "extract_dir": "salam-windows-i686"
    }
  },
  "bin": "salam.exe",
  "env_set": {
    "SALAM_STD": "$dir\\std"
  },
  "checkver": {
    "github": "https://github.com/SalamLang/Salam"
  },
  "autoupdate": {
    "architecture": {
      "64bit": {
        "url": "https://github.com/SalamLang/Salam/releases/download/v$version/salam-$version-windows-x86_64.zip"
      },
      "32bit": {
        "url": "https://github.com/SalamLang/Salam/releases/download/v$version/salam-$version-windows-i686.zip"
      }
    },
    "hash": {
      "url": "$url.sha256"
    }
  }
}
