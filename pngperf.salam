package main

import image
import str
import time

func t(w: int, h: int):
    mut img := image.NewFilled(w, h, image.RGB(255, 255, 255))
    image.DrawRectFilled(img, 5, 5, w / 2, h / 2, image.RGB(10, 20, 30))
    t0 := time.NowMillis()
    buf := image.EncodePNG(img)
    t1 := time.NowMillis()
    println str.FromInt(w as i64) + "x" + str.FromInt(h as i64) + " bytes=" + str.FromInt(buf.len as i64) + " ms=" + str.FromInt((t1 - t0) as i64)
    image.Free(img)
    ret
end

func main:
    t(200, 100)
    t(400, 200)
    t(560, 260)
    t(720, 380)
    ret 0
end
