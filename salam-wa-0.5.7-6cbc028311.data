@fa "گزینه ها"
pub func Options(url: str): Response: ret send("OPTIONS", url, "", "") end
@en "OptionsWith"
@fa "گزینه ها با"
pub func OptionsWith(url: str, headers: HashMap<str, str>): Response:
ret send("OPTIONS", url, serialize(headers), "")
