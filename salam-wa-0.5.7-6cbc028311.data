if rd > 5:
carry = true
else:
if rd == 5:
mut i := 1
until i < ndig:
if digits[i] != (48 as u8):
carry = true
i = ndig
else:
i += 1
end
end
end
end
end
digits[0] = carry ? (49 as u8) : (48 as u8)
