excess := bl - 53
mut m := _round_quotient(quo, excess, sticky)
mut fe := e2 + excess
if m >= (TWO53 as u64):
m = m >> (1 as u64)
fe += 1
end
if fe < SUBNORMAL_EXP:
_bn_copy(p, p0)
_bn_copy(q, q0)
if not _bn_shl(p, 1075):
ret _encode(neg, 0 as u64, 0)
end
quo = _bn_div(p, q, t)
sticky = trunc or not _bn_is_zero(p)
m = _round_quotient(quo, 1, sticky)
fe = SUBNORMAL_EXP
if m >= (TWO52 as u64):
ret _encode(neg, m, fe)
end
mut bits := m
if neg:
bits = bits | (0x8000000000000000 as u64)
end
ret bits
end
if (fe + 1075) >= 2047:
mut inf := 0x7FF0000000000000 as u64
if neg:
inf = inf | (0x8000000000000000 as u64)
end
ret inf
end
ret _encode(neg, m, fe)
end
func _is_digit(c: int): bool:
ret c >= 48 and c <= 57
