func _sha512_block(s &: Sha512):
mut w: u64[80]
repeat 16 in t:
o := t * 8
mut v := 0 as u64
repeat 8 in j:
v = (v << (8 as u64)) | (s.blk[o + j] as u64)
end
w[t] = v
end
repeat 64 in k:
t := k + 16
x15 := w[t - 15]
x2 := w[t - 2]
s0 := _rotr64(x15, 1 as u64) ^ _rotr64(x15, 8 as u64) ^ (x15 >> (7 as u64))
s1 := _rotr64(x2, 19 as u64) ^ _rotr64(x2, 61 as u64) ^ (x2 >> (6 as u64))
w[t] = w[t - 16] + s0 + w[t - 7] + s1
end
mut a := s.h[0]
mut b := s.h[1]
mut c := s.h[2]
mut d := s.h[3]
mut e := s.h[4]
mut f := s.h[5]
mut g := s.h[6]
mut hh := s.h[7]
repeat 80 in t:
bigs1 := _rotr64(e, 14 as u64) ^ _rotr64(e, 18 as u64) ^ _rotr64(e, 41 as u64)
ch := (e & f) ^ ((~e) & g)
t1 := hh + bigs1 + ch + K512[t] + w[t]
bigs0 := _rotr64(a, 28 as u64) ^ _rotr64(a, 34 as u64) ^ _rotr64(a, 39 as u64)
maj := (a & b) ^ (a & c) ^ (b & c)
t2 := bigs0 + maj
hh = g
g = f
f = e
e = d + t1
d = c
c = b
b = a
a = t1 + t2
end
s.h[0] += a
s.h[1] += b
s.h[2] += c
s.h[3] += d
s.h[4] += e
s.h[5] += f
s.h[6] += g
s.h[7] += hh
end
func _sha512_update(s &: Sha512, p: void*, n: int):
mut i := 0
until i < n:
space := SHA512_BLOCK - s.blen
mut take := n - i
if take > space:
take = space
end
repeat take in j:
s.blk[s.blen + j] = _bget(p, i + j) as u8
end
s.blen += take
i += take
s.total += take as u64
if s.blen == SHA512_BLOCK:
_sha512_block(s)
s.blen = 0
end
end
end
func _sha512_final(s0: Sha512, out: void*):
mut s := s0
bits := s.total * (8 as u64)
s.blk[s.blen] = 0x80 as u8
s.blen += 1
if s.blen > 112:
until s.blen < SHA512_BLOCK:
s.blk[s.blen] = 0 as u8
s.blen += 1
end
_sha512_block(s)
s.blen = 0
end
until s.blen < 112:
s.blk[s.blen] = 0 as u8
s.blen += 1
end
repeat 8 in i:
s.blk[112 + i] = 0 as u8
end
repeat 8 in i:
sh := ((7 - i) * 8) as u64
s.blk[120 + i] = ((bits >> sh) & (0xFF as u64)) as u8
end
_sha512_block(s)
n := s.outlen
repeat n in i:
word := s.h[i / 8]
sh := ((7 - (i % 8)) * 8) as u64
_bput(out, i, ((word >> sh) & (0xFF as u64)) as int)
end
end
func _sha256(p: void*, n: int, out: void*):
mut s := _sha256_init()
_sha256_update(s, p, n)
_sha256_final(s, out)
end
func _sha384(p: void*, n: int, out: void*):
mut s := _sha384_init()
_sha512_update(s, p, n)
_sha512_final(s, out)
end
func _sha512(p: void*, n: int, out: void*):
mut s := _sha512_init()
_sha512_update(s, p, n)
_sha512_final(s, out)
end
