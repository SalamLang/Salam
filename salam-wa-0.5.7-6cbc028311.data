@en "Walk"
@fa "پیمایش"
pub func Walk(root: str): Vector<str>:
files := Vector {} as Vector<str> stack := Vector {} as Vector<str> defer stack.free()
stack.push(root)
until stack.len() > 0:
dir := stack.pop()
entries := listdir(dir)
repeat entries.len() in i:
name := entries.get(i)
full := filepath.Join(dir, name)
if _os_is_dir(full):
stack.push(full)
else:
files.push(full)
end
end
entries.free()
end
ret files
end
