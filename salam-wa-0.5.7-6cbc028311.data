this._ensureLoaded()
p := _skip_ws(this.buf, this.pos)
ret p < this.buf.len()
end
@en "Decode"
@fa "کدگشایی"
pub func Decode(): value.Value:
this._ensureLoaded()
p := _skip_ws(this.buf, this.pos)
