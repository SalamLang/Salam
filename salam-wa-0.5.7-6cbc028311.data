@fa "عدد با طول"
pub func IntWithLength(digits: int): i64:
if digits <= 1:
ret rand_int64() % 10
end
mut lo := 1 as i64
mut k := 1
until k < digits:
lo *= 10
k += 1
end
hi := lo * 10 - 1
ret lo + rand_int64() % (hi - lo + 1)
end
