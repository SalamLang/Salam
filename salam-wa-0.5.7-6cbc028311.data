const N_LIST := 16
const N_TABLE_REF := 17
const N_SUBQUERY := 18
const N_JOIN := 19
const N_RESULT_COL := 20
const N_COLUMN_REF := 21
const N_LITERAL := 22
const N_PARAM := 23
const N_BINARY := 24
const N_UNARY := 25
const N_FUNC := 26
const N_CASE := 27
