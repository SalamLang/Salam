package llvm
extern:
func LLVMTargetMachineEmitToFile(tm: void*, mod: void*, path: str, file_type: int, out_err &: void*): int
func LLVMWriteBitcodeToFile(mod: void*, path: str): int
end
@en "EmitResult"
@fa "نتیجه تولید"
pub struct EmitResult:
pub ok: bool = false
pub err: str = ""
end
func emit_to_file(mod: Module, tm: TargetMachine, path: str, file_type: int): EmitResult:
mut eerr := null as void*
if LLVMTargetMachineEmitToFile(tm.handle, mod.handle, path, file_type, eerr) != 0:
msg := eerr != null ? str.Clone(eerr as str) : "(unknown)"
if eerr != null: LLVMDisposeMessage(eerr) end
ret EmitResult { ok = false, err = "LLVM emit failed for '" + path + "': " + msg }
end
ret EmitResult { ok = true }
end
@en "EmitAsm"
@fa "تولید اسمبلی"
pub func EmitAsm(mod: Module, tm: TargetMachine, path: str): EmitResult:
ret emit_to_file(mod, tm, path, CODEGEN_FILE_ASSEMBLY)
end
@en "EmitObject"
@fa "تولید شیء"
pub func EmitObject(mod: Module, tm: TargetMachine, path: str): EmitResult:
ret emit_to_file(mod, tm, path, CODEGEN_FILE_OBJECT)
end
@en "EmitBitcode"
@fa "تولید بیت‌کد"
pub func EmitBitcode(mod: Module, path: str): EmitResult:
if LLVMWriteBitcodeToFile(mod.handle, path) != 0:
ret EmitResult { ok = false, err = "LLVM bitcode write failed for '" + path + "'" }
end
ret EmitResult { ok = true }
end
package llvm
extern:
func LLVMContextCreate(): void*
func LLVMContextDispose(ctx: void*)
func LLVMCreateMemoryBufferWithContentsOfFile(path: str, out_buf &: void*, out_err &: void*): int
func LLVMDisposeMemoryBuffer(buf: void*)
func LLVMParseIRInContext(ctx: void*, buf: void*, out_mod &: void*, out_err &: void*): int
func LLVMDisposeModule(mod: void*)
func LLVMVerifyModule(mod: void*, action: int, out_err &: void*): int
func LLVMPrintModuleToFile(mod: void*, path: str, out_err &: void*): int
func LLVMSetTarget(mod: void*, triple: str)
func LLVMGetTarget(mod: void*): void*
func LLVMSetModuleDataLayout(mod: void*, td: void*)
func LLVMDisposeMessage(msg: void*)
end
@en "VERIFY_RETURN_STATUS"
@fa "بررسی با بازگرداندن وضعیت"
pub const VERIFY_RETURN_STATUS := 2
@en "Context"
@fa "زمینه"
pub struct Context:
pub handle: void* = null
end
@en "Module"
@fa "ماژول"
pub struct Module:
pub handle: void* = null
end
@en "ParseResult"
@fa "نتیجه تجزیه"
pub struct ParseResult:
pub ctx: Context = Context {}
pub mod: Module = Module {}
pub ok: bool = false
pub err: str = ""
end
@en "VerifyResult"
@fa "نتیجه بررسی"
pub struct VerifyResult:
pub ok: bool = false
pub err: str = ""
end
@en "NewContext"
@fa "زمینه جدید"
pub func NewContext(): Context:
ret Context { handle = LLVMContextCreate() }
end
@en "FreeContext"
@fa "آزادسازی زمینه"
pub func FreeContext(ctx: Context):
if ctx.handle != null:
LLVMContextDispose(ctx.handle)
end
end
@en "FreeModule"
@fa "آزادسازی ماژول"
pub func FreeModule(mod: Module):
if mod.handle != null:
LLVMDisposeModule(mod.handle)
end
end
@en "ParseIR"
@fa "تجزیه آی آر"
pub func ParseIR(ll_path: str): ParseResult:
mut buf := null as void*
mut berr := null as void*
if LLVMCreateMemoryBufferWithContentsOfFile(ll_path, buf, berr) != 0:
msg := berr != null ? str.Clone(berr as str) : "cannot read '" + ll_path + "'"
if berr != null: LLVMDisposeMessage(berr) end
ret ParseResult { ok = false, err = msg }
end
ctx := LLVMContextCreate()
mut mod := null as void*
mut perr := null as void*
if LLVMParseIRInContext(ctx, buf, mod, perr) != 0:
msg := perr != null ? str.Clone(perr as str) : "(unknown)"
if perr != null: LLVMDisposeMessage(perr) end
LLVMContextDispose(ctx)
ret ParseResult { ok = false, err = "LLVM IR parse error: " + msg }
end
ret ParseResult { ctx = Context { handle = ctx }, mod = Module { handle = mod }, ok = true }
end
@en "Verify"
@fa "بررسی"
pub func Verify(mod: Module): VerifyResult:
mut verr := null as void*
if LLVMVerifyModule(mod.handle, VERIFY_RETURN_STATUS, verr) != 0:
msg := verr != null ? str.Clone(verr as str) : "(unknown)"
if verr != null: LLVMDisposeMessage(verr) end
ret VerifyResult { ok = false, err = "LLVM module verification failed: " + msg }
end
ret VerifyResult { ok = true }
end
@en "TargetTripleOf"
@fa "سه‌تایی هدف"
pub func TargetTripleOf(mod: Module): str:
p := LLVMGetTarget(mod.handle)
if p == null:
ret ""
end
ret str.Clone(p as str)
end
@en "SetTargetTriple"
@fa "تنظیم سه‌تایی هدف"
pub func SetTargetTriple(mod: Module, triple: str):
if str.Len(triple) > 0:
LLVMSetTarget(mod.handle, triple)
end
end
package llvm
@en "LinkResult"
@fa "نتیجه پیوند"
pub struct LinkResult:
pub ok: bool = false
pub err: str = ""
end
func argv_of(items: Vector<str>): void*:
mut buf := mem.Allocate((items.len() as u64) * (sizeof(str) as u64)) as str*
repeat items.len() in i:
buf[i] = items.get(i)
end
ret buf as void*
end
func elf_arch_of(t: str): str:
if str.Contains(t, "aarch64") or str.Contains(t, "arm64"): ret "aarch64" end
if str.Contains(t, "i686") or str.Contains(t, "i386") or str.Contains(t, "i586"): ret "i386" end
if str.Contains(t, "arm"): ret "arm" end
ret "x86_64"
end
func elf_emul_of(t: str): str:
if str.Contains(t, "aarch64") or str.Contains(t, "arm64"): ret "aarch64linux" end
if str.Contains(t, "i686") or str.Contains(t, "i386") or str.Contains(t, "i586"): ret "elf_i386" end
if str.Contains(t, "arm"): ret "armelf_linux_eabi" end
ret "elf_x86_64"
end
func mingw_arch(t: str): str:
if str.Contains(t, "aarch64") or str.Contains(t, "arm64"): ret "aarch64" end
if str.Contains(t, "i686") or str.Contains(t, "i386") or str.Contains(t, "i586"): ret "i686" end
ret "x86_64"
end
func mingw_emul(t: str): str:
if str.Contains(t, "aarch64") or str.Contains(t, "arm64"): ret "arm64pe" end
if str.Contains(t, "i686") or str.Contains(t, "i386") or str.Contains(t, "i586"): ret "i386pe" end
ret "i386pep"
end
func find_compiler_rt(rtarch: str): str:
mut bases := Vector {} as Vector<str>
defer bases.free()
bases.push("/usr/lib/llvm-22/lib/clang")
bases.push("/usr/lib/llvm/lib/clang")
bases.push("/usr/lib/clang")
repeat bases.len() in bi:
base := bases.get(bi)
if not os.IsDir(base):
continue
end
entries := os.ListDir(base)
mut hit := ""
repeat entries.len() in i:
name := entries.get(i)
candidate := filepath.Join(filepath.Join(filepath.Join(base, name), "lib"), "linux")
path := filepath.Join(candidate, "libclang_rt.builtins-" + rtarch + ".a")
if os.Exists(path) and str.Len(hit) == 0:
hit = path
end
end
entries.free()
if str.Len(hit) > 0:
ret hit
end
end
ret ""
end
func find_mingw_gccdir(arch: str): str:
base := "/usr/lib/gcc/" + arch + "-w64-mingw32"
if not os.IsDir(base):
ret ""
end
entries := os.ListDir(base)
defer entries.free()
mut found := ""
repeat entries.len() in i:
name := entries.get(i)
if str.Len(name) > 0 and str.StartsWith(name, "."):
continue
end
dir := filepath.Join(base, name)
if os.Exists(filepath.Join(dir, "crtbegin.o")):
found = dir
if str.Contains(name, "win32"):
ret found
end
end
end
ret found
end
func musl_sysroot(explicit: str, arch: str): str:
if str.Len(explicit) > 0:
ret explicit
end
env := os.Env("SALAM_SYSROOTS")
if str.Len(env) > 0:
candidate := filepath.Join(env, arch + "-linux-musl")
if os.Exists(filepath.Join(candidate, "crt1.o")):
ret candidate
end
end
ret "/usr/lib/" + arch + "-linux-musl"
end
func mingw_sysroot(explicit: str, arch: str): str:
if str.Len(explicit) > 0:
ret explicit
end
env := os.Env("SALAM_SYSROOTS")
if str.Len(env) > 0:
candidate := filepath.Join(env, arch + "-w64-mingw32")
if os.Exists(filepath.Join(candidate, "lib/crt2.o")):
ret candidate
end
end
ret "/usr/" + arch + "-w64-mingw32"
end
func musl_folds_into_libc(flag: str): bool:
mut names := Vector {} as Vector<str>
names.push("pthread")
names.push("dl")
names.push("rt")
names.push("util")
names.push("anl")
names.push("resolv")
names.push("crypt")
names.push("m")
defer names.free()
repeat names.len() in i:
n := names.get(i)
if str.Equals(flag, "-l" + n) or str.Equals(flag, "-l:lib" + n + ".a"):
ret true
end
end
ret false
end
func user_libs_of(opts: Options): Vector<str>:
mut out := Vector {} as Vector<str>
repeat opts.link_libs.len() in i:
s := opts.link_libs.get(i)
if str.Len(s) == 0:
continue
end
if str.StartsWith(s, "-") or str.Contains(s, "/") or str.Contains(s, "\\") or str.Contains(s, "."):
out.push(s)
continue
end
mut kind := ""
if i < opts.link_kinds.len():
kind = opts.link_kinds.get(i)
end
if str.Equals(kind, "static"):
out.push("-l:lib" + s + ".a")
else:
out.push("-l" + s)
end
end
ret out
end
if SALAM_OS_WINDOWS:
func resolve_linker(): str:
ret "gcc"
end
else:
func resolve_linker(): str:
ret "cc"
end
end
func _target_is_darwin(opts: Options): bool:
t := opts.target_triple
if str.Len(t) == 0:
if SALAM_OS_MAC:
ret true
else:
ret false
end
end
ret str.Contains(t, "darwin") or str.Contains(t, "apple") or str.Contains(t, "macos")
end
@en "CanLinkTriple"
@fa "می‌توان سه‌تایی را پیوند داد"
pub func CanLinkTriple(t: str): bool:
if str.Len(t) == 0 or not LldAvailable():
ret false
end
win := str.Contains(t, "windows") or str.Contains(t, "mingw") or str.Contains(t, "win32")
gnu := str.Contains(t, "gnu") or str.Contains(t, "mingw")
musl := str.Contains(t, "linux") and str.Contains(t, "musl")
wasi := str.Contains(t, "wasm32") and str.Contains(t, "wasi")
ret (win and gnu) or musl or wasi
end
@en "LinkExternal"
@fa "پیوند خارجی"
pub func LinkExternal(obj: str, out_path: str, opts: Options): LinkResult:
linker := resolve_linker()
mut cmd := `"` + linker + `" "` + obj + `"`
repeat opts.extra_objects.len() in xo:
cmd += ` "` + opts.extra_objects.get(xo) + `"`
end
cmd += ` -o "` + out_path + `"`
repeat opts.lib_paths.len() in i:
cmd += ` -L"` + opts.lib_paths.get(i) + `"`
end
darwin := _target_is_darwin(opts)
repeat opts.link_libs.len() in i:
spec := opts.link_libs.get(i)
if str.Len(spec) == 0:
continue
end
if str.StartsWith(spec, "-") or str.Contains(spec, "/") or str.Contains(spec, "\\") or str.Contains(spec, "."):
cmd += ` "` + spec + `"`
continue
end
mut kind := ""
if i < opts.link_kinds.len():
kind = opts.link_kinds.get(i)
end
if str.Equals(kind, "framework"):
if darwin:
cmd += " -framework " + spec
end
continue
end
if str.Equals(kind, "static") and not darwin:
cmd += " -Wl,-Bstatic -l" + spec + " -Wl,-Bdynamic"
continue
end
cmd += " -l" + spec
end
cmd += " -lm"
if os.Run(cmd) == 0:
ret LinkResult { ok = true }
end
ret LinkResult { ok = false, err = "external link failed: " + cmd }
end
@en "HostLinkTriple"
@fa "سه‌تایی پیوند میزبان"
pub func HostLinkTriple(): str:
host := DefaultTriple()
if str.Len(host) == 0:
ret ""
end
if str.Contains(host, "windows") or str.Contains(host, "mingw") or str.Contains(host, "win32"):
if str.Contains(host, "msvc"):
ret ""
end
ret host
end
if not str.Contains(host, "linux"):
ret ""
end
mut arch := "x86_64"
if str.Contains(host, "aarch64") or str.Contains(host, "arm64"):
arch = "aarch64"
else str.Contains(host, "i686") or str.Contains(host, "i386") or str.Contains(host, "i586"):
arch = "i386"
else str.Contains(host, "arm"):
arch = "arm"
end
env := os.Env("SALAM_SYSROOTS")
if str.Len(env) == 0:
ret ""
end
if not os.Exists(filepath.Join(filepath.Join(env, arch + "-linux-musl"), "crt1.o")):
ret ""
end
ret (str.Equals(arch, "i386") ? "i686" : arch) + "-linux-musl"
end
@en "LinkElf"
@fa "پیوند ای ال اف"
pub func LinkElf(obj: str, out_path: str, opts: Options): LinkResult:
t := opts.target_triple
arch := elf_arch_of(t)
emul := elf_emul_of(t)
sr := musl_sysroot(opts.sysroot, arch)
crt1 := filepath.Join(sr, "crt1.o")
if not os.Exists(crt1):
ret LinkResult {
ok = false, err = "no musl sysroot for '" + t + "' (looked in " + sr + "): install musl-dev or bundle a sysroot ($SALAM_SYSROOTS)"
}
end
crti := filepath.Join(sr, "crti.o")
crtn := filepath.Join(sr, "crtn.o")
mut rt := filepath.Join(sr, "libclang_rt.builtins-" + arch + ".a")
if not os.Exists(rt):
rt = find_compiler_rt(arch)
end
have_gcc := os.Exists(filepath.Join(sr, "libgcc.a"))
mut argv := Vector {} as Vector<str>
defer argv.free()
argv.push("ld.lld")
argv.push("-m")
argv.push(emul)
argv.push("-static")
if not opts.debug_info:
argv.push("-s")
end
argv.push("-o")
argv.push(out_path)
argv.push(crt1)
argv.push(crti)
argv.push("-L" + sr)
repeat opts.lib_paths.len() in lpi:
argv.push("-L" + opts.lib_paths.get(lpi))
end
argv.push(obj)
repeat opts.extra_objects.len() in xo:
argv.push(opts.extra_objects.get(xo))
end
libs := user_libs_of(opts)
defer libs.free()
repeat libs.len() in i:
l := libs.get(i)
if musl_folds_into_libc(l):
continue
end
argv.push(l)
end
argv.push("--start-group")
argv.push("-lc")
if str.Len(rt) > 0:
argv.push(rt)
end
if have_gcc:
argv.push("-lgcc")
end
argv.push("--end-group")
argv.push(crtn)
if Link(LLD_ELF, argv_of(argv), argv.len()):
ret LinkResult { ok = true }
end
ret LinkResult { ok = false, err = "in-process lld link failed" }
end
@en "LinkWasi"
@fa "پیوند وازی"
pub func LinkWasi(obj: str, out_path: str, opts: Options): LinkResult:
lib := filepath.Join(opts.sysroot, "lib")
crt1 := filepath.Join(lib, "crt1-command.o")
if str.Len(opts.sysroot) == 0 or not os.Exists(crt1):
ret LinkResult {
ok = false, err = "no WASI sysroot (looked in '" + opts.sysroot + "'): use a salam build that embeds one, set $SALAM_SYSROOTS, or install wasi-sdk"
}
end
mut argv := Vector {} as Vector<str>
defer argv.free()
argv.push("wasm-ld")
argv.push("-m")
argv.push("wasm32")
argv.push("-L" + lib)
repeat opts.lib_paths.len() in lpi:
argv.push("-L" + opts.lib_paths.get(lpi))
end
argv.push(crt1)
argv.push(obj)
repeat opts.extra_objects.len() in xo:
argv.push(opts.extra_objects.get(xo))
end
libs := user_libs_of(opts)
defer libs.free()
repeat libs.len() in i:
l := libs.get(i)
if not str.Equals(l, "-lm") and not str.Equals(l, "-lc"):
argv.push(l)
end
end
argv.push("-lwasi-emulated-signal")
if not opts.debug_info:
argv.push("--strip-all")
end
argv.push("-lc")
rt := filepath.Join(lib, "libclang_rt.builtins.a")
if os.Exists(rt):
argv.push(rt)
end
argv.push("-o")
argv.push(out_path)
if Link(LLD_WASM, argv_of(argv), argv.len()):
ret LinkResult { ok = true }
end
ret LinkResult { ok = false, err = "in-process lld wasm link failed" }
end
@en "LinkMingw"
@fa "پیوند مینگو"
pub func LinkMingw(obj: str, out_path: str, opts: Options): LinkResult:
t := opts.target_triple
if not CanLinkTriple(t):
ret LinkResult { ok = false, err = "'" + t + "' is not a mingw target" }
end
arch := mingw_arch(t)
emul := mingw_emul(t)
sr := mingw_sysroot(opts.sysroot, arch)
crt2 := filepath.Join(sr, "lib/crt2.o")
if not os.Exists(crt2):
ret LinkResult {
ok = false, err = "no mingw sysroot for '" + t + "' (looked in " + sr + "): install mingw-w64 or bundle a sysroot ($SALAM_SYSROOTS)"
}
end
mut gccdir := filepath.Join(sr, "lib")
mut have_gcc := os.Exists(filepath.Join(gccdir, "libgcc.a"))
if not have_gcc:
found := find_mingw_gccdir(arch)
if str.Len(found) > 0:
gccdir = found
have_gcc = true
end
end
mut argv := Vector {} as Vector<str>
defer argv.free()
argv.push("ld.lld")
argv.push("-m")
argv.push(emul)
argv.push("-Bdynamic")
argv.push("--stack")
argv.push("8388608")
if not opts.debug_info:
argv.push("-s")
end
argv.push("-o")
argv.push(out_path)
argv.push(crt2)
if have_gcc:
argv.push(filepath.Join(gccdir, "crtbegin.o"))
argv.push("-L" + gccdir)
end
argv.push("-L" + filepath.Join(sr, "lib"))
argv.push("-L" + filepath.Join(sr, "mingw/lib"))
repeat opts.lib_paths.len() in lpi:
argv.push("-L" + opts.lib_paths.get(lpi))
end
argv.push(obj)
repeat opts.extra_objects.len() in xo:
argv.push(opts.extra_objects.get(xo))
end
libs := user_libs_of(opts)
defer libs.free()
repeat libs.len() in i:
argv.push(libs.get(i))
end
argv.push("--start-group")
argv.push("-lmingw32")
argv.push("-lgcc")
argv.push("-lgcc_eh")
argv.push("-lmoldname")
argv.push("-lmingwex")
argv.push("-lmsvcrt")
argv.push("-ladvapi32")
argv.push("-lshell32")
argv.push("-luser32")
argv.push("-lkernel32")
argv.push("--end-group")
if have_gcc:
argv.push(filepath.Join(gccdir, "crtend.o"))
end
if Link(LLD_MINGW, argv_of(argv), argv.len()):
ret LinkResult { ok = true }
end
ret LinkResult { ok = false, err = "in-process lld link failed" }
end
@en "LinkAuto"
@fa "پیوند خودکار"
pub func LinkAuto(obj: str, out_path: str, opts: Options): LinkResult:
t := opts.target_triple
if str.Len(t) == 0:
ret LinkResult { ok = false, err = "no target triple set" }
end
win := str.Contains(t, "windows") or str.Contains(t, "mingw") or str.Contains(t, "win32")
gnu := str.Contains(t, "gnu") or str.Contains(t, "mingw")
if win and gnu:
ret LinkMingw(obj, out_path, opts)
end
if str.Contains(t, "linux") and str.Contains(t, "musl"):
ret LinkElf(obj, out_path, opts)
end
if str.Contains(t, "wasm32") and str.Contains(t, "wasi"):
ret LinkWasi(obj, out_path, opts)
end
ret LinkResult { ok = false, err = "no in-process linker for triple '" + t + "'" }
end
