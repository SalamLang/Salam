@en "arabic"
@fa "عربی"
package arabic
import str
import unicode
@en "FoldLetters"
@fa "یکسان سازی حروف"
pub const FoldLetters := 1
@en "StripHarakat"
@fa "حذف اعراب"
pub const StripHarakat := 2
@en "StripTatweel"
@fa "حذف کشیده"
pub const StripTatweel := 4
@en "FoldDigits"
@fa "یکسان سازی رقم ها"
pub const FoldDigits := 8
@en "FoldAlef"
@fa "یکسان سازی الف"
pub const FoldAlef := 16
@en "FoldTehMarbuta"
@fa "یکسان سازی ته گرد"
pub const FoldTehMarbuta := 32
@en "StripZWNJ"
@fa "حذف نیم فاصله"
pub const StripZWNJ := 64
@en "FoldPresentation"
@fa "یکسان سازی شکل نمایشی"
pub const FoldPresentation := 128
const _TATWEEL := 0x0640
pure func _map_cp(cp: int, flags: int): int:
if (flags / StripTatweel) % 2 == 1 and cp == _TATWEEL: ret 0 - 1 end
if (flags / StripHarakat) % 2 == 1 and IsHaraka(cp): ret 0 - 1 end
if (flags / StripHarakat) % 2 == 1 and cp == 0x06C0: ret 0x0647 end
if (flags / StripZWNJ) % 2 == 1 and cp == unicode.ZWNJ: ret 0 - 1 end
if (flags / FoldLetters) % 2 == 1:
if cp == 0x0643: ret 0x06A9 end
if cp == 0x064A: ret 0x06CC end
if cp == 0x0649: ret 0x06CC end
if cp == 0x06D2: ret 0x06CC end
if cp == 0x06D3: ret 0x06CC end
if cp == 0x06AA: ret 0x06A9 end
if cp == 0x06AB: ret 0x06A9 end
end
if (flags / FoldAlef) % 2 == 1:
if cp == 0x0622 or cp == 0x0623 or cp == 0x0625 or cp == 0x0671: ret 0x0627 end
end
if (flags / FoldTehMarbuta) % 2 == 1:
if cp == 0x0629: ret 0x0647 end
end
ret cp
end
@en "IsArabicScript"
@fa "خط عربی است"
pub pure func IsArabicScript(cp: int): bool:
if unicode.Script(cp) == unicode.ScriptArabic: ret true end
ret IsHaraka(cp)
end
@en "IsHaraka"
@fa "اعراب است"
pub pure func IsHaraka(cp: int): bool:
if cp >= 0x0610 and cp <= 0x061A: ret true end
if cp >= 0x064B and cp <= 0x065F: ret true end
if cp == 0x0670: ret true end
if cp >= 0x06D6 and cp <= 0x06DC: ret true end
if cp >= 0x06DF and cp <= 0x06E4: ret true end
if cp >= 0x06E7 and cp <= 0x06E8: ret true end
if cp >= 0x06EA and cp <= 0x06ED: ret true end
if cp >= 0x08D3 and cp <= 0x08FF: ret true end
ret false
end
@en "IsTatweel"
@fa "کشیده است"
pub inline pure func IsTatweel(cp: int): bool:
ret cp == _TATWEEL
end
@en "Normalize"
@fa "هنجارسازی"
pub func Normalize(s: str, flags: int): str:
mut subject := s
if (flags / FoldPresentation) % 2 == 1:
subject = str.NFKC(s)
end
if (flags / FoldDigits) % 2 == 1:
subject = str.ToEnglishDigits(subject)
end
mut sb := str.NewBuilder()
defer str.BufFree(sb)
n := subject.len()
mut i := 0
mut cp := 0
until i < n:
i = str.CodePointAt(subject, i, cp)
if cp < 0: cp = 0xFFFD end
out := _map_cp(cp, flags)
if out >= 0: str.BufAppendCp(sb, out) end
end
ret str.BufStr(sb)
end
@en "NormalizePersian"
@fa "هنجارسازی فارسی"
pub func NormalizePersian(s: str): str:
ret Normalize(s, FoldPresentation + FoldLetters + StripTatweel)
end
@en "SearchKey"
@fa "کلید جستجو"
pub func SearchKey(s: str): str:
folded := Normalize(
s, FoldPresentation + FoldLetters + StripHarakat + StripTatweel + FoldDigits + FoldAlef + FoldTehMarbuta + StripZWNJ
)
ret str.Lower(folded)
end
@en "EqualLoose"
@fa "یکسان تقریبی"
pub func EqualLoose(a: str, b: str): bool:
ret SearchKey(a) == SearchKey(b)
end
@en "archive"
@fa "بایگانی"
package archive
import mem
import compress
import os
extern:
func fopen(path: str, mode: str): void*
func fclose(fp: void*): int
func fread(ptr: void*, size: u64, nmemb: u64, stream: void*): u64
func fwrite(ptr: void*, size: u64, nmemb: u64, stream: void*): u64
func fseek(fp: void*, off: int, whence: int): int
func ftell(fp: void*): int
end
@en "Entry"
@fa "مدخل"
pub struct Entry:
pub name: str = ""
pub size: i64 = 0 as i64
pub compressed_size: i64 = 0 as i64
pub is_dir: bool = false
pub method: int = 0
pub crc32: u32 = 0 as u32
pub mtime: i64 = 0 as i64
end
func _safe_entry_name(name: str): bool:
n := name.len()
if n == 0:
ret false
end
bp := name as u8*
first := bp[0] as int
if first == 47 or first == 92 or (n >= 2 and (bp[1] as int) == 58):
ret false
end
mut start := 0
mut i := 0
until i <= n:
c := i < n ? bp[i] as int : 47
if c == 47 or c == 92:
if i - start == 2 and (bp[start] as int) == 46 and (bp[start + 1] as int) == 46:
ret false
end
start = i + 1
end
i += 1
end
ret true
end
@en "ReadBinaryFile"
@fa "خواندن پرونده دودویی"
pub func ReadBinaryFile(path: str, ok &: bool): compress.ByteBuf:
ok = false
fp := fopen(path, "rb")
if fp == null:
ret compress.NewByteBuf()
end
fseek(fp, 0, 2)
size := ftell(fp)
fseek(fp, 0, 0)
mut buf := compress.NewByteBufCap(size)
if size > 0:
raw := mem.Allocate(size as u64)
got := fread(raw, 1 as u64, size as u64, fp)
compress.BufPushBytes(buf, raw, got as int)
mem.Free(raw)
end
fclose(fp)
ok = true
ret buf
end
@en "WriteBinaryFile"
@fa "نوشتن پرونده دودویی"
pub func WriteBinaryFile(path: str, p: void*, n: int): bool:
fp := fopen(path, "wb")
if fp == null:
ret false
end
mut written := 0 as u64
if n > 0:
written = fwrite(p, 1 as u64, n as u64, fp)
end
fclose(fp)
ret (written as int) == n
end
@en "WriteBinaryFileBuf"
@fa "نوشتن پرونده دودویی از بافر"
pub func WriteBinaryFileBuf(path: str, b: compress.ByteBuf): bool:
ret WriteBinaryFile(path, b.data, b.len)
end
@en "EnsureDir"
@fa "اطمینان از پوشه"
pub func EnsureDir(dir: str):
if dir.len() == 0: ret end
if os.Exists(dir): ret end
os.MkdirAll(dir)
end
@en "LEGet16"
@fa "خواندن شانزده بیتی کم ارزش‌اول"
pub func LEGet16(p: void*, off: int): int:
bp := p as u8*
ret (bp[off] as int) | ((bp[off + 1] as int) << 8)
end
@en "LEGet32"
@fa "خواندن عدد۳۲ کم ارزش‌اول"
pub func LEGet32(p: void*, off: int): int:
bp := p as u8*
ret (bp[off] as int) | ((bp[off + 1] as int) << 8) | ((bp[off + 2] as int) << 16) | ((bp[off + 3] as int) << 24)
end
@en "LEPut16"
@fa "نوشتن شانزده بیتی کم ارزش‌اول"
pub func LEPut16(b &: compress.ByteBuf, v: int):
compress.BufPush(b, v & 255)
compress.BufPush(b, (v >> 8) & 255)
end
@en "LEPut32"
@fa "نوشتن عدد۳۲ کم ارزش‌اول"
pub func LEPut32(b &: compress.ByteBuf, v: int):
compress.BufPush(b, v & 255)
compress.BufPush(b, (v >> 8) & 255)
compress.BufPush(b, (v >> 16) & 255)
compress.BufPush(b, (v >> 24) & 255)
end
@en "FreeEntries"
@fa "آزادسازی فهرست"
pub func FreeEntries(v &: Vector<Entry>):
repeat v.len() in i:
nm := v.get(i).name
if nm.len() > 0: mem.Free(nm as void*) end
end
v.free()
end
package archive
import compress
@en "GzipCompressFile"
@fa "فشرده سازی پرونده جی زیپ"
pub func GzipCompressFile(inpath: str, outpath: str): bool:
mut rok := false
inbuf := ReadBinaryFile(inpath, rok)
if not rok:
ret false
end
mut out := compress.GzipCompress(inbuf.data, inbuf.len)
wok := WriteBinaryFileBuf(outpath, out)
compress.BufFree(inbuf)
compress.BufFree(out)
ret wok
end
@en "GzipDecompressFile"
@fa "کدگشایی پرونده جی زیپ"
pub func GzipDecompressFile(inpath: str, outpath: str): bool:
mut rok := false
inbuf := ReadBinaryFile(inpath, rok)
if not rok:
ret false
end
mut gok := false
mut out := compress.GzipDecompress(inbuf.data, inbuf.len, gok)
compress.BufFree(inbuf)
if not gok:
compress.BufFree(out)
ret false
end
wok := WriteBinaryFileBuf(outpath, out)
compress.BufFree(out)
ret wok
end
package archive
import compress
import filepath
import mem
const _RAR4_SIG_LEN := 7
const _RAR5_SIG_LEN := 8
func _rar4_sig_match(p: void*, n: int): bool:
if n < _RAR4_SIG_LEN: ret false end
bp := p as u8*
ret bp[0] as int == 0x52 and bp[1] as int == 0x61 and bp[2] as int == 0x72 and bp[3] as int == 0x21 and bp[4] as int == 0x1a and bp[5] as int == 0x07 and bp[6] as int == 0x00
end
func _rar5_sig_match(p: void*, n: int): bool:
if n < _RAR5_SIG_LEN: ret false end
bp := p as u8*
ret bp[0] as int == 0x52 and bp[1] as int == 0x61 and bp[2] as int == 0x72 and bp[3] as int == 0x21 and bp[4] as int == 0x1a and bp[5] as int == 0x07 and bp[6] as int == 0x01 and bp[7] as int == 0x00
end
func _rar_bytes_to_str(p: void*, off: int, n: int): str:
mut buf := compress.NewByteBuf()
compress.BufPushBytes(buf, ((p as i64) + (off as i64)) as void*, n)
s := compress.BufToStrUnsafe(buf)
compress.BufFree(buf)
ret s
end
func _rar_free_name(s: str):
if s.len() > 0:
mem.Free(s as void*)
end
end
func _rar4_read_file_fields(p: void*, block_start: int, pack_size_out &: int, unp_size_out &: int, method_out &: int, flags_out &: int, name_out &: str): int:
bp := p as u8*
flags_out = (bp[block_start + 3] as int) | ((bp[block_start + 4] as int) << 8)
head_size := (bp[block_start + 5] as int) | ((bp[block_start + 6] as int) << 8)
f := block_start + 7
pack_size_out = LEGet32(p, f)
unp_size_out = LEGet32(p, f + 4)
method_out = bp[f + 18] as int
name_size := LEGet16(p, f + 19)
name_off := f + 25
name_out = _rar_bytes_to_str(p, name_off, name_size)
ret head_size
end
func _rar5_vint(p: void*, pos: int, len_out &: int): i64:
bp := p as u8*
mut result := 0 as i64
mut shift := 0
mut i := 0
until i < 10:
b := bp[pos + i] as int
result = result | (((b & 0x7f) as i64) << shift)
i += 1
if (b & 0x80) == 0:
len_out = i
ret result
end
shift += 7
end
len_out = i
ret result
end
func _rar5_parse_block(p: void*, block_start: int, n: int, header_type_out &: int, total_size_out &: int, is_dir_out &: bool, unp_size_out &: int, method_out &: int, name_out &: str, data_offset_out &: int, data_size_out &: int): bool:
if block_start + 5 > n:
ret false
end
mut hsize_len := 0
hsize := _rar5_vint(p, block_start + 4, hsize_len) as int
header_data_start := block_start + 4 + hsize_len
if header_data_start + hsize > n:
ret false
end
mut cur := header_data_start
mut vlen := 0
header_type := _rar5_vint(p, cur, vlen) as int
cur += vlen
header_flags := _rar5_vint(p, cur, vlen) as int
cur += vlen
if (header_flags & 0x01) != 0:
_extra_size := _rar5_vint(p, cur, vlen)
cur += vlen
end
mut data_size := 0
if (header_flags & 0x02) != 0:
data_size = _rar5_vint(p, cur, vlen) as int
cur += vlen
end
header_type_out = header_type
data_size_out = data_size
is_dir_out = false
unp_size_out = 0
method_out = 0
name_out = ""
data_offset_out = header_data_start + hsize
if header_type == 2 or header_type == 3:
file_flags := _rar5_vint(p, cur, vlen) as int
cur += vlen
unp_size := _rar5_vint(p, cur, vlen) as int
cur += vlen
_attr := _rar5_vint(p, cur, vlen)
cur += vlen
if (file_flags & 0x02) != 0:
cur += 4
end
if (file_flags & 0x04) != 0:
cur += 4
end
compinfo := _rar5_vint(p, cur, vlen) as int
cur += vlen
_host_os := _rar5_vint(p, cur, vlen)
cur += vlen
name_size := _rar5_vint(p, cur, vlen) as int
cur += vlen
name_out = _rar_bytes_to_str(p, cur, name_size)
is_dir_out = (file_flags & 0x01) != 0
unp_size_out = unp_size
method_out = (compinfo >> 7) & 7
end
total_size_out = (header_data_start - block_start) + hsize + data_size
ret true
end
func _rar4_list(p: void*, n: int, out &: Vector<Entry>):
bp := p as u8*
mut pos := _RAR4_SIG_LEN
until pos + 7 <= n:
head_type := bp[pos + 2] as int
head_size := (bp[pos + 5] as int) | ((bp[pos + 6] as int) << 8)
if head_size < 7:
break
end
if head_type == 0x7b:
break
end
if head_type == 0x74:
mut pack_size := 0
mut unp_size := 0
mut method := 0
mut flags := 0
mut name := ""
_rar4_read_file_fields(p, pos, pack_size, unp_size, method, flags, name)
e := Entry {
name = name
size = unp_size as i64
compressed_size = pack_size as i64
is_dir = false
method = method
crc32 = 0 as u32
mtime = 0 as i64
}
out.push(e)
pos += head_size + pack_size
else:
pos += head_size
end
end
end
func _rar5_list(p: void*, n: int, out &: Vector<Entry>):
mut pos := _RAR5_SIG_LEN
until pos < n:
mut header_type := 0
mut total_size := 0
mut is_dir := false
mut unp_size := 0
mut method := 0
mut name := ""
mut data_offset := 0
mut data_size := 0
good := _rar5_parse_block(p, pos, n, header_type, total_size, is_dir, unp_size, method, name, data_offset, data_size)
if good and total_size > 0 and header_type == 2 and name.len() > 0:
e := Entry {
name = name
size = unp_size as i64
compressed_size = data_size as i64
is_dir = is_dir
method = method
crc32 = 0 as u32
mtime = 0 as i64
}
out.push(e)
else:
_rar_free_name(name)
end
if not good or total_size <= 0:
break
end
if header_type == 5:
break
end
pos += total_size
end
end
func _rar4_extract(p: void*, n: int, name: str, out &: compress.ByteBuf, ok &: bool):
bp := p as u8*
mut pos := _RAR4_SIG_LEN
until pos + 7 <= n:
head_type := bp[pos + 2] as int
head_size := (bp[pos + 5] as int) | ((bp[pos + 6] as int) << 8)
if head_size < 7:
break
end
if head_type == 0x7b:
break
end
if head_type == 0x74:
mut pack_size := 0
mut unp_size := 0
mut method := 0
mut flags := 0
mut nm := ""
_rar4_read_file_fields(p, pos, pack_size, unp_size, method, flags, nm)
hit := nm == name
_rar_free_name(nm)
if hit:
if (flags & 0x0004) != 0:
ret
end
if method != 0x30:
ret
end
data_ptr := ((p as i64) + ((pos + head_size) as i64)) as void*
compress.BufPushBytes(out, data_ptr, pack_size)
ok = true
ret
end
pos += head_size + pack_size
else:
pos += head_size
end
end
end
func _rar5_extract(p: void*, n: int, name: str, out &: compress.ByteBuf, ok &: bool):
mut pos := _RAR5_SIG_LEN
until pos < n:
mut header_type := 0
mut total_size := 0
mut is_dir := false
mut unp_size := 0
mut method := 0
mut nm := ""
mut data_offset := 0
mut data_size := 0
good := _rar5_parse_block(p, pos, n, header_type, total_size, is_dir, unp_size, method, nm, data_offset, data_size)
hit := header_type == 2 and nm == name and not is_dir
_rar_free_name(nm)
if not good or total_size <= 0:
break
end
if header_type == 5:
break
end
if hit:
if method != 0:
ret
end
data_ptr := ((p as i64) + (data_offset as i64)) as void*
compress.BufPushBytes(out, data_ptr, data_size)
ok = true
ret
end
pos += total_size
end
end
@en "IsRar"
@fa "آر ای آر است"
pub func IsRar(p: void*, n: int): bool:
ret _rar4_sig_match(p, n) or _rar5_sig_match(p, n)
end
@en "RarList"
@fa "فهرست آر ای آر"
pub func RarList(p: void*, n: int): Vector<Entry>:
mut out := Vector {} as Vector<Entry>
if _rar4_sig_match(p, n):
_rar4_list(p, n, out)
else:
if _rar5_sig_match(p, n):
_rar5_list(p, n, out)
end
end
ret out
end
@en "RarExtractByName"
@fa "استخراج با نام از آر ای آر"
pub func RarExtractByName(p: void*, n: int, name: str, ok &: bool): compress.ByteBuf:
ok = false
mut out := compress.NewByteBuf()
if _rar4_sig_match(p, n):
_rar4_extract(p, n, name, out, ok)
else:
if _rar5_sig_match(p, n):
_rar5_extract(p, n, name, out, ok)
end
end
ret out
end
@en "RarExtractAll"
@fa "استخراج همه از آر ای آر"
pub func RarExtractAll(p: void*, n: int, destdir: str): bool:
entries := RarList(p, n)
mut all_ok := true
mut i := 0
until i < entries.len():
e := entries.get(i)
if not _safe_entry_name(e.name):
all_ok = false
i += 1
continue
end
outpath := filepath.Join(destdir, e.name)
if e.is_dir:
EnsureDir(outpath)
else:
parent := filepath.Dir(outpath)
EnsureDir(parent)
mem.Free(parent as void*)
mut ok := false
data := RarExtractByName(p, n, e.name, ok)
if ok:
if not WriteBinaryFileBuf(outpath, data):
all_ok = false
end
else:
all_ok = false
end
compress.BufFree(data)
end
mem.Free(outpath as void*)
i += 1
end
defer FreeEntries(entries)
ret all_ok
end
package archive
import compress
import mem
import filepath
@en "TarFileInput"
@fa "ورودی پرونده تار"
pub struct TarFileInput:
pub name: str = ""
pub data_ptr: void* = null
pub data_len: int = 0
pub is_dir: bool = false
end
func _tar_put_octal(b &: compress.ByteBuf, value: i64, width: int):
ndigits := width - 1
mut digits: int[16]
mut v := value
mut i := ndigits - 1
until i >= 0:
digits[i] = (v % (8 as i64)) as int
v = v / (8 as i64)
i -= 1
end
mut k := 0
until k < ndigits:
compress.BufPush(b, 48 + digits[k])
k += 1
end
compress.BufPush(b, 0)
end
func _tar_get_octal(p: void*, off: int, width: int): i64:
bp := p as u8*
mut v := 0 as i64
mut i := 0
until i < width:
c := bp[off + i] as int
if c >= 48 and c <= 55:
v = v * (8 as i64) + ((c - 48) as i64)
end
i += 1
end
ret v
end
func _tar_put_str(b &: compress.ByteBuf, s: str, width: int):
n := s.len()
mut w := n
if w > width: w = width end
compress.BufPushBytes(b, s as void*, w)
mut pad := width - w
until pad > 0:
compress.BufPush(b, 0)
pad -= 1
end
end
func _tar_get_str(p: void*, off: int, width: int): str:
bp := p as u8*
mut len := 0
until len < width and (bp[off + len] as int) != 0:
len += 1
end
mut buf := compress.NewByteBuf()
compress.BufPushBytes(buf, ((p as i64) + (off as i64)) as void*, len)
s := compress.BufToStrUnsafe(buf)
compress.BufFree(buf)
ret s
end
func _tar_free_str(name: str):
if name.len() > 0: mem.Free(name as void*) end
end
func _tar_checksum(header: void*): int:
bp := header as u8*
mut sum := 0
mut i := 0
until i < 512:
if i >= 148 and i < 156:
sum += 32
else:
sum += bp[i] as int
end
i += 1
end
ret sum
end
func _tar_is_zero_block(p: void*, pos: int): bool:
bp := p as u8*
mut i := 0
until i < 512:
if (bp[pos + i] as int) != 0:
ret false
end
i += 1
end
ret true
end
func _tar_write_header(out &: compress.ByteBuf, f: TarFileInput):
mut h := compress.NewByteBuf()
_tar_put_str(h, f.name, 100)
_tar_put_octal(h, 0o644 as i64, 8)
_tar_put_octal(h, 0 as i64, 8)
_tar_put_octal(h, 0 as i64, 8)
mut sz := f.data_len
if f.is_dir: sz = 0 end
_tar_put_octal(h, sz as i64, 12)
_tar_put_octal(h, 0 as i64, 12)
repeat 8: compress.BufPush(h, 32) end
mut typeflag := 48
if f.is_dir: typeflag = 53 end
compress.BufPush(h, typeflag)
_tar_put_str(h, "", 100)
_tar_put_str(h, "ustar", 6)
compress.BufPush(h, 48)
compress.BufPush(h, 48)
_tar_put_str(h, "", 32)
_tar_put_str(h, "", 32)
_tar_put_octal(h, 0 as i64, 8)
_tar_put_octal(h, 0 as i64, 8)
_tar_put_str(h, "", 155)
repeat 12: compress.BufPush(h, 0) end
sum := _tar_checksum(h.data)
mut tmp := compress.NewByteBuf()
_tar_put_octal(tmp, sum as i64, 7)
mut k := 0
until k < 6:
compress.BufSet(h, 148 + k, compress.BufGet(tmp, k))
k += 1
end
compress.BufSet(h, 148 + 6, 0)
compress.BufSet(h, 148 + 7, 32)
compress.BufFree(tmp)
compress.BufPushBuf(out, h)
compress.BufFree(h)
end
@en "MakeTarFileInput"
@fa "ساخت ورودی پرونده تار"
pub func MakeTarFileInput(name: str, data_ptr: void*, data_len: int, is_dir: bool): TarFileInput:
ret TarFileInput { name = name, data_ptr = data_ptr, data_len = data_len, is_dir = is_dir }
end
@en "TarCreate"
@fa "ساخت تار"
pub func TarCreate(files: Vector<TarFileInput>): compress.ByteBuf:
mut out := compress.NewByteBuf()
mut i := 0
until i < files.len():
f := files.get(i)
_tar_write_header(out, f)
if not f.is_dir:
compress.BufPushBytes(out, f.data_ptr, f.data_len)
pad := f.data_len % 512
if pad > 0:
mut k := 0
until k < 512 - pad:
compress.BufPush(out, 0)
k += 1
end
end
end
i += 1
end
repeat 1024: compress.BufPush(out, 0) end
ret out
end
@en "TarCreateFile"
@fa "ساخت پرونده تار"
pub func TarCreateFile(files: Vector<TarFileInput>, outpath: str): bool:
mut out := TarCreate(files)
ok := WriteBinaryFileBuf(outpath, out)
compress.BufFree(out)
ret ok
end
@en "TarList"
@fa "فهرست تار"
pub func TarList(p: void*, n: int): Vector<Entry>:
mut out := Vector {} as Vector<Entry>
mut pos := 0
until pos + 512 <= n:
if _tar_is_zero_block(p, pos):
break
end
nm := _tar_get_str(p, pos, 100)
if nm.len() == 0:
break
end
size := _tar_get_octal(p, pos + 124, 12)
if size < (0 as i64) or (pos as i64) + (512 as i64) + size > (n as i64):
_tar_free_str(nm)
break
end
mtime := _tar_get_octal(p, pos + 136, 12)
bp := p as u8*
typeflag := bp[pos + 156] as int
is_dir := typeflag == 53
e := Entry {
name = nm
size = size
compressed_size = size
is_dir = is_dir
method = 0
crc32 = 0 as u32
mtime = mtime
}
out.push(e)
pos += 512
if not is_dir:
datasize := size as int
pos += datasize
pad := datasize % 512
if pad > 0:
pos += 512 - pad
end
end
end
ret out
end
@en "TarExtractByName"
@fa "استخراج با نام از تار"
pub func TarExtractByName(p: void*, n: int, name: str, ok &: bool): compress.ByteBuf:
ok = false
mut out := compress.NewByteBuf()
mut pos := 0
until pos + 512 <= n:
if _tar_is_zero_block(p, pos):
break
end
nm := _tar_get_str(p, pos, 100)
empty := nm.len() == 0
size := _tar_get_octal(p, pos + 124, 12)
bp := p as u8*
typeflag := bp[pos + 156] as int
is_dir := typeflag == 53
datasize := size as int
hit := not empty and nm == name and not is_dir
_tar_free_str(nm)
if empty or size < (0 as i64) or (pos as i64) + (512 as i64) + size > (n as i64):
break
end
if hit:
data_ptr := ((p as i64) + ((pos + 512) as i64)) as void*
compress.BufPushBytes(out, data_ptr, datasize)
ok = true
ret out
end
pos += 512
if not is_dir:
pos += datasize
pad := datasize % 512
if pad > 0:
pos += 512 - pad
end
end
end
ret out
end
@en "TarExtractAll"
@fa "استخراج همه از تار"
pub func TarExtractAll(p: void*, n: int, destdir: str): bool:
entries := TarList(p, n)
mut all_ok := true
mut i := 0
until i < entries.len():
e := entries.get(i)
if not _safe_entry_name(e.name):
all_ok = false
i += 1
continue
end
outpath := filepath.Join(destdir, e.name)
if e.is_dir:
EnsureDir(outpath)
else:
parent := filepath.Dir(outpath)
EnsureDir(parent)
mem.Free(parent as void*)
mut ok := false
data := TarExtractByName(p, n, e.name, ok)
if ok:
if not WriteBinaryFileBuf(outpath, data):
all_ok = false
end
else:
all_ok = false
end
compress.BufFree(data)
end
mem.Free(outpath as void*)
i += 1
end
defer FreeEntries(entries)
ret all_ok
end
package archive
import compress
import filepath
import mem
import str
@en "ZipFileInput"
@fa "ورودی پرونده زیپ"
pub struct ZipFileInput:
pub name: str = ""
pub data_ptr: void* = null
pub data_len: int = 0
pub method: int = 8
end
func _zip_find_eocd(p: void*, n: int, eocd_pos_out &: int): bool:
if n < 22:
ret false
end
mut search_start := n - 22 - 65535
if search_start < 0: search_start = 0 end
mut i := n - 22
until i >= search_start:
if LEGet32(p, i) == 0x06054b50:
eocd_pos_out = i
ret true
end
i -= 1
end
ret false
end
func _zip_in(off: int, len: int, n: int): bool:
ret off >= 0 and len >= 0 and (off as i64) + (len as i64) <= (n as i64)
end
func _zip_read_name(p: void*, off: int, name_len: int): str:
mut nmbuf := compress.NewByteBuf()
name_ptr := ((p as i64) + (off as i64)) as void*
compress.BufPushBytes(nmbuf, name_ptr, name_len)
nm := compress.BufToStrUnsafe(nmbuf)
compress.BufFree(nmbuf)
ret nm
end
func _zip_free_name(name: str):
if str.Len(name) > 0: mem.Free(name as void*) end
end
func _zip_is_dir_name(name: str): bool:
n := name.len()
if n == 0: ret false end
ret str.EndsWith(name, "/")
end
func _zip_extract_by_name(p: void*, n: int, name: str, max: int, ok &: bool): compress.ByteBuf:
ok = false
mut out := compress.NewByteBuf()
mut eocd_pos := 0
if not _zip_find_eocd(p, n, eocd_pos):
ret out
end
count := LEGet16(p, eocd_pos + 10)
cd_offset := LEGet32(p, eocd_pos + 16)
mut pos := cd_offset
mut k := 0
until k < count:
if not _zip_in(pos, 46, n) or LEGet32(p, pos) != 0x02014b50:
break
end
if not _zip_in(pos + 46, LEGet16(p, pos + 28), n):
break
end
flags := LEGet16(p, pos + 8)
method := LEGet16(p, pos + 10)
comp_size := LEGet32(p, pos + 20)
uncomp_size := LEGet32(p, pos + 24)
name_len := LEGet16(p, pos + 28)
extra_len := LEGet16(p, pos + 30)
comment_len := LEGet16(p, pos + 32)
local_offset := LEGet32(p, pos + 42)
nm := _zip_read_name(p, pos + 46, name_len)
hit := nm == name
_zip_free_name(nm)
if hit:
if (flags & 1) != 0 or not _zip_in(local_offset, 30, n):
ret out
end
lname_len := LEGet16(p, local_offset + 26)
lextra_len := LEGet16(p, local_offset + 28)
data_start := local_offset + 30 + lname_len + lextra_len
if not _zip_in(data_start, comp_size, n):
ret out
end
data_ptr := ((p as i64) + (data_start as i64)) as void*
if max > 0 and uncomp_size > max:
ret out
end
if method == 0:
if max > 0 and comp_size > max:
ret out
end
compress.BufPushBytes(out, data_ptr, comp_size)
ok = true
else:
if method == 8:
mut infl_ok := false
result := compress.RawInflateMax(data_ptr, comp_size, uncomp_size < 0 ? 0 : uncomp_size, max, infl_ok)
if infl_ok:
compress.BufFree(out)
out = result
ok = true
else:
compress.BufFree(result)
end
end
end
ret out
end
pos += 46 + name_len + extra_len + comment_len
k += 1
end
ret out
end
@en "MakeZipFileInput"
@fa "ساخت ورودی پرونده زیپ"
pub func MakeZipFileInput(name: str, data_ptr: void*, data_len: int, method: int): ZipFileInput:
ret ZipFileInput { name = name, data_ptr = data_ptr, data_len = data_len, method = method }
end
@en "ZipCreate"
@fa "ساخت زیپ"
pub func ZipCreate(files: Vector<ZipFileInput>): compress.ByteBuf:
mut body := compress.NewByteBuf()
mut central := compress.NewByteBuf()
mut count := 0
mut i := 0
until i < files.len():
f := files.get(i)
crc := compress.CRC32(f.data_ptr, f.data_len)
mut comp_ptr := f.data_ptr
mut comp_len := f.data_len
mut owned := compress.NewByteBuf()
mut has_owned := false
if f.method == 8:
owned = compress.RawDeflate(f.data_ptr, f.data_len)
comp_ptr = owned.data
comp_len = owned.len
has_owned = true
end
offset := compress.BufLen(body)
name_len := f.name.len()
LEPut32(body, 0x04034b50)
LEPut16(body, 20)
LEPut16(body, 0)
LEPut16(body, f.method)
LEPut16(body, 0)
LEPut16(body, 0x21)
LEPut32(body, crc as int)
LEPut32(body, comp_len)
LEPut32(body, f.data_len)
LEPut16(body, name_len)
LEPut16(body, 0)
compress.BufPushBytes(body, f.name as void*, name_len)
compress.BufPushBytes(body, comp_ptr, comp_len)
LEPut32(central, 0x02014b50)
LEPut16(central, 20)
LEPut16(central, 20)
LEPut16(central, 0)
LEPut16(central, f.method)
LEPut16(central, 0)
LEPut16(central, 0x21)
LEPut32(central, crc as int)
LEPut32(central, comp_len)
LEPut32(central, f.data_len)
LEPut16(central, name_len)
LEPut16(central, 0)
LEPut16(central, 0)
LEPut16(central, 0)
LEPut16(central, 0)
LEPut32(central, 0)
LEPut32(central, offset)
compress.BufPushBytes(central, f.name as void*, name_len)
if has_owned:
compress.BufFree(owned)
end
count += 1
i += 1
end
mut out := compress.NewByteBuf()
compress.BufPushBuf(out, body)
cd_offset := compress.BufLen(out)
compress.BufPushBuf(out, central)
cd_size := compress.BufLen(central)
compress.BufFree(body)
compress.BufFree(central)
LEPut32(out, 0x06054b50)
LEPut16(out, 0)
LEPut16(out, 0)
LEPut16(out, count)
LEPut16(out, count)
LEPut32(out, cd_size)
LEPut32(out, cd_offset)
LEPut16(out, 0)
ret out
end
@en "ZipCreateFile"
@fa "ساخت پرونده زیپ"
pub func ZipCreateFile(files: Vector<ZipFileInput>, outpath: str): bool:
mut out := ZipCreate(files)
ok := WriteBinaryFileBuf(outpath, out)
compress.BufFree(out)
ret ok
end
@en "ZipList"
@fa "فهرست زیپ"
pub func ZipList(p: void*, n: int): Vector<Entry>:
mut out := Vector {} as Vector<Entry>
mut eocd_pos := 0
if not _zip_find_eocd(p, n, eocd_pos):
ret out
end
count := LEGet16(p, eocd_pos + 10)
cd_offset := LEGet32(p, eocd_pos + 16)
mut pos := cd_offset
mut k := 0
until k < count:
if not _zip_in(pos, 46, n) or LEGet32(p, pos) != 0x02014b50:
break
end
if not _zip_in(pos + 46, LEGet16(p, pos + 28), n):
break
end
method := LEGet16(p, pos + 10)
crc := LEGet32(p, pos + 16)
comp_size := LEGet32(p, pos + 20)
uncomp_size := LEGet32(p, pos + 24)
name_len := LEGet16(p, pos + 28)
extra_len := LEGet16(p, pos + 30)
comment_len := LEGet16(p, pos + 32)
nm := _zip_read_name(p, pos + 46, name_len)
e := Entry {
name = nm
size = uncomp_size as i64
compressed_size = comp_size as i64
is_dir = _zip_is_dir_name(nm)
method = method
crc32 = crc as u32
mtime = 0 as i64
}
out.push(e)
pos += 46 + name_len + extra_len + comment_len
k += 1
end
ret out
end
@en "ZipExtractByName"
@fa "استخراج با نام از زیپ"
pub func ZipExtractByName(p: void*, n: int, name: str, ok &: bool): compress.ByteBuf:
ret _zip_extract_by_name(p, n, name, 0, ok)
end
@en "ZipExtractByNameMax"
@fa "استخراج با نام از زیپ با سقف"
pub func ZipExtractByNameMax(p: void*, n: int, name: str, max: int, ok &: bool): compress.ByteBuf:
ret _zip_extract_by_name(p, n, name, max, ok)
end
@en "ZipExtractAll"
@fa "استخراج همه از زیپ"
pub func ZipExtractAll(p: void*, n: int, destdir: str): bool:
entries := ZipList(p, n)
mut all_ok := true
mut i := 0
until i < entries.len():
e := entries.get(i)
if not _safe_entry_name(e.name):
all_ok = false
i += 1
continue
end
outpath := filepath.Join(destdir, e.name)
if e.is_dir:
EnsureDir(outpath)
else:
parent := filepath.Dir(outpath)
EnsureDir(parent)
mem.Free(parent as void*)
mut ok := false
data := ZipExtractByName(p, n, e.name, ok)
if ok:
if not WriteBinaryFileBuf(outpath, data):
all_ok = false
end
else:
all_ok = false
end
compress.BufFree(data)
end
mem.Free(outpath as void*)
i += 1
end
defer FreeEntries(entries)
ret all_ok
end
@en "atomic"
@fa "اتمی"
package atomic
import mem
import sync
@en "I64"
@fa "صحیح۶۴"
pub struct I64:
pub cell: i64* = null
pub mu: sync.Mutex = sync.Mutex {}
end
@en "Flag"
@fa "پرچم"
pub struct Flag:
pub cell: i64* = null
pub mu: sync.Mutex = sync.Mutex {}
end
if defined(SALAM_CC_TCC):
func cell_new(v: i64): I64:
c := mem.AllocateZeroed(8 as u64) as i64*
c[0] = v
ret I64 { cell = c, mu = sync.NewMutex() }
end
func cell_load(a: I64): i64:
c := a.cell
sync.Lock(a.mu)
v := c[0]
sync.Unlock(a.mu)
ret v
end
func cell_store(a: I64, v: i64):
c := a.cell
sync.Lock(a.mu)
c[0] = v
sync.Unlock(a.mu)
end
func cell_add(a: I64, delta: i64): i64:
c := a.cell
sync.Lock(a.mu)
c[0] = c[0] + delta
v := c[0]
sync.Unlock(a.mu)
ret v
end
func cell_swap(a: I64, v: i64): i64:
c := a.cell
sync.Lock(a.mu)
old := c[0]
c[0] = v
sync.Unlock(a.mu)
ret old
end
func cell_cas(a: I64, expected: i64, next: i64): bool:
c := a.cell
sync.Lock(a.mu)
mut won := false
if c[0] == expected:
c[0] = next
won = true
end
sync.Unlock(a.mu)
ret won
end
func cell_free(a: I64):
mem.Free(a.cell as void*)
sync.Destroy(a.mu)
end
else:
func cell_new(v: i64): I64:
c := mem.AllocateZeroed(8 as u64) as i64*
atomic_store(c, v)
ret I64 { cell = c, mu = sync.Mutex {} }
end
func cell_load(a: I64): i64: ret atomic_load(a.cell) end
func cell_store(a: I64, v: i64): atomic_store(a.cell, v) end
func cell_add(a: I64, delta: i64): i64: ret atomic_add(a.cell, delta) end
func cell_swap(a: I64, v: i64): i64: ret atomic_swap(a.cell, v) end
func cell_cas(a: I64, expected: i64, next: i64): bool:
ret atomic_cas(a.cell, expected, next)
end
func cell_free(a: I64): mem.Free(a.cell as void*) end
end
@en "NewI64"
@fa "صحیح۶۴ جدید"
pub func NewI64(v: i64): I64: ret cell_new(v) end
@en "Load"
@fa "بارگذاری"
pub func Load(a: I64): i64: ret cell_load(a) end
@en "Store"
@fa "ذخیره"
pub func Store(a: I64, v: i64): cell_store(a, v) end
@en "Add"
@fa "افزودن"
pub func Add(a: I64, delta: i64): i64: ret cell_add(a, delta) end
@en "Swap"
@fa "تعویض"
pub func Swap(a: I64, v: i64): i64: ret cell_swap(a, v) end
@en "CompareAndSwap"
@fa "مقایسه سپس تعویض"
pub func CompareAndSwap(a: I64, expected: i64, next: i64): bool:
ret cell_cas(a, expected, next)
end
@en "DestroyI64"
@fa "نابودسازی صحیح۶۴"
pub func DestroyI64(a: I64): cell_free(a) end
@en "NewFlag"
@fa "پرچم جدید"
pub func NewFlag(v: bool): Flag:
mut n := 0 as i64
if v: n = 1 end
c := cell_new(n)
ret Flag { cell = c.cell, mu = c.mu }
end
@en "Get"
@fa "گرفتن"
pub func Get(f: Flag): bool:
ret cell_load(I64 { cell = f.cell, mu = f.mu }) != 0
end
@en "Set"
@fa "تنظیم"
pub func Set(f: Flag, v: bool):
mut n := 0 as i64
if v: n = 1 end
cell_store(I64 { cell = f.cell, mu = f.mu }, n)
end
@en "TestAndSet"
@fa "آزمون سپس تنظیم"
pub func TestAndSet(f: Flag): bool:
ret cell_cas(I64 { cell = f.cell, mu = f.mu }, 0 as i64, 1 as i64)
end
@en "DestroyFlag"
@fa "نابودسازی پرچم"
pub func DestroyFlag(f: Flag):
cell_free(I64 { cell = f.cell, mu = f.mu })
end
@en "bidi"
@fa "دوسویه"
package bidi
import str
import unicode
@en "DirAuto"
@fa "جهت خودکار"
pub const DirAuto := 0
@en "DirLTR"
@fa "جهت چپ به راست"
pub const DirLTR := 1
@en "DirRTL"
@fa "جهت راست به چپ"
pub const DirRTL := 2
const _MAX_DEPTH := 125
const _OVR_NEUTRAL := 0
const _OVR_LTR := 1
const _OVR_RTL := 2
inline pure func _is_isolate_init(t: int): bool:
ret t == unicode.BcLRI or t == unicode.BcRLI or t == unicode.BcFSI
end
inline pure func _is_removed(t: int): bool:
if t == unicode.BcRLE or t == unicode.BcLRE: ret true end
if t == unicode.BcRLO or t == unicode.BcLRO: ret true end
ret t == unicode.BcPDF or t == unicode.BcBN
end
inline pure func _is_ni(t: int): bool:
if t == unicode.BcB or t == unicode.BcS: ret true end
if t == unicode.BcWS or t == unicode.BcON: ret true end
ret _is_isolate_init(t) or t == unicode.BcPDI
end
inline pure func _level_dir(level: int): int:
if level % 2 == 1: ret unicode.BcR end
ret unicode.BcL
end
inline pure func _n_dir(t: int): int:
if t == unicode.BcR or t == unicode.BcEN or t == unicode.BcAN: ret unicode.BcR end
if t == unicode.BcL: ret unicode.BcL end
ret 0 - 1
end
func _new_ints(n: int, fill: int): Vector<int>:
out := Vector {} as Vector<int>
repeat n in _: out.push(fill) end
ret out
end
func _auto_level(types: Vector<int>, from: int, stop: int): int:
mut depth := 0
mut i := from
until i < stop:
t := types.get(i)
if _is_isolate_init(t):
depth += 1
else t == unicode.BcPDI:
if depth > 0: depth -= 1 end
else depth == 0:
if t == unicode.BcL: ret 0 end
if t == unicode.BcR or t == unicode.BcAL: ret 1 end
end
i += 1
end
ret 0
end
func _match_isolates(types: Vector<int>, pdi_of &: Vector<int>, init_of &: Vector<int>):
n := types.len()
stack := Vector {} as Vector<int>
defer stack.free()
repeat n in i:
t := types.get(i)
if _is_isolate_init(t):
stack.push(i)
else t == unicode.BcPDI:
if stack.len() > 0:
j := stack.pop()
pdi_of.set(j, i)
init_of.set(i, j)
end
end
end
end
func _explicit_levels(types &: Vector<int>, pdi_of: Vector<int>, para: int, levels &: Vector<int>):
n := types.len()
st_level := Vector {} as Vector<int>
defer st_level.free()
st_over := Vector {} as Vector<int>
defer st_over.free()
st_iso := Vector {} as Vector<int>
defer st_iso.free()
st_level.push(para)
st_over.push(_OVR_NEUTRAL)
st_iso.push(0)
mut overflow_iso := 0
mut overflow_emb := 0
mut valid_iso := 0
mut i := 0
until i < n:
t := types.get(i)
top := st_level.len() - 1
cur := st_level.get(top)
if t == unicode.BcRLE or t == unicode.BcLRE or t == unicode.BcRLO or t == unicode.BcLRO:
levels.set(i, cur)
mut next := cur + 1
if t == unicode.BcRLE or t == unicode.BcRLO:
if next % 2 == 0: next += 1 end
else:
if next % 2 == 1: next += 1 end
end
if next <= _MAX_DEPTH and overflow_iso == 0 and overflow_emb == 0:
st_level.push(next)
if t == unicode.BcRLO: st_over.push(_OVR_RTL)
else t == unicode.BcLRO: st_over.push(_OVR_LTR)
else:
st_over.push(_OVR_NEUTRAL)
end
st_iso.push(0)
else:
if overflow_iso == 0: overflow_emb += 1 end
end
else _is_isolate_init(t):
levels.set(i, cur)
if st_over.get(top) == _OVR_LTR: types.set(i, unicode.BcL)
else st_over.get(top) == _OVR_RTL: types.set(i, unicode.BcR) end
mut rtl := t == unicode.BcRLI
if t == unicode.BcFSI:
mut stop := pdi_of.get(i)
if stop < 0: stop = n end
rtl = _auto_level(types, i + 1, stop) == 1
end
mut next := cur + 1
if rtl:
if next % 2 == 0: next += 1 end
else:
if next % 2 == 1: next += 1 end
end
if next <= _MAX_DEPTH and overflow_iso == 0 and overflow_emb == 0:
valid_iso += 1
st_level.push(next)
st_over.push(_OVR_NEUTRAL)
st_iso.push(1)
else:
overflow_iso += 1
end
else t == unicode.BcPDI:
if overflow_iso > 0:
overflow_iso -= 1
else valid_iso > 0:
overflow_emb = 0
until st_iso.get(st_level.len() - 1) == 0:
st_level.pop()
st_over.pop()
st_iso.pop()
end
st_level.pop()
st_over.pop()
st_iso.pop()
valid_iso -= 1
end
ntop := st_level.len() - 1
levels.set(i, st_level.get(ntop))
if st_over.get(ntop) == _OVR_LTR: types.set(i, unicode.BcL)
else st_over.get(ntop) == _OVR_RTL: types.set(i, unicode.BcR) end
else t == unicode.BcPDF:
levels.set(i, cur)
if overflow_iso > 0:
overflow_iso += 0
else overflow_emb > 0:
overflow_emb -= 1
else st_iso.get(top) == 0 and st_level.len() >= 2:
st_level.pop()
st_over.pop()
st_iso.pop()
end
levels.set(i, st_level.get(st_level.len() - 1))
else t == unicode.BcB:
levels.set(i, para)
else:
levels.set(i, cur)
if st_over.get(top) == _OVR_LTR: types.set(i, unicode.BcL)
else st_over.get(top) == _OVR_RTL: types.set(i, unicode.BcR) end
end
i += 1
end
end
func _resolve_weak(types &: Vector<int>, seq: Vector<int>, sos: int):
m := seq.len()
mut prev := sos
repeat m in k:
p := seq.get(k)
t := types.get(p)
if t == unicode.BcNSM:
if _is_isolate_init(prev) or prev == unicode.BcPDI:
types.set(p, unicode.BcON)
else:
types.set(p, prev)
end
end
prev = types.get(p)
end
mut strong := sos
repeat m in k:
p := seq.get(k)
t := types.get(p)
if t == unicode.BcL or t == unicode.BcR or t == unicode.BcAL: strong = t end
if t == unicode.BcEN and strong == unicode.BcAL:
types.set(p, unicode.BcAN)
end
end
repeat m in k:
p := seq.get(k)
if types.get(p) == unicode.BcAL: types.set(p, unicode.BcR) end
end
repeat m in k:
if k == 0: continue end
if k + 1 >= m: continue end
p := seq.get(k)
t := types.get(p)
before := types.get(seq.get(k - 1))
after := types.get(seq.get(k + 1))
if t == unicode.BcES and before == unicode.BcEN and after == unicode.BcEN:
types.set(p, unicode.BcEN)
else t == unicode.BcCS and before == unicode.BcEN and after == unicode.BcEN:
types.set(p, unicode.BcEN)
else t == unicode.BcCS and before == unicode.BcAN and after == unicode.BcAN:
types.set(p, unicode.BcAN)
end
end
mut k := 0
until k < m:
if types.get(seq.get(k)) != unicode.BcET:
k += 1
continue
end
mut e := k
until e < m and types.get(seq.get(e)) == unicode.BcET:
e += 1
end
mut adjacent := false
if k > 0 and types.get(seq.get(k - 1)) == unicode.BcEN: adjacent = true end
if e < m and types.get(seq.get(e)) == unicode.BcEN: adjacent = true end
if adjacent:
mut j := k
until j < e:
types.set(seq.get(j), unicode.BcEN)
j += 1
end
end
k = e
end
repeat m in q:
p := seq.get(q)
t := types.get(p)
if t == unicode.BcET or t == unicode.BcES or t == unicode.BcCS:
types.set(p, unicode.BcON)
end
end
strong = sos
repeat m in q:
p := seq.get(q)
t := types.get(p)
if t == unicode.BcL or t == unicode.BcR: strong = t end
if t == unicode.BcEN and strong == unicode.BcL:
types.set(p, unicode.BcL)
end
end
end
inline pure func _canon_bracket(cp: int): int:
if cp == 0x3008: ret 0x2329 end
if cp == 0x3009: ret 0x232A end
ret cp
end
func _resolve_brackets(cps: Vector<int>, types &: Vector<int>, seq: Vector<int>, level: int, sos: int):
m := seq.len()
e := _level_dir(level)
mut o := unicode.BcL
if e == unicode.BcL: o = unicode.BcR end
stack_pos := Vector {} as Vector<int>
defer stack_pos.free()
stack_cp := Vector {} as Vector<int>
defer stack_cp.free()
open_at := Vector {} as Vector<int>
defer open_at.free()
close_at := Vector {} as Vector<int>
defer close_at.free()
mut k := 0
until k < m:
p := seq.get(k)
if types.get(p) == unicode.BcON:
cp := cps.get(p)
bt := unicode.PairedBracketType(cp)
if bt == unicode.PbtOpen:
if stack_cp.len() >= 63: break end
stack_pos.push(k)
stack_cp.push(_canon_bracket(unicode.PairedBracket(cp)))
else bt == unicode.PbtClose:
mut d := stack_cp.len() - 1
until d >= 0:
if stack_cp.get(d) == _canon_bracket(cp):
open_at.push(stack_pos.get(d))
close_at.push(k)
until stack_cp.len() > d:
stack_cp.pop()
stack_pos.pop()
end
break
end
d -= 1
end
end
end
k += 1
end
mut a := 0
until a < open_at.len():
mut b := a + 1
until b < open_at.len():
if open_at.get(b) < open_at.get(a):
t1 := open_at.get(a)
open_at.set(a, open_at.get(b))
open_at.set(b, t1)
t2 := close_at.get(a)
close_at.set(a, close_at.get(b))
close_at.set(b, t2)
end
b += 1
end
a += 1
end
mut pair := 0
until pair < open_at.len():
ko := open_at.get(pair)
kc := close_at.get(pair)
mut found_e := false
mut found_o := false
mut q := ko + 1
until q < kc:
d := _n_dir(types.get(seq.get(q)))
if d == e: found_e = true end
if d == o: found_o = true end
q += 1
end
mut chosen := 0 - 1
if found_e:
chosen = e
else found_o:
mut ctx := sos
mut r := ko - 1
until r >= 0:
d := _n_dir(types.get(seq.get(r)))
if d >= 0:
ctx = d
break
end
r -= 1
end
if ctx == o: chosen = o
else:
chosen = e
end
end
if chosen >= 0:
types.set(seq.get(ko), chosen)
types.set(seq.get(kc), chosen)
mut z := ko + 1
until z < m and _orig_nsm(cps, seq, z):
types.set(seq.get(z), chosen)
z += 1
end
z = kc + 1
until z < m and _orig_nsm(cps, seq, z):
types.set(seq.get(z), chosen)
z += 1
end
end
pair += 1
end
end
inline func _orig_nsm(cps: Vector<int>, seq: Vector<int>, k: int): bool:
ret unicode.BidiClass(cps.get(seq.get(k))) == unicode.BcNSM
end
func _resolve_neutrals(types &: Vector<int>, seq: Vector<int>, level: int, sos: int, eos: int):
m := seq.len()
e := _level_dir(level)
mut k := 0
until k < m:
if _is_ni(types.get(seq.get(k))) == false:
k += 1
continue
end
mut end_k := k
until end_k < m and _is_ni(types.get(seq.get(end_k))):
end_k += 1
end
mut before := sos
if k > 0: before = _n_dir(types.get(seq.get(k - 1))) end
mut after := eos
if end_k < m: after = _n_dir(types.get(seq.get(end_k))) end
mut fill := e
if before == after and before >= 0: fill = before end
mut j := k
until j < end_k:
types.set(seq.get(j), fill)
j += 1
end
k = end_k
end
end
func _resolve_implicit(types: Vector<int>, seq: Vector<int>, levels &: Vector<int>):
m := seq.len()
repeat m in k:
p := seq.get(k)
t := types.get(p)
lv := levels.get(p)
if lv % 2 == 0:
if t == unicode.BcR: levels.set(p, lv + 1)
else t == unicode.BcAN or t == unicode.BcEN: levels.set(p, lv + 2) end
else:
if t == unicode.BcL or t == unicode.BcAN or t == unicode.BcEN:
levels.set(p, lv + 1)
end
end
end
end
func _code_points(s: str): Vector<int>:
out := Vector {} as Vector<int>
n := s.len()
mut i := 0
mut cp := 0
until i < n:
i = str.CodePointAt(s, i, cp)
if cp < 0: cp = 0xFFFD end
out.push(cp)
end
ret out
end
func _resolve(cps: Vector<int>, dir: int, levels &: Vector<int>): int:
n := cps.len()
orig := Vector {} as Vector<int>
defer orig.free()
types := Vector {} as Vector<int>
defer types.free()
repeat n in i:
c := unicode.BidiClass(cps.get(i))
orig.push(c)
types.push(c)
end
pdi_of := _new_ints(n, 0 - 1)
defer pdi_of.free()
init_of := _new_ints(n, 0 - 1)
defer init_of.free()
_match_isolates(types, pdi_of, init_of)
mut para := 0
if dir == DirRTL: para = 1
else dir == DirLTR: para = 0
else:
para = _auto_level(types, 0, n)
end
repeat n in i: levels.set(i, para) end
_explicit_levels(types, pdi_of, para, levels)
explicit := _new_ints(n, 0)
defer explicit.free()
repeat n in i: explicit.set(i, levels.get(i)) end
retained := Vector {} as Vector<int>
defer retained.free()
repeat n in i:
if _is_removed(orig.get(i)) == false: retained.push(i) end
end
rn := retained.len()
run_start := Vector {} as Vector<int>
defer run_start.free()
run_end := Vector {} as Vector<int>
defer run_end.free()
run_of := _new_ints(n, 0 - 1)
defer run_of.free()
mut k := 0
until k < rn:
mut e := k
lv := explicit.get(retained.get(k))
until e < rn and explicit.get(retained.get(e)) == lv:
run_of.set(retained.get(e), run_start.len())
e += 1
end
run_start.push(k)
run_end.push(e - 1)
k = e
end
used := _new_ints(run_start.len(), 0)
defer used.free()
mut r := 0
until r < run_start.len():
if used.get(r) == 1:
r += 1
continue
end
first := retained.get(run_start.get(r))
if orig.get(first) == unicode.BcPDI and init_of.get(first) >= 0:
r += 1
continue
end
seq := Vector {} as Vector<int>
defer seq.free()
mut cur := r
until true:
used.set(cur, 1)
mut q := run_start.get(cur)
until q <= run_end.get(cur):
seq.push(retained.get(q))
q += 1
end
last := retained.get(run_end.get(cur))
if _is_isolate_init(orig.get(last)) == false: break end
nxt := pdi_of.get(last)
if nxt < 0: break end
nr := run_of.get(nxt)
if nr < 0 or used.get(nr) == 1: break end
cur = nr
end
level := explicit.get(seq.get(0))
mut prev_level := para
pi := run_start.get(r) - 1
if pi >= 0: prev_level = explicit.get(retained.get(pi)) end
mut hi := level
if prev_level > hi: hi = prev_level end
sos := _level_dir(hi)
seq_last := seq.get(seq.len() - 1)
mut next_level := para
if _is_isolate_init(orig.get(seq_last)) and pdi_of.get(seq_last) < 0:
next_level = para
else:
ni := run_end.get(cur) + 1
if ni < rn: next_level = explicit.get(retained.get(ni)) end
end
hi = level
if next_level > hi: hi = next_level end
eos := _level_dir(hi)
_resolve_weak(types, seq, sos)
_resolve_brackets(cps, types, seq, level, sos)
_resolve_neutrals(types, seq, level, sos, eos)
_resolve_implicit(types, seq, levels)
r += 1
end
mut trailing := true
mut q := rn - 1
until q >= 0:
p := retained.get(q)
t := orig.get(p)
if t == unicode.BcB or t == unicode.BcS:
levels.set(p, para)
trailing = true
else t == unicode.BcWS or _is_isolate_init(t) or t == unicode.BcPDI:
if trailing: levels.set(p, para) end
else:
trailing = false
end
q -= 1
end
repeat n in i:
if _is_removed(orig.get(i)): levels.set(i, 0 - 1) end
end
ret para
end
@en "ParagraphLevel"
@fa "تراز بند"
pub func ParagraphLevel(s: str, dir: int): int:
cps := _code_points(s)
defer cps.free()
levels := _new_ints(cps.len(), 0)
defer levels.free()
ret _resolve(cps, dir, levels)
end
@en "Levels"
@fa "ترازها"
pub func Levels(s: str, dir: int): Vector<int>:
cps := _code_points(s)
defer cps.free()
levels := _new_ints(cps.len(), 0)
_resolve(cps, dir, levels)
ret levels
end
@en "VisualOrder"
@fa "ترتیب دیداری"
pub func VisualOrder(s: str, dir: int): Vector<int>:
cps := _code_points(s)
defer cps.free()
n := cps.len()
levels := _new_ints(n, 0)
defer levels.free()
_resolve(cps, dir, levels)
order := Vector {} as Vector<int>
keep := Vector {} as Vector<int>
defer keep.free()
repeat n in i:
if levels.get(i) >= 0:
order.push(i)
keep.push(levels.get(i))
end
end
m := order.len()
if m == 0: ret order end
mut highest := 0
mut lowest_odd := _MAX_DEPTH + 2
repeat m in i:
lv := keep.get(i)
if lv > highest: highest = lv end
if lv % 2 == 1 and lv < lowest_odd: lowest_odd = lv end
end
mut lv := highest
until lv >= lowest_odd:
mut i := 0
until i < m:
if keep.get(i) < lv:
i += 1
continue
end
mut e := i
until e < m and keep.get(e) >= lv:
e += 1
end
mut a := i
mut b := e - 1
until a < b:
t := order.get(a)
order.set(a, order.get(b))
order.set(b, t)
a += 1
b -= 1
end
i = e
end
lv -= 1
end
ret order
end
@en "Reorder"
@fa "بازچینش"
pub func Reorder(s: str, dir: int): str:
cps := _code_points(s)
defer cps.free()
order := VisualOrder(s, dir)
defer order.free()
mut sb := str.NewBuilder()
defer str.BufFree(sb)
repeat order.len() in i:
str.BufAppendCp(sb, cps.get(order.get(i)))
end
ret str.BufStr(sb)
end
package bigint
@en "Neg"
@fa "قرینه"
pub func Neg(x: Int): Int:
mut r := x.clone()
if not r.is_zero(): r.neg = not r.neg end
ret r
end
@en "Abs"
@fa "قدرمطلق"
pub func Abs(x: Int): Int:
mut r := x.clone()
r.neg = false
ret r
end
@en "Add"
@fa "جمع"
pub func Add(a: Int, b: Int): Int:
if a.neg == b.neg:
mut r := _uadd(a, b)
r.neg = a.neg
_norm(r)
ret r
end
c := _ucmp(a, b)
if c == 0: ret Int {} end
if c > 0:
mut r := _usub(a, b)
r.neg = a.neg
_norm(r)
ret r
end
mut r := _usub(b, a)
r.neg = b.neg
_norm(r)
ret r
end
@en "Sub"
@fa "تفریق"
pub func Sub(a: Int, b: Int): Int:
mut nb := b.clone()
defer nb.free()
if not nb.is_zero(): nb.neg = not nb.neg end
ret Add(a, nb)
end
@en "Mul"
@fa "ضرب"
pub func Mul(a: Int, b: Int): Int:
mut r := _umul(a, b)
r.neg = a.neg != b.neg
_norm(r)
ret r
end
@en "Sqr"
@fa "مربع"
pub func Sqr(x: Int): Int: ret Mul(x, x) end
@en "AddInt"
@fa "جمع صحیح"
pub func AddInt(a: Int, v: i64): Int:
mut b := FromInt(v)
defer b.free()
ret Add(a, b)
end
@en "SubInt"
@fa "تفریق صحیح"
pub func SubInt(a: Int, v: i64): Int:
mut b := FromInt(v)
defer b.free()
ret Sub(a, b)
end
@en "MulInt"
@fa "ضرب صحیح"
pub func MulInt(a: Int, v: i64): Int:
mut b := FromInt(v)
defer b.free()
ret Mul(a, b)
end
@en "Shl"
@fa "شیفت چپ"
pub func Shl(x: Int, k: int): Int:
if k < 0: ret Shr(x, 0 - k) end
mut r := _ushl(x, k)
r.neg = x.neg
_norm(r)
ret r
end
@en "Shr"
@fa "شیفت راست"
pub func Shr(x: Int, k: int): Int:
if k < 0: ret Shl(x, 0 - k) end
mut r := _ushr(x, k)
if x.neg:
if _has_low_bits(x, k):
mut one := One()
defer one.free()
bumped := _uadd(r, one)
r.free()
r = bumped
end
r.neg = true
end
_norm(r)
ret r
end
@en "Set"
@fa "تنظیم"
pub func Set(x &: Int, src: Int): _replace(x, src.clone()) end
@en "SetInt"
@fa "تنظیم صحیح"
pub func SetInt(x &: Int, v: i64): _replace(x, FromInt(v)) end
@en "AddTo"
@fa "افزودن به"
pub func AddTo(x &: Int, y: Int): _replace(x, Add(x, y)) end
@en "SubFrom"
@fa "کاستن از"
pub func SubFrom(x &: Int, y: Int): _replace(x, Sub(x, y)) end
@en "MulBy"
@fa "ضرب در"
pub func MulBy(x &: Int, y: Int): _replace(x, Mul(x, y)) end
@en "AddIntTo"
@fa "افزودن صحیح به"
pub func AddIntTo(x &: Int, v: i64): _replace(x, AddInt(x, v)) end
@en "MulIntBy"
@fa "ضرب در صحیح"
pub func MulIntBy(x &: Int, v: i64): _replace(x, MulInt(x, v)) end
@en "NegateIn"
@fa "قرینه‌سازی"
pub func NegateIn(x &: Int):
if not x.is_zero(): x.neg = not x.neg end
end
@en "ShlBy"
@fa "شیفت چپ در جا"
pub func ShlBy(x &: Int, k: int): _replace(x, Shl(x, k)) end
@en "ShrBy"
@fa "شیفت راست در جا"
pub func ShrBy(x &: Int, k: int): _replace(x, Shr(x, k)) end
package bigint
const _OP_AND := 0
const _OP_OR := 1
const _OP_XOR := 2
const _OP_ANDNOT := 3
func _op_u32(a: u32, b: u32, op: int): u32:
if op == _OP_AND: ret a & b end
if op == _OP_OR: ret a | b end
if op == _OP_XOR: ret a ^ b end
ret a & (~b)
end
func _op_bool(a: bool, b: bool, op: int): bool:
if op == _OP_AND: ret a and b end
if op == _OP_OR: ret a or b end
if op == _OP_XOR: ret a != b end
ret a and not b
end
func _tc_prep(x: Int): Int:
if not x.neg: ret Abs(x) end
mut one := One()
mut ax := Abs(x)
r := _usub(ax, one)
ax.free()
one.free()
ret r
end
func _tc_limb(p: Int, neg: bool, i: int): u32:
v := _at(p, i)
if neg: ret ~v end
ret v
end
func _bitop(a: Int, b: Int, op: int): Int:
mut pa := _tc_prep(a)
mut pb := _tc_prep(b)
mut n := pa.mag.len()
if pb.mag.len() > n: n = pb.mag.len() end
n += 1
rneg := _op_bool(a.neg, b.neg, op)
mut r := _blank(n)
repeat n in i:
r.mag.set(i, _op_u32(_tc_limb(pa, a.neg, i), _tc_limb(pb, b.neg, i), op))
end
pa.free()
pb.free()
if rneg:
mut carry := 1 as u64
repeat n in i:
t := ((~r.mag.get(i)) as u64) + carry
r.mag.set(i, (t & _LOW_MASK) as u32)
carry = t >> 32
end
if carry != 0 as u64: r.mag.push(carry as u32) end
r.neg = true
end
_norm(r)
ret r
end
@en "And"
@fa "اشتراک بیتی"
pub func And(a: Int, b: Int): Int: ret _bitop(a, b, _OP_AND) end
@en "Or"
@fa "اجتماع بیتی"
pub func Or(a: Int, b: Int): Int: ret _bitop(a, b, _OP_OR) end
@en "Xor"
@fa "یای انحصاری"
pub func Xor(a: Int, b: Int): Int: ret _bitop(a, b, _OP_XOR) end
@en "AndNot"
@fa "اشتراک با نقیض"
pub func AndNot(a: Int, b: Int): Int: ret _bitop(a, b, _OP_ANDNOT) end
@en "Not"
@fa "نقیض بیتی"
pub func Not(x: Int): Int:
mut one := One()
defer one.free()
mut s := Add(x, one)
NegateIn(s)
ret s
end
@en "PopCount"
@fa "شمار یک‌ها"
pub func PopCount(x: Int): int:
mut c := 0
repeat x.mag.len() in i:
mut v := x.mag.get(i)
until v != 0 as u32:
v = v & (v - (1 as u32))
c += 1
end
end
ret c
end
@en "TrailingZeros"
@fa "صفرهای پایانی"
pub func TrailingZeros(x: Int): int:
if x.is_zero(): ret 0 - 1 end
repeat x.mag.len() in i:
v := x.mag.get(i)
if v != 0 as u32:
mut k := 0
mut t := v
until (t & (1 as u32)) == 0 as u32:
t = t >> 1
k += 1
end
ret i * _LIMB_BITS + k
end
end
ret 0 - 1
end
package bigint
import str
func _digit_val(c: int, base: int): int:
mut d := 0 - 1
if c >= 48 and c <= 57: d = c - 48
else c >= 97 and c <= 122: d = c - 97 + 10
else c >= 65 and c <= 90: d = c - 65 + 10
end
if d < 0 or d >= base: ret 0 - 1 end
ret d
end
func _digit_char(d: int): int:
if d < 10: ret 48 + d end
ret 97 + (d - 10)
end
@en "ToStr"
@fa "به رشته"
pub func ToStr(x: Int): str: ret ToStrBase(x, 10) end
@en "ToStrBase"
@fa "به رشته با پایه"
pub func ToStrBase(x: Int, base: int): str:
if base < 2 or base > 36: ret "" end
if x.is_zero(): ret "0" end
mut pw := 1 as u64
mut per := 0
until pw * (base as u64) <= _LOW_MASK:
pw = pw * (base as u64)
per += 1
end
mut digits := Vector {} as Vector<int>
mut cur := Abs(x)
until not cur.is_zero():
mut rem := 0 as u32
nx := _udivmod_small(cur, pw as u32, rem)
cur.free()
cur = nx
mut chunk := rem as u64
radix := base as u64
if cur.is_zero():
until chunk > 0 as u64:
digits.push((chunk % radix) as int)
chunk = chunk / radix
end
else:
repeat per:
digits.push((chunk % radix) as int)
chunk = chunk / radix
end
end
end
cur.free()
mut b := str.NewBuilder()
if x.neg: str.BufAppendChar(b, 45) end
mut i := digits.len() - 1
until i >= 0:
str.BufAppendChar(b, _digit_char(digits.get(i)))
i -= 1
end
digits.free()
out := str.BufStr(b)
str.BufFree(b)
ret out
end
@en "ToHex"
@fa "به شانزده‌شانزدهی"
pub func ToHex(x: Int): str: ret ToStrBase(x, 16) end
@en "Parse"
@fa "تجزیه"
pub func Parse(s: str, ok &: bool): Int: ret ParseBase(s, 10, ok) end
@en "ParseBase"
@fa "تجزیه با پایه"
pub func ParseBase(s: str, base: int, ok &: bool): Int:
ok = false
if base != 0 and (base < 2 or base > 36): ret Int {} end
mut norm := s
if str.HasPersianDigits(s) or str.HasArabicDigits(s):
norm = str.ToEnglishDigits(s)
end
n := norm.len()
mut i := 0
until i < n and (norm[i] as int) == 32: i += 1 end
mut neg := false
if i < n:
c := norm[i] as int
if c == 45: neg = true i += 1
else c == 43: i += 1
end
end
mut b := base
if b == 0:
b = 10
if i + 1 < n and (norm[i] as int) == 48:
p := norm[i + 1] as int
if p == 120 or p == 88: b = 16 i += 2
else p == 98 or p == 66: b = 2 i += 2
else p == 111 or p == 79: b = 8 i += 2
end
end
end
mut pw := 1 as u64
mut per := 0
until pw * (b as u64) <= _LOW_MASK:
pw = pw * (b as u64)
per += 1
end
mut acc := Int {}
mut chunk := 0 as u64
mut in_chunk := 0
mut seen := 0
mut bad := false
mut last_sep := false
until i < n:
c := norm[i] as int
i += 1
if c == 95:
if seen == 0: bad = true break end
last_sep = true
continue
end
d := _digit_val(c, b)
if d < 0: bad = true break end
last_sep = false
seen += 1
chunk = chunk * (b as u64) + (d as u64)
in_chunk += 1
if in_chunk == per:
nx := _umul_add_small(acc, pw as u32, chunk as u32)
acc.free()
acc = nx
chunk = 0 as u64
in_chunk = 0
end
end
if bad or seen == 0 or last_sep:
acc.free()
ret Int {}
end
if in_chunk > 0:
mut mult := 1 as u64
repeat in_chunk: mult = mult * (b as u64) end
nx := _umul_add_small(acc, mult as u32, chunk as u32)
acc.free()
acc = nx
end
acc.neg = neg
_norm(acc)
ok = true
ret acc
end
@en "ParseOr"
@fa "تجزیه با پیش فرض"
pub func ParseOr(s: str, base: int): Int:
mut ok := false
mut v := ParseBase(s, base, ok)
if not ok:
v.free()
ret Int {}
end
ret v
end
@en "ToInt"
@fa "به صحیح"
pub func ToInt(x: Int, ok &: bool): i64:
ok = true
n := x.mag.len()
if n == 0: ret 0 end
if n > 2:
ok = false
ret 0
end
mut u := x.mag.get(0) as u64
if n == 2: u = u | ((x.mag.get(1) as u64) << 32) end
if x.neg:
if u > 0x8000000000000000 as u64:
ok = false
ret 0
end
ret (0 as i64) - (u as i64)
end
if u > 0x7FFFFFFFFFFFFFFF as u64:
ok = false
ret 0
end
ret u as i64
end
@en "ToIntClamped"
@fa "به صحیح محدود"
pub func ToIntClamped(x: Int): i64:
mut ok := true
v := ToInt(x, ok)
if ok: ret v end
if x.neg: ret 0 - 0x7FFFFFFFFFFFFFFF as i64 - (1 as i64) end
ret 0x7FFFFFFFFFFFFFFF
end
@en "ToFloat"
@fa "به اعشاری"
pub func ToFloat(x: Int): f64:
mut f := 0.0
mut i := x.mag.len() - 1
until i >= 0:
f = f * 4294967296.0 + (x.mag.get(i) as f64)
i -= 1
end
if x.neg: ret 0.0 - f end
ret f
end
@en "ByteLen"
@fa "طول بایت"
pub func ByteLen(x: Int): int: ret (x.bit_len() + 7) / 8 end
@en "FromBytes"
@fa "از بایت‌ها"
pub func FromBytes(p: void*, n: int): Int:
mut r := Int {}
if p == null or n <= 0: ret r end
src := p as u8*
nl := (n + 3) / 4
r.mag.zeros(nl)
mut i := 0
until i < n:
b := src[n - 1 - i] as u32
li := i / 4
sh := (i % 4) * 8
r.mag.set(li, r.mag.get(li) | (b << sh))
i += 1
end
_norm(r)
ret r
end
@en "ToBytes"
@fa "به بایت‌ها"
pub func ToBytes(x: Int, out: void*, n: int): bool:
if out == null or n < 0: ret false end
need := ByteLen(x)
if need > n: ret false end
dst := out as u8*
mut i := 0
until i < n:
li := i / 4
mut v := 0 as u32
if li < x.mag.len(): v = (x.mag.get(li) >> ((i % 4) * 8)) & (0xFF as u32) end
dst[n - 1 - i] = v as u8
i += 1
end
ret true
end
package bigint
const _BASE := 0x100000000 as u64
func _pad_to(x &: Int, n: int):
until x.mag.len() < n: x.mag.push(0 as u32) end
end
func _udivmod(a: Int, b: Int, q &: Int, r &: Int):
na := a.mag.len()
nb := b.mag.len()
if _ucmp(a, b) < 0:
_replace(q, Int {})
_replace(r, Abs(a))
ret
end
if nb == 1:
mut rem := 0 as u32
_replace(q, _udivmod_small(a, b.mag.get(0), rem))
mut rr := Int {}
if rem != 0 as u32: rr.mag.push(rem) end
_replace(r, rr)
ret
end
n := nb
m := na - nb
s := _LIMB_BITS - _bit_width(b.mag.get(nb - 1))
mut vn := _ushl(b, s)
defer vn.free()
_pad_to(vn, n)
mut un := _ushl(a, s)
defer un.free()
_pad_to(un, na + 1)
vtop := vn.mag.get(n - 1) as u64
vsec := vn.mag.get(n - 2) as u64
mut qq := _blank(m + 1)
mut j := m
until j >= 0:
num := ((un.mag.get(j + n) as u64) << 32) | (un.mag.get(j + n - 1) as u64)
mut qhat := num / vtop
mut rhat := num % vtop
mut again := true
until again:
again = false
if qhat >= _BASE or qhat * vsec > (rhat << 32) + (un.mag.get(j + n - 2) as u64):
qhat -= 1 as u64
rhat += vtop
if rhat < _BASE: again = true end
end
end
mut carry := 0 as u64
mut borrow := 0 as u64
repeat n in i:
p := qhat * (vn.mag.get(i) as u64) + carry
carry = p >> 32
plo := (p & _LOW_MASK) + borrow
cur := un.mag.get(i + j) as u64
if cur >= plo:
un.mag.set(i + j, (cur - plo) as u32)
borrow = 0 as u64
else:
un.mag.set(i + j, ((cur + _BASE) - plo) as u32)
borrow = 1 as u64
end
end
top := un.mag.get(j + n) as u64
sub := carry + borrow
if top >= sub:
un.mag.set(j + n, (top - sub) as u32)
else:
un.mag.set(j + n, ((top + _BASE) - sub) as u32)
qhat -= 1 as u64
mut c := 0 as u64
repeat n in i:
t := (un.mag.get(i + j) as u64) + (vn.mag.get(i) as u64) + c
un.mag.set(i + j, (t & _LOW_MASK) as u32)
c = t >> 32
end
un.mag.set(j + n, ((un.mag.get(j + n) as u64) + c) as u32)
end
qq.mag.set(j, qhat as u32)
j -= 1
end
_norm(qq)
_replace(q, qq)
mut rr := _blank(n)
repeat n in i: rr.mag.set(i, un.mag.get(i)) end
_norm(rr)
rs := _ushr(rr, s)
rr.free()
_replace(r, rs)
end
@en "DivMod"
@fa "تقسیم با باقیمانده"
pub func DivMod(a: Int, b: Int, q &: Int, r &: Int): bool:
if b.is_zero():
_replace(q, Int {})
_replace(r, Int {})
ret false
end
_udivmod(a, b, q, r)
q.neg = a.neg != b.neg
r.neg = a.neg
_norm(q)
_norm(r)
ret true
end
@en "Div"
@fa "تقسیم"
pub func Div(a: Int, b: Int): Int:
mut q := Int {}
mut r := Int {}
_ok := DivMod(a, b, q, r)
r.free()
ret q
end
@en "Rem"
@fa "باقیمانده"
pub func Rem(a: Int, b: Int): Int:
mut q := Int {}
mut r := Int {}
_ok := DivMod(a, b, q, r)
q.free()
ret r
end
@en "FloorDivMod"
@fa "تقسیم کف با باقیمانده"
pub func FloorDivMod(a: Int, b: Int, q &: Int, r &: Int): bool:
if not DivMod(a, b, q, r): ret false end
if not r.is_zero() and (a.neg != b.neg):
mut one := One()
defer one.free()
_replace(q, Sub(q, one))
_replace(r, Add(r, b))
end
ret true
end
@en "FloorDiv"
@fa "تقسیم کف"
pub func FloorDiv(a: Int, b: Int): Int:
mut q := Int {}
mut r := Int {}
_ok := FloorDivMod(a, b, q, r)
r.free()
ret q
end
@en "FloorMod"
@fa "باقیمانده کف"
pub func FloorMod(a: Int, b: Int): Int:
mut q := Int {}
mut r := Int {}
_ok := FloorDivMod(a, b, q, r)
q.free()
ret r
end
@en "Mod"
@fa "پیمانه"
pub func Mod(a: Int, m: Int): Int:
if m.is_zero(): ret Int {} end
mut q := Int {}
defer q.free()
mut r := Int {}
_udivmod(a, m, q, r)
if a.neg and not r.is_zero():
mut am := Abs(m)
defer am.free()
_replace(r, _usub(am, r))
end
r.neg = false
_norm(r)
ret r
end
@en "DivModInt"
@fa "تقسیم صحیح"
pub func DivModInt(a: Int, v: i64, rem &: i64): Int:
mut b := FromInt(v)
defer b.free()
mut q := Int {}
mut r := Int {}
defer r.free()
if not DivMod(a, b, q, r):
rem = 0 as i64
ret q
end
mut ok := true
rem = ToInt(r, ok)
ret q
end
@en "ModInt"
@fa "پیمانه صحیح"
pub func ModInt(a: Int, v: i64): i64:
mut m := FromInt(v)
defer m.free()
mut r := Mod(a, m)
defer r.free()
mut ok := true
ret ToInt(r, ok)
end
package bigint
func _half(x: Int): Int: ret _ushr(x, 1) end
@en "Pow"
@fa "توان"
pub func Pow(x: Int, e: int): Int:
if e < 0: ret Int {} end
if e == 0: ret One() end
mut result := One()
mut base := x.clone()
mut n := e
until n > 0:
if (n & 1) == 1:
t := Mul(result, base)
result.free()
result = t
end
n = n >> 1
if n > 0:
sq := Sqr(base)
base.free()
base = sq
end
end
base.free()
ret result
end
@en "Pow10"
@fa "توان ده"
pub func Pow10(n: int): Int:
if n < 0: ret Int {} end
mut r := One()
mut k := n
until k >= 9:
t := _umul_add_small(r, 1000000000 as u32, 0 as u32)
r.free()
r = t
k -= 9
end
if k > 0:
mut m := 1 as u32
repeat k: m = m * (10 as u32) end
t := _umul_add_small(r, m, 0 as u32)
r.free()
r = t
end
ret r
end
@en "ModExp"
@fa "توان پیمانه‌ای"
pub func ModExp(base: Int, e: Int, m: Int): Int:
if m.is_zero() or e.neg: ret Int {} end
mut mm := Abs(m)
mut one := One()
mut result := Mod(one, mm)
one.free()
mut b := Mod(base, mm)
mut i := e.bit_len() - 1
until i >= 0:
sq := Sqr(result)
result.free()
result = Mod(sq, mm)
sq.free()
if Bit(e, i) == 1:
p := Mul(result, b)
result.free()
result = Mod(p, mm)
p.free()
end
i -= 1
end
b.free()
mm.free()
ret result
end
@en "Gcd"
@fa "ب م م"
pub func Gcd(a: Int, b: Int): Int:
mut x := Abs(a)
mut y := Abs(b)
until not y.is_zero():
r := Mod(x, y)
x.free()
x = y
y = r
end
y.free()
ret x
end
@en "Lcm"
@fa "ک م م"
pub func Lcm(a: Int, b: Int): Int:
if a.is_zero() or b.is_zero(): ret Int {} end
mut g := Gcd(a, b)
mut d := Div(a, g)
g.free()
mut p := Mul(d, b)
d.free()
r := Abs(p)
p.free()
ret r
end
@en "ExtGcd"
@fa "ب م م گسترده"
pub func ExtGcd(a: Int, b: Int, x &: Int, y &: Int): Int:
mut old_r := Abs(a)
mut r := Abs(b)
mut old_s := One()
mut s := Int {}
mut old_t := Int {}
mut t := One()
until not r.is_zero():
q := Div(old_r, r)
qr := Mul(q, r)
nr := Sub(old_r, qr)
qr.free()
old_r.free()
old_r = r
r = nr
qs := Mul(q, s)
ns := Sub(old_s, qs)
qs.free()
old_s.free()
old_s = s
s = ns
qt := Mul(q, t)
nt := Sub(old_t, qt)
qt.free()
old_t.free()
old_t = t
t = nt
q.free()
end
r.free()
s.free()
t.free()
if a.neg: NegateIn(old_s) end
if b.neg: NegateIn(old_t) end
_replace(x, old_s)
_replace(y, old_t)
ret old_r
end
@en "ModInverse"
@fa "وارون پیمانه‌ای"
pub func ModInverse(a: Int, m: Int, ok &: bool): Int:
ok = false
if m.is_zero(): ret Int {} end
mut mm := Abs(m)
mut x := Int {}
mut y := Int {}
mut g := ExtGcd(a, mm, x, y)
y.free()
one := EqualsInt(g, 1 as i64)
g.free()
if not one:
x.free()
mm.free()
ret Int {}
end
r := Mod(x, mm)
x.free()
mm.free()
ok = true
ret r
end
@en "Sqrt"
@fa "جذر"
pub func Sqrt(x: Int): Int:
if x.neg or x.is_zero(): ret Int {} end
bl := x.bit_len()
if bl <= 2: ret One() end
mut one := One()
mut a := Shl(one, (bl + 1) / 2)
one.free()
until true:
d := Div(x, a)
sum := Add(a, d)
d.free()
b := _half(sum)
sum.free()
if Cmp(b, a) >= 0:
b.free()
break
end
a.free()
a = b
end
ret a
end
@en "Factorial"
@fa "فاکتوریل"
pub func Factorial(n: int): Int:
if n < 0: ret Int {} end
mut r := One()
mut i := 2
until i <= n:
MulIntBy(r, i as i64)
i += 1
end
ret r
end
@en "bigint"
@fa "عدد بزرگ"
package bigint
const _LIMB_BITS := 32
const _LOW_MASK := 0xFFFFFFFF as u64
@en "Int"
@fa "صحیح"
pub struct Int:
pub neg: bool = false
pub mag: Vector<u32> = Vector {}
@en "free"
@fa "آزادسازی"
pub func free(): this.mag.free() end
@en "is_zero"
@fa "صفر است"
pub func is_zero(): bool: ret this.mag.len() == 0 end
@en "sign"
@fa "علامت"
pub func sign(): int:
if this.mag.len() == 0: ret 0 end
if this.neg: ret 0 - 1 end
ret 1
end
@en "is_odd"
@fa "فرد است"
pub func is_odd(): bool:
if this.mag.len() == 0: ret false end
ret (this.mag.get(0) & (1 as u32)) != 0 as u32
end
@en "is_even"
@fa "زوج است"
pub func is_even(): bool: ret not this.is_odd() end
@en "bit_len"
@fa "طول بیت"
pub func bit_len(): int:
n := this.mag.len()
if n == 0: ret 0 end
ret (n - 1) * _LIMB_BITS + _bit_width(this.mag.get(n - 1))
end
@en "limb_count"
@fa "شمار لخت"
pub func limb_count(): int: ret this.mag.len() end
@en "clone"
@fa "همانند"
pub func clone(): Int:
mut r := Int {}
r.neg = this.neg
n := this.mag.len()
r.mag.reserve(n)
repeat n in i: r.mag.push(this.mag.get(i)) end
ret r
end
@en "to_str"
@fa "به رشته"
pub func to_str(): str: ret ToStrBase(this[0], 10) end
end
func _bit_width(v: u32): int:
mut x := v
mut n := 0
until x != 0 as u32:
n += 1
x = x >> 1
end
ret n
end
func _norm(x &: Int):
mut n := x.mag.len()
until n > 0 and x.mag.get(n - 1) == 0 as u32:
n -= 1
end
until x.mag.len() > n:
_dropped := x.mag.pop()
end
if n == 0: x.neg = false end
end
func _blank(n: int): Int:
mut r := Int {}
if n > 0: r.mag.zeros(n) end
ret r
end
func _at(x: Int, i: int): u32:
if i >= x.mag.len(): ret 0 end
ret x.mag.get(i)
end
func _ucmp(a: Int, b: Int): int:
na := a.mag.len()
nb := b.mag.len()
if na != nb:
if na < nb: ret 0 - 1 end
ret 1
end
mut i := na - 1
until i >= 0:
av := a.mag.get(i)
bv := b.mag.get(i)
if av != bv:
if av < bv: ret 0 - 1 end
ret 1
end
i -= 1
end
ret 0
end
func _uadd(a: Int, b: Int): Int:
na := a.mag.len()
nb := b.mag.len()
mut n := na
if nb > n: n = nb end
mut r := _blank(n + 1)
mut carry := 0 as u64
repeat n in i:
s := (_at(a, i) as u64) + (_at(b, i) as u64) + carry
r.mag.set(i, (s & _LOW_MASK) as u32)
carry = s >> 32
end
r.mag.set(n, carry as u32)
_norm(r)
ret r
end
func _usub(a: Int, b: Int): Int:
na := a.mag.len()
mut r := _blank(na)
mut borrow := 0 as u64
repeat na in i:
av := a.mag.get(i) as u64
bv := (_at(b, i) as u64) + borrow
if av >= bv:
r.mag.set(i, (av - bv) as u32)
borrow = 0 as u64
else:
r.mag.set(i, ((av + 0x100000000 as u64) - bv) as u32)
borrow = 1 as u64
end
end
_norm(r)
ret r
end
func _umul(a: Int, b: Int): Int:
na := a.mag.len()
nb := b.mag.len()
if na == 0 or nb == 0: ret Int {} end
mut r := _blank(na + nb)
repeat na in i:
av := a.mag.get(i) as u64
if av != 0 as u64:
mut carry := 0 as u64
repeat nb in j:
cur := (r.mag.get(i + j) as u64) + av * (b.mag.get(j) as u64) + carry
r.mag.set(i + j, (cur & _LOW_MASK) as u32)
carry = cur >> 32
end
r.mag.set(i + nb, carry as u32)
end
end
_norm(r)
ret r
end
func _umul_add_small(x: Int, m: u32, add: u32): Int:
n := x.mag.len()
mut r := _blank(n + 1)
mut carry := add as u64
repeat n in i:
cur := (x.mag.get(i) as u64) * (m as u64) + carry
r.mag.set(i, (cur & _LOW_MASK) as u32)
carry = cur >> 32
end
r.mag.set(n, carry as u32)
_norm(r)
ret r
end
func _udivmod_small(x: Int, d: u32, rem &: u32): Int:
n := x.mag.len()
mut q := _blank(n)
mut r := 0 as u64
mut i := n - 1
dv := d as u64
until i >= 0:
cur := (r << 32) | (x.mag.get(i) as u64)
q.mag.set(i, (cur / dv) as u32)
r = cur % dv
i -= 1
end
rem = r as u32
_norm(q)
ret q
end
func _ushl(x: Int, k: int): Int:
n := x.mag.len()
if n == 0 or k <= 0:
mut c := x.clone()
c.neg = false
ret c
end
limbs := k / _LIMB_BITS
bits := k % _LIMB_BITS
mut r := _blank(n + limbs + 1)
if bits == 0:
repeat n in i: r.mag.set(i + limbs, x.mag.get(i)) end
else:
mut carry := 0 as u32
repeat n in i:
v := x.mag.get(i)
r.mag.set(i + limbs, (v << bits) | carry)
carry = v >> (_LIMB_BITS - bits)
end
r.mag.set(n + limbs, carry)
end
_norm(r)
ret r
end
func _ushr(x: Int, k: int): Int:
n := x.mag.len()
limbs := k / _LIMB_BITS
if n == 0 or k <= 0:
mut c := x.clone()
c.neg = false
ret c
end
if limbs >= n: ret Int {} end
bits := k % _LIMB_BITS
keep := n - limbs
mut r := _blank(keep)
if bits == 0:
repeat keep in i: r.mag.set(i, x.mag.get(i + limbs)) end
else:
repeat keep in i:
mut v := x.mag.get(i + limbs) >> bits
if i + limbs + 1 < n:
v = v | (x.mag.get(i + limbs + 1) << (_LIMB_BITS - bits))
end
r.mag.set(i, v)
end
end
_norm(r)
ret r
end
func _has_low_bits(x: Int, k: int): bool:
if k <= 0: ret false end
limbs := k / _LIMB_BITS
bits := k % _LIMB_BITS
n := x.mag.len()
mut i := 0
until i < limbs and i < n:
if x.mag.get(i) != 0 as u32: ret true end
i += 1
end
if bits > 0 and limbs < n:
mask := ((1 as u32) << bits) - (1 as u32)
if (x.mag.get(limbs) & mask) != 0 as u32: ret true end
end
ret false
end
func _replace(x &: Int, src: Int):
x.mag.free()
x.neg = src.neg
x.mag = src.mag
end
@en "Zero"
@fa "صفر"
pub func Zero(): Int: ret Int {} end
@en "One"
@fa "یک"
pub func One(): Int: ret FromInt(1 as i64) end
@en "FromInt"
@fa "از صحیح"
pub func FromInt(v: i64): Int:
mut r := Int {}
if v == 0 as i64: ret r end
mut u := v as u64
if v < 0 as i64:
r.neg = true
u = (0 as u64) - (v as u64)
end
lo := (u & _LOW_MASK) as u32
hi := (u >> 32) as u32
r.mag.push(lo)
if hi != 0 as u32: r.mag.push(hi) end
_norm(r)
ret r
end
@en "FromUint"
@fa "از صحیح بی‌علامت"
pub func FromUint(v: u64): Int:
mut r := Int {}
if v == 0 as u64: ret r end
r.mag.push((v & _LOW_MASK) as u32)
hi := (v >> 32) as u32
if hi != 0 as u32: r.mag.push(hi) end
_norm(r)
ret r
end
@en "Clone"
@fa "همانند"
pub func Clone(x: Int): Int: ret x.clone() end
@en "Free"
@fa "آزادسازی"
pub func Free(x &: Int): x.mag.free() end
@en "IsZero"
@fa "صفر است"
pub func IsZero(x: Int): bool: ret x.is_zero() end
@en "Sign"
@fa "علامت"
pub func Sign(x: Int): int: ret x.sign() end
@en "BitLen"
@fa "طول بیت"
pub func BitLen(x: Int): int: ret x.bit_len() end
@en "Bit"
@fa "بیت"
pub func Bit(x: Int, i: int): int:
if i < 0: ret 0 end
limb := i / _LIMB_BITS
if limb >= x.mag.len(): ret 0 end
ret ((x.mag.get(limb) >> (i % _LIMB_BITS)) & (1 as u32)) as int
end
@en "IsOdd"
@fa "فرد است"
pub func IsOdd(x: Int): bool: ret x.is_odd() end
@en "IsEven"
@fa "زوج است"
pub func IsEven(x: Int): bool: ret x.is_even() end
@en "Cmp"
@fa "مقایسه"
pub func Cmp(a: Int, b: Int): int:
if a.neg != b.neg:
if a.neg: ret 0 - 1 end
ret 1
end
c := _ucmp(a, b)
if a.neg: ret 0 - c end
ret c
end
@en "CmpAbs"
@fa "مقایسه قدرمطلق"
pub func CmpAbs(a: Int, b: Int): int: ret _ucmp(a, b) end
@en "Equals"
@fa "یکسان است"
pub func Equals(a: Int, b: Int): bool: ret Cmp(a, b) == 0 end
@en "Less"
@fa "کمتر است"
pub func Less(a: Int, b: Int): bool: ret Cmp(a, b) < 0 end
@en "Greater"
@fa "بیشتر است"
pub func Greater(a: Int, b: Int): bool: ret Cmp(a, b) > 0 end
@en "Min"
@fa "کمینه"
pub func Min(a: Int, b: Int): Int:
if Cmp(a, b) <= 0: ret a.clone() end
ret b.clone()
end
@en "Max"
@fa "بیشینه"
pub func Max(a: Int, b: Int): Int:
if Cmp(a, b) >= 0: ret a.clone() end
ret b.clone()
end
@en "EqualsInt"
@fa "یکسان با صحیح است"
pub func EqualsInt(a: Int, v: i64): bool:
mut b := FromInt(v)
defer b.free()
ret Cmp(a, b) == 0
end
package calendar
func _shiftMonth(year: int, month: int, n: int): GregorianDate:
total := (year as i64) * 12 + ((month - 1) as i64) + (n as i64)
y := _floordiv(total, 12)
m := _floormod(total, 12) + 1
ret GregorianDate { year = y as int, month = m as int, day = 1 }
end
@en "AddDaysGregorian"
@fa "افزودن روز میلادی"
pub func AddDaysGregorian(d: GregorianDate, n: int): GregorianDate:
ret JDNToGregorian(GregorianToJDN(d) + (n as i64))
end
@en "AddWeeksGregorian"
