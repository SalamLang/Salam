package db
@en "NO_LEASE"
@fa "بدون اجاره"
pub const NO_LEASE := -1
@en "Pool"
@fa "استخر"
pub struct Pool:
pub conns: Vector<dyn Connection>
pub taken: Vector<int>
pub limit: int = 0
end
@en "NewPool"
@fa "استخر جدید"
pub func NewPool(limit: int): Pool:
ret Pool {
conns = Vector {} as Vector<dyn Connection> taken = Vector {} as Vector<int> limit = limit
}
end
@en "Add"
@fa "افزودن"
pub func Add(p &: Pool, c: dyn Connection): bool:
if p.limit > 0 and p.conns.len() >= p.limit:
ret false
end
p.conns.push(c)
p.taken.push(0)
ret true
end
@en "Acquire"
@fa "گرفتن"
pub func Acquire(p &: Pool): int:
mut i := 0
until i < p.conns.len():
if p.taken.get(i) == 0:
p.taken.set(i, 1)
ret i
end
i = i + 1
end
ret NO_LEASE
end
@en "Leased"
@fa "اجاره شده"
pub func Leased(lease: int): bool: ret lease != NO_LEASE end
@en "Conn"
@fa "اتصال اجاره‌ای"
pub func Conn(p: Pool, lease: int): dyn Connection:
ret p.conns.get(lease)
end
@en "Release"
@fa "رهاکردن"
pub func Release(p &: Pool, lease: int):
if lease < 0 or lease >= p.taken.len():
ret
end
p.taken.set(lease, 0)
end
@en "Size"
@fa "اندازه"
pub func Size(p: Pool): int: ret p.conns.len() end
@en "Idle"
@fa "بیکار"
pub func Idle(p: Pool): int:
mut n := 0
mut i := 0
until i < p.taken.len():
if p.taken.get(i) == 0:
n = n + 1
end
i = i + 1
end
ret n
end
@en "InUse"
@fa "در استفاده"
pub func InUse(p: Pool): int: ret Size(p) - Idle(p) end
@en "DropDead"
@fa "حذف مرده ها"
pub func DropDead(p &: Pool): int:
mut removed := 0
mut i := 0
until i < p.conns.len():
if p.taken.get(i) == 0 and not p.conns.get(i).Ping():
p.conns.get(i).Close()
_dropped := p.conns.remove_at(i)
_flag := p.taken.remove_at(i)
removed = removed + 1
else:
i = i + 1
end
end
ret removed
end
@en "CloseAll"
@fa "بستن همه"
pub func CloseAll(p &: Pool):
mut i := 0
until i < p.conns.len():
p.conns.get(i).Close()
i = i + 1
end
p.conns.clear()
p.taken.clear()
end
@en "Free"
@fa "آزادکردن"
pub func Free(p &: Pool):
CloseAll(p)
p.conns.free()
p.taken.free()
end
