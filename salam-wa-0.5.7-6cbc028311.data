else n == 0:
p := px.get(td.get(t))
_wp_emit(w, _wpd_ch(p, 8), lg, kg, sg)
_wp_emit(w, _wpd_ch(p, 16), lr, kr, sr)
_wp_emit(w, _wpd_ch(p, 0), lbl, kb, sb)
_wp_emit(w, _wpd_ch(p, 24), la, ka, sa)
else:
_wp_prefix(n, lp, le, lb)
_wp_emit(w, 256 + lp, lg, kg, sg)
compress.BitWriteBits(w, le, lb)
_wp_prefix(td.get(t), lp, le, lb)
_wp_emit(w, lp, ld, kd, sd)
compress.BitWriteBits(w, le, lb)
end
end
tl.free()
td.free()
head.free()
chain.free()
cache.free()
planes.free()
