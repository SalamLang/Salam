func _big_setbit(x &: Big, i: int):
li := i / 32
if li >= x.cap:
x.bad = true
ret
end
_setlimb(x, li, _limb(x, li) | ((1 as u32) << ((i % 32) as u32)))
if li + 1 > x.n:
x.n = li + 1
end
end
func _big_add(r &: Big, a: Big, b: Big):
mut maxn := a.n
if b.n > maxn:
maxn = b.n
end
if r.cap < maxn + 1:
r.bad = true
ret
end
_big_zero(r)
mut carry := 0 as u64
repeat maxn in i:
mut s := carry
if i < a.n:
s += _limb(a, i) as u64
end
if i < b.n:
s += _limb(b, i) as u64
end
_setlimb(r, i, s as u32)
carry = s >> (32 as u64)
end
mut n := maxn
if carry != (0 as u64):
_setlimb(r, maxn, carry as u32)
n = maxn + 1
end
r.n = n
