package tls
const PRF_LABEL_MASTER := "master secret"
const PRF_LABEL_EXT_MASTER := "extended master secret"
const PRF_LABEL_KEY_EXPANSION := "key expansion"
const PRF_LABEL_CLIENT_FINISHED := "client finished"
const PRF_LABEL_SERVER_FINISHED := "server finished"
const MASTER_SECRET_LEN := 48
const VERIFY_DATA_LEN := 12
func _p_hash(kind: int, secret: void*, slen: int, seed: Buf, out: void*, olen: int):
hlen := _hash_size(kind)
mut a := _newbuf(hlen)
defer _buf_wipe(a)
_putzeros(a, hlen)
_hmac(kind, secret, slen, seed.p, seed.len, a.p)
mut blk := _newbuf(hlen)
defer _buf_wipe(blk)
_putzeros(blk, hlen)
mut msg := _newbuf(hlen + seed.len)
defer _buf_free(msg)
mut done := 0
until done < olen:
_bufreset(msg)
_putbuf(msg, a)
_putbuf(msg, seed)
_hmac(kind, secret, slen, msg.p, msg.len, blk.p)
mut take := olen - done
if take > hlen:
take = hlen
end
repeat take in i:
_bput(out, done + i, _bufat(blk, i))
end
done += take
_hmac(kind, secret, slen, a.p, hlen, a.p)
end
end
func _prf(kind: int, secret: void*, slen: int, label: str, seed: Buf, out: void*, olen: int):
mut ls := _newbuf(label.len() + seed.len)
defer _buf_free(ls)
_putstr(ls, label)
_putbuf(ls, seed)
_p_hash(kind, secret, slen, ls, out, olen)
end
func _tls12_master(kind: int, pms: void*, pmslen: int, crand: Buf, srand: Buf, out: void*):
mut seed := _newbuf(64)
defer _buf_free(seed)
_putbuf(seed, crand)
_putbuf(seed, srand)
_prf(kind, pms, pmslen, PRF_LABEL_MASTER, seed, out, MASTER_SECRET_LEN)
end
func _tls12_master_ext(kind: int, pms: void*, pmslen: int, session_hash: Buf, out: void*):
_prf(kind, pms, pmslen, PRF_LABEL_EXT_MASTER, session_hash, out, MASTER_SECRET_LEN)
end
func _tls12_key_block(kind: int, master: void*, mlen: int, srand: Buf, crand: Buf, out: void*, olen: int):
mut seed := _newbuf(64)
defer _buf_free(seed)
_putbuf(seed, srand)
_putbuf(seed, crand)
_prf(kind, master, mlen, PRF_LABEL_KEY_EXPANSION, seed, out, olen)
end
func _tls12_verify_data(kind: int, master: void*, mlen: int, label: str, th: Buf, out: void*):
_prf(kind, master, mlen, label, th, out, VERIFY_DATA_LEN)
end
package tls
struct PrivateKey:
pub pk_alg: int = 0
pub rsa_n: Buf = Buf {}
pub rsa_e: Buf = Buf {}
pub rsa_d: Buf = Buf {}
pub rsa_phi: Buf = Buf {}
pub ec_scalar: Buf = Buf {}
pub ok: bool = false
end
func _der_octetstring(r &: Reader): Reader:
t := _der_tag(r, ASN1_OCTETSTRING)
if not t.ok:
ret _newreader(null, 0)
end
ret t.body
end
func _parse_rsa_pkcs1_body(body: Reader, k &: PrivateKey): bool:
mut r := body
mut seq := _der_seq(r)
if r.bad:
ret false
end
_der_skip(seq)
n := _der_uint(seq)
e := _der_uint(seq)
d := _der_uint(seq)
p := _der_uint(seq)
q := _der_uint(seq)
if seq.bad:
ret false
end
if n.len < 128:
ret false
end
if e.len == 0 or d.len == 0 or p.len == 0 or q.len == 0:
ret false
end
k.rsa_n = _newbuf(n.len)
repeat n.len in i:
_put8(k.rsa_n, _rdat(n, i))
end
k.rsa_e = _newbuf(e.len)
repeat e.len in i:
_put8(k.rsa_e, _rdat(e, i))
end
k.rsa_d = _newbuf(d.len)
repeat d.len in i:
_put8(k.rsa_d, _rdat(d, i))
end
mut pbig := _big_from_bytes(p.p, p.len)
defer _big_wipe_free(pbig)
mut qbig := _big_from_bytes(q.p, q.len)
defer _big_wipe_free(qbig)
mut one := _big_new(1)
defer _big_free(one)
_big_set_u32(one, 1 as u32)
mut pm1 := _big_new(pbig.n + 1)
defer _big_wipe_free(pm1)
mut qm1 := _big_new(qbig.n + 1)
defer _big_wipe_free(qm1)
if pbig.bad or qbig.bad or one.bad or pm1.bad or qm1.bad:
ret false
end
if not _big_sub(pm1, pbig, one) or not _big_sub(qm1, qbig, one):
ret false
end
mut phi := _big_new(pm1.n + qm1.n)
defer _big_wipe_free(phi)
if phi.bad:
ret false
end
_big_mul(phi, pm1, qm1)
if phi.bad:
ret false
end
philen := _big_bytelen(phi)
k.rsa_phi = _newbuf(philen)
_putzeros(k.rsa_phi, philen)
if not _big_to_bytes(phi, k.rsa_phi.p, philen):
ret false
end
k.pk_alg = PK_RSA
k.ok = true
ret true
end
func _parse_ec_sec1_body(body: Reader, curve_hint: int, k &: PrivateKey): bool:
mut r := body
mut seq := _der_seq(r)
if r.bad:
ret false
end
_der_skip(seq)
priv := _der_octetstring(seq)
if seq.bad:
ret false
end
mut alg := curve_hint
if _der_is(seq, ASN1_CTX0):
pt := _der_tag(seq, ASN1_CTX0)
if not pt.ok:
ret false
end
mut pb := pt.body
curve_oid := _der_oid(pb)
if pb.bad:
ret false
end
if _oid_is(curve_oid, OID_PRIME256V1):
alg = PK_EC_P256
else if _oid_is(curve_oid, OID_SECP384R1):
alg = PK_EC_P384
else:
ret false
end
end
if alg == PK_UNKNOWN:
if priv.len == 32:
alg = PK_EC_P256
else if priv.len == 48:
alg = PK_EC_P384
else:
ret false
end
end
mut width := 32
if alg == PK_EC_P384:
width = 48
end
if priv.len > width or priv.len == 0:
ret false
end
k.ec_scalar = _newbuf(width)
_putzeros(k.ec_scalar, width - priv.len)
repeat priv.len in i:
_put8(k.ec_scalar, _rdat(priv, i))
end
k.pk_alg = alg
k.ok = true
ret true
end
func _parse_pkcs8_body(body: Reader, k &: PrivateKey): bool:
mut r := body
mut seq := _der_seq(r)
if r.bad:
ret false
end
_der_skip(seq)
mut params := _newreader(null, 0)
alg_oid := _der_algid(seq, params)
if seq.bad:
ret false
end
pkoct := _der_octetstring(seq)
if seq.bad:
ret false
end
if _oid_is(alg_oid, OID_RSA_ENCRYPTION):
ret _parse_rsa_pkcs1_body(pkoct, k)
end
if _oid_is(alg_oid, OID_EC_PUBLICKEY):
mut pkcs8_curve := 0
mut pp := params
curve_oid := _der_oid(pp)
if not pp.bad:
if _oid_is(curve_oid, OID_PRIME256V1):
pkcs8_curve = PK_EC_P256
else if _oid_is(curve_oid, OID_SECP384R1):
pkcs8_curve = PK_EC_P384
end
end
ret _parse_ec_sec1_body(pkoct, pkcs8_curve, k)
end
ret false
end
@en "FreePrivateKey"
@fa "آزادسازی کلید خصوصی"
pub func FreePrivateKey(k &: PrivateKey):
_buf_wipe(k.rsa_d)
_buf_wipe(k.rsa_phi)
_buf_free(k.rsa_n)
_buf_free(k.rsa_e)
_buf_wipe(k.ec_scalar)
k.ok = false
end
@en "ParsePrivateKeyPEM"
@fa "تجزیه کلید خصوصی پم"
pub func ParsePrivateKeyPEM(pem: str): PrivateKey:
mut k := PrivateKey {}
mut markers: str[3]
markers[0] = "RSA PRIVATE KEY"
markers[1] = "EC PRIVATE KEY"
markers[2] = "PRIVATE KEY"
mut mi := 0
until mi < 3:
begintag := "-----BEGIN " + markers[mi] + "-----"
endtag := "-----END " + markers[mi] + "-----"
b := pem.find(begintag)
if b >= 0:
bodystart := b + begintag.len()
e := str.IndexFrom(pem, endtag, bodystart)
if e >= 0:
room := (e - bodystart) / 4 * 3 + 8
mut der := _newbuf(room)
mut good := false
got := encoding.Base64DecodeBytes(pem.substr(bodystart, e - bodystart), der.p, room, good)
if good and got > 0:
rd := _newreader(der.p, got)
if mi == 0:
_parse_rsa_pkcs1_body(rd, k)
else if mi == 1:
_parse_ec_sec1_body(rd, PK_UNKNOWN, k)
else:
_parse_pkcs8_body(rd, k)
end
end
_buf_wipe(der)
if k.ok:
ret k
end
end
end
mi += 1
end
ret k
end
@en "LoadPrivateKeyFile"
@fa "بارگذاری فایل کلید خصوصی"
pub func LoadPrivateKeyFile(path: str): PrivateKey:
if not os.Exists(path):
k := PrivateKey {}
ret k
end
pem := io.ReadFile(path)
ret ParsePrivateKeyPEM(pem)
end
package tls
import net.internal.rawsock
const REC_CHANGE_CIPHER_SPEC := 20
const REC_ALERT := 21
const REC_HANDSHAKE := 22
const REC_APPLICATION_DATA := 23
const REC_MAX_PLAINTEXT := 16384
const REC_MAX_CIPHERTEXT := 16640
const REC_HEADER := 5
const CIPHER_NONE := 0
const CIPHER_AES128_GCM_SHA256 := 1
const CIPHER_CHACHA20_SHA256 := 2
const CIPHER_AES256_GCM_SHA384 := 3
const TLS_AES_128_GCM_SHA256 := 0x1301
const TLS_AES_256_GCM_SHA384 := 0x1302
const TLS_CHACHA20_POLY1305_SHA256 := 0x1303
const ALERT_CLOSE_NOTIFY := 0
const ALERT_UNEXPECTED_MESSAGE := 10
const ALERT_BAD_RECORD_MAC := 20
const ALERT_HANDSHAKE_FAILURE := 40
const ALERT_BAD_CERTIFICATE := 42
const ALERT_CERTIFICATE_EXPIRED := 45
const ALERT_CERTIFICATE_UNKNOWN := 46
const ALERT_ILLEGAL_PARAMETER := 47
const ALERT_DECODE_ERROR := 50
const ALERT_DECRYPT_ERROR := 51
const ALERT_PROTOCOL_VERSION := 70
const ALERT_INTERNAL_ERROR := 80
const HANDSHAKE_READ_TIMEOUT_MS := 15000
struct RecordLayer:
pub fd: i64 = 0 - 1
pub rx: Buf = Buf {}
pub rxk: TrafficKeys = TrafficKeys {}
pub txk: TrafficKeys = TrafficKeys {}
pub eof: bool = false
pub failed: bool = false
pub err: str = ""
pub read_deadline_ms: int = 0
end
func _rec_new(fd: i64): RecordLayer:
mut r := RecordLayer {}
r.fd = fd
r.rx = _newbuf(REC_MAX_CIPHERTEXT + REC_HEADER)
ret r
end
func _rec_free(r &: RecordLayer):
_buf_free(r.rx)
_tk_free(r.rxk)
_tk_free(r.txk)
end
func _rec_fail(r &: RecordLayer, msg: str):
if not r.failed:
r.failed = true
r.err = msg
end
end
func _rec_fill(r &: RecordLayer): bool:
if r.read_deadline_ms > 0:
if not rawsock.WaitReadable(rawsock.FromFd(r.fd), r.read_deadline_ms):
_rec_fail(r, "timed out waiting for the peer")
r.eof = true
ret false
end
end
mut tmp := _newbuf(4096)
defer _buf_free(tmp)
_putzeros(tmp, 4096)
n := rawsock.RecvBytes(rawsock.FromFd(r.fd), tmp.p, 4096)
if n <= 0:
r.eof = true
ret false
end
_putraw(r.rx, tmp.p, n)
ret true
end
func _rec_need(r &: RecordLayer, n: int): bool:
until r.rx.len < n:
if not _rec_fill(r):
ret false
end
end
ret true
end
func _rec_buffered(r: RecordLayer): int:
if r.rx.len < REC_HEADER:
ret 0
end
length := (_bufat(r.rx, 3) << 8) | _bufat(r.rx, 4)
if r.rx.len < REC_HEADER + length:
ret 0
end
ret r.rx.len
end
func _rec_read(r &: RecordLayer, typ &: int, out &: Buf): bool:
if r.failed:
ret false
end
if not _rec_need(r, REC_HEADER):
ret false
end
ctype := _bufat(r.rx, 0)
length := (_bufat(r.rx, 3) << 8) | _bufat(r.rx, 4)
if length > REC_MAX_CIPHERTEXT:
_rec_fail(r, "record too large")
ret false
end
if not _rec_need(r, REC_HEADER + length):
_rec_fail(r, "truncated record")
ret false
end
mut hdr := _newbuf(REC_HEADER)
defer _buf_free(hdr)
mut n12 := _newbuf(12)
defer _buf_free(n12)
mut a12 := _newbuf(16)
defer _buf_free(a12)
mut p12 := _newbuf(REC_MAX_CIPHERTEXT)
defer _buf_free(p12)
repeat REC_HEADER in i:
_put8(hdr, _bufat(r.rx, i))
end
_bufreset(out)
if not r.rxk.live:
repeat length in i:
_put8(out, _bufat(r.rx, REC_HEADER + i))
end
_bufconsume(r.rx, REC_HEADER + length)
typ = ctype
ret true
end
if ctype == REC_CHANGE_CIPHER_SPEC:
_bufconsume(r.rx, REC_HEADER + length)
typ = REC_CHANGE_CIPHER_SPEC
ret true
end
if length < 17:
_rec_fail(r, "encrypted record shorter than its tag")
ret false
end
if r.rxk.is12:
exp := r.rxk.explicit_len
if length < exp + 17:
_rec_fail(r, "encrypted record too short")
ret false
end
content_len := length - exp - 16
_bufreset(n12)
if exp > 0:
repeat 4 in i:
_put8(n12, _bufat(r.rxk.iv, i))
end
repeat 8 in i:
_put8(n12, _bufat(r.rx, REC_HEADER + i))
end
else:
_putzeros(n12, 12)
_tk_nonce(r.rxk, n12)
end
_tk12_aad(r.rxk.seq, ctype, content_len, a12)
_bufreset(p12)
_putzeros(p12, content_len)
cp := _bufptr(r.rx, REC_HEADER + exp)
tp := _bufptr(r.rx, REC_HEADER + exp + content_len)
if not _aead_open(r.rxk, n12, a12.p, a12.len, cp, content_len, tp, p12.p):
_rec_fail(r, "bad record MAC")
ret false
end
_bufconsume(r.rx, REC_HEADER + length)
if not _tk_advance(r.rxk):
_rec_fail(r, "sequence number exhausted")
ret false
end
repeat content_len in i:
_put8(out, _bufat(p12, i))
end
typ = ctype
ret true
end
ctlen := length - 16
mut nonce := _newbuf(12)
defer _buf_free(nonce)
_putzeros(nonce, 12)
_tk_nonce(r.rxk, nonce)
mut plain := _newbuf(ctlen + 1)
defer _buf_free(plain)
_putzeros(plain, ctlen)
ctp := _bufptr(r.rx, REC_HEADER)
tagp := _bufptr(r.rx, REC_HEADER + ctlen)
if not _aead_open(r.rxk, nonce, hdr.p, REC_HEADER, ctp, ctlen, tagp, plain.p):
_rec_fail(r, "bad record MAC")
ret false
end
_bufconsume(r.rx, REC_HEADER + length)
if not _tk_advance(r.rxk):
_rec_fail(r, "sequence number exhausted")
ret false
end
mut last := ctlen - 1
until last >= 0 and _bufat(plain, last) == 0:
last -= 1
end
if last < 0:
_rec_fail(r, "record with no content type")
ret false
end
typ = _bufat(plain, last)
repeat last in i:
_put8(out, _bufat(plain, i))
end
ret true
end
func _rec_write_raw(r &: RecordLayer, typ: int, p: void*, n: int): bool:
mut rec := _newbuf(n + REC_HEADER + 32)
defer _buf_free(rec)
mut inner := _newbuf(n + 1)
defer _buf_free(inner)
mut nonce := _newbuf(12)
defer _buf_free(nonce)
mut ct := _newbuf(n + 1)
defer _buf_free(ct)
mut tag := _newbuf(16)
defer _buf_free(tag)
mut wa12 := _newbuf(16)
defer _buf_free(wa12)
if not r.txk.live:
_put8(rec, typ)
_put16(rec, TLS12)
_put16(rec, n)
_putraw(rec, p, n)
else if r.txk.is12:
exp := r.txk.explicit_len
_put8(rec, typ)
_put16(rec, TLS12)
_put16(rec, exp + n + 16)
_putzeros(nonce, 12)
_tk_nonce(r.txk, nonce)
if exp > 0:
repeat 8 in i:
_put8(rec, _bufat(nonce, 4 + i))
end
end
_tk12_aad(r.txk.seq, typ, n, wa12)
_putzeros(ct, n)
_putzeros(tag, 16)
_aead_seal(r.txk, nonce, wa12.p, wa12.len, p, ct.p, n, tag.p)
_putbuf(rec, ct)
_putbuf(rec, tag)
if not _tk_advance(r.txk):
_rec_fail(r, "sequence number exhausted")
ret false
end
else:
_putraw(inner, p, n)
_put8(inner, typ)
_put8(rec, REC_APPLICATION_DATA)
_put16(rec, TLS12)
_put16(rec, inner.len + 16)
_putzeros(nonce, 12)
_tk_nonce(r.txk, nonce)
_putzeros(ct, inner.len)
_putzeros(tag, 16)
_aead_seal(r.txk, nonce, rec.p, REC_HEADER, inner.p, ct.p, inner.len, tag.p)
_putbuf(rec, ct)
_putbuf(rec, tag)
if not _tk_advance(r.txk):
_rec_fail(r, "sequence number exhausted")
ret false
end
end
sent := rawsock.SendBytes(rawsock.FromFd(r.fd), rec.p, rec.len)
if sent != rec.len:
_rec_fail(r, "short write")
ret false
end
ret true
end
func _rec_write(r &: RecordLayer, typ: int, p: void*, n: int): bool:
if r.failed:
ret false
end
mut off := 0
if n == 0:
ret _rec_write_raw(r, typ, p, 0)
end
until off < n:
mut take := n - off
if take > REC_MAX_PLAINTEXT:
take = REC_MAX_PLAINTEXT
end
if not _rec_write_raw(r, typ, ((p as i64) + (off as i64)) as void*, take):
ret false
end
off += take
end
ret true
end
func _rec_write_plain(r &: RecordLayer, typ: int, p: void*, n: int): bool:
mut rec := _newbuf(n + REC_HEADER)
defer _buf_free(rec)
_put8(rec, typ)
_put16(rec, TLS12)
_put16(rec, n)
_putraw(rec, p, n)
sent := rawsock.SendBytes(rawsock.FromFd(r.fd), rec.p, rec.len)
if sent != rec.len:
_rec_fail(r, "short write")
ret false
end
ret true
end
func _rec_send_alert(r &: RecordLayer, level: int, desc: int):
mut a := _newbuf(2)
defer _buf_free(a)
_put8(a, level)
_put8(a, desc)
_rec_write(r, REC_ALERT, a.p, 2)
end
package tls
if SALAM_OS_WIN64:
link dynamic "crypt32"
extern:
func CertOpenSystemStoreA(hprov: i64, subsystem: str): void*
func CertEnumCertificatesInStore(store: void*, prev: void*): void*
func CertCloseStore(store: void*, flags: int): int
end
else:
if SALAM_OS_MAC:
link framework "Security"
link framework "CoreFoundation"
extern:
func SecTrustCopyAnchorCertificates(anchors: void*): int
func CFArrayGetCount(arr: void*): i64
func CFArrayGetValueAtIndex(arr: void*, idx: i64): void*
func SecCertificateCopyData(cert: void*): void*
func CFDataGetBytePtr(data: void*): void*
func CFDataGetLength(data: void*): i64
func CFRelease(obj: void*)
end
end
end
const PEM_BEGIN := "-----BEGIN CERTIFICATE-----"
const PEM_END := "-----END CERTIFICATE-----"
const CA_PATH_0 := "/etc/ssl/certs/ca-certificates.crt"
const CA_PATH_1 := "/etc/pki/tls/certs/ca-bundle.crt"
const CA_PATH_2 := "/etc/ssl/ca-bundle.pem"
const CA_PATH_3 := "/etc/ssl/cert.pem"
const CA_PATH_4 := "/usr/local/etc/ssl/cert.pem"
const CA_PATH_5 := "/usr/local/share/certs/ca-root-nss.crt"
const CA_PATH_6 := "/etc/ssl/certs/ca-bundle.crt"
const CA_PATH_7 := "C:/Program Files/Git/mingw64/etc/ssl/certs/ca-bundle.crt"
const CA_PATH_8 := "C:/Program Files/Git/usr/ssl/certs/ca-bundle.crt"
const CA_PATH_9 := "C:/msys64/etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem"
const CA_PATH_10 := "/usr/pkg/etc/openssl/certs/ca-certificates.crt"
const CA_PATH_COUNT := 11
mut _shared_roots := Roots {}
mut _shared_key := ""
mut _shared_ready := false
func _ca_path(i: int): str:
if i == 0: ret CA_PATH_0 end
if i == 1: ret CA_PATH_1 end
if i == 2: ret CA_PATH_2 end
if i == 3: ret CA_PATH_3 end
if i == 4: ret CA_PATH_4 end
if i == 5: ret CA_PATH_5 end
if i == 6: ret CA_PATH_6 end
if i == 7: ret CA_PATH_7 end
if i == 8: ret CA_PATH_8 end
if i == 9: ret CA_PATH_9 end
if i == 10: ret CA_PATH_10 end
ret ""
end
func _roots_add_pem(r &: Roots, pem: str): int:
mut added := 0
mut pos := 0
n := pem.len()
until pos < n:
b := str.IndexFrom(pem, PEM_BEGIN, pos)
if b < 0:
ret added
end
body := b + PEM_BEGIN.len()
e := str.IndexFrom(pem, PEM_END, body)
if e < 0:
ret added
end
room := (e - body) / 4 * 3 + 8
mut der := _newbuf(room)
mut good := false
b64 := pem.substr(body, e - body)
got := encoding.Base64DecodeBytes(b64, der.p, room, good)
mem.Free(b64 as void*)
if good and got > 0:
c := _cert_parse(der.p, got)
if c.ok:
_roots_add(r, der.p, got)
added += 1
end
end
_buf_free(der)
pos = e + PEM_END.len()
end
ret added
end
func _embedded_roots_pem(): str:
ret ""
end
if SALAM_OS_WIN64:
func _roots_load_native(r &: Roots): int:
store := CertOpenSystemStoreA(0, "ROOT")
if store == null:
ret 0
end
mut added := 0
mut ctx := null as void*
mut going := true
until going:
ctx = CertEnumCertificatesInStore(store, ctx)
if ctx == null:
going = false
else:
pp := (ctx as i64 + 8) as i64*
lp := (ctx as i64 + 16) as int*
der := pp[0] as void*
dlen := lp[0]
if der != null and dlen > 0:
_roots_add(r, der, dlen)
added += 1
end
end
end
CertCloseStore(store, 0)
ret added
end
else:
if SALAM_OS_MAC:
func _roots_load_native(r &: Roots): int:
outbuf := mem.Allocate(8 as u64)
defer mem.Free(outbuf)
outp := outbuf as i64*
outp[0] = 0
status := SecTrustCopyAnchorCertificates(outbuf)
if status != 0:
ret 0
end
arr := outp[0] as void*
if arr == null:
ret 0
end
defer CFRelease(arr)
n := CFArrayGetCount(arr)
mut added := 0
mut i := 0 as i64
until i >= n:
cert := CFArrayGetValueAtIndex(arr, i)
if cert != null:
data := SecCertificateCopyData(cert)
if data != null:
p := CFDataGetBytePtr(data)
dlen := CFDataGetLength(data)
if p != null and dlen > 0:
_roots_add(r, p, dlen as int)
added += 1
end
CFRelease(data)
end
end
i += 1
end
ret added
end
else:
func _roots_load_native(_r &: Roots): int:
ret 0
end
end
end
func _roots_load_file(r &: Roots, path: str): int:
if path.len() == 0:
ret 0
end
if not os.Exists(path):
ret 0
end
pem := io.ReadFile(path)
if pem.len() == 0:
mem.Free(pem as void*)
ret 0
end
added := _roots_add_pem(r, pem)
mem.Free(pem as void*)
ret added
end
func _roots_shared(ca_file: str): Roots:
if _shared_ready and _shared_key == ca_file:
ret _shared_roots
end
if _shared_ready:
_roots_free(_shared_roots)
end
_shared_roots = _roots_load(ca_file)
_shared_key = ca_file
_shared_ready = true
ret _shared_roots
end
func _roots_load(ca_file: str): Roots:
mut r := _roots_new()
if ca_file.len() > 0:
_roots_load_file(r, ca_file)
ret r
end
env := os.Env("SSL_CERT_FILE")
if env.len() > 0:
_roots_load_file(r, env)
ret r
end
if _roots_load_native(r) > 0:
ret r
end
mut i := 0
until i < CA_PATH_COUNT:
if _roots_load_file(r, _ca_path(i)) > 0:
ret r
end
i += 1
end
emb := _embedded_roots_pem()
if emb.len() > 0:
_roots_add_pem(r, emb)
end
ret r
end
package tls
const RSA_MAX_BYTES := 1024
func _rsa_digestinfo(kind: int): str:
if kind == HASH_SHA384:
ret "3041300d060960864801650304020205000430"
end
ret "3031300d060960864801650304020105000420"
end
func _rsa_public_op(sig: void*, siglen: int, nmod: void*, nlen: int, expo: void*, elen: int, out: void*, klen: int): bool:
mut n := _big_from_bytes(nmod, nlen)
defer _big_free(n)
mut e := _big_from_bytes(expo, elen)
defer _big_free(e)
mut s := _big_from_bytes(sig, siglen)
defer _big_free(s)
if n.bad or e.bad or s.bad:
ret false
end
if _big_is_zero(n) or _big_is_zero(e):
ret false
end
if _big_cmp(s, n) >= 0:
ret false
end
mut m := _big_new(n.n + 2)
defer _big_free(m)
if m.bad:
ret false
end
if not _big_modexp_barrett(m, s, e, n):
ret false
end
ret _big_to_bytes(m, out, klen)
end
func _rsa_verify_pkcs1(kind: int, digest: void*, nmod: void*, nlen: int, expo: void*, elen: int, sig: void*, siglen: int): bool:
klen := nlen
if klen < 16 or klen > RSA_MAX_BYTES:
ret false
end
if siglen != klen:
ret false
end
hlen := _hash_size(kind)
mut di := _hexbuf(_rsa_digestinfo(kind))
defer _buf_free(di)
mut want := _newbuf(klen)
defer _buf_free(want)
tlen := di.len + hlen
if klen < tlen + 11:
ret false
end
_put8(want, 0x00)
_put8(want, 0x01)
pslen := klen - tlen - 3
repeat pslen:
_put8(want, 0xFF)
end
_put8(want, 0x00)
_putbuf(want, di)
_putraw(want, digest, hlen)
mut got := _newbuf(klen)
defer _buf_free(got)
_putzeros(got, klen)
if not _rsa_public_op(sig, siglen, nmod, nlen, expo, elen, got.p, klen):
ret false
end
ret _cteq(got.p, want.p, klen)
end
func _mgf1(kind: int, seed: void*, seedlen: int, out: void*, outlen: int):
hlen := _hash_size(kind)
mut ctr := _newbuf(4)
defer _buf_free(ctr)
_putzeros(ctr, 4)
mut blk := _newbuf(hlen)
defer _buf_free(blk)
_putzeros(blk, hlen)
mut done := 0
mut counter := 0
until done < outlen:
_bufset(ctr, 0, (counter >> 24) & 0xFF)
_bufset(ctr, 1, (counter >> 16) & 0xFF)
_bufset(ctr, 2, (counter >> 8) & 0xFF)
_bufset(ctr, 3, counter & 0xFF)
mut h := _hash_init(kind)
_hash_update(h, seed, seedlen)
_hash_update(h, ctr.p, 4)
_hash_final(h, blk.p)
mut take := outlen - done
if take > hlen:
take = hlen
end
repeat take in i:
_bput(out, done + i, _bufat(blk, i))
end
done += take
counter += 1
end
end
func _rsa_verify_pss(kind: int, digest: void*, nmod: void*, nlen: int, expo: void*, elen: int, sig: void*, siglen: int, slen: int): bool:
klen := nlen
if klen < 16 or klen > RSA_MAX_BYTES:
ret false
end
if siglen != klen:
ret false
end
hlen := _hash_size(kind)
mut nbig := _big_from_bytes(nmod, nlen)
defer _big_free(nbig)
modbits := _big_bitlen(nbig)
if modbits < 2:
ret false
end
emlen := (modbits - 1 + 7) / 8
if emlen < hlen + slen + 2:
ret false
end
mut em := _newbuf(klen)
defer _buf_free(em)
_putzeros(em, klen)
if not _rsa_public_op(sig, siglen, nmod, nlen, expo, elen, em.p, klen):
ret false
end
skip := klen - emlen
repeat skip in i:
if _bufat(em, i) != 0:
ret false
end
end
if _bufat(em, klen - 1) != 0xbc:
ret false
end
dblen := emlen - hlen - 1
hoff := skip + dblen
unused := 8 * emlen - (modbits - 1)
topmask := (0xFF >> unused) & 0xFF
if (_bufat(em, skip) & ~topmask & 0xFF) != 0:
ret false
end
mut dbmask := _newbuf(dblen)
defer _buf_free(dbmask)
_putzeros(dbmask, dblen)
_mgf1(kind, _bufptr(em, hoff), hlen, dbmask.p, dblen)
mut db := _newbuf(dblen)
defer _buf_free(db)
repeat dblen in i:
_put8(db, _bufat(em, skip + i) ^ _bufat(dbmask, i))
end
_bufset(db, 0, _bufat(db, 0) & topmask)
pslen := dblen - slen - 1
repeat pslen in i:
if _bufat(db, i) != 0:
ret false
end
end
if _bufat(db, pslen) != 0x01:
ret false
end
mut mprime := _newbuf(8 + hlen + slen)
defer _buf_free(mprime)
_putzeros(mprime, 8)
_putraw(mprime, digest, hlen)
repeat slen in i:
_put8(mprime, _bufat(db, pslen + 1 + i))
end
mut hprime := _newbuf(hlen)
defer _buf_free(hprime)
_putzeros(hprime, hlen)
_hash_oneshot(kind, mprime.p, mprime.len, hprime.p)
ret _cteq(hprime.p, _bufptr(em, hoff), hlen)
end
package tls
func _rsa_private_op_blinded(msg: void*, mlen: int, nmod: void*, nlen: int, dexp: void*, dlen: int, eexp: void*, elen: int, phi: void*, philen: int, out: void*, klen: int): bool:
mut n := _big_from_bytes(nmod, nlen)
defer _big_free(n)
mut e := _big_from_bytes(eexp, elen)
defer _big_free(e)
mut d := _big_from_bytes(dexp, dlen)
defer _big_wipe_free(d)
mut ph := _big_from_bytes(phi, philen)
defer _big_wipe_free(ph)
mut m := _big_from_bytes(msg, mlen)
defer _big_free(m)
if n.bad or e.bad or d.bad or ph.bad or m.bad:
ret false
end
if _big_is_zero(n) or _big_cmp(m, n) >= 0:
ret false
end
mut rbytes := _newbuf(nlen)
defer _buf_wipe(rbytes)
crypto.RandomBytes(rbytes.p, nlen)
mut rraw := _big_from_bytes(rbytes.p, nlen)
defer _big_wipe_free(rraw)
if rraw.bad:
ret false
end
mut r := _big_new(n.n + 1)
defer _big_wipe_free(r)
if not _big_mod(r, rraw, n):
ret false
end
if _big_is_zero(r):
ret false
end
mut re := _big_new(n.n + 1)
defer _big_free(re)
if not _big_modexp_barrett(re, r, e, n):
ret false
end
mut prod := _big_new(2 * n.n + 2)
defer _big_wipe_free(prod)
_big_mul(prod, m, re)
if prod.bad:
ret false
end
mut blinded := _big_new(n.n + 1)
defer _big_wipe_free(blinded)
if not _big_mod(blinded, prod, n):
ret false
end
mut s := _big_new(n.n + 1)
defer _big_wipe_free(s)
if not _big_modexp_barrett(s, blinded, d, n):
ret false
end
mut one := _big_new(1)
defer _big_free(one)
_big_set_u32(one, 1 as u32)
mut phim1 := _big_new(ph.n + 1)
defer _big_wipe_free(phim1)
if not _big_sub(phim1, ph, one):
ret false
end
mut rinv := _big_new(n.n + 1)
defer _big_wipe_free(rinv)
if not _big_modexp_barrett(rinv, r, phim1, n):
ret false
end
mut prod2 := _big_new(2 * n.n + 2)
defer _big_wipe_free(prod2)
_big_mul(prod2, s, rinv)
if prod2.bad:
ret false
end
mut result := _big_new(n.n + 1)
defer _big_wipe_free(result)
if not _big_mod(result, prod2, n):
ret false
end
ret _big_to_bytes(result, out, klen)
end
func _rsa_sign_pkcs1(kind: int, digest: void*, n: Buf, e: Buf, d: Buf, phi: Buf, sigout: void*): bool:
klen := n.len
if klen < 16 or klen > RSA_MAX_BYTES:
ret false
end
hlen := _hash_size(kind)
mut di := _hexbuf(_rsa_digestinfo(kind))
defer _buf_free(di)
tlen := di.len + hlen
if klen < tlen + 11:
ret false
end
mut em := _newbuf(klen)
defer _buf_free(em)
_put8(em, 0x00)
_put8(em, 0x01)
pslen := klen - tlen - 3
repeat pslen:
_put8(em, 0xFF)
end
_put8(em, 0x00)
_putbuf(em, di)
_putraw(em, digest, hlen)
ret _rsa_private_op_blinded(em.p, em.len, n.p, n.len, d.p, d.len, e.p, e.len, phi.p, phi.len, sigout, klen)
end
func _rsa_sign_pss(kind: int, digest: void*, n: Buf, e: Buf, d: Buf, phi: Buf, slen: int, sigout: void*): bool:
klen := n.len
if klen < 16 or klen > RSA_MAX_BYTES:
ret false
end
hlen := _hash_size(kind)
mut nbig := _big_from_bytes(n.p, n.len)
defer _big_free(nbig)
modbits := _big_bitlen(nbig)
if modbits < 2:
ret false
end
emlen := (modbits - 1 + 7) / 8
if emlen < hlen + slen + 2:
ret false
end
dblen := emlen - hlen - 1
skip := klen - emlen
mut salt := _newbuf(slen)
defer _buf_wipe(salt)
_putzeros(salt, slen)
crypto.RandomBytes(salt.p, slen)
mut mprime := _newbuf(8 + hlen + slen)
defer _buf_free(mprime)
_putzeros(mprime, 8)
_putraw(mprime, digest, hlen)
_putbuf(mprime, salt)
mut hpr := _newbuf(hlen)
defer _buf_free(hpr)
_putzeros(hpr, hlen)
_hash_oneshot(kind, mprime.p, mprime.len, hpr.p)
mut dbmask := _newbuf(dblen)
defer _buf_free(dbmask)
_putzeros(dbmask, dblen)
_mgf1(kind, hpr.p, hlen, dbmask.p, dblen)
pslen := dblen - slen - 1
mut em := _newbuf(klen)
defer _buf_free(em)
_putzeros(em, skip)
repeat pslen in i:
_put8(em, 0x00 ^ _bufat(dbmask, i))
end
_put8(em, 0x01 ^ _bufat(dbmask, pslen))
repeat slen in i:
_put8(em, _bufat(salt, i) ^ _bufat(dbmask, pslen + 1 + i))
end
unused := 8 * emlen - (modbits - 1)
topmask := (0xFF >> unused) & 0xFF
_bufset(em, skip, _bufat(em, skip) & topmask)
_putbuf(em, hpr)
_put8(em, 0xbc)
ret _rsa_private_op_blinded(em.p, em.len, n.p, n.len, d.p, d.len, e.p, e.len, phi.p, phi.len, sigout, klen)
end
package tls
mut _st_fails := 0
mut _st_total := 0
func _ck(cond: bool, name: str):
_st_total += 1
if not cond:
_st_fails += 1
println "  FAIL:", name
end
end
func _ckhex(got: str, want: str, name: str):
_st_total += 1
if got != want:
_st_fails += 1
println "  FAIL:", name
println "    got  ", got
println "    want ", want
end
end
@en "SelfTest"
@fa "خودآزمایی"
pub func SelfTest(): int:
_st_fails = 0
_st_total = 0
println "tls self-test"
_selftest_bytes()
_selftest_sha()
_selftest_prf()
_selftest_legacy()
_selftest_hmac()
_selftest_hkdf()
_selftest_chacha()
_selftest_aes()
_selftest_bigint()
_selftest_x25519()
_selftest_p256()
_selftest_p384()
_selftest_sig()
_selftest_sign()
_selftest_x509()
_selftest_ip()
_selftest_verify()
_selftest_roots()
_selftest_fuzz()
if _st_fails == 0:
println "tls self-test:", _st_total, "checks passed"
else:
println "tls self-test:", _st_fails, "of", _st_total, "checks FAILED"
end
ret _st_fails
end
package tls
func _bighex(x: Big): str:
n := _big_bytelen(x)
if n == 0:
ret "00"
end
mut o := _newbuf(n)
defer _buf_free(o)
_putzeros(o, n)
if not _big_to_bytes(x, o.p, n):
ret "TOOBIG"
end
ret _hexofbuf(o)
end
func _bigof(hex: str): Big:
mut h := _hexbuf(hex)
defer _buf_free(h)
ret _big_from_bytes(h.p, h.len)
end
func _selftest_bigint():
mut a := _bigof("123456789abcdef0fedcba9876543210")
defer _big_free(a)
mut b := _bigof("deadbeefcafebabe0123456789abcdef")
defer _big_free(b)
mut m := _bigof("fedcba9876543210123456789abcdef1")
defer _big_free(m)
_ckhex(_bighex(a), "123456789abcdef0fedcba9876543210", "big from/to bytes")
mut lz := _bigof("0000000000ff00")
defer _big_free(lz)
_ckhex(_bighex(lz), "ff00", "big strips leading zeros")
mut zero := _bigof("00000000")
defer _big_free(zero)
_ck(_big_is_zero(zero), "big zero detected")
_ck(_big_bitlen(zero) == 0, "big zero bitlen")
_ck(_big_cmp(a, b) < 0, "big cmp a < b")
_ck(_big_cmp(b, a) > 0, "big cmp b > a")
_ck(_big_cmp(a, a) == 0, "big cmp equal")
mut r := _big_new(16)
defer _big_free(r)
_big_add(r, a, b)
_ckhex(_bighex(r), "f0e2156865bb99aeffffffffffffffff", "big add")
_ck(_big_sub(r, b, a), "big sub ok")
_ckhex(_bighex(r), "cc7968773041dbcd02468acf13579bdf", "big sub")
_ck(not _big_sub(r, a, b), "big sub refuses to go negative")
_big_add(r, a, b)
mut back := _big_new(16)
defer _big_free(back)
_ck(_big_sub(back, r, b), "big add/sub inverse ok")
_ck(_big_cmp(back, a) == 0, "big add then sub restores a")
mut p := _big_new(32)
defer _big_free(p)
_big_mul(p, a, b)
_ckhex(_bighex(p), "0fd5bdeeeb2a01d8c92db8cd43d35b8d6e1bd1a5075ef1322236d88fe5618cf0", "big mul")
_big_mul(p, a, zero)
_ck(_big_is_zero(p), "big mul by zero")
mut one := _big_new(4)
defer _big_free(one)
_big_set_u32(one, 1 as u32)
_big_mul(p, a, one)
_ck(_big_cmp(p, a) == 0, "big mul by one")
mut q := _big_new(32)
defer _big_free(q)
mut rem := _big_new(32)
defer _big_free(rem)
_ck(_big_divmod(q, rem, a, m), "big divmod ok")
_ck(_big_is_zero(q), "big divmod quotient a/m")
_ckhex(_bighex(rem), "123456789abcdef0fedcba9876543210", "big divmod remainder a%m")
_big_mul(p, a, b)
_ck(_big_mod(rem, p, m), "big mod of product ok")
_ckhex(_bighex(rem), "c66d3edf67c257e839c2e724dc6e39c8", "big (a*b) mod m")
_ck(_big_divmod(q, rem, p, m), "big divmod product ok")
mut chk := _big_new(64)
defer _big_free(chk)
_big_mul(chk, q, m)
mut sum := _big_new(64)
defer _big_free(sum)
_big_add(sum, chk, rem)
_ck(_big_cmp(sum, p) == 0, "big q*m + rem == a*b")
_ck(_big_cmp(rem, m) < 0, "big remainder is reduced")
_ck(not _big_divmod(q, rem, a, zero), "big divmod rejects zero modulus")
mut n := _bigof("c4f8e9e15dcadf2b96c763d981006a644ffb4415030a16ed1283883340f2aa0e2be2be8fa60150b9046965837c3e7d151b7de237ebb957c20663898250703b3f5f4b1e8b8bb7f8b9c1a1e1e2b0d9f0e5f0a0b1c2d3e4f5061728394a5b6c7d8e9fa0b1c2d3e4f50617")
defer _big_free(n)
mut base := _bigof("1234567890abcdef")
defer _big_free(base)
mut e := _bigof("010001")
defer _big_free(e)
mut out := _big_new(n.n + 2)
defer _big_free(out)
_ck(_big_modexp(out, base, e, n), "big modexp ok")
_ckhex(
_bighex(out),
"1639860633a2eb152470d64d2418b9a02b502baaf3031ac7692bc447e6d082915c2fa8348c97f7253ccc0f4fa5bcfe3c0a9abd2bb54ae32b2f909fcebce85e6857d4a475c1c1e323bdf0433b7209102bac675fdef1b52e85c7fb078d13c0823060f3f746a4c8e65c94",
"big modexp base^65537 mod n"
)
mut e0 := _big_new(2)
defer _big_free(e0)
_big_set_u32(e0, 0 as u32)
_ck(_big_modexp(out, base, e0, n), "big modexp exponent 0 ok")
_ck(_big_cmp(out, one) == 0, "big modexp x^0 == 1")
mut e1 := _big_new(2)
defer _big_free(e1)
_big_set_u32(e1, 1 as u32)
_ck(_big_modexp(out, base, e1, n), "big modexp exponent 1 ok")
_ck(_big_cmp(out, base) == 0, "big modexp x^1 == x")
mut outbt := _big_new(n.n + 2)
defer _big_free(outbt)
_ck(_big_modexp_barrett(outbt, base, e, n), "big barrett modexp ok")
_ckhex(
_bighex(outbt),
"1639860633a2eb152470d64d2418b9a02b502baaf3031ac7692bc447e6d082915c2fa8348c97f7253ccc0f4fa5bcfe3c0a9abd2bb54ae32b2f909fcebce85e6857d4a475c1c1e323bdf0433b7209102bac675fdef1b52e85c7fb078d13c0823060f3f746a4c8e65c94",
"big barrett modexp base^65537 mod n"
)
_ck(_big_modexp_barrett(outbt, base, e0, n), "big barrett modexp exponent 0 ok")
_ck(_big_cmp(outbt, one) == 0, "big barrett modexp x^0 == 1")
_ck(_big_modexp_barrett(outbt, base, e1, n), "big barrett modexp exponent 1 ok")
_ck(_big_cmp(outbt, base) == 0, "big barrett modexp x^1 == x")
mut edense := _bigof("d3a71f04b96e2c85f10a7b3c9e5d28460f")
defer _big_free(edense)
mut outplain := _big_new(n.n + 2)
defer _big_free(outplain)
_ck(_big_modexp(outplain, base, edense, n), "big modexp dense exponent ok")
_ck(_big_modexp_barrett(outbt, base, edense, n), "big barrett modexp dense exponent ok")
_ckhex(
_bighex(outbt), _bighex(outplain), "big barrett agrees with bit-serial on a dense exponent"
)
mut wbase := _bigof("f1e2d3c4b5a6978800112233445566778899aabbccddeeff0f1e2d3c4b5a69788")
defer _big_free(wbase)
_ck(_big_modexp(outplain, wbase, edense, n), "big modexp wide base ok")
_ck(_big_modexp_barrett(outbt, wbase, edense, n), "big barrett modexp wide base ok")
_ckhex(
_bighex(outbt), _bighex(outplain), "big barrett agrees with bit-serial on a wide base"
)
mut tiny := _newbuf(4)
defer _buf_free(tiny)
_putzeros(tiny, 4)
_ck(not _big_to_bytes(a, tiny.p, 4), "big to_bytes rejects short buffer")
mut wide := _newbuf(32)
defer _buf_free(wide)
_putzeros(wide, 32)
_ck(_big_to_bytes(a, wide.p, 32), "big to_bytes pads to width")
_ckhex(_hexofbuf(wide), "0000000000000000000000000000000" + "0123456789abcdef0fedcba9876543210", "big to_bytes zero-pads on the left")
end
package tls
func _selftest_bytes():
mut b := _newbuf(8)
defer _buf_free(b)
_put8(b, 0x01)
_put16(b, 0x0203)
_put24(b, 0x040506)
_put32(b, 0x0708090A as i64)
_put64(b, 0x0B0C0D0E0F101112 as u64)
_ckhex(_hexofbuf(b), "0102030405060708090a0b0c0d0e0f101112", "be writers")
mut t := _newbuf(4)
defer _buf_free(t)
_put8(t, 0x1FF)
_ckhex(_hexofbuf(t), "ff", "put8 masks to one byte")
mut v := _newbuf(16)
defer _buf_free(v)
_put16(v, 7)
_put8(v, 2)
_put8(v, 0xAA)
_put8(v, 0xBB)
_put24(v, 1)
_put8(v, 0xCC)
mut r := _readerof(v)
mut outer := _rdvec16(r)
mut inner := _rdvec8(outer)
_ck(inner.len == 2, "vec8 length")
_ck(_rd8(inner) == 0xAA, "vec8 first byte")
_ck(_rd8(inner) == 0xBB, "vec8 second byte")
mut inner2 := _rdvec24(outer)
_ck(inner2.len == 1, "vec24 length")
_ck(_rd8(inner2) == 0xCC, "vec24 byte")
_ck(not r.bad, "well-formed parse leaves bad clear")
_ck(_rdleft(r) == 0, "outer fully consumed")
mut sr := _readerof(v)
_rdskip(sr, v.len)
_ck(not sr.bad, "skip to exact end is fine")
x := _rd8(sr)
_ck(sr.bad, "read past end latches bad")
_ck(x == 0, "read past end yields zero")
_ck(_rd16(sr) == 0, "reads stay zero once bad")
_ck(_rdleft(sr) == 0, "left is zero once bad")
sub := _rdbytes(sr, 4)
_ck(sub.len == 0, "sub-reader of a bad reader is empty")
mut o := _newbuf(8)
defer _buf_free(o)
_put8(o, 200)
_put8(o, 0x11)
mut orr := _readerof(o)
over := _rdvec8(orr)
_ck(orr.bad, "over-long vector latches bad")
_ck(over.len == 0, "over-long vector yields empty")
mut p := _newbuf(16)
defer _buf_free(p)
_put8(p, 0x16)
lenoff := p.len
_put16(p, 0)
body := p.len
_put8(p, 0xDE)
_put8(p, 0xAD)
_patch16(p, lenoff, p.len - body)
_ckhex(_hexofbuf(p), "160002dead", "patch16 backfills length")
mut p24 := _newbuf(16)
defer _buf_free(p24)
off := p24.len
_put24(p24, 0)
_put8(p24, 0xFF)
_patch24(p24, off, 1)
_ckhex(_hexofbuf(p24), "000001ff", "patch24 backfills length")
mut cbuf := _newbuf(8)
defer _buf_free(cbuf)
_put32(cbuf, 0x01020304 as i64)
_bufconsume(cbuf, 1)
_ckhex(_hexofbuf(cbuf), "020304", "consume drops prefix")
_bufconsume(cbuf, 99)
_ck(cbuf.len == 0, "over-long consume empties")
mut g := _newbuf(1)
defer _buf_free(g)
repeat 500 in i:
_put8(g, i & 0xFF)
end
_ck(g.len == 500, "grown length")
_ck(not g.bad, "growth did not fail")
mut gok := true
repeat 500 in i:
if _bufat(g, i) != (i & 0xFF):
gok = false
end
end
_ck(gok, "growth preserved contents")
mut a1 := _hexbuf("00112233")
defer _buf_free(a1)
mut a2 := _hexbuf("00112233")
defer _buf_free(a2)
mut a3 := _hexbuf("00112234")
defer _buf_free(a3)
_ck(_cteq(a1.p, a2.p, 4), "cteq equal")
