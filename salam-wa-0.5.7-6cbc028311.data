func _big_shl1(x &: Big):
mut carry := 0 as u32
lim := x.n
repeat lim in i:
v := _limb(x, i)
_setlimb(x, i, (v << (1 as u32)) | carry)
carry = v >> (31 as u32)
end
if carry != (0 as u32):
if x.n >= x.cap:
x.bad = true
ret
end
_setlimb(x, x.n, carry)
x.n += 1
end
