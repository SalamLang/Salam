@en "yaml"
@fa "یامل"
package yaml
import str
import conv
struct _YR:
pub value: str = ""
pub next: int = 0
pub ok: bool = true
end
inline pure func _bp(s: str): i8*: ret (s as void*) as i8* end
inline pure func _ub(bp: i8*, i: int): int:
mut v := bp[i] as int
if v < 0: v = v + 256 end
ret v
end
func _raw_indent(raw: str): int:
n := raw.len()
bp := _bp(raw)
mut i := 0
until i < n and _ub(bp, i) == 32:
i = i + 1
end
ret i
end
func _content(raw: str): str:
n := raw.len()
bp := _bp(raw)
mut i := 0
mut inq := 0
mut cut := n
until i < n:
c := _ub(bp, i)
if inq == 1:
if c == 92 and i + 1 < n:
i = i + 1
else c == 34:
inq = 0
end
else inq == 2:
if c == 39:
if i + 1 < n and _ub(bp, i + 1) == 39:
i = i + 1
else:
inq = 0
end
end
else:
if c == 34:
inq = 1
else c == 39:
inq = 2
else c == 35:
if i == 0 or _ub(bp, i - 1) == 32 or _ub(bp, i - 1) == 9:
cut = i
break
end
end
end
i = i + 1
end
ret str.TrimRight(raw.substr(0, cut))
end
func _indent_of(content: str): int:
n := content.len()
bp := _bp(content)
mut i := 0
until i < n and _ub(bp, i) == 32:
i = i + 1
end
ret i
end
func _skip_noise(lines: Vector<str>, li: int): int:
n := lines.len()
mut i := li
until i < n:
c := _content(lines.get(i))
if str.Trim(c) == "":
i = i + 1
else:
break
end
end
ret i
end
func _is_seq_item(t: str): bool:
if t == "-": ret true end
if t.len() >= 2 and t.substr(0, 2) == "- ": ret true end
ret false
end
func _key_colon_pos(t: str): int:
n := t.len()
bp := _bp(t)
mut i := 0
mut depth := 0
mut inq := 0
until i < n:
c := _ub(bp, i)
if inq == 1:
if c == 92 and i + 1 < n:
i = i + 1
else c == 34:
inq = 0
end
else inq == 2:
if c == 39:
if i + 1 < n and _ub(bp, i + 1) == 39:
i = i + 1
else:
inq = 0
end
end
else:
if c == 34:
inq = 1
else c == 39:
inq = 2
else c == 91 or c == 123:
depth = depth + 1
else c == 93 or c == 125:
depth = depth - 1
else c == 58 and depth == 0:
if i + 1 >= n or _ub(bp, i + 1) == 32:
ret i
end
end
end
i = i + 1
end
ret 0 - 1
end
func _key_to_json_string(raw: str): str:
k := str.Trim(raw)
if k.len() >= 1 and k.substr(0, 1) == `"`:
r := _unescape_dq(k, 0)
ret _json_str_literal(r.value)
end
if k.len() >= 1 and k.substr(0, 1) == "'":
r := _unescape_sq(k, 0)
ret _json_str_literal(r.value)
end
ret _json_str_literal(k)
end
func _parse_node(lines: Vector<str>, li0: int, min_indent: int): _YR:
n := lines.len()
li := _skip_noise(lines, li0)
if li >= n: ret _YR { value = "null", next = li } end
content := _content(lines.get(li))
ind := _indent_of(content)
if ind < min_indent: ret _YR { value = "null", next = li0 } end
t := str.TrimLeft(content)
if _is_seq_item(t): ret _parse_seq(lines, li, ind) end
if _key_colon_pos(t) >= 0: ret _parse_map(lines, li, ind) end
ret _parse_leaf(lines, li, t)
end
func _parse_map_entry_text(lines: Vector<str>, li: int, keyval_text: str, ind: int): _YR:
kc := _key_colon_pos(keyval_text)
keypart := str.TrimRight(keyval_text.substr(0, kc))
key_json := _key_to_json_string(keypart)
mut rest := ""
if kc + 1 < keyval_text.len():
rest = str.TrimLeft(keyval_text.substr(kc + 1, keyval_text.len() - kc - 1))
end
n := lines.len()
if rest == "":
nxt := _skip_noise(lines, li + 1)
if nxt < n:
ncontent := _content(lines.get(nxt))
nind := _indent_of(ncontent)
nt := str.TrimLeft(ncontent)
mut allow := false
if nind > ind: allow = true end
if nind == ind and _is_seq_item(nt): allow = true end
if allow:
child := _parse_node(lines, li + 1, nind)
ret _YR { value = key_json.concat(": ").concat(child.value), next = child.next, ok = child.ok }
end
end
ret _YR { value = key_json.concat(": null"), next = li + 1 }
end
leaf := _parse_leaf(lines, li, rest)
ret _YR { value = key_json.concat(": ").concat(leaf.value), next = leaf.next, ok = leaf.ok }
end
func _parse_map(lines: Vector<str>, li: int, ind: int): _YR:
n := lines.len()
members := Vector {} as Vector<str>
defer members.free()
mut cur := li
mut ok := true
until cur < n:
cur = _skip_noise(lines, cur)
if cur >= n: break end
content := _content(lines.get(cur))
ci := _indent_of(content)
if ci != ind: break end
t := str.TrimLeft(content)
if _key_colon_pos(t) < 0: break end
e := _parse_map_entry_text(lines, cur, t, ind)
members.push(e.value)
if e.ok == false: ok = false end
cur = e.next
end
out := Object(members)
ret _YR { value = out, next = cur, ok = ok }
end
func _parse_map_inline(lines: Vector<str>, li: int, first_rest: str, ind: int): _YR:
members := Vector {} as Vector<str>
defer members.free()
e0 := _parse_map_entry_text(lines, li, first_rest, ind)
members.push(e0.value)
mut ok := e0.ok
n := lines.len()
mut cur := e0.next
until cur < n:
cur = _skip_noise(lines, cur)
if cur >= n: break end
content := _content(lines.get(cur))
ci := _indent_of(content)
if ci != ind: break end
t := str.TrimLeft(content)
if _key_colon_pos(t) < 0: break end
e := _parse_map_entry_text(lines, cur, t, ind)
members.push(e.value)
if e.ok == false: ok = false end
cur = e.next
end
out := Object(members)
ret _YR { value = out, next = cur, ok = ok }
end
func _parse_seq(lines: Vector<str>, li: int, ind: int): _YR:
n := lines.len()
items := Vector {} as Vector<str>
defer items.free()
mut cur := li
mut ok := true
until cur < n:
cur = _skip_noise(lines, cur)
if cur >= n: break end
content := _content(lines.get(cur))
ci := _indent_of(content)
if ci != ind: break end
t := str.TrimLeft(content)
if _is_seq_item(t) == false: break end
mut rest := ""
if t.len() > 2: rest = str.TrimLeft(t.substr(2, t.len() - 2)) end
if rest == "":
nxt := _skip_noise(lines, cur + 1)
mut consumed := false
if nxt < n:
ncontent := _content(lines.get(nxt))
nind := _indent_of(ncontent)
if nind > ind:
child := _parse_node(lines, cur + 1, nind)
items.push(child.value)
if child.ok == false: ok = false end
cur = child.next
consumed = true
end
end
if consumed == false:
items.push("null")
cur = cur + 1
end
else:
kc := _key_colon_pos(rest)
if kc >= 0:
mp := _parse_map_inline(lines, cur, rest, ind + 2)
items.push(mp.value)
if mp.ok == false: ok = false end
cur = mp.next
else:
leaf := _parse_leaf(lines, cur, rest)
items.push(leaf.value)
if leaf.ok == false: ok = false end
cur = leaf.next
end
end
end
out := Array(items)
ret _YR { value = out, next = cur, ok = ok }
end
func _parse_leaf(lines: Vector<str>, li: int, text: str): _YR:
n0 := text.len()
if n0 == 0: ret _YR { value = "null", next = li + 1 } end
c0 := text.substr(0, 1)
if c0 == "|" or c0 == ">":
ret _parse_block_scalar(lines, li, text)
end
if c0 == `"`:
r := _unescape_dq(text, 0)
ret _YR { value = _json_str_literal(r.value), next = li + 1, ok = r.ok }
end
if c0 == "'":
r := _unescape_sq(text, 0)
ret _YR { value = _json_str_literal(r.value), next = li + 1, ok = r.ok }
end
if c0 == "[" or c0 == "{":
g := _gather_flow_text(lines, li, text)
fv := _flow_value(g.value, 0, 0)
ret _YR { value = fv.value, next = g.next, ok = fv.ok }
end
tok := _bool_or_null_token(text)
if tok != "NOMATCH": ret _YR { value = tok, next = li + 1 } end
if _looks_numeric(text):
mut nt := text
if nt.substr(0, 1) == "+": nt = nt.substr(1, nt.len() - 1) end
ret _YR { value = nt, next = li + 1 }
end
ret _YR { value = _json_str_literal(text), next = li + 1 }
end
func _truncate_to_first_doc(text: str): str:
lines := text.split("\n")
defer lines.free()
out_lines := Vector {} as Vector<str>
defer out_lines.free()
mut started := false
n := lines.len()
mut i := 0
until i < n:
raw := lines.get(i)
t := str.Trim(raw)
if t == "---":
if started: break end
else t == "...":
break
else:
if t != "": started = true end
out_lines.push(raw)
end
i = i + 1
end
out := str.Join(out_lines, "\n")
ret out
end
func _parse_document(text: str): _YR:
t := _truncate_to_first_doc(text)
lines := t.split("\n")
defer lines.free()
r := _parse_node(lines, 0, 0)
ret r
end
func _json_unescape(inner: str): str:
n := inner.len()
bp := _bp(inner)
mut sb := str.NewBuilder()
defer str.BufFree(sb)
mut i := 0
until i < n:
c := _ub(bp, i)
if c == 92 and i + 1 < n:
e := _ub(bp, i + 1)
if e == 34: str.BufAppendChar(sb, 34)
else e == 92: str.BufAppendChar(sb, 92)
else e == 110: str.BufAppendChar(sb, 10)
else e == 116: str.BufAppendChar(sb, 9)
else e == 114: str.BufAppendChar(sb, 13)
else:
str.BufAppendChar(sb, e)
end
i = i + 2
else:
str.BufAppendChar(sb, c)
i = i + 1
end
end
out := str.BufStr(sb)
ret out
end
func _bool_or_null_token(v: str): str:
if v == "~" or v == "null" or v == "Null" or v == "NULL" or v == "": ret "null" end
if v == "true" or v == "True" or v == "TRUE": ret "true" end
if v == "false" or v == "False" or v == "FALSE": ret "false" end
ret "NOMATCH"
end
func _looks_numeric(v: str): bool:
n := v.len()
if n == 0: ret false end
bp := _bp(v)
mut i := 0
if _ub(bp, 0) == 45 or _ub(bp, 0) == 43: i = 1 end
if i >= n: ret false end
if _ub(bp, i) == 48 and i + 1 < n and _ub(bp, i + 1) >= 48 and _ub(bp, i + 1) <= 57:
ret false
end
mut has_digit := false
until i < n and _ub(bp, i) >= 48 and _ub(bp, i) <= 57:
has_digit = true
i = i + 1
end
if has_digit == false: ret false end
if i < n and _ub(bp, i) == 46:
i = i + 1
until i < n and _ub(bp, i) >= 48 and _ub(bp, i) <= 57:
i = i + 1
end
end
if i < n and (_ub(bp, i) == 101 or _ub(bp, i) == 69):
i = i + 1
if i < n and (_ub(bp, i) == 45 or _ub(bp, i) == 43): i = i + 1 end
mut edig := false
until i < n and _ub(bp, i) >= 48 and _ub(bp, i) <= 57:
edig = true
i = i + 1
end
if edig == false: ret false end
end
ret i == n
end
func _needs_quote(v: str): bool:
n := v.len()
if n == 0: ret true end
tok := _bool_or_null_token(v)
if tok != "NOMATCH": ret true end
if _looks_numeric(v): ret true end
bp := _bp(v)
c0 := _ub(bp, 0)
if c0 == 45 or c0 == 63 or c0 == 58 or c0 == 44 or c0 == 91 or c0 == 93 or c0 == 123 or c0 == 125 or c0 == 35 or c0 == 38 or c0 == 42 or c0 == 33 or c0 == 124 or c0 == 62 or c0 == 39 or c0 == 34 or c0 == 37 or c0 == 64 or c0 == 96 or c0 == 32:
ret true
end
last := _ub(bp, n - 1)
if last == 32 or last == 58: ret true end
mut i := 0
until i < n:
c := _ub(bp, i)
if c == 10 or c == 13 or c == 9: ret true end
if c == 58 and i + 1 < n and _ub(bp, i + 1) == 32: ret true end
if c == 35 and i > 0 and _ub(bp, i - 1) == 32: ret true end
i = i + 1
end
ret false
end
func _json_str_literal(raw: str): str:
ret `"`.concat(Escape(raw)).concat(`"`)
end
func _cws(s: str, i: int): int:
n := s.len()
bp := _bp(s)
mut p := i
until p < n and (_ub(bp, p) == 32 or _ub(bp, p) == 10 or _ub(bp, p) == 9 or _ub(bp, p) == 13):
p = p + 1
end
ret p
end
func _cstr_end(s: str, i: int): int:
n := s.len()
bp := _bp(s)
mut p := i + 1
until p < n:
c := _ub(bp, p)
if c == 92 and p + 1 < n:
p = p + 2
continue
end
if c == 34: ret p + 1 end
p = p + 1
end
ret p
end
func _cval_end(s: str, i0: int): int:
i := _cws(s, i0)
n := s.len()
bp := _bp(s)
if i >= n: ret i end
c := _ub(bp, i)
if c == 34: ret _cstr_end(s, i) end
if c == 123:
mut p := _cws(s, i + 1)
if p < n and _ub(bp, p) == 125: ret p + 1 end
until p < n:
p = _cws(s, p)
ke := _cstr_end(s, p)
p = _cws(s, ke)
if p < n and _ub(bp, p) == 58: p = p + 1 end
p = _cval_end(s, p)
p = _cws(s, p)
if p < n and _ub(bp, p) == 44:
p = p + 1
continue
end
if p < n and _ub(bp, p) == 125: ret p + 1 end
break
end
ret p
end
if c == 91:
mut p := _cws(s, i + 1)
if p < n and _ub(bp, p) == 93: ret p + 1 end
until p < n:
p = _cval_end(s, p)
p = _cws(s, p)
if p < n and _ub(bp, p) == 44:
p = p + 1
continue
end
if p < n and _ub(bp, p) == 93: ret p + 1 end
break
end
ret p
end
mut p := i
until p < n:
cc := _ub(bp, p)
if cc == 44 or cc == 93 or cc == 125 or cc == 32 or cc == 10 or cc == 9 or cc == 13: break end
p = p + 1
end
ret p
end
func _obj_get(s: str, key: str): _YR:
n := s.len()
bp := _bp(s)
mut p := _cws(s, 0)
if p >= n or _ub(bp, p) != 123: ret _YR { value = "", ok = false } end
p = _cws(s, p + 1)
if p < n and _ub(bp, p) == 125: ret _YR { value = "", ok = false } end
until p < n:
p = _cws(s, p)
ks := p
ke := _cstr_end(s, p)
rawkey := _json_unescape(s.substr(ks + 1, ke - ks - 2))
p = _cws(s, ke)
if p < n and _ub(bp, p) == 58: p = p + 1 end
vs := _cws(s, p)
ve := _cval_end(s, vs)
if rawkey == key: ret _YR { value = s.substr(vs, ve - vs), ok = true } end
p = _cws(s, ve)
if p < n and _ub(bp, p) == 44:
p = p + 1
continue
end
break
end
ret _YR { value = "", ok = false }
end
func _arr_get(s: str, idx: int): _YR:
if idx < 0: ret _YR { value = "", ok = false } end
n := s.len()
bp := _bp(s)
mut p := _cws(s, 0)
if p >= n or _ub(bp, p) != 91: ret _YR { value = "", ok = false } end
p = _cws(s, p + 1)
if p < n and _ub(bp, p) == 93: ret _YR { value = "", ok = false } end
mut i := 0
until p < n:
vs := _cws(s, p)
ve := _cval_end(s, vs)
if i == idx: ret _YR { value = s.substr(vs, ve - vs), ok = true } end
i = i + 1
p = _cws(s, ve)
if p < n and _ub(bp, p) == 44:
p = p + 1
continue
end
break
end
ret _YR { value = "", ok = false }
end
func _resolve_path(compact: str, path: str): _YR:
if path == "": ret _YR { value = compact, ok = true } end
mut cur := compact
n := path.len()
bp := _bp(path)
mut i := 0
mut ok := true
until i < n and ok:
mut keyend := i
until keyend < n:
c := _ub(bp, keyend)
if c == 46 or c == 91: break end
keyend = keyend + 1
end
if keyend > i:
key := path.substr(i, keyend - i)
r := _obj_get(cur, key)
if r.ok == false:
ok = false
else:
cur = r.value
end
i = keyend
end
until i < n and ok and _ub(bp, i) == 91:
mut j := i + 1
numstart := j
until j < n and _ub(bp, j) >= 48 and _ub(bp, j) <= 57:
j = j + 1
end
if j < n and _ub(bp, j) == 93 and j > numstart:
idx := conv.Atoi(path.substr(numstart, j - numstart))
r := _arr_get(cur, idx)
if r.ok == false:
ok = false
else:
cur = r.value
end
i = j + 1
else:
ok = false
end
end
if i < n and ok and _ub(bp, i) == 46: i = i + 1 end
end
if ok == false: ret _YR { value = "", ok = false } end
ret _YR { value = cur, ok = true }
end
func _count_elems(s: str, is_obj: bool): int:
n := s.len()
bp := _bp(s)
mut p := _cws(s, 1)
mut closec := 93
if is_obj: closec = 125 end
if p < n and _ub(bp, p) == closec: ret 0 end
mut count := 0
until p < n:
if is_obj:
ke := _cstr_end(s, p)
p = _cws(s, ke)
if p < n and _ub(bp, p) == 58: p = p + 1 end
end
vs := _cws(s, p)
ve := _cval_end(s, vs)
count = count + 1
p = _cws(s, ve)
if p < n and _ub(bp, p) == 44:
p = p + 1
continue
end
break
end
ret count
end
func _unescape_dq(s: str, i0: int): _YR:
n := s.len()
bp := _bp(s)
mut i := i0 + 1
mut sb := str.NewBuilder()
defer str.BufFree(sb)
mut closed := false
until i < n:
c := _ub(bp, i)
if c == 34:
i = i + 1
closed = true
break
end
if c == 92 and i + 1 < n:
e := _ub(bp, i + 1)
if e == 34: str.BufAppendChar(sb, 34)
else e == 92: str.BufAppendChar(sb, 92)
else e == 110: str.BufAppendChar(sb, 10)
else e == 116: str.BufAppendChar(sb, 9)
else e == 114: str.BufAppendChar(sb, 13)
else e == 48: str.BufAppendChar(sb, 0)
else e == 47: str.BufAppendChar(sb, 47)
else:
str.BufAppendChar(sb, e)
end
i = i + 2
else:
str.BufAppendChar(sb, c)
i = i + 1
end
end
out := str.BufStr(sb)
ret _YR { value = out, next = i, ok = closed }
end
func _unescape_sq(s: str, i0: int): _YR:
n := s.len()
bp := _bp(s)
mut i := i0 + 1
mut sb := str.NewBuilder()
defer str.BufFree(sb)
mut closed := false
until i < n:
c := _ub(bp, i)
if c == 39:
if i + 1 < n and _ub(bp, i + 1) == 39:
str.BufAppendChar(sb, 39)
i = i + 2
continue
end
i = i + 1
closed = true
break
end
str.BufAppendChar(sb, c)
i = i + 1
end
out := str.BufStr(sb)
ret _YR { value = out, next = i, ok = closed }
end
func _flow_depth_delta(s: str, i0: int): int:
n := s.len()
bp := _bp(s)
mut i := i0
mut depth := 0
mut inq := 0
until i < n:
c := _ub(bp, i)
if inq == 1:
if c == 92 and i + 1 < n:
i = i + 1
else c == 34:
inq = 0
end
else inq == 2:
if c == 39:
if i + 1 < n and _ub(bp, i + 1) == 39:
i = i + 1
else:
inq = 0
end
end
else:
if c == 34:
inq = 1
else c == 39:
inq = 2
else c == 91 or c == 123:
depth = depth + 1
else c == 93 or c == 125:
depth = depth - 1
end
end
i = i + 1
end
ret depth
end
func _gather_flow_text(lines: Vector<str>, li: int, first_text: str): _YR:
mut buf := first_text
mut depth := _flow_depth_delta(first_text, 0)
mut cur := li
n := lines.len()
until depth > 0:
cur = cur + 1
if cur >= n: break end
piece := str.TrimLeft(_content(lines.get(cur)))
buf = buf.concat(" ").concat(piece)
depth = depth + _flow_depth_delta(piece, 0)
end
ret _YR { value = buf, next = cur + 1 }
end
func _flow_ws(s: str, i: int): int:
n := s.len()
bp := _bp(s)
mut p := i
until p < n and _ub(bp, p) == 32:
p = p + 1
end
ret p
end
func _flow_bare_end(s: str, i: int): int:
n := s.len()
bp := _bp(s)
mut p := i
until p < n:
c := _ub(bp, p)
if c == 44 or c == 93 or c == 125: break end
if c == 58:
mut stop := false
if p + 1 >= n: stop = true end
if p + 1 < n and _ub(bp, p + 1) == 32: stop = true end
if p + 1 < n and _ub(bp, p + 1) == 44: stop = true end
if p + 1 < n and _ub(bp, p + 1) == 93: stop = true end
if p + 1 < n and _ub(bp, p + 1) == 125: stop = true end
if stop: break end
end
p = p + 1
end
ret p
end
func _flow_key(s: str, i: int): _YR:
n := s.len()
bp := _bp(s)
if i < n and _ub(bp, i) == 34: ret _unescape_dq(s, i) end
if i < n and _ub(bp, i) == 39: ret _unescape_sq(s, i) end
e := _flow_bare_end(s, i)
ret _YR { value = str.Trim(s.substr(i, e - i)), next = e }
end
func _flow_scalar(s: str, i: int): _YR:
n := s.len()
bp := _bp(s)
if i < n and _ub(bp, i) == 34:
r := _unescape_dq(s, i)
ret _YR { value = _json_str_literal(r.value), next = r.next, ok = r.ok }
end
if i < n and _ub(bp, i) == 39:
r := _unescape_sq(s, i)
ret _YR { value = _json_str_literal(r.value), next = r.next, ok = r.ok }
end
e := _flow_bare_end(s, i)
raw := str.Trim(s.substr(i, e - i))
tok := _bool_or_null_token(raw)
if tok != "NOMATCH": ret _YR { value = tok, next = e } end
if _looks_numeric(raw):
mut nt := raw
if nt.substr(0, 1) == "+": nt = nt.substr(1, nt.len() - 1) end
ret _YR { value = nt, next = e }
end
ret _YR { value = _json_str_literal(raw), next = e }
end
func _flow_value(s: str, i: int, depth: int): _YR:
p := _flow_ws(s, i)
n := s.len()
if depth > 512:
ret _YR { value = "null", next = n, ok = false }
end
bp := _bp(s)
if p < n and _ub(bp, p) == 123: ret _flow_object(s, p, depth) end
if p < n and _ub(bp, p) == 91: ret _flow_array(s, p, depth) end
ret _flow_scalar(s, p)
end
func _flow_object(s: str, i: int, depth: int): _YR:
n := s.len()
bp := _bp(s)
members := Vector {} as Vector<str>
defer members.free()
mut p := _flow_ws(s, i + 1)
if p < n and _ub(bp, p) == 125:
ret _YR { value = "{}", next = p + 1 }
end
mut closed := false
mut all_ok := true
until p < n:
p = _flow_ws(s, p)
k := _flow_key(s, p)
if k.ok == false: all_ok = false end
p = _flow_ws(s, k.next)
if p < n and _ub(bp, p) == 58: p = p + 1 end
p = _flow_ws(s, p)
v := _flow_value(s, p, depth + 1)
if v.ok == false: all_ok = false end
members.push(_json_str_literal(k.value).concat(": ").concat(v.value))
p = _flow_ws(s, v.next)
if p < n and _ub(bp, p) == 44:
p = p + 1
continue
end
if p < n and _ub(bp, p) == 125:
p = p + 1
closed = true
end
break
end
out := Object(members)
ret _YR { value = out, next = p, ok = closed and all_ok }
end
func _flow_array(s: str, i: int, depth: int): _YR:
n := s.len()
bp := _bp(s)
items := Vector {} as Vector<str>
defer items.free()
mut p := _flow_ws(s, i + 1)
if p < n and _ub(bp, p) == 93:
ret _YR { value = "[]", next = p + 1 }
end
mut closed := false
mut all_ok := true
until p < n:
v := _flow_value(s, p, depth + 1)
if v.ok == false: all_ok = false end
items.push(v.value)
p = _flow_ws(s, v.next)
if p < n and _ub(bp, p) == 44:
p = p + 1
continue
end
if p < n and _ub(bp, p) == 93:
p = p + 1
closed = true
end
break
end
out := Array(items)
ret _YR { value = out, next = p, ok = closed and all_ok }
end
func _parse_block_scalar(lines: Vector<str>, li: int, indicator: str): _YR:
mut folded := false
if indicator.substr(0, 1) == ">": folded = true end
mut chomp := 0
k := 1
ilen := indicator.len()
if k < ilen:
ch := indicator.substr(k, 1)
if ch == "-":
chomp = 1
else ch == "+":
chomp = 2
end
end
n := lines.len()
mut bi := li + 1
mut base := 0 - 1
until bi < n and base < 0:
raw := lines.get(bi)
if str.Trim(raw) != "":
base = _raw_indent(raw)
else:
bi = bi + 1
end
end
if base < 0:
ret _YR { value = _json_str_literal(""), next = li + 1 }
end
body_lines := Vector {} as Vector<str>
defer body_lines.free()
mut cur := li + 1
until cur < n:
raw := lines.get(cur)
if str.Trim(raw) == "":
body_lines.push("")
cur = cur + 1
else:
ind := _raw_indent(raw)
if ind < base: break end
mut piece := ""
if raw.len() >= base: piece = raw.substr(base, raw.len() - base) end
body_lines.push(str.TrimRight(piece))
cur = cur + 1
end
end
mut endi := body_lines.len()
until endi > 0 and body_lines.get(endi - 1) == "":
endi = endi - 1
end
mut sb := str.NewBuilder()
defer str.BufFree(sb)
mut prev_blank := false
repeat endi in idx:
line := body_lines.get(idx)
if idx > 0:
if folded:
if line == "" or prev_blank:
str.BufAppendChar(sb, 10)
else:
str.BufAppendChar(sb, 32)
end
else:
str.BufAppendChar(sb, 10)
end
end
str.BufAppend(sb, line)
prev_blank = line == ""
end
mut result := str.BufStr(sb)
if chomp == 2:
trailing := body_lines.len() - endi
mut t := 0
until t < trailing + 1:
result = result.concat("\n")
t = t + 1
end
else chomp == 0:
if endi > 0: result = result.concat("\n") end
end
ret _YR { value = _json_str_literal(result), next = cur }
end
func _dump_indent(sb &: str.StringBuilder, unit: str, depth: int):
repeat depth:
str.BufAppend(sb, unit)
end
end
func _dump_scalar(s: str, i: int, sb &: str.StringBuilder): int:
n := s.len()
bp := _bp(s)
if i < n and _ub(bp, i) == 34:
e := _cstr_end(s, i)
raw := _json_unescape(s.substr(i + 1, e - i - 2))
if _needs_quote(raw):
str.BufAppend(sb, _json_str_literal(raw))
else:
str.BufAppend(sb, raw)
end
ret e
end
e := _cval_end(s, i)
str.BufAppend(sb, s.substr(i, e - i))
ret e
end
func _dump_collection_or_scalar(s: str, vs: int, sb &: str.StringBuilder, unit: str, depth: int): int:
n := s.len()
bp := _bp(s)
vc := _ub(bp, vs)
if vc == 123 or vc == 91:
mut closec := 125
if vc == 91: closec = 93 end
inner := _cws(s, vs + 1)
if inner < n and _ub(bp, inner) == closec:
str.BufAppendChar(sb, 32)
if vc == 123: str.BufAppend(sb, "{}") else:
str.BufAppend(sb, "[]")
end
ret inner + 1
end
str.BufAppendChar(sb, 10)
ret _dump_block(s, vs, sb, unit, depth + 1)
end
str.BufAppendChar(sb, 32)
ret _dump_scalar(s, vs, sb)
end
func _dump_block(s: str, i0: int, sb &: str.StringBuilder, unit: str, depth: int): int:
i := _cws(s, i0)
n := s.len()
bp := _bp(s)
if i >= n:
str.BufAppend(sb, "null")
ret i
end
c := _ub(bp, i)
if c == 123:
mut p := _cws(s, i + 1)
if p < n and _ub(bp, p) == 125:
str.BufAppend(sb, "{}")
ret p + 1
end
mut first := true
until p < n:
p = _cws(s, p)
ke := _cstr_end(s, p)
keyraw := _json_unescape(s.substr(p + 1, ke - p - 2))
if first == false: str.BufAppendChar(sb, 10) end
first = false
_dump_indent(sb, unit, depth)
if _needs_quote(keyraw):
str.BufAppend(sb, _json_str_literal(keyraw))
else:
str.BufAppend(sb, keyraw)
end
str.BufAppendChar(sb, 58)
p = _cws(s, ke)
if p < n and _ub(bp, p) == 58: p = p + 1 end
vs := _cws(s, p)
p = _dump_collection_or_scalar(s, vs, sb, unit, depth)
p = _cws(s, p)
if p < n and _ub(bp, p) == 44:
p = p + 1
continue
end
if p < n and _ub(bp, p) == 125: p = p + 1 end
break
end
ret p
end
if c == 91:
mut p := _cws(s, i + 1)
if p < n and _ub(bp, p) == 93:
str.BufAppend(sb, "[]")
ret p + 1
end
mut first := true
until p < n:
if first == false: str.BufAppendChar(sb, 10) end
first = false
_dump_indent(sb, unit, depth)
str.BufAppendChar(sb, 45)
vs := _cws(s, p)
p = _dump_collection_or_scalar(s, vs, sb, unit, depth)
p = _cws(s, p)
if p < n and _ub(bp, p) == 44:
p = p + 1
continue
end
if p < n and _ub(bp, p) == 93: p = p + 1 end
break
end
ret p
end
ret _dump_scalar(s, i, sb)
end
@en "Parse"
@fa "تجزیه"
pub func Parse(text: str): str:
r := _parse_document(text)
ret r.value
end
@en "ToJSON"
@fa "به جیسون"
pub func ToJSON(text: str): str:
ret Parse(text)
end
@en "Valid"
@fa "معتبر"
pub func Valid(text: str): bool:
r := _parse_document(text)
if r.ok == false: ret false end
t := _truncate_to_first_doc(text)
lines := t.split("\n")
defer lines.free()
tail := _skip_noise(lines, r.next)
total := lines.len()
ret tail >= total
end
@en "SplitDocuments"
@fa "تفکیک کردن اسناد"
pub func SplitDocuments(text: str): Vector<str>:
lines := text.split("\n")
defer lines.free()
out := Vector {} as Vector<str>
mut cur := str.NewBuilder()
mut any := false
n := lines.len()
mut i := 0
until i < n:
raw := lines.get(i)
t := str.Trim(raw)
if t == "---":
if any: out.push(str.BufStr(cur)) end
str.BufReset(cur)
any = true
else t == "...":
if any: out.push(str.BufStr(cur)) end
str.BufReset(cur)
any = false
else:
if str.BufIsEmpty(cur) == false: str.BufAppendChar(cur, 10) end
str.BufAppend(cur, raw)
any = true
end
i = i + 1
end
if any: out.push(str.BufStr(cur)) end
str.BufFree(cur)
ret out
end
@en "env"
@fa "محیط"
package env
import str
import conv
import io
import fs.path
import encoding.envfile
if SALAM_OS_WINDOWS:
extern:
func getenv(name: str): void*
func _putenv_s(name: str, value: str): int
end
else:
extern:
func getenv(name: str): void*
func setenv(name: str, value: str, overwrite: int): int
func unsetenv(name: str): int
end
end
func _base_from_names(names: Vector<str>): envfile.Doc:
mut base := envfile.New()
repeat names.len() in i:
n := names.get(i)
if Has(n): envfile.Set(base, n, Get(n)) end
end
ret base
end
func _env_base(raw &: envfile.Doc): envfile.Doc:
names := envfile.RefNames(raw)
defer names.free()
ret _base_from_names(names)
end
func _apply_doc(d &: envfile.Doc, override: bool): int:
mut count := 0
repeat envfile.Len(d) in i:
k := envfile.KeyAt(d, i)
if override or Has(k) == false:
Set(k, envfile.ValueAt(d, i))
count += 1
end
end
ret count
end
func _apply_raw(raw &: envfile.Doc, override: bool): int:
mut base := _env_base(raw)
defer envfile.Free(base)
mut d := envfile.ExpandDoc(raw, base)
defer envfile.Free(d)
ret _apply_doc(d, override)
end
func _apply_text(text: str, override: bool): int:
mut raw := envfile.ParseRaw(text)
defer envfile.Free(raw)
ret _apply_raw(raw, override)
end
func _merge_file(dst &: envfile.Doc, p: str):
mut raw := envfile.ParseRaw(io.ReadFile(p))
defer envfile.Free(raw)
envfile.MergeInto(dst, raw)
end
@en "Get"
@fa "دریافت"
pub func Get(name: str): str:
v := getenv(name)
if v == null: ret "" end
ret str.Clone(v as str)
end
@en "GetOr"
@fa "دریافت با پیش فرض"
pub func GetOr(name: str, def: str): str:
v := Get(name)
if v.len() == 0: ret def end
ret v
end
@en "Has"
@fa "دارد"
pub func Has(name: str): bool: ret getenv(name) != null end
@en "GetInt"
@fa "دریافت صحیح"
pub func GetInt(name: str, def: i64): i64:
v := Get(name)
if v.len() == 0: ret def end
ret conv.ParseInt(v)
end
@en "GetFloat"
@fa "دریافت اعشاری"
pub func GetFloat(name: str, def: f64): f64:
v := Get(name)
if v.len() == 0: ret def end
ret conv.ParseFloat(v)
end
@en "GetBool"
@fa "دریافت منطقی"
pub func GetBool(name: str, def: bool): bool:
v := Get(name)
if v.len() == 0: ret def end
ret conv.ParseBool(v)
end
if SALAM_OS_WINDOWS:
@en "Set"
@fa "تنظیم"
pub func Set(name: str, value: str): bool: ret _putenv_s(name, value) == 0 end
@en "Unset"
@fa "حذف"
pub func Unset(name: str): bool: ret _putenv_s(name, "") == 0 end
else:
@en "Set"
@fa "تنظیم"
pub func Set(name: str, value: str): bool: ret setenv(name, value, 1) == 0 end
@en "Unset"
@fa "حذف"
pub func Unset(name: str): bool: ret unsetenv(name) == 0 end
end
@en "Mask"
@fa "پوشاندن"
pub func Mask(value: str): str:
n := value.len()
if n == 0: ret "" end
if n <= 8:
mut out := ""
repeat n: out = out.concat("*") end
ret out
end
ret value.substr(0, 2).concat("****").concat(value.substr(n - 2, 2))
end
@en "GetMasked"
@fa "دریافت پوشیده"
pub func GetMasked(name: str): str: ret Mask(Get(name)) end
@en "Profile"
@fa "نمایه"
pub func Profile(): str:
v := GetOr("SALAM_ENV", GetOr("APP_ENV", GetOr("ENV", "development")))
ret str.Lower(v)
end
@en "IsProduction"
@fa "تولید است"
pub func IsProduction(): bool: ret Profile() == "production" or Profile() == "prod" end
@en "IsDevelopment"
@fa "توسعه است"
pub func IsDevelopment(): bool: ret Profile() == "development" or Profile() == "dev" end
@en "IsTest"
@fa "آزمایش است"
pub func IsTest(): bool: ret Profile() == "test" or Profile() == "testing" end
@en "IsStaging"
@fa "آزمایشی است"
pub func IsStaging(): bool: ret Profile() == "staging" end
@en "Load"
@fa "بارگذاری"
pub func Load(path: str): int:
ret _apply_text(io.ReadFile(path), false)
end
@en "Overload"
@fa "بارگذاری اجباری"
pub func Overload(path: str): int:
ret _apply_text(io.ReadFile(path), true)
end
@en "LoadText"
@fa "بارگذاری متن"
pub func LoadText(text: str): int:
ret _apply_text(text, false)
end
@en "LoadDotEnv"
@fa "بارگذاری نقطه‌محیط"
pub func LoadDotEnv(path: str): int:
ret _apply_text(io.ReadFile(path), true)
end
@en "LoadProfile"
@fa "بارگذاری نمایه"
pub func LoadProfile(dir: str): int:
p := Profile()
mut d := envfile.New()
defer envfile.Free(d)
_merge_file(d, path.Join(dir, ".env"))
_merge_file(d, path.Join(dir, ".env.local"))
_merge_file(d, path.Join(dir, ".env.".concat(p)))
_merge_file(d, path.Join(dir, ".env.".concat(p).concat(".local")))
ret _apply_raw(d, false)
end
@en "Expand"
@fa "گسترش"
pub func Expand(text: str): str:
names := envfile.RefNamesIn(text)
defer names.free()
mut base := _base_from_names(names)
defer envfile.Free(base)
mut none := envfile.New()
defer envfile.Free(none)
ret envfile.Expand(text, none, base)
end
@en "error"
@fa "خطا"
package error
import str
import fmt
import collections
@en "KindUnknown"
@fa "نوع نامشخص"
pub const KindUnknown := "unknown"
@en "KindNotFound"
@fa "یافت نشد"
pub const KindNotFound := "not_found"
@en "KindInvalidArgument"
@fa "آرگومان نامعتبر"
pub const KindInvalidArgument := "invalid_argument"
@en "KindPermissionDenied"
@fa "دسترسی رد شد"
pub const KindPermissionDenied := "permission_denied"
@en "KindAlreadyExists"
@fa "نوع از قبل موجود"
pub const KindAlreadyExists := "already_exists"
@en "KindUnavailable"
@fa "در دسترس نیست"
pub const KindUnavailable := "unavailable"
@en "KindTimeout"
@fa "پایان زمان"
pub const KindTimeout := "timeout"
@en "KindCanceled"
@fa "لغو شد"
pub const KindCanceled := "canceled"
@en "KindInternal"
@fa "داخلی"
pub const KindInternal := "internal"
@en "KindIO"
@fa "ورودی خروجی"
pub const KindIO := "io"
@en "KindUnimplemented"
@fa "پیاده سازی نشده"
pub const KindUnimplemented := "unimplemented"
@en "Error"
@fa "خطا"
pub struct Error:
pub kind: str = ""
pub messages: Vector<str> = Vector {}
pub kinds: Vector<str> = Vector {}
pub trace: Vector<str> = Vector {}
pub meta_keys: Vector<str> = Vector {}
pub meta_vals: Vector<str> = Vector {}
end
@en "RetryPolicy"
@fa "سیاست تکرار"
pub struct RetryPolicy:
pub max_attempts: int = 3
pub base_delay_ms: int = 100
pub max_delay_ms: int = 5000
end
func _new(kind: str, message: str, at: str): Error:
mut k := kind
if k == "": k = KindUnknown end
mut e := Error { kind = k }
e.messages.push(message)
e.kinds.push(k)
if at != "": e.trace.push(at) end
ret e
end
@en "Nil"
@fa "خالی"
pub func Nil(): Error: ret Error {} end
@en "IsNil"
@fa "خالی است"
pub func IsNil(e: Error): bool: ret e.kind == "" end
@en "Ok"
@fa "بدون خطا"
pub func Ok(e: Error): bool: ret e.kind == "" end
@en "New"
@fa "جدید"
pub func New(kind: str, message: str): Error: ret _new(kind, message, "") end
@en "NewAt"
@fa "جدید در"
pub func NewAt(kind: str, message: str, at: str): Error: ret _new(kind, message, at) end
@en "Newf"
@fa "جدید قالبی"
pub func Newf(kind: str, tmpl: str, args: Vector<str>): Error: ret _new(kind, fmt.Sprintf(tmpl, args), "") end
@en "Wrap"
@fa "پیچیدن"
pub func Wrap(e: Error, message: str): Error:
if IsNil(e): ret New(KindUnknown, message) end
mut out := Error { kind = e.kind }
out.messages = collections.clone(e.messages)
out.messages.push(message)
out.kinds = collections.clone(e.kinds)
out.trace = collections.clone(e.trace)
out.meta_keys = collections.clone(e.meta_keys)
out.meta_vals = collections.clone(e.meta_vals)
ret out
end
@en "WrapAt"
@fa "پیچیدن در"
pub func WrapAt(e: Error, message: str, at: str): Error:
mut out := Wrap(e, message)
if at != "": out.trace.push(at) end
ret out
end
@en "WrapKind"
@fa "پیچیدن با نوع"
pub func WrapKind(e: Error, kind: str, message: str): Error:
mut out := Wrap(e, message)
out.kind = kind
out.kinds.push(kind)
ret out
end
@en "WithMeta"
@fa "با فراداده"
pub func WithMeta(e: Error, key: str, val: str): Error:
mut src := e
if IsNil(src): src = New(KindUnknown, "") end
mut out := Error { kind = src.kind }
out.messages = collections.clone(src.messages)
out.kinds = collections.clone(src.kinds)
out.trace = collections.clone(src.trace)
out.meta_keys = collections.clone(src.meta_keys)
out.meta_vals = collections.clone(src.meta_vals)
out.meta_keys.push(key)
out.meta_vals.push(val)
ret out
end
@en "Meta"
@fa "فراداده"
pub func Meta(e: Error, key: str): str:
repeat e.meta_keys.len() in i:
if e.meta_keys.get(i) == key: ret e.meta_vals.get(i) end
end
ret ""
end
@en "Kind"
@fa "نوع"
pub func Kind(e: Error): str: ret e.kind end
@en "Is"
@fa "است"
pub func Is(e: Error, kind: str): bool:
repeat e.kinds.len() in i:
if e.kinds.get(i) == kind: ret true end
end
ret false
end
@en "Message"
@fa "پیام"
pub func Message(e: Error): str:
n := e.messages.len()
if n == 0: ret "" end
mut out := e.messages.get(n - 1)
mut i := n - 2
until i >= 0:
out = out.concat(": ").concat(e.messages.get(i))
i -= 1
end
ret out
end
@en "RootMessage"
@fa "پیام ریشه"
pub func RootMessage(e: Error): str:
if e.messages.len() == 0: ret "" end
ret e.messages.get(0)
end
@en "Trace"
@fa "ردیابی"
pub func Trace(e: Error): str:
mut out := str.NewBuilder()
defer str.BufFree(out)
repeat e.trace.len() in i:
if i > 0: str.BufAppend(out, " -> ") end
str.BufAppend(out, e.trace.get(i))
end
ret str.BufStr(out)
end
@en "Format"
@fa "قالب"
pub func Format(e: Error): str:
if IsNil(e): ret "<nil>" end
mut b := str.NewBuilder()
defer str.BufFree(b)
str.BufAppend(b, "[")
str.BufAppend(b, e.kind)
str.BufAppend(b, "] ")
str.BufAppend(b, Message(e))
if e.trace.len() > 0:
str.BufAppend(b, "\n  trace: ")
str.BufAppend(b, Trace(e))
end
repeat e.meta_keys.len() in i:
str.BufAppend(b, "\n  ")
str.BufAppend(b, e.meta_keys.get(i))
str.BufAppend(b, "=")
str.BufAppend(b, e.meta_vals.get(i))
end
ret str.BufStr(b)
end
@en "IsNotFound"
@fa "یافت نشد است"
pub func IsNotFound(e: Error): bool: ret Is(e, KindNotFound) end
@en "IsInvalidArgument"
@fa "آرگومان نامعتبر است"
pub func IsInvalidArgument(e: Error): bool: ret Is(e, KindInvalidArgument) end
@en "IsPermissionDenied"
@fa "دسترسی رد شد است"
pub func IsPermissionDenied(e: Error): bool: ret Is(e, KindPermissionDenied) end
@en "IsAlreadyExists"
@fa "از قبل موجود است"
pub func IsAlreadyExists(e: Error): bool: ret Is(e, KindAlreadyExists) end
@en "IsTimeout"
@fa "پایان زمان است"
pub func IsTimeout(e: Error): bool: ret Is(e, KindTimeout) end
@en "IsCanceled"
@fa "لغو شد است"
pub func IsCanceled(e: Error): bool: ret Is(e, KindCanceled) end
@en "IsUnavailable"
@fa "در دسترس نیست است"
pub func IsUnavailable(e: Error): bool: ret Is(e, KindUnavailable) end
@en "IsInternal"
@fa "داخلی است"
pub func IsInternal(e: Error): bool: ret Is(e, KindInternal) end
@en "IsRetryable"
@fa "قابل تکرار است"
pub func IsRetryable(e: Error): bool:
ret Is(e, KindTimeout) or Is(e, KindUnavailable) or Is(e, KindIO)
end
@en "NewRetryPolicy"
@fa "سیاست تکرار جدید"
pub func NewRetryPolicy(max_attempts: int, base_delay_ms: int, max_delay_ms: int): RetryPolicy:
ret RetryPolicy { max_attempts = max_attempts, base_delay_ms = base_delay_ms, max_delay_ms = max_delay_ms }
end
@en "DelayForAttempt"
@fa "تاخیر برای تلاش"
pub func DelayForAttempt(p &: RetryPolicy, attempt: int): int:
if attempt <= 1: ret p.base_delay_ms end
mut delay := p.base_delay_ms
mut i := 1
until i < attempt:
delay *= 2
if delay >= p.max_delay_ms: ret p.max_delay_ms end
i += 1
end
ret delay
end
@en "ShouldRetry"
@fa "باید تکرار شود"
pub func ShouldRetry(p &: RetryPolicy, e: Error, attempt: int): bool:
if IsNil(e): ret false end
if attempt >= p.max_attempts: ret false end
ret IsRetryable(e)
end
@en "Free"
@fa "آزادسازی"
pub func Free(e &: Error):
e.messages.free()
e.kinds.free()
e.trace.free()
e.meta_keys.free()
e.meta_vals.free()
end
@en "filepath"
@fa "مسیر پرونده"
package filepath
import mem
import str
if SALAM_OS_WINDOWS:
extern:
func GetCurrentDirectoryA(sz: int, buf: void*): int
end
else:
extern:
func getcwd(buf: void*, sz: int): void*
end
end
@en "Separator"
@fa "جداکننده"
pub const Separator := "/"
func _fp_cwd(): str:
buf := mem.Allocate(2048 as u64)
mut s := ""
if SALAM_OS_WINDOWS:
n := GetCurrentDirectoryA(2048, buf)
if n > 0 and n < 2048: s = str.Clone(buf as str) end
else:
r := getcwd(buf, 2048)
if r != null: s = str.Clone(r as str) end
end
mem.Free(buf)
ret s
end
func _fp_segments(p: str): Vector<str>:
parts := p.split("/")
defer parts.free()
out := Vector {} as Vector<str>
repeat parts.len() in i:
seg := parts.get(i)
if seg.len() > 0:
out.push(seg)
end
end
ret out
end
@en "Normalize"
@fa "نرمال سازی"
pub func Normalize(p: str): str:
ret str.Replace(p, "\\", "/")
end
@en "IsAbs"
@fa "مطلق است"
pub func IsAbs(p: str): bool:
q := Normalize(p)
if str.StartsWith(q, "/"): ret true
else q.len() >= 2 and q.substr(1, 1) == ":":
c := char_code(q.substr(0, 1))
ret str.IsAsciiAlpha(c)
end
ret false
end
@en "Join"
@fa "پیوند"
pub func Join(a: str, b: str): str:
if a.len() == 0: ret Normalize(b) end
if b.len() == 0: ret Normalize(a) end
x := Normalize(a)
y := Normalize(b)
mut out := ""
if str.EndsWith(x, "/") and str.StartsWith(y, "/"):
tail := y.substr(1, y.len() - 1)
out = x.concat(tail)
mem.Free(tail as void*)
else str.EndsWith(x, "/") or str.StartsWith(y, "/"):
out = x.concat(y)
else:
mut sb := str.NewBuilder()
str.BufAppend(sb, x)
str.BufAppend(sb, "/")
str.BufAppend(sb, y)
out = str.BufStr(sb)
str.BufFree(sb)
end
mem.Free(x as void*)
mem.Free(y as void*)
ret out
end
@en "Base"
@fa "نام پایه"
pub func Base(p: str): str:
mut q := Normalize(p)
until q.len() > 1 and str.EndsWith(q, "/"):
shorter := q.substr(0, q.len() - 1)
mem.Free(q as void*)
q = shorter
end
if q == "/":
mem.Free(q as void*)
ret str.Clone("/")
else q.len() == 0:
mem.Free(q as void*)
ret str.Clone(".")
end
idx := str.LastIndex(q, "/")
if idx < 0: ret q end
out := q.substr(idx + 1, q.len() - idx - 1)
mem.Free(q as void*)
ret out
end
@en "Dir"
@fa "پوشه"
pub func Dir(p: str): str:
mut q := Normalize(p)
until q.len() > 1 and str.EndsWith(q, "/"):
t := q.substr(0, q.len() - 1)
mem.Free(q as void*)
q = t
end
idx := str.LastIndex(q, "/")
mut out := ""
if idx < 0:
out = str.Clone(".")
else idx == 0:
out = str.Clone("/")
else:
out = q.substr(0, idx)
end
mem.Free(q as void*)
ret out
end
@en "Ext"
@fa "پسوند"
pub func Ext(p: str): str:
b := Base(p)
idx := str.LastIndex(b, ".")
if idx <= 0:
mem.Free(b as void*)
ret str.Clone("")
end
out := b.substr(idx, b.len() - idx)
mem.Free(b as void*)
ret out
end
@en "Stem"
@fa "نام بدون پسوند"
pub func Stem(p: str): str:
b := Base(p)
idx := str.LastIndex(b, ".")
if idx <= 0: ret b end
ret b.substr(0, idx)
end
@en "Clean"
@fa "پاک سازی"
pub func Clean(p: str): str:
q := Normalize(p)
if q.len() == 0:
mem.Free(q as void*)
ret str.Clone(".")
end
abs := str.StartsWith(q, "/")
parts := q.split("/")
kept := Vector {} as Vector<str> defer kept.free()
repeat parts.len() in i:
seg := parts.get(i)
if seg.len() > 0 and seg != ".":
if seg == "..":
if kept.len() > 0 and kept.last() != "..":
kept.pop()
else:
if abs == false:
kept.push(seg)
end
end
else:
kept.push(seg)
end
end
end
out := str.Join(kept, "/")
repeat parts.len() in i:
mem.Free(parts.get(i) as void*)
end
parts.free()
mem.Free(q as void*)
if abs:
rooted := "/".concat(out)
mem.Free(out as void*)
ret rooted
end
if out.len() == 0:
mem.Free(out as void*)
ret str.Clone(".")
end
ret out
end
@en "Abs"
@fa "مسیر مطلق"
pub func Abs(p: str): str:
if IsAbs(p): ret Clean(p) end
cwd := _fp_cwd()
ret Clean(Join(cwd, p))
end
@en "Rel"
@fa "مسیر نسبی"
pub func Rel(base: str, target: str): str:
ab := Abs(base)
at := Abs(target)
bs := _fp_segments(ab)
defer bs.free()
ts := _fp_segments(at)
defer ts.free()
mut common := 0
until common < bs.len() and common < ts.len() and bs.get(common) == ts.get(common):
common += 1
end
out := Vector {} as Vector<str>
defer out.free()
mut up := common
until up < bs.len():
out.push("..")
up += 1
end
mut i := common
until i < ts.len():
out.push(ts.get(i))
i += 1
end
if out.len() == 0: ret "." end
ret str.Join(out, "/")
end
@en "Validate"
@fa "اعتبارسنجی مسیر"
pub func Validate(p: str): bool:
ret p.len() > 0
end
@en "IsSafe"
@fa "مسیر امن است"
pub func IsSafe(base: str, p: str): bool:
if Validate(p) == false: ret false end
b := Clean(Abs(base))
full := Clean(Join(b, p))
if full == b: ret true end
prefix := b.concat("/")
ret str.StartsWith(full, prefix)
end
@en "flag"
@fa "پرچم"
package flag
import str
import conv
import collections
@en "FlagKindBool"
@fa "نوع منطقی"
pub const FlagKindBool := 0
@en "FlagKindStr"
@fa "نوع رشته"
pub const FlagKindStr := 1
@en "FlagKindInt"
@fa "نوع صحیح"
pub const FlagKindInt := 2
@en "FlagKindFloat"
@fa "نوع اعشاری"
pub const FlagKindFloat := 3
@en "FlagSet"
@fa "مجموعه پرچم"
pub struct FlagSet:
pub prog: str = ""
pub desc: str = ""
pub names: Vector<str> = Vector {}
pub shorts: Vector<str> = Vector {}
pub kinds: Vector<int> = Vector {}
pub vals: Vector<str> = Vector {}
pub defs: Vector<str> = Vector {}
pub helps: Vector<str> = Vector {}
pub was_set: Vector<bool> = Vector {}
pub pos: Vector<str> = Vector {}
pub err: str = ""
pub help_wanted: bool = false
end
func _register(fs &: FlagSet, name: str, short: str, kind: int, def: str, help: str):
fs.names.push(name)
fs.shorts.push(short)
fs.kinds.push(kind)
fs.defs.push(def)
fs.vals.push(def)
fs.helps.push(help)
fs.was_set.push(false)
end
func _find(fs &: FlagSet, name: str): int:
repeat fs.names.len() in i:
if fs.names.get(i) == name: ret i end
end
ret 0 - 1
end
func _find_short(fs &: FlagSet, short: str): int:
repeat fs.shorts.len() in i:
s := fs.shorts.get(i)
if s.len() > 0 and s == short: ret i end
end
ret 0 - 1
end
func _assign(fs &: FlagSet, idx: int, val: str):
fs.vals.set(idx, val)
fs.was_set.set(idx, true)
end
func _valid_number(raw: str, kind: int): bool:
t := str.Replace(str.ToEnglishDigits(str.Trim(raw)), "٫", ".")
n := t.len()
mut i := 0
if n > 0 and (t.substr(0, 1) == "-" or t.substr(0, 1) == "+"):
i = 1
end
mut digits := 0
mut dots := 0
mut exp := false
until i < n:
c := t.substr(i, 1)
if str.IsAsciiDigit(char_code(c)):
digits += 1
else kind == 3 and c == "." and dots == 0 and not exp:
dots += 1
else kind == 3 and (c == "e" or c == "E") and digits > 0 and not exp:
exp = true
if i + 1 < n and (t.substr(i + 1, 1) == "-" or t.substr(i + 1, 1) == "+"):
i += 1
end
else:
ret false
end
i += 1
end
ret digits > 0
end
func _kind_hint(kind: int): str:
if kind == 1: ret " <string>"
else kind == 2: ret " <int>"
else kind == 3: ret " <float>"
else:
ret ""
end
end
@en "New"
@fa "جدید"
pub func New(prog_name: str, description: str): FlagSet:
fs := FlagSet {}
fs.prog = prog_name
fs.desc = description
ret fs
end
@en "AddBool"
@fa "افزودن منطقی"
pub func AddBool(fs &: FlagSet, name: str, short: str, def: bool, help: str):
_register(fs, name, short, 0, conv.FormatBool(def), help)
end
@en "AddStr"
@fa "افزودن رشته"
pub func AddStr(fs &: FlagSet, name: str, short: str, def: str, help: str):
_register(fs, name, short, 1, def, help)
end
@en "AddInt"
@fa "افزودن صحیح"
pub func AddInt(fs &: FlagSet, name: str, short: str, def: i64, help: str):
_register(fs, name, short, 2, conv.FormatInt(def), help)
end
@en "AddFloat"
@fa "افزودن اعشاری"
pub func AddFloat(fs &: FlagSet, name: str, short: str, def: f64, help: str):
_register(fs, name, short, 3, conv.FormatFloat(def), help)
end
@en "Parse"
@fa "تجزیه"
pub func Parse(fs &: FlagSet, arglist: Vector<str>): bool:
fs.err = ""
mut i := 0
mut only_pos := false
until i < arglist.len():
arg := arglist.get(i)
if only_pos:
fs.pos.push(arg)
i += 1
else:
if arg == "--":
only_pos = true
i += 1
else:
if str.StartsWith(arg, "--") or (str.StartsWith(arg, "-") and arg.len() > 1):
mut body := arg.substr(1, arg.len() - 1)
mut long := false
if str.StartsWith(arg, "--"):
body = arg.substr(2, arg.len() - 2)
long = true
end
mut name := body
mut inline_val := ""
mut has_inline := false
eq_at := body.find("=")
if eq_at >= 0:
name = body.substr(0, eq_at)
inline_val = body.substr(eq_at + 1, body.len() - eq_at - 1)
has_inline = true
end
if name == "help" or name == "h":
fs.help_wanted = true
i += 1
else:
mut idx := 0 - 1
if long:
idx = _find(fs, name)
else:
idx = _find_short(fs, name)
if idx < 0: idx = _find(fs, name) end
end
if idx < 0:
fs.err = "unknown flag: ".concat(arg)
ret false
end
if fs.kinds.get(idx) == 0:
if has_inline:
_assign(fs, idx, inline_val)
else:
_assign(fs, idx, "true")
end
i += 1
else:
if has_inline:
_assign(fs, idx, inline_val)
i += 1
else:
if i + 1 >= arglist.len():
fs.err = "missing value for flag: ".concat(arg)
ret false
end
_assign(fs, idx, arglist.get(i + 1))
i += 2
end
end
end
else:
fs.pos.push(arg)
i += 1
end
end
end
end
repeat fs.names.len() in k:
kind := fs.kinds.get(k)
if (kind == 2 or kind == 3) and fs.was_set.get(k) and not _valid_number(fs.vals.get(k), kind):
fs.err = "invalid " + (kind == 2 ? "int" : "float") + " value for --" + fs.names.get(k) + ": " + fs.vals.get(k)
ret false
end
end
ret true
end
@en "GetStr"
@fa "دریافت رشته"
pub func GetStr(fs &: FlagSet, name: str): str:
idx := _find(fs, name)
if idx < 0: ret "" end
ret fs.vals.get(idx)
end
@en "GetInt"
@fa "دریافت صحیح"
pub func GetInt(fs &: FlagSet, name: str): i64:
idx := _find(fs, name)
if idx < 0: ret 0 end
ret conv.ParseInt(fs.vals.get(idx))
end
@en "GetFloat"
@fa "دریافت اعشاری"
pub func GetFloat(fs &: FlagSet, name: str): f64:
idx := _find(fs, name)
if idx < 0: ret 0.0 end
ret conv.ParseFloat(fs.vals.get(idx))
end
@en "GetBool"
@fa "دریافت منطقی"
pub func GetBool(fs &: FlagSet, name: str): bool:
idx := _find(fs, name)
if idx < 0: ret false end
ret conv.ParseBool(fs.vals.get(idx))
end
@en "WasSet"
@fa "تنظیم شده"
pub func WasSet(fs &: FlagSet, name: str): bool:
idx := _find(fs, name)
if idx < 0: ret false end
ret fs.was_set.get(idx)
end
@en "Positional"
@fa "موقعیتی"
pub func Positional(fs &: FlagSet): Vector<str>:
ret collections.clone(fs.pos)
end
@en "HelpWanted"
@fa "راهنما خواسته"
pub func HelpWanted(fs &: FlagSet): bool: ret fs.help_wanted end
@en "Error"
@fa "خطا"
pub func Error(fs &: FlagSet): str: ret fs.err end
@en "Usage"
@fa "راهنما"
pub func Usage(fs &: FlagSet): str:
mut b := str.NewBuilder()
defer str.BufFree(b)
str.BufAppend(b, "Usage: ")
str.BufAppend(b, fs.prog)
str.BufAppend(b, " [options] [args]\n")
if fs.desc.len() > 0:
str.BufAppend(b, "  ")
str.BufAppend(b, fs.desc)
str.BufAppend(b, "\n")
end
str.BufAppend(b, "Options:\n")
repeat fs.names.len() in i:
str.BufAppend(b, "  ")
short := fs.shorts.get(i)
if short.len() > 0:
str.BufAppend(b, "-")
str.BufAppend(b, short)
str.BufAppend(b, ", ")
end
str.BufAppend(b, "--")
str.BufAppend(b, fs.names.get(i))
str.BufAppend(b, _kind_hint(fs.kinds.get(i)))
help := fs.helps.get(i)
if help.len() > 0:
str.BufAppend(b, "  ")
str.BufAppend(b, help)
end
def := fs.defs.get(i)
if fs.kinds.get(i) != 0 and def.len() > 0:
str.BufAppend(b, " (default: ")
str.BufAppend(b, def)
str.BufAppend(b, ")")
end
str.BufAppend(b, "\n")
end
str.BufAppend(b, "  -h, --help  show this help\n")
out := str.BufStr(b)
ret out
end
@en "Free"
@fa "آزادسازی"
pub func Free(fs &: FlagSet):
fs.names.free()
fs.shorts.free()
fs.kinds.free()
fs.vals.free()
fs.defs.free()
fs.helps.free()
fs.was_set.free()
fs.pos.free()
end
@en "fmt"
@fa "قالب بندی"
package fmt
import str
import conv
@en "Int"
@fa "عدد صحیح"
pub inline func Int(i: i64): str: ret conv.FormatInt(i) end
@en "Float"
@fa "عدد اعشار"
pub inline func Float(f: f64): str: ret str.FromFloat(f) end
@en "Bool"
@fa "منطقی"
pub inline pure func Bool(b: bool): str: ret conv.FormatBool(b) end
@en "PadLeft"
@fa "پرکردن چپ"
pub func PadLeft(s: str, width: int): str:
gap := width - str.CharCount(s)
if gap <= 0:
ret s
end
ret str.Repeat(" ", gap).concat(s)
end
@en "PadRight"
@fa "پرکردن راست"
pub func PadRight(s: str, width: int): str:
gap := width - str.CharCount(s)
if gap <= 0:
ret s
end
ret s.concat(str.Repeat(" ", gap))
end
@en "Center"
@fa "وسط چین"
pub func Center(s: str, width: int): str:
gap := width - str.CharCount(s)
if gap <= 0:
ret s
end
left := gap / 2
ret str.Repeat(" ", left).concat(s).concat(str.Repeat(" ", gap - left))
end
@en "Sprintf"
@fa "قالب رشته"
pub func Sprintf(tmpl: str, args: Vector<str>): str:
parts := tmpl.split("{}")
defer parts.free()
mut out := parts.get(0)
mut i := 1
until i < parts.len():
if i - 1 < args.len():
out = out.concat(args.get(i - 1))
end
out = out.concat(parts.get(i))
i += 1
end
ret out
end
@en "Fprintf"
@fa "قالب نوشتن"
pub func Fprintf(f: File*, tmpl: str, args: Vector<str>): int:
ret f.write(Sprintf(tmpl, args))
end
@en "FloatPrec"
@fa "عدد اعشار با دقت"
pub inline func FloatPrec(f: f64, prec: int): str: ret conv.FormatFloatPrec(f, prec) end
@en "Uint"
@fa "عدد بی علامت"
pub inline func Uint(u: u64): str: ret conv.FormatUint(u) end
@en "Hex"
@fa "شانزده"
pub inline func Hex(u: u64): str: ret conv.FormatHex(u) end
@en "dir"
@fa "پوشه"
package dir
import os
import fs
import fs.file
import fs.path
import os.error
@en "Mkdir"
@fa "ساخت پوشه"
pub func Mkdir(p: str): int:
if os.Mkdir(p) != 0:
error.Set(error.IOError, "mkdir failed", "Mkdir", p, 0)
ret 0 - 1
end
ret 0
end
@en "MkdirAll"
@fa "ساخت پوشه ها"
pub func MkdirAll(p: str): int:
if os.MkdirAll(p) != 0:
error.Set(error.IOError, "mkdir -p failed", "MkdirAll", p, 0)
ret 0 - 1
end
ret 0
end
@en "Remove"
@fa "حذف"
pub func Remove(p: str): int:
if os.Rmdir(p) != 0:
error.Set(error.IOError, "rmdir failed", "Remove", p, 0)
ret 0 - 1
end
ret 0
end
@en "RemoveAll"
@fa "حذف همه"
pub func RemoveAll(p: str): int:
if os.RemoveAll(p) != 0:
error.Set(error.IOError, "recursive remove failed", "RemoveAll", p, 0)
ret 0 - 1
end
ret 0
end
@en "List"
@fa "فهرست"
pub func List(p: str): Vector<str>: ret os.ListDir(p) end
@en "ListDirs"
@fa "فهرست پوشه ها"
pub func ListDirs(p: str): Vector<str>: ret os.ListDirs(p) end
@en "ListFiles"
@fa "فهرست پرونده ها"
pub func ListFiles(p: str): Vector<str>:
entries := os.ListDir(p)
defer entries.free()
out := Vector {} as Vector<str>
repeat entries.len() in i:
name := entries.get(i)
full := path.Join(p, name)
if os.IsDir(full) == false:
out.push(name)
end
end
ret out
end
@en "Walk"
@fa "پیمایش"
pub func Walk(p: str): Vector<str>: ret os.Walk(p) end
@en "Copy"
@fa "کپی"
pub func Copy(src: str, dst: str): int:
if os.CopyTree(src, dst) != 0:
error.Set(error.IOError, "copy tree failed", "Copy", src, 0)
ret 0 - 1
end
ret 0
end
@en "Move"
@fa "جابجایی"
pub func Move(src: str, dst: str): int:
if os.Move(src, dst) == 0: ret 0 end
if os.CopyTree(src, dst) != 0:
error.Set(error.IOError, "move (copy phase) failed", "Move", src, 0)
ret 0 - 1
end
if os.RemoveAll(src) != 0:
error.Set(error.IOError, "move (cleanup phase) failed", "Move", src, 0)
ret 0 - 1
end
ret 0
end
@en "Exists"
@fa "وجود دارد"
pub func Exists(p: str): bool: ret os.Exists(p) and os.IsDir(p) end
@en "IsDir"
@fa "پوشه است"
pub func IsDir(p: str): bool: ret os.IsDir(p) end
@en "Size"
@fa "اندازه"
pub func Size(p: str): i64:
files := os.Walk(p)
defer files.free()
mut total := 0 as i64
repeat files.len() in i:
f := files.get(i)
sz := file.Size(f)
if sz > 0: total += sz end
end
ret total
end
@en "Permissions"
@fa "مجوزها"
pub func Permissions(p: str): int: ret fs.Permissions(p) end
@en "ModTime"
@fa "زمان تغییر"
pub func ModTime(p: str): i64: ret fs.ModTime(p) end
@en "file"
@fa "پرونده"
package file
import io
import os
import fs
import fs.path
import crypto
import str
import os.error
if SALAM_OS_WINDOWS:
extern:
func MoveFileExA(existing: str, new_path: str, flags: int): int
end
end
@en "FileInfo"
@fa "اطلاعات پرونده"
pub struct FileInfo:
pub size: i64 = 0
pub mod_time: i64 = 0
pub accessed_time: i64 = 0
pub created_time: i64 = 0
pub permissions: int = 0
pub exists: bool = false
end
if SALAM_OS_WINDOWS:
func _atomic_rename(tmp: str, path: str): int:
if MoveFileExA(tmp, path, 1) == 0: ret 0 - 1 end
ret 0
end
else:
func _atomic_rename(tmp: str, path: str): int:
if os.Move(tmp, path) != 0: ret 0 - 1 end
ret 0
end
end
func _strip_cr(s: str): str:
if str.EndsWith(s, "\r"): ret s.substr(0, s.len() - 1) end
ret s
end
func _write_binary(path: str, mode: str, data: str): int:
f := os.Open(path, mode)
if f == null: ret 0 - 1 end
n := io.Write(f, data)
io.Close(f)
ret n
end
@en "Open"
@fa "بازکردن"
pub func Open(path: str, mode: str): File*: ret os.Open(path, mode) end
@en "Close"
@fa "بستن"
pub func Close(f: File*): io.Close(f) end
@en "ReadText"
@fa "خواندن متن"
pub func ReadText(path: str): str: ret io.ReadFile(path) end
@en "ReadAll"
@fa "خواندن همه"
pub func ReadAll(path: str): str: ret io.ReadFile(path) end
@en "ReadBytes"
@fa "خواندن بایت‌ها"
pub func ReadBytes(path: str, n: int): str:
f := os.Open(path, "rb")
if f == null: ret "" end
out := io.Read(f, n as u64)
io.Close(f)
ret out
end
@en "ReadLines"
@fa "خواندن خط‌ها"
pub func ReadLines(path: str): Vector<str>:
raw := io.Lines(path)
defer raw.free()
out := Vector {} as Vector<str>
n := raw.len()
mut i := 0
until i < n:
out.push(_strip_cr(raw.get(i)))
i += 1
end
ret out
end
@en "WriteText"
@fa "نوشتن متن"
pub func WriteText(path: str, data: str): int: ret _write_binary(path, "wb", data) end
@en "WriteBytes"
@fa "نوشتن بایت‌ها"
pub func WriteBytes(path: str, data: str): int: ret _write_binary(path, "wb", data) end
@en "Append"
@fa "افزودن"
pub func Append(path: str, data: str): int: ret _write_binary(path, "ab", data) end
@en "AtomicWrite"
@fa "نوشتن اتمی"
pub func AtomicWrite(path: str, data: str): int:
tmp := path.concat(".tmp")
if _write_binary(tmp, "wb", data) < 0:
error.Set(error.IOError, "atomic write failed", "AtomicWrite", path, 0)
ret 0 - 1
end
if _atomic_rename(tmp, path) != 0:
error.Set(error.IOError, "atomic rename failed", "AtomicWrite", path, 0)
ret 0 - 1
end
ret 0
end
@en "Size"
@fa "اندازه"
pub func Size(p: str): i64: ret os.FileSize(p) end
@en "ModTime"
@fa "زمان تغییر"
pub func ModTime(p: str): i64: ret fs.ModTime(p) end
@en "AccessedTime"
@fa "زمان دسترسی"
pub func AccessedTime(p: str): i64: ret fs.AccessedTime(p) end
@en "CreatedTime"
@fa "زمان ایجاد"
pub func CreatedTime(p: str): i64: ret fs.CreatedTime(p) end
@en "Permissions"
@fa "مجوزها"
pub func Permissions(p: str): int: ret fs.Permissions(p) end
@en "Chmod"
@fa "تغییر مجوز"
pub func Chmod(p: str, mode: int): int: ret fs.Chmod(p, mode) end
@en "Extension"
@fa "پسوند"
pub func Extension(p: str): str: ret path.Ext(p) end
@en "MimeType"
@fa "نوع مایم"
pub func MimeType(p: str): str:
ext := str.Lower(path.Ext(p))
if ext == ".txt": ret "text/plain"
else ext == ".html": ret "text/html"
else ext == ".htm": ret "text/html"
else ext == ".css": ret "text/css"
else ext == ".js": ret "text/javascript"
else ext == ".json": ret "application/json"
else ext == ".xml": ret "application/xml"
else ext == ".csv": ret "text/csv"
else ext == ".md": ret "text/markdown"
else ext == ".pdf": ret "application/pdf"
else ext == ".zip": ret "application/zip"
else ext == ".gz": ret "application/gzip"
else ext == ".tar": ret "application/x-tar"
else ext == ".png": ret "image/png"
else ext == ".jpg": ret "image/jpeg"
else ext == ".jpeg": ret "image/jpeg"
else ext == ".gif": ret "image/gif"
else ext == ".svg": ret "image/svg+xml"
else ext == ".webp": ret "image/webp"
else ext == ".ico": ret "image/x-icon"
else ext == ".mp3": ret "audio/mpeg"
else ext == ".wav": ret "audio/wav"
else ext == ".mp4": ret "video/mp4"
else ext == ".wasm": ret "application/wasm"
end
ret "application/octet-stream"
end
@en "Stat"
@fa "وضعیت"
pub func Stat(p: str): FileInfo:
if os.Exists(p) == false: ret FileInfo { exists = false } end
ret FileInfo {
size = Size(p), mod_time = ModTime(p), accessed_time = AccessedTime(p), created_time = CreatedTime(p),
permissions = Permissions(p), exists = true
}
end
@en "Copy"
@fa "کپی"
pub func Copy(src: str, dst: str): int:
if os.Copy(src, dst) != 0:
error.Set(error.IOError, "copy failed", "Copy", src, 0)
ret 0 - 1
end
ret 0
end
@en "Move"
@fa "جابجایی"
pub func Move(src: str, dst: str): int:
if os.Move(src, dst) != 0:
error.Set(error.IOError, "move failed", "Move", src, 0)
ret 0 - 1
end
ret 0
end
@en "Rename"
@fa "تغییر نام"
pub func Rename(src: str, dst: str): int: ret Move(src, dst) end
@en "Delete"
@fa "حذف"
pub func Delete(p: str): int:
if os.Remove(p) != 0:
error.Set(error.FileNotFound, "delete failed", "Delete", p, 0)
ret 0 - 1
end
ret 0
end
@en "Exists"
@fa "وجود دارد"
pub func Exists(p: str): bool: ret os.Exists(p) end
@en "Md5Hex"
@fa "هش ام‌دی۵"
pub func Md5Hex(p: str): str: ret crypto.Md5Hex(io.ReadFile(p)) end
@en "Sha1Hex"
@fa "هش شا۱"
pub func Sha1Hex(p: str): str: ret crypto.Sha1Hex(io.ReadFile(p)) end
@en "Sha256Hex"
@fa "هش شا۲۵۶"
pub func Sha256Hex(p: str): str: ret crypto.Sha256Hex(io.ReadFile(p)) end
@en "Sha512Hex"
@fa "هش شا۵۱۲"
pub func Sha512Hex(p: str): str: ret crypto.Sha512Hex(io.ReadFile(p)) end
@en "fs"
@fa "سیستم پرونده"
package fs
import mem
import str
import conv
extern:
func fopen(path: str, mode: str): void*
func fclose(fp: void*): int
func fread(ptr: void*, size: u64, nmemb: u64, stream: void*): u64
func fwrite(ptr: void*, size: u64, nmemb: u64, stream: void*): u64
func fgetc(stream: void*): int
func fseek(fp: void*, off: int, whence: int): int
noret func abort()
end
if SALAM_OS_WINDOWS:
extern:
func _fseeki64(fp: void*, off: i64, whence: int): int
end
else:
extern:
func fseeko(fp: void*, off: i64, whence: int): int
end
end
if SALAM_OS_WINDOWS:
extern:
func FindFirstFileA(pat: str, data: void*): void*
func FindNextFileA(h: void*, data: void*): int
func FindClose(h: void*): int
func _wopen(path: void*, flags: int, mode: int): int
func _fdopen(fd: int, mode: str): void*
func MultiByteToWideChar(codepage: u32, flags: u32, src: str, srclen: i32, dst: void*, dstlen: i32): i32
end
else:
extern:
func opendir(path: str): void*
func readdir(d: void*): void*
func closedir(d: void*): int
end
if SALAM_OS_LINUX or SALAM_OS_ANDROID:
extern:
func dirfd(d: void*): int
end
if SALAM_ARCH_X64 or SALAM_ARCH_ARM64:
extern:
func syscall(nr: i64, a: i64, b: i64, c: i64): i64
end
else:
extern:
func syscall(nr: int, a: int, b: int, c: int): int
end
end
end
end
if SALAM_OS_WINDOWS:
extern:
func GetFileAttributesExA(path: str, level: int, data: void*): int
func _chmod(path: str, mode: int): int
end
else:
extern:
func chmod(path: str, mode: int): int
func popen(cmd: str, mode: str): void*
func pclose(fp: void*): int
end
end
func _byte_at(base: void*, off: i64): int:
p := ((base as i64) + off) as u8*
ret p[0] as int
end
func _strptr(s: str): i64:
v := s as void*
ret v as i64
end
noret func _fs_oom():
printerrln "salam: out of memory while reading a file"
abort()
end
func _fs_alloc(n: u64): void*:
p := mem.AllocateZeroed(n)
if p == null:
_fs_oom()
end
ret p
end
if SALAM_OS_WINDOWS:
func _str_to_wide(s: str): void*:
n := MultiByteToWideChar(65001 as u32, 0 as u32, s, 0 - 1, null, 0)
if n <= 0:
ret mem.Allocate(2 as u64)
end
w := mem.Allocate((n * 2) as u64)
MultiByteToWideChar(65001 as u32, 0 as u32, s, 0 - 1, w, n)
ret w
end
func _wopen_flags(mode: str): int:
O_RDONLY := 0
O_WRONLY := 1
O_APPEND := 8
O_CREAT := 256
O_TRUNC := 512
O_BINARY := 32768
if mode.len() == 0:
ret O_RDONLY | O_BINARY
end
c := mode.substr(0, 1)
if c == "w":
ret O_WRONLY | O_CREAT | O_TRUNC | O_BINARY
end
if c == "a":
ret O_WRONLY | O_CREAT | O_APPEND | O_BINARY
end
ret O_RDONLY | O_BINARY
end
end
export:
func salam_open(path: str, mode: str): File*:
if SALAM_OS_WINDOWS:
S_IREAD_IWRITE := 384
wpath := _str_to_wide(path)
fd := _wopen(wpath, _wopen_flags(mode), S_IREAD_IWRITE)
mem.Free(wpath)
if fd < 0: ret null end
fp := _fdopen(fd, mode)
if fp == null: ret null end
ret fp as File*
else:
fp := fopen(path, mode)
if fp == null: ret null end
ret fp as File*
end
end
func salam_file_read(f: File*, size: u64): str:
if f == null: ret "" end
fp := f as void*
buf := _fs_alloc(size + (1 as u64))
got := fread(buf, 1 as u64, size, fp)
mem.Set(((buf as i64) + (got as i64)) as void*, 0, 1 as u64)
ret buf as str
end
func salam_file_readline(f: File*): str:
if f == null: ret "" end
fp := f as void*
mut sb := str.NewBuilder()
defer str.BufFree(sb)
mut c := fgetc(fp)
until c != -1 and c != 10:
str.BufAppendChar(sb, c)
c = fgetc(fp)
end
out := str.BufStr(sb)
ret out
end
func salam_file_write(f: File*, data: str): int:
if f == null: ret 0 - 1 end
fp := f as void*
n := data.len() as u64
w := fwrite(data as void*, 1 as u64, n, fp)
ret w as int
end
func salam_file_close(f: File*):
if f == null: ret end
fclose(f as void*)
end
func salam_file_seek(f: File*, off: i64, whence: int): int:
if f == null: ret 0 - 1 end
fp := f as void*
mut w := 0
if whence == 1: w = 1
else whence == 2: w = 2
end
if _fs_seek64(fp, off, w) == 0: ret 0 end
ret 0 - 1
end
end
if SALAM_OS_WINDOWS:
func _fs_seek64(fp: void*, off: i64, w: int): int: ret _fseeki64(fp, off, w) end
else:
func _fs_seek64(fp: void*, off: i64, w: int): int: ret fseeko(fp, off, w) end
end
func _ld_push(arr: void*, n: int, cap_box: void*, name: str): void*:
cap := cap_box as int*
mut a := arr
if n >= cap[0]:
if cap[0] == 0: cap[0] = 8 else:
cap[0] = cap[0] * 2
end
a = mem.Reallocate(a, (cap[0] as u64) * (sizeof(str) as u64))
end
slots := a as str*
slots[n] = name.substr(0, name.len())
ret a
end
func _ld_skip(name: str): bool:
if name == ".": ret true
else name == "..": ret true
else:
ret false
end
end
if SALAM_OS_WINDOWS:
export:
func salam_os_listdir(path: str, out_count: void*): void*:
mut oc := out_count as int*
fd := mem.Allocate(320 as u64)
h := FindFirstFileA(path.concat("/*"), fd)
mut arr := null as void*
mut n := 0
cap_box := mem.AllocateZeroed(4 as u64)
if (h as i64) != (0 - 1):
mut more := 1
until more != 0:
np := ((fd as i64) + 44) as void*
nm := np as str
if _ld_skip(nm) == false:
arr = _ld_push(arr, n, cap_box, nm)
n += 1
end
more = FindNextFileA(h, fd)
end
FindClose(h)
end
mem.Free(fd)
mem.Free(cap_box)
if arr == null: arr = mem.Allocate(8 as u64) end
oc[0] = n
ret arr
end
end
else:
if SALAM_OS_LINUX or SALAM_OS_ANDROID:
if SALAM_ARCH_X86:
func _gd_nr(): i64: ret 220 end
else SALAM_ARCH_ARM64:
func _gd_nr(): i64: ret 61 end
else:
func _gd_nr(): i64: ret 217 end
end
if SALAM_ARCH_X64 or SALAM_ARCH_ARM64:
func _getdents(fd: int, buf: void*, cap: int): i64:
ret syscall(_gd_nr(), fd as i64, buf as i64, cap as i64)
end
else:
func _getdents(fd: int, buf: void*, cap: int): i64:
ret syscall(_gd_nr() as int, fd, (buf as i64) as int, cap)
end
end
export:
func salam_os_listdir(path: str, out_count: void*): void*:
oc := out_count as int*
mut arr := null as void*
mut n := 0
cap_box := mem.AllocateZeroed(4 as u64)
dp := opendir(path)
if dp != null:
fd := dirfd(dp)
bcap := 32768
buf := mem.Allocate(bcap as u64)
mut got := _getdents(fd, buf, bcap)
until got > (0 as i64):
mut p := 0 as i64
until p < got:
rl := (_byte_at(buf, p + (16 as i64)) + _byte_at(buf, p + (17 as i64)) * 256) as i64
if rl < (1 as i64):
break
end
nm := (((buf as i64) + p + (19 as i64)) as void*) as str
if _ld_skip(nm) == false:
arr = _ld_push(arr, n, cap_box, nm)
n += 1
end
p += rl
end
got = _getdents(fd, buf, bcap)
end
mem.Free(buf)
closedir(dp)
end
mem.Free(cap_box)
if arr == null: arr = mem.Allocate(sizeof(str) as u64) end
oc[0] = n
ret arr
end
end
else:
if SALAM_OS_MAC:
func _dname_off(): i64: ret 21 end
else SALAM_OS_BSD:
func _dname_off(): i64: ret 24 end
else:
func _dname_off(): i64: ret 19 end
end
export:
func salam_os_listdir(path: str, out_count: void*): void*:
oc := out_count as int*
mut arr := null as void*
mut n := 0
cap_box := mem.AllocateZeroed(4 as u64)
off := _dname_off()
d := opendir(path)
if d != null:
mut e := readdir(d)
until e != null:
np := ((e as i64) + off) as void*
nm := np as str
if _ld_skip(nm) == false:
arr = _ld_push(arr, n, cap_box, nm)
n += 1
end
e = readdir(d)
end
closedir(d)
end
mem.Free(cap_box)
if arr == null: arr = mem.Allocate(sizeof(str) as u64) end
oc[0] = n
ret arr
end
end
end
end
func _u32_at(base: void*, off: i64): u32:
p := ((base as i64) + off) as u32*
ret p[0]
end
func _filetime_to_unix(low: u32, high: u32): i64:
combined := (high as u64) * (4294967296 as u64) + (low as u64)
epoch := 116444736000000000 as u64
if combined < epoch: ret 0 end
ret ((combined - epoch) / (10000000 as u64)) as i64
end
if SALAM_OS_WINDOWS:
func _fs_times(path: str): i64*:
buf := mem.AllocateZeroed(40 as u64)
out := mem.Allocate(24 as u64) as i64*
ok := GetFileAttributesExA(path, 0, buf)
if ok == 0:
out[0] = 0 - 1
out[1] = 0 - 1
out[2] = 0 - 1
mem.Free(buf)
ret out
end
ctime := _filetime_to_unix(_u32_at(buf, 4), _u32_at(buf, 8))
atime := _filetime_to_unix(_u32_at(buf, 12), _u32_at(buf, 16))
mtime := _filetime_to_unix(_u32_at(buf, 20), _u32_at(buf, 24))
out[0] = mtime
out[1] = atime
out[2] = ctime
mem.Free(buf)
ret out
end
else:
func _fs_shell_quote(path: str): str:
mut sb := str.NewBuilder()
str.BufAppendChar(sb, 39)
pp := path as void*
repeat path.len() in i:
c := _byte_at(pp, i as i64)
if c == 39:
str.BufAppend(sb, "'\\''")
else:
str.BufAppendChar(sb, c)
end
end
str.BufAppendChar(sb, 39)
out := str.BufStr(sb)
str.BufFree(sb)
ret out
end
func _fs_stat_field(path: str, fmt: str): i64:
mut cmd := ""
quoted := _fs_shell_quote(path)
if SALAM_OS_MAC or SALAM_OS_BSD:
cmd = "stat -f ".concat(fmt).concat(" ").concat(quoted).concat(" 2>/dev/null")
else:
cmd = "stat -c ".concat(fmt).concat(" ").concat(quoted).concat(" 2>/dev/null")
end
mem.Free(quoted as void*)
fp := popen(cmd, "r")
if fp == null: ret 0 - 1 end
buf := mem.Allocate(256 as u64)
mut sb := str.NewBuilder()
mut c := fgetc(fp)
until c != -1 and c != 10:
str.BufAppendChar(sb, c)
c = fgetc(fp)
end
mem.Free(buf)
line := str.BufStr(sb)
str.BufFree(sb)
pclose(fp)
if line.len() == 0: ret 0 - 1 end
lp := line as void*
mut k := 0
if _byte_at(lp, 0 as i64) == 45: k = 1 end
if k >= line.len(): ret 0 - 1 end
until k < line.len():
c := _byte_at(lp, k as i64)
if c < 48 or c > 57: ret 0 - 1 end
k += 1
end
ret conv.ParseInt(line)
end
end
if SALAM_OS_WINDOWS:
@en "ModTime"
@fa "زمان تغییر"
pub func ModTime(path: str): i64:
t := _fs_times(path)
ret t[0]
end
@en "AccessedTime"
@fa "زمان دسترسی"
pub func AccessedTime(path: str): i64:
t := _fs_times(path)
ret t[1]
end
@en "CreatedTime"
@fa "زمان ایجاد"
pub func CreatedTime(path: str): i64:
t := _fs_times(path)
ret t[2]
end
@en "Chmod"
@fa "تغییر مجوز"
pub func Chmod(path: str, mode: int): int:
if _chmod(path, mode) == 0: ret 0 end
ret 0 - 1
end
@en "Permissions"
@fa "مجوزها"
pub func Permissions(path: str): int:
buf := mem.AllocateZeroed(40 as u64)
ok := GetFileAttributesExA(path, 0, buf)
if ok == 0:
mem.Free(buf)
ret 0 - 1
end
attrs := _u32_at(buf, 0)
mem.Free(buf)
if (attrs as int) % 2 == 1: ret 292 end
ret 438
end
else:
@en "ModTime"
@fa "زمان تغییر"
pub func ModTime(path: str): i64:
if SALAM_OS_MAC or SALAM_OS_BSD:
ret _fs_stat_field(path, "%m")
else:
ret _fs_stat_field(path, "%Y")
end
end
@en "AccessedTime"
@fa "زمان دسترسی"
pub func AccessedTime(path: str): i64:
if SALAM_OS_MAC or SALAM_OS_BSD:
ret _fs_stat_field(path, "%a")
else:
ret _fs_stat_field(path, "%X")
end
end
@en "CreatedTime"
@fa "زمان ایجاد"
pub func CreatedTime(path: str): i64:
if SALAM_OS_MAC or SALAM_OS_BSD:
ret _fs_stat_field(path, "%B")
else:
ret _fs_stat_field(path, "%W")
end
end
@en "Chmod"
@fa "تغییر مجوز"
pub func Chmod(path: str, mode: int): int:
if chmod(path, mode) == 0: ret 0 end
ret 0 - 1
end
@en "Permissions"
@fa "مجوزها"
pub func Permissions(path: str): int:
if SALAM_OS_MAC or SALAM_OS_BSD:
ret _fs_stat_field(path, "%Lp") as int
else:
ret _fs_stat_field(path, "%a") as int
end
end
end
@en "path"
