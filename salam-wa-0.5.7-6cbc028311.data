end
end
until pos > 1 and digits[pos - 1] == (48 as u8):
pos -= 1
end
mut i := 0
mut j2 := pos - 1
until i < j2:
t := digits[i]
digits[i] = digits[j2]
digits[j2] = t
i += 1
j2 -= 1
end
