const RT_FLAGS := 5 as u8
const SYM_PAIR_SIZE := 24 as u64
@en "RunResult"
@fa "نتیجه اجرا"
pub struct RunResult:
pub ok: bool = false
pub rc: int = 0
pub err: str = ""
end
func pack_symbol(buf: void*, idx: int, name_entry: void*, addr: i64):
base := (buf as u64) + (idx as u64) * SYM_PAIR_SIZE
mut name_slot := base as u64*
name_slot[0] = name_entry as u64
mut addr_slot := (base + 8) as i64*
addr_slot[0] = addr
mut flags_slot := (base + 16) as u8*
flags_slot[0] = RT_FLAGS
end
func define_runtime_symbols(jit: void*, jd: void*):
if SALAM_OS_WINDOWS:
buf := mem.AllocateZeroed((16 as u64) * SYM_PAIR_SIZE)
defer mem.Free(buf)
pack_symbol(buf, 0, LLVMOrcLLJITMangleAndIntern(jit, "printf"), printf)
pack_symbol(buf, 1, LLVMOrcLLJITMangleAndIntern(jit, "snprintf"), snprintf)
pack_symbol(buf, 2, LLVMOrcLLJITMangleAndIntern(jit, "strlen"), strlen)
pack_symbol(buf, 3, LLVMOrcLLJITMangleAndIntern(jit, "strcmp"), strcmp)
pack_symbol(buf, 4, LLVMOrcLLJITMangleAndIntern(jit, "malloc"), malloc)
pack_symbol(buf, 5, LLVMOrcLLJITMangleAndIntern(jit, "realloc"), realloc)
pack_symbol(buf, 6, LLVMOrcLLJITMangleAndIntern(jit, "free"), free)
pack_symbol(buf, 7, LLVMOrcLLJITMangleAndIntern(jit, "memcpy"), memcpy)
pack_symbol(buf, 8, LLVMOrcLLJITMangleAndIntern(jit, "memmove"), memmove)
pack_symbol(buf, 9, LLVMOrcLLJITMangleAndIntern(jit, "abort"), abort)
pack_symbol(buf, 10, LLVMOrcLLJITMangleAndIntern(jit, "exit"), exit)
pack_symbol(buf, 11, LLVMOrcLLJITMangleAndIntern(jit, "strtol"), strtol)
pack_symbol(buf, 12, LLVMOrcLLJITMangleAndIntern(jit, "strtod"), strtod)
pack_symbol(buf, 13, LLVMOrcLLJITMangleAndIntern(jit, "strstr"), strstr)
pack_symbol(buf, 14, LLVMOrcLLJITMangleAndIntern(jit, "__main"), __main)
pack_symbol(buf, 15, LLVMOrcLLJITMangleAndIntern(jit, "___chkstk_ms"), ___chkstk_ms)
LLVMOrcJITDylibDefine(jd, LLVMOrcAbsoluteSymbols(buf, 16 as u64))
else:
buf := mem.AllocateZeroed((14 as u64) * SYM_PAIR_SIZE)
defer mem.Free(buf)
pack_symbol(buf, 0, LLVMOrcLLJITMangleAndIntern(jit, "printf"), printf)
pack_symbol(buf, 1, LLVMOrcLLJITMangleAndIntern(jit, "snprintf"), snprintf)
pack_symbol(buf, 2, LLVMOrcLLJITMangleAndIntern(jit, "strlen"), strlen)
pack_symbol(buf, 3, LLVMOrcLLJITMangleAndIntern(jit, "strcmp"), strcmp)
pack_symbol(buf, 4, LLVMOrcLLJITMangleAndIntern(jit, "malloc"), malloc)
pack_symbol(buf, 5, LLVMOrcLLJITMangleAndIntern(jit, "realloc"), realloc)
pack_symbol(buf, 6, LLVMOrcLLJITMangleAndIntern(jit, "free"), free)
pack_symbol(buf, 7, LLVMOrcLLJITMangleAndIntern(jit, "memcpy"), memcpy)
pack_symbol(buf, 8, LLVMOrcLLJITMangleAndIntern(jit, "memmove"), memmove)
pack_symbol(buf, 9, LLVMOrcLLJITMangleAndIntern(jit, "abort"), abort)
pack_symbol(buf, 10, LLVMOrcLLJITMangleAndIntern(jit, "exit"), exit)
pack_symbol(buf, 11, LLVMOrcLLJITMangleAndIntern(jit, "strtol"), strtol)
pack_symbol(buf, 12, LLVMOrcLLJITMangleAndIntern(jit, "strtod"), strtod)
pack_symbol(buf, 13, LLVMOrcLLJITMangleAndIntern(jit, "strstr"), strstr)
LLVMOrcJITDylibDefine(jd, LLVMOrcAbsoluteSymbols(buf, 14 as u64))
end
end
@en "RunJIT"
@fa "اجرای جیت"
pub func RunJIT(ll_path: str): RunResult:
mut none := Vector {} as Vector<str>
defer none.free()
ret RunJITArgs(ll_path, none)
end
@en "RunJITArgs"
@fa "اجرای جیت با آرگومان"
pub func RunJITArgs(ll_path: str, args: Vector<str>): RunResult:
InitTargets()
ctx := LLVMContextCreate()
tsctx := LLVMOrcCreateNewThreadSafeContextFromLLVMContext(ctx)
mut buf := null as void*
mut berr := null as void*
if LLVMCreateMemoryBufferWithContentsOfFile(ll_path, buf, berr) != 0:
msg := berr != null ? str.Clone(berr as str) : "cannot read '" + ll_path + "'"
if berr != null: LLVMDisposeMessage(berr) end
LLVMOrcDisposeThreadSafeContext(tsctx)
ret RunResult { ok = false, err = msg }
end
mut mod := null as void*
mut perr := null as void*
if LLVMParseIRInContext(ctx, buf, mod, perr) != 0:
msg := perr != null ? str.Clone(perr as str) : "(unknown)"
if perr != null: LLVMDisposeMessage(perr) end
LLVMOrcDisposeThreadSafeContext(tsctx)
ret RunResult { ok = false, err = "LLVM IR parse error: " + msg }
end
mut jit := null as void*
jit_err := LLVMOrcCreateLLJIT(jit, null)
if jit_err != null:
msg := LLVMGetErrorMessage(jit_err)
out := msg != null ? str.Clone(msg as str) : "(unknown)"
if msg != null: LLVMDisposeErrorMessage(msg) end
LLVMDisposeModule(mod)
LLVMOrcDisposeThreadSafeContext(tsctx)
ret RunResult { ok = false, err = "JIT init failed: " + out }
end
dl_str := LLVMOrcLLJITGetDataLayoutStr(jit)
if str.Len(dl_str) > 0:
jit_dl := LLVMCreateTargetData(dl_str)
LLVMSetModuleDataLayout(mod, jit_dl)
LLVMDisposeTargetData(jit_dl)
end
tsm := LLVMOrcCreateNewThreadSafeModule(mod, tsctx)
LLVMOrcDisposeThreadSafeContext(tsctx)
jd := LLVMOrcLLJITGetMainJITDylib(jit)
mut gen := null as void*
gen_err := LLVMOrcCreateDynamicLibrarySearchGeneratorForProcess(
gen, LLVMOrcLLJITGetGlobalPrefix(jit), null, null
)
if gen_err != null:
msg := LLVMGetErrorMessage(gen_err)
out := msg != null ? str.Clone(msg as str) : "(unknown)"
if msg != null: LLVMDisposeErrorMessage(msg) end
_d := LLVMOrcDisposeLLJIT(jit)
LLVMOrcDisposeThreadSafeModule(tsm)
ret RunResult { ok = false, err = "JIT symbol generator failed: " + out }
end
LLVMOrcJITDylibAddGenerator(jd, gen)
define_runtime_symbols(jit, jd)
add_err := LLVMOrcLLJITAddLLVMIRModule(jit, jd, tsm)
if add_err != null:
msg := LLVMGetErrorMessage(add_err)
out := msg != null ? str.Clone(msg as str) : "(unknown)"
if msg != null: LLVMDisposeErrorMessage(msg) end
_d := LLVMOrcDisposeLLJIT(jit)
ret RunResult { ok = false, err = "JIT add module failed: " + out }
end
mut addr := 0 as i64
lookup_err := LLVMOrcLLJITLookup(jit, addr, "main")
if lookup_err != null:
msg := LLVMGetErrorMessage(lookup_err)
out := msg != null ? str.Clone(msg as str) : "(unknown)"
if msg != null: LLVMDisposeErrorMessage(msg) end
_d := LLVMOrcDisposeLLJIT(jit)
ret RunResult { ok = false, err = "no 'main' function to run: " + out }
end
if addr == 0:
_d := LLVMOrcDisposeLLJIT(jit)
ret RunResult { ok = false, err = "no 'main' function to run" }
end
salam_orc_args_clear()
if args.len() == 0:
salam_orc_args_push(ll_path)
end
each arg in args:
salam_orc_args_push(arg)
end
rc := salam_orc_call_main(addr)
salam_orc_args_clear()
_d := LLVMOrcDisposeLLJIT(jit)
ret RunResult { ok = true, rc = rc }
end
package llvm
import str
import conv
import os
import os.platform
extern:
func salam_parallel_partitions(mod: void*, jobs: int): int
func salam_parallel_opt_emit(mod: void*, tm: void*, pipeline: str, parts: int, out_prefix: str, out_err &: void*): int
end
@en "ParallelResult"
@fa "نتیجه موازی"
pub struct ParallelResult:
pub ok: bool = false
pub err: str = ""
pub objects: Vector<str> = Vector {}
end
@en "ParallelJobs"
@fa "کارهای موازی"
pub func ParallelJobs(): int:
env := os.Env("SALAM_LLVM_JOBS")
if str.Len(env) > 0:
v := conv.ParseInt(env) as int
ret v < 1 ? 1 : v
end
n := platform.CpuCount()
ret n < 1 ? 1 : n
end
@en "ParallelPartitions"
@fa "بخش‌های موازی"
pub func ParallelPartitions(mod: Module, jobs: int): int:
ret salam_parallel_partitions(mod.handle, jobs)
end
@en "OptimizeEmitParallel"
@fa "بهینه‌سازی سپس تولید موازی"
pub func OptimizeEmitParallel(mod: Module, tm: TargetMachine, opt_level: int, parts: int, out_prefix: str): ParallelResult:
mut perr := null as void*
rc := salam_parallel_opt_emit(mod.handle, tm.handle, PassPipelineOf(opt_level), parts, out_prefix, perr)
mut objects := Vector {} as Vector<str>
repeat parts in i:
objects.push(out_prefix + "." + str.FromInt(i as i64) + ".o")
end
if rc != 0:
msg := perr != null ? str.Clone(perr as str) : "(unknown)"
if perr != null: LLVMDisposeMessage(perr) end
repeat objects.len() in j:
if os.Exists(objects.get(j)):
_rm := os.Remove(objects.get(j))
end
end
objects.free()
ret ParallelResult { ok = false, err = msg }
end
ret ParallelResult { ok = true, objects = objects }
end
package llvm
extern:
func LLVMCreatePassBuilderOptions(): void*
func LLVMDisposePassBuilderOptions(pbo: void*)
func LLVMRunPasses(mod: void*, pipeline: str, tm: void*, pbo: void*): void*
func LLVMGetErrorMessage(err: void*): void*
func LLVMDisposeErrorMessage(msg: void*)
end
@en "OptResult"
@fa "نتیجه بهینه‌سازی"
pub struct OptResult:
pub ok: bool = false
pub err: str = ""
end
@en "RunOpt"
@fa "اجرای بهینه‌سازی"
pub func RunOpt(mod: Module, tm: TargetMachine, opt_level: int): OptResult:
pipeline := PassPipelineOf(opt_level)
if str.Len(pipeline) == 0:
ret OptResult { ok = true }
end
pbo := LLVMCreatePassBuilderOptions()
err := LLVMRunPasses(mod.handle, pipeline, tm.handle, pbo)
LLVMDisposePassBuilderOptions(pbo)
if err != null:
msg := LLVMGetErrorMessage(err)
out := msg != null ? str.Clone(msg as str) : "(unknown)"
if msg != null: LLVMDisposeErrorMessage(msg) end
ret OptResult { ok = false, err = "LLVM optimization failed: " + out }
end
ret OptResult { ok = true }
end
package llvm
func run_parallel(pr: ParseResult, tm: TargetMachine, opts: Options, parts: int): Output:
mut out := Output { ok = true }
if opts.verify_module:
vr := Verify(pr.mod)
if not vr.ok:
out = Output { ok = false, error = vr.err }
end
end
if out.ok:
par := OptimizeEmitParallel(pr.mod, tm, opts.opt_level, parts, opts.output_file)
if not par.ok:
out = Output { ok = false, error = par.err }
else:
mut extra := Vector {} as Vector<str>
repeat par.objects.len() - 1 in i:
extra.push(par.objects.get(i + 1))
end
mut xopts := opts
xopts.extra_objects = extra
mut lopts := xopts
if str.Len(lopts.target_triple) == 0:
lopts.target_triple = HostLinkTriple()
end
first := par.objects.get(0)
if CanLinkTriple(lopts.target_triple):
lr := LinkAuto(first, opts.output_file, lopts)
out = Output { ok = lr.ok, error = lr.err }
else:
lr := LinkExternal(first, opts.output_file, xopts)
out = Output { ok = lr.ok, error = lr.err }
end
repeat par.objects.len() in j:
_rm := os.Remove(par.objects.get(j))
end
extra.free()
end
end
FreeTargetMachine(tm)
FreeModule(pr.mod)
FreeContext(pr.ctx)
ret out
end
@en "Available"
@fa "در دسترس"
pub func Available(): bool:
ret true
end
@en "Run"
@fa "اجرا"
pub func Run(ll_path: str, opts: Options): Output:
if opts.output_mode == OUT_IR:
ret Output { ok = true }
end
if opts.output_mode == OUT_JIT:
jr := RunJITArgs(ll_path, opts.run_args)
ret Output { ok = jr.ok, error = jr.err, rc = jr.rc }
end
pr := ParseIR(ll_path)
if not pr.ok:
ret Output { ok = false, error = pr.err }
end
mut trip := opts.target_triple
if str.Len(trip) == 0:
trip = TargetTripleOf(pr.mod)
end
SetTargetTriple(pr.mod, trip)
tmr := NewTargetMachine(trip, opts.opt_level, opts.native_cpu)
if not tmr.ok:
FreeModule(pr.mod)
FreeContext(pr.ctx)
ret Output { ok = false, error = tmr.err }
end
ApplyDataLayout(pr.mod, tmr.tm)
if opts.output_mode == OUT_EXEC and not opts.debug_info:
parts := ParallelPartitions(pr.mod, ParallelJobs())
if parts >= 2:
ret run_parallel(pr, tmr.tm, opts, parts)
end
end
_opt := RunOpt(pr.mod, tmr.tm, opts.opt_level)
if opts.verify_module:
vr := Verify(pr.mod)
if not vr.ok:
FreeTargetMachine(tmr.tm)
FreeModule(pr.mod)
FreeContext(pr.ctx)
ret Output { ok = false, error = vr.err }
end
end
mut out := Output { ok = false, error = "unknown output mode" }
if opts.output_mode == OUT_ASM:
er := EmitAsm(pr.mod, tmr.tm, opts.output_file)
out = Output { ok = er.ok, error = er.err }
else opts.output_mode == OUT_BITCODE:
er := EmitBitcode(pr.mod, opts.output_file)
out = Output { ok = er.ok, error = er.err }
else opts.output_mode == OUT_OBJ:
er := EmitObject(pr.mod, tmr.tm, opts.output_file)
out = Output { ok = er.ok, error = er.err }
else opts.output_mode == OUT_EXEC:
obj_path := opts.output_file + ".o"
er := EmitObject(pr.mod, tmr.tm, obj_path)
if not er.ok:
out = Output { ok = false, error = er.err }
else:
mut lopts := opts
if str.Len(lopts.target_triple) == 0:
lopts.target_triple = HostLinkTriple()
end
if CanLinkTriple(lopts.target_triple):
lr := LinkAuto(obj_path, opts.output_file, lopts)
out = Output { ok = lr.ok, error = lr.err }
else:
lr := LinkExternal(obj_path, opts.output_file, opts)
out = Output { ok = lr.ok, error = lr.err }
end
_rm := os.Remove(obj_path)
end
end
FreeTargetMachine(tmr.tm)
FreeModule(pr.mod)
FreeContext(pr.ctx)
ret out
end
package llvm
extern:
func salam_llvm_init_all_target_infos()
func salam_llvm_init_all_targets()
func salam_llvm_init_all_target_mcs()
func salam_llvm_init_all_asm_printers()
func salam_llvm_init_all_asm_parsers()
func LLVMGetDefaultTargetTriple(): str
func LLVMNormalizeTargetTriple(triple: str): str
func LLVMGetTargetFromTriple(triple: str, out_target &: void*, out_err &: void*): int
func LLVMGetHostCPUName(): str
func LLVMGetHostCPUFeatures(): str
func LLVMCreateTargetMachine(
target: void*, triple: str, cpu: str, features: str, level: int, reloc: int, model: int
): void*
func LLVMDisposeTargetMachine(tm: void*)
func LLVMCreateTargetDataLayout(tm: void*): void*
func LLVMCreateTargetData(layout_str: str): void*
func LLVMDisposeTargetData(td: void*)
end
mut _targets_inited := false
@en "TargetMachine"
@fa "ماشین هدف"
pub struct TargetMachine:
pub handle: void* = null
end
@en "TargetData"
@fa "داده هدف"
pub struct TargetData:
pub handle: void* = null
end
@en "TargetMachineResult"
@fa "نتیجه ماشین هدف"
pub struct TargetMachineResult:
pub tm: TargetMachine = TargetMachine {}
pub ok: bool = false
pub err: str = ""
end
func default_target_cpu(triple: str): str:
if str.StartsWith(triple, "x86_64") or str.StartsWith(triple, "amd64"):
ret "x86-64"
end
if str.StartsWith(triple, "i386") or str.StartsWith(triple, "i486"):
ret "pentium4"
end
if str.StartsWith(triple, "i586") or str.StartsWith(triple, "i686"):
ret "pentium4"
end
if str.StartsWith(triple, "aarch64") or str.StartsWith(triple, "arm64"):
ret "generic"
end
ret ""
end
@en "InitTargets"
@fa "مقداردهی اهداف"
pub func InitTargets():
if _targets_inited:
ret
end
_targets_inited = true
salam_llvm_init_all_target_infos()
salam_llvm_init_all_targets()
salam_llvm_init_all_target_mcs()
salam_llvm_init_all_asm_printers()
salam_llvm_init_all_asm_parsers()
end
@en "CodeGenLevelOf"
@fa "سطح تولید کد"
pub func CodeGenLevelOf(opt_level: int): int:
if opt_level == OPT_O0: ret CODEGEN_LEVEL_NONE end
if opt_level == OPT_O1: ret CODEGEN_LEVEL_LESS end
if opt_level == OPT_O3: ret CODEGEN_LEVEL_AGGRESSIVE end
ret CODEGEN_LEVEL_DEFAULT
end
@en "PassPipelineOf"
@fa "خط لوله پاس"
pub func PassPipelineOf(opt_level: int): str:
if opt_level == OPT_O1: ret "default<O1>" end
if opt_level == OPT_O2: ret "default<O2>" end
if opt_level == OPT_O3: ret "default<O3>" end
if opt_level == OPT_OS: ret "default<Os>" end
if opt_level == OPT_OZ: ret "default<Oz>" end
ret ""
end
@en "DefaultTriple"
@fa "سه‌تایی پیش‌فرض"
pub func DefaultTriple(): str:
raw := LLVMGetDefaultTargetTriple()
if str.Len(raw) == 0:
ret ""
end
ret LLVMNormalizeTargetTriple(raw)
end
@en "NewTargetMachine"
@fa "ماشین هدف جدید"
pub func NewTargetMachine(triple: str, opt_level: int, native_cpu: bool): TargetMachineResult:
InitTargets()
mut t := triple
if str.Len(t) == 0:
t = DefaultTriple()
end
if str.Len(t) == 0:
ret TargetMachineResult { ok = false, err = "no default target triple available" }
end
mut target := null as void*
mut terr := null as void*
if LLVMGetTargetFromTriple(t, target, terr) != 0:
msg := terr != null ? str.Clone(terr as str) : "(unavailable)"
ret TargetMachineResult { ok = false, err = "LLVM target '" + t + "': " + msg }
end
mut cpu := default_target_cpu(t)
mut features := ""
host := DefaultTriple()
is_host_target := str.Len(host) > 0 and str.EqualFold(host, t)
if native_cpu and is_host_target:
hc := LLVMGetHostCPUName()
hf := LLVMGetHostCPUFeatures()
cpu = str.Len(hc) > 0 ? hc : cpu
features = str.Len(hf) > 0 ? hf : ""
end
tm := LLVMCreateTargetMachine(
target, t, cpu, features, CodeGenLevelOf(opt_level), RELOC_PIC, CODE_MODEL_DEFAULT
)
if tm == null:
ret TargetMachineResult { ok = false, err = "LLVMCreateTargetMachine failed for '" + t + "'" }
end
ret TargetMachineResult { tm = TargetMachine { handle = tm }, ok = true }
end
@en "FreeTargetMachine"
@fa "آزادسازی ماشین هدف"
pub func FreeTargetMachine(tm: TargetMachine):
if tm.handle != null:
LLVMDisposeTargetMachine(tm.handle)
end
end
@en "ApplyDataLayout"
@fa "اعمال آرایش داده"
pub func ApplyDataLayout(mod: Module, tm: TargetMachine):
td := LLVMCreateTargetDataLayout(tm.handle)
LLVMSetModuleDataLayout(mod.handle, td)
LLVMDisposeTargetData(td)
end
@en "llvm/triple"
@fa "سه‌گانه هدف"
package triple
import str
const k_w64 := [
"x86_64", "amd64", "aarch64", "arm64", "riscv64", "wasm64", "powerpc64", "ppc64", "mips64",
"sparc64", "s390x", "loongarch64"
]
const k_w16 := ["msp430", "avr"]
const k_w32 := [
"i386", "i486", "i586", "i686", "wasm32", "armv6", "armv7", "armv5", "thumb", "mipsel", "mips",
"riscv32", "powerpc", "ppc", "arm"
]
func host_bits(): int:
if SALAM_ARCH_X64 or SALAM_ARCH_ARM64:
ret 64
else:
ret 32
end
end
@en "HostDatalayout"
@fa "آرایش داده میزبان"
pub func HostDatalayout(): str:
if SALAM_ARCH_X64 and SALAM_OS_WINDOWS:
ret "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
else SALAM_ARCH_X64 and SALAM_OS_MAC:
ret "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
else SALAM_ARCH_X64:
ret "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
else SALAM_ARCH_ARM64 and SALAM_OS_MAC:
ret "e-m:o-i64:64-i128:128-n32:64-S128"
else SALAM_ARCH_ARM64:
ret "e-m:e-i8:8:32-i16:16:32-i64:64-i128:128-n32:64-S128"
else SALAM_ARCH_X86:
ret "e-m:e-p:32:32-p270:32:32-p271:32:32-p272:64:64-i128:128-f64:32:64-f80:32-n8:16:32-S128"
else:
ret ""
end
end
@en "Datalayout"
@fa "آرایش داده"
pub func Datalayout(t: str): str:
dl_x64_elf := "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
dl_x64_win := "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
dl_x64_mac := "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
dl_x86_elf := "e-m:e-p:32:32-p270:32:32-p271:32:32-p272:64:64-i128:128-f64:32:64-f80:32-n8:16:32-S128"
dl_a64_elf := "e-m:e-i8:8:32-i16:16:32-i64:64-i128:128-n32:64-S128"
dl_a64_mac := "e-m:o-i64:64-i128:128-n32:64-S128"
dl_rv64 := "e-m:e-p:64:64-i64:64-i128:128-n32:64-S128"
dl_arm_le := "e-m:e-p:32:32-Fi8-i64:64-v128:64:128-a:0:32-n32-S64"
dl_arm_be := "E-m:e-p:32:32-Fi8-i64:64-v128:64:128-a:0:32-n32-S64"
if str.Len(t) == 0:
ret HostDatalayout()
end
win := str.Contains(t, "windows")
mac := str.Contains(t, "apple") or str.Contains(t, "darwin") or str.Contains(t, "macos")
if str.Contains(t, "x86_64") or str.Contains(t, "amd64"):
ret win ? dl_x64_win : (mac ? dl_x64_mac : dl_x64_elf)
end
if str.Contains(t, "aarch64") or str.Contains(t, "arm64"):
ret mac ? dl_a64_mac : dl_a64_elf
end
if not win and not mac and (
str.Contains(t, "i686") or str.Contains(t, "i586") or str.Contains(t, "i486") or str.Contains(t, "i386")
):
ret dl_x86_elf
end
if str.Contains(t, "riscv64"):
ret dl_rv64
end
if str.Contains(t, "thumb") or str.Contains(t, "arm"):
ret (str.Contains(t, "thumbeb") or str.Contains(t, "armeb")) ? dl_arm_be : dl_arm_le
end
ret ""
end
@en "PointerBits"
@fa "بیت‌های اشاره‌گر"
pub func PointerBits(t: str): int:
if str.Len(t) == 0:
ret host_bits()
end
repeat 12 in i:
if str.Contains(t, k_w64[i]):
ret 64
end
end
repeat 2 in k:
if str.Contains(t, k_w16[k]):
ret 16
end
end
repeat 15 in j:
if str.Contains(t, k_w32[j]):
ret 32
end
end
ret host_bits()
end
@en "IsWindows"
@fa "ویندوز است"
pub func IsWindows(t: str): bool:
if str.Len(t) > 0:
ret str.Contains(t, "windows") or str.Contains(t, "mingw") or str.Contains(t, "win32")
end
if SALAM_OS_WINDOWS:
ret true
else:
ret false
end
end
@en "IsGlibc"
@fa "گلیبسی است"
pub func IsGlibc(t: str): bool:
if str.Len(t) == 0: ret false end
if str.Contains(t, "musl"): ret false end
if str.Contains(t, "darwin") or str.Contains(t, "apple"): ret false end
if str.Contains(t, "windows") or str.Contains(t, "wasm"): ret false end
ret str.Contains(t, "linux")
end
@en "log"
@fa "گزارش"
package log
import str
import time
import fmt
import io
import os
import conv
import encoding.json
extern:
noret func exit(code: int)
func salam_open(path: str, mode: str): File*
end
@en "LevelDebug"
@fa "سطح اشکال زدایی"
pub const LevelDebug := 0
@en "LevelInfo"
@fa "سطح اطلاعات"
pub const LevelInfo := 1
@en "LevelWarn"
@fa "سطح هشدار"
pub const LevelWarn := 2
@en "LevelError"
@fa "سطح خطا"
pub const LevelError := 3
@en "FormatText"
@fa "قالب متن"
pub const FormatText := 0
@en "FormatJSON"
@fa "قالب جیسون"
pub const FormatJSON := 1
mut _level := 1
mut _prefix := ""
mut _show_time := true
mut _sink := 0
mut _file := null as File*
mut _format := 0
mut _file_path := ""
mut _rotate_max_bytes := 0 as i64
mut _rotate_max_backups := 5
mut _bytes_since_rotate := 0 as i64
func _level_name(l: int): str:
if l <= 0: ret "DEBUG"
else l == 1: ret "INFO"
else l == 2: ret "WARN"
else:
ret "ERROR"
end
end
func _rotate_if_needed():
if _rotate_max_bytes <= (0 as i64) or _sink != 2 or _file_path == "": ret end
if _bytes_since_rotate < _rotate_max_bytes: ret end
if _file != null: _file.close() end
mut i := _rotate_max_backups
until i >= 2:
src := _file_path.concat(".").concat(conv.FormatInt(i - 1 as i64))
dst := _file_path.concat(".").concat(conv.FormatInt(i as i64))
if os.Exists(src):
os.Remove(dst)
os.Move(src, dst)
end
i -= 1
end
if os.Exists(_file_path):
bak1 := _file_path.concat(".1")
os.Remove(bak1)
os.Move(_file_path, bak1)
end
_file = salam_open(_file_path, "ab")
_bytes_since_rotate = 0 as i64
end
func _text_line(l: int, msg: str, keys: Vector<str>, vals: Vector<str>): str:
mut line := ""
if _show_time:
line = line.concat(time.Format(time.Now())).concat(" ")
end
line = line.concat("[").concat(_level_name(l)).concat("]")
if _prefix.len() > 0:
line = line.concat(" ").concat(_prefix)
end
line = line.concat(" ").concat(msg)
repeat keys.len() in i:
line = line.concat(" ").concat(Field(keys.get(i), vals.get(i)))
end
ret line
end
func _json_line(l: int, msg: str, keys: Vector<str>, vals: Vector<str>): str:
mut b := str.NewBuilder()
defer str.BufFree(b)
str.BufAppend(b, "{")
mut first := true
if _show_time:
str.BufAppend(b, json.Member("time", time.FormatISO(time.Now())))
first = false
end
if first == false: str.BufAppend(b, ", ") end
str.BufAppend(b, json.Member("level", _level_name(l)))
if _prefix.len() > 0:
str.BufAppend(b, ", ")
str.BufAppend(b, json.Member("prefix", _prefix))
end
str.BufAppend(b, ", ")
str.BufAppend(b, json.Member("msg", msg))
repeat keys.len() in i:
str.BufAppend(b, ", ")
str.BufAppend(b, json.Member(keys.get(i), vals.get(i)))
end
str.BufAppend(b, "}")
ret str.BufStr(b)
end
func _emit_kv(l: int, msg: str, keys: Vector<str>, vals: Vector<str>):
if l < _level: ret end
mut line := ""
if _format == 1:
line = _json_line(l, msg, keys, vals)
else:
line = _text_line(l, msg, keys, vals)
end
if _sink == 2 and _file != null:
_rotate_if_needed()
_file.write(line.concat("\n"))
_bytes_since_rotate += (line.len() as i64) + (1 as i64)
else:
if _sink == 1:
println line
else:
io.EPrintln(line)
end
end
end
func _emit(l: int, msg: str):
empty := Vector {} as Vector<str>
_emit_kv(l, msg, empty, empty)
end
@en "LevelName"
@fa "نام سطح"
pub func LevelName(l: int): str: ret _level_name(l) end
@en "ParseLevel"
@fa "تجزیه سطح"
pub func ParseLevel(s: str): int:
u := str.Upper(str.Trim(s))
if u == "DEBUG": ret 0
else u == "INFO": ret 1
else u == "WARN": ret 2
else u == "WARNING": ret 2
else u == "ERROR": ret 3
else:
ret 1
end
end
@en "SetLevel"
@fa "تنظیم سطح"
pub func SetLevel(l: int): _level = l end
@en "GetLevel"
@fa "دریافت سطح"
pub func GetLevel(): int: ret _level end
@en "SetPrefix"
@fa "تنظیم پیشوند"
pub func SetPrefix(p: str): _prefix = p end
@en "ShowTime"
@fa "نمایش زمان"
pub func ShowTime(b: bool): _show_time = b end
@en "SetFormat"
@fa "تنظیم قالب"
pub func SetFormat(f: int): _format = f end
@en "GetFormat"
@fa "دریافت قالب"
pub func GetFormat(): int: ret _format end
@en "SetRotation"
@fa "تنظیم چرخش"
pub func SetRotation(max_bytes: i64, max_backups: int):
_rotate_max_bytes = max_bytes
_rotate_max_backups = max_backups
end
@en "ToStderr"
@fa "به خطای استاندارد"
pub func ToStderr():
_sink = 0
end
@en "ToStdout"
@fa "به خروجی استاندارد"
pub func ToStdout():
_sink = 1
end
@en "ToFile"
@fa "به پرونده"
pub func ToFile(path: str): int:
f := salam_open(path, "ab")
if f == null: ret 0 - 1 end
if _sink == 2 and _file != null: _file.close() end
_file = f
_file_path = path
_sink = 2
existing := os.FileSize(path)
if existing > (0 as i64):
_bytes_since_rotate = existing
else:
_bytes_since_rotate = 0 as i64
end
ret 0
end
@en "CloseFile"
@fa "بستن پرونده"
pub func CloseFile():
if _sink == 2 and _file != null: _file.close() end
_file = null
_sink = 0
end
@en "Log"
@fa "ثبت"
pub func Log(l: int, msg: str): _emit(l, msg) end
@en "Debug"
@fa "اشکال زدایی"
pub func Debug(msg: str): _emit(0, msg) end
@en "Info"
@fa "اطلاعات"
pub func Info(msg: str): _emit(1, msg) end
@en "Warn"
@fa "هشدار"
pub func Warn(msg: str): _emit(2, msg) end
@en "Error"
@fa "خطا"
pub func Error(msg: str): _emit(3, msg) end
@en "Debugf"
@fa "اشکال زدایی قالبی"
pub func Debugf(tmpl: str, args: Vector<str>): _emit(0, fmt.Sprintf(tmpl, args)) end
@en "Infof"
@fa "اطلاعات قالبی"
pub func Infof(tmpl: str, args: Vector<str>): _emit(1, fmt.Sprintf(tmpl, args)) end
@en "Warnf"
@fa "هشدار قالبی"
pub func Warnf(tmpl: str, args: Vector<str>): _emit(2, fmt.Sprintf(tmpl, args)) end
@en "Errorf"
@fa "خطا قالبی"
pub func Errorf(tmpl: str, args: Vector<str>): _emit(3, fmt.Sprintf(tmpl, args)) end
@en "Fatal"
@fa "مهلک"
pub noret func Fatal(msg: str):
_emit(3, msg)
if _sink == 2 and _file != null: _file.close() end
exit(1)
end
@en "Field"
@fa "فیلد"
pub func Field(key: str, val: str): str:
if str.Contains(val, " ") or str.Contains(val, `"`):
ret key.concat(`="`).concat(str.Replace(val, `"`, `\"`)).concat(`"`)
end
ret key.concat("=").concat(val)
end
@en "FieldInt"
@fa "فیلد عدد"
pub func FieldInt(key: str, val: i64): str:
ret key.concat("=").concat(str.FromInt(val))
end
@en "FieldBool"
@fa "فیلد منطقی"
pub func FieldBool(key: str, val: bool): str:
if val: ret key.concat("=true") end
ret key.concat("=false")
end
@en "KV"
@fa "کلید مقدار"
pub func KV(msg: str, fields: Vector<str>): str:
mut out := msg
repeat fields.len() in i:
out = out.concat(" ").concat(fields.get(i))
end
ret out
end
@en "DebugKV"
@fa "اشکال زدایی با فیلد"
pub func DebugKV(msg: str, keys: Vector<str>, vals: Vector<str>): _emit_kv(0, msg, keys, vals) end
@en "InfoKV"
@fa "اطلاعات با فیلد"
pub func InfoKV(msg: str, keys: Vector<str>, vals: Vector<str>): _emit_kv(1, msg, keys, vals) end
@en "WarnKV"
@fa "هشدار با فیلد"
pub func WarnKV(msg: str, keys: Vector<str>, vals: Vector<str>): _emit_kv(2, msg, keys, vals) end
@en "ErrorKV"
@fa "خطا با فیلد"
pub func ErrorKV(msg: str, keys: Vector<str>, vals: Vector<str>): _emit_kv(3, msg, keys, vals) end
@en "map"
@fa "نگاشت"
package map
import mem
func _ptrstr(p: i64): str:
v := p as void*
ret v as str
end
func _m_keykind(m: void*): int:
p := m as int*
ret p[0]
end
func _m_cap(m: void*): i64:
p := m as i64*
ret p[1]
end
func _m_count(m: void*): i64:
p := m as i64*
ret p[2]
end
func _m_state(m: void*): int*:
p := m as i64*
sp := p[3] as void*
ret sp as int*
end
func _m_keys(m: void*): i64*:
p := m as i64*
kp := p[4] as void*
ret kp as i64*
end
func _m_vals(m: void*): i64*:
p := m as i64*
vp := p[5] as void*
ret vp as i64*
end
func _m_set_cap(m: void*, v: i64):
p := m as i64*
p[1] = v
end
func _m_set_count(m: void*, v: i64):
p := m as i64*
p[2] = v
end
func _m_set_state(m: void*, v: void*):
p := m as i64*
p[3] = v as i64
end
func _m_set_keys(m: void*, v: void*):
p := m as i64*
p[4] = v as i64
end
func _m_set_vals(m: void*, v: void*):
p := m as i64*
p[5] = v as i64
end
func _m_hash(m: void*, key: i64): u64:
if _m_keykind(m) == 1:
bp := (key as void*) as i8*
mut h := 5381 as u64
mut j := 0
until bp[j] != 0:
mut c := bp[j] as int
if c < 0: c = c + 256 end
h = h * (33 as u64) + (c as u64)
j += 1
end
ret h
end
ret (key as u64) * (2654435761 as u64)
end
func _m_keq(m: void*, a: i64, b: i64): bool:
if _m_keykind(m) == 1:
ret _ptrstr(a) == _ptrstr(b)
end
ret a == b
end
func _m_find(m: void*, key: i64): i64:
cap := _m_cap(m)
st := _m_state(m)
keys := _m_keys(m)
h := _m_hash(m, key)
mut i := (h % (cap as u64)) as i64
mut free_slot := (0 - 1) as i64
repeat cap:
s := st[i]
if s == 0:
if free_slot != (0 - 1): ret free_slot * 2 end
ret i * 2
else s == 2:
if free_slot == (0 - 1): free_slot = i end
else:
if _m_keq(m, keys[i], key):
ret i * 2 + 1
end
end
i += 1
if i >= cap: i = 0 end
end
ret free_slot * 2
end
func _m_raw_insert(m: void*, key: i64, val: i64):
i := _m_find(m, key) / 2
st := _m_state(m)
keys := _m_keys(m)
vals := _m_vals(m)
st[i] = 1
keys[i] = key
vals[i] = val
_m_set_count(m, _m_count(m) + 1)
end
func _m_grow(m: void*):
oc := _m_cap(m)
ost := _m_state(m)
okeys := _m_keys(m)
ovals := _m_vals(m)
ncap := oc * 2
_m_set_cap(m, ncap)
_m_set_count(m, 0)
_m_set_state(m, mem.AllocateZeroed((ncap * 4) as u64))
_m_set_keys(m, mem.AllocateZeroed((ncap * 8) as u64))
_m_set_vals(m, mem.AllocateZeroed((ncap * 8) as u64))
repeat oc in idx:
if ost[idx] == 1:
_m_raw_insert(m, okeys[idx], ovals[idx])
end
end
mem.Free(ost as void*)
mem.Free(okeys as void*)
mem.Free(ovals as void*)
end
export:
func salam_map_new(key_kind: int, val_size: int): void*:
m := mem.AllocateZeroed(48 as u64)
mi32 := m as int*
mi32[0] = key_kind
mut vs := val_size
if vs <= 0: vs = 1 end
mi32[1] = vs
_m_set_cap(m, 16)
_m_set_count(m, 0)
_m_set_state(m, mem.AllocateZeroed((16 * 4) as u64))
_m_set_keys(m, mem.AllocateZeroed((16 * 8) as u64))
_m_set_vals(m, mem.AllocateZeroed((16 * 8) as u64))
ret m
end
func salam_map_put(m: void*, key: i64, val: i64):
if (_m_count(m) + 1) * 10 >= _m_cap(m) * 7:
_m_grow(m)
end
r := _m_find(m, key)
i := r / 2
st := _m_state(m)
keys := _m_keys(m)
vals := _m_vals(m)
if r % 2 == 0:
st[i] = 1
keys[i] = key
_m_set_count(m, _m_count(m) + 1)
end
vals[i] = val
end
func salam_map_get(m: void*, key: i64): i64:
r := _m_find(m, key)
if r % 2 == 0: ret 0 end
vals := _m_vals(m)
ret vals[r / 2]
end
func salam_map_has(m: void*, key: i64): int:
r := _m_find(m, key)
ret (r % 2) as int
end
func salam_map_remove(m: void*, key: i64): int:
r := _m_find(m, key)
if r % 2 == 0: ret 0 end
st := _m_state(m)
st[r / 2] = 2
_m_set_count(m, _m_count(m) - 1)
ret 1
end
func salam_map_size(m: void*): int:
ret _m_count(m) as int
end
end
func _it_map(it: void*): void*:
p := it as i64*
ret p[0] as void*
end
func _it_i(it: void*): i64:
p := it as i64*
ret p[1]
end
func _it_set_i(it: void*, v: i64):
p := it as i64*
p[1] = v
end
func _it_seek(it: void*):
m := _it_map(it)
cap := _m_cap(m)
st := _m_state(m)
mut i := _it_i(it)
until i < cap:
if st[i] == 1:
_it_set_i(it, i)
ret
end
i += 1
end
_it_set_i(it, cap)
end
export:
func salam_map_iter_new(m: void*): void*:
it := mem.AllocateZeroed(16 as u64)
p := it as i64*
p[0] = m as i64
p[1] = 0
_it_seek(it)
ret it
end
func salam_map_iter_valid(it: void*): int:
m := _it_map(it)
if _it_i(it) < _m_cap(m): ret 1 end
ret 0
end
func salam_map_iter_key(it: void*): i64:
m := _it_map(it)
keys := _m_keys(m)
ret keys[_it_i(it)]
end
func salam_map_iter_value(it: void*): i64:
m := _it_map(it)
vals := _m_vals(m)
ret vals[_it_i(it)]
end
func salam_map_iter_next(it: void*):
_it_set_i(it, _it_i(it) + 1)
_it_seek(it)
end
end
