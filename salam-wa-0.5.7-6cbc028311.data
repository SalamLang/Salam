package tls
const PK_UNKNOWN := 0
const PK_RSA := 1
const PK_EC_P256 := 2
const PK_EC_P384 := 3
const SIG_UNKNOWN := 0
const SIG_RSA_PKCS1_SHA256 := 1
const SIG_RSA_PKCS1_SHA384 := 2
const SIG_RSA_PKCS1_SHA512 := 3
const SIG_RSA_PSS_SHA256 := 4
const SIG_RSA_PSS_SHA384 := 5
const SIG_ECDSA_SHA256 := 6
const SIG_ECDSA_SHA384 := 7
const OID_RSA_ENCRYPTION := "2a864886f70d010101"
const OID_RSASSA_PSS := "2a864886f70d01010a"
const OID_SHA256_RSA := "2a864886f70d01010b"
const OID_SHA384_RSA := "2a864886f70d01010c"
const OID_SHA512_RSA := "2a864886f70d01010d"
const OID_EC_PUBLICKEY := "2a8648ce3d0201"
const OID_PRIME256V1 := "2a8648ce3d030107"
const OID_SECP384R1 := "2b81040022"
const OID_ECDSA_SHA256 := "2a8648ce3d040302"
const OID_ECDSA_SHA384 := "2a8648ce3d040303"
const OID_SHA256 := "608648016503040201"
const OID_SHA384 := "608648016503040202"
struct Cert:
pub tbs: Reader = Reader {}
pub serial: Reader = Reader {}
pub issuer: Reader = Reader {}
pub subject: Reader = Reader {}
pub subject_cn: str = ""
pub pk_alg: int = 0
pub rsa_n: Reader = Reader {}
pub rsa_e: Reader = Reader {}
pub ec_point: Reader = Reader {}
pub sig_alg: int = 0
pub sig: Reader = Reader {}
pub not_before: i64 = 0
pub not_after: i64 = 0
pub has_basic_constraints: bool = false
pub is_ca: bool = false
pub has_path_len: bool = false
pub path_len: int = 0
pub has_key_usage: bool = false
pub key_usage: int = 0
pub has_eku: bool = false
pub eku_server_auth: bool = false
pub san: Reader = Reader {}
pub has_san: bool = false
pub ok: bool = false
end
func _sig_alg_from_oid(o: Reader, params: Reader): int:
if _oid_is(o, OID_SHA256_RSA):
ret SIG_RSA_PKCS1_SHA256
end
if _oid_is(o, OID_SHA384_RSA):
ret SIG_RSA_PKCS1_SHA384
end
if _oid_is(o, OID_SHA512_RSA):
ret SIG_RSA_PKCS1_SHA512
end
if _oid_is(o, OID_ECDSA_SHA256):
ret SIG_ECDSA_SHA256
end
if _oid_is(o, OID_ECDSA_SHA384):
ret SIG_ECDSA_SHA384
end
if _oid_is(o, OID_RSASSA_PSS):
ret _pss_params_digest(params)
end
ret SIG_UNKNOWN
end
func _pss_params_digest(params: Reader): int:
mut p := params
mut s := _der_seq(p)
if p.bad:
ret SIG_UNKNOWN
end
if not _der_is(s, ASN1_CTX0):
ret SIG_UNKNOWN
end
t := _der_tag(s, ASN1_CTX0)
if not t.ok:
ret SIG_UNKNOWN
end
mut inner := t.body
mut hp := Reader {}
o := _der_algid(inner, hp)
if inner.bad:
ret SIG_UNKNOWN
end
if _oid_is(o, OID_SHA256):
ret SIG_RSA_PSS_SHA256
end
if _oid_is(o, OID_SHA384):
ret SIG_RSA_PSS_SHA384
end
ret SIG_UNKNOWN
end
func _sig_hash(alg: int): int:
if alg == SIG_RSA_PKCS1_SHA384 or alg == SIG_RSA_PSS_SHA384 or alg == SIG_ECDSA_SHA384:
ret HASH_SHA384
end
ret HASH_SHA256
end
func _parse_spki(spki: Reader, c &: Cert): bool:
mut s := spki
mut inner := _der_seq(s)
if s.bad:
ret false
end
mut params := Reader {}
o := _der_algid(inner, params)
if inner.bad:
ret false
end
key := _der_bitstring(inner, false)
if inner.bad:
ret false
end
if _oid_is(o, OID_RSA_ENCRYPTION):
mut k := key
mut ks := _der_seq(k)
if k.bad:
ret false
end
c.rsa_n = _der_uint(ks)
c.rsa_e = _der_uint(ks)
if ks.bad or _rdleft(ks) != 0:
ret false
end
if c.rsa_n.len < 128:
ret false
end
c.pk_alg = PK_RSA
ret true
end
if _oid_is(o, OID_EC_PUBLICKEY):
mut p := params
curve := _der_oid(p)
if p.bad:
ret false
end
if _oid_is(curve, OID_PRIME256V1):
if key.len != 65 or _rdat(key, 0) != 0x04:
ret false
end
c.ec_point = key
c.pk_alg = PK_EC_P256
ret true
end
if _oid_is(curve, OID_SECP384R1):
if key.len != 97 or _rdat(key, 0) != 0x04:
ret false
end
c.ec_point = key
c.pk_alg = PK_EC_P384
ret true
end
ret false
end
ret false
end
func _cert_parse(p: void*, n: int): Cert:
mut c := Cert {}
mut top := _newreader(p, n)
mut outer := _der_seq(top)
if top.bad:
ret c
end
if _rdleft(top) != 0:
ret c
end
tbs := _der_tag(outer, ASN1_SEQUENCE)
if not tbs.ok:
ret c
end
c.tbs = tbs.full
mut t := tbs.body
mut version := 1
if _der_is(t, ASN1_CTX0):
vt := _der_tag(t, ASN1_CTX0)
if not vt.ok:
ret c
end
mut vb := vt.body
vi := _der_uint(vb)
if vb.bad or vi.len != 1:
ret c
end
version = _rdat(vi, 0) + 1
end
if version != 3:
ret c
end
c.serial = _der_uint(t)
if t.bad:
ret c
end
ia := _der_tag(t, ASN1_SEQUENCE)
if not ia.ok:
ret c
end
mut ib := ia.body
inner_sig_oid := _der_oid(ib)
if ib.bad:
ret c
end
inner_params := _rdrest(ib)
inner_alg := _sig_alg_from_oid(inner_sig_oid, inner_params)
issuer := _der_tag(t, ASN1_SEQUENCE)
if not issuer.ok:
ret c
end
c.issuer = issuer.full
mut validity := _der_seq(t)
if t.bad:
ret c
end
nb := _der(validity)
na := _der(validity)
if not nb.ok or not na.ok or _rdleft(validity) != 0:
ret c
end
c.not_before = _parse_time(nb)
c.not_after = _parse_time(na)
if c.not_before == 0 or c.not_after == 0:
ret c
end
subject := _der_tag(t, ASN1_SEQUENCE)
if not subject.ok:
ret c
end
c.subject = subject.full
c.subject_cn = _name_cn(subject.full)
spki := _der_tag(t, ASN1_SEQUENCE)
if not spki.ok:
ret c
end
if not _parse_spki(spki.full, c):
ret c
end
if _der_is(t, ASN1_CTX1):
_der_skip(t)
end
if _der_is(t, ASN1_CTX2):
_der_skip(t)
end
if _der_is(t, ASN1_CTX3):
et := _der_tag(t, ASN1_CTX3)
if not et.ok:
ret c
end
if not _parse_extensions(et.body, c):
ret c
end
end
if t.bad or _rdleft(t) != 0:
ret c
end
oa := _der_tag(outer, ASN1_SEQUENCE)
if not oa.ok:
ret c
end
mut ob := oa.body
outer_oid := _der_oid(ob)
if ob.bad:
ret c
end
outer_params := _rdrest(ob)
c.sig_alg = _sig_alg_from_oid(outer_oid, outer_params)
if inner_alg != c.sig_alg:
ret c
end
if not _cteqrd(ia.full, oa.full):
ret c
end
c.sig = _der_bitstring(outer, false)
if outer.bad or _rdleft(outer) != 0:
ret c
end
c.ok = true
ret c
end
package tls
const KU_DIGITAL_SIGNATURE := 0x0080
const KU_KEY_ENCIPHERMENT := 0x0020
const KU_KEY_CERT_SIGN := 0x0004
const OID_CN := "550403"
const OID_EXT_SAN := "551d11"
const OID_EXT_BASIC_CONSTRAINTS := "551d13"
const OID_EXT_KEY_USAGE := "551d0f"
const OID_EXT_EXT_KEY_USAGE := "551d25"
const OID_EKU_SERVER_AUTH := "2b06010505070301"
func _t2(r: Reader, i: int): int:
a := _rdat(r, i)
b := _rdat(r, i + 1)
if a < 48 or a > 57 or b < 48 or b > 57:
ret 0 - 1
end
ret (a - 48) * 10 + (b - 48)
end
func _parse_time(t: Tlv): i64:
r := t.body
mut year := 0
mut off := 0
if t.tag == ASN1_UTCTIME:
if r.len != 13 or _rdat(r, 12) != 90:
ret 0
end
yy := _t2(r, 0)
if yy < 0:
ret 0
end
if yy < 50:
year = 2000 + yy
else:
year = 1900 + yy
end
off = 2
else if t.tag == ASN1_GENERALIZEDTIME:
if r.len != 15 or _rdat(r, 14) != 90:
ret 0
end
hi := _t2(r, 0)
lo := _t2(r, 2)
if hi < 0 or lo < 0:
ret 0
end
year = hi * 100 + lo
off = 4
else:
ret 0
end
mon := _t2(r, off)
day := _t2(r, off + 2)
hh := _t2(r, off + 4)
mm := _t2(r, off + 6)
ss := _t2(r, off + 8)
if mon < 1 or mon > 12 or day < 1 or day > 31 or hh > 23 or mm > 59 or ss > 60:
ret 0
end
mut v := year as i64
v = v * 100 + (mon as i64)
v = v * 100 + (day as i64)
v = v * 100 + (hh as i64)
v = v * 100 + (mm as i64)
v = v * 100 + (ss as i64)
ret v
end
func _name_cn(name: Reader): str:
mut n := name
mut seq := _der_seq(n)
if n.bad:
ret ""
end
mut out := ""
until _rdleft(seq) > 0 and not seq.bad:
rdn := _der_tag(seq, ASN1_SET)
if not rdn.ok:
ret out
end
mut set := rdn.body
until _rdleft(set) > 0 and not set.bad:
atv := _der_tag(set, ASN1_SEQUENCE)
if not atv.ok:
ret out
end
mut a := atv.body
o := _der_oid(a)
if a.bad:
ret out
end
v := _der(a)
if not v.ok:
ret out
end
if _oid_is(o, OID_CN):
out = _rd_to_str(v.body)
end
end
end
ret out
end
func _parse_extensions(exts: Reader, c &: Cert): bool:
mut e := exts
mut seq := _der_seq(e)
if e.bad:
ret false
end
until _rdleft(seq) > 0 and not seq.bad:
ext := _der_tag(seq, ASN1_SEQUENCE)
if not ext.ok:
ret false
end
mut x := ext.body
o := _der_oid(x)
if x.bad:
ret false
end
mut critical := false
if _der_is(x, ASN1_BOOLEAN):
b := _der_tag(x, ASN1_BOOLEAN)
if not b.ok or b.body.len != 1:
ret false
end
bv := _rdat(b.body, 0)
if bv != 0x00 and bv != 0xFF:
ret false
end
critical = bv != 0
end
val := _der_tag(x, ASN1_OCTETSTRING)
if not val.ok:
ret false
end
mut v := val.body
if _oid_is(o, OID_EXT_BASIC_CONSTRAINTS):
mut bs := _der_seq(v)
if v.bad:
ret false
end
c.has_basic_constraints = true
if _der_is(bs, ASN1_BOOLEAN):
b := _der_tag(bs, ASN1_BOOLEAN)
if not b.ok or b.body.len != 1:
ret false
end
c.is_ca = _rdat(b.body, 0) != 0
end
if _der_is(bs, ASN1_INTEGER):
pl := _der_uint(bs)
if bs.bad:
ret false
end
mut n := 0
repeat pl.len in i:
n = (n << 8) | _rdat(pl, i)
end
c.has_path_len = true
c.path_len = n
end
else if _oid_is(o, OID_EXT_KEY_USAGE):
bits := _der_bitstring(v, true)
if v.bad:
ret false
end
mut ku := 0
if bits.len > 0:
ku = _rdat(bits, 0) << 8
end
if bits.len > 1:
ku = ku | _rdat(bits, 1)
end
c.has_key_usage = true
c.key_usage = ku >> 8
else if _oid_is(o, OID_EXT_SAN):
c.san = v
c.has_san = true
else if _oid_is(o, OID_EXT_EXT_KEY_USAGE):
mut es := _der_seq(v)
if v.bad:
ret false
end
c.has_eku = true
until _rdleft(es) > 0 and not es.bad:
u := _der_oid(es)
if es.bad:
ret false
end
if _oid_is(u, OID_EKU_SERVER_AUTH):
c.eku_server_auth = true
end
end
else:
if critical:
ret false
end
end
end
ret true
end
@en "types"
@fa "نوع‌ها"
package types
import str
@en "TypeKindNull"
@fa "نوع خالی"
pub const TypeKindNull := 0
@en "TypeKindBool"
@fa "نوع منطقی"
pub const TypeKindBool := 1
@en "TypeKindInt"
@fa "نوع صحیح"
pub const TypeKindInt := 2
@en "TypeKindFloat"
@fa "نوع اعشاری"
pub const TypeKindFloat := 3
@en "TypeKindStr"
@fa "نوع رشته"
pub const TypeKindStr := 4
func _is_digit(c: str): bool:
code := char_code(c)
ret code >= 48 and code <= 57
end
func _is_sign(c: str): bool: ret c == "-" or c == "+" end
@en "IsInt"
@fa "صحیح است"
pub func IsInt(s: str): bool:
t := str.ToEnglishDigits(str.Trim(s))
n := t.len()
if n == 0: ret false end
mut i := 0
if _is_sign(t.substr(0, 1)):
i = 1
if n == 1: ret false end
end
until i < n:
if _is_digit(t.substr(i, 1)) == false: ret false end
i += 1
end
ret true
end
@en "IsFloat"
@fa "اعشاری است"
pub func IsFloat(s: str): bool:
t := str.Replace(str.ToEnglishDigits(str.Trim(s)), "٫", ".")
n := t.len()
if n == 0 or IsInt(t): ret false end
mut i := 0
mut seen_digit := false
mut seen_dot := false
mut seen_e := false
if _is_sign(t.substr(0, 1)): i = 1 end
until i < n:
c := t.substr(i, 1)
if _is_digit(c):
seen_digit = true
i += 1
else:
if c == "." and seen_dot == false and seen_e == false:
seen_dot = true
i += 1
else:
if (c == "e" or c == "E") and seen_e == false and seen_digit:
seen_e = true
i += 1
if i < n and _is_sign(t.substr(i, 1)): i += 1 end
else:
ret false
end
end
end
end
ret seen_digit and (seen_dot or seen_e)
end
@en "IsNumeric"
@fa "عددی است"
pub func IsNumeric(s: str): bool: ret IsInt(s) or IsFloat(s) end
@en "IsBool"
@fa "منطقی است"
pub func IsBool(s: str): bool:
t := str.Lower(str.Trim(s))
ret t == "true" or t == "false"
end
@en "KindOf"
@fa "نوعِ"
pub func KindOf(s: str): int:
if s.len() == 0: ret TypeKindNull end
if IsBool(s): ret TypeKindBool end
if IsInt(s): ret TypeKindInt end
if IsFloat(s): ret TypeKindFloat end
ret TypeKindStr
end
@en "KindName"
@fa "نام نوع"
pub func KindName(k: int): str:
if k == TypeKindNull: ret "null"
else k == TypeKindBool: ret "bool"
else k == TypeKindInt: ret "int"
else k == TypeKindFloat: ret "float"
else:
ret "string"
end
end
@en "Equal"
@fa "یکسان"
pub func Equal<T>(a: Vector<T>, b: Vector<T>): bool:
if a.len() != b.len(): ret false end
repeat a.len() in i:
if a.get(i) != b.get(i): ret false end
end
ret true
end
