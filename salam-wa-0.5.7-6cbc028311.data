func done_chain(c: Context, reason &: int): bool:
mut cur := c
until true:
s := cur.state
if s[0] != 0:
reason = 1
ret true
end
if s[2] != 0 and sync.NowMs() >= s[1]:
reason = 2
ret true
end
if cur.parent == null:
break
end
cur = cur.parent[0]
end
reason = 0
ret false
end
func nearest_deadline(c: Context): i64:
mut cur := c
mut best := 0 as i64
until true:
s := cur.state
if s[2] != 0:
if best == 0 or s[1] < best:
best = s[1]
end
end
if cur.parent == null:
break
end
cur = cur.parent[0]
end
ret best
end
func child_of(parent: Context, deadline: i64, has_deadline: bool): Context:
p := mem.AllocateZeroed(sizeof(Context) as u64) as Context*
p[0] = parent
st := mem.AllocateZeroed(24 as u64) as i64*
if has_deadline:
st[1] = deadline
st[2] = 1
end
ret Context { state = st, parent = p, mu = parent.mu, cv = parent.cv, is_root = false }
end
@en "Background"
@fa "پس زمینه"
pub func Background(): Context:
st := mem.AllocateZeroed(24 as u64) as i64*
ret Context {
state = st, parent = null, mu = sync.NewMutex(), cv = sync.NewCondVar(), is_root = true
}
end
@en "WithCancel"
@fa "با لغو"
pub func WithCancel(parent: Context): Context:
ret child_of(parent, 0 as i64, false)
end
@en "WithTimeout"
@fa "با مهلت"
pub func WithTimeout(parent: Context, ms: i64): Context:
ret child_of(parent, sync.NowMs() + ms, true)
end
@en "WithDeadline"
@fa "با موعد"
pub func WithDeadline(parent: Context, at_ms: i64): Context:
ret child_of(parent, at_ms, true)
end
@en "Cancel"
@fa "لغو"
pub func Cancel(c: Context):
s := c.state
sync.Lock(c.mu)
s[0] = 1
sync.Broadcast(c.cv)
sync.Unlock(c.mu)
end
@en "IsDone"
@fa "تمام شده"
pub func IsDone(c: Context): bool:
mut why := 0
sync.Lock(c.mu)
r := done_chain(c, why)
sync.Unlock(c.mu)
ret r
end
@en "Err"
@fa "خطا"
pub func Err(c: Context): str:
mut why := 0
sync.Lock(c.mu)
_ := done_chain(c, why)
sync.Unlock(c.mu)
if why == 1:
ret "cancelled"
end
if why == 2:
ret "deadline exceeded"
end
ret ""
end
@en "Deadline"
@fa "موعد"
pub func Deadline(c: Context): i64:
sync.Lock(c.mu)
d := nearest_deadline(c)
sync.Unlock(c.mu)
ret d
end
@en "Wait"
@fa "انتظار"
pub func Wait(c: Context, ms: i64): bool:
mut why := 0
sync.Lock(c.mu)
until_ms := sync.NowMs() + ms
mut fin := done_chain(c, why)
until not fin:
mut left := until_ms - sync.NowMs()
dl := nearest_deadline(c)
if dl > 0:
dleft := dl - sync.NowMs()
if dleft < left:
left = dleft
end
end
if left <= 0:
break
end
_ := sync.WaitCondTimeout(c.cv, c.mu, left)
fin = done_chain(c, why)
end
sync.Unlock(c.mu)
ret fin
end
@en "Free"
@fa "آزادسازی"
pub func Free(c: Context):
mem.Free(c.state as void*)
if c.parent != null:
mem.Free(c.parent as void*)
end
if c.is_root:
sync.DestroyCondVar(c.cv)
sync.Destroy(c.mu)
end
end
@en "db"
@fa "دیتابیس"
package db
@en "SQLITE"
@fa "اس کیو لایت"
pub const SQLITE := "sqlite"
@en "MYSQL"
@fa "مای اس کیو ال"
pub const MYSQL := "mysql"
@en "POSTGRES"
@fa "پستگرس"
pub const POSTGRES := "postgres"
@en "ELASTICSEARCH"
@fa "الستیک سرچ"
pub const ELASTICSEARCH := "elasticsearch"
@en "OPENSEARCH"
@fa "اپن سرچ"
pub const OPENSEARCH := "opensearch"
@en "TYPE_NULL"
@fa "نوع خالی"
pub const TYPE_NULL := 0
@en "TYPE_INT"
@fa "نوع صحیح"
pub const TYPE_INT := 1
@en "TYPE_FLOAT"
@fa "نوع اعشاری"
pub const TYPE_FLOAT := 2
@en "TYPE_TEXT"
@fa "نوع متن"
pub const TYPE_TEXT := 3
@en "TYPE_BLOB"
@fa "نوع دودویی"
pub const TYPE_BLOB := 4
@en "Rows"
@fa "ردیف ها"
pub interface Rows:
@en "Ok"
@fa "معتبر"
func Ok(): bool
@en "Next"
@fa "بعدی"
func Next(): bool
@en "ColumnCount"
@fa "تعداد ستون"
func ColumnCount(): int
@en "ColumnName"
@fa "نام ستون"
func ColumnName(col: int): str
@en "ColumnType"
@fa "نوع ستون"
func ColumnType(col: int): int
@en "IsNull"
@fa "خالی است"
func IsNull(col: int): bool
@en "Text"
@fa "متن"
func Text(col: int): str
@en "Int"
@fa "عدد صحیح"
func Int(col: int): int
@en "Int64"
@fa "عدد صحیح۶۴"
func Int64(col: int): i64
@en "Float"
@fa "عدد اعشار"
func Float(col: int): f64
@en "Close"
@fa "بستن"
func Close(): int
end
@en "Tx"
@fa "تراکنش"
pub interface Tx:
@en "Ok"
@fa "معتبر"
func Ok(): bool
@en "Exec"
@fa "اجرا"
func Exec(sql: str): int
@en "Query"
@fa "پرسمان"
func Query(sql: str): dyn Rows
@en "Commit"
@fa "ثبت تراکنش"
func Commit(): int
@en "Rollback"
@fa "بازگردانی"
func Rollback(): int
end
@en "Connection"
@fa "اتصال"
pub interface Connection:
@en "Kind"
@fa "نوع"
func Kind(): str
@en "Ok"
@fa "معتبر"
func Ok(): bool
@en "Ping"
@fa "پینگ"
func Ping(): bool
@en "Exec"
@fa "اجرا"
func Exec(sql: str): int
@en "Query"
@fa "پرسمان"
func Query(sql: str): dyn Rows
@en "Begin"
@fa "شروع تراکنش"
func Begin(): dyn Tx
@en "LastInsertId"
@fa "شناسه آخرین درج"
func LastInsertId(): i64
@en "Changes"
@fa "تعداد تغییرات"
func Changes(): i64
@en "Error"
@fa "خطا"
func Error(): str
@en "Quote"
@fa "نقل قول"
func Quote(s: str): str
@en "Close"
@fa "بستن"
func Close(): int
end
@en "QueryInt"
@fa "پرسمان عدد"
pub func QueryInt(c: dyn Connection, sql: str): int:
r := c.Query(sql)
mut out := 0
if r.Ok():
if r.Next():
out = r.Int(0)
end
r.Close()
end
ret out
end
@en "QueryInt64"
@fa "پرسمان عدد۶۴"
pub func QueryInt64(c: dyn Connection, sql: str): i64:
r := c.Query(sql)
mut out := 0 as i64
if r.Ok():
if r.Next():
out = r.Int64(0)
end
r.Close()
end
ret out
end
@en "QueryFloat"
@fa "پرسمان اعشار"
pub func QueryFloat(c: dyn Connection, sql: str): f64:
r := c.Query(sql)
mut out := 0.0
if r.Ok():
if r.Next():
out = r.Float(0)
end
r.Close()
end
ret out
end
@en "QueryText"
@fa "پرسمان متن"
pub func QueryText(c: dyn Connection, sql: str): str:
r := c.Query(sql)
mut out := ""
if r.Ok():
if r.Next():
out = r.Text(0)
end
r.Close()
end
ret out
end
@en "CountRows"
@fa "شمارش ردیف ها"
pub func CountRows(c: dyn Connection, sql: str): int:
r := c.Query(sql)
mut n := 0
if r.Ok():
until r.Next():
n = n + 1
end
r.Close()
end
ret n
end
@en "Run"
@fa "اجرا کن"
pub func Run(c: dyn Connection, sql: str): bool:
ret c.Exec(sql) == 0
end
@en "RunAll"
@fa "اجرای همه"
pub func RunAll(c: dyn Connection, stmts: Vector<str>): int:
mut done := 0
mut i := 0
until i < stmts.len():
if c.Exec(stmts.get(i)) != 0:
ret done
end
done = done + 1
i = i + 1
end
ret done
end
@en "InTx"
@fa "در تراکنش"
pub func InTx(c: dyn Connection, stmts: Vector<str>): bool:
t := c.Begin()
if not t.Ok():
ret false
end
mut i := 0
until i < stmts.len():
if t.Exec(stmts.get(i)) != 0:
t.Rollback()
ret false
end
i = i + 1
end
ret t.Commit() == 0
end
@en "QuoteLiteral"
@fa "نقل قول"
pub func QuoteLiteral(s: str): str:
mut out := "'"
mut i := 0
until i < len(s):
ch := s[i]
if ch == '\'':
out = out + "''"
else:
out = out + ch
end
i = i + 1
end
ret out + "'"
end
package db
import conv
@en "MIGRATION_TABLE"
@fa "جدول مهاجرت"
pub const MIGRATION_TABLE := "schema_migrations"
@en "Migration"
@fa "مهاجرت"
pub struct Migration:
pub version: int = 0
pub name: str = ""
pub up: str = ""
pub down: str = ""
end
@en "Migrator"
@fa "مهاجرت گر"
pub struct Migrator:
pub items: Vector<Migration>
pub table: str = ""
end
func _TrimSpace(s: str): str:
mut start := 0
mut stop := len(s)
until start < stop and _IsSpace(s[start]):
start = start + 1
end
until stop > start and _IsSpace(s[stop - 1]):
stop = stop - 1
end
mut out := ""
mut i := start
until i < stop:
out = out + s[i]
i = i + 1
end
ret out
end
func _IsSpace(c: char): bool:
ret c == ' ' or c == '\t' or c == '\n' or c == '\r'
end
func _ApplyUp(m: Migrator, c: dyn Connection, step: Migration): bool:
stmts := SplitStatements(step.up)
defer stmts.free()
stmts.push(
"INSERT INTO " + m.table + " (version, name, applied_at) VALUES (" + conv.FormatInt(step.version as i64) + ", " + QuoteLiteral(step.name) + ", CURRENT_TIMESTAMP)"
)
ret InTx(c, stmts)
end
func _ApplyDown(m: Migrator, c: dyn Connection, step: Migration): bool:
if step.down == "":
ret false
end
stmts := SplitStatements(step.down)
defer stmts.free()
stmts.push("DELETE FROM " + m.table + " WHERE version = " + conv.FormatInt(step.version as i64))
ret InTx(c, stmts)
end
@en "NewMigrator"
@fa "مهاجرت گر جدید"
pub func NewMigrator(): Migrator:
ret Migrator { items = Vector {} as Vector<Migration>, table = MIGRATION_TABLE }
end
@en "NewMigratorIn"
@fa "مهاجرت گر در"
pub func NewMigratorIn(table: str): Migrator:
ret Migrator { items = Vector {} as Vector<Migration>, table = table }
end
@en "FreeMigrator"
@fa "آزادکردن مهاجرت گر"
pub func FreeMigrator(m &: Migrator):
m.items.free()
end
@en "AddMigration"
@fa "افزودن مهاجرت"
pub func AddMigration(m &: Migrator, version: int, name: str, up: str, down: str):
step := Migration { version = version, name = name, up = up, down = down }
mut i := 0
until i < m.items.len():
if m.items.get(i).version > version:
m.items.insert(i, step)
ret
end
i = i + 1
end
m.items.push(step)
end
@en "MigrationCount"
@fa "تعداد مهاجرت"
pub func MigrationCount(m: Migrator): int: ret m.items.len() end
@en "SplitStatements"
@fa "جداکردن دستورها"
pub func SplitStatements(sql: str): Vector<str>:
mut out := Vector {} as Vector<str>
mut cur := ""
mut inquote := false
mut i := 0
until i < len(sql):
ch := sql[i]
if ch == '\'':
inquote = not inquote
cur = cur + ch
else:
if ch == ';' and not inquote:
trimmed := _TrimSpace(cur)
if trimmed != "":
out.push(trimmed)
end
cur = ""
else:
cur = cur + ch
end
end
i = i + 1
end
last := _TrimSpace(cur)
if last != "":
out.push(last)
end
ret out
end
@en "EnsureTable"
@fa "ساخت جدول"
pub func EnsureTable(m: Migrator, c: dyn Connection): int:
ret c.Exec(
"CREATE TABLE IF NOT EXISTS " + m.table + " (version INTEGER PRIMARY KEY, name TEXT NOT NULL, applied_at TEXT NOT NULL)"
)
end
@en "SchemaVersion"
@fa "نسخه طرح‌واره"
pub func SchemaVersion(m: Migrator, c: dyn Connection): int:
EnsureTable(m, c)
ret QueryInt(c, "SELECT COALESCE(MAX(version), 0) FROM " + m.table)
end
@en "IsApplied"
@fa "اعمال شده"
pub func IsApplied(m: Migrator, c: dyn Connection, version: int): bool:
EnsureTable(m, c)
ret QueryInt(
c, "SELECT COUNT(*) FROM " + m.table + " WHERE version = " + conv.FormatInt(version as i64)
) > 0
end
@en "PendingCount"
@fa "تعداد در انتظار"
pub func PendingCount(m: Migrator, c: dyn Connection): int:
at := SchemaVersion(m, c)
mut n := 0
mut i := 0
until i < m.items.len():
if m.items.get(i).version > at:
n = n + 1
end
i = i + 1
end
ret n
end
@en "MigrateUp"
@fa "مهاجرت به بالا"
pub func MigrateUp(m: Migrator, c: dyn Connection): int:
at := SchemaVersion(m, c)
mut done := 0
mut i := 0
until i < m.items.len():
step := m.items.get(i)
if step.version > at:
if not _ApplyUp(m, c, step):
ret done
end
done = done + 1
end
i = i + 1
end
ret done
end
@en "Rollback"
@fa "بازگردانی"
pub func Rollback(m: Migrator, c: dyn Connection): bool:
at := SchemaVersion(m, c)
if at == 0:
ret false
end
mut i := m.items.len() - 1
until i >= 0:
step := m.items.get(i)
if step.version == at:
ret _ApplyDown(m, c, step)
end
i = i - 1
end
ret false
end
@en "MigrateTo"
@fa "مهاجرت به"
pub func MigrateTo(m: Migrator, c: dyn Connection, target: int): int:
mut moved := 0
mut at := SchemaVersion(m, c)
until at < target:
mut i := 0
mut ran := false
until i < m.items.len():
step := m.items.get(i)
if step.version > at and step.version <= target:
if not _ApplyUp(m, c, step):
ret moved
end
moved = moved + 1
ran = true
i = m.items.len()
else:
i = i + 1
end
end
if not ran:
ret moved
end
at = SchemaVersion(m, c)
end
until at > target:
if not Rollback(m, c):
ret moved
end
moved = moved + 1
at = SchemaVersion(m, c)
end
ret moved
end
