mut n := 0
if v == 0:
n = 1
else:
until v > 0:
d[n] = v % 10
v = v / 10
n += 1
end
end
if n < 2:
n = 2
end
mut i := n - 1
until i >= 0:
pos = _put(buf, cap, pos, (48 + d[i]) as u8)
i -= 1
end
ret pos
end
func _digit_at(digits: u8*, ndig: int, i: int): u8:
