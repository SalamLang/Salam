@en "pool"
@fa "استخر"
package pool
import mem
import sync
import thread
if SALAM_OS_WINDOWS:
extern:
func GetSystemInfo(info: void*)
end
else:
extern:
func sysconf(name: int): i64
end
end
struct Range:
pub body: func (i64) = (i: i64): end
pub next: i64* = null
pub n: i64 = 0
pub mu: sync.Mutex = sync.Mutex {}
end
func range_worker(rp: Range*):
r := rp[0]
c := r.next
until true:
sync.Lock(r.mu)
i := c[0]
c[0] = i + 1
sync.Unlock(r.mu)
if i >= r.n:
break
end
r.body(i)
end
end
if SALAM_OS_WINDOWS:
func cpu_count_os(): i64:
buf := mem.AllocateZeroed(96 as u64)
GetSystemInfo(buf)
p := ((buf as i64) + 32) as i32*
n := p[0] as i64
mem.Free(buf)
ret n
end
else:
if defined(SALAM_OS_BSD):
func cpu_count_os(): i64: ret sysconf(58) end
else:
func cpu_count_os(): i64: ret sysconf(84) end
end
end
@en "CPUCount"
@fa "تعداد پردازنده"
pub func CPUCount(): i64:
n := cpu_count_os()
if n < 1:
ret 1
end
ret n
end
@en "ParallelFor"
@fa "برای موازی"
pub func ParallelFor(n: i64, workers: i64, body: func (i64)):
if n <= 0:
ret
end
mut w := workers
if w < 1: w = 1 end
if w > n: w = n end
rp := mem.AllocateZeroed(sizeof(Range) as u64) as Range*
c := mem.AllocateZeroed(8 as u64) as i64*
rp[0] = Range { body = body, next = c, n = n, mu = sync.NewMutex() }
mut ts := Vector {} as Vector<thread.Thread>
mut k := 0 as i64
until k < w:
ts = thread.Collect(ts, spawn(range_worker, rp))
k = k + 1
end
thread.JoinAll(ts)
ts.free()
sync.Destroy(rp[0].mu)
mem.Free(c as void*)
mem.Free(rp as void*)
end
@en "ParallelForAuto"
@fa "برای موازی خودکار"
pub func ParallelForAuto(n: i64, body: func (i64)):
ParallelFor(n, CPUCount(), body)
end
@en "rand"
@fa "تصادفی"
package rand
import time
import str
mut _g_state := 0 as u64
mut _g_seeded := 0
func _pcg_step():
_g_state = _g_state * (6364136223846793005 as u64) + (1442695040888963407 as u64)
end
func _ensure_seeded():
if _g_seeded == 0:
rand_seed(time.Now())
end
end
func rand_seed(s: i64):
_g_state = (s as u64) + (1442695040888963407 as u64)
_pcg_step()
_g_seeded = 1
end
func rand_int32(): int:
_ensure_seeded()
_pcg_step()
h := _g_state / (4294967296 as u64)
ret (h % (2147483648 as u64)) as int
end
func rand_int64(): i64:
_ensure_seeded()
_pcg_step()
hi := _g_state / (4294967296 as u64) % (2147483648 as u64)
_pcg_step()
lo := _g_state / (4294967296 as u64)
ret (hi * (4294967296 as u64) + lo) as i64
end
func rand_float64(): f64:
n := rand_int64()
n53 := n % 9007199254740992
ret n53 as f64 / 9007199254740992.0
end
func rand_bytes(n: int): str:
if n <= 0: ret "" end
mut sb := str.NewBuilder()
defer str.BufFree(sb)
repeat n:
str.BufAppendChar(sb, rand_int32() % 255 + 1)
end
out := str.BufStr(sb)
ret out
end
func _hex_digit(d: int): int:
if d < 10: ret d + 48 end
ret d + 87
end
func hex_bytes(n: int): str:
mut sb := str.NewBuilder()
defer str.BufFree(sb)
repeat n:
b := rand_int32() % 256
str.BufAppendChar(sb, _hex_digit(b / 16))
str.BufAppendChar(sb, _hex_digit(b % 16))
end
out := str.BufStr(sb)
ret out
end
@en "Seed"
@fa "بذر"
pub func Seed(s: i64):
rand_seed(s)
end
@en "SeedAuto"
@fa "بذر خودکار"
pub func SeedAuto():
rand_seed(time.Now())
end
@en "Int"
@fa "عدد تصادفی"
pub func Int(): i64:
ret rand_int64()
end
@en "Int32"
@fa "عدد۳۲بیتی"
pub func Int32(): int:
ret rand_int32()
end
@en "IntN"
@fa "عدد کمتر از ان"
