@en "PageBegin"
@fa "آغاز صفحه"
pub func PageBegin(): str.StringBuilder:
ret str.NewBuilder()
end
@en "PageEnd"
@fa "پایان صفحه"
pub func PageEnd(b &: str.StringBuilder): str:
out := str.BufStr(b)
str.BufFree(b)
ret out
end
@en "PageStatic"
@fa "بخش ثابت صفحه"
pub func PageStatic(b &: str.StringBuilder, s: str):
