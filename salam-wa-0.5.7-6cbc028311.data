func recv(s: int, buf: void*, len: int, flags: int): int
func sendto(s: int, buf: void*, len: int, flags: int, addr: void*, addrlen: int): int
func recvfrom(s: int, buf: void*, len: int, flags: int, addr: void*, addrlen: void*): int
func close(s: int): int
func shutdown(s: int, how: int): int
func setsockopt(s: int, level: int, optname: int, optval: void*, optlen: int): int
func getsockname(s: int, addr: void*, addrlen: void*): int
func fcntl(s: int, cmd: int, ...): int
func getaddrinfo(node: str, service: str, hints: void*, res: void*): int
func freeaddrinfo(res: void*)
func gethostbyname(name: str): void*
func poll(fds: void*, nfds: usize, timeout: int): int
end
end
if SALAM_OS_WINDOWS:
const _SEND_FLAGS := 0
else SALAM_OS_MAC:
const _SEND_FLAGS := 0
else SALAM_OS_FREEBSD:
const _SEND_FLAGS := 131072
else SALAM_OS_OPENBSD or SALAM_OS_NETBSD:
const _SEND_FLAGS := 1024
else:
const _SEND_FLAGS := 16384
end
@en "AF_INET"
@fa "خانواده آی‌پی۴"
pub const AF_INET := 2
@en "SOCK_STREAM"
@fa "سوکت جریانی"
pub const SOCK_STREAM := 1
@en "SOCK_DGRAM"
@fa "سوکت داده‌نگاری"
pub const SOCK_DGRAM := 2
if SALAM_OS_WINDOWS:
@en "AF_INET6"
@fa "خانواده آی‌پی۶"
pub const AF_INET6 := 23
else SALAM_OS_MAC:
@en "AF_INET6"
@fa "خانواده آی‌پی۶"
pub const AF_INET6 := 30
else SALAM_OS_FREEBSD:
@en "AF_INET6"
@fa "خانواده آی‌پی۶"
pub const AF_INET6 := 28
else SALAM_OS_OPENBSD or SALAM_OS_NETBSD:
@en "AF_INET6"
@fa "خانواده آی‌پی۶"
pub const AF_INET6 := 24
else:
@en "AF_INET6"
@fa "خانواده آی‌پی۶"
pub const AF_INET6 := 10
end
@en "ShutRd"
@fa "بستن خواندن"
pub const ShutRd := 0
@en "ShutWr"
@fa "بستن نوشتن"
pub const ShutWr := 1
@en "ShutRdWr"
@fa "بستن دوطرفه"
pub const ShutRdWr := 2
const _SHUT_BOTH := 2
if SALAM_OS_WINDOWS:
mut _rawsock_wsa_init := 0
end
@en "Socket"
@fa "سوکت"
pub struct Socket:
pub fd: i64 = 0 - 1
pub family: int = AF_INET
end
if SALAM_OS_WINDOWS:
func _net_init():
if _rawsock_wsa_init == 0:
wsa := mem.Allocate(512 as u64)
WSAStartup(514, wsa)
mem.Free(wsa)
_rawsock_wsa_init = 1
end
end
end
func _sk(fd: i64): usize:
ret fd as usize
end
func _fd_of(s: usize): i64:
if s == (0 - 1) as usize: ret 0 - 1 end
ret s as i64
end
func _hostent_addr4(he: void*): int:
listp := (he as i64 + 24) as i64*
list := listp[0]
if list == 0: ret 0 end
addrp := list as i64*
addr := addrp[0]
if addr == 0: ret 0 end
bytes := addr as int*
ret bytes[0]
end
func _resolve_addr4(host: str): int:
he := gethostbyname(host)
if he == null: ret 0 end
ret _hostent_addr4(he)
end
func _make_sa4(h_addr: int, port: int): void*:
sa := mem.Allocate(16 as u64)
memset(sa, 0, 16 as u64)
sa32 := sa as int*
port_n := htons(port)
packed := (port_n as i64) * 65536 + AF_INET
sa32[0] = packed as int
sa32[1] = h_addr
ret sa
end
func _ai_family(ai: void*): int: ret ((ai as i64 + 4) as int*)[0] end
func _ai_addrlen(ai: void*): i64:
if SALAM_OS_WINDOWS:
ret ((ai as i64 + 16) as i64*)[0]
else:
ret ((ai as i64 + 16) as int*)[0]
end
end
func _ai_addr(ai: void*): void*:
if SALAM_OS_LINUX:
ret ((ai as i64 + 24) as i64*)[0] as void*
else:
ret ((ai as i64 + 32) as i64*)[0] as void*
end
end
func _ai_next(ai: void*): void*: ret ((ai as i64 + 40) as i64*)[0] as void* end
func _try_connect(sa: void*, alen: int, fam: int, socktype: int): Socket:
if SALAM_OS_WINDOWS:
s := _fd_of(socket(fam, socktype, 0))
if s == (0 - 1 as i64):
ret Socket { fd = 0 - 1, family = fam }
end
if connect(_sk(s), sa, alen) != 0:
closesocket(_sk(s))
ret Socket { fd = 0 - 1, family = fam }
end
ret Socket { fd = s, family = fam }
else:
s := socket(fam, socktype, 0)
if s == 0 - 1:
ret Socket { fd = 0 - 1, family = fam }
end
if connect(s, sa, alen) != 0:
close(s)
ret Socket { fd = 0 - 1, family = fam }
end
_no_sigpipe(s as i64)
ret Socket { fd = s as i64, family = fam }
end
end
func _resolve_all(host: str, port: int, addrs &: Vector<i64>, lens &: Vector<int>, fams &: Vector<int>):
hints := mem.Allocate(48 as u64)
defer mem.Free(hints)
memset(hints, 0, 48 as u64)
hp := hints as int*
hp[2] = SOCK_STREAM
res_slot := mem.Allocate(8 as u64)
defer mem.Free(res_slot)
rp := res_slot as i64*
rp[0] = 0
port_str := str.FromInt(port as i64)
if getaddrinfo(host, port_str, hints, res_slot) != 0:
ret
end
res := rp[0] as void*
if res == null:
ret
end
defer freeaddrinfo(res)
mut cur := res
until cur != null:
mut alen := 0
sa := _copy_sockaddr(cur, alen)
addrs.push(sa as i64)
lens.push(alen)
fams.push(_ai_family(cur))
cur = _ai_next(cur)
end
end
func _copy_sockaddr(ai: void*, out_len &: int): void*:
alen := _ai_addrlen(ai) as int
addr := _ai_addr(ai)
out := mem.Allocate(alen as u64)
memcpy(out, addr, alen as u64)
out_len = alen
ret out
end
func _no_sigpipe(fd: i64):
if fd < 0:
ret
end
if SALAM_OS_MAC:
opt := mem.Allocate(4 as u64)
defer mem.Free(opt)
o32 := opt as int*
o32[0] = 1
setsockopt(fd as int, 65535, 4130, opt, 4)
end
end
@en "FromFd"
@fa "سوکت از توصیف‌گر"
pub func FromFd(fd: i64): Socket:
ret Socket { fd = fd, family = AF_INET }
end
@en "Open"
@fa "باز کردن سوکت"
pub func Open(family: int, socktype: int): Socket:
if SALAM_OS_WINDOWS:
_net_init()
end
if SALAM_OS_WINDOWS:
s := _fd_of(socket(family, socktype, 0))
ret Socket { fd = s, family = family }
else:
s := socket(family, socktype, 0)
_no_sigpipe(s as i64)
ret Socket { fd = s as i64, family = family }
end
end
@en "Connect"
@fa "اتصال"
pub func Connect(host: str, port: int): Socket:
ret ConnectProto(host, port, SOCK_STREAM)
end
@en "ConnectProto"
@fa "اتصال با نوع"
pub func ConnectProto(host: str, port: int, socktype: int): Socket:
if SALAM_OS_WINDOWS:
_net_init()
end
mut addrs := Vector {} as Vector<i64>
mut lens := Vector {} as Vector<int>
mut fams := Vector {} as Vector<int>
_resolve_all(host, port, addrs, lens, fams)
mut out := Socket { fd = 0 - 1, family = AF_INET }
repeat addrs.len() in i:
if out.fd < 0:
out = _try_connect(addrs.get(i) as void*, lens.get(i), fams.get(i), socktype)
end
mem.Free(addrs.get(i) as void*)
end
addrs.free()
lens.free()
fams.free()
ret out
end
@en "ListenOn"
@fa "شنود روی"
pub func ListenOn(host: str, port: int, socktype: int): Socket:
if SALAM_OS_WINDOWS:
_net_init()
end
mut h_addr := 0
if host.len() > 0 and host != "0.0.0.0" and host != "::":
h_addr = _resolve_addr4(host)
if h_addr == 0:
ret Socket { fd = 0 - 1, family = AF_INET }
end
end
if SALAM_OS_WINDOWS:
s := _fd_of(socket(AF_INET, socktype, 0))
if s == (0 - 1 as i64): ret Socket { fd = 0 - 1, family = AF_INET } end
opt := mem.Allocate(4 as u64)
defer mem.Free(opt)
mut opt32 := opt as int*
opt32[0] = 1
setsockopt(_sk(s), 65535, 4, opt, 4)
sa := _make_sa4(h_addr, port)
defer mem.Free(sa)
if bind(_sk(s), sa, 16) != 0:
closesocket(_sk(s))
ret Socket { fd = 0 - 1, family = AF_INET }
end
if socktype == SOCK_STREAM:
if listen(_sk(s), 128) != 0:
closesocket(_sk(s))
ret Socket { fd = 0 - 1, family = AF_INET }
end
end
ret Socket { fd = s, family = AF_INET }
else:
s := socket(AF_INET, socktype, 0)
if s == 0 - 1: ret Socket { fd = 0 - 1, family = AF_INET } end
opt := mem.Allocate(4 as u64)
defer mem.Free(opt)
opt32 := opt as int*
opt32[0] = 1
if SALAM_OS_BSD:
setsockopt(s, 65535, 4, opt, 4)
else:
setsockopt(s, 1, 2, opt, 4)
end
sa := _make_sa4(h_addr, port)
defer mem.Free(sa)
if bind(s, sa, 16) != 0:
close(s)
ret Socket { fd = 0 - 1, family = AF_INET }
end
if socktype == SOCK_STREAM:
if listen(s, 128) != 0:
close(s)
ret Socket { fd = 0 - 1, family = AF_INET }
end
end
ret Socket { fd = s as i64, family = AF_INET }
end
end
@en "Listen"
@fa "شنود"
pub func Listen(port: int): Socket:
ret ListenOn("", port, SOCK_STREAM)
end
@en "LocalPort"
@fa "درگاه محلی"
pub func LocalPort(s: Socket): int:
buf := mem.Allocate(16 as u64)
defer mem.Free(buf)
lenbuf := mem.Allocate(4 as u64)
defer mem.Free(lenbuf)
lenbuf32 := lenbuf as int*
lenbuf32[0] = 16
mut ok := 0 - 1
if SALAM_OS_WINDOWS:
ok = getsockname(_sk(s.fd), buf, lenbuf)
else:
ok = getsockname(s.fd as int, buf, lenbuf)
end
if ok != 0: ret 0 end
bp := buf as i8*
mut hi := bp[2] as int
mut lo := bp[3] as int
if hi < 0: hi += 256 end
if lo < 0: lo += 256 end
ret hi * 256 + lo
end
@en "Accept"
@fa "پذیرش"
pub func Accept(server: Socket): Socket:
if SALAM_OS_WINDOWS:
c := _fd_of(accept(_sk(server.fd), null, null))
if c == (0 - 1 as i64): ret Socket { fd = 0 - 1, family = server.family } end
ret Socket { fd = c, family = server.family }
else:
c := accept(server.fd as int, null, null)
if c == 0 - 1: ret Socket { fd = 0 - 1, family = server.family } end
_no_sigpipe(c as i64)
ret Socket { fd = c as i64, family = server.family }
end
end
@en "Send"
@fa "ارسال"
pub func Send(sock: Socket, data: str): int:
n := data.len()
ptr := data as void*
mut sent := 0
until sent < n:
mut r := 0
if SALAM_OS_WINDOWS:
r = send(_sk(sock.fd), (ptr as i64 + sent) as void*, n - sent, _SEND_FLAGS)
else:
r = send(sock.fd as int, (ptr as i64 + sent) as void*, n - sent, _SEND_FLAGS)
end
if r <= 0:
if sent > 0: ret sent end
ret r
end
sent += r
end
ret sent
end
@en "SendBytes"
@fa "ارسال بایت"
pub func SendBytes(sock: Socket, ptr: void*, n: int): int:
if SALAM_OS_WINDOWS:
mut sent := 0
until sent < n:
r := send(_sk(sock.fd), (ptr as i64 + sent) as void*, n - sent, _SEND_FLAGS)
if r <= 0: ret sent end
sent += r
end
ret sent
else:
mut sent := 0
until sent < n:
r := send(sock.fd as int, (ptr as i64 + sent) as void*, n - sent, _SEND_FLAGS)
if r <= 0: ret sent end
sent += r
end
ret sent
end
end
@en "Recv"
@fa "دریافت"
pub func Recv(sock: Socket, max: int): str:
mut m := max
if m <= 0: m = 4096 end
buf := mem.Allocate((m + 1) as u64)
defer mem.Free(buf)
memset(buf, 0, (m + 1) as u64)
if SALAM_OS_WINDOWS:
recv(_sk(sock.fd), buf, m, 0)
else:
recv(sock.fd as int, buf, m, 0)
end
ret str.Clone(buf as str)
end
@en "RecvBytes"
@fa "دریافت بایت"
pub func RecvBytes(sock: Socket, buf: void*, max: int): int:
if SALAM_OS_WINDOWS:
ret recv(_sk(sock.fd), buf, max, 0)
else:
ret recv(sock.fd as int, buf, max, 0)
end
end
@en "Shutdown"
@fa "خاموش کردن"
pub func Shutdown(sock: Socket):
if sock.fd < 0: ret end
if SALAM_OS_WINDOWS:
shutdown(_sk(sock.fd), _SHUT_BOTH)
else:
shutdown(sock.fd as int, _SHUT_BOTH)
end
end
@en "Close"
@fa "بستن"
pub func Close(sock: Socket):
if sock.fd < 0: ret end
if SALAM_OS_WINDOWS:
closesocket(_sk(sock.fd))
else:
close(sock.fd as int)
end
end
@en "Ok"
@fa "معتبر"
pub func Ok(sock: Socket): bool:
ret sock.fd >= 0
end
@en "Resolve"
@fa "تفکیک نشانی"
pub func Resolve(host: str): str:
if SALAM_OS_WINDOWS:
_net_init()
end
addr := _resolve_addr4(host)
if addr == 0: ret "" end
ret str.Clone(inet_ntoa(addr))
end
@en "ResolveAddr4Raw"
@fa "نشانی خام آی‌پی۴"
pub func ResolveAddr4Raw(host: str): int:
if SALAM_OS_WINDOWS:
_net_init()
end
ret _resolve_addr4(host)
end
@en "SetNonBlocking"
@fa "تنظیم حالت غیرمسدود"
pub func SetNonBlocking(sock: Socket, enable: bool):
if SALAM_OS_WINDOWS:
mode := mem.Allocate(4 as u64)
defer mem.Free(mode)
m32 := mode as int*
if enable: m32[0] = 1 else:
m32[0] = 0
end
ioctlsocket(_sk(sock.fd), 0 - 2147195266, mode)
else:
mut flags := fcntl(sock.fd as int, 3, 0)
if flags < 0: ret end
mut nb := 2048
if SALAM_OS_MAC or SALAM_OS_BSD:
nb = 4
end
if enable:
flags = flags | nb
else:
flags = flags & (0 - nb - 1)
end
fcntl(sock.fd as int, 4, flags)
end
end
@en "SetTimeout"
@fa "تنظیم مهلت زمانی"
pub func SetTimeout(sock: Socket, millis: int):
if SALAM_OS_WINDOWS:
t := mem.Allocate(4 as u64)
defer mem.Free(t)
t32 := t as int*
t32[0] = millis
setsockopt(_sk(sock.fd), 65535, 4102, t, 4)
setsockopt(_sk(sock.fd), 65535, 4101, t, 4)
else:
tv := mem.Allocate(16 as u64)
defer mem.Free(tv)
memset(tv, 0, 16 as u64)
mut tvlen := 16
if sizeof(void*) == 8:
tv64 := tv as i64*
tv64[0] = (millis / 1000) as i64
tv64[1] = ((millis % 1000) * 1000) as i64
else:
tv32 := tv as i32*
tv32[0] = millis / 1000
tv32[1] = (millis % 1000) * 1000
tvlen = 8
end
if SALAM_OS_MAC or SALAM_OS_BSD:
setsockopt(sock.fd as int, 65535, 4102, tv, tvlen)
setsockopt(sock.fd as int, 65535, 4101, tv, tvlen)
else:
setsockopt(sock.fd as int, 1, 20, tv, tvlen)
setsockopt(sock.fd as int, 1, 21, tv, tvlen)
end
end
end
@en "WaitReadable"
@fa "انتظار برای خواندن"
pub func WaitReadable(sock: Socket, timeout_ms: int): bool:
if sock.fd < 0:
ret false
end
if SALAM_OS_WINDOWS:
p := mem.AllocateZeroed(16 as u64)
defer mem.Free(p)
fdp := p as i64*
fdp[0] = sock.fd
evp := ((p as i64) + 8) as i16*
evp[0] = 256 as i16
ret WSAPoll(p, 1 as u32, timeout_ms) > 0
else:
p := mem.AllocateZeroed(8 as u64)
defer mem.Free(p)
fdp := p as i32*
fdp[0] = sock.fd as i32
evp := ((p as i64) + 4) as i16*
evp[0] = 1 as i16
ret poll(p, 1 as usize, timeout_ms) > 0
end
end
@en "SetKeepAlive"
@fa "تنظیم زنده‌نگه‌داری"
pub func SetKeepAlive(sock: Socket, enable: bool):
opt := mem.Allocate(4 as u64)
defer mem.Free(opt)
o32 := opt as int*
if enable: o32[0] = 1 else:
o32[0] = 0
end
if SALAM_OS_WINDOWS:
setsockopt(_sk(sock.fd), 65535, 8, opt, 4)
else SALAM_OS_MAC or SALAM_OS_BSD:
setsockopt(sock.fd as int, 65535, 8, opt, 4)
else:
setsockopt(sock.fd as int, 1, 9, opt, 4)
end
end
@en "SetNoDelay"
@fa "غیرفعال‌سازی نگل"
pub func SetNoDelay(sock: Socket, enable: bool):
opt := mem.Allocate(4 as u64)
defer mem.Free(opt)
o32 := opt as int*
if enable: o32[0] = 1 else:
o32[0] = 0
end
if SALAM_OS_WINDOWS:
setsockopt(_sk(sock.fd), 6, 1, opt, 4)
else:
setsockopt(sock.fd as int, 6, 1, opt, 4)
end
end
@en "SetOpt"
@fa "تنظیم گزینه سوکت"
pub func SetOpt(sock: Socket, level: int, optname: int, ptr: void*, optlen: int): int:
if SALAM_OS_WINDOWS:
ret setsockopt(_sk(sock.fd), level, optname, ptr, optlen)
else:
ret setsockopt(sock.fd as int, level, optname, ptr, optlen)
end
end
@en "SetBroadcast"
@fa "فعال‌سازی پخش"
pub func SetBroadcast(sock: Socket, enable: bool):
opt := mem.Allocate(4 as u64)
defer mem.Free(opt)
o32 := opt as int*
if enable: o32[0] = 1 else:
o32[0] = 0
end
if SALAM_OS_WINDOWS:
setsockopt(_sk(sock.fd), 65535, 32, opt, 4)
else SALAM_OS_MAC or SALAM_OS_BSD:
setsockopt(sock.fd as int, 65535, 32, opt, 4)
else:
setsockopt(sock.fd as int, 1, 6, opt, 4)
end
end
@en "SendToBytes"
@fa "ارسال بایت به"
pub func SendToBytes(sock: Socket, host: str, port: int, ptr: void*, n: int): int:
h_addr := _resolve_addr4(host)
if h_addr == 0: ret 0 - 1 end
sa := _make_sa4(h_addr, port)
defer mem.Free(sa)
if SALAM_OS_WINDOWS:
ret sendto(_sk(sock.fd), ptr, n, 0, sa, 16)
else:
ret sendto(sock.fd as int, ptr, n, 0, sa, 16)
end
end
@en "SendTo"
@fa "ارسال به"
pub func SendTo(sock: Socket, host: str, port: int, data: str): int:
ret SendToBytes(sock, host, port, data as void*, data.len())
end
@en "RecvFromBytes"
@fa "دریافت بایت از"
pub func RecvFromBytes(sock: Socket, buf: void*, max: int, out_host &: str, out_port &: int): int:
sa := mem.Allocate(16 as u64)
defer mem.Free(sa)
memset(sa, 0, 16 as u64)
salen := mem.Allocate(4 as u64)
defer mem.Free(salen)
salen32 := salen as int*
salen32[0] = 16
mut n := 0
if SALAM_OS_WINDOWS:
n = recvfrom(_sk(sock.fd), buf, max, 0, sa, salen)
else:
n = recvfrom(sock.fd as int, buf, max, 0, sa, salen)
end
if n < 0:
out_host = ""
out_port = 0
ret n
end
sap := sa as i8*
sa32 := sa as int*
mut hi := sap[2] as int
mut lo := sap[3] as int
if hi < 0: hi += 256 end
if lo < 0: lo += 256 end
out_port = hi * 256 + lo
out_host = str.Clone(inet_ntoa(sa32[1]))
ret n
end
@en "RecvFrom"
@fa "دریافت از"
pub func RecvFrom(sock: Socket, max: int, out_host &: str, out_port &: int): str:
mut m := max
if m <= 0: m = 65536 end
buf := mem.Allocate((m + 1) as u64)
defer mem.Free(buf)
memset(buf, 0, (m + 1) as u64)
n := RecvFromBytes(sock, buf, m, out_host, out_port)
if n < 0: ret "" end
ret str.Clone(buf as str).substr(0, n)
end
@en "net/mime"
@fa "مایم"
package mime
import mem
import str
import filepath
import crypto
import compress
@en "ContentTypeParam"
@fa "پارامتر نوع محتوا"
pub struct ContentTypeParam:
pub key: str = ""
pub value: str = ""
end
@en "ContentTypeParams"
@fa "پارامترهای نوع محتوا"
pub struct ContentTypeParams:
pub items: Vector<ContentTypeParam> = Vector {}
end
@en "ContentType"
@fa "نوع محتوا"
pub struct ContentType:
pub media_type: str = ""
pub params: ContentTypeParams = ContentTypeParams {}
end
@en "MultipartHeader"
@fa "سرآیند بخش"
pub struct MultipartHeader:
pub key: str = ""
pub value: str = ""
end
@en "MultipartHeaders"
@fa "سرآیندهای بخش"
pub struct MultipartHeaders:
pub items: Vector<MultipartHeader> = Vector {}
end
@en "MultipartPart"
@fa "بخش چندبخشی"
pub struct MultipartPart:
pub name: str = ""
pub filename: str = ""
pub content_type: str = ""
pub headers: MultipartHeaders = MultipartHeaders {}
pub body: compress.ByteBuf = compress.ByteBuf {}
end
@en "MultipartParts"
@fa "بخش‌های چندبخشی"
pub struct MultipartParts:
pub items: Vector<MultipartPart> = Vector {}
end
@en "MultipartWriter"
@fa "نویسنده چندبخشی"
pub struct MultipartWriter:
pub boundary: str = ""
pub buf: compress.ByteBuf = compress.ByteBuf {}
pub closed: bool = false
end
func _wbytes(b &: compress.ByteBuf, s: str):
compress.BufPushBytes(b, s as void*, s.len())
end
func _bytes_to_str(p: void*, n: int): str:
buf := mem.Allocate((n + 1) as u64)
defer mem.Free(buf)
mem.Copy(buf, p, n as u64)
bufp := buf as i8*
bufp[n] = 0 as i8
ret str.Clone(buf as str)
end
func _mem_find(hay: void*, hay_len: int, needle: void*, needle_len: int, start: int): int:
if needle_len == 0: ret start end
if needle_len > hay_len: ret 0 - 1 end
hp := hay as i64
np := needle as i64
limit := hay_len - needle_len
mut i := start
until i <= limit:
mut j := 0
mut matched := true
until j < needle_len:
hb := ((hp + i + j) as i8*)[0]
nb := ((np + j) as i8*)[0]
if hb != nb:
matched = false
j = needle_len
else:
j += 1
end
end
if matched: ret i end
i += 1
end
ret 0 - 1
end
func _ltrim(s: str): str:
mut a := 0
n := s.len()
until a < n:
c := s.substr(a, 1)
if c == " " or c == "\t":
a += 1
else:
ret s.substr(a, n - a)
end
end
ret ""
end
func _rtrim(s: str): str:
mut b := s.len()
until b > 0:
c := s.substr(b - 1, 1)
if c == " " or c == "\t" or c == "\r" or c == "\n":
b -= 1
else:
ret s.substr(0, b)
end
end
ret ""
end
func _strip(s: str): str:
ret _rtrim(_ltrim(s))
end
func _unquote(s: str): str:
if s.len() >= 2 and s.substr(0, 1) == "\"" and s.substr(s.len() - 1, 1) == "\"":
ret s.substr(1, s.len() - 2)
end
ret s
end
func _header_value(headers: MultipartHeaders, key: str): str:
n := headers.items.len()
mut i := 0
until i < n:
h := headers.items.get(i)
if h.key == key:
ret h.value
end
i += 1
end
ret ""
end
func _cd_quoted_param(cd: str, key: str): str:
needle := key + "=\""
idx := cd.find(needle)
if idx < 0: ret "" end
start := idx + needle.len()
rest := cd.substr(start, cd.len() - start)
close := rest.find("\"")
if close < 0: ret "" end
ret rest.substr(0, close)
end
func _write_part_header(w &: MultipartWriter, disposition: str, content_type: str):
_wbytes(w.buf, "--" + w.boundary + "\r\n")
_wbytes(w.buf, "Content-Disposition: " + disposition + "\r\n")
if content_type.len() > 0:
_wbytes(w.buf, "Content-Type: " + content_type + "\r\n")
end
_wbytes(w.buf, "\r\n")
end
@en "MimeExt"
@fa "پسوند مایم"
pub func MimeExt(ext: str): str:
if ext == "html" or ext == "htm": ret "text/html; charset=utf-8"
else ext == "css": ret "text/css"
else ext == "js" or ext == "mjs": ret "application/javascript"
else ext == "json": ret "application/json"
else ext == "png": ret "image/png"
else ext == "jpg" or ext == "jpeg": ret "image/jpeg"
else ext == "gif": ret "image/gif"
else ext == "svg": ret "image/svg+xml"
else ext == "ico": ret "image/x-icon"
else ext == "webp": ret "image/webp"
else ext == "txt": ret "text/plain; charset=utf-8"
else ext == "md": ret "text/markdown; charset=utf-8"
else ext == "pdf": ret "application/pdf"
else ext == "xml": ret "application/xml"
else ext == "wasm": ret "application/wasm"
else ext == "map": ret "application/json"
else ext == "zip": ret "application/zip"
else ext == "mp4": ret "video/mp4"
else ext == "webm": ret "video/webm"
else ext == "mp3": ret "audio/mpeg"
else ext == "wav": ret "audio/wav"
else ext == "woff": ret "font/woff"
else ext == "woff2": ret "font/woff2"
else:
ret "application/octet-stream"
end
end
@en "MimeType"
@fa "رده مایم"
pub func MimeType(p: str): str:
e := filepath.Ext(p)
if e.len() == 0:
mem.Free(e as void*)
ret "application/octet-stream"
end
bare := e.substr(1, e.len() - 1)
out := MimeExt(bare)
mem.Free(bare as void*)
mem.Free(e as void*)
ret out
end
@en "StatusText"
@fa "متن وضعیت"
pub func StatusText(code: int): str:
if code == 100: ret "Continue"
else code == 101: ret "Switching Protocols"
else code == 102: ret "Processing"
else code == 103: ret "Early Hints"
else code == 200: ret "OK"
else code == 201: ret "Created"
else code == 202: ret "Accepted"
else code == 203: ret "Non-Authoritative Information"
else code == 204: ret "No Content"
else code == 205: ret "Reset Content"
else code == 206: ret "Partial Content"
else code == 207: ret "Multi-Status"
else code == 208: ret "Already Reported"
else code == 226: ret "IM Used"
else code == 300: ret "Multiple Choices"
else code == 301: ret "Moved Permanently"
else code == 302: ret "Found"
else code == 303: ret "See Other"
else code == 304: ret "Not Modified"
else code == 305: ret "Use Proxy"
else code == 307: ret "Temporary Redirect"
else code == 308: ret "Permanent Redirect"
else code == 400: ret "Bad Request"
else code == 401: ret "Unauthorized"
else code == 402: ret "Payment Required"
else code == 403: ret "Forbidden"
else code == 404: ret "Not Found"
else code == 405: ret "Method Not Allowed"
else code == 406: ret "Not Acceptable"
else code == 407: ret "Proxy Authentication Required"
else code == 408: ret "Request Timeout"
else code == 409: ret "Conflict"
else code == 410: ret "Gone"
else code == 411: ret "Length Required"
else code == 412: ret "Precondition Failed"
else code == 413: ret "Content Too Large"
else code == 414: ret "URI Too Long"
else code == 415: ret "Unsupported Media Type"
else code == 416: ret "Range Not Satisfiable"
else code == 417: ret "Expectation Failed"
else code == 418: ret "I'm a teapot"
else code == 421: ret "Misdirected Request"
else code == 422: ret "Unprocessable Entity"
else code == 423: ret "Locked"
else code == 424: ret "Failed Dependency"
else code == 425: ret "Too Early"
else code == 426: ret "Upgrade Required"
else code == 428: ret "Precondition Required"
else code == 429: ret "Too Many Requests"
else code == 431: ret "Request Header Fields Too Large"
else code == 451: ret "Unavailable For Legal Reasons"
else code == 500: ret "Internal Server Error"
else code == 501: ret "Not Implemented"
else code == 502: ret "Bad Gateway"
else code == 503: ret "Service Unavailable"
else code == 504: ret "Gateway Timeout"
else code == 505: ret "HTTP Version Not Supported"
else code == 506: ret "Variant Also Negotiates"
else code == 507: ret "Insufficient Storage"
else code == 508: ret "Loop Detected"
else code == 510: ret "Not Extended"
else code == 511: ret "Network Authentication Required"
else:
ret "Unknown"
end
end
@en "ParseContentType"
@fa "تجزیه نوع محتوا"
pub func ParseContentType(header: str): ContentType:
mut out := ContentType {}
parts := str.Split(header, ";")
if parts.len() == 0: ret out end
out.media_type = _strip(parts.get(0))
mut i := 1
until i < parts.len():
piece := _strip(parts.get(i))
eq_at := piece.find("=")
if eq_at >= 0:
k := _strip(piece.substr(0, eq_at))
v := _unquote(_strip(piece.substr(eq_at + 1, piece.len() - eq_at - 1)))
out.params.items.push(ContentTypeParam { key = k, value = v })
end
i += 1
end
ret out
end
@en "ParamGet"
@fa "دریافت پارامتر"
pub func ParamGet(ct: ContentType, key: str): str:
n := ct.params.items.len()
mut i := 0
until i < n:
p := ct.params.items.get(i)
if p.key == key:
ret p.value
end
i += 1
end
ret ""
end
@en "ParseMultipart"
@fa "تجزیه چندبخشی"
pub func ParseMultipart(data: void*, n: int, boundary: str): MultipartParts:
mut out := MultipartParts {}
delim := "--" + boundary
dbytes := delim as void*
dlen := delim.len()
mut pos := _mem_find(data, n, dbytes, dlen, 0)
if pos < 0: ret out end
pos += dlen
mut done := false
until not done:
if pos + 1 < n:
b0 := ((data as i64 + pos) as i8*)[0]
b1 := ((data as i64 + pos + 1) as i8*)[0]
if b0 == 45 and b1 == 45:
done = true
continue
end
end
crlf := _mem_find(data, n, "\r\n" as void*, 2, pos)
if crlf < 0:
done = true
continue
end
header_start := crlf + 2
sep := _mem_find(data, n, "\r\n\r\n" as void*, 4, header_start)
if sep < 0:
done = true
continue
end
next_boundary := _mem_find(data, n, dbytes, dlen, header_start)
if next_boundary < 0:
done = true
continue
end
header_text := _bytes_to_str((data as i64 + header_start) as void*, sep - header_start)
mut part := MultipartPart {}
lines := str.Split(header_text, "\r\n")
mut li := 0
until li < lines.len():
line := lines.get(li)
colon := line.find(":")
if colon >= 0:
hk := _strip(line.substr(0, colon))
hv := _strip(line.substr(colon + 1, line.len() - colon - 1))
part.headers.items.push(MultipartHeader { key = hk, value = hv })
end
li += 1
end
cd := _header_value(part.headers, "Content-Disposition")
part.name = _cd_quoted_param(cd, "name")
part.filename = _cd_quoted_param(cd, "filename")
part.content_type = _header_value(part.headers, "Content-Type")
body_start := sep + 4
mut body_end := next_boundary
if body_end - 2 >= body_start:
body_end -= 2
end
blen := body_end - body_start
if blen > 0:
src := (data as i64 + body_start) as void*
compress.BufPushBytes(part.body, src, blen)
end
out.items.push(part)
pos = next_boundary + dlen
end
ret out
end
@en "NewMultipartWriter"
@fa "نویسنده چندبخشی جدید"
pub func NewMultipartWriter(): MultipartWriter:
mut w := MultipartWriter {}
w.boundary = "SalamBoundary" + crypto.RandomHex(16)
w.buf = compress.NewByteBuf()
w.closed = false
ret w
end
@en "ContentTypeHeader"
@fa "سرآیند نوع محتوا"
pub func ContentTypeHeader(w: MultipartWriter): str:
ret "multipart/form-data; boundary=" + w.boundary
end
@en "WriteField"
@fa "نوشتن فیلد"
pub func WriteField(w &: MultipartWriter, name: str, value: str):
_write_part_header(w, "form-data; name=\"" + name + "\"", "")
_wbytes(w.buf, value)
_wbytes(w.buf, "\r\n")
end
@en "WriteFileBytes"
@fa "نوشتن پرونده"
pub func WriteFileBytes(w &: MultipartWriter, name: str, filename: str, content_type: str, data: void*, n: int):
mut ct := content_type
if ct.len() == 0: ct = MimeType(filename) end
_write_part_header(w, "form-data; name=\"" + name + "\"; filename=\"" + filename + "\"", ct)
compress.BufPushBytes(w.buf, data, n)
_wbytes(w.buf, "\r\n")
end
@en "WriteFileStr"
@fa "نوشتن پرونده متنی"
pub func WriteFileStr(w &: MultipartWriter, name: str, filename: str, content_type: str, data: str):
WriteFileBytes(w, name, filename, content_type, data as void*, data.len())
end
@en "CloseWriter"
@fa "بستن نویسنده"
pub func CloseWriter(w &: MultipartWriter): compress.ByteBuf:
if not w.closed:
_wbytes(w.buf, "--" + w.boundary + "--\r\n")
w.closed = true
end
ret w.buf
end
@en "net"
@fa "شبکه"
package net
@en "net/router"
@fa "مسیریاب"
package router
import mem
const _CH_SLASH := 47
const _CH_COLON := 58
const _CH_STAR := 42
@en "Param"
@fa "پارامتر"
pub struct Param:
pub key: str = ""
pub value: str = ""
end
@en "ParamList"
@fa "پارامترها"
pub struct ParamList:
pub items: Vector<Param> = Vector {}
end
@en "Route"
@fa "مسیر مسیریابی"
pub struct Route:
pub method: str = ""
pub pattern: str = ""
pub fn: i64 = 0
pub mid: int = 0
pub spec: int = 0
end
@en "Router"
@fa "مسیریاب"
pub struct Router:
pub routes: Vector<Route> = Vector {}
pub static_prefix: str = ""
pub static_dir: str = ""
pub has_static: bool = false
pub static_listing: bool = false
pub idx: Vector<int> = Vector {}
pub idx_mask: int = 0
pub n_literal: int = 0
pub n_dynamic: int = 0
end
@en "Match"
@fa "تطابق"
pub struct Match:
pub matched: bool = false
pub fn: i64 = 0
pub params: ParamList = ParamList {}
end
func _free_params(p &: ParamList):
n := p.items.len()
mut i := 0
until i < n:
kv := p.items.get(i)
mem.Free(kv.key as void *)
mem.Free(kv.value as void *)
i += 1
end
p.items.free()
p.items = Vector {} as Vector<Param>
end
func _method_id(m: str): int:
if m == "GET": ret 1 end
if m == "POST": ret 2 end
if m == "PUT": ret 3 end
if m == "DELETE": ret 4 end
if m == "PATCH": ret 5 end
if m == "HEAD": ret 6 end
if m == "OPTIONS": ret 7 end
ret 0
end
func _hash_key(mid: int, s: str): int:
mut h := 2166136261 as i64
h = ((h ^ (mid as i64)) * 16777619) & 4294967295
p := s as i8 *
n := s.len()
mut i := 0
until i < n:
h = ((h ^ ((p[i] as i64) & 255)) * 16777619) & 4294967295
i += 1
end
ret (h & 2147483647) as int
end
func _param_get(p: ParamList, key: str): str:
n := p.items.len()
mut i := 0
until i < n:
kv := p.items.get(i)
if kv.key == key: ret kv.value end
i += 1
end
ret ""
end
func _specificity(pattern: str): int:
if pattern.find("*") >= 0: ret 2 end
if pattern.find(":") >= 0: ret 1 end
ret 0
end
func _byte_at(s: str, i: int): int:
p := s as i8 *
ret p[i]
end
func _try_match(pattern: str, path: str, out_params &: ParamList): bool:
mut pi := 0
mut pp := 0
plen := pattern.len()
pathlen := path.len()
until pi < plen or pp < pathlen:
if pi < plen and _byte_at(pattern, pi) == _CH_STAR:
ret true
end
if pi < plen and _byte_at(pattern, pi) == _CH_COLON:
mut ne := pi + 1
until ne < plen and _byte_at(pattern, ne) != _CH_SLASH:
ne += 1
end
pname := pattern.substr(pi + 1, ne - pi - 1)
mut ve := pp
until ve < pathlen and _byte_at(path, ve) != _CH_SLASH:
ve += 1
end
pval := path.substr(pp, ve - pp)
out_params.items.push(Param { key = pname, value = pval })
pi = ne
pp = ve
else:
if pi >= plen or pp >= pathlen:
break
end
if _byte_at(pattern, pi) != _byte_at(path, pp):
ret false
end
pi += 1
pp += 1
end
end
until pi < plen and _byte_at(pattern, pi) == _CH_SLASH: pi = pi + 1 end
until pp < pathlen and _byte_at(path, pp) == _CH_SLASH: pp = pp + 1 end
ret pi == plen and pp == pathlen
end
func _idx_insert(r &: Router, ri: int):
route := r.routes.get(ri)
if route.spec != 0: ret end
mut slot := _hash_key(route.mid, route.pattern) & r.idx_mask
until r.idx.get(slot) != 0:
prev := r.routes.get(r.idx.get(slot) - 1)
if prev.mid == route.mid and prev.method == route.method and prev.pattern == route.pattern:
ret
end
slot = (slot + 1) & r.idx_mask
end
r.idx.set(slot, ri + 1)
end
func _idx_grow(r &: Router, cap: int):
r.idx.free()
r.idx = Vector {} as Vector<int>
repeat cap in _:
r.idx.push(0)
end
r.idx_mask = cap - 1
n := r.routes.len()
mut i := 0
until i < n:
_idx_insert(r, i)
i += 1
end
end
func _add(r &: Router, method: str, pattern: str, fn: i64):
mut rt := Route {}
rt.method = method
rt.pattern = pattern
rt.fn = fn
rt.spec = _specificity(pattern)
rt.mid = _method_id(method)
r.routes.push(rt)
if rt.spec != 0:
r.n_dynamic += 1
ret
end
r.n_literal += 1
cap := r.idx_mask + 1
if (r.n_literal * 2) > cap:
mut want := 16
until want < (r.n_literal * 4):
want = want * 2
end
_idx_grow(r, want)
else:
_idx_insert(r, r.routes.len() - 1)
end
end
func _dispatch_exact(r: Router, method: str, path: str): Match:
mut m := Match {}
mid := _method_id(method)
if r.idx_mask > 0:
mut slot := _hash_key(mid, path) & r.idx_mask
until r.idx.get(slot) != 0:
route := r.routes.get(r.idx.get(slot) - 1)
if route.mid == mid and route.pattern == path:
if mid != 0 or route.method == method:
m.matched = true
m.fn = route.fn
ret m
end
end
slot = (slot + 1) & r.idx_mask
end
end
if r.n_dynamic == 0: ret m end
n := r.routes.len()
mut best := 3
mut i := 0
until i < n:
route := r.routes.get(i)
if route.spec != 0 and route.mid == mid and route.spec < best:
if mid != 0 or route.method == method:
mut params := ParamList {}
if _try_match(route.pattern, path, params):
_free_params(m.params)
m.matched = true
m.fn = route.fn
m.params = params
best = route.spec
else:
_free_params(params)
end
end
end
i += 1
end
ret m
end
@en "NewRouter"
@fa "مسیریاب جدید"
pub func NewRouter(): Router:
ret Router {}
end
@en "Get"
@fa "دریافت"
pub func Get(r &: Router, path: str, fn: i64): _add(r, "GET", path, fn) end
@en "Post"
@fa "ارسال"
pub func Post(r &: Router, path: str, fn: i64): _add(r, "POST", path, fn) end
@en "Put"
@fa "قراردادن"
pub func Put(r &: Router, path: str, fn: i64): _add(r, "PUT", path, fn) end
@en "Delete"
@fa "حذف"
pub func Delete(r &: Router, path: str, fn: i64): _add(r, "DELETE", path, fn) end
@en "Patch"
@fa "وصله"
pub func Patch(r &: Router, path: str, fn: i64): _add(r, "PATCH", path, fn) end
@en "Head"
@fa "سر"
pub func Head(r &: Router, path: str, fn: i64): _add(r, "HEAD", path, fn) end
@en "Options"
@fa "گزینه ها"
pub func Options(r &: Router, path: str, fn: i64): _add(r, "OPTIONS", path, fn) end
@en "Method"
@fa "روش"
pub func Method(r &: Router, method: str, path: str, fn: i64):
_add(r, method, path, fn)
end
@en "Group"
@fa "گروه"
pub func Group(r &: Router, prefix: str, method: str, path: str, fn: i64):
_add(r, method, prefix + path, fn)
end
@en "Static"
@fa "ایستا"
pub func Static(r &: Router, prefix: str, dir: str):
r.static_prefix = prefix
r.static_dir = dir
r.has_static = true
end
@en "EnableListing"
@fa "فعال سازی فهرست پوشه"
pub func EnableListing(r &: Router):
r.static_listing = true
end
@en "ParamGet"
@fa "دریافت پارامتر"
pub func ParamGet(m: Match, key: str): str:
ret _param_get(m.params, key)
end
@en "Dispatch"
@fa "اعزام"
pub func Dispatch(r: Router, method: str, path: str): Match:
m := _dispatch_exact(r, method, path)
if not m.matched and method == "HEAD":
ret _dispatch_exact(r, "GET", path)
end
ret m
end
@en "FreeMatch"
@fa "آزادسازی تطابق"
pub func FreeMatch(m &: Match):
_free_params(m.params)
end
@en "net/tcp"
@fa "تی سی پی"
package tcp
import net.internal.rawsock
import conv
import tls
@en "Server"
@fa "سرور"
pub struct Server:
pub fd: i64 = 0 - 1
pub port: int = 0
end
@en "Conn"
@fa "اتصال شبکه"
pub struct Conn:
pub fd: i64 = 0 - 1
end
@en "PoolEntry"
@fa "مدخل استخر"
pub struct PoolEntry:
pub key: str = ""
pub conn: Conn = Conn {}
pub put_at_ms: i64 = 0
end
@en "PoolEntries"
@fa "مدخل‌های استخر"
pub struct PoolEntries:
pub items: Vector<PoolEntry> = Vector {}
end
@en "Pool"
@fa "استخر اتصال"
pub struct Pool:
pub entries: PoolEntries = PoolEntries {}
pub idle_ttl_ms: i64 = 30000
end
func _sock(fd: i64): rawsock.Socket:
ret rawsock.FromFd(fd)
end
func _pool_key(host: str, port: int): str:
ret host + ":" + conv.FormatInt(port as i64)
end
@en "Bind"
@fa "پیوند"
pub func Bind(port: int): Server:
ret Server { fd = rawsock.Listen(port).fd, port = port }
end
@en "Ok"
@fa "معتبر"
pub func Ok(srv: Server): bool:
ret srv.fd >= 0
end
@en "Port"
@fa "درگاه"
pub func Port(srv: Server): int:
ret rawsock.LocalPort(_sock(srv.fd))
end
@en "Accept"
@fa "پذیرش"
pub func Accept(srv: Server): Conn:
ret Conn { fd = rawsock.Accept(_sock(srv.fd)).fd }
end
@en "CloseServer"
@fa "بستن سرور"
pub func CloseServer(srv: Server):
rawsock.Close(_sock(srv.fd))
end
@en "ConnOk"
@fa "اتصال معتبر"
pub func ConnOk(c: Conn): bool:
ret c.fd >= 0
end
@en "Read"
@fa "خواندن"
pub func Read(c: Conn, max: int): str:
ret rawsock.Recv(_sock(c.fd), max)
end
@en "Write"
@fa "نوشتن"
pub func Write(c: Conn, data: str): int:
ret rawsock.Send(_sock(c.fd), data)
end
@en "ReadBytes"
@fa "خواندن بایت"
pub func ReadBytes(c: Conn, buf: void*, max: int): int:
ret rawsock.RecvBytes(_sock(c.fd), buf, max)
end
@en "WriteBytes"
@fa "نوشتن بایت"
pub func WriteBytes(c: Conn, ptr: void*, n: int): int:
ret rawsock.SendBytes(_sock(c.fd), ptr, n)
end
@en "Close"
@fa "بستن"
pub func Close(c: Conn):
rawsock.Close(_sock(c.fd))
end
@en "Dial"
@fa "شماره گیری"
pub func Dial(host: str, port: int): Conn:
ret Conn { fd = rawsock.Connect(host, port).fd }
end
@en "DialTLS"
@fa "شماره گیری امن"
pub func DialTLS(host: str, port: int): tls.Conn:
cfg := tls.NewConfig(host)
ret tls.Dial(host, port, cfg)
end
@en "UpgradeTLS"
@fa "ارتقا به تی ال اس"
pub func UpgradeTLS(c: Conn, cfg: tls.Config): tls.Conn:
ret tls.WrapClient(c.fd, cfg)
end
@en "ConnFromFd"
@fa "اتصال از توصیف‌گر"
pub func ConnFromFd(fd: i64): Conn:
ret Conn { fd = fd }
end
@en "WriteHTTP"
@fa "نوشتن اچ تی تی پی"
pub func WriteHTTP(c: Conn, status_line: str, content_type: str, body: str):
blen := conv.FormatInt(len(body) as i64)
resp := "HTTP/1.1 " + status_line + "\r\n" + "Content-Type: " + content_type + "\r\n" + "Content-Length: " + blen + "\r\n" + "Connection: close\r\n\r\n" + body
rawsock.Send(_sock(c.fd), resp)
end
@en "SetReadDeadline"
@fa "تنظیم مهلت خواندن"
pub func SetReadDeadline(c: Conn, millis: int):
rawsock.SetTimeout(_sock(c.fd), millis)
end
@en "SetWriteDeadline"
@fa "تنظیم مهلت نوشتن"
pub func SetWriteDeadline(c: Conn, millis: int):
rawsock.SetTimeout(_sock(c.fd), millis)
end
@en "SetDeadline"
@fa "تنظیم مهلت"
pub func SetDeadline(c: Conn, millis: int):
rawsock.SetTimeout(_sock(c.fd), millis)
end
@en "SetKeepAlive"
@fa "تنظیم زنده‌نگه‌داری"
pub func SetKeepAlive(c: Conn, enable: bool):
rawsock.SetKeepAlive(_sock(c.fd), enable)
end
@en "SetNoDelay"
@fa "غیرفعال‌سازی نگل"
pub func SetNoDelay(c: Conn, enable: bool):
rawsock.SetNoDelay(_sock(c.fd), enable)
end
@en "NewPool"
@fa "استخر جدید"
pub func NewPool(): Pool:
ret Pool { entries = PoolEntries {}, idle_ttl_ms = 30000 }
end
@en "Get"
@fa "دریافت اتصال"
pub func Get(p &: Pool, host: str, port: int, now_ms: i64): Conn:
key := _pool_key(host, port)
n := p.entries.items.len()
mut i := 0
until i < n:
e := p.entries.items.get(i)
if e.key == key:
p.entries.items.remove_at(i)
if ConnOk(e.conn) and (now_ms - e.put_at_ms) < p.idle_ttl_ms:
ret e.conn
end
Close(e.conn)
ret Dial(host, port)
end
i += 1
end
ret Dial(host, port)
end
@en "Put"
@fa "بازگرداندن اتصال"
pub func Put(p &: Pool, host: str, port: int, c: Conn, now_ms: i64):
if not ConnOk(c):
ret
end
entry := PoolEntry { key = _pool_key(host, port), conn = c, put_at_ms = now_ms }
p.entries.items.push(entry)
end
@en "PoolLen"
@fa "تعداد استخر"
pub func PoolLen(p: Pool): int:
ret p.entries.items.len()
end
@en "net/udp"
@fa "یو دی پی"
package udp
import mem
import net.internal.rawsock
@en "Socket"
@fa "سوکت یو دی پی"
pub struct Socket:
pub fd: i64 = 0 - 1
end
@en "Packet"
@fa "بسته"
pub struct Packet:
pub data: str = ""
pub from_host: str = ""
pub from_port: int = 0
end
func _sock(s: Socket): rawsock.Socket:
ret rawsock.FromFd(s.fd)
end
func _make_mreq(group_addr: int, iface_addr: int): void*:
m := mem.Allocate(8 as u64)
m32 := m as int*
m32[0] = group_addr
m32[1] = iface_addr
ret m
end
func _mcast_optname(joining: bool): int:
if SALAM_OS_WINDOWS or SALAM_OS_MAC or SALAM_OS_BSD:
if joining: ret 12 end
ret 13
else:
if joining: ret 35 end
ret 36
end
end
@en "Bind"
@fa "پیوند"
pub func Bind(port: int): Socket:
ret Socket { fd = rawsock.ListenOn("", port, rawsock.SOCK_DGRAM).fd }
end
@en "BindOn"
@fa "پیوند روی"
pub func BindOn(host: str, port: int): Socket:
ret Socket { fd = rawsock.ListenOn(host, port, rawsock.SOCK_DGRAM).fd }
end
@en "Open"
@fa "باز کردن"
pub func Open(): Socket:
ret Socket { fd = rawsock.Open(rawsock.AF_INET, rawsock.SOCK_DGRAM).fd }
end
@en "Port"
@fa "درگاه"
pub func Port(s: Socket): int:
ret rawsock.LocalPort(_sock(s))
end
@en "Ok"
@fa "معتبر"
pub func Ok(s: Socket): bool:
ret s.fd >= 0
end
@en "Close"
@fa "بستن"
pub func Close(s: Socket):
rawsock.Close(_sock(s))
end
@en "Send"
@fa "ارسال"
pub func Send(s: Socket, host: str, port: int, data: str): int:
ret rawsock.SendTo(_sock(s), host, port, data)
end
@en "SendTo"
@fa "ارسال به"
pub func SendTo(s: Socket, host: str, port: int, data: str): int:
ret rawsock.SendTo(_sock(s), host, port, data)
end
@en "SendBytes"
@fa "ارسال بایت"
pub func SendBytes(s: Socket, host: str, port: int, ptr: void*, n: int): int:
ret rawsock.SendToBytes(_sock(s), host, port, ptr, n)
end
@en "Receive"
@fa "دریافت"
pub func Receive(s: Socket, max: int): Packet:
mut p := Packet {}
mut fh := ""
mut fp := 0
p.data = rawsock.RecvFrom(_sock(s), max, fh, fp)
p.from_host = fh
p.from_port = fp
ret p
end
@en "ReceiveBytes"
@fa "دریافت بایت"
pub func ReceiveBytes(s: Socket, buf: void*, max: int, out_host &: str, out_port &: int): int:
ret rawsock.RecvFromBytes(_sock(s), buf, max, out_host, out_port)
end
@en "SetBroadcast"
@fa "فعال‌سازی پخش"
pub func SetBroadcast(s: Socket, enable: bool):
rawsock.SetBroadcast(_sock(s), enable)
end
@en "SetTimeout"
@fa "تنظیم زمان انتظار"
pub func SetTimeout(s: Socket, millis: int):
rawsock.SetTimeout(_sock(s), millis)
end
@en "JoinMulticast"
@fa "پیوستن به گروه پخش"
pub func JoinMulticast(s: Socket, group_ip: str): bool:
group := rawsock.ResolveAddr4Raw(group_ip)
if group == 0: ret false end
mreq := _make_mreq(group, 0)
defer mem.Free(mreq)
r := rawsock.SetOpt(_sock(s), 0, _mcast_optname(true), mreq, 8)
ret r == 0
end
@en "LeaveMulticast"
@fa "ترک گروه پخش"
pub func LeaveMulticast(s: Socket, group_ip: str): bool:
group := rawsock.ResolveAddr4Raw(group_ip)
if group == 0: ret false end
mreq := _make_mreq(group, 0)
defer mem.Free(mreq)
r := rawsock.SetOpt(_sock(s), 0, _mcast_optname(false), mreq, 8)
ret r == 0
end
@en "node"
@fa "نود"
package node
import str
extern:
func require(id: str): i64
func salam_js_get_prop(obj: i64, name: str): i64
