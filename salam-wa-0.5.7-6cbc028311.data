const N_STAR := 41
const N_CONFLICT := 42
const N_DEFAULT := 43
const N_ALTER_ACTION := 44
const ALT_ADD := 1
const ALT_MODIFY := 2
const ALT_DROP := 3
const ALT_RENAME_TABLE := 4
const ALT_RENAME_COL := 5
const ALT_OTHER := 6
const OP_OR := 1
const OP_AND := 2
const OP_NOT := 3
const OP_EQ := 4
const OP_NE := 5
const OP_LT := 6
const OP_LE := 7
const OP_GT := 8
const OP_GE := 9
const OP_IS := 10
const OP_LIKE := 11
const OP_ILIKE := 12
const OP_GLOB := 13
const OP_REGEXP := 14
const OP_MATCH := 15
const OP_ADD := 16
const OP_SUB := 17
const OP_MUL := 18
const OP_DIV := 19
const OP_MOD := 20
const OP_CONCAT := 21
const OP_BITAND := 22
const OP_BITOR := 23
const OP_SHL := 24
const OP_SHR := 25
const OP_NEG := 26
const OP_BITNOT := 27
const OP_JSON := 28
const OP_COLLATE := 29
const OP_UNION := 30
const OP_UNION_ALL := 31
const OP_INTERSECT := 32
const OP_EXCEPT := 33
const OP_BITXOR := 34
const OP_CONTAINS := 35
const OP_JSON_PATH := 36
const LIT_NULL := 1
const LIT_INT := 2
const LIT_FLOAT := 3
const LIT_STRING := 4
const LIT_BLOB := 5
const LIT_BOOL := 6
const LIT_CURRENT := 7
const CON_PRIMARY := 1
const CON_UNIQUE := 2
const CON_CHECK := 3
const CON_FOREIGN := 4
const F_DISTINCT := 1
const F_STAR := 2
const F_NOT := 4
const F_NOT_NULL := 8
const F_PRIMARY := 16
const F_UNIQUE := 32
const F_AUTOINC := 64
const F_HAS_DEFAULT := 128
const F_GENERATED := 256
const F_IF_EXISTS := 512
const F_TEMP := 1024
const F_DESC := 2048
const F_NULLABLE := 4096
const F_UNSIGNED := 8192
const J_INNER := 0
const J_LEFT := 1
const J_RIGHT := 2
const J_FULL := 3
const J_CROSS := 4
struct Node:
pub kind: int = 0
pub tok: int = 0 - 1
pub t1: int = 0 - 1
pub t2: int = 0 - 1
pub op: int = 0
pub flags: int = 0
pub a: int = 0 - 1
pub b: int = 0 - 1
pub c: int = 0 - 1
pub d: int = 0 - 1
pub e: int = 0 - 1
pub f: int = 0 - 1
pub g: int = 0 - 1
pub list: Vector<int> = Vector {}
end
struct Ast:
pub nodes: Vector<Node> = Vector {}
pub roots: Vector<int> = Vector {}
end
func nd_new(a &: Ast, kind: int, tok: int): int:
id := a.nodes.len()
a.nodes.push(Node { kind = kind, tok = tok })
ret id
end
func nd_kind(a: Ast, id: int): int:
if id < 0 or id >= a.nodes.len():
ret N_NONE
end
ret a.nodes.get(id).kind
end
func nd_set_list(a &: Ast, id: int, items: Vector<int>):
if id < 0 or id >= a.nodes.len():
ret
end
mut n := a.nodes.ref(id)
n.list = items
end
func nd_set_a(a &: Ast, id: int, v: int):
if id < 0 or id >= a.nodes.len():
ret
end
mut n := a.nodes.ref(id)
n.a = v
end
func nd_set_b(a &: Ast, id: int, v: int):
if id < 0 or id >= a.nodes.len():
ret
end
mut n := a.nodes.ref(id)
n.b = v
end
func nd_set_c(a &: Ast, id: int, v: int):
if id < 0 or id >= a.nodes.len():
ret
end
mut n := a.nodes.ref(id)
n.c = v
end
func nd_set_d(a &: Ast, id: int, v: int):
if id < 0 or id >= a.nodes.len():
ret
end
mut n := a.nodes.ref(id)
n.d = v
end
func nd_set_e(a &: Ast, id: int, v: int):
if id < 0 or id >= a.nodes.len():
ret
end
mut n := a.nodes.ref(id)
n.e = v
end
func nd_set_f(a &: Ast, id: int, v: int):
if id < 0 or id >= a.nodes.len():
ret
end
mut n := a.nodes.ref(id)
n.f = v
end
func nd_set_g(a &: Ast, id: int, v: int):
if id < 0 or id >= a.nodes.len():
ret
end
mut n := a.nodes.ref(id)
n.g = v
end
func nd_set_t1(a &: Ast, id: int, v: int):
if id < 0 or id >= a.nodes.len():
ret
end
mut n := a.nodes.ref(id)
n.t1 = v
end
func nd_set_t2(a &: Ast, id: int, v: int):
if id < 0 or id >= a.nodes.len():
ret
end
mut n := a.nodes.ref(id)
n.t2 = v
end
func nd_set_op(a &: Ast, id: int, v: int):
if id < 0 or id >= a.nodes.len():
ret
end
mut n := a.nodes.ref(id)
n.op = v
end
func nd_add_flag(a &: Ast, id: int, v: int):
if id < 0 or id >= a.nodes.len():
ret
end
mut n := a.nodes.ref(id)
n.flags = n.flags | v
end
func nd_set_tok(a &: Ast, id: int, v: int):
if id < 0 or id >= a.nodes.len():
ret
end
mut n := a.nodes.ref(id)
n.tok = v
end
func nd_push(a &: Ast, id: int, v: int):
if id < 0 or id >= a.nodes.len():
ret
end
mut n := a.nodes.ref(id)
n.list.push(v)
end
func free_ast(a &: Ast):
mut i := 0
until i < a.nodes.len():
mut n := a.nodes.ref(i)
n.list.free()
i = i + 1
end
a.nodes.free()
a.roots.free()
end
package sql
import str
import mem
@en "STMT_UNKNOWN"
@fa "دستور ناشناخته"
pub const STMT_UNKNOWN := 0
@en "STMT_SELECT"
@fa "دستور گزینش"
pub const STMT_SELECT := 1
@en "STMT_INSERT"
@fa "دستور درج"
pub const STMT_INSERT := 2
@en "STMT_UPDATE"
@fa "دستور بروزرسانی"
pub const STMT_UPDATE := 3
@en "STMT_DELETE"
@fa "دستور حذف"
pub const STMT_DELETE := 4
@en "STMT_DDL"
@fa "دستور طرح"
pub const STMT_DDL := 5
k_sql_aggregates := [
"COUNT", "SUM", "AVG", "MIN", "MAX", "TOTAL", "GROUP_CONCAT", "STRING_AGG", "ARRAY_AGG", "JSON_AGG",
"JSONB_AGG", "BIT_AND", "BIT_OR", "BOOL_AND", "BOOL_OR", "EVERY", "STDDEV", "STDDEV_POP",
"STDDEV_SAMP", "VARIANCE", "VAR_POP", "VAR_SAMP"
]
struct Scope:
pub base: int = 0
pub name_base: int = 0
pub srcs: Vector<str> = Vector {}
pub cols: Vector<str> = Vector {}
pub kinds: Vector<int> = Vector {}
pub nulls: Vector<bool> = Vector {}
pub prims: Vector<bool> = Vector {}
pub names: Vector<str> = Vector {}
pub opens: Vector<bool> = Vector {}
end
struct Checker:
pub p: Parser = Parser {}
pub cat: Catalog = Catalog {}
pub local: Catalog = Catalog {}
pub owned: Vector<str> = Vector {}
pub ptoks: Vector<int> = Vector {}
pub pkinds: Vector<int> = Vector {}
pub pnulls: Vector<bool> = Vector {}
pub ptables: Vector<str> = Vector {}
pub pcols: Vector<str> = Vector {}
pub results: Vector<ResultCol> = Vector {}
pub kind: int = 0
pub table: str = ""
pub want_results: bool = false
end
@en "Param"
@fa "پارامتر"
pub struct Param:
pub marker: str = ""
pub ordinal: int = 0
pub table: str = ""
pub column: str = ""
pub kind: int = 7
pub not_null: bool = false
end
@en "ResultCol"
@fa "ستون نتیجه"
pub struct ResultCol:
pub name: str = ""
pub table: str = ""
pub kind: int = 7
pub nullable: bool = true
end
@en "Analysis"
@fa "تحلیل"
pub struct Analysis:
pub ok: bool = true
pub kind: int = 0
pub table: str = ""
pub params: Vector<Param> = Vector {}
pub results: Vector<ResultCol> = Vector {}
pub report: Report = Report {}
pub owned: Vector<str> = Vector {}
end
func c_own(ck &: Checker, s: str): str:
ck.owned.push(s)
ret s
end
func c_name(ck &: Checker, tok: int): str:
if tok < 0:
ret ""
end
ret c_own(ck, tok_name(ck.p.src, ck.p.toks.get(tok)))
end
func c_err(ck &: Checker, tok: int, code: str, message: str, help: str):
p_err_at(ck.p, tok, code, message, help)
end
func c_warn(ck &: Checker, tok: int, code: str, message: str, help: str):
if tok < 0:
ret
end
t := ck.p.toks.get(tok)
mut n := t.len
if n < 1:
n = 1
end
add_diag(ck.p.rep, WARNING, code, message, help, t.line, t.col, t.off, n)
end
func min3(a: int, b: int, c: int): int:
mut m := a
if b < m:
m = b
end
if c < m:
m = c
end
ret m
end
func edit_dist(a: str, b: str): int:
la := a.len()
lb := b.len()
if la == 0:
ret lb
end
if lb == 0:
ret la
end
mut prev := Vector {} as Vector<int>
mut cur := Vector {} as Vector<int>
mut j := 0
until j < lb + 1:
prev.push(j)
cur.push(0)
j = j + 1
end
mut i := 1
until i < la + 1:
cur.set(0, i)
ca := ch_upper(a[i - 1])
mut k := 1
until k < lb + 1:
cost := ca == ch_upper(b[k - 1]) ? 0 : 1
cur.set(k, min3(prev.get(k) + 1, cur.get(k - 1) + 1, prev.get(k - 1) + cost))
k = k + 1
end
mut m := 0
until m < lb + 1:
prev.set(m, cur.get(m))
m = m + 1
end
i = i + 1
end
out := prev.get(lb)
prev.free()
cur.free()
ret out
end
func near_of(cands: Vector<str>, want: str): str:
mut best := ""
mut bestd := 3
mut i := 0
until i < cands.len():
cand := cands.get(i)
if not str.IsEmpty(cand):
d := edit_dist(cand, want)
if d < bestd:
bestd = d
best = cand
end
end
i = i + 1
end
ret best
end
func did_you_mean(name: str): str:
if str.IsEmpty(name):
ret ""
end
ret "did you mean \"" + name + "\"?"
end
func scope_free(sc &: Scope):
sc.srcs.free()
sc.cols.free()
sc.kinds.free()
sc.nulls.free()
sc.prims.free()
sc.names.free()
sc.opens.free()
end
func scope_find_src_here(sc: Scope, name: str): int:
mut i := sc.name_base
until i < sc.names.len():
if str.EqualFold(sc.names.get(i), name):
ret i
end
i = i + 1
end
ret 0 - 1
end
func scope_find_src(sc: Scope, name: str): int:
mut i := 0
until i < sc.names.len():
if str.EqualFold(sc.names.get(i), name):
ret i
end
i = i + 1
end
ret 0 - 1
end
func scope_inherit(dst &: Scope, src: Scope):
mut i := 0
until i < src.cols.len():
dst.srcs.push(src.srcs.get(i))
dst.cols.push(src.cols.get(i))
dst.kinds.push(src.kinds.get(i))
dst.nulls.push(true)
dst.prims.push(false)
i = i + 1
end
mut j := 0
until j < src.names.len():
dst.names.push(src.names.get(j))
dst.opens.push(src.opens.get(j))
j = j + 1
end
dst.base = src.cols.len()
dst.name_base = src.names.len()
end
func lookup_table(ck: Checker, name: str, out &: Table): bool:
i := cat_find(ck.local, name)
if i >= 0:
out = ck.local.tables.get(i)
ret true
end
j := cat_find(ck.cat, name)
if j >= 0:
out = ck.cat.tables.get(j)
ret true
end
ret false
end
func table_names(ck &: Checker, out &: Vector<str>):
mut i := 0
until i < ck.cat.tables.len():
out.push(ck.cat.tables.get(i).name)
i = i + 1
end
mut j := 0
until j < ck.local.tables.len():
out.push(ck.local.tables.get(j).name)
j = j + 1
end
end
func scope_add_table(sc &: Scope, as_name: str, t: Table, nullable: bool):
sc.names.push(as_name)
sc.opens.push(t.open)
mut i := 0
until i < t.columns.len():
col := t.columns.get(i)
sc.srcs.push(as_name)
sc.cols.push(col.name)
sc.kinds.push(col.kind)
sc.nulls.push(nullable or not col.not_null)
sc.prims.push(col.primary)
i = i + 1
end
end
func scope_add_results(sc &: Scope, as_name: str, rows: Vector<ResultCol>, nullable: bool):
sc.names.push(as_name)
sc.opens.push(false)
mut i := 0
until i < rows.len():
r := rows.get(i)
sc.srcs.push(as_name)
sc.cols.push(r.name)
sc.kinds.push(r.kind)
sc.nulls.push(nullable or r.nullable)
sc.prims.push(false)
i = i + 1
end
end
func note_param(ck &: Checker, tok: int, kind: int, not_null: bool, table: str, column: str):
mut i := 0
until i < ck.ptoks.len():
if ck.ptoks.get(i) == tok:
ret
end
i = i + 1
end
ck.ptoks.push(tok)
ck.pkinds.push(kind)
ck.pnulls.push(not_null)
ck.ptables.push(table)
ck.pcols.push(column)
end
func col_find(ck &: Checker, sc &: Scope, node: int): int:
n := ck.p.ast.nodes.get(node)
cname := c_name(ck, n.tok)
mut qual := ""
if n.t1 >= 0:
qual = c_name(ck, n.t1)
end
mut found := 0 - 1
mut hits := 0
mut i := sc.base
until i < sc.cols.len():
if str.EqualFold(sc.cols.get(i), cname):
if str.IsEmpty(qual) or str.EqualFold(sc.srcs.get(i), qual):
hits = hits + 1
if found < 0:
found = i
end
end
end
i = i + 1
end
if found < 0:
mut j := 0
until j < sc.base:
if str.EqualFold(sc.cols.get(j), cname):
if str.IsEmpty(qual) or str.EqualFold(sc.srcs.get(j), qual):
found = j
break
end
end
j = j + 1
end
ret found
end
if hits > 1:
c_err(
ck, n.tok, "SQL312", "column \"" + cname + "\" is in more than one table here",
"qualify it, as in " + sc.srcs.get(found) + "." + cname
)
end
ret found
end
func scope_has_open(sc: Scope): bool:
mut i := 0
until i < sc.opens.len():
if sc.opens.get(i):
ret true
end
i = i + 1
end
ret false
end
func resolve_col(ck &: Checker, sc &: Scope, node: int):
if col_find(ck, sc, node) >= 0:
ret
end
if sc.cols.len() == 0 and sc.names.len() == 0:
ret
end
n := ck.p.ast.nodes.get(node)
column := c_name(ck, n.tok)
if n.t1 >= 0:
qual := c_name(ck, n.t1)
si := scope_find_src(sc, qual)
if si < 0:
best := near_of(sc.names, qual)
c_err(
ck, n.t1, "SQL310", "no table or alias named \"" + qual + "\" in this statement", did_you_mean(best)
)
ret
end
if sc.opens.get(si):
ret
end
mut cands := Vector {} as Vector<str>
mut i := 0
until i < sc.cols.len():
if str.EqualFold(sc.srcs.get(i), qual):
cands.push(sc.cols.get(i))
end
i = i + 1
end
best := near_of(cands, column)
cands.free()
c_err(
ck, n.tok, "SQL311", "\"" + qual + "\" has no column \"" + column + "\"", did_you_mean(best)
)
ret
end
if scope_has_open(sc):
ret
end
best := near_of(sc.cols, column)
c_err(
ck, n.tok, "SQL311", "no column named \"" + column + "\" in this statement", did_you_mean(best)
)
end
func kind_of_func_upper(u: str): int:
if str.Equals(u, "COUNT"):
ret TYPE_INT
end
if str.Equals(u, "SUM") or str.Equals(u, "TOTAL") or str.Equals(u, "AVG"):
ret TYPE_FLOAT
end
if str.Equals(u, "LENGTH") or str.Equals(u, "CHAR_LENGTH") or str.Equals(u, "ROW_NUMBER"):
ret TYPE_INT
end
if str.Equals(u, "ABS") or str.Equals(u, "ROUND"):
ret TYPE_FLOAT
end
if str.Equals(u, "LOWER") or str.Equals(u, "UPPER") or str.Equals(u, "TRIM"):
ret TYPE_TEXT
end
if str.Equals(u, "CONCAT") or str.Equals(u, "SUBSTR") or str.Equals(u, "SUBSTRING"):
ret TYPE_TEXT
end
if str.Equals(u, "NOW") or str.Equals(u, "CURRENT_TIMESTAMP"):
ret TYPE_TIME
end
if str.Equals(u, "DATE") or str.Equals(u, "DATETIME"):
ret TYPE_TIME
end
ret TYPE_UNKNOWN
end
func func_kind(name: str): int:
u := name.upper()
k := kind_of_func_upper(u)
mem.Free(u as void*)
ret k
end
func lit_kind(op: int): int:
if op == LIT_INT:
ret TYPE_INT
end
if op == LIT_FLOAT:
ret TYPE_FLOAT
end
if op == LIT_STRING:
ret TYPE_TEXT
end
if op == LIT_BLOB:
ret TYPE_BLOB
end
if op == LIT_BOOL:
ret TYPE_BOOL
end
if op == LIT_CURRENT:
ret TYPE_TIME
end
ret TYPE_NULL
end
func is_cmp_op(op: int): bool:
if op == OP_EQ or op == OP_NE or op == OP_LT or op == OP_LE:
ret true
end
if op == OP_GT or op == OP_GE or op == OP_IS:
ret true
end
if op == OP_LIKE or op == OP_ILIKE or op == OP_GLOB:
ret true
end
ret op == OP_REGEXP or op == OP_MATCH
end
func is_aggregate_name(name: str): bool:
mut i := 0
until i < len(k_sql_aggregates):
if str.EqualFold(name, k_sql_aggregates[i]):
ret true
end
i = i + 1
end
ret false
end
func expr_has_aggregate(ck &: Checker, id: int): bool:
k := nd_kind(ck.p.ast, id)
if k == N_NONE:
ret false
end
if k == N_SUBQUERY or k == N_EXISTS:
ret false
end
n := ck.p.ast.nodes.get(id)
if k == N_FUNC:
if is_aggregate_name(c_name(ck, n.tok)):
ret true
end
end
if expr_has_aggregate(ck, n.a) or expr_has_aggregate(ck, n.b):
ret true
end
if expr_has_aggregate(ck, n.c) or expr_has_aggregate(ck, n.d):
ret true
end
mut i := 0
until i < n.list.len():
if expr_has_aggregate(ck, n.list.get(i)):
ret true
end
i = i + 1
end
ret false
end
func collect_bare_cols(ck &: Checker, id: int, out &: Vector<int>):
k := nd_kind(ck.p.ast, id)
if k == N_NONE:
ret
end
n := ck.p.ast.nodes.get(id)
if k == N_COLUMN_REF:
out.push(id)
ret
end
if k == N_FUNC:
if is_aggregate_name(c_name(ck, n.tok)):
ret
end
end
if k == N_SUBQUERY or k == N_EXISTS:
ret
end
collect_bare_cols(ck, n.a, out)
collect_bare_cols(ck, n.b, out)
collect_bare_cols(ck, n.c, out)
collect_bare_cols(ck, n.d, out)
mut i := 0
until i < n.list.len():
collect_bare_cols(ck, n.list.get(i), out)
i = i + 1
end
end
func lit_is_number_text(ck &: Checker, node: int): bool:
n := ck.p.ast.nodes.get(node)
t := ck.p.toks.get(n.tok)
if t.len < 3:
ret false
end
mut i := t.off + 1
stop := t.off + t.len - 1
mut digits := 0
mut dots := 0
until i < stop:
c := ck.p.src[i]
if ch_digit(c):
digits = digits + 1
else c == '.':
dots = dots + 1
else c == '-' or c == '+':
if i != t.off + 1:
ret false
end
else:
ret false
end
i = i + 1
end
ret digits > 0 and dots < 2
end
func lit_int_value(ck &: Checker, id: int): int:
if nd_kind(ck.p.ast, id) != N_LITERAL:
ret 0 - 1
end
n := ck.p.ast.nodes.get(id)
if n.op != LIT_INT:
ret 0 - 1
end
t := ck.p.toks.get(n.tok)
if t.len < 1 or t.len > 9:
ret 0 - 1
end
mut v := 0
mut i := 0
until i < t.len:
c := ck.p.src[t.off + i]
if not ch_digit(c):
ret 0 - 1
end
v = v * 10 + ((c as int) - 48)
i = i + 1
end
ret v
end
func check_subquery_arity(ck &: Checker, sc &: Scope, sub: int, want: int, tok: int):
k := nd_kind(ck.p.ast, sub)
if k != N_SELECT and k != N_SET_OP and k != N_WITH and k != N_VALUES:
ret
end
mut rows := Vector {} as Vector<ResultCol>
select_results(ck, sub, sc, rows, true)
got := rows.len()
rows.free()
if got == 0 or got == want:
ret
end
mut what := "one value is"
if want > 1:
what = str.FromInt(want as i64) + " values are"
end
c_err(
ck, tok, "SQL324", "this subquery returns " + str.FromInt(got as i64) + " columns but " + what + " expected",
"select just the column the comparison needs"
)
end
func check_ordinals(ck &: Checker, list_node: int, count: int, label: str):
if list_node < 0:
ret
end
items := ck.p.ast.nodes.get(list_node).list
mut i := 0
until i < items.len():
mut e := items.get(i)
if nd_kind(ck.p.ast, e) == N_ORDER_ITEM:
e = ck.p.ast.nodes.get(e).a
end
v := lit_int_value(ck, e)
if v >= 0:
if v < 1 or v > count:
c_err(
ck, ck.p.ast.nodes.get(e).tok, "SQL326", label + " " + str.FromInt(v as i64) + " but the statement returns " + str.FromInt(count as i64) + " columns",
"count the result columns from 1, or name the column instead"
)
end
end
i = i + 1
end
end
func check_limit_value(ck &: Checker, id: int, what: str):
if nd_kind(ck.p.ast, id) != N_LITERAL:
ret
end
n := ck.p.ast.nodes.get(id)
if n.op == LIT_INT:
ret
end
if n.op == LIT_STRING or n.op == LIT_BOOL or n.op == LIT_NULL:
c_err(
ck, n.tok, "SQL327", what + " takes a number",
"write the count without quotes, or bind it as a placeholder"
)
end
end
func check_duplicate_aliases(ck &: Checker, id: int):
n := ck.p.ast.nodes.get(id)
mut seen := Vector {} as Vector<str>
mut i := 0
until i < n.list.len():
rc := ck.p.ast.nodes.get(n.list.get(i))
if (rc.flags & F_STAR) == 0:
name := result_name(ck, n.list.get(i))
if not str.IsEmpty(name):
mut j := 0
until j < seen.len():
if str.EqualFold(seen.get(j), name) and rc.t2 >= 0:
c_warn(
ck, rc.t2, "SQL325", "two result columns are both called \"" + name + "\"",
"give one of them a different alias"
)
break
end
j = j + 1
end
seen.push(name)
end
end
i = i + 1
end
seen.free()
end
func check_cmp_types(ck &: Checker, sc &: Scope, a: int, b: int):
mut cnode := 0 - 1
mut lnode := 0 - 1
if nd_kind(ck.p.ast, a) == N_COLUMN_REF and nd_kind(ck.p.ast, b) == N_LITERAL:
cnode = a
lnode = b
else nd_kind(ck.p.ast, b) == N_COLUMN_REF and nd_kind(ck.p.ast, a) == N_LITERAL:
cnode = b
lnode = a
end
if cnode < 0:
ret
end
idx := col_find(ck, sc, cnode)
if idx < 0:
ret
end
col_kind := sc.kinds.get(idx)
lit := ck.p.ast.nodes.get(lnode)
lit_k := lit_kind(lit.op)
if lit_k == TYPE_NULL:
ret
end
cname := c_name(ck, ck.p.ast.nodes.get(cnode).tok)
numeric := col_kind == TYPE_INT or col_kind == TYPE_FLOAT
if numeric and lit_k == TYPE_TEXT:
if lit_is_number_text(ck, lnode):
ret
end
msg := "\"" + cname + "\" is " + KindName(col_kind) + " and this compares it with text"
if ck.p.d.id == POSTGRES:
c_err(ck, lit.tok, "SQL330", msg, "postgres refuses this value for a numeric column")
else:
c_warn(ck, lit.tok, "SQL330", msg, "a number goes here without quotes")
end
ret
end
if col_kind == TYPE_TEXT and (lit_k == TYPE_INT or lit_k == TYPE_FLOAT):
if ck.p.d.id == POSTGRES:
c_err(
ck, lit.tok, "SQL330", "\"" + cname + "\" is text and postgres has no text = number operator",
"quote the value"
)
end
end
end
func check_group_by(ck &: Checker, sc &: Scope, id: int):
n := ck.p.ast.nodes.get(id)
if n.c < 0:
ret
end
glist := ck.p.ast.nodes.get(n.c).list
if glist.len() == 0:
ret
end
mut grouped := Vector {} as Vector<int>
mut i := 0
until i < glist.len():
g := glist.get(i)
if nd_kind(ck.p.ast, g) != N_COLUMN_REF:
grouped.free()
ret
end
gi := col_find(ck, sc, g)
if gi < 0:
grouped.free()
ret
end
grouped.push(gi)
i = i + 1
end
mut determined := Vector {} as Vector<str>
mut si := 0
until si < sc.names.len():
src_name := sc.names.get(si)
mut pk_total := 0
mut pk_grouped := 0
mut c := 0
until c < sc.cols.len():
if sc.prims.get(c) and str.EqualFold(sc.srcs.get(c), src_name):
pk_total = pk_total + 1
mut g := 0
until g < grouped.len():
if grouped.get(g) == c:
pk_grouped = pk_grouped + 1
end
g = g + 1
end
end
c = c + 1
end
if pk_total > 0 and pk_grouped == pk_total:
determined.push(src_name)
end
si = si + 1
end
mut j := 0
until j < n.list.len():
rc := ck.p.ast.nodes.get(n.list.get(j))
if (rc.flags & F_STAR) == 0 and not expr_has_aggregate(ck, rc.a):
mut bare := Vector {} as Vector<int>
collect_bare_cols(ck, rc.a, bare)
mut b := 0
until b < bare.len():
bi := col_find(ck, sc, bare.get(b))
if bi >= 0:
mut ok := false
mut g := 0
until g < grouped.len():
if grouped.get(g) == bi:
ok = true
end
g = g + 1
end
mut dt := 0
until dt < determined.len():
if str.EqualFold(determined.get(dt), sc.srcs.get(bi)):
ok = true
end
dt = dt + 1
end
if not ok:
cname := c_name(ck, ck.p.ast.nodes.get(bare.get(b)).tok)
msg := "\"" + cname + "\" is neither grouped nor aggregated"
help := "add it to GROUP BY, or wrap it in an aggregate such as MAX()"
if ck.p.d.id == POSTGRES:
c_err(ck, ck.p.ast.nodes.get(bare.get(b)).tok, "SQL332", msg, help)
else:
c_warn(ck, ck.p.ast.nodes.get(bare.get(b)).tok, "SQL332", msg, help)
end
end
end
b = b + 1
end
bare.free()
end
j = j + 1
end
determined.free()
grouped.free()
end
func scope_drop(sc &: Scope, idx: int):
sc.srcs.remove_at(idx)
sc.cols.remove_at(idx)
sc.kinds.remove_at(idx)
sc.nulls.remove_at(idx)
sc.prims.remove_at(idx)
end
func check_using(ck &: Checker, sc &: Scope, join: int, left_at: int, right_at: int):
n := ck.p.ast.nodes.get(join)
open_scope := scope_has_open(sc)
mut rend := sc.cols.len()
mut i := 0
until i < n.list.len():
tk := ck.p.ast.nodes.get(n.list.get(i)).tok
name := c_name(ck, tk)
mut left_has := false
mut k := left_at
until k < right_at:
if str.EqualFold(sc.cols.get(k), name):
left_has = true
end
k = k + 1
end
mut right_at_idx := 0 - 1
mut m := right_at
until m < rend:
if str.EqualFold(sc.cols.get(m), name) and right_at_idx < 0:
right_at_idx = m
end
m = m + 1
end
if not open_scope:
if not left_has:
c_err(
ck, tk, "SQL333", "the left side of this join has no column \"" + name + "\"",
"USING needs the column on both sides; an ON condition can name them separately"
)
else right_at_idx < 0:
c_err(
ck, tk, "SQL333", "the right side of this join has no column \"" + name + "\"",
"USING needs the column on both sides; an ON condition can name them separately"
)
end
end
if left_has and right_at_idx >= 0:
scope_drop(sc, right_at_idx)
rend = rend - 1
end
i = i + 1
end
end
func cast_kind(ck &: Checker, id: int): int:
tn := c_own(ck, type_text(ck.p, id))
ret kind_from_type(tn)
end
func expr_kind(ck &: Checker, sc &: Scope, id: int, nullable &: bool): int:
nullable = true
k := nd_kind(ck.p.ast, id)
if k == N_NONE:
ret TYPE_UNKNOWN
end
n := ck.p.ast.nodes.get(id)
if k == N_COLUMN_REF:
idx := col_find(ck, sc, id)
if idx < 0:
ret TYPE_UNKNOWN
end
nullable = sc.nulls.get(idx)
ret sc.kinds.get(idx)
end
if k == N_LITERAL:
nullable = n.op == LIT_NULL
ret lit_kind(n.op)
end
if k == N_CAST:
ret cast_kind(ck, id)
end
if k == N_FUNC:
name := c_name(ck, n.tok)
if str.EqualFold(name, "COUNT"):
nullable = false
ret TYPE_INT
end
if str.EqualFold(name, "TOTAL"):
nullable = false
ret TYPE_FLOAT
end
if is_aggregate_name(name):
mut inner_null := true
mut arg_kind := TYPE_UNKNOWN
if n.list.len() > 0:
arg_kind = expr_kind(ck, sc, n.list.get(0), inner_null)
end
nullable = true
if str.EqualFold(name, "MIN") or str.EqualFold(name, "MAX"):
ret arg_kind
end
agg_kind := func_kind(name)
if agg_kind != TYPE_UNKNOWN:
ret agg_kind
end
ret arg_kind
end
if str.EqualFold(name, "COALESCE") or str.EqualFold(name, "IFNULL"):
if n.list.len() > 0:
mut inner := true
kk := expr_kind(ck, sc, n.list.get(0), inner)
nullable = false
ret kk
end
ret TYPE_UNKNOWN
end
kf := func_kind(name)
if kf != TYPE_UNKNOWN:
ret kf
end
if n.list.len() == 1:
mut inner := true
kk := expr_kind(ck, sc, n.list.get(0), inner)
ret kk
end
ret TYPE_UNKNOWN
end
if k == N_BINARY:
if is_cmp_op(n.op) or n.op == OP_AND or n.op == OP_OR:
nullable = false
ret TYPE_BOOL
end
if n.op == OP_CONCAT:
ret TYPE_TEXT
end
if n.op == OP_DIV:
ret TYPE_FLOAT
end
mut ln := true
lk := expr_kind(ck, sc, n.a, ln)
mut rn := true
rk := expr_kind(ck, sc, n.b, rn)
nullable = ln or rn
if lk == TYPE_FLOAT or rk == TYPE_FLOAT:
ret TYPE_FLOAT
end
if lk == TYPE_INT or rk == TYPE_INT:
ret TYPE_INT
end
ret TYPE_UNKNOWN
end
if k == N_UNARY:
if n.op == OP_NOT:
nullable = false
ret TYPE_BOOL
end
ret expr_kind(ck, sc, n.a, nullable)
end
if k == N_IN or k == N_BETWEEN or k == N_EXISTS:
nullable = false
ret TYPE_BOOL
end
if k == N_CASE:
if n.list.len() > 0:
arm := ck.p.ast.nodes.get(n.list.get(0))
ret expr_kind(ck, sc, arm.b, nullable)
end
ret TYPE_UNKNOWN
end
if k == N_SUBQUERY:
mut rows := Vector {} as Vector<ResultCol>
select_results(ck, n.a, sc, rows, true)
mut out := TYPE_UNKNOWN
if rows.len() > 0:
out = rows.get(0).kind
nullable = rows.get(0).nullable
end
rows.free()
ret out
end
ret TYPE_UNKNOWN
end
func bind_param(ck &: Checker, sc &: Scope, col_node: int, par_node: int):
if nd_kind(ck.p.ast, par_node) != N_PARAM:
ret
end
if nd_kind(ck.p.ast, col_node) != N_COLUMN_REF:
ret
end
idx := col_find(ck, sc, col_node)
if idx < 0:
ret
end
cn := ck.p.ast.nodes.get(col_node)
note_param(
ck, ck.p.ast.nodes.get(par_node).tok, sc.kinds.get(idx), not sc.nulls.get(idx), sc.srcs.get(idx),
c_name(ck, cn.tok)
)
end
func walk_list(ck &: Checker, sc &: Scope, items: Vector<int>):
mut i := 0
until i < items.len():
walk_expr(ck, sc, items.get(i))
i = i + 1
end
end
func walk_expr(ck &: Checker, sc &: Scope, id: int):
k := nd_kind(ck.p.ast, id)
if k == N_NONE:
ret
end
n := ck.p.ast.nodes.get(id)
if k == N_COLUMN_REF:
resolve_col(ck, sc, id)
ret
end
if k == N_BINARY:
if is_cmp_op(n.op):
bind_param(ck, sc, n.a, n.b)
bind_param(ck, sc, n.b, n.a)
check_cmp_types(ck, sc, n.a, n.b)
if nd_kind(ck.p.ast, n.b) == N_SUBQUERY:
mut lw := 1
if nd_kind(ck.p.ast, n.a) == N_ROW:
lw = ck.p.ast.nodes.get(n.a).list.len()
end
check_subquery_arity(ck, sc, ck.p.ast.nodes.get(n.b).a, lw, n.tok)
end
end
walk_expr(ck, sc, n.a)
walk_expr(ck, sc, n.b)
walk_expr(ck, sc, n.c)
ret
end
if k == N_IN:
mut i := 0
until i < n.list.len():
bind_param(ck, sc, n.a, n.list.get(i))
i = i + 1
end
bind_param(ck, sc, n.a, n.b)
walk_expr(ck, sc, n.a)
if nd_kind(ck.p.ast, n.b) == N_SELECT or nd_kind(ck.p.ast, n.b) == N_SET_OP or nd_kind(ck.p.ast, n.b) == N_WITH:
mut want := 1
if nd_kind(ck.p.ast, n.a) == N_ROW:
want = ck.p.ast.nodes.get(n.a).list.len()
end
check_subquery_arity(ck, sc, n.b, want, n.tok)
else:
walk_expr(ck, sc, n.b)
end
walk_list(ck, sc, n.list)
ret
end
if k == N_BETWEEN:
bind_param(ck, sc, n.a, n.b)
bind_param(ck, sc, n.a, n.c)
walk_expr(ck, sc, n.a)
walk_expr(ck, sc, n.b)
walk_expr(ck, sc, n.c)
ret
end
if k == N_SUBQUERY or k == N_EXISTS:
mut rows := Vector {} as Vector<ResultCol>
select_results(ck, n.a, sc, rows, false)
rows.free()
ret
end
if k == N_FUNC or k == N_ROW or k == N_LIST:
walk_list(ck, sc, n.list)
ret
end
if k == N_CASE:
walk_expr(ck, sc, n.a)
walk_list(ck, sc, n.list)
walk_expr(ck, sc, n.b)
ret
end
if k == N_WHEN:
walk_expr(ck, sc, n.a)
walk_expr(ck, sc, n.b)
ret
end
if k == N_UNARY or k == N_CAST or k == N_ORDER_ITEM or k == N_RESULT_COL:
walk_expr(ck, sc, n.a)
ret
end
if k == N_SET_ITEM:
walk_expr(ck, sc, n.a)
end
end
func add_star_results(sc &: Scope, qual: str, out &: Vector<ResultCol>):
mut i := sc.base
until i < sc.cols.len():
if str.IsEmpty(qual) or str.EqualFold(sc.srcs.get(i), qual):
out.push(
ResultCol {
name = sc.cols.get(i), table = sc.srcs.get(i), kind = sc.kinds.get(i), nullable = sc.nulls.get(i)
}
)
end
i = i + 1
end
end
func result_name(ck &: Checker, id: int): str:
n := ck.p.ast.nodes.get(id)
if n.t2 >= 0:
ret c_name(ck, n.t2)
end
if nd_kind(ck.p.ast, n.a) == N_COLUMN_REF:
ret c_name(ck, ck.p.ast.nodes.get(n.a).tok)
end
inner := ck.p.ast.nodes.get(n.a)
if nd_kind(ck.p.ast, n.a) == N_FUNC:
ret c_name(ck, inner.tok)
end
ret ""
end
func build_from_scope(ck &: Checker, sc &: Scope, from: int, nullable: bool):
k := nd_kind(ck.p.ast, from)
if k == N_NONE:
ret
end
n := ck.p.ast.nodes.get(from)
if k == N_JOIN:
left_null := nullable or n.op == J_RIGHT or n.op == J_FULL
right_null := nullable or n.op == J_LEFT or n.op == J_FULL
left_at := sc.cols.len()
build_from_scope(ck, sc, n.a, left_null)
right_at := sc.cols.len()
build_from_scope(ck, sc, n.b, right_null)
if n.list.len() > 0:
check_using(ck, sc, from, left_at, right_at)
end
ret
end
if k != N_TABLE_REF:
ret
end
if n.a >= 0:
alias := n.t2 >= 0 ? c_name(ck, n.t2) : ""
mut rows := Vector {} as Vector<ResultCol>
mut empty := Scope {}
select_results(ck, n.a, empty, rows, true)
scope_free(empty)
if str.IsEmpty(alias):
c_warn(
ck, n.tok, "SQL322", "this subquery has no alias",
"name it with AS so its columns can be qualified"
)
end
scope_add_results(sc, alias, rows, nullable)
rows.free()
ret
end
if (n.flags & F_STAR) != 0:
name := n.t2 >= 0 ? c_name(ck, n.t2) : c_name(ck, n.tok)
scope_add_table(sc, name, Table { open = true }, nullable)
ret
end
tname := c_name(ck, n.tok)
mut t := Table {}
if not lookup_table(ck, tname, t):
mut names := Vector {} as Vector<str>
table_names(ck, names)
best := near_of(names, tname)
names.free()
if n.t1 >= 0:
scope_add_table(sc, tname, Table { open = true }, nullable)
ret
end
c_err(ck, n.tok, "SQL317", "no table named \"" + tname + "\"", did_you_mean(best))
scope_add_table(sc, tname, Table { open = true }, nullable)
ret
end
alias := n.t2 >= 0 ? c_name(ck, n.t2) : tname
if scope_find_src_here(sc, alias) >= 0:
c_err(
ck, n.t2 >= 0 ? n.t2 : n.tok, "SQL313", "\"" + alias + "\" is used twice in this FROM",
"give one of them a different alias"
)
end
scope_add_table(sc, alias, t, nullable)
end
func check_select_core(ck &: Checker, id: int, outer &: Scope, out &: Vector<ResultCol>, want: bool):
n := ck.p.ast.nodes.get(id)
mut sc := Scope {}
scope_inherit(sc, outer)
build_from_scope(ck, sc, n.a, false)
if str.IsEmpty(ck.table) and sc.names.len() > sc.base:
ck.table = sc.names.get(0)
end
walk_expr(ck, sc, n.b)
walk_expr(ck, sc, n.c)
walk_expr(ck, sc, n.d)
mut i := 0
until i < n.list.len():
rc := n.list.get(i)
rn := ck.p.ast.nodes.get(rc)
if (rn.flags & F_STAR) != 0:
mut qual := ""
if rn.t1 >= 0:
qual = c_name(ck, rn.t1)
if scope_find_src(sc, qual) < 0:
best := near_of(sc.names, qual)
c_err(
ck, rn.t1, "SQL310", "no table or alias named \"" + qual + "\" in this statement", did_you_mean(best)
)
end
end
if want:
add_star_results(sc, qual, out)
end
else:
walk_expr(ck, sc, rn.a)
if want:
mut nullable := true
kk := expr_kind(ck, sc, rn.a, nullable)
out.push(
ResultCol {
name = result_name(ck, rc), table = "", kind = kk, nullable = nullable
}
)
end
end
i = i + 1
end
if n.e >= 0:
walk_list(ck, sc, ck.p.ast.nodes.get(n.e).list)
end
walk_expr(ck, sc, n.f)
walk_expr(ck, sc, n.g)
check_group_by(ck, sc, id)
check_duplicate_aliases(ck, id)
check_limit_value(ck, n.f, "LIMIT")
check_limit_value(ck, n.g, "OFFSET")
if expr_has_aggregate(ck, n.b):
c_err(
ck, n.tok, "SQL328", "an aggregate cannot be used in WHERE",
"move the condition to HAVING, which runs after the grouping"
)
end
if want:
check_ordinals(ck, n.e, out.len(), "ORDER BY names column")
check_ordinals(ck, n.c, out.len(), "GROUP BY names column")
end
scope_free(sc)
end
func check_values(ck &: Checker, id: int, outer &: Scope, out &: Vector<ResultCol>, want: bool):
n := ck.p.ast.nodes.get(id)
mut sc := Scope {}
scope_inherit(sc, outer)
mut width := 0 - 1
mut i := 0
until i < n.list.len():
row := ck.p.ast.nodes.get(n.list.get(i))
if width < 0:
width = row.list.len()
else width != row.list.len():
c_err(
ck, row.tok, "SQL314", "this row has " + str.FromInt(row.list.len() as i64) + " values but the first row has " + str.FromInt(width as i64),
""
)
end
walk_list(ck, sc, row.list)
if want and i == 0:
mut j := 0
until j < row.list.len():
mut nullable := true
kk := expr_kind(ck, sc, row.list.get(j), nullable)
out.push(ResultCol { name = "", table = "", kind = kk, nullable = nullable })
j = j + 1
end
end
i = i + 1
end
scope_free(sc)
end
func select_results(ck &: Checker, id: int, outer &: Scope, out &: Vector<ResultCol>, want: bool):
k := nd_kind(ck.p.ast, id)
if k == N_NONE:
ret
end
n := ck.p.ast.nodes.get(id)
if k == N_WITH:
bind_ctes(ck, id)
select_results(ck, n.a, outer, out, want)
ret
end
if k == N_SET_OP:
select_results(ck, n.a, outer, out, want)
mut right := Vector {} as Vector<ResultCol>
select_results(ck, n.b, outer, right, true)
if out.len() > 0 and right.len() > 0 and out.len() != right.len():
c_err(
ck, n.tok, "SQL323", "the two sides of this set operation return " + str.FromInt(out.len() as i64) + " and " + str.FromInt(right.len() as i64) + " columns",
"both sides have to return the same number of columns"
)
end
right.free()
ret
end
if k == N_VALUES:
check_values(ck, id, outer, out, want)
ret
end
if k == N_SELECT:
check_select_core(ck, id, outer, out, want)
end
end
func bind_ctes(ck &: Checker, id: int):
n := ck.p.ast.nodes.get(id)
mut i := 0
until i < n.list.len():
cte := ck.p.ast.nodes.get(n.list.get(i))
name := c_name(ck, cte.tok)
if cat_find(ck.local, name) < 0:
tid := cat_add(ck.local, name, true)
mut rows := Vector {} as Vector<ResultCol>
mut empty := Scope {}
select_results(ck, cte.a, empty, rows, true)
scope_free(empty)
if cte.list.len() > 0:
mut j := 0
until j < cte.list.len():
cn := c_name(ck, ck.p.ast.nodes.get(cte.list.get(j)).tok)
mut kk := TYPE_UNKNOWN
if j < rows.len():
kk = rows.get(j).kind
end
cat_add_col(ck.local, tid, Column { name = str.Clone(cn), type_name = str.Clone(""), kind = kk })
j = j + 1
end
else:
mut j := 0
until j < rows.len():
r := rows.get(j)
if str.IsEmpty(r.name):
mut t := ck.local.tables.ref(tid)
t.open = true
else:
cat_add_col(ck.local, tid, Column { name = str.Clone(r.name), type_name = str.Clone(""), kind = r.kind })
end
j = j + 1
end
end
rows.free()
end
i = i + 1
end
end
func target_table(ck &: Checker, from: int, name &: str, t &: Table): bool:
if nd_kind(ck.p.ast, from) != N_TABLE_REF:
ret false
end
n := ck.p.ast.nodes.get(from)
if n.a >= 0:
ret false
end
name = c_name(ck, n.tok)
ret lookup_table(ck, name, t)
end
func check_write_col(ck &: Checker, t: Table, tname: str, ctok: int): int:
cname := c_name(ck, ctok)
ci := tab_find(t, cname)
if ci < 0:
if t.open:
ret 0 - 1
end
mut cands := Vector {} as Vector<str>
mut z := 0
until z < t.columns.len():
cands.push(t.columns.get(z).name)
z = z + 1
end
best := near_of(cands, cname)
cands.free()
c_err(
ck, ctok, "SQL311", "\"" + tname + "\" has no column \"" + cname + "\"", did_you_mean(best)
)
ret 0 - 1
end
if t.columns.get(ci).generated:
c_err(
ck, ctok, "SQL318", "column \"" + cname + "\" is generated and cannot be written",
"leave it out of the statement"
)
end
ret ci
end
func check_insert(ck &: Checker, id: int):
ck.kind = STMT_INSERT
n := ck.p.ast.nodes.get(id)
mut t := Table {}
mut tname := ""
if not target_table(ck, n.a, tname, t):
if not str.IsEmpty(tname):
mut names := Vector {} as Vector<str>
table_names(ck, names)
best := near_of(names, tname)
names.free()
c_err(
ck, ck.p.ast.nodes.get(n.a).tok, "SQL317", "no table named \"" + tname + "\"", did_you_mean(best)
)
end
ret
end
ck.table = tname
mut sc := Scope {}
scope_add_table(sc, tname, t, false)
trn := ck.p.ast.nodes.get(n.a)
if trn.t2 >= 0:
scope_add_table(sc, c_name(ck, trn.t2), t, false)
end
mut cols := Vector {} as Vector<int>
mut named := false
if n.d >= 0:
named = true
list := ck.p.ast.nodes.get(n.d).list
mut i := 0
until i < list.len():
ctok := ck.p.ast.nodes.get(list.get(i)).tok
ci := check_write_col(ck, t, tname, ctok)
if ci >= 0:
mut d := 0
until d < cols.len():
if cols.get(d) == ci:
c_err(
ck, ctok, "SQL316", "column \"" + c_name(ck, ctok) + "\" is listed twice", ""
)
break
end
d = d + 1
end
end
cols.push(ci)
i = i + 1
end
else:
mut i := 0
until i < t.columns.len():
cols.push(i)
i = i + 1
end
end
if n.b >= 0 and nd_kind(ck.p.ast, n.b) == N_VALUES:
rows := ck.p.ast.nodes.get(n.b).list
mut i := 0
until i < rows.len():
row := ck.p.ast.nodes.get(rows.get(i))
if row.list.len() != cols.len() and not t.open:
c_err(
ck, row.tok, "SQL314", "this row has " + str.FromInt(row.list.len() as i64) + " values but " + str.FromInt(cols.len() as i64) + " columns are expected",
named ? "the column list names " + str.FromInt(cols.len() as i64) + " columns" : "\"" + tname + "\" has " + str.FromInt(cols.len() as i64) + " columns"
)
end
mut j := 0
until j < row.list.len():
v := row.list.get(j)
if j < cols.len() and cols.get(j) >= 0 and nd_kind(ck.p.ast, v) == N_PARAM:
col := t.columns.get(cols.get(j))
note_param(ck, ck.p.ast.nodes.get(v).tok, col.kind, col.not_null, tname, col.name)
end
walk_expr(ck, sc, v)
j = j + 1
end
i = i + 1
end
if not t.open:
mut z := 0
until z < t.columns.len():
col := t.columns.get(z)
need := col.not_null and not col.has_default and not col.generated and not col.auto
if need:
mut present := false
mut d := 0
until d < cols.len():
if cols.get(d) == z:
present = true
end
d = d + 1
end
if not present:
if ck.p.d.id == SQLITE and col.primary:
c_warn(
ck, n.tok, "SQL335", "\"" + col.name + "\" is the primary key and this INSERT leaves it out",
"sqlite stores NULL there unless the column is declared INTEGER PRIMARY KEY"
)
else:
c_err(
ck, n.tok, "SQL315", "\"" + col.name + "\" is NOT NULL with no default and this INSERT leaves it out",
"add it to the column list and to every row"
)
end
end
end
z = z + 1
end
end
else n.b >= 0:
mut empty := Scope {}
mut rows := Vector {} as Vector<ResultCol>
select_results(ck, n.b, empty, rows, true)
scope_free(empty)
if rows.len() > 0 and rows.len() != cols.len() and not t.open:
c_err(
ck, n.tok, "SQL314", "this SELECT returns " + str.FromInt(rows.len() as i64) + " columns but " + str.FromInt(cols.len() as i64) + " are expected",
""
)
end
rows.free()
else n.f >= 0:
list := ck.p.ast.nodes.get(n.f).list
mut i := 0
until i < list.len():
it := ck.p.ast.nodes.get(list.get(i))
ci := check_write_col(ck, t, tname, it.tok)
if ci >= 0 and nd_kind(ck.p.ast, it.a) == N_PARAM:
col := t.columns.get(ci)
note_param(ck, ck.p.ast.nodes.get(it.a).tok, col.kind, col.not_null, tname, col.name)
end
walk_expr(ck, sc, it.a)
i = i + 1
end
end
if n.c >= 0:
conf := ck.p.ast.nodes.get(n.c)
if conf.a >= 0:
tlist := ck.p.ast.nodes.get(conf.a).list
mut ti := 0
until ti < tlist.len():
_tc := check_write_col(ck, t, tname, ck.p.ast.nodes.get(tlist.get(ti)).tok)
ti = ti + 1
end
end
mut i := 0
until i < conf.list.len():
it := ck.p.ast.nodes.get(conf.list.get(i))
ci := check_write_col(ck, t, tname, it.tok)
if ci >= 0 and nd_kind(ck.p.ast, it.a) == N_PARAM:
col := t.columns.get(ci)
note_param(ck, ck.p.ast.nodes.get(it.a).tok, col.kind, col.not_null, tname, col.name)
end
walk_expr(ck, sc, it.a)
i = i + 1
end
walk_expr(ck, sc, conf.b)
end
if n.e >= 0:
mut rl := ck.p.ast.nodes.get(n.e).list
mut i := 0
until i < rl.len():
rc := ck.p.ast.nodes.get(rl.get(i))
if (rc.flags & F_STAR) != 0:
if ck.want_results:
add_star_results(sc, "", ck.results)
end
else:
walk_expr(ck, sc, rc.a)
if ck.want_results:
mut nullable := true
kk := expr_kind(ck, sc, rc.a, nullable)
ck.results.push(ResultCol { name = result_name(ck, rl.get(i)), kind = kk, nullable = nullable })
end
end
i = i + 1
end
end
cols.free()
scope_free(sc)
end
func check_update(ck &: Checker, id: int):
ck.kind = STMT_UPDATE
n := ck.p.ast.nodes.get(id)
mut sc := Scope {}
build_from_scope(ck, sc, n.a, false)
build_from_scope(ck, sc, n.d, false)
mut t := Table {}
mut tname := ""
have := target_table(ck, n.a, tname, t)
ck.table = tname
if n.c >= 0:
list := ck.p.ast.nodes.get(n.c).list
mut written := Vector {} as Vector<int>
mut i := 0
until i < list.len():
it := ck.p.ast.nodes.get(list.get(i))
mut ci := 0 - 1
if have:
ci = check_write_col(ck, t, tname, it.tok)
end
if ci >= 0:
mut w := 0
until w < written.len():
if written.get(w) == ci:
c_err(
ck, it.tok, "SQL329", "\"" + c_name(ck, it.tok) + "\" is assigned twice in this SET",
"keep one assignment per column"
)
break
end
w = w + 1
end
written.push(ci)
end
if ci >= 0 and nd_kind(ck.p.ast, it.a) == N_PARAM:
col := t.columns.get(ci)
note_param(ck, ck.p.ast.nodes.get(it.a).tok, col.kind, col.not_null, tname, col.name)
end
walk_expr(ck, sc, it.a)
i = i + 1
end
written.free()
end
walk_expr(ck, sc, n.b)
if n.b < 0:
c_warn(
ck, n.tok, "SQL320", "this UPDATE has no WHERE clause and changes every row",
"add a WHERE clause, or say so in a comment"
)
end
if n.g >= 0:
walk_list(ck, sc, ck.p.ast.nodes.get(n.g).list)
end
if n.e >= 0:
walk_list(ck, sc, ck.p.ast.nodes.get(n.e).list)
end
scope_free(sc)
end
func check_delete(ck &: Checker, id: int):
ck.kind = STMT_DELETE
n := ck.p.ast.nodes.get(id)
mut sc := Scope {}
build_from_scope(ck, sc, n.a, false)
build_from_scope(ck, sc, n.d, false)
mut t := Table {}
mut tname := ""
_have := target_table(ck, n.a, tname, t)
ck.table = tname
walk_expr(ck, sc, n.b)
if n.b < 0:
c_warn(
ck, n.tok, "SQL320", "this DELETE has no WHERE clause and removes every row",
"add a WHERE clause, or use TRUNCATE when that is what you mean"
)
end
if n.e >= 0:
walk_list(ck, sc, ck.p.ast.nodes.get(n.e).list)
end
scope_free(sc)
end
func check_table_exists(ck &: Checker, tok: int, flags: int):
if tok < 0:
ret
end
name := c_name(ck, tok)
mut t := Table {}
if lookup_table(ck, name, t):
ret
end
if (flags & F_IF_EXISTS) != 0:
ret
end
mut names := Vector {} as Vector<str>
table_names(ck, names)
best := near_of(names, name)
names.free()
c_err(ck, tok, "SQL317", "no table named \"" + name + "\"", did_you_mean(best))
end
func check_create_index(ck &: Checker, id: int):
ck.kind = STMT_DDL
n := ck.p.ast.nodes.get(id)
check_table_exists(ck, n.t1, 0)
if n.t1 < 0:
ret
end
name := c_name(ck, n.t1)
mut t := Table {}
if not lookup_table(ck, name, t):
ret
end
mut sc := Scope {}
scope_add_table(sc, name, t, false)
walk_list(ck, sc, n.list)
walk_expr(ck, sc, n.b)
scope_free(sc)
end
func check_stmt(ck &: Checker, id: int):
k := nd_kind(ck.p.ast, id)
if k == N_NONE:
ret
end
n := ck.p.ast.nodes.get(id)
if k == N_WITH:
bind_ctes(ck, id)
check_stmt(ck, n.a)
ret
end
if k == N_SELECT or k == N_SET_OP or k == N_VALUES:
ck.kind = STMT_SELECT
mut empty := Scope {}
mut rows := Vector {} as Vector<ResultCol>
select_results(ck, id, empty, rows, true)
scope_free(empty)
if ck.want_results:
mut i := 0
until i < rows.len():
ck.results.push(rows.get(i))
i = i + 1
end
end
rows.free()
ret
end
if k == N_INSERT:
check_insert(ck, id)
ret
end
if k == N_UPDATE:
check_update(ck, id)
ret
end
if k == N_DELETE:
check_delete(ck, id)
ret
end
if k == N_CREATE_INDEX:
check_create_index(ck, id)
ret
end
if k == N_CREATE_VIEW:
ck.kind = STMT_DDL
mut empty := Scope {}
mut rows := Vector {} as Vector<ResultCol>
select_results(ck, n.a, empty, rows, false)
scope_free(empty)
rows.free()
ret
end
if k == N_DROP or k == N_TRUNCATE:
ck.kind = STMT_DDL
check_table_exists(ck, n.tok, n.flags)
ret
end
if k == N_ALTER_TABLE:
ck.kind = STMT_DDL
check_table_exists(ck, n.tok, n.flags)
ret
end
if k == N_CREATE_TABLE:
ck.kind = STMT_DDL
end
end
func a_own(a &: Analysis, s: str): str:
c := str.Clone(s)
a.owned.push(c)
ret c
end
func param_number(src: str, t: Token): int:
if t.len < 2:
ret 0
end
if src[t.off] != '$':
ret 0
end
mut v := 0
mut i := 1
until i < t.len:
c := src[t.off + i]
if not ch_digit(c):
ret 0
end
v = v * 10 + ((c as int) - 48)
i = i + 1
end
ret v
end
func collect_params(ck &: Checker, a &: Analysis):
mut ord := 0
mut highest := 0
mut seen := Vector {} as Vector<int>
mut i := 0
until i < ck.p.toks.len():
t := ck.p.toks.get(i)
if t.kind == TK_PARAM:
ord = ord + 1
num := param_number(ck.p.src, t)
if num > 0:
seen.push(num)
if num > highest:
highest = num
end
end
mut kind := TYPE_UNKNOWN
mut nn := false
mut tbl := ""
mut col := ""
mut j := 0
until j < ck.ptoks.len():
if ck.ptoks.get(j) == i:
kind = ck.pkinds.get(j)
nn = ck.pnulls.get(j)
tbl = ck.ptables.get(j)
col = ck.pcols.get(j)
break
end
j = j + 1
end
marker := tok_text(ck.p.src, t)
a.params.push(
Param {
marker = a_own(a, marker), ordinal = num > 0 ? num : ord, table = a_own(a, tbl), column = a_own(a, col),
kind = kind, not_null = nn
}
)
mem.Free(marker as void*)
end
i = i + 1
end
mut want := 1
until want < highest + 1:
mut found := false
mut k := 0
until k < seen.len():
if seen.get(k) == want:
found = true
end
k = k + 1
end
if not found:
add_diag(
ck.p.rep, ERROR, "SQL319", "this statement uses $" + str.FromInt(highest as i64) + " but never $" + str.FromInt(want as i64),
"numbered placeholders have to run from $1 upwards with no gaps", 1, 1, 0, 1
)
end
want = want + 1
end
seen.free()
end
func free_checker(ck &: Checker):
mut i := 0
until i < ck.owned.len():
mem.Free(ck.owned.get(i) as void*)
i = i + 1
end
ck.owned.free()
ck.ptoks.free()
ck.pkinds.free()
ck.pnulls.free()
ck.ptables.free()
ck.pcols.free()
ck.results.free()
FreeCatalog(ck.local)
free_parser(ck.p)
end
func run_check(ck &: Checker, sql: str, c: Catalog):
ck.cat = c
ck.local = NewCatalog(c.d)
parse_into(ck.p, sql, c.d)
if ck.p.rep.errors > 0:
ret
end
mut i := 0
until i < ck.p.ast.roots.len():
check_stmt(ck, ck.p.ast.roots.get(i))
i = i + 1
end
end
@en "Check"
@fa "بررسی"
pub func Check(sql: str, c: Catalog): Report:
mut ck := Checker {}
run_check(ck, sql, c)
out := ck.p.rep
free_checker(ck)
ret out
end
@en "Analyze"
@fa "تحلیل کن"
pub func Analyze(sql: str, c: Catalog): Analysis:
mut ck := Checker {}
ck.want_results = true
run_check(ck, sql, c)
mut a := Analysis {}
a.kind = ck.kind
collect_params(ck, a)
a.report = ck.p.rep
a.ok = ck.p.rep.errors == 0
a.table = a_own(a, ck.table)
mut i := 0
until i < ck.results.len():
r := ck.results.get(i)
a.results.push(
ResultCol {
name = a_own(a, r.name), table = a_own(a, r.table), kind = r.kind, nullable = r.nullable
}
)
i = i + 1
end
free_checker(ck)
ret a
end
@en "FreeAnalysis"
@fa "آزادسازی تحلیل"
pub func FreeAnalysis(a &: Analysis):
mut i := 0
until i < a.owned.len():
mem.Free(a.owned.get(i) as void*)
i = i + 1
end
a.owned.free()
a.params.free()
a.results.free()
FreeReport(a.report)
end
@en "StmtKindName"
@fa "نام دستور"
pub func StmtKindName(k: int): str:
if k == STMT_SELECT:
ret "select"
end
if k == STMT_INSERT:
ret "insert"
end
if k == STMT_UPDATE:
ret "update"
end
if k == STMT_DELETE:
ret "delete"
end
if k == STMT_DDL:
ret "ddl"
end
ret "unknown"
end
package sql
import str
import mem
const ARG_NULL := 0
const ARG_INT := 1
const ARG_FLOAT := 2
const ARG_TEXT := 3
const ARG_BOOL := 4
@en "Args"
@fa "مقدارها"
pub struct Args:
pub kinds: Vector<int> = Vector {}
pub ints: Vector<i64> = Vector {}
pub floats: Vector<f64> = Vector {}
pub texts: Vector<str> = Vector {}
pub bools: Vector<bool> = Vector {}
end
func args_push(a &: Args, kind: int, i: i64, f: f64, t: str, b: bool):
a.kinds.push(kind)
a.ints.push(i)
a.floats.push(f)
a.texts.push(t)
a.bools.push(b)
end
func quote_text(s: str, d: Dialect): str:
mut sb := str.NewBuilder()
str.BufAppend(sb, "'")
mut i := 0
until i < s.len():
c := s[i]
if c == '\'':
str.BufAppend(sb, "''")
else c == '\\' and d.backslash_escape:
str.BufAppend(sb, "\\\\")
else:
str.BufAppendChar(sb, c as int)
end
i = i + 1
end
str.BufAppend(sb, "'")
out := str.BufStr(sb)
str.BufFree(sb)
ret out
end
func arg_literal(a: Args, idx: int, d: Dialect): str:
kind := a.kinds.get(idx)
if kind == ARG_INT:
ret str.FromInt(a.ints.get(idx))
end
if kind == ARG_FLOAT:
ret str.FromFloat(a.floats.get(idx))
end
if kind == ARG_BOOL:
if d.id == POSTGRES:
ret str.Clone(a.bools.get(idx) ? "TRUE" : "FALSE")
end
ret str.Clone(a.bools.get(idx) ? "1" : "0")
end
if kind == ARG_TEXT:
ret quote_text(a.texts.get(idx), d)
end
ret str.Clone("NULL")
end
func marker_index(src: str, t: Token, ord: int): int:
if t.len < 2:
ret ord
end
if src[t.off] != '$':
ret ord
end
mut v := 0
mut i := 1
until i < t.len:
c := src[t.off + i]
if not ch_digit(c):
ret ord
end
v = v * 10 + ((c as int) - 48)
i = i + 1
end
if v < 1:
ret ord
end
ret v - 1
end
func marker_is_named(src: str, t: Token): bool:
if t.len < 1:
ret false
end
c := src[t.off]
ret c == ':' or c == '@'
end
@en "NewArgs"
@fa "مقدارهای تازه"
pub func NewArgs(): Args:
ret Args {}
end
@en "AddInt"
@fa "افزودن عدد"
pub func AddInt(a &: Args, v: i64):
args_push(a, ARG_INT, v, 0.0, "", false)
end
@en "AddFloat"
@fa "افزودن اعشار"
pub func AddFloat(a &: Args, v: f64):
args_push(a, ARG_FLOAT, 0 as i64, v, "", false)
end
@en "AddText"
@fa "افزودن متن"
pub func AddText(a &: Args, v: str):
args_push(a, ARG_TEXT, 0 as i64, 0.0, str.Clone(v), false)
end
@en "AddBool"
@fa "افزودن منطقی"
pub func AddBool(a &: Args, v: bool):
args_push(a, ARG_BOOL, 0 as i64, 0.0, "", v)
end
@en "AddNull"
@fa "افزودن خالی"
pub func AddNull(a &: Args):
args_push(a, ARG_NULL, 0 as i64, 0.0, "", false)
end
@en "ArgCount"
@fa "شمار مقدار"
pub func ArgCount(a: Args): int:
ret a.kinds.len()
end
@en "FreeArgs"
@fa "آزادسازی مقدارها"
pub func FreeArgs(a &: Args):
mut i := 0
until i < a.texts.len():
if a.kinds.get(i) == ARG_TEXT:
mem.Free(a.texts.get(i) as void*)
end
i = i + 1
end
a.kinds.free()
a.ints.free()
a.floats.free()
a.texts.free()
a.bools.free()
end
@en "Fill"
@fa "پرکردن"
pub func Fill(query: str, a: Args, d: Dialect, err &: Report): str:
mut l := Lexer { src = query, n = query.len(), d = d }
lex_into(l, err)
if err.errors > 0:
l.toks.free()
ret str.Clone("")
end
mut used := 0
mut ord := 0
mut i := 0
until i < l.toks.len():
t := l.toks.get(i)
if t.kind == TK_PARAM:
if marker_is_named(query, t):
add_diag(
err, ERROR, "SQL401", "a named placeholder cannot be filled in", "bind by position with ? or $1", t.line,
t.col, t.off, t.len
)
l.toks.free()
ret str.Clone("")
end
idx := marker_index(query, t, ord)
if idx + 1 > used:
used = idx + 1
end
ord = ord + 1
end
i = i + 1
end
if used != a.kinds.len():
add_diag(
err, ERROR, "SQL400", "this query takes " + str.FromInt(used as i64) + " values but got " + str.FromInt(a.kinds.len() as i64),
"add or remove an argument so the two agree", 1, 1, 0, 1
)
l.toks.free()
ret str.Clone("")
end
mut sb := str.NewBuilder()
mut pos := 0
mut k := 0
mut seq := 0
until k < l.toks.len():
t := l.toks.get(k)
if t.kind == TK_PARAM:
if t.off > pos:
piece := query.substr(pos, t.off - pos)
str.BufAppend(sb, piece)
mem.Free(piece as void*)
end
lit := arg_literal(a, marker_index(query, t, seq), d)
str.BufAppend(sb, lit)
mem.Free(lit as void*)
pos = t.off + t.len
seq = seq + 1
end
k = k + 1
end
n := query.len()
if pos < n:
tail := query.substr(pos, n - pos)
str.BufAppend(sb, tail)
mem.Free(tail as void*)
end
out := str.BufStr(sb)
str.BufFree(sb)
l.toks.free()
ret out
end
package sql
import str
import mem
@en "Q_ONE"
@fa "پرسمان یکی"
pub const Q_ONE := 0
@en "Q_MANY"
@fa "پرسمان چندی"
pub const Q_MANY := 1
@en "Q_EXEC"
@fa "پرسمان اجرا"
pub const Q_EXEC := 2
@en "Q_EXECROWS"
@fa "پرسمان شمار"
pub const Q_EXECROWS := 3
k_salam_words := [
"and", "as", "break", "component", "const", "continue", "deprecated", "defer", "dyn", "each",
"else", "end", "enum", "eq", "export", "extern", "false", "func", "gt", "gte", "if", "impl",
"import", "include", "inline", "input", "interface", "layout", "link", "lt", "lte", "match", "mut",
"neq", "noinline", "noret", "not", "null", "on", "or", "package", "print", "println", "pub", "pure",
"repeat", "ret", "static", "struct", "switch", "this", "to", "true", "type", "until", "use", "by"
]
@en "Query"
@fa "پرسمان"
pub struct Query:
pub name: str = ""
pub kind: int = 0
pub text: str = ""
pub line: int = 1
end
func is_salam_word(s: str): bool:
mut i := 0
until i < len(k_salam_words):
if str.Equals(s, k_salam_words[i]):
ret true
end
i = i + 1
end
ret false
end
func ident_ok(s: str): bool:
n := s.len()
if n == 0:
ret false
end
c := s[0]
if not ((c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or c == '_'):
ret false
end
mut i := 1
until i < n:
d := s[i]
if not ((d >= 'a' and d <= 'z') or (d >= 'A' and d <= 'Z') or (d >= '0' and d <= '9') or d == '_'):
ret false
end
i = i + 1
end
ret not is_salam_word(s)
end
func safe_name(raw: str, fallback: str, nth: int): str:
if ident_ok(raw):
ret str.Clone(raw)
end
ret fallback + str.FromInt(nth as i64)
end
func unique_name(taken &: Vector<str>, want: str): str:
mut n := 1
mut candidate := str.Clone(want)
until true:
mut hit := false
mut i := 0
until i < taken.len():
if str.Equals(taken.get(i), candidate):
hit = true
break
end
i = i + 1
end
if not hit:
taken.push(candidate)
ret candidate
end
mem.Free(candidate as void*)
n = n + 1
candidate = want + "_" + str.FromInt(n as i64)
end
end
func salam_string(s: str): str:
mut sb := str.NewBuilder()
str.BufAppend(sb, "\"")
mut i := 0
until i < s.len():
c := s[i]
if c == '"':
str.BufAppend(sb, "\\\"")
else c == '\\':
str.BufAppend(sb, "\\\\")
else c == '\n':
str.BufAppend(sb, "\\n")
else c == '\r':
str.BufAppend(sb, "\\r")
else c == '\t':
str.BufAppend(sb, "\\t")
else:
str.BufAppendChar(sb, c as int)
end
i = i + 1
end
str.BufAppend(sb, "\"")
out := str.BufStr(sb)
str.BufFree(sb)
ret out
end
func plain_type(kind: int): str:
if kind == TYPE_INT:
ret "i64"
end
if kind == TYPE_FLOAT:
ret "f64"
end
if kind == TYPE_BOOL:
ret "bool"
end
ret "str"
end
func zero_of(kind: int): str:
if kind == TYPE_INT:
ret "0 as i64"
end
if kind == TYPE_FLOAT:
ret "0.0"
end
if kind == TYPE_BOOL:
ret "false"
end
ret "\"\""
end
func reader_of(kind: int): str:
if kind == TYPE_INT:
ret "Int64"
end
if kind == TYPE_FLOAT:
ret "Float"
end
ret "Text"
end
func adder_of(kind: int): str:
if kind == TYPE_INT:
ret "AddInt"
end
if kind == TYPE_FLOAT:
ret "AddFloat"
end
if kind == TYPE_BOOL:
ret "AddBool"
end
ret "AddText"
end
func kind_word(k: str): int:
if str.Equals(k, "one"):
ret Q_ONE
end
if str.Equals(k, "many"):
ret Q_MANY
end
if str.Equals(k, "exec"):
ret Q_EXEC
end
if str.Equals(k, "execrows"):
ret Q_EXECROWS
end
ret 0 - 1
end
func trim_semi(s: str): str:
t := str.Trim(s)
n := t.len()
if n > 0 and t[n - 1] == ';':
out := t.substr(0, n - 1)
mem.Free(t as void*)
ret str.Trim(out)
end
ret t
end
func merge_report(err &: Report, from: Report, name: str, base: int):
mut i := 0
until i < from.items.len():
d := from.items.get(i)
add_diag(
err, d.severity, d.code, name + ": " + d.message, d.help, base + d.line, d.col, d.offset, d.length
)
i = i + 1
end
end
func read_expr(kind: int, col: int): str:
at := "(" + str.FromInt(col as i64) + ")"
if kind == TYPE_BOOL:
ret "r.Int64" + at + " != 0"
end
ret "r." + reader_of(kind) + at
end
func emit_reads(sb &: str.StringBuilder, a: Analysis, names: Vector<str>, pad: str):
mut i := 0
until i < a.results.len():
c := a.results.get(i)
field := names.get(i)
base := plain_type(c.kind)
if c.nullable:
str.BufAppend(sb, pad + "if r.IsNull(" + str.FromInt(i as i64) + "):\n")
str.BufAppend(sb, pad + "    out." + field + " = option.None() as option.Option<" + base + ">\n")
str.BufAppend(sb, pad + "else:\n")
str.BufAppend(sb, pad + "    out." + field + " = option.Some(" + read_expr(c.kind, i) + ")\n")
str.BufAppend(sb, pad + "end\n")
else:
str.BufAppend(sb, pad + "out." + field + " = " + read_expr(c.kind, i) + "\n")
end
i = i + 1
end
end
func emit_args(sb &: str.StringBuilder, a: Analysis, names: Vector<str>):
if a.params.len() == 0:
str.BufAppend(sb, "    a := sql.NewArgs()\n")
ret
end
str.BufAppend(sb, "    mut a := sql.NewArgs()\n")
mut i := 0
until i < a.params.len():
p := a.params.get(i)
str.BufAppend(sb, "    sql." + adder_of(p.kind) + "(a, " + names.get(i) + ")\n")
i = i + 1
end
end
func param_list(a: Analysis, names: Vector<str>): str:
mut sb := str.NewBuilder()
mut i := 0
until i < a.params.len():
str.BufAppend(sb, ", " + names.get(i) + ": " + plain_type(a.params.get(i).kind))
i = i + 1
end
out := str.BufStr(sb)
str.BufFree(sb)
ret out
end
func name_set(a: Analysis, want_results: bool, fallback: str): Vector<str>:
mut taken := Vector {} as Vector<str>
mut out := Vector {} as Vector<str>
n := want_results ? a.results.len() : a.params.len()
mut i := 0
until i < n:
mut raw := ""
if want_results:
raw = a.results.get(i).name
else:
raw = a.params.get(i).column
end
safe := safe_name(raw, fallback, i + 1)
out.push(unique_name(taken, safe))
mem.Free(safe as void*)
i = i + 1
end
taken.free()
ret out
end
func free_names(v &: Vector<str>):
mut i := 0
until i < v.len():
mem.Free(v.get(i) as void*)
i = i + 1
end
v.free()
end
@en "ParseQueries"
@fa "خواندن پرسمان ها"
pub func ParseQueries(src: str, err &: Report): Vector<Query>:
mut out := Vector {} as Vector<Query>
mut lines := str.Split(src, "\n")
mut name := ""
mut kind := 0 - 1
mut at := 0
mut body := str.NewBuilder()
mut have := false
mut i := 0
until i < lines.len():
raw := lines.get(i)
line := str.Trim(raw)
if str.StartsWith(line, "-- name:") or str.StartsWith(line, "--name:"):
if have:
text := trim_semi(str.BufStr(body))
out.push(Query { name = name, kind = kind, text = text, line = at })
str.BufFree(body)
body = str.NewBuilder()
end
rest := str.Trim(str.Substr(line, str.IndexOf(line, ":") + 1, line.len()))
mut parts := str.Fields(rest)
if parts.len() < 2:
add_diag(
err, ERROR, "SQL500", "a query header needs a name and a kind", "write '-- name: GetUser :one'", i + 1,
1, 0, 1
)
else:
nm := parts.get(0)
kw := parts.get(1)
k := kind_word(str.TrimPrefix(kw, ":"))
if not ident_ok(nm):
add_diag(
err, ERROR, "SQL501", "'" + nm + "' cannot be a Salam function name",
"use letters, digits and underscore, and not a keyword", i + 1, 1, 0, 1
)
end
if k < 0:
add_diag(
err, ERROR, "SQL502", "'" + kw + "' is not a query kind", "one of :one, :many, :exec or :execrows",
i + 1, 1, 0, 1
)
end
name = str.Clone(nm)
kind = k
at = i + 1
have = true
end
parts.free()
mem.Free(rest as void*)
mem.Free(line as void*)
i = i + 1
continue
end
if have and not str.StartsWith(line, "--"):
str.BufAppend(body, raw)
str.BufAppend(body, "\n")
end
mem.Free(line as void*)
i = i + 1
end
if have:
text := trim_semi(str.BufStr(body))
out.push(Query { name = name, kind = kind, text = text, line = at })
end
str.BufFree(body)
lines.free()
ret out
end
@en "FreeQueries"
@fa "آزادسازی پرسمان ها"
pub func FreeQueries(v &: Vector<Query>):
mut i := 0
until i < v.len():
q := v.get(i)
mem.Free(q.name as void*)
mem.Free(q.text as void*)
i = i + 1
end
v.free()
end
@en "Generate"
@fa "تولید کد"
pub func Generate(pkg: str, queries: Vector<Query>, c: Catalog, err &: Report): str:
mut analyses := Vector {} as Vector<Analysis>
mut needs_option := false
mut i := 0
until i < queries.len():
q := queries.get(i)
mut a := Analyze(q.text, c)
merge_report(err, a.report, q.name, q.line)
mut j := 0
until j < a.results.len():
if a.results.get(j).nullable:
needs_option = true
end
j = j + 1
end
analyses.push(a)
i = i + 1
end
mut sb := str.NewBuilder()
str.BufAppend(sb, "package " + pkg + "\n\n")
str.BufAppend(sb, "import db\n")
str.BufAppend(sb, "import db.sql\n")
str.BufAppend(sb, "import mem\n")
if needs_option:
str.BufAppend(sb, "import option\n")
end
str.BufAppend(sb, "\n")
mut k := 0
until k < queries.len():
q := queries.get(k)
a := analyses.get(k)
if q.kind == Q_ONE or q.kind == Q_MANY:
mut fields := name_set(a, true, "col")
str.BufAppend(sb, "struct " + q.name + "Row:\n")
mut f := 0
until f < a.results.len():
rc := a.results.get(f)
base := plain_type(rc.kind)
if rc.nullable:
str.BufAppend(
sb, "    pub " + fields.get(f) + ": option.Option<" + base + "> = option.None() as option.Option<" + base + ">\n"
)
else:
str.BufAppend(sb, "    pub " + fields.get(f) + ": " + base + " = " + zero_of(rc.kind) + "\n")
end
f = f + 1
end
if a.results.len() == 0:
str.BufAppend(sb, "    pub empty: bool = false\n")
end
str.BufAppend(sb, "end\n\n")
free_names(fields)
end
k = k + 1
end
if queries.len() > 0:
str.BufAppend(sb, "func fill_query(c: dyn db.Connection, raw: str, a: sql.Args): str:\n")
str.BufAppend(sb, "    mut rep := sql.Report {}\n")
str.BufAppend(sb, "    out := sql.Fill(raw, a, sql.DialectNamed(c.Kind()), rep)\n")
str.BufAppend(sb, "    sql.FreeReport(rep)\n")
str.BufAppend(sb, "    ret out\n")
str.BufAppend(sb, "end\n\n")
end
mut m := 0
until m < queries.len():
q := queries.get(m)
a := analyses.get(m)
mut pnames := name_set(a, false, "arg")
mut fields := name_set(a, true, "col")
plist := param_list(a, pnames)
sig := "pub func " + q.name + "(c: dyn db.Connection" + plist
if q.kind == Q_ONE:
str.BufAppend(sb, sig + ", ok &: bool): " + q.name + "Row:\n")
else q.kind == Q_MANY:
str.BufAppend(sb, sig + "): Vector<" + q.name + "Row>:\n")
else q.kind == Q_EXECROWS:
str.BufAppend(sb, sig + "): i64:\n")
else:
str.BufAppend(sb, sig + "): bool:\n")
end
mem.Free(plist as void*)
emit_args(sb, a, pnames)
str.BufAppend(sb, "    q := fill_query(c, " + salam_string(q.text) + ", a)\n")
str.BufAppend(sb, "    sql.FreeArgs(a)\n")
if q.kind == Q_ONE:
str.BufAppend(sb, "    mut out := " + q.name + "Row {}\n")
str.BufAppend(sb, "    ok = false\n")
str.BufAppend(sb, "    r := c.Query(q)\n")
str.BufAppend(sb, "    if r.Ok():\n")
str.BufAppend(sb, "        if r.Next():\n")
emit_reads(sb, a, fields, "            ")
str.BufAppend(sb, "            ok = true\n")
str.BufAppend(sb, "        end\n")
str.BufAppend(sb, "        r.Close()\n")
str.BufAppend(sb, "    end\n")
str.BufAppend(sb, "    mem.Free(q as void*)\n")
str.BufAppend(sb, "    ret out\n")
else q.kind == Q_MANY:
str.BufAppend(sb, "    mut rows := Vector {} as Vector<" + q.name + "Row>\n")
str.BufAppend(sb, "    r := c.Query(q)\n")
str.BufAppend(sb, "    if r.Ok():\n")
str.BufAppend(sb, "        until r.Next():\n")
str.BufAppend(sb, "            mut out := " + q.name + "Row {}\n")
emit_reads(sb, a, fields, "            ")
str.BufAppend(sb, "            rows.push(out)\n")
str.BufAppend(sb, "        end\n")
str.BufAppend(sb, "        r.Close()\n")
str.BufAppend(sb, "    end\n")
str.BufAppend(sb, "    mem.Free(q as void*)\n")
str.BufAppend(sb, "    ret rows\n")
else q.kind == Q_EXECROWS:
str.BufAppend(sb, "    rc := c.Exec(q)\n")
str.BufAppend(sb, "    mut n := 0 as i64\n")
str.BufAppend(sb, "    if rc == 0:\n")
str.BufAppend(sb, "        n = c.Changes()\n")
str.BufAppend(sb, "    end\n")
str.BufAppend(sb, "    mem.Free(q as void*)\n")
str.BufAppend(sb, "    ret n\n")
else:
str.BufAppend(sb, "    done := c.Exec(q) == 0\n")
str.BufAppend(sb, "    mem.Free(q as void*)\n")
str.BufAppend(sb, "    ret done\n")
end
str.BufAppend(sb, "end\n")
if m + 1 < queries.len():
str.BufAppend(sb, "\n")
end
free_names(pnames)
free_names(fields)
m = m + 1
end
out := str.BufStr(sb)
str.BufFree(sb)
mut z := 0
until z < analyses.len():
mut a := analyses.get(z)
FreeAnalysis(a)
z = z + 1
end
analyses.free()
ret out
end
package sql
import str
const TK_EOF := 0
const TK_IDENT := 1
const TK_KEYWORD := 2
const TK_NUMBER := 3
const TK_STRING := 4
const TK_BLOB := 5
const TK_PARAM := 6
const TK_SYM := 7
const CH_NUL := '\x00'
k_sql_keywords := [
"ABORT", "ACTION", "ADD", "AFTER", "ALL", "ALTER", "ALWAYS", "ANALYZE", "AND", "ANY", "AS", "ASC",
"ATTACH", "AUTOINCREMENT", "AUTO_INCREMENT", "BEFORE", "BEGIN", "BETWEEN", "BINARY", "BOTH", "BY",
"CASCADE", "CASE", "CAST", "CHANGE", "CHARACTER", "CHECK", "COLLATE", "COLUMN", "COMMENT", "COMMIT",
"CONFLICT", "CONSTRAINT", "CREATE", "CROSS", "CURRENT", "CURRENT_DATE", "CURRENT_TIME",
"CURRENT_TIMESTAMP", "DATABASE", "DEFAULT", "DEFERRABLE", "DEFERRED", "DELAYED", "DELETE", "DESC",
"DETACH", "DISTINCT", "DO", "DROP", "DUPLICATE", "EACH", "ELSE", "END", "ESCAPE", "EXCEPT",
"EXCLUDE", "EXCLUSIVE", "EXISTS", "EXPLAIN", "FAIL", "FALSE", "FETCH", "FILTER", "FIRST",
"FOLLOWING", "FOR", "FOREIGN", "FROM", "FULL", "GENERATED", "GLOB", "GROUP", "GROUPS", "HAVING",
"HIGH_PRIORITY", "IDENTITY", "IF", "IGNORE", "ILIKE", "IMMEDIATE", "IN", "INDEX", "INDEXED",
"INITIALLY", "INNER", "INSERT", "INSTEAD", "INTERSECT", "INTO", "IS", "ISNULL", "JOIN", "KEY",
"LAST", "LATERAL", "LEADING", "LEFT", "LIKE", "LIMIT", "LOCK", "LOW_PRIORITY", "MATCH",
"MATERIALIZED", "MODIFY", "NATURAL", "NEXT", "NO", "NOT", "NOTHING", "NOTNULL", "NULL", "NULLS",
"OF", "OFFSET", "ON", "ONLY", "OPTION", "OR", "ORDER", "OTHERS", "OUTER", "OVER", "PARTITION",
"PLAN", "PRAGMA", "PRECEDING", "PRIMARY", "QUERY", "RAISE", "RANGE", "RECURSIVE", "REFERENCES",
"REGEXP", "REINDEX", "RELEASE", "RENAME", "REPLACE", "RESTART", "RESTRICT", "RETURNING", "RIGHT",
"ROLLBACK", "ROW", "ROWID", "ROWS", "SAVEPOINT", "SELECT", "SEPARATOR", "SET", "SHARE", "SOME",
"STORED", "STRAIGHT_JOIN", "TABLE", "TEMP", "TEMPORARY", "THEN", "TIES", "TO", "TRAILING",
"TRANSACTION", "TRIGGER", "TRUE", "TRUNCATE", "UNBOUNDED", "UNION", "UNIQUE", "UNSIGNED", "UPDATE",
"USING", "VACUUM", "VALUES", "VERBOSE", "VIEW", "VIRTUAL", "WHEN", "WHERE", "WINDOW", "WITH",
"WITHIN", "WITHOUT", "ZEROFILL"
]
k_sql_hard_keywords := [
"ALL", "AND", "AS", "ASC", "BETWEEN", "BY", "CASE", "CROSS", "DEFAULT", "DELETE", "DESC",
"DISTINCT", "ELSE", "END", "EXCEPT", "EXISTS", "FROM", "FULL", "GROUP", "HAVING", "IN", "INNER",
"INSERT", "INTERSECT", "INTO", "IS", "JOIN", "LEFT", "LIKE", "LIMIT", "NATURAL", "NOT", "NULL",
"OFFSET", "ON", "OR", "ORDER", "OUTER", "RETURNING", "RIGHT", "SELECT", "SET", "THEN", "UNION",
"UPDATE", "USING", "VALUES", "WHEN", "WHERE", "WITH"
]
struct Token:
pub kind: int = 0
pub off: int = 0
pub len: int = 0
pub line: int = 1
pub col: int = 1
pub quote: char = CH_NUL
pub sub: char = CH_NUL
end
struct Lexer:
pub src: str = ""
pub n: int = 0
pub i: int = 0
pub line: int = 1
pub col: int = 1
pub d: Dialect = Dialect {}
pub toks: Vector<Token> = Vector {}
end
func char_to_text(c: char): str:
empty := ""
ret empty + c
end
func ch_upper(c: char): char:
if c >= 'a' and c <= 'z':
ret ((c as int) - 32) as char
end
ret c
end
func ch_digit(c: char): bool:
ret c >= '0' and c <= '9'
end
func ch_hex(c: char): bool:
ret ch_digit(c) or (c >= 'a' and c <= 'f') or (c >= 'A' and c <= 'F')
end
func ch_high(c: char): bool:
ret c > '\x7F' or c < '\x00'
end
func ch_ident_start(c: char): bool:
ret (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or c == '_' or ch_high(c)
end
func ch_ident_part(c: char): bool:
ret ch_ident_start(c) or ch_digit(c) or c == '$'
end
func range_eq_fold(src: str, off: int, n: int, word: str): bool:
if n != word.len(): ret false end
mut i := 0
until i < n:
if ch_upper(src[off + i]) != ch_upper(word[i]):
ret false
end
i = i + 1
end
ret true
end
func kw_index(src: str, off: int, n: int): int:
if n < 2 or n > 17: ret 0 - 1 end
mut i := 0
until i < len(k_sql_keywords):
if range_eq_fold(src, off, n, k_sql_keywords[i]):
ret i
end
i = i + 1
end
ret 0 - 1
end
func lx_cur(l: Lexer): char:
if l.i >= l.n: ret CH_NUL end
ret l.src[l.i]
end
func lx_peek(l: Lexer, k: int): char:
j := l.i + k
if j >= l.n: ret CH_NUL end
ret l.src[j]
end
func lx_bump(l &: Lexer):
if l.i >= l.n: ret end
if l.src[l.i] == '\n':
l.line = l.line + 1
l.col = 1
else:
l.col = l.col + 1
end
l.i = l.i + 1
end
func lx_push(l &: Lexer, kind: int, off: int, line: int, col: int, q: char):
l.toks.push(Token { kind = kind, off = off, len = l.i - off, line = line, col = col, quote = q })
end
func lx_push_sub(l &: Lexer, kind: int, off: int, line: int, col: int, sub: char):
l.toks.push(Token { kind = kind, off = off, len = l.i - off, line = line, col = col, sub = sub })
end
func bump_n(l &: Lexer, n: int):
mut k := 0
until k < n:
lx_bump(l)
k = k + 1
end
end
func cp_at(l: Lexer): int:
if l.i >= l.n:
ret 0 - 1
end
c0 := (l.src[l.i] as int) & 255
if c0 < 128:
ret c0
end
if c0 >= 192 and c0 < 224 and l.i + 1 < l.n:
c1 := (l.src[l.i + 1] as int) & 63
ret ((c0 & 31) << 6) | c1
end
if c0 >= 224 and c0 < 240 and l.i + 2 < l.n:
c1 := (l.src[l.i + 1] as int) & 63
c2 := (l.src[l.i + 2] as int) & 63
ret ((c0 & 15) << 12) | (c1 << 6) | c2
end
ret 0 - 1
end
func cp_width(cp: int): int:
if cp < 128:
ret 1
end
if cp < 2048:
ret 2
end
ret 3
end
func cp_is_eastern_digit(cp: int): bool:
if cp >= 0x06F0 and cp <= 0x06F9:
ret true
end
ret cp >= 0x0660 and cp <= 0x0669
end
func cp_is_curly_quote(cp: int): bool:
if cp == 0x2018 or cp == 0x2019 or cp == 0x201C or cp == 0x201D:
ret true
end
ret cp == 0x00AB or cp == 0x00BB
end
func cp_is_foreign_punct(cp: int): bool:
if cp == 0x00A0 or cp == 0x200B or cp == 0xFEFF:
ret true
end
if cp_is_curly_quote(cp):
ret true
end
if cp == 0x060C or cp == 0x066B or cp == 0x061B or cp == 0x061F:
ret true
end
if cp == 0x00D7 or cp == 0x2212 or cp == 0x2013 or cp == 0x2014:
ret true
end
ret cp == 0xFF08 or cp == 0xFF09
end
func word_breaks_here(l: Lexer): bool:
if not ch_high(lx_cur(l)):
ret false
end
ret cp_is_foreign_punct(cp_at(l))
end
func lx_eastern_number(l &: Lexer, r &: Report):
off := l.i
line := l.line
col := l.col
until true:
cp := cp_at(l)
if cp_is_eastern_digit(cp):
bump_n(l, cp_width(cp))
continue
end
if cp >= 48 and cp <= 57:
lx_bump(l)
continue
end
break
end
add_diag(
r, ERROR, "SQL007", "numbers in SQL have to be written with ASCII digits",
"write 0 to 9 instead of the Persian or Arabic digits", line, col, off, l.i - off
)
lx_push(l, TK_NUMBER, off, line, col, CH_NUL)
end
func lx_curly_string(l &: Lexer, r &: Report):
off := l.i
line := l.line
col := l.col
bump_n(l, cp_width(cp_at(l)))
mut closed := false
until l.i < l.n:
cp := cp_at(l)
if cp == '\n' as int:
break
end
if cp_is_curly_quote(cp):
bump_n(l, cp_width(cp))
closed = true
break
end
bump_n(l, cp_width(cp))
end
if closed:
add_diag(
r, ERROR, "SQL008", "this text is quoted with typographic quotes",
"SQL strings are quoted with ' ... '", line, col, off, l.i - off
)
else:
add_diag(
r, ERROR, "SQL001", "unterminated string literal", "SQL strings are quoted with ' ... '", line, col,
off, l.i - off
)
end
lx_push(l, TK_STRING, off, line, col, '\'')
end
func lx_foreign(l &: Lexer, r &: Report, cp: int): bool:
if cp < 128:
ret false
end
if cp == 0x00A0 or cp == 0x200B or cp == 0x200C or cp == 0x200D or cp == 0xFEFF:
off := l.i
line := l.line
col := l.col
bump_n(l, cp_width(cp))
add_diag(
r, ERROR, "SQL006", "an invisible character is in this statement",
"delete it: only a plain space separates words in SQL", line, col, off, l.i - off
)
ret true
end
if cp_is_eastern_digit(cp):
lx_eastern_number(l, r)
ret true
end
if cp_is_curly_quote(cp):
lx_curly_string(l, r)
ret true
end
mut sub := CH_NUL
mut label := ""
if cp == 0x060C or cp == 0x066B:
sub = ','
label = "an Arabic comma"
else cp == 0x061B:
sub = ';'
label = "an Arabic semicolon"
else cp == 0x061F:
sub = '?'
label = "an Arabic question mark"
else cp == 0x00D7:
sub = '*'
label = "a multiplication sign"
else cp == 0x2212 or cp == 0x2013 or cp == 0x2014:
sub = '-'
label = "a dash"
else cp == 0xFF08:
sub = '('
label = "a wide parenthesis"
else cp == 0xFF09:
sub = ')'
label = "a wide parenthesis"
else:
ret false
end
off := l.i
line := l.line
col := l.col
bump_n(l, cp_width(cp))
one := l.src.substr(off, l.i - off)
add_diag(
r, ERROR, "SQL005", label + " '" + one + "' is not SQL punctuation", "write '" + char_to_text(sub) + "' instead",
line, col, off, l.i - off
)
lx_push_sub(l, TK_SYM, off, line, col, sub)
ret true
end
func lx_line_comment(l &: Lexer):
until l.i < l.n and lx_cur(l) != '\n':
lx_bump(l)
end
end
func lx_trivia(l &: Lexer, r &: Report):
until l.i < l.n:
c := lx_cur(l)
if c == ' ' or c == '\t' or c == '\n' or c == '\r' or c == '\x0B' or c == '\x0C':
lx_bump(l)
continue
end
if c == '-' and lx_peek(l, 1) == '-':
lx_line_comment(l)
continue
end
if c == '#' and l.d.hash_comment:
lx_line_comment(l)
continue
end
if c == '/' and lx_peek(l, 1) == '*':
off := l.i
line := l.line
col := l.col
lx_bump(l)
lx_bump(l)
mut closed := false
until l.i < l.n:
if lx_cur(l) == '*' and lx_peek(l, 1) == '/':
lx_bump(l)
lx_bump(l)
closed = true
break
end
lx_bump(l)
end
if not closed:
add_diag(
r, ERROR, "SQL002", "unterminated block comment", "close the comment with */", line, col, off, l.i - off
)
end
continue
end
break
end
end
func lx_string(l &: Lexer, r &: Report, q: char, kind: int, prefix: int):
off := l.i
line := l.line
col := l.col
mut k := 0
until k < prefix:
lx_bump(l)
k = k + 1
end
lx_bump(l)
mut closed := false
until l.i < l.n:
c := lx_cur(l)
if c == '\\' and l.d.backslash_escape:
lx_bump(l)
if l.i < l.n: lx_bump(l) end
continue
end
if c == q:
if lx_peek(l, 1) == q:
lx_bump(l)
lx_bump(l)
continue
end
lx_bump(l)
closed = true
break
end
lx_bump(l)
end
if not closed:
add_diag(
r, ERROR, "SQL001", "unterminated string literal", "close it with a matching quote", line, col, off,
l.i - off
)
end
lx_push(l, kind, off, line, col, q)
end
func lx_qident(l &: Lexer, r &: Report, close: char, doubling: bool):
off := l.i
line := l.line
col := l.col
lx_bump(l)
mut closed := false
until l.i < l.n:
c := lx_cur(l)
if c == close:
if doubling and lx_peek(l, 1) == close:
lx_bump(l)
lx_bump(l)
continue
end
lx_bump(l)
closed = true
break
end
lx_bump(l)
end
if not closed:
add_diag(
r, ERROR, "SQL003", "unterminated quoted name", "close the name with a matching quote", line, col,
off, l.i - off
)
end
lx_push(l, TK_IDENT, off, line, col, close)
end
func lx_number(l &: Lexer):
off := l.i
line := l.line
col := l.col
if lx_cur(l) == '0' and (lx_peek(l, 1) == 'x' or lx_peek(l, 1) == 'X'):
lx_bump(l)
lx_bump(l)
until l.i < l.n and ch_hex(lx_cur(l)):
lx_bump(l)
end
lx_push(l, TK_NUMBER, off, line, col, CH_NUL)
ret
end
until l.i < l.n and ch_digit(lx_cur(l)):
lx_bump(l)
end
if lx_cur(l) == '.':
lx_bump(l)
until l.i < l.n and ch_digit(lx_cur(l)):
lx_bump(l)
end
end
c := lx_cur(l)
if c == 'e' or c == 'E':
nx := lx_peek(l, 1)
signed_exp := (nx == '+' or nx == '-') and ch_digit(lx_peek(l, 2))
if ch_digit(nx) or signed_exp:
lx_bump(l)
if lx_cur(l) == '+' or lx_cur(l) == '-':
lx_bump(l)
end
until l.i < l.n and ch_digit(lx_cur(l)):
lx_bump(l)
end
end
end
lx_push(l, TK_NUMBER, off, line, col, CH_NUL)
end
func lx_dollar_string(l &: Lexer, r &: Report): bool:
mut j := l.i + 1
until j < l.n and l.src[j] != '$' and ch_ident_part(l.src[j]):
j = j + 1
end
if j >= l.n:
ret false
end
if l.src[j] != '$':
ret false
end
tag_len := j + 1 - l.i
off := l.i
line := l.line
col := l.col
mut k := 0
until k < tag_len:
lx_bump(l)
k = k + 1
end
mut closed := false
until l.i < l.n:
if lx_cur(l) == '$' and l.i + tag_len <= l.n and bytes_eq(l.src, l.i, off, tag_len):
mut m := 0
until m < tag_len:
lx_bump(l)
m = m + 1
end
closed = true
break
end
lx_bump(l)
end
if not closed:
add_diag(
r, ERROR, "SQL001", "unterminated dollar-quoted string",
"close it with the same $tag$ it opened with", line, col, off, l.i - off
)
end
lx_push(l, TK_STRING, off, line, col, '$')
ret true
end
func bytes_eq(src: str, a: int, b: int, n: int): bool:
mut i := 0
until i < n:
if src[a + i] != src[b + i]:
ret false
end
i = i + 1
end
ret true
end
func lx_param(l &: Lexer, r &: Report):
off := l.i
line := l.line
col := l.col
c := lx_cur(l)
lx_bump(l)
if c == '?':
until l.i < l.n and ch_digit(lx_cur(l)):
lx_bump(l)
end
if not l.d.qmark_param:
add_diag(
r, ERROR, "SQL201", "'?' is not a placeholder in " + l.d.name,
"postgres numbers its placeholders: $1, $2", line, col, off, l.i - off
)
end
else c == '$':
until l.i < l.n and ch_ident_part(lx_cur(l)):
lx_bump(l)
end
if not l.d.numbered_param:
add_diag(
r, ERROR, "SQL202", "'$1' is not a placeholder in " + l.d.name,
"this driver binds by position with ?", line, col, off, l.i - off
)
end
else:
until l.i < l.n and ch_ident_part(lx_cur(l)):
lx_bump(l)
end
if not l.d.named_param:
add_diag(
r, ERROR, "SQL203", "named placeholders are not supported by " + l.d.name,
"bind by position instead", line, col, off, l.i - off
)
end
end
lx_push(l, TK_PARAM, off, line, col, c)
end
func sym_width(l: Lexer, c: char): int:
nx := lx_peek(l, 1)
if c == '<' and (nx == '>' or nx == '=' or nx == '<'): ret 2 end
if c == '>' and (nx == '=' or nx == '>'): ret 2 end
if c == '!' and nx == '=': ret 2 end
if c == '=' and nx == '=': ret 2 end
if c == '|' and nx == '|': ret 2 end
if c == '&' and nx == '&': ret 2 end
if c == ':' and nx == ':': ret 2 end
if c == '-' and nx == '>':
if lx_peek(l, 2) == '>': ret 3 end
ret 2
end
if c == '#' and nx == '>':
if lx_peek(l, 2) == '>': ret 3 end
ret 2
end
if c == '@' and nx == '>': ret 2 end
if c == '@' and nx == '@': ret 2 end
if c == '^' and nx == '@': ret 2 end
if c == '~' and nx == '*': ret 2 end
if c == '?' and (nx == '|' or nx == '&'): ret 2 end
if c == '!' and nx == '~':
if lx_peek(l, 2) == '*': ret 3 end
ret 2
end
if c == '<' and nx == '-':
if lx_peek(l, 2) == '>': ret 3 end
ret 1
end
if c == '<' and nx == '@': ret 2 end
ret 1
end
func sym_known(c: char): bool:
if c == '(' or c == ')' or c == ',' or c == '.' or c == ';':
ret true
end
if c == '*' or c == '+' or c == '-' or c == '/' or c == '%':
ret true
end
if c == '=' or c == '<' or c == '>' or c == '!':
ret true
end
if c == '|' or c == '&' or c == '^' or c == '~':
ret true
end
if c == '[' or c == ']' or c == '{' or c == '}':
ret true
end
if c == ':' or c == '#' or c == '@' or c == '?':
ret true
end
ret false
end
func lx_sym(l &: Lexer, r &: Report):
off := l.i
line := l.line
col := l.col
c := lx_cur(l)
if not sym_known(c):
lx_bump(l)
add_diag(
r, ERROR, "SQL004", "unexpected character in SQL", "remove it or quote it as part of a literal",
line, col, off, 1
)
ret
end
w := sym_width(l, c)
mut k := 0
until k < w:
lx_bump(l)
k = k + 1
end
lx_push(l, TK_SYM, off, line, col, CH_NUL)
end
func lx_word(l &: Lexer):
off := l.i
line := l.line
col := l.col
until l.i < l.n and ch_ident_part(lx_cur(l)) and not word_breaks_here(l):
lx_bump(l)
end
mut kind := TK_IDENT
if kw_index(l.src, off, l.i - off) >= 0:
kind = TK_KEYWORD
end
lx_push(l, kind, off, line, col, CH_NUL)
end
func lex_into(l &: Lexer, r &: Report):
until true:
lx_trivia(l, r)
if l.i >= l.n:
break
end
c := lx_cur(l)
nx := lx_peek(l, 1)
if c == '\'':
lx_string(l, r, '\'', TK_STRING, 0)
continue
end
if c == '"':
if l.d.double_quoted_string:
lx_string(l, r, '"', TK_STRING, 0)
else:
lx_qident(l, r, '"', true)
end
continue
end
if c == '`':
if l.d.backtick_ident:
lx_qident(l, r, '`', true)
else:
off := l.i
line := l.line
col := l.col
lx_bump(l)
add_diag(
r, ERROR, "SQL204", "backtick names are not supported by " + l.d.name,
"quote the name with \" instead", line, col, off, 1
)
end
continue
end
if c == '[' and l.d.bracket_ident:
lx_qident(l, r, ']', false)
continue
end
if (c == 'x' or c == 'X' or c == 'b' or c == 'B') and nx == '\'':
lx_string(l, r, '\'', TK_BLOB, 1)
continue
end
if (c == 'e' or c == 'E' or c == 'n' or c == 'N') and nx == '\'':
lx_string(l, r, '\'', TK_STRING, 1)
continue
end
if ch_digit(c):
lx_number(l)
continue
end
if c == '.' and ch_digit(nx):
lx_number(l)
continue
end
if c == '$' and l.d.dollar_string and not ch_digit(nx):
if lx_dollar_string(l, r):
continue
end
end
if c == '?' and l.d.qmark_param:
lx_param(l, r)
continue
end
if c == '$' and ch_digit(nx):
lx_param(l, r)
continue
end
if (c == ':' and nx != ':' and ch_ident_start(nx)) or (c == '@' and ch_ident_start(nx)):
lx_param(l, r)
continue
end
if ch_high(c):
if lx_foreign(l, r, cp_at(l)):
continue
end
end
if ch_ident_start(c):
lx_word(l)
continue
end
lx_sym(l, r)
end
l.toks.push(Token { kind = TK_EOF, off = l.n, len = 0, line = l.line, col = l.col })
end
func tok_text(src: str, t: Token): str:
ret src.substr(t.off, t.len)
end
func tok_is_kw(src: str, t: Token, word: str): bool:
if t.kind != TK_KEYWORD: ret false end
ret range_eq_fold(src, t.off, t.len, word)
end
func tok_is_sym(src: str, t: Token, word: str): bool:
if t.kind != TK_SYM:
ret false
end
if t.sub != CH_NUL:
if word.len() != 1:
ret false
end
ret word[0] == t.sub
end
ret range_eq_fold(src, t.off, t.len, word)
end
func tok_is_hard_kw(src: str, t: Token): bool:
if t.kind != TK_KEYWORD: ret false end
mut i := 0
until i < len(k_sql_hard_keywords):
if range_eq_fold(src, t.off, t.len, k_sql_hard_keywords[i]):
ret true
end
i = i + 1
end
ret false
end
func tok_name(src: str, t: Token): str:
if t.quote == CH_NUL or t.len < 2:
ret src.substr(t.off, t.len)
end
inner := src.substr(t.off + 1, t.len - 2)
if t.quote == ']':
ret inner
end
dq := t.quote == '"' ? "\"\"" : "``"
one := t.quote == '"' ? "\"" : "`"
ret str.Replace(inner, dq, one)
end
package sql
const F_REPLACE := 16384
const F_IGNORE := 32768
k_sql_type_words := [
"BINARY", "CHARACTER", "PRECISION", "SET", "ENUM", "UNSIGNED", "ZEROFILL", "VARYING", "NATIONAL",
"TIME", "ZONE", "WITH", "WITHOUT", "KEY"
]
struct Parser:
pub src: str = ""
pub toks: Vector<Token> = Vector {}
pub i: int = 0
pub d: Dialect = Dialect {}
pub ast: Ast = Ast {}
pub rep: Report = Report {}
pub failed: bool = false
end
func p_tok(p: Parser): Token:
ret p.toks.get(p.i)
end
func p_kind(p: Parser): int:
ret p.toks.get(p.i).kind
end
func p_next(p &: Parser):
if p.toks.get(p.i).kind != TK_EOF:
p.i = p.i + 1
end
end
func p_is_kw(p: Parser, w: str): bool:
ret tok_is_kw(p.src, p.toks.get(p.i), w)
end
func p_is_sym(p: Parser, w: str): bool:
ret tok_is_sym(p.src, p.toks.get(p.i), w)
end
func p_kw_at(p: Parser, k: int, w: str): bool:
j := p.i + k
if j >= p.toks.len():
ret false
end
ret tok_is_kw(p.src, p.toks.get(j), w)
end
func p_sym_at(p: Parser, k: int, w: str): bool:
j := p.i + k
if j >= p.toks.len():
ret false
end
ret tok_is_sym(p.src, p.toks.get(j), w)
end
func p_eat_kw(p &: Parser, w: str): bool:
if p_is_kw(p, w):
p_next(p)
ret true
end
ret false
end
func p_eat_sym(p &: Parser, w: str): bool:
if p_is_sym(p, w):
p_next(p)
ret true
end
ret false
end
func p_skip_kw(p &: Parser, w: str):
if p_is_kw(p, w):
p_next(p)
end
end
func p_skip_sym(p &: Parser, w: str):
if p_is_sym(p, w):
p_next(p)
end
end
func tok_desc(src: str, t: Token): str:
if t.kind == TK_EOF:
ret "the end of the statement"
end
ret "'" + src.substr(t.off, t.len) + "'"
end
func p_err(p &: Parser, code: str, message: str, help: str):
if p.failed:
ret
end
t := p.toks.get(p.i)
mut n := t.len
if n < 1:
n = 1
end
add_diag(p.rep, ERROR, code, message, help, t.line, t.col, t.off, n)
p.failed = true
end
func p_err_at(p &: Parser, idx: int, code: str, message: str, help: str):
t := p.toks.get(idx)
mut n := t.len
if n < 1:
n = 1
end
add_diag(p.rep, ERROR, code, message, help, t.line, t.col, t.off, n)
end
func p_expect_sym(p &: Parser, w: str, ctx: str):
if p_eat_sym(p, w):
ret
end
p_err(p, "SQL101", "expected '" + w + "' " + ctx + ", found " + tok_desc(p.src, p_tok(p)), "")
end
func p_expect_kw(p &: Parser, w: str, ctx: str):
if p_eat_kw(p, w):
ret
end
p_err(p, "SQL101", "expected " + w + " " + ctx + ", found " + tok_desc(p.src, p_tok(p)), "")
end
func p_name_here(p: Parser): bool:
t := p.toks.get(p.i)
if t.kind == TK_IDENT:
ret true
end
if t.kind != TK_KEYWORD:
ret false
end
ret not tok_is_hard_kw(p.src, t)
end
func p_take_name(p &: Parser): int:
if p_name_here(p):
idx := p.i
p_next(p)
ret idx
end
p_err(
p, "SQL102", "expected a name, found " + tok_desc(p.src, p_tok(p)),
"a reserved word has to be quoted to be used as a name"
)
ret 0 - 1
end
func type_word_here(p: Parser): bool:
t := p.toks.get(p.i)
if t.kind == TK_IDENT:
ret true
end
if t.kind != TK_KEYWORD:
ret false
end
mut i := 0
until i < len(k_sql_type_words):
if tok_is_kw(p.src, t, k_sql_type_words[i]):
ret true
end
i = i + 1
end
ret false
end
func num_is_float(src: str, t: Token): bool:
mut i := 0
until i < t.len:
c := src[t.off + i]
if c == '.' or c == 'e' or c == 'E':
ret true
end
i = i + 1
end
ret false
end
func mk_bin(p &: Parser, op: int, left: int, right: int, tk: int): int:
id := nd_new(p.ast, N_BINARY, tk)
nd_set_op(p.ast, id, op)
nd_set_a(p.ast, id, left)
nd_set_b(p.ast, id, right)
ret id
end
func parse_type_name(p &: Parser, id: int):
if not type_word_here(p):
ret
end
first := p.i
mut last := p.i
p_next(p)
until type_word_here(p):
last = p.i
p_next(p)
end
if p_is_sym(p, "("):
mut depth := 0
until p_kind(p) != TK_EOF:
if p_is_sym(p, "("):
depth = depth + 1
else p_is_sym(p, ")"):
depth = depth - 1
end
last = p.i
p_next(p)
if depth == 0:
break
end
end
end
until type_word_here(p):
last = p.i
p_next(p)
end
until p_is_sym(p, "["):
last = p.i
p_next(p)
if p_kind(p) == TK_NUMBER:
last = p.i
p_next(p)
end
if not p_is_sym(p, "]"):
p_err(p, "SQL116", "expected ']' after the array type, found " + tok_desc(p.src, p_tok(p)), "")
break
end
last = p.i
p_next(p)
end
nd_set_t1(p.ast, id, first)
nd_set_t2(p.ast, id, last)
end
func skip_balanced(p &: Parser):
if not p_is_sym(p, "("):
ret
end
mut depth := 0
until p_kind(p) != TK_EOF:
if p_is_sym(p, "("):
depth = depth + 1
else p_is_sym(p, ")"):
depth = depth - 1
end
p_next(p)
if depth == 0:
break
end
end
end
func skip_window(p &: Parser):
if p_eat_kw(p, "FILTER"):
skip_balanced(p)
end
if p_eat_kw(p, "WITHIN"):
p_skip_kw(p, "GROUP")
skip_balanced(p)
end
if p_eat_kw(p, "OVER"):
if p_is_sym(p, "("):
skip_balanced(p)
else:
_wn := p_take_name(p)
end
end
end
func parse_expr_items(p &: Parser, items &: Vector<int>):
until true:
if p.failed:
break
end
e := parse_expr(p)
if e >= 0:
items.push(e)
end
if not p_eat_sym(p, ","):
break
end
end
end
func parse_name_items(p &: Parser, items &: Vector<int>):
until true:
if p.failed:
break
end
nm := p_take_name(p)
if nm < 0:
break
end
items.push(nd_new(p.ast, N_NAME, nm))
if not p_eat_sym(p, ","):
break
end
end
end
func parse_func(p &: Parser, name_tok: int): int:
id := nd_new(p.ast, N_FUNC, name_tok)
p_next(p)
if p_eat_kw(p, "DISTINCT"):
nd_add_flag(p.ast, id, F_DISTINCT)
else:
p_skip_kw(p, "ALL")
end
mut args := Vector {} as Vector<int>
if not p_is_sym(p, ")"):
until true:
if p.failed:
break
end
if p_is_sym(p, "*"):
tk := p.i
p_next(p)
args.push(nd_new(p.ast, N_STAR, tk))
nd_add_flag(p.ast, id, F_STAR)
else:
e := parse_expr(p)
if e >= 0:
args.push(e)
end
end
if p_eat_kw(p, "ORDER"):
p_skip_kw(p, "BY")
mut extra := Vector {} as Vector<int>
parse_expr_items(p, extra)
extra.free()
p_skip_kw(p, "SEPARATOR")
if p_kind(p) == TK_STRING:
p_next(p)
end
end
if not p_eat_sym(p, ","):
break
end
end
end
nd_set_list(p.ast, id, args)
p_expect_sym(p, ")", "after the function arguments")
skip_window(p)
ret id
end
func parse_case(p &: Parser): int:
tk := p.i
p_next(p)
id := nd_new(p.ast, N_CASE, tk)
if not p_is_kw(p, "WHEN"):
nd_set_a(p.ast, id, parse_expr(p))
end
mut arms := Vector {} as Vector<int>
until p.failed == false and p_is_kw(p, "WHEN"):
wtk := p.i
p_next(p)
cond := parse_expr(p)
p_expect_kw(p, "THEN", "after the WHEN condition")
val := parse_expr(p)
arm := nd_new(p.ast, N_WHEN, wtk)
nd_set_a(p.ast, arm, cond)
nd_set_b(p.ast, arm, val)
arms.push(arm)
end
nd_set_list(p.ast, id, arms)
if arms.len() == 0 and not p.failed:
p_err(p, "SQL106", "CASE needs at least one WHEN branch", "")
end
if p_eat_kw(p, "ELSE"):
nd_set_b(p.ast, id, parse_expr(p))
end
p_expect_kw(p, "END", "to close CASE")
ret id
end
func parse_cast(p &: Parser): int:
tk := p.i
p_next(p)
id := nd_new(p.ast, N_CAST, tk)
p_expect_sym(p, "(", "after CAST")
nd_set_a(p.ast, id, parse_expr(p))
p_expect_kw(p, "AS", "in CAST")
parse_type_name(p, id)
p_expect_sym(p, ")", "to close CAST")
ret id
end
func parse_primary(p &: Parser): int:
t := p_tok(p)
tk := p.i
if t.kind == TK_NUMBER:
p_next(p)
id := nd_new(p.ast, N_LITERAL, tk)
nd_set_op(p.ast, id, num_is_float(p.src, t) ? LIT_FLOAT : LIT_INT)
ret id
end
if t.kind == TK_STRING:
p_next(p)
id := nd_new(p.ast, N_LITERAL, tk)
nd_set_op(p.ast, id, LIT_STRING)
ret id
end
if t.kind == TK_BLOB:
p_next(p)
id := nd_new(p.ast, N_LITERAL, tk)
nd_set_op(p.ast, id, LIT_BLOB)
ret id
end
if t.kind == TK_PARAM:
p_next(p)
ret nd_new(p.ast, N_PARAM, tk)
end
if p_is_kw(p, "NULL"):
p_next(p)
id := nd_new(p.ast, N_LITERAL, tk)
nd_set_op(p.ast, id, LIT_NULL)
ret id
end
if p_is_kw(p, "TRUE") or p_is_kw(p, "FALSE"):
p_next(p)
id := nd_new(p.ast, N_LITERAL, tk)
nd_set_op(p.ast, id, LIT_BOOL)
ret id
end
if p_is_kw(p, "CURRENT_DATE") or p_is_kw(p, "CURRENT_TIME") or p_is_kw(p, "CURRENT_TIMESTAMP"):
p_next(p)
id := nd_new(p.ast, N_LITERAL, tk)
nd_set_op(p.ast, id, LIT_CURRENT)
ret id
end
if p_is_kw(p, "CASE"):
ret parse_case(p)
end
if p_is_kw(p, "CAST"):
ret parse_cast(p)
end
if p_is_kw(p, "EXISTS"):
p_next(p)
id := nd_new(p.ast, N_EXISTS, tk)
p_expect_sym(p, "(", "after EXISTS")
nd_set_a(p.ast, id, parse_select_stmt(p))
p_expect_sym(p, ")", "after the EXISTS subquery")
ret id
end
if p_is_sym(p, "("):
p_next(p)
if p_is_kw(p, "SELECT") or p_is_kw(p, "WITH") or p_is_kw(p, "VALUES"):
id := nd_new(p.ast, N_SUBQUERY, tk)
nd_set_a(p.ast, id, parse_select_stmt(p))
p_expect_sym(p, ")", "after the subquery")
ret id
end
mut items := Vector {} as Vector<int>
parse_expr_items(p, items)
p_expect_sym(p, ")", "to close the group")
if items.len() == 1:
only := items.get(0)
items.free()
ret only
end
id := nd_new(p.ast, N_ROW, tk)
nd_set_list(p.ast, id, items)
ret id
end
if p_is_kw(p, "DEFAULT"):
p_next(p)
ret nd_new(p.ast, N_DEFAULT, tk)
end
if p_is_kw(p, "VALUES") and p_sym_at(p, 1, "("):
p_next(p)
ret parse_func(p, tk)
end
if p_name_here(p):
n1 := p.i
p_next(p)
if p_is_sym(p, "("):
ret parse_func(p, n1)
end
if p_kind(p) == TK_STRING:
p_next(p)
id := nd_new(p.ast, N_LITERAL, tk)
nd_set_op(p.ast, id, LIT_STRING)
ret id
end
mut col := n1
mut tbl := 0 - 1
mut sch := 0 - 1
if p_is_sym(p, "."):
p_next(p)
if p_is_sym(p, "*"):
p_next(p)
id := nd_new(p.ast, N_STAR, n1)
nd_set_t1(p.ast, id, n1)
ret id
end
n2 := p_take_name(p)
if n2 < 0:
ret 0 - 1
end
tbl = n1
col = n2
if p_is_sym(p, "."):
p_next(p)
n3 := p_take_name(p)
if n3 < 0:
ret 0 - 1
end
sch = n1
tbl = n2
col = n3
end
end
id := nd_new(p.ast, N_COLUMN_REF, col)
nd_set_t1(p.ast, id, tbl)
nd_set_t2(p.ast, id, sch)
ret id
end
if p_is_sym(p, "?"):
p_err(
p, "SQL201", "'?' is not a placeholder in " + p.d.name, "postgres numbers its placeholders: $1, $2"
)
ret 0 - 1
end
p_err(
p, "SQL105", "expected a value, found " + tok_desc(p.src, t),
"a column name, a literal, a function call or a placeholder goes here"
)
ret 0 - 1
end
func parse_postfix(p &: Parser): int:
mut e := parse_primary(p)
until p.failed == false:
if p_is_sym(p, "::"):
tk := p.i
if not p.d.colon_cast:
p_err(
p, "SQL206", "'::' casts are postgres only", "write CAST(x AS type) instead"
)
break
end
p_next(p)
id := nd_new(p.ast, N_CAST, tk)
nd_set_a(p.ast, id, e)
parse_type_name(p, id)
e = id
continue
end
if p_is_kw(p, "COLLATE"):
p_next(p)
_cn := p_take_name(p)
continue
end
break
end
ret e
end
func parse_unary(p &: Parser): int:
tk := p.i
if p_is_sym(p, "-") or p_is_sym(p, "+") or p_is_sym(p, "~"):
neg := p_is_sym(p, "-")
bnot := p_is_sym(p, "~")
p_next(p)
inner := parse_unary(p)
if not neg and not bnot:
ret inner
end
id := nd_new(p.ast, N_UNARY, tk)
nd_set_op(p.ast, id, neg ? OP_NEG : OP_BITNOT)
nd_set_a(p.ast, id, inner)
ret id
end
ret parse_postfix(p)
end
func parse_concat(p &: Parser): int:
mut left := parse_unary(p)
until p.failed == false:
mut op := 0
mut pg_only := false
if p_is_sym(p, "||"):
op = OP_CONCAT
else p_is_sym(p, "->") or p_is_sym(p, "->>"):
op = OP_JSON
else p_is_sym(p, "#>") or p_is_sym(p, "#>>"):
op = OP_JSON_PATH
pg_only = true
end
if op == 0:
break
end
tk := p.i
if pg_only and p.d.id != POSTGRES:
p_err(
p, "SQL214", "this json operator is postgres only",
"sqlite and mysql reach into json with the json_extract family"
)
break
end
p_next(p)
right := parse_unary(p)
left = mk_bin(p, op, left, right, tk)
end
ret left
end
func parse_mul(p &: Parser): int:
mut left := parse_concat(p)
until p.failed == false:
mut op := 0
if p_is_sym(p, "*"):
op = OP_MUL
else p_is_sym(p, "/"):
op = OP_DIV
else p_is_sym(p, "%"):
op = OP_MOD
end
if op == 0:
break
end
tk := p.i
p_next(p)
right := parse_concat(p)
left = mk_bin(p, op, left, right, tk)
end
ret left
end
func parse_add(p &: Parser): int:
mut left := parse_mul(p)
until p.failed == false:
mut op := 0
if p_is_sym(p, "+"):
op = OP_ADD
else p_is_sym(p, "-"):
op = OP_SUB
end
if op == 0:
break
end
tk := p.i
p_next(p)
right := parse_mul(p)
left = mk_bin(p, op, left, right, tk)
end
ret left
end
func parse_shift(p &: Parser): int:
mut left := parse_add(p)
until p.failed == false:
mut op := 0
if p_is_sym(p, "<<"):
op = OP_SHL
else p_is_sym(p, ">>"):
op = OP_SHR
end
if op == 0:
break
end
tk := p.i
p_next(p)
right := parse_add(p)
left = mk_bin(p, op, left, right, tk)
end
ret left
end
func parse_bit(p &: Parser): int:
mut left := parse_shift(p)
until p.failed == false:
mut op := 0
if p_is_sym(p, "&"):
op = OP_BITAND
else p_is_sym(p, "|"):
op = OP_BITOR
else p_is_sym(p, "^"):
op = OP_BITXOR
end
if op == 0:
break
end
tk := p.i
p_next(p)
right := parse_shift(p)
left = mk_bin(p, op, left, right, tk)
end
ret left
end
func pg_sym_op(p: Parser): bool:
if p_is_sym(p, "@>") or p_is_sym(p, "<@") or p_is_sym(p, "@@"):
ret true
end
if p_is_sym(p, "~") or p_is_sym(p, "~*") or p_is_sym(p, "!~") or p_is_sym(p, "!~*"):
ret true
end
if p_is_sym(p, "?") or p_is_sym(p, "?|") or p_is_sym(p, "?&"):
ret true
end
ret p_is_sym(p, "^@") or p_is_sym(p, "<->")
end
func cmp_sym_op(p: Parser): int:
if pg_sym_op(p):
ret OP_CONTAINS
end
if p_is_sym(p, "=") or p_is_sym(p, "=="):
ret OP_EQ
end
if p_is_sym(p, "<>") or p_is_sym(p, "!="):
ret OP_NE
end
if p_is_sym(p, "<="):
ret OP_LE
end
if p_is_sym(p, ">="):
ret OP_GE
end
if p_is_sym(p, "<"):
ret OP_LT
end
if p_is_sym(p, ">"):
ret OP_GT
end
ret 0
end
func match_op_here(p: Parser): int:
if p_is_kw(p, "LIKE"):
ret OP_LIKE
end
if p_is_kw(p, "ILIKE"):
ret OP_ILIKE
end
if p_is_kw(p, "GLOB"):
ret OP_GLOB
end
if p_is_kw(p, "REGEXP"):
ret OP_REGEXP
end
if p_is_kw(p, "MATCH"):
ret OP_MATCH
end
ret 0
end
func parse_cmp(p &: Parser): int:
mut left := parse_bit(p)
until p.failed == false:
op := cmp_sym_op(p)
if op != 0:
tk := p.i
if op == OP_CONTAINS and p.d.id != POSTGRES:
p_err(
p, "SQL214", "this operator is postgres only",
"sqlite and mysql have no operator spelled like this"
)
break
end
p_next(p)
p_skip_kw(p, "ANY")
p_skip_kw(p, "SOME")
p_skip_kw(p, "ALL")
right := parse_bit(p)
left = mk_bin(p, op, left, right, tk)
continue
end
mut neg := false
if p_is_kw(p, "NOT"):
nxt_ok := p_kw_at(p, 1, "LIKE") or p_kw_at(p, 1, "ILIKE") or p_kw_at(p, 1, "IN")
nxt_ok2 := p_kw_at(p, 1, "BETWEEN") or p_kw_at(p, 1, "GLOB") or p_kw_at(p, 1, "REGEXP")
if nxt_ok or nxt_ok2 or p_kw_at(p, 1, "MATCH"):
neg = true
p_next(p)
else:
break
end
end
if p_is_kw(p, "IS"):
tk := p.i
p_next(p)
isneg := p_eat_kw(p, "NOT")
if p_eat_kw(p, "DISTINCT"):
p_expect_kw(p, "FROM", "after IS DISTINCT")
end
right := parse_bit(p)
id := mk_bin(p, OP_IS, left, right, tk)
if isneg:
nd_add_flag(p.ast, id, F_NOT)
end
left = id
continue
end
if p_is_kw(p, "IN"):
tk := p.i
p_next(p)
id := nd_new(p.ast, N_IN, tk)
nd_set_a(p.ast, id, left)
if neg:
nd_add_flag(p.ast, id, F_NOT)
end
if p_eat_sym(p, "("):
if p_is_kw(p, "SELECT") or p_is_kw(p, "WITH") or p_is_kw(p, "VALUES"):
nd_set_b(p.ast, id, parse_select_stmt(p))
else:
mut items := Vector {} as Vector<int>
if not p_is_sym(p, ")"):
parse_expr_items(p, items)
end
nd_set_list(p.ast, id, items)
end
p_expect_sym(p, ")", "after the IN list")
else:
nd_set_b(p.ast, id, parse_bit(p))
end
left = id
continue
end
if p_is_kw(p, "BETWEEN"):
tk := p.i
p_next(p)
lo := parse_bit(p)
p_expect_kw(p, "AND", "between the two bounds of BETWEEN")
hi := parse_bit(p)
id := nd_new(p.ast, N_BETWEEN, tk)
nd_set_a(p.ast, id, left)
nd_set_b(p.ast, id, lo)
nd_set_c(p.ast, id, hi)
if neg:
nd_add_flag(p.ast, id, F_NOT)
end
left = id
continue
end
mop := match_op_here(p)
if mop != 0:
tk := p.i
if mop == OP_ILIKE and not p.d.ilike:
p_err(
p, "SQL205", "ILIKE is postgres only",
"use LOWER(x) LIKE LOWER(y), or LIKE on a case-insensitive column"
)
break
end
p_next(p)
right := parse_bit(p)
id := mk_bin(p, mop, left, right, tk)
if neg:
nd_add_flag(p.ast, id, F_NOT)
end
if p_eat_kw(p, "ESCAPE"):
nd_set_c(p.ast, id, parse_bit(p))
end
left = id
continue
end
if neg:
p_err(p, "SQL107", "expected LIKE, IN, BETWEEN or MATCH after NOT", "")
end
break
end
ret left
end
func parse_not(p &: Parser): int:
if p_is_kw(p, "NOT"):
tk := p.i
p_next(p)
inner := parse_not(p)
id := nd_new(p.ast, N_UNARY, tk)
nd_set_op(p.ast, id, OP_NOT)
nd_set_a(p.ast, id, inner)
ret id
end
ret parse_cmp(p)
end
func parse_and(p &: Parser): int:
mut left := parse_not(p)
until p.failed == false and p_is_kw(p, "AND"):
tk := p.i
p_next(p)
right := parse_not(p)
left = mk_bin(p, OP_AND, left, right, tk)
end
ret left
end
func parse_expr(p &: Parser): int:
mut left := parse_and(p)
until p.failed == false and p_is_kw(p, "OR"):
tk := p.i
p_next(p)
right := parse_and(p)
left = mk_bin(p, OP_OR, left, right, tk)
end
ret left
end
func parse_values(p &: Parser): int:
tk := p.i
p_next(p)
id := nd_new(p.ast, N_VALUES, tk)
mut rows := Vector {} as Vector<int>
until true:
if p.failed:
break
end
rtk := p.i
p_expect_sym(p, "(", "before a VALUES row")
row := nd_new(p.ast, N_ROW, rtk)
mut items := Vector {} as Vector<int>
if not p_is_sym(p, ")"):
parse_expr_items(p, items)
end
nd_set_list(p.ast, row, items)
p_expect_sym(p, ")", "after a VALUES row")
rows.push(row)
if not p_eat_sym(p, ","):
break
end
end
nd_set_list(p.ast, id, rows)
ret id
end
func parse_alias(p &: Parser, id: int):
if p_eat_kw(p, "AS"):
al := p_take_name(p)
nd_set_t2(p.ast, id, al)
ret
end
if p_name_here(p):
nd_set_t2(p.ast, id, p.i)
p_next(p)
end
end
func parse_join_op(p &: Parser): int:
mut kind := 0 - 1
natural := p_eat_kw(p, "NATURAL")
if p_is_kw(p, "LEFT"):
kind = J_LEFT
p_next(p)
p_skip_kw(p, "OUTER")
else p_is_kw(p, "RIGHT"):
kind = J_RIGHT
p_next(p)
p_skip_kw(p, "OUTER")
else p_is_kw(p, "FULL"):
kind = J_FULL
p_next(p)
p_skip_kw(p, "OUTER")
else p_is_kw(p, "INNER"):
kind = J_INNER
p_next(p)
else p_is_kw(p, "CROSS"):
kind = J_CROSS
p_next(p)
end
if p_is_kw(p, "JOIN"):
p_next(p)
if kind < 0:
ret J_INNER
end
ret kind
end
if natural or kind >= 0:
p_err(p, "SQL103", "expected JOIN, found " + tok_desc(p.src, p_tok(p)), "")
end
ret 0 - 1
end
func parse_table_or_sub(p &: Parser): int:
tk := p.i
if p_is_sym(p, "("):
p_next(p)
if p_is_kw(p, "SELECT") or p_is_kw(p, "WITH") or p_is_kw(p, "VALUES"):
id := nd_new(p.ast, N_TABLE_REF, tk)
nd_set_a(p.ast, id, parse_select_stmt(p))
p_expect_sym(p, ")", "after the subquery")
parse_alias(p, id)
ret id
end
inner := parse_from(p)
p_expect_sym(p, ")", "after the joined tables")
ret inner
end
p_skip_kw(p, "LATERAL")
nm := p_take_name(p)
if nm < 0:
ret 0 - 1
end
id := nd_new(p.ast, N_TABLE_REF, nm)
if p_is_sym(p, "."):
p_next(p)
n2 := p_take_name(p)
if n2 < 0:
ret id
end
nd_set_t1(p.ast, id, nm)
nd_set_tok(p.ast, id, n2)
end
if p_is_sym(p, "("):
nd_add_flag(p.ast, id, F_STAR)
skip_balanced(p)
end
parse_alias(p, id)
if p_eat_kw(p, "INDEXED"):
p_expect_kw(p, "BY", "after INDEXED")
_ix := p_take_name(p)
end
if p_is_kw(p, "NOT") and p_kw_at(p, 1, "INDEXED"):
p_next(p)
p_next(p)
end
ret id
end
func parse_from(p &: Parser): int:
mut left := parse_table_or_sub(p)
until p.failed == false:
if p_is_sym(p, ","):
tk := p.i
p_next(p)
right := parse_table_or_sub(p)
j := nd_new(p.ast, N_JOIN, tk)
nd_set_op(p.ast, j, J_CROSS)
nd_set_a(p.ast, j, left)
nd_set_b(p.ast, j, right)
left = j
continue
end
tk := p.i
kind := parse_join_op(p)
if kind < 0:
break
end
right := parse_table_or_sub(p)
j := nd_new(p.ast, N_JOIN, tk)
nd_set_op(p.ast, j, kind)
nd_set_a(p.ast, j, left)
nd_set_b(p.ast, j, right)
if p_eat_kw(p, "ON"):
nd_set_c(p.ast, j, parse_expr(p))
else p_eat_kw(p, "USING"):
p_expect_sym(p, "(", "after USING")
mut cols := Vector {} as Vector<int>
parse_name_items(p, cols)
nd_set_list(p.ast, j, cols)
p_expect_sym(p, ")", "after the USING columns")
end
left = j
end
ret left
end
func parse_result_col(p &: Parser): int:
tk := p.i
if p_is_sym(p, "*"):
p_next(p)
id := nd_new(p.ast, N_RESULT_COL, tk)
nd_add_flag(p.ast, id, F_STAR)
ret id
end
if p_name_here(p) and p_sym_at(p, 1, ".") and p_sym_at(p, 2, "*"):
q := p.i
p_next(p)
p_next(p)
p_next(p)
id := nd_new(p.ast, N_RESULT_COL, tk)
nd_add_flag(p.ast, id, F_STAR)
nd_set_t1(p.ast, id, q)
ret id
end
e := parse_expr(p)
id := nd_new(p.ast, N_RESULT_COL, tk)
nd_set_a(p.ast, id, e)
if p_eat_kw(p, "AS"):
nd_set_t2(p.ast, id, p_take_name(p))
else p_name_here(p):
nd_set_t2(p.ast, id, p.i)
p_next(p)
end
ret id
end
func parse_result_cols(p &: Parser, owner: int):
mut items := Vector {} as Vector<int>
until true:
if p.failed:
break
end
c := parse_result_col(p)
if c >= 0:
items.push(c)
end
if not p_eat_sym(p, ","):
break
end
end
nd_set_list(p.ast, owner, items)
end
func parse_order_items(p &: Parser, owner: int):
mut items := Vector {} as Vector<int>
until true:
if p.failed:
break
end
tk := p.i
e := parse_expr(p)
it := nd_new(p.ast, N_ORDER_ITEM, tk)
nd_set_a(p.ast, it, e)
if p_eat_kw(p, "DESC"):
nd_add_flag(p.ast, it, F_DESC)
else:
p_skip_kw(p, "ASC")
end
if p_eat_kw(p, "NULLS"):
p_skip_kw(p, "FIRST")
p_skip_kw(p, "LAST")
end
items.push(it)
if not p_eat_sym(p, ","):
break
end
end
nd_set_list(p.ast, owner, items)
end
func parse_limit(p &: Parser, target: int):
if p_eat_kw(p, "LIMIT"):
tk := p.i
first := parse_expr(p)
if p_eat_sym(p, ","):
if not p.d.limit_comma:
p_err_at(
p, tk, "SQL207", "LIMIT a, b is not supported by " + p.d.name,
"write LIMIT count OFFSET start instead"
)
end
nd_set_g(p.ast, target, first)
nd_set_f(p.ast, target, parse_expr(p))
else:
nd_set_f(p.ast, target, first)
if p_eat_kw(p, "OFFSET"):
nd_set_g(p.ast, target, parse_expr(p))
end
end
ret
end
if p_eat_kw(p, "OFFSET"):
nd_set_g(p.ast, target, parse_expr(p))
if p_eat_kw(p, "FETCH"):
p_skip_kw(p, "FIRST")
p_skip_kw(p, "NEXT")
nd_set_f(p.ast, target, parse_expr(p))
p_skip_kw(p, "ROW")
p_skip_kw(p, "ROWS")
p_skip_kw(p, "ONLY")
end
end
end
func parse_select_core(p &: Parser): int:
tk := p.i
if p_is_kw(p, "VALUES"):
ret parse_values(p)
end
if not p_eat_kw(p, "SELECT"):
p_err(p, "SQL104", "expected SELECT, found " + tok_desc(p.src, p_tok(p)), "")
ret 0 - 1
end
id := nd_new(p.ast, N_SELECT, tk)
p_skip_kw(p, "STRAIGHT_JOIN")
if p_eat_kw(p, "DISTINCT"):
nd_add_flag(p.ast, id, F_DISTINCT)
if p_eat_kw(p, "ON"):
skip_balanced(p)
end
else:
p_skip_kw(p, "ALL")
end
parse_result_cols(p, id)
if p_eat_kw(p, "FROM"):
nd_set_a(p.ast, id, parse_from(p))
end
if p_eat_kw(p, "WHERE"):
nd_set_b(p.ast, id, parse_expr(p))
end
if p_eat_kw(p, "GROUP"):
p_expect_kw(p, "BY", "after GROUP")
g := nd_new(p.ast, N_LIST, p.i)
mut items := Vector {} as Vector<int>
parse_expr_items(p, items)
nd_set_list(p.ast, g, items)
nd_set_c(p.ast, id, g)
if p_eat_kw(p, "HAVING"):
nd_set_d(p.ast, id, parse_expr(p))
end
end
if p_eat_kw(p, "WINDOW"):
until p.failed == false and p_name_here(p):
p_next(p)
p_expect_kw(p, "AS", "after the window name")
skip_balanced(p)
if not p_eat_sym(p, ","):
break
end
end
end
ret id
end
func set_op_here(p &: Parser): int:
if p_is_kw(p, "UNION"):
p_next(p)
if p_eat_kw(p, "ALL"):
ret OP_UNION_ALL
end
p_skip_kw(p, "DISTINCT")
ret OP_UNION
end
if p_is_kw(p, "INTERSECT"):
p_next(p)
p_skip_kw(p, "ALL")
ret OP_INTERSECT
end
if p_is_kw(p, "EXCEPT"):
p_next(p)
p_skip_kw(p, "ALL")
ret OP_EXCEPT
end
ret 0
end
func parse_select_tail(p &: Parser): int:
mut left := parse_select_core(p)
until p.failed == false:
tk := p.i
op := set_op_here(p)
if op == 0:
break
end
right := parse_select_core(p)
s := nd_new(p.ast, N_SET_OP, tk)
nd_set_op(p.ast, s, op)
nd_set_a(p.ast, s, left)
nd_set_b(p.ast, s, right)
left = s
end
if p_eat_kw(p, "ORDER"):
p_expect_kw(p, "BY", "after ORDER")
o := nd_new(p.ast, N_LIST, p.i)
parse_order_items(p, o)
nd_set_e(p.ast, left, o)
end
parse_limit(p, left)
if p_eat_kw(p, "FOR"):
p_skip_kw(p, "UPDATE")
p_skip_kw(p, "SHARE")
p_skip_kw(p, "NO")
p_skip_kw(p, "KEY")
end
ret left
end
func parse_with_prefix(p &: Parser): int:
tk := p.i
p_next(p)
id := nd_new(p.ast, N_WITH, tk)
p_skip_kw(p, "RECURSIVE")
mut ctes := Vector {} as Vector<int>
until true:
if p.failed:
break
end
nm := p_take_name(p)
if nm < 0:
break
end
c := nd_new(p.ast, N_CTE, nm)
if p_eat_sym(p, "("):
mut cols := Vector {} as Vector<int>
parse_name_items(p, cols)
nd_set_list(p.ast, c, cols)
p_expect_sym(p, ")", "after the CTE columns")
end
p_expect_kw(p, "AS", "before the body of the CTE")
if p_eat_kw(p, "NOT"):
p_expect_kw(p, "MATERIALIZED", "after NOT")
else:
p_skip_kw(p, "MATERIALIZED")
end
p_expect_sym(p, "(", "before the body of the CTE")
nd_set_a(p.ast, c, parse_select_stmt(p))
p_expect_sym(p, ")", "after the body of the CTE")
ctes.push(c)
if not p_eat_sym(p, ","):
break
end
end
nd_set_list(p.ast, id, ctes)
ret id
end
func parse_select_stmt(p &: Parser): int:
mut w := 0 - 1
if p_is_kw(p, "WITH"):
w = parse_with_prefix(p)
end
body := parse_select_tail(p)
if w < 0:
ret body
end
nd_set_a(p.ast, w, body)
ret w
end
func parse_returning(p &: Parser, owner: int):
tk := p.i
if not p_eat_kw(p, "RETURNING"):
ret
end
if not p.d.returning:
p_err_at(
p, tk, "SQL208", "RETURNING is not supported by " + p.d.name,
"read the row back with a second query, or use LAST_INSERT_ID()"
)
end
r := nd_new(p.ast, N_LIST, tk)
parse_result_cols(p, r)
nd_set_e(p.ast, owner, r)
end
func parse_set_items(p &: Parser, owner: int):
mut items := Vector {} as Vector<int>
until true:
if p.failed:
break
end
if p_eat_sym(p, "("):
mut names := Vector {} as Vector<int>
parse_name_items(p, names)
p_expect_sym(p, ")", "after the column list")
p_expect_sym(p, "=", "after the column list")
mut j := 0
until j < names.len():
it := nd_new(p.ast, N_SET_ITEM, p.ast.nodes.get(names.get(j)).tok)
items.push(it)
j = j + 1
end
names.free()
_rhs := parse_expr(p)
else:
nm := p_take_name(p)
if nm < 0:
break
end
it := nd_new(p.ast, N_SET_ITEM, nm)
p_expect_sym(p, "=", "after the column name")
nd_set_a(p.ast, it, parse_expr(p))
items.push(it)
end
if not p_eat_sym(p, ","):
break
end
end
nd_set_list(p.ast, owner, items)
end
func parse_conflict(p &: Parser, owner: int):
tk := p.i
if not p_eat_kw(p, "ON"):
ret
end
if p_eat_kw(p, "CONFLICT"):
if not p.d.on_conflict:
p_err_at(
p, tk, "SQL209", "ON CONFLICT is not supported by " + p.d.name,
"mysql writes ON DUPLICATE KEY UPDATE"
)
end
id := nd_new(p.ast, N_CONFLICT, tk)
if p_eat_sym(p, "("):
target := nd_new(p.ast, N_LIST, p.i)
mut cols := Vector {} as Vector<int>
parse_name_items(p, cols)
nd_set_list(p.ast, target, cols)
nd_set_a(p.ast, id, target)
p_expect_sym(p, ")", "after the conflict target")
if p_eat_kw(p, "WHERE"):
nd_set_b(p.ast, id, parse_expr(p))
end
end
if p_eat_kw(p, "ON"):
p_expect_kw(p, "CONSTRAINT", "after ON")
_cn := p_take_name(p)
end
p_expect_kw(p, "DO", "after the conflict target")
if p_eat_kw(p, "NOTHING"):
nd_set_c(p.ast, owner, id)
ret
end
p_expect_kw(p, "UPDATE", "after DO")
p_expect_kw(p, "SET", "after DO UPDATE")
parse_set_items(p, id)
if p_eat_kw(p, "WHERE"):
nd_set_b(p.ast, id, parse_expr(p))
end
nd_set_c(p.ast, owner, id)
ret
end
if p_eat_kw(p, "DUPLICATE"):
if not p.d.on_duplicate:
p_err_at(
p, tk, "SQL210", "ON DUPLICATE KEY UPDATE is mysql only",
"sqlite and postgres write ON CONFLICT (col) DO UPDATE SET ..."
)
end
p_expect_kw(p, "KEY", "after ON DUPLICATE")
p_expect_kw(p, "UPDATE", "after ON DUPLICATE KEY")
id := nd_new(p.ast, N_CONFLICT, tk)
parse_set_items(p, id)
nd_set_c(p.ast, owner, id)
ret
end
p_err(p, "SQL108", "expected CONFLICT or DUPLICATE after ON", "")
end
func parse_insert(p &: Parser): int:
tk := p.i
id := nd_new(p.ast, N_INSERT, tk)
if p_is_kw(p, "REPLACE"):
nd_add_flag(p.ast, id, F_REPLACE)
p_next(p)
else:
p_next(p)
if p_eat_kw(p, "OR"):
if p_is_kw(p, "REPLACE"):
nd_add_flag(p.ast, id, F_REPLACE)
end
if p_is_kw(p, "IGNORE"):
nd_add_flag(p.ast, id, F_IGNORE)
end
p_next(p)
end
if p_eat_kw(p, "IGNORE"):
nd_add_flag(p.ast, id, F_IGNORE)
end
p_skip_kw(p, "LOW_PRIORITY")
p_skip_kw(p, "HIGH_PRIORITY")
p_skip_kw(p, "DELAYED")
end
p_expect_kw(p, "INTO", "after INSERT")
nm := p_take_name(p)
if nm < 0:
ret id
end
tr := nd_new(p.ast, N_TABLE_REF, nm)
if p_is_sym(p, "."):
p_next(p)
n2 := p_take_name(p)
nd_set_t1(p.ast, tr, nm)
nd_set_tok(p.ast, tr, n2)
end
if p_eat_kw(p, "AS"):
nd_set_t2(p.ast, tr, p_take_name(p))
end
nd_set_a(p.ast, id, tr)
if p_is_sym(p, "(") and not p_kw_at(p, 1, "SELECT"):
p_next(p)
cols := nd_new(p.ast, N_LIST, p.i)
mut names := Vector {} as Vector<int>
parse_name_items(p, names)
nd_set_list(p.ast, cols, names)
p_expect_sym(p, ")", "after the column list")
nd_set_d(p.ast, id, cols)
end
if p_eat_kw(p, "DEFAULT"):
p_expect_kw(p, "VALUES", "after DEFAULT")
else p_is_kw(p, "VALUES"):
nd_set_b(p.ast, id, parse_values(p))
else p_is_kw(p, "SET"):
p_next(p)
s := nd_new(p.ast, N_LIST, p.i)
parse_set_items(p, s)
nd_set_f(p.ast, id, s)
else p_is_kw(p, "SELECT") or p_is_kw(p, "WITH") or p_is_sym(p, "("):
nd_set_b(p.ast, id, parse_select_stmt(p))
else:
p_err(p, "SQL109", "expected VALUES, SELECT or DEFAULT VALUES, found " + tok_desc(p.src, p_tok(p)), "")
ret id
end
parse_conflict(p, id)
parse_returning(p, id)
ret id
end
func parse_update(p &: Parser): int:
tk := p.i
p_next(p)
if p_eat_kw(p, "OR"):
p_next(p)
end
p_skip_kw(p, "IGNORE")
id := nd_new(p.ast, N_UPDATE, tk)
nd_set_a(p.ast, id, parse_from(p))
p_expect_kw(p, "SET", "after the table name")
s := nd_new(p.ast, N_LIST, p.i)
parse_set_items(p, s)
nd_set_c(p.ast, id, s)
if p_eat_kw(p, "FROM"):
nd_set_d(p.ast, id, parse_from(p))
end
if p_eat_kw(p, "WHERE"):
nd_set_b(p.ast, id, parse_expr(p))
end
if p_eat_kw(p, "ORDER"):
p_expect_kw(p, "BY", "after ORDER")
o := nd_new(p.ast, N_LIST, p.i)
parse_order_items(p, o)
nd_set_g(p.ast, id, o)
end
parse_limit(p, id)
parse_returning(p, id)
ret id
end
func parse_delete(p &: Parser): int:
tk := p.i
p_next(p)
id := nd_new(p.ast, N_DELETE, tk)
p_expect_kw(p, "FROM", "after DELETE")
nd_set_a(p.ast, id, parse_from(p))
if p_eat_kw(p, "USING"):
nd_set_d(p.ast, id, parse_from(p))
end
if p_eat_kw(p, "WHERE"):
nd_set_b(p.ast, id, parse_expr(p))
end
parse_limit(p, id)
parse_returning(p, id)
ret id
end
func autoinc_help(d: Dialect): str:
if d.id == POSTGRES:
ret "postgres has no auto-increment keyword: use GENERATED ALWAYS AS IDENTITY, or the SERIAL types"
end
ret d.name + " spells it " + d.autoincrement_word
end
func check_autoinc(p &: Parser, id: int):
tk := p.i
if p_is_kw(p, "AUTOINCREMENT"):
if p.d.id != SQLITE:
p_err_at(p, tk, "SQL211", "AUTOINCREMENT is sqlite only", autoinc_help(p.d))
end
p_next(p)
nd_add_flag(p.ast, id, F_AUTOINC)
ret
end
if p_is_kw(p, "AUTO_INCREMENT"):
if p.d.id != MYSQL and p.d.id != MARIADB:
p_err_at(p, tk, "SQL211", "AUTO_INCREMENT is a mysql keyword", autoinc_help(p.d))
end
p_next(p)
nd_add_flag(p.ast, id, F_AUTOINC)
end
end
func parse_fk_actions(p &: Parser):
until p.failed == false and (p_is_kw(p, "ON") or p_is_kw(p, "MATCH")):
if p_eat_kw(p, "MATCH"):
_mn := p_take_name(p)
continue
end
p_next(p)
if not p_eat_kw(p, "DELETE"):
p_expect_kw(p, "UPDATE", "after ON")
end
if p_eat_kw(p, "SET"):
if not p_eat_kw(p, "NULL"):
p_expect_kw(p, "DEFAULT", "after SET")
end
continue
end
if p_eat_kw(p, "NO"):
p_expect_kw(p, "ACTION", "after NO")
continue
end
if p_eat_kw(p, "CASCADE") or p_eat_kw(p, "RESTRICT"):
continue
end
p_err(
p, "SQL110", "expected a foreign key action, found " + tok_desc(p.src, p_tok(p)),
"one of CASCADE, RESTRICT, SET NULL, SET DEFAULT or NO ACTION"
)
end
if p_eat_kw(p, "NOT"):
p_expect_kw(p, "DEFERRABLE", "after NOT")
else:
p_skip_kw(p, "DEFERRABLE")
end
if p_eat_kw(p, "INITIALLY"):
if not p_eat_kw(p, "DEFERRED"):
p_expect_kw(p, "IMMEDIATE", "after INITIALLY")
end
end
end
func parse_references(p &: Parser): int:
tk := p.i
p_next(p)
nm := p_take_name(p)
id := nd_new(p.ast, N_REFERENCES, nm)
if nm < 0:
ret id
end
nd_set_t1(p.ast, id, tk)
if p_is_sym(p, "."):
p_next(p)
n2 := p_take_name(p)
nd_set_tok(p.ast, id, n2)
end
if p_eat_sym(p, "("):
mut cols := Vector {} as Vector<int>
parse_name_items(p, cols)
nd_set_list(p.ast, id, cols)
p_expect_sym(p, ")", "after the referenced columns")
end
parse_fk_actions(p)
ret id
end
func parse_column_def(p &: Parser): int:
nm := p_take_name(p)
if nm < 0:
ret 0 - 1
end
id := nd_new(p.ast, N_COLUMN_DEF, nm)
parse_type_name(p, id)
until p.failed == false:
if p_eat_kw(p, "CONSTRAINT"):
_cn := p_take_name(p)
continue
end
if p_is_kw(p, "NOT") and p_kw_at(p, 1, "NULL"):
p_next(p)
p_next(p)
nd_add_flag(p.ast, id, F_NOT_NULL)
continue
end
if p_eat_kw(p, "NULL"):
nd_add_flag(p.ast, id, F_NULLABLE)
continue
end
if p_eat_kw(p, "PRIMARY"):
p_expect_kw(p, "KEY", "after PRIMARY")
nd_add_flag(p.ast, id, F_PRIMARY)
p_skip_kw(p, "ASC")
p_skip_kw(p, "DESC")
check_autoinc(p, id)
continue
end
if p_eat_kw(p, "UNIQUE"):
p_skip_kw(p, "KEY")
nd_add_flag(p.ast, id, F_UNIQUE)
continue
end
if p_eat_kw(p, "CHECK"):
p_expect_sym(p, "(", "after CHECK")
nd_set_b(p.ast, id, parse_expr(p))
p_expect_sym(p, ")", "after the CHECK expression")
continue
end
if p_eat_kw(p, "DEFAULT"):
nd_add_flag(p.ast, id, F_HAS_DEFAULT)
if p_is_sym(p, "("):
skip_balanced(p)
else:
nd_set_a(p.ast, id, parse_expr(p))
end
continue
end
if p_eat_kw(p, "COLLATE"):
_coll := p_take_name(p)
continue
end
if p_is_kw(p, "REFERENCES"):
nd_set_c(p.ast, id, parse_references(p))
continue
end
if p_eat_kw(p, "GENERATED"):
if p_eat_kw(p, "ALWAYS"):
if p_eat_kw(p, "AS"):
if p_eat_kw(p, "IDENTITY"):
nd_add_flag(p.ast, id, F_AUTOINC)
if p_is_sym(p, "("):
skip_balanced(p)
end
continue
end
skip_balanced(p)
nd_add_flag(p.ast, id, F_GENERATED)
p_skip_kw(p, "STORED")
p_skip_kw(p, "VIRTUAL")
continue
end
end
if p_eat_kw(p, "BY"):
p_expect_kw(p, "DEFAULT", "after GENERATED BY")
p_expect_kw(p, "AS", "after GENERATED BY DEFAULT")
p_expect_kw(p, "IDENTITY", "after AS")
nd_add_flag(p.ast, id, F_AUTOINC)
if p_is_sym(p, "("):
skip_balanced(p)
end
continue
end
p_err(p, "SQL111", "expected ALWAYS or BY DEFAULT after GENERATED", "")
continue
end
if p_eat_kw(p, "AS"):
skip_balanced(p)
nd_add_flag(p.ast, id, F_GENERATED)
p_skip_kw(p, "STORED")
p_skip_kw(p, "VIRTUAL")
continue
end
if p_is_kw(p, "AUTOINCREMENT") or p_is_kw(p, "AUTO_INCREMENT"):
check_autoinc(p, id)
continue
end
if p_eat_kw(p, "UNSIGNED"):
nd_add_flag(p.ast, id, F_UNSIGNED)
continue
end
if p_eat_kw(p, "COMMENT"):
if p_kind(p) == TK_STRING:
p_next(p)
end
continue
end
if p_eat_kw(p, "ZEROFILL") or p_eat_kw(p, "KEY"):
continue
end
if p_eat_kw(p, "ON"):
p_expect_kw(p, "UPDATE", "after ON")
_ou := parse_expr(p)
continue
end
break
end
ret id
end
func constraint_here(p: Parser): bool:
if p_is_kw(p, "CONSTRAINT") or p_is_kw(p, "PRIMARY") or p_is_kw(p, "UNIQUE"):
ret true
end
if p_is_kw(p, "CHECK") or p_is_kw(p, "FOREIGN") or p_is_kw(p, "EXCLUDE"):
ret true
end
if p_is_kw(p, "KEY") or p_is_kw(p, "INDEX"):
ret true
end
ret false
end
func parse_table_constraint(p &: Parser): int:
tk := p.i
if p_eat_kw(p, "CONSTRAINT"):
if p_name_here(p):
p_next(p)
end
end
id := nd_new(p.ast, N_CONSTRAINT, tk)
if p_eat_kw(p, "PRIMARY"):
p_expect_kw(p, "KEY", "after PRIMARY")
nd_set_op(p.ast, id, CON_PRIMARY)
else p_eat_kw(p, "UNIQUE"):
p_skip_kw(p, "KEY")
p_skip_kw(p, "INDEX")
nd_set_op(p.ast, id, CON_UNIQUE)
if p_name_here(p):
p_next(p)
end
else p_eat_kw(p, "CHECK"):
nd_set_op(p.ast, id, CON_CHECK)
p_expect_sym(p, "(", "after CHECK")
nd_set_a(p.ast, id, parse_expr(p))
p_expect_sym(p, ")", "after the CHECK expression")
ret id
else p_eat_kw(p, "FOREIGN"):
p_expect_kw(p, "KEY", "after FOREIGN")
nd_set_op(p.ast, id, CON_FOREIGN)
else:
p_skip_kw(p, "KEY")
p_skip_kw(p, "INDEX")
nd_set_op(p.ast, id, CON_UNIQUE)
if p_name_here(p):
p_next(p)
end
end
p_expect_sym(p, "(", "before the constrained columns")
mut cols := Vector {} as Vector<int>
parse_name_items(p, cols)
nd_set_list(p.ast, id, cols)
p_expect_sym(p, ")", "after the constrained columns")
if p.ast.nodes.get(id).op == CON_FOREIGN:
if p_is_kw(p, "REFERENCES"):
nd_set_c(p.ast, id, parse_references(p))
else:
p_err(p, "SQL112", "expected REFERENCES after the FOREIGN KEY columns", "")
end
end
ret id
end
func parse_table_options(p &: Parser):
until p.failed == false and p_kind(p) != TK_EOF and not p_is_sym(p, ";"):
if p_is_sym(p, "("):
skip_balanced(p)
continue
end
p_next(p)
end
end
func parse_create_table(p &: Parser, tk: int, temp: bool): int:
id := nd_new(p.ast, N_CREATE_TABLE, tk)
if temp:
nd_add_flag(p.ast, id, F_TEMP)
end
if p_eat_kw(p, "IF"):
p_expect_kw(p, "NOT", "after IF")
p_expect_kw(p, "EXISTS", "after IF NOT")
nd_add_flag(p.ast, id, F_IF_EXISTS)
end
nm := p_take_name(p)
if nm < 0:
ret id
end
nd_set_tok(p.ast, id, nm)
if p_is_sym(p, "."):
p_next(p)
n2 := p_take_name(p)
nd_set_t1(p.ast, id, nm)
nd_set_tok(p.ast, id, n2)
end
if p_eat_kw(p, "AS"):
nd_set_c(p.ast, id, parse_select_stmt(p))
ret id
end
p_expect_sym(p, "(", "before the column definitions")
cols := nd_new(p.ast, N_LIST, p.i)
cons := nd_new(p.ast, N_LIST, p.i)
mut col_items := Vector {} as Vector<int>
mut con_items := Vector {} as Vector<int>
until true:
if p.failed:
break
end
if constraint_here(p):
c := parse_table_constraint(p)
if c >= 0:
con_items.push(c)
end
else:
c := parse_column_def(p)
if c >= 0:
col_items.push(c)
end
end
if not p_eat_sym(p, ","):
break
end
end
nd_set_list(p.ast, cols, col_items)
nd_set_list(p.ast, cons, con_items)
nd_set_a(p.ast, id, cols)
nd_set_b(p.ast, id, cons)
p_expect_sym(p, ")", "after the column definitions")
parse_table_options(p)
ret id
end
func parse_create_index(p &: Parser, tk: int, unique: bool): int:
id := nd_new(p.ast, N_CREATE_INDEX, tk)
if unique:
nd_add_flag(p.ast, id, F_UNIQUE)
end
if p_eat_kw(p, "IF"):
p_expect_kw(p, "NOT", "after IF")
p_expect_kw(p, "EXISTS", "after IF NOT")
nd_add_flag(p.ast, id, F_IF_EXISTS)
end
nm := p_take_name(p)
nd_set_tok(p.ast, id, nm)
if p_is_sym(p, "."):
p_next(p)
nd_set_tok(p.ast, id, p_take_name(p))
end
p_expect_kw(p, "ON", "after the index name")
tbl := p_take_name(p)
nd_set_t1(p.ast, id, tbl)
if p_eat_kw(p, "USING"):
_um := p_take_name(p)
end
p_expect_sym(p, "(", "before the indexed columns")
mut items := Vector {} as Vector<int>
parse_expr_items(p, items)
nd_set_list(p.ast, id, items)
p_expect_sym(p, ")", "after the indexed columns")
if p_eat_kw(p, "WHERE"):
nd_set_b(p.ast, id, parse_expr(p))
end
ret id
end
func parse_create_view(p &: Parser, tk: int, temp: bool): int:
id := nd_new(p.ast, N_CREATE_VIEW, tk)
if temp:
nd_add_flag(p.ast, id, F_TEMP)
end
if p_eat_kw(p, "IF"):
p_expect_kw(p, "NOT", "after IF")
p_expect_kw(p, "EXISTS", "after IF NOT")
nd_add_flag(p.ast, id, F_IF_EXISTS)
end
nm := p_take_name(p)
nd_set_tok(p.ast, id, nm)
if p_is_sym(p, "."):
p_next(p)
nd_set_tok(p.ast, id, p_take_name(p))
end
if p_eat_sym(p, "("):
mut cols := Vector {} as Vector<int>
parse_name_items(p, cols)
nd_set_list(p.ast, id, cols)
p_expect_sym(p, ")", "after the view columns")
end
p_expect_kw(p, "AS", "before the body of the view")
nd_set_a(p.ast, id, parse_select_stmt(p))
ret id
end
func parse_other(p &: Parser): int:
tk := p.i
id := nd_new(p.ast, N_OTHER, tk)
until p_kind(p) != TK_EOF and not p_is_sym(p, ";"):
if p_is_sym(p, "("):
skip_balanced(p)
continue
end
p_next(p)
end
ret id
end
func parse_create(p &: Parser): int:
tk := p.i
p_next(p)
if p_eat_kw(p, "OR"):
p_expect_kw(p, "REPLACE", "after OR")
end
unique := p_eat_kw(p, "UNIQUE")
mut temp := false
if p_eat_kw(p, "TEMP"):
temp = true
else p_eat_kw(p, "TEMPORARY"):
temp = true
end
if p_eat_kw(p, "TABLE"):
ret parse_create_table(p, tk, temp)
end
if p_eat_kw(p, "INDEX"):
ret parse_create_index(p, tk, unique)
end
if p_eat_kw(p, "VIEW"):
ret parse_create_view(p, tk, temp)
end
if unique:
p_err(p, "SQL113", "expected INDEX after CREATE UNIQUE", "")
end
ret parse_other(p)
end
func parse_alter_action(p &: Parser): int:
tk := p.i
id := nd_new(p.ast, N_ALTER_ACTION, tk)
if p_eat_kw(p, "ADD"):
p_skip_kw(p, "COLUMN")
if p_eat_kw(p, "IF"):
p_expect_kw(p, "NOT", "after IF")
p_expect_kw(p, "EXISTS", "after IF NOT")
nd_add_flag(p.ast, id, F_IF_EXISTS)
end
p_skip_kw(p, "COLUMN")
nd_set_op(p.ast, id, ALT_ADD)
if constraint_here(p):
nd_set_b(p.ast, id, parse_table_constraint(p))
else:
nd_set_a(p.ast, id, parse_column_def(p))
end
ret id
end
if p_eat_kw(p, "DROP"):
p_skip_kw(p, "COLUMN")
if p_eat_kw(p, "IF"):
p_expect_kw(p, "EXISTS", "after IF")
nd_add_flag(p.ast, id, F_IF_EXISTS)
end
p_skip_kw(p, "COLUMN")
nd_set_op(p.ast, id, ALT_DROP)
nd_set_t1(p.ast, id, p_take_name(p))
p_skip_kw(p, "CASCADE")
p_skip_kw(p, "RESTRICT")
ret id
end
if p_eat_kw(p, "RENAME"):
if p_eat_kw(p, "TO"):
nd_set_op(p.ast, id, ALT_RENAME_TABLE)
nd_set_t2(p.ast, id, p_take_name(p))
ret id
end
p_skip_kw(p, "COLUMN")
nd_set_op(p.ast, id, ALT_RENAME_COL)
nd_set_t1(p.ast, id, p_take_name(p))
p_expect_kw(p, "TO", "after the old column name")
nd_set_t2(p.ast, id, p_take_name(p))
ret id
end
if p_is_kw(p, "MODIFY") or p_is_kw(p, "CHANGE"):
renames := p_is_kw(p, "CHANGE")
p_next(p)
p_skip_kw(p, "COLUMN")
nd_set_op(p.ast, id, ALT_MODIFY)
if renames and p_name_here(p):
nd_set_t1(p.ast, id, p.i)
p_next(p)
end
nd_set_a(p.ast, id, parse_column_def(p))
ret id
end
nd_set_op(p.ast, id, ALT_OTHER)
until p_kind(p) != TK_EOF and not p_is_sym(p, ";") and not p_is_sym(p, ","):
if p_is_sym(p, "("):
skip_balanced(p)
continue
end
p_next(p)
end
ret id
end
func parse_alter(p &: Parser): int:
tk := p.i
p_next(p)
if not p_eat_kw(p, "TABLE"):
ret parse_other(p)
end
id := nd_new(p.ast, N_ALTER_TABLE, tk)
if p_eat_kw(p, "IF"):
p_expect_kw(p, "EXISTS", "after IF")
nd_add_flag(p.ast, id, F_IF_EXISTS)
end
nm := p_take_name(p)
nd_set_tok(p.ast, id, nm)
if p_is_sym(p, "."):
p_next(p)
nd_set_tok(p.ast, id, p_take_name(p))
end
mut actions := Vector {} as Vector<int>
until true:
if p.failed:
break
end
a := parse_alter_action(p)
if a >= 0:
actions.push(a)
end
if not p_eat_sym(p, ","):
break
end
end
nd_set_list(p.ast, id, actions)
ret id
end
func parse_drop(p &: Parser): int:
tk := p.i
p_next(p)
mut kind := 0
if p_eat_kw(p, "TABLE"):
kind = N_CREATE_TABLE
else p_eat_kw(p, "INDEX"):
kind = N_CREATE_INDEX
else p_eat_kw(p, "VIEW"):
kind = N_CREATE_VIEW
else:
ret parse_other(p)
end
id := nd_new(p.ast, N_DROP, tk)
nd_set_op(p.ast, id, kind)
if p_eat_kw(p, "IF"):
p_expect_kw(p, "EXISTS", "after IF")
nd_add_flag(p.ast, id, F_IF_EXISTS)
end
nm := p_take_name(p)
nd_set_tok(p.ast, id, nm)
if p_is_sym(p, "."):
p_next(p)
nd_set_tok(p.ast, id, p_take_name(p))
end
p_skip_kw(p, "CASCADE")
p_skip_kw(p, "RESTRICT")
ret id
end
func parse_truncate(p &: Parser): int:
tk := p.i
if p.d.id == SQLITE:
p_err_at(
p, tk, "SQL212", "sqlite has no TRUNCATE statement", "write DELETE FROM the_table instead"
)
end
p_next(p)
p_skip_kw(p, "TABLE")
id := nd_new(p.ast, N_TRUNCATE, tk)
nm := p_take_name(p)
nd_set_tok(p.ast, id, nm)
if p_is_sym(p, "."):
p_next(p)
nd_set_tok(p.ast, id, p_take_name(p))
end
p_skip_kw(p, "CASCADE")
p_skip_kw(p, "RESTART")
p_skip_kw(p, "IDENTITY")
ret id
end
func parse_txn(p &: Parser): int:
tk := p.i
id := nd_new(p.ast, N_TXN, tk)
p_next(p)
until p_kind(p) != TK_EOF and not p_is_sym(p, ";"):
p_next(p)
end
ret id
end
func parse_stmt(p &: Parser): int:
if p_is_kw(p, "EXPLAIN"):
p_next(p)
p_skip_kw(p, "QUERY")
p_skip_kw(p, "PLAN")
p_skip_kw(p, "ANALYZE")
p_skip_kw(p, "VERBOSE")
ret parse_stmt(p)
end
if p_is_kw(p, "PRAGMA"):
tk := p.i
if p.d.id != SQLITE:
p_err_at(
p, tk, "SQL213", "PRAGMA is sqlite only", p.d.name + " configures the session with SET"
)
end
ret parse_other(p)
end
mut w := 0 - 1
if p_is_kw(p, "WITH"):
w = parse_with_prefix(p)
end
mut body := 0 - 1
if p_is_kw(p, "SELECT") or p_is_kw(p, "VALUES"):
body = parse_select_tail(p)
else p_is_kw(p, "INSERT") or p_is_kw(p, "REPLACE"):
body = parse_insert(p)
else p_is_kw(p, "UPDATE"):
body = parse_update(p)
else p_is_kw(p, "DELETE"):
body = parse_delete(p)
else w >= 0:
p_err(p, "SQL114", "expected SELECT, INSERT, UPDATE or DELETE after the WITH clause, found " + tok_desc(p.src, p_tok(p)), "")
else p_is_kw(p, "CREATE"):
body = parse_create(p)
else p_is_kw(p, "ALTER"):
body = parse_alter(p)
else p_is_kw(p, "DROP"):
body = parse_drop(p)
else p_is_kw(p, "TRUNCATE"):
body = parse_truncate(p)
else p_is_kw(p, "BEGIN") or p_is_kw(p, "COMMIT") or p_is_kw(p, "ROLLBACK"):
body = parse_txn(p)
else p_is_kw(p, "SAVEPOINT") or p_is_kw(p, "RELEASE"):
body = parse_txn(p)
else:
body = parse_other(p)
end
if w < 0:
ret body
end
nd_set_a(p.ast, w, body)
ret w
end
func parse_script(p &: Parser):
until p_kind(p) != TK_EOF:
p.failed = false
start := p.i
s := parse_stmt(p)
if s >= 0 and not p.failed:
p.ast.roots.push(s)
end
if not p.failed and p_kind(p) != TK_EOF and not p_is_sym(p, ";"):
p_err(
p, "SQL115", "unexpected " + tok_desc(p.src, p_tok(p)) + " after the statement",
"a statement ends at a ';'"
)
end
if p.failed:
until p_kind(p) != TK_EOF and not p_is_sym(p, ";"):
p_next(p)
end
end
if p.i == start and p_kind(p) != TK_EOF:
p_next(p)
end
p_skip_sym(p, ";")
end
end
func parse_into(p &: Parser, src: str, d: Dialect):
mut l := Lexer { src = src, n = src.len(), d = d }
lex_into(l, p.rep)
p.src = src
p.d = d
p.toks = l.toks
parse_script(p)
p.rep.statements = p.ast.roots.len()
end
func free_parser(p &: Parser):
p.toks.free()
free_ast(p.ast)
end
package sql
import str
import mem
@en "TYPE_NULL"
@fa "نوع خالی"
pub const TYPE_NULL := 0
@en "TYPE_INT"
@fa "نوع صحیح"
pub const TYPE_INT := 1
@en "TYPE_FLOAT"
@fa "نوع اعشاری"
pub const TYPE_FLOAT := 2
@en "TYPE_TEXT"
@fa "نوع متن"
pub const TYPE_TEXT := 3
@en "TYPE_BLOB"
@fa "نوع دودویی"
pub const TYPE_BLOB := 4
@en "TYPE_BOOL"
@fa "نوع منطقی"
pub const TYPE_BOOL := 5
@en "TYPE_TIME"
@fa "نوع زمان"
pub const TYPE_TIME := 6
@en "TYPE_UNKNOWN"
@fa "نوع ناشناخته"
pub const TYPE_UNKNOWN := 7
@en "Column"
@fa "ستون"
pub struct Column:
pub name: str = ""
pub type_name: str = ""
pub kind: int = 7
pub not_null: bool = false
pub has_default: bool = false
pub primary: bool = false
pub auto: bool = false
pub generated: bool = false
end
@en "Table"
@fa "جدول"
pub struct Table:
pub name: str = ""
pub is_view: bool = false
pub open: bool = false
pub columns: Vector<Column> = Vector {}
end
@en "Catalog"
@fa "فهرست جداول"
pub struct Catalog:
pub d: Dialect = Dialect {}
pub tables: Vector<Table> = Vector {}
end
func kind_from_upper(u: str): int:
if str.Contains(u, "BOOL"):
ret TYPE_BOOL
end
if str.Contains(u, "SERIAL"):
ret TYPE_INT
end
if str.Contains(u, "TIMESTAMP") or str.Contains(u, "DATETIME"):
ret TYPE_TIME
end
if str.Equals(u, "DATE") or str.StartsWith(u, "TIME"):
ret TYPE_TIME
end
if str.Contains(u, "INT"):
ret TYPE_INT
end
if str.Contains(u, "CHAR") or str.Contains(u, "CLOB") or str.Contains(u, "TEXT"):
ret TYPE_TEXT
end
if str.Contains(u, "UUID") or str.Contains(u, "JSON") or str.Contains(u, "ENUM"):
ret TYPE_TEXT
end
if str.Contains(u, "BLOB") or str.Contains(u, "BYTEA") or str.Contains(u, "BINARY"):
ret TYPE_BLOB
end
if str.Contains(u, "REAL") or str.Contains(u, "FLOA") or str.Contains(u, "DOUBLE"):
ret TYPE_FLOAT
end
if str.Contains(u, "DEC") or str.Contains(u, "NUMERIC") or str.Contains(u, "MONEY"):
ret TYPE_FLOAT
end
if str.IsEmpty(u):
ret TYPE_UNKNOWN
end
ret TYPE_FLOAT
end
func kind_from_type(t: str): int:
u := t.upper()
k := kind_from_upper(u)
mem.Free(u as void*)
ret k
end
func fills_from_upper(d: Dialect, u: str, primary: bool): bool:
if str.Contains(u, "SERIAL"):
ret true
end
if d.id != SQLITE or not primary:
ret false
end
trimmed := str.Trim(u)
same := str.Equals(trimmed, "INTEGER")
mem.Free(trimmed as void*)
ret same
end
func type_fills_itself(d: Dialect, type_name: str, primary: bool): bool:
u := type_name.upper()
out := fills_from_upper(d, u, primary)
mem.Free(u as void*)
ret out
end
func cat_find(c: Catalog, name: str): int:
mut i := 0
until i < c.tables.len():
if str.EqualFold(c.tables.get(i).name, name):
ret i
end
i = i + 1
end
ret 0 - 1
end
func tab_find(t: Table, name: str): int:
mut i := 0
until i < t.columns.len():
if str.EqualFold(t.columns.get(i).name, name):
ret i
end
i = i + 1
end
ret 0 - 1
end
func cat_add(c &: Catalog, name: str, is_view: bool): int:
id := c.tables.len()
c.tables.push(Table { name = str.Clone(name), is_view = is_view })
ret id
end
func cat_add_col(c &: Catalog, tid: int, col: Column):
mut t := c.tables.ref(tid)
t.columns.push(col)
end
func cat_mark_primary(c &: Catalog, tid: int, name: str):
idx := tab_find(c.tables.get(tid), name)
if idx < 0:
ret
end
fills := type_fills_itself(c.d, c.tables.get(tid).columns.get(idx).type_name, true)
mut t := c.tables.ref(tid)
mut col := t.columns.ref(idx)
col.primary = true
col.not_null = true
if fills:
col.auto = true
col.has_default = true
end
end
func cat_drop(c &: Catalog, tid: int):
mut t := c.tables.ref(tid)
mem.Free(t.name as void*)
mut i := 0
until i < t.columns.len():
col := t.columns.get(i)
mem.Free(col.name as void*)
mem.Free(col.type_name as void*)
i = i + 1
end
t.columns.free()
c.tables.remove_at(tid)
end
func type_text(p: Parser, id: int): str:
n := p.ast.nodes.get(id)
if n.t1 < 0 or n.t2 < n.t1:
ret str.Clone("")
end
a := p.toks.get(n.t1)
b := p.toks.get(n.t2)
ret p.src.substr(a.off, b.off + b.len - a.off)
end
func apply_create_table(p &: Parser, c &: Catalog, id: int):
node := p.ast.nodes.get(id)
name := tok_name(p.src, p.toks.get(node.tok))
if cat_find(c, name) >= 0:
if (node.flags & F_IF_EXISTS) == 0:
p_err_at(
p, node.tok, "SQL301", "table \"" + name + "\" is declared twice",
"drop the earlier declaration, or add IF NOT EXISTS"
)
end
mem.Free(name as void*)
ret
end
tid := cat_add(c, name, false)
mem.Free(name as void*)
if node.c >= 0:
mut t := c.tables.ref(tid)
t.open = true
ret
end
cols := node.a
if cols >= 0:
list := p.ast.nodes.get(cols).list
mut i := 0
until i < list.len():
cd := p.ast.nodes.get(list.get(i))
cname := tok_name(p.src, p.toks.get(cd.tok))
dup := tab_find(c.tables.get(tid), cname)
if dup >= 0:
p_err_at(p, cd.tok, "SQL302", "column \"" + cname + "\" is declared twice", "")
mem.Free(cname as void*)
else:
tname := type_text(p, list.get(i))
prim := (cd.flags & F_PRIMARY) != 0
auto := (cd.flags & F_AUTOINC) != 0 or type_fills_itself(c.d, tname, prim)
cat_add_col(
c, tid, Column {
name = cname, type_name = tname, kind = kind_from_type(tname), not_null = (cd.flags & F_NOT_NULL) != 0 or prim or auto,
has_default = (cd.flags & F_HAS_DEFAULT) != 0 or auto, primary = prim, auto = auto, generated = (cd.flags & F_GENERATED) != 0
}
)
end
i = i + 1
end
end
cons := node.b
if cons >= 0:
clist := p.ast.nodes.get(cons).list
mut j := 0
until j < clist.len():
cn := p.ast.nodes.get(clist.get(j))
if cn.op == CON_PRIMARY:
mut k := 0
until k < cn.list.len():
nm := tok_name(p.src, p.toks.get(p.ast.nodes.get(cn.list.get(k)).tok))
cat_mark_primary(c, tid, nm)
mem.Free(nm as void*)
k = k + 1
end
end
j = j + 1
end
end
end
func view_columns(p &: Parser, c &: Catalog, tid: int, id: int):
node := p.ast.nodes.get(id)
if node.list.len() > 0:
mut i := 0
until i < node.list.len():
nm := tok_name(p.src, p.toks.get(p.ast.nodes.get(node.list.get(i)).tok))
cat_add_col(c, tid, Column { name = nm, type_name = str.Clone(""), kind = TYPE_UNKNOWN })
i = i + 1
end
ret
end
mut body := node.a
if nd_kind(p.ast, body) == N_WITH:
body = p.ast.nodes.get(body).a
end
if nd_kind(p.ast, body) != N_SELECT:
mut t := c.tables.ref(tid)
t.open = true
ret
end
cols := p.ast.nodes.get(body).list
mut i := 0
until i < cols.len():
rc := p.ast.nodes.get(cols.get(i))
if (rc.flags & F_STAR) != 0:
mut t := c.tables.ref(tid)
t.open = true
ret
end
mut tk := 0 - 1
if rc.t2 >= 0:
tk = rc.t2
else nd_kind(p.ast, rc.a) == N_COLUMN_REF:
tk = p.ast.nodes.get(rc.a).tok
end
if tk < 0:
mut t := c.tables.ref(tid)
t.open = true
ret
end
nm := tok_name(p.src, p.toks.get(tk))
cat_add_col(c, tid, Column { name = nm, type_name = str.Clone(""), kind = TYPE_UNKNOWN })
i = i + 1
end
end
func col_from_def(p: Parser, node: int, name: str, type_name: str): Column:
cd := p.ast.nodes.get(node)
prim := (cd.flags & F_PRIMARY) != 0
auto := (cd.flags & F_AUTOINC) != 0
ret Column {
name = name, type_name = type_name, kind = kind_from_type(type_name), not_null = (cd.flags & F_NOT_NULL) != 0 or prim or auto,
has_default = (cd.flags & F_HAS_DEFAULT) != 0 or auto, primary = prim, auto = auto, generated = (cd.flags & F_GENERATED) != 0
}
end
func cat_replace_col(c &: Catalog, tid: int, idx: int, col: Column):
old := c.tables.get(tid).columns.get(idx)
mem.Free(old.name as void*)
mem.Free(old.type_name as void*)
mut t := c.tables.ref(tid)
t.columns.set(idx, col)
end
func apply_alter_action(p &: Parser, c &: Catalog, tid: int, id: int):
node := p.ast.nodes.get(id)
if node.op == ALT_ADD:
if node.a < 0:
ret
end
cd := p.ast.nodes.get(node.a)
cname := tok_name(p.src, p.toks.get(cd.tok))
if tab_find(c.tables.get(tid), cname) >= 0:
if (node.flags & F_IF_EXISTS) == 0:
p_err_at(p, cd.tok, "SQL302", "column \"" + cname + "\" is declared twice", "")
end
mem.Free(cname as void*)
ret
end
tname := type_text(p, node.a)
fills := type_fills_itself(c.d, tname, (cd.flags & F_PRIMARY) != 0)
mut col := col_from_def(p, node.a, cname, tname)
if fills:
col.auto = true
col.has_default = true
col.not_null = true
end
cat_add_col(c, tid, col)
ret
end
if node.op == ALT_MODIFY:
if node.a < 0:
ret
end
cd := p.ast.nodes.get(node.a)
cname := tok_name(p.src, p.toks.get(cd.tok))
mut target := 0 - 1
if node.t1 >= 0:
old := tok_name(p.src, p.toks.get(node.t1))
target = tab_find(c.tables.get(tid), old)
if target < 0:
p_err_at(p, node.t1, "SQL304", "no column named \"" + old + "\"", "")
end
mem.Free(old as void*)
else:
target = tab_find(c.tables.get(tid), cname)
if target < 0:
p_err_at(p, cd.tok, "SQL304", "no column named \"" + cname + "\"", "")
end
end
if target < 0:
mem.Free(cname as void*)
ret
end
tname := type_text(p, node.a)
cat_replace_col(c, tid, target, col_from_def(p, node.a, cname, tname))
ret
end
if node.op == ALT_DROP:
if node.t1 < 0:
ret
end
old := tok_name(p.src, p.toks.get(node.t1))
oid := tab_find(c.tables.get(tid), old)
if oid < 0:
if (node.flags & F_IF_EXISTS) == 0:
p_err_at(p, node.t1, "SQL304", "no column named \"" + old + "\"", "")
end
else:
col := c.tables.get(tid).columns.get(oid)
mem.Free(col.name as void*)
mem.Free(col.type_name as void*)
mut t := c.tables.ref(tid)
t.columns.remove_at(oid)
end
mem.Free(old as void*)
ret
end
if node.op == ALT_RENAME_COL:
if node.t1 < 0 or node.t2 < 0:
ret
end
old := tok_name(p.src, p.toks.get(node.t1))
fresh := tok_name(p.src, p.toks.get(node.t2))
oid := tab_find(c.tables.get(tid), old)
if oid < 0:
p_err_at(p, node.t1, "SQL304", "no column named \"" + old + "\"", "")
mem.Free(fresh as void*)
else:
mut t := c.tables.ref(tid)
mut col := t.columns.ref(oid)
mem.Free(col.name as void*)
col.name = fresh
end
mem.Free(old as void*)
ret
end
if node.op == ALT_RENAME_TABLE:
if node.t2 < 0:
ret
end
fresh := tok_name(p.src, p.toks.get(node.t2))
mut t := c.tables.ref(tid)
mem.Free(t.name as void*)
t.name = fresh
end
end
func apply_alter(p &: Parser, c &: Catalog, id: int):
node := p.ast.nodes.get(id)
name := tok_name(p.src, p.toks.get(node.tok))
tid := cat_find(c, name)
if tid < 0:
if (node.flags & F_IF_EXISTS) == 0:
p_err_at(
p, node.tok, "SQL303", "no table named \"" + name + "\"", "the schema has no such table"
)
end
mem.Free(name as void*)
ret
end
mem.Free(name as void*)
mut i := 0
until i < node.list.len():
apply_alter_action(p, c, tid, node.list.get(i))
i = i + 1
end
end
func apply_stmt(p &: Parser, c &: Catalog, id: int):
k := nd_kind(p.ast, id)
if k == N_CREATE_TABLE:
apply_create_table(p, c, id)
ret
end
if k == N_CREATE_VIEW:
node := p.ast.nodes.get(id)
name := tok_name(p.src, p.toks.get(node.tok))
if cat_find(c, name) >= 0:
mem.Free(name as void*)
ret
end
tid := cat_add(c, name, true)
mem.Free(name as void*)
view_columns(p, c, tid, id)
ret
end
if k == N_ALTER_TABLE:
apply_alter(p, c, id)
ret
end
if k == N_DROP:
node := p.ast.nodes.get(id)
if node.op != N_CREATE_TABLE and node.op != N_CREATE_VIEW:
ret
end
name := tok_name(p.src, p.toks.get(node.tok))
tid := cat_find(c, name)
if tid < 0:
if (node.flags & F_IF_EXISTS) == 0:
p_err_at(
p, node.tok, "SQL303", "no table named \"" + name + "\"",
"add IF EXISTS when the table may not be there"
)
end
else:
cat_drop(c, tid)
end
mem.Free(name as void*)
end
end
@en "NewCatalog"
@fa "فهرست تازه"
pub func NewCatalog(d: Dialect): Catalog:
ret Catalog { d = d }
end
@en "Apply"
@fa "اعمال"
pub func Apply(c &: Catalog, ddl: str): Report:
mut p := Parser {}
parse_into(p, ddl, c.d)
mut i := 0
until i < p.ast.roots.len():
apply_stmt(p, c, p.ast.roots.get(i))
i = i + 1
end
out := p.rep
free_parser(p)
ret out
end
@en "FreeCatalog"
@fa "آزادسازی فهرست"
pub func FreeCatalog(c &: Catalog):
until c.tables.len() > 0:
cat_drop(c, c.tables.len() - 1)
end
c.tables.free()
end
@en "TableCount"
@fa "شمار جدول"
pub func TableCount(c: Catalog): int:
ret c.tables.len()
end
@en "TableName"
@fa "نام جدول"
pub func TableName(c: Catalog, i: int): str:
if i < 0 or i >= c.tables.len():
ret ""
end
ret c.tables.get(i).name
end
@en "HasTable"
@fa "جدول دارد"
pub func HasTable(c: Catalog, name: str): bool:
ret cat_find(c, name) >= 0
end
@en "ColumnCount"
@fa "شمار ستون"
pub func ColumnCount(c: Catalog, table: str): int:
tid := cat_find(c, table)
if tid < 0:
ret 0
end
ret c.tables.get(tid).columns.len()
end
@en "ColumnAt"
@fa "ستون شماره"
pub func ColumnAt(c: Catalog, table: str, i: int): Column:
tid := cat_find(c, table)
if tid < 0:
ret Column {}
end
t := c.tables.get(tid)
if i < 0 or i >= t.columns.len():
ret Column {}
end
ret t.columns.get(i)
end
@en "HasColumn"
@fa "ستون دارد"
pub func HasColumn(c: Catalog, table: str, column: str): bool:
tid := cat_find(c, table)
if tid < 0:
ret false
end
ret tab_find(c.tables.get(tid), column) >= 0
end
@en "KindName"
@fa "نام نوع"
pub func KindName(k: int): str:
if k == TYPE_INT:
ret "int"
end
if k == TYPE_FLOAT:
ret "float"
end
if k == TYPE_TEXT:
ret "text"
end
if k == TYPE_BLOB:
ret "blob"
end
if k == TYPE_BOOL:
ret "bool"
end
if k == TYPE_TIME:
ret "time"
end
if k == TYPE_NULL:
ret "null"
end
ret "unknown"
end
@en "SalamType"
@fa "گونه سلام"
pub func SalamType(k: int, not_null: bool): str:
mut base := "str"
if k == TYPE_INT:
base = "i64"
else k == TYPE_FLOAT:
base = "f64"
else k == TYPE_BOOL:
base = "bool"
else k == TYPE_BLOB:
base = "str"
end
if not_null:
ret base
end
ret "option.Option<" + base + ">"
end
@en "sqlite"
@fa "اس کیو لایت"
package sqlite
import str
import db
link dynamic "sqlite3"
extern:
func sqlite3_open(path: str, db &: void*): int
func sqlite3_close(db: void*): int
func sqlite3_exec(db: void*, sql: str, cb: void*, cbarg: void*, errmsg: void*): int
func sqlite3_prepare_v2(db: void*, sql: str, nbytes: int, stmt &: void*, tail: void*): int
func sqlite3_step(stmt: void*): int
func sqlite3_finalize(stmt: void*): int
func sqlite3_reset(stmt: void*): int
func sqlite3_column_count(stmt: void*): int
func sqlite3_column_text(stmt: void*, col: int): void*
func sqlite3_column_name(stmt: void*, col: int): str
func sqlite3_column_int(stmt: void*, col: int): int
func sqlite3_column_int64(stmt: void*, col: int): i64
func sqlite3_column_double(stmt: void*, col: int): f64
func sqlite3_column_type(stmt: void*, col: int): int
func sqlite3_bind_text(stmt: void*, idx: int, val: str, nbytes: int, destructor: void*): int
func sqlite3_bind_int64(stmt: void*, idx: int, val: i64): int
func sqlite3_bind_double(stmt: void*, idx: int, val: f64): int
func sqlite3_bind_null(stmt: void*, idx: int): int
func sqlite3_last_insert_rowid(db: void*): i64
func sqlite3_changes(db: void*): int
func sqlite3_total_changes(db: void*): int
func sqlite3_errmsg(db: void*): str
func sqlite3_libversion(): str
end
@en "Database"
@fa "پایگاه داده"
pub struct Database:
pub handle: void* = null
@en "Kind"
@fa "نوع"
pub func Kind(): str: ret db.SQLITE end
@en "Ok"
@fa "معتبر"
pub func Ok(): bool: ret this.handle != null end
@en "Ping"
@fa "پینگ"
pub func Ping(): bool: ret this.handle != null end
@en "Exec"
@fa "اجرا"
pub func Exec(sql: str): int:
if this.handle == null:
ret -1
end
if sqlite3_exec(this.handle, sql, null, null, null) == 0:
ret 0
end
ret -1
end
@en "Query"
@fa "پرسمان"
pub func Query(sql: str): dyn db.Rows:
if this.handle == null:
ret Rows { handle = null }
end
mut st := null as void*
sqlite3_prepare_v2(this.handle, sql, -1, st, null)
ret Rows { handle = st }
end
@en "Begin"
@fa "شروع تراکنش"
pub func Begin(): dyn db.Tx:
if this.handle == null:
ret Txn { handle = null }
end
if sqlite3_exec(this.handle, "BEGIN", null, null, null) != 0:
ret Txn { handle = null }
end
ret Txn { handle = this.handle }
end
@en "LastInsertId"
@fa "شناسه آخرین درج"
pub func LastInsertId(): i64:
if this.handle == null:
ret 0
end
ret sqlite3_last_insert_rowid(this.handle)
end
@en "Changes"
@fa "تعداد تغییرات"
pub func Changes(): i64:
if this.handle == null:
ret 0
end
ret sqlite3_changes(this.handle)
end
@en "Error"
@fa "خطا"
pub func Error(): str:
if this.handle == null:
ret "no database"
end
ret str.Clone(sqlite3_errmsg(this.handle))
end
@en "Quote"
@fa "نقل قول"
pub func Quote(s: str): str: ret db.QuoteLiteral(s) end
@en "Close"
@fa "بستن"
pub func Close(): int:
if this.handle == null:
ret -1
end
ret sqlite3_close(this.handle)
end
end
@en "Rows"
@fa "ردیف ها"
pub struct Rows:
pub handle: void* = null
@en "Ok"
@fa "معتبر"
pub func Ok(): bool: ret this.handle != null end
@en "Next"
@fa "بعدی"
pub func Next(): bool:
if this.handle == null:
ret false
end
ret sqlite3_step(this.handle) == 100
end
@en "ColumnCount"
@fa "تعداد ستون"
pub func ColumnCount(): int:
if this.handle == null:
ret 0
end
ret sqlite3_column_count(this.handle)
end
@en "ColumnName"
