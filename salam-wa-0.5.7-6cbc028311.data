@en "tls"
@fa "تی ال اس"
package tls
@en "TLS10"
@fa "تی ال اس۱۰"
pub const TLS10 := 0x0301
@en "TLS11"
@fa "تی ال اس۱۱"
pub const TLS11 := 0x0302
@en "TLS12"
@fa "تی ال اس۱۲"
pub const TLS12 := 0x0303
@en "TLS13"
@fa "تی ال اس۱۳"
