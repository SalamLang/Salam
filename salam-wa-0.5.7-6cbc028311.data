if zero:
x = 0
end
mut p := prec
if kind == 103:
if p < 1:
p = 1
end
end
mut style := kind
if kind == 103:
if x < -4 or x >= p:
style = 101
else:
style = 102
end
end
mut sig := p
mut ndec := 0
if style == 101 and kind != 103:
sig = p + 1
ndec = p
end
if style == 102 and kind != 103:
sig = (x + 1) + p
ndec = p
end
