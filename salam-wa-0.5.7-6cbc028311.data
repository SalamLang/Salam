bigs1 := _rotr32(e, 6 as u32) ^ _rotr32(e, 11 as u32) ^ _rotr32(e, 25 as u32)
ch := (e & f) ^ ((~e) & g)
t1 := hh + bigs1 + ch + K256[t] + w[t]
bigs0 := _rotr32(a, 2 as u32) ^ _rotr32(a, 13 as u32) ^ _rotr32(a, 22 as u32)
maj := (a & b) ^ (a & c) ^ (b & c)
t2 := bigs0 + maj
hh = g
g = f
f = e
e = d + t1
d = c
c = b
b = a
a = t1 + t2
end
s.h[0] += a
s.h[1] += b
s.h[2] += c
s.h[3] += d
s.h[4] += e
s.h[5] += f
s.h[6] += g
