func _big_divmod(q &: Big, rem &: Big, a: Big, m: Big): bool:
if m.n == 0:
ret false
end
if q.cap < a.n or rem.cap < m.n + 1:
q.bad = true
ret false
end
_big_zero(q)
_big_zero(rem)
mut scratch := _big_new(m.n + 2)
defer _big_free(scratch)
if scratch.bad:
ret false
end
mut i := _big_bitlen(a) - 1
until i >= 0:
_big_shl1(rem)
if rem.bad:
ret false
end
if _big_bit(a, i) == 1:
if rem.n == 0:
_setlimb(rem, 0, 1 as u32)
rem.n = 1
else:
_setlimb(rem, 0, _limb(rem, 0) | (1 as u32))
end
end
if _big_cmp(rem, m) >= 0:
if not _big_sub(scratch, rem, m):
ret false
end
_big_copy(rem, scratch)
