package crypto
import mem
import str
import encoding
const SHA1_BLOCK_SIZE := 64
const SHA1_DIGEST_SIZE := 20
func _at(p: void*, off: int): void*:
ret ((p as i64) + (off as i64)) as void*
end
func _sha1_key(key: void*, klen: int, out: void*):
if klen > SHA1_BLOCK_SIZE:
Sha1Bytes(key, klen, out)
else:
mem.Copy(out, key, klen as u64)
end
end
func _sha1_pads(key: void*, klen: int, ipad: void*, opad: void*):
kb := mem.AllocateZeroed(SHA1_BLOCK_SIZE as u64)
defer mem.Free(kb)
_sha1_key(key, klen, kb)
kp := kb as u8*
ip := ipad as u8*
op := opad as u8*
repeat SHA1_BLOCK_SIZE in i:
ip[i] = ((kp[i] as int) ^ 0x36) as u8
op[i] = ((kp[i] as int) ^ 0x5c) as u8
end
end
@en "HmacSha1Raw"
@fa "اچ مک شا۱ خام"
pub func HmacSha1Raw(key: void*, klen: int, msg: void*, mlen: int, out: void*):
ipad := mem.AllocateZeroed(SHA1_BLOCK_SIZE as u64)
defer mem.Free(ipad)
opad := mem.AllocateZeroed(SHA1_BLOCK_SIZE as u64)
defer mem.Free(opad)
_sha1_pads(key, klen, ipad, opad)
inner_input := mem.Allocate((SHA1_BLOCK_SIZE + mlen) as u64)
defer mem.Free(inner_input)
mem.Copy(inner_input, ipad, SHA1_BLOCK_SIZE as u64)
mem.Copy(_at(inner_input, SHA1_BLOCK_SIZE), msg, mlen as u64)
inner := mem.Allocate(SHA1_DIGEST_SIZE as u64)
defer mem.Free(inner)
Sha1Bytes(inner_input, SHA1_BLOCK_SIZE + mlen, inner)
outer_input := mem.Allocate((SHA1_BLOCK_SIZE + SHA1_DIGEST_SIZE) as u64)
defer mem.Free(outer_input)
mem.Copy(outer_input, opad, SHA1_BLOCK_SIZE as u64)
mem.Copy(_at(outer_input, SHA1_BLOCK_SIZE), inner, SHA1_DIGEST_SIZE as u64)
Sha1Bytes(outer_input, SHA1_BLOCK_SIZE + SHA1_DIGEST_SIZE, out)
end
@en "HmacSha1Bytes"
@fa "اچ مک شا۱ بایتی"
pub func HmacSha1Bytes(key: str, msg: str, out: void*):
HmacSha1Raw(key as void*, key.len(), msg as void*, msg.len(), out)
end
@en "HmacSha1Hex"
@fa "اچ مک شا۱ شانزدهی"
pub func HmacSha1Hex(key: str, msg: str): str:
out := mem.Allocate(SHA1_DIGEST_SIZE as u64)
defer mem.Free(out)
HmacSha1Bytes(key, msg, out)
mut sb := str.NewBuilder()
defer str.BufFree(sb)
bp := out as u8*
repeat SHA1_DIGEST_SIZE in i:
str.BufAppend(sb, _hex_byte(bp[i] as int))
end
ret str.BufStr(sb)
end
@en "HmacSha1Base64"
@fa "اچ مک شا۱ بیس۶۴"
pub func HmacSha1Base64(key: str, msg: str): str:
out := mem.Allocate(SHA1_DIGEST_SIZE as u64)
defer mem.Free(out)
HmacSha1Bytes(key, msg, out)
ret encoding.Base64EncodeBytes(out, SHA1_DIGEST_SIZE)
end
package crypto
const HMAC_IPAD_BYTE := 0x36
const HMAC_OPAD_BYTE := 0x5C
pure func _hmac_block_size(variant: int): int:
if variant == 256: ret 64 end
ret 128
end
pure func _hmac_digest_size(variant: int): int:
if variant == 256: ret 32 end
if variant == 384: ret 48 end
ret 64
end
func _hmac_hash_once(variant: int, p: void*, n: int, out: void*):
if variant == 256:
Sha256Bytes(p, n, out)
else variant == 384:
Sha384Bytes(p, n, out)
else:
Sha512Bytes(p, n, out)
end
end
func _hmac_pads(key: void*, klen: int, variant: int, ipad: void*, opad: void*):
bs := _hmac_block_size(variant)
kb := mem.AllocateZeroed(bs as u64)
defer mem.Free(kb)
if klen > bs:
_hmac_hash_once(variant, key, klen, kb)
else:
mem.Copy(kb, key, klen as u64)
end
repeat bs in i:
b := _bget(kb, i)
_bput(ipad, i, b ^ HMAC_IPAD_BYTE)
_bput(opad, i, b ^ HMAC_OPAD_BYTE)
end
end
func _hmac_sha256_raw(key: void*, klen: int, msg: void*, mlen: int, out: void*):
ipad := mem.AllocateZeroed(64 as u64)
defer mem.Free(ipad)
opad := mem.AllocateZeroed(64 as u64)
defer mem.Free(opad)
_hmac_pads(key, klen, 256, ipad, opad)
inner := mem.Allocate(32 as u64)
defer mem.Free(inner)
mut si := Sha256New()
Sha256Update(si, ipad, 64)
Sha256Update(si, msg, mlen)
Sha256Final(si, inner)
mut so := Sha256New()
Sha256Update(so, opad, 64)
Sha256Update(so, inner, 32)
Sha256Final(so, out)
end
func _hmac_sha512_raw(variant: int, key: void*, klen: int, msg: void*, mlen: int, out: void*):
ds := _hmac_digest_size(variant)
ipad := mem.AllocateZeroed(128 as u64)
defer mem.Free(ipad)
opad := mem.AllocateZeroed(128 as u64)
defer mem.Free(opad)
_hmac_pads(key, klen, variant, ipad, opad)
inner := mem.Allocate(64 as u64)
defer mem.Free(inner)
mut si := _hmac_sha512_state(variant)
Sha512Update(si, ipad, 128)
Sha512Update(si, msg, mlen)
Sha512Final(si, inner)
mut so := _hmac_sha512_state(variant)
Sha512Update(so, opad, 128)
Sha512Update(so, inner, ds)
Sha512Final(so, out)
end
func _hmac_sha512_state(variant: int): Sha512:
if variant == 384: ret Sha384New() end
ret Sha512New()
end
func _hmac_raw(variant: int, key: void*, klen: int, msg: void*, mlen: int, out: void*):
if variant == 256:
_hmac_sha256_raw(key, klen, msg, mlen, out)
else:
_hmac_sha512_raw(variant, key, klen, msg, mlen, out)
end
end
func _hmac_hex(variant: int, key: str, msg: str): str:
n := _hmac_digest_size(variant)
out := mem.Allocate(n as u64)
defer mem.Free(out)
_hmac_raw(variant, key as void*, key.len(), msg as void*, msg.len(), out)
mut sb := str.NewBuilder()
defer str.BufFree(sb)
repeat n in i:
str.BufAppend(sb, _hex_byte(_bget(out, i)))
end
hex := str.BufStr(sb)
ret hex
end
@en "HmacSha256Raw"
@fa "اچ مک شا۲۵۶ خام"
pub func HmacSha256Raw(key: void*, klen: int, msg: void*, mlen: int, out: void*):
_hmac_sha256_raw(key, klen, msg, mlen, out)
end
