end
func _sha256_update(s &: Sha256, p: void*, n: int):
mut i := 0
until i < n:
space := SHA256_BLOCK - s.blen
mut take := n - i
if take > space:
take = space
end
repeat take in j:
s.blk[s.blen + j] = _bget(p, i + j) as u8
end
s.blen += take
i += take
s.total += take as u64
if s.blen == SHA256_BLOCK:
_sha256_block(s)
s.blen = 0
end
end
end
func _sha256_final(s0: Sha256, out: void*):
mut s := s0
bits := s.total * (8 as u64)
