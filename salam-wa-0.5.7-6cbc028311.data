if my == 0:
mut i := 0 - 1
until i < size + extra:
ws[d - _VP8_BPS + i] = 127 as u8
i += 1
end
else:
repeat size in i:
ws[d - _VP8_BPS + i] = pl[(py - 1) * ps + px + i]
end
ws[d - _VP8_BPS - 1] = (mx > 0 ? pl[(py - 1) * ps + px - 1] : 129 as u8)
end
end
