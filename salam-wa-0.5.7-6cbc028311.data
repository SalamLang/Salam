i -= 1
end
_big_trim(q)
_big_trim(rem)
ret true
end
func _big_mod(r &: Big, a: Big, m: Big): bool:
mut q := _big_new(a.n + 1)
defer _big_free(q)
if q.bad:
ret false
end
ret _big_divmod(q, r, a, m)
end
func _big_modexp(r &: Big, base: Big, e: Big, m: Big): bool:
if m.n == 0:
ret false
end
mut acc := _big_new(m.n + 1)
defer _big_free(acc)
mut cur := _big_new(m.n + 1)
defer _big_free(cur)
mut prod := _big_new(2 * m.n + 2)
defer _big_free(prod)
mut red := _big_new(m.n + 2)
defer _big_free(red)
if acc.bad or cur.bad or prod.bad or red.bad:
ret false
end
_big_set_u32(acc, 1 as u32)
if not _big_mod(cur, base, m):
ret false
end
bits := _big_bitlen(e)
mut i := 0
until i < bits:
if _big_bit(e, i) == 1:
