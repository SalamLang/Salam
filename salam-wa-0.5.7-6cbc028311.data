end
repeat 48 in k:
t := k + 16
x15 := w[t - 15]
x2 := w[t - 2]
s0 := _rotr32(x15, 7 as u32) ^ _rotr32(x15, 18 as u32) ^ (x15 >> (3 as u32))
s1 := _rotr32(x2, 17 as u32) ^ _rotr32(x2, 19 as u32) ^ (x2 >> (10 as u32))
w[t] = w[t - 16] + s0 + w[t - 7] + s1
end
mut a := s.h[0]
mut b := s.h[1]
mut c := s.h[2]
mut d := s.h[3]
mut e := s.h[4]
mut f := s.h[5]
mut g := s.h[6]
mut hh := s.h[7]
