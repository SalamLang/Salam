_ := _vp8_recon4(ws, sb, nb, m, coeffs, lv, qp)
dist := _vp8_sse_rect(sb, ws, _vp8_yblock(nb), 4, 4)
dry.bits = 0
_vp8_bmode_bits(dry, m, top_m, left_m)
_ := _vp8w_coeffs(dry, 3, ctx, lv, (1 + nb) * 16, 0)
sc := dry.bits * lambda_i4 + 256 * dist
if bscore < 0 or sc < bscore:
bscore = sc
bm = m
brate = dry.bits
bdist = dist
end
end
_ := _vp8_recon4(ws, sb, nb, bm, coeffs, lv, qp)
sub[nb] = bm
g := _vp8w_coeffs(dry, 3, ctx, lv, (1 + nb) * 16, 0)
ln.set(by4, g)
tn.set(bx, g)
total4 += brate * lambda_mode + 256 * bdist
if total4 >= score16:
is4 = false
end
end
end
if not is4:
repeat 16 in j:
repeat 16 in i:
ws[_VP8_YOFF + j * _VP8_BPS + i] = save[_VP8_YOFF + j * _VP8_BPS + i]
end
end
mem.Copy(lv as void*, lv16 as void*, (17 * 16 * 4) as u64)
repeat 4 in i:
intra_t.set(mx * 4 + i, ymode)
intra_l[i] = ymode
end
else:
repeat 4 in i:
intra_t.set(mx * 4 + i, sub[12 + i])
intra_l[i] = sub[i * 4 + 3]
end
end
mut uvmode := 0
mut bestuv := 0 - 1
repeat 4 in m:
_ := _vp8_recon_uv(ws, sb, _vp8_edge_mode(m, mx, my), coeffs, lv, qp)
d := _vp8_sse_rect(sb, ws, _VP8_UOFF, 8, 8) + _vp8_sse_rect(sb, ws, _VP8_VOFF, 8, 8)
_vp8_copy9(top_nz, tbase, tn)
_vp8_copy9(left_nz, 0, ln)
dry.bits = 0
_vp8_uvmode_bits(dry, m)
_vp8_tokens_uv(dry, lv, tn, ln)
score := dry.bits * lambda_uv + 256 * d
if bestuv < 0 or score < bestuv:
bestuv = score
uvmode = m
end
end
_ := _vp8_recon_uv(ws, sb, _vp8_edge_mode(uvmode, mx, my), coeffs, lv, qp)
repeat 16 in j:
repeat 16 in i:
ry[(my * 16 + j) * ys + mx * 16 + i] = ws[_VP8_YOFF + j * _VP8_BPS + i]
end
end
repeat 8 in j:
repeat 8 in i:
ru[(my * 8 + j) * uvs + mx * 8 + i] = ws[_VP8_UOFF + j * _VP8_BPS + i]
rv[(my * 8 + j) * uvs + mx * 8 + i] = ws[_VP8_VOFF + j * _VP8_BPS + i]
end
end
mut any := false
repeat 25 * 16 in i:
if lv[i] != 0:
any = true
end
end
if is4:
repeat 16 in i:
lv[i] = 0
end
end
_vp8_copy9(top_nz, tbase, tn)
_vp8_copy9(left_nz, 0, ln)
if not any:
skips += 1
repeat 8 in i:
ln.set(i, 0)
tn.set(i, 0)
end
if not is4:
ln.set(8, 0)
tn.set(8, 0)
end
else:
_vp8_tokens_y(dry, is4, lv, tn, ln)
_vp8_tokens_uv(dry, lv, tn, ln)
end
repeat 25 * 16 in i:
all_lv.push(lv[i])
end
repeat 9 in i:
top_nz.set(tbase + i, tn.get(i))
left_nz.set(i, ln.get(i))
end
modes.push(is4 ? 1 : 0)
modes.push(ymode)
modes.push(uvmode)
modes.push(any ? 0 : 1)
repeat 16 in i:
modes.push(sub[i])
end
end
end
mut st := _Vp8Bw { dry = true, stats = true }
repeat 1056:
st.ones.push(0)
st.seen.push(0)
end
_vp8_token_pass(st, all_lv, modes, mbw, mbh)
mut newp := Vector {} as Vector<int>
mut upd := Vector {} as Vector<int>
repeat 1056 in i:
nb := st.ones.get(i)
tot := st.seen.get(i)
old_p := _VP8_PROBA0[i]
mut use := false
mut np := old_p
if tot > 0:
np = _vp8_clamp(nb > 0 ? 255 - nb * 255 / tot : 255, 255)
if np < 1:
np = 1
end
oldc := nb * _VP8_COST[256 - old_p] + (tot - nb) * _VP8_COST[old_p] + _VP8_COST[_VP8_UPDATE[i]]
newc := nb * _VP8_COST[256 - np] + (tot - nb) * _VP8_COST[np] + _VP8_COST[256 - _VP8_UPDATE[i]] + 8 * 256
use = oldc > newc
end
newp.push(use ? np : old_p)
upd.push(use ? 1 : 0)
end
st.ones.free()
st.seen.free()
tw.probs = newp
_vp8_token_pass(tw, all_lv, modes, mbw, mbh)
_vp8w_flush(tw)
total := mbw * mbh
use_skip := skips > 0
mut skip_p := ((total - skips) * 255) / total
if skip_p < 1:
skip_p = 1
end
if skip_p > 254:
skip_p = 254
end
mut hw := _vp8w_new()
_vp8w_put(hw, 0, 128)
_vp8w_put(hw, 0, 128)
_vp8w_put(hw, 0, 128)
_vp8w_put(hw, 0, 128)
_vp8w_bits(hw, level, 6)
_vp8w_bits(hw, 0, 3)
_vp8w_put(hw, 0, 128)
_vp8w_bits(hw, 0, 2)
_vp8w_bits(hw, q, 7)
repeat 5:
_vp8w_put(hw, 0, 128)
end
_vp8w_put(hw, 0, 128)
repeat 1056 in i:
_vp8w_put(hw, upd.get(i), _VP8_UPDATE[i])
if upd.get(i) == 1:
_vp8w_bits(hw, newp.get(i), 8)
end
end
_vp8w_put(hw, use_skip ? 1 : 0, 128)
if use_skip:
_vp8w_bits(hw, skip_p, 8)
end
repeat mbw * 4 in i:
intra_t.set(i, 0)
end
repeat mbh in my:
repeat 4 in i:
intra_l[i] = 0
end
repeat mbw in mx:
k := (my * mbw + mx) * 20
if use_skip:
_vp8w_put(hw, modes.get(k + 3), skip_p)
end
if modes.get(k) == 0:
_vp8w_put(hw, 1, 145)
ym := modes.get(k + 1)
_vp8_ymode_bits(hw, ym)
repeat 4 in i:
intra_t.set(mx * 4 + i, ym)
intra_l[i] = ym
end
else:
_vp8w_put(hw, 0, 145)
repeat 4 in yy:
repeat 4 in xx:
m := modes.get(k + 4 + yy * 4 + xx)
_vp8_bmode_bits(hw, m, intra_t.get(mx * 4 + xx), intra_l[yy])
intra_t.set(mx * 4 + xx, m)
intra_l[yy] = m
end
end
end
_vp8_uvmode_bits(hw, modes.get(k + 2))
end
end
_vp8w_flush(hw)
p0 := compress.BufLen(hw.buf)
tl := compress.BufLen(tw.buf)
mut out := compress.NewByteBuf()
if p0 >= 524288:
compress.BufFree(hw.buf)
compress.BufFree(tw.buf)
_vp8_free_all(sy, su, sv, ry, ru, rv, ws, sb, save, coeffs, dcs, lv, lv16)
qp.free()
newp.free()
upd.free()
all_lv.free()
modes.free()
top_nz.free()
left_nz.free()
tn.free()
ln.free()
intra_t.free()
ret out
end
tag := (p0 << 5) | (1 << 4)
compress.BufPush(out, tag & 255)
compress.BufPush(out, (tag >> 8) & 255)
compress.BufPush(out, (tag >> 16) & 255)
compress.BufPush(out, 157)
compress.BufPush(out, 1)
compress.BufPush(out, 42)
compress.BufPush(out, width & 255)
compress.BufPush(out, (width >> 8) & 63)
compress.BufPush(out, height & 255)
compress.BufPush(out, (height >> 8) & 63)
compress.BufPushBytes(out, hw.buf.data, p0)
compress.BufPushBytes(out, tw.buf.data, tl)
compress.BufFree(hw.buf)
compress.BufFree(tw.buf)
_vp8_free_all(sy, su, sv, ry, ru, rv, ws, sb, save, coeffs, dcs, lv, lv16)
qp.free()
newp.free()
upd.free()
all_lv.free()
modes.free()
top_nz.free()
left_nz.free()
tn.free()
ln.free()
intra_t.free()
ret out
end
func _vp8_imax(a: int, b: int): int:
ret a > b ? a : b
end
func _vp8_free_all(sy: u8*, su: u8*, sv: u8*, ry: u8*, ru: u8*, rv: u8*, ws: u8*, sb: u8*, save: u8*, coeffs: int*, dcs: int*, lv: int*, lv16: int*):
mem.Free(sy as void*)
mem.Free(su as void*)
mem.Free(sv as void*)
mem.Free(ry as void*)
mem.Free(ru as void*)
mem.Free(rv as void*)
mem.Free(ws as void*)
mem.Free(sb as void*)
mem.Free(save as void*)
mem.Free(coeffs as void*)
mem.Free(dcs as void*)
mem.Free(lv as void*)
mem.Free(lv16 as void*)
end
@en "io"
@fa "ورودی خروجی"
package io
import str
import mem
extern:
func salam_open(path: str, mode: str): File*
func salam_file_read(f: File*, size: u64): str
func salam_file_readline(f: File*): str
func salam_file_write(f: File*, data: str): int
func salam_file_close(f: File*)
func salam_file_seek(f: File*, off: i64, whence: int): int
func fflush(stream: void*): int
func fread(ptr: void*, size: u64, nmemb: u64, stream: void*): u64
func fwrite(ptr: void*, size: u64, nmemb: u64, stream: void*): u64
end
const COPY_CHUNK := 65536
@en "Input"
@fa "بخوان"
pub func Input(): str: ret input () end
@en "Read"
@fa "خواندن"
pub func Read(f: File*, size: u64): str: ret f.read(size) end
@en "Readline"
@fa "خواندن خط"
pub func Readline(f: File*): str: ret f.readline() end
@en "Write"
@fa "نوشتن"
pub func Write(f: File*, data: str): int: ret f.write(data) end
@en "Seek"
@fa "جابجایی مکان نما"
pub func Seek(f: File*, offset: i64, whence: int): int: ret f.seek(offset, whence) end
@en "Close"
@fa "بستن"
pub func Close(f: File*): f.close() end
@en "ReadFile"
@fa "خواندن پرونده"
pub func ReadFile(path: str): str:
f := salam_open(path, "rb")
if f == null:
ret ""
end
out := ReadAll(f)
f.close()
ret out
end
@en "WriteFile"
@fa "نوشتن پرونده"
pub func WriteFile(path: str, data: str): int:
f := salam_open(path, "wb")
if f == null:
ret 0 - 1
end
n := f.write(data)
f.close()
ret n
end
@en "AppendFile"
@fa "افزودن به پرونده"
pub func AppendFile(path: str, data: str): int:
f := salam_open(path, "ab")
if f == null:
ret 0 - 1
end
n := f.write(data)
f.close()
ret n
end
@en "Lines"
@fa "خط ها"
pub func Lines(path: str): Vector<str>:
text := ReadFile(path)
ret text.trim().split("\n")
end
@en "EPrint"
@fa "نوشتن خطا"
pub func EPrint(s: str): printerr s end
@en "EPrintln"
@fa "نوشتن خطا با خط جدید"
pub func EPrintln(s: str): printerrln s end
@en "Flush"
@fa "تخلیه"
pub func Flush():
_r := fflush(null as void*)
end
@en "ReadAll"
@fa "خواندن همه"
pub func ReadAll(f: File*): str:
if f == null:
ret ""
end
mut sb := str.NewBuilder()
defer str.BufFree(sb)
mut chunk := f.read(4096)
until chunk.len() > 0:
str.BufAppend(sb, chunk)
mem.Free(chunk as void*)
chunk = f.read(4096)
end
mem.Free(chunk as void*)
out := str.BufStr(sb)
ret out
end
@en "Copy"
@fa "کپی"
pub func Copy(dst: File*, src: File*): i64:
if src == null or dst == null:
ret 0
end
buf := mem.Allocate(COPY_CHUNK as u64)
if buf == null:
ret 0
end
sp := src as void*
dp := dst as void*
mut total := 0 as i64
mut going := true
until going:
got := fread(buf, 1 as u64, COPY_CHUNK as u64, sp)
if got == 0 as u64:
going = false
else:
put := fwrite(buf, 1 as u64, got, dp)
total += put as i64
if put != got: going = false end
end
end
mem.Free(buf)
ret total
end
@en "WriteLines"
@fa "نوشتن خط ها"
pub func WriteLines(path: str, lines: Vector<str>): int:
f := salam_open(path, "wb")
if f == null:
ret 0 - 1
end
mut total := 0
repeat lines.len() in i:
total += f.write(lines.get(i))
total += f.write("\n")
end
f.close()
ret total
end
@en "jwt"
@fa "جی دبلیو تی"
package jwt
import str
import mem
import conv
import time
import crypto
import encoding
@en "JWT_HS256"
@fa "الگوریتم اچ اس۲۵۶"
pub const JWT_HS256 := "HS256"
@en "JWT_HS384"
@fa "الگوریتم اچ اس۳۸۴"
pub const JWT_HS384 := "HS384"
@en "JWT_HS512"
@fa "الگوریتم اچ اس۵۱۲"
pub const JWT_HS512 := "HS512"
@en "JWT_OK"
@fa "بدون خطا"
pub const JWT_OK := 0
@en "JWT_ERR_MALFORMED"
@fa "خطای قالب توکن"
pub const JWT_ERR_MALFORMED := 1
@en "JWT_ERR_BAD_BASE64"
@fa "خطای پایه۶۴ معیوب"
pub const JWT_ERR_BAD_BASE64 := 2
@en "JWT_ERR_BAD_JSON"
@fa "خطای جیسون معیوب"
pub const JWT_ERR_BAD_JSON := 3
@en "JWT_ERR_ALG_UNSUPPORTED"
@fa "خطای الگوریتم پشتیبانی نشده"
pub const JWT_ERR_ALG_UNSUPPORTED := 4
@en "JWT_ERR_ALG_MISMATCH"
@fa "خطای ناهمخوانی الگوریتم"
pub const JWT_ERR_ALG_MISMATCH := 5
@en "JWT_ERR_SIGNATURE"
@fa "خطای امضا"
pub const JWT_ERR_SIGNATURE := 6
@en "JWT_ERR_EXPIRED"
@fa "خطای انقضا"
pub const JWT_ERR_EXPIRED := 7
@en "JWT_ERR_NOT_YET_VALID"
@fa "خطای هنوز معتبر نیست"
pub const JWT_ERR_NOT_YET_VALID := 8
@en "JWT_ERR_ISSUED_IN_FUTURE"
@fa "خطای صدور در آینده"
pub const JWT_ERR_ISSUED_IN_FUTURE := 9
@en "JWT_ERR_ISSUER"
@fa "خطای صادرکننده"
pub const JWT_ERR_ISSUER := 10
@en "JWT_ERR_AUDIENCE"
@fa "خطای مخاطب"
pub const JWT_ERR_AUDIENCE := 11
@en "JWT_ERR_SUBJECT"
@fa "خطای موضوع"
pub const JWT_ERR_SUBJECT := 12
@en "JWT_ERR_MISSING_CLAIM"
@fa "خطای ادعای ناموجود"
pub const JWT_ERR_MISSING_CLAIM := 13
@en "JWT_ERR_EMPTY_SECRET"
@fa "خطای کلید خالی"
pub const JWT_ERR_EMPTY_SECRET := 14
@en "JWT_ERR_TYPE"
@fa "خطای نوع"
pub const JWT_ERR_TYPE := 15
@en "IsSupportedAlg"
@fa "الگوریتم پشتیبانی می شود"
pub pure func IsSupportedAlg(alg: str): bool:
ret alg == JWT_HS256 or alg == JWT_HS384 or alg == JWT_HS512
end
@en "DigestSize"
@fa "اندازه چکیده"
pub pure func DigestSize(alg: str): int:
if alg == JWT_HS256: ret 32 end
if alg == JWT_HS384: ret 48 end
if alg == JWT_HS512: ret 64 end
ret 0
end
@en "ErrorText"
@fa "متن خطا"
pub pure func ErrorText(code: int): str:
if code == JWT_OK: ret "ok" end
if code == JWT_ERR_MALFORMED: ret "malformed token" end
if code == JWT_ERR_BAD_BASE64: ret "invalid base64url segment" end
if code == JWT_ERR_BAD_JSON: ret "invalid JSON in header or payload" end
if code == JWT_ERR_ALG_UNSUPPORTED: ret "unsupported algorithm" end
if code == JWT_ERR_ALG_MISMATCH: ret "algorithm mismatch" end
if code == JWT_ERR_SIGNATURE: ret "signature does not match" end
if code == JWT_ERR_EXPIRED: ret "token expired" end
if code == JWT_ERR_NOT_YET_VALID: ret "token not yet valid" end
if code == JWT_ERR_ISSUED_IN_FUTURE: ret "token issued in the future" end
if code == JWT_ERR_ISSUER: ret "issuer mismatch" end
if code == JWT_ERR_AUDIENCE: ret "audience mismatch" end
if code == JWT_ERR_SUBJECT: ret "subject mismatch" end
if code == JWT_ERR_MISSING_CLAIM: ret "required claim missing" end
if code == JWT_ERR_EMPTY_SECRET: ret "empty secret" end
if code == JWT_ERR_TYPE: ret "unexpected typ header" end
ret "unknown error"
end
package jwt
inline pure func _bp(s: str): i8*: ret (s as void*) as i8* end
inline pure func _ub(bp: i8*, i: int): int:
mut v := bp[i] as int
if v < 0: v = v + 256 end
ret v
end
pure func _b64url_ok(code: int): bool:
if code >= 65 and code <= 90: ret true end
if code >= 97 and code <= 122: ret true end
if code >= 48 and code <= 57: ret true end
ret code == 45 or code == 95
end
func _to_url_alphabet(s: str): str:
n := s.len()
bp := _bp(s)
mut sb := str.NewBuilder()
defer str.BufFree(sb)
repeat n in i:
code := _ub(bp, i)
if code == 43:
str.BufAppendChar(sb, 45)
else code == 47:
str.BufAppendChar(sb, 95)
else code != 61:
str.BufAppendChar(sb, code)
end
end
out := str.BufStr(sb)
ret out
end
@en "B64UrlEncodeBytes"
@fa "کدگذاری پایه۶۴ نشانی بایت"
pub func B64UrlEncodeBytes(p: void*, n: int): str:
std64 := encoding.Base64EncodeBytes(p, n)
ret _to_url_alphabet(std64)
end
@en "B64UrlEncode"
@fa "کدگذاری پایه۶۴ نشانی"
pub func B64UrlEncode(s: str): str:
ret B64UrlEncodeBytes(s as void*, s.len())
end
@en "B64UrlDecode"
@fa "کدگشایی پایه۶۴ نشانی"
pub func B64UrlDecode(s: str, ok &: bool): str:
ok = false
n := s.len()
if n % 4 == 1: ret "" end
bp := _bp(s)
mut sb := str.NewBuilder()
defer str.BufFree(sb)
repeat n in i:
code := _ub(bp, i)
if not _b64url_ok(code):
ret ""
end
if code == 45:
str.BufAppendChar(sb, 43)
else code == 95:
str.BufAppendChar(sb, 47)
else:
str.BufAppendChar(sb, code)
end
end
pad := (4 - (n % 4)) % 4
repeat pad:
str.BufAppendChar(sb, 61)
end
padded := str.BufStr(sb)
mut good := false
out := encoding.Base64DecodeStrict(padded, good)
ok = good
if not good: ret "" end
ret out
end
package jwt
@en "Claims"
@fa "ادعاها"
pub struct Claims:
pub iss: str = ""
pub sub: str = ""
pub aud: str = ""
pub aud_raw: str = ""
pub exp: i64 = 0
pub nbf: i64 = 0
pub iat: i64 = 0
pub jti: str = ""
pub extra: str = ""
end
pure func _is_registered(key: str): bool:
if key == "iss" or key == "sub" or key == "aud": ret true end
if key == "exp" or key == "nbf" or key == "iat": ret true end
ret key == "jti"
end
func _append_member(c &: Claims, key: str, rendered_value: str):
if c.extra.len() > 0:
c.extra = c.extra.concat(",")
end
c.extra = c.extra.concat(_quoted(key)).concat(":").concat(rendered_value)
end
func _emit(sb &: str.StringBuilder, count: int, key: str, rendered: str): int:
if count > 0: str.BufAppendChar(sb, 44) end
str.BufAppend(sb, _quoted(key))
str.BufAppendChar(sb, 58)
str.BufAppend(sb, rendered)
ret count + 1
end
@en "NewClaims"
@fa "ادعاهای جدید"
pub func NewClaims(): Claims:
ret Claims {}
end
@en "SetStr"
@fa "تنظیم رشته"
pub func SetStr(c &: Claims, key: str, value: str):
if key == "iss": c.iss = value ret end
if key == "sub": c.sub = value ret end
if key == "aud": c.aud = value ret end
if key == "jti": c.jti = value ret end
_append_member(c, key, _quoted(value))
end
@en "SetInt"
@fa "تنظیم عدد"
pub func SetInt(c &: Claims, key: str, value: i64):
if key == "exp": c.exp = value ret end
if key == "nbf": c.nbf = value ret end
if key == "iat": c.iat = value ret end
_append_member(c, key, conv.FormatInt(value))
end
@en "SetBool"
@fa "تنظیم منطقی"
pub func SetBool(c &: Claims, key: str, value: bool):
_append_member(c, key, conv.FormatBool(value))
end
@en "SetRaw"
@fa "تنظیم خام"
pub func SetRaw(c &: Claims, key: str, raw: str):
if key == "aud": c.aud_raw = raw ret end
if _is_registered(key):
ret
end
_append_member(c, key, raw)
end
@en "ExpiresIn"
@fa "انقضا در"
pub func ExpiresIn(c &: Claims, seconds: i64):
now := time.Now()
c.iat = now
c.exp = now + seconds
end
@en "NotBeforeIn"
@fa "معتبر نه پیش از"
pub func NotBeforeIn(c &: Claims, seconds: i64):
c.nbf = time.Now() + seconds
end
@en "ClaimsJSON"
@fa "جیسون ادعاها"
pub func ClaimsJSON(c: Claims): str:
mut sb := str.NewBuilder()
defer str.BufFree(sb)
str.BufAppendChar(sb, 123)
mut count := 0
if c.iss.len() > 0:
count = _emit(sb, count, "iss", _quoted(c.iss))
end
if c.sub.len() > 0:
count = _emit(sb, count, "sub", _quoted(c.sub))
end
if c.aud_raw.len() > 0:
count = _emit(sb, count, "aud", c.aud_raw)
else c.aud.len() > 0:
count = _emit(sb, count, "aud", _quoted(c.aud))
end
if c.exp != 0 as i64:
count = _emit(sb, count, "exp", conv.FormatInt(c.exp))
end
if c.nbf != 0 as i64:
count = _emit(sb, count, "nbf", conv.FormatInt(c.nbf))
end
if c.iat != 0 as i64:
count = _emit(sb, count, "iat", conv.FormatInt(c.iat))
end
if c.jti.len() > 0:
count = _emit(sb, count, "jti", _quoted(c.jti))
end
if c.extra.len() > 0:
if count > 0: str.BufAppendChar(sb, 44) end
str.BufAppend(sb, c.extra)
end
str.BufAppendChar(sb, 125)
out := str.BufStr(sb)
ret out
end
package jwt
import net.http
@en "Guard"
@fa "نگهبان"
pub struct Guard:
pub secret: str = ""
pub opts: Options = Options {}
pub cookie: str = ""
pub realm: str = "api"
end
pure func _lower_ascii(c: int): int:
if c >= 65 and c <= 90: ret c + 32 end
ret c
end
func _strip_bearer(value: str): str:
n := value.len()
if n < 7: ret "" end
want := "bearer"
p := (value as void*) as i8*
w := (want as void*) as i8*
repeat 6 in i:
mut a := p[i] as int
if a < 0: a = a + 256 end
mut b := w[i] as int
if b < 0: b = b + 256 end
if _lower_ascii(a) != b: ret "" end
end
if value.substr(6, 1) != " ": ret "" end
mut start := 6
until start < n and value.substr(start, 1) == " ":
start += 1
end
if start >= n: ret "" end
ret value.substr(start, n - start)
end
func _json_error(code: str, reason: str): str:
ret `{"error":"`.concat(code).concat(`","reason":"`).concat(reason).concat(`"}`)
end
func _challenge(ctx: i64, g: Guard, token_was_offered: bool):
http.SetStatus(ctx, 401)
mut value := `Bearer realm="`.concat(g.realm).concat(`"`)
if token_was_offered:
value = value.concat(`, error="invalid_token"`)
end
http.SetHeader(ctx, "WWW-Authenticate", value)
end
@en "NewGuard"
@fa "نگهبان جدید"
pub func NewGuard(secret: str): Guard:
ret Guard { secret = secret, opts = DefaultOptions() }
end
@en "ParseBearer"
@fa "تجزیه حامل"
pub func ParseBearer(header_value: str): str:
ret _strip_bearer(header_value)
end
@en "BearerToken"
@fa "توکن حامل"
pub func BearerToken(ctx: i64): str:
ret _strip_bearer(http.Header(ctx, "Authorization"))
end
@en "TokenFrom"
@fa "توکن از"
pub func TokenFrom(ctx: i64, g: Guard): str:
bearer := BearerToken(ctx)
if bearer.len() > 0: ret bearer end
if g.cookie.len() > 0: ret http.CookieValue(ctx, g.cookie) end
ret ""
end
@en "Check"
@fa "بررسی"
pub func Check(ctx: i64, g: Guard, err &: int): Token:
raw := TokenFrom(ctx, g)
if raw.len() == 0:
err = JWT_ERR_MALFORMED
ret Token {}
end
ret Verify(raw, g.secret, g.opts, err)
end
@en "Unauthorized"
@fa "غیرمجاز"
pub func Unauthorized(ctx: i64, g: Guard, reason: str):
_challenge(ctx, g, true)
http.Json(ctx, _json_error("unauthorized", reason))
end
@en "MissingCredential"
@fa "بدون گواهی"
pub func MissingCredential(ctx: i64, g: Guard):
_challenge(ctx, g, false)
http.Json(ctx, _json_error("unauthorized", "missing bearer token"))
end
@en "Forbidden"
@fa "ممنوع"
pub func Forbidden(ctx: i64, reason: str):
http.SetStatus(ctx, 403)
http.Json(ctx, _json_error("forbidden", reason))
end
@en "Require"
@fa "نیاز"
pub func Require(ctx: i64, g: Guard, t &: Token): bool:
raw := TokenFrom(ctx, g)
if raw.len() == 0:
MissingCredential(ctx, g)
ret false
end
mut err := 0
verified := Verify(raw, g.secret, g.opts, err)
if err != JWT_OK:
Unauthorized(ctx, g, ErrorText(err))
ret false
end
t = verified
ret true
end
@en "RequireScope"
@fa "نیاز به دامنه"
pub func RequireScope(ctx: i64, g: Guard, scope: str, t &: Token): bool:
if not Require(ctx, g, t): ret false end
if not HasScope(t, scope):
Forbidden(ctx, "missing scope: ".concat(scope))
ret false
end
ret true
end
@en "RequireClaim"
@fa "نیاز به ادعا"
pub func RequireClaim(ctx: i64, g: Guard, key: str, value: str, t &: Token): bool:
if not Require(ctx, g, t): ret false end
if not ListHas(t, key, value):
Forbidden(ctx, "missing ".concat(key).concat(": ").concat(value))
ret false
end
ret true
end
@en "RequireSubject"
@fa "نیاز به موضوع"
pub func RequireSubject(ctx: i64, g: Guard, subject: str, t &: Token): bool:
if not Require(ctx, g, t): ret false end
if t.claims.sub != subject:
Forbidden(ctx, "not your resource")
ret false
end
ret true
end
package jwt
pure func _is_ws(code: int): bool:
ret code == 32 or code == 9 or code == 10 or code == 13
end
func _skip_ws(s: str, from: int): int:
n := s.len()
bp := _bp(s)
mut i := from
until i < n and _is_ws(_ub(bp, i)):
i += 1
end
ret i
end
func _end_of_string(s: str, p: int): int:
n := s.len()
bp := _bp(s)
mut i := p + 1
until i < n:
code := _ub(bp, i)
if code == 92:
i += 2
continue
end
if code == 34: ret i + 1 end
i += 1
end
ret 0 - 1
end
func _end_of_group(s: str, p: int): int:
n := s.len()
bp := _bp(s)
mut depth := 0
mut i := p
until i < n:
code := _ub(bp, i)
if code == 34:
e := _end_of_string(s, i)
if e < 0: ret 0 - 1 end
i = e
continue
end
if code == 123 or code == 91:
depth += 1
else code == 125 or code == 93:
depth -= 1
if depth == 0: ret i + 1 end
end
i += 1
end
ret 0 - 1
end
func _end_of_value(s: str, p: int): int:
n := s.len()
if p >= n: ret 0 - 1 end
bp := _bp(s)
code := _ub(bp, p)
if code == 34: ret _end_of_string(s, p) end
if code == 123 or code == 91: ret _end_of_group(s, p) end
mut i := p
until i < n:
c := _ub(bp, i)
if c == 44 or c == 125 or c == 93 or _is_ws(c): ret i end
i += 1
end
ret n
end
func _slice_eq(text: str, start: int, length: int, key: str): bool:
if length != key.len(): ret false end
tp := _bp(text)
kp := _bp(key)
repeat length in i:
if _ub(tp, start + i) != _ub(kp, i): ret false end
end
ret true
end
func _key_eq(text: str, start: int, length: int, key: str): bool:
tp := _bp(text)
mut escaped := false
repeat length in i:
if _ub(tp, start + i) == 92:
escaped = true
break
end
end
if escaped: ret _unescape(text.substr(start, length)) == key end
ret _slice_eq(text, start, length, key)
end
func _member_all(text: str, key: str, count &: int): str:
count = 0
mut first := ""
n := text.len()
if n == 0: ret "" end
bp := _bp(text)
mut p := _skip_ws(text, 0)
if p >= n or _ub(bp, p) != 123: ret "" end
p += 1
until p < n:
p = _skip_ws(text, p)
if p >= n or _ub(bp, p) == 125: ret first end
if _ub(bp, p) != 34: ret first end
ke := _end_of_string(text, p)
if ke < 0: ret first end
matched := _key_eq(text, p + 1, ke - p - 2, key)
p = _skip_ws(text, ke)
if p >= n or _ub(bp, p) != 58: ret first end
vs := _skip_ws(text, p + 1)
ve := _end_of_value(text, vs)
if ve < 0: ret first end
if matched:
if count == 0: first = text.substr(vs, ve - vs) end
count += 1
end
p = _skip_ws(text, ve)
if p < n and _ub(bp, p) == 44:
p += 1
continue
end
ret first
end
ret first
end
func _member_raw(text: str, key: str, found &: bool): str:
mut count := 0
v := _member_all(text, key, count)
found = count > 0
ret v
end
func _member_count(text: str, key: str): int:
mut count := 0
_v := _member_all(text, key, count)
ret count
end
func _raw_to_str(raw: str): str:
if raw.len() == 0: ret "" end
bp := _bp(raw)
c := _ub(bp, 0)
if c == 34:
ret _unescape(raw.substr(1, raw.len() - 2))
end
if c == 123 or c == 91: ret "" end
if raw == "null": ret "" end
ret raw
end
pure func _raw_to_i64(raw: str): i64:
n := raw.len()
if n == 0: ret 0 end
bp := _bp(raw)
mut i := 0
mut neg := false
if _ub(bp, 0) == 45:
neg = true
i = 1
else _ub(bp, 0) == 43:
i = 1
end
mut v := 0 as i64
mut digits := 0
until i < n:
c := _ub(bp, i)
if c < 48 or c > 57: break end
v = v * (10 as i64) + ((c - 48) as i64)
digits += 1
i += 1
end
if digits == 0: ret 0 end
if neg: ret 0 as i64 - v end
ret v
end
func _raw_has_string(raw: str, want: str): bool:
n := raw.len()
if n == 0: ret false end
bp := _bp(raw)
if _ub(bp, 0) == 34:
ret _raw_to_str(raw) == want
end
if _ub(bp, 0) != 91: ret false end
mut i := 1
until i < n:
i = _skip_ws(raw, i)
if i >= n or _ub(bp, i) == 93: ret false end
e := _end_of_value(raw, i)
if e < 0: ret false end
if _raw_to_str(raw.substr(i, e - i)) == want: ret true end
i = _skip_ws(raw, e)
if i < n and _ub(bp, i) == 44:
i += 1
continue
end
ret false
end
ret false
end
package jwt
func _utf8_append(sb &: str.StringBuilder, cp: int):
if cp < 0x80:
str.BufAppendChar(sb, cp)
else cp < 0x800:
str.BufAppendChar(sb, 0xC0 | (cp >> 6))
str.BufAppendChar(sb, 0x80 | (cp & 0x3F))
else cp < 0x10000:
str.BufAppendChar(sb, 0xE0 | (cp >> 12))
str.BufAppendChar(sb, 0x80 | ((cp >> 6) & 0x3F))
str.BufAppendChar(sb, 0x80 | (cp & 0x3F))
else:
str.BufAppendChar(sb, 0xF0 | (cp >> 18))
str.BufAppendChar(sb, 0x80 | ((cp >> 12) & 0x3F))
str.BufAppendChar(sb, 0x80 | ((cp >> 6) & 0x3F))
str.BufAppendChar(sb, 0x80 | (cp & 0x3F))
end
end
pure func _hex_digit(code: int): int:
if code >= 48 and code <= 57: ret code - 48 end
if code >= 97 and code <= 102: ret code - 87 end
if code >= 65 and code <= 70: ret code - 55 end
ret 0 - 1
end
func _hex4(s: str, i: int): int:
if i + 3 >= s.len(): ret 0 - 1 end
bp := _bp(s)
mut v := 0
repeat 4 in k:
d := _hex_digit(_ub(bp, i + k))
if d < 0: ret 0 - 1 end
v = v * 16 + d
end
ret v
end
func _unescape(s: str): str:
n := s.len()
bp := _bp(s)
mut sb := str.NewBuilder()
defer str.BufFree(sb)
mut i := 0
until i < n:
code := _ub(bp, i)
if code != 92:
str.BufAppendChar(sb, code)
i += 1
continue
end
if i + 1 >= n: break end
esc := _ub(bp, i + 1)
i += 2
if esc == 110: str.BufAppendChar(sb, 10)
else esc == 116: str.BufAppendChar(sb, 9)
else esc == 114: str.BufAppendChar(sb, 13)
else esc == 98: str.BufAppendChar(sb, 8)
else esc == 102: str.BufAppendChar(sb, 12)
else esc == 117:
cp := _hex4(s, i)
if cp < 0: continue end
i += 4
if cp >= 0xD800 and cp <= 0xDBFF and i + 1 < n and _ub(bp, i) == 92 and _ub(bp, i + 1) == 117:
lo := _hex4(s, i + 2)
if lo >= 0xDC00 and lo <= 0xDFFF:
i += 6
_utf8_append(sb, 0x10000 + ((cp - 0xD800) << 10) + (lo - 0xDC00))
continue
end
end
_utf8_append(sb, cp)
else:
str.BufAppendChar(sb, esc)
end
end
out := str.BufStr(sb)
ret out
end
func _hexchar(v: int): int:
if v < 10: ret 48 + v end
ret 87 + v
end
func _escape(s: str): str:
n := s.len()
bp := _bp(s)
mut sb := str.NewBuilder()
defer str.BufFree(sb)
repeat n in i:
code := _ub(bp, i)
if code == 34:
str.BufAppend(sb, `\"`)
else code == 92:
str.BufAppend(sb, `\\`)
else code == 10:
str.BufAppend(sb, `\n`)
else code == 9:
str.BufAppend(sb, `\t`)
else code == 13:
str.BufAppend(sb, `\r`)
else code == 8:
str.BufAppend(sb, `\b`)
else code == 12:
str.BufAppend(sb, `\f`)
else code < 32:
str.BufAppend(sb, `\u00`)
str.BufAppendChar(sb, _hexchar(code / 16))
str.BufAppendChar(sb, _hexchar(code % 16))
else:
str.BufAppendChar(sb, code)
end
end
out := str.BufStr(sb)
ret out
end
func _quoted(s: str): str:
ret `"`.concat(_escape(s)).concat(`"`)
end
package jwt
import crypto
func _cookie_name(g: Guard): str:
if g.cookie.len() > 0: ret g.cookie end
ret "session"
end
func _refresh_id(subject: str): str:
ret subject.concat("-").concat(crypto.RandomHex(16))
end
func _write_session_cookie(ctx: i64, g: Guard, token: str, max_age: int, secure: bool):
mut c := http.Cookie {}
c.name = _cookie_name(g)
c.value = token
c.path = "/"
c.max_age = max_age
c.has_max_age = true
c.http_only = true
c.secure = secure
c.same_site = "Lax"
http.SetCookie(ctx, c)
end
@en "Issue"
@fa "صدور"
pub func Issue(g: Guard, c: Claims, ttl: i64, err &: int): str:
mut claims := c
ExpiresIn(claims, ttl)
if g.opts.issuer.len() > 0 and claims.iss.len() == 0:
claims.iss = g.opts.issuer
end
if g.opts.audience.len() > 0 and claims.aud.len() == 0 and claims.aud_raw.len() == 0:
claims.aud = g.opts.audience
end
mut alg := g.opts.alg
if alg.len() == 0: alg = JWT_HS256 end
ret Sign(claims, alg, g.secret, err)
end
@en "IssueFor"
@fa "صدور برای"
pub func IssueFor(g: Guard, subject: str, ttl: i64, err &: int): str:
mut c := NewClaims()
c.sub = subject
ret Issue(g, c, ttl, err)
end
@en "IssuePair"
@fa "صدور جفت"
pub func IssuePair(g: Guard, subject: str, access_ttl: i64, refresh_ttl: i64, access &: str, refresh &: str, err &: int): bool:
mut a := NewClaims()
a.sub = subject
SetStr(a, "kind", "access")
access = Issue(g, a, access_ttl, err)
if err != JWT_OK: ret false end
mut r := NewClaims()
r.sub = subject
r.jti = _refresh_id(subject)
SetStr(r, "kind", "refresh")
refresh = Issue(g, r, refresh_ttl, err)
ret err == JWT_OK
end
@en "SetSessionCookie"
@fa "تنظیم کوکی نشست"
pub func SetSessionCookie(ctx: i64, g: Guard, token: str, max_age: int):
_write_session_cookie(ctx, g, token, max_age, true)
end
@en "SetSessionCookieInsecure"
@fa "تنظیم کوکی نشست ناامن"
pub func SetSessionCookieInsecure(ctx: i64, g: Guard, token: str, max_age: int):
_write_session_cookie(ctx, g, token, max_age, false)
end
@en "ClearSessionCookie"
@fa "پاک کردن کوکی نشست"
pub func ClearSessionCookie(ctx: i64, g: Guard):
http.ClearCookie(ctx, _cookie_name(g))
end
package jwt
func _header_json(alg: str, kid: str): str:
mut sb := str.NewBuilder()
defer str.BufFree(sb)
str.BufAppend(sb, `{"alg":`)
str.BufAppend(sb, _quoted(alg))
str.BufAppend(sb, `,"typ":"JWT"`)
if kid.len() > 0:
str.BufAppend(sb, `,"kid":`)
str.BufAppend(sb, _quoted(kid))
end
str.BufAppendChar(sb, 125)
out := str.BufStr(sb)
ret out
end
func _signature(alg: str, secret: str, signing_input: str): str:
n := DigestSize(alg)
if n == 0: ret "" end
out := mem.Allocate(n as u64)
defer mem.Free(out)
if alg == JWT_HS256:
crypto.HmacSha256Bytes(secret, signing_input, out)
else alg == JWT_HS384:
crypto.HmacSha384Bytes(secret, signing_input, out)
else:
crypto.HmacSha512Bytes(secret, signing_input, out)
end
sig := B64UrlEncodeBytes(out, n)
ret sig
end
@en "SignJSON"
@fa "امضای جیسون"
pub func SignJSON(payload_json: str, alg: str, kid: str, secret: str, err &: int): str:
err = JWT_OK
if not IsSupportedAlg(alg):
err = JWT_ERR_ALG_UNSUPPORTED
ret ""
end
if secret.len() == 0:
err = JWT_ERR_EMPTY_SECRET
ret ""
end
signing_input := B64UrlEncode(_header_json(alg, kid)).concat(".").concat(B64UrlEncode(payload_json))
ret signing_input.concat(".").concat(_signature(alg, secret, signing_input))
end
@en "SignatureOf"
@fa "امضای ورودی"
pub func SignatureOf(signing_input: str, alg: str, secret: str): str:
if secret.len() == 0: ret "" end
ret _signature(alg, secret, signing_input)
end
@en "SignWithKid"
@fa "امضا با شناسه کلید"
pub func SignWithKid(c: Claims, alg: str, kid: str, secret: str, err &: int): str:
ret SignJSON(ClaimsJSON(c), alg, kid, secret, err)
end
@en "Sign"
@fa "امضا"
pub func Sign(c: Claims, alg: str, secret: str, err &: int): str:
ret SignJSON(ClaimsJSON(c), alg, "", secret, err)
end
@en "SignHS256"
@fa "امضای اچ اس۲۵۶"
pub func SignHS256(c: Claims, secret: str, err &: int): str:
ret SignJSON(ClaimsJSON(c), JWT_HS256, "", secret, err)
end
@en "SignHS384"
@fa "امضای اچ اس۳۸۴"
pub func SignHS384(c: Claims, secret: str, err &: int): str:
ret SignJSON(ClaimsJSON(c), JWT_HS384, "", secret, err)
end
@en "SignHS512"
@fa "امضای اچ اس۵۱۲"
pub func SignHS512(c: Claims, secret: str, err &: int): str:
ret SignJSON(ClaimsJSON(c), JWT_HS512, "", secret, err)
end
package jwt
@en "Token"
@fa "توکن"
pub struct Token:
pub alg: str = ""
pub typ: str = ""
pub kid: str = ""
pub claims: Claims = Claims {}
pub header_json: str = ""
pub payload_json: str = ""
pub signing_input: str = ""
pub signature: str = ""
pub valid: bool = false
end
func _claim_raw(t: Token, key: str, found &: bool): str:
ret _member_raw(t.payload_json, key, found)
end
@en "Has"
@fa "دارد"
pub func Has(t: Token, key: str): bool:
mut found := false
_unused := _claim_raw(t, key, found)
ret found
end
@en "Raw"
@fa "خام"
pub func Raw(t: Token, key: str): str:
mut found := false
raw := _claim_raw(t, key, found)
if not found: ret "" end
ret raw
end
@en "Str"
@fa "رشته"
pub func Str(t: Token, key: str): str:
mut found := false
raw := _claim_raw(t, key, found)
if not found: ret "" end
ret _raw_to_str(raw)
end
@en "Int"
@fa "عدد"
pub func Int(t: Token, key: str): i64:
mut found := false
raw := _claim_raw(t, key, found)
if not found: ret 0 end
ret _raw_to_i64(raw)
end
@en "Bool"
@fa "منطقی"
pub func Bool(t: Token, key: str): bool:
mut found := false
raw := _claim_raw(t, key, found)
if not found: ret false end
ret raw == "true"
end
@en "HasAudience"
@fa "مخاطب دارد"
pub func HasAudience(t: Token, want: str): bool:
mut found := false
raw := _claim_raw(t, "aud", found)
if not found: ret false end
ret _raw_has_string(raw, want)
end
@en "ListHas"
@fa "فهرست دارد"
pub func ListHas(t: Token, key: str, want: str): bool:
mut found := false
raw := _claim_raw(t, key, found)
if not found: ret false end
ret _raw_has_string(raw, want)
end
@en "HasScope"
@fa "دامنه دارد"
pub func HasScope(t: Token, want: str): bool:
scopes := Str(t, "scope")
if scopes.len() == 0 or want.len() == 0: ret false end
n := scopes.len()
w := want.len()
mut i := 0
until i < n:
mut e := i
until e < n and scopes.substr(e, 1) != " ":
e += 1
end
if e - i == w and scopes.substr(i, w) == want: ret true end
i = e + 1
end
ret false
end
@en "SecondsRemaining"
@fa "ثانیه های باقی مانده"
pub func SecondsRemaining(t: Token): i64:
if t.claims.exp == 0 as i64: ret 0 end
ret t.claims.exp - time.Now()
end
package jwt
@en "Options"
@fa "گزینه ها"
pub struct Options:
pub alg: str = "HS256"
pub issuer: str = ""
pub audience: str = ""
pub subject: str = ""
pub leeway: i64 = 0
pub now: i64 = 0
pub require_exp: bool = false
pub require_nbf: bool = false
pub require_iat: bool = false
pub require_sub: bool = false
pub require_jti: bool = false
pub check_typ: bool = true
end
func _split3(token: str, a &: str, b &: str, c &: str): bool:
n := token.len()
bp := _bp(token)
mut d1 := 0 - 1
mut d2 := 0 - 1
repeat n in i:
if _ub(bp, i) == 46:
if d1 < 0:
d1 = i
else d2 < 0:
d2 = i
else:
ret false
end
end
end
if d1 < 0 or d2 < 0: ret false end
if d1 == 0 or d2 == d1 + 1: ret false end
a = token.substr(0, d1)
b = token.substr(d1 + 1, d2 - d1 - 1)
c = token.substr(d2 + 1, n - d2 - 1)
ret true
end
func _once(text: str, key: str, ok &: bool): str:
mut count := 0
value := _member_all(text, key, count)
if count > 1: ok = false end
ret value
end
func _read_claims(payload: str, c &: Claims, ok &: bool):
c.iss = _raw_to_str(_once(payload, "iss", ok))
c.sub = _raw_to_str(_once(payload, "sub", ok))
c.jti = _raw_to_str(_once(payload, "jti", ok))
aud := _once(payload, "aud", ok)
if aud.len() > 0:
c.aud_raw = aud
c.aud = _raw_to_str(aud)
end
c.exp = _raw_to_i64(_once(payload, "exp", ok))
c.nbf = _raw_to_i64(_once(payload, "nbf", ok))
c.iat = _raw_to_i64(_once(payload, "iat", ok))
end
func _parse(token: str, t &: Token, err &: int): bool:
err = JWT_OK
mut h := ""
mut p := ""
mut s := ""
if not _split3(token, h, p, s):
err = JWT_ERR_MALFORMED
ret false
end
mut ok := false
header := B64UrlDecode(h, ok)
if not ok:
err = JWT_ERR_BAD_BASE64
ret false
end
payload := B64UrlDecode(p, ok)
if not ok:
err = JWT_ERR_BAD_BASE64
ret false
end
mut single := true
mut alg_count := 0
alg := _raw_to_str(_member_all(header, "alg", alg_count))
if alg_count != 1:
err = JWT_ERR_BAD_JSON
ret false
end
t.alg = alg
t.typ = _raw_to_str(_once(header, "typ", single))
t.kid = _raw_to_str(_once(header, "kid", single))
t.header_json = header
t.payload_json = payload
t.signing_input = h.concat(".").concat(p)
t.signature = s
mut c := Claims {}
_read_claims(payload, c, single)
t.claims = c
if not single:
err = JWT_ERR_BAD_JSON
ret false
end
ret true
end
func _typ_ok(typ: str): bool:
n := typ.len()
if n == 0: ret true end
if _lower(typ) == "jwt": ret true end
if n < 4: ret false end
ret _lower(typ.substr(n - 4, 4)) == "+jwt"
end
func _lower(s: str): str:
n := s.len()
bp := _bp(s)
mut sb := str.NewBuilder()
defer str.BufFree(sb)
repeat n in i:
mut c := _ub(bp, i)
if c >= 65 and c <= 90: c = c + 32 end
str.BufAppendChar(sb, c)
end
out := str.BufStr(sb)
ret out
end
func _check_time(t: Token, opts: Options, err &: int): bool:
mut now := opts.now
if now == 0 as i64: now = time.Now() end
if t.claims.exp != 0 as i64 and now - opts.leeway >= t.claims.exp:
err = JWT_ERR_EXPIRED
ret false
end
if t.claims.nbf != 0 as i64 and now + opts.leeway < t.claims.nbf:
err = JWT_ERR_NOT_YET_VALID
ret false
end
if t.claims.iat != 0 as i64 and now + opts.leeway < t.claims.iat:
err = JWT_ERR_ISSUED_IN_FUTURE
ret false
end
ret true
end
func _check_required(t: Token, opts: Options, err &: int): bool:
if opts.require_exp and t.claims.exp == 0 as i64:
err = JWT_ERR_MISSING_CLAIM
ret false
end
if opts.require_nbf and t.claims.nbf == 0 as i64:
err = JWT_ERR_MISSING_CLAIM
ret false
end
if opts.require_iat and t.claims.iat == 0 as i64:
err = JWT_ERR_MISSING_CLAIM
ret false
end
if opts.require_sub and t.claims.sub.len() == 0:
err = JWT_ERR_MISSING_CLAIM
ret false
end
if opts.require_jti and t.claims.jti.len() == 0:
err = JWT_ERR_MISSING_CLAIM
ret false
end
ret true
end
func _check_claims(t: Token, opts: Options, err &: int): bool:
if opts.issuer.len() > 0 and opts.issuer != t.claims.iss:
err = JWT_ERR_ISSUER
ret false
end
if opts.subject.len() > 0 and opts.subject != t.claims.sub:
err = JWT_ERR_SUBJECT
ret false
end
if opts.audience.len() > 0 and not HasAudience(t, opts.audience):
err = JWT_ERR_AUDIENCE
ret false
end
if not _check_required(t, opts, err): ret false end
ret _check_time(t, opts, err)
end
@en "DefaultOptions"
@fa "گزینه های پیش فرض"
pub func DefaultOptions(): Options:
ret Options {}
end
@en "OptionsFor"
@fa "گزینه ها برای"
pub func OptionsFor(alg: str): Options:
ret Options { alg = alg }
end
@en "Decode"
@fa "کدگشایی"
pub func Decode(token: str, err &: int): Token:
mut t := Token {}
_unused := _parse(token, t, err)
ret t
end
@en "Verify"
@fa "تایید"
pub func Verify(token: str, secret: str, opts: Options, err &: int): Token:
mut t := Token {}
if not _parse(token, t, err): ret t end
if secret.len() == 0:
err = JWT_ERR_EMPTY_SECRET
ret t
end
if not IsSupportedAlg(t.alg):
err = JWT_ERR_ALG_UNSUPPORTED
ret t
end
if opts.alg.len() > 0 and opts.alg != t.alg:
err = JWT_ERR_ALG_MISMATCH
ret t
end
if opts.check_typ and not _typ_ok(t.typ):
err = JWT_ERR_TYPE
ret t
end
if _member_count(t.header_json, "crit") > 0:
err = JWT_ERR_ALG_UNSUPPORTED
ret t
end
expected := _signature(t.alg, secret, t.signing_input)
if not crypto.SecretEquals(expected, t.signature):
err = JWT_ERR_SIGNATURE
ret t
end
if not _check_claims(t, opts, err): ret t end
err = JWT_OK
t.valid = true
ret t
end
@en "VerifyHS256"
@fa "تایید اچ اس۲۵۶"
pub func VerifyHS256(token: str, secret: str, err &: int): Token:
ret Verify(token, secret, Options {}, err)
end
@en "IsValid"
@fa "معتبر است"
pub func IsValid(token: str, secret: str, opts: Options): bool:
mut err := 0
t := Verify(token, secret, opts, err)
ret t.valid
end
