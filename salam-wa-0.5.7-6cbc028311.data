pub inline pure func Radians(deg: f64): f64: ret deg * PI / 180.0 end
@en "Degrees"
@fa "درجه"
pub inline pure func Degrees(rad: f64): f64: ret rad * 180.0 / PI end
@en "Factorial"
@fa "فاکتوریل"
pub pure func Factorial(n: int): i64:
mut r := 1 as i64
mut i := 2 as i64
until i <= n as i64:
r *= i
i += 1
end
ret r
end
@en "GcdI64"
@fa "ب م م۶۴"
pub pure func GcdI64(a: i64, b: i64): i64:
mut x := a
mut y := b
if x < 0: x = 0 - x end
if y < 0: y = 0 - y end
until y != 0:
t := y
y = x % y
x = t
end
ret x
end
