if rd > 5:
up = true
else:
if rd == 5:
mut sticky := false
mut i := p + 1
until i < ndig:
if digits[i] != (48 as u8):
sticky = true
i = ndig
else:
i += 1
end
end
if sticky:
up = true
else:
up = (((digits[p - 1] as int) - 48) % 2) == 1
end
end
end
if not up:
ret 0
end
mut k := p - 1
until k >= 0:
if digits[k] == (57 as u8):
digits[k] = 48 as u8
k -= 1
else:
digits[k] = digits[k] + (1 as u8)
ret 0
end
end
mut m := p - 1
until m > 0:
digits[m] = digits[m - 1]
m -= 1
end
