pub func Delete(url: str): Response: ret send("DELETE", url, "", "") end
@en "DeleteWith"
@fa "حذف با"
pub func DeleteWith(url: str, headers: HashMap<str, str>): Response:
ret send("DELETE", url, serialize(headers), "")
end
