package collections
@en "PriorityQueue"
@fa "صف اولویت دار"
pub struct PriorityQueue<T>:
pub h: Vector<T> = Vector {}
pub func _swap(i: int, j: int):
a := this.h.get(i)
b := this.h.get(j)
this.h.set(i, b)
this.h.set(j, a)
end
@en "push"
@fa "افزودن"
pub func push(x: T):
this.h.push(x)
mut i := this.h.len() - 1
mut go := true
until go:
if i == 0:
go = false
else:
p := (i - 1) / 2
if this.h.get(i) < this.h.get(p):
this._swap(i, p)
i = p
else:
go = false
end
end
end
end
@en "peek"
@fa "مشاهده"
pub func peek(): T: ret this.h.get(0) end
@en "size"
@fa "اندازه"
pub func size(): int: ret this.h.len() end
@en "is_empty"
@fa "خالی است"
pub func is_empty(): bool: ret this.h.len() == 0 end
@en "pop"
@fa "برداشتن"
pub func pop(): T:
if SALAM_SAFE:
if this.h.len() == 0: salam_panic("PriorityQueue.pop: empty") end
end
n := this.h.len()
top := this.h.get(0)
last := this.h.pop()
if n > 1:
this.h.set(0, last)
mut i := 0
mut go := true
until go:
l := 2 * i + 1
r := 2 * i + 2
mut sm := i
if l < this.h.len() and this.h.get(l) < this.h.get(sm): sm = l end
if r < this.h.len() and this.h.get(r) < this.h.get(sm): sm = r end
if sm == i: go = false
else:
this._swap(i, sm)
i = sm
end
end
end
ret top
end
@en "free"
@fa "آزادسازی"
pub func free(): this.h.free() end
end
