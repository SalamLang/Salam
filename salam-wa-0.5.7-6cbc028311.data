@en "shell"
@fa "پوسته"
package shell
import os.process
if SALAM_OS_WINDOWS:
extern:
func system(cmd: str): int
end
end
@en "CmdResult"
@fa "نتیجه فرمان"
pub struct CmdResult:
pub code: int = 0
pub out: str = ""
pub err: str = ""
end
@en "Run"
@fa "اجرا"
pub func Run(command: str, args: Vector<str>): CmdResult:
mut p := process.StartCaptured(command, args)
if p.pid <= 0:
process.Cleanup(p)
ret CmdResult { code = 0 - 1 }
end
code := process.Wait(p)
out := process.ReadStdout(p)
err := process.ReadStderr(p)
process.Cleanup(p)
ret CmdResult { code = code, out = out, err = err }
end
@en "Exec"
@fa "اجرا با متن فرمان"
pub func Exec(command: str): CmdResult:
parts := command.split(" ")
defer parts.free()
n := parts.len()
if n == 0: ret CmdResult { code = 0 - 1 } end
exe := parts.get(0)
args := Vector {} as Vector<str>
mut i := 1
until i < n:
seg := parts.get(i)
if seg.len() > 0: args.push(seg) end
i += 1
end
ret Run(exe, args)
end
@en "System"
@fa "اجرای پوسته"
pub func System(command: str): int:
if SALAM_OS_WINDOWS:
ret system(command)
else:
mut args := Vector {} as Vector<str>
args.push("-c")
args.push(command)
mut p := process.Start("/bin/sh", args)
args.free()
if p.pid <= 0:
ret 127
end
ret process.Wait(p)
end
end
@en "temp"
