@en "keys"
@fa "کلیدها"
package keys
import dom
tracked: str[32]
held: bool[32]
once: bool[32]
mut ntracked := 0
func find(k: str): int:
repeat ntracked in i:
if tracked[i] == k: ret i end
end
ret -1
end
@en "Track"
@fa "پیگیری"
pub func Track(k: str):
if find(k) >= 0: ret end
if ntracked >= 32: ret end
tracked[ntracked] = k
held[ntracked] = false
once[ntracked] = false
ntracked = ntracked + 1
end
@en "Init"
@fa "آماده سازی"
pub func Init():
Track("ArrowUp")
Track("ArrowDown")
Track("ArrowLeft")
Track("ArrowRight")
Track("Enter")
Track(" ")
dom.OnWindowE(
"keydown", (ev: i64): i := find(dom.EventKey(ev)) if i >= 0: if not held[i]: once[i] = true end held[i] = true dom.PreventDefault(ev) end end
)
dom.OnWindowE(
"keyup", (ev: i64): i := find(dom.EventKey(ev)) if i >= 0: held[i] = false end end
)
end
@en "Down"
@fa "نگه داشته"
pub func Down(k: str): bool:
i := find(k)
ret i >= 0 and held[i]
end
@en "Pressed"
@fa "فشرده شد"
pub func Pressed(k: str): bool:
i := find(k)
if i < 0: ret false end
if once[i]:
once[i] = false
ret true
end
ret false
end
package web
import str
@en "Url"
@fa "نشانی وب"
pub struct Url:
value: str = ""
@en "set"
@fa "تنظیم"
pub func set(s: str): bool:
if not _w_url_ok(s):
ret false
end
this.value = s
ret true
end
@en "text"
@fa "متن"
pub pure func text(): str:
ret this.value
end
end
@en "Color"
@fa "رنگ وب"
pub struct Color:
value: str = ""
@en "set"
@fa "تنظیم"
pub func set(s: str): bool:
if not _w_color_ok(s):
ret false
end
this.value = s
ret true
end
@en "text"
@fa "متن"
pub pure func text(): str:
ret this.value
end
end
@en "Length"
@fa "اندازه وب"
pub struct Length:
value: str = ""
@en "set"
@fa "تنظیم"
pub func set(s: str): bool:
if not _w_length_ok(s):
ret false
end
this.value = s
ret true
end
@en "text"
@fa "متن"
pub pure func text(): str:
ret this.value
end
end
inline pure func _wb(s: str, i: int): int:
bp := (s as void*) as i8*
mut v := bp[i] as int
if v < 0: v = v + 256 end
ret v
end
pure func _w_lower(c: int): int:
if c >= 65 and c <= 90:
ret c + 32
end
ret c
end
pure func _w_scheme_len(s: str): int:
n := s.len()
if n == 0:
ret 0
end
b0 := _w_lower(_wb(s, 0))
if b0 < 97 or b0 > 122:
ret 0
end
mut i := 1
until i < n:
b := _w_lower(_wb(s, i))
if b == 58:
ret i
end
ok := (b >= 97 and b <= 122) or (b >= 48 and b <= 57) or b == 43 or b == 45 or b == 46
if not ok:
ret 0
end
i += 1
end
ret 0
end
pure func _w_prefix_ci(s: str, p: str): bool:
if s.len() < p.len():
ret false
end
repeat p.len() in i:
if _w_lower(_wb(s, i)) != _wb(p, i):
ret false
end
end
ret true
end
pure func _w_url_ok(s: str): bool:
n := s.len()
if n == 0 or n > 8192:
ret false
end
repeat n in i:
b := _wb(s, i)
if b < 33 or b == 127 or b == 34 or b == 39 or b == 60 or b == 62 or b == 92 or b == 96:
ret false
end
end
sl := _w_scheme_len(s)
if sl == 0:
ret true
end
ret _w_prefix_ci(s, "http://") or _w_prefix_ci(s, "https://") or _w_prefix_ci(s, "mailto:") or _w_prefix_ci(s, "tel:")
end
pure func _w_hex(b: int): bool:
ret (b >= 48 and b <= 57) or (b >= 97 and b <= 102) or (b >= 65 and b <= 70)
end
pure func _w_word(s: str): bool:
if s.len() == 0 or s.len() > 32:
ret false
end
repeat s.len() in i:
b := _w_lower(_wb(s, i))
if b < 97 or b > 122:
ret false
end
end
ret true
end
pure func _w_color_func_ok(s: str): bool:
n := s.len()
if n > 64 or _wb(s, n - 1) != 41:
ret false
end
mut open := 0 - 1
repeat n in i:
if _wb(s, i) == 40 and open < 0:
open = i
end
end
if open <= 0:
ret false
end
fname := s.substr(0, open)
known := fname == "rgb" or fname == "rgba" or fname == "hsl" or fname == "hsla" or fname == "hwb" or fname == "oklch" or fname == "oklab" or fname == "lab" or fname == "lch"
if not known:
ret false
end
mut i := open + 1
until i < n - 1:
b := _wb(s, i)
ok := (b >= 48 and b <= 57) or b == 46 or b == 44 or b == 32 or b == 37 or b == 47 or b == 45 or b == 43 or (b >= 97 and b <= 122)
if not ok:
ret false
end
i += 1
end
ret true
end
pure func _w_color_ok(s: str): bool:
n := s.len()
if n == 0:
ret false
end
if _wb(s, 0) == 35:
if n != 4 and n != 5 and n != 7 and n != 9:
ret false
end
mut i := 1
until i < n:
if not _w_hex(_wb(s, i)):
ret false
end
i += 1
end
ret true
end
if _w_word(s):
ret true
end
ret _w_color_func_ok(s)
end
pure func _w_clamp(v: int, hi: int): int:
if v < 0:
ret 0
end
if v > hi:
ret hi
end
ret v
end
pure func _w_length_ok(s: str): bool:
n := s.len()
if n == 0 or n > 32:
ret false
end
if s == "0" or s == "auto":
ret true
end
mut i := 0
if _wb(s, 0) == 45:
i = 1
end
mut digits := 0
mut dot := false
until i < n:
b := _wb(s, i)
if b >= 48 and b <= 57:
digits += 1
else b == 46 and not dot:
dot = true
else:
break
end
i += 1
end
if digits == 0:
ret false
end
unit := s.substr(i, n - i)
ret unit == "px" or unit == "em" or unit == "rem" or unit == "%" or unit == "vh" or unit == "vw" or unit == "vmin" or unit == "vmax" or unit == "pt" or unit == "ch" or unit == "ex" or unit == "cm" or unit == "mm" or unit == "in" or unit == "fr" or unit == ""
end
func _w_escape(b &: str.StringBuilder, s: str):
n := s.len()
mut clean := true
repeat n in i:
c := _wb(s, i)
if c == 38 or c == 60 or c == 62 or c == 34 or c == 39:
clean = false
break
end
end
if clean:
str.BufAppend(b, s)
ret
end
repeat n in j:
c := _wb(s, j)
if c == 38:
str.BufAppend(b, "&amp;")
else c == 60:
str.BufAppend(b, "&lt;")
else c == 62:
str.BufAppend(b, "&gt;")
else c == 34:
str.BufAppend(b, "&quot;")
else c == 39:
str.BufAppend(b, "&#39;")
else:
str.BufAppendChar(b, c)
end
end
end
@en "ParseUrl"
@fa "خواندن نشانی وب"
