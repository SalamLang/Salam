@en "RandomHex"
@fa "تصادفی ایمن شانزدهی"
pub func RandomHex(n: int): str:
if n <= 0:
ret ""
end
buf := mem.Allocate(n as u64)
defer mem.Free(buf)
_os_random_fill(buf, n)
mut result := ""
repeat n in i:
result = result.concat(_hex_byte(_bget(buf, i)))
end
ret result
end
@en "RandomToken"
@fa "توکن تصادفی ایمن"
pub func RandomToken(n: int): str:
ret RandomHex(n)
end
@en "RandomBytes"
@fa "بایت های تصادفی"
pub func RandomBytes(p: void*, n: int):
if n <= 0:
ret
end
_os_random_fill(p, n)
end
package crypto
@en "Sha1Hex"
@fa "شا۱ شانزدهی"
pub func Sha1Hex(data: str): str:
dlen := data.len()
out := mem.Allocate(20 as u64)
defer mem.Free(out)
