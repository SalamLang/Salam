@en "Type"
@fa "نوع"
pub struct Type:
pub handle: void* = null
end
@en "Value"
@fa "مقدار"
pub struct Value:
pub handle: void* = null
end
@en "BasicBlock"
@fa "بلوک پایه"
pub struct BasicBlock:
pub handle: void* = null
end
@en "Builder"
@fa "سازنده"
pub struct Builder:
pub handle: void* = null
end
func _pack_types(v: Vector<Type>): void*:
n := v.len()
if n == 0:
ret null
end
buf := mem.Allocate((n as u64) * 8)
mut i := 0
until i < n:
slot := ((buf as u64) + (i as u64) * 8) as u64*
slot[0] = v.get(i).handle as u64
i += 1
end
ret buf
end
func _pack_values(v: Vector<Value>): void*:
n := v.len()
if n == 0:
ret null
end
buf := mem.Allocate((n as u64) * 8)
mut i := 0
until i < n:
slot := ((buf as u64) + (i as u64) * 8) as u64*
slot[0] = v.get(i).handle as u64
i += 1
end
ret buf
end
func _pack_blocks(v: Vector<BasicBlock>): void*:
n := v.len()
if n == 0:
ret null
end
buf := mem.Allocate((n as u64) * 8)
mut i := 0
until i < n:
slot := ((buf as u64) + (i as u64) * 8) as u64*
slot[0] = v.get(i).handle as u64
i += 1
end
ret buf
end
@en "NewModule"
@fa "ماژول جدید"
pub func NewModule(ctx: Context, name: str): Module:
ret Module { handle = LLVMModuleCreateWithNameInContext(name, ctx.handle) }
end
@en "ModuleToString"
@fa "ماژول به رشته"
pub func ModuleToString(mod: Module): str:
p := LLVMPrintModuleToString(mod.handle)
if p == null:
ret ""
end
out := str.Clone(p as str)
LLVMDisposeMessage(p)
ret out
end
@en "Int1Type"
@fa "نوع یک بیتی"
pub func Int1Type(c: Context): Type: ret Type { handle = LLVMInt1TypeInContext(c.handle) } end
@en "Int8Type"
@fa "نوع هشت بیتی"
pub func Int8Type(c: Context): Type: ret Type { handle = LLVMInt8TypeInContext(c.handle) } end
@en "Int16Type"
@fa "نوع شانزده بیتی"
pub func Int16Type(c: Context): Type: ret Type { handle = LLVMInt16TypeInContext(c.handle) } end
@en "Int32Type"
@fa "نوع سی‌ودو بیتی"
pub func Int32Type(c: Context): Type: ret Type { handle = LLVMInt32TypeInContext(c.handle) } end
@en "Int64Type"
@fa "نوع شصت‌وچهار بیتی"
pub func Int64Type(c: Context): Type: ret Type { handle = LLVMInt64TypeInContext(c.handle) } end
@en "VoidType"
@fa "نوع تهی"
pub func VoidType(c: Context): Type: ret Type { handle = LLVMVoidTypeInContext(c.handle) } end
@en "FloatType"
@fa "نوع اعشاری"
pub func FloatType(c: Context): Type: ret Type { handle = LLVMFloatTypeInContext(c.handle) } end
@en "DoubleType"
@fa "نوع اعشاری دقیق"
pub func DoubleType(c: Context): Type: ret Type { handle = LLVMDoubleTypeInContext(c.handle) } end
@en "PointerType"
@fa "نوع اشاره‌گر"
pub func PointerType(c: Context): Type: ret Type { handle = LLVMPointerTypeInContext(c.handle, 0) } end
@en "ArrayType"
@fa "نوع آرایه"
pub func ArrayType(elem: Type, n: i64): Type:
ret Type { handle = LLVMArrayType2(elem.handle, n as u64) }
end
@en "FunctionType"
@fa "نوع تابعی"
pub func FunctionType(ret_ty: Type, params: Vector<Type>, vararg: bool): Type:
p := _pack_types(params)
t := LLVMFunctionType(ret_ty.handle, p, params.len(), vararg ? 1 : 0)
if p != null: mem.Free(p) end
ret Type { handle = t }
end
@en "AddFunction"
@fa "افزودن تابعی"
pub func AddFunction(mod: Module, name: str, fnty: Type): Value:
ret Value { handle = LLVMAddFunction(mod.handle, name, fnty.handle) }
end
@en "NamedFunction"
@fa "تابع نام‌دار"
pub func NamedFunction(mod: Module, name: str): Value:
ret Value { handle = LLVMGetNamedFunction(mod.handle, name) }
end
@en "Param"
@fa "پارامتر"
pub func Param(fn: Value, idx: int): Value:
ret Value { handle = LLVMGetParam(fn.handle, idx) }
end
@en "SetLinkage"
@fa "تنظیم پیوند"
pub func SetLinkage(v: Value, linkage: int): LLVMSetLinkage(v.handle, linkage) end
@en "AppendBlock"
@fa "افزودن بلوک"
pub func AppendBlock(c: Context, fn: Value, name: str): BasicBlock:
ret BasicBlock { handle = LLVMAppendBasicBlockInContext(c.handle, fn.handle, name) }
end
@en "NewBuilder"
@fa "سازنده جدید"
pub func NewBuilder(c: Context): Builder:
ret Builder { handle = LLVMCreateBuilderInContext(c.handle) }
end
@en "PositionAtEnd"
