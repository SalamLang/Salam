w[t] = _rotl32(mixed, 1)
t += 1
end
mut a := h0
mut b := h1
mut c := h2
mut d := h3
mut e := h4
t = 0
until t < 80:
mut f := 0 as i64
mut k := 0 as i64
if t < 20:
f = _or32(_and32(b, c), _and32(_not32(b), d))
k = 1518500249
else t < 40:
f = _xor32(_xor32(b, c), d)
k = 1859775393
else t < 60:
f = _or32(_or32(_and32(b, c), _and32(b, d)), _and32(c, d))
k = 2400959708
else:
f = _xor32(_xor32(b, c), d)
k = 3395469782
end
temp := (_rotl32(a, 5) + f + e + k + w[t]) % 4294967296
e = d
d = c
c = _rotl32(b, 30)
b = a
a = temp
t += 1
end
h0 = (h0 + a) % 4294967296
h1 = (h1 + b) % 4294967296
h2 = (h2 + c) % 4294967296
h3 = (h3 + d) % 4294967296
h4 = (h4 + e) % 4294967296
blk += 64
end
_put_word32(outp, 0, h0)
_put_word32(outp, 4, h1)
_put_word32(outp, 8, h2)
_put_word32(outp, 12, h3)
_put_word32(outp, 16, h4)
end
