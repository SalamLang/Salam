pub func Patch(url: str, body: str): Response: ret send("PATCH", url, "", body) end
@en "PatchWith"
@fa "وصله با"
pub func PatchWith(url: str, body: str, headers: HashMap<str, str>): Response:
ret send("PATCH", url, serialize(headers), body)
end
