defer _buf_free(ka)
mut kb2 := _hexbuf("d9c1c1ff4bee2b2e0d1c2b4a3f5e6d7c8b9a0f1e2d3c4b5a69788796a5b4c3d2d9c1c1ff4bee2b2e0d1c2b4a3f5e6d7c")
defer _buf_free(kb2)
mut axb := _newbuf(48)
defer _buf_free(axb)
_putzeros(axb, 48)
mut ayb := _newbuf(48)
defer _buf_free(ayb)
_putzeros(ayb, 48)
mut bxb := _newbuf(48)
defer _buf_free(bxb)
_putzeros(bxb, 48)
mut byb := _newbuf(48)
defer _buf_free(byb)
_putzeros(byb, 48)
_ck(_p384_base_mul(ka.p, axb.p, ayb.p), "p384 public key a")
_ck(_p384_base_mul(kb2.p, bxb.p, byb.p), "p384 public key b")
mut apub := _newbuf(97)
defer _buf_free(apub)
_put8(apub, 4)
_putbuf(apub, axb)
_putbuf(apub, ayb)
mut bpub := _newbuf(97)
defer _buf_free(bpub)
_put8(bpub, 4)
_putbuf(bpub, bxb)
_putbuf(bpub, byb)
mut ss1 := _newbuf(48)
defer _buf_free(ss1)
_putzeros(ss1, 48)
