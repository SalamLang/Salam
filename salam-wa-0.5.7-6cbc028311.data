@en "Run"
@fa "اجرا"
pub func Run(s: Server):
if SALAM_OS_WASM:
_edge_serve(s.router, s.hide_tokens, s.access_log)
else:
lfd := _bind(s)
if lfd < 0:
ret
end
_accept_loop(_srv_pack(_srv_claim(s.router, s.hide_tokens, s.access_log), lfd))
end
end
@en "RunBackground"
@fa "اجرا در پس زمینه"
pub func RunBackground(s: Server): bool:
if SALAM_OS_WASM:
_edge_serve(s.router, s.hide_tokens, s.access_log)
ret true
else:
lfd := _bind(s)
if lfd < 0:
ret false
end
slot := _srv_claim(s.router, s.hide_tokens, s.access_log)
salam_spawn_fn_i64(_accept_loop, _srv_pack(slot, lfd))
ret true
end
end
@en "RunTLS"
@fa "اجرای امن"
pub func RunTLS(s: Server, cert_file: str, key_file: str):
if SALAM_OS_WASM:
_edge_serve(s.router, s.hide_tokens, s.access_log)
else:
lfd := _bind(s)
if lfd < 0:
ret
end
slot := _srv_claim(s.router, s.hide_tokens, s.access_log)
_srv_tls.set(slot, tls.NewServerConfig(cert_file, key_file))
_accept_loop_tls(_srv_pack(slot, lfd))
end
end
package httpx
import mem
import str
import tls
import net.tcp
const RAW_CHUNK := 65536
const RAW_LIMIT_DEFAULT := 268435456
mut _raw_limit := RAW_LIMIT_DEFAULT
struct RawAcc:
pub data: void* = null
pub len: int = 0
pub cap: int = 0
pub bad: bool = false
end
@en "Raw"
@fa "پاسخ خام"
pub struct Raw:
pub status: int = 0
pub head: str = ""
pub data: void* = null
pub len: int = 0
pub ok: bool = false
pub error: str = ""
end
inline func _raw_byte(p: void*, i: int): int:
bp := p as u8*
ret bp[i] as int
end
func _raw_grow(a &: RawAcc, need: int): bool:
if a.bad: ret false end
if a.len + need <= a.cap: ret true end
mut nc := a.cap
if nc < RAW_CHUNK: nc = RAW_CHUNK end
until nc < a.len + need: nc = nc * 2 end
p := mem.Reallocate(a.data, nc as u64)
if p == null:
a.bad = true
ret false
end
a.data = p
a.cap = nc
ret true
end
func _raw_at(a &: RawAcc, off: int): void*:
ret ((a.data as i64) + (off as i64)) as void*
end
func _raw_read_plain(c: tcp.Conn, a &: RawAcc): str:
until true:
if not _raw_grow(a, RAW_CHUNK): ret "out of memory reading the response" end
n := tcp.ReadBytes(c, _raw_at(a, a.len), RAW_CHUNK)
if n <= 0: ret "" end
a.len += n
if a.len > _raw_limit:
ret "the response is larger than the " + _raw_limit + "-byte limit"
end
end
end
func _raw_read_tls(c &: tls.Conn, a &: RawAcc): str:
until true:
if not _raw_grow(a, RAW_CHUNK): ret "out of memory reading the response" end
n := tls.ReadBytes(c, _raw_at(a, a.len), RAW_CHUNK)
if n <= 0: ret "" end
a.len += n
if a.len > _raw_limit:
ret "the response is larger than the " + _raw_limit + "-byte limit"
end
end
end
func _raw_head_end(a &: RawAcc): int:
mut i := 0
until i + 3 < a.len:
if _raw_byte(a.data, i) == 13 and _raw_byte(a.data, i + 1) == 10 and _raw_byte(a.data, i + 2) == 13 and _raw_byte(a.data, i + 3) == 10:
ret i + 4
end
i += 1
end
ret -1
end
func _raw_head_str(a &: RawAcc, n: int): str:
mut sb := str.NewBuilder()
defer str.BufFree(sb)
repeat n in i:
str.BufAppendChar(sb, _raw_byte(a.data, i))
end
ret str.BufStr(sb)
end
func _raw_hexval(c: int): int:
if c >= 48 and c <= 57: ret c - 48 end
if c >= 97 and c <= 102: ret c - 87 end
if c >= 65 and c <= 70: ret c - 55 end
ret -1
end
func _raw_dechunk(a &: RawAcc, start: int, out_len &: int): bool:
mut src := start
mut dst := start
until true:
mut size := 0
mut digits := 0
until src < a.len:
d := _raw_hexval(_raw_byte(a.data, src))
if d < 0: break end
size = size * 16 + d
digits += 1
src += 1
if size > a.len:
ret false
end
end
if digits == 0: ret false end
until src < a.len and _raw_byte(a.data, src) != 10: src += 1 end
if src >= a.len: ret false end
src += 1
if size == 0:
out_len = dst - start
ret true
end
if size < 0 or size > a.len - src: ret false end
if dst != src:
mem.MemMove(_raw_at(a, dst), _raw_at(a, src), size as u64)
end
dst += size
src += size
if src + 1 < a.len and _raw_byte(a.data, src) == 13: src += 2
else src < a.len and _raw_byte(a.data, src) == 10: src += 1
end
end
end
func _raw_finish(a &: RawAcc, err: str): Raw:
if err.len() > 0:
mem.Free(a.data)
ret Raw { error = err }
end
if a.len == 0:
mem.Free(a.data)
ret Raw { error = "the server closed without answering" }
end
head_end := _raw_head_end(a)
if head_end < 0:
mem.Free(a.data)
ret Raw { error = "the response head never ended" }
end
head := _raw_head_str(a, head_end)
mut body_len := a.len - head_end
if body_len > 0 and str.Contains(HeaderValue(head, "Transfer-Encoding").lower(), "chunked"):
mut decoded := 0
if not _raw_dechunk(a, head_end, decoded):
mem.Free(a.data)
ret Raw { error = "the chunked response body could not be decoded" }
end
body_len = decoded
end
status := _raw_status(head)
mut out := Raw {
status = status, head = head, len = body_len, ok = status >= 200 and status < 300
}
if body_len == 0:
mem.Free(a.data)
ret out
end
mem.MemMove(a.data, _raw_at(a, head_end), body_len as u64)
out.data = a.data
ret out
end
func _raw_status(head: str): int:
sp := head.find(" ")
if sp < 0: ret 0 end
ret head.substr(sp + 1, 3).to_int()
end
func _dial_tls(ep: Endpoint, timeout_ms: int, cfg: tls.Config): tls.Conn:
if timeout_ms <= 0: ret tls.Dial(ep.host, ep.port, cfg) end
t := tcp.Dial(ep.host, ep.port)
if not tcp.ConnOk(t): ret tls.Conn { err = "could not connect to " + ep.host } end
tcp.SetDeadline(t, timeout_ms)
ret tls.WrapClient(t.fd, cfg)
end
func _raw_send_plain(
ep: Endpoint, head: str, body: void*, n: int, timeout_ms: int
): Raw:
c := tcp.Dial(ep.host, ep.port)
if not tcp.ConnOk(c):
ret Raw { error = "could not connect to " + ep.host + ":" + ep.port }
end
defer tcp.Close(c)
if timeout_ms > 0: tcp.SetDeadline(c, timeout_ms) end
mut a := RawAcc {}
if tcp.Write(c, head) < 0: ret _raw_finish(a, "could not send the request") end
if n > 0 and tcp.WriteBytes(c, body, n) < 0:
ret _raw_finish(a, "could not send the body")
end
ret _raw_finish(a, _raw_read_plain(c, a))
end
func _raw_send_tls(
ep: Endpoint, head: str, body: void*, n: int, timeout_ms: int, cfg: tls.Config
): Raw:
mut c := _dial_tls(ep, timeout_ms, cfg)
if not tls.ConnOk(c):
e := tls.ConnError(c)
tls.Close(c)
ret Raw { error = "TLS: " + e }
end
defer tls.Close(c)
mut a := RawAcc {}
if tls.Write(c, head) < 0: ret _raw_finish(a, "could not send the request") end
if n > 0 and tls.WriteBytes(c, body, n) < 0:
ret _raw_finish(a, "could not send the body")
end
ret _raw_finish(a, _raw_read_tls(c, a))
end
@en "SendRaw"
@fa "ارسال خام"
pub func SendRaw(ep: Endpoint, head: str, body: void*, n: int): Raw:
ret SendRawTimeout(ep, head, body, n, 0)
end
@en "SendRawTimeout"
@fa "ارسال خام با مهلت"
pub func SendRawTimeout(
ep: Endpoint, head: str, body: void*, n: int, timeout_ms: int
): Raw:
if not ep.ok: ret Raw { error = "the endpoint could not be parsed" } end
if ep.secure: ret _raw_send_tls(ep, head, body, n, timeout_ms, tls.NewConfig(ep.host)) end
ret _raw_send_plain(ep, head, body, n, timeout_ms)
end
@en "SendRawTLS"
@fa "ارسال خام با پیکربندی امن"
pub func SendRawTLS(
ep: Endpoint, head: str, body: void*, n: int, timeout_ms: int, cfg: tls.Config
): Raw:
if not ep.ok: ret Raw { error = "the endpoint could not be parsed" } end
if ep.secure: ret _raw_send_tls(ep, head, body, n, timeout_ms, cfg) end
ret _raw_send_plain(ep, head, body, n, timeout_ms)
end
@en "FreeRaw"
@fa "آزادسازی پاسخ خام"
pub func FreeRaw(r &: Raw):
if r.data != null:
mem.Free(r.data)
r.data = null
end
r.len = 0
end
@en "RawText"
@fa "متن پاسخ خام"
pub func RawText(r: Raw): str:
if r.data == null or r.len == 0: ret "" end
mut sb := str.NewBuilder()
defer str.BufFree(sb)
repeat r.len in i:
b := _raw_byte(r.data, i)
if b == 0: break end
str.BufAppendChar(sb, b)
end
ret str.BufStr(sb)
end
@en "RawLimit"
@fa "سقف پاسخ خام"
pub func RawLimit(): int: ret _raw_limit end
@en "SetRawLimit"
@fa "تنظیم سقف پاسخ خام"
pub func SetRawLimit(bytes: int):
if bytes > 0: _raw_limit = bytes end
end
@en "httpx"
@fa "اچ تی تی پی ساده"
package httpx
import mem
import str
import tls
import net.tcp
const READ_CHUNK := 16384
const MAX_RESPONSE := 33554432
@en "Response"
@fa "پاسخ"
pub struct Response:
pub status: int = 0
pub head: str = ""
pub body: str = ""
pub ok: bool = false
pub error: str = ""
end
@en "Endpoint"
@fa "نقطه پایانی"
pub struct Endpoint:
pub host: str = ""
pub port: int = 443
pub secure: bool = true
pub ok: bool = false
end
func _status_of(head: str): int:
sp := head.find(" ")
if sp < 0: ret 0 end
ret head.substr(sp + 1, 3).to_int()
end
func _split(raw: str, out &: Response):
sep := raw.find("\r\n\r\n")
if sep < 0:
out.head = raw
ret
end
out.head = raw.substr(0, sep + 4)
out.body = raw.substr(sep + 4, raw.len() - sep - 4)
end
func _read_plain(c: tcp.Conn): str:
mut sb := str.NewBuilder()
defer str.BufFree(sb)
mut total := 0
mut chunk := tcp.Read(c, READ_CHUNK)
until chunk.len() > 0 and total < MAX_RESPONSE:
str.BufAppend(sb, chunk)
total += chunk.len()
chunk = tcp.Read(c, READ_CHUNK)
end
ret str.BufStr(sb)
end
func _read_tls(c &: tls.Conn): str:
mut sb := str.NewBuilder()
defer str.BufFree(sb)
mut total := 0
mut chunk := tls.Read(c, READ_CHUNK)
until chunk.len() > 0 and total < MAX_RESPONSE:
str.BufAppend(sb, chunk)
total += chunk.len()
chunk = tls.Read(c, READ_CHUNK)
end
ret str.BufStr(sb)
end
func _send_plain(ep: Endpoint, head: str, body: void*, n: int): Response:
c := tcp.Dial(ep.host, ep.port)
if not tcp.ConnOk(c):
ret Response { error = "could not connect to " + ep.host + ":" + ep.port }
end
defer tcp.Close(c)
if tcp.Write(c, head) < 0: ret Response { error = "could not send the request" } end
if n > 0 and tcp.WriteBytes(c, body, n) < 0:
ret Response { error = "could not send the body" }
end
ret _finish(_read_plain(c))
end
func _send_tls(ep: Endpoint, head: str, body: void*, n: int): Response:
cfg := tls.NewConfig(ep.host)
mut c := tls.Dial(ep.host, ep.port, cfg)
if not tls.ConnOk(c):
e := tls.ConnError(c)
tls.Close(c)
ret Response { error = "TLS: " + e }
end
defer tls.Close(c)
if tls.Write(c, head) < 0: ret Response { error = "could not send the request" } end
if n > 0 and tls.WriteBytes(c, body, n) < 0:
ret Response { error = "could not send the body" }
end
ret _finish(_read_tls(c))
end
func _finish(raw: str): Response:
if raw.len() == 0: ret Response { error = "the server closed without answering" } end
mut out := Response {}
_split(raw, out)
out.status = _status_of(out.head)
out.ok = out.status >= 200 and out.status < 300
ret out
end
func _trim_value(head: str, start: int, stop: int): str:
mut e := stop
if e < 0 or e > head.len(): e = head.len() end
if e <= start: ret "" end
ret str.Trim(head.substr(start, e - start))
end
@en "ParseEndpoint"
@fa "تجزیه نقطه پایانی"
pub func ParseEndpoint(endpoint: str): Endpoint:
mut rest := endpoint
mut secure := true
mut port := 443
if str.StartsWith(rest, "https://"): rest = rest.substr(8, rest.len() - 8)
else str.StartsWith(rest, "http://"):
rest = rest.substr(7, rest.len() - 7)
secure = false
port = 80
else:
ret Endpoint {}
end
slash := rest.find("/")
if slash >= 0: rest = rest.substr(0, slash) end
colon := rest.find(":")
if colon >= 0:
port = rest.substr(colon + 1, rest.len() - colon - 1).to_int()
rest = rest.substr(0, colon)
end
if rest.len() == 0: ret Endpoint {} end
ret Endpoint { host = rest, port = port, secure = secure, ok = true }
end
@en "Send"
@fa "ارسال"
pub func Send(ep: Endpoint, head: str, body: void*, n: int): Response:
if not ep.ok: ret Response { error = "the endpoint could not be parsed" } end
if ep.secure: ret _send_tls(ep, head, body, n) end
ret _send_plain(ep, head, body, n)
end
@en "SendText"
@fa "ارسال متن"
pub func SendText(ep: Endpoint, head: str, body: str): Response:
if body.len() == 0: ret Send(ep, head, null, 0) end
ret Send(ep, head, body as void*, body.len())
end
@en "HeaderValue"
@fa "مقدار سرصفحه"
pub func HeaderValue(head: str, name: str): str:
lower := head.lower()
needle := "\r\n" + name.lower() + ":"
at := lower.find(needle)
if at < 0: ret "" end
start := at + needle.len()
ret _trim_value(head, start, str.IndexFrom(lower, "\r\n", start))
end
@en "CopyOut"
@fa "رونوشت بیرونی"
pub func CopyOut(body: str, out_len &: int): void*:
n := body.len()
if n == 0:
out_len = 0
ret null
end
ptr := mem.Allocate(n as u64)
if ptr == null:
out_len = 0
ret null
end
mem.Copy(ptr, body as void*, n as u64)
out_len = n
ret ptr
end
@en "net/internal/errors"
@fa "خطاها"
package errors
@en "KindNone"
@fa "نوع بدون خطا"
pub const KindNone := 0
@en "KindTimeout"
@fa "اتمام مهلت"
pub const KindTimeout := 1
@en "KindConnectionRefused"
@fa "اتصال رد شد"
pub const KindConnectionRefused := 2
@en "KindConnectionReset"
@fa "بازنشانی اتصال"
pub const KindConnectionReset := 3
@en "KindHostUnreachable"
@fa "میزبان غیرقابل دسترس"
pub const KindHostUnreachable := 4
@en "KindAddressInUse"
@fa "نشانی در حال استفاده"
pub const KindAddressInUse := 5
@en "KindProtocolError"
@fa "خطای پروتکل"
pub const KindProtocolError := 6
@en "KindDNSFailure"
@fa "خطای دی ان اس"
pub const KindDNSFailure := 7
@en "KindWouldBlock"
@fa "مسدود می‌شد"
pub const KindWouldBlock := 8
@en "KindClosed"
@fa "بسته شده"
pub const KindClosed := 9
@en "KindInvalidArgument"
@fa "آرگومان نامعتبر"
pub const KindInvalidArgument := 10
@en "NetError"
@fa "خطای شبکه"
pub struct NetError:
pub kind: int = 0
pub message: str = ""
pub sys_errno: int = 0
end
@en "None"
@fa "بدون خطا"
pub func None(): NetError:
ret NetError { kind = KindNone, message = "", sys_errno = 0 }
end
@en "New"
@fa "خطای جدید"
pub func New(kind: int, message: str): NetError:
ret NetError { kind = kind, message = message, sys_errno = 0 }
end
@en "NewSys"
@fa "خطای سیستمی جدید"
pub func NewSys(kind: int, message: str, sys_errno: int): NetError:
ret NetError { kind = kind, message = message, sys_errno = sys_errno }
end
@en "IsError"
@fa "خطا است"
pub func IsError(e: NetError): bool:
ret e.kind != KindNone
end
@en "IsTimeout"
@fa "اتمام مهلت است"
pub func IsTimeout(e: NetError): bool:
ret e.kind == KindTimeout
end
@en "IsRefused"
@fa "رد شده است"
pub func IsRefused(e: NetError): bool:
ret e.kind == KindConnectionRefused
end
@en "IsClosed"
@fa "بسته شده است"
pub func IsClosed(e: NetError): bool:
ret e.kind == KindClosed
end
@en "IsWouldBlock"
@fa "در حال مسدودشدن است"
pub func IsWouldBlock(e: NetError): bool:
ret e.kind == KindWouldBlock
end
@en "KindName"
@fa "نام نوع خطا"
pub func KindName(kind: int): str:
if kind == KindNone: ret "none" end
if kind == KindTimeout: ret "timeout" end
if kind == KindConnectionRefused: ret "connection_refused" end
if kind == KindConnectionReset: ret "connection_reset" end
if kind == KindHostUnreachable: ret "host_unreachable" end
if kind == KindAddressInUse: ret "address_in_use" end
if kind == KindProtocolError: ret "protocol_error" end
if kind == KindDNSFailure: ret "dns_failure" end
if kind == KindWouldBlock: ret "would_block" end
if kind == KindClosed: ret "closed" end
if kind == KindInvalidArgument: ret "invalid_argument" end
ret "unknown"
end
@en "String"
@fa "متن"
pub func String(e: NetError): str:
if e.kind == KindNone: ret "" end
ret KindName(e.kind) + ": " + e.message
end
@en "internal"
@fa "داخلی"
package internal
@en "net/internal/netbuf"
@fa "بافر"
package netbuf
import mem
import compress
@en "Buffer"
@fa "بافر"
pub struct Buffer:
pub data: compress.ByteBuf = compress.ByteBuf {}
pub r: int = 0
end
@en "New"
@fa "بافر جدید"
pub func New(): Buffer:
mut b := Buffer {}
b.data = compress.NewByteBuf()
ret b
end
@en "NewCap"
@fa "بافر جدید با ظرفیت"
pub func NewCap(capacity: int): Buffer:
mut b := Buffer {}
b.data = compress.NewByteBufCap(capacity)
ret b
end
@en "Free"
@fa "آزادسازی بافر"
pub func Free(b &: Buffer):
compress.BufFree(b.data)
b.r = 0
end
@en "Reset"
@fa "بازنشانی بافر"
pub func Reset(b &: Buffer):
compress.BufReset(b.data)
b.r = 0
end
@en "WriteBytes"
@fa "نوشتن بایت‌ها"
pub func WriteBytes(b &: Buffer, p: void*, n: int):
compress.BufPushBytes(b.data, p, n)
end
@en "WriteStr"
@fa "نوشتن رشته"
pub func WriteStr(b &: Buffer, s: str):
compress.BufPushBytes(b.data, s as void*, s.len())
end
@en "WriteBuf"
@fa "نوشتن بافر"
pub func WriteBuf(b &: Buffer, src: compress.ByteBuf):
compress.BufPushBuf(b.data, src)
end
@en "Unread"
@fa "بایت‌های خوانده‌نشده"
pub func Unread(b: Buffer): int:
ret b.data.len - b.r
end
@en "Available"
@fa "ظرفیت باقی‌مانده"
pub func Available(b: Buffer): int:
ret b.data.cap - b.data.len
end
@en "Peek"
@fa "پیش‌نمایش بدون مصرف"
pub func Peek(b: Buffer, n: int): compress.ByteBuf:
mut take := n
avail := Unread(b)
if take > avail: take = avail end
if take < 0: take = 0 end
mut out := compress.NewByteBufCap(take)
if take > 0:
src := (b.data.data as i64 + b.r) as void*
compress.BufPushBytes(out, src, take)
end
ret out
end
@en "ReadN"
@fa "خواندن بایت‌ها"
pub func ReadN(b &: Buffer, n: int): compress.ByteBuf:
out := Peek(b, n)
b.r += out.len
ret out
end
@en "Consume"
@fa "مصرف بایت‌ها"
pub func Consume(b &: Buffer, n: int):
mut c := n
avail := Unread(b)
if c > avail: c = avail end
if c < 0: c = 0 end
b.r += c
end
@en "Compact"
@fa "فشرده‌سازی بافر"
pub func Compact(b &: Buffer):
if b.r == 0: ret end
remaining := b.data.len - b.r
if remaining > 0:
dst := b.data.data
src := (b.data.data as i64 + b.r) as void*
mem.MemMove(dst, src, remaining as u64)
end
b.data.len = remaining
b.r = 0
end
@en "net/internal/nettls"
@fa "لایه تی ال اس"
package nettls
import tls
@en "NewConfig"
@fa "پیکربندی جدید"
pub func NewConfig(server_name: str): tls.Config:
ret tls.NewConfig(server_name)
end
@en "Dial"
@fa "شماره گیری امن"
pub func Dial(host: str, port: int, cfg: tls.Config): tls.Conn:
ret tls.Dial(host, port, cfg)
end
@en "WrapClient"
@fa "پوشش کارخواه"
pub func WrapClient(fd: i64, cfg: tls.Config): tls.Conn:
ret tls.WrapClient(fd, cfg)
end
@en "ConnOk"
@fa "اتصال معتبر"
pub func ConnOk(c: tls.Conn): bool:
ret tls.ConnOk(c)
end
@en "ConnError"
@fa "خطای اتصال"
pub func ConnError(c: tls.Conn): str:
ret tls.ConnError(c)
end
@en "Write"
@fa "نوشتن"
pub func Write(c &: tls.Conn, data: str): int:
ret tls.Write(c, data)
end
@en "WriteBytes"
@fa "نوشتن بایت"
pub func WriteBytes(c &: tls.Conn, ptr: void*, n: int): int:
ret tls.WriteBytes(c, ptr, n)
end
@en "Read"
@fa "خواندن"
pub func Read(c &: tls.Conn, max: int): str:
ret tls.Read(c, max)
end
@en "ReadBytes"
@fa "خواندن بایت"
pub func ReadBytes(c &: tls.Conn, buf: void*, max: int): int:
ret tls.ReadBytes(c, buf, max)
end
@en "Close"
@fa "بستن"
pub func Close(c &: tls.Conn):
tls.Close(c)
end
@en "net/internal/poller"
@fa "پایشگر"
package poller
import mem
if SALAM_OS_WINDOWS:
link dynamic "ws2_32"
end
if SALAM_OS_WINDOWS:
extern:
func WSAPoll(fds: void*, nfds: u32, timeout: int): int
end
else SALAM_OS_LINUX:
extern:
func epoll_create1(flags: int): int
func epoll_ctl(epfd: int, op: int, fd: int, event: void*): int
func epoll_wait(epfd: int, events: void*, maxevents: int, timeout: int): int
func close(fd: int): int
end
else SALAM_OS_MAC:
extern:
func kqueue(): int
func kevent(kq: int, changelist: void*, nchanges: int, eventlist: void*, nevents: int, timeout: void*): int
func close(fd: int): int
end
else SALAM_OS_BSD:
extern:
func kqueue(): int
func kevent(kq: int, changelist: void*, nchanges: int, eventlist: void*, nevents: int, timeout: void*): int
func close(fd: int): int
end
else:
extern:
func poll(fds: void*, nfds: usize, timeout: int): int
end
end
if SALAM_OS_LINUX or SALAM_OS_MAC or SALAM_OS_BSD:
extern:
func poll(fds: void*, nfds: usize, timeout: int): int
end
end
extern:
func memset(ptr: void*, val: int, n: u64): void*
end
@en "BackendEpoll"
@fa "پشتیبان ای‌پول"
pub const BackendEpoll := 1
@en "BackendKqueue"
@fa "پشتیبان کی‌کیو"
pub const BackendKqueue := 2
@en "BackendWSAPoll"
@fa "پشتیبان دبلیو‌اس‌ای‌پول"
pub const BackendWSAPoll := 3
@en "BackendPoll"
@fa "پشتیبان پول"
pub const BackendPoll := 4
@en "Readable"
@fa "خواندنی"
pub const Readable := 1
@en "Writable"
@fa "نوشتنی"
pub const Writable := 2
@en "Event"
@fa "رویداد"
pub struct Event:
pub fd: i64 = 0
pub readable: bool = false
pub writable: bool = false
pub err: bool = false
end
@en "RegisteredFd"
@fa "توصیف‌گر ثبت‌شده"
pub struct RegisteredFd:
pub fd: i64 = 0
pub interest: int = 0
end
@en "RegisteredFds"
@fa "توصیف‌گرهای ثبت‌شده"
pub struct RegisteredFds:
pub items: Vector<RegisteredFd> = Vector {}
end
@en "Events"
@fa "رویدادها"
pub struct Events:
pub items: Vector<Event> = Vector {}
end
@en "Poller"
@fa "پایشگر"
pub struct Poller:
pub backend: int = 0
pub kfd: i64 = 0 - 1
pub regs: RegisteredFds = RegisteredFds {}
end
func _find_reg(p: Poller, fd: i64): int:
n := p.regs.items.len()
mut i := 0
until i < n:
if p.regs.items.get(i).fd == fd:
ret i
end
i += 1
end
ret 0 - 1
end
func _epoll_evsize(): int:
if SALAM_ARCH_ARM64 or SALAM_ARCH_ARM:
ret 16
else:
ret 12
end
end
func _epoll_dataoff(): int:
if SALAM_ARCH_ARM64 or SALAM_ARCH_ARM:
ret 8
else:
ret 4
end
end
func _epoll_register(_p &: Poller, _fd: i64, _interest: int): bool:
if SALAM_OS_LINUX:
sz := _epoll_evsize()
off := _epoll_dataoff()
ev := mem.Allocate(sz as u64)
defer mem.Free(ev)
memset(ev, 0, sz as u64)
ev32 := ev as int*
mut evbits := 0
if (_interest & Readable) != 0: evbits = evbits | 1 end
if (_interest & Writable) != 0: evbits = evbits | 4 end
ev32[0] = evbits
evi64 := (ev as i64 + off) as i64*
evi64[0] = _fd
r := epoll_ctl(_p.kfd as int, 1, _fd as int, ev)
ret r == 0
else:
ret false
end
end
func _epoll_modify(_p &: Poller, _fd: i64, _interest: int): bool:
if SALAM_OS_LINUX:
sz := _epoll_evsize()
off := _epoll_dataoff()
ev := mem.Allocate(sz as u64)
defer mem.Free(ev)
memset(ev, 0, sz as u64)
ev32 := ev as int*
mut evbits := 0
if (_interest & Readable) != 0: evbits = evbits | 1 end
if (_interest & Writable) != 0: evbits = evbits | 4 end
ev32[0] = evbits
evi64 := (ev as i64 + off) as i64*
evi64[0] = _fd
r := epoll_ctl(_p.kfd as int, 3, _fd as int, ev)
ret r == 0
else:
ret false
end
end
func _epoll_unregister(_p &: Poller, _fd: i64): bool:
if SALAM_OS_LINUX:
r := epoll_ctl(_p.kfd as int, 2, _fd as int, null)
ret r == 0
else:
ret false
end
end
func _epoll_wait(_p &: Poller, _timeout_ms: int): Events:
out := Events {}
if SALAM_OS_LINUX:
cap := 64
sz := _epoll_evsize()
off := _epoll_dataoff()
buf := mem.Allocate((sz * cap) as u64)
defer mem.Free(buf)
n := epoll_wait(_p.kfd as int, buf, cap, _timeout_ms)
mut i := 0
until i < n:
base := buf as i64 + (i * sz)
bitsp := base as int*
bits := bitsp[0]
fdp := (base + off) as i64*
e := Event { fd = fdp[0], readable = (bits & 1) != 0, writable = (bits & 4) != 0, err = (bits & 8) != 0 or (bits & 16) != 0 }
out.items.push(e)
i += 1
end
end
ret out
end
func _kevent_add(_p &: Poller, _fd: i64, _filter: int, _flags: int): bool:
if SALAM_OS_MAC or SALAM_OS_BSD:
kev := mem.Allocate(32 as u64)
defer mem.Free(kev)
memset(kev, 0, 32 as u64)
kp64 := kev as i64*
kp64[0] = _fd
f16 := (kev as i64 + 8) as int*
packed := (_flags * 65536) + (_filter & 65535)
f16[0] = packed
r := kevent(_p.kfd as int, kev, 1, null, 0, null)
ret r == 0
else:
ret false
end
end
func _kqueue_register(_p &: Poller, _fd: i64, _interest: int): bool:
mut ok := true
if (_interest & Readable) != 0:
ok = ok and _kevent_add(_p, _fd, 0 - 1, 1)
end
if (_interest & Writable) != 0:
ok = ok and _kevent_add(_p, _fd, 0 - 2, 1)
end
ret ok
end
func _kqueue_unregister(_p &: Poller, _fd: i64, _interest: int): bool:
mut ok := true
if (_interest & Readable) != 0:
ok = ok and _kevent_add(_p, _fd, 0 - 1, 2)
end
if (_interest & Writable) != 0:
ok = ok and _kevent_add(_p, _fd, 0 - 2, 2)
end
ret ok
end
func _kqueue_wait(_p &: Poller, _timeout_ms: int): Events:
out := Events {}
if SALAM_OS_MAC or SALAM_OS_BSD:
cap := 64
buf := mem.Allocate((32 * cap) as u64)
defer mem.Free(buf)
ts := mem.Allocate(16 as u64)
defer mem.Free(ts)
ts64 := ts as i64*
ts64[0] = (_timeout_ms / 1000) as i64
ts64[1] = ((_timeout_ms % 1000) * 1000000) as i64
n := kevent(_p.kfd as int, null, 0, buf, cap, ts)
mut i := 0
until i < n:
base := buf as i64
entry := base + (i * 32)
fdp := entry as i64*
fd := fdp[0]
packedp := (entry + 8) as int*
packed := packedp[0]
filt := packed & 65535
mut sfilt := filt
if sfilt > 32767: sfilt = sfilt - 65536 end
e := Event { fd = fd, readable = sfilt == (0 - 1), writable = sfilt == (0 - 2), err = false }
out.items.push(e)
i += 1
end
end
ret out
end
func _wsapoll_wait(_p &: Poller, _timeout_ms: int): Events:
out := Events {}
if SALAM_OS_WINDOWS:
n := _p.regs.items.len()
if n == 0: ret out end
buf := mem.Allocate((16 * n) as u64)
defer mem.Free(buf)
memset(buf, 0, (16 * n) as u64)
mut i := 0
until i < n:
r := _p.regs.items.get(i)
base := buf as i64 + (i * 16)
fdp := base as i64*
fdp[0] = r.fd
mut evbits := 0
if (r.interest & Readable) != 0: evbits = evbits | 768 end
if (r.interest & Writable) != 0: evbits = evbits | 16 end
evp := (base + 8) as int*
evp[0] = evbits & 65535
i += 1
end
rc := WSAPoll(buf, n as u32, _timeout_ms)
if rc > 0:
i = 0
until i < n:
base := buf as i64 + (i * 16)
fdp := base as i64*
fd := fdp[0]
revp := (base + 10) as int*
revbits := revp[0] & 65535
if revbits != 0:
e := Event { fd = fd, readable = (revbits & 768) != 0, writable = (revbits & 16) != 0, err = (revbits & 7) != 0 }
out.items.push(e)
end
i += 1
end
end
end
ret out
end
func _poll_wait(_p &: Poller, _timeout_ms: int): Events:
out := Events {}
if not SALAM_OS_WINDOWS:
n := _p.regs.items.len()
if n == 0: ret out end
buf := mem.Allocate((8 * n) as u64)
defer mem.Free(buf)
memset(buf, 0, (8 * n) as u64)
mut i := 0
until i < n:
r := _p.regs.items.get(i)
base := buf as i64 + (i * 8)
fdp := base as int*
fdp[0] = r.fd as int
mut evbits := 0
if (r.interest & Readable) != 0: evbits = evbits | 1 end
if (r.interest & Writable) != 0: evbits = evbits | 4 end
evp := (base + 4) as int*
evp[0] = evbits & 65535
i += 1
end
rc := poll(buf, n as usize, _timeout_ms)
if rc > 0:
i = 0
until i < n:
base := buf as i64 + (i * 8)
fdp := base as int*
fd := fdp[0] as i64
revp := (base + 6) as int*
revbits := revp[0] & 65535
if revbits != 0:
e := Event { fd = fd, readable = (revbits & 1) != 0, writable = (revbits & 4) != 0, err = (revbits & 24) != 0 }
out.items.push(e)
end
i += 1
end
end
end
ret out
end
@en "New"
@fa "پایشگر جدید"
pub func New(): Poller:
if SALAM_OS_LINUX:
kfd := epoll_create1(0) as i64
ret Poller { backend = BackendEpoll, kfd = kfd, regs = RegisteredFds {} }
else SALAM_OS_MAC:
kfd := kqueue() as i64
ret Poller { backend = BackendKqueue, kfd = kfd, regs = RegisteredFds {} }
else SALAM_OS_BSD:
kfd := kqueue() as i64
ret Poller { backend = BackendKqueue, kfd = kfd, regs = RegisteredFds {} }
else SALAM_OS_WINDOWS:
ret Poller { backend = BackendWSAPoll, kfd = 0 - 1, regs = RegisteredFds {} }
else:
ret Poller { backend = BackendPoll, kfd = 0 - 1, regs = RegisteredFds {} }
end
end
@en "Register"
@fa "ثبت"
pub func Register(p &: Poller, fd: i64, interest: int): bool:
if _find_reg(p, fd) >= 0:
ret Modify(p, fd, interest)
end
p.regs.items.push(RegisteredFd { fd = fd, interest = interest })
if p.backend == BackendEpoll:
ret _epoll_register(p, fd, interest)
else p.backend == BackendKqueue:
ret _kqueue_register(p, fd, interest)
end
ret true
end
@en "Modify"
@fa "تغییر"
pub func Modify(p &: Poller, fd: i64, interest: int): bool:
idx := _find_reg(p, fd)
if idx < 0:
ret Register(p, fd, interest)
end
old := p.regs.items.get(idx).interest
p.regs.items.set(idx, RegisteredFd { fd = fd, interest = interest })
if p.backend == BackendEpoll:
ret _epoll_modify(p, fd, interest)
else p.backend == BackendKqueue:
ret _kqueue_unregister(p, fd, old) and _kqueue_register(p, fd, interest)
end
ret true
end
@en "Unregister"
@fa "لغو ثبت"
pub func Unregister(p &: Poller, fd: i64): bool:
idx := _find_reg(p, fd)
mut interest := Readable | Writable
if idx >= 0:
interest = p.regs.items.get(idx).interest
p.regs.items.remove_at(idx)
end
if p.backend == BackendEpoll:
ret _epoll_unregister(p, fd)
else p.backend == BackendKqueue:
ret _kqueue_unregister(p, fd, interest)
end
ret true
end
@en "Wait"
@fa "انتظار"
pub func Wait(p &: Poller, timeout_ms: int): Events:
if p.backend == BackendEpoll:
ret _epoll_wait(p, timeout_ms)
else p.backend == BackendKqueue:
ret _kqueue_wait(p, timeout_ms)
else p.backend == BackendWSAPoll:
ret _wsapoll_wait(p, timeout_ms)
end
ret _poll_wait(p, timeout_ms)
end
@en "Close"
@fa "بستن"
pub func Close(p &: Poller):
if p.kfd >= 0:
if SALAM_OS_LINUX or SALAM_OS_MAC or SALAM_OS_BSD:
close(p.kfd as int)
end
p.kfd = 0 - 1
end
end
@en "net/internal/rawsock"
@fa "سوکت خام"
package rawsock
import mem
import str
if SALAM_OS_WINDOWS:
link dynamic "ws2_32"
end
extern:
func memset(ptr: void*, val: int, n: u64): void*
func memcpy(dst: void*, src: void*, n: u64): void*
func htons(n: int): int
func ntohs(n: int): int
func inet_ntoa(addr: int): str
end
if SALAM_OS_WINDOWS:
extern:
func WSAStartup(version: int, wsa: void*): int
func socket(family: int, socktype: int, proto: int): usize
func connect(s: usize, addr: void*, addrlen: int): int
func bind(s: usize, addr: void*, addrlen: int): int
func listen(s: usize, backlog: int): int
