ret 128
end
if i >= total - 8:
ml := (dlen as i64) * 8
shift := total - 1 - i
mut d := ml
repeat shift:
d /= 256
end
ret (d % 256) as int
end
ret 0
end
func _sha1_core(data: void*, dlen: int, outp: void*):
