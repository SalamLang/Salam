_big_zero(r)
an := a.n
mut borrow := 0 as i64
repeat an in i:
mut d := (_limb(a, i) as i64) - borrow
if i < b.n:
d -= _limb(b, i) as i64
end
if d < 0:
d += 4294967296
borrow = 1
else:
borrow = 0
end
_setlimb(r, i, d as u32)
end
