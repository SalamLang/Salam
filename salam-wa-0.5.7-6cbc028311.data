_big_zero(r)
if a.n == 0 or b.n == 0:
ret
end
an := a.n
bn := b.n
repeat an in i:
mut carry := 0 as u64
av := _limb(a, i) as u64
repeat bn in j:
cur := (_limb(r, i + j) as u64) + av * (_limb(b, j) as u64) + carry
_setlimb(r, i + j, cur as u32)
carry = cur >> (32 as u64)
end
mut k := i + bn
until carry != (0 as u64):
cur := (_limb(r, k) as u64) + carry
_setlimb(r, k, cur as u32)
carry = cur >> (32 as u64)
k += 1
end
end
r.n = a.n + b.n
