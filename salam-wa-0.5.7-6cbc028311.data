_ck(_p384_ecdh(kb2.p, apub.p, apub.len, ss2.p), "p384 ecdh b ok")
_ck(_cteq(ss1.p, ss2.p, 48), "p384 ecdh both sides agree")
mut rootder := _hexbuf(TC_P384_ROOT)
defer _buf_free(rootder)
mut leafder := _hexbuf(TC_P384_LEAF)
defer _buf_free(leafder)
root := _cert_parse(rootder.p, rootder.len)
leaf := _cert_parse(leafder.p, leafder.len)
_ck(root.ok, "x509 parses P-384 root")
_ck(root.pk_alg == PK_EC_P384, "x509 P-384 key recognised")
_ck(root.ec_point.len == 97, "x509 P-384 point is 97 bytes")
_ck(root.sig_alg == SIG_ECDSA_SHA384, "x509 P-384 root sigalg")
_ck(leaf.ok, "x509 parses P-384 leaf")
_ck(_cert_signed_by(root, root), "p384 root self-signature verifies")
_ck(_cert_signed_by(leaf, root), "p384 leaf verifies under P-384 root")
_ck(not _cert_signed_by(root, leaf), "p384 root not signed by leaf")
mut roots := _roots_new()
defer _roots_free(roots)
_roots_add(roots, rootder.p, rootder.len)
mut ch: Reader[8]
repeat 8 in i:
ch[i] = _newreader(null, 0)
end
ch[0] = _readerof(leafder)
now := 20270601000000 as i64
_ck(_verify_chain(ch, 1, roots, "p384.example.com", now) == VERR_NONE, "verify: P-384 chain against P-384 root")
_ck(_verify_chain(ch, 1, roots, "evil.com", now) == VERR_HOSTNAME, "verify: P-384 chain rejects wrong host")
mut empty := _roots_new()
defer _roots_free(empty)
_ck(_verify_chain(ch, 1, empty, "p384.example.com", now) == VERR_UNTRUSTED, "verify: P-384 chain needs a trusted root")
end
package tls
mut _fz_state := 0 as u64
func _fz_next(): int:
_fz_state = _fz_state * (6364136223846793005 as u64) + (1442695040888963407 as u64)
ret ((_fz_state >> (33 as u64)) & (0x7FFFFFFF as u64)) as int
end
func _selftest_fuzz():
_fz_state = 0x5A1A11C0FFEE as u64
mut root := _hexbuf(TC_ROOT)
defer _buf_free(root)
mut leaf := _hexbuf(TC_LEAF)
defer _buf_free(leaf)
mut roots := _roots_new()
defer _roots_free(roots)
_roots_add(roots, root.p, root.len)
mut work := _newbuf(leaf.len + 8)
defer _buf_free(work)
mut ch: Reader[8]
repeat 8 in i:
ch[i] = _newreader(null, 0)
end
now := 20270601000000 as i64
mut accepted := 0
mut parsed := 0
rounds := 400
repeat rounds in iter:
_bufreset(work)
_putbuf(work, leaf)
if (iter % 7) == 0:
cut := 1 + (_fz_next() % work.len)
work.len = work.len - cut
else:
nmut := 1 + (_fz_next() % 3)
repeat nmut:
if work.len > 0:
pos := _fz_next() % work.len
old := _bufat(work, pos)
_bufset(work, pos, (old + 1 + (_fz_next() % 255)) & 0xFF)
end
end
end
if work.len > 0:
c := _cert_parse(work.p, work.len)
if c.ok:
parsed += 1
_cert_match_host(c, "example.com")
end
ch[0] = _readerof(work)
if _verify_chain(ch, 1, roots, "example.com", now) == VERR_NONE:
accepted += 1
end
end
end
_ck(accepted == 0, "fuzz: no mutated certificate verifies")
_ck(parsed > 0, "fuzz: some mutations still reach the parser body")
println "  fuzz:", rounds, "mutations,", parsed, "parsed,", accepted, "accepted"
end
package tls
func _hex_sha256(s: str): str:
mut out := _newbuf(32)
defer _buf_free(out)
_putzeros(out, 32)
crypto.Sha256Bytes(s as void*, s.len(), out.p)
ret _hexofbuf(out)
end
func _hex_sha384(s: str): str:
mut out := _newbuf(48)
defer _buf_free(out)
_putzeros(out, 48)
crypto.Sha384Bytes(s as void*, s.len(), out.p)
ret _hexofbuf(out)
end
func _hex_sha512(s: str): str:
mut out := _newbuf(64)
defer _buf_free(out)
_putzeros(out, 64)
crypto.Sha512Bytes(s as void*, s.len(), out.p)
ret _hexofbuf(out)
end
