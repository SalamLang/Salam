bq := _bn_bitlen(q0)
shift := 54 - (bp - bq)
_bn_copy(p, p0)
_bn_copy(q, q0)
if shift > 0:
if not _bn_shl(p, shift):
ret _encode(neg, 0 as u64, 0)
end
else:
if not _bn_shl(q, 0 - shift):
ret _encode(neg, 0 as u64, 0)
end
end
