end
package collections
@en "Deque"
@fa "صف دوسر"
pub struct Deque<T>:
pub front: Vector<T> = Vector {}
pub back: Vector<T> = Vector {}
pub func _to_front(): until this.back.len() > 0: this.front.push(this.back.pop()) end end
pub func _to_back(): until this.front.len() > 0: this.back.push(this.front.pop()) end end
@en "push_front"
@fa "افزودن به ابتدا"
pub func push_front(x: T): this.front.push(x) end
@en "push_back"
@fa "افزودن به انتها"
pub func push_back(x: T): this.back.push(x) end
@en "pop_front"
@fa "برداشتن از ابتدا"
pub func pop_front(): T:
if this.front.len() == 0: this._to_front() end
ret this.front.pop()
end
@en "pop_back"
@fa "برداشتن از انتها"
pub func pop_back(): T:
if this.back.len() == 0: this._to_back() end
ret this.back.pop()
end
@en "front_val"
@fa "مقدار ابتدا"
pub func front_val(): T:
if this.front.len() == 0: this._to_front() end
ret this.front.last()
end
@en "back_val"
@fa "مقدار انتها"
pub func back_val(): T:
if this.back.len() == 0: this._to_back() end
ret this.back.last()
end
@en "size"
@fa "اندازه"
pub func size(): int: ret this.front.len() + this.back.len() end
@en "is_empty"
@fa "خالی است"
pub func is_empty(): bool: ret this.size() == 0 end
@en "get"
@fa "دریافت"
pub func get(i: int): T:
fl := this.front.len()
if i < fl: ret this.front.get(fl - 1 - i) end
ret this.back.get(i - fl)
end
@en "free"
@fa "آزادسازی"
pub func free():
this.front.free()
this.back.free()
end
end
package collections
@en "HashMap"
@fa "نگاشت درهم"
pub struct HashMap<K, V>:
pub keys: K* = null
pub vals: V* = null
pub state: int* = null
pub cap: int = 0
pub count: int = 0
pub used: int = 0
pub func _index(k: K): int:
mut idx := (hash(k) % (this.cap as u64)) as int
mut firstdel := 0 - 1
kp := this.keys
go := true
until go:
st := this.state[idx]
if st == 0:
if firstdel >= 0: ret firstdel end
ret idx
else st == 1:
if kp[idx] == k: ret idx end
else:
if firstdel < 0: firstdel = idx end
end
idx = (idx + 1) % this.cap
end
ret idx
end
pub func _resize(newcap: int):
ok := this.keys
ov := this.vals
os := this.state
oc := this.cap
this.keys = mem.Allocate((newcap as u64) * sizeof(K)) as K*
this.vals = mem.Allocate((newcap as u64) * sizeof(V)) as V*
this.state = mem.AllocateZeroed((newcap as u64) * sizeof(int)) as int*
this.cap = newcap
this.count = 0
this.used = 0
repeat oc in i:
if os[i] == 1:
okp := ok
ovp := ov
this.put(okp[i], ovp[i])
end
end
if ok != null: mem.Free(ok as void*) end
if ov != null: mem.Free(ov as void*) end
if os != null: mem.Free(os as void*) end
end
@en "put"
@fa "قراردادن"
pub func put(k: K, v: V):
if this.cap == 0:
this._resize(8)
else:
if (this.used + 1) * 10 >= this.cap * 7: this._resize(this.cap * 2) end
end
idx := this._index(k)
kp := this.keys
vp := this.vals
st := this.state[idx]
if st != 1:
this.count += 1
if st == 0: this.used = this.used + 1 end
end
this.state[idx] = 1
kp[idx] = k
vp[idx] = v
end
@en "insert"
@fa "درج"
pub func insert(k: K, v: V): this.put(k, v) end
@en "has"
@fa "دارد"
pub func has(k: K): bool:
if this.cap == 0: ret false end
idx := this._index(k)
ret this.state[idx] == 1
end
@en "get"
@fa "دریافت"
pub func get(k: K): V:
if this.cap != 0:
idx := this._index(k)
vp := this.vals
if this.state[idx] == 1: ret vp[idx] end
end
z := mem.AllocateZeroed(sizeof(V)) as V*
zv := z[0]
mem.Free(z as void*)
ret zv
end
@en "get_or"
@fa "دریافت با پیش فرض"
pub func get_or(k: K, def: V): V:
if this.cap == 0: ret def end
idx := this._index(k)
vp := this.vals
if this.state[idx] == 1: ret vp[idx] end
ret def
end
@en "remove"
@fa "حذف"
pub func remove(k: K): bool:
if this.cap == 0: ret false end
idx := this._index(k)
if this.state[idx] != 1: ret false end
this.state[idx] = 2
this.count -= 1
ret true
end
@en "size"
@fa "اندازه"
pub func size(): int: ret this.count end
@en "is_empty"
@fa "خالی است"
pub func is_empty(): bool: ret this.count == 0 end
@en "iter"
@fa "پیمایشگر"
pub func iter(): MapIter<K, V>:
it := MapIter {} as MapIter<K, V> it.keys = this.keys
it.vals = this.vals
it.state = this.state
it.cap = this.cap
it.pos = 0
ret it
end
@en "free"
@fa "آزادسازی"
pub func free():
if this.keys != null: mem.Free(this.keys as void*) end
if this.vals != null: mem.Free(this.vals as void*) end
if this.state != null: mem.Free(this.state as void*) end
this.keys = null
this.vals = null
this.state = null
this.cap = 0
this.count = 0
this.used = 0
end
end
@en "MapIter"
@fa "پیمایشگر نگاشت"
pub struct MapIter<K, V>:
pub keys: K* = null
pub vals: V* = null
pub state: int* = null
pub cap: int = 0
pub pos: int = 0
pub func _seek():
until this.pos < this.cap:
if this.state[this.pos] == 1: ret end
this.pos += 1
end
end
@en "has_next"
@fa "بعدی دارد"
pub func has_next(): bool:
this._seek()
ret this.pos < this.cap
end
@en "key"
@fa "کلید"
pub func key(): K:
this._seek()
kp := this.keys
ret kp[this.pos]
end
@en "value"
@fa "مقدار"
pub func value(): V:
this._seek()
vp := this.vals
ret vp[this.pos]
end
@en "next"
@fa "بعدی"
pub func next(): this.pos = this.pos + 1 end
end
package collections
@en "LinkedList"
@fa "لیست پیوندی"
pub struct LinkedList<T>:
pub vals: Vector<T> = Vector {}
pub nxt: Vector<int> = Vector {}
pub prv: Vector<int> = Vector {}
pub head: int = 0 - 1
pub tail: int = 0 - 1
pub freed: int = 0 - 1
pub count: int = 0
pub func _alloc(v: T): int:
if this.freed >= 0:
idx := this.freed
this.freed = this.nxt.get(idx)
this.vals.set(idx, v)
ret idx
end
idx := this.vals.len()
this.vals.push(v)
this.nxt.push(0 - 1)
this.prv.push(0 - 1)
ret idx
end
@en "push_back"
@fa "افزودن به انتها"
pub func push_back(v: T):
n := this._alloc(v)
this.nxt.set(n, 0 - 1)
this.prv.set(n, this.tail)
if this.tail >= 0: this.nxt.set(this.tail, n) else:
this.head = n
end
this.tail = n
this.count += 1
end
@en "push_front"
@fa "افزودن به ابتدا"
pub func push_front(v: T):
n := this._alloc(v)
this.prv.set(n, 0 - 1)
this.nxt.set(n, this.head)
if this.head >= 0: this.prv.set(this.head, n) else:
this.tail = n
end
this.head = n
this.count += 1
end
pub func _unlink(n: int):
p := this.prv.get(n)
q := this.nxt.get(n)
if p >= 0: this.nxt.set(p, q) else:
this.head = q
end
if q >= 0: this.prv.set(q, p) else:
this.tail = p
end
this.nxt.set(n, this.freed)
this.freed = n
this.count -= 1
end
@en "pop_front"
@fa "برداشتن از ابتدا"
pub func pop_front(): T:
if SALAM_SAFE:
if this.head < 0: salam_panic("LinkedList.pop_front: empty") end
end
n := this.head
v := this.vals.get(n)
this._unlink(n)
ret v
end
@en "pop_back"
@fa "برداشتن از انتها"
pub func pop_back(): T:
if SALAM_SAFE:
if this.tail < 0: salam_panic("LinkedList.pop_back: empty") end
end
n := this.tail
v := this.vals.get(n)
this._unlink(n)
ret v
end
@en "front_val"
@fa "مقدار ابتدا"
pub func front_val(): T: ret this.vals.get(this.head) end
@en "back_val"
@fa "مقدار انتها"
pub func back_val(): T: ret this.vals.get(this.tail) end
@en "size"
@fa "اندازه"
pub func size(): int: ret this.count end
@en "is_empty"
@fa "خالی است"
pub func is_empty(): bool: ret this.count == 0 end
@en "get"
@fa "دریافت"
pub func get(i: int): T:
if SALAM_SAFE:
if i < 0 or i >= this.count: salam_panic("LinkedList.get: index out of bounds") end
end
mut cur := this.head
repeat i:
cur = this.nxt.get(cur)
end
ret this.vals.get(cur)
end
@en "to_vector"
@fa "تبدیل به بردار"
pub func to_vector(): Vector<T>:
mut out := Vector {} as Vector<T> mut cur := this.head
until cur >= 0:
out.push(this.vals.get(cur))
cur = this.nxt.get(cur)
end
ret out
end
@en "free"
@fa "آزادسازی"
pub func free():
this.vals.free()
this.nxt.free()
this.prv.free()
end
end
package collections
@en "OrderedMap"
@fa "نگاشت مرتب"
pub struct OrderedMap:
pub keys: Vector<str> = Vector {}
pub vals: Vector<str> = Vector {}
pub idx: HashMap<str, int> = HashMap {}
@en "index_of"
@fa "نمایه کلید"
pub func index_of(k: str): int: ret this.idx.get(k) - 1 end
@en "len"
@fa "طول"
pub func len(): int: ret this.keys.len() end
@en "has"
@fa "دارد"
pub func has(k: str): bool: ret this.idx.get(k) > 0 end
@en "get"
@fa "دریافت"
pub func get(k: str): str:
i := this.idx.get(k) - 1
if i < 0: ret "" end
ret this.vals.get(i)
end
@en "get_or"
@fa "دریافت با پیش فرض"
pub func get_or(k: str, def: str): str:
i := this.idx.get(k) - 1
if i < 0: ret def end
ret this.vals.get(i)
end
@en "set"
@fa "تنظیم"
pub func set(k: str, v: str): int:
i := this.idx.get(k) - 1
if i >= 0:
this.vals.set(i, v)
ret i
end
n := this.keys.len()
this.keys.push(k)
this.vals.push(v)
this.idx.put(k, n + 1)
ret n
end
@en "key_at"
@fa "کلید در"
pub func key_at(i: int): str:
if i < 0 or i >= this.keys.len(): ret "" end
ret this.keys.get(i)
end
@en "val_at"
@fa "مقدار در"
pub func val_at(i: int): str:
if i < 0 or i >= this.vals.len(): ret "" end
ret this.vals.get(i)
end
@en "set_at"
@fa "تنظیم در"
pub func set_at(i: int, v: str):
if i < 0 or i >= this.vals.len(): ret end
this.vals.set(i, v)
end
@en "remove"
@fa "حذف"
pub func remove(k: str): int:
i := this.idx.get(k) - 1
if i < 0: ret 0 - 1 end
this.keys.remove_at(i)
this.vals.remove_at(i)
this.idx.remove(k)
mut j := i
until j < this.keys.len():
this.idx.put(this.keys.get(j), j + 1)
j += 1
end
ret i
end
@en "clone_keys"
@fa "رونوشت کلیدها"
pub func clone_keys(): Vector<str>: ret clone(this.keys) end
@en "iter"
@fa "پیمایش"
pub func iter(): OrderedMapIter:
mut it := OrderedMapIter {}
it.keys = this.keys
it.vals = this.vals
ret it
end
@en "free"
@fa "آزادسازی"
pub func free():
this.keys.free()
this.vals.free()
this.idx.free()
end
end
@en "OrderedMapIter"
@fa "پیمایشگر نگاشت مرتب"
pub struct OrderedMapIter:
pub keys: Vector<str> = Vector {}
pub vals: Vector<str> = Vector {}
pub pos: int = 0
@en "has_next"
@fa "بعدی دارد"
pub func has_next(): bool: ret this.pos < this.keys.len() end
@en "key"
@fa "کلید"
pub func key(): str: ret this.keys.get(this.pos) end
@en "value"
@fa "مقدار"
pub func value(): str: ret this.vals.get(this.pos) end
@en "next"
@fa "بعدی"
pub func next(): this.pos = this.pos + 1 end
end
