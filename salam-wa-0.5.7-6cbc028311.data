@fa "از قبل موجود است"
pub const AlreadyExists := 3
@en "InvalidPath"
@fa "مسیر نامعتبر"
pub const InvalidPath := 4
@en "NotSupported"
@fa "پشتیبانی نمی شود"
pub const NotSupported := 5
@en "IOError"
@fa "خطای ورودی خروجی"
pub const IOError := 6
@en "Timeout"
@fa "پایان زمان"
pub const Timeout := 7
