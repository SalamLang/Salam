@en "UUID"
@fa "شناسه یکتا"
pub func UUID(): str:
mut sb := str.NewBuilder()
defer str.BufFree(sb)
repeat 16 in i:
b := rand_int32() % 256
mut bval := b
if i == 6: bval = b % 16 + 64
else i == 8: bval = b % 64 + 128
end
str.BufAppendChar(sb, _hex_digit(bval / 16))
str.BufAppendChar(sb, _hex_digit(bval % 16))
if i == 3 or i == 5 or i == 7 or i == 9:
str.BufAppendChar(sb, 45)
end
end
out := str.BufStr(sb)
ret out
end
@en "ChoiceStr"
