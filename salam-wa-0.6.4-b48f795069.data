@en "Path"
@fa "مسیر"
pub struct Path:
@en "verbs"
@fa "فرمان ها"
pub verbs: Vector<int> = Vector {} as Vector<int>
@en "points"
@fa "نقطه ها"
pub points: Vector<f64> = Vector {} as Vector<f64>
@en "MoveTo"
@fa "حرکت به"
pub func MoveTo(x: f64, y: f64):
this.verbs.push(0)
this.points.push(x)
this.points.push(y)
end
@en "LineTo"
@fa "خط به"
pub func LineTo(x: f64, y: f64):
if this.verbs.len() == 0:
this.verbs.push(0)
else:
this.verbs.push(1)
end
this.points.push(x)
this.points.push(y)
end
@en "QuadTo"
@fa "منحنی درجه دو به"
pub func QuadTo(cx: f64, cy: f64, x: f64, y: f64):
if this.verbs.len() == 0:
this.MoveTo(cx, cy)
end
this.verbs.push(2)
this.points.push(cx)
this.points.push(cy)
this.points.push(x)
this.points.push(y)
end
@en "CubicTo"
@fa "منحنی درجه سه به"
pub func CubicTo(c1x: f64, c1y: f64, c2x: f64, c2y: f64, x: f64, y: f64):
if this.verbs.len() == 0:
this.MoveTo(c1x, c1y)
end
this.verbs.push(3)
this.points.push(c1x)
this.points.push(c1y)
this.points.push(c2x)
this.points.push(c2y)
this.points.push(x)
this.points.push(y)
end
@en "Close"
@fa "بستن مسیر"
pub func Close():
if this.verbs.len() > 0:
this.verbs.push(4)
end
end
@en "Arc"
@fa "کمان"
pub func Arc(cx: f64, cy: f64, rx: f64, ry: f64, start: f64, sweep: f64):
_path_arc(this, cx, cy, rx, ry, start, sweep)
end
@en "AddRect"
@fa "افزودن مستطیل"
pub func AddRect(r: Rect):
this.MoveTo(r.x, r.y)
this.LineTo(r.x + r.width, r.y)
this.LineTo(r.x + r.width, r.y + r.height)
this.LineTo(r.x, r.y + r.height)
this.Close()
end
@en "AddRoundedRect"
@fa "افزودن مستطیل گرد"
pub func AddRoundedRect(r: Rect, radii: Radii):
_path_rounded_rect(this, r, FitRadii(r, radii))
end
@en "AddEllipse"
@fa "افزودن بیضی"
pub func AddEllipse(cx: f64, cy: f64, rx: f64, ry: f64):
this.MoveTo(cx + rx, cy)
this.Arc(cx, cy, rx, ry, 0.0, 360.0)
this.Close()
end
@en "Clear"
@fa "پاک کردن"
pub func Clear():
this.verbs.clear()
this.points.clear()
end
@en "Free"
@fa "رهاسازی"
pub func Free():
this.verbs.free()
this.points.free()
end
end
@en "Region"
@fa "ناحیه"
pub struct Region:
n: int = 0
ax: int = 0
ay: int = 0
aw: int = 0
ah: int = 0
bx: int = 0
by: int = 0
bw: int = 0
bh: int = 0
qx: int = 0
qy: int = 0
qw: int = 0
qh: int = 0
func _get(i: int): IntRect:
if i == 0:
ret IntRect { x = this.ax, y = this.ay, width = this.aw, height = this.ah }
else i == 1:
ret IntRect { x = this.bx, y = this.by, width = this.bw, height = this.bh }
end
ret IntRect { x = this.qx, y = this.qy, width = this.qw, height = this.qh }
end
func _put(i: int, r: IntRect):
if i == 0:
this.ax = r.x
this.ay = r.y
this.aw = r.width
this.ah = r.height
else i == 1:
this.bx = r.x
this.by = r.y
this.bw = r.width
this.bh = r.height
else:
this.qx = r.x
this.qy = r.y
this.qw = r.width
this.qh = r.height
end
end
@en "Count"
@fa "شمار"
pub func Count(): int:
ret this.n
end
@en "At"
@fa "مستطیل شماره"
pub func At(i: int): IntRect:
if i < 0 or i >= this.n:
ret IntRect {}
end
ret this._get(i)
end
@en "IsEmpty"
@fa "خالی است"
pub func IsEmpty(): bool:
ret this.n == 0
end
@en "Clear"
@fa "پاک کردن"
pub func Clear():
this.n = 0
end
@en "Bounds"
@fa "کرانه"
pub func Bounds(): IntRect:
if this.n == 0:
ret IntRect {}
end
mut u := this._get(0)
repeat this.n - 1 in i:
u = _irect_union(u, this._get(i + 1))
end
ret u
end
@en "Add"
@fa "افزودن"
pub func Add(r: IntRect):
if r.width <= 0 or r.height <= 0:
ret
end
mut i := 0
until i < this.n:
cur := this._get(i)
if _irect_contains(cur, r):
ret
end
if _irect_contains(r, cur):
this._put(i, this._get(this.n - 1))
this.n--
continue
end
i++
end
if this.n < 3:
this._put(this.n, r)
this.n++
ret
end
mut best := 0
mut best_grow := 0 as i64
repeat 3 in k:
cur := this._get(k)
grow := _irect_area(_irect_union(cur, r)) - _irect_area(cur)
if k == 0 or grow < best_grow:
best = k
best_grow = grow
end
end
this._put(best, _irect_union(this._get(best), r))
end
@en "Union"
@fa "اجتماع"
pub func Union(o: Region):
repeat o.Count() in i:
this.Add(o.At(i))
end
end
end
