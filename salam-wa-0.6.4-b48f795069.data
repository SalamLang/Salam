@en "FieldKindName"
@fa "نام نوع فیلد"
pub func FieldKindName(k: int): str:
if k == FK_DOUBLE: ret "double" end
if k == FK_FLOAT: ret "float" end
if k == FK_INT32: ret "int32" end
if k == FK_INT64: ret "int64" end
if k == FK_UINT32: ret "uint32" end
if k == FK_UINT64: ret "uint64" end
if k == FK_SINT32: ret "sint32" end
if k == FK_SINT64: ret "sint64" end
if k == FK_FIXED32: ret "fixed32" end
if k == FK_FIXED64: ret "fixed64" end
if k == FK_SFIXED32: ret "sfixed32" end
if k == FK_SFIXED64: ret "sfixed64" end
if k == FK_BOOL: ret "bool" end
if k == FK_STRING: ret "string" end
if k == FK_BYTES: ret "bytes" end
if k == FK_MESSAGE: ret "message" end
if k == FK_ENUM: ret "enum" end
if k == FK_MAP: ret "map" end
ret "?"
end
@en "ScalarKindFromName"
@fa "نوع ساده از نام"
pub func ScalarKindFromName(name: str): int:
if name == "double": ret FK_DOUBLE end
if name == "float": ret FK_FLOAT end
if name == "int32": ret FK_INT32 end
if name == "int64": ret FK_INT64 end
if name == "uint32": ret FK_UINT32 end
if name == "uint64": ret FK_UINT64 end
if name == "sint32": ret FK_SINT32 end
if name == "sint64": ret FK_SINT64 end
if name == "fixed32": ret FK_FIXED32 end
if name == "fixed64": ret FK_FIXED64 end
if name == "sfixed32": ret FK_SFIXED32 end
if name == "sfixed64": ret FK_SFIXED64 end
if name == "bool": ret FK_BOOL end
if name == "string": ret FK_STRING end
if name == "bytes": ret FK_BYTES end
ret 0
end
package protobuf
import str
import conv
func _scalar_salam_type(kind: int): str:
if kind == FK_STRING: ret "str" end
if kind == FK_BYTES: ret "str" end
if kind == FK_BOOL: ret "bool" end
if kind == FK_DOUBLE: ret "f64" end
if kind == FK_FLOAT: ret "f64" end
ret "i64"
end
func _is_scalar_or_string(kind: int): bool:
ret kind != FK_MESSAGE and kind != FK_MAP and kind != 0
end
func _has_scalar(msg: PMessage): bool:
mut fi := 0
until fi < msg.fields.len():
if _is_scalar_or_string(msg.fields.get(fi).kind): ret true end
fi++
end
ret false
end
func _salam_field_type(f: PField): str:
base := _scalar_salam_type(f.kind)
if f.repeated: ret "Vector<".concat(base).concat(">") end
ret base
end
func _salam_field_default(f: PField): str:
if f.repeated: ret "Vector {}" end
if f.kind == FK_STRING or f.kind == FK_BYTES: ret "\"\"" end
if f.kind == FK_BOOL: ret "false" end
if f.kind == FK_DOUBLE or f.kind == FK_FLOAT: ret "0.0" end
ret "0 as i64"
end
func _wire_type_const(kind: int): str:
if kind == FK_STRING or kind == FK_BYTES: ret "protobuf.WT_LEN" end
if kind == FK_DOUBLE: ret "protobuf.WT_FIXED64" end
if kind == FK_FLOAT: ret "protobuf.WT_FIXED32" end
if kind == FK_FIXED32 or kind == FK_SFIXED32: ret "protobuf.WT_FIXED32" end
if kind == FK_FIXED64 or kind == FK_SFIXED64: ret "protobuf.WT_FIXED64" end
ret "protobuf.WT_VARINT"
end
func _write_stmt(kind: int, expr: str): str:
if kind == FK_STRING or kind == FK_BYTES:
ret "protobuf.WriteLenPrefixedStr(buf, ".concat(expr).concat(")")
end
if kind == FK_DOUBLE: ret "protobuf.WriteDouble(buf, ".concat(expr).concat(")") end
if kind == FK_FLOAT: ret "protobuf.WriteFloat(buf, ".concat(expr).concat(")") end
if kind == FK_BOOL:
ret "protobuf.WriteVarint(buf, (".concat(expr).concat(" ? 1 : 0) as u64)")
end
if kind == FK_SINT32:
ret "protobuf.WriteVarint(buf, protobuf.ZigZagEncode32(".concat(expr).concat(" as i32) as u64)")
end
if kind == FK_SINT64:
ret "protobuf.WriteVarint(buf, protobuf.ZigZagEncode64(".concat(expr).concat(") as u64)")
end
if kind == FK_FIXED32 or kind == FK_SFIXED32:
ret "protobuf.WriteFixed32(buf, ".concat(expr).concat(" as u32)")
end
if kind == FK_FIXED64 or kind == FK_SFIXED64:
ret "protobuf.WriteFixed64(buf, ".concat(expr).concat(" as u64)")
end
ret "protobuf.WriteVarint(buf, ".concat(expr).concat(" as u64)")
end
func _read_expr(kind: int): str:
if kind == FK_STRING or kind == FK_BYTES: ret "protobuf.ReadLenPrefixedStr(r)" end
if kind == FK_DOUBLE: ret "protobuf.ReadDouble(r)" end
if kind == FK_FLOAT: ret "protobuf.ReadFloat(r)" end
if kind == FK_BOOL: ret "protobuf.ReadVarint(r) != (0 as u64)" end
if kind == FK_SINT32: ret "protobuf.ZigZagDecode32(protobuf.ReadVarint(r) as u32) as i64" end
if kind == FK_SINT64: ret "protobuf.ZigZagDecode64(protobuf.ReadVarint(r))" end
if kind == FK_FIXED32 or kind == FK_SFIXED32: ret "protobuf.ReadFixed32(r) as i64" end
if kind == FK_FIXED64 or kind == FK_SFIXED64: ret "protobuf.ReadFixed64(r) as i64" end
ret "protobuf.ReadVarint(r) as i64"
end
func _nonzero_check(f: PField): str:
if f.kind == FK_STRING or f.kind == FK_BYTES: ret "m.".concat(f.name).concat(".len() > 0") end
if f.kind == FK_BOOL: ret "m.".concat(f.name) end
if f.kind == FK_DOUBLE or f.kind == FK_FLOAT: ret "m.".concat(f.name).concat(" != 0.0") end
ret "m.".concat(f.name).concat(" != (0 as i64)")
end
func _emit_struct(sb &: str.StringBuilder, msg: PMessage):
str.BufAppend(sb, "pub struct ")
str.BufAppend(sb, msg.name)
str.BufAppend(sb, ":\n")
mut fi := 0
until fi < msg.fields.len():
f := msg.fields.get(fi)
if _is_scalar_or_string(f.kind):
str.BufAppend(sb, "    pub ")
str.BufAppend(sb, f.name)
str.BufAppend(sb, ": ")
str.BufAppend(sb, _salam_field_type(f))
str.BufAppend(sb, " = ")
str.BufAppend(sb, _salam_field_default(f))
str.BufAppendChar(sb, 10)
end
fi++
end
if not _has_scalar(msg):
str.BufAppend(sb, "    pub _empty: bool = false\n")
end
str.BufAppend(sb, "end\n\n")
end
func _emit_marshal(sb &: str.StringBuilder, msg: PMessage):
if not _has_scalar(msg):
str.BufAppend(sb, "pub func Marshal")
str.BufAppend(sb, msg.name)
str.BufAppend(sb, "(_m: ")
str.BufAppend(sb, msg.name)
str.BufAppend(sb, "): compress.ByteBuf:\n")
str.BufAppend(sb, "    ret compress.NewByteBuf()\n")
str.BufAppend(sb, "end\n\n")
ret
end
str.BufAppend(sb, "pub func Marshal")
str.BufAppend(sb, msg.name)
str.BufAppend(sb, "(m: ")
str.BufAppend(sb, msg.name)
str.BufAppend(sb, "): compress.ByteBuf:\n")
str.BufAppend(sb, "    mut buf := compress.NewByteBuf()\n")
mut fi := 0
until fi < msg.fields.len():
f := msg.fields.get(fi)
if _is_scalar_or_string(f.kind):
numStr := conv.FormatInt(f.number as i64)
if f.repeated:
str.BufAppend(sb, "    mut ri")
str.BufAppend(sb, numStr)
str.BufAppend(sb, " := 0\n")
str.BufAppend(sb, "    until ri")
str.BufAppend(sb, numStr)
str.BufAppend(sb, " < m.")
str.BufAppend(sb, f.name)
str.BufAppend(sb, ".len():\n")
str.BufAppend(sb, "        protobuf.WriteTag(buf, ")
str.BufAppend(sb, numStr)
str.BufAppend(sb, ", ")
str.BufAppend(sb, _wire_type_const(f.kind))
str.BufAppend(sb, ")\n        ")
elemExpr := "m.".concat(f.name).concat(".get(ri").concat(numStr).concat(")")
str.BufAppend(sb, _write_stmt(f.kind, elemExpr))
str.BufAppendChar(sb, 10)
str.BufAppend(sb, "        ri")
str.BufAppend(sb, numStr)
str.BufAppend(sb, " += 1\n    end\n")
else:
str.BufAppend(sb, "    if ")
str.BufAppend(sb, _nonzero_check(f))
str.BufAppend(sb, ":\n        protobuf.WriteTag(buf, ")
str.BufAppend(sb, numStr)
str.BufAppend(sb, ", ")
str.BufAppend(sb, _wire_type_const(f.kind))
str.BufAppend(sb, ")\n        ")
str.BufAppend(sb, _write_stmt(f.kind, "m.".concat(f.name)))
str.BufAppendChar(sb, 10)
str.BufAppend(sb, "    end\n")
end
end
fi++
end
str.BufAppend(sb, "    ret buf\n")
str.BufAppend(sb, "end\n\n")
end
func _emit_unmarshal(sb &: str.StringBuilder, msg: PMessage):
str.BufAppend(sb, "pub func Unmarshal")
str.BufAppend(sb, msg.name)
str.BufAppend(sb, "(data: void*, n: int): ")
str.BufAppend(sb, msg.name)
str.BufAppend(sb, " throws:\n")
scalar := _has_scalar(msg)
if scalar:
str.BufAppend(sb, "    mut out := ")
str.BufAppend(sb, msg.name)
str.BufAppend(sb, " {}\n")
end
str.BufAppend(sb, "    mut r := compress.NewByteReader(data, n)\n")
str.BufAppend(sb, "    try:\n")
str.BufAppend(sb, "        until compress.RdLeft(r) > 0:\n")
if scalar: str.BufAppend(sb, "            at := r.pos\n") end
str.BufAppend(sb, "            mut fnum := 0\n")
str.BufAppend(sb, "            mut wtype := 0\n")
str.BufAppend(sb, "            protobuf.ReadTag(r, fnum, wtype)\n")
mut fi := 0
mut any := false
until fi < msg.fields.len():
f := msg.fields.get(fi)
if _is_scalar_or_string(f.kind):
numStr := conv.FormatInt(f.number as i64)
wire := _wire_type_const(f.kind)
mut kw := "if"
if any: kw = "else" end
any = true
str.BufAppend(sb, "            ")
str.BufAppend(sb, kw)
str.BufAppend(sb, " fnum == ")
str.BufAppend(sb, numStr)
str.BufAppend(sb, ":\n")
str.BufAppend(sb, "                if wtype != ")
str.BufAppend(sb, wire)
str.BufAppend(sb, ":\n")
str.BufAppend(sb, "                    throw Error.At(ErrorKind.TypeMismatch, \"field ")
str.BufAppend(sb, numStr)
str.BufAppend(sb, " (")
str.BufAppend(sb, f.name)
str.BufAppend(sb, ") has wire type \" + wtype + \", expected \" + ")
str.BufAppend(sb, wire)
str.BufAppend(sb, ", at).with_code(\"protobuf.wire_type_mismatch\").wrap(\"protobuf\")\n")
str.BufAppend(sb, "                end\n")
str.BufAppend(sb, "                out.")
str.BufAppend(sb, f.name)
if f.repeated:
str.BufAppend(sb, ".push(")
str.BufAppend(sb, _read_expr(f.kind))
str.BufAppend(sb, ")\n")
else:
str.BufAppend(sb, " = ")
str.BufAppend(sb, _read_expr(f.kind))
str.BufAppendChar(sb, 10)
end
end
fi++
end
if any:
str.BufAppend(sb, "            else:\n")
str.BufAppend(sb, "                protobuf.SkipFieldFor(r, fnum, wtype)\n")
str.BufAppend(sb, "            end\n")
else:
str.BufAppend(sb, "            protobuf.SkipFieldFor(r, fnum, wtype)\n")
end
str.BufAppend(sb, "        end\n")
str.BufAppend(sb, "    catch e:\n")
str.BufAppend(sb, "        throw e.wrap(\"")
str.BufAppend(sb, msg.name)
str.BufAppend(sb, "\")\n")
str.BufAppend(sb, "    end\n")
if scalar:
str.BufAppend(sb, "    ret out\n")
else:
str.BufAppend(sb, "    ret ")
str.BufAppend(sb, msg.name)
str.BufAppend(sb, " {}\n")
end
str.BufAppend(sb, "end\n\n")
end
func _emit_enum(sb &: str.StringBuilder, en: PEnum):
mut vi := 0
until vi < en.values.len():
v := en.values.get(vi)
str.BufAppend(sb, "pub const ")
str.BufAppend(sb, en.name)
str.BufAppendChar(sb, 95)
str.BufAppend(sb, v.name)
str.BufAppend(sb, " := ")
str.BufAppend(sb, conv.FormatInt(v.number as i64))
str.BufAppendChar(sb, 10)
vi++
end
str.BufAppendChar(sb, 10)
end
func _generate(f: PFile, services: bool): str:
mut sb := str.NewBuilder()
str.BufAppend(sb, "// Generated by encoding.protobuf - DO NOT EDIT.\n\n")
str.BufAppend(sb, "package generated_pb\n\n")
str.BufAppend(sb, "import encoding.protobuf\n")
str.BufAppend(sb, "import compress\n")
withServices := services and f.services.len() > 0
if withServices: str.BufAppend(sb, "import grpc\n") end
str.BufAppendChar(sb, 10)
mut ei := 0
until ei < f.enums.len():
_emit_enum(sb, f.enums.get(ei))
ei++
end
if withServices: _emit_service_consts(sb, f) end
mut mi := 0
until mi < f.messages.len():
_emit_struct(sb, f.messages.get(mi))
mi++
end
mi = 0
until mi < f.messages.len():
_emit_marshal(sb, f.messages.get(mi))
_emit_unmarshal(sb, f.messages.get(mi))
mi++
end
if withServices: _emit_service_funcs(sb, f) end
out := str.BufStr(sb)
str.BufFree(sb)
ret out
end
@en "GenerateSingle"
@fa "تولید کد"
pub func GenerateSingle(protoSource: str): str throws:
f := try ParseFile(protoSource)
ret _generate(f, false)
end
package protobuf
import str
import conv
func _svc_prefix(f: PFile, svc: PService): str:
if f.packageName == "": ret svc.name end
ret f.packageName + "." + svc.name
end
func _path_const(svc: PService, m: PMethod): str:
ret svc.name + m.name + "Path"
end
func _emit_path_const(sb &: str.StringBuilder, f: PFile, svc: PService, m: PMethod):
str.BufAppend(sb, "pub const ")
str.BufAppend(sb, _path_const(svc, m))
str.BufAppend(sb, " := \"/")
str.BufAppend(sb, _svc_prefix(f, svc))
str.BufAppend(sb, "/")
str.BufAppend(sb, m.name)
str.BufAppend(sb, "\"\n")
end
func _emit_decode_raw(sb &: str.StringBuilder, m: PMethod):
str.BufAppend(sb, "    try:\n")
str.BufAppend(sb, "        out := Unmarshal")
str.BufAppend(sb, m.outputType)
str.BufAppend(sb, "(raw.data, compress.BufLen(raw))\n")
str.BufAppend(sb, "        compress.BufFree(raw)\n")
str.BufAppend(sb, "        ret out\n")
str.BufAppend(sb, "    catch e:\n")
str.BufAppend(sb, "        compress.BufFree(raw)\n")
str.BufAppend(sb, "        throw e\n")
str.BufAppend(sb, "    end\n")
end
func _emit_unary(sb &: str.StringBuilder, svc: PService, m: PMethod):
str.BufAppend(sb, "pub func ")
str.BufAppend(sb, svc.name)
str.BufAppend(sb, m.name)
str.BufAppend(sb, "(ch &: grpc.Channel, req: ")
str.BufAppend(sb, m.inputType)
str.BufAppend(sb, ", md: grpc.Metadata, st &: grpc.Status): ")
str.BufAppend(sb, m.outputType)
str.BufAppend(sb, " throws:\n")
str.BufAppend(sb, "    mut body := Marshal")
str.BufAppend(sb, m.inputType)
str.BufAppend(sb, "(req)\n")
str.BufAppend(sb, "    mut raw := grpc.UnaryCall(ch, ")
str.BufAppend(sb, _path_const(svc, m))
str.BufAppend(sb, ", body, md, st)\n")
str.BufAppend(sb, "    compress.BufFree(body)\n")
_emit_decode_raw(sb, m)
str.BufAppend(sb, "end\n\n")
end
func _emit_stream(sb &: str.StringBuilder, svc: PService, m: PMethod):
base := svc.name + m.name
str.BufAppend(sb, "pub func ")
str.BufAppend(sb, base)
str.BufAppend(sb, "Start(ch &: grpc.Channel, md: grpc.Metadata): int:\n")
str.BufAppend(sb, "    ret grpc.StartCall(ch, ")
str.BufAppend(sb, _path_const(svc, m))
str.BufAppend(sb, ", md)\n")
str.BufAppend(sb, "end\n\n")
str.BufAppend(sb, "pub func ")
str.BufAppend(sb, base)
str.BufAppend(sb, "Send(ch &: grpc.Channel, sid: int, req: ")
str.BufAppend(sb, m.inputType)
str.BufAppend(sb, ", last: bool): bool:\n")
str.BufAppend(sb, "    mut body := Marshal")
str.BufAppend(sb, m.inputType)
str.BufAppend(sb, "(req)\n")
str.BufAppend(sb, "    sent := grpc.SendMessage(ch, sid, body, last)\n")
str.BufAppend(sb, "    compress.BufFree(body)\n")
str.BufAppend(sb, "    ret sent\n")
str.BufAppend(sb, "end\n\n")
str.BufAppend(sb, "pub func ")
str.BufAppend(sb, base)
str.BufAppend(sb, "Recv(ch &: grpc.Channel, sid: int, got &: bool): ")
str.BufAppend(sb, m.outputType)
str.BufAppend(sb, " throws:\n")
str.BufAppend(sb, "    mut raw := grpc.RecvMessage(ch, sid, got)\n")
str.BufAppend(sb, "    if not got:\n")
str.BufAppend(sb, "        compress.BufFree(raw)\n")
str.BufAppend(sb, "        ret ")
str.BufAppend(sb, m.outputType)
str.BufAppend(sb, " {}\n")
str.BufAppend(sb, "    end\n")
_emit_decode_raw(sb, m)
str.BufAppend(sb, "end\n\n")
str.BufAppend(sb, "pub func ")
str.BufAppend(sb, base)
str.BufAppend(sb, "Finish(ch &: grpc.Channel, sid: int): grpc.Status:\n")
str.BufAppend(sb, "    ret grpc.FinishCall(ch, sid)\n")
str.BufAppend(sb, "end\n\n")
end
func _emit_register(sb &: str.StringBuilder, svc: PService, m: PMethod):
str.BufAppend(sb, "pub func Register")
str.BufAppend(sb, svc.name)
str.BufAppend(sb, m.name)
str.BufAppend(sb, "(fn: i64):\n")
if m.clientStream or m.serverStream:
str.BufAppend(sb, "    grpc.RegisterStreamMethod(")
str.BufAppend(sb, _path_const(svc, m))
str.BufAppend(sb, ", fn, ")
if m.clientStream: str.BufAppend(sb, "true, ") else:
str.BufAppend(sb, "false, ")
end
if m.serverStream: str.BufAppend(sb, "true)\n") else:
str.BufAppend(sb, "false)\n")
end
else:
str.BufAppend(sb, "    grpc.RegisterMethod(")
str.BufAppend(sb, _path_const(svc, m))
str.BufAppend(sb, ", fn)\n")
end
str.BufAppend(sb, "end\n\n")
end
func _emit_service_consts(sb &: str.StringBuilder, f: PFile):
mut si := 0
until si < f.services.len():
svc := f.services.get(si)
mut i := 0
until i < svc.methods.len():
_emit_path_const(sb, f, svc, svc.methods.get(i))
i++
end
si++
end
str.BufAppendChar(sb, 10)
end
func _emit_service_funcs(sb &: str.StringBuilder, f: PFile):
mut si := 0
until si < f.services.len():
svc := f.services.get(si)
mut i := 0
until i < svc.methods.len():
m := svc.methods.get(i)
if m.clientStream or m.serverStream:
_emit_stream(sb, svc, m)
else:
_emit_unary(sb, svc, m)
end
_emit_register(sb, svc, m)
i++
end
si++
end
end
@en "ServiceCount"
@fa "تعداد سرویس‌ها"
pub func ServiceCount(f: PFile): int:
ret f.services.len()
end
@en "ServiceNameAt"
@fa "نام سرویس"
pub func ServiceNameAt(f: PFile, i: int): str:
if i < 0 or i >= f.services.len(): ret "" end
ret f.services.get(i).name
end
@en "ServiceMethodCount"
@fa "تعداد متدهای سرویس"
pub func ServiceMethodCount(f: PFile, i: int): int:
if i < 0 or i >= f.services.len(): ret 0 end
ret f.services.get(i).methods.len()
end
@en "ServiceMethodSignature"
@fa "امضای متد"
pub func ServiceMethodSignature(f: PFile, si: int, mi: int): str:
if si < 0 or si >= f.services.len(): ret "" end
svc := f.services.get(si)
if mi < 0 or mi >= svc.methods.len(): ret "" end
m := svc.methods.get(mi)
mut out := m.name + "("
if m.clientStream: out += "stream " end
out = out + m.inputType + ") returns ("
if m.serverStream: out += "stream " end
ret out + m.outputType + ")"
end
@en "GenerateServices"
@fa "تولید سرویس‌ها"
pub func GenerateServices(f: PFile): str:
if f.services.len() == 0: ret "" end
mut sb := str.NewBuilder()
_emit_service_consts(sb, f)
_emit_service_funcs(sb, f)
out := str.BufStr(sb)
str.BufFree(sb)
ret out
end
@en "GenerateWithServices"
@fa "تولید با سرویس‌ها"
pub func GenerateWithServices(protoSource: str): str throws:
f := try ParseFile(protoSource)
ret _generate(f, true)
end
@en "ServiceSummary"
@fa "خلاصه سرویس"
pub func ServiceSummary(protoSource: str): str throws:
f := try ParseFile(protoSource)
mut out := ""
mut si := 0
until si < f.services.len():
svc := f.services.get(si)
out = out + "service " + svc.name + " (" + conv.FormatInt(svc.methods.len() as i64) + " methods)\n"
mut mi := 0
until mi < svc.methods.len():
out = out + "  rpc " + ServiceMethodSignature(f, si, mi) + "\n"
mi++
end
si++
end
ret out
end
package protobuf
import str
struct Lx:
pub s: str = ""
pub n: int = 0
pub pos: int = 0
pub line: int = 1
pub err: str = ""
pub errPos: int = 0
pub errEnd: bool = false
pub errCode: str = ""
end
@en "PTokenStream"
@fa "جریان نشانه پروتو"
pub struct PTokenStream:
@en "toks"
@fa "نشانه‌ها"
pub toks: Vector<PToken> = Vector {}
end
inline pure func _bp(s: str): i8*: ret (s as void*) as i8* end
inline pure func _ub(bp: i8*, i: int): int:
mut v := bp[i] as int
if v < 0: v += 256 end
ret v
end
func _is_digit(c: int): bool: ret c >= 48 and c <= 57 end
func _is_ident_start(c: int): bool:
ret (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95
end
func _is_ident_cont(c: int): bool:
ret _is_ident_start(c) or _is_digit(c)
end
func _is_hex_digit(c: int): bool:
ret _is_digit(c) or (c >= 97 and c <= 102) or (c >= 65 and c <= 70)
end
func _lx_peek(lx: Lx): int:
if lx.pos >= lx.n: ret -1 end
ret _ub(_bp(lx.s), lx.pos)
end
func _lx_peek2(lx: Lx): int:
if lx.pos + 1 >= lx.n: ret -1 end
ret _ub(_bp(lx.s), lx.pos + 1)
end
func _lx_fail(lx &: Lx, msg: str, pos: int, atEnd: bool, code: str):
if lx.err != "": ret end
lx.err = msg
lx.errPos = pos
lx.errEnd = atEnd
lx.errCode = code
end
func _lx_skip_trivia(lx &: Lx):
until true:
c := _lx_peek(lx)
if c == 32 or c == 9 or c == 13:
lx.pos++
else c == 10:
lx.pos++
lx.line++
else c == 47 and _lx_peek2(lx) == 47:
until _lx_peek(lx) != 10 and _lx_peek(lx) != -1:
lx.pos++
end
else c == 47 and _lx_peek2(lx) == 42:
start := lx.pos
lx.pos += 2
until true:
d := _lx_peek(lx)
if d == -1:
_lx_fail(lx, "unterminated comment", start, true, "protobuf.unterminated_comment")
ret
end
if d == 42 and _lx_peek2(lx) == 47:
lx.pos += 2
break
end
if d == 10: lx.line++ end
lx.pos++
end
else:
ret
end
end
end
func _lx_string(lx &: Lx): PToken:
quote := _lx_peek(lx)
startLine := lx.line
start := lx.pos
lx.pos++
mut sb := str.NewBuilder()
until true:
c := _lx_peek(lx)
if c == -1 or c == 10:
str.BufFree(sb)
_lx_fail(lx, "unterminated string", start, c == -1, "protobuf.unterminated_string")
ret PToken { kind = PTK_ERROR, line = startLine, offset = start }
end
if c == quote:
lx.pos++
out := str.BufStr(sb)
str.BufFree(sb)
mut tok := PToken { kind = PTK_STRING }
tok.sval = out
tok.line = startLine
tok.offset = start
ret tok
end
if c == 92:
lx.pos++
e := _lx_peek(lx)
if e == 110: str.BufAppendChar(sb, 10)
else e == 116: str.BufAppendChar(sb, 9)
else e == 114: str.BufAppendChar(sb, 13)
else e == 92: str.BufAppendChar(sb, 92)
else e == 34: str.BufAppendChar(sb, 34)
else e == 39: str.BufAppendChar(sb, 39)
else:
str.BufAppendChar(sb, e)
end
lx.pos++
else:
str.BufAppendChar(sb, c)
lx.pos++
end
end
end
func _lx_number(lx &: Lx): PToken:
startLine := lx.line
start := lx.pos
mut isFloat := false
if _lx_peek(lx) == 48 and (_lx_peek2(lx) == 120 or _lx_peek2(lx) == 88):
lx.pos += 2
until _is_hex_digit(_lx_peek(lx)):
lx.pos++
end
text := lx.s.substr(start, lx.pos - start)
mut tok := PToken { kind = PTK_INT }
tok.lexeme = text
tok.ival = _hex_to_i64(text.substr(2, text.len() - 2))
tok.line = startLine
tok.offset = start
ret tok
end
until _is_digit(_lx_peek(lx)):
lx.pos++
end
if _lx_peek(lx) == 46 and _is_digit(_lx_peek2(lx)):
isFloat = true
lx.pos++
until _is_digit(_lx_peek(lx)):
lx.pos++
end
end
if _lx_peek(lx) == 101 or _lx_peek(lx) == 69:
isFloat = true
lx.pos++
if _lx_peek(lx) == 43 or _lx_peek(lx) == 45: lx.pos++ end
until _is_digit(_lx_peek(lx)):
lx.pos++
end
end
text := lx.s.substr(start, lx.pos - start)
if isFloat:
mut tok := PToken { kind = PTK_FLOAT }
tok.lexeme = text
tok.fval = text.to_float()
tok.line = startLine
tok.offset = start
ret tok
end
mut tok := PToken { kind = PTK_INT }
tok.lexeme = text
tok.ival = text.to_int() as i64
tok.line = startLine
tok.offset = start
ret tok
end
func _hex_digit_val(c: int): i64:
if c >= 48 and c <= 57: ret (c - 48) end
if c >= 97 and c <= 102: ret (c - 97 + 10) end
if c >= 65 and c <= 70: ret (c - 65 + 10) end
ret 0
end
func _hex_to_i64(s: str): i64:
n := s.len()
bp := _bp(s)
mut out := 0 as i64
mut i := 0
until i < n:
out = out * (16 as i64) + _hex_digit_val(_ub(bp, i))
i++
end
ret out
end
func _lx_ident(lx &: Lx): PToken:
startLine := lx.line
start := lx.pos
until _is_ident_cont(_lx_peek(lx)):
lx.pos++
end
mut tok := PToken { kind = PTK_IDENT }
tok.lexeme = lx.s.substr(start, lx.pos - start)
tok.line = startLine
tok.offset = start
ret tok
end
func _lx_punct_kind(c: int): int:
if c == 59: ret PTK_SEMI end
if c == 123: ret PTK_LBRACE end
if c == 125: ret PTK_RBRACE end
if c == 40: ret PTK_LPAREN end
if c == 41: ret PTK_RPAREN end
if c == 91: ret PTK_LBRACKET end
if c == 93: ret PTK_RBRACKET end
if c == 60: ret PTK_LANGLE end
if c == 62: ret PTK_RANGLE end
if c == 61: ret PTK_EQ end
if c == 44: ret PTK_COMMA end
if c == 46: ret PTK_DOT end
if c == 45: ret PTK_MINUS end
ret PTK_ERROR
end
func _lx_next(lx &: Lx): PToken:
_lx_skip_trivia(lx)
line := lx.line
start := lx.pos
if lx.err != "": ret PToken { kind = PTK_ERROR, line = line, offset = lx.errPos } end
c := _lx_peek(lx)
if c == -1: ret PToken { kind = PTK_EOF, line = line, offset = start } end
if _is_ident_start(c): ret _lx_ident(lx) end
if _is_digit(c): ret _lx_number(lx) end
if c == 34 or c == 39: ret _lx_string(lx) end
kind := _lx_punct_kind(c)
mut n := 1
if c >= 128:
until n < 4 and start + n < lx.n and (_ub(_bp(lx.s), start + n) & 192) == 128:
n++
end
end
lx.pos += n
mut tok := PToken { kind = kind, line = line, offset = start }
tok.lexeme = lx.s.substr(start, n)
if kind == PTK_ERROR:
_lx_fail(lx, "unexpected character '" + tok.lexeme + "'", start, false, "protobuf.unexpected_char")
end
ret tok
end
@en "Tokenize"
@fa "نشانه گذاری"
pub func Tokenize(source: str): PTokenStream throws:
mut lx := Lx { s = source }
lx.n = source.len()
mut out := PTokenStream {}
until true:
tok := _lx_next(lx)
if lx.err != "":
kind := lx.errEnd ? ErrorKind.UnexpectedEnd : ErrorKind.Syntax
throw Error.At(kind, lx.err, lx.errPos).with_code(lx.errCode).locate(source).wrap("protobuf")
end
out.toks.push(tok)
if tok.kind == PTK_EOF: ret out end
end
end
package protobuf
struct Pp:
pub toks: PTokenStream = PTokenStream {}
pub count: int = 0
pub pos: int = 0
pub hadError: bool = false
pub errMsg: str = ""
pub errOffset: int = 0
pub errAtEnd: bool = false
end
func pp_peek(p: Pp): PToken: ret p.toks.toks.get(p.pos) end
func pp_check(p: Pp, kind: int): bool: ret pp_peek(p).kind == kind end
func pp_check_ident(p: Pp, lexeme: str): bool:
t := pp_peek(p)
ret t.kind == PTK_IDENT and t.lexeme == lexeme
end
func pp_advance(p &: Pp): PToken:
t := pp_peek(p)
if p.pos < p.count - 1: p.pos++ end
ret t
end
func pp_match(p &: Pp, kind: int): bool:
if pp_check(p, kind):
pp_advance(p)
ret true
end
ret false
end
func pp_match_ident(p &: Pp, lexeme: str): bool:
if pp_check_ident(p, lexeme):
pp_advance(p)
ret true
end
ret false
end
func pp_describe(t: PToken): str:
if t.kind == PTK_EOF: ret "end of input" end
if t.kind == PTK_STRING: ret "a string" end
ret "'" + t.lexeme + "'"
end
func pp_error(p &: Pp, what: str):
if p.hadError: ret end
t := pp_peek(p)
p.hadError = true
p.errMsg = "expected " + what + ", found " + pp_describe(t)
p.errOffset = t.offset
p.errAtEnd = t.kind == PTK_EOF
end
func pp_expect(p &: Pp, kind: int, what: str): bool:
if pp_check(p, kind):
pp_advance(p)
ret true
end
pp_error(p, what)
ret false
end
func pp_expect_ident(p &: Pp, what: str): PToken:
if not pp_check(p, PTK_IDENT): pp_error(p, what) end
ret pp_advance(p)
end
func pp_expect_int(p &: Pp, what: str): PToken:
if not pp_check(p, PTK_INT): pp_error(p, what) end
ret pp_advance(p)
end
func pp_sync(p &: Pp):
until not (pp_check(p, PTK_SEMI) or pp_check(p, PTK_RBRACE) or pp_check(p, PTK_EOF)):
pp_advance(p)
end
if pp_check(p, PTK_SEMI): pp_advance(p) end
end
func pp_skip_balanced(p &: Pp):
pp_expect(p, PTK_LBRACE, "'{'")
mut depth := 1
until depth > 0 and not pp_check(p, PTK_EOF):
if pp_check(p, PTK_LBRACE): depth++ end
if pp_check(p, PTK_RBRACE): depth-- end
pp_advance(p)
end
end
func parse_type_name(p &: Pp): str:
mut sb := ""
if pp_check(p, PTK_DOT):
pp_advance(p)
sb = "."
end
t := pp_expect_ident(p, "a type name")
sb = sb.concat(t.lexeme)
until pp_check(p, PTK_DOT) and not p.hadError:
pp_advance(p)
t2 := pp_expect_ident(p, "a name after '.'")
sb = sb.concat(".").concat(t2.lexeme)
end
ret sb
end
func parse_field_options(p &: Pp, f &: PField):
if not pp_match(p, PTK_LBRACKET): ret end
until not p.hadError:
nameTok := pp_expect_ident(p, "an option name")
pp_expect(p, PTK_EQ, "'='")
valTok := pp_advance(p)
if nameTok.lexeme == "packed":
f.packedOpt = valTok.kind == PTK_IDENT and valTok.lexeme == "true"
end
if nameTok.lexeme == "deprecated":
f.is_deprecated = valTok.kind == PTK_IDENT and valTok.lexeme == "true"
end
if not pp_match(p, PTK_COMMA): break end
end
pp_expect(p, PTK_RBRACKET, "']'")
end
func parse_field_with_type(p &: Pp, msg &: PMessage, typeName: str, repeated: bool): bool:
mut f := PField {}
f.repeated = repeated
scalarKind := ScalarKindFromName(typeName)
if scalarKind != 0:
f.kind = scalarKind
else:
f.kind = FK_MESSAGE
f.typeName = typeName
end
nameTok := pp_expect_ident(p, "a field name")
f.name = nameTok.lexeme
if not pp_expect(p, PTK_EQ, "'='"):
pp_sync(p)
ret false
end
numTok := pp_expect_int(p, "a field number")
f.number = numTok.ival as int
parse_field_options(p, f)
if not pp_expect(p, PTK_SEMI, "';'"):
pp_sync(p)
ret false
end
msg.fields.push(f)
ret true
end
func parse_map_field(p &: Pp, msg &: PMessage): bool:
pp_advance(p)
pp_expect(p, PTK_LANGLE, "'<'")
keyTypeName := parse_type_name(p)
pp_expect(p, PTK_COMMA, "','")
valTypeName := parse_type_name(p)
pp_expect(p, PTK_RANGLE, "'>'")
nameTok := pp_expect_ident(p, "a field name")
if not pp_expect(p, PTK_EQ, "'='"):
pp_sync(p)
ret false
end
numTok := pp_expect_int(p, "a field number")
mut f := PField {}
f.name = nameTok.lexeme
f.kind = FK_MAP
f.keyKind = ScalarKindFromName(keyTypeName)
valScalar := ScalarKindFromName(valTypeName)
if valScalar != 0:
f.mapValueKind = valScalar
else:
f.mapValueKind = FK_MESSAGE
f.mapValueTypeName = valTypeName
end
f.number = numTok.ival as int
parse_field_options(p, f)
if not pp_expect(p, PTK_SEMI, "';'"):
pp_sync(p)
ret false
end
msg.fields.push(f)
ret true
end
func parse_oneof(p &: Pp, msg &: PMessage): bool:
pp_advance(p)
nameTok := pp_expect_ident(p, "a oneof name")
mut oneof := POneof { name = nameTok.lexeme }
if not pp_expect(p, PTK_LBRACE, "'{'"):
pp_sync(p)
ret false
end
until not p.hadError:
if pp_check(p, PTK_RBRACE) or pp_check(p, PTK_EOF): break end
if pp_match(p, PTK_SEMI): continue end
idx := msg.fields.len()
typeName := parse_type_name(p)
ok := parse_field_with_type(p, msg, typeName, false)
if ok:
mut lastField := msg.fields.get(idx)
lastField.oneofIndex = msg.oneofs.len()
msg.fields.set(idx, lastField)
oneof.fieldIndices.push(idx)
end
end
pp_expect(p, PTK_RBRACE, "'}'")
msg.oneofs.push(oneof)
ret true
end
func parse_reserved(p &: Pp):
pp_advance(p)
until not (pp_check(p, PTK_SEMI) or pp_check(p, PTK_EOF)):
pp_advance(p)
end
pp_match(p, PTK_SEMI)
end
func parse_option_stmt(p &: Pp):
pp_advance(p)
until not (pp_check(p, PTK_SEMI) or pp_check(p, PTK_EOF)):
pp_advance(p)
end
pp_match(p, PTK_SEMI)
end
func parse_enum(p &: Pp, out &: PEnum): bool:
pp_advance(p)
nameTok := pp_expect_ident(p, "an enum name")
out.name = nameTok.lexeme
if not pp_expect(p, PTK_LBRACE, "'{'"):
pp_sync(p)
ret false
end
until not p.hadError:
if pp_check(p, PTK_RBRACE) or pp_check(p, PTK_EOF): break end
if pp_match(p, PTK_SEMI): continue end
if pp_check_ident(p, "option"):
parse_option_stmt(p)
continue
end
if pp_check_ident(p, "reserved"):
parse_reserved(p)
continue
end
valNameTok := pp_expect_ident(p, "an enum value name")
if not pp_expect(p, PTK_EQ, "'='"):
pp_sync(p)
continue
end
mut sign := 1 as i64
if pp_match(p, PTK_MINUS): sign = 0 - 1 as i64 end
numTok := pp_expect_int(p, "an enum value number")
mut ev := PEnumValue { name = valNameTok.lexeme }
ev.number = (sign * numTok.ival) as int
if pp_check(p, PTK_LBRACKET):
mut dummy := PField {}
parse_field_options(p, dummy)
end
out.values.push(ev)
pp_expect(p, PTK_SEMI, "';'")
end
pp_expect(p, PTK_RBRACE, "'}'")
ret true
end
func parse_message(p &: Pp, out &: PMessage): bool:
pp_advance(p)
nameTok := pp_expect_ident(p, "a message name")
out.name = nameTok.lexeme
if not pp_expect(p, PTK_LBRACE, "'{'"):
pp_sync(p)
ret false
end
until not p.hadError:
if pp_check(p, PTK_RBRACE) or pp_check(p, PTK_EOF): break end
if pp_match(p, PTK_SEMI): continue end
if pp_check_ident(p, "message"):
mut nested := PMessage {}
parse_message(p, nested)
out.nestedMessages.push(nested)
continue
end
if pp_check_ident(p, "enum"):
mut nestedEnum := PEnum {}
parse_enum(p, nestedEnum)
out.nestedEnums.push(nestedEnum)
continue
end
if pp_check_ident(p, "oneof"):
parse_oneof(p, out)
continue
end
if pp_check_ident(p, "map"):
parse_map_field(p, out)
continue
end
if pp_check_ident(p, "reserved"):
parse_reserved(p)
continue
end
if pp_check_ident(p, "option"):
parse_option_stmt(p)
continue
end
mut repeated := false
if pp_match_ident(p, "repeated"):
repeated = true
else:
pp_match_ident(p, "optional")
end
typeName := parse_type_name(p)
parse_field_with_type(p, out, typeName, repeated)
end
pp_expect(p, PTK_RBRACE, "'}'")
ret true
end
func parse_rpc(p &: Pp, out &: PService):
pp_advance(p)
nameTok := pp_expect_ident(p, "a method name")
mut m := PMethod {}
m.name = nameTok.lexeme
pp_expect(p, PTK_LPAREN, "'('")
if pp_match_ident(p, "stream"): m.clientStream = true end
m.inputType = parse_type_name(p)
pp_expect(p, PTK_RPAREN, "')'")
if not pp_match_ident(p, "returns"):
pp_error(p, "'returns'")
pp_sync(p)
ret
end
pp_expect(p, PTK_LPAREN, "'('")
if pp_match_ident(p, "stream"): m.serverStream = true end
m.outputType = parse_type_name(p)
pp_expect(p, PTK_RPAREN, "')'")
if pp_check(p, PTK_LBRACE):
pp_skip_balanced(p)
else:
pp_expect(p, PTK_SEMI, "';'")
end
out.methods.push(m)
end
func parse_service(p &: Pp, out &: PFile):
pp_advance(p)
nameTok := pp_expect_ident(p, "a service name")
mut svc := PService {}
svc.name = nameTok.lexeme
pp_expect(p, PTK_LBRACE, "'{'")
until not pp_check(p, PTK_RBRACE) and not pp_check(p, PTK_EOF) and not p.hadError:
if pp_match(p, PTK_SEMI): continue end
if pp_check_ident(p, "option"):
parse_option_stmt(p)
continue
end
if pp_check_ident(p, "rpc"):
parse_rpc(p, svc)
continue
end
pp_error(p, "'rpc' or 'option' in the service body")
pp_sync(p)
end
pp_expect(p, PTK_RBRACE, "'}'")
out.services.push(svc)
end
func parse_package_stmt(p &: Pp, out &: PFile):
pp_advance(p)
name := parse_type_name(p)
out.packageName = name
pp_expect(p, PTK_SEMI, "';'")
end
func parse_import_stmt(p &: Pp, out &: PFile):
pp_advance(p)
pp_match_ident(p, "public")
pp_match_ident(p, "weak")
if not pp_check(p, PTK_STRING): pp_error(p, "a file name in quotes") end
strTok := pp_advance(p)
out.imports.push(strTok.sval)
pp_expect(p, PTK_SEMI, "';'")
end
func parse_syntax_stmt(p &: Pp):
pp_advance(p)
pp_expect(p, PTK_EQ, "'='")
if not pp_check(p, PTK_STRING): pp_error(p, "the syntax name in quotes") end
pp_advance(p)
pp_expect(p, PTK_SEMI, "';'")
end
@en "ParseFile"
@fa "تجزیه پرونده"
pub func ParseFile(source: str): PFile throws:
mut out := PFile {}
ts := try Tokenize(source)
mut p := Pp {}
p.toks = ts
p.count = ts.toks.len()
p.pos = 0
until not p.hadError:
if pp_check(p, PTK_EOF): break end
if pp_match(p, PTK_SEMI): continue end
if pp_check_ident(p, "syntax"):
parse_syntax_stmt(p)
continue
end
if pp_check_ident(p, "package"):
parse_package_stmt(p, out)
continue
end
if pp_check_ident(p, "import"):
parse_import_stmt(p, out)
continue
end
if pp_check_ident(p, "option"):
parse_option_stmt(p)
continue
end
if pp_check_ident(p, "message"):
mut msg := PMessage {}
parse_message(p, msg)
out.messages.push(msg)
continue
end
if pp_check_ident(p, "enum"):
mut en := PEnum {}
parse_enum(p, en)
out.enums.push(en)
continue
end
if pp_check_ident(p, "service"):
parse_service(p, out)
continue
end
pp_error(p, "'message', 'enum', 'service' or another top-level statement")
end
if p.hadError:
kind := p.errAtEnd ? ErrorKind.UnexpectedEnd : ErrorKind.Syntax
code := p.errAtEnd ? "protobuf.unexpected_end" : "protobuf.unexpected_token"
throw Error.At(kind, p.errMsg, p.errOffset).with_code(code).locate(source).wrap("protobuf")
end
ret out
end
@en "protobuf"
@fa "پروتوباف"
package protobuf
package protobuf
@en "PTK_EOF"
@fa "نشانه اتمام"
pub const PTK_EOF := 0
@en "PTK_IDENT"
@fa "نشانه شناسه"
pub const PTK_IDENT := 1
@en "PTK_INT"
@fa "نشانه عدد صحیح"
pub const PTK_INT := 2
@en "PTK_FLOAT"
@fa "نشانه عدد اعشاری"
pub const PTK_FLOAT := 3
@en "PTK_STRING"
@fa "نشانه رشته"
pub const PTK_STRING := 4
@en "PTK_SEMI"
@fa "نشانه نقطه‌ویرگول"
pub const PTK_SEMI := 5
@en "PTK_LBRACE"
@fa "نشانه آکولاد باز"
pub const PTK_LBRACE := 6
@en "PTK_RBRACE"
@fa "نشانه آکولاد بسته"
pub const PTK_RBRACE := 7
@en "PTK_LPAREN"
@fa "نشانه پرانتز باز"
pub const PTK_LPAREN := 8
@en "PTK_RPAREN"
@fa "نشانه پرانتز بسته"
pub const PTK_RPAREN := 9
@en "PTK_LBRACKET"
@fa "نشانه کروشه باز"
pub const PTK_LBRACKET := 10
@en "PTK_RBRACKET"
@fa "نشانه کروشه بسته"
pub const PTK_RBRACKET := 11
@en "PTK_LANGLE"
@fa "نشانه زاویه باز"
pub const PTK_LANGLE := 12
@en "PTK_RANGLE"
@fa "نشانه زاویه بسته"
pub const PTK_RANGLE := 13
@en "PTK_EQ"
@fa "نشانه مساوی"
pub const PTK_EQ := 14
@en "PTK_COMMA"
@fa "نشانه ویرگول"
pub const PTK_COMMA := 15
@en "PTK_DOT"
@fa "نشانه نقطه"
pub const PTK_DOT := 16
@en "PTK_MINUS"
@fa "نشانه منها"
pub const PTK_MINUS := 17
@en "PTK_ERROR"
@fa "نشانه خطا"
pub const PTK_ERROR := 18
@en "PToken"
@fa "نشانه پروتو"
pub struct PToken:
@en "kind"
@fa "نوع"
pub kind: int = PTK_EOF
@en "lexeme"
@fa "متن"
pub lexeme: str = ""
@en "ival"
@fa "مقدار صحیح"
pub ival: i64 = 0
@en "fval"
@fa "مقدار اعشاری"
pub fval: f64 = 0.0
@en "sval"
@fa "مقدار رشته"
pub sval: str = ""
@en "line"
@fa "شماره خط"
pub line: int = 0
@en "offset"
@fa "جایگاه"
pub offset: int = 0
end
package protobuf
import compress
import encoding.binary
@en "WT_VARINT"
@fa "نوع سیم متغیر"
pub const WT_VARINT := 0
@en "WT_FIXED64"
@fa "نوع سیم ثابت۶۴"
pub const WT_FIXED64 := 1
@en "WT_LEN"
@fa "نوع سیم طول‌دار"
pub const WT_LEN := 2
@en "WT_START_GROUP"
@fa "آغاز گروه"
pub const WT_START_GROUP := 3
@en "WT_END_GROUP"
@fa "گروه ختم"
pub const WT_END_GROUP := 4
@en "WT_FIXED32"
@fa "نوع سیم ثابت۳۲"
pub const WT_FIXED32 := 5
func _pb_err(kind: ErrorKind, msg: str, offset: int, code: str): Error:
ret Error.At(kind, msg, offset).with_code(code).wrap("protobuf")
end
func _pb_need(r: compress.ByteReader, n: int, what: str) throws:
if r.bad or compress.RdLeft(r) < n:
throw _pb_err(ErrorKind.UnexpectedEnd, what + " needs " + n + " bytes, " + compress.RdLeft(r) + " left", r.pos, "protobuf.truncated")
end
end
func _pb_len(r &: compress.ByteReader): int throws:
start := r.pos
n := try ReadVarint(r)
left := compress.RdLeft(r)
if n > (left as u64):
throw _pb_err(ErrorKind.UnexpectedEnd, "length-prefixed field needs " + n + " bytes, " + left + " left", start, "protobuf.truncated")
end
ret n as int
end
func _pb_skip_group(r &: compress.ByteReader, fieldNum: int, depth: int) throws:
if depth > 64:
throw _pb_err(ErrorKind.OutOfRange, "groups are nested deeper than 64 levels", r.pos, "protobuf.group_depth")
end
until compress.RdLeft(r) > 0:
at := r.pos
mut num := 0
mut wt := 0
try ReadTag(r, num, wt)
if wt == WT_END_GROUP:
if fieldNum != 0 and num != fieldNum:
throw _pb_err(ErrorKind.Syntax, "group " + fieldNum + " ends as group " + num, at, "protobuf.group_mismatch")
end
ret
end
try _pb_skip_field(r, num, wt, depth + 1)
end
throw _pb_err(ErrorKind.UnexpectedEnd, "a group is never closed", r.pos, "protobuf.truncated")
end
func _pb_skip_field(r &: compress.ByteReader, fieldNum: int, wireType: int, depth: int) throws:
start := r.pos
if wireType == WT_VARINT:
try ReadVarint(r)
else wireType == WT_FIXED64:
try _pb_need(r, 8, "fixed64")
r.pos += 8
else wireType == WT_FIXED32:
try _pb_need(r, 4, "fixed32")
r.pos += 4
else wireType == WT_LEN:
n := try _pb_len(r)
r.pos += n
else wireType == WT_START_GROUP:
try _pb_skip_group(r, fieldNum, depth)
else wireType == WT_END_GROUP:
throw _pb_err(ErrorKind.Syntax, "an end-group tag appears outside a group", start, "protobuf.group_mismatch")
else:
throw _pb_err(ErrorKind.Syntax, "invalid wire type " + wireType, start, "protobuf.bad_wire_type")
end
end
@en "MakeTag"
@fa "ساخت برچسب"
pub func MakeTag(fieldNum: int, wireType: int): u64:
ret ((fieldNum as u64) << (3 as u64)) | (wireType as u64)
end
@en "WriteVarint"
@fa "نوشتن عدد متغیر"
pub func WriteVarint(buf &: compress.ByteBuf, n: u64):
mut v := n
until true:
b := (v & (127 as u64)) as int
v >>= (7 as u64)
if v != (0 as u64):
compress.BufPush(buf, b | 128)
else:
compress.BufPush(buf, b)
ret
end
end
end
@en "ReadVarint"
@fa "خواندن عدد متغیر"
pub func ReadVarint(r &: compress.ByteReader): u64 throws:
start := r.pos
mut result := 0 as u64
mut shift := 0 as u64
mut i := 0
until i < 10:
if r.bad or compress.RdLeft(r) < 1:
throw _pb_err(ErrorKind.UnexpectedEnd, "varint is cut short", r.pos, "protobuf.truncated")
end
b := compress.RdByte(r)
if i == 9 and b > 1:
throw _pb_err(ErrorKind.OutOfRange, "varint does not fit in 64 bits", start, "protobuf.varint_overflow")
end
result |= (((b & 127) as u64) << shift)
if (b & 128) == 0:
ret result
end
shift += (7 as u64)
i++
end
throw _pb_err(ErrorKind.OutOfRange, "varint is longer than 10 bytes", start, "protobuf.varint_overflow")
end
@en "WriteTag"
@fa "نوشتن برچسب"
pub func WriteTag(buf &: compress.ByteBuf, fieldNum: int, wireType: int):
WriteVarint(buf, MakeTag(fieldNum, wireType))
end
@en "WriteStartGroup"
@fa "نوشتن آغاز گروه"
pub func WriteStartGroup(buf &: compress.ByteBuf, fieldNum: int):
WriteTag(buf, fieldNum, WT_START_GROUP)
end
@en "WriteEndGroup"
@fa "نوشتن ختم گروه"
pub func WriteEndGroup(buf &: compress.ByteBuf, fieldNum: int):
WriteTag(buf, fieldNum, WT_END_GROUP)
end
@en "ReadTag"
@fa "خواندن برچسب"
pub func ReadTag(r &: compress.ByteReader, fieldNum &: int, wireType &: int) throws:
start := r.pos
tag := try ReadVarint(r)
num := tag >> (3 as u64)
wt := (tag & (7 as u64)) as int
if num == (0 as u64) or num > (536870911 as u64):
throw _pb_err(ErrorKind.Syntax, "invalid field number " + num, start, "protobuf.bad_field_number")
end
if wt == 6 or wt == 7:
throw _pb_err(ErrorKind.Syntax, "invalid wire type " + wt + " for field " + num, start, "protobuf.bad_wire_type")
end
fieldNum = num as int
wireType = wt
end
@en "ZigZagEncode32"
@fa "کدگذاری زیگزاگ۳۲"
pub func ZigZagEncode32(n: i32): u32: ret ((n << 1) ^ (n >> 31)) as u32 end
@en "ZigZagDecode32"
@fa "کدگشایی زیگزاگ۳۲"
pub func ZigZagDecode32(n: u32): i32:
ni := n as i32
ret ((ni >> 1) ^ (0 - (ni & 1)))
end
@en "ZigZagEncode64"
@fa "کدگذاری زیگزاگ۶۴"
pub func ZigZagEncode64(n: i64): u64: ret ((n << 1) ^ (n >> 63)) as u64 end
@en "ZigZagDecode64"
@fa "کدگشایی زیگزاگ۶۴"
pub func ZigZagDecode64(n: u64): i64:
ni := n as i64
ret ((ni >> 1) ^ (0 - (ni & 1)))
end
@en "WriteFixed32"
@fa "نوشتن ثابت۳۲"
pub func WriteFixed32(buf &: compress.ByteBuf, v: u32): binary.WriteU32LE(buf, v as int) end
@en "ReadFixed32"
@fa "خواندن ثابت۳۲"
pub func ReadFixed32(r &: compress.ByteReader): u32 throws:
try _pb_need(r, 4, "fixed32")
ret try binary.ReadU32LE(r) as u32
end
@en "WriteFixed64"
@fa "نوشتن ثابت۶۴"
pub func WriteFixed64(buf &: compress.ByteBuf, v: u64): binary.WriteU64LE(buf, v as i64) end
@en "ReadFixed64"
@fa "خواندن ثابت۶۴"
pub func ReadFixed64(r &: compress.ByteReader): u64 throws:
try _pb_need(r, 8, "fixed64")
ret try binary.ReadU64LE(r) as u64
end
@en "WriteFloat"
@fa "نوشتن اعشار۳۲"
pub func WriteFloat(buf &: compress.ByteBuf, v: f64): binary.WriteF32(buf, v, false) end
@en "ReadFloat"
@fa "خواندن اعشار۳۲"
pub func ReadFloat(r &: compress.ByteReader): f64 throws:
try _pb_need(r, 4, "float")
ret try binary.ReadF32(r, false)
end
@en "WriteDouble"
@fa "نوشتن اعشار۶۴"
pub func WriteDouble(buf &: compress.ByteBuf, v: f64): binary.WriteF64(buf, v, false) end
@en "ReadDouble"
@fa "خواندن اعشار۶۴"
pub func ReadDouble(r &: compress.ByteReader): f64 throws:
try _pb_need(r, 8, "double")
ret try binary.ReadF64(r, false)
end
@en "WriteLenPrefixedBytes"
@fa "نوشتن بایت‌های طول‌دار"
pub func WriteLenPrefixedBytes(buf &: compress.ByteBuf, p: void*, n: int):
WriteVarint(buf, n as u64)
compress.BufPushBytes(buf, p, n)
end
@en "WriteLenPrefixedStr"
@fa "نوشتن رشته طول‌دار"
pub func WriteLenPrefixedStr(buf &: compress.ByteBuf, s: str):
WriteLenPrefixedBytes(buf, s as void*, s.len())
end
@en "ReadLenPrefixedBuf"
@fa "خواندن بافر طول‌دار"
pub func ReadLenPrefixedBuf(r &: compress.ByteReader): compress.ByteBuf throws:
n := try _pb_len(r)
ret compress.RdBytes(r, n)
end
@en "ReadLenPrefixedStr"
@fa "خواندن رشته طول‌دار"
pub func ReadLenPrefixedStr(r &: compress.ByteReader): str throws:
n := try _pb_len(r)
mut b := compress.RdBytes(r, n)
out := compress.BufToStrUnsafe(b)
compress.BufFree(b)
ret out
end
@en "SkipFieldFor"
@fa "رد کردن فیلد با شماره"
pub func SkipFieldFor(r &: compress.ByteReader, fieldNum: int, wireType: int) throws:
try _pb_skip_field(r, fieldNum, wireType, 0)
end
@en "SkipField"
@fa "رد کردن فیلد"
pub func SkipField(r &: compress.ByteReader, wireType: int) throws:
try SkipFieldFor(r, 0, wireType)
end
@en "query"
@fa "پرس‌وجو"
package query
import str
import encoding
@en "QueryOptions"
@fa "گزینه‌های پرس‌وجو"
pub struct QueryOptions:
@en "space_as_plus"
@fa "فاصله پلاس"
pub space_as_plus: bool = true
end
@en "QueryValues"
@fa "مقدارهای پرس‌وجو"
pub struct QueryValues:
@en "items"
@fa "مقدارها"
pub items: Vector<str> = Vector {}
end
@en "QueryMap"
@fa "نگاشت پرس‌وجو"
pub struct QueryMap:
@en "data"
@fa "داده"
pub data: HashMap<str, QueryValues> = HashMap {} as HashMap<str, QueryValues>
@en "order"
@fa "ترتیب"
pub order: Vector<str> = Vector {}
end
inline pure func _bp(s: str): i8*: ret (s as void*) as i8* end
inline pure func _ub(bp: i8*, i: int): int:
mut v := bp[i] as int
if v < 0: v += 256 end
ret v
end
func _hexval(code: int): int:
if code >= 48 and code <= 57: ret code - 48 end
if code >= 65 and code <= 70: ret code - 55 end
if code >= 97 and code <= 102: ret code - 87 end
ret 0 - 1
end
func _pct_decode(text: str, from: int, stop: int, plus_as_space: bool, strict: bool, err &: Error): str:
bp := _bp(text)
mut sb := str.NewBuilder()
defer str.BufFree(sb)
mut i := from
until i < stop:
code := _ub(bp, i)
if code == 37:
mut hi := 0 - 1
mut lo := 0 - 1
if i + 1 < stop: hi = _hexval(_ub(bp, i + 1)) end
if i + 2 < stop: lo = _hexval(_ub(bp, i + 2)) end
if hi >= 0 and lo >= 0:
str.BufAppendChar(sb, hi * 16 + lo)
i += 3
else:
if strict and err.message == "":
mut kind := ErrorKind.Syntax
mut message := "malformed percent escape"
if i + 2 >= stop and (i + 1 >= stop or hi >= 0):
kind = ErrorKind.UnexpectedEnd
message = "incomplete percent escape"
end
err = Error.At(kind, message, i).locate(text).wrap("query")
end
str.BufAppendChar(sb, code)
i++
end
else code == 43 and plus_as_space:
str.BufAppendChar(sb, 32)
i++
else:
str.BufAppendChar(sb, code)
i++
end
end
ret str.BufStr(sb)
end
func _parse(qs: str, opts: QueryOptions, strict: bool, err &: Error): QueryMap:
mut out := QueryMap {}
n := qs.len()
bp := _bp(qs)
mut pos := 0
if n > 0 and _ub(bp, 0) == 63: pos = 1 end
until pos < n:
mut pend := pos
until pend < n and _ub(bp, pend) != 38:
pend++
end
if pend > pos:
mut eq_at := pos
until eq_at < pend and _ub(bp, eq_at) != 61:
eq_at++
end
key := _pct_decode(qs, pos, eq_at, opts.space_as_plus, strict, err)
mut val := ""
if eq_at < pend:
val = _pct_decode(qs, eq_at + 1, pend, opts.space_as_plus, strict, err)
end
if strict and err.message != "": ret out end
mut qv := QueryValues {}
if out.data.has(key):
qv = out.data.get(key)
else:
out.order.push(key)
end
qv.items.push(val)
out.data.put(key, qv)
end
pos = pend + 1
end
ret out
end
func _encode_component(s: str, space_as_plus: bool): str:
enc := encoding.URLEncode(s)
if space_as_plus: ret str.Replace(enc, "%20", "+") end
ret enc
end
@en "NewQueryMap"
@fa "نگاشت پرس‌وجو جدید"
pub func NewQueryMap(): QueryMap: ret QueryMap {} end
@en "DecodeWith"
@fa "کدگشایی سفارشی"
pub func DecodeWith(qs: str, opts: QueryOptions): QueryMap throws:
mut err := Error {}
out := _parse(qs, opts, true, err)
if err.message != "": throw err end
ret out
end
@en "Decode"
@fa "کدگشایی"
pub func Decode(qs: str): QueryMap throws:
ret try DecodeWith(qs, QueryOptions {})
end
@en "EncodeWith"
@fa "کدگذاری سفارشی"
pub func EncodeWith(values: QueryMap, opts: QueryOptions): str:
mut out := str.NewBuilder()
mut first := true
mut i := 0
until i < values.order.len():
k := values.order.get(i)
i++
if values.data.has(k) == false: continue end
qv := values.data.get(k)
mut j := 0
until j < qv.items.len():
if not first: str.BufAppendChar(out, 38) end
first = false
str.BufAppend(out, _encode_component(k, opts.space_as_plus))
str.BufAppendChar(out, 61)
str.BufAppend(out, _encode_component(qv.items.get(j), opts.space_as_plus))
j++
end
end
ret str.BufStr(out)
end
@en "Encode"
@fa "کدگذاری"
pub func Encode(values: QueryMap): str:
ret EncodeWith(values, QueryOptions {})
end
@en "GetAll"
@fa "همه مقدارها"
pub func GetAll(qs: str, key: str): Vector<str>:
mut err := Error {}
m := _parse(qs, QueryOptions {}, false, err)
if m.data.has(key): ret m.data.get(key).items end
ret Vector {}
end
@en "Get"
@fa "مقدار"
pub func Get(qs: str, key: str): str:
vs := GetAll(qs, key)
if vs.len() > 0: ret vs.get(0) end
ret ""
end
@en "Has"
@fa "دارد"
pub func Has(qs: str, key: str): bool:
mut err := Error {}
m := _parse(qs, QueryOptions {}, false, err)
ret m.data.has(key)
end
@en "Size"
@fa "اندازه"
pub func Size(m: QueryMap): int: ret m.data.size() end
@en "Add"
@fa "افزودن"
pub func Add(values &: QueryMap, key: str, val: str):
mut qv := QueryValues {}
if values.data.has(key):
qv = values.data.get(key)
else:
values.order.push(key)
end
qv.items.push(val)
values.data.put(key, qv)
end
@en "Set"
@fa "تنظیم"
pub func Set(values &: QueryMap, key: str, val: str):
mut qv := QueryValues {}
qv.items.push(val)
if values.data.has(key) == false: values.order.push(key) end
values.data.put(key, qv)
end
@en "Keys"
@fa "کلیدها"
pub func Keys(values: QueryMap): Vector<str>:
mut out := Vector {} as Vector<str>
mut i := 0
until i < values.order.len():
out.push(values.order.get(i))
i++
end
ret out
end
@en "Remove"
@fa "حذف"
pub func Remove(values &: QueryMap, key: str): bool:
if values.data.has(key) == false: ret false end
values.data.remove(key)
mut i := 0
until i < values.order.len():
if values.order.get(i) == key:
values.order.remove_at(i)
ret true
end
i++
end
ret true
end
@en "Retain"
@fa "نگه داشتن"
pub func Retain(values &: QueryMap, keep: Vector<str>):
ks := Keys(values)
defer ks.free()
mut i := 0
until i < ks.len():
k := ks.get(i)
mut found := false
mut j := 0
until j < keep.len():
if keep.get(j) == k: found = true end
j++
end
if found == false: Remove(values, k) end
i++
end
end
@en "serde"
@fa "تبدیل قالب"
package serde
import encoding.value
import encoding.json
import encoding.yaml
import encoding.toml
import encoding.xml
import encoding.csv
import str
@en "FormatUnknown"
@fa "قالب ناشناخته"
pub const FormatUnknown := 0
@en "FormatJSON"
@fa "قالب جیسون"
pub const FormatJSON := 1
@en "FormatYAML"
@fa "قالب یامل"
pub const FormatYAML := 2
@en "FormatTOML"
@fa "قالب تامل"
pub const FormatTOML := 3
@en "FormatXML"
@fa "قالب اکس‌ام‌ال"
pub const FormatXML := 4
@en "FormatCSV"
@fa "قالب سی اس وی"
pub const FormatCSV := 5
func _trim_leading_ws(s: str): str:
n := s.len()
mut i := 0
until i < n:
c := s.substr(i, 1)
if c != " " and c != "\t" and c != "\n" and c != "\r": break end
i++
end
ret s.substr(i, n - i)
end
func _looks_toml(s: str): bool:
lines := str.Split(s, "\n")
mut i := 0
until i < lines.len():
line := _trim_leading_ws(lines.get(i))
if line.len() > 0 and str.CharAt(line, 0) != "#":
if str.CharAt(line, 0) == "[": ret true end
eq_at := str.IndexOf(line, "=")
colon := str.IndexOf(line, ":")
if eq_at >= 0 and (colon < 0 or eq_at < colon): ret true end
end
i++
end
ret false
end
func _same_width(t: csv.CSVTable): bool:
if t.rows.len() < 2: ret false end
first := t.rows.get(0).fields.len()
if first < 2: ret false end
repeat t.rows.len() in j:
if t.rows.get(j).fields.len() != first: ret false end
end
ret true
end
func _looks_csv(s: str): bool:
try:
mut t := csv.ReadAll(s)
out := _same_width(t)
csv.FreeTable(t)
ret out
catch:
ret false
end
end
func _decode_by_name(data: str, from: str): value.Value throws:
if from == "json":
ret try json.Decode(data)
end
if from == "yaml":
ret try yaml.Decode(data)
end
if from == "toml":
ret try toml.Decode(data)
end
if from == "xml":
node := try xml.Decode(data)
ret xml.ToValue(node)
end
if from == "csv":
ret try csv.ToValue(data)
end
throw Error.New(ErrorKind.InvalidArgument, "unknown format '" + from + "'").wrap("serde")
end
func _encode_by_name(v: value.Value, dest: str): str throws:
if dest == "json": ret json.EncodeDefault(v) end
if dest == "yaml": ret yaml.Encode(v) end
if dest == "toml": ret try toml.Encode(v) end
if dest == "xml": ret xml.EncodeDeclaration(xml.FromValue(v, "root")) end
if dest == "csv": ret csv.FromValue(v) end
throw Error.New(ErrorKind.InvalidArgument, "unknown format '" + dest + "'").wrap("serde")
end
@en "DetectFormat"
@fa "تشخیص شماره قالب"
pub func DetectFormat(text: str): int:
trimmed := _trim_leading_ws(text)
if trimmed.len() == 0: ret FormatUnknown end
if str.CharAt(trimmed, 0) == "<": ret FormatXML end
if json.Valid(trimmed): ret FormatJSON end
if _looks_toml(trimmed) and toml.Valid(trimmed): ret FormatTOML end
if _looks_csv(trimmed): ret FormatCSV end
if yaml.Valid(trimmed): ret FormatYAML end
ret FormatUnknown
end
@en "Detect"
@fa "تشخیص قالب"
pub func Detect(text: str): str:
f := DetectFormat(text)
if f == FormatJSON: ret "json" end
if f == FormatYAML: ret "yaml" end
if f == FormatTOML: ret "toml" end
if f == FormatXML: ret "xml" end
if f == FormatCSV: ret "csv" end
ret ""
end
@en "TranscodeStrict"
@fa "تبدیل قالب سخت گیرانه"
pub func TranscodeStrict(data: str, from: str, dest: str): str throws:
v := try _decode_by_name(data, from)
ret try _encode_by_name(v, dest)
end
@en "Transcode"
@fa "تبدیل قالب"
pub func Transcode(data: str, from: str, dest: str): str:
try:
ret TranscodeStrict(data, from, dest)
catch:
ret ""
end
end
@en "toml"
@fa "تامل"
package toml
import encoding.value
import str
import conv
import mem
inline pure func _bp(s: str): i8*: ret (s as void*) as i8* end
func _tsub(s: str, start: int, cnt: int): str:
bp := _bp(s)
mut sb := str.NewBuilder()
mut k := 0
until k < cnt:
str.BufAppendChar(sb, bp[start + k] as int)
k++
end
out := str.BufStr(sb)
str.BufFree(sb)
ret out
end
inline pure func _ub(bp: i8*, i: int): int:
mut v := bp[i] as int
if v < 0: v += 256 end
ret v
end
func _fail(err &: Error, kind: ErrorKind, message: str, at: int, code: str):
if err.message != "": ret end
err = Error.At(kind, message, at).with_code(code)
end
func _is_digit(c: int): bool: ret c >= 48 and c <= 57 end
func _is_bare_key_char(c: int): bool:
ret _is_digit(c) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 45 or c == 95
end
func _skip_inline_ws(s: str, n: int, i: int): int:
bp := _bp(s)
mut p := i
until p < n:
c := _ub(bp, p)
if c != 32 and c != 9: ret p end
p++
end
ret p
end
func _skip_loose(s: str, n: int, i: int): int:
bp := _bp(s)
mut p := i
until p < n:
c := _ub(bp, p)
if c == 32 or c == 9 or c == 10 or c == 13:
p++
else c == 35:
until p < n and _ub(bp, p) != 10:
p++
end
else:
ret p
end
end
ret p
end
func _end_of_line(s: str, n: int, i: int, what: str, err &: Error): bool:
p := _skip_inline_ws(s, n, i)
if p >= n: ret true end
c := _ub(_bp(s), p)
if c == 10 or c == 13 or c == 35: ret true end
_fail(err, ErrorKind.Syntax, "expected the end of the line after " + what, p, "toml.expected_newline")
ret false
end
func _digit_val(c: int): int:
if c >= 48 and c <= 57: ret c - 48 end
if c >= 97 and c <= 102: ret c - 97 + 10 end
if c >= 65 and c <= 70: ret c - 65 + 10 end
ret 0 - 1
end
func _hexn(s: str, n: int, i: int, cnt: int): int:
if i + cnt > n: ret 0 - 1 end
bp := _bp(s)
mut out := 0
repeat cnt in k:
d := _digit_val(_ub(bp, i + k))
if d < 0: ret 0 - 1 end
if out <= 0x10FFFF: out = out * 16 + d end
end
ret out
end
func _parse_int_base(s: str, first: int, base: int, neg: bool, fits &: bool): i64:
fits = true
n := s.len()
bp := _bp(s)
mut limit := 9223372036854775807 as u64
if neg: limit = 9223372036854775808 as u64 end
mut acc := 0 as u64
mut i := first
until i < n:
d := _digit_val(_ub(bp, i))
if d >= 0 and d < base:
if acc > (limit - (d as u64)) / (base as u64):
fits = false
ret 0
end
acc = acc * (base as u64) + (d as u64)
end
i++
end
if neg: ret (0 as u64 - acc) as i64 end
ret acc as i64
end
func _bits_to_f64(bits: i64): f64:
buf := mem.Allocate(8 as u64)
p := buf as i64*
p[0] = bits
q := buf as f64*
v := q[0]
mem.Free(buf)
ret v
end
func _pos_inf(): f64: ret _bits_to_f64((0x7FF0000000000000 as u64) as i64) end
func _neg_inf(): f64: ret _bits_to_f64((0xFFF0000000000000 as u64) as i64) end
func _nan_val(): f64: ret _bits_to_f64((0x7FF8000000000000 as u64) as i64) end
func _unterminated(err &: Error, n: int, start: int, stop: int):
if stop >= n:
_fail(err, ErrorKind.UnexpectedEnd, "the string is not closed", start, "toml.unterminated_string")
else:
_fail(err, ErrorKind.Syntax, "the string is not closed before the end of the line", start, "toml.unterminated_string")
end
end
func _skip_toml_newline(bp: i8*, n: int, p: int): int:
if p >= n: ret p end
c := _ub(bp, p)
if c == 10: ret p + 1 end
if c == 13 and p + 1 < n and _ub(bp, p + 1) == 10: ret p + 2 end
ret p
end
func _skip_toml_ws_nl(bp: i8*, n: int, p: int): int:
mut q := p
until q < n:
c := _ub(bp, q)
if c != 32 and c != 9 and c != 10 and c != 13: break end
q++
end
ret q
end
func _append_basic_escape(s: str, n: int, p: int, sb &: str.StringBuilder, err &: Error): int:
if p + 1 >= n:
_fail(err, ErrorKind.UnexpectedEnd, "the string is not closed", p, "toml.unterminated_string")
ret n
end
e := _ub(_bp(s), p + 1)
if e == 34: str.BufAppendChar(sb, 34)
else e == 92: str.BufAppendChar(sb, 92)
else e == 110: str.BufAppendChar(sb, 10)
else e == 116: str.BufAppendChar(sb, 9)
else e == 114: str.BufAppendChar(sb, 13)
else e == 98: str.BufAppendChar(sb, 8)
else e == 102: str.BufAppendChar(sb, 12)
else e == 117 or e == 85:
cnt := e == 117 ? 4 : 8
cp := _hexn(s, n, p + 2, cnt)
if cp < 0 or cp > 0x10FFFF or (cp >= 0xD800 and cp <= 0xDFFF):
_fail(err, ErrorKind.Syntax, "invalid unicode escape '" + _tsub(s, p, 2) + "'", p, "toml.invalid_escape")
ret n
end
str.BufAppendCp(sb, cp)
ret p + 2 + cnt
else:
_fail(err, ErrorKind.Syntax, "invalid escape '" + _tsub(s, p, 2) + "'", p, "toml.invalid_escape")
ret n
end
ret p + 2
end
func _parse_basic_multiline(s: str, n: int, i: int, endpos &: int, err &: Error): str:
bp := _bp(s)
endpos = n
mut sb := str.NewBuilder()
defer str.BufFree(sb)
mut p := _skip_toml_newline(bp, n, i + 3)
until p < n:
c := _ub(bp, p)
if c == 34:
mut q := p
until q < n and _ub(bp, q) == 34:
q++
end
run := q - p
if run >= 3:
if run > 5:
_fail(err, ErrorKind.Syntax, "too many quotes close a multi-line string", p, "toml.invalid_string")
ret ""
end
mut extra := 0
until extra < run - 3:
str.BufAppendChar(sb, 34)
extra++
end
endpos = q
ret str.BufStr(sb)
end
mut k := 0
until k < run:
str.BufAppendChar(sb, 34)
k++
end
p = q
continue
end
if c == 92:
e := _ub(bp, p + 1)
if e == 10 or (e == 13 and p + 2 < n and _ub(bp, p + 2) == 10):
p = _skip_toml_ws_nl(bp, n, p + 2)
continue
end
p = _append_basic_escape(s, n, p, sb, err)
if err.message != "": ret "" end
continue
end
if c == 13:
if p + 1 < n and _ub(bp, p + 1) == 10:
p++
end
str.BufAppendChar(sb, 10)
p++
continue
end
if c == 10:
str.BufAppendChar(sb, 10)
p++
continue
end
if c < 32 and c != 9:
_fail(err, ErrorKind.Syntax, "a control character is not allowed in a string", p, "toml.invalid_string")
ret ""
end
str.BufAppendChar(sb, c)
p++
end
_unterminated(err, n, i, p)
ret ""
end
func _parse_literal_multiline(s: str, n: int, i: int, endpos &: int, err &: Error): str:
bp := _bp(s)
endpos = n
mut sb := str.NewBuilder()
defer str.BufFree(sb)
mut p := _skip_toml_newline(bp, n, i + 3)
until p < n:
c := _ub(bp, p)
if c == 39:
mut q := p
until q < n and _ub(bp, q) == 39:
q++
end
run := q - p
if run >= 3:
if run > 5:
_fail(err, ErrorKind.Syntax, "too many quotes close a multi-line string", p, "toml.invalid_string")
ret ""
end
mut extra := 0
until extra < run - 3:
str.BufAppendChar(sb, 39)
extra++
end
endpos = q
ret str.BufStr(sb)
end
mut k := 0
until k < run:
str.BufAppendChar(sb, 39)
k++
end
p = q
continue
end
if c == 13:
if p + 1 < n and _ub(bp, p + 1) == 10:
p++
end
str.BufAppendChar(sb, 10)
p++
continue
end
if c == 10:
str.BufAppendChar(sb, 10)
p++
continue
end
str.BufAppendChar(sb, c)
p++
end
_unterminated(err, n, i, p)
ret ""
end
func _parse_basic_string(s: str, n: int, i: int, endpos &: int, err &: Error): str:
bp := _bp(s)
endpos = n
if i + 2 < n and _ub(bp, i + 1) == 34 and _ub(bp, i + 2) == 34:
ret _parse_basic_multiline(s, n, i, endpos, err)
end
mut sb := str.NewBuilder()
defer str.BufFree(sb)
mut p := i + 1
until p < n:
c := _ub(bp, p)
if c == 34:
endpos = p + 1
ret str.BufStr(sb)
end
if c == 10 or c == 13: break end
if c == 92:
if p + 1 >= n:
p = n
break
end
e := _ub(bp, p + 1)
if e == 34: str.BufAppendChar(sb, 34)
else e == 92: str.BufAppendChar(sb, 92)
else e == 110: str.BufAppendChar(sb, 10)
else e == 116: str.BufAppendChar(sb, 9)
else e == 114: str.BufAppendChar(sb, 13)
else e == 98: str.BufAppendChar(sb, 8)
else e == 102: str.BufAppendChar(sb, 12)
else e == 117 or e == 85:
cnt := e == 117 ? 4 : 8
cp := _hexn(s, n, p + 2, cnt)
if cp < 0 or cp > 0x10FFFF or (cp >= 0xD800 and cp <= 0xDFFF):
_fail(err, ErrorKind.Syntax, "invalid unicode escape '" + _tsub(s, p, 2) + "'", p, "toml.invalid_escape")
ret ""
end
str.BufAppendCp(sb, cp)
p += cnt
else:
_fail(err, ErrorKind.Syntax, "invalid escape '" + _tsub(s, p, 2) + "'", p, "toml.invalid_escape")
ret ""
end
p += 2
else:
str.BufAppendChar(sb, c)
p++
end
end
_unterminated(err, n, i, p)
ret ""
end
func _parse_literal_string(s: str, n: int, i: int, endpos &: int, err &: Error): str:
bp := _bp(s)
endpos = n
if i + 2 < n and _ub(bp, i + 1) == 39 and _ub(bp, i + 2) == 39:
ret _parse_literal_multiline(s, n, i, endpos, err)
end
mut p := i + 1
start := p
until p < n:
c := _ub(bp, p)
if c == 39:
endpos = p + 1
ret _tsub(s, start, p - start)
end
if c == 10 or c == 13: break end
p++
end
_unterminated(err, n, i, p)
ret ""
end
func _parse_key(s: str, n: int, i: int, endpos &: int, err &: Error): str:
endpos = i
if i >= n:
_fail(err, ErrorKind.UnexpectedEnd, "expected a key", i, "toml.expected_key")
ret ""
end
bp := _bp(s)
c := _ub(bp, i)
if c == 34: ret _parse_basic_string(s, n, i, endpos, err) end
if c == 39: ret _parse_literal_string(s, n, i, endpos, err) end
mut p := i
until p < n and _is_bare_key_char(_ub(bp, p)):
p++
end
endpos = p
if p == i:
_fail(err, ErrorKind.Syntax, "expected a key", i, "toml.expected_key")
ret ""
end
ret _tsub(s, i, p - i)
end
func _parse_key_path(s: str, n: int, i: int, endpos &: int, err &: Error): Vector<str>:
mut out := Vector {} as Vector<str>
mut p := i
bp := _bp(s)
until true:
p = _skip_inline_ws(s, n, p)
mut kend := p
k := _parse_key(s, n, p, kend, err)
if err.message != "":
endpos = kend
ret out
end
out.push(k)
p = _skip_inline_ws(s, n, kend)
if p < n and _ub(bp, p) == 46:
p++
else:
endpos = p
ret out
end
end
end
func _dotted(path: Vector<str>, count: int): str:
mut out := ""
mut i := 0
until i < count:
if i > 0: out += "." end
out += path.get(i)
i++
end
ret out
end
func _kind_name(v: value.Value): str:
if value.IsObject(v): ret "a table" end
if value.IsArray(v): ret "an array" end
if value.IsString(v): ret "a string" end
if value.IsInt(v): ret "an integer" end
if value.IsFloat(v): ret "a float" end
if value.IsBool(v): ret "a boolean" end
ret "null"
end
func _scan_bare_token(s: str, n: int, i: int, endpos &: int): str:
bp := _bp(s)
mut p := i
until p < n:
c := _ub(bp, p)
if c == 44 or c == 93 or c == 125 or c == 32 or c == 9 or c == 10 or c == 13 or c == 35:
break
end
p++
end
endpos = p
ret _tsub(s, i, p - i)
end
func _looks_datetime(tok: str): bool:
n := tok.len()
if n < 5: ret false end
bp := _bp(tok)
is_date := n >= 10 and _ub(bp, 4) == 45
is_clock := _ub(bp, 2) == 58
if not is_date and not is_clock: ret false end
lead := is_date ? 4 : 2
repeat lead in k:
if not _is_digit(_ub(bp, k)): ret false end
end
repeat n in k:
c := _ub(bp, k)
if not (_is_digit(c) or c == 45 or c == 58 or c == 46 or c == 43 or c == 84 or c == 116 or c == 90 or c == 122):
ret false
end
end
ret true
end
func _digits_ok(s: str, lo: int, hi: int, base: int): bool:
if lo >= hi: ret false end
bp := _bp(s)
mut prev_digit := false
mut i := lo
until i < hi:
c := _ub(bp, i)
if c == 95:
if not prev_digit: ret false end
prev_digit = false
else:
d := _digit_val(c)
if d < 0 or d >= base: ret false end
prev_digit = true
end
i++
end
ret prev_digit
end
func _scan_digits(s: str, n: int, i: int): int:
bp := _bp(s)
mut p := i
until p < n and (_is_digit(_ub(bp, p)) or _ub(bp, p) == 95):
p++
end
ret p
end
func _prefix_base(tok: str): int:
if tok.len() < 3 or _ub(_bp(tok), 0) != 48: ret 0 end
c := _ub(_bp(tok), 1)
if c == 120: ret 16 end
if c == 111: ret 8 end
if c == 98: ret 2 end
ret 0
end
func _valid_number(tok: str): bool:
n := tok.len()
if n == 0: ret false end
bp := _bp(tok)
base := _prefix_base(tok)
if base > 0: ret _digits_ok(tok, 2, n, base) end
mut i := 0
c0 := _ub(bp, 0)
if c0 == 43 or c0 == 45: i = 1 end
rest := tok.substr(i, n - i)
if rest == "inf" or rest == "nan": ret true end
start := i
i = _scan_digits(tok, n, i)
if not _digits_ok(tok, start, i, 10): ret false end
if i - start > 1 and _ub(bp, start) == 48: ret false end
if i < n and _ub(bp, i) == 46:
fs := i + 1
i = _scan_digits(tok, n, fs)
if not _digits_ok(tok, fs, i, 10): ret false end
end
if i < n and (_ub(bp, i) == 101 or _ub(bp, i) == 69):
i++
if i < n and (_ub(bp, i) == 43 or _ub(bp, i) == 45): i++ end
es := i
i = _scan_digits(tok, n, es)
if not _digits_ok(tok, es, i, 10): ret false end
end
ret i == n
end
func _parse_number(tok: str, at: int, err &: Error): value.Value:
base := _prefix_base(tok)
mut fits := true
if base > 0:
v := _parse_int_base(tok, 2, base, false, fits)
if not fits:
_fail(err, ErrorKind.OutOfRange, "the integer " + tok + " does not fit in 64 bits", at, "toml.int_overflow")
end
ret value.ValueInt(v)
end
clean := str.Replace(tok, "_", "")
if clean == "inf" or clean == "+inf": ret value.ValueFloat(_pos_inf()) end
if clean == "-inf": ret value.ValueFloat(_neg_inf()) end
if clean == "nan" or clean == "+nan" or clean == "-nan": ret value.ValueFloat(_nan_val()) end
if str.Contains(clean, ".") or str.Contains(clean, "e") or str.Contains(clean, "E"):
ret value.ValueFloat(clean.to_float())
end
c0 := _ub(_bp(clean), 0)
neg := c0 == 45
mut first := 0
if c0 == 43 or c0 == 45: first = 1 end
v := _parse_int_base(clean, first, 10, neg, fits)
if not fits:
_fail(err, ErrorKind.OutOfRange, "the integer " + tok + " does not fit in 64 bits", at, "toml.int_overflow")
end
ret value.ValueInt(v)
end
func _parse_value_d(s: str, n: int, i: int, endpos &: int, err &: Error, depth: int): value.Value:
p0 := _skip_inline_ws(s, n, i)
endpos = p0
if depth > 512:
_fail(err, ErrorKind.OutOfRange, "the value is nested deeper than 512 levels", p0, "toml.too_deep")
ret value.ValueNull()
end
if p0 >= n:
_fail(err, ErrorKind.UnexpectedEnd, "expected a value", p0, "toml.expected_value")
ret value.ValueNull()
end
bp := _bp(s)
c := _ub(bp, p0)
if c == 34: ret value.ValueString(_parse_basic_string(s, n, p0, endpos, err)) end
if c == 39: ret value.ValueString(_parse_literal_string(s, n, p0, endpos, err)) end
if c == 91: ret _parse_array(s, n, p0, endpos, err, depth) end
if c == 123: ret _parse_inline_table(s, n, p0, endpos, err, depth) end
mut ep := p0
tok := _scan_bare_token(s, n, p0, ep)
endpos = ep
if tok.len() == 0:
_fail(err, ErrorKind.Syntax, "expected a value", p0, "toml.expected_value")
ret value.ValueNull()
end
if tok == "true": ret value.ValueBool(true) end
if tok == "false": ret value.ValueBool(false) end
if _looks_datetime(tok):
if tok.len() == 10 and ep + 3 < n and _ub(bp, ep) == 32 and _is_digit(_ub(bp, ep + 1)) and _is_digit(_ub(bp, ep + 2)) and _ub(bp, ep + 3) == 58:
mut ep2 := ep + 1
clock := _scan_bare_token(s, n, ep + 1, ep2)
endpos = ep2
ret value.ValueString(tok + " " + clock)
end
ret value.ValueString(tok)
end
if _valid_number(tok): ret _parse_number(tok, p0, err) end
_fail(err, ErrorKind.Syntax, "invalid value '" + tok + "'", p0, "toml.invalid_value")
ret value.ValueNull()
end
func _parse_array(s: str, n: int, i: int, endpos &: int, err &: Error, depth: int): value.Value:
mut out := value.NewValueArray()
bp := _bp(s)
mut p := _skip_loose(s, n, i + 1)
until true:
if p >= n: break end
if _ub(bp, p) == 93:
endpos = p + 1
ret out
end
mut vend := p
item := _parse_value_d(s, n, p, vend, err, depth + 1)
if err.message != "":
endpos = vend
ret out
end
value.ArrayPush(out, item)
p = _skip_loose(s, n, vend)
if p < n and _ub(bp, p) == 44:
p = _skip_loose(s, n, p + 1)
continue
end
if p < n and _ub(bp, p) == 93:
endpos = p + 1
ret out
end
if p < n:
_fail(err, ErrorKind.Syntax, "expected ',' or ']' in the array", p, "toml.expected_comma")
endpos = p
ret out
end
end
_fail(err, ErrorKind.UnexpectedEnd, "the array is not closed", i, "toml.unclosed_array")
endpos = n
ret out
end
func _descend(root &: value.Value, path: Vector<str>, idx: int, child &: value.Value, at: int, err &: Error): bool:
key := path.get(idx)
child = value.NewValueObject()
if not value.ObjectHas(root, key): ret true end
child = value.ObjectGet(root, key)
if value.IsObject(child): ret true end
if value.IsArray(child) and value.ArrayLen(child) > 0 and value.IsObject(value.ArrayGet(child, value.ArrayLen(child) - 1)): ret true end
_fail(err, ErrorKind.TypeMismatch, "'" + _dotted(path, idx + 1) + "' is " + _kind_name(child) + ", not a table", at, "toml.not_a_table")
ret false
end
func _store(root &: value.Value, key: str, child &: value.Value, item: value.Value):
if value.IsArray(child):
value.ArraySet(child, value.ArrayLen(child) - 1, item)
value.ObjectSet(root, key, child)
else:
value.ObjectSet(root, key, item)
end
end
func _inner(child: value.Value): value.Value:
if value.IsArray(child): ret value.ArrayGet(child, value.ArrayLen(child) - 1) end
ret child
end
func _put(root &: value.Value, path: Vector<str>, idx: int, leaf: value.Value, at: int, err &: Error): bool:
key := path.get(idx)
if idx == path.len() - 1:
if value.ObjectHas(root, key):
_fail(err, ErrorKind.AlreadyExists, "duplicate key '" + _dotted(path, idx + 1) + "'", at, "toml.duplicate_key")
ret false
end
value.ObjectSet(root, key, leaf)
ret true
end
mut child := value.NewValueObject()
if not _descend(root, path, idx, child, at, err): ret false end
mut item := _inner(child)
if not _put(item, path, idx + 1, leaf, at, err): ret false end
_store(root, key, child, item)
ret true
end
func _parse_inline_table(s: str, n: int, i: int, endpos &: int, err &: Error, depth: int): value.Value:
mut out := value.NewValueObject()
bp := _bp(s)
mut p := _skip_inline_ws(s, n, i + 1)
if p < n and _ub(bp, p) == 125:
endpos = p + 1
ret out
end
until true:
p = _skip_inline_ws(s, n, p)
kstart := p
mut kend := p
path := _parse_key_path(s, n, p, kend, err)
if err.message != "":
endpos = kend
ret out
end
p = _skip_inline_ws(s, n, kend)
if p >= n or _ub(bp, p) != 61:
if p >= n:
_fail(err, ErrorKind.UnexpectedEnd, "the inline table is not closed", i, "toml.unclosed_table")
else:
_fail(err, ErrorKind.Syntax, "expected '=' after the key", p, "toml.expected_equals")
end
endpos = p
ret out
end
p++
mut vend := p
v := _parse_value_d(s, n, p, vend, err, depth + 1)
if err.message != "":
endpos = vend
ret out
end
if not _put(out, path, 0, v, kstart, err):
endpos = vend
ret out
end
p = _skip_inline_ws(s, n, vend)
if p < n and _ub(bp, p) == 44:
p++
continue
end
if p < n and _ub(bp, p) == 125:
endpos = p + 1
ret out
end
if p >= n:
_fail(err, ErrorKind.UnexpectedEnd, "the inline table is not closed", i, "toml.unclosed_table")
else:
_fail(err, ErrorKind.Syntax, "expected ',' or '}' in the inline table", p, "toml.expected_comma")
end
endpos = p
ret out
end
end
func _open_table(root &: value.Value, path: Vector<str>, idx: int, is_array: bool, at: int, err &: Error): bool:
key := path.get(idx)
if idx < path.len() - 1:
mut child := value.NewValueObject()
if not _descend(root, path, idx, child, at, err): ret false end
mut item := _inner(child)
if not _open_table(item, path, idx + 1, is_array, at, err): ret false end
_store(root, key, child, item)
ret true
end
name := _dotted(path, path.len())
has := value.ObjectHas(root, key)
existing := value.ObjectGet(root, key)
if is_array:
mut arr := value.NewValueArray()
if has:
if not value.IsArray(existing):
_fail(err, ErrorKind.TypeMismatch, "'" + name + "' is " + _kind_name(existing) + ", not an array of tables", at, "toml.not_a_table")
ret false
end
arr = existing
end
value.ArrayPush(arr, value.NewValueObject())
value.ObjectSet(root, key, arr)
ret true
end
if not has:
value.ObjectSet(root, key, value.NewValueObject())
ret true
end
if not value.IsObject(existing):
_fail(err, ErrorKind.TypeMismatch, "'" + name + "' is " + _kind_name(existing) + ", not a table", at, "toml.not_a_table")
ret false
end
ret true
end
func _path_key(path: Vector<str>): str:
mut out := ""
mut i := 0
until i < path.len():
k := path.get(i)
out = out + conv.FormatInt(k.len() as i64) + ":" + k + ";"
i++
end
ret out
end
func _forget_below(defined &: HashMap<str, bool>, prefix: str):
mut drop := Vector {} as Vector<str>
each k, _ in defined:
if str.StartsWith(k, prefix): drop.push(k) end
end
each k in drop:
defined.remove(k)
end
drop.free()
end
func _read_header(root &: value.Value, s: str, n: int, start: int, defined &: HashMap<str, bool>, cur_path &: Vector<str>, err &: Error): int:
bp := _bp(s)
mut is_array := false
mut hstart := start + 1
if hstart < n and _ub(bp, hstart) == 91:
is_array = true
hstart++
end
mut hend := hstart
path := _parse_key_path(s, n, hstart, hend, err)
if err.message != "": ret n end
mut q := _skip_inline_ws(s, n, hend)
mut closed := q < n and _ub(bp, q) == 93
if is_array: closed = q + 1 < n and _ub(bp, q) == 93 and _ub(bp, q + 1) == 93 end
if not closed:
mut want := "']'"
if is_array: want = "']]'" end
if q >= n:
_fail(err, ErrorKind.UnexpectedEnd, "the table header is not closed", start, "toml.unclosed_header")
else:
_fail(err, ErrorKind.Syntax, "expected " + want + " to close the table header", q, "toml.unclosed_header")
end
ret n
end
q += is_array ? 2 : 1
if not _end_of_line(s, n, q, "the table header", err): ret n end
key := _path_key(path)
if is_array:
_forget_below(defined, key)
else:
if defined.has(key):
_fail(err, ErrorKind.AlreadyExists, "the table [" + _dotted(path, path.len()) + "] is defined twice", start, "toml.duplicate_table")
ret n
end
defined.put(key, true)
end
if not _open_table(root, path, 0, is_array, start, err): ret n end
cur_path = path
ret q
end
func _decode(text: str, err &: Error): value.Value:
mut root := value.NewValueObject()
n := text.len()
bp := _bp(text)
mut start := 0
if n >= 3 and _ub(bp, 0) == 0xEF and _ub(bp, 1) == 0xBB and _ub(bp, 2) == 0xBF: start = 3 end
mut p := _skip_loose(text, n, start)
mut cur_path := Vector {} as Vector<str>
mut defined := HashMap {} as HashMap<str, bool>
until p < n:
if _ub(bp, p) == 91:
q := _read_header(root, text, n, p, defined, cur_path, err)
if err.message != "": ret root end
p = _skip_loose(text, n, q)
continue
end
kstart := p
mut kend := p
keypath := _parse_key_path(text, n, p, kend, err)
if err.message != "": ret root end
mut q := _skip_inline_ws(text, n, kend)
if q >= n or _ub(bp, q) != 61:
if q >= n:
_fail(err, ErrorKind.UnexpectedEnd, "expected '=' after the key", q, "toml.expected_equals")
else:
_fail(err, ErrorKind.Syntax, "expected '=' after the key", q, "toml.expected_equals")
end
ret root
end
q++
mut vend := q
v := _parse_value_d(text, n, q, vend, err, 0)
if err.message != "": ret root end
if not _end_of_line(text, n, vend, "the value", err): ret root end
mut full := Vector {} as Vector<str>
each seg in cur_path:
full.push(seg)
end
each seg in keypath:
full.push(seg)
end
if not _put(root, full, 0, v, kstart, err): ret root end
p = _skip_loose(text, n, vend)
end
ret root
end
func _needs_quote_key(k: str): bool:
n := k.len()
if n == 0: ret true end
bp := _bp(k)
mut i := 0
until i < n:
if not _is_bare_key_char(_ub(bp, i)): ret true end
i++
end
ret false
end
func _hex_digit(d: int): int:
if d < 10: ret 48 + d end
ret 55 + d
end
func _escape_toml_string(s: str): str:
mut sb := str.NewBuilder()
defer str.BufFree(sb)
n := s.len()
bp := _bp(s)
mut i := 0
until i < n:
c := _ub(bp, i)
if c == 34: str.BufAppend(sb, `\"`)
else c == 92: str.BufAppend(sb, "\\\\")
else c == 10: str.BufAppend(sb, "\\n")
else c == 9: str.BufAppend(sb, "\\t")
else c == 13: str.BufAppend(sb, "\\r")
else c == 8: str.BufAppend(sb, "\\b")
else c == 12: str.BufAppend(sb, "\\f")
else c < 32 or c == 127:
str.BufAppend(sb, "\\u00")
str.BufAppendChar(sb, _hex_digit(c >> 4))
str.BufAppendChar(sb, _hex_digit(c & 15))
else:
str.BufAppendChar(sb, c)
end
i++
end
ret str.BufStr(sb)
end
func _encode_key(k: str): str:
if _needs_quote_key(k): ret `"`.concat(_escape_toml_string(k)).concat(`"`) end
ret k
end
func _join_key(prefix: str, k: str): str:
if prefix == "": ret k end
ret prefix + "." + k
end
func _encode_inline_value(v: value.Value, path: str, err &: Error): str:
if value.IsNull(v):
if err.message == "":
err = Error.New(ErrorKind.Unsupported, "TOML has no null value").with_code("toml.null").with_path(path)
end
ret ""
end
if value.IsBool(v):
if value.AsBool(v): ret "true" end
ret "false"
end
if value.IsInt(v): ret conv.FormatInt(value.AsInt(v)) end
if value.IsFloat(v):
f := conv.FormatFloat(value.AsFloat(v))
if str.Contains(f, ".") or str.Contains(f, "e") or str.Contains(f, "n"): ret f end
ret f.concat(".0")
end
if value.IsString(v): ret `"`.concat(_escape_toml_string(value.AsString(v))).concat(`"`) end
if value.IsBytes(v) or value.IsExt(v):
if err.message == "":
err = Error.New(ErrorKind.Unsupported, "TOML has no binary or extension value").with_code("toml.unsupported_value").with_path(path)
end
ret ""
end
if value.IsArray(v):
mut sb := str.NewBuilder()
str.BufAppendChar(sb, 91)
n := value.ArrayLen(v)
mut i := 0
until i < n:
if i > 0: str.BufAppend(sb, ", ") end
str.BufAppend(sb, _encode_inline_value(value.ArrayGet(v, i), path + "[" + conv.FormatInt(i as i64) + "]", err))
i++
end
str.BufAppendChar(sb, 93)
arr_out := str.BufStr(sb)
str.BufFree(sb)
ret arr_out
end
mut sb := str.NewBuilder()
str.BufAppendChar(sb, 123)
keys := value.ObjectKeys(v)
mut i := 0
until i < keys.len():
if i > 0: str.BufAppend(sb, ", ") end
k := keys.get(i)
str.BufAppend(sb, _encode_key(k))
str.BufAppend(sb, " = ")
str.BufAppend(sb, _encode_inline_value(value.ObjectGet(v, k), _join_key(path, k), err))
i++
end
str.BufAppendChar(sb, 125)
obj_out := str.BufStr(sb)
str.BufFree(sb)
ret obj_out
end
func _encode_table(sb &: str.StringBuilder, v: value.Value, prefix: Vector<str>, err &: Error):
keys := value.ObjectKeys(v)
here := _dotted(prefix, prefix.len())
mut sub_keys := Vector {} as Vector<str>
mut i := 0
until i < keys.len():
k := keys.get(i)
fv := value.ObjectGet(v, k)
if value.IsObject(fv):
sub_keys.push(k)
else value.IsNull(fv) == false:
str.BufAppend(sb, _encode_key(k))
str.BufAppend(sb, " = ")
str.BufAppend(sb, _encode_inline_value(fv, _join_key(here, k), err))
str.BufAppendChar(sb, 10)
end
i++
end
mut si := 0
until si < sub_keys.len():
k := sub_keys.get(si)
mut path := Vector {} as Vector<str>
mut pi := 0
until pi < prefix.len():
path.push(prefix.get(pi))
pi++
end
path.push(k)
str.BufAppendChar(sb, 91)
mut j := 0
until j < path.len():
if j > 0: str.BufAppendChar(sb, 46) end
str.BufAppend(sb, _encode_key(path.get(j)))
j++
end
str.BufAppendChar(sb, 93)
str.BufAppendChar(sb, 10)
_encode_table(sb, value.ObjectGet(v, k), path, err)
si++
end
end
@en "Decode"
@fa "کدگشایی"
pub func Decode(text: str): value.Value throws:
mut err := Error {}
v := _decode(text, err)
if err.message != "":
throw err.locate(text).wrap("toml")
end
ret v
end
@en "Valid"
@fa "معتبر"
pub func Valid(text: str): bool:
mut err := Error {}
_decode(text, err)
ret err.message == ""
end
@en "Encode"
@fa "کدگذاری"
pub func Encode(v: value.Value): str throws:
if not value.IsObject(v):
throw Error.New(ErrorKind.Unsupported, "the top level must be an object, since a TOML document is a table, not " + _kind_name(v)).with_code("toml.not_a_table").wrap("toml")
end
mut err := Error {}
mut sb := str.NewBuilder()
prefix := Vector {} as Vector<str>
_encode_table(sb, v, prefix, err)
out := str.BufStr(sb)
str.BufFree(sb)
if err.message != "":
throw err.wrap("toml")
end
ret out
end
@en "url"
@fa "نشانی وب"
package url
import mem
import str
import encoding
import encoding.query
@en "URL"
@fa "نشانی وب"
pub struct URL:
@en "scheme"
@fa "طرح"
pub scheme: str = ""
@en "userinfo"
@fa "اطلاعات کاربر"
pub userinfo: str = ""
@en "host"
@fa "میزبان"
pub host: str = ""
@en "port"
@fa "درگاه"
pub port: int = 0
@en "path"
@fa "مسیر"
pub path: str = ""
@en "raw_query"
@fa "پرس‌وجوی خام"
pub raw_query: str = ""
@en "fragment"
@fa "قطعه"
pub fragment: str = ""
end
inline pure func _bp(s: str): i8*: ret (s as void*) as i8* end
inline pure func _ub(bp: i8*, i: int): int:
mut v := bp[i] as int
if v < 0: v += 256 end
ret v
end
func _hexdigit(v: int): int:
if v >= 0 and v <= 9: ret 48 + v end
ret 65 + (v - 10)
end
func _hexval(c: int): int:
if c >= 48 and c <= 57: ret c - 48 end
if c >= 65 and c <= 70: ret c - 65 + 10 end
if c >= 97 and c <= 102: ret c - 97 + 10 end
ret 0 - 1
end
func _path_seg_safe(code: int): bool:
if code >= 65 and code <= 90: ret true end
if code >= 97 and code <= 122: ret true end
if code >= 48 and code <= 57: ret true end
if code == 45 or code == 95 or code == 46 or code == 126: ret true end
if code == 58 or code == 64: ret true end
if code == 33 or code == 36 or code == 38 or code == 39: ret true end
if code == 40 or code == 41 or code == 42 or code == 43: ret true end
if code == 44 or code == 59 or code == 61: ret true end
ret false
end
func _url_err(text: str, kind: ErrorKind, message: str, offset: int): Error:
ret Error.At(kind, message, offset).locate(text).wrap("url")
end
func _byte_desc(code: int): str:
mut sb := str.NewBuilder()
defer str.BufFree(sb)
if code == 32:
str.BufAppend(sb, "space")
else code > 32 and code < 127:
str.BufAppend(sb, "character ")
str.BufAppendChar(sb, 39)
str.BufAppendChar(sb, code)
str.BufAppendChar(sb, 39)
else:
str.BufAppend(sb, "byte 0x")
str.BufAppendChar(sb, _hexdigit(code / 16))
str.BufAppendChar(sb, _hexdigit(code % 16))
end
ret str.BufStr(sb)
end
func _pct_decode_no_plus(s: str): str throws:
n := s.len()
bp := _bp(s)
mut sb := str.NewBuilder()
defer str.BufFree(sb)
mut i := 0
until i < n:
code := _ub(bp, i)
if code == 37:
try _check_escape(s, i, n)
str.BufAppendChar(sb, _hexval(_ub(bp, i + 1)) * 16 + _hexval(_ub(bp, i + 2)))
i += 3
else:
str.BufAppendChar(sb, code)
i++
end
end
ret str.BufStr(sb)
end
func _check_escape(raw: str, i: int, stop: int) throws:
bp := _bp(raw)
if i + 1 < stop and _hexval(_ub(bp, i + 1)) < 0:
throw _url_err(raw, ErrorKind.Syntax, "malformed percent escape", i)
end
if i + 2 < stop and _hexval(_ub(bp, i + 2)) < 0:
throw _url_err(raw, ErrorKind.Syntax, "malformed percent escape", i)
end
if i + 2 >= stop:
throw _url_err(raw, ErrorKind.UnexpectedEnd, "incomplete percent escape", i)
end
end
func _check_escapes(raw: str, from: int, stop: int) throws:
bp := _bp(raw)
mut i := from
until i < stop:
if _ub(bp, i) == 37:
try _check_escape(raw, i, stop)
i += 3
else:
i++
end
end
end
func _is_alpha(code: int): bool:
ret (code >= 65 and code <= 90) or (code >= 97 and code <= 122)
end
func _is_digit(code: int): bool:
ret code >= 48 and code <= 57
end
func _sub_delim(code: int): bool:
ret code == 33 or code == 36 or code == 38 or code == 39 or code == 40 or code == 41 or code == 42 or code == 43 or code == 44 or code == 59 or code == 61
end
func _name_char(code: int): bool:
if _is_alpha(code) or _is_digit(code) or code >= 128: ret true end
if code == 45 or code == 46 or code == 95 or code == 126 or code == 37: ret true end
ret _sub_delim(code)
end
func _check_scheme(raw: str, stop: int) throws:
if stop == 0:
throw _url_err(raw, ErrorKind.Syntax, "missing scheme before '://'", 0)
end
bp := _bp(raw)
repeat stop in i:
code := _ub(bp, i)
mut good := _is_alpha(code)
if i > 0 and (_is_digit(code) or code == 43 or code == 45 or code == 46): good = true end
if not good:
throw _url_err(raw, ErrorKind.Syntax, "invalid " + _byte_desc(code) + " in scheme", i)
end
end
end
func _check_name(raw: str, from: int, stop: int, what: str, allow_colon: bool) throws:
bp := _bp(raw)
mut i := from
until i < stop:
code := _ub(bp, i)
if not _name_char(code) and not (allow_colon and code == 58):
throw _url_err(raw, ErrorKind.Syntax, "invalid " + _byte_desc(code) + " in " + what, i)
end
i++
end
try _check_escapes(raw, from, stop)
end
func _parse_port(raw: str, from: int, stop: int): int throws:
bp := _bp(raw)
mut port := 0
mut i := from
until i < stop:
code := _ub(bp, i)
if not _is_digit(code):
throw _url_err(raw, ErrorKind.Syntax, "invalid " + _byte_desc(code) + " in port", i)
end
port = port * 10 + (code - 48)
if port > 65535:
throw _url_err(raw, ErrorKind.OutOfRange, "port is larger than 65535", from)
end
i++
end
ret port
end
func _index_from(raw: str, code: int, from: int, stop: int): int:
bp := _bp(raw)
mut i := from
until i < stop:
if _ub(bp, i) == code: ret i end
i++
end
ret 0 - 1
end
func _parse_authority(raw: str, from: int, stop: int, u &: URL) throws:
bp := _bp(raw)
mut hs := from
mut at := 0 - 1
mut i := from
until i < stop:
if _ub(bp, i) == 64: at = i end
i++
end
if at >= 0:
try _check_name(raw, from, at, "userinfo", true)
u.userinfo = raw.substr(from, at - from)
hs = at + 1
end
mut port_at := 0 - 1
if hs < stop and _ub(bp, hs) == 91:
close := _index_from(raw, 93, hs, stop)
if close < 0:
throw _url_err(raw, ErrorKind.Syntax, "missing ']' after the IPv6 address", hs)
end
if close == hs + 1:
throw _url_err(raw, ErrorKind.Syntax, "empty IPv6 address", hs)
end
mut j := hs + 1
until j < close:
code := _ub(bp, j)
if _hexval(code) < 0 and code != 58 and code != 46:
throw _url_err(raw, ErrorKind.Syntax, "invalid " + _byte_desc(code) + " in IPv6 address", j)
end
j++
end
u.host = raw.substr(hs + 1, close - hs - 1)
if close + 1 < stop:
if _ub(bp, close + 1) != 58:
throw _url_err(raw, ErrorKind.Syntax, "unexpected " + _byte_desc(_ub(bp, close + 1)) + " after the IPv6 address", close + 1)
end
port_at = close + 1
end
else:
port_at = _index_from(raw, 58, hs, stop)
mut he := stop
if port_at >= 0: he = port_at end
try _check_name(raw, hs, he, "host", false)
u.host = raw.substr(hs, he - hs)
end
if port_at >= 0:
u.port = try _parse_port(raw, port_at + 1, stop)
end
end
func _remove_dots(p: str): str:
if p.find("/.") < 0 and not p.starts_with("."):
ret p
end
parts := p.split("/")
defer parts.free()
mut out := Vector {} as Vector<str>
defer out.free()
n := parts.len()
repeat n in i:
seg := parts.get(i)
if seg == ".":
if i == n - 1: out.push("") end
else seg == "..":
if out.len() > 1: _ := out.pop() end
if i == n - 1: out.push("") end
else:
out.push(seg)
end
end
mut r := ""
repeat out.len() in j:
if j > 0: r += "/" end
r += out.get(j)
end
if p.starts_with("/") and not r.starts_with("/"): r = "/" + r end
ret r
end
func _path_dir(p: str): str:
mut slash := 0 - 1
mut i := p.len() - 1
until i >= 0:
if p.substr(i, 1) == "/":
slash = i
i = 0 - 1
else:
i--
end
end
if slash < 0: ret "" end
ret p.substr(0, slash + 1)
end
@en "Parse"
@fa "تجزیه نشانی"
pub func Parse(raw: str): URL throws:
n := raw.len()
if n == 0:
throw _url_err(raw, ErrorKind.InvalidArgument, "empty URL", 0)
end
bp := _bp(raw)
repeat n in i:
code := _ub(bp, i)
if code <= 32 or code == 127:
throw _url_err(raw, ErrorKind.Syntax, "invalid " + _byte_desc(code), i)
end
end
mut u := URL {}
mut stop := n
hash := _index_from(raw, 35, 0, n)
if hash >= 0:
try _check_escapes(raw, hash + 1, n)
u.fragment = raw.substr(hash + 1, n - hash - 1)
stop = hash
end
q := _index_from(raw, 63, 0, stop)
if q >= 0:
try _check_escapes(raw, q + 1, stop)
u.raw_query = raw.substr(q + 1, stop - q - 1)
stop = q
end
mut pos := 0
mut has_authority := false
before_stop := raw.substr(0, stop)
scheme_end := before_stop.find("://")
mem.Free(before_stop as void*)
if scheme_end >= 0 and _index_from(raw, 47, 0, scheme_end) < 0:
try _check_scheme(raw, scheme_end)
u.scheme = raw.substr(0, scheme_end)
pos = scheme_end + 3
has_authority = true
else stop >= 2 and _ub(bp, 0) == 47 and _ub(bp, 1) == 47:
pos = 2
has_authority = true
end
if has_authority:
mut aend := _index_from(raw, 47, pos, stop)
if aend < 0: aend = stop end
try _parse_authority(raw, pos, aend, u)
if u.host == "" and str.Lower(u.scheme) != "file":
throw _url_err(raw, ErrorKind.Syntax, "missing host", pos)
end
pos = aend
end
try _check_escapes(raw, pos, stop)
u.path = raw.substr(pos, stop - pos)
ret u
end
@en "HostPort"
@fa "میزبان با درگاه"
pub func HostPort(u: URL): str:
mut h := u.host
if h.find(":") >= 0:
h = "[" + h + "]"
end
if u.port != 0:
ret h + ":" + str.FromInt(u.port as i64)
end
ret h
end
@en "String"
@fa "متن"
pub func String(u: URL): str:
mut out := ""
mut has_authority := u.host.len() > 0
if u.scheme.len() > 0:
out += u.scheme + "://"
has_authority = true
else has_authority:
out += "//"
end
if has_authority:
if u.userinfo.len() > 0:
out += u.userinfo + "@"
end
out += HostPort(u)
end
out += u.path
if u.raw_query.len() > 0:
out += "?" + u.raw_query
end
if u.fragment.len() > 0:
out += "#" + u.fragment
end
ret out
end
@en "DecodedPath"
@fa "مسیر کدگشایی‌شده"
pub func DecodedPath(u: URL): str throws:
ret try _pct_decode_no_plus(u.path)
end
@en "DecodedUserinfo"
@fa "اطلاعات کاربر کدگشایی‌شده"
pub func DecodedUserinfo(u: URL): str throws:
ret try _pct_decode_no_plus(u.userinfo)
end
@en "EncodePathSegment"
@fa "کدگذاری بخش مسیر"
pub func EncodePathSegment(s: str): str:
n := s.len()
bp := _bp(s)
mut sb := str.NewBuilder()
defer str.BufFree(sb)
mut i := 0
until i < n:
code := _ub(bp, i)
if _path_seg_safe(code):
str.BufAppendChar(sb, code)
else:
str.BufAppendChar(sb, 37)
str.BufAppendChar(sb, _hexdigit(code / 16))
str.BufAppendChar(sb, _hexdigit(code % 16))
end
i++
end
ret str.BufStr(sb)
end
@en "Query"
@fa "پرس‌وجو"
pub func Query(u: URL): query.QueryMap throws:
ret try query.Decode(u.raw_query)
end
@en "SetQuery"
@fa "تنظیم پرس‌وجو"
pub func SetQuery(u &: URL, q: query.QueryMap):
u.raw_query = query.Encode(q)
end
@en "Join"
@fa "پیوستن نشانی"
pub func Join(base: URL, ref: str): URL throws:
if ref.len() == 0: ret base end
r := try Parse(ref)
if r.scheme.len() > 0: ret r end
if r.host.len() > 0:
mut out := r
out.scheme = base.scheme
ret out
end
mut u := base
u.fragment = r.fragment
if r.path.len() == 0:
if ref.starts_with("?"): u.raw_query = r.raw_query end
ret u
end
u.raw_query = r.raw_query
if r.path.starts_with("/"):
u.path = _remove_dots(r.path)
else:
mut dir := _path_dir(base.path)
if dir == "" and base.host.len() > 0: dir = "/" end
u.path = _remove_dots(dir + r.path)
end
ret u
end
package url
import str
import encoding.query
const _SUFFIX2 := " co.uk ac.uk gov.uk org.uk net.uk sch.uk ltd.uk plc.uk me.uk com.au net.au org.au edu.au gov.au id.au co.nz net.nz org.nz govt.nz ac.nz co.za org.za web.za com.br net.br org.br gov.br edu.br com.cn net.cn org.cn gov.cn edu.cn com.mx org.mx net.mx com.ar net.ar org.ar com.tr net.tr org.tr gov.tr co.jp ne.jp or.jp ac.jp go.jp co.kr or.kr ne.kr go.kr co.in net.in org.in gov.in ac.in com.sg com.hk org.hk com.tw com.my org.my com.ph com.vn co.il org.il com.pk com.eg com.sa com.ua co.id or.id com.ng com.gh co.ke co.th in.th com.pe com.co com.ec com.uy com.py com.bo com.ve "
func _is_suffix2(s: str): bool:
ret str.Contains(_SUFFIX2, " ".concat(s).concat(" "))
end
func _all_digits(s: str): bool:
if s.len() == 0: ret false end
bp := _bp(s)
repeat s.len() in i:
if str.IsAsciiDigit(_ub(bp, i)) == false: ret false end
end
ret true
end
func _join_range(labels: Vector<str>, start: int, endx: int): str:
mut out := ""
mut i := start
until i < endx:
if i > start: out = out.concat(".") end
out = out.concat(labels.get(i))
i++
end
ret out
end
func _suffix_len(labels: Vector<str>): int:
n := labels.len()
if n >= 3:
last2 := labels.get(n - 2).concat(".").concat(labels.get(n - 1))
if _is_suffix2(last2): ret 2 end
end
ret 1
end
func _rebuild_query(u &: URL, q: query.QueryMap):
u.raw_query = query.Encode(q)
end
@en "Hostname"
@fa "نام میزبان"
pub func Hostname(u: URL): str:
ret u.host
end
@en "IsIP"
@fa "نشانی عددی است"
pub func IsIP(u: URL): bool:
if u.host.len() == 0: ret false end
if u.host.find(":") >= 0: ret true end
parts := u.host.split(".")
defer parts.free()
if parts.len() != 4: ret false end
mut ok := true
repeat parts.len() in i:
if _all_digits(parts.get(i)) == false: ok = false end
end
ret ok
end
@en "Labels"
@fa "برچسب‌های میزبان"
pub func Labels(u: URL): Vector<str>:
ret u.host.split(".")
end
@en "PublicSuffix"
@fa "پسوند عمومی"
pub func PublicSuffix(u: URL): str:
if IsIP(u): ret "" end
labels := u.host.split(".")
defer labels.free()
n := labels.len()
if n < 2: ret "" end
ret _join_range(labels, n - _suffix_len(labels), n)
end
@en "Domain"
@fa "دامنه"
pub func Domain(u: URL): str:
if IsIP(u): ret u.host end
labels := u.host.split(".")
defer labels.free()
n := labels.len()
if n < 2: ret u.host end
take := _suffix_len(labels) + 1
if n <= take: ret u.host end
ret _join_range(labels, n - take, n)
end
@en "Subdomain"
@fa "زیردامنه"
pub func Subdomain(u: URL): str:
if IsIP(u): ret "" end
labels := u.host.split(".")
defer labels.free()
n := labels.len()
take := _suffix_len(labels) + 1
if n <= take: ret "" end
ret _join_range(labels, 0, n - take)
end
@en "RemoveParam"
@fa "حذف پارامتر"
pub func RemoveParam(u &: URL, key: str): bool throws:
mut q := try query.Decode(u.raw_query)
ok := query.Remove(q, key)
_rebuild_query(u, q)
ret ok
end
@en "SetParam"
@fa "تنظیم پارامتر"
pub func SetParam(u &: URL, key: str, val: str) throws:
mut q := try query.Decode(u.raw_query)
query.Set(q, key, val)
_rebuild_query(u, q)
end
@en "KeepParams"
@fa "نگه داشتن پارامترها"
pub func KeepParams(u &: URL, keep: Vector<str>) throws:
mut q := try query.Decode(u.raw_query)
query.Retain(q, keep)
_rebuild_query(u, q)
end
@en "ClearQuery"
@fa "پاک کردن پرس‌وجو"
pub func ClearQuery(u &: URL):
u.raw_query = ""
end
@en "ParamNames"
@fa "نام پارامترها"
pub func ParamNames(u: URL): Vector<str> throws:
q := try query.Decode(u.raw_query)
ret query.Keys(q)
end
package value
import conv
@en "ToDebugString"
@fa "رشته اشکال زدایی"
pub func ToDebugString(v: Value): str:
if v.kind == KindNull: ret "null" end
if v.kind == KindBool:
if v.b: ret "bool(true)" end
ret "bool(false)"
end
if v.kind == KindInt: ret "int(" + conv.FormatInt(v.i) + ")" end
if v.kind == KindFloat:
if SALAM_KERNEL:
ret "float(?)"
else:
ret "float(" + conv.FormatFloat(v.n) + ")"
end
end
if v.kind == KindString: ret "string(" + v.s + ")" end
if v.kind == KindBytes: ret "bytes(" + conv.FormatInt(v.bin.len() as i64) + ")" end
if v.kind == KindExt: ret "ext(" + conv.FormatInt(v.i) + ", " + conv.FormatInt(v.bin.len() as i64) + ")" end
if v.kind == KindArray:
mut out := "array["
mut i := 0
until i < v.arr.len():
if i > 0: out += ", " end
out += ToDebugString(v.arr.get(i))
i++
end
ret out + "]"
end
if v.kind == KindObject:
mut out := "object{"
keys := ObjectKeys(v)
repeat keys.len() in i:
if i > 0: out += ", " end
k := keys.get(i)
out = out + k + ": " + ToDebugString(v.obj.get(k))
end
ret out + "}"
end
ret "?"
end
package value
func _bin_equal(a: Vector<u8>, b: Vector<u8>): bool:
if a.len() != b.len(): ret false end
mut i := 0
until i < a.len():
if a.get(i) != b.get(i): ret false end
i++
end
ret true
end
@en "Equal"
@fa "یکسان است"
pub func Equal(a: Value, b: Value): bool:
if a.kind != b.kind: ret false end
if a.kind == KindNull: ret true end
if a.kind == KindBool: ret a.b == b.b end
if a.kind == KindInt: ret a.i == b.i end
if a.kind == KindFloat: ret a.n == b.n end
if a.kind == KindString: ret a.s == b.s end
if a.kind == KindBytes: ret _bin_equal(a.bin, b.bin) end
if a.kind == KindExt: ret a.i == b.i and _bin_equal(a.bin, b.bin) end
if a.kind == KindArray:
if a.arr.len() != b.arr.len(): ret false end
mut i := 0
until i < a.arr.len():
if not Equal(a.arr.get(i), b.arr.get(i)): ret false end
i++
end
ret true
end
if a.kind == KindObject:
if a.obj.size() != b.obj.size(): ret false end
mut it := a.obj.iter()
until it.has_next():
k := it.key()
if not b.obj.has(k): ret false end
if not Equal(it.value(), b.obj.get(k)): ret false end
it.next()
end
ret true
end
ret false
end
@en "value"
@fa "مقدار"
package value
import compress
import mem
@en "KindNull"
@fa "نوع تهی"
pub const KindNull := 0
@en "KindBool"
@fa "نوع منطقی"
pub const KindBool := 1
@en "KindInt"
@fa "نوع صحیح"
pub const KindInt := 2
@en "KindFloat"
@fa "نوع اعشاری"
pub const KindFloat := 3
@en "KindString"
@fa "نوع رشته"
pub const KindString := 4
@en "KindArray"
@fa "نوع آرایه"
pub const KindArray := 5
@en "KindObject"
@fa "نوع شیء"
pub const KindObject := 6
@en "KindBytes"
@fa "نوع بایت‌ها"
pub const KindBytes := 7
@en "KindExt"
@fa "نوع داده افزونه"
pub const KindExt := 8
@en "Value"
@fa "مقدار"
pub struct Value:
@en "kind"
@fa "نوع"
pub kind: int = KindNull
@en "b"
@fa "مقدار منطقی"
pub b: bool = false
@en "i"
@fa "مقدار صحیح"
pub i: i64 = 0
@en "n"
@fa "مقدار اعشاری"
pub n: f64 = 0.0
@en "s"
@fa "مقدار رشته"
pub s: str = ""
@en "arr"
@fa "عضوهای آرایه"
pub arr: Vector<Value> = Vector {}
@en "obj"
@fa "عضوهای شیء"
pub obj: HashMap<str, Value> = HashMap {} as HashMap<str, Value>
@en "order"
@fa "ترتیب کلیدها"
pub order: i64 = 0
@en "bin"
@fa "بایت‌ها"
pub bin: Vector<u8> = Vector {} as Vector<u8>
@en "field"
@fa "عضو"
pub func field(key: str): Value throws:
if this.kind != KindObject:
throw Error.New(ErrorKind.TypeMismatch, "cannot read key '" + key + "': expected an object, got " + _kind_text(this.kind))
end
if not this.obj.has(key):
throw Error.New(ErrorKind.MissingKey, "missing key '" + key + "'")
end
ret this.obj.get(key)
end
@en "at"
@fa "عنصر"
pub func at(index: int): Value throws:
if this.kind != KindArray:
throw Error.New(ErrorKind.TypeMismatch, "cannot read index " + index + ": expected an array, got " + _kind_text(this.kind))
end
if index < 0 or index >= this.arr.len():
throw Error.New(ErrorKind.OutOfRange, "index " + index + " is out of range for an array of " + this.arr.len())
end
ret this.arr.get(index)
end
@en "int"
@fa "عدد صحیح"
pub func int(): i64 throws:
if this.kind == KindInt:
ret this.i
end
if this.kind == KindFloat and (this.n as i64) as f64 == this.n:
ret this.n as i64
end
throw Error.New(ErrorKind.TypeMismatch, "expected an integer, got " + _kind_text(this.kind))
end
@en "float"
@fa "عدد اعشاری"
pub func float(): f64 throws:
if this.kind == KindFloat:
ret this.n
end
if this.kind == KindInt:
ret this.i as f64
end
throw Error.New(ErrorKind.TypeMismatch, "expected a number, got " + _kind_text(this.kind))
end
@en "str"
@fa "متن"
pub func str(): str throws:
if this.kind != KindString:
throw Error.New(ErrorKind.TypeMismatch, "expected a string, got " + _kind_text(this.kind))
end
ret this.s
end
@en "bool"
@fa "درستی"
pub func bool(): bool throws:
if this.kind != KindBool:
throw Error.New(ErrorKind.TypeMismatch, "expected a boolean, got " + _kind_text(this.kind))
end
ret this.b
end
end
func _kind_text(kind: int): str:
switch kind:
KindNull:
ret "null"
end
KindBool:
ret "a boolean"
end
KindInt:
ret "an integer"
end
KindFloat:
ret "a number"
end
KindString:
ret "a string"
end
KindArray:
ret "an array"
end
KindBytes:
ret "binary data"
end
KindExt:
ret "an extension value"
end
end
ret "an object"
end
func _ord_new(): i64:
h := mem.AllocateZeroed(24 as u64) as i64 *
h[1] = 4 as i64
h[2] = mem.Allocate(32 as u64) as i64
ret h as i64
end
func _ord_len(o: i64): int:
if o == (0 as i64): ret 0 end
ret (o as i64 *)[0] as int
end
func _ord_at(o: i64, i: int): str:
h := o as i64 *
ret (((h[2] + (i as i64) * (8 as i64)) as i64 *)[0] as void *) as str
end
func _ord_push(o: i64, key: str):
if o == (0 as i64): ret end
h := o as i64 *
if h[0] == h[1]:
h[1] *= (2 as i64)
h[2] = mem.Reallocate(h[2] as void *, (h[1] * (8 as i64)) as u64) as i64
end
slot := (h[2] + h[0] * (8 as i64)) as i64 *
slot[0] = (key as void *) as i64
h[0]++
end
func _ord_remove(o: i64, key: str):
n := _ord_len(o)
h := o as i64 *
repeat n in i:
if _ord_at(o, i) == key:
mut j := i
until j + 1 < n:
dst := (h[2] + (j as i64) * (8 as i64)) as i64 *
src := (h[2] + ((j + 1) as i64) * (8 as i64)) as i64 *
dst[0] = src[0]
j++
end
h[0]--
ret
end
end
end
func _ord_free(o: i64):
if o == (0 as i64): ret end
h := o as i64 *
mem.Free(h[2] as void *)
mem.Free(o as void *)
end
func _fill_bin(p: void*, n: int): Vector<u8>:
mut out := Vector {} as Vector<u8>
bp := p as u8*
mut i := 0
until i < n:
out.push(bp[i])
i++
end
ret out
end
func _fill_bin_str(s: str): Vector<u8>:
ret _fill_bin(s as void*, s.len())
end
@en "ValueNull"
@fa "مقدار تهی"
pub func ValueNull(): Value: ret Value { kind = KindNull } end
@en "ValueBool"
@fa "مقدار منطقی"
pub func ValueBool(b: bool): Value: ret Value { kind = KindBool, b = b } end
@en "ValueInt"
@fa "مقدار صحیح"
pub func ValueInt(i: i64): Value: ret Value { kind = KindInt, i = i } end
@en "ValueFloat"
@fa "مقدار اعشاری"
pub func ValueFloat(n: f64): Value: ret Value { kind = KindFloat, n = n } end
@en "ValueString"
@fa "مقدار رشته"
pub func ValueString(s: str): Value: ret Value { kind = KindString, s = s } end
@en "ValueBinary"
@fa "مقدار دودویی"
pub func ValueBinary(p: void*, n: int): Value:
mut v := Value { kind = KindBytes }
v.bin = _fill_bin(p, n)
ret v
end
@en "ValueBinaryStr"
@fa "مقدار دودویی رشته"
pub func ValueBinaryStr(s: str): Value:
mut v := Value { kind = KindBytes }
v.bin = _fill_bin_str(s)
ret v
end
@en "ValueExt"
@fa "مقدار افزونه"
pub func ValueExt(typeId: int, p: void*, n: int): Value:
mut v := Value { kind = KindExt, i = typeId as i64 }
v.bin = _fill_bin(p, n)
ret v
end
@en "ValueExtStr"
@fa "مقدار افزونه رشته"
pub func ValueExtStr(typeId: int, s: str): Value:
mut v := Value { kind = KindExt, i = typeId as i64 }
v.bin = _fill_bin_str(s)
ret v
end
@en "ValueArray"
@fa "مقدار آرایه"
pub func ValueArray(items: Vector<Value>): Value:
mut v := Value { kind = KindArray }
v.arr = items
ret v
end
@en "ValueObject"
@fa "مقدار شیء"
pub func ValueObject(fields: HashMap<str, Value>): Value:
mut v := Value { kind = KindObject, order = _ord_new() }
v.obj = fields
mut it := fields.iter()
until it.has_next():
_ord_push(v.order, it.key())
it.next()
end
ret v
end
@en "NewValueArray"
@fa "آرایه جدید"
pub func NewValueArray(): Value:
ret Value { kind = KindArray, arr = Vector {} as Vector<Value> }
end
@en "NewValueObject"
@fa "شیء جدید"
pub func NewValueObject(): Value:
ret Value { kind = KindObject, obj = HashMap {} as HashMap<str, Value>, order = _ord_new() }
end
@en "IsNull"
@fa "تهی است"
pub func IsNull(v: Value): bool: ret v.kind == KindNull end
@en "IsBool"
@fa "منطقی است"
pub func IsBool(v: Value): bool: ret v.kind == KindBool end
@en "IsInt"
@fa "صحیح است"
pub func IsInt(v: Value): bool: ret v.kind == KindInt end
@en "IsFloat"
@fa "اعشاری است"
pub func IsFloat(v: Value): bool: ret v.kind == KindFloat end
@en "IsNumber"
@fa "عدد است"
pub func IsNumber(v: Value): bool: ret v.kind == KindInt or v.kind == KindFloat end
@en "IsString"
@fa "رشته است"
pub func IsString(v: Value): bool: ret v.kind == KindString end
@en "IsArray"
@fa "آرایه است"
pub func IsArray(v: Value): bool: ret v.kind == KindArray end
@en "IsObject"
@fa "شیء است"
pub func IsObject(v: Value): bool: ret v.kind == KindObject end
@en "IsBytes"
@fa "بایتی است"
pub func IsBytes(v: Value): bool: ret v.kind == KindBytes end
@en "IsExt"
@fa "افزونه است"
pub func IsExt(v: Value): bool: ret v.kind == KindExt end
@en "BytesLen"
@fa "طول بایت‌ها"
pub func BytesLen(v: Value): int: ret v.bin.len() end
@en "BytesGet"
@fa "بایت"
pub func BytesGet(v: Value, i: int): int:
if i < 0 or i >= v.bin.len(): ret 0 end
ret v.bin.get(i) as int
end
@en "BytesToBuf"
@fa "بایت‌ها به بافر"
pub func BytesToBuf(v: Value): compress.ByteBuf:
mut out := compress.NewByteBufCap(v.bin.len())
mut i := 0
until i < v.bin.len():
compress.BufPush(out, v.bin.get(i) as int)
i++
end
ret out
end
@en "BytesToStr"
@fa "بایت‌ها به رشته"
pub func BytesToStr(v: Value): str:
mut b := BytesToBuf(v)
defer compress.BufFree(b)
ret compress.BufToStrUnsafe(b)
end
@en "ExtType"
@fa "نوع افزونه"
pub func ExtType(v: Value): int: ret v.i as int end
@en "ExtDataLen"
@fa "طول داده افزونه"
pub func ExtDataLen(v: Value): int: ret v.bin.len() end
@en "ExtDataGet"
@fa "داده افزونه"
pub func ExtDataGet(v: Value, i: int): int:
if i < 0 or i >= v.bin.len(): ret 0 end
ret v.bin.get(i) as int
end
@en "ExtDataToBuf"
@fa "داده افزونه به بافر"
pub func ExtDataToBuf(v: Value): compress.ByteBuf:
mut out := compress.NewByteBufCap(v.bin.len())
mut i := 0
until i < v.bin.len():
compress.BufPush(out, v.bin.get(i) as int)
i++
end
ret out
end
@en "ExtDataToStr"
@fa "داده افزونه به رشته"
pub func ExtDataToStr(v: Value): str:
mut b := ExtDataToBuf(v)
defer compress.BufFree(b)
ret compress.BufToStrUnsafe(b)
end
@en "AsBool"
@fa "به منطقی"
pub func AsBool(v: Value): bool: ret v.b end
@en "AsInt"
@fa "به صحیح"
pub func AsInt(v: Value): i64:
if v.kind == KindFloat: ret v.n as i64 end
ret v.i
end
@en "AsFloat"
@fa "به اعشاری"
pub func AsFloat(v: Value): f64:
if v.kind == KindInt: ret v.i as f64 end
ret v.n
end
@en "AsString"
@fa "به رشته"
pub func AsString(v: Value): str: ret v.s end
@en "ArrayLen"
@fa "طول آرایه"
pub func ArrayLen(v: Value): int: ret v.arr.len() end
@en "ArrayGet"
@fa "عضو آرایه"
pub func ArrayGet(v: Value, i: int): Value: ret v.arr.get(i) end
@en "ArraySet"
@fa "تنظیم عضو آرایه"
pub func ArraySet(v &: Value, i: int, item: Value): v.arr.set(i, item) end
@en "ArrayPush"
@fa "افزودن به آرایه"
pub func ArrayPush(v &: Value, item: Value): v.arr.push(item) end
@en "ObjectLen"
@fa "طول شیء"
pub func ObjectLen(v: Value): int: ret v.obj.size() end
@en "ObjectHas"
@fa "شیء دارد"
pub func ObjectHas(v: Value, key: str): bool: ret v.obj.has(key) end
@en "ObjectGet"
@fa "مقدار کلید"
pub func ObjectGet(v: Value, key: str): Value:
if v.obj.has(key): ret v.obj.get(key) end
ret ValueNull()
end
@en "ObjectGetOk"
@fa "مقدار کلید با وضعیت"
pub func ObjectGetOk(v: Value, key: str, ok &: bool): Value:
ok = v.obj.has(key)
if ok: ret v.obj.get(key) end
ret ValueNull()
end
@en "ObjectSet"
@fa "تنظیم کلید"
pub func ObjectSet(v &: Value, key: str, item: Value):
if not v.obj.has(key): _ord_push(v.order, key) end
v.obj.put(key, item)
end
@en "ObjectDelete"
@fa "حذف کلید"
pub func ObjectDelete(v &: Value, key: str): bool:
if not v.obj.remove(key): ret false end
_ord_remove(v.order, key)
ret true
end
@en "ObjectKeys"
@fa "کلیدهای شیء"
pub func ObjectKeys(v: Value): Vector<str>:
mut out := Vector {} as Vector<str>
mut seen := HashMap {} as HashMap<str, bool>
repeat _ord_len(v.order) in i:
k := _ord_at(v.order, i)
if v.obj.has(k) and not seen.has(k):
out.push(k)
seen.put(k, true)
end
end
mut it := v.obj.iter()
until it.has_next():
k := it.key()
if not seen.has(k):
out.push(k)
end
it.next()
end
seen.free()
ret out
end
@en "ValueClone"
@fa "رونوشت مقدار"
pub func ValueClone(v: Value): Value:
if v.kind == KindBytes or v.kind == KindExt:
mut out := v
out.bin = Vector {} as Vector<u8>
mut bi := 0
until bi < v.bin.len():
out.bin.push(v.bin.get(bi))
bi++
end
ret out
end
if v.kind == KindArray:
mut out := Vector {} as Vector<Value>
mut i := 0
until i < v.arr.len():
out.push(ValueClone(v.arr.get(i)))
i++
end
ret ValueArray(out)
end
if v.kind == KindObject:
mut out := NewValueObject()
keys := ObjectKeys(v)
repeat keys.len() in i:
k := keys.get(i)
ObjectSet(out, k, ValueClone(v.obj.get(k)))
end
ret out
end
ret v
end
@en "ValueFree"
@fa "آزادسازی مقدار"
pub func ValueFree(v &: Value):
if v.kind == KindBytes or v.kind == KindExt:
v.bin.free()
ret
end
if v.kind == KindArray:
mut i := 0
until i < v.arr.len():
mut child := v.arr.get(i)
ValueFree(child)
i++
end
v.arr.free()
else v.kind == KindObject:
mut it := v.obj.iter()
until it.has_next():
mut child := it.value()
ValueFree(child)
it.next()
end
v.obj.free()
_ord_free(v.order)
v.order = 0 as i64
end
end
package xml
@en "KindDocument"
@fa "نوع سند"
pub const KindDocument := 0
@en "KindElement"
@fa "نوع عنصر"
pub const KindElement := 1
@en "KindText"
@fa "نوع متن"
pub const KindText := 2
@en "KindCData"
@fa "نوع سی‌دیتا"
pub const KindCData := 3
@en "KindComment"
@fa "نوع توضیح"
pub const KindComment := 4
@en "KindProcessingInstruction"
@fa "نوع دستور پردازش"
pub const KindProcessingInstruction := 5
@en "KindDoctype"
@fa "نوع اعلان سند"
pub const KindDoctype := 6
@en "XMLNamespaceURI"
@fa "نشانی فضای نام اکس‌ام‌ال"
pub const XMLNamespaceURI := "http://www.w3.org/XML/1998/namespace"
@en "XMLNSNamespaceURI"
@fa "نشانی فضای نام اکس‌ام‌ال‌ان‌اس"
pub const XMLNSNamespaceURI := "http://www.w3.org/2000/xmlns/"
@en "Attribute"
@fa "ویژگی"
pub struct Attribute:
@en "owner"
@fa "عنصر مالک"
pub owner: int = 0 - 1
@en "name"
@fa "نام"
pub name: str = ""
@en "prefix"
@fa "پیشوند"
pub prefix: str = ""
@en "local"
@fa "نام محلی"
pub local: str = ""
@en "uri"
@fa "نشانی فضای نام"
pub uri: str = ""
@en "value"
@fa "مقدار"
pub value: str = ""
@en "line"
@fa "خط"
pub line: int = 0
@en "col"
@fa "ستون"
pub col: int = 0
end
@en "Node"
@fa "گره"
pub struct Node:
@en "kind"
@fa "نوع"
pub kind: int = 0
@en "name"
@fa "نام"
pub name: str = ""
@en "prefix"
@fa "پیشوند"
pub prefix: str = ""
@en "local"
@fa "نام محلی"
pub local: str = ""
@en "uri"
@fa "نشانی فضای نام"
pub uri: str = ""
@en "value"
@fa "مقدار"
pub value: str = ""
@en "parent"
@fa "والد"
pub parent: int = 0 - 1
@en "children"
@fa "فرزندان"
pub children: Vector<int> = Vector {}
@en "attrs"
@fa "ویژگی‌ها"
pub attrs: Vector<int> = Vector {}
@en "line"
@fa "خط"
pub line: int = 0
@en "col"
@fa "ستون"
pub col: int = 0
end
@en "Document"
@fa "سند"
pub struct Document:
@en "nodes"
@fa "گره‌ها"
pub nodes: Vector<Node> = Vector {}
@en "attributes"
@fa "ویژگی‌ها"
pub attributes: Vector<Attribute> = Vector {}
@en "version"
@fa "نسخه"
pub version: str = ""
@en "encoding"
@fa "کدگذاری"
pub encoding: str = ""
@en "standalone"
@fa "مستقل"
pub standalone: str = ""
@en "doctype"
@fa "نوع سند"
pub doctype: str = ""
@en "doctype_public"
@fa "شناسه عمومی نوع سند"
pub doctype_public: str = ""
@en "doctype_system"
@fa "شناسه سیستمی نوع سند"
pub doctype_system: str = ""
@en "internal_subset"
@fa "زیرمجموعه داخلی"
pub internal_subset: str = ""
@en "entity_names"
@fa "نام موجودیت‌ها"
pub entity_names: Vector<str> = Vector {}
@en "entity_values"
@fa "مقدار موجودیت‌ها"
pub entity_values: Vector<str> = Vector {}
@en "owned"
@fa "رشته‌های نگه‌داشته"
pub owned: Vector<str> = Vector {}
end
@en "NodeList"
@fa "فهرست گره"
pub struct NodeList:
@en "items"
@fa "شناسه‌ها"
pub items: Vector<int> = Vector {}
end
func release(text: str):
if str.Len(text) > 0: mem.Free(text as void*) end
end
func own(d &: Document, text: str): str:
if str.Len(text) > 0: d.owned.push(text) end
ret text
end
func new_element(d &: Document, name: str): int:
ret new_node(d, KindElement, name)
end
func node_at(d: Document, id: int): Node:
if id < 0 or id >= d.nodes.len(): ret Node { kind = 0 - 1 } end
ret d.nodes.get(id)
end
func attr_at(d: Document, id: int): Attribute:
if id < 0 or id >= d.attributes.len(): ret Attribute {} end
ret d.attributes.get(id)
end
func new_node(d &: Document, kind: int, name: str): int:
id := d.nodes.len()
d.nodes.push(Node { kind = kind, name = name, local = name })
ret id
end
func attach(d &: Document, parent: int, child: int):
mut p := d.nodes.get(parent)
p.children.push(child)
d.nodes.set(parent, p)
mut c := d.nodes.get(child)
c.parent = parent
d.nodes.set(child, c)
end
func set_attribute_on(d &: Document, id: int, name: str, prefix: str, local: str, uri: str, value: str, line: int, col: int):
mut owner := d.nodes.get(id)
mut i := 0
until i < owner.attrs.len():
existing := d.attributes.get(owner.attrs.get(i))
if existing.name == name:
mut updated := existing
updated.value = value
d.attributes.set(owner.attrs.get(i), updated)
ret
end
i++
end
aid := d.attributes.len()
d.attributes.push(Attribute { owner = id, name = name, prefix = prefix, local = local, uri = uri, value = value, line = line, col = col })
owner.attrs.push(aid)
d.nodes.set(id, owner)
end
func collect_text(d: Document, id: int, sb &: str.StringBuilder, with_cdata: bool):
n := node_at(d, id)
if n.kind == KindText: str.BufAppend(sb, n.value) end
if n.kind == KindCData and with_cdata: str.BufAppend(sb, n.value) end
mut i := 0
until i < n.children.len():
collect_text(d, n.children.get(i), sb, with_cdata)
i++
end
end
func collect_descendants(d: Document, id: int, out &: NodeList):
n := node_at(d, id)
mut i := 0
until i < n.children.len():
child := n.children.get(i)
out.items.push(child)
collect_descendants(d, child, out)
i++
end
end
func index_among_named_siblings(d: Document, id: int): int:
n := node_at(d, id)
if n.parent < 0: ret 1 end
p := node_at(d, n.parent)
mut seen := 0
mut i := 0
until i < p.children.len():
c := node_at(d, p.children.get(i))
if c.kind == n.kind and c.name == n.name:
seen++
if p.children.get(i) == id: ret seen end
end
i++
end
ret seen
end
@en "NewDocument"
@fa "سند جدید"
pub func NewDocument(): Document:
mut d := Document { version = "1.0", encoding = "UTF-8" }
_root := new_node(d, KindDocument, "#document")
ret d
end
@en "Free"
@fa "آزادسازی"
pub func Free(d &: Document):
mut i := 0
until i < d.nodes.len():
mut n := d.nodes.get(i)
n.children.free()
n.attrs.free()
i++
end
mut k := 0
until k < d.owned.len():
mem.Free(d.owned.get(k) as void*)
k++
end
d.nodes.free()
d.attributes.free()
d.entity_names.free()
d.entity_values.free()
d.owned.free()
end
@en "FreeList"
@fa "آزادسازی فهرست"
pub func FreeList(list &: NodeList):
list.items.free()
end
@en "NodeCount"
@fa "شمار گره‌ها"
pub func NodeCount(d: Document): int: ret d.nodes.len() end
@en "DocumentNode"
@fa "گره سند"
pub func DocumentNode(d: Document): int:
if d.nodes.len() == 0: ret 0 - 1 end
ret 0
end
@en "Root"
@fa "عنصر ریشه"
pub func Root(d: Document): int:
doc := node_at(d, 0)
mut i := 0
until i < doc.children.len():
child := doc.children.get(i)
if node_at(d, child).kind == KindElement: ret child end
i++
end
ret 0 - 1
end
@en "Exists"
@fa "وجود دارد"
pub func Exists(d: Document, id: int): bool:
ret id >= 0 and id < d.nodes.len()
end
@en "Kind"
@fa "نوع"
pub func Kind(d: Document, id: int): int: ret node_at(d, id).kind end
@en "Name"
@fa "نام"
pub func Name(d: Document, id: int): str: ret node_at(d, id).name end
@en "LocalName"
@fa "نام محلی"
pub func LocalName(d: Document, id: int): str: ret node_at(d, id).local end
@en "Prefix"
@fa "پیشوند"
pub func Prefix(d: Document, id: int): str: ret node_at(d, id).prefix end
@en "NamespaceURI"
@fa "نشانی فضای نام"
pub func NamespaceURI(d: Document, id: int): str: ret node_at(d, id).uri end
@en "Value"
@fa "مقدار"
pub func Value(d: Document, id: int): str: ret node_at(d, id).value end
@en "Parent"
@fa "والد"
pub func Parent(d: Document, id: int): int: ret node_at(d, id).parent end
@en "Line"
@fa "خط"
pub func Line(d: Document, id: int): int: ret node_at(d, id).line end
@en "Column"
@fa "ستون"
pub func Column(d: Document, id: int): int: ret node_at(d, id).col end
@en "IsElement"
@fa "عنصر است"
pub func IsElement(d: Document, id: int): bool: ret node_at(d, id).kind == KindElement end
@en "ChildCount"
@fa "شمار فرزندان"
pub func ChildCount(d: Document, id: int): int: ret node_at(d, id).children.len() end
@en "ChildAt"
@fa "فرزند شماره"
pub func ChildAt(d: Document, id: int, index: int): int:
n := node_at(d, id)
if index < 0 or index >= n.children.len(): ret 0 - 1 end
ret n.children.get(index)
end
@en "ChildNodes"
@fa "گره‌های فرزند"
pub func ChildNodes(d: Document, id: int): NodeList:
mut out := NodeList {}
n := node_at(d, id)
mut i := 0
until i < n.children.len():
out.items.push(n.children.get(i))
i++
end
ret out
end
@en "Elements"
@fa "عنصرها"
pub func Elements(d: Document, id: int): NodeList:
mut out := NodeList {}
n := node_at(d, id)
mut i := 0
until i < n.children.len():
child := n.children.get(i)
if node_at(d, child).kind == KindElement: out.items.push(child) end
i++
end
ret out
end
@en "ElementsNamed"
@fa "عنصرهای با نام"
pub func ElementsNamed(d: Document, id: int, name: str): NodeList:
mut out := NodeList {}
n := node_at(d, id)
mut i := 0
until i < n.children.len():
child := n.children.get(i)
c := node_at(d, child)
if c.kind == KindElement and (c.name == name or c.local == name): out.items.push(child) end
i++
end
ret out
end
@en "FirstElementNamed"
@fa "نخستین عنصر با نام"
pub func FirstElementNamed(d: Document, id: int, name: str): int:
n := node_at(d, id)
mut i := 0
until i < n.children.len():
child := n.children.get(i)
c := node_at(d, child)
if c.kind == KindElement and (c.name == name or c.local == name): ret child end
i++
end
ret 0 - 1
end
@en "Descendants"
@fa "نوادگان"
pub func Descendants(d: Document, id: int): NodeList:
mut out := NodeList {}
collect_descendants(d, id, out)
ret out
end
@en "Ancestors"
@fa "نیاکان"
pub func Ancestors(d: Document, id: int): NodeList:
mut out := NodeList {}
mut at := node_at(d, id).parent
until at >= 0:
out.items.push(at)
at = node_at(d, at).parent
end
ret out
end
@en "NextSibling"
@fa "گره هم‌سطح بعدی"
pub func NextSibling(d: Document, id: int): int:
n := node_at(d, id)
if n.parent < 0: ret 0 - 1 end
p := node_at(d, n.parent)
mut i := 0
until i < p.children.len():
if p.children.get(i) == id and i + 1 < p.children.len(): ret p.children.get(i + 1) end
i++
end
ret 0 - 1
end
@en "PreviousSibling"
@fa "گره هم‌سطح قبلی"
pub func PreviousSibling(d: Document, id: int): int:
n := node_at(d, id)
if n.parent < 0: ret 0 - 1 end
p := node_at(d, n.parent)
mut i := 0
until i < p.children.len():
if p.children.get(i) == id and i > 0: ret p.children.get(i - 1) end
i++
end
ret 0 - 1
end
@en "Depth"
@fa "عمق"
pub func Depth(d: Document, id: int): int:
mut count := 0
mut at := node_at(d, id).parent
until at >= 0:
count++
at = node_at(d, at).parent
end
ret count
end
@en "AttributeCount"
@fa "شمار ویژگی‌ها"
pub func AttributeCount(d: Document, id: int): int: ret node_at(d, id).attrs.len() end
@en "AttributeAt"
@fa "ویژگی شماره"
pub func AttributeAt(d: Document, id: int, index: int): Attribute:
n := node_at(d, id)
if index < 0 or index >= n.attrs.len(): ret Attribute {} end
ret attr_at(d, n.attrs.get(index))
end
@en "HasAttribute"
@fa "ویژگی دارد"
pub func HasAttribute(d: Document, id: int, name: str): bool:
n := node_at(d, id)
mut i := 0
until i < n.attrs.len():
if attr_at(d, n.attrs.get(i)).name == name: ret true end
i++
end
ret false
end
@en "AttributeValue"
@fa "مقدار ویژگی"
pub func AttributeValue(d: Document, id: int, name: str): str:
n := node_at(d, id)
mut i := 0
until i < n.attrs.len():
a := attr_at(d, n.attrs.get(i))
if a.name == name: ret a.value end
i++
end
ret ""
end
@en "AttributeValueNS"
@fa "مقدار ویژگی با فضای نام"
pub func AttributeValueNS(d: Document, id: int, uri: str, local: str): str:
n := node_at(d, id)
mut i := 0
until i < n.attrs.len():
a := attr_at(d, n.attrs.get(i))
if a.uri == uri and a.local == local: ret a.value end
i++
end
ret ""
end
@en "Text"
@fa "متن"
pub func Text(d: Document, id: int): str:
mut sb := str.NewBuilder()
collect_text(d, id, sb, true)
out := str.BufStr(sb)
str.BufFree(sb)
ret out
end
@en "DirectText"
@fa "متن مستقیم"
pub func DirectText(d: Document, id: int): str:
mut sb := str.NewBuilder()
n := node_at(d, id)
mut i := 0
until i < n.children.len():
c := node_at(d, n.children.get(i))
if c.kind == KindText or c.kind == KindCData: str.BufAppend(sb, c.value) end
i++
end
out := str.BufStr(sb)
str.BufFree(sb)
ret out
end
@en "Path"
@fa "مسیر"
pub func Path(d: Document, id: int): str:
if not Exists(d, id): ret "" end
n := node_at(d, id)
if n.kind == KindDocument: ret "/" end
parent := n.parent
mut head := ""
if parent > 0: head = Path(d, parent) end
mut label := n.name
if n.kind == KindText: label = "text()" end
if n.kind == KindComment: label = "comment()" end
if n.kind == KindCData: label = "text()" end
if n.kind == KindProcessingInstruction: label = "processing-instruction()" end
ret head + "/" + label + "[" + str.FromInt(index_among_named_siblings(d, id) as i64) + "]"
end
@en "EntityCount"
@fa "شمار موجودیت‌ها"
pub func EntityCount(d: Document): int: ret d.entity_names.len() end
@en "EntityValue"
@fa "مقدار موجودیت"
pub func EntityValue(d: Document, name: str): str:
mut i := 0
until i < d.entity_names.len():
if d.entity_names.get(i) == name: ret d.entity_values.get(i) end
i++
end
ret ""
end
@en "CreateElement"
@fa "ساخت عنصر"
pub func CreateElement(d &: Document, name: str): int:
id := new_node(d, KindElement, name)
mut n := d.nodes.get(id)
colon := str.IndexOf(name, ":")
if colon > 0:
n.prefix = own(d, str.Substr(name, 0, colon))
n.local = own(d, str.Substr(name, colon + 1, str.Len(name) - colon - 1))
end
d.nodes.set(id, n)
ret id
end
@en "CreateText"
@fa "ساخت متن"
pub func CreateText(d &: Document, text: str): int:
id := new_node(d, KindText, "#text")
mut n := d.nodes.get(id)
n.value = text
d.nodes.set(id, n)
ret id
end
@en "CreateCData"
@fa "ساخت سی‌دیتا"
pub func CreateCData(d &: Document, text: str): int:
id := new_node(d, KindCData, "#cdata-section")
mut n := d.nodes.get(id)
n.value = text
d.nodes.set(id, n)
ret id
end
@en "CreateComment"
@fa "ساخت توضیح"
pub func CreateComment(d &: Document, text: str): int:
id := new_node(d, KindComment, "#comment")
mut n := d.nodes.get(id)
n.value = text
d.nodes.set(id, n)
ret id
end
@en "CreateProcessingInstruction"
@fa "ساخت دستور پردازش"
pub func CreateProcessingInstruction(d &: Document, target: str, data: str): int:
id := new_node(d, KindProcessingInstruction, target)
mut n := d.nodes.get(id)
n.value = data
d.nodes.set(id, n)
ret id
end
@en "Append"
@fa "افزودن فرزند"
pub func Append(d &: Document, parent: int, child: int):
if not Exists(d, parent) or not Exists(d, child): ret end
attach(d, parent, child)
end
@en "InsertBefore"
@fa "درج پیش از"
pub func InsertBefore(d &: Document, parent: int, child: int, before: int):
if not Exists(d, parent) or not Exists(d, child): ret end
mut p := d.nodes.get(parent)
mut at := p.children.len()
mut i := 0
mut found := false
until not found and i < p.children.len():
if p.children.get(i) == before:
at = i
found = true
end
i++
end
p.children.insert(at, child)
d.nodes.set(parent, p)
mut c := d.nodes.get(child)
c.parent = parent
d.nodes.set(child, c)
end
@en "RemoveChild"
@fa "حذف فرزند"
pub func RemoveChild(d &: Document, parent: int, child: int): bool:
if not Exists(d, parent): ret false end
mut p := d.nodes.get(parent)
mut i := 0
until i < p.children.len():
if p.children.get(i) == child:
p.children.remove_at(i)
d.nodes.set(parent, p)
mut c := d.nodes.get(child)
c.parent = 0 - 1
d.nodes.set(child, c)
ret true
end
i++
end
ret false
end
@en "SetAttribute"
@fa "تنظیم ویژگی"
pub func SetAttribute(d &: Document, id: int, name: str, value: str):
if not Exists(d, id): ret end
mut prefix := ""
mut local := name
colon := str.IndexOf(name, ":")
if colon > 0:
prefix = own(d, str.Substr(name, 0, colon))
local = own(d, str.Substr(name, colon + 1, str.Len(name) - colon - 1))
end
set_attribute_on(d, id, name, prefix, local, "", value, 0, 0)
end
@en "RemoveAttribute"
@fa "حذف ویژگی"
pub func RemoveAttribute(d &: Document, id: int, name: str): bool:
if not Exists(d, id): ret false end
mut n := d.nodes.get(id)
mut i := 0
until i < n.attrs.len():
if attr_at(d, n.attrs.get(i)).name == name:
n.attrs.remove_at(i)
d.nodes.set(id, n)
ret true
end
i++
end
ret false
end
@en "SetText"
@fa "تنظیم متن"
pub func SetText(d &: Document, id: int, text: str):
if not Exists(d, id): ret end
mut n := d.nodes.get(id)
n.children.clear()
d.nodes.set(id, n)
child := CreateText(d, text)
attach(d, id, child)
end
package xml
@en "ContentEmpty"
@fa "محتوای خالی"
pub const ContentEmpty := 0
@en "ContentAny"
@fa "محتوای دلخواه"
pub const ContentAny := 1
@en "ContentMixed"
@fa "محتوای آمیخته"
pub const ContentMixed := 2
@en "ContentChildren"
@fa "محتوای فرزندان"
pub const ContentChildren := 3
@en "AttrCData"
@fa "ویژگی متنی"
pub const AttrCData := 0
@en "AttrId"
@fa "ویژگی شناسه"
pub const AttrId := 1
@en "AttrIdRef"
@fa "ویژگی ارجاع شناسه"
pub const AttrIdRef := 2
@en "AttrIdRefs"
@fa "ویژگی ارجاع‌های شناسه"
pub const AttrIdRefs := 3
@en "AttrEntity"
@fa "ویژگی موجودیت"
pub const AttrEntity := 4
@en "AttrEntities"
@fa "ویژگی موجودیت‌ها"
pub const AttrEntities := 5
@en "AttrNmToken"
@fa "ویژگی نام‌نشانه"
pub const AttrNmToken := 6
@en "AttrNmTokens"
@fa "ویژگی نام‌نشانه‌ها"
pub const AttrNmTokens := 7
@en "AttrEnumeration"
@fa "ویژگی فهرستی"
pub const AttrEnumeration := 8
@en "AttrNotation"
@fa "ویژگی نشان‌گذاری"
pub const AttrNotation := 9
@en "DefaultRequired"
@fa "پیش فرض الزامی"
pub const DefaultRequired := 0
@en "DefaultImplied"
@fa "پیش فرض اختیاری"
pub const DefaultImplied := 1
@en "DefaultFixed"
@fa "پیش فرض ثابت"
pub const DefaultFixed := 2
@en "DefaultValue"
@fa "پیش فرض با مقدار"
pub const DefaultValue := 3
const MK_NAME := 0
const MK_SEQUENCE := 1
const MK_CHOICE := 2
const OC_ONCE := 0
const OC_OPTIONAL := 1
const OC_STAR := 2
const OC_PLUS := 3
struct ModelNode:
pub kind: int = 0
pub name: str = ""
pub occur: int = 0
pub args: Vector<int> = Vector {}
end
@en "ElementDecl"
@fa "اعلان عنصر"
pub struct ElementDecl:
@en "name"
@fa "نام"
pub name: str = ""
@en "content"
@fa "محتوا"
pub content: int = 1
@en "model"
@fa "مدل"
pub model: str = ""
@en "root"
@fa "ریشه"
pub root: int = 0 - 1
@en "mixed"
@fa "آمیخته"
pub mixed: Vector<str> = Vector {}
end
@en "AttrDecl"
@fa "اعلان ویژگی"
pub struct AttrDecl:
@en "element"
@fa "عنصر"
pub element: str = ""
@en "name"
@fa "نام"
pub name: str = ""
@en "kind"
@fa "گونه"
pub kind: int = 0
@en "mode"
@fa "حالت"
pub mode: int = 1
@en "value"
@fa "مقدار پیش‌فرض"
pub value: str = ""
@en "values"
@fa "مقدارهای مجاز"
pub values: Vector<str> = Vector {}
end
@en "DTD"
@fa "دی‌تی‌دی"
pub struct DTD:
@en "ok"
@fa "موفق"
pub ok: bool = true
@en "message"
@fa "پیام"
pub message: str = ""
@en "elements"
@fa "عنصرها"
pub elements: Vector<ElementDecl> = Vector {}
@en "attributes"
@fa "ویژگی‌ها"
pub attributes: Vector<AttrDecl> = Vector {}
@en "notations"
@fa "نشان‌گذاری‌ها"
pub notations: Vector<str> = Vector {}
@en "models"
@fa "مدل‌ها"
pub models: Vector<ModelNode> = Vector {}
end
@en "Violation"
@fa "تخلف"
pub struct Violation:
@en "message"
@fa "پیام"
pub message: str = ""
@en "line"
@fa "خط"
pub line: int = 0
@en "col"
@fa "ستون"
pub col: int = 0
@en "node"
@fa "گره"
pub node: int = 0 - 1
end
@en "Report"
@fa "گزارش اعتبارسنجی"
pub struct Report:
@en "ok"
@fa "معتبر"
pub ok: bool = true
@en "items"
@fa "موردها"
pub items: Vector<Violation> = Vector {}
end
func report_add(r &: Report, d: Document, node: int, message: str):
mut line := 0
mut col := 0
if node >= 0 and node < d.nodes.len():
line = Line(d, node)
col = Column(d, node)
end
r.items.push(Violation { message = message, line = line, col = col, node = node })
r.ok = false
end
func is_name_text(text: str): bool:
n := str.Len(text)
if n == 0: ret false end
p := xbp(text)
mut width := 0
cp := decode_cp(p, n, 0, width)
if cp < 0 or not name_start_cp(cp): ret false end
mut i := width
until i < n:
c := decode_cp(p, n, i, width)
if c < 0 or not name_char_cp(c): ret false end
i += width
end
ret true
end
func is_nmtoken_text(text: str): bool:
n := str.Len(text)
if n == 0: ret false end
p := xbp(text)
mut width := 0
mut i := 0
until i < n:
c := decode_cp(p, n, i, width)
if c < 0 or not name_char_cp(c): ret false end
i += width
end
ret true
end
func skip_dtd_space(text: str, p: i8*, n: int, at: int): int:
mut i := at
until i < n:
if xml_space(xub(p, i)):
i++
else i + 3 < n and xub(p, i) == 60 and xub(p, i + 1) == 33 and xub(p, i + 2) == 45 and xub(p, i + 3) == 45:
close := str.IndexFrom(text, "-->", i + 4)
if close < 0: ret n end
i = close + 3
else:
ret i
end
end
ret i
end
func read_dtd_name(text: str, p: i8*, n: int, at: int, stop &: int): str:
mut i := at
until i < n and not xml_space(xub(p, i)) and xub(p, i) != 62 and xub(p, i) != 40 and xub(p, i) != 41 and xub(p, i) != 124 and xub(p, i) != 44 and xub(p, i) != 42 and xub(p, i) != 63 and xub(p, i) != 43:
i++
end
stop = i
ret str.Substr(text, at, i - at)
end
func new_model(dtd &: DTD, kind: int): int:
id := dtd.models.len()
dtd.models.push(ModelNode { kind = kind })
ret id
end
func read_occurrence(p: i8*, n: int, at: int, stop &: int): int:
stop = at
if at >= n: ret OC_ONCE end
c := xub(p, at)
if c == 63:
stop = at + 1
ret OC_OPTIONAL
end
if c == 42:
stop = at + 1
ret OC_STAR
end
if c == 43:
stop = at + 1
ret OC_PLUS
end
ret OC_ONCE
end
func parse_particle(dtd &: DTD, text: str, p: i8*, n: int, at: int, stop &: int): int:
mut i := skip_dtd_space(text, p, n, at)
if i < n and xub(p, i) == 40:
i++
mut kind := MK_SEQUENCE
mut parts := Vector {} as Vector<int>
mut going := true
until going:
mut inner := i
child := parse_particle(dtd, text, p, n, i, inner)
if child < 0:
parts.free()
stop = i
ret 0 - 1
end
parts.push(child)
i = skip_dtd_space(text, p, n, inner)
if i < n and xub(p, i) == 124:
kind = MK_CHOICE
i++
else i < n and xub(p, i) == 44:
i++
else:
going = false
end
end
if i >= n or xub(p, i) != 41:
parts.free()
stop = i
ret 0 - 1
end
i++
id := new_model(dtd, kind)
mut node := dtd.models.get(id)
mut k := 0
until k < parts.len():
node.args.push(parts.get(k))
k++
end
node.occur = read_occurrence(p, n, i, i)
dtd.models.set(id, node)
parts.free()
stop = i
ret id
end
mut named := i
name := read_dtd_name(text, p, n, i, named)
if str.Len(name) == 0:
stop = i
ret 0 - 1
end
id := new_model(dtd, MK_NAME)
mut node := dtd.models.get(id)
node.name = name
node.occur = read_occurrence(p, n, named, named)
dtd.models.set(id, node)
stop = named
ret id
end
func parse_element_decl(dtd &: DTD, text: str, p: i8*, n: int, at: int): int:
mut i := skip_dtd_space(text, p, n, at)
mut stop := i
name := read_dtd_name(text, p, n, i, stop)
if str.Len(name) == 0:
dtd.ok = false
dtd.message = "an element declaration has no name"
ret n
end
i = skip_dtd_space(text, p, n, stop)
mut decl := ElementDecl { name = name }
if i + 5 <= n and str.Substr(text, i, 5) == "EMPTY":
decl.content = ContentEmpty
decl.model = "EMPTY"
i += 5
else i + 3 <= n and str.Substr(text, i, 3) == "ANY":
decl.content = ContentAny
decl.model = "ANY"
i += 3
else i < n and xub(p, i) == 40:
probe := skip_dtd_space(text, p, n, i + 1)
if probe + 7 <= n and str.Substr(text, probe, 7) == "#PCDATA":
decl.content = ContentMixed
mut j := probe + 7
mut going := true
until going:
j = skip_dtd_space(text, p, n, j)
if j < n and xub(p, j) == 124:
j = skip_dtd_space(text, p, n, j + 1)
mut e := j
child := read_dtd_name(text, p, n, j, e)
if str.Len(child) == 0:
dtd.ok = false
dtd.message = "the mixed content model of <" + name + "> is malformed"
ret n
end
decl.mixed.push(child)
j = e
else:
going = false
end
end
if j >= n or xub(p, j) != 41:
dtd.ok = false
dtd.message = "the mixed content model of <" + name + "> is never closed"
ret n
end
j++
if j < n and xub(p, j) == 42: j++ end
decl.model = str.Substr(text, i, j - i)
i = j
else:
mut e := i
root := parse_particle(dtd, text, p, n, i, e)
if root < 0:
dtd.ok = false
dtd.message = "the content model of <" + name + "> is malformed"
ret n
end
decl.content = ContentChildren
decl.root = root
decl.model = str.Substr(text, i, e - i)
i = e
end
else:
dtd.ok = false
dtd.message = "the content model of <" + name + "> is malformed"
ret n
end
dtd.elements.push(decl)
i = skip_dtd_space(text, p, n, i)
if i < n and xub(p, i) == 62: ret i + 1 end
ret i
end
func attr_kind_of(word: str): int:
if word == "CDATA": ret AttrCData end
if word == "ID": ret AttrId end
if word == "IDREF": ret AttrIdRef end
if word == "IDREFS": ret AttrIdRefs end
if word == "ENTITY": ret AttrEntity end
if word == "ENTITIES": ret AttrEntities end
if word == "NMTOKEN": ret AttrNmToken end
if word == "NMTOKENS": ret AttrNmTokens end
if word == "NOTATION": ret AttrNotation end
ret 0 - 1
end
func parse_attlist_decl(dtd &: DTD, text: str, p: i8*, n: int, at: int): int:
mut i := skip_dtd_space(text, p, n, at)
mut stop := i
element := read_dtd_name(text, p, n, i, stop)
if str.Len(element) == 0:
dtd.ok = false
dtd.message = "an attribute list declaration has no element name"
ret n
end
i = stop
mut going := true
until going:
i = skip_dtd_space(text, p, n, i)
if i >= n or xub(p, i) == 62:
going = false
else:
mut e := i
name := read_dtd_name(text, p, n, i, e)
if str.Len(name) == 0:
dtd.ok = false
dtd.message = "an attribute in the list for <" + element + "> has no name"
ret n
end
i = skip_dtd_space(text, p, n, e)
mut decl := AttrDecl { element = element, name = name }
if i < n and xub(p, i) == 40:
decl.kind = AttrEnumeration
mut j := i + 1
mut reading := true
until reading:
j = skip_dtd_space(text, p, n, j)
mut q := j
token := read_dtd_name(text, p, n, j, q)
if str.Len(token) > 0: decl.values.push(token) end
j = skip_dtd_space(text, p, n, q)
if j < n and xub(p, j) == 124: j++
else:
reading = false
end
end
if j >= n or xub(p, j) != 41:
dtd.ok = false
dtd.message = "the value list for \"" + name + "\" is never closed"
ret n
end
i = j + 1
else:
mut e2 := i
word := read_dtd_name(text, p, n, i, e2)
kind := attr_kind_of(word)
if kind < 0:
dtd.ok = false
dtd.message = "\"" + word + "\" is not an attribute type"
ret n
end
decl.kind = kind
i = skip_dtd_space(text, p, n, e2)
if kind == AttrNotation:
if i >= n or xub(p, i) != 40:
dtd.ok = false
dtd.message = "NOTATION must be followed by a list of names"
ret n
end
mut j := i + 1
mut reading := true
until reading:
j = skip_dtd_space(text, p, n, j)
mut q := j
token := read_dtd_name(text, p, n, j, q)
if str.Len(token) > 0: decl.values.push(token) end
j = skip_dtd_space(text, p, n, q)
if j < n and xub(p, j) == 124: j++
else:
reading = false
end
end
if j >= n or xub(p, j) != 41:
dtd.ok = false
dtd.message = "the notation list for \"" + name + "\" is never closed"
ret n
end
i = j + 1
end
end
i = skip_dtd_space(text, p, n, i)
if i < n and xub(p, i) == 35:
mut e3 := i + 1
word := read_dtd_name(text, p, n, i + 1, e3)
if word == "REQUIRED": decl.mode = DefaultRequired
else word == "IMPLIED": decl.mode = DefaultImplied
else word == "FIXED":
decl.mode = DefaultFixed
i = skip_dtd_space(text, p, n, e3)
mut e4 := i
decl.value = read_dtd_literal(text, p, n, i, e4)
e3 = e4
else:
dtd.ok = false
dtd.message = "\"#" + word + "\" is not an attribute default"
ret n
end
i = e3
else i < n and (xub(p, i) == 34 or xub(p, i) == 39):
decl.mode = DefaultValue
mut e4 := i
decl.value = read_dtd_literal(text, p, n, i, e4)
i = e4
end
dtd.attributes.push(decl)
end
end
if i < n and xub(p, i) == 62: ret i + 1 end
ret i
end
func read_dtd_literal(text: str, p: i8*, n: int, at: int, stop &: int): str:
if at >= n or (xub(p, at) != 34 and xub(p, at) != 39):
stop = at
ret ""
end
quote := xub(p, at)
mut i := at + 1
until i < n and xub(p, i) != quote:
i++
end
stop = i + 1
ret str.Substr(text, at + 1, i - at - 1)
end
func parse_notation_decl(dtd &: DTD, text: str, p: i8*, n: int, at: int): int:
i := skip_dtd_space(text, p, n, at)
mut stop := i
name := read_dtd_name(text, p, n, i, stop)
if str.Len(name) > 0: dtd.notations.push(name) end
close := str.IndexFrom(text, ">", stop)
if close < 0: ret n end
ret close + 1
end
func find_element_decl(dtd: DTD, name: str): int:
mut i := 0
until i < dtd.elements.len():
if dtd.elements.get(i).name == name: ret i end
i++
end
ret 0 - 1
end
func copy_positions(source &: Vector<int>): Vector<int>:
mut out := Vector {} as Vector<int>
mut i := 0
until i < source.len():
out.push(source.get(i))
i++
end
ret out
end
func match_once(dtd: DTD, id: int, names &: Vector<str>, starts &: Vector<int>): Vector<int>:
node := dtd.models.get(id)
mut out := Vector {} as Vector<int>
if node.kind == MK_NAME:
mut i := 0
until i < starts.len():
at := starts.get(i)
if at < names.len() and names.get(at) == node.name: _added := push_unique(out, at + 1) end
i++
end
ret out
end
if node.kind == MK_SEQUENCE:
mut current := copy_positions(starts)
mut a := 0
until a < node.args.len():
next := advance_model(dtd, node.args.get(a), names, current)
current.free()
current = next
a++
end
ret current
end
mut a := 0
until a < node.args.len():
part := advance_model(dtd, node.args.get(a), names, starts)
mut k := 0
until k < part.len():
_added := push_unique(out, part.get(k))
k++
end
part.free()
a++
end
ret out
end
func closure_from(dtd: DTD, id: int, names &: Vector<str>, seed &: Vector<int>, out &: Vector<int>):
mut frontier := copy_positions(seed)
mut guard := 0
until guard < 8192:
mut fresh := Vector {} as Vector<int>
mut i := 0
until i < frontier.len():
if push_unique(out, frontier.get(i)): fresh.push(frontier.get(i)) end
i++
end
if fresh.len() == 0:
fresh.free()
break
end
next := match_once(dtd, id, names, fresh)
fresh.free()
frontier.free()
frontier = next
guard++
end
frontier.free()
end
func advance_model(dtd: DTD, id: int, names &: Vector<str>, starts &: Vector<int>): Vector<int>:
node := dtd.models.get(id)
if node.occur == OC_ONCE: ret match_once(dtd, id, names, starts) end
mut out := Vector {} as Vector<int>
if node.occur == OC_OPTIONAL:
mut i := 0
until i < starts.len():
_added := push_unique(out, starts.get(i))
i++
end
once := match_once(dtd, id, names, starts)
mut k := 0
until k < once.len():
_added := push_unique(out, once.get(k))
k++
end
once.free()
ret out
end
if node.occur == OC_STAR:
closure_from(dtd, id, names, starts, out)
ret out
end
mut first := match_once(dtd, id, names, starts)
closure_from(dtd, id, names, first, out)
first.free()
ret out
end
func push_unique(list &: Vector<int>, value: int): bool:
mut i := 0
until i < list.len():
if list.get(i) == value: ret false end
i++
end
list.push(value)
ret true
end
func parse_dtd_text(text: str): DTD:
mut dtd := DTD {}
n := str.Len(text)
p := xbp(text)
mut i := 0
until dtd.ok and i < n:
i = skip_dtd_space(text, p, n, i)
if i >= n: break end
if xub(p, i) != 60:
i++
continue
end
if i + 1 < n and xub(p, i + 1) == 63:
close := str.IndexFrom(text, "?>", i)
if close < 0: break end
i = close + 2
continue
end
if i + 9 <= n and str.Substr(text, i, 9) == "<!ELEMENT":
i = parse_element_decl(dtd, text, p, n, i + 9)
continue
end
if i + 9 <= n and str.Substr(text, i, 9) == "<!ATTLIST":
i = parse_attlist_decl(dtd, text, p, n, i + 9)
continue
end
if i + 10 <= n and str.Substr(text, i, 10) == "<!NOTATION":
i = parse_notation_decl(dtd, text, p, n, i + 10)
continue
end
close := str.IndexFrom(text, ">", i)
if close < 0: break end
i = close + 1
end
ret dtd
end
func find_attr_decl(dtd: DTD, element: str, name: str): int:
mut i := 0
until i < dtd.attributes.len():
a := dtd.attributes.get(i)
if a.element == element and a.name == name: ret i end
i++
end
ret 0 - 1
end
func split_tokens(text: str): Vector<str>:
mut out := Vector {} as Vector<str>
parts := str.Fields(text)
mut i := 0
until i < parts.len():
if str.Len(parts.get(i)) > 0: out.push(parts.get(i)) end
i++
end
parts.free()
ret out
end
func has_text_child(d: Document, id: int): bool:
n := node_at(d, id)
mut i := 0
until i < n.children.len():
c := node_at(d, n.children.get(i))
if (c.kind == KindText or c.kind == KindCData) and str.Len(str.Trim(c.value)) > 0: ret true end
i++
end
ret false
end
func check_attributes(
d: Document, dtd: DTD, r &: Report, id: int, ids &: Vector<str>, idrefs &: Vector<str>, idref_nodes &: Vector<int>
):
element := Name(d, id)
n := node_at(d, id)
mut seen_id := false
mut i := 0
until i < n.attrs.len():
a := d.attributes.get(n.attrs.get(i))
if a.name == "xmlns" or a.prefix == "xmlns":
i++
continue
end
at := find_attr_decl(dtd, element, a.name)
if at < 0:
report_add(r, d, id, "the attribute \"" + a.name + "\" is not declared for <" + element + ">")
i++
continue
end
decl := dtd.attributes.get(at)
if decl.mode == DefaultFixed and a.value != decl.value:
report_add(r, d, id, "the attribute \"" + a.name + "\" is fixed at \"" + decl.value + "\" but is \"" + a.value + "\"")
end
if decl.kind == AttrEnumeration or decl.kind == AttrNotation:
mut allowed := false
mut k := 0
until k < decl.values.len():
if decl.values.get(k) == a.value: allowed = true end
k++
end
if not allowed:
report_add(r, d, id, "\"" + a.value + "\" is not one of the values declared for \"" + a.name + "\"")
end
end
if decl.kind == AttrId:
if seen_id:
report_add(r, d, id, "<" + element + "> has more than one ID attribute")
end
seen_id = true
if not is_name_text(a.value):
report_add(r, d, id, "the ID \"" + a.value + "\" is not a valid XML name")
end
mut duplicate := false
mut k := 0
until k < ids.len():
if ids.get(k) == a.value: duplicate = true end
k++
end
if duplicate:
report_add(r, d, id, "the ID \"" + a.value + "\" is used more than once")
else:
ids.push(a.value)
end
end
if decl.kind == AttrIdRef:
idrefs.push(a.value)
idref_nodes.push(id)
end
if decl.kind == AttrIdRefs:
mut parts := split_tokens(a.value)
mut k := 0
until k < parts.len():
idrefs.push(parts.get(k))
idref_nodes.push(id)
k++
end
parts.free()
end
if decl.kind == AttrNmToken and not is_nmtoken_text(a.value):
report_add(r, d, id, "\"" + a.value + "\" is not a valid NMTOKEN for \"" + a.name + "\"")
end
if decl.kind == AttrNmTokens:
mut parts := split_tokens(a.value)
mut k := 0
until k < parts.len():
if not is_nmtoken_text(parts.get(k)):
report_add(r, d, id, "\"" + parts.get(k) + "\" is not a valid NMTOKEN for \"" + a.name + "\"")
end
k++
end
parts.free()
end
i++
end
mut k := 0
until k < dtd.attributes.len():
decl := dtd.attributes.get(k)
if decl.element == element and decl.mode == DefaultRequired and not HasAttribute(d, id, decl.name):
report_add(r, d, id, "<" + element + "> is missing the required attribute \"" + decl.name + "\"")
end
k++
end
end
func check_element(
d: Document, dtd: DTD, r &: Report, id: int, ids &: Vector<str>, idrefs &: Vector<str>, idref_nodes &: Vector<int>
):
element := Name(d, id)
at := find_element_decl(dtd, element)
if at < 0:
report_add(r, d, id, "the element <" + element + "> is not declared")
else:
decl := dtd.elements.get(at)
mut names := Vector {} as Vector<str>
n := node_at(d, id)
mut i := 0
until i < n.children.len():
c := node_at(d, n.children.get(i))
if c.kind == KindElement: names.push(c.name) end
i++
end
if decl.content == ContentEmpty:
if names.len() > 0 or has_text_child(d, id):
report_add(r, d, id, "<" + element + "> is declared EMPTY but has content")
end
else decl.content == ContentMixed:
mut k := 0
until k < names.len():
mut allowed := false
mut m := 0
until m < decl.mixed.len():
if decl.mixed.get(m) == names.get(k): allowed = true end
m++
end
if not allowed:
report_add(r, d, id, "<" + names.get(k) + "> is not allowed inside <" + element + ">")
end
k++
end
else decl.content == ContentChildren:
if has_text_child(d, id):
report_add(r, d, id, "<" + element + "> is declared with element content but holds text")
end
mut starts := Vector {} as Vector<int>
starts.push(0)
reached := advance_model(dtd, decl.root, names, starts)
mut complete := false
mut k := 0
until k < reached.len():
if reached.get(k) == names.len(): complete = true end
k++
end
if not complete:
report_add(r, d, id, "the children of <" + element + "> do not match " + decl.model)
end
starts.free()
reached.free()
end
names.free()
check_attributes(d, dtd, r, id, ids, idrefs, idref_nodes)
end
n := node_at(d, id)
mut i := 0
until i < n.children.len():
child := n.children.get(i)
if node_at(d, child).kind == KindElement:
check_element(d, dtd, r, child, ids, idrefs, idref_nodes)
end
i++
end
end
func collect_prefix_scope(d: Document, id: int, prefixes &: Vector<str>, uris &: Vector<str>): int:
n := node_at(d, id)
mut added := 0
mut i := 0
until i < n.attrs.len():
a := d.attributes.get(n.attrs.get(i))
if a.name == "xmlns":
prefixes.push("")
uris.push(a.value)
added++
else a.prefix == "xmlns":
prefixes.push(a.local)
uris.push(a.value)
added++
end
i++
end
ret added
end
func namespace_walk(d: Document, id: int, r &: Report, prefixes &: Vector<str>, uris &: Vector<str>):
added := collect_prefix_scope(d, id, prefixes, uris)
prefix := Prefix(d, id)
if str.Len(prefix) > 0 and prefix != "xml" and not prefix_bound(prefixes, prefix):
report_add(r, d, id, "the namespace prefix \"" + prefix + "\" is not declared")
end
n := node_at(d, id)
mut i := 0
until i < n.attrs.len():
a := d.attributes.get(n.attrs.get(i))
if str.Len(a.prefix) > 0 and a.prefix != "xmlns" and a.prefix != "xml" and not prefix_bound(prefixes, a.prefix):
report_add(r, d, id, "the namespace prefix \"" + a.prefix + "\" on \"" + a.name + "\" is not declared")
end
i++
end
mut k := 0
until k < n.children.len():
child := n.children.get(k)
if node_at(d, child).kind == KindElement:
namespace_walk(d, child, r, prefixes, uris)
end
k++
end
mut drop := 0
until drop < added:
prefixes.pop()
uris.pop()
drop++
end
end
func prefix_bound(prefixes &: Vector<str>, want: str): bool:
mut i := prefixes.len() - 1
until i >= 0:
if prefixes.get(i) == want: ret true end
i--
end
ret false
end
@en "ParseDTD"
@fa "تجزیه دی‌تی‌دی"
pub func ParseDTD(text: str): DTD:
ret parse_dtd_text(text)
end
@en "FreeDTD"
@fa "آزادسازی دی‌تی‌دی"
pub func FreeDTD(dtd &: DTD):
mut i := 0
until i < dtd.elements.len():
mut e := dtd.elements.get(i)
e.mixed.free()
i++
end
mut k := 0
until k < dtd.attributes.len():
mut a := dtd.attributes.get(k)
a.values.free()
k++
end
mut m := 0
until m < dtd.models.len():
mut node := dtd.models.get(m)
node.args.free()
m++
end
dtd.elements.free()
dtd.attributes.free()
dtd.notations.free()
dtd.models.free()
end
@en "FreeReport"
@fa "آزادسازی گزارش"
pub func FreeReport(r &: Report):
r.items.free()
end
@en "ReportText"
@fa "متن گزارش"
pub func ReportText(r: Report): str:
if r.ok: ret "" end
mut sb := str.NewBuilder()
mut i := 0
until i < r.items.len():
v := r.items.get(i)
if i > 0: str.BufAppendChar(sb, 10) end
str.BufAppend(sb, "line " + str.FromInt(v.line as i64) + ", column " + str.FromInt(v.col as i64) + ": " + v.message)
i++
end
out := str.BufStr(sb)
str.BufFree(sb)
ret out
end
@en "DeclaredElementCount"
@fa "شمار عنصرهای اعلام‌شده"
pub func DeclaredElementCount(dtd: DTD): int: ret dtd.elements.len() end
@en "DeclaredAttributeCount"
@fa "شمار ویژگی‌های اعلام‌شده"
pub func DeclaredAttributeCount(dtd: DTD): int: ret dtd.attributes.len() end
@en "Validate"
@fa "اعتبارسنجی"
pub func Validate(d: Document, dtd: DTD): Report:
mut r := Report {}
if not dtd.ok:
r.ok = false
r.items.push(Violation { message = dtd.message })
ret r
end
root := Root(d)
if root < 0:
r.ok = false
r.items.push(Violation { message = "the document has no root element" })
ret r
end
if str.Len(d.doctype) > 0 and Name(d, root) != d.doctype:
report_add(r, d, root, "the root element is <" + Name(d, root) + "> but the document type declares " + d.doctype)
end
mut ids := Vector {} as Vector<str>
mut idrefs := Vector {} as Vector<str>
mut idref_nodes := Vector {} as Vector<int>
check_element(d, dtd, r, root, ids, idrefs, idref_nodes)
mut i := 0
until i < idrefs.len():
mut known := false
mut k := 0
until k < ids.len():
if ids.get(k) == idrefs.get(i): known = true end
k++
end
if not known:
report_add(r, d, idref_nodes.get(i), "the reference \"" + idrefs.get(i) + "\" points at an ID no element carries")
end
i++
end
ids.free()
idrefs.free()
idref_nodes.free()
ret r
end
@en "ValidateInternalSubset"
@fa "اعتبارسنجی زیرمجموعه داخلی"
pub func ValidateInternalSubset(d: Document): Report:
mut dtd := parse_dtd_text(d.internal_subset)
r := Validate(d, dtd)
FreeDTD(dtd)
ret r
end
@en "CheckNamespaces"
@fa "بررسی فضای نام"
pub func CheckNamespaces(d: Document): Report:
mut r := Report {}
root := Root(d)
if root < 0: ret r end
mut prefixes := Vector {} as Vector<str>
mut uris := Vector {} as Vector<str>
namespace_walk(d, root, r, prefixes, uris)
prefixes.free()
uris.free()
ret r
end
@en "ApplyDefaults"
@fa "اعمال پیش فرض‌ها"
pub func ApplyDefaults(d &: Document, dtd: DTD): int:
root := Root(d)
if root < 0: ret 0 end
mut filled := 0
mut queue := Vector {} as Vector<int>
queue.push(root)
until queue.len() > 0:
id := queue.get(queue.len() - 1)
queue.pop()
element := Name(d, id)
mut k := 0
until k < dtd.attributes.len():
decl := dtd.attributes.get(k)
if decl.element == element and (decl.mode == DefaultValue or decl.mode == DefaultFixed) and not HasAttribute(d, id, decl.name):
SetAttribute(d, id, decl.name, decl.value)
filled++
end
k++
end
n := d.nodes.get(id)
mut i := n.children.len() - 1
until i >= 0:
child := n.children.get(i)
if d.nodes.get(child).kind == KindElement: queue.push(child) end
i--
end
end
queue.free()
ret filled
end
package xml
@en "EntityDepthLimit"
@fa "سقف عمق موجودیت"
pub const EntityDepthLimit := 32
@en "EntityExpansionLimit"
@fa "سقف گسترش موجودیت"
pub const EntityExpansionLimit := 262144
struct Scope:
pub prefixes: Vector<str> = Vector {}
pub uris: Vector<str> = Vector {}
pub marks: Vector<int> = Vector {}
end
struct Reader:
pub text: str = ""
pub n: int = 0
pub pos: int = 0
pub expanded: int = 0
pub line_starts: Vector<int> = Vector {}
end
struct ReadFail:
pub ok: bool = true
pub kind: ErrorKind = ErrorKind.Syntax
pub code: str = ""
pub message: str = ""
pub offset: int = 0
end
@en "ParseOptions"
@fa "گزینه‌های تجزیه"
pub struct ParseOptions:
@en "preserve_whitespace"
@fa "حفظ فاصله‌ها"
pub preserve_whitespace: bool = false
@en "keep_comments"
@fa "نگه‌داشتن توضیح‌ها"
pub keep_comments: bool = true
@en "keep_instructions"
@fa "نگه‌داشتن دستورها"
pub keep_instructions: bool = true
@en "namespaces"
@fa "فضای نام‌ها"
pub namespaces: bool = true
@en "expand_entities"
@fa "گسترش موجودیت‌ها"
pub expand_entities: bool = true
@en "max_depth"
@fa "بیشترین عمق"
pub max_depth: int = 1024
@en "max_entity_depth"
@fa "بیشترین عمق موجودیت"
pub max_entity_depth: int = EntityDepthLimit
@en "max_entity_expansion"
@fa "بیشترین گسترش موجودیت"
pub max_entity_expansion: int = EntityExpansionLimit
end
inline pure func xbp(s: str): i8*: ret (s as void*) as i8* end
inline pure func xub(p: i8*, i: int): int:
mut v := p[i] as int
if v < 0: v += 256 end
ret v
end
pure func xml_space(c: int): bool:
ret c == 32 or c == 9 or c == 10 or c == 13
end
pure func ascii_digit(c: int): bool: ret c >= 48 and c <= 57 end
pure func ascii_hex(c: int): bool:
ret (c >= 48 and c <= 57) or (c >= 97 and c <= 102) or (c >= 65 and c <= 70)
end
pure func name_start_cp(c: int): bool:
if c == 58 or c == 95: ret true end
if c >= 65 and c <= 90: ret true end
if c >= 97 and c <= 122: ret true end
if c >= 0xC0 and c <= 0xD6: ret true end
if c >= 0xD8 and c <= 0xF6: ret true end
if c >= 0xF8 and c <= 0x2FF: ret true end
if c >= 0x370 and c <= 0x37D: ret true end
if c >= 0x37F and c <= 0x1FFF: ret true end
if c >= 0x200C and c <= 0x200D: ret true end
if c >= 0x2070 and c <= 0x218F: ret true end
if c >= 0x2C00 and c <= 0x2FEF: ret true end
if c >= 0x3001 and c <= 0xD7FF: ret true end
if c >= 0xF900 and c <= 0xFDCF: ret true end
if c >= 0xFDF0 and c <= 0xFFFD: ret true end
if c >= 0x10000 and c <= 0xEFFFF: ret true end
ret false
end
pure func name_char_cp(c: int): bool:
if name_start_cp(c): ret true end
if c == 45 or c == 46: ret true end
if c >= 48 and c <= 57: ret true end
if c == 0xB7: ret true end
if c >= 0x300 and c <= 0x36F: ret true end
if c >= 0x203F and c <= 0x2040: ret true end
ret false
end
pure func valid_char_cp(c: int): bool:
if c == 9 or c == 10 or c == 13: ret true end
if c >= 32 and c <= 0xD7FF: ret true end
if c >= 0xE000 and c <= 0xFFFD: ret true end
if c >= 0x10000 and c <= 0x10FFFF: ret true end
ret false
end
func decode_cp(p: i8*, n: int, at: int, width &: int): int:
width = 1
b0 := xub(p, at)
if b0 < 0x80: ret b0 end
if b0 < 0xC0 or b0 >= 0xF8: ret 0 - 1 end
mut need := 1
if b0 >= 0xE0: need = 2 end
if b0 >= 0xF0: need = 3 end
if at + need >= n: ret 0 - 1 end
repeat need in k:
if (xub(p, at + 1 + k) & 0xC0) != 0x80: ret 0 - 1 end
end
if b0 >= 0xC0 and b0 < 0xE0 and at + 1 < n:
width = 2
ret ((b0 & 0x1F) << 6) | (xub(p, at + 1) & 0x3F)
end
if b0 >= 0xE0 and b0 < 0xF0 and at + 2 < n:
width = 3
ret ((b0 & 0x0F) << 12) | ((xub(p, at + 1) & 0x3F) << 6) | (xub(p, at + 2) & 0x3F)
end
if b0 >= 0xF0 and at + 3 < n:
width = 4
ret ((b0 & 0x07) << 18) | ((xub(p, at + 1) & 0x3F) << 12) | ((xub(p, at + 2) & 0x3F) << 6) | (xub(p, at + 3) & 0x3F)
end
ret 0 - 1
end
func index_lines(text: str): Vector<int>:
mut out := Vector {} as Vector<int>
out.push(0)
n := str.Len(text)
p := xbp(text)
mut i := 0
until i < n:
if xub(p, i) == 10: out.push(i + 1) end
i++
end
ret out
end
func line_of(starts &: Vector<int>, offset: int): int:
mut lo := 0
mut hi := starts.len() - 1
until lo < hi:
mid := (lo + hi + 1) / 2
if starts.get(mid) <= offset: lo = mid
else:
hi = mid - 1
end
end
ret lo
end
func fail_kind(err &: ReadFail, offset: int, kind: ErrorKind, code: str, message: str):
if not err.ok: ret end
err.ok = false
err.kind = kind
err.code = code
err.message = message
err.offset = offset
end
func fail_at(err &: ReadFail, offset: int, message: str):
fail_kind(err, offset, ErrorKind.Syntax, "", message)
end
func fail_end(err &: ReadFail, rd &: Reader, offset: int, code: str, message: str):
mut kind := ErrorKind.Syntax
if offset >= rd.n: kind = ErrorKind.UnexpectedEnd end
fail_kind(err, offset, kind, code, message)
end
func offset_of(rd &: Reader, line: int, col: int): int:
if line < 1 or line > rd.line_starts.len(): ret 0 end
ret rd.line_starts.get(line - 1) + col - 1
end
func encode_cp(sb &: str.StringBuilder, cp: int):
if cp < 0x80:
str.BufAppendChar(sb, cp)
else cp < 0x800:
str.BufAppendChar(sb, 0xC0 | (cp >> 6))
str.BufAppendChar(sb, 0x80 | (cp & 0x3F))
else cp < 0x10000:
str.BufAppendChar(sb, 0xE0 | (cp >> 12))
str.BufAppendChar(sb, 0x80 | ((cp >> 6) & 0x3F))
str.BufAppendChar(sb, 0x80 | (cp & 0x3F))
else:
str.BufAppendChar(sb, 0xF0 | (cp >> 18))
str.BufAppendChar(sb, 0x80 | ((cp >> 12) & 0x3F))
str.BufAppendChar(sb, 0x80 | ((cp >> 6) & 0x3F))
str.BufAppendChar(sb, 0x80 | (cp & 0x3F))
end
end
func scan_name(rd &: Reader, p: i8*, at: int, stop &: int): str:
mut i := at
mut width := 0
if i >= rd.n:
stop = i
ret ""
end
cp := decode_cp(p, rd.n, i, width)
if cp < 0 or not name_start_cp(cp):
stop = i
ret ""
end
i += width
until i < rd.n:
c := decode_cp(p, rd.n, i, width)
if c < 0 or not name_char_cp(c): break end
i += width
end
stop = i
ret str.Substr(rd.text, at, i - at)
end
func skip_space(rd &: Reader, p: i8*, at: int): int:
mut i := at
until i < rd.n and xml_space(xub(p, i)):
i++
end
ret i
end
func expand_entities(
d &: Document, rd &: Reader, raw: str, at: int, in_attribute: bool, opts: ParseOptions, depth: int,
err &: ReadFail
): str:
if not str.Contains(raw, "&"): ret str.Clone(raw) end
mut ceiling := opts.max_entity_depth
if ceiling <= 0: ceiling = EntityDepthLimit end
if depth > ceiling:
fail_kind(err, at, ErrorKind.OutOfRange, "xml.entity_limit", "an entity expands into itself, or nests deeper than the parser allows")
ret ""
end
mut budget := opts.max_entity_expansion
if budget <= 0: budget = EntityExpansionLimit end
if rd.expanded > budget:
fail_kind(err, at, ErrorKind.OutOfRange, "xml.entity_limit", "the entities in this document expand to more text than the parser allows")
ret ""
end
mut sb := str.NewBuilder()
n := str.Len(raw)
p := xbp(raw)
mut i := 0
until err.ok and i < n:
c := xub(p, i)
if c != 38:
str.BufAppendChar(sb, c)
i++
continue
end
semi := str.IndexFrom(raw, ";", i)
if semi < 0:
fail_at(err, at + i, "an entity reference has no closing semicolon")
break
end
body := str.Substr(raw, i + 1, semi - i - 1)
if str.Len(body) == 0:
fail_at(err, at + i, "an entity reference is empty")
break
end
if str.CharAt(body, 0) == "#":
mut cp := 0
mut good := true
if str.Len(body) > 2 and (str.CharAt(body, 1) == "x" or str.CharAt(body, 1) == "X"):
digits := str.Substr(body, 2, str.Len(body) - 2)
dn := str.Len(digits)
dp := xbp(digits)
if dn == 0: good = false end
mut k := 0
until good and k < dn:
ch := xub(dp, k)
if not ascii_hex(ch):
good = false
else:
mut v := 0
if ch >= 48 and ch <= 57: v = ch - 48
else ch >= 97 and ch <= 102: v = ch - 87
else:
v = ch - 55
end
cp = cp * 16 + v
end
k++
end
else:
digits := str.Substr(body, 1, str.Len(body) - 1)
dn := str.Len(digits)
dp := xbp(digits)
if dn == 0: good = false end
mut k := 0
until good and k < dn:
ch := xub(dp, k)
if not ascii_digit(ch): good = false
else:
cp = cp * 10 + (ch - 48)
end
k++
end
end
if not good:
fail_at(err, at + i, "\"&" + body + ";\" is not a character reference")
break
end
if not valid_char_cp(cp):
fail_at(err, at + i, "the character reference \"&" + body + ";\" is not a legal XML character")
break
end
encode_cp(sb, cp)
i = semi + 1
continue
end
if body == "amp": str.BufAppendChar(sb, 38)
else body == "lt": str.BufAppendChar(sb, 60)
else body == "gt": str.BufAppendChar(sb, 62)
else body == "quot": str.BufAppendChar(sb, 34)
else body == "apos": str.BufAppendChar(sb, 39)
else:
mut known := false
mut value := ""
mut e := 0
until e < d.entity_names.len():
if d.entity_names.get(e) == body:
known = true
value = d.entity_values.get(e)
end
e++
end
if not known:
fail_kind(err, at + i, ErrorKind.NotFound, "xml.undeclared_entity", "the entity \"&" + body + ";\" is not declared")
break
end
if in_attribute and str.Contains(value, "<"):
fail_at(err, at + i, "the entity \"&" + body + ";\" puts a '<' in an attribute value")
break
end
if opts.expand_entities:
piece := expand_entities(d, rd, value, at + i, in_attribute, opts, depth + 1, err)
if not err.ok: break end
rd.expanded = rd.expanded + str.Len(piece)
str.BufAppend(sb, piece)
release(piece)
if rd.expanded > budget:
fail_kind(err, at + i, ErrorKind.OutOfRange, "xml.entity_limit", "the entities in this document expand to more text than the parser allows")
break
end
else:
str.BufAppend(sb, "&" + body + ";")
end
end
i = semi + 1
end
out := str.BufStr(sb)
str.BufFree(sb)
ret out
end
func scope_push(sc &: Scope):
sc.marks.push(sc.prefixes.len())
end
func scope_pop(sc &: Scope):
if sc.marks.len() == 0: ret end
mark := sc.marks.get(sc.marks.len() - 1)
sc.marks.pop()
until sc.prefixes.len() > mark:
sc.prefixes.pop()
sc.uris.pop()
end
end
func scope_bind(sc &: Scope, prefix: str, uri: str):
sc.prefixes.push(prefix)
sc.uris.push(uri)
end
func scope_lookup(sc &: Scope, prefix: str, found &: bool): str:
found = false
if prefix == "xml":
found = true
ret XMLNamespaceURI
end
if prefix == "xmlns":
found = true
ret XMLNSNamespaceURI
end
mut i := sc.prefixes.len() - 1
until i >= 0:
if sc.prefixes.get(i) == prefix:
found = true
ret sc.uris.get(i)
end
i--
end
if prefix == "":
found = true
ret ""
end
ret ""
end
func scope_free(sc &: Scope):
sc.prefixes.free()
sc.uris.free()
sc.marks.free()
end
func split_qname(name: str, prefix &: str, local &: str): bool:
colon := str.IndexOf(name, ":")
if colon < 0:
prefix = ""
local = str.Clone(name)
ret true
end
if colon == 0 or colon == str.Len(name) - 1: ret false end
rest := str.Substr(name, colon + 1, str.Len(name) - colon - 1)
if str.Contains(rest, ":"): ret false end
prefix = str.Substr(name, 0, colon)
local = rest
ret true
end
func read_quoted(rd &: Reader, p: i8*, at: int, stop &: int, err &: ReadFail, what: str): str:
if at >= rd.n or (xub(p, at) != 34 and xub(p, at) != 39):
fail_at(err, at, what + " must be in quotes")
stop = at
ret ""
end
quote := xub(p, at)
mut i := at + 1
until i < rd.n and xub(p, i) != quote:
i++
end
if i >= rd.n:
fail_kind(err, at, ErrorKind.UnexpectedEnd, "xml.unclosed", what + " is never closed")
stop = rd.n
ret ""
end
stop = i + 1
ret str.Substr(rd.text, at + 1, i - at - 1)
end
func read_declaration(d &: Document, rd &: Reader, p: i8*, at: int, err &: ReadFail): int:
mut i := at + 5
i = skip_space(rd, p, i)
mut stop := i
key := own(d, scan_name(rd, p, i, stop))
if key != "version":
fail_at(err, i, "the XML declaration must start with version")
ret rd.n
end
i = skip_space(rd, p, stop)
if i >= rd.n or xub(p, i) != 61:
fail_at(err, i, "the XML declaration is missing '=' after version")
ret rd.n
end
i = skip_space(rd, p, i + 1)
d.version = own(d, read_quoted(rd, p, i, stop, err, "the version"))
if not err.ok: ret rd.n end
i = skip_space(rd, p, stop)
until i < rd.n and xub(p, i) != 63:
field := own(d, scan_name(rd, p, i, stop))
if str.Len(field) == 0:
fail_at(err, i, "the XML declaration holds something that is not a name")
ret rd.n
end
i = skip_space(rd, p, stop)
if i >= rd.n or xub(p, i) != 61:
fail_at(err, i, "the XML declaration is missing '=' after " + field)
ret rd.n
end
i = skip_space(rd, p, i + 1)
text := own(d, read_quoted(rd, p, i, stop, err, "the " + field + " value"))
if not err.ok: ret rd.n end
if field == "encoding": d.encoding = text
else field == "standalone":
if text != "yes" and text != "no":
fail_at(err, i, "standalone must be yes or no")
ret rd.n
end
d.standalone = text
else:
fail_at(err, i, "the XML declaration has no field called " + field)
ret rd.n
end
i = skip_space(rd, p, stop)
end
if i + 1 >= rd.n or xub(p, i) != 63 or xub(p, i + 1) != 62:
fail_end(err, rd, i, "xml.unclosed", "the XML declaration is never closed")
ret rd.n
end
ret i + 2
end
func register_entities(d &: Document, subset: str):
mut i := 0
until true:
at := str.IndexFrom(subset, "<!ENTITY", i)
if at < 0: break end
mut j := at + 8
n := str.Len(subset)
p := xbp(subset)
until j < n and xml_space(xub(p, j)):
j++
end
if j < n and xub(p, j) == 37:
i = at + 8
continue
end
start := j
until j < n and not xml_space(xub(p, j)) and xub(p, j) != 62:
j++
end
name := own(d, str.Substr(subset, start, j - start))
until j < n and xml_space(xub(p, j)):
j++
end
if j < n and (xub(p, j) == 34 or xub(p, j) == 39):
quote := xub(p, j)
vstart := j + 1
mut k := vstart
until k < n and xub(p, k) != quote:
k++
end
if str.Len(name) > 0:
d.entity_names.push(name)
d.entity_values.push(own(d, str.Substr(subset, vstart, k - vstart)))
end
i = k + 1
else:
i = at + 8
end
end
end
func read_doctype(d &: Document, rd &: Reader, p: i8*, at: int, err &: ReadFail): int:
mut i := skip_space(rd, p, at + 9)
mut stop := i
name := own(d, scan_name(rd, p, i, stop))
if str.Len(name) == 0:
fail_at(err, i, "the document type declaration has no name")
ret rd.n
end
d.doctype = name
i = skip_space(rd, p, stop)
word := own(d, scan_name(rd, p, i, stop))
if word == "PUBLIC":
i = skip_space(rd, p, stop)
d.doctype_public = own(d, read_quoted(rd, p, i, stop, err, "the public identifier"))
if not err.ok: ret rd.n end
i = skip_space(rd, p, stop)
d.doctype_system = own(d, read_quoted(rd, p, i, stop, err, "the system identifier"))
if not err.ok: ret rd.n end
i = skip_space(rd, p, stop)
else word == "SYSTEM":
i = skip_space(rd, p, stop)
d.doctype_system = own(d, read_quoted(rd, p, i, stop, err, "the system identifier"))
if not err.ok: ret rd.n end
i = skip_space(rd, p, stop)
else str.Len(word) > 0:
fail_at(err, i, "a document type declaration takes SYSTEM or PUBLIC, not " + word)
ret rd.n
end
if i < rd.n and xub(p, i) == 91:
mut depth := 1
mut j := i + 1
until j < rd.n and depth > 0:
c := xub(p, j)
if c == 91: depth++
else c == 93: depth--
end
j++
end
if depth > 0:
fail_kind(err, i, ErrorKind.UnexpectedEnd, "xml.unclosed", "the internal subset is never closed")
ret rd.n
end
d.internal_subset = own(d, str.Substr(rd.text, i + 1, j - i - 2))
register_entities(d, d.internal_subset)
i = skip_space(rd, p, j)
end
if i >= rd.n or xub(p, i) != 62:
fail_end(err, rd, i, "xml.unclosed", "the document type declaration is never closed")
ret rd.n
end
ret i + 1
end
func read_comment(
d &: Document, rd &: Reader, p: i8*, at: int, parent: int, opts: ParseOptions, err &: ReadFail
): int:
start := at + 4
mut i := start
until i + 2 < rd.n and not (xub(p, i) == 45 and xub(p, i + 1) == 45 and xub(p, i + 2) == 62):
if xub(p, i) == 45 and xub(p, i + 1) == 45:
fail_at(err, i, "a comment may not hold \"--\"")
ret rd.n
end
i++
end
if i + 2 >= rd.n:
fail_kind(err, at, ErrorKind.UnexpectedEnd, "xml.unclosed", "a comment is never closed")
ret rd.n
end
if opts.keep_comments:
id := CreateComment(d, own(d, str.Substr(rd.text, start, i - start)))
place(d, rd, id, parent, at)
end
ret i + 3
end
func read_instruction(
d &: Document, rd &: Reader, p: i8*, at: int, parent: int, opts: ParseOptions, err &: ReadFail
): int:
mut stop := at + 2
target := own(d, scan_name(rd, p, at + 2, stop))
if str.Len(target) == 0:
fail_at(err, at, "a processing instruction has no target")
ret rd.n
end
if str.EqualFold(target, "xml"):
fail_at(err, at, "\"xml\" is reserved and cannot be a processing instruction target")
ret rd.n
end
mut i := stop
mut close := 0 - 1
until i + 1 < rd.n and close < 0:
if xub(p, i) == 63 and xub(p, i + 1) == 62: close = i end
i++
end
if close < 0:
fail_kind(err, at, ErrorKind.UnexpectedEnd, "xml.unclosed", "a processing instruction is never closed")
ret rd.n
end
raw_data := str.Substr(rd.text, stop, close - stop)
data := own(d, str.Trim(raw_data))
release(raw_data)
if opts.keep_instructions:
id := CreateProcessingInstruction(d, target, data)
place(d, rd, id, parent, at)
end
ret close + 2
end
func read_cdata(d &: Document, rd &: Reader, p: i8*, at: int, parent: int, err &: ReadFail): int:
start := at + 9
mut i := start
mut close := 0 - 1
until i + 2 < rd.n and close < 0:
if xub(p, i) == 93 and xub(p, i + 1) == 93 and xub(p, i + 2) == 62: close = i end
i++
end
if close < 0:
fail_kind(err, at, ErrorKind.UnexpectedEnd, "xml.unclosed", "a CDATA section is never closed")
ret rd.n
end
id := CreateCData(d, own(d, str.Substr(rd.text, start, close - start)))
place(d, rd, id, parent, at)
ret close + 3
end
func place(d &: Document, rd &: Reader, id: int, parent: int, offset: int):
idx := line_of(rd.line_starts, offset)
mut n := d.nodes.get(id)
n.line = idx + 1
n.col = offset - rd.line_starts.get(idx) + 1
d.nodes.set(id, n)
attach(d, parent, id)
end
func all_space(text: str): bool:
n := str.Len(text)
p := xbp(text)
mut i := 0
until i < n:
if not xml_space(xub(p, i)): ret false end
i++
end
ret true
end
func read_text_run(
d &: Document, rd &: Reader, p: i8*, at: int, parent: int, opts: ParseOptions, err &: ReadFail
): int:
mut i := at
until i < rd.n and xub(p, i) != 60:
if xub(p, i) == 93 and i + 2 < rd.n and xub(p, i + 1) == 93 and xub(p, i + 2) == 62:
fail_at(err, i, "\"]]>\" may not appear in character data")
ret rd.n
end
mut width := 0
cp := decode_cp(p, rd.n, i, width)
if cp < 0:
fail_kind(err, i, ErrorKind.InvalidUtf8, "xml.invalid_utf8", "the document is not valid UTF-8")
ret rd.n
end
if not valid_char_cp(cp):
fail_kind(err, i, ErrorKind.Syntax, "xml.invalid_char", "the document holds a character XML does not allow")
ret rd.n
end
i += width
end
raw := str.Substr(rd.text, at, i - at)
if parent == 0:
outside := not all_space(raw)
release(raw)
if outside:
fail_at(err, at, "text is not allowed outside the root element")
ret rd.n
end
ret i
end
text := expand_entities(d, rd, raw, at, false, opts, 0, err)
release(raw)
if not err.ok:
release(text)
ret rd.n
end
if str.Len(text) == 0 or (not opts.preserve_whitespace and all_space(text)):
release(text)
ret i
end
id := CreateText(d, own(d, text))
place(d, rd, id, parent, at)
ret i
end
func read_attributes(
d &: Document, rd &: Reader, p: i8*, at: int, id: int, sc &: Scope, opts: ParseOptions,
self_closing &: bool, err &: ReadFail
): int:
mut i := at
self_closing = false
until err.ok:
before := i
i = skip_space(rd, p, i)
if i >= rd.n:
fail_kind(err, at, ErrorKind.UnexpectedEnd, "xml.unclosed_tag", "a start tag is never closed")
ret rd.n
end
c := xub(p, i)
if c == 62: ret i + 1 end
if c == 47:
if i + 1 >= rd.n or xub(p, i + 1) != 62:
fail_at(err, i, "'/' in a start tag must be followed by '>'")
ret rd.n
end
self_closing = true
ret i + 2
end
if i == before:
fail_at(err, i, "attributes must be separated by whitespace")
ret rd.n
end
mut stop := i
name := own(d, scan_name(rd, p, i, stop))
if str.Len(name) == 0:
fail_at(err, i, "an attribute name is missing")
ret rd.n
end
if HasAttribute(d, id, name):
fail_kind(err, i, ErrorKind.AlreadyExists, "xml.duplicate_attribute", "the attribute \"" + name + "\" is given twice")
ret rd.n
end
name_at := i
i = skip_space(rd, p, stop)
if i >= rd.n or xub(p, i) != 61:
fail_at(err, i, "the attribute \"" + name + "\" has no value")
ret rd.n
end
i = skip_space(rd, p, i + 1)
raw := read_quoted(rd, p, i, stop, err, "the value of \"" + name + "\"")
if not err.ok:
release(raw)
ret rd.n
end
if str.Contains(raw, "<"):
release(raw)
fail_at(err, i, "the attribute \"" + name + "\" holds a literal '<'")
ret rd.n
end
value := own(d, expand_entities(d, rd, raw, i + 1, true, opts, 0, err))
release(raw)
if not err.ok: ret rd.n end
mut prefix := ""
mut local := ""
if opts.namespaces:
if not split_qname(name, prefix, local):
fail_at(err, name_at, "\"" + name + "\" is not a valid qualified name")
ret rd.n
end
if str.Len(prefix) > 0: _kept := own(d, prefix) end
_kept_local := own(d, local)
else:
prefix = ""
local = name
end
idx := line_of(rd.line_starts, name_at)
d.attributes.push(
Attribute {
owner = id, name = name, prefix = prefix, local = local, value = value, line = idx + 1, col = name_at - rd.line_starts.get(idx) + 1
}
)
mut owner := d.nodes.get(id)
owner.attrs.push(d.attributes.len() - 1)
d.nodes.set(id, owner)
if opts.namespaces:
if name == "xmlns":
scope_bind(sc, "", value)
else prefix == "xmlns":
if str.Len(value) == 0:
fail_at(err, name_at, "the prefix \"" + local + "\" cannot be bound to an empty namespace")
ret rd.n
end
if local == "xmlns":
fail_at(err, name_at, "the prefix \"xmlns\" cannot be redeclared")
ret rd.n
end
if local == "xml" and value != XMLNamespaceURI:
fail_at(err, name_at, "the prefix \"xml\" can only be bound to " + XMLNamespaceURI)
ret rd.n
end
if value == XMLNSNamespaceURI:
fail_at(err, name_at, "no prefix may be bound to " + XMLNSNamespaceURI)
ret rd.n
end
scope_bind(sc, local, value)
end
end
i = stop
end
ret rd.n
end
func resolve_names(d &: Document, rd &: Reader, id: int, sc &: Scope, err &: ReadFail):
mut n := d.nodes.get(id)
mut found := false
uri := scope_lookup(sc, n.prefix, found)
if not found:
fail_kind(err, offset_of(rd, n.line, n.col), ErrorKind.NotFound, "xml.undeclared_prefix", "the namespace prefix \"" + n.prefix + "\" is not declared")
ret
end
n.uri = uri
d.nodes.set(id, n)
mut i := 0
until err.ok and i < n.attrs.len():
aid := n.attrs.get(i)
mut a := d.attributes.get(aid)
if str.Len(a.prefix) > 0 and a.prefix != "xmlns":
mut ok := false
au := scope_lookup(sc, a.prefix, ok)
if not ok:
fail_kind(err, offset_of(rd, a.line, a.col), ErrorKind.NotFound, "xml.undeclared_prefix", "the namespace prefix \"" + a.prefix + "\" is not declared")
ret
end
a.uri = au
d.attributes.set(aid, a)
end
mut j := 0
until err.ok and j < i:
b := d.attributes.get(n.attrs.get(j))
if str.Len(a.uri) > 0 and b.uri == a.uri and b.local == a.local:
fail_kind(err, offset_of(rd, a.line, a.col), ErrorKind.AlreadyExists, "xml.duplicate_attribute", "the attribute \"" + a.local + "\" is given twice in the same namespace")
ret
end
j++
end
i++
end
end
func parse_into(d &: Document, rd &: Reader, opts: ParseOptions, err &: ReadFail):
p := xbp(rd.text)
mut sc := Scope {}
mut stack := Vector {} as Vector<int>
mut parent := 0
mut seen_root := false
mut seen_doctype := false
mut i := 0
if rd.n >= 3 and xub(p, 0) == 0xEF and xub(p, 1) == 0xBB and xub(p, 2) == 0xBF: i = 3 end
if i + 5 <= rd.n and str.Substr(rd.text, i, 5) == "<?xml" and (i + 5 >= rd.n or xml_space(xub(p, i + 5)) or xub(p, i + 5) == 63):
i = read_declaration(d, rd, p, i, err)
end
until err.ok and i < rd.n:
c := xub(p, i)
if c != 60:
i = read_text_run(d, rd, p, i, parent, opts, err)
continue
end
if i + 1 >= rd.n:
fail_kind(err, i, ErrorKind.UnexpectedEnd, "", "the document ends with '<'")
break
end
c1 := xub(p, i + 1)
if c1 == 33:
if i + 3 < rd.n and xub(p, i + 2) == 45 and xub(p, i + 3) == 45:
i = read_comment(d, rd, p, i, parent, opts, err)
continue
end
if i + 8 < rd.n and str.Substr(rd.text, i + 2, 7) == "[CDATA[":
if parent == 0:
fail_at(err, i, "a CDATA section is not allowed outside the root element")
break
end
i = read_cdata(d, rd, p, i, parent, err)
continue
end
if i + 9 <= rd.n and str.Substr(rd.text, i + 2, 7) == "DOCTYPE":
if seen_doctype:
fail_at(err, i, "there is more than one document type declaration")
break
end
if seen_root:
fail_at(err, i, "the document type declaration must come before the root element")
break
end
seen_doctype = true
i = read_doctype(d, rd, p, i, err)
continue
end
fail_at(err, i, "\"<!\" starts nothing the parser knows")
break
end
if c1 == 63:
i = read_instruction(d, rd, p, i, parent, opts, err)
continue
end
if c1 == 47:
mut stop := i + 2
name := scan_name(rd, p, i + 2, stop)
if stack.len() == 0:
fail_kind(err, i, ErrorKind.Syntax, "xml.unexpected_end_tag", "</" + name + "> closes an element that never opened")
release(name)
break
end
top := stack.get(stack.len() - 1)
if d.nodes.get(top).name != name:
fail_kind(err, i, ErrorKind.Syntax, "xml.mismatched_tag", "</" + name + "> closes <" + d.nodes.get(top).name + ">")
release(name)
break
end
j := skip_space(rd, p, stop)
if j >= rd.n or xub(p, j) != 62:
fail_end(err, rd, j, "xml.unclosed_tag", "the end tag </" + name + "> is never closed")
release(name)
break
end
release(name)
stack.pop()
if opts.namespaces: scope_pop(sc) end
parent = d.nodes.get(top).parent
i = j + 1
continue
end
mut stop := i + 1
name := own(d, scan_name(rd, p, i + 1, stop))
if str.Len(name) == 0:
fail_at(err, i + 1, "an element name is missing or starts with a character XML does not allow")
break
end
if parent == 0 and seen_root:
fail_kind(err, i, ErrorKind.Syntax, "xml.multiple_roots", "a document may hold only one root element, and <" + name + "> is a second")
break
end
if stack.len() >= opts.max_depth:
fail_kind(err, i, ErrorKind.OutOfRange, "xml.too_deep", "the element nesting is deeper than the parser allows")
break
end
id := new_element(d, name)
if opts.namespaces:
mut prefix := ""
mut local := ""
if not split_qname(name, prefix, local):
fail_at(err, i + 1, "\"" + name + "\" is not a valid qualified name")
break
end
mut e := d.nodes.get(id)
if str.Len(prefix) > 0: e.prefix = own(d, prefix) end
e.local = own(d, local)
d.nodes.set(id, e)
scope_push(sc)
end
place(d, rd, id, parent, i)
mut self_closing := false
i = read_attributes(d, rd, p, stop, id, sc, opts, self_closing, err)
if not err.ok: break end
if opts.namespaces:
resolve_names(d, rd, id, sc, err)
if not err.ok: break end
end
if parent == 0: seen_root = true end
if self_closing:
if opts.namespaces: scope_pop(sc) end
else:
stack.push(id)
parent = id
end
end
if err.ok and stack.len() > 0:
last := stack.get(stack.len() - 1)
fail_kind(err, offset_of(rd, d.nodes.get(last).line, d.nodes.get(last).col), ErrorKind.UnexpectedEnd, "xml.unclosed_tag", "<" + d.nodes.get(last).name + "> is never closed")
end
if err.ok and not seen_root:
fail_kind(err, rd.n, ErrorKind.UnexpectedEnd, "xml.no_root", "the document has no root element")
end
stack.free()
scope_free(sc)
end
func read_document(text: str, opts: ParseOptions, err &: ReadFail): Document:
mut d := NewDocument()
d.version = ""
d.encoding = ""
mut rd := Reader { text = text, n = str.Len(text) }
rd.line_starts = index_lines(text)
parse_into(d, rd, opts, err)
rd.line_starts.free()
ret d
end
@en "DefaultOptions"
@fa "گزینه‌های پیش فرض"
pub func DefaultOptions(): ParseOptions:
ret ParseOptions {
keep_comments = true, keep_instructions = true, namespaces = true, expand_entities = true,
max_depth = 1024, max_entity_depth = EntityDepthLimit, max_entity_expansion = EntityExpansionLimit
}
end
@en "ParseWith"
@fa "تجزیه سفارشی"
pub func ParseWith(text: str, opts: ParseOptions): Document throws:
mut err := ReadFail {}
mut d := read_document(text, opts, err)
if not err.ok:
Free(d)
throw Error.At(err.kind, err.message, err.offset).with_code(err.code).locate(text).wrap("xml")
end
ret d
end
@en "Parse"
@fa "تجزیه"
pub func Parse(text: str): Document throws:
ret try ParseWith(text, DefaultOptions())
end
@en "WellFormed"
@fa "خوش‌ساخت است"
pub func WellFormed(text: str): bool:
mut err := ReadFail {}
mut d := read_document(text, DefaultOptions(), err)
Free(d)
ret err.ok
end
package xml
@en "WriteOptions"
@fa "گزینه‌های نوشتن"
pub struct WriteOptions:
@en "indent"
@fa "تورفتگی"
pub indent: str = ""
@en "newline"
@fa "خط تازه"
pub newline: str = "\n"
@en "declaration"
@fa "اعلان"
pub declaration: bool = false
@en "doctype"
@fa "نوع سند"
pub doctype: bool = false
@en "empty_as_pair"
@fa "عنصر خالی جفتی"
pub empty_as_pair: bool = false
@en "sort_attributes"
@fa "مرتب‌سازی ویژگی‌ها"
pub sort_attributes: bool = false
@en "escape_newlines_in_attributes"
@fa "کدکردن خط تازه ویژگی‌ها"
pub escape_newlines_in_attributes: bool = false
end
func escape_into(sb &: str.StringBuilder, text: str, in_attribute: bool, escape_breaks: bool):
n := str.Len(text)
p := xbp(text)
mut i := 0
until i < n:
c := xub(p, i)
if c == 38: str.BufAppend(sb, "&amp;")
else c == 60: str.BufAppend(sb, "&lt;")
else c == 62: str.BufAppend(sb, "&gt;")
else c == 34 and in_attribute: str.BufAppend(sb, "&quot;")
else c == 39 and in_attribute: str.BufAppend(sb, "&apos;")
else c == 13: str.BufAppend(sb, "&#xD;")
else c == 10 and in_attribute and escape_breaks: str.BufAppend(sb, "&#xA;")
else c == 9 and in_attribute and escape_breaks: str.BufAppend(sb, "&#x9;")
else:
str.BufAppendChar(sb, c)
end
i++
end
end
func sorted_attribute_ids(d: Document, id: int): Vector<int>:
n := node_at(d, id)
mut out := Vector {} as Vector<int>
mut i := 0
until i < n.attrs.len():
out.push(n.attrs.get(i))
i++
end
mut a := 0
until a < out.len():
mut b := a + 1
until b < out.len():
x := d.attributes.get(out.get(a))
y := d.attributes.get(out.get(b))
mut swap := false
if x.uri > y.uri: swap = true
else x.uri == y.uri and x.local > y.local: swap = true
end
if swap:
keep_id := out.get(a)
out.set(a, out.get(b))
out.set(b, keep_id)
end
b++
end
a++
end
ret out
end
func has_element_child(d: Document, id: int): bool:
n := node_at(d, id)
mut i := 0
until i < n.children.len():
if node_at(d, n.children.get(i)).kind == KindElement: ret true end
i++
end
ret false
end
func write_node(d: Document, id: int, sb &: str.StringBuilder, opts: WriteOptions, depth: int, inline_only: bool):
n := node_at(d, id)
pretty := str.Len(opts.indent) > 0 and not inline_only
if n.kind == KindText:
escape_into(sb, n.value, false, false)
ret
end
if n.kind == KindCData:
str.BufAppend(sb, "<![CDATA[" + n.value + "]]>")
ret
end
if n.kind == KindComment:
if pretty: str.BufAppend(sb, str.Repeat(opts.indent, depth)) end
str.BufAppend(sb, "<!--" + n.value + "-->")
if pretty: str.BufAppend(sb, opts.newline) end
ret
end
if n.kind == KindProcessingInstruction:
if pretty: str.BufAppend(sb, str.Repeat(opts.indent, depth)) end
str.BufAppend(sb, "<?" + n.name)
if str.Len(n.value) > 0: str.BufAppend(sb, " " + n.value) end
str.BufAppend(sb, "?>")
if pretty: str.BufAppend(sb, opts.newline) end
ret
end
if n.kind != KindElement:
mut i := 0
until i < n.children.len():
write_node(d, n.children.get(i), sb, opts, depth, inline_only)
i++
end
ret
end
if pretty: str.BufAppend(sb, str.Repeat(opts.indent, depth)) end
str.BufAppend(sb, "<" + n.name)
mut ids := Vector {} as Vector<int>
if opts.sort_attributes:
ids = sorted_attribute_ids(d, id)
else:
mut k := 0
until k < n.attrs.len():
ids.push(n.attrs.get(k))
k++
end
end
mut a := 0
until a < ids.len():
at := d.attributes.get(ids.get(a))
str.BufAppend(sb, " " + at.name + "=\"")
escape_into(sb, at.value, true, opts.escape_newlines_in_attributes)
str.BufAppendChar(sb, 34)
a++
end
ids.free()
if n.children.len() == 0:
if opts.empty_as_pair: str.BufAppend(sb, "></" + n.name + ">")
else:
str.BufAppend(sb, "/>")
end
if pretty: str.BufAppend(sb, opts.newline) end
ret
end
str.BufAppendChar(sb, 62)
block := pretty and has_element_child(d, id)
if block: str.BufAppend(sb, opts.newline) end
mut i := 0
until i < n.children.len():
child := n.children.get(i)
if block:
write_node(d, child, sb, opts, depth + 1, false)
else:
write_node(d, child, sb, opts, 0, true)
end
i++
end
if block: str.BufAppend(sb, str.Repeat(opts.indent, depth)) end
str.BufAppend(sb, "</" + n.name + ">")
if pretty: str.BufAppend(sb, opts.newline) end
end
func write_prolog(d: Document, sb &: str.StringBuilder, opts: WriteOptions):
if opts.declaration:
mut version := d.version
if str.Len(version) == 0: version = "1.0" end
str.BufAppend(sb, "<?xml version=\"" + version + "\"")
if str.Len(d.encoding) > 0: str.BufAppend(sb, " encoding=\"" + d.encoding + "\"") end
if str.Len(d.standalone) > 0: str.BufAppend(sb, " standalone=\"" + d.standalone + "\"") end
str.BufAppend(sb, "?>" + opts.newline)
end
if opts.doctype and str.Len(d.doctype) > 0:
str.BufAppend(sb, "<!DOCTYPE " + d.doctype)
if str.Len(d.doctype_public) > 0:
str.BufAppend(sb, " PUBLIC \"" + d.doctype_public + "\" \"" + d.doctype_system + "\"")
else str.Len(d.doctype_system) > 0:
str.BufAppend(sb, " SYSTEM \"" + d.doctype_system + "\"")
end
if str.Len(d.internal_subset) > 0:
str.BufAppend(sb, " [" + d.internal_subset + "]")
end
str.BufAppend(sb, ">" + opts.newline)
end
end
func render(d: Document, id: int, opts: WriteOptions, prolog: bool): str:
mut sb := str.NewBuilder()
if prolog: write_prolog(d, sb, opts) end
write_node(d, id, sb, opts, 0, false)
out := str.BufStr(sb)
str.BufFree(sb)
ret out
end
@en "DefaultWriteOptions"
@fa "گزینه‌های نوشتن پیش فرض"
pub func DefaultWriteOptions(): WriteOptions:
ret WriteOptions { indent = "", newline = "\n" }
end
@en "Write"
@fa "نوشتن"
pub func Write(d: Document): str:
ret render(d, DocumentNode(d), DefaultWriteOptions(), false)
end
@en "WriteIndent"
@fa "نوشتن با تورفتگی"
pub func WriteIndent(d: Document, unit: str): str:
mut opts := DefaultWriteOptions()
opts.indent = unit
ret render(d, DocumentNode(d), opts, false)
end
@en "WriteWith"
@fa "نوشتن سفارشی"
pub func WriteWith(d: Document, opts: WriteOptions): str:
ret render(d, DocumentNode(d), opts, true)
end
@en "WriteNode"
@fa "نوشتن گره"
pub func WriteNode(d: Document, id: int): str:
ret render(d, id, DefaultWriteOptions(), false)
end
@en "WriteNodeIndent"
@fa "نوشتن گره با تورفتگی"
pub func WriteNodeIndent(d: Document, id: int, unit: str): str:
mut opts := DefaultWriteOptions()
opts.indent = unit
ret render(d, id, opts, false)
end
@en "WriteDocument"
@fa "نوشتن سند"
pub func WriteDocument(d: Document): str:
mut opts := DefaultWriteOptions()
opts.declaration = true
opts.doctype = true
body := render(d, DocumentNode(d), opts, true)
if str.EndsWith(body, opts.newline): ret body end
ret body + opts.newline
end
@en "Canonical"
@fa "شکل استاندارد"
pub func Canonical(d: Document): str:
mut opts := DefaultWriteOptions()
opts.empty_as_pair = true
opts.sort_attributes = true
opts.escape_newlines_in_attributes = true
ret render(d, DocumentNode(d), opts, false)
end
@en "CanonicalNode"
@fa "شکل استاندارد گره"
pub func CanonicalNode(d: Document, id: int): str:
mut opts := DefaultWriteOptions()
opts.empty_as_pair = true
opts.sort_attributes = true
opts.escape_newlines_in_attributes = true
ret render(d, id, opts, false)
end
@en "xml"
@fa "اکس‌ام‌ال"
package xml
import encoding.value
import str
import math
import mem
@en "XMLTokStartElement"
@fa "نشانه آغاز عنصر"
pub const XMLTokStartElement := 1
@en "XMLTokEndElement"
@fa "نشانه انتهای عنصر"
pub const XMLTokEndElement := 2
@en "XMLTokText"
@fa "نشانه متن"
pub const XMLTokText := 3
@en "XMLTokComment"
@fa "نشانه توضیح"
pub const XMLTokComment := 4
@en "XMLTokCData"
@fa "نشانه سی‌دیتا"
pub const XMLTokCData := 5
@en "XMLTokEOF"
@fa "نشانه اتمام"
pub const XMLTokEOF := 6
@en "XMLTokError"
@fa "نشانه خطا"
pub const XMLTokError := 7
@en "XMLNode"
@fa "گره ساده"
pub struct XMLNode:
@en "tag"
@fa "نام عنصر"
pub tag: str = ""
@en "attrs"
@fa "ویژگی‌ها"
pub attrs: HashMap<str, str> = HashMap {} as HashMap<str, str>
@en "children"
@fa "فرزندان"
pub children: Vector<XMLNode> = Vector {}
@en "text"
@fa "متن"
pub text: str = ""
end
@en "XMLNodeList"
@fa "فهرست گره ساده"
pub struct XMLNodeList:
@en "items"
@fa "گره‌ها"
pub items: Vector<XMLNode> = Vector {}
end
@en "XMLToken"
@fa "نشانه اکس‌ام‌ال"
pub struct XMLToken:
@en "kind"
@fa "نوع"
pub kind: int = 0
@en "tag"
@fa "نام عنصر"
pub tag: str = ""
@en "attrs"
@fa "ویژگی‌ها"
pub attrs: HashMap<str, str> = HashMap {} as HashMap<str, str>
@en "text"
@fa "متن"
pub text: str = ""
end
@en "XMLTokenizer"
@fa "نشانه‌خوان اکس‌ام‌ال"
pub struct XMLTokenizer:
@en "text"
@fa "متن"
pub text: str = ""
@en "pos"
@fa "جایگاه"
pub pos: int = 0
@en "bad"
@fa "خراب"
pub bad: bool = false
@en "pendingEnd"
@fa "انتهای معلق"
pub pendingEnd: str = ""
end
inline pure func _bp(s: str): i8*: ret (s as void*) as i8* end
inline pure func _ub(bp: i8*, i: int): int:
mut v := bp[i] as int
if v < 0: v += 256 end
ret v
end
func _is_ws(c: int): bool: ret c == 32 or c == 9 or c == 10 or c == 13 end
func _is_name_char(c: int): bool:
ret (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or (c >= 48 and c <= 57) or c == 45 or c == 95 or c == 46 or c == 58
end
func _xsub(s: str, start: int, cnt: int): str:
bp := _bp(s)
mut sb := str.NewBuilder()
mut k := 0
until k < cnt:
str.BufAppendChar(sb, bp[start + k] as int)
k++
end
out := str.BufStr(sb)
str.BufFree(sb)
ret out
end
func _xat(bp: i8*, at: int, lit: str): bool:
lp := _bp(lit)
mut k := 0
until lp[k] != (0 as i8):
if bp[at + k] != lp[k]: ret false end
k++
end
ret true
end
func _skip_ws(s: str, n: int, i: int): int:
bp := _bp(s)
mut p := i
until p < n and _is_ws(_ub(bp, p)):
p++
end
ret p
end
func _scan_name(s: str, n: int, i: int, endpos &: int): str:
bp := _bp(s)
mut p := i
until p < n and _is_name_char(_ub(bp, p)):
p++
end
endpos = p
ret _xsub(s, i, p - i)
end
func _hex_digit(c: int): int:
if c >= 48 and c <= 57: ret c - 48 end
if c >= 97 and c <= 102: ret c - 97 + 10 end
if c >= 65 and c <= 70: ret c - 65 + 10 end
ret 0
end
func _hex_val(s: str): int:
n := s.len()
bp := _bp(s)
mut out := 0
mut i := 0
until i < n:
out = out * 16 + _hex_digit(_ub(bp, i))
i++
end
ret out
end
func _unescape(s: str): str:
mut sb := str.NewBuilder()
n := s.len()
bp := _bp(s)
mut i := 0
until i < n:
c := _ub(bp, i)
if c == 38:
semi := str.IndexFrom(s, ";", i)
if semi > i and semi - i <= 10:
ent := s.substr(i + 1, semi - i - 1)
if ent == "amp": str.BufAppendChar(sb, 38)
else ent == "lt": str.BufAppendChar(sb, 60)
else ent == "gt": str.BufAppendChar(sb, 62)
else ent == "quot": str.BufAppendChar(sb, 34)
else ent == "apos": str.BufAppendChar(sb, 39)
else ent.len() > 1 and str.CharAt(ent, 0) == "#":
mut code := 0
if ent.len() > 2 and (str.CharAt(ent, 1) == "x" or str.CharAt(ent, 1) == "X"):
code = _hex_val(ent.substr(2, ent.len() - 2))
else:
code = ent.substr(1, ent.len() - 1).to_int()
end
encode_cp(sb, code)
else:
str.BufAppend(sb, "&")
str.BufAppend(sb, ent)
str.BufAppend(sb, ";")
end
i = semi + 1
else:
str.BufAppendChar(sb, c)
i++
end
else:
str.BufAppendChar(sb, c)
i++
end
end
out := str.BufStr(sb)
str.BufFree(sb)
ret out
end
func _parse_attrs(s: str, n: int, i: int, endpos &: int, attrs &: HashMap<str, str>, selfClose &: bool):
bp := _bp(s)
mut p := i
selfClose = false
until true:
p = _skip_ws(s, n, p)
if p >= n:
endpos = p
ret
end
c := _ub(bp, p)
if c == 47:
selfClose = true
p++
p = _skip_ws(s, n, p)
if p < n and _ub(bp, p) == 62:
endpos = p + 1
ret
end
endpos = p
ret
end
if c == 62:
endpos = p + 1
ret
end
mut nend := p
name := _scan_name(s, n, p, nend)
if name.len() == 0:
endpos = p
ret
end
p = _skip_ws(s, n, nend)
mut avalue := ""
if p < n and _ub(bp, p) == 61:
p = _skip_ws(s, n, p + 1)
if p < n and (_ub(bp, p) == 34 or _ub(bp, p) == 39):
q := _ub(bp, p)
vstart := p + 1
mut vend := vstart
until vend < n and _ub(bp, vend) != q:
vend++
end
rawv := _xsub(s, vstart, vend - vstart)
avalue = _unescape(rawv)
mem.Free(rawv as void *)
p = vend + 1
end
end
attrs.put(name, avalue)
end
end
func _next_token(tz &: XMLTokenizer, n: int): XMLToken:
if tz.pendingEnd.len() > 0:
mut tok := XMLToken { kind = XMLTokEndElement }
tok.tag = tz.pendingEnd
tz.pendingEnd = ""
ret tok
end
s := tz.text
bp := _bp(s)
p := tz.pos
if p >= n:
ret XMLToken { kind = XMLTokEOF }
end
c := _ub(bp, p)
if c == 60:
c1 := _ub(bp, p + 1)
if c1 == 33 and p + 3 < n and _ub(bp, p + 2) == 45 and _ub(bp, p + 3) == 45:
mut e := p + 4
until e + 2 < n and not (_ub(bp, e) == 45 and _ub(bp, e + 1) == 45 and _ub(bp, e + 2) == 62):
e++
end
mut tok := XMLToken { kind = XMLTokComment }
tok.text = _xsub(s, p + 4, e - (p + 4))
tz.pos = e + 3
ret tok
end
if c1 == 33 and p + 8 < n and _xat(bp, p + 2, "[CDATA["):
start := p + 9
mut e := start
until e + 2 < n and not (_ub(bp, e) == 93 and _ub(bp, e + 1) == 93 and _ub(bp, e + 2) == 62):
e++
end
mut tok := XMLToken { kind = XMLTokCData }
tok.text = _xsub(s, start, e - start)
tz.pos = e + 3
ret tok
end
if c1 == 33 or c1 == 63:
mut e := p + 2
until e < n and _ub(bp, e) != 62:
e++
end
tz.pos = e + 1
ret _next_token(tz, n)
end
if c1 == 47:
mut nend := p + 2
name := _scan_name(s, n, p + 2, nend)
mut e := nend
until e < n and _ub(bp, e) != 62:
e++
end
tz.pos = e + 1
mut tok := XMLToken { kind = XMLTokEndElement }
tok.tag = name
ret tok
end
mut nend := p + 1
name := _scan_name(s, n, p + 1, nend)
mut attrs := HashMap {} as HashMap<str, str>
mut ep := nend
mut selfClose := false
_parse_attrs(s, n, nend, ep, attrs, selfClose)
tz.pos = ep
mut tok := XMLToken { kind = XMLTokStartElement }
tok.tag = name
tok.attrs = attrs
if selfClose: tz.pendingEnd = name end
ret tok
end
mut e := p
until e < n and _ub(bp, e) != 60:
e++
end
raw := _xsub(s, p, e - p)
tz.pos = e
mut tok := XMLToken { kind = XMLTokText }
tok.text = _unescape(raw)
mem.Free(raw as void *)
ret tok
end
func _encode_node(sb &: str.StringBuilder, node: XMLNode, unit: str, depth: int):
if unit.len() > 0:
mut d := 0
until d < depth:
str.BufAppend(sb, unit)
d++
end
end
str.BufAppendChar(sb, 60)
str.BufAppend(sb, node.tag)
mut it := node.attrs.iter()
until it.has_next():
str.BufAppendChar(sb, 32)
str.BufAppend(sb, it.key())
str.BufAppend(sb, "=\"")
str.BufAppend(sb, _escape_attr(it.value()))
str.BufAppendChar(sb, 34)
it.next()
end
if node.children.len() == 0 and node.text.len() == 0:
str.BufAppend(sb, "/>")
if unit.len() > 0: str.BufAppendChar(sb, 10) end
ret
end
str.BufAppendChar(sb, 62)
if node.text.len() > 0:
str.BufAppend(sb, _escape_text(node.text))
end
if node.children.len() > 0:
if unit.len() > 0: str.BufAppendChar(sb, 10) end
mut i := 0
until i < node.children.len():
_encode_node(sb, node.children.get(i), unit, depth + 1)
i++
end
if unit.len() > 0:
mut d := 0
until d < depth:
str.BufAppend(sb, unit)
d++
end
end
end
str.BufAppend(sb, "</")
str.BufAppend(sb, node.tag)
str.BufAppendChar(sb, 62)
if unit.len() > 0: str.BufAppendChar(sb, 10) end
end
func _escape_text(s: str): str:
mut sb := str.NewBuilder()
n := s.len()
bp := _bp(s)
mut i := 0
until i < n:
c := _ub(bp, i)
if c == 38: str.BufAppend(sb, "&amp;")
else c == 60: str.BufAppend(sb, "&lt;")
else c == 62: str.BufAppend(sb, "&gt;")
else:
str.BufAppendChar(sb, c)
end
i++
end
out := str.BufStr(sb)
str.BufFree(sb)
ret out
end
func _escape_attr(s: str): str:
mut sb := str.NewBuilder()
n := s.len()
bp := _bp(s)
mut i := 0
until i < n:
c := _ub(bp, i)
if c == 38: str.BufAppend(sb, "&amp;")
else c == 60: str.BufAppend(sb, "&lt;")
else c == 34: str.BufAppend(sb, "&quot;")
else:
str.BufAppendChar(sb, c)
end
i++
end
out := str.BufStr(sb)
str.BufFree(sb)
ret out
end
func _value_text(v: value.Value): str:
if value.IsString(v): ret value.AsString(v) end
if value.IsInt(v): ret str.FromInt(value.AsInt(v)) end
if value.IsFloat(v): ret str.FromFloat(value.AsFloat(v)) end
if value.IsBool(v):
if value.AsBool(v): ret "true" end
ret "false"
end
ret ""
end
func _simple_node(d: Document, id: int): XMLNode:
n := node_at(d, id)
mut node := XMLNode { tag = str.Clone(n.name) }
each aid in n.attrs:
a := d.attributes.get(aid)
node.attrs.put(str.Clone(a.name), str.Clone(a.value))
end
mut sb := str.NewBuilder()
each child in n.children:
c := node_at(d, child)
if c.kind == KindElement:
node.children.push(_simple_node(d, child))
else c.kind == KindText or c.kind == KindCData:
str.BufAppend(sb, c.value)
end
end
node.text = str.BufStr(sb)
str.BufFree(sb)
ret node
end
func _simple_options(): ParseOptions:
mut opts := DefaultOptions()
opts.preserve_whitespace = true
opts.keep_comments = false
opts.keep_instructions = false
opts.namespaces = false
ret opts
end
@en "UnescapeEntities"
@fa "بازگردانی موجودیت‌ها"
pub func UnescapeEntities(s: str): str: ret _unescape(s) end
@en "EscapeText"
@fa "اسکیپ متن"
pub func EscapeText(s: str): str: ret _escape_text(s) end
@en "EscapeAttr"
@fa "اسکیپ ویژگی"
pub func EscapeAttr(s: str): str: ret _escape_attr(s) end
@en "NewXMLTokenizer"
@fa "نشانه‌خوان جدید"
pub func NewXMLTokenizer(text: str): XMLTokenizer:
ret XMLTokenizer { text = text }
end
@en "NextToken"
@fa "نشانه بعدی"
pub func NextToken(tz &: XMLTokenizer): XMLToken:
ret _next_token(tz, tz.text.len())
end
@en "NewXMLNode"
@fa "گره ساده جدید"
pub func NewXMLNode(tag: str): XMLNode:
ret XMLNode { tag = tag }
end
@en "Found"
@fa "پیدا شد"
pub func Found(n: XMLNode): bool: ret n.tag != "" end
@en "HasAttr"
@fa "دارای ویژگی"
pub func HasAttr(node: XMLNode, name: str): bool: ret node.attrs.has(name) end
@en "Attr"
@fa "ویژگی گره"
pub func Attr(node: XMLNode, name: str): str:
if node.attrs.has(name): ret node.attrs.get(name) end
ret ""
end
@en "SetAttr"
@fa "تنظیم ویژگی گره"
pub func SetAttr(node &: XMLNode, name: str, value: str):
node.attrs.put(name, value)
end
@en "AppendChild"
@fa "افزودن گره فرزند"
pub func AppendChild(node &: XMLNode, child: XMLNode):
node.children.push(child)
end
@en "Child"
@fa "فرزند"
pub func Child(node: XMLNode, tag: str): XMLNode:
mut i := 0
until i < node.children.len():
c := node.children.get(i)
if c.tag == tag: ret c end
i++
end
ret XMLNode {}
end
@en "Children"
@fa "فرزندان"
pub func Children(node: XMLNode, tag: str): XMLNodeList:
mut out := XMLNodeList {}
mut i := 0
until i < node.children.len():
c := node.children.get(i)
if c.tag == tag: out.items.push(c) end
i++
end
ret out
end
@en "Decode"
@fa "کدگشایی"
pub func Decode(text: str): XMLNode throws:
mut d := try ParseWith(text, _simple_options())
node := _simple_node(d, Root(d))
Free(d)
ret node
end
@en "Valid"
@fa "معتبر"
pub func Valid(text: str): bool:
mut err := ReadFail {}
mut d := read_document(text, _simple_options(), err)
Free(d)
ret err.ok
end
@en "Encode"
@fa "کدگذاری"
pub func Encode(node: XMLNode): str:
mut sb := str.NewBuilder()
_encode_node(sb, node, "", 0)
out := str.BufStr(sb)
str.BufFree(sb)
ret out
end
@en "EncodeIndent"
@fa "کدگذاری با تورفتگی"
pub func EncodeIndent(node: XMLNode, unit: str): str:
mut sb := str.NewBuilder()
_encode_node(sb, node, unit, 0)
out := str.BufStr(sb)
str.BufFree(sb)
ret out
end
@en "EncodeDeclaration"
@fa "کدگذاری با اعلان"
pub func EncodeDeclaration(node: XMLNode): str:
ret "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n".concat(Encode(node))
end
@en "ToValue"
@fa "به مقدار"
pub func ToValue(node: XMLNode): value.Value:
mut out := value.NewValueObject()
mut it := node.attrs.iter()
until it.has_next():
value.ObjectSet(out, "@".concat(it.key()), value.ValueString(it.value()))
it.next()
end
if node.children.len() == 0:
if value.ObjectLen(out) == 0:
ret value.ValueString(node.text)
end
if node.text.len() > 0:
value.ObjectSet(out, "#text", value.ValueString(node.text))
end
ret out
end
mut i := 0
until i < node.children.len():
c := node.children.get(i)
childVal := ToValue(c)
if value.ObjectHas(out, c.tag):
mut existing := value.ObjectGet(out, c.tag)
if value.IsArray(existing):
value.ArrayPush(existing, childVal)
else:
mut arr := value.NewValueArray()
value.ArrayPush(arr, existing)
value.ArrayPush(arr, childVal)
existing = arr
end
value.ObjectSet(out, c.tag, existing)
else:
value.ObjectSet(out, c.tag, childVal)
end
i++
end
ret out
end
@en "FromValue"
@fa "از مقدار"
pub func FromValue(v: value.Value, rootTag: str): XMLNode:
mut node := XMLNode { tag = rootTag }
if not value.IsObject(v):
node.text = _value_text(v)
ret node
end
keys := value.ObjectKeys(v)
mut i := 0
until i < keys.len():
k := keys.get(i)
fv := value.ObjectGet(v, k)
if k.len() > 0 and str.CharAt(k, 0) == "@":
node.attrs.put(k.substr(1, k.len() - 1), _value_text(fv))
else k == "#text":
node.text = _value_text(fv)
else value.IsArray(fv):
mut j := 0
until j < value.ArrayLen(fv):
node.children.push(FromValue(value.ArrayGet(fv, j), k))
j++
end
else:
node.children.push(FromValue(fv, k))
end
i++
end
ret node
end
package xml
@en "ValueNodeSet"
@fa "مقدار مجموعه گره"
pub const ValueNodeSet := 0
@en "ValueString"
@fa "مقدار رشته"
pub const ValueString := 1
@en "ValueNumber"
@fa "مقدار عدد"
pub const ValueNumber := 2
@en "ValueBoolean"
@fa "مقدار منطقی"
pub const ValueBoolean := 3
const TK_END := 0
const TK_NAME := 1
const TK_NUMBER := 2
const TK_LITERAL := 3
const TK_OP := 4
const XP_PATH := 1
const XP_STEP := 2
const XP_BINARY := 3
const XP_NEGATE := 4
const XP_LITERAL := 5
const XP_NUMBER := 6
const XP_CALL := 7
const XP_FILTER := 8
const XP_UNION := 9
const XP_VARIABLE := 10
const AX_CHILD := 0
const AX_DESCENDANT := 1
const AX_PARENT := 2
const AX_ANCESTOR := 3
const AX_SELF := 4
const AX_DESCENDANT_OR_SELF := 5
const AX_ANCESTOR_OR_SELF := 6
const AX_FOLLOWING_SIBLING := 7
const AX_PRECEDING_SIBLING := 8
const AX_ATTRIBUTE := 9
const AX_FOLLOWING := 10
const AX_PRECEDING := 11
const NT_NAME := 0
const NT_ANY := 1
const NT_NODE := 2
const NT_TEXT := 3
const NT_COMMENT := 4
const NT_INSTRUCTION := 5
const NT_PREFIX_ANY := 6
struct XPVal:
pub kind: int = 0
pub set: int = 0 - 1
pub text: str = ""
pub number: f64 = 0.0
pub flag: bool = false
end
struct XPExpr:
pub kind: int = 0
pub op: str = ""
pub a: int = 0 - 1
pub b: int = 0 - 1
pub args: Vector<int> = Vector {}
pub text: str = ""
pub number: f64 = 0.0
pub axis: int = 0
pub test: int = 0
pub name: str = ""
pub prefix: str = ""
pub absolute: bool = false
end
struct XPEngine:
pub kinds: Vector<int> = Vector {}
pub texts: Vector<str> = Vector {}
pub numbers: Vector<f64> = Vector {}
pub offsets: Vector<int> = Vector {}
pub at: int = 0
pub exprs: Vector<XPExpr> = Vector {}
pub sets: Vector<NodeList> = Vector {}
pub vars: XPathVariables = XPathVariables {}
pub order: Vector<int> = Vector {}
pub failed: bool = false
pub message: str = ""
pub offset: int = 0
pub kind: ErrorKind = ErrorKind.Syntax
pub code: str = ""
end
@en "XPathValue"
@fa "مقدار اکس‌پث"
pub struct XPathValue:
@en "kind"
@fa "نوع"
pub kind: int = 0
@en "nodes"
@fa "گره‌ها"
pub nodes: NodeList = NodeList {}
@en "text"
@fa "متن"
pub text: str = ""
@en "number"
@fa "عدد"
pub number: f64 = 0.0
@en "flag"
@fa "منطقی"
pub flag: bool = false
end
@en "XPathVariables"
@fa "متغیرهای اکس‌پث"
pub struct XPathVariables:
@en "names"
@fa "نام‌ها"
pub names: Vector<str> = Vector {} as Vector<str>
@en "values"
@fa "مقدارها"
pub values: Vector<XPathValue> = Vector {} as Vector<XPathValue>
@en "index_of"
@fa "اندیس"
pub func index_of(name: str): int:
mut i := 0
until i < this.names.len():
if this.names.get(i) == name: ret i end
i++
end
ret -1
end
@en "set"
@fa "تنظیم"
pub func set(name: str, value: XPathValue):
idx := this.index_of(name)
if idx < 0:
this.names.push(name)
this.values.push(value)
ret
end
mut old := this.values.get(idx)
FreeValue(old)
this.values.set(idx, value)
end
@en "set_string"
@fa "تنظیم رشته"
pub func set_string(name: str, text: str):
this.set(name, XPathValue { kind = ValueString, text = text })
end
@en "set_number"
@fa "تنظیم عدد"
pub func set_number(name: str, number: f64):
this.set(name, XPathValue { kind = ValueNumber, number = number })
end
@en "set_boolean"
@fa "تنظیم منطقی"
pub func set_boolean(name: str, flag: bool):
this.set(name, XPathValue { kind = ValueBoolean, flag = flag })
end
@en "set_nodes"
@fa "تنظیم گره‌ها"
pub func set_nodes(name: str, nodes: NodeList):
this.set(name, XPathValue { kind = ValueNodeSet, nodes = nodes })
end
@en "free"
@fa "آزادسازی"
pub func free():
mut i := 0
until i < this.values.len():
mut v := this.values.get(i)
FreeValue(v)
i++
end
this.values.free()
this.names.free()
end
end
func xp_fail_kind(e &: XPEngine, offset: int, kind: ErrorKind, code: str, message: str):
if e.failed: ret end
e.failed = true
e.message = message
e.offset = offset
e.kind = kind
e.code = code
end
func xp_fail(e &: XPEngine, offset: int, message: str):
xp_fail_kind(e, offset, ErrorKind.Syntax, "", message)
end
func xp_op_expected(text: str, prev_kind: int, prev_text: str): bool:
if prev_kind == TK_END: ret false end
if prev_kind == TK_NAME:
if prev_text == "and" or prev_text == "or" or prev_text == "div" or prev_text == "mod": ret false end
ret true
end
if prev_kind == TK_NUMBER or prev_kind == TK_LITERAL: ret true end
if prev_text == ")" or prev_text == "]" or prev_text == "*" or prev_text == ".": ret true end
_unused := text
ret false
end
func xp_push_token(e &: XPEngine, kind: int, text: str, number: f64, offset: int):
e.kinds.push(kind)
e.texts.push(text)
e.numbers.push(number)
e.offsets.push(offset)
end
func xp_lex(e &: XPEngine, src: str):
n := str.Len(src)
p := xbp(src)
mut i := 0
until not e.failed and i < n:
c := xub(p, i)
if xml_space(c):
i++
continue
end
start := i
if c == 34 or c == 39:
mut j := i + 1
until j < n and xub(p, j) != c:
j++
end
if j >= n:
xp_fail_kind(e, i, ErrorKind.UnexpectedEnd, "xpath.unclosed_string", "a string literal is never closed")
ret
end
xp_push_token(e, TK_LITERAL, str.Substr(src, i + 1, j - i - 1), 0.0, start)
i = j + 1
continue
end
if ascii_digit(c) or (c == 46 and i + 1 < n and ascii_digit(xub(p, i + 1))):
mut j := i
until j < n and (ascii_digit(xub(p, j)) or xub(p, j) == 46):
j++
end
xp_push_token(e, TK_NUMBER, "", str.ToFloat(str.Substr(src, i, j - i)), start)
i = j
continue
end
mut width := 0
cp := decode_cp(p, n, i, width)
if cp >= 0 and name_start_cp(cp) and cp != 58:
mut j := i
until j < n:
q := decode_cp(p, n, j, width)
if q < 0 or not name_char_cp(q) or q == 58: break end
j += width
end
mut word := str.Substr(src, i, j - i)
mut k := j
if k + 1 < n and xub(p, k) == 58 and xub(p, k + 1) != 58:
m := k + 1
if m < n and xub(p, m) == 42:
word += ":*"
k = m + 1
else:
mut q := m
until q < n:
cq := decode_cp(p, n, q, width)
if cq < 0 or not name_char_cp(cq) or cq == 58: break end
q += width
end
if q > m:
word = str.Substr(src, i, q - i)
k = q
end
end
end
xp_push_token(e, TK_NAME, word, 0.0, start)
i = k
continue
end
mut prev_kind := TK_END
mut prev_text := ""
if e.kinds.len() > 0:
prev_kind = e.kinds.get(e.kinds.len() - 1)
prev_text = e.texts.get(e.texts.len() - 1)
end
if c == 47 and i + 1 < n and xub(p, i + 1) == 47:
xp_push_token(e, TK_OP, "//", 0.0, start)
i += 2
continue
end
if c == 46 and i + 1 < n and xub(p, i + 1) == 46:
xp_push_token(e, TK_OP, "..", 0.0, start)
i += 2
continue
end
if c == 58 and i + 1 < n and xub(p, i + 1) == 58:
xp_push_token(e, TK_OP, "::", 0.0, start)
i += 2
continue
end
if (c == 33 or c == 60 or c == 62) and i + 1 < n and xub(p, i + 1) == 61:
xp_push_token(e, TK_OP, str.Substr(src, i, 2), 0.0, start)
i += 2
continue
end
if c == 42:
mut text := "*"
if xp_op_expected(text, prev_kind, prev_text): text = "*mul" end
xp_push_token(e, TK_OP, text, 0.0, start)
i++
continue
end
if c == 47 or c == 40 or c == 41 or c == 91 or c == 93 or c == 64 or c == 44 or c == 124 or c == 43 or c == 45 or c == 61 or c == 60 or c == 62 or c == 46 or c == 36:
xp_push_token(e, TK_OP, str.Substr(src, i, 1), 0.0, start)
i++
continue
end
xp_fail(e, i, "\"" + str.Substr(src, i, 1) + "\" has no meaning in an XPath expression")
ret
end
xp_push_token(e, TK_END, "", 0.0, n)
end
func tk_kind(e &: XPEngine, ahead: int): int:
at := e.at + ahead
if at >= e.kinds.len(): ret TK_END end
ret e.kinds.get(at)
end
func tk_text(e &: XPEngine, ahead: int): str:
at := e.at + ahead
if at >= e.texts.len(): ret "" end
ret e.texts.get(at)
end
func tk_offset(e &: XPEngine): int:
if e.at >= e.offsets.len(): ret 0 end
ret e.offsets.get(e.at)
end
func tk_is_op(e &: XPEngine, text: str): bool:
ret tk_kind(e, 0) == TK_OP and tk_text(e, 0) == text
end
func tk_is_word(e &: XPEngine, text: str): bool:
ret tk_kind(e, 0) == TK_NAME and tk_text(e, 0) == text
end
func tk_take(e &: XPEngine):
e.at++
end
func tk_expect(e &: XPEngine, text: str):
if not tk_is_op(e, text):
xp_fail(e, tk_offset(e), "\"" + text + "\" was expected here")
ret
end
tk_take(e)
end
func new_expr(e &: XPEngine, kind: int): int:
id := e.exprs.len()
e.exprs.push(XPExpr { kind = kind })
ret id
end
func axis_code(name: str): int:
if name == "child": ret AX_CHILD end
if name == "descendant": ret AX_DESCENDANT end
if name == "parent": ret AX_PARENT end
if name == "ancestor": ret AX_ANCESTOR end
if name == "self": ret AX_SELF end
if name == "descendant-or-self": ret AX_DESCENDANT_OR_SELF end
if name == "ancestor-or-self": ret AX_ANCESTOR_OR_SELF end
if name == "following-sibling": ret AX_FOLLOWING_SIBLING end
if name == "preceding-sibling": ret AX_PRECEDING_SIBLING end
if name == "attribute": ret AX_ATTRIBUTE end
if name == "following": ret AX_FOLLOWING end
if name == "preceding": ret AX_PRECEDING end
ret 0 - 1
end
func parse_predicates(e &: XPEngine, owner: int):
until not e.failed and tk_is_op(e, "["):
tk_take(e)
inner := parse_expression(e)
tk_expect(e, "]")
if e.failed: ret end
mut node := e.exprs.get(owner)
node.args.push(inner)
e.exprs.set(owner, node)
end
end
func parse_step(e &: XPEngine): int:
id := new_expr(e, XP_STEP)
mut node := e.exprs.get(id)
node.axis = AX_CHILD
node.test = NT_NAME
if tk_is_op(e, "."):
tk_take(e)
node.axis = AX_SELF
node.test = NT_NODE
e.exprs.set(id, node)
ret id
end
if tk_is_op(e, ".."):
tk_take(e)
node.axis = AX_PARENT
node.test = NT_NODE
e.exprs.set(id, node)
ret id
end
if tk_is_op(e, "@"):
tk_take(e)
node.axis = AX_ATTRIBUTE
else tk_kind(e, 0) == TK_NAME and tk_kind(e, 1) == TK_OP and tk_text(e, 1) == "::":
code := axis_code(tk_text(e, 0))
if code < 0:
xp_fail(e, tk_offset(e), "\"" + tk_text(e, 0) + "\" is not an axis this engine knows")
ret id
end
node.axis = code
tk_take(e)
tk_take(e)
end
if tk_is_op(e, "*"):
tk_take(e)
node.test = NT_ANY
else tk_kind(e, 0) == TK_NAME:
word := tk_text(e, 0)
if tk_kind(e, 1) == TK_OP and tk_text(e, 1) == "(":
if word == "node": node.test = NT_NODE
else word == "text": node.test = NT_TEXT
else word == "comment": node.test = NT_COMMENT
else word == "processing-instruction": node.test = NT_INSTRUCTION
else:
xp_fail(e, tk_offset(e), "\"" + word + "()\" is not a node test")
ret id
end
tk_take(e)
tk_take(e)
if tk_kind(e, 0) == TK_LITERAL:
node.name = tk_text(e, 0)
tk_take(e)
end
if not tk_is_op(e, ")"):
xp_fail(e, tk_offset(e), "\")\" was expected after the node test")
ret id
end
tk_take(e)
else str.EndsWith(word, ":*"):
node.test = NT_PREFIX_ANY
node.prefix = str.Substr(word, 0, str.Len(word) - 2)
tk_take(e)
else:
node.test = NT_NAME
node.name = word
colon := str.IndexOf(word, ":")
if colon > 0:
node.prefix = str.Substr(word, 0, colon)
node.name = str.Substr(word, colon + 1, str.Len(word) - colon - 1)
end
tk_take(e)
end
else:
xp_fail(e, tk_offset(e), "a step was expected here")
ret id
end
e.exprs.set(id, node)
parse_predicates(e, id)
ret id
end
func append_step(e &: XPEngine, path: int, step: int):
mut node := e.exprs.get(path)
node.args.push(step)
e.exprs.set(path, node)
end
func descendant_bridge(e &: XPEngine): int:
id := new_expr(e, XP_STEP)
mut node := e.exprs.get(id)
node.axis = AX_DESCENDANT_OR_SELF
node.test = NT_NODE
e.exprs.set(id, node)
ret id
end
func starts_a_step(e &: XPEngine): bool:
if tk_is_op(e, "@") or tk_is_op(e, "*") or tk_is_op(e, ".") or tk_is_op(e, ".."): ret true end
ret tk_kind(e, 0) == TK_NAME
end
func parse_relative_path(e &: XPEngine, path: int):
append_step(e, path, parse_step(e))
until not e.failed and (tk_is_op(e, "/") or tk_is_op(e, "//")):
doubled := tk_is_op(e, "//")
tk_take(e)
if doubled: append_step(e, path, descendant_bridge(e)) end
append_step(e, path, parse_step(e))
end
end
func parse_location_path(e &: XPEngine): int:
id := new_expr(e, XP_PATH)
mut node := e.exprs.get(id)
if tk_is_op(e, "/"):
node.absolute = true
e.exprs.set(id, node)
tk_take(e)
if starts_a_step(e): parse_relative_path(e, id) end
ret id
end
if tk_is_op(e, "//"):
node.absolute = true
e.exprs.set(id, node)
tk_take(e)
append_step(e, id, descendant_bridge(e))
parse_relative_path(e, id)
ret id
end
e.exprs.set(id, node)
parse_relative_path(e, id)
ret id
end
func parse_primary(e &: XPEngine): int:
if tk_kind(e, 0) == TK_LITERAL:
id := new_expr(e, XP_LITERAL)
mut node := e.exprs.get(id)
node.text = tk_text(e, 0)
e.exprs.set(id, node)
tk_take(e)
ret id
end
if tk_kind(e, 0) == TK_NUMBER:
id := new_expr(e, XP_NUMBER)
mut node := e.exprs.get(id)
node.number = e.numbers.get(e.at)
e.exprs.set(id, node)
tk_take(e)
ret id
end
if tk_is_op(e, "("):
tk_take(e)
inner := parse_expression(e)
tk_expect(e, ")")
ret inner
end
if tk_is_op(e, "$"):
tk_take(e)
if tk_kind(e, 0) != TK_NAME:
xp_fail(e, tk_offset(e), "a variable name was expected after \"$\"")
ret new_expr(e, XP_LITERAL)
end
id := new_expr(e, XP_VARIABLE)
mut node := e.exprs.get(id)
node.name = tk_text(e, 0)
e.exprs.set(id, node)
tk_take(e)
ret id
end
if tk_kind(e, 0) == TK_NAME and tk_kind(e, 1) == TK_OP and tk_text(e, 1) == "(":
id := new_expr(e, XP_CALL)
mut node := e.exprs.get(id)
node.name = tk_text(e, 0)
e.exprs.set(id, node)
tk_take(e)
tk_take(e)
if not tk_is_op(e, ")"):
until not e.failed:
arg := parse_expression(e)
mut owner := e.exprs.get(id)
owner.args.push(arg)
e.exprs.set(id, owner)
if not tk_is_op(e, ","): break end
tk_take(e)
end
end
tk_expect(e, ")")
ret id
end
ret parse_location_path(e)
end
func parse_filter(e &: XPEngine): int:
primary := parse_primary(e)
if e.failed: ret primary end
if e.exprs.get(primary).kind == XP_PATH: ret primary end
if not tk_is_op(e, "[") and not tk_is_op(e, "/") and not tk_is_op(e, "//"): ret primary end
id := new_expr(e, XP_FILTER)
mut node := e.exprs.get(id)
node.a = primary
e.exprs.set(id, node)
parse_predicates(e, id)
if tk_is_op(e, "/") or tk_is_op(e, "//"):
path := new_expr(e, XP_PATH)
doubled := tk_is_op(e, "//")
tk_take(e)
if doubled: append_step(e, path, descendant_bridge(e)) end
parse_relative_path(e, path)
mut owner := e.exprs.get(id)
owner.b = path
e.exprs.set(id, owner)
end
ret id
end
func parse_union(e &: XPEngine): int:
mut left := parse_filter(e)
until not e.failed and tk_is_op(e, "|"):
tk_take(e)
right := parse_filter(e)
id := new_expr(e, XP_UNION)
mut node := e.exprs.get(id)
node.a = left
node.b = right
e.exprs.set(id, node)
left = id
end
ret left
end
func parse_unary(e &: XPEngine): int:
if tk_is_op(e, "-"):
tk_take(e)
inner := parse_unary(e)
id := new_expr(e, XP_NEGATE)
mut node := e.exprs.get(id)
node.a = inner
e.exprs.set(id, node)
ret id
end
ret parse_union(e)
end
func make_binary(e &: XPEngine, op: str, left: int, right: int): int:
id := new_expr(e, XP_BINARY)
mut node := e.exprs.get(id)
node.op = op
node.a = left
node.b = right
e.exprs.set(id, node)
ret id
end
func parse_multiplicative(e &: XPEngine): int:
mut left := parse_unary(e)
until not e.failed and (tk_is_op(e, "*mul") or tk_is_word(e, "div") or tk_is_word(e, "mod")):
mut op := "*"
if tk_kind(e, 0) == TK_NAME: op = tk_text(e, 0) end
tk_take(e)
left = make_binary(e, op, left, parse_unary(e))
end
ret left
end
func parse_additive(e &: XPEngine): int:
mut left := parse_multiplicative(e)
until not e.failed and (tk_is_op(e, "+") or tk_is_op(e, "-")):
op := tk_text(e, 0)
tk_take(e)
left = make_binary(e, op, left, parse_multiplicative(e))
end
ret left
end
func parse_relational(e &: XPEngine): int:
mut left := parse_additive(e)
until not e.failed and (tk_is_op(e, "<") or tk_is_op(e, ">") or tk_is_op(e, "<=") or tk_is_op(e, ">=")):
op := tk_text(e, 0)
tk_take(e)
left = make_binary(e, op, left, parse_additive(e))
end
ret left
end
func parse_equality(e &: XPEngine): int:
mut left := parse_relational(e)
until not e.failed and (tk_is_op(e, "=") or tk_is_op(e, "!=")):
op := tk_text(e, 0)
tk_take(e)
left = make_binary(e, op, left, parse_relational(e))
end
ret left
end
func parse_and(e &: XPEngine): int:
mut left := parse_equality(e)
until not e.failed and tk_is_word(e, "and"):
tk_take(e)
left = make_binary(e, "and", left, parse_equality(e))
end
ret left
end
func parse_expression(e &: XPEngine): int:
mut left := parse_and(e)
until not e.failed and tk_is_word(e, "or"):
tk_take(e)
left = make_binary(e, "or", left, parse_and(e))
end
ret left
end
func attr_ref(aid: int): int: ret 0 - 2 - aid end
func is_attr_ref(id: int): bool: ret id <= 0 - 2 end
func aid_of(id: int): int: ret 0 - 2 - id end
func new_set(e &: XPEngine): int:
id := e.sets.len()
e.sets.push(NodeList {})
ret id
end
func set_push(e &: XPEngine, set: int, id: int):
mut s := e.sets.get(set)
s.items.push(id)
e.sets.set(set, s)
end
func set_len(e &: XPEngine, set: int): int:
if set < 0: ret 0 end
ret e.sets.get(set).items.len()
end
func set_get(e &: XPEngine, set: int, i: int): int:
ret e.sets.get(set).items.get(i)
end
func node_set(set: int): XPVal: ret XPVal { kind = ValueNodeSet, set = set } end
func string_val(text: str): XPVal: ret XPVal { kind = ValueString, text = text } end
func number_val(number: f64): XPVal: ret XPVal { kind = ValueNumber, number = number } end
func boolean_val(flag: bool): XPVal: ret XPVal { kind = ValueBoolean, flag = flag } end
func build_order(e &: XPEngine, d: Document):
e.order.clear()
mut i := 0
until i < d.nodes.len():
e.order.push(0)
i++
end
mut counter := 0
order_walk(e, d, DocumentNode(d), counter)
end
func order_walk(e &: XPEngine, d: Document, id: int, counter &: int):
if id < 0 or id >= e.order.len(): ret end
e.order.set(id, counter)
counter++
n := node_at(d, id)
mut i := 0
until i < n.children.len():
order_walk(e, d, n.children.get(i), counter)
i++
end
end
func order_major(e &: XPEngine, d: Document, id: int): int:
if is_attr_ref(id):
owner := d.attributes.get(aid_of(id)).owner
if owner < 0 or owner >= e.order.len(): ret 0 end
ret e.order.get(owner)
end
if id < 0 or id >= e.order.len(): ret 0 end
ret e.order.get(id)
end
func order_minor(d: Document, id: int): int:
if not is_attr_ref(id): ret 0 - 1 end
aid := aid_of(id)
owner := d.attributes.get(aid).owner
if owner < 0: ret 0 end
n := node_at(d, owner)
mut i := 0
until i < n.attrs.len():
if n.attrs.get(i) == aid: ret i end
i++
end
ret 0
end
func sort_unique(e &: XPEngine, d: Document, set: int):
mut s := e.sets.get(set)
mut a := 0
until a < s.items.len():
mut b := a + 1
until b < s.items.len():
x := s.items.get(a)
y := s.items.get(b)
xm := order_major(e, d, x)
ym := order_major(e, d, y)
mut swap := false
if xm > ym: swap = true
else xm == ym and order_minor(d, x) > order_minor(d, y): swap = true
end
if swap:
s.items.set(a, y)
s.items.set(b, x)
end
b++
end
a++
end
mut out := NodeList {}
mut i := 0
until i < s.items.len():
if i == 0 or s.items.get(i) != s.items.get(i - 1): out.items.push(s.items.get(i)) end
i++
end
s.items.free()
e.sets.set(set, out)
end
func string_of_node(d: Document, id: int): str:
if is_attr_ref(id): ret d.attributes.get(aid_of(id)).value end
k := Kind(d, id)
if k == KindElement or k == KindDocument: ret Text(d, id) end
ret Value(d, id)
end
func name_of_node(d: Document, id: int): str:
if is_attr_ref(id): ret d.attributes.get(aid_of(id)).name end
ret Name(d, id)
end
func local_of_node(d: Document, id: int): str:
if is_attr_ref(id): ret d.attributes.get(aid_of(id)).local end
ret LocalName(d, id)
end
func uri_of_node(d: Document, id: int): str:
if is_attr_ref(id): ret d.attributes.get(aid_of(id)).uri end
ret NamespaceURI(d, id)
end
func matches_test(d: Document, id: int, test: int, name: str, prefix: str): bool:
if test == NT_NODE: ret true end
if test == NT_TEXT:
if is_attr_ref(id): ret false end
k := Kind(d, id)
ret k == KindText or k == KindCData
end
if test == NT_COMMENT:
if is_attr_ref(id): ret false end
ret Kind(d, id) == KindComment
end
if test == NT_INSTRUCTION:
if is_attr_ref(id): ret false end
if Kind(d, id) != KindProcessingInstruction: ret false end
if str.Len(name) == 0: ret true end
ret Name(d, id) == name
end
if is_attr_ref(id):
a := d.attributes.get(aid_of(id))
if a.prefix == "xmlns" or a.name == "xmlns": ret false end
if test == NT_ANY: ret true end
if test == NT_PREFIX_ANY: ret a.prefix == prefix end
if str.Len(prefix) > 0: ret a.prefix == prefix and a.local == name end
ret a.name == name
end
if Kind(d, id) != KindElement: ret false end
if test == NT_ANY: ret true end
if test == NT_PREFIX_ANY: ret Prefix(d, id) == prefix end
if str.Len(prefix) > 0: ret Prefix(d, id) == prefix and LocalName(d, id) == name end
ret Name(d, id) == name
end
func gather_descendants(d: Document, id: int, out &: Vector<int>):
n := node_at(d, id)
mut i := 0
until i < n.children.len():
child := n.children.get(i)
out.push(child)
gather_descendants(d, child, out)
i++
end
end
func axis_nodes(d: Document, origin: int, axis: int, out &: Vector<int>):
if axis == AX_SELF:
out.push(origin)
ret
end
if is_attr_ref(origin):
owner := d.attributes.get(aid_of(origin)).owner
if axis == AX_PARENT: out.push(owner) end
if axis == AX_ANCESTOR or axis == AX_ANCESTOR_OR_SELF:
if axis == AX_ANCESTOR_OR_SELF: out.push(origin) end
mut at := owner
until at >= 0:
out.push(at)
at = Parent(d, at)
end
end
ret
end
if axis == AX_CHILD:
n := node_at(d, origin)
mut i := 0
until i < n.children.len():
out.push(n.children.get(i))
i++
end
ret
end
if axis == AX_DESCENDANT:
gather_descendants(d, origin, out)
ret
end
if axis == AX_DESCENDANT_OR_SELF:
out.push(origin)
gather_descendants(d, origin, out)
ret
end
if axis == AX_PARENT:
p := Parent(d, origin)
if p >= 0: out.push(p) end
ret
end
if axis == AX_ANCESTOR or axis == AX_ANCESTOR_OR_SELF:
if axis == AX_ANCESTOR_OR_SELF: out.push(origin) end
mut at := Parent(d, origin)
until at >= 0:
out.push(at)
at = Parent(d, at)
end
ret
end
if axis == AX_ATTRIBUTE:
n := node_at(d, origin)
mut i := 0
until i < n.attrs.len():
out.push(attr_ref(n.attrs.get(i)))
i++
end
ret
end
if axis == AX_FOLLOWING_SIBLING or axis == AX_PRECEDING_SIBLING:
parent := Parent(d, origin)
if parent < 0: ret end
p := node_at(d, parent)
mut seen := false
mut i := 0
until i < p.children.len():
child := p.children.get(i)
if child == origin: seen = true
else seen and axis == AX_FOLLOWING_SIBLING: out.push(child)
else not seen and axis == AX_PRECEDING_SIBLING: out.push(child)
end
i++
end
ret
end
if axis == AX_FOLLOWING or axis == AX_PRECEDING:
mut all := Vector {} as Vector<int>
gather_descendants(d, DocumentNode(d), all)
mut mine := Vector {} as Vector<int>
mine.push(origin)
gather_descendants(d, origin, mine)
mut ancestors := Vector {} as Vector<int>
mut at := origin
until at >= 0:
ancestors.push(at)
at = Parent(d, at)
end
mut passed := false
mut i := 0
until i < all.len():
candidate := all.get(i)
if candidate == origin:
passed = true
else:
mut skip := false
mut k := 0
until k < mine.len():
if mine.get(k) == candidate: skip = true end
k++
end
mut m := 0
until m < ancestors.len():
if ancestors.get(m) == candidate: skip = true end
m++
end
if not skip:
if passed and axis == AX_FOLLOWING: out.push(candidate) end
if not passed and axis == AX_PRECEDING: out.push(candidate) end
end
end
i++
end
all.free()
mine.free()
ancestors.free()
end
end
func number_to_string(v: f64): str:
if math.IsNaN(v): ret "NaN" end
if math.IsInf(v):
if v > 0.0: ret "Infinity" end
ret "-Infinity"
end
if v == math.Floor(v) and v < 1.0e18 and v > 0.0 - 1.0e18: ret str.FromInt(v as i64) end
ret str.FromFloat(v)
end
func string_to_number(text: str): f64:
s := str.Trim(text)
n := str.Len(s)
if n == 0: ret math.NaN() end
p := xbp(s)
mut i := 0
if xub(p, 0) == 45 or xub(p, 0) == 43: i = 1 end
mut digits := 0
mut dots := 0
until i < n:
c := xub(p, i)
if ascii_digit(c): digits++
else c == 46: dots++
else:
ret math.NaN()
end
i++
end
if digits == 0 or dots > 1: ret math.NaN() end
ret str.ToFloat(s)
end
func as_string(e &: XPEngine, d: Document, v: XPVal): str:
if v.kind == ValueString: ret v.text end
if v.kind == ValueNumber: ret number_to_string(v.number) end
if v.kind == ValueBoolean:
if v.flag: ret "true" end
ret "false"
end
if set_len(e, v.set) == 0: ret "" end
ret string_of_node(d, set_get(e, v.set, 0))
end
func as_boolean(e &: XPEngine, d: Document, v: XPVal): bool:
if v.kind == ValueBoolean: ret v.flag end
if v.kind == ValueString: ret str.Len(v.text) > 0 end
if v.kind == ValueNumber: ret not math.IsNaN(v.number) and v.number != 0.0 end
_unused := d
ret set_len(e, v.set) > 0
end
func as_number(e &: XPEngine, d: Document, v: XPVal): f64:
if v.kind == ValueNumber: ret v.number end
if v.kind == ValueBoolean:
if v.flag: ret 1.0 end
ret 0.0
end
ret string_to_number(as_string(e, d, v))
end
func compare_strings(op: str, a: str, b: str): bool:
if op == "=": ret a == b end
ret a != b
end
func compare_numbers(op: str, a: f64, b: f64): bool:
if math.IsNaN(a) or math.IsNaN(b):
if op == "!=": ret true end
ret false
end
if op == "=": ret a == b end
if op == "!=": ret a != b end
if op == "<": ret a < b end
if op == ">": ret a > b end
if op == "<=": ret a <= b end
ret a >= b
end
func compare_values(e &: XPEngine, d: Document, op: str, left: XPVal, right: XPVal): bool:
equality := op == "=" or op == "!="
left_set := left.kind == ValueNodeSet
right_set := right.kind == ValueNodeSet
if left_set and right_set:
mut i := 0
until i < set_len(e, left.set):
a := string_of_node(d, set_get(e, left.set, i))
mut j := 0
until j < set_len(e, right.set):
b := string_of_node(d, set_get(e, right.set, j))
if equality:
if compare_strings(op, a, b): ret true end
else:
if compare_numbers(op, string_to_number(a), string_to_number(b)): ret true end
end
j++
end
i++
end
ret false
end
if left_set or right_set:
mut set := left.set
mut other := right
mut flipped := false
if right_set:
set = right.set
other = left
flipped = true
end
if other.kind == ValueBoolean and equality:
ret compare_strings(op, boolean_text(set_len(e, set) > 0), boolean_text(other.flag))
end
mut i := 0
until i < set_len(e, set):
text := string_of_node(d, set_get(e, set, i))
mut hit := false
if equality and other.kind == ValueString:
hit = compare_strings(op, text, other.text)
else:
a := string_to_number(text)
b := as_number(e, d, other)
if flipped:
hit = compare_numbers(op, b, a)
else:
hit = compare_numbers(op, a, b)
end
end
if hit: ret true end
i++
end
ret false
end
if equality:
if left.kind == ValueBoolean or right.kind == ValueBoolean:
ret compare_strings(op, boolean_text(as_boolean(e, d, left)), boolean_text(as_boolean(e, d, right)))
end
if left.kind == ValueNumber or right.kind == ValueNumber:
ret compare_numbers(op, as_number(e, d, left), as_number(e, d, right))
end
ret compare_strings(op, as_string(e, d, left), as_string(e, d, right))
end
ret compare_numbers(op, as_number(e, d, left), as_number(e, d, right))
end
func boolean_text(flag: bool): str:
if flag: ret "true" end
ret "false"
end
func normalize_space(text: str): str:
mut sb := str.NewBuilder()
n := str.Len(text)
p := xbp(text)
mut i := 0
mut pending := false
mut started := false
until i < n:
c := xub(p, i)
if xml_space(c):
if started: pending = true end
else:
if pending: str.BufAppendChar(sb, 32) end
pending = false
started = true
str.BufAppendChar(sb, c)
end
i++
end
out := str.BufStr(sb)
str.BufFree(sb)
ret out
end
func translate_text(text: str, from: str, onto: str): str:
mut sb := str.NewBuilder()
n := str.Len(text)
p := xbp(text)
fn := str.Len(from)
fp := xbp(from)
tn := str.Len(onto)
tp := xbp(onto)
mut i := 0
until i < n:
c := xub(p, i)
mut at := 0 - 1
mut k := 0
until k < fn:
if xub(fp, k) == c and at < 0: at = k end
k++
end
if at < 0: str.BufAppendChar(sb, c)
else at < tn: str.BufAppendChar(sb, xub(tp, at))
end
i++
end
out := str.BufStr(sb)
str.BufFree(sb)
ret out
end
func substring_of(text: str, start: f64, length: f64, has_length: bool): str:
n := str.CharCount(text)
from := math.Round(start) as int
mut count := n
if has_length:
if math.IsNaN(length) or math.IsNaN(start): ret "" end
count = math.Round(length) as int
end
mut first := from - 1
mut last := n
if has_length: last = first + count end
if first < 0: first = 0 end
if last > n: last = n end
if last <= first: ret "" end
mut sb := str.NewBuilder()
mut i := first
until i < last:
str.BufAppend(sb, str.CharAt(text, i))
i++
end
out := str.BufStr(sb)
str.BufFree(sb)
ret out
end
func argument_or_context(
e &: XPEngine, d: Document, args &: Vector<XPVal>, index: int, ctx: int, present: bool
): str:
if present: ret as_string(e, d, args.get(index)) end
ret string_of_node(d, ctx)
end
func call_function(
e &: XPEngine, d: Document, name: str, args &: Vector<XPVal>, ctx: int, position: int, size: int
): XPVal:
count := args.len()
if name == "last": ret number_val(size as f64) end
if name == "position": ret number_val(position as f64) end
if name == "true": ret boolean_val(true) end
if name == "false": ret boolean_val(false) end
if name == "count":
if count != 1 or args.get(0).kind != ValueNodeSet:
xp_fail_kind(e, 0, ErrorKind.InvalidArgument, "xpath.arity", "count() takes one node-set")
ret number_val(0.0)
end
ret number_val(set_len(e, args.get(0).set) as f64)
end
if name == "name" or name == "local-name" or name == "namespace-uri":
mut target := ctx
if count >= 1:
if args.get(0).kind != ValueNodeSet or set_len(e, args.get(0).set) == 0: ret string_val("") end
target = set_get(e, args.get(0).set, 0)
end
if name == "name": ret string_val(name_of_node(d, target)) end
if name == "local-name": ret string_val(local_of_node(d, target)) end
ret string_val(uri_of_node(d, target))
end
if name == "string":
if count == 0: ret string_val(string_of_node(d, ctx)) end
ret string_val(as_string(e, d, args.get(0)))
end
if name == "concat":
mut sb := str.NewBuilder()
mut i := 0
until i < count:
str.BufAppend(sb, as_string(e, d, args.get(i)))
i++
end
out := str.BufStr(sb)
str.BufFree(sb)
ret string_val(out)
end
if name == "starts-with" or name == "contains" or name == "ends-with" or name == "substring-before" or name == "substring-after":
if count != 2:
xp_fail_kind(e, 0, ErrorKind.InvalidArgument, "xpath.arity", name + "() takes two arguments")
ret string_val("")
end
a := as_string(e, d, args.get(0))
b := as_string(e, d, args.get(1))
if name == "starts-with": ret boolean_val(str.StartsWith(a, b)) end
if name == "ends-with": ret boolean_val(str.EndsWith(a, b)) end
if name == "contains": ret boolean_val(str.Contains(a, b)) end
at := str.IndexOf(a, b)
if at < 0: ret string_val("") end
if name == "substring-before": ret string_val(str.Substr(a, 0, at)) end
ret string_val(str.Substr(a, at + str.Len(b), str.Len(a) - at - str.Len(b)))
end
if name == "substring":
if count < 2:
xp_fail_kind(e, 0, ErrorKind.InvalidArgument, "xpath.arity", "substring() takes two or three arguments")
ret string_val("")
end
text := as_string(e, d, args.get(0))
start := as_number(e, d, args.get(1))
if count >= 3: ret string_val(substring_of(text, start, as_number(e, d, args.get(2)), true)) end
ret string_val(substring_of(text, start, 0.0, false))
end
if name == "string-length":
ret number_val(str.CharCount(argument_or_context(e, d, args, 0, ctx, count >= 1)) as f64)
end
if name == "normalize-space":
ret string_val(normalize_space(argument_or_context(e, d, args, 0, ctx, count >= 1)))
end
if name == "translate":
if count != 3:
xp_fail_kind(e, 0, ErrorKind.InvalidArgument, "xpath.arity", "translate() takes three arguments")
ret string_val("")
end
ret string_val(translate_text(as_string(e, d, args.get(0)), as_string(e, d, args.get(1)), as_string(e, d, args.get(2))))
end
if name == "boolean":
if count != 1:
xp_fail_kind(e, 0, ErrorKind.InvalidArgument, "xpath.arity", "boolean() takes one argument")
ret boolean_val(false)
end
ret boolean_val(as_boolean(e, d, args.get(0)))
end
if name == "not":
if count != 1:
xp_fail_kind(e, 0, ErrorKind.InvalidArgument, "xpath.arity", "not() takes one argument")
ret boolean_val(false)
end
ret boolean_val(not as_boolean(e, d, args.get(0)))
end
if name == "number":
if count == 0: ret number_val(string_to_number(string_of_node(d, ctx))) end
ret number_val(as_number(e, d, args.get(0)))
end
if name == "sum":
if count != 1 or args.get(0).kind != ValueNodeSet:
xp_fail_kind(e, 0, ErrorKind.InvalidArgument, "xpath.arity", "sum() takes one node-set")
ret number_val(0.0)
end
mut total := 0.0
mut i := 0
until i < set_len(e, args.get(0).set):
total += string_to_number(string_of_node(d, set_get(e, args.get(0).set, i)))
i++
end
ret number_val(total)
end
if name == "floor" or name == "ceiling" or name == "round":
if count != 1:
xp_fail_kind(e, 0, ErrorKind.InvalidArgument, "xpath.arity", name + "() takes one argument")
ret number_val(0.0)
end
v := as_number(e, d, args.get(0))
if name == "floor": ret number_val(math.Floor(v)) end
if name == "ceiling": ret number_val(math.Ceil(v)) end
ret number_val(math.Floor(v + 0.5))
end
xp_fail_kind(e, 0, ErrorKind.NotFound, "xpath.unknown_function", "there is no XPath function called " + name + "()")
ret string_val("")
end
func keep_by_predicates(e &: XPEngine, d: Document, predicates &: Vector<int>, candidates &: Vector<int>):
mut pi := 0
until not e.failed and pi < predicates.len():
mut kept := Vector {} as Vector<int>
size := candidates.len()
mut i := 0
until not e.failed and i < size:
v := evaluate(e, d, predicates.get(pi), candidates.get(i), i + 1, size)
mut keep := false
if v.kind == ValueNumber: keep = v.number == (i + 1) as f64
else:
keep = as_boolean(e, d, v)
end
if keep: kept.push(candidates.get(i)) end
i++
end
candidates.clear()
mut k := 0
until k < kept.len():
candidates.push(kept.get(k))
k++
end
kept.free()
pi++
end
end
func run_step(e &: XPEngine, d: Document, step_id: int, source: int): int:
step := e.exprs.get(step_id)
output := new_set(e)
mut i := 0
until not e.failed and i < set_len(e, source):
origin := set_get(e, source, i)
mut candidates := Vector {} as Vector<int>
mut raw := Vector {} as Vector<int>
axis_nodes(d, origin, step.axis, raw)
mut k := 0
until k < raw.len():
if matches_test(d, raw.get(k), step.test, step.name, step.prefix): candidates.push(raw.get(k)) end
k++
end
raw.free()
mut predicates := step.args
keep_by_predicates(e, d, predicates, candidates)
mut m := 0
until m < candidates.len():
set_push(e, output, candidates.get(m))
m++
end
candidates.free()
i++
end
sort_unique(e, d, output)
ret output
end
func run_path(e &: XPEngine, d: Document, path_id: int, start: int): XPVal:
path := e.exprs.get(path_id)
mut current := new_set(e)
if path.absolute: set_push(e, current, DocumentNode(d))
else:
set_push(e, current, start)
end
mut i := 0
until not e.failed and i < path.args.len():
current = run_step(e, d, path.args.get(i), current)
i++
end
ret node_set(current)
end
func xpath_value_to_xpval(e &: XPEngine, v: XPathValue): XPVal:
if v.kind == ValueString: ret string_val(v.text) end
if v.kind == ValueNumber: ret number_val(v.number) end
if v.kind == ValueBoolean: ret boolean_val(v.flag) end
set := new_set(e)
mut i := 0
until i < v.nodes.items.len():
set_push(e, set, v.nodes.items.get(i))
i++
end
ret node_set(set)
end
func evaluate(e &: XPEngine, d: Document, id: int, ctx: int, position: int, size: int): XPVal:
if e.failed or id < 0: ret string_val("") end
node := e.exprs.get(id)
if node.kind == XP_LITERAL: ret string_val(node.text) end
if node.kind == XP_NUMBER: ret number_val(node.number) end
if node.kind == XP_VARIABLE:
idx := e.vars.index_of(node.name)
if idx < 0:
xp_fail_kind(e, 0, ErrorKind.NotFound, "xpath.unknown_variable", "there is no XPath variable called $" + node.name)
ret string_val("")
end
ret xpath_value_to_xpval(e, e.vars.values.get(idx))
end
if node.kind == XP_PATH: ret run_path(e, d, id, ctx) end
if node.kind == XP_NEGATE: ret number_val(0.0 - as_number(e, d, evaluate(e, d, node.a, ctx, position, size))) end
if node.kind == XP_UNION:
left := evaluate(e, d, node.a, ctx, position, size)
right := evaluate(e, d, node.b, ctx, position, size)
if left.kind != ValueNodeSet or right.kind != ValueNodeSet:
xp_fail_kind(e, 0, ErrorKind.TypeMismatch, "xpath.not_node_set", "'|' joins node-sets only")
ret string_val("")
end
merged := new_set(e)
mut i := 0
until i < set_len(e, left.set):
set_push(e, merged, set_get(e, left.set, i))
i++
end
mut j := 0
until j < set_len(e, right.set):
set_push(e, merged, set_get(e, right.set, j))
j++
end
sort_unique(e, d, merged)
ret node_set(merged)
end
if node.kind == XP_CALL:
mut args := Vector {} as Vector<XPVal>
mut i := 0
until not e.failed and i < node.args.len():
args.push(evaluate(e, d, node.args.get(i), ctx, position, size))
i++
end
out := call_function(e, d, node.name, args, ctx, position, size)
args.free()
ret out
end
if node.kind == XP_FILTER:
base := evaluate(e, d, node.a, ctx, position, size)
if base.kind != ValueNodeSet:
xp_fail_kind(e, 0, ErrorKind.TypeMismatch, "xpath.not_node_set", "a predicate can only filter a node-set")
ret string_val("")
end
mut candidates := Vector {} as Vector<int>
mut i := 0
until i < set_len(e, base.set):
candidates.push(set_get(e, base.set, i))
i++
end
mut predicates := node.args
keep_by_predicates(e, d, predicates, candidates)
filtered := new_set(e)
mut k := 0
until k < candidates.len():
set_push(e, filtered, candidates.get(k))
k++
end
candidates.free()
if node.b < 0: ret node_set(filtered) end
tail := e.exprs.get(node.b)
mut current := filtered
mut s := 0
until not e.failed and s < tail.args.len():
current = run_step(e, d, tail.args.get(s), current)
s++
end
ret node_set(current)
end
if node.kind == XP_BINARY:
op := node.op
if op == "and":
if not as_boolean(e, d, evaluate(e, d, node.a, ctx, position, size)): ret boolean_val(false) end
ret boolean_val(as_boolean(e, d, evaluate(e, d, node.b, ctx, position, size)))
end
if op == "or":
if as_boolean(e, d, evaluate(e, d, node.a, ctx, position, size)): ret boolean_val(true) end
ret boolean_val(as_boolean(e, d, evaluate(e, d, node.b, ctx, position, size)))
end
left := evaluate(e, d, node.a, ctx, position, size)
right := evaluate(e, d, node.b, ctx, position, size)
if op == "=" or op == "!=" or op == "<" or op == ">" or op == "<=" or op == ">=":
ret boolean_val(compare_values(e, d, op, left, right))
end
a := as_number(e, d, left)
b := as_number(e, d, right)
if op == "+": ret number_val(a + b) end
if op == "-": ret number_val(a - b) end
if op == "*": ret number_val(a * b) end
if op == "div":
if b == 0.0:
if a == 0.0 or math.IsNaN(a): ret number_val(math.NaN()) end
if a > 0.0: ret number_val(math.Inf()) end
ret number_val(0.0 - math.Inf())
end
ret number_val(a / b)
end
if op == "mod":
if b == 0.0: ret number_val(math.NaN()) end
ret number_val(math.Mod(a, b))
end
xp_fail_kind(e, 0, ErrorKind.Internal, "", "\"" + op + "\" is not an operator this engine knows")
ret string_val("")
end
xp_fail_kind(e, 0, ErrorKind.Internal, "", "the expression could not be evaluated")
ret string_val("")
end
func engine_free(e &: XPEngine):
mut i := 0
until i < e.exprs.len():
mut x := e.exprs.get(i)
x.args.free()
i++
end
mut s := 0
until s < e.sets.len():
mut set := e.sets.get(s)
set.items.free()
s++
end
e.exprs.free()
e.sets.free()
e.kinds.free()
e.texts.free()
e.numbers.free()
e.offsets.free()
e.order.free()
end
func run_query(d: Document, context: int, expression: str, variables: XPathVariables, err &: Error, out &: XPathValue):
mut e := XPEngine { vars = variables }
out = XPathValue { kind = ValueNodeSet }
xp_lex(e, expression)
mut root := 0 - 1
if not e.failed:
root = parse_expression(e)
if not e.failed and tk_kind(e, 0) != TK_END:
xp_fail(e, tk_offset(e), "the expression has trailing text")
end
end
if not e.failed:
build_order(e, d)
mut ctx := context
if ctx < 0: ctx = DocumentNode(d) end
v := evaluate(e, d, root, ctx, 1, 1)
if not e.failed:
if v.kind == ValueNodeSet:
mut copied := NodeList {}
mut i := 0
until i < set_len(e, v.set):
copied.items.push(set_get(e, v.set, i))
i++
end
out = XPathValue { kind = ValueNodeSet, nodes = copied }
else v.kind == ValueString:
out = XPathValue { kind = ValueString, text = v.text }
else v.kind == ValueNumber:
out = XPathValue { kind = ValueNumber, number = v.number }
else:
out = XPathValue { kind = ValueBoolean, flag = v.flag }
end
end
end
if e.failed:
err = Error.At(e.kind, e.message, e.offset).with_code(e.code).locate(expression).wrap("xpath")
end
engine_free(e)
end
@en "Evaluate"
@fa "ارزیابی"
pub func Evaluate(d: Document, context: int, expression: str): XPathValue throws:
ret try EvaluateWith(d, context, expression, XPathVariables {})
end
@en "EvaluateWith"
@fa "ارزیابی با متغیرها"
pub func EvaluateWith(d: Document, context: int, expression: str, variables: XPathVariables): XPathValue throws:
mut err := Error {}
mut out := XPathValue {}
run_query(d, context, expression, variables, err, out)
if err.message != "": throw err end
ret out
end
@en "FreeValue"
@fa "آزادسازی مقدار"
pub func FreeValue(v &: XPathValue):
v.nodes.items.free()
end
@en "Select"
@fa "انتخاب"
pub func Select(d: Document, context: int, expression: str): NodeList throws:
mut v := try Evaluate(d, context, expression)
if v.kind != ValueNodeSet:
FreeValue(v)
throw Error.At(ErrorKind.TypeMismatch, "the expression does not produce a node-set", 0).with_code("xpath.not_node_set").locate(expression).wrap("xpath")
end
ret v.nodes
end
@en "SelectFirst"
@fa "انتخاب نخستین"
pub func SelectFirst(d: Document, context: int, expression: str): int throws:
mut list := try Select(d, context, expression)
mut out := 0 - 1
if list.items.len() > 0: out = list.items.get(0) end
list.items.free()
ret out
end
@en "SelectString"
@fa "انتخاب رشته"
pub func SelectString(d: Document, context: int, expression: str): str throws:
mut v := try Evaluate(d, context, expression)
mut out := ""
if v.kind == ValueString: out = v.text
else v.kind == ValueNumber: out = number_to_string(v.number)
else v.kind == ValueBoolean: out = boolean_text(v.flag)
else v.nodes.items.len() > 0: out = string_of_node(d, v.nodes.items.get(0))
end
FreeValue(v)
ret out
end
@en "SelectNumber"
@fa "انتخاب عدد"
pub func SelectNumber(d: Document, context: int, expression: str): f64 throws:
mut v := try Evaluate(d, context, expression)
mut out := 0.0
if v.kind == ValueNumber: out = v.number
else v.kind == ValueString: out = string_to_number(v.text)
else v.kind == ValueBoolean:
if v.flag: out = 1.0 end
else v.nodes.items.len() > 0: out = string_to_number(string_of_node(d, v.nodes.items.get(0)))
else:
out = math.NaN()
end
FreeValue(v)
ret out
end
@en "SelectBoolean"
@fa "انتخاب منطقی"
pub func SelectBoolean(d: Document, context: int, expression: str): bool throws:
mut v := try Evaluate(d, context, expression)
mut out := false
if v.kind == ValueBoolean: out = v.flag
else v.kind == ValueString: out = str.Len(v.text) > 0
else v.kind == ValueNumber: out = not math.IsNaN(v.number) and v.number != 0.0
else:
out = v.nodes.items.len() > 0
end
FreeValue(v)
ret out
end
@en "SelectWith"
@fa "انتخاب با متغیرها"
pub func SelectWith(d: Document, context: int, expression: str, variables: XPathVariables): NodeList throws:
mut v := try EvaluateWith(d, context, expression, variables)
if v.kind != ValueNodeSet:
FreeValue(v)
throw Error.At(ErrorKind.TypeMismatch, "the expression does not produce a node-set", 0).with_code("xpath.not_node_set").locate(expression).wrap("xpath")
end
ret v.nodes
end
@en "SelectFirstWith"
@fa "انتخاب نخستین با متغیرها"
pub func SelectFirstWith(d: Document, context: int, expression: str, variables: XPathVariables): int throws:
mut list := try SelectWith(d, context, expression, variables)
mut out := 0 - 1
if list.items.len() > 0: out = list.items.get(0) end
list.items.free()
ret out
end
@en "SelectStringWith"
