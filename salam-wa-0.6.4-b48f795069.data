func _sha1_new(): _Sha1:
mut c := _Sha1 {
h = mem.AllocateZeroed(40 as u64) as i64*
buf = mem.AllocateZeroed(64 as u64) as u8*
blen = 0
total = 0 as i64
w = mem.AllocateZeroed(640 as u64) as i64*
}
c.h[0] = 0x67452301
c.h[1] = 0xEFCDAB89
c.h[2] = 0x98BADCFE
c.h[3] = 0x10325476
c.h[4] = 0xC3D2E1F0
ret c
end
func _sha1_free(c &: _Sha1):
mem.Free(c.h as void*)
mem.Free(c.buf as void*)
mem.Free(c.w as void*)
end
func _sha1_copy(dst &: _Sha1, src: _Sha1):
repeat 5 in i:
dst.h[i] = src.h[i]
end
repeat 64 in i:
dst.buf[i] = src.buf[i]
end
dst.blen = src.blen
dst.total = src.total
end
func _sha1_rol(v: i64, n: int): i64:
ret ((v << n) | (v >> (32 - n))) & 0xffffffff
end
func _sha1_block(c &: _Sha1, p: u8*):
w := c.w
repeat 16 in i:
w[i] = ((p[i * 4] as i64) << 24) | ((p[i * 4 + 1] as i64) << 16) | ((p[i * 4 + 2] as i64) << 8) | (p[i * 4 + 3] as i64)
end
mut t := 16
until t < 80:
w[t] = _sha1_rol(w[t - 3] ^ w[t - 8] ^ w[t - 14] ^ w[t - 16], 1)
t++
end
mut a := c.h[0]
mut b := c.h[1]
mut cc := c.h[2]
mut d := c.h[3]
mut e := c.h[4]
repeat 80 in i:
mut f := 0 as i64
mut k := 0 as i64
if i < 20:
f = (b & cc) | ((~b) & d)
k = 0x5A827999
else i < 40:
f = b ^ cc ^ d
k = 0x6ED9EBA1
else i < 60:
f = (b & cc) | (b & d) | (cc & d)
k = 0x8F1BBCDC
else:
f = b ^ cc ^ d
k = 0xCA62C1D6
end
tmp := (_sha1_rol(a, 5) + (f & 0xffffffff) + e + k + w[i]) & 0xffffffff
e = d
d = cc
cc = _sha1_rol(b, 30)
b = a
a = tmp
end
c.h[0] = (c.h[0] + a) & 0xffffffff
c.h[1] = (c.h[1] + b) & 0xffffffff
c.h[2] = (c.h[2] + cc) & 0xffffffff
c.h[3] = (c.h[3] + d) & 0xffffffff
c.h[4] = (c.h[4] + e) & 0xffffffff
end
func _sha1_update(c &: _Sha1, p: u8*, n: int):
c.total += n as i64
mut off := 0
until off < n:
c.buf[c.blen] = p[off]
c.blen++
off++
if c.blen == 64:
_sha1_block(c, c.buf)
c.blen = 0
end
end
end
func _sha1_final(c &: _Sha1, out: i64*):
bits := c.total * 8
pad := mem.AllocateZeroed(72 as u64) as u8*
pad[0] = 0x80 as u8
mut padlen := 56 - c.blen
if padlen <= 0:
padlen += 64
end
repeat 8 in i:
pad[padlen + i] = ((bits >> (56 - i * 8)) & 255) as u8
end
_sha1_update(c, pad, padlen + 8)
mem.Free(pad as void*)
repeat 5 in i:
out[i] = c.h[i]
end
end
package archive
import mem
const _RH_FAST := 12
const _RB_BUF := 4194304
const _RB_LOW := 1048576
struct _RarBits:
pub p: u8*
pub n: int
pub pos: int
end
struct _RarStrm:
pub base: i64
pub soff: i64
pub stream: bool
pub cap: int
end
struct _RarHuff:
pub fast: u32*
pub syms: u16*
pub count: int*
pub first: int*
pub fidx: int*
pub nsyms: int
end
func _rb_apos(b &: _RarBits, st &: _RarStrm): i64:
ret (st.base << 3) + (b.pos as i64)
end
func _rb_fill(b &: _RarBits, st &: _RarStrm, s &: _RarSrc):
if not st.stream:
ret
end
have := b.n - (b.pos >> 3)
if have >= _RB_LOW or st.soff >= s.total:
ret
end
shift := b.pos >> 3
if shift > 0:
mem.MemMove(b.p as void*, _poff(b.p, shift) as void*, have as u64)
st.base += shift as i64
b.pos &= 7
b.n = have
end
mut take := st.cap - b.n
if (take as i64) > s.total - st.soff:
take = (s.total - st.soff) as int
end
q := _rsrc_get(s, st.soff, take)
if q == null:
st.soff = s.total
ret
end
mem.Copy(_poff(b.p, b.n) as void*, q as void*, take as u64)
b.n += take
st.soff += take as i64
end
func _rb_open(s &: _RarSrc, st &: _RarStrm): _RarBits:
st.base = 0 as i64
if s.mem != null and not s.aes_on and s.total <= (2000000000 as i64):
st.stream = false
st.soff = s.total
st.cap = 0
ret _RarBits { p = s.mem, n = s.total as int, pos = 0 }
end
st.stream = true
st.soff = 0 as i64
st.cap = _RB_BUF
buf := mem.AllocateZeroed((_RB_BUF + 64) as u64) as u8*
mut b := _RarBits { p = buf, n = 0, pos = 0 }
_rb_fill(b, st, s)
ret b
end
func _rb_close(b &: _RarBits, st &: _RarStrm):
if st.stream:
mem.Free(b.p as void*)
b.p = null
end
end
func _rb_done(b &: _RarBits, st &: _RarStrm, s &: _RarSrc): bool:
ret b.pos >= b.n * 8 and (not st.stream or st.soff >= s.total)
end
func _rb_peek(b &: _RarBits, count: int): int:
byte := b.pos >> 3
sh := b.pos & 7
mut v := 0 as i64
if byte + 4 <= b.n:
v = ((b.p[byte] as i64) << 24) | ((b.p[byte + 1] as i64) << 16) | ((b.p[byte + 2] as i64) << 8) | (b.p[byte + 3] as i64)
else:
mut i := 0
until i < 4:
v <<= 8
if byte + i < b.n:
v |= (b.p[byte + i] as i64)
end
i++
end
end
v = (v << sh) & 0xffffffff
ret (v >> (32 - count)) as int
end
func _rb_read(b &: _RarBits, count: int): int:
if count == 0:
ret 0
end
v := _rb_peek(b, count)
b.pos += count
ret v
end
func _rb_read64(b &: _RarBits, count: int): i64:
if count <= 16:
ret _rb_read(b, count)
end
hi := _rb_read64(b, count - 16)
lo := _rb_read(b, 16)
ret (hi << 16) | (lo as i64)
end
func _rh_new(ns: int): _RarHuff:
ret _RarHuff {
fast = mem.AllocateZeroed((4096 * 4) as u64) as u32*
syms = mem.AllocateZeroed((ns * 2 + 2) as u64) as u16*
count = mem.AllocateZeroed(64 as u64) as int*
first = mem.AllocateZeroed(64 as u64) as int*
fidx = mem.AllocateZeroed(64 as u64) as int*
nsyms = ns
}
end
func _rh_free(h &: _RarHuff):
mem.Free(h.fast as void*)
mem.Free(h.syms as void*)
mem.Free(h.count as void*)
mem.Free(h.first as void*)
mem.Free(h.fidx as void*)
end
func _rh_build(h &: _RarHuff, lens: u8*, n: int): bool:
mut offs: int[17]
repeat 17 in i: offs[i] = 0 end
repeat 16 in i: h.count[i] = 0 end
repeat 4096 in i: h.fast[i] = 0 as u32 end
repeat n in s:
l := lens[s] as int
if l > 0:
h.count[l]++
end
end
mut acc := 0
mut l := 1
until l <= 15:
offs[l] = acc
acc += h.count[l]
l++
end
repeat n in s:
l2 := lens[s] as int
if l2 > 0:
h.syms[offs[l2]] = s as u16
offs[l2]++
end
end
mut code := 0
mut idx := 0
mut ln := 1
until ln <= 15:
c := h.count[ln]
h.first[ln] = code
h.fidx[ln] = idx
if code + c > (1 << ln):
ret false
end
if ln <= _RH_FAST:
repeat c in i:
sym := h.syms[idx + i] as int
base := (code + i) << (_RH_FAST - ln)
span := 1 << (_RH_FAST - ln)
entry := ((sym << 4) | ln) as u32
repeat span in j:
h.fast[base + j] = entry
end
end
end
code = (code + c) << 1
idx += c
ln++
end
ret true
end
func _rh_decode(h &: _RarHuff, b &: _RarBits): int:
v := _rb_peek(b, 15)
e := h.fast[v >> 3] as int
if e != 0:
b.pos += e & 15
ret e >> 4
end
mut l := 13
until l <= 15:
d := (v >> (15 - l)) - h.first[l]
if d >= 0 and d < h.count[l]:
b.pos += l
ret h.syms[h.fidx[l] + d] as int
end
l++
end
ret -1
end
package archive
import compress
import crypto
import mem
func _rar_blob(p: u8*, off: int, n: int): u8*:
b := mem.AllocateZeroed((n + 16) as u64) as u8*
repeat n in i:
b[i] = p[off + i]
end
ret b
end
func _rar_pw_utf16(password: str): compress.ByteBuf:
mut out := compress.NewByteBuf()
bp := password as u8*
n := password.len()
mut i := 0
until i < n:
c := bp[i] as int
mut cp := c
mut need := 0
if c >= 0xf0:
cp = c & 7
need = 3
else c >= 0xe0:
cp = c & 15
need = 2
else c >= 0xc0:
cp = c & 31
need = 1
end
i++
repeat need:
if i < n:
cp = (cp << 6) | ((bp[i] as int) & 63)
i++
end
end
if cp >= 0x10000:
v := cp - 0x10000
hi := 0xd800 + (v >> 10)
lo := 0xdc00 + (v & 0x3ff)
compress.BufPush(out, hi & 255)
compress.BufPush(out, hi >> 8)
compress.BufPush(out, lo & 255)
compress.BufPush(out, lo >> 8)
else:
compress.BufPush(out, cp & 255)
compress.BufPush(out, cp >> 8)
end
end
ret out
end
func _rar5_kdf(password: str, salt: u8*, lg2: int, key: u8*, hkey: u8*, chk: u8*):
count := 1 << lg2
pw := password as void*
plen := password.len()
sd := mem.AllocateZeroed(32 as u64) as u8*
repeat 16 in i:
sd[i] = salt[i]
end
sd[19] = 1 as u8
u := mem.AllocateZeroed(32 as u64) as u8*
u2 := mem.AllocateZeroed(32 as u64) as u8*
fn := mem.AllocateZeroed(32 as u64) as u8*
crypto.HmacSha256Raw(pw, plen, sd as void*, 20, u as void*)
repeat 32 in i:
fn[i] = u[i]
end
mut it := 1
until it < count:
crypto.HmacSha256Raw(pw, plen, u as void*, 32, u2 as void*)
repeat 32 in i:
u[i] = u2[i]
fn[i] = ((fn[i] as int) ^ (u[i] as int)) as u8
end
it++
end
repeat 32 in i:
key[i] = fn[i]
end
repeat 2 in phase:
repeat 16:
crypto.HmacSha256Raw(pw, plen, u as void*, 32, u2 as void*)
repeat 32 in i:
u[i] = u2[i]
fn[i] = ((fn[i] as int) ^ (u[i] as int)) as u8
end
end
if phase == 0:
repeat 32 in i:
hkey[i] = fn[i]
end
else:
repeat 8 in i:
chk[i] = 0 as u8
end
repeat 32 in i:
chk[i & 7] = ((chk[i & 7] as int) ^ (fn[i] as int)) as u8
end
end
end
mem.Free(sd as void*)
mem.Free(u as void*)
mem.Free(u2 as void*)
mem.Free(fn as void*)
end
func _rar3_kdf(password: str, salt: u8*, key: u8*, iv: u8*):
mut raw := _rar_pw_utf16(password)
rawlen := raw.len + 8
rb := mem.AllocateZeroed((rawlen + 16) as u64) as u8*
repeat raw.len in i:
rb[i] = compress.BufGet(raw, i) as u8
end
repeat 8 in i:
rb[raw.len + i] = salt[i]
end
compress.BufFree(raw)
mut c := _sha1_new()
mut cp := _sha1_new()
h := mem.AllocateZeroed(40 as u64) as i64*
pn := mem.AllocateZeroed(8 as u64) as u8*
mut r := 0
until r < 0x40000:
_sha1_update(c, rb, rawlen)
pn[0] = (r & 255) as u8
pn[1] = ((r >> 8) & 255) as u8
pn[2] = ((r >> 16) & 255) as u8
_sha1_update(c, pn, 3)
if r % 0x4000 == 0:
_sha1_copy(cp, c)
_sha1_final(cp, h)
iv[r / 0x4000] = (h[4] & 255) as u8
end
r++
end
_sha1_final(c, h)
repeat 4 in i:
repeat 4 in j:
key[i * 4 + j] = ((h[i] >> (j * 8)) & 255) as u8
end
end
mem.Free(rb as void*)
mem.Free(h as void*)
mem.Free(pn as void*)
_sha1_free(c)
_sha1_free(cp)
end
func _rar5_check(password: str, salt: u8*, lg2: int, chk: u8*, key: u8*, hkey: u8*): bool:
if lg2 > 24:
ret false
end
v := mem.AllocateZeroed(16 as u64) as u8*
_rar5_kdf(password, salt, lg2, key, hkey, v)
mut ok := true
if chk != null:
repeat 8 in i:
if v[i] != chk[i]:
ok = false
end
end
end
mem.Free(v as void*)
ret ok
end
func _rar_derive5(kc: u8*, password: str, f: _RarFile, key: u8*, hkey: u8*): bool:
mut hit := (kc[0] as int) == 1 and (kc[1] as int) == f.kdf
if hit:
repeat 16 in i:
if kc[2 + i] != f.salt[i]:
hit = false
end
end
end
if not hit:
if not _rar5_check(password, f.salt, f.kdf, f.chk, key, hkey):
ret false
end
kc[0] = 1 as u8
kc[1] = f.kdf as u8
repeat 16 in i:
kc[2 + i] = f.salt[i]
end
repeat 32 in i:
kc[18 + i] = key[i]
kc[50 + i] = hkey[i]
end
ret true
end
repeat 32 in i:
key[i] = kc[18 + i]
hkey[i] = kc[50 + i]
end
ret true
end
func _rar_derive3(kc: u8*, password: str, f: _RarFile, key: u8*, iv: u8*):
mut hit := (kc[96] as int) == 1
if hit:
repeat 8 in i:
if kc[97 + i] != f.salt[i]:
hit = false
end
end
end
if not hit:
_rar3_kdf(password, f.salt, key, iv)
kc[96] = 1 as u8
repeat 8 in i:
kc[97 + i] = f.salt[i]
end
repeat 16 in i:
kc[105 + i] = key[i]
kc[121 + i] = iv[i]
end
ret
end
repeat 16 in i:
key[i] = kc[105 + i]
iv[i] = kc[121 + i]
end
end
func _rar_decrypt_file(kc: u8*, password: str, f: _RarFile, src: u8*, n16: int, hk: u8*, status &: int): u8*:
key := mem.AllocateZeroed(64 as u64) as u8*
hkey := mem.AllocateZeroed(64 as u64) as u8*
dst := mem.AllocateZeroed((n16 + 32) as u64) as u8*
status = 0
if f.crypt == 5 and f.salt != null and f.iv != null:
if f.kdf > 24:
status = 2
else:
if not _rar_derive5(kc, password, f, key, hkey):
status = 9
else:
mut ka := _aes_new(key, 32)
_aes_cbc_decrypt(ka, f.iv, src, dst, n16)
_aes_free(ka)
repeat 32 in i:
hk[i] = hkey[i]
end
end
end
else f.crypt == 3 and f.salt != null:
_rar_derive3(kc, password, f, key, hkey)
mut ka := _aes_new(key, 16)
_aes_cbc_decrypt(ka, hkey, src, dst, n16)
_aes_free(ka)
else f.crypt == 1 or f.crypt == 2:
repeat n16 in i:
dst[i] = src[i]
end
if f.crypt == 1:
_rar15_decrypt(password, dst, n16)
else:
_rar20_decrypt(password, dst, n16)
end
else:
status = 2
end
mem.Free(key as void*)
mem.Free(hkey as void*)
if status != 0:
mem.Free(dst as void*)
ret null
end
ret dst
end
func _rar_mac_crc(crc: u32, hk: u8*): u32:
raw := mem.AllocateZeroed(8 as u64) as u8*
raw[0] = ((crc as int) & 255) as u8
raw[1] = (((crc as int) >> 8) & 255) as u8
raw[2] = (((crc as int) >> 16) & 255) as u8
raw[3] = (((crc as int) >> 24) & 255) as u8
dg := mem.AllocateZeroed(40 as u64) as u8*
crypto.HmacSha256Raw(hk as void*, 32, raw as void*, 4, dg as void*)
mut v := 0 as u32
repeat 32 in i:
v ^= (((dg[i] as u32) & (255 as u32)) << ((i & 3) * 8))
end
mem.Free(raw as void*)
mem.Free(dg as void*)
ret v
end
package archive
import compress
import filepath
import mem
import os
import str
const _RARF_HEADER_MAX := 2097152
const _RARF_MEM_MAX := 1073741824
struct _RarVols:
pub paths: Vector<str>
pub sizes: Vector<i64>
pub pvol: Vector<int>
pub poff: Vector<i64>
pub plen: Vector<i64>
pub pfirst: Vector<int>
pub pcount: Vector<int>
end
struct _RarDecs:
pub r5: _R5
pub r3: _R3
pub ro: _ROld
end
@en "RarFile"
@fa "پرونده آر ای آر"
pub struct RarFile:
@en "path"
@fa "مسیر"
pub path: str = ""
@en "size"
@fa "اندازه"
pub size: i64 = 0 as i64
@en "status"
@fa "وضعیت"
pub status: int = 0
@en "streaming"
@fa "جریانی"
pub streaming: bool = false
@en "arc"
@fa "بایگانی"
pub arc: _RarArc = _rarf_blank()
@en "offs"
@fa "جابه جایی ها"
pub offs: Vector<i64> = Vector {} as Vector<i64>
@en "whole"
@fa "کل داده"
pub whole: compress.ByteBuf = compress.ByteBuf { data = null, len = 0, cap = 0 }
@en "password"
@fa "گذرواژه"
pub password: str = ""
@en "vols"
@fa "بخش ها"
pub vols: _RarVols = _rarf_vols()
end
func _rarf_decs(): _RarDecs:
ret _RarDecs { r5 = _r5_new(131072, 64), r3 = _r3_new(131072), ro = _ro_new(131072) }
end
func _rarf_decs_free(dc &: _RarDecs):
_r5_free(dc.r5)
_r3_free(dc.r3)
_ro_free(dc.ro)
end
func _rarf_vols(): _RarVols:
ret _RarVols {
paths = Vector {} as Vector<str> sizes = Vector {} as Vector<i64> pvol = Vector {} as Vector<int> poff = Vector {} as Vector<i64> plen = Vector {} as Vector<i64> pfirst = Vector {} as Vector<int> pcount = Vector {} as Vector<int>
}
end
func _rarf_blank(): _RarArc:
ret _RarArc {
p = null
n = 0
valid = false
v5 = false
files = Vector {} as Vector<_RarFile> enc_headers = false
multi = false
password = ""
hkey = null
h4 = false
bad_password = false
kcache = null
big = 0 as i64
}
end
func _rarf_hdr_plain(fp: void*, pos: i64, size: i64, total &: int, ok &: bool): u8*:
ok = false
total = 0
mut want := 16
if pos + (want as i64) > size:
want = (size - pos) as int
end
small := mem.AllocateZeroed(32 as u64) as u8*
got := compress.FileReadAt(fp, pos, small as void*, want)
mut l := 0
hs := _rar_vint(small, 4, got, l)
mem.Free(small as void*)
if got < want or l == 0 or hs < 2 or hs > (_RARF_HEADER_MAX as i64):
ret null
end
total = 4 + l + (hs as int)
if pos + (total as i64) > size:
ret null
end
buf := mem.AllocateZeroed((total + 16) as u64) as u8*
if compress.FileReadAt(fp, pos, buf as void*, total) != total:
mem.Free(buf as void*)
ret null
end
ok = true
ret buf
end
func _rarf_hdr_enc(rf &: RarFile, fp: void*, pos: i64, size: i64, total &: int, ok &: bool): u8*:
ok = false
total = 0
if pos + (32 as i64) > size:
rf.arc.bad_password = true
ret null
end
first := mem.AllocateZeroed(48 as u64) as u8*
if compress.FileReadAt(fp, pos, first as void*, 32) != 32:
mem.Free(first as void*)
ret null
end
plain := mem.AllocateZeroed(32 as u64) as u8*
mut ka := _aes_new(rf.arc.hkey, 32)
_aes_cbc_decrypt(ka, first, _poff(first, 16), plain, 16)
mut vl := 0
hs := _rar_vint(plain, 4, 16, vl)
mem.Free(plain as void*)
if vl == 0 or hs < 2 or hs > (_RARF_HEADER_MAX as i64):
rf.arc.bad_password = true
_aes_free(ka)
mem.Free(first as void*)
ret null
end
t := _rar_align16(4 + vl + (hs as int))
if pos + (16 as i64) + (t as i64) > size:
rf.arc.bad_password = true
_aes_free(ka)
mem.Free(first as void*)
ret null
end
cipher := mem.AllocateZeroed((t + 16) as u64) as u8*
if compress.FileReadAt(fp, pos + (16 as i64), cipher as void*, t) != t:
_aes_free(ka)
mem.Free(first as void*)
mem.Free(cipher as void*)
ret null
end
tmp := mem.AllocateZeroed((t + 16) as u64) as u8*
_aes_cbc_decrypt(ka, first, cipher, tmp, t)
_aes_free(ka)
mem.Free(first as void*)
mem.Free(cipher as void*)
hend := 4 + vl + (hs as int)
if _rar_crc(_poff(tmp, 4) as void*, hend - 4) != (_rar_u32(tmp, 0) as u32):
rf.arc.bad_password = true
mem.Free(tmp as void*)
ret null
end
total = t
ok = true
ret tmp
end
func _rarf_scan_vol(rf &: RarFile, vi: int, fp: void*, size: i64):
mem.Free(rf.arc.hkey as void*)
rf.arc.hkey = null
mut pos := 8 as i64
mut stop := false
until not stop and pos + (7 as i64) <= size:
mut total := 0
mut good := false
enc := rf.arc.hkey != null
mut buf := null as u8*
if enc:
buf = _rarf_hdr_enc(rf, fp, pos, size, total, good)
else:
buf = _rarf_hdr_plain(fp, pos, size, total, good)
end
if not good:
if not enc:
rf.status = RAR_CORRUPT
end
stop = true
break
end
disk := enc ? 16 + total : total
mut l := 0
_ := _rar_vint(buf, 4, total, l)
htype := _rar_vint(buf, 4 + l, total, l) as int
before := rf.arc.files.len()
mut next := 0
ok := _rar5_one(rf.arc, buf, total, 0, 0, disk, next)
mem.Free(buf as void*)
if htype == 2 and rf.arc.files.len() > before:
f := rf.arc.files.get(before)
rf.vols.pvol.push(vi)
rf.vols.poff.push(pos + (disk as i64))
rf.vols.plen.push(f.pack_size)
pos = pos + (disk as i64) + f.pack_size
else ok and next > 0:
pos += (next as i64)
else:
stop = true
end
end
end
func _rarf_hdr4(rf &: RarFile, fp: void*, pos: i64, size: i64, lastsalt: u8*, havekey &: bool, key: u8*, iv: u8*, hs &: int, disk &: int): u8*:
hs = 0
disk = 0
if rf.arc.h4:
if pos + (24 as i64) > size:
ret null
end
head := mem.AllocateZeroed(48 as u64) as u8*
if compress.FileReadAt(fp, pos, head as void*, 24) != 24:
mem.Free(head as void*)
ret null
end
mut same := havekey
if same:
repeat 8 in i:
if lastsalt[i] != head[i]:
same = false
end
end
end
if not same:
_rar3_kdf(rf.password, head, key, iv)
repeat 8 in i:
lastsalt[i] = head[i]
end
havekey = true
end
mut ka := _aes_new(key, 16)
first := mem.AllocateZeroed(48 as u64) as u8*
_aes_cbc_decrypt(ka, iv, _poff(head, 8), first, 16)
n := (first[5] as int) | ((first[6] as int) << 8)
mem.Free(first as void*)
mem.Free(head as void*)
if n < 7 or n > 65535:
rf.arc.bad_password = true
_aes_free(ka)
ret null
end
total := _rar_align16(n)
if pos + (8 as i64) + (total as i64) > size:
rf.arc.bad_password = true
_aes_free(ka)
ret null
end
cipher := mem.AllocateZeroed((total + 16) as u64) as u8*
if compress.FileReadAt(fp, pos + (8 as i64), cipher as void*, total) != total:
mem.Free(cipher as void*)
_aes_free(ka)
ret null
end
tmp := mem.AllocateZeroed((total + 16) as u64) as u8*
_aes_cbc_decrypt(ka, iv, cipher, tmp, total)
_aes_free(ka)
mem.Free(cipher as void*)
if (_rar_crc(_poff(tmp, 2) as void*, n - 2) & (0xffff as u32)) != ((_rar_u32(tmp, 0) & 0xffff) as u32):
rf.arc.bad_password = true
mem.Free(tmp as void*)
ret null
end
hs = total
disk = 8 + total
ret tmp
end
head := mem.AllocateZeroed(16 as u64) as u8*
if compress.FileReadAt(fp, pos, head as void*, 7) != 7:
mem.Free(head as void*)
ret null
end
n := (head[5] as int) | ((head[6] as int) << 8)
mem.Free(head as void*)
if n < 7 or pos + (n as i64) > size:
ret null
end
buf := mem.AllocateZeroed((n + 16) as u64) as u8*
if compress.FileReadAt(fp, pos, buf as void*, n) != n:
mem.Free(buf as void*)
ret null
end
hs = n
disk = n
ret buf
end
func _rarf_scan_vol4(rf &: RarFile, vi: int, fp: void*, size: i64):
rf.arc.big = size
rf.arc.h4 = false
lastsalt := mem.AllocateZeroed(16 as u64) as u8*
key := mem.AllocateZeroed(32 as u64) as u8*
iv := mem.AllocateZeroed(32 as u64) as u8*
mut havekey := false
mut pos := 7 as i64
mut stop := false
until not stop and pos + (7 as i64) <= size:
mut hs := 0
mut disk := 0
buf := _rarf_hdr4(rf, fp, pos, size, lastsalt, havekey, key, iv, hs, disk)
if buf == null:
if not rf.arc.bad_password and not rf.arc.h4:
rf.status = RAR_CORRUPT
end
break
end
htype := buf[2] as int
before := rf.arc.files.len()
mut next := 0 as i64
ok := _rar4_one(rf.arc, buf, hs, 0, pos, disk, next)
mem.Free(buf as void*)
if htype == 0x74 and rf.arc.files.len() > before:
f := rf.arc.files.get(before)
rf.vols.pvol.push(vi)
rf.vols.poff.push(pos + (disk as i64))
rf.vols.plen.push(f.pack_size)
if next <= pos:
stop = true
end
pos = next
else ok and next > pos:
pos = next
else:
stop = true
end
end
mem.Free(lastsalt as void*)
mem.Free(key as void*)
mem.Free(iv as void*)
end
func _rarf_merge(rf &: RarFile):
n := rf.arc.files.len()
mut any := false
repeat n in k:
g := rf.arc.files.get(k)
if g.split_before or g.split_after:
any = true
end
end
mut out := Vector {} as Vector<_RarFile>
mut nv := Vector {} as Vector<int>
mut no := Vector {} as Vector<i64>
mut nl := Vector {} as Vector<i64>
mut pf := Vector {} as Vector<int>
mut pc := Vector {} as Vector<int>
mut i := 0
until i < n:
f := rf.arc.files.get(i)
i++
if f.split_after and not f.split_before:
mut j := i
mut total := f.pack_size
mut complete := false
until j < n:
g := rf.arc.files.get(j)
if g.name != f.name or not g.split_before:
break
end
total += g.pack_size
j++
if not g.split_after:
complete = true
break
end
end
pf.push(nv.len())
if complete:
mut k := i - 1
until k < j:
nv.push(rf.vols.pvol.get(k))
no.push(rf.vols.poff.get(k))
nl.push(rf.vols.plen.get(k))
k++
end
pc.push(j - i + 1)
last := rf.arc.files.get(j - 1)
mut merged := f
merged.pack_size = total
merged.split = false
merged.split_before = false
merged.split_after = false
merged.crc = last.crc
merged.has_crc = last.has_crc
merged.cflags = last.cflags
out.push(merged)
else:
nv.push(rf.vols.pvol.get(i - 1))
no.push(rf.vols.poff.get(i - 1))
nl.push(rf.vols.plen.get(i - 1))
pc.push(1)
out.push(f)
end
mut d := i
until d < j:
_rar_free_name(rf.arc.files.get(d).name)
_rar_free_name(rf.arc.files.get(d).rtarget)
_rar_free_part(rf.arc.files.get(d))
d++
end
i = j
else:
pf.push(nv.len())
pc.push(1)
nv.push(rf.vols.pvol.get(i - 1))
no.push(rf.vols.poff.get(i - 1))
nl.push(rf.vols.plen.get(i - 1))
out.push(f)
end
end
rf.arc.files.free()
rf.arc.files = out
rf.vols.pvol.free()
rf.vols.poff.free()
rf.vols.plen.free()
rf.vols.pvol = nv
rf.vols.poff = no
rf.vols.plen = nl
rf.vols.pfirst.free()
rf.vols.pcount.free()
rf.vols.pfirst = pf
rf.vols.pcount = pc
rf.offs.free()
repeat rf.arc.files.len() in e:
rf.offs.push(rf.vols.poff.get(rf.vols.pfirst.get(e)))
end
end
func _rarf_add_volume(rf &: RarFile, path: str): bool:
fp := compress.FileOpenRead(path)
if fp == null:
ret false
end
size := compress.FileSize(fp)
head := mem.AllocateZeroed(16 as u64)
got := compress.FileReadAt(fp, 0 as i64, head, 8)
v5 := got == 8 and _rar5_sig_match(head, 8)
v4 := got >= 7 and _rar4_sig_match(head, 7)
mem.Free(head)
good := v5 or v4
if good:
vi := rf.vols.paths.len()
rf.vols.paths.push(str.Clone(path))
rf.vols.sizes.push(size)
if v5:
_rarf_scan_vol(rf, vi, fp, size)
else:
_rarf_scan_vol4(rf, vi, fp, size)
end
end
compress.FileClose(fp)
ret good
end
func _rarf_finish(rf &: RarFile):
_rarf_merge(rf)
if rf.status == RAR_OK:
rf.status = _rar_arc_status(rf.arc)
end
end
func _rarf_src(rf: RarFile, idx: int): _RarSrc:
mut s := _rsrc_files(rf.vols.paths)
first := rf.vols.pfirst.get(idx)
cnt := rf.vols.pcount.get(idx)
repeat cnt in k:
_rsrc_add(s, rf.vols.pvol.get(first + k), rf.vols.poff.get(first + k), rf.vols.plen.get(first + k))
end
ret s
end
func _rarf_entry(rf: RarFile, dc &: _RarDecs, nx &: int, rd &: int, idx: int, sink &: compress.FileSink, memcap: i64): int:
f := rf.arc.files.get(idx)
if f.split:
ret RAR_MULTIVOLUME
end
if f.is_dir or f.redirect:
if nx == idx: nx = idx + 1 end
ret RAR_OK
end
if sink.cap > (0 as i64) and f.unp_size > sink.cap:
ret RAR_TOO_BIG
end
if f.pack_size < (0 as i64):
ret RAR_CORRUPT
end
mut pcap := _RARF_MEM_MAX as i64
if memcap > (0 as i64) and memcap < pcap: pcap = memcap end
mut src := _rarf_src(rf, idx)
mut hk := null as u8*
mut st := RAR_OK
if f.encrypted and rf.arc.v5:
if rf.password.len() == 0:
st = RAR_ENCRYPTED
else f.crypt != 5 or f.salt == null or f.iv == null or f.kdf > 24:
st = RAR_UNSUPPORTED
else:
key := mem.AllocateZeroed(64 as u64) as u8*
hkey := mem.AllocateZeroed(64 as u64) as u8*
if _rar_derive5(rf.arc.kcache, rf.password, f, key, hkey):
_rsrc_encrypt(src, key, 32, f.iv)
src.total &= (~(15 as i64))
hk = hkey
else:
mem.Free(hkey as void*)
st = RAR_BAD_PASSWORD
end
mem.Free(key as void*)
end
end
mut iv4 := null as u8*
if f.encrypted and not rf.arc.v5 and f.crypt == 3 and st == RAR_OK:
if rf.password.len() == 0:
st = RAR_ENCRYPTED
else f.salt == null:
st = RAR_UNSUPPORTED
else:
key := mem.AllocateZeroed(64 as u64) as u8*
iv4 = mem.AllocateZeroed(64 as u64) as u8*
_rar_derive3(rf.arc.kcache, rf.password, f, key, iv4)
_rsrc_encrypt(src, key, 16, iv4)
src.total &= (~(15 as i64))
mem.Free(key as void*)
end
end
if st == RAR_OK and not rf.arc.v5:
st = _rarf_entry4(rf, src, dc, nx, rd, idx, sink, pcap, memcap)
else st == RAR_OK:
st = _rarf_decode(rf, src, dc, nx, rd, idx, sink, pcap, memcap)
end
if st == RAR_OK and sink.fp != null and f.has_crc:
mut c := sink.crc
if hk != null and (f.cflags & 2) != 0:
c = _rar_mac_crc(c, hk)
end
if c != f.crc:
st = (f.crypt >= 1 and f.crypt <= 3) ? RAR_BAD_PASSWORD : RAR_BAD_CRC
end
end
mem.Free(hk as void*)
_rsrc_free(src)
mem.Free(iv4 as void*)
ret st
end
func _rarf_entry4(rf: RarFile, src &: _RarSrc, dc &: _RarDecs, nx &: int, rd &: int, idx: int, sink &: compress.FileSink, pcap: i64, memcap: i64): int:
f := rf.arc.files.get(idx)
if f.encrypted and f.crypt != 3:
ret _rarf_entry4m(rf, src, dc, nx, rd, idx, sink, pcap, memcap)
end
if f.unp_size == 0 and f.pack_size == 0:
if nx == idx: nx = idx + 1 end
ret RAR_OK
end
if f.method != 0:
if f.ver != 29 and f.ver != 36 and f.ver != 20 and f.ver != 26 and f.ver != 15:
ret RAR_UNSUPPORTED
end
if f.method > 5:
ret RAR_UNSUPPORTED
end
end
if f.method == 0:
mut want := f.pack_size
if f.encrypted:
want = f.unp_size
if want < (0 as i64) or want > src.total:
ret RAR_CORRUPT
end
else f.unp_size >= (0 as i64) and f.unp_size != f.pack_size:
ret RAR_CORRUPT
end
mut at := 0 as i64
until at < want:
mut n := 65536
if want - at < (n as i64): n = (want - at) as int end
p := _rsrc_get(src, at, n)
if p == null:
ret RAR_CORRUPT
end
if not compress.SinkWrite(sink, p as void*, n):
ret sink.over ? RAR_TOO_BIG : RAR_CORRUPT
end
at += n as i64
end
if nx == idx: nx = idx + 1 end
ret RAR_OK
end
if f.solid and nx != idx:
s0 := _rar_chain_start(rf.arc, idx)
nx = s0
rd = 0
mut k := s0
until k < idx:
mut scratch := compress.FileSink {}
cst := _rarf_entry(rf, dc, nx, rd, k, scratch, memcap)
if cst != RAR_OK:
nx = -1
rd = 0
ret cst
end
k++
end
nx = idx
end
mut st := RAR_OK
mut out := compress.NewByteBufCap(4194304)
lim := sink.cap > (0 as i64) ? sink.cap : (4611686018427387904 as i64)
if f.ver == 29 or f.ver == 36:
if not f.solid or rd == 0:
w := _rar_win_size(rf.arc, idx)
if not _r3_setwin(dc.r3, w as int):
st = RAR_WINDOW_TOO_BIG
else:
_r3_reset(dc.r3)
end
end
if st == RAR_OK:
st = _r3_decode_src(dc.r3, src, f.unp_size, lim, out, sink, true)
end
else:
if not f.solid or rd == 0:
w := _rar_win_size(rf.arc, idx)
if not _ro_setwin(dc.ro, w as int):
st = RAR_WINDOW_TOO_BIG
else:
_ro_reset(dc.ro)
end
end
if st == RAR_OK and f.ver == 15:
st = _ro15_decode_src(dc.ro, src, f.unp_size, lim, f.solid, out, sink, true)
else st == RAR_OK:
st = _ro20_decode_src(dc.ro, src, f.unp_size, lim, f.solid, out, sink, true)
end
end
compress.BufFree(out)
if st != RAR_OK:
nx = -1
rd = 0
ret sink.over ? RAR_TOO_BIG : st
end
rd = 1
nx = idx + 1
ret RAR_OK
end
func _rarf_entry4m(rf: RarFile, src &: _RarSrc, dc &: _RarDecs, nx &: int, rd &: int, idx: int, sink &: compress.FileSink, pcap: i64, memcap: i64): int:
f := rf.arc.files.get(idx)
if f.unp_size == 0 and f.pack_size == 0:
if nx == idx: nx = idx + 1 end
ret RAR_OK
end
if f.method != 0:
if f.ver != 29 and f.ver != 36 and f.ver != 20 and f.ver != 26 and f.ver != 15:
ret RAR_UNSUPPORTED
end
if f.method > 5:
ret RAR_UNSUPPORTED
end
end
if src.total > (_R5_MAXBLOCK as i64) or src.total > pcap:
ret RAR_TOO_BIG
end
n := src.total as int
raw := mem.AllocateZeroed((n + 32) as u64) as u8*
if not _rsrc_raw(src, 0 as i64, raw, n):
mem.Free(raw as void*)
ret RAR_CORRUPT
end
mut data := raw
mut dn := n
mut hk := null as u8*
if f.encrypted:
if rf.password.len() == 0:
mem.Free(raw as void*)
ret RAR_ENCRYPTED
end
n16 := f.crypt == 1 ? n : (n & (~15))
hk = mem.AllocateZeroed(64 as u64) as u8*
mut dst := 0
dec := _rar_decrypt_file(rf.arc.kcache, rf.password, f, raw, n16, hk, dst)
mem.Free(raw as void*)
mem.Free(hk as void*)
if dec == null:
ret dst == 9 ? RAR_BAD_PASSWORD : RAR_UNSUPPORTED
end
data = dec
dn = n16
end
mut st := RAR_OK
if f.method == 0:
mut want := f.pack_size as int
if f.encrypted:
want = f.unp_size as int
else f.unp_size >= (0 as i64) and f.unp_size != f.pack_size:
st = RAR_CORRUPT
end
if st == RAR_OK and (want < 0 or want > dn):
st = RAR_CORRUPT
end
if st == RAR_OK and not compress.SinkWrite(sink, data as void*, want):
st = sink.over ? RAR_TOO_BIG : RAR_CORRUPT
end
if st == RAR_OK and nx == idx:
nx = idx + 1
end
mem.Free(data as void*)
ret st
end
if f.solid and nx != idx:
s0 := _rar_chain_start(rf.arc, idx)
nx = s0
rd = 0
mut k := s0
until k < idx:
mut scratch := compress.FileSink {}
cst := _rarf_entry(rf, dc, nx, rd, k, scratch, memcap)
if cst != RAR_OK:
nx = -1
rd = 0
mem.Free(data as void*)
ret cst
end
k++
end
nx = idx
end
mut out := compress.NewByteBufCap(4194304)
lim := sink.cap > (0 as i64) ? sink.cap : (4611686018427387904 as i64)
if f.ver == 29 or f.ver == 36:
if not f.solid or rd == 0:
w := _rar_win_size(rf.arc, idx)
if not _r3_setwin(dc.r3, w as int):
st = RAR_WINDOW_TOO_BIG
else:
_r3_reset(dc.r3)
end
end
if st == RAR_OK:
st = _r3_decode(dc.r3, data, dn, f.unp_size, lim, out, sink, true)
end
else:
if not f.solid or rd == 0:
w := _rar_win_size(rf.arc, idx)
if not _ro_setwin(dc.ro, w as int):
st = RAR_WINDOW_TOO_BIG
else:
_ro_reset(dc.ro)
end
end
if st == RAR_OK and f.ver == 15:
st = _ro15_decode(dc.ro, data, dn, f.unp_size, lim, f.solid, out, sink, true)
else st == RAR_OK:
st = _ro20_decode(dc.ro, data, dn, f.unp_size, lim, f.solid, out, sink, true)
end
end
compress.BufFree(out)
mem.Free(data as void*)
if st != RAR_OK:
nx = -1
rd = 0
ret sink.over ? RAR_TOO_BIG : st
end
rd = 1
nx = idx + 1
ret RAR_OK
end
func _rarf_decode(rf: RarFile, src &: _RarSrc, dc &: _RarDecs, nx &: int, rd &: int, idx: int, sink &: compress.FileSink, pcap: i64, memcap: i64): int:
f := rf.arc.files.get(idx)
if f.unp_size == 0 and f.pack_size == 0:
if nx == idx: nx = idx + 1 end
ret RAR_OK
end
if f.method == 0:
mut want := f.pack_size
if f.encrypted:
want = f.unp_size
if want < (0 as i64) or want > src.total:
ret RAR_CORRUPT
end
else f.unp_size >= (0 as i64) and f.unp_size != f.pack_size:
ret RAR_CORRUPT
end
mut at := 0 as i64
until at < want:
mut n := 65536
if want - at < (n as i64): n = (want - at) as int end
p := _rsrc_get(src, at, n)
if p == null:
ret RAR_CORRUPT
end
if not compress.SinkWrite(sink, p as void*, n):
ret sink.over ? RAR_TOO_BIG : RAR_CORRUPT
end
at += n as i64
end
if nx == idx: nx = idx + 1 end
ret RAR_OK
end
if f.ver > 1 or f.method > 5:
ret RAR_UNSUPPORTED
end
if f.solid and nx != idx:
s := _rar_chain_start(rf.arc, idx)
nx = s
rd = 0
mut k := s
until k < idx:
mut scratch := compress.FileSink {}
st := _rarf_entry(rf, dc, nx, rd, k, scratch, memcap)
if st != RAR_OK:
nx = -1
rd = 0
ret st
end
k++
end
nx = idx
end
if not f.solid or rd == 0:
mut w := _rar_win_size(rf.arc, idx)
if w > pcap or w > (_RARF_MEM_MAX as i64):
w = pcap < (_RARF_MEM_MAX as i64) ? pcap : (_RARF_MEM_MAX as i64)
mut pw := 131072 as i64
until pw * (2 as i64) > w:
pw *= (2 as i64)
end
if w < (131072 as i64):
ret RAR_WINDOW_TOO_BIG
end
w = pw
end
if not _r5_setwin(dc.r5, w as int):
ret RAR_WINDOW_TOO_BIG
end
dc.r5.dcsize = f.dc
_r5_reset(dc.r5)
end
mut out := compress.NewByteBufCap(4194304)
lim := sink.cap > (0 as i64) ? sink.cap : (4611686018427387904 as i64)
st := _r5_decode_src(dc.r5, src, f.unp_size, lim, out, sink, true)
compress.BufFree(out)
if st != 0:
nx = -1
rd = 0
if st == 4 and dc.r5.far and f.dict > (dc.r5.wsize as i64):
ret RAR_WINDOW_TOO_BIG
end
ret sink.over ? RAR_TOO_BIG : st
end
rd = 1
nx = idx + 1
ret RAR_OK
end
func _rarf_write(rf: RarFile, dc &: _RarDecs, nx &: int, rd &: int, idx: int, outpath: str, cap: i64, memcap: i64): int:
mut sink := compress.SinkOpen(outpath, cap)
if sink.failed:
ret RAR_NOT_FOUND
end
st := _rarf_entry(rf, dc, nx, rd, idx, sink, memcap)
closed := compress.SinkClose(sink)
if st == RAR_OK and not closed:
os.Remove(outpath)
ret RAR_CORRUPT
end
if st != RAR_OK:
os.Remove(outpath)
end
ret st
end
func _rarf_whole_to(rf: RarFile, idx: int, outpath: str, cap: i64): int:
f := rf.arc.files.get(idx)
mut st := 0
mut out := _rar_read_from(rf.arc, f.name, 0, st)
if st == RAR_OK and cap > (0 as i64) and (out.len as i64) > cap:
st = RAR_TOO_BIG
end
if st == RAR_OK and not WriteBinaryFileBuf(outpath, out):
st = RAR_CORRUPT
end
compress.BufFree(out)
ret st
end
func _rarf_reload_whole(rf &: RarFile, path: str):
if rf.size > (2000000000 as i64):
rf.status = RAR_TOO_BIG
ret
end
_rar_free_files(rf.arc.files)
_rar_close_arc(rf.arc)
rf.streaming = false
mut ok := false
rf.whole = ReadBinaryFile(path, ok)
if ok and IsRar(rf.whole.data, rf.whole.len):
rf.arc = _rar_open(rf.whole.data, rf.whole.len, rf.password)
rf.status = _rar_arc_status(rf.arc)
else:
rf.arc = _rarf_blank()
rf.status = RAR_CORRUPT
end
end
func _rarf_open_with(path: str, password: str, volumes: bool): RarFile:
mut rf := RarFile { path = str.Clone(path), status = RAR_CORRUPT, password = password.len() > 0 ? str.Clone(password) : "" }
rf.arc.password = rf.password
fp := compress.FileOpenRead(path)
if fp == null:
rf.status = RAR_NOT_FOUND
ret rf
end
rf.size = compress.FileSize(fp)
head := mem.AllocateZeroed(16 as u64)
got := compress.FileReadAt(fp, 0 as i64, head, 8)
compress.FileClose(fp)
if (got == 8 and _rar5_sig_match(head, 8)) or (got >= 7 and _rar4_sig_match(head, 7)):
rf.streaming = true
rf.arc.kcache = mem.AllocateZeroed(256 as u64) as u8*
rf.arc.valid = true
rf.arc.v5 = got == 8 and _rar5_sig_match(head, 8)
rf.status = RAR_OK
if _rarf_add_volume(rf, path) and volumes:
mut idx := 1
until true:
vp := _rar_volume_path(path, idx)
if vp.len() == 0:
break
end
if not os.Exists(vp):
mem.Free(vp as void*)
break
end
good := _rarf_add_volume(rf, vp)
mem.Free(vp as void*)
if not good:
break
end
idx++
end
end
_rarf_finish(rf)
else:
if rf.size > (2000000000 as i64) or volumes:
rf.status = volumes ? RAR_UNSUPPORTED : RAR_TOO_BIG
else:
_rarf_reload_whole(rf, path)
end
end
mem.Free(head)
ret rf
end
@en "RarFileOpen"
@fa "بازکردن پرونده آر ای آر"
pub func RarFileOpen(path: str): RarFile:
ret _rarf_open_with(path, "", false)
end
@en "RarFileOpenWith"
@fa "بازکردن پرونده آر ای آر با گذرواژه"
pub func RarFileOpenWith(path: str, password: str): RarFile:
ret _rarf_open_with(path, password, false)
end
@en "RarFileOpenVolumes"
@fa "بازکردن بخش های پرونده آر ای آر"
pub func RarFileOpenVolumes(first: str, password: str): RarFile:
ret _rarf_open_with(first, password, true)
end
@en "RarFileClose"
@fa "بستن پرونده آر ای آر"
pub func RarFileClose(rf &: RarFile):
_rar_free_files(rf.arc.files)
_rar_close_arc(rf.arc)
rf.offs.free()
repeat rf.vols.paths.len() in i:
mem.Free(rf.vols.paths.get(i) as void*)
end
rf.vols.paths.free()
rf.vols.sizes.free()
rf.vols.pvol.free()
rf.vols.poff.free()
rf.vols.plen.free()
rf.vols.pfirst.free()
rf.vols.pcount.free()
compress.BufFree(rf.whole)
if rf.path.len() > 0:
mem.Free(rf.path as void*)
end
if rf.password.len() > 0:
mem.Free(rf.password as void*)
end
rf.path = ""
rf.password = ""
end
@en "RarFileEntries"
@fa "مدخل های پرونده آر ای آر"
pub func RarFileEntries(rf &: RarFile): Vector<Entry>:
ret _rar_entries_of(rf.arc, false)
end
@en "RarFileExtractTo"
@fa "استخراج از پرونده آر ای آر به پرونده"
pub func RarFileExtractTo(rf &: RarFile, name: str, destpath: str, cap: i64, memcap: i64): int:
if rf.status != RAR_OK:
ret rf.status
end
idx := _rar_find(rf.arc, name)
if idx < 0:
ret RAR_NOT_FOUND
end
if not rf.streaming:
ret _rarf_whole_to(rf, idx, destpath, cap)
end
mut dc := _rarf_decs()
mut nx := -1
mut rd := 0
st := _rarf_write(rf, dc, nx, rd, idx, destpath, cap, memcap)
_rarf_decs_free(dc)
ret st
end
@en "RarFileExtractAll"
@fa "استخراج همه از پرونده آر ای آر"
pub func RarFileExtractAll(rf &: RarFile, destdir: str, cap: i64, memcap: i64): int:
if rf.status != RAR_OK:
ret rf.status
end
if not rf.streaming:
repeat rf.arc.files.len() in k:
if cap > (0 as i64) and rf.arc.files.get(k).unp_size > cap:
ret RAR_TOO_BIG
end
end
mut wst := RAR_OK
_ := _rar_extract_all_of(rf.arc, destdir, wst)
ret wst
end
mut dc := _rarf_decs()
mut first := RAR_OK
mut nx := -1
mut rd := 0
mut made := Vector {} as Vector<str>
repeat rf.arc.files.len() in i:
f := rf.arc.files.get(i)
mut st := RAR_OK
if not _safe_entry_name(f.name) or _rar_under_link(f.name, made):
st = RAR_UNSAFE_PATH
else:
outpath := filepath.Join(destdir, f.name)
if f.is_dir:
EnsureDir(outpath)
if nx == i: nx = i + 1 end
else f.redirect:
if nx == i: nx = i + 1 end
parent := filepath.Dir(outpath)
EnsureDir(parent)
mem.Free(parent as void*)
if f.rkind == 1:
_ := _rar_make_link(f, f.rtarget, outpath, made, st)
else f.rkind == 4 or f.rkind == 5:
_ := _rar_copy_link(f, destdir, outpath, made, st)
else:
st = RAR_UNSUPPORTED
end
else:
parent := filepath.Dir(outpath)
EnsureDir(parent)
mem.Free(parent as void*)
if os.Exists(outpath):
_rar_set_mode(outpath, 0x1a4)
end
st = _rarf_write(rf, dc, nx, rd, i, outpath, cap, memcap)
if st == RAR_OK and f.rkind == 1:
mut tok := false
mut tb := ReadBinaryFile(outpath, tok)
os.Remove(outpath)
if tok and tb.len > 0 and tb.len < 4096:
tgt := compress.BufToStrUnsafe(tb)
_ := _rar_make_link(f, tgt, outpath, made, st)
_rar_free_name(tgt)
else:
st = RAR_CORRUPT
end
compress.BufFree(tb)
else st == RAR_OK:
_rar_apply_meta(f, outpath)
end
end
mem.Free(outpath as void*)
end
if st != RAR_OK and first == RAR_OK:
first = st
end
end
mut j := rf.arc.files.len() - 1
until j >= 0:
f := rf.arc.files.get(j)
j--
if f.is_dir and _safe_entry_name(f.name) and not _rar_under_link(f.name, made):
dpath := filepath.Join(destdir, f.name)
if os.IsDir(dpath):
_rar_apply_meta(f, dpath)
end
mem.Free(dpath as void*)
end
end
repeat made.len() in k:
mem.Free(made.get(k) as void*)
end
made.free()
_rarf_decs_free(dc)
ret first
end
package archive
import compress
import fs
import mem
import os
import str
import time
mut _arc_tmp_seq := 0 as i64
if SALAM_OS_WINDOWS:
func _rar_symlink(target: str, path: str): bool:
ret false
end
func _rar_set_mtime(path: str, t: i64): bool:
ret false
end
func _rar_set_mode(path: str, mode: int): bool:
ret false
end
else:
func _rar_symlink(target: str, path: str): bool:
if os.IsDir(path):
ret false
end
if os.Exists(path):
os.Remove(path)
end
ret symlink(target, path) == 0
end
if SALAM_ARCH_X86 or SALAM_ARCH_ARM or SALAM_ARCH_WASM:
func _rar_utimes(path: str, t: i64): bool:
ret false
end
else:
func _rar_utimes(path: str, t: i64): bool:
tv := mem.AllocateZeroed(32 as u64) as i64*
tv[0] = t
tv[2] = t
r := utimes(path, tv as void*)
mem.Free(tv as void*)
ret r == 0
end
end
func _rar_set_mtime(path: str, t: i64): bool:
if t <= 0:
ret false
end
ret _rar_utimes(path, t)
end
func _rar_set_mode(path: str, mode: int): bool:
ret fs.Chmod(path, mode & 0x1ff) == 0
end
end
func _arc_tmp_tag(): str:
_arc_tmp_seq++
pid := str.FromInt(_arc_pid() as i64)
now := str.FromInt(time.NowNanos())
seq := str.FromInt(_arc_tmp_seq)
tag := pid + "_" + now + "_" + seq
mem.Free(pid as void*)
mem.Free(now as void*)
mem.Free(seq as void*)
ret tag
end
func _arc_pid(): int:
if SALAM_ARCH_WASM:
ret 1
else:
ret os.Pid()
end
end
func _rar_is_sep(c: int): bool:
ret c == 47 or c == 92
end
func _rar_under_link(name: str, made: Vector<str>): bool:
nb := name as u8*
nl := name.len()
repeat made.len() in k:
m := made.get(k)
ml := m.len()
if ml == 0 or ml > nl:
continue
end
mb := m as u8*
mut same := true
mut i := 0
until i < ml:
if nb[i] != mb[i]:
same = false
break
end
i++
end
if same and (nl == ml or _rar_is_sep(nb[ml] as int)):
ret true
end
end
ret false
end
func _rar_cur_is_link(cur: compress.ByteBuf, made: Vector<str>): bool:
repeat made.len() in k:
m := made.get(k)
if m.len() != cur.len:
continue
end
mb := m as u8*
cb := cur.data as u8*
mut same := true
mut i := 0
until i < cur.len:
if cb[i] != mb[i]:
same = false
break
end
i++
end
if same:
ret true
end
end
ret false
end
func _rar_link_target_ok(name: str, target: str, made: Vector<str>): bool:
tl := target.len()
if tl == 0 or tl > 4096:
ret false
end
tb := target as u8*
if _rar_is_sep(tb[0] as int) or (tl >= 2 and (tb[1] as int) == 58):
ret false
end
nb := name as u8*
mut last := -1
repeat name.len() in i:
if _rar_is_sep(nb[i] as int):
last = i
end
end
mut cur := compress.NewByteBuf()
mut ok := true
mut pass := 0
until pass < 2:
mut src := tb
mut n := tl
if pass == 0:
src = nb
n = last + 1
end
mut start := 0
mut i := 0
until i <= n:
c := i < n ? src[i] as int : 47
if _rar_is_sep(c):
cl := i - start
if cl == 0 or (cl == 1 and (src[start] as int) == 46):
start = i + 1
i++
continue
end
if cl == 2 and (src[start] as int) == 46 and (src[start + 1] as int) == 46:
if cur.len == 0 or _rar_cur_is_link(cur, made):
ok = false
break
end
mut cut := cur.len - 1
until cut >= 0 and not _rar_is_sep(((cur.data as u8*)[cut]) as int):
cut--
end
cur.len = cut < 0 ? 0 : cut
else:
if cur.len > 0:
compress.BufPush(cur, 47)
end
compress.BufPushBytes(cur, ((src as i64) + (start as i64)) as void*, cl)
end
start = i + 1
