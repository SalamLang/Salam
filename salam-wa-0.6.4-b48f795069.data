if kind == H2_HEADERS: ret "HEADERS" end
if kind == H2_PRIORITY: ret "PRIORITY" end
if kind == H2_RST_STREAM: ret "RST_STREAM" end
if kind == H2_SETTINGS: ret "SETTINGS" end
if kind == H2_PUSH_PROMISE: ret "PUSH_PROMISE" end
if kind == H2_PING: ret "PING" end
if kind == H2_GOAWAY: ret "GOAWAY" end
if kind == H2_WINDOW_UPDATE: ret "WINDOW_UPDATE" end
if kind == H2_CONTINUATION: ret "CONTINUATION" end
ret "UNKNOWN"
end
@en "ErrorName"
@fa "نام خطا"
pub func ErrorName(code: int): str:
if code == H2_NO_ERROR: ret "NO_ERROR" end
if code == H2_PROTOCOL_ERROR: ret "PROTOCOL_ERROR" end
if code == H2_INTERNAL_ERROR: ret "INTERNAL_ERROR" end
if code == H2_FLOW_CONTROL_ERROR: ret "FLOW_CONTROL_ERROR" end
if code == H2_SETTINGS_TIMEOUT: ret "SETTINGS_TIMEOUT" end
if code == H2_STREAM_CLOSED: ret "STREAM_CLOSED" end
if code == H2_FRAME_SIZE_ERROR: ret "FRAME_SIZE_ERROR" end
if code == H2_REFUSED_STREAM: ret "REFUSED_STREAM" end
if code == H2_CANCEL: ret "CANCEL" end
if code == H2_COMPRESSION_ERROR: ret "COMPRESSION_ERROR" end
if code == H2_CONNECT_ERROR: ret "CONNECT_ERROR" end
if code == H2_ENHANCE_YOUR_CALM: ret "ENHANCE_YOUR_CALM" end
if code == H2_INADEQUATE_SECURITY: ret "INADEQUATE_SECURITY" end
if code == H2_HTTP_1_1_REQUIRED: ret "HTTP_1_1_REQUIRED" end
ret "UNKNOWN"
end
@en "NewHeader"
@fa "سرآیند جدید"
pub func NewHeader(name: str, value: str): Header:
mut h := Header {}
h.name = name
h.value = value
ret h
end
@en "NewSensitiveHeader"
@fa "سرآیند حساس"
pub func NewSensitiveHeader(name: str, value: str): Header:
mut h := Header {}
h.name = name
h.value = value
h.sensitive = true
ret h
end
@en "HeadersAdd"
@fa "افزودن سرآیند"
pub func HeadersAdd(hl &: HeaderList, name: str, value: str):
hl.items.push(NewHeader(name, value))
end
@en "HeadersAddSensitive"
@fa "افزودن سرآیند حساس"
pub func HeadersAddSensitive(hl &: HeaderList, name: str, value: str):
hl.items.push(NewSensitiveHeader(name, value))
end
@en "HeadersGet"
@fa "دریافت سرآیند"
pub func HeadersGet(hl: HeaderList, name: str): str:
mut i := 0
until i < hl.items.len():
h := hl.items.get(i)
if h.name == name: ret h.value end
i++
end
ret ""
end
@en "HeadersHas"
@fa "سرآیند دارد"
pub func HeadersHas(hl: HeaderList, name: str): bool:
mut i := 0
until i < hl.items.len():
if hl.items.get(i).name == name: ret true end
i++
end
ret false
end
@en "HeadersCount"
@fa "تعداد سرآیندها"
pub func HeadersCount(hl: HeaderList): int:
ret hl.items.len()
end
@en "DefaultSettings"
@fa "تنظیمات پیش‌فرض"
pub func DefaultSettings(): Settings:
ret Settings {}
end
@en "conf"
@fa "پیکربندی وب"
package conf
import str
const T_EOF := 0
const T_WORD := 1
const T_STR := 2
const T_NUM := 3
const T_EQ := 4
const T_COLON := 5
@en "VAL_WORD"
@fa "مقدار واژه"
pub const VAL_WORD := 0
@en "VAL_STR"
@fa "مقدار رشته"
pub const VAL_STR := 1
@en "VAL_NUM"
@fa "مقدار عددی"
pub const VAL_NUM := 2
struct Tok:
pub kind: int = 0
pub text: str = ""
pub line: int = 0
pub col: int = 0
end
@en "Value"
@fa "مقدار"
pub struct Value:
@en "kind"
@fa "نوع مقدار"
pub kind: int = 0
@en "text"
@fa "متن مقدار"
pub text: str = ""
@en "line"
@fa "خط مقدار"
pub line: int = 0
@en "col"
@fa "ستون مقدار"
pub col: int = 0
end
@en "Node"
@fa "گره"
pub struct Node:
@en "block"
@fa "بلوک است"
pub block: bool = false
@en "words"
@fa "واژه های نام"
pub words: Vector<str> = Vector {}
@en "labels"
@fa "برچسب ها"
pub labels: Vector<str> = Vector {}
@en "values"
@fa "مقدارها"
pub values: Vector<Value> = Vector {}
@en "children"
@fa "فرزندان"
pub children: Vector<int> = Vector {}
@en "line"
@fa "خط گره"
pub line: int = 0
@en "col"
@fa "ستون گره"
pub col: int = 0
end
@en "Doc"
@fa "سند"
pub struct Doc:
@en "nodes"
@fa "گره ها"
pub nodes: Vector<Node> = Vector {}
@en "ok"
@fa "درست است"
pub ok: bool = true
@en "error"
@fa "پیام خطا"
pub error: str = ""
@en "line"
@fa "خط خطا"
pub line: int = 0
@en "col"
@fa "ستون خطا"
pub col: int = 0
end
func _fail(d &: Doc, line: int, col: int, msg: str):
if d.ok:
d.ok = false
d.error = msg
d.line = line
d.col = col
end
end
func _is_word_start(c: int): bool:
if c >= 97 and c <= 122: ret true end
if c >= 65 and c <= 90: ret true end
if c == 95: ret true end
ret c >= 128
end
func _is_word_char(c: int): bool:
if _is_word_start(c): ret true end
ret c >= 48 and c <= 57
end
func _is_digit(c: int): bool:
ret c >= 48 and c <= 57
end
func _is_num_char(c: int): bool:
if _is_digit(c): ret true end
if c == 46 or c == 37: ret true end
if c >= 97 and c <= 122: ret true end
ret c >= 65 and c <= 90
end
func _unescape_at(c: int): str:
if c == 110: ret "\n" end
if c == 116: ret "\t" end
if c == 114: ret "\r" end
if c == 34: ret "\"" end
if c == 92: ret "\\" end
ret ""
end
func _tok(kind: int, text: str, line: int, col: int): Tok:
ret Tok { kind = kind, text = text, line = line, col = col }
end
func _lex(d &: Doc, text: str): Vector<Tok>:
mut out := Vector {} as Vector<Tok>
n := text.len()
bp := text as u8 *
mut i := 0
mut line := 1
mut ls := 0
until i < n:
c := bp[i] as int
col := i - ls + 1
if c == 10:
line++
i++
ls = i
else c == 32 or c == 9 or c == 13:
i++
else c == 47 and i + 1 < n and bp[i + 1] as int == 47:
until i < n and bp[i] as int != 10:
i++
end
else c == 47 and i + 1 < n and bp[i + 1] as int == 42:
start_line := line
start_col := col
i += 2
mut closed := false
until i < n and not closed:
if bp[i] as int == 42 and i + 1 < n and bp[i + 1] as int == 47:
i += 2
closed = true
else:
if bp[i] as int == 10:
line++
ls = i + 1
end
i++
end
end
if not closed:
_fail(d, start_line, start_col, "unterminated comment")
end
else c == 61:
out.push(_tok(T_EQ, "=", line, col))
i++
else c == 58:
out.push(_tok(T_COLON, ":", line, col))
i++
else c == 96:
start := i + 1
mut j := start
until j < n and bp[j] as int != 96:
if bp[j] as int == 10:
line++
ls = j + 1
end
j++
end
if j >= n:
_fail(d, line, col, "unterminated string")
i = n
else:
out.push(_tok(T_STR, text.substr(start, j - start), line, col))
i = j + 1
end
else c == 34:
mut sb := str.NewBuilder()
mut j := i + 1
mut closed := false
until j < n and not closed:
b := bp[j] as int
if b == 34:
closed = true
j++
else b == 10:
j = n
else b == 92 and j + 1 < n:
e := _unescape_at(bp[j + 1] as int)
if e.len() > 0:
str.BufAppend(sb, e)
else:
str.BufAppend(sb, "\\")
str.BufAppend(sb, text.substr(j + 1, 1))
end
j += 2
else:
str.BufAppend(sb, text.substr(j, 1))
j++
end
end
if not closed:
_fail(d, line, col, "unterminated string")
i = n
else:
out.push(_tok(T_STR, str.BufStr(sb), line, col))
i = j
end
str.BufFree(sb)
else _is_digit(c) or (c == 45 and i + 1 < n and _is_digit(bp[i + 1] as int)):
mut j := i + 1
until j < n and _is_num_char(bp[j] as int):
j++
end
out.push(_tok(T_NUM, text.substr(i, j - i), line, col))
i = j
else _is_word_start(c):
mut j := i + 1
until j < n and _is_word_char(bp[j] as int):
j++
end
out.push(_tok(T_WORD, text.substr(i, j - i), line, col))
i = j
else:
_fail(d, line, col, "unexpected character '" + text.substr(i, 1) + "'")
i = n
end
end
out.push(_tok(T_EOF, "", line, i - ls + 1))
ret out
end
func _add_child(d &: Doc, parent: int, idx: int):
mut p := d.nodes.get(parent)
p.children.push(idx)
d.nodes.set(parent, p)
end
func _is_end(t: Tok): bool:
if t.kind != T_WORD: ret false end
ret str.Equals(t.text, "end") or str.Equals(t.text, "پایان")
end
func _starts_item(toks: Vector<Tok>, at: int): bool:
t := toks.get(at)
if t.kind != T_WORD or _is_end(t): ret false end
mut j := at
until toks.get(j).kind == T_WORD and not _is_end(toks.get(j)) and toks.get(j).line == t.line:
j++
end
until toks.get(j).kind == T_STR and toks.get(j).line == t.line:
j++
end
nk := toks.get(j).kind
ret nk == T_EQ or nk == T_COLON
end
func _parse_items(d &: Doc, toks: Vector<Tok>, pos &: int, parent: int):
until d.ok:
t := toks.get(pos)
if t.kind == T_EOF:
if parent != 0:
_fail(d, t.line, t.col, "missing 'end' for the block opened on line " + str.FromInt(d.nodes.get(parent).line as i64))
end
ret
end
if _is_end(t):
if parent == 0:
_fail(d, t.line, t.col, "'end' without a matching block")
else:
pos++
end
ret
end
if t.kind != T_WORD:
_fail(d, t.line, t.col, "expected a setting or block name, found '" + t.text + "'")
ret
end
mut node := Node { line = t.line, col = t.col }
mut j := pos
until toks.get(j).kind == T_WORD and not _is_end(toks.get(j)) and toks.get(j).line == t.line:
node.words.push(toks.get(j).text)
j++
end
mut k := j
until toks.get(k).kind == T_STR and toks.get(k).line == t.line:
node.labels.push(toks.get(k).text)
k++
end
next := toks.get(k)
if next.kind == T_EQ and node.labels.len() == 0:
pos = k + 1
eq_line := next.line
until d.ok:
v := toks.get(pos)
if v.line != eq_line or v.kind == T_EOF or _is_end(v):
break
end
if v.kind == T_WORD and _starts_item(toks, pos):
break
end
if v.kind == T_STR:
node.values.push(Value { kind = VAL_STR, text = v.text, line = v.line, col = v.col })
else v.kind == T_NUM:
node.values.push(Value { kind = VAL_NUM, text = v.text, line = v.line, col = v.col })
else v.kind == T_WORD:
node.values.push(Value { kind = VAL_WORD, text = v.text, line = v.line, col = v.col })
else:
_fail(d, v.line, v.col, "unexpected '" + v.text + "' in a value")
end
pos++
end
if node.values.len() == 0:
_fail(d, next.line, next.col, "expected a value after '='")
end
d.nodes.push(node)
_add_child(d, parent, d.nodes.len() - 1)
else next.kind == T_COLON:
node.block = true
pos = k + 1
d.nodes.push(node)
idx := d.nodes.len() - 1
_add_child(d, parent, idx)
_parse_items(d, toks, pos, idx)
else:
_fail(d, next.line, next.col, "expected '=' or ':' after '" + t.text + "'")
end
end
end
@en "Parse"
@fa "تجزیه"
pub func Parse(text: str): Doc:
mut d := Doc {}
d.nodes.push(Node { block = true })
toks := _lex(d, text)
defer toks.free()
if not d.ok: ret d end
mut pos := 0
_parse_items(d, toks, pos, 0)
ret d
end
@en "Free"
@fa "آزاد سازی"
pub func Free(d &: Doc):
repeat d.nodes.len() in i:
n := d.nodes.ref(i)
n.words.free()
n.labels.free()
n.values.free()
n.children.free()
end
d.nodes.free()
end
@en "ErrorText"
@fa "متن خطا"
pub func ErrorText(d: Doc, file: str): str:
if d.ok: ret "" end
ret file + ":" + str.FromInt(d.line as i64) + ":" + str.FromInt(d.col as i64) + ": " + d.error
end
@en "Name"
@fa "نام"
pub func Name(d: Doc, node: int): str:
ret str.Join(d.nodes.get(node).words, " ")
end
@en "Root"
@fa "گره ریشه"
pub func Root(): int:
ret 0
end
@en "Count"
@fa "شمار فرزندان"
pub func Count(d: Doc, node: int): int:
ret d.nodes.get(node).children.len()
end
@en "ChildAt"
@fa "فرزند شماره"
pub func ChildAt(d: Doc, node: int, i: int): int:
ret d.nodes.get(node).children.get(i)
end
@en "Find"
@fa "یافتن فرزند"
pub func Find(d: Doc, node: int, name: str): int:
ch := d.nodes.get(node).children
repeat ch.len() in i:
c := ch.get(i)
if str.Equals(Name(d, c), name): ret c end
end
ret -1
end
@en "ValueText"
@fa "متن مقدار گره"
pub func ValueText(d: Doc, node: int, i: int): str:
ret d.nodes.get(node).values.get(i).text
end
package httpd
import str
import conv
import os
import regex
import net.httpd.conf
const LOC_PREFIX := 0
const LOC_EXACT := 1
const LOC_NOREGEX := 2
const LOC_REGEX := 3
const LOC_REGEX_I := 4
struct Listen:
pub host: str = "0.0.0.0"
pub port: int = 80
pub site: int = 0
end
struct HeaderRule:
pub site: int = 0
pub loc: int = -1
pub name: str = ""
pub value: str = ""
end
struct ErrorPage:
pub site: int = 0
pub loc: int = -1
pub code: int = 0
pub path: str = ""
end
struct Rule:
pub root: str = ""
pub alias: str = ""
pub index: str = ""
pub ret_code: int = 0
pub ret_body: str = ""
pub redirect: str = ""
pub redirect_code: int = 0
pub cache: i64 = -1
pub fastcgi: str = ""
pub fastcgi_index: str = ""
pub fastcgi_timeout: int = 0
end
struct FcgiParam:
pub site: int = 0
pub loc: int = -1
pub name: str = ""
pub value: str = ""
end
struct Location:
pub site: int = 0
pub kind: int = 0
pub pattern: str = ""
pub rule: Rule = Rule {}
end
struct Site:
pub names: str = ""
pub is_default: bool = false
pub loc_first: int = 0
pub loc_count: int = 0
pub line: int = 0
pub col: int = 0
pub rule: Rule = Rule {}
end
struct Config:
pub access_log: str = ""
pub listens: Vector<Listen> = Vector {}
pub sites: Vector<Site> = Vector {}
pub locations: Vector<Location> = Vector {}
pub headers: Vector<HeaderRule> = Vector {}
pub pages: Vector<ErrorPage> = Vector {}
pub fcgi: Vector<FcgiParam> = Vector {}
pub problems: Vector<str> = Vector {}
end
func _problem(c &: Config, file: str, line: int, col: int, msg: str):
c.problems.push(file + ":" + str.FromInt(line as i64) + ":" + str.FromInt(col as i64) + ": " + msg)
end
func _min3(a: int, b: int, c: int): int:
mut m := a
if b < m: m = b end
if c < m: m = c end
ret m
end
func _distance(a: str, b: str): int:
na := a.len()
nb := b.len()
ap := a as u8 *
bp := b as u8 *
mut prev := Vector {} as Vector<int>
mut cur := Vector {} as Vector<int>
defer prev.free()
defer cur.free()
repeat nb + 1 in j:
prev.push(j)
cur.push(0)
end
repeat na in i:
cur.set(0, i + 1)
repeat nb in j:
cost := ap[i] == bp[j] ? 0 : 1
cur.set(j + 1, _min3(prev.get(j + 1) + 1, cur.get(j) + 1, prev.get(j) + cost))
end
repeat nb + 1 in j:
prev.set(j, cur.get(j))
end
end
ret prev.get(nb)
end
func _suggest(name: str, allowed: str): str:
names := str.Split(allowed, "|")
defer names.free()
mut best := ""
mut best_d := 1000
repeat names.len() in i:
n := names.get(i)
dist := _distance(name, n)
if dist < best_d:
best_d = dist
best = n
end
end
limit := name.len() / 3 + 1
if best_d <= limit and best_d < best.len():
ret " (did you mean '" + best + "'?)"
end
ret ""
end
func _in_list(name: str, allowed: str): bool:
names := str.Split(allowed, "|")
defer names.free()
repeat names.len() in i:
if str.Equals(names.get(i), name): ret true end
end
ret false
end
func _parse_uint(s: str): i64:
n := s.len()
if n == 0 or n > 15: ret -1 end
bp := s as u8 *
repeat n in i:
ch := bp[i] as int
if ch < 48 or ch > 57: ret -1 end
end
ret conv.ParseIntOr(s, 0 - 1)
end
func _parse_addr(text: str, host &: str, port &: int): bool:
t := str.Trim(text)
if t.len() == 0: ret false end
colon := t.indexOf(":")
mut h := "127.0.0.1"
mut ps := t
if colon >= 0:
if colon > 0: h = t.substr(0, colon) end
ps = t.substr(colon + 1, t.len() - colon - 1)
end
p := _parse_uint(ps)
if p < 1 or p > 65535: ret false end
host = h
port = p as int
ret true
end
func _joined(d: conf.Doc, node: int): str:
n := d.nodes.get(node)
mut parts := Vector {} as Vector<str>
defer parts.free()
repeat n.values.len() in i:
parts.push(n.values.get(i).text)
end
ret str.Join(parts, " ")
end
func _is_true(word: str): bool:
ret str.Equals(word, "true") or str.Equals(word, "yes") or str.Equals(word, "on")
end
func _is_false(word: str): bool:
ret str.Equals(word, "false") or str.Equals(word, "no") or str.Equals(word, "off")
end
func _parse_listen(c &: Config, file: str, d: conf.Doc, node: int, site: int):
n := d.nodes.get(node)
mut l := Listen { site = site }
mut have_port := false
repeat n.values.len() in i:
v := n.values.get(i)
if v.kind == conf.VAL_NUM:
p := _parse_uint(v.text)
if p < 1 or p > 65535:
_problem(c, file, v.line, v.col, "port must be a number from 1 to 65535")
else:
l.port = p as int
have_port = true
end
else v.kind == conf.VAL_STR:
colon := v.text.indexOf(":")
if colon < 0:
l.host = v.text
else:
if colon > 0: l.host = v.text.substr(0, colon) end
p := _parse_uint(v.text.substr(colon + 1, v.text.len() - colon - 1))
if p < 1 or p > 65535:
_problem(c, file, v.line, v.col, "port must be a number from 1 to 65535")
else:
l.port = p as int
have_port = true
end
end
else str.Equals(v.text, "tls"):
_problem(c, file, v.line, v.col, "tls is not available yet")
else:
_problem(c, file, v.line, v.col, "unknown listen option '" + v.text + "'")
end
end
if not have_port: l.port = 80 end
c.listens.push(l)
end
func _apply_common(c &: Config, file: str, d: conf.Doc, node: int, name: str, rule &: Rule, site: int, loc: int): bool:
n := d.nodes.get(node)
if str.Equals(name, "root"):
rule.root = _joined(d, node)
else str.Equals(name, "alias"):
rule.alias = _joined(d, node)
else str.Equals(name, "index"):
rule.index = _joined(d, node)
else str.Equals(name, "redirect"):
rule.redirect = _joined(d, node)
else str.Equals(name, "code"):
p := _parse_uint(n.values.get(0).text)
if p < 100 or p > 599:
_problem(c, file, n.line, n.col, "code must be an HTTP status from 100 to 599")
else:
rule.redirect_code = p as int
end
else str.Equals(name, "return"):
v0 := n.values.get(0)
p := v0.kind == conf.VAL_NUM ? _parse_uint(v0.text) : -1
if p < 100 or p > 599:
_problem(c, file, v0.line, v0.col, "return needs an HTTP status from 100 to 599, then an optional text")
else:
rule.ret_code = p as int
if n.values.len() > 1: rule.ret_body = n.values.get(1).text end
end
else str.Equals(name, "cache"):
secs := ParseDuration(_joined(d, node))
if secs < 0:
_problem(c, file, n.line, n.col, "cache must be a duration such as 30s, 10m, 12h, 30d or 1y")
else:
rule.cache = secs
end
else str.Equals(name, "header"):
if n.values.len() != 2 or n.values.get(0).kind != conf.VAL_STR or n.values.get(1).kind != conf.VAL_STR:
_problem(c, file, n.line, n.col, "header needs two strings: the name and the value")
else:
c.headers.push(HeaderRule { site = site, loc = loc, name = n.values.get(0).text, value = n.values.get(1).text })
end
else str.Equals(name, "error page"):
v0 := n.values.get(0)
p := v0.kind == conf.VAL_NUM ? _parse_uint(v0.text) : -1
if p < 400 or p > 599 or n.values.len() != 2:
_problem(c, file, v0.line, v0.col, "error page needs a status from 400 to 599 and a file")
else:
c.pages.push(ErrorPage { site = site, loc = loc, code = p as int, path = n.values.get(1).text })
end
else str.Equals(name, "fastcgi_pass"):
v := _joined(d, node)
if str.StartsWith(v, "unix:"):
_problem(c, file, n.line, n.col, "fastcgi_pass cannot read a unix socket yet; give a TCP address such as 127.0.0.1:9000")
else:
mut fh := ""
mut fp := 0
if not _parse_addr(v, fh, fp):
_problem(c, file, n.line, n.col, "fastcgi_pass needs an address such as 127.0.0.1:9000")
else:
rule.fastcgi = fh + ":" + str.FromInt(fp as i64)
end
end
else str.Equals(name, "fastcgi_index"):
rule.fastcgi_index = _joined(d, node)
else str.Equals(name, "fastcgi_timeout"):
secs := ParseDuration(_joined(d, node))
if secs <= 0:
_problem(c, file, n.line, n.col, "fastcgi_timeout must be a duration such as 30s or 2m")
else:
rule.fastcgi_timeout = (secs * 1000) as int
end
else str.Equals(name, "fastcgi_param"):
if n.values.len() < 2 or n.values.get(0).kind != conf.VAL_STR:
_problem(c, file, n.line, n.col, "fastcgi_param needs a name and a value")
else:
mut value := ""
repeat n.values.len() - 1 in k:
if k > 0: value += " " end
value += n.values.get(k + 1).text
end
c.fcgi.push(FcgiParam { site = site, loc = loc, name = n.values.get(0).text, value = value })
end
else:
ret false
end
ret true
end
func _parse_location(c &: Config, file: str, d: conf.Doc, node: int, site: int):
n := d.nodes.get(node)
if n.labels.len() != 1:
_problem(c, file, n.line, n.col, "location needs one pattern, for example location \"/api/\":")
ret
end
label := n.labels.get(0)
mut loc := Location { site = site }
mut pat := label
if str.StartsWith(label, "= "):
loc.kind = LOC_EXACT
pat = label.substr(2, label.len() - 2)
else str.StartsWith(label, "^~ "):
loc.kind = LOC_NOREGEX
pat = label.substr(3, label.len() - 3)
else str.StartsWith(label, "~* "):
loc.kind = LOC_REGEX_I
pat = label.substr(3, label.len() - 3)
else str.StartsWith(label, "~ "):
loc.kind = LOC_REGEX
pat = label.substr(2, label.len() - 2)
end
pat = str.Trim(pat)
if loc.kind == LOC_REGEX or loc.kind == LOC_REGEX_I:
if not regex.IsValid(pat):
_problem(c, file, n.line, n.col, "'" + pat + "' is not a valid regular expression")
end
else:
if not str.StartsWith(pat, "/"):
_problem(c, file, n.line, n.col, "a location path must start with '/'")
end
end
loc.pattern = pat
idx := c.locations.len()
mut rule := Rule {}
repeat n.children.len() in i:
ch := n.children.get(i)
cn := d.nodes.get(ch)
name := conf.Name(d, ch)
if cn.block:
_problem(c, file, cn.line, cn.col, "'" + name + "' cannot be used inside a location")
else:
if not _apply_common(c, file, d, ch, name, rule, site, idx):
_problem(c, file, cn.line, cn.col, "unknown setting '" + name + "' in a location" + _suggest(name, "root|alias|index|redirect|code|return|cache|header|error page|fastcgi_pass|fastcgi_index|fastcgi_param|fastcgi_timeout"))
end
end
end
if rule.alias.len() > 0:
if loc.kind != LOC_PREFIX and loc.kind != LOC_NOREGEX:
_problem(c, file, n.line, n.col, "alias works only with a prefix location, use root for the others")
else not os.IsDir(rule.alias):
_problem(c, file, n.line, n.col, "alias '" + rule.alias + "' is not a directory")
end
end
loc.rule = rule
c.locations.push(loc)
end
func _parse_site(c &: Config, file: str, d: conf.Doc, node: int):
n := d.nodes.get(node)
site := c.sites.len()
mut s := Site { loc_first = c.locations.len(), line = n.line, col = n.col }
mut rule := Rule {}
mut listen_count := 0
repeat n.children.len() in i:
ch := n.children.get(i)
cn := d.nodes.get(ch)
name := conf.Name(d, ch)
if cn.block:
if str.Equals(name, "location"):
_parse_location(c, file, d, ch, site)
else:
_problem(c, file, cn.line, cn.col, "unknown block '" + name + "' in a site" + _suggest(name, "location"))
end
else str.Equals(name, "listen"):
_parse_listen(c, file, d, ch, site)
listen_count++
else str.Equals(name, "names"):
s.names = str.Lower(_joined(d, ch))
else str.Equals(name, "default"):
w := cn.values.get(0).text
if _is_true(w):
s.is_default = true
else not _is_false(w):
_problem(c, file, cn.line, cn.col, "default must be true or false")
end
else:
if not _apply_common(c, file, d, ch, name, rule, site, -1):
_problem(c, file, cn.line, cn.col, "unknown setting '" + name + "' in a site" + _suggest(name, "listen|names|default|root|index|redirect|code|return|cache|header|error page|fastcgi_pass|fastcgi_index|fastcgi_param|fastcgi_timeout|location"))
end
end
end
if listen_count == 0:
c.listens.push(Listen { site = site })
end
if rule.index.len() == 0: rule.index = "index.html" end
if rule.root.len() > 0 and not os.IsDir(rule.root):
_problem(c, file, n.line, n.col, "root '" + rule.root + "' is not a directory")
end
if rule.fastcgi.len() > 0 and rule.root.len() == 0:
_problem(c, file, n.line, n.col, "fastcgi_pass needs a root: the folder that holds the scripts")
end
s.loc_count = c.locations.len() - s.loc_first
s.rule = rule
c.sites.push(s)
end
func _parse_log(c &: Config, file: str, d: conf.Doc, node: int):
n := d.nodes.get(node)
repeat n.children.len() in i:
ch := n.children.get(i)
cn := d.nodes.get(ch)
name := conf.Name(d, ch)
if not cn.block and str.Equals(name, "access"):
c.access_log = _joined(d, ch)
else:
_problem(c, file, cn.line, cn.col, "unknown setting '" + name + "' in log" + _suggest(name, "access"))
end
end
end
func _parse_server(c &: Config, file: str, d: conf.Doc, node: int):
n := d.nodes.get(node)
repeat n.children.len() in i:
ch := n.children.get(i)
cn := d.nodes.get(ch)
name := conf.Name(d, ch)
if cn.block:
if str.Equals(name, "site"):
_parse_site(c, file, d, ch)
else str.Equals(name, "log"):
_parse_log(c, file, d, ch)
else str.Equals(name, "server"):
_parse_server(c, file, d, ch)
else:
_problem(c, file, cn.line, cn.col, "unknown block '" + name + "'" + _suggest(name, "site|log|server"))
end
else:
_problem(c, file, cn.line, cn.col, "unknown setting '" + name + "'" + _suggest(name, "site|log"))
end
end
end
func _check_names(c &: Config, file: str):
mut seen := HashMap {} as HashMap<str, int>
defer seen.free()
repeat c.sites.len() in si:
s := c.sites.get(si)
names := str.Fields(s.names)
if names.len() == 0 and not s.is_default:
_problem(c, file, s.line, s.col, "site number " + str.FromInt((si + 1) as i64) + " has no names and is not the default site")
end
repeat names.len() in ni:
nm := names.get(ni)
if str.StartsWith(nm, "*") and not str.StartsWith(nm, "*."):
_problem(c, file, s.line, s.col, "wildcard name '" + nm + "' must look like *.example.com")
end
repeat c.listens.len() in li:
l := c.listens.get(li)
if l.site == si:
key := str.FromInt(l.port as i64) + "|" + nm
if seen.has(key):
_problem(c, file, s.line, s.col, "name '" + nm + "' is used by two sites on port " + str.FromInt(l.port as i64))
else:
seen.put(key, si)
end
end
end
end
names.free()
end
end
@en "ParseDuration"
@fa "تجزیه مدت"
pub func ParseDuration(text: str): i64:
n := text.len()
if n == 0: ret -1 end
bp := text as u8 *
mut i := 0
until i < n and bp[i] as int >= 48 and bp[i] as int <= 57:
i++
end
if i == 0: ret -1 end
num := _parse_uint(text.substr(0, i))
if num < 0: ret -1 end
unit := text.substr(i, n - i)
if unit.len() == 0 or str.Equals(unit, "s"): ret num end
if str.Equals(unit, "m"): ret num * 60 end
if str.Equals(unit, "h"): ret num * 3600 end
if str.Equals(unit, "d"): ret num * 86400 end
if str.Equals(unit, "w"): ret num * 604800 end
if str.Equals(unit, "y"): ret num * 31536000 end
ret -1
end
@en "LoadText"
@fa "بارگذاری متن پیکربندی"
pub func LoadText(text: str, file: str): bool:
mut cfg := Config {}
mut d := conf.Parse(text)
defer conf.Free(d)
if not d.ok:
cfg.problems.push(conf.ErrorText(d, file))
_publish(cfg)
ret false
end
_parse_server(cfg, file, d, conf.Root())
if cfg.sites.len() == 0 and cfg.problems.len() == 0:
_problem(cfg, file, 1, 1, "the config has no sites")
end
if cfg.problems.len() == 0:
_check_names(cfg, file)
end
ok := cfg.problems.len() == 0
_publish(cfg)
ret ok
end
@en "httpd"
@fa "سرور وب"
package httpd
import str
import os
import io
import time
import net.http
import net.router
@en "LoadFile"
@fa "بارگذاری پرونده"
pub func LoadFile(path: str): bool:
if not os.Exists(path) or os.IsDir(path):
mut cfg := Config {}
cfg.problems.push(path + ": cannot read the config file")
_publish(cfg)
ret false
end
ret LoadText(io.ReadFile(path), path)
end
@en "Check"
@fa "بررسی"
pub func Check(path: str): int:
if not LoadFile(path):
repeat ProblemCount() in i:
printerrln ProblemAt(i)
end
printerrln "configuration is not valid"
ret 1
end
mut seen := HashMap {} as HashMap<str, int>
repeat _cfg.listens.len() in i:
l := _cfg.listens.get(i)
seen.put(l.host + ":" + str.FromInt(l.port as i64), 1)
end
println "configuration is ok:", SiteCount(), "site(s),", seen.size(), "listener(s)"
seen.free()
ret 0
end
@en "Run"
@fa "اجرا"
pub func Run(): int:
if _cfg.sites.len() == 0 or _cfg.problems.len() > 0:
printerrln "salam serve: load a valid configuration before running"
ret 2
end
if not _open_log(_cfg.access_log):
printerrln "salam serve: cannot open the access log " + _cfg.access_log
ret 2
end
mut r := router.NewRouter()
router.SetFallback(r, _handle)
mut started := HashMap {} as HashMap<str, int>
defer started.free()
repeat _cfg.listens.len() in i:
l := _cfg.listens.get(i)
key := l.host + ":" + str.FromInt(l.port as i64)
if not started.has(key):
started.put(key, 1)
mut s := http.NewServer(l.port)
http.SetHost(s, l.host)
http.Use(s, r)
if not http.RunBackground(s):
printerrln "salam serve: cannot listen on " + key
ret 2
end
end
end
_serving = true
until _serving:
time.Sleep(200)
end
ret 0
end
@en "Stop"
@fa "توقف"
pub func Stop():
_serving = false
end
package httpd
import str
import mem
import regex
mut _cfg := Config {}
mut _exact := HashMap {} as HashMap<str, int>
mut _wild_port := Vector {} as Vector<int>
mut _wild_suffix := Vector {} as Vector<str>
mut _wild_site := Vector {} as Vector<int>
mut _default_by_port := HashMap {} as HashMap<str, int>
mut _multi_port := false
mut _only_port := 80
mut _serving := false
func _port_key(port: int): str:
ret str.FromInt(port as i64)
end
func _index_sites(cfg: Config):
_exact = HashMap {} as HashMap<str, int>
_default_by_port = HashMap {} as HashMap<str, int>
_wild_port = Vector {} as Vector<int>
_wild_suffix = Vector {} as Vector<str>
_wild_site = Vector {} as Vector<int>
_multi_port = false
if cfg.listens.len() > 0:
_only_port = cfg.listens.get(0).port
end
repeat cfg.listens.len() in li:
l := cfg.listens.get(li)
if l.port != _only_port: _multi_port = true end
s := cfg.sites.get(l.site)
names := str.Fields(s.names)
repeat names.len() in ni:
nm := names.get(ni)
if str.StartsWith(nm, "*."):
_wild_port.push(l.port)
_wild_suffix.push(nm.substr(1, nm.len() - 1))
_wild_site.push(l.site)
else:
_exact.put(_port_key(l.port) + "|" + nm, l.site)
end
end
names.free()
pk := _port_key(l.port)
if s.is_default or not _default_by_port.has(pk):
_default_by_port.put(pk, l.site)
end
end
end
func _publish(cfg: Config):
_cfg = cfg
if cfg.problems.len() == 0:
_index_sites(cfg)
end
end
func _normalize_host(raw: str): str:
t := str.Trim(raw)
h := str.Lower(t)
mem.Free(t as void *)
if str.StartsWith(h, "["):
close := h.indexOf("]")
if close > 0:
r := h.substr(0, close + 1)
mem.Free(h as void *)
ret r
end
ret h
end
mut end_at := h.len()
colon := h.indexOf(":")
if colon >= 0: end_at = colon end
if end_at > 0 and (h as u8 *)[end_at - 1] as int == 46: end_at-- end
r := h.substr(0, end_at)
mem.Free(h as void *)
ret r
end
func _lower_pattern(p: str): str:
n := p.len()
bp := p as u8 *
mut sb := str.NewBuilder()
mut i := 0
until i < n:
mut ch := bp[i] as int
if ch == 92 and i + 1 < n:
piece := p.substr(i, 2)
str.BufAppend(sb, piece)
mem.Free(piece as void *)
i += 2
else:
if ch >= 65 and ch <= 90: ch += 32 end
str.BufAppendChar(sb, ch)
i++
end
end
out := str.BufStr(sb)
str.BufFree(sb)
ret out
end
func _regex_match(pattern: str, path: str): bool:
try:
ret regex.MatchStr(pattern, path)
catch:
ret false
end
end
func _regex_hit(l: Location, path: str): bool:
if l.kind == LOC_REGEX:
ret _regex_match(l.pattern, path)
end
pat := _lower_pattern(l.pattern)
low := str.Lower(path)
hit := _regex_match(pat, low)
mem.Free(pat as void *)
mem.Free(low as void *)
ret hit
end
@en "SiteFor"
@fa "سایت برای"
pub func SiteFor(host: str, port: int): int:
h := _normalize_host(host)
pk := _port_key(port)
key := pk + "|" + h
mut found := -1
if _exact.has(key):
found = _exact.get(key)
else:
mut best_len := 0
repeat _wild_suffix.len() in i:
suf := _wild_suffix.get(i)
if _wild_port.get(i) == port and h.len() > suf.len() and str.EndsWith(h, suf) and suf.len() > best_len:
found = _wild_site.get(i)
best_len = suf.len()
end
end
if found < 0 and _default_by_port.has(pk):
found = _default_by_port.get(pk)
end
end
mem.Free(key as void *)
mem.Free(pk as void *)
mem.Free(h as void *)
ret found
end
@en "LocationFor"
@fa "مسیر برای"
pub func LocationFor(site: int, path: str): int:
s := _cfg.sites.get(site)
mut best := -1
mut best_len := -1
mut best_blocks_regex := false
repeat s.loc_count in k:
i := s.loc_first + k
l := _cfg.locations.get(i)
if l.kind == LOC_EXACT:
if str.Equals(path, l.pattern): ret i end
else l.kind == LOC_PREFIX or l.kind == LOC_NOREGEX:
if str.StartsWith(path, l.pattern) and l.pattern.len() > best_len:
best = i
best_len = l.pattern.len()
best_blocks_regex = l.kind == LOC_NOREGEX
end
end
end
if best_blocks_regex: ret best end
repeat s.loc_count in k:
i := s.loc_first + k
l := _cfg.locations.get(i)
if (l.kind == LOC_REGEX or l.kind == LOC_REGEX_I) and _regex_hit(l, path):
ret i
end
end
ret best
end
@en "SiteCount"
@fa "شمار سایت ها"
pub func SiteCount(): int:
ret _cfg.sites.len()
end
@en "SiteNames"
@fa "نام های سایت"
pub func SiteNames(site: int): str:
ret _cfg.sites.get(site).names
end
@en "LocationPattern"
@fa "الگوی مسیر"
pub func LocationPattern(loc: int): str:
ret _cfg.locations.get(loc).pattern
end
@en "ProblemCount"
@fa "شمار مشکل ها"
pub func ProblemCount(): int:
ret _cfg.problems.len()
end
@en "ProblemAt"
@fa "مشکل شماره"
pub func ProblemAt(i: int): str:
ret _cfg.problems.get(i)
end
package httpd
import str
import os
import io
import time
import mem
import conv
import sync
import filepath
import net.http
import net.router
import net.mime
import net.tcp
import net.fastcgi
extern:
func fopen(path: str, mode: str): void *
func fclose(stream: void *): int
func fputs(s: str, stream: void *): int
func fflush(stream: void *): int
func fdopen(fd: int, mode: str): void *
end
mut _log_fp := null as void *
mut _log_mu := sync.NewMutex()
func _open_log(path: str): bool:
if path.len() == 0:
_log_fp = null
ret true
end
if str.Equals(path, "stdout"):
_log_fp = fdopen(1, "w")
else str.Equals(path, "stderr"):
_log_fp = fdopen(2, "w")
else:
_log_fp = fopen(path, "ab")
end
ret _log_fp != null
end
func _log_line(host: str, method: str, path: str, status: int):
if _log_fp == null: ret end
mut sb := str.NewBuilder()
stamp := time.FormatISOUTC(time.Now())
code := str.FromInt(status as i64)
str.BufAppend(sb, stamp)
str.BufAppend(sb, " ")
str.BufAppend(sb, host)
str.BufAppend(sb, " ")
str.BufAppend(sb, method)
str.BufAppend(sb, " ")
str.BufAppend(sb, path)
str.BufAppend(sb, " ")
str.BufAppend(sb, code)
str.BufAppend(sb, "\n")
line := str.BufStr(sb)
sync.Lock(_log_mu)
fputs(line, _log_fp)
fflush(_log_fp)
sync.Unlock(_log_mu)
mem.Free(line as void *)
mem.Free(stamp as void *)
mem.Free(code as void *)
str.BufFree(sb)
end
func _swap(cur: str, find: str, repl: str): str:
next := str.Replace(cur, find, repl)
mem.Free(cur as void *)
ret next
end
func _expand(tmpl: str, host: str, path: str, query: str): str:
mut out := str.Replace(tmpl, "$host", host)
out = _swap(out, "$scheme", "http")
if query.len() > 0:
ru := _cat3(path, "?", query)
out = _swap(out, "$request_uri", ru)
mem.Free(ru as void *)
else:
out = _swap(out, "$request_uri", path)
end
out = _swap(out, "$uri", path)
out = _swap(out, "$args", query)
ret out
end
func _reply(ctx: i64, code: int, body: str):
http.SetStatus(ctx, code)
http.Text(ctx, body)
end
func _apply_headers(ctx: i64, site: int, loc: int):
repeat _cfg.headers.len() in i:
h := _cfg.headers.get(i)
if h.site == site and (h.loc == -1 or h.loc == loc):
http.SetHeader(ctx, h.name, h.value)
end
end
end
func _norm_path(path: str): str:
n := path.len()
bp := path as u8 *
out := mem.Allocate((n + 2) as u64)
ob := out as u8 *
mut marks := Vector {} as Vector<int>
defer marks.free()
mut len := 0
mut i := 0
mut bad := false
until i < n and not bad:
until i < n and bp[i] as int == 47:
i++
end
start := i
until i < n and bp[i] as int != 47:
i++
end
seg := i - start
if seg == 0 or (seg == 1 and bp[start] as int == 46):
continue
end
if seg == 2 and bp[start] as int == 46 and bp[start + 1] as int == 46:
if marks.len() == 0:
bad = true
else:
len = marks.pop()
end
else:
marks.push(len)
ob[len] = 47 as u8
len++
repeat seg in k:
ob[len] = bp[start + k]
len++
end
end
end
if bad:
mem.Free(out)
ret str.Clone("")
end
if len == 0:
ob[0] = 47 as u8
len = 1
else n > 0 and bp[n - 1] as int == 47:
ob[len] = 47 as u8
len++
end
ob[len] = 0 as u8
ret out as str
end
func _starts_at(s: str, at: int, lit: str): bool:
ln := lit.len()
if at + ln > s.len(): ret false end
sp := s as u8 *
lp := lit as u8 *
repeat ln in k:
if sp[at + k] != lp[k]: ret false end
end
ret true
end
func _blocked_segment(path: str): bool:
n := path.len()
bp := path as u8 *
mut i := 0
until i < n:
ch := bp[i] as int
if ch == 92: ret true end
if ch == 46 and (i == 0 or bp[i - 1] as int == 47):
ok := _starts_at(path, i, ".well-known") and (i + 11 == n or bp[i + 11] as int == 47)
if not ok: ret true end
end
i++
end
ret false
end
func _cat3(a: str, b: str, c: str): str:
mut sb := str.NewBuilder()
str.BufAppend(sb, a)
str.BufAppend(sb, b)
str.BufAppend(sb, c)
out := str.BufStr(sb)
str.BufFree(sb)
ret out
end
func _page_for(site: int, loc: int, code: int): str:
mut found := ""
repeat _cfg.pages.len() in i:
p := _cfg.pages.get(i)
if p.site == site and p.code == code:
if p.loc == loc: ret p.path end
if p.loc == -1: found = p.path end
end
end
ret found
end
func _fail(ctx: i64, site: int, loc: int, root: str, code: int, text: str):
page := _page_for(site, loc, code)
if page.len() > 0 and root.len() > 0:
rel := "/" + page
clean := _norm_path(rel)
mem.Free(rel as void *)
target := root + clean
mem.Free(clean as void *)
if os.Exists(target) and not os.IsDir(target):
if http.File(ctx, target, mime.MimeType(target)):
http.SetStatus(ctx, code)
mem.Free(target as void *)
ret
end
end
mem.Free(target as void *)
end
_reply(ctx, code, text)
end
func _effective_root(site: int, loc: int): str:
if loc >= 0 and _cfg.locations.get(loc).rule.root.len() > 0:
ret _cfg.locations.get(loc).rule.root
end
ret _cfg.sites.get(site).rule.root
end
func _effective_alias(loc: int): str:
if loc < 0: ret "" end
ret _cfg.locations.get(loc).rule.alias
end
func _effective_index(site: int, loc: int): str:
if loc >= 0 and _cfg.locations.get(loc).rule.index.len() > 0:
ret _cfg.locations.get(loc).rule.index
end
ret _cfg.sites.get(site).rule.index
end
func _effective_cache(site: int, loc: int): i64:
if loc >= 0 and _cfg.locations.get(loc).rule.cache >= 0:
ret _cfg.locations.get(loc).rule.cache
end
ret _cfg.sites.get(site).rule.cache
end
func _send_rule(ctx: i64, rule: Rule, host: str, path: str, query: str): bool:
if rule.redirect.len() > 0:
mut code := rule.redirect_code
if code == 0: code = 301 end
http.SetStatus(ctx, code)
http.SetHeader(ctx, "Location", http.Own(ctx, _expand(rule.redirect, host, path, query)))
http.Text(ctx, "")
ret true
end
if rule.ret_code > 0:
_reply(ctx, rule.ret_code, rule.ret_body)
ret true
end
ret false
end
func _free_strs(v: Vector<str>):
repeat v.len() in i:
mem.Free(v.get(i) as void *)
end
v.free()
end
func _serve_file(ctx: i64, site: int, loc: int, root: str, rel: str, path: str, query: str): int:
mut target := http.Own(ctx, root + rel)
if os.IsDir(target):
if not str.EndsWith(path, "/"):
http.SetStatus(ctx, 301)
base := _cat3(path, "/", "")
mut dest := base
if query.len() > 0:
dest = _cat3(base, "?", query)
mem.Free(base as void *)
end
http.SetHeader(ctx, "Location", http.Own(ctx, dest))
http.Text(ctx, "")
ret 301
end
names := str.Fields(_effective_index(site, loc))
mut found := ""
repeat names.len() in i:
cand := filepath.Join(target, names.get(i))
if found.len() == 0 and os.Exists(cand) and not os.IsDir(cand):
found = http.Own(ctx, cand)
else:
mem.Free(cand as void *)
end
end
_free_strs(names)
if found.len() == 0: ret 404 end
target = found
else not os.Exists(target):
ret 404
end
ret _send_target(ctx, site, loc, target)
end
func _etag_of(mt: i64, size: i64): str:
a := conv.FormatHex(mt as u64)
b := conv.FormatHex(size as u64)
mut sb := str.NewBuilder()
str.BufAppend(sb, "\"")
str.BufAppend(sb, a)
str.BufAppend(sb, "-")
str.BufAppend(sb, b)
str.BufAppend(sb, "\"")
out := str.BufStr(sb)
str.BufFree(sb)
mem.Free(a as void *)
mem.Free(b as void *)
ret out
end
func _etag_listed(header: str, etag: str): bool:
if str.Equals(str.Trim(header), "*"): ret true end
parts := str.Split(header, ",")
mut hit := false
repeat parts.len() in i:
mut p := str.Trim(parts.get(i))
if str.StartsWith(p, "W/"): p = p.substr(2, p.len() - 2) end
if str.Equals(p, etag): hit = true end
end
_free_strs(parts)
ret hit
end
func _not_modified(ctx: i64, etag: str, mt: i64): bool:
inm := http.Header(ctx, "If-None-Match")
if inm.len() > 0:
ret _etag_listed(inm, etag)
end
ims := http.Header(ctx, "If-Modified-Since")
if ims.len() > 0 and mt > 0:
try:
ret mt <= time.ParseHTTPDate(ims)
catch:
ret false
end
end
ret false
end
func _range_bounds(spec: str, size: i64, start &: i64, last &: i64): int:
dash := spec.indexOf("-")
if dash < 0 or spec.indexOf(",") >= 0: ret 0 end
a := str.Trim(spec.substr(0, dash))
b := str.Trim(spec.substr(dash + 1, spec.len() - dash - 1))
mut result := 1
if a.len() == 0:
n := _parse_uint(b)
if n < 1:
result = 2
else:
start = n < size ? size - n : 0
last = size - 1
end
else:
s0 := _parse_uint(a)
if s0 < 0:
result = 0
else:
start = s0
last = size - 1
if b.len() > 0:
e0 := _parse_uint(b)
if e0 < 0:
result = 0
else:
if e0 < last: last = e0 end
end
end
if result == 1 and (start >= size or last < start): result = 2 end
end
end
mem.Free(a as void *)
mem.Free(b as void *)
ret result
end
func _content_range(start: i64, last: i64, size: i64): str:
mut sb := str.NewBuilder()
str.BufAppend(sb, "bytes ")
if start < 0:
str.BufAppend(sb, "*")
else:
str.BufAppendInt(sb, start)
str.BufAppend(sb, "-")
str.BufAppendInt(sb, last)
end
str.BufAppend(sb, "/")
str.BufAppendInt(sb, size)
out := str.BufStr(sb)
str.BufFree(sb)
ret out
end
func _send_target(ctx: i64, site: int, loc: int, target: str): int:
ct := mime.MimeType(target)
mut size := 0 as i64
mut mt := 0 as i64
if not http.FileStat(target, size, mt): ret 404 end
etag := http.Own(ctx, _etag_of(mt, size))
http.SetHeader(ctx, "ETag", etag)
if mt > 0:
http.SetHeader(ctx, "Last-Modified", http.Own(ctx, time.FormatHTTPDate(mt)))
end
http.SetHeader(ctx, "Accept-Ranges", "bytes")
cache := _effective_cache(site, loc)
if cache >= 0:
secs := str.FromInt(cache)
http.SetHeader(ctx, "Cache-Control", http.Own(ctx, _cat3("public, max-age=", secs, "")))
mem.Free(secs as void *)
end
if _not_modified(ctx, etag, mt):
http.SetStatus(ctx, 304)
http.Text(ctx, "")
ret 304
end
rh := http.Header(ctx, "Range")
ir := http.Header(ctx, "If-Range")
if rh.len() > 6 and str.StartsWith(rh, "bytes=") and (ir.len() == 0 or str.Equals(ir, etag)):
spec := rh.substr(6, rh.len() - 6)
mut start := 0 as i64
mut last := 0 as i64
kind := _range_bounds(spec, size, start, last)
mem.Free(spec as void *)
if kind == 2:
http.SetStatus(ctx, 416)
http.SetHeader(ctx, "Content-Range", http.Own(ctx, _content_range(-1, -1, size)))
http.Text(ctx, "")
ret 416
end
if kind == 1:
if not http.FileRange(ctx, target, ct, start as int, (last - start + 1) as int): ret 404 end
http.SetStatus(ctx, 206)
http.SetHeader(ctx, "Content-Range", http.Own(ctx, _content_range(start, last, size)))
ret 206
end
end
if not http.File(ctx, target, ct): ret 404 end
ret 200
end
func _effective_fastcgi(site: int, loc: int): str:
if loc >= 0 and _cfg.locations.get(loc).rule.fastcgi.len() > 0:
ret _cfg.locations.get(loc).rule.fastcgi
end
ret _cfg.sites.get(site).rule.fastcgi
end
func _effective_fcgi_index(site: int, loc: int): str:
if loc >= 0 and _cfg.locations.get(loc).rule.fastcgi_index.len() > 0:
ret _cfg.locations.get(loc).rule.fastcgi_index
end
if _cfg.sites.get(site).rule.fastcgi_index.len() > 0:
ret _cfg.sites.get(site).rule.fastcgi_index
end
ret "index.php"
end
func _effective_fcgi_timeout(site: int, loc: int): int:
if loc >= 0 and _cfg.locations.get(loc).rule.fastcgi_timeout > 0:
ret _cfg.locations.get(loc).rule.fastcgi_timeout
end
if _cfg.sites.get(site).rule.fastcgi_timeout > 0:
ret _cfg.sites.get(site).rule.fastcgi_timeout
end
ret 30000
end
func _host_only(host: str): str:
c := host.indexOf(":")
if c > 0: ret host.substr(0, c) end
ret str.Clone(host)
end
func _is_slash(s: str, i: int): bool:
bp := s as u8 *
ret bp[i] as int == 47
end
func _http_param(name: str): str:
mut sb := str.NewBuilder()
str.BufAppend(sb, "HTTP_")
bp := name as u8 *
repeat name.len() in i:
mut ch := bp[i] as int
if ch == 45:
str.BufAppend(sb, "_")
else:
if ch >= 97 and ch <= 122:
ch -= 32
end
str.BufAppendChar(sb, ch)
end
end
out := str.BufStr(sb)
str.BufFree(sb)
ret out
end
func _expand_param(ctx: i64, tmpl: str, host: str, path: str, query: str, root: str, script: str, port: int, remote: str): str:
if str.StartsWith(tmpl, "$header:"):
ret str.Clone(http.Header(ctx, tmpl.substr(8, tmpl.len() - 8)))
end
mut out := str.Replace(tmpl, "$host", host)
if query.len() > 0:
ru := _cat3(path, "?", query)
out = _swap(out, "$request_uri", ru)
mem.Free(ru as void *)
else:
out = _swap(out, "$request_uri", path)
end
out = _swap(out, "$document_root", root)
out = _swap(out, "$document_uri", path)
out = _swap(out, "$script_name", script)
out = _swap(out, "$query_string", query)
out = _swap(out, "$args", query)
out = _swap(out, "$remote_addr", remote)
pnum := str.FromInt(port as i64)
out = _swap(out, "$server_port", pnum)
mem.Free(pnum as void *)
out = _swap(out, "$scheme", "http")
out = _swap(out, "$uri", path)
out = _swap(out, "$root", root)
ret out
end
func _serve_fastcgi(ctx: i64, site: int, loc: int, root: str, rel: str, path: str, query: str, host: str, port: int): int:
addr := _effective_fastcgi(site, loc)
colon := addr.indexOf(":")
if colon <= 0: ret 502 end
fhost := addr.substr(0, colon)
fpstr := addr.substr(colon + 1, addr.len() - colon - 1)
fport := fpstr.to_int()
mem.Free(fpstr as void *)
timeout := _effective_fcgi_timeout(site, loc)
index := _effective_fcgi_index(site, loc)
mut script_rel := rel
if str.EndsWith(rel, "/"):
script_rel = _cat3(rel, index, "")
end
mut script_name := ""
mut path_info := ""
mut target := root + script_rel
if os.Exists(target) and not os.IsDir(target):
script_name = script_rel
else:
mem.Free(target as void *)
target = ""
mut cut := script_rel.len()
until cut > 0:
cand := script_rel.substr(0, cut)
full := root + cand
if os.Exists(full) and not os.IsDir(full):
script_name = cand
path_info = script_rel.substr(cut, script_rel.len() - cut)
target = full
break
end
mem.Free(full as void *)
mem.Free(cand as void *)
mut k := cut - 1
until k >= 0 and not _is_slash(script_rel, k):
k--
end
if k <= 0:
cut = 0
else:
cut = k
end
end
end
if script_name.len() == 0:
mem.Free(fhost as void *)
ret 404
end
mut p := fastcgi.NewParams()
defer fastcgi.Free(p)
hname := _host_only(host)
fastcgi.Add(p, "GATEWAY_INTERFACE", "CGI/1.1")
fastcgi.Add(p, "SERVER_SOFTWARE", "Salam")
fastcgi.Add(p, "SERVER_PROTOCOL", "HTTP/1.1")
fastcgi.Add(p, "REQUEST_METHOD", http.Method(ctx))
fastcgi.Add(p, "SCRIPT_NAME", script_name)
fastcgi.Add(p, "SCRIPT_FILENAME", target)
fastcgi.Add(p, "PATH_INFO", path_info)
fastcgi.Add(p, "DOCUMENT_ROOT", root)
fastcgi.Add(p, "DOCUMENT_URI", path)
fastcgi.Add(p, "QUERY_STRING", query)
fastcgi.Add(p, "REDIRECT_STATUS", "200")
fastcgi.Add(p, "SERVER_NAME", hname)
pnum := str.FromInt(port as i64)
fastcgi.Add(p, "SERVER_PORT", pnum)
mem.Free(pnum as void *)
fastcgi.Add(p, "REMOTE_ADDR", "127.0.0.1")
fastcgi.Add(p, "HTTPS", "off")
if query.len() > 0:
ru := _cat3(path, "?", query)
fastcgi.Add(p, "REQUEST_URI", ru)
mem.Free(ru as void *)
else:
fastcgi.Add(p, "REQUEST_URI", path)
end
ctype := http.Header(ctx, "Content-Type")
if ctype.len() > 0:
fastcgi.Add(p, "CONTENT_TYPE", ctype)
end
body_len_txt := str.FromInt(http.BodyLen(ctx) as i64)
fastcgi.Add(p, "CONTENT_LENGTH", body_len_txt)
mem.Free(body_len_txt as void *)
mut hdrs := Vector {} as Vector<str>
hdrs.push("Host")
hdrs.push("User-Agent")
hdrs.push("Accept")
hdrs.push("Accept-Language")
hdrs.push("Accept-Encoding")
hdrs.push("Cookie")
hdrs.push("Referer")
hdrs.push("Authorization")
hdrs.push("Origin")
hdrs.push("Cache-Control")
hdrs.push("If-None-Match")
hdrs.push("If-Modified-Since")
hdrs.push("Range")
hdrs.push("X-Requested-With")
hdrs.push("X-Forwarded-For")
hdrs.push("X-Forwarded-Proto")
hdrs.push("X-Real-IP")
repeat hdrs.len() in i:
hn := hdrs.get(i)
hv := http.Header(ctx, hn)
if hv.len() > 0:
key := _http_param(hn)
fastcgi.Add(p, key, hv)
mem.Free(key as void *)
end
end
hdrs.free()
repeat _cfg.fcgi.len() in i:
fp := _cfg.fcgi.get(i)
if fp.site == site and (fp.loc == -1 or fp.loc == loc):
val := _expand_param(ctx, fp.value, hname, path, query, root, script_name, port, "127.0.0.1")
fastcgi.Add(p, fp.name, val)
mem.Free(val as void *)
end
end
mem.Free(hname as void *)
c := fastcgi.Connect(fhost, fport, timeout)
if not tcp.ConnOk(c):
mem.Free(fhost as void *)
mem.Free(target as void *)
_reply(ctx, 502, "502 Bad Gateway: cannot connect to the FastCGI backend " + addr)
ret 502
end
defer tcp.Close(c)
mut r := fastcgi.Execute(c, p, http.BodyBytes(ctx), http.BodyLen(ctx), timeout)
mem.Free(fhost as void *)
mem.Free(target as void *)
if not r.ok:
msg := "502 Bad Gateway: " + r.error
fastcgi.FreeResponse(r)
_reply(ctx, 502, msg)
ret 502
end
http.SetStatus(ctx, r.status)
mut ctout := "text/html; charset=utf-8"
repeat r.headers.len() in i:
h := r.headers.get(i)
ln := str.Lower(h.name)
if str.Equals(ln, "content-type"):
ctout = h.value
else str.Equals(ln, "content-length") or str.Equals(ln, "connection") or str.Equals(ln, "transfer-encoding"):
continue
else:
http.AddHeader(ctx, http.Own(ctx, str.Clone(h.name)), http.Own(ctx, str.Clone(h.value)))
end
end
if str.Equals(http.Method(ctx), "HEAD"):
http.Bytes(ctx, ctout, r.body, 0)
else:
http.Bytes(ctx, ctout, r.body, r.len)
end
fastcgi.FreeResponse(r)
ret r.status
end
func _origin_form(ctx: i64, target: str): str:
mut start := 0
if _starts_at(target, 0, "http://"):
start = 7
else _starts_at(target, 0, "https://"):
start = 8
end
if start == 0: ret target end
rest := target.substr(start, target.len() - start)
slash := rest.indexOf("/")
if slash < 0:
mem.Free(rest as void *)
ret "/"
end
out := rest.substr(slash, rest.len() - slash)
mem.Free(rest as void *)
ret http.Own(ctx, out)
end
func _handle(ctx: i64):
host := http.Header(ctx, "Host")
mut port := _only_port
if _multi_port: port = http.LocalPort(ctx) end
method := http.Method(ctx)
raw := http.Path(ctx)
query := http.RawQuery(ctx)
site := SiteFor(host, port)
if site < 0:
_reply(ctx, 404, "no site is configured for this host")
_log_line(host, method, raw, 404)
ret
end
if str.Contains(raw, "%00"):
_reply(ctx, 400, "400 Bad Request")
_log_line(host, method, raw, 400)
ret
end
dec := http.UrlDecode(_origin_form(ctx, raw))
path := http.Own(ctx, _norm_path(dec))
mem.Free(dec as void *)
mut status := 200
mut loc := -1
if path.len() == 0 or _blocked_segment(path):
_fail(ctx, site, -1, _effective_root(site, -1), 404, "404 Not Found")
_log_line(host, method, raw, 404)
ret
end
_apply_headers(ctx, site, -1)
if _send_rule(ctx, _cfg.sites.get(site).rule, host, path, query):
_log_line(host, method, raw, http.Status(ctx))
ret
end
loc = LocationFor(site, path)
if loc >= 0:
_apply_headers(ctx, site, loc)
if _send_rule(ctx, _cfg.locations.get(loc).rule, host, path, query):
_log_line(host, method, raw, http.Status(ctx))
ret
end
end
mut root := _effective_root(site, loc)
mut rel := path
alias := _effective_alias(loc)
if alias.len() > 0:
root = alias
cut := _cfg.locations.get(loc).pattern.len()
tail := path.substr(cut, path.len() - cut)
rel = http.Own(ctx, _cat3("/", tail, ""))
mem.Free(tail as void *)
end
if _effective_fastcgi(site, loc).len() > 0:
status = _serve_fastcgi(ctx, site, loc, root, rel, path, query, host, port)
else root.len() == 0:
status = 404
else not (str.Equals(method, "GET") or str.Equals(method, "HEAD")):
http.SetHeader(ctx, "Allow", "GET, HEAD")
status = 405
else:
status = _serve_file(ctx, site, loc, root, rel, path, query)
end
if status == 404:
_fail(ctx, site, loc, root, 404, "404 Not Found")
else status == 405:
_fail(ctx, site, loc, root, 405, "405 Method Not Allowed")
end
_log_line(host, method, raw, http.Status(ctx))
end
package httpproxy
import str
import net.tunnel
import net.socks
@en "HttpInbound"
@fa "ورودی اچ‌تی‌تی‌پی"
pub struct HttpInbound:
@en "config"
@fa "پیکربندی"
pub config: ServerConfig = ServerConfig {}
@en "Name"
@fa "نام"
pub func Name(): str:
ret "http"
end
@en "Handshake"
@fa "دست‌دهی"
pub func Handshake(s: dyn tunnel.Stream): tunnel.Session:
ret _inbound_handshake(this.config, s)
end
@en "Reply"
@fa "پاسخ"
pub func Reply(s: dyn tunnel.Stream, sess: tunnel.Session, ok: bool):
if sess.initial.len() > 0:
if sess.refused and not ok:
_respond(s, 403, "", "forbidden\n", true)
else not ok:
_respond(s, 502, "", "cannot reach " + sess.target.String() + "\n", true)
end
ret
end
if ok:
_send(s, "HTTP/1.1 200 Connection established\r\n\r\n")
else sess.refused:
_respond(s, 403, "", "forbidden\n", true)
else:
_respond(s, 502, "", "cannot reach " + sess.target.String() + "\n", true)
end
end
end
@en "HttpConnector"
@fa "رابط اچ‌تی‌تی‌پی"
pub struct HttpConnector:
@en "client"
@fa "کلاینت"
pub client: Client = Client {}
@en "Server"
@fa "کارساز"
pub func Server(): tunnel.Addr:
ret tunnel.NewAddr(this.client.host, this.client.port)
end
@en "Handshake"
@fa "دست‌دهی"
pub func Handshake(s: dyn tunnel.Stream, target: tunnel.Addr): bool:
ret ClientHandshake(s, this.client, target.host, target.port).ok
end
@en "Name"
@fa "نام"
pub func Name(): str:
ret "http"
end
end
func _fail(msg: str): tunnel.Session:
ret tunnel.Session { error = msg }
end
func _inbound_handshake(cfg: ServerConfig, s: dyn tunnel.Stream): tunnel.Session:
mut rd := _rd_new(s, MaxHeadBytes)
defer _rd_free(rd)
mut tries := 0
until tries < 4:
tries++
mut st := 0
text := _rd_head(rd, MaxHeadBytes, st)
if st != 0:
if st == 2: _respond(s, 431, "", "request head too large\n", true) end
ret _fail("no request head")
end
h := ParseRequestHead(text)
if not h.ok:
_respond(s, 400, "", "bad request\n", true)
ret _fail("bad request")
end
mut blen := 0 as i64
kind := _body_kind(h, blen)
if not _auth_ok(cfg, h):
if kind != 0 or not _keepalive(h):
_respond(s, 407, "Proxy-Authenticate: Basic realm=\"" + cfg.realm + "\"\r\n", "", true)
ret _fail("proxy authentication required")
end
_respond(s, 407, "Proxy-Authenticate: Basic realm=\"" + cfg.realm + "\"\r\n", "", false)
continue
end
mut user := ""
if cfg.require_auth:
mut pass := ""
BasicCredentials(HeaderGet(h, "proxy-authorization"), user, pass)
end
if h.method == "CONNECT":
hp := SplitHostPort(h.target, 0)
if not hp.ok or not hp.has_port:
_respond(s, 400, "", "CONNECT needs host:port\n", true)
ret _fail("bad CONNECT target")
end
if not cfg.allow_connect or not cfg.allow("CONNECT", hp.host, hp.port):
_respond(s, 403, "", "forbidden\n", true)
ret _fail("target not allowed")
end
if rd.len > rd.pos:
ret _fail("data sent before the tunnel was open")
end
ret tunnel.Session { ok = true, target = tunnel.NewAddr(hp.host, hp.port), protocol = "http", user = user, command = 1 }
end
u := ParseURL(h.target)
if not u.ok or u.scheme != "http":
_respond(s, 400, "", "absolute http URI required\n", true)
ret _fail("not a proxy request")
end
if not cfg.allow_plain or not cfg.allow(h.method, u.host, u.port):
_respond(s, 403, "", "forbidden\n", true)
ret _fail("target not allowed")
end
if kind < 0 or kind == 2 or blen > 1048576 as i64:
_respond(s, 501, "", "this proxy entry cannot forward that body\n", true)
ret _fail("unsupported body framing")
end
mut head := h.method + " " + u.path + " HTTP/1.1\r\nHost: " + _host_header(u) + "\r\n" + _fwd_headers(h, false)
if kind == 1: head += "Content-Length: " + str.FromInt(blen) + "\r\n" end
head += "Connection: close\r\n\r\n"
mut payload := head
if kind == 1:
n := blen as int
sink_st := _sink_new(n + 16)
sink := _Sink { st = sink_st }
ok := _rd_copy(rd, sink, blen)
mut clean := ok
if ok:
repeat sink_st[0].len in i:
if sink_st[0].buf[i] == 0: clean = false end
end
end
if clean: payload += _range_str(sink_st[0].buf, 0, sink_st[0].len) end
_sink_free(sink_st)
if not clean: ret _fail("body truncated or binary") end
end
ret tunnel.Session { ok = true, target = tunnel.NewAddr(u.host, u.port), protocol = "http", user = user, command = 1, initial = payload }
end
ret _fail("too many authentication attempts")
end
@en "NewInbound"
@fa "ورودی جدید"
pub func NewInbound(cfg: ServerConfig): HttpInbound:
ret HttpInbound { config = cfg }
end
@en "NewConnector"
@fa "رابط جدید"
pub func NewConnector(c: Client): HttpConnector:
ret HttpConnector { client = c }
end
@en "SetDialer"
@fa "تعیین شماره‌گیر"
pub func SetDialer(cfg &: ServerConfig, d: dyn tunnel.Dialer):
cfg.has_connect = true
cfg.connect = (h: str, p: int):
s := d.Dial(tunnel.NewAddr(h, p))
if not s.Ok(): ret socks.Outbound { ok = false, code = socks.RepHostUnreachable, err = "dial failed via " + d.Name() } end
ret socks.Outbound { ok = true, code = socks.RepSucceeded, stream = s }
end
end
package httpproxy
import str
import net.tcp
import net.tunnel
import tls
@en "Client"
@fa "کلاینت"
pub struct Client:
@en "host"
@fa "میزبان"
pub host: str = ""
@en "port"
@fa "درگاه"
pub port: int = 0
@en "username"
@fa "نام کاربری"
pub username: str = ""
@en "password"
@fa "گذرواژه"
pub password: str = ""
@en "tls"
@fa "امن"
pub tls: bool = false
@en "server_name"
@fa "نام سرور"
pub server_name: str = ""
@en "insecure"
@fa "بدون اعتبارسنجی"
pub insecure: bool = false
@en "timeout_ms"
@fa "مهلت میلی‌ثانیه"
pub timeout_ms: int = 15000
@en "max_body"
@fa "بیشترین اندازه بدنه"
pub max_body: int = 16777216
end
@en "HandshakeResult"
@fa "نتیجه دست‌دهی"
pub struct HandshakeResult:
@en "ok"
@fa "موفق"
pub ok: bool = false
@en "status"
@fa "وضعیت"
pub status: int = 0
@en "err"
@fa "خطا"
pub err: str = ""
end
@en "ConnectResult"
@fa "نتیجه اتصال"
pub struct ConnectResult:
@en "ok"
@fa "موفق"
pub ok: bool = false
@en "status"
@fa "وضعیت"
pub status: int = 0
@en "err"
@fa "خطا"
pub err: str = ""
@en "stream"
@fa "جریان"
pub stream: dyn tunnel.Stream = tunnel.TcpStream {}
end
@en "Response"
@fa "پاسخ"
pub struct Response:
@en "ok"
@fa "موفق"
pub ok: bool = false
@en "err"
@fa "خطا"
pub err: str = ""
@en "status"
@fa "وضعیت"
pub status: int = 0
@en "head"
@fa "سرآیند"
pub head: Head = Head {}
@en "body"
@fa "بدنه"
pub body: str = ""
@en "length"
@fa "طول بدنه"
pub length: int = 0
end
func _open(c: Client): ConnectResult:
mut r := ConnectResult {}
if c.tls:
mut cfg := tls.NewConfig(c.server_name)
if c.server_name.len() == 0: cfg = tls.NewConfig(c.host) end
cfg.insecure_skip_verify = c.insecure
t := tls.Dial(c.host, c.port, cfg)
if not tls.ConnOk(t):
r.err = "tls dial to proxy failed: " + tls.ConnError(t)
ret r
end
r.stream = tunnel.TlsStream { conn = t }
r.ok = true
ret r
end
conn := tcp.DialTimeout(c.host, c.port, c.timeout_ms)
if not tcp.ConnOk(conn):
r.err = "cannot reach proxy " + c.host + ":" + str.FromInt(c.port as i64)
ret r
end
tcp.SetNoDelay(conn, true)
r.stream = tunnel.TcpStream { conn = conn }
r.ok = true
ret r
end
func _auth_line(c: Client): str:
if c.username.len() == 0: ret "" end
ret "Proxy-Authorization: " + BasicHeader(c.username, c.password) + "\r\n"
end
func _authority(host: str, port: int): str:
mut h := host
if h.find(":") >= 0: h = "[" + h + "]" end
ret h + ":" + str.FromInt(port as i64)
end
func _rd_unchunk(r &: _Rd, dst: dyn tunnel.Stream): bool:
until true:
mut line := ""
if not _rd_line(r, 1024, line): ret false end
size := _chunk_size(line)
if size < 0: ret false end
if size == 0:
until true:
mut tl := ""
if not _rd_line(r, 8192, tl): ret false end
if tl.len() == 0: ret true end
end
end
if not _rd_copy(r, dst, size): ret false end
mut crlf := ""
if not _rd_line(r, 8, crlf): ret false end
if crlf.len() != 0: ret false end
end
end
@en "NewClient"
@fa "کلاینت جدید"
pub func NewClient(host: str, port: int): Client:
ret Client { host = host, port = port }
end
@en "NewClientAuth"
@fa "کلاینت جدید با احراز هویت"
pub func NewClientAuth(host: str, port: int, username: str, password: str): Client:
ret Client { host = host, port = port, username = username, password = password }
end
@en "ClientHandshake"
@fa "دست‌دهی کلاینت"
pub func ClientHandshake(s: dyn tunnel.Stream, c: Client, host: str, port: int): HandshakeResult:
mut r := HandshakeResult {}
auth := _authority(host, port)
req := "CONNECT " + auth + " HTTP/1.1\r\nHost: " + auth + "\r\n" + _auth_line(c) + "\r\n"
s.SetDeadline(c.timeout_ms)
if not tunnel.WriteAll(s, req):
r.err = "request write failed"
ret r
end
text := tunnel.ReadUntil(s, "\r\n\r\n", 16384)
s.SetDeadline(0)
if not text.ends_with("\r\n\r\n"):
r.err = "response head truncated"
ret r
end
rh := ParseResponseHead(text)
if not rh.ok:
r.err = "bad response: " + rh.err
ret r
end
r.status = rh.status
if rh.status < 200 or rh.status > 299:
r.err = "proxy answered " + str.FromInt(rh.status as i64) + " " + rh.reason
ret r
end
r.ok = true
ret r
end
@en "Connect"
@fa "اتصال"
pub func Connect(c: Client, host: str, port: int): ConnectResult:
mut r := _open(c)
if not r.ok: ret r end
h := ClientHandshake(r.stream, c, host, port)
if not h.ok:
r.stream.Close()
r.ok = false
r.status = h.status
r.err = h.err
ret r
end
r.status = h.status
ret r
end
@en "DialConn"
@fa "شماره‌گیری اتصال"
pub func DialConn(c: Client, host: str, port: int): tcp.Conn:
conn := tcp.DialTimeout(c.host, c.port, c.timeout_ms)
if not tcp.ConnOk(conn): ret conn end
st := tunnel.TcpStream { conn = conn }
h := ClientHandshake(st, c, host, port)
if not h.ok:
tcp.Close(conn)
ret tcp.Conn {}
end
ret conn
end
@en "Request"
@fa "درخواست"
pub func Request(c: Client, method: str, url: str, headers: str, body: str): Response:
mut resp := Response {}
u := ParseURL(url)
if not u.ok or u.scheme != "http":
resp.err = "only absolute http URLs can go through the proxy this way"
ret resp
end
mut o := _open(c)
if not o.ok:
resp.err = o.err
ret resp
end
mut req := method + " " + url + " HTTP/1.1\r\nHost: " + _host_header(u) + "\r\n" + _auth_line(c) + headers + "Connection: close\r\n"
if body.len() > 0 or method == "POST" or method == "PUT":
req += "Content-Length: " + str.FromInt(body.len() as i64) + "\r\n"
end
req += "\r\n" + body
o.stream.SetDeadline(c.timeout_ms)
if not tunnel.WriteAll(o.stream, req):
o.stream.Close()
resp.err = "request write failed"
ret resp
end
mut rd := _rd_new(o.stream, MaxHeadBytes)
sk := _sink_new(c.max_body)
sink := _Sink { st = sk }
mut ok := false
until true:
mut st := 0
text := _rd_head(rd, MaxHeadBytes, st)
if st != 0:
resp.err = "no response head"
break
end
rh := ParseResponseHead(text)
if not rh.ok:
resp.err = "bad response: " + rh.err
break
end
if rh.status >= 100 and rh.status < 200 and rh.status != 101: continue end
resp.head = rh
resp.status = rh.status
framing := _resp_framing(rh, method)
if framing == 1:
mut rl := 0 as i64
_body_kind(rh, rl)
ok = _rd_copy(rd, sink, rl)
else framing == 2:
ok = _rd_unchunk(rd, sink)
else framing == 3:
ok = _rd_copy_close(rd, sink)
else:
ok = true
end
if not ok: resp.err = "body truncated or too large" end
break
end
resp.length = sk[0].len
resp.body = _range_str(sk[0].buf, 0, sk[0].len)
resp.ok = ok
_sink_free(sk)
_rd_free(rd)
o.stream.Close()
ret resp
end
@en "Get"
@fa "دریافت"
pub func Get(c: Client, url: str): Response:
ret Request(c, "GET", url, "", "")
end
@en "Post"
@fa "ارسال"
pub func Post(c: Client, url: str, content_type: str, body: str): Response:
ret Request(c, "POST", url, "Content-Type: " + content_type + "\r\n", body)
end
@en "net/httpproxy"
@fa "پراکسی اچ‌تی‌تی‌پی"
package httpproxy
import mem
import str
import encoding
@en "MaxHeadBytes"
@fa "بیشترین اندازه سرآیند"
pub const MaxHeadBytes := 65536
@en "MaxHeaders"
@fa "بیشترین تعداد سرآیند"
pub const MaxHeaders := 200
@en "Head"
@fa "سرآیند"
pub struct Head:
@en "ok"
@fa "معتبر"
pub ok: bool = false
@en "err"
@fa "خطا"
pub err: str = ""
@en "method"
@fa "روش"
pub method: str = ""
@en "target"
@fa "هدف"
pub target: str = ""
@en "version"
@fa "نسخه"
pub version: str = ""
@en "status"
@fa "وضعیت"
pub status: int = 0
@en "reason"
@fa "دلیل"
pub reason: str = ""
@en "names"
@fa "نام‌ها"
pub names: Vector<str> = Vector {}
@en "values"
@fa "مقدارها"
pub values: Vector<str> = Vector {}
end
@en "HostPort"
@fa "میزبان درگاه"
pub struct HostPort:
@en "ok"
@fa "معتبر"
pub ok: bool = false
@en "host"
@fa "میزبان"
pub host: str = ""
@en "port"
@fa "درگاه"
pub port: int = 0
@en "has_port"
@fa "درگاه دارد"
pub has_port: bool = false
end
@en "URL"
@fa "نشانی وب"
pub struct URL:
@en "ok"
@fa "معتبر"
pub ok: bool = false
@en "scheme"
@fa "طرح"
pub scheme: str = ""
@en "host"
@fa "میزبان"
pub host: str = ""
@en "port"
@fa "درگاه"
pub port: int = 0
@en "path"
@fa "مسیر"
pub path: str = ""
end
func _ch(s: str, i: int): int:
p := s as u8*
ret p[i] as int
end
func _is_tchar(c: int): bool:
if c >= 48 and c <= 57: ret true end
if c >= 65 and c <= 90: ret true end
if c >= 97 and c <= 122: ret true end
if c == 33 or c == 35 or c == 36 or c == 37 or c == 38 or c == 39 or c == 42 or c == 43: ret true end
if c == 45 or c == 46 or c == 94 or c == 95 or c == 96 or c == 124 or c == 126: ret true end
ret false
end
func _is_token(s: str): bool:
n := s.len()
if n == 0: ret false end
repeat n in i:
if not _is_tchar(_ch(s, i)): ret false end
end
ret true
end
func _digits(s: str): bool:
n := s.len()
if n == 0 or n > 9: ret false end
repeat n in i:
c := _ch(s, i)
if c < 48 or c > 57: ret false end
end
ret true
end
func _parse_headers(lines: Vector<str>, from: int, h &: Head): bool:
mut i := from
mut count := 0
until i < lines.len():
line := lines.get(i)
if line.len() == 0: ret true end
c0 := _ch(line, 0)
if c0 == 32 or c0 == 9:
h.err = "folded header lines are not allowed"
ret false
end
colon := line.find(":")
if colon <= 0:
h.err = "malformed header line"
ret false
end
name := line.substr(0, colon)
if not _is_token(name):
h.err = "invalid header name"
ret false
end
value := line.substr(colon + 1, line.len() - colon - 1).trim()
h.names.push(name)
h.values.push(value)
count++
if count > MaxHeaders:
h.err = "too many headers"
ret false
end
i++
end
ret true
end
func _bare_break(text: str): bool:
n := text.len()
mut i := 0
until i < n:
c := _ch(text, i)
if c == 13:
if i + 1 >= n or _ch(text, i + 1) != 10: ret true end
i++
else c == 10:
ret true
end
i++
end
ret false
end
func _fail_head(msg: str): Head:
ret Head { ok = false, err = msg }
end
func _lower_eq(a: str, b: str): bool:
ret str.EqualFold(a, b)
end
func _tokens_has(value: str, token: str): bool:
parts := value.split(",")
defer parts.free()
repeat parts.len() in i:
if _lower_eq(parts.get(i).trim(), token): ret true end
end
ret false
end
@en "ParseRequestHead"
@fa "تجزیه سرآیند درخواست"
pub func ParseRequestHead(text: str): Head:
if text.len() == 0 or text.len() > MaxHeadBytes: ret _fail_head("bad head size") end
if _bare_break(text): ret _fail_head("bare CR or LF in the head") end
lines := text.split("\r\n")
defer lines.free()
if lines.len() < 1: ret _fail_head("empty head") end
first := lines.get(0)
parts := first.split(" ")
defer parts.free()
if parts.len() != 3: ret _fail_head("malformed request line") end
mut h := Head {}
h.method = parts.get(0)
h.target = parts.get(1)
h.version = parts.get(2)
if not _is_token(h.method): ret _fail_head("invalid method") end
if h.target.len() == 0: ret _fail_head("empty request target") end
if h.version != "HTTP/1.1" and h.version != "HTTP/1.0": ret _fail_head("unsupported HTTP version") end
if not _parse_headers(lines, 1, h): ret h end
h.ok = true
ret h
end
@en "ParseResponseHead"
@fa "تجزیه سرآیند پاسخ"
pub func ParseResponseHead(text: str): Head:
if text.len() == 0 or text.len() > MaxHeadBytes: ret _fail_head("bad head size") end
if _bare_break(text): ret _fail_head("bare CR or LF in the head") end
lines := text.split("\r\n")
defer lines.free()
if lines.len() < 1: ret _fail_head("empty head") end
first := lines.get(0)
if first.len() < 12: ret _fail_head("malformed status line") end
mut h := Head {}
h.version = first.substr(0, 8)
if h.version != "HTTP/1.1" and h.version != "HTTP/1.0": ret _fail_head("unsupported HTTP version") end
if _ch(first, 8) != 32: ret _fail_head("malformed status line") end
code := first.substr(9, 3)
if not _digits(code): ret _fail_head("malformed status code") end
h.status = code.to_int()
if first.len() > 12:
if _ch(first, 12) != 32: ret _fail_head("malformed status line") end
h.reason = first.substr(13, first.len() - 13)
end
if not _parse_headers(lines, 1, h): ret h end
h.ok = true
ret h
end
@en "HeaderGet"
@fa "گرفتن سرآیند"
pub func HeaderGet(h: Head, name: str): str:
repeat h.names.len() in i:
if _lower_eq(h.names.get(i), name): ret h.values.get(i) end
end
ret ""
end
@en "HeaderHas"
@fa "سرآیند دارد"
pub func HeaderHas(h: Head, name: str): bool:
repeat h.names.len() in i:
if _lower_eq(h.names.get(i), name): ret true end
end
ret false
end
@en "HeaderCount"
@fa "تعداد سرآیند"
pub func HeaderCount(h: Head, name: str): int:
mut n := 0
repeat h.names.len() in i:
if _lower_eq(h.names.get(i), name): n++ end
end
ret n
end
@en "HeaderHasToken"
@fa "سرآیند توکن دارد"
pub func HeaderHasToken(h: Head, name: str, token: str): bool:
repeat h.names.len() in i:
if _lower_eq(h.names.get(i), name):
if _tokens_has(h.values.get(i), token): ret true end
end
end
ret false
end
@en "IsHopByHop"
@fa "از نوع گام‌به‌گام"
pub func IsHopByHop(name: str): bool:
n := name.lower()
if n == "connection" or n == "keep-alive" or n == "proxy-authenticate" or n == "proxy-authorization": ret true end
if n == "proxy-connection" or n == "te" or n == "trailer" or n == "transfer-encoding" or n == "upgrade": ret true end
ret false
end
@en "SplitHostPort"
@fa "جداسازی میزبان درگاه"
pub func SplitHostPort(s: str, default_port: int): HostPort:
n := s.len()
if n == 0 or n > 300: ret HostPort {} end
mut host := ""
mut rest := ""
if _ch(s, 0) == 91:
close := s.find("]")
if close < 2: ret HostPort {} end
host = s.substr(1, close - 1)
rest = s.substr(close + 1, n - close - 1)
if rest.len() > 0 and _ch(rest, 0) != 58: ret HostPort {} end
else:
colon := s.find(":")
if colon < 0:
host = s
else:
if s.substr(colon + 1, n - colon - 1).find(":") >= 0: ret HostPort {} end
host = s.substr(0, colon)
rest = s.substr(colon, n - colon)
end
end
if host.len() == 0 or host.len() > 255: ret HostPort {} end
repeat host.len() in i:
c := _ch(host, i)
if c <= 32 or c == 47 or c == 63 or c == 35 or c == 64 or c == 127: ret HostPort {} end
end
if rest.len() > 0:
ps := rest.substr(1, rest.len() - 1)
if not _digits(ps): ret HostPort {} end
p := ps.to_int()
if p < 1 or p > 65535: ret HostPort {} end
ret HostPort { ok = true, host = host, port = p, has_port = true }
end
ret HostPort { ok = true, host = host, port = default_port, has_port = false }
end
@en "ParseURL"
@fa "تجزیه نشانی وب"
pub func ParseURL(s: str): URL:
sep := s.find("://")
if sep < 1: ret URL {} end
scheme := s.substr(0, sep).lower()
if scheme != "http" and scheme != "https": ret URL {} end
mut rest := s.substr(sep + 3, s.len() - sep - 3)
hash := rest.find("#")
if hash >= 0: rest = rest.substr(0, hash) end
mut cut := rest.len()
slash := rest.find("/")
qpos := rest.find("?")
if slash >= 0 and slash < cut: cut = slash end
if qpos >= 0 and qpos < cut: cut = qpos end
mut auth := rest.substr(0, cut)
mut path := rest.substr(cut, rest.len() - cut)
at := auth.find("@")
if at >= 0: auth = auth.substr(at + 1, auth.len() - at - 1) end
if path.len() == 0: path = "/" end
if _ch(path, 0) == 63: path = "/" + path end
mut dp := 80
if scheme == "https": dp = 443 end
hp := SplitHostPort(auth, dp)
if not hp.ok: ret URL {} end
ret URL { ok = true, scheme = scheme, host = hp.host, port = hp.port, path = path }
end
@en "BasicHeader"
@fa "سرآیند بیسیک"
pub func BasicHeader(user: str, pass: str): str:
ret "Basic " + encoding.Base64Encode(user + ":" + pass)
end
@en "BasicCredentials"
@fa "اعتبارنامه بیسیک"
pub func BasicCredentials(value: str, user &: str, pass &: str): bool:
v := value.trim()
if v.len() < 7: ret false end
if not _lower_eq(v.substr(0, 5), "basic") or _ch(v, 5) != 32: ret false end
token := v.substr(6, v.len() - 6).trim()
mut plain := ""
try:
plain = encoding.Base64Decode(token)
catch:
ret false
end
colon := plain.find(":")
if colon < 0: ret false end
user = plain.substr(0, colon)
pass = plain.substr(colon + 1, plain.len() - colon - 1)
ret true
end
@en "StatusReason"
@fa "دلیل وضعیت"
pub func StatusReason(code: int): str:
switch code:
100: ret "Continue" end
200: ret "OK" end
400: ret "Bad Request" end
403: ret "Forbidden" end
404: ret "Not Found" end
405: ret "Method Not Allowed" end
407: ret "Proxy Authentication Required" end
408: ret "Request Timeout" end
411: ret "Length Required" end
431: ret "Request Header Fields Too Large" end
501: ret "Not Implemented" end
502: ret "Bad Gateway" end
504: ret "Gateway Timeout" end
505: ret "HTTP Version Not Supported" end
end
ret "Status"
end
@en "ResponseText"
@fa "متن پاسخ"
pub func ResponseText(code: int, extra_headers: str, body: str, close: bool): str:
mut out := "HTTP/1.1 " + str.FromInt(code as i64) + " " + StatusReason(code) + "\r\n"
out += extra_headers
out += "Content-Length: " + str.FromInt(body.len() as i64) + "\r\n"
if close: out += "Connection: close\r\n" end
out += "\r\n" + body
ret out
end
package httpproxy
import mem
import str
import net.tunnel
struct _Rd:
pub s: dyn tunnel.Stream = tunnel.TcpStream {}
pub buf: u8* = null
pub cap: int = 0
pub pos: int = 0
pub len: int = 0
end
struct _SinkState:
pub buf: u8* = null
pub len: int = 0
pub cap: int = 0
pub limit: int = 0
pub overflow: bool = false
end
struct _Sink:
pub st: _SinkState* = null
pub deadline: int = 0
pub closed: bool = false
pub func Read(_max: int): str:
ret ""
end
pub func ReadBytes(_buf: void*, _max: int): int:
ret 0
end
pub func Write(data: str): int:
ret this.WriteBytes(data as void*, data.len())
end
pub func WriteBytes(ptr: void*, n: int): int:
s := this.st
if s[0].len + n > s[0].limit:
s[0].overflow = true
ret 0 - 1
end
if s[0].len + n > s[0].cap:
mut nc := s[0].cap * 2
if nc < s[0].len + n: nc = s[0].len + n end
s[0].buf = mem.Reallocate(s[0].buf as void*, nc as u64) as u8*
s[0].cap = nc
end
mem.Copy(((s[0].buf as i64) + (s[0].len as i64)) as void*, ptr, n as u64)
s[0].len += n
ret n
end
pub func SetDeadline(millis: int):
this.deadline = millis
end
pub func Shutdown():
this.closed = true
end
pub func CloseWrite():
this.closed = true
end
pub func Close():
this.closed = true
end
pub func Ok(): bool:
ret not this.closed
end
end
func _range_str(p: u8*, off: int, n: int): str:
b := mem.AllocateZeroed((n + 1) as u64)
if n > 0: mem.Copy(b, ((p as i64) + (off as i64)) as void*, n as u64) end
out := str.Clone(b as str)
mem.Free(b)
ret out
end
func _rd_new(s: dyn tunnel.Stream, cap: int): _Rd:
ret _Rd { s = s, buf = mem.Allocate(cap as u64) as u8*, cap = cap, pos = 0, len = 0 }
end
func _rd_free(r: _Rd):
mem.Free(r.buf as void*)
end
func _rd_fill(r &: _Rd): bool:
if r.pos == r.len:
r.pos = 0
r.len = 0
end
if r.len == r.cap:
if r.pos == 0: ret false end
mem.MemMove(r.buf as void*, ((r.buf as i64) + (r.pos as i64)) as void*, (r.len - r.pos) as u64)
r.len -= r.pos
r.pos = 0
end
n := r.s.ReadBytes(((r.buf as i64) + (r.len as i64)) as void*, r.cap - r.len)
if n <= 0: ret false end
r.len += n
ret true
end
func _rd_find(r: _Rd, pat: str, from: int): int:
pl := pat.len()
pp := pat as u8*
mut i := r.pos + from
until i + pl <= r.len:
mut m := 0
until m < pl and r.buf[i + m] == pp[m]:
m++
end
if m == pl: ret i - r.pos end
i++
end
ret 0 - 1
end
func _rd_head(r &: _Rd, max: int, status &: int): str:
status = 0
until r.pos < r.len and (r.buf[r.pos] == 13 or r.buf[r.pos] == 10):
r.pos++
end
mut scan := 0
until true:
idx := _rd_find(r, "\r\n\r\n", scan)
if idx >= 0:
take := idx + 4
if take > max:
status = 2
ret ""
end
repeat take in i:
if r.buf[r.pos + i] == 0:
status = 3
ret ""
end
end
text := _range_str(r.buf, r.pos, take)
r.pos += take
ret text
end
avail := r.len - r.pos
if avail >= max:
status = 2
ret ""
end
scan = avail - 3
if scan < 0: scan = 0 end
had := avail
if not _rd_fill(r):
status = 1
if had > 0: status = 4 end
ret ""
end
end
end
func _rd_copy(r &: _Rd, dst: dyn tunnel.Stream, n: i64): bool:
mut left := n
until left > 0:
if r.pos == r.len:
if not _rd_fill(r): ret false end
end
mut take := r.len - r.pos
if (take as i64) > left: take = left as int end
if dst.WriteBytes(((r.buf as i64) + (r.pos as i64)) as void*, take) != take: ret false end
r.pos += take
left -= take as i64
end
ret true
end
func _rd_copy_close(r &: _Rd, dst: dyn tunnel.Stream): bool:
until true:
if r.pos < r.len:
take := r.len - r.pos
if dst.WriteBytes(((r.buf as i64) + (r.pos as i64)) as void*, take) != take: ret false end
r.pos += take
end
if not _rd_fill(r): ret true end
end
end
func _rd_line(r &: _Rd, max: int, out &: str): bool:
until true:
nl := _rd_find(r, "\n", 0)
if nl >= 0:
mut n := nl
if n > 0 and r.buf[r.pos + n - 1] == 13: n-- end
if n > max: ret false end
out = _range_str(r.buf, r.pos, n)
r.pos += nl + 1
ret true
end
if r.len - r.pos >= max: ret false end
if not _rd_fill(r): ret false end
end
end
func _hex_val(c: int): int:
if c >= 48 and c <= 57: ret c - 48 end
if c >= 97 and c <= 102: ret c - 87 end
if c >= 65 and c <= 70: ret c - 55 end
ret 0 - 1
end
func _has_ctl(line: str): bool:
n := line.len()
repeat n in i:
c := _ch(line, i)
if (c < 32 and c != 9) or c == 127: ret true end
end
ret false
end
func _chunk_size(line: str): i64:
n := line.len()
mut size := 0 as i64
mut digits := 0
mut i := 0
until i < n:
c := _ch(line, i)
if c == 59 or c == 32 or c == 9: break end
d := _hex_val(c)
if d < 0: ret 0 - 1 end
size = size * 16 + (d as i64)
digits++
if digits > 15: ret 0 - 1 end
i++
end
if digits == 0: ret 0 - 1 end
ret size
end
func _rd_copy_chunked(r &: _Rd, dst: dyn tunnel.Stream): bool:
until true:
mut line := ""
if not _rd_line(r, 1024, line): ret false end
if _has_ctl(line): ret false end
size := _chunk_size(line)
if size < 0: ret false end
if not tunnel.WriteAll(dst, line + "\r\n"): ret false end
if size == 0:
until true:
mut tl := ""
if not _rd_line(r, 8192, tl): ret false end
if _has_ctl(tl): ret false end
if not tunnel.WriteAll(dst, tl + "\r\n"): ret false end
if tl.len() == 0: ret true end
end
end
if not _rd_copy(r, dst, size): ret false end
mut crlf := ""
if not _rd_line(r, 8, crlf): ret false end
if crlf.len() != 0: ret false end
if not tunnel.WriteAll(dst, "\r\n"): ret false end
end
end
func _rd_flush_to(r &: _Rd, dst: dyn tunnel.Stream): bool:
take := r.len - r.pos
if take <= 0: ret true end
ok := dst.WriteBytes(((r.buf as i64) + (r.pos as i64)) as void*, take) == take
r.pos = r.len
ret ok
end
func _sink_new(limit: int): _SinkState*:
p := mem.AllocateZeroed(sizeof(_SinkState) as u64) as _SinkState*
p[0].buf = mem.Allocate(1024 as u64) as u8*
p[0].cap = 1024
p[0].limit = limit
ret p
end
func _sink_free(p: _SinkState*):
mem.Free(p[0].buf as void*)
mem.Free(p as void*)
end
package httpproxy
import mem
import str
import sync
import net.tcp
import net.internal.rawsock
import net.tunnel
import net.socks
import tls
struct _AcceptJob:
pub cfg: ServerConfig = ServerConfig {}
pub listener: tcp.Server = tcp.Server {}
pub stop: i64* = null
pub limits: tunnel.ConnLimits = tunnel.ConnLimits {}
end
struct _ConnJob:
pub cfg: ServerConfig = ServerConfig {}
pub conn: tcp.Conn = tcp.Conn {}
pub limits: tunnel.ConnLimits = tunnel.ConnLimits {}
pub adm: tunnel.Admit = tunnel.Admit {}
end
struct _Up:
pub ok: bool = false
pub host: str = ""
pub port: int = 0
pub stream: dyn tunnel.Stream = tunnel.TcpStream {}
pub rd: _Rd = _Rd {}
end
@en "ServerConfig"
@fa "پیکربندی سرور"
pub struct ServerConfig:
@en "port"
@fa "درگاه"
pub port: int = 0
@en "bind_host"
@fa "میزبان پیوند"
pub bind_host: str = "127.0.0.1"
@en "require_auth"
@fa "نیاز به احراز هویت"
pub require_auth: bool = false
@en "realm"
@fa "قلمرو"
pub realm: str = "Salam proxy"
@en "users"
@fa "کاربران"
pub users: HashMap<str, str> = HashMap {}
@en "auth"
@fa "احراز هویت"
pub auth: func (str, str) bool = (_u: str, _p: str): ret false end
@en "has_auth"
@fa "دارای احراز هویت سفارشی"
pub has_auth: bool = false
@en "allow_connect"
@fa "اجازه کانکت"
pub allow_connect: bool = true
@en "allow_plain"
@fa "اجازه درخواست ساده"
pub allow_plain: bool = true
@en "handshake_timeout_ms"
@fa "مهلت دست‌دهی میلی‌ثانیه"
pub handshake_timeout_ms: int = 15000
@en "idle_timeout_ms"
@fa "مهلت بی‌کاری میلی‌ثانیه"
pub idle_timeout_ms: int = 60000
@en "relay_idle_ms"
@fa "مهلت بی‌کاری رله"
pub relay_idle_ms: int = 0
@en "use_tls"
@fa "استفاده از تی ال اس"
pub use_tls: bool = false
@en "tls_config"
@fa "پیکربندی تی ال اس"
pub tls_config: tls.ServerConfig = tls.ServerConfig {}
@en "connect"
@fa "اتصال به مقصد"
pub connect: func (str, int) socks.Outbound = (h: str, p: int): ret socks.DirectConnect(h, p, 10000) end
@en "allow"
@fa "اجازه"
pub allow: func (str, str, int) bool = (_m: str, _h: str, _p: int): ret true end
@en "policy"
@fa "سیاست مقصد"
pub policy: tunnel.DestPolicy = tunnel.DestPolicy {}
@en "has_connect"
@fa "اتصال سفارشی دارد"
pub has_connect: bool = false
@en "max_connections"
@fa "بیشینه اتصال همزمان"
pub max_connections: int = 1024
@en "max_per_source"
@fa "بیشینه دست دادن مبدا"
pub max_per_source: int = 32
@en "handshake_deadline_ms"
@fa "مهلت کل دست‌دهی"
pub handshake_deadline_ms: int = 10000
end
@en "Server"
@fa "سرور"
pub struct Server:
@en "ok"
@fa "موفق"
pub ok: bool = false
@en "port"
@fa "درگاه"
pub port: int = 0
@en "host"
@fa "میزبان"
pub host: str = ""
@en "listener"
@fa "شنونده"
pub listener: tcp.Server = tcp.Server {}
@en "stop_cell"
@fa "پرچم توقف"
pub stop_cell: i64* = null
end
func _ct_eq(a: str, b: str): bool:
n := a.len()
m := b.len()
mut diff := n ^ m
pa := a as u8*
pb := b as u8*
mut i := 0
until i < n:
mut y := 0
if i < m: y = pb[i] as int end
diff |= (pa[i] as int) ^ y
i++
end
ret diff == 0
end
func _authorized(cfg: ServerConfig, user: str, pass: str): bool:
if cfg.users.has(user):
if _ct_eq(cfg.users.get(user), pass): ret true end
end
if cfg.has_auth: ret cfg.auth(user, pass) end
ret false
end
func _auth_ok(cfg: ServerConfig, h: Head): bool:
if not cfg.require_auth: ret true end
v := HeaderGet(h, "proxy-authorization")
if v.len() == 0: ret false end
mut user := ""
mut pass := ""
if not BasicCredentials(v, user, pass): ret false end
ret _authorized(cfg, user, pass)
end
func _send(s: dyn tunnel.Stream, text: str): bool:
ret tunnel.WriteAll(s, text)
end
func _respond(s: dyn tunnel.Stream, code: int, extra: str, body: str, close: bool): bool:
ret _send(s, ResponseText(code, extra, body, close))
end
func _body_kind(h: Head, n &: i64): int:
n = 0 as i64
te := HeaderGet(h, "transfer-encoding")
cls := HeaderCount(h, "content-length")
if te.len() > 0:
if cls > 0: ret 0 - 1 end
if HeaderCount(h, "transfer-encoding") > 1: ret 0 - 1 end
if not str.EqualFold(te.trim(), "chunked"): ret 0 - 2 end
ret 2
end
if cls == 0: ret 0 end
mut seen := ""
mut first := true
repeat h.names.len() in i:
if str.EqualFold(h.names.get(i), "content-length"):
v := h.values.get(i).trim()
if first:
seen = v
first = false
else v != seen:
ret 0 - 1
end
end
end
if seen.len() == 0 or seen.len() > 18: ret 0 - 1 end
mut total := 0 as i64
repeat seen.len() in i:
c := _ch(seen, i)
if c < 48 or c > 57: ret 0 - 1 end
total = total * 10 + ((c - 48) as i64)
end
n = total
if total == 0 as i64: ret 0 end
ret 1
end
func _keepalive(h: Head): bool:
if HeaderHasToken(h, "connection", "close") or HeaderHasToken(h, "proxy-connection", "close"): ret false end
if h.version == "HTTP/1.1": ret true end
ret HeaderHasToken(h, "connection", "keep-alive") or HeaderHasToken(h, "proxy-connection", "keep-alive")
end
func _fwd_headers(h: Head, keep_upgrade: bool): str:
mut out := ""
mut listed := Vector {} as Vector<str>
defer listed.free()
repeat h.names.len() in i:
if str.EqualFold(h.names.get(i), "connection"):
parts := h.values.get(i).split(",")
repeat parts.len() in k:
listed.push(parts.get(k).trim().lower())
end
parts.free()
end
end
repeat h.names.len() in i:
name := h.names.get(i)
low := name.lower()
mut skip := IsHopByHop(name)
if keep_upgrade and low == "upgrade": skip = false end
if low == "host" or low == "expect": skip = true end
repeat listed.len() in k:
if listed.get(k) == low and not (keep_upgrade and low == "upgrade"): skip = true end
end
if not skip: out += name + ": " + h.values.get(i) + "\r\n" end
end
ret out
end
func _host_header(u: URL): str:
mut hs := u.host
if hs.find(":") >= 0: hs = "[" + hs + "]" end
mut dp := 80
if u.scheme == "https": dp = 443 end
if u.port != dp: hs += ":" + str.FromInt(u.port as i64) end
ret hs
end
func _up_close(up &: _Up):
if up.ok:
up.stream.Close()
_rd_free(up.rd)
end
up.ok = false
end
func _outbound(cfg: ServerConfig, host: str, port: int): socks.Outbound:
pol := tunnel.PolicyForBind(cfg.policy, _bind_host(cfg))
if cfg.has_connect:
pl := tunnel.PolicyPlan(pol, tunnel.NewAddr(host, port), false)
if not pl.allowed:
ret socks.Outbound { ok = false, code = socks.RepNotAllowed, err = pl.reason }
end
ret cfg.connect(host, port)
end
ret socks.PolicyConnect(pol, host, port, 10000)
end
func _up_open(cfg: ServerConfig, up &: _Up, host: str, port: int): int:
_up_close(up)
out := _outbound(cfg, host, port)
if not out.ok: ret out.code end
up.ok = true
up.host = host
up.port = port
up.stream = out.stream
up.rd = _rd_new(out.stream, MaxHeadBytes)
ret 0
end
func _resp_framing(rh: Head, method: str): int:
st := rh.status
if method == "HEAD" or st == 204 or st == 304 or (st >= 100 and st < 200): ret 0 end
if HeaderHasToken(rh, "transfer-encoding", "chunked"): ret 2 end
mut n := 0 as i64
k := _body_kind(rh, n)
if k == 1: ret 1 end
if k == 0 and HeaderHas(rh, "content-length"): ret 0 end
ret 3
end
func _forward(cfg: ServerConfig, s: dyn tunnel.Stream, rd &: _Rd, h: Head, up &: _Up): bool:
u := ParseURL(h.target)
if not u.ok or u.scheme != "http":
_respond(s, 400, "", "absolute http URI required\n", true)
ret false
end
if not cfg.allow_plain or not cfg.allow(h.method, u.host, u.port):
_respond(s, 403, "", "forbidden\n", true)
ret false
end
mut blen := 0 as i64
kind := _body_kind(h, blen)
if kind == 0 - 1:
_respond(s, 400, "", "bad message framing\n", true)
ret false
else kind == 0 - 2:
_respond(s, 501, "", "unsupported transfer encoding\n", true)
ret false
end
upgrade := HeaderHasToken(h, "connection", "upgrade") and HeaderHas(h, "upgrade")
mut ka := _keepalive(h)
if upgrade: ka = false end
if str.EqualFold(HeaderGet(h, "expect").trim(), "100-continue") and kind != 0:
_send(s, "HTTP/1.1 100 Continue\r\n\r\n")
end
mut head := h.method + " " + u.path + " HTTP/1.1\r\nHost: " + _host_header(u) + "\r\n" + _fwd_headers(h, upgrade)
if kind == 2: head += "Transfer-Encoding: chunked\r\n" end
if upgrade: head += "Connection: Upgrade\r\n" else not ka: head += "Connection: close\r\n" end
head += "\r\n"
mut reused := up.ok and up.host == u.host and up.port == u.port
mut attempt := 0
mut rh := Head {}
until true:
if not reused:
code := _up_open(cfg, up, u.host, u.port)
if code == socks.RepNotAllowed:
_respond(s, 403, "", "forbidden\n", true)
ret false
else code != 0:
_respond(s, 502, "", "cannot reach " + u.host + "\n", true)
ret false
end
end
sent := _send(up.stream, head)
mut got := false
if sent:
if kind == 1:
if not _rd_copy(rd, up.stream, blen):
_up_close(up)
ret false
end
else kind == 2:
if not _rd_copy_chunked(rd, up.stream):
_up_close(up)
ret false
end
end
until true:
mut st := 0
text := _rd_head(up.rd, MaxHeadBytes, st)
if st != 0:
if reused and kind == 0 and st == 1 and attempt == 0: break end
_up_close(up)
_respond(s, 502, "", "upstream closed or sent a bad response\n", true)
ret false
end
rh = ParseResponseHead(text)
if not rh.ok:
_up_close(up)
_respond(s, 502, "", "bad response from upstream\n", true)
ret false
end
if rh.status >= 100 and rh.status < 200 and rh.status != 101:
_send(s, "HTTP/1.1 " + str.FromInt(rh.status as i64) + " " + rh.reason + "\r\n\r\n")
continue
end
got = true
break
end
else reused and attempt == 0:
got = false
else:
_up_close(up)
_respond(s, 502, "", "cannot send to upstream\n", true)
ret false
end
if got: break end
if reused and attempt == 0 and (kind == 0 or not sent):
attempt = 1
reused = false
_up_close(up)
else:
_up_close(up)
_respond(s, 502, "", "upstream failed\n", true)
ret false
end
end
framing := _resp_framing(rh, h.method)
mut rhead := "HTTP/1.1 " + str.FromInt(rh.status as i64) + " " + rh.reason + "\r\n" + _fwd_headers(rh, rh.status == 101)
if rh.status == 101:
rhead += "Connection: Upgrade\r\n\r\n"
if not _send(s, rhead) or not _rd_flush_to(up.rd, s):
_up_close(up)
ret false
end
_rd_flush_to(rd, up.stream)
s.SetDeadline(0)
socks.Relay(s, up.stream, cfg.relay_idle_ms)
up.ok = false
_rd_free(up.rd)
ret false
end
if framing == 2: rhead += "Transfer-Encoding: chunked\r\n" end
ck := ka and framing != 3
if not ck: rhead += "Connection: close\r\n" end
rhead += "\r\n"
if not _send(s, rhead):
_up_close(up)
ret false
end
mut ok := true
if framing == 1:
mut rl := 0 as i64
_body_kind(rh, rl)
ok = _rd_copy(up.rd, s, rl)
else framing == 2:
ok = _rd_copy_chunked(up.rd, s)
else framing == 3:
ok = _rd_copy_close(up.rd, s)
end
if not ok:
_up_close(up)
ret false
end
mut keep_up := framing != 3 and not HeaderHasToken(rh, "connection", "close")
if rh.version == "HTTP/1.0" and not HeaderHasToken(rh, "connection", "keep-alive"): keep_up = false end
if not keep_up: _up_close(up) end
ret ck
end
func _do_connect(cfg: ServerConfig, s: dyn tunnel.Stream, rd &: _Rd, h: Head): bool:
hp := SplitHostPort(h.target, 0)
if not hp.ok or not hp.has_port:
_respond(s, 400, "", "CONNECT needs host:port\n", true)
ret false
end
if not cfg.allow_connect or not cfg.allow("CONNECT", hp.host, hp.port):
_respond(s, 403, "", "forbidden\n", true)
ret false
end
out := _outbound(cfg, hp.host, hp.port)
if not out.ok and out.code == socks.RepNotAllowed:
_respond(s, 403, "", "forbidden\n", true)
ret false
end
if not out.ok:
_respond(s, 502, "", "cannot reach " + hp.host + ":" + str.FromInt(hp.port as i64) + "\n", true)
ret false
end
if not _send(s, "HTTP/1.1 200 Connection established\r\n\r\n"):
out.stream.Close()
ret false
end
_rd_flush_to(rd, out.stream)
socks.Relay(s, out.stream, cfg.relay_idle_ms)
ret true
end
func _conn_thread(arg: i64):
jp := (arg as void*) as _ConnJob*
cfg := jp[0].cfg
c := jp[0].conn
lim := jp[0].limits
mut adm := jp[0].adm
mem.Free(jp as void*)
if cfg.use_tls:
t := tls.WrapServer(c.fd, cfg.tls_config)
if not tls.ConnOk(t):
tunnel.LimitsRelease(lim, adm)
tcp.Close(c)
ret
end
_handle(cfg, tunnel.TlsStream { conn = t }, lim, adm)
else:
tcp.SetNoDelay(c, true)
_handle(cfg, tunnel.TcpStream { conn = c }, lim, adm)
end
tunnel.LimitsRelease(lim, adm)
end
func _bind_host(cfg: ServerConfig): str:
if cfg.bind_host.len() == 0:
ret "127.0.0.1"
end
ret cfg.bind_host
end
func _busy(c: tcp.Conn):
tcp.Write(c, "HTTP/1.1 503 Service Unavailable\r\nRetry-After: 1\r\nConnection: close\r\nContent-Length: 0\r\n\r\n")
tcp.Close(c)
end
func _accept_thread(arg: i64):
jp := (arg as void*) as _AcceptJob*
cfg := jp[0].cfg
lst := jp[0].listener
stop := jp[0].stop
limits := jp[0].limits
mem.Free(jp as void*)
until atomic_load(stop) != 0:
c := tcp.Accept(lst)
if atomic_load(stop) == 0:
if tcp.ConnOk(c): tcp.Close(c) end
else not tcp.ConnOk(c):
sync.SleepMs(5)
else:
adm := tunnel.LimitsEnter(limits, c.fd)
if not adm.ok:
_busy(c)
else:
cj := mem.AllocateZeroed(sizeof(_ConnJob) as u64) as _ConnJob*
cj[0] = _ConnJob { cfg = cfg, conn = c, limits = limits, adm = adm }
if not socks.Go(_conn_thread, cj as void*):
mut failed := adm
tunnel.LimitsRelease(limits, failed)
tcp.Close(c)
mem.Free(cj as void*)
end
end
end
end
tcp.CloseServer(lst)
mem.Free(stop as void*)
end
func _handle(cfg: ServerConfig, s: dyn tunnel.Stream, lim: tunnel.ConnLimits, adm &: tunnel.Admit):
mut rd := _rd_new(s, MaxHeadBytes)
mut up := _Up {}
mut first := true
mut closed := false
until true:
if first:
s.SetDeadline(cfg.handshake_timeout_ms)
else:
s.SetDeadline(cfg.idle_timeout_ms)
end
first = false
mut st := 0
text := _rd_head(rd, MaxHeadBytes, st)
tunnel.LimitsHandshakeDone(lim, adm)
if st != 0:
if st == 2:
_respond(s, 431, "", "request head too large\n", true)
else st == 3:
_respond(s, 400, "", "bad request\n", true)
end
break
end
h := ParseRequestHead(text)
if not h.ok:
_respond(s, 400, "", "bad request: " + h.err + "\n", true)
break
end
s.SetDeadline(cfg.idle_timeout_ms)
if not _auth_ok(cfg, h):
mut n := 0 as i64
kind := _body_kind(h, n)
ka := _keepalive(h) and kind == 0
_respond(s, 407, "Proxy-Authenticate: Basic realm=\"" + cfg.realm + "\"\r\n", "", not ka)
if not ka: break end
continue
end
if h.method == "CONNECT":
closed = _do_connect(cfg, s, rd, h)
break
end
if not _forward(cfg, s, rd, h, up): break end
end
_up_close(up)
_rd_free(rd)
if not closed: s.Close() end
end
@en "NewServerConfig"
@fa "پیکربندی سرور جدید"
pub func NewServerConfig(port: int): ServerConfig:
ret ServerConfig { port = port }
end
@en "AddUser"
@fa "افزودن کاربر"
pub func AddUser(cfg &: ServerConfig, user: str, pass: str):
cfg.users.put(user, pass)
cfg.require_auth = true
end
@en "SetAuth"
@fa "تعیین احراز هویت"
pub func SetAuth(cfg &: ServerConfig, check: func (str, str) bool):
cfg.auth = check
cfg.has_auth = true
cfg.require_auth = true
end
@en "SetConnector"
@fa "تعیین اتصال به مقصد"
pub func SetConnector(cfg &: ServerConfig, connect: func (str, int) socks.Outbound):
cfg.connect = connect
cfg.has_connect = true
end
@en "SetPolicy"
@fa "تعیین سیاست مقصد"
pub func SetPolicy(cfg &: ServerConfig, p: tunnel.DestPolicy):
cfg.policy = p
end
@en "AllowPrivate"
@fa "اجازه آدرس‌های خصوصی"
pub func AllowPrivate(cfg &: ServerConfig, enabled: bool):
cfg.policy.allow_private = enabled
end
@en "SetTLS"
@fa "تعیین تی ال اس"
pub func SetTLS(cfg &: ServerConfig, cert_file: str, key_file: str): bool:
cfg.tls_config = tls.NewServerConfig(cert_file, key_file)
cfg.use_tls = true
ret cfg.tls_config.ok
end
@en "Handle"
@fa "رسیدگی"
pub func Handle(cfg: ServerConfig, s: dyn tunnel.Stream):
mut adm := tunnel.Admit { done = true }
_handle(cfg, s, tunnel.ConnLimits {}, adm)
end
@en "Start"
@fa "شروع"
pub func Start(cfg: ServerConfig): Server:
mut sv := Server {}
if cfg.use_tls and not cfg.tls_config.ok: ret sv end
ls := tcp.BindOn(_bind_host(cfg), cfg.port)
if not tcp.Ok(ls): ret sv end
stop := mem.AllocateZeroed(8 as u64) as i64*
atomic_store(stop, 1 as i64)
jb := mem.AllocateZeroed(sizeof(_AcceptJob) as u64) as _AcceptJob*
jb[0] = _AcceptJob { cfg = cfg, listener = ls, stop = stop, limits = tunnel.NewConnLimits(cfg.max_connections, cfg.max_per_source, cfg.handshake_deadline_ms) }
sv.ok = true
sv.port = tcp.Port(ls)
sv.host = _bind_host(cfg)
sv.listener = ls
sv.stop_cell = stop
socks.Go(_accept_thread, jb as void*)
ret sv
end
@en "Stop"
@fa "توقف"
pub func Stop(sv: Server):
if not sv.ok: ret end
atomic_store(sv.stop_cell, 0 as i64)
rawsock.Shutdown(rawsock.FromFd(sv.listener.fd))
tcp.WakeServer(sv.host, sv.port)
end
@en "Serve"
@fa "خدمت‌رسانی"
pub func Serve(cfg: ServerConfig): bool:
sv := Start(cfg)
if not sv.ok: ret false end
until sv.ok:
sync.SleepMs(1000)
end
ret true
end
@en "net/internal/errors"
@fa "خطاها"
package errors
@en "KindNone"
@fa "نوع بدون خطا"
pub const KindNone := 0
@en "KindTimeout"
@fa "اتمام مهلت"
pub const KindTimeout := 1
@en "KindConnectionRefused"
@fa "اتصال رد شد"
pub const KindConnectionRefused := 2
@en "KindConnectionReset"
@fa "بازنشانی اتصال"
pub const KindConnectionReset := 3
@en "KindHostUnreachable"
@fa "میزبان غیرقابل دسترس"
pub const KindHostUnreachable := 4
@en "KindAddressInUse"
@fa "نشانی در حال استفاده"
pub const KindAddressInUse := 5
@en "KindProtocolError"
@fa "خطای پروتکل"
pub const KindProtocolError := 6
@en "KindDNSFailure"
@fa "خطای دی ان اس"
pub const KindDNSFailure := 7
@en "KindWouldBlock"
@fa "مسدود می‌شد"
pub const KindWouldBlock := 8
@en "KindClosed"
@fa "بسته شده"
pub const KindClosed := 9
@en "KindInvalidArgument"
@fa "آرگومان نامعتبر"
pub const KindInvalidArgument := 10
@en "NetError"
@fa "خطای شبکه"
pub struct NetError:
pub kind: int = 0
pub message: str = ""
pub sys_errno: int = 0
end
@en "None"
@fa "بدون خطا"
pub func None(): NetError:
ret NetError { kind = KindNone, message = "", sys_errno = 0 }
end
@en "New"
@fa "خطای جدید"
pub func New(kind: int, message: str): NetError:
ret NetError { kind = kind, message = message, sys_errno = 0 }
end
@en "NewSys"
@fa "خطای سیستمی جدید"
pub func NewSys(kind: int, message: str, sys_errno: int): NetError:
ret NetError { kind = kind, message = message, sys_errno = sys_errno }
end
@en "IsError"
@fa "خطا است"
pub func IsError(e: NetError): bool:
ret e.kind != KindNone
end
@en "IsTimeout"
@fa "اتمام مهلت است"
pub func IsTimeout(e: NetError): bool:
ret e.kind == KindTimeout
end
@en "IsRefused"
@fa "رد شده است"
pub func IsRefused(e: NetError): bool:
ret e.kind == KindConnectionRefused
end
@en "IsClosed"
@fa "بسته شده است"
pub func IsClosed(e: NetError): bool:
ret e.kind == KindClosed
end
@en "IsWouldBlock"
@fa "در حال مسدودشدن است"
pub func IsWouldBlock(e: NetError): bool:
ret e.kind == KindWouldBlock
end
@en "KindName"
@fa "نام نوع خطا"
pub func KindName(kind: int): str:
if kind == KindNone: ret "none" end
if kind == KindTimeout: ret "timeout" end
if kind == KindConnectionRefused: ret "connection_refused" end
if kind == KindConnectionReset: ret "connection_reset" end
if kind == KindHostUnreachable: ret "host_unreachable" end
if kind == KindAddressInUse: ret "address_in_use" end
if kind == KindProtocolError: ret "protocol_error" end
if kind == KindDNSFailure: ret "dns_failure" end
if kind == KindWouldBlock: ret "would_block" end
if kind == KindClosed: ret "closed" end
if kind == KindInvalidArgument: ret "invalid_argument" end
ret "unknown"
end
@en "String"
@fa "متن"
pub func String(e: NetError): str:
if e.kind == KindNone: ret "" end
ret KindName(e.kind) + ": " + e.message
end
@en "internal"
@fa "داخلی"
package internal
@en "net/internal/netbuf"
@fa "بافر"
package netbuf
import mem
import compress
@en "Buffer"
@fa "بافر"
pub struct Buffer:
pub data: compress.ByteBuf = compress.ByteBuf {}
pub r: int = 0
end
@en "New"
@fa "بافر جدید"
pub func New(): Buffer:
mut b := Buffer {}
b.data = compress.NewByteBuf()
ret b
end
@en "NewCap"
@fa "بافر جدید با ظرفیت"
pub func NewCap(capacity: int): Buffer:
mut b := Buffer {}
b.data = compress.NewByteBufCap(capacity)
ret b
end
@en "Free"
@fa "آزادسازی بافر"
pub func Free(b &: Buffer):
compress.BufFree(b.data)
b.r = 0
end
@en "Reset"
@fa "بازنشانی بافر"
pub func Reset(b &: Buffer):
compress.BufReset(b.data)
b.r = 0
end
@en "WriteBytes"
@fa "نوشتن بایت‌ها"
pub func WriteBytes(b &: Buffer, p: void*, n: int):
compress.BufPushBytes(b.data, p, n)
end
@en "WriteStr"
@fa "نوشتن رشته"
pub func WriteStr(b &: Buffer, s: str):
compress.BufPushBytes(b.data, s as void*, s.len())
end
@en "WriteBuf"
@fa "نوشتن بافر"
pub func WriteBuf(b &: Buffer, src: compress.ByteBuf):
compress.BufPushBuf(b.data, src)
end
@en "Unread"
@fa "بایت‌های خوانده‌نشده"
pub func Unread(b: Buffer): int:
ret b.data.len - b.r
end
@en "Available"
@fa "ظرفیت باقی‌مانده"
pub func Available(b: Buffer): int:
ret b.data.cap - b.data.len
end
@en "Peek"
@fa "پیش‌نمایش بدون مصرف"
pub func Peek(b: Buffer, n: int): compress.ByteBuf:
mut take := n
avail := Unread(b)
if take > avail: take = avail end
if take < 0: take = 0 end
mut out := compress.NewByteBufCap(take)
if take > 0:
src := (b.data.data as i64 + b.r) as void*
compress.BufPushBytes(out, src, take)
end
ret out
end
@en "ReadN"
@fa "خواندن بایت‌ها"
pub func ReadN(b &: Buffer, n: int): compress.ByteBuf:
out := Peek(b, n)
b.r += out.len
ret out
end
@en "Consume"
@fa "مصرف بایت‌ها"
pub func Consume(b &: Buffer, n: int):
mut c := n
avail := Unread(b)
if c > avail: c = avail end
if c < 0: c = 0 end
b.r += c
end
@en "Compact"
@fa "فشرده‌سازی بافر"
pub func Compact(b &: Buffer):
if b.r == 0: ret end
remaining := b.data.len - b.r
if remaining > 0:
dst := b.data.data
src := (b.data.data as i64 + b.r) as void*
mem.MemMove(dst, src, remaining as u64)
end
b.data.len = remaining
b.r = 0
end
@en "net/internal/nettls"
@fa "لایه تی ال اس"
package nettls
import tls
@en "NewConfig"
