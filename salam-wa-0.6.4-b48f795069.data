@en "Close"
@fa "بستن"
pub func Close(s: Socket):
rawsock.Close(_sock(s))
end
@en "Send"
@fa "ارسال"
pub func Send(s: Socket, host: str, port: int, data: str): int:
ret rawsock.SendTo(_sock(s), host, port, data)
end
@en "SendTo"
@fa "ارسال به"
pub func SendTo(s: Socket, host: str, port: int, data: str): int:
ret rawsock.SendTo(_sock(s), host, port, data)
end
@en "SendBytes"
@fa "ارسال بایت"
pub func SendBytes(s: Socket, host: str, port: int, ptr: void*, n: int): int:
ret rawsock.SendToBytes(_sock(s), host, port, ptr, n)
end
@en "Receive"
@fa "دریافت"
pub func Receive(s: Socket, max: int): Packet:
mut p := Packet {}
mut fh := ""
mut fp := 0
p.data = rawsock.RecvFrom(_sock(s), max, fh, fp)
p.from_host = fh
p.from_port = fp
ret p
end
@en "ReceiveBytes"
@fa "دریافت بایت"
pub func ReceiveBytes(s: Socket, buf: void*, max: int, out_host &: str, out_port &: int): int:
ret rawsock.RecvFromBytes(_sock(s), buf, max, out_host, out_port)
end
@en "SetBroadcast"
@fa "فعال‌سازی پخش"
pub func SetBroadcast(s: Socket, enable: bool):
rawsock.SetBroadcast(_sock(s), enable)
end
@en "SetTimeout"
@fa "تنظیم زمان انتظار"
pub func SetTimeout(s: Socket, millis: int):
rawsock.SetTimeout(_sock(s), millis)
end
@en "JoinMulticast"
@fa "پیوستن به گروه پخش"
pub func JoinMulticast(s: Socket, group_ip: str): bool:
group := rawsock.ResolveAddr4Raw(group_ip)
if group == 0: ret false end
mreq := _make_mreq(group, 0)
defer mem.Free(mreq)
r := rawsock.SetOpt(_sock(s), 0, _mcast_optname(true), mreq, 8)
ret r == 0
end
@en "LeaveMulticast"
@fa "ترک گروه پخش"
pub func LeaveMulticast(s: Socket, group_ip: str): bool:
group := rawsock.ResolveAddr4Raw(group_ip)
if group == 0: ret false end
mreq := _make_mreq(group, 0)
defer mem.Free(mreq)
r := rawsock.SetOpt(_sock(s), 0, _mcast_optname(false), mreq, 8)
ret r == 0
end
@en "net/utls"
@fa "اثر انگشت تی ال اس"
package utls
import mem
import crypto
import tls
import str
const _SID_OFFSET := 39
const _GREASE_BASE := 0x10000
const _PAD_TOKEN := 0x20000
const _EXT_ECH := 0xFE0D
struct _Ctx:
pub g0: int = 0
pub g1: int = 0
pub g2: int = 0
pub g3: int = 0
pub g4: int = 0
end
@en "Bytes"
@fa "بایت‌ها"
pub struct Bytes:
@en "p"
@fa "نشانگر"
pub p: void* = null
@en "len"
@fa "طول"
pub len: int = 0
@en "cap"
@fa "ظرفیت"
pub cap: int = 0
end
@en "Spec"
@fa "مشخصات"
pub struct Spec:
@en "name"
@fa "نام"
pub name: str = ""
@en "ciphers"
@fa "رمزها"
pub ciphers: str = ""
@en "extensions"
@fa "افزونه‌ها"
pub extensions: str = ""
@en "groups"
@fa "گروه‌ها"
pub groups: str = ""
@en "key_shares"
@fa "سهم کلیدها"
pub key_shares: str = ""
@en "sigalgs"
@fa "الگوریتم‌های امضا"
pub sigalgs: str = ""
@en "versions"
@fa "نسخه‌ها"
pub versions: str = ""
@en "alpn"
@fa "پروتکل برنامه"
pub alpn: str = ""
@en "cert_compress"
@fa "فشرده‌سازی گواهی"
pub cert_compress: str = ""
@en "delegated"
@fa "اعتبارنامه تفویضی"
pub delegated: str = ""
@en "record_size_limit"
@fa "حد اندازه رکورد"
pub record_size_limit: int = 0
@en "pad_to"
@fa "اندازه پرکننده"
pub pad_to: int = 0
@en "randomize"
@fa "تصادفی سازی"
pub randomize: bool = false
@en "ok"
@fa "معتبر"
pub ok: bool = false
end
@en "Options"
@fa "گزینه‌ها"
pub struct Options:
@en "server_name"
@fa "نام کارساز"
pub server_name: str = ""
@en "alpn"
@fa "پروتکل برنامه"
pub alpn: str = ""
@en "shuffle"
@fa "بر زدن افزونه‌ها"
pub shuffle: bool = false
@en "pq"
@fa "کلید پسا کوانتومی"
pub pq: bool = true
@en "ech"
@fa "گریس اکو"
pub ech: bool = true
@en "padding"
@fa "پرکننده"
pub padding: bool = true
end
@en "Hello"
@fa "سلام کارخواه"
pub struct Hello:
@en "raw"
@fa "خام"
pub raw: Bytes = Bytes {}
@en "priv"
@fa "کلید خصوصی"
pub priv: Bytes = Bytes {}
@en "pub_key"
@fa "کلید عمومی"
pub pub_key: Bytes = Bytes {}
@en "pq_seed"
@fa "بذر پسا کوانتومی"
pub pq_seed: Bytes = Bytes {}
@en "pq_ek"
@fa "کلید عمومی پسا کوانتومی"
pub pq_ek: Bytes = Bytes {}
@en "ok"
@fa "معتبر"
pub ok: bool = false
@en "err"
@fa "خطا"
pub err: str = ""
end
func _nb(cap0: int): Bytes:
mut c := cap0
if c < 64:
c = 64
end
ret Bytes { p = mem.AllocateZeroed(c as u64), len = 0, cap = c }
end
func _grow(b &: Bytes, need: int):
if b.len + need <= b.cap:
ret
end
mut c := b.cap * 2
if c < b.len + need:
c = b.len + need
end
b.p = mem.Reallocate(b.p, c as u64)
b.cap = c
end
func _p8(b &: Bytes, v: int):
_grow(b, 1)
bp := b.p as u8*
bp[b.len] = (v & 0xFF) as u8
b.len++
end
func _p16(b &: Bytes, v: int):
_p8(b, v >> 8)
_p8(b, v)
end
func _p24(b &: Bytes, v: int):
_p8(b, v >> 16)
_p16(b, v)
end
func _praw(b &: Bytes, src: void*, n: int):
_grow(b, n)
mem.Copy(((b.p as i64) + (b.len as i64)) as void*, src, n as u64)
b.len += n
end
func _prand(b &: Bytes, n: int):
_grow(b, n)
crypto.RandomBytes(((b.p as i64) + (b.len as i64)) as void*, n)
b.len += n
end
func _patch16(b &: Bytes, off: int, v: int):
bp := b.p as u8*
bp[off] = ((v >> 8) & 0xFF) as u8
bp[off + 1] = (v & 0xFF) as u8
end
func _patch24(b &: Bytes, off: int, v: int):
bp := b.p as u8*
bp[off] = ((v >> 16) & 0xFF) as u8
bp[off + 1] = ((v >> 8) & 0xFF) as u8
bp[off + 2] = (v & 0xFF) as u8
end
func _at(b: Bytes, i: int): int:
bp := b.p as u8*
ret bp[i] as int
end
func _randbyte(): int:
p := mem.Allocate(8 as u64)
crypto.RandomBytes(p, 1)
bp := p as u8*
v := bp[0] as int
mem.Free(p)
ret v
end
func _grease_val(): int:
b := (_randbyte() & 0xF0) | 0x0A
ret (b << 8) | b
end
func _ctx_new(): _Ctx:
mut c := _Ctx {}
c.g0 = _grease_val()
c.g1 = _grease_val()
c.g2 = _grease_val()
c.g3 = _grease_val()
c.g4 = _grease_val()
if c.g4 == c.g1:
c.g4 ^= 0x1010
end
ret c
end
func _grease(c: _Ctx, slot: int): int:
if slot == 0:
ret c.g0
end
if slot == 1:
ret c.g1
end
if slot == 2:
ret c.g2
end
if slot == 3:
ret c.g3
end
ret c.g4
end
func _hexval(ch: int): int:
if ch >= 48 and ch <= 57:
ret ch - 48
end
if ch >= 97 and ch <= 102:
ret ch - 87
end
if ch >= 65 and ch <= 70:
ret ch - 55
end
ret 0 - 1
end
func _tokens(s: str): Vector<int>:
mut out := Vector {} as Vector<int>
n := s.len()
bp := s as u8*
mut i := 0
until i < n:
ch := bp[i] as int
if ch == 32 or ch == 44:
i++
continue
end
mut j := i
until j < n and bp[j] as int != 32 and bp[j] as int != 44:
j++
end
first := bp[i] as int
if first == 103 and j - i == 2:
out.push(_GREASE_BASE + ((bp[i + 1] as int) - 48))
else if first == 112 and j - i == 3:
out.push(_PAD_TOKEN)
else:
mut v := 0
mut k := i
until k < j:
v = (v << 4) | _hexval(bp[k] as int)
k++
end
out.push(v)
end
i = j
end
ret out
end
func _resolve(c: _Ctx, t: int): int:
if t >= _PAD_TOKEN:
ret t
end
if t >= _GREASE_BASE:
ret _grease(c, t - _GREASE_BASE)
end
ret t
end
func _put_list16(out &: Bytes, c: _Ctx, s: str, grease_on: bool, pq: bool):
mut v := _tokens(s)
defer v.free()
mark := out.len
_p16(out, 0)
repeat v.len() in i:
t := v.get(i)
if t >= _GREASE_BASE and not grease_on:
continue
end
if not pq and (t == 0x11EC or t == 0x6399):
continue
end
_p16(out, _resolve(c, t))
end
_patch16(out, mark, out.len - mark - 2)
end
func _ext_head(out &: Bytes, id: int): int:
_p16(out, id)
_p16(out, 0)
ret out.len
end
func _ext_done(out &: Bytes, mark: int):
_patch16(out, mark - 2, out.len - mark)
end
func _put_alpn(out &: Bytes, list: str):
mut start := 0
n := list.len()
bp := list as u8*
mark := out.len
_p16(out, 0)
mut i := 0
until i <= n:
if i == n or (bp[i] as int) == 44:
if i > start:
_p8(out, i - start)
_praw(out, (((list as void*) as i64) + (start as i64)) as void*, i - start)
end
start = i + 1
end
i++
end
_patch16(out, mark, out.len - mark - 2)
end
func _pq_ek(out &: Bytes, ek: Bytes):
_praw(out, ek.p, 1184)
end
func _put_ext(out &: Bytes, id: int, c: _Ctx, sp: Spec, o: Options, pub_key: Bytes, pq_ek: Bytes, grease_on: bool): bool:
if id == 0:
if o.server_name.len() == 0:
ret false
end
m := _ext_head(out, 0)
_p16(out, o.server_name.len() + 3)
_p8(out, 0)
_p16(out, o.server_name.len())
_praw(out, o.server_name as void*, o.server_name.len())
_ext_done(out, m)
ret true
end
if id == 5:
m := _ext_head(out, 5)
_p8(out, 1)
_p16(out, 0)
_p16(out, 0)
_ext_done(out, m)
ret true
end
if id == 10:
m := _ext_head(out, 10)
_put_list16(out, c, sp.groups, grease_on, o.pq)
_ext_done(out, m)
ret true
end
if id == 11:
m := _ext_head(out, 11)
_p8(out, 1)
_p8(out, 0)
_ext_done(out, m)
ret true
end
if id == 13:
m := _ext_head(out, 13)
_put_list16(out, c, sp.sigalgs, grease_on, true)
_ext_done(out, m)
ret true
end
if id == 16:
mut list := sp.alpn
if o.alpn.len() > 0:
list = o.alpn
end
if list == "none" or list.len() == 0:
ret false
end
m := _ext_head(out, 16)
_put_alpn(out, list)
_ext_done(out, m)
ret true
end
if id == 18 or id == 35 or id == 23 or id == 49:
m := _ext_head(out, id)
_ext_done(out, m)
ret true
end
if id == 27:
mut v := _tokens(sp.cert_compress)
defer v.free()
m := _ext_head(out, 27)
_p8(out, v.len() * 2)
repeat v.len() in i:
_p16(out, v.get(i))
end
_ext_done(out, m)
ret true
end
if id == 28:
m := _ext_head(out, 28)
_p16(out, sp.record_size_limit)
_ext_done(out, m)
ret true
end
if id == 34:
m := _ext_head(out, 34)
_put_list16(out, c, sp.delegated, false, true)
_ext_done(out, m)
ret true
end
if id == 43:
mut v := _tokens(sp.versions)
defer v.free()
m := _ext_head(out, 43)
mark := out.len
_p8(out, 0)
repeat v.len() in i:
t := v.get(i)
if t >= _GREASE_BASE and not grease_on:
continue
end
_p16(out, _resolve(c, t))
end
bp := out.p as u8*
bp[mark] = (out.len - mark - 1) as u8
_ext_done(out, m)
ret true
end
if id == 45:
m := _ext_head(out, 45)
_p8(out, 1)
_p8(out, 1)
_ext_done(out, m)
ret true
end
if id == 51:
mut v := _tokens(sp.key_shares)
defer v.free()
m := _ext_head(out, 51)
mark := out.len
_p16(out, 0)
repeat v.len() in i:
t := v.get(i)
if t >= _GREASE_BASE:
if grease_on:
_p16(out, _resolve(c, t))
_p16(out, 1)
_p8(out, 0)
end
else if t == 0x001D:
_p16(out, 0x001D)
_p16(out, 32)
_praw(out, pub_key.p, 32)
else if t == 0x11EC:
if o.pq:
_p16(out, 0x11EC)
_p16(out, 1184 + 32)
_pq_ek(out, pq_ek)
_praw(out, pub_key.p, 32)
end
else if t == 0x6399:
if o.pq:
_p16(out, 0x6399)
_p16(out, 32 + 1184)
_praw(out, pub_key.p, 32)
_pq_ek(out, pq_ek)
end
else if t == 0x0017:
_p16(out, 0x0017)
_p16(out, 65)
_p8(out, 4)
_prand(out, 64)
end
end
_patch16(out, mark, out.len - mark - 2)
_ext_done(out, m)
ret true
end
if id == 17513 or id == 17613:
m := _ext_head(out, id)
_p16(out, 3)
_p8(out, 2)
_p8(out, 104)
_p8(out, 50)
_ext_done(out, m)
ret true
end
if id == 65281:
m := _ext_head(out, 65281)
_p8(out, 0)
_ext_done(out, m)
ret true
end
if id == _EXT_ECH:
if not o.ech:
ret false
end
m := _ext_head(out, _EXT_ECH)
_p8(out, 0)
_p16(out, 1)
_p16(out, 1)
_p8(out, _randbyte())
_p16(out, 32)
_prand(out, 32)
plen := 144 + 32 * (_randbyte() % 4)
_p16(out, plen)
_prand(out, plen)
_ext_done(out, m)
ret true
end
ret false
end
func _shuffle(v &: Vector<int>, lo: int, hi: int):
mut i := hi
until i > lo:
r := (_randbyte() << 16) | (_randbyte() << 8) | _randbyte()
j := lo + (r % (i - lo + 1))
a := v.get(i)
v.set(i, v.get(j))
v.set(j, a)
i--
end
end
func _is_grease(v: int): bool:
ret (v & 0x0F0F) == 0x0A0A and ((v >> 8) == (v & 0xFF))
end
func _u16(b: Bytes, i: int): int:
ret (_at(b, i) << 8) | _at(b, i + 1)
end
func _join_dec(v: Vector<int>): str:
mut parts := Vector {} as Vector<str>
defer parts.free()
repeat v.len() in i:
parts.push(str.FromInt(v.get(i) as i64))
end
ret str.Join(parts, "-")
end
@en "JA3"
@fa "جی ای سه"
pub func JA3(b: Bytes): str:
if b.len < 43 or _at(b, 0) != 1:
ret ""
end
mut o := 4
ver := _u16(b, o)
o += 2 + 32
o += 1 + _at(b, o)
nc := _u16(b, o)
o += 2
mut ciphers := Vector {} as Vector<int>
defer ciphers.free()
mut i := 0
until i < nc:
v := _u16(b, o + i)
if not _is_grease(v):
ciphers.push(v)
end
i += 2
end
o += nc
o += 1 + _at(b, o)
mut el := _u16(b, o)
o += 2
end_at := o + el
mut exts := Vector {} as Vector<int>
mut groups := Vector {} as Vector<int>
mut points := Vector {} as Vector<int>
defer exts.free()
defer groups.free()
defer points.free()
until o + 4 <= end_at:
id := _u16(b, o)
l := _u16(b, o + 2)
body := o + 4
if not _is_grease(id):
exts.push(id)
if id == 10:
n := _u16(b, body)
mut j := 0
until j < n:
g := _u16(b, body + 2 + j)
if not _is_grease(g):
groups.push(g)
end
j += 2
end
else if id == 11:
n := _at(b, body)
repeat n in j:
points.push(_at(b, body + 1 + j))
end
end
end
o = body + l
end
el = 0
ret str.FromInt(ver as i64) + "," + _join_dec(ciphers) + "," + _join_dec(exts) + "," + _join_dec(groups) + "," + _join_dec(points)
end
@en "FreeBytes"
@fa "آزادسازی بایت‌ها"
pub func FreeBytes(b &: Bytes):
if b.p != null:
mem.Free(b.p)
end
b.p = null
b.len = 0
b.cap = 0
end
@en "FreeHello"
@fa "آزادسازی سلام"
pub func FreeHello(h &: Hello):
FreeBytes(h.raw)
FreeBytes(h.priv)
FreeBytes(h.pub_key)
if h.pq_seed.p != null:
mem.Set(h.pq_seed.p, 0, h.pq_seed.len as u64)
end
FreeBytes(h.pq_seed)
FreeBytes(h.pq_ek)
end
@en "ToHex"
@fa "به شانزدهی"
pub func ToHex(b: Bytes): str:
digits := "0123456789abcdef"
mut sb := Vector {} as Vector<str>
defer sb.free()
bp := b.p as u8*
repeat b.len in i:
v := bp[i] as int
sb.push(str.Substr(digits, v >> 4, 1) + str.Substr(digits, v & 15, 1))
end
ret str.Join(sb, "")
end
@en "SessionIdOffset"
@fa "جایگاه شناسه نشست"
pub func SessionIdOffset(): int:
ret _SID_OFFSET
end
@en "SetSessionId"
@fa "تنظیم شناسه نشست"
pub func SetSessionId(h &: Hello, sid: void*):
mem.Copy(((h.raw.p as i64) + (_SID_OFFSET as i64)) as void*, sid, 32 as u64)
end
@en "Build"
@fa "ساخت"
pub func Build(sp: Spec, o: Options): Hello:
mut h := Hello {}
if not sp.ok:
h.err = "unknown fingerprint profile"
ret h
end
c := _ctx_new()
grease_on := sp.randomize or sp.ciphers.len() > 0
h.priv = _nb(32)
_prand(h.priv, 32)
h.pub_key = _nb(32)
_p16(h.pub_key, 0)
h.pub_key.len = 0
h.pub_key.len = 32
tls.X25519Public(h.priv.p, h.pub_key.p)
h.pq_ek = _nb(1184)
if o.pq:
h.pq_seed = _nb(64)
_prand(h.pq_seed, 64)
tls.Mlkem768PublicKey(h.pq_seed.p, h.pq_ek.p)
h.pq_ek.len = 1184
end
mut out := _nb(2048)
_p8(out, 1)
_p24(out, 0)
_p16(out, 0x0303)
_prand(out, 32)
_p8(out, 32)
_prand(out, 32)
mut cs := _tokens(sp.ciphers)
defer cs.free()
if sp.randomize and cs.len() > 2:
first := cs.get(0)
if first >= _GREASE_BASE:
_shuffle(cs, 1, cs.len() - 1)
else:
_shuffle(cs, 0, cs.len() - 1)
end
end
cmark := out.len
_p16(out, 0)
repeat cs.len() in i:
_p16(out, _resolve(c, cs.get(i)))
end
_patch16(out, cmark, out.len - cmark - 2)
_p8(out, 1)
_p8(out, 0)
mut ids := _tokens(sp.extensions)
defer ids.free()
if o.shuffle or sp.randomize:
mut lo := 0
mut hi := ids.len() - 1
if ids.len() > 0 and ids.get(0) >= _GREASE_BASE:
lo = 1
end
if hi >= 0 and ids.get(hi) == _PAD_TOKEN:
hi--
end
if hi >= 0 and ids.get(hi) >= _GREASE_BASE:
hi--
end
if hi > lo:
_shuffle(ids, lo, hi)
end
end
emark := out.len
_p16(out, 0)
mut pad_at := 0 - 1
repeat ids.len() in i:
t := ids.get(i)
if t == _PAD_TOKEN:
pad_at = out.len
continue
end
if t >= _GREASE_BASE:
if grease_on:
m := _ext_head(out, _grease(c, t - _GREASE_BASE))
if t - _GREASE_BASE == 4:
_p8(out, 0)
end
_ext_done(out, m)
end
continue
end
_put_ext(out, t, c, sp, o, h.pub_key, h.pq_ek, grease_on)
end
if pad_at >= 0 and o.padding and sp.pad_to > 0:
total := out.len
if total > 255 and total < sp.pad_to:
mut padlen := sp.pad_to - total
if padlen >= 5:
padlen -= 4
else:
padlen = 1
end
_p16(out, 21)
_p16(out, padlen)
repeat padlen:
_p8(out, 0)
end
end
end
_patch16(out, emark, out.len - emark - 2)
_patch24(out, 1, out.len - 4)
h.raw = out
h.ok = true
ret h
end
@en "Profile"
@fa "نمایه"
pub func Profile(name: str): Spec:
mut s := Spec {}
s.name = name
if name == "chrome" or name == "edge" or name == "chrome_auto" or name == "randomized":
s.ciphers = "g0 1301 1302 1303 c02b c02f c02c c030 cca9 cca8 c013 c014 009c 009d 002f 0035"
s.extensions = "g1 0000 0017 ff01 000a 000b 0023 0010 0005 000d 0012 0033 002d 002b 001b 4469 fe0d g4 pad"
s.groups = "g2 11ec 001d 0017 0018"
s.key_shares = "g2 11ec 001d"
s.sigalgs = "0403 0804 0401 0503 0805 0501 0806 0601"
s.versions = "g3 0304 0303"
s.alpn = "h2,http/1.1"
s.cert_compress = "0002"
s.pad_to = 512
s.randomize = name == "randomized"
s.ok = true
ret s
end
if name == "chrome_120":
s.ciphers = "g0 1301 1302 1303 c02b c02f c02c c030 cca9 cca8 c013 c014 009c 009d 002f 0035"
s.extensions = "g1 0000 0017 ff01 000a 000b 0023 0010 0005 000d 0012 0033 002d 002b 001b 4469 g4 pad"
s.groups = "g2 001d 0017 0018"
s.key_shares = "g2 001d"
s.sigalgs = "0403 0804 0401 0503 0805 0501 0806 0601"
s.versions = "g3 0304 0303"
s.alpn = "h2,http/1.1"
s.cert_compress = "0002"
s.pad_to = 512
s.ok = true
ret s
end
if name == "firefox":
s.ciphers = "1301 1303 1302 c02b c02f cca9 cca8 c02c c030 c00a c009 c013 c014 009c 009d 002f 0035"
s.extensions = "0000 0017 ff01 000a 000b 0023 0010 0005 0022 0033 002b 000d 002d 001c fe0d pad"
s.groups = "11ec 001d 0017 0018 0019 0100 0101"
s.key_shares = "11ec 001d 0017"
s.sigalgs = "0403 0503 0603 0804 0805 0806 0401 0501 0601 0203 0201"
s.delegated = "0403 0503 0603 0203"
s.versions = "0304 0303"
s.alpn = "h2,http/1.1"
s.record_size_limit = 0x4001
s.pad_to = 512
s.ok = true
ret s
end
if name == "safari" or name == "ios":
s.ciphers = "g0 1301 1302 1303 c02c c02b cca9 c030 c02f cca8 c00a c009 c014 c013 009d 009c 003d 003c 0035 002f c008 c012 000a"
s.extensions = "g1 0000 0017 ff01 000a 000b 0010 0005 000d 0012 0033 002d 002b 001b g4 pad"
s.groups = "g2 11ec 001d 0017 0018 0019"
s.key_shares = "g2 11ec 001d"
s.sigalgs = "0403 0804 0401 0503 0203 0805 0805 0501 0806 0601 0201"
s.versions = "g3 0304 0303 0302 0301"
s.alpn = "h2,http/1.1"
s.cert_compress = "0001"
s.pad_to = 512
s.ok = true
ret s
end
ret s
end
@en "ProfileNames"
@fa "نام نمایه‌ها"
pub func ProfileNames(): str:
ret "chrome,edge,firefox,safari,ios,randomized"
end
@en "LegacyProfileNames"
@fa "نام نمایه‌های قدیمی"
pub func LegacyProfileNames(): str:
ret "chrome_120"
end
@en "Record"
@fa "رکورد"
pub func Record(h: Hello): Bytes:
mut r := _nb(h.raw.len + 5)
_p8(r, 22)
_p16(r, 0x0301)
_p16(r, h.raw.len)
_praw(r, h.raw.p, h.raw.len)
ret r
end
@en "PqSeed"
@fa "بذر پسا کوانتومی سلام"
pub func PqSeed(h: Hello): void*:
if h.pq_seed.len == 64:
ret h.pq_seed.p
end
ret null
end
@en "WrapClient"
@fa "پوشش کارخواه"
pub func WrapClient(fd: i64, sp: Spec, o: Options, cfg: tls.Config): tls.Conn:
mut h := Build(sp, o)
if not h.ok:
mut c := tls.Conn {}
c.err = h.err
ret c
end
conn := tls.WrapClientRawPq(fd, h.raw.p, h.raw.len, h.priv.p, PqSeed(h), null, 0, cfg)
FreeHello(h)
ret conn
end
package vless
import mem
import net.transport
import net.tunnel
struct _Adapter:
pub c: Conn = Conn {}
pub func Read(max: int): str:
buf := mem.Allocate((max + 1) as u64)
n := _read(this.c, buf, max)
if n <= 0:
mem.Free(buf)
ret ""
end
bp := buf as u8*
bp[n] = 0 as u8
ret buf as str
end
pub func ReadBytes(buf: void*, max: int): int:
ret _read(this.c, buf, max)
end
pub func Write(data: str): int:
if not _write(this.c, data as void*, data.len()):
ret 0 - 1
end
ret data.len()
end
pub func WriteBytes(ptr: void*, n: int): int:
if not _write(this.c, ptr, n):
ret 0 - 1
end
ret n
end
pub func SetDeadline(millis: int):
transport.SetReadTimeout(this.c.t, millis)
end
pub func Shutdown():
transport.ShutdownConn(this.c.t)
end
pub func CloseWrite():
transport.CloseWriteConn(this.c.t)
end
pub func Close():
_close(this.c)
end
pub func Ok(): bool:
ret this.c.ok
end
end
func _read(c &: Conn, buf: void*, max: int): int:
ret Read(c, buf, max)
end
func _write(c &: Conn, p: void*, n: int): bool:
ret Write(c, p, n)
end
func _close(c &: Conn):
Close(c)
end
@en "AsStream"
@fa "به عنوان جریان"
pub func AsStream(c: Conn): dyn tunnel.Stream:
ret _Adapter { c = c }
end
@en "DialOver"
@fa "اتصال روی جریان"
pub func DialOver(s: dyn tunnel.Stream, uuid: str, flow: str, command: int, target: transport.Addr): Conn:
ret Client(transport.FromStream(s, true), uuid, flow, command, target)
end
@en "AcceptOver"
@fa "پذیرش روی جریان"
pub func AcceptOver(s: dyn tunnel.Stream, users: Vector<User>): Conn:
ret Accept(transport.FromStream(s, false), users)
end
@en "MuxClient"
@fa "چندگانه ساز کارخواه"
pub func MuxClient(c: Conn): transport.Mux:
ret transport.NewMuxClient(AsStream(c))
end
@en "MuxServer"
@fa "چندگانه ساز کارساز"
pub func MuxServer(c: Conn): transport.Mux:
ret transport.NewMuxServer(AsStream(c))
end
package vless
import mem
import crypto
import rand
import net.transport
@en "FlowVision"
@fa "جریان ویژن"
pub const FlowVision := "xtls-rprx-vision"
@en "VisionContinue"
@fa "فرمان ادامه ویژن"
pub const VisionContinue := 0
@en "VisionEnd"
@fa "فرمان خاتمه ویژن"
pub const VisionEnd := 1
@en "VisionDirect"
@fa "فرمان مستقیم ویژن"
pub const VisionDirect := 2
@en "VisionPaddedPackets"
@fa "بسته های لایه گذاری شده ویژن"
pub const VisionPaddedPackets := 8
const VISION_FRAME := 8192
@en "Vision"
@fa "ویژن"
pub struct Vision:
@en "uuid"
@fa "شناسه"
pub uuid: transport.Bytes = transport.Bytes {}
@en "writes"
@fa "نوشتن ها"
pub writes: int = 0
@en "write_done"
@fa "نوشتن تمام"
pub write_done: bool = false
@en "uuid_sent"
@fa "شناسه فرستاده شد"
pub uuid_sent: bool = false
@en "read_done"
@fa "خواندن تمام"
pub read_done: bool = false
@en "read_raw"
@fa "خواندن خام"
pub read_raw: bool = false
@en "read_init"
@fa "آغاز خواندن"
pub read_init: bool = true
@en "head_left"
@fa "باقی سرآیند"
pub head_left: int = 0
@en "content_left"
@fa "باقی محتوا"
pub content_left: int = 0
@en "pad_left"
@fa "باقی لایه"
pub pad_left: int = 0
@en "command"
@fa "فرمان"
pub command: int = 0
@en "switched"
@fa "تغییر کرد"
pub switched: bool = false
@en "pending"
@fa "معلق"
pub pending: transport.Bytes = transport.Bytes {}
@en "ready"
@fa "آماده"
pub ready: transport.Bytes = transport.Bytes {}
end
@en "NewVision"
@fa "ویژن جدید"
pub func NewVision(uuid: transport.Bytes): Vision:
mut v := Vision {}
v.uuid = transport.NewBytes(16)
transport.PutBytes(v.uuid, uuid)
v.pending = transport.NewBytes(256)
v.ready = transport.NewBytes(256)
ret v
end
@en "FreeVision"
@fa "آزادسازی ویژن"
pub func FreeVision(v &: Vision):
transport.FreeBytes(v.uuid)
transport.FreeBytes(v.pending)
transport.FreeBytes(v.ready)
end
@en "VisionPad"
@fa "لایه گذاری ویژن"
pub func VisionPad(v &: Vision, p: void*, n: int, command: int, long_padding: bool): transport.Bytes:
mut pad := 0
if n < 900 and long_padding:
pad = rand.IntRange(0 as i64, 499 as i64) as int + 900 - n
else:
pad = rand.IntRange(0 as i64, 255 as i64) as int
end
room := VISION_FRAME - 21 - n
if pad > room:
pad = room
end
if pad < 0:
pad = 0
end
mut b := transport.NewBytes(n + pad + 32)
if not v.uuid_sent:
transport.PutBytes(b, v.uuid)
v.uuid_sent = true
end
transport.Put8(b, command)
transport.Put16(b, n)
transport.Put16(b, pad)
transport.PutRaw(b, p, n)
if pad > 0:
transport.Reserve(b, pad)
crypto.RandomBytes(transport.BytesPtr(b, b.len), pad)
b.len += pad
end
ret b
end
@en "VisionUnpad"
@fa "برداشتن لایه ویژن"
pub func VisionUnpad(v &: Vision, p: void*, n: int, out &: transport.Bytes): bool:
if v.read_raw or v.read_done:
transport.PutRaw(out, p, n)
ret true
end
transport.PutRaw(v.pending, p, n)
until true:
if v.read_raw or v.read_done:
transport.PutBytes(out, v.pending)
transport.ResetBytes(v.pending)
break
end
if v.read_init:
if v.pending.len < 21:
break
end
mut head := transport.NewBytes(16)
transport.PutRaw(head, v.pending.p, 16)
same := transport.Equal(head, v.uuid)
transport.FreeBytes(head)
v.read_init = false
if not same:
v.read_raw = true
continue
end
transport.Consume(v.pending, 16)
v.head_left = 5
v.content_left = 0
v.pad_left = 0
v.command = 0
continue
end
if v.head_left == 0 and v.content_left == 0 and v.pad_left == 0:
if v.command == VisionContinue:
v.head_left = 5
else:
v.read_done = true
end
continue
end
if v.pending.len == 0:
break
end
if v.head_left > 0:
pos := 5 - v.head_left
b := transport.At(v.pending, 0)
transport.Consume(v.pending, 1)
if pos == 0:
v.command = b
v.content_left = 0
v.pad_left = 0
else pos == 1:
v.content_left = b << 8
else pos == 2:
v.content_left |= b
else pos == 3:
v.pad_left = b << 8
else:
v.pad_left |= b
end
v.head_left--
continue
end
if v.content_left > 0:
mut take := v.content_left
if take > v.pending.len:
take = v.pending.len
end
transport.PutRaw(out, v.pending.p, take)
transport.Consume(v.pending, take)
v.content_left -= take
continue
end
if v.pad_left > 0:
mut skip := v.pad_left
if skip > v.pending.len:
skip = v.pending.len
end
transport.Consume(v.pending, skip)
v.pad_left -= skip
continue
end
end
ret not out.bad
end
@en "VisionWrite"
@fa "نوشتن ویژن"
pub func VisionWrite(t &: transport.Conn, v &: Vision, p: void*, n: int): bool:
if n <= 0:
ret true
end
if v.write_done:
ret transport.Write(t, p, n)
end
mut off := 0
until off < n:
mut take := n - off
if take > VISION_FRAME - 21:
take = VISION_FRAME - 21
end
if v.write_done:
if not transport.Write(t, ((p as i64) + (off as i64)) as void*, n - off):
ret false
end
ret true
end
v.writes++
mut cmd := VisionContinue
if v.writes >= VisionPaddedPackets:
cmd = VisionEnd
end
mut f := VisionPad(v, ((p as i64) + (off as i64)) as void*, take, cmd, v.writes <= 1)
ok := transport.WriteBytes(t, f)
transport.FreeBytes(f)
if not ok:
ret false
end
if cmd != VisionContinue:
v.write_done = true
end
off += take
end
ret true
end
@en "VisionRead"
@fa "خواندن ویژن"
pub func VisionRead(t &: transport.Conn, v &: Vision, buf: void*, max: int): int:
until true:
if v.ready.len > 0:
mut take := max
if take > v.ready.len:
take = v.ready.len
end
mem.Copy(buf, v.ready.p, take as u64)
transport.Consume(v.ready, take)
ret take
end
if v.read_done and v.command == VisionDirect and not v.switched:
v.switched = true
transport.SwitchDirect(t)
end
scratch := mem.Allocate(16384 as u64)
r := transport.Read(t, scratch, 16384)
if r <= 0:
mem.Free(scratch)
ret r
end
ok := VisionUnpad(v, scratch, r, v.ready)
mem.Free(scratch)
if not ok:
ret 0 - 1
end
end
end
@en "net/vless"
@fa "وی لس"
package vless
import mem
import str
import net.transport
import net.reality
@en "CmdTCP"
@fa "فرمان تی سی پی"
pub const CmdTCP := 1
@en "CmdUDP"
@fa "فرمان یو دی پی"
pub const CmdUDP := 2
@en "CmdMux"
@fa "فرمان مالتی پلکس"
pub const CmdMux := 3
@en "Request"
@fa "درخواست"
pub struct Request:
@en "uuid"
@fa "شناسه"
pub uuid: transport.Bytes = transport.Bytes {}
@en "flow"
@fa "جریان"
pub flow: str = ""
@en "command"
@fa "فرمان"
pub command: int = 1
@en "addr"
@fa "نشانی"
pub addr: transport.Addr = transport.Addr {}
end
@en "User"
@fa "کاربر"
pub struct User:
@en "id"
@fa "شناسه"
pub id: str = ""
@en "uuid"
@fa "بایت های شناسه"
pub uuid: transport.Bytes = transport.Bytes {}
@en "flow"
@fa "جریان"
pub flow: str = ""
end
@en "Link"
@fa "پیوند"
pub struct Link:
@en "ok"
@fa "معتبر"
pub ok: bool = false
@en "err"
@fa "خطا"
pub err: str = ""
@en "uuid"
@fa "شناسه"
pub uuid: str = ""
@en "host"
@fa "میزبان"
pub host: str = ""
@en "port"
@fa "درگاه"
pub port: int = 443
@en "remark"
@fa "برچسب"
pub remark: str = ""
@en "encryption"
@fa "رمزگذاری"
pub encryption: str = "none"
@en "flow"
@fa "جریان"
pub flow: str = ""
@en "security"
@fa "امنیت"
pub security: str = "none"
@en "sni"
@fa "نام سرور"
pub sni: str = ""
@en "alpn"
@fa "الپن"
pub alpn: str = ""
@en "fingerprint"
@fa "اثر انگشت"
pub fingerprint: str = ""
@en "network"
@fa "شبکه"
pub network: str = "tcp"
@en "host_header"
@fa "سربرگ میزبان"
pub host_header: str = ""
@en "path"
@fa "مسیر"
pub path: str = ""
@en "allow_insecure"
@fa "اجازه ناامن"
pub allow_insecure: bool = false
@en "reality"
@fa "ریلیتی"
pub reality: reality.Settings = reality.Settings {}
@en "service_name"
@fa "نام سرویس"
pub service_name: str = ""
@en "grpc_mode"
@fa "حالت جی آر پی سی"
pub grpc_mode: str = "gun"
end
@en "Conn"
@fa "اتصال"
pub struct Conn:
@en "t"
@fa "انتقال"
pub t: transport.Conn = transport.Conn {}
@en "client"
@fa "کارخواه"
pub client: bool = false
@en "ok"
@fa "معتبر"
pub ok: bool = false
@en "err"
@fa "خطا"
pub err: str = ""
@en "req"
@fa "درخواست"
pub req: Request = Request {}
@en "user"
@fa "کاربر"
pub user: str = ""
@en "resp_pending"
@fa "پاسخ معلق"
pub resp_pending: bool = false
@en "closed"
@fa "بسته شده"
pub closed: bool = false
@en "vis_on"
@fa "ویژن روشن"
pub vis_on: bool = false
@en "vis"
@fa "ویژن"
pub vis: Vision = Vision {}
end
func _hexval(c: int): int:
if c >= 48 and c <= 57: ret c - 48 end
if c >= 97 and c <= 102: ret c - 87 end
if c >= 65 and c <= 70: ret c - 55 end
ret 0 - 1
end
func _unreserved(c: int): bool:
if c >= 48 and c <= 57: ret true end
if c >= 65 and c <= 90: ret true end
if c >= 97 and c <= 122: ret true end
ret c == 45 or c == 46 or c == 95 or c == 126
end
func _pct_decode(s: str): str:
mut b := transport.NewBytes(s.len() + 1)
defer transport.FreeBytes(b)
sp := s as u8*
mut i := 0
until i < s.len():
ch := sp[i] as int
if ch == 37 and i + 2 < s.len():
hv := _hexval(sp[i + 1] as int)
lv := _hexval(sp[i + 2] as int)
if hv >= 0 and lv >= 0:
transport.Put8(b, hv * 16 + lv)
i += 3
continue
end
end
transport.Put8(b, ch)
i++
end
transport.Put8(b, 0)
ret str.Clone(b.p as str)
end
func _pct_encode(s: str): str:
mut b := transport.NewBytes(s.len() * 3 + 1)
defer transport.FreeBytes(b)
dg := "0123456789ABCDEF" as u8*
sp := s as u8*
repeat s.len() in i:
ch := sp[i] as int
if _unreserved(ch):
transport.Put8(b, ch)
else:
transport.Put8(b, 37)
transport.Put8(b, dg[ch >> 4] as int)
transport.Put8(b, dg[ch & 15] as int)
end
end
transport.Put8(b, 0)
ret str.Clone(b.p as str)
end
func _query_get(q: str, key: str): str:
mut start := 0
until start < q.len():
mut e := str.IndexFrom(q, "&", start)
if e < 0:
e = q.len()
end
part := q.substr(start, e - start)
eqi := str.Find(part, "=")
if eqi >= 0 and part.substr(0, eqi) == key:
ret _pct_decode(part.substr(eqi + 1, part.len() - eqi - 1))
end
start = e + 1
end
ret ""
end
func _fail(c &: Conn, msg: str):
c.ok = false
c.err = msg
transport.Close(c.t)
end
func _put_packet_len(b &: transport.Bytes, n: int):
transport.Put16(b, n)
end
func _read_response(c &: Conn): bool:
hdr := mem.Allocate(2 as u64) as u8*
defer mem.Free(hdr as void*)
if not transport.ReadFull(c.t, hdr as void*, 2):
_fail(c, "no response header")
ret false
end
if (hdr[0] as int) != 0:
_fail(c, "bad response version")
ret false
end
n := hdr[1] as int
if n > 0:
skip := mem.Allocate(n as u64)
ok := transport.ReadFull(c.t, skip, n)
mem.Free(skip)
if not ok:
_fail(c, "short response header")
ret false
end
end
c.resp_pending = false
ret true
end
@en "EncodeRequest"
@fa "کدگذاری درخواست"
pub func EncodeRequest(r: Request): transport.Bytes:
mut b := transport.NewBytes(64)
transport.Put8(b, 0)
transport.PutBytes(b, r.uuid)
if r.flow.len() > 0:
transport.Put8(b, r.flow.len() + 2)
transport.Put8(b, 0x0a)
transport.Put8(b, r.flow.len())
transport.PutStr(b, r.flow)
else:
transport.Put8(b, 0)
end
transport.Put8(b, r.command)
if r.command != CmdMux:
if not transport.PutAddr(b, r.addr):
b.bad = true
end
end
ret b
end
@en "DecodeRequest"
@fa "کدگشایی درخواست"
pub func DecodeRequest(b: transport.Bytes, r &: Request): int:
if b.len < 19 or transport.At(b, 0) != 0:
ret 0 - 1
end
r.uuid = transport.NewBytes(16)
transport.PutRaw(r.uuid, transport.BytesPtr(b, 1), 16)
n := transport.At(b, 17)
mut off := 18
if off + n + 1 > b.len:
ret 0 - 1
end
r.flow = ""
if n > 0:
if n < 2 or transport.At(b, off) != 0x0a:
ret 0 - 1
end
fl := transport.At(b, off + 1)
if fl + 2 != n:
ret 0 - 1
end
raw := mem.Allocate((fl + 1) as u64)
mem.Copy(raw, transport.BytesPtr(b, off + 2), fl as u64)
rp := raw as u8*
rp[fl] = 0 as u8
r.flow = raw as str
end
off += n
r.command = transport.At(b, off)
off++
if r.command == CmdTCP or r.command == CmdUDP:
mut a := transport.Addr {}
off = transport.ReadAddr(b, off, a)
if off < 0:
ret 0 - 1
end
r.addr = a
else r.command != CmdMux:
ret 0 - 1
end
ret off
end
@en "ReadRequest"
@fa "خواندن درخواست"
pub func ReadRequest(t &: transport.Conn, r &: Request): bool:
mut b := transport.NewBytes(64)
defer transport.FreeBytes(b)
transport.Reserve(b, 560)
if not transport.ReadFull(t, b.p, 18):
ret false
end
b.len = 18
n := transport.At(b, 17)
if not transport.ReadFull(t, transport.BytesPtr(b, 18), n + 1):
ret false
end
b.len = 18 + n + 1
cmd := transport.At(b, 18 + n)
if cmd == CmdTCP or cmd == CmdUDP:
if not transport.ReadFull(t, transport.BytesPtr(b, b.len), 3):
ret false
end
b.len += 3
k := transport.At(b, b.len - 1)
mut more := 0
if k == 1:
more = 4
else k == 3:
more = 16
else k == 2:
if not transport.ReadFull(t, transport.BytesPtr(b, b.len), 1):
ret false
end
b.len++
more = transport.At(b, b.len - 1)
else:
ret false
end
if more > 0 and not transport.ReadFull(t, transport.BytesPtr(b, b.len), more):
ret false
end
b.len += more
else cmd != CmdMux:
ret false
end
ret DecodeRequest(b, r) == b.len
end
@en "NewUser"
@fa "کاربر جدید"
pub func NewUser(uuid: str, flow: str): User:
mut u := User {}
u.id = uuid
u.flow = flow
u.uuid = transport.ParseUUID(uuid)
ret u
end
@en "Client"
@fa "کارخواه"
pub func Client(t: transport.Conn, uuid: str, flow: str, command: int, addr: transport.Addr): Conn:
mut c := Conn {}
c.t = t
c.client = true
mut r := Request {}
r.uuid = transport.ParseUUID(uuid)
if r.uuid.bad:
_fail(c, "bad uuid")
ret c
end
r.flow = flow
r.command = command
r.addr = addr
c.req = r
mut hdr := EncodeRequest(r)
if hdr.bad or not transport.WriteBytes(c.t, hdr):
transport.FreeBytes(hdr)
_fail(c, "could not send the request header")
ret c
end
transport.FreeBytes(hdr)
c.resp_pending = true
if flow == FlowVision and command == CmdTCP:
c.vis = NewVision(r.uuid)
c.vis_on = true
end
c.ok = true
ret c
end
@en "Dial"
@fa "شماره گیری"
pub func Dial(
host: str, port: int, s: transport.Settings, uuid: str, flow: str, command: int, target: transport.Addr
): Conn:
t := transport.Dial(host, port, s)
if not transport.Ok(t):
mut c := Conn {}
c.t = t
c.err = t.err
ret c
end
ret Client(t, uuid, flow, command, target)
end
@en "Accept"
@fa "پذیرش"
pub func Accept(t: transport.Conn, users: Vector<User>): Conn:
mut c := Conn {}
c.t = t
mut r := Request {}
if not ReadRequest(c.t, r):
_fail(c, "bad request header")
ret c
end
mut found := 0 - 1
repeat users.len() in i:
u := users.get(i)
if transport.Equal(u.uuid, r.uuid):
found = i
end
end
if found < 0:
_fail(c, "unknown user")
ret c
end
u := users.get(found)
if r.flow != u.flow and r.flow.len() > 0:
_fail(c, "unsupported flow " + r.flow)
ret c
end
c.req = r
c.user = u.id
if r.flow == FlowVision and r.command == CmdTCP:
c.vis = NewVision(r.uuid)
c.vis_on = true
end
mut resp := transport.NewBytes(2)
transport.Put8(resp, 0)
transport.Put8(resp, 0)
ok := transport.WriteBytes(c.t, resp)
transport.FreeBytes(resp)
if not ok:
_fail(c, "could not send the response header")
ret c
end
c.ok = true
ret c
end
@en "Read"
@fa "خواندن"
pub func Read(c &: Conn, buf: void*, max: int): int:
if not c.ok:
ret 0
end
if c.resp_pending and not _read_response(c):
ret 0 - 1
end
if c.vis_on:
ret VisionRead(c.t, c.vis, buf, max)
end
ret transport.Read(c.t, buf, max)
end
@en "Write"
@fa "نوشتن"
pub func Write(c &: Conn, p: void*, n: int): bool:
if not c.ok:
ret false
end
if c.vis_on:
ret VisionWrite(c.t, c.vis, p, n)
end
ret transport.Write(c.t, p, n)
end
@en "ReadPacket"
@fa "خواندن بسته"
pub func ReadPacket(c &: Conn, out &: transport.Bytes): bool:
if not c.ok:
ret false
end
if c.resp_pending and not _read_response(c):
ret false
end
lb := mem.Allocate(2 as u64) as u8*
defer mem.Free(lb as void*)
if not transport.ReadFull(c.t, lb as void*, 2):
ret false
end
n := (lb[0] as int) * 256 + (lb[1] as int)
if n == 0:
ret true
end
transport.Reserve(out, n)
if not transport.ReadFull(c.t, transport.BytesPtr(out, out.len), n):
ret false
end
out.len += n
ret true
end
@en "WritePacket"
@fa "نوشتن بسته"
pub func WritePacket(c &: Conn, p: void*, n: int): bool:
if not c.ok or n > 65535:
ret false
end
mut b := transport.NewBytes(n + 2)
defer transport.FreeBytes(b)
_put_packet_len(b, n)
transport.PutRaw(b, p, n)
ret transport.WriteBytes(c.t, b)
end
@en "Close"
@fa "بستن"
pub func Close(c &: Conn):
if c.closed:
ret
end
c.closed = true
transport.Close(c.t)
transport.FreeBytes(c.req.uuid)
if c.vis_on:
FreeVision(c.vis)
end
end
@en "ParseLink"
@fa "تجزیه پیوند"
pub func ParseLink(link: str): Link:
mut l := Link {}
if not str.StartsWith(link, "vless://"):
l.err = "not a vless link"
ret l
end
mut rest := link.substr(8, link.len() - 8)
hash := str.Find(rest, "#")
if hash >= 0:
l.remark = _pct_decode(rest.substr(hash + 1, rest.len() - hash - 1))
rest = rest.substr(0, hash)
end
mut query := ""
qm := str.Find(rest, "?")
if qm >= 0:
query = rest.substr(qm + 1, rest.len() - qm - 1)
rest = rest.substr(0, qm)
end
at := str.Find(rest, "@")
if at < 0:
l.err = "missing user id"
ret l
end
l.uuid = _pct_decode(rest.substr(0, at))
mut b := transport.ParseUUID(l.uuid)
defer transport.FreeBytes(b)
if b.bad:
l.err = "bad uuid"
ret l
end
mut hostport := rest.substr(at + 1, rest.len() - at - 1)
if str.EndsWith(hostport, "/"):
hostport = hostport.substr(0, hostport.len() - 1)
end
mut colon := 0 - 1
if hostport.starts_with("["):
close := str.Find(hostport, "]")
if close < 0:
l.err = "bad host"
ret l
end
l.host = hostport.substr(1, close - 1)
if close + 1 < hostport.len() and hostport.substr(close + 1, 1) == ":":
colon = close + 1
end
else:
colon = str.LastIndex(hostport, ":")
if colon >= 0:
l.host = hostport.substr(0, colon)
else:
l.host = hostport
end
end
if colon >= 0:
l.port = hostport.substr(colon + 1, hostport.len() - colon - 1).to_int()
end
if l.host.len() == 0 or l.port <= 0 or l.port > 65535:
l.err = "bad host or port"
ret l
end
enc := _query_get(query, "encryption")
if enc.len() > 0:
l.encryption = enc
end
l.flow = _query_get(query, "flow")
sec := _query_get(query, "security")
if sec.len() > 0:
l.security = sec
end
l.sni = _query_get(query, "sni")
if l.sni.len() == 0:
l.sni = _query_get(query, "peer")
end
l.alpn = _query_get(query, "alpn")
l.fingerprint = _query_get(query, "fp")
nt := _query_get(query, "type")
if nt.len() > 0:
l.network = nt
end
l.host_header = _query_get(query, "host")
l.path = _query_get(query, "path")
l.service_name = _query_get(query, "serviceName")
gm := _query_get(query, "mode")
if gm == "multi":
l.grpc_mode = "multi"
end
mut ai := _query_get(query, "allowInsecure")
if ai.len() == 0:
ai = _query_get(query, "insecure")
end
l.allow_insecure = ai == "1" or ai == "true"
if l.encryption != "none":
l.err = "unsupported encryption " + l.encryption
ret l
end
if l.security == "reality":
l.reality = reality.ParseParams(query)
if not reality.ValidPublicKey(l.reality.public_key):
l.err = "bad reality public key"
ret l
end
if not reality.ValidShortId(l.reality.short_id):
l.err = "bad reality short id"
ret l
end
end
if l.security != "none" and l.security != "tls" and l.security != "reality":
l.err = "unsupported security " + l.security
ret l
end
if l.network != "tcp" and l.network != "ws" and l.network != "httpupgrade" and l.network != "grpc":
l.err = "unsupported transport " + l.network
ret l
end
l.ok = true
ret l
end
@en "FormatLink"
@fa "قالب پیوند"
pub func FormatLink(l: Link): str:
mut host := l.host
if str.Find(host, ":") >= 0:
host = "[" + host + "]"
end
mut q := "encryption=" + _pct_encode(l.encryption)
if l.security == "tls":
q += "&security=tls"
end
if l.flow.len() > 0 and l.security != "reality":
q += "&flow=" + _pct_encode(l.flow)
end
if l.security == "reality":
mut rs := l.reality
if rs.server_name.len() == 0:
rs.server_name = l.sni
end
q += "&" + reality.FormatParams(rs)
end
if l.sni.len() > 0 and l.security != "reality":
q += "&sni=" + _pct_encode(l.sni)
end
if l.alpn.len() > 0:
q += "&alpn=" + _pct_encode(l.alpn)
end
if l.fingerprint.len() > 0 and l.security != "reality":
q += "&fp=" + _pct_encode(l.fingerprint)
end
if l.allow_insecure:
q += "&allowInsecure=1"
end
q += "&type=" + l.network
if l.host_header.len() > 0:
q += "&host=" + _pct_encode(l.host_header)
end
if l.path.len() > 0:
q += "&path=" + _pct_encode(l.path)
end
if l.service_name.len() > 0:
q += "&serviceName=" + _pct_encode(l.service_name)
end
if l.network == "grpc" and l.grpc_mode == "multi":
q += "&mode=multi"
end
mut out := "vless://" + l.uuid + "@" + host + ":" + str.FromInt(l.port as i64) + "?" + q
if l.remark.len() > 0:
out += "#" + _pct_encode(l.remark)
end
ret out
end
@en "LinkSettings"
@fa "تنظیمات پیوند"
pub func LinkSettings(l: Link): transport.Settings:
mut s := transport.Settings {}
s.network = l.network
s.tls = l.security == "tls"
s.sni = l.sni
s.alpn = l.alpn
s.fingerprint = l.fingerprint
s.allow_insecure = l.allow_insecure
s.host = l.host_header
s.security = l.security
if l.security == "reality":
s.reality = l.reality
s.reality.server_name = l.sni
s.tls = false
end
s.service_name = l.service_name
s.grpc_mode = l.grpc_mode
if l.path.len() > 0:
s.path = l.path
qi := str.Find(l.path, "?ed=")
if qi >= 0:
s.path = l.path.substr(0, qi)
s.early_data = l.path.substr(qi + 4, l.path.len() - qi - 4).to_int()
end
end
ret s
end
@en "DialLink"
@fa "شماره گیری پیوند"
pub func DialLink(l: Link, command: int, target: transport.Addr): Conn:
ret Dial(l.host, l.port, LinkSettings(l), l.uuid, l.flow, command, target)
end
package vmess
import mem
import net.transport
import net.tunnel
struct _Adapter:
pub c: Conn = Conn {}
pub func Read(max: int): str:
buf := mem.Allocate((max + 1) as u64)
n := _read(this.c, buf, max)
if n <= 0:
mem.Free(buf)
ret ""
end
bp := buf as u8*
bp[n] = 0 as u8
ret buf as str
end
pub func ReadBytes(buf: void*, max: int): int:
ret _read(this.c, buf, max)
end
pub func Write(data: str): int:
if not _write(this.c, data as void*, data.len()):
ret 0 - 1
end
ret data.len()
end
pub func WriteBytes(ptr: void*, n: int): int:
if not _write(this.c, ptr, n):
ret 0 - 1
end
ret n
end
pub func SetDeadline(millis: int):
transport.SetReadTimeout(this.c.t, millis)
end
pub func Shutdown():
transport.ShutdownConn(this.c.t)
end
pub func CloseWrite():
transport.CloseWriteConn(this.c.t)
end
pub func Close():
_close(this.c)
end
pub func Ok(): bool:
ret this.c.ok
end
end
func _read(c &: Conn, buf: void*, max: int): int:
ret Read(c, buf, max)
end
func _write(c &: Conn, p: void*, n: int): bool:
ret Write(c, p, n)
end
func _close(c &: Conn):
Close(c)
end
@en "AsStream"
@fa "به عنوان جریان"
pub func AsStream(c: Conn): dyn tunnel.Stream:
ret _Adapter { c = c }
end
@en "DialOver"
@fa "اتصال روی جریان"
pub func DialOver(s: dyn tunnel.Stream, uuid: str, security: int, command: int, target: transport.Addr): Conn:
ret Client(transport.FromStream(s, true), uuid, security, DefaultOption(security), command, target)
end
@en "AcceptOver"
@fa "پذیرش روی جریان"
pub func AcceptOver(s: dyn tunnel.Stream, users: Vector<User>, rf &: ReplayFilter): Conn:
ret Accept(transport.FromStream(s, false), users, rf)
end
@en "MuxClient"
@fa "چندگانه ساز کارخواه"
pub func MuxClient(c: Conn): transport.Mux:
ret transport.NewMuxClient(AsStream(c))
end
@en "MuxServer"
@fa "چندگانه ساز کارساز"
pub func MuxServer(c: Conn): transport.Mux:
ret transport.NewMuxServer(AsStream(c))
end
package vmess
import str
import encoding
import encoding.json
import net.transport
import net.tunnel
@en "Link"
@fa "پیوند"
pub struct Link:
@en "ok"
@fa "معتبر"
pub ok: bool = false
@en "err"
@fa "خطا"
pub err: str = ""
@en "remark"
@fa "برچسب"
pub remark: str = ""
@en "host"
@fa "میزبان"
pub host: str = ""
@en "port"
@fa "درگاه"
pub port: int = 443
@en "uuid"
@fa "شناسه"
pub uuid: str = ""
@en "alter_id"
@fa "شناسه جایگزین"
pub alter_id: int = 0
@en "security"
@fa "امنیت"
pub security: str = "auto"
@en "network"
@fa "شبکه"
pub network: str = "tcp"
@en "header_type"
@fa "نوع سرآیند"
pub header_type: str = "none"
@en "host_header"
@fa "سربرگ میزبان"
pub host_header: str = ""
@en "path"
@fa "مسیر"
pub path: str = ""
@en "tls"
@fa "تی ال اس"
pub tls: bool = false
@en "sni"
@fa "نام سرور"
pub sni: str = ""
@en "alpn"
@fa "الپن"
pub alpn: str = ""
@en "fingerprint"
@fa "اثر انگشت"
pub fingerprint: str = ""
@en "allow_insecure"
@fa "اجازه ناامن"
pub allow_insecure: bool = false
end
@en "SecurityByName"
@fa "امنیت از نام"
pub func SecurityByName(name: str): int:
n := str.Lower(name)
if n == "aes-128-gcm" or n == "auto" or n == "":
ret SecAES128GCM
end
if n == "chacha20-poly1305" or n == "chacha20-ietf-poly1305":
ret SecChaCha20Poly1305
end
if n == "none":
ret SecNone
end
if n == "zero":
ret SecZero
end
ret 0 - 1
end
@en "SecurityName"
@fa "نام امنیت"
pub func SecurityName(sec: int): str:
if sec == SecChaCha20Poly1305:
ret "chacha20-poly1305"
end
if sec == SecNone:
ret "none"
end
if sec == SecZero:
ret "zero"
end
ret "aes-128-gcm"
end
@en "ParseLink"
@fa "تجزیه پیوند"
pub func ParseLink(link: str): Link:
mut l := Link {}
if not str.StartsWith(link, "vmess://"):
l.err = "not a vmess link"
ret l
end
mut body := str.Trim(link.substr(8, link.len() - 8))
mut frag := ""
hash := str.Find(body, "#")
if hash >= 0:
frag = tunnel.PctDecode(body.substr(hash + 1, body.len() - hash - 1))
body = body.substr(0, hash)
end
js := tunnel.B64Decode(body)
if js.len() == 0 or not json.Valid(js):
l.err = "bad vmess payload"
ret l
end
l.host = json.Get(js, "add")
l.port = json.Get(js, "port").to_int()
l.uuid = json.Get(js, "id")
l.alter_id = json.Get(js, "aid").to_int()
sc := json.Get(js, "scy")
if sc.len() > 0:
l.security = sc
end
nt := json.Get(js, "net")
if nt.len() > 0:
l.network = nt
end
ty := json.Get(js, "type")
if ty.len() > 0:
l.header_type = ty
end
l.host_header = json.Get(js, "host")
l.path = json.Get(js, "path")
l.sni = json.Get(js, "sni")
l.alpn = json.Get(js, "alpn")
l.fingerprint = json.Get(js, "fp")
tv := json.Get(js, "tls")
l.tls = tv == "tls" or tv == "true" or tv == "1"
ai := json.Get(js, "allowInsecure")
l.allow_insecure = ai == "1" or ai == "true"
l.remark = json.Get(js, "ps")
if l.remark.len() == 0:
l.remark = frag
end
mut parsed := transport.ParseUUID(l.uuid)
bad_id := parsed.bad
transport.FreeBytes(parsed)
if l.host.len() == 0 or l.port <= 0 or l.port > 65535:
l.err = "bad host or port"
ret l
end
if bad_id:
l.err = "bad uuid"
ret l
end
if SecurityByName(l.security) < 0:
l.err = "unsupported security " + l.security
ret l
end
if l.network != "tcp" and l.network != "ws" and l.network != "httpupgrade" and l.network != "grpc":
l.err = "unsupported transport " + l.network
ret l
end
l.ok = true
ret l
end
@en "FormatLink"
@fa "قالب پیوند"
pub func FormatLink(l: Link): str:
mut m := Vector {} as Vector<str>
defer m.free()
m.push(json.Member("v", "2"))
m.push(json.Member("ps", l.remark))
m.push(json.Member("add", l.host))
m.push(json.Member("port", str.FromInt(l.port as i64)))
m.push(json.Member("id", l.uuid))
m.push(json.Member("aid", str.FromInt(l.alter_id as i64)))
m.push(json.Member("scy", l.security))
m.push(json.Member("net", l.network))
m.push(json.Member("type", l.header_type))
m.push(json.Member("host", l.host_header))
m.push(json.Member("path", l.path))
mut tv := ""
if l.tls:
tv = "tls"
end
m.push(json.Member("tls", tv))
m.push(json.Member("sni", l.sni))
m.push(json.Member("alpn", l.alpn))
m.push(json.Member("fp", l.fingerprint))
if l.allow_insecure:
m.push(json.Member("allowInsecure", "1"))
end
ret "vmess://" + encoding.Base64Encode(json.Object(m))
end
@en "LinkSettings"
@fa "تنظیمات پیوند"
pub func LinkSettings(l: Link): transport.Settings:
mut s := transport.Settings {}
s.network = l.network
s.tls = l.tls
s.sni = l.sni
s.alpn = l.alpn
s.fingerprint = l.fingerprint
s.allow_insecure = l.allow_insecure
s.host = l.host_header
if l.network == "grpc":
s.service_name = l.path
if l.header_type == "multi": s.grpc_mode = "multi" end
else l.path.len() > 0:
s.path = l.path
qi := str.Find(l.path, "?ed=")
if qi >= 0:
s.path = l.path.substr(0, qi)
s.early_data = l.path.substr(qi + 4, l.path.len() - qi - 4).to_int()
end
end
ret s
end
@en "DialLink"
@fa "شماره گیری پیوند"
pub func DialLink(l: Link, command: int, target: transport.Addr): Conn:
sec := SecurityByName(l.security)
ret Dial(l.host, l.port, LinkSettings(l), l.uuid, sec, command, target)
end
package vmess
import mem
const SHAKE_RATE := 168
struct Shake:
pub st: u64* = null
pub buf: u8* = null
pub pos: int = 0
end
inline func _rotl64(x: u64, n: int): u64:
ret (x << (n as u64)) | (x >> ((64 - n) as u64))
end
inline func _rotl8(x: int, n: int): int:
ret ((x << n) | (x >> (8 - n))) & 0xFF
end
func _xtime(a: int): int:
mut r := (a << 1) & 0xFF
if (a & 0x80) != 0:
r ^= 0x1b
end
ret r
end
func _gmul(a0: int, b0: int): int:
mut a := a0
mut b := b0
mut p := 0
repeat 8:
if (b & 1) != 0:
p ^= a
end
a = _xtime(a)
b >>= 1
end
ret p
end
func _ginv(x: int): int:
if x == 0:
ret 0
end
mut r := 1
mut base := x
mut e := 254
until e > 0:
if (e & 1) != 0:
r = _gmul(r, base)
end
base = _gmul(base, base)
e >>= 1
end
ret r
end
func _sbox(x: int): int:
i := _ginv(x)
ret (i ^ _rotl8(i, 1) ^ _rotl8(i, 2) ^ _rotl8(i, 3) ^ _rotl8(i, 4) ^ 0x63) & 0xFF
end
func _inv_sbox(y: int): int:
ret _ginv((_rotl8(y, 1) ^ _rotl8(y, 3) ^ _rotl8(y, 6) ^ 0x05) & 0xFF)
end
func _aes128_expand(key: u8*, rk: u8*):
repeat 16 in i:
rk[i] = key[i]
end
mut rcon := 1
repeat 10 in r:
base := 16 * r
rk[base + 16] = (rk[base] as int ^ _sbox(rk[base + 13] as int) ^ rcon) as u8
rk[base + 17] = (rk[base + 1] as int ^ _sbox(rk[base + 14] as int)) as u8
rk[base + 18] = (rk[base + 2] as int ^ _sbox(rk[base + 15] as int)) as u8
rk[base + 19] = (rk[base + 3] as int ^ _sbox(rk[base + 12] as int)) as u8
repeat 12 in j:
rk[base + 20 + j] = (rk[base + 4 + j] as int ^ rk[base + 16 + j] as int) as u8
end
rcon = _xtime(rcon)
end
end
func _add_round_key(s: u8*, rk: u8*, round: int):
repeat 16 in i:
s[i] = (s[i] as int ^ rk[16 * round + i] as int) as u8
end
end
func _shift_rows(s: u8*, inverse: bool):
t := mem.Allocate(16 as u64) as u8*
repeat 4 in c:
repeat 4 in r:
mut src := (c + r) % 4
if inverse:
src = (c - r + 4) % 4
end
t[4 * c + r] = s[4 * src + r]
end
end
repeat 16 in i:
s[i] = t[i]
end
mem.Free(t as void*)
end
func _mix_columns(s: u8*, inverse: bool):
repeat 4 in c:
a0 := s[4 * c] as int
a1 := s[4 * c + 1] as int
a2 := s[4 * c + 2] as int
a3 := s[4 * c + 3] as int
if inverse:
s[4 * c] = (_gmul(a0, 14) ^ _gmul(a1, 11) ^ _gmul(a2, 13) ^ _gmul(a3, 9)) as u8
s[4 * c + 1] = (_gmul(a0, 9) ^ _gmul(a1, 14) ^ _gmul(a2, 11) ^ _gmul(a3, 13)) as u8
s[4 * c + 2] = (_gmul(a0, 13) ^ _gmul(a1, 9) ^ _gmul(a2, 14) ^ _gmul(a3, 11)) as u8
s[4 * c + 3] = (_gmul(a0, 11) ^ _gmul(a1, 13) ^ _gmul(a2, 9) ^ _gmul(a3, 14)) as u8
else:
s[4 * c] = (_gmul(a0, 2) ^ _gmul(a1, 3) ^ a2 ^ a3) as u8
s[4 * c + 1] = (a0 ^ _gmul(a1, 2) ^ _gmul(a2, 3) ^ a3) as u8
s[4 * c + 2] = (a0 ^ a1 ^ _gmul(a2, 2) ^ _gmul(a3, 3)) as u8
s[4 * c + 3] = (_gmul(a0, 3) ^ a1 ^ a2 ^ _gmul(a3, 2)) as u8
end
end
end
func _sub_bytes(s: u8*, inverse: bool):
repeat 16 in i:
if inverse:
s[i] = _inv_sbox(s[i] as int) as u8
else:
s[i] = _sbox(s[i] as int) as u8
end
end
end
func _aes128_block(key: void*, inp: void*, out: void*, decrypt: bool):
rk := mem.AllocateZeroed(176 as u64) as u8*
s := mem.AllocateZeroed(16 as u64) as u8*
ip := inp as u8*
_aes128_expand(key as u8*, rk)
repeat 16 in i:
s[i] = ip[i]
end
if not decrypt:
_add_round_key(s, rk, 0)
repeat 9 in r:
_sub_bytes(s, false)
_shift_rows(s, false)
_mix_columns(s, false)
_add_round_key(s, rk, r + 1)
end
_sub_bytes(s, false)
_shift_rows(s, false)
_add_round_key(s, rk, 10)
else:
_add_round_key(s, rk, 10)
repeat 9 in r:
_shift_rows(s, true)
_sub_bytes(s, true)
_add_round_key(s, rk, 9 - r)
_mix_columns(s, true)
end
_shift_rows(s, true)
_sub_bytes(s, true)
_add_round_key(s, rk, 0)
end
op := out as u8*
repeat 16 in i:
op[i] = s[i]
end
mem.Set(rk as void*, 0, 176 as u64)
mem.Free(rk as void*)
mem.Free(s as void*)
end
func _keccak_round_constant(r: int): u64:
rc := mem.Allocate(192 as u64) as u64*
defer mem.Free(rc as void*)
rc[0] = 0x0000000000000001 as u64
rc[1] = 0x0000000000008082 as u64
rc[2] = 0x800000000000808a as u64
rc[3] = 0x8000000080008000 as u64
rc[4] = 0x000000000000808b as u64
rc[5] = 0x0000000080000001 as u64
rc[6] = 0x8000000080008081 as u64
rc[7] = 0x8000000000008009 as u64
rc[8] = 0x000000000000008a as u64
rc[9] = 0x0000000000000088 as u64
rc[10] = 0x0000000080008009 as u64
rc[11] = 0x000000008000000a as u64
rc[12] = 0x000000008000808b as u64
rc[13] = 0x800000000000008b as u64
rc[14] = 0x8000000000008089 as u64
rc[15] = 0x8000000000008003 as u64
rc[16] = 0x8000000000008002 as u64
rc[17] = 0x8000000000000080 as u64
rc[18] = 0x000000000000800a as u64
rc[19] = 0x800000008000000a as u64
rc[20] = 0x8000000080008081 as u64
rc[21] = 0x8000000000008080 as u64
rc[22] = 0x0000000080000001 as u64
rc[23] = 0x8000000080008008 as u64
ret rc[r]
end
func _keccakf(st: u64*):
rotc := [1, 3, 6, 10, 15, 21, 28, 36, 45, 55, 2, 14, 27, 41, 56, 8, 25, 43, 62, 18, 39, 61, 20, 44]
piln := [10, 7, 11, 17, 18, 3, 5, 16, 8, 21, 24, 4, 15, 23, 19, 13, 12, 2, 20, 14, 22, 9, 6, 1]
bc := mem.AllocateZeroed(40 as u64) as u64*
repeat 24 in r:
repeat 5 in i:
bc[i] = st[i] ^ st[i + 5] ^ st[i + 10] ^ st[i + 15] ^ st[i + 20]
end
repeat 5 in i:
t := bc[(i + 4) % 5] ^ _rotl64(bc[(i + 1) % 5], 1)
repeat 5 in k:
st[5 * k + i] ^= t
end
end
mut t := st[1]
repeat 24 in i:
j := piln[i]
b0 := st[j]
st[j] = _rotl64(t, rotc[i])
t = b0
end
repeat 5 in k:
repeat 5 in i:
bc[i] = st[5 * k + i]
end
repeat 5 in i:
st[5 * k + i] ^= ((~bc[(i + 1) % 5]) & bc[(i + 2) % 5])
end
end
st[0] = st[0] ^ _keccak_round_constant(r)
end
mem.Free(bc as void*)
end
func _shake_refill(s &: Shake):
_keccakf(s.st)
sp := s.st as u8*
repeat SHAKE_RATE in i:
s.buf[i] = sp[i]
end
s.pos = 0
end
func _shake128_new(data: void*, n: int): Shake:
mut s := Shake {}
s.st = mem.AllocateZeroed(200 as u64) as u64*
s.buf = mem.AllocateZeroed(SHAKE_RATE as u64) as u8*
sp := s.st as u8*
dp := data as u8*
mut off := 0
until n - off >= SHAKE_RATE:
repeat SHAKE_RATE in i:
sp[i] = (sp[i] as int ^ dp[off + i] as int) as u8
end
_keccakf(s.st)
off += SHAKE_RATE
end
rem := n - off
repeat rem in i:
sp[i] = (sp[i] as int ^ dp[off + i] as int) as u8
end
sp[rem] = (sp[rem] as int ^ 0x1F) as u8
sp[SHAKE_RATE - 1] = (sp[SHAKE_RATE - 1] as int ^ 0x80) as u8
_shake_refill(s)
ret s
end
func _shake_next16(s &: Shake): int:
if s.pos + 2 > SHAKE_RATE:
_shake_refill(s)
end
v := (s.buf[s.pos] as int) * 256 + (s.buf[s.pos + 1] as int)
s.pos += 2
ret v
end
func _shake_read(s &: Shake, out: u8*, n: int):
repeat n in i:
if s.pos >= SHAKE_RATE:
_shake_refill(s)
end
out[i] = s.buf[s.pos]
s.pos++
end
end
func _shake_free(s &: Shake):
if s.st != null:
mem.Set(s.st as void*, 0, 200 as u64)
mem.Free(s.st as void*)
end
if s.buf != null:
mem.Free(s.buf as void*)
end
s.st = null
s.buf = null
end
func _crc32_ieee(p: u8*, n: int): i64:
mut crc := 0xFFFFFFFF as i64
repeat n in i:
crc ^= (p[i] as i64)
repeat 8:
if (crc & 1) != 0:
crc = (crc >> 1) ^ (0xEDB88320 as i64)
else:
crc >>= 1
end
end
end
ret crc ^ (0xFFFFFFFF as i64)
end
func _fnv1a32(p: u8*, n: int): i64:
mut h := 0x811c9dc5 as i64
repeat n in i:
h ^= (p[i] as i64)
h = (h * (16777619 as i64)) & (0xFFFFFFFF as i64)
end
ret h
end
package vmess
import mem
import crypto
import tls
import sync
import time
import rand
import net.transport
const MAX_PLAIN := 16384
struct Codec:
pub security: int = 3
pub option: int = 0
pub key: transport.Bytes = transport.Bytes {}
pub iv: transport.Bytes = transport.Bytes {}
pub lkey: transport.Bytes = transport.Bytes {}
pub liv: transport.Bytes = transport.Bytes {}
pub counter: int = 0
pub lcounter: int = 0
pub shake: Shake = Shake {}
pub has_shake: bool = false
end
@en "User"
@fa "کاربر"
pub struct User:
@en "id"
@fa "شناسه"
pub id: str = ""
@en "cmd_key"
@fa "کلید فرمان"
pub cmd_key: transport.Bytes = transport.Bytes {}
end
@en "ReplayFilter"
@fa "فیلتر بازپخش"
pub struct ReplayFilter:
@en "seen"
@fa "دیده شده"
pub seen: HashMap<str, i64> = HashMap {} as HashMap<str, i64>
@en "lock"
@fa "قفل"
pub lock: sync.Mutex = sync.NewMutex()
end
@en "Conn"
@fa "اتصال"
pub struct Conn:
@en "t"
@fa "انتقال"
pub t: transport.Conn = transport.Conn {}
@en "client"
@fa "کارخواه"
pub client: bool = false
@en "ok"
@fa "معتبر"
pub ok: bool = false
@en "err"
@fa "خطا"
pub err: str = ""
@en "req"
@fa "درخواست"
pub req: Request = Request {}
@en "user"
@fa "کاربر"
pub user: str = ""
@en "wc"
@fa "رمز نوشتن"
pub wc: Codec = Codec {}
@en "rc"
@fa "رمز خواندن"
pub rc: Codec = Codec {}
@en "resp_pending"
@fa "پاسخ معلق"
pub resp_pending: bool = false
@en "resp_key"
@fa "کلید پاسخ"
pub resp_key: transport.Bytes = transport.Bytes {}
@en "resp_iv"
@fa "بردار پاسخ"
pub resp_iv: transport.Bytes = transport.Bytes {}
@en "rbuf"
@fa "بافر خواندن"
pub rbuf: transport.Bytes = transport.Bytes {}
@en "eof"
@fa "پایان جریان"
pub eof: bool = false
@en "closed"
@fa "بسته شده"
pub closed: bool = false
end
func _chacha_key(k: transport.Bytes): transport.Bytes:
mut out := transport.NewBytes(32)
crypto.Md5Bytes(k.p, 16, out.p)
crypto.Md5Bytes(out.p, 16, transport.BytesPtr(out, 16))
out.len = 32
ret out
end
func _codec_new(
security: int, option: int, key: transport.Bytes, iv: transport.Bytes, lsrc_key: transport.Bytes,
lsrc_iv: transport.Bytes
): Codec:
mut c := Codec {}
c.security = security
c.option = option
if security == SecChaCha20Poly1305:
c.key = _chacha_key(key)
else:
c.key = transport.NewBytes(16)
transport.PutBytes(c.key, key)
end
c.iv = transport.NewBytes(16)
transport.PutBytes(c.iv, iv)
c.liv = transport.NewBytes(16)
transport.PutBytes(c.liv, lsrc_iv)
if (option & OptAuthLength) != 0:
c.lkey = KDF16(lsrc_key, "auth_len", _empty(), _empty())
if security == SecChaCha20Poly1305:
mut k16 := c.lkey
c.lkey = _chacha_key(k16)
transport.FreeBytes(k16)
end
end
if (option & (OptChunkMask | OptPadding)) != 0:
c.shake = _shake128_new(iv.p, iv.len)
c.has_shake = true
end
ret c
end
func _codec_free(c &: Codec):
transport.FreeBytes(c.key)
transport.FreeBytes(c.iv)
transport.FreeBytes(c.liv)
transport.FreeBytes(c.lkey)
if c.has_shake:
_shake_free(c.shake)
c.has_shake = false
end
end
func _len_seal(c: Codec, nonce: transport.Bytes, plain: transport.Bytes): transport.Bytes:
if c.security != SecChaCha20Poly1305:
ret _gcm_seal(c.lkey, nonce, _empty(), plain)
end
mut out := transport.NewBytes(plain.len + 16)
tls.ChaCha20Poly1305SealRaw(c.lkey.p, nonce.p, null, 0, plain.p, plain.len, out.p)
out.len = plain.len + 16
ret out
end
func _len_open(c: Codec, nonce: transport.Bytes, sealed: transport.Bytes): transport.Bytes:
if c.security != SecChaCha20Poly1305:
ret _gcm_open(c.lkey, nonce, _empty(), sealed)
end
mut out := transport.NewBytes(sealed.len + 1)
if sealed.len < 16 or not tls.ChaCha20Poly1305OpenRaw(c.lkey.p, nonce.p, null, 0, sealed.p, sealed.len, out.p):
out.bad = true
ret out
end
out.len = sealed.len - 16
ret out
end
func _raw(security: int, option: int): bool:
if security == SecZero:
ret true
end
ret security == SecNone and (option & OptChunkStream) == 0
end
func _overhead(c: Codec): int:
if c.security == SecAES128GCM or c.security == SecChaCha20Poly1305:
ret 16
end
ret 0
end
func _nonce(iv: transport.Bytes, counter: int): transport.Bytes:
mut n := transport.NewBytes(12)
transport.Put16(n, counter & 0xFFFF)
transport.PutRaw(n, transport.BytesPtr(iv, 2), 10)
ret n
end
func _padding_len(c &: Codec): int:
if (c.option & OptPadding) != 0 and c.has_shake:
ret _shake_next16(c.shake) % 64
end
ret 0
end
func _seal_chunk(c &: Codec, p: void*, n: int, out &: transport.Bytes):
ov := _overhead(c)
pad := _padding_len(c)
total := n + ov + pad
if (c.option & OptAuthLength) != 0:
mut lb := transport.NewBytes(2)
transport.Put16(lb, total - 16)
mut ln := _nonce(c.liv, c.lcounter)
c.lcounter++
mut le := _len_seal(c, ln, lb)
transport.PutBytes(out, le)
transport.FreeBytes(lb)
transport.FreeBytes(ln)
transport.FreeBytes(le)
else (c.option & OptChunkMask) != 0 and c.has_shake:
transport.Put16(out, total ^ _shake_next16(c.shake))
else:
transport.Put16(out, total)
end
if ov == 0:
transport.PutRaw(out, p, n)
else:
mut nn := _nonce(c.iv, c.counter)
c.counter++
transport.Reserve(out, n + 16)
dst := transport.BytesPtr(out, out.len)
if c.security == SecAES128GCM:
tls.AesGcmSealRaw(c.key.p, 16, nn.p, null, 0, p, n, dst)
else:
tls.ChaCha20Poly1305SealRaw(c.key.p, nn.p, null, 0, p, n, dst)
end
out.len += n + 16
transport.FreeBytes(nn)
end
if pad > 0:
mut pb := transport.NewBytes(pad)
crypto.RandomBytes(pb.p, pad)
pb.len = pad
transport.PutBytes(out, pb)
transport.FreeBytes(pb)
end
end
func _read_chunk(t &: transport.Conn, c &: Codec, out &: transport.Bytes): int:
mut slen := 2
if (c.option & OptAuthLength) != 0:
slen = 18
end
mut sb := transport.NewBytes(slen)
defer transport.FreeBytes(sb)
if not transport.ReadFull(t, sb.p, slen):
ret 0 - 1
end
sb.len = slen
pad := _padding_len(c)
mut total := 0
if (c.option & OptAuthLength) != 0:
mut ln := _nonce(c.liv, c.lcounter)
c.lcounter++
mut pl := _len_open(c, ln, sb)
transport.FreeBytes(ln)
if pl.bad:
transport.FreeBytes(pl)
ret 0 - 1
end
total = transport.Peek16(pl, 0) + 16
transport.FreeBytes(pl)
else (c.option & OptChunkMask) != 0 and c.has_shake:
total = transport.Peek16(sb, 0) ^ _shake_next16(c.shake)
else:
total = transport.Peek16(sb, 0)
end
ov := _overhead(c)
enc := total - pad
if enc < ov or total > 65535:
ret 0 - 1
end
mut body := transport.NewBytes(total + 1)
defer transport.FreeBytes(body)
if total > 0 and not transport.ReadFull(t, body.p, total):
ret 0 - 1
end
body.len = total
pn := enc - ov
if ov == 0:
if pn > 0:
transport.PutRaw(out, body.p, pn)
end
ret pn
end
mut nn := _nonce(c.iv, c.counter)
c.counter++
transport.Reserve(out, pn + 1)
dst := transport.BytesPtr(out, out.len)
mut good := false
if c.security == SecAES128GCM:
good = tls.AesGcmOpenRaw(c.key.p, 16, nn.p, null, 0, body.p, enc, dst)
else:
good = tls.ChaCha20Poly1305OpenRaw(c.key.p, nn.p, null, 0, body.p, enc, dst)
end
transport.FreeBytes(nn)
if not good:
ret 0 - 1
end
out.len += pn
ret pn
end
func _fail(c &: Conn, msg: str):
c.ok = false
c.err = msg
transport.Close(c.t)
end
func _setup_resp_keys(c &: Conn):
mut kh := Sha256(c.req.key)
mut ih := Sha256(c.req.iv)
c.resp_key = transport.NewBytes(16)
transport.PutRaw(c.resp_key, kh.p, 16)
c.resp_iv = transport.NewBytes(16)
transport.PutRaw(c.resp_iv, ih.p, 16)
transport.FreeBytes(kh)
transport.FreeBytes(ih)
end
func _read_response(c &: Conn): bool:
mut el := transport.NewBytes(18)
defer transport.FreeBytes(el)
if not transport.ReadFull(c.t, el.p, 18):
_fail(c, "no response header")
ret false
end
el.len = 18
n := OpenResponseLength(c.resp_key, c.resp_iv, el)
if n < 4 or n > 4096:
_fail(c, "bad response header length")
ret false
end
mut eh := transport.NewBytes(n + 16)
defer transport.FreeBytes(eh)
if not transport.ReadFull(c.t, eh.p, n + 16):
_fail(c, "short response header")
ret false
end
eh.len = n + 16
mut h := OpenResponseHeader(c.resp_key, c.resp_iv, eh)
defer transport.FreeBytes(h)
if h.bad or h.len < 4 or transport.At(h, 0) != c.req.resp_v:
_fail(c, "response header rejected")
ret false
end
c.resp_pending = false
if not _raw(c.req.security, c.req.option):
c.rc = _codec_new(c.req.security, c.req.option, c.resp_key, c.resp_iv, c.req.key, c.req.iv)
end
ret true
end
@en "NewUser"
@fa "کاربر جدید"
pub func NewUser(uuid: str): User:
mut u := User {}
u.id = uuid
mut b := transport.ParseUUID(uuid)
if b.bad:
transport.FreeBytes(b)
ret u
end
u.cmd_key = CmdKey(b)
transport.FreeBytes(b)
ret u
end
@en "NewReplayFilter"
@fa "فیلتر بازپخش جدید"
pub func NewReplayFilter(): ReplayFilter:
ret ReplayFilter {}
end
@en "DefaultOption"
@fa "گزینه پیش فرض"
pub func DefaultOption(security: int): int:
if security == SecZero:
ret 0
end
if security == SecNone:
ret OptChunkStream
end
ret OptChunkStream | OptChunkMask
end
@en "Client"
@fa "کارخواه"
pub func Client(t: transport.Conn, uuid: str, security: int, option: int, command: int, addr: transport.Addr): Conn:
mut c := Conn {}
c.t = t
c.client = true
mut idb := transport.ParseUUID(uuid)
if idb.bad:
transport.FreeBytes(idb)
_fail(c, "bad uuid")
ret c
end
mut ck := CmdKey(idb)
transport.FreeBytes(idb)
mut r := Request {}
r.iv = transport.NewBytes(16)
crypto.RandomBytes(r.iv.p, 16)
r.iv.len = 16
r.key = transport.NewBytes(16)
crypto.RandomBytes(r.key.p, 16)
r.key.len = 16
r.resp_v = rand.IntRange(0 as i64, 255 as i64) as int
r.option = option
r.security = security
r.command = command
r.addr = addr
r.padding = rand.IntRange(0 as i64, 15 as i64) as int
c.req = r
mut plain := EncodeRequest(r)
mut sealed := SealHeaderNow(ck, plain)
ok := transport.WriteBytes(c.t, sealed)
transport.FreeBytes(plain)
transport.FreeBytes(sealed)
transport.FreeBytes(ck)
if not ok:
_fail(c, "could not send the request header")
ret c
end
if not _raw(security, option):
c.wc = _codec_new(security, option, r.key, r.iv, r.key, r.iv)
end
_setup_resp_keys(c)
c.resp_pending = true
c.ok = true
ret c
end
@en "Dial"
@fa "شماره گیری"
pub func Dial(
host: str, port: int, s: transport.Settings, uuid: str, security: int, command: int, target: transport.Addr
): Conn:
t := transport.Dial(host, port, s)
if not transport.Ok(t):
mut c := Conn {}
c.t = t
c.err = t.err
ret c
end
ret Client(t, uuid, security, DefaultOption(security), command, target)
end
@en "Accept"
@fa "پذیرش"
pub func Accept(t: transport.Conn, users: Vector<User>, rf &: ReplayFilter): Conn:
mut c := Conn {}
c.t = t
mut authid := transport.NewBytes(16)
defer transport.FreeBytes(authid)
if not transport.ReadFull(c.t, authid.p, 16):
_fail(c, "no auth id")
ret c
end
authid.len = 16
now := time.Now()
mut found := 0 - 1
repeat users.len() in i:
u := users.get(i)
mut ts := 0 as i64
if OpenAuthID(u.cmd_key, authid, ts):
mut d := now - ts
if d < 0 as i64:
d = 0 as i64 - d
end
if d <= (TimeWindow as i64) and found < 0:
found = i
end
end
end
if found < 0:
_fail(c, "unknown user or stale timestamp")
ret c
end
u := users.get(found)
key := transport.ToHex(authid)
sync.Lock(rf.lock)
mut replay := false
if rf.seen.has(key):
replay = true
else:
rf.seen.put(key, now)
if rf.seen.size() > 4096:
mut stale := Vector {} as Vector<str>
each k, v in rf.seen:
if now - v > ((2 * TimeWindow) as i64):
stale.push(k)
end
end
repeat stale.len() in i:
rf.seen.remove(stale.get(i))
end
stale.free()
end
end
sync.Unlock(rf.lock)
if replay:
_fail(c, "replayed auth id")
ret c
end
mut el := transport.NewBytes(18 + 8)
defer transport.FreeBytes(el)
if not transport.ReadFull(c.t, el.p, 26):
_fail(c, "short header")
ret c
end
el.len = 26
mut enc_len := transport.NewBytes(18)
defer transport.FreeBytes(enc_len)
transport.PutRaw(enc_len, el.p, 18)
mut nonce := transport.NewBytes(8)
defer transport.FreeBytes(nonce)
transport.PutRaw(nonce, transport.BytesPtr(el, 18), 8)
n := OpenHeaderLength(u.cmd_key, authid, enc_len, nonce)
if n < 38 or n > 2048:
_fail(c, "bad header length")
ret c
end
mut eh := transport.NewBytes(n + 16)
defer transport.FreeBytes(eh)
if not transport.ReadFull(c.t, eh.p, n + 16):
_fail(c, "short header body")
ret c
end
eh.len = n + 16
mut hd := OpenHeader(u.cmd_key, authid, eh, nonce)
defer transport.FreeBytes(hd)
if hd.bad:
_fail(c, "header authentication failed")
ret c
end
mut req := Request {}
if not DecodeRequest(hd, req):
_fail(c, "bad request header")
ret c
end
c.req = req
c.user = u.id
sec := req.security
if sec != SecAES128GCM and sec != SecChaCha20Poly1305 and sec != SecNone and sec != SecZero:
_fail(c, "unsupported security type")
ret c
end
_setup_resp_keys(c)
if not _raw(sec, req.option):
c.rc = _codec_new(sec, req.option, req.key, req.iv, req.key, req.iv)
c.wc = _codec_new(sec, req.option, c.resp_key, c.resp_iv, req.key, req.iv)
end
mut rh := transport.NewBytes(4)
defer transport.FreeBytes(rh)
transport.Put8(rh, req.resp_v)
transport.Put8(rh, 0)
transport.Put8(rh, 0)
transport.Put8(rh, 0)
mut sealed := SealResponseHeader(c.resp_key, c.resp_iv, rh)
defer transport.FreeBytes(sealed)
if not transport.WriteBytes(c.t, sealed):
_fail(c, "could not send the response header")
ret c
end
c.ok = true
ret c
end
@en "Read"
@fa "خواندن"
pub func Read(c &: Conn, buf: void*, max: int): int:
if not c.ok or c.eof:
ret 0
end
if c.resp_pending:
if not _read_response(c):
ret 0 - 1
end
end
if _raw(c.req.security, c.req.option):
ret transport.Read(c.t, buf, max)
end
until c.rbuf.len == 0:
n := _read_chunk(c.t, c.rc, c.rbuf)
if n < 0:
c.eof = true
ret 0 - 1
end
if n == 0:
c.eof = true
ret 0
end
end
mut take := max
if take > c.rbuf.len:
take = c.rbuf.len
end
mem.Copy(buf, c.rbuf.p, take as u64)
transport.Consume(c.rbuf, take)
ret take
end
@en "ReadPacket"
@fa "خواندن بسته"
pub func ReadPacket(c &: Conn, out &: transport.Bytes): bool:
if not c.ok or c.eof:
ret false
end
if c.resp_pending:
if not _read_response(c):
ret false
end
end
n := _read_chunk(c.t, c.rc, out)
if n <= 0:
c.eof = true
ret false
end
ret true
end
@en "Write"
@fa "نوشتن"
pub func Write(c &: Conn, p: void*, n: int): bool:
if not c.ok:
ret false
end
if _raw(c.req.security, c.req.option):
ret transport.Write(c.t, p, n)
end
mut out := transport.NewBytes(n + 64)
defer transport.FreeBytes(out)
mut off := 0
until off < n:
mut take := n - off
if take > MAX_PLAIN:
take = MAX_PLAIN
end
_seal_chunk(c.wc, ((p as i64) + (off as i64)) as void*, take, out)
off += take
end
ret transport.WriteBytes(c.t, out)
end
@en "Close"
@fa "بستن"
pub func Close(c &: Conn):
if c.closed:
ret
end
c.closed = true
if c.ok and not _raw(c.req.security, c.req.option):
mut out := transport.NewBytes(64)
_seal_chunk(c.wc, null, 0, out)
transport.WriteBytes(c.t, out)
transport.FreeBytes(out)
end
transport.Close(c.t)
_codec_free(c.wc)
_codec_free(c.rc)
transport.FreeBytes(c.rbuf)
transport.FreeBytes(c.resp_key)
transport.FreeBytes(c.resp_iv)
end
@en "EncodeChunks"
@fa "کدگذاری قطعه ها"
pub func EncodeChunks(
security: int, option: int, key: transport.Bytes, iv: transport.Bytes, parts: Vector<transport.Bytes>,
with_end: bool
): transport.Bytes:
mut c := _codec_new(security, option, key, iv, key, iv)
mut out := transport.NewBytes(256)
repeat parts.len() in i:
p := parts.get(i)
_seal_chunk(c, p.p, p.len, out)
end
if with_end:
_seal_chunk(c, null, 0, out)
end
_codec_free(c)
ret out
end
@en "net/vmess"
@fa "وی مس"
package vmess
import mem
import crypto
import tls
import time
import net.transport
@en "CmdTCP"
@fa "فرمان تی سی پی"
pub const CmdTCP := 1
@en "CmdUDP"
@fa "فرمان یو دی پی"
pub const CmdUDP := 2
@en "CmdMux"
@fa "فرمان مالتی پلکس"
pub const CmdMux := 3
@en "SecAES128GCM"
@fa "امنیت ای ای اس۱۲۸ جی سی ام"
pub const SecAES128GCM := 3
@en "SecChaCha20Poly1305"
@fa "امنیت چاچا۲۰ پلی۱۳۰۵"
pub const SecChaCha20Poly1305 := 4
@en "SecNone"
@fa "امنیت هیچ"
pub const SecNone := 5
@en "SecZero"
@fa "امنیت صفر"
pub const SecZero := 6
@en "OptChunkStream"
@fa "گزینه جریان قطعه ای"
pub const OptChunkStream := 1
@en "OptChunkMask"
@fa "گزینه نقاب طول"
pub const OptChunkMask := 4
@en "OptPadding"
@fa "گزینه لایه گذاری"
pub const OptPadding := 8
@en "OptAuthLength"
@fa "گزینه طول احراز شده"
pub const OptAuthLength := 16
@en "TimeWindow"
@fa "پنجره زمانی"
pub const TimeWindow := 120
const KDF_SALT := "VMess AEAD KDF"
const CMD_KEY_SALT := "c48619fe-8f02-49e0-b9e9-edf763e17e21"
@en "Request"
@fa "درخواست"
pub struct Request:
@en "version"
@fa "نگارش"
pub version: int = 1
@en "iv"
@fa "بردار آغازین"
pub iv: transport.Bytes = transport.Bytes {}
@en "key"
@fa "کلید"
pub key: transport.Bytes = transport.Bytes {}
@en "resp_v"
@fa "بایت پاسخ"
pub resp_v: int = 0
@en "option"
@fa "گزینه ها"
pub option: int = 0
@en "security"
@fa "امنیت"
pub security: int = 3
@en "command"
@fa "فرمان"
pub command: int = 1
@en "addr"
@fa "نشانی"
pub addr: transport.Addr = transport.Addr {}
@en "padding"
@fa "طول لایه گذاری"
pub padding: int = 0
end
func _hash_level(path: Vector<transport.Bytes>, depth: int, msg: void*, n: int, out: void*):
if depth == 0:
crypto.HmacSha256Raw(KDF_SALT as void*, KDF_SALT.len(), msg, n, out)
ret
end
key := path.get(depth - 1)
kp := mem.AllocateZeroed(64 as u64) as u8*
if key.len > 64:
_hash_level(path, depth - 1, key.p, key.len, kp as void*)
else:
mem.Copy(kp as void*, key.p, key.len as u64)
end
inner := mem.Allocate((64 + n) as u64) as u8*
repeat 64 in i:
inner[i] = (kp[i] as int ^ 0x36) as u8
end
if n > 0:
mem.Copy(((inner as i64) + 64) as void*, msg, n as u64)
end
mid := mem.AllocateZeroed(32 as u64) as u8*
_hash_level(path, depth - 1, inner as void*, 64 + n, mid as void*)
outer := mem.Allocate(96 as u64) as u8*
repeat 64 in i:
outer[i] = (kp[i] as int ^ 0x5c) as u8
end
mem.Copy(((outer as i64) + 64) as void*, mid as void*, 32 as u64)
_hash_level(path, depth - 1, outer as void*, 96, out)
mem.Set(kp as void*, 0, 64 as u64)
mem.Free(kp as void*)
mem.Free(inner as void*)
mem.Free(mid as void*)
mem.Free(outer as void*)
end
func _kdf(key: transport.Bytes, label: str, a: transport.Bytes, b: transport.Bytes): transport.Bytes:
mut path := Vector {} as Vector<transport.Bytes>
defer path.free()
mut lb := transport.FromStr(label)
defer transport.FreeBytes(lb)
path.push(lb)
if a.len > 0:
path.push(a)
end
if b.len > 0:
path.push(b)
end
mut out := transport.NewBytes(32)
_hash_level(path, path.len(), key.p, key.len, out.p)
out.len = 32
ret out
end
func _empty(): transport.Bytes:
ret transport.Bytes {}
end
func _gcm_seal(key: transport.Bytes, nonce: transport.Bytes, aad: transport.Bytes, pt: transport.Bytes): transport.Bytes:
mut out := transport.NewBytes(pt.len + 16)
ok := tls.AesGcmSealRaw(key.p, 16, nonce.p, aad.p, aad.len, pt.p, pt.len, out.p)
if not ok:
out.bad = true
ret out
end
out.len = pt.len + 16
ret out
end
func _gcm_open(key: transport.Bytes, nonce: transport.Bytes, aad: transport.Bytes, ct: transport.Bytes): transport.Bytes:
mut out := transport.NewBytes(ct.len + 1)
if ct.len < 16:
out.bad = true
ret out
end
ok := tls.AesGcmOpenRaw(key.p, 16, nonce.p, aad.p, aad.len, ct.p, ct.len, out.p)
if not ok:
out.bad = true
ret out
end
out.len = ct.len - 16
ret out
end
func _truncate(b: transport.Bytes, n: int): transport.Bytes:
mut r := b
if r.len > n:
r.len = n
end
ret r
end
@en "KDF"
@fa "تابع اشتقاق کلید"
pub func KDF(key: transport.Bytes, label: str, a: transport.Bytes, b: transport.Bytes): transport.Bytes:
ret _kdf(key, label, a, b)
end
@en "KDF16"
@fa "تابع اشتقاق کلید۱۶"
pub func KDF16(key: transport.Bytes, label: str, a: transport.Bytes, b: transport.Bytes): transport.Bytes:
k := _kdf(key, label, a, b)
ret _truncate(k, 16)
end
@en "KDF12"
@fa "تابع اشتقاق کلید۱۲"
pub func KDF12(key: transport.Bytes, label: str, a: transport.Bytes, b: transport.Bytes): transport.Bytes:
k := _kdf(key, label, a, b)
ret _truncate(k, 12)
end
@en "CmdKey"
@fa "کلید فرمان"
pub func CmdKey(uuid: transport.Bytes): transport.Bytes:
mut buf := transport.NewBytes(64)
defer transport.FreeBytes(buf)
transport.PutBytes(buf, uuid)
transport.PutStr(buf, CMD_KEY_SALT)
mut out := transport.NewBytes(16)
crypto.Md5Bytes(buf.p, buf.len, out.p)
out.len = 16
ret out
end
@en "Sha256"
@fa "شا۲۵۶"
pub func Sha256(data: transport.Bytes): transport.Bytes:
mut out := transport.NewBytes(32)
crypto.Sha256Bytes(data.p, data.len, out.p)
out.len = 32
ret out
end
@en "AES128Block"
@fa "بلوک ای ای اس۱۲۸"
pub func AES128Block(key: transport.Bytes, block: transport.Bytes, decrypt: bool): transport.Bytes:
mut out := transport.NewBytes(16)
if key.len != 16 or block.len != 16:
out.bad = true
ret out
end
_aes128_block(key.p, block.p, out.p, decrypt)
out.len = 16
ret out
end
@en "Shake128"
@fa "شیک۱۲۸"
pub func Shake128(msg: transport.Bytes, outlen: int): transport.Bytes:
mut s := _shake128_new(msg.p, msg.len)
mut out := transport.NewBytes(outlen + 1)
_shake_read(s, out.p as u8*, outlen)
out.len = outlen
_shake_free(s)
ret out
end
@en "CRC32"
@fa "سی آر سی۳۲"
pub func CRC32(data: transport.Bytes): i64:
ret _crc32_ieee(data.p as u8*, data.len)
end
@en "FNV1a"
@fa "اف ان وی یک ای"
pub func FNV1a(data: transport.Bytes): i64:
ret _fnv1a32(data.p as u8*, data.len)
end
@en "CreateAuthID"
@fa "ساخت شناسه احراز"
pub func CreateAuthID(cmd_key: transport.Bytes, ts: i64, rand4: transport.Bytes): transport.Bytes:
mut plain := transport.NewBytes(16)
defer transport.FreeBytes(plain)
transport.Put64(plain, ts as u64)
transport.PutBytes(plain, rand4)
transport.Put32(plain, _crc32_ieee(plain.p as u8*, 12))
mut ek := KDF16(cmd_key, "AES Auth ID Encryption", _empty(), _empty())
defer transport.FreeBytes(ek)
ret AES128Block(ek, plain, false)
end
@en "OpenAuthID"
@fa "گشودن شناسه احراز"
pub func OpenAuthID(cmd_key: transport.Bytes, authid: transport.Bytes, ts &: i64): bool:
if authid.len != 16:
ret false
end
mut ek := KDF16(cmd_key, "AES Auth ID Encryption", _empty(), _empty())
defer transport.FreeBytes(ek)
mut plain := AES128Block(ek, authid, true)
defer transport.FreeBytes(plain)
want := _crc32_ieee(plain.p as u8*, 12)
got := transport.Peek32(plain, 12)
if want != got:
ret false
end
mut t := 0 as i64
repeat 8 in i:
t = (t << (8 as i64)) | (transport.At(plain, i) as i64)
end
ts = t
ret true
end
@en "SealHeader"
@fa "مهر سرآیند"
pub func SealHeader(
cmd_key: transport.Bytes, data: transport.Bytes, ts: i64, rand4: transport.Bytes, nonce: transport.Bytes
): transport.Bytes:
mut out := transport.NewBytes(data.len + 64)
mut authid := CreateAuthID(cmd_key, ts, rand4)
defer transport.FreeBytes(authid)
mut lenb := transport.NewBytes(2)
defer transport.FreeBytes(lenb)
transport.Put16(lenb, data.len)
mut lk := KDF16(cmd_key, "VMess Header AEAD Key_Length", authid, nonce)
defer transport.FreeBytes(lk)
mut ln := KDF12(cmd_key, "VMess Header AEAD Nonce_Length", authid, nonce)
defer transport.FreeBytes(ln)
mut lenc := _gcm_seal(lk, ln, authid, lenb)
defer transport.FreeBytes(lenc)
mut hk := KDF16(cmd_key, "VMess Header AEAD Key", authid, nonce)
defer transport.FreeBytes(hk)
mut hn := KDF12(cmd_key, "VMess Header AEAD Nonce", authid, nonce)
defer transport.FreeBytes(hn)
mut hdr_enc := _gcm_seal(hk, hn, authid, data)
defer transport.FreeBytes(hdr_enc)
transport.PutBytes(out, authid)
transport.PutBytes(out, lenc)
transport.PutBytes(out, nonce)
transport.PutBytes(out, hdr_enc)
ret out
end
@en "SealHeaderNow"
@fa "مهر سرآیند اکنون"
pub func SealHeaderNow(cmd_key: transport.Bytes, data: transport.Bytes): transport.Bytes:
mut r4 := transport.NewBytes(4)
defer transport.FreeBytes(r4)
mut n8 := transport.NewBytes(8)
defer transport.FreeBytes(n8)
crypto.RandomBytes(r4.p, 4)
r4.len = 4
crypto.RandomBytes(n8.p, 8)
n8.len = 8
ret SealHeader(cmd_key, data, time.Now(), r4, n8)
end
@en "OpenHeaderLength"
@fa "گشودن طول سرآیند"
pub func OpenHeaderLength(
cmd_key: transport.Bytes, authid: transport.Bytes, enc_len: transport.Bytes, nonce: transport.Bytes
): int:
mut lk := KDF16(cmd_key, "VMess Header AEAD Key_Length", authid, nonce)
defer transport.FreeBytes(lk)
mut ln := KDF12(cmd_key, "VMess Header AEAD Nonce_Length", authid, nonce)
defer transport.FreeBytes(ln)
mut plain := _gcm_open(lk, ln, authid, enc_len)
defer transport.FreeBytes(plain)
if plain.bad or plain.len != 2:
ret 0 - 1
end
ret transport.Peek16(plain, 0)
end
@en "OpenHeader"
@fa "گشودن سرآیند"
pub func OpenHeader(
cmd_key: transport.Bytes, authid: transport.Bytes, enc: transport.Bytes, nonce: transport.Bytes
): transport.Bytes:
mut hk := KDF16(cmd_key, "VMess Header AEAD Key", authid, nonce)
defer transport.FreeBytes(hk)
mut hn := KDF12(cmd_key, "VMess Header AEAD Nonce", authid, nonce)
defer transport.FreeBytes(hn)
ret _gcm_open(hk, hn, authid, enc)
end
@en "SealResponseHeader"
@fa "مهر سرآیند پاسخ"
pub func SealResponseHeader(resp_key: transport.Bytes, resp_iv: transport.Bytes, header: transport.Bytes): transport.Bytes:
mut out := transport.NewBytes(header.len + 40)
mut lb := transport.NewBytes(2)
defer transport.FreeBytes(lb)
transport.Put16(lb, header.len)
mut lk := KDF16(resp_key, "AEAD Resp Header Len Key", _empty(), _empty())
defer transport.FreeBytes(lk)
mut ln := KDF12(resp_iv, "AEAD Resp Header Len IV", _empty(), _empty())
defer transport.FreeBytes(ln)
mut hk := KDF16(resp_key, "AEAD Resp Header Key", _empty(), _empty())
defer transport.FreeBytes(hk)
mut hn := KDF12(resp_iv, "AEAD Resp Header IV", _empty(), _empty())
defer transport.FreeBytes(hn)
mut le := _gcm_seal(lk, ln, _empty(), lb)
defer transport.FreeBytes(le)
mut he := _gcm_seal(hk, hn, _empty(), header)
defer transport.FreeBytes(he)
transport.PutBytes(out, le)
transport.PutBytes(out, he)
ret out
end
@en "OpenResponseLength"
@fa "گشودن طول پاسخ"
pub func OpenResponseLength(resp_key: transport.Bytes, resp_iv: transport.Bytes, enc_len: transport.Bytes): int:
mut lk := KDF16(resp_key, "AEAD Resp Header Len Key", _empty(), _empty())
defer transport.FreeBytes(lk)
mut ln := KDF12(resp_iv, "AEAD Resp Header Len IV", _empty(), _empty())
defer transport.FreeBytes(ln)
mut plain := _gcm_open(lk, ln, _empty(), enc_len)
defer transport.FreeBytes(plain)
if plain.bad or plain.len != 2:
ret 0 - 1
end
ret transport.Peek16(plain, 0)
end
@en "OpenResponseHeader"
@fa "گشودن سرآیند پاسخ"
pub func OpenResponseHeader(resp_key: transport.Bytes, resp_iv: transport.Bytes, enc: transport.Bytes): transport.Bytes:
mut hk := KDF16(resp_key, "AEAD Resp Header Key", _empty(), _empty())
defer transport.FreeBytes(hk)
mut hn := KDF12(resp_iv, "AEAD Resp Header IV", _empty(), _empty())
defer transport.FreeBytes(hn)
ret _gcm_open(hk, hn, _empty(), enc)
end
@en "EncodeRequest"
@fa "کدگذاری درخواست"
pub func EncodeRequest(r: Request): transport.Bytes:
mut b := transport.NewBytes(64 + r.padding)
transport.Put8(b, r.version)
transport.PutBytes(b, r.iv)
transport.PutBytes(b, r.key)
transport.Put8(b, r.resp_v)
transport.Put8(b, r.option)
transport.Put8(b, ((r.padding & 15) << 4) | (r.security & 15))
transport.Put8(b, 0)
transport.Put8(b, r.command)
if r.command != CmdMux:
if not transport.PutAddr(b, r.addr):
b.bad = true
ret b
end
end
if r.padding > 0:
mut pad := transport.NewBytes(r.padding)
crypto.RandomBytes(pad.p, r.padding)
pad.len = r.padding
transport.PutBytes(b, pad)
transport.FreeBytes(pad)
end
transport.Put32(b, _fnv1a32(b.p as u8*, b.len))
ret b
end
@en "DecodeRequest"
@fa "کدگشایی درخواست"
pub func DecodeRequest(b: transport.Bytes, r &: Request): bool:
if b.len < 4 + 38:
ret false
end
if transport.At(b, 0) != 1:
ret false
end
want := _fnv1a32(b.p as u8*, b.len - 4)
if want != transport.Peek32(b, b.len - 4):
ret false
end
r.version = 1
r.iv = transport.NewBytes(16)
transport.PutRaw(r.iv, transport.BytesPtr(b, 1), 16)
r.key = transport.NewBytes(16)
transport.PutRaw(r.key, transport.BytesPtr(b, 17), 16)
r.resp_v = transport.At(b, 33)
r.option = transport.At(b, 34)
pv := transport.At(b, 35)
r.padding = pv >> 4
r.security = pv & 15
r.command = transport.At(b, 37)
mut off := 38
if r.command == CmdTCP or r.command == CmdUDP:
mut a := transport.Addr {}
off = transport.ReadAddr(b, off, a)
if off < 0:
ret false
end
r.addr = a
else r.command != CmdMux:
ret false
end
ret off + r.padding + 4 == b.len
end
@en "net/vpn"
@fa "وی‌پی‌ان"
package vpn
import atomic
import sync
import term
import tls
import encoding.json
import net.tcp
import net.trojan
import net.transport
import net.tunnel
import net.internal.rawsock
extern:
func signal(sig: int, handler: void*): void*
end
@en "PENDING_PER_SOURCE"
@fa "سقف دست دادن مبدا"
pub const PENDING_PER_SOURCE := 32
mut _stop := atomic.NewFlag(false)
@en "TransportPending"
@fa "اتصال انتقال در انتظار"
pub struct TransportPending:
@en "raw"
@fa "خام"
pub raw: transport.Conn = transport.Conn {}
@en "settings"
@fa "تنظیمات"
pub settings: transport.Settings = transport.Settings {}
@en "upgraded"
@fa "ارتقا یافته"
pub upgraded: bool = false
@en "Valid"
@fa "معتبر"
pub func Valid(): bool:
ret this.raw.open
end
@en "Open"
@fa "گشودن"
pub func Open(): dyn tunnel.Stream:
mut c := this.raw
if not this.upgraded and not transport.Upgrade(c, this.settings):
transport.Close(c)
ret tunnel.ClosedStream {}
end
ret transport.AsStream(c)
end
@en "Abort"
@fa "رها کردن"
pub func Abort():
mut c := this.raw
transport.Close(c)
end
@en "Remote"
@fa "مبدا"
pub func Remote(): str:
ret this.raw.remote
end
end
@en "TransportAcceptor"
@fa "پذیرنده انتقال"
pub struct TransportAcceptor:
@en "listener"
@fa "شنونده"
pub listener: transport.Listener = transport.Listener {}
@en "settings"
@fa "تنظیمات"
pub settings: transport.Settings = transport.Settings {}
@en "Accept"
@fa "پذیرش"
pub func Accept(): dyn tunnel.Pending:
c := transport.Accept(this.listener)
ret TransportPending { raw = c, settings = this.settings, upgraded = true }
end
@en "Port"
@fa "درگاه"
pub func Port(): int:
ret transport.ListenerPort(this.listener)
end
@en "Ok"
@fa "معتبر"
pub func Ok(): bool:
ret transport.ListenerOk(this.listener)
end
@en "Close"
@fa "بستن"
pub func Close():
transport.CloseListener(this.listener)
end
end
@en "Listener"
@fa "شنونده"
pub struct Listener:
@en "server"
@fa "کارساز"
pub server: tunnel.AcceptServer = tunnel.AcceptServer {}
@en "has_server"
@fa "کارساز دارد"
pub has_server: bool = false
@en "trojan"
@fa "تروجان"
pub trojan: trojan.Server = trojan.Server {}
@en "port"
@fa "درگاه"
pub port: int = 0
@en "tag"
@fa "برچسب"
pub tag: str = ""
end
export:
func _on_signal(_sig: int):
atomic.Set(_stop, true)
end
end
func _trojan_listen(cfg: trojan.ServerConfig, port: int, s: transport.Settings): trojan.Server:
if s.tls: ret trojan.Serve(cfg, port) end
if s.network == "ws": ret trojan.ServeWS(cfg, port) end
ret trojan.ServePlain(cfg, port)
end
func _trojan_native(s: transport.Settings): bool:
if s.security == "reality": ret false end
if s.network == "ws": ret not s.tls end
ret s.network == "tcp" or s.network.len() == 0
end
func _trojan_server(ib: tunnel.InboundConfig, s: transport.Settings): Listener:
mut cfg := trojan.NewServerConfig(s.cert_file, s.key_file)
cfg.max_per_source = PENDING_PER_SOURCE
clients := json.Items(json.Get(ib.settings, "clients"))
defer clients.free()
repeat clients.len() in i:
trojan.AddPassword(cfg, json.Get(clients[i], "password"))
end
fb := json.Items(json.Get(ib.settings, "fallbacks"))
defer fb.free()
if fb.len() > 0:
dest := tunnel.ParseAddr(json.Get(fb[0], "dest"))
trojan.SetFallback(cfg, dest.host, dest.port)
end
srv := _trojan_listen(cfg, ib.port, s)
ret Listener { trojan = srv, port = trojan.ServerPort(srv), tag = ib.tag }
end
func _start_with(ib: tunnel.InboundConfig, h0: tunnel.ForwardHandler, stats: tunnel.Stats): Listener:
mut s := StreamSettings(ib.stream_settings)
s.max_per_source = PENDING_PER_SOURCE
if ib.protocol == "trojan" and _trojan_native(s): ret _trojan_server(ib, s) end
proto := tunnel.CreateInbound(ib)
mut h := h0
h.proto = proto
h.stats = stats
mut host := ib.listen
if host.len() == 0: host = "127.0.0.1" end
sock := rawsock.ListenOn(host, ib.port, rawsock.SOCK_STREAM)
mut bound := tcp.Server { fd = sock.fd }
if sock.fd >= 0: bound.port = rawsock.LocalPort(sock) end
tl := transport.ListenerFrom(bound, s)
acc := TransportAcceptor { listener = tl, settings = s }
mut srv := tunnel.NewAcceptServer(acc, host)
srv.per_source = PENDING_PER_SOURCE
l := Listener { server = srv, has_server = true, port = acc.Port(), tag = ib.tag }
if acc.Ok(): tunnel.StartAccepting(srv, proto, h) end
ret l
end
@en "InboundPolicy"
@fa "سیاست درون‌سو"
pub func InboundPolicy(ib: tunnel.InboundConfig): tunnel.DestPolicy:
mut p := tunnel.NewDestPolicy()
host := ib.listen
if json.Get(ib.settings, "allowPrivate") == "true": tunnel.PolicyAllowPrivate(p, true) end
allow := json.Items(json.Get(ib.settings, "allowCidr"))
deny := json.Items(json.Get(ib.settings, "denyCidr"))
dallow := json.Items(json.Get(ib.settings, "allowDomain"))
ddeny := json.Items(json.Get(ib.settings, "denyDomain"))
repeat allow.len() in i:
tunnel.PolicyAllowCidr(p, json.Unquote(allow[i]))
end
repeat deny.len() in i:
tunnel.PolicyDenyCidr(p, json.Unquote(deny[i]))
end
repeat dallow.len() in i:
tunnel.PolicyAllowSuffix(p, json.Unquote(dallow[i]))
end
repeat ddeny.len() in i:
tunnel.PolicyDenySuffix(p, json.Unquote(ddeny[i]))
end
allow.free()
deny.free()
dallow.free()
ddeny.free()
if _opts.use_doh: tunnel.PolicySetResolver(p, DohResolver { resolver = _opts.resolver }) end
ret tunnel.PolicyForBind(p, host)
end
@en "Start"
@fa "شروع"
pub func Start(ib: tunnel.InboundConfig, dialer: dyn tunnel.Dialer, stats: tunnel.Stats): Listener:
g := tunnel.Guard(dialer, InboundPolicy(ib))
ret _start_with(ib, tunnel.NewGuardedForwarder(g, tunnel.NullProtocol {}), stats)
end
@en "StartRouted"
@fa "شروع با مسیریاب"
pub func StartRouted(ib: tunnel.InboundConfig, rd: tunnel.RouterDialer, stats: tunnel.Stats): Listener:
g := tunnel.GuardRouter(rd, InboundPolicy(ib))
ret _start_with(ib, tunnel.NewGuardedForwarder(g, tunnel.NullProtocol {}), stats)
end
@en "StartAll"
@fa "شروع همه"
pub func StartAll(c: tunnel.Config, stats: tunnel.Stats): Vector<Listener>:
dialer := BuildDialer(c)
mut out := Vector {} as Vector<Listener>
repeat c.inbounds.len() in i:
out.push(StartRouted(c.inbounds[i], dialer, stats))
end
ret out
end
@en "Ok"
@fa "معتبر"
pub func Ok(l: Listener): bool:
if l.trojan.ok: ret true end
ret l.has_server and l.server.Ok()
end
@en "Stop"
@fa "توقف"
pub func Stop(l: Listener):
if l.trojan.ok:
trojan.Stop(l.trojan)
ret
end
if l.has_server: l.server.Stop() end
end
@en "Summary"
@fa "خلاصه"
pub func Summary(st: tunnel.Stats): str:
ret "up " + term.FormatBytes(st.Up()) + "  down " + term.FormatBytes(st.Down()) + "  conns " + st.Total() + "  active " + st.Active() + "  failed " + st.Failed()
end
@en "Wait"
@fa "انتظار"
pub func Wait(st: tunnel.Stats, every: int, limit: int):
_p1 := signal(2, &_on_signal)
_p2 := signal(15, &_on_signal)
mut t := 0
until not atomic.Get(_stop) and (limit <= 0 or t < limit):
sync.SleepMs(1000)
t++
if every > 0 and t % every == 0: println "[" + t + "s] " + Summary(st) end
end
end
@en "RunConfig"
@fa "اجرای پیکربندی"
pub func RunConfig(path: str, every: int, limit: int): int:
cfg := tunnel.LoadConfig(path)
errs := tunnel.ValidateConfig(cfg)
each e in errs: printerrln "config:", e end
if errs.len() > 0: ret 1 end
stats := tunnel.NewStats()
listeners := StartAll(cfg, stats)
mut failed := false
each l in listeners:
if Ok(l):
println l.tag, "listening on port", l.port
else:
printerrln l.tag, "could not listen (port in use or bad certificate?)"
failed = true
end
end
if failed: ret 1 end
Wait(stats, every, limit)
each l in listeners: Stop(l) end
println "bye,", Summary(stats)
ret 0
end
@en "net/vpn"
@fa "وی‌پی‌ان"
package vpn
import str
import encoding.json
import net.doh
import net.socks
import net.httpproxy
import net.trojan
import net.vless
import net.vmess
import net.shadowsocks
import net.transport
import net.tunnel
mut _opts := Options {}
@en "Options"
@fa "گزینه‌ها"
pub struct Options:
@en "fragment"
@fa "تکه‌تکه کردن"
pub fragment: bool = false
@en "fragment_min"
@fa "کمینه تکه"
pub fragment_min: int = 4
@en "fragment_max"
@fa "بیشینه تکه"
pub fragment_max: int = 12
@en "fragment_delay_ms"
@fa "تاخیر تکه"
pub fragment_delay_ms: int = 5
@en "fragment_mode"
@fa "حالت تکه تکه کردن"
pub fragment_mode: str = "tcp"
@en "fragment_sni"
@fa "برش نام سرور"
pub fragment_sni: bool = false
@en "fragment_writes"
@fa "شمار نوشتن های تکه شده"
pub fragment_writes: int = 1
@en "read_timeout_ms"
@fa "مهلت بی کاری خواندن"
pub read_timeout_ms: int = 0
@en "write_timeout_ms"
@fa "مهلت بی کاری نوشتن"
pub write_timeout_ms: int = 0
@en "use_doh"
@fa "استفاده از دی او اچ"
pub use_doh: bool = false
@en "resolver"
@fa "حل‌کننده"
pub resolver: doh.Resolver = doh.Resolver {}
end
@en "DohResolver"
@fa "حل‌کننده دی او اچ"
pub struct DohResolver:
@en "resolver"
@fa "حل‌کننده"
pub resolver: doh.Resolver = doh.Resolver {}
@en "ipv6"
@fa "نسخه شش"
pub ipv6: bool = true
@en "Lookup"
@fa "جستجو"
pub func Lookup(host: str): tunnel.LookupResult:
mut out := tunnel.LookupResult {}
a := doh.LookupA(this.resolver, host)
repeat a.len() in i:
out.ips.push(a[i])
end
if this.ipv6:
b := doh.LookupAAAA(this.resolver, host)
repeat b.len() in i:
out.ips.push(b[i])
end
end
ret out
end
end
@en "TransportDialer"
@fa "شماره‌گیر انتقال"
pub struct TransportDialer:
@en "settings"
@fa "تنظیمات"
pub settings: transport.Settings = transport.Settings {}
@en "Dial"
@fa "اتصال"
pub func Dial(target: tunnel.Addr): dyn tunnel.Stream:
c := _connect(target.host, target.port, this.settings)
if not transport.Ok(c): ret tunnel.ClosedStream {} end
ret transport.AsStream(c)
end
@en "Name"
@fa "نام"
pub func Name(): str:
ret "transport"
end
end
@en "VlessDialer"
@fa "شماره‌گیر وی‌لس"
pub struct VlessDialer:
@en "node"
@fa "گره"
pub node: tunnel.Node = tunnel.Node {}
@en "Dial"
@fa "اتصال"
pub func Dial(target: tunnel.Addr): dyn tunnel.Stream:
t := _connect(this.node.host, this.node.port, NodeSettings(this.node))
if not transport.Ok(t): ret tunnel.ClosedStream {} end
c := vless.Client(t, this.node.uuid, this.node.flow, vless.CmdTCP, transport.NewAddr(target.host, target.port))
if not c.ok: ret tunnel.ClosedStream {} end
ret vless.AsStream(c)
end
@en "Name"
@fa "نام"
pub func Name(): str:
ret "vless"
end
end
@en "VmessDialer"
@fa "شماره‌گیر وی‌مس"
pub struct VmessDialer:
@en "node"
@fa "گره"
pub node: tunnel.Node = tunnel.Node {}
@en "Dial"
@fa "اتصال"
pub func Dial(target: tunnel.Addr): dyn tunnel.Stream:
t := _connect(this.node.host, this.node.port, NodeSettings(this.node))
if not transport.Ok(t): ret tunnel.ClosedStream {} end
sec := _vmess_security(this.node.method)
c := vmess.Client(t, this.node.uuid, sec, vmess.DefaultOption(sec), vmess.CmdTCP, transport.NewAddr(target.host, target.port))
if not c.ok: ret tunnel.ClosedStream {} end
ret vmess.AsStream(c)
end
@en "Name"
@fa "نام"
pub func Name(): str:
ret "vmess"
end
end
@en "SsDialer"
@fa "شماره‌گیر شدوساکس"
pub struct SsDialer:
@en "node"
@fa "گره"
pub node: tunnel.Node = tunnel.Node {}
@en "Dial"
@fa "اتصال"
pub func Dial(target: tunnel.Addr): dyn tunnel.Stream:
cfg := shadowsocks.ToConfig(shadowsocks.Uri { host = _resolve(this.node.host), port = this.node.port, method = this.node.method, password = this.node.password, plugin = this.node.plugin })
c := shadowsocks.Dial(cfg, target.host, target.port)
if not shadowsocks.Ok(c): ret tunnel.ClosedStream {} end
ret shadowsocks.AsStream(c)
end
@en "Name"
@fa "نام"
pub func Name(): str:
ret "shadowsocks"
end
end
@en "OutMaker"
@fa "خروجی‌ساز"
pub struct OutMaker:
@en "proto"
@fa "پروتکل"
pub proto: str = ""
@en "Protocol"
@fa "پروتکل"
pub func Protocol(): str:
ret this.proto
end
@en "Make"
@fa "ساخت"
pub func Make(cfg: tunnel.OutboundConfig): dyn tunnel.Dialer:
ret DialerFromNode(tunnel.NodeFromOutbound(cfg))
end
end
@en "VlessInbound"
@fa "درون‌سو وی‌لس"
pub struct VlessInbound:
@en "users"
@fa "کاربران"
pub users: Vector<vless.User> = Vector {}
@en "Name"
@fa "نام"
pub func Name(): str:
ret "vless"
end
@en "Handshake"
@fa "دست‌دهی"
pub func Handshake(s: dyn tunnel.Stream): tunnel.Session:
c := vless.AcceptOver(s, this.users)
if not c.ok: ret tunnel.Session { error = c.err } end
ret tunnel.Session { ok = true, target = tunnel.NewAddr(c.req.addr.host, c.req.addr.port), protocol = "vless", user = c.user, wrapped = true, stream = vless.AsStream(c) }
end
@en "Reply"
@fa "پاسخ"
pub func Reply(_s: dyn tunnel.Stream, sess: tunnel.Session, ok: bool):
if not ok: sess.stream.Close() end
end
end
@en "VmessInbound"
@fa "درون‌سو وی‌مس"
pub struct VmessInbound:
@en "users"
@fa "کاربران"
pub users: Vector<vmess.User> = Vector {}
@en "replay"
@fa "پالایه تکرار"
pub replay: vmess.ReplayFilter = vmess.NewReplayFilter()
@en "Name"
@fa "نام"
pub func Name(): str:
ret "vmess"
end
@en "Handshake"
@fa "دست‌دهی"
pub func Handshake(s: dyn tunnel.Stream): tunnel.Session:
c := vmess.AcceptOver(s, this.users, this.replay)
if not c.ok: ret tunnel.Session { error = c.err } end
ret tunnel.Session { ok = true, target = tunnel.NewAddr(c.req.addr.host, c.req.addr.port), protocol = "vmess", wrapped = true, stream = vmess.AsStream(c) }
end
@en "Reply"
@fa "پاسخ"
pub func Reply(_s: dyn tunnel.Stream, sess: tunnel.Session, ok: bool):
if not ok: sess.stream.Close() end
end
end
@en "SsInbound"
@fa "درون‌سو شدوساکس"
pub struct SsInbound:
@en "server"
@fa "کارساز"
pub server: shadowsocks.Server = shadowsocks.Server {}
@en "Name"
@fa "نام"
pub func Name(): str:
ret "shadowsocks"
end
@en "Handshake"
@fa "دست‌دهی"
pub func Handshake(s: dyn tunnel.Stream): tunnel.Session:
c := shadowsocks.AcceptOver(this.server, s)
if not shadowsocks.Ok(c): ret tunnel.Session { error = "shadowsocks handshake failed" } end
t := shadowsocks.TargetOf(c)
ret tunnel.Session { ok = true, target = tunnel.NewAddr(t.host, t.port), protocol = "shadowsocks", wrapped = true, stream = shadowsocks.AsStream(c) }
end
@en "Reply"
@fa "پاسخ"
pub func Reply(_s: dyn tunnel.Stream, sess: tunnel.Session, ok: bool):
if not ok: sess.stream.Close() end
end
end
@en "InMaker"
@fa "درون‌سوساز"
pub struct InMaker:
@en "proto"
@fa "پروتکل"
pub proto: str = ""
@en "Protocol"
@fa "پروتکل"
pub func Protocol(): str:
ret this.proto
end
@en "Make"
@fa "ساخت"
pub func Make(cfg: tunnel.InboundConfig): dyn tunnel.InboundProtocol:
clients := json.Items(json.Get(cfg.settings, "clients"))
defer clients.free()
if this.proto == "vless":
mut p := VlessInbound {}
repeat clients.len() in i:
p.users.push(vless.NewUser(json.Get(clients[i], "id"), json.Get(clients[i], "flow")))
end
ret p
end
if this.proto == "vmess":
mut p := VmessInbound {}
repeat clients.len() in i:
p.users.push(vmess.NewUser(json.Get(clients[i], "id")))
end
ret p
end
if this.proto == "trojan":
mut p := trojan.NewInbound()
repeat clients.len() in i:
trojan.InboundAddPassword(p, json.Get(clients[i], "password"))
end
ret p
end
if this.proto == "shadowsocks":
mut obfs := ""
plugin := json.Get(cfg.settings, "plugin")
if plugin.len() > 0:
pl := shadowsocks.ParsePlugin(plugin)
obfs = shadowsocks.PluginGet(pl, "obfs", "")
shadowsocks.PluginFree(pl)
end
ret SsInbound { server = shadowsocks.ListenObfs(0, json.Get(cfg.settings, "method"), json.Get(cfg.settings, "password"), obfs) }
end
if this.proto == "socks": ret socks.NewInbound(socks.ServerConfig {}) end
if this.proto == "http": ret httpproxy.NewInbound(httpproxy.ServerConfig {}) end
mut m := tunnel.NewMixed()
tunnel.MixedSetSocks5(m, socks.NewInbound(socks.ServerConfig {}))
tunnel.MixedSetSocks4(m, socks.NewInbound4(socks.ServerConfig {}))
tunnel.MixedSetHttp(m, httpproxy.NewInbound(httpproxy.ServerConfig {}))
ret m
end
end
func _resolve(host: str): str:
if not _opts.use_doh or tunnel.IsIP(host): ret host end
ips := doh.LookupHost(_opts.resolver, host)
defer ips.free()
if ips.len() == 0: ret host end
ret ips[0]
end
func _connect(host: str, port: int, s: transport.Settings): transport.Conn:
mut st := s
if st.tls and st.sni.len() == 0: st.sni = host end
ret transport.Dial(_resolve(host), port, st)
end
func _vmess_security(method: str): int:
if method == "chacha20-poly1305": ret vmess.SecChaCha20Poly1305 end
if method == "none": ret vmess.SecNone end
if method == "zero": ret vmess.SecZero end
ret vmess.SecAES128GCM
end
func _fragment_into(s &: transport.Settings):
s.fragment = true
s.fragment_min = _opts.fragment_min
s.fragment_max = _opts.fragment_max
s.fragment_delay_ms = _opts.fragment_delay_ms
s.fragment_mode = _opts.fragment_mode
s.fragment_sni = _opts.fragment_sni
s.fragment_writes = _opts.fragment_writes
end
@en "StreamSettings"
@fa "تنظیمات جریان"
pub func StreamSettings(raw: str): transport.Settings:
mut s := transport.Settings {}
n := json.Get(raw, "network")
if n.len() > 0: s.network = n end
s.tls = json.Get(raw, "security") == "tls"
t := json.Get(raw, "tlsSettings")
s.sni = json.Get(t, "serverName")
s.allow_insecure = json.Get(t, "allowInsecure") == "true"
certs := json.Items(json.Get(t, "certificates"))
defer certs.free()
if certs.len() > 0:
s.cert_file = json.Get(certs[0], "certificateFile")
s.key_file = json.Get(certs[0], "keyFile")
end
mut w := json.Get(raw, "wsSettings")
if s.network == "httpupgrade": w = json.Get(raw, "httpupgradeSettings") end
p := json.Get(w, "path")
if p.len() > 0: s.path = p end
s.host = json.Get(json.Get(w, "headers"), "Host")
if json.Get(raw, "security") == "reality":
s.security = "reality"
s.tls = false
r := json.Get(raw, "realitySettings")
s.reality.server_name = json.Get(r, "serverName")
s.reality.public_key = json.Get(r, "publicKey")
s.reality.short_id = json.Get(r, "shortId")
s.reality.spider_x = json.Get(r, "spiderX")
fp := json.Get(r, "fingerprint")
if fp.len() > 0: s.reality.fingerprint = fp end
s.sni = s.reality.server_name
s.reality_server.private_key = json.Get(r, "privateKey")
s.reality_server.dest = json.Get(r, "dest")
td := json.Get(r, "maxTimeDiff")
if td.len() > 0: s.reality_server.max_time_diff = td.to_int() end
names := json.Items(json.Get(r, "serverNames"))
defer names.free()
mut nl := ""
repeat names.len() in i:
if i > 0: nl += "," end
nl += json.Unquote(names[i])
end
s.reality_server.server_names = nl
ids := json.Items(json.Get(r, "shortIds"))
defer ids.free()
mut il := ""
repeat ids.len() in i:
if i > 0: il += "," end
il += json.Unquote(ids[i])
end
s.reality_server.short_ids = il
end
if s.network == "grpc":
g := json.Get(raw, "grpcSettings")
s.service_name = json.Get(g, "serviceName")
if json.Get(g, "multiMode") == "true": s.grpc_mode = "multi" end
end
tmo := json.Get(raw, "timeouts")
if tmo.len() > 0:
s.read_timeout_ms = json.Get(tmo, "read").to_int()
s.write_timeout_ms = json.Get(tmo, "write").to_int()
end
frag := json.Get(raw, "fragment")
if frag.len() > 0 and (s.tls or s.security == "reality"):
_fragment_into(s)
mode := json.Get(frag, "mode")
if mode.len() > 0: s.fragment_mode = mode end
if json.Get(frag, "sni") == "true": s.fragment_sni = true end
w := json.Get(frag, "writes").to_int()
if w > 0: s.fragment_writes = w end
lo := json.Get(frag, "min").to_int()
hi := json.Get(frag, "max").to_int()
if lo > 0 or hi > 0:
s.fragment_min = lo
s.fragment_max = hi
end
dl := json.Get(frag, "delay").to_int()
if dl > 0: s.fragment_delay_ms = dl end
end
ret s
end
@en "NodeSettings"
@fa "تنظیمات گره"
pub func NodeSettings(n: tunnel.Node): transport.Settings:
mut s := transport.Settings { network = n.network, tls = n.tls, sni = n.sni, alpn = n.alpn, fingerprint = n.fingerprint, allow_insecure = n.allow_insecure, host = n.host_header }
if n.path.len() > 0: s.path = n.path end
if n.network == "grpc":
s.service_name = n.service_name
if s.service_name.len() == 0: s.service_name = n.path end
if n.grpc_mode == "multi": s.grpc_mode = "multi" end
end
if n.security == "reality":
s.security = "reality"
s.tls = false
s.reality.server_name = n.sni
s.reality.public_key = n.public_key
s.reality.short_id = n.short_id
s.reality.spider_x = n.spider_x
if n.fingerprint.len() > 0: s.reality.fingerprint = n.fingerprint end
s.reality.alpn = n.alpn
end
s.read_timeout_ms = _opts.read_timeout_ms
s.write_timeout_ms = _opts.write_timeout_ms
if (s.tls or s.security == "reality") and _opts.fragment:
_fragment_into(s)
end
ret s
end
@en "DialerFromNode"
@fa "شماره‌گیر از گره"
pub func DialerFromNode(n: tunnel.Node): dyn tunnel.Dialer:
plain := TransportDialer { settings = NodeSettings(n) }
if n.protocol == "vless": ret VlessDialer { node = n } end
if n.protocol == "vmess": ret VmessDialer { node = n } end
if n.protocol == "ss" or n.protocol == "shadowsocks": ret SsDialer { node = n } end
if n.protocol == "trojan":
ret tunnel.Via(plain, trojan.NewConnector(n.host, n.port, n.password))
end
if n.protocol == "socks":
ret tunnel.Via(plain, socks.NewConnector(socks.Client { host = n.host, port = n.port }))
end
if n.protocol == "http":
ret tunnel.Via(plain, httpproxy.NewConnector(httpproxy.Client { host = n.host, port = n.port }))
end
ret tunnel.Block()
end
@en "ToTunnelAddr"
@fa "نشانی تونل از انتقال"
pub func ToTunnelAddr(a: transport.Addr): tunnel.Addr:
ret tunnel.NewAddr(a.host, a.port)
end
@en "ToTransportAddr"
@fa "نشانی انتقال از تونل"
pub func ToTransportAddr(a: tunnel.Addr): transport.Addr:
ret transport.NewAddr(a.host, a.port)
end
@en "RegisterWith"
@fa "ثبت با گزینه‌ها"
pub func RegisterWith(o: Options):
_opts = o
each p in ["vless", "vmess", "trojan", "shadowsocks", "ss", "socks", "http"]:
tunnel.RegisterOutbound(OutMaker { proto = p })
end
each p in ["mixed", "socks", "http", "trojan", "vless", "vmess", "shadowsocks"]:
tunnel.RegisterInbound(InMaker { proto = p })
end
end
@en "Register"
@fa "ثبت"
pub func Register():
RegisterWith(Options {})
end
@en "BuildDialer"
@fa "ساخت شماره‌گیر"
pub func BuildDialer(c: tunnel.Config): tunnel.RouterDialer:
mut rd := tunnel.BuildDialer(c)
if _opts.use_doh:
tunnel.SetResolver(rd.router, DohResolver { resolver = _opts.resolver }, 300000 as i64)
end
ret rd
end
@en "net/websocket"
@fa "وب‌سوکت"
package websocket
import net.internal.rawsock
import mem
import str
import rand
import encoding
import crypto
import tls
import time
const WS_GUID := "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"
@en "NONE"
@fa "هیچ"
pub const NONE := 0
@en "TEXT"
@fa "متن"
pub const TEXT := 1
@en "BINARY"
@fa "دودویی"
pub const BINARY := 2
@en "CLOSE"
@fa "بسته"
pub const CLOSE := 8
@en "PING"
@fa "پینگ"
pub const PING := 9
@en "PONG"
@fa "پونگ"
pub const PONG := 10
@en "TIMEOUT"
@fa "مهلت"
pub const TIMEOUT := 100
mut _tls_slots := Vector {} as Vector<tls.Conn>
mut _tls_free := Vector {} as Vector<int>
mut _wss_cfg := tls.ServerConfig {}
@en "Server"
@fa "سرور"
pub struct Server:
@en "fd"
@fa "توصیفگر سوکت"
pub fd: i64 = 0 - 1
@en "port"
@fa "درگاه"
pub port: int = 0
end
@en "Conn"
@fa "اتصال وب"
pub struct Conn:
@en "fd"
@fa "توصیفگر سوکت"
pub fd: i64 = 0 - 1
@en "open"
@fa "باز"
pub open: bool = false
@en "path"
@fa "مسیر"
pub path: str = ""
@en "client"
@fa "سمت کارخواه"
pub client: bool = false
@en "buf"
@fa "بافر دریافت"
pub buf: void* = null
@en "blen"
@fa "طول بافر"
pub blen: int = 0
@en "bcap"
@fa "ظرفیت بافر"
pub bcap: int = 0
@en "secure"
@fa "رمزشده"
pub secure: bool = false
@en "tls_idx"
@fa "شماره تی ال اس"
pub tls_idx: int = 0 - 1
@en "hdr"
@fa "سرآیندهای دست‌دهی"
pub hdr: str = ""
@en "acc"
@fa "متن جمع‌شده"
pub acc: str = ""
@en "acc_kind"
@fa "نوع پیام جمع‌شده"
pub acc_kind: int = 0
@en "fragmented"
@fa "چندقابی"
pub fragmented: bool = false
@en "bin"
@fa "بافر دودویی"
pub bin: void* = null
@en "binlen"
@fa "طول بافر دودویی"
pub binlen: int = 0
@en "bincap"
@fa "ظرفیت بافر دودویی"
pub bincap: int = 0
end
@en "Message"
@fa "پیام"
pub struct Message:
@en "kind"
@fa "نوع"
pub kind: int = 0
@en "text"
@fa "متن"
pub text: str = ""
@en "data"
@fa "داده"
pub data: void* = null
@en "len"
@fa "طول"
pub len: int = 0
end
@en "RoomMembers"
@fa "اعضای اتاق"
pub struct RoomMembers:
@en "items"
@fa "اتصال‌ها"
pub items: Vector<Conn> = Vector {}
end
@en "Hub"
@fa "هاب"
pub struct Hub:
@en "rooms"
@fa "اتاق‌ها"
pub rooms: HashMap<str, RoomMembers> = HashMap {} as HashMap<str, RoomMembers>
end
func _tls_store(tc: tls.Conn): int:
if _tls_free.len() > 0:
idx := _tls_free.get(_tls_free.len() - 1)
_tls_free.remove_at(_tls_free.len() - 1)
_tls_slots.set(idx, tc)
ret idx
end
_tls_slots.push(tc)
ret _tls_slots.len() - 1
end
func _tls_release(idx: int):
if idx < 0 or idx >= _tls_slots.len():
ret
end
_tls_free.push(idx)
end
func _tls_get(idx: int): tls.Conn:
ret _tls_slots.get(idx)
end
func _tls_put(idx: int, tc: tls.Conn):
_tls_slots.set(idx, tc)
end
func _pow2(n: int): i64:
mut r := 1 as i64
repeat n:
r *= 2
end
ret r
end
func _xor8(a0: int, b0: int): int:
mut a := a0
mut b := b0
mut r := 0
mut p := 1
repeat 8:
if a % 2 != b % 2:
r += p
end
a /= 2
b /= 2
p *= 2
end
ret r
end
func _bget(p: void*, i: int): int:
bp := p as i8*
mut v := bp[i] as int
if v < 0:
v += 256
end
ret v
end
func _bput(p: void*, i: int, v: int):
bp := p as i8*
bp[i] = v as i8
end
func _copy_raw(buf: void*, off: int, payload: void*, n: int):
if n <= 0:
ret
end
mem.Copy(((buf as i64) + (off as i64)) as void*, payload, n as u64)
end
func _byte_at(s: str, i: int): int:
mut v := char_code(s.substr(i, 1))
if v < 0:
v += 256
end
ret v
end
func _no_delay(fd: i64):
if fd < 0:
ret
end
rawsock.SetNoDelay(rawsock.FromFd(fd), true)
end
func _new_conn(fd: i64, client: bool): Conn:
ret Conn { fd = fd, open = false, client = client, buf = mem.Allocate(4096 as u64), blen = 0, bcap = 4096 }
end
func _ensure(c &: Conn, need: int):
if need <= c.bcap:
ret
end
mut ncap := c.bcap * 2
if ncap < need:
ncap = need
end
nb := mem.Reallocate(c.buf, ncap as u64)
if nb != null:
c.buf = nb
c.bcap = ncap
end
end
func _fill(c &: Conn): int:
if c.bcap - c.blen < 1024:
_ensure(c, c.bcap + 4096)
end
space := c.bcap - c.blen
if space <= 0:
ret 0 - 1
end
dst := ((c.buf as i64) + (c.blen as i64)) as void*
mut n := 0
if c.secure:
mut tc := _tls_get(c.tls_idx)
n = tls.ReadBytes(tc, dst, space)
_tls_put(c.tls_idx, tc)
else:
n = rawsock.RecvBytes(rawsock.FromFd(c.fd), dst, space)
end
if n > 0:
c.blen += n
end
ret n
end
func _readable(c &: Conn, timeout_ms: int): bool:
if c.secure:
tc := _tls_get(c.tls_idx)
if tls.Readable(tc):
ret true
end
ret rawsock.WaitReadable(rawsock.FromFd(tls.Fd(tc)), timeout_ms)
end
if c.fd < 0:
ret false
end
ret rawsock.WaitReadable(rawsock.FromFd(c.fd), timeout_ms)
end
func _bin_ensure(c &: Conn, need: int):
if need <= c.bincap:
ret
end
mut ncap := c.bincap * 2
if ncap < need:
ncap = need
end
if ncap < 1024:
ncap = 1024
end
mut nb := null as void*
if c.bin == null:
nb = mem.Allocate(ncap as u64)
else:
nb = mem.Reallocate(c.bin, ncap as u64)
end
if nb != null:
c.bin = nb
c.bincap = ncap
end
end
func _bin_reset(c &: Conn):
c.binlen = 0
end
func _bin_append(c &: Conn, off: int, plen: int, masked: bool, moff: int):
if plen <= 0:
ret
end
_bin_ensure(c, c.binlen + plen)
if c.bincap < c.binlen + plen:
ret
end
dst := ((c.bin as i64) + (c.binlen as i64)) as i8*
repeat plen in i:
mut b := _bget(c.buf, off + i)
if masked:
b = _xor8(b, _bget(c.buf, moff + (i % 4)))
end
dst[i] = b as i8
end
c.binlen += plen
end
func _dial_wss(host: str, port: int, path: str, extra: str, insecure: bool): Conn:
mut cfg := tls.NewConfig(host)
cfg.insecure_skip_verify = insecure
mut tc := tls.Dial(host, port, cfg)
mut c := _new_conn(0 - 1, true)
c.secure = true
c.tls_idx = _tls_store(tc)
if not tls.ConnOk(tc):
c.open = false
ret c
end
key := encoding.Base64Encode(rand.Alnum(16))
req := HandshakeRequestWith(host, path, key, extra)
n := tls.Write(tc, req)
_tls_put(c.tls_idx, tc)
if n <= 0:
_shutdown(c)
ret c
end
hdr := _read_headers(c)
c.hdr = hdr
if not str.Contains(hdr, " 101 "):
_shutdown(c)
ret c
end
if not str.Contains(hdr, AcceptKey(key)):
_shutdown(c)
ret c
end
c.path = path
c.open = true
ret c
end
func _bin_str(c &: Conn): str:
if c.binlen <= 0:
ret ""
end
mut sb := str.NewBuilder()
defer str.BufFree(sb)
bp := c.bin as i8*
repeat c.binlen in i:
mut v := bp[i] as int
if v < 0:
v += 256
end
str.BufAppendChar(sb, v)
end
ret str.BufStr(sb)
end
func _consume(c &: Conn, n: int):
if n <= 0:
ret
end
if n >= c.blen:
c.blen = 0
ret
end
src := ((c.buf as i64) + (n as i64)) as void*
mem.MemMove(c.buf, src, (c.blen - n) as u64)
c.blen -= n
end
func _shutdown(c &: Conn):
if c.secure and c.tls_idx >= 0:
mut tc := _tls_get(c.tls_idx)
tls.Close(tc)
_tls_put(c.tls_idx, tc)
_tls_release(c.tls_idx)
c.tls_idx = 0 - 1
else c.secure:
c.open = false
else:
if c.fd >= 0:
rawsock.Close(rawsock.FromFd(c.fd))
end
end
c.open = false
c.fd = 0 - 1
if c.buf != null:
mem.Free(c.buf)
c.buf = null
c.blen = 0
c.bcap = 0
end
if c.bin != null:
mem.Free(c.bin)
c.bin = null
c.binlen = 0
c.bincap = 0
end
end
func _payload_str(c &: Conn, off: int, plen: int, masked: bool, moff: int): str:
mut sb := str.NewBuilder()
defer str.BufFree(sb)
repeat plen in i:
mut b := _bget(c.buf, off + i)
if masked:
mk := _bget(c.buf, moff + (i % 4))
b = _xor8(b, mk)
end
str.BufAppendChar(sb, b)
end
result := str.BufStr(sb)
ret result
end
func _find_hdr_end(c &: Conn): int:
mut i := 0
until i + 3 < c.blen:
if _bget(c.buf, i) == 13 and _bget(c.buf, i + 1) == 10 and _bget(c.buf, i + 2) == 13 and _bget(c.buf, i + 3) == 10:
ret i
end
i++
end
ret 0 - 1
end
func _read_headers(c &: Conn): str:
mut hdr := ""
mut going := true
until going:
e := _find_hdr_end(c)
if e >= 0:
hdr = _payload_str(c, 0, e + 4, false, 0)
_consume(c, e + 4)
going = false
else:
if c.blen > 65536:
going = false
else:
n := _fill(c)
if n <= 0:
going = false
end
end
end
end
ret hdr
end
func _request_path(request: str): str:
sp := str.Find(request, " ")
if sp < 0: ret "" end
rest := request.substr(sp + 1, request.len() - sp - 1)
e := str.Find(rest, " ")
if e < 0: ret "" end
ret rest.substr(0, e)
end
func _frame_size(c &: Conn): int:
if c.blen < 2:
ret 0
end
b1 := _bget(c.buf, 1)
masked := b1 / 128
mut plen := (b1 % 128) as i64
mut hlen := 2
if plen == 126:
if c.blen < 4:
ret 0
end
plen = (_bget(c.buf, 2) * 256 + _bget(c.buf, 3)) as i64
hlen = 4
else plen == 127:
if c.blen < 10:
ret 0
end
mut v := 0 as i64
repeat 8 in k:
v = v * 256 + (_bget(c.buf, 2 + k) as i64)
end
if v < (0 as i64) or v > 104857600:
ret 0 - 1
end
plen = v
hlen = 10
end
if masked == 1:
hlen += 4
end
need := (hlen as i64) + plen
if (c.blen as i64) < need:
ret 0
end
ret need as int
end
func _send_frame(c &: Conn, opcode: int, payload: str): int:
ret _send_frame_raw(c, opcode, payload as void*, payload.len())
end
func _send_frame_raw(c &: Conn, opcode: int, payload: void*, plen: int): int:
if not c.open and opcode != 8:
ret 0 - 1
end
if not c.secure and c.fd < 0:
ret 0 - 1
end
mut hlen := 2
if plen >= 126 and plen < 65536:
hlen = 4
end
if plen >= 65536:
hlen = 10
end
mut mlen := 0
if c.client:
mlen = 4
end
total := hlen + mlen + plen
buf := mem.Allocate(total as u64)
defer mem.Free(buf)
_bput(buf, 0, 128 + opcode)
mut maskbit := 0
if c.client:
maskbit = 128
end
if plen < 126:
_bput(buf, 1, maskbit + plen)
else plen < 65536:
_bput(buf, 1, maskbit + 126)
_bput(buf, 2, plen / 256)
_bput(buf, 3, plen % 256)
else:
_bput(buf, 1, maskbit + 127)
p64 := plen as i64
repeat 8 in k:
_bput(buf, 2 + k, ((p64 / _pow2(8 * (7 - k))) % 256) as int)
end
end
if c.client:
m0 := rand.Int32Range(0, 255)
m1 := rand.Int32Range(0, 255)
m2 := rand.Int32Range(0, 255)
m3 := rand.Int32Range(0, 255)
_bput(buf, hlen, m0)
_bput(buf, hlen + 1, m1)
_bput(buf, hlen + 2, m2)
_bput(buf, hlen + 3, m3)
_copy_raw(buf, hlen + 4, payload, plen)
body := ((buf as i64) + ((hlen + 4) as i64)) as i8*
repeat plen in i:
mi := i % 4
mut mk := m0
if mi == 1: mk = m1 end
if mi == 2: mk = m2 end
if mi == 3: mk = m3 end
mut v := body[i] as int
if v < 0: v += 256 end
body[i] = _xor8(v, mk) as i8
end
else:
_copy_raw(buf, hlen, payload, plen)
end
mut sent := 0
if c.secure and c.tls_idx < 0:
ret 0 - 1
else c.secure:
mut tc := _tls_get(c.tls_idx)
sent = tls.WriteBytes(tc, buf, total)
_tls_put(c.tls_idx, tc)
else:
sent = rawsock.SendBytes(rawsock.FromFd(c.fd), buf, total)
end
if sent != total:
c.open = false
ret 0 - 1
end
ret 0
end
func _header_value(headers: str, name_lower: str): str:
lower := str.Lower(headers)
idx := str.Find(lower, name_lower)
if idx < 0:
ret ""
end
ci := str.IndexFrom(headers, ":", idx)
if ci < 0:
ret ""
end
mut e := str.IndexFrom(headers, "\r", ci)
if e < 0:
e = headers.len()
end
ret str.Trim(headers.substr(ci + 1, e - ci - 1))
end
@en "AcceptKey"
@fa "کلید پذیرش"
pub func AcceptKey(key: str): str:
ret crypto.Sha1Base64(key + WS_GUID)
end
@en "HandshakeResponse"
@fa "پاسخ دست دادن"
pub func HandshakeResponse(request: str): str:
key := _header_value(request, "sec-websocket-key")
if key == "":
ret ""
end
ret "HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: " + AcceptKey(key) + "\r\n\r\n"
end
@en "HandshakeRequest"
@fa "درخواست دست دادن"
pub func HandshakeRequest(host: str, path: str, key: str): str:
ret HandshakeRequestWith(host, path, key, "")
end
@en "HandshakeRequestWith"
@fa "درخواست دست دادن با سربرگ"
pub func HandshakeRequestWith(host: str, path: str, key: str, extra: str): str:
mut req := "GET " + path + " HTTP/1.1\r\nHost: " + host + "\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: " + key + "\r\nSec-WebSocket-Version: 13\r\n"
if str.Trim(extra).len() > 0:
req += extra
if not str.EndsWith(extra, "\r\n"):
req += "\r\n"
end
end
ret req + "\r\n"
end
@en "Listen"
@fa "شنود"
pub func Listen(port: int): Server:
ret Server { fd = rawsock.Listen(port).fd, port = port }
end
@en "Ok"
@fa "معتبر"
pub func Ok(srv: Server): bool:
ret srv.fd >= 0
end
@en "Port"
@fa "درگاه"
pub func Port(srv: Server): int:
if srv.fd < 0:
ret 0
end
ret rawsock.LocalPort(rawsock.FromFd(srv.fd))
end
@en "CloseServer"
@fa "بستن سرور"
pub func CloseServer(srv: Server):
if srv.fd >= 0:
rawsock.Close(rawsock.FromFd(srv.fd))
end
end
@en "Accept"
@fa "پذیرش"
pub func Accept(srv: Server): Conn:
t := rawsock.Accept(rawsock.FromFd(srv.fd))
ret AcceptConn(t.fd)
end
@en "AcceptConn"
@fa "پذیرش اتصال"
pub func AcceptConn(fd: i64): Conn:
mut c := _new_conn(fd, false)
if fd < 0:
ret c
end
_no_delay(fd)
hdr := _read_headers(c)
resp := HandshakeResponse(hdr)
if resp == "":
_shutdown(c)
ret c
end
n := rawsock.Send(rawsock.FromFd(c.fd), resp)
if n <= 0:
_shutdown(c)
ret c
end
c.hdr = hdr
c.path = _request_path(hdr)
c.open = true
ret c
end
@en "LoadWSSConfig"
@fa "بارگذاری پیکربندی امن"
pub func LoadWSSConfig(cert_file: str, key_file: str):
_wss_cfg = tls.NewServerConfig(cert_file, key_file)
end
@en "AcceptWSS"
@fa "پذیرش امن"
pub func AcceptWSS(srv: Server): Conn:
t := rawsock.Accept(rawsock.FromFd(srv.fd))
mut c := _new_conn(0 - 1, false)
if t.fd < 0:
ret c
end
_no_delay(t.fd)
tc := tls.WrapServer(t.fd, _wss_cfg)
c.secure = true
c.tls_idx = _tls_store(tc)
if not tls.ConnOk(tc):
c.open = false
ret c
end
hdr := _read_headers(c)
resp := HandshakeResponse(hdr)
if resp == "":
_shutdown(c)
ret c
end
mut tc2 := _tls_get(c.tls_idx)
n := tls.Write(tc2, resp)
_tls_put(c.tls_idx, tc2)
if n <= 0:
_shutdown(c)
ret c
end
c.hdr = hdr
c.path = _request_path(hdr)
c.open = true
ret c
end
@en "Dial"
@fa "شماره گیری"
pub func Dial(host: str, port: int, path: str): Conn:
ret DialWith(host, port, path, "")
end
@en "DialWith"
@fa "شماره گیری با سربرگ"
pub func DialWith(host: str, port: int, path: str, extra: str): Conn:
s := rawsock.Connect(host, port)
mut c := _new_conn(s.fd, true)
if s.fd < 0:
ret c
end
_no_delay(s.fd)
key := encoding.Base64Encode(rand.Alnum(16))
req := HandshakeRequestWith(host, path, key, extra)
n := rawsock.Send(s, req)
if n <= 0:
_shutdown(c)
ret c
end
hdr := _read_headers(c)
c.hdr = hdr
if not str.Contains(hdr, " 101 "):
_shutdown(c)
ret c
end
if not str.Contains(hdr, AcceptKey(key)):
_shutdown(c)
ret c
end
c.path = path
c.open = true
ret c
end
@en "DialWSS"
@fa "شماره گیری امن"
pub func DialWSS(host: str, port: int, path: str): Conn:
ret DialWSSWith(host, port, path, "")
end
@en "DialWSSWith"
@fa "شماره گیری امن با سربرگ"
pub func DialWSSWith(host: str, port: int, path: str, extra: str): Conn:
ret _dial_wss(host, port, path, extra, false)
end
@en "DialWSSUnverified"
@fa "شماره گیری امن بدون بررسی"
pub func DialWSSUnverified(host: str, port: int, path: str, extra: str): Conn:
ret _dial_wss(host, port, path, extra, true)
end
@en "IsOpen"
@fa "باز است"
pub func IsOpen(c &: Conn): bool:
ret c.open
end
@en "Receive"
@fa "دریافت پیام"
pub func Receive(c &: Conn): Message:
ret Poll(c, 0 - 1)
end
@en "Poll"
@fa "دریافت با مهلت"
pub func Poll(c &: Conn, timeout_ms: int): Message:
mut msg := Message { kind = NONE, text = "" }
if not c.open:
ret msg
end
start := time.MonoMillis()
mut going := true
until going:
fsize := _frame_size(c)
if fsize < 0:
Close(c)
going = false
else fsize == 0:
mut remaining := timeout_ms
if timeout_ms >= 0:
spent := (time.MonoMillis() - start) as int
remaining = timeout_ms - spent
if remaining < 0:
remaining = 0
end
end
if not _readable(c, remaining):
msg = Message { kind = TIMEOUT, text = "" }
going = false
else:
n := _fill(c)
if n <= 0:
_shutdown(c)
going = false
end
end
else:
b0 := _bget(c.buf, 0)
b1 := _bget(c.buf, 1)
fin := b0 / 128
opcode := b0 % 16
masked := (b1 / 128) == 1
mut plen := b1 % 128
mut hlen := 2
if plen == 126:
plen = _bget(c.buf, 2) * 256 + _bget(c.buf, 3)
hlen = 4
else plen == 127:
mut v := 0 as i64
repeat 8 in k:
v = v * 256 + (_bget(c.buf, 2 + k) as i64)
end
plen = v as int
hlen = 10
end
mut moff := 0
if masked:
moff = hlen
hlen += 4
end
if opcode == 9:
payload := _payload_str(c, hlen, plen, masked, moff)
_consume(c, fsize)
_send_frame(c, 10, payload)
else opcode == 10:
payload := _payload_str(c, hlen, plen, masked, moff)
_consume(c, fsize)
msg = Message { kind = 10, text = payload }
going = false
else opcode == 8:
_consume(c, fsize)
_send_frame(c, 8, "")
_shutdown(c)
msg = Message { kind = 8, text = "" }
going = false
else:
if opcode == 1 or opcode == 2:
c.acc_kind = opcode
c.acc = ""
_bin_reset(c)
end
if c.acc_kind == 2:
_bin_append(c, hlen, plen, masked, moff)
else:
c.acc += _payload_str(c, hlen, plen, masked, moff)
end
_consume(c, fsize)
if fin == 1:
if c.acc_kind == 2:
msg = Message { kind = 2, text = _bin_str(c), data = c.bin, len = c.binlen }
else:
msg = Message { kind = c.acc_kind, text = c.acc }
end
c.acc = ""
going = false
end
end
end
end
ret msg
end
@en "ReceiveText"
@fa "دریافت متن"
pub func ReceiveText(c &: Conn): str:
m := Receive(c)
if m.kind == 1:
ret m.text
end
ret ""
end
@en "IsText"
@fa "متن است"
pub func IsText(m: Message): bool:
ret m.kind == 1
end
@en "IsBinary"
@fa "دودویی است"
pub func IsBinary(m: Message): bool:
ret m.kind == 2
end
@en "IsClose"
@fa "بسته است"
pub func IsClose(m: Message): bool:
ret m.kind == 8
end
@en "IsPong"
@fa "پونگ است"
pub func IsPong(m: Message): bool:
ret m.kind == 10
end
@en "SendText"
@fa "ارسال متن"
pub func SendText(c &: Conn, msg: str): int:
ret _send_frame(c, 1, msg)
end
@en "SendBinary"
@fa "ارسال دودویی"
pub func SendBinary(c &: Conn, data: str): int:
ret _send_frame(c, 2, data)
end
@en "SendBinaryBytes"
@fa "ارسال بایت دودویی"
pub func SendBinaryBytes(c &: Conn, ptr: void*, n: int): int:
ret _send_frame_raw(c, 2, ptr, n)
end
@en "Ping"
@fa "پینگ فرست"
pub func Ping(c &: Conn, data: str): int:
ret _send_frame(c, 9, data)
end
@en "Close"
@fa "بستن"
pub func Close(c &: Conn):
if c.open:
_send_frame(c, 8, "")
end
_shutdown(c)
end
@en "Stop"
@fa "توقف"
pub func Stop(c &: Conn):
if c.open:
_send_frame(c, 8, "")
end
if c.secure and c.tls_idx >= 0:
mut tc := _tls_get(c.tls_idx)
tls.Close(tc)
_tls_put(c.tls_idx, tc)
else c.secure:
c.open = false
else:
if c.fd >= 0:
rawsock.Shutdown(rawsock.FromFd(c.fd))
end
end
c.open = false
end
@en "NewHub"
@fa "هاب جدید"
pub func NewHub(): Hub:
ret Hub {}
end
@en "Register"
@fa "ثبت"
pub func Register(h &: Hub, room: str, c: Conn):
mut members := RoomMembers {}
if h.rooms.has(room): members = h.rooms.get(room) end
members.items.push(c)
h.rooms.put(room, members)
end
@en "Unregister"
@fa "لغو ثبت"
pub func Unregister(h &: Hub, room: str, c: Conn):
if not h.rooms.has(room): ret end
mut members := h.rooms.get(room)
mut kept := RoomMembers {}
n := members.items.len()
mut i := 0
until i < n:
m := members.items.get(i)
mut same := false
if c.secure:
same = m.secure and m.tls_idx == c.tls_idx
else:
same = not m.secure and m.fd == c.fd
end
if not same:
kept.items.push(m)
end
i++
end
h.rooms.put(room, kept)
end
@en "RoomSize"
@fa "اندازه اتاق"
pub func RoomSize(h: Hub, room: str): int:
if not h.rooms.has(room): ret 0 end
ret h.rooms.get(room).items.len()
end
@en "Broadcast"
@fa "پخش"
pub func Broadcast(h &: Hub, room: str, msg: str): int:
if not h.rooms.has(room): ret 0 end
mut members := h.rooms.get(room)
mut sent := 0
n := members.items.len()
mut i := 0
until i < n:
mut m := members.items.get(i)
if m.open:
rc := _send_frame(m, 1, msg)
if rc == 0: sent++ end
members.items.set(i, m)
end
i++
end
h.rooms.put(room, members)
ret sent
end
@en "BroadcastBinary"
@fa "پخش دودویی"
pub func BroadcastBinary(h &: Hub, room: str, data: str): int:
if not h.rooms.has(room): ret 0 end
mut members := h.rooms.get(room)
mut sent := 0
n := members.items.len()
mut i := 0
until i < n:
mut m := members.items.get(i)
if m.open:
rc := _send_frame(m, 2, data)
if rc == 0: sent++ end
members.items.set(i, m)
end
i++
end
h.rooms.put(room, members)
ret sent
end
