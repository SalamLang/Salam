@en "TempDir"
@fa "پوشه موقت"
pub func TempDir(): str:
each name in ["TEMP", "TMP", "TMPDIR"]:
v := getenv(name)
if v != null and (v as str).len() > 0:
ret str.Clone(v as str)
end
end
ret str.Clone("/tmp")
end
