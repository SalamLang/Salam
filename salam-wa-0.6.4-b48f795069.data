@en "WaitPid"
@fa "انتظار شناسه"
pub func WaitPid(pid: int): int:
if pid <= 0: ret 0 - 1 end
statusbuf := mem.AllocateZeroed(4 as u64)
mut rc := waitpid(pid, statusbuf, 0)
until rc < 0 and kill(pid, 0) == 0:
rc = waitpid(pid, statusbuf, 0)
end
sp := statusbuf as int*
status := sp[0]
mem.Free(statusbuf)
mut code := 0 - 1
if rc == pid:
low := status % 128
if low == 0:
code = (status / 256) % 256
else:
if low != 127: code = 128 + low end
end
end
ret code
end
@en "Wait"
