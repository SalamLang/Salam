end
@en "MatchAnd"
@fa "تطبیق همه واژه‌ها"
pub func MatchAnd(field: str, text: str): str:
ret _os_field_obj("match", field, _os_two("query", json.Str(text), "operator", `"and"`))
end
@en "MatchFuzzy"
@fa "تطبیق تقریبی"
pub func MatchFuzzy(field: str, text: str): str:
