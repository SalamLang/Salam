pl[p - 2 * step] = _vp8_clamp(p1 + a3, 255) as u8
pl[p - step] = _vp8_clamp(p0 + a2, 255) as u8
pl[p] = _vp8_clamp(q0 - a1, 255) as u8
pl[p + step] = _vp8_clamp(q1 - a3, 255) as u8
end
func _vp8_filter6(pl: u8*, p: int, step: int):
p2 := _vp8_pg(pl, p - 3 * step)
p1 := _vp8_pg(pl, p - 2 * step)
p0 := _vp8_pg(pl, p - step)
q0 := _vp8_pg(pl, p)
q1 := _vp8_pg(pl, p + step)
q2 := _vp8_pg(pl, p + 2 * step)
a := _vp8_sclip(3 * (q0 - p0) + _vp8_sclip(p1 - q1, 0 - 128, 127), 0 - 128, 127)
a1 := (27 * a + 63) >> 7
a2 := (18 * a + 63) >> 7
a3 := (9 * a + 63) >> 7
pl[p - 3 * step] = _vp8_clamp(p2 + a3, 255) as u8
pl[p - 2 * step] = _vp8_clamp(p1 + a2, 255) as u8
pl[p - step] = _vp8_clamp(p0 + a1, 255) as u8
pl[p] = _vp8_clamp(q0 - a1, 255) as u8
pl[p + step] = _vp8_clamp(q1 - a2, 255) as u8
pl[p + 2 * step] = _vp8_clamp(q2 - a3, 255) as u8
end
func _vp8_needs(pl: u8*, p: int, step: int, t: int): bool:
ret 4 * _vp8_abs(_vp8_pg(pl, p - step) - _vp8_pg(pl, p)) + _vp8_abs(_vp8_pg(pl, p - 2 * step) - _vp8_pg(pl, p + step)) <= t
end
func _vp8_needs2(pl: u8*, p: int, step: int, t: int, it: int): bool:
if not _vp8_needs(pl, p, step, t):
ret false
end
p3 := _vp8_pg(pl, p - 4 * step)
p2 := _vp8_pg(pl, p - 3 * step)
p1 := _vp8_pg(pl, p - 2 * step)
p0 := _vp8_pg(pl, p - step)
q0 := _vp8_pg(pl, p)
q1 := _vp8_pg(pl, p + step)
q2 := _vp8_pg(pl, p + 2 * step)
q3 := _vp8_pg(pl, p + 3 * step)
ret _vp8_abs(p3 - p2) <= it and _vp8_abs(p2 - p1) <= it and _vp8_abs(p1 - p0) <= it and _vp8_abs(q3 - q2) <= it and _vp8_abs(q2 - q1) <= it and _vp8_abs(q1 - q0) <= it
end
func _vp8_hev(pl: u8*, p: int, step: int, t: int): bool:
ret _vp8_abs(_vp8_pg(pl, p - 2 * step) - _vp8_pg(pl, p - step)) > t or _vp8_abs(_vp8_pg(pl, p + step) - _vp8_pg(pl, p)) > t
end
func _vp8_simple(pl: u8*, p: int, step: int, along: int, thresh: int):
t2 := 2 * thresh + 1
repeat 16 in i:
q := p + i * along
if _vp8_needs(pl, q, step, t2):
_vp8_filter2(pl, q, step)
end
end
end
func _vp8_loop(pl: u8*, p: int, step: int, along: int, size: int, thresh: int, it: int, hev: int, six: bool):
t2 := 2 * thresh + 1
repeat size in i:
q := p + i * along
if _vp8_needs2(pl, q, step, t2, it):
if _vp8_hev(pl, q, step, hev):
_vp8_filter2(pl, q, step)
else six:
_vp8_filter6(pl, q, step)
else:
_vp8_filter4(pl, q, step)
end
end
end
end
func _vp8_filter_mb(ftype: int, y: u8*, ys: int, u: u8*, v: u8*, uvs: int, mx: int, my: int, limit: int, ilevel: int, hev: int, inner: bool):
