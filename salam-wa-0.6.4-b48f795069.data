func _js_string(s: str): str:
ret json.Str(s)
end
func _reply(window: int, origin: str, id: str, ok: bool, raw_json: str):
if window < 0:
ret
end
mut b := str.NewBuilder()
str.BufAppend(b, "if(location.origin===")
quoted := _js_string(origin)
str.BufAppend(b, quoted)
mem.Free(quoted as void*)
str.BufAppend(b, "&&window.__salamBridge)window.__salamBridge.reply(")
str.BufAppend(b, id)
str.BufAppend(b, ok ? ",true," : ",false,")
str.BufAppend(b, raw_json)
str.BufAppend(b, ")")
code := str.BufStr(b)
_app_view(window).EvalLater(code)
mem.Free(code as void*)
str.BufFree(b)
end
func _emit_to(index: int, event: str, raw_json: str):
if index < 0:
ret
end
mut b := str.NewBuilder()
str.BufAppend(b, "if(")
origins := _origins_json(index)
str.BufAppend(b, origins)
mem.Free(origins as void*)
str.BufAppend(b, ".includes(location.origin)&&window.__salamBridge)window.__salamBridge.event(")
name := _js_string(event)
str.BufAppend(b, name)
mem.Free(name as void*)
str.BufAppend(b, ",")
str.BufAppend(b, raw_json)
str.BufAppend(b, ")")
code := str.BufStr(b)
_app_view(index).EvalLater(code)
mem.Free(code as void*)
str.BufFree(b)
end
func _app_view(index: int): WebView:
sync.Lock(_pending_lock)
mut view := WebView {}
if index >= 0 and index < _wins.len():
view = _wins[index].view
end
sync.Unlock(_pending_lock)
ret view
end
func _local_origin(): str:
if _local_origin_text.len() == 0:
_local_origin_text = SchemeOrigin(_cfg.scheme)
end
ret _local_origin_text
end
func _origins_json(index: int): str:
mut items := Vector {} as Vector<str>
defer items.free()
items.push(_js_string(_local_origin()))
each rule in _rules:
items.push(_js_string(rule.origin))
end
sync.Lock(_pending_lock)
has_inline := index >= 0 and index < _wins.len() and _wins[index].inline_html
sync.Unlock(_pending_lock)
if has_inline:
items.push(_js_string("null"))
end
ret json.Array(items)
end
func _matches(pattern: str, name: str): bool:
if pattern == "*" or pattern == name:
ret true
end
if str.EndsWith(pattern, "*"):
prefix := str.Substr(pattern, 0, str.Len(pattern) - 1)
defer mem.Free(prefix as void*)
ret str.StartsWith(name, prefix)
end
ret false
end
func _bridge_script(index: int): str:
origins := _origins_json(index)
post := PostScript()
token := _js_string(_token)
code := str.Replace(
str.Replace(str.Replace(_BRIDGE_JS, "%ORIGINS%", origins), "%POST%", post), "%TOKEN%", token
)
mem.Free(origins as void*)
mem.Free(post as void*)
mem.Free(token as void*)
ret code
end
func _find_command(name: str): int:
repeat _commands.len() in i:
if _commands[i].name == name:
ret i
end
end
ret -1
end
func _field(text: str, key: str): str:
value := json.Get(text, key)
ret value.len() > 0 ? value : str.Clone("")
end
func _on_message(index: int, text: str):
if not json.Valid(text):
ret
end
sent := _field(text, "t")
defer mem.Free(sent as void*)
if not crypto.SecretEquals(sent, _token):
Trace("message dropped: wrong token")
ret
end
url := _wins[index].view.URL()
defer mem.Free(url as void*)
origin := OriginOf(url)
kind := _field(text, "k")
defer mem.Free(kind as void*)
if kind == "emit":
_on_emit(index, text, origin)
mem.Free(origin as void*)
ret
end
if kind != "call":
mem.Free(origin as void*)
ret
end
id := _field(text, "id")
command := _field(text, "cmd")
args := _field(text, "args")
sync.Lock(_pending_lock)
_call_serial++
serial := _call_serial
_pending.put(serial, _Owned { command = command, args = args, origin = origin, id = id })
sync.Unlock(_pending_lock)
mut c := Call { command = command, args = args, origin = origin, window = index, id = id, serial = serial }
inline_ok := origin == "null" and _wins[index].inline_html
if not inline_ok and not Allowed(origin, command):
Trace("command refused for " + origin)
c.Reject("not allowed: " + command)
ret
end
found := _find_command(command)
if found < 0:
c.Reject("unknown command: " + command)
ret
end
entry := _commands[found]
if entry.threaded:
pool.Go((): entry.handler(c) end)
else:
entry.handler(c)
end
end
func _on_emit(index: int, text: str, origin: str):
inline_ok := origin == "null" and _wins[index].inline_html
name := _field(text, "name")
defer mem.Free(name as void*)
pattern := "event:".concat(name)
defer mem.Free(pattern as void*)
if not inline_ok and not Allowed(origin, pattern):
ret
end
data := _field(text, "data")
defer mem.Free(data as void*)
each l in _listeners:
if l.name == name:
l.handler(data)
end
end
end
func _nav_allowed(index: int, url: str): bool:
if url == "about:blank" or url == "about:srcdoc":
ret true
end
if str.StartsWith(url, "data:") or str.StartsWith(url, "about:"):
ret _wins[index].inline_html
end
origin := OriginOf(str.StartsWith(url, "blob:") ? str.Substr(url, 5, str.Len(url) - 5) : url)
defer mem.Free(origin as void*)
if origin == _local_origin() or origin == _wins[index].start_origin:
ret true
end
each rule in _rules:
if rule.origin == origin:
ret true
end
end
each allowed in _wins[index].allow_navigation:
if allowed == origin:
ret true
end
end
ret false
end
func _on_navigate(index: int, url: str): bool:
if _nav_allowed(index, url):
ret true
end
if _cfg.external_links and NavigationIsMainFrame():
OpenURL(url)
end
ret false
end
func _on_new_window(url: str):
if _cfg.external_links:
OpenURL(url)
end
end
func _startup():
if _inited:
ret
end
_inited = true
if _cfg.id.len() == 0:
_cfg.id = "ir.salamlang.app"
end
if _cfg.name.len() == 0:
_cfg.name = _cfg.id
end
_token = crypto.RandomHex(16)
SetApp(_cfg.id, _cfg.name)
dir := DataDir()
_mk := os.MkdirAll(dir)
SetDataDir(dir)
mem.Free(dir as void*)
RegisterScheme(_cfg.scheme, (req: Request): ret _serve_asset(req) end)
if _cfg.pack_path.len() > 0:
_opened := pack.Open(_cfg.pack_path, _cfg.id, _the_pack)
else:
_open_default_pack()
end
end
func _open_default_pack():
exe := _exe_path()
defer mem.Free(exe as void*)
if exe.len() == 0:
ret
end
if pack.Open(exe, _cfg.id, _the_pack):
ret
end
sibling := exe.concat(".pack")
defer mem.Free(sibling as void*)
if os.Exists(sibling) and pack.Open(sibling, _cfg.id, _the_pack):
ret
end
if SALAM_OS_MAC:
dir := filepath.Dir(exe)
defer mem.Free(dir as void*)
resources := dir.concat("/../Resources/app.pack")
defer mem.Free(resources as void*)
if os.Exists(resources):
_opened := pack.Open(resources, _cfg.id, _the_pack)
end
end
end
@en "OriginOf"
@fa "مبدا نشانی"
pub func OriginOf(url: str): str:
start := str.IndexOf(url, "://")
if start <= 0:
ret str.Clone("null")
end
scheme := str.Substr(url, 0, start)
defer mem.Free(scheme as void*)
if str.EqualFold(scheme, "file"):
ret str.Clone("file://")
end
rest := start + 3
mut stop := str.Len(url)
each sep in ["/", "?", "#"]:
at := str.IndexFrom(url, sep, rest)
if at >= 0 and at < stop:
stop = at
end
end
authority := str.Substr(url, rest, stop - rest)
defer mem.Free(authority as void*)
at_sign := str.LastIndex(authority, "@")
host := at_sign >= 0 ? str.Substr(authority, at_sign + 1, str.Len(authority) - at_sign - 1) : str.Clone(authority)
defer mem.Free(host as void*)
lower_scheme := str.Lower(scheme)
defer mem.Free(lower_scheme as void*)
lower_host := str.Lower(host)
defer mem.Free(lower_host as void*)
mut host_only := str.Clone(lower_host)
if lower_scheme == "https" and str.EndsWith(lower_host, ":443"):
mem.Free(host_only as void*)
host_only = str.Substr(lower_host, 0, str.Len(lower_host) - 4)
else lower_scheme == "http" and str.EndsWith(lower_host, ":80"):
mem.Free(host_only as void*)
host_only = str.Substr(lower_host, 0, str.Len(lower_host) - 3)
end
mut b := str.NewBuilder()
str.BufAppend(b, lower_scheme)
str.BufAppend(b, "://")
str.BufAppend(b, host_only)
out := str.BufStr(b)
str.BufFree(b)
mem.Free(host_only as void*)
ret out
end
@en "Allowed"
@fa "مجاز است"
pub func Allowed(origin: str, command: str): bool:
if origin == _local_origin():
ret true
end
each rule in _rules:
if rule.origin == origin:
each pattern in rule.patterns:
if _matches(pattern, command):
ret true
end
end
end
end
ret false
end
@en "PackDir"
@fa "فشرده کردن پوشه"
pub func PackDir(dir: str, out_path: str, key: str): int:
ret pack.PackDir(dir, out_path, key)
end
@en "Init"
@fa "آغاز"
pub func Init(config: Config):
_cfg = config
_inited = false
end
@en "CurrentConfig"
@fa "پیکربندی فعلی"
pub func CurrentConfig(): Config:
ret _cfg
end
@en "DataDir"
@fa "پوشه داده"
pub func DataDir(): str:
id := _cfg.id.len() > 0 ? _cfg.id : "ir.salamlang.app"
if SALAM_OS_WINDOWS:
ret filepath.Join(user.CacheDir(), id)
else SALAM_OS_MAC:
ret filepath.Join(user.HomeDir(), "Library/Application Support/".concat(id))
else:
xdg := os.Env("XDG_DATA_HOME")
if xdg.len() > 0:
ret filepath.Join(xdg, id)
end
ret filepath.Join(user.HomeDir(), ".local/share/".concat(id))
end
end
@en "Allow"
@fa "اجازه دادن"
pub func Allow(origin: str, commands: Vector<str>):
normalized := OriginOf(origin)
_rules.push(_Rule { origin = normalized, patterns = commands })
end
@en "Command"
@fa "فرمان"
pub func Command(name: str, handler: func (Call)):
_commands.push(_Command { name = str.Clone(name), handler = handler })
end
@en "CommandAsync"
@fa "فرمان ناهمگام"
pub func CommandAsync(name: str, handler: func (Call)):
_commands.push(_Command { name = str.Clone(name), handler = handler, threaded = true })
end
@en "On"
@fa "هنگام رویداد"
pub func On(event: str, handler: func (str)):
_listeners.push(_Listener { name = str.Clone(event), handler = handler })
end
@en "Emit"
@fa "رویداد فرستادن"
pub func Emit(event: str, raw_json: str = "null"):
sync.Lock(_pending_lock)
count := _wins.len()
sync.Unlock(_pending_lock)
repeat count in i:
_emit_to(i, event, raw_json)
end
end
@en "AssetURL"
@fa "نشانی دارایی"
pub func AssetURL(path: str): str:
ret SchemeURL(_cfg.scheme, path)
end
@en "Open"
@fa "باز کردن"
pub func Open(options: WindowOptions): Window:
_startup()
view := Create(_cfg.debug, false)
if view.IsClosed():
ret Window {}
end
index := _wins.len()
mut start := options.url
if start.len() == 0 and options.html.len() == 0:
start = AssetURL("/index.html")
end
sync.Lock(_pending_lock)
_wins.push(
_Win {
label = str.Clone(options.label), view = view, start_origin = start.len() > 0 ? OriginOf(start) : str.Clone("null"),
inline_html = options.html.len() > 0, allow_navigation = options.allow_navigation
}
)
sync.Unlock(_pending_lock)
if options.title.len() > 0:
view.SetTitle(options.title)
end
view.SetSize(options.width, options.height, options.resizable ? HINT_NONE : HINT_FIXED)
if options.min_width > 0 or options.min_height > 0:
view.SetMinSize(options.min_width, options.min_height)
end
if options.icon.len() > 0:
view.SetIcon(options.icon)
end
if not options.context_menu:
view.SetContextMenu(false)
end
if not options.devtools_enabled:
view.SetDevToolsEnabled(false)
end
if not options.translate_enabled:
view.SetTranslateEnabled(false)
end
bridge := _bridge_script(index)
view.Init(bridge)
mem.Free(bridge as void*)
each script in options.scripts:
view.Init(script, true)
end
view.OnMessage((text: str): _on_message(index, text) end)
view.OnNavigate((url: str): ret _on_navigate(index, url) end)
view.OnNewWindow((url: str): _on_new_window(url) end)
if options.center:
view.Center()
end
if options.html.len() > 0:
view.SetHTML(options.html)
else:
view.Navigate(start)
end
if options.visible:
view.Show()
end
ret Window { index = index }
end
@en "GetWindow"
@fa "گرفتن پنجره"
pub func GetWindow(label: str): Window:
repeat _wins.len() in i:
if _wins[i].label == label:
ret Window { index = i }
end
end
ret Window {}
end
@en "Run"
@fa "اجرا"
pub func Run():
RunAll()
end
package webview
mut _the_pack := pack.Pack {}
mut _asset_cache := HashMap {} as HashMap<str, pack.Blob>
mut _uncached := null as void*
func _hex_value(c: int): int:
if c >= 48 and c <= 57:
ret c - 48
else c >= 65 and c <= 70:
ret c - 55
else c >= 97 and c <= 102:
ret c - 87
end
ret -1
end
func _decode_path(path: str): str:
n := str.Len(path)
bytes := path as u8*
out := mem.Allocate((n + 1) as u64) as u8*
mut j := 0
mut i := 0
until i < n:
c := bytes[i] as int
if c == 37 and i + 2 < n:
hi := _hex_value(bytes[i + 1] as int)
lo := _hex_value(bytes[i + 2] as int)
if hi >= 0 and lo >= 0:
out[j] = ((hi * 16) + lo) as u8
j++
i += 3
continue
end
end
out[j] = c as u8
j++
i++
end
out[j] = 0 as u8
decoded := out as str
if str.Len(decoded) != j:
mem.Free(out as void*)
ret str.Clone("\\")
end
ret decoded
end
func _keep_until_next(blob: pack.Blob):
if _uncached != null:
mem.Free(_uncached)
end
_uncached = blob.data
end
func _load_asset(rel: str): pack.Blob:
if _asset_cache.has(rel):
ret _asset_cache.get(rel)
end
mut blob := pack.Blob {}
if _cfg.assets_dir.len() > 0 and _the_pack.Count() == 0:
full := filepath.Join(_cfg.assets_dir, rel)
defer mem.Free(full as void*)
if os.Exists(full) and not os.IsDir(full):
size := os.FileSize(full)
data := pack.ReadRange(full, 0 as i64, size)
if data != null:
blob = pack.Blob { data = data, size = size }
_keep_until_next(blob)
ret blob
end
end
end
if _the_pack.Count() > 0:
blob = _the_pack.Read(rel)
if blob.data != null:
if blob.size <= (4 * 1024 * 1024 as i64):
_asset_cache.put(str.Clone(rel), blob)
else:
_keep_until_next(blob)
end
end
end
ret blob
end
func _serve_asset(req: Request): Response:
rel := SafeAssetPath(req.path)
defer mem.Free(rel as void*)
if rel.len() == 0:
ret Response { status = 403, mime = "text/plain" }
end
mut blob := _load_asset(rel)
if blob.data == null and _cfg.spa and not str.Contains(rel, "."):
blob = _load_asset("index.html")
if blob.data != null:
mut res := Response { mime = "text/html; charset=utf-8", data = blob.data, size = blob.size }
_add_headers(res)
ret res
end
end
if blob.data == null:
ret Response { status = 404, mime = "text/plain" }
end
mut res := Response { mime = mime.MimeType(rel), data = blob.data, size = blob.size }
_add_headers(res)
ret res
end
func _add_headers(res &: Response):
if _cfg.csp.len() > 0:
res.Header("Content-Security-Policy", _cfg.csp)
end
res.Header("X-Content-Type-Options", "nosniff")
end
@en "SafeAssetPath"
@fa "مسیر امن دارایی"
pub func SafeAssetPath(request_path: str): str:
decoded := _decode_path(request_path)
defer mem.Free(decoded as void*)
mut start := 0
until start < str.Len(decoded) and (decoded as u8*)[start] == (47 as u8):
start++
end
mut rel := str.Substr(decoded, start, str.Len(decoded) - start)
if str.Contains(rel, "\\") or str.Contains(rel, ":"):
mem.Free(rel as void*)
ret str.Clone("")
end
parts := str.Split(rel, "/")
mut climbs := false
each part in parts:
climbs = climbs or part == ".."
mem.Free(part as void*)
end
parts.free()
if climbs:
mem.Free(rel as void*)
ret str.Clone("")
end
if rel.len() == 0 or str.EndsWith(rel, "/"):
full := rel.concat("index.html")
mem.Free(rel as void*)
rel = full
end
ret rel
end
package webview
const _BRIDGE_JS := `(function(){
var A=%ORIGINS%;
if(window.top!==window||A.indexOf(location.origin)<0)return;
if(window.__salamBridge)return;
var T=%TOKEN%,post=%POST%,seq=0,pend=new Map(),subs=new Map();
function send(kind,body){body.t=T;body.k=kind;post(JSON.stringify(body));}
var api=Object.freeze({
invoke:function(cmd,args){return new Promise(function(res,rej){var id=++seq;pend.set(id,[res,rej]);send("call",{id:id,cmd:String(cmd),args:args===undefined?{}:args});});},
listen:function(name,fn){var s=subs.get(name);if(!s){s=new Set();subs.set(name,s);}s.add(fn);return function(){s.delete(fn);};},
emit:function(name,data){send("emit",{name:String(name),data:data===undefined?null:data});}
});
Object.defineProperty(window,"salam",{value:api,enumerable:true});
Object.defineProperty(window,"__salamBridge",{value:Object.freeze({
reply:function(id,ok,value){var p=pend.get(id);if(!p)return;pend.delete(id);if(ok)p[0](value);else p[1](new Error(value));},
event:function(name,data){var s=subs.get(name);if(s)s.forEach(function(fn){try{fn(data);}catch(e){console.error(e);}});}
})});
})();`
@en "gui/webview/bundle"
@fa "نصب ساز رومیزی"
package bundle
import archive
import compress
import gui.webview.pack
import filepath
import fs
import io
import mem
import os
import os.shell
import str
const USAGE := `Usage: salam bundle [dir] [--target=TRIPLE] [--format=a,b] [--output=DIR] [--backend=B]

Builds the app described by the [app] table of salam.toml into installable packages.

  --target=TRIPLE  Build for another system (default: this one)
  --format=a,b     tar, deb, rpm, appimage on Linux; zip, nsis on Windows;
                   app, tar, dmg on macOS (default: tar,deb / zip / app,tar)
  --output=DIR     Where the packages go (default: dist)
  --backend=NAME   Compiler backend (default: native for Windows and macOS)
  --engine=NAME    system (the web view of the operating system, the default)
                   or chromium (Chromium Embedded Framework)
  --runtime=DIR    With chromium: the folder holding the built salam_webview_cef
                   library, salam_cef_helper and the CEF runtime files; copied
                   next to the program (tar on Linux, zip on Windows). Also read
                   from SALAM_CEF_DIR

salam.toml:

  [app]
  id = "com.example.notes"
  name = "Notes"
  version = "1.0.0"
  main = "main.salam"
  assets = "www"
  icon = "icon.png"
  description = "Take notes"
  publisher = "Example"
  category = "Utility"
`
const WINDOWS_MANIFEST := `<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <dependency><dependentAssembly><assemblyIdentity type="win32" name="Microsoft.Windows.Common-Controls" version="6.0.0.0" processorArchitecture="*" publicKeyToken="6595b64144ccf1df" language="*"/></dependentAssembly></dependency>
  <application xmlns="urn:schemas-microsoft-com:asm.v3"><windowsSettings>
    <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
    <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
  </windowsSettings></application>
</assembly>
`
struct _Build:
pub manifest: Manifest = Manifest {}
pub project: str = ""
pub output: str = ""
pub work: str = ""
pub target: str = ""
pub os_name: str = ""
pub arch: str = ""
pub backend: str = ""
pub salam: str = "salam"
pub exe: str = ""
pub pack: str = ""
pub base: str = ""
pub runtime: str = ""
end
@en "Manifest"
@fa "شناسنامه"
pub struct Manifest:
@en "id"
@fa "شناسه"
pub id: str = ""
@en "name"
@fa "نام"
pub name: str = ""
@en "version"
@fa "نگارش"
pub version: str = "0.1.0"
@en "main"
@fa "ورودی"
pub main: str = "main.salam"
@en "assets"
@fa "دارایی ها"
pub assets: str = ""
@en "icon"
@fa "نماد"
pub icon: str = ""
@en "description"
@fa "توضیح"
pub description: str = ""
@en "publisher"
@fa "ناشر"
pub publisher: str = ""
@en "category"
@fa "دسته"
pub category: str = "Utility"
@en "slug"
@fa "نام کوتاه"
pub slug: str = ""
@en "engine"
@fa "موتور"
pub engine: str = "system"
@en "runtime"
@fa "پوشه موتور"
pub runtime: str = ""
end
func _say(text: str):
println "bundle: " + text
end
func _fail(text: str): int:
printerrln "bundle: " + text
ret 1
end
func _unquote(value: str): str:
t := str.Trim(value)
n := str.Len(t)
if n >= 2 and (t as u8*)[0] == (34 as u8) and (t as u8*)[n - 1] == (34 as u8):
ret str.Substr(t, 1, n - 2)
end
ret t
end
func _slug(name: str): str:
mut b := str.NewBuilder()
lower := str.Lower(name)
bytes := lower as u8*
mut dash := false
repeat str.Len(lower) in i:
c := bytes[i] as int
if (c >= 97 and c <= 122) or (c >= 48 and c <= 57):
if dash and str.BufLen(b) > 0:
str.BufAppendChar(b, 45)
end
dash = false
str.BufAppendChar(b, c)
else:
dash = true
end
end
out := str.BufStr(b)
if out.len() == 0:
ret str.Clone("app")
end
ret out
end
func _os_of(target: str): str:
if target.len() == 0:
if SALAM_OS_WINDOWS:
ret "windows"
else SALAM_OS_MAC:
ret "macos"
else:
ret "linux"
end
end
if str.Contains(target, "windows") or str.Contains(target, "mingw"):
ret "windows"
end
if str.Contains(target, "apple") or str.Contains(target, "darwin") or str.Contains(target, "macos"):
ret "macos"
end
ret "linux"
end
func _arch_of(target: str): str:
mut source := target
if target.len() == 0:
source = SALAM_ARCH_ARM64 ? "aarch64" : (SALAM_ARCH_X86 ? "i686" : "x86_64")
end
if str.StartsWith(source, "aarch64") or str.StartsWith(source, "arm64"):
ret "arm64"
end
if str.StartsWith(source, "i686") or str.StartsWith(source, "i386"):
ret "x86"
end
ret "x64"
end
func _deb_arch(arch: str): str:
if arch == "arm64":
ret "arm64"
else arch == "x86":
ret "i386"
end
ret "amd64"
end
func _rpm_arch(arch: str): str:
if arch == "arm64":
ret "aarch64"
else arch == "x86":
ret "i686"
end
ret "x86_64"
end
func _on_path(tool: str): bool:
folders := os.Env("PATH").split(SALAM_OS_WINDOWS ? ";" : ":")
defer folders.free()
each folder in folders:
if folder.len() > 0:
path := filepath.Join(folder, tool)
if os.Exists(path) and not os.IsDir(path):
ret true
end
if SALAM_OS_WINDOWS and os.Exists(path + ".exe"):
ret true
end
end
end
ret false
end
func _write(path: str, text: str): bool:
ret io.WriteFile(path, text) >= 0
end
func _read_bytes(path: str, size_out &: i64): void*:
size_out = os.FileSize(path)
if size_out < 0:
ret null
end
ret pack.ReadRange(path, 0 as i64, size_out)
end
func _copy_file(from_path: str, to_path: str): bool:
mut size := 0 as i64
data := _read_bytes(from_path, size)
if data == null:
ret false
end
defer mem.Free(data)
ret archive.WriteBinaryFile(to_path, data, size as int)
end
func _tar_add(files &: Vector<archive.TarFileInput>, name: str, data: void*, size: i64, mode: int):
files.push(archive.TarFileInput { name = name, data_ptr = data, data_len = size as int, mode = mode })
end
func _tar_add_dir(files &: Vector<archive.TarFileInput>, name: str):
files.push(archive.TarFileInput { name = name, is_dir = true })
end
func _tar_add_file(files &: Vector<archive.TarFileInput>, name: str, path: str, mode: int): bool:
mut size := 0 as i64
data := _read_bytes(path, size)
if data == null:
ret false
end
_tar_add(files, name, data, size, mode)
ret true
end
func _tar_add_text(files &: Vector<archive.TarFileInput>, name: str, text: str, mode: int = 0):
_tar_add(files, name, text as void*, str.Len(text) as i64, mode)
end
func _write_targz(files: Vector<archive.TarFileInput>, path: str): bool:
tar := archive.TarCreate(files)
packed := compress.GzipCompress(tar.data, tar.len)
ret archive.WriteBinaryFileBuf(path, packed)
end
func _targz_bytes(files: Vector<archive.TarFileInput>): compress.ByteBuf:
tar := archive.TarCreate(files)
ret compress.GzipCompress(tar.data, tar.len)
end
func _ar_field(buf &: compress.ByteBuf, text: str, width: int):
n := str.Len(text)
compress.BufPushBytes(buf, text as void*, n)
repeat width - n:
compress.BufPush(buf, 32)
end
end
func _ar_member(buf &: compress.ByteBuf, name: str, data: void*, size: int):
_ar_field(buf, name, 16)
_ar_field(buf, "0", 12)
_ar_field(buf, "0", 6)
_ar_field(buf, "0", 6)
_ar_field(buf, "100644", 8)
_ar_field(buf, str.FromInt(size as i64), 10)
compress.BufPush(buf, 96)
compress.BufPush(buf, 10)
compress.BufPushBytes(buf, data, size)
if size % 2 == 1:
compress.BufPush(buf, 10)
end
end
func _one_line(text: str): str:
ret str.Replace(str.Replace(text, "\r", " "), "\n", " ")
end
func _desktop_entry(b: _Build, exec_path: str, icon_name: str): str:
m := b.manifest
mut out := "[Desktop Entry]\nType=Application\nName=" + _one_line(m.name) + "\nExec=" + exec_path + " %U\nIcon=" + icon_name
if m.description.len() > 0:
out = out + "\nComment=" + _one_line(m.description)
end
ret out + "\nCategories=" + m.category + ";\nTerminal=false\nStartupWMClass=" + m.id + "\n"
end
func _runtime_files(b: _Build): Vector<str>:
mut out := Vector {} as Vector<str>
if b.runtime.len() == 0:
ret out
end
prefix := b.runtime.len() + 1
each full in os.Walk(b.runtime):
out.push(str.Substr(full, prefix, str.Len(full) - prefix))
end
ret out
end
func _package_tar_linux(b: _Build): bool:
mut files := Vector {} as Vector<archive.TarFileInput>
defer files.free()
_tar_add_dir(files, b.base + "/")
if not _tar_add_file(files, b.base + "/" + b.manifest.slug, b.exe, 0o755):
ret false
end
if b.manifest.icon.len() > 0:
if not _tar_add_file(files, b.base + "/icon" + filepath.Ext(b.manifest.icon), b.manifest.icon, 0o644):
ret false
end
end
_tar_add_text(files, b.base + "/" + b.manifest.id + ".desktop", _desktop_entry(b, b.manifest.slug, "icon"))
each rel in _runtime_files(b):
mode := rel == "salam_cef_helper" ? 0o755 : 0o644
if not _tar_add_file(files, b.base + "/" + rel, filepath.Join(b.runtime, rel), mode):
ret false
end
end
ret _write_targz(files, filepath.Join(b.output, b.base + ".tar.gz"))
end
func _package_deb(b: _Build): bool:
m := b.manifest
mut data := Vector {} as Vector<archive.TarFileInput>
defer data.free()
each dir in ["./", "./usr/", "./usr/bin/", "./usr/share/", "./usr/share/applications/"]:
_tar_add_dir(data, dir)
end
if not _tar_add_file(data, "./usr/bin/" + m.slug, b.exe, 0o755):
ret false
end
_tar_add_text(data, "./usr/share/applications/" + m.id + ".desktop", _desktop_entry(b, "/usr/bin/" + m.slug, m.id))
if m.icon.len() > 0:
each dir in ["./usr/share/icons/", "./usr/share/icons/hicolor/", "./usr/share/icons/hicolor/256x256/", "./usr/share/icons/hicolor/256x256/apps/"]:
_tar_add_dir(data, dir)
end
if not _tar_add_file(data, "./usr/share/icons/hicolor/256x256/apps/" + m.id + ".png", m.icon, 0o644):
ret false
end
end
size_kb := os.FileSize(b.exe) / (1024 as i64) + (1 as i64)
mut control := "Package: " + m.slug + "\nVersion: " + m.version + "\nArchitecture: " + _deb_arch(b.arch)
control = control + "\nMaintainer: " + (m.publisher.len() > 0 ? m.publisher : m.name)
control = control + "\nInstalled-Size: " + str.FromInt(size_kb) + "\nSection: utils\nPriority: optional"
control += "\nDepends: libgtk-3-0t64 | libgtk-3-0, libwebkit2gtk-4.1-0, libsoup-3.0-0, libjavascriptcoregtk-4.1-0"
control = control + "\nDescription: " + (m.description.len() > 0 ? m.description : m.name) + "\n"
mut meta := Vector {} as Vector<archive.TarFileInput>
defer meta.free()
_tar_add_dir(meta, "./")
_tar_add_text(meta, "./control", control)
control_gz := _targz_bytes(meta)
data_gz := _targz_bytes(data)
mut out := compress.NewByteBuf()
magic := "!<arch>\n"
compress.BufPushBytes(out, magic as void*, 8)
version_text := "2.0\n"
_ar_member(out, "debian-binary", version_text as void*, 4)
_ar_member(out, "control.tar.gz", control_gz.data, control_gz.len)
_ar_member(out, "data.tar.gz", data_gz.data, data_gz.len)
ret archive.WriteBinaryFileBuf(filepath.Join(b.output, m.slug + "_" + m.version + "_" + _deb_arch(b.arch) + ".deb"), out)
end
func _rpm_text(text: str): str:
ret str.Replace(_one_line(text), "%", "%%")
end
func _package_rpm(b: _Build): bool:
if not _on_path("rpmbuild"):
_say("rpm needs rpmbuild, which is not installed")
ret false
end
m := b.manifest
root := filepath.Join(b.work, "rpm")
_mk := os.MkdirAll(root)
mut spec := "%global _build_id_links none\n%global __strip /bin/true\n%define debug_package %{nil}\nName: " + m.slug + "\nVersion: " + str.Replace(m.version, "-", "_") + "\nRelease: 1\nSummary: " + _rpm_text(m.description.len() > 0 ? m.description : m.name)
spec = spec + "\nLicense: Proprietary\nBuildArch: " + _rpm_arch(b.arch) + "\nAutoReqProv: no\nRequires: gtk3, webkit2gtk4.1\n\n%description\n" + _rpm_text(m.description.len() > 0 ? m.description : m.name)
spec = spec + "\n\n%install\nmkdir -p %{buildroot}/usr/bin %{buildroot}/usr/share/applications\ncp " + b.exe + " %{buildroot}/usr/bin/" + m.slug + "\ncp " + filepath.Join(b.work, m.id + ".desktop") + " %{buildroot}/usr/share/applications/\n\n%files\n/usr/bin/" + m.slug + "\n/usr/share/applications/" + m.id + ".desktop\n"
if not _write(filepath.Join(b.work, m.id + ".desktop"), _desktop_entry(b, "/usr/bin/" + m.slug, m.id)):
ret false
end
spec_path := filepath.Join(b.work, m.slug + ".spec")
if not _write(spec_path, spec):
ret false
end
mut args := Vector {} as Vector<str>
defer args.free()
args.push("-bb")
args.push("--define")
args.push("_topdir " + root)
args.push("--define")
args.push("_rpmdir " + b.output)
args.push("--define")
args.push("_build_name_fmt %%{NAME}-%%{VERSION}-%%{RELEASE}.%%{ARCH}.rpm")
args.push(spec_path)
ret shell.Run("rpmbuild", args).code == 0
end
func _package_appimage(b: _Build): bool:
if not _on_path("appimagetool"):
_say("appimage needs appimagetool, which is not installed")
ret false
end
m := b.manifest
dir := filepath.Join(b.work, m.slug + ".AppDir")
_mk := os.MkdirAll(filepath.Join(dir, "usr/bin"))
target_exe := filepath.Join(dir, "usr/bin/" + m.slug)
if not _copy_file(b.exe, target_exe):
ret false
end
_exec := fs.Chmod(target_exe, 0o755)
run_path := filepath.Join(dir, "AppRun")
if not _write(run_path, "#!/bin/sh\nexec \"$(dirname \"$0\")/usr/bin/" + m.slug + "\" \"$@\"\n"):
ret false
end
_exec2 := fs.Chmod(run_path, 0o755)
if not _write(filepath.Join(dir, m.id + ".desktop"), _desktop_entry(b, m.slug, m.id)):
ret false
end
if m.icon.len() > 0:
_ok := _copy_file(m.icon, filepath.Join(dir, m.id + ".png"))
end
mut args := Vector {} as Vector<str>
defer args.free()
args.push(dir)
args.push(filepath.Join(b.output, b.base + ".AppImage"))
ret shell.Run("appimagetool", args).code == 0
end
func _package_zip_windows(b: _Build): bool:
mut files := Vector {} as Vector<archive.ZipFileInput>
defer files.free()
mut size := 0 as i64
data := _read_bytes(b.exe, size)
if data == null:
ret false
end
files.push(archive.MakeZipFileInput(b.base + "/" + b.manifest.slug + ".exe", data, size as int, 8))
mut extra := Vector {} as Vector<void*>
defer extra.free()
each rel in _runtime_files(b):
mut extra_size := 0 as i64
blob := _read_bytes(filepath.Join(b.runtime, rel), extra_size)
if blob == null:
mem.Free(data)
each p in extra:
mem.Free(p)
end
ret false
end
extra.push(blob)
files.push(archive.MakeZipFileInput(b.base + "/" + rel, blob, extra_size as int, 8))
end
ok := archive.ZipCreateFile(files, filepath.Join(b.output, b.base + ".zip"))
mem.Free(data)
each p in extra:
mem.Free(p)
end
ret ok
end
func _nsis(text: str): str:
dollar := str.Replace(text, "$", "$$")
ret str.Replace(dollar, "\"", "$\\\"")
end
func _package_nsis(b: _Build): bool:
if not _on_path("makensis"):
_say("nsis needs makensis, which is not installed")
ret false
end
m := b.manifest
name := _nsis(m.name)
script := filepath.Join(b.work, "installer.nsi")
mut text := "Unicode true\nName \"" + name + "\"\nOutFile \"" + filepath.Join(b.output, b.base + "-setup.exe") + "\"\nInstallDir \"$LOCALAPPDATA\\Programs\\" + name + "\"\nRequestExecutionLevel user\nPage directory\nPage instfiles\nUninstPage uninstConfirm\nUninstPage instfiles\nSection\nSetOutPath \"$INSTDIR\"\nFile \"/oname=" + m.slug + ".exe\" \"" + b.exe + "\"\n"
text = text + "WriteUninstaller \"$INSTDIR\\uninstall.exe\"\nCreateShortcut \"$SMPROGRAMS\\" + name + ".lnk\" \"$INSTDIR\\" + m.slug + ".exe\"\nSectionEnd\nSection Uninstall\nDelete \"$SMPROGRAMS\\" + name + ".lnk\"\nDelete \"$INSTDIR\\" + m.slug + ".exe\"\nDelete \"$INSTDIR\\uninstall.exe\"\nRMDir \"$INSTDIR\"\nSectionEnd\n"
if not _write(script, text):
ret false
end
mut args := Vector {} as Vector<str>
defer args.free()
args.push(script)
ret shell.Run("makensis", args).code == 0
end
func _icns_tag(width: int): str:
if width >= 1024:
ret "ic10"
else width >= 512:
ret "ic09"
else width >= 256:
ret "ic08"
end
ret "ic07"
end
func _png_to_icns(path: str, out_path: str): bool:
mut size := 0 as i64
data := _read_bytes(path, size)
if data == null or size < 24:
ret false
end
defer mem.Free(data)
bytes := data as u8*
width := ((bytes[18] as int) << 8) | (bytes[19] as int)
mut out := compress.NewByteBuf()
magic := "icns"
compress.BufPushBytes(out, magic as void*, 4)
_push_be32(out, (size + 16) as int)
tag := _icns_tag(width)
compress.BufPushBytes(out, tag as void*, 4)
_push_be32(out, (size + 8) as int)
compress.BufPushBytes(out, data, size as int)
ret archive.WriteBinaryFileBuf(out_path, out)
end
func _push_be32(out &: compress.ByteBuf, value: int):
compress.BufPush(out, (value >> 24) & 0xFF)
compress.BufPush(out, (value >> 16) & 0xFF)
compress.BufPush(out, (value >> 8) & 0xFF)
compress.BufPush(out, value & 0xFF)
end
func _png_to_ico(path: str, out_path: str): bool:
mut size := 0 as i64
data := _read_bytes(path, size)
if data == null or size < 24:
ret false
end
defer mem.Free(data)
bytes := data as u8*
width := ((bytes[18] as int) << 8) | (bytes[19] as int)
height := ((bytes[22] as int) << 8) | (bytes[23] as int)
mut out := compress.NewByteBuf()
archive.LEPut16(out, 0)
archive.LEPut16(out, 1)
archive.LEPut16(out, 1)
compress.BufPush(out, width >= 256 ? 0 : width)
compress.BufPush(out, height >= 256 ? 0 : height)
compress.BufPush(out, 0)
compress.BufPush(out, 0)
archive.LEPut16(out, 1)
archive.LEPut16(out, 32)
archive.LEPut32(out, size as int)
archive.LEPut32(out, 22)
compress.BufPushBytes(out, data, size as int)
ret archive.WriteBinaryFileBuf(out_path, out)
end
func _xml(text: str): str:
amps := str.Replace(text, "&", "&amp;")
opens := str.Replace(amps, "<", "&lt;")
closes := str.Replace(opens, ">", "&gt;")
ret str.Replace(closes, "\"", "&quot;")
end
func _info_plist(b: _Build, has_icon: bool): str:
m := b.manifest
mut out := `<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>CFBundleName</key><string>` + _xml(m.name) + `</string>
<key>CFBundleDisplayName</key><string>` + _xml(m.name) + `</string>
<key>CFBundleIdentifier</key><string>` + _xml(m.id) + `</string>
<key>CFBundleExecutable</key><string>` + _xml(m.slug) + `</string>
<key>CFBundleVersion</key><string>` + _xml(m.version) + `</string>
<key>CFBundleShortVersionString</key><string>` + _xml(m.version) + `</string>
<key>CFBundlePackageType</key><string>APPL</string>
<key>NSHighResolutionCapable</key><true/>
<key>LSMinimumSystemVersion</key><string>11.0</string>
`
if has_icon:
out += "<key>CFBundleIconFile</key><string>app.icns</string>\n"
end
ret out + "</dict></plist>\n"
end
func _mac_app_files(b: _Build, files &: Vector<archive.TarFileInput>): bool:
m := b.manifest
root := m.name + ".app/"
each dir in ["", "Contents/", "Contents/MacOS/", "Contents/Resources/"]:
_tar_add_dir(files, root + dir)
end
if not _tar_add_file(files, root + "Contents/MacOS/" + m.slug, b.exe, 0o755):
ret false
end
if b.pack.len() > 0:
if not _tar_add_file(files, root + "Contents/Resources/app.pack", b.pack, 0o644):
ret false
end
end
mut has_icon := false
if m.icon.len() > 0:
icns := filepath.Join(b.work, "app.icns")
made := str.EndsWith(m.icon, ".icns") ? _copy_file(m.icon, icns) : _png_to_icns(m.icon, icns)
if made:
has_icon = _tar_add_file(files, root + "Contents/Resources/app.icns", icns, 0o644)
end
end
_tar_add_text(files, root + "Contents/Info.plist", _info_plist(b, has_icon))
ret true
end
func _package_tar_mac(b: _Build): bool:
mut files := Vector {} as Vector<archive.TarFileInput>
defer files.free()
if not _mac_app_files(b, files):
ret false
end
ret _write_targz(files, filepath.Join(b.output, b.base + ".tar.gz"))
end
func _package_app_dir(b: _Build): bool:
mut files := Vector {} as Vector<archive.TarFileInput>
defer files.free()
if not _mac_app_files(b, files):
ret false
end
tar := archive.TarCreate(files)
if not archive.TarExtractAll(tar.data, tar.len, b.output):
ret false
end
_exec := fs.Chmod(filepath.Join(b.output, b.manifest.name + ".app/Contents/MacOS/" + b.manifest.slug), 0o755)
ret true
end
func _package_dmg(b: _Build): bool:
if not _on_path("hdiutil"):
_say("dmg needs hdiutil, which only exists on macOS")
ret false
end
source := filepath.Join(b.work, "dmg")
_mk := os.MkdirAll(source)
mut files := Vector {} as Vector<archive.TarFileInput>
defer files.free()
if not _mac_app_files(b, files):
ret false
end
tar := archive.TarCreate(files)
if not archive.TarExtractAll(tar.data, tar.len, source):
ret false
end
_exec := fs.Chmod(filepath.Join(source, b.manifest.name + ".app/Contents/MacOS/" + b.manifest.slug), 0o755)
mut args := Vector {} as Vector<str>
defer args.free()
args.push("create")
args.push("-volname")
args.push(b.manifest.name)
args.push("-srcfolder")
args.push(source)
args.push("-ov")
args.push("-format")
args.push("UDZO")
args.push(filepath.Join(b.output, b.base + ".dmg"))
ret shell.Run("hdiutil", args).code == 0
end
func _compile(b &: _Build): bool:
m := b.manifest
exe_name := b.os_name == "windows" ? m.slug + ".exe" : m.slug
b.exe = filepath.Join(b.work, exe_name)
mut args := Vector {} as Vector<str>
defer args.free()
args.push("build")
args.push(filepath.Join(b.project, m.main))
args.push("--release")
args.push("--log-level=error")
args.push("--output=" + b.exe)
if b.target.len() > 0:
args.push("--target=" + b.target)
end
if m.engine == "chromium":
args.push("-DSALAM_WEBVIEW_CEF")
end
backend := b.backend.len() > 0 ? b.backend : (b.os_name == "linux" ? "" : "native")
if backend.len() > 0:
args.push("--backend=" + backend)
end
if b.os_name == "windows":
args.push("--subsystem=windows")
manifest_path := filepath.Join(b.work, "app.manifest")
if _write(manifest_path, WINDOWS_MANIFEST):
args.push("--manifest=" + manifest_path)
end
args.push("--version-info=version=" + m.version)
args.push("--version-info=product=" + m.name)
if m.publisher.len() > 0:
args.push("--version-info=company=" + m.publisher)
end
if m.description.len() > 0:
args.push("--version-info=description=" + m.description)
end
if m.icon.len() > 0:
ico := filepath.Join(b.work, "app.ico")
made := str.EndsWith(m.icon, ".ico") ? _copy_file(m.icon, ico) : _png_to_ico(m.icon, ico)
if made:
args.push("--icon=" + ico)
end
end
end
here := os.Cwd()
_moved := os.Chdir(b.work)
result := shell.Run(b.salam, args)
_back := os.Chdir(here)
if result.code != 0:
printerrln result.out
printerrln result.err
ret false
end
ret os.Exists(b.exe)
end
@en "ReadManifest"
@fa "خواندن شناسنامه"
pub func ReadManifest(path: str, out &: Manifest): bool:
if not os.Exists(path):
ret false
end
text := io.ReadFile(path)
lines := str.Split(text, "\n")
defer lines.free()
mut inside := false
mut seen := false
each raw in lines:
line := str.Trim(raw)
if str.StartsWith(line, "["):
inside = line == "[app]"
seen = seen or inside
continue
end
sign := str.IndexOf(line, "=")
if not inside or sign <= 0 or str.StartsWith(line, "#"):
continue
end
key := str.Trim(str.Substr(line, 0, sign))
value := _unquote(str.Substr(line, sign + 1, str.Len(line) - sign - 1))
if key == "id":
out.id = value
else key == "name":
out.name = value
else key == "version":
out.version = value
else key == "main":
out.main = value
else key == "assets":
out.assets = value
else key == "icon":
out.icon = value
else key == "description":
out.description = value
else key == "publisher":
out.publisher = value
else key == "category":
out.category = value
else key == "engine":
out.engine = value
else key == "runtime":
out.runtime = value
end
end
if out.name.len() == 0:
out.name = out.id
end
out.slug = _slug(out.name)
ret seen
end
@en "Main"
@fa "اجرا"
pub func Main(args: Vector<str>): int:
mut project := ""
mut target := ""
mut backend := ""
mut engine := ""
mut runtime := ""
mut output := "dist"
mut formats := ""
mut caller := ""
mut self_path := os.Env("SALAM_SELF")
repeat args.len() in i:
if i == 0:
continue
end
arg := args[i]
if arg == "--help" or arg == "-h":
println USAGE
ret 0
else str.StartsWith(arg, "--target="):
target = str.Substr(arg, 9, str.Len(arg) - 9)
else str.StartsWith(arg, "--backend="):
backend = str.Substr(arg, 10, str.Len(arg) - 10)
else str.StartsWith(arg, "--engine="):
engine = str.Substr(arg, 9, str.Len(arg) - 9)
else str.StartsWith(arg, "--runtime="):
runtime = str.Substr(arg, 10, str.Len(arg) - 10)
else str.StartsWith(arg, "--output="):
output = str.Substr(arg, 9, str.Len(arg) - 9)
else str.StartsWith(arg, "--format="):
formats = str.Substr(arg, 9, str.Len(arg) - 9)
else str.StartsWith(arg, "--cwd="):
caller = str.Substr(arg, 6, str.Len(arg) - 6)
else str.StartsWith(arg, "--salam="):
self_path = str.Substr(arg, 8, str.Len(arg) - 8)
else str.StartsWith(arg, "-"):
printerrln USAGE
ret _fail("unknown option " + arg)
else:
project = arg
end
end
if caller.len() > 0:
_moved := os.Chdir(caller)
end
if project.len() == 0:
project = "."
end
root := filepath.Abs(project)
mut m := Manifest {}
if not ReadManifest(filepath.Join(root, "salam.toml"), m):
ret _fail("no [app] table in " + filepath.Join(root, "salam.toml"))
end
if m.id.len() == 0:
ret _fail("[app] needs an id, for example id = \"com.example.notes\"")
end
if m.icon.len() > 0:
m.icon = filepath.Join(root, m.icon)
end
if engine.len() > 0:
m.engine = engine
end
if m.engine != "system" and m.engine != "chromium":
ret _fail("engine must be system or chromium, not " + m.engine)
end
if runtime.len() > 0:
m.runtime = runtime
end
if m.runtime.len() == 0:
m.runtime = os.Env("SALAM_CEF_DIR")
end
if m.engine == "chromium":
if m.runtime.len() == 0:
ret _fail("the chromium engine needs the folder with the built salam_webview_cef library and the CEF runtime: runtime = \"dir\" in [app], --runtime=DIR or SALAM_CEF_DIR (see std/gui/webview/native/CMakeLists.txt)")
end
m.runtime = filepath.IsAbs(m.runtime) ? m.runtime : filepath.Join(root, m.runtime)
if not os.IsDir(m.runtime):
ret _fail("runtime folder not found: " + m.runtime)
end
end
mut b := _Build {
manifest = m, project = root, output = filepath.IsAbs(output) ? output : filepath.Join(os.Cwd(), output),
target = target, os_name = _os_of(target), arch = _arch_of(target), backend = backend, runtime = m.engine == "chromium" ? m.runtime : "",
salam = self_path.len() > 0 ? self_path : "salam"
}
b.base = m.slug + "-" + m.version + "-" + b.os_name + "-" + b.arch
b.work = filepath.Join(os.TempDir(), "salam-bundle-" + m.slug + "-" + b.os_name + "-" + b.arch)
_clean := os.RemoveAll(b.work)
_a := os.MkdirAll(b.work)
_b := os.MkdirAll(b.output)
_say("building " + m.name + " " + m.version + " for " + b.os_name + " " + b.arch)
if not _compile(b):
ret _fail("the build failed")
end
if m.assets.len() > 0:
assets_dir := filepath.Join(root, m.assets)
if not os.IsDir(assets_dir):
ret _fail("assets folder not found: " + assets_dir)
end
b.pack = filepath.Join(b.work, "app.pack")
count := pack.PackDir(assets_dir, b.pack, m.id)
if count < 0:
ret _fail("could not pack " + assets_dir)
end
_say("packed " + str.FromInt(count as i64) + " assets")
if b.os_name != "macos":
if not pack.AppendPack(b.exe, b.pack):
ret _fail("could not add the assets to " + b.exe)
end
end
end
if formats.len() == 0:
if b.os_name == "linux":
formats = "tar,deb"
else b.os_name == "windows":
formats = "zip"
else:
formats = "app,tar"
end
end
wanted := str.Split(formats, ",")
defer wanted.free()
each format in wanted:
mut ok := false
if b.runtime.len() > 0 and not ((b.os_name == "linux" and format == "tar") or (b.os_name == "windows" and format == "zip")):
ret _fail("the chromium engine can be packed as tar on Linux or zip on Windows, not " + format + " on " + b.os_name)
end
if b.os_name == "linux" and format == "tar":
ok = _package_tar_linux(b)
else b.os_name == "linux" and format == "deb":
ok = _package_deb(b)
else b.os_name == "linux" and format == "rpm":
ok = _package_rpm(b)
else b.os_name == "linux" and format == "appimage":
ok = _package_appimage(b)
else b.os_name == "windows" and format == "zip":
ok = _package_zip_windows(b)
else b.os_name == "windows" and format == "nsis":
ok = _package_nsis(b)
else b.os_name == "macos" and format == "tar":
ok = _package_tar_mac(b)
else b.os_name == "macos" and format == "app":
ok = _package_app_dir(b)
else b.os_name == "macos" and format == "dmg":
ok = _package_dmg(b)
else:
ret _fail("format '" + format + "' does not apply to " + b.os_name)
end
if not ok:
ret _fail("could not make " + format)
end
_say("made " + format)
end
_say("packages are in " + b.output)
ret 0
end
package webview
if SALAM_WEBVIEW_CEF:
if not SALAM_WEBVIEW_CEF_MOCK:
link dynamic "salam_webview_cef"
end
extern:
func salam_wv_cef_init(debug: int): int
func salam_wv_cef_create(width: int, height: int, debug: int): void*
func salam_wv_cef_destroy(view: void*)
func salam_wv_cef_pump()
func salam_wv_cef_is_closed(view: void*): int
func salam_wv_cef_set_title(view: void*, title: str)
func salam_wv_cef_set_size(view: void*, width: int, height: int, fixed: int)
func salam_wv_cef_set_html(view: void*, html: str)
func salam_wv_cef_navigate(view: void*, url: str)
func salam_wv_cef_eval(view: void*, js: str)
end
mut _cef_views := Vector {} as Vector<void*>
func _cef_view(id: int): void*:
ret _cef_views[id]
end
func _wv_bk_create(id: int, debug: bool, _visible: bool): bool:
until _cef_views.len() <= id:
_cef_views.push(null)
end
if salam_wv_cef_init(debug ? 1 : 0) == 0:
ret false
end
view := salam_wv_cef_create(800, 600, debug ? 1 : 0)
if view == null:
ret false
end
_cef_views[id] = view
ret true
end
func _wv_bk_destroy(id: int):
salam_wv_cef_destroy(_cef_view(id))
end
func _wv_bk_iter():
salam_wv_cef_pump()
repeat _cef_views.len() in i:
if _wv_alive(i) and salam_wv_cef_is_closed(_cef_views[i]) != 0:
_wv_mark_closed(i)
end
end
end
func _wv_bk_wake():
_wv_touch()
end
