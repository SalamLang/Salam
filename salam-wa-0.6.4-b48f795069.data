func _rotr32(x0: i64, n: int): i64:
x := x0 % 4294967296
if n == 0:
ret x
end
hi := x % POW2[n]
lo := x / POW2[n]
ret lo + hi * POW2[32 - n]
end
func _shr32(x0: i64, n: int): i64:
