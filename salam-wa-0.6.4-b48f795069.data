func WinHttpSetTimeouts(handle: void*, resolve: int, connect: int, send: int, receive: int): int
func GetLastError(): int
end
end
const MAX_COOKIES := 256
const DEFAULT_MAX_BODY := 268435456
const MAX_BODY_CAP := 1073741824
struct _Reply:
pub status: int = 0
pub head: str = ""
pub body: compress.ByteBuf = compress.ByteBuf {}
pub err: str = ""
pub url: str = ""
end
@en "Response"
@fa "پاسخ"
pub struct Response:
@en "status"
@fa "وضعیت"
pub status: int = 0
@en "body"
@fa "بدنه"
pub body: str = ""
@en "head"
@fa "سرصفحه"
pub head: str = ""
@en "err"
@fa "خطا"
pub err: str = ""
@en "url"
@fa "نشانی"
pub url: str = ""
end
@en "BytesResponse"
@fa "پاسخ بایتی"
pub struct BytesResponse:
@en "status"
@fa "وضعیت"
pub status: int = 0
@en "head"
@fa "سرصفحه"
pub head: str = ""
@en "body"
@fa "بدنه"
pub body: compress.ByteBuf = compress.ByteBuf {}
@en "err"
@fa "خطا"
pub err: str = ""
@en "url"
@fa "نشانی"
pub url: str = ""
end
@en "RequestOptions"
@fa "گزینه های درخواست"
pub struct RequestOptions:
@en "idle_ms"
@fa "میلی‌ثانیه‌بیکاری"
pub idle_ms: int = 30000
@en "timeout_ms"
@fa "میلی‌ثانیه‌زمان‌انتظار"
pub timeout_ms: int = 0
@en "max_body"
@fa "حداکثر‌بدنه"
pub max_body: int = 268435456
@en "max_redirects"
@fa "حداکثر‌تغییرمسیر"
pub max_redirects: int = 0
end
@en "Client"
@fa "کارخواه"
pub struct Client:
@en "cookies"
@fa "کوکی‌ها"
pub cookies: HashMap<str, str> = HashMap {} as HashMap<str, str>
@en "headers"
@fa "سرصفحه‌ها"
pub headers: HashMap<str, str> = HashMap {} as HashMap<str, str>
@en "cookie_hosts"
@fa "میزبان‌های‌کوکی"
pub cookie_hosts: HashMap<str, str> = HashMap {} as HashMap<str, str>
_host_copies: HashMap<str, str> = HashMap {} as HashMap<str, str>
_own_vals: HashMap<str, str> = HashMap {} as HashMap<str, str>
_own_keys: HashMap<str, str> = HashMap {} as HashMap<str, str>
@en "cookie_secure"
@fa "امنیت‌کوکی"
pub cookie_secure: HashMap<str, bool> = HashMap {} as HashMap<str, bool>
@en "options"
@fa "گزینه‌های درخواست"
pub options: RequestOptions = RequestOptions {}
@en "mu"
@fa "قفل"
pub mu: sync.Mutex = sync.Mutex {}
func _lock():
if this.mu.handle != null: sync.Lock(this.mu) end
end
func _unlock():
if this.mu.handle != null: sync.Unlock(this.mu) end
end
@en "SetHeader"
@fa "تنظیم سرصفحه"
pub func SetHeader(name: str, value: str):
this._lock()
this.headers.put(name, value)
this._unlock()
end
@en "SetCookie"
@fa "تنظیم کوکی"
pub func SetCookie(name: str, value: str):
this._lock()
this.cookies.put(name, value)
this.cookie_hosts.remove(name)
this.cookie_secure.remove(name)
this._drop_owned(name)
this._unlock()
end
@en "ClearCookies"
@fa "پاک کردن کوکی ها"
pub func ClearCookies():
this._lock()
this.cookies.free()
this.cookie_hosts.free()
this.cookie_secure.free()
this._free_owned()
this._free_host_copies()
this.cookies = HashMap {} as HashMap<str, str>
this.cookie_hosts = HashMap {} as HashMap<str, str>
this.cookie_secure = HashMap {} as HashMap<str, bool>
this._unlock()
end
@en "SetTimeout"
@fa "تنظیم مهلت"
pub func SetTimeout(total_ms: int):
this._lock()
this.options.timeout_ms = total_ms
this._unlock()
end
@en "SetIdleTimeout"
@fa "تنظیم مهلت بیکاری"
pub func SetIdleTimeout(idle_ms: int):
this._lock()
this.options.idle_ms = idle_ms
this._unlock()
end
@en "SetMaxRedirects"
@fa "تنظیم سقف تغییر مسیر"
pub func SetMaxRedirects(n: int):
this._lock()
this.options.max_redirects = n
this._unlock()
end
@en "SetMaxBody"
@fa "تنظیم سقف بدنه"
pub func SetMaxBody(bytes: int):
this._lock()
if bytes > 0: this.options.max_body = bytes end
this._unlock()
end
@en "Free"
@fa "آزادسازی"
pub func Free():
if this.mu.handle != null: sync.Destroy(this.mu) end
this.mu = sync.Mutex {}
this.cookies.free()
this.headers.free()
this.cookie_hosts.free()
this._free_owned()
this._free_host_copies()
this.cookie_secure.free()
end
func _drop_owned(name: str):
if this._own_vals.has(name):
v := this._own_vals.get(name)
this._own_vals.remove(name)
mem.Free(v as void*)
end
if this._own_keys.has(name):
k := this._own_keys.get(name)
this._own_keys.remove(name)
mem.Free(k as void*)
end
end
func _free_owned():
it := this._own_vals.iter()
until it.has_next():
mem.Free(it.value() as void*)
it.next()
end
this._own_vals.free()
kt := this._own_keys.iter()
until kt.has_next():
mem.Free(kt.value() as void*)
kt.next()
end
this._own_keys.free()
end
func _host_copy(host: str): str:
if not this._host_copies.has(host):
copy := str.Clone(host)
this._host_copies.put(copy, copy)
end
ret this._host_copies.get(host)
end
func _free_host_copies():
it := this._host_copies.iter()
until it.has_next():
mem.Free(it.value() as void*)
it.next()
end
this._host_copies.free()
end
func _opts(): RequestOptions:
this._lock()
mut o := this.options
this._unlock()
if o.max_body <= 0: o.max_body = DEFAULT_MAX_BODY end
if o.max_body > MAX_BODY_CAP: o.max_body = MAX_BODY_CAP end
ret o
end
func _host_cookies(host: str, orig_host: str, secure: bool): str:
if this.cookies.size() == 0: ret "" end
mut out := str.NewBuilder()
defer str.BufFree(out)
it := this.cookies.iter()
until it.has_next():
name := it.key()
value := it.value()
mut owner := ""
if this.cookie_hosts.has(name): owner = this.cookie_hosts.get(name) end
mut allow := owner == host
if owner.len() == 0: allow = host == orig_host end
if not secure and this.cookie_secure.has(name): allow = false end
if allow and _token_ok(name) and not _has_control(value) and value.find(";") < 0:
if out.len > 0: str.BufAppend(out, "; ") end
str.BufAppend(out, name)
str.BufAppend(out, "=")
str.BufAppend(out, value)
end
it.next()
end
if out.len == 0:
ret ""
end
ret str.BufStr(out)
end
func _jar_block(host: str, orig_host: str, secure: bool, user_block: str, bad &: str): str:
cross := host != orig_host
if this.mu.handle != null: sync.Lock(this.mu) end
base := _block_of(this.headers, bad)
ck := this._host_cookies(host, orig_host, secure)
if this.mu.handle != null: sync.Unlock(this.mu) end
if bad.len() > 0:
if ck.len() > 0:
mem.Free(ck as void*)
end
ret ""
end
mut b := str.NewBuilder()
defer str.BufFree(b)
if cross:
safe_base := _strip_sensitive(base)
str.BufAppend(b, safe_base)
if safe_base.len() > 0:
mem.Free(safe_base as void*)
end
else:
str.BufAppend(b, base)
end
if ck.len() > 0:
str.BufAppend(b, "Cookie: ")
str.BufAppend(b, ck)
str.BufAppend(b, "\r\n")
mem.Free(ck as void*)
end
if user_block.len() > 0:
if cross:
safe_user := _strip_sensitive(user_block)
str.BufAppend(b, safe_user)
mem.Free(safe_user as void*)
else:
str.BufAppend(b, user_block)
end
end
if base.len() > 0:
mem.Free(base as void*)
end
if b.len == 0:
ret ""
end
ret str.BufStr(b)
end
func _jar_absorb(host: str, head: str):
r := Response { head = head }
lines := HeaderValues(r, "Set-Cookie")
defer _free_lines(lines)
if lines.len() > 0:
if this.mu.handle != null: sync.Lock(this.mu) end
each line in lines:
semi := line.find(";")
mut pair := line
mut attrs := ""
if semi >= 0:
pair = line.substr(0, semi)
tail := line.substr(semi, line.len() - semi)
low_tail := str.Lower(tail)
attrs = str.Replace(low_tail, " ", "")
mem.Free(tail as void*)
mem.Free(low_tail as void*)
end
eqp := pair.find("=")
if eqp > 0:
name := _trimmed_part(pair, 0, eqp)
value := _trimmed_part(pair, eqp + 1, pair.len() - eqp - 1)
gone := str.Contains(attrs, ";max-age=0") or str.Contains(attrs, ";max-age=-")
mut kept := false
if gone:
this.cookies.remove(name)
this.cookie_hosts.remove(name)
this.cookie_secure.remove(name)
this._drop_owned(name)
else _token_ok(name) and not _has_control(value):
if this.cookies.has(name) or this.cookies.size() < MAX_COOKIES:
had := this._own_vals.has(name)
mut oldv := ""
mut oldk := ""
if had:
oldv = this._own_vals.get(name)
oldk = this._own_keys.get(name)
end
kept = true
this.cookies.put(name, value)
this._own_vals.put(name, value)
this._own_keys.put(name, name)
this.cookie_hosts.put(name, this._host_copy(host))
tagged := attrs.concat(";")
is_secure := str.Contains(tagged, ";secure;")
mem.Free(tagged as void*)
if is_secure:
this.cookie_secure.put(name, true)
else:
this.cookie_secure.remove(name)
end
if had:
mem.Free(oldv as void*)
mem.Free(oldk as void*)
end
end
end
if not kept:
mem.Free(name as void*)
mem.Free(value as void*)
end
end
if semi >= 0:
mem.Free(pair as void*)
mem.Free(attrs as void*)
end
end
if this.mu.handle != null: sync.Unlock(this.mu) end
end
end
func _run(method_in: str, url_str: str, block: str, body: str, o: RequestOptions): _Reply:
method := str.Upper(method_in)
defer mem.Free(method as void*)
e := _check_request(method, url_str, block)
if e.len() > 0: ret _Reply { err = e, url = url_str } end
mut deadline := 0 as i64
if o.timeout_ms > 0: deadline = sync.NowMs() + (o.timeout_ms as i64) end
mut cur_url := url_str
mut cur_method := method
mut cur_body := body
mut cur_block := block
mut first := url.URL {}
try:
first = url.Parse(url_str)
catch e:
ret _Reply { err = e.to_str(), url = url_str }
end
orig_host := str.Lower(first.host)
defer mem.Free(orig_host as void*)
mut hops := 0
until true:
mut u := first
if hops > 0:
try:
u = url.Parse(cur_url)
catch e:
ret _Reply { err = e.to_str(), url = cur_url }
end
end
se := _scheme_ok(u)
if se.len() > 0: ret _Reply { err = se, url = cur_url } end
mut total_ms := 0
if deadline > 0:
left := deadline - sync.NowMs()
if left <= 0: ret _Reply { err = "the request timed out", url = cur_url } end
total_ms = left as int
end
mut bad := ""
low_host := str.Lower(u.host)
defer mem.Free(low_host as void*)
mut hop_block := this._jar_block(low_host, orig_host, str.EqualFold(u.scheme, "https"), cur_block, bad)
if bad.len() > 0: ret _Reply { err = bad, url = cur_url } end
if cur_body.len() == 0 and (cur_method == "GET" or cur_method == "HEAD"):
stripped := _strip_body_headers(hop_block)
if hop_block.len() > 0:
mem.Free(hop_block as void*)
end
hop_block = stripped
else cur_body.len() > 0 and _header_at(hop_block, "Content-Type") < 0:
with_type := hop_block.concat("Content-Type: application/x-www-form-urlencoded\r\n")
if hop_block.len() > 0:
mem.Free(hop_block as void*)
end
hop_block = with_type
end
mut rep := _hop(cur_method, u, hop_block, cur_body, total_ms, o)
if hop_block.len() > 0:
mem.Free(hop_block as void*)
end
if rep.err.len() == 0: this._jar_absorb(low_host, rep.head) end
loc := _redirect_target(rep)
if rep.err.len() > 0 or loc.len() == 0 or o.max_redirects <= 0:
ret _finish(rep, o, cur_url)
end
compress.BufFree(rep.body)
if hops >= o.max_redirects:
ret _Reply { status = rep.status, head = rep.head, err = "stopped after " + hops + " redirects", url = cur_url }
end
if _has_space_or_control(loc):
ret _Reply { status = rep.status, head = rep.head, err = "the redirect target is not a valid URL", url = cur_url }
end
mut next := url.URL {}
try:
next = url.Join(u, loc)
catch e:
ret _Reply { status = rep.status, head = rep.head, err = "redirect: " + e.to_str(), url = cur_url }
end
ne := _scheme_ok(next)
if ne.len() > 0:
ret _Reply { status = rep.status, head = rep.head, err = "redirect: " + ne, url = cur_url }
end
if str.EqualFold(u.scheme, "https") and str.EqualFold(next.scheme, "http"):
ret _Reply { status = rep.status, head = rep.head, err = "refusing to follow a redirect from https to http", url = cur_url }
end
if _origin_of(u) != _origin_of(next): cur_block = _strip_sensitive(cur_block) end
s := rep.status
if s == 303 or ((s == 301 or s == 302) and cur_method == "POST"):
if cur_method != "HEAD": cur_method = "GET" end
cur_body = ""
cur_block = _strip_body_headers(cur_block)
end
cur_url = url.String(next)
if rep.head.len() > 0: mem.Free(rep.head as void*) end
mem.Free(loc as void*)
hops++
end
end
@en "Request"
@fa "درخواست"
pub func Request(method: str, url: str, body: str): Response:
ret _as_response(this._run(method, url, "", body, this._opts()))
end
@en "RequestRaw"
@fa "درخواست خام"
pub func RequestRaw(method: str, url: str, header_block: str, body: str): Response:
ret _as_response(this._run(method, url, header_block, body, this._opts()))
end
@en "RequestBytes"
@fa "درخواست بایتی"
pub func RequestBytes(method: str, url: str, header_block: str, body: str): BytesResponse:
rep := this._run(method, url, header_block, body, this._opts())
ret BytesResponse { status = rep.status, head = rep.head, body = rep.body, err = rep.err, url = rep.url }
end
@en "RequestWith"
@fa "درخواست با"
pub func RequestWith(method: str, url: str, body: str, extra: HashMap<str, str>): Response:
mut bad := ""
block := _block_of(extra, bad)
if bad.len() > 0: ret Response { err = bad, url = url } end
out := _as_response(this._run(method, url, block, body, this._opts()))
if block.len() > 0:
mem.Free(block as void*)
end
ret out
end
@en "Get"
@fa "دریافت"
pub func Get(url: str): Response: ret this.Request("GET", url, "") end
@en "Post"
@fa "ارسال"
pub func Post(url: str, body: str): Response: ret this.Request("POST", url, body) end
@en "Put"
@fa "قرار دادن"
pub func Put(url: str, body: str): Response: ret this.Request("PUT", url, body) end
@en "Delete"
@fa "حذف"
pub func Delete(url: str): Response: ret this.Request("DELETE", url, "") end
@en "Patch"
@fa "وصله"
pub func Patch(url: str, body: str): Response: ret this.Request("PATCH", url, body) end
@en "Options"
@fa "گزینه ها"
pub func Options(url: str): Response: ret this.Request("OPTIONS", url, "") end
@en "Head"
@fa "درخواست هد"
pub func Head(url: str): Response: ret this.Request("HEAD", url, "") end
end
func _hdr_lower(s: str): str:
ret str.Lower(s)
end
func _header_at(headers: str, name: str): int:
if headers.len() == 0:
ret 0 - 1
end
lower := str.Lower(headers)
defer mem.Free(lower as void*)
lower_name := str.Lower(name)
defer mem.Free(lower_name as void*)
mut b := str.NewBuilder()
str.BufAppend(b, "\r\n")
str.BufAppend(b, lower_name)
str.BufAppend(b, ":")
needle := str.BufStr(b)
str.BufFree(b)
defer mem.Free(needle as void*)
key := str.Substr(needle, 2, str.Len(needle) - 2)
defer mem.Free(key as void*)
if str.StartsWith(lower, key):
ret 0
end
nl := str.Find(lower, needle)
if nl < 0:
ret 0 - 1
end
ret nl + 2
end
func _trimmed_part(text: str, start: int, count: int): str:
part := text.substr(start, count)
out := part.trim()
mem.Free(part as void*)
ret out
end
func _header_value(headers: str, name: str, fallback: str): str:
at := _header_at(headers, name)
if at < 0:
ret fallback
end
start := at + name.len() + 1
mut stop := str.IndexFrom(headers, "\r\n", start)
if stop < 0:
stop = headers.len()
end
part := headers.substr(start, stop - start)
value := str.Trim(part)
mem.Free(part as void*)
if value.len() == 0:
mem.Free(value as void*)
ret fallback
end
ret value
end
func _has_control(s: str): bool:
bp := s as u8*
repeat s.len() in i:
c := bp[i] as int
if c < 32 or c == 127: ret true end
end
ret false
end
func _has_space_or_control(s: str): bool:
bp := s as u8*
repeat s.len() in i:
c := bp[i] as int
if c <= 32 or c == 127: ret true end
end
ret false
end
func _token_ok(s: str): bool:
if s.len() == 0: ret false end
bp := s as u8*
repeat s.len() in i:
c := bp[i] as int
if c <= 32 or c >= 127: ret false end
if c == 58 or c == 34 or c == 40 or c == 41 or c == 44 or c == 47 or c == 59 or c == 60 or c == 61 or c == 62 or c == 63 or c == 64 or c == 91 or c == 92 or c == 93 or c == 123 or c == 125:
ret false
end
end
ret true
end
func _free_lines(lines: Vector<str>):
each line in lines:
mem.Free(line as void*)
end
lines.free()
end
func _keep_lines(headers: str, keep: func (str) bool): str:
lines := str.Split(headers, "\r\n")
mut b := str.NewBuilder()
each line in lines:
low := str.Lower(line)
if line.len() > 0 and keep(low):
str.BufAppend(b, line)
str.BufAppend(b, "\r\n")
end
mem.Free(low as void*)
end
_free_lines(lines)
if b.len == 0:
str.BufFree(b)
ret ""
end
out := str.BufStr(b)
str.BufFree(b)
ret out
end
func _check_block(block: str): str:
if block.len() == 0: ret "" end
lines := str.Split(block, "\r\n")
defer _free_lines(lines)
each line in lines:
if line.len() > 0:
if _has_control(line): ret "a header contains a control character" end
colon := line.find(":")
if colon <= 0: ret "a header line has no name: " + line end
if not _token_ok(line.substr(0, colon)):
ret "invalid header name: " + line.substr(0, colon)
end
end
end
ret ""
end
func _block_of(headers: HashMap<str, str>, bad &: str): str:
mut b := str.NewBuilder()
defer str.BufFree(b)
it := headers.iter()
until it.has_next():
if not _token_ok(it.key()):
bad = "invalid header name: " + it.key()
ret ""
end
if _has_control(it.value()):
bad = "the value of header " + it.key() + " contains a control character"
ret ""
end
str.BufAppend(b, it.key())
str.BufAppend(b, ": ")
str.BufAppend(b, it.value())
str.BufAppend(b, "\r\n")
it.next()
end
if headers.size() == 0:
ret ""
end
ret str.BufStr(b)
end
func _drop_transport_headers(headers: str): str:
if headers.len() == 0:
ret ""
end
ret _keep_lines(
headers, (low: str): ret not (str.StartsWith(low, "accept-encoding:") or str.StartsWith(low, "connection:") or str.StartsWith(low, "content-length:") or str.StartsWith(low, "transfer-encoding:") or str.StartsWith(low, "host:")) end
)
end
func _is_sensitive(low: str): bool:
ret str.StartsWith(low, "authorization:") or str.StartsWith(low, "cookie:") or str.StartsWith(low, "proxy-authorization:") or str.StartsWith(low, "private-token:")
end
func _strip_sensitive(headers: str): str:
if headers.len() == 0: ret "" end
ret _keep_lines(headers, (low: str): ret not _is_sensitive(low) end)
end
func _strip_body_headers(headers: str): str:
if headers.len() == 0: ret "" end
ret _keep_lines(
headers, (low: str): ret not str.StartsWith(low, "content-type:") and not str.StartsWith(low, "content-length:") end
)
end
func _request_target(u: url.URL): str:
mut path := u.path
if path.len() == 0:
path = "/"
end
if u.raw_query.len() > 0:
ret path + "?" + u.raw_query
end
ret path
end
func _host_header(u: url.URL): str:
h := u.host.find(":") >= 0 ? "[" + u.host + "]" : str.Clone(u.host)
if u.port == 0:
ret h
end
if u.port == 80 and str.EqualFold(u.scheme, "http"):
ret h
end
if u.port == 443 and str.EqualFold(u.scheme, "https"):
ret h
end
port := str.FromInt(u.port as i64)
with_colon := h.concat(":")
out := with_colon.concat(port)
mem.Free(port as void*)
mem.Free(with_colon as void*)
mem.Free(h as void*)
ret out
end
func _build_head(method: str, u: url.URL, raw_headers: str, body_len: int): str:
target := _request_target(u)
headers := _drop_transport_headers(raw_headers)
mut host := _header_value(raw_headers, "Host", "")
if host.len() == 0:
host = _host_header(u)
end
mut b := str.NewBuilder()
str.BufAppend(b, method)
str.BufAppend(b, " ")
str.BufAppend(b, target)
str.BufAppend(b, " HTTP/1.1\r\nHost: ")
str.BufAppend(b, host)
str.BufAppend(b, "\r\n")
if host.len() > 0:
mem.Free(host as void*)
end
if _header_at(headers, "User-Agent") < 0:
str.BufAppend(b, "User-Agent: Salam/1.0\r\n")
end
if _header_at(headers, "Accept") < 0:
str.BufAppend(b, "Accept: */*\r\n")
end
str.BufAppend(b, "Accept-Encoding: gzip\r\nConnection: close\r\n")
if headers.len() > 0:
str.BufAppend(b, headers)
mem.Free(headers as void*)
end
if body_len > 0 or method == "POST" or method == "PUT" or method == "PATCH":
str.BufAppend(b, "Content-Length: ")
length := str.FromInt(body_len as i64)
str.BufAppend(b, length)
mem.Free(length as void*)
str.BufAppend(b, "\r\n")
end
str.BufAppend(b, "\r\n")
out := str.BufStr(b)
str.BufFree(b)
ret out
end
func _port_of(u: url.URL): int:
if u.port != 0: ret u.port end
if str.EqualFold(u.scheme, "http"): ret 80 end
ret 443
end
func _origin_of(u: url.URL): str:
ret str.Lower(u.scheme) + "://" + str.Lower(u.host) + ":" + _port_of(u)
end
func _check_request(method: str, url_str: str, block: str): str:
if not _token_ok(method): ret "invalid request method" end
if url_str.len() == 0: ret "no URL" end
if _has_space_or_control(url_str): ret "the URL contains a space or a control character" end
ret _check_block(block)
end
func _scheme_ok(u: url.URL): str:
if not str.EqualFold(u.scheme, "http") and not str.EqualFold(u.scheme, "https"):
if u.scheme.len() == 0: ret "the URL has no scheme" end
ret "unsupported URL scheme '" + u.scheme + "'"
end
if u.host.len() == 0: ret "no host in URL" end
ret ""
end
func _redirect_target(rep: _Reply): str:
s := rep.status
if s != 301 and s != 302 and s != 303 and s != 307 and s != 308: ret "" end
ret HeaderValue(rep.head, "Location")
end
func _finish(rep: _Reply, o: RequestOptions, url_str: str): _Reply:
mut out := rep
out.url = url_str
if out.err.len() > 0: ret out end
raw_enc := HeaderValue(out.head, "Content-Encoding")
enc := raw_enc.lower()
gzipped := str.Contains(enc, "gzip")
mem.Free(enc as void*)
if raw_enc.len() > 0:
mem.Free(raw_enc as void*)
end
if out.body.len > 0 and gzipped:
mut ok := false
plain := compress.GzipDecompressMax(out.body.data, out.body.len, o.max_body, ok)
compress.BufFree(out.body)
if not ok:
mut dead := plain
compress.BufFree(dead)
out.err = "the gzip body could not be decoded or is larger than the " + o.max_body + "-byte limit"
out.body = compress.NewByteBuf()
ret out
end
out.body = plain
end
if out.body.len > o.max_body:
compress.BufFree(out.body)
out.body = compress.NewByteBuf()
out.err = "the response body is larger than the " + o.max_body + "-byte limit"
end
ret out
end
func _as_response(rep: _Reply): Response:
mut r := Response { status = rep.status, head = rep.head, err = rep.err, url = rep.url }
mut buf := rep.body
r.body = compress.BufToStrUnsafe(buf)
if buf.len > 0 and r.body.len() == 0:
mem.Free(r.body as void*)
r.body = ""
end
compress.BufFree(buf)
ret r
end
if SALAM_OS_WINDOWS and not SALAM_NATIVE_TLS:
func _make_str(buf: void*, len: int): str:
if buf == null or len <= 0:
ret ""
end
dst := mem.Allocate((len + 1) as u64)
mem.Set(dst, 0, (len + 1) as u64)
mem.Copy(dst, buf, len as u64)
ret dst as str
end
func _str_to_wide(s: str): void*:
n := MultiByteToWideChar(65001 as u32, 0 as u32, s, 0 - 1, null, 0)
if n <= 0:
ret mem.Allocate(2 as u64)
end
w := mem.Allocate((n * 2) as u64)
MultiByteToWideChar(65001 as u32, 0 as u32, s, 0 - 1, w, n)
ret w
end
func _wide_to_str(w: void*): str:
if w == null: ret "" end
n := WideCharToMultiByte(65001 as u32, 0 as u32, w, 0 - 1, null, 0, null, null)
if n <= 0: ret "" end
buf := mem.Allocate(n as u64)
WideCharToMultiByte(65001 as u32, 0 as u32, w, 0 - 1, buf, n, null, null)
ret _make_str(buf, n - 1)
end
func _hop(method: str, u: url.URL, raw_headers: str, body: str, total_ms: int, o: RequestOptions): _Reply:
headers := _drop_transport_headers(raw_headers)
secure := str.EqualFold(u.scheme, "https")
wagent := _str_to_wide(_header_value(headers, "User-Agent", "Salam/1.0"))
sess := WinHttpOpen(wagent, 0, null, null, 0)
mem.Free(wagent)
if sess == null: ret _Reply { err = "could not open an HTTP session" } end
defer WinHttpCloseHandle(sess)
mut idle := o.idle_ms
if idle <= 0: idle = 0 end
mut dial := idle
if total_ms > 0 and (dial == 0 or total_ms < dial): dial = total_ms end
mut io := idle
if total_ms > 0 and (io == 0 or total_ms < io): io = total_ms end
WinHttpSetTimeouts(sess, dial, dial, io, io)
whost := _str_to_wide(u.host)
conn := WinHttpConnect(sess, whost, _port_of(u), 0)
mem.Free(whost)
if conn == null:
ret _Reply { err = "could not connect to " + u.host }
end
defer WinHttpCloseHandle(conn)
mut req_flags := 0
if secure: req_flags = 8388608 end
wverb := _str_to_wide(method)
wpath := _str_to_wide(_request_target(u))
req := WinHttpOpenRequest(conn, wverb, wpath, null, null, null, req_flags)
mem.Free(wverb)
mem.Free(wpath)
if req == null:
ret _Reply { err = "could not open the request" }
end
defer WinHttpCloseHandle(req)
WinHttpSetTimeouts(req, dial, dial, io, io)
off := mem.Allocate(4 as u64)
o32 := off as int*
o32[0] = 2
WinHttpSetOption(req, 63, off, 4)
mem.Free(off)
if headers.len() > 0:
wh := _str_to_wide(headers)
added := WinHttpAddRequestHeaders(req, wh, 0 - 1, 805306368)
mem.Free(wh)
if added == 0:
ret _Reply { err = "the request headers were refused" }
end
end
blen := body.len()
waited_from := sync.NowMs()
sent := WinHttpSendRequest(req, null, 0, body, blen, blen, 0 as usize)
if sent == 0:
ret _Reply { err = "could not send the request" }
end
recv_ok := WinHttpReceiveResponse(req, null)
if recv_ok == 0:
if GetLastError() == 12002 or (io > 0 and sync.NowMs() - waited_from >= (io as i64) - 5):
ret _Reply { err = "the request timed out" }
end
ret _Reply { err = "the server did not answer" }
end
mut hlen := mem.Allocate(8 as u64) as i64*
defer mem.Free(hlen as void*)
hlen[0] = 0
WinHttpQueryHeaders(req, 22, null, null, hlen as void*, null)
hsize := hlen[0] as int
mut hdr_str := str.Clone("HTTP/1.1 0 \r\n\r\n")
if hsize > 0:
wh := mem.Allocate((hsize + 4) as u64)
q2 := WinHttpQueryHeaders(req, 22, null, wh, hlen as void*, null)
if q2 != 0:
mem.Free(hdr_str as void*)
hdr_str = _wide_to_str(wh)
end
mem.Free(wh)
end
hend := hdr_str.len() - 4
if hend < 0 or hdr_str.substr(hend, 4) != "\r\n\r\n":
grown := hdr_str.concat("\r\n\r\n")
if hdr_str.len() > 0: mem.Free(hdr_str as void*) end
hdr_str = grown
end
buf := mem.Allocate(2050 as u64)
defer mem.Free(buf)
mut got := mem.Allocate(8 as u64) as i64*
defer mem.Free(got as void*)
mut out := _Reply { status = _status_of(hdr_str), head = hdr_str, body = compress.NewByteBuf() }
mut reading := true
mut cut := ""
mut broken := false
mut timed_out := false
until reading:
got[0] = 0
read_from := sync.NowMs()
rd_ok := WinHttpReadData(req, buf, 2048, got as void*)
if rd_ok == 0:
broken = true
timed_out = GetLastError() == 12002 or (io > 0 and sync.NowMs() - read_from >= (io as i64) - 5)
reading = false
else got[0] == 0:
reading = false
else:
compress.BufPushBytes(out.body, buf, got[0] as int)
if out.body.len > o.max_body + 65536:
compress.BufFree(out.body)
out.err = "the response body is larger than the " + o.max_body + "-byte limit"
reading = false
end
end
end
if out.err.len() == 0:
want := _header_value(hdr_str, "Content-Length", "")
plain := str.Equals(_header_value(hdr_str, "Content-Encoding", ""), "") and method != "HEAD" and out.status >= 200 and out.status != 204 and out.status != 304
short := plain and want.len() > 0 and want.to_int() > out.body.len
whole := want.len() > 0 and want.to_int() <= out.body.len
if timed_out:
cut = "the request timed out"
else short or (broken and not whole):
cut = "the response body was cut short"
end
if cut.len() > 0:
compress.BufFree(out.body)
ret _Reply { err = cut }
end
end
ret out
end
else:
func _hop(method: str, u: url.URL, raw_headers: str, body: str, total_ms: int, o: RequestOptions): _Reply:
ep := Endpoint { host = u.host, port = _port_of(u), secure = str.EqualFold(u.scheme, "https"), ok = u.host.len() > 0 }
head := _build_head(method, u, raw_headers, body.len())
mut r := RawResponse {}
if body.len() == 0:
r = _raw_send(ep, head, null, 0, o.idle_ms, total_ms, o.max_body + RAW_HEAD_LIMIT, tls.NewConfig(u.host))
else:
r = _raw_send(ep, head, body as void*, body.len(), o.idle_ms, total_ms, o.max_body + RAW_HEAD_LIMIT, tls.NewConfig(u.host))
end
mem.Free(head as void*)
if r.error.len() > 0: ret _Reply { err = r.error } end
mut out := _Reply { status = r.status, head = r.head, body = compress.NewByteBuf() }
compress.BufPushBytes(out.body, r.data, r.len)
FreeRaw(r)
ret out
end
end
func _status_of(head: str): int:
sp := head.find(" ")
if sp < 0: ret 0 end
ret head.substr(sp + 1, 3).to_int()
end
func _simple(method: str, url_str: str, block: str, body: str): Response:
mut c := Client {}
defer c.Free()
ret c.RequestRaw(method, url_str, block, body)
end
func _simple_with(method: str, url_str: str, headers: HashMap<str, str>, body: str): Response:
mut bad := ""
block := _block_of(headers, bad)
if bad.len() > 0: ret Response { err = bad, url = url_str } end
ret _simple(method, url_str, block, body)
end
@en "NewHeaders"
@fa "سرصفحه جدید"
pub func NewHeaders(): HashMap<str, str>:
m := HashMap {} as HashMap<str, str> ret m
end
@en "Get"
@fa "دریافت"
pub func Get(url: str): Response: ret _simple("GET", url, "", "") end
@en "Post"
@fa "ارسال"
pub func Post(url: str, body: str): Response: ret _simple("POST", url, "", body) end
@en "GetWith"
@fa "دریافت با"
pub func GetWith(url: str, headers: HashMap<str, str>): Response:
ret _simple_with("GET", url, headers, "")
end
@en "PostWith"
@fa "ارسال با"
pub func PostWith(url: str, body: str, headers: HashMap<str, str>): Response:
ret _simple_with("POST", url, headers, body)
end
@en "Request"
@fa "درخواست"
pub func Request(method: str, url: str, headers: HashMap<str, str>, body: str): Response:
ret _simple_with(method, url, headers, body)
end
@en "RequestRaw"
@fa "درخواست خام"
pub func RequestRaw(method: str, url: str, header_block: str, body: str): Response:
ret _simple(method, url, header_block, body)
end
@en "GetBytesWith"
@fa "دریافت بایت ها با"
pub func GetBytesWith(url: str, headers: HashMap<str, str>): BytesResponse:
mut bad := ""
block := _block_of(headers, bad)
if bad.len() > 0: ret BytesResponse { err = bad, url = url } end
mut c := Client {}
defer c.Free()
ret c.RequestBytes("GET", url, block, "")
end
@en "Do"
@fa "انجام درخواست"
pub func Do(method: str, url: str, headers: HashMap<str, str>, body: str, opts: RequestOptions): Response:
mut bad := ""
block := _block_of(headers, bad)
if bad.len() > 0: ret Response { err = bad, url = url } end
mut c := Client { options = opts }
defer c.Free()
ret c.RequestRaw(method, url, block, body)
end
@en "Ok"
@fa "موفق"
pub func Ok(r: Response): bool:
ret r.status >= 200 and r.status < 300
end
@en "Status"
@fa "وضعیت"
pub func Status(r: Response): int:
ret r.status
end
@en "Body"
@fa "بدنه"
pub func Body(r: Response): str:
ret r.body
end
@en "Error"
@fa "خطا"
pub func Error(r: Response): str:
ret r.err
end
@en "Headers"
@fa "سرصفحه ها"
pub func Headers(r: Response): HashMap<str, str>:
m := HashMap {} as HashMap<str, str> lines := r.head.split("\r\n")
defer lines.free()
repeat lines.len() in i:
line := lines.get(i)
c := line.find(":")
if c > 0:
key := line.substr(0, c)
val := line.substr(c + 1, line.len() - c - 1)
m.put(key, val.trim())
end
end
ret m
end
@en "GetHeader"
@fa "دریافت سرصفحه"
pub func GetHeader(r: Response, name: str): str:
target := _hdr_lower(name)
lines := r.head.split("\r\n")
defer lines.free()
mut result := ""
mut found := false
repeat lines.len() in i:
if found == false:
line := lines.get(i)
c := line.find(":")
if c > 0:
if _hdr_lower(line.substr(0, c)) == target:
result = line.substr(c + 1, line.len() - c - 1).trim()
found = true
end
end
end
end
ret result
end
@en "Raw"
@fa "خام"
pub func Raw(r: Response): str:
ret r.head.concat(r.body)
end
@en "RawHeaders"
@fa "سرصفحه های خام"
pub func RawHeaders(r: Response): str:
ret r.head
end
@en "HeaderValues"
@fa "مقادیر سرصفحه"
pub func HeaderValues(r: Response, name: str): Vector<str>:
target := _hdr_lower(name)
defer mem.Free(target as void*)
out := Vector {} as Vector<str>
lines := r.head.split("\r\n")
defer _free_lines(lines)
repeat lines.len() in i:
line := lines.get(i)
c := line.find(":")
if c > 0:
raw_name := line.substr(0, c)
lower_name := _hdr_lower(raw_name)
if lower_name == target:
raw_value := line.substr(c + 1, line.len() - c - 1)
out.push(raw_value.trim())
mem.Free(raw_value as void*)
end
mem.Free(raw_name as void*)
mem.Free(lower_name as void*)
end
end
ret out
end
@en "FreeResponse"
@fa "آزاد کردن پاسخ"
pub func FreeResponse(r: Response):
if r.body.len() > 0:
mem.Free(r.body as void*)
end
if r.head.len() > 0:
mem.Free(r.head as void*)
end
end
@en "Put"
@fa "قرار دادن"
pub func Put(url: str, body: str): Response: ret _simple("PUT", url, "", body) end
@en "PutWith"
@fa "قرار دادن با"
pub func PutWith(url: str, body: str, headers: HashMap<str, str>): Response:
ret _simple_with("PUT", url, headers, body)
end
@en "Delete"
@fa "حذف"
pub func Delete(url: str): Response: ret _simple("DELETE", url, "", "") end
@en "DeleteWith"
@fa "حذف با"
pub func DeleteWith(url: str, headers: HashMap<str, str>): Response:
ret _simple_with("DELETE", url, headers, "")
end
@en "Patch"
@fa "وصله"
pub func Patch(url: str, body: str): Response: ret _simple("PATCH", url, "", body) end
@en "PatchWith"
@fa "وصله با"
pub func PatchWith(url: str, body: str, headers: HashMap<str, str>): Response:
ret _simple_with("PATCH", url, headers, body)
end
@en "Options"
@fa "گزینه ها"
pub func Options(url: str): Response: ret _simple("OPTIONS", url, "", "") end
@en "OptionsWith"
@fa "گزینه ها با"
pub func OptionsWith(url: str, headers: HashMap<str, str>): Response:
ret _simple_with("OPTIONS", url, headers, "")
end
@en "Head"
@fa "درخواست هد"
pub func Head(url: str): Response: ret _simple("HEAD", url, "", "") end
@en "HeadWith"
@fa "سرصفحه با"
pub func HeadWith(url: str, headers: HashMap<str, str>): Response:
ret _simple_with("HEAD", url, headers, "")
end
@en "EncodeForm"
@fa "کدگذاری فرم"
pub func EncodeForm(params: HashMap<str, str>): str:
mut out := ""
it := params.iter()
mut first := true
until it.has_next():
if first == false: out = out.concat("&") end
out = out.concat(encoding.URLEncode(it.key())).concat("=").concat(encoding.URLEncode(it.value()))
first = false
it.next()
end
ret out
end
@en "WithQuery"
@fa "با پرسمان"
pub func WithQuery(base: str, params: HashMap<str, str>): str:
q := EncodeForm(params)
if q.len() == 0: ret base end
mut sep := "?"
if base.find("?") >= 0: sep = "&" end
ret base.concat(sep).concat(q)
end
@en "SetCookieLines"
@fa "خطوط کوکی"
pub func SetCookieLines(r: Response): Vector<str>:
ret HeaderValues(r, "Set-Cookie")
end
@en "CookieMap"
@fa "نگاشت کوکی"
pub func CookieMap(r: Response): HashMap<str, str>:
m := HashMap {} as HashMap<str, str>
raw := SetCookieLines(r)
repeat raw.len() in i:
rawline := raw.get(i)
semi := rawline.find(";")
mut pair := rawline
if semi >= 0:
pair = rawline.substr(0, semi)
end
eq_at := pair.find("=")
mut nm := pair
mut vl := ""
if eq_at >= 0:
nm = pair.substr(0, eq_at)
vl = pair.substr(eq_at + 1, pair.len() - eq_at - 1)
end
m.put(nm.trim(), vl.trim())
end
defer raw.free()
ret m
end
@en "CookieHeader"
@fa "سرصفحه کوکی"
pub func CookieHeader(cookies: HashMap<str, str>): str:
if cookies.size() == 0: ret "" end
mut out := ""
it := cookies.iter()
mut first := true
until it.has_next():
if first == false: out = out.concat("; ") end
out = out.concat(it.key()).concat("=").concat(it.value())
first = false
it.next()
end
ret out
end
@en "NewClient"
@fa "کارخواه جدید"
pub func NewClient(): Client:
ret Client { mu = sync.NewMutex() }
end
@en "middleware"
@fa "میان افزار"
package middleware
import net.http
import conv
@en "Log"
@fa "ثبت رخداد"
pub func Log(ctx: i64):
println "[HTTP]", http.Method(ctx), http.Path(ctx)
end
@en "AllowAll"
@fa "اجازه به همه"
pub func AllowAll(ctx: i64):
http.SetHeader(ctx, "Access-Control-Allow-Origin", "*")
http.SetHeader(ctx, "Access-Control-Allow-Methods", "GET, POST, PUT, DELETE, OPTIONS")
http.SetHeader(ctx, "Access-Control-Allow-Headers", "Content-Type, Authorization")
end
@en "Secure"
@fa "امن"
pub func Secure(ctx: i64):
http.SetHeader(ctx, "X-Content-Type-Options", "nosniff")
http.SetHeader(ctx, "X-Frame-Options", "DENY")
http.SetHeader(ctx, "X-XSS-Protection", "1; mode=block")
end
@en "NoCache"
@fa "بدون کش"
pub func NoCache(ctx: i64):
http.SetHeader(ctx, "Cache-Control", "no-store, no-cache, must-revalidate")
http.SetHeader(ctx, "Pragma", "no-cache")
end
@en "Cache"
@fa "کش"
pub func Cache(ctx: i64, seconds: int):
http.SetHeader(ctx, "Cache-Control", "max-age=" + conv.FormatInt(seconds as i64))
end
package http
func _ud_hex(code: int): int:
if code >= 48 and code <= 57: ret code - 48 end
if code >= 65 and code <= 70: ret code - 55 end
if code >= 97 and code <= 102: ret code - 87 end
ret 0 - 1
end
@en "UrlDecode"
@fa "رمزگشایی نشانی"
pub func UrlDecode(s: str): str:
n := s.len()
bp := (s as void*) as i8*
mut sb := str.NewBuilder()
defer str.BufFree(sb)
mut i := 0
until i < n:
code := (bp[i] as int) & 255
if code == 37 and i + 2 < n and _ud_hex((bp[i + 1] as int) & 255) >= 0 and _ud_hex((bp[i + 2] as int) & 255) >= 0:
str.BufAppendChar(sb, _ud_hex((bp[i + 1] as int) & 255) * 16 + _ud_hex((bp[i + 2] as int) & 255))
i += 3
else code == 43:
str.BufAppendChar(sb, 32)
i++
else:
str.BufAppendChar(sb, code)
i++
end
end
out := str.BufStr(sb)
ret out
end
package http
import mem
import str
import tls
import sync
import net.tcp
const RAW_CHUNK := 65536
const RAW_LIMIT_DEFAULT := 268435456
const RAW_HEAD_LIMIT := 65536
mut _raw_limit := RAW_LIMIT_DEFAULT
struct RawAcc:
pub data: void* = null
pub len: int = 0
pub cap: int = 0
pub bad: bool = false
pub scanned: int = 0
pub head_end: int = -1
pub mode: int = 0
pub need: int = 0
pub done: bool = false
pub head_only: bool = false
end
@en "RawResponse"
@fa "پاسخ خام"
pub struct RawResponse:
@en "status"
@fa "وضعیت"
pub status: int = 0
@en "head"
@fa "سرصفحه"
pub head: str = ""
@en "data"
@fa "داده"
pub data: void* = null
@en "len"
@fa "اندازه"
pub len: int = 0
@en "ok"
@fa "موفق"
pub ok: bool = false
@en "error"
@fa "خطا"
pub error: str = ""
end
inline func _raw_byte(p: void*, i: int): int:
bp := p as u8*
ret bp[i] as int
end
func _raw_grow(a &: RawAcc, need: int): bool:
if a.bad: ret false end
if a.len + need <= a.cap: ret true end
mut nc := a.cap
if nc < RAW_CHUNK: nc = RAW_CHUNK end
until nc < a.len + need: nc *= 2 end
p := mem.Reallocate(a.data, nc as u64)
if p == null:
a.bad = true
ret false
end
a.data = p
a.cap = nc
ret true
end
func _raw_at(a &: RawAcc, off: int): void*:
ret ((a.data as i64) + (off as i64)) as void*
end
func _next_wait(idle_ms: int, deadline: i64): int:
mut w := idle_ms
if deadline > 0:
left := deadline - sync.NowMs()
if left <= 0: ret -1 end
if w <= 0 or left < w: w = left as int end
end
ret w
end
func _timed_out(started: i64, waited: int): bool:
if waited <= 0: ret false end
ret sync.NowMs() - started >= (waited as i64) - 5
end
func _raw_note(a &: RawAcc): str:
if a.head_end >= 0: ret "" end
mut i := a.scanned
if i > 3:
i -= 3
else:
i = 0
end
until i + 3 < a.len:
if _raw_byte(a.data, i) == 13 and _raw_byte(a.data, i + 1) == 10 and _raw_byte(a.data, i + 2) == 13 and _raw_byte(a.data, i + 3) == 10:
a.head_end = i + 4
ret ""
end
i++
end
a.scanned = a.len
if a.len > RAW_HEAD_LIMIT: ret "the response head is larger than " + RAW_HEAD_LIMIT + " bytes" end
ret ""
end
func _all_digits(s: str): bool:
if s.len() == 0: ret false end
bp := s as u8*
repeat s.len() in i:
c := bp[i] as int
if c < 48 or c > 57: ret false end
end
ret true
end
func _raw_chunks_done(a &: RawAcc): bool:
mut src := a.head_end
until true:
mut size := 0
mut digits := 0
until src < a.len:
d := _raw_hexval(_raw_byte(a.data, src))
if d < 0: break end
size = size * 16 + d
digits++
src++
if digits > 12: ret false end
end
if digits == 0: ret false end
until src < a.len and _raw_byte(a.data, src) != 10: src++ end
if src >= a.len: ret false end
src++
if size == 0:
if a.len - src == 2 and _raw_byte(a.data, src) == 13 and _raw_byte(a.data, src + 1) == 10: ret true end
mut i := src
until i + 3 < a.len:
if _raw_byte(a.data, i) == 13 and _raw_byte(a.data, i + 1) == 10 and _raw_byte(a.data, i + 2) == 13 and _raw_byte(a.data, i + 3) == 10: ret true end
i++
end
ret false
end
if size > a.len - src: ret false end
src += size
if src < a.len and _raw_byte(a.data, src) == 13: src += 2
else src < a.len and _raw_byte(a.data, src) == 10: src++
end
end
end
func _raw_frame(a &: RawAcc):
head := _raw_head_str(a, a.head_end)
status := _raw_status(head)
a.mode = 1
if a.head_only or status < 200 or status == 204 or status == 304:
a.mode = 4
a.done = true
ret
end
if _raw_is_chunked(head):
a.mode = 3
ret
end
cl := HeaderValue(head, "Content-Length")
if cl.len() > 0 and cl.len() < 16 and _all_digits(cl):
a.mode = 2
a.need = cl.to_int()
end
if cl.len() > 0:
mem.Free(cl as void*)
end
end
func _raw_check_done(a &: RawAcc):
if a.head_end < 0 or a.done: ret end
if a.mode == 0: _raw_frame(a) end
if a.mode == 2 and a.len - a.head_end >= a.need:
a.done = true
else a.mode == 3 and a.len - a.head_end >= 5:
n := a.len
if _raw_byte(a.data, n - 1) == 10 and _raw_byte(a.data, n - 2) == 13 and _raw_byte(a.data, n - 3) == 10 and _raw_byte(a.data, n - 4) == 13:
if _raw_chunks_done(a): a.done = true end
end
end
end
func _raw_after_read(a &: RawAcc, limit: int): str:
if a.len > limit:
ret "the response is larger than the " + limit + "-byte limit"
end
e := _raw_note(a)
if e.len() > 0: ret e end
_raw_check_done(a)
ret ""
end
func _raw_read_plain(c: tcp.Conn, a &: RawAcc, idle_ms: int, deadline: i64, limit: int): str:
until true:
w := _next_wait(idle_ms, deadline)
if w < 0: ret "the request timed out" end
if w > 0: tcp.SetDeadline(c, w) end
if not _raw_grow(a, RAW_CHUNK): ret "out of memory reading the response" end
started := sync.NowMs()
n := tcp.ReadBytes(c, _raw_at(a, a.len), RAW_CHUNK)
if n <= 0:
if _timed_out(started, w): ret "the request timed out" end
ret ""
end
a.len += n
e := _raw_after_read(a, limit)
if e.len() > 0: ret e end
if a.done: ret "" end
end
end
func _raw_read_tls(t: tcp.Conn, c &: tls.Conn, a &: RawAcc, idle_ms: int, deadline: i64, limit: int): str:
until true:
w := _next_wait(idle_ms, deadline)
if w < 0: ret "the request timed out" end
if w > 0: tcp.SetDeadline(t, w) end
if not _raw_grow(a, RAW_CHUNK): ret "out of memory reading the response" end
started := sync.NowMs()
n := tls.ReadBytes(c, _raw_at(a, a.len), RAW_CHUNK)
if n <= 0:
if _timed_out(started, w): ret "the request timed out" end
ret ""
end
a.len += n
e := _raw_after_read(a, limit)
if e.len() > 0: ret e end
if a.done: ret "" end
end
end
func _raw_head_end(a &: RawAcc): int:
if a.head_end >= 0: ret a.head_end end
mut i := 0
until i + 3 < a.len:
if _raw_byte(a.data, i) == 13 and _raw_byte(a.data, i + 1) == 10 and _raw_byte(a.data, i + 2) == 13 and _raw_byte(a.data, i + 3) == 10:
ret i + 4
end
i++
end
ret -1
end
func _raw_head_str(a &: RawAcc, n: int): str:
mut sb := str.NewBuilder()
defer str.BufFree(sb)
repeat n in i:
str.BufAppendChar(sb, _raw_byte(a.data, i))
end
ret str.BufStr(sb)
end
func _raw_hexval(c: int): int:
if c >= 48 and c <= 57: ret c - 48 end
if c >= 97 and c <= 102: ret c - 87 end
if c >= 65 and c <= 70: ret c - 55 end
ret -1
end
func _raw_dechunk(a &: RawAcc, start: int, out_len &: int): bool:
mut src := start
mut dst := start
until true:
mut size := 0
mut digits := 0
until src < a.len:
d := _raw_hexval(_raw_byte(a.data, src))
if d < 0: break end
size = size * 16 + d
digits++
src++
if size > a.len:
ret false
end
end
if digits == 0: ret false end
until src < a.len and _raw_byte(a.data, src) != 10: src++ end
if src >= a.len: ret false end
src++
if size == 0:
out_len = dst - start
ret true
end
if size < 0 or size > a.len - src: ret false end
if dst != src:
mem.MemMove(_raw_at(a, dst), _raw_at(a, src), size as u64)
end
dst += size
src += size
if src + 1 < a.len and _raw_byte(a.data, src) == 13: src += 2
else src < a.len and _raw_byte(a.data, src) == 10: src++
end
end
end
func _raw_finish(a &: RawAcc, err: str): RawResponse:
if err.len() > 0:
mem.Free(a.data)
ret RawResponse { error = err }
end
if a.len == 0:
mem.Free(a.data)
ret RawResponse { error = "the server closed without answering" }
end
head_end := _raw_head_end(a)
if head_end < 0:
mem.Free(a.data)
ret RawResponse { error = "the response head never ended" }
end
if a.mode == 2 and a.len - head_end < a.need:
mem.Free(a.data)
ret RawResponse { error = "the response body was cut short" }
end
head := _raw_head_str(a, head_end)
mut body_len := a.len - head_end
if body_len > 0 and _raw_is_chunked(head):
mut decoded := 0
if not _raw_dechunk(a, head_end, decoded):
mem.Free(a.data)
ret RawResponse { error = "the chunked response body could not be decoded" }
end
body_len = decoded
end
status := _raw_status(head)
mut out := RawResponse {
status = status, head = head, len = body_len, ok = status >= 200 and status < 300
}
if body_len == 0:
mem.Free(a.data)
ret out
end
mem.MemMove(a.data, _raw_at(a, head_end), body_len as u64)
out.data = a.data
ret out
end
func _raw_is_chunked(head: str): bool:
value := HeaderValue(head, "Transfer-Encoding")
if value.len() == 0:
ret false
end
low := value.lower()
found := str.Contains(low, "chunked")
mem.Free(low as void*)
mem.Free(value as void*)
ret found
end
func _raw_status(head: str): int:
sp := head.find(" ")
if sp < 0: ret 0 end
code := head.substr(sp + 1, 3)
status := code.to_int()
mem.Free(code as void*)
ret status
end
func _send_error(deadline: i64, what: str): RawResponse:
if deadline > 0 and sync.NowMs() >= deadline:
ret RawResponse { error = "the request timed out" }
end
ret RawResponse { error = what }
end
func _raw_send_plain(
ep: Endpoint, head: str, body: void*, n: int, idle_ms: int, total_ms: int, limit: int
): RawResponse:
mut deadline := 0 as i64
if total_ms > 0: deadline = sync.NowMs() + (total_ms as i64) end
mut dial_ms := total_ms
if dial_ms <= 0: dial_ms = idle_ms end
c := tcp.DialTimeout(ep.host, ep.port, dial_ms)
if not tcp.ConnOk(c):
ret _send_error(deadline, "could not connect to " + ep.host + ":" + ep.port)
end
defer tcp.Close(c)
mut a := RawAcc { head_only = str.StartsWith(head, "HEAD ") }
w := _next_wait(idle_ms, deadline)
if w < 0: ret _raw_finish(a, "the request timed out") end
if w > 0: tcp.SetDeadline(c, w) end
if tcp.Write(c, head) < 0: ret _raw_finish(a, "could not send the request") end
if n > 0 and tcp.WriteBytes(c, body, n) < 0:
ret _raw_finish(a, "could not send the body")
end
ret _raw_finish(a, _raw_read_plain(c, a, idle_ms, deadline, limit))
end
func _raw_send_tls(
ep: Endpoint, head: str, body: void*, n: int, idle_ms: int, total_ms: int, limit: int, cfg: tls.Config
): RawResponse:
mut deadline := 0 as i64
if total_ms > 0: deadline = sync.NowMs() + (total_ms as i64) end
mut dial_ms := total_ms
if dial_ms <= 0: dial_ms = idle_ms end
t := tcp.DialTimeout(ep.host, ep.port, dial_ms)
if not tcp.ConnOk(t): ret _send_error(deadline, "could not connect to " + ep.host) end
mut conf := cfg
if conf.server_name.len() == 0: conf.server_name = ep.host end
w0 := _next_wait(idle_ms, deadline)
if w0 < 0:
tcp.Close(t)
ret RawResponse { error = "the request timed out" }
end
if w0 > 0: tcp.SetDeadline(t, w0) end
mut c := tls.WrapClient(t.fd, conf)
if not tls.ConnOk(c):
e := tls.ConnError(c)
tls.Close(c)
ret RawResponse { error = "TLS: " + e }
end
defer tls.Close(c)
mut a := RawAcc { head_only = str.StartsWith(head, "HEAD ") }
w := _next_wait(idle_ms, deadline)
if w < 0: ret _raw_finish(a, "the request timed out") end
if w > 0: tcp.SetDeadline(t, w) end
if tls.Write(c, head) < 0: ret _raw_finish(a, "could not send the request") end
if n > 0 and tls.WriteBytes(c, body, n) < 0:
ret _raw_finish(a, "could not send the body")
end
ret _raw_finish(a, _raw_read_tls(t, c, a, idle_ms, deadline, limit))
end
func _raw_send(
ep: Endpoint, head: str, body: void*, n: int, idle_ms: int, total_ms: int, limit: int, cfg: tls.Config
): RawResponse:
if not ep.ok: ret RawResponse { error = "the endpoint could not be parsed" } end
if ep.secure: ret _raw_send_tls(ep, head, body, n, idle_ms, total_ms, limit, cfg) end
ret _raw_send_plain(ep, head, body, n, idle_ms, total_ms, limit)
end
@en "SendRaw"
@fa "ارسال خام"
pub func SendRaw(ep: Endpoint, head: str, body: void*, n: int): RawResponse:
ret SendRawTimeout(ep, head, body, n, 0)
end
@en "SendRawTimeout"
@fa "ارسال خام با مهلت"
pub func SendRawTimeout(
ep: Endpoint, head: str, body: void*, n: int, timeout_ms: int
): RawResponse:
ret _raw_send(ep, head, body, n, timeout_ms, 0, _raw_limit, tls.NewConfig(ep.host))
end
@en "SendRawTLS"
@fa "ارسال خام با پیکربندی امن"
pub func SendRawTLS(
ep: Endpoint, head: str, body: void*, n: int, timeout_ms: int, cfg: tls.Config
): RawResponse:
ret _raw_send(ep, head, body, n, timeout_ms, 0, _raw_limit, cfg)
end
@en "FreeRaw"
@fa "آزادسازی پاسخ خام"
pub func FreeRaw(r &: RawResponse):
if r.data != null:
mem.Free(r.data)
r.data = null
end
r.len = 0
end
@en "RawText"
@fa "متن پاسخ خام"
pub func RawText(r: RawResponse): str:
if r.data == null or r.len == 0: ret "" end
mut sb := str.NewBuilder()
defer str.BufFree(sb)
repeat r.len in i:
b := _raw_byte(r.data, i)
if b == 0: break end
str.BufAppendChar(sb, b)
end
ret str.BufStr(sb)
end
@en "RawLimit"
@fa "سقف پاسخ خام"
pub func RawLimit(): int: ret _raw_limit end
@en "SetRawLimit"
@fa "تنظیم سقف پاسخ خام"
pub func SetRawLimit(bytes: int):
if bytes > 0: _raw_limit = bytes end
end
package http
import net.router
import net.internal.rawsock
import mem
import tls
if SALAM_OS_WINDOWS:
extern:
func _beginthread(start: void *, stack: u32, arg: void *): usize
end
else:
extern:
func pthread_create(thread: void *, attr: void *, start: void *, arg: void *): int
func pthread_detach(thread: u64): int
end
end
if not SALAM_OS_WINDOWS:
extern:
func signal(signum: int, handler: void *): void *
end
export:
func _http_ignore_sigpipe():
signal(13, 1 as void *)
end
end
end
if SALAM_OS_WINDOWS:
export:
func salam_spawn_fn_i64(fn: i64, arg: i64):
_h := _beginthread(fn as void *, 0 as u32, arg as void *)
end
end
else:
export:
func salam_spawn_fn_i64(fn: i64, arg: i64):
t := mem.Allocate(8 as u64)
if pthread_create(t, null, fn as void *, arg as void *) == 0:
tp := t as i64 *
pthread_detach(tp[0] as u64)
end
mem.Free(t)
end
end
end
func _bind(s: Server): i64:
_reqctx_sizeof()
_warm_up_split()
if not SALAM_OS_WINDOWS:
_http_ignore_sigpipe()
end
ret _net_listen(s.host, s.port)
end
func _accept_loop(packed: i64):
slot := _srv_slot_of(packed)
lfd := _srv_fd_of(packed)
events := _ev_start()
ctl := mem.AllocateZeroed(16 as u64)
until 1 == 1:
cfd := _net_accept(lfd)
if cfd >= 0:
if not (events and _ev_adopt(slot, cfd, ctl)):
salam_spawn_fn_i64(_web_conn_handler, _srv_pack(slot, cfd))
end
end
end
end
@en "NewServer"
@fa "سرور جدید"
pub func NewServer(port: int): Server:
ret Server { port = port }
end
@en "Use"
@fa "استفاده"
pub func Use(s &: Server, r: router.Router):
s.router = r
end
@en "HideTokens"
@fa "پنهان سازی توکن"
pub func HideTokens(s &: Server):
s.hide_tokens = true
end
@en "SetHost"
@fa "تنظیم میزبان"
pub func SetHost(s &: Server, host: str):
s.host = host
end
@en "EnableAccessLog"
@fa "فعال سازی گزارش دسترسی"
pub func EnableAccessLog(s &: Server):
s.access_log = true
end
@en "Run"
@fa "اجرا"
pub func Run(s: Server):
if SALAM_OS_WASM:
_edge_serve(s.router, s.hide_tokens, s.access_log)
else:
lfd := _bind(s)
if lfd < 0:
ret
end
slot := _srv_claim(s.router, s.hide_tokens, s.access_log)
if slot < 0:
rawsock.Close(rawsock.FromFd(lfd))
ret
end
_accept_loop(_srv_pack(slot, lfd))
end
end
@en "RunBackground"
@fa "اجرا در پس زمینه"
pub func RunBackground(s: Server): bool:
if SALAM_OS_WASM:
_edge_serve(s.router, s.hide_tokens, s.access_log)
ret true
else:
lfd := _bind(s)
if lfd < 0:
ret false
end
slot := _srv_claim(s.router, s.hide_tokens, s.access_log)
if slot < 0:
rawsock.Close(rawsock.FromFd(lfd))
ret false
end
salam_spawn_fn_i64(_accept_loop, _srv_pack(slot, lfd))
ret true
end
end
@en "RunBackgroundPort"
@fa "اجرا در پس زمینه با درگاه"
pub func RunBackgroundPort(s: Server): int:
if SALAM_OS_WASM:
_edge_serve(s.router, s.hide_tokens, s.access_log)
ret s.port
else:
lfd := _bind(s)
if lfd < 0:
ret 0
end
slot := _srv_claim(s.router, s.hide_tokens, s.access_log)
if slot < 0:
rawsock.Close(rawsock.FromFd(lfd))
ret 0
end
port := rawsock.LocalPort(rawsock.FromFd(lfd))
salam_spawn_fn_i64(_accept_loop, _srv_pack(slot, lfd))
ret port
end
end
@en "RunTLS"
@fa "اجرای امن"
pub func RunTLS(s: Server, cert_file: str, key_file: str):
if SALAM_OS_WASM:
_edge_serve(s.router, s.hide_tokens, s.access_log)
else:
lfd := _bind(s)
if lfd < 0:
ret
end
slot := _srv_claim(s.router, s.hide_tokens, s.access_log)
if slot < 0:
rawsock.Close(rawsock.FromFd(lfd))
ret
end
_srv_tls.set(slot, tls.NewServerConfig(cert_file, key_file))
_srv_is_tls.set(slot, true)
if _tls_tab == (0 as i64):
_tls_tab = _ev_table(_TLS_TAB_MAX)
end
_accept_loop(_srv_pack(slot, lfd))
end
end
@en "net/http/session"
@fa "نشست"
package session
import net.http
import crypto
import time
import sync
@en "DefaultCookieName"
@fa "نام پیش فرض کوکی"
pub const DefaultCookieName := "salam_sid"
@en "DefaultMaxAge"
@fa "حداکثر عمر پیش فرض"
pub const DefaultMaxAge := 86400
const _csrf_key := "_csrf_token"
mut _sessions := HashMap {} as HashMap<str, Session>
mut _mu := sync.Mutex {}
mut _cookie_name := "salam_sid"
mut _max_age := 86400
mut _secure := false
mut _same_site := "Lax"
mut _gc_hits := 0
@en "SessionData"
@fa "داده نشست"
pub struct SessionData:
@en "items"
@fa "مقدارها"
pub items: HashMap<str, str> = HashMap {} as HashMap<str, str>
end
@en "Session"
@fa "نشست"
pub struct Session:
@en "id"
@fa "شناسه"
pub id: str = ""
@en "data"
@fa "داده"
pub data: SessionData = SessionData {}
@en "created_at"
@fa "زمان ساخت"
pub created_at: i64 = 0
@en "last_seen"
@fa "آخرین استفاده"
pub last_seen: i64 = 0
@en "max_age"
@fa "بیشترین عمر"
pub max_age: int = 0
end
func _gen_id(): str:
ret crypto.RandomToken(32)
end
func _is_expired(s: Session, now: i64): bool:
if s.max_age <= 0: ret false end
ret (now - s.last_seen) > (s.max_age as i64)
end
func _ensure_mu():
if _mu.handle == null:
_mu = sync.NewMutex()
end
end
func _store_put(id: str, s: Session):
_ensure_mu()
sync.Lock(_mu)
_sessions.put(id, s)
sync.Unlock(_mu)
end
func _store_delete(id: str):
_ensure_mu()
sync.Lock(_mu)
_sessions.remove(id)
sync.Unlock(_mu)
end
func _store_touch(id: str, ok &: bool): Session:
now := time.Now()
_ensure_mu()
sync.Lock(_mu)
mut found := _sessions.has(id)
mut s := Session {}
if found:
s = _sessions.get(id)
if _is_expired(s, now):
_sessions.remove(id)
found = false
else:
s.last_seen = now
_sessions.put(id, s)
end
end
sync.Unlock(_mu)
ok = found
ret s
end
func _cleanup_expired(): int:
now := time.Now()
mut dead := Vector {} as Vector<str>
_ensure_mu()
sync.Lock(_mu)
it := _sessions.iter()
until it.has_next():
s := it.value()
if _is_expired(s, now):
dead.push(it.key())
end
it.next()
end
repeat dead.len() in i:
_sessions.remove(dead.get(i))
end
sync.Unlock(_mu)
n := dead.len()
defer dead.free()
ret n
end
func _maybe_gc():
_gc_hits++
if _gc_hits < 100:
ret
end
_gc_hits = 0
_cleanup_expired()
end
func _cookie_for(id: str): http.Cookie:
mut c := http.ExpiringCookie(_cookie_name, id, _max_age)
c.secure = _secure
c.same_site = _same_site
c.http_only = true
c.path = "/"
ret c
end
@en "Configure"
@fa "پیکربندی"
pub func Configure(cookie_name: str, max_age_seconds: int, secure: bool, same_site: str):
_cookie_name = cookie_name
_max_age = max_age_seconds
_secure = secure
_same_site = same_site
end
@en "CleanupExpired"
@fa "پاکسازی منقضی شده ها"
pub func CleanupExpired(): int: ret _cleanup_expired() end
@en "New"
@fa "جدید"
pub func New(): Session:
_maybe_gc()
now := time.Now()
s := Session { id = _gen_id(), created_at = now, last_seen = now, max_age = _max_age }
_store_put(s.id, s)
ret s
end
@en "Get"
@fa "دریافت"
pub func Get(id: str, ok &: bool): Session:
_maybe_gc()
mut found := false
s := _store_touch(id, found)
ok = found
ret s
end
@en "Save"
@fa "ذخیره"
pub func Save(s: Session): _store_put(s.id, s) end
@en "Destroy"
@fa "نابودسازی"
pub func Destroy(id: str): _store_delete(id) end
@en "Value"
@fa "مقدار"
pub func Value(s: Session, key: str): str:
if s.data.items.has(key): ret s.data.items.get(key) end
ret ""
end
@en "HasValue"
@fa "مقدار دارد"
pub func HasValue(s: Session, key: str): bool:
ret s.data.items.has(key)
end
@en "SetValue"
@fa "تنظیم مقدار"
pub func SetValue(s &: Session, key: str, value: str):
s.data.items.put(key, value)
end
@en "DeleteValue"
@fa "حذف مقدار"
pub func DeleteValue(s &: Session, key: str): bool:
ret s.data.items.remove(key)
end
@en "ClearValues"
@fa "پاک کردن مقادیر"
pub func ClearValues(s &: Session):
s.data = SessionData {}
end
@en "Start"
@fa "شروع"
pub func Start(h: i64): Session:
sid := http.CookieValue(h, _cookie_name)
mut ok := false
mut s := Session {}
if sid.len() > 0:
s = Get(sid, ok)
end
if ok == false:
s = New()
end
http.SetCookie(h, _cookie_for(s.id))
ret s
end
@en "End"
@fa "پایان"
pub func End(h: i64):
sid := http.CookieValue(h, _cookie_name)
if sid.len() > 0:
Destroy(sid)
end
http.ClearCookie(h, _cookie_name)
end
@en "Regenerate"
@fa "بازتولید"
pub func Regenerate(h: i64, s &: Session):
Destroy(s.id)
now := time.Now()
s.id = _gen_id()
s.created_at = now
s.last_seen = now
Save(s)
http.SetCookie(h, _cookie_for(s.id))
end
@en "CSRFToken"
@fa "توکن سی اس آر اف"
pub func CSRFToken(s &: Session): str:
if HasValue(s, _csrf_key) == false:
SetValue(s, _csrf_key, crypto.RandomToken(24))
end
ret Value(s, _csrf_key)
end
@en "CSRFVerify"
@fa "تایید سی اس آر اف"
pub func CSRFVerify(s: Session, token: str): bool:
if token.len() == 0: ret false end
want := Value(s, _csrf_key)
if want.len() == 0: ret false end
ret crypto.SecretEquals(want, token)
end
package http
import net.tcp
import sync
import mem
import str
import os
if SALAM_OS_WINDOWS:
import fs
end
if SALAM_OS_LINUX:
if SALAM_ARCH_X64 or SALAM_ARCH_ARM64:
extern:
func stat(path: str, buf: void *): int
end
else:
if SALAM_OS_ANDROID:
extern:
func stat64(path: str, buf: void *): int
end
else:
extern:
func statx(dirfd: int, path: str, flags: int, mask: u32, buf: void *): int
end
end
end
end
if SALAM_OS_MAC:
extern:
func stat(path: str, buf: void *): int
end
end
const _SC_MAX_ENTRIES := 1024
const _SC_MAX_FILE := 262144
const _SC_MAX_TOTAL := 33554432
mut _sc_mu := sync.NewMutex()
mut _sc_index := HashMap {} as HashMap<str, int>
mut _sc_key := Vector {} as Vector<str>
mut _sc_slot := Vector {} as Vector<int>
mut _sc_file := Vector {} as Vector<str>
mut _sc_sig := Vector {} as Vector<i64>
mut _sc_ptr := Vector {} as Vector<i64>
mut _sc_len := Vector {} as Vector<int>
mut _sc_refs := Vector {} as Vector<int>
mut _sc_live := Vector {} as Vector<bool>
mut _sc_spare := Vector {} as Vector<int>
mut _sc_bytes := 0
if SALAM_OS_LINUX:
if SALAM_ARCH_X64 or SALAM_ARCH_ARM64:
func _sc_signature(path: str): i64:
buf := mem.Allocate(256 as u64)
if stat(path, buf) != 0:
mem.Free(buf)
ret 0 - 1
end
w := buf as i64 *
sig := (w[11] * (1000000007 as i64) + w[12]) * (31 as i64) + w[6]
mem.Free(buf)
if sig < (0 as i64): ret 0 - sig end
ret sig
end
else:
if SALAM_OS_ANDROID:
func _sc_signature(path: str): i64:
buf := mem.Allocate(256 as u64)
if stat64(path, buf) != 0:
mem.Free(buf)
ret 0 - 1
end
mut size_at := 48
mut sec_at := 80
if SALAM_ARCH_X86:
size_at = 44
sec_at = 72
end
size := ((buf as i64 + size_at) as i64 *)[0]
secs := ((buf as i64 + sec_at) as u32 *)[0] as i64
ns := ((buf as i64 + sec_at + 4) as u32 *)[0] as i64
sig := (secs * (1000000007 as i64) + ns) * (31 as i64) + size
mem.Free(buf)
if sig < (0 as i64): ret 0 - sig end
ret sig
end
else:
func _sc_signature(path: str): i64:
buf := mem.Allocate(256 as u64)
if statx(0 - 100, path, 0, 2047 as u32, buf) != 0:
mem.Free(buf)
ret 0 - 1
end
w := buf as i64 *
ns := ((buf as i64 + 120) as u32 *)[0] as i64
sig := (w[14] * (1000000007 as i64) + ns) * (31 as i64) + w[5]
mem.Free(buf)
if sig < (0 as i64): ret 0 - sig end
ret sig
end
end
end
else:
func _sc_signature(path: str): i64: ret 0 - 1 end
end
func _sc_release(id: int):
mem.Free(_sc_ptr.get(id) as void *)
mem.Free(_sc_key.get(id) as void *)
mem.Free(_sc_file.get(id) as void *)
_sc_bytes -= _sc_len.get(id)
_sc_ptr.set(id, 0 as i64)
_sc_len.set(id, 0)
_sc_key.set(id, "")
_sc_file.set(id, "")
_sc_spare.push(id)
end
func _sc_drop(id: int):
if _sc_live.get(id) == false: ret end
_sc_live.set(id, false)
_sc_index.remove(_sc_key.get(id))
if _sc_refs.get(id) == 0:
_sc_release(id)
end
end
func _sc_new_id(): int:
if _sc_spare.len() > 0:
id := _sc_spare.get(_sc_spare.len() - 1)
_sc_spare.pop()
ret id
end
_sc_key.push("")
_sc_slot.push(0)
_sc_file.push("")
_sc_sig.push(0 as i64)
_sc_ptr.push(0 as i64)
_sc_len.push(0)
_sc_refs.push(0)
_sc_live.push(false)
ret _sc_key.len() - 1
end
func _sc_put(slot: int, url: str, file: str, sig: i64, buf: void *, n: int):
sync.Lock(_sc_mu)
if _sc_index.has(url):
_sc_drop(_sc_index.get(url))
end
if _sc_index.size() >= _SC_MAX_ENTRIES or _sc_bytes + n > _SC_MAX_TOTAL:
sync.Unlock(_sc_mu)
mem.Free(buf)
ret
end
id := _sc_new_id()
key := str.Clone(url)
_sc_key.set(id, key)
_sc_slot.set(id, slot)
_sc_file.set(id, str.Clone(file))
_sc_sig.set(id, sig)
_sc_ptr.set(id, buf as i64)
_sc_len.set(id, n)
_sc_refs.set(id, 0)
_sc_live.set(id, true)
_sc_index.put(key, id)
_sc_bytes += n
sync.Unlock(_sc_mu)
end
func _sc_serve(slot: int, fd: i64, url: str): bool:
sync.Lock(_sc_mu)
if _sc_index.has(url) == false:
sync.Unlock(_sc_mu)
ret false
end
id := _sc_index.get(url)
if _sc_slot.get(id) != slot:
sync.Unlock(_sc_mu)
ret false
end
_sc_refs.set(id, _sc_refs.get(id) + 1)
file := _sc_file.get(id)
want := _sc_sig.get(id)
ptr := _sc_ptr.get(id)
n := _sc_len.get(id)
sync.Unlock(_sc_mu)
fresh := _sc_signature(file) == want
if fresh:
_io_send(fd, ptr as void *, n)
end
sync.Lock(_sc_mu)
_sc_refs.set(id, _sc_refs.get(id) - 1)
if fresh == false:
_sc_drop(id)
end
if _sc_live.get(id) == false and _sc_refs.get(id) == 0 and _sc_ptr.get(id) != (0 as i64):
_sc_release(id)
end
sync.Unlock(_sc_mu)
ret fresh
end
func _sc_file_head(sz: i64, ct: str, server_hdr: str): str:
mut hb := str.NewBuilder()
str.BufAppend(hb, "HTTP/1.1 200 OK\r\nContent-Length: ")
str.BufAppendInt(hb, sz)
str.BufAppend(hb, "\r\nContent-Type: ")
str.BufAppend(hb, ct)
str.BufAppend(hb, "\r\nConnection: keep-alive\r\nServer: ")
str.BufAppend(hb, server_hdr)
str.BufAppend(hb, "\r\nX-Powered-By: ")
str.BufAppend(hb, server_hdr)
str.BufAppend(hb, "\r\n\r\n")
head := str.BufStr(hb)
str.BufFree(hb)
ret head
end
func _sc_send_new(slot: int, fd: i64, url: str, file: str, ct: str, server_hdr: str): bool:
sig := _sc_signature(file)
if sig < (0 as i64): ret false end
f := fopen(file, "rb")
if f == null: ret false end
fseek(f, 0, 2)
sz := ftell(f) as i64
fseek(f, 0, 0)
if sz < (0 as i64) or sz > (_SC_MAX_FILE as i64):
fclose(f)
ret false
end
head := _sc_file_head(sz, ct, server_hdr)
hl := head.len()
total := hl + (sz as int)
buf := mem.Allocate((total + 1) as u64)
mem.Copy(buf, head as void *, hl as u64)
mem.Free(head as void *)
got := fread((buf as i64 + hl) as void *, 1 as u64, sz as u64, f)
fclose(f)
if (got as i64) != sz:
mem.Free(buf)
ret false
end
_io_send(fd, buf, total)
_sc_put(slot, url, file, sig, buf, total)
ret true
end
if SALAM_OS_LINUX:
if SALAM_ARCH_X64 or SALAM_ARCH_ARM64:
@en "FileStat"
@fa "وضعیت پرونده"
pub func FileStat(path: str, size &: i64, mtime &: i64): bool:
buf := mem.Allocate(256 as u64)
if stat(path, buf) != 0:
mem.Free(buf)
ret false
end
w := buf as i64 *
size = w[6]
mtime = w[11]
mem.Free(buf)
ret true
end
else:
if SALAM_OS_ANDROID:
@en "FileStat"
@fa "وضعیت پرونده"
pub func FileStat(path: str, size &: i64, mtime &: i64): bool:
buf := mem.Allocate(256 as u64)
if stat64(path, buf) != 0:
mem.Free(buf)
ret false
end
w := buf as i64 *
size = w[6]
mtime = ((buf as i64 + 80) as u32 *)[0] as i64
mem.Free(buf)
ret true
end
else:
@en "FileStat"
@fa "وضعیت پرونده"
pub func FileStat(path: str, size &: i64, mtime &: i64): bool:
buf := mem.Allocate(256 as u64)
if statx(0 - 100, path, 0, 2047 as u32, buf) != 0:
mem.Free(buf)
ret false
end
w := buf as i64 *
size = w[5]
mtime = w[14]
mem.Free(buf)
ret true
end
end
end
else SALAM_OS_MAC:
@en "FileStat"
@fa "وضعیت پرونده"
pub func FileStat(path: str, size &: i64, mtime &: i64): bool:
buf := mem.Allocate(256 as u64)
if stat(path, buf) != 0:
mem.Free(buf)
ret false
end
w := buf as i64 *
size = w[12]
mtime = w[6]
mem.Free(buf)
ret true
end
else:
@en "FileStat"
@fa "وضعیت پرونده"
pub func FileStat(path: str, size &: i64, mtime &: i64): bool:
mtime = 0
size = os.FileSize(path)
if SALAM_OS_WINDOWS:
if size >= 0:
m := fs.ModTime(path)
if m > 0: mtime = m end
end
end
ret size >= 0
end
end
package swagger
import net.router
import str
import conv
func _op_label(o: Op): str:
ret o.method.concat(" ").concat(o.pattern)
end
func _has_scheme(d: Doc, name: str): bool:
repeat d.schemes.len() in i:
if str.Equals(d.schemes.get(i).name, name):
ret true
end
end
ret false
end
func _param_named(o: Op, name: str, loc: str): bool:
repeat o.params.len() in i:
p := o.params.get(i)
if str.Equals(p.name, name) and str.Equals(p.loc, loc):
ret true
end
end
ret false
end
func _op_id_of(o: Op): str:
ret o.op_id.len() > 0 ? o.op_id : _default_op_id(o.method, o.pattern)
end
func _bodyless(method: str): bool:
ret str.Equals(method, "GET") or str.Equals(method, "HEAD")
end
func _check_security(d: Doc, o: Op, out &: Vector<str>):
repeat o.security.len() in i:
name := o.security.get(i)
if not _has_scheme(d, name):
out.push(
_op_label(o).concat(": needs security scheme '").concat(name).concat("', which no BearerAuth or ApiKeyAuth declared")
)
end
end
end
func _check_path_params(o: Op, out &: Vector<str>):
declared := _path_params(o.pattern)
defer declared.free()
repeat declared.len() in i:
name := declared.get(i).name
if not _param_named(o, name, "path"):
out.push(
_op_label(o).concat(": the path has '{").concat(name).concat("}' but the operation does not declare it")
)
end
end
repeat o.params.len() in j:
p := o.params.get(j)
if not str.Equals(p.loc, "path"):
continue
end
mut found := false
repeat declared.len() in k:
if str.Equals(declared.get(k).name, p.name):
found = true
end
end
if not found:
out.push(
_op_label(o).concat(": declares path parameter '").concat(p.name).concat("', which the path does not contain")
)
end
if not p.required:
out.push(
_op_label(o).concat(": path parameter '").concat(p.name).concat("' is optional, and a path parameter cannot be")
)
end
end
end
func _check_replies(o: Op, out &: Vector<str>):
repeat o.replies.len() in i:
code := o.replies.get(i).code
if code < 100 or code > 599:
out.push(
_op_label(o).concat(": ").concat(conv.FormatInt(code as i64)).concat(" is not an HTTP status code")
)
end
end
end
@en "Problems"
@fa "مشکلات"
pub func Problems(d: Doc): Vector<str>:
mut out := Vector {} as Vector<str>
if d.title.len() == 0:
out.push("the document has no title")
end
if d.version.len() == 0:
out.push("the document has no version")
end
mut ids := Vector {} as Vector<str>
defer ids.free()
repeat d.ops.len() in i:
o := d.ops.get(i)
_check_security(d, o, out)
_check_path_params(o, out)
_check_replies(o, out)
if o.body_schema.len() > 0 and _bodyless(o.method):
out.push(
_op_label(o).concat(
": has a request body, and nothing between the client and the" + " handler will carry one on this method"
)
)
end
id := _op_id_of(o)
repeat ids.len() in j:
if str.Equals(ids.get(j), id):
out.push(
_op_label(o).concat(": operationId '").concat(id).concat("' is already used by another operation")
)
end
end
ids.push(id)
end
ret out
end
@en "Undocumented"
@fa "توضیح داده نشده"
pub func Undocumented(d: Doc): Vector<str>:
mut out := Vector {} as Vector<str>
repeat d.ops.len() in i:
o := d.ops.get(i)
if o.summary.len() == 0 and o.description.len() == 0 and o.replies.len() == 0:
out.push(_op_label(o))
end
end
ret out
end
@en "Missing"
@fa "جا افتاده"
pub func Missing(d: Doc, r: router.Router): Vector<str>:
mut out := Vector {} as Vector<str>
repeat r.routes.len() in i:
rt := r.routes.get(i)
if _is_own_route(rt.fn):
continue
end
mut found := false
repeat d.ops.len() in j:
o := d.ops.get(j)
if str.Equals(o.method, rt.method) and str.Equals(o.pattern, rt.pattern):
found = true
end
end
if not found:
out.push(rt.method.concat(" ").concat(rt.pattern))
end
end
ret out
end
@en "Free"
@fa "آزاد سازی"
pub func Free(d &: Doc):
repeat d.ops.len() in i:
mut o := d.ops.get(i)
o.tags.free()
o.params.free()
repeat o.replies.len() in j:
mut rp := o.replies.get(j)
rp.header_names.free()
rp.header_notes.free()
end
o.replies.free()
o.security.free()
end
d.ops.free()
d.servers.free()
d.server_notes.free()
d.defs.free()
d.schemes.free()
d.cur = 0 - 1
end
package swagger
import net.router
import str
const _WILDCARD_NAME := "path"
func _path_params(pattern: str): Vector<Param>:
mut out := Vector {} as Vector<Param>
n := pattern.len()
mut i := 0
until i < n:
c := pattern.substr(i, 1)
if str.Equals(c, ":"):
mut e := i + 1
until e < n and not str.Equals(pattern.substr(e, 1), "/"):
e++
end
out.push(
Param {
name = pattern.substr(i + 1, e - i - 1), loc = "path", required = true
}
)
i = e
else str.Equals(c, "*"):
out.push(
Param {
name = _WILDCARD_NAME, loc = "path", required = true, description = "the rest of the path, slashes included"
}
)
i++
else:
i++
end
end
ret out
end
func _openapi_path(pattern: str): str:
mut out := ""
n := pattern.len()
mut i := 0
until i < n:
c := pattern.substr(i, 1)
if str.Equals(c, ":"):
mut e := i + 1
until e < n and not str.Equals(pattern.substr(e, 1), "/"):
e++
end
out = out.concat("{").concat(pattern.substr(i + 1, e - i - 1)).concat("}")
i = e
else str.Equals(c, "*"):
out = out.concat("{").concat(_WILDCARD_NAME).concat("}")
i++
else:
out = out.concat(c)
i++
end
end
ret out
end
func _is_own_route(fn: i64): bool:
ret fn == _handle_ui or fn == _handle_spec
end
func _default_op_id(method: str, pattern: str): str:
mut out := method.lower()
n := pattern.len()
mut last_us := false
repeat n in i:
c := pattern.substr(i, 1)
if str.Equals(c, "/") or str.Equals(c, ":") or str.Equals(c, "*") or str.Equals(c, "-"):
if not last_us:
out = out.concat("_")
last_us = true
end
else:
out = out.concat(c)
last_us = false
end
end
if last_us and out.len() > 1:
ret out.substr(0, out.len() - 1)
end
ret out
end
@en "Scan"
@fa "پویش"
pub func Scan(d &: Doc, r: router.Router):
n := r.routes.len()
mut i := 0
until i < n:
rt := r.routes.get(i)
if not _is_own_route(rt.fn):
_add := Route(d, rt.method, rt.pattern)
end
i++
end
d.cur = 0 - 1
end
@en "ScanPrefix"
@fa "پویش با پیشوند"
pub func ScanPrefix(d &: Doc, r: router.Router, prefix: str):
n := r.routes.len()
mut i := 0
until i < n:
rt := r.routes.get(i)
if not _is_own_route(rt.fn) and rt.pattern.len() >= prefix.len() and str.Equals(
rt.pattern.substr(0, prefix.len()), prefix
):
_add := Route(d, rt.method, rt.pattern)
end
i++
end
d.cur = 0 - 1
end
package swagger
import net.http
import net.router
import os
import str
mut _mounts := Vector {} as Vector<_Mount>
struct _Mount:
pub prefix: str = ""
pub prefix_slash: str = ""
pub spec_path: str = ""
pub title: str = ""
pub spec: str = ""
pub page: str = ""
pub port: int = 0
end
func _host_port(host: str): int:
colon := str.LastIndex(host, ":")
if colon < 0 or colon == host.len() - 1:
ret 0
end
tail := host.substr(colon + 1, host.len() - colon - 1)
repeat tail.len() in i:
c := tail.substr(i, 1)
if c < "0" or c > "9":
ret 0
end
end
ret tail.to_int()
end
func _path_matches(m: _Mount, path: str, want_spec: bool): bool:
if want_spec:
ret str.Equals(m.spec_path, path)
end
ret str.Equals(m.prefix, path) or str.Equals(m.prefix_slash, path)
end
func _mount_for(path: str, host: str, want_spec: bool): int:
port := _host_port(host)
if port > 0:
repeat _mounts.len() in i:
m := _mounts.get(i)
if m.port == port and _path_matches(m, path, want_spec):
ret i
end
end
end
repeat _mounts.len() in j:
m2 := _mounts.get(j)
if m2.port == 0 and _path_matches(m2, path, want_spec):
ret j
end
end
repeat _mounts.len() in k:
if _path_matches(_mounts.get(k), path, want_spec):
ret k
end
end
ret 0 - 1
end
func _clean_prefix(prefix: str): str:
mut p := prefix
if p.len() == 0:
ret "/"
end
if not p.starts_with("/"):
p = "/".concat(p)
end
until p.len() > 1 and p.ends_with("/"):
p = p.substr(0, p.len() - 1)
end
ret p
end
func _spec_path_for(prefix: str): str:
if str.Equals(prefix, "/"):
ret "/openapi.json"
end
ret prefix.concat("/openapi.json")
end
func _register(prefix: str, port: int, title: str, spec: str): int:
p := _clean_prefix(prefix)
entry := _Mount {
prefix = p, prefix_slash = p.concat("/"), spec_path = _spec_path_for(p), title = title, spec = spec,
page = Page(title, ""), port = port
}
repeat _mounts.len() in i:
m := _mounts.get(i)
if str.Equals(m.prefix, p) and m.port == port:
_mounts.set(i, entry)
ret i
end
end
_mounts.push(entry)
ret _mounts.len() - 1
end
func _handle_ui(ctx: i64):
i := _mount_for(http.Path(ctx), http.Header(ctx, "Host"), false)
if i < 0:
http.SetStatus(ctx, 404)
http.Text(ctx, "404 Not Found")
ret
end
http.SetHeader(ctx, "Cache-Control", "no-cache")
http.Html(ctx, _mounts.get(i).page)
end
func _handle_spec(ctx: i64):
i := _mount_for(http.Path(ctx), http.Header(ctx, "Host"), true)
if i < 0:
http.SetStatus(ctx, 404)
http.Json(ctx, "{\"error\":\"not found\"}")
ret
end
http.SetHeader(ctx, "Access-Control-Allow-Origin", "*")
http.SetHeader(ctx, "Cache-Control", "no-cache")
http.Json(ctx, _mounts.get(i).spec)
end
func _mount_routes(r &: router.Router, prefix: str):
p := _clean_prefix(prefix)
router.Get(r, p, _handle_ui)
if not str.Equals(p, "/"):
router.Get(r, p.concat("/"), _handle_ui)
end
router.Get(r, _spec_path_for(p), _handle_spec)
end
func _serve_on(prefix: str, port: int): bool:
mut r := router.NewRouter()
_mount_routes(r, prefix)
mut s := http.NewServer(port)
http.Use(s, r)
ret http.RunBackground(s)
end
@en "Mount"
@fa "نصب"
pub func Mount(d: Doc, r &: router.Router, prefix: str):
_reg := _register(prefix, 0, d.title, Spec(d))
_mount_routes(r, prefix)
end
@en "MountSpec"
@fa "نصب مشخصات"
pub func MountSpec(spec: str, title: str, r &: router.Router, prefix: str):
_reg := _register(prefix, 0, title, spec)
_mount_routes(r, prefix)
end
@en "Serve"
@fa "سرو"
pub func Serve(d: Doc, port: int): bool:
_reg := _register("/", port, d.title, Spec(d))
ret _serve_on("/", port)
end
@en "ServeSpec"
@fa "سرو مشخصات"
pub func ServeSpec(spec: str, title: str, port: int): bool:
_reg := _register("/", port, title, spec)
ret _serve_on("/", port)
end
@en "SpecFromFile"
@fa "مشخصات از پرونده"
pub func SpecFromFile(path: str): str:
if not os.Exists(path):
ret ""
end
ret os.ReadFile(path)
end
@en "WriteSpec"
@fa "نوشتن مشخصات"
pub func WriteSpec(d: Doc, path: str): bool:
ret os.WriteFile(path, SpecIndent(d)) > 0
end
package swagger
import encoding.json
import conv
import str
func _q(s: str): str:
ret json.Str(s)
end
func _finish(b &: str.StringBuilder): str:
out := str.BufStr(b)
str.BufFree(b)
ret out
end
func _kv(key: str, value: str): str:
mut b := str.NewBuilder()
str.BufAppend(b, _q(key))
str.BufAppend(b, ":")
str.BufAppend(b, _q(value))
ret _finish(b)
end
func _kraw(key: str, raw: str): str:
mut b := str.NewBuilder()
str.BufAppend(b, _q(key))
str.BufAppend(b, ":")
str.BufAppend(b, raw)
ret _finish(b)
end
func _wrap(open: str, parts: Vector<str>, close: str): str:
mut b := str.NewBuilder()
str.BufAppend(b, open)
repeat parts.len() in i:
if i > 0:
str.BufAppend(b, ",")
end
str.BufAppend(b, parts.get(i))
end
str.BufAppend(b, close)
ret _finish(b)
end
func _obj(parts: Vector<str>): str:
ret _wrap("{", parts, "}")
end
func _arr(parts: Vector<str>): str:
ret _wrap("[", parts, "]")
end
func _opt(parts &: Vector<str>, key: str, value: str):
if value.len() > 0:
parts.push(_kv(key, value))
end
end
func _info(d: Doc): str:
mut parts := Vector {} as Vector<str>
defer parts.free()
parts.push(_kv("title", d.title))
parts.push(_kv("version", d.version))
_opt(parts, "description", d.description)
if d.contact_name.len() > 0 or d.contact_url.len() > 0 or d.contact_email.len() > 0:
mut c := Vector {} as Vector<str>
defer c.free()
_opt(c, "name", d.contact_name)
_opt(c, "url", d.contact_url)
_opt(c, "email", d.contact_email)
parts.push(_kraw("contact", _obj(c)))
end
if d.license_name.len() > 0:
mut l := Vector {} as Vector<str>
defer l.free()
l.push(_kv("name", d.license_name))
_opt(l, "url", d.license_url)
parts.push(_kraw("license", _obj(l)))
end
ret _obj(parts)
end
func _servers(d: Doc): str:
mut parts := Vector {} as Vector<str>
defer parts.free()
repeat d.servers.len() in i:
mut s := Vector {} as Vector<str>
defer s.free()
s.push(_kv("url", d.servers.get(i)))
_opt(s, "description", d.server_notes.get(i))
parts.push(_obj(s))
end
ret _arr(parts)
end
func _param(p: Param): str:
mut parts := Vector {} as Vector<str>
defer parts.free()
parts.push(_kv("name", p.name))
parts.push(_kv("in", p.loc))
parts.push(_kraw("required", p.required ? "true" : "false"))
_opt(parts, "description", p.description)
parts.push(_kraw("schema", p.schema))
ret _obj(parts)
end
func _content(content_type: str, schema: str): str:
mut b := str.NewBuilder()
str.BufAppend(b, "{")
str.BufAppend(b, _q(content_type.len() > 0 ? content_type : JSON_TYPE))
str.BufAppend(b, ":{\"schema\":")
str.BufAppend(b, schema)
str.BufAppend(b, "}}")
ret _finish(b)
end
func _replies(o: Op): str:
mut parts := Vector {} as Vector<str>
defer parts.free()
repeat o.replies.len() in i:
rp := o.replies.get(i)
mut body := Vector {} as Vector<str>
defer body.free()
body.push(_kv("description", rp.description.len() > 0 ? rp.description : "response"))
if rp.header_names.len() > 0:
mut hs := Vector {} as Vector<str>
defer hs.free()
repeat rp.header_names.len() in h:
mut one := Vector {} as Vector<str>
defer one.free()
_opt(one, "description", rp.header_notes.get(h))
one.push(_kraw("schema", "{\"type\":\"string\"}"))
hs.push(_kraw(rp.header_names.get(h), _obj(one)))
end
body.push(_kraw("headers", _obj(hs)))
end
if rp.schema.len() > 0:
body.push(_kraw("content", _content(rp.content_type, rp.schema)))
end
parts.push(_kraw(conv.FormatInt(rp.code as i64), _obj(body)))
end
if parts.len() == 0:
ret "{\"200\":{\"description\":\"OK\"}}"
end
ret _obj(parts)
end
func _security(o: Op): str:
mut parts := Vector {} as Vector<str>
defer parts.free()
repeat o.security.len() in i:
parts.push("{".concat(_kraw(o.security.get(i), "[]")).concat("}"))
end
ret _arr(parts)
end
func _tags_of(o: Op): str:
mut parts := Vector {} as Vector<str>
defer parts.free()
repeat o.tags.len() in i:
parts.push(_q(o.tags.get(i)))
end
ret _arr(parts)
end
func _params_of(o: Op): str:
mut parts := Vector {} as Vector<str>
defer parts.free()
repeat o.params.len() in i:
parts.push(_param(o.params.get(i)))
end
ret _arr(parts)
end
func _operation(o: Op): str:
mut parts := Vector {} as Vector<str>
defer parts.free()
parts.push(_kv("operationId", o.op_id.len() > 0 ? o.op_id : _default_op_id(o.method, o.pattern)))
if o.tags.len() > 0:
parts.push(_kraw("tags", _tags_of(o)))
end
_opt(parts, "summary", o.summary)
_opt(parts, "description", o.description)
if o.is_deprecated:
parts.push(_kraw("deprecated", "true"))
end
if o.params.len() > 0:
parts.push(_kraw("parameters", _params_of(o)))
end
if o.body_schema.len() > 0:
mut rb := Vector {} as Vector<str>
defer rb.free()
_opt(rb, "description", o.body_description)
rb.push(_kraw("required", o.body_required ? "true" : "false"))
rb.push(_kraw("content", _content(o.body_content_type, o.body_schema)))
parts.push(_kraw("requestBody", _obj(rb)))
end
if o.security.len() > 0:
parts.push(_kraw("security", _security(o)))
end
parts.push(_kraw("responses", _replies(o)))
ret _obj(parts)
end
func _paths(d: Doc): str:
mut done := Vector {} as Vector<str>
defer done.free()
mut parts := Vector {} as Vector<str>
defer parts.free()
repeat d.ops.len() in i:
path := _openapi_path(d.ops.get(i).pattern)
mut seen := false
repeat done.len() in j:
if str.Equals(done.get(j), path):
seen = true
end
end
if seen:
continue
end
done.push(path)
mut methods := Vector {} as Vector<str>
defer methods.free()
repeat d.ops.len() in k:
o := d.ops.get(k)
if str.Equals(_openapi_path(o.pattern), path):
methods.push(_kraw(o.method.lower(), _operation(o)))
end
end
parts.push(_kraw(path, _obj(methods)))
end
ret _obj(parts)
end
func _scheme(s: Scheme): str:
mut parts := Vector {} as Vector<str>
defer parts.free()
parts.push(_kv("type", s.kind))
if str.Equals(s.kind, "apiKey"):
parts.push(_kv("in", s.loc))
parts.push(_kv("name", s.param.len() > 0 ? s.param : s.name))
else:
parts.push(_kv("scheme", s.scheme))
_opt(parts, "bearerFormat", s.format)
end
_opt(parts, "description", s.description)
ret _obj(parts)
end
func _components(d: Doc): str:
mut parts := Vector {} as Vector<str>
defer parts.free()
if d.defs.len() > 0:
mut schemas := Vector {} as Vector<str>
defer schemas.free()
repeat d.defs.len() in i:
schemas.push(_kraw(d.defs.get(i).name, d.defs.get(i).body))
end
parts.push(_kraw("schemas", _obj(schemas)))
end
if d.schemes.len() > 0:
mut sec := Vector {} as Vector<str>
defer sec.free()
repeat d.schemes.len() in i:
sec.push(_kraw(d.schemes.get(i).name, _scheme(d.schemes.get(i))))
end
parts.push(_kraw("securitySchemes", _obj(sec)))
end
ret _obj(parts)
end
func _tag_list(d: Doc): str:
mut seen := Vector {} as Vector<str>
defer seen.free()
mut parts := Vector {} as Vector<str>
defer parts.free()
repeat d.ops.len() in i:
o := d.ops.get(i)
repeat o.tags.len() in j:
name := o.tags.get(j)
mut have := false
repeat seen.len() in k:
if str.Equals(seen.get(k), name):
have = true
end
end
if not have:
seen.push(name)
parts.push("{".concat(_kv("name", name)).concat("}"))
end
end
end
ret _arr(parts)
end
@en "Spec"
@fa "مشخصات"
pub func Spec(d: Doc): str:
mut parts := Vector {} as Vector<str>
defer parts.free()
parts.push(_kv("openapi", "3.1.0"))
parts.push(_kraw("info", _info(d)))
if d.servers.len() > 0:
parts.push(_kraw("servers", _servers(d)))
end
tags := _tag_list(d)
if tags.len() > 2:
parts.push(_kraw("tags", tags))
end
parts.push(_kraw("paths", _paths(d)))
components := _components(d)
if components.len() > 2:
parts.push(_kraw("components", components))
end
ret _obj(parts)
end
@en "SpecIndent"
@fa "مشخصات با تورفتگی"
pub func SpecIndent(d: Doc): str:
ret json.Indent(Spec(d))
end
@en "net/http/swagger"
@fa "سواگر"
package swagger
import net.router
import encoding.json
import str
const _DEFS_PREFIX := "#/$defs/"
const _COMP_PREFIX := "#/components/schemas/"
@en "JSON_TYPE"
@fa "نوع جیسون"
pub const JSON_TYPE := "application/json"
@en "TEXT_TYPE"
@fa "نوع متن"
pub const TEXT_TYPE := "text/plain; charset=utf-8"
@en "HTML_TYPE"
@fa "نوع اچ تی ام ال"
pub const HTML_TYPE := "text/html; charset=utf-8"
@en "FORM_TYPE"
@fa "نوع فرم"
pub const FORM_TYPE := "application/x-www-form-urlencoded"
@en "TEXT_SCHEMA"
@fa "طرحواره متن"
pub const TEXT_SCHEMA := "{\"type\":\"string\"}"
@en "BINARY_SCHEMA"
@fa "طرحواره دودویی"
pub const BINARY_SCHEMA := "{\"type\":\"string\",\"format\":\"binary\"}"
@en "Param"
@fa "پارامتر"
pub struct Param:
@en "name"
@fa "نام"
pub name: str = ""
@en "loc"
@fa "جا"
pub loc: str = "query"
@en "required"
@fa "الزامی"
pub required: bool = false
@en "description"
@fa "توضیح"
pub description: str = ""
@en "schema"
@fa "طرحواره"
pub schema: str = "{\"type\":\"string\"}"
end
@en "Reply"
@fa "پاسخ"
pub struct Reply:
@en "code"
@fa "کد"
pub code: int = 200
@en "description"
@fa "توضیح"
pub description: str = ""
@en "schema"
@fa "طرحواره"
pub schema: str = ""
@en "content_type"
@fa "نوع محتوا"
pub content_type: str = "application/json"
@en "header_names"
@fa "نام سرآیندها"
pub header_names: Vector<str> = Vector {}
@en "header_notes"
@fa "توضیح سرآیندها"
pub header_notes: Vector<str> = Vector {}
end
@en "Scheme"
@fa "طرح احراز هویت"
pub struct Scheme:
@en "name"
@fa "نام"
pub name: str = ""
@en "kind"
@fa "نوع"
pub kind: str = "http"
@en "scheme"
@fa "طرح"
pub scheme: str = "bearer"
@en "format"
@fa "قالب"
pub format: str = ""
@en "loc"
@fa "جا"
pub loc: str = "header"
@en "param"
@fa "پارامتر کلید"
pub param: str = ""
@en "description"
@fa "توضیح"
pub description: str = ""
end
@en "Op"
@fa "عملیات"
pub struct Op:
@en "method"
@fa "روش"
pub method: str = ""
@en "pattern"
@fa "الگوی مسیر"
pub pattern: str = ""
@en "op_id"
@fa "شناسه عملیات"
pub op_id: str = ""
@en "summary"
@fa "خلاصه"
pub summary: str = ""
@en "description"
@fa "توضیح"
pub description: str = ""
@en "is_deprecated"
@fa "منسوخ"
pub is_deprecated: bool = false
@en "tags"
@fa "برچسب‌ها"
pub tags: Vector<str> = Vector {}
@en "params"
@fa "پارامترها"
pub params: Vector<Param> = Vector {}
@en "replies"
@fa "پاسخ‌ها"
pub replies: Vector<Reply> = Vector {}
@en "security"
@fa "روش‌های احراز هویت"
pub security: Vector<str> = Vector {}
@en "body_schema"
@fa "طرحواره بدنه"
pub body_schema: str = ""
@en "body_description"
@fa "توضیح بدنه"
pub body_description: str = ""
@en "body_required"
@fa "بدنه الزامی"
pub body_required: bool = true
@en "body_content_type"
@fa "نوع محتوای بدنه"
pub body_content_type: str = "application/json"
end
@en "Definition"
@fa "تعریف"
pub struct Definition:
@en "name"
@fa "نام"
pub name: str = ""
@en "body"
@fa "طرحواره"
pub body: str = ""
end
@en "Doc"
@fa "سند"
pub struct Doc:
@en "title"
@fa "عنوان"
pub title: str = "API"
@en "version"
@fa "نسخه"
pub version: str = "1.0.0"
@en "description"
@fa "توضیح"
pub description: str = ""
@en "servers"
@fa "سرورها"
pub servers: Vector<str> = Vector {}
@en "server_notes"
@fa "توضیح سرورها"
pub server_notes: Vector<str> = Vector {}
@en "ops"
@fa "عملیات‌ها"
pub ops: Vector<Op> = Vector {}
@en "defs"
@fa "تعریف‌ها"
pub defs: Vector<Definition> = Vector {}
@en "schemes"
@fa "روش‌های احراز هویت"
pub schemes: Vector<Scheme> = Vector {}
@en "contact_name"
@fa "نام تماس"
pub contact_name: str = ""
@en "contact_url"
@fa "نشانی تماس"
pub contact_url: str = ""
@en "contact_email"
@fa "ایمیل تماس"
pub contact_email: str = ""
@en "license_name"
@fa "نام پروانه"
pub license_name: str = ""
@en "license_url"
@fa "نشانی پروانه"
pub license_url: str = ""
@en "cur"
@fa "عملیات فعلی"
pub cur: int = 0 - 1
end
func _reref(schema: str): str:
ret str.Replace(schema, _DEFS_PREFIX, _COMP_PREFIX)
end
func _op_index(d &: Doc, method: str, pattern: str): int:
repeat d.ops.len() in i:
o := d.ops.get(i)
if str.Equals(o.method, method) and str.Equals(o.pattern, pattern):
ret i
end
end
ret 0 - 1
end
func _def_has(d &: Doc, name: str): bool:
repeat d.defs.len() in i:
if str.Equals(d.defs.get(i).name, name):
ret true
end
end
ret false
end
func _absorb(d &: Doc, envelope: str): str:
defs := json.Get(envelope, "defs")
if defs.len() > 2:
names := json.Keys(defs)
defer names.free()
repeat names.len() in i:
name := names.get(i)
if not _def_has(d, name):
d.defs.push(Definition { name = name, body = _reref(json.Get(defs, name)) })
end
end
end
ret _reref(json.Get(envelope, "schema"))
end
func _cur(d &: Doc): int:
if d.cur < 0 or d.cur >= d.ops.len():
ret 0 - 1
end
ret d.cur
end
func _put_param(d &: Doc, name: str, loc: str, description: str, required: bool, schema: str):
_set_param(
d, Param {
name = name, loc = loc, required = required, description = description, schema = schema
}
)
end
func _enum_schema(values: Vector<str>): str:
if values.len() == 0:
ret "{\"type\":\"string\"}"
end
mut out := "{\"type\":\"string\",\"enum\":["
repeat values.len() in i:
if i > 0:
out = out.concat(",")
end
out = out.concat(json.Str(values.get(i)))
end
ret out.concat("]}")
end
func _put_body(d &: Doc, description: str, schema: str, content_type: str, required: bool):
i := _cur(d)
if i < 0:
ret
end
mut o := d.ops.get(i)
o.body_schema = schema
o.body_description = description
o.body_content_type = content_type
o.body_required = required
d.ops.set(i, o)
end
func _set_param(d &: Doc, p: Param):
i := _cur(d)
if i < 0:
ret
end
mut o := d.ops.get(i)
repeat o.params.len() in j:
if str.Equals(o.params.get(j).name, p.name) and str.Equals(o.params.get(j).loc, p.loc):
o.params.set(j, p)
d.ops.set(i, o)
ret
end
end
o.params.push(p)
d.ops.set(i, o)
end
func _add_reply(d &: Doc, code: int, description: str, schema: str, content_type: str):
i := _cur(d)
if i < 0:
ret
end
mut o := d.ops.get(i)
r := Reply {
code = code, description = description, schema = schema, content_type = content_type
}
repeat o.replies.len() in j:
if o.replies.get(j).code == code:
o.replies.set(j, r)
d.ops.set(i, o)
ret
end
end
o.replies.push(r)
d.ops.set(i, o)
end
@en "New"
@fa "جدید"
pub func New(title: str, version: str): Doc:
ret Doc { title = title, version = version }
end
@en "Describe"
@fa "توضیح"
pub func Describe(d &: Doc, text: str):
d.description = text
end
@en "Server"
@fa "سرور"
pub func Server(d &: Doc, url: str, note: str):
d.servers.push(url)
d.server_notes.push(note)
end
@en "Contact"
@fa "تماس"
pub func Contact(d &: Doc, name: str, url: str, email: str):
d.contact_name = name
d.contact_url = url
d.contact_email = email
end
@en "License"
@fa "پروانه"
pub func License(d &: Doc, name: str, url: str):
d.license_name = name
d.license_url = url
end
@en "BearerAuth"
@fa "احراز هویت حامل"
pub func BearerAuth(d &: Doc, name: str, format: str):
d.schemes.push(Scheme { name = name, kind = "http", scheme = "bearer", format = format })
end
@en "ApiKeyAuth"
@fa "احراز هویت کلید"
pub func ApiKeyAuth(d &: Doc, name: str, loc: str, param: str):
d.schemes.push(Scheme { name = name, kind = "apiKey", loc = loc, param = param })
end
@en "Route"
@fa "مسیر"
pub func Route(d &: Doc, method: str, pattern: str): int:
verb := str.Upper(method)
hit := _op_index(d, verb, pattern)
if hit >= 0:
d.cur = hit
ret hit
end
mut o := Op { method = verb, pattern = pattern }
found := _path_params(pattern)
defer found.free()
repeat found.len() in i:
o.params.push(found.get(i))
end
d.ops.push(o)
d.cur = d.ops.len() - 1
ret d.cur
end
@en "At"
@fa "انتخاب مسیر"
pub func At(d &: Doc, method: str, pattern: str): bool:
hit := _op_index(d, str.Upper(method), pattern)
d.cur = hit
ret hit >= 0
end
@en "Summary"
@fa "خلاصه"
pub func Summary(d &: Doc, text: str):
i := _cur(d)
if i < 0:
ret
end
mut o := d.ops.get(i)
o.summary = text
d.ops.set(i, o)
end
@en "Details"
@fa "جزئیات"
pub func Details(d &: Doc, text: str):
i := _cur(d)
if i < 0:
ret
end
mut o := d.ops.get(i)
o.description = text
d.ops.set(i, o)
end
@en "Tag"
@fa "برچسب"
pub func Tag(d &: Doc, name: str):
i := _cur(d)
if i < 0:
ret
end
mut o := d.ops.get(i)
o.tags.push(name)
d.ops.set(i, o)
end
@en "OperationId"
@fa "شناسه عملیات"
pub func OperationId(d &: Doc, id: str):
i := _cur(d)
if i < 0:
ret
end
mut o := d.ops.get(i)
o.op_id = id
d.ops.set(i, o)
end
@en "Deprecated"
@fa "منسوخ"
pub func Deprecated(d &: Doc):
i := _cur(d)
if i < 0:
ret
end
mut o := d.ops.get(i)
o.is_deprecated = true
d.ops.set(i, o)
end
@en "Secure"
@fa "امن"
pub func Secure(d &: Doc, scheme: str):
i := _cur(d)
if i < 0:
ret
end
mut o := d.ops.get(i)
o.security.push(scheme)
d.ops.set(i, o)
end
@en "Query"
@fa "پرسمان"
pub func Query(d &: Doc, name: str, description: str, required: bool):
_put_param(d, name, "query", description, required, "{\"type\":\"string\"}")
end
@en "QueryTyped"
@fa "پرسمان نوع دار"
pub func QueryTyped<T>(d &: Doc, name: str, description: str, required: bool, sample: T):
_put_param(d, name, "query", description, required, _absorb(d, json.SchemaEnvelope(sample)))
end
@en "QueryEnum"
@fa "پرسمان گزینه ای"
pub func QueryEnum(
d &: Doc, name: str, description: str, required: bool, values: Vector<str>
):
_put_param(d, name, "query", description, required, _enum_schema(values))
end
@en "Header"
@fa "سرصفحه"
pub func Header(d &: Doc, name: str, description: str, required: bool):
_put_param(d, name, "header", description, required, "{\"type\":\"string\"}")
end
@en "Cookie"
@fa "کوکی"
pub func Cookie(d &: Doc, name: str, description: str, required: bool):
_put_param(d, name, "cookie", description, required, "{\"type\":\"string\"}")
end
@en "PathParam"
@fa "پارامتر مسیر"
pub func PathParam(d &: Doc, name: str, description: str):
_put_param(d, name, "path", description, true, "{\"type\":\"string\"}")
end
@en "Accepts"
@fa "می پذیرد"
pub func Accepts<T>(d &: Doc, description: str, sample: T):
_put_body(d, description, _absorb(d, json.SchemaEnvelope(sample)), JSON_TYPE, true)
end
@en "AcceptsOptional"
@fa "می پذیرد اختیاری"
pub func AcceptsOptional<T>(d &: Doc, description: str, sample: T):
_put_body(d, description, _absorb(d, json.SchemaEnvelope(sample)), JSON_TYPE, false)
end
@en "AcceptsRaw"
@fa "می پذیرد خام"
pub func AcceptsRaw(d &: Doc, description: str, content_type: str, schema: str, required: bool):
_put_body(d, description, schema, content_type, required)
end
@en "AcceptsForm"
@fa "می پذیرد فرم"
pub func AcceptsForm<T>(d &: Doc, description: str, sample: T):
_put_body(d, description, _absorb(d, json.SchemaEnvelope(sample)), FORM_TYPE, true)
end
@en "Returns"
@fa "برمی گرداند"
pub func Returns<T>(d &: Doc, code: int, description: str, sample: T):
_add_reply(d, code, description, _absorb(d, json.SchemaEnvelope(sample)), JSON_TYPE)
end
@en "ReturnsRaw"
@fa "برمی گرداند خام"
pub func ReturnsRaw(d &: Doc, code: int, description: str, content_type: str, schema: str):
_add_reply(d, code, description, schema, content_type)
end
@en "ReturnsText"
@fa "برمی گرداند متن"
pub func ReturnsText(d &: Doc, code: int, description: str):
_add_reply(d, code, description, TEXT_SCHEMA, TEXT_TYPE)
end
@en "ReturnsHtml"
@fa "برمی گرداند اچ تی ام ال"
pub func ReturnsHtml(d &: Doc, code: int, description: str):
_add_reply(d, code, description, TEXT_SCHEMA, HTML_TYPE)
end
@en "ReturnsFile"
@fa "برمی گرداند پرونده"
pub func ReturnsFile(d &: Doc, code: int, description: str, content_type: str):
_add_reply(d, code, description, BINARY_SCHEMA, content_type)
end
@en "ReturnsHeader"
@fa "برمی گرداند سرصفحه"
pub func ReturnsHeader(d &: Doc, code: int, name: str, description: str):
i := _cur(d)
if i < 0:
ret
end
mut o := d.ops.get(i)
mut at_slot := 0 - 1
repeat o.replies.len() in j:
if o.replies.get(j).code == code:
at_slot = j
end
end
if at_slot < 0:
o.replies.push(Reply { code = code, description = "", schema = "", content_type = "" })
at_slot = o.replies.len() - 1
end
mut rp := o.replies.get(at_slot)
repeat rp.header_names.len() in k:
if str.Equals(rp.header_names.get(k), name):
rp.header_notes.set(k, description)
o.replies.set(at_slot, rp)
d.ops.set(i, o)
ret
end
end
rp.header_names.push(name)
rp.header_notes.push(description)
o.replies.set(at_slot, rp)
d.ops.set(i, o)
end
@en "ReturnsNothing"
@fa "بدون بدنه برمی گرداند"
pub func ReturnsNothing(d &: Doc, code: int, description: str):
_add_reply(d, code, description, "", "")
end
