@en "Font"
@fa "قلم"
pub struct Font:
@en "data"
@fa "داده"
pub data: void* = null
@en "size"
@fa "اندازه"
pub size: int = 0
@en "units_per_em"
@fa "واحد ام"
pub units_per_em: int = 0
@en "num_glyphs"
@fa "شمار گلیف‌ها"
pub num_glyphs: int = 0
@en "ascent"
@fa "صعود"
pub ascent: int = 0
@en "descent"
