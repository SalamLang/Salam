ret -1
end
res := _pq_exec(this.handle, "COMMIT")
if res == null:
ret -1
end
ok := _pq_result_status(res) == PGRES_COMMAND_OK and _pq_cmd_status(res) != "ROLLBACK"
_pq_clear(res)
ret ok ? 0 : -1
end
@en "Rollback"
@fa "بازگردانی"
pub func Rollback(): int:
if this.handle == null:
ret -1
end
d := Database { handle = this.handle }
ret d.Exec("ROLLBACK")
end
end
func _pg_int(s: str): i64:
try:
ret conv.ParseInt(s)
catch:
ret conv.ParseFloatOr(s, 0.0) as i64
end
end
