func _load(names &: HashMap<str, str>, legacy &: HashMap<str, bool>):
chunks := _chunks()
defer chunks.free()
repeat chunks.len() in c:
parts := str.Split(chunks.get(c), ",")
repeat parts.len() in i:
mut item := parts.get(i)
sep := str.IndexOf(item, "=")
mut name := item.substr(0, sep)
if str.StartsWith(name, "*"):
name = name.substr(1, name.len() - 1)
legacy.put(name, true)
end
names.put(name, item.substr(sep + 1, item.len() - sep - 1))
end
parts.free()
end
end
func _cps(spec: str): str:
mut sb := str.NewBuilder()
defer str.BufFree(sb)
parts := str.Split(spec, "+")
defer parts.free()
repeat parts.len() in i:
str.BufAppendCp(sb, str.ToInt(parts.get(i)) as int)
end
ret str.BufStr(sb)
end
func _cp1252(n: int): int:
table := [8364, 129, 8218, 402, 8222, 8230, 8224, 8225, 710, 8240, 352, 8249, 338, 141, 381, 143, 144, 8216, 8217, 8220, 8221, 8226, 8211, 8212, 732, 8482, 353, 8250, 339, 157, 382, 376]
ret table[n - 128]
end
func _invalid(n: int): bool:
if n >= 1 and n <= 8: ret true end
if n == 11: ret true end
if n >= 14 and n <= 31: ret true end
if n >= 127 and n <= 159: ret true end
if n >= 64976 and n <= 65007: ret true end
if (n & 65534) == 65534: ret true end
ret false
end
func _digit(c: int, hex: bool): int:
if c >= 48 and c <= 57: ret c - 48 end
if hex and c >= 97 and c <= 102: ret c - 87 end
if hex and c >= 65 and c <= 70: ret c - 55 end
ret 0 - 1
end
func _numeric(bp: u8*, n: int, at: int, sb &: str.StringBuilder): int:
mut i := at + 2
mut hex := false
if i < n and (bp[i] == 120 or bp[i] == 88):
hex = true
i++
end
start := i
mut value := 0
until i < n and _digit(bp[i] as int, hex) >= 0:
if value < 1114112:
value = value * (hex ? 16 : 10) + _digit(bp[i] as int, hex)
end
i++
end
if i == start:
ret 0 - 1
end
if i < n and bp[i] == 59:
i++
end
mut cp := value
if value == 0:
cp = 65533
else value >= 128 and value <= 159:
cp = _cp1252(value)
else (value >= 55296 and value <= 57343) or value > 1114111:
cp = 65533
else _invalid(value):
ret i
end
str.BufAppendCp(sb, cp)
ret i
end
func _stop(c: int): bool:
ret c == 9 or c == 10 or c == 12 or c == 32 or c == 60 or c == 38 or c == 35 or c == 59
end
@en "Unescape"
@fa "بازگردانی موجودیت ها"
pub func Unescape(s: str): str:
if str.IndexOf(s, "&") < 0:
ret str.Clone(s)
end
n := s.len()
bp := s as u8*
mut names := HashMap {} as HashMap<str, str>
defer names.free()
mut legacy := HashMap {} as HashMap<str, bool>
defer legacy.free()
_load(names, legacy)
mut sb := str.NewBuilder()
defer str.BufFree(sb)
mut i := 0
mut run := 0
until i < n:
if bp[i] != 38:
i++
continue
end
str.BufAppend(sb, s.substr(run, i - run))
if i + 1 < n and bp[i + 1] == 35:
stop := _numeric(bp, n, i, sb)
if stop >= 0:
i = stop
run = stop
continue
end
str.BufAppend(sb, "&")
i++
run = i
continue
end
mut j := i + 1
until j < n and j - i - 1 < 32 and not _stop(bp[j] as int):
j++
end
if j == i + 1:
str.BufAppend(sb, "&")
i++
run = i
continue
end
word := s.substr(i + 1, j - i - 1)
semi := j < n and bp[j] == 59
if semi and names.has(word):
str.BufAppend(sb, _cps(names.get(word)))
i = j + 1
run = i
continue
end
if not semi and legacy.has(word):
str.BufAppend(sb, _cps(names.get(word)))
i = j
run = i
continue
end
mut x := word.len() - (semi ? 0 : 1)
mut done := false
until x >= 2 and not done:
head := word.substr(0, x)
if legacy.has(head):
str.BufAppend(sb, _cps(names.get(head)))
i = i + 1 + x
run = i
done = true
end
x--
end
if not done:
str.BufAppend(sb, "&")
i++
run = i
end
end
str.BufAppend(sb, s.substr(run, n - run))
ret str.BufStr(sb)
end
@en "Escape"
@fa "اسکیپ"
pub func Escape(s: str): str:
mut t := str.Replace(s, "&", "&amp;")
t = str.Replace(t, "<", "&lt;")
t = str.Replace(t, ">", "&gt;")
t = str.Replace(t, `"`, "&quot;")
ret str.Replace(t, "'", "&#x27;")
end
@en "EscapeText"
@fa "اسکیپ متن"
pub func EscapeText(s: str): str:
mut t := str.Replace(s, "&", "&amp;")
t = str.Replace(t, "<", "&lt;")
ret str.Replace(t, ">", "&gt;")
end
@en "json"
@fa "جیسون"
package json
import conv
import str
inline pure func _bp(s: str): i8*: ret (s as void*) as i8* end
inline pure func _ub(bp: i8*, i: int): int:
mut v := bp[i] as int
if v < 0: v += 256 end
ret v
end
pure func _match_at(hp: i8*, hi: int, np: i8*, n: int): bool:
repeat n in k:
if hp[hi + k] != np[k]: ret false end
end
ret true
end
pure func _jws_n(s: str, l: int, i: int): int:
bp := _bp(s)
mut p := i
until p < l:
code := _ub(bp, p)
if code != 32 and code != 9 and code != 10 and code != 13:
ret p
end
p++
end
ret p
end
pure func _jws(s: str, i: int): int: ret _jws_n(s, str.ByteLen(s), i) end
pure func _jstr_n(s: str, l: int, i: int): int:
bp := _bp(s)
if i >= l or _ub(bp, i) != 34: ret -1 end
mut p := i + 1
until p < l:
code := _ub(bp, p)
if code == 34: ret p + 1
else code == 92:
p++
if p >= l: ret -1 end
end
p++
end
ret -1
end
pure func _jnum_n(s: str, l: int, i: int): int:
bp := _bp(s)
mut p := i
if p < l and _ub(bp, p) == 45: p++ end
start := p
until p < l:
code := _ub(bp, p)
if code < 48 or code > 57: break end
p++
end
if p == start: ret -1 end
if p < l and _ub(bp, p) == 46:
p++
until p < l:
code := _ub(bp, p)
if code < 48 or code > 57: break end
p++
end
end
if p < l and (_ub(bp, p) == 101 or _ub(bp, p) == 69):
p++
if p < l and (_ub(bp, p) == 43 or _ub(bp, p) == 45): p++ end
until p < l:
code := _ub(bp, p)
if code < 48 or code > 57: break end
p++
end
end
ret p
end
pure func _jval_n(s: str, l: int, i: int): int:
p0 := _jws_n(s, l, i)
if p0 >= l: ret -1 end
bp := _bp(s)
c := _ub(bp, p0)
if c == 34: ret _jstr_n(s, l, p0)
else c == 123:
mut q := _jws_n(s, l, p0 + 1)
if q < l and _ub(bp, q) == 125: ret q + 1 end
until q < l:
q = _jws_n(s, l, q)
qk := _jstr_n(s, l, q)
if qk < 0: ret -1 end
q = _jws_n(s, l, qk)
if q >= l or _ub(bp, q) != 58: ret -1 end
q = _jval_n(s, l, q + 1)
if q < 0: ret -1 end
q = _jws_n(s, l, q)
if q < l and _ub(bp, q) == 44:
q++
continue
end
if q < l and _ub(bp, q) == 125: ret q + 1 end
ret -1
end
else c == 91:
mut q := _jws_n(s, l, p0 + 1)
if q < l and _ub(bp, q) == 93: ret q + 1 end
until q < l:
q = _jval_n(s, l, q)
if q < 0: ret -1 end
q = _jws_n(s, l, q)
if q < l and _ub(bp, q) == 44:
q++
continue
end
if q < l and _ub(bp, q) == 93: ret q + 1 end
ret -1
end
else p0 + 4 <= l and _match_at(bp, p0, _bp("true"), 4): ret p0 + 4
else p0 + 5 <= l and _match_at(bp, p0, _bp("false"), 5): ret p0 + 5
else p0 + 4 <= l and _match_at(bp, p0, _bp("null"), 4): ret p0 + 4
else:
ret _jnum_n(s, l, p0)
end
ret -1
end
func _pp_put(sb &: str.StringBuilder, bp: i8*, lo: int, hi: int):
mut k := lo
until k < hi:
str.BufAppendChar(sb, bp[k] as int)
k++
end
end
func _pp_indent(sb &: str.StringBuilder, unit: str, depth: int):
repeat depth:
str.BufAppend(sb, unit)
end
end
func _pp_val_n(s: str, l: int, i: int, sb &: str.StringBuilder, unit: str, depth: int): int:
p0 := _jws_n(s, l, i)
if p0 >= l: ret -1 end
bp := _bp(s)
c := _ub(bp, p0)
if c == 123: ret _pp_obj(s, l, p0, sb, unit, depth)
else c == 91: ret _pp_arr(s, l, p0, sb, unit, depth)
else:
e := _jval_n(s, l, p0)
if e < 0: ret -1 end
_pp_put(sb, bp, p0, e)
ret e
end
end
func _pp_obj(s: str, l: int, p0: int, sb &: str.StringBuilder, unit: str, depth: int): int:
bp := _bp(s)
mut q := _jws_n(s, l, p0 + 1)
if q < l and _ub(bp, q) == 125:
str.BufAppend(sb, "{}")
ret q + 1
end
str.BufAppendChar(sb, 123)
str.BufAppendChar(sb, 10)
until q < l:
_pp_indent(sb, unit, depth + 1)
q = _jws_n(s, l, q)
qk := _jstr_n(s, l, q)
if qk < 0: ret -1 end
_pp_put(sb, bp, q, qk)
q = _jws_n(s, l, qk)
if q >= l or _ub(bp, q) != 58: ret -1 end
str.BufAppend(sb, ": ")
q = _pp_val_n(s, l, q + 1, sb, unit, depth + 1)
if q < 0: ret -1 end
q = _jws_n(s, l, q)
if q < l and _ub(bp, q) == 44:
str.BufAppendChar(sb, 44)
str.BufAppendChar(sb, 10)
q++
continue
end
if q < l and _ub(bp, q) == 125:
str.BufAppendChar(sb, 10)
_pp_indent(sb, unit, depth)
str.BufAppendChar(sb, 125)
ret q + 1
end
ret -1
end
ret -1
end
func _pp_arr(s: str, l: int, p0: int, sb &: str.StringBuilder, unit: str, depth: int): int:
bp := _bp(s)
mut q := _jws_n(s, l, p0 + 1)
if q < l and _ub(bp, q) == 93:
str.BufAppend(sb, "[]")
ret q + 1
end
str.BufAppendChar(sb, 91)
str.BufAppendChar(sb, 10)
until q < l:
_pp_indent(sb, unit, depth + 1)
q = _pp_val_n(s, l, q, sb, unit, depth + 1)
if q < 0: ret -1 end
q = _jws_n(s, l, q)
if q < l and _ub(bp, q) == 44:
str.BufAppendChar(sb, 44)
str.BufAppendChar(sb, 10)
q++
continue
end
if q < l and _ub(bp, q) == 93:
str.BufAppendChar(sb, 10)
_pp_indent(sb, unit, depth)
str.BufAppendChar(sb, 93)
ret q + 1
end
ret -1
end
ret -1
end
func _get_raw(text: str, key: str): str:
l := str.ByteLen(text)
start := _jws_n(text, l, 0)
bp := _bp(text)
if start >= l or _ub(bp, start) != 123: ret "" end
kl := str.ByteLen(key)
kp := _bp(key)
mut p := start + 1
until p < l:
p = _jws_n(text, l, p)
if p >= l or _ub(bp, p) != 34: ret "" end
ke := _jstr_n(text, l, p)
if ke < 0: ret "" end
is_key := ke - p - 2 == kl and _match_at(bp, p + 1, kp, kl)
p = _jws_n(text, l, ke)
if p >= l or _ub(bp, p) != 58: ret "" end
vs := _jws_n(text, l, p + 1)
ve := _jval_n(text, l, vs)
if ve < 0: ret "" end
if is_key: ret __jdslice(text, vs, vs + ve - vs) end
p = _jws_n(text, l, ve)
if p < l and _ub(bp, p) == 44:
p++
continue
end
ret ""
end
ret ""
end
@en "Valid"
@fa "معتبر"
pub pure func Valid(text: str): bool:
if text.len() == 0: ret false end
l := str.ByteLen(text)
e := _jval_n(text, l, 0)
if e < 0: ret false end
ret _jws_n(text, l, e) == l
end
@en "Get"
@fa "دریافت"
pub func Get(text: str, key: str): str:
if text.len() == 0 or key.len() == 0: ret "" end
l := str.ByteLen(text)
start := _jws_n(text, l, 0)
bp := _bp(text)
if start >= l or _ub(bp, start) != 123: ret "" end
kl := str.ByteLen(key)
kp := _bp(key)
mut p := start + 1
until p < l:
p = _jws_n(text, l, p)
if p >= l or _ub(bp, p) != 34: ret "" end
ke := _jstr_n(text, l, p)
if ke < 0: ret "" end
this_kl := ke - p - 2
is_key := this_kl == kl and _match_at(bp, p + 1, kp, kl)
p = _jws_n(text, l, ke)
if p >= l or _ub(bp, p) != 58: ret "" end
vs := _jws_n(text, l, p + 1)
ve := _jval_n(text, l, vs)
if ve < 0: ret "" end
if is_key:
if vs < l and _ub(bp, vs) == 34:
mut sep := 0
dec := __jdgstr(text, vs, sep)
if sep >= 0:
ret dec
end
ret __jdslice(text, vs + 1, vs + 1 + ve - vs - 2)
end
ret __jdslice(text, vs, vs + ve - vs)
end
p = _jws_n(text, l, ve)
if p < l and _ub(bp, p) == 44:
p++
continue
end
ret ""
end
ret ""
end
@en "Escape"
@fa "اسکیپ"
pub func Escape(s: str): str:
l := str.ByteLen(s)
bp := _bp(s)
mut sb := str.NewBuilder()
defer str.BufFree(sb)
repeat l in i:
code := _ub(bp, i)
if code == 34:
str.BufAppend(sb, `\"`)
else code == 92:
str.BufAppend(sb, "\\\\")
else code == 10:
str.BufAppend(sb, "\\n")
else code == 9:
