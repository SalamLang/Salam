func _wopen(path: void*, flags: int, mode: int): int
func _fdopen(fd: int, mode: str): void*
func MultiByteToWideChar(codepage: u32, flags: u32, src: str, srclen: i32, dst: void*, dstlen: i32): i32
func WideCharToMultiByte(codepage: u32, flags: u32, src: void*, srclen: i32, dst: void*, dstlen: i32, defchar: void*, used: void*): i32
end
else:
extern:
func opendir(path: str): void*
func readdir(d: void*): void*
func closedir(d: void*): int
end
if SALAM_OS_LINUX or SALAM_OS_ANDROID:
extern:
func dirfd(d: void*): int
end
if not (SALAM_ARCH_X86 or SALAM_ARCH_ARM or SALAM_ARCH_WASM):
extern:
func syscall(nr: i64, a: i64, b: i64, c: i64): i64
end
else:
extern:
func syscall(nr: int, a: int, b: int, c: int): int
end
end
end
end
func _byte_at(base: void*, off: i64): int:
p := ((base as i64) + off) as u8*
ret p[0] as int
end
if SALAM_OS_WINDOWS:
func _str_to_wide(s: str): void*:
n := MultiByteToWideChar(65001 as u32, 0 as u32, s, 0 - 1, null, 0)
if n <= 0:
ret mem.MustAllocate(2 as u64)
end
w := mem.MustAllocate((n * 2) as u64)
MultiByteToWideChar(65001 as u32, 0 as u32, s, 0 - 1, w, n)
ret w
end
func _wide_to_utf8(w: void*): str:
n := WideCharToMultiByte(65001 as u32, 0 as u32, w, 0 - 1, null, 0, null, null)
if n <= 0:
ret str.Clone("")
end
buf := mem.MustAllocateZeroed((n + 1) as u64)
WideCharToMultiByte(65001 as u32, 0 as u32, w, 0 - 1, buf, n, null, null)
ret buf as str
end
func _wopen_flags(mode: str): int:
O_RDONLY := 0
O_WRONLY := 1
O_APPEND := 8
O_CREAT := 256
O_TRUNC := 512
O_BINARY := 32768
if mode.len() == 0:
ret O_RDONLY | O_BINARY
end
c := mode.substr(0, 1)
if c == "w":
ret O_WRONLY | O_CREAT | O_TRUNC | O_BINARY
end
if c == "a":
ret O_WRONLY | O_CREAT | O_APPEND | O_BINARY
end
ret O_RDONLY | O_BINARY
end
end
export:
func salam_env(name: str): str:
v := getenv(name)
if v == null: ret str.Clone("") end
ret str.Clone(v as str)
end
func salam_open(path: str, mode: str): File*:
if SALAM_OS_WINDOWS:
S_IREAD_IWRITE := 384
wpath := _str_to_wide(path)
fd := _wopen(wpath, _wopen_flags(mode), S_IREAD_IWRITE)
mem.Free(wpath)
if fd < 0: ret null end
fp := _fdopen(fd, mode)
if fp == null: ret null end
ret fp as File*
else:
fp := fopen(path, mode)
if fp == null: ret null end
ret fp as File*
end
end
func salam_file_read(f: File*, size: u64): str:
if f == null: ret "" end
fp := f as void*
buf := mem.MustAllocateZeroed(size + (1 as u64))
got := fread(buf, 1 as u64, size, fp)
mem.Set(((buf as i64) + (got as i64)) as void*, 0, 1 as u64)
ret buf as str
end
func salam_file_readline(f: File*): str:
if f == null: ret "" end
fp := f as void*
mut sb := str.NewBuilder()
defer str.BufFree(sb)
mut c := fgetc(fp)
until c != -1 and c != 10:
str.BufAppendChar(sb, c)
c = fgetc(fp)
end
out := str.BufStr(sb)
ret out
end
func salam_file_write(f: File*, data: str): int:
if f == null: ret 0 - 1 end
fp := f as void*
n := data.len() as u64
w := fwrite(data as void*, 1 as u64, n, fp)
ret w as int
end
func salam_file_close(f: File*):
if f == null: ret end
fclose(f as void*)
end
func salam_file_seek(f: File*, off: i64, whence: int): int:
if f == null: ret 0 - 1 end
fp := f as void*
mut w := 0
if whence == 1: w = 1
else whence == 2: w = 2
end
if _fs_seek64(fp, off, w) == 0: ret 0 end
ret 0 - 1
end
end
if SALAM_OS_WINDOWS:
func _fs_seek64(fp: void*, off: i64, w: int): int: ret _fseeki64(fp, off, w) end
else:
func _fs_seek64(fp: void*, off: i64, w: int): int: ret fseeko(fp, off, w) end
end
func _ld_push(arr: void*, n: int, cap_box: void*, name: str): void*:
cap := cap_box as int*
mut a := arr
if n >= cap[0]:
if cap[0] == 0: cap[0] = 8 else:
cap[0] *= 2
end
a = mem.MustReallocate(a, (cap[0] as u64) * (sizeof(str) as u64))
end
slots := a as str*
slots[n] = name.substr(0, name.len())
ret a
end
func _ld_skip(name: str): bool:
if name == ".": ret true
else name == "..": ret true
else:
ret false
end
end
if SALAM_OS_WINDOWS:
export:
func salam_os_listdir(path: str, out_count: void*): void*:
mut oc := out_count as int*
fd := mem.MustAllocate(592 as u64)
wpat := _str_to_wide(path.concat("/*"))
h := FindFirstFileW(wpat, fd)
mem.Free(wpat)
mut arr := null as void*
mut n := 0
cap_box := mem.MustAllocateZeroed(4 as u64)
if (h as i64) != (0 - 1):
mut more := 1
until more != 0:
np := ((fd as i64) + 44) as void*
nm := _wide_to_utf8(np)
if _ld_skip(nm) == false:
arr = _ld_push(arr, n, cap_box, nm)
n++
end
mem.Free(nm as void*)
more = FindNextFileW(h, fd)
end
FindClose(h)
end
mem.Free(fd)
mem.Free(cap_box)
if arr == null: arr = mem.MustAllocate(8 as u64) end
oc[0] = n
ret arr
end
end
else:
if SALAM_OS_LINUX or SALAM_OS_ANDROID:
if SALAM_ARCH_X86:
func _gd_nr(): i64: ret 220 end
else SALAM_ARCH_X64 or SALAM_ARCH_ARM:
func _gd_nr(): i64: ret 217 end
else:
func _gd_nr(): i64: ret 61 end
end
if not (SALAM_ARCH_X86 or SALAM_ARCH_ARM or SALAM_ARCH_WASM):
func _getdents(fd: int, buf: void*, cap: int): i64:
ret syscall(_gd_nr(), fd as i64, buf as i64, cap as i64)
end
else:
func _getdents(fd: int, buf: void*, cap: int): i64:
ret syscall(_gd_nr() as int, fd, (buf as i64) as int, cap)
end
end
export:
func salam_os_listdir(path: str, out_count: void*): void*:
oc := out_count as int*
mut arr := null as void*
mut n := 0
cap_box := mem.MustAllocateZeroed(4 as u64)
dp := opendir(path)
if dp != null:
fd := dirfd(dp)
bcap := 32768
buf := mem.MustAllocate(bcap as u64)
mut got := _getdents(fd, buf, bcap)
until got > (0 as i64):
mut p := 0 as i64
until p < got:
rl := (_byte_at(buf, p + (16 as i64)) + _byte_at(buf, p + (17 as i64)) * 256) as i64
if rl < (1 as i64):
break
end
nm := (((buf as i64) + p + (19 as i64)) as void*) as str
if _ld_skip(nm) == false:
arr = _ld_push(arr, n, cap_box, nm)
n++
end
p += rl
end
got = _getdents(fd, buf, bcap)
end
mem.Free(buf)
closedir(dp)
end
mem.Free(cap_box)
if arr == null: arr = mem.MustAllocate(sizeof(str) as u64) end
oc[0] = n
ret arr
end
end
else:
if SALAM_OS_MAC:
func _dname_off(): i64: ret 21 end
else SALAM_OS_BSD:
func _dname_off(): i64: ret 24 end
else:
func _dname_off(): i64: ret 19 end
end
export:
func salam_os_listdir(path: str, out_count: void*): void*:
oc := out_count as int*
mut arr := null as void*
mut n := 0
cap_box := mem.MustAllocateZeroed(4 as u64)
off := _dname_off()
d := opendir(path)
if d != null:
mut e := readdir(d)
until e != null:
np := ((e as i64) + off) as void*
nm := np as str
if _ld_skip(nm) == false:
arr = _ld_push(arr, n, cap_box, nm)
n++
end
e = readdir(d)
end
closedir(d)
end
mem.Free(cap_box)
if arr == null: arr = mem.MustAllocate(sizeof(str) as u64) end
oc[0] = n
ret arr
end
end
end
end
end
@en "cpu"
@fa "پردازنده"
package cpu
import mem
import os
import str
@en "FEATURE_HW_CRYPTO"
@fa "ویژگی رمز سخت افزاری"
pub const FEATURE_HW_CRYPTO := 1
@en "FEATURE_X86"
@fa "ویژگی ایکس۸۶"
pub const FEATURE_X86 := 2
@en "FEATURE_ARM64"
@fa "ویژگی آرم۶۴"
pub const FEATURE_ARM64 := 4
mut g_state := 0
func _gmul(a0: int, b0: int): int:
mut a := a0
mut b := b0
mut r := 0
repeat 8:
if (b & 1) != 0:
r ^= a
end
hi := a & 128
a = (a << 1) & 255
if hi != 0:
a ^= 27
end
b >>= 1
end
ret r
end
func _sub(x: int): int:
mut inv := 1
mut sq := x
mut e := 254
until e > 0:
if (e & 1) != 0:
inv = _gmul(inv, sq)
end
sq = _gmul(sq, sq)
e >>= 1
end
if x == 0:
inv = 0
end
mut r := inv
repeat 4 in i:
k := i + 1
r ^= ((inv << k) | (inv >> (8 - k))) & 255
end
ret r ^ 99
end
func _split(x: u128, lo &: u64, hi &: u64):
lo = x as u64
hi = (x >> (64 as u128)) as u64
end
func _join(lo: u64, hi: u64): u128:
ret ((hi as u128) << (64 as u128)) | (lo as u128)
end
func _get(x: u128, i: int): int:
mut lo := 0 as u64
mut hi := 0 as u64
_split(x, lo, hi)
if i < 8:
ret ((lo >> ((i * 8) as u64)) & (255 as u64)) as int
end
ret ((hi >> (((i - 8) * 8) as u64)) & (255 as u64)) as int
end
func _soft_round(x: u128, key: u128, last: bool): u128:
b := mem.AllocateZeroed(32 as u64) as u8*
repeat 16 in i:
b[i] = _sub(_get(x, i)) as u8
end
repeat 16 in i:
r := i % 4
c := i / 4
b[16 + r + 4 * c] = b[r + 4 * ((c + r) % 4)]
end
mut lo := 0 as u64
mut hi := 0 as u64
repeat 16 in i:
mut v := b[16 + i] as int
if not last:
col := (i / 4) * 4
r := i % 4
v = _gmul(b[16 + col + r] as int, 2) ^ _gmul(b[16 + col + (r + 1) % 4] as int, 3) ^ (b[16 + col + (r + 2) % 4] as int) ^ (b[16 + col + (r + 3) % 4] as int)
end
if i < 8:
lo |= (v as u64) << ((i * 8) as u64)
else:
hi |= (v as u64) << (((i - 8) * 8) as u64)
end
end
mem.Free(b as void*)
ret _join(lo, hi) ^ key
end
func _soft_clmul(a: u64, b: u64): u128:
mut r := 0 as u128
repeat 64 in i:
if ((b >> (i as u64)) & (1 as u64)) != (0 as u64):
r ^= (a as u128) << (i as u128)
end
end
ret r
end
@en "Features"
@fa "ویژگی های پردازنده"
pub func Features(): int:
ret 0
end
@en "HwAesEnc"
@fa "دور رمز"
pub func HwAesEnc(state: u128, key: u128): u128:
ret _soft_round(state, key, false)
end
@en "HwAesEncLast"
@fa "دور آخر رمز"
pub func HwAesEncLast(state: u128, key: u128): u128:
ret _soft_round(state, key, true)
end
@en "HwClmul"
@fa "ضرب بدون نقلی"
pub func HwClmul(a: u128, b: u128, imm: int): u128:
mut a_low := 0 as u64
mut a_high := 0 as u64
mut b_low := 0 as u64
mut b_high := 0 as u64
_split(a, a_low, a_high)
_split(b, b_low, b_high)
x := (imm & 1) != 0 ? a_high : a_low
y := (imm & 16) != 0 ? b_high : b_low
ret _soft_clmul(x, y)
end
@en "HwSwap64"
@fa "جابجایی نیمه ها"
pub func HwSwap64(x: u128): u128:
mut lo := 0 as u64
mut hi := 0 as u64
_split(x, lo, hi)
ret _join(hi, lo)
end
@en "HwBswap"
@fa "وارونه سازی بایت ها"
pub func HwBswap(x: u128): u128:
mut lo := 0 as u64
mut hi := 0 as u64
_split(x, lo, hi)
mut rlo := 0 as u64
mut rhi := 0 as u64
repeat 8 in i:
rhi = (rhi << (8 as u64)) | ((lo >> ((i * 8) as u64)) & (255 as u64))
rlo = (rlo << (8 as u64)) | ((hi >> ((i * 8) as u64)) & (255 as u64))
end
ret _join(rlo, rhi)
end
@en "HwLoad"
@fa "بارگیری شانزده بایت"
pub func HwLoad(p: void*): u128:
b := p as u8*
mut lo := 0 as u64
mut hi := 0 as u64
repeat 8 in i:
lo |= (b[i] as u64) << ((i * 8) as u64)
hi |= (b[8 + i] as u64) << ((i * 8) as u64)
end
ret _join(lo, hi)
end
@en "HwStore"
@fa "ذخیره شانزده بایت"
pub func HwStore(p: void*, x: u128):
b := p as u8*
repeat 16 in i:
b[i] = _get(x, i) as u8
end
end
@en "SetHardware"
@fa "تنظیم سخت افزار"
pub func SetHardware(enable: bool):
g_state = enable ? 1 : 2
end
@en "HasHardwareCrypto"
@fa "دارای رمز سخت افزاری"
pub func HasHardwareCrypto(): bool:
if g_state == 0:
mut st := 2
if (Features() & FEATURE_HW_CRYPTO) != 0 and str.Len(os.Env("SALAM_NO_HWCRYPTO")) == 0:
st = 1
end
g_state = st
end
ret g_state == 1 and (Features() & FEATURE_HW_CRYPTO) != 0
end
@en "HasAesNi"
@fa "دارای ای ای اس ان آی"
pub func HasAesNi(): bool:
f := Features()
ret (f & FEATURE_HW_CRYPTO) != 0 and (f & FEATURE_X86) != 0
end
@en "HasPclmul"
@fa "دارای ضرب بدون نقلی"
pub func HasPclmul(): bool:
ret HasAesNi()
end
@en "HasArmCrypto"
@fa "دارای رمز آرم"
pub func HasArmCrypto(): bool:
f := Features()
ret (f & FEATURE_HW_CRYPTO) != 0 and (f & FEATURE_ARM64) != 0
end
@en "cron"
@fa "کرون"
package cron
import str
import conv
import mem
import time
import calendar
import rand
import sync
if SALAM_OS_WINDOWS:
extern:
func _beginthreadex(sec: void *, stack: u32, start: void *, arg: void *, flags: u32, thrdaddr: void *): u64
func CloseHandle(h: void *): int
end
else:
extern:
func pthread_create(thread: void *, attr: void *, start: void *, arg: void *): int
func pthread_detach(thread: u64): int
end
end
const CRON_KIND_PLAIN := 0
const CRON_KIND_MONTH := 1
const CRON_KIND_DOW := 2
const CRON_MAX_SCAN := 2000000
const JOB_CRON := 0
const JOB_EVERY := 1
const JOB_BETWEEN := 2
const JOB_ONCE := 3
const S_BUSY := 0
const S_REMOVED := 1
const S_INTERVAL := 2
const S_MAX := 3
const S_NEXT := 4
const S_LIMIT := 5
const S_RUNS := 6
const S_STARTED := 7
const S_FINISHED := 8
const S_SLOT := 9
const S_START_AT := 10
const S_STOP_AT := 11
const S_AFTER_DONE := 12
const S_QUEUE := 13
const S_PENDING := 14
const S_FAILED := 15
const S_FAILS := 16
const S_COUNT := 17
mut _jobs := Vector {} as Vector<_Job>
mut _zone_name := "UTC"
mut _zone_fallback := 0
mut _stop := null as i64*
mut _last_minute := 0 as i64
mut _mu := sync.NewMutex()
mut _gcell := mem.AllocateZeroed(16 as u64) as i64*
mut _on_error := 0 as i64
mut _before := 0 as i64
mut _after := 0 as i64
struct _Job:
pub name: str = ""
pub tags: str = ""
pub kind: int = 0
pub expr: Expr = Expr {}
pub fn: i64 = 0
pub cell: i64 = 0
end
@en "Expr"
@fa "عبارت زمان‌بندی"
pub struct Expr:
@en "minutes"
@fa "دقیقه‌ها"
pub minutes: i64 = 0
@en "hours"
@fa "ساعت‌ها"
pub hours: i64 = 0
@en "days"
@fa "روزها"
pub days: i64 = 0
@en "months"
@fa "ماه‌ها"
pub months: i64 = 0
@en "weekdays"
@fa "روزهای هفته"
pub weekdays: i64 = 0
@en "dom_star"
@fa "همه روزها"
pub dom_star: bool = true
@en "dow_star"
@fa "همه روزهای هفته"
pub dow_star: bool = true
@en "seconds"
@fa "ثانیه‌ها"
pub seconds: i64 = 1
@en "with_seconds"
@fa "با ثانیه"
pub with_seconds: bool = false
@en "ok"
@fa "معتبر"
pub ok: bool = false
end
func _job(i: int): _Job:
sync.Lock(_mu)
j := _jobs.get(i)
sync.Unlock(_mu)
ret j
end
func _n(): int:
sync.Lock(_mu)
n := _jobs.len()
sync.Unlock(_mu)
ret n
end
func _slot(base: i64, slot: int): i64*: ret (base + ((slot * 8) as i64)) as i64* end
func _cell(id: int): i64: ret _job(id).cell end
func _get(id: int, slot: int): i64: ret atomic_load(_slot(_cell(id), slot)) end
func _put(id: int, slot: int, v: i64): atomic_store(_slot(_cell(id), slot), v) end
if SALAM_OS_WINDOWS:
export:
func salam_cron_spawn(fn: i64, arg: i64):
h := _beginthreadex(null, 0 as u32, fn as void *, arg as void *, 0 as u32, null)
if h != (0 as u64): CloseHandle(h as void *) end
end
end
else:
export:
func salam_cron_spawn(fn: i64, arg: i64):
t := mem.Allocate(8 as u64)
if pthread_create(t, null, fn as void *, arg as void *) == 0:
tp := t as i64 *
pthread_detach(tp[0] as u64)
end
mem.Free(t)
end
end
end
func _bit(v: int): i64: ret (1 as i64) << (v as i64) end
func _has(mask: i64, v: int): bool:
ret ((mask >> (v as i64)) & (1 as i64)) == (1 as i64)
end
func _name_value(s: str, kind: int): int:
if kind == CRON_KIND_MONTH:
names := "janfebmaraprmayjunjulaugsepoctnovdec"
repeat 12 in i:
if str.EqualFold(s, names.substr(i * 3, 3)): ret i + 1 end
end
end
if kind == CRON_KIND_DOW:
names := "sunmontuewedthufrisat"
repeat 7 in i:
if str.EqualFold(s, names.substr(i * 3, 3)): ret i end
end
end
ret 0 - 1
end
func _num(s: str, kind: int): int:
n := s.len()
if n == 0: ret 0 - 1 end
mut digits := true
repeat n in i:
c := s[i]
if c < '0' or c > '9': digits = false end
end
if digits:
if n > 4: ret 0 - 1 end
ret conv.AtoiOr(s, 0 - 1)
end
ret _name_value(s, kind)
end
func _parse_item(item: str, lo: int, hi: int, kind: int, mask &: i64, star &: bool): bool:
mut base := item
mut step := 1
slash := item.find("/")
if slash >= 0:
base = item.substr(0, slash)
step = _num(item.substr(slash + 1, item.len() - slash - 1), CRON_KIND_PLAIN)
if step <= 0: ret false end
end
mut a := lo
mut b := hi
if base == "*":
star = true
else:
dash := base.find("-")
if dash > 0:
a = _num(base.substr(0, dash), kind)
b = _num(base.substr(dash + 1, base.len() - dash - 1), kind)
else:
a = _num(base, kind)
if slash >= 0:
b = hi
else:
b = a
end
end
end
if a < lo or b > hi or a > b: ret false end
mut v := a
until v <= b:
mask = mask | _bit(v)
v += step
end
ret true
end
func _parse_field(text: str, lo: int, hi: int, kind: int, mask &: i64, star &: bool): bool:
items := str.Split(text, ",")
defer items.free()
if items.len() == 0: ret false end
star = false
mut i := 0
until i < items.len():
if not _parse_item(items.get(i), lo, hi, kind, mask, star): ret false end
i++
end
ret true
end
func _expand_macro(spec: str): str:
if spec == "@yearly" or spec == "@annually": ret "0 0 1 1 *" end
if spec == "@monthly": ret "0 0 1 * *" end
if spec == "@weekly": ret "0 0 * * 0" end
if spec == "@daily" or spec == "@midnight": ret "0 0 * * *" end
if spec == "@hourly": ret "0 * * * *" end
ret spec
end
func _offset(z: calendar.Zone, fallback_minutes: int, epoch: i64): i64:
if z.ok: ret calendar.ZoneOffsetSeconds(z, epoch) end
ret fallback_minutes * 60
end
func _cron_entry(id: i64):
i := id as int
j := _job(i)
if _before != (0 as i64): callhandler(_before, id) end
_put(i, S_STARTED, time.Now())
callhandler(j.fn, id)
done := time.Now()
_put(i, S_FINISHED, done)
if _after != (0 as i64): callhandler(_after, id) end
if _get(i, S_AFTER_DONE) != (0 as i64):
mut next := done + _get(i, S_INTERVAL)
if j.kind == JOB_BETWEEN: next = done + _pick(i) end
_put(i, S_NEXT, next)
end
if _get(i, S_FAILED) != (0 as i64):
_put(i, S_FAILS, _get(i, S_FAILS) + (1 as i64))
_put(i, S_FAILED, 0 as i64)
if _on_error != (0 as i64): callhandler(_on_error, id) end
end
atomic_add(_slot(_gcell as i64, 1), 0 as i64 - (1 as i64))
_put(i, S_BUSY, 0 as i64)
if _get(i, S_PENDING) != (0 as i64):
_put(i, S_PENDING, 0 as i64)
_launch(i)
end
end
func _pick(i: int): i64:
lo := _get(i, S_INTERVAL)
hi := _get(i, S_MAX)
if hi <= lo: ret lo end
ret rand.IntRange(lo, hi)
end
func _launch(i: int): bool:
cap := atomic_load(_gcell)
if cap > (0 as i64) and atomic_load(_slot(_gcell as i64, 1)) >= cap: ret false end
if atomic_swap(_slot(_cell(i), S_BUSY), 1 as i64) != (0 as i64):
if _get(i, S_QUEUE) != (0 as i64): _put(i, S_PENDING, 1 as i64) end
ret false
end
atomic_add(_slot(_gcell as i64, 1), 1 as i64)
_put(i, S_RUNS, _get(i, S_RUNS) + (1 as i64))
lim := _get(i, S_LIMIT)
if lim > (0 as i64) and _get(i, S_RUNS) >= lim: _put(i, S_REMOVED, 1 as i64) end
salam_cron_spawn(_cron_entry, i as i64)
ret true
end
func _cron_loop(arg: i64):
Run()
end
func _next_minute(e: Expr, after: i64, zone: str, fallback_minutes: int): i64:
mut z := calendar.LoadZone(zone)
mut found := 0 as i64
mut t := (after / (60 as i64) + (1 as i64)) * (60 as i64)
mut steps := 0
until steps < CRON_MAX_SCAN and found == (0 as i64):
local := t + _offset(z, fallback_minutes, t)
sod := local % (86400 as i64)
if not _has(e.months, time.MonthUTC(local)):
t += (86400 as i64) - sod
else not _has(e.hours, time.HourUTC(local)):
t += (3600 as i64) - (local % (3600 as i64))
else MatchesLocal(e, local):
found = t
else:
t += 60 as i64
end
steps++
end
if z.ok: calendar.FreeZone(z) end
ret found
end
func _register(name: str, kind: int, e: Expr, fn: i64, interval: i64, hi: i64, first: i64): int:
cell := mem.AllocateZeroed((S_COUNT * 8) as u64) as i64*
atomic_store(_slot(cell as i64, S_INTERVAL), interval)
atomic_store(_slot(cell as i64, S_MAX), hi)
atomic_store(_slot(cell as i64, S_NEXT), first)
sync.Lock(_mu)
_jobs.push(_Job { name = str.Clone(name), kind = kind, expr = e, fn = fn, cell = cell as i64 })
id := _jobs.len() - 1
sync.Unlock(_mu)
ret id
end
func _at_fields(at: str): str:
parts := str.Split(at, ":")
defer parts.free()
n := parts.len()
if n < 2 or n > 3: ret "" end
h := _num(parts.get(0), CRON_KIND_PLAIN)
m := _num(parts.get(1), CRON_KIND_PLAIN)
mut sec := 0
if n == 3: sec = _num(parts.get(2), CRON_KIND_PLAIN) end
if h < 0 or h > 23 or m < 0 or m > 59 or sec < 0 or sec > 59: ret "" end
if n == 3: ret conv.FormatInt(sec as i64) + " " + conv.FormatInt(m as i64) + " " + conv.FormatInt(h as i64) end
ret conv.FormatInt(m as i64) + " " + conv.FormatInt(h as i64)
end
func _due(i: int, now: i64, dedupe: bool): bool:
if _get(i, S_REMOVED) != (0 as i64): ret false end
st := _get(i, S_START_AT)
if st > (0 as i64) and now < st: ret false end
stop := _get(i, S_STOP_AT)
if stop > (0 as i64) and now > stop: ret false end
j := _job(i)
if j.kind != JOB_CRON:
nx := _get(i, S_NEXT)
if nx == (0 as i64) or now < nx: ret false end
ret true
end
local := now + OffsetSeconds(_zone_name, _zone_fallback, now)
if not MatchesLocal(j.expr, local): ret false end
mut slot := now / (60 as i64)
if j.expr.with_seconds:
if not _has(j.expr.seconds, time.SecondUTC(local)): ret false end
slot = now
end
if dedupe:
if _get(i, S_SLOT) == slot + (1 as i64): ret false end
end
ret true
end
func _advance(i: int, now: i64):
j := _job(i)
if j.kind == JOB_CRON:
slot := now / (60 as i64)
if j.expr.with_seconds: _put(i, S_SLOT, now + (1 as i64)) else:
_put(i, S_SLOT, slot + (1 as i64))
end
ret
end
if j.kind == JOB_ONCE:
_put(i, S_NEXT, 0 as i64)
_put(i, S_REMOVED, 1 as i64)
ret
end
if _get(i, S_AFTER_DONE) != (0 as i64):
_put(i, S_NEXT, 0 as i64)
ret
end
mut step := _get(i, S_INTERVAL)
if j.kind == JOB_BETWEEN: step = _pick(i) end
mut nx := _get(i, S_NEXT) + step
if nx <= now: nx = now + step end
_put(i, S_NEXT, nx)
end
func _fire_due(now: i64, dedupe: bool): int:
mut started := 0
n := _n()
repeat n in i:
if _due(i, now, dedupe):
_advance(i, now)
if _launch(i): started++ end
end
end
ret started
end
@en "Parse"
@fa "تجزیه"
pub func Parse(spec: str): Expr:
mut e := Expr {}
fields := str.Fields(_expand_macro(spec))
defer fields.free()
n := fields.len()
if n != 5 and n != 6: ret e end
mut star := false
mut at := 0
if n == 6:
e.seconds = 0
if not _parse_field(fields.get(0), 0, 59, CRON_KIND_PLAIN, e.seconds, star): ret e end
e.with_seconds = true
at = 1
end
if not _parse_field(fields.get(at + 0), 0, 59, CRON_KIND_PLAIN, e.minutes, star): ret e end
if not _parse_field(fields.get(at + 1), 0, 23, CRON_KIND_PLAIN, e.hours, star): ret e end
if not _parse_field(fields.get(at + 2), 1, 31, CRON_KIND_PLAIN, e.days, star): ret e end
e.dom_star = star
if not _parse_field(fields.get(at + 3), 1, 12, CRON_KIND_MONTH, e.months, star): ret e end
if not _parse_field(fields.get(at + 4), 0, 7, CRON_KIND_DOW, e.weekdays, star): ret e end
e.dow_star = star
if _has(e.weekdays, 7):
e.weekdays = e.weekdays | _bit(0)
end
e.ok = true
ret e
end
@en "MatchFields"
@fa "تطبیق فیلدها"
pub func MatchFields(e: Expr, minute: int, hour: int, day: int, month: int, weekday: int): bool:
if not e.ok: ret false end
if not _has(e.minutes, minute) or not _has(e.hours, hour) or not _has(e.months, month):
ret false
end
dom := _has(e.days, day)
dow := _has(e.weekdays, weekday)
if e.dom_star or e.dow_star:
ret dom and dow
end
ret dom or dow
end
@en "MatchesLocal"
@fa "تطبیق محلی"
pub func MatchesLocal(e: Expr, local: i64): bool:
days := local / (86400 as i64)
weekday := ((days + (4 as i64)) % (7 as i64)) as int
ret MatchFields(e, time.MinuteUTC(local), time.HourUTC(local), time.DayUTC(local), time.MonthUTC(local), weekday)
end
@en "OffsetSeconds"
@fa "اختلاف ثانیه منطقه"
pub func OffsetSeconds(zone: str, fallback_minutes: int, epoch: i64): i64:
mut z := calendar.LoadZone(zone)
off := _offset(z, fallback_minutes, epoch)
if z.ok: calendar.FreeZone(z) end
ret off
end
@en "Next"
@fa "بعدی"
pub func Next(e: Expr, after: i64, zone: str, fallback_minutes: int): i64:
if not e.ok: ret 0 end
if not e.with_seconds: ret _next_minute(e, after, zone, fallback_minutes) end
t0 := after + (1 as i64)
base := t0 - (t0 % (60 as i64))
first := (t0 % (60 as i64)) as int
local := base + OffsetSeconds(zone, fallback_minutes, base)
if MatchesLocal(e, local):
repeat 60 - first in k:
sec := first + k
if _has(e.seconds, sec): ret base + (sec as i64) end
end
end
m := _next_minute(e, base, zone, fallback_minutes)
if m == (0 as i64): ret 0 end
repeat 60 in sec:
if _has(e.seconds, sec): ret m + (sec as i64) end
end
ret 0
end
@en "SetZone"
@fa "تنظیم منطقه"
pub func SetZone(name: str, fallback_minutes: int):
_zone_name = str.Clone(name)
_zone_fallback = fallback_minutes
end
@en "Add"
@fa "افزودن"
pub func Add(name: str, spec: str, fn: i64): int:
e := Parse(spec)
if not e.ok: ret 0 - 1 end
ret _register(name, JOB_CRON, e, fn, 0 as i64, 0 as i64, 0 as i64)
end
@en "Every"
@fa "هر"
pub func Every(name: str, seconds: int, fn: i64): int:
if seconds <= 0: ret 0 - 1 end
ret _register(name, JOB_EVERY, Expr {}, fn, seconds as i64, 0 as i64, time.Now() + (seconds as i64))
end
@en "EveryBetween"
@fa "هر بین"
pub func EveryBetween(name: str, lo: int, hi: int, fn: i64): int:
if lo <= 0 or hi < lo: ret 0 - 1 end
id := _register(name, JOB_BETWEEN, Expr {}, fn, lo as i64, hi as i64, 0 as i64)
_put(id, S_NEXT, time.Now() + _pick(id))
ret id
end
@en "Once"
@fa "یک بار"
pub func Once(name: str, at: i64, fn: i64): int:
id := _register(name, JOB_ONCE, Expr {}, fn, 0 as i64, 0 as i64, at)
_put(id, S_LIMIT, 1 as i64)
ret id
end
@en "DailyAt"
@fa "روزانه در"
pub func DailyAt(name: str, at: str, fn: i64): int:
f := _at_fields(at)
if f == "": ret 0 - 1 end
ret Add(name, f + " * * *", fn)
end
@en "WeeklyAt"
@fa "هفتگی در"
pub func WeeklyAt(name: str, days: str, at: str, fn: i64): int:
f := _at_fields(at)
if f == "": ret 0 - 1 end
ret Add(name, f + " * * " + days, fn)
end
@en "MonthlyAt"
@fa "ماهانه در"
pub func MonthlyAt(name: str, day: int, at: str, fn: i64): int:
f := _at_fields(at)
if f == "" or day < 1 or day > 31: ret 0 - 1 end
ret Add(name, f + " " + conv.FormatInt(day as i64) + " * *", fn)
end
@en "Count"
@fa "تعداد"
pub func Count(): int:
mut n := 0
repeat _n() in i:
if _get(i, S_REMOVED) == (0 as i64): n++ end
end
ret n
end
@en "Total"
@fa "کل"
pub func Total(): int: ret _n() end
@en "Name"
@fa "نام"
pub func Name(id: int): str: ret _job(id).name end
@en "Find"
@fa "یافتن"
pub func Find(name: str): int:
repeat _n() in i:
if _job(i).name == name and _get(i, S_REMOVED) == (0 as i64): ret i end
end
ret 0 - 1
end
@en "IsBusy"
@fa "مشغول است"
pub func IsBusy(id: int): bool:
ret _get(id, S_BUSY) != (0 as i64)
end
@en "Remove"
@fa "حذف"
pub func Remove(id: int):
if id >= 0 and id < _n(): _put(id, S_REMOVED, 1 as i64) end
end
@en "SetTags"
@fa "تنظیم برچسب"
pub func SetTags(id: int, tags: str):
j := _job(id)
sync.Lock(_mu)
_jobs.set(id, _Job { name = j.name, tags = "," + tags + ",", kind = j.kind, expr = j.expr, fn = j.fn, cell = j.cell })
sync.Unlock(_mu)
end
@en "HasTag"
@fa "برچسب دارد"
pub func HasTag(id: int, tag: str): bool:
ret str.Contains(_job(id).tags, "," + tag + ",")
end
@en "RemoveByTag"
@fa "حذف با برچسب"
pub func RemoveByTag(tag: str): int:
mut n := 0
repeat _n() in i:
if HasTag(i, tag) and _get(i, S_REMOVED) == (0 as i64):
Remove(i)
n++
end
end
ret n
end
@en "Limit"
@fa "محدودیت"
pub func Limit(id: int, n: int):
_put(id, S_LIMIT, n as i64)
end
@en "StartAt"
@fa "شروع از"
pub func StartAt(id: int, at: i64):
_put(id, S_START_AT, at)
end
@en "StopAt"
@fa "توقف در"
pub func StopAt(id: int, at: i64):
_put(id, S_STOP_AT, at)
end
@en "FromCompletion"
@fa "از اتمام اجرا"
pub func FromCompletion(id: int):
_put(id, S_AFTER_DONE, 1 as i64)
end
@en "Queue"
@fa "صف"
pub func Queue(id: int):
_put(id, S_QUEUE, 1 as i64)
end
@en "OnBefore"
@fa "پیش از اجرا"
pub func OnBefore(fn: i64):
_before = fn
end
@en "OnAfter"
@fa "پس از اجرا"
pub func OnAfter(fn: i64):
_after = fn
end
@en "Fail"
@fa "شکست"
pub func Fail(id: i64):
_put(id as int, S_FAILED, 1 as i64)
end
@en "OnError"
@fa "هنگام خطا"
pub func OnError(fn: i64):
_on_error = fn
end
@en "Failures"
@fa "تعداد شکست"
pub func Failures(id: int): i64: ret _get(id, S_FAILS) end
@en "ConcurrencyLimit"
@fa "سقف هم‌زمانی"
pub func ConcurrencyLimit(n: int):
atomic_store(_gcell, n as i64)
end
@en "Runs"
@fa "تعداد اجرا"
pub func Runs(id: int): i64: ret _get(id, S_RUNS) end
@en "LastRun"
@fa "آخرین اجرا"
pub func LastRun(id: int): i64: ret _get(id, S_STARTED) end
@en "LastFinished"
@fa "آخرین اتمام"
pub func LastFinished(id: int): i64: ret _get(id, S_FINISHED) end
@en "NextRun"
@fa "اجرای بعدی"
pub func NextRun(id: int, after: i64): i64:
if _get(id, S_REMOVED) != (0 as i64): ret 0 end
j := _job(id)
mut t := 0 as i64
if j.kind == JOB_CRON:
t = Next(j.expr, after, _zone_name, _zone_fallback)
else:
t = _get(id, S_NEXT)
end
st := _get(id, S_START_AT)
if st > (0 as i64) and t < st:
if j.kind == JOB_CRON: t = Next(j.expr, st - (1 as i64), _zone_name, _zone_fallback) else:
t = st
end
end
stop := _get(id, S_STOP_AT)
if stop > (0 as i64) and t > stop: ret 0 end
ret t
end
@en "RunDue"
@fa "اجرای موعد"
pub func RunDue(now: i64): int:
ret _fire_due(now, false)
end
@en "RunNow"
@fa "اجرای فوری"
pub func RunNow(id: int): bool:
if id < 0 or id >= _n(): ret false end
ret _launch(id)
end
@en "Run"
@fa "اجرا"
pub func Run():
if _stop == null:
_stop = mem.AllocateZeroed(8 as u64) as i64*
end
until atomic_load(_stop) == (0 as i64):
now := time.Now()
_fire_due(now, true)
time.Sleep(200)
end
end
@en "RunBackground"
@fa "اجرا در پس‌زمینه"
pub func RunBackground():
if _stop == null:
_stop = mem.AllocateZeroed(8 as u64) as i64*
end
salam_cron_spawn(_cron_loop, 0 as i64)
end
@en "Stop"
@fa "توقف"
pub func Stop():
if _stop != null:
atomic_store(_stop, 1 as i64)
end
end
@en "StopWait"
@fa "توقف با انتظار"
pub func StopWait(timeout_ms: int):
Stop()
mut waited := 0
until waited < timeout_ms:
mut any := false
repeat _n() in i:
if IsBusy(i): any = true end
end
if not any: ret end
time.Sleep(10)
waited += 10
end
end
