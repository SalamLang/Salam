pub hbits: int
pub ll: u32*
pub llog: int
pub off: u32*
pub olog: int
pub ml: u32*
pub mlog: int
pub ftmp: u32*
pub norm: int*
pub nxt: int*
pub spr: u8*
pub lit: u8*
pub litp: u8*
pub nlit: int
pub wt: u8*
pub r1: int
pub r2: int
pub r3: int
pub dc: u8*
pub dl: int
pub dlist: u8*
pub dn: int
pub did: int
pub fstart: int
pub cap: int
pub st: int
end
struct _ZBr:
pub p: u8*
