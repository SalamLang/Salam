end
@en "Message"
@fa "پیام"
pub struct Message:
@en "message_id"
@fa "شناسه پیام"
pub message_id: i64 = 0
@en "date"
@fa "زمان"
pub date: i64 = 0
@en "chat"
@fa "گفتگو"
pub chat: Chat = Chat {}
@en "from_user"
@fa "فرستنده"
pub from_user: User = User {}
@en "text"
@fa "متن"
pub text: str = ""
@en "caption"
@fa "زیرنویس"
pub caption: str = ""
@en "reply_to"
@fa "پیام پاسخ‌داده‌شده"
pub reply_to: ReplyTo = ReplyTo {}
end
