@en "ErrorKind"
@fa "نوع خطا"
pub enum ErrorKind:
@en "Other"
@fa "دیگر"
Other
@en "Syntax"
@fa "نحو"
Syntax
@en "UnexpectedEnd"
@fa "اتمام ناگهانی"
UnexpectedEnd
@en "TypeMismatch"
@fa "ناهمخوانی نوع"
TypeMismatch
@en "MissingKey"
@fa "کلید ناموجود"
MissingKey
@en "OutOfRange"
@fa "خارج از بازه"
OutOfRange
@en "InvalidUtf8"
@fa "یوتی‌اف۸ نامعتبر"
InvalidUtf8
@en "InvalidArgument"
@fa "آرگومان نامعتبر"
InvalidArgument
@en "NotFound"
@fa "یافت نشد"
NotFound
@en "AlreadyExists"
@fa "از قبل موجود"
AlreadyExists
@en "PermissionDenied"
@fa "دسترسی رد شد"
PermissionDenied
@en "Io"
@fa "ورودی خروجی"
Io
@en "Timeout"
@fa "اتمام زمان"
Timeout
@en "Canceled"
@fa "لغو شد"
Canceled
@en "Unavailable"
@fa "ناموجود"
Unavailable
@en "Unsupported"
@fa "پشتیبانی نشده"
Unsupported
@en "Internal"
@fa "داخلی"
Internal
end
@en "Error"
@fa "خطا"
pub struct Error:
@en "kind"
@fa "نوع"
pub kind: ErrorKind = ErrorKind.Other
@en "code"
@fa "کد"
pub code: str = ""
@en "message"
@fa "پیام"
pub message: str = ""
@en "context"
@fa "زمینه"
pub context: str = ""
@en "path"
@fa "مسیر"
pub path: str = ""
@en "offset"
@fa "جایگاه"
pub offset: int = 0 - 1
@en "line"
@fa "خط"
pub line: int = 0
@en "column"
@fa "ستون"
pub column: int = 0
@en "New"
@fa "جدید"
pub static func New(kind: ErrorKind, message: str): Error:
ret Error { kind = kind, message = message }
end
@en "At"
@fa "در جایگاه"
pub static func At(kind: ErrorKind, message: str, offset: int): Error:
ret Error { kind = kind, message = message, offset = offset }
end
@en "is"
@fa "است"
pub func is(kind: ErrorKind): bool:
ret this.kind == kind
end
@en "wrap"
@fa "بپیچ"
pub func wrap(message: str): Error:
mut out := Error { kind = this.kind, code = this.code, message = this.message, context = this.context, path = this.path, offset = this.offset, line = this.line, column = this.column }
if out.context == "":
out.context = message
else:
out.context = message + ": " + out.context
end
ret out
end
@en "with_code"
@fa "با کد"
pub func with_code(code: str): Error:
mut out := Error { kind = this.kind, code = this.code, message = this.message, context = this.context, path = this.path, offset = this.offset, line = this.line, column = this.column }
out.code = code
ret out
end
@en "with_path"
@fa "با مسیر"
pub func with_path(path: str): Error:
mut out := Error { kind = this.kind, code = this.code, message = this.message, context = this.context, path = this.path, offset = this.offset, line = this.line, column = this.column }
out.path = path
ret out
end
@en "with_position"
@fa "با موقعیت"
pub func with_position(offset: int, line: int, column: int): Error:
mut out := Error { kind = this.kind, code = this.code, message = this.message, context = this.context, path = this.path, offset = this.offset, line = this.line, column = this.column }
out.offset = offset
out.line = line
out.column = column
ret out
end
@en "locate"
@fa "مکان یابی"
pub func locate(text: str): Error:
mut out := Error { kind = this.kind, code = this.code, message = this.message, context = this.context, path = this.path, offset = this.offset, line = this.line, column = this.column }
if this.offset < 0:
ret out
end
n := text.len()
lim := this.offset < n ? this.offset : n
head := text.substr(0, lim)
mut lines := head.split("\n")
line := lines.len() > 0 ? lines.len() : 1
column := lines.len() > 0 ? lines.get(lines.len() - 1).char_count() + 1 : 1
lines.free()
out.line = line
out.column = column
ret out
end
@en "kind_name"
@fa "نام نوع"
pub func kind_name(): str:
ret _error_kind_text(this.kind)
end
@en "to_str"
@fa "به رشته"
pub func to_str(): str:
mut out := this.message
if out == "":
out = _error_kind_text(this.kind)
end
if this.context != "":
out = this.context + ": " + out
end
if this.path != "":
out = out + " at " + this.path
end
if this.line > 0:
out = out + " (line " + this.line + ", column " + this.column + ")"
else this.offset >= 0:
out = out + " (offset " + this.offset + ")"
end
ret out
end
end
@en "Throws"
@fa "نتیجه پرتاب"
pub enum Throws<T>:
@en "Ok"
@fa "موفق"
Ok(value: T)
@en "Err"
@fa "ناموفق"
Err(error: Error)
end
