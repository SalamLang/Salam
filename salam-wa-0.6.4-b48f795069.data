struct _BzIn:
pub data: void* = null
pub len: int = 0
pub pos: int = 0
pub acc: i64 = 0
pub cnt: int = 0
pub bad: bool = false
pub fp: void* = null
pub foff: i64 = 0 as i64
pub fleft: i64 = 0 as i64
end
struct _BzOut:
pub buf: ByteBuf = ByteBuf { data = null, len = 0, cap = 0 }
pub acc: i64 = 0
pub cnt: int = 0
end
func _bz_refill(s &: _BzIn): bool:
