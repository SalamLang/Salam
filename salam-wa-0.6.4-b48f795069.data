end
@en "LastInsertId"
@fa "شناسه آخرین درج"
pub func LastInsertId(db: Database): i64:
if db.handle == null:
ret 0
end
ret _my_insert_id(db.handle) as i64
end
@en "Begin"
@fa "شروع تراکنش"
pub func Begin(db: Database): int:
