@en "max_total"
@fa "بیشینه اندازه کل"
pub max_total: i64 = 4294967296 as i64
@en "max_ratio"
@fa "بیشینه نسبت فشرده سازی"
pub max_ratio: int = 5000
end
@en "Archive"
@fa "بایگانی"
pub struct Archive:
@en "data"
