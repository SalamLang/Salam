_wp_write_code(w, cb, lbl, kb)
_wp_write_code(w, ca, la, ka)
_wp_write_code(w, cd, ld, kd)
sg := _wp_used(lg) <= 1
sr := _wp_used(lr) <= 1
sb := _wp_used(lbl) <= 1
sa := _wp_used(la) <= 1
sd := _wp_used(ld) <= 1
repeat tl.len() in t:
n := tl.get(t)
