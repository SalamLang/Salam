func _ttf_u8(p: void*, n: int, off: int): int:
if off < 0 or off >= n:
ret 0
end
bp := p as u8*
ret bp[off] as int
end
func _ttf_u16(p: void*, n: int, off: int): int:
ret (_ttf_u8(p, n, off) << 8) | _ttf_u8(p, n, off + 1)
end
func _ttf_i16(p: void*, n: int, off: int): int:
v := _ttf_u16(p, n, off)
if v >= 32768:
ret v - 65536
end
ret v
end
func _ttf_u32(p: void*, n: int, off: int): int:
ret (_ttf_u16(p, n, off) << 16) | _ttf_u16(p, n, off + 2)
end
func _ttf_find_table(p: void*, n: int, dir_off: int, tag: int, len_out &: int): int:
num_tables := _ttf_u16(p, n, dir_off + 4)
mut i := 0
until i < num_tables:
rec := dir_off + 12 + i * 16
if _ttf_u32(p, n, rec) == tag:
len_out = _ttf_u32(p, n, rec + 12)
ret _ttf_u32(p, n, rec + 8)
end
i++
end
len_out = 0
ret 0
end
func _ttf_init(f &: Font, dir_off: int): bool:
ver := _ttf_u32(f.data, f.size, dir_off)
if ver != _TTF_SFNT_10 and ver != _TTF_SFNT_TRUE:
ret false
end
mut tlen := 0
head := _ttf_find_table(f.data, f.size, dir_off, _TTF_TAG_HEAD, tlen)
maxp := _ttf_find_table(f.data, f.size, dir_off, _TTF_TAG_MAXP, tlen)
hhea := _ttf_find_table(f.data, f.size, dir_off, _TTF_TAG_HHEA, tlen)
if head == 0 or maxp == 0:
ret false
end
f.glyf = _ttf_find_table(f.data, f.size, dir_off, _TTF_TAG_GLYF, tlen)
f.glyf_len = tlen
f.loca = _ttf_find_table(f.data, f.size, dir_off, _TTF_TAG_LOCA, tlen)
f.loca_len = tlen
f.hmtx = _ttf_find_table(f.data, f.size, dir_off, _TTF_TAG_HMTX, tlen)
f.kern = _ttf_find_table(f.data, f.size, dir_off, _TTF_TAG_KERN, tlen)
f.kern_len = tlen
f.head = head
f.hhea = hhea
f.os2 = _ttf_find_table(f.data, f.size, dir_off, _TTF_TAG_OS2, tlen)
f.name = _ttf_find_table(f.data, f.size, dir_off, _TTF_TAG_NAME, tlen)
f.post = _ttf_find_table(f.data, f.size, dir_off, _TTF_TAG_POST, tlen)
f.gsub = _ttf_find_table(f.data, f.size, dir_off, _TTF_TAG_GSUB, tlen)
f.gpos = _ttf_find_table(f.data, f.size, dir_off, _TTF_TAG_GPOS, tlen)
f.gdef = _ttf_find_table(f.data, f.size, dir_off, _TTF_TAG_GDEF, tlen)
if f.glyf == 0 or f.loca == 0:
ret false
end
f.units_per_em = _ttf_u16(f.data, f.size, head + 18)
f.loca_long = _ttf_i16(f.data, f.size, head + 50) != 0
f.num_glyphs = _ttf_u16(f.data, f.size, maxp + 4)
if f.units_per_em <= 0 or f.num_glyphs <= 0:
ret false
end
if hhea != 0:
f.ascent = _ttf_i16(f.data, f.size, hhea + 4)
f.descent = _ttf_i16(f.data, f.size, hhea + 6)
f.line_gap = _ttf_i16(f.data, f.size, hhea + 8)
f.num_hmetrics = _ttf_u16(f.data, f.size, hhea + 34)
end
if f.ascent == 0 and f.descent == 0:
f.ascent = (f.units_per_em * 4) / 5
f.descent = 0 - f.units_per_em / 5
end
_ttf_pick_cmap(f, _ttf_find_table(f.data, f.size, dir_off, _TTF_TAG_CMAP, tlen))
ret true
end
@en "ParseFontIndex"
@fa "خواندن قلم با اندیس"
pub func ParseFontIndex(p: void*, n: int, index: int, ok &: bool): Font:
mut f := Font {}
ok = false
if p == null or n < 12:
ret f
end
f.data = mem.Allocate(n as u64)
if f.data == null:
ret f
end
mem.Copy(f.data, p, n as u64)
f.size = n
mut dir := 0
if _ttf_u32(f.data, f.size, 0) == _TTF_SFNT_TTCF:
count := _ttf_u32(f.data, f.size, 8)
if index < 0 or index >= count:
FreeFont(f)
ret f
end
dir = _ttf_u32(f.data, f.size, 12 + index * 4)
else:
if index != 0:
FreeFont(f)
ret f
end
end
if not _ttf_init(f, dir):
FreeFont(f)
ret f
end
f.ok = true
f.index = index
f.id = _ttf_next_id
_ttf_next_id++
ok = true
ret f
end
@en "ParseFont"
@fa "خواندن قلم"
pub func ParseFont(p: void*, n: int, ok &: bool): Font:
ret ParseFontIndex(p, n, 0, ok)
end
@en "LoadFont"
@fa "بارگذاری قلم"
pub func LoadFont(path: str, ok &: bool): Font:
ret LoadFontIndex(path, 0, ok)
end
@en "LoadFontIndex"
@fa "بارگذاری قلم با اندیس"
pub func LoadFontIndex(path: str, index: int, ok &: bool): Font:
ok = false
mut read_ok := false
mut buf := archive.ReadBinaryFile(path, read_ok)
if not read_ok:
compress.BufFree(buf)
ret Font {}
end
out := ParseFontIndex(buf.data, buf.len, index, ok)
compress.BufFree(buf)
ret out
end
@en "FreeFont"
@fa "آزادسازی قلم"
pub func FreeFont(f &: Font):
if f.data != null:
mem.Free(f.data)
end
f.data = null
f.size = 0
f.ok = false
f.num_glyphs = 0
f.units_per_em = 0
end
@en "FontValid"
@fa "قلم معتبر"
pub func FontValid(f: Font): bool:
ret f.ok and f.data != null and f.units_per_em > 0
end
@en "IsCFFFont"
@fa "قلم سی‌اف‌اف است"
pub func IsCFFFont(p: void*, n: int): bool:
if p == null or n < 12:
ret false
end
mut tlen := 0
if _ttf_u32(p, n, 0) == _TTF_SFNT_OTTO:
ret true
end
ret _ttf_find_table(p, n, 0, _TTF_TAG_CFF, tlen) != 0
end
@en "UnitsPerEm"
@fa "واحد در ام"
pub func UnitsPerEm(f: Font): int:
ret f.units_per_em
end
@en "NumGlyphs"
@fa "تعداد نویسه‌ها"
pub func NumGlyphs(f: Font): int:
ret f.num_glyphs
end
package typeset
func _ttf_cmap_score(plat: int, enc: int, format: int): int:
if format != 0 and format != 4 and format != 6 and format != 12:
ret -1
end
if plat == 3 and enc == 10: ret 5 end
if plat == 0 and enc >= 3: ret 4 end
if plat == 3 and enc == 1: ret 3 end
if plat == 0: ret 2 end
if plat == 3 and enc == 0: ret 1 end
if plat == 1 and enc == 0: ret 0 end
ret -1
end
func _ttf_pick_cmap(f &: Font, cmap_off: int):
if cmap_off <= 0:
ret
end
ntab := _ttf_u16(f.data, f.size, cmap_off + 2)
mut best := 0
mut best_score := 0 - 1
mut best_symbol := false
mut i := 0
until i < ntab:
rec := cmap_off + 4 + i * 8
plat := _ttf_u16(f.data, f.size, rec)
enc := _ttf_u16(f.data, f.size, rec + 2)
sub := cmap_off + _ttf_u32(f.data, f.size, rec + 4)
format := _ttf_u16(f.data, f.size, sub)
score := _ttf_cmap_score(plat, enc, format)
if score > best_score:
best_score = score
best = sub
best_symbol = plat == 3 and enc == 0
end
i++
end
if best_score >= 0:
f.cmap_sub = best
f.cmap_symbol = best_symbol
end
end
func _ttf_cmap0(f: Font, sub: int, cp: int): int:
if cp < 0 or cp > 255:
ret 0
end
ret _ttf_u8(f.data, f.size, sub + 6 + cp)
end
func _ttf_cmap4(f: Font, sub: int, cp: int): int:
if cp > 0xFFFF:
ret 0
end
seg_x2 := _ttf_u16(f.data, f.size, sub + 6)
ends := sub + 14
starts := ends + seg_x2 + 2
deltas := starts + seg_x2
ranges := deltas + seg_x2
mut i := 0
until i < seg_x2:
if _ttf_u16(f.data, f.size, ends + i) >= cp:
start := _ttf_u16(f.data, f.size, starts + i)
if start > cp:
ret 0
end
delta := _ttf_u16(f.data, f.size, deltas + i)
ro := _ttf_u16(f.data, f.size, ranges + i)
if ro == 0:
ret (cp + delta) & 0xFFFF
end
g := _ttf_u16(f.data, f.size, ranges + i + ro + (cp - start) * 2)
if g == 0:
ret 0
end
ret (g + delta) & 0xFFFF
end
i += 2
end
ret 0
end
func _ttf_cmap6(f: Font, sub: int, cp: int): int:
first := _ttf_u16(f.data, f.size, sub + 6)
count := _ttf_u16(f.data, f.size, sub + 8)
if cp < first or cp >= first + count:
ret 0
end
ret _ttf_u16(f.data, f.size, sub + 10 + (cp - first) * 2)
end
func _ttf_cmap12(f: Font, sub: int, cp: int): int:
ngroups := _ttf_u32(f.data, f.size, sub + 12)
mut lo := 0
mut hi := ngroups
until lo < hi:
mid := (lo + hi) / 2
g := sub + 16 + mid * 12
start := _ttf_u32(f.data, f.size, g)
end_cp := _ttf_u32(f.data, f.size, g + 4)
if cp < start:
hi = mid
else:
if cp > end_cp:
lo = mid + 1
else:
ret _ttf_u32(f.data, f.size, g + 8) + (cp - start)
end
end
end
ret 0
end
func _ttf_lookup(f: Font, cp: int): int:
if f.cmap_sub == 0:
ret 0
end
format := _ttf_u16(f.data, f.size, f.cmap_sub)
if format == 0: ret _ttf_cmap0(f, f.cmap_sub, cp) end
if format == 4: ret _ttf_cmap4(f, f.cmap_sub, cp) end
if format == 6: ret _ttf_cmap6(f, f.cmap_sub, cp) end
if format == 12: ret _ttf_cmap12(f, f.cmap_sub, cp) end
ret 0
end
@en "GlyphIndex"
@fa "اندیس نویسه"
pub func GlyphIndex(f: Font, codepoint: int): int:
g := _ttf_lookup(f, codepoint)
if g != 0:
ret g
end
if f.cmap_symbol and codepoint >= 0 and codepoint < 0x100:
ret _ttf_lookup(f, 0xF000 + codepoint)
end
ret 0
end
package typeset
const _TTF_ON_CURVE := 1
const _TTF_X_SHORT := 2
const _TTF_Y_SHORT := 4
const _TTF_REPEAT := 8
const _TTF_X_SAME := 16
const _TTF_Y_SAME := 32
const _TTF_ARG_WORDS := 1
const _TTF_ARGS_XY := 2
const _TTF_HAVE_SCALE := 8
const _TTF_MORE_COMP := 32
const _TTF_XY_SCALE := 64
const _TTF_TWO_BY_TWO := 128
const _TTF_MAX_POINTS := 20000
const _TTF_MAX_DEPTH := 5
const _TTF_MAX_WORK := 1024
@en "OutlinePoint"
@fa "نقطه طرح"
pub struct OutlinePoint:
@en "x"
@fa "ایکس"
pub x: f64 = 0.0
@en "y"
@fa "ایگرگ"
pub y: f64 = 0.0
@en "on"
@fa "روی منحنی"
pub on: bool = false
end
@en "GlyphOutline"
@fa "طرح نویسه"
pub struct GlyphOutline:
@en "points"
@fa "نقطه‌ها"
pub points: Vector<OutlinePoint> = Vector {}
@en "ends"
@fa "پایان‌های کانتور"
pub ends: Vector<int> = Vector {}
end
func _ttf_i8(f: Font, off: int): int:
v := _ttf_u8(f.data, f.size, off)
if v >= 128:
ret v - 256
end
ret v
end
func _ttf_f2dot14(f: Font, off: int): f64:
ret (_ttf_i16(f.data, f.size, off) as f64) / 16384.0
end
func _ttf_glyph_range(f: Font, gid: int, off &: int, glen &: int): bool:
off = 0
glen = 0
if gid < 0 or gid >= f.num_glyphs:
ret false
end
mut s := 0
mut e := 0
if f.loca_long:
s = _ttf_u32(f.data, f.size, f.loca + gid * 4)
e = _ttf_u32(f.data, f.size, f.loca + gid * 4 + 4)
else:
s = _ttf_u16(f.data, f.size, f.loca + gid * 2) * 2
e = _ttf_u16(f.data, f.size, f.loca + gid * 2 + 2) * 2
end
if e <= s or s < 0:
ret false
end
off = f.glyf + s
glen = e - s
ret true
end
func _ttf_read_flags(f: Font, start: int, npoints: int, flags &: Vector<int>): int:
mut cur := start
mut n := 0
until n < npoints:
fl := _ttf_u8(f.data, f.size, cur)
cur++
flags.push(fl)
n++
if (fl & _TTF_REPEAT) != 0:
r := _ttf_u8(f.data, f.size, cur)
cur++
mut k := 0
until k < r and n < npoints:
flags.push(fl)
n++
k++
end
end
end
ret cur
end
func _ttf_read_coords(f: Font, start: int, npoints: int, short_bit: int, same_bit: int, flags &: Vector<int>, out &: Vector<int>): int:
mut cur := start
mut v := 0
mut i := 0
until i < npoints:
fl := flags.get(i)
if (fl & short_bit) != 0:
d := _ttf_u8(f.data, f.size, cur)
cur++
if (fl & same_bit) != 0:
v += d
else:
v -= d
end
else if (fl & same_bit) == 0:
v += _ttf_i16(f.data, f.size, cur)
cur += 2
end
out.push(v)
i++
end
ret cur
end
func _ttf_simple_glyph(f: Font, goff: int, ncont: int, a: f64, b: f64, c: f64, d: f64, dx: f64, dy: f64, pts &: Vector<OutlinePoint>, ends &: Vector<int>):
base := pts.len()
npoints := _ttf_u16(f.data, f.size, goff + 10 + (ncont - 1) * 2) + 1
if npoints <= 0 or npoints > _TTF_MAX_POINTS or pts.len() + npoints > _TTF_MAX_POINTS:
ret
end
mut i := 0
until i < ncont:
e := _ttf_u16(f.data, f.size, goff + 10 + i * 2)
if e < npoints:
ends.push(base + e + 1)
end
i++
end
ins_at := goff + 10 + ncont * 2
mut flags := Vector {} as Vector<int>
mut xs := Vector {} as Vector<int>
mut ys := Vector {} as Vector<int>
after_flags := _ttf_read_flags(f, ins_at + 2 + _ttf_u16(f.data, f.size, ins_at), npoints, flags)
after_x := _ttf_read_coords(f, after_flags, npoints, _TTF_X_SHORT, _TTF_X_SAME, flags, xs)
_ttf_read_coords(f, after_x, npoints, _TTF_Y_SHORT, _TTF_Y_SAME, flags, ys)
mut k := 0
until k < npoints:
gx := xs.get(k) as f64
gy := ys.get(k) as f64
mut p := OutlinePoint {}
p.x = a * gx + c * gy + dx
p.y = b * gx + d * gy + dy
p.on = (flags.get(k) & _TTF_ON_CURVE) != 0
pts.push(p)
k++
end
flags.free()
xs.free()
ys.free()
end
func _ttf_component_xform(f: Font, at: int, flags: int, sa &: f64, sb &: f64, sc &: f64, sd &: f64, ox &: f64, oy &: f64): int:
mut cur := at
mut arg1 := 0
mut arg2 := 0
if (flags & _TTF_ARG_WORDS) != 0:
arg1 = _ttf_i16(f.data, f.size, cur)
arg2 = _ttf_i16(f.data, f.size, cur + 2)
cur += 4
else:
arg1 = _ttf_i8(f, cur)
arg2 = _ttf_i8(f, cur + 1)
cur += 2
end
sa = 1.0
sb = 0.0
sc = 0.0
sd = 1.0
if (flags & _TTF_HAVE_SCALE) != 0:
sa = _ttf_f2dot14(f, cur)
sd = sa
cur += 2
else if (flags & _TTF_XY_SCALE) != 0:
sa = _ttf_f2dot14(f, cur)
sd = _ttf_f2dot14(f, cur + 2)
cur += 4
else if (flags & _TTF_TWO_BY_TWO) != 0:
sa = _ttf_f2dot14(f, cur)
sb = _ttf_f2dot14(f, cur + 2)
sc = _ttf_f2dot14(f, cur + 4)
sd = _ttf_f2dot14(f, cur + 6)
cur += 8
end
ox = 0.0
oy = 0.0
if (flags & _TTF_ARGS_XY) != 0:
ox = arg1 as f64
oy = arg2 as f64
end
ret cur
end
func _ttf_composite_glyph(f: Font, goff: int, a: f64, b: f64, c: f64, d: f64, dx: f64, dy: f64, pts &: Vector<OutlinePoint>, ends &: Vector<int>, depth: int, work &: int):
mut cur := goff + 10
mut more := true
until more and pts.len() <= _TTF_MAX_POINTS and work <= _TTF_MAX_WORK:
flags := _ttf_u16(f.data, f.size, cur)
sub := _ttf_u16(f.data, f.size, cur + 2)
mut sa := 1.0
mut sb := 0.0
mut sc := 0.0
mut sd := 1.0
mut ox := 0.0
mut oy := 0.0
cur = _ttf_component_xform(f, cur + 4, flags, sa, sb, sc, sd, ox, oy)
_ttf_append_glyph(f, sub, a * sa + c * sb, b * sa + d * sb, a * sc + c * sd, b * sc + d * sd, a * ox + c * oy + dx, b * ox + d * oy + dy, pts, ends, depth + 1, work)
more = (flags & _TTF_MORE_COMP) != 0
end
end
func _ttf_append_glyph(f: Font, gid: int, a: f64, b: f64, c: f64, d: f64, dx: f64, dy: f64, pts &: Vector<OutlinePoint>, ends &: Vector<int>, depth: int, work &: int):
work++
if depth >= _TTF_MAX_DEPTH or pts.len() > _TTF_MAX_POINTS or work > _TTF_MAX_WORK:
ret
end
mut goff := 0
mut glen := 0
if not _ttf_glyph_range(f, gid, goff, glen):
ret
end
ncont := _ttf_i16(f.data, f.size, goff)
if ncont > 0:
_ttf_simple_glyph(f, goff, ncont, a, b, c, d, dx, dy, pts, ends)
ret
end
if ncont < 0:
_ttf_composite_glyph(f, goff, a, b, c, d, dx, dy, pts, ends, depth, work)
end
end
@en "GlyphBox"
@fa "کادر نویسه"
pub func GlyphBox(f: Font, glyph: int, x0 &: int, y0 &: int, x1 &: int, y1 &: int): bool:
x0 = 0
y0 = 0
x1 = 0
y1 = 0
mut goff := 0
mut glen := 0
if not _ttf_glyph_range(f, glyph, goff, glen):
ret false
end
x0 = _ttf_i16(f.data, f.size, goff + 2)
y0 = _ttf_i16(f.data, f.size, goff + 4)
x1 = _ttf_i16(f.data, f.size, goff + 6)
y1 = _ttf_i16(f.data, f.size, goff + 8)
ret true
end
@en "GlyphHasOutline"
@fa "نویسه طرح دارد"
pub func GlyphHasOutline(f: Font, glyph: int): bool:
mut goff := 0
mut glen := 0
if not _ttf_glyph_range(f, glyph, goff, glen):
ret false
end
ret _ttf_i16(f.data, f.size, goff) != 0
end
@en "TransformedOutline"
@fa "طرح تبدیل‌شده"
pub func TransformedOutline(f: Font, glyph: int, a: f64, b: f64, c: f64, d: f64, dx: f64, dy: f64): GlyphOutline:
mut o := GlyphOutline {}
if not FontValid(f):
ret o
end
mut work := 0
_ttf_append_glyph(f, glyph, a, b, c, d, dx, dy, o.points, o.ends, 0, work)
ret o
end
@en "FreeOutline"
@fa "آزادسازی طرح"
pub func FreeOutline(o &: GlyphOutline):
o.points.free()
o.ends.free()
o.points = Vector {} as Vector<OutlinePoint>
o.ends = Vector {} as Vector<int>
end
package typeset
@en "ScaleFactor"
@fa "ضریب مقیاس"
pub func ScaleFactor(f: Font, size: f64): f64:
if f.units_per_em <= 0:
ret 0.0
end
ret size / (f.units_per_em as f64)
end
@en "AscentPixels"
@fa "صعود پیکسلی"
pub func AscentPixels(f: Font, size: f64): f64:
ret (f.ascent as f64) * ScaleFactor(f, size)
end
@en "DescentPixels"
@fa "نزول پیکسلی"
pub func DescentPixels(f: Font, size: f64): f64:
ret (f.descent as f64) * ScaleFactor(f, size)
end
@en "LineHeightPixels"
@fa "ارتفاع خط پیکسلی"
pub func LineHeightPixels(f: Font, size: f64): f64:
ret ((f.ascent - f.descent + f.line_gap) as f64) * ScaleFactor(f, size)
end
@en "GlyphAdvance"
@fa "پیشروی نویسه"
pub func GlyphAdvance(f: Font, glyph: int): int:
if f.hmtx == 0 or f.num_hmetrics <= 0 or glyph < 0:
ret 0
end
mut i := glyph
if i >= f.num_hmetrics:
i = f.num_hmetrics - 1
end
ret _ttf_u16(f.data, f.size, f.hmtx + i * 4)
end
@en "KernAdvance"
@fa "کرنینگ"
pub func KernAdvance(f: Font, glyph1: int, glyph2: int): int:
if f.kern == 0 or glyph1 <= 0 or glyph2 <= 0:
ret 0
end
if _ttf_u16(f.data, f.size, f.kern + 2) < 1:
ret 0
end
coverage := _ttf_u16(f.data, f.size, f.kern + 8)
if (coverage & 0xFF00) != 0 or (coverage & 1) == 0:
ret 0
end
npairs := _ttf_u16(f.data, f.size, f.kern + 10)
key := (glyph1 << 16) | glyph2
base := f.kern + 18
mut lo := 0
mut hi := npairs
until lo < hi:
mid := (lo + hi) / 2
rec := base + mid * 6
k := (_ttf_u16(f.data, f.size, rec) << 16) | _ttf_u16(f.data, f.size, rec + 2)
if key < k:
hi = mid
else:
if key > k:
lo = mid + 1
else:
ret _ttf_i16(f.data, f.size, rec + 4)
end
end
end
ret 0
end
@en "typeset"
@fa "حروف‌چینی"
package typeset
package ui
import gui.css
import gui.reactive
func _prop_name(prop: int): str:
switch prop:
0: ret "color" end
1: ret "background-color" end
2: ret "opacity" end
else: ret "transform" end
end
ret "opacity"
end
func _find_transition(cs: css.ComputedStyle, prop: int, out &: css.Transition): bool:
name := _prop_name(prop)
mut found := false
each t in cs.transitions:
if (t.property == "all" or t.property == name or (prop == 1 and t.property == "background") or (prop == 3 and (t.property == "translate" or t.property == "rotate" or t.property == "scale"))) and t.duration > 0.0:
out = t
found = true
end
end
ret found
end
func _now(): i64:
ret reactive.Now()
end
func _anim_index(node: int, prop: int): int:
repeat _e.anims.len() in i:
a := _e.anims[i]
if a.node == node and a.prop == prop and not a.done:
ret i
end
end
ret -1
end
func _same_color(a: css.Color, b: css.Color): bool:
ret a.r == b.r and a.g == b.g and a.b == b.b and a.a == b.a
end
func _start_transitions(i: int, old: css.ComputedStyle, now: css.ComputedStyle):
node := _e.el_node[i]
repeat 4 in prop:
mut t := css.Transition {}
if not _find_transition(now, prop, t):
continue
end
mut a := _Anim { node = node, uid = _e.ctl[node].uid, prop = prop, start = _now(), duration = t.duration, delay = t.delay, timing = t.timing }
if prop == 3:
if not _xf_changed(old, now):
continue
end
a.from_x = Vector {} as Vector<css.TransformFn>
a.to_x = Vector {} as Vector<css.TransformFn>
_xf_current_fns(node, old, a.from_x)
_fns_of(now, a.to_x)
else prop == 2:
if old.opacity == now.opacity:
continue
end
a.from_f = _anim_f(node, 2, old.opacity)
a.to_f = now.opacity
else:
oc := prop == 0 ? old.color : old.background_color
nc := prop == 0 ? now.color : now.background_color
if _same_color(oc, nc):
continue
end
a.from = _anim_color(node, prop, oc)
a.to = nc
end
k := _anim_index(node, prop)
if k >= 0:
mut prev := _e.anims[k]
prev.done = true
_e.anims[k] = prev
end
_e.anims.push(a)
end
end
func _anim_progress(a: _Anim): f64:
el := (_now() - a.start) as f64 - a.delay
if el <= 0.0:
ret 0.0
end
if a.duration <= 0.0 or el >= a.duration:
ret 1.0
end
ret css.EasingAt(a.timing, el / a.duration)
end
func _anim_color(node: int, prop: int, target: css.Color): css.Color:
if _e.anims.len() == 0:
ret target
end
k := _anim_index(node, prop)
if k < 0:
ret target
end
a := _e.anims[k]
t := _anim_progress(a)
if t >= 1.0:
ret target
end
ret css.MixColors(a.from, target, t)
end
func _anim_f(node: int, prop: int, target: f64): f64:
if _e.anims.len() == 0:
ret target
end
k := _anim_index(node, prop)
if k < 0:
ret target
end
a := _e.anims[k]
t := _anim_progress(a)
if t >= 1.0:
ret target
end
ret a.from_f + (target - a.from_f) * t
end
func _anims_running(): bool:
mut any := false
repeat _e.anims.len() in i:
a := _e.anims[i]
if not a.done:
if (_now() - a.start) as f64 >= a.delay + a.duration:
mut ak := _e.anims.ref(i)
ak.done = true
_damage_node(a.node)
else:
any = true
_damage_node(a.node)
end
end
end
if not any and _e.anims.len() > 0:
_free_anims()
end
ret any
end
func _free_anims():
repeat _e.anims.len() in i:
mut a := _e.anims.ref(i)
a.from_x.free()
a.to_x.free()
end
_e.anims.clear()
end
func _xf_changed(a: css.ComputedStyle, b: css.ComputedStyle): bool:
mut fa := Vector {} as Vector<css.TransformFn>
mut fb := Vector {} as Vector<css.TransformFn>
defer fa.free()
defer fb.free()
_fns_of(a, fa)
_fns_of(b, fb)
if fa.len() != fb.len():
ret true
end
repeat fa.len() in i:
x := fa[i]
y := fb[i]
if x.kind != y.kind or x.a != y.a or x.b != y.b or x.c != y.c or x.d != y.d or x.e != y.e or x.f != y.f or x.x.px != y.x.px or x.x.pct != y.x.pct or x.y.px != y.y.px or x.y.pct != y.y.pct:
ret true
end
end
ret false
end
func _xf_current_fns(node: int, old: css.ComputedStyle, out &: Vector<css.TransformFn>):
k := _anim_index(node, 3)
if k >= 0:
a := _e.anims[k]
t := _anim_progress(a)
if t < 1.0 and _same_kinds(a.from_x, a.to_x):
n := math.MaxI(a.from_x.len(), a.to_x.len())
repeat n in i:
to_f := i < a.to_x.len() ? a.to_x[i] : _ident_fn(a.from_x[i].kind)
from_f := i < a.from_x.len() ? a.from_x[i] : _ident_fn(a.to_x[i].kind)
out.push(_mix_fn(from_f, to_f, t))
end
ret
end
end
_fns_of(old, out)
end
