mut remf := nmtf
mut gs := 0
until npart > 0:
tf := remf / npart
mut ge := gs - 1
mut af := 0
until af < tf and ge < alpha - 1:
ge++
af += gf[ge]
end
if ge > gs and npart != ng and npart != 1 and ((ng - npart) % 2) == 1:
af -= gf[ge]
ge--
end
repeat alpha in v:
if v >= gs and v <= ge:
lens[(npart - 1) * 258 + v] = 0
else:
lens[(npart - 1) * 258 + v] = 15
end
end
npart--
gs = ge + 1
remf -= af
end
mut sels: u8[18100]
mut nsel := 0
