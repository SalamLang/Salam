func _gg_edge(pr: f32*, rc: int, px: f32*, xc: int, py: f32*, yc: int, i0: int, i1: int, j0: int, j1: int, kn: int):
mut i := i0
until i < i1:
xrow := _p32(px, i * xc)
crow := _p32(pr, i * rc)
mut j := j0
until j < j1:
mut acc := 0.0 as f32
repeat kn in k: acc += xrow[k] * py[k * yc + j] end
crow[j] += acc
j++
end
i++
end
end
func _gemm_acc(px: f32*, py: f32*, pr: f32*, n: int, kn: int, m: int):
if n <= 0 or m <= 0 or kn <= 0: ret end
nfull := (n / _MR) * _MR
mfull := (m / _NR) * _NR
if nfull == 0 or mfull == 0:
_gg_edge(pr, m, px, kn, py, m, nfull, n, 0, mfull, kn)
_gg_edge(pr, m, px, kn, py, m, 0, n, mfull, m, kn)
ret
end
kcap := _gmin(_KC, kn)
bpack := mem.Allocate(((_gmin(_NC, mfull) * kcap) as u64) * (sizeof(f32) as u64)) as f32*
defer mem.Free(bpack as void*)
apack := mem.Allocate(((_gmin((_MC / _MR) * _MR, nfull) * kcap) as u64) * (sizeof(f32) as u64)) as f32*
defer mem.Free(apack as void*)
mut j0 := 0
until j0 < mfull:
nc := _gmin(_NC, mfull - j0)
ncblk := nc / _NR
mut p0 := 0
until p0 < kn:
kc := _gmin(_KC, kn - p0)
repeat ncblk in jb:
_gg_pack_b(py, m, p0, p0 + kc, j0 + jb * _NR, _p32(bpack, jb * kc * _NR))
end
mut i0 := 0
until i0 < nfull:
mcap := (_MC / _MR) * _MR
ic := _gmin(mcap, nfull - i0)
mut ip := 0
until ip < ic:
_gg_pack_a(px, kn, i0 + ip, p0, kc, _p32(apack, ip * kc))
ip += _MR
end
repeat ncblk in jb:
j := j0 + jb * _NR
bp := _p32(bpack, jb * kc * _NR)
mut ii := 0
until ii < ic:
i := i0 + ii
_gg_micro(
_p32(apack, ii * kc), bp, kc as i64, _p32(pr, i * m + j), _p32(pr, (i + 1) * m + j), _p32(pr, (i + 2) * m + j),
_p32(pr, (i + 3) * m + j)
)
ii += _MR
end
end
i0 += _MC
end
p0 += _KC
end
j0 += _NC
end
_gg_edge(pr, m, px, kn, py, m, nfull, n, 0, mfull, kn)
_gg_edge(pr, m, px, kn, py, m, 0, n, mfull, m, kn)
end
func _transpose2d_into(px: f32*, n: int, m: int, pr: f32*):
mut i0 := 0
until i0 < n:
i1 := _gmin(i0 + _T_BLOCK, n)
mut j0 := 0
until j0 < m:
j1 := _gmin(j0 + _T_BLOCK, m)
mut i := i0
until i < i1:
xo := i * m
mut j := j0
until j < j1:
pr[j * n + i] = px[xo + j]
j++
end
i++
end
j0 += _T_BLOCK
end
i0 += _T_BLOCK
end
end
func _is_mat(x &: Tensor): bool: ret x.rank() == 2 and x.is_empty() == false end
@en "Transpose2D"
@fa "ترانهاده دوبعدی"
pub func Transpose2D(x &: Tensor): Tensor:
if _is_mat(x) == false: ret Empty() end
n := x.shape.get(0)
m := x.shape.get(1)
t := Zeros2(m, n)
_transpose2d_into(x.data.data, n, m, t.data.data)
ret t
end
@en "MatMul"
@fa "ضرب ماتریسی"
pub func MatMul(x &: Tensor, y &: Tensor): Tensor:
if _is_mat(x) == false or _is_mat(y) == false: ret Empty() end
if x.shape.get(1) != y.shape.get(0): ret Empty() end
n := x.shape.get(0)
kn := x.shape.get(1)
m := y.shape.get(1)
t := Zeros2(n, m)
_par_gemm(x.data.data, y.data.data, t.data.data, n, kn, m)
ret t
end
@en "MatMulInto"
@fa "ضرب ماتریسی در"
pub func MatMulInto(x &: Tensor, y &: Tensor, out &: Tensor): bool:
if _is_mat(x) == false or _is_mat(y) == false or out.rank() != 2: ret false end
if x.shape.get(1) != y.shape.get(0): ret false end
n := x.shape.get(0)
m := y.shape.get(1)
if out.shape.get(0) != n or out.shape.get(1) != m: ret false end
pz := out.data.data
zero := 0.0 as f32
repeat n * m in i: pz[i] = zero end
_par_gemm(x.data.data, y.data.data, pz, n, x.shape.get(1), m)
ret true
end
@en "MatMulAcc"
@fa "ضرب ماتریسی انباشته"
pub func MatMulAcc(x &: Tensor, y &: Tensor, out &: Tensor): bool:
if _is_mat(x) == false or _is_mat(y) == false or out.rank() != 2: ret false end
if x.shape.get(1) != y.shape.get(0): ret false end
n := x.shape.get(0)
m := y.shape.get(1)
if out.shape.get(0) != n or out.shape.get(1) != m: ret false end
_par_gemm(x.data.data, y.data.data, out.data.data, n, x.shape.get(1), m)
ret true
end
@en "TransposeMul"
@fa "ضرب ترانهاده"
pub func TransposeMul(x &: Tensor, y &: Tensor): Tensor:
if _is_mat(x) == false or _is_mat(y) == false: ret Empty() end
if x.shape.get(0) != y.shape.get(0): ret Empty() end
mut t := Transpose2D(x)
r := MatMul(t, y)
defer t.free()
ret r
end
@en "MulTranspose"
@fa "ضرب در ترانهاده"
pub func MulTranspose(x &: Tensor, y &: Tensor): Tensor:
if _is_mat(x) == false or _is_mat(y) == false: ret Empty() end
if x.shape.get(1) != y.shape.get(1): ret Empty() end
mut t := Transpose2D(y)
r := MatMul(x, t)
defer t.free()
ret r
end
@en "BatchMatMul"
@fa "ضرب ماتریسی دسته‌ای"
pub func BatchMatMul(x &: Tensor, y &: Tensor): Tensor:
if x.rank() != 3 or y.rank() != 3: ret Empty() end
if x.shape.get(0) != y.shape.get(0): ret Empty() end
if x.shape.get(2) != y.shape.get(1): ret Empty() end
b := x.shape.get(0)
n := x.shape.get(1)
kn := x.shape.get(2)
m := y.shape.get(2)
t := Zeros3(b, n, m)
_par_batch_gemm(x.data.data, y.data.data, t.data.data, b, n, kn, m)
ret t
end
@en "MatVec"
@fa "ضرب در بردار"
pub func MatVec(a &: Tensor, x &: Tensor): Tensor:
if _is_mat(a) == false or x.rank() != 1: ret Empty() end
if a.shape.get(1) != x.shape.get(0): ret Empty() end
n := a.shape.get(0)
kn := a.shape.get(1)
t := Zeros1(n)
pa := a.data.data
pv := x.data.data
pr := t.data.data
repeat n in i:
row := _p32(pa, i * kn)
mut s := 0.0 as f32
repeat kn in k: s += row[k] * pv[k] end
pr[i] = s
end
ret t
end
@en "TransposeRaw"
@fa "ترانهاده خام"
pub func TransposeRaw(px: f32*, n: int, m: int): Tensor:
t := Zeros2(m, n)
_transpose2d_into(px, n, m, t.data.data)
ret t
end
@en "GemmAcc"
@fa "ضرب انباشته خام"
pub func GemmAcc(px: f32*, py: f32*, pr: f32*, n: int, k: int, m: int):
_gemm_acc(px, py, pr, n, k, m)
end
@en "Dot"
@fa "ضرب داخلی"
pub func Dot(x &: Tensor, y &: Tensor): f64:
if x.rank() != 1 or y.rank() != 1: ret 0.0 end
n := x.shape.get(0)
if n != y.shape.get(0): ret 0.0 end
p := x.data.data
q := y.data.data
mut s := 0.0
repeat n in k: s += (p[k] as f64) * (q[k] as f64) end
ret s
end
package tensor
func _bstrides(x &: Tensor, rank: int, out &: Vector<int>):
out.clear()
xr := x.rank()
mut own := Vector {} as Vector<int>
repeat xr: own.push(0) end
mut s := 1
mut i := xr - 1
until i >= 0:
own.set(i, s)
s *= x.shape.get(i)
i--
end
repeat rank in d:
xi := d - (rank - xr)
if xi < 0 or x.shape.get(xi) == 1:
out.push(0)
else:
out.push(own.get(xi))
end
end
own.free()
end
func _can_expand(x &: Tensor, shape &: Vector<int>): bool:
r := shape.len()
xr := x.rank()
if xr > r: ret false end
repeat xr in i:
d := x.shape.get(i)
if d != 1 and d != shape.get(i + r - xr): ret false end
end
ret true
end
func _cmp(a &: Tensor, b &: Tensor, op: int): Tensor:
mut shape := Vector {} as Vector<int>
if not BroadcastShape(a, b, shape):
shape.free()
ret Empty()
end
mut ea := Expand(a, shape)
mut eb := Expand(b, shape)
out := Zeros(shape)
shape.free()
n := out.numel()
pa := ea.data.data
pb := eb.data.data
po := out.data.data
one := 1.0 as f32
if op == 0:
repeat n in k: if pa[k] > pb[k]: po[k] = one end end
else op == 1:
repeat n in k: if pa[k] >= pb[k]: po[k] = one end end
else op == 2:
repeat n in k: if pa[k] < pb[k]: po[k] = one end end
else op == 3:
repeat n in k: if pa[k] <= pb[k]: po[k] = one end end
else op == 4:
repeat n in k: if pa[k] == pb[k]: po[k] = one end end
else:
repeat n in k: if pa[k] != pb[k]: po[k] = one end end
end
ea.free()
eb.free()
ret out
end
func _cmp_scalar(x &: Tensor, s: f64, op: int): Tensor:
mut t := Scalar(s)
out := _cmp(x, t, op)
t.free()
ret out
end
func _split_axis(x &: Tensor, axis: int, outer &: int, inner &: int):
outer = 1
inner = 1
repeat x.rank() in i:
if i < axis: outer = outer * x.shape.get(i)
else i > axis: inner = inner * x.shape.get(i) end
end
end
func _tri(x &: Tensor, diagonal: int, lower: bool): Tensor:
if x.rank() < 2: ret Empty() end
cols := x.shape.get(x.rank() - 1)
rows := x.shape.get(x.rank() - 2)
planes := x.numel() / (rows * cols)
out := Clone(x)
po := out.data.data
zero := 0.0 as f32
repeat planes in p:
base := p * rows * cols
repeat rows in i:
repeat cols in j:
keep := lower ? j <= i + diagonal : j >= i + diagonal
if not keep: po[base + i * cols + j] = zero end
end
end
end
ret out
end
@en "BroadcastShape"
@fa "شکل پخش"
pub func BroadcastShape(a &: Tensor, b &: Tensor, out &: Vector<int>): bool:
out.clear()
ra := a.rank()
rb := b.rank()
r := ra > rb ? ra : rb
repeat r in i:
ia := i - (r - ra)
ib := i - (r - rb)
da := ia < 0 ? 1 : a.shape.get(ia)
db := ib < 0 ? 1 : b.shape.get(ib)
if da != db and da != 1 and db != 1:
out.clear()
ret false
end
out.push(da == 1 ? db : da)
end
ret true
end
@en "Expand"
@fa "گسترش"
pub func Expand(x &: Tensor, shape &: Vector<int>): Tensor:
if x.is_empty() or not _can_expand(x, shape): ret Empty() end
r := shape.len()
mut st := Vector {} as Vector<int>
_bstrides(x, r, st)
out := Zeros(shape)
n := out.numel()
px := x.data.data
po := out.data.data
mut idx := Vector {} as Vector<int>
repeat r: idx.push(0) end
mut off := 0
repeat n in k:
po[k] = px[off]
mut d := r - 1
mut carry := true
until carry and d >= 0:
idx.set(d, idx.get(d) + 1)
off += st.get(d)
if idx.get(d) < shape.get(d):
carry = false
else:
off -= st.get(d) * shape.get(d)
idx.set(d, 0)
d--
end
end
end
idx.free()
st.free()
ret out
end
@en "Greater"
@fa "بزرگتر"
pub func Greater(a &: Tensor, b &: Tensor): Tensor: ret _cmp(a, b, 0) end
@en "GreaterEqual"
@fa "بزرگتر مساوی"
pub func GreaterEqual(a &: Tensor, b &: Tensor): Tensor: ret _cmp(a, b, 1) end
@en "Less"
@fa "کوچکتر"
pub func Less(a &: Tensor, b &: Tensor): Tensor: ret _cmp(a, b, 2) end
@en "LessEqual"
@fa "کوچکتر مساوی"
pub func LessEqual(a &: Tensor, b &: Tensor): Tensor: ret _cmp(a, b, 3) end
@en "EqualMask"
@fa "ماسک برابری"
pub func EqualMask(a &: Tensor, b &: Tensor): Tensor: ret _cmp(a, b, 4) end
@en "NotEqualMask"
@fa "ماسک نابرابری"
pub func NotEqualMask(a &: Tensor, b &: Tensor): Tensor: ret _cmp(a, b, 5) end
@en "GreaterScalar"
@fa "بزرگتر از عدد"
pub func GreaterScalar(x &: Tensor, s: f64): Tensor: ret _cmp_scalar(x, s, 0) end
@en "LessScalar"
@fa "کوچکتر از عدد"
pub func LessScalar(x &: Tensor, s: f64): Tensor: ret _cmp_scalar(x, s, 2) end
@en "EqualScalar"
@fa "یکسان با عدد"
pub func EqualScalar(x &: Tensor, s: f64): Tensor: ret _cmp_scalar(x, s, 4) end
@en "Where"
@fa "کجا"
pub func Where(cond &: Tensor, a &: Tensor, b &: Tensor): Tensor:
mut s1 := Vector {} as Vector<int>
if not BroadcastShape(cond, a, s1):
s1.free()
ret Empty()
end
mut tmp := Zeros(s1)
mut shape := Vector {} as Vector<int>
ok := BroadcastShape(tmp, b, shape)
tmp.free()
s1.free()
if not ok:
shape.free()
ret Empty()
end
mut ec := Expand(cond, shape)
mut ea := Expand(a, shape)
mut eb := Expand(b, shape)
out := Zeros(shape)
shape.free()
n := out.numel()
pc := ec.data.data
pa := ea.data.data
pb := eb.data.data
po := out.data.data
zero := 0.0 as f32
repeat n in k: po[k] = pc[k] != zero ? pa[k] : pb[k] end
ec.free()
ea.free()
eb.free()
ret out
end
@en "MaskedFill"
@fa "پرکردن ماسک‌شده"
pub func MaskedFill(x &: Tensor, mask &: Tensor, value: f64): Tensor:
mut em := Expand(mask, x.shape)
if em.is_empty(): ret Empty() end
out := Clone(x)
n := out.numel()
pm := em.data.data
po := out.data.data
v := value as f32
zero := 0.0 as f32
repeat n in k: if pm[k] != zero: po[k] = v end end
em.free()
ret out
end
@en "IndexSelect"
@fa "انتخاب نمایه"
pub func IndexSelect(x &: Tensor, axis: int, ids &: Vector<int>): Tensor:
if x.is_empty() or axis < 0 or axis >= x.rank(): ret Empty() end
len := x.shape.get(axis)
repeat ids.len() in i:
if ids.get(i) < 0 or ids.get(i) >= len: ret Empty() end
end
mut outer := 1
mut inner := 1
_split_axis(x, axis, outer, inner)
mut shape := Vector {} as Vector<int>
repeat x.rank() in i: shape.push(i == axis ? ids.len() : x.shape.get(i)) end
out := Zeros(shape)
shape.free()
m := ids.len()
px := x.data.data
po := out.data.data
repeat outer in o:
repeat m in t:
src := (o * len + ids.get(t)) * inner
dst := (o * m + t) * inner
repeat inner in k: po[dst + k] = px[src + k] end
end
end
ret out
end
@en "TakeRows"
@fa "گرفتن ردیف‌ها"
pub func TakeRows(x &: Tensor, ids &: Vector<int>): Tensor: ret IndexSelect(x, 0, ids) end
@en "Gather"
@fa "گردآوری"
pub func Gather(x &: Tensor, axis: int, idx &: Tensor): Tensor:
if x.is_empty() or idx.is_empty() or axis < 0 or axis >= x.rank() or idx.rank() != x.rank(): ret Empty() end
repeat x.rank() in i:
if i != axis and idx.shape.get(i) != x.shape.get(i): ret Empty() end
end
mut outer := 1
mut inner := 1
_split_axis(x, axis, outer, inner)
lx := x.shape.get(axis)
li := idx.shape.get(axis)
out := Zeros(idx.shape)
px := x.data.data
pi := idx.data.data
po := out.data.data
repeat outer in o:
repeat li in j:
repeat inner in k:
at := (o * li + j) * inner + k
mut id := pi[at] as int
if id < 0: id = 0 end
if id >= lx: id = lx - 1 end
po[at] = px[(o * lx + id) * inner + k]
end
end
end
ret out
end
@en "ScatterAddRows"
@fa "پراکندن جمعی ردیف‌ها"
pub func ScatterAddRows(dst &: Tensor, ids &: Vector<int>, src &: Tensor): bool:
if dst.rank() != 2 or src.rank() != 2 or src.dim(1) != dst.dim(1) or src.dim(0) != ids.len(): ret false end
w := dst.dim(1)
rows := dst.dim(0)
pd := dst.data.data
ps := src.data.data
repeat ids.len() in i:
r := ids.get(i)
if r < 0 or r >= rows: continue end
repeat w in k: pd[r * w + k] += ps[i * w + k] end
end
ret true
end
@en "OneHot"
@fa "یک‌داغ"
pub func OneHot(ids &: Vector<int>, classes: int): Tensor:
n := ids.len()
out := Zeros2(n, classes)
po := out.data.data
one := 1.0 as f32
repeat n in i:
c := ids.get(i)
if c >= 0 and c < classes: po[i * classes + c] = one end
end
ret out
end
@en "TopK"
@fa "کِی برتر"
pub func TopK(x &: Tensor, k: int, largest: bool, idx_out &: Tensor): Tensor:
if x.is_empty() or k < 1: ret Empty() end
width := x.shape.get(x.rank() - 1)
if k > width: ret Empty() end
rows := x.numel() / width
mut shape := Vector {} as Vector<int>
repeat x.rank() in i: shape.push(i == x.rank() - 1 ? k : x.shape.get(i)) end
out := Zeros(shape)
idx_out.free()
idx_out = Zeros(shape)
shape.free()
px := x.data.data
po := out.data.data
pi := idx_out.data.data
repeat rows in r:
base := r * width
obase := r * k
mut taken := Vector {} as Vector<bool>
repeat width: taken.push(false) end
repeat k in t:
mut best := 0 - 1
repeat width in c:
if taken.get(c): continue end
if best < 0: best = c
else largest and px[base + c] > px[base + best]: best = c
else not largest and px[base + c] < px[base + best]: best = c end
end
taken.set(best, true)
po[obase + t] = px[base + best]
pi[obase + t] = best as f32
end
taken.free()
end
ret out
end
@en "Tril"
@fa "مثلث پایین"
pub func Tril(x &: Tensor, diagonal: int): Tensor: ret _tri(x, diagonal, true) end
@en "Triu"
@fa "مثلث بالا"
pub func Triu(x &: Tensor, diagonal: int): Tensor: ret _tri(x, diagonal, false) end
@en "Cumsum"
@fa "جمع تجمعی"
pub func Cumsum(x &: Tensor, axis: int): Tensor:
if x.is_empty() or axis < 0 or axis >= x.rank(): ret Empty() end
mut outer := 1
mut inner := 1
_split_axis(x, axis, outer, inner)
len := x.shape.get(axis)
out := Clone(x)
po := out.data.data
repeat outer in o:
repeat inner in i:
mut acc := 0.0 as f32
repeat len in t:
at := (o * len + t) * inner + i
acc += po[at]
po[at] = acc
end
end
end
ret out
end
package tensor
import compress
import encoding.binary
import mem
import str
const _TSR_DTYPE_F32 := 1
func _tsr_err(kind: ErrorKind, msg: str, at: int, code: str): Error:
ret Error.At(kind, msg, at).with_code(code)
end
func _read_shape(rd &: compress.ByteReader, shape &: Vector<int>): i64 throws:
dtype := try binary.ReadU8(rd)
r := try binary.ReadU8(rd)
if dtype != _TSR_DTYPE_F32: throw _tsr_err(ErrorKind.Unsupported, "unsupported dtype " + dtype + " (only f32)", rd.pos - 2, "tensor.dtype") end
if r <= 0: throw _tsr_err(ErrorKind.Syntax, "rank 0", rd.pos - 1, "tensor.rank") end
mut n := 1 as i64
repeat r:
d := try binary.ReadU32LE(rd)
if d < 0: throw _tsr_err(ErrorKind.OutOfRange, "dimension too large", rd.pos - 4, "tensor.size") end
shape.push(d)
n *= (d as i64)
end
nbytes := try binary.ReadU64LE(rd)
if nbytes != n * 4:
throw _tsr_err(ErrorKind.Syntax, "the data size " + nbytes + " does not match the shape (" + (n * 4) + " bytes)", rd.pos - 8, "tensor.size")
end
if (compress.RdLeft(rd) as i64) < nbytes:
throw _tsr_err(ErrorKind.UnexpectedEnd, "the data needs " + nbytes + " bytes, " + compress.RdLeft(rd) + " left", rd.pos, "tensor.truncated")
end
ret nbytes
end
func _read_name(rd &: compress.ByteReader): str throws:
start := rd.pos
nl := try binary.ReadU16LE(rd)
if nl <= 0: throw _tsr_err(ErrorKind.Syntax, "empty tensor name", start, "tensor.bad_name") end
if compress.RdLeft(rd) < nl:
throw _tsr_err(ErrorKind.UnexpectedEnd, "the name needs " + nl + " bytes, " + compress.RdLeft(rd) + " left", rd.pos, "tensor.truncated")
end
mut nb := compress.RdBytes(rd, nl)
name := compress.BufToStrUnsafe(nb)
compress.BufFree(nb)
ret name
end
@en "WriteTensor"
@fa "نوشتن تانسور"
pub func WriteTensor(buf &: compress.ByteBuf, name: str, t &: Tensor): bool:
nl := str.Len(name)
if nl <= 0 or nl > 65535: ret false end
if t.is_empty(): ret false end
r := t.rank()
if r > 255: ret false end
binary.WriteU16LE(buf, nl)
compress.BufPushBytes(buf, name as void*, nl)
binary.WriteU8(buf, _TSR_DTYPE_F32)
binary.WriteU8(buf, r)
repeat r in i: binary.WriteU32LE(buf, t.shape.get(i)) end
n := t.numel()
binary.WriteU64LE(buf, (n as i64) * 4)
compress.BufPushBytes(buf, t.data.data as void*, n * 4)
ret true
end
@en "ReadTensor"
@fa "خواندن تانسور"
pub func ReadTensor(rd &: compress.ByteReader, name_out &: str, out &: Tensor) throws:
mut name := ""
try:
name = _read_name(rd)
catch e:
throw e.wrap("tensor")
end
mut shape := Vector {} as Vector<int>
defer shape.free()
mut nbytes := 0 as i64
try:
nbytes = _read_shape(rd, shape)
catch e:
mem.Free(name as void*)
throw e.wrap("tensor")
end
out.free()
t := _raw(shape)
src := ((rd.data as i64) + (rd.pos as i64)) as void*
mem.Copy(t.data.data as void*, src, nbytes as u64)
rd.pos += nbytes as int
out = t
name_out = name
end
package tensor
import pool
const _EW_CHUNK := 65536
const _EW_MIN := 262144
const _GM_MIN_FLOPS := 32000000.0
mut _tsr_threads := 0
mut _ew_pa := null as f32*
mut _ew_pb := null as f32*
mut _ew_pr := null as f32*
mut _ew_n := 0
mut _ew_op := 0
mut _gm_px := null as f32*
mut _gm_py := null as f32*
mut _gm_pr := null as f32*
mut _gm_n := 0
mut _gm_k := 0
mut _gm_m := 0
mut _gm_band := 0
mut _bm_px := null as f32*
mut _bm_py := null as f32*
mut _bm_pr := null as f32*
mut _bm_n := 0
mut _bm_k := 0
mut _bm_m := 0
func _ew_zip_worker(t: i64):
off := (t as int) * _EW_CHUNK
mut cnt := _ew_n - off
if cnt > _EW_CHUNK: cnt = _EW_CHUNK end
_k_same(_p32(_ew_pa, off), _p32(_ew_pb, off), _p32(_ew_pr, off), cnt, _ew_op)
end
func _ew_map_worker(t: i64):
off := (t as int) * _EW_CHUNK
mut cnt := _ew_n - off
if cnt > _EW_CHUNK: cnt = _EW_CHUNK end
_u_range(_p32(_ew_pa, off), _p32(_ew_pr, off), cnt, _ew_op)
end
func _gm_worker(t: i64):
start := (t as int) * _gm_band
mut rows := _gm_n - start
if rows > _gm_band: rows = _gm_band end
if rows <= 0: ret end
_gemm_acc(_p32(_gm_px, start * _gm_k), _gm_py, _p32(_gm_pr, start * _gm_m), rows, _gm_k, _gm_m)
end
func _bm_worker(t: i64):
i := t as int
_gemm_acc(
_p32(_bm_px, i * _bm_n * _bm_k), _p32(_bm_py, i * _bm_k * _bm_m), _p32(_bm_pr, i * _bm_n * _bm_m),
_bm_n, _bm_k, _bm_m
)
end
func _par_zip(pa: f32*, pb: f32*, pr: f32*, n: int, op: int):
if n < _EW_MIN or Threads() <= 1:
_k_same(pa, pb, pr, n, op)
ret
end
_ew_pa = pa
_ew_pb = pb
_ew_pr = pr
_ew_n = n
_ew_op = op
chunks := (n + _EW_CHUNK - 1) / _EW_CHUNK
pool.ParallelFor(chunks as i64, Threads() as i64, (i: i64): _ew_zip_worker(i) end)
end
func _par_map(pa: f32*, pr: f32*, n: int, op: int):
if n < _EW_MIN or Threads() <= 1:
_u_range(pa, pr, n, op)
ret
end
_ew_pa = pa
_ew_pr = pr
_ew_n = n
_ew_op = op
chunks := (n + _EW_CHUNK - 1) / _EW_CHUNK
pool.ParallelFor(chunks as i64, Threads() as i64, (i: i64): _ew_map_worker(i) end)
end
func _par_gemm(px: f32*, py: f32*, pr: f32*, n: int, kn: int, m: int):
t := Threads()
flops := 2.0 * (n as f64) * (kn as f64) * (m as f64)
if t <= 1 or flops < _GM_MIN_FLOPS or n < 2 * _MR:
_gemm_acc(px, py, pr, n, kn, m)
ret
end
mut band := (n + t - 1) / t
band = ((band + _MR - 1) / _MR) * _MR
bands := (n + band - 1) / band
_gm_px = px
_gm_py = py
_gm_pr = pr
_gm_n = n
_gm_k = kn
_gm_m = m
_gm_band = band
pool.ParallelFor(bands as i64, t as i64, (i: i64): _gm_worker(i) end)
end
func _par_batch_gemm(px: f32*, py: f32*, pr: f32*, b: int, n: int, kn: int, m: int):
t := Threads()
if t <= 1 or b < 2:
repeat b in i:
_par_gemm(_p32(px, i * n * kn), _p32(py, i * kn * m), _p32(pr, i * n * m), n, kn, m)
end
ret
end
if b < t:
repeat b in i:
_par_gemm(_p32(px, i * n * kn), _p32(py, i * kn * m), _p32(pr, i * n * m), n, kn, m)
end
ret
end
_bm_px = px
_bm_py = py
_bm_pr = pr
_bm_n = n
_bm_k = kn
_bm_m = m
pool.ParallelFor(b as i64, t as i64, (i: i64): _bm_worker(i) end)
end
@en "SetThreads"
@fa "تنظیم نخ‌ها"
pub func SetThreads(n: int): _tsr_threads = n end
@en "Threads"
@fa "نخ‌ها"
pub func Threads(): int:
if _tsr_threads > 0: ret _tsr_threads end
c := pool.CPUCount() as int
if c > 8: ret 8 end
ret c
end
package tensor
import math
const _RNG_MULT := 2685821657736338717 as u64
const _RNG_ODD := 1442695040888963407 as u64
@en "Rng"
@fa "مولد تصادفی"
pub struct Rng:
@en "s"
@fa "حالت داخلی"
pub s: u64 = 0
@en "next_bits"
@fa "بیت بعدی"
pub func next_bits(): u64:
mut x := this.s
x ^= (x >> 12)
x ^= (x << 25)
x ^= (x >> 27)
this.s = x
ret x * _RNG_MULT
end
@en "next_float"
@fa "اعشاری بعدی"
pub func next_float(): f64:
v := this.next_bits() >> 11
ret (v as f64) / 9007199254740992.0
end
@en "next_normal"
@fa "نرمال بعدی"
pub func next_normal(): f64:
mut u := this.next_float()
if u <= 0.0: u = 1.0e-15 end
v := this.next_float()
ret math.Sqrt(0.0 - 2.0 * math.Log(u)) * math.Cos(6.283185307179586 * v)
end
end
@en "NewRng"
@fa "مولد تصادفی جدید"
pub func NewRng(seed: i64): Rng:
mut g := Rng {}
g.s = (seed as u64) + _RNG_ODD
if g.s == 0: g.s = _RNG_ODD end
ret g
end
@en "DeriveSeed"
@fa "بذر مشتق"
pub func DeriveSeed(seed: i64, index: i64): i64:
ret seed + (0 - 7046029254386353131) * (index + 1)
end
@en "FillUniform"
@fa "پر کردن یکنواخت"
pub func FillUniform(t &: Tensor, lo: f64, hi: f64, g &: Rng):
n := t.data.len()
p := t.data.data
repeat n in k: p[k] = (lo + (hi - lo) * g.next_float()) as f32 end
end
@en "FillNormal"
@fa "پر کردن نرمال"
pub func FillNormal(t &: Tensor, mean: f64, std: f64, g &: Rng):
n := t.data.len()
p := t.data.data
repeat n in k: p[k] = (mean + std * g.next_normal()) as f32 end
end
@en "FillBernoulli"
@fa "پر کردن برنولی"
pub func FillBernoulli(t &: Tensor, p: f64, g &: Rng):
n := t.data.len()
d := t.data.data
one := 1.0 as f32
zero := 0.0 as f32
repeat n in k:
mut v := zero
if g.next_float() < p: v = one end
d[k] = v
end
end
@en "RandUniform"
@fa "تصادفی یکنواخت"
pub func RandUniform(shape &: Vector<int>, lo: f64, hi: f64, seed: i64): Tensor:
mut t := _raw(shape)
mut g := NewRng(seed)
FillUniform(t, lo, hi, g)
ret t
end
@en "RandNormal"
@fa "تصادفی نرمال"
pub func RandNormal(shape &: Vector<int>, seed: i64): Tensor:
mut t := _raw(shape)
mut g := NewRng(seed)
FillNormal(t, 0.0, 1.0, g)
ret t
end
package tensor
func _reduced_shape(x &: Tensor, axis: int, keepdim: bool): Vector<int>:
mut s := Vector {} as Vector<int>
repeat x.rank() in i:
if i == axis:
if keepdim: s.push(1) end
else:
s.push(x.shape.get(i))
end
end
if s.len() == 0: s.push(1) end
ret s
end
func _axis_ok(x &: Tensor, axis: int): bool:
if x.is_empty(): ret false end
ret axis >= 0 and axis < x.rank()
end
@en "SumAll"
@fa "مجموع همه"
pub func SumAll(x &: Tensor): f64:
n := x.data.len()
p := x.data.data
mut s := 0.0
repeat n in k: s += p[k] as f64 end
ret s
end
@en "MeanAll"
@fa "میانگین همه"
pub func MeanAll(x &: Tensor): f64:
n := x.data.len()
if n <= 0: ret 0.0 end
ret SumAll(x) / (n as f64)
end
@en "MaxAll"
@fa "بیشینه همه"
pub func MaxAll(x &: Tensor): f64:
n := x.data.len()
if n <= 0: ret 0.0 end
p := x.data.data
mut best := p[0]
repeat n in k:
v := p[k]
if v > best: best = v end
end
ret best as f64
end
@en "MinAll"
@fa "کمینه همه"
pub func MinAll(x &: Tensor): f64:
n := x.data.len()
if n <= 0: ret 0.0 end
p := x.data.data
mut best := p[0]
repeat n in k:
v := p[k]
if v < best: best = v end
end
ret best as f64
end
@en "ArgMaxAll"
@fa "نمایه بیشینه همه"
pub func ArgMaxAll(x &: Tensor): int:
n := x.data.len()
if n <= 0: ret 0 - 1 end
p := x.data.data
mut best := p[0]
mut at_idx := 0
repeat n in k:
v := p[k]
if v > best:
best = v
at_idx = k
end
end
ret at_idx
end
@en "SumAxis"
@fa "مجموع محور"
pub func SumAxis(x &: Tensor, axis: int, keepdim: bool): Tensor:
if _axis_ok(x, axis) == false: ret Empty() end
n := x.shape.get(axis)
outer := _outer_of(x, axis)
inner := _inner_of(x, axis)
mut oshape := _reduced_shape(x, axis, keepdim)
t := Zeros(oshape)
oshape.free()
p := t.data.data
q := x.data.data
repeat outer in o:
dbase := o * inner
repeat n in i:
sbase := (o * n + i) * inner
repeat inner in k: p[dbase + k] += q[sbase + k] end
end
end
ret t
end
@en "MeanAxis"
@fa "میانگین محور"
pub func MeanAxis(x &: Tensor, axis: int, keepdim: bool): Tensor:
mut t := SumAxis(x, axis, keepdim)
if t.is_empty(): ret t end
ScaleInPlace(t, 1.0 / (x.shape.get(axis) as f64))
ret t
end
@en "MaxAxis"
@fa "بیشینه محور"
pub func MaxAxis(x &: Tensor, axis: int, keepdim: bool): Tensor:
if _axis_ok(x, axis) == false: ret Empty() end
n := x.shape.get(axis)
outer := _outer_of(x, axis)
inner := _inner_of(x, axis)
mut oshape := _reduced_shape(x, axis, keepdim)
t := _raw(oshape)
oshape.free()
p := t.data.data
q := x.data.data
repeat outer in o:
dbase := o * inner
sbase0 := o * n * inner
repeat inner in k: p[dbase + k] = q[sbase0 + k] end
repeat n - 1 in i:
sbase := (o * n + i + 1) * inner
repeat inner in k:
v := q[sbase + k]
if v > p[dbase + k]: p[dbase + k] = v end
end
end
end
ret t
end
@en "ArgMaxAxis"
@fa "نمایه بیشینه محور"
pub func ArgMaxAxis(x &: Tensor, axis: int, keepdim: bool): Tensor:
if _axis_ok(x, axis) == false: ret Empty() end
n := x.shape.get(axis)
outer := _outer_of(x, axis)
inner := _inner_of(x, axis)
mut oshape := _reduced_shape(x, axis, keepdim)
t := Zeros(oshape)
oshape.free()
p := t.data.data
q := x.data.data
repeat outer in o:
dbase := o * inner
repeat inner in k:
mut best := q[o * n * inner + k]
mut bi := 0
repeat n - 1 in i:
v := q[(o * n + i + 1) * inner + k]
if v > best:
best = v
bi = i + 1
end
end
p[dbase + k] = bi as f32
end
end
ret t
end
@en "Softmax"
@fa "بیشینه نرم"
pub func Softmax(x &: Tensor): Tensor:
if x.is_empty(): ret Empty() end
width := x.shape.get(x.rank() - 1)
rows := x.numel() / width
t := _raw_like(x)
p := t.data.data
q := x.data.data
one := 1.0 as f32
repeat rows in r:
base := r * width
mut m := q[base]
repeat width in k:
v := q[base + k]
if v > m: m = v end
end
mut s := 0.0 as f32
repeat width in k:
e := expf(q[base + k] - m)
p[base + k] = e
s += e
end
inv := one / s
repeat width in k: p[base + k] *= inv end
end
ret t
end
@en "LogSoftmax"
@fa "لگاریتم بیشینه نرم"
pub func LogSoftmax(x &: Tensor): Tensor:
if x.is_empty(): ret Empty() end
width := x.shape.get(x.rank() - 1)
rows := x.numel() / width
t := _raw_like(x)
p := t.data.data
q := x.data.data
repeat rows in r:
base := r * width
mut m := q[base]
repeat width in k:
v := q[base + k]
if v > m: m = v end
end
mut s := 0.0 as f32
repeat width in k: s += expf(q[base + k] - m) end
lse := m + logf(s)
repeat width in k: p[base + k] = q[base + k] - lse end
end
ret t
end
package tensor
func _outer_of(x &: Tensor, axis: int): int:
mut o := 1
repeat axis in i: o *= x.shape.get(i) end
ret o
end
func _inner_of(x &: Tensor, axis: int): int:
mut v := 1
r := x.rank()
repeat r - axis - 1 in i: v *= x.shape.get(axis + 1 + i) end
ret v
end
@en "Reshape"
@fa "تغییر شکل"
pub func Reshape(x &: Tensor, shape &: Vector<int>): Tensor:
mut n := 1
if shape.len() == 0: n = 0 end
repeat shape.len() in i: n *= shape.get(i) end
if n != x.numel(): ret Empty() end
mut t := Clone(x)
t.reshape_(shape)
ret t
end
@en "SqueezeInPlace"
@fa "فشردن درجا"
pub func SqueezeInPlace(x &: Tensor):
mut s := Vector {} as Vector<int>
repeat x.rank() in i:
d := x.shape.get(i)
if d != 1: s.push(d) end
end
if s.len() == 0: s.push(1) end
x.shape.free()
x.shape = s
end
@en "UnsqueezeInPlace"
@fa "گشودن درجا"
pub func UnsqueezeInPlace(x &: Tensor, axis: int):
r := x.rank()
if axis < 0 or axis > r: ret end
x.shape.insert(axis, 1)
end
@en "Permute"
@fa "جایگشت"
pub func Permute(x &: Tensor, perm &: Vector<int>): Tensor:
r := x.rank()
if perm.len() != r or r == 0: ret Empty() end
mut in_range := true
repeat r in i:
p := perm.get(i)
if p < 0 or p >= r: in_range = false end
end
if in_range == false: ret Empty() end
mut seen := Vector {} as Vector<int>
seen.zeros(r)
repeat r in i: seen.set(perm.get(i), seen.get(perm.get(i)) + 1) end
mut valid := true
repeat r in i:
if seen.get(i) != 1: valid = false end
end
seen.free()
if valid == false: ret Empty() end
mut istr := Vector {} as Vector<int>
istr.zeros(r)
mut acc := 1
repeat r in i:
d := r - 1 - i
istr.set(d, acc)
acc *= x.shape.get(d)
end
mut ostr := Vector {} as Vector<int>
ostr.zeros(r)
mut oshape := Vector {} as Vector<int>
repeat r in i:
oshape.push(x.shape.get(perm.get(i)))
ostr.set(i, istr.get(perm.get(i)))
end
t := _raw(oshape)
n := t.data.len()
if n > 0:
p := t.data.data
q := x.data.data
mut idx := Vector {} as Vector<int>
idx.zeros(r)
mut src := 0
repeat n in k:
p[k] = q[src]
mut d := r - 1
mut carrying := true
until carrying:
v := idx.get(d) + 1
if v < oshape.get(d):
idx.set(d, v)
src += ostr.get(d)
carrying = false
else:
src -= idx.get(d) * ostr.get(d)
idx.set(d, 0)
if d == 0:
carrying = false
else:
d--
end
end
end
end
idx.free()
end
istr.free()
ostr.free()
oshape.free()
ret t
end
@en "SliceAxis0"
@fa "برش محور صفر"
pub func SliceAxis0(x &: Tensor, start: int, len: int): Tensor:
r := x.rank()
if r == 0: ret Empty() end
d0 := x.shape.get(0)
if start < 0 or len <= 0 or start + len > d0: ret Empty() end
mut oshape := _copy_shape(x.shape)
oshape.set(0, len)
t := _raw(oshape)
oshape.free()
inner := x.numel() / d0
n := len * inner
p := t.data.data
q := x.data.data
base := start * inner
repeat n in k: p[k] = q[base + k] end
ret t
end
@en "Narrow"
@fa "باریک‌سازی"
pub func Narrow(x &: Tensor, axis: int, start: int, len: int): Tensor:
r := x.rank()
if axis < 0 or axis >= r: ret Empty() end
if axis == 0: ret SliceAxis0(x, start, len) end
mid := x.shape.get(axis)
if start < 0 or len <= 0 or start + len > mid: ret Empty() end
outer := _outer_of(x, axis)
inner := _inner_of(x, axis)
mut oshape := _copy_shape(x.shape)
oshape.set(axis, len)
t := _raw(oshape)
oshape.free()
p := t.data.data
q := x.data.data
block := len * inner
repeat outer in o:
sbase := (o * mid + start) * inner
dbase := o * block
repeat block in k: p[dbase + k] = q[sbase + k] end
end
ret t
end
@en "Concat2"
@fa "پیوند دو"
pub func Concat2(a &: Tensor, b &: Tensor, axis: int): Tensor:
r := a.rank()
if r == 0 or b.rank() != r or axis < 0 or axis >= r: ret Empty() end
repeat r in i:
if i != axis and a.shape.get(i) != b.shape.get(i): ret Empty() end
end
ma := a.shape.get(axis)
mb := b.shape.get(axis)
outer := _outer_of(a, axis)
inner := _inner_of(a, axis)
mut oshape := _copy_shape(a.shape)
oshape.set(axis, ma + mb)
t := _raw(oshape)
oshape.free()
p := t.data.data
qa := a.data.data
qb := b.data.data
blocka := ma * inner
blockb := mb * inner
ostride := blocka + blockb
repeat outer in o:
dbase := o * ostride
abase := o * blocka
repeat blocka in k: p[dbase + k] = qa[abase + k] end
bbase := o * blockb
repeat blockb in k: p[dbase + blocka + k] = qb[bbase + k] end
end
ret t
end
@en "Stack2"
@fa "انباشت دو"
pub func Stack2(a &: Tensor, b &: Tensor): Tensor:
if a.same_shape(b) == false or a.rank() == 0: ret Empty() end
mut oshape := Vector {} as Vector<int>
oshape.push(2)
repeat a.rank() in i: oshape.push(a.shape.get(i)) end
t := _raw(oshape)
oshape.free()
n := a.numel()
p := t.data.data
qa := a.data.data
qb := b.data.data
repeat n in k: p[k] = qa[k] end
repeat n in k: p[n + k] = qb[k] end
ret t
end
@en "Pad2D"
@fa "لایه‌گذاری دوبعدی"
pub func Pad2D(x &: Tensor, pt: int, pb: int, pl: int, pr: int): Tensor:
r := x.rank()
if r < 2 or pt < 0 or pb < 0 or pl < 0 or pr < 0: ret Empty() end
h := x.shape.get(r - 2)
w := x.shape.get(r - 1)
oh := h + pt + pb
ow := w + pl + pr
mut oshape := _copy_shape(x.shape)
oshape.set(r - 2, oh)
oshape.set(r - 1, ow)
t := Zeros(oshape)
oshape.free()
planes := x.numel() / (h * w)
p := t.data.data
q := x.data.data
repeat planes in c:
splane := c * h * w
dplane := c * oh * ow
repeat h in i:
sbase := splane + i * w
dbase := dplane + (i + pt) * ow + pl
repeat w in k: p[dbase + k] = q[sbase + k] end
end
end
ret t
end
@en "arabic"
@fa "عربی"
package arabic
import str
import unicode
@en "FoldLetters"
@fa "یکسان سازی حروف"
pub const FoldLetters := 1
@en "StripHarakat"
@fa "حذف اعراب"
pub const StripHarakat := 2
@en "StripTatweel"
@fa "حذف کشیده"
pub const StripTatweel := 4
@en "FoldDigits"
@fa "یکسان سازی رقم ها"
pub const FoldDigits := 8
@en "FoldAlef"
@fa "یکسان سازی الف"
pub const FoldAlef := 16
@en "FoldTehMarbuta"
@fa "یکسان سازی ته گرد"
pub const FoldTehMarbuta := 32
@en "StripZWNJ"
@fa "حذف نیم فاصله"
pub const StripZWNJ := 64
@en "FoldPresentation"
@fa "یکسان سازی شکل نمایشی"
pub const FoldPresentation := 128
const _TATWEEL := 0x0640
pure func _map_cp(cp: int, flags: int): int:
if (flags / StripTatweel) % 2 == 1 and cp == _TATWEEL: ret 0 - 1 end
if (flags / StripHarakat) % 2 == 1 and IsHaraka(cp): ret 0 - 1 end
if (flags / StripHarakat) % 2 == 1 and cp == 0x06C0: ret 0x0647 end
if (flags / StripZWNJ) % 2 == 1 and cp == unicode.ZWNJ: ret 0 - 1 end
if (flags / FoldLetters) % 2 == 1:
if cp == 0x0643: ret 0x06A9 end
if cp == 0x064A: ret 0x06CC end
if cp == 0x0649: ret 0x06CC end
if cp == 0x06D2: ret 0x06CC end
if cp == 0x06D3: ret 0x06CC end
if cp == 0x06AA: ret 0x06A9 end
if cp == 0x06AB: ret 0x06A9 end
end
if (flags / FoldAlef) % 2 == 1:
if cp == 0x0622 or cp == 0x0623 or cp == 0x0625 or cp == 0x0671: ret 0x0627 end
end
if (flags / FoldTehMarbuta) % 2 == 1:
if cp == 0x0629: ret 0x0647 end
end
ret cp
end
@en "IsArabicScript"
@fa "خط عربی است"
pub pure func IsArabicScript(cp: int): bool:
if unicode.Script(cp) == unicode.ScriptArabic: ret true end
ret IsHaraka(cp)
end
@en "IsHaraka"
@fa "اعراب است"
pub pure func IsHaraka(cp: int): bool:
if cp >= 0x0610 and cp <= 0x061A: ret true end
if cp >= 0x064B and cp <= 0x065F: ret true end
if cp == 0x0670: ret true end
if cp >= 0x06D6 and cp <= 0x06DC: ret true end
if cp >= 0x06DF and cp <= 0x06E4: ret true end
if cp >= 0x06E7 and cp <= 0x06E8: ret true end
if cp >= 0x06EA and cp <= 0x06ED: ret true end
if cp >= 0x08D3 and cp <= 0x08FF: ret true end
ret false
end
@en "IsTatweel"
@fa "کشیده است"
pub inline pure func IsTatweel(cp: int): bool:
ret cp == _TATWEEL
end
@en "Normalize"
@fa "هنجارسازی"
pub func Normalize(s: str, flags: int): str:
mut subject := s
if (flags / FoldPresentation) % 2 == 1:
subject = str.NFKC(s)
end
if (flags / FoldDigits) % 2 == 1:
subject = str.ToEnglishDigits(subject)
end
mut sb := str.NewBuilder()
defer str.BufFree(sb)
n := subject.len()
mut i := 0
mut cp := 0
until i < n:
i = str.CodePointAt(subject, i, cp)
if cp < 0: cp = 0xFFFD end
out := _map_cp(cp, flags)
if out >= 0: str.BufAppendCp(sb, out) end
end
ret str.BufStr(sb)
end
@en "NormalizePersian"
@fa "هنجارسازی فارسی"
pub func NormalizePersian(s: str): str:
ret Normalize(s, FoldPresentation + FoldLetters + StripTatweel)
end
@en "SearchKey"
@fa "کلید جستجو"
pub func SearchKey(s: str): str:
folded := Normalize(
s, FoldPresentation + FoldLetters + StripHarakat + StripTatweel + FoldDigits + FoldAlef + FoldTehMarbuta + StripZWNJ
)
ret str.Lower(folded)
end
@en "EqualLoose"
@fa "یکسان تقریبی"
pub func EqualLoose(a: str, b: str): bool:
ret SearchKey(a) == SearchKey(b)
end
@en "archive"
@fa "بایگانی"
package archive
import mem
import compress
import os
extern:
func fopen(path: str, mode: str): void*
func fclose(fp: void*): int
func fread(ptr: void*, size: u64, nmemb: u64, stream: void*): u64
func fwrite(ptr: void*, size: u64, nmemb: u64, stream: void*): u64
func fseek(fp: void*, off: int, whence: int): int
func ftell(fp: void*): int
end
@en "Entry"
@fa "مدخل"
pub struct Entry:
@en "name"
@fa "نام"
pub name: str = ""
@en "size"
@fa "اندازه"
pub size: i64 = 0 as i64
@en "compressed_size"
@fa "اندازه فشرده"
pub compressed_size: i64 = 0 as i64
@en "is_dir"
@fa "پوشه"
pub is_dir: bool = false
@en "method"
@fa "روش"
pub method: int = 0
@en "crc32"
@fa "چک‌جمع"
pub crc32: u32 = 0 as u32
@en "mtime"
@fa "زمان تغییر"
pub mtime: i64 = 0 as i64
@en "link"
@fa "پیوند"
pub link: str = ""
@en "kind"
@fa "نوع"
pub kind: int = 0
@en "mode"
@fa "دسترسی"
pub mode: int = 0
end
func _safe_entry_name(name: str): bool:
n := name.len()
if n == 0:
ret false
end
bp := name as u8*
first := bp[0] as int
if first == 47 or first == 92 or (n >= 2 and (bp[1] as int) == 58):
ret false
end
mut start := 0
mut i := 0
until i <= n:
c := i < n ? bp[i] as int : 47
if c == 47 or c == 92:
if i - start == 2 and (bp[start] as int) == 46 and (bp[start + 1] as int) == 46:
ret false
end
start = i + 1
end
i++
end
ret true
end
func _decap(cap: i64): int:
if cap <= (0 as i64): ret 0 end
if cap > (2147483647 as i64): ret 2147483647 end
ret cap as int
end
@en "ReadBinaryFile"
@fa "خواندن پرونده دودویی"
pub func ReadBinaryFile(path: str, ok &: bool): compress.ByteBuf:
ok = false
fp := fopen(path, "rb")
if fp == null:
ret compress.NewByteBuf()
end
fseek(fp, 0, 2)
size := ftell(fp)
fseek(fp, 0, 0)
mut buf := compress.NewByteBufCap(size)
if size > 0:
raw := mem.Allocate(size as u64)
got := fread(raw, 1 as u64, size as u64, fp)
compress.BufPushBytes(buf, raw, got as int)
mem.Free(raw)
end
fclose(fp)
ok = true
ret buf
end
@en "WriteBinaryFile"
@fa "نوشتن پرونده دودویی"
pub func WriteBinaryFile(path: str, p: void*, n: int): bool:
fp := fopen(path, "wb")
if fp == null:
ret false
end
mut written := 0 as u64
if n > 0:
written = fwrite(p, 1 as u64, n as u64, fp)
end
fclose(fp)
ret (written as int) == n
end
@en "WriteBinaryFileBuf"
@fa "نوشتن پرونده دودویی از بافر"
pub func WriteBinaryFileBuf(path: str, b: compress.ByteBuf): bool:
ret WriteBinaryFile(path, b.data, b.len)
end
@en "EnsureDir"
@fa "اطمینان از پوشه"
pub func EnsureDir(dir: str):
if dir.len() == 0: ret end
if os.Exists(dir): ret end
os.MkdirAll(dir)
end
@en "LEGet16"
@fa "خواندن شانزده بیتی کم ارزش‌اول"
pub func LEGet16(p: void*, off: int): int:
bp := p as u8*
ret (bp[off] as int) | ((bp[off + 1] as int) << 8)
end
@en "LEGet32"
@fa "خواندن عدد۳۲ کم ارزش‌اول"
pub func LEGet32(p: void*, off: int): int:
bp := p as u8*
ret (bp[off] as int) | ((bp[off + 1] as int) << 8) | ((bp[off + 2] as int) << 16) | ((bp[off + 3] as int) << 24)
end
@en "LEPut16"
@fa "نوشتن شانزده بیتی کم ارزش‌اول"
pub func LEPut16(b &: compress.ByteBuf, v: int):
compress.BufPush(b, v & 255)
compress.BufPush(b, (v >> 8) & 255)
end
@en "LEPut32"
@fa "نوشتن عدد۳۲ کم ارزش‌اول"
pub func LEPut32(b &: compress.ByteBuf, v: int):
compress.BufPush(b, v & 255)
compress.BufPush(b, (v >> 8) & 255)
compress.BufPush(b, (v >> 16) & 255)
compress.BufPush(b, (v >> 24) & 255)
end
@en "FreeEntries"
@fa "آزادسازی فهرست"
pub func FreeEntries(v &: Vector<Entry>):
repeat v.len() in i:
nm := v.get(i).name
if nm.len() > 0: mem.Free(nm as void*) end
lk := v.get(i).link
if lk.len() > 0: mem.Free(lk as void*) end
end
v.free()
end
package archive
import compress
@en "Bzip2CompressFile"
@fa "فشرده سازی پرونده بی زیپ دو"
pub func Bzip2CompressFile(inpath: str, outpath: str): bool:
ret _cw_compress_path(inpath, outpath, _CW_BZIP2, 9)
end
@en "Bzip2CompressFileLevel"
@fa "فشرده سازی پرونده بی زیپ دو با سطح"
pub func Bzip2CompressFileLevel(inpath: str, outpath: str, level: int): bool:
mut lv := level
if lv < 1: lv = 1 end
if lv > 9: lv = 9 end
ret _cw_compress_path(inpath, outpath, _CW_BZIP2, lv)
end
@en "Bzip2DecompressFileCap"
@fa "کدگشایی پرونده بی زیپ دو با سقف"
pub func Bzip2DecompressFileCap(inpath: str, outpath: str, cap: i64): int:
mut rok := false
mut inbuf := ReadBinaryFile(inpath, rok)
if not rok:
ret ARCHIVE_IO_ERROR
end
mut why := 0
mut out := compress.Bzip2DecompressWhy(inbuf.data, inbuf.len, _decap(cap), why)
compress.BufFree(inbuf)
if why != compress.DecodeOk:
compress.BufFree(out)
ret why == compress.DecodeTooBig ? ARCHIVE_TOO_BIG : ARCHIVE_CORRUPT
end
wok := WriteBinaryFileBuf(outpath, out)
compress.BufFree(out)
ret wok ? ARCHIVE_OK : ARCHIVE_IO_ERROR
end
@en "Bzip2DecompressFile"
@fa "کدگشایی پرونده بی زیپ دو"
pub func Bzip2DecompressFile(inpath: str, outpath: str): bool:
mut rok := false
mut inbuf := ReadBinaryFile(inpath, rok)
if not rok:
ret false
end
mut bok := false
mut out := compress.Bzip2Decompress(inbuf.data, inbuf.len, bok)
compress.BufFree(inbuf)
if not bok:
compress.BufFree(out)
ret false
end
wok := WriteBinaryFileBuf(outpath, out)
compress.BufFree(out)
ret wok
end
package archive
import compress
import mem
import os
func _gz_cstr_end(h: u8*, start: int, n: int): int:
mut i := start
until i < n and (h[i] as int) != 0:
i++
end
if i >= n:
ret -1
end
ret i + 1
end
func _gz_header_len(h: u8*, n: int): int:
if n < 18 or (h[0] as int) != 0x1f or (h[1] as int) != 0x8b or (h[2] as int) != 8:
ret -1
end
flg := h[3] as int
if (flg & 0xe0) != 0:
ret -1
end
mut pos := 10
if (flg & 4) != 0:
if pos + 2 > n:
ret -1
end
pos += 2 + ((h[pos] as int) | ((h[pos + 1] as int) << 8))
end
if (flg & 8) != 0:
pos = _gz_cstr_end(h, pos, n)
end
if pos >= 0 and (flg & 16) != 0:
pos = _gz_cstr_end(h, pos, n)
end
if pos >= 0 and (flg & 2) != 0:
pos += 2
end
if pos < 0 or pos > n:
ret -1
end
ret pos
end
func _gz_to_sink(fp: void*, size: i64, sink &: compress.FileSink): int:
if size < (18 as i64):
ret ARCHIVE_CORRUPT
end
mut hn := 70000
if (hn as i64) > size: hn = size as int end
head := mem.Allocate(hn as u64)
tail := mem.Allocate(8 as u64)
got := compress.FileReadAt(fp, 0 as i64, head, hn)
got2 := compress.FileReadAt(fp, size - (8 as i64), tail, 8)
hlen := got == hn ? _gz_header_len(head as u8*, hn) : -1
mut st := ARCHIVE_OK
if got2 != 8 or hlen < 0 or (hlen as i64) >= size - (8 as i64):
st = ARCHIVE_CORRUPT
else:
mut br := compress.NewFileBitReader(fp, hlen as i64, size - (8 as i64) - (hlen as i64))
good := not br.bad and compress.RawInflateToSink(br, sink, false)
compress.FileBitReaderFree(br)
want_crc := LEGet32(tail, 0) as u32
want_size := (LEGet32(tail, 4) as i64) & (0xFFFFFFFF as i64)
if sink.over:
st = ARCHIVE_TOO_BIG
else sink.failed:
st = ARCHIVE_IO_ERROR
else not good or sink.crc != want_crc or (sink.written & (0xFFFFFFFF as i64)) != want_size:
st = ARCHIVE_CORRUPT
end
end
mem.Free(head)
mem.Free(tail)
ret st
end
@en "GzipCompressFile"
@fa "فشرده سازی پرونده جی زیپ"
pub func GzipCompressFile(inpath: str, outpath: str): bool:
ret _cw_compress_path(inpath, outpath, _CW_GZIP, 0)
end
@en "GzipDecompressFileCap"
@fa "کدگشایی پرونده جی زیپ با سقف"
pub func GzipDecompressFileCap(inpath: str, outpath: str, cap: i64): int:
fp := compress.FileOpenRead(inpath)
if fp == null:
ret ARCHIVE_IO_ERROR
end
size := compress.FileSize(fp)
mut sink := compress.SinkOpen(outpath, cap)
mut st := ARCHIVE_OK
if sink.failed:
st = ARCHIVE_IO_ERROR
else:
st = _gz_to_sink(fp, size, sink)
closed := compress.SinkClose(sink)
if st == ARCHIVE_OK and not closed:
st = ARCHIVE_IO_ERROR
end
if st != ARCHIVE_OK:
os.Remove(outpath)
end
end
compress.FileClose(fp)
ret st
end
@en "GzipDecompressFile"
@fa "کدگشایی پرونده جی زیپ"
pub func GzipDecompressFile(inpath: str, outpath: str): bool:
ret GzipDecompressFileCap(inpath, outpath, 0 as i64) == ARCHIVE_OK
end
package archive
