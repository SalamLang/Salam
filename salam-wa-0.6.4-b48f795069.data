func _oz_of(line: int, explicit: int): int:
if line > 0:
ret line - 1
end
ret line + explicit + 1
end
func _area_edge(gd: GData, a: int, name: str, endp: bool): int:
mut best := 0
each ar in gd.areas:
if ar.name == name:
v := a == 0 ? (endp ? ar.ce : ar.cs) : (endp ? ar.re : ar.rs)
best = v
end
end
ret best
end
func _names_lines(names: Vector<LName>, nm: str, out &: Vector<int>):
each ln in names:
if ln.name == nm:
out.push(ln.line)
end
end
end
func _sort_dedup(v &: Vector<int>):
n := v.len()
repeat n in i:
mut j := i
until j > 0 and v[j - 1] > v[j]:
tmp := v[j]
v[j] = v[j - 1]
v[j - 1] = tmp
j--
end
end
mut out := 0
repeat n in i:
if out == 0 or v[out - 1] != v[i]:
v[out] = v[i]
out++
end
end
until v.len() > out:
_x := v.pop()
end
end
func _ends_with(s: str, suf: str): bool:
if s.len() < suf.len():
ret false
end
ret s.ends_with(suf)
end
func _area_line(gd: GData, names: Vector<LName>, a: int, name: str, endp: bool): int:
mut best := _area_edge(gd, a, name, endp)
full := name + (endp ? "-end" : "-start")
each ln in names:
if ln.name == full:
v := ln.line + 1
if best == 0 or v < best:
best = v
end
end
end
_sfree(full)
ret best
end
func _lines_named(gd: GData, names: Vector<LName>, a: int, nm: str, out &: Vector<int>):
_names_lines(names, nm, out)
if _ends_with(nm, "-start"):
base := nm.substr(0, nm.len() - 6)
e := _area_edge(gd, a, base, false)
if e > 0:
out.push(e - 1)
end
_sfree(base)
else _ends_with(nm, "-end"):
base := nm.substr(0, nm.len() - 4)
e := _area_edge(gd, a, base, true)
if e > 0:
out.push(e - 1)
end
_sfree(base)
end
_sort_dedup(out)
end
func _nth_fwd(lines: Vector<int>, first_line: int, n: int, explicit: int): int:
first := first_line < 0 ? 0 : first_line
mut cnt := 0
each l in lines:
if l >= first:
cnt++
if cnt == n:
ret l
end
end
end
st := first > explicit + 1 ? first : explicit + 1
ret st + (n - cnt) - 1
end
func _nth_bwd(lines: Vector<int>, last_line: int, n: int, explicit: int): int:
last := last_line < explicit ? last_line : explicit
mut sel := Vector {} as Vector<int>
defer sel.free()
each l in lines:
if l <= last:
sel.push(l)
end
end
if sel.len() >= n:
ret sel[sel.len() - n]
end
lm := last < -1 ? last : -1
ret lm - (n - sel.len()) + 1
end
func _find_named(gd: GData, names: Vector<LName>, a: int, nm: str, idx: int, endp: bool, explicit: int): int:
if idx == 0:
al := _area_line(gd, names, a, nm, endp)
if al != 0:
ret al - 1
end
end
mut lines := Vector {} as Vector<int>
defer lines.free()
_lines_named(gd, names, a, nm, lines)
if idx >= 0:
ret _nth_fwd(lines, 0, idx < 1 ? 1 : idx, explicit)
end
ret _nth_bwd(lines, explicit, 0 - idx, explicit)
end
func _resolve_pl(gd: GData, names: Vector<LName>, a: int, ps: GPl, pe: GPl, explicit: int): GPx:
mut k0 := GP_AUTO
mut v0 := 0
mut k1 := GP_AUTO
mut v1 := 0
switch ps.kind:
GP_LINE:
k0 = GP_LINE
v0 = _oz_of(ps.n, explicit)
break
end
GP_SPAN:
k0 = GP_SPAN
v0 = ps.n
break
end
GP_NLINE:
k0 = GP_LINE
v0 = _find_named(gd, names, a, ps.name, ps.n, false, explicit)
break
end
GP_NSPAN:
k0 = GP_NSPAN
v0 = ps.n
break
end
else:
end
end
switch pe.kind:
GP_LINE:
k1 = GP_LINE
v1 = _oz_of(pe.n, explicit)
break
end
GP_SPAN:
k1 = GP_SPAN
v1 = pe.n
break
end
GP_NLINE:
k1 = GP_LINE
v1 = _find_named(gd, names, a, pe.name, pe.n, true, explicit)
break
end
GP_NSPAN:
k1 = GP_NSPAN
v1 = pe.n
break
end
else:
end
end
if k0 == GP_LINE and k1 == GP_NSPAN:
mut lines := Vector {} as Vector<int>
_lines_named(gd, names, a, pe.name, lines)
v1 = _nth_fwd(lines, v0 + 1, v1 < 1 ? 1 : v1, explicit)
k1 = GP_LINE
lines.free()
else k0 == GP_NSPAN and k1 == GP_LINE:
mut lines := Vector {} as Vector<int>
_lines_named(gd, names, a, ps.name, lines)
v0 = _nth_bwd(lines, v1 - 1, v0 < 1 ? 1 : v0, explicit)
k0 = GP_LINE
lines.free()
end
if k0 == GP_NSPAN:
k0 = GP_SPAN
v0 = 1
end
if k1 == GP_NSPAN:
k1 = GP_SPAN
v1 = 1
end
if k0 == GP_SPAN and k1 == GP_SPAN:
k1 = GP_AUTO
end
ret GPx { k0 = k0, v0 = v0, k1 = k1, v1 = v1 }
end
func _px_def(p: GPx): bool:
ret p.k0 == GP_LINE or p.k1 == GP_LINE
end
func _px_lines(p: GPx, s &: int, e &: int):
if p.k0 == GP_LINE and p.k1 == GP_LINE:
if p.v0 == p.v1:
s = p.v0
e = p.v0 + 1
else:
s = p.v0 < p.v1 ? p.v0 : p.v1
e = p.v0 < p.v1 ? p.v1 : p.v0
end
ret
end
if p.k0 == GP_LINE:
s = p.v0
e = p.k1 == GP_SPAN ? p.v0 + p.v1 : p.v0 + 1
ret
end
e = p.v1
s = p.k0 == GP_SPAN ? p.v1 - p.v0 : p.v1 - 1
end
func _px_span(p: GPx): int:
if p.k0 == GP_SPAN:
ret p.v0
end
if p.k1 == GP_SPAN:
ret p.v1
end
ret 1
end
func _px_minmax(p: GPx, mn &: int, mx &: int, sp &: int):
if p.k0 == GP_LINE and p.k1 == GP_LINE:
if p.v0 == p.v1:
mn = p.v0
mx = p.v0 + 1
else:
mn = p.v0 < p.v1 ? p.v0 : p.v1
mx = p.v0 < p.v1 ? p.v1 : p.v0
end
sp = 1
else p.k0 == GP_LINE:
mn = p.v0
mx = p.k1 == GP_SPAN ? p.v0 + p.v1 : p.v0 + 1
sp = 1
else p.k1 == GP_LINE:
mn = p.k0 == GP_SPAN ? p.v1 - p.v0 : p.v1 - 1
mx = p.v1
sp = 1
else:
mn = 0
mx = 0
sp = _px_span(p)
end
if mn < 0 - GMAX:
mn = 0 - GMAX
end
if mx > GMAX:
mx = GMAX
end
end
func _occ_new(nneg_c: int, nexp_c: int, npos_c: int, nneg_r: int, nexp_r: int, npos_r: int): Occ:
mut o := Occ { nr0 = nneg_r, nc0 = nneg_c, nrt = nneg_r + nexp_r + npos_r, nct = nneg_c + nexp_c + npos_c }
o.cells = Vector {} as Vector<u8>
repeat o.nrt * o.nct:
o.cells.push(0 as u8)
end
o.rcur = Vector {} as Vector<int>
repeat o.nrt:
o.rcur.push(NOLINE)
end
o.ccur = Vector {} as Vector<int>
repeat o.nct:
o.ccur.push(NOLINE)
end
ret o
end
func _occ_free(o &: Occ):
o.cells.free()
o.rcur.free()
o.ccur.free()
end
func _occ_at(o: Occ, c: int, r: int): bool:
ci := c + o.nc0
ri := r + o.nr0
if ci < 0 or ci >= o.nct or ri < 0 or ri >= o.nrt:
ret false
end
ret (o.cells[ri * o.nct + ci] as int) != 0
end
func _occ_expand(o &: Occ, r0: int, r1: int, c0: int, c1: int):
nr := _imax(0 - o.nr0 - r0, 0)
pr := _imax(r1 - (o.nrt - o.nr0), 0)
nc := _imax(0 - o.nc0 - c0, 0)
pc := _imax(c1 - (o.nct - o.nc0), 0)
if nr == 0 and pr == 0 and nc == 0 and pc == 0:
ret
end
nrt := o.nrt + nr + pr
nct := o.nct + nc + pc
mut cells := Vector {} as Vector<u8>
repeat nrt * nct:
cells.push(0 as u8)
end
repeat o.nrt in ri:
repeat o.nct in ci:
cells[(ri + nr) * nct + ci + nc] = o.cells[ri * o.nct + ci]
end
end
o.cells.free()
o.cells = cells
mut rc := Vector {} as Vector<int>
repeat nr:
rc.push(NOLINE)
end
each v in o.rcur:
rc.push(v)
end
repeat pr:
rc.push(NOLINE)
end
o.rcur.free()
o.rcur = rc
mut cc := Vector {} as Vector<int>
repeat nc:
cc.push(NOLINE)
end
each v in o.ccur:
cc.push(v)
end
repeat pc:
cc.push(NOLINE)
end
o.ccur.free()
o.ccur = cc
o.nrt = nrt
o.nct = nct
o.nr0 += nr
o.nc0 += nc
end
func _imax(a: int, b: int): int:
if a > b:
ret a
end
ret b
end
func _imin(a: int, b: int): int:
if a < b:
ret a
end
ret b
end
func _occ_mark(o &: Occ, pa: int, ps: int, pe: int, ss: int, se: int, auto: bool):
c0 := pa == 0 ? ps : ss
c1 := pa == 0 ? pe : se
r0 := pa == 0 ? ss : ps
r1 := pa == 0 ? se : pe
_occ_expand(o, r0, r1, c0, c1)
if auto and ps < pe and ss < se:
if pa == 0:
ri := ss + o.nr0
if o.rcur[ri] < pe:
o.rcur[ri] = pe
end
else:
ci := ss + o.nc0
if o.ccur[ci] < pe:
o.ccur[ci] = pe
end
end
end
mut r := r0
until r < r1:
mut c := c0
until c < c1:
o.cells[(r + o.nr0) * o.nct + c + o.nc0] = 1 as u8
c++
end
r++
end
end
func _occ_start(o: Occ, a: int): int:
if a == 0:
ret 0 - o.nc0
end
ret 0 - o.nr0
end
func _occ_end(o: Occ, a: int): int:
if a == 0:
ret o.nct - o.nc0
end
ret o.nrt - o.nr0
end
func _occ_cell(o: Occ, pa: int, p: int, s: int): bool:
if pa == 0:
ret _occ_at(o, p, s)
end
ret _occ_at(o, s, p)
end
func _occ_jump(o: Occ, pa: int, ps: int, pe: int, ss: int, se: int): int:
sa := 1 - pa
s0 := _imax(ss, _occ_start(o, sa))
s1 := _imin(se, _occ_end(o, sa))
pend := _occ_end(o, pa)
mut best := NOLINE
mut s := s0
until s < s1:
mut p := _imax(ps, _occ_start(o, pa))
until p < pe and p < pend:
if _occ_cell(o, pa, p, s):
mut q := p
until q < pend and _occ_cell(o, pa, q, s):
q++
end
if q > best:
best = q
end
p = q
else:
p++
end
end
s++
end
ret best
end
func _occ_track_jump(o: Occ, a: int, s: int, e: int): int:
s0 := _imax(s, _occ_start(o, a))
s1 := _imin(e, _occ_end(o, a))
oa := 1 - a
mut k := s1 - 1
until k >= s0:
mut q := _occ_start(o, oa)
until q < _occ_end(o, oa):
if _occ_cell(o, oa, q, k):
ret k + 1
end
q++
end
k--
end
ret NOLINE
end
func _occ_cursor(o: Occ, pa: int, s: int): int:
if pa == 0:
ri := s + o.nr0
if ri < 0 or ri >= o.nrt:
ret NOLINE
end
ret o.rcur[ri]
end
ci := s + o.nc0
if ci < 0 or ci >= o.nct:
ret NOLINE
end
ret o.ccur[ci]
end
func _occ_track_used(o: Occ, a: int, idx: int): bool:
oa := 1 - a
line := idx - (a == 0 ? o.nc0 : o.nr0)
mut q := _occ_start(o, oa)
until q < _occ_end(o, oa):
if _occ_cell(o, oa, q, line):
ret true
end
q++
end
ret false
end
func _clamp_line(s &: int, e &: int):
if s < 0 - GMAX:
s = 0 - GMAX
end
if s > GMAX - 1:
s = GMAX - 1
end
if e < s + 1:
e = s + 1
end
if e > GMAX:
e = GMAX
end
end
func _gpx_axis(pl: GPlc, a: int): GPx:
if a == 0:
ret pl.col
end
ret pl.row
end
func _record(o &: Occ, it &: GIt, pa: int, ps0: int, pe0: int, ss0: int, se0: int, auto: bool):
mut ps := ps0
mut pe := pe0
mut ss := ss0
mut se := se0
_clamp_line(ps, pe)
_clamp_line(ss, se)
_occ_mark(o, pa, ps, pe, ss, se, auto)
if pa == 0:
it.c0 = ps
it.c1 = pe
it.r0 = ss
it.r1 = se
else:
it.c0 = ss
it.c1 = se
it.r0 = ps
it.r1 = pe
end
end
func _place(o &: Occ, items &: Vector<GIt>, pls: Vector<GPlc>, flow: GridAutoFlow):
pa := (flow == GridAutoFlow.Row or flow == GridAutoFlow.RowDense) ? 0 : 1
sa := 1 - pa
dense := flow == GridAutoFlow.RowDense or flow == GridAutoFlow.ColumnDense
repeat items.len() in i:
pl := pls[i]
if not (_px_def(pl.col) and _px_def(pl.row)):
continue
end
mut ps := 0
mut pe := 0
mut ss := 0
mut se := 0
_px_lines(_gpx_axis(pl, pa), ps, pe)
_px_lines(_gpx_axis(pl, sa), ss, se)
_record(o, items.ref(i), pa, ps, pe, ss, se, false)
end
repeat items.len() in i:
pl := pls[i]
if not (_px_def(_gpx_axis(pl, sa)) and not _px_def(_gpx_axis(pl, pa))):
continue
end
mut ss := 0
mut se := 0
_px_lines(_gpx_axis(pl, sa), ss, se)
pstart := _occ_start(o, pa)
mut pos := pstart
if not dense:
cur := _occ_cursor(o, pa, ss)
if cur != NOLINE:
pos = cur
end
end
span := _px_span(_gpx_axis(pl, pa))
until true:
j := _occ_jump(o, pa, pos, pos + span, ss, se)
if j == NOLINE:
break
end
pos = j
end
_record(o, items.ref(i), pa, pos, pos + span, ss, se, true)
end
gstart_p := _occ_start(o, pa)
gstart_s := _occ_start(o, sa)
mut cp := gstart_p
mut cs := gstart_s
repeat items.len() in i:
pl := pls[i]
if _px_def(_gpx_axis(pl, sa)):
continue
end
pst := _gpx_axis(pl, pa)
sspan := _px_span(_gpx_axis(pl, sa))
mut rps := 0
mut rpe := 0
mut rss := 0
mut rse := 0
pstart := _occ_start(o, pa)
pend := _occ_end(o, pa)
sstart := _occ_start(o, sa)
if _px_def(pst):
mut ps := 0
mut pe := 0
_px_lines(pst, ps, pe)
mut sidx := cs
if dense:
sidx = sstart
else ps < cp:
sidx = cs + 1
end
until true:
j := _occ_jump(o, sa, sidx, sidx + sspan, ps, pe)
if j == NOLINE:
break
end
sidx = j
end
rps = ps
rpe = pe
rss = sidx
rse = sidx + sspan
else:
pspan := _px_span(pst)
all := pspan >= pend - pstart
mut pidx := cp
mut sidx := cs
until true:
ppe := pidx + pspan
if ppe > pend:
if pidx == pstart:
break
end
sidx++
pidx = pstart
continue
end
if all:
tj := _occ_track_jump(o, sa, sidx, sidx + sspan)
if tj != NOLINE:
sidx = tj
pidx = pstart
continue
end
break
end
j := _occ_jump(o, pa, pidx, ppe, sidx, sidx + sspan)
if j != NOLINE:
pidx = j
continue
end
break
end
rps = pidx
rpe = pidx + pspan
rss = sidx
rse = sidx + sspan
end
_record(o, items.ref(i), pa, rps, rpe, rss, rse, true)
if dense:
cp = gstart_p
cs = gstart_s
else:
it := items[i]
cp = pa == 0 ? it.c1 : it.r1
cs = pa == 0 ? it.r0 : it.c0
end
end
end
func _tpl_count(tpl: GTpl, size: f64, max_fit: bool, gap: Length, reps &: int): int:
reps = 0
if not tpl.ok:
ret 0
end
nrep := tpl.tracks.len()
if tpl.rep == 0:
ret _imin(nrep, GMAX)
end
m := tpl.rtracks.len()
mut num := 1
if _is(size):
mut used := 0.0
each d in tpl.tracks:
used += _tdef_val(d, size)
end
g := _res0(gap, size)
mut per := 0.0
each d in tpl.rtracks:
per += _tdef_val(d, size)
end
first := used + per + (((nrep + m - 1) as f64) * g)
if first > size:
num = 1
else:
per_rep := per + (m as f64) * g
fit := (size - first) / per_rep
fl := fit as int
if max_fit:
num = fl + 1
else:
mut ce := fl
if (ce as f64) < fit:
ce++
end
num = ce + 1
end
end
end
rem := GMAX - tpl.rep_at
if rem <= 0:
num = 0
else:
mx := (rem + m - 1) / m
if num < 1:
num = 1
end
if num > mx:
num = mx
end
end
reps = num
ret _imin(nrep + m * num, GMAX)
end
func _tdef_val(d: TDef, p: f64): f64:
mx := _dv(d.xk, d.xv, p)
mn := _dv(d.mk, d.mv, p)
if _is(mx):
ret _mmax(mx, mn)
end
ret _or(mn, 0.0)
end
func _tpl_expand(tpl: GTpl, reps: int, tracks &: Vector<TDef>, names &: Vector<LName>):
if not tpl.ok:
ret
end
m := tpl.rtracks.len()
repeat tpl.tracks.len() in i:
if tpl.rep != 0 and i == tpl.rep_at:
repeat reps:
each d in tpl.rtracks:
tracks.push(d)
end
end
end
tracks.push(tpl.tracks[i])
end
if tpl.rep != 0 and tpl.rep_at == tpl.tracks.len():
repeat reps:
each d in tpl.rtracks:
tracks.push(d)
end
end
end
shift := tpl.rep != 0 ? reps * m : 0
each ln in tpl.names:
mut l := ln.line
if tpl.rep != 0 and (l > tpl.rep_at or (l == tpl.rep_at and ln.after)):
l += shift
end
names.push(LName { line = l, name = ln.name })
end
if tpl.rep != 0:
repeat reps in r:
each ln in tpl.rnames:
names.push(LName { line = tpl.rep_at + r * m + ln.line, name = ln.name })
end
end
end
end
func _gutter(gap: Length): GTr:
if gap.kind == LengthKind.Percent:
ret GTr { gut = true, mk = K_PCT, mv = gap.value, xk = K_PCT, xv = gap.value }
end
v := gap.kind == LengthKind.Px ? gap.value : 0.0
ret GTr { gut = true, mk = K_PX, mv = v, xk = K_PX, xv = v }
end
func _track(d: TDef): GTr:
ret GTr { mk = d.mk, mv = d.mv, xk = d.xk, xv = d.xv }
end
func _init_tracks(tr &: Vector<GTr>, neg: int, nexp: int, pos: int, tpl: GTpl, reps: int, autos: Vector<TDef>, gap: Length, fit: bool, o: Occ, a: int):
b0 := tr.len()
tr.push(_gutter(gap))
na := autos.len()
if neg > 0:
repeat neg in i:
if na == 0:
tr.push(_track(TDef {}))
else:
off := na - (neg % na)
tr.push(_track(autos[(off + i) % na]))
end
tr.push(_gutter(gap))
end
end
mut cur := neg
lim := neg + nexp
if nexp > 0 and tpl.ok:
m := tpl.rtracks.len()
repeat tpl.tracks.len() + 1 in i:
if tpl.rep != 0 and i == tpl.rep_at:
repeat reps * m in k:
if cur < lim:
mut t2 := _track(tpl.rtracks[k % m])
mut gu := _gutter(gap)
if fit and not _occ_track_used(o, a, cur):
_tr_collapse(t2)
_tr_collapse(gu)
end
tr.push(t2)
tr.push(gu)
cur++
end
end
if fit and cur == neg + nexp + pos:
mut q := tr.len() - 1
until q >= b0:
mut tq := tr[q]
if not tq.gut and not tq.collapsed:
break
end
_tr_collapse(tq)
tr[q] = tq
q--
end
end
end
if i < tpl.tracks.len() and cur < lim:
tr.push(_track(tpl.tracks[i]))
tr.push(_gutter(gap))
cur++
end
end
end
rest := neg + nexp - cur + pos
repeat rest in i:
if na == 0:
tr.push(_track(TDef {}))
else:
tr.push(_track(autos[i % na]))
end
tr.push(_gutter(gap))
end
mut first := tr[b0]
_tr_collapse(first)
tr[b0] = first
mut last := tr[tr.len() - 1]
_tr_collapse(last)
tr[tr.len() - 1] = last
end
func _gt(g &: GC, a: int, i: int): GTr:
ret g.tr[_tb(g, a) + i]
end
func _gm(t &: Engine, id: int, kw: f64, kh: f64, pw: f64, ph: f64, aw: f64, ah: f64, axis: int): f64:
o := _layout(t, id, Inp { kw = kw, kh = kh, pw = pw, ph = ph, aw = aw, ah = ah, inherent = true, axis = axis })
if axis == 0:
ret o.w
end
ret o.h
end
func _stretchy(a: Align): bool:
ret a == Align.Stretch or a == Align.Normal
end
func _g_margins(st: Style, iw: f64, shim: f64, mx &: f64, my &: f64):
mx = _res0(st.margin.left, 0.0) + _res0(st.margin.right, 0.0)
my = _res0(st.margin.top, iw) + _res0(st.margin.bottom, iw) + shim
end
func _g_known(t &: Engine, it: GIt, gw: f64, gh: f64, kw &: f64, kh &: f64):
st := t.nodes.ref(it.id).style
ratio := st.aspect_ratio
mut mx := 0.0
mut my := 0.0
_g_margins(st, gw, it.shim, mx, my)
pad := _r4(st.padding, gw)
bor := _r4(st.border, gw)
pbw := pad.l + pad.r + bor.l + bor.r
pbh := pad.t + pad.b + bor.t + bor.b
adjw := st.box_sizing == BoxSizing.ContentBox ? pbw : 0.0
adjh := st.box_sizing == BoxSizing.ContentBox ? pbh : 0.0
sw0 := _res(st.width, gw)
sh0 := _res(st.height, gh)
isw := _add(_arw(sw0, sh0, ratio), adjw)
ish := _add(_arh(sw0, sh0, ratio), adjh)
mnw0 := _res(st.min_width, gw)
mnh0 := _res(st.min_height, gh)
minw := _fmax(_or(_add(_arw(mnw0, mnh0, ratio), adjw), pbw), pbw)
minh := _fmax(_or(_add(_arh(mnw0, mnh0, ratio), adjh), pbh), pbh)
mxw0 := _res(st.max_width, gw)
mxh0 := _res(st.max_height, gh)
maxw := _add(_arw(mxw0, mxh0, ratio), adjw)
maxh := _add(_arh(mxw0, mxh0, ratio), adjh)
gmw := _is(gw) ? _fmax(gw - mx, 0.0) : NO
gmh := _is(gh) ? _fmax(gh - my, 0.0) : NO
mut w := isw
if not _is(w):
if _iskeyword(st.width):
mut ex := NO
_kav := _keyword_avail(st.width, gmw, ex)
w = ex
else not _isauto(st.margin.left) and not _isauto(st.margin.right) and _stretchy(it.jself):
w = gmw
end
end
w2 := _arw(w, ish, ratio)
mut h := _arh(w, ish, ratio)
if not _is(h):
if _iskeyword(st.height):
mut ex := NO
_kav := _keyword_avail(st.height, gmh, ex)
h = ex
else not _isauto(st.margin.top) and not _isauto(st.margin.bottom) and _stretchy(it.aself):
h = gmh
end
end
w3 := _arw(w2, h, ratio)
h3 := _arh(w2, h, ratio)
kw = _clamp(w3, minw, maxw)
kh = _clamp(h3, minh, maxh)
end
func _g_kd(t &: Engine, it &: GIt, gw: f64, gh: f64, kw &: f64, kh &: f64):
if it.kd_ok and it.kd_gw == gw and it.kd_gh == gh:
kw = it.kdw
kh = it.kdh
ret
end
_g_known(t, it, gw, gh, kw, kh)
it.kd_ok = true
it.kd_gw = gw
it.kd_gh = gh
it.kdw = kw
it.kdh = kh
end
func _g_kwadj(st: Style, gw: f64, gh: f64, shim: f64, aw &: f64, ah &: f64):
if not _iskeyword(st.width) and not _iskeyword(st.height):
ret
end
mut mx := 0.0
mut my := 0.0
_g_margins(st, gw, shim, mx, my)
if _iskeyword(st.width):
sw := _is(gw) ? _fmax(gw - mx, 0.0) : NO
mut ex := NO
kav := _keyword_avail(st.width, sw, ex)
if kav != NO:
aw = kav
end
end
if _iskeyword(st.height):
sh := _is(gh) ? _fmax(gh - my, 0.0) : NO
mut ex := NO
kav := _keyword_avail(st.height, sh, ex)
if kav != NO:
ah = kav
end
end
end
func _g_contrib(t &: Engine, it &: GIt, a: int, gw: f64, gh: f64, avw: f64, avh: f64, maxc: bool): f64:
mut kw := NO
mut kh := NO
_g_kd(t, it, gw, gh, kw, kh)
if a == 0 and _is(kw):
ret kw
end
if a == 1 and _is(kh):
ret kh
end
st := t.nodes.ref(it.id).style
mut aw := avw
mut ah := avh
if _is(avw) or _is(avh):
mar := _r4(st.margin, gw)
if _is(aw):
aw = _fmax(aw - mar.l - mar.r, 0.0)
end
if _is(ah):
ah = _fmax(ah - mar.t - mar.b - it.shim, 0.0)
end
end
fill := maxc ? MAXC : MINC
if not _is(aw):
aw = fill
end
if not _is(ah):
ah = fill
end
_g_kwadj(st, gw, gh, it.shim, aw, ah)
ret _gm(t, it.id, kw, kh, gw, gh, aw, ah, a)
end
func _g_minc(t &: Engine, it &: GIt, a: int, gw: f64, gh: f64, avw: f64, avh: f64): f64:
if a == 0 and _is(it.mincw):
ret it.mincw
end
if a == 1 and _is(it.minch):
ret it.minch
end
v := _g_contrib(t, it, a, gw, gh, avw, avh, false)
if a == 0:
it.mincw = v
else:
it.minch = v
end
ret v
end
func _g_maxc(t &: Engine, it &: GIt, a: int, gw: f64, gh: f64, avw: f64, avh: f64): f64:
if a == 0 and _is(it.maxcw):
ret it.maxcw
end
if a == 1 and _is(it.maxch):
ret it.maxch
end
v := _g_contrib(t, it, a, gw, gh, avw, avh, true)
if a == 0:
it.maxcw = v
else:
it.maxch = v
end
ret v
end
func _g_area(g &: GC, it &: GIt, a: int, iw: f64, ih: f64, est: int, gw &: f64, gh &: f64):
if it.ga_ok:
gw = it.gaw
gh = it.gah
ret
end
oa := 1 - a
pa := _pick(a, iw, ih)
po := _pick(oa, iw, ih)
mut sa := 0.0
mut k := _i0(it, a) + 1
until k < _i1(it, a):
tr := _gt(g, a, k)
mn := _dv(tr.mk, tr.mv, pa)
mx := _dv(tr.xk, tr.xv, pa)
if _is(mn) and _is(mx) and mn == mx and _is(sa):
sa += tr.base
else:
sa = NO
end
k++
end
mut so := 0.0
k = _i0(it, oa) + 1
until k < _i1(it, oa):
tr := _gt(g, oa, k)
mut e := NO
if est == 0:
e = _dv(tr.xk, tr.xv, po)
else:
e = tr.base
end
if _is(e) and _is(so):
so += e + tr.adj
else:
so = NO
end
k++
end
if a == 0:
gw = sa
gh = so
else:
gw = so
gh = sa
end
it.ga_ok = true
it.gaw = gw
it.gah = gh
end
func _ms_minc(t &: Engine, g &: GC, idx: int, a: int, iw: f64, ih: f64, est: int): f64:
it := g.items.ref(idx)
mut gw := NO
mut gh := NO
_g_area(g, it, a, iw, ih, est, gw, gh)
avw := a == 0 ? NO : gw
avh := a == 1 ? NO : gh
st := t.nodes.ref(it.id).style
mut mx := 0.0
mut my := 0.0
_g_margins(st, avw, it.shim, mx, my)
c := _g_minc(t, it, a, gw, gh, avw, avh)
ret c + _pick(a, mx, my)
end
func _ms_maxc(t &: Engine, g &: GC, idx: int, a: int, iw: f64, ih: f64, est: int): f64:
it := g.items.ref(idx)
mut gw := NO
mut gh := NO
_g_area(g, it, a, iw, ih, est, gw, gh)
avw := a == 0 ? NO : gw
avh := a == 1 ? NO : gh
st := t.nodes.ref(it.id).style
mut mx := 0.0
mut my := 0.0
_g_margins(st, avw, it.shim, mx, my)
c := _g_maxc(t, it, a, gw, gh, avw, avh)
ret c + _pick(a, mx, my)
end
func _ms_mins(t &: Engine, g &: GC, idx: int, a: int, iw: f64, ih: f64, est: int): f64:
it := g.items.ref(idx)
mut gw := NO
mut gh := NO
_g_area(g, it, a, iw, ih, est, gw, gh)
avw := a == 0 ? NO : gw
st := t.nodes.ref(it.id).style
mut mx := 0.0
mut my := 0.0
_g_margins(st, avw, it.shim, mx, my)
mut c := a == 0 ? it.minsw : it.minsh
if not _is(c):
c = _g_minimum(t, g, idx, a, gw, gh, iw, ih)
it2 := g.items.ref(idx)
if a == 0:
it2.minsw = c
else:
it2.minsh = c
end
end
ret c + _pick(a, mx, my)
end
func _g_minimum(t &: Engine, g &: GC, idx: int, a: int, gw: f64, gh: f64, iw: f64, ih: f64): f64:
it := g.items.ref(idx)
st := t.nodes.ref(it.id).style
ratio := st.aspect_ratio
pad := _r4(st.padding, gw)
bor := _r4(st.border, gw)
pbw := pad.l + pad.r + bor.l + bor.r
pbh := pad.t + pad.b + bor.t + bor.b
adjw := st.box_sizing == BoxSizing.ContentBox ? pbw : 0.0
adjh := st.box_sizing == BoxSizing.ContentBox ? pbh : 0.0
sw0 := _res(st.width, gw)
sh0 := _res(st.height, gh)
sz := a == 0 ? _add(_arw(sw0, sh0, ratio), adjw) : _add(_arh(sw0, sh0, ratio), adjh)
if _is(sz):
mnl := a == 0 ? st.min_width : st.min_height
mxl := a == 0 ? st.max_width : st.max_height
if _isauto(mnl) and _isauto(mxl):
ret sz
end
basis := _pick(a, gw, gh)
adj := _pick(a, adjw, adjh)
ret _clamp(sz, _add(_res(mnl, basis), adj), _add(_res(mxl, basis), adj))
end
szl := a == 0 ? st.width : st.height
if _iskeyword(szl) and szl.kind != LengthKind.Stretch:
ret _g_minc(t, it, a, gw, gh, gw, gh)
end
mnw0 := _res(st.min_width, _or(gw, 0.0))
mnh0 := _res(st.min_height, _or(gh, 0.0))
mn := a == 0 ? _add(_arw(mnw0, mnh0, ratio), adjw) : _add(_arh(mnw0, mnh0, ratio), adjh)
if _is(mn):
ret mn
end
if _it_scroll(it[0], a):
ret 0.0
end
pin := _pick(a, iw, ih)
i0 := _i0(it[0], a)
i1 := _i1(it[0], a)
mut spans_auto := false
mut any_fr := false
mut k := i0 + 1
until k < i1:
tr := _gt(g, a, k)
if _bauto(tr.mk, pin):
spans_auto = true
end
if tr.xk == K_FR:
any_fr = true
end
k++
end
one := i1 - i0 - 1 == 1
if spans_auto and (one or not any_fr):
mc := _g_minc(t, it, a, gw, gh, gw, gh)
mut lim := 0.0
k = i0 + 1
until k < i1:
tr := _gt(g, a, k)
v := _dv(tr.xk, tr.xv, pin)
if _is(v) and _is(lim):
lim += v
else:
lim = NO
end
k++
end
if _is(lim):
mut mx := 0.0
mut my := 0.0
_g_margins(st, gw, it.shim, mx, my)
ret _fmin(mc, _fmax(lim - _pick(a, mx, my), _pick(a, pbw, pbh)))
end
ret mc
end
ret 0.0
end
func _spanned_limit(g &: GC, it: GIt, a: int, p: f64): f64:
mut lim := 0.0
mut k := _i0(it, a) + 1
until k < _i1(it, a):
tr := _gt(g, a, k)
v := _dl(tr.xk, tr.xv, p)
if not _is(v):
ret NO
end
lim += v
k++
end
ret lim
end
func _ff_sum(g &: GC, it: GIt, a: int): f64:
mut s := 0.0
mut k := _i0(it, a) + 1
until k < _i1(it, a):
s += _tr_ff(_gt(g, a, k))
k++
end
ret s
end
func _inflex_sum(g &: GC, it: GIt, a: int): f64:
mut s := 0.0
mut k := _i0(it, a) + 1
until k < _i1(it, a):
tr := _gt(g, a, k)
if not _tr_flex(tr):
s += tr.base
end
k++
end
ret s
end
func _spans_match(g &: GC, it: GIt, a: int, mode: int, p: f64): bool:
mut k := _i0(it, a) + 1
until k < _i1(it, a):
if _tr_match(_gt(g, a, k), mode, p):
ret true
end
k++
end
ret false
end
func _tr_match(tr: GTr, mode: int, p: f64): bool:
switch mode:
0:
ret not _is(_dv(tr.mk, tr.mv, p))
end
1:
ret tr.mk == K_MINC or tr.mk == K_MAXC
end
2:
ret tr.mk == K_AUTO and tr.xk != K_MINC
end
3:
ret tr.mk == K_MAXC
end
4:
ret not _hdv(tr.xk, p)
end
5:
ret _mcalike(tr.xk) or (_usepct(tr.xk) and not _is(p))
end
6:
ret (tr.mk == K_AUTO and tr.xk != K_MINC) or tr.mk == K_MAXC
end
else:
ret true
end
end
ret true
end
func _dist_limits(g &: GC, a: int, s0: int, s1: int, space0: f64, affm: int, p: f64, flexonly: bool, prop_flex: bool, prop_affect: int, lim: int): f64:
mut space := space0
nn := s1 - s0 + 1
repeat nn:
if space <= 0.01:
break
end
mut psum := 0.0
mut minlim := BIG
mut any := false
mut k := s0
until k < s1:
tr := _gt(g, a, k)
if _dl_aff(tr, affm, p, flexonly):
ap := _dl_prop(tr, prop_affect)
lv := _dl_lim(tr, lim)
if ap + tr.inc < lv:
pr := _dl_ratio(tr, prop_flex)
psum += pr
if pr > 0.0:
q := (lv - ap - tr.inc) / pr
if not any or q < minlim:
minlim = q
end
any = true
end
end
end
k++
end
if psum == 0.0:
break
end
inc := _fmin(minlim, space / psum)
k = s0
until k < s1:
tr := g.tr.ref(_tb(g, a) + k)
if _dl_aff(tr[0], affm, p, flexonly):
incr := inc * _dl_ratio(tr[0], prop_flex)
if incr > 0.0 and _dl_prop(tr[0], prop_affect) + tr.inc + incr <= _dl_lim(tr[0], lim) + 0.01:
tr.inc += incr
space -= incr
end
end
k++
end
end
ret space
end
func _dl_aff(tr: GTr, affm: int, p: f64, flexonly: bool): bool:
if flexonly and not _tr_flex(tr):
ret false
end
if affm >= 100:
if not _tr_match(tr, affm - 100, p):
ret false
end
ret true
end
if affm == 50:
ret true
end
if affm == 51:
ret _intr(tr.xk)
end
if affm == 52:
ret _mofc(tr.xk)
end
if affm == 60:
ret tr.ig or tr.glim == BIG
end
ret _tr_match(tr, affm, p)
end
func _dl_prop(tr: GTr, which: int): f64:
if which == 1:
if tr.glim == BIG:
ret tr.base
end
ret tr.glim
end
ret tr.base
end
func _dl_lim(tr: GTr, which: int): f64:
switch which:
0:
ret tr.glim
end
1:
ret _tr_fclg(tr)
end
2:
ret BIG
end
3:
ret tr.fcl
end
else:
ret BIG
end
end
ret BIG
end
func _dl_ratio(tr: GTr, prop_flex: bool): f64:
if prop_flex:
ret _tr_ff(tr)
end
ret 1.0
end
func _g_any_aff(g &: GC, a: int, s0: int, s1: int, affm: int, p: f64, flexonly: bool): int:
mut c := 0
mut k := s0
until k < s1:
if _dl_aff(_gt(g, a, k), affm, p, flexonly):
c++
end
k++
end
ret c
end
func _dist_base(g &: GC, a: int, s0: int, s1: int, is_flex: bool, space: f64, affm: int, p: f64, lim: int, maxtype: bool):
if is_flex:
mut ffs := 0.0
mut k := s0
until k < s1:
tr := _gt(g, a, k)
if _tr_flex(tr) and _dl_aff(tr, affm, p, false):
ffs += _tr_ff(tr)
end
k++
end
_dist_base_inner(g, a, s0, s1, space, affm, p, true, ffs > 0.0, lim, maxtype)
else:
_dist_base_inner(g, a, s0, s1, space, affm, p, false, false, lim, maxtype)
end
end
func _dist_base_inner(g &: GC, a: int, s0: int, s1: int, space: f64, affm: int, p: f64, flexonly: bool, byff: bool, lim: int, maxtype: bool):
if space == 0.0 or _g_any_aff(g, a, s0, s1, affm, p, flexonly) == 0:
ret
end
mut sizes := 0.0
mut k := s0
until k < s1:
sizes += _gt(g, a, k).base
k++
end
extra := _fmax(0.0, space - sizes)
rest := _dist_limits(g, a, s0, s1, extra, affm, p, flexonly, byff, 0, lim)
if rest > 0.000001:
mut f := maxtype ? 52 : 51
mut cnt := 0
k = s0
until k < s1:
tr := _gt(g, a, k)
if _dl_aff(tr, affm, p, flexonly) and _dl_aff(tr, f, p, false):
cnt++
end
k++
end
if cnt == 0:
f = 50
end
_dist_beyond(g, a, s0, s1, rest, affm, f, p, flexonly, byff)
end
k = s0
until k < s1:
tr := g.tr.ref(_tb(g, a) + k)
if tr.inc > tr.bpi:
tr.bpi = tr.inc
end
tr.inc = 0.0
k++
end
end
func _dist_beyond(g &: GC, a: int, s0: int, s1: int, space0: f64, affm: int, f: int, p: f64, flexonly: bool, byff: bool):
mut space := space0
nn := s1 - s0 + 1
repeat nn:
if space <= 0.01:
break
end
mut psum := 0.0
mut minlim := BIG
mut any := false
mut k := s0
until k < s1:
tr := _gt(g, a, k)
if _dl_aff(tr, affm, p, flexonly) and _dl_aff(tr, f, p, false):
if tr.base + tr.inc < tr.fcl:
pr := byff ? _tr_ff(tr) : 1.0
psum += pr
if pr > 0.0:
q := (tr.fcl - tr.base - tr.inc) / pr
if not any or q < minlim:
minlim = q
end
any = true
end
end
end
k++
end
if psum == 0.0:
break
end
inc := _fmin(minlim, space / psum)
k = s0
until k < s1:
tr := g.tr.ref(_tb(g, a) + k)
if _dl_aff(tr[0], affm, p, flexonly) and _dl_aff(tr[0], f, p, false):
incr := inc * (byff ? _tr_ff(tr[0]) : 1.0)
if incr > 0.0 and tr.base + tr.inc + incr <= tr.fcl + 0.01:
tr.inc += incr
space -= incr
end
end
k++
end
end
end
func _dist_glim(g &: GC, a: int, s0: int, s1: int, space: f64, affm: int, p: f64):
if space == 0.0 or _g_any_aff(g, a, s0, s1, affm, p, false) == 0:
ret
end
mut sizes := 0.0
mut k := s0
until k < s1:
tr := _gt(g, a, k)
sizes += tr.glim == BIG ? tr.base : tr.glim
k++
end
extra := _fmax(0.0, space - sizes)
rest := _dist_glim_lim(g, a, s0, s1, extra, affm, p, true)
if rest > 0.0:
_r := _dist_glim_lim(g, a, s0, s1, rest, affm, p, false)
end
k = s0
until k < s1:
tr := g.tr.ref(_tb(g, a) + k)
if tr.inc > tr.gpi:
tr.gpi = tr.inc
end
tr.inc = 0.0
k++
end
end
func _dist_glim_lim(g &: GC, a: int, s0: int, s1: int, space0: f64, affm: int, p: f64, growable_only: bool): f64:
mut space := space0
nn := s1 - s0 + 1
repeat nn:
if space <= 0.01:
break
end
mut psum := 0.0
mut minlim := BIG
mut k := s0
until k < s1:
tr := _gt(g, a, k)
ok := _dl_aff(tr, affm, p, false) and (not growable_only or tr.ig or tr.glim == BIG)
ap := tr.glim == BIG ? tr.base : tr.glim
if ok and ap + tr.inc < tr.fcl:
psum++
q := tr.fcl - ap - tr.inc
if q < minlim:
minlim = q
end
end
k++
end
if psum == 0.0:
break
end
inc := _fmin(minlim, space / psum)
k = s0
until k < s1:
tr := g.tr.ref(_tb(g, a) + k)
ok := _dl_aff(tr[0], affm, p, false) and (not growable_only or tr.ig or tr.glim == BIG)
ap := tr.glim == BIG ? tr.base : tr.glim
if ok and inc > 0.0 and ap + tr.inc + inc <= tr.fcl + 0.01:
tr.inc += inc
space -= inc
end
k++
end
end
ret space
end
func _flush_base(g &: GC, a: int):
repeat _tn(g, a) in k:
tr := g.tr.ref(_tb(g, a) + k)
tr.base += tr.bpi
tr.bpi = 0.0
end
end
func _flush_glim(g &: GC, a: int, setig: bool):
repeat _tn(g, a) in k:
tr := g.tr.ref(_tb(g, a) + k)
if tr.gpi > 0.0:
if tr.glim == BIG:
tr.glim = tr.base + tr.gpi
else:
tr.glim += tr.gpi
end
tr.ig = setig
else:
tr.ig = false
end
tr.gpi = 0.0
end
end
func _g_baselines(t &: Engine, g &: GC, iw: f64, ih: f64):
n := g.items.len()
mut done := Vector {} as Vector<bool>
defer done.free()
repeat n:
done.push(false)
end
repeat n in i:
if done[i]:
continue
end
row := g.items[i].r0
mut cnt := 0
repeat n in j:
if g.items[j].r0 == row:
done[j] = true
if _g_base_part(t, g.items[j]):
cnt++
end
end
end
if cnt <= 1:
continue
end
mut maxb := MINC
repeat n in j:
itj := g.items[j]
if itj.r0 == row and _g_base_part(t, itj):
o := _layout(t, itj.id, Inp { pw = iw, ph = ih, aw = MINC, ah = MINC, inherent = true, axis = 2, perform = true })
st := t.nodes.ref(itj.id).style
bl := _or(_child_baseline(o.baseline, o.h, st.overflow_y), o.h)
ir := g.items.ref(j)
ir.ibase = bl
mb := bl + _res0(st.margin.top, iw)
if mb > maxb:
maxb = mb
end
end
end
repeat n in j:
itj := g.items[j]
if itj.r0 == row and _g_base_part(t, itj):
st := t.nodes.ref(itj.id).style
ir := g.items.ref(j)
ir.shim = maxb - (itj.ibase + _res0(st.margin.top, iw))
ir.kd_ok = false
end
end
end
end
func _g_base_part(t &: Engine, it: GIt): bool:
if it.aself != Align.Baseline:
ret false
end
st := t.nodes.ref(it.id).style
if _isauto(st.margin.top) or _isauto(st.margin.bottom):
ret false
end
if st.height.kind == LengthKind.Percent and (it.ir or it.fr):
ret false
end
ret true
end
func _gutter_adj(g &: GC, a: int, align: Align, inner: f64, est: int): f64:
n := _tn(g, a)
if n <= 1:
ret 0.0
end
mut outer := 0
mut innerw := 0
switch align:
Align.Start, Align.FlexStart, Align.End, Align.FlexEnd, Align.Center:
outer = 1
break
end
Align.SpaceBetween:
innerw = 1
break
end
Align.SpaceAround:
outer = 1
innerw = 2
break
end
Align.SpaceEvenly:
outer = 1
innerw = 1
break
end
else:
end
end
if innerw == 0 or not _is(inner):
ret 0.0
end
mut sum := 0.0
repeat n in k:
tr := _gt(g, a, k)
e := est == 0 ? _dv(tr.xk, tr.xv, inner) : tr.base
if not _is(e) or not _is(sum):
sum = NO
else:
sum += e
end
end
free := _is(sum) ? _fmax(0.0, inner - sum) : 0.0
wtc := ((n - 3) / 2) * innerw + 2 * outer
if wtc <= 0:
ret 0.0
end
ret (free / (wtc as f64)) * (innerw as f64)
end
func _sizing(t &: Engine, g &: GC, a: int, amin: f64, amax: f64, aal: Align, oal: Align, agw: f64, agh: f64, iw: f64, ih: f64, est: int, has_base: bool):
pin := _pick(a, iw, ih)
base := _tb(g, a)
n := _tn(g, a)
pb := _or(pin, amin)
repeat n in k:
tr := g.tr.ref(base + k)
tr.base = _or(_dv(tr.mk, tr.mv, pb), 0.0)
tr.glim = _dv(tr.xk, tr.xv, pb)
if not _is(tr.glim):
tr.glim = BIG
end
if tr.glim < tr.base:
tr.glim = tr.base
end
tr.fcl = _fcl_of(tr.xk, tr.xv, pin)
end
if has_base:
_g_baselines(t, g, iw, ih)
end
mut all_fixed := true
repeat n in k:
tr := _gt(g, a, k)
if not (tr.base == tr.glim and _is(_dv(tr.mk, tr.mv, pb))):
all_fixed = false
break
end
end
if all_fixed:
ret
end
oa := 1 - a
adjv := _gutter_adj(g, oa, oal, _pick(oa, iw, ih), est)
onn := _tn(g, oa)
if onn > 3:
mut k := 2
until k < onn:
tr := g.tr.ref(_tb(g, oa) + k)
tr.adj = adjv
k += 2
end
end
aspace := _pick(a, agw, agh)
_intrinsic(t, g, a, aspace, iw, ih, est)
_maximise(g, a, aspace)
mut exp := NO
if _is(pin):
exp = pin
else aspace == MINC and a == 0:
exp = MINC
else:
exp = MAXC
end
_expand_flex(t, g, a, amin, amax, exp, iw, ih, est)
if aal == Align.Stretch:
_stretch_auto(g, a, amin, exp)
end
end
func _order(g &: GC, a: int): Vector<int>:
mut out := Vector {} as Vector<int>
n := g.items.len()
mut maxsp := 1
repeat n in i:
it := g.items[i]
if not _cflex(it, a):
sp := _span(it, a)
if sp > maxsp:
maxsp = sp
end
end
end
mut sp := 0
until sp <= maxsp:
repeat n in i:
it := g.items[i]
if not _cflex(it, a) and _span(it, a) == sp:
out.push(i)
end
end
sp++
end
repeat n in i:
if _cflex(g.items[i], a):
out.push(i)
end
end
ret out
end
func _intrinsic(t &: Engine, g &: GC, a: int, aspace: f64, iw: f64, ih: f64, est: int):
pin := _pick(a, iw, ih)
mut ord := _order(g, a)
defer ord.free()
mut bi := 0
until bi < ord.len():
first := g.items[ord[bi]]
is_flex := _cflex(first, a)
sp := _span(first, a)
mut be := bi
if is_flex:
be = ord.len()
else:
until be < ord.len() and not _cflex(g.items[ord[be]], a) and _span(g.items[ord[be]], a) == sp:
be++
end
end
if not is_flex and sp == 1:
mut q := bi
until q < be:
idx := ord[q]
it := g.items[idx]
ti := _i0(it, a) + 1
tr := _gt(g, a, ti)
mut nb := tr.base
if tr.mk == K_MINC:
nb = _fmax(tr.base, _ms_minc(t, g, idx, a, iw, ih, est))
else tr.mk == K_MAXC:
nb = _fmax(tr.base, _ms_maxc(t, g, idx, a, iw, ih, est))
else _bauto(tr.mk, pin):
mut sv := 0.0
if (aspace == MINC or aspace == MAXC) and not _it_scroll(it, a):
mins := _ms_mins(t, g, idx, a, iw, ih, est)
minc := _ms_minc(t, g, idx, a, iw, ih, est)
lim := _dl(tr.xk, tr.xv, pin)
sv = _fmax(_mmin(minc, lim), mins)
else:
sv = _ms_mins(t, g, idx, a, iw, ih, est)
end
nb = _fmax(tr.base, sv)
end
trr := g.tr.ref(_tb(g, a) + ti)
trr.base = nb
tr2 := _gt(g, a, ti)
mut mcc := NO
if _tr_intr(tr2):
mcc = _ms_minc(t, g, idx, a, iw, ih, est)
end
mut planned := NO
if tr2.xk == K_FITPX or tr2.xk == K_FITPCT:
mxc := _fmin(_ms_maxc(t, g, idx, a, iw, ih, est), tr2.fcl)
if _is(mcc) and not _it_scroll(it, a):
planned = _fmax(mcc, mxc)
else:
planned = mxc
end
else _mcalike(tr2.xk) or (_usepct(tr2.xk) and not _is(pin)):
planned = _ms_maxc(t, g, idx, a, iw, ih, est)
else _intr(tr2.xk):
planned = mcc
end
if _is(planned):
trp := g.tr.ref(_tb(g, a) + ti)
trp.gpi = _fmax(trp.gpi, planned)
end
q++
end
repeat _tn(g, a) in k:
tr := g.tr.ref(_tb(g, a) + k)
if tr.gpi > 0.0:
if tr.glim == BIG:
tr.glim = tr.gpi
else:
tr.glim = _fmax(tr.glim, tr.gpi)
end
end
tr.ig = false
tr.gpi = 0.0
if tr.glim < tr.base:
tr.glim = tr.base
end
end
bi = be
continue
end
mut q := bi
until q < be:
idx := ord[q]
it := g.items[idx]
if _cintr(it, a):
mut sv := 0.0
if (aspace == MINC or aspace == MAXC) and not _it_scroll(it, a):
mins := _ms_mins(t, g, idx, a, iw, ih, est)
minc := _ms_minc(t, g, idx, a, iw, ih, est)
lim := _spanned_limit(g, it, a, pin)
lmc := _fmax(_mmin(minc, lim), mins)
if is_flex:
infl := _inflex_sum(g, it, a)
scale := _fmin(_ff_sum(g, it, a), 1.0)
excess := _fmax(lmc - infl, 0.0)
sv = _fmax(mins, infl + excess * scale)
else:
sv = lmc
end
else:
sv = _ms_mins(t, g, idx, a, iw, ih, est)
end
if sv > 0.0:
lm := _it_scroll(it, a) ? 1 : 0
_dist_base(g, a, _i0(it, a) + 1, _i1(it, a), is_flex, sv, 0, pin, lm, false)
end
end
q++
end
_flush_base(g, a)
q = bi
until q < be:
idx := ord[q]
it := g.items[idx]
if _spans_match(g, it, a, 1, pin):
sv := _ms_minc(t, g, idx, a, iw, ih, est)
if sv > 0.0:
lm := _it_scroll(it, a) ? 1 : 0
_dist_base(g, a, _i0(it, a) + 1, _i1(it, a), is_flex, sv, 1, pin, lm, false)
end
end
q++
end
_flush_base(g, a)
if aspace == MAXC:
q = bi
until q < be:
idx := ord[q]
it := g.items[idx]
if _spans_match(g, it, a, 6, pin):
mxc := _ms_maxc(t, g, idx, a, iw, ih, est)
lim := _spanned_limit(g, it, a, pin)
mut sv := _mmin(mxc, lim)
if is_flex:
infl := _inflex_sum(g, it, a)
scale := _fmin(_ff_sum(g, it, a), 1.0)
sv = infl + _fmax(sv - infl, 0.0) * scale
end
if sv > 0.0:
if _spans_match(g, it, a, 3, pin):
_dist_base(g, a, _i0(it, a) + 1, _i1(it, a), is_flex, sv, 3, pin, 2, true)
else:
_dist_base(g, a, _i0(it, a) + 1, _i1(it, a), is_flex, sv, 2, pin, 1, true)
end
end
end
q++
end
_flush_base(g, a)
end
q = bi
until q < be:
idx := ord[q]
it := g.items[idx]
if _spans_match(g, it, a, 3, pin):
sv := _ms_maxc(t, g, idx, a, iw, ih, est)
if sv > 0.0:
_dist_base(g, a, _i0(it, a) + 1, _i1(it, a), is_flex, sv, 3, pin, 0, true)
end
end
q++
end
_flush_base(g, a)
repeat _tn(g, a) in k:
tr := g.tr.ref(_tb(g, a) + k)
if tr.glim < tr.base:
tr.glim = tr.base
end
end
if not is_flex:
q = bi
until q < be:
idx := ord[q]
it := g.items[idx]
if _spans_match(g, it, a, 4, pin):
sv := _ms_minc(t, g, idx, a, iw, ih, est)
if sv > 0.0:
_dist_glim(g, a, _i0(it, a) + 1, _i1(it, a), sv, 4, pin)
end
end
q++
end
_flush_glim(g, a, true)
q = bi
until q < be:
idx := ord[q]
it := g.items[idx]
if _spans_match(g, it, a, 5, pin):
sv := _ms_maxc(t, g, idx, a, iw, ih, est)
if sv > 0.0:
_dist_glim(g, a, _i0(it, a) + 1, _i1(it, a), sv, 5, pin)
end
end
q++
end
_flush_glim(g, a, false)
end
bi = be
end
repeat _tn(g, a) in k:
tr := g.tr.ref(_tb(g, a) + k)
if tr.glim == BIG:
tr.glim = tr.base
end
end
end
func _maximise(g &: GC, a: int, aspace: f64):
mut used := 0.0
repeat _tn(g, a) in k:
used += _gt(g, a, k).base
end
mut free := 0.0
if aspace == MAXC:
free = BIG
else aspace == MINC:
free = 0.0
else:
free = aspace - used
end
if free == BIG:
repeat _tn(g, a) in k:
tr := g.tr.ref(_tb(g, a) + k)
tr.base = tr.glim
end
else free > 0.0:
_r := _dist_limits(g, a, 0, _tn(g, a), free, 50, NO, false, false, 0, 1)
repeat _tn(g, a) in k:
tr := g.tr.ref(_tb(g, a) + k)
tr.base += tr.inc
tr.inc = 0.0
end
end
end
func _fr_size(g &: GC, a: int, s0: int, s1: int, space: f64): f64:
if space == 0.0:
ret 0.0
end
mut hyp := BIG
mut prev := BIG
nn := s1 - s0 + 1
repeat nn:
mut used := 0.0
mut ffs := 0.0
mut k := s0
until k < s1:
tr := _gt(g, a, k)
if tr.xk == K_FR and (hyp == BIG ? tr.xv > 0.0 : tr.xv * hyp >= tr.base):
ffs += tr.xv
else:
used += tr.base
end
k++
end
left := space - used
ff := _fmax(ffs, 1.0)
prev = hyp
hyp = left / ff
mut valid := true
k = s0
until k < s1:
tr := _gt(g, a, k)
if tr.xk == K_FR:
if not (tr.xv * hyp >= tr.base or (prev != BIG and tr.xv * prev < tr.base)):
valid = false
end
end
k++
end
if valid:
break
end
end
ret hyp
end
func _expand_flex(t &: Engine, g &: GC, a: int, amin: f64, amax: f64, exp: f64, iw: f64, ih: f64, est: int):
n := _tn(g, a)
mut ff := 0.0
if exp == MINC:
ff = 0.0
else exp == MAXC:
mut m1 := 0.0
mut has1 := false
repeat n in k:
tr := _gt(g, a, k)
if tr.xk == K_FR:
v := tr.xv > 1.0 ? tr.base / tr.xv : tr.base
if not has1 or v > m1:
m1 = v
end
has1 = true
end
end
mut m2 := 0.0
mut has2 := false
repeat g.items.len() in i:
it := g.items[i]
if _cflex(it, a):
mxc := _ms_maxc(t, g, i, a, iw, ih, est)
it2 := g.items[i]
v := _fr_size(g, a, _i0(it2, a) + 1, _i1(it2, a), mxc)
if not has2 or v > m2:
m2 = v
end
has2 = true
end
end
ff = _fmax(m1, m2)
mut hyp := 0.0
repeat n in k:
tr := _gt(g, a, k)
if tr.xk == K_FR:
hyp += _fmax(tr.base, tr.xv * ff)
else:
hyp += tr.base
end
end
mn := _or(amin, 0.0)
mx := _or(amax, BIG)
if hyp < mn:
ff = _fr_size(g, a, 0, n, mn)
else hyp > mx:
ff = _fr_size(g, a, 0, n, mx)
end
else:
mut used := 0.0
repeat n in k:
used += _gt(g, a, k).base
end
if exp - used <= 0.0:
ff = 0.0
else:
ff = _fr_size(g, a, 0, n, exp)
end
end
repeat n in k:
tr := g.tr.ref(_tb(g, a) + k)
if tr.xk == K_FR:
tr.base = _fmax(tr.base, tr.xv * ff)
end
end
end
func _stretch_auto(g &: GC, a: int, amin: f64, exp: f64):
n := _tn(g, a)
mut na := 0
mut used := 0.0
repeat n in k:
tr := _gt(g, a, k)
if tr.xk == K_AUTO and not tr.gut:
na++
end
used += tr.base
end
if na == 0:
ret
end
mut free := 0.0
if exp != MINC and exp != MAXC:
free = exp - used
else _is(amin):
free = amin - used
end
if free > 0.0:
per := free / (na as f64)
repeat n in k:
tr := g.tr.ref(_tb(g, a) + k)
if tr.xk == K_AUTO and not tr.gut:
tr.base += per
end
end
end
end
func _align_tracks(g &: GC, a: int, size: f64, ps: f64, bs: f64, align: Align, rev: bool):
n := _tn(g, a)
mut used := 0.0
mut nt := 0
repeat n in k:
tr := _gt(g, a, k)
used += tr.base
if k % 2 == 1 and not tr.collapsed:
nt++
end
end
free := size - used
origin := ps + bs
mut al := _content_fallback(align, free, nt)
if rev:
switch al:
Align.Start:
al = Align.End
break
end
Align.End:
al = Align.Start
break
end
Align.FlexStart:
al = Align.FlexEnd
break
end
Align.FlexEnd:
al = Align.FlexStart
break
end
Align.Stretch:
al = Align.End
break
end
else:
end
end
end
empty_off := nt == 0 ? _content_offset(free, nt, 0.0, al, false, true) : 0.0
mut tot := origin + empty_off
mut seen := false
repeat n in i:
k := rev ? n - 1 - i : i
tr := g.tr.ref(_tb(g, a) + k)
gutter := i % 2 == 0
real := not gutter and not tr.collapsed
first := real and not seen
off := real ? _content_offset(free, nt, 0.0, al, false, first) : 0.0
tr.off = tot + off
tot = tot + off + tr.base
if real:
seen = true
end
end
end
func _align_in_area(s: f64, e: f64, al: Align, size: f64, oof: bool, ins_s: f64, ins_e: f64, mar_s: f64, mar_e: f64, shim: f64, rtl: bool, rm_s &: f64, rm_e &: f64): f64:
nm_s := _or(mar_s, 0.0) + shim
nm_e := _or(mar_e, 0.0)
gas := _fmax(e - s, 0.0)
free := _fmax(gas - size - nm_s - nm_e, 0.0)
mut autos := 0
if not _is(mar_s):
autos++
end
if not _is(mar_e):
autos++
end
am := autos > 0 ? free / (autos as f64) : 0.0
rm_s = _or(mar_s, am) + shim
rm_e = _or(mar_e, am)
mut off := 0.0
switch al:
Align.End, Align.FlexEnd:
off = rtl ? rm_s : gas - size - rm_e
break
end
Align.Center:
off = (gas - size + rm_s - rm_e) / 2.0
break
end
else:
off = rtl ? gas - size - rm_e : rm_s
end
end
if oof:
if _is(ins_s) and _is(ins_e):
off = rtl ? gas - ins_e - size - nm_e : ins_s + nm_s
else _is(ins_s):
off = ins_s + nm_s
else _is(ins_e):
off = gas - ins_e - size - nm_e
end
end
ret s + off
end
func _g_position(t &: Engine, it &: GIt, left: f64, right: f64, top: f64, bottom: f64, ji: Align, ai: Align, rtl: bool):
n := t.nodes.ref(it.id)
st := n.style
cbw := right - left
cbh := bottom - top
ratio := st.aspect_ratio
mut js := st.justify_self == Align.Auto ? ji : st.justify_self
mut a_self := st.align_self == Align.Auto ? ai : st.align_self
pad := _r4(st.padding, cbw)
bor := _r4(st.border, cbw)
pbw := pad.l + pad.r + bor.l + bor.r
pbh := pad.t + pad.b + bor.t + bor.b
adjw := st.box_sizing == BoxSizing.ContentBox ? pbw : 0.0
adjh := st.box_sizing == BoxSizing.ContentBox ? pbh : 0.0
sw0 := _res(st.width, cbw)
sh0 := _res(st.height, cbh)
isw := _add(_arw(sw0, sh0, ratio), adjw)
ish := _add(_arh(sw0, sh0, ratio), adjh)
mnw0 := _res(st.min_width, cbw)
mnh0 := _res(st.min_height, cbh)
mnw1 := _fmax(_or(_add(mnw0, adjw), pbw), pbw)
mnh1 := _fmax(_or(_add(mnh0, adjh), pbh), pbh)
minw := _arw(mnw1, mnh1, ratio)
minh := _arh(mnw1, mnh1, ratio)
mxw0 := _res(st.max_width, cbw)
mxh0 := _res(st.max_height, cbh)
maxw := _add(_arw(mxw0, mxh0, ratio), adjw)
maxh := _add(_arh(mxw0, mxh0, ratio), adjh)
if js == Align.Normal:
js = (_is(isw) or _iskeyword(st.width)) ? Align.Start : Align.Stretch
end
if a_self == Align.Normal:
a_self = (_is(ish) or _iskeyword(st.height) or ratio > 0.0) ? Align.Start : Align.Stretch
end
mar := _r4opt(st.margin, cbw)
gmw := _fmax(cbw - _or(mar.l, 0.0) - _or(mar.r, 0.0), 0.0)
gmh := _fmax(cbh - _or(mar.t, 0.0) - _or(mar.b, 0.0) - it.shim, 0.0)
mut kxw := NO
mut kxh := NO
mut kex_w := NO
mut kex_h := NO
if not _is(isw):
kxw = _keyword_avail(st.width, gmw, kex_w)
end
if not _is(ish):
kxh = _keyword_avail(st.height, gmh, kex_h)
end
mut both_w := NO
mut both_h := NO
if kxw != NO and kxh != NO:
o := _layout(t, it.id, Inp { pw = cbw, ph = cbh, aw = kxw, ah = kxh, inherent = true, axis = 2 })
both_w = o.w
both_h = o.h
end
mut w := isw
if not _is(w):
if _is(kex_w):
w = kex_w
else kxw != NO:
if _is(both_w):
w = both_w
else:
w = _gm(t, it.id, NO, NO, cbw, cbh, kxw, gmh, 0)
end
else _is(mar.l) and _is(mar.r) and js == Align.Stretch:
w = gmw
end
end
w2 := _arw(w, ish, ratio)
mut h := _arh(w, ish, ratio)
if not _is(h):
if _is(kex_h):
h = kex_h
else kxh != NO:
if _is(both_h):
h = both_h
else:
h = _gm(t, it.id, w2, NO, cbw, cbh, _is(w2) ? w2 : gmw, kxh, 1)
end
else _is(mar.t) and _is(mar.b) and a_self == Align.Stretch:
h = gmh
end
end
w3 := _clamp(_arw(w2, h, ratio), minw, maxw)
h3 := _clamp(_arh(w2, h, ratio), minh, maxh)
o := _layout(t, it.id, Inp { kw = w3, kh = h3, pw = cbw, ph = cbh, aw = gmw, ah = gmh, inherent = true, axis = 2, perform = true })
fw := _clampf(_or(w3, o.w), minw, maxw)
fh := _clampf(_or(h3, o.h), minh, maxh)
mut ml := 0.0
mut mr := 0.0
mut mt := 0.0
mut mb := 0.0
insh := _r4opt(st.inset, cbw)
insv := _r4opt(st.inset, cbh)
x0 := _align_in_area(left, right, js, fw, false, NO, NO, mar.l, mar.r, 0.0, rtl, ml, mr)
y0 := _align_in_area(top, bottom, a_self, fh, false, NO, NO, mar.t, mar.b, it.shim, false, mt, mb)
mut rx := 0.0
mut ry := 0.0
if _isrel(st.position):
if rtl:
rx = _is(insh.r) ? 0.0 - insh.r : _or(insh.l, 0.0)
else:
rx = _is(insh.l) ? insh.l : (_is(insh.r) ? 0.0 - insh.r : 0.0)
end
ry = _is(insv.t) ? insv.t : (_is(insv.b) ? 0.0 - insv.b : 0.0)
end
_set_layout(t, it.id, x0 + rx, y0 + ry, fw, fh, pad, bor, R4 { l = ml, r = mr, t = mt, b = mb })
it.ypos = y0
it.hgt = fh
it.ibase = _child_baseline(o.baseline, fh, st.overflow_y)
end
func _g_crosses(g &: GC):
repeat g.items.len() in i:
it := g.items.ref(i)
it.fc = false
it.ic = false
it.fr = false
it.ir = false
mut k := it.ci0 + 1
until k < it.ci1:
tr := g.tr[k]
if _tr_flex(tr):
it.fc = true
end
if _tr_intr(tr):
it.ic = true
end
k++
end
k = it.ri0 + 1
until k < it.ri1:
tr := g.tr[g.nct + k]
if _tr_flex(tr):
it.fr = true
end
if _tr_intr(tr):
it.ir = true
end
k++
end
end
end
func _sum_base(g &: GC, a: int): f64:
mut s := 0.0
repeat _tn(g, a) in k:
s += _gt(g, a, k).base
end
ret s
end
func _any_pct(g &: GC, a: int): bool:
repeat _tn(g, a) in k:
if _tr_pct(_gt(g, a, k)):
ret true
end
end
ret false
end
func _recheck(t &: Engine, g &: GC, a: int, iw: f64, ih: f64): bool:
mut changed := false
repeat g.items.len() in i:
it := g.items.ref(i)
if not _cintr(it[0], a):
continue
end
it.ga_ok = false
mut gw := NO
mut gh := NO
_g_area(g, it, a, iw, ih, 1, gw, gh)
avw := a == 0 ? NO : gw
avh := a == 1 ? NO : gh
old := a == 0 ? it.mincw : it.minch
nv := _g_contrib(t, it, a, gw, gh, avw, avh, false)
if not _is(old) or old != nv:
changed = true
end
if a == 0:
it.mincw = nv
it.maxcw = NO
it.minsw = NO
else:
it.minch = nv
it.maxch = NO
it.minsh = NO
end
end
ret changed
end
func _clear_caches(g &: GC, a: int):
repeat g.items.len() in i:
it := g.items.ref(i)
it.ga_ok = false
if a == 0:
it.mincw = NO
it.maxcw = NO
it.minsw = NO
else:
it.minch = NO
it.maxch = NO
it.minsh = NO
end
end
end
func _grid_child_pl(t &: Engine, c: int, gd: GData, cnames: Vector<LName>, rnames: Vector<LName>, ncol: int, nrow: int): GPlc:
cd := t.nodes.ref(c).gd
ret GPlc { col = _resolve_pl(gd, cnames, 0, cd.pcs, cd.pce, ncol), row = _resolve_pl(gd, rnames, 1, cd.prs, cd.pre, nrow) }
end
func _align_edge(a: Align, rtl: bool): int:
if a == Align.Center:
ret 2
end
endk := a == Align.End or a == Align.FlexEnd
st := endk == rtl
ret st ? 0 : 1
end
func _grid(t &: Engine, id: int, inp: Inp): Out:
n := t.nodes.ref(id)
st := n.style
gd := n.gd
rtl := st.direction == Direction.Rtl
ratio := st.aspect_ratio
pad := _r4(st.padding, inp.pw)
bor := _r4(st.border, inp.pw)
pbw := pad.l + pad.r + bor.l + bor.r
pbh := pad.t + pad.b + bor.t + bor.b
adjw := st.box_sizing == BoxSizing.ContentBox ? pbw : 0.0
adjh := st.box_sizing == BoxSizing.ContentBox ? pbh : 0.0
mnw0 := _res(st.min_width, inp.pw)
mnh0 := _res(st.min_height, inp.ph)
mxw0 := _res(st.max_width, inp.pw)
mxh0 := _res(st.max_height, inp.ph)
minw := _add(_arw(mnw0, mnh0, ratio), adjw)
minh := _add(_arh(mnw0, mnh0, ratio), adjh)
maxw := _add(_arw(mxw0, mxh0, ratio), adjw)
maxh := _add(_arh(mxw0, mxh0, ratio), adjh)
mut prw := NO
mut prh := NO
if inp.inherent:
sw0 := _res(st.width, inp.pw)
sh0 := _res(st.height, inp.ph)
prw = _add(_arw(sw0, sh0, ratio), adjw)
prh = _add(_arh(sw0, sh0, ratio), adjh)
end
sgx := st.overflow_y == Overflow.Scroll ? st.scrollbar_width : 0.0
sgy := st.overflow_x == Overflow.Scroll ? st.scrollbar_width : 0.0
mut cbi := _r4add(pad, bor)
cbi.b += sgy
if rtl:
cbi.l += sgx
else:
cbi.r += sgx
end
cbx := cbi.l + cbi.r
cby := cbi.t + cbi.b
jc := st.justify_content == Align.Normal ? Align.Stretch : st.justify_content
ac := st.align_content == Align.Normal ? Align.Stretch : st.align_content
ai := st.align_items
ji := st.justify_items
kw0 := _or(inp.kw, prw)
kh0 := _or(inp.kh, prh)
mut caw := _is(kw0) ? kw0 : inp.aw
mut cah := _is(kh0) ? kh0 : inp.ah
if _def(caw):
caw = _fmax(_clampf(caw, minw, maxw), pbw)
end
if _def(cah):
cah = _fmax(_clampf(cah, minh, maxh), pbh)
end
agw := _def(caw) ? caw - cbx : caw
agh := _def(cah) ? cah - cby : cah
outer_w := _is(kw0) ? _fmax(_clampf(kw0, minw, maxw), pbw) : NO
outer_h := _is(kh0) ? _fmax(_clampf(kh0, minh, maxh), pbh) : NO
iminw := _sub(minw, cbx)
iminh := _sub(minh, cby)
imaxw := _sub(maxw, cbx)
imaxh := _sub(maxh, cby)
mut inner_w := _sub(outer_w, cbx)
mut inner_h := _sub(outer_h, cby)
if not inp.perform:
if _is(outer_w) and _is(outer_h):
ret Out { w = outer_w, h = outer_h }
end
if inp.axis == 0 and _is(outer_w):
ret Out { w = outer_w, h = 0.0 }
end
end
mut afw := _or(_or(outer_w, maxw), minw)
if _is(afw):
afw = _sub(_fmax(_clampf(afw, minw, maxw), pbw), cbx)
end
mut afh := _or(_or(outer_h, maxh), minh)
if _is(afh):
afh = _sub(_fmax(_clampf(afh, minh, maxh), pbh), cby)
end
mut creps := 0
mut rreps := 0
ccount := _tpl_count(gd.cols, afw, _is(_or(outer_w, maxw)), st.column_gap, creps)
rcount := _tpl_count(gd.rows, afh, _is(_or(outer_h, maxh)), st.row_gap, rreps)
mut ctr := Vector {} as Vector<TDef>
defer ctr.free()
mut cnames := Vector {} as Vector<LName>
defer cnames.free()
mut rtr := Vector {} as Vector<TDef>
defer rtr.free()
mut rnames := Vector {} as Vector<LName>
defer rnames.free()
_tpl_expand(gd.cols, creps, ctr, cnames)
_tpl_expand(gd.rows, rreps, rtr, rnames)
ecol := _imin(_imax(ccount, gd.area_nc), GMAX)
erow := _imin(_imax(rcount, gd.area_nr), GMAX)
kids := _kids(t, id)
defer kids.free()
mut g := GC {}
g.tr = Vector {} as Vector<GTr>
g.items = Vector {} as Vector<GIt>
defer g.tr.free()
defer g.items.free()
mut pls := Vector {} as Vector<GPlc>
defer pls.free()
mut sorted := Vector {} as Vector<int>
defer sorted.free()
repeat kids.len() in i:
c := kids[i]
cst := t.nodes.ref(c).style
if cst.display == Display.None or _oof(cst.position):
continue
end
sorted.push(i)
end
repeat sorted.len() in i:
mut j := i
until j > 0 and t.nodes.ref(kids[sorted[j - 1]]).style.order > t.nodes.ref(kids[sorted[j]]).style.order:
tmp := sorted[j]
sorted[j] = sorted[j - 1]
sorted[j - 1] = tmp
j--
end
end
each si in sorted:
c := kids[si]
cst := t.nodes.ref(c).style
pls.push(_grid_child_pl(t, c, gd, cnames, rnames, ecol, erow))
a_s := cst.align_self == Align.Auto ? ai : cst.align_self
j_s := cst.justify_self == Align.Auto ? ji : cst.justify_self
g.items.push(GIt { id = c, src = si, ovx = cst.overflow_x, ovy = cst.overflow_y, aself = a_s, jself = j_s })
end
mut cmin := 0
mut cmax := 0
mut cspan := 0
mut rmin := 0
mut rmax := 0
mut rspan := 0
each pl in pls:
mut mn := 0
mut mx := 0
mut sp := 0
_px_minmax(pl.col, mn, mx, sp)
cmin = _imin(cmin, mn)
cmax = _imax(cmax, mx)
cspan = _imax(cspan, sp)
_px_minmax(pl.row, mn, mx, sp)
rmin = _imin(rmin, mn)
rmax = _imax(rmax, mx)
rspan = _imax(rspan, sp)
end
cneg0 := cmin < 0 ? 0 - cmin : 0
mut cpos0 := cmax > ecol ? cmax - ecol : 0
if cneg0 + ecol + cpos0 < cspan:
cpos0 = cspan - ecol - cneg0
end
if cneg0 + ecol + cpos0 > GMAX:
cpos0 = _imax(0, GMAX - cneg0 - ecol)
end
rneg0 := rmin < 0 ? 0 - rmin : 0
mut rpos0 := rmax > erow ? rmax - erow : 0
if rneg0 + erow + rpos0 < rspan:
rpos0 = rspan - erow - rneg0
end
if rneg0 + erow + rpos0 > GMAX:
rpos0 = _imax(0, GMAX - rneg0 - erow)
end
mut occ := _occ_new(cneg0, ecol, cpos0, rneg0, erow, rpos0)
defer _occ_free(occ)
_place(occ, g.items, pls, st.grid_auto_flow)
g.cneg = occ.nc0
g.cexp = ecol
g.cpos = occ.nct - occ.nc0 - ecol
g.rneg = occ.nr0
g.rexp = erow
g.rpos = occ.nrt - occ.nr0 - erow
_init_tracks(g.tr, g.cneg, g.cexp, g.cpos, gd.cols, creps, gd.acols, st.column_gap, gd.cols.rep == 2, occ, 0)
g.nct = g.tr.len()
_init_tracks(g.tr, g.rneg, g.rexp, g.rpos, gd.rows, rreps, gd.arows, st.row_gap, gd.rows.rep == 2, occ, 1)
g.nrt = g.tr.len() - g.nct
repeat g.items.len() in i:
it := g.items.ref(i)
it.ci0 = 2 * (it.c0 + g.cneg)
it.ci1 = 2 * (it.c1 + g.cneg)
it.ri0 = 2 * (it.r0 + g.rneg)
it.ri1 = 2 * (it.r1 + g.rneg)
end
_g_crosses(g)
mut has_base := false
repeat g.items.len() in i:
if _g_base_part(t, g.items[i]):
has_base = true
end
end
_sizing(t, g, 0, iminw, imaxw, jc, ac, agw, agh, inner_w, inner_h, 0, has_base)
icol := _sum_base(g, 0)
if not _is(inner_w):
inner_w = icol
end
if not inp.perform and inp.axis == 0:
w := _fmax(_clampf(icol + cbx, minw, maxw), pbw)
ret Out { w = w, h = 0.0 }
end
repeat g.items.len() in i:
it := g.items.ref(i)
it.ga_ok = false
end
_sizing(t, g, 1, iminh, imaxh, ac, jc, agw, agh, inner_w, inner_h, 1, false)
irow := _sum_base(g, 1)
rsw := _or(inp.kw, prw)
rsh := _or(inp.kh, prh)
mut bw := _fmax(_clampf(_or(rsw, icol + cbx), minw, maxw), pbw)
mut bh := _fmax(_clampf(_or(rsh, irow + cby), minh, maxh), pbh)
mut cw := _fmax(0.0, bw - cbx)
mut ch := _fmax(0.0, bh - cby)
if not inp.perform:
ret Out { w = bw, h = bh }
end
inner_w = cw
inner_h = ch
hpc := _any_pct(g, 0)
hpr := _any_pct(g, 1)
mut rerun_c := not _is(outer_w) and hpc
mut cchanged := false
if not rerun_c:
cchanged = _recheck(t, g, 0, inner_w, inner_h)
rerun_c = cchanged
else:
_clear_caches(g, 0)
end
mut rerun_r := not _is(outer_h) and hpr
mut rchanged := false
if rerun_r:
_clear_caches(g, 1)
end
if rerun_c:
_sizing(t, g, 0, iminw, imaxw, jc, ac, agw, agh, inner_w, inner_h, 1, has_base)
if not rerun_r:
rchanged = _recheck(t, g, 1, inner_w, inner_h)
rerun_r = rchanged
end
end
if rerun_r:
_sizing(t, g, 1, iminh, imaxh, ac, jc, agw, agh, inner_w, inner_h, 1, false)
end
if (cchanged and not hpc) or (rchanged and not hpr):
if cchanged and not hpc:
bw = _fmax(_clampf(_or(rsw, _sum_base(g, 0) + cbx), minw, maxw), pbw)
cw = _fmax(0.0, bw - cbx)
end
if rchanged and not hpr:
bh = _fmax(_clampf(_or(rsh, _sum_base(g, 1) + cby), minh, maxh), pbh)
ch = _fmax(0.0, bh - cby)
end
end
iws := _fmax(bw - pbw, 0.0)
gx := _fmin(sgx, iws)
_align_tracks(g, 0, cw, pad.l + (rtl ? gx : 0.0), bor.l, jc, rtl)
_align_tracks(g, 1, ch, pad.t, bor.t, ac, false)
repeat g.items.len() in i:
it := g.items.ref(i)
top := g.tr[g.nct + it.ri0 + 1].off
bottom := g.tr[g.nct + it.ri1].off
mut left := 0.0
mut right := 0.0
if rtl:
left = g.tr[it.ci1 - 1].off
right = g.tr[it.ci0].off
else:
left = g.tr[it.ci0 + 1].off
right = g.tr[it.ci1].off
end
_g_position(t, it, left, right, top, bottom, ji, ai, rtl)
end
each c in kids:
cn := t.nodes.ref(c)
cst := cn.style
if cst.display == Display.None or not _oof(cst.position):
continue
end
js := cst.justify_self == Align.Auto ? ji : cst.justify_self
a_self := cst.align_self == Align.Auto ? ai : cst.align_self
cn.spx_s = bor.l + pad.l + (rtl ? sgx : 0.0)
cn.spx_e = bw - bor.r - pad.r - (rtl ? 0.0 : sgx)
cn.spx_a = _align_edge(js, rtl)
cn.spy_s = bor.t + pad.t
cn.spy_e = bh - bor.b - pad.b - sgy
cn.spy_a = _align_edge(a_self, false)
end
_hide_display_none(t, kids)
nn := t.nodes.ref(id)
nn.gi.tr.free()
nn.gi = GInfo { ok = true, nct = g.nct, nrt = g.nrt, cneg = g.cneg, cexp = g.cexp, cpos = g.cpos, rneg = g.rneg, rexp = g.rexp, rpos = g.rpos, creps = creps, rreps = rreps, w = bw, h = bh, bor = bor, sgx = sgx, sgy = sgy, rtl = rtl }
nn.gi.tr = Vector {} as Vector<GTr>
each tr in g.tr:
nn.gi.tr.push(tr)
end
if g.items.len() == 0:
ret Out { w = bw, h = bh }
end
mut first_row := g.items[0].ri0
each it in g.items:
if it.ri0 < first_row:
first_row = it.ri0
end
end
mut pick := -1
repeat g.items.len() in i:
it := g.items[i]
if it.ri0 == first_row:
if pick < 0:
pick = i
end
if _g_base_part(t, it) and not _g_base_part(t, g.items[pick]):
pick = i
end
end
end
pit := g.items[pick]
ret Out { w = bw, h = bh, baseline = pit.ypos + _or(pit.ibase, pit.hgt) }
end
func _grid_abs_area(t &: Engine, cb: int, child: int, left &: f64, right &: f64, top &: f64, bottom &: f64): bool:
cn := t.nodes.ref(cb)
gi := cn.gi
if not gi.ok:
ret false
end
gd := cn.gd
mut ctr := Vector {} as Vector<TDef>
defer ctr.free()
mut cnames := Vector {} as Vector<LName>
defer cnames.free()
mut rtr := Vector {} as Vector<TDef>
defer rtr.free()
mut rnames := Vector {} as Vector<LName>
defer rnames.free()
_tpl_expand(gd.cols, gi.creps, ctr, cnames)
_tpl_expand(gd.rows, gi.rreps, rtr, rnames)
pl := _grid_child_pl(t, child, gd, cnames, rnames, gi.cexp, gi.rexp)
ps_l := gi.bor.l + (gi.rtl ? gi.sgx : 0.0)
ps_r := gi.w - gi.bor.r - (gi.rtl ? 0.0 : gi.sgx)
ps_t := gi.bor.t
ps_b := gi.h - gi.bor.b - gi.sgy
mut cs := NOLINE
mut ce := NOLINE
_abs_lines(pl.col, cs, ce)
mut rs := NOLINE
mut re := NOLINE
_abs_lines(pl.row, rs, re)
cmin := 0 - gi.cneg
cmax := gi.cexp + gi.cpos
rmin := 0 - gi.rneg
rmax := gi.rexp + gi.rpos
if cs != NOLINE and (cs < cmin or cs > cmax):
cs = NOLINE
end
if ce != NOLINE and (ce < cmin or ce > cmax):
ce = NOLINE
end
if rs != NOLINE and (rs < rmin or rs > rmax):
rs = NOLINE
end
if re != NOLINE and (re < rmin or re > rmax):
re = NOLINE
end
ntc := (gi.nct - 1) / 2
ntr := (gi.nrt - 1) / 2
mut s_x := gi.rtl ? ps_r : ps_l
mut e_x := gi.rtl ? ps_l : ps_r
if ntc == 0:
if cs != NOLINE:
s_x = gi.tr[0].off
end
if ce != NOLINE:
e_x = gi.tr[0].off
end
else cs != NOLINE:
k := cs + gi.cneg
if k < ntc:
s_x = _abs_edge(gi, 0, k, true)
else ntc > 0:
s_x = _abs_edge(gi, 0, ntc - 1, false)
end
end
if ce != NOLINE and ntc > 0:
k := ce + gi.cneg - 1
if k >= 0 and k < ntc:
e_x = _abs_edge(gi, 0, k, false)
else ntc > 0:
e_x = _abs_edge(gi, 0, 0, true)
end
end
mut s_y := ps_t
mut e_y := ps_b
if ntr == 0:
if rs != NOLINE:
s_y = gi.tr[gi.nct].off
end
if re != NOLINE:
e_y = gi.tr[gi.nct].off
end
else rs != NOLINE:
k := rs + gi.rneg
if k < ntr:
s_y = _abs_edge(gi, 1, k, true)
else ntr > 0:
s_y = _abs_edge(gi, 1, ntr - 1, false)
end
end
if re != NOLINE and ntr > 0:
k := re + gi.rneg - 1
if k >= 0 and k < ntr:
e_y = _abs_edge(gi, 1, k, false)
else ntr > 0:
e_y = _abs_edge(gi, 1, 0, true)
end
end
if gi.rtl:
left = _fmin(s_x, e_x)
right = s_x
else:
left = s_x
right = _fmax(s_x, e_x)
end
top = s_y
bottom = _fmax(s_y, e_y)
ret true
end
func _abs_lines(p: GPx, s &: int, e &: int):
s = NOLINE
e = NOLINE
if p.k0 == GP_LINE and p.k1 == GP_LINE:
if p.v0 == p.v1:
s = p.v0
e = p.v0 + 1
else:
s = _imin(p.v0, p.v1)
e = _imax(p.v0, p.v1)
end
else p.k0 == GP_LINE and p.k1 == GP_SPAN:
s = p.v0
e = p.v0 + p.v1
else p.k0 == GP_LINE:
s = p.v0
else p.k0 == GP_SPAN and p.k1 == GP_LINE:
s = p.v1 - p.v0
e = p.v1
else p.k1 == GP_LINE:
e = p.v1
end
end
func _abs_edge(gi: GInfo, a: int, k0: int, is_start: bool): f64:
base := a == 0 ? 0 : gi.nct
nt := ((a == 0 ? gi.nct : gi.nrt) - 1) / 2
mut k := k0
if gi.tr[base + 2 * k + 1].collapsed:
mut rs := k
until rs > 0 and gi.tr[base + 2 * (rs - 1) + 1].collapsed:
rs--
end
mut re := k
until re < nt and gi.tr[base + 2 * re + 1].collapsed:
re++
end
if is_start and re < nt:
k = re
else not is_start and rs > 0:
k = rs - 1
end
end
tr := gi.tr[base + 2 * k + 1]
rev := a == 0 and gi.rtl
if is_start != rev:
ret tr.off
end
ret tr.off + tr.base
end
package cssbox
import mem
const K_AUTO := 0
const K_PX := 1
const K_PCT := 2
const K_FR := 3
const K_MINC := 4
const K_MAXC := 5
const K_FITPX := 6
const K_FITPCT := 7
const GP_AUTO := 0
const GP_LINE := 1
const GP_SPAN := 2
const GP_NLINE := 3
const GP_NSPAN := 4
const GMAX := 10000
struct TDef:
pub mk: int = 0
pub mv: f64 = 0.0
pub xk: int = 0
pub xv: f64 = 0.0
end
struct LName:
pub line: int = 0
pub name: str = ""
pub after: bool = false
end
struct GTpl:
pub ok: bool = false
pub tracks: Vector<TDef> = Vector {}
pub names: Vector<LName> = Vector {}
pub rep: int = 0
pub rep_at: int = 0
pub rtracks: Vector<TDef> = Vector {}
pub rnames: Vector<LName> = Vector {}
end
struct GArea:
pub name: str = ""
pub rs: int = 0
pub re: int = 0
pub cs: int = 0
pub ce: int = 0
end
struct GPl:
pub kind: int = 0
pub n: int = 0
pub name: str = ""
end
struct GData:
pub s_cols: str = ""
pub s_rows: str = ""
pub s_areas: str = ""
pub s_acols: str = ""
pub s_arows: str = ""
pub s_rs: str = ""
pub s_re: str = ""
pub s_cs: str = ""
pub s_ce: str = ""
pub cols: GTpl = GTpl {}
pub rows: GTpl = GTpl {}
pub areas: Vector<GArea> = Vector {}
pub area_nc: int = 0
pub area_nr: int = 0
pub acols: Vector<TDef> = Vector {}
pub arows: Vector<TDef> = Vector {}
pub prs: GPl = GPl {}
pub pre: GPl = GPl {}
pub pcs: GPl = GPl {}
pub pce: GPl = GPl {}
end
struct Sc:
pub p: u8* = null
pub n: int = 0
pub i: int = 0
pub bad: bool = false
end
inline func _sb(sc: Sc, i: int): int:
ret sc.p[i] as int
end
func _sc(s: str): Sc:
ret Sc { p = (s as void*) as u8*, n = s.len() }
end
func _ws(c: int): bool:
ret c == 32 or c == 9 or c == 10 or c == 13 or c == 12
end
func _skip_ws(sc &: Sc):
until sc.i < sc.n and _ws(_sb(sc, sc.i)):
sc.i++
end
end
func _id_char(c: int): bool:
ret (c >= 97 and c <= 122) or (c >= 65 and c <= 90) or (c >= 48 and c <= 57) or c == 45 or c == 95 or c >= 128
end
func _peek(sc &: Sc): int:
_skip_ws(sc)
if sc.i >= sc.n:
ret -1
end
ret _sb(sc, sc.i)
end
func _eat(sc &: Sc, c: int): bool:
if _peek(sc) == c:
sc.i++
ret true
end
ret false
end
func _ident(sc &: Sc): str:
_skip_ws(sc)
st := sc.i
until sc.i < sc.n and _id_char(_sb(sc, sc.i)):
sc.i++
end
if sc.i == st:
ret ""
end
ret _slice(sc, st, sc.i)
end
func _slice(sc: Sc, a: int, b: int): str:
r := mem.AllocateZeroed((b - a + 1) as u64) as u8*
repeat b - a in k:
r[k] = sc.p[a + k]
end
ret (r as void*) as str
end
func _sfree(s: str):
if s.len() > 0:
mem.Free(s as void*)
end
end
func _seq(s: str, lit: str): bool:
ret s == lit
end
func _lower_eq(s: str, lit: str): bool:
if s.len() != lit.len():
ret false
end
a := (s as void*) as u8*
b := (lit as void*) as u8*
repeat s.len() in i:
mut c := a[i] as int
if c >= 65 and c <= 90:
c += 32
end
if c != (b[i] as int):
ret false
end
end
ret true
end
func _is_num_start(sc &: Sc): bool:
c := _peek(sc)
if c >= 48 and c <= 57:
ret true
end
if (c == 45 or c == 43 or c == 46) and sc.i + 1 < sc.n:
d := _sb(sc, sc.i + 1)
ret (d >= 48 and d <= 57) or d == 46
end
ret false
end
func _number(sc &: Sc, unit &: str): f64:
_skip_ws(sc)
mut neg := false
if sc.i < sc.n and (_sb(sc, sc.i) == 45 or _sb(sc, sc.i) == 43):
neg = _sb(sc, sc.i) == 45
sc.i++
end
mut v := 0.0
mut digits := 0
until sc.i < sc.n and _sb(sc, sc.i) >= 48 and _sb(sc, sc.i) <= 57:
v = v * 10.0 + ((_sb(sc, sc.i) - 48) as f64)
sc.i++
digits++
end
if sc.i < sc.n and _sb(sc, sc.i) == 46:
sc.i++
mut f := 0.1
until sc.i < sc.n and _sb(sc, sc.i) >= 48 and _sb(sc, sc.i) <= 57:
v += f * ((_sb(sc, sc.i) - 48) as f64)
f /= 10.0
sc.i++
digits++
end
end
if digits == 0:
sc.bad = true
end
if sc.i < sc.n and (_sb(sc, sc.i) == 101 or _sb(sc, sc.i) == 69) and sc.i + 1 < sc.n:
d := _sb(sc, sc.i + 1)
if (d >= 48 and d <= 57) or d == 45 or d == 43:
sc.i++
mut eneg := false
if _sb(sc, sc.i) == 45 or _sb(sc, sc.i) == 43:
eneg = _sb(sc, sc.i) == 45
sc.i++
end
mut e := 0
until sc.i < sc.n and _sb(sc, sc.i) >= 48 and _sb(sc, sc.i) <= 57:
e = e * 10 + (_sb(sc, sc.i) - 48)
sc.i++
end
repeat e:
v = eneg ? v / 10.0 : v * 10.0
end
end
end
if neg:
v = 0.0 - v
end
st := sc.i
if sc.i < sc.n and _sb(sc, sc.i) == 37:
sc.i++
unit = "%"
ret v
end
until sc.i < sc.n and _id_char(_sb(sc, sc.i)):
sc.i++
end
if sc.i == st:
unit = ""
else:
u := _slice(sc, st, sc.i)
if _lower_eq(u, "px"):
unit = "px"
else _lower_eq(u, "fr"):
unit = "fr"
else:
unit = "?"
end
_sfree(u)
end
ret v
end
func _breadth(sc &: Sc, k &: int, v &: f64): bool:
if _is_num_start(sc):
mut unit := ""
x := _number(sc, unit)
if sc.bad:
ret false
end
v = x
if unit == "px" or (unit == "" and x == 0.0):
k = K_PX
else unit == "%":
k = K_PCT
else unit == "fr":
k = K_FR
else:
ret false
end
ret x >= 0.0
end
id := _ident(sc)
defer _sfree(id)
v = 0.0
if _lower_eq(id, "auto"):
k = K_AUTO
ret true
end
if _lower_eq(id, "min-content"):
k = K_MINC
ret true
end
if _lower_eq(id, "max-content"):
k = K_MAXC
ret true
end
ret false
end
func _track_size(sc &: Sc, d &: TDef): bool:
save := sc.i
id := _ident(sc)
if _peek(sc) == 40 and _lower_eq(id, "minmax"):
_sfree(id)
sc.i++
mut mk := 0
mut mv := 0.0
if not _breadth(sc, mk, mv) or mk == K_FR:
ret false
end
if not _eat(sc, 44):
ret false
end
mut xk := 0
mut xv := 0.0
if not _breadth(sc, xk, xv):
ret false
end
if not _eat(sc, 41):
ret false
end
d = TDef { mk = mk, mv = mv, xk = xk, xv = xv }
ret true
end
if _peek(sc) == 40 and _lower_eq(id, "fit-content"):
_sfree(id)
sc.i++
mut k := 0
mut v := 0.0
if not _breadth(sc, k, v):
ret false
end
if not _eat(sc, 41):
ret false
end
if k == K_PX:
d = TDef { mk = K_AUTO, xk = K_FITPX, xv = v }
ret true
end
if k == K_PCT:
d = TDef { mk = K_AUTO, xk = K_FITPCT, xv = v }
ret true
end
ret false
end
_sfree(id)
sc.i = save
mut k := 0
mut v := 0.0
if not _breadth(sc, k, v):
ret false
end
if k == K_FR:
d = TDef { mk = K_AUTO, xk = K_FR, xv = v }
else:
d = TDef { mk = k, mv = v, xk = k, xv = v }
end
ret true
end
func _line_names(sc &: Sc, out &: Vector<LName>, line: int, after: bool): bool:
if not _eat(sc, 91):
ret true
end
until true:
if _eat(sc, 93):
ret true
end
id := _ident(sc)
if id.len() == 0:
ret false
end
if _lower_eq(id, "span") or _lower_eq(id, "auto"):
_sfree(id)
ret false
end
out.push(LName { line = line, name = id, after = after })
end
end
func _free_names(v &: Vector<LName>):
each nm in v:
_sfree(nm.name)
end
v.free()
end
func _tpl_free(g &: GTpl):
g.tracks.free()
_free_names(g.names)
g.rtracks.free()
_free_names(g.rnames)
g.ok = false
end
func _fixed(k: int): bool:
ret k == K_PX or k == K_PCT
end
func _tpl_parse(s: str): GTpl:
mut g := GTpl {}
g.tracks = Vector {} as Vector<TDef>
g.names = Vector {} as Vector<LName>
g.rtracks = Vector {} as Vector<TDef>
g.rnames = Vector {} as Vector<LName>
mut sc := _sc(s)
if _peek(sc) < 0:
ret g
end
save := sc.i
first := _ident(sc)
if _lower_eq(first, "none") and _peek(sc) < 0:
_sfree(first)
ret g
end
_sfree(first)
sc.i = save
mut ok := true
mut after := false
until ok:
if not _line_names(sc, g.names, g.tracks.len(), after):
ok = false
break
end
if _peek(sc) < 0:
break
end
save2 := sc.i
id := _ident(sc)
if _peek(sc) == 40 and _lower_eq(id, "repeat"):
_sfree(id)
sc.i++
mut count := 0
mut kind := 0
if _is_num_start(sc):
mut unit := ""
c := _number(sc, unit)
if unit != "" or c < 1.0 or sc.bad:
ok = false
break
end
count = c as int
else:
kw := _ident(sc)
if _lower_eq(kw, "auto-fill"):
kind = 1
else _lower_eq(kw, "auto-fit"):
kind = 2
else:
ok = false
end
_sfree(kw)
if not ok:
break
end
end
if not _eat(sc, 44):
ok = false
break
end
mut rt := Vector {} as Vector<TDef>
mut rn := Vector {} as Vector<LName>
until ok:
if not _line_names(sc, rn, rt.len(), false):
ok = false
break
end
if _eat(sc, 41):
break
end
mut d := TDef {}
if not _track_size(sc, d):
ok = false
break
end
rt.push(d)
end
if ok and rt.len() == 0:
ok = false
end
if not ok:
rt.free()
_free_names(rn)
break
end
if kind == 0:
mut reps := count
if g.tracks.len() + reps * rt.len() > GMAX:
reps = (GMAX - g.tracks.len()) / rt.len() + 1
end
repeat reps:
base := g.tracks.len()
each nm in rn:
g.names.push(LName { line = base + nm.line, name = _clone_s(nm.name), after = after })
end
each d in rt:
g.tracks.push(d)
end
end
rt.free()
_free_names(rn)
else:
if g.rep != 0:
ok = false
rt.free()
_free_names(rn)
break
end
g.rep = kind
g.rep_at = g.tracks.len()
g.rtracks.free()
g.rtracks = rt
_free_names(g.rnames)
g.rnames = rn
after = true
end
continue
end
_sfree(id)
sc.i = save2
mut d := TDef {}
if not _track_size(sc, d):
ok = false
break
end
g.tracks.push(d)
end
if ok and g.rep != 0:
each d in g.tracks:
if not (_fixed(d.mk) or _fixed(d.xk)):
ok = false
end
end
each d in g.rtracks:
if not (_fixed(d.mk) or _fixed(d.xk)):
ok = false
end
end
end
if not ok or (g.tracks.len() == 0 and g.rep == 0):
_tpl_free(g)
g.tracks = Vector {} as Vector<TDef>
g.names = Vector {} as Vector<LName>
g.rtracks = Vector {} as Vector<TDef>
g.rnames = Vector {} as Vector<LName>
g.ok = false
g.rep = 0
ret g
end
g.ok = true
ret g
end
func _clone_s(s: str): str:
if s.len() == 0:
ret ""
end
sc := _sc(s)
ret _slice(sc, 0, s.len())
end
func _auto_list(s: str): Vector<TDef>:
mut out := Vector {} as Vector<TDef>
mut sc := _sc(s)
until _peek(sc) >= 0:
mut d := TDef {}
if not _track_size(sc, d):
out.clear()
break
end
out.push(d)
end
ret out
end
func _place_parse(s: str): GPl:
mut sc := _sc(s)
mut span := false
mut has_n := false
mut n := 0
mut name := ""
mut bad := false
until _peek(sc) >= 0:
if _is_num_start(sc):
mut unit := ""
v := _number(sc, unit)
if has_n or unit != "" or sc.bad:
bad = true
break
end
has_n = true
n = v as int
continue
end
id := _ident(sc)
if id.len() == 0:
bad = true
break
end
if _lower_eq(id, "span"):
_sfree(id)
if span:
bad = true
break
end
span = true
continue
end
if _lower_eq(id, "auto"):
_sfree(id)
if span or has_n or name.len() > 0 or _peek(sc) >= 0:
bad = true
end
break
end
if name.len() > 0:
_sfree(id)
bad = true
break
end
name = id
end
if bad or (has_n and n == 0) or (span and has_n and n < 0):
_sfree(name)
ret GPl {}
end
if span:
if name.len() > 0:
ret GPl { kind = GP_NSPAN, n = has_n ? n : 1, name = name }
end
ret GPl { kind = GP_SPAN, n = has_n ? n : 1 }
end
if name.len() > 0:
ret GPl { kind = GP_NLINE, n = has_n ? n : 0, name = name }
end
if has_n:
ret GPl { kind = GP_LINE, n = n }
end
ret GPl {}
end
func _areas_parse(s: str, areas &: Vector<GArea>, nc &: int, nr &: int):
nc = 0
nr = 0
mut sc := _sc(s)
mut cells := Vector {} as Vector<str>
defer cells.free()
mut bad := false
until _peek(sc) >= 0:
q := _peek(sc)
if q != 34 and q != 39:
bad = true
break
end
sc.i++
mut row := 0
until sc.i < sc.n and _sb(sc, sc.i) != q:
c := _sb(sc, sc.i)
if _ws(c):
sc.i++
continue
end
if c == 46:
until sc.i < sc.n and _sb(sc, sc.i) == 46:
sc.i++
end
cells.push("")
row++
continue
end
st := sc.i
until sc.i < sc.n and _id_char(_sb(sc, sc.i)):
sc.i++
end
if sc.i == st:
bad = true
break
end
cells.push(_slice(sc, st, sc.i))
row++
end
if bad or sc.i >= sc.n:
bad = true
break
end
sc.i++
if row == 0 or (nr > 0 and row != nc):
bad = true
break
end
nc = row
nr++
end
if not bad:
repeat cells.len() in k:
nm := cells[k]
if nm.len() == 0:
continue
end
mut found := -1
repeat areas.len() in a:
if areas[a].name == nm:
found = a
end
end
r := k / nc
c := k % nc
if found < 0:
areas.push(GArea { name = _clone_s(nm), rs = r + 1, re = r + 2, cs = c + 1, ce = c + 2 })
else:
mut ar := areas[found]
if r + 2 > ar.re:
ar.re = r + 2
end
if c + 2 > ar.ce:
ar.ce = c + 2
end
areas[found] = ar
end
end
each ar in areas:
repeat ar.re - ar.rs in rr:
repeat ar.ce - ar.cs in cc:
k := (ar.rs - 1 + rr) * nc + ar.cs - 1 + cc
if cells[k] != ar.name:
bad = true
end
end
end
end
mut cnt := 0
each nm in cells:
if nm.len() > 0:
cnt++
end
end
mut tot := 0
each ar in areas:
tot += (ar.re - ar.rs) * (ar.ce - ar.cs)
end
if tot != cnt:
bad = true
end
end
each nm in cells:
_sfree(nm)
end
if bad:
each ar in areas:
_sfree(ar.name)
end
areas.clear()
nc = 0
nr = 0
end
end
func _gd_free(g &: GData):
_sfree(g.s_cols)
_sfree(g.s_rows)
_sfree(g.s_areas)
_sfree(g.s_acols)
_sfree(g.s_arows)
_sfree(g.s_rs)
_sfree(g.s_re)
_sfree(g.s_cs)
_sfree(g.s_ce)
_tpl_free(g.cols)
_tpl_free(g.rows)
each ar in g.areas:
_sfree(ar.name)
end
g.areas.free()
g.acols.free()
g.arows.free()
_sfree(g.prs.name)
_sfree(g.pre.name)
_sfree(g.pcs.name)
_sfree(g.pce.name)
g = GData {}
end
func _gd_set(g &: GData, st &: Style):
if st.grid_template_columns != g.s_cols:
_sfree(g.s_cols)
_tpl_free(g.cols)
g.s_cols = _clone_s(st.grid_template_columns)
g.cols = _tpl_parse(g.s_cols)
end
if st.grid_template_rows != g.s_rows:
_sfree(g.s_rows)
_tpl_free(g.rows)
g.s_rows = _clone_s(st.grid_template_rows)
g.rows = _tpl_parse(g.s_rows)
end
if st.grid_template_areas != g.s_areas:
_sfree(g.s_areas)
each ar in g.areas:
_sfree(ar.name)
end
g.areas.clear()
g.s_areas = _clone_s(st.grid_template_areas)
_areas_parse(g.s_areas, g.areas, g.area_nc, g.area_nr)
end
if st.grid_auto_columns != g.s_acols:
_sfree(g.s_acols)
g.acols.free()
g.s_acols = _clone_s(st.grid_auto_columns)
g.acols = _auto_list(g.s_acols)
end
if st.grid_auto_rows != g.s_arows:
_sfree(g.s_arows)
g.arows.free()
g.s_arows = _clone_s(st.grid_auto_rows)
g.arows = _auto_list(g.s_arows)
end
if st.grid_row_start != g.s_rs:
_sfree(g.s_rs)
_sfree(g.prs.name)
g.s_rs = _clone_s(st.grid_row_start)
g.prs = _place_parse(g.s_rs)
end
if st.grid_row_end != g.s_re:
_sfree(g.s_re)
_sfree(g.pre.name)
g.s_re = _clone_s(st.grid_row_end)
g.pre = _place_parse(g.s_re)
end
if st.grid_column_start != g.s_cs:
_sfree(g.s_cs)
_sfree(g.pcs.name)
g.s_cs = _clone_s(st.grid_column_start)
g.pcs = _place_parse(g.s_cs)
end
if st.grid_column_end != g.s_ce:
_sfree(g.s_ce)
_sfree(g.pce.name)
g.s_ce = _clone_s(st.grid_column_end)
g.pce = _place_parse(g.s_ce)
end
st.grid_template_columns = g.s_cols
st.grid_template_rows = g.s_rows
st.grid_template_areas = g.s_areas
st.grid_auto_columns = g.s_acols
st.grid_auto_rows = g.s_arows
st.grid_row_start = g.s_rs
st.grid_row_end = g.s_re
st.grid_column_start = g.s_cs
st.grid_column_end = g.s_ce
end
@en "IsTrackList"
@fa "فهرست ردیف معتبر است"
pub func IsTrackList(text: str): bool:
sc := _sc(text)
mut s2 := sc
first := _ident(s2)
if _lower_eq(first, "none") and _peek(s2) < 0:
_sfree(first)
ret true
end
_sfree(first)
mut g := _tpl_parse(text)
ok := g.ok
_tpl_free(g)
ret ok
end
@en "IsTrackSizes"
@fa "اندازه های ردیف معتبر است"
pub func IsTrackSizes(text: str): bool:
mut sc := _sc(text)
if _peek(sc) < 0:
ret false
end
mut v := _auto_list(text)
ok := v.len() > 0
v.free()
ret ok
end
@en "IsGridLine"
@fa "خط شبکه معتبر است"
pub func IsGridLine(text: str): bool:
mut sc := _sc(text)
if _peek(sc) < 0:
ret false
end
id := _ident(sc)
if _lower_eq(id, "auto") and _peek(sc) < 0:
_sfree(id)
ret true
end
_sfree(id)
p := _place_parse(text)
ok := p.kind != GP_AUTO
_sfree(p.name)
ret ok
end
@en "IsGridAreas"
@fa "نواحی شبکه معتبر است"
pub func IsGridAreas(text: str): bool:
mut sc := _sc(text)
if _peek(sc) < 0:
ret false
end
id := _ident(sc)
if _lower_eq(id, "none") and _peek(sc) < 0:
_sfree(id)
ret true
end
_sfree(id)
mut areas := Vector {} as Vector<GArea>
mut nc := 0
mut nr := 0
_areas_parse(text, areas, nc, nr)
each ar in areas:
_sfree(ar.name)
end
areas.free()
ret nc > 0
end
package cssbox
func _call_measure(t &: Engine, id: int, kw: f64, kh: f64, aw: f64, ah: f64): MeasureOutput:
n := t.nodes.ref(id)
if _is(kw) and _is(kh):
ret MeasureOutput { width = kw, height = kh }
end
if not n.has_measure:
ret MeasureOutput { width = _or(kw, 0.0), height = _or(kh, 0.0) }
end
t.measure_calls++
mi := MeasureInput { node = id, known_width = _or(kw, 0.0), has_known_width = _is(kw), known_height = _or(kh, 0.0), has_known_height = _is(kh), available_width = _space_in(aw), available_height = _space_in(ah) }
mut m := n.measure(mi)
if _is(kw):
m.width = kw
end
if _is(kh):
m.height = kh
end
ret m
end
func _leaf(t &: Engine, id: int, inp: Inp): Out:
n := t.nodes.ref(id)
pad := _r4(n.style.padding, inp.pw)
bor := _r4(n.style.border, inp.pw)
pbw := pad.l + pad.r + bor.l + bor.r
pbh := pad.t + pad.b + bor.t + bor.b
adjw := n.style.box_sizing == BoxSizing.ContentBox ? pbw : 0.0
adjh := n.style.box_sizing == BoxSizing.ContentBox ? pbh : 0.0
mut nw := inp.kw
mut nh := inp.kh
mut minw := NO
mut minh := NO
mut maxw := NO
mut maxh := NO
mut ratio := 0.0
if inp.inherent:
ratio = n.style.aspect_ratio
sw0 := _res(n.style.width, inp.pw)
sh0 := _res(n.style.height, inp.ph)
sw := _add(_arw(sw0, sh0, ratio), adjw)
sh := _add(_arh(sw0, sh0, ratio), adjh)
mnw0 := _res(n.style.min_width, inp.pw)
mnh0 := _res(n.style.min_height, inp.ph)
minw = _add(_arw(mnw0, mnh0, ratio), adjw)
minh = _add(_arh(mnw0, mnh0, ratio), adjh)
maxw = _add(_res(n.style.max_width, inp.pw), adjw)
maxh = _add(_res(n.style.max_height, inp.ph), adjh)
nw = _or(inp.kw, sw)
nh = _or(inp.kh, sh)
end
sgx := n.style.overflow_y == Overflow.Scroll ? n.style.scrollbar_width : 0.0
sgy := n.style.overflow_x == Overflow.Scroll ? n.style.scrollbar_width : 0.0
insw := pbw + sgx
insh := pbh + sgy
is_scroll := _scroller(n.style.overflow_x) or _scroller(n.style.overflow_y)
d := n.style.display
prevent := d != Display.Block or is_scroll or _oof(n.style.position) or pad.t > 0.0 or pad.b > 0.0 or bor.t > 0.0 or bor.b > 0.0 or (_is(nh) and nh > 0.0) or (_is(minh) and minh > 0.0)
if not inp.perform and prevent and _is(nw) and _is(nh):
ret Out { w = _fmax(_clampf(nw, minw, maxw), pbw), h = _fmax(_clampf(nh, minh, maxh), pbh) }
end
mut aw := _avset(_avset(_is(inp.kw) ? inp.kw : inp.aw, inp.kw), nw)
if _def(aw):
aw = _clampf(aw, minw, maxw) - insw
end
mut ah := _avset(_avset(_is(inp.kh) ? inp.kh : inp.ah, inp.kh), nh)
if _def(ah):
ah = _clampf(ah, minh, maxh) - insh
end
mkw := inp.perform ? NO : inp.kw
mkh := inp.perform ? NO : inp.kh
m := _call_measure(t, id, mkw, mkh, aw, ah)
mut cw := _is(inp.kw) ? inp.kw : (_is(nw) ? nw : m.width + insw)
mut ch := _is(inp.kh) ? inp.kh : (_is(nh) ? nh : m.height + insh)
cw = _clampf(cw, minw, maxw)
ch = _clampf(ch, minh, maxh)
if ratio > 0.0:
ch = _fmax(ch, cw / ratio)
end
cw = _fmax(cw, pbw)
ch = _fmax(ch, pbh)
if inp.perform:
n2 := t.nodes.ref(id)
n2.cmw = m.width
n2.cmh = m.height
end
mut o := Out { w = cw, h = ch }
if m.has_baseline:
o.baseline = pad.t + bor.t + m.baseline
end
o.collapse = not prevent and ch == 0.0 and m.height == 0.0
ret o
end
package cssbox
struct OAxis:
pub cb: f64 = 0.0
pub ins_s: f64 = NO
pub ins_e: f64 = NO
pub mar_s: f64 = NO
pub mar_e: f64 = NO
pub sp_s: f64 = 0.0
pub sp_e: f64 = 0.0
pub sp_a: int = 0
pub align: int = 0
pub inl: bool = false
pub reversed: bool = false
end
struct Span:
pub s: f64 = 0.0
pub e: f64 = 0.0
end
func _oa_imcb(a: OAxis): Span:
mut sp := Span {}
mut weaker_start := false
if _is(a.ins_s) and _is(a.ins_e):
sp = Span { s = a.ins_s, e = a.cb - a.ins_e }
weaker_start = a.reversed
else _is(a.ins_s):
sp = Span { s = a.ins_s, e = a.cb }
weaker_start = false
else _is(a.ins_e):
sp = Span { s = 0.0, e = a.cb - a.ins_e }
weaker_start = true
else:
switch a.sp_a:
0:
sp = Span { s = a.sp_s, e = a.cb }
break
end
1:
sp = Span { s = 0.0, e = a.sp_e }
break
end
else:
c := (a.sp_s + a.sp_e) / 2.0
sd := c
ed := a.cb - c
sda := sd < 0.0 ? 0.0 - sd : sd
eda := ed < 0.0 ? 0.0 - ed : ed
if sda <= eda:
sp = Span { s = 0.0, e = 2.0 * sd }
else:
sp = Span { s = a.cb - 2.0 * ed, e = a.cb }
end
end
end
weaker_start = a.reversed
end
if sp.e < sp.s:
if weaker_start:
sp.s = sp.e
else:
sp.e = sp.s
end
end
ret sp
end
func _oa_stretch_fit(a: OAxis): f64:
sp := _oa_imcb(a)
ret _fmax(sp.e - sp.s - _or(a.mar_s, 0.0) - _or(a.mar_e, 0.0), 0.0)
end
func _oa_is_stretch(a: OAxis): bool:
ret _is(a.ins_s) and _is(a.ins_e) and (a.align == 0 or a.align == 1)
end
func _oa_margins(a: OAxis, size: f64): Span:
both := _is(a.ins_s) and _is(a.ins_e)
sp := _oa_imcb(a)
free := sp.e - sp.s - size
if _is(a.mar_s) and _is(a.mar_e):
ret Span { s = a.mar_s, e = a.mar_e }
end
if not both:
ret Span { s = _or(a.mar_s, 0.0), e = _or(a.mar_e, 0.0) }
end
if _is(a.mar_s):
ret Span { s = a.mar_s, e = free - a.mar_s }
end
if _is(a.mar_e):
ret Span { s = free - a.mar_e, e = a.mar_e }
end
if free < 0.0 and a.inl:
if a.reversed:
ret Span { s = free, e = 0.0 }
end
ret Span { s = 0.0, e = free }
end
ret Span { s = free / 2.0, e = free / 2.0 }
end
func _align_in(s: f64, e: f64, size: f64, edge: int): f64:
switch edge:
0:
ret s
end
1:
ret e - size
end
else:
ret (s + e - size) / 2.0
end
end
ret s
end
func _oa_position(a: OAxis, size: f64, m: Span): f64:
sp := _oa_imcb(a)
hs := _is(a.ins_s)
he := _is(a.ins_e)
if not hs and not he:
mbs := size + m.s + m.e
ret _align_in(a.sp_s, a.sp_e, mbs, a.sp_a) + m.s
end
if hs and not he:
ret sp.s + m.s
end
if he and not hs:
ret sp.e - size - m.e
end
if not _is(a.mar_s) or not _is(a.mar_e):
ret sp.s + m.s
end
mbs := size + m.s + m.e
imcb_size := sp.e - sp.s
mut edge := 0
switch a.align:
3:
edge = 2
break
end
4:
edge = a.reversed ? 0 : 1
break
end
else:
edge = a.reversed ? 1 : 0
end
end
start_edge := a.reversed ? 1 : 0
mut mstart := 0.0
if mbs <= imcb_size or a.align == 0:
mstart = _align_in(sp.s, sp.e, mbs, edge)
else:
ls := _fmin(sp.s, 0.0)
le := _fmax(sp.e, a.cb)
if mbs <= le - ls:
st := _align_in(sp.s, sp.e, mbs, edge)
mstart = _fmax(_fmin(st, le - mbs), ls)
else:
mstart = _align_in(ls, le, mbs, start_edge)
end
end
ret mstart + m.s
end
func _align_code(a: Align): int:
switch a:
Align.Stretch:
ret 1
end
Align.Center:
ret 3
end
Align.End, Align.FlexEnd:
ret 4
end
Align.Start, Align.FlexStart, Align.Baseline:
ret 2
end
else:
ret 0
end
end
ret 0
end
func _oof_box(t &: Engine, id: int, aw: f64, ah: f64, ox: f64, oy: f64, cb_rtl: bool, spxs: f64, spxe: f64, spxa: int, spys: f64, spye: f64, spya: int):
n := t.nodes.ref(id)
st := n.style
ratio := st.aspect_ratio
pad := _r4(st.padding, aw)
bor := _r4(st.border, aw)
mar := _r4opt(st.margin, aw)
pbw := pad.l + pad.r + bor.l + bor.r
pbh := pad.t + pad.b + bor.t + bor.b
adjw := st.box_sizing == BoxSizing.ContentBox ? pbw : 0.0
adjh := st.box_sizing == BoxSizing.ContentBox ? pbh : 0.0
left := _res(st.inset.left, aw)
right := _res(st.inset.right, aw)
top := _res(st.inset.top, ah)
bottom := _res(st.inset.bottom, ah)
sw0 := _res(st.width, aw)
sh0 := _res(st.height, ah)
ssw := _add(_arw(sw0, sh0, ratio), adjw)
ssh := _add(_arh(sw0, sh0, ratio), adjh)
mnw0 := _res(st.min_width, aw)
mnh0 := _res(st.min_height, ah)
minw := _fmax(_or(_add(_arw(mnw0, mnh0, ratio), adjw), pbw), pbw)
minh := _fmax(_or(_add(_arh(mnw0, mnh0, ratio), adjh), pbh), pbh)
mxw0 := _res(st.max_width, aw)
mxh0 := _res(st.max_height, ah)
maxw := _add(_arw(mxw0, mxh0, ratio), adjw)
maxh := _add(_arh(mxw0, mxh0, ratio), adjh)
mut kw := _clamp(ssw, minw, maxw)
mut kh := _clamp(ssh, minh, maxh)
hx := OAxis { cb = aw, ins_s = left, ins_e = right, mar_s = mar.l, mar_e = mar.r, sp_s = spxs - ox, sp_e = spxe - ox, sp_a = spxa, align = _align_code(st.justify_self), inl = true, reversed = cb_rtl }
vy := OAxis { cb = ah, ins_s = top, ins_e = bottom, mar_s = mar.t, mar_e = mar.b, sp_s = spys - oy, sp_e = spye - oy, sp_a = spya, align = _align_code(st.align_self), inl = false, reversed = false }
sfw := _oa_stretch_fit(hx)
sfh := _oa_stretch_fit(vy)
avw := _clampf(sfw, minw, maxw)
avh := _clampf(sfh, minh, maxh)
if _iskeyword(st.width) and not _is(kw):
mut ex := NO
sw := _fmax(aw - _or(left, 0.0) - _or(right, 0.0) - _or(mar.l, 0.0) - _or(mar.r, 0.0), 0.0)
kav := _keyword_avail(st.width, sw, ex)
if _is(ex):
kw = ex
else kav != NO:
sh := _fmax(ah - _or(top, 0.0) - _or(bottom, 0.0) - _or(mar.t, 0.0) - _or(mar.b, 0.0), 0.0)
kw = _measure(t, id, NO, kh, aw, ah, kav, sh, 0)
end
kh = _arh(kw, kh, ratio)
kw = _clamp(kw, minw, maxw)
kh = _clamp(kh, minh, maxh)
end
if _iskeyword(st.height) and not _is(kh):
mut ex := NO
sh := _fmax(ah - _or(top, 0.0) - _or(bottom, 0.0) - _or(mar.t, 0.0) - _or(mar.b, 0.0), 0.0)
kav := _keyword_avail(st.height, sh, ex)
if _is(ex):
kh = ex
else kav != NO:
sw := _fmax(aw - _or(left, 0.0) - _or(right, 0.0) - _or(mar.l, 0.0) - _or(mar.r, 0.0), 0.0)
kh = _measure(t, id, kw, NO, aw, ah, _or(kw, sw), kav, 1)
end
kw = _arw(kw, kh, ratio)
kw = _clamp(kw, minw, maxw)
kh = _clamp(kh, minh, maxh)
end
stw := not _is(kw) and _oa_is_stretch(hx)
sth := not _is(kh) and _oa_is_stretch(vy)
if stw:
kw = sfw
nkh := _arh(kw, kh, ratio)
kw = _clamp(kw, minw, maxw)
kh = _clamp(nkh, minh, maxh)
end
if not _is(kh) and sth:
kh = sfh
nkw := _arw(kw, kh, ratio)
kw = _clamp(nkw, minw, maxw)
kh = _clamp(kh, minh, maxh)
end
mut fw := kw
mut fh := kh
if not _is(fw) or not _is(fh):
o := _layout(t, id, Inp { kw = kw, kh = kh, pw = aw, ph = ah, aw = avw, ah = avh, axis = 2 })
fw = _or(kw, o.w)
fh = _or(kh, o.h)
end
fw = _clampf(fw, minw, maxw)
fh = _clampf(fh, minh, maxh)
_layout(t, id, Inp { kw = fw, kh = fh, pw = aw, ph = ah, aw = avw, ah = avh, axis = 2, perform = true })
hm := _oa_margins(hx, fw)
vm := _oa_margins(vy, fh)
x := _oa_position(hx, fw, hm) + ox
y := _oa_position(vy, fh, vm) + oy
_set_layout(t, id, x, y, fw, fh, pad, bor, R4 { l = hm.s, r = hm.e, t = vm.s, b = vm.e })
end
func _cb_area(t &: Engine, cb: int, ax &: f64, ay &: f64, aw &: f64, ah &: f64, rtl &: bool):
c := t.nodes.ref(cb)
crtl := c.style.direction == Direction.Rtl
ax = c.ax + c.bor.l + (crtl ? c.sbw : 0.0)
ay = c.ay + c.bor.t
aw = c.lw - c.bor.l - c.bor.r - c.sbw
ah = c.lh - c.bor.t - c.bor.b - c.sbh
rtl = crtl
end
func _post(t &: Engine, id: int, root: int):
n := t.nodes.ref(id)
pax := n.ax
pay := n.ay
nk := n.children.len()
repeat nk in i:
c := t.nodes.ref(id).children.get(i)
cn := t.nodes.ref(c)
d := cn.style.display
if d == Display.None:
_post_hidden(t, c, pax, pay)
continue
end
if d == Display.Contents:
_set_zero(t, c)
cz := t.nodes.ref(c)
cz.ax = pax
cz.ay = pay
_post(t, c, root)
continue
end
if _oof(cn.style.position):
mut cb := -1
if cn.style.position == Position.Absolute:
mut p := id
until p >= 0 and cb < 0:
pn := t.nodes.ref(p)
if pn.style.position != Position.Static or p == root:
if pn.style.display != Display.Contents:
cb = p
end
end
if p == root:
break
end
p = pn.parent
end
end
mut ax := 0.0
mut ay := 0.0
mut aw := 0.0
mut ah := 0.0
mut rtl := false
if cb >= 0 and not (cb == root and t.nodes.ref(root).style.position == Position.Static and _def(t.vw) and _def(t.vh)):
_cb_area(t, cb, ax, ay, aw, ah, rtl)
else _def(t.vw) and _def(t.vh):
rn := t.nodes.ref(root)
ax = 0.0
ay = 0.0
aw = _fmax(t.vw - rn.sbw, 0.0)
ah = _fmax(t.vh - rn.sbh, 0.0)
rtl = rn.style.direction == Direction.Rtl
else:
_cb_area(t, root, ax, ay, aw, ah, rtl)
end
cn2 := t.nodes.ref(c)
cn2.cb = cb
if cn.style.position == Position.Fixed or (cb == root and t.nodes.ref(root).style.position == Position.Static and _def(t.vw) and _def(t.vh)):
cn2.cb = -1
end
t.oofs.push(c)
mut dx := pax - ax
mut dy := pay - ay
mut sxs := cn2.spx_s + dx
mut sxe := cn2.spx_e + dx
mut sxa := cn2.spx_a
mut sys := cn2.spy_s + dy
mut sye := cn2.spy_e + dy
mut sya := cn2.spy_a
if cn2.cb >= 0:
gcb := t.nodes.ref(cn2.cb)
gdisp := gcb.style.display
if gdisp == Display.Grid or gdisp == Display.InlineGrid:
mut gl := 0.0
mut gr := 0.0
mut gtp := 0.0
mut gb := 0.0
if _grid_abs_area(t, cn2.cb, c, gl, gr, gtp, gb):
gcb2 := t.nodes.ref(cn2.cb)
ax = gcb2.ax + gl
ay = gcb2.ay + gtp
aw = gr - gl
ah = gb - gtp
dx = pax - ax
dy = pay - ay
sxs = cn2.spx_s + dx
sxe = cn2.spx_e + dx
sys = cn2.spy_s + dy
sye = cn2.spy_e + dy
if cn2.cb == id:
cst := t.nodes.ref(c).style
gst := t.nodes.ref(cn2.cb).style
js := cst.justify_self == Align.Auto ? gst.justify_items : cst.justify_self
a_self := cst.align_self == Align.Auto ? gst.align_items : cst.align_self
sxs = 0.0
sxe = aw
sxa = _align_edge(js, rtl)
sys = 0.0
sye = ah
sya = _align_edge(a_self, false)
end
end
end
end
_oof_box(t, c, aw, ah, 0.0, 0.0, rtl, sxs, sxe, sxa, sys, sye, sya)
cn3 := t.nodes.ref(c)
cn3.lx = cn3.lx + ax - pax
cn3.ly = cn3.ly + ay - pay
end
cn4 := t.nodes.ref(c)
cn4.ax = pax + cn4.lx
cn4.ay = pay + cn4.ly
_post(t, c, root)
end
end
func _post_hidden(t &: Engine, id: int, pax: f64, pay: f64):
_set_zero(t, id)
n := t.nodes.ref(id)
n.ax = pax
n.ay = pay
each c in n.children:
_post_hidden(t, c, pax, pay)
end
end
func _union_child(t &: Engine, pid: int, c: int, ox: f64, oy: f64, scroll: bool, r &: R4):
cn := t.nodes.ref(c)
d := cn.style.display
if d == Display.None:
ret
end
if d == Display.Contents:
each g in cn.children:
_union_child(t, pid, g, ox, oy, scroll, r)
end
ret
end
if _oof(cn.style.position):
ret
end
x0 := ox + cn.lx
y0 := oy + cn.ly
r.l = _fmin(r.l, x0)
r.t = _fmin(r.t, y0)
r.r = _fmax(r.r, x0 + cn.lw)
r.b = _fmax(r.b, y0 + cn.lh)
clips := cn.style.overflow_x != Overflow.Visible or cn.style.overflow_y != Overflow.Visible
if not clips:
r.l = _fmin(r.l, x0 + cn.ovl)
r.t = _fmin(r.t, y0 + cn.ovt)
r.r = _fmax(r.r, x0 + cn.ovr)
r.b = _fmax(r.b, y0 + cn.ovb)
end
if scroll:
p := t.nodes.ref(pid)
r.r = _fmax(r.r, x0 + cn.lw + cn.mar.r + p.pad.r)
r.b = _fmax(r.b, y0 + cn.lh + cn.mar.b + p.pad.b)
end
end
func _overflow(t &: Engine, id: int):
n := t.nodes.ref(id)
if n.style.display == Display.None:
ret
end
each c in n.children:
_overflow(t, c)
end
n2 := t.nodes.ref(id)
if n2.style.display == Display.Contents:
n2.ovl = 0.0
n2.ovt = 0.0
n2.ovr = 0.0
n2.ovb = 0.0
ret
end
rtl := n2.style.direction == Direction.Rtl
pl := n2.bor.l + (rtl ? n2.sbw : 0.0)
pt := n2.bor.t
pr := n2.lw - n2.bor.r - (rtl ? 0.0 : n2.sbw)
pb := n2.lh - n2.bor.b - n2.sbh
mut r := R4 { l = pl, t = pt, r = _fmax(pr, pl), b = _fmax(pb, pt) }
scroll := _scroller(n2.style.overflow_x) or _scroller(n2.style.overflow_y)
if n2.children.len() == 0:
endp := scroll ? n2.pad.r : 0.0
endb := scroll ? n2.pad.b : 0.0
if rtl:
r.l = _fmin(r.l, pr - n2.pad.r - n2.cmw - (scroll ? n2.pad.l : 0.0))
else:
r.r = _fmax(r.r, pl + n2.pad.l + n2.cmw + endp)
end
r.b = _fmax(r.b, pt + n2.pad.t + n2.cmh + endb)
else:
each c in n2.children:
_union_child(t, id, c, 0.0, 0.0, scroll, r)
end
end
each o in t.oofs:
ob := t.nodes.ref(o)
if ob.cb == id:
x0 := ob.ax - n2.ax
y0 := ob.ay - n2.ay
r.l = _fmin(r.l, x0)
r.t = _fmin(r.t, y0)
r.r = _fmax(r.r, x0 + ob.lw)
r.b = _fmax(r.b, y0 + ob.lh)
if ob.style.overflow_x == Overflow.Visible and ob.style.overflow_y == Overflow.Visible:
r.l = _fmin(r.l, x0 + ob.ovl)
r.t = _fmin(r.t, y0 + ob.ovt)
r.r = _fmax(r.r, x0 + ob.ovr)
r.b = _fmax(r.b, y0 + ob.ovb)
end
end
end
n3 := t.nodes.ref(id)
n3.ovl = r.l
n3.ovt = r.t
n3.ovr = r.r
n3.ovb = r.b
end
func _rnd(t &: Engine, v: f64): f64:
if t.rounding:
ret _round(v)
end
ret v
end
func _finalize(t &: Engine, id: int, cx0: f64, cy0: f64):
n := t.nodes.ref(id)
cx := cx0 + n.lx
cy := cy0 + n.ly
mut b := BoxLayout {}
b.x = _rnd(t, cx) - _rnd(t, cx0)
b.y = _rnd(t, cy) - _rnd(t, cy0)
b.abs_x = _rnd(t, cx)
b.abs_y = _rnd(t, cy)
b.width = _rnd(t, cx + n.lw) - _rnd(t, cx)
b.height = _rnd(t, cy + n.lh) - _rnd(t, cy)
b.border = Edges { left = _rnd(t, cx + n.bor.l) - _rnd(t, cx), right = _rnd(t, cx + n.lw) - _rnd(t, cx + n.lw - n.bor.r), top = _rnd(t, cy + n.bor.t) - _rnd(t, cy), bottom = _rnd(t, cy + n.lh) - _rnd(t, cy + n.lh - n.bor.b) }
b.padding = Edges { left = _rnd(t, cx + n.bor.l + n.pad.l) - _rnd(t, cx + n.bor.l), right = _rnd(t, cx + n.lw - n.bor.r) - _rnd(t, cx + n.lw - n.bor.r - n.pad.r), top = _rnd(t, cy + n.bor.t + n.pad.t) - _rnd(t, cy + n.bor.t), bottom = _rnd(t, cy + n.lh - n.bor.b) - _rnd(t, cy + n.lh - n.bor.b - n.pad.b) }
b.margin = Edges { left = _rnd(t, n.mar.l), right = _rnd(t, n.mar.r), top = _rnd(t, n.mar.t), bottom = _rnd(t, n.mar.b) }
b.scrollbar_width = _rnd(t, n.sbw)
b.scrollbar_height = _rnd(t, n.sbh)
rtl := n.style.direction == Direction.Rtl
cl := n.bor.l + n.pad.l + (rtl ? n.sbw : 0.0)
ct := n.bor.t + n.pad.t
cr := n.lw - n.bor.r - n.pad.r - (rtl ? 0.0 : n.sbw)
cbm := n.lh - n.bor.b - n.pad.b - n.sbh
b.content_x = _rnd(t, cx + cl) - _rnd(t, cx)
b.content_y = _rnd(t, cy + ct) - _rnd(t, cy)
b.content_width = _fmax(_rnd(t, cx + cr) - _rnd(t, cx + cl), 0.0)
b.content_height = _fmax(_rnd(t, cy + cbm) - _rnd(t, cy + ct), 0.0)
pl := n.bor.l + (rtl ? n.sbw : 0.0)
pr := n.lw - n.bor.r - (rtl ? 0.0 : n.sbw)
pt := n.bor.t
pb := n.lh - n.bor.b - n.sbh
mut sw := 0.0
if rtl:
sw = pr - _fmin(n.ovl, pl)
else:
sw = _fmax(n.ovr, pr) - pl
end
sh := _fmax(n.ovb, pb) - pt
b.scroll_width = _fmax(_rnd(t, sw), 0.0)
b.scroll_height = _fmax(_rnd(t, sh), 0.0)
if _is(n.base):
b.has_baseline = true
b.baseline = _rnd(t, cy + n.base) - _rnd(t, cy)
end
n.fin = b
nk := n.children.len()
repeat nk in i:
c := t.nodes.ref(id).children.get(i)
_finalize(t, c, cx, cy)
end
end
func _compute_root(t &: Engine, root: int, aw: f64, ah: f64):
t.vw = aw
t.vh = ah
n := t.nodes.ref(root)
st := n.style
if st.display == Display.None:
_hide(t, root)
n0 := t.nodes.ref(root)
n0.fin = BoxLayout {}
ret
end
rtl := st.direction == Direction.Rtl
if _oof(st.position) and _def(aw) and _def(ah):
n.ax = 0.0
n.ay = 0.0
_oof_box(t, root, aw, ah, 0.0, 0.0, rtl, rtl ? aw : 0.0, rtl ? aw : 0.0, rtl ? 1 : 0, 0.0, 0.0, 0)
else:
pw := _avopt(aw)
ph := _avopt(ah)
mar := _r4(st.margin, pw)
raw := _avmax(_avsub(aw, mar.l + mar.r), 0.0)
rah := _avmax(_avsub(ah, mar.t + mar.b), 0.0)
mut kw := NO
if st.display == Display.Block or st.display == Display.FlowRoot or st.display == Display.InlineBlock:
ratio := st.aspect_ratio
pad := _r4(st.padding, pw)
bor := _r4(st.border, pw)
pbw := pad.l + pad.r + bor.l + bor.r
pbh := pad.t + pad.b + bor.t + bor.b
adjw := st.box_sizing == BoxSizing.ContentBox ? pbw : 0.0
adjh := st.box_sizing == BoxSizing.ContentBox ? pbh : 0.0
mnw0 := _res(st.min_width, pw)
mnh0 := _res(st.min_height, ph)
mxw0 := _res(st.max_width, pw)
mxh0 := _res(st.max_height, ph)
minw := _add(_arw(mnw0, mnh0, ratio), adjw)
maxw := _add(_arw(mxw0, mxh0, ratio), adjw)
minh := _add(_arh(mnw0, mnh0, ratio), adjh)
maxh := _add(_arh(mxw0, mxh0, ratio), adjh)
sw0 := _res(st.width, pw)
sh0 := _res(st.height, ph)
csw := _clamp(_add(_arw(sw0, sh0, ratio), adjw), minw, maxw)
csh := _clamp(_add(_arh(sw0, sh0, ratio), adjh), minh, maxh)
mmw := (_is(minw) and _is(maxw) and maxw <= minw) ? minw : NO
kw = _mmax(_or(_or(mmw, csw), _avopt(raw)), pbw)
mmh := (_is(minh) and _is(maxh) and maxh <= minh) ? minh : NO
kh0 := _mmax(_or(mmh, csh), pbh)
o := _layout(t, root, Inp { kw = kw, kh = kh0, pw = pw, ph = ph, aw = raw, ah = rah, inherent = true, axis = 2, perform = true })
_root_place(t, root, o, aw, pw, ph, mar, rtl)
else:
o := _layout(t, root, Inp { kw = kw, pw = pw, ph = ph, aw = raw, ah = rah, inherent = true, axis = 2, perform = true })
_root_place(t, root, o, aw, pw, ph, mar, rtl)
end
end
n2 := t.nodes.ref(root)
n2.ax = n2.lx
n2.ay = n2.ly
t.oofs.clear()
_post(t, root, root)
_overflow(t, root)
_finalize(t, root, 0.0, 0.0)
end
func _root_place(t &: Engine, root: int, o: Out, aw: f64, pw: f64, ph: f64, mar: R4, rtl: bool):
n := t.nodes.ref(root)
st := n.style
pad := _r4(st.padding, pw)
bor := _r4(st.border, pw)
mut x := mar.l
if rtl and _def(aw):
x = aw - o.w - mar.r
end
mut y := mar.t
if _isrel(st.position):
l := _res(st.inset.left, pw)
r := _res(st.inset.right, pw)
tp := _res(st.inset.top, ph)
bt := _res(st.inset.bottom, ph)
if rtl:
x += _is(r) ? 0.0 - r : _or(l, 0.0)
else:
x += _is(l) ? l : (_is(r) ? 0.0 - r : 0.0)
end
y += _is(tp) ? tp : (_is(bt) ? 0.0 - bt : 0.0)
end
_set_layout(t, root, x, y, o.w, o.h, pad, bor, mar)
end
package cssbox
struct TCell:
pub id: int = 0
pub row: int = 0
pub col: int = 0
pub cs: int = 1
pub rs: int = 1
pub mn: f64 = 0.0
pub mx: f64 = 0.0
pub fixed: bool = false
pub fw: f64 = 0.0
pub pct: f64 = NO
pub hauto: f64 = 0.0
pub hmin: f64 = 0.0
pub base: f64 = NO
pub w: f64 = 0.0
pub h: f64 = 0.0
pub bor: R4 = R4 {}
end
struct TRow:
pub id: int = -1
pub g: int = 0
pub fixed: bool = false
pub hspec: f64 = 0.0
pub h: f64 = 0.0
pub y: f64 = 0.0
pub base: f64 = NO
end
struct TGrp:
pub id: int = -1
pub kind: int = 1
pub r0: int = 0
pub r1: int = 0
end
struct TCol:
pub mn: f64 = 0.0
pub mx: f64 = 0.0
pub fixed: bool = false
pub fw: f64 = 0.0
pub pct: f64 = NO
pub w: f64 = 0.0
pub x: f64 = 0.0
pub id: int = -1
pub gid: int = -1
end
struct TCap:
pub id: int = 0
pub bottom: bool = false
pub h: f64 = 0.0
pub mt: f64 = 0.0
pub mb: f64 = 0.0
end
struct TCtx:
pub cells: Vector<TCell> = Vector {}
pub rows: Vector<TRow> = Vector {}
pub grps: Vector<TGrp> = Vector {}
pub cols: Vector<TCol> = Vector {}
pub caps: Vector<TCap> = Vector {}
pub rcells: Vector<int> = Vector {}
pub rstart: Vector<int> = Vector {}
pub ncols: int = 0
end
func _is_group(d: Display): bool:
ret d == Display.TableRowGroup or d == Display.TableHeaderGroup or d == Display.TableFooterGroup
end
func _t_skip(t &: Engine, c: int): bool:
st := t.nodes.ref(c).style
ret st.display == Display.None or _oof(st.position)
end
func _t_row_cells(t &: Engine, row: int, out &: Vector<int>):
kids := _kids(t, row)
each c in kids:
if not _t_skip(t, c):
out.push(c)
end
end
kids.free()
end
func _t_add_row(x &: TCtx, id: int, g: int, cells: Vector<int>):
x.rstart.push(x.rcells.len())
each c in cells:
x.rcells.push(c)
end
x.rows.push(TRow { id = id, g = g })
end
func _t_build(t &: Engine, id: int, x &: TCtx):
kids := _kids(t, id)
defer kids.free()
mut gl := Vector {} as Vector<TGrp>
defer gl.free()
mut grows := Vector {} as Vector<int>
defer grows.free()
mut gcells := Vector {} as Vector<int>
defer gcells.free()
mut grstart := Vector {} as Vector<int>
defer grstart.free()
mut growgrp := Vector {} as Vector<int>
defer growgrp.free()
mut anon_g := -1
mut anon_r := -1
each c in kids:
if _t_skip(t, c):
continue
end
d := t.nodes.ref(c).style.display
if d == Display.TableCaption:
cs := t.nodes.ref(c).style
x.caps.push(TCap { id = c, bottom = cs.caption_side == CaptionSide.Bottom })
anon_g = -1
anon_r = -1
continue
end
if d == Display.TableColumnGroup:
ck := _kids(t, c)
mut any := false
each cc in ck:
cst := t.nodes.ref(cc).style
if cst.display == Display.TableColumn:
any = true
repeat _imax(cst.col_span, 1):
x.cols.push(TCol { id = cc, gid = c })
end
end
end
ck.free()
if not any:
repeat _imax(t.nodes.ref(c).style.col_span, 1):
x.cols.push(TCol { id = -1, gid = c })
end
end
anon_g = -1
anon_r = -1
continue
end
if d == Display.TableColumn:
repeat _imax(t.nodes.ref(c).style.col_span, 1):
x.cols.push(TCol { id = c })
end
anon_g = -1
anon_r = -1
continue
end
if _is_group(d):
kind := d == Display.TableHeaderGroup ? 0 : (d == Display.TableFooterGroup ? 2 : 1)
gi := gl.len()
gl.push(TGrp { id = c, kind = kind })
gk := _kids(t, c)
mut ar := -1
each rc in gk:
if _t_skip(t, rc):
continue
end
if t.nodes.ref(rc).style.display == Display.TableRow:
grstart.push(gcells.len())
mut tmp := Vector {} as Vector<int>
_t_row_cells(t, rc, tmp)
each q in tmp:
gcells.push(q)
end
tmp.free()
grows.push(rc)
growgrp.push(gi)
ar = -1
else:
if ar < 0:
grstart.push(gcells.len())
grows.push(-1)
growgrp.push(gi)
ar = grows.len() - 1
end
gcells.push(rc)
end
end
gk.free()
anon_g = -1
anon_r = -1
continue
end
if anon_g < 0:
gl.push(TGrp { id = -1, kind = 1 })
anon_g = gl.len() - 1
anon_r = -1
end
if d == Display.TableRow:
grstart.push(gcells.len())
mut tmp := Vector {} as Vector<int>
_t_row_cells(t, c, tmp)
each q in tmp:
gcells.push(q)
end
tmp.free()
grows.push(c)
growgrp.push(anon_g)
anon_r = -1
continue
end
if anon_r < 0:
grstart.push(gcells.len())
grows.push(-1)
growgrp.push(anon_g)
anon_r = grows.len() - 1
end
gcells.push(c)
end
mut head := -1
mut foot := -1
repeat gl.len() in i:
if gl[i].kind == 0 and head < 0:
head = i
end
if gl[i].kind == 2 and foot < 0:
foot = i
end
end
mut order := Vector {} as Vector<int>
defer order.free()
if head >= 0:
order.push(head)
end
repeat gl.len() in i:
if i != head and i != foot:
order.push(i)
end
end
if foot >= 0:
order.push(foot)
end
each gi in order:
mut gg := gl[gi]
gg.kind = gi == head ? 0 : (gi == foot ? 2 : 1)
gg.r0 = x.rows.len()
ng := x.grps.len()
repeat grows.len() in r:
if growgrp[r] == gi:
e := r + 1 < grstart.len() ? grstart[r + 1] : gcells.len()
mut cl := Vector {} as Vector<int>
mut k := grstart[r]
until k < e:
cl.push(gcells[k])
k++
end
_t_add_row(x, grows[r], ng, cl)
cl.free()
end
end
gg.r1 = x.rows.len()
x.grps.push(gg)
end
end
func _t_place(t &: Engine, x &: TCtx):
mut left := Vector {} as Vector<int>
defer left.free()
repeat x.rows.len() in r:
rw := x.rows[r]
g := x.grps[rw.g]
if r == g.r0:
repeat left.len() in k:
left[k] = 0
end
end
s := x.rstart[r]
e := r + 1 < x.rstart.len() ? x.rstart[r + 1] : x.rcells.len()
mut col := 0
mut k := s
until k < e:
cid := x.rcells[k]
st := t.nodes.ref(cid).style
iscell := st.display == Display.TableCell
cs := iscell ? _imin(_imax(st.col_span, 1), 1000) : 1
mut rs := iscell ? st.row_span : 1
if rs <= 0:
rs = g.r1 - r
end
rs = _imax(1, _imin(rs, g.r1 - r))
until col < left.len() and left[col] > 0:
col++
end
until left.len() < col + cs:
left.push(0)
end
repeat cs in q:
left[col + q] = rs
end
x.cells.push(TCell { id = cid, row = r, col = col, cs = cs, rs = rs })
col += cs
k++
end
repeat left.len() in q:
if left[q] > 0:
left[q] = left[q] - 1
end
end
if left.len() > x.ncols:
x.ncols = left.len()
end
end
each c in x.cells:
if c.col + c.cs > x.ncols:
x.ncols = c.col + c.cs
end
end
if x.cols.len() > x.ncols:
x.ncols = x.cols.len()
end
until x.cols.len() < x.ncols:
x.cols.push(TCol {})
end
end
func _side_w(s: Length): f64:
if s.kind == LengthKind.Px:
ret s.value
end
ret 0.0
end
func _t_set_border(t &: Engine, id: int, b: R4):
n := t.nodes.ref(id)
nb := Sides { top = Px(b.t), right = Px(b.r), bottom = Px(b.b), left = Px(b.l) }
mut same := n.bov
if same:
same = n.style.border.top.value == b.t and n.style.border.right.value == b.r and n.style.border.bottom.value == b.b and n.style.border.left.value == b.l
end
if not same:
n.style.border = nb
n.bov = true
n.fin_ok = false
n.ckeys.clear()
n.couts.clear()
n.cnext = 0
end
end
func _t_restore_border(t &: Engine, id: int):
n := t.nodes.ref(id)
if n.bov:
n.style.border = n.ubor
n.bov = false
n.fin_ok = false
n.ckeys.clear()
n.couts.clear()
n.cnext = 0
end
end
func _bk_rank(k: BorderKind): int:
switch k:
BorderKind.Double: ret 8 end
BorderKind.Solid: ret 7 end
BorderKind.Dashed: ret 6 end
BorderKind.Dotted: ret 5 end
BorderKind.Ridge, BorderKind.Inset: ret 4 end
BorderKind.Groove, BorderKind.Outset: ret 2 end
else: ret 0 end
end
ret 0
end
func _bk_side(k: BorderKinds, side: int): BorderKind:
switch side:
0: ret k.top end
1: ret k.right end
2: ret k.bottom end
else: ret k.left end
end
ret k.left
end
func _len_side(s: Sides, side: int): f64:
switch side:
0: ret _side_w(s.top) end
1: ret _side_w(s.right) end
2: ret _side_w(s.bottom) end
else: ret _side_w(s.left) end
end
ret 0.0
end
func _ce_better(a: CEdge, b: CEdge): bool:
if b.origin < 0:
ret a.origin >= 0
end
if a.hidden or b.hidden:
ret a.hidden and not b.hidden
end
if a.w != b.w:
ret a.w > b.w
end
if a.rank != b.rank:
ret a.rank > b.rank
end
ret a.origin > b.origin
end
func _ce_offer(t &: Engine, v &: Vector<CEdge>, i: int, node: int, side: int, origin: int):
if node < 0 or i < 0 or i >= v.len():
ret
end
n := t.nodes.ref(node)
k := _bk_side(n.style.border_kinds, side)
mut c := CEdge { origin = origin, node = node, side = side }
if k == BorderKind.Hidden:
c.hidden = true
else:
if k == BorderKind.None:
ret
end
c.w = _len_side(n.ubor, side)
if c.w <= 0.0:
ret
end
c.rank = _bk_rank(k)
end
if _ce_better(c, v[i]):
v[i] = c
end
end
func _bk_vis(k: BorderKinds, side: int): bool:
b := _bk_side(k, side)
ret b != BorderKind.None and b != BorderKind.Hidden
end
func _ce_w(c: CEdge): f64:
if c.hidden or c.origin < 0:
ret 0.0
end
ret c.w
end
func _tb_free(b &: TableEdges):
b.h.free()
b.v.free()
b.xs.free()
b.ys.free()
end
func _t_resolve(t &: Engine, id: int, x &: TCtx, rtl: bool):
nr := x.rows.len()
nc := x.ncols
sside := rtl ? 1 : 3
eside := rtl ? 3 : 1
tn := t.nodes.ref(id)
_tb_free(tn.tb)
mut hs := Vector {} as Vector<CEdge>
mut vs := Vector {} as Vector<CEdge>
repeat (nr + 1) * nc:
hs.push(CEdge {})
end
repeat nr * (nc + 1):
vs.push(CEdge {})
end
repeat nc in c:
_ce_offer(t, hs, c, id, 0, 0)
_ce_offer(t, hs, nr * nc + c, id, 2, 0)
end
repeat nr in r:
_ce_offer(t, vs, r * (nc + 1), id, sside, 0)
_ce_offer(t, vs, r * (nc + 1) + nc, id, eside, 0)
end
mut k := 0
until k < nc:
g := x.cols[k].gid
mut k1 := k + 1
until k1 < nc and x.cols[k1].gid == g:
k1++
end
if g >= 0:
repeat nr in r:
_ce_offer(t, vs, r * (nc + 1) + k, g, sside, 1)
_ce_offer(t, vs, r * (nc + 1) + k1, g, eside, 1)
end
mut c := k
until c < k1:
_ce_offer(t, hs, c, g, 0, 1)
_ce_offer(t, hs, nr * nc + c, g, 2, 1)
c++
end
end
k = k1
end
k = 0
until k < nc:
cid := x.cols[k].id
mut k1 := k + 1
until k1 < nc and x.cols[k1].id == cid:
k1++
end
if cid >= 0:
repeat nr in r:
_ce_offer(t, vs, r * (nc + 1) + k, cid, sside, 2)
_ce_offer(t, vs, r * (nc + 1) + k1, cid, eside, 2)
end
mut c := k
until c < k1:
_ce_offer(t, hs, c, cid, 0, 2)
_ce_offer(t, hs, nr * nc + c, cid, 2, 2)
c++
end
end
k = k1
end
each g in x.grps:
if g.id >= 0 and g.r1 > g.r0:
repeat nc in c:
_ce_offer(t, hs, g.r0 * nc + c, g.id, 0, 3)
_ce_offer(t, hs, g.r1 * nc + c, g.id, 2, 3)
end
mut r := g.r0
until r < g.r1:
_ce_offer(t, vs, r * (nc + 1), g.id, sside, 3)
_ce_offer(t, vs, r * (nc + 1) + nc, g.id, eside, 3)
r++
end
end
end
repeat nr in r:
rid := x.rows[r].id
if rid >= 0:
repeat nc in c:
_ce_offer(t, hs, r * nc + c, rid, 0, 4)
_ce_offer(t, hs, (r + 1) * nc + c, rid, 2, 4)
end
_ce_offer(t, vs, r * (nc + 1), rid, sside, 4)
_ce_offer(t, vs, r * (nc + 1) + nc, rid, eside, 4)
end
end
each c in x.cells:
repeat c.cs in dc:
_ce_offer(t, hs, c.row * nc + c.col + dc, c.id, 0, 5)
_ce_offer(t, hs, (c.row + c.rs) * nc + c.col + dc, c.id, 2, 5)
end
repeat c.rs in dr:
_ce_offer(t, vs, (c.row + dr) * (nc + 1) + c.col, c.id, sside, 5)
_ce_offer(t, vs, (c.row + dr) * (nc + 1) + c.col + c.cs, c.id, eside, 5)
end
end
each c in x.cells:
repeat c.rs - 1 in dr:
repeat c.cs in dc:
hs[(c.row + dr + 1) * nc + c.col + dc] = CEdge {}
end
end
repeat c.cs - 1 in dc:
repeat c.rs in dr:
vs[(c.row + dr) * (nc + 1) + c.col + dc + 1] = CEdge {}
end
end
end
tn2 := t.nodes.ref(id)
tn2.tb = TableEdges { h = hs, v = vs, xs = Vector {} as Vector<f64>, ys = Vector {} as Vector<f64>, nr = nr, nc = nc }
end
func _t_collapse(t &: Engine, id: int, x &: TCtx, tb &: R4, rtl: bool):
nr := x.rows.len()
nc := x.ncols
_t_resolve(t, id, x, rtl)
tbd := t.nodes.ref(id).tb
hs := tbd.h
vs := tbd.v
mut ml := 0.0
mut mr := 0.0
mut mt := 0.0
mut mb := 0.0
repeat nr in r:
ml = _fmax(ml, _ce_w(vs[r * (nc + 1)]))
mr = _fmax(mr, _ce_w(vs[r * (nc + 1) + nc]))
end
repeat nc in c:
mt = _fmax(mt, _ce_w(hs[c]))
mb = _fmax(mb, _ce_w(hs[nr * nc + c]))
end
repeat x.cells.len() in i:
c := x.cells[i]
mut bl := 0.0
mut br := 0.0
mut bt := 0.0
mut bb := 0.0
repeat c.rs in dr:
bl = _fmax(bl, _ce_w(vs[(c.row + dr) * (nc + 1) + c.col]))
br = _fmax(br, _ce_w(vs[(c.row + dr) * (nc + 1) + c.col + c.cs]))
end
repeat c.cs in dc:
bt = _fmax(bt, _ce_w(hs[c.row * nc + c.col + dc]))
bb = _fmax(bb, _ce_w(hs[(c.row + c.rs) * nc + c.col + dc]))
end
cr := x.cells.ref(i)
cr.bor = R4 { l = bl / 2.0, r = br / 2.0, t = bt / 2.0, b = bb / 2.0 }
end
repeat x.cells.len() in i:
c := x.cells[i]
mut b := c.bor
if rtl:
sw := b.l
b.l = b.r
b.r = sw
end
cr := x.cells.ref(i)
cr.bor = b
_t_set_border(t, c.id, b)
end
if nr == 0 or nc == 0:
tub := t.nodes.ref(id).ubor
tk := t.nodes.ref(id).style.border_kinds
ml = _bk_vis(tk, rtl ? 1 : 3) ? _side_w(rtl ? tub.right : tub.left) : 0.0
mr = _bk_vis(tk, rtl ? 3 : 1) ? _side_w(rtl ? tub.left : tub.right) : 0.0
mt = _bk_vis(tk, 0) ? _side_w(tub.top) : 0.0
mb = _bk_vis(tk, 2) ? _side_w(tub.bottom) : 0.0
end
if rtl:
tb = R4 { l = mr / 2.0, r = ml / 2.0, t = mt / 2.0, b = mb / 2.0 }
else:
tb = R4 { l = ml / 2.0, r = mr / 2.0, t = mt / 2.0, b = mb / 2.0 }
end
end
func _joint(b: TableEdges, hr: int, k: int, e: CEdge, horiz: bool, perp &: f64): bool:
nc := b.nc
nr := b.nr
mut beaten := false
perp = 0.0
repeat 2 in q:
if horiz:
r := hr - 1 + q
if r >= 0 and r < nr:
o := b.v[r * (nc + 1) + k]
if _ce_w(o) > 0.0:
perp = _fmax(perp, o.w)
if _ce_better(o, e):
beaten = true
end
end
end
else:
c := k - 1 + q
if c >= 0 and c < nc:
o := b.h[hr * nc + c]
if _ce_w(o) > 0.0:
perp = _fmax(perp, o.w)
if _ce_better(o, e):
beaten = true
end
end
end
end
end
ret not beaten
end
func _col_beats(o: CEdge, e: CEdge): bool:
ret _ce_w(o) > 0.0 and _ce_better(o, e)
end
func _tb_segments(t &: Engine, id: int, out &: Vector<CollapsedBorder>):
if id < 0 or id >= t.nodes.len():
ret
end
b := t.nodes.ref(id).tb
nr := b.nr
nc := b.nc
if b.xs.len() != nc + 1 or b.ys.len() != nr + 1 or b.h.len() != (nr + 1) * nc or b.v.len() != nr * (nc + 1):
ret
end
mut pw := 0.0
repeat nr in r0:
repeat nc + 1 in k0:
r := nr - 1 - r0
k := nc - k0
e := b.v[r * (nc + 1) + k]
if _ce_w(e) <= 0.0:
continue
end
mut y0 := b.ys[r]
mut y1 := b.ys[r + 1]
if _joint(b, r, k, e, false, pw) and not (r > 0 and _col_beats(b.v[(r - 1) * (nc + 1) + k], e)):
y0 -= pw / 2.0
else:
y0 += pw / 2.0
end
if _joint(b, r + 1, k, e, false, pw) and not (r + 1 < nr and _col_beats(b.v[(r + 1) * (nc + 1) + k], e)):
y1 += pw / 2.0
else:
y1 -= pw / 2.0
end
if y1 > y0:
out.push(CollapsedBorder { x = b.xs[k] - e.w / 2.0, y = y0, width = e.w, height = y1 - y0, node = e.node, side = e.side, vertical = true })
end
end
end
repeat nr + 1 in hr0:
repeat nc in c0:
hr := nr - hr0
c := nc - 1 - c0
e := b.h[hr * nc + c]
if _ce_w(e) <= 0.0:
continue
end
kl := b.xs[c] <= b.xs[c + 1] ? c : c + 1
kr := kl == c ? c + 1 : c
mut x0 := _fmin(b.xs[c], b.xs[c + 1])
mut x1 := _fmax(b.xs[c], b.xs[c + 1])
cl := kl == c ? c - 1 : c + 1
cr := kl == c ? c + 1 : c - 1
if _joint(b, hr, kl, e, true, pw) and not (cl >= 0 and cl < nc and _col_beats(b.h[hr * nc + cl], e)):
x0 -= pw / 2.0
else:
x0 += pw / 2.0
end
if _joint(b, hr, kr, e, true, pw) and not (cr >= 0 and cr < nc and _col_beats(b.h[hr * nc + cr], e)):
x1 += pw / 2.0
else:
x1 -= pw / 2.0
end
if x1 > x0:
out.push(CollapsedBorder { x = x0, y = b.ys[hr] - e.w / 2.0, width = x1 - x0, height = e.w, node = e.node, side = e.side, vertical = false })
end
end
end
end
func _t_cell_widths(t &: Engine, x &: TCtx):
repeat x.cells.len() in i:
c := x.cells[i]
st := t.nodes.ref(c.id).style
mn := _layout(t, c.id, Inp { pw = NO, ph = NO, aw = MINC, ah = MAXC, axis = 0 }).w
mut mx := _layout(t, c.id, Inp { pw = NO, ph = NO, aw = MAXC, ah = MAXC, axis = 0 }).w
mx = _fmax(mx, mn)
cr := x.cells.ref(i)
cr.mn = mn
cr.mx = mx
if st.width.kind == LengthKind.Px:
pad := _r4(st.padding, NO)
bor := _r4(st.border, NO)
adj := st.box_sizing == BoxSizing.ContentBox ? pad.l + pad.r + bor.l + bor.r : 0.0
w := st.width.value + adj
cr.fixed = true
cr.fw = w
cr.mx = _fmax(w, mn)
else st.width.kind == LengthKind.Percent:
cr.pct = st.width.value
end
end
repeat x.cols.len() in k:
col := x.cols[k]
if col.id >= 0 or col.gid >= 0:
src := col.id >= 0 ? col.id : col.gid
st := t.nodes.ref(src).style
cr := x.cols.ref(k)
if st.width.kind == LengthKind.Px:
cr.fixed = true
cr.fw = st.width.value
cr.mx = _fmax(cr.mx, st.width.value)
else st.width.kind == LengthKind.Percent:
cr.pct = st.width.value
end
end
end
each c in x.cells:
if c.cs != 1:
continue
end
cr := x.cols.ref(c.col)
cr.mn = _fmax(cr.mn, c.mn)
cr.mx = _fmax(cr.mx, c.mx)
if c.fixed:
cr.fixed = true
cr.fw = _fmax(cr.fw, c.fw)
end
if _is(c.pct):
cr.pct = _fmax(_or(cr.pct, 0.0), c.pct)
end
end
repeat x.cols.len() in k:
cr := x.cols.ref(k)
cr.mx = _fmax(cr.mx, cr.mn)
end
end
func _t_spans(x &: TCtx, hs: f64):
mut maxs := 1
each c in x.cells:
maxs = _imax(maxs, c.cs)
end
mut sp := 2
until sp <= maxs:
each c in x.cells:
if c.cs != sp:
continue
end
mut smn := 0.0
mut smx := 0.0
repeat c.cs in q:
col := x.cols[c.col + q]
smn += col.mn
smx += col.mx
end
gaps := hs * ((c.cs - 1) as f64)
if c.mx > smx + gaps:
extra := c.mx - smx - gaps
repeat c.cs in q:
cr := x.cols.ref(c.col + q)
share := smx > 0.0 ? extra * cr.mx / smx : extra / (c.cs as f64)
cr.mx += share
end
end
if c.mn > smn + gaps:
extra := c.mn - smn - gaps
mut base := 0.0
repeat c.cs in q:
base += x.cols[c.col + q].mx
end
repeat c.cs in q:
cr := x.cols.ref(c.col + q)
share := base > 0.0 ? extra * cr.mx / base : extra / (c.cs as f64)
cr.mn += share
cr.mx = _fmax(cr.mx, cr.mn)
end
end
end
sp++
end
end
func _t_distribute(x &: TCtx, target: f64):
n := x.cols.len()
mut gmin := 0.0
mut gpct := 0.0
mut gspec := 0.0
mut gmax := 0.0
repeat n in k:
c := x.cols[k]
gmin += c.mn
if _is(c.pct):
p := _fmax(c.mn, c.pct * target / 100.0)
gpct += p
gspec += p
gmax += p
else c.fixed:
gpct += c.mn
gspec += c.mx
gmax += c.mx
else:
gpct += c.mn
gspec += c.mn
gmax += c.mx
end
end
repeat n in k:
c := x.cols[k]
mut w := c.mn
mut hi := c.mn
mut lo := c.mn
if target <= gmin:
w = c.mn
else target <= gpct:
hi = _is(c.pct) ? _fmax(c.mn, c.pct * target / 100.0) : c.mn
w = c.mn + (hi - c.mn) * (target - gmin) / _fmax(gpct - gmin, 0.000001)
else target <= gspec:
lo = _is(c.pct) ? _fmax(c.mn, c.pct * target / 100.0) : c.mn
hi = _is(c.pct) ? lo : (c.fixed ? c.mx : c.mn)
w = lo + (hi - lo) * (target - gpct) / _fmax(gspec - gpct, 0.000001)
else target <= gmax:
lo = _is(c.pct) ? _fmax(c.mn, c.pct * target / 100.0) : (c.fixed ? c.mx : c.mn)
hi = _is(c.pct) ? lo : c.mx
w = lo + (hi - lo) * (target - gspec) / _fmax(gmax - gspec, 0.000001)
else:
w = _is(c.pct) ? _fmax(c.mn, c.pct * target / 100.0) : c.mx
end
cr := x.cols.ref(k)
cr.w = w
end
if target > gmax and n > 0:
excess := target - gmax
mut kind := 0
mut tot := 0.0
mut cnt := 0
repeat n in k:
c := x.cols[k]
if not _is(c.pct) and not c.fixed:
cnt++
tot += c.mx
end
end
if cnt == 0:
kind = 1
repeat n in k:
c := x.cols[k]
if not _is(c.pct) and c.fixed:
cnt++
tot += c.mx
end
end
end
if cnt == 0:
kind = 2
repeat n in k:
c := x.cols[k]
if _is(c.pct):
cnt++
tot += c.pct
end
end
end
if cnt == 0:
kind = 3
cnt = n
end
repeat n in k:
c := x.cols[k]
mut take := false
mut wt := 0.0
switch kind:
0:
take = not _is(c.pct) and not c.fixed
wt = c.mx
break
end
1:
take = not _is(c.pct) and c.fixed
wt = c.mx
break
end
2:
take = _is(c.pct)
wt = _or(c.pct, 0.0)
break
end
else:
take = true
wt = 1.0
end
end
if take:
cr := x.cols.ref(k)
if tot > 0.0 and kind != 3:
cr.w += excess * wt / tot
else:
cr.w += excess / (cnt as f64)
end
end
end
end
end
func _t_fixed(t &: Engine, x &: TCtx, target: f64, hs: f64): f64:
n := x.cols.len()
mut set := Vector {} as Vector<bool>
defer set.free()
repeat n in k:
set.push(false)
c := x.cols[k]
if c.id >= 0 or c.gid >= 0:
src := c.id >= 0 ? c.id : c.gid
st := t.nodes.ref(src).style
cr := x.cols.ref(k)
if st.width.kind == LengthKind.Px:
cr.w = st.width.value
set[k] = true
else st.width.kind == LengthKind.Percent:
cr.w = st.width.value * target / 100.0
set[k] = true
end
end
end
each c in x.cells:
if c.row != 0:
continue
end
st := t.nodes.ref(c.id).style
mut w := NO
if st.width.kind == LengthKind.Px:
pad := _r4(st.padding, NO)
bor := _r4(st.border, NO)
adj := st.box_sizing == BoxSizing.ContentBox ? pad.l + pad.r + bor.l + bor.r : 0.0
w = st.width.value + adj
else st.width.kind == LengthKind.Percent:
w = st.width.value * target / 100.0
end
if not _is(w):
continue
end
per := (w - hs * ((c.cs - 1) as f64)) / (c.cs as f64)
repeat c.cs in q:
k := c.col + q
if not set[k]:
cr := x.cols.ref(k)
cr.w = per
set[k] = true
end
end
end
mut used := 0.0
mut free_n := 0
repeat n in k:
if set[k]:
used += x.cols[k].w
else:
free_n++
end
end
if free_n > 0:
each_w := _fmax(0.0, (target - used) / (free_n as f64))
repeat n in k:
if not set[k]:
cr := x.cols.ref(k)
cr.w = each_w
end
end
else used < target and n > 0:
extra := target - used
repeat n in k:
cr := x.cols.ref(k)
if used > 0.0:
cr.w += extra * cr.w / used
else:
cr.w += extra / (n as f64)
end
end
end
mut tot := 0.0
repeat n in k:
tot += x.cols[k].w
end
ret tot
end
func _t_rows(t &: Engine, x &: TCtx, hs: f64, vs: f64):
repeat x.rows.len() in r:
rw := x.rows[r]
if rw.id >= 0:
st := t.nodes.ref(rw.id).style
if st.height.kind == LengthKind.Px:
rr := x.rows.ref(r)
rr.hspec = st.height.value
rr.fixed = true
rr.h = st.height.value
end
end
end
repeat x.cells.len() in i:
c := x.cells[i]
mut w := hs * ((c.cs - 1) as f64)
repeat c.cs in q:
w += x.cols[c.col + q].w
end
o := _layout(t, c.id, Inp { kw = w, pw = w, ph = NO, aw = w, ah = MAXC, axis = 2 })
st := t.nodes.ref(c.id).style
mut hmin := 0.0
if st.height.kind == LengthKind.Px:
pad := _r4(st.padding, w)
bor := _r4(st.border, w)
adj := st.box_sizing == BoxSizing.ContentBox ? pad.t + pad.b + bor.t + bor.b : 0.0
hmin = st.height.value + adj
if c.rs == 1:
rr := x.rows.ref(c.row)
rr.fixed = true
end
end
cr := x.cells.ref(i)
cr.w = w
cr.hauto = o.h
cr.hmin = hmin
mut b := o.baseline
if not _is(b):
pad := _r4(st.padding, w)
bor := _r4(st.border, w)
b = o.h - pad.b - bor.b
end
cr.base = b
end
each c in x.cells:
st := t.nodes.ref(c.id).style
if st.vertical_align == VerticalAlign.Baseline:
rr := x.rows.ref(c.row)
rr.base = _fmax(_or(rr.base, 0.0), c.base)
end
end
each c in x.cells:
if c.rs != 1:
continue
end
st := t.nodes.ref(c.id).style
mut need := _fmax(c.hauto, c.hmin)
if st.vertical_align == VerticalAlign.Baseline:
rb := x.rows[c.row].base
need = _fmax(need, rb - c.base + c.hauto)
end
rr := x.rows.ref(c.row)
rr.h = _fmax(rr.h, need)
end
mut maxs := 1
each c in x.cells:
maxs = _imax(maxs, c.rs)
end
mut sp := 2
until sp <= maxs:
each c in x.cells:
if c.rs != sp:
continue
end
need := _fmax(c.hauto, c.hmin)
mut have := vs * ((c.rs - 1) as f64)
repeat c.rs in q:
have += x.rows[c.row + q].h
end
if need > have:
_t_grow_rows(x, c.row, c.row + c.rs, need - have, false)
end
end
sp++
end
end
func _t_grow_rows(x &: TCtx, r0: int, r1: int, extra: f64, body_only: bool):
mut tot := 0.0
mut cnt := 0
mut pass := 0
until pass < 3:
tot = 0.0
cnt = 0
mut r := r0
until r < r1:
rw := x.rows[r]
if _t_row_ok(x, rw, pass, body_only):
tot += rw.h
cnt++
end
r++
end
if cnt > 0:
break
end
pass++
end
if cnt == 0:
ret
end
mut r := r0
until r < r1:
rw := x.rows[r]
if _t_row_ok(x, rw, pass, body_only):
rr := x.rows.ref(r)
if tot > 0.0:
rr.h += extra * rw.h / tot
else:
rr.h += extra / (cnt as f64)
end
end
r++
end
end
func _t_row_ok(x &: TCtx, rw: TRow, pass: int, body_only: bool): bool:
body := x.grps[rw.g].kind == 1
switch pass:
0:
ret not rw.fixed and (body or not body_only)
end
1:
ret body or not body_only
end
else:
ret true
end
end
ret true
end
func _t_shift(t &: Engine, id: int, dy: f64):
if dy == 0.0:
ret
end
kids := _kids(t, id)
each c in kids:
n := t.nodes.ref(c)
if n.style.display == Display.None:
continue
end
if _oof(n.style.position):
n.spy_s += dy
n.spy_e += dy
else:
n.ly += dy
end
end
kids.free()
end
func _table(t &: Engine, id: int, inp: Inp): Out:
n := t.nodes.ref(id)
st := n.style
rtl := st.direction == Direction.Rtl
collapse := st.border_collapse == BorderCollapse.Collapse
mut x := TCtx {}
x.cells = Vector {} as Vector<TCell>
x.rows = Vector {} as Vector<TRow>
x.grps = Vector {} as Vector<TGrp>
x.cols = Vector {} as Vector<TCol>
x.caps = Vector {} as Vector<TCap>
x.rcells = Vector {} as Vector<int>
x.rstart = Vector {} as Vector<int>
defer x.cells.free()
defer x.rows.free()
defer x.grps.free()
defer x.cols.free()
defer x.caps.free()
defer x.rcells.free()
defer x.rstart.free()
_t_build(t, id, x)
_t_place(t, x)
mut pad := _r4(st.padding, inp.pw)
mut bor := _r4(n.ubor, inp.pw)
hs := collapse ? 0.0 : st.border_spacing_x
vs := collapse ? 0.0 : st.border_spacing_y
if collapse:
pad = R4 {}
_t_collapse(t, id, x, bor, rtl)
_t_set_border(t, id, bor)
else:
_t_restore_border(t, id)
each c in x.cells:
_t_restore_border(t, c.id)
end
end
pbw := pad.l + pad.r + bor.l + bor.r
pbh := pad.t + pad.b + bor.t + bor.b
adjw := st.box_sizing == BoxSizing.ContentBox ? pbw : 0.0
adjh := st.box_sizing == BoxSizing.ContentBox ? pbh : 0.0
nc := x.ncols
extra := pbw + hs * ((_imax(nc, 1) + 1) as f64)
fixed_layout := st.table_layout == TableLayout.Fixed and st.width.kind != LengthKind.Auto
_t_cell_widths(t, x)
_t_spans(x, hs)
mut smn := 0.0
mut smx := 0.0
mut nonpct := 0.0
mut totpct := 0.0
mut pctmax := 0.0
each c in x.cols:
smn += c.mn
smx += c.mx
if _is(c.pct):
totpct += c.pct
if c.pct > 0.0:
pctmax = _fmax(pctmax, c.mx * 100.0 / c.pct)
end
else:
nonpct += c.mx
end
end
mut cmx := _fmax(smx, pctmax)
if totpct > 0.0 and totpct < 100.0:
cmx = _fmax(cmx, nonpct * 100.0 / (100.0 - totpct))
end
mut capmin := 0.0
each cp in x.caps:
capmin = _fmax(capmin, _layout(t, cp.id, Inp { aw = MINC, ah = MAXC, axis = 0 }).w)
end
tmin := _fmax(smn + extra, capmin)
tmax := _fmax(cmx + extra, tmin)
minw := _add(_res(st.min_width, inp.pw), adjw)
maxw := _add(_res(st.max_width, inp.pw), adjw)
mut spec := NO
if inp.inherent:
spec = _add(_res(st.width, inp.pw), adjw)
end
mut w := NO
if _is(inp.kw):
w = _fmax(inp.kw, tmin)
else _is(spec):
w = _fmax(_clampf(spec, minw, maxw), tmin)
else:
if inp.aw == MINC:
w = tmin
else inp.aw == MAXC:
w = tmax
else:
w = _fmin(_fmax(tmin, inp.aw), tmax)
end
w = _fmax(_clampf(w, minw, maxw), tmin)
end
if fixed_layout:
used := _t_fixed(t, x, w - extra, hs)
w = _fmax(w, used + extra)
else:
_t_distribute(x, w - extra)
end
if not inp.perform and inp.axis == 0:
ret Out { w = w, h = 0.0 }
end
_t_rows(t, x, hs, vs)
nr := x.rows.len()
mut rows_h := 0.0
each rw in x.rows:
rows_h += rw.h
end
if nr > 0:
rows_h += vs * ((nr + 1) as f64)
end
mut cap_top := 0.0
mut cap_bot := 0.0
repeat x.caps.len() in i:
cp := x.caps[i]
cst := t.nodes.ref(cp.id).style
o := _layout(t, cp.id, Inp { kw = w, pw = w, ph = NO, aw = w, ah = MAXC, inherent = true, axis = 1 })
mt := _res0(cst.margin.top, w)
mb := _res0(cst.margin.bottom, w)
cr := x.caps.ref(i)
cr.h = o.h
cr.mt = mt
cr.mb = mb
if cp.bottom:
cap_bot += o.h + mt + mb
else:
cap_top += o.h + mt + mb
end
end
mut spech := NO
if inp.inherent:
spech = _add(_res(st.height, inp.ph), adjh)
end
mut boxh := rows_h + pbh
target_h := _or(inp.kh, NO)
mut want := spech
if _is(target_h):
want = target_h - cap_top - cap_bot
end
minh := _add(_res(st.min_height, inp.ph), adjh)
maxh := _add(_res(st.max_height, inp.ph), adjh)
if _is(want) or _is(minh):
want2 := _clampf(_or(want, boxh), minh, maxh)
if want2 > boxh and nr > 0:
_t_grow_rows(x, 0, nr, want2 - boxh, true)
boxh = want2
else want2 > boxh:
boxh = want2
end
end
total_h := boxh + cap_top + cap_bot
mut base := NO
if nr > 0:
r0 := x.rows[0]
mut rb := r0.base
if not _is(rb):
each c in x.cells:
if c.row == 0 and not _is(rb):
rb = c.base
end
end
end
if _is(rb):
base = cap_top + bor.t + pad.t + vs + rb
end
end
if not inp.perform:
ret Out { w = w, h = total_h, baseline = base }
end
gx0 := bor.l + pad.l + hs
gy0 := cap_top + bor.t + pad.t + vs
gw := _fmax(0.0, w - extra + hs * ((_imax(nc, 1) - 1) as f64))
mut cx := 0.0
repeat nc in k:
cr := x.cols.ref(k)
if rtl:
cr.x = gx0 + gw - cx - cr.w
else:
cr.x = gx0 + cx
end
cx += cr.w + hs
end
mut ry := gy0
repeat nr in r:
rr := x.rows.ref(r)
rr.y = ry
ry += rr.h + vs
end
gtop := gy0
gbot := nr > 0 ? ry - vs : gy0
if collapse:
tbn := t.nodes.ref(id)
tbn.tb.xs.clear()
tbn.tb.ys.clear()
repeat nc + 1 in k:
if k < nc:
tbn.tb.xs.push(rtl ? x.cols[k].x + x.cols[k].w : x.cols[k].x)
else nc > 0:
tbn.tb.xs.push(rtl ? x.cols[nc - 1].x : x.cols[nc - 1].x + x.cols[nc - 1].w)
end
end
repeat nr + 1 in r:
if r < nr:
tbn.tb.ys.push(x.rows[r].y)
else nr > 0:
tbn.tb.ys.push(x.rows[nr - 1].y + x.rows[nr - 1].h)
end
end
end
mut ty := 0.0
each cp in x.caps:
if not cp.bottom:
ty += cp.mt
_layout(t, cp.id, Inp { kw = w, kh = cp.h, pw = w, ph = NO, aw = w, ah = cp.h, inherent = true, axis = 2, perform = true })
cst := t.nodes.ref(cp.id).style
_set_layout(t, cp.id, 0.0, ty, w, cp.h, _r4(cst.padding, w), _r4(cst.border, w), R4 { t = cp.mt, b = cp.mb })
ty += cp.h + cp.mb
end
end
ty = cap_top + boxh
each cp in x.caps:
if cp.bottom:
ty += cp.mt
_layout(t, cp.id, Inp { kw = w, kh = cp.h, pw = w, ph = NO, aw = w, ah = cp.h, inherent = true, axis = 2, perform = true })
cst := t.nodes.ref(cp.id).style
_set_layout(t, cp.id, 0.0, ty, w, cp.h, _r4(cst.padding, w), _r4(cst.border, w), R4 { t = cp.mt, b = cp.mb })
ty += cp.h + cp.mb
end
end
mut gtx := Vector {} as Vector<f64>
defer gtx.free()
mut gty := Vector {} as Vector<f64>
defer gty.free()
each g in x.grps:
y0 := g.r1 > g.r0 ? x.rows[g.r0].y : gtop
y1 := g.r1 > g.r0 ? x.rows[g.r1 - 1].y + x.rows[g.r1 - 1].h : y0
gtx.push(gx0)
gty.push(y0)
if g.id >= 0:
gs := t.nodes.ref(g.id).style
_set_layout(t, g.id, gx0, y0, gw, y1 - y0, _r4(gs.padding, gw), _r4(gs.border, gw), R4 {})
end
end
mut rtx := Vector {} as Vector<f64>
defer rtx.free()
mut rty := Vector {} as Vector<f64>
defer rty.free()
repeat nr in r:
rw := x.rows[r]
g := x.grps[rw.g]
mut px := 0.0
mut py := 0.0
if g.id >= 0:
px = gtx[rw.g]
py = gty[rw.g]
end
rtx.push(px)
rty.push(py)
if rw.id >= 0:
rs := t.nodes.ref(rw.id).style
_set_layout(t, rw.id, gx0 - px, rw.y - py, gw, rw.h, _r4(rs.padding, gw), _r4(rs.border, gw), R4 {})
end
end
each c in x.cells:
rw := x.rows[c.row]
mut ox := 0.0
mut oy := 0.0
if rw.id >= 0:
ox = gx0
oy = rw.y
else x.grps[rw.g].id >= 0:
ox = gtx[rw.g]
oy = gty[rw.g]
end
mut cx0 := x.cols[c.col].x
if rtl:
cx0 = x.cols[c.col + c.cs - 1].x
end
mut ch := vs * ((c.rs - 1) as f64)
repeat c.rs in q:
ch += x.rows[c.row + q].h
end
cst := t.nodes.ref(c.id).style
_layout(t, c.id, Inp { kw = c.w, kh = ch, pw = c.w, ph = ch, aw = c.w, ah = ch, axis = 2, perform = true })
mut off := 0.0
switch cst.vertical_align:
VerticalAlign.Middle:
off = (ch - c.hauto) / 2.0
break
end
VerticalAlign.Bottom:
off = ch - c.hauto
break
end
VerticalAlign.Baseline:
off = _or(rw.base, c.base) - c.base
break
end
else:
end
end
off = _fmax(off, 0.0)
mut cpad := _r4(cst.padding, c.w)
cbor := _r4(cst.border, c.w)
cn := t.nodes.ref(c.id)
if cn.children.len() == 0:
cpad.t += off
cpad.b = _fmax(0.0, cpad.b - off)
else:
_t_shift(t, c.id, off)
end
_set_layout(t, c.id, cx0 - ox, rw.y - oy, c.w, ch, cpad, cbor, R4 {})
if off != 0.0:
cn2 := t.nodes.ref(c.id)
if _is(cn2.base):
cn2.base += off
end
end
end
repeat nc in k:
col := x.cols[k]
if col.id >= 0:
mut px := 0.0
mut py := 0.0
if col.gid >= 0:
px = gx0
py = gtop
end
cs := t.nodes.ref(col.id).style
mut cw := col.w
mut ccx := col.x
mut k2 := k + 1
until k2 < nc and x.cols[k2].id == col.id:
cw += hs + x.cols[k2].w
if rtl:
ccx = x.cols[k2].x
end
k2++
end
if k == 0 or x.cols[k - 1].id != col.id:
_set_layout(t, col.id, ccx - px, gtop - py, cw, gbot - gtop, _r4(cs.padding, cw), _r4(cs.border, cw), R4 {})
end
end
if col.gid >= 0 and (k == 0 or x.cols[k - 1].gid != col.gid):
mut k2 := k
mut cw := 0.0
mut ccx := col.x
until k2 < nc and x.cols[k2].gid == col.gid:
cw += x.cols[k2].w + (k2 > k ? hs : 0.0)
if rtl:
ccx = x.cols[k2].x
end
k2++
end
gs := t.nodes.ref(col.gid).style
_set_layout(t, col.gid, ccx, gtop, cw, gbot - gtop, _r4(gs.padding, cw), _r4(gs.border, cw), R4 {})
end
end
kids := _kids(t, id)
defer kids.free()
each c in kids:
cn := t.nodes.ref(c)
if cn.style.display != Display.None and _oof(cn.style.position):
cn.spx_s = bor.l + pad.l
cn.spx_e = w - bor.r - pad.r
cn.spx_a = rtl ? 1 : 0
cn.spy_s = cap_top + bor.t + pad.t
cn.spy_e = cn.spy_s
cn.spy_a = 0
end
end
_hide_display_none(t, kids)
ret Out { w = w, h = total_h, baseline = base }
end
package cssbox
struct Engine:
pub nodes: Vector<Node> = Vector {}
pub rounding: bool = true
pub measure_calls: int = 0
pub layout_calls: int = 0
pub vw: f64 = MAXC
pub vh: f64 = MAXC
pub oofs: Vector<int> = Vector {}
end
@en "Tree"
@fa "درخت"
pub struct Tree:
e: Engine = Engine {}
@en "AddNode"
@fa "افزودن گره"
pub func AddNode(style: Style): int:
mut st := style
mut gd := GData {}
_gd_set(gd, st)
this.e.nodes.push(Node { style = st, gd = gd, ubor = st.border })
ret this.e.nodes.len() - 1
end
@en "NodeCount"
@fa "شمار گره ها"
pub func NodeCount(): int:
ret this.e.nodes.len()
end
@en "SetChildren"
@fa "تنظیم فرزندان"
pub func SetChildren(node: int, children: Vector<int>):
if node < 0 or node >= this.e.nodes.len():
ret
end
n := this.e.nodes.ref(node)
each old in n.children:
if old >= 0 and old < this.e.nodes.len():
c := this.e.nodes.ref(old)
if c.parent == node:
c.parent = -1
end
end
end
n.children.clear()
each c in children:
if c >= 0 and c < this.e.nodes.len() and c != node:
n.children.push(c)
cn := this.e.nodes.ref(c)
cn.parent = node
end
end
this.MarkDirty(node)
end
@en "AddChild"
@fa "افزودن فرزند"
pub func AddChild(node: int, child: int):
if node < 0 or node >= this.e.nodes.len() or child < 0 or child >= this.e.nodes.len() or child == node:
ret
end
n := this.e.nodes.ref(node)
n.children.push(child)
cn := this.e.nodes.ref(child)
cn.parent = node
this.MarkDirty(node)
end
@en "ChildCount"
@fa "شمار فرزندان"
pub func ChildCount(node: int): int:
if node < 0 or node >= this.e.nodes.len():
ret 0
end
ret this.e.nodes.ref(node).children.len()
end
@en "Child"
@fa "فرزند"
pub func Child(node: int, index: int): int:
if node < 0 or node >= this.e.nodes.len():
ret -1
end
n := this.e.nodes.ref(node)
if index < 0 or index >= n.children.len():
ret -1
end
ret n.children.get(index)
end
@en "Parent"
@fa "والد"
pub func Parent(node: int): int:
if node < 0 or node >= this.e.nodes.len():
ret -1
end
ret this.e.nodes.ref(node).parent
end
@en "GetStyle"
@fa "سبک گره"
pub func GetStyle(node: int): Style:
if node < 0 or node >= this.e.nodes.len():
ret Style {}
end
n := this.e.nodes.ref(node)
if n.bov:
mut st := n.style
st.border = n.ubor
ret st
end
ret n.style
end
@en "SetStyle"
@fa "تنظیم سبک"
pub func SetStyle(node: int, style: Style):
if node < 0 or node >= this.e.nodes.len():
ret
end
n := this.e.nodes.ref(node)
if _style_eq(n.bov ? _with_border(n.style, n.ubor) : n.style, style):
ret
end
mut st := style
_gd_set(n.gd, st)
n.style = st
n.ubor = st.border
n.bov = false
this.MarkDirty(node)
end
@en "SetMeasure"
@fa "تنظیم سنجش"
pub func SetMeasure(node: int, measure: func (MeasureInput) MeasureOutput):
if node < 0 or node >= this.e.nodes.len():
ret
end
n := this.e.nodes.ref(node)
n.measure = measure
n.has_measure = true
this.MarkDirty(node)
end
@en "ClearMeasure"
@fa "حذف سنجش"
pub func ClearMeasure(node: int):
if node < 0 or node >= this.e.nodes.len():
ret
end
n := this.e.nodes.ref(node)
n.has_measure = false
this.MarkDirty(node)
end
@en "MarkDirty"
@fa "علامت تغییر"
pub func MarkDirty(node: int):
mut cur := node
mut guard := 0
until cur >= 0 and cur < this.e.nodes.len() and guard <= this.e.nodes.len():
n := this.e.nodes.ref(cur)
n.fin_ok = false
n.ckeys.clear()
n.couts.clear()
n.cnext = 0
cur = n.parent
guard++
end
end
@en "IsDirty"
@fa "تغییر کرده است"
pub func IsDirty(node: int): bool:
if node < 0 or node >= this.e.nodes.len():
ret false
end
n := this.e.nodes.ref(node)
ret not n.fin_ok and n.ckeys.len() == 0
end
@en "SetRounding"
@fa "تنظیم گردکردن"
pub func SetRounding(enabled: bool):
this.e.rounding = enabled
end
@en "MeasureCalls"
@fa "شمار سنجش ها"
pub func MeasureCalls(): int:
ret this.e.measure_calls
end
@en "LayoutCalls"
@fa "شمار محاسبه ها"
pub func LayoutCalls(): int:
ret this.e.layout_calls
end
@en "ResetCounters"
@fa "صفر کردن شمارنده ها"
pub func ResetCounters():
this.e.measure_calls = 0
this.e.layout_calls = 0
end
@en "Compute"
@fa "محاسبه"
pub func Compute(root: int, width: Space, height: Space):
if root < 0 or root >= this.e.nodes.len():
ret
end
_compute_root(this.e, root, _space_out(width), _space_out(height))
end
@en "Layout"
@fa "جانمایی گره"
pub func Layout(node: int): BoxLayout:
if node < 0 or node >= this.e.nodes.len():
ret BoxLayout {}
end
ret this.e.nodes.ref(node).fin
end
@en "CollapsedBorders"
@fa "مرزهای ادغامی"
pub func CollapsedBorders(table: int): Vector<CollapsedBorder>:
mut out := Vector {} as Vector<CollapsedBorder>
if table >= 0 and table < this.e.nodes.len() and this.e.nodes.ref(table).style.border_collapse == BorderCollapse.Collapse:
_tb_segments(this.e, table, out)
end
ret out
end
@en "Free"
@fa "آزاد کردن"
pub func Free():
repeat this.e.nodes.len() in i:
n := this.e.nodes.ref(i)
n.children.free()
n.ckeys.free()
n.couts.free()
_gd_free(n.gd)
n.gi.tr.free()
_tb_free(n.tb)
end
this.e.nodes.free()
this.e.oofs.free()
end
end
func _len_eq(a: Length, b: Length): bool:
ret a.kind == b.kind and a.value == b.value
end
func _sides_eq(a: Sides, b: Sides): bool:
ret _len_eq(a.top, b.top) and _len_eq(a.right, b.right) and _len_eq(a.bottom, b.bottom) and _len_eq(a.left, b.left)
end
func _with_border(s: Style, b: Sides): Style:
mut r := s
r.border = b
ret r
end
func _style_eq(a: Style, b: Style): bool:
if not (a.display == b.display):
ret false
end
if not (a.position == b.position):
ret false
end
if not (_sides_eq(a.inset, b.inset)):
ret false
end
if not (a.box_sizing == b.box_sizing):
ret false
end
if not (_len_eq(a.width, b.width)):
ret false
end
if not (_len_eq(a.height, b.height)):
ret false
end
if not (_len_eq(a.min_width, b.min_width)):
ret false
end
if not (_len_eq(a.min_height, b.min_height)):
ret false
end
if not (_len_eq(a.max_width, b.max_width)):
ret false
end
if not (_len_eq(a.max_height, b.max_height)):
ret false
end
if not (a.aspect_ratio == b.aspect_ratio):
ret false
end
if not (_sides_eq(a.margin, b.margin)):
ret false
end
if not (_sides_eq(a.padding, b.padding)):
ret false
end
if not (_sides_eq(a.border, b.border)):
ret false
end
if not (a.overflow_x == b.overflow_x):
ret false
end
if not (a.overflow_y == b.overflow_y):
ret false
end
if not (a.scrollbar_width == b.scrollbar_width):
ret false
end
if not (a.direction == b.direction):
ret false
end
if not (a.flex_direction == b.flex_direction):
ret false
end
if not (a.flex_wrap == b.flex_wrap):
ret false
end
if not (a.flex_grow == b.flex_grow):
ret false
end
if not (a.flex_shrink == b.flex_shrink):
ret false
end
if not (_len_eq(a.flex_basis, b.flex_basis)):
ret false
end
if not (a.justify_content == b.justify_content):
ret false
end
