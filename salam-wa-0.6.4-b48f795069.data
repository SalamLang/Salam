@en "EncodeResponse"
@fa "کدگذاری پاسخ"
pub func EncodeResponse(id: int, name: str, qtype: int, rcode: int, records: Vector<dns.Record>): compress.ByteBuf:
mut b := compress.NewByteBufCap(128)
_put_u16(b, id)
_put_u16(b, 33152 + (rcode & 15))
_put_u16(b, 1)
_put_u16(b, records.len())
_put_u16(b, 0)
_put_u16(b, 0)
_put_name(b, name)
_put_u16(b, qtype)
_put_u16(b, dns.ClassIN)
repeat records.len() in i:
r := records.get(i)
_put_name(b, r.name)
_put_u16(b, r.rtype)
_put_u16(b, dns.ClassIN)
compress.BufPushU32(b, r.ttl)
_put_rdata(b, r)
end
ret b
end
@en "FreeServers"
@fa "آزاد کردن کارگزارها"
pub func FreeServers(v &: Vector<Server>):
repeat v.len() in i:
s := v.get(i)
s.addrs.free()
end
v.free()
end
package doh
import mem
import str
import compress
import net.dns
import sync
import time
struct State:
pub servers: Vector<Server> = Vector {}
pub bootstrap: Vector<Server> = Vector {}
pub cache: HashMap<str, CacheEntry> = HashMap {}
pub lock: sync.Mutex = sync.Mutex {}
pub stats: i64* = null
pub min_ttl: int = 10
pub max_ttl: int = 86400
pub neg_ttl: int = 30
pub timeout_ms: int = 4000
pub max_entries: int = 2048
end
@en "CacheEntry"
@fa "ورودی حافظه"
pub struct CacheEntry:
@en "raw"
@fa "پاسخ خام"
pub raw: compress.ByteBuf = compress.ByteBuf {}
@en "expires_ms"
@fa "زمان انقضا"
pub expires_ms: i64 = 0
@en "negative"
@fa "منفی"
pub negative: bool = false
end
@en "Answer"
@fa "پاسخ نهایی"
pub struct Answer:
@en "ok"
@fa "معتبر"
pub ok: bool = false
@en "cached"
@fa "از حافظه"
pub cached: bool = false
@en "negative"
@fa "منفی"
pub negative: bool = false
@en "rcode"
@fa "کد نتیجه"
pub rcode: int = 0
@en "ttl"
@fa "زمان ماندگاری"
pub ttl: int = 0
@en "raw"
@fa "پاسخ خام"
pub raw: compress.ByteBuf = compress.ByteBuf {}
@en "msg"
@fa "پیام"
pub msg: dns.Message = dns.Message {}
@en "server"
@fa "کارگزار"
pub server: str = ""
@en "err"
@fa "خطا"
pub err: str = ""
end
@en "ResolverStats"
@fa "آمار حل‌کننده"
pub struct ResolverStats:
@en "hits"
@fa "برخورد حافظه"
pub hits: i64 = 0
@en "misses"
@fa "ناکامی حافظه"
pub misses: i64 = 0
@en "upstream"
@fa "پرسش بالادست"
pub upstream: i64 = 0
@en "failures"
@fa "شکست‌ها"
pub failures: i64 = 0
end
@en "Resolver"
@fa "حل‌کننده"
pub struct Resolver:
@en "st"
@fa "وضعیت"
pub st: State* = null
end
func _key(name: str, qtype: int): str:
mut n := name.lower()
if n.ends_with("."):
n = n.substr(0, n.len() - 1)
end
ret n + "/" + str.FromInt(qtype as i64)
end
func _bump(r: Resolver, idx: int):
cell := ((r.st[0].stats as i64) + (idx * 8) as i64) as i64*
_v := atomic_add(cell, 1 as i64)
end
func _answer_ttl(msg: dns.Message): int:
mut best := 0 - 1
repeat msg.answers.items.len() in i:
t := msg.answers.items.get(i).ttl
if best < 0 or t < best:
best = t
end
end
ret best
end
func _purge(st: State*, now_ms: i64):
mut dead := Vector {} as Vector<str>
defer dead.free()
each k, v in st[0].cache:
if now_ms >= v.expires_ms:
dead.push(k)
end
end
repeat dead.len() in i:
mut e := st[0].cache.get(dead.get(i))
compress.BufFree(e.raw)
st[0].cache.remove(dead.get(i))
end
if st[0].cache.size() >= st[0].max_entries:
mut all := Vector {} as Vector<str>
defer all.free()
each k, _ in st[0].cache:
all.push(k)
end
repeat all.len() in i:
mut e := st[0].cache.get(all.get(i))
compress.BufFree(e.raw)
st[0].cache.remove(all.get(i))
end
end
end
func _server_ips(r: Resolver, srv: Server): Vector<str>:
mut out := Vector {} as Vector<str>
repeat srv.addrs.len() in i:
out.push(srv.addrs.get(i))
end
if out.len() > 0:
ret out
end
if IsIP(srv.host):
out.push(srv.host)
ret out
end
repeat r.st[0].bootstrap.len() in i:
q := Query(r.st[0].bootstrap.get(i), srv.host, dns.TypeA, r.st[0].timeout_ms)
if q.ok:
repeat q.msg.answers.items.len() in j:
rec := q.msg.answers.items.get(j)
if rec.rtype == dns.TypeA:
out.push(rec.data)
end
end
end
if out.len() > 0:
ret out
end
end
ret out
end
func _purge_all(st: State*):
_purge(st, 9223372036854775807 as i64)
end
func _collect(r: Resolver, name: str, qtype: int): Vector<str>:
mut out := Vector {} as Vector<str>
mut a := Resolve(r, name, qtype)
if a.ok:
repeat a.msg.answers.items.len() in i:
rec := a.msg.answers.items.get(i)
if rec.rtype == qtype:
out.push(rec.data)
end
end
end
FreeAnswer(a)
ret out
end
@en "NewResolver"
@fa "حل‌کننده جدید"
pub func NewResolver(servers: Vector<Server>): Resolver:
st := mem.AllocateZeroed(sizeof(State) as u64) as State*
mut s := State {}
s.servers = servers
s.lock = sync.NewMutex()
s.stats = mem.AllocateZeroed(32 as u64) as i64*
st[0] = s
ret Resolver { st = st }
end
@en "SetBootstrap"
@fa "تعیین کارگزارهای راه‌انداز"
pub func SetBootstrap(r: Resolver, servers: Vector<Server>):
r.st[0].bootstrap = servers
end
@en "SetTTLLimits"
@fa "تعیین حدود ماندگاری"
pub func SetTTLLimits(r: Resolver, min_ttl: int, max_ttl: int, neg_ttl: int):
r.st[0].min_ttl = min_ttl
r.st[0].max_ttl = max_ttl
r.st[0].neg_ttl = neg_ttl
end
@en "SetTimeout"
@fa "تعیین مهلت"
pub func SetTimeout(r: Resolver, timeout_ms: int):
r.st[0].timeout_ms = timeout_ms
end
@en "Stats"
@fa "آمار"
pub func Stats(r: Resolver): ResolverStats:
c := r.st[0].stats
ret ResolverStats { hits = atomic_load(c), misses = atomic_load(((c as i64) + 8) as i64*), upstream = atomic_load(((c as i64) + 16) as i64*), failures = atomic_load(((c as i64) + 24) as i64*) }
end
@en "CacheSize"
@fa "اندازه حافظه"
pub func CacheSize(r: Resolver): int:
_l := sync.Lock(r.st[0].lock)
n := r.st[0].cache.size()
_u := sync.Unlock(r.st[0].lock)
ret n
end
@en "ClearCache"
@fa "پاک کردن حافظه"
pub func ClearCache(r: Resolver):
_l := sync.Lock(r.st[0].lock)
_purge_all(r.st)
_u := sync.Unlock(r.st[0].lock)
end
@en "ResolveAt"
@fa "حل در زمان"
pub func ResolveAt(r: Resolver, name: str, qtype: int, now_ms: i64): Answer:
mut a := Answer {}
key := _key(name, qtype)
st := r.st
_l := sync.Lock(st[0].lock)
if st[0].cache.has(key):
e := st[0].cache.get(key)
if now_ms < e.expires_ms:
a.raw = compress.BufClone(e.raw)
a.cached = true
a.negative = e.negative
a.ttl = ((e.expires_ms - now_ms) / 1000) as int
_u := sync.Unlock(st[0].lock)
a.msg = dns.Decode(a.raw.data, a.raw.len)
a.rcode = a.msg.rcode
a.ok = true
_bump(r, 0)
ret a
end
mut old := e
compress.BufFree(old.raw)
st[0].cache.remove(key)
end
_u2 := sync.Unlock(st[0].lock)
_bump(r, 1)
mut err := "no servers"
mut got := Response {}
mut found := false
repeat st[0].servers.len() in i:
srv := st[0].servers.get(i)
ips := _server_ips(r, srv)
_bump(r, 2)
mut j := 0
until j < ips.len() and not found:
q := QueryAddr(srv, ips.get(j), name, qtype, st[0].timeout_ms)
if q.ok and q.msg.rcode != 2 and q.msg.rcode != 5:
got = q
found = true
else q.ok:
err = srv.name + " rcode " + str.FromInt(q.msg.rcode as i64)
mut qq := q
FreeResponse(qq)
else:
err = srv.name + ": " + q.err
end
j++
end
ips.free()
if found:
break
end
end
if not found:
_bump(r, 3)
a.err = err
ret a
end
mut ttl := _answer_ttl(got.msg)
mut neg := false
if ttl < 0 or got.msg.rcode != 0:
neg = true
ttl = st[0].neg_ttl
end
if ttl < st[0].min_ttl and not neg:
ttl = st[0].min_ttl
end
if ttl > st[0].max_ttl:
ttl = st[0].max_ttl
end
a.ok = true
a.negative = neg
a.rcode = got.msg.rcode
a.ttl = ttl
a.msg = got.msg
a.server = got.server
a.raw = compress.BufClone(got.raw)
entry := CacheEntry { raw = got.raw, expires_ms = now_ms + (ttl as i64) * 1000, negative = neg }
_l2 := sync.Lock(st[0].lock)
if st[0].cache.size() >= st[0].max_entries:
_purge(st, now_ms)
end
if st[0].cache.has(key):
mut prev := st[0].cache.get(key)
compress.BufFree(prev.raw)
end
st[0].cache.put(key, entry)
_u3 := sync.Unlock(st[0].lock)
ret a
end
@en "Resolve"
@fa "حل"
pub func Resolve(r: Resolver, name: str, qtype: int): Answer:
ret ResolveAt(r, name, qtype, time.NowMillis())
end
@en "FreeAnswer"
@fa "آزاد کردن پاسخ نهایی"
pub func FreeAnswer(a &: Answer):
compress.BufFree(a.raw)
end
@en "LookupA"
@fa "جستجوی آ"
pub func LookupA(r: Resolver, name: str): Vector<str>:
ret _collect(r, name, dns.TypeA)
end
@en "LookupAAAA"
@fa "جستجوی کواداِی"
pub func LookupAAAA(r: Resolver, name: str): Vector<str>:
ret _collect(r, name, dns.TypeAAAA)
end
@en "LookupTXT"
@fa "جستجوی تی‌ایکس‌تی"
pub func LookupTXT(r: Resolver, name: str): Vector<str>:
ret _collect(r, name, dns.TypeTXT)
end
@en "LookupCNAME"
@fa "جستجوی سی‌نیم"
pub func LookupCNAME(r: Resolver, name: str): str:
v := _collect(r, name, dns.TypeCNAME)
defer v.free()
if v.len() > 0:
ret v.get(0)
end
ret ""
end
@en "LookupHost"
@fa "جستجوی میزبان"
pub func LookupHost(r: Resolver, name: str): Vector<str>:
if IsIP(name):
mut one := Vector {} as Vector<str>
one.push(name)
ret one
end
v := LookupA(r, name)
if v.len() > 0:
ret v
end
v.free()
ret LookupAAAA(r, name)
end
package doh
import mem
import compress
import net.dns
import net.udp
import net.tcp
import net.internal.rawsock
import sync
struct StubState:
pub sock: udp.Socket = udp.Socket {}
pub resolver: Resolver = Resolver {}
pub stop: i64* = null
pub served: i64* = null
pub inflight: i64* = null
pub tcp_srv: tcp.Server = tcp.Server {}
pub tcp_ok: bool = false
end
struct TcpJob:
pub st: StubState* = null
pub conn: tcp.Conn = tcp.Conn {}
end
struct Job:
pub st: StubState* = null
pub query: compress.ByteBuf = compress.ByteBuf {}
pub host: str = ""
pub port: int = 0
end
@en "Stub"
@fa "کارگزار محلی"
pub struct Stub:
@en "ok"
@fa "معتبر"
pub ok: bool = false
@en "port"
@fa "درگاه"
pub port: int = 0
@en "host"
@fa "میزبان"
pub host: str = ""
@en "tcp_ok"
@fa "تی سی پی فعال"
pub tcp_ok: bool = false
@en "st"
@fa "وضعیت"
pub st: StubState* = null
end
func _answer(st: StubState*, q: compress.ByteBuf): compress.ByteBuf:
msg := dns.Decode(q.data, q.len)
id := msg.id
mut out := compress.NewByteBuf()
mut done := false
if msg.questions.items.len() > 0:
qn := msg.questions.items.get(0)
mut a := Resolve(st[0].resolver, qn.name, qn.qtype)
if a.ok:
out = compress.BufClone(a.raw)
compress.BufSet(out, 0, (id >> 8) & 255)
compress.BufSet(out, 1, id & 255)
done = true
else:
empty := Vector {} as Vector<dns.Record>
out = EncodeResponse(id, qn.name, qn.qtype, 2, empty)
empty.free()
done = true
end
FreeAnswer(a)
end
if done:
_n := atomic_add(st[0].served, 1 as i64)
else:
compress.BufFree(out)
out = compress.NewByteBuf()
end
ret out
end
func _handle(j: Job*):
st := j[0].st
mut out := _answer(st, j[0].query)
if out.len > 0:
_sent := udp.SendBytes(st[0].sock, j[0].host, j[0].port, out.data, out.len)
end
compress.BufFree(out)
mut qq := j[0].query
compress.BufFree(qq)
mem.Free(j as void*)
_d := atomic_add(st[0].inflight, 0 - 1 as i64)
end
func _read_full(c: tcp.Conn, buf: void*, n: int): bool:
mut got := 0
until got < n:
r := tcp.ReadBytes(c, ((buf as i64) + (got as i64)) as void*, n - got)
if r <= 0:
ret false
end
got += r
end
ret true
end
func _tcp_conn(j: TcpJob*):
st := j[0].st
c := j[0].conn
mem.Free(j as void*)
tcp.SetDeadline(c, 5000)
hdr := mem.Allocate(2 as u64)
buf := mem.Allocate(65536 as u64)
until atomic_load(st[0].stop) != 0:
if not _read_full(c, hdr, 2):
break
end
n := ((hdr as u8*)[0] as int) * 256 + ((hdr as u8*)[1] as int)
if n < 12 or not _read_full(c, buf, n):
break
end
mut qb := compress.NewByteBufCap(n)
compress.BufPushBytes(qb, buf, n)
mut out := _answer(st, qb)
compress.BufFree(qb)
if out.len == 0:
compress.BufFree(out)
break
end
mut framed := compress.NewByteBufCap(out.len + 2)
compress.BufPush(framed, (out.len >> 8) & 255)
compress.BufPush(framed, out.len & 255)
compress.BufPushBuf(framed, out)
w := tcp.WriteBytes(c, framed.data, framed.len)
compress.BufFree(framed)
compress.BufFree(out)
if w <= 0:
break
end
end
mem.Free(hdr)
mem.Free(buf)
tcp.Close(c)
_d := atomic_add(st[0].inflight, 0 - 1 as i64)
end
func _tcp_loop(st: StubState*):
until atomic_load(st[0].stop) != 0:
c := tcp.Accept(st[0].tcp_srv)
if atomic_load(st[0].stop) == 0:
if tcp.ConnOk(c):
tcp.Close(c)
end
break
end
if not tcp.ConnOk(c):
sync.SleepMs(5)
else atomic_load(st[0].inflight) >= 256:
tcp.Close(c)
else:
_a := atomic_add(st[0].inflight, 1 as i64)
j := mem.AllocateZeroed(sizeof(TcpJob) as u64) as TcpJob*
j[0] = TcpJob { st = st, conn = c }
_t := spawn(_tcp_conn, j)
end
end
end
func _stub_loop(st: StubState*):
cap := 4096
buf := mem.Allocate(cap as u64)
mut fh := ""
mut fp := 0
until atomic_load(st[0].stop) != 0:
n := udp.ReceiveBytes(st[0].sock, buf, cap, fh, fp)
if n >= 12 and atomic_load(st[0].stop) != 0 and atomic_load(st[0].inflight) < 256:
_a := atomic_add(st[0].inflight, 1 as i64)
j := mem.AllocateZeroed(sizeof(Job) as u64) as Job*
mut qb := compress.NewByteBufCap(n)
compress.BufPushBytes(qb, buf, n)
j[0] = Job { st = st, query = qb, host = fh, port = fp }
_t := spawn(_handle, j)
end
end
mem.Free(buf)
end
@en "StartStub"
@fa "راه‌اندازی کارگزار محلی"
pub func StartStub(r: Resolver, host: str, port: int): Stub:
mut s := Stub {}
mut bind := host
if bind.len() == 0:
bind = "127.0.0.1"
end
sock := udp.BindOn(bind, port)
if not udp.Ok(sock):
ret s
end
udp.SetTimeout(sock, 200)
st := mem.AllocateZeroed(sizeof(StubState) as u64) as StubState*
stop := mem.AllocateZeroed(8 as u64) as i64*
served := mem.AllocateZeroed(8 as u64) as i64*
inflight := mem.AllocateZeroed(8 as u64) as i64*
atomic_store(stop, 1 as i64)
lport := udp.Port(sock)
ts := tcp.BindOn(bind, lport)
st[0] = StubState { sock = sock, resolver = r, stop = stop, served = served, inflight = inflight, tcp_srv = ts, tcp_ok = tcp.Ok(ts) }
_t := spawn(_stub_loop, st)
if tcp.Ok(ts):
_t2 := spawn(_tcp_loop, st)
end
s.ok = true
s.port = lport
s.host = bind
s.tcp_ok = tcp.Ok(ts)
s.st = st
ret s
end
@en "StubServed"
@fa "شمار پاسخ‌های کارگزار محلی"
pub func StubServed(s: Stub): i64:
if not s.ok:
ret 0
end
ret atomic_load(s.st[0].served)
end
@en "StopStub"
@fa "توقف کارگزار محلی"
pub func StopStub(s: Stub):
if not s.ok:
ret
end
atomic_store(s.st[0].stop, 0 as i64)
if s.tcp_ok:
rawsock.Shutdown(rawsock.FromFd(s.st[0].tcp_srv.fd))
tcp.WakeServer(s.host, s.port)
end
sync.SleepMs(300)
if s.tcp_ok:
tcp.CloseServer(s.st[0].tcp_srv)
end
udp.Close(s.st[0].sock)
end
@en "net/email"
@fa "پست الکترونیک"
package email
package email
import str
import conv
import net.tcp
import tls
mut _imap_tls_slots := Vector {} as Vector<tls.Conn>
@en "IMAPClient"
@fa "کارخواه آی‌مپ"
pub struct IMAPClient:
@en "conn"
@fa "اتصال"
pub conn: tcp.Conn = tcp.Conn {}
@en "secure"
@fa "امن"
pub secure: bool = false
@en "tls_idx"
@fa "شناسه درونی تی‌ال‌اس"
pub tls_idx: int = 0 - 1
@en "ok"
@fa "سالم"
pub ok: bool = false
@en "rxbuf"
@fa "بافر دریافت"
pub rxbuf: str = ""
@en "tag_counter"
@fa "شمارنده برچسب"
pub tag_counter: int = 0
end
@en "IMAPReply"
@fa "پاسخ آی‌مپ"
pub struct IMAPReply:
@en "ok"
@fa "موفق"
pub ok: bool = false
@en "status"
@fa "وضعیت"
pub status: str = ""
@en "lines"
@fa "خطوط"
pub lines: Vector<str> = Vector {}
end
func _imap_tls_store(tc: tls.Conn): int:
_imap_tls_slots.push(tc)
ret _imap_tls_slots.len() - 1
end
func _imap_tls_get(idx: int): tls.Conn:
ret _imap_tls_slots.get(idx)
end
func _imap_tls_put(idx: int, tc: tls.Conn):
_imap_tls_slots.set(idx, tc)
end
func _imap_fill(c &: IMAPClient):
mut chunk := ""
if c.secure:
mut tc := _imap_tls_get(c.tls_idx)
chunk = tls.Read(tc, 4096)
_imap_tls_put(c.tls_idx, tc)
else:
chunk = tcp.Read(c.conn, 4096)
end
c.rxbuf += chunk
end
func _imap_read_line(c &: IMAPClient, eof &: bool): str:
eof = false
mut idx := c.rxbuf.find("\r\n")
mut tries := 0
until idx < 0 and tries < 200:
_imap_fill(c)
idx = c.rxbuf.find("\r\n")
tries++
end
if idx < 0:
line := c.rxbuf
c.rxbuf = ""
eof = true
ret line
end
line := c.rxbuf.substr(0, idx)
c.rxbuf = c.rxbuf.substr(idx + 2, c.rxbuf.len() - idx - 2)
ret line
end
func _imap_send_line(c &: IMAPClient, line: str): int:
if c.secure:
mut tc := _imap_tls_get(c.tls_idx)
n := tls.Write(tc, line + "\r\n")
_imap_tls_put(c.tls_idx, tc)
ret n
end
ret tcp.Write(c.conn, line + "\r\n")
end
func _imap_next_tag(c &: IMAPClient): str:
c.tag_counter++
ret "A" + conv.FormatInt(c.tag_counter as i64)
end
func _imap_read_reply(c &: IMAPClient, tag: str): IMAPReply:
mut r := IMAPReply {}
mut done := false
mut safety := 0
until not done:
safety++
mut eof := false
line := _imap_read_line(c, eof)
if line.starts_with(tag):
r.status = line
r.ok = str.Contains(line, " OK")
done = true
else:
r.lines.push(line)
if eof or safety > 10000:
done = true
end
end
end
ret r
end
func _imap_connect_common(conn: tcp.Conn): IMAPClient:
mut c := IMAPClient { conn = conn }
if not tcp.ConnOk(conn):
c.ok = false
ret c
end
mut eof := false
greeting := _imap_read_line(c, eof)
c.ok = str.Contains(greeting, "* OK")
ret c
end
@en "DialIMAP"
@fa "اتصال آی‌مپ"
pub func DialIMAP(host: str, port: int): IMAPClient:
ret _imap_connect_common(tcp.Dial(host, port))
end
@en "DialIMAPTLS"
@fa "اتصال امن آی‌مپ"
pub func DialIMAPTLS(host: str, port: int): IMAPClient:
cfg := tls.NewConfig(host)
tc := tls.Dial(host, port, cfg)
mut c := IMAPClient {}
c.secure = true
c.tls_idx = _imap_tls_store(tc)
if not tls.ConnOk(tc):
c.ok = false
ret c
end
mut eof := false
greeting := _imap_read_line(c, eof)
c.ok = str.Contains(greeting, "* OK")
ret c
end
@en "Command"
@fa "دستور"
pub func Command(c &: IMAPClient, cmd: str): IMAPReply:
tag := _imap_next_tag(c)
_imap_send_line(c, tag + " " + cmd)
ret _imap_read_reply(c, tag)
end
@en "Login"
@fa "ورود"
pub func Login(c &: IMAPClient, username: str, password: str): bool:
r := Command(c, "LOGIN \"" + username + "\" \"" + password + "\"")
ret r.ok
end
@en "LoginXOAuth2"
@fa "ورود ایکس‌اواث۲"
pub func LoginXOAuth2(c &: IMAPClient, username: str, access_token: str): bool:
r := Command(c, "AUTHENTICATE XOAUTH2 " + BuildXOAuth2(username, access_token))
ret r.ok
end
@en "Select"
@fa "انتخاب"
pub func Select(c &: IMAPClient, mailbox: str): bool:
r := Command(c, "SELECT \"" + mailbox + "\"")
ret r.ok
end
@en "List"
@fa "فهرست صندوق‌ها"
pub func List(c &: IMAPClient, reference: str, pattern: str): Vector<str>:
r := Command(c, "LIST \"" + reference + "\" \"" + pattern + "\"")
ret r.lines
end
@en "Fetch"
@fa "دریافت پیام‌ها"
pub func Fetch(c &: IMAPClient, seq: str, items: str): Vector<str>:
r := Command(c, "FETCH " + seq + " (" + items + ")")
ret r.lines
end
@en "Logout"
@fa "خروج آی‌مپ"
pub func Logout(c &: IMAPClient):
Command(c, "LOGOUT")
if c.secure:
mut tc := _imap_tls_get(c.tls_idx)
tls.Close(tc)
_imap_tls_put(c.tls_idx, tc)
else:
tcp.Close(c.conn)
end
end
package email
import str
import encoding
@en "BuildXOAuth2"
@fa "ساخت ایکس‌اواث۲"
pub func BuildXOAuth2(username: str, access_token: str): str:
mut sb := str.NewBuilder()
defer str.BufFree(sb)
str.BufAppend(sb, "user=")
str.BufAppend(sb, username)
str.BufAppendChar(sb, 1)
str.BufAppend(sb, "auth=Bearer ")
str.BufAppend(sb, access_token)
str.BufAppendChar(sb, 1)
str.BufAppendChar(sb, 1)
raw := str.BufStr(sb)
ret encoding.Base64Encode(raw)
end
package email
import str
import net.tcp
import tls
mut _pop3_tls_slots := Vector {} as Vector<tls.Conn>
@en "POP3Client"
@fa "کارخواه پاپ۳"
pub struct POP3Client:
@en "conn"
@fa "اتصال"
pub conn: tcp.Conn = tcp.Conn {}
@en "secure"
@fa "امن"
pub secure: bool = false
@en "tls_idx"
@fa "شناسه درونی تی‌ال‌اس"
pub tls_idx: int = 0 - 1
@en "ok"
@fa "سالم"
pub ok: bool = false
@en "rxbuf"
@fa "بافر دریافت"
pub rxbuf: str = ""
end
func _pop3_tls_store(tc: tls.Conn): int:
_pop3_tls_slots.push(tc)
ret _pop3_tls_slots.len() - 1
end
func _pop3_tls_get(idx: int): tls.Conn:
ret _pop3_tls_slots.get(idx)
end
func _pop3_tls_put(idx: int, tc: tls.Conn):
_pop3_tls_slots.set(idx, tc)
end
func _pop3_fill(c &: POP3Client):
mut chunk := ""
if c.secure:
mut tc := _pop3_tls_get(c.tls_idx)
chunk = tls.Read(tc, 4096)
_pop3_tls_put(c.tls_idx, tc)
else:
chunk = tcp.Read(c.conn, 4096)
end
c.rxbuf += chunk
end
func _pop3_read_line(c &: POP3Client): str:
mut idx := c.rxbuf.find("\r\n")
mut tries := 0
until idx < 0 and tries < 200:
_pop3_fill(c)
idx = c.rxbuf.find("\r\n")
tries++
end
if idx < 0:
line := c.rxbuf
c.rxbuf = ""
ret line
end
line := c.rxbuf.substr(0, idx)
c.rxbuf = c.rxbuf.substr(idx + 2, c.rxbuf.len() - idx - 2)
ret line
end
func _pop3_send_line(c &: POP3Client, line: str): int:
if c.secure:
mut tc := _pop3_tls_get(c.tls_idx)
n := tls.Write(tc, line + "\r\n")
_pop3_tls_put(c.tls_idx, tc)
ret n
end
ret tcp.Write(c.conn, line + "\r\n")
end
func _pop3_command(c &: POP3Client, line: str): str:
_pop3_send_line(c, line)
ret _pop3_read_line(c)
end
func _pop3_ok(reply: str): bool:
ret reply.len() >= 3 and reply.starts_with("+OK")
end
func _pop3_read_multiline(c &: POP3Client): Vector<str>:
mut out := Vector {} as Vector<str>
mut done := false
mut safety := 0
until not done:
safety++
line := _pop3_read_line(c)
if line == "." or safety > 100000:
done = true
else:
if line.len() >= 2 and line.starts_with(".."):
out.push(line.substr(1, line.len() - 1))
else:
out.push(line)
end
end
end
ret out
end
func _pop3_connect_common(conn: tcp.Conn): POP3Client:
mut c := POP3Client { conn = conn }
if not tcp.ConnOk(conn):
c.ok = false
ret c
end
greeting := _pop3_read_line(c)
c.ok = _pop3_ok(greeting)
ret c
end
@en "DialPOP3"
@fa "اتصال پاپ۳"
pub func DialPOP3(host: str, port: int): POP3Client:
ret _pop3_connect_common(tcp.Dial(host, port))
end
@en "DialPOP3TLS"
@fa "اتصال امن پاپ۳"
pub func DialPOP3TLS(host: str, port: int): POP3Client:
cfg := tls.NewConfig(host)
tc := tls.Dial(host, port, cfg)
mut c := POP3Client {}
c.secure = true
c.tls_idx = _pop3_tls_store(tc)
if not tls.ConnOk(tc):
c.ok = false
ret c
end
greeting := _pop3_read_line(c)
c.ok = _pop3_ok(greeting)
ret c
end
@en "User"
@fa "کاربر"
pub func User(c &: POP3Client, username: str): bool:
ret _pop3_ok(_pop3_command(c, "USER " + username))
end
@en "Pass"
@fa "گذرواژه"
pub func Pass(c &: POP3Client, password: str): bool:
ret _pop3_ok(_pop3_command(c, "PASS " + password))
end
@en "Stat"
@fa "وضعیت"
pub func Stat(c &: POP3Client): str:
ret _pop3_command(c, "STAT")
end
@en "POP3List"
@fa "فهرست پیام‌های پاپ۳"
pub func POP3List(c &: POP3Client): Vector<str>:
reply := _pop3_command(c, "LIST")
if not _pop3_ok(reply): ret Vector {} end
ret _pop3_read_multiline(c)
end
@en "Retr"
@fa "دریافت پیام پاپ۳"
pub func Retr(c &: POP3Client, msgnum: int): str:
reply := _pop3_command(c, "RETR " + str.FromInt(msgnum as i64))
if not _pop3_ok(reply): ret "" end
lines := _pop3_read_multiline(c)
ret str.Join(lines, "\r\n")
end
@en "Dele"
@fa "حذف"
pub func Dele(c &: POP3Client, msgnum: int): bool:
ret _pop3_ok(_pop3_command(c, "DELE " + str.FromInt(msgnum as i64)))
end
@en "POP3Quit"
@fa "خروج پاپ۳"
pub func POP3Quit(c &: POP3Client):
_pop3_command(c, "QUIT")
if c.secure:
mut tc := _pop3_tls_get(c.tls_idx)
tls.Close(tc)
_pop3_tls_put(c.tls_idx, tc)
else:
tcp.Close(c.conn)
end
end
package email
import mem
import str
import encoding
import crypto
import net.tcp
import tls
mut _smtp_tls_slots := Vector {} as Vector<tls.Conn>
@en "SMTPClient"
@fa "کارخواه اس‌ام‌تی‌پی"
pub struct SMTPClient:
@en "conn"
@fa "اتصال"
pub conn: tcp.Conn = tcp.Conn {}
@en "secure"
@fa "امن"
pub secure: bool = false
@en "tls_idx"
@fa "شناسه درونی تی‌ال‌اس"
pub tls_idx: int = 0 - 1
@en "ok"
@fa "سالم"
pub ok: bool = false
@en "rxbuf"
@fa "بافر دریافت"
pub rxbuf: str = ""
@en "last_reply"
@fa "آخرین پاسخ"
pub last_reply: str = ""
end
func _smtp_tls_store(tc: tls.Conn): int:
_smtp_tls_slots.push(tc)
ret _smtp_tls_slots.len() - 1
end
func _smtp_tls_get(idx: int): tls.Conn:
ret _smtp_tls_slots.get(idx)
end
func _smtp_tls_put(idx: int, tc: tls.Conn):
_smtp_tls_slots.set(idx, tc)
end
func _smtp_fill(c &: SMTPClient):
mut chunk := ""
if c.secure:
mut tc := _smtp_tls_get(c.tls_idx)
chunk = tls.Read(tc, 4096)
_smtp_tls_put(c.tls_idx, tc)
else:
chunk = tcp.Read(c.conn, 4096)
end
c.rxbuf += chunk
end
func _smtp_read_line(c &: SMTPClient): str:
mut idx := c.rxbuf.find("\r\n")
mut tries := 0
until idx < 0 and tries < 200:
_smtp_fill(c)
idx = c.rxbuf.find("\r\n")
tries++
end
if idx < 0:
line := c.rxbuf
c.rxbuf = ""
ret line
end
line := c.rxbuf.substr(0, idx)
c.rxbuf = c.rxbuf.substr(idx + 2, c.rxbuf.len() - idx - 2)
ret line
end
func _smtp_read_reply(c &: SMTPClient): str:
mut full := ""
mut done := false
until not done:
line := _smtp_read_line(c)
full += line + "\r\n"
if line.len() == 0:
done = true
else line.len() >= 4 and line.substr(3, 1) == " ":
done = true
end
end
ret full
end
func _smtp_send_line(c &: SMTPClient, line: str): int:
if c.secure:
mut tc := _smtp_tls_get(c.tls_idx)
n := tls.Write(tc, line + "\r\n")
_smtp_tls_put(c.tls_idx, tc)
ret n
end
ret tcp.Write(c.conn, line + "\r\n")
end
func _smtp_code(reply: str): int:
if reply.len() < 3: ret 0 end
ret reply.substr(0, 3).to_int()
end
func _smtp_command(c &: SMTPClient, line: str): bool:
_smtp_send_line(c, line)
c.last_reply = _smtp_read_reply(c)
code := _smtp_code(c.last_reply)
ret code > 0 and code < 400
end
func _dot_stuff(body: str): str:
lines := str.Split(body, "\r\n")
mut out := ""
mut i := 0
until i < lines.len():
line := lines.get(i)
if line.starts_with("."):
out += "."
end
out += line
if i < lines.len() - 1:
out += "\r\n"
end
i++
end
ret out
end
func _hdr_line(name: str, value: str): str:
ret name + ": " + value + "\r\n"
end
func _smtp_connect_common(conn: tcp.Conn): SMTPClient:
mut c := SMTPClient { conn = conn }
if not tcp.ConnOk(conn):
c.ok = false
ret c
end
c.last_reply = _smtp_read_reply(c)
c.ok = _smtp_code(c.last_reply) == 220
ret c
end
@en "DialSMTP"
@fa "اتصال اس‌ام‌تی‌پی"
pub func DialSMTP(host: str, port: int): SMTPClient:
ret _smtp_connect_common(tcp.Dial(host, port))
end
@en "DialSMTPTLS"
@fa "اتصال امن اس‌ام‌تی‌پی"
pub func DialSMTPTLS(host: str, port: int): SMTPClient:
cfg := tls.NewConfig(host)
tc := tls.Dial(host, port, cfg)
mut c := SMTPClient {}
c.secure = true
c.tls_idx = _smtp_tls_store(tc)
if not tls.ConnOk(tc):
c.ok = false
ret c
end
c.last_reply = _smtp_read_reply(c)
c.ok = _smtp_code(c.last_reply) == 220
ret c
end
@en "Hello"
@fa "سلام"
pub func Hello(c &: SMTPClient, domain: str): bool:
ret _smtp_command(c, "EHLO " + domain)
end
@en "StartTLS"
@fa "شروع تی‌ال‌اس"
pub func StartTLS(c &: SMTPClient, host: str): bool:
if not _smtp_command(c, "STARTTLS"): ret false end
cfg := tls.NewConfig(host)
tc := tls.WrapClient(c.conn.fd, cfg)
if not tls.ConnOk(tc): ret false end
c.secure = true
c.tls_idx = _smtp_tls_store(tc)
c.rxbuf = ""
ret true
end
@en "AuthLogin"
@fa "ورود با احراز هویت"
pub func AuthLogin(c &: SMTPClient, username: str, password: str): bool:
if not _smtp_command(c, "AUTH LOGIN"): ret false end
if not _smtp_command(c, encoding.Base64Encode(username)): ret false end
ret _smtp_command(c, encoding.Base64Encode(password))
end
@en "AuthPlain"
@fa "ورود ساده"
pub func AuthPlain(c &: SMTPClient, username: str, password: str): bool:
mut sb := str.NewBuilder()
defer str.BufFree(sb)
str.BufAppendChar(sb, 0)
str.BufAppend(sb, username)
str.BufAppendChar(sb, 0)
str.BufAppend(sb, password)
ret _smtp_command(c, "AUTH PLAIN " + encoding.Base64EncodeBytes(sb.data, sb.len as int))
end
@en "AuthXOAuth2"
@fa "احراز هویت ایکس‌اواث۲"
pub func AuthXOAuth2(c &: SMTPClient, username: str, access_token: str): bool:
ret _smtp_command(c, "AUTH XOAUTH2 " + BuildXOAuth2(username, access_token))
end
@en "MailFrom"
@fa "فرستنده"
pub func MailFrom(c &: SMTPClient, addr: str): bool:
ret _smtp_command(c, "MAIL FROM:<" + addr + ">")
end
@en "RcptTo"
@fa "گیرنده"
pub func RcptTo(c &: SMTPClient, addr: str): bool:
ret _smtp_command(c, "RCPT TO:<" + addr + ">")
end
@en "Data"
@fa "داده"
pub func Data(c &: SMTPClient, raw_message: str): bool:
if not _smtp_command(c, "DATA"): ret false end
_smtp_send_line(c, _dot_stuff(raw_message))
ret _smtp_command(c, ".")
end
@en "Quit"
@fa "خروج اس‌ام‌تی‌پی"
pub func Quit(c &: SMTPClient):
_smtp_command(c, "QUIT")
if c.secure:
mut tc := _smtp_tls_get(c.tls_idx)
tls.Close(tc)
_smtp_tls_put(c.tls_idx, tc)
else:
tcp.Close(c.conn)
end
end
@en "BuildMessage"
@fa "ساخت پیام"
pub func BuildMessage(from: str, to_addr: str, subject: str, text_body: str, html_body: str): str:
mut headers := _hdr_line("From", from)
headers += _hdr_line("To", to_addr)
headers += _hdr_line("Subject", subject)
headers += _hdr_line("MIME-Version", "1.0")
if html_body.len() == 0:
headers += _hdr_line("Content-Type", "text/plain; charset=utf-8")
ret headers + "\r\n" + text_body
end
if text_body.len() == 0:
headers += _hdr_line("Content-Type", "text/html; charset=utf-8")
ret headers + "\r\n" + html_body
end
boundary := "SalamAltBoundary" + crypto.RandomHex(12)
headers += _hdr_line("Content-Type", "multipart/alternative; boundary=" + boundary)
mut body := "--" + boundary + "\r\n"
body += "Content-Type: text/plain; charset=utf-8\r\n\r\n"
body += text_body + "\r\n"
body += "--" + boundary + "\r\n"
body += "Content-Type: text/html; charset=utf-8\r\n\r\n"
body += html_body + "\r\n"
body += "--" + boundary + "--\r\n"
ret headers + "\r\n" + body
end
@en "Send"
@fa "ارسال"
pub func Send(host: str, port: int, use_tls: bool, username: str, password: str, from: str, to_addr: str, subject: str, text_body: str, html_body: str): bool:
mut c := SMTPClient {}
if use_tls:
c = DialSMTPTLS(host, port)
else:
c = DialSMTP(host, port)
end
if not c.ok: ret false end
if not Hello(c, "localhost"): ret false end
if not use_tls:
if not StartTLS(c, host):
Quit(c)
ret false
end
if not Hello(c, "localhost"):
Quit(c)
ret false
end
end
if username.len() > 0:
if not AuthPlain(c, username, password): ret false end
end
if not MailFrom(c, from): ret false end
if not RcptTo(c, to_addr): ret false end
msg := BuildMessage(from, to_addr, subject, text_body, html_body)
ok := Data(c, msg)
Quit(c)
ret ok
end
@en "fastcgi"
@fa "فست سی جی آی"
package fastcgi
import str
import mem
import sync
import net.tcp
const VERSION := 1
const BEGIN_REQUEST := 1
const END_REQUEST := 3
const PARAMS := 4
const STDIN := 5
const STDOUT := 6
const STDERR := 7
const ROLE_RESPONDER := 1
const MAX_CONTENT := 32768
const READ_CHUNK := 65536
struct Buf:
pub data: void* = null
pub len: int = 0
pub cap: int = 0
pub bad: bool = false
end
@en "Param"
@fa "پارامتر"
pub struct Param:
@en "name"
@fa "نام"
pub name: str = ""
@en "value"
@fa "مقدار"
pub value: str = ""
end
@en "Params"
@fa "پارامترها"
pub struct Params:
@en "items"
@fa "آیتم ها"
pub items: Vector<Param> = Vector {}
end
@en "Header"
@fa "سرصفحه"
pub struct Header:
@en "name"
@fa "نام"
pub name: str = ""
@en "value"
@fa "مقدار"
pub value: str = ""
end
@en "Response"
@fa "پاسخ"
pub struct Response:
@en "status"
@fa "وضعیت"
pub status: int = 0
@en "headers"
@fa "سرصفحه ها"
pub headers: Vector<Header> = Vector {}
@en "body"
@fa "بدنه"
pub body: void* = null
@en "len"
@fa "اندازه"
pub len: int = 0
@en "ok"
@fa "موفق"
pub ok: bool = false
@en "error"
@fa "خطا"
pub error: str = ""
end
inline func _at(p: void*, off: int): void*:
ret ((p as i64) + (off as i64)) as void *
end
inline func _byte(p: void*, i: int): int:
bp := p as u8 *
ret bp[i] as int
end
func _new(cap: int): Buf:
mut b := Buf {}
mut size := cap
if size < 64: size = 64 end
p := mem.Allocate(size as u64)
if p == null:
b.bad = true
else:
b.data = p
b.cap = size
end
ret b
end
func _free_buf(b: Buf):
if b.data != null:
mem.Free(b.data)
end
b.data = null
b.len = 0
b.cap = 0
end
func _reserve(b &: Buf, need: int): bool:
if b.bad: ret false end
if b.len + need <= b.cap: ret true end
mut nc := b.cap
if nc < 64: nc = 64 end
until nc >= b.len + need: nc *= 2 end
p := mem.Reallocate(b.data, nc as u64)
if p == null:
b.bad = true
ret false
end
b.data = p
b.cap = nc
ret true
end
func _put(b &: Buf, src: void*, n: int):
if n <= 0 or b.bad: ret end
if not _reserve(b, n): ret end
mem.Copy(_at(b.data, b.len), src, n as u64)
b.len += n
end
func _put_str(b &: Buf, s: str):
_put(b, s as void *, s.len())
end
func _u8(b &: Buf, v: int):
if not _reserve(b, 1): ret end
p := b.data as u8 *
p[b.len] = (v & 255) as u8
b.len++
end
func _u16(b &: Buf, v: int):
_u8(b, (v >> 8) & 255)
_u8(b, v & 255)
end
func _put_len(b &: Buf, n: int):
if n < 128:
_u8(b, n)
else:
_u8(b, ((n >> 24) & 127) | 128)
_u8(b, (n >> 16) & 255)
_u8(b, (n >> 8) & 255)
_u8(b, n & 255)
end
end
func _head(b &: Buf, typ: int, n: int):
_u8(b, VERSION)
_u8(b, typ)
_u16(b, 1)
_u16(b, n)
_u8(b, 0)
_u8(b, 0)
end
func _write_all(c: tcp.Conn, p: void*, n: int): bool:
mut off := 0
until off < n:
k := tcp.WriteBytes(c, _at(p, off), n - off)
if k <= 0: ret false end
off += k
end
ret true
end
func _read_exact(c: tcp.Conn, p: void*, n: int): int:
mut got := 0
until got < n:
k := tcp.ReadBytes(c, _at(p, got), n - got)
if k <= 0: ret got end
got += k
end
ret got
end
func _send_record(c: tcp.Conn, typ: int, p: void*, n: int): bool:
mut h := _new(8)
_head(h, typ, n)
mut ok := _write_all(c, h.data, 8)
_free_buf(h)
if ok and n > 0:
ok = _write_all(c, p, n)
end
ret ok
end
func _head_end(p: void*, n: int): int:
mut i := 0
until i + 3 < n:
if _byte(p, i) == 13 and _byte(p, i + 1) == 10 and _byte(p, i + 2) == 13 and _byte(p, i + 3) == 10:
ret i + 4
end
i++
end
until i + 1 < n:
if _byte(p, i) == 10 and _byte(p, i + 1) == 10:
ret i + 2
end
i++
end
ret -1
end
func _bytes_str(p: void*, n: int): str:
mut sb := str.NewBuilder()
defer str.BufFree(sb)
repeat n in i:
str.BufAppendChar(sb, _byte(p, i))
end
ret str.BufStr(sb)
end
func _status_code(v: str): int:
if v.len() < 3: ret 0 end
bp := v as u8 *
repeat 3 in i:
if (bp[i] as int) < 48 or (bp[i] as int) > 57: ret 0 end
end
ret v.substr(0, 3).to_int()
end
func _free_parts(v: Vector<str>):
repeat v.len() in i:
mem.Free(v.get(i) as void *)
end
v.free()
end
func _parse_head(r &: Response, head: str):
lines := str.Split(head, "\n")
repeat lines.len() in i:
line := str.Trim(lines.get(i))
if line.len() == 0: continue end
c := line.indexOf(":")
if c <= 0: continue end
name := str.Trim(line.substr(0, c))
value := str.Trim(line.substr(c + 1, line.len() - c - 1))
if str.Equals(str.Lower(name), "status"):
code := _status_code(value)
if code >= 100 and code <= 599: r.status = code end
else:
r.headers.push(Header { name = str.Clone(name), value = str.Clone(value) })
end
end
_free_parts(lines)
end
@en "NewParams"
@fa "پارامترهای جدید"
pub func NewParams(): Params:
ret Params {}
end
@en "Add"
@fa "افزودن"
pub func Add(p &: Params, name: str, value: str):
p.items.push(Param { name = str.Clone(name), value = str.Clone(value) })
end
@en "Free"
@fa "آزادسازی"
pub func Free(p &: Params):
repeat p.items.len() in i:
it := p.items.get(i)
mem.Free(it.name as void *)
mem.Free(it.value as void *)
end
p.items.free()
end
@en "Connect"
@fa "اتصال"
pub func Connect(host: str, port: int, timeout_ms: int): tcp.Conn:
mut wait := timeout_ms
if wait <= 0: wait = 30000 end
ret tcp.DialTimeout(host, port, wait)
end
@en "Execute"
@fa "اجرا"
pub func Execute(c: tcp.Conn, params: Params, data: void*, n: int, timeout_ms: int): Response:
if not tcp.ConnOk(c):
ret Response { error = "the FastCGI connection is not open" }
end
mut wait := timeout_ms
if wait <= 0: wait = 30000 end
tcp.SetDeadline(c, wait)
deadline := sync.NowMs() + (wait as i64)
mut pb := _new(1024)
repeat params.items.len() in i:
it := params.items.get(i)
_put_len(pb, it.name.len())
_put_len(pb, it.value.len())
_put_str(pb, it.name)
_put_str(pb, it.value)
end
if pb.bad:
_free_buf(pb)
ret Response { error = "out of memory building the FastCGI parameters" }
end
mut rec := _new(16)
_head(rec, BEGIN_REQUEST, 8)
_u16(rec, ROLE_RESPONDER)
_u8(rec, 0)
_u8(rec, 0)
_u8(rec, 0)
_u8(rec, 0)
_u8(rec, 0)
_u8(rec, 0)
ok := _write_all(c, rec.data, rec.len)
_free_buf(rec)
if not ok:
_free_buf(pb)
ret Response { error = "could not send the request to the FastCGI backend" }
end
mut off := 0
until off < pb.len:
mut size := pb.len - off
if size > MAX_CONTENT: size = MAX_CONTENT end
if not _send_record(c, PARAMS, _at(pb.data, off), size):
_free_buf(pb)
ret Response { error = "could not send the parameters to the FastCGI backend" }
end
off += size
end
_free_buf(pb)
if not _send_record(c, PARAMS, null, 0):
ret Response { error = "could not send the parameters to the FastCGI backend" }
end
mut boff := 0
until boff < n:
mut size := n - boff
if size > MAX_CONTENT: size = MAX_CONTENT end
if not _send_record(c, STDIN, _at(data, boff), size):
ret Response { error = "could not send the body to the FastCGI backend" }
end
boff += size
end
if not _send_record(c, STDIN, null, 0):
ret Response { error = "could not send the body to the FastCGI backend" }
end
mut out := _new(4096)
mut errb := _new(256)
scratch := mem.Allocate(READ_CHUNK as u64)
hdr := mem.Allocate(8 as u64)
mut failed := ""
mut done := false
mut proto := 0
until not done and failed.len() == 0:
if _read_exact(c, hdr, 8) != 8:
if sync.NowMs() >= deadline - 5:
failed = "the FastCGI backend timed out"
else:
failed = "the FastCGI backend closed the connection without answering"
end
break
end
typ := _byte(hdr, 1)
rec_len := (_byte(hdr, 4) << 8) | _byte(hdr, 5)
plen := _byte(hdr, 6)
if rec_len > 0:
if typ == STDOUT:
if not _reserve(out, rec_len):
failed = "out of memory reading the FastCGI response"
else:
got := _read_exact(c, _at(out.data, out.len), rec_len)
if got != rec_len:
failed = "the FastCGI response was cut short"
else:
out.len += rec_len
end
end
else:
got := _read_exact(c, scratch, rec_len)
if got != rec_len:
failed = "the FastCGI response was cut short"
else:
if typ == STDERR:
_put(errb, scratch, rec_len)
else typ == END_REQUEST and rec_len >= 5:
proto = _byte(scratch, 4)
end
end
end
end
if plen > 0 and failed.len() == 0:
if _read_exact(c, scratch, plen) != plen:
failed = "the FastCGI response was cut short"
end
end
if typ == END_REQUEST: done = true end
end
mut note := failed
mut errtxt := ""
if errb.len > 0:
errtxt = _bytes_str(errb.data, errb.len)
end
_free_buf(errb)
mem.Free(scratch)
mem.Free(hdr)
if note.len() > 0:
_free_buf(out)
ret Response { error = note }
end
if not done:
_free_buf(out)
ret Response { error = "the FastCGI backend did not finish the request" }
end
if proto != 0:
_free_buf(out)
ret Response { error = "the FastCGI backend ended the request with protocol status " + str.FromInt(proto as i64) }
end
hend := _head_end(out.data, out.len)
if hend < 0:
_free_buf(out)
mut msg := "the FastCGI response has no header block"
if errtxt.len() > 0:
msg = msg + ": " + errtxt
end
ret Response { error = msg }
end
head := _bytes_str(out.data, hend)
mut r := Response { status = 200 }
_parse_head(r, head)
body_len := out.len - hend
if body_len > 0:
mem.MemMove(out.data, _at(out.data, hend), body_len as u64)
r.body = out.data
r.len = body_len
else:
_free_buf(out)
end
r.ok = true
ret r
end
@en "FreeResponse"
@fa "آزادسازی پاسخ"
pub func FreeResponse(r &: Response):
repeat r.headers.len() in i:
h := r.headers.get(i)
mem.Free(h.name as void *)
mem.Free(h.value as void *)
end
r.headers.free()
if r.body != null:
mem.Free(r.body)
r.body = null
r.len = 0
end
end
