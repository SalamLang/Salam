package reactive
@en "Tracker"
@fa "ردیاب"
pub struct Tracker:
@en "node"
@fa "گره"
pub node: int = -1
@en "IsDirty"
@fa "کهنه است"
pub func IsDirty(): bool:
ret _rx_is_dirty(this.node)
end
@en "Refresh"
@fa "تازه کن"
pub func Refresh(): bool:
if not _rx_is_dirty(this.node):
ret false
end
_rx_eval(this.node)
ret true
end
@en "Name"
@fa "نام بده"
pub func Name(name: str): Tracker:
_rx_set_name(this.node, name)
ret this[0]
end
@en "Free"
@fa "آزاد کن"
pub func Free():
_rx_node_free(this.node)
end
end
@en "Handler"
@fa "کنترل‌کننده"
pub struct Handler:
@en "node"
@fa "گره"
pub node: int = -1
@en "Free"
@fa "آزاد کن"
pub func Free():
_rx_node_free(this.node)
end
end
func _rx_track(body: func (), cb: int): Tracker:
n := _rx_node_new(_K_TRACKER)
_p := _rx_bind_new(n, _B_TRACK, _rx_slot_void(body), cb)
_rx_eval(n)
ret Tracker { node = n }
end
func _rx_on_change(w: int, body: func ()): Handler:
if w < 0 or not _rx_live(w):
ret Handler {}
end
n := _rx_node_new(_K_HANDLER)
_p := _rx_bind_new(n, _B_HANDLER, _rx_slot_void(body), w)
_rx_eval(n)
_n_val.set(n, _n_ver.get(w) as i64)
ret Handler { node = n }
end
func _rx_run_handler(h: int): bool:
if not _rx_live(h) or _rx_kind(h) != _K_HANDLER:
ret false
end
if (_n_flags.get(h) & _F_DIRTY) == 0:
ret false
end
b := _n_bind.get(h)
w := _b_aux.get(b)
_rx_eval(h)
if not _rx_live(w):
ret false
end
v := _n_ver.get(w) as i64
if v == _n_val.get(h):
ret false
end
_n_val.set(h, v)
f := _f_void.get(_b_fn.get(b))
f()
ret true
end
@en "Track"
@fa "ردیابی"
pub func Track(body: func ()): Tracker:
ret _rx_track(body, -1)
end
@en "Track"
@fa "ردیابی"
pub func Track(body: func (), on_dirty: func ()): Tracker:
ret _rx_track(body, _rx_slot_void(on_dirty))
end
@en "OnChange"
@fa "هنگام تغییر"
pub func OnChange(p: IntProp, body: func ()): Handler:
ret _rx_on_change(p.node, body)
end
@en "OnChange"
@fa "هنگام تغییر"
pub func OnChange(p: I64Prop, body: func ()): Handler:
ret _rx_on_change(p.node, body)
end
@en "OnChange"
@fa "هنگام تغییر"
pub func OnChange(p: F64Prop, body: func ()): Handler:
ret _rx_on_change(p.node, body)
end
@en "OnChange"
@fa "هنگام تغییر"
pub func OnChange(p: BoolProp, body: func ()): Handler:
ret _rx_on_change(p.node, body)
end
@en "OnChange"
@fa "هنگام تغییر"
pub func OnChange(p: StrProp, body: func ()): Handler:
ret _rx_on_change(p.node, body)
end
@en "PendingHandlers"
@fa "کنترل‌کننده های منتظر"
pub func PendingHandlers(): int:
mut n := 0
each h in _hq:
if _rx_live(h) and _rx_kind(h) == _K_HANDLER and (_n_flags.get(h) & _F_DIRTY) != 0:
n++
end
end
ret n
end
@en "RunPendingHandlers"
@fa "اجرای کنترل‌کننده ها"
pub func RunPendingHandlers(): int:
mut calls := 0
mut rounds := 0
until _hq.len() > 0:
rounds++
if rounds > _HANDLER_ROUNDS:
_rx_error("change handlers did not settle after " + _HANDLER_ROUNDS + " rounds")
each h in _hq:
if _rx_live(h) and _rx_kind(h) == _K_HANDLER:
_n_flags.set(h, _n_flags.get(h) & ~_F_DIRTY)
end
end
_hq.clear()
break
end
mut q := Vector {} as Vector<int>
each h2 in _hq:
q.push(h2)
end
_hq.clear()
each h3 in q:
if _rx_run_handler(h3):
calls++
end
end
q.free()
end
ret calls
end
package typeset
const _AR_ISOLATED := 0
const _AR_FINAL := 1
const _AR_INITIAL := 2
const _AR_MEDIAL := 3
func _arabic_form_base(cp: int, count &: int): int:
count = 0
if cp == 0xFEF5 or cp == 0xFEF7 or cp == 0xFEF9 or cp == 0xFEFB:
count = 2
ret cp
end
if cp < 0x0621 or cp > 0x06D3:
ret 0
end
if cp == 0x0621: count = 1 ret 0xFE80 end
if cp == 0x0622: count = 2 ret 0xFE81 end
if cp == 0x0623: count = 2 ret 0xFE83 end
if cp == 0x0624: count = 2 ret 0xFE85 end
if cp == 0x0625: count = 2 ret 0xFE87 end
if cp == 0x0626: count = 4 ret 0xFE89 end
if cp == 0x0627: count = 2 ret 0xFE8D end
if cp == 0x0628: count = 4 ret 0xFE8F end
if cp == 0x0629: count = 2 ret 0xFE93 end
if cp == 0x062A: count = 4 ret 0xFE95 end
if cp == 0x062B: count = 4 ret 0xFE99 end
if cp == 0x062C: count = 4 ret 0xFE9D end
if cp == 0x062D: count = 4 ret 0xFEA1 end
if cp == 0x062E: count = 4 ret 0xFEA5 end
if cp == 0x062F: count = 2 ret 0xFEA9 end
if cp == 0x0630: count = 2 ret 0xFEAB end
if cp == 0x0631: count = 2 ret 0xFEAD end
if cp == 0x0632: count = 2 ret 0xFEAF end
if cp == 0x0633: count = 4 ret 0xFEB1 end
if cp == 0x0634: count = 4 ret 0xFEB5 end
if cp == 0x0635: count = 4 ret 0xFEB9 end
if cp == 0x0636: count = 4 ret 0xFEBD end
if cp == 0x0637: count = 4 ret 0xFEC1 end
if cp == 0x0638: count = 4 ret 0xFEC5 end
if cp == 0x0639: count = 4 ret 0xFEC9 end
if cp == 0x063A: count = 4 ret 0xFECD end
if cp == 0x0641: count = 4 ret 0xFED1 end
if cp == 0x0642: count = 4 ret 0xFED5 end
if cp == 0x0643: count = 4 ret 0xFED9 end
if cp == 0x0644: count = 4 ret 0xFEDD end
if cp == 0x0645: count = 4 ret 0xFEE1 end
if cp == 0x0646: count = 4 ret 0xFEE5 end
if cp == 0x0647: count = 4 ret 0xFEE9 end
if cp == 0x0648: count = 2 ret 0xFEED end
if cp == 0x064A: count = 4 ret 0xFEF1 end
if cp == 0x0671: count = 2 ret 0xFB50 end
if cp == 0x0677: count = 1 ret 0xFBDD end
if cp == 0x0679: count = 4 ret 0xFB66 end
if cp == 0x067A: count = 4 ret 0xFB5E end
if cp == 0x067B: count = 4 ret 0xFB52 end
if cp == 0x067E: count = 4 ret 0xFB56 end
if cp == 0x067F: count = 4 ret 0xFB62 end
if cp == 0x0680: count = 4 ret 0xFB5A end
if cp == 0x0683: count = 4 ret 0xFB76 end
if cp == 0x0684: count = 4 ret 0xFB72 end
if cp == 0x0686: count = 4 ret 0xFB7A end
if cp == 0x0687: count = 4 ret 0xFB7E end
if cp == 0x0688: count = 2 ret 0xFB88 end
if cp == 0x068C: count = 2 ret 0xFB84 end
if cp == 0x068D: count = 2 ret 0xFB82 end
if cp == 0x068E: count = 2 ret 0xFB86 end
if cp == 0x0691: count = 2 ret 0xFB8C end
if cp == 0x0698: count = 2 ret 0xFB8A end
if cp == 0x06A4: count = 4 ret 0xFB6A end
if cp == 0x06A6: count = 4 ret 0xFB6E end
if cp == 0x06A9: count = 4 ret 0xFB8E end
if cp == 0x06AD: count = 4 ret 0xFBD3 end
if cp == 0x06AF: count = 4 ret 0xFB92 end
if cp == 0x06B1: count = 4 ret 0xFB9A end
if cp == 0x06B3: count = 4 ret 0xFB96 end
if cp == 0x06BA: count = 2 ret 0xFB9E end
if cp == 0x06BB: count = 4 ret 0xFBA0 end
if cp == 0x06BE: count = 4 ret 0xFBAA end
if cp == 0x06C0: count = 2 ret 0xFBA4 end
if cp == 0x06C1: count = 4 ret 0xFBA6 end
if cp == 0x06C5: count = 2 ret 0xFBE0 end
if cp == 0x06C6: count = 2 ret 0xFBD9 end
if cp == 0x06C7: count = 2 ret 0xFBD7 end
if cp == 0x06C8: count = 2 ret 0xFBDB end
if cp == 0x06C9: count = 2 ret 0xFBE2 end
if cp == 0x06CB: count = 2 ret 0xFBDE end
if cp == 0x06CC: count = 4 ret 0xFBFC end
if cp == 0x06D0: count = 4 ret 0xFBE4 end
if cp == 0x06D2: count = 2 ret 0xFBAE end
if cp == 0x06D3: count = 2 ret 0xFBB0 end
ret 0
end
func _arabic_join_count(cp: int): int:
if cp == 0x0640:
ret 2
end
mut count := 0
_arabic_form_base(cp, count)
if count == 4: ret 2 end
if count == 2: ret 1 end
ret 0
end
func _arabic_transparent(cp: int): bool:
if cp >= 0x0610 and cp <= 0x061A: ret true end
if cp >= 0x064B and cp <= 0x065F: ret true end
if cp == 0x0670: ret true end
if cp >= 0x06D6 and cp <= 0x06DC: ret true end
if cp >= 0x06DF and cp <= 0x06E4: ret true end
if cp >= 0x06E7 and cp <= 0x06E8: ret true end
if cp >= 0x06EA and cp <= 0x06ED: ret true end
if cp >= 0x0300 and cp <= 0x036F: ret true end
if cp >= 0x0591 and cp <= 0x05BD: ret true end
if cp == 0x05BF or cp == 0x05C1 or cp == 0x05C2: ret true end
if cp == 0x05C4 or cp == 0x05C5 or cp == 0x05C7: ret true end
if cp == 0x200D: ret true end
ret false
end
func _arabic_shaped(cp: int, form: int): int:
if cp == 0x0649:
if form == _AR_INITIAL: ret 0xFBE8 end
if form == _AR_MEDIAL: ret 0xFBE9 end
if form == _AR_FINAL: ret 0xFEF0 end
ret 0xFEEF
end
mut count := 0
base := _arabic_form_base(cp, count)
if base == 0 or count == 0:
ret cp
end
mut want := form
if want >= count:
if want == _AR_MEDIAL: want = _AR_FINAL end
if want == _AR_INITIAL: want = _AR_ISOLATED end
end
if want >= count:
want = _AR_ISOLATED
end
ret base + want
end
func _arabic_lam_alef(lam: int, alef: int): int:
if lam != 0x0644:
ret 0
end
if alef == 0x0622: ret 0xFEF5 end
if alef == 0x0623: ret 0xFEF7 end
if alef == 0x0625: ret 0xFEF9 end
if alef == 0x0627: ret 0xFEFB end
ret 0
end
package typeset
func _shape_prev_index(cps &: Vector<int>, i: int): int:
mut k := i - 1
until k >= 0:
if not _arabic_transparent(cps.get(k)):
ret k
end
k--
end
ret -1
end
func _shape_next_index(cps &: Vector<int>, i: int): int:
mut k := i + 1
until k < cps.len():
if not _arabic_transparent(cps.get(k)):
ret k
end
k++
end
ret -1
end
func _shape_merge_ligatures(src &: Vector<int>, out &: Vector<int>):
n := src.len()
mut i := 0
until i < n:
cp := src.get(i)
mut merged := false
if cp == 0x0644:
j := _shape_next_index(src, i)
if j >= 0:
lig := _arabic_lam_alef(cp, src.get(j))
if lig != 0:
out.push(lig)
mut k := i + 1
until k < j:
out.push(src.get(k))
k++
end
i = j + 1
merged = true
end
end
end
if not merged:
out.push(cp)
i++
end
end
end
func _shape_form_at(cps &: Vector<int>, i: int): int:
cp := cps.get(i)
if _arabic_join_count(cp) == 0:
ret _AR_ISOLATED
end
p := _shape_prev_index(cps, i)
n := _shape_next_index(cps, i)
joined_prev := p >= 0 and _arabic_join_count(cps.get(p)) == 2
joined_next := n >= 0 and _arabic_join_count(cp) == 2 and _arabic_join_count(cps.get(n)) >= 1
if joined_prev and joined_next: ret _AR_MEDIAL end
if joined_next: ret _AR_INITIAL end
if joined_prev: ret _AR_FINAL end
ret _AR_ISOLATED
end
func _shape_arabic(src &: Vector<int>, out &: Vector<int>):
mut merged := Vector {} as Vector<int>
_shape_merge_ligatures(src, merged)
mut i := 0
until i < merged.len():
out.push(_arabic_shaped(merged.get(i), _shape_form_at(merged, i)))
i++
end
merged.free()
end
@en "ShapeArabic"
@fa "شکل‌دهی عربی"
pub func ShapeArabic(text: str): str:
mut src := Vector {} as Vector<int>
mut out := Vector {} as Vector<int>
_utf8_decode_all(text, src)
_shape_arabic(src, out)
s := _utf8_encode_all(out)
src.free()
out.free()
ret s
end
