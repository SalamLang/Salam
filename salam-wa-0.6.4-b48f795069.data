@en "EmitAck"
@fa "ارسال منتظر تایید"
pub func EmitAck(c: Client, name: str, a: Args, timeout_ms: int): Ack:
if c.p == null or _reserved(name):
ret Ack {}
end
sp := _sock(c)
m := sp[0].mgr as MgrState*
id := _next_ack_id(sp)
wait := _ack_wait(m, timeout_ms)
_register_waiter(sp, id, wait, false, (_x: Ack): end)
if not _emit_raw(c, PKT_EVENT, name, a, id, false):
ret Ack { id = id }
end
mut deadline := time.MonoMillis() + (wait as i64)
if wait <= 0:
deadline = 0
end
mut out := Ack { id = id }
mut going := true
until going:
if _take_result(sp, id, out):
going = false
else:
mut left := 0 - 1
if deadline > 0:
left = (deadline - time.MonoMillis()) as int
if left <= 0:
going = false
end
end
if going:
rc := _pump_mgr(m, left)
if rc == PUMP_CLOSED and m[0].state == ST_CLOSED:
going = false
end
end
end
end
if not out.ok:
_expire_acks(m)
_take_result(sp, id, out)
end
_drop_dead_waiters(sp)
ret out
end
@en "EmitWithAck"
@fa "ارسال با تایید"
pub func EmitWithAck(c: Client, name: str, a: Args, timeout_ms: int, cb: func (Ack)): bool:
if c.p == null or _reserved(name):
ret false
end
sp := _sock(c)
m := sp[0].mgr as MgrState*
id := _next_ack_id(sp)
_register_waiter(sp, id, _ack_wait(m, timeout_ms), true, cb)
ret _emit_raw(c, PKT_EVENT, name, a, id, false)
end
@en "Reply"
@fa "پاسخ"
pub func Reply(ev: Event, a: Args): bool:
if ev.ack_id < 0 or ev.client.p == null:
ret false
end
ret _emit_raw(ev.client, PKT_ACK, "", a, ev.ack_id, false)
end
