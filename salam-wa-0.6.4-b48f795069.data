mut n := _newbuf(k)
defer _buf_free(n)
repeat k in i:
_put8(n, _rdat(c.rsa_n, i))
end
mut ex := _newbuf(c.rsa_e.len)
defer _buf_free(ex)
repeat c.rsa_e.len in i:
_put8(ex, _rdat(c.rsa_e, i))
end
mut out := _newbuf(k)
defer _buf_free(out)
_putzeros(out, k)
if not _rsa_public_op(em.p, k, n.p, n.len, ex.p, ex.len, out.p, k): ret "" end
ok = true
ret encoding.Base64EncodeBytes(out.p, k)
end
package tls
import mem
@en "AEAD_AES_128_GCM"
@fa "ای ای دی ای ای اس۱۲۸ جی سی ام"
pub const AEAD_AES_128_GCM := 0
@en "AEAD_AES_256_GCM"
@fa "ای ای دی ای ای اس۲۵۶ جی سی ام"
pub const AEAD_AES_256_GCM := 1
@en "AEAD_CHACHA20_POLY1305"
@fa "ای ای دی چاچا۲۰ پلی۱۳۰۵"
pub const AEAD_CHACHA20_POLY1305 := 2
@en "AEAD_TAG_LEN"
@fa "طول برچسب ای ای دی"
pub const AEAD_TAG_LEN := 16
@en "AEAD_NONCE_LEN"
@fa "طول نانس ای ای دی"
pub const AEAD_NONCE_LEN := 12
struct AeadPtr:
pub kind: int = 0
pub key: void* = null
pub fg: FastGcm* = null
end
@en "AeadKeyLen"
@fa "طول کلید ای ای دی"
pub func AeadKeyLen(kind: int): int:
if kind == AEAD_AES_128_GCM:
ret 16
end
ret 32
end
@en "AeadNew"
@fa "ای ای دی جدید"
pub func AeadNew(kind: int, key: void*): void*:
if kind < 0 or kind > 2:
ret null
end
c := mem.AllocateZeroed(sizeof(AeadPtr) as u64) as AeadPtr*
if c == null:
ret null
end
c.kind = kind
klen := AeadKeyLen(kind)
c.key = mem.Allocate(32 as u64)
mem.Set(c.key, 0, 32 as u64)
mem.Copy(c.key, key, klen as u64)
if kind != AEAD_CHACHA20_POLY1305:
c.fg = _fg_new(key, klen)
end
ret c as void*
end
@en "AeadFree"
@fa "آزادسازی ای ای دی"
pub func AeadFree(ctx: void*):
if ctx == null:
ret
end
c := ctx as AeadPtr*
_fg_free(c.fg)
if c.key != null:
_wipe(c.key, 32)
mem.Free(c.key)
end
_wipe(ctx, sizeof(AeadPtr) as int)
mem.Free(ctx)
end
@en "AeadSeal"
@fa "مهر ای ای دی"
pub func AeadSeal(ctx: void*, nonce: void*, aad: void*, aadlen: int, pt: void*, n: int, out: void*):
c := ctx as AeadPtr*
tag := ((out as i64) + (n as i64)) as void*
if c.kind == AEAD_CHACHA20_POLY1305:
_cha20poly_seal(c.key, nonce, aad, aadlen, pt, out, n, tag)
else:
_fg_seal(c.fg, nonce, aad, aadlen, pt, out, n, tag)
end
end
@en "AeadOpen"
@fa "گشودن ای ای دی"
pub func AeadOpen(ctx: void*, nonce: void*, aad: void*, aadlen: int, ct: void*, n: int, out: void*): bool:
c := ctx as AeadPtr*
tag := ((ct as i64) + (n as i64)) as void*
if c.kind == AEAD_CHACHA20_POLY1305:
ret _cha20poly_open(c.key, nonce, aad, aadlen, ct, n, tag, out)
end
ret _fg_open(c.fg, nonce, aad, aadlen, ct, n, tag, out)
end
package tls
@en "AesGcmSealRaw"
@fa "مهر خام ای ای اس جی سی ام"
pub func AesGcmSealRaw(
key: void*, keylen: int, nonce: void*, aad: void*, aadlen: int, pt: void*, n: int, out: void*
): bool:
if keylen != 16 and keylen != 32: ret false end
c := _fg_new(key, keylen)
defer _fg_free(c)
_fg_seal(c, nonce, aad, aadlen, pt, out, n, ((out as i64) + (n as i64)) as void*)
ret true
end
@en "AesGcmOpenRaw"
@fa "گشودن خام ای ای اس جی سی ام"
pub func AesGcmOpenRaw(
key: void*, keylen: int, nonce: void*, aad: void*, aadlen: int, sealed: void*, sealed_len: int, out: void*
): bool:
if keylen != 16 and keylen != 32: ret false end
if sealed_len < 16: ret false end
n := sealed_len - 16
c := _fg_new(key, keylen)
defer _fg_free(c)
ret _fg_open(c, nonce, aad, aadlen, sealed, n, ((sealed as i64) + (n as i64)) as void*, out)
end
@en "ChaCha20Poly1305SealRaw"
@fa "مهر خام چاچا۲۰ پلی۱۳۰۵"
pub func ChaCha20Poly1305SealRaw(
key: void*, nonce: void*, aad: void*, aadlen: int, pt: void*, n: int, out: void*
): bool:
_cha20poly_seal(key, nonce, aad, aadlen, pt, out, n, ((out as i64) + (n as i64)) as void*)
ret true
end
@en "ChaCha20Poly1305OpenRaw"
@fa "گشودن خام چاچا۲۰ پلی۱۳۰۵"
pub func ChaCha20Poly1305OpenRaw(
key: void*, nonce: void*, aad: void*, aadlen: int, sealed: void*, sealed_len: int, out: void*
): bool:
if sealed_len < 16: ret false end
n := sealed_len - 16
ret _cha20poly_open(key, nonce, aad, aadlen, sealed, n, ((sealed as i64) + (n as i64)) as void*, out)
end
package tls
import mem
inline func _xc_qr(x: u32*, a: int, b: int, c: int, d: int):
x[a] += x[b]
x[d] = _rotl32(x[d] ^ x[a], 16 as u32)
x[c] += x[d]
x[b] = _rotl32(x[b] ^ x[c], 12 as u32)
x[a] += x[b]
x[d] = _rotl32(x[d] ^ x[a], 8 as u32)
x[c] += x[d]
x[b] = _rotl32(x[b] ^ x[c], 7 as u32)
end
func _hchacha20(key: void*, nonce16: void*, out: void*):
x := mem.AllocateZeroed(64 as u64) as u32*
x[0] = 0x61707865 as u32
x[1] = 0x3320646e as u32
x[2] = 0x79622d32 as u32
x[3] = 0x6b206574 as u32
repeat 8 in i:
x[4 + i] = _le32(key, i * 4)
end
repeat 4 in i:
x[12 + i] = _le32(nonce16, i * 4)
end
repeat 10:
_xc_qr(x, 0, 4, 8, 12)
_xc_qr(x, 1, 5, 9, 13)
_xc_qr(x, 2, 6, 10, 14)
_xc_qr(x, 3, 7, 11, 15)
_xc_qr(x, 0, 5, 10, 15)
_xc_qr(x, 1, 6, 11, 12)
_xc_qr(x, 2, 7, 8, 13)
_xc_qr(x, 3, 4, 9, 14)
end
repeat 4 in i:
_ple32(x[i], out, i * 4)
_ple32(x[12 + i], out, 16 + i * 4)
end
_wipe(x as void*, 64)
mem.Free(x as void*)
end
func _xc_subkey(key: void*, nonce24: void*, sub: void*, cn: void*):
_hchacha20(key, nonce24, sub)
mem.Set(cn, 0, 12 as u64)
mem.Copy(((cn as i64) + (4 as i64)) as void*, ((nonce24 as i64) + (16 as i64)) as void*, 8 as u64)
end
inline func _ecb_xt(a: int): int:
ret ((a << 1) ^ (((a >> 7) & 1) * 0x11b)) & 0xFF
end
func _ecb_mul(a0: int, b0: int): int:
mut a := a0
mut b := b0
mut r := 0
until b > 0:
if (b & 1) == 1:
r ^= a
end
a = _ecb_xt(a)
b >>= 1
end
ret r
end
func _ecb_addkey(s: u8*, rk: u32*, r: int):
repeat 4 in c:
w := rk[r * 4 + c]
s[c * 4] ^= ((w >> (24 as u32)) as u8)
s[c * 4 + 1] ^= ((w >> (16 as u32)) as u8)
s[c * 4 + 2] ^= ((w >> (8 as u32)) as u8)
s[c * 4 + 3] ^= (w as u8)
end
end
@en "XChaCha20Poly1305SealRaw"
@fa "مهر خام ایکس چاچا۲۰ پلی۱۳۰۵"
pub func XChaCha20Poly1305SealRaw(
key: void*, nonce24: void*, aad: void*, aadlen: int, pt: void*, n: int, out: void*
): bool:
sub := mem.AllocateZeroed(32 as u64)
cn := mem.AllocateZeroed(12 as u64)
_xc_subkey(key, nonce24, sub, cn)
_cha20poly_seal(sub, cn, aad, aadlen, pt, out, n, ((out as i64) + (n as i64)) as void*)
_wipe(sub, 32)
mem.Free(sub)
mem.Free(cn)
ret true
end
@en "XChaCha20Poly1305OpenRaw"
@fa "گشودن خام ایکس چاچا۲۰ پلی۱۳۰۵"
pub func XChaCha20Poly1305OpenRaw(
key: void*, nonce24: void*, aad: void*, aadlen: int, sealed: void*, sealed_len: int, out: void*
): bool:
if sealed_len < 16:
ret false
end
sub := mem.AllocateZeroed(32 as u64)
cn := mem.AllocateZeroed(12 as u64)
_xc_subkey(key, nonce24, sub, cn)
n := sealed_len - 16
ok := _cha20poly_open(sub, cn, aad, aadlen, sealed, n, ((sealed as i64) + (n as i64)) as void*, out)
_wipe(sub, 32)
mem.Free(sub)
mem.Free(cn)
ret ok
end
@en "AesEcbBlock"
@fa "بلوک ای ای اس ای سی بی"
pub func AesEcbBlock(key: void*, keylen: int, inp: void*, out: void*, decrypt: bool): bool:
c := _fg_new(key, keylen)
if c == null:
ret false
end
if not decrypt:
_fg_block(c, _fg_be32(inp, 0), _fg_be32(inp, 4), _fg_be32(inp, 8), _fg_be32(inp, 12), out, 0)
_fg_free(c)
ret true
end
inv := mem.AllocateZeroed(256 as u64) as u8*
repeat 256 in i:
inv[FG_SBOX[i] as int] = i as u8
end
s := mem.AllocateZeroed(32 as u64) as u8*
t := ((s as i64) + (16 as i64)) as u8*
mem.Copy(s as void*, inp, 16 as u64)
rk := c.rk
_ecb_addkey(s, rk, c.nr)
mut r := c.nr - 1
until r >= 0:
repeat 4 in col:
repeat 4 in row:
t[((col + row) % 4) * 4 + row] = inv[s[col * 4 + row] as int]
end
end
mem.Copy(s as void*, t as void*, 16 as u64)
_ecb_addkey(s, rk, r)
if r > 0:
repeat 4 in col:
a0 := s[col * 4] as int
a1 := s[col * 4 + 1] as int
a2 := s[col * 4 + 2] as int
a3 := s[col * 4 + 3] as int
t[col * 4] = (_ecb_mul(a0, 14) ^ _ecb_mul(a1, 11) ^ _ecb_mul(a2, 13) ^ _ecb_mul(a3, 9)) as u8
t[col * 4 + 1] = (_ecb_mul(a0, 9) ^ _ecb_mul(a1, 14) ^ _ecb_mul(a2, 11) ^ _ecb_mul(a3, 13)) as u8
t[col * 4 + 2] = (_ecb_mul(a0, 13) ^ _ecb_mul(a1, 9) ^ _ecb_mul(a2, 14) ^ _ecb_mul(a3, 11)) as u8
t[col * 4 + 3] = (_ecb_mul(a0, 11) ^ _ecb_mul(a1, 13) ^ _ecb_mul(a2, 9) ^ _ecb_mul(a3, 14)) as u8
end
mem.Copy(s as void*, t as void*, 16 as u64)
end
r--
end
mem.Copy(out, s as void*, 16 as u64)
_wipe(s as void*, 32)
mem.Free(s as void*)
mem.Free(inv as void*)
_fg_free(c)
ret true
end
