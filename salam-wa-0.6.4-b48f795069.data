func _zs_huf_stream(d &: _Zd, p: u8*, n: int, dst: u8*, cnt: int): bool:
mut r := _ZBr { p = null as u8*, pos = 0 }
if not _zb_init(r, p, n):
ret false
end
mb := d.hbits
repeat cnt in i:
e := d.huf[_zb_peek(r, mb)] as int
