end
else:
_damage_rect(x0, y0, x1, y1)
end
end
repeat _e.recs.len() in i:
if not seen[i]:
o := _e.recs[i]
_damage_rect(o.x0, o.y0, o.x1, o.y1)
end
end
_e.recs.free()
_e.recs = nrecs
_damage_effects()
