c = s >> (32 as u64)
s = t6 + a6 * b6 + c
t6 = s & PF_M
c = s >> (32 as u64)
s = t7 + a6 * b7 + c
t7 = s & PF_M
c = s >> (32 as u64)
t8 += c
c = (t0 * (0xee00bc4f as u64)) & PF_M
s = t0 + c * (0xfc632551 as u64)
