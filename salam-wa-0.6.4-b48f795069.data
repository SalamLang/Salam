if w > 0:
sum += 1 << (w - 1)
end
end
if sum == 0:
ret 0 - 1
end
maxbits := _zs_hb(sum) + 1
if maxbits > 11:
ret 0 - 1
end
rest := (1 << maxbits) - sum
if rest <= 0 or (rest & (rest - 1)) != 0:
