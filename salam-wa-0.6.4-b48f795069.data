pub const AuthNone := 0
@en "AuthUserPass"
@fa "احراز هویت نام کاربری"
pub const AuthUserPass := 2
@en "AuthNoAcceptable"
@fa "روش پذیرفتنی نیست"
pub const AuthNoAcceptable := 255
@en "CmdConnect"
@fa "فرمان اتصال"
pub const CmdConnect := 1
@en "CmdBind"
@fa "فرمان پیوند"
pub const CmdBind := 2
@en "CmdUDPAssociate"
@fa "فرمان یو دی پی"
pub const CmdUDPAssociate := 3
@en "AtypIPv4"
@fa "نوع آی‌پی۴"
pub const AtypIPv4 := 1
@en "AtypDomain"
@fa "نوع دامنه"
pub const AtypDomain := 3
@en "AtypIPv6"
@fa "نوع آی‌پی۶"
pub const AtypIPv6 := 4
@en "RepSucceeded"
@fa "کد موفق"
pub const RepSucceeded := 0
@en "RepGeneralFailure"
@fa "کد خطای کلی"
pub const RepGeneralFailure := 1
@en "RepNotAllowed"
@fa "کد غیرمجاز"
pub const RepNotAllowed := 2
