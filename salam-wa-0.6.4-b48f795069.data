ll = mem.Allocate(2048 as u64) as u32*, llog = 0 - 1
off = mem.Allocate(2048 as u64) as u32*, olog = 0 - 1
ml = mem.Allocate(2048 as u64) as u32*, mlog = 0 - 1
ftmp = mem.Allocate(512 as u64) as u32*
norm = mem.Allocate(1100 as u64) as int*
nxt = mem.Allocate(1100 as u64) as int*
spr = mem.Allocate(1024 as u64) as u8*
lit = mem.Allocate((_ZS_MAXBLOCK + 64) as u64) as u8*
litp = null as u8*, nlit = 0
wt = mem.Allocate(512 as u64) as u8*
r1 = 1, r2 = 4, r3 = 8
dc = null as u8*, dl = 0, dlist = dict as u8*, dn = dn, did = 0
fstart = 0, cap = 0, st = 0
}
end
func _zd_free(d &: _Zd):
mem.Free(d.huf as void*)
mem.Free(d.ll as void*)
mem.Free(d.off as void*)
mem.Free(d.ml as void*)
mem.Free(d.ftmp as void*)
mem.Free(d.norm as void*)
mem.Free(d.nxt as void*)
mem.Free(d.spr as void*)
mem.Free(d.lit as void*)
mem.Free(d.wt as void*)
end
inline func _zs_at(p: u8*, i: int): u8*:
ret ((p as i64) + (i as i64)) as u8*
