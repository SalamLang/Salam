f.has_para = false
f.has_lay = false
end
func _pc_sweep():
repeat _pc_keys.len() in i:
if not _pc_taken[i]:
mut p := _pc_para[i]
typeset.FreeParagraph(p)
if _pc_has_lay[i]:
mut l := _pc_lay[i]
typeset.FreeLayout(l)
end
mut al := _pc_alt[i]
repeat al.len() in j:
mut l2 := al[j]
typeset.FreeLayout(l2)
end
al.free()
mut aw := _pc_altw[i]
aw.free()
end
_sfree(_pc_keys[i])
end
_pc_map.free()
_pc_map = HashMap {} as HashMap<str, int>
_pc_keys.clear()
_pc_para.clear()
_pc_lay.clear()
_pc_layw.clear()
_pc_has_lay.clear()
_pc_taken.clear()
_pc_alt.clear()
_pc_altw.clear()
end
func _ifc_para(fi: int):
f0 := _e.ifcs[fi]
if f0.has_para:
ret
end
mut f := _e.ifcs.ref(fi)
_patch_atoms(f)
if f.control:
mut sp := f.spans[0]
if sp.text.len() == 0:
sp.text = str.Clone(" ")
f.spans[0] = sp
end
end
key := f.ckey.len() > 0 ? f.ckey : _para_key(_e.ifcs[fi])
if key.len() > 0 and _pc_map.has(key):
k := _pc_map.get(key)
if not _pc_taken[k]:
_pc_taken[k] = true
f.para = _pc_para[k]
f.has_para = true
if _pc_has_lay[k]:
f.lay = _pc_lay[k]
f.lay_w = _pc_layw[k]
