@fa "اتصال"
pub join: LineJoin = LineJoin.Miter
@en "miter_limit"
@fa "حد تیزی"
pub miter_limit: f64 = 4.0
@en "dash"
@fa "خط چین"
pub dash: f64 = 0.0
@en "gap"
@fa "فاصله خط چین"
