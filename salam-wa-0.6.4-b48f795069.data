package yaml
@en "DumpWith"
@fa "برونریزی سفارشی"
pub func DumpWith(text: str, unit: str): str:
c := Parse(text)
mut sb := str.NewBuilder()
defer str.BufFree(sb)
_dump_block(c, c.len(), 0, sb, unit, 0)
out := str.BufStr(sb)
ret out
end
@en "Dump"
@fa "برونریزی"
pub func Dump(text: str): str:
ret DumpWith(text, "  ")
end
@en "DumpTabs"
@fa "برونریزی تب"
pub func DumpTabs(text: str): str:
ret DumpWith(text, "\t")
end
package yaml
@en "Escape"
@fa "اسکیپ"
pub func Escape(s: str): str:
l := s.len()
bp := _bp(s)
mut sb := str.NewBuilder()
defer str.BufFree(sb)
repeat l in i:
code := _ub(bp, i)
if code == 34:
str.BufAppend(sb, `\"`)
else code == 92:
str.BufAppend(sb, "\\\\")
else code == 10:
str.BufAppend(sb, "\\n")
else code == 9:
str.BufAppend(sb, "\\t")
else code == 13:
str.BufAppend(sb, "\\r")
else:
str.BufAppendChar(sb, code)
end
end
out := str.BufStr(sb)
ret out
end
@en "Str"
@fa "رشته یامل"
pub func Str(value: str): str:
ret _json_str_literal(value)
end
@en "Member"
@fa "عضو"
pub func Member(key: str, value: str): str:
ret _json_str_literal(key).concat(": ").concat(_json_str_literal(value))
end
@en "MemberInt"
@fa "عضو عدد"
pub func MemberInt(key: str, value: i64): str:
ret _json_str_literal(key).concat(": ").concat(conv.FormatInt(value))
end
@en "MemberBool"
