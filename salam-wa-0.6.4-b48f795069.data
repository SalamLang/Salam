package ui
import str
import mem
struct _Node:
pub tag: str = ""
pub text: str = ""
pub names: Vector<str> = Vector {}
pub values: Vector<str> = Vector {}
pub parent: int = -1
pub kids: Vector<int> = Vector {}
pub uid: int = 0
pub d_base: int = -1
pub d_hover: int = -1
pub d_focus: int = -1
pub d_active: int = -1
pub dyn: Vector<int> = Vector {}
end
struct _Dom:
pub nodes: Vector<_Node> = Vector {}
pub html: int = -1
pub head: int = -1
pub body: int = -1
pub title: str = ""
pub lang: str = ""
pub dir: str = ""
pub css: str = ""
pub icon: str = ""
pub ev_node: Vector<int> = Vector {}
pub ev_kind: Vector<str> = Vector {}
pub ev_fn: Vector<func ()> = Vector {}
end
inline func _hb(p: u8*, i: int): int:
ret p[i] as int
end
func _sfree(s: str):
if s.len() > 0:
mem.Free(s as void*)
end
end
func _is_ws(c: int): bool:
ret c == 32 or c == 9 or c == 10 or c == 13 or c == 12
end
func _lower(s: str): str:
mut b := str.NewBuilder()
p := (s as void*) as u8*
repeat s.len() in i:
c := _hb(p, i)
if c >= 65 and c <= 90:
str.BufAppendChar(b, c + 32)
else:
str.BufAppendChar(b, c)
end
end
r := str.BufStr(b)
str.BufFree(b)
ret r
end
func _slice(s: str, a: int, b: int): str:
if b <= a:
ret str.Clone("")
end
ret str.SubstrIn(s, a, b - a)
end
func _is_void(tag: str): bool:
switch tag:
"area", "base", "br", "col", "embed", "hr", "img", "input", "link", "meta", "source", "track", "wbr", "param", "keygen":
ret true
end
else:
ret false
end
end
ret false
end
func _is_raw(tag: str): bool:
ret tag == "style" or tag == "script" or tag == "title" or tag == "textarea" or tag == "xmp"
end
func _named_entity(name: str): int:
switch name:
"amp": ret 38 end
"lt": ret 60 end
"gt": ret 62 end
"quot": ret 34 end
"apos": ret 39 end
"nbsp": ret 160 end
"copy": ret 169 end
"reg": ret 174 end
"trade": ret 8482 end
"hellip": ret 8230 end
"mdash": ret 8212 end
"ndash": ret 8211 end
"laquo": ret 171 end
"raquo": ret 187 end
"lsquo": ret 8216 end
"rsquo": ret 8217 end
"ldquo": ret 8220 end
"rdquo": ret 8221 end
"middot": ret 183 end
"bull": ret 8226 end
"times": ret 215 end
"divide": ret 247 end
"deg": ret 176 end
"euro": ret 8364 end
"zwnj": ret 8204 end
"zwj": ret 8205 end
"lrm": ret 8206 end
"rlm": ret 8207 end
"shy": ret 173 end
"larr": ret 8592 end
"rarr": ret 8594 end
"uarr": ret 8593 end
"darr": ret 8595 end
else: ret -1 end
end
ret -1
end
func _decode_entities(s: str): str:
if not s.includes("&"):
ret str.Clone(s)
end
p := (s as void*) as u8*
n := s.len()
mut b := str.NewBuilder()
mut i := 0
until i < n:
c := _hb(p, i)
if c != 38:
str.BufAppendChar(b, c)
i++
continue
end
mut j := i + 1
until j < n and j - i < 34 and _hb(p, j) != 59 and _hb(p, j) != 38 and not _is_ws(_hb(p, j)):
j++
end
mut cp := -1
if j < n and _hb(p, j) == 59 and j > i + 1:
body := _slice(s, i + 1, j)
if _hb(p, i + 1) == 35:
mut v := 0
mut ok := true
if j > i + 2 and (_hb(p, i + 2) == 120 or _hb(p, i + 2) == 88):
mut k := i + 3
until k < j:
d := _hb(p, k)
if d >= 48 and d <= 57:
v = v * 16 + d - 48
else d >= 97 and d <= 102:
v = v * 16 + d - 87
else d >= 65 and d <= 70:
v = v * 16 + d - 55
else:
ok = false
end
if v > 0x10FFFF:
ok = false
end
k++
end
ok = ok and j > i + 3
else:
mut k := i + 2
until k < j:
d := _hb(p, k)
if d >= 48 and d <= 57:
v = v * 10 + d - 48
else:
ok = false
end
if v > 0x10FFFF:
ok = false
end
k++
end
ok = ok and j > i + 2
end
if ok:
cp = v == 0 ? 0xFFFD : v
end
else:
cp = _named_entity(body)
end
_sfree(body)
end
if cp >= 0:
str.BufAppendCp(b, cp)
i = j + 1
else:
str.BufAppendChar(b, c)
i++
end
end
r := str.BufStr(b)
str.BufFree(b)
ret r
end
func _new_node(d &: _Dom, tag: str, parent: int): int:
mut nd := _Node { tag = tag, parent = parent }
nd.names = Vector {} as Vector<str>
nd.values = Vector {} as Vector<str>
nd.kids = Vector {} as Vector<int>
d.nodes.push(nd)
id := d.nodes.len() - 1
if parent >= 0:
mut pn := d.nodes.ref(parent)
pn.kids.push(id)
end
ret id
end
func _add_text(d &: _Dom, parent: int, text: str):
if text.len() == 0:
ret
end
pn := d.nodes[parent]
if pn.kids.len() > 0:
last := pn.kids[pn.kids.len() - 1]
if d.nodes[last].tag == "#text":
mut ln := d.nodes.ref(last)
old := ln.text
ln.text = old + text
_sfree(old)
ret
end
end
id := _new_node(d, "#text", parent)
mut tn := d.nodes.ref(id)
tn.text = str.Clone(text)
end
func _attr(d: _Dom, node: int, name: str): str:
if node < 0 or node >= d.nodes.len():
ret ""
end
nd := d.nodes[node]
repeat nd.names.len() in i:
if nd.names[i] == name:
ret nd.values[i]
end
end
ret ""
end
func _has_attr(d: _Dom, node: int, name: str): bool:
if node < 0 or node >= d.nodes.len():
ret false
end
nd := d.nodes[node]
repeat nd.names.len() in i:
if nd.names[i] == name:
ret true
end
end
ret false
end
func _set_attr(d &: _Dom, node: int, name: str, value: str):
mut nd := d.nodes.ref(node)
repeat nd.names.len() in i:
if nd.names[i] == name:
old := nd.values[i]
nd.values[i] = str.Clone(value)
_sfree(old)
ret
end
end
nd.names.push(str.Clone(name))
nd.values.push(str.Clone(value))
end
func _remove_attr(d &: _Dom, node: int, name: str):
mut nd := d.nodes.ref(node)
repeat nd.names.len() in i:
if nd.names[i] == name:
_sfree(nd.names[i])
_sfree(nd.values[i])
nd.names.remove_at(i)
nd.values.remove_at(i)
ret
end
end
end
func _implied_end(open: str, next: str): bool:
switch open:
"p":
switch next:
"address", "article", "aside", "blockquote", "details", "dialog", "div", "dl", "fieldset", "figcaption", "figure", "footer", "form", "h1", "h2", "h3", "h4", "h5", "h6", "header", "hgroup", "hr", "main", "menu", "nav", "ol", "p", "pre", "section", "table", "ul":
ret true
end
else: ret false end
end
end
"li": ret next == "li" end
"option": ret next == "option" or next == "optgroup" end
"dt", "dd": ret next == "dt" or next == "dd" end
"tr": ret next == "tr" end
"td", "th": ret next == "td" or next == "th" or next == "tr" end
else: ret false end
end
ret false
end
func _parse_attrs(d &: _Dom, node: int, s: str, p: u8*, n: int, start: int, self_close &: bool): int:
mut i := start
until i < n:
until i < n and _is_ws(_hb(p, i)):
i++
end
if i >= n:
ret n
end
c := _hb(p, i)
if c == 62:
ret i + 1
end
if c == 47:
if i + 1 < n and _hb(p, i + 1) == 62:
self_close = true
ret i + 2
end
i++
continue
end
ns := i
until i < n and not _is_ws(_hb(p, i)) and _hb(p, i) != 61 and _hb(p, i) != 62 and not (_hb(p, i) == 47 and i + 1 < n and _hb(p, i + 1) == 62):
i++
end
raw_name := _slice(s, ns, i)
name := _lower(raw_name)
_sfree(raw_name)
until i < n and _is_ws(_hb(p, i)):
i++
end
mut value := str.Clone("")
if i < n and _hb(p, i) == 61:
i++
until i < n and _is_ws(_hb(p, i)):
i++
end
if i < n and (_hb(p, i) == 34 or _hb(p, i) == 39):
q := _hb(p, i)
vs := i + 1
i++
until i < n and _hb(p, i) != q:
i++
end
raw := _slice(s, vs, i)
_sfree(value)
value = _decode_entities(raw)
_sfree(raw)
if i < n:
i++
end
else:
vs := i
until i < n and not _is_ws(_hb(p, i)) and _hb(p, i) != 62:
i++
end
raw := _slice(s, vs, i)
_sfree(value)
value = _decode_entities(raw)
_sfree(raw)
end
end
if name.len() > 0 and not _has_attr(d, node, name):
mut nd := d.nodes.ref(node)
nd.names.push(name)
nd.values.push(value)
else:
_sfree(name)
_sfree(value)
end
end
ret n
end
func _find_ci(p: u8*, n: int, from: int, needle: str): int:
q := (needle as void*) as u8*
m := needle.len()
mut i := from
until i + m <= n:
mut ok := true
repeat m in k:
mut c := _hb(p, i + k)
if c >= 65 and c <= 90:
c += 32
end
if c != _hb(q, k):
ok = false
break
end
end
if ok:
ret i
end
i++
end
ret -1
end
func _close_to(d &: _Dom, stack &: Vector<int>, tag: str): bool:
mut k := stack.len() - 1
until k >= 1:
if d.nodes[stack[k]].tag == tag:
until stack.len() > k:
stack.pop()
end
ret true
end
k--
end
ret false
end
func _parse_html(src: str): _Dom:
mut d := _Dom {}
d.nodes = Vector {} as Vector<_Node>
root := _new_node(d, "#document", -1)
mut stack := Vector {} as Vector<int>
defer stack.free()
stack.push(root)
p := (src as void*) as u8*
n := src.len()
mut i := 0
mut text_start := 0
until i < n:
if _hb(p, i) != 60:
i++
continue
end
if i + 1 >= n:
break
end
c1 := _hb(p, i + 1)
is_tag := (c1 >= 97 and c1 <= 122) or (c1 >= 65 and c1 <= 90) or c1 == 47 or c1 == 33
if not is_tag:
i++
continue
end
if i > text_start:
raw := _slice(src, text_start, i)
dec := _decode_entities(raw)
_add_text(d, stack[stack.len() - 1], dec)
_sfree(dec)
_sfree(raw)
end
if c1 == 33:
if i + 3 < n and _hb(p, i + 2) == 45 and _hb(p, i + 3) == 45:
e := str.IndexFrom(src, "-->", i + 4)
i = e < 0 ? n : e + 3
else:
mut j := i + 2
until j < n and _hb(p, j) != 62:
j++
end
i = j + 1
end
text_start = i
continue
end
if c1 == 47:
mut j := i + 2
until j < n and not _is_ws(_hb(p, j)) and _hb(p, j) != 62:
j++
end
raw := _slice(src, i + 2, j)
tag := _lower(raw)
_sfree(raw)
until j < n and _hb(p, j) != 62:
j++
end
i = j + 1
text_start = i
if tag == "br":
_new_node(d, "br", stack[stack.len() - 1])
else:
_close_to(d, stack, tag)
end
_sfree(tag)
continue
end
mut j := i + 1
until j < n and not _is_ws(_hb(p, j)) and _hb(p, j) != 62 and _hb(p, j) != 47:
j++
end
raw := _slice(src, i + 1, j)
tag := _lower(raw)
_sfree(raw)
mut top := stack[stack.len() - 1]
until stack.len() > 1 and _implied_end(d.nodes[top].tag, tag):
stack.pop()
top = stack[stack.len() - 1]
end
if tag == "tr" and d.nodes[top].tag == "table":
tb := _new_node(d, "tbody", top)
stack.push(tb)
top = tb
end
node := _new_node(d, tag, top)
mut self_close := false
i = _parse_attrs(d, node, src, p, n, j, self_close)
text_start = i
if _is_raw(tag):
close := "</" + tag
e := _find_ci(p, n, i, close)
_sfree(close)
end_at := e < 0 ? n : e
mut cs := i
if tag == "textarea" and cs < end_at and _hb(p, cs) == 10:
cs++
end
body := _slice(src, cs, end_at)
if tag == "style" or tag == "script":
_add_text(d, node, body)
else:
dec := _decode_entities(body)
_add_text(d, node, dec)
_sfree(dec)
end
_sfree(body)
if e < 0:
i = n
else:
mut k := e
until k < n and _hb(p, k) != 62:
k++
end
i = k + 1
end
text_start = i
continue
end
if not _is_void(tag) and not self_close:
stack.push(node)
if tag == "pre" or tag == "listing":
if i < n and _hb(p, i) == 10:
i++
text_start = i
end
end
end
end
if n > text_start:
raw := _slice(src, text_start, n)
dec := _decode_entities(raw)
_add_text(d, stack[stack.len() - 1], dec)
_sfree(dec)
_sfree(raw)
end
_dom_finish(d)
ret d
end
func _find_tag(d: _Dom, from: int, tag: str): int:
if d.nodes[from].tag == tag:
ret from
end
each k in d.nodes[from].kids:
r := _find_tag(d, k, tag)
if r >= 0:
ret r
end
end
ret -1
end
func _text_of(d: _Dom, node: int): str:
mut b := str.NewBuilder()
_collect_text(d, node, b)
r := str.BufStr(b)
str.BufFree(b)
ret r
end
func _collect_text(d: _Dom, node: int, b &: str.StringBuilder):
nd := d.nodes[node]
if nd.tag == "#text":
str.BufAppend(b, nd.text)
ret
end
each k in nd.kids:
_collect_text(d, k, b)
end
end
func _reparent(d &: _Dom, node: int, parent: int):
old := d.nodes[node].parent
if old >= 0:
mut onode := d.nodes.ref(old)
repeat onode.kids.len() in i:
if onode.kids[i] == node:
onode.kids.remove_at(i)
break
end
end
end
mut nd := d.nodes.ref(node)
nd.parent = parent
mut pn := d.nodes.ref(parent)
pn.kids.push(node)
end
func _dom_finish(d &: _Dom):
mut html := _find_tag(d, 0, "html")
if html < 0:
html = _new_node(d, "html", -1)
doc := d.nodes.ref(0)
mut moved := Vector {} as Vector<int>
each k in doc.kids:
moved.push(k)
end
each k in moved:
_reparent(d, k, html)
end
moved.free()
mut hn := d.nodes.ref(html)
hn.parent = 0
mut doc2 := d.nodes.ref(0)
doc2.kids.push(html)
end
d.html = html
mut body := _find_tag(d, html, "body")
head := _find_tag(d, html, "head")
if body < 0:
body = _new_node(d, "body", html)
mut moved := Vector {} as Vector<int>
each k in d.nodes[html].kids:
if k != body and k != head:
moved.push(k)
end
end
each k in moved:
_reparent(d, k, body)
end
moved.free()
end
d.body = body
d.head = head
d.lang = _attr(d, html, "lang")
d.dir = _attr(d, html, "dir")
t := _find_tag(d, html, "title")
if t >= 0:
d.title = _text_of(d, t)
end
mut css := str.NewBuilder()
_collect_styles(d, html, css)
d.css = str.BufStr(css)
str.BufFree(css)
_find_icon(d, html)
end
func _collect_styles(d &: _Dom, node: int, b &: str.StringBuilder):
nd := d.nodes[node]
if nd.tag == "style":
media := _attr(d, node, "media")
if media.len() > 0:
str.BufAppend(b, "@media " + media + " {\n")
end
each k in nd.kids:
str.BufAppend(b, d.nodes[k].text)
end
if media.len() > 0:
str.BufAppend(b, "\n}")
end
str.BufAppend(b, "\n")
ret
end
each k in nd.kids:
_collect_styles(d, k, b)
end
end
func _find_icon(d &: _Dom, node: int):
nd := d.nodes[node]
if nd.tag == "link":
rel := _lower(_attr(d, node, "rel"))
if rel.includes("icon") and d.icon.len() == 0:
d.icon = _attr(d, node, "href")
end
_sfree(rel)
end
each k in nd.kids:
_find_icon(d, k)
end
end
func _dom_free(d &: _Dom):
repeat d.nodes.len() in i:
mut nd := d.nodes.ref(i)
_sfree(nd.text)
each s in nd.names:
_sfree(s)
end
each s in nd.values:
_sfree(s)
end
nd.names.free()
nd.values.free()
nd.kids.free()
nd.dyn.free()
end
d.nodes.free()
each s in d.ev_kind:
_sfree(s)
end
d.ev_node.free()
d.ev_kind.free()
d.ev_fn.free()
_sfree(d.title)
_sfree(d.css)
d.title = ""
d.css = ""
end
package ui
import str
import math
import gui.css
import gui.cssbox
import gui.paint
import gui.typeset
const _OUT_NONE := 0
const _OUT_BLOCK := 1
const _OUT_INLINE := 2
const _OUT_ATOM := 3
const _VIRT_MIN := 200
func _ensure_fonts():
if _fonts_ready:
ret
end
_fonts_ready = true
if _fonts_added == 0:
_n := typeset.AddSystemFonts(_fc)
end
end
func _ensure_gcache():
if not _gcache_ready:
_gcache = typeset.NewGlyphCache(4 * 1024 * 1024)
_gcache_ready = true
end
end
func _is_replaced(tag: str): bool:
switch tag:
"img", "input", "select", "textarea", "progress", "meter", "canvas", "video", "iframe", "embed", "object", "audio":
ret true
end
else:
ret false
end
end
ret false
end
func _input_type(node: int): str:
t := _attr(_e.dom, node, "type")
if t.len() == 0:
ret "text"
end
ret t
end
func _is_text_input(node: int): bool:
tag := _e.dom.nodes[node].tag
if tag == "textarea":
ret true
end
if tag != "input":
ret false
end
t := _input_type(node)
switch t:
"text", "password", "email", "search", "url", "tel", "number":
ret true
end
else:
ret false
end
end
ret false
end
func _is_button_input(node: int): bool:
if _e.dom.nodes[node].tag != "input":
ret false
end
t := _input_type(node)
ret t == "button" or t == "submit" or t == "reset"
end
func _has_block_desc(node: int): bool:
each k in _e.dom.nodes[node].kids:
i := _e.node_el[k]
if i >= 0:
cs := _e.st[i]
d := cs.display
if d != css.Display.None and d != css.Display.Inline and d != css.Display.InlineBlock and d != css.Display.InlineFlex and d != css.Display.InlineGrid and d != css.Display.InlineTable and d != css.Display.Contents:
if not _is_replaced(_e.dom.nodes[k].tag):
ret true
end
end
if d == css.Display.Inline and _has_block_desc(k):
ret true
end
end
end
ret false
end
func _details_hidden(node: int): bool:
p := _e.dom.nodes[node].parent
if p < 0 or _e.dom.nodes[p].tag != "details":
ret false
end
if _details_open(p):
ret false
end
each k in _e.dom.nodes[p].kids:
if _e.dom.nodes[k].tag == "summary":
ret k != node
end
end
ret true
end
func _details_open(node: int): bool:
i := _e.node_el[node]
if i >= 0:
ret _e.els[i].HasAttr("open")
end
ret false
end
func _outer(node: int): int:
nd := _e.dom.nodes[node]
if _details_hidden(node):
ret _OUT_NONE
end
if nd.tag == "#text":
ret _OUT_INLINE
end
i := _e.node_el[node]
if i < 0:
ret _OUT_NONE
end
cs := _e.st[i]
switch cs.display:
css.Display.None:
ret _OUT_NONE
end
css.Display.Inline:
if nd.tag == "br":
ret _OUT_INLINE
end
if _is_replaced(nd.tag) or nd.tag == "button":
ret _OUT_ATOM
end
if cs.position == cssbox.Position.Absolute or cs.position == cssbox.Position.Fixed:
ret _OUT_BLOCK
end
if _has_block_desc(node):
ret _OUT_BLOCK
end
ret _OUT_INLINE
end
css.Display.InlineBlock, css.Display.InlineFlex, css.Display.InlineGrid, css.Display.InlineTable:
if cs.position == cssbox.Position.Absolute or cs.position == cssbox.Position.Fixed:
ret _OUT_BLOCK
end
ret _OUT_ATOM
end
else:
ret _OUT_BLOCK
end
end
ret _OUT_BLOCK
end
func _is_ws_text(s: str): bool:
p := (s as void*) as u8*
repeat s.len() in i:
if not _is_ws(_hb(p, i)):
ret false
end
end
ret true
end
func _box_style(node: int, cs: css.ComputedStyle, blockify: bool): cssbox.Style:
mut st := css.ToBox(cs)
if css.NeedsBasis(cs):
st = css.ToBoxIn(cs, _e.width, _e.height)
end
if blockify:
if st.display == cssbox.Display.InlineBlock:
st.display = cssbox.Display.Block
else st.display == cssbox.Display.InlineFlex:
st.display = cssbox.Display.Flex
else st.display == cssbox.Display.InlineGrid:
st.display = cssbox.Display.Grid
else st.display == cssbox.Display.InlineTable:
st.display = cssbox.Display.Table
end
end
if node >= 0:
switch cs.display:
css.Display.TableCell:
cspan := _attr(_e.dom, node, "colspan")
if cspan.len() > 0:
st.col_span = cspan.to_int()
end
rspan := _attr(_e.dom, node, "rowspan")
if rspan.len() > 0:
st.row_span = rspan.to_int()
end
break
end
css.Display.TableColumn, css.Display.TableColumnGroup:
sp := _attr(_e.dom, node, "span")
if sp.len() > 0:
st.col_span = sp.to_int()
end
break
end
else:
break
end
end
end
if node >= 0 and _e.dom.nodes[node].tag == "img":
iw := _e.rep_w[node]
ih := _e.rep_h[node]
if iw > 0.0 and ih > 0.0 and st.aspect_ratio == 0.0:
st.aspect_ratio = iw / ih
end
end
if st.overflow_x == cssbox.Overflow.Scroll or st.overflow_y == cssbox.Overflow.Scroll:
st.scrollbar_width = 0.0
end
ret st
end
func _cb_grow(n: int):
until _e.cb_node.len() < n:
_e.cb_node.push(-1)
_e.cb_ifc.push(-1)
_e.cb_rep.push(-1)
_e.cb_key.push(-1 as i64)
_e.cb_used.push(false)
_e.cb_meas.push(false)
_e.cb_want.push(false)
_e.cb_pkey.push("")
_e.cb_rw.push(-1.0)
_e.cb_rh.push(-1.0)
end
end
func _new_cb(st: cssbox.Style, node: int): int:
mut key := -2 as i64
if node >= 0 and node < _e.node_ord.len():
ord := _e.node_ord[node]
_e.node_ord[node] = ord + 1
uid := node < _e.ctl.len() ? _e.ctl[node].uid : node
key = (uid as i64) * (1000003 as i64) + (ord as i64)
else:
key = (-2 - _e.root_ord) as i64
_e.root_ord++
end
mut cb := -1
if _e.key_map.has(key):
c := _e.key_map.get(key)
if c < _e.cb_used.len() and not _e.cb_used[c] and _e.cb_key[c] == key:
cb = c
end
end
if cb >= 0:
_e.tree.SetStyle(cb, st)
else _e.free_cbs.len() > 0:
cb = _e.free_cbs.pop()
_e.tree.SetStyle(cb, st)
_e.tree.MarkDirty(cb)
else:
cb = _e.tree.AddNode(st)
_cb_grow(cb + 1)
end
if _e.cb_key[cb] != key:
_e.cb_key[cb] = key
_e.key_map.put(key, cb)
end
_e.cb_used[cb] = true
_e.cb_node[cb] = node
ret cb
end
func _link(parent: int, child: int):
_e.link_p.push(parent)
_e.link_c.push(child)
end
func _measure_fn(mi: cssbox.MeasureInput): cssbox.MeasureOutput:
ret _measure(mi)
end
func _attach_measure(cb: int):
_e.cb_want[cb] = true
end
func _begin_build():
if not _e.has_tree:
_e.tree = cssbox.Tree {}
_e.has_tree = true
_cb_clear()
end
n := _e.tree.NodeCount()
_cb_grow(n)
repeat n in c:
_e.cb_node[c] = -1
_e.cb_ifc[c] = -1
_e.cb_rep[c] = -1
_e.cb_used[c] = false
_e.cb_want[c] = false
end
_e.node_ord.free()
_e.node_ord = Vector {} as Vector<int>
repeat _e.dom.nodes.len():
_e.node_ord.push(0)
end
_e.root_ord = 0
_e.link_p.clear()
_e.link_c.clear()
end
func _end_build():
n := _e.tree.NodeCount()
mut cnt := Vector {} as Vector<int>
defer cnt.free()
repeat n + 1:
cnt.push(0)
end
each p in _e.link_p:
cnt[p + 1] += 1
end
repeat n in i:
cnt[i + 1] += cnt[i]
end
mut fill := Vector {} as Vector<int>
defer fill.free()
repeat n:
fill.push(0)
end
mut flat := Vector {} as Vector<int>
defer flat.free()
repeat _e.link_c.len():
flat.push(0)
end
repeat _e.link_p.len() in k:
p := _e.link_p[k]
flat[cnt[p] + fill[p]] = _e.link_c[k]
fill[p] += 1
end
mut kids := Vector {} as Vector<int>
defer kids.free()
repeat n in c:
if not _e.cb_used[c]:
if _e.cb_key[c] != (-1 as i64):
kids.clear()
if _e.tree.ChildCount(c) > 0:
_e.tree.SetChildren(c, kids)
end
if _e.cb_meas[c]:
_e.tree.ClearMeasure(c)
_e.cb_meas[c] = false
end
if _e.key_map.has(_e.cb_key[c]) and _e.key_map.get(_e.cb_key[c]) == c:
_e.key_map.remove(_e.cb_key[c])
end
_e.cb_key[c] = -1 as i64
_sfree(_e.cb_pkey[c])
_e.cb_pkey[c] = ""
_e.cb_rw[c] = -1.0
_e.cb_rh[c] = -1.0
_e.free_cbs.push(c)
end
continue
end
s0 := cnt[c]
e0 := cnt[c + 1]
mut same := _e.tree.ChildCount(c) == e0 - s0
if same:
repeat e0 - s0 in q:
if _e.tree.Child(c, q) != flat[s0 + q]:
same = false
break
end
end
end
if not same:
kids.clear()
repeat e0 - s0 in q:
kids.push(flat[s0 + q])
end
_e.tree.SetChildren(c, kids)
end
if _e.cb_want[c] and not _e.cb_meas[c]:
_e.tree.SetMeasure(c, (mi: cssbox.MeasureInput): ret _measure_fn(mi) end)
_e.cb_meas[c] = true
else not _e.cb_want[c] and _e.cb_meas[c]:
_e.tree.ClearMeasure(c)
_e.cb_meas[c] = false
end
rep := _e.cb_rep[c]
if rep >= 0:
if _e.cb_rw[c] != _e.rep_w[rep] or _e.cb_rh[c] != _e.rep_h[rep]:
_e.cb_rw[c] = _e.rep_w[rep]
_e.cb_rh[c] = _e.rep_h[rep]
_e.tree.MarkDirty(c)
end
end
fi := _e.cb_ifc[c]
if fi >= 0:
f := _e.ifcs[fi]
key := (f.control or f.atoms.len() > 0) ? "" : _para_key(f)
if key.len() == 0 or key != _e.cb_pkey[c]:
_e.tree.MarkDirty(c)
end
if key.len() > 0 and f.ckey.len() == 0:
mut fr := _e.ifcs.ref(fi)
fr.ckey = str.Clone(key)
end
_sfree(_e.cb_pkey[c])
_e.cb_pkey[c] = key
else _e.cb_pkey[c].len() > 0:
_sfree(_e.cb_pkey[c])
_e.cb_pkey[c] = ""
_e.tree.MarkDirty(c)
end
end
end
func _cb_clear():
each k in _e.cb_pkey:
_sfree(k)
end
_e.key_map.free()
_e.key_map = HashMap {} as HashMap<i64, int>
_e.cb_node.clear()
_e.cb_ifc.clear()
_e.cb_rep.clear()
_e.cb_key.clear()
_e.cb_used.clear()
_e.cb_meas.clear()
_e.cb_want.clear()
_e.cb_pkey.clear()
_e.cb_rw.clear()
_e.cb_rh.clear()
_e.free_cbs.clear()
end
func _drop_tree():
if _e.has_tree:
_e.tree.Free()
_e.has_tree = false
end
_cb_clear()
_e.key_map.free()
_e.key_map = HashMap {} as HashMap<i64, int>
end
func _new_ifc(owner: int, cb: int): int:
mut f := _Ifc { owner = owner, cb = cb }
f.spans = Vector {} as Vector<typeset.TextSpan>
f.span_el = Vector {} as Vector<int>
f.span_atom = Vector {} as Vector<int>
f.atoms = Vector {} as Vector<int>
cs := _style_of(owner)
f.pstyle = _pstyle(cs)
_e.ifcs.push(f)
idx := _e.ifcs.len() - 1
if owner >= 0 and owner < _e.node_ifc.len() and _e.node_ifc[owner] < 0:
_e.node_ifc[owner] = idx
else owner >= 0 and owner < _e.node_ifc.len():
mut j := _e.node_ifc[owner]
until _e.ifcs[j].next >= 0:
j = _e.ifcs[j].next
end
if j != idx:
mut pj := _e.ifcs.ref(j)
pj.next = idx
end
end
if cb >= 0:
_e.cb_ifc[cb] = idx
_attach_measure(cb)
end
ret idx
end
func _pstyle(cs: css.ComputedStyle): typeset.ParagraphStyle:
mut ps := typeset.ParagraphStyle {}
switch cs.text_align:
css.TextAlign.End: ps.align = typeset.TextAlign.End break end
css.TextAlign.Left: ps.align = typeset.TextAlign.Left break end
css.TextAlign.Right: ps.align = typeset.TextAlign.Right break end
css.TextAlign.Center: ps.align = typeset.TextAlign.Center break end
css.TextAlign.Justify: ps.align = typeset.TextAlign.Justify break end
else: ps.align = typeset.TextAlign.Start break end
end
ps.direction = cs.direction == cssbox.Direction.Rtl ? typeset.TextDirRTL : typeset.TextDirLTR
switch cs.white_space:
css.WhiteSpace.Pre: ps.white_space = typeset.WhiteSpace.Pre break end
css.WhiteSpace.NoWrap: ps.white_space = typeset.WhiteSpace.NoWrap break end
css.WhiteSpace.PreWrap, css.WhiteSpace.BreakSpaces: ps.white_space = typeset.WhiteSpace.PreWrap break end
else: ps.white_space = typeset.WhiteSpace.Normal break end
end
switch cs.overflow_wrap:
css.OverflowWrap.Anywhere: ps.overflow_wrap = typeset.OverflowWrap.Anywhere break end
css.OverflowWrap.BreakWord: ps.overflow_wrap = typeset.OverflowWrap.BreakWord break end
else: break end
end
ps.lang = _e.env.lang
ret ps
end
func _span_of(cs: css.ComputedStyle, text: str, el: int): typeset.TextSpan:
mut sp := typeset.TextSpan {}
sp.text = text
sp.families = cs.font_family
sp.size = cs.font_size
sp.weight = cs.font_weight
sp.italic = cs.font_style != css.FontStyle.Normal
sp.letter_spacing = cs.letter_spacing
sp.word_spacing = cs.word_spacing
if not cs.line_height_normal:
sp.line_height = cs.line_height
end
sp.lang = _e.env.lang
sp.tag = el
ret sp
end
func _transform(cs: css.ComputedStyle, s: str): str:
switch cs.text_transform:
css.TextTransform.Uppercase: ret str.Upper(s) end
css.TextTransform.Lowercase: ret str.Lower(s) end
css.TextTransform.Capitalize: ret str.Title(s) end
else: ret str.Clone(s) end
end
ret str.Clone(s)
end
func _push_span(f &: _Ifc, sp: typeset.TextSpan, el: int, atom: int):
f.spans.push(sp)
f.span_el.push(el)
f.span_atom.push(atom)
end
func _ifc_add(fi: int, node: int):
nd := _e.dom.nodes[node]
mut f := _e.ifcs.ref(fi)
if nd.tag == "#text":
el := _el_of(nd.parent)
cs := _style_of(el)
t := _transform(cs, nd.text)
_push_span(f, _span_of(cs, t, el), el, -1)
_sc_note_span(fi, f.spans.len() - 1, node)
ret
end
o := _outer(node)
if o == _OUT_NONE:
ret
end
cs := _style_of(node)
if nd.tag == "br":
_push_span(f, _span_of(cs, " ", node), node, -1)
ret
end
if o == _OUT_ATOM:
ai := _build_atom(node, fi)
mut f2 := _e.ifcs.ref(fi)
_push_span(f2, _span_of(cs, "​", node), node, -1)
_push_span(f2, _span_of(cs, " ", node), node, ai)
f2.atoms.push(ai)
mut a := _e.atoms.ref(ai)
a.span = f2.spans.len() - 1
_push_span(f2, _span_of(cs, "​", node), node, -1)
ret
end
each k in nd.kids:
_ifc_add(fi, k)
end
end
func _build_atom(node: int, fi: int): int:
cb := _build_element(node, -1, false)
_e.atoms.push(_Atom { node = node, ifc = fi })
ai := _e.atoms.len() - 1
_e.node_atom[node] = ai
_e.node_cb[node] = cb
ret ai
end
func _marker_text(node: int, cs: css.ComputedStyle): str:
t := cs.list_style_type
switch t:
"none", "":
ret str.Clone("")
end
"disc": ret str.Clone("•\u00A0 ") end
"circle": ret str.Clone("◦\u00A0 ") end
"square": ret str.Clone("▪\u00A0 ") end
"disclosure-closed": ret str.Clone(cs.direction == cssbox.Direction.Rtl ? "◂ " : "▸ ") end
"disclosure-open": ret str.Clone("▾ ") end
else:
break
end
end
mut idx := 1
p := _e.dom.nodes[node].parent
if p >= 0:
mut start := 1
st := _attr(_e.dom, p, "start")
if st.len() > 0:
start = st.to_int()
end
idx = start
each k in _e.dom.nodes[p].kids:
if k == node:
break
end
if _e.dom.nodes[k].tag == "li":
idx++
end
end
end
v := _attr(_e.dom, node, "value")
if v.len() > 0:
idx = v.to_int()
end
mut num := str.FromInt(idx as i64)
if t == "persian" or t == "arabic-indic" or (t == "decimal" and _e.env.lang.starts_with("fa")):
old := num
num = t == "arabic-indic" ? str.ToArabicDigits(old) : str.ToPersianDigits(old)
_sfree(old)
end
if t == "lower-alpha" or t == "lower-latin":
_sfree(num)
num = str.Clone(" ")
p2 := (num as void*) as u8*
p2[0] = (96 + ((idx - 1) % 26 + 1)) as u8
else t == "upper-alpha" or t == "upper-latin":
_sfree(num)
num = str.Clone(" ")
p2 := (num as void*) as u8*
p2[0] = (64 + ((idx - 1) % 26 + 1)) as u8
end
sep := ".\u00A0"
r := num + (t == "decimal" or t == "persian" or t == "arabic-indic" ? sep : ".\u00A0")
_sfree(num)
ret r
end
func _make_ifc(owner: int, cb: int, kids: Vector<int>): int:
fi := _new_ifc(owner, cb)
cs := _style_of(owner)
if cs.display == css.Display.ListItem and cs.list_style_position == css.ListPosition.Inside:
m := _marker_text(owner, cs)
if m.len() > 0:
mut f := _e.ifcs.ref(fi)
_push_span(f, _span_of(cs, m, owner), owner, -1)
end
end
each k in kids:
_ifc_add(fi, k)
end
ret fi
end
func _run_has_content(kids: Vector<int>, pre: bool): bool:
each k in kids:
nd := _e.dom.nodes[k]
if nd.tag == "#text":
if pre or not _is_ws_text(nd.text):
ret true
end
else:
ret true
end
end
ret false
end
func _flush_run(node: int, cbn: int, run &: Vector<int>):
if run.len() == 0:
ret
end
cs := _style_of(node)
pre := cs.white_space == css.WhiteSpace.Pre or cs.white_space == css.WhiteSpace.PreWrap
if _run_has_content(run, pre):
mut st := cssbox.Style {}
st.direction = cs.direction
anon := _new_cb(st, node)
_link(cbn, anon)
_make_ifc(node, anon, run)
end
run.clear()
end
func _virt_view(node: int, cs: css.ComputedStyle): f64:
if node < 0 or node == _e.dom.body or not (cs.overflow_y == cssbox.Overflow.Auto or cs.overflow_y == cssbox.Overflow.Scroll):
ret -1.0
end
if cs.height.kind == css.LenKind.Length and cs.height.calc.len() == 0 and not cs.height.has_pct and cs.height.px > 0.0:
ret cs.height.px
end
if cs.max_height.kind == css.LenKind.Length and cs.max_height.calc.len() == 0 and not cs.max_height.has_pct and cs.max_height.px > 0.0:
ret cs.max_height.px
end
ret -1.0
end
func _virt_rows(node: int, rows &: Vector<int>): bool:
each k in _e.dom.nodes[node].kids:
nd := _e.dom.nodes[k]
if nd.tag == "#text":
if not _is_ws_text(nd.text):
ret false
end
continue
end
o := _outer(k)
if o == _OUT_NONE:
continue
end
if o != _OUT_BLOCK:
ret false
end
kcs := _style_of(k)
if kcs.position != cssbox.Position.Static and kcs.position != cssbox.Position.Relative:
ret false
end
rows.push(k)
end
ret rows.len() >= _VIRT_MIN
end
func _row_uid(k: int): int:
if k < _e.ctl.len():
ret _e.ctl[k].uid
end
ret k
end
func _virt_build(node: int, cbn: int, view: f64, rows: Vector<int>):
mut known := 0.0
mut known_n := 0
each r in rows:
u := _row_uid(r)
if _e.vadv.has(u):
known += _e.vadv.get(u)
known_n++
end
end
mut avg := 20.0
if known_n > 0:
avg = known / (known_n as f64)
else:
_e.vfix = true
end
scroll := node < _e.ctl.len() ? _e.ctl[node].scroll_y : 0.0
lo := scroll - view
hi := scroll + 2.0 * view
mut top := 0.0
mut first := -1
mut last := -1
repeat rows.len() in i:
r := rows[i]
u := _row_uid(r)
a := _e.vadv.has(u) ? _e.vadv.get(u) : avg
_e.vtop[r] = top
_e.vh[r] = a
if top + a > lo and top < hi:
if first < 0:
first = i
end
last = i
end
top += a
end
if first < 0:
first = rows.len() - 1
last = rows.len() - 1
end
total := top
last_row := rows[last]
lu := _row_uid(last_row)
after := total - _e.vtop[last_row] - (_e.vadv.has(lu) ? _e.vadv.get(lu) : avg)
before := _e.vtop[rows[first]]
cs := _style_of(node)
if before > 0.0:
mut st := cssbox.Style {}
st.direction = cs.direction
st.height = cssbox.Px(before)
sp := _new_cb(st, node)
_link(cbn, sp)
end
_e.vconts.push(node)
_e.vrow0.push(_e.vrows.len())
repeat rows.len() in i:
r := rows[i]
if i < first or i > last:
_e.vskip[r] = node
continue
end
child := _build_element(r, cbn, false)
if child >= 0:
_e.node_cb[r] = child
_e.vrows.push(r)
end
end
if after > 0.0:
mut st := cssbox.Style {}
st.direction = cs.direction
st.height = cssbox.Px(after)
sp := _new_cb(st, node)
_link(cbn, sp)
end
end
func _virt_measure():
repeat _e.vconts.len() in v:
s0 := _e.vrow0[v]
e0 := v + 1 < _e.vrow0.len() ? _e.vrow0[v + 1] : _e.vrows.len()
mut k := s0
until k < e0:
r := _e.vrows[k]
l := _e.tree.Layout(_e.node_cb[r])
mut a := 0.0
if k + 1 < e0:
n2 := _e.tree.Layout(_e.node_cb[_e.vrows[k + 1]])
a = n2.abs_y - l.abs_y
else:
a = l.height + l.margin.top + l.margin.bottom
end
u := _row_uid(r)
if not _e.vadv.has(u) or math.Abs(_e.vadv.get(u) - a) > 0.01:
_e.vadv.put(u, a)
_e.vfix = true
end
k++
end
cont := _e.vconts[v]
cl := _e.tree.Layout(_e.node_cb[cont])
vh := cl.height - cl.border.top - cl.border.bottom - cl.scrollbar_height
newmax := math.Max(0.0, cl.scroll_height - vh)
cu := _row_uid(cont)
if _e.vmax.has(cu) and cont < _e.ctl.len():
oldmax := _e.vmax.get(cu)
sy := _e.ctl[cont].scroll_y
if sy >= oldmax - 0.5 and math.Abs(newmax - sy) > 0.5:
mut cc := _e.ctl.ref(cont)
cc.scroll_y = newmax
_e.vfix = true
end
end
_e.vmax.put(cu, newmax)
end
end
func _virt_reset():
n := _e.dom.nodes.len()
_e.vskip.free()
_e.vtop.free()
_e.vh.free()
_e.vskip = Vector {} as Vector<int>
_e.vtop = Vector {} as Vector<f64>
_e.vh = Vector {} as Vector<f64>
repeat n:
_e.vskip.push(-1)
_e.vtop.push(0.0)
_e.vh.push(0.0)
end
_e.vconts.clear()
_e.vrow0.clear()
_e.vrows.clear()
end
func _build_children(node: int, cbn: int, flex: bool):
nd := _e.dom.nodes[node]
mut any_block := false
each k in nd.kids:
o := _outer(k)
if o == _OUT_BLOCK:
any_block = true
end
end
cs := _style_of(node)
if any_block and not flex and nd.kids.len() >= _VIRT_MIN:
view := _virt_view(node, cs)
if view > 0.0:
mut rows := Vector {} as Vector<int>
if _virt_rows(node, rows):
_virt_build(node, cbn, view, rows)
rows.free()
ret
end
rows.free()
end
end
if not any_block and not flex:
pre := cs.white_space == css.WhiteSpace.Pre or cs.white_space == css.WhiteSpace.PreWrap
list_marker := cs.display == css.Display.ListItem and cs.list_style_position == css.ListPosition.Inside
if _run_has_content(nd.kids, pre) or list_marker:
_make_ifc(node, cbn, nd.kids)
end
ret
end
mut run := Vector {} as Vector<int>
defer run.free()
each k in nd.kids:
o := _outer(k)
if o == _OUT_NONE:
continue
end
if o == _OUT_BLOCK or (flex and _e.dom.nodes[k].tag != "#text"):
_flush_run(node, cbn, run)
child := _build_element(k, cbn, flex)
if child >= 0:
_e.node_cb[k] = child
end
else:
run.push(k)
end
end
_flush_run(node, cbn, run)
end
func _intrinsic(node: int, cs: css.ComputedStyle): bool:
tag := _e.dom.nodes[node].tag
fs := cs.font_size
mut w := 0.0
mut h := 0.0
switch tag:
"img":
src := _attr(_e.dom, node, "src")
k := _image_index(src)
if k >= 0 and _img_ok[k]:
w = _img_canvas[k].width as f64
h = _img_canvas[k].height as f64
end
break
end
"progress":
w = fs * 10.0
h = fs
break
end
"meter":
w = fs * 5.0
h = fs
break
end
"canvas":
w = 300.0
h = 150.0
break
end
"video", "iframe", "embed", "object":
w = 300.0
h = 150.0
break
end
"input":
t := _input_type(node)
switch t:
"checkbox", "radio":
w = 13.0
h = 13.0
break
end
"range":
w = 129.0
h = 16.0
break
end
"color":
w = 50.0
h = 27.0
break
end
else:
ret false
end
end
break
end
else:
ret false
end
end
_e.rep_w[node] = w
_e.rep_h[node] = h
ret true
end
func _control_ifc(node: int, cb: int, cs: css.ComputedStyle):
tag := _e.dom.nodes[node].tag
fi := _new_ifc(node, cb)
mut f := _e.ifcs.ref(fi)
f.control = true
f.pstyle.white_space = tag == "textarea" ? typeset.WhiteSpace.PreWrap : typeset.WhiteSpace.Pre
fs := cs.font_size
if tag == "textarea":
cols := _attr(_e.dom, node, "cols")
nc := cols.len() > 0 ? cols.to_int() : 20
f.fixed_w = (nc as f64) * fs * 0.6 + 17.0
else tag == "select":
f.fixed_w = -1.0
else:
sz := _attr(_e.dom, node, "size")
nc := sz.len() > 0 ? sz.to_int() : 20
f.fixed_w = (nc as f64) * fs * 0.55
if _input_type(node) == "number":
f.fixed_w -= 13.0
end
end
mut text := _control_text(node)
if tag == "select":
mut longest := ""
_select_longest(node, longest)
text = longest
end
_push_span(f, _span_of(cs, text, node), node, -1)
if tag == "textarea":
rows := _attr(_e.dom, node, "rows")
nr := rows.len() > 0 ? rows.to_int() : 2
lh := cs.line_height_normal ? fs * 1.2 : cs.line_height
f.fixed_h = (nr as f64) * lh
end
end
func _select_longest(node: int, out &: str):
each k in _e.dom.nodes[node].kids:
nd := _e.dom.nodes[k]
if nd.tag == "option":
t := _text_of(_e.dom, k)
if t.len() > out.len():
out = t
end
else nd.tag == "optgroup":
_select_longest(k, out)
end
end
end
func _build_element(node: int, parent_cb: int, blockify: bool): int:
i := _e.node_el[node]
if i < 0:
ret -1
end
cs := _e.st[i]
if cs.display == css.Display.None:
ret -1
end
tag := _e.dom.nodes[node].tag
replaced := _is_replaced(tag)
if replaced:
_intrinsic(node, cs)
end
st := _box_style(node, cs, blockify)
cb := _new_cb(st, node)
_e.node_cb[node] = cb
if parent_cb >= 0:
_link(parent_cb, cb)
end
if replaced:
if _intrinsic(node, cs):
_e.cb_rep[cb] = node
_attach_measure(cb)
else tag == "input" or tag == "textarea" or tag == "select":
_control_ifc(node, cb, cs)
end
ret cb
end
if _is_button_input(node):
_control_ifc(node, cb, cs)
ret cb
end
flex := cs.display == css.Display.Flex or cs.display == css.Display.InlineFlex or cs.display == css.Display.Grid or cs.display == css.Display.InlineGrid or cs.display == css.Display.TableRow
_build_children(node, cb, flex)
ret cb
end
func _image_index(src: str): int:
if src.len() == 0:
ret -1
end
repeat _img_keys.len() in k:
if _img_keys[k] == src:
ret k
end
end
mut ok := false
cv := _load_image(src, ok)
_img_keys.push(str.Clone(src))
_img_canvas.push(cv)
_img_ok.push(ok)
ret _img_keys.len() - 1
end
func _reset_layout():
_sc_spans_reset()
repeat _e.ifcs.len() in i:
mut f := _e.ifcs.ref(i)
if f.ckey.len() > 0 and f.has_para and not _pc_map.has(f.ckey):
_pc_put(f)
end
_free_ifc(f)
end
_e.ifcs.free()
_e.ifcs = Vector {} as Vector<_Ifc>
_e.atoms.free()
_e.atoms = Vector {} as Vector<_Atom>
n := _e.dom.nodes.len()
_e.node_cb.free()
_e.node_atom.free()
_e.node_ifc.free()
_e.rep_w.free()
_e.rep_h.free()
_e.node_cb = Vector {} as Vector<int>
_e.node_atom = Vector {} as Vector<int>
_e.node_ifc = Vector {} as Vector<int>
_e.rep_w = Vector {} as Vector<f64>
_e.rep_h = Vector {} as Vector<f64>
repeat n:
_e.node_cb.push(-1)
_e.node_atom.push(-1)
_e.node_ifc.push(-1)
_e.rep_w.push(0.0)
_e.rep_h.push(0.0)
end
end
func _free_ifc(f &: _Ifc):
repeat f.spans.len() in k:
sp := f.spans[k]
if f.span_atom[k] < 0 and sp.text.len() > 0 and not (sp.text == "​" or sp.text == " " or sp.text == " "):
_sfree(sp.text)
end
end
f.spans.free()
f.span_el.free()
f.span_atom.free()
f.atoms.free()
_sfree(f.ckey)
f.ckey = ""
if f.has_para:
typeset.FreeParagraph(f.para)
f.has_para = false
end
if f.has_lay:
typeset.FreeLayout(f.lay)
f.has_lay = false
end
_free_alts(f)
end
func _free_alts(f &: _Ifc):
repeat f.alt_lay.len() in i:
mut l := f.alt_lay[i]
typeset.FreeLayout(l)
end
f.alt_lay.free()
f.alt_w.free()
f.alt_lay = Vector {} as Vector<typeset.TextLayout>
f.alt_w = Vector {} as Vector<f64>
end
func _layout():
repeat 3:
_e.vfix = false
_layout_pass()
if not _e.vfix:
break
end
end
end
func _layout_pass():
_ensure_fonts()
_reset_layout()
_virt_reset()
_begin_build()
mut rs := cssbox.Style {}
rs.width = cssbox.Px(_e.width)
rcs := _e.sheet.RootStyle()
rs.direction = rcs.direction
_e.root_cb = _new_cb(rs, -1)
if _e.dom.body >= 0:
_build_element(_e.dom.body, _e.root_cb, false)
end
_end_build()
_e.tree.ResetCounters()
repeat _e.atoms.len() in k:
_compute_atom(k)
end
_e.tree.Compute(_e.root_cb, cssbox.Definite(_e.width), cssbox.Definite(_e.height))
_e.last_layout_calls = _e.tree.LayoutCalls()
_virt_measure()
_place_all()
_pc_sweep()
end
func _compute_atom(k: int):
a := _e.atoms[k]
cb := _e.node_cb[a.node]
if cb < 0:
ret
end
_e.tree.Compute(cb, cssbox.MaxContentSpace(), cssbox.MaxContentSpace())
mut l := _e.tree.Layout(cb)
if l.width + l.margin.left + l.margin.right > _e.width:
_e.tree.Compute(cb, cssbox.Definite(_e.width), cssbox.MaxContentSpace())
l = _e.tree.Layout(cb)
end
mut at := _e.atoms.ref(k)
at.mw = l.width + l.margin.left + l.margin.right
at.mh = l.height + l.margin.top + l.margin.bottom
tag := _e.dom.nodes[a.node].tag
mut base := at.mh
if l.has_baseline and not (tag == "img" or (tag == "input" and not _is_text_input(a.node) and not _is_button_input(a.node))):
base = l.margin.top + l.baseline
end
at.baseline = _va_base(a.node, base, at.mh)
at.va = _va_kind(a.node)
at.va_set = false
