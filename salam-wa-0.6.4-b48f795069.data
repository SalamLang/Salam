pub name: str = ""
@en "varDefs"
@fa "تعریف‌های متغیر"
pub varDefs: Vector<AstVariableDef> = Vector {}
@en "directives"
@fa "دستورالعمل‌ها"
pub directives: Vector<AstDirective> = Vector {}
@en "selections"
@fa "گزینش‌ها"
pub selections: Vector<int> = Vector {}
@en "shorthand"
@fa "کوتاه‌نویسی"
pub shorthand: bool = false
@en "line"
@fa "خط"
pub line: int = 0
