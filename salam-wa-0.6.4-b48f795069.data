prev[i] = iv[i]
end
mut off := 0
until off + 16 <= n:
repeat 16 in i:
cur[i] = src[off + i]
end
_aes_dec_block(a, _poff(src, off), _poff(dst, off))
repeat 16 in i:
dst[off + i] = ((dst[off + i] as int) ^ (prev[i] as int)) as u8
prev[i] = cur[i]
end
off += 16
end
