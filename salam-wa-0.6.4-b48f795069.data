package dir
import os
import fs
import fs.path
import os.error
@en "Mkdir"
@fa "ساخت پوشه"
pub func Mkdir(p: str): int:
if os.Mkdir(p) != 0:
error.Set(error.IOError, "mkdir failed", "Mkdir", p, 0)
ret 0 - 1
end
ret 0
end
@en "MkdirAll"
@fa "ساخت پوشه ها"
pub func MkdirAll(p: str): int:
if os.MkdirAll(p) != 0:
error.Set(error.IOError, "mkdir -p failed", "MkdirAll", p, 0)
ret 0 - 1
end
ret 0
end
@en "Remove"
@fa "حذف"
pub func Remove(p: str): int:
if os.Rmdir(p) != 0:
error.Set(error.IOError, "rmdir failed", "Remove", p, 0)
ret 0 - 1
end
ret 0
end
@en "RemoveAll"
@fa "حذف همه"
pub func RemoveAll(p: str): int:
if os.RemoveAll(p) != 0:
error.Set(error.IOError, "recursive remove failed", "RemoveAll", p, 0)
ret 0 - 1
end
ret 0
end
@en "List"
@fa "فهرست"
pub func List(p: str): Vector<str>: ret os.ListDir(p) end
@en "ListDirs"
@fa "فهرست پوشه ها"
pub func ListDirs(p: str): Vector<str>: ret os.ListDirs(p) end
@en "ListFiles"
@fa "فهرست پرونده ها"
pub func ListFiles(p: str): Vector<str>:
entries := os.ListDir(p)
defer entries.free()
out := Vector {} as Vector<str>
repeat entries.len() in i:
name := entries.get(i)
full := path.Join(p, name)
if os.IsDir(full) == false:
out.push(name)
end
end
ret out
end
@en "Walk"
@fa "پیمایش"
pub func Walk(p: str): Vector<str>: ret os.Walk(p) end
@en "Copy"
@fa "کپی"
pub func Copy(src: str, dst: str): int:
if os.CopyTree(src, dst) != 0:
error.Set(error.IOError, "copy tree failed", "Copy", src, 0)
ret 0 - 1
end
ret 0
end
@en "Move"
@fa "جابجایی"
pub func Move(src: str, dst: str): int:
if os.Move(src, dst) == 0: ret 0 end
if os.CopyTree(src, dst) != 0:
error.Set(error.IOError, "move (copy phase) failed", "Move", src, 0)
ret 0 - 1
end
if os.RemoveAll(src) != 0:
error.Set(error.IOError, "move (cleanup phase) failed", "Move", src, 0)
ret 0 - 1
end
ret 0
end
@en "Exists"
@fa "وجود دارد"
pub func Exists(p: str): bool: ret os.Exists(p) and os.IsDir(p) end
@en "IsDir"
@fa "پوشه است"
pub func IsDir(p: str): bool: ret os.IsDir(p) end
@en "Size"
@fa "اندازه"
pub func Size(p: str): i64:
files := os.Walk(p)
defer files.free()
mut total := 0 as i64
repeat files.len() in i:
f := files.get(i)
sz := fs.Size(f)
if sz > 0: total += sz end
end
ret total
end
@en "Permissions"
@fa "مجوزها"
pub func Permissions(p: str): int: ret fs.Permissions(p) end
@en "ModTime"
@fa "زمان تغییر"
pub func ModTime(p: str): i64: ret fs.ModTime(p) end
package dir
import os
import str
import sort
import filepath
func _glob_join(base: str, name: str): str:
if base.len() == 0:
ret str.Clone(name)
end
if base == "/":
ret "/" + name
end
ret base + "/" + name
end
func _glob_expand(base: str, segs: Vector<str>, at: int, out &: Vector<str>):
if at >= segs.len():
if base.len() > 0 and os.Exists(base):
out.push(str.Clone(base))
end
ret
end
seg := segs.get(at)
if seg == "**":
_glob_expand(base, segs, at + 1, out)
entries := os.ListDir(base.len() == 0 ? "." : base)
defer entries.free()
repeat entries.len() in i:
full := _glob_join(base, entries.get(i))
if os.IsDir(full):
_glob_expand(full, segs, at, out)
end
end
ret
end
if not filepath.HasMeta(seg):
_glob_expand(_glob_join(base, seg), segs, at + 1, out)
ret
end
if base.len() > 0 and not os.IsDir(base):
ret
end
entries := os.ListDir(base.len() == 0 ? "." : base)
defer entries.free()
repeat entries.len() in i:
name := entries.get(i)
if filepath.Match(seg, name):
_glob_expand(_glob_join(base, name), segs, at + 1, out)
end
end
end
@en "Glob"
@fa "الگوجویی"
pub func Glob(pattern: str): Vector<str>:
mut out := Vector {} as Vector<str>
parts := str.Split(pattern, "/")
defer parts.free()
mut segs := Vector {} as Vector<str>
defer segs.free()
repeat parts.len() in i:
if parts.get(i).len() > 0:
segs.push(parts.get(i))
end
end
base := str.StartsWith(pattern, "/") ? "/" : ""
_glob_expand(base, segs, 0, out)
sort.Sort(out)
mut unique := Vector {} as Vector<str>
repeat out.len() in i:
if i == 0 or out.get(i) != out.get(i - 1):
unique.push(out.get(i))
end
end
out.free()
ret unique
end
@en "WalkMatch"
@fa "پیمایش با الگو"
pub func WalkMatch(root: str, pattern: str): Vector<str>:
mut out := Vector {} as Vector<str>
files := os.Walk(root)
defer files.free()
prefix := root.len() == 0 ? "" : (str.EndsWith(root, "/") ? root : root + "/")
byname := str.IndexOf(pattern, "/") < 0
repeat files.len() in i:
full := files.get(i)
rel := str.StartsWith(full, prefix) ? full.substr(prefix.len(), full.len() - prefix.len()) : full
target := byname ? filepath.Base(rel) : rel
if filepath.Match(pattern, target):
out.push(full)
end
end
sort.Sort(out)
ret out
end
