func _param_at(s: str, start: int, stop: int, idx: int): int:
bp := _bp(s)
mut seen := 0
mut value := 0
mut i := start
until i < stop:
c := _ub(bp, i)
if c == 59:
if seen == idx: ret value end
seen++
value = 0
else c >= 48 and c <= 57:
value = value * 10 + (c - 48)
end
i++
end
if seen == idx: ret value end
ret 0
end
func _apply_mods(k &: Key, m: int):
if m <= 1: ret end
bits := m - 1
if (bits & 1) != 0: k.shift = true end
if (bits & 2) != 0: k.alt = true end
if (bits & 4) != 0: k.ctrl = true end
end
func _letter_key(c: int): int:
if c == 65: ret KeyUp end
if c == 66: ret KeyDown end
if c == 67: ret KeyRight end
if c == 68: ret KeyLeft end
if c == 70: ret KeyEnd end
if c == 72: ret KeyHome end
ret KeyUnknown
end
func _tilde_key(n: int): int:
if n == 1: ret KeyHome end
if n == 2: ret KeyInsert end
if n == 3: ret KeyDelete end
if n == 4: ret KeyEnd end
if n == 5: ret KeyPageUp end
if n == 6: ret KeyPageDown end
if n == 7: ret KeyHome end
if n == 8: ret KeyEnd end
if n >= 11 and n <= 15: ret KeyF1 + (n - 11) end
if n >= 17 and n <= 21: ret KeyF1 + (n - 17) + 5 end
if n == 23: ret KeyF1 + 10 end
if n == 24: ret KeyF1 + 11 end
ret KeyUnknown
end
func _decode_byte(b: int): Key:
mut k := Key { code = KeyUnknown }
if b == 13 or b == 10: k.code = KeyEnter ret k end
if b == 9: k.code = KeyTab ret k end
if b == 127 or b == 8: k.code = KeyBackspace ret k end
if b == 27: k.code = KeyEscape ret k end
if b == 32:
k.code = KeySpace
k.ch = " "
ret k
end
if b == 0:
k.code = KeyChar
k.ctrl = true
k.ch = " "
ret k
end
if b < 27:
k.code = KeyChar
k.ctrl = true
k.ch = char_from_code(96 + b)
ret k
end
if b < 32:
k.code = KeyChar
k.ctrl = true
k.ch = char_from_code(b + 64)
ret k
end
k.code = KeyChar
k.ch = char_from_code(b)
ret k
end
func _ready(_timeout_ms: int): bool:
if SALAM_OS_WINDOWS:
if not IsTTY(StdinFd): ret true end
ret _kbhit() != 0
else:
pfd := mem.Allocate(8 as u64)
defer mem.Free(pfd)
memset(pfd, 0, 8 as u64)
fdp := pfd as int*
fdp[0] = StdinFd
evp := ((pfd as i64) + 4) as i16*
evp[0] = 1 as i16
ret poll(pfd, 1 as usize, _timeout_ms) > 0
end
end
@en "Decode"
@fa "رمزگشایی"
pub func Decode(seq: str): Key:
n := seq.len()
if n == 0:
ret Key { code = KeyUnknown }
end
bp := _bp(seq)
if n == 1:
mut one := _decode_byte(_ub(bp, 0))
one.raw = seq
ret one
end
if _ub(bp, 0) != 27:
ret Key { code = KeyChar, ch = seq, raw = seq }
end
second := _ub(bp, 1)
if second != 91 and second != 79:
mut alt := _decode_byte(second)
if n > 2: alt.ch = str.Substr(seq, 1, n - 1) end
alt.alt = true
alt.raw = seq
ret alt
end
final := _ub(bp, n - 1)
if second == 79:
mut k := Key { raw = seq }
if final >= 80 and final <= 83:
k.code = KeyF1 + (final - 80)
else:
k.code = _letter_key(final)
end
ret k
end
if _ub(bp, 2) == 60:
ret Key { code = KeyMouse, raw = seq }
end
mut k := Key { raw = seq }
if final == 126:
k.code = _tilde_key(_param_at(seq, 2, n - 1, 0))
_apply_mods(k, _param_at(seq, 2, n - 1, 1))
ret k
end
k.code = _letter_key(final)
_apply_mods(k, _param_at(seq, 2, n - 1, 1))
ret k
end
@en "DecodeMouse"
@fa "رمزگشایی موشواره"
pub func DecodeMouse(seq: str): MouseEvent:
mut ev := MouseEvent {}
n := seq.len()
if n < 6: ret ev end
bp := _bp(seq)
if _ub(bp, 0) != 27 or _ub(bp, 1) != 91 or _ub(bp, 2) != 60: ret ev end
final := _ub(bp, n - 1)
if final != 77 and final != 109: ret ev end
b := _param_at(seq, 3, n - 1, 0)
ev.col = _param_at(seq, 3, n - 1, 1)
ev.row = _param_at(seq, 3, n - 1, 2)
ev.motion = (b & 32) != 0
ev.button = b & 3
ev.pressed = final == 77
ev.ok = true
ret ev
end
@en "ReadByte"
@fa "خواندن بایت"
pub func ReadByte(): int:
buf := mem.Allocate(2 as u64)
defer mem.Free(buf)
memset(buf, 0, 2 as u64)
mut got := 0
if SALAM_OS_WINDOWS:
got = _read(StdinFd, buf, 1 as u32)
else:
got = _fd_read1(StdinFd, buf)
end
if got <= 0: ret 0 - 1 end
p := buf as i8*
v := p[0] as int
if v < 0: ret v + 256 end
ret v
end
@en "KeyReady"
@fa "کلید آماده"
pub func KeyReady(timeout_ms: int): bool: ret _ready(timeout_ms) end
@en "ReadKey"
@fa "خواندن کلید"
pub func ReadKey(): Key:
first := ReadByte()
if first < 0: ret Key { code = KeyEOF } end
mut b := str.NewBuilder()
defer str.BufFree(b)
str.BufAppendChar(b, first)
if first == 27:
if not _ready(EscDelayMs): ret Key { code = KeyEscape, raw = Esc } end
second := ReadByte()
if second < 0: ret Key { code = KeyEscape, raw = Esc } end
str.BufAppendChar(b, second)
if second == 79:
c := ReadByte()
if c >= 0: str.BufAppendChar(b, c) end
else second == 91:
mut done := false
until not done:
c := ReadByte()
if c < 0: break end
str.BufAppendChar(b, c)
if c >= 0x40 and c <= 0x7E: done = true end
end
end
else first >= 0xC0:
mut extra := str.CharLen(first) - 1
until extra > 0:
c := ReadByte()
if c < 0: break end
str.BufAppendChar(b, c)
extra--
end
end
seq := str.BufStr(b)
ret Decode(seq)
end
@en "GetKey"
@fa "گرفتن کلید"
pub func GetKey(): Key:
mut st := MakeCbreak(StdinFd)
defer _restored := Restore(st)
if not st.ok:
ret ReadKey()
end
ret ReadKey()
end
@en "ReadPassword"
@fa "خواندن گذرواژه"
pub func ReadPassword(prompt: str): str:
Write(prompt)
Flush()
mut st := MakeCbreak(StdinFd)
mut b := str.NewBuilder()
defer str.BufFree(b)
until true:
c := ReadByte()
if c < 0 or c == 13 or c == 10: break end
if c == 3:
str.BufReset(b)
break
end
if c == 127 or c == 8:
if str.BufLen(b) > 0: b.len-- end
continue
end
str.BufAppendChar(b, c)
end
_restored := Restore(st)
Write("\n")
Flush()
out := str.BufStr(b)
ret out
end
package term
import str
import time
const _UNIT_KB := 1
const _UNIT_MB := 2
const _UNIT_GB := 3
const _UNIT_TB := 4
@en "Bar"
@fa "نوار پیشرفت"
pub struct Bar:
@en "total"
@fa "کل"
pub total: int = 100
@en "current"
@fa "مقدار فعلی"
pub current: int = 0
@en "width"
@fa "پهنا"
pub width: int = 0
@en "label"
@fa "برچسب"
pub label: str = ""
@en "fill"
@fa "نویسه پر"
pub fill: str = "#"
@en "head"
@fa "نویسه سر"
pub head: str = ""
@en "empty"
@fa "نویسه خالی"
pub empty: str = "-"
@en "color"
@fa "رنگ"
pub color: int = 0
@en "show_percent"
@fa "نمایش درصد"
pub show_percent: bool = true
@en "show_count"
@fa "نمایش شمار"
pub show_count: bool = false
@en "show_eta"
@fa "نمایش زمان باقیمانده"
pub show_eta: bool = false
@en "hide_cursor"
@fa "پنهان‌سازی مکان‌نما"
pub hide_cursor: bool = true
@en "start_ms"
@fa "زمان شروع"
pub start_ms: i64 = 0
@en "drawn"
@fa "کشیده شده"
pub drawn: bool = false
@en "done"
@fa "تمام شده"
pub done: bool = false
end
@en "Spinner"
@fa "چرخنده"
pub struct Spinner:
@en "frames"
@fa "قاب‌ها"
pub frames: Vector<str> = Vector {}
@en "idx"
@fa "شماره قاب"
pub idx: int = 0
@en "label"
@fa "برچسب"
pub label: str = ""
@en "color"
@fa "رنگ"
pub color: int = 0
@en "drawn"
@fa "کشیده شده"
pub drawn: bool = false
end
func _unicode_ok(): bool:
if str.Contains(_env("LC_ALL"), "UTF-8") or str.Contains(_env("LC_ALL"), "utf8"): ret true end
if str.Contains(_env("LC_CTYPE"), "UTF-8") or str.Contains(_env("LC_CTYPE"), "utf8"): ret true end
if str.Contains(_env("LANG"), "UTF-8") or str.Contains(_env("LANG"), "utf8"): ret true end
ret false
end
func _two(n: i64): str:
if n < 10: ret "0" + str.FromInt(n) end
ret str.FromInt(n)
end
func _unit_name(u: int): str:
if u == _UNIT_KB: ret "KB" end
if u == _UNIT_MB: ret "MB" end
if u == _UNIT_GB: ret "GB" end
if u == _UNIT_TB: ret "TB" end
ret "PB"
end
func _digits(n: int): int:
mut v := n
if v < 0: v = 0 - v end
mut d := 1
until v >= 10:
v /= 10
d++
end
ret d
end
func _bar_cells(b &: Bar): int:
if b.width > 0: ret b.width end
mut avail := Cols() - Width(b.label) - 4
if b.show_percent: avail -= 5 end
if b.show_count: avail -= 2 * _digits(b.total) + 2 end
if b.show_eta: avail -= 12 end
if avail < 8: ret 8 end
if avail > 80: ret 80 end
ret avail
end
func _bar_pct(b &: Bar): int:
if b.total <= 0: ret 0 end
mut p := (b.current * 100) / b.total
if p < 0: p = 0 end
if p > 100: p = 100 end
ret p
end
func _bar_eta(b &: Bar): str:
if b.current <= 0 or b.total <= 0: ret "--" end
if b.current >= b.total: ret "0s" end
elapsed := time.MonoMillis() - b.start_ms
if elapsed <= 0: ret "--" end
left := (b.total - b.current) as i64
ret FormatDuration((elapsed * left) / (b.current as i64))
end
@en "FormatDuration"
@fa "قالب‌بندی مدت"
pub func FormatDuration(ms: i64): str:
if ms <= 0: ret "0s" end
secs := ms / 1000
if secs < 10:
ret str.FromInt(secs) + "." + str.FromInt((ms % 1000) / 100) + "s"
end
if secs < 60: ret str.FromInt(secs) + "s" end
mins := secs / 60
if mins < 60: ret str.FromInt(mins) + "m " + _two(secs % 60) + "s" end
hours := mins / 60
ret str.FromInt(hours) + "h " + _two(mins % 60) + "m"
end
@en "FormatBytes"
@fa "قالب‌بندی بایت"
pub func FormatBytes(n: i64): str:
if n < 0: ret "0 B" end
if n < 1024: ret str.FromInt(n) + " B" end
mut v := n
mut unit := 0
until v >= 1024 * 1024 and unit < 4:
v /= 1024
unit++
end
unit++
ret str.FromInt(v / 1024) + "." + str.FromInt(((v % 1024) * 10) / 1024) + " " + _unit_name(unit)
end
@en "NewBar"
@fa "نوار جدید"
pub func NewBar(total: int, label: str): Bar:
mut b := Bar { total = total, label = label, start_ms = time.MonoMillis() }
if _unicode_ok():
b.fill = "█"
b.empty = "░"
end
ret b
end
@en "BarRender"
@fa "ترسیم نوار"
pub func BarRender(b &: Bar): str:
cells := _bar_cells(b)
mut filled := 0
if b.total > 0: filled = (cells * b.current) / b.total end
if filled < 0: filled = 0 end
if filled > cells: filled = cells end
rest := cells - filled
mut body := ""
if b.head.len() > 0 and filled > 0 and rest > 0:
body = str.Repeat(b.fill, filled - 1) + b.head
else:
body = str.Repeat(b.fill, filled)
end
if b.color != 0: body = Paint(body, Sgr(b.color)) end
body += str.Repeat(b.empty, rest)
mut out := str.NewBuilder()
defer str.BufFree(out)
if b.label.len() > 0:
str.BufAppend(out, b.label)
str.BufAppend(out, " ")
end
str.BufAppend(out, "[")
str.BufAppend(out, body)
str.BufAppend(out, "]")
if b.show_percent:
str.BufAppend(out, " ")
str.BufAppend(out, PadLeft(str.FromInt(_bar_pct(b) as i64) + "%", 4))
end
if b.show_count:
str.BufAppend(out, " ")
str.BufAppend(out, str.FromInt(b.current as i64))
str.BufAppend(out, "/")
str.BufAppend(out, str.FromInt(b.total as i64))
end
if b.show_eta:
str.BufAppend(out, " eta ")
str.BufAppend(out, _bar_eta(b))
end
line := str.BufStr(out)
ret line
end
@en "BarDraw"
@fa "کشیدن نوار"
pub func BarDraw(b &: Bar):
if not IsTerminal(): ret end
if b.hide_cursor and not b.drawn: Write(SeqHideCursor()) end
b.drawn = true
Emit(SeqResetLine() + BarRender(b))
end
@en "BarSet"
@fa "تنظیم نوار"
pub func BarSet(b &: Bar, n: int):
b.current = n
if b.current < 0: b.current = 0 end
if b.current > b.total: b.current = b.total end
BarDraw(b)
end
@en "BarAdd"
@fa "افزودن به نوار"
pub func BarAdd(b &: Bar, delta: int): BarSet(b, b.current + delta) end
@en "BarFinish"
@fa "پایان نوار"
pub func BarFinish(b &: Bar):
b.current = b.total
b.done = true
if IsTerminal():
Write(SeqResetLine())
Write(BarRender(b))
if b.hide_cursor and b.drawn: Write(SeqShowCursor()) end
else:
Write(Strip(BarRender(b)))
end
Write("\n")
Flush()
end
@en "NewSpinner"
@fa "چرخنده جدید"
pub func NewSpinner(label: str): Spinner:
mut s := Spinner { label = label }
if _unicode_ok():
each f in ["⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏"]:
s.frames.push(f)
end
else:
each f in ["|", "/", "-", "\\"]:
s.frames.push(f)
end
end
ret s
end
@en "NewSpinnerFrames"
@fa "چرخنده با قاب‌ها"
pub func NewSpinnerFrames(label: str, frames: Vector<str>): Spinner:
mut s := Spinner { label = label }
each f in frames:
s.frames.push(f)
end
ret s
end
@en "SpinnerFrame"
@fa "قاب چرخنده"
pub func SpinnerFrame(s &: Spinner): str:
n := s.frames.len()
if n == 0: ret "" end
ret s.frames.get(s.idx % n)
end
@en "SpinnerTick"
@fa "تیک چرخنده"
pub func SpinnerTick(s &: Spinner):
if s.frames.len() == 0: ret end
if IsTerminal():
mut frame := SpinnerFrame(s)
if s.color != 0: frame = Paint(frame, Sgr(s.color)) end
s.drawn = true
mut line := SeqResetLine() + frame
if s.label.len() > 0: line = line + " " + s.label end
Emit(line)
end
s.idx++
if s.idx >= s.frames.len(): s.idx = 0 end
end
@en "SpinnerStop"
@fa "توقف چرخنده"
pub func SpinnerStop(s &: Spinner, final: str):
if IsTerminal() and s.drawn:
Write(SeqResetLine())
end
if final.len() > 0:
if IsTerminal():
Write(final)
else:
Write(Strip(final))
end
Write("\n")
end
s.drawn = false
Flush()
end
@en "SpinnerFree"
@fa "آزادسازی چرخنده"
pub func SpinnerFree(s &: Spinner):
s.frames.free()
end
@en "testing"
@fa "آزمایش"
package testing
import conv
import os
import str
mut _tpass := 0
mut _tfail := 0
mut _tformat := 0
mut _tname := ""
mut _tfile := ""
mut _tfail_at := 0
mut _tlast := ""
mut _tcount := 0
mut _tbad := 0
mut _tfilter := ""
func record(cond: bool, msg: str):
if cond:
_tpass++
else:
_tfail++
_tlast = msg
printerr "FAIL: "
printerrln msg
end
end
func tc_escape(s: str): str:
mut out := str.Replace(s, "|", "||")
out = str.Replace(out, "'", "|'")
out = str.Replace(out, "\n", "|n")
out = str.Replace(out, "\r", "|r")
out = str.Replace(out, "[", "|[")
ret str.Replace(out, "]", "|]")
end
func fail_pair(label: str, got: str, want: str):
_tfail++
_tlast = label + got + " want " + want
printerr "FAIL: "
printerr label
printerr got
printerr " want "
printerrln want
end
@en "Assert"
@fa "ادعا"
pub func Assert(cond: bool): record(cond, "assertion failed") end
@en "AssertMsg"
@fa "ادعا با پیام"
pub func AssertMsg(cond: bool, msg: str): record(cond, msg) end
@en "AssertTrue"
@fa "ادعای درستی"
pub func AssertTrue(cond: bool): record(cond, "expected true") end
@en "AssertFalse"
@fa "ادعای نادرستی"
pub func AssertFalse(cond: bool): record(cond == false, "expected false") end
@en "AssertEqInt"
@fa "ادعای برابری عدد"
pub func AssertEqInt(got: int, want: int):
if got == want:
_tpass++
ret
end
fail_pair("ints differ: got ", conv.FormatInt(got as i64), conv.FormatInt(want as i64))
end
@en "AssertEqInt64"
@fa "ادعای برابری عدد۶۴"
pub func AssertEqInt64(got: i64, want: i64):
if got == want:
_tpass++
ret
end
fail_pair("ints differ: got ", conv.FormatInt(got), conv.FormatInt(want))
end
@en "AssertEqFloat"
@fa "ادعای برابری اعشار"
pub func AssertEqFloat(got: f64, want: f64, eps: f64):
mut diff := got - want
if diff < 0.0: diff = 0.0 - diff end
if diff <= eps:
_tpass++
ret
end
fail_pair("floats differ: got ", conv.FormatFloat(got), conv.FormatFloat(want))
end
@en "AssertContains"
@fa "ادعای شامل بودن"
pub func AssertContains(hay: str, needle: str):
if hay.find(needle) >= 0:
_tpass++
ret
end
fail_pair("string does not contain: got ", hay, needle)
end
@en "AssertEqStr"
@fa "ادعای برابری رشته"
pub func AssertEqStr(got: str, want: str):
if got == want:
_tpass++
ret
end
fail_pair("strings differ: got ", got, want)
end
@en "AssertEqBool"
@fa "ادعای برابری منطقی"
pub func AssertEqBool(got: bool, want: bool):
record(got == want, "bools differ")
end
@en "AssertNeInt"
@fa "ادعای نابرابری عدد"
pub func AssertNeInt(a: int, b: int):
record(a != b, "ints unexpectedly equal")
end
@en "AssertNeStr"
@fa "ادعای نابرابری رشته"
pub func AssertNeStr(a: str, b: str):
record((a == b) == false, "strings unexpectedly equal")
end
@en "AssertNil"
@fa "ادعای خالی بودن"
pub func AssertNil(p: void*): record(p == null, "expected nil") end
@en "AssertNotNil"
@fa "ادعای خالی نبودن"
pub func AssertNotNil(p: void*): record((p == null) == false, "expected non-nil") end
@en "Reset"
@fa "بازنشانی"
pub func Reset():
_tpass = 0
_tfail = 0
end
@en "Passed"
@fa "موفق"
pub func Passed(): int: ret _tpass end
@en "Failed"
@fa "ناموفق"
pub func Failed(): int: ret _tfail end
@en "Summary"
@fa "خلاصه"
pub func Summary(): int:
println "--"
print "tests: "
print _tpass
print " passed, "
print _tfail
println " failed"
ret _tfail
end
@en "SetFormat"
@fa "قالب گزارش"
pub func SetFormat(format: str):
_tformat = format == "teamcity" ? 1 : 0
end
@en "SetFilter"
@fa "پالایه آزمون"
pub func SetFilter(part: str):
_tfilter = part
end
@en "Selected"
@fa "انتخاب شده"
pub func Selected(name: str): bool:
if str.Len(_tfilter) == 0:
ret true
end
mut f := _tfilter
at_start := str.StartsWith(f, "^")
if at_start:
f = f.substr(1, str.Len(f) - 1)
end
at_end := str.EndsWith(f, "$")
if at_end:
f = f.substr(0, str.Len(f) - 1)
end
if at_start and at_end:
ret str.Equals(name, f)
else at_start:
ret str.StartsWith(name, f)
else at_end:
ret str.EndsWith(name, f)
end
ret str.Contains(name, f)
end
@en "SuiteStart"
@fa "شروع مجموعه"
pub func SuiteStart(file: str):
_tfile = file
_tcount = 0
_tbad = 0
if _tformat == 1:
println "##teamcity[testSuiteStarted name='" + tc_escape(file) + "' locationHint='salam://" + tc_escape(file) + "']"
end
end
@en "Begin"
@fa "شروع آزمون"
pub func Begin(name: str, line: int):
_tname = name
_tfail_at = _tfail
_tlast = ""
if _tformat == 1:
println "##teamcity[testStarted name='" + tc_escape(name) + "' locationHint='salam://" + tc_escape(_tfile) + ":" + conv.FormatInt(line as i64) + "' captureStandardOutput='true']"
else:
println "=== RUN   " + name
end
end
@en "End"
@fa "اتمام آزمون"
pub func End():
_tcount++
failed := _tfail > _tfail_at
if failed:
_tbad++
end
if _tformat == 1:
if failed:
println "##teamcity[testFailed name='" + tc_escape(_tname) + "' message='" + tc_escape(_tlast) + "']"
end
println "##teamcity[testFinished name='" + tc_escape(_tname) + "']"
else:
verdict := failed ? "--- FAIL: " : "--- PASS: "
println verdict + _tname
end
end
@en "Finish"
@fa "جمع‌بندی آزمون‌ها"
pub func Finish():
if _tformat == 1:
println "##teamcity[testSuiteFinished name='" + tc_escape(_tfile) + "']"
else:
if _tbad > 0:
println "FAIL " + _tfile + ": " + conv.FormatInt(_tbad as i64) + " of " + conv.FormatInt(_tcount as i64) + " tests failed"
else:
println "ok   " + _tfile + ": " + conv.FormatInt(_tcount as i64) + " tests passed"
end
end
if _tbad > 0:
os.Exit(1)
end
end
@en "diff"
@fa "تفاوت"
package diff
import str
const MAX_EDIT_DISTANCE := 3000
@en "Equal"
@fa "همسان"
pub const Equal := 0
@en "Replace"
@fa "جایگزین"
pub const Replace := 1
@en "Delete"
@fa "حذف شده"
pub const Delete := 2
@en "Insert"
@fa "افزوده"
pub const Insert := 3
@en "Opcode"
@fa "دستور ویرایش"
pub struct Opcode:
@en "tag"
@fa "نوع"
pub tag: int = 0
@en "a_start"
@fa "آغاز الف"
pub a_start: int = 0
@en "a_stop"
@fa "انتهای الف"
pub a_stop: int = 0
@en "b_start"
@fa "آغاز ب"
pub b_start: int = 0
@en "b_stop"
@fa "انتهای ب"
pub b_stop: int = 0
end
func _intern(a: Vector<str>, b: Vector<str>, ai &: Vector<int>, bi &: Vector<int>):
mut ids := HashMap {} as HashMap<str, int>
defer ids.free()
repeat a.len() in i:
s := a.get(i)
if not ids.has(s):
ids.put(s, ids.size())
end
ai.push(ids.get(s))
end
repeat b.len() in i:
s := b.get(i)
if not ids.has(s):
ids.put(s, ids.size())
end
bi.push(ids.get(s))
end
end
func _middle(a: Vector<int>, b: Vector<int>, lo_a: int, hi_a: int, lo_b: int, hi_b: int, steps &: Vector<int>):
n := hi_a - lo_a
m := hi_b - lo_b
if n == 0:
repeat m:
steps.push(3)
end
ret
end
if m == 0:
repeat n:
steps.push(2)
end
ret
end
mut limit := n + m
if limit > MAX_EDIT_DISTANCE:
limit = MAX_EDIT_DISTANCE
end
width := 2 * limit + 3
mut v := Vector {} as Vector<int>
defer v.free()
repeat width:
v.push(0)
end
mut trace := Vector {} as Vector<int>
defer trace.free()
mut offsets := Vector {} as Vector<int>
defer offsets.free()
base := limit + 1
mut found := -1
mut d := 0
until d <= limit and found < 0:
mut k := 0 - d
until k <= d:
mut x := 0
if k == 0 - d or (k != d and v.get(base + k - 1) < v.get(base + k + 1)):
x = v.get(base + k + 1)
else:
x = v.get(base + k - 1) + 1
end
mut y := x - k
until x < n and y < m and a.get(lo_a + x) == b.get(lo_b + y):
x++
y++
end
v.set(base + k, x)
if x >= n and y >= m and found < 0:
found = d
end
k += 2
end
offsets.push(trace.len())
mut kk := 0 - d
until kk <= d:
trace.push(v.get(base + kk))
kk++
end
d++
end
if found < 0:
repeat n:
steps.push(2)
end
repeat m:
steps.push(3)
end
ret
end
mut rev := Vector {} as Vector<int>
defer rev.free()
mut x := n
mut y := m
mut r := found
until r > 0:
k := x - y
prev := r - 1
off := offsets.get(prev)
mut pk := 0
if k == 0 - r or (k != r and trace.get(off + (k - 1) + prev) < trace.get(off + (k + 1) + prev)):
pk = k + 1
else:
pk = k - 1
end
px := trace.get(off + pk + prev)
py := px - pk
until x > px and y > py:
rev.push(1)
x--
y--
end
if x == px:
rev.push(3)
else:
rev.push(2)
end
x = px
y = py
r--
end
until x > 0 and y > 0:
rev.push(1)
x--
y--
end
repeat rev.len() in i:
steps.push(rev.get(rev.len() - 1 - i))
end
end
func _steps(a: Vector<str>, b: Vector<str>): Vector<int>:
mut ai := Vector {} as Vector<int>
defer ai.free()
mut bi := Vector {} as Vector<int>
defer bi.free()
_intern(a, b, ai, bi)
mut steps := Vector {} as Vector<int>
mut lo := 0
until lo < ai.len() and lo < bi.len() and ai.get(lo) == bi.get(lo):
steps.push(1)
lo++
end
mut ha := ai.len()
mut hb := bi.len()
until ha > lo and hb > lo and ai.get(ha - 1) == bi.get(hb - 1):
ha--
hb--
end
_middle(ai, bi, lo, ha, lo, hb, steps)
mut t := ai.len() - 1
until t >= ha:
steps.push(1)
t--
end
ret steps
end
func _range(start: int, stop: int): str:
mut begin := start + 1
length := stop - start
if length == 1:
ret str.FromInt(begin as i64)
end
if length == 0:
begin--
end
ret str.FromInt(begin as i64) + "," + str.FromInt(length as i64)
end
@en "Opcodes"
@fa "دستورهای ویرایش"
pub func Opcodes(a: Vector<str>, b: Vector<str>): Vector<Opcode>:
steps := _steps(a, b)
defer steps.free()
mut out := Vector {} as Vector<Opcode>
mut i := 0
mut j := 0
mut s := 0
until s < steps.len():
if steps.get(s) == 1:
mut e := s
until e < steps.len() and steps.get(e) == 1:
e++
end
out.push(Opcode { tag = 0, a_start = i, a_stop = i + (e - s), b_start = j, b_stop = j + (e - s) })
i += e - s
j += e - s
s = e
else:
mut e := s
mut dels := 0
mut ins := 0
until e < steps.len() and steps.get(e) != 1:
if steps.get(e) == 2:
dels++
else:
ins++
end
e++
end
mut tag := 1
if ins == 0:
tag = 2
else ins > 0 and dels == 0:
tag = 3
end
out.push(Opcode { tag = tag, a_start = i, a_stop = i + dels, b_start = j, b_stop = j + ins })
i += dels
j += ins
s = e
end
end
ret out
end
@en "GroupedOpcodes"
@fa "دستورهای ویرایش گروه بندی شده"
pub func GroupedOpcodes(a: Vector<str>, b: Vector<str>, context: int): Vector<Vector<Opcode>>:
mut codes := Opcodes(a, b)
defer codes.free()
mut out := Vector {} as Vector<Vector<Opcode>>
mut n := context
if n < 0:
n = 0
end
if codes.len() == 0:
codes.push(Opcode { tag = 0, a_start = 0, a_stop = 1, b_start = 0, b_stop = 1 })
end
first := codes.get(0)
if first.tag == 0:
codes.set(0, Opcode { tag = 0, a_start = first.a_stop - n > first.a_start ? first.a_stop - n : first.a_start, a_stop = first.a_stop, b_start = first.b_stop - n > first.b_start ? first.b_stop - n : first.b_start, b_stop = first.b_stop })
end
last_at := codes.len() - 1
last := codes.get(last_at)
if last.tag == 0:
codes.set(last_at, Opcode { tag = 0, a_start = last.a_start, a_stop = last.a_stop < last.a_start + n ? last.a_stop : last.a_start + n, b_start = last.b_start, b_stop = last.b_stop < last.b_start + n ? last.b_stop : last.b_start + n })
end
mut group := Vector {} as Vector<Opcode>
repeat codes.len() in c:
mut op := codes.get(c)
if op.tag == 0 and op.a_stop - op.a_start > 2 * n:
group.push(Opcode { tag = 0, a_start = op.a_start, a_stop = op.a_stop < op.a_start + n ? op.a_stop : op.a_start + n, b_start = op.b_start, b_stop = op.b_stop < op.b_start + n ? op.b_stop : op.b_start + n })
out.push(group)
group = Vector {} as Vector<Opcode>
op = Opcode { tag = 0, a_start = op.a_start > op.a_stop - n ? op.a_start : op.a_stop - n, a_stop = op.a_stop, b_start = op.b_start > op.b_stop - n ? op.b_start : op.b_stop - n, b_stop = op.b_stop }
end
group.push(op)
end
if group.len() > 0 and not (group.len() == 1 and group.get(0).tag == 0):
out.push(group)
else:
group.free()
end
ret out
end
@en "Unified"
@fa "تفاوت یکپارچه"
pub func Unified(a: Vector<str>, b: Vector<str>, from_name: str, to_name: str, context: int): Vector<str>:
mut out := Vector {} as Vector<str>
mut groups := GroupedOpcodes(a, b, context)
repeat groups.len() in g:
group := groups.get(g)
if g == 0:
out.push("--- " + from_name)
out.push("+++ " + to_name)
end
first := group.get(0)
last := group.get(group.len() - 1)
out.push("@@ -" + _range(first.a_start, last.a_stop) + " +" + _range(first.b_start, last.b_stop) + " @@")
repeat group.len() in c:
op := group.get(c)
if op.tag == 0:
repeat op.a_stop - op.a_start in i:
out.push(" " + a.get(op.a_start + i))
end
else:
if op.tag == 1 or op.tag == 2:
repeat op.a_stop - op.a_start in i:
out.push("-" + a.get(op.a_start + i))
end
end
if op.tag == 1 or op.tag == 3:
repeat op.b_stop - op.b_start in i:
out.push("+" + b.get(op.b_start + i))
end
end
end
end
group.free()
end
groups.free()
ret out
end
@en "Lines"
@fa "خط ها"
pub func Lines(text: str): Vector<str>:
mut out := Vector {} as Vector<str>
if text.len() == 0:
ret out
end
parts := str.Split(text, "\n")
defer parts.free()
mut n := parts.len()
if parts.get(n - 1).len() == 0:
n--
end
repeat n in i:
out.push(str.TrimSuffix(parts.get(i), "\r"))
end
ret out
end
@en "UnifiedText"
@fa "تفاوت یکپارچه متن"
pub func UnifiedText(a: str, b: str, from_name: str, to_name: str, context: int): str:
la := Lines(a)
defer la.free()
lb := Lines(b)
defer lb.free()
lines := Unified(la, lb, from_name, to_name, context)
defer lines.free()
if lines.len() == 0:
ret ""
end
ret str.Join(lines, "\n") + "\n"
end
@en "Ratio"
@fa "نسبت شباهت"
pub func Ratio(a: Vector<str>, b: Vector<str>): f64:
total := a.len() + b.len()
if total == 0:
ret 1.0
end
steps := _steps(a, b)
defer steps.free()
mut same := 0
repeat steps.len() in i:
if steps.get(i) == 1:
same++
end
end
ret 2.0 * (same as f64) / (total as f64)
end
@en "RatioText"
@fa "نسبت شباهت متن"
pub func RatioText(a: str, b: str): f64:
ca := str.Chars(a)
defer ca.free()
cb := str.Chars(b)
defer cb.free()
ret Ratio(ca, cb)
end
@en "text"
@fa "متن"
package text
import mem
import str
import conv.numfmt
extern:
func malloc(size: u64): void*
end
inline pure func _strptr(s: str): i64:
v := s as void*
ret v as i64
end
if not SALAM_KERNEL:
export:
func salam_fmt_f64(v: f64): str:
t := numfmt.FormatFloat(v)
n := t.len() as u64
r := malloc(n + (1 as u64))
if r == null:
mem.OutOfMemory()
end
mem.Copy(r, t as void*, n + (1 as u64))
mem.Free(t as void*)
ret r as str
end
end
end
export:
func salam_str_repeat(s: str, n: int): str:
slen := s.len() as i64
if n <= 1 or slen == 0:
if n == 1: ret s end
r := mem.MustAllocateZeroed(1 as u64)
ret r as str
end
total := slen * (n as i64)
r := mem.MustAllocateZeroed((total + 1) as u64)
mem.Copy(r, s as void*, slen as u64)
mut filled := slen
until filled < total:
mut chunk := filled
if chunk > total - filled: chunk = total - filled end
mem.Copy(((r as i64) + filled) as void*, r, chunk as u64)
filled += chunk
end
ret r as str
end
func salam_str_upper(s: str): str:
n := s.len()
bp := (s as void*) as i8*
r := mem.MustAllocateZeroed((n + 1) as u64)
rp := r as i8*
repeat n in i:
mut c := bp[i] as int
if c < 0: c += 256 end
if c >= 97 and c <= 122: c -= 32 end
rp[i] = c as i8
end
ret r as str
end
func salam_str_lower(s: str): str:
n := s.len()
bp := (s as void*) as i8*
r := mem.MustAllocateZeroed((n + 1) as u64)
rp := r as i8*
repeat n in i:
mut c := bp[i] as int
if c < 0: c += 256 end
if c >= 65 and c <= 90: c += 32 end
rp[i] = c as i8
end
ret r as str
end
end
inline pure func _is_ws(ch: int): bool:
ret ch == 32 or ch == 9 or ch == 10 or ch == 13
end
func _copy_range(s: str, start: int, ln: int): i64:
r := mem.MustAllocateZeroed((ln + 1) as u64)
mem.Copy(r, (_strptr(s) + (start as i64)) as void*, ln as u64)
ret r as i64
end
func _find_from(s: str, sub: str, from: int): int:
tail := ((_strptr(s) + (from as i64)) as void*) as str
idx := tail.find(sub)
if idx < 0: ret 0 - 1 end
ret from + idx
end
export:
func salam_str_trim(s: str): str:
bp := (s as void*) as i8*
slen := s.len()
mut a := 0
until a < slen and _is_ws(bp[a] as int):
a++
end
mut e := slen
until e > a and _is_ws(bp[e - 1] as int):
e--
end
ret (_copy_range(s, a, e - a) as void*) as str
end
end
export:
func salam_str_split(s: str, delim: str, out_count: void*): void*:
oc := out_count as int*
dl := delim.len()
n := s.len()
if dl == 0:
arr := mem.MustAllocate(sizeof(str) as u64) as str*
arr[0] = (_copy_range(s, 0, n) as void*) as str
oc[0] = 1
ret arr as void*
end
mut count := 1
mut idx := _find_from(s, delim, 0)
until idx >= 0:
count++
idx = _find_from(s, delim, idx + dl)
end
arr := mem.MustAllocate((count as u64) * (sizeof(str) as u64)) as str*
mut k := 0
mut off := 0
idx = _find_from(s, delim, 0)
until idx >= 0:
arr[k] = (_copy_range(s, off, idx - off) as void*) as str
k++
off = idx + dl
idx = _find_from(s, delim, off)
end
arr[k] = (_copy_range(s, off, n - off) as void*) as str
oc[0] = count
ret arr as void*
end
end
package text
inline pure func _seq_len(b0: int): int:
if b0 >= 240: ret 4
else b0 >= 224: ret 3
else b0 >= 192: ret 2
else:
ret 1
end
end
inline pure func _ub(bp: i8*, i: int): int:
mut v := bp[i] as int
if v < 0: v += 256 end
ret v
end
pure func _decode(bp: i8*, i: int, char_len: int): int:
b0 := _ub(bp, i)
if char_len == 1: ret b0
else char_len == 2:
ret (b0 - 192) * 64 + (_ub(bp, i + 1) - 128)
else char_len == 3:
ret (b0 - 224) * 4096 + (_ub(bp, i + 1) - 128) * 64 + (_ub(bp, i + 2) - 128)
else:
ret (b0 - 240) * 262144 + (_ub(bp, i + 1) - 128) * 4096 + (_ub(bp, i + 2) - 128) * 64 + (_ub(bp, i + 3) - 128)
end
end
inline pure func _unit(src: u16*, i: int): int:
mut u := src[i] as int
if u < 0: u += 65536 end
ret u
end
func _buf_cp(sb &: str.StringBuilder, cp: int):
if cp < 128:
str.BufAppendChar(sb, cp)
ret
end
if cp < 2048:
str.BufAppendChar(sb, 192 + cp / 64)
str.BufAppendChar(sb, 128 + cp % 64)
ret
end
if cp < 65536:
str.BufAppendChar(sb, 224 + cp / 4096)
str.BufAppendChar(sb, 128 + (cp / 64) % 64)
str.BufAppendChar(sb, 128 + cp % 64)
ret
end
str.BufAppendChar(sb, 240 + cp / 262144)
str.BufAppendChar(sb, 128 + (cp / 4096) % 64)
str.BufAppendChar(sb, 128 + (cp / 64) % 64)
str.BufAppendChar(sb, 128 + cp % 64)
end
@en "Utf16Len"
@fa "طول یوتف شانزده"
pub pure func Utf16Len(s: str): int:
n := s.len()
bp := (s as void*) as i8*
mut i := 0
mut units := 0
until i < n:
mut char_len := _seq_len(_ub(bp, i))
if i + char_len > n: char_len = n - i end
cp := _decode(bp, i, char_len)
if cp > 65535:
units += 2
else:
units++
end
i += char_len
end
ret units
end
@en "ToUtf16"
@fa "به یوتف شانزده"
pub func ToUtf16(s: str): void*:
units := Utf16Len(s)
buf := mem.MustAllocateZeroed(((units + 1) * 2) as u64)
w := buf as u16*
bp := (s as void*) as i8*
n := s.len()
mut i := 0
mut k := 0
until i < n:
mut char_len := _seq_len(_ub(bp, i))
if i + char_len > n: char_len = n - i end
cp := _decode(bp, i, char_len)
if cp > 65535:
c := cp - 65536
w[k] = (55296 + c / 1024) as u16
k++
w[k] = (56320 + c % 1024) as u16
k++
else:
w[k] = cp as u16
k++
end
i += char_len
end
ret buf
end
@en "Utf16UnitAt"
@fa "واحد یوتف شانزده"
pub inline pure func Utf16UnitAt(w: void*, i: int): int:
ret _unit(w as u16*, i)
end
@en "FromUtf16"
@fa "از یوتف شانزده"
pub func FromUtf16(w: void*): str:
if w == null: ret "" end
src := w as u16*
mut sb := str.NewBuilder()
defer str.BufFree(sb)
mut i := 0
mut u := _unit(src, i)
until u != 0:
mut cp := u
if u >= 55296 and u < 56320:
lo := _unit(src, i + 1)
if lo >= 56320 and lo < 57344:
cp = 65536 + (u - 55296) * 1024 + (lo - 56320)
i++
end
end
_buf_cp(sb, cp)
i++
u = _unit(src, i)
end
out := str.BufStr(sb)
ret out
end
@en "thread"
@fa "نخ"
package thread
import mem
if SALAM_OS_UNIX:
if not defined(SALAM_CC_TCC):
link dynamic "pthread"
end
end
if SALAM_OS_WINDOWS:
extern:
func _beginthreadex(sec: void*, stack: u32, start: void*, arg: void*, flags: u32, thrdaddr: void*): u64
func WaitForSingleObject(handle: void*, milliseconds: int): int
func CloseHandle(handle: void*): int
end
else:
extern:
func pthread_create(thread: void*, attr: void*, start: void*, arg: void*): int
func pthread_join(thread: void*, retval: void*): int
func pthread_attr_init(attr: void*): int
func pthread_attr_setstacksize(attr: void*, size: usize): int
func pthread_attr_destroy(attr: void*): int
end
end
mut tcells := mem.MustAllocateZeroed(8 as u64) as i64*
mut tlimit := mem.MustAllocateZeroed(8 as u64) as i64*
@en "Thread"
@fa "نخ"
pub struct Thread:
@en "handle"
@fa "دسته"
pub handle: i64 = 0
end
if SALAM_OS_WINDOWS:
export:
func salam_thread_spawn(fn: void*): i64:
ret salam_thread_spawn_arg(fn, null)
end
func raw_spawn_arg(fn: void*, arg: void*): i64:
if fn == null: ret 0 end
ret _beginthreadex(null, 0 as u32, fn, arg, 0 as u32, null) as i64
end
func raw_spawn_stack(fn: void*, arg: void*, stack: u64): i64:
if fn == null: ret 0 end
ret _beginthreadex(null, stack as u32, fn, arg, 0x10000 as u32, null) as i64
end
func raw_join(h: i64):
if h == 0: ret end
WaitForSingleObject(h as void*, 0 - 1)
CloseHandle(h as void*)
end
end
else:
export:
func salam_thread_spawn(fn: void*): i64:
ret salam_thread_spawn_arg(fn, null)
end
func raw_spawn_arg(fn: void*, arg: void*): i64:
if fn == null: ret 0 end
t := mem.MustAllocateZeroed(8 as u64)
if pthread_create(t, null, fn, arg) != 0:
mem.Free(t)
ret 0
end
ret t as i64
end
func raw_spawn_stack(fn: void*, arg: void*, stack: u64): i64:
if fn == null: ret 0 end
t := mem.MustAllocateZeroed(8 as u64)
attr := mem.MustAllocateZeroed(256 as u64)
if pthread_attr_init(attr) != 0:
mem.Free(attr)
mem.Free(t)
ret 0
end
if stack > (0 as u64) and pthread_attr_setstacksize(attr, stack as usize) != 0:
pthread_attr_destroy(attr)
mem.Free(attr)
mem.Free(t)
ret 0
end
rc := pthread_create(t, attr, fn, arg)
pthread_attr_destroy(attr)
mem.Free(attr)
if rc != 0:
mem.Free(t)
ret 0
end
ret t as i64
end
func raw_join(h: i64):
if h == 0: ret end
tp := (h as void*) as i64*
pthread_join(tp[0] as void*, null)
mem.Free(h as void*)
end
end
end
func slot_take(): bool:
lim := atomic_load(tlimit)
if lim > 0 as i64 and atomic_load(tcells) >= lim:
ret false
end
atomic_add(tcells, 1 as i64)
ret true
end
export:
func salam_thread_spawn_arg(fn: void*, arg: void*): i64:
if not slot_take(): ret 0 end
h := raw_spawn_arg(fn, arg)
if h == 0: atomic_add(tcells, 0 as i64 - 1) end
ret h
end
func salam_thread_spawn_stack(fn: void*, arg: void*, stack: u64): i64:
if not slot_take(): ret 0 end
h := raw_spawn_stack(fn, arg, stack)
if h == 0: atomic_add(tcells, 0 as i64 - 1) end
ret h
end
func salam_thread_join(h: i64):
if h == 0: ret end
raw_join(h)
atomic_add(tcells, 0 as i64 - 1)
end
end
@en "New"
@fa "جدید"
pub func New(h: i64): Thread:
ret Thread { handle = h }
end
@en "SpawnStack"
@fa "اجرا با پشته"
pub func SpawnStack(fn: i64, arg: void*, stack: u64): Thread:
ret Thread { handle = salam_thread_spawn_stack(fn as void*, arg, stack) }
end
@en "Join"
@fa "پیوستن"
pub func Join(t: Thread):
join(t.handle)
end
@en "JoinAll"
@fa "پیوستن به همه"
pub func JoinAll(threads: Vector<Thread>):
repeat threads.len() in i:
join(threads.get(i).handle)
end
end
@en "Valid"
@fa "معتبر"
pub func Valid(t: Thread): bool:
ret t.handle != 0
end
@en "Handle"
@fa "دسته"
pub func Handle(t: Thread): i64:
ret t.handle
end
@en "Collect"
@fa "جمع آوری"
pub func Collect(threads: Vector<Thread>, h: i64): Vector<Thread>:
threads.push(Thread { handle = h })
ret threads
end
@en "SetLimit"
@fa "تعیین سقف"
pub func SetLimit(n: i64):
atomic_store(tlimit, n)
end
@en "Live"
@fa "نخ‌های زنده"
pub func Live(): i64:
ret atomic_load(tcells)
end
package time
import conv
const _NS_PER_US := 1000 as i64
const _NS_PER_MS := 1000000 as i64
const _NS_PER_SEC := 1000000000 as i64
const _NS_PER_MIN := 60000000000 as i64
const _NS_PER_HOUR := 3600000000000 as i64
const _NS_PER_DAY := 86400000000000 as i64
const _I64_MAX := 9223372036854775807 as i64
const _I64_MIN := 0 - 9223372036854775807 - 1
@en "Duration"
@fa "مدت"
pub struct Duration:
@en "ns"
@fa "نانوثانیه خام"
pub ns: i64 = 0
@en "nanos"
@fa "نانوثانیه"
pub func nanos(): i64: ret this.ns end
@en "micros"
@fa "میکروثانیه"
pub func micros(): i64: ret this.ns / _NS_PER_US end
@en "millis"
@fa "میلی‌ثانیه"
pub func millis(): i64: ret this.ns / _NS_PER_MS end
@en "secs"
@fa "ثانیه‌های کامل"
pub func secs(): i64: ret this.ns / _NS_PER_SEC end
@en "seconds"
@fa "ثانیه"
pub func seconds(): f64: ret (this.ns as f64) / 1000000000.0 end
@en "minutes"
@fa "دقیقه"
pub func minutes(): f64: ret (this.ns as f64) / 60000000000.0 end
@en "hours"
@fa "ساعت"
pub func hours(): f64: ret (this.ns as f64) / 3600000000000.0 end
@en "days"
@fa "روز"
pub func days(): f64: ret (this.ns as f64) / 86400000000000.0 end
@en "add"
@fa "جمع"
pub func add(o: Duration): Duration: ret Duration { ns = this.ns + o.ns } end
@en "sub"
@fa "تفریق"
pub func sub(o: Duration): Duration: ret Duration { ns = this.ns - o.ns } end
@en "mul"
@fa "ضرب"
pub func mul(k: i64): Duration: ret Duration { ns = this.ns * k } end
@en "div"
@fa "تقسیم"
pub func div(k: i64): Duration:
if k == 0: ret Duration { ns = 0 } end
ret Duration { ns = this.ns / k }
end
@en "ratio"
@fa "نسبت"
pub func ratio(o: Duration): i64:
if o.ns == 0: ret 0 end
ret this.ns / o.ns
end
@en "neg"
@fa "منفی"
pub func neg(): Duration:
if this.ns == _I64_MIN: ret Duration { ns = _I64_MAX } end
ret Duration { ns = 0 - this.ns }
end
@en "abs"
@fa "قدرمطلق"
pub func abs(): Duration:
if this.ns == _I64_MIN: ret Duration { ns = _I64_MAX } end
if this.ns < 0: ret Duration { ns = 0 - this.ns } end
ret Duration { ns = this.ns }
end
@en "is_zero"
@fa "صفر است"
pub func is_zero(): bool: ret this.ns == 0 end
@en "is_negative"
@fa "منفی است"
pub func is_negative(): bool: ret this.ns < 0 end
@en "cmp"
@fa "مقایسه"
pub func cmp(o: Duration): int:
if this.ns < o.ns: ret 0 - 1 end
if this.ns > o.ns: ret 1 end
ret 0
end
@en "less"
@fa "کمتر"
pub func less(o: Duration): bool: ret this.ns < o.ns end
@en "equals"
@fa "یکسان"
pub func equals(o: Duration): bool: ret this.ns == o.ns end
@en "truncate"
@fa "برش"
pub func truncate(m: Duration): Duration:
if m.ns <= 0: ret Duration { ns = this.ns } end
ret Duration { ns = this.ns - this.ns % m.ns }
end
@en "round"
@fa "گرد کردن"
pub func round(m: Duration): Duration:
if m.ns <= 0: ret Duration { ns = this.ns } end
r := this.ns % m.ns
down := this.ns - r
if r < 0:
nr := 0 - r
if nr >= m.ns - nr:
if down < _I64_MIN + m.ns: ret Duration { ns = down } end
ret Duration { ns = down - m.ns }
end
ret Duration { ns = down }
end
if r >= m.ns - r:
if down > _I64_MAX - m.ns: ret Duration { ns = down } end
ret Duration { ns = down + m.ns }
end
ret Duration { ns = down }
end
@en "to_str"
@fa "به رشته"
pub func to_str(): str: ret FormatDuration(Duration { ns = this.ns }) end
end
inline pure func _dbp(s: str): i8*: ret (s as void*) as i8* end
inline pure func _dub(bp: i8*, i: int): int:
mut v := bp[i] as int
if v < 0: v += 256 end
ret v
end
inline pure func _isDigitByte(c: int): bool: ret c >= 48 and c <= 57 end
func _fracStr(rem: i64, digits: int): str:
if rem == 0: ret "" end
mut s := conv.FormatInt(rem)
until s.len() < digits:
s = "0" + s
end
mut e := s.len()
until e > 0 and s.substr(e - 1, 1) == "0":
e--
end
ret "." + s.substr(0, e)
end
func _unitNanos(u: str): i64:
if u == "ns": ret 1 end
if u == "us": ret _NS_PER_US end
if u == "µs": ret _NS_PER_US end
if u == "μs": ret _NS_PER_US end
if u == "ms": ret _NS_PER_MS end
if u == "s": ret _NS_PER_SEC end
if u == "m": ret _NS_PER_MIN end
if u == "h": ret _NS_PER_HOUR end
if u == "d": ret _NS_PER_DAY end
ret 0
end
func _derr(s: str, kind: ErrorKind, code: str, message: str, offset: int): Error:
ret Error.At(kind, message, offset).locate(s).with_code(code).wrap("time")
end
func _dwant(s: str, n: int, i: int, what: str): Error:
if i >= n:
ret _derr(s, ErrorKind.UnexpectedEnd, "time.unexpected_end", "expected " + what + ", found the end of the text", i)
end
ret _derr(s, ErrorKind.Syntax, "time.syntax", "expected " + what + ", found " + _tdesc(s, i), i)
end
func _dtooLong(s: str, at: int): Error:
ret _derr(s, ErrorKind.OutOfRange, "time.overflow", "duration is too long (the limit is about 292 years)", at)
end
@en "Nanoseconds"
@fa "نانوثانیه‌ها"
pub inline pure func Nanoseconds(n: i64): Duration: ret Duration { ns = n } end
@en "Microseconds"
@fa "میکروثانیه‌ها"
pub inline pure func Microseconds(n: i64): Duration: ret Duration { ns = n * _NS_PER_US } end
@en "Milliseconds"
@fa "میلی‌ثانیه‌ها"
pub inline pure func Milliseconds(n: i64): Duration: ret Duration { ns = n * _NS_PER_MS } end
@en "Seconds"
@fa "ثانیه‌ها"
pub inline pure func Seconds(n: i64): Duration: ret Duration { ns = n * _NS_PER_SEC } end
@en "Minutes"
@fa "دقیقه‌ها"
pub inline pure func Minutes(n: i64): Duration: ret Duration { ns = n * _NS_PER_MIN } end
@en "Hours"
@fa "ساعت‌ها"
pub inline pure func Hours(n: i64): Duration: ret Duration { ns = n * _NS_PER_HOUR } end
@en "Days"
@fa "روزها"
pub inline pure func Days(n: i64): Duration: ret Duration { ns = n * _NS_PER_DAY } end
@en "SecondsF"
@fa "ثانیه اعشاری"
pub inline pure func SecondsF(x: f64): Duration: ret Duration { ns = (x * 1000000000.0) as i64 } end
@en "ZeroDuration"
@fa "مدت صفر"
pub inline pure func ZeroDuration(): Duration: ret Duration { ns = 0 } end
@en "FormatDuration"
@fa "قالب مدت"
pub func FormatDuration(d: Duration): str:
if d.ns == 0: ret "0s" end
if d.ns == _I64_MIN: ret "-2562047h47m16.854775808s" end
mut sign := ""
mut v := d.ns
if v < 0:
sign = "-"
v = 0 - v
end
if v < _NS_PER_US: ret sign + conv.FormatInt(v) + "ns" end
if v < _NS_PER_MS:
ret sign + conv.FormatInt(v / _NS_PER_US) + _fracStr(v % _NS_PER_US, 3) + "us"
end
if v < _NS_PER_SEC:
ret sign + conv.FormatInt(v / _NS_PER_MS) + _fracStr(v % _NS_PER_MS, 6) + "ms"
end
secs := v / _NS_PER_SEC
frac := _fracStr(v % _NS_PER_SEC, 9)
if secs < 60: ret sign + conv.FormatInt(secs) + frac + "s" end
if secs < 3600:
ret sign + conv.FormatInt(secs / 60) + "m" + conv.FormatInt(secs % 60) + frac + "s"
end
h := secs / 3600
m := (secs % 3600) / 60
s := secs % 60
ret sign + conv.FormatInt(h) + "h" + conv.FormatInt(m) + "m" + conv.FormatInt(s) + frac + "s"
end
@en "ParseDuration"
@fa "تجزیه مدت"
pub func ParseDuration(s: str): Duration throws:
n := s.len()
if n == 0: throw _derr(s, ErrorKind.UnexpectedEnd, "time.empty", "empty duration", 0) end
bp := _dbp(s)
mut i := 0
mut neg := false
c0 := _dub(bp, 0)
if c0 == 45:
neg = true
i = 1
else c0 == 43:
i = 1
end
if i >= n: throw _dwant(s, n, i, "a number") end
if s.substr(i, n - i) == "0": ret Duration { ns = 0 } end
mut total := 0 as i64
until i < n:
gs := i
mut whole := 0 as i64
mut digits := 0
until i < n and _isDigitByte(_dub(bp, i)):
dv := (_dub(bp, i) - 48) as i64
if whole > (_I64_MAX - dv) / 10: throw _dtooLong(s, gs) end
whole = whole * 10 + dv
digits++
i++
end
mut fracNum := 0 as i64
mut fracDen := 1 as i64
if i < n and _dub(bp, i) == 46:
i++
mut fdigits := 0
mut seen := 0
until i < n and _isDigitByte(_dub(bp, i)):
if fdigits < 9:
fracNum = fracNum * 10 + ((_dub(bp, i) - 48) as i64)
fracDen *= 10
fdigits++
end
seen++
i++
end
if seen == 0: throw _dwant(s, n, i, "a digit after the decimal point") end
digits += seen
end
if digits == 0: throw _dwant(s, n, i, "a number") end
us := i
until i < n and not _isDigitByte(_dub(bp, i)):
i++
end
if i == us:
throw _derr(s, ErrorKind.UnexpectedEnd, "time.missing_unit", "the number has no unit (ns, us, ms, s, m, h or d)", i)
end
unit := s.substr(us, i - us)
unitNs := _unitNanos(unit)
if unitNs == 0:
throw _derr(s, ErrorKind.Syntax, "time.bad_unit", "unknown unit '" + unit + "' (use ns, us, ms, s, m, h or d)", us)
end
if whole > _I64_MAX / unitNs: throw _dtooLong(s, gs) end
q := unitNs / fracDen
r := unitNs % fracDen
fpart := fracNum * q + (fracNum * r) / fracDen
part := whole * unitNs
if part > _I64_MAX - fpart: throw _dtooLong(s, gs) end
if total > _I64_MAX - (part + fpart): throw _dtooLong(s, gs) end
total = total + part + fpart
end
if neg: total = 0 - total end
ret Duration { ns = total }
end
@en "ParseDurationOr"
@fa "تجزیه مدت با پیش فرض"
pub func ParseDurationOr(s: str, fallback: Duration): Duration:
try:
ret ParseDuration(s)
catch:
ret fallback
end
end
@en "SleepFor"
@fa "خواب به مدت"
pub func SleepFor(d: Duration):
if d.ns <= 0: ret end
ms := d.ns / _NS_PER_MS
if ms > 0:
sleep_ms(ms as int)
ret
end
sleep_ms(1)
end
@en "SinceDuration"
@fa "مدت از"
pub func SinceDuration(start_ns: i64): Duration:
ret Duration { ns = _mono_ns() - start_ns }
end
@en "DurationBetween"
@fa "مدت بین"
pub inline pure func DurationBetween(later: i64, earlier: i64): Duration:
ret Duration { ns = (later - earlier) * _NS_PER_SEC }
end
@en "AddDuration"
@fa "افزودن مدت"
pub inline pure func AddDuration(epoch: i64, d: Duration): i64:
ret epoch + d.ns / _NS_PER_SEC
end
package time
@en "NowNanos"
@fa "اکنون نانوثانیه"
pub func NowNanos(): i64: ret _now_ns() end
@en "NowMicros"
@fa "اکنون میکروثانیه"
pub func NowMicros(): i64: ret _now_ns() / 1000 end
@en "NowMillis"
@fa "اکنون میلی ثانیه"
pub func NowMillis(): i64: ret _now_ns() / 1000000 end
@en "ElapsedMs"
@fa "سپری میلی ثانیه"
pub func ElapsedMs(start_ns: i64, end_ns: i64): f64:
ret ((end_ns - start_ns) as f64) / 1000000.0
end
@en "ElapsedUs"
@fa "سپری میکروثانیه"
pub func ElapsedUs(start_ns: i64, end_ns: i64): f64:
ret ((end_ns - start_ns) as f64) / 1000.0
end
@en "ElapsedSec"
@fa "سپری ثانیه"
pub func ElapsedSec(start_ns: i64, end_ns: i64): f64:
ret ((end_ns - start_ns) as f64) / 1000000000.0
end
@en "MonoNanos"
@fa "نانوثانیه یکنواخت"
pub func MonoNanos(): i64: ret _mono_ns() end
@en "MonoMicros"
@fa "میکروثانیه یکنواخت"
pub func MonoMicros(): i64: ret _mono_ns() / 1000 end
@en "MonoMillis"
@fa "میلی‌ثانیه یکنواخت"
pub func MonoMillis(): i64: ret _mono_ns() / 1000000 end
@en "SinceNanos"
@fa "از نانوثانیه"
pub func SinceNanos(start_ns: i64): i64: ret _mono_ns() - start_ns end
@en "SinceMs"
@fa "از میلی ثانیه"
pub func SinceMs(start_ns: i64): f64:
ret ((_mono_ns() - start_ns) as f64) / 1000000.0
end
@en "SinceUs"
@fa "از میکروثانیه"
pub func SinceUs(start_ns: i64): f64:
ret ((_mono_ns() - start_ns) as f64) / 1000.0
end
@en "SinceSec"
@fa "از ثانیه"
pub func SinceSec(start_ns: i64): f64:
ret ((_mono_ns() - start_ns) as f64) / 1000000000.0
end
package time
import mem
import conv
if SALAM_OS_WINDOWS:
extern:
func _mktime64(tp: void*): i64
end
else:
if not (SALAM_ARCH_X86 or SALAM_ARCH_ARM or SALAM_ARCH_WASM):
extern:
func mktime(tp: void*): i64
end
else:
if SALAM_OS_ANDROID:
extern:
func mktime(tp: void*): i32
end
else SALAM_OS_LINUX:
extern:
func __mktime64(tp: void*): i64
end
else:
extern:
func mktime(tp: void*): i64
end
end
end
end
struct _Parts:
pub year: int = 1970
pub month: int = 1
pub day: int = 1
pub hour: int = 0
pub minute: int = 0
pub second: int = 0
pub nanos: int = 0
pub has_offset: bool = false
pub offset_minutes: int = 0
pub at_month: int = 0
pub at_day: int = 0
pub at_hour: int = 0
pub at_minute: int = 0
pub at_second: int = 0
end
inline pure func _pbp(s: str): i8*: ret (s as void*) as i8* end
inline pure func _pub(bp: i8*, i: int): int:
mut v := bp[i] as int
if v < 0: v += 256 end
ret v
end
pure func _pIsDigit(c: int): bool: ret c >= 48 and c <= 57 end
pure func _pIsAlpha(c: int): bool:
ret (c >= 65 and c <= 90) or (c >= 97 and c <= 122)
end
pure func _pIsBlank(c: int): bool:
ret c == 32 or c == 9 or c == 10 or c == 13
end
func _tdesc(s: str, i: int): str:
n := s.len()
if i >= n: ret "the end of the text" end
c := _pub(_pbp(s), i)
if c == 32: ret "a space" end
mut w := 1
if c >= 240: w = 4
else c >= 224: w = 3
else c >= 192: w = 2
end
if c < 32 or c == 127 or (c >= 128 and c < 192) or i + w > n:
ret "byte " + c
end
ret "'" + s.substr(i, w) + "'"
end
func _terr(s: str, kind: ErrorKind, code: str, message: str, offset: int): Error:
ret Error.At(kind, message, offset).locate(s).with_code(code).wrap("time")
end
func _want(s: str, n: int, i: int, what: str): Error:
if i >= n:
ret _terr(s, ErrorKind.UnexpectedEnd, "time.unexpected_end", "expected " + what + ", found the end of the text", i)
end
ret _terr(s, ErrorKind.Syntax, "time.syntax", "expected " + what + ", found " + _tdesc(s, i), i)
end
func _trailing(s: str, i: int, after: str): Error:
ret _terr(s, ErrorKind.Syntax, "time.trailing", "expected the end of the text after " + after + ", found " + _tdesc(s, i), i)
end
func _fixedDigits(s: str, n: int, i &: int, count: int, what: str): int throws:
bp := _pbp(s)
mut v := 0
repeat count in k:
if i + k >= n or not _pIsDigit(_pub(bp, i + k)):
throw _want(s, n, i + k, "a digit in the " + what)
end
v = v * 10 + (_pub(bp, i + k) - 48)
end
i += count
ret v
end
func _someDigits(s: str, n: int, i &: int, maxd: int, what: str): int throws:
bp := _pbp(s)
mut v := 0
mut got := 0
until i < n and got < maxd and _pIsDigit(_pub(bp, i)):
v = v * 10 + (_pub(bp, i) - 48)
got++
i++
end
if got == 0: throw _want(s, n, i, "the " + what) end
ret v
end
func _expectByte(s: str, n: int, i &: int, c: int, what: str) throws:
if i >= n or _pub(_pbp(s), i) != c: throw _want(s, n, i, what) end
i++
end
pure func _pfloordiv(a: i64, b: i64): i64:
q := a / b
r := a - q * b
if r != 0 and (r < 0) != (b < 0): ret q - 1 end
ret q
end
pure func _daysFromCivil(y0: int, m: int, d: int): i64:
mut y := y0 as i64
mm := m as i64
if mm <= 2: y-- end
era := _pfloordiv(y, 400)
yoe := y - era * 400
mp := (mm + 9) % 12
doy := (153 * mp + 2) / 5 + (d as i64) - 1
doe := yoe * 365 + yoe / 4 - yoe / 100 + doy
ret era * 146097 + doe - 719468
end
pure func _utcEpoch(y: int, mo: int, d: int, h: int, mi: int, s: int): i64:
ret _daysFromCivil(y, mo, d) * 86400 + (h as i64) * 3600 + (mi as i64) * 60 + (s as i64)
end
pure func _pfloormod(a: i64, b: i64): i64:
ret a - _pfloordiv(a, b) * b
end
pure func _gmFieldPure(epoch: i64, idx: int): int:
days := _pfloordiv(epoch, 86400)
secs := epoch - days * 86400
if idx == 0: ret (secs % 60) as int end
if idx == 1: ret ((secs / 60) % 60) as int end
if idx == 2: ret (secs / 3600) as int end
if idx == 6: ret _pfloormod(days + 4, 7) as int end
z := days + 719468
era := _pfloordiv(z, 146097)
doe := z - era * 146097
yoe := (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
doy := doe - (365 * yoe + yoe / 4 - yoe / 100)
mp := (5 * doy + 2) / 153
d := doy - (153 * mp + 2) / 5 + 1
mut m := mp + 3
if mp >= 10: m = mp - 9 end
mut y := yoe + era * 400
if m <= 2: y++ end
if idx == 3: ret d as int end
if idx == 4: ret (m - 1) as int end
if idx == 5: ret (y - 1900) as int end
if idx == 7: ret (days - _daysFromCivil(y as int, 1, 1)) as int end
ret 0
end
if SALAM_OS_WINDOWS:
func _c_mktime(tp: void*): i64: ret _mktime64(tp) end
else:
if not (SALAM_ARCH_X86 or SALAM_ARCH_ARM or SALAM_ARCH_WASM):
func _c_mktime(tp: void*): i64: ret mktime(tp) end
else:
if SALAM_OS_ANDROID:
func _c_mktime(tp: void*): i64: ret mktime(tp) end
else SALAM_OS_LINUX:
func _c_mktime(tp: void*): i64: ret __mktime64(tp) end
else:
func _c_mktime(tp: void*): i64: ret mktime(tp) end
end
end
end
func _localEpoch(y: int, mo: int, d: int, h: int, mi: int, s: int): i64:
buf := mem.AllocateZeroed(128 as u64)
if buf == null: ret _utcEpoch(y, mo, d, h, mi, s) end
p := buf as int*
p[0] = s
p[1] = mi
p[2] = h
p[3] = d
p[4] = mo - 1
p[5] = y - 1900
p[8] = 0 - 1
out := _c_mktime(buf)
mem.Free(buf)
if out == (0 - 1) as i64: ret _utcEpoch(y, mo, d, h, mi, s) end
ret out
end
func _daysInMonth(y: int, m: int): int:
if m == 2:
if (y % 4 == 0 and y % 100 != 0) or y % 400 == 0: ret 29 end
ret 28
end
if m == 4 or m == 6 or m == 9 or m == 11: ret 30 end
ret 31
end
func _resolve(s: str, p: _Parts): i64 throws:
if p.month < 1 or p.month > 12:
throw _terr(s, ErrorKind.OutOfRange, "time.bad_month", "month " + p.month + " is out of range (1 to 12)", p.at_month)
end
dim := _daysInMonth(p.year, p.month)
if p.day < 1 or p.day > dim:
throw _terr(s, ErrorKind.OutOfRange, "time.bad_day", "day " + p.day + " is out of range for month " + p.month + " of " + p.year + " (1 to " + dim + ")", p.at_day)
end
if p.hour > 24 or (p.hour == 24 and (p.minute != 0 or p.second != 0 or p.nanos != 0)):
throw _terr(s, ErrorKind.OutOfRange, "time.bad_hour", "hour " + p.hour + " is out of range (0 to 23, or 24:00:00)", p.at_hour)
end
if p.minute > 59:
throw _terr(s, ErrorKind.OutOfRange, "time.bad_minute", "minute " + p.minute + " is out of range (0 to 59)", p.at_minute)
end
if p.second > 60:
throw _terr(s, ErrorKind.OutOfRange, "time.bad_second", "second " + p.second + " is out of range (0 to 60)", p.at_second)
end
mut sec := p.second
if sec == 60: sec = 59 end
if p.has_offset:
ret _utcEpoch(p.year, p.month, p.day, p.hour, p.minute, sec) - (p.offset_minutes as i64) * 60
end
ret _localEpoch(p.year, p.month, p.day, p.hour, p.minute, sec)
end
func _monthFromName(name: str): int:
if name.len() < 3: ret 0 end
k := name.substr(0, 3).lower()
if k == "jan": ret 1 end
if k == "feb": ret 2 end
if k == "mar": ret 3 end
if k == "apr": ret 4 end
if k == "may": ret 5 end
if k == "jun": ret 6 end
if k == "jul": ret 7 end
if k == "aug": ret 8 end
if k == "sep": ret 9 end
if k == "oct": ret 10 end
if k == "nov": ret 11 end
if k == "dec": ret 12 end
ret 0
end
func _monthName(s: str, n: int, i &: int, p &: _Parts) throws:
bp := _pbp(s)
ms := i
until i < n and _pIsAlpha(_pub(bp, i)):
i++
end
if i == ms: throw _want(s, n, i, "a month name") end
mo := _monthFromName(s.substr(ms, i - ms))
if mo == 0:
throw _terr(s, ErrorKind.Syntax, "time.bad_month_name", "unknown month name '" + s.substr(ms, i - ms) + "'", ms)
end
p.month = mo
p.at_month = ms
end
func _parseZone(s: str, n: int, i &: int, p &: _Parts) throws:
if i >= n: ret end
bp := _pbp(s)
c := _pub(bp, i)
if c == 90 or c == 122:
i++
p.has_offset = true
p.offset_minutes = 0
ret
end
if c == 43 or c == 45:
at := i
sign := 1 - 2 * ((c == 45) ? 1 : 0)
i++
hh := try _fixedDigits(s, n, i, 2, "offset")
mut mm := 0
if i < n and _pub(bp, i) == 58:
i++
mm = try _fixedDigits(s, n, i, 2, "offset")
else i < n and _pIsDigit(_pub(bp, i)):
mm = try _fixedDigits(s, n, i, 2, "offset")
end
if hh > 23 or mm > 59:
throw _terr(s, ErrorKind.OutOfRange, "time.bad_offset", "offset " + s.substr(at, i - at) + " is out of range (up to 23:59)", at)
end
p.has_offset = true
p.offset_minutes = sign * (hh * 60 + mm)
end
end
func _skipSpaces(s: str, n: int, i &: int):
bp := _pbp(s)
until i < n and (_pub(bp, i) == 32 or _pub(bp, i) == 9):
i++
end
end
func _parseClock(s: str, n: int, i &: int, p &: _Parts) throws:
p.at_hour = i
p.hour = try _fixedDigits(s, n, i, 2, "hour")
try _expectByte(s, n, i, 58, "':' after the hour")
p.at_minute = i
p.minute = try _fixedDigits(s, n, i, 2, "minute")
if i < n and _pub(_pbp(s), i) == 58:
i++
p.at_second = i
p.second = try _fixedDigits(s, n, i, 2, "second")
end
end
func _parseFraction(s: str, n: int, i &: int): int throws:
bp := _pbp(s)
mut scale := 100000000
mut acc := 0
mut got := 0
until i < n and _pIsDigit(_pub(bp, i)):
if scale >= 1:
acc += (_pub(bp, i) - 48) * scale
scale /= 10
end
got++
i++
end
if got == 0: throw _want(s, n, i, "a digit of the fraction") end
ret acc
end
func _trimStart(s: str): int:
bp := _pbp(s)
n := s.len()
mut i := 0
until i < n and _pIsBlank(_pub(bp, i)):
i++
end
ret i
end
func _trimEnd(s: str, from: int): int:
bp := _pbp(s)
mut n := s.len()
until n > from and _pIsBlank(_pub(bp, n - 1)):
n--
end
ret n
end
func _empty(s: str, what: str): Error:
ret _terr(s, ErrorKind.UnexpectedEnd, "time.empty", "empty " + what, 0)
end
func _scanISO(s: str, p &: _Parts) throws:
mut i := _trimStart(s)
n := _trimEnd(s, i)
if i >= n: throw _empty(s, "date") end
bp := _pbp(s)
p.year = try _fixedDigits(s, n, i, 4, "year")
try _expectByte(s, n, i, 45, "'-' after the year")
p.at_month = i
p.month = try _fixedDigits(s, n, i, 2, "month")
try _expectByte(s, n, i, 45, "'-' after the month")
p.at_day = i
p.day = try _fixedDigits(s, n, i, 2, "day")
if i >= n: ret end
sep := _pub(bp, i)
if sep != 84 and sep != 116 and sep != 32:
throw _want(s, n, i, "'T' or a space before the time")
end
i++
try _parseClock(s, n, i, p)
if i < n and (_pub(bp, i) == 46 or _pub(bp, i) == 44):
i++
p.nanos = try _parseFraction(s, n, i)
end
try _parseZone(s, n, i, p)
if i != n: throw _trailing(s, i, "the time") end
end
func _httpZone(s: str, n: int, i &: int, p &: _Parts) throws:
if i >= n: ret end
bp := _pbp(s)
c := _pub(bp, i)
if c == 43 or c == 45:
try _parseZone(s, n, i, p)
ret
end
zs := i
until i < n and _pIsAlpha(_pub(bp, i)):
i++
end
if i == zs: throw _want(s, n, zs, "GMT or an offset such as +0000") end
word := s.substr(zs, i - zs)
nm := word.upper()
if nm != "GMT" and nm != "UTC" and nm != "UT" and nm != "Z":
throw _terr(s, ErrorKind.Syntax, "time.syntax", "expected GMT or an offset such as +0000, found '" + word + "'", zs)
end
end
func _layoutErr(pattern: str, message: str): Error:
ret Error.New(ErrorKind.InvalidArgument, "layout \"" + pattern + "\" " + message).with_code("time.bad_layout").wrap("time")
end
func _layoutWant(s: str, n: int, i: int, lit: str): Error:
mut what := "'" + lit + "'"
if lit == " ": what = "a space" end
if i >= n:
ret _terr(s, ErrorKind.UnexpectedEnd, "time.unexpected_end", "expected " + what + " from the layout, found the end of the text", i)
end
ret _terr(s, ErrorKind.Syntax, "time.layout_mismatch", "expected " + what + " from the layout, found " + _tdesc(s, i), i)
end
@en "ParseISO"
@fa "تجزیه ایزو"
pub func ParseISO(s: str): i64 throws:
mut p := _Parts {}
try _scanISO(s, p)
ret try _resolve(s, p)
end
@en "ParseISONanos"
@fa "تجزیه ایزو نانوثانیه"
pub func ParseISONanos(s: str): i64 throws:
mut p := _Parts {}
try _scanISO(s, p)
epoch := try _resolve(s, p)
nanos := p.nanos as i64
lo := 0 - 9223372037 as i64
hi := 9223372036 as i64
if epoch > hi or epoch < lo or (epoch == hi and nanos > 854775807) or (epoch == lo and nanos < 145224192):
throw _terr(s, ErrorKind.OutOfRange, "time.overflow", "date is outside the range of nanosecond timestamps (years 1677 to 2262)", _trimStart(s))
end
ret epoch * 1000000000 + nanos
end
@en "ParseISOIn"
@fa "تجزیه ایزو در"
pub func ParseISOIn(s: str, offsetMinutes: int): i64 throws:
mut p := _Parts {}
try _scanISO(s, p)
if not p.has_offset:
p.has_offset = true
p.offset_minutes = offsetMinutes
end
ret try _resolve(s, p)
end
@en "ParseHTTPDate"
@fa "تجزیه تاریخ اچ‌تی‌تی‌پی"
pub func ParseHTTPDate(s: str): i64 throws:
mut i := _trimStart(s)
n := _trimEnd(s, i)
if i >= n: throw _empty(s, "date") end
bp := _pbp(s)
ds := i
until i < n and _pIsAlpha(_pub(bp, i)):
i++
end
if i == ds: throw _want(s, n, i, "a day name such as 'Mon'") end
mut isAsctime := true
if i < n and _pub(bp, i) == 44:
i++
isAsctime = false
end
_skipSpaces(s, n, i)
mut p := _Parts { has_offset = true, offset_minutes = 0 }
if isAsctime:
try _monthName(s, n, i, p)
_skipSpaces(s, n, i)
p.at_day = i
p.day = try _someDigits(s, n, i, 2, "day")
_skipSpaces(s, n, i)
try _parseClock(s, n, i, p)
_skipSpaces(s, n, i)
p.year = try _fixedDigits(s, n, i, 4, "year")
if i != n: throw _trailing(s, i, "the year") end
ret try _resolve(s, p)
end
p.at_day = i
p.day = try _someDigits(s, n, i, 2, "day")
if i < n and (_pub(bp, i) == 45 or _pub(bp, i) == 32): i++ end
try _monthName(s, n, i, p)
if i < n and (_pub(bp, i) == 45 or _pub(bp, i) == 32): i++ end
mut y := try _someDigits(s, n, i, 4, "year")
if y < 100:
if y < 69: y += 2000
else:
y += 1900
end
end
p.year = y
_skipSpaces(s, n, i)
try _parseClock(s, n, i, p)
_skipSpaces(s, n, i)
try _httpZone(s, n, i, p)
if i != n: throw _trailing(s, i, "the time") end
ret try _resolve(s, p)
end
@en "ParseFormat"
@fa "تجزیه با قالب"
pub func ParseFormat(pattern: str, s: str): i64 throws:
pn := pattern.len()
n := s.len()
pbpv := _pbp(pattern)
bp := _pbp(s)
mut pi := 0
mut i := 0
mut p := _Parts {}
until pi < pn:
pc := _pub(pbpv, pi)
if pc != 37:
if pc == 32:
pi++
_skipSpaces(s, n, i)
continue
end
if i >= n or _pub(bp, i) != pc: throw _layoutWant(s, n, i, pattern.substr(pi, 1)) end
pi++
i++
continue
end
pi++
if pi >= pn: throw _layoutErr(pattern, "ends with a lone '%'") end
d := _pub(pbpv, pi)
pi++
if d == 37:
if i >= n or _pub(bp, i) != 37: throw _layoutWant(s, n, i, "%") end
i++
else d == 89:
p.year = try _fixedDigits(s, n, i, 4, "year")
else d == 121:
v := try _fixedDigits(s, n, i, 2, "year")
if v < 69: p.year = v + 2000 else:
p.year = v + 1900
end
else d == 109:
p.at_month = i
p.month = try _someDigits(s, n, i, 2, "month")
else d == 100:
p.at_day = i
p.day = try _someDigits(s, n, i, 2, "day")
else d == 72:
p.at_hour = i
p.hour = try _someDigits(s, n, i, 2, "hour")
else d == 77:
p.at_minute = i
p.minute = try _someDigits(s, n, i, 2, "minute")
else d == 83:
p.at_second = i
p.second = try _someDigits(s, n, i, 2, "second")
else d == 102:
p.nanos = try _parseFraction(s, n, i)
else d == 98 or d == 66:
try _monthName(s, n, i, p)
else d == 97 or d == 65:
ds := i
until i < n and _pIsAlpha(_pub(bp, i)):
i++
end
if i == ds: throw _want(s, n, i, "a day name") end
else d == 122:
try _parseZone(s, n, i, p)
else d == 90:
zs := i
until i < n and _pIsAlpha(_pub(bp, i)):
i++
end
if i == zs: throw _want(s, n, i, "a zone name") end
nm := s.substr(zs, i - zs).upper()
if nm == "GMT" or nm == "UTC" or nm == "Z":
p.has_offset = true
p.offset_minutes = 0
end
else:
throw _layoutErr(pattern, "has an unknown directive '%" + pattern.substr(pi - 1, 1) + "'")
end
end
if i != n: throw _trailing(s, i, "the layout") end
ret try _resolve(s, p)
end
@en "ParseISOOr"
@fa "تجزیه ایزو با پیش فرض"
pub func ParseISOOr(s: str, fallback: i64): i64:
try:
ret ParseISO(s)
catch:
ret fallback
end
end
@en "FormatISOUTC"
@fa "قالب ایزو جهانی"
pub func FormatISOUTC(epoch: i64): str:
y := _gm_field(epoch, 5) + 1900
mo := _gm_field(epoch, 4) + 1
d := _gm_field(epoch, 3)
ret conv.FormatInt(y as i64) + "-" + pad2(mo) + "-" + pad2(d) + "T" + pad2(_gm_field(epoch, 2)) + ":" + pad2(_gm_field(epoch, 1)) + ":" + pad2(_gm_field(epoch, 0)) + "Z"
end
@en "FormatRFC3339"
@fa "قالب آر‌اف‌سی۳۳۳۹"
pub func FormatRFC3339(epoch: i64): str:
body := FormatDate(epoch) + "T" + FormatTime(epoch)
off := LocalOffsetMinutesAt(epoch)
if off == 0: ret body + "Z" end
mut sign := "+"
mut v := off
if v < 0:
sign = "-"
v = 0 - v
end
ret body + sign + pad2(v / 60) + ":" + pad2(v % 60)
end
@en "LocalOffsetMinutesAt"
@fa "اختلاف محلی در"
pub func LocalOffsetMinutesAt(epoch: i64): int:
local := _utcEpoch(time_year(epoch), time_month(epoch), time_day(epoch), time_hour(epoch), time_minute(epoch), time_second(epoch))
ret ((local - epoch) / 60) as int
end
@en "FromLocalParts"
@fa "از اجزای محلی"
pub func FromLocalParts(year: int, month: int, day: int, hour: int, minute: int, second: int): i64:
ret _localEpoch(year, month, day, hour, minute, second)
end
@en "FromUTCParts"
@fa "از اجزای جهانی"
pub func FromUTCParts(year: int, month: int, day: int, hour: int, minute: int, second: int): i64:
ret _utcEpoch(year, month, day, hour, minute, second)
end
@en "time"
@fa "زمان"
package time
import mem
import conv
if SALAM_OS_WINDOWS:
extern:
func _time64(tp: void*): i64
func _localtime64(tp: void*): void*
func SleepEx(ms: u32, alertable: int): u32
func GetSystemTimeAsFileTime(ft: void*)
func QueryPerformanceCounter(counter: void*): int
func QueryPerformanceFrequency(freq: void*): int
end
else:
extern:
func usleep(usec: u32): int
end
if not (SALAM_ARCH_X86 or SALAM_ARCH_ARM or SALAM_ARCH_WASM):
extern:
func time(tp: void*): i64
func localtime(tp: void*): void*
func clock_gettime(clock_id: int, ts: void*): int
end
else:
if SALAM_OS_ANDROID:
extern:
func time(tp: void*): i32
func localtime(tp: void*): void*
func clock_gettime(clock_id: int, ts: void*): int
end
else SALAM_OS_LINUX:
extern:
func __time64(tp: void*): i64
func __localtime64(tp: void*): void*
func __clock_gettime64(clock_id: int, ts: void*): int
end
else:
extern:
func time(tp: void*): i64
func localtime(tp: void*): void*
end
end
end
end
@en "SecondsPerMinute"
@fa "ثانیه در دقیقه"
pub const SecondsPerMinute := 60
@en "SecondsPerHour"
@fa "ثانیه در ساعت"
pub const SecondsPerHour := 3600
@en "SecondsPerDay"
@fa "ثانیه در روز"
pub const SecondsPerDay := 86400
@en "DateTime"
@fa "تاریخ زمان"
pub struct DateTime:
@en "epoch"
@fa "ثانیه مبدا"
pub epoch: i64 = 0
end
if SALAM_OS_WINDOWS:
func sleep_ms(ms: int):
if ms > 0:
SleepEx(ms as u32, 0)
end
end
else:
func sleep_ms(ms: int):
if ms > 0:
usleep((ms * 1000) as u32)
end
end
end
if SALAM_OS_WINDOWS:
func time_now(): i64: ret _time64(null) end
func _c_localtime(tp: void*): void*: ret _localtime64(tp) end
else:
if not (SALAM_ARCH_X86 or SALAM_ARCH_ARM or SALAM_ARCH_WASM):
func time_now(): i64: ret time(null) end
func _c_localtime(tp: void*): void*: ret localtime(tp) end
else:
if SALAM_OS_ANDROID:
func time_now(): i64: ret time(null) end
func _c_localtime(tp: void*): void*: ret localtime(tp) end
else SALAM_OS_LINUX:
func time_now(): i64: ret __time64(null) end
func _c_localtime(tp: void*): void*: ret __localtime64(tp) end
else:
func time_now(): i64: ret time(null) end
func _c_localtime(tp: void*): void*: ret localtime(tp) end
end
end
end
func _localtime(epoch: i64): void*:
if SALAM_OS_ANDROID:
if SALAM_ARCH_X86 or SALAM_ARCH_ARM:
if epoch > (2147483647 as i64) or epoch < (0 - 2147483647 as i64): ret null end
end
end
tp := mem.Allocate(8 as u64)
tp64 := tp as i64*
tp64[0] = epoch
tm := _c_localtime(tp)
mem.Free(tp)
ret tm
end
func _tm_field(epoch: i64, idx: int): int:
tm := _localtime(epoch)
if tm == null: ret _gmFieldPure(epoch, idx) end
tm32 := tm as int*
ret tm32[idx]
end
func time_year(epoch: i64): int: ret _tm_field(epoch, 5) + 1900 end
func time_month(epoch: i64): int: ret _tm_field(epoch, 4) + 1 end
func time_day(epoch: i64): int: ret _tm_field(epoch, 3) end
func time_hour(epoch: i64): int: ret _tm_field(epoch, 2) end
func time_minute(epoch: i64): int: ret _tm_field(epoch, 1) end
func time_second(epoch: i64): int: ret _tm_field(epoch, 0) end
func pad2(n: int): str:
s := conv.FormatInt(n as i64)
if s.len() < 2: ret "0".concat(s) end
ret s
end
func _put2(p: u8 *, at: int, n: int):
p[at] = (48 + (n / 10) % 10) as u8
p[at + 1] = (48 + n % 10) as u8
end
func _gm_field(epoch: i64, idx: int): int:
ret _gmFieldPure(epoch, idx)
end
func _weekday_name(w: int): str:
if w == 0: ret "Sun"
else w == 1: ret "Mon"
else w == 2: ret "Tue"
else w == 3: ret "Wed"
else w == 4: ret "Thu"
else w == 5: ret "Fri"
else:
ret "Sat"
end
end
func _month_name(m: int): str:
if m == 0: ret "Jan"
else m == 1: ret "Feb"
else m == 2: ret "Mar"
else m == 3: ret "Apr"
else m == 4: ret "May"
else m == 5: ret "Jun"
else m == 6: ret "Jul"
else m == 7: ret "Aug"
else m == 8: ret "Sep"
else m == 9: ret "Oct"
else m == 10: ret "Nov"
else:
ret "Dec"
end
end
if SALAM_OS_WINDOWS:
func _now_ns(): i64:
buf := mem.Allocate(8 as u64)
GetSystemTimeAsFileTime(buf)
p := buf as u64*
ft := p[0] as i64
mem.Free(buf)
ret (ft - 116444736000000000) * 100
end
else:
if not (SALAM_ARCH_X86 or SALAM_ARCH_ARM or SALAM_ARCH_WASM):
func _now_ns(): i64:
buf := mem.AllocateZeroed(16 as u64)
mut out := 0 as i64
if clock_gettime(0, buf) == 0:
p := buf as i64*
out = p[0] * 1000000000 + p[1]
end
mem.Free(buf)
ret out
end
else:
if SALAM_OS_ANDROID:
func _now_ns(): i64:
buf := mem.AllocateZeroed(16 as u64)
mut out := 0 as i64
if clock_gettime(0, buf) == 0:
q := buf as i32*
out = (q[0] as i64) * 1000000000 + (q[1] as i64)
end
mem.Free(buf)
ret out
end
else SALAM_OS_LINUX:
func _now_ns(): i64:
buf := mem.AllocateZeroed(16 as u64)
mut out := 0 as i64
if __clock_gettime64(0, buf) == 0:
p := buf as i64*
q := buf as i32*
out = p[0] * 1000000000 + (q[2] as i64)
end
mem.Free(buf)
ret out
end
else:
func _now_ns(): i64:
ret time_now() * 1000000000
end
end
end
end
if SALAM_OS_WINDOWS:
func _mono_ns(): i64:
buf := mem.AllocateZeroed(16 as u64)
mut out := 0 as i64
if QueryPerformanceCounter(buf) != 0:
fbuf := mem.AllocateZeroed(8 as u64)
if QueryPerformanceFrequency(fbuf) != 0:
cp := buf as i64*
fp := fbuf as i64*
counter := cp[0]
freq := fp[0]
if freq > 0:
whole := counter / freq
frac := counter % freq
out = whole * 1000000000 + (frac * 1000000000) / freq
end
end
mem.Free(fbuf)
end
mem.Free(buf)
ret out
end
else:
if not (SALAM_ARCH_X86 or SALAM_ARCH_ARM or SALAM_ARCH_WASM):
func _mono_clock_id(): int:
if SALAM_OS_MAC:
ret 8
else SALAM_OS_FREEBSD:
ret 4
else SALAM_OS_OPENBSD or SALAM_OS_NETBSD:
ret 3
else:
ret 1
end
end
func _mono_ns(): i64:
buf := mem.AllocateZeroed(16 as u64)
mut out := 0 as i64
if clock_gettime(_mono_clock_id(), buf) == 0:
p := buf as i64*
out = p[0] * 1000000000 + p[1]
end
mem.Free(buf)
ret out
end
else:
if SALAM_OS_ANDROID:
func _mono_ns(): i64:
buf := mem.AllocateZeroed(16 as u64)
mut out := 0 as i64
if clock_gettime(1, buf) == 0:
q := buf as i32*
out = (q[0] as i64) * 1000000000 + (q[1] as i64)
end
mem.Free(buf)
ret out
end
else SALAM_OS_LINUX:
func _mono_ns(): i64:
buf := mem.AllocateZeroed(16 as u64)
mut out := 0 as i64
if __clock_gettime64(1, buf) == 0:
p := buf as i64*
q := buf as i32*
out = p[0] * 1000000000 + (q[2] as i64)
end
mem.Free(buf)
ret out
end
else:
func _mono_ns(): i64:
ret time_now() * 1000000000
end
end
end
end
@en "Now"
@fa "اکنون"
pub func Now(): i64: ret time_now() end
@en "NowDateTime"
@fa "تاریخ زمان اکنون"
pub func NowDateTime(): DateTime:
ret DateTime { epoch = time_now() }
end
@en "FromEpoch"
@fa "از مبدا"
pub func FromEpoch(seconds: i64): DateTime:
ret DateTime { epoch = seconds }
end
@en "Epoch"
@fa "مبدا"
pub inline pure func Epoch(dt: DateTime): i64:
ret dt.epoch
end
@en "Year"
@fa "سال"
pub func Year(epoch: i64): int: ret time_year(epoch) end
@en "Month"
@fa "ماه"
pub func Month(epoch: i64): int: ret time_month(epoch) end
@en "Day"
@fa "روز"
pub func Day(epoch: i64): int: ret time_day(epoch) end
@en "Hour"
@fa "ساعت"
pub func Hour(epoch: i64): int: ret time_hour(epoch) end
@en "Minute"
@fa "دقیقه"
pub func Minute(epoch: i64): int: ret time_minute(epoch) end
@en "Second"
@fa "ثانیه"
pub func Second(epoch: i64): int: ret time_second(epoch) end
@en "YearUTC"
@fa "سال جهانی"
pub func YearUTC(epoch: i64): int: ret _gm_field(epoch, 5) + 1900 end
@en "MonthUTC"
@fa "ماه جهانی"
pub func MonthUTC(epoch: i64): int: ret _gm_field(epoch, 4) + 1 end
@en "DayUTC"
@fa "روز جهانی"
pub func DayUTC(epoch: i64): int: ret _gm_field(epoch, 3) end
@en "HourUTC"
@fa "ساعت جهانی"
pub func HourUTC(epoch: i64): int: ret _gm_field(epoch, 2) end
@en "MinuteUTC"
@fa "دقیقه جهانی"
pub func MinuteUTC(epoch: i64): int: ret _gm_field(epoch, 1) end
@en "SecondUTC"
@fa "ثانیه جهانی"
pub func SecondUTC(epoch: i64): int: ret _gm_field(epoch, 0) end
@en "Weekday"
@fa "روز هفته"
pub func Weekday(epoch: i64): int: ret _tm_field(epoch, 6) end
@en "YearDay"
@fa "روز سال"
pub func YearDay(epoch: i64): int: ret _tm_field(epoch, 7) + 1 end
@en "FormatDate"
@fa "قالب تاریخ"
pub func FormatDate(epoch: i64): str:
y := time_year(epoch)
mo := time_month(epoch)
d := time_day(epoch)
ret conv.FormatInt(y as i64).concat("-").concat(pad2(mo)).concat("-").concat(pad2(d))
end
@en "FormatTime"
@fa "قالب ساعت"
pub func FormatTime(epoch: i64): str:
h := time_hour(epoch)
mi := time_minute(epoch)
s := time_second(epoch)
ret pad2(h).concat(":").concat(pad2(mi)).concat(":").concat(pad2(s))
end
@en "Format"
@fa "قالب بندی"
pub func Format(epoch: i64): str:
ret FormatDate(epoch).concat(" ").concat(FormatTime(epoch))
end
@en "FormatISO"
@fa "قالب ایزو"
pub func FormatISO(epoch: i64): str:
ret FormatDate(epoch).concat("T").concat(FormatTime(epoch))
end
@en "FormatHTTPDate"
@fa "قالب تاریخ اچ‌تی‌تی‌پی"
pub func FormatHTTPDate(epoch: i64): str:
out := mem.Allocate(30 as u64)
p := out as u8 *
wp := _weekday_name(_gm_field(epoch, 6)) as u8 *
mp := _month_name(_gm_field(epoch, 4)) as u8 *
p[0] = wp[0]
p[1] = wp[1]
p[2] = wp[2]
p[3] = 44 as u8
p[4] = 32 as u8
_put2(p, 5, _gm_field(epoch, 3))
p[7] = 32 as u8
p[8] = mp[0]
p[9] = mp[1]
p[10] = mp[2]
p[11] = 32 as u8
mut yr := _gm_field(epoch, 5) + 1900
if yr < 0: yr = 0 end
if yr > 9999: yr = 9999 end
_put2(p, 12, yr / 100)
_put2(p, 14, yr % 100)
p[16] = 32 as u8
_put2(p, 17, _gm_field(epoch, 2))
p[19] = 58 as u8
_put2(p, 20, _gm_field(epoch, 1))
p[22] = 58 as u8
_put2(p, 23, _gm_field(epoch, 0))
p[25] = 32 as u8
p[26] = 71 as u8
p[27] = 77 as u8
p[28] = 84 as u8
p[29] = 0 as u8
ret out as str
end
@en "Sleep"
@fa "خواب"
pub func Sleep(ms: int):
sleep_ms(ms)
end
@en "DiffSeconds"
@fa "اختلاف ثانیه"
pub inline pure func DiffSeconds(later: i64, earlier: i64): i64:
ret later - earlier
end
@en "Since"
@fa "از زمان"
pub func Since(t: i64): i64:
ret time_now() - t
end
@en "Until"
@fa "تا زمان"
pub func Until(t: i64): i64:
ret t - time_now()
end
package time
import mem
if SALAM_OS_WINDOWS:
extern:
func SetWaitableTimer(timer: void*, due: void*, period: int, routine: void*, arg: void*, resume: int): int
func WaitForSingleObject(h: void*, ms: int): int
func CloseHandle(h: void*): int
end
if SALAM_ARCH_X86:
extern:
func CreateWaitableTimerExW(attrs: void*, name: void*, flags: u32, access: u32): void*
end
else:
extern:
func GetModuleHandleA(name: str): void*
func GetProcAddress(mod: void*, name: str): void*
end
end
mut _hires_off := false
end
@en "Timer"
@fa "زمان‌سنج"
pub struct Timer:
@en "deadline_ns"
@fa "مهلت"
pub deadline_ns: i64 = 0
@en "active"
@fa "فعال"
pub active: bool = false
@en "expired"
@fa "منقضی شده"
pub func expired(): bool:
if not this.active: ret false end
ret _mono_ns() >= this.deadline_ns
end
@en "remaining"
@fa "باقی‌مانده"
pub func remaining(): Duration:
if not this.active: ret Duration { ns = 0 } end
rem := this.deadline_ns - _mono_ns()
if rem < 0: ret Duration { ns = 0 } end
ret Duration { ns = rem }
end
@en "wait"
@fa "انتظار"
pub func wait():
if not this.active: ret end
_sleepUntil(this.deadline_ns)
end
@en "reset"
@fa "بازنشانی"
pub func reset(d: Duration):
this.deadline_ns = _mono_ns() + d.ns
this.active = true
end
@en "stop"
@fa "توقف"
pub func stop():
this.active = false
end
end
@en "Ticker"
@fa "تیک‌زن"
pub struct Ticker:
@en "interval_ns"
@fa "بازه"
pub interval_ns: i64 = 0
@en "next_ns"
@fa "بعدی"
pub next_ns: i64 = 0
@en "active"
@fa "فعال"
pub active: bool = false
@en "dropped"
@fa "از دست رفته"
pub dropped: i64 = 0
@en "fired"
@fa "رخ داده"
pub func fired(): bool:
if not this.active or this.interval_ns <= 0: ret false end
if _mono_ns() < this.next_ns: ret false end
this.advance()
ret true
end
@en "wait"
@fa "انتظار"
pub func wait():
if not this.active or this.interval_ns <= 0: ret end
late := _mono_ns() - this.next_ns
if late >= this.interval_ns:
missed := late / this.interval_ns
this.dropped += missed
this.next_ns += missed * this.interval_ns
end
_sleepUntil(this.next_ns)
this.next_ns += this.interval_ns
end
@en "advance"
@fa "پیشروی"
pub func advance():
this.next_ns += this.interval_ns
now := _mono_ns()
if this.next_ns <= now:
missed := (now - this.next_ns) / this.interval_ns + 1
this.dropped += missed
this.next_ns += missed * this.interval_ns
end
end
@en "remaining"
@fa "باقی‌مانده"
pub func remaining(): Duration:
if not this.active: ret Duration { ns = 0 } end
rem := this.next_ns - _mono_ns()
if rem < 0: ret Duration { ns = 0 } end
ret Duration { ns = rem }
end
@en "reset"
@fa "بازنشانی"
pub func reset(d: Duration):
this.interval_ns = d.ns
this.next_ns = _mono_ns() + d.ns
this.active = d.ns > 0
this.dropped = 0
end
@en "stop"
@fa "توقف"
pub func stop():
this.active = false
end
end
if SALAM_OS_WINDOWS:
if SALAM_ARCH_X86:
func _hiresTimerNew(): void*:
ret CreateWaitableTimerExW(null, null, 2 as u32, 1048578 as u32)
end
else:
func _hiresTimerNew(): void*:
fp := GetProcAddress(GetModuleHandleA("kernel32.dll"), "CreateWaitableTimerExW")
if fp == null: ret null end
f := fp as extern func (void*, void*, u32, u32) void*
ret f(null, null, 2 as u32, 1048578 as u32)
end
end
func _sleepChunk(ns: i64):
mut ms := (ns + 999999) / 1000000
if ms > 1000: ms = 1000 end
SleepEx(ms as u32, 0)
end
func _sleepCoarse(deadline_ns: i64):
until true:
rem := deadline_ns - _mono_ns()
if rem <= 0: break end
if rem > 20000000:
_sleepChunk(rem - 16000000)
else:
SleepEx(0 as u32, 0)
end
end
end
func _sleepUntil(deadline_ns: i64):
if _mono_ns() >= deadline_ns: ret end
if _hires_off:
_sleepCoarse(deadline_ns)
ret
end
h := _hiresTimerNew()
if h == null:
_hires_off = true
_sleepCoarse(deadline_ns)
ret
end
due := mem.Allocate(8 as u64)
dp := due as i64*
until true:
rem := deadline_ns - _mono_ns()
if rem <= 0: break end
dp[0] = 0 - (rem + 99) / 100
if SetWaitableTimer(h, due, 0, null, null, 0) == 0 or WaitForSingleObject(h, 0 - 1) != 0:
_hires_off = true
_sleepCoarse(deadline_ns)
break
end
end
mem.Free(due)
_cl := CloseHandle(h)
end
else:
func _sleepChunk(ns: i64):
mut us := (ns + 999) / 1000
if us > 999999: us = 999999 end
usleep(us as u32)
end
func _sleepUntil(deadline_ns: i64):
until true:
rem := deadline_ns - _mono_ns()
if rem <= 0: break end
_sleepChunk(rem)
end
end
end
@en "NewTimer"
@fa "زمان‌سنج جدید"
pub func NewTimer(d: Duration): Timer:
ret Timer { deadline_ns = _mono_ns() + d.ns, active = true }
end
@en "NewTicker"
@fa "تیک‌زن جدید"
pub func NewTicker(d: Duration): Ticker:
if d.ns <= 0: ret Ticker { interval_ns = 0, next_ns = 0, active = false } end
ret Ticker { interval_ns = d.ns, next_ns = _mono_ns() + d.ns, active = true }
end
@en "AfterFunc"
@fa "پس از"
pub func AfterFunc(d: Duration, fn: func ()):
SleepFor(d)
fn()
end
@en "Every"
@fa "هر"
pub func Every(d: Duration, fn: func () bool): i64:
mut tk := NewTicker(d)
if not tk.active: ret 0 end
mut n := 0 as i64
until true:
tk.wait()
n++
if not fn(): break end
end
ret n
end
@en "RepeatEvery"
@fa "تکرار با فاصله"
pub func RepeatEvery(d: Duration, count: int, fn: func ()):
if count <= 0: ret end
mut tk := NewTicker(d)
if not tk.active: ret end
repeat count:
tk.wait()
fn()
end
end
@en "WaitUntil"
@fa "صبر برای"
pub func WaitUntil(fn: func () bool, poll: Duration, limit: Duration): bool:
mut t := NewTimer(limit)
until true:
if fn(): ret true end
if t.expired(): ret false end
rem := t.remaining()
if poll.ns < rem.ns:
SleepFor(poll)
else:
SleepFor(rem)
end
end
end
package tls
import encoding
import crypto
const SPKI_P256_PREFIX := "3059301306072a8648ce3d020106082a8648ce3d030107034200"
const SPKI_P256_LEN := 91
const P256_POINT_LEN := 65
const P256_SCALAR_LEN := 32
const GCM_TAG_LEN := 16
const GCM_NONCE_LEN := 12
const AES128_KEY_LEN := 16
const AES256_KEY_LEN := 32
func _hexval(c: int): int:
if c >= 48 and c <= 57: ret c - 48 end
if c >= 97 and c <= 102: ret c - 87 end
if c >= 65 and c <= 70: ret c - 55 end
ret 0 - 1
end
func _hex_into(hex: str, dst: void*, off: int): int:
n := hex.len()
if n % 2 != 0: ret 0 - 1 end
mut i := 0
until i < n:
hi := _hexval(hex[i] as int)
lo := _hexval(hex[i + 1] as int)
if hi < 0 or lo < 0: ret 0 - 1 end
_bput(dst, off + i / 2, hi * 16 + lo)
i += 2
end
ret n / 2
end
func _decode(b64: str, want: int): Buf:
mut out := _newbuf(want + 16)
if out.bad: ret out end
_putzeros(out, want + 16)
mut ok := false
mut n := 0
try:
n = encoding.Base64DecodeBytes(b64, out.p, want + 16)
ok = true
catch:
ok = false
end
if not ok or n != want:
out.bad = true
ret out
end
out.len = want
ret out
end
func _decode_any(b64: str): Buf:
cap := b64.len() + 16
mut out := _newbuf(cap)
if out.bad: ret out end
_putzeros(out, cap)
mut ok := false
mut n := 0
try:
n = encoding.Base64DecodeBytes(b64, out.p, cap)
ok = true
catch:
ok = false
end
if not ok or n < 0:
out.bad = true
ret out
end
out.len = n
ret out
end
func _spki_wrap(point: void*): str:
mut der := _newbuf(SPKI_P256_LEN)
defer _buf_free(der)
_putzeros(der, SPKI_P256_LEN)
if _hex_into(SPKI_P256_PREFIX, der.p, 0) < 0: ret "" end
mem.Copy(_bufptr(der, SPKI_P256_LEN - P256_POINT_LEN), point, P256_POINT_LEN as u64)
ret encoding.Base64EncodeBytes(der.p, SPKI_P256_LEN)
end
func _spki_point(spki_b64: str, out &: Buf): bool:
mut der := _decode(spki_b64, SPKI_P256_LEN)
defer _buf_free(der)
if der.bad: ret false end
mut want := _newbuf(SPKI_P256_LEN)
defer _buf_free(want)
_putzeros(want, SPKI_P256_LEN)
if _hex_into(SPKI_P256_PREFIX, want.p, 0) < 0: ret false end
if not _cteq(der.p, want.p, SPKI_P256_LEN - P256_POINT_LEN): ret false end
if _bget(der.p, SPKI_P256_LEN - P256_POINT_LEN) != 4: ret false end
_putraw(out, _bufptr(der, SPKI_P256_LEN - P256_POINT_LEN), P256_POINT_LEN)
ret true
end
func _aes_from(key_b64: str, ok &: bool): Aes:
mut key := _decode_any(key_b64)
defer _buf_wipe(key)
if key.bad or (key.len != AES128_KEY_LEN and key.len != AES256_KEY_LEN):
ok = false
ret Aes {}
end
ok = true
ret _aes_init(key.p, key.len)
end
func _public_of(cv: Curve, scalar: void*): str:
mut point := _newbuf(P256_POINT_LEN)
defer _buf_free(point)
_putzeros(point, P256_POINT_LEN)
_bput(point.p, 0, 4)
if not _ec_base_mul(cv, scalar, _bufptr(point, 1), _bufptr(point, 1 + P256_SCALAR_LEN)):
ret ""
end
ret _spki_wrap(point.p)
end
func _mgf1_xor(seed: void*, slen: int, dst: void*, dlen: int):
mut blk := _newbuf(slen + 4)
defer _buf_free(blk)
mut h := _newbuf(20)
defer _buf_free(h)
_putzeros(h, 20)
hp := h.p as u8*
dp := dst as u8*
mut done := 0
mut cnt := 0 as i64
until done < dlen:
_bufreset(blk)
_putraw(blk, seed, slen)
_put32(blk, cnt)
crypto.Sha1Bytes(blk.p, blk.len, h.p)
repeat 20 in i:
if done + i < dlen:
dp[done + i] = ((dp[done + i] as int) ^ (hp[i] as int)) as u8
end
end
done += 20
cnt++
end
end
@en "EcdhP256Generate"
@fa "تولید کلید ای سی دی اچ"
pub func EcdhP256Generate(priv &: str, pub_spki &: str): bool:
cv := _curve_p256()
mut attempt := 0
until attempt < 8:
candidate := crypto.RandomHex(P256_SCALAR_LEN)
mut scalar := _newbuf(P256_SCALAR_LEN)
_putzeros(scalar, P256_SCALAR_LEN)
if _hex_into(candidate, scalar.p, 0) == P256_SCALAR_LEN:
spki := _public_of(cv, scalar.p)
if spki.len() > 0:
priv = encoding.Base64EncodeBytes(scalar.p, P256_SCALAR_LEN)
pub_spki = spki
_buf_wipe(scalar)
ret true
end
end
_buf_wipe(scalar)
attempt++
end
ret false
end
@en "EcdhP256Shared"
@fa "راز مشترک ای سی دی اچ"
pub func EcdhP256Shared(priv_b64: str, peer_spki_b64: str, ok &: bool): str:
ok = false
mut scalar := _decode(priv_b64, P256_SCALAR_LEN)
defer _buf_wipe(scalar)
if scalar.bad: ret "" end
mut point := _newbuf(P256_POINT_LEN)
defer _buf_free(point)
if not _spki_point(peer_spki_b64, point): ret "" end
mut secret := _newbuf(P256_SCALAR_LEN)
defer _buf_wipe(secret)
_putzeros(secret, P256_SCALAR_LEN)
if not _ec_ecdh(_curve_p256(), scalar.p, point.p, P256_POINT_LEN, secret.p): ret "" end
ok = true
ret encoding.Base64EncodeBytes(secret.p, P256_SCALAR_LEN)
end
@en "HkdfSha256"
@fa "اچ کی دی اف شا۲۵۶"
pub func HkdfSha256(ikm_b64: str, salt_b64: str, info: str, out_len: int, ok &: bool): str:
ok = false
mut ikm := _decode_any(ikm_b64)
defer _buf_wipe(ikm)
mut salt := _decode_any(salt_b64)
defer _buf_free(salt)
if ikm.bad or salt.bad or out_len <= 0: ret "" end
mut prk := _newbuf(32)
defer _buf_wipe(prk)
_putzeros(prk, 32)
_hkdf_extract(HASH_SHA256, salt.p, salt.len, ikm.p, ikm.len, prk.p)
mut out := _newbuf(out_len)
defer _buf_wipe(out)
_putzeros(out, out_len)
mut label := _newbuf(info.len() + 1)
defer _buf_free(label)
_putstr(label, info)
if not _hkdf_expand(HASH_SHA256, prk.p, 32, label.p, info.len(), out.p, out_len): ret "" end
ok = true
ret encoding.Base64EncodeBytes(out.p, out_len)
end
@en "AesGcmSeal"
@fa "مهر ای ای اس جی سی ام"
pub func AesGcmSeal(key_b64: str, nonce_b64: str, plaintext: str, ok &: bool): str:
ok = false
mut aes_ok := false
mut a := _aes_from(key_b64, aes_ok)
defer _aes_free(a)
mut nonce := _decode(nonce_b64, GCM_NONCE_LEN)
defer _buf_free(nonce)
if not aes_ok or nonce.bad: ret "" end
n := plaintext.len()
mut pt := _newbuf(n + 1)
defer _buf_wipe(pt)
_putstr(pt, plaintext)
mut out := _newbuf(n + GCM_TAG_LEN)
defer _buf_free(out)
_putzeros(out, n + GCM_TAG_LEN)
_gcm_seal(a, nonce.p, null, 0, pt.p, out.p, n, _bufptr(out, n))
ok = true
ret encoding.Base64EncodeBytes(out.p, n + GCM_TAG_LEN)
end
@en "AesGcmOpen"
@fa "گشودن ای ای اس جی سی ام"
pub func AesGcmOpen(key_b64: str, nonce_b64: str, sealed_b64: str, ok &: bool): str:
ok = false
mut aes_ok := false
mut a := _aes_from(key_b64, aes_ok)
defer _aes_free(a)
mut nonce := _decode(nonce_b64, GCM_NONCE_LEN)
defer _buf_free(nonce)
mut sealed := _decode_any(sealed_b64)
defer _buf_free(sealed)
if not aes_ok or nonce.bad or sealed.bad or sealed.len <= GCM_TAG_LEN: ret "" end
n := sealed.len - GCM_TAG_LEN
mut pt := _newbuf(n + 1)
defer _buf_wipe(pt)
_putzeros(pt, n + 1)
if not _gcm_open(a, nonce.p, null, 0, sealed.p, n, _bufptr(sealed, n), pt.p): ret "" end
ok = true
ret _bufstr(pt)
end
@en "GcmNonce"
@fa "نانس جی سی ام"
pub func GcmNonce(counter: i64): str:
mut n := _newbuf(GCM_NONCE_LEN)
defer _buf_free(n)
_putzeros(n, 4)
_put64(n, counter as u64)
ret encoding.Base64EncodeBytes(n.p, GCM_NONCE_LEN)
end
@en "RandomSalt"
@fa "نمک تصادفی"
pub func RandomSalt(n: int): str:
mut b := _newbuf(n)
defer _buf_free(b)
_putzeros(b, n)
hex := crypto.RandomHex(n)
if _hex_into(hex, b.p, 0) != n: ret "" end
ret encoding.Base64EncodeBytes(b.p, n)
end
@en "EcdhP256PublicPoint"
@fa "نقطه عمومی ای سی دی اچ"
pub func EcdhP256PublicPoint(priv_b64: str): str:
mut scalar := _decode(priv_b64, P256_SCALAR_LEN)
defer _buf_wipe(scalar)
if scalar.bad: ret "" end
