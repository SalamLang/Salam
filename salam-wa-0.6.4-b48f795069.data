tp[0].have += take
at += take
if tp[0].have == 512:
tp[0].have = 0
_tp_block(tp)
end
else st == _TP_META:
mut take := tp[0].meta_left
if take > room:
take = room
end
compress.BufPushBytes(tp[0].mini, src, take)
tp[0].meta_left -= take
at += take
if tp[0].meta_left == 0:
tp[0].state = _TP_HDR
end
else st == _TP_DATA or st == _TP_SKIP:
mut take := room
if (take as i64) > tp[0].left:
take = tp[0].left as int
end
if st == _TP_DATA and not tp[0].sink.over and not tp[0].sink.failed:
_ := compress.SinkWrite(tp[0].sink, src, take)
end
tp[0].left -= take as i64
at += take
if tp[0].left == (0 as i64):
if st == _TP_DATA:
_tp_after_data(tp)
else tp[0].pad > 0:
tp[0].state = _TP_PAD
else:
tp[0].state = _TP_HDR
end
end
else st == _TP_PAD:
mut take := tp[0].pad
if take > room:
take = room
end
tp[0].pad -= take
at += take
if tp[0].pad == 0:
tp[0].state = _TP_HDR
end
else:
at = n
end
end
end
func _tp_end(tp: _TarPush*): int:
st := tp[0].state
if not tp[0].stop and (st == _TP_DATA or st == _TP_SKIP or st == _TP_PAD or st == _TP_META or tp[0].have > 0):
