@fa "پاسخ ای پی آی"
pub struct ApiResponse:
@en "ok"
@fa "موفق"
pub ok: bool = false
@en "result"
@fa "نتیجه"
pub result: str = ""
@en "description"
@fa "توضیح"
pub description: str = ""
@en "error_code"
@fa "کد خطا"
pub error_code: i64 = 0
@en "http_status"
@fa "وضعیت اچ تی تی پی"
pub http_status: int = 0
@en "http_err"
@fa "خطای شبکه"
pub http_err: str = ""
end
