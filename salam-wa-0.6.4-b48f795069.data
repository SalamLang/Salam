package yaml
@en "Get"
@fa "دریافت"
pub func Get(text: str, path: str): str:
c := Parse(text)
r := _resolve_path(c, path)
if r.ok == false: ret "" end
v := r.value
if v.len() >= 2 and v.starts_with("\""):
ret _json_unescape(v.substr(1, v.len() - 2))
end
if v == "null": ret "" end
ret v
end
@en "Has"
@fa "دارد"
pub func Has(text: str, path: str): bool:
c := Parse(text)
r := _resolve_path(c, path)
ret r.ok
end
@en "GetInt"
@fa "دریافت عدد"
pub func GetInt(text: str, path: str): int:
ret conv.AtoiOr(Get(text, path), 0)
end
if not SALAM_KERNEL:
@en "GetFloat"
@fa "دریافت اعشار"
pub func GetFloat(text: str, path: str): f64:
ret conv.ParseFloatOr(Get(text, path), 0.0)
end
end
@en "GetBool"
@fa "دریافت منطقی"
pub func GetBool(text: str, path: str): bool:
ret Get(text, path) == "true"
end
@en "TypeOf"
@fa "نوع"
pub func TypeOf(text: str, path: str): str:
c := Parse(text)
r := _resolve_path(c, path)
if r.ok == false: ret "none" end
v := r.value
if v.len() == 0: ret "none" end
c0 := v.substr(0, 1)
if c0 == `"`: ret "string" end
if c0 == "{": ret "map" end
if c0 == "[": ret "list" end
if v == "true" or v == "false": ret "bool" end
if v == "null": ret "null" end
if _looks_numeric(v):
if v.find(".") >= 0 or v.find("e") >= 0 or v.find("E") >= 0: ret "float" end
ret "int"
end
ret "string"
end
@en "Len"
@fa "طول"
pub func Len(text: str, path: str): int:
c := Parse(text)
r := _resolve_path(c, path)
if r.ok == false: ret 0 - 1 end
v := r.value
if v.len() == 0: ret 0 - 1 end
c0 := v.substr(0, 1)
if c0 == "[": ret _count_elems(v, false) end
if c0 == "{": ret _count_elems(v, true) end
ret 0 - 1
end
@en "Keys"
@fa "کلیدها"
pub func Keys(text: str, path: str): Vector<str>:
out := Vector {} as Vector<str>
c := Parse(text)
r := _resolve_path(c, path)
if r.ok == false: ret out end
v := r.value
if v.len() == 0 or not v.starts_with("{"): ret out end
n := v.len()
bp := _bp(v)
mut p := _cws(v, n, 1)
if p < n and _ub(bp, p) == 125: ret out end
until p < n:
p = _cws(v, n, p)
ks := p
ke := _cstr_end(v, n, p)
rawslice := _ysub(v, ks + 1, ke - ks - 2)
out.push(_json_unescape(rawslice))
mem.Free(rawslice as void *)
p = _cws(v, n, ke)
if p < n and _ub(bp, p) == 58: p++ end
vs := _cws(v, n, p)
ve := _cval_end(v, n, vs)
p = _cws(v, n, ve)
if p < n and _ub(bp, p) == 44:
p++
continue
end
break
end
ret out
end
@en "HasKeys"
@fa "دارد کلیدها"
pub func HasKeys(text: str, required: Vector<str>): bool:
ks := Keys(text, "")
defer ks.free()
mut all_ok := true
repeat required.len() in i:
want := required.get(i)
mut found := false
repeat ks.len() in j:
if ks.get(j) == want: found = true end
end
if found == false: all_ok = false end
end
ret all_ok
end
package yaml
if not SALAM_KERNEL:
import encoding.value
import encoding.json
@en "Decode"
@fa "کدگشایی"
pub func Decode(text: str): value.Value throws:
try:
ret json.Decode(ToJSON(text))
catch e:
throw Error.New(e.kind, e.message).with_code(e.code).wrap("yaml")
end
end
@en "Encode"
@fa "کدگذاری"
pub func Encode(v: value.Value): str:
ret Dump(json.EncodeDefault(v))
end
end
@en "yaml"
@fa "یامل"
package yaml
import str
import conv
import mem
struct _YR:
pub value: str = ""
pub next: int = 0
pub ok: bool = true
end
inline pure func _bp(s: str): i8*: ret (s as void*) as i8* end
inline pure func _ub(bp: i8*, i: int): int:
mut v := bp[i] as int
if v < 0: v += 256 end
ret v
end
func _raw_indent(raw: str): int:
n := raw.len()
bp := _bp(raw)
mut i := 0
until i < n and _ub(bp, i) == 32:
i++
end
ret i
end
func _content(raw: str): str:
n := raw.len()
bp := _bp(raw)
mut i := 0
mut inq := 0
mut cut := n
until i < n:
c := _ub(bp, i)
if inq == 1:
if c == 92 and i + 1 < n:
i++
else c == 34:
inq = 0
end
else inq == 2:
if c == 39:
if i + 1 < n and _ub(bp, i + 1) == 39:
i++
else:
inq = 0
end
end
else:
if c == 34:
inq = 1
else c == 39:
inq = 2
else c == 35:
if i == 0 or _ub(bp, i - 1) == 32 or _ub(bp, i - 1) == 9:
cut = i
break
end
end
end
i++
end
head := raw.substr(0, cut)
out := str.TrimRight(head)
mem.Free(head as void *)
ret out
end
func _indent_of(content: str): int:
n := content.len()
bp := _bp(content)
mut i := 0
until i < n and _ub(bp, i) == 32:
i++
end
ret i
end
func _skip_noise(lines: Vector<str>, li: int): int:
n := lines.len()
mut i := li
until i < n:
c := _content(lines.get(i))
t := str.Trim(c)
blank := t == ""
mem.Free(t as void *)
mem.Free(c as void *)
if blank:
i++
else:
break
end
end
ret i
end
func _is_seq_item(t: str): bool:
if t == "-": ret true end
if t.len() >= 2 and t.starts_with("- "): ret true end
ret false
end
func _key_colon_pos(t: str): int:
