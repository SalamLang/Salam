@en "postgres"
@fa "پستگرس"
package postgres
import str
import conv
import db
const CONNECTION_OK := 0
const PGRES_EMPTY_QUERY := 0
const PGRES_COMMAND_OK := 1
const PGRES_TUPLES_OK := 2
const OID_BOOL := 16
const OID_BYTEA := 17
const OID_INT8 := 20
const OID_INT2 := 21
const OID_INT4 := 23
const OID_FLOAT4 := 700
const OID_FLOAT8 := 701
const OID_NUMERIC := 1700
@en "Database"
@fa "پایگاه داده"
pub struct Database:
@en "handle"
@fa "دسته"
pub handle: void* = null
@en "affected"
@fa "تاثیرپذیرفته"
pub affected: i64 = 0
@en "Kind"
@fa "نوع"
pub func Kind(): str: ret db.POSTGRES end
@en "Ok"
@fa "معتبر"
pub func Ok(): bool:
if this.handle == null:
ret false
end
ret _pq_status(this.handle) == CONNECTION_OK
end
@en "Ping"
@fa "پینگ"
pub func Ping(): bool:
if this.handle == null:
ret false
end
if _pq_status(this.handle) != CONNECTION_OK:
ret false
end
res := _pq_exec(this.handle, "SELECT 1")
if res == null:
ret false
end
good := _pq_result_status(res) == PGRES_TUPLES_OK
_pq_clear(res)
ret good
end
@en "Exec"
@fa "اجرا"
pub func Exec(sql: str): int:
this.affected = 0
if this.handle == null:
ret -1
end
res := _pq_exec(this.handle, sql)
if res == null:
ret -1
end
st := _pq_result_status(res)
if st == PGRES_COMMAND_OK or st == PGRES_TUPLES_OK:
n := str.Clone(_pq_cmd_tuples(res))
if n != "":
this.affected = conv.ParseIntOr(n, 0)
end
end
_pq_clear(res)
if st == PGRES_COMMAND_OK or st == PGRES_TUPLES_OK or st == PGRES_EMPTY_QUERY:
ret 0
end
ret -1
end
@en "Query"
@fa "پرسمان"
pub func Query(sql: str): dyn db.Rows:
if this.handle == null:
ret Rows { handle = null }
end
res := _pq_exec(this.handle, sql)
if res == null:
ret Rows { handle = null }
end
if _pq_result_status(res) != PGRES_TUPLES_OK:
_pq_clear(res)
ret Rows { handle = null }
end
ret Rows { handle = res, row = -1, count = _pq_ntuples(res) }
end
@en "Begin"
@fa "شروع تراکنش"
pub func Begin(): dyn db.Tx:
if this.Exec("BEGIN") != 0:
ret Txn { handle = null }
end
ret Txn { handle = this.handle }
end
@en "LastInsertId"
@fa "شناسه آخرین درج"
pub func LastInsertId(): i64:
if this.handle == null:
ret 0
end
res := _pq_exec(this.handle, "SELECT lastval()")
if res == null:
ret 0
end
mut out := 0 as i64
if _pq_result_status(res) == PGRES_TUPLES_OK and _pq_ntuples(res) > 0:
p := _pq_getvalue(res, 0, 0)
if p != null:
out = conv.ParseIntOr(p as str, 0)
end
end
_pq_clear(res)
ret out
end
@en "Changes"
@fa "تعداد تغییرات"
pub func Changes(): i64: ret this.affected end
@en "Error"
@fa "خطا"
pub func Error(): str:
if this.handle == null:
ret "no connection"
end
ret str.Clone(_pq_error_message(this.handle))
end
@en "Quote"
@fa "نقل قول"
pub func Quote(s: str): str:
if this.handle == null:
ret db.QuoteLiteral(s)
end
p := _pq_escape_literal(this.handle, s, len(s) as u64)
if p == null:
ret db.QuoteLiteral(s)
end
out := str.Clone(p as str)
_pq_freemem(p)
ret out
end
@en "Close"
@fa "بستن"
pub func Close(): int:
if this.handle == null:
ret -1
end
_pq_finish(this.handle)
ret 0
end
end
@en "Rows"
@fa "ردیف ها"
pub struct Rows:
@en "handle"
@fa "دسته"
pub handle: void* = null
@en "row"
@fa "ردیف"
pub row: int = -1
@en "count"
@fa "تعداد"
pub count: int = 0
@en "Ok"
@fa "معتبر"
pub func Ok(): bool: ret this.handle != null end
@en "Next"
@fa "بعدی"
pub func Next(): bool:
if this.handle == null:
ret false
end
if this.row + 1 < this.count:
this.row++
ret true
end
ret false
end
@en "ColumnCount"
@fa "تعداد ستون"
pub func ColumnCount(): int:
if this.handle == null:
ret 0
end
ret _pq_nfields(this.handle)
end
@en "RowCount"
@fa "تعداد ردیف"
pub func RowCount(): int: ret this.count end
@en "ColumnName"
@fa "نام ستون"
pub func ColumnName(col: int): str:
if this.handle == null:
ret ""
end
ret str.Clone(_pq_fname(this.handle, col))
end
@en "ColumnType"
@fa "نوع ستون"
pub func ColumnType(col: int): int:
if this.handle == null or this.row < 0:
ret db.TYPE_NULL
end
if _pq_getisnull(this.handle, this.row, col) != 0:
ret db.TYPE_NULL
end
oid := _pq_ftype(this.handle, col) as int
if oid == OID_INT2 or oid == OID_INT4 or oid == OID_INT8 or oid == OID_BOOL:
ret db.TYPE_INT
end
if oid == OID_FLOAT4 or oid == OID_FLOAT8 or oid == OID_NUMERIC:
ret db.TYPE_FLOAT
end
if oid == OID_BYTEA:
ret db.TYPE_BLOB
end
ret db.TYPE_TEXT
end
@en "IsNull"
@fa "خالی است"
pub func IsNull(col: int): bool:
if this.handle == null or this.row < 0:
ret true
end
ret _pq_getisnull(this.handle, this.row, col) != 0
end
@en "Text"
@fa "متن"
pub func Text(col: int): str:
if this.handle == null or this.row < 0:
ret ""
end
if _pq_getisnull(this.handle, this.row, col) != 0:
ret ""
end
p := _pq_getvalue(this.handle, this.row, col)
if p == null:
ret ""
end
ret str.Clone(p as str)
end
@en "Int"
@fa "عدد صحیح"
pub func Int(col: int): int: ret this.Int64(col) as int end
@en "Int64"
@fa "عدد صحیح۶۴"
pub func Int64(col: int): i64:
s := this.Text(col)
if s == "":
ret 0
end
if s == "t":
ret 1
end
if s == "f":
ret 0
end
ret _pg_int(s)
end
@en "Float"
@fa "عدد اعشار"
pub func Float(col: int): f64:
s := this.Text(col)
if s == "":
ret 0.0
end
ret conv.ParseFloatOr(s, 0.0)
end
@en "Close"
@fa "بستن"
pub func Close(): int:
if this.handle == null:
ret -1
end
_pq_clear(this.handle)
this.handle = null
ret 0
end
end
@en "Txn"
@fa "تراکنش"
pub struct Txn:
@en "handle"
@fa "دسته"
pub handle: void* = null
@en "Ok"
@fa "معتبر"
pub func Ok(): bool: ret this.handle != null end
@en "Exec"
@fa "اجرا"
pub func Exec(sql: str): int:
