end
inline func _zb_peek(r &: _ZBr, n: int): int:
if n == 0:
ret 0
end
start := r.pos - n
mut v := 0 as i64
if start >= 0:
idx := start >> 3
sh := start & 7
cnt := (sh + n + 7) >> 3
mut k := 0
until k < cnt:
v |= (r.p[idx + k] as i64) << (8 * k)
k++
end
ret ((v >> sh) & (((1 as i64) << n) - 1)) as int
end
if r.pos <= 0:
ret 0
end
cnt := (r.pos + 7) >> 3
mut k := 0
until k < cnt:
v |= (r.p[k] as i64) << (8 * k)
k++
end
v &= ((1 as i64) << r.pos) - 1
ret (v << (0 - start)) as int
end
inline func _zb_read(r &: _ZBr, n: int): int:
