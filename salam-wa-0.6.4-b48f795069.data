end
d.have_tables = true
end
if not d.have_tables:
ret 4
end
until b.pos < bend:
sym := _rh_decode(d.ld, b)
if sym < 0:
ret 4
end
if sym < 256:
d.win[d.wp] = sym as u8
d.wp = (d.wp + 1) & d.wmask
d.total++
else sym == 256:
fs := _r5_read_fdata(b)
fl := _r5_read_fdata(b)
kind := _rb_read(b, 3)
mut ch := 0
if kind == 0:
ch = _rb_read(b, 5) + 1
end
if fl > 0 and fl <= 0x400000:
d.filters.push(_R5Filter { start = (d.total - start_total) + fs, len = fl, kind = kind, ch = ch })
end
else:
mut ml := 0
mut dist := 0 as i64
if sym == 257:
ml = d.last_len
dist = d.od[0]
if ml == 0:
continue
end
else sym < 262:
idx := sym - 258
dist = d.od[idx]
mut j := idx
until j > 0:
d.od[j] = d.od[j - 1]
j--
end
d.od[0] = dist
slot := _rh_decode(d.rd, b)
if slot < 0:
ret 4
end
ml = _r5_slot_len(b, slot)
d.last_len = ml
else:
ml = _r5_slot_len(b, sym - 262)
dslot := _rh_decode(d.dd, b)
if dslot < 0:
ret 4
end
dist = 1 as i64
if dslot < 4:
dist += dslot as i64
else:
dbits := (dslot >> 1) - 1
dist += ((2 | (dslot & 1)) as i64) << dbits
if dbits >= 4:
if dbits > 4:
dist += _rb_read64(b, dbits - 4) << 4
end
low := _rh_decode(d.ldd, b)
if low < 0:
ret 4
end
dist += low as i64
else:
dist += _rb_read(b, dbits) as i64
end
end
if dist > 0x100:
ml++
if dist > 0x2000:
ml++
if dist > 0x40000:
ml++
end
end
end
mut j2 := 3
until j2 > 0:
d.od[j2] = d.od[j2 - 1]
j2--
end
d.od[0] = dist
d.last_len = ml
end
if not _r5_copy(d, ml, dist):
ret 4
end
end
done := d.total - start_total
if done > limit:
ret 7
end
if unp >= 0 and done > unp:
ret 4
end
if ((d.wp - d.fl) & d.wmask) >= (d.wsize >> 1):
_r5_flush(d, out)
if stream and not _r5_drain(d, out, sink, drained, false):
ret 7
end
end
end
if b.pos > bend:
ret 4
end
end
_r5_flush(d, out)
produced := d.total - start_total
if unp >= 0 and produced != unp:
ret 4
end
if stream:
if not _r5_drain(d, out, sink, drained, true):
ret sink.over ? 7 : 4
end
ret 0
end
if not _r5_apply_filters(d, out, base, produced):
ret 4
end
ret 0
end
func _r5_setwin(d &: _R5, wsize: int): bool:
if wsize == d.wsize:
ret true
end
mem.Free(d.win as void*)
d.win = mem.AllocateZeroed(wsize as u64) as u8*
if d.win == null:
d.wsize = 0
d.wmask = 0
ret false
end
d.wsize = wsize
d.wmask = wsize - 1
ret true
end
