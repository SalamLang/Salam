tbl = d.off
maxlog = 8
maxsym = 31
else which == 2:
tbl = d.ml
maxsym = 52
end
mut log := 0 - 1
if mode == 0:
log = _zs_predef(d, tbl, which)
else mode == 1:
if pos >= qn:
ret false
end
sym := q[pos] as int
pos++
if sym > maxsym:
ret false
end
tbl[0] = sym as u32
log = 0
else mode == 2:
mut nsym := 0
used := _zs_read_norm(d, _zs_at(q, pos), qn - pos, maxlog, maxsym, log, nsym)
if used < 0:
ret false
end
pos += used
if not _zs_build_dt(d, tbl, log, nsym):
ret false
end
else:
if which == 0:
log = d.llog
else which == 1:
log = d.olog
else:
log = d.mlog
end
end
if log < 0:
ret false
end
if which == 0:
d.llog = log
else which == 1:
d.olog = log
else:
d.mlog = log
end
ret true
end
func _zs_hist_byte(d &: _Zd, bp: u8*, v: int): int:
