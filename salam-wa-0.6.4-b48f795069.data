@en "fragment_max"
@fa "بیشینه تکه"
pub fragment_max: int = 20
@en "fragment_delay_ms"
@fa "تاخیر تکه میلی ثانیه"
pub fragment_delay_ms: int = 10
@en "cert_file"
@fa "پرونده گواهی"
pub cert_file: str = ""
@en "key_file"
@fa "پرونده کلید"
pub key_file: str = ""
@en "timeout_ms"
@fa "مهلت میلی ثانیه"
pub timeout_ms: int = 0
@en "read_timeout_ms"
@fa "مهلت بی کاری خواندن"
pub read_timeout_ms: int = 0
@en "write_timeout_ms"
@fa "مهلت بی کاری نوشتن"
pub write_timeout_ms: int = 0
@en "fragment_mode"
@fa "حالت تکه تکه کردن"
pub fragment_mode: str = "tcp"
@en "fragment_sni"
@fa "برش نام سرور"
pub fragment_sni: bool = false
@en "fragment_writes"
@fa "شمار نوشتن های تکه شده"
pub fragment_writes: int = 1
