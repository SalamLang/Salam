@en "AddMember"
@fa "افزودن عضو"
pub func AddMember(obj: str, key: str, raw: str): str:
body := _os_strip_obj(obj)
member := _os_m(key, raw)
if body.len() == 0: ret "{" + member + "}" end
ret "{" + body + "," + member + "}"
end
@en "SearchBody"
@fa "بدنه جستجو"
pub func SearchBody(req: SearchRequest): str:
mut m := Vector {} as Vector<str>
if req.query.len() > 0: m.push(_os_m("query", req.query)) end
if req.from >= 0: m.push(_os_m("from", str.FromInt(req.from as i64))) end
if req.size >= 0: m.push(_os_m("size", str.FromInt(req.size as i64))) end
if req.sort.len() > 0: m.push(_os_m("sort", _os_arr(req.sort))) end
if req.no_source:
m.push(_os_m("_source", "false"))
else req.source.len() > 0 or req.source_excludes.len() > 0:
mut src := Vector {} as Vector<str>
if req.source.len() > 0: src.push(_os_m("includes", _os_strs(req.source))) end
if req.source_excludes.len() > 0: src.push(_os_m("excludes", _os_strs(req.source_excludes))) end
m.push(_os_m("_source", _os_obj(src)))
end
if req.fields.len() > 0: m.push(_os_m("fields", _os_strs(req.fields))) end
if req.docvalue_fields.len() > 0: m.push(_os_m("docvalue_fields", _os_strs(req.docvalue_fields))) end
if req.aggs.len() > 0: m.push(_os_m("aggs", req.aggs)) end
if req.highlight.len() > 0: m.push(_os_m("highlight", req.highlight)) end
if req.post_filter.len() > 0: m.push(_os_m("post_filter", req.post_filter)) end
if req.collapse.len() > 0: m.push(_os_m("collapse", req.collapse)) end
if req.suggest.len() > 0: m.push(_os_m("suggest", req.suggest)) end
if req.rescore.len() > 0: m.push(_os_m("rescore", req.rescore)) end
if req.script_fields.len() > 0: m.push(_os_m("script_fields", req.script_fields)) end
if req.search_after.len() > 0: m.push(_os_m("search_after", req.search_after)) end
if req.pit_id.len() > 0:
mut pit := Vector {} as Vector<str>
pit.push(_os_m("id", json.Str(req.pit_id)))
if req.pit_keep_alive.len() > 0: pit.push(_os_m("keep_alive", json.Str(req.pit_keep_alive))) end
m.push(_os_m("pit", _os_obj(pit)))
end
if req.track_total_hits.len() > 0:
tth := req.track_total_hits
if tth == "true" or tth == "false" or str.IsDigit(char_code(tth.substr(0, 1))):
m.push(_os_m("track_total_hits", tth))
else:
m.push(_os_m("track_total_hits", json.Str(tth)))
end
end
if req.track_scores: m.push(_os_m("track_scores", "true")) end
if req.min_score.len() > 0: m.push(_os_m("min_score", req.min_score)) end
if req.timeout.len() > 0: m.push(_os_m("timeout", json.Str(req.timeout))) end
if req.explain: m.push(_os_m("explain", "true")) end
if req.version: m.push(_os_m("version", "true")) end
if req.seq_no_primary_term: m.push(_os_m("seq_no_primary_term", "true")) end
if req.ext.len() > 0: m.push(_os_m("ext", req.ext)) end
each e in req.extra:
m.push(e)
end
ret _os_obj(m)
end
package opensearch
import str
import conv
import encoding.json
@en "SearchParams"
@fa "پارامترهای جستجو"
pub struct SearchParams:
@en "routing"
@fa "مسیریابی"
pub routing: str = ""
@en "preference"
@fa "ترجیح"
pub preference: str = ""
@en "search_pipeline"
@fa "خط لوله جستجو"
pub search_pipeline: str = ""
@en "search_type"
@fa "نوع جستجو"
pub search_type: str = ""
@en "scroll"
@fa "پیمایش"
pub scroll: str = ""
@en "request_cache"
@fa "حافظه نهان درخواست"
pub request_cache: str = ""
@en "allow_partial_search_results"
@fa "اجازه نتیجه ناقص"
pub allow_partial_search_results: str = ""
@en "ignore_unavailable"
@fa "نادیده گرفتن ناموجود"
pub ignore_unavailable: bool = false
end
func _os_hit(raw: str): Hit:
mut h := Hit { raw = raw }
h.index = _os_jstr(raw, "_index")
h.id = _os_jstr(raw, "_id")
h.score = _os_f64(_os_jraw(raw, "_score"))
h.source = _os_jraw(raw, "_source")
h.sort = _os_jraw(raw, "sort")
h.highlight = _os_jraw(raw, "highlight")
h.fields = _os_jraw(raw, "fields")
h.inner_hits = _os_jraw(raw, "inner_hits")
h.matched_queries = _os_jraw(raw, "matched_queries")
ret h
end
func _os_search_body(body: str, status: int, ok: bool, err: str): SearchResult:
mut s := SearchResult { ok = ok, status = status, error = err, raw = body }
if body.len() == 0: ret s end
s.took = _os_ji64(body, "took", 0)
s.timed_out = _os_jbool(body, "timed_out")
s.scroll_id = _os_jstr(body, "_scroll_id")
s.pit_id = _os_jstr(body, "pit_id")
hits := _os_jraw(body, "hits")
total := _os_jraw(hits, "total")
if str.StartsWith(total, "{"):
s.total = _os_ji64(total, "value", 0)
s.total_relation = _os_jstr(total, "relation")
else total.len() > 0:
s.total = _os_i64(total)
s.total_relation = "eq"
end
s.max_score = _os_f64(_os_jraw(hits, "max_score"))
mut list := Vector {} as Vector<Hit>
each h in _os_items(_os_jraw(hits, "hits")):
list.push(_os_hit(h))
end
s.hits = list
s.aggregations = _os_jraw(body, "aggregations")
s.suggest = _os_jraw(body, "suggest")
ret s
end
func _os_search_result(r: Response): SearchResult:
ret _os_search_body(r.body, r.status, r.ok, r.error)
end
func _os_params_query(q &: Vector<str>, p: SearchParams):
_os_qadd(q, "routing", p.routing)
_os_qadd(q, "preference", p.preference)
_os_qadd(q, "search_pipeline", p.search_pipeline)
_os_qadd(q, "search_type", p.search_type)
_os_qadd(q, "scroll", p.scroll)
_os_qadd(q, "request_cache", p.request_cache)
_os_qadd(q, "allow_partial_search_results", p.allow_partial_search_results)
if p.ignore_unavailable: _os_qadd(q, "ignore_unavailable", "true") end
end
func _os_search_path(index: str): str:
if index.len() == 0: ret str.Clone("/_search") end
ret "/" + _os_idx(index) + "/_search"
end
@en "Search"
@fa "جستجو"
pub func Search(c: Client, index: str, query: str): SearchResult:
ret SearchWith(c, index, SearchRequest { query = query })
end
@en "SearchWith"
@fa "جستجو با درخواست"
pub func SearchWith(c: Client, index: str, req: SearchRequest): SearchResult:
path := req.pit_id.len() > 0 ? "/_search" : _os_search_path(index)
ret _os_search_result(Perform(c, "POST", path, SearchBody(req)))
end
@en "SearchRaw"
@fa "جستجوی خام"
pub func SearchRaw(c: Client, index: str, body: str): SearchResult:
ret _os_search_result(Perform(c, "POST", _os_search_path(index), _os_body_or_empty(body)))
end
