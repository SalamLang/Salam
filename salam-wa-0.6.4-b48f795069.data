@en "tls"
@fa "تی ال اس"
package tls
@en "TLS10"
@fa "تی ال اس۱۰"
pub const TLS10 := 0x0301
@en "TLS11"
@fa "تی ال اس۱۱"
pub const TLS11 := 0x0302
@en "TLS12"
@fa "تی ال اس۱۲"
pub const TLS12 := 0x0303
@en "TLS13"
@fa "تی ال اس۱۳"
pub const TLS13 := 0x0304
@en "HexEncodeBuf"
@fa "کدگذاری شانزدهی"
pub func HexEncodeBuf(b: Buf): str:
ret _hexofbuf(b)
end
@en "HexDecodeBuf"
@fa "کدگشایی شانزدهی"
pub func HexDecodeBuf(s: str): Buf:
ret _hexbuf(s)
end
@en "NewBuf"
@fa "بافر جدید"
pub func NewBuf(cap: int): Buf:
ret _newbuf(cap)
end
@en "NewZeroBuf"
@fa "بافر صفر جدید"
pub func NewZeroBuf(n: int): Buf:
mut b := _newbuf(n)
_putzeros(b, n)
ret b
end
@en "FreeBuf"
@fa "آزادسازی بافر"
pub func FreeBuf(b &: Buf):
_buf_free(b)
end
@en "WipeBuf"
@fa "پاک سازی بافر"
pub func WipeBuf(b &: Buf):
_buf_wipe(b)
end
@en "BufLen"
@fa "طول بافر"
pub func BufLen(b: Buf): int:
ret b.len
end
@en "BufAppendStr"
@fa "افزودن رشته به بافر"
pub func BufAppendStr(b &: Buf, s: str):
_putstr(b, s)
end
@en "LoadRoots"
@fa "بارگذاری ریشه ها"
pub func LoadRoots(ca_file: str): Roots:
ret _roots_load(ca_file)
end
@en "RootCount"
@fa "تعداد ریشه ها"
pub func RootCount(r: Roots): int:
ret r.count
end
@en "FreeRoots"
@fa "آزادسازی ریشه ها"
pub func FreeRoots(r &: Roots):
_roots_free(r)
end
@en "VerifyError"
@fa "خطای تایید"
pub func VerifyError(code: int): str:
ret _verr_str(code)
end
@en "VerifyCert"
@fa "تایید گواهی"
pub func VerifyCert(der: Buf, roots: Roots, host: str): int:
mut ch: Reader[8]
repeat 8 in i:
ch[i] = _newreader(null, 0)
end
ch[0] = _readerof(der)
ret _verify_chain(ch, 1, roots, host, _now_stamp())
end
@en "CertIsValid"
@fa "گواهی معتبر است"
pub func CertIsValid(der: Buf): bool:
c := _cert_parse(der.p, der.len)
ret c.ok
end
@en "CertSubjectCN"
@fa "نام مشترک گواهی"
pub func CertSubjectCN(der: Buf): str:
c := _cert_parse(der.p, der.len)
if not c.ok:
ret ""
end
ret c.subject_cn
end
@en "HashDigest"
@fa "درهم ساز"
pub func HashDigest(sha384: bool, msg: str): Buf:
mut kind := 0
mut hlen := 32
if sha384:
kind = HASH_SHA384
hlen = 48
end
mut d := _newbuf(hlen)
_putzeros(d, hlen)
_hash_oneshot(kind, msg as void*, msg.len(), d.p)
ret d
end
@en "SignRSAPKCS1"
@fa "امضای آر اس ای پی کی سی اس یک"
pub func SignRSAPKCS1(k: PrivateKey, sha384: bool, digest: Buf, sigout &: Buf): bool:
mut kind := 0
if sha384:
kind = HASH_SHA384
end
if sigout.cap < k.rsa_n.len:
ret false
end
ok := _rsa_sign_pkcs1(kind, digest.p, k.rsa_n, k.rsa_crt, sigout.p)
if ok:
sigout.len = k.rsa_n.len
end
ret ok
end
@en "SignRSAPSS"
@fa "امضای آر اس ای پی اس اس"
pub func SignRSAPSS(k: PrivateKey, sha384: bool, digest: Buf, sigout &: Buf): bool:
mut kind := 0
mut slen := 32
if sha384:
kind = HASH_SHA384
slen = 48
end
if sigout.cap < k.rsa_n.len:
ret false
end
ok := _rsa_sign_pss(kind, digest.p, k.rsa_n, k.rsa_crt, slen, sigout.p)
if ok:
sigout.len = k.rsa_n.len
end
ret ok
end
@en "SignECDSA"
@fa "امضای بیضوی"
pub func SignECDSA(k: PrivateKey, digest: Buf, rout: Buf, sout: Buf): bool:
if k.pk_alg == PK_EC_P384:
ret _ecdsa_sign(_curve_p384(), HASH_SHA384, k.ec_scalar.p, digest.p, digest.len, rout.p, sout.p)
end
ret _ecdsa_sign(_curve_p256(), HASH_SHA256, k.ec_scalar.p, digest.p, digest.len, rout.p, sout.p)
end
@en "ECDSADerEncode"
@fa "کدگذاری دی ای آر بیضوی"
pub func ECDSADerEncode(rbytes: Buf, sbytes: Buf, width: int): Buf:
mut out := _newbuf(2 * width + 8)
_ecdsa_der_encode(rbytes.p, sbytes.p, width, out)
ret out
end
@en "VerifyRSAPSSWithKey"
@fa "تایید آر اس ای پی اس اس با کلید"
pub func VerifyRSAPSSWithKey(k: PrivateKey, sha384: bool, digest: Buf, sig: Buf): bool:
mut kind := 0
mut slen := 32
if sha384:
kind = 1
slen = 48
end
ret _rsa_verify_pss(kind, digest.p, k.rsa_n.p, k.rsa_n.len, k.rsa_e.p, k.rsa_e.len, sig.p, sig.len, slen)
end
@en "VerifyECDSADERWithKey"
@fa "تایید دی ای آر بیضوی با کلید"
pub func VerifyECDSADERWithKey(k: PrivateKey, digest: Buf, dersig: Buf): bool:
mut cv := _curve_p256()
if k.pk_alg == PK_EC_P384:
cv = _curve_p384()
end
mut xb := _newbuf(cv.nb)
_putzeros(xb, cv.nb)
mut yb := _newbuf(cv.nb)
_putzeros(yb, cv.nb)
if not _ec_base_mul(cv, k.ec_scalar.p, xb.p, yb.p):
ret false
end
mut pubkey := _newbuf(1 + 2 * cv.nb)
_put8(pubkey, 0x04)
_putbuf(pubkey, xb)
_putbuf(pubkey, yb)
mut rb := _newbuf(cv.nb)
mut sb := _newbuf(cv.nb)
if not _ecdsa_split(_readerof(dersig), rb, sb, cv.nb):
ret false
end
ret _ecdsa_verify(cv, digest.p, digest.len, rb.p, sb.p, pubkey.p, pubkey.len)
end
package tls
const TLS12_ECDHE_ECDSA_AES128_GCM_SHA256 := 0xC02B
const TLS12_ECDHE_RSA_AES128_GCM_SHA256 := 0xC02F
const TLS12_ECDHE_ECDSA_AES256_GCM_SHA384 := 0xC02C
const TLS12_ECDHE_RSA_AES256_GCM_SHA384 := 0xC030
const TLS12_ECDHE_RSA_CHACHA20_SHA256 := 0xCCA8
const TLS12_ECDHE_ECDSA_CHACHA20_SHA256 := 0xCCA9
const HS_SERVER_KEY_EXCHANGE := 12
const HS_SERVER_HELLO_DONE := 14
const HS_CLIENT_KEY_EXCHANGE := 16
const EXT_EC_POINT_FORMATS := 11
const EXT_EXTENDED_MASTER_SECRET := 23
const EXT_RENEGOTIATION_INFO := 0xFF01
func _tls12_cipher(w: int): int:
if w == TLS12_ECDHE_ECDSA_AES128_GCM_SHA256 or w == TLS12_ECDHE_RSA_AES128_GCM_SHA256:
ret CIPHER_AES128_GCM_SHA256
end
if w == TLS12_ECDHE_ECDSA_AES256_GCM_SHA384 or w == TLS12_ECDHE_RSA_AES256_GCM_SHA384:
ret CIPHER_AES256_GCM_SHA384
end
if w == TLS12_ECDHE_RSA_CHACHA20_SHA256 or w == TLS12_ECDHE_ECDSA_CHACHA20_SHA256:
ret CIPHER_CHACHA20_SHA256
end
ret CIPHER_NONE
end
func _tls_verify_leaf_sig(leaf: Cert, scheme: int, content: Buf, sig: Reader, allow_pkcs1: bool): bool:
mut kind := HASH_SHA256
if scheme == SA_ECDSA_P384_SHA384 or scheme == SA_RSA_PSS_RSAE_SHA384 or scheme == SA_RSA_PKCS1_SHA384:
kind = HASH_SHA384
end
hlen := _hash_size(kind)
mut digest := _newbuf(hlen)
defer _buf_free(digest)
_putzeros(digest, hlen)
_hash_oneshot(kind, content.p, content.len, digest.p)
mut rb := _newbuf(48)
defer _buf_free(rb)
mut sb := _newbuf(48)
defer _buf_free(sb)
mut n := _newbuf(512)
defer _buf_free(n)
mut e := _newbuf(16)
defer _buf_free(e)
mut sg := _newbuf(512)
defer _buf_free(sg)
if scheme == SA_ECDSA_P256_SHA256 or scheme == SA_ECDSA_P384_SHA384:
if leaf.pk_alg == PK_EC_P256:
if not _ecdsa_split(sig, rb, sb, 32):
ret false
end
ret _ecdsa_p256_verify(digest.p, hlen, rb.p, sb.p, leaf.ec_point.p, leaf.ec_point.len)
end
if leaf.pk_alg == PK_EC_P384:
if not _ecdsa_split(sig, rb, sb, 48):
ret false
end
ret _ecdsa_p384_verify(digest.p, hlen, rb.p, sb.p, leaf.ec_point.p, leaf.ec_point.len)
end
ret false
end
if leaf.pk_alg != PK_RSA:
ret false
end
repeat leaf.rsa_n.len in i:
_put8(n, _rdat(leaf.rsa_n, i))
end
repeat leaf.rsa_e.len in i:
_put8(e, _rdat(leaf.rsa_e, i))
end
repeat sig.len in i:
_put8(sg, _rdat(sig, i))
end
if scheme == SA_RSA_PSS_RSAE_SHA256 or scheme == SA_RSA_PSS_RSAE_SHA384 or scheme == SA_RSA_PSS_PSS_SHA256:
ret _rsa_verify_pss(kind, digest.p, n.p, n.len, e.p, e.len, sg.p, sg.len, hlen)
end
if scheme == SA_RSA_PKCS1_SHA256 or scheme == SA_RSA_PKCS1_SHA384:
if not allow_pkcs1:
ret false
end
ret _rsa_verify_pkcs1(kind, digest.p, n.p, n.len, e.p, e.len, sg.p, sg.len)
end
ret false
end
func _tls12_gen_ec_key(h &: Handshake, cv: Curve): bool:
mut x := _newbuf(cv.nb)
defer _buf_free(x)
mut y := _newbuf(cv.nb)
defer _buf_free(y)
mut tries := 0
until tries < 8:
tries++
_bufreset(x)
_bufreset(y)
_putzeros(x, cv.nb)
_putzeros(y, cv.nb)
_bufreset(h.ecpriv)
_putzeros(h.ecpriv, cv.nb)
crypto.RandomBytes(h.ecpriv.p, cv.nb)
if _ec_base_mul(cv, h.ecpriv.p, x.p, y.p):
_bufreset(h.ecpub)
_put8(h.ecpub, 4)
_putbuf(h.ecpub, x)
_putbuf(h.ecpub, y)
ret not h.ecpub.bad and not h.ecpriv.bad
end
end
ret false
end
func _tls12_parse_ske(h &: Handshake, msg: Reader): bool:
mut r := msg
ctype := _rd8(r)
if r.bad or ctype != 3:
ret _hs_fail(h, "ServerKeyExchange did not use a named curve")
end
group := _rd16(r)
plen := _rd8(r)
point := _rdbytes(r, plen)
if r.bad:
ret _hs_fail(h, "malformed ServerKeyExchange")
end
params := _subreader(msg, 0, 4 + plen)
scheme := _rd16(r)
sig := _rdvec16(r)
if r.bad or _rdleft(r) != 0:
ret _hs_fail(h, "malformed ServerKeyExchange signature")
end
mut signed := _newbuf(128 + plen)
defer _buf_free(signed)
mut peer := _newbuf(point.len + 1)
defer _buf_free(peer)
_putbuf(signed, h.crand)
_putbuf(signed, h.srand)
repeat params.len in i:
_put8(signed, _rdat(params, i))
end
leaf := _cert_parse(_bufptr(h.certs, 0), _cert_len(h, 0))
if not leaf.ok:
ret _hs_fail(h, "server leaf certificate did not parse")
end
if not _tls_verify_leaf_sig(leaf, scheme, signed, sig, true):
ret _hs_fail(h, "ServerKeyExchange signature invalid")
end
h.group = group
_bufreset(h.shared)
if group == GROUP_X25519:
if point.len != 32:
ret _hs_fail(h, "bad X25519 server key share")
end
_putzeros(h.shared, 32)
if not _x25519_shared(h.priv.p, point.p, h.shared.p):
ret _hs_fail(h, "degenerate X25519 shared secret")
end
ret true
end
if group == GROUP_SECP256R1 or group == GROUP_SECP384R1:
mut cv := _curve_p256()
if group == GROUP_SECP384R1:
cv = _curve_p384()
end
if not _tls12_gen_ec_key(h, cv):
ret _hs_fail(h, "could not generate a key on the server's curve")
end
repeat point.len in i:
_put8(peer, _rdat(point, i))
end
_putzeros(h.shared, cv.nb)
if not _ec_ecdh(cv, h.ecpriv.p, peer.p, peer.len, h.shared.p):
ret _hs_fail(h, "invalid EC server key share")
end
ret true
end
ret _hs_fail(h, "server chose an unsupported group")
end
func _tls12_client_key_exchange(h: Handshake, group: int, out &: Buf):
_bufreset(out)
_put8(out, HS_CLIENT_KEY_EXCHANGE)
lenmark := out.len
_put24(out, 0)
body := out.len
if group == GROUP_X25519:
_put8(out, 32)
_putbuf(out, h.pub_key)
else:
_put8(out, h.ecpub.len)
_putbuf(out, h.ecpub)
end
_patch24(out, lenmark, out.len - body)
end
func _tls12_install_keys(h &: Handshake): bool:
klen := _cipher_keylen(h.cipher)
ivlen := _tk12_ivlen(h.cipher)
total := 2 * klen + 2 * ivlen
mut kb := _newbuf(total)
defer _buf_wipe(kb)
_putzeros(kb, total)
_tls12_key_block(h.hash, h.master.p, h.master.len, h.srand, h.crand, kb.p, total)
_tk_free(h.rec.rxk)
_tk_free(h.rec.txk)
h.rec.txk = _tk_from_block(kb, 0, klen, 2 * klen, ivlen, h.cipher)
h.rec.rxk = _tk_from_block(kb, klen, klen, 2 * klen + ivlen, ivlen, h.cipher)
ret h.rec.txk.live and h.rec.rxk.live
end
func _tls12_finished_msg(h: Handshake, label: str, th: Buf, out &: Buf):
mut vd := _newbuf(VERIFY_DATA_LEN)
defer _buf_free(vd)
_putzeros(vd, VERIFY_DATA_LEN)
_tls12_verify_data(h.hash, h.master.p, h.master.len, label, th, vd.p)
_bufreset(out)
_put8(out, HS_FINISHED)
_put24(out, VERIFY_DATA_LEN)
_putbuf(out, vd)
end
package tls
const MAX_CHAIN_DEPTH := 8
const VERR_NONE := 0
const VERR_PARSE := 1
const VERR_EXPIRED := 2
const VERR_NOT_YET_VALID := 3
const VERR_HOSTNAME := 4
const VERR_UNTRUSTED := 5
const VERR_BAD_SIGNATURE := 6
const VERR_NOT_CA := 7
const VERR_PATHLEN := 8
const VERR_DEPTH := 9
const VERR_USAGE := 10
struct Roots:
pub der: Buf = Buf {}
pub off: Buf = Buf {}
pub count: int = 0
end
func _verr_str(e: int): str:
if e == VERR_PARSE: ret "certificate parse failed" end
if e == VERR_EXPIRED: ret "certificate expired" end
if e == VERR_NOT_YET_VALID: ret "certificate not yet valid" end
if e == VERR_HOSTNAME: ret "hostname does not match certificate" end
if e == VERR_UNTRUSTED: ret "no trusted issuer found" end
if e == VERR_BAD_SIGNATURE: ret "certificate signature invalid" end
if e == VERR_NOT_CA: ret "issuer is not a CA" end
if e == VERR_PATHLEN: ret "path length constraint exceeded" end
if e == VERR_DEPTH: ret "certificate chain too long" end
if e == VERR_USAGE: ret "certificate key usage forbids this" end
ret "ok"
end
func _now_stamp(): i64:
e := time.Now()
mut v := time.Year(e) as i64
v = v * 100 + (time.Month(e) as i64)
v = v * 100 + (time.Day(e) as i64)
v = v * 100 + (time.Hour(e) as i64)
v = v * 100 + (time.Minute(e) as i64)
v = v * 100 + (time.Second(e) as i64)
ret v
end
func _cert_time_ok(c: Cert, now: i64): int:
if now < c.not_before:
ret VERR_NOT_YET_VALID
end
if now > c.not_after:
ret VERR_EXPIRED
end
ret VERR_NONE
end
func _ecdsa_split(sig: Reader, rout &: Buf, sout &: Buf, width: int): bool:
mut s := sig
mut seq := _der_seq(s)
if s.bad:
ret false
end
r := _der_uint(seq)
v := _der_uint(seq)
if seq.bad or _rdleft(seq) != 0:
ret false
end
if r.len == 0 or v.len == 0 or r.len > width or v.len > width:
ret false
end
_bufreset(rout)
_putzeros(rout, width - r.len)
repeat r.len in i:
_put8(rout, _rdat(r, i))
end
_bufreset(sout)
_putzeros(sout, width - v.len)
repeat v.len in i:
_put8(sout, _rdat(v, i))
end
ret true
end
func _cert_signed_by(child: Cert, parent: Cert): bool:
kind := _sig_hash(child.sig_alg)
hlen := _hash_size(kind)
mut digest := _newbuf(hlen)
defer _buf_free(digest)
mut rb := _newbuf(48)
defer _buf_free(rb)
mut sb := _newbuf(48)
defer _buf_free(sb)
_putzeros(digest, hlen)
_hash_oneshot(kind, child.tbs.p, child.tbs.len, digest.p)
if child.sig_alg == SIG_ECDSA_SHA256 or child.sig_alg == SIG_ECDSA_SHA384:
if parent.pk_alg == PK_EC_P256:
if not _ecdsa_split(child.sig, rb, sb, 32):
ret false
end
ret _ecdsa_p256_verify(digest.p, hlen, rb.p, sb.p, parent.ec_point.p, parent.ec_point.len)
end
if parent.pk_alg == PK_EC_P384:
if not _ecdsa_split(child.sig, rb, sb, 48):
ret false
end
ret _ecdsa_p384_verify(digest.p, hlen, rb.p, sb.p, parent.ec_point.p, parent.ec_point.len)
end
ret false
end
if parent.pk_alg != PK_RSA:
ret false
end
mut n := _newbuf(parent.rsa_n.len)
defer _buf_free(n)
repeat parent.rsa_n.len in i:
_put8(n, _rdat(parent.rsa_n, i))
end
mut e := _newbuf(parent.rsa_e.len)
defer _buf_free(e)
repeat parent.rsa_e.len in i:
_put8(e, _rdat(parent.rsa_e, i))
end
mut sg := _newbuf(child.sig.len)
defer _buf_free(sg)
repeat child.sig.len in i:
_put8(sg, _rdat(child.sig, i))
end
if child.sig_alg == SIG_RSA_PSS_SHA256 or child.sig_alg == SIG_RSA_PSS_SHA384:
ret _rsa_verify_pss(kind, digest.p, n.p, n.len, e.p, e.len, sg.p, sg.len, hlen)
end
if child.sig_alg == SIG_RSA_PKCS1_SHA256 or child.sig_alg == SIG_RSA_PKCS1_SHA384 or child.sig_alg == SIG_RSA_PKCS1_SHA512:
ret _rsa_verify_pkcs1(kind, digest.p, n.p, n.len, e.p, e.len, sg.p, sg.len)
end
ret false
end
func _cert_can_issue(parent: Cert, depth: int): int:
if not parent.has_basic_constraints or not parent.is_ca:
ret VERR_NOT_CA
end
if parent.has_key_usage and (parent.key_usage & KU_KEY_CERT_SIGN) == 0:
ret VERR_USAGE
end
if parent.has_path_len and depth > parent.path_len:
ret VERR_PATHLEN
end
ret VERR_NONE
end
func _roots_new(): Roots:
mut r := Roots {}
r.der = _newbuf(65536)
r.off = _newbuf(1024)
r.count = 0
ret r
end
func _roots_free(r &: Roots):
_buf_free(r.der)
_buf_free(r.off)
r.count = 0
end
func _roots_add(r &: Roots, p: void*, n: int):
start := r.der.len
_putraw(r.der, p, n)
_put32(r.off, start as i64)
_put32(r.off, n as i64)
r.count++
end
func _roots_get(r: Roots, i: int): Reader:
if i < 0 or i >= r.count:
ret _newreader(null, 0)
end
mut o := 0
mut l := 0
repeat 4 in k:
o = (o << 8) | _bufat(r.off, i * 8 + k)
end
repeat 4 in k:
l = (l << 8) | _bufat(r.off, i * 8 + 4 + k)
end
ret _newreader(_bufptr(r.der, o), l)
end
func _verify_chain(chain: Reader[8], nchain: int, roots: Roots, host: str, now: i64): int:
if nchain < 1:
ret VERR_PARSE
end
if nchain > MAX_CHAIN_DEPTH:
ret VERR_DEPTH
end
mut certs: Cert[8]
repeat nchain in i:
certs[i] = _cert_parse(chain[i].p, chain[i].len)
if not certs[i].ok:
ret VERR_PARSE
end
end
leaf := certs[0]
terr := _cert_time_ok(leaf, now)
if terr != VERR_NONE:
ret terr
end
if not _cert_match_host(leaf, host):
ret VERR_HOSTNAME
end
if leaf.has_eku and not leaf.eku_server_auth:
ret VERR_USAGE
end
mut used: bool[8]
repeat 8 in i:
used[i] = false
end
used[0] = true
mut cur := 0
mut depth := 0
until depth < nchain:
child := certs[cur]
mut ri := 0
until ri < roots.count:
rd := _roots_get(roots, ri)
rc := _cert_parse(rd.p, rd.len)
if rc.ok:
if _cteqrd(child.issuer, rc.subject):
ce := _cert_can_issue(rc, depth)
if ce == VERR_NONE:
rt := _cert_time_ok(rc, now)
if rt == VERR_NONE:
if _cert_signed_by(child, rc):
ret VERR_NONE
end
end
end
end
end
ri++
end
mut nxt := 0 - 1
repeat nchain in j:
if not used[j] and nxt < 0:
if _cteqrd(child.issuer, certs[j].subject):
nxt = j
end
end
end
if nxt < 0:
ret VERR_UNTRUSTED
end
parent := certs[nxt]
pe := _cert_can_issue(parent, depth)
if pe != VERR_NONE:
ret pe
end
pt := _cert_time_ok(parent, now)
if pt != VERR_NONE:
ret pt
end
if not _cert_signed_by(child, parent):
ret VERR_BAD_SIGNATURE
end
used[nxt] = true
cur = nxt
depth++
end
ret VERR_UNTRUSTED
end
package tls
import mem
const X25519_SIZE := 32
const X_LIMBS := 10
const X_SLOT := 80
func _fe25519_mul(h: i64*, f: i64*, g: i64*):
f0 := f[0]
f1 := f[1]
f2 := f[2]
f3 := f[3]
f4 := f[4]
f5 := f[5]
f6 := f[6]
f7 := f[7]
f8 := f[8]
f9 := f[9]
g0 := g[0]
g1 := g[1]
g2 := g[2]
g3 := g[3]
g4 := g[4]
g5 := g[5]
g6 := g[6]
g7 := g[7]
g8 := g[8]
g9 := g[9]
g1x := g1 * (19 as i64)
g2x := g2 * (19 as i64)
g3x := g3 * (19 as i64)
g4x := g4 * (19 as i64)
g5x := g5 * (19 as i64)
g6x := g6 * (19 as i64)
g7x := g7 * (19 as i64)
g8x := g8 * (19 as i64)
g9x := g9 * (19 as i64)
f1d := f1 * (2 as i64)
f3d := f3 * (2 as i64)
f5d := f5 * (2 as i64)
f7d := f7 * (2 as i64)
f9d := f9 * (2 as i64)
mut h0 := f0 * g0 + f1d * g9x + f2 * g8x + f3d * g7x + f4 * g6x + f5d * g5x + f6 * g4x + f7d * g3x + f8 * g2x + f9d * g1x
mut h1 := f0 * g1 + f1 * g0 + f2 * g9x + f3 * g8x + f4 * g7x + f5 * g6x + f6 * g5x + f7 * g4x + f8 * g3x + f9 * g2x
mut h2 := f0 * g2 + f1d * g1 + f2 * g0 + f3d * g9x + f4 * g8x + f5d * g7x + f6 * g6x + f7d * g5x + f8 * g4x + f9d * g3x
mut h3 := f0 * g3 + f1 * g2 + f2 * g1 + f3 * g0 + f4 * g9x + f5 * g8x + f6 * g7x + f7 * g6x + f8 * g5x + f9 * g4x
mut h4 := f0 * g4 + f1d * g3 + f2 * g2 + f3d * g1 + f4 * g0 + f5d * g9x + f6 * g8x + f7d * g7x + f8 * g6x + f9d * g5x
mut h5 := f0 * g5 + f1 * g4 + f2 * g3 + f3 * g2 + f4 * g1 + f5 * g0 + f6 * g9x + f7 * g8x + f8 * g7x + f9 * g6x
mut h6 := f0 * g6 + f1d * g5 + f2 * g4 + f3d * g3 + f4 * g2 + f5d * g1 + f6 * g0 + f7d * g9x + f8 * g8x + f9d * g7x
mut h7 := f0 * g7 + f1 * g6 + f2 * g5 + f3 * g4 + f4 * g3 + f5 * g2 + f6 * g1 + f7 * g0 + f8 * g9x + f9 * g8x
mut h8 := f0 * g8 + f1d * g7 + f2 * g6 + f3d * g5 + f4 * g4 + f5d * g3 + f6 * g2 + f7d * g1 + f8 * g0 + f9d * g9x
mut h9 := f0 * g9 + f1 * g8 + f2 * g7 + f3 * g6 + f4 * g5 + f5 * g4 + f6 * g3 + f7 * g2 + f8 * g1 + f9 * g0
mut c := 0 as i64
c = (h0 + (33554432 as i64)) >> (26 as i64)
h1 += c
h0 -= c << (26 as i64)
c = (h4 + (33554432 as i64)) >> (26 as i64)
h5 += c
h4 -= c << (26 as i64)
c = (h1 + (16777216 as i64)) >> (25 as i64)
h2 += c
h1 -= c << (25 as i64)
c = (h5 + (16777216 as i64)) >> (25 as i64)
h6 += c
h5 -= c << (25 as i64)
c = (h2 + (33554432 as i64)) >> (26 as i64)
h3 += c
h2 -= c << (26 as i64)
c = (h6 + (33554432 as i64)) >> (26 as i64)
h7 += c
h6 -= c << (26 as i64)
c = (h3 + (16777216 as i64)) >> (25 as i64)
h4 += c
h3 -= c << (25 as i64)
c = (h7 + (16777216 as i64)) >> (25 as i64)
h8 += c
h7 -= c << (25 as i64)
c = (h4 + (33554432 as i64)) >> (26 as i64)
h5 += c
h4 -= c << (26 as i64)
c = (h8 + (33554432 as i64)) >> (26 as i64)
h9 += c
h8 -= c << (26 as i64)
c = (h9 + (16777216 as i64)) >> (25 as i64)
h0 += c * (19 as i64)
h9 -= c << (25 as i64)
c = (h0 + (33554432 as i64)) >> (26 as i64)
h1 += c
h0 -= c << (26 as i64)
h[0] = h0
h[1] = h1
h[2] = h2
h[3] = h3
h[4] = h4
h[5] = h5
h[6] = h6
h[7] = h7
h[8] = h8
h[9] = h9
end
func _fe25519_sq(h: i64*, f: i64*):
f0 := f[0]
f1 := f[1]
f2 := f[2]
f3 := f[3]
f4 := f[4]
f5 := f[5]
f6 := f[6]
f7 := f[7]
f8 := f[8]
f9 := f[9]
f0d := f0 * (2 as i64)
f1d := f1 * (2 as i64)
f2d := f2 * (2 as i64)
f3d := f3 * (2 as i64)
f4d := f4 * (2 as i64)
f5d := f5 * (2 as i64)
f6d := f6 * (2 as i64)
f7d := f7 * (2 as i64)
f5x := f5 * (38 as i64)
f6x := f6 * (19 as i64)
f7x := f7 * (38 as i64)
f8x := f8 * (19 as i64)
f9x := f9 * (38 as i64)
