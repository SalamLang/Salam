func _to26(v: f64): int:
ret math.Round(v * 64.0) as int
end
func _from26(v: int): f64:
ret (v as f64) / 64.0
end
func _div_round(a: i64, b: i64): int:
if b <= (0 as i64):
ret 0
end
if a >= (0 as i64):
ret ((a + b / (2 as i64)) / b) as int
end
ret (0 - (((0 as i64) - a + b / (2 as i64)) / b)) as int
end
func _scale26(fu: int, size64: int, upem: int): int:
ret _div_round((fu as i64) * (size64 as i64), upem as i64)
end
func _gcb_is_break(prev: int, curr: int, ri_run: int, pict_zwj: bool, conjunct: bool): bool:
pc := unicode.GraphemeBreak(prev)
cc := unicode.GraphemeBreak(curr)
if pc == unicode.GcbCR and cc == unicode.GcbLF: ret false end
if pc == unicode.GcbControl or pc == unicode.GcbCR or pc == unicode.GcbLF: ret true end
if cc == unicode.GcbControl or cc == unicode.GcbCR or cc == unicode.GcbLF: ret true end
if pc == unicode.GcbL:
if cc == unicode.GcbL or cc == unicode.GcbV or cc == unicode.GcbLV or cc == unicode.GcbLVT: ret false end
end
if pc == unicode.GcbLV or pc == unicode.GcbV:
if cc == unicode.GcbV or cc == unicode.GcbT: ret false end
end
if pc == unicode.GcbLVT or pc == unicode.GcbT:
if cc == unicode.GcbT: ret false end
end
if cc == unicode.GcbExtend or cc == unicode.GcbZWJ or cc == unicode.GcbSpacingMark: ret false end
if pc == unicode.GcbPrepend: ret false end
if conjunct and unicode.ConjunctBreak(curr) == unicode.IncbConsonant: ret false end
if pc == unicode.GcbZWJ and cc == unicode.GcbExtendedPictographic and pict_zwj: ret false end
if pc == unicode.GcbRegionalIndicator and cc == unicode.GcbRegionalIndicator and ri_run % 2 == 1: ret false end
ret true
end
func _gcb_pict(state: int, cp: int): int:
k := unicode.GraphemeBreak(cp)
if k == unicode.GcbExtendedPictographic: ret 1 end
if state == 1 and k == unicode.GcbExtend: ret 1 end
if state == 1 and k == unicode.GcbZWJ: ret 2 end
ret 0
end
func _gcb_conj(state: int, cp: int): int:
k := unicode.ConjunctBreak(cp)
if k == unicode.IncbConsonant: ret 1 end
if state > 0 and k == unicode.IncbLinker: ret 2 end
if state > 0 and k == unicode.IncbExtend: ret state end
ret 0
end
func _grapheme_starts(cps &: Vector<int>, out &: Vector<bool>):
out.clear()
n := cps.len()
if n == 0:
ret
end
out.push(true)
mut prev := cps.get(0)
mut ri := 0
if unicode.GraphemeBreak(prev) == unicode.GcbRegionalIndicator: ri = 1 end
mut pict := _gcb_pict(0, prev)
mut conj := _gcb_conj(0, prev)
mut i := 1
until i < n:
cur := cps.get(i)
brk := _gcb_is_break(prev, cur, ri, pict == 2, conj == 2)
out.push(brk)
if brk:
ri = 0
end
if unicode.GraphemeBreak(cur) == unicode.GcbRegionalIndicator:
ri++
else:
ri = 0
end
pict = _gcb_pict(pict, cur)
conj = _gcb_conj(conj, cur)
prev = cur
i++
end
end
func _is_word_cp(cp: int): bool:
if cp == 0x200C or cp == 0x200D or cp == 0x5F:
ret true
end
ret unicode.IsLetter(cp) or unicode.IsNumber(cp) or unicode.IsMark(cp)
end
func _cf(p: Paragraph, i: int, flag: int): bool:
ret (p.chars.get(i).flags & flag) != 0
end
func _span_family_face(fc &: FontCollection, sp: TextSpan): int:
key := _fc_memo_key(sp.families, sp.weight, sp.italic, -2)
if fc.memo.has(key):
r := fc.memo.get(key)
mem.Free(key as void*)
ret r
end
r := _span_family_face_scan(fc, sp)
fc.memo.put(key, r)
ret r
end
func _span_family_face_scan(fc &: FontCollection, sp: TextSpan): int:
mut names := Vector {} as Vector<str>
defer names.free()
_fc_family_list(sp.families, names)
mut exp := Vector {} as Vector<str>
defer exp.free()
each n in names:
if not _fc_generic(n, exp):
exp.push(n)
end
end
each n in exp:
r := _fc_match(fc, n, sp.weight, sp.italic, -1)
if r >= 0:
ret r
end
end
ret -1
end
func _pick_face(fc &: FontCollection, sp: TextSpan, cps &: Vector<int>, s: int, e: int, prev_face: int): int:
mut base := -1
mut k := s
until k < e and base < 0:
c := cps.get(k)
if not _is_default_ignorable(c) and not unicode.IsMark(c):
base = c
end
k++
end
if base < 0:
ret prev_face
end
sc := unicode.Script(base)
if prev_face >= 0 and (sc == unicode.ScriptCommon or sc == unicode.ScriptInherited) and _fc_covers(fc, prev_face, base):
ret prev_face
end
ret FaceForCodepoint(fc, sp.families, sp.weight, sp.italic, base)
end
func _resolve_scripts(cps &: Vector<int>, out &: Vector<int>):
n := cps.len()
out.clear()
mut last := -1
mut i := 0
until i < n:
sc := unicode.Script(cps.get(i))
if sc == unicode.ScriptCommon or sc == unicode.ScriptInherited or sc == unicode.ScriptUnknown:
out.push(last)
else:
out.push(sc)
last = sc
end
i++
end
mut next := unicode.ScriptLatin
mut j := n - 1
until j >= 0:
if out.get(j) < 0:
out.set(j, next)
else:
next = out.get(j)
end
j--
end
end
func _ws_mode_pre(ws: WhiteSpace): bool:
ret ws == WhiteSpace.Pre or ws == WhiteSpace.PreWrap
end
func _ws_wraps(ws: WhiteSpace): bool:
ret ws == WhiteSpace.Normal or ws == WhiteSpace.PreWrap
end
func _para_levels(p &: Paragraph, shape_cps &: Vector<int>):
n := p.chars.len()
mut s := 0
until s < n:
mut e := s
until e < n and not _cf(p, e, _CF_HARD):
e++
end
mut sub := Vector {} as Vector<int>
mut k := s
until k < e:
sub.push(shape_cps.get(k))
k++
end
txt := _utf8_encode_all(sub)
base := bidi.ParagraphLevel(txt, p.style.direction)
levels := bidi.Levels(txt, p.style.direction)
mut lastlv := base
k = s
until k < e:
mut c := p.chars.get(k)
mut lv := levels.get(k - s)
if lv < 0:
lv = lastlv
end
lastlv = lv
c.level = lv
c.base = base
p.chars.set(k, c)
k++
end
if e < n:
mut c := p.chars.get(e)
c.level = base
c.base = base
p.chars.set(e, c)
end
levels.free()
sub.free()
mem.Free(txt as void*)
s = e + 1
end
end
func _decode_spans(p &: Paragraph):
mut sb := str.NewBuilder()
mut si := 0
until si < p.spans.len():
sp := p.spans.get(si)
base := str.BufLen(sb) as int
p.span_starts.push(base)
str.BufAppend(sb, sp.text)
n := str.Len(sp.text)
bp := sp.text as u8*
mut i := 0
until i < n:
mut ci := CharInfo {}
ci.offset = base + i
ci.span = si
mut cp := 0
i = _utf8_next(bp, n, i, cp)
ci.cp = cp
p.chars.push(ci)
end
si++
end
p.text = str.BufStr(sb)
str.BufFree(sb)
end
func _white_space(p &: Paragraph, shape_cps &: Vector<int>):
pre := _ws_mode_pre(p.style.white_space)
n := p.chars.len()
mut prev_space := true
mut i := 0
until i < n:
mut c := p.chars.get(i)
cp := c.cp
mut scp := cp
if cp == 0x2028 or cp == 0x2029:
c.flags |= _CF_HARD | _CF_HIDDEN
scp = 0x0A
prev_space = true
else pre:
if cp == 0x0A:
c.flags |= _CF_HARD | _CF_HIDDEN
else cp == 0x0D:
c.flags |= _CF_HIDDEN
if i + 1 >= n or p.chars.get(i + 1).cp != 0x0A:
c.flags |= _CF_HARD
scp = 0x0A
end
else cp == 0x20 or cp == 0x09:
c.flags |= _CF_SPACE
end
else cp == 0x20 or cp == 0x09 or cp == 0x0A or cp == 0x0D or cp == 0x0C:
scp = 0x20
c.flags |= _CF_SPACE
if prev_space:
c.flags |= _CF_HIDDEN
end
prev_space = true
else:
prev_space = false
end
if _is_word_cp(cp):
c.flags |= _CF_WORD
end
p.chars.set(i, c)
shape_cps.push(scp)
i++
end
if not pre:
mut j := n - 1
until j >= 0 and _cf(p, j, _CF_SPACE):
mut c := p.chars.get(j)
c.flags |= _CF_HIDDEN
p.chars.set(j, c)
j--
end
end
end
func _make_runs(p &: Paragraph, fc &: FontCollection, shape_cps &: Vector<int>, scripts &: Vector<int>):
n := p.chars.len()
mut gs := Vector {} as Vector<bool>
defer gs.free()
_grapheme_starts(shape_cps, gs)
mut face := -1
mut i := 0
until i < n:
mut e := i + 1
until e < n and not gs.get(e):
e++
end
sp := p.spans.get(p.chars.get(i).span)
if not _cf(p, i, _CF_HIDDEN) or face < 0:
f2 := _pick_face(fc, sp, shape_cps, i, e, face)
if f2 >= 0:
face = f2
end
end
mut k := i
until k < e:
mut c := p.chars.get(k)
c.face = face
if k == i:
c.flags |= _CF_GSTART
end
p.chars.set(k, c)
k++
end
i = e
end
mut j := 0
mut first_face := -1
until j < n and first_face < 0:
first_face = p.chars.get(j).face
j++
end
i = 0
until i < n:
mut c := p.chars.get(i)
if c.face < 0:
c.face = first_face
p.chars.set(i, c)
end
i++
end
mut s := 0
until s < n:
c0 := p.chars.get(s)
mut e := s + 1
until e < n:
ce := p.chars.get(e)
if _cf(p, e - 1, _CF_HARD):
break
end
if ce.span != c0.span or ce.level != c0.level or (ce.face != c0.face and (ce.flags & _CF_HIDDEN) == 0) or scripts.get(e) != scripts.get(s):
break
end
e++
end
mut r := ShapedRun {}
r.cp_start = s
r.cp_end = e
r.level = c0.level
r.face = c0.face
r.span = c0.span
r.size64 = _to26(p.spans.get(c0.span).size)
p.runs.push(r)
s = e
end
end
func _shape_runs(p &: Paragraph, fc &: FontCollection, shape_cps &: Vector<int>, scripts &: Vector<int>):
n := p.chars.len()
mut forms := Vector {} as Vector<int>
defer forms.free()
forms.zeros(n)
_joining_forms(shape_cps, 0, n, forms)
mut skip := Vector {} as Vector<bool>
defer skip.free()
mut i := 0
until i < n:
skip.push(_cf(p, i, _CF_HIDDEN))
i++
end
mut ri := 0
until ri < p.runs.len():
mut r := p.runs.get(ri)
r.glyph_start = p.glyphs.len()
sp := p.spans.get(r.span)
f := FaceFont(fc, r.face)
if FontValid(f):
mut lang := sp.lang
if str.Len(lang) == 0:
lang = p.style.lang
end
mut off := 0
ls := _to26(sp.letter_spacing)
ws := _to26(sp.word_spacing)
if ls != 0:
off = (1 << _FB_LIGA) | (1 << _FB_CLIG) | (1 << _FB_CALT)
end
mut b := _Buf {}
_shape_buf(f, shape_cps, forms, skip, r.cp_start, r.cp_end, (r.level % 2) == 1, _opentype_script_tag(scripts.get(r.cp_start)), _lang_tag(lang), off, b)
mut last_cp := -1
mut q := 0
until q < b.g.len():
if b.att.get(q) != -2:
mut g := ParagraphGlyph {}
g.id = b.g.get(q)
g.cp = b.cl.get(q)
g.advance = _scale26(b.xa.get(q), r.size64, f.units_per_em)
g.x_offset = _scale26(b.xo.get(q), r.size64, f.units_per_em)
g.y_offset = _scale26(b.yo.get(q), r.size64, f.units_per_em)
if g.cp != last_cp:
if ls != 0 and _cf(p, g.cp, _CF_GSTART):
g.advance += ls
end
if ws != 0 and _cf(p, g.cp, _CF_SPACE):
g.advance += ws
end
last_cp = g.cp
end
p.glyphs.push(g)
end
q++
end
_buf_free(b)
end
r.glyph_end = p.glyphs.len()
p.runs.set(ri, r)
ri++
end
mut has_glyph := Vector {} as Vector<bool>
defer has_glyph.free()
i = 0
until i < n:
has_glyph.push(false)
i++
end
each g in p.glyphs:
mut c := p.chars.get(g.cp)
c.advance += g.advance
p.chars.set(g.cp, c)
has_glyph.set(g.cp, true)
end
each r in p.runs:
mut k := r.cp_start
until k < r.cp_end:
if not has_glyph.get(k):
k++
continue
end
mut e := k + 1
until e < r.cp_end and not has_glyph.get(e):
e++
end
mut count := 0
mut q := k
until q < e:
if _cf(p, q, _CF_GSTART) and not _cf(p, q, _CF_HIDDEN):
count++
end
q++
end
if count > 1:
total := p.chars.get(k).advance
each_part := total / count
mut left := total
mut seen := 0
q = k
until q < e:
if _cf(p, q, _CF_GSTART) and not _cf(p, q, _CF_HIDDEN):
seen++
mut c := p.chars.get(q)
if seen == count:
c.advance = left
else:
c.advance = each_part
left -= each_part
end
p.chars.set(q, c)
end
q++
end
end
k = e
end
end
end
func _breaks(p &: Paragraph, shape_cps &: Vector<int>):
mut brk := Vector {} as Vector<int>
defer brk.free()
_line_breaks(shape_cps, brk)
wraps := _ws_wraps(p.style.white_space)
n := p.chars.len()
mut i := 0
until i < n:
mut c := p.chars.get(i)
mut b := brk.get(i)
if i > 0 and _cf(p, i - 1, _CF_HARD):
b = _BRK_MUST
else b == _BRK_MUST:
b = _BRK_ALLOW
end
if b == _BRK_ALLOW and (not wraps or (c.flags & _CF_GSTART) == 0):
b = _BRK_NONE
end
c.brk = b
p.chars.set(i, c)
i++
end
end
func _content_end(p: Paragraph, s: int, e: int): int:
mut k := e
until k > s and (_cf(p, k - 1, _CF_SPACE) or _cf(p, k - 1, _CF_HIDDEN)):
k--
end
ret k
end
func _width(p: Paragraph, s: int, e: int): int:
mut w := 0
mut k := s
until k < e:
w += p.chars.get(k).advance
k++
end
ret w
end
func _intrinsic(p &: Paragraph):
n := p.chars.len()
anywhere := p.style.overflow_wrap == OverflowWrap.Anywhere
mut maxw := 0
mut minw := 0
mut line_s := 0
mut piece_s := 0
mut i := 1
until i <= n:
b := i == n ? _BRK_MUST : p.chars.get(i).brk
if b != _BRK_NONE:
cw := _width(p, piece_s, _content_end(p, piece_s, i))
if cw > minw and not anywhere:
minw = cw
end
piece_s = i
end
if b == _BRK_MUST:
lw := _width(p, line_s, _content_end(p, line_s, i))
if lw > maxw:
maxw = lw
end
line_s = i
end
i++
end
if anywhere:
mut g := 0
mut k := 0
until k < n:
if _cf(p, k, _CF_GSTART) and not _cf(p, k, _CF_SPACE):
g = 0
end
g += _cf(p, k, _CF_SPACE) ? 0 : p.chars.get(k).advance
if g > minw:
minw = g
end
k++
end
end
if minw > maxw:
minw = maxw
end
p.min_content = minw
p.max_content = maxw
end
@en "NewParagraph"
@fa "بند تازه"
pub func NewParagraph(fc &: FontCollection, spans: Vector<TextSpan>, style: ParagraphStyle): Paragraph:
mut p := Paragraph {}
p.style = style
each sp in spans:
p.spans.push(sp)
end
if p.spans.len() == 0:
p.spans.push(TextSpan {})
end
_decode_spans(p)
mut shape_cps := Vector {} as Vector<int>
defer shape_cps.free()
_white_space(p, shape_cps)
_para_levels(p, shape_cps)
mut scripts := Vector {} as Vector<int>
defer scripts.free()
_resolve_scripts(shape_cps, scripts)
_make_runs(p, fc, shape_cps, scripts)
_shape_runs(p, fc, shape_cps, scripts)
_breaks(p, shape_cps)
_intrinsic(p)
ret p
end
@en "MinContentWidth"
@fa "پهنای کمینه محتوا"
pub func MinContentWidth(p: Paragraph): f64:
ret _from26(p.min_content)
end
@en "MaxContentWidth"
@fa "پهنای بیشینه محتوا"
pub func MaxContentWidth(p: Paragraph): f64:
ret _from26(p.max_content)
end
@en "SpanAt"
@fa "تکه جای"
pub func SpanAt(p: Paragraph, offset: int): int:
mut i := p.span_starts.len() - 1
until i > 0 and p.span_starts.get(i) > offset:
i--
end
ret i
end
@en "FreeParagraph"
@fa "آزادسازی بند"
pub func FreeParagraph(p &: Paragraph):
p.spans.free()
p.span_starts.free()
p.chars.free()
p.runs.free()
p.glyphs.free()
mem.Free(p.text as void*)
p.text = ""
p.spans = Vector {} as Vector<TextSpan>
p.span_starts = Vector {} as Vector<int>
p.chars = Vector {} as Vector<CharInfo>
p.runs = Vector {} as Vector<ShapedRun>
p.glyphs = Vector {} as Vector<ParagraphGlyph>
end
package typeset
import mem
import math
const _RQ := 256
const _RSUB := 16
const _RMAX_EDGES := 65536
struct _IOut:
pub x: Vector<int> = Vector {}
pub y: Vector<int> = Vector {}
pub on: Vector<bool> = Vector {}
pub ends: Vector<int> = Vector {}
end
struct _IEdges:
pub x0: Vector<int> = Vector {}
pub y0: Vector<int> = Vector {}
pub x1: Vector<int> = Vector {}
pub y1: Vector<int> = Vector {}
pub dir: Vector<int> = Vector {}
end
@en "GlyphMask"
@fa "ماسک گلیف"
pub struct GlyphMask:
@en "data"
@fa "داده"
pub data: void* = null
@en "width"
@fa "پهنا"
pub width: int = 0
@en "height"
@fa "بلندی"
pub height: int = 0
@en "stride"
@fa "گام سطر"
pub stride: int = 0
@en "left"
@fa "چپ"
pub left: int = 0
@en "top"
@fa "بالا"
pub top: int = 0
end
@en "CacheSlot"
@fa "خانه نهانگاه"
pub struct CacheSlot:
@en "key"
@fa "کلید"
pub key: i64 = 0 as i64
@en "mask"
@fa "ماسک"
pub mask: GlyphMask = GlyphMask {}
@en "stamp"
@fa "مهر زمان"
pub stamp: i64 = 0 as i64
@en "used"
@fa "اشغال"
pub used: bool = false
end
@en "GlyphCache"
@fa "نهانگاه گلیف"
pub struct GlyphCache:
@en "capacity"
@fa "گنجایش"
pub capacity: int = 1048576
@en "bytes"
@fa "بایت‌ها"
pub bytes: int = 0
@en "hits"
@fa "برخوردها"
pub hits: int = 0
@en "misses"
@fa "نیافته‌ها"
pub misses: int = 0
@en "clock"
@fa "ساعت"
pub clock: i64 = 0 as i64
@en "slots"
@fa "خانه‌ها"
pub slots: Vector<CacheSlot> = Vector {}
@en "index"
@fa "فهرست"
pub index: HashMap<i64, int> = HashMap {}
end
func _floordiv(a: i64, b: i64): i64:
q := a / b
if (a % b != (0 as i64)) and ((a < (0 as i64)) != (b < (0 as i64))):
ret q - (1 as i64)
end
ret q
end
func _f2_mul(a: int, v: int): int:
ret _div_round((a as i64) * (v as i64), 16384 as i64)
end
func _i_simple(f: Font, goff: int, ncont: int, xx: int, xy: int, yx: int, yy: int, dx: int, dy: int, o &: _IOut):
base := o.x.len()
npoints := _ttf_u16(f.data, f.size, goff + 10 + (ncont - 1) * 2) + 1
if npoints <= 0 or npoints > _TTF_MAX_POINTS or base + npoints > _TTF_MAX_POINTS:
ret
end
mut i := 0
until i < ncont:
e := _ttf_u16(f.data, f.size, goff + 10 + i * 2)
if e < npoints:
o.ends.push(base + e + 1)
end
i++
end
ins_at := goff + 10 + ncont * 2
mut flags := Vector {} as Vector<int>
mut xs := Vector {} as Vector<int>
mut ys := Vector {} as Vector<int>
after_flags := _ttf_read_flags(f, ins_at + 2 + _ttf_u16(f.data, f.size, ins_at), npoints, flags)
after_x := _ttf_read_coords(f, after_flags, npoints, _TTF_X_SHORT, _TTF_X_SAME, flags, xs)
_ttf_read_coords(f, after_x, npoints, _TTF_Y_SHORT, _TTF_Y_SAME, flags, ys)
mut k := 0
until k < npoints:
gx := xs.get(k)
gy := ys.get(k)
o.x.push(_f2_mul(xx, gx) + _f2_mul(yx, gy) + dx)
o.y.push(_f2_mul(xy, gx) + _f2_mul(yy, gy) + dy)
o.on.push((flags.get(k) & _TTF_ON_CURVE) != 0)
k++
end
flags.free()
xs.free()
ys.free()
end
func _i_glyph(f: Font, gid: int, xx: int, xy: int, yx: int, yy: int, dx: int, dy: int, o &: _IOut, depth: int, work &: int):
work++
if depth >= _TTF_MAX_DEPTH or o.x.len() > _TTF_MAX_POINTS or work > _TTF_MAX_WORK:
ret
end
mut goff := 0
mut glen := 0
if not _ttf_glyph_range(f, gid, goff, glen):
ret
end
ncont := _ttf_i16(f.data, f.size, goff)
if ncont > 0:
_i_simple(f, goff, ncont, xx, xy, yx, yy, dx, dy, o)
ret
end
if ncont == 0:
ret
end
mut cur := goff + 10
mut more := true
until more and o.x.len() <= _TTF_MAX_POINTS and work <= _TTF_MAX_WORK:
flags := _ttf_u16(f.data, f.size, cur)
sub := _ttf_u16(f.data, f.size, cur + 2)
cur += 4
mut a1 := 0
mut a2 := 0
if (flags & _TTF_ARG_WORDS) != 0:
a1 = _ttf_i16(f.data, f.size, cur)
a2 = _ttf_i16(f.data, f.size, cur + 2)
cur += 4
else:
a1 = _ttf_i8(f, cur)
a2 = _ttf_i8(f, cur + 1)
cur += 2
end
mut sa := 16384
mut sb := 0
mut sc := 0
mut sd := 16384
if (flags & _TTF_HAVE_SCALE) != 0:
sa = _ttf_i16(f.data, f.size, cur)
sd = sa
cur += 2
else (flags & _TTF_XY_SCALE) != 0:
sa = _ttf_i16(f.data, f.size, cur)
sd = _ttf_i16(f.data, f.size, cur + 2)
cur += 4
else (flags & _TTF_TWO_BY_TWO) != 0:
sa = _ttf_i16(f.data, f.size, cur)
sb = _ttf_i16(f.data, f.size, cur + 2)
sc = _ttf_i16(f.data, f.size, cur + 4)
sd = _ttf_i16(f.data, f.size, cur + 6)
cur += 8
end
mut ox := 0
mut oy := 0
if (flags & _TTF_ARGS_XY) != 0:
ox = a1
oy = a2
end
nxx := _f2_mul(xx, sa) + _f2_mul(yx, sb)
nxy := _f2_mul(xy, sa) + _f2_mul(yy, sb)
nyx := _f2_mul(xx, sc) + _f2_mul(yx, sd)
nyy := _f2_mul(xy, sc) + _f2_mul(yy, sd)
ndx := _f2_mul(xx, ox) + _f2_mul(yx, oy) + dx
ndy := _f2_mul(xy, ox) + _f2_mul(yy, oy) + dy
_i_glyph(f, sub, nxx, nxy, nyx, nyy, ndx, ndy, o, depth + 1, work)
more = (flags & _TTF_MORE_COMP) != 0
end
end
func _e_push(e &: _IEdges, x0: int, y0: int, x1: int, y1: int):
if y0 == y1:
ret
end
if y0 < y1:
e.x0.push(x0)
e.y0.push(y0)
e.x1.push(x1)
e.y1.push(y1)
e.dir.push(1)
else:
e.x0.push(x1)
e.y0.push(y1)
e.x1.push(x0)
e.y1.push(y0)
e.dir.push(-1)
end
end
func _iabs(v: int): int:
ret v < 0 ? 0 - v : v
end
func _e_quad(e &: _IEdges, x0: int, y0: int, cx: int, cy: int, x1: int, y1: int):
d := _iabs(cx - x0) + _iabs(cy - y0) + _iabs(x1 - cx) + _iabs(y1 - cy)
mut n := 1 + d / _RQ
if n > 32:
n = 32
end
nn := (n * n) as i64
mut px := x0
mut py := y0
mut k := 1
until k <= n:
a := ((n - k) * (n - k)) as i64
b := (2 * k * (n - k)) as i64
c := (k * k) as i64
qx := _div_round_s(a * (x0 as i64) + b * (cx as i64) + c * (x1 as i64), nn)
qy := _div_round_s(a * (y0 as i64) + b * (cy as i64) + c * (y1 as i64), nn)
_e_push(e, px, py, qx, qy)
px = qx
py = qy
k++
end
end
func _div_round_s(a: i64, b: i64): int:
ret _floordiv(a * (2 as i64) + b, b * (2 as i64)) as int
end
func _contour_iedges(xs &: Vector<int>, ys &: Vector<int>, oncurve &: Vector<bool>, s: int, e: int, out &: _IEdges):
if e - s < 2:
ret
end
mut sx := 0
mut sy := 0
mut lo := s
mut hi := e - 1
if oncurve.get(s):
sx = xs.get(s)
sy = ys.get(s)
lo = s + 1
else oncurve.get(e - 1):
sx = xs.get(e - 1)
sy = ys.get(e - 1)
hi = e - 2
else:
sx = _div_round_s((xs.get(s) + xs.get(e - 1)) as i64, 2 as i64)
sy = _div_round_s((ys.get(s) + ys.get(e - 1)) as i64, 2 as i64)
end
mut cx := sx
mut cy := sy
mut kx := 0
mut ky := 0
mut have := false
mut i := lo
until i <= hi:
px := xs.get(i)
py := ys.get(i)
if oncurve.get(i):
if have:
_e_quad(out, cx, cy, kx, ky, px, py)
have = false
else:
_e_push(out, cx, cy, px, py)
end
cx = px
cy = py
else:
if have:
mx := _div_round_s((kx + px) as i64, 2 as i64)
my := _div_round_s((ky + py) as i64, 2 as i64)
_e_quad(out, cx, cy, kx, ky, mx, my)
cx = mx
cy = my
end
kx = px
ky = py
have = true
end
i++
end
if have:
_e_quad(out, cx, cy, kx, ky, sx, sy)
else:
_e_push(out, cx, cy, sx, sy)
end
end
func _add_cov(acc &: Vector<int>, w: int, a0: int, b0: int):
lim := w * _RQ
mut a := a0
mut b := b0
if a < 0: a = 0 end
if b > lim: b = lim end
if b <= a:
ret
end
ia := a / _RQ
ib := b / _RQ
if ia == ib:
acc.set(ia, acc.get(ia) + b - a)
ret
end
acc.set(ia, acc.get(ia) + (ia + 1) * _RQ - a)
mut i := ia + 1
until i < ib:
acc.set(i, acc.get(i) + _RQ)
i++
end
if ib < w:
acc.set(ib, acc.get(ib) + b - ib * _RQ)
end
end
func _sort_cross(xs &: Vector<int>, ds &: Vector<int>):
mut i := 1
until i < xs.len():
x := xs.get(i)
d := ds.get(i)
mut j := i
until j > 0 and xs.get(j - 1) > x:
xs.set(j, xs.get(j - 1))
ds.set(j, ds.get(j - 1))
j--
end
xs.set(j, x)
ds.set(j, d)
i++
end
end
func _free_iedges(e &: _IEdges):
e.x0.free()
e.y0.free()
e.x1.free()
e.y1.free()
e.dir.free()
end
@en "RasterizeGlyph"
@fa "شطرنجی کردن گلیف"
pub func RasterizeGlyph(f: Font, glyph: int, size: f64, subpixel: int): GlyphMask:
mut m := GlyphMask {}
if not FontValid(f) or size <= 0.0:
ret m
end
size64 := _to26(size)
mut o := _IOut {}
mut work := 0
_i_glyph(f, glyph, 16384, 0, 0, 16384, 0, 0, o, 0, work)
np := o.x.len()
mut sx := Vector {} as Vector<int>
mut sy := Vector {} as Vector<int>
shift := (subpixel & 3) * (_RQ / 4)
mut minx := 0
mut maxx := 0
mut miny := 0
mut maxy := 0
mut i := 0
until i < np:
sx.push(_div_round((o.x.get(i) as i64) * (size64 as i64) * (4 as i64), f.units_per_em as i64) + shift)
sy.push(0 - _div_round((o.y.get(i) as i64) * (size64 as i64) * (4 as i64), f.units_per_em as i64))
vx := sx.get(i)
vy := sy.get(i)
if i == 0 or vx < minx: minx = vx end
if i == 0 or vx > maxx: maxx = vx end
if i == 0 or vy < miny: miny = vy end
if i == 0 or vy > maxy: maxy = vy end
i++
end
mut edges := _IEdges {}
mut s := 0
each e in o.ends:
if e > s and e <= np:
_contour_iedges(sx, sy, o.on, s, e, edges)
end
s = e
end
ne := edges.dir.len()
if ne > 0 and ne <= _RMAX_EDGES:
px0 := _floordiv(minx as i64, _RQ as i64) as int
px1 := (_floordiv((maxx - 1) as i64, _RQ as i64) as int) + 1
py0 := _floordiv(miny as i64, _RQ as i64) as int
py1 := (_floordiv((maxy - 1) as i64, _RQ as i64) as int) + 1
w := px1 - px0
h := py1 - py0
if w > 0 and h > 0 and w <= 4096 and h <= 4096:
m.data = mem.AllocateZeroed((w * h) as u64)
m.width = w
m.height = h
m.stride = w
m.left = px0
m.top = 0 - py0
bp := m.data as u8*
mut acc := Vector {} as Vector<int>
acc.zeros(w)
mut cx := Vector {} as Vector<int>
mut cd := Vector {} as Vector<int>
ox := px0 * _RQ
mut row := 0
until row < h:
mut k := 0
until k < w:
acc.set(k, 0)
k++
end
mut sub := 0
until sub < _RSUB:
yy := (py0 + row) * _RQ + sub * (_RQ / _RSUB) + (_RQ / _RSUB) / 2
cx.clear()
cd.clear()
mut q := 0
until q < ne:
ey0 := edges.y0.get(q)
ey1 := edges.y1.get(q)
if yy >= ey0 and yy < ey1:
ex0 := edges.x0.get(q)
ex1 := edges.x1.get(q)
xc := ex0 + (_floordiv(((yy - ey0) as i64) * ((ex1 - ex0) as i64), (ey1 - ey0) as i64) as int)
cx.push(xc - ox)
cd.push(edges.dir.get(q))
end
q++
end
_sort_cross(cx, cd)
mut wind := 0
mut start := 0
mut c := 0
until c < cx.len():
prev := wind
wind += cd.get(c)
if prev == 0 and wind != 0:
start = cx.get(c)
else prev != 0 and wind == 0:
_add_cov(acc, w, start, cx.get(c))
end
c++
end
sub++
end
k = 0
until k < w:
mut v := (acc.get(k) * 255 + (_RQ * _RSUB) / 2) / (_RQ * _RSUB)
if v > 255:
v = 255
end
bp[row * w + k] = v as u8
k++
end
row++
end
acc.free()
cx.free()
cd.free()
end
end
_free_iedges(edges)
sx.free()
sy.free()
o.x.free()
o.y.free()
o.on.free()
o.ends.free()
ret m
end
@en "FreeGlyphMask"
@fa "آزادسازی ماسک گلیف"
pub func FreeGlyphMask(m &: GlyphMask):
if m.data != null:
mem.Free(m.data)
end
m.data = null
m.width = 0
m.height = 0
m.stride = 0
end
@en "GlyphMaskHash"
@fa "درهم ماسک گلیف"
pub func GlyphMaskHash(m: GlyphMask): i64:
mut h := 1469598103934665603 as i64
if m.data == null:
ret h
end
bp := m.data as u8*
mut y := 0
until y < m.height:
mut x := 0
until x < m.width:
h = (h ^ (bp[y * m.stride + x] as i64)) * (1099511628211 as i64)
x++
end
y++
end
ret h
end
@en "SubpixelOf"
@fa "زیرپیکسل"
pub func SubpixelOf(x: f64): int:
q := math.Round(x * 4.0) as int
ret q - (_floordiv(q as i64, 4 as i64) as int) * 4
end
@en "GlyphOriginX"
@fa "مبدا افقی گلیف"
pub func GlyphOriginX(x: f64, m: GlyphMask): int:
q := math.Round(x * 4.0) as int
ret (_floordiv(q as i64, 4 as i64) as int) + m.left
end
@en "GlyphOriginY"
@fa "مبدا عمودی گلیف"
pub func GlyphOriginY(y: f64, m: GlyphMask): int:
ret (math.Round(y) as int) - m.top
end
@en "NewGlyphCache"
@fa "نهانگاه گلیف تازه"
pub func NewGlyphCache(capacity_bytes: int): GlyphCache:
mut c := GlyphCache {}
c.capacity = capacity_bytes
ret c
end
@en "CachedGlyph"
@fa "گلیف نهان"
pub func CachedGlyph(c &: GlyphCache, f: Font, glyph: int, size: f64, x: f64): GlyphMask:
sub := SubpixelOf(x)
key := ((((f.id as i64) * (1048576 as i64) + ((_to26(size) & 0xFFFFF) as i64)) * (65536 as i64) + ((glyph & 0xFFFF) as i64)) * (4 as i64)) + (sub as i64)
c.clock++
if c.index.has(key):
si := c.index.get(key)
mut slot := c.slots.get(si)
slot.stamp = c.clock
c.slots.set(si, slot)
c.hits++
ret slot.mask
end
c.misses++
m := RasterizeGlyph(f, glyph, size, sub)
cost := m.stride * m.height + 64
until c.bytes + cost > c.capacity and c.index.size() > 0:
mut oldest := -1
mut old_stamp := c.clock
mut i := 0
until i < c.slots.len():
sl := c.slots.get(i)
if sl.used and sl.stamp <= old_stamp:
oldest = i
old_stamp = sl.stamp
end
i++
end
if oldest < 0:
break
end
mut victim := c.slots.get(oldest)
c.bytes -= victim.mask.stride * victim.mask.height + 64
c.index.remove(victim.key)
FreeGlyphMask(victim.mask)
victim.used = false
c.slots.set(oldest, victim)
end
mut slot := CacheSlot {}
slot.key = key
slot.mask = m
slot.stamp = c.clock
slot.used = true
mut at := -1
mut i := 0
until i < c.slots.len() and at < 0:
if not c.slots.get(i).used:
at = i
end
i++
end
if at < 0:
at = c.slots.len()
c.slots.push(slot)
else:
c.slots.set(at, slot)
end
c.index.put(key, at)
c.bytes += cost
ret m
end
@en "FreeGlyphCache"
@fa "آزادسازی نهانگاه گلیف"
pub func FreeGlyphCache(c &: GlyphCache):
mut i := 0
until i < c.slots.len():
mut sl := c.slots.get(i)
if sl.used:
FreeGlyphMask(sl.mask)
end
i++
end
c.slots.free()
c.index.free()
c.slots = Vector {} as Vector<CacheSlot>
c.index = HashMap {} as HashMap<i64, int>
c.bytes = 0
end
package typeset
import str
import unicode
const _JT_U := 0
const _JT_R := 1
const _JT_D := 2
const _JT_C := 3
const _JT_T := 4
const _FORM_NONE := 0
const _FORM_ISOL := 1
const _FORM_FINA := 2
const _FORM_MEDI := 3
const _FORM_INIT := 4
const _FB_CCMP := 0
const _FB_LOCL := 1
const _FB_ISOL := 2
const _FB_FINA := 3
const _FB_MEDI := 4
const _FB_INIT := 5
const _FB_RLIG := 6
const _FB_CALT := 7
const _FB_LIGA := 8
const _FB_CLIG := 9
const _FB_RCLT := 10
const _FB_KERN := 11
const _FB_MARK := 12
const _FB_MKMK := 13
const _FB_ABVM := 14
const _FB_BLWM := 15
const _FB_DIST := 16
const _FB_RTLA := 17
const _FB_COUNT := 18
@en "ShapedGlyph"
@fa "گلیف شکل‌یافته"
pub struct ShapedGlyph:
@en "id"
@fa "شناسه"
pub id: int = 0
@en "cluster"
@fa "خوشه"
pub cluster: int = 0
@en "x_advance"
@fa "پیشروی افقی"
pub x_advance: int = 0
@en "x_offset"
@fa "جابجایی افقی"
pub x_offset: int = 0
@en "y_offset"
@fa "جابجایی عمودی"
pub y_offset: int = 0
end
func _feat_tag(bit: int): int:
switch bit:
_FB_CCMP: ret _tag("ccmp") end
_FB_LOCL: ret _tag("locl") end
_FB_ISOL: ret _tag("isol") end
_FB_FINA: ret _tag("fina") end
_FB_MEDI: ret _tag("medi") end
_FB_INIT: ret _tag("init") end
_FB_RLIG: ret _tag("rlig") end
_FB_CALT: ret _tag("calt") end
_FB_LIGA: ret _tag("liga") end
_FB_CLIG: ret _tag("clig") end
_FB_RCLT: ret _tag("rclt") end
_FB_KERN: ret _tag("kern") end
_FB_MARK: ret _tag("mark") end
_FB_MKMK: ret _tag("mkmk") end
_FB_ABVM: ret _tag("abvm") end
_FB_BLWM: ret _tag("blwm") end
_FB_DIST: ret _tag("dist") end
_FB_RTLA: ret _tag("rtla") end
else: ret 0 end
end
ret 0
end
func _jt_range(cp: int, lo: int, hi: int): bool:
ret cp >= lo and cp <= hi
end
func _joining_type(cp: int): int:
if cp == 0x200D or cp == 0x0640 or cp == 0x07FA: ret _JT_C end
if cp == 0x200C: ret _JT_U end
if cp >= 0x0600 and cp <= 0x06FF:
if _jt_range(cp, 0x0610, 0x061A) or _jt_range(cp, 0x064B, 0x065F) or cp == 0x0670: ret _JT_T end
if _jt_range(cp, 0x06D6, 0x06DC) or _jt_range(cp, 0x06DF, 0x06E4) or _jt_range(cp, 0x06E7, 0x06E8) or _jt_range(cp, 0x06EA, 0x06ED): ret _JT_T end
if cp == 0x0620 or cp == 0x0626 or cp == 0x0628 or _jt_range(cp, 0x062A, 0x062E): ret _JT_D end
if _jt_range(cp, 0x0622, 0x0625) or cp == 0x0627 or cp == 0x0629 or _jt_range(cp, 0x062F, 0x0632): ret _JT_R end
if _jt_range(cp, 0x0633, 0x063F) or _jt_range(cp, 0x0641, 0x0647) or _jt_range(cp, 0x0649, 0x064A): ret _JT_D end
if cp == 0x0648: ret _JT_R end
if _jt_range(cp, 0x066E, 0x066F) or _jt_range(cp, 0x0678, 0x0687) or _jt_range(cp, 0x069A, 0x06BF): ret _JT_D end
if _jt_range(cp, 0x0671, 0x0673) or _jt_range(cp, 0x0675, 0x0677) or _jt_range(cp, 0x0688, 0x0699) or cp == 0x06C0: ret _JT_R end
if _jt_range(cp, 0x06C1, 0x06C2) or cp == 0x06CC or cp == 0x06CE or _jt_range(cp, 0x06D0, 0x06D1): ret _JT_D end
if _jt_range(cp, 0x06C3, 0x06CB) or cp == 0x06CD or cp == 0x06CF or _jt_range(cp, 0x06D2, 0x06D3) or cp == 0x06D5: ret _JT_R end
if _jt_range(cp, 0x06EE, 0x06EF): ret _JT_R end
if _jt_range(cp, 0x06FA, 0x06FC) or cp == 0x06FF: ret _JT_D end
ret _JT_U
end
if cp >= 0x0750 and cp <= 0x077F:
if _jt_range(cp, 0x0759, 0x075B) or _jt_range(cp, 0x076B, 0x076C) or cp == 0x0771 or _jt_range(cp, 0x0773, 0x0774) or _jt_range(cp, 0x0778, 0x0779): ret _JT_R end
ret _JT_D
end
if cp >= 0x08A0 and cp <= 0x08C9:
if _jt_range(cp, 0x08AA, 0x08AC) or cp == 0x08AE or _jt_range(cp, 0x08B1, 0x08B2) or cp == 0x08B9: ret _JT_R end
if cp == 0x08AD: ret _JT_U end
ret _JT_D
end
if cp >= 0x08CA and cp <= 0x08FF: ret _JT_T end
if cp < 0x0300:
ret _JT_U
end
cat := unicode.Category(cp)
if unicode.IsMark(cp) or (unicode.IsFormat(cp) and cat >= 0):
ret _JT_T
end
ret _JT_U
end
func _joining_forms(cps &: Vector<int>, s: int, e: int, forms &: Vector<int>):
mut prev := -1
mut prev_t := _JT_U
mut i := s
until i < e:
t := _joining_type(cps.get(i))
if t == _JT_T:
forms.set(i, _FORM_NONE)
i++
continue
end
if prev >= 0 and (prev_t == _JT_D or prev_t == _JT_C) and (t == _JT_D or t == _JT_R or t == _JT_C):
pf := forms.get(prev)
if pf == _FORM_ISOL:
forms.set(prev, _FORM_INIT)
else pf == _FORM_FINA:
forms.set(prev, _FORM_MEDI)
end
forms.set(i, (t == _JT_U) ? _FORM_NONE : _FORM_FINA)
else:
forms.set(i, (t == _JT_U) ? _FORM_NONE : _FORM_ISOL)
end
if t == _JT_C and forms.get(i) == _FORM_FINA:
forms.set(i, _FORM_FINA)
end
prev = i
prev_t = t
i++
end
end
func _is_default_ignorable(cp: int): bool:
if cp == 0x00AD or cp == 0x034F or cp == 0x061C or cp == 0x3164 or cp == 0xFEFF or cp == 0xFFA0: ret true end
if cp >= 0x200B and cp <= 0x200F: ret true end
if cp >= 0x202A and cp <= 0x202E: ret true end
if cp >= 0x2060 and cp <= 0x206F: ret true end
if cp >= 0xFE00 and cp <= 0xFE0F: ret true end
if cp >= 0x180B and cp <= 0x180F: ret true end
if cp >= 0xFFF0 and cp <= 0xFFF8: ret true end
if cp >= 0xE0000 and cp <= 0xE0FFF: ret true end
if cp == 0x115F or cp == 0x1160 or cp == 0x17B4 or cp == 0x17B5: ret true end
ret false
end
func _opentype_script_tag(sc: int): int:
if sc == unicode.ScriptArabic: ret _tag("arab") end
if sc == unicode.ScriptLatin: ret _tag("latn") end
if sc == unicode.ScriptCyrillic: ret _tag("cyrl") end
if sc == unicode.ScriptGreek: ret _tag("grek") end
if sc == unicode.ScriptHebrew: ret _tag("hebr") end
if sc == unicode.ScriptHan: ret _tag("hani") end
if sc == unicode.ScriptHiragana or sc == unicode.ScriptKatakana: ret _tag("kana") end
if sc == unicode.ScriptHangul: ret _tag("hang") end
if sc == unicode.ScriptThai: ret _tag("thai") end
if sc == unicode.ScriptArmenian: ret _tag("armn") end
if sc == unicode.ScriptGeorgian: ret _tag("geor") end
if sc == unicode.ScriptSyriac: ret _tag("syrc") end
if sc == unicode.ScriptThaana: ret _tag("thaa") end
ret _tag("DFLT")
end
func _lang_tag(lang: str): int:
if str.Len(lang) < 2:
ret 0
end
bp := lang as u8*
c0 := (bp[0] as int) | 0x20
c1 := (bp[1] as int) | 0x20
code := (c0 << 8) | c1
switch code:
0x6661: ret _tag("FAR ") end
0x6172: ret _tag("ARA ") end
0x7572: ret _tag("URD ") end
0x6B75: ret _tag("KUR ") end
0x7073: ret _tag("PAS ") end
0x7364: ret _tag("SND ") end
0x7567: ret _tag("UYG ") end
0x656E: ret _tag("ENG ") end
0x6465: ret _tag("DEU ") end
0x6672: ret _tag("FRA ") end
0x7472: ret _tag("TRK ") end
0x7275: ret _tag("RUS ") end
else: ret 0 end
end
ret 0
end
func _stage_lookups(f: Font, table: int, langsys: int, bits: Vector<int>, idx &: Vector<int>, masks &: Vector<int>): bool:
idx.clear()
masks.clear()
mut found := false
mut tmp := Vector {} as Vector<int>
defer tmp.free()
each bit in bits:
tmp.clear()
if _feature_lookups(f, table, langsys, _feat_tag(bit), tmp):
found = true
end
each li in tmp:
mut k := 0
mut merged := false
until k < idx.len():
if idx.get(k) == li:
masks.set(k, masks.get(k) | (1 << bit))
merged = true
break
end
k++
end
if not merged:
mut at := idx.len()
until at > 0 and idx.get(at - 1) > li:
at--
end
idx.insert(at, li)
masks.insert(at, 1 << bit)
end
end
end
ret found
end
func _run_stage(f: Font, table: int, gsub: bool, langsys: int, bits: Vector<int>, b &: _Buf): bool:
mut idx := Vector {} as Vector<int>
mut masks := Vector {} as Vector<int>
defer idx.free()
defer masks.free()
found := _stage_lookups(f, table, langsys, bits, idx, masks)
mut k := 0
until k < idx.len():
_apply_lookup_pass(f, table, gsub, idx.get(k), masks.get(k), b)
k++
end
ret found
end
func _has_feature(f: Font, table: int, langsys: int, bit: int): bool:
mut tmp := Vector {} as Vector<int>
defer tmp.free()
ret _feature_lookups(f, table, langsys, _feat_tag(bit), tmp)
end
func _form_code(form: int): int:
if form == _FORM_FINA: ret _AR_FINAL end
if form == _FORM_INIT: ret _AR_INITIAL end
if form == _FORM_MEDI: ret _AR_MEDIAL end
ret _AR_ISOLATED
end
func _arabic_fallback(f: Font, b &: _Buf, forms &: Vector<int>):
mut i := 0
until i < b.g.len():
cp := b.cp.get(i)
form := forms.get(b.cl.get(i))
if cp == 0x0644 and (form == _FORM_INIT or form == _FORM_MEDI):
mut j := i + 1
until j < b.g.len() and b.cls.get(j) == 3:
j++
end
if j < b.g.len():
lig := _arabic_lam_alef(cp, b.cp.get(j))
if lig != 0:
mut lcp := lig
if form == _FORM_MEDI:
lcp = lig + 1
end
lg := GlyphIndex(f, lcp)
if lg != 0:
b.g.set(i, lg)
_buf_remove(b, j)
i++
continue
end
end
end
end
if form != _FORM_NONE:
pf := _arabic_shaped(cp, _form_code(form))
if pf != cp:
pg := GlyphIndex(f, pf)
if pg != 0:
b.g.set(i, pg)
end
end
end
i++
end
end
func _bits(a: int, b: int, c: int, d: int): Vector<int>:
mut v := Vector {} as Vector<int>
if a >= 0: v.push(a) end
if b >= 0: v.push(b) end
if c >= 0: v.push(c) end
if d >= 0: v.push(d) end
ret v
end
func _gsub_all(f: Font, b &: _Buf, arabic: bool, langsys: int, forms &: Vector<int>):
if arabic:
mut st := _bits(_FB_CCMP, _FB_LOCL, -1, -1)
_run_stage(f, f.gsub, true, langsys, st, b)
st.free()
joining := _has_feature(f, f.gsub, langsys, _FB_ISOL) or _has_feature(f, f.gsub, langsys, _FB_FINA) or _has_feature(f, f.gsub, langsys, _FB_INIT) or _has_feature(f, f.gsub, langsys, _FB_MEDI)
if joining:
each bit in [_FB_ISOL, _FB_FINA, _FB_MEDI, _FB_INIT]:
mut one := _bits(bit, -1, -1, -1)
_run_stage(f, f.gsub, true, langsys, one, b)
one.free()
end
end
mut rl := _bits(_FB_RLIG, -1, -1, -1)
_run_stage(f, f.gsub, true, langsys, rl, b)
rl.free()
if not joining:
_arabic_fallback(f, b, forms)
end
mut ca := _bits(_FB_RCLT, _FB_CALT, -1, -1)
_run_stage(f, f.gsub, true, langsys, ca, b)
ca.free()
mut li := _bits(_FB_LIGA, _FB_CLIG, _FB_RTLA, -1)
_run_stage(f, f.gsub, true, langsys, li, b)
li.free()
ret
end
mut all := _bits(_FB_CCMP, _FB_LOCL, _FB_RLIG, _FB_RTLA)
all.push(_FB_CALT)
all.push(_FB_LIGA)
all.push(_FB_CLIG)
all.push(_FB_RCLT)
_run_stage(f, f.gsub, true, langsys, all, b)
all.free()
end
func _legacy_kern(f: Font, b &: _Buf):
mut i := 0
until i < b.g.len():
if b.cls.get(i) != 3:
mut j := i + 1
until j < b.g.len() and b.cls.get(j) == 3:
j++
end
if j < b.g.len():
b.xa.set(i, b.xa.get(i) + KernAdvance(f, b.g.get(i), b.g.get(j)))
end
end
i++
end
end
func _shape_buf(f: Font, cps &: Vector<int>, forms &: Vector<int>, skip &: Vector<bool>, s: int, e: int, rtl: bool, script_tag: int, lang_tag: int, off_mask: int, b &: _Buf):
mut global := 0
mut k := 0
until k < _FB_COUNT:
if k != _FB_ISOL and k != _FB_FINA and k != _FB_MEDI and k != _FB_INIT and (k != _FB_RTLA or rtl):
global |= 1 << k
end
k++
end
global &= ~off_mask
arabic := script_tag == _tag("arab")
mut i := s
until i < e:
if skip.get(i):
i++
continue
end
cp := cps.get(i)
mut use := cp
if rtl:
use = _bidi_mirror(cp)
end
mut g := GlyphIndex(f, use)
if g == 0 and use != cp:
g = GlyphIndex(f, cp)
end
mut mask := global
fm := forms.get(i)
if fm == _FORM_ISOL: mask |= 1 << _FB_ISOL end
if fm == _FORM_FINA: mask |= 1 << _FB_FINA end
if fm == _FORM_MEDI: mask |= 1 << _FB_MEDI end
if fm == _FORM_INIT: mask |= 1 << _FB_INIT end
_buf_push(b, g, i, cp, mask, _glyph_class(f, g, cp))
i++
end
_normalize_run(f, b)
if f.gsub != 0:
_gsub_all(f, b, arabic, _langsys_off(f, f.gsub, script_tag, lang_tag), forms)
else arabic:
_arabic_fallback(f, b, forms)
end
mut q := 0
until q < b.g.len():
b.xa.set(q, GlyphAdvance(f, b.g.get(q)))
q++
end
mut kerned := false
if f.gpos != 0:
gl := _langsys_off(f, f.gpos, script_tag, lang_tag)
kerned = _has_feature(f, f.gpos, gl, _FB_KERN)
mut pb := _bits(_FB_KERN, _FB_MARK, _FB_MKMK, _FB_DIST)
pb.push(_FB_ABVM)
pb.push(_FB_BLWM)
_run_stage(f, f.gpos, false, gl, pb, b)
pb.free()
end
if not kerned and f.kern != 0 and (off_mask & (1 << _FB_KERN)) == 0:
_legacy_kern(f, b)
end
q = 0
until q < b.g.len():
if b.cls.get(q) == 3:
b.xa.set(q, 0)
end
q++
end
q = 0
until q < b.g.len():
j := b.att.get(q)
if j >= 0 and j < q:
mut xo := b.xo.get(q) + b.xo.get(j)
b.yo.set(q, b.yo.get(q) + b.yo.get(j))
if not rtl:
mut m := j
until m < q:
xo -= b.xa.get(m)
m++
end
else:
mut m := j + 1
until m <= q:
xo += b.xa.get(m)
m++
end
end
b.xo.set(q, xo)
end
q++
end
space := GlyphIndex(f, 32)
q = 0
until q < b.g.len():
if _is_default_ignorable(b.cp.get(q)):
b.g.set(q, space)
b.xa.set(q, 0)
b.xo.set(q, 0)
b.yo.set(q, 0)
b.att.set(q, -2)
end
q++
end
end
func _modified_ccc(cp: int): int:
if cp >= 0x064B and cp <= 0x0650:
ret unicode.CombiningClass(cp) + 1
end
if cp == 0x0651:
ret 27
end
ret unicode.CombiningClass(cp)
end
func _normalize_run(f: Font, b &: _Buf):
mut i := 1
until i < b.g.len():
c := _modified_ccc(b.cp.get(i))
if c != 0:
mut j := i
until j > 0 and _modified_ccc(b.cp.get(j - 1)) > c:
j--
end
if j < i:
cp := b.cp.get(i)
cl := b.cl.get(i)
m := b.mask.get(i)
k := b.cls.get(i)
gg := b.g.get(i)
mut low := cl
mut q := j
until q < i:
if b.cl.get(q) < low:
low = b.cl.get(q)
end
q++
end
_buf_remove(b, i)
_buf_insert_at(b, j, gg, cl, cp, m, k)
q = j
until q <= i:
b.cl.set(q, low)
q++
end
end
end
i++
end
i = 1
until i < b.g.len():
if _modified_ccc(b.cp.get(i)) != 0 and _modified_ccc(b.cp.get(i - 1)) == 0:
comp := unicode.Compose(b.cp.get(i - 1), b.cp.get(i))
if comp > 0:
cg := GlyphIndex(f, comp)
if cg != 0:
b.cp.set(i - 1, comp)
b.g.set(i - 1, cg)
b.cls.set(i - 1, _glyph_class(f, cg, comp))
_buf_remove(b, i)
continue
end
end
end
i++
end
end
func _auto_script(cps &: Vector<int>): int:
each cp in cps:
sc := unicode.Script(cp)
if sc != unicode.ScriptCommon and sc != unicode.ScriptInherited and sc != unicode.ScriptUnknown:
ret sc
end
end
ret unicode.ScriptLatin
end
@en "ShapeText"
@fa "شکل‌دهی متن"
pub func ShapeText(f: Font, text: str, rtl: bool, script: str, lang: str): Vector<ShapedGlyph>:
mut out := Vector {} as Vector<ShapedGlyph>
if not FontValid(f):
ret out
end
mut cps := Vector {} as Vector<int>
mut offs := Vector {} as Vector<int>
defer cps.free()
defer offs.free()
n := str.Len(text)
bp := text as u8*
mut i := 0
until i < n:
offs.push(i)
mut cp := 0
i = _utf8_next(bp, n, i, cp)
cps.push(cp)
end
mut forms := Vector {} as Vector<int>
mut skip := Vector {} as Vector<bool>
defer forms.free()
defer skip.free()
forms.zeros(cps.len())
repeat cps.len():
skip.push(false)
end
_joining_forms(cps, 0, cps.len(), forms)
mut stag := 0
if str.Len(script) == 0:
stag = _opentype_script_tag(_auto_script(cps))
else:
stag = _tag(script)
end
mut b := _Buf {}
_shape_buf(f, cps, forms, skip, 0, cps.len(), rtl, stag, _lang_tag(lang), 0, b)
mut q := 0
until q < b.g.len():
mut sg := ShapedGlyph {}
sg.id = b.g.get(q)
sg.cluster = offs.get(b.cl.get(q))
sg.x_advance = b.xa.get(q)
sg.x_offset = b.xo.get(q)
sg.y_offset = b.yo.get(q)
if rtl:
out.insert(0, sg)
else:
out.push(sg)
end
q++
end
_buf_free(b)
ret out
end
package typeset
@en "TextDirAuto"
@fa "جهت متن خودکار"
pub const TextDirAuto := 0
@en "TextDirLTR"
@fa "جهت متن چپ به راست"
pub const TextDirLTR := 1
@en "TextDirRTL"
@fa "جهت متن راست به چپ"
pub const TextDirRTL := 2
const _BC_L := 0
const _BC_R := 1
const _BC_AL := 2
const _BC_EN := 3
const _BC_AN := 4
const _BC_NSM := 5
const _BC_WS := 6
const _BC_ON := 7
const _BC_CS := 8
const _BC_ES := 9
const _BC_ET := 10
func _bidi_is_rtl_class(c: int): bool:
ret c == _BC_R or c == _BC_AL
end
func _bidi_implicit_level(c: int, base: int): int:
if base == 1:
if c == _BC_R: ret 1 end
ret 2
end
if c == _BC_R: ret 1 end
if c == _BC_EN or c == _BC_AN: ret 2 end
ret 0
end
func _bidi_side_class(classes &: Vector<int>, i: int, base: int, forward: bool): int:
mut k := i
until k >= 0 and k < classes.len():
c := classes.get(k)
if c == _BC_L: ret _BC_L end
if c == _BC_R or c == _BC_EN or c == _BC_AN: ret _BC_R end
if forward:
k++
else:
k--
end
end
if base == 1: ret _BC_R end
ret _BC_L
end
func _bidi_is_neutral(c: int): bool:
ret c == _BC_WS or c == _BC_ON
end
func _bidi_levels(cps &: Vector<int>, base: int, levels &: Vector<int>):
mut classes := Vector {} as Vector<int>
_bidi_classes(cps, classes)
_bidi_weak_rules(classes, base)
_bidi_resolve_pairs(cps, classes, base)
mut i := 0
until i < classes.len():
c := classes.get(i)
if _bidi_is_neutral(c):
before := _bidi_side_class(classes, i - 1, base, false)
after := _bidi_side_class(classes, i + 1, base, true)
if before == after:
levels.push(_bidi_implicit_level(before, base))
else:
levels.push(base)
end
else:
levels.push(_bidi_implicit_level(c, base))
end
i++
end
mut k := levels.len() - 1
until k >= 0:
if not _bidi_is_neutral(classes.get(k)):
break
end
levels.set(k, base)
k--
end
classes.free()
end
func _bidi_reverse_range(cps &: Vector<int>, lo: int, hi: int):
mut a := lo
mut b := hi
until a < b:
tmp := cps.get(a)
cps.set(a, cps.get(b))
cps.set(b, tmp)
a++
b--
end
end
func _bidi_reorder(cps &: Vector<int>, levels &: Vector<int>):
mut max_level := 0
mut i := 0
until i < levels.len():
if levels.get(i) > max_level:
max_level = levels.get(i)
end
i++
end
mut lvl := max_level
until lvl >= 1:
mut k := 0
until k < levels.len():
if levels.get(k) >= lvl:
mut e := k
until e + 1 < levels.len() and levels.get(e + 1) >= lvl:
e++
end
_bidi_reverse_range(cps, k, e)
k = e + 1
else:
k++
end
end
lvl--
end
end
func _bidi_mirror(cp: int): int:
if cp == 0x28: ret 0x29 end
if cp == 0x29: ret 0x28 end
if cp == 0x5B: ret 0x5D end
if cp == 0x5D: ret 0x5B end
if cp == 0x7B: ret 0x7D end
if cp == 0x7D: ret 0x7B end
if cp == 0x3C: ret 0x3E end
if cp == 0x3E: ret 0x3C end
if cp == 0x00AB: ret 0x00BB end
if cp == 0x00BB: ret 0x00AB end
if cp == 0x2039: ret 0x203A end
if cp == 0x203A: ret 0x2039 end
ret cp
end
func _bidi_apply_mirroring(cps &: Vector<int>, levels &: Vector<int>):
mut i := 0
until i < cps.len():
if (levels.get(i) % 2) == 1:
cps.set(i, _bidi_mirror(cps.get(i)))
end
i++
end
end
func _bidi_has_rtl(cps &: Vector<int>): bool:
mut i := 0
until i < cps.len():
if _bidi_is_rtl_class(_bidi_class(cps.get(i))):
ret true
end
i++
end
ret false
end
func _bidi_needs_reorder(cps &: Vector<int>): bool:
mut i := 0
until i < cps.len():
c := _bidi_class(cps.get(i))
if _bidi_is_rtl_class(c) or c == _BC_AN:
ret true
end
i++
end
ret false
end
func _bidi_base_level(cps &: Vector<int>, dir: int): int:
if dir == TextDirRTL: ret 1 end
if dir == TextDirLTR: ret 0 end
mut i := 0
until i < cps.len():
c := _bidi_class(cps.get(i))
if _bidi_is_rtl_class(c): ret 1 end
if c == _BC_L: ret 0 end
i++
end
ret 0
end
func _bidi_visual(cps &: Vector<int>, dir: int): bool:
base := _bidi_base_level(cps, dir)
if base == 0 and not _bidi_needs_reorder(cps):
ret false
end
mut levels := Vector {} as Vector<int>
_bidi_levels(cps, base, levels)
_bidi_apply_mirroring(cps, levels)
_bidi_reorder(cps, levels)
levels.free()
ret true
end
@en "IsRTLText"
@fa "متن راست به چپ است"
pub func IsRTLText(text: str): bool:
mut cps := Vector {} as Vector<int>
_utf8_decode_all(text, cps)
out := _bidi_has_rtl(cps)
cps.free()
ret out
end
@en "BaseDirection"
@fa "جهت پایه"
pub func BaseDirection(text: str): int:
mut cps := Vector {} as Vector<int>
_utf8_decode_all(text, cps)
base := _bidi_base_level(cps, TextDirAuto)
cps.free()
if base == 1:
ret TextDirRTL
end
ret TextDirLTR
end
@en "ToVisualOrder"
@fa "به ترتیب نمایشی"
pub func ToVisualOrder(text: str, dir: int): str:
mut logical := Vector {} as Vector<int>
mut shaped := Vector {} as Vector<int>
_utf8_decode_all(text, logical)
_shape_arabic(logical, shaped)
_bidi_visual(shaped, dir)
out := _utf8_encode_all(shaped)
logical.free()
shaped.free()
ret out
end
@en "VisualCodepoints"
@fa "کدهای نمایشی"
pub func VisualCodepoints(text: str, dir: int, shape: bool): Vector<int>:
mut out := Vector {} as Vector<int>
if not shape:
_utf8_decode_all(text, out)
_text_drop_invisible(out)
ret out
end
mut logical := Vector {} as Vector<int>
_utf8_decode_all(text, logical)
_shape_arabic(logical, out)
_bidi_visual(out, dir)
_text_drop_invisible(out)
logical.free()
ret out
end
package typeset
const _BIDI_MAX_PAIRS := 63
func _bidi_bracket_close(cp: int): int:
if cp == 0x28: ret 0x29 end
if cp == 0x5B: ret 0x5D end
if cp == 0x7B: ret 0x7D end
if cp == 0x2045: ret 0x2046 end
if cp == 0x2308: ret 0x2309 end
if cp == 0x230A: ret 0x230B end
if cp == 0x3008: ret 0x3009 end
if cp == 0x300A: ret 0x300B end
if cp == 0x300C: ret 0x300D end
if cp == 0x300E: ret 0x300F end
if cp == 0x3010: ret 0x3011 end
if cp == 0x3014: ret 0x3015 end
if cp == 0x3016: ret 0x3017 end
if cp == 0x3018: ret 0x3019 end
if cp == 0x301A: ret 0x301B end
if cp == 0xFF08: ret 0xFF09 end
if cp == 0xFF3B: ret 0xFF3D end
if cp == 0xFF5B: ret 0xFF5D end
ret 0
end
func _bidi_strong_of(c: int): int:
if c == _BC_L: ret _BC_L end
if c == _BC_R or c == _BC_EN or c == _BC_AN: ret _BC_R end
ret 0 - 1
end
func _bidi_find_pairs(cps &: Vector<int>, classes &: Vector<int>, opens &: Vector<int>, closes &: Vector<int>):
mut stack_close := Vector {} as Vector<int>
mut stack_pos := Vector {} as Vector<int>
mut i := 0
until i < cps.len():
if classes.get(i) == _BC_ON:
cp := cps.get(i)
closer := _bidi_bracket_close(cp)
if closer != 0:
if stack_close.len() >= _BIDI_MAX_PAIRS:
break
end
stack_close.push(closer)
stack_pos.push(i)
else:
mut k := stack_close.len() - 1
until k >= 0:
if stack_close.get(k) == cp:
opens.push(stack_pos.get(k))
closes.push(i)
until stack_close.len() <= k:
stack_close.pop()
stack_pos.pop()
end
break
end
k--
end
end
end
i++
end
stack_close.free()
stack_pos.free()
mut a := 1
until a < opens.len():
o := opens.get(a)
c := closes.get(a)
mut b := a - 1
until b >= 0 and opens.get(b) > o:
opens.set(b + 1, opens.get(b))
closes.set(b + 1, closes.get(b))
b--
end
opens.set(b + 1, o)
closes.set(b + 1, c)
a++
end
end
func _bidi_inside_strong(classes &: Vector<int>, open: int, close: int, e: int): int:
mut found_opposite := false
mut i := open + 1
until i < close:
s := _bidi_strong_of(classes.get(i))
if s == e:
ret e
end
if s >= 0:
found_opposite = true
end
i++
end
if found_opposite:
if e == _BC_L: ret _BC_R end
ret _BC_L
end
ret 0 - 1
end
func _bidi_before_strong(classes &: Vector<int>, open: int, base: int): int:
mut i := open - 1
until i >= 0:
s := _bidi_strong_of(classes.get(i))
if s >= 0:
ret s
end
i--
end
if base == 1:
ret _BC_R
end
ret _BC_L
end
func _bidi_resolve_pairs(cps &: Vector<int>, classes &: Vector<int>, base: int):
mut e := _BC_L
if base == 1:
e = _BC_R
end
mut opens := Vector {} as Vector<int>
mut closes := Vector {} as Vector<int>
_bidi_find_pairs(cps, classes, opens, closes)
mut i := 0
until i < opens.len():
open := opens.get(i)
close := closes.get(i)
inside := _bidi_inside_strong(classes, open, close, e)
if inside == e:
classes.set(open, e)
classes.set(close, e)
else if inside >= 0:
if _bidi_before_strong(classes, open, base) == inside:
classes.set(open, inside)
classes.set(close, inside)
else:
classes.set(open, e)
classes.set(close, e)
end
end
i++
end
opens.free()
closes.free()
end
package typeset
func _bidi_class(cp: int): int:
if cp == 0x20 or cp == 0x09 or cp == 0x0A or cp == 0x0D or cp == 0x0C: ret _BC_WS end
if cp >= 0x2000 and cp <= 0x200A: ret _BC_WS end
if cp == 0x3000 or cp == 0x00A0: ret _BC_WS end
if cp >= 0x30 and cp <= 0x39: ret _BC_EN end
if _arabic_transparent(cp): ret _BC_NSM end
if cp == 0x2C or cp == 0x2E or cp == 0x2F or cp == 0x3A: ret _BC_CS end
if cp == 0x060C: ret _BC_CS end
if cp == 0x2B or cp == 0x2D: ret _BC_ES end
if cp == 0x23 or cp == 0x24 or cp == 0x25 or cp == 0x00B0: ret _BC_ET end
if cp == 0x066A: ret _BC_ET end
if cp >= 0x20A0 and cp <= 0x20CF: ret _BC_ET end
if cp >= 0x0660 and cp <= 0x0669: ret _BC_AN end
if cp == 0x066B or cp == 0x066C: ret _BC_AN end
if cp >= 0x06F0 and cp <= 0x06F9: ret _BC_EN end
if cp == 0x061B or cp == 0x061F or cp == 0x06D4: ret _BC_ON end
if cp >= 0x0600 and cp <= 0x06FF: ret _BC_AL end
if cp >= 0x0750 and cp <= 0x077F: ret _BC_AL end
if cp >= 0x08A0 and cp <= 0x08FF: ret _BC_AL end
if cp >= 0xFB50 and cp <= 0xFDFF: ret _BC_AL end
if cp >= 0xFE70 and cp <= 0xFEFF: ret _BC_AL end
if cp >= 0x0590 and cp <= 0x05FF: ret _BC_R end
if cp >= 0x07C0 and cp <= 0x089F: ret _BC_R end
if cp >= 0xFB1D and cp <= 0xFB4F: ret _BC_R end
if cp >= 0x21 and cp <= 0x2F: ret _BC_ON end
if cp >= 0x3A and cp <= 0x40: ret _BC_ON end
if cp >= 0x5B and cp <= 0x60: ret _BC_ON end
if cp >= 0x7B and cp <= 0x7E: ret _BC_ON end
if cp >= 0x00A1 and cp <= 0x00BF: ret _BC_ON end
if cp >= 0x2010 and cp <= 0x205E: ret _BC_ON end
if cp >= 0x20A0 and cp <= 0x20CF: ret _BC_ON end
ret _BC_L
end
func _bidi_classes(cps &: Vector<int>, classes &: Vector<int>):
mut i := 0
until i < cps.len():
classes.push(_bidi_class(cps.get(i)))
i++
end
end
func _bidi_next_class(classes &: Vector<int>, i: int, skip: int): int:
mut k := i + 1
until k < classes.len():
c := classes.get(k)
if c != skip:
ret c
end
k++
end
ret _BC_ON
end
func _bidi_weak_rules(classes &: Vector<int>, base: int):
mut prev := _BC_L
if base == 1:
prev = _BC_R
end
mut last_strong := prev
mut i := 0
until i < classes.len():
mut c := classes.get(i)
if c == _BC_NSM:
c = prev
end
if c == _BC_EN and last_strong == _BC_AL:
c = _BC_AN
end
if c == _BC_L or c == _BC_R or c == _BC_AL:
last_strong = c
end
if c == _BC_AL:
c = _BC_R
end
if c == _BC_CS or c == _BC_ES:
nxt := _bidi_next_class(classes, i, 0 - 1)
mut joined := nxt
if joined == _BC_EN and last_strong == _BC_AL:
joined = _BC_AN
end
if prev == _BC_EN and joined == _BC_EN:
c = _BC_EN
end
if c == _BC_CS and prev == _BC_AN and joined == _BC_AN:
c = _BC_AN
end
end
if c == _BC_ET:
if prev == _BC_EN:
c = _BC_EN
else if _bidi_next_class(classes, i, _BC_ET) == _BC_EN and last_strong != _BC_AL:
c = _BC_EN
end
end
if c == _BC_CS or c == _BC_ES or c == _BC_ET:
c = _BC_ON
end
classes.set(i, c)
prev = c
i++
end
_bidi_rule_w7(classes, base)
end
func _bidi_rule_w7(classes &: Vector<int>, base: int):
mut last_strong := _BC_L
if base == 1:
last_strong = _BC_R
end
mut i := 0
until i < classes.len():
c := classes.get(i)
if c == _BC_L or c == _BC_R:
last_strong = c
end
if c == _BC_EN and last_strong == _BC_L:
classes.set(i, _BC_L)
end
i++
end
end
package typeset
import str
func _utf8_next(bp: u8*, n: int, i: int, cp &: int): int:
b0 := bp[i] as int
if b0 < 0x80:
cp = b0
ret i + 1
end
if (b0 & 0xE0) == 0xC0 and i + 1 < n:
cp = ((b0 & 0x1F) << 6) | ((bp[i + 1] as int) & 0x3F)
ret i + 2
end
if (b0 & 0xF0) == 0xE0 and i + 2 < n:
cp = ((b0 & 0x0F) << 12) | (((bp[i + 1] as int) & 0x3F) << 6) | ((bp[i + 2] as int) & 0x3F)
ret i + 3
end
if (b0 & 0xF8) == 0xF0 and i + 3 < n:
cp = ((b0 & 0x07) << 18) | (((bp[i + 1] as int) & 0x3F) << 12) | (((bp[i + 2] as int) & 0x3F) << 6) | ((bp[i + 3] as int) & 0x3F)
ret i + 4
end
cp = 0xFFFD
ret i + 1
end
func _utf8_decode_all(text: str, out &: Vector<int>):
n := str.Len(text)
bp := text as u8*
mut i := 0
until i < n:
mut cp := 0
i = _utf8_next(bp, n, i, cp)
out.push(cp)
end
end
func _utf8_append(b &: str.StringBuilder, cp: int):
if cp < 0x80:
str.BufAppendChar(b, cp)
ret
end
if cp < 0x800:
str.BufAppendChar(b, 0xC0 | (cp >> 6))
str.BufAppendChar(b, 0x80 | (cp & 0x3F))
ret
end
if cp < 0x10000:
str.BufAppendChar(b, 0xE0 | (cp >> 12))
str.BufAppendChar(b, 0x80 | ((cp >> 6) & 0x3F))
str.BufAppendChar(b, 0x80 | (cp & 0x3F))
ret
end
str.BufAppendChar(b, 0xF0 | (cp >> 18))
str.BufAppendChar(b, 0x80 | ((cp >> 12) & 0x3F))
str.BufAppendChar(b, 0x80 | ((cp >> 6) & 0x3F))
str.BufAppendChar(b, 0x80 | (cp & 0x3F))
end
func _text_drawable(cp: int): bool:
if cp < 0x20: ret false end
if cp == 0x7F: ret false end
if cp == 0x00AD: ret false end
if cp >= 0x200B and cp <= 0x200F: ret false end
if cp >= 0x202A and cp <= 0x202E: ret false end
if cp >= 0x2060 and cp <= 0x2064: ret false end
if cp >= 0x2066 and cp <= 0x2069: ret false end
if cp == 0xFEFF: ret false end
ret true
end
func _text_drop_invisible(cps &: Vector<int>):
mut w := 0
mut i := 0
until i < cps.len():
cp := cps.get(i)
if _text_drawable(cp):
cps.set(w, cp)
w++
end
i++
end
until cps.len() > w:
cps.pop()
end
end
func _utf8_encode_all(cps &: Vector<int>): str:
mut b := str.NewBuilder()
mut i := 0
until i < cps.len():
_utf8_append(b, cps.get(i))
i++
end
out := str.BufStr(b)
str.BufFree(b)
ret out
end
