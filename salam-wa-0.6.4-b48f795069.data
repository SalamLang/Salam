@en "SearchBody"
@fa "بدنه جستجو"
pub func SearchBody(req: SearchRequest): str:
mut m := Vector {} as Vector<str>
if req.query.len() > 0: m.push(json.MemberRaw("query", req.query)) end
if req.from >= 0: m.push(json.MemberInt("from", req.from as i64)) end
if req.size >= 0: m.push(json.MemberInt("size", req.size as i64)) end
if req.sort.len() > 0: m.push(json.MemberRaw("sort", json.Array(req.sort))) end
switch true:
req.no_source:
m.push(json.MemberRaw("_source", "false"))
break
end
req.source_excludes.len() > 0:
mut src := Vector {} as Vector<str>
if req.source.len() > 0: src.push(json.MemberRaw("includes", _strs(req.source))) end
src.push(json.MemberRaw("excludes", _strs(req.source_excludes)))
m.push(json.MemberRaw("_source", json.Object(src)))
break
end
req.source.len() > 0:
m.push(json.MemberRaw("_source", _strs(req.source)))
end
end
if req.fields.len() > 0: m.push(json.MemberRaw("fields", _strs(req.fields))) end
if req.aggs.len() > 0: m.push(json.MemberRaw("aggs", req.aggs)) end
if req.highlight.len() > 0: m.push(json.MemberRaw("highlight", req.highlight)) end
if req.post_filter.len() > 0: m.push(json.MemberRaw("post_filter", req.post_filter)) end
if req.knn.len() > 0: m.push(json.MemberRaw("knn", req.knn)) end
if req.collapse.len() > 0: m.push(json.MemberRaw("collapse", _one("field", json.Str(req.collapse)))) end
if req.suggest.len() > 0: m.push(json.MemberRaw("suggest", req.suggest)) end
if req.search_after.len() > 0: m.push(json.MemberRaw("search_after", req.search_after)) end
if req.pit_id.len() > 0:
mut pit := Vector {} as Vector<str>
pit.push(json.Member("id", req.pit_id))
if req.pit_keep_alive.len() > 0: pit.push(json.Member("keep_alive", req.pit_keep_alive)) end
m.push(json.MemberRaw("pit", json.Object(pit)))
end
if req.track_total_hits.len() > 0: m.push(json.MemberRaw("track_total_hits", req.track_total_hits)) end
if req.min_score.len() > 0: m.push(json.MemberRaw("min_score", req.min_score)) end
if req.timeout.len() > 0: m.push(json.Member("timeout", req.timeout)) end
each x in req.extra:
m.push(x)
end
ret json.Object(m)
end
package elasticsearch
import str
import encoding.json
func _hit_of(raw: str): Hit:
ret Hit {
index = json.Get(raw, "_index"), id = json.Get(raw, "_id"), score = _f64(json.Get(raw, "_score")),
source = json.Get(raw, "_source"), sort = json.Get(raw, "sort"), highlight = json.Get(raw, "highlight"),
fields = json.Get(raw, "fields"), raw = str.Clone(raw)
}
end
func _search_path(index: str, op: str): str:
if index.len() == 0: ret "/" + op end
ret "/" + _idx(index) + "/" + op
end
func _search_result(r: Response): SearchResult:
mut res := ParseSearchResult(r.body)
res.ok = r.ok and res.ok
res.status = r.status
res.error = r.error
ret res
end
func _by_query_body(query: str, script: str): str:
mut m := Vector {} as Vector<str>
m.push(json.MemberRaw("query", query.len() > 0 ? query : MatchAll()))
if script.len() > 0: m.push(json.MemberRaw("script", script)) end
ret json.Object(m)
end
func _by_query_path(index: str, op: str, opts: Options): str:
mut q := Vector {} as Vector<str>
_qadd(q, "refresh", opts.refresh == REFRESH_WAIT_FOR ? "true" : opts.refresh)
_qadd(q, "routing", opts.routing)
_qadd(q, "timeout", opts.timeout)
_qadd(q, "conflicts", opts.conflicts)
ret _search_path(index, op) + _qs(q)
end
@en "ParseSearchResult"
@fa "تجزیه نتیجه جستجو"
pub func ParseSearchResult(body: str): SearchResult:
mut res := SearchResult { raw = str.Clone(body) }
hits := json.Get(body, "hits")
res.ok = hits.len() > 0
res.took = _i64(json.Get(body, "took"))
res.timed_out = json.Get(body, "timed_out") == "true"
total := json.Get(hits, "total")
if str.StartsWith(total, "{"):
res.total = _i64(json.Get(total, "value"))
res.total_relation = json.Get(total, "relation")
else:
res.total = _i64(total)
res.total_relation = str.Clone("eq")
end
res.max_score = _f64(json.Get(hits, "max_score"))
each raw in json.Items(json.Get(hits, "hits")):
res.hits.push(_hit_of(raw))
end
res.aggregations = json.Get(body, "aggregations")
res.suggest = json.Get(body, "suggest")
res.scroll_id = json.Get(body, "_scroll_id")
res.pit_id = json.Get(body, "pit_id")
ret res
end
@en "Search"
@fa "جستجو"
pub func Search(c: Client, index: str, req: SearchRequest): SearchResult:
ret SearchRaw(c, index, SearchBody(req))
end
@en "SearchQuery"
@fa "جستجوی پرسمان"
pub func SearchQuery(c: Client, index: str, query: str, size: int): SearchResult:
ret Search(c, index, SearchRequest { query = query, size = size })
end
@en "SearchRaw"
@fa "جستجوی خام"
pub func SearchRaw(c: Client, index: str, body: str): SearchResult:
ret _search_result(Perform(c, "POST", _search_path(index, "_search"), body))
end
@en "SearchScroll"
@fa "جستجوی پیمایشی"
pub func SearchScroll(c: Client, index: str, req: SearchRequest, keep_alive: str): SearchResult:
path := _search_path(index, "_search") + "?scroll=" + _seg(keep_alive)
ret _search_result(Perform(c, "POST", path, SearchBody(req)))
end
@en "Scroll"
@fa "پیمایش"
pub func Scroll(c: Client, scroll_id: str, keep_alive: str): SearchResult:
mut m := Vector {} as Vector<str>
m.push(json.Member("scroll", keep_alive))
m.push(json.Member("scroll_id", scroll_id))
ret _search_result(Perform(c, "POST", "/_search/scroll", json.Object(m)))
end
@en "ClearScroll"
@fa "پاک کردن پیمایش"
pub func ClearScroll(c: Client, scroll_id: str): bool:
r := Perform(c, "DELETE", "/_search/scroll", _one("scroll_id", json.Str(scroll_id)))
ret r.ok
end
@en "OpenPit"
@fa "گشودن نقطه زمانی"
pub func OpenPit(c: Client, index: str, keep_alive: str): str:
if _opensearch(c):
r := Perform(c, "POST", "/" + _idx(index) + "/_search/point_in_time?keep_alive=" + _seg(keep_alive), "")
if not r.ok: ret str.Clone("") end
ret json.Get(r.body, "pit_id")
end
r := Perform(c, "POST", "/" + _idx(index) + "/_pit?keep_alive=" + _seg(keep_alive), "")
if not r.ok: ret str.Clone("") end
ret json.Get(r.body, "id")
end
@en "ClosePit"
@fa "بستن نقطه زمانی"
pub func ClosePit(c: Client, pit_id: str): bool:
if _opensearch(c):
mut ids := Vector {} as Vector<str>
ids.push(pit_id)
ret Perform(c, "DELETE", "/_search/point_in_time", _one("pit_id", _strs(ids))).ok
end
r := Perform(c, "DELETE", "/_pit", _one("id", json.Str(pit_id)))
ret r.ok
end
@en "DeleteByQuery"
@fa "حذف با پرسمان"
pub func DeleteByQuery(c: Client, index: str, query: str): i64:
ret DeleteByQueryWith(c, index, query, Options {})
end
@en "DeleteByQueryWith"
@fa "حذف با پرسمان با گزینه"
pub func DeleteByQueryWith(c: Client, index: str, query: str, opts: Options): i64:
r := Perform(c, "POST", _by_query_path(index, "_delete_by_query", opts), _by_query_body(query, ""))
if not r.ok: ret -1 end
ret _i64(json.Get(r.body, "deleted"))
end
@en "UpdateByQuery"
@fa "به‌روزرسانی با پرسمان"
pub func UpdateByQuery(c: Client, index: str, query: str, script: str): i64:
ret UpdateByQueryWith(c, index, query, script, Options {})
end
@en "UpdateByQueryWith"
@fa "به‌روزرسانی با پرسمان با گزینه"
pub func UpdateByQueryWith(c: Client, index: str, query: str, script: str, opts: Options): i64:
r := Perform(c, "POST", _by_query_path(index, "_update_by_query", opts), _by_query_body(query, script))
if not r.ok: ret -1 end
ret _i64(json.Get(r.body, "updated"))
end
@en "MSearch"
@fa "جستجوی چندگانه"
pub func MSearch(c: Client, index: str, bodies: Vector<str>): Vector<SearchResult>:
mut out := Vector {} as Vector<SearchResult>
mut sb := str.NewBuilder()
defer str.BufFree(sb)
each b in bodies:
str.BufAppend(sb, "{}\n")
str.BufAppend(sb, _one_line(b))
str.BufAppend(sb, "\n")
end
r := PerformNdjson(c, "POST", _search_path(index, "_msearch"), str.BufStr(sb))
if not r.ok: ret out end
each raw in json.Items(json.Get(r.body, "responses")):
mut one := ParseSearchResult(raw)
st := _i64(json.Get(raw, "status")) as int
one.status = st
err := json.GetPath(raw, "error.reason")
if err.len() > 0:
one.ok = false
one.error = json.GetPath(raw, "error.type") + ": " + err
end
out.push(one)
end
ret out
end
@en "AggValueIn"
@fa "مقدار تجمیع در"
pub func AggValueIn(aggs: str, name: str): f64:
ret _f64(json.Get(json.Get(aggs, name), "value"))
end
@en "AggBucketsIn"
@fa "سطل‌های تجمیع در"
pub func AggBucketsIn(aggs: str, name: str): Vector<Bucket>:
mut out := Vector {} as Vector<Bucket>
each raw in json.Items(json.Get(json.Get(aggs, name), "buckets")):
mut key := json.Get(raw, "key_as_string")
if key.len() == 0: key = json.Get(raw, "key") end
out.push(Bucket { key = key, doc_count = _i64(json.Get(raw, "doc_count")), raw = str.Clone(raw) })
end
ret out
end
@en "AggValue"
@fa "مقدار تجمیع"
pub func AggValue(res: SearchResult, name: str): f64:
ret AggValueIn(res.aggregations, name)
end
@en "AggBuckets"
@fa "سطل‌های تجمیع"
pub func AggBuckets(res: SearchResult, name: str): Vector<Bucket>:
ret AggBucketsIn(res.aggregations, name)
end
@en "AggRaw"
@fa "تجمیع خام"
pub func AggRaw(res: SearchResult, name: str): str:
ret json.Get(res.aggregations, name)
end
package elasticsearch
import mem
import str
import db
import encoding.json
struct _SqlState:
pub client: void* = null
pub ok: bool = false
pub err: str = ""
pub names: Vector<str> = Vector {}
pub types: Vector<str> = Vector {}
pub rows: Vector<str> = Vector {}
pub pos: int = 0
pub cells: Vector<str> = Vector {}
pub cursor: str = ""
pub os: bool = false
end
@en "SqlRows"
@fa "ردیف‌های اس کیو ال"
pub struct SqlRows:
@en "handle"
@fa "دسته"
pub handle: void* = null
@en "Ok"
@fa "معتبر"
pub func Ok(): bool:
if this.handle == null: ret false end
ret _sq(this.handle)[0].ok
end
@en "Error"
@fa "خطا"
pub func Error(): str:
if this.handle == null: ret str.Clone("no result") end
ret str.Clone(_sq(this.handle)[0].err)
end
@en "Next"
@fa "بعدی"
pub func Next(): bool:
if this.handle == null: ret false end
s := _sq(this.handle)
if not s[0].ok: ret false end
if s[0].pos >= s[0].rows.len():
if s[0].cursor.len() == 0: ret false end
if not _sql_page(s): ret false end
if s[0].rows.len() == 0: ret false end
end
s[0].cells = json.Items(s[0].rows.get(s[0].pos))
s[0].pos++
ret true
end
@en "ColumnCount"
@fa "تعداد ستون"
pub func ColumnCount(): int:
if this.handle == null: ret 0 end
ret _sq(this.handle)[0].names.len()
end
@en "ColumnName"
@fa "نام ستون"
pub func ColumnName(col: int): str:
if this.handle == null: ret str.Clone("") end
s := _sq(this.handle)
if col < 0 or col >= s[0].names.len(): ret str.Clone("") end
ret str.Clone(s[0].names.get(col))
end
@en "ColumnTypeName"
@fa "نام نوع ستون"
pub func ColumnTypeName(col: int): str:
if this.handle == null: ret str.Clone("") end
s := _sq(this.handle)
if col < 0 or col >= s[0].types.len(): ret str.Clone("") end
ret str.Clone(s[0].types.get(col))
end
@en "ColumnType"
@fa "نوع ستون"
pub func ColumnType(col: int): int:
if this.handle == null: ret db.TYPE_NULL end
if _sq(this.handle)[0].cells.len() > 0 and this.IsNull(col): ret db.TYPE_NULL end
ret _sql_kind(this.ColumnTypeName(col))
end
@en "IsNull"
@fa "خالی است"
pub func IsNull(col: int): bool:
ret _sql_cell(this.handle, col) == "null"
end
@en "Text"
@fa "متن"
pub func Text(col: int): str:
raw := _sql_cell(this.handle, col)
if raw == "null": ret str.Clone("") end
ret json.Unquote(raw)
end
@en "Int"
@fa "عدد صحیح"
pub func Int(col: int): int:
ret _int(_sql_number(_sql_cell(this.handle, col)))
end
@en "Int64"
@fa "عدد صحیح۶۴"
pub func Int64(col: int): i64:
ret _i64(_sql_number(_sql_cell(this.handle, col)))
end
@en "Float"
@fa "عدد اعشار"
pub func Float(col: int): f64:
ret _f64(_sql_cell(this.handle, col))
end
@en "Close"
@fa "بستن"
pub func Close(): int:
if this.handle == null: ret -1 end
s := _sq(this.handle)
if s[0].cursor.len() > 0 and s[0].client != null:
c := Client { handle = s[0].client }
Perform(c, "POST", _sql_path(s[0].os, "close"), _one("cursor", json.Str(s[0].cursor)))
end
mem.Free(this.handle)
this.handle = null
ret 0
end
end
@en "Database"
@fa "پایگاه داده"
pub struct Database:
@en "handle"
@fa "دسته"
pub handle: void* = null
@en "Kind"
@fa "نوع"
pub func Kind(): str: ret db.ELASTICSEARCH end
@en "Ok"
@fa "معتبر"
pub func Ok(): bool:
ret _client_ok(this.handle)
end
@en "Ping"
@fa "پینگ"
pub func Ping(): bool:
ret _client_ping(this.handle)
end
@en "Exec"
@fa "اجرا"
pub func Exec(_sql: str): int:
if this.handle == null: ret -1 end
_set_error(this.handle, "elasticsearch SQL is read-only; write with Index, Bulk or DeleteByQuery")
ret -1
end
@en "Query"
@fa "پرسمان"
pub func Query(sql: str): dyn db.Rows:
ret Sql(Client { handle = this.handle }, sql)
end
@en "Begin"
@fa "شروع تراکنش"
pub func Begin(): dyn db.Tx:
if this.handle != null:
_set_error(this.handle, "elasticsearch has no transactions")
end
ret Txn {}
end
@en "LastInsertId"
@fa "شناسه آخرین درج"
pub func LastInsertId(): i64: ret 0 end
@en "Changes"
@fa "تعداد تغییرات"
pub func Changes(): i64: ret 0 end
@en "Error"
@fa "خطا"
pub func Error(): str:
ret _client_error(this.handle)
end
@en "Quote"
@fa "نقل قول"
pub func Quote(s: str): str:
ret db.QuoteLiteral(s)
end
@en "Close"
@fa "بستن"
pub func Close(): int:
if this.handle == null: ret -1 end
_client_close(this.handle)
this.handle = null
ret 0
end
end
@en "Txn"
@fa "تراکنش"
pub struct Txn:
@en "handle"
@fa "دسته"
pub handle: void* = null
@en "Ok"
@fa "معتبر"
pub func Ok(): bool: ret false end
@en "Exec"
@fa "اجرا"
pub func Exec(_sql: str): int: ret -1 end
@en "Query"
@fa "پرسمان"
pub func Query(_sql: str): dyn db.Rows:
ret SqlRows {}
end
@en "Commit"
@fa "ثبت تراکنش"
pub func Commit(): int: ret -1 end
@en "Rollback"
@fa "بازگردانی"
pub func Rollback(): int: ret -1 end
end
func _client_ok(h: void*): bool:
ret Ok(Client { handle = h })
end
func _client_ping(h: void*): bool:
ret Ping(Client { handle = h })
end
func _client_error(h: void*): str:
ret Error(Client { handle = h })
end
func _client_close(h: void*):
mut c := Client { handle = h }
Close(c)
end
func _sq(h: void*): _SqlState*:
ret h as _SqlState*
end
func _set_error(h: void*, msg: str):
_set_state(h as _EsState*, 0, msg, "", msg)
end
func _sql_cell(h: void*, col: int): str:
if h == null: ret "null" end
s := _sq(h)
if col < 0 or col >= s[0].cells.len(): ret "null" end
ret s[0].cells.get(col)
end
func _sql_number(raw: str): str:
switch raw:
"true": ret "1" end
"false": ret "0" end
end
if str.StartsWith(raw, `"`): ret json.Unquote(raw) end
dot := raw.find(".")
if dot > 0: ret raw.substr(0, dot) end
ret raw
end
func _sql_kind(t: str): int:
switch t:
"long", "integer", "short", "byte", "unsigned_long", "boolean": ret db.TYPE_INT end
"double", "float", "half_float", "scaled_float": ret db.TYPE_FLOAT end
"binary": ret db.TYPE_BLOB end
"null": ret db.TYPE_NULL end
end
ret db.TYPE_TEXT
end
func _sql_path(os: bool, op: str): str:
switch op:
"query": ret os ? "/_plugins/_sql?format=jdbc" : "/_sql?format=json" end
"text": ret os ? "/_plugins/_sql?format=csv" : "/_sql?format=txt" end
"close": ret os ? "/_plugins/_sql/close" : "/_sql/close" end
"translate": ret os ? "/_plugins/_sql/_explain" : "/_sql/translate" end
end
ret ""
end
func _sql_fill(s: _SqlState*, r: Response):
if not r.ok:
s[0].ok = false
s[0].err = r.error
s[0].rows = Vector {} as Vector<str>
s[0].cursor = ""
ret
end
mut cols := json.Get(r.body, "columns")
if cols.len() == 0: cols = json.Get(r.body, "schema") end
if cols.len() > 0:
mut names := Vector {} as Vector<str>
mut types := Vector {} as Vector<str>
each col in json.Items(cols):
mut name := json.Get(col, "alias")
if name.len() == 0: name = json.Get(col, "name") end
names.push(name)
types.push(json.Get(col, "type"))
end
s[0].names = names
s[0].types = types
end
mut rows := json.Get(r.body, "rows")
if rows.len() == 0: rows = json.Get(r.body, "datarows") end
s[0].rows = json.Items(rows)
s[0].pos = 0
s[0].cursor = json.Get(r.body, "cursor")
s[0].ok = true
end
func _sql_page(s: _SqlState*): bool:
c := Client { handle = s[0].client }
r := Perform(c, "POST", _sql_path(s[0].os, "query"), _one("cursor", json.Str(s[0].cursor)))
_sql_fill(s, r)
ret s[0].ok
end
func _sql_request(c: Client, query: str, params: Vector<str>, fetch_size: int): SqlRows:
s := mem.AllocateZeroed(sizeof(_SqlState) as u64) as _SqlState*
s[0] = _SqlState {}
s[0].client = c.handle
s[0].os = _opensearch(c)
_sql_fill(s, Perform(c, "POST", _sql_path(s[0].os, "query"), _sql_body(query, params, fetch_size, s[0].os)))
ret SqlRows { handle = s as void* }
end
func _os_param(raw: str): str:
t := str.Trim(raw)
mut kind := "long"
switch true:
str.StartsWith(t, `"`):
kind = "string"
break
end
t == "true" or t == "false":
kind = "boolean"
break
end
t.find(".") >= 0 or t.find("e") >= 0 or t.find("E") >= 0:
kind = "double"
end
end
mut m := Vector {} as Vector<str>
m.push(json.Member("type", kind))
m.push(json.MemberRaw("value", t))
ret json.Object(m)
end
func _sql_body(query: str, params: Vector<str>, fetch_size: int, os: bool): str:
mut m := Vector {} as Vector<str>
m.push(json.Member("query", query))
if params.len() > 0:
if os:
mut typed := Vector {} as Vector<str>
each p in params:
typed.push(_os_param(p))
end
m.push(json.MemberRaw("parameters", json.Array(typed)))
else:
m.push(json.MemberRaw("params", json.Array(params)))
end
end
if fetch_size > 0: m.push(json.MemberInt("fetch_size", fetch_size as i64)) end
ret json.Object(m)
end
@en "Sql"
@fa "اس کیو ال"
pub func Sql(c: Client, query: str): SqlRows:
ret _sql_request(c, query, Vector {} as Vector<str>, 0)
end
@en "SqlWith"
@fa "اس کیو ال با پارامتر"
pub func SqlWith(c: Client, query: str, params: Vector<str>, fetch_size: int): SqlRows:
ret _sql_request(c, query, params, fetch_size)
end
@en "SqlText"
@fa "متن اس کیو ال"
pub func SqlText(c: Client, query: str): str:
os := _opensearch(c)
r := Perform(c, "POST", _sql_path(os, "text"), _sql_body(query, Vector {} as Vector<str>, 0, os))
if not r.ok: ret str.Clone("") end
ret r.body
end
@en "SqlTranslate"
@fa "ترجمه اس کیو ال"
pub func SqlTranslate(c: Client, query: str): str:
os := _opensearch(c)
r := Perform(c, "POST", _sql_path(os, "translate"), _sql_body(query, Vector {} as Vector<str>, 0, os))
if not r.ok: ret str.Clone("") end
ret r.body
end
@en "Conn"
@fa "اتصال عمومی"
pub func Conn(c: Client): dyn db.Connection:
ret Database { handle = c.handle }
end
package elasticsearch
import mem
import str
import conv
import tls
import encoding
import encoding.json
import encoding.url
import net.http
import time
func _st(c: Client): _EsState*:
ret c.handle as _EsState*
end
func _parse_node(raw: str, user &: str, pass &: str): _Node:
mut text := str.Trim(raw)
if not str.Contains(text, "://"): text = "http://" + text end
mut u := url.URL {}
try:
u = url.Parse(text)
catch:
ret _Node { url = text }
end
scheme := u.scheme.lower()
if scheme != "http" and scheme != "https": ret _Node { url = text } end
if u.host.len() == 0: ret _Node { url = text } end
secure := scheme == "https"
port := u.port > 0 ? u.port : DEFAULT_PORT
if u.userinfo.len() > 0 and user.len() == 0:
mut info := u.userinfo
try:
info = url.DecodedUserinfo(u)
catch:
info = u.userinfo
end
colon := info.find(":")
if colon >= 0:
user = info.substr(0, colon)
pass = info.substr(colon + 1, info.len() - colon - 1)
else:
user = info
end
end
mut prefix := u.path
until str.EndsWith(prefix, "/"):
prefix = prefix.substr(0, prefix.len() - 1)
end
mut host_header := u.host
if u.host.find(":") >= 0: host_header = "[" + u.host + "]" end
default_port := secure ? 443 : 80
if port != default_port: host_header = host_header + ":" + str.FromInt(port as i64) end
shown := scheme + "://" + host_header + prefix
ep := http.Endpoint { host = u.host, port = port, secure = secure, ok = true }
ret _Node { ep = ep, prefix = prefix, host_header = host_header, url = shown }
end
func _cloud_url(cloud_id: str): str:
colon := cloud_id.find(":")
mut encoded := cloud_id
if colon >= 0: encoded = cloud_id.substr(colon + 1, cloud_id.len() - colon - 1) end
mut decoded := ""
try:
decoded = encoding.Base64Decode(encoded)
catch:
ret str.Clone("")
end
parts := decoded.split("$")
if parts.len() < 2: ret str.Clone("") end
mut host := parts.get(0)
mut port := "443"
hc := host.find(":")
if hc >= 0:
port = host.substr(hc + 1, host.len() - hc - 1)
host = host.substr(0, hc)
end
es := parts.get(1)
if host.len() == 0 or es.len() == 0: ret str.Clone("") end
ret "https://" + es + "." + host + ":" + port
end
func _auth_header(user: str, pass: str, api_key: str, bearer: str): str:
if api_key.len() > 0:
if api_key.find(":") >= 0: ret "ApiKey " + encoding.Base64Encode(api_key) end
ret "ApiKey " + api_key
end
if bearer.len() > 0: ret "Bearer " + bearer end
if user.len() > 0: ret "Basic " + encoding.Base64Encode(user + ":" + pass) end
ret str.Clone("")
end
func _head(st: _EsState*, node: _Node, method: str, path: str, ctype: str, blen: int): str:
mut sb := str.NewBuilder()
defer str.BufFree(sb)
str.BufAppend(sb, method)
str.BufAppend(sb, " ")
str.BufAppend(sb, node.prefix)
if not str.StartsWith(path, "/"): str.BufAppend(sb, "/") end
str.BufAppend(sb, path)
str.BufAppend(sb, " HTTP/1.1\r\nHost: ")
str.BufAppend(sb, node.host_header)
str.BufAppend(sb, "\r\nUser-Agent: salam-elasticsearch/1.0\r\nAccept: application/json\r\n")
if blen > 0 or method == "POST" or method == "PUT":
str.BufAppend(sb, "Content-Type: ")
str.BufAppend(sb, ctype)
str.BufAppend(sb, "\r\nContent-Length: ")
str.BufAppendInt(sb, blen as i64)
str.BufAppend(sb, "\r\n")
end
if st[0].auth.len() > 0:
str.BufAppend(sb, "Authorization: ")
str.BufAppend(sb, st[0].auth)
str.BufAppend(sb, "\r\n")
end
str.BufAppend(sb, st[0].extra_headers)
str.BufAppend(sb, st[0].keep_alive ? "Connection: keep-alive\r\n\r\n" : "Connection: close\r\n\r\n")
ret str.BufStr(sb)
end
func _tls_cfg(st: _EsState*, node: _Node): tls.Config:
mut cfg := tls.NewConfig(node.ep.host)
cfg.ca_file = st[0].ca_file
cfg.insecure_skip_verify = st[0].insecure
ret cfg
end
func _raw_body(raw: http.RawResponse): str:
if raw.data == null or raw.len <= 0: ret str.Clone("") end
p := mem.Allocate((raw.len + 1) as u64)
mem.Copy(p, raw.data, raw.len as u64)
bp := p as u8*
bp[raw.len] = 0 as u8
ret p as str
end
func _parse_error(r &: Response):
if r.ok: ret end
body := r.body
et := json.GetPath(body, "error.type")
if et.len() > 0:
r.error_type = et
r.error_reason = json.GetPath(body, "error.reason")
cause := json.GetPath(body, "error.root_cause.0.reason")
if cause.len() > 0 and cause != r.error_reason:
r.error = et + ": " + r.error_reason + " (" + cause + ")"
else:
r.error = et + ": " + r.error_reason
end
ret
end
plain := json.Get(body, "error")
if plain.len() > 0 and not str.StartsWith(plain, "{"):
r.error_reason = plain
r.error = "HTTP " + str.FromInt(r.status as i64) + ": " + plain
ret
end
r.error = "HTTP " + str.FromInt(r.status as i64)
end
func _set_state(st: _EsState*, status: int, err: str, err_type: str, err_reason: str):
old_err := st[0].err
old_type := st[0].err_type
old_reason := st[0].err_reason
st[0].status = status
st[0].err = str.Clone(err)
st[0].err_type = str.Clone(err_type)
st[0].err_reason = str.Clone(err_reason)
mem.Free(old_err as void*)
mem.Free(old_type as void*)
mem.Free(old_reason as void*)
end
func _record(st: _EsState*, r: Response):
_set_state(st, r.status, r.error, r.error_type, r.error_reason)
end
func _retryable(status: int): bool:
ret status == 502 or status == 503 or status == 504
end
func _replay_ok(method: str, resp: _WireResp): bool:
if not resp.sent or resp.quick: ret true end
ret method == "GET" or method == "HEAD" or method == "PUT" or method == "DELETE"
end
func _resendable(method: str, resp: _WireResp): bool:
ret resp.stale and _replay_ok(method, resp)
end
func _send_once(st: _EsState*, ni: int, node: _Node, method: str, head: str, body: str, blen: int): _WireResp:
if not st[0].keep_alive:
mut raw := http.SendRawTLS(node.ep, head, body as void*, blen, st[0].timeout_ms, _tls_cfg(st, node))
if raw.error.len() > 0:
e := str.Clone(raw.error)
http.FreeRaw(raw)
early := str.StartsWith(e, "could not connect") or str.StartsWith(e, "TLS") or str.StartsWith(e, "the endpoint")
ret _WireResp { err = e, sent = not early }
end
out := _WireResp { status = raw.status, body = _raw_body(raw) }
http.FreeRaw(raw)
ret out
end
w := st[0].wires.get(ni) as _Wire*
repeat 2:
if not w[0].open:
e := _wire_connect(w, node, _tls_cfg(st, node), st[0].timeout_ms)
if e.len() > 0: ret _WireResp { err = e } end
end
resp := _wire_roundtrip(w, method, head, body, blen)
if resp.err.len() == 0: ret resp end
_wire_close(w)
if not _resendable(method, resp): ret resp end
end
ret _WireResp { err = "the connection was closed twice in a row" }
end
func _pick(st: _EsState*): int:
n := st[0].nodes.len()
now := time.MonoMillis()
start := st[0].cursor % n
repeat n in k:
i := (start + k) % n
if st[0].dead_until.get(i) <= now:
st[0].cursor = (i + 1) % n
ret i
end
end
mut best := start
repeat n in k:
if st[0].dead_until.get(k) < st[0].dead_until.get(best): best = k end
end
st[0].cursor = (best + 1) % n
ret best
end
func _do(c: Client, method: str, path: str, body: str, ctype: str): Response:
if c.handle == null: ret Response { error = "no client" } end
st := _st(c)
if st[0].config_err.len() > 0:
r := Response { error = st[0].config_err }
_record(st, r)
ret r
end
n := st[0].nodes.len()
if n == 0:
r := Response { error = "no nodes configured" }
_record(st, r)
ret r
end
blen := str.ByteLen(body)
tries := st[0].max_retries + 1
mut last := Response {}
repeat tries in attempt:
ni := _pick(st)
node := st[0].nodes.get(ni)
head := _head(st, node, method, path, ctype, blen)
mut sent := _send_once(st, ni, node, method, head, body, blen)
mem.Free(head as void*)
if sent.err.len() > 0:
if str.StartsWith(sent.err, "could not connect") or str.StartsWith(sent.err, "TLS"):
st[0].dead_until.set(ni, time.MonoMillis() + DEAD_NODE_MS)
end
last = Response { error = node.url + ": " + sent.err }
if not _replay_ok(method, sent): break end
continue
end
st[0].dead_until.set(ni, 0 as i64)
mut r := Response { status = sent.status, ok = sent.status >= 200 and sent.status < 300 }
r.body = sent.body
_parse_error(r)
if _retryable(r.status) and attempt + 1 < tries:
last = r
continue
end
_record(st, r)
ret r
end
_record(st, last)
ret last
end
func _flavor(c: Client): str:
if c.handle == null: ret "" end
st := _st(c)
if st[0].flavor.len() == 0:
r := _do(c, "GET", "/", "", "application/json")
if r.ok:
d := json.GetPath(r.body, "version.distribution")
st[0].flavor = d.len() > 0 ? d : str.Clone("elasticsearch")
end
end
ret st[0].flavor
end
func _opensearch(c: Client): bool:
ret _flavor(c) == "opensearch"
end
func _seg(s: str): str:
ret encoding.URLEncode(s)
end
func _idx(s: str): str:
e := encoding.URLEncode(s)
ret str.Replace(str.Replace(str.Replace(e, "%2C", ","), "%2A", "*"), "%2a", "*")
end
func _qadd(q &: Vector<str>, key: str, val: str):
if val.len() == 0: ret end
q.push(key + "=" + encoding.URLEncode(val))
end
func _qs(q: Vector<str>): str:
if q.len() == 0: ret str.Clone("") end
ret "?" + str.Join(q, "&")
end
func _opts_query(q &: Vector<str>, o: Options):
_qadd(q, "refresh", o.refresh)
_qadd(q, "routing", o.routing)
_qadd(q, "pipeline", o.pipeline)
_qadd(q, "timeout", o.timeout)
_qadd(q, "wait_for_active_shards", o.wait_for_active_shards)
if o.if_seq_no >= 0: _qadd(q, "if_seq_no", conv.FormatInt(o.if_seq_no)) end
if o.if_primary_term >= 0: _qadd(q, "if_primary_term", conv.FormatInt(o.if_primary_term)) end
end
func _i64(raw: str): i64:
if raw.len() == 0 or raw == "null": ret 0 end
try:
ret conv.ParseInt(raw)
catch:
ret conv.ParseFloatOr(raw, 0.0) as i64
end
end
func _int(raw: str): int:
ret _i64(raw) as int
end
func _f64(raw: str): f64:
if raw.len() == 0 or raw == "null": ret 0.0 end
ret raw.to_float()
end
func _strs(items: Vector<str>): str:
mut quoted := Vector {} as Vector<str>
each it in items:
quoted.push(json.Str(it))
end
ret json.Array(quoted)
end
package elasticsearch
import mem
import str
import tls
import net.http
import net.internal.rawsock
const _WIRE_CHUNK := 65536
struct _Wire:
pub fd: i64 = -1
pub secure: bool = false
pub tc: tls.Conn = tls.Conn {}
pub open: bool = false
pub buf: void* = null
pub len: i64 = 0
pub cap: i64 = 0
pub pos: i64 = 0
pub uses: int = 0
pub timeout_ms: int = 0
end
struct _WireResp:
pub status: int = 0
pub body: str = ""
pub err: str = ""
pub stale: bool = false
pub sent: bool = false
pub quick: bool = false
end
func _wire_new(): _Wire*:
w := mem.AllocateZeroed(sizeof(_Wire) as u64) as _Wire*
w[0] = _Wire {}
ret w
end
func _wire_close(w: _Wire*):
if w[0].open:
if w[0].secure:
tls.Close(w[0].tc)
else:
rawsock.Close(rawsock.FromFd(w[0].fd))
end
end
w[0].open = false
w[0].fd = -1
w[0].len = 0
w[0].pos = 0
w[0].uses = 0
end
func _wire_free(w: _Wire*):
_wire_close(w)
if w[0].buf != null: mem.Free(w[0].buf) end
mem.Free(w as void*)
end
func _wire_connect(w: _Wire*, node: _Node, cfg: tls.Config, timeout_ms: int): str:
_wire_close(w)
sock := rawsock.Connect(node.ep.host, node.ep.port)
if not rawsock.Ok(sock):
ret "could not connect to " + node.ep.host + ":" + str.FromInt(node.ep.port as i64)
end
if timeout_ms > 0: rawsock.SetTimeout(sock, timeout_ms) end
rawsock.SetNoDelay(sock, true)
w[0].timeout_ms = timeout_ms
w[0].fd = sock.fd
w[0].secure = node.ep.secure
if node.ep.secure:
w[0].tc = tls.WrapClient(sock.fd, cfg)
if not tls.ConnOk(w[0].tc):
e := tls.ConnError(w[0].tc)
tls.Close(w[0].tc)
w[0].fd = -1
ret "TLS: " + e
end
end
w[0].open = true
ret ""
end
func _wire_write(w: _Wire*, p: void*, n: int): bool:
if n <= 0: ret true end
mut sent := 0
if w[0].secure:
sent = tls.WriteBytes(w[0].tc, p, n)
else:
sent = rawsock.SendBytes(rawsock.FromFd(w[0].fd), p, n)
end
ret sent == n
end
func _wire_fill(w: _Wire*): bool:
if w[0].pos > 0:
rest := w[0].len - w[0].pos
if rest > 0:
mem.MemMove(w[0].buf, (w[0].buf as i64 + w[0].pos) as void*, rest as u64)
end
w[0].len = rest
w[0].pos = 0
end
if w[0].cap - w[0].len < 4096:
mut ncap := w[0].cap * 2
if ncap < _WIRE_CHUNK: ncap = _WIRE_CHUNK end
nb := mem.Allocate(ncap as u64)
if nb == null: ret false end
if w[0].len > 0: mem.Copy(nb, w[0].buf, w[0].len as u64) end
if w[0].buf != null: mem.Free(w[0].buf) end
w[0].buf = nb
w[0].cap = ncap
end
dst := (w[0].buf as i64 + w[0].len) as void*
room := (w[0].cap - w[0].len) as int
mut n := 0
if w[0].secure:
n = tls.ReadBytes(w[0].tc, dst, room)
else:
n = rawsock.RecvBytes(rawsock.FromFd(w[0].fd), dst, room)
end
if n <= 0: ret false end
w[0].len += (n as i64)
ret true
end
func _wire_byte(w: _Wire*, i: i64): int:
p := (w[0].buf as i64 + w[0].pos + i) as u8*
ret p[0] as int
end
func _wire_avail(w: _Wire*): i64:
ret w[0].len - w[0].pos
end
func _wire_need(w: _Wire*, n: i64): bool:
until _wire_avail(w) < n:
if not _wire_fill(w): ret false end
end
ret true
end
func _wire_take(w: _Wire*, n: i64): str:
out := mem.Allocate((n + 1) as u64)
if n > 0: mem.Copy(out, (w[0].buf as i64 + w[0].pos) as void*, n as u64) end
op := out as u8*
op[n] = 0 as u8
w[0].pos += n
ret out as str
end
func _wire_find(w: _Wire*, from: i64, double: bool): i64:
avail := _wire_avail(w)
mut i := from
span := double ? 4 : 2
until i + span <= avail:
if _wire_byte(w, i) == 13 and _wire_byte(w, i + 1) == 10:
if not double: ret i end
if _wire_byte(w, i + 2) == 13 and _wire_byte(w, i + 3) == 10: ret i end
end
i++
end
ret -1
end
func _wire_line(w: _Wire*, line &: str): bool:
mut scanned := 0 as i64
until true:
at := _wire_find(w, scanned, false)
if at >= 0:
line = _wire_take(w, at)
w[0].pos += 2
ret true
end
scanned = _wire_avail(w) > 1 ? _wire_avail(w) - 1 : 0
if not _wire_fill(w): ret false end
end
end
func _hex_value(s: str): i64:
mut v := 0 as i64
mut seen := false
repeat s.len() in i:
c := s[i] as int
mut d := -1
switch true:
c >= 48 and c <= 57:
d = c - 48
break
end
c >= 97 and c <= 102:
d = c - 87
break
end
c >= 65 and c <= 70:
d = c - 55
end
end
if d < 0:
if seen: ret v end
if c == 32: continue end
ret -1
end
v = v * 16 + (d as i64)
seen = true
end
ret seen ? v : -1
end
func _wire_chunked(w: _Wire*, body &: str): bool:
mut sb := str.NewBuilder()
defer str.BufFree(sb)
until true:
mut line := ""
if not _wire_line(w, line): ret false end
size := _hex_value(line)
mem.Free(line as void*)
if size < 0: ret false end
if size == 0:
until true:
mut trailer := ""
if not _wire_line(w, trailer): ret false end
empty := trailer.len() == 0
mem.Free(trailer as void*)
if empty: break end
end
body = str.BufStr(sb)
ret true
end
if not _wire_need(w, size + 2): ret false end
part := _wire_take(w, size)
str.BufAppend(sb, part)
mem.Free(part as void*)
w[0].pos += 2
end
end
func _wire_roundtrip(w: _Wire*, method: str, head: str, body: str, blen: int): _WireResp:
reused := w[0].uses > 0
if not _wire_write(w, head as void*, str.ByteLen(head)) or not _wire_write(w, body as void*, blen):
ret _WireResp { err = "could not send the request", stale = reused }
end
waited := time.MonoMillis()
mut head_end := -1 as i64
until head_end < 0:
head_end = _wire_find(w, 0, true)
if head_end >= 0: break end
if not _wire_fill(w):
if _wire_avail(w) == 0:
mut fast := 2000
if w[0].timeout_ms > 0 and w[0].timeout_ms / 2 < fast: fast = w[0].timeout_ms / 2 end
quick := time.MonoMillis() - waited < (fast as i64)
ret _WireResp { err = "the server closed the connection", stale = reused, sent = true, quick = quick }
end
ret _WireResp { err = "the response head never ended", sent = true }
end
end
rhead := _wire_take(w, head_end + 4)
defer mem.Free(rhead as void*)
sp := rhead.find(" ")
status := sp >= 0 ? rhead.substr(sp + 1, 3).to_int() : 0
te := http.HeaderValue(rhead, "Transfer-Encoding").lower()
cl := http.HeaderValue(rhead, "Content-Length")
connection := http.HeaderValue(rhead, "Connection").lower()
mut close_after := connection == "close" or (str.StartsWith(rhead, "HTTP/1.0") and connection != "keep-alive")
mut out := _WireResp { status = status }
no_body := method == "HEAD" or status == 204 or status == 304 or (status >= 100 and status < 200)
switch true:
no_body:
out.body = str.Clone("")
break
end
str.Contains(te, "chunked"):
mut text := ""
if not _wire_chunked(w, text):
_wire_close(w)
ret _WireResp { err = "the chunked response body could not be decoded", sent = true }
end
out.body = text
break
end
cl.len() > 0:
n := cl.to_int() as i64
if not _wire_need(w, n):
_wire_close(w)
ret _WireResp { err = "the response body ended early", sent = true }
end
out.body = _wire_take(w, n)
break
end
else:
mut more := true
until more:
more = _wire_fill(w)
end
out.body = _wire_take(w, _wire_avail(w))
close_after = true
end
end
w[0].uses++
if close_after: _wire_close(w) end
ret out
end
