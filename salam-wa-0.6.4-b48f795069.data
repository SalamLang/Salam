ret s.to_float()
end
@en "IsNull"
@fa "خالی است"
pub func IsNull(res: Result, col: int): bool:
ret _cell(res, col) == 0
end
@en "Escape"
@fa "اسکیپ"
pub func Escape(db: Database, s: str): str:
if db.handle == null:
ret s
end
n := s.len()
buf := mem.Allocate(((n * 2) + 1) as u64)
if buf == null:
ret s
end
_my_real_escape_string(db.handle, buf, s, n as u64)
out := str.Clone(buf as str)
mem.Free(buf)
ret out
end
@en "QueryInt"
@fa "پرسمان عدد"
pub func QueryInt(db: Database, sql: str): int:
mut res := Query(db, sql)
mut out := 0
if Next(res):
out = Int(res, 0)
end
Finish(res)
ret out
end
@en "QueryText"
@fa "پرسمان متن"
pub func QueryText(db: Database, sql: str): str:
mut res := Query(db, sql)
mut out := ""
if Next(res):
out = Text(res, 0)
end
Finish(res)
ret out
end
@en "LibraryInit"
@fa "آماده سازی کتابخانه"
pub func LibraryInit(): bool:
ret _my_server_init(0, null, null) == 0
end
@en "LibraryEnd"
@fa "پایان کتابخانه"
pub func LibraryEnd():
_my_server_end()
end
@en "ThreadInit"
@fa "آماده سازی نخ"
pub func ThreadInit(): bool:
ret _my_thread_init()
end
@en "ThreadEnd"
@fa "پایان نخ"
pub func ThreadEnd():
_my_thread_end()
end
@en "Conn"
@fa "اتصال"
pub func Conn(d: Database): dyn db.Connection:
ret d
end
