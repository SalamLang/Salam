package css
import str
import math
const K_NUM := 0
const K_LEN := 1
const K_ANG := 2
const K_TIME := 3
mut g_intern := HashMap {} as HashMap<str, int>
mut g_intern_list := Vector {} as Vector<str>
struct Cx:
pub fs: f64 = 16.0
pub pfs: f64 = 16.0
pub pkw: f64 = 1.0
pub mono: bool = false
pub rfs: f64 = 16.0
pub vw: f64 = 1024.0
pub vh: f64 = 768.0
pub dark: bool = false
pub color: Color = Color {}
pub pcolor: Color = Color {}
pub rtl: bool = false
pub basis: f64 = -1.0
end
struct Lin:
pub kind: int = K_NUM
pub v: f64 = 0.0
pub pct: f64 = 0.0
pub has_pct: bool = false
pub nl: str = ""
pub ok: bool = true
end
func unit_value(n: f64, unit: int, cx: Cx, out &: f64, kind &: int): bool:
kind = K_LEN
switch unit:
KW_PX: out = n break end
KW_EM: out = n * cx.fs break end
KW_REM: out = n * cx.rfs break end
KW_EX, KW_CH: out = n * cx.fs * 0.5 break end
KW_CAP: out = n * cx.fs * 0.7 break end
KW_IC: out = n * cx.fs break end
KW_LH: out = n * cx.fs * 1.2 break end
KW_RLH: out = n * cx.rfs * 1.2 break end
KW_VW, KW_SVW, KW_LVW, KW_DVW, KW_VI, KW_SVI, KW_LVI, KW_DVI, KW_CQW, KW_CQI: out = n * cx.vw / 100.0 break end
KW_VH, KW_SVH, KW_LVH, KW_DVH, KW_VB, KW_SVB, KW_LVB, KW_DVB, KW_CQH, KW_CQB: out = n * cx.vh / 100.0 break end
KW_VMIN, KW_SVMIN, KW_LVMIN, KW_DVMIN, KW_CQMIN: out = n * math.Min(cx.vw, cx.vh) / 100.0 break end
KW_VMAX, KW_SVMAX, KW_LVMAX, KW_DVMAX, KW_CQMAX: out = n * math.Max(cx.vw, cx.vh) / 100.0 break end
KW_PT: out = n * 4.0 / 3.0 break end
KW_PC: out = n * 16.0 break end
KW_IN: out = n * 96.0 break end
KW_CM: out = n * 96.0 / 2.54 break end
KW_MM: out = n * 96.0 / 25.4 break end
KW_Q: out = n * 96.0 / 101.6 break end
KW_DEG:
kind = K_ANG
out = n
break
end
KW_RAD:
kind = K_ANG
out = n * 180.0 / math.PI
break
end
KW_GRAD:
kind = K_ANG
out = n * 0.9
break
end
KW_TURN:
kind = K_ANG
out = n * 360.0
break
end
KW_S:
kind = K_TIME
out = n * 1000.0
break
end
KW_MS:
kind = K_TIME
out = n
break
end
else:
ret false
end
end
ret true
end
func lin_bad(): Lin:
ret Lin { ok = false }
end
func lin_css(a: Lin): str:
if a.nl.len() > 0:
ret str.Clone(a.nl)
end
vs := fmt_num(a.v)
defer sfree(vs)
if a.kind != K_LEN or not a.has_pct:
if a.kind == K_LEN:
ret vs + "px"
end
if a.kind == K_ANG:
ret vs + "deg"
end
if a.kind == K_TIME:
ret vs + "ms"
end
ret str.Clone(vs)
end
ps := fmt_num(a.pct)
defer sfree(ps)
if a.v == 0.0:
ret ps + "%"
end
if a.v < 0.0:
nv := fmt_num(0.0 - a.v)
out := "calc(" + ps + "% - " + nv + "px)"
sfree(nv)
ret out
end
ret "calc(" + ps + "% + " + vs + "px)"
end
func lin_add(a: Lin, b: Lin, sub: bool): Lin:
if not a.ok or not b.ok:
ret lin_bad()
end
ka := a.kind
kb := b.kind
if ka != kb:
ret lin_bad()
end
if a.nl.len() > 0 or b.nl.len() > 0:
sa := lin_css(a)
sb := lin_css(b)
r := Lin { kind = ka, has_pct = true, nl = "calc(" + sa + (sub ? " - " : " + ") + sb + ")" }
sfree(sa)
sfree(sb)
ret r
end
sg := sub ? -1.0 : 1.0
ret Lin { kind = ka, v = a.v + sg * b.v, pct = a.pct + sg * b.pct, has_pct = a.has_pct or b.has_pct }
end
func lin_scale(a: Lin, k: f64): Lin:
if not a.ok:
ret a
end
if a.nl.len() > 0:
sa := lin_css(a)
ks := fmt_num(k)
r := Lin { kind = a.kind, has_pct = true, nl = "calc(" + sa + " * " + ks + ")" }
sfree(sa)
sfree(ks)
ret r
end
ret Lin { kind = a.kind, v = a.v * k, pct = a.pct * k, has_pct = a.has_pct }
end
func lin_minmax(args: Vector<Lin>, is_max: bool, fname: str): Lin:
if args.len() == 0:
ret lin_bad()
end
k := args[0].kind
mut linear := true
repeat args.len() in i:
a := args[i]
if not a.ok or a.kind != k:
ret lin_bad()
end
if a.has_pct or a.nl.len() > 0:
linear = false
end
end
if linear:
mut best := args[0].v
repeat args.len() in i:
v := args[i].v
if is_max and v > best:
best = v
end
if not is_max and v < best:
best = v
end
end
ret Lin { kind = k, v = best }
end
mut b := str.NewBuilder()
str.BufAppend(b, fname)
str.BufAppend(b, "(")
repeat args.len() in i:
if i > 0:
str.BufAppend(b, ", ")
end
sa := lin_css(args[i])
str.BufAppend(b, sa)
sfree(sa)
end
str.BufAppend(b, ")")
out := str.BufStr(b)
str.BufFree(b)
ret Lin { kind = k, has_pct = true, nl = out }
end
func lin_free(a: Lin):
if a.nl.len() > 0:
sfree(a.nl)
end
end
func calc_term(t: Vector<Tok>, i: int, e: int, cx: Cx): Lin:
if i >= e:
ret lin_bad()
end
tk := t[i]
if tk.k == TK_NUM:
ret Lin { kind = K_NUM, v = tk.n }
end
if tk.k == TK_PCT:
if cx.basis >= 0.0:
ret Lin { kind = K_LEN, v = tk.n * cx.basis / 100.0 }
end
ret Lin { kind = K_LEN, pct = tk.n, has_pct = true }
end
if tk.k == TK_DIM:
mut v := 0.0
mut k := K_LEN
if not unit_value(tk.n, tk.id, cx, v, k):
ret lin_bad()
end
ret Lin { kind = k, v = v }
end
if tk.k == TK_IDENT:
switch tk.s:
"pi": ret Lin { kind = K_NUM, v = math.PI } end
"e": ret Lin { kind = K_NUM, v = math.E } end
"infinity": ret Lin { kind = K_NUM, v = 1.0e300 } end
"-infinity": ret Lin { kind = K_NUM, v = -1.0e300 } end
else: ret lin_bad() end
end
end
if tk.k == TK_FUNC:
ret calc_fn(t, i, cx)
end
ret lin_bad()
end
func calc_product(t: Vector<Tok>, s: int, e: int, cx: Cx): Lin:
mut acc := calc_term(t, s, e, cx)
mut i := nxt(t, s)
until i < e and acc.ok:
if t[i].k != TK_DELIM or (t[i].d != 42 and t[i].d != 47):
lin_free(acc)
ret lin_bad()
end
op := t[i].d
if i + 1 >= e:
lin_free(acc)
ret lin_bad()
end
rhs := calc_term(t, i + 1, e, cx)
if not rhs.ok:
lin_free(acc)
ret lin_bad()
end
if op == 42:
if rhs.kind == K_NUM and rhs.nl.len() == 0:
old := acc
acc = lin_scale(acc, rhs.v)
lin_free(old)
else acc.kind == K_NUM and acc.nl.len() == 0:
k := acc.v
acc = lin_scale(rhs, k)
lin_free(rhs)
else:
lin_free(acc)
lin_free(rhs)
ret lin_bad()
end
else:
if rhs.kind != K_NUM or rhs.nl.len() > 0 or rhs.v == 0.0:
lin_free(acc)
lin_free(rhs)
ret lin_bad()
end
old := acc
acc = lin_scale(acc, 1.0 / rhs.v)
lin_free(old)
end
i = nxt(t, i + 1)
end
ret acc
end
func is_addop(t: Vector<Tok>, j: int): bool:
ret t[j].k == TK_DELIM and (t[j].d == 43 or t[j].d == 45)
end
func calc_sum(t: Vector<Tok>, s: int, e: int, cx: Cx): Lin:
if s >= e:
ret lin_bad()
end
mut j := s
until j < e and not is_addop(t, j):
j = nxt(t, j)
end
mut acc := calc_product(t, s, j, cx)
until j < e and acc.ok:
sub := t[j].d == 45
start := j + 1
mut k := start
until k < e and not is_addop(t, k):
k = nxt(t, k)
end
rhs := calc_product(t, start, k, cx)
old := acc
acc = lin_add(acc, rhs, sub)
lin_free(old)
lin_free(rhs)
j = k
end
ret acc
end
func calc_fn(t: Vector<Tok>, i: int, cx: Cx): Lin:
f := t[i]
s := i + 1
e := f.close
if e < 0:
ret lin_bad()
end
switch f.s:
"calc", "", "-webkit-calc":
ret calc_sum(t, s, e, cx)
end
"min", "max", "clamp":
mut parts := Vector {} as Vector<int>
defer parts.free()
split_commas(t, s, e, parts)
mut args := Vector {} as Vector<Lin>
defer args.free()
mut k := 0
until k + 1 < parts.len():
args.push(calc_sum(t, parts[k], parts[k + 1], cx))
k += 2
end
mut r := lin_bad()
if f.s == "clamp":
if args.len() == 3:
mut inner := Vector {} as Vector<Lin>
inner.push(args[1])
inner.push(args[2])
mn := lin_minmax(inner, false, "min")
inner.free()
mut outer := Vector {} as Vector<Lin>
outer.push(args[0])
outer.push(mn)
r = lin_minmax(outer, true, "max")
outer.free()
lin_free(mn)
end
else:
r = lin_minmax(args, f.s == "max", f.s)
end
repeat args.len() in a:
lin_free(args[a])
end
ret r
end
"abs", "sign":
a := calc_sum(t, s, e, cx)
if not a.ok or a.has_pct or a.nl.len() > 0:
lin_free(a)
ret lin_bad()
end
if f.s == "abs":
ret Lin { kind = a.kind, v = math.Abs(a.v) }
end
ret Lin { kind = K_NUM, v = a.v > 0.0 ? 1.0 : (a.v < 0.0 ? -1.0 : 0.0) }
end
"round", "mod", "rem":
mut parts := Vector {} as Vector<int>
defer parts.free()
split_commas(t, s, e, parts)
mut ps := 0
mut strategy := "nearest"
if parts.len() >= 2 and t[parts[0]].k == TK_IDENT and nxt(t, parts[0]) == parts[1] and f.s == "round":
strategy = t[parts[0]].s
ps = 2
end
if parts.len() - ps != 4:
ret lin_bad()
end
a := calc_sum(t, parts[ps], parts[ps + 1], cx)
b := calc_sum(t, parts[ps + 2], parts[ps + 3], cx)
if not a.ok or not b.ok or a.has_pct or b.has_pct or a.nl.len() > 0 or b.nl.len() > 0 or a.kind != b.kind or b.v == 0.0:
lin_free(a)
lin_free(b)
ret lin_bad()
end
q := a.v / b.v
mut r := 0.0
if f.s == "round":
switch strategy:
"up": r = math.Ceil(q) * b.v break end
"down": r = math.Floor(q) * b.v break end
"to-zero": r = (q < 0.0 ? math.Ceil(q) : math.Floor(q)) * b.v break end
else: r = math.Floor(q + 0.5) * b.v end
end
else f.s == "mod":
r = a.v - math.Floor(q) * b.v
else:
r = a.v - (q < 0.0 ? math.Ceil(q) : math.Floor(q)) * b.v
end
ret Lin { kind = a.kind, v = r }
end
else:
ret lin_bad()
end
end
ret lin_bad()
end
func is_math_fn(name: str): bool:
switch name:
"calc", "min", "max", "clamp", "abs", "sign", "round", "mod", "rem", "-webkit-calc":
ret true
end
else:
ret false
end
end
ret false
end
func lin_to_len(a: Lin, out &: Len):
if a.nl.len() > 0:
out = Len { kind = LenKind.Length, has_pct = true, calc = intern_own(a.nl) }
ret
end
out = Len { kind = LenKind.Length, px = a.v, pct = a.pct, has_pct = a.has_pct }
end
func p_len(t: Vector<Tok>, i: int, e: int, cx: Cx, allow_pct: bool, allow_neg: bool, out &: Len): bool:
if i >= e:
ret false
end
tk := t[i]
if tk.k == TK_NUM:
if tk.n == 0.0:
out = Len {}
ret true
end
ret false
end
if tk.k == TK_DIM:
mut v := 0.0
mut k := K_LEN
if not unit_value(tk.n, tk.id, cx, v, k) or k != K_LEN:
ret false
end
if v < 0.0 and not allow_neg:
ret false
end
out = Len { px = v }
ret true
end
if tk.k == TK_PCT:
if not allow_pct or (tk.n < 0.0 and not allow_neg):
ret false
end
if cx.basis >= 0.0:
out = Len { px = tk.n * cx.basis / 100.0 }
else:
out = Len { pct = tk.n, has_pct = true }
end
ret true
end
if tk.k == TK_FUNC and is_math_fn(tk.s):
a := calc_fn(t, i, cx)
if not a.ok or (a.kind != K_LEN and not (a.kind == K_NUM and a.v == 0.0 and a.nl.len() == 0)):
lin_free(a)
ret false
end
if a.has_pct and not allow_pct:
lin_free(a)
ret false
end
if a.nl.len() == 0 and not allow_neg and not a.has_pct and a.v < 0.0:
out = Len {}
ret true
end
lin_to_len(a, out)
ret true
end
ret false
end
func p_num(t: Vector<Tok>, i: int, e: int, cx: Cx, out &: f64): bool:
if i >= e:
ret false
end
tk := t[i]
if tk.k == TK_NUM:
out = tk.n
ret true
end
if tk.k == TK_FUNC and is_math_fn(tk.s):
a := calc_fn(t, i, cx)
if not a.ok or a.kind != K_NUM or a.nl.len() > 0:
lin_free(a)
ret false
end
out = a.v
ret true
end
ret false
end
func p_num_or_pct(t: Vector<Tok>, i: int, e: int, cx: Cx, out &: f64): bool:
if i < e and t[i].k == TK_PCT:
out = t[i].n / 100.0
ret true
end
ret p_num(t, i, e, cx, out)
end
func p_angle(t: Vector<Tok>, i: int, e: int, cx: Cx, allow_zero: bool, out &: f64): bool:
if i >= e:
ret false
end
tk := t[i]
if tk.k == TK_NUM:
if allow_zero and tk.n == 0.0:
out = 0.0
ret true
end
ret false
end
if tk.k == TK_DIM:
mut v := 0.0
mut k := K_LEN
if unit_value(tk.n, tk.id, cx, v, k) and k == K_ANG:
out = v
ret true
end
ret false
end
if tk.k == TK_FUNC and is_math_fn(tk.s):
a := calc_fn(t, i, cx)
if a.ok and a.kind == K_ANG and a.nl.len() == 0:
out = a.v
ret true
end
lin_free(a)
end
ret false
end
func p_time(t: Vector<Tok>, i: int, e: int, cx: Cx, out &: f64): bool:
if i >= e:
ret false
end
tk := t[i]
if tk.k == TK_DIM:
mut v := 0.0
mut k := K_LEN
if unit_value(tk.n, tk.id, cx, v, k) and k == K_TIME:
out = v
ret true
end
ret false
end
if tk.k == TK_FUNC and is_math_fn(tk.s):
a := calc_fn(t, i, cx)
if a.ok and a.kind == K_TIME and a.nl.len() == 0:
out = a.v
ret true
end
lin_free(a)
end
ret false
end
func p_int(t: Vector<Tok>, i: int, e: int, cx: Cx, out &: int): bool:
mut v := 0.0
if not p_num(t, i, e, cx, v):
ret false
end
if t[i].k == TK_NUM and not t[i].int_like:
ret false
end
out = math.Floor(v + 0.5) as int
ret true
end
func single(t: Vector<Tok>, s: int, e: int): bool:
ret s < e and nxt(t, s) == e
end
func kw_at(t: Vector<Tok>, s: int, e: int): str:
if single(t, s, e) and t[s].k == TK_IDENT:
ret t[s].s
end
ret ""
end
func ident_at(t: Vector<Tok>, s: int, e: int): bool:
ret single(t, s, e) and t[s].k == TK_IDENT
end
func kw_id_at(t: Vector<Tok>, s: int, e: int): int:
if single(t, s, e) and t[s].k == TK_IDENT:
ret t[s].id
end
ret -1
end
func resolve_len(l: Len, basis: f64, cx: Cx): f64:
if l.kind != LenKind.Length:
ret 0.0
end
if l.calc.len() > 0:
mut toks := Vector {} as Vector<Tok>
tokenize(l.calc, toks)
mut c2 := cx
c2.basis = basis
mut r := 0.0
if toks.len() > 0:
a := calc_term(toks, 0, toks.len(), c2)
if a.ok:
r = a.v
end
lin_free(a)
end
free_toks(toks, 0)
toks.free()
ret r
end
if l.has_pct:
ret l.px + l.pct * basis / 100.0
end
ret l.px
end
func len_text(l: Len): str:
switch l.kind:
LenKind.Auto: ret str.Clone("auto") end
LenKind.None: ret str.Clone("none") end
LenKind.Normal: ret str.Clone("normal") end
LenKind.MinContent: ret str.Clone("min-content") end
LenKind.MaxContent: ret str.Clone("max-content") end
LenKind.FitContent: ret str.Clone("fit-content") end
LenKind.Content: ret str.Clone("content") end
LenKind.Number: ret fmt_sig(l.px) end
else:
if l.calc.len() > 0:
ret str.Clone(l.calc)
end
ret lin_css(Lin { kind = K_LEN, v = l.px, pct = l.pct, has_pct = l.has_pct })
end
end
ret str.Clone("")
end
func intern(s: str): str:
if s.len() == 0:
ret ""
end
if g_intern.has(s):
ret g_intern_list[g_intern.get(s)]
end
c := str.Clone(s)
g_intern_list.push(c)
g_intern.put(c, g_intern_list.len() - 1)
ret c
end
func intern_own(s: str): str:
r := intern(s)
sfree(s)
ret r
end
package cssbox
struct BItem:
pub id: int = 0
pub same_bfc: bool = false
pub oof: bool = false
pub fit: bool = false
pub w: f64 = NO
pub h: f64 = NO
pub minw: f64 = NO
pub minh: f64 = NO
pub maxw: f64 = NO
pub maxh: f64 = NO
pub pad: R4 = R4 {}
pub bor: R4 = R4 {}
pub pbw: f64 = 0.0
pub pbh: f64 = 0.0
pub spx: f64 = 0.0
pub spy: f64 = 0.0
pub can_collapse: bool = false
pub has_final: bool = false
pub fx: f64 = 0.0
pub fy: f64 = 0.0
pub fw: f64 = 0.0
pub fh: f64 = 0.0
pub fm: R4 = R4 {}
end
struct BRes:
pub content_h: f64 = 0.0
pub ftpos: f64 = 0.0
pub ftneg: f64 = 0.0
pub lbpos: f64 = 0.0
pub lbneg: f64 = 0.0
pub baseline: f64 = NO
end
func _ms_collapse_pos(p: f64, m: f64): f64:
if m >= 0.0 and m > p:
ret m
end
ret p
end
func _ms_collapse_neg(ng: f64, m: f64): f64:
if m < 0.0 and m < ng:
ret m
end
ret ng
end
func _block_items(t &: Engine, kids: Vector<int>, inner_w: f64, inner_h: f64): Vector<BItem>:
mut items := Vector {} as Vector<BItem>
each c in kids:
n := t.nodes.ref(c)
st := n.style
if st.display == Display.None:
continue
end
pad := _r4(st.padding, inner_w)
bor := _r4(st.border, inner_w)
pbw := pad.l + pad.r + bor.l + bor.r
pbh := pad.t + pad.b + bor.t + bor.b
adjw := st.box_sizing == BoxSizing.ContentBox ? pbw : 0.0
adjh := st.box_sizing == BoxSizing.ContentBox ? pbh : 0.0
ratio := st.aspect_ratio
w0 := _res(st.width, inner_w)
h0 := _res(st.height, inner_h)
mnw0 := _res(st.min_width, inner_w)
mnh0 := _res(st.min_height, inner_h)
mxw0 := _res(st.max_width, inner_w)
mxh0 := _res(st.max_height, inner_h)
is_scroll := _scroller(st.overflow_x) or _scroller(st.overflow_y)
oof := _oof(st.position)
same := st.display == Display.Block and not oof and not is_scroll and st.align_content == Align.Normal
fit := st.display == Display.InlineBlock or st.display == Display.InlineFlex or st.display == Display.InlineGrid or st.display == Display.InlineTable or st.display == Display.Table
items.push(BItem { id = c, same_bfc = same, oof = oof, fit = fit, w = _add(_arw(w0, h0, ratio), adjw), h = _add(_arh(w0, h0, ratio), adjh), minw = _add(_arw(mnw0, mnh0, ratio), adjw), minh = _add(_arh(mnw0, mnh0, ratio), adjh), maxw = _add(_arw(mxw0, mxh0, ratio), adjw), maxh = _add(_arh(mxw0, mxh0, ratio), adjh), pad = pad, bor = bor, pbw = pbw, pbh = pbh })
end
ret items
end
func _block_content_width(t &: Engine, items: Vector<BItem>, avw: f64): f64:
mut maxw := 0.0
each it in items:
if it.oof:
continue
end
n := t.nodes.ref(it.id)
kw := _clamp(it.w, it.minw, it.maxw)
kh := _clamp(it.h, it.minh, it.maxh)
mar := _r4(n.style.margin, _avopt(avw))
mx := mar.l + mar.r
mut w := kw
if not _is(w):
wk := n.style.width.kind
mut iaw := _avsub(avw, mx)
switch wk:
LengthKind.MinContent:
iaw = MINC
break
end
LengthKind.MaxContent:
iaw = MAXC
break
end
else:
end
end
o := _layout(t, it.id, Inp { kw = kw, kh = kh, aw = iaw, ah = MINC, inherent = true, axis = 0, cstart = it.same_bfc, cend = it.same_bfc })
w = o.w
end
w2 := _fmax(w, it.pbw) + mx
maxw = _fmax(maxw, w2)
end
ret maxw
end
func _block_known(t &: Engine, it: BItem, stretch_w: f64, pct_h: f64, nmar: R4, adjoin_s: bool, adjoin_e: bool, pw: f64, ph: f64): Inp:
n := t.nodes.ref(it.id)
mut wk := n.style.width.kind
if it.fit and wk == LengthKind.Auto:
wk = LengthKind.FitContent
end
mut kwd := NO
switch wk:
LengthKind.MinContent:
kwd = _layout(t, it.id, Inp { pw = pw, ph = ph, aw = MINC, ah = MAXC, inherent = true, axis = 0, cstart = it.same_bfc, cend = it.same_bfc }).w
break
end
LengthKind.MaxContent:
kwd = _layout(t, it.id, Inp { pw = pw, ph = ph, aw = MAXC, ah = MAXC, inherent = true, axis = 0, cstart = it.same_bfc, cend = it.same_bfc }).w
break
end
LengthKind.FitContent:
kwd = _layout(t, it.id, Inp { pw = pw, ph = ph, aw = stretch_w, ah = MAXC, inherent = true, axis = 0, cstart = it.same_bfc, cend = it.same_bfc }).w
break
end
LengthKind.Stretch:
kwd = stretch_w
break
end
else:
end
end
mut kh := NO
if n.style.height.kind == LengthKind.Stretch and _is(pct_h):
mut hh := pct_h
if not adjoin_s:
hh -= nmar.t
end
if not adjoin_e:
hh -= nmar.b
end
kh = hh
end
mut w := _is(it.w) ? it.w : (_is(kwd) ? kwd : stretch_w)
w = _clampf(w, it.minw, it.maxw)
mut h := _is(it.h) ? it.h : kh
h = _clamp(h, it.minh, it.maxh)
ret Inp { kw = w, kh = h }
end
func _block_children(t &: Engine, items &: Vector<BItem>, perform: bool, outer_w: f64, pct_h_in: f64, rcbi: R4, dir_rtl: bool, own_s: bool, own_e: bool, adjoin_s: bool, adjoin_e: bool): BRes:
inner_w := _fmax(outer_w - rcbi.l - rcbi.r, 0.0)
pct_h := _sub(pct_h_in, rcbi.t + rcbi.b)
mut committed := rcbi.t
mut y_abs := rcbi.t
mut ftpos := 0.0
mut ftneg := 0.0
mut apos := 0.0
mut aneg := 0.0
mut collapsing_first := true
mut first_base := NO
repeat items.len() in i:
mut it := items.get(i)
if it.oof:
it.spx = dir_rtl ? outer_w - rcbi.r : rcbi.l
it.spy = y_abs
items.set(i, it)
continue
end
n := t.nodes.ref(it.id)
st_margin := n.style.margin
im := _r4opt(st_margin, inner_w)
nmar := R4 { t = _or(im.t, 0.0), r = _or(im.r, 0.0), b = _or(im.b, 0.0), l = _or(im.l, 0.0) }
nmx := nmar.l + nmar.r
mut ymo := 0.0
stretch_w := _fmax(inner_w - nmx, 0.0)
if not it.same_bfc:
if not collapsing_first or not own_s:
ymo = _fmax(apos, _fmax(nmar.t, 0.0)) + _fmin(aneg, _fmin(nmar.t, 0.0))
end
end
kd := _block_known(t, it, stretch_w, pct_h, nmar, adjoin_s, adjoin_e, inner_w, pct_h)
o := _layout(t, it.id, Inp { kw = kd.kw, kh = kd.kh, pw = inner_w, ph = pct_h, aw = stretch_w, ah = MAXC, inherent = true, axis = 2, perform = perform, cstart = it.same_bfc, cend = it.same_bfc })
tm := _or(im.t, 0.0)
bm := _or(im.b, 0.0)
ttpos := _ms_collapse_pos(o.top_pos, tm)
ttneg := _ms_collapse_neg(o.top_neg, tm)
bbpos := _ms_collapse_pos(o.bot_pos, bm)
bbneg := _ms_collapse_neg(o.bot_neg, bm)
free_x := _fmax(0.0, stretch_w - o.w)
mut autos := 0
if not _is(im.l):
autos++
end
if not _is(im.r):
autos++
end
auto_m := autos > 0 ? free_x / (autos as f64) : 0.0
rm := R4 { l = _or(im.l, auto_m), r = _or(im.r, auto_m), t = tm, b = bm }
mut insx := 0.0
mut insy := 0.0
if _isrel(n.style.position):
ins := _r4opt(n.style.inset, inner_w)
insh := _r4opt(n.style.inset, pct_h)
if dir_rtl:
insx = _is(ins.r) ? 0.0 - ins.r : _or(ins.l, 0.0)
else:
insx = _is(ins.l) ? ins.l : (_is(ins.r) ? 0.0 - ins.r : 0.0)
end
insy = _is(insh.t) ? insh.t : (_is(insh.b) ? 0.0 - insh.b : 0.0)
end
if it.same_bfc and (not collapsing_first or not own_s):
ymo = _fmax(apos, ttpos) + _fmin(aneg, ttneg)
end
it.can_collapse = o.collapse
mut lx := 0.0
if it.same_bfc:
if dir_rtl:
lx = outer_w - rcbi.r - o.w - rm.r + insx
else:
lx = rcbi.l + insx + rm.l
end
else:
if dir_rtl:
lx = rcbi.l + inner_w - o.w - rm.r + insx
else:
lx = rcbi.l + rm.l + insx
end
end
ly := committed + ymo + insy
has_auto_x := not _is(im.l) or not _is(im.r)
item_outer_w := o.w + rm.l + rm.r
if it.fit and not has_auto_x:
fx := inner_w - item_outer_w
off := dir_rtl ? fx : 0.0
lx = rcbi.l + rm.l + insx + off
end
if not _is(first_base):
cb := _child_baseline(o.baseline, o.h, n.style.overflow_y)
if _is(cb):
first_base = ly - insy + cb
end
end
it.has_final = true
it.fx = lx
it.fy = ly
it.fw = o.w
it.fh = o.h
it.fm = rm
if collapsing_first:
if it.can_collapse:
ftpos = _fmax(_fmax(ftpos, ttpos), bbpos)
ftneg = _fmin(_fmin(ftneg, ttneg), bbneg)
else:
ftpos = _fmax(ftpos, ttpos)
ftneg = _fmin(ftneg, ttneg)
collapsing_first = false
end
end
if it.can_collapse:
apos = _fmax(_fmax(apos, ttpos), bbpos)
aneg = _fmin(_fmin(aneg, ttneg), bbneg)
y_abs = committed + o.h + ymo
else:
committed = ly - insy + o.h
apos = bbpos
aneg = bbneg
y_abs = committed + apos + aneg
end
items.set(i, it)
end
mut bottom_off := 0.0
if own_e or (collapsing_first and own_s):
bottom_off = 0.0
else:
bottom_off = apos + aneg
end
committed += rcbi.b + bottom_off
ret BRes { content_h = _fmax(0.0, committed), ftpos = ftpos, ftneg = ftneg, lbpos = apos, lbneg = aneg, baseline = first_base }
end
func _block(t &: Engine, id: int, inp_in: Inp): Out:
n := t.nodes.ref(id)
st := n.style
is_scroll := _scroller(st.overflow_x) or _scroll_y(st)
new_bfc := is_scroll or st.align_content != Align.Normal or st.display == Display.FlowRoot or st.display == Display.InlineBlock or st.display == Display.TableCell or st.display == Display.TableCaption
ratio := st.aspect_ratio
pad0 := _r4(st.padding, inp_in.pw)
bor0 := _r4(st.border, inp_in.pw)
pbw := pad0.l + pad0.r + bor0.l + bor0.r
pbh := pad0.t + pad0.b + bor0.t + bor0.b
adjw := st.box_sizing == BoxSizing.ContentBox ? pbw : 0.0
adjh := st.box_sizing == BoxSizing.ContentBox ? pbh : 0.0
mnw0 := _res(st.min_width, inp_in.pw)
mnh0 := _res(st.min_height, inp_in.ph)
mxw0 := _res(st.max_width, inp_in.pw)
mxh0 := _res(st.max_height, inp_in.ph)
minw := _add(_arw(mnw0, mnh0, ratio), adjw)
minh := _add(_arh(mnw0, mnh0, ratio), adjh)
maxw := _add(_arw(mxw0, mxh0, ratio), adjw)
maxh := _add(_arh(mxw0, mxh0, ratio), adjh)
mut csw := NO
mut csh := NO
if inp_in.inherent:
sw0 := _res(st.width, inp_in.pw)
sh0 := _res(st.height, inp_in.ph)
csw = _clamp(_add(_arw(sw0, sh0, ratio), adjw), minw, maxw)
csh = _clamp(_add(_arh(sw0, sh0, ratio), adjh), minh, maxh)
end
mmw := (_is(minw) and _is(maxw) and maxw <= minw) ? minw : NO
mmh := (_is(minh) and _is(maxh) and maxh <= minh) ? minh : NO
kw0 := _mmax(_or(_or(inp_in.kw, mmw), csw), pbw)
kh0 := _mmax(_or(_or(inp_in.kh, mmh), csh), pbh)
if not inp_in.perform:
if _is(kw0) and _is(kh0):
ret Out { w = kw0, h = kh0 }
end
if inp_in.axis == 0 and _is(kw0):
ret Out { w = kw0, h = 0.0 }
end
end
mut inp := inp_in
inp.kw = kw0
inp.kh = kh0
in_bfc := inp.cstart or inp.cend
ret _block_inner(t, id, inp, in_bfc and not new_bfc, new_bfc)
end
func _scroll_y(st: Style): bool:
ret _scroller(st.overflow_y)
end
func _block_inner(t &: Engine, id: int, inp: Inp, in_parent_bfc: bool, new_bfc: bool): Out:
n := t.nodes.ref(id)
st := n.style
ratio := st.aspect_ratio
pad := _r4(st.padding, inp.pw)
bor := _r4(st.border, inp.pw)
rtl := st.direction == Direction.Rtl
sgx := st.overflow_y == Overflow.Scroll ? st.scrollbar_width : 0.0
sgy := st.overflow_x == Overflow.Scroll ? st.scrollbar_width : 0.0
sg := R4 { t = 0.0, l = rtl ? sgx : 0.0, r = rtl ? 0.0 : sgx, b = sgy }
pbw := pad.l + pad.r + bor.l + bor.r
pbh := pad.t + pad.b + bor.t + bor.b
cbi := _r4add(_r4add(pad, bor), sg)
adjw := st.box_sizing == BoxSizing.ContentBox ? pbw : 0.0
adjh := st.box_sizing == BoxSizing.ContentBox ? pbh : 0.0
sw0 := _res(st.width, inp.pw)
sh0 := _res(st.height, inp.ph)
size_h := _add(_arh(sw0, sh0, ratio), adjh)
mnw0 := _res(st.min_width, inp.pw)
mnh0 := _res(st.min_height, inp.ph)
mxw0 := _res(st.max_width, inp.pw)
mxh0 := _res(st.max_height, inp.ph)
minw := _add(_arw(mnw0, mnh0, ratio), adjw)
minh := _add(_arh(mnw0, mnh0, ratio), adjh)
maxw := _add(_arw(mxw0, mxh0, ratio), adjw)
maxh := _add(_arh(mxw0, mxh0, ratio), adjh)
dw := _clamp(_arw(inp.kw, inp.kh, ratio), minw, maxw)
dh := _clamp(_arh(inp.kw, inp.kh, ratio), minh, maxh)
kw := _or(inp.kw, dw)
kh := _or(inp.kh, dh)
pbd_h := inp.kh_def ? kh : NO
ccw := _sub(kw, cbi.l + cbi.r)
cch := _sub(pbd_h, cbi.t + cbi.b)
oof_self := _oof(st.position)
adj_s := inp.cstart and not new_bfc and not oof_self and pad.t == 0.0 and bor.t == 0.0
adj_e := inp.cend and not new_bfc and not oof_self and pad.b == 0.0 and bor.b == 0.0
own_s := adj_s
own_e := adj_e and not _is(size_h)
prevent := st.display != Display.Block or not in_parent_bfc or new_bfc or oof_self or pad.t > 0.0 or pad.b > 0.0 or bor.t > 0.0 or bor.b > 0.0
align_c := st.align_content
kids := _kids(t, id)
defer kids.free()
mut items := _block_items(t, kids, ccw, cch)
defer items.free()
mut outer_w := kw
if not _is(outer_w):
avw := _avsub(inp.aw, cbi.l + cbi.r)
iw := _block_content_width(t, items, avw) + cbi.l + cbi.r
outer_w = _fmax(_clampf(iw, minw, maxw), pbw)
end
if not inp.perform and _is(kh):
ret Out { w = outer_w, h = kh }
end
if not inp.perform and inp.axis == 0:
ret Out { w = outer_w, h = 0.0 }
end
mut pct_h := pbd_h
if not _is(pct_h) and inp.inherent:
pct_h = _mmax(size_h, minh)
end
prw := _or(inp.pw, outer_w)
rpad := _r4(st.padding, prw)
rbor := _r4(st.border, prw)
rcbi := _r4add(_r4add(rpad, rbor), sg)
res := _block_children(t, items, inp.perform, outer_w, pct_h, rcbi, rtl, own_s, own_e, adj_s, adj_e)
mut outer_h := kh
if not _is(outer_h):
outer_h = _clampf(res.content_h, minh, maxh)
end
outer_h = _fmax(outer_h, pbh)
constrained := _is(minh) and minh > 0.0 and minh >= outer_h
own_bottom := own_e and not constrained
mut first_base := res.baseline
if align_c != Align.Normal:
inner_h := outer_h - rcbi.t - rcbi.b
flow_h := res.content_h - rcbi.t - rcbi.b
free := inner_h - flow_h
off := _block_align_offset(align_c, free)
if _is(first_base):
first_base += off
end
repeat items.len() in i:
mut it := items.get(i)
if it.has_final:
it.fy += off
end
if it.oof:
it.spy += off
end
items.set(i, it)
end
end
mut all_collapse := true
each it in items:
if not it.oof and not it.can_collapse:
all_collapse = false
end
end
mut o := Out { w = outer_w, h = outer_h, baseline = first_base }
o.collapse = not prevent and outer_h == 0.0 and all_collapse
if own_s:
o.top_pos = res.ftpos
o.top_neg = res.ftneg
else:
mt := _res0(st.margin.top, inp.pw)
o.top_pos = _fmax(mt, 0.0)
o.top_neg = _fmin(mt, 0.0)
end
if own_bottom:
o.bot_pos = res.lbpos
o.bot_neg = res.lbneg
else:
mb := _res0(st.margin.bottom, inp.pw)
o.bot_pos = _fmax(mb, 0.0)
o.bot_neg = _fmin(mb, 0.0)
end
if not inp.perform:
ret o
end
each it in items:
c := t.nodes.ref(it.id)
if it.has_final:
_set_layout(t, it.id, it.fx, it.fy, it.fw, it.fh, it.pad, it.bor, it.fm)
end
if it.oof:
c.spx_s = rcbi.l
c.spx_e = outer_w - rcbi.r
c.spx_a = rtl ? 1 : 0
c.spy_s = it.spy
c.spy_e = it.spy
c.spy_a = 0
end
end
_hide_display_none(t, kids)
ret o
end
func _block_align_offset(a: Align, free: f64): f64:
k := _content_fallback(a, free, 1)
ret _content_offset(free, 1, 0.0, k, false, true)
end
@en "cssbox"
@fa "جعبه سی اس اس"
package cssbox
const NO := -1.0e300
const BIG := 1.0e300
const MINC := -3.0e300
const MAXC := 3.0e300
struct Inp:
pub kw: f64 = NO
pub kh: f64 = NO
pub kw_def: bool = true
pub kh_def: bool = true
pub pw: f64 = NO
pub ph: f64 = NO
pub aw: f64 = MAXC
pub ah: f64 = MAXC
pub inherent: bool = false
pub axis: int = 2
pub perform: bool = false
pub cstart: bool = false
pub cend: bool = false
end
struct Out:
pub w: f64 = 0.0
pub h: f64 = 0.0
pub baseline: f64 = NO
pub top_pos: f64 = 0.0
pub top_neg: f64 = 0.0
pub bot_pos: f64 = 0.0
pub bot_neg: f64 = 0.0
pub collapse: bool = false
end
struct R4:
pub t: f64 = 0.0
pub r: f64 = 0.0
pub b: f64 = 0.0
pub l: f64 = 0.0
end
struct CEdge:
pub w: f64 = 0.0
pub rank: int = 0
pub origin: int = -1
pub node: int = -1
pub side: int = 0
pub hidden: bool = false
end
struct TableEdges:
pub h: Vector<CEdge> = Vector {}
pub v: Vector<CEdge> = Vector {}
pub xs: Vector<f64> = Vector {}
pub ys: Vector<f64> = Vector {}
pub nr: int = 0
pub nc: int = 0
end
struct Node:
pub style: Style = Style {}
pub children: Vector<int> = Vector {}
pub parent: int = -1
pub has_measure: bool = false
pub measure: func (MeasureInput) MeasureOutput = (_mi: MeasureInput): ret MeasureOutput {} end
pub fin_ok: bool = false
pub fin_key: Inp = Inp {}
pub fin_out: Out = Out {}
pub ckeys: Vector<Inp> = Vector {}
pub couts: Vector<Out> = Vector {}
pub cnext: int = 0
pub lx: f64 = 0.0
pub ly: f64 = 0.0
pub lw: f64 = 0.0
pub lh: f64 = 0.0
pub pad: R4 = R4 {}
pub bor: R4 = R4 {}
pub mar: R4 = R4 {}
pub sbw: f64 = 0.0
pub sbh: f64 = 0.0
pub base: f64 = NO
pub spx_s: f64 = 0.0
pub spx_e: f64 = 0.0
pub spx_a: int = 0
pub spy_s: f64 = 0.0
pub spy_e: f64 = 0.0
pub spy_a: int = 0
pub ax: f64 = 0.0
pub ay: f64 = 0.0
pub ovr: f64 = 0.0
pub ovb: f64 = 0.0
pub ovl: f64 = 0.0
pub ovt: f64 = 0.0
pub cb: int = -1
pub cmw: f64 = 0.0
pub cmh: f64 = 0.0
pub fin: BoxLayout = BoxLayout {}
pub gd: GData = GData {}
pub gi: GInfo = GInfo {}
pub ubor: Sides = Sides {}
pub bov: bool = false
pub tb: TableEdges = TableEdges {}
end
@en "LengthKind"
@fa "نوع‌درازا"
pub enum LengthKind:
@en "Auto"
@fa "درازای خودکار"
Auto
@en "Px"
@fa "درازای پیکسلی"
Px
@en "Percent"
@fa "درازای درصدی"
Percent
@en "MinContent"
@fa "درازای کمینه محتوا"
MinContent
@en "MaxContent"
@fa "درازای بیشینه محتوا"
MaxContent
@en "FitContent"
@fa "درازای اندازه محتوا"
FitContent
@en "Stretch"
@fa "درازای کشیده"
Stretch
end
@en "Display"
@fa "نوع‌نمایش"
pub enum Display:
@en "Block"
@fa "بلوکی"
Block
@en "InlineBlock"
@fa "بلوکی درون خطی"
InlineBlock
@en "FlowRoot"
@fa "ریشه جریان"
FlowRoot
@en "Flex"
@fa "فلکس"
Flex
@en "InlineFlex"
@fa "فلکس درون خطی"
InlineFlex
@en "Contents"
@fa "فقط فرزندان"
Contents
@en "None"
@fa "بدون نمایش"
None
@en "Grid"
@fa "شبکه ای"
Grid
@en "InlineGrid"
@fa "شبکه درون خطی"
InlineGrid
@en "Table"
@fa "جدول"
Table
@en "InlineTable"
@fa "جدول درون خطی"
InlineTable
@en "TableRowGroup"
@fa "گروه سطر جدول"
TableRowGroup
@en "TableHeaderGroup"
@fa "گروه سرآیند جدول"
TableHeaderGroup
@en "TableFooterGroup"
@fa "گروه پاورقی جدول"
TableFooterGroup
@en "TableRow"
@fa "سطر جدول"
TableRow
@en "TableCell"
@fa "خانه جدول"
TableCell
@en "TableColumn"
@fa "ستون جدول"
TableColumn
@en "TableColumnGroup"
@fa "گروه ستون جدول"
TableColumnGroup
@en "TableCaption"
@fa "عنوان جدول"
TableCaption
end
@en "GridAutoFlow"
@fa "نوع‌جریان‌شبکه"
pub enum GridAutoFlow:
@en "Row"
@fa "جریان سطری"
Row
@en "Column"
@fa "جریان ستونی"
Column
@en "RowDense"
@fa "جریان سطری فشرده"
RowDense
@en "ColumnDense"
@fa "جریان ستونی فشرده"
ColumnDense
end
@en "TableLayout"
@fa "نوع‌چینش‌جدول"
pub enum TableLayout:
@en "Auto"
@fa "چینش خودکار جدول"
Auto
@en "Fixed"
@fa "چینش ثابت جدول"
Fixed
