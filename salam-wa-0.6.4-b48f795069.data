import mem
const _ZSF_DEFAULT_WINDOW := 1073741824
const _ZSF_CLAMP := 2147000000
struct _XxhS:
pub v1: u64
pub v2: u64
pub v3: u64
pub v4: u64
pub buf: u8*
pub bl: int
pub total: i64
