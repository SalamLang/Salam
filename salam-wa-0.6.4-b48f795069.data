end
end
if SALAM_WEBVIEW_CEF:
func _wv_is_cef(): bool:
ret true
end
end
if not SALAM_WEBVIEW_CEF:
func _wv_is_cef(): bool:
ret false
end
end
func _wv_touch():
_wv_touches++
end
func _wv_alive(id: int): bool:
if id < 0 or id >= _wv_hooks.len():
ret false
end
ret not _wv_hooks[id].closed
end
func _wv_register(): int:
_wv_hooks.push(
_Hooks {
on_message = (_text: str): ret end, on_navigate = (_url: str): ret true end, on_new_window = (_url: str): ret end,
on_close = (): ret true end, on_load = (_url: str, _done: bool): ret end, on_crash = (): ret end,
on_resize = (_w: int, _h: int): ret end, devtools_enabled = true, translate_enabled = true
}
)
_wv_open++
ret _wv_hooks.len() - 1
end
func _wv_mark_closed(id: int):
if _wv_alive(id):
_wv_hooks[id].closed = true
_wv_open--
_wv_bk_wake()
end
end
func _wv_enqueue(task: _Task):
sync.Lock(_wv_lock)
_wv_tasks.push(task)
sync.Unlock(_wv_lock)
_wv_bk_wake()
end
func _wv_drain():
sync.Lock(_wv_lock)
n := _wv_tasks.len()
if n == 0:
sync.Unlock(_wv_lock)
ret
end
mut batch := _wv_tasks
_wv_tasks = Vector {} as Vector<_Task>
sync.Unlock(_wv_lock)
repeat n in i:
t := batch[i]
if t.has_run:
t.run()
else _wv_alive(t.view):
_wv_bk_eval(t.view, t.js)
end
if t.js.len() > 0:
mem.Free(t.js as void*)
end
end
batch.free()
end
func _wv_tracing(): bool:
if not _wv_trace_read:
_wv_trace_path = os.Env("SALAM_WEBVIEW_TRACE")
_wv_trace_read = true
end
ret _wv_trace_path.len() > 0
end
func _wv_fire_message(id: int, text: str):
if _wv_tracing():
Trace("message, " + str.FromInt(text.len() as i64) + " bytes")
end
if _wv_alive(id):
_wv_hooks[id].on_message(text)
end
end
func _wv_fire_navigate(id: int, url: str): bool:
if _wv_tracing():
Trace("navigation to " + url)
end
if _wv_alive(id):
ret _wv_hooks[id].on_navigate(url)
end
ret true
end
func _wv_fire_new_window(id: int, url: str):
if _wv_alive(id):
_wv_hooks[id].on_new_window(url)
end
end
func _wv_fire_close(id: int): bool:
if _wv_alive(id):
ret _wv_hooks[id].on_close()
end
ret true
end
func _wv_fire_load(id: int, url: str, finished: bool):
if _wv_alive(id):
_wv_hooks[id].on_load(url, finished)
end
end
func _wv_fire_crash(id: int):
if _wv_alive(id):
_wv_hooks[id].on_crash()
end
end
func _wv_fire_resize(id: int, width: int, height: int):
if _wv_alive(id):
_wv_hooks[id].on_resize(width, height)
end
end
func _wv_scheme_answer(req: Request): Response:
each s in _wv_schemes:
if str.EqualFold(s.name, req.scheme):
answer := s.handler(req)
if _wv_tracing():
Trace("resource " + req.path + ": " + str.FromInt(answer.status as i64))
end
ret answer
end
end
ret Response { status = 404, mime = "text/plain" }
end
func _wv_request_free(req: Request):
if req.path != "/":
mem.Free(req.path as void*)
end
if req.query.len() > 0:
mem.Free(req.query as void*)
end
end
func _wv_split_url(url: str, scheme: str, method: str): Request:
mut r := Request { url = url, scheme = scheme, method = method }
start := str.IndexOf(url, "://")
if start < 0:
ret r
end
after := str.Substr(url, start + 3, str.Len(url) - start - 3)
defer mem.Free(after as void*)
slash := str.IndexOf(after, "/")
if slash < 0:
ret r
end
mut rest := str.Substr(after, slash, str.Len(after) - slash)
hash := str.IndexOf(rest, "#")
if hash >= 0:
cut := str.Substr(rest, 0, hash)
mem.Free(rest as void*)
rest = cut
end
q := str.IndexOf(rest, "?")
if q >= 0:
r.path = str.Substr(rest, 0, q)
r.query = str.Substr(rest, q + 1, str.Len(rest) - q - 1)
mem.Free(rest as void*)
else:
r.path = rest
end
ret r
end
@en "Dispatch"
@fa "ارسال به رشته رابط"
pub func Dispatch(work: func ()):
_wv_enqueue(_Task { run = work, has_run = true })
end
@en "RunAll"
@fa "اجرای همه"
pub func RunAll():
_wv_drain()
until _wv_open > 0 and not _wv_quit:
_wv_bk_iter()
_wv_drain()
end
_wv_quit = false
end
@en "Quit"
@fa "خروج"
pub func Quit():
_wv_quit = true
_wv_bk_wake()
end
@en "SetApp"
@fa "تنظیم برنامه"
pub func SetApp(id: str, name: str):
_wv_app_id = str.Clone(id)
_wv_app_name = str.Clone(name)
end
