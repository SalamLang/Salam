@en "CompareJalali"
@fa "مقایسه تاریخ جلالی"
pub func CompareJalali(a: JalaliDate, b: JalaliDate): int:
da := JalaliToJDN(a)
db := JalaliToJDN(b)
if da < db: ret 0 - 1 end
if da > db: ret 1 end
ret 0
end
package calendar
import time
struct _EpochParts:
pub jdn: i64 = 0
pub secOfDay: i64 = 0
end
@en "TimeZone"
@fa "منطقه زمانی"
pub struct TimeZone:
@en "name"
@fa "نام"
pub name: str = "UTC"
@en "offset_minutes"
@fa "اختلاف دقیقه‌ای"
pub offset_minutes: int = 0
end
func _pseudoEpoch(y: int, m: int, d: int, hh: int, mm: int, ss: int): i64:
jdn := GregorianToJDN(GregorianDate { year = y, month = m, day = d })
ret (jdn - _UNIX_EPOCH_JDN) * _SECONDS_PER_DAY + (hh as i64) * 3600 + (mm as i64) * 60 + (ss as i64)
end
func _epochParts(epoch: i64): _EpochParts:
days := _floordiv(epoch, _SECONDS_PER_DAY)
sec := epoch - days * _SECONDS_PER_DAY
ret _EpochParts { jdn = _UNIX_EPOCH_JDN + days, secOfDay = sec }
end
func _fallbackZone(name: str): TimeZone:
if name == "Asia/Tehran": ret TZTehran() end
if name == "Asia/Kabul": ret TZKabul() end
if name == "Asia/Riyadh": ret TZRiyadh() end
if name == "Asia/Dubai": ret TZDubai() end
if name == "Europe/Istanbul": ret TZIstanbul() end
if name == "Europe/London": ret TZLondon() end
if name == "America/New_York": ret TZNewYork() end
if name == "Asia/Tokyo": ret TZTokyo() end
ret TimeZone { name = name, offset_minutes = 0 }
end
@en "FixedOffsetZone"
@fa "منطقه زمانی ثابت"
pub func FixedOffsetZone(name: str, offsetMinutes: int): TimeZone:
ret TimeZone { name = name, offset_minutes = offsetMinutes }
end
@en "TZUTC"
@fa "منطقه زمانی جهانی"
pub func TZUTC(): TimeZone: ret TimeZone { name = "UTC", offset_minutes = 0 } end
@en "TZTehran"
@fa "منطقه زمانی تهران"
pub func TZTehran(): TimeZone: ret TimeZone { name = "Asia/Tehran", offset_minutes = 210 } end
@en "TZKabul"
@fa "منطقه زمانی کابل"
pub func TZKabul(): TimeZone: ret TimeZone { name = "Asia/Kabul", offset_minutes = 270 } end
@en "TZRiyadh"
@fa "منطقه زمانی ریاض"
pub func TZRiyadh(): TimeZone: ret TimeZone { name = "Asia/Riyadh", offset_minutes = 180 } end
@en "TZMecca"
@fa "منطقه زمانی مکه"
pub func TZMecca(): TimeZone: ret TimeZone { name = "Asia/Riyadh", offset_minutes = 180 } end
@en "TZDubai"
@fa "منطقه زمانی دبی"
pub func TZDubai(): TimeZone: ret TimeZone { name = "Asia/Dubai", offset_minutes = 240 } end
@en "TZIstanbul"
@fa "منطقه زمانی استانبول"
pub func TZIstanbul(): TimeZone: ret TimeZone { name = "Europe/Istanbul", offset_minutes = 180 } end
@en "TZLondon"
@fa "منطقه زمانی لندن"
pub func TZLondon(): TimeZone: ret TimeZone { name = "Europe/London", offset_minutes = 0 } end
@en "TZNewYork"
@fa "منطقه زمانی نیویورک"
pub func TZNewYork(): TimeZone: ret TimeZone { name = "America/New_York", offset_minutes = 0 - 300 } end
@en "TZTokyo"
@fa "منطقه زمانی توکیو"
pub func TZTokyo(): TimeZone: ret TimeZone { name = "Asia/Tokyo", offset_minutes = 540 } end
@en "LocalOffsetMinutes"
@fa "اختلاف زمانی محلی"
pub func LocalOffsetMinutes(epoch: i64): int:
localPseudo := _pseudoEpoch(time.Year(epoch), time.Month(epoch), time.Day(epoch), time.Hour(epoch), time.Minute(epoch), time.Second(epoch))
ret ((localPseudo - epoch) / 60) as int
end
@en "TZLocal"
@fa "منطقه زمانی محلی"
pub func TZLocal(epoch: i64): TimeZone:
ret TimeZone { name = "Local", offset_minutes = LocalOffsetMinutes(epoch) }
end
@en "WallClockGregorian"
@fa "تاریخ میلادی محلی"
pub func WallClockGregorian(epoch: i64, tz: TimeZone): GregorianDate:
shifted := epoch + (tz.offset_minutes as i64) * 60
ret JDNToGregorian(_epochParts(shifted).jdn)
end
@en "WallClockJalali"
@fa "تاریخ جلالی محلی"
pub func WallClockJalali(epoch: i64, tz: TimeZone): JalaliDate: ret GregorianToJalali(WallClockGregorian(epoch, tz)) end
@en "WallClockHijri"
@fa "تاریخ هجری محلی"
pub func WallClockHijri(epoch: i64, tz: TimeZone): HijriDate: ret GregorianToHijri(WallClockGregorian(epoch, tz)) end
@en "WallClockTime"
@fa "ساعت محلی"
pub func WallClockTime(epoch: i64, tz: TimeZone): ClockTime:
shifted := epoch + (tz.offset_minutes as i64) * 60
secOfDay := _epochParts(shifted).secOfDay
hh := secOfDay / 3600
mm := (secOfDay - hh * 3600) / 60
ss := secOfDay - hh * 3600 - mm * 60
ret ClockTime { hour = hh as int, minute = mm as int, second = ss as int }
end
@en "ZonedGregorianToEpoch"
@fa "میلادی محلی به زمان مطلق"
pub func ZonedGregorianToEpoch(d: GregorianDate, t: ClockTime, tz: TimeZone): i64:
ret GregorianToUnixUTC(d, t.hour, t.minute, t.second) - (tz.offset_minutes as i64) * 60
end
@en "ConvertZonedGregorian"
@fa "تبدیل میلادی بین مناطق زمانی"
pub func ConvertZonedGregorian(d: GregorianDate, t: ClockTime, from: TimeZone, toTz: TimeZone): GregorianDate:
epoch := ZonedGregorianToEpoch(d, t, from)
ret WallClockGregorian(epoch, toTz)
end
@en "ConvertZonedTime"
@fa "تبدیل ساعت بین مناطق زمانی"
pub func ConvertZonedTime(d: GregorianDate, t: ClockTime, from: TimeZone, toTz: TimeZone): ClockTime:
epoch := ZonedGregorianToEpoch(d, t, from)
ret WallClockTime(epoch, toTz)
end
package calendar
import mem
import str
extern:
func fopen(path: str, mode: str): void*
func fread(ptr: void*, size: u64, count: u64, stream: void*): u64
func fclose(stream: void*): int
func fseek(stream: void*, offset: int, whence: int): int
func ftell(stream: void*): int
func getenv(name: str): void*
end
const _TZ_MAX_FILE := 2000000
struct PosixRule:
pub kind: int = 0
pub mon: int = 0
pub week: int = 0
pub day: int = 0
pub at_seconds: int = 7200
end
struct PosixTZ:
pub ok: bool = false
pub has_dst: bool = false
pub std_abbrev: str = ""
pub dst_abbrev: str = ""
pub std_offset: int = 0
pub dst_offset: int = 0
pub dst_from: PosixRule = PosixRule {}
pub dst_to: PosixRule = PosixRule {}
end
struct _Bytes:
pub data: u8* = null
pub len: int = 0
end
struct _TZHead:
pub ok: bool = false
pub version: int = 0
pub isutcnt: int = 0
pub isstdcnt: int = 0
pub leapcnt: int = 0
pub timecnt: int = 0
pub typecnt: int = 0
pub charcnt: int = 0
end
@en "Zone"
@fa "منطقه"
pub struct Zone:
@en "name"
@fa "نام"
pub name: str = "UTC"
@en "ok"
@fa "بارگذاری شد"
pub ok: bool = false
@en "type_offset"
@fa "اختلاف نوع‌ها"
pub type_offset: Vector<int> = Vector {}
@en "type_isdst"
@fa "تابستانی نوع‌ها"
pub type_isdst: Vector<bool> = Vector {}
@en "type_abbrev"
@fa "نماد نوع‌ها"
pub type_abbrev: Vector<str> = Vector {}
@en "times"
@fa "لحظه‌های تغییر"
pub times: Vector<i64> = Vector {}
@en "type_at"
@fa "نوع پس از تغییر"
pub type_at: Vector<int> = Vector {}
@en "base_type"
@fa "نوع پایه"
pub base_type: int = 0
@en "rule"
@fa "قاعده"
pub rule: PosixTZ = PosixTZ {}
end
func _readFile(path: str): _Bytes:
empty := _Bytes { data = null, len = 0 }
f := fopen(path, "rb")
if f == null: ret empty end
if fseek(f, 0, 2) != 0:
fclose(f)
ret empty
end
n := ftell(f) as i64
if n <= 0 or n > (_TZ_MAX_FILE as i64):
fclose(f)
ret empty
end
if fseek(f, 0, 0) != 0:
fclose(f)
ret empty
end
p := mem.Allocate(n as u64)
if p == null:
fclose(f)
ret empty
end
got := fread(p, 1 as u64, n as u64, f)
fclose(f)
if (got as i64) != n:
mem.Free(p)
ret empty
end
ret _Bytes { data = p as u8*, len = n as int }
end
pure func _be32u(p: u8*, off: int): i64:
ret ((p[off] as i64) << 24) | ((p[off + 1] as i64) << 16) | ((p[off + 2] as i64) << 8) | (p[off + 3] as i64)
end
pure func _be32s(p: u8*, off: int): i64:
v := _be32u(p, off)
if v >= 2147483648 as i64: ret v - 4294967296 end
ret v
end
pure func _be64s(p: u8*, off: int): i64:
mut v := 0 as i64
repeat 8 in k:
v = (v << 8) | (p[off + k] as i64)
end
ret v
end
func _cstrAt(p: u8*, start: int, limit: int): str:
mut b := str.NewBuilder()
mut i := start
until i < limit and p[i] as int != 0:
str.BufAppendChar(b, p[i] as int)
i++
end
out := str.BufStr(b)
str.BufFree(b)
ret out
end
pure func _isAlphaByte(c: int): bool:
ret (c >= 65 and c <= 90) or (c >= 97 and c <= 122)
end
pure func _isDigitByte(c: int): bool: ret c >= 48 and c <= 57 end
func _byteAt(s: str, i: int): int:
bp := (s as void*) as i8*
mut v := bp[i] as int
if v < 0: v += 256 end
ret v
end
func _parseAbbrev(s: str, i &: int, out &: str): bool:
n := s.len()
if i >= n: ret false end
if _byteAt(s, i) == 60:
i++
start := i
until i < n and _byteAt(s, i) != 62:
i++
end
if i >= n: ret false end
out = s.substr(start, i - start)
i++
ret out.len() > 0
end
start := i
until i < n and _isAlphaByte(_byteAt(s, i)):
i++
end
if i == start: ret false end
out = s.substr(start, i - start)
ret true
end
func _parseHMS(s: str, i &: int, out &: int): bool:
n := s.len()
if i >= n: ret false end
mut sign := 1
if _byteAt(s, i) == 45:
sign = 0 - 1
i++
else _byteAt(s, i) == 43:
i++
end
mut parts := [0, 0, 0]
mut got := 0
until got < 3:
if got > 0:
if i >= n or _byteAt(s, i) != 58: break end
i++
end
start := i
mut v := 0
until i < n and _isDigitByte(_byteAt(s, i)):
if v > 100000000: ret false end
v = v * 10 + (_byteAt(s, i) - 48)
i++
end
if i == start: ret false end
parts[got] = v
got++
end
if got == 0: ret false end
out = sign * (parts[0] * 3600 + parts[1] * 60 + parts[2])
ret true
end
func _parseRule(s: str, i &: int, out &: PosixRule): bool:
n := s.len()
if i >= n: ret false end
mut r := PosixRule { kind = 0, mon = 0, week = 0, day = 0, at_seconds = 7200 }
c := _byteAt(s, i)
if c == 77:
i++
mut vals := [0, 0, 0]
repeat 3 in k:
if k > 0:
if i >= n or _byteAt(s, i) != 46: ret false end
i++
end
start := i
mut v := 0
until i < n and _isDigitByte(_byteAt(s, i)):
if v > 100000000: ret false end
v = v * 10 + (_byteAt(s, i) - 48)
i++
end
if i == start: ret false end
vals[k] = v
end
if vals[0] < 1 or vals[0] > 12: ret false end
if vals[1] < 1 or vals[1] > 5: ret false end
if vals[2] < 0 or vals[2] > 6: ret false end
r.kind = 1
r.mon = vals[0]
r.week = vals[1]
r.day = vals[2]
else c == 74:
i++
start := i
mut v := 0
until i < n and _isDigitByte(_byteAt(s, i)):
if v > 100000000: ret false end
v = v * 10 + (_byteAt(s, i) - 48)
i++
end
if i == start: ret false end
r.kind = 2
r.day = v
else _isDigitByte(c):
mut v := 0
until i < n and _isDigitByte(_byteAt(s, i)):
if v > 100000000: ret false end
v = v * 10 + (_byteAt(s, i) - 48)
i++
end
r.kind = 3
r.day = v
else:
ret false
end
if i < n and _byteAt(s, i) == 47:
i++
mut t := 0
if not _parseHMS(s, i, t): ret false end
r.at_seconds = t
end
out = r
ret true
end
func _parsePosixTZ(s: str): PosixTZ:
mut out := PosixTZ { ok = false }
n := s.len()
if n == 0: ret out end
mut i := 0
mut abbrev := ""
if not _parseAbbrev(s, i, abbrev): ret out end
mut off := 0
if not _parseHMS(s, i, off): ret out end
out.std_abbrev = abbrev
out.std_offset = 0 - off
out.dst_abbrev = abbrev
out.dst_offset = out.std_offset
out.ok = true
if i >= n: ret out end
mut dabbrev := ""
if _byteAt(s, i) != 44:
if not _parseAbbrev(s, i, dabbrev): ret out end
out.dst_abbrev = dabbrev
out.has_dst = true
out.dst_offset = out.std_offset + 3600
if i < n and _byteAt(s, i) != 44:
mut doff := 0
if not _parseHMS(s, i, doff): ret out end
out.dst_offset = 0 - doff
end
end
if not out.has_dst: ret out end
if i >= n or _byteAt(s, i) != 44: ret out end
i++
mut r1 := PosixRule {}
if not _parseRule(s, i, r1): ret out end
if i >= n or _byteAt(s, i) != 44: ret out end
i++
mut r2 := PosixRule {}
if not _parseRule(s, i, r2): ret out end
out.dst_from = r1
out.dst_to = r2
ret out
end
func _ruleInstant(r: PosixRule, year: int, offsetBefore: int): i64:
mut d := GregorianDate { year = year, month = 1, day = 1 }
if r.kind == 1:
first := GregorianDate { year = year, month = r.mon, day = 1 }
firstMatch := NextWeekdayOnOrAfter(first, r.day)
cand := AddDaysGregorian(firstMatch, (r.week - 1) * 7)
if cand.month != r.mon:
d = AddDaysGregorian(cand, 0 - 7)
else:
d = cand
end
else r.kind == 2:
mut n := r.day
if n < 1: n = 1 end
if n > 59 and IsLeapGregorian(year): n++ end
d = AddDaysGregorian(GregorianDate { year = year, month = 1, day = 1 }, n - 1)
else:
d = AddDaysGregorian(GregorianDate { year = year, month = 1, day = 1 }, r.day)
end
local := _pseudoEpoch(d.year, d.month, d.day, 0, 0, 0) + (r.at_seconds as i64)
ret local - (offsetBefore as i64)
end
func _posixIsDST(p: PosixTZ, epoch: i64): bool:
if not p.has_dst: ret false end
if p.dst_from.kind == 0 or p.dst_to.kind == 0: ret true end
approx := _epochParts(epoch + (p.std_offset as i64))
year := JDNToGregorian(approx.jdn).year
startAt := _ruleInstant(p.dst_from, year, p.std_offset)
stopAt := _ruleInstant(p.dst_to, year, p.dst_offset)
if startAt < stopAt:
ret epoch >= startAt and epoch < stopAt
end
ret epoch >= startAt or epoch < stopAt
end
func _parseHead(b: _Bytes, off: int): _TZHead:
bad := _TZHead { ok = false }
if off < 0 or b.len < 44 or off > b.len - 44: ret bad end
p := b.data
if p[off] as int != 84 or p[off + 1] as int != 90 or p[off + 2] as int != 105 or p[off + 3] as int != 102:
ret bad
end
lim := b.len as i64
isutcnt := _be32u(p, off + 20)
isstdcnt := _be32u(p, off + 24)
leapcnt := _be32u(p, off + 28)
timecnt := _be32u(p, off + 32)
typecnt := _be32u(p, off + 36)
charcnt := _be32u(p, off + 40)
if isutcnt > lim or isstdcnt > lim or leapcnt > lim: ret bad end
if timecnt > lim or typecnt > lim or charcnt > lim: ret bad end
ret _TZHead {
ok = true, version = p[off + 4] as int, isutcnt = isutcnt as int, isstdcnt = isstdcnt as int,
leapcnt = leapcnt as int, timecnt = timecnt as int, typecnt = typecnt as int, charcnt = charcnt as int
}
end
func _blockSize(h: _TZHead, tsize: int): i64:
tc := h.timecnt as i64
ret tc * (tsize as i64) + tc + (h.typecnt as i64) * 6 + (h.charcnt as i64) + (h.leapcnt as i64) * ((tsize + 4) as i64) + (h.isstdcnt as i64) + (h.isutcnt as i64)
end
func _readBlock(b: _Bytes, off: int, h: _TZHead, tsize: int, z &: Zone): bool:
if off < 0 or h.typecnt <= 0 or h.charcnt <= 0 or h.timecnt < 0: ret false end
if (off as i64) + _blockSize(h, tsize) > (b.len as i64): ret false end
p := b.data
mut c := off
timesAt := c
c += h.timecnt * tsize
idxAt := c
c += h.timecnt
typesAt := c
c += h.typecnt * 6
charsAt := c
repeat h.typecnt in k:
base := typesAt + k * 6
z.type_offset.push(_be32s(p, base) as int)
z.type_isdst.push(p[base + 4] as int != 0)
di := p[base + 5] as int
if charsAt + di >= b.len: ret false end
z.type_abbrev.push(_cstrAt(p, charsAt + di, charsAt + h.charcnt))
end
repeat h.timecnt in k:
mut t := 0 as i64
if tsize == 8:
t = _be64s(p, timesAt + k * 8)
else:
t = _be32s(p, timesAt + k * 4)
end
ti := p[idxAt + k] as int
if ti >= h.typecnt: ret false end
z.times.push(t)
z.type_at.push(ti)
end
mut base := 0
mut found := false
repeat h.typecnt in k:
if not found and not z.type_isdst.get(k):
base = k
found = true
end
end
z.base_type = base
ret true
end
func _readFooter(b: _Bytes, off: int): str:
if off < 0 or off >= b.len: ret "" end
p := b.data
if p[off] as int != 10: ret "" end
mut i := off + 1
start := i
until i < b.len and p[i] as int != 10:
i++
end
if i <= start: ret "" end
ret _cstrAt(p, start, i)
end
func _parseTZif(b: _Bytes, z &: Zone): bool:
h1 := _parseHead(b, 0)
if not h1.ok: ret false end
if h1.version == 0:
ret _readBlock(b, 44, h1, 4, z)
end
second64 := 44 + _blockSize(h1, 4)
if second64 < 0 or second64 > (b.len as i64): ret _readBlock(b, 44, h1, 4, z) end
second := second64 as int
h2 := _parseHead(b, second)
if not h2.ok: ret _readBlock(b, 44, h1, 4, z) end
dataAt64 := (second as i64) + 44
if dataAt64 > (b.len as i64): ret false end
dataAt := dataAt64 as int
if not _readBlock(b, dataAt, h2, 8, z): ret false end
footer64 := dataAt64 + _blockSize(h2, 8)
if footer64 < 0 or footer64 > (b.len as i64): ret true end
z.rule = _parsePosixTZ(_readFooter(b, footer64 as int))
ret true
end
func _env(name: str): str:
p := getenv(name)
if p == null: ret "" end
ret p as str
end
func _safeZoneName(name: str): bool:
n := name.len()
if n == 0 or n > 128: ret false end
if _byteAt(name, 0) == 47: ret false end
repeat n in i:
c := _byteAt(name, i)
alnum := _isAlphaByte(c) or _isDigitByte(c)
if not alnum and c != 47 and c != 95 and c != 45 and c != 43 and c != 46: ret false end
if c == 46 and i + 1 < n and _byteAt(name, i + 1) == 46: ret false end
end
ret true
end
func _zoneDirs(): Vector<str>:
mut dirs := Vector {} as Vector<str>
tzdir := _env("TZDIR")
if tzdir.len() > 0: dirs.push(tzdir) end
dirs.push("/usr/share/zoneinfo")
dirs.push("/usr/lib/zoneinfo")
dirs.push("/usr/share/lib/zoneinfo")
dirs.push("/etc/zoneinfo")
dirs.push("/var/db/timezone/zoneinfo")
ret dirs
end
func _loadFromPath(path: str, name: str): Zone:
mut z := Zone { name = name, ok = false }
b := _readFile(path)
if b.data == null: ret z end
good := _parseTZif(b, z)
mem.Free(b.data as void*)
if not good:
FreeZone(z)
ret Zone { name = name, ok = false }
end
z.ok = true
ret z
end
func _findTransition(z: Zone, epoch: i64): int:
n := z.times.len()
if n == 0: ret 0 - 1 end
if epoch < z.times.get(0): ret 0 - 1 end
mut lo := 0
mut hi := n - 1
until lo < hi:
mid := (lo + hi + 1) / 2
if z.times.get(mid) <= epoch:
lo = mid
else:
hi = mid - 1
end
end
ret lo
end
func _posixTypeFor(z: Zone, epoch: i64): int:
if not z.rule.ok: ret 0 - 1 end
dst := _posixIsDST(z.rule, epoch)
mut want := z.rule.std_offset
mut wantAbbrev := z.rule.std_abbrev
if dst:
want = z.rule.dst_offset
wantAbbrev = z.rule.dst_abbrev
end
n := z.type_offset.len()
repeat n in k:
if z.type_offset.get(k) == want and z.type_isdst.get(k) == dst and z.type_abbrev.get(k) == wantAbbrev:
ret k
end
end
repeat n in k:
if z.type_offset.get(k) == want and z.type_isdst.get(k) == dst: ret k end
end
ret 0 - 1
end
@en "LoadZone"
@fa "بارگذاری منطقه"
pub func LoadZone(name: str): Zone:
if not _safeZoneName(name): ret Zone { name = name, ok = false } end
mut dirs := _zoneDirs()
defer dirs.free()
n := dirs.len()
repeat n in i:
z := _loadFromPath(dirs.get(i) + "/" + name, name)
if z.ok: ret z end
end
ret Zone { name = name, ok = false }
end
@en "LocalZone"
@fa "منطقه محلی"
pub func LocalZone(): Zone:
mut tz := _env("TZ")
if tz.len() > 1 and _byteAt(tz, 0) == 58:
tz = tz.substr(1, tz.len() - 1)
end
if tz.len() > 0:
z := LoadZone(tz)
if z.ok: ret z end
end
z2 := _loadFromPath("/etc/localtime", "Local")
if z2.ok: ret z2 end
ret Zone { name = "Local", ok = false }
end
@en "FreeZone"
@fa "آزادسازی منطقه"
pub func FreeZone(z &: Zone):
z.type_offset.free()
z.type_isdst.free()
z.type_abbrev.free()
z.times.free()
z.type_at.free()
z.ok = false
end
@en "ZoneOffsetSeconds"
@fa "اختلاف ثانیه منطقه"
pub func ZoneOffsetSeconds(z: Zone, epoch: i64): int:
if not z.ok: ret 0 end
if z.type_offset.len() == 0: ret 0 end
idx := _findTransition(z, epoch)
if idx < 0: ret z.type_offset.get(z.base_type) end
if idx == z.times.len() - 1:
pt := _posixTypeFor(z, epoch)
if pt >= 0: ret z.type_offset.get(pt) end
end
ret z.type_offset.get(z.type_at.get(idx))
end
@en "ZoneOffsetMinutes"
@fa "اختلاف دقیقه منطقه"
pub func ZoneOffsetMinutes(z: Zone, epoch: i64): int:
ret ZoneOffsetSeconds(z, epoch) / 60
end
@en "ZoneIsDST"
@fa "ساعت تابستانی منطقه"
pub func ZoneIsDST(z: Zone, epoch: i64): bool:
if not z.ok: ret false end
if z.type_isdst.len() == 0: ret false end
idx := _findTransition(z, epoch)
if idx < 0: ret z.type_isdst.get(z.base_type) end
if idx == z.times.len() - 1:
pt := _posixTypeFor(z, epoch)
if pt >= 0: ret z.type_isdst.get(pt) end
end
ret z.type_isdst.get(z.type_at.get(idx))
end
@en "ZoneAbbrevAt"
@fa "نماد منطقه"
pub func ZoneAbbrevAt(z: Zone, epoch: i64): str:
if not z.ok: ret "UTC" end
if z.type_abbrev.len() == 0: ret "UTC" end
idx := _findTransition(z, epoch)
if idx < 0: ret z.type_abbrev.get(z.base_type) end
if idx == z.times.len() - 1:
pt := _posixTypeFor(z, epoch)
if pt >= 0: ret z.type_abbrev.get(pt) end
end
ret z.type_abbrev.get(z.type_at.get(idx))
end
@en "TimeZoneAt"
@fa "منطقه زمانی در"
pub func TimeZoneAt(z: Zone, epoch: i64): TimeZone:
if not z.ok: ret _fallbackZone(z.name) end
ret TimeZone { name = ZoneAbbrevAt(z, epoch), offset_minutes = ZoneOffsetMinutes(z, epoch) }
end
@en "ZoneAt"
@fa "منطقه در"
pub func ZoneAt(name: str, epoch: i64): TimeZone:
mut z := LoadZone(name)
defer FreeZone(z)
ret TimeZoneAt(z, epoch)
end
@en "ZonedToEpoch"
@fa "محلی به زمان مطلق"
pub func ZonedToEpoch(d: GregorianDate, t: ClockTime, z: Zone): i64:
local := _pseudoEpoch(d.year, d.month, d.day, t.hour, t.minute, t.second)
mut guess := local - (ZoneOffsetSeconds(z, local) as i64)
off2 := ZoneOffsetSeconds(z, guess)
if local - (off2 as i64) != guess:
guess = local - (off2 as i64)
end
ret guess
end
@en "chan"
@fa "کانال"
package chan
import mem
import sync
mut sel_mu := sync.NewMutex()
mut sel_cv := sync.NewCondVar()
mut sel_cells := mem.MustAllocateZeroed(16 as u64) as i64*
struct TimerArg:
pub ch: Chan<i64> = Chan {} as Chan<i64>
pub cancel: i64* = null
pub ms: i64 = 0
pub repeat_: i64 = 0
end
@en "Chan"
@fa "کانال"
pub struct Chan<T>:
@en "buf"
@fa "بافر"
pub buf: T* = null
@en "ctl"
@fa "وضعیت درونی"
pub ctl: i64* = null
@en "cap"
@fa "اندازه بافر"
pub cap: i64 = 0
@en "zidx"
@fa "خانه صفر"
pub zidx: i64 = 0
@en "mu"
@fa "قفل"
pub mu: sync.Mutex = sync.Mutex {}
@en "not_empty"
@fa "شرط ناخالی"
pub not_empty: sync.CondVar = sync.CondVar {}
@en "not_full"
@fa "شرط ناپر"
pub not_full: sync.CondVar = sync.CondVar {}
@en "taken"
@fa "شرط برداشت"
pub taken: sync.CondVar = sync.CondVar {}
@en "init"
@fa "مقداردهی"
pub func init(capacity: i64):
mut n := capacity
if n < 0: n = 0 end
this.cap = n
mut slots := n + 1
if n == 0: slots = 2 end
this.zidx = slots - 1
this.buf = mem.MustAllocateZeroed((slots * (sizeof(T) as i64)) as u64) as T*
this.ctl = mem.MustAllocateZeroed(64 as u64) as i64*
this.mu = sync.NewMutex()
this.not_empty = sync.NewCondVar()
this.not_full = sync.NewCondVar()
this.taken = sync.NewCondVar()
end
@en "send"
@fa "فرستادن"
pub func send(v: T): bool:
ret this.send_deadline(v, 0 as i64, false)
end
@en "send_timeout"
@fa "فرستادن با مهلت"
pub func send_timeout(v: T, ms: i64): bool:
ret this.send_deadline(v, ms, true)
end
@en "send_deadline"
@fa "فرستادن با موعد"
pub func send_deadline(v: T, ms: i64, timed: bool): bool:
c := this.ctl
b := this.buf
sync.Lock(this.mu)
deadline := sync.NowMs() + ms
mut expired := false
mut room := this.cap
if this.cap == 0: room = 1 end
until c[3] == 0 and c[2] >= room and not expired:
if timed:
left := deadline - sync.NowMs()
if left <= 0:
expired = true
else:
_ := sync.WaitCondTimeout(this.not_full, this.mu, left)
end
else:
sync.WaitCond(this.not_full, this.mu)
end
end
if c[3] != 0 or expired:
sync.Unlock(this.mu)
ret false
end
if this.cap == 0:
b[0] = v
c[2] = 1
mine := c[4] + 1
c[4] = mine
sync.Signal(this.not_empty)
wake_selectors()
until c[3] == 0 and c[5] < mine and not expired:
if timed:
left := deadline - sync.NowMs()
if left <= 0:
expired = true
else:
_ := sync.WaitCondTimeout(this.taken, this.mu, left)
end
else:
sync.WaitCond(this.taken, this.mu)
end
end
if c[5] < mine:
c[2] = 0
sync.Signal(this.not_full)
sync.Unlock(this.mu)
ret false
end
sync.Unlock(this.mu)
ret true
end
b[c[1]] = v
c[1] = (c[1] + 1) % this.cap
c[2]++
sync.Signal(this.not_empty)
sync.Unlock(this.mu)
wake_selectors()
ret true
end
@en "recv"
@fa "دریافت"
pub func recv(ok &: bool): T:
ret this.recv_deadline(ok, 0 as i64, false)
end
@en "recv_timeout"
@fa "دریافت با مهلت"
pub func recv_timeout(ok &: bool, ms: i64): T:
ret this.recv_deadline(ok, ms, true)
end
@en "recv_deadline"
@fa "دریافت با موعد"
pub func recv_deadline(ok &: bool, ms: i64, timed: bool): T:
c := this.ctl
b := this.buf
sync.Lock(this.mu)
deadline := sync.NowMs() + ms
mut expired := false
until c[3] == 0 and c[2] <= 0 and not expired:
if timed:
left := deadline - sync.NowMs()
if left <= 0:
expired = true
else:
_ := sync.WaitCondTimeout(this.not_empty, this.mu, left)
end
else:
sync.WaitCond(this.not_empty, this.mu)
end
end
if c[2] <= 0:
ok = false
sync.Unlock(this.mu)
ret b[this.zidx]
end
mut v := b[c[0]]
if this.cap == 0:
v = b[0]
c[2] = 0
c[5]++
sync.Broadcast(this.taken)
else:
c[0] = (c[0] + 1) % this.cap
c[2]--
end
ok = true
sync.Signal(this.not_full)
sync.Unlock(this.mu)
wake_selectors()
ret v
end
@en "try_send"
@fa "کوشش برای فرستادن"
pub func try_send(v: T): bool:
if this.cap == 0:
ret false
end
c := this.ctl
b := this.buf
sync.Lock(this.mu)
if c[3] != 0 or c[2] >= this.cap:
sync.Unlock(this.mu)
ret false
end
b[c[1]] = v
c[1] = (c[1] + 1) % this.cap
c[2]++
sync.Signal(this.not_empty)
sync.Unlock(this.mu)
wake_selectors()
ret true
end
@en "try_recv"
@fa "کوشش برای دریافت"
pub func try_recv(ok &: bool): T:
c := this.ctl
b := this.buf
sync.Lock(this.mu)
if c[2] <= 0:
ok = false
sync.Unlock(this.mu)
ret b[this.zidx]
end
mut v := b[c[0]]
if this.cap == 0:
v = b[0]
c[2] = 0
c[5]++
sync.Broadcast(this.taken)
else:
c[0] = (c[0] + 1) % this.cap
c[2]--
end
ok = true
sync.Signal(this.not_full)
sync.Unlock(this.mu)
wake_selectors()
ret v
end
@en "close"
@fa "بستن"
pub func close():
c := this.ctl
sync.Lock(this.mu)
c[3] = 1
sync.Broadcast(this.not_empty)
sync.Broadcast(this.not_full)
sync.Broadcast(this.taken)
sync.Unlock(this.mu)
wake_selectors()
end
@en "is_closed"
@fa "بسته است"
pub func is_closed(): bool:
c := this.ctl
sync.Lock(this.mu)
v := c[3] != 0
sync.Unlock(this.mu)
ret v
end
@en "len"
@fa "طول"
pub func len(): i64:
c := this.ctl
sync.Lock(this.mu)
v := c[2]
sync.Unlock(this.mu)
ret v
end
@en "capacity"
@fa "ظرفیت"
pub func capacity(): i64: ret this.cap end
@en "free"
@fa "آزادسازی"
pub func free():
sync.DestroyCondVar(this.taken)
sync.DestroyCondVar(this.not_full)
sync.DestroyCondVar(this.not_empty)
sync.Destroy(this.mu)
mem.Free(this.ctl as void*)
mem.Free(this.buf as void*)
end
end
@en "Timer"
@fa "زمان‌سنج"
pub struct Timer:
@en "c"
@fa "کانال"
pub c: Chan<i64> = Chan {} as Chan<i64>
@en "cancel"
@fa "لغو"
pub cancel: i64* = null
@en "arg"
@fa "آرگومان"
pub arg: void* = null
@en "handle"
@fa "دسته"
pub handle: i64 = 0
end
func wake_selectors():
if atomic_load(sel_cells) == 0:
ret
end
sync.Lock(sel_mu)
sel_cells[1]++
sync.Broadcast(sel_cv)
sync.Unlock(sel_mu)
end
func timer_run(ap: TimerArg*):
a := ap[0]
mut n := 0 as i64
until true:
mut left := a.ms
until left > 0 as i64 and atomic_load(a.cancel) == 0:
sync.SleepMs(1)
left--
end
if atomic_load(a.cancel) != 0:
break
end
n++
a.ch.try_send(n)
if a.repeat_ == 0:
break
end
end
end
func timer_start(ms: i64, again: i64): Timer:
mut t := Timer {}
t.c = Chan {} as Chan<i64>
t.c.init(1 as i64)
t.cancel = mem.MustAllocateZeroed(8 as u64) as i64*
ap := mem.MustAllocateZeroed(sizeof(TimerArg) as u64) as TimerArg*
ap[0] = TimerArg { ch = t.c, cancel = t.cancel, ms = ms, repeat_ = again }
t.arg = ap as void*
t.handle = spawn(timer_run, ap)
ret t
end
@en "New"
@fa "جدید"
pub func New<T>(capacity: i64): Chan<T>:
mut c := Chan {} as Chan<T>
c.init(capacity)
ret c
end
@en "Send"
@fa "فرستادن"
pub func Send<T>(c: Chan<T>, v: T): bool:
ret c.send(v)
end
@en "SendTimeout"
@fa "فرستادن با مهلت"
pub func SendTimeout<T>(c: Chan<T>, v: T, ms: i64): bool:
ret c.send_timeout(v, ms)
end
@en "TrySend"
@fa "کوشش برای فرستادن"
pub func TrySend<T>(c: Chan<T>, v: T): bool:
ret c.try_send(v)
end
@en "SendAll"
@fa "فرستادن همه"
pub func SendAll<T>(c: Chan<T>, values: Vector<T>): bool:
mut ok := true
repeat values.len() in i:
if not c.send(values.get(i)):
ok = false
break
end
end
ret ok
end
@en "Recv"
@fa "دریافت"
pub func Recv<T>(c: Chan<T>, ok &: bool): T:
ret c.recv(ok)
end
@en "RecvTimeout"
@fa "دریافت با مهلت"
pub func RecvTimeout<T>(c: Chan<T>, ok &: bool, ms: i64): T:
ret c.recv_timeout(ok, ms)
end
@en "TryRecv"
@fa "کوشش برای دریافت"
pub func TryRecv<T>(c: Chan<T>, ok &: bool): T:
ret c.try_recv(ok)
end
@en "Drain"
@fa "تخلیه"
pub func Drain<T>(c: Chan<T>): Vector<T>:
mut out := Vector {} as Vector<T>
mut ok := true
until true:
v := c.recv(ok)
if not ok:
break
end
out.push(v)
end
ret out
end
@en "Take"
@fa "برداشتن"
pub func Take<T>(c: Chan<T>, n: i64): Vector<T>:
mut out := Vector {} as Vector<T>
mut ok := true
mut i := 0 as i64
until i < n:
v := c.recv(ok)
if not ok:
break
end
out.push(v)
i++
end
ret out
end
@en "Close"
@fa "بستن"
pub func Close<T>(c: Chan<T>):
c.close()
end
@en "Len"
@fa "طول"
pub func Len<T>(c: Chan<T>): i64:
ret c.len()
end
@en "Capacity"
@fa "ظرفیت"
pub func Capacity<T>(c: Chan<T>): i64:
ret c.capacity()
end
@en "IsClosed"
@fa "بسته است"
pub func IsClosed<T>(c: Chan<T>): bool:
ret c.is_closed()
end
@en "After"
@fa "پس از"
pub func After(ms: i64): Timer:
ret timer_start(ms, 0 as i64)
end
@en "Tick"
@fa "ضربان"
pub func Tick(ms: i64): Timer:
ret timer_start(ms, 1 as i64)
end
@en "StopTimer"
@fa "توقف زمان‌سنج"
pub func StopTimer(t: Timer):
atomic_store(t.cancel, 1 as i64)
join(t.handle)
t.c.free()
mem.Free(t.cancel as void*)
mem.Free(t.arg)
end
@en "Select"
@fa "گزینش"
pub func Select<T>(cs: Vector<Chan<T>>, v &: T, ms: i64): i64:
start := sync.NowMs()
atomic_add(sel_cells, 1 as i64)
until true:
sync.Lock(sel_mu)
seen := sel_cells[1]
sync.Unlock(sel_mu)
mut open := 0 as i64
mut i := 0 as i64
until i < (cs.len() as i64):
c := cs.get(i as int)
mut ok := false
got := c.try_recv(ok)
if ok:
v = got
atomic_add(sel_cells, 0 as i64 - 1)
ret i
end
if not c.is_closed():
open++
end
i++
end
if open == 0:
atomic_add(sel_cells, 0 as i64 - 1)
ret 0 as i64 - 2
end
sync.Lock(sel_mu)
if sel_cells[1] == seen:
if ms < 0:
sync.WaitCond(sel_cv, sel_mu)
else:
left := ms - (sync.NowMs() - start)
if left <= 0:
sync.Unlock(sel_mu)
atomic_add(sel_cells, 0 as i64 - 1)
ret 0 as i64 - 1
end
_ := sync.WaitCondTimeout(sel_cv, sel_mu, left)
end
end
sync.Unlock(sel_mu)
end
end
@en "SelectRecv"
@fa "گزینش دریافت"
pub func SelectRecv<T>(cs: Vector<Chan<T>>, v &: T, ok &: bool, ms: i64): i64:
idx := Select(cs, v, ms)
if idx < 0:
ok = false
ret idx
end
ok = true
ret idx
end
@en "TrySelect"
@fa "کوشش برای گزینش"
pub func TrySelect<T>(cs: Vector<Chan<T>>, v &: T): i64:
ret Select(cs, v, 0 as i64)
end
@en "SelectSend"
@fa "گزینش فرستادن"
pub func SelectSend<T>(cs: Vector<Chan<T>>, v: T, ms: i64): i64:
start := sync.NowMs()
atomic_add(sel_cells, 1 as i64)
until true:
sync.Lock(sel_mu)
seen := sel_cells[1]
sync.Unlock(sel_mu)
mut open := 0 as i64
mut i := 0 as i64
until i < (cs.len() as i64):
c := cs.get(i as int)
if c.try_send(v):
atomic_add(sel_cells, 0 as i64 - 1)
ret i
end
if not c.is_closed():
open++
end
i++
end
if open == 0:
atomic_add(sel_cells, 0 as i64 - 1)
ret 0 as i64 - 2
end
sync.Lock(sel_mu)
if sel_cells[1] == seen:
if ms < 0:
sync.WaitCond(sel_cv, sel_mu)
else:
left := ms - (sync.NowMs() - start)
if left <= 0:
sync.Unlock(sel_mu)
atomic_add(sel_cells, 0 as i64 - 1)
ret 0 as i64 - 1
end
_ := sync.WaitCondTimeout(sel_cv, sel_mu, left)
end
end
sync.Unlock(sel_mu)
end
end
@en "TrySelectSend"
@fa "کوشش برای گزینش فرستادن"
pub func TrySelectSend<T>(cs: Vector<Chan<T>>, v: T): i64:
ret SelectSend(cs, v, 0 as i64)
end
@en "cli"
@fa "خط فرمان"
package cli
import str
import fmt
import io
import flag
import collections
@en "CmdHelp"
@fa "دستور راهنما"
pub const CmdHelp := "__help__"
@en "CmdVersion"
@fa "دستور نسخه"
pub const CmdVersion := "__version__"
@en "CmdUnknown"
@fa "دستور نامشخص"
pub const CmdUnknown := "__unknown__"
@en "App"
@fa "برنامه"
pub struct App:
@en "name"
@fa "نام"
pub name: str = ""
@en "desc"
@fa "شرح"
pub desc: str = ""
@en "version"
@fa "نسخه"
pub version: str = ""
@en "cmd_names"
@fa "نام دستورها"
pub cmd_names: Vector<str> = Vector {}
@en "cmd_descs"
@fa "شرح دستورها"
pub cmd_descs: Vector<str> = Vector {}
end
func _find_cmd(app &: App, name: str): int:
repeat app.cmd_names.len() in i:
if app.cmd_names.get(i) == name: ret i end
end
ret 0 - 1
end
@en "New"
@fa "جدید"
pub func New(name: str, desc: str, version: str): App:
ret App { name = name, desc = desc, version = version }
end
@en "Register"
@fa "ثبت"
pub func Register(app &: App, name: str, desc: str):
app.cmd_names.push(name)
app.cmd_descs.push(desc)
end
@en "HasCommand"
@fa "دستور دارد"
pub func HasCommand(app &: App, name: str): bool: ret _find_cmd(app, name) >= 0 end
@en "CommandDesc"
@fa "شرح دستور"
pub func CommandDesc(app &: App, name: str): str:
idx := _find_cmd(app, name)
if idx < 0: ret "" end
ret app.cmd_descs.get(idx)
end
@en "Dispatch"
@fa "توزیع"
pub func Dispatch(app &: App, argv: Vector<str>): str:
if argv.len() == 0: ret CmdHelp end
name := argv.get(0)
if name == "-h" or name == "--help" or name == "help": ret CmdHelp end
if name == "-v" or name == "--version" or name == "version": ret CmdVersion end
if HasCommand(app, name): ret name end
ret CmdUnknown
end
@en "RemainingArgs"
@fa "آرگومان‌های باقیمانده"
pub func RemainingArgs(argv: Vector<str>): Vector<str>:
if argv.len() <= 1: ret Vector {} end
ret collections.slice(argv, 1, argv.len() - 1)
end
@en "Usage"
@fa "راهنما"
pub func Usage(app &: App): str:
mut b := str.NewBuilder()
defer str.BufFree(b)
str.BufAppend(b, app.name)
if app.version.len() > 0:
str.BufAppend(b, " ")
str.BufAppend(b, app.version)
end
str.BufAppend(b, "\n")
if app.desc.len() > 0:
str.BufAppend(b, app.desc)
str.BufAppend(b, "\n")
end
str.BufAppend(b, "\nUsage: ")
str.BufAppend(b, app.name)
str.BufAppend(b, " <command> [options]\n\nCommands:\n")
repeat app.cmd_names.len() in i:
str.BufAppend(b, "  ")
str.BufAppend(b, fmt.PadRight(app.cmd_names.get(i), 14))
str.BufAppend(b, app.cmd_descs.get(i))
str.BufAppend(b, "\n")
end
str.BufAppend(b, "\nRun '")
str.BufAppend(b, app.name)
str.BufAppend(b, " <command> --help' for help on a specific command.\n")
ret str.BufStr(b)
end
@en "RequireFlags"
@fa "الزامی بودن پرچم‌ها"
pub func RequireFlags(fs &: flag.FlagSet, names: Vector<str>): Vector<str>:
mut missing := Vector {} as Vector<str>
repeat names.len() in i:
n := names.get(i)
if flag.WasSet(fs, n) == false: missing.push(n) end
end
ret missing
end
@en "Confirm"
@fa "تایید"
pub func Confirm(question: str): bool:
print question
print " [y/N]: "
answer := str.Lower(str.Trim(io.Input()))
ret answer == "y" or answer == "yes"
end
@en "Prompt"
@fa "درخواست"
pub func Prompt(question: str): str:
print question
print ": "
ret str.Trim(io.Input())
end
@en "PromptOr"
@fa "درخواست با پیش فرض"
pub func PromptOr(question: str, def: str): str:
v := Prompt(question.concat(" (").concat(def).concat(")"))
if v.len() == 0: ret def end
ret v
end
package collections
@en "CircularList"
@fa "لیست حلقوی"
pub struct CircularList<T>:
@en "items"
@fa "عضوها"
pub items: Vector<T> = Vector {}
@en "head"
@fa "نمایه جاری"
pub head: int = 0
@en "add"
@fa "افزودن"
pub func add(x: T): this.items.push(x) end
@en "size"
@fa "اندازه"
pub func size(): int: ret this.items.len() end
@en "is_empty"
@fa "خالی است"
pub func is_empty(): bool: ret this.items.is_empty() end
@en "get"
@fa "دریافت"
pub func get(i: int): T:
n := this.items.len()
if SALAM_SAFE:
if n <= 0: salam_panic("CircularList.get: empty list") end
end
ret this.items.get(((this.head + i) % n + n) % n)
end
@en "rotate"
@fa "چرخش"
pub func rotate(k: int):
n := this.items.len()
if n > 0: this.head = ((this.head + k) % n + n) % n end
end
@en "current"
@fa "جاری"
pub func current(): T: ret this.get(0) end
@en "advance"
@fa "پیشروی"
pub func advance(): this.rotate(1) end
@en "to_vector"
@fa "تبدیل به بردار"
pub func to_vector(): Vector<T>:
mut out := Vector {} as Vector<T> mut i := 0
until i < this.items.len():
out.push(this.get(i))
i++
end
ret out
end
@en "free"
@fa "آزادسازی"
pub func free(): this.items.free() end
end
@en "collections"
@fa "مجموعه ها"
package collections
import mem
extern:
noret func salam_panic(msg: str)
end
package collections
@en "Counter"
@fa "شمارنده"
pub struct Counter<K>:
@en "m"
@fa "نگاشت"
pub m: HashMap<K, int> = HashMap {}
@en "add"
@fa "افزودن"
pub func add(k: K): this.m.put(k, this.count(k) + 1) end
@en "add_n"
@fa "افزودن چندتایی"
pub func add_n(k: K, n: int): this.m.put(k, this.count(k) + n) end
@en "count"
@fa "شمارش"
pub func count(k: K): int:
if this.m.has(k): ret this.m.get(k) end
ret 0
end
@en "distinct"
@fa "متمایز"
pub func distinct(): int: ret this.m.size() end
@en "iter"
@fa "پیمایش"
pub func iter(): CounterIter<K>:
it := CounterIter {} as CounterIter<K> it.inner = this.m.iter()
ret it
end
@en "free"
@fa "آزادسازی"
pub func free(): this.m.free() end
end
@en "CounterIter"
@fa "پیمایشگر شمارنده"
pub struct CounterIter<K>:
@en "inner"
@fa "پیمایشگر درونی"
pub inner: MapIter<K, int> = MapIter {}
@en "has_next"
@fa "بعدی دارد"
pub func has_next(): bool: ret this.inner.has_next() end
@en "key"
@fa "کلید"
pub func key(): K: ret this.inner.key() end
@en "value"
@fa "مقدار"
pub func value(): int: ret this.inner.value() end
@en "next"
@fa "بعدی"
pub func next(): this.inner.next() end
end
package collections
@en "Deque"
@fa "صف دوسر"
pub struct Deque<T>:
@en "front"
@fa "نیمه ابتدا"
pub front: Vector<T> = Vector {}
@en "back"
@fa "نیمه انتها"
pub back: Vector<T> = Vector {}
pub func _to_front(): until this.back.len() > 0: this.front.push(this.back.pop()) end end
pub func _to_back(): until this.front.len() > 0: this.back.push(this.front.pop()) end end
@en "push_front"
@fa "افزودن به ابتدا"
pub func push_front(x: T): this.front.push(x) end
@en "push_back"
@fa "افزودن به انتها"
pub func push_back(x: T): this.back.push(x) end
@en "pop_front"
@fa "برداشتن از ابتدا"
pub func pop_front(): T:
if this.front.len() == 0: this._to_front() end
ret this.front.pop()
end
@en "pop_back"
@fa "برداشتن از انتها"
pub func pop_back(): T:
if this.back.len() == 0: this._to_back() end
ret this.back.pop()
end
@en "front_val"
@fa "مقدار ابتدا"
pub func front_val(): T:
if this.front.len() == 0: this._to_front() end
ret this.front.last()
end
@en "back_val"
@fa "مقدار انتها"
pub func back_val(): T:
if this.back.len() == 0: this._to_back() end
ret this.back.last()
end
@en "size"
@fa "اندازه"
pub func size(): int: ret this.front.len() + this.back.len() end
@en "is_empty"
@fa "خالی است"
pub func is_empty(): bool: ret this.size() == 0 end
@en "get"
@fa "دریافت"
pub func get(i: int): T:
fl := this.front.len()
if i < fl: ret this.front.get(fl - 1 - i) end
ret this.back.get(i - fl)
end
@en "free"
@fa "آزادسازی"
pub func free():
this.front.free()
this.back.free()
end
end
package collections
@en "HashMap"
@fa "نگاشت درهم"
pub struct HashMap<K, V>:
@en "keys"
@fa "کلیدها"
pub keys: K* = null
@en "vals"
@fa "مقدارها"
pub vals: V* = null
@en "state"
@fa "وضعیت خانه‌ها"
pub state: int* = null
@en "cap"
@fa "ظرفیت"
pub cap: int = 0
@en "count"
@fa "شمار"
pub count: int = 0
@en "used"
@fa "خانه‌های استفاده‌شده"
pub used: int = 0
pub func _index(k: K): int:
mut idx := (hash(k) % (this.cap as u64)) as int
mut firstdel := 0 - 1
kp := this.keys
go := true
until go:
st := this.state[idx]
if st == 0:
if firstdel >= 0: ret firstdel end
ret idx
else st == 1:
if kp[idx] == k: ret idx end
else:
if firstdel < 0: firstdel = idx end
end
idx = (idx + 1) % this.cap
end
ret idx
end
pub func _resize(newcap: int):
ok := this.keys
ov := this.vals
os := this.state
oc := this.cap
this.keys = mem.MustAllocate((newcap as u64) * sizeof(K)) as K*
this.vals = mem.MustAllocate((newcap as u64) * sizeof(V)) as V*
this.state = mem.MustAllocateZeroed((newcap as u64) * sizeof(int)) as int*
this.cap = newcap
this.count = 0
this.used = 0
repeat oc in i:
if os[i] == 1:
okp := ok
ovp := ov
this.put(okp[i], ovp[i])
end
end
if ok != null: mem.Free(ok as void*) end
if ov != null: mem.Free(ov as void*) end
if os != null: mem.Free(os as void*) end
end
@en "put"
@fa "قراردادن"
pub func put(k: K, v: V):
if this.cap == 0:
this._resize(8)
else:
if (this.used + 1) * 10 >= this.cap * 7: this._resize(this.cap * 2) end
end
idx := this._index(k)
kp := this.keys
vp := this.vals
st := this.state[idx]
if st != 1:
this.count++
if st == 0: this.used++ end
end
this.state[idx] = 1
kp[idx] = k
vp[idx] = v
end
@en "insert"
@fa "درج"
pub func insert(k: K, v: V): this.put(k, v) end
@en "has"
@fa "دارد"
pub func has(k: K): bool:
if this.cap == 0: ret false end
idx := this._index(k)
ret this.state[idx] == 1
end
@en "get"
@fa "دریافت"
pub func get(k: K): V:
if this.cap != 0:
idx := this._index(k)
vp := this.vals
if this.state[idx] == 1: ret vp[idx] end
end
z := mem.MustAllocateZeroed(sizeof(V)) as V*
zv := z[0]
mem.Free(z as void*)
ret zv
end
@en "get_or"
@fa "دریافت با پیش فرض"
pub func get_or(k: K, def: V): V:
if this.cap == 0: ret def end
idx := this._index(k)
vp := this.vals
if this.state[idx] == 1: ret vp[idx] end
ret def
end
@en "remove"
@fa "حذف"
pub func remove(k: K): bool:
if this.cap == 0: ret false end
idx := this._index(k)
if this.state[idx] != 1: ret false end
this.state[idx] = 2
this.count--
ret true
end
@en "size"
@fa "اندازه"
pub func size(): int: ret this.count end
@en "is_empty"
@fa "خالی است"
pub func is_empty(): bool: ret this.count == 0 end
@en "iter"
@fa "پیمایشگر"
pub func iter(): MapIter<K, V>:
it := MapIter {} as MapIter<K, V> it.keys = this.keys
it.vals = this.vals
it.state = this.state
it.cap = this.cap
it.pos = 0
ret it
end
@en "free"
@fa "آزادسازی"
pub func free():
if this.keys != null: mem.Free(this.keys as void*) end
if this.vals != null: mem.Free(this.vals as void*) end
if this.state != null: mem.Free(this.state as void*) end
this.keys = null
this.vals = null
this.state = null
this.cap = 0
this.count = 0
this.used = 0
end
end
@en "MapIter"
@fa "پیمایشگر نگاشت"
pub struct MapIter<K, V>:
@en "keys"
@fa "کلیدها"
pub keys: K* = null
@en "vals"
@fa "مقدارها"
pub vals: V* = null
@en "state"
@fa "وضعیت خانه‌ها"
pub state: int* = null
@en "cap"
@fa "ظرفیت"
pub cap: int = 0
@en "pos"
@fa "جایگاه"
pub pos: int = 0
pub func _seek():
until this.pos < this.cap:
if this.state[this.pos] == 1: ret end
this.pos++
end
end
@en "has_next"
@fa "بعدی دارد"
pub func has_next(): bool:
this._seek()
ret this.pos < this.cap
end
@en "key"
@fa "کلید"
pub func key(): K:
this._seek()
kp := this.keys
ret kp[this.pos]
end
@en "value"
@fa "مقدار"
pub func value(): V:
this._seek()
vp := this.vals
ret vp[this.pos]
end
@en "next"
@fa "بعدی"
pub func next(): this.pos++ end
end
package collections
@en "LinkedList"
@fa "لیست پیوندی"
pub struct LinkedList<T>:
@en "vals"
@fa "مقدارها"
pub vals: Vector<T> = Vector {}
@en "nxt"
@fa "گره‌های بعدی"
pub nxt: Vector<int> = Vector {}
@en "prv"
@fa "گره‌های قبلی"
pub prv: Vector<int> = Vector {}
@en "head"
@fa "نخستین گره"
pub head: int = 0 - 1
@en "tail"
@fa "آخرین گره"
pub tail: int = 0 - 1
@en "freed"
@fa "گره‌های آزادشده"
pub freed: int = 0 - 1
@en "count"
@fa "شمار"
pub count: int = 0
pub func _alloc(v: T): int:
if this.freed >= 0:
idx := this.freed
this.freed = this.nxt.get(idx)
this.vals.set(idx, v)
ret idx
end
idx := this.vals.len()
this.vals.push(v)
this.nxt.push(0 - 1)
this.prv.push(0 - 1)
ret idx
end
@en "push_back"
@fa "افزودن به انتها"
pub func push_back(v: T):
n := this._alloc(v)
this.nxt.set(n, 0 - 1)
this.prv.set(n, this.tail)
if this.tail >= 0: this.nxt.set(this.tail, n) else:
this.head = n
end
this.tail = n
this.count++
end
@en "push_front"
@fa "افزودن به ابتدا"
pub func push_front(v: T):
n := this._alloc(v)
this.prv.set(n, 0 - 1)
this.nxt.set(n, this.head)
if this.head >= 0: this.prv.set(this.head, n) else:
this.tail = n
end
this.head = n
this.count++
end
pub func _unlink(n: int):
p := this.prv.get(n)
q := this.nxt.get(n)
if p >= 0: this.nxt.set(p, q) else:
this.head = q
end
if q >= 0: this.prv.set(q, p) else:
this.tail = p
end
this.nxt.set(n, this.freed)
this.freed = n
this.count--
end
@en "pop_front"
@fa "برداشتن از ابتدا"
pub func pop_front(): T:
if SALAM_SAFE:
if this.head < 0: salam_panic("LinkedList.pop_front: empty") end
end
n := this.head
v := this.vals.get(n)
this._unlink(n)
ret v
end
@en "pop_back"
@fa "برداشتن از انتها"
pub func pop_back(): T:
if SALAM_SAFE:
if this.tail < 0: salam_panic("LinkedList.pop_back: empty") end
end
n := this.tail
v := this.vals.get(n)
this._unlink(n)
ret v
end
@en "front_val"
@fa "مقدار ابتدا"
pub func front_val(): T: ret this.vals.get(this.head) end
@en "back_val"
@fa "مقدار انتها"
pub func back_val(): T: ret this.vals.get(this.tail) end
@en "size"
@fa "اندازه"
pub func size(): int: ret this.count end
@en "is_empty"
@fa "خالی است"
pub func is_empty(): bool: ret this.count == 0 end
@en "get"
@fa "دریافت"
pub func get(i: int): T:
if SALAM_SAFE:
if i < 0 or i >= this.count: salam_panic("LinkedList.get: index out of bounds") end
end
mut cur := this.head
repeat i:
cur = this.nxt.get(cur)
end
ret this.vals.get(cur)
end
@en "to_vector"
@fa "تبدیل به بردار"
pub func to_vector(): Vector<T>:
mut out := Vector {} as Vector<T> mut cur := this.head
until cur >= 0:
out.push(this.vals.get(cur))
cur = this.nxt.get(cur)
end
ret out
end
@en "free"
@fa "آزادسازی"
pub func free():
this.vals.free()
this.nxt.free()
this.prv.free()
end
end
package collections
@en "OrderedMap"
@fa "نگاشت مرتب"
pub struct OrderedMap:
@en "keys"
@fa "کلیدها"
pub keys: Vector<str> = Vector {}
@en "vals"
@fa "مقدارها"
pub vals: Vector<str> = Vector {}
@en "idx"
@fa "جدول نمایه"
pub idx: HashMap<str, int> = HashMap {}
@en "index_of"
@fa "نمایه کلید"
pub func index_of(k: str): int: ret this.idx.get(k) - 1 end
@en "len"
@fa "طول"
pub func len(): int: ret this.keys.len() end
@en "has"
@fa "دارد"
pub func has(k: str): bool: ret this.idx.get(k) > 0 end
@en "get"
@fa "دریافت"
pub func get(k: str): str:
i := this.idx.get(k) - 1
if i < 0: ret "" end
ret this.vals.get(i)
end
@en "get_or"
@fa "دریافت با پیش فرض"
pub func get_or(k: str, def: str): str:
i := this.idx.get(k) - 1
if i < 0: ret def end
ret this.vals.get(i)
end
@en "set"
@fa "تنظیم"
pub func set(k: str, v: str): int:
i := this.idx.get(k) - 1
if i >= 0:
this.vals.set(i, v)
ret i
end
n := this.keys.len()
this.keys.push(k)
this.vals.push(v)
this.idx.put(k, n + 1)
ret n
end
@en "key_at"
@fa "کلید در"
pub func key_at(i: int): str:
if i < 0 or i >= this.keys.len(): ret "" end
ret this.keys.get(i)
end
@en "val_at"
@fa "مقدار در"
pub func val_at(i: int): str:
if i < 0 or i >= this.vals.len(): ret "" end
ret this.vals.get(i)
end
@en "set_at"
@fa "تنظیم در"
pub func set_at(i: int, v: str):
if i < 0 or i >= this.vals.len(): ret end
this.vals.set(i, v)
end
@en "remove"
@fa "حذف"
pub func remove(k: str): int:
i := this.idx.get(k) - 1
if i < 0: ret 0 - 1 end
this.keys.remove_at(i)
this.vals.remove_at(i)
this.idx.remove(k)
mut j := i
until j < this.keys.len():
this.idx.put(this.keys.get(j), j + 1)
j++
end
ret i
end
@en "clone_keys"
@fa "رونوشت کلیدها"
pub func clone_keys(): Vector<str>: ret clone(this.keys) end
@en "iter"
@fa "پیمایش"
pub func iter(): OrderedMapIter:
mut it := OrderedMapIter {}
it.keys = this.keys
it.vals = this.vals
ret it
end
@en "free"
@fa "آزادسازی"
pub func free():
this.keys.free()
this.vals.free()
this.idx.free()
end
end
@en "OrderedMapIter"
@fa "پیمایشگر نگاشت مرتب"
pub struct OrderedMapIter:
@en "keys"
@fa "کلیدها"
pub keys: Vector<str> = Vector {}
@en "vals"
@fa "مقدارها"
pub vals: Vector<str> = Vector {}
@en "pos"
@fa "جایگاه"
pub pos: int = 0
@en "has_next"
@fa "بعدی دارد"
pub func has_next(): bool: ret this.pos < this.keys.len() end
@en "key"
@fa "کلید"
pub func key(): str: ret this.keys.get(this.pos) end
@en "value"
@fa "مقدار"
pub func value(): str: ret this.vals.get(this.pos) end
@en "next"
@fa "بعدی"
pub func next(): this.pos++ end
end
package collections
@en "Pair"
@fa "زوج"
pub struct Pair<A, B>:
@en "first"
@fa "نخست"
pub first: A
@en "second"
@fa "دوم"
pub second: B
end
package collections
@en "PriorityQueue"
@fa "صف اولویت دار"
pub struct PriorityQueue<T>:
@en "h"
@fa "هرم"
pub h: Vector<T> = Vector {}
pub func _swap(i: int, j: int):
a := this.h.get(i)
b := this.h.get(j)
this.h.set(i, b)
this.h.set(j, a)
end
@en "push"
@fa "افزودن"
pub func push(x: T):
this.h.push(x)
mut i := this.h.len() - 1
mut go := true
until go:
if i == 0:
go = false
else:
p := (i - 1) / 2
if this.h.get(i) < this.h.get(p):
this._swap(i, p)
i = p
else:
go = false
end
end
end
end
@en "peek"
@fa "مشاهده"
pub func peek(): T: ret this.h.get(0) end
@en "size"
@fa "اندازه"
pub func size(): int: ret this.h.len() end
@en "is_empty"
@fa "خالی است"
pub func is_empty(): bool: ret this.h.len() == 0 end
@en "pop"
@fa "برداشتن"
pub func pop(): T:
if SALAM_SAFE:
if this.h.len() == 0: salam_panic("PriorityQueue.pop: empty") end
end
n := this.h.len()
top := this.h.get(0)
last := this.h.pop()
if n > 1:
this.h.set(0, last)
mut i := 0
mut go := true
until go:
l := 2 * i + 1
r := 2 * i + 2
mut sm := i
if l < this.h.len() and this.h.get(l) < this.h.get(sm): sm = l end
if r < this.h.len() and this.h.get(r) < this.h.get(sm): sm = r end
if sm == i: go = false
else:
this._swap(i, sm)
i = sm
end
end
end
ret top
end
@en "free"
@fa "آزادسازی"
pub func free(): this.h.free() end
end
package collections
@en "Queue"
@fa "صف"
pub struct Queue<T>:
@en "inbox"
@fa "ورودی‌ها"
pub inbox: Vector<T> = Vector {}
@en "outbox"
@fa "خروجی‌ها"
pub outbox: Vector<T> = Vector {}
pub func _shift():
if this.outbox.len() == 0:
until this.inbox.len() > 0: this.outbox.push(this.inbox.pop()) end
end
end
@en "enqueue"
@fa "وارد کردن"
pub func enqueue(x: T): this.inbox.push(x) end
@en "dequeue"
@fa "خارج کردن"
pub func dequeue(): T:
this._shift()
ret this.outbox.pop()
end
@en "peek"
@fa "مشاهده"
pub func peek(): T:
this._shift()
ret this.outbox.last()
end
@en "size"
@fa "اندازه"
pub func size(): int: ret this.inbox.len() + this.outbox.len() end
@en "iter"
@fa "پیمایش"
pub func iter(): QueueIter<T>:
it := QueueIter {} as QueueIter<T> it.outbox = this.outbox
it.inbox = this.inbox
ret it
end
@en "is_empty"
@fa "خالی است"
pub func is_empty(): bool: ret this.size() == 0 end
@en "free"
@fa "آزادسازی"
pub func free():
this.inbox.free()
this.outbox.free()
end
end
@en "QueueIter"
@fa "پیمایشگر صف"
pub struct QueueIter<T>:
@en "outbox"
@fa "خروجی‌ها"
pub outbox: Vector<T> = Vector {}
@en "inbox"
@fa "ورودی‌ها"
pub inbox: Vector<T> = Vector {}
@en "pos"
@fa "جایگاه"
pub pos: int = 0
@en "has_next"
@fa "بعدی دارد"
pub func has_next(): bool: ret this.pos < this.outbox.len() + this.inbox.len() end
@en "value"
@fa "مقدار"
pub func value(): T:
n := this.outbox.len()
if this.pos < n: ret this.outbox.get(n - 1 - this.pos) end
ret this.inbox.get(this.pos - n)
end
@en "next"
@fa "بعدی"
pub func next(): this.pos++ end
end
package collections
@en "Set"
@fa "مجموعه"
pub struct Set<T>:
@en "m"
@fa "نگاشت"
pub m: HashMap<T, bool> = HashMap {}
@en "add"
@fa "افزودن"
pub func add(x: T): this.m.put(x, true) end
@en "has"
@fa "دارد"
pub func has(x: T): bool: ret this.m.has(x) end
@en "remove"
@fa "حذف"
pub func remove(x: T): bool: ret this.m.remove(x) end
@en "size"
@fa "اندازه"
pub func size(): int: ret this.m.size() end
@en "is_empty"
@fa "خالی است"
pub func is_empty(): bool: ret this.m.is_empty() end
@en "iter"
@fa "پیمایش"
pub func iter(): SetIter<T>:
it := SetIter {} as SetIter<T> it.inner = this.m.iter()
ret it
end
@en "free"
@fa "آزادسازی"
pub func free(): this.m.free() end
end
@en "SetIter"
@fa "پیمایشگر مجموعه"
pub struct SetIter<T>:
@en "inner"
@fa "پیمایشگر درونی"
pub inner: MapIter<T, bool> = MapIter {}
@en "has_next"
@fa "بعدی دارد"
pub func has_next(): bool: ret this.inner.has_next() end
@en "value"
@fa "مقدار"
pub func value(): T: ret this.inner.key() end
@en "next"
@fa "بعدی"
pub func next(): this.inner.next() end
end
package collections
@en "Stack"
@fa "پشته"
pub struct Stack<T>:
@en "items"
@fa "عضوها"
pub items: Vector<T> = Vector {}
@en "push"
@fa "افزودن"
pub func push(x: T): this.items.push(x) end
@en "pop"
@fa "برداشتن"
pub func pop(): T: ret this.items.pop() end
@en "peek"
@fa "مشاهده"
pub func peek(): T: ret this.items.last() end
@en "size"
@fa "اندازه"
pub func size(): int: ret this.items.len() end
@en "iter"
@fa "پیمایش"
pub func iter(): StackIter<T>:
it := StackIter {} as StackIter<T> it.items = this.items
ret it
end
@en "is_empty"
@fa "خالی است"
pub func is_empty(): bool: ret this.items.is_empty() end
@en "clear"
@fa "پاک‌سازی"
pub func clear(): this.items.clear() end
@en "free"
@fa "آزادسازی"
pub func free(): this.items.free() end
end
@en "StackIter"
@fa "پیمایشگر پشته"
pub struct StackIter<T>:
@en "items"
@fa "عضوها"
pub items: Vector<T> = Vector {}
@en "pos"
@fa "جایگاه"
pub pos: int = 0
@en "has_next"
