s2 := r2 * (5 as u32)
s3 := r3 * (5 as u32)
s4 := r4 * (5 as u32)
mut h0 := st.h[0]
mut h1 := st.h[1]
mut h2 := st.h[2]
mut h3 := st.h[3]
mut h4 := st.h[4]
