@en "memo"
@fa "یادداشت چهره"
pub memo: HashMap<str, int> = HashMap {}
end
func _fc_read(fp: void*, off: int, n: int): void*:
if n <= 0 or n > 64 * 1024 * 1024 or off < 0:
ret null
end
if fseek(fp, off, 0) != 0:
ret null
end
buf := mem.AllocateZeroed(n as u64)
got := fread(buf, 1 as u64, n as u64, fp)
if (got as int) != n:
mem.Free(buf)
ret null
end
ret buf
end
func _fc_be32(p: void*, off: int): int:
ret _ttf_u32(p, off + 4, off)
end
func _fc_meta(fp: void*, dir_off: int, face &: FontFace): bool:
hdr := _fc_read(fp, dir_off, 12)
if hdr == null:
ret false
end
ver := _ttf_u32(hdr, 12, 0)
nt := _ttf_u16(hdr, 12, 4)
mem.Free(hdr)
if ver != _TTF_SFNT_10 and ver != _TTF_SFNT_TRUE:
ret false
end
dir := _fc_read(fp, dir_off + 12, nt * 16)
if dir == null:
ret false
end
dn := nt * 16
mut name_off := 0
mut name_len := 0
mut os2_off := 0
mut os2_len := 0
mut head_off := 0
mut head_len := 0
mut glyf := false
mut i := 0
until i < nt:
tag := _ttf_u32(dir, dn, i * 16)
o := _ttf_u32(dir, dn, i * 16 + 8)
l := _ttf_u32(dir, dn, i * 16 + 12)
if tag == _TTF_TAG_NAME:
name_off = o
name_len = l
end
if tag == _TTF_TAG_OS2:
os2_off = o
os2_len = l
end
if tag == _TTF_TAG_HEAD:
head_off = o
head_len = l
end
if tag == _TTF_TAG_GLYF:
glyf = true
end
i++
end
mem.Free(dir)
if not glyf or name_len <= 0:
ret false
end
total := 4 + name_len + os2_len + head_len
buf := mem.AllocateZeroed(total as u64)
mut f := Font {}
f.data = buf
f.size = total
f.ok = true
f.units_per_em = 1
mut good := true
nb := _fc_read(fp, name_off, name_len)
if nb == null:
good = false
else:
mem.Copy(((buf as i64) + (4 as i64)) as void*, nb, name_len as u64)
mem.Free(nb)
f.name = 4
end
if good and os2_len > 0:
ob := _fc_read(fp, os2_off, os2_len)
if ob != null:
mem.Copy(((buf as i64) + ((4 + name_len) as i64)) as void*, ob, os2_len as u64)
mem.Free(ob)
f.os2 = 4 + name_len
end
end
if good and head_len > 0:
hb := _fc_read(fp, head_off, head_len)
if hb != null:
mem.Copy(((buf as i64) + ((4 + name_len + os2_len) as i64)) as void*, hb, head_len as u64)
mem.Free(hb)
f.head = 4 + name_len + os2_len
end
end
if good:
face.family = FamilyName(f)
face.style = StyleName(f)
face.weight = Weight(f)
face.italic = IsItalic(f)
end
mem.Free(buf)
ret good and str.Len(face.family) > 0
end
func _fc_scan_file(fc &: FontCollection, path: str): int:
fp := fopen(path, "rb")
if fp == null:
ret 0
end
head := _fc_read(fp, 0, 12)
if head == null:
fclose(fp)
ret 0
end
mut offsets := Vector {} as Vector<int>
defer offsets.free()
if _ttf_u32(head, 12, 0) == _TTF_SFNT_TTCF:
n := _ttf_u32(head, 12, 8)
if n > 0 and n < 256:
tab := _fc_read(fp, 12, n * 4)
if tab != null:
mut k := 0
until k < n:
offsets.push(_ttf_u32(tab, n * 4, k * 4))
k++
end
mem.Free(tab)
end
end
else:
offsets.push(0)
end
mem.Free(head)
mut added := 0
mut k := 0
until k < offsets.len():
mut face := FontFace {}
face.path = path
face.index = k
if _fc_meta(fp, offsets.get(k), face):
fc.faces.push(face)
added++
end
k++
end
fclose(fp)
ret added
end
func _fc_is_font_name(p: str): bool:
l := str.Lower(p)
ok := str.EndsWith(l, ".ttf") or str.EndsWith(l, ".ttc") or str.EndsWith(l, ".otf") or str.EndsWith(l, ".otc")
mem.Free(l as void*)
ret ok
end
func _fc_sort(v &: Vector<str>):
mut i := 1
until i < v.len():
x := v.get(i)
mut j := i
until j > 0 and str.Compare(v.get(j - 1), x) > 0:
v.set(j, v.get(j - 1))
j--
end
v.set(j, x)
i++
end
end
func _fc_family_list(families: str, out &: Vector<str>):
parts := str.Split(families, ",")
each p in parts:
mut t := str.Trim(p)
if str.StartsWith(t, "\"") or str.StartsWith(t, "'"):
t = str.Substr(t, 1, str.Len(t) - 2)
end
if str.Len(t) > 0:
out.push(t)
end
end
parts.free()
end
func _fc_generic(name: str, out &: Vector<str>): bool:
l := str.Lower(name)
defer mem.Free(l as void*)
if str.Equals(l, "sans-serif") or str.Equals(l, "system-ui") or str.Equals(l, "ui-sans-serif"):
_fc_family_list("Vazirmatn, Segoe UI, Arial, Helvetica, Noto Sans, DejaVu Sans, Liberation Sans, Tahoma", out)
ret true
end
if str.Equals(l, "serif") or str.Equals(l, "ui-serif"):
_fc_family_list("Noto Serif, Times New Roman, Times, DejaVu Serif, Liberation Serif, Noto Naskh Arabic", out)
ret true
end
if str.Equals(l, "monospace") or str.Equals(l, "ui-monospace"):
_fc_family_list("DejaVu Sans Mono, Consolas, Menlo, Liberation Mono, Noto Sans Mono, Courier New", out)
ret true
end
ret false
end
func _fc_script_fallback(sc: int, out &: Vector<str>):
if sc == unicode.ScriptArabic:
_fc_family_list("Vazirmatn, Noto Naskh Arabic, Noto Sans Arabic, Segoe UI, Tahoma, Geeza Pro, Arial, DejaVu Sans", out)
ret
end
if sc == unicode.ScriptHebrew:
_fc_family_list("Noto Sans Hebrew, Arial, Segoe UI, DejaVu Sans", out)
ret
end
if sc == unicode.ScriptHan or sc == unicode.ScriptHiragana or sc == unicode.ScriptKatakana or sc == unicode.ScriptBopomofo:
_fc_family_list("Noto Sans CJK SC, Noto Sans CJK JP, Source Han Sans, Microsoft YaHei, PingFang SC, Hiragino Sans, WenQuanYi Micro Hei, MS Gothic", out)
ret
end
if sc == unicode.ScriptHangul:
_fc_family_list("Noto Sans CJK KR, Malgun Gothic, Apple SD Gothic Neo, NanumGothic", out)
ret
end
_fc_family_list("DejaVu Sans, Segoe UI, Arial, Helvetica, Noto Sans, Liberation Sans, Segoe UI Symbol", out)
end
func _fc_reset(fc &: FontCollection):
fc.fallback.free()
fc.fallback = HashMap {} as HashMap<int, int>
each k, _ in fc.memo:
mem.Free(k as void*)
end
fc.memo.free()
fc.memo = HashMap {} as HashMap<str, int>
end
func _fc_memo_key(families: str, weight: int, italic: bool, cp: int): str:
mut b := str.NewBuilder()
str.BufAppend(b, families)
str.BufAppendChar(b, 1)
str.BufAppendInt(b, weight as i64)
str.BufAppendChar(b, italic ? 105 : 110)
str.BufAppendInt(b, cp as i64)
r := str.BufStr(b)
str.BufFree(b)
ret r
end
func _fc_load(fc &: FontCollection, i: int): bool:
mut face := fc.faces.get(i)
if face.loaded:
ret true
end
if face.failed:
ret false
end
mut ok := false
f := LoadFontIndex(face.path, face.index, ok)
if ok:
face.font = f
face.loaded = true
else:
face.failed = true
end
fc.faces.set(i, face)
ret ok
end
func _fc_covers(fc &: FontCollection, i: int, cp: int): bool:
if not _fc_load(fc, i):
ret false
end
ret GlyphIndex(fc.faces.get(i).font, cp) != 0
end
func _fc_match(fc &: FontCollection, family: str, weight: int, italic: bool, cp: int): int:
mut best := -1
mut best_score := 0
mut i := 0
until i < fc.faces.len():
face := fc.faces.get(i)
if str.EqualFold(face.family, family) and not face.failed:
mut score := 100000
if face.italic != italic:
score -= 10000
end
mut d := face.weight - weight
if d < 0:
d = 0 - d
if weight > 500:
d += 50
end
else weight <= 500:
d += 50
end
score -= d
if score > best_score and (cp < 0 or _fc_covers(fc, i, cp)):
best = i
best_score = score
end
end
i++
end
ret best
end
func _fc_face_for_cp(fc &: FontCollection, families: str, weight: int, italic: bool, cp: int): int:
mut names := Vector {} as Vector<str>
defer names.free()
_fc_family_list(families, names)
mut expanded := Vector {} as Vector<str>
defer expanded.free()
each n in names:
if not _fc_generic(n, expanded):
expanded.push(n)
end
end
each n in expanded:
r := _fc_match(fc, n, weight, italic, cp)
if r >= 0:
ret r
end
end
key := (cp << 1) | (italic ? 1 : 0)
if fc.fallback.has(key):
ret fc.fallback.get(key)
end
mut chain := Vector {} as Vector<str>
defer chain.free()
_fc_script_fallback(unicode.Script(cp), chain)
mut found := -1
each n in chain:
if found < 0:
found = _fc_match(fc, n, weight, italic, cp)
end
end
mut i := 0
until found < 0 and i < fc.faces.len():
if _fc_covers(fc, i, cp):
found = i
end
i++
end
fc.fallback.put(key, found)
ret found
end
@en "NewFontCollection"
@fa "مجموعه قلم تازه"
pub func NewFontCollection(): FontCollection:
ret FontCollection {}
end
@en "AddFont"
@fa "افزودن قلم"
pub func AddFont(fc &: FontCollection, f: Font): int:
if not FontValid(f):
ret -1
end
mut face := FontFace {}
face.family = FamilyName(f)
face.style = StyleName(f)
face.weight = Weight(f)
face.italic = IsItalic(f)
face.index = f.index
face.font = f
face.loaded = true
fc.faces.push(face)
_fc_reset(fc)
ret fc.faces.len() - 1
end
@en "AddFontBytes"
@fa "افزودن قلم از بایت‌ها"
pub func AddFontBytes(fc &: FontCollection, p: void*, n: int): int:
count := FaceCount(p, n)
mut added := 0
mut k := 0
until k < count:
mut ok := false
f := ParseFontIndex(p, n, k, ok)
if ok:
AddFont(fc, f)
added++
end
k++
end
ret added
end
@en "AddFontFile"
@fa "افزودن پرونده قلم"
pub func AddFontFile(fc &: FontCollection, path: str): int:
added := _fc_scan_file(fc, path)
if added > 0:
_fc_reset(fc)
end
ret added
end
@en "SystemFontDirs"
@fa "پوشه‌های قلم سیستم"
pub func SystemFontDirs(): Vector<str>:
mut out := Vector {} as Vector<str>
if SALAM_OS_WINDOWS:
win := os.Env("WINDIR")
if str.Len(win) > 0:
out.push(filepath.Join(win, "Fonts"))
else:
out.push("C:\\Windows\\Fonts")
end
local := os.Env("LOCALAPPDATA")
if str.Len(local) > 0:
out.push(filepath.Join(local, "Microsoft\\Windows\\Fonts"))
end
else SALAM_OS_MAC:
out.push("/System/Library/Fonts")
out.push("/Library/Fonts")
home := os.Env("HOME")
if str.Len(home) > 0:
out.push(filepath.Join(home, "Library/Fonts"))
end
else:
out.push("/usr/share/fonts")
out.push("/usr/local/share/fonts")
home := os.Env("HOME")
if str.Len(home) > 0:
out.push(filepath.Join(home, ".local/share/fonts"))
out.push(filepath.Join(home, ".fonts"))
end
xdg := os.Env("XDG_DATA_HOME")
if str.Len(xdg) > 0:
out.push(filepath.Join(xdg, "fonts"))
end
end
ret out
end
@en "AddFontDir"
@fa "افزودن پوشه قلم"
pub func AddFontDir(fc &: FontCollection, dir: str): int:
if not os.IsDir(dir):
ret 0
end
mut files := os.Walk(dir)
defer files.free()
_fc_sort(files)
mut added := 0
each p in files:
if _fc_is_font_name(p):
added += _fc_scan_file(fc, p)
end
end
if added > 0:
_fc_reset(fc)
end
ret added
end
@en "AddSystemFonts"
@fa "افزودن قلم‌های سیستم"
pub func AddSystemFonts(fc &: FontCollection): int:
mut dirs := SystemFontDirs()
defer dirs.free()
mut added := 0
each d in dirs:
added += AddFontDir(fc, d)
end
ret added
end
@en "FaceCountIn"
@fa "شمار چهره‌های مجموعه"
pub func FaceCountIn(fc: FontCollection): int:
ret fc.faces.len()
end
@en "FaceFont"
@fa "قلم چهره"
pub func FaceFont(fc &: FontCollection, face: int): Font:
if face < 0 or face >= fc.faces.len() or not _fc_load(fc, face):
ret Font {}
end
ret fc.faces.get(face).font
end
@en "FindFace"
@fa "یافتن چهره"
pub func FindFace(fc &: FontCollection, family: str, weight: int, italic: bool): int:
ret _fc_match(fc, family, weight, italic, -1)
end
@en "FaceForCodepoint"
@fa "چهره برای نویسه"
pub func FaceForCodepoint(fc &: FontCollection, families: str, weight: int, italic: bool, cp: int): int:
key := _fc_memo_key(families, weight, italic, cp)
if fc.memo.has(key):
r := fc.memo.get(key)
mem.Free(key as void*)
ret r
end
r := _fc_face_for_cp(fc, families, weight, italic, cp)
fc.memo.put(key, r)
ret r
end
@en "FreeFontCollection"
@fa "آزادسازی مجموعه قلم"
pub func FreeFontCollection(fc &: FontCollection):
mut i := 0
until i < fc.faces.len():
mut face := fc.faces.get(i)
if face.loaded:
FreeFont(face.font)
end
i++
end
fc.faces.free()
_fc_reset(fc)
fc.fallback.free()
fc.memo.free()
fc.faces = Vector {} as Vector<FontFace>
fc.fallback = HashMap {} as HashMap<int, int>
fc.memo = HashMap {} as HashMap<str, int>
end
package typeset
import str
struct _Unit:
pub s: int = 0
pub e: int = 0
pub left: int = 0
pub right: int = 0
pub rtl: bool = false
end
@en "TextPosition"
@fa "جای متن"
pub struct TextPosition:
@en "offset"
@fa "جابجایی"
pub offset: int = 0
@en "upstream"
@fa "وابسته به پیش"
pub upstream: bool = false
@en "line"
@fa "خط"
pub line: int = 0
end
@en "TextRect"
@fa "مستطیل متن"
pub struct TextRect:
@en "x"
@fa "ایکس"
pub x: f64 = 0.0
@en "y"
@fa "ایگرگ"
pub y: f64 = 0.0
@en "width"
@fa "پهنا"
pub width: f64 = 0.0
@en "height"
@fa "بلندی"
pub height: f64 = 0.0
end
func _cp_offset(p: Paragraph, k: int): int:
if k >= p.chars.len():
ret str.Len(p.text)
end
ret p.chars.get(k).offset
end
func _cp_at_offset(p: Paragraph, off: int): int:
mut lo := 0
mut hi := p.chars.len()
until lo < hi:
mid := (lo + hi) / 2
if p.chars.get(mid).offset < off:
lo = mid + 1
else:
hi = mid
end
end
ret lo
end
func _line_units(p: Paragraph, l: TextLayout, li: int, out &: Vector<_Unit>):
out.clear()
if li < 0 or li >= l.lines.len():
ret
end
lb := l.lines.get(li)
collapse := not _ws_mode_pre(p.style.white_space)
mut tmp := Vector {} as Vector<_Unit>
defer tmp.free()
mut k := lb.run_start
until k < lb.run_start + lb.run_count:
gr := l.runs.get(k)
k++
if gr.ellipsis:
continue
end
trailing := gr.cp_start >= lb.trailing_cp
tmp.clear()
x0 := _to26(gr.x)
x1 := _to26(gr.x + gr.width)
mut acc := 0
mut a := gr.cp_start
until a < gr.cp_end:
b := _next_gstart(p, a, gr.cp_end)
mut w := 0
if not (trailing and collapse):
mut q := a
until q < b:
w += p.chars.get(q).advance
if lb.space_extra != 0 and _cf(p, q, _CF_SPACE) and not _cf(p, q, _CF_HIDDEN):
w += lb.space_extra
end
q++
end
end
mut u := _Unit {}
u.s = _cp_offset(p, a)
u.e = _cp_offset(p, b)
u.rtl = gr.rtl
if gr.rtl:
u.right = x1 - acc
u.left = x1 - acc - w
else:
u.left = x0 + acc
u.right = x0 + acc + w
end
acc += w
tmp.push(u)
a = b
end
if gr.rtl:
mut q := tmp.len() - 1
until q >= 0:
out.push(tmp.get(q))
q--
end
else:
each u in tmp:
out.push(u)
end
end
end
end
func _left_edge(u: _Unit): int:
ret u.rtl ? u.e : u.s
end
func _right_edge(u: _Unit): int:
ret u.rtl ? u.s : u.e
end
func _line_for(l: TextLayout, off: int, upstream: bool): int:
n := l.lines.len()
mut li := 0
until li < n:
lb := l.lines.get(li)
if off >= lb.start and off < lb.end:
if off == lb.start and upstream and li > 0 and not l.lines.get(li - 1).hard_break and l.lines.get(li - 1).end == off:
ret li - 1
end
ret li
end
if off == lb.end and (li == n - 1 or (upstream and not lb.hard_break)):
ret li
end
li++
end
ret n - 1
end
func _caret_x(p: Paragraph, l: TextLayout, li: int, off: int, upstream: bool): int:
mut units := Vector {} as Vector<_Unit>
defer units.free()
_line_units(p, l, li, units)
lb := l.lines.get(li)
if upstream:
each u in units:
if u.e == off:
ret u.rtl ? u.left : u.right
end
end
end
each u in units:
if u.s == off:
ret u.rtl ? u.right : u.left
end
end
each u in units:
if u.e == off:
ret u.rtl ? u.left : u.right
end
end
if lb.rtl:
ret _to26(lb.x + lb.width)
end
ret _to26(lb.x)
end
@en "HitTest"
@fa "آزمون برخورد"
pub func HitTest(p: Paragraph, l: TextLayout, x: f64, y: f64): TextPosition:
mut pos := TextPosition {}
n := l.lines.len()
if n == 0:
ret pos
end
mut li := 0
until li < n - 1 and y >= l.lines.get(li).top + l.lines.get(li).height:
li++
end
pos.line = li
lb := l.lines.get(li)
mut units := Vector {} as Vector<_Unit>
defer units.free()
_line_units(p, l, li, units)
if units.len() == 0:
pos.offset = lb.start
ret pos
end
x26 := _to26(x)
mut chosen := 0
first := units.get(0)
last := units.get(units.len() - 1)
if x26 < first.left:
chosen = _left_edge(first)
else x26 >= last.right:
chosen = _right_edge(last)
else:
mut i := 0
until i < units.len():
u := units.get(i)
if x26 >= u.left and x26 < u.right:
if (x26 - u.left) * 2 < (u.right - u.left):
chosen = _left_edge(u)
else:
chosen = _right_edge(u)
end
break
end
i++
end
end
if lb.hard_break and chosen == lb.end:
chosen = _cp_offset(p, lb.cp_end - 1)
end
pos.offset = chosen
pos.upstream = chosen == lb.end and li < n - 1
ret pos
end
@en "CaretRect"
@fa "مستطیل نشانگر"
pub func CaretRect(p: Paragraph, l: TextLayout, pos: TextPosition): TextRect:
mut r := TextRect {}
if l.lines.len() == 0:
ret r
end
li := _line_for(l, pos.offset, pos.upstream)
lb := l.lines.get(li)
r.x = _from26(_caret_x(p, l, li, pos.offset, pos.upstream))
r.y = lb.top
r.height = lb.height
ret r
end
@en "SelectionRects"
@fa "مستطیل‌های گزینش"
pub func SelectionRects(p: Paragraph, l: TextLayout, from: int, to_offset: int): Vector<TextRect>:
mut out := Vector {} as Vector<TextRect>
mut a := from
mut b := to_offset
if b < a:
a = to_offset
b = from
end
if a == b:
ret out
end
mut units := Vector {} as Vector<_Unit>
defer units.free()
mut li := 0
until li < l.lines.len():
lb := l.lines.get(li)
if lb.end > a and lb.start < b:
_line_units(p, l, li, units)
mut have := false
mut x0 := 0
mut x1 := 0
each u in units:
inside := u.s >= a and u.e <= b and u.e > u.s
if inside and have and u.left == x1:
x1 = u.right
else inside:
if have:
mut rr := TextRect {}
rr.x = _from26(x0)
rr.y = lb.top
rr.width = _from26(x1 - x0)
rr.height = lb.height
out.push(rr)
end
x0 = u.left
x1 = u.right
have = true
end
end
if have:
mut rr := TextRect {}
rr.x = _from26(x0)
rr.y = lb.top
rr.width = _from26(x1 - x0)
rr.height = lb.height
out.push(rr)
end
end
li++
end
ret out
end
@en "NextGrapheme"
@fa "خوشه بعدی"
pub func NextGrapheme(p: Paragraph, offset: int): int:
n := p.chars.len()
mut k := _cp_at_offset(p, offset)
if k < n and p.chars.get(k).offset == offset:
k++
end
until k < n and not _cf(p, k, _CF_GSTART):
k++
end
ret _cp_offset(p, k)
end
@en "PrevGrapheme"
@fa "خوشه پیشین"
pub func PrevGrapheme(p: Paragraph, offset: int): int:
mut k := _cp_at_offset(p, offset) - 1
until k > 0 and not _cf(p, k, _CF_GSTART):
k--
end
if k < 0:
ret 0
end
ret _cp_offset(p, k)
end
@en "NextWordEnd"
@fa "انتهای واژه بعدی"
pub func NextWordEnd(p: Paragraph, offset: int): int:
n := p.chars.len()
mut k := _cp_at_offset(p, offset)
until k < n and not _cf(p, k, _CF_WORD):
k++
end
until k < n and _cf(p, k, _CF_WORD):
k++
end
ret _cp_offset(p, k)
end
@en "PrevWordStart"
@fa "آغاز واژه پیشین"
pub func PrevWordStart(p: Paragraph, offset: int): int:
mut k := _cp_at_offset(p, offset)
until k > 0 and not _cf(p, k - 1, _CF_WORD):
k--
end
until k > 0 and _cf(p, k - 1, _CF_WORD):
k--
end
ret _cp_offset(p, k)
end
@en "MoveVisual"
@fa "جابجایی دیداری"
pub func MoveVisual(p: Paragraph, l: TextLayout, pos: TextPosition, right: bool): TextPosition:
mut out := pos
n := l.lines.len()
if n == 0:
ret out
end
li := _line_for(l, pos.offset, pos.upstream)
lb := l.lines.get(li)
x := _caret_x(p, l, li, pos.offset, pos.upstream)
mut units := Vector {} as Vector<_Unit>
defer units.free()
_line_units(p, l, li, units)
out.line = li
if right:
each u in units:
if u.left >= x and u.right > u.left:
if u.rtl:
out.offset = u.s
out.upstream = false
else:
out.offset = u.e
out.upstream = true
end
ret out
end
end
else:
mut i := units.len() - 1
until i >= 0:
u := units.get(i)
if u.right <= x and u.right > u.left:
if u.rtl:
out.offset = u.e
out.upstream = true
else:
out.offset = u.s
out.upstream = false
end
ret out
end
i--
end
end
forward := right != lb.rtl
if forward and li + 1 < n:
out.offset = l.lines.get(li + 1).start
out.upstream = false
out.line = li + 1
else not forward and li > 0:
prev := l.lines.get(li - 1)
out.offset = prev.hard_break ? _cp_offset(p, prev.cp_end - 1) : prev.end
out.upstream = not prev.hard_break
out.line = li - 1
end
ret out
end
package typeset
import str
@en "FontMetrics"
@fa "متریک قلم"
pub struct FontMetrics:
@en "units_per_em"
@fa "واحد ام"
pub units_per_em: int = 0
@en "ascent"
@fa "صعود"
pub ascent: int = 0
@en "descent"
@fa "نزول"
pub descent: int = 0
@en "line_gap"
@fa "فاصله سطرها"
pub line_gap: int = 0
@en "x_height"
@fa "ارتفاع ایکس"
pub x_height: int = 0
@en "cap_height"
@fa "ارتفاع حرف بزرگ"
pub cap_height: int = 0
@en "underline_position"
@fa "جای زیرخط"
pub underline_position: int = 0
@en "underline_thickness"
@fa "ضخامت زیرخط"
pub underline_thickness: int = 0
end
func _name_score(plat: int, enc: int, lang: int): int:
if plat == 3 and (enc == 1 or enc == 10) and lang == 0x409: ret 5 end
if plat == 3 and (enc == 1 or enc == 10): ret 4 end
if plat == 0: ret 3 end
if plat == 1 and enc == 0 and lang == 0: ret 2 end
if plat == 1 and enc == 0: ret 1 end
ret 0
end
func _name_decode(f: Font, at: int, len: int, utf16: bool): str:
mut sb := str.NewBuilder()
defer str.BufFree(sb)
if utf16:
mut i := 0
until i + 1 < len:
mut cp := _ttf_u16(f.data, f.size, at + i)
i += 2
if cp >= 0xD800 and cp < 0xDC00 and i + 1 < len:
lo := _ttf_u16(f.data, f.size, at + i)
if lo >= 0xDC00 and lo < 0xE000:
cp = 0x10000 + ((cp - 0xD800) << 10) + (lo - 0xDC00)
i += 2
end
end
if cp != 0:
str.BufAppendCp(sb, cp)
end
end
else:
mut i := 0
until i < len:
b := _ttf_u8(f.data, f.size, at + i)
if b != 0:
str.BufAppendCp(sb, b < 128 ? b : 0xFFFD)
end
i++
end
end
ret str.BufStr(sb)
end
func _os2_u16(f: Font, off: int): int:
if f.os2 == 0:
ret 0
end
ret _ttf_u16(f.data, f.size, f.os2 + off)
end
func _os2_i16(f: Font, off: int): int:
if f.os2 == 0:
ret 0
end
ret _ttf_i16(f.data, f.size, f.os2 + off)
end
func _glyph_top(f: Font, cp: int): int:
mut x0 := 0
mut y0 := 0
mut x1 := 0
mut y1 := 0
if GlyphBox(f, GlyphIndex(f, cp), x0, y0, x1, y1):
ret y1
end
ret 0
end
@en "NameString"
@fa "متن نام"
pub func NameString(f: Font, name_id: int): str:
if not FontValid(f) or f.name == 0:
ret ""
end
count := _ttf_u16(f.data, f.size, f.name + 2)
strings := f.name + _ttf_u16(f.data, f.size, f.name + 4)
mut best := -1
mut best_score := 0
mut i := 0
until i < count:
rec := f.name + 6 + i * 12
if _ttf_u16(f.data, f.size, rec + 6) == name_id:
sc := _name_score(_ttf_u16(f.data, f.size, rec), _ttf_u16(f.data, f.size, rec + 2), _ttf_u16(f.data, f.size, rec + 4))
if sc > best_score:
best_score = sc
best = rec
end
end
i++
end
if best < 0:
ret ""
end
plat := _ttf_u16(f.data, f.size, best)
ln := _ttf_u16(f.data, f.size, best + 8)
at := strings + _ttf_u16(f.data, f.size, best + 10)
ret _name_decode(f, at, ln, plat != 1)
end
@en "FamilyName"
@fa "نام خانواده"
pub func FamilyName(f: Font): str:
typo := NameString(f, 16)
if str.Len(typo) > 0:
ret typo
end
ret NameString(f, 1)
end
@en "StyleName"
@fa "نام سبک قلم"
pub func StyleName(f: Font): str:
typo := NameString(f, 17)
if str.Len(typo) > 0:
ret typo
end
ret NameString(f, 2)
end
@en "FullName"
@fa "نام کامل قلم"
pub func FullName(f: Font): str:
ret NameString(f, 4)
end
@en "Weight"
@fa "وزن قلم"
pub func Weight(f: Font): int:
w := _os2_u16(f, 4)
if w >= 1 and w <= 1000:
ret w
end
if f.head != 0 and (_ttf_u16(f.data, f.size, f.head + 44) & 1) != 0:
ret 700
end
ret 400
end
@en "IsItalic"
@fa "مورب است"
pub func IsItalic(f: Font): bool:
if f.os2 != 0:
ret (_os2_u16(f, 62) & 0x201) != 0
end
if f.head != 0:
ret (_ttf_u16(f.data, f.size, f.head + 44) & 2) != 0
end
ret false
end
@en "Metrics"
@fa "متریک‌ها"
pub func Metrics(f: Font): FontMetrics:
mut m := FontMetrics {}
if not FontValid(f):
ret m
end
m.units_per_em = f.units_per_em
m.ascent = f.ascent
m.descent = 0 - f.descent
m.line_gap = f.line_gap
if f.os2 != 0:
use_typo := (_os2_u16(f, 62) & 0x80) != 0
hhea_zero := f.hhea == 0 or (_ttf_i16(f.data, f.size, f.hhea + 4) == 0 and _ttf_i16(f.data, f.size, f.hhea + 6) == 0)
if use_typo or hhea_zero:
ta := _os2_i16(f, 68)
td := _os2_i16(f, 70)
if ta != 0 or td != 0:
m.ascent = ta
m.descent = 0 - td
m.line_gap = _os2_i16(f, 72)
else:
m.ascent = _os2_u16(f, 74)
m.descent = _os2_u16(f, 76)
m.line_gap = 0
end
end
if _os2_u16(f, 0) >= 2:
m.x_height = _os2_i16(f, 86)
m.cap_height = _os2_i16(f, 88)
end
end
if m.x_height <= 0:
m.x_height = _glyph_top(f, 0x78)
end
if m.cap_height <= 0:
m.cap_height = _glyph_top(f, 0x48)
end
if f.post != 0:
m.underline_position = _ttf_i16(f.data, f.size, f.post + 8)
m.underline_thickness = _ttf_i16(f.data, f.size, f.post + 10)
end
if m.underline_thickness <= 0:
m.underline_thickness = f.units_per_em / 14
m.underline_position = 0 - f.units_per_em / 10
end
ret m
end
@en "FaceCount"
@fa "شمار چهره‌ها"
pub func FaceCount(p: void*, n: int): int:
if p == null or n < 12:
ret 0
end
if _ttf_u32(p, n, 0) == _TTF_SFNT_TTCF:
ret _ttf_u32(p, n, 8)
end
ret 1
end
package typeset
import math
const _TTF_SUBSAMPLES := 4
struct _Edge:
pub x0: f64 = 0.0
pub y0: f64 = 0.0
pub x1: f64 = 0.0
pub y1: f64 = 0.0
pub dir: int = 0
end
struct _Cross:
pub x: f64 = 0.0
pub dir: int = 0
end
@en "CoverageRows"
@fa "سطرهای پوشش"
pub struct CoverageRows:
@en "x"
@fa "ایکس"
pub x: int = 0
@en "y"
@fa "ایگرگ"
pub y: int = 0
@en "width"
@fa "پهنا"
pub width: int = 0
@en "height"
@fa "بلندی"
pub height: int = 0
@en "values"
@fa "مقدارها"
pub values: Vector<f64> = Vector {}
end
func _ttf_clampi(v: int, lo: int, hi: int): int:
if v < lo: ret lo end
if v > hi: ret hi end
ret v
end
func _edge_push(edges &: Vector<_Edge>, x0: f64, y0: f64, x1: f64, y1: f64):
if y0 == y1:
ret
end
mut e := _Edge {}
if y0 < y1:
e.x0 = x0
e.y0 = y0
e.x1 = x1
e.y1 = y1
e.dir = 1
else:
e.x0 = x1
e.y0 = y1
e.x1 = x0
e.y1 = y0
e.dir = 0 - 1
end
edges.push(e)
end
func _quad_to(edges &: Vector<_Edge>, x0: f64, y0: f64, cx: f64, cy: f64, x1: f64, y1: f64):
d := math.Abs(cx - x0) + math.Abs(cy - y0) + math.Abs(x1 - cx) + math.Abs(y1 - cy)
mut n := 2 + (d / 3.0) as int
if n > 32:
n = 32
end
mut px := x0
mut py := y0
mut i := 1
until i <= n:
t := (i as f64) / (n as f64)
mt := 1.0 - t
qx := mt * mt * x0 + 2.0 * mt * t * cx + t * t * x1
qy := mt * mt * y0 + 2.0 * mt * t * cy + t * t * y1
_edge_push(edges, px, py, qx, qy)
px = qx
py = qy
i++
end
end
func _contour_edges(pts &: Vector<OutlinePoint>, s: int, e: int, edges &: Vector<_Edge>):
if e - s < 2:
ret
end
p0 := pts.get(s)
plast := pts.get(e - 1)
mut startx := 0.0
mut starty := 0.0
mut lo := s
mut hi := e - 1
if p0.on:
startx = p0.x
starty = p0.y
lo = s + 1
else if plast.on:
startx = plast.x
starty = plast.y
hi = e - 2
else:
startx = (p0.x + plast.x) * 0.5
starty = (p0.y + plast.y) * 0.5
end
mut cx := startx
mut cy := starty
mut ctrlx := 0.0
mut ctrly := 0.0
mut have_ctrl := false
mut i := lo
until i <= hi:
p := pts.get(i)
if p.on:
if have_ctrl:
_quad_to(edges, cx, cy, ctrlx, ctrly, p.x, p.y)
have_ctrl = false
else:
_edge_push(edges, cx, cy, p.x, p.y)
end
cx = p.x
cy = p.y
else:
if have_ctrl:
mx := (ctrlx + p.x) * 0.5
my := (ctrly + p.y) * 0.5
_quad_to(edges, cx, cy, ctrlx, ctrly, mx, my)
cx = mx
cy = my
end
ctrlx = p.x
ctrly = p.y
have_ctrl = true
end
i++
end
if have_ctrl:
_quad_to(edges, cx, cy, ctrlx, ctrly, startx, starty)
else:
_edge_push(edges, cx, cy, startx, starty)
end
end
func _build_edges(pts &: Vector<OutlinePoint>, ends &: Vector<int>, edges &: Vector<_Edge>):
mut s := 0
mut k := 0
until k < ends.len():
e := ends.get(k)
if e > s and e <= pts.len():
_contour_edges(pts, s, e, edges)
end
s = e
k++
end
end
func _add_span(acc &: Vector<f64>, xoff: int, w: int, xa: f64, xb: f64, weight: f64):
mut a := xa - (xoff as f64)
mut b := xb - (xoff as f64)
if a < 0.0:
a = 0.0
end
if b > (w as f64):
b = w as f64
end
if b <= a:
ret
end
ia := a as int
mut ib := b as int
if ib >= w:
ib = w - 1
end
if ia >= w or ib < ia:
ret
end
if ia == ib:
acc.set(ia, acc.get(ia) + (b - a) * weight)
ret
end
acc.set(ia, acc.get(ia) + (((ia + 1) as f64) - a) * weight)
mut i := ia + 1
until i < ib:
acc.set(i, acc.get(i) + weight)
i++
end
acc.set(ib, acc.get(ib) + (b - (ib as f64)) * weight)
end
func _accumulate_spans(xs &: Vector<_Cross>, acc &: Vector<f64>, xoff: int, w: int, weight: f64):
mut wind := 0
mut spanx := 0.0
mut i := 0
until i < xs.len():
cr := xs.get(i)
prev := wind
wind += cr.dir
if prev == 0 and wind != 0:
spanx = cr.x
else if prev != 0 and wind == 0:
_add_span(acc, xoff, w, spanx, cr.x, weight)
end
i++
end
end
func _gr_msort(idx &: Vector<int>, keys &: Vector<f64>, tmp &: Vector<int>, lo: int, hi: int):
if hi - lo < 2:
ret
end
mid := (lo + hi) / 2
_gr_msort(idx, keys, tmp, lo, mid)
_gr_msort(idx, keys, tmp, mid, hi)
mut i := lo
mut j := mid
mut k := lo
until k < hi:
if j >= hi or (i < mid and keys.get(idx.get(i)) <= keys.get(idx.get(j))):
tmp.set(k, idx.get(i))
i++
else:
tmp.set(k, idx.get(j))
j++
end
k++
end
k = lo
until k < hi:
idx.set(k, tmp.get(k))
k++
end
end
func _gr_sort(idx &: Vector<int>, keys &: Vector<f64>, tmp &: Vector<int>):
until tmp.len() < idx.len():
tmp.push(0)
end
_gr_msort(idx, keys, tmp, 0, idx.len())
end
func _fill_edges(out &: CoverageRows, clip_w: int, clip_h: int, edges &: Vector<_Edge>):
n := edges.len()
if n == 0 or clip_w <= 0 or clip_h <= 0:
ret
end
mut minx := 1.0e30
mut maxx := 0.0 - 1.0e30
mut miny := 1.0e30
mut maxy := 0.0 - 1.0e30
mut ykeys := Vector {} as Vector<f64>
mut order := Vector {} as Vector<int>
mut i := 0
until i < n:
e := edges.get(i)
if e.x0 < minx: minx = e.x0 end
if e.x1 < minx: minx = e.x1 end
if e.x0 > maxx: maxx = e.x0 end
if e.x1 > maxx: maxx = e.x1 end
if e.y0 < miny: miny = e.y0 end
if e.y1 > maxy: maxy = e.y1 end
ykeys.push(e.y0)
order.push(i)
i++
end
x0 := _ttf_clampi(math.Floor(minx) as int, 0, clip_w)
x1 := _ttf_clampi((math.Floor(maxx) as int) + 1, 0, clip_w)
y0 := _ttf_clampi(math.Floor(miny) as int, 0, clip_h)
y1 := _ttf_clampi((math.Floor(maxy) as int) + 1, 0, clip_h)
if x1 <= x0 or y1 <= y0:
ykeys.free()
order.free()
ret
end
mut tmp := Vector {} as Vector<int>
_gr_sort(order, ykeys, tmp)
w := x1 - x0
out.x = x0
out.y = y0
out.width = w
out.height = y1 - y0
out.values.zeros(w * (y1 - y0))
step := 1.0 / (_TTF_SUBSAMPLES as f64)
mut acc := Vector {} as Vector<f64>
acc.zeros(w)
mut xs := Vector {} as Vector<_Cross>
mut active := Vector {} as Vector<int>
mut xkeys := Vector {} as Vector<f64>
mut xorder := Vector {} as Vector<int>
mut sorted := Vector {} as Vector<_Cross>
mut next := 0
mut py := y0
until py < y1:
mut k := 0
until k < w:
acc.set(k, 0.0)
k++
end
mut s := 0
until s < _TTF_SUBSAMPLES:
sy := (py as f64) + ((s as f64) + 0.5) * step
until next < n and edges.get(order.get(next)).y0 <= sy:
active.push(order.get(next))
next++
end
xs.clear()
xkeys.clear()
xorder.clear()
mut keep := 0
mut a := 0
until a < active.len():
ei := active.get(a)
e := edges.get(ei)
if e.y1 > sy:
active.set(keep, ei)
keep++
if sy >= e.y0:
mut cr := _Cross {}
cr.x = e.x0 + (sy - e.y0) * (e.x1 - e.x0) / (e.y1 - e.y0)
cr.dir = e.dir
xorder.push(xs.len())
xkeys.push(cr.x)
xs.push(cr)
end
end
a++
end
until active.len() > keep:
active.pop()
end
_gr_sort(xorder, xkeys, tmp)
sorted.clear()
mut q := 0
until q < xorder.len():
sorted.push(xs.get(xorder.get(q)))
q++
end
_accumulate_spans(sorted, acc, x0, w, step)
s++
end
row := (py - y0) * w
mut q2 := 0
until q2 < w:
out.values.set(row + q2, acc.get(q2))
q2++
end
py++
end
acc.free()
xs.free()
active.free()
xkeys.free()
xorder.free()
sorted.free()
tmp.free()
ykeys.free()
order.free()
end
@en "OutlineCoverage"
@fa "پوشش طرح"
pub func OutlineCoverage(o: GlyphOutline, clip_width: int, clip_height: int): CoverageRows:
mut out := CoverageRows {}
mut edges := Vector {} as Vector<_Edge>
mut pts := o.points
mut ends := o.ends
_build_edges(pts, ends, edges)
if edges.len() <= 65536:
_fill_edges(out, clip_width, clip_height, edges)
end
edges.free()
ret out
end
@en "FreeCoverageRows"
@fa "آزادسازی سطرهای پوشش"
pub func FreeCoverageRows(c &: CoverageRows):
c.values.free()
c.values = Vector {} as Vector<f64>
c.width = 0
c.height = 0
end
