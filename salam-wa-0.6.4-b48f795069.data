salam_js_call(cpmod, "execFile", cmd, args, opts, handler)
end
@en "npy"
@fa "ان‌پی‌وای"
package npy
import archive
import compress
import encoding.binary
import matrix
import mem
@en "NPY_F64"
@fa "نوع اعشاری هشت"
pub const NPY_F64 := 0
@en "NPY_F32"
@fa "نوع اعشاری چهار"
pub const NPY_F32 := 1
@en "NPY_I8"
@fa "نوع صحیح یک"
pub const NPY_I8 := 2
@en "NPY_I16"
@fa "نوع صحیح دو"
pub const NPY_I16 := 3
@en "NPY_I32"
@fa "نوع صحیح چهار"
pub const NPY_I32 := 4
@en "NPY_I64"
@fa "نوع صحیح هشت"
pub const NPY_I64 := 5
@en "NPY_U8"
@fa "نوع بی‌علامت یک"
pub const NPY_U8 := 6
@en "NPY_U16"
@fa "نوع بی‌علامت دو"
pub const NPY_U16 := 7
@en "NPY_U32"
@fa "نوع بی‌علامت چهار"
pub const NPY_U32 := 8
@en "NPY_BOOL"
@fa "نوع دودویی"
pub const NPY_BOOL := 9
@en "NpyArray"
@fa "آرایه ان‌پی‌وای"
pub struct NpyArray:
@en "shape"
@fa "شکل"
pub shape: Vector<int> = Vector {}
@en "dtype"
@fa "نوع داده"
pub dtype: int = NPY_F64
@en "data"
@fa "عنصرها"
pub data: Vector<f64> = Vector {}
@en "ndim"
@fa "شمار بعد"
pub func ndim(): int: ret this.shape.len() end
@en "count"
@fa "شمار"
pub func count(): int: ret this.data.len() end
@en "free"
@fa "آزادسازی"
pub func free():
this.shape.free()
this.data.free()
end
end
func _elem_size(dtype: int): int:
if dtype == NPY_F64 or dtype == NPY_I64: ret 8 end
if dtype == NPY_F32 or dtype == NPY_I32 or dtype == NPY_U32: ret 4 end
if dtype == NPY_I16 or dtype == NPY_U16: ret 2 end
ret 1
end
func _read_elem(rd &: compress.ByteReader, dtype: int, big: bool): f64 throws:
if dtype == NPY_F64: ret try binary.ReadF64(rd, big) end
if dtype == NPY_F32: ret try binary.ReadF32(rd, big) end
if dtype == NPY_I8 or dtype == NPY_U8 or dtype == NPY_BOOL:
mut v := try binary.ReadU8(rd)
if dtype == NPY_I8 and v >= 128: v -= 256 end
ret v as f64
end
if dtype == NPY_I16 or dtype == NPY_U16:
mut v := 0
if big: v = try binary.ReadU16BE(rd) else:
v = try binary.ReadU16LE(rd)
end
if dtype == NPY_I16 and v >= 32768: v -= 65536 end
ret v as f64
end
if dtype == NPY_I32 or dtype == NPY_U32:
mut v := 0 as i64
if big: v = (try binary.ReadU32BE(rd)) as i64 else:
v = (try binary.ReadU32LE(rd)) as i64
end
if v < 0: v += 4294967296 end
if dtype == NPY_I32 and v >= 2147483648: v -= 4294967296 end
ret v as f64
end
if big: ret (try binary.ReadU64BE(rd)) as f64 end
ret (try binary.ReadU64LE(rd)) as f64
end
func _read_npy(p: void*, n: int): NpyArray throws:
mut a := NpyArray {}
mut rd := compress.NewByteReader(p, n)
mut dtype := 0
mut big := false
mut fortran := false
try:
_read_header(rd, dtype, big, fortran, a.shape)
catch e:
a.shape.free()
throw e
end
mut total := 1
repeat a.shape.len() in i: total *= a.shape.get(i) end
if a.shape.len() == 0: total = 1 end
esz := _elem_size(dtype)
if compress.RdLeft(rd) < total * esz:
left := compress.RdLeft(rd)
a.shape.free()
throw Error.At(ErrorKind.UnexpectedEnd, "the data ends early: " + total + " elements need " + (total * esz) + " bytes, " + left + " are left", rd.pos).with_code("npy.truncated")
end
if fortran and a.shape.len() > 2:
a.shape.free()
throw Error.New(ErrorKind.Unsupported, "Fortran order with more than 2 dimensions is not supported").with_code("npy.fortran")
end
a.dtype = dtype
a.data.alloc(total)
pd := a.data.data
if dtype == NPY_F64 and big == false and fortran == false:
src := ((rd.data as i64) + (rd.pos as i64)) as void*
mem.Copy(pd as void*, src, (total * 8) as u64)
else fortran and a.shape.len() == 2:
rows := a.shape.get(0)
cols := a.shape.get(1)
repeat cols in j:
repeat rows in i: pd[i * cols + j] = try _read_elem(rd, dtype, big) end
end
else:
repeat total in k: pd[k] = try _read_elem(rd, dtype, big) end
end
if a.shape.len() == 0: a.shape.push(1) end
ret a
end
func _read_file(path: str): compress.ByteBuf throws:
mut fok := false
mut raw := archive.ReadBinaryFile(path, fok)
if fok == false:
compress.BufFree(raw)
throw Error.New(ErrorKind.NotFound, "cannot open file").with_path(path).wrap("npy")
end
ret raw
end
@en "ReadNpy"
@fa "خواندن ان‌پی‌وای"
pub func ReadNpy(p: void*, n: int): NpyArray throws:
try:
ret _read_npy(p, n)
catch e:
throw e.wrap("npy")
end
end
@en "ReadNpyFile"
@fa "خواندن پرونده ان‌پی‌وای"
pub func ReadNpyFile(path: str): NpyArray throws:
mut raw := try _read_file(path)
defer compress.BufFree(raw)
try:
ret _read_npy(raw.data, compress.BufLen(raw))
catch e:
throw e.with_path(path).wrap("npy")
end
end
@en "WriteNpy"
@fa "نوشتن ان‌پی‌وای"
pub func WriteNpy(a &: NpyArray): compress.ByteBuf:
mut buf := compress.NewByteBuf()
_write_header(buf, a.shape)
n := a.data.len()
compress.BufPushBytes(buf, a.data.data as void*, n * 8)
ret buf
end
@en "WriteNpyFile"
@fa "نوشتن پرونده ان‌پی‌وای"
pub func WriteNpyFile(a &: NpyArray, path: str): bool:
mut buf := WriteNpy(a)
ok := archive.WriteBinaryFileBuf(path, buf)
compress.BufFree(buf)
ret ok
end
@en "ToMatrix"
@fa "به ماتریس"
pub func ToMatrix(a &: NpyArray): matrix.Matrix throws:
d := a.shape.len()
if d != 1 and d != 2:
throw Error.New(ErrorKind.InvalidArgument, "ToMatrix needs a 1-D or 2-D array, got " + d + " dimensions").with_code("npy.ndim").wrap("npy")
end
mut rows := 1
mut cols := a.shape.get(0)
if d == 2:
rows = a.shape.get(0)
cols = a.shape.get(1)
end
ret matrix.FromArray(rows, cols, a.data)
end
@en "FromMatrix"
@fa "از ماتریس"
pub func FromMatrix(m &: matrix.Matrix): NpyArray:
mut a := NpyArray {}
a.shape.push(m.rows)
a.shape.push(m.cols)
a.data.alloc(m.count())
pd := a.data.data
repeat m.count() in k: pd[k] = m.a.get(k) end
ret a
end
package npy
import compress
import conv
import encoding.binary
import mem
import str
inline pure func _bp(s: str): i8*: ret (s as void*) as i8* end
inline pure func _ub(bp: i8*, i: int): int:
mut v := bp[i] as int
if v < 0: v += 256 end
ret v
end
func _quoted_after(text: str, key: str): str:
k := str.IndexOf(text, key)
if k < 0: ret "" end
n := str.Len(text)
bp := _bp(text)
mut i := k + str.Len(key)
mut colon := false
until i < n:
c := _ub(bp, i)
if c == 58: colon = true end
if colon and (c == 39 or c == 34):
mut j := i + 1
until j < n and _ub(bp, j) != 39 and _ub(bp, j) != 34: j++ end
ret str.Substr(text, i + 1, j - i - 1)
end
i++
end
ret ""
end
func _bool_after(text: str, key: str, found &: bool): bool:
found = false
k := str.IndexOf(text, key)
if k < 0: ret false end
rest := str.Substr(text, k + str.Len(key), str.Len(text) - k - str.Len(key))
t := str.IndexOf(rest, "True")
f := str.IndexOf(rest, "False")
mem.Free(rest as void*)
if t < 0 and f < 0: ret false end
found = true
if f < 0: ret true end
if t < 0: ret false end
ret t < f
end
func _shape_after(text: str, key: str, shape_out &: Vector<int>): bool:
k := str.IndexOf(text, key)
if k < 0: ret false end
n := str.Len(text)
bp := _bp(text)
mut i := k + str.Len(key)
until i < n and _ub(bp, i) != 40: i++ end
if i >= n: ret false end
i++
mut cur := 0
mut have := false
until i < n:
c := _ub(bp, i)
if c >= 48 and c <= 57:
cur = cur * 10 + (c - 48)
have = true
else c == 44:
if have: shape_out.push(cur) end
cur = 0
have = false
else c == 41:
if have: shape_out.push(cur) end
ret true
else c != 32:
ret false
end
i++
end
ret false
end
func _descr_to_dtype(descr: str, dtype &: int, big &: bool): bool:
n := str.Len(descr)
if n < 2: ret false end
bp := _bp(descr)
mut i := 0
c0 := _ub(bp, 0)
big = false
if c0 == 60 or c0 == 124 or c0 == 61:
i = 1
else c0 == 62:
big = true
i = 1
end
if i >= n: ret false end
kind := _ub(bp, i)
mut size := 0
mut j := i + 1
until j < n:
d := _ub(bp, j)
if d < 48 or d > 57: ret false end
size = size * 10 + (d - 48)
j++
end
if kind == 102:
if size == 8: dtype = NPY_F64 ret true end
if size == 4: dtype = NPY_F32 ret true end
ret false
end
if kind == 105:
if size == 1: dtype = NPY_I8 ret true end
if size == 2: dtype = NPY_I16 ret true end
if size == 4: dtype = NPY_I32 ret true end
if size == 8: dtype = NPY_I64 ret true end
ret false
end
if kind == 117:
if size == 1: dtype = NPY_U8 ret true end
if size == 2: dtype = NPY_U16 ret true end
if size == 4: dtype = NPY_U32 ret true end
ret false
end
if kind == 98 and size == 1:
dtype = NPY_BOOL
ret true
end
ret false
end
func _npy_err(kind: ErrorKind, msg: str, at: int, code: str): Error:
ret Error.At(kind, msg, at).with_code(code)
end
func _read_header(rd &: compress.ByteReader, dtype &: int, big &: bool, fortran &: bool, shape_out &: Vector<int>) throws:
word := "NUMPY"
repeat 6 in k:
mut want := 147
if k > 0: want = _ub(_bp(word), k - 1) end
if (try binary.ReadU8(rd)) != want:
throw _npy_err(ErrorKind.Syntax, "not a .npy file (bad magic bytes)", 0, "npy.bad_magic")
end
end
major := try binary.ReadU8(rd)
try binary.ReadU8(rd)
mut hlen := 0
if major == 1:
hlen = try binary.ReadU16LE(rd)
else major == 2 or major == 3:
hlen = try binary.ReadU32LE(rd)
else:
throw _npy_err(ErrorKind.Unsupported, "unsupported .npy format version " + major, 6, "npy.version")
end
at := rd.pos
if hlen <= 0 or compress.RdLeft(rd) < hlen:
throw _npy_err(ErrorKind.UnexpectedEnd, "the header says " + hlen + " bytes but " + compress.RdLeft(rd) + " are left", at, "npy.truncated")
end
mut hb := compress.RdBytes(rd, hlen)
text := compress.BufToStrUnsafe(hb)
compress.BufFree(hb)
defer mem.Free(text as void*)
descr := _quoted_after(text, "descr")
if str.Len(descr) == 0:
throw _npy_err(ErrorKind.Syntax, "the header has no 'descr'", at, "npy.bad_header")
end
defer mem.Free(descr as void*)
if _descr_to_dtype(descr, dtype, big) == false:
throw _npy_err(ErrorKind.Unsupported, "unsupported dtype '" + descr + "'", at, "npy.dtype")
end
mut found := false
fortran = _bool_after(text, "fortran_order", found)
if found == false:
throw _npy_err(ErrorKind.Syntax, "the header has no 'fortran_order'", at, "npy.bad_header")
end
if _shape_after(text, "shape", shape_out) == false:
throw _npy_err(ErrorKind.Syntax, "the header has no valid 'shape'", at, "npy.bad_header")
end
end
func _write_header(buf &: compress.ByteBuf, shape &: Vector<int>):
mut sb := str.NewBuilder()
str.BufAppend(sb, "{'descr': '<f8', 'fortran_order': False, 'shape': (")
repeat shape.len() in i:
str.BufAppendInt(sb, shape.get(i) as i64)
if shape.len() == 1 or i + 1 < shape.len(): str.BufAppendChar(sb, 44) end
if i + 1 < shape.len(): str.BufAppendChar(sb, 32) end
end
str.BufAppend(sb, "), }")
total := 10 + (str.BufLen(sb) as int) + 1
mut pad := 0
if total % 64 != 0: pad = 64 - total % 64 end
repeat pad: str.BufAppendChar(sb, 32) end
str.BufAppendChar(sb, 10)
dict := str.BufStr(sb)
str.BufFree(sb)
binary.WriteU8(buf, 147)
compress.BufPushBytes(buf, "NUMPY" as void*, 5)
binary.WriteU8(buf, 1)
binary.WriteU8(buf, 0)
binary.WriteU16LE(buf, str.Len(dict))
compress.BufPushBytes(buf, dict as void*, str.Len(dict))
mem.Free(dict as void*)
end
package npy
import archive
import compress
import mem
import str
func _strip_npy(name: str): str:
if str.EndsWith(name, ".npy"):
ret str.Substr(name, 0, str.Len(name) - 4)
end
ret str.Clone(name)
end
@en "NpzList"
@fa "فهرست ان‌پی‌زد"
pub func NpzList(path: str): Vector<str> throws:
mut raw := try _read_file(path)
defer compress.BufFree(raw)
mut entries := archive.ZipList(raw.data, compress.BufLen(raw))
defer archive.FreeEntries(entries)
if entries.len() == 0:
throw Error.New(ErrorKind.Syntax, "not a .npz file (no zip entries)").with_code("npy.bad_npz").with_path(path).wrap("npy")
end
mut out := Vector {} as Vector<str>
repeat entries.len() in i:
e := entries.get(i)
if e.is_dir == false: out.push(_strip_npy(e.name)) end
end
ret out
end
@en "NpzRead"
@fa "خواندن ان‌پی‌زد"
pub func NpzRead(path: str, key: str): NpyArray throws:
mut raw := try _read_file(path)
defer compress.BufFree(raw)
mut zok := false
named := key + ".npy"
mut member := archive.ZipExtractByName(raw.data, compress.BufLen(raw), named, zok)
mem.Free(named as void*)
if zok == false:
compress.BufFree(member)
member = archive.ZipExtractByName(raw.data, compress.BufLen(raw), key, zok)
end
defer compress.BufFree(member)
if zok == false:
throw Error.New(ErrorKind.NotFound, "no array named '" + key + "'").with_code("npy.missing_key").with_path(path).wrap("npy")
end
try:
ret _read_npy(member.data, compress.BufLen(member))
catch e:
throw e.with_path(path + ":" + key).wrap("npy")
end
end
@en "NpzWrite"
@fa "نوشتن ان‌پی‌زد"
pub func NpzWrite(path: str, keys &: Vector<str>, arrays &: Vector<NpyArray>): bool:
if keys.len() != arrays.len() or keys.len() == 0: ret false end
mut bufs := Vector {} as Vector<compress.ByteBuf>
mut inputs := Vector {} as Vector<archive.ZipFileInput>
repeat keys.len() in i:
mut a := arrays.get(i)
b := WriteNpy(a)
mut fi := archive.ZipFileInput {}
fi.name = keys.get(i) + ".npy"
fi.data_ptr = b.data
fi.data_len = compress.BufLen(b)
fi.method = 0
inputs.push(fi)
bufs.push(b)
end
ok := archive.ZipCreateFile(inputs, path)
repeat bufs.len() in i:
mut b := bufs.get(i)
compress.BufFree(b)
end
repeat inputs.len() in i: mem.Free(inputs.get(i).name as void*) end
bufs.free()
inputs.free()
ret ok
end
package os
@en "MkdirAll"
@fa "ساخت پوشه ها"
pub func MkdirAll(path: str): int:
if path.len() == 0: ret 0 - 1 end
if _os_is_dir(path): ret 0 end
parts := path.split("/")
mut cur := ""
mut owns := false
repeat parts.len() in i:
part := parts.get(i)
if part.len() == 0:
if i == 0:
cur = "/"
owns = false
end
else:
mut sb := str.NewBuilder()
str.BufAppend(sb, cur)
if cur.len() > 0 and cur != "/": str.BufAppend(sb, "/") end
str.BufAppend(sb, part)
next := str.BufStr(sb)
str.BufFree(sb)
if owns: mem.Free(cur as void *) end
cur = next
owns = true
if _os_is_dir(cur) == false:
_os_mkdir(cur)
end
end
end
if owns: mem.Free(cur as void *) end
repeat parts.len() in i:
mem.Free(parts.get(i) as void *)
end
parts.free()
if _os_is_dir(path): ret 0 end
ret 0 - 1
end
@en "RemoveAll"
@fa "حذف همه"
pub func RemoveAll(path: str): int:
if _os_is_link(path): ret _os_remove_link(path) end
if _os_exists(path) == false: ret 0 end
if _os_is_dir(path) == false:
ret Remove(path)
end
entries := ListDir(path)
mut rc := 0
repeat entries.len() in i:
full := filepath.Join(path, entries.get(i))
if RemoveAll(full) != 0: rc = 0 - 1 end
mem.Free(full as void *)
end
repeat entries.len() in i:
mem.Free(entries.get(i) as void *)
end
entries.free()
if _os_rmdir(path) != 0: rc = 0 - 1 end
ret rc
end
@en "CopyTree"
@fa "کپی درخت"
pub func CopyTree(src: str, dst: str): int:
if _os_is_dir(src) == false: ret 0 - 1 end
if MkdirAll(dst) != 0: ret 0 - 1 end
entries := ListDir(src)
defer entries.free()
mut rc := 0
repeat entries.len() in i:
name := entries.get(i)
s := filepath.Join(src, name)
d := filepath.Join(dst, name)
if _os_is_dir(s):
if CopyTree(s, d) != 0: rc = 0 - 1 end
else:
if Copy(s, d) != 0: rc = 0 - 1 end
end
end
ret rc
end
@en "ListDirs"
@fa "فهرست پوشه ها"
pub func ListDirs(path: str): Vector<str>:
out := Vector {} as Vector<str> entries := ListDir(path)
defer entries.free()
repeat entries.len() in i:
name := entries.get(i)
if _os_is_dir(filepath.Join(path, name)):
out.push(name)
end
end
ret out
end
@en "dl"
@fa "بارگذاری کتابخانه"
package dl
import str
if SALAM_OS_LINUX:
link dynamic "dl"
end
if not SALAM_OS_WINDOWS:
extern:
func dlopen(path: void*, flags: int): void*
func dlsym(handle: void*, name: str): void*
func dlclose(handle: void*): int
func dlerror(): void*
end
end
func _int_at(args: size[], k: int): size:
if k < len(args):
ret args[k]
end
ret 0
end
func _dbl_at(args: f64[], k: int): f64:
if k < len(args):
ret args[k]
end
ret 0.0
end
@en "Supported"
@fa "پشتیبانی می شود"
pub func Supported(): bool:
ret not SALAM_OS_WINDOWS
end
@en "Open"
@fa "باز کردن"
pub func Open(path: str): void*:
if SALAM_OS_WINDOWS:
ret null
else:
ret dlopen(path as void*, 2)
end
end
@en "OpenSelf"
@fa "باز کردن برنامه"
pub func OpenSelf(): void*:
if SALAM_OS_WINDOWS:
ret null
else:
ret dlopen(null, 2)
end
end
@en "Sym"
@fa "نماد"
pub func Sym(lib: void*, name: str): void*:
if SALAM_OS_WINDOWS or lib == null:
ret null
else:
ret dlsym(lib, name)
end
end
@en "Close"
@fa "بستن"
pub func Close(lib: void*): bool:
if SALAM_OS_WINDOWS or lib == null:
ret false
else:
ret dlclose(lib) == 0
end
end
@en "Error"
@fa "خطا"
pub func Error(): str:
if SALAM_OS_WINDOWS:
ret "dynamic loading is not supported on Windows"
else:
e := dlerror()
if e == null:
ret ""
end
ret str.Clone(e as str)
end
end
@en "Call"
@fa "فراخوان"
pub func Call(fn: void*, args: size[]): size:
if fn == null or len(args) > 8:
ret 0
end
n := len(args)
switch n:
0:
f := fn as extern func () size
ret f()
end
1:
f := fn as extern func (size) size
ret f(args[0])
end
2:
f := fn as extern func (size, size) size
ret f(args[0], args[1])
end
3:
f := fn as extern func (size, size, size) size
ret f(args[0], args[1], args[2])
end
4:
f := fn as extern func (size, size, size, size) size
ret f(args[0], args[1], args[2], args[3])
end
5:
f := fn as extern func (size, size, size, size, size) size
ret f(args[0], args[1], args[2], args[3], args[4])
end
6:
f := fn as extern func (size, size, size, size, size, size) size
ret f(args[0], args[1], args[2], args[3], args[4], args[5])
end
7:
f := fn as extern func (size, size, size, size, size, size, size) size
ret f(args[0], args[1], args[2], args[3], args[4], args[5], args[6])
end
else:
f := fn as extern func (size, size, size, size, size, size, size, size) size
ret f(args[0], args[1], args[2], args[3], args[4], args[5], args[6], args[7])
end
end
end
@en "CallMixed"
@fa "فراخوانی ترکیبی"
pub func CallMixed(fn: void*, ints: size[], dbls: f64[]): size:
if fn == null or len(ints) > 6 or len(dbls) > 8:
ret 0
end
f := fn as extern func (size, size, size, size, size, size, f64, f64, f64, f64, f64, f64, f64, f64) size
ret f(_int_at(ints, 0), _int_at(ints, 1), _int_at(ints, 2), _int_at(ints, 3), _int_at(ints, 4), _int_at(ints, 5), _dbl_at(dbls, 0), _dbl_at(dbls, 1), _dbl_at(dbls, 2), _dbl_at(dbls, 3), _dbl_at(dbls, 4), _dbl_at(dbls, 5), _dbl_at(dbls, 6), _dbl_at(dbls, 7))
end
@en "CallMixedF64"
@fa "فراخوانی ترکیبی اعشار"
pub func CallMixedF64(fn: void*, ints: size[], dbls: f64[]): f64:
if fn == null or len(ints) > 6 or len(dbls) > 8:
ret 0.0
end
f := fn as extern func (size, size, size, size, size, size, f64, f64, f64, f64, f64, f64, f64, f64) f64
ret f(_int_at(ints, 0), _int_at(ints, 1), _int_at(ints, 2), _int_at(ints, 3), _int_at(ints, 4), _int_at(ints, 5), _dbl_at(dbls, 0), _dbl_at(dbls, 1), _dbl_at(dbls, 2), _dbl_at(dbls, 3), _dbl_at(dbls, 4), _dbl_at(dbls, 5), _dbl_at(dbls, 6), _dbl_at(dbls, 7))
end
@en "error"
@fa "خطا"
package error
@en "None"
@fa "بدون خطا"
pub const None := 0
@en "FileNotFound"
@fa "پرونده یافت نشد"
pub const FileNotFound := 1
@en "PermissionDenied"
@fa "دسترسی رد شد"
pub const PermissionDenied := 2
@en "AlreadyExists"
@fa "از قبل موجود است"
pub const AlreadyExists := 3
@en "InvalidPath"
@fa "مسیر نامعتبر"
pub const InvalidPath := 4
@en "NotSupported"
@fa "پشتیبانی نمی شود"
pub const NotSupported := 5
@en "IOError"
@fa "خطای ورودی خروجی"
pub const IOError := 6
@en "Timeout"
@fa "پایان زمان"
pub const Timeout := 7
@en "ProcessFailed"
@fa "فرآیند ناموفق"
pub const ProcessFailed := 8
mut _last_code := 0
mut _last_message := ""
mut _last_operation := ""
mut _last_path := ""
mut _last_system_code := 0
@en "OSError"
@fa "خطای سیستم عامل"
pub struct OSError:
@en "code"
@fa "کد"
pub code: int = 0
@en "message"
@fa "پیام"
pub message: str = ""
@en "operation"
@fa "عملیات"
pub operation: str = ""
@en "path"
@fa "مسیر"
pub path: str = ""
@en "system_code"
@fa "کد سیستم"
pub system_code: int = 0
end
@en "Set"
@fa "تنظیم خطا"
pub func Set(code: int, message: str, operation: str, path: str, system_code: int):
_last_code = code
_last_message = message
_last_operation = operation
_last_path = path
_last_system_code = system_code
end
@en "Clear"
@fa "پاک کردن خطا"
pub func Clear():
_last_code = None
_last_message = ""
_last_operation = ""
_last_path = ""
_last_system_code = 0
end
@en "Last"
@fa "آخرین خطا"
pub func Last(): OSError:
ret OSError {
code = _last_code, message = _last_message, operation = _last_operation, path = _last_path,
system_code = _last_system_code
}
end
@en "LastCode"
@fa "کد آخرین خطا"
pub func LastCode(): int: ret _last_code end
@en "LastMessage"
@fa "پیام آخرین خطا"
pub func LastMessage(): str: ret _last_message end
@en "HasError"
@fa "خطا دارد"
pub func HasError(): bool: ret _last_code != None end
@en "os/internal/fdio"
@fa "ورودی خروجی توصیف‌گر"
package fdio
import mem
import str
import time
if SALAM_OS_WINDOWS:
link dynamic "kernel32"
extern:
func PeekNamedPipe(h: void*, buf: void*, n: u32, got: void*, avail: void*, left: void*): int
func ReadFile(h: void*, buf: void*, n: u32, got: void*, overlapped: void*): int
func WriteFile(h: void*, buf: void*, n: u32, wrote: void*, overlapped: void*): int
func CloseHandle(h: void*): int
func Sleep(ms: int)
end
else:
extern:
func poll(fds: void*, nfds: usize, timeout: int): int
func close(fd: int): int
func pipe(fds: void*): int
func fcntl(fd: int, cmd: int, ...): int
func dup2(from_fd: int, to_fd: int): int
func execve(path: str, argv: void*, envp: void*): int
func access(path: str, mode: int): int
func getenv(name: str): void*
environ: void*
end
