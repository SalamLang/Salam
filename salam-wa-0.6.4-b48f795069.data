@en "x"
@fa "ایکس"
pub x: f64 = 0.0
@en "y"
@fa "ایگرگ"
pub y: f64 = 0.0
@en "width"
@fa "پهنا"
pub width: f64 = 0.0
@en "height"
@fa "بلندی"
pub height: f64 = 0.0
@en "physical_width"
@fa "پهنای فیزیکی"
