d.nlit = rsz
if typ == 0:
if hdr + rsz > n:
ret 0 - 1
end
d.litp = _zs_at(p, hdr)
ret hdr + rsz
end
if typ == 1:
if hdr + 1 > n:
ret 0 - 1
end
mem.Set(d.lit as void*, p[hdr] as int, rsz as u64)
d.litp = d.lit
ret hdr + 1
