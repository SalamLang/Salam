@en "DecodeDocument"
@fa "رمزگشایی سند"
pub func DecodeDocument<T>(document: str, out &: T, err &: Error): bool:
try:
json.UnmarshalLenient(document, out)
catch e:
_ts_decode_fail(e.message, err)
ret false
end
ret true
end
@en "GetDocumentAs"
@fa "دریافت سند به نوع"
pub func GetDocumentAs<T>(c: Client, collection: str, id: str, out &: T, err &: Error): bool:
body := _ts_fetch(c, collection, id, err)
if _ts_failed(err): ret false end
try:
json.UnmarshalLenient(body, out)
catch e:
_ts_decode_fail(e.message, err)
ret false
end
ret true
end
@en "DecodeDocuments"
@fa "رمزگشایی سندها"
pub func DecodeDocuments<T>(documents: Vector<str>, out &: Vector<T>, err &: Error): bool:
each item in documents:
mut v := T {}
try:
json.UnmarshalLenient(item, v)
catch e:
_ts_decode_fail(e.message, err)
ret false
end
out.push(v)
end
ret true
end
@en "ExportJSONL"
