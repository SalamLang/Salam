@en "binary"
@fa "دودویی"
package binary
import compress
import mem
@en "BinaryOptions"
@fa "گزینه‌های دودویی"
pub struct BinaryOptions:
@en "big_endian"
@fa "بزرگ‌انتها"
pub big_endian: bool = false
end
func f64_bits(v: f64): i64:
buf := mem.Allocate(8 as u64)
p := buf as f64*
p[0] = v
q := buf as i64*
bits := q[0]
mem.Free(buf)
ret bits
end
func bits_to_f64(bits: i64): f64:
buf := mem.Allocate(8 as u64)
p := buf as i64*
p[0] = bits
q := buf as f64*
v := q[0]
mem.Free(buf)
ret v
end
func f32_bits(v: f32): int:
buf := mem.Allocate(4 as u64)
p := buf as f32*
p[0] = v
q := buf as u32*
bits := q[0] as int
mem.Free(buf)
ret bits
end
func bits_to_f32(bits: int): f32:
buf := mem.Allocate(4 as u64)
p := buf as u32*
p[0] = bits as u32
q := buf as f32*
v := q[0]
mem.Free(buf)
ret v
end
inline func _b(p: void*, i: int): int:
bp := p as u8*
ret bp[i] as int
end
func _short(r: compress.ByteReader, n: int): Error:
mut left := r.len - r.pos
if r.bad or left < 0: left = 0 end
mut unit := " bytes, "
if n == 1: unit = " byte, " end
ret Error.At(ErrorKind.UnexpectedEnd, "unexpected end of data: needed " + n + unit + left + " left", r.pos).with_code("binary.unexpected_end")
end
@en "WriteU8"
@fa "نوشتن طبیعی۸"
pub func WriteU8(b &: compress.ByteBuf, v: int): compress.BufPush(b, v & 255) end
@en "WriteU16BE"
@fa "نوشتن طبیعی۱۶ بزرگ‌انتها"
pub func WriteU16BE(b &: compress.ByteBuf, v: int):
compress.BufPush(b, (v >> 8) & 255)
compress.BufPush(b, v & 255)
end
@en "WriteU16LE"
@fa "نوشتن طبیعی۱۶ کوچک‌انتها"
pub func WriteU16LE(b &: compress.ByteBuf, v: int):
compress.BufPush(b, v & 255)
compress.BufPush(b, (v >> 8) & 255)
end
@en "WriteU32BE"
@fa "نوشتن طبیعی۳۲ بزرگ‌انتها"
pub func WriteU32BE(b &: compress.ByteBuf, v: int): compress.BufPushU32(b, v) end
@en "WriteU32LE"
@fa "نوشتن طبیعی۳۲ کوچک‌انتها"
pub func WriteU32LE(b &: compress.ByteBuf, v: int):
compress.BufPush(b, v & 255)
compress.BufPush(b, (v >> 8) & 255)
compress.BufPush(b, (v >> 16) & 255)
compress.BufPush(b, (v >> 24) & 255)
end
@en "WriteU64BE"
@fa "نوشتن طبیعی۶۴ بزرگ‌انتها"
pub func WriteU64BE(b &: compress.ByteBuf, v: i64):
mut shift := 56
until shift >= 0:
compress.BufPush(b, ((v >> shift) & (255 as i64)) as int)
shift -= 8
end
end
@en "WriteU64LE"
@fa "نوشتن طبیعی۶۴ کوچک‌انتها"
pub func WriteU64LE(b &: compress.ByteBuf, v: i64):
mut shift := 0
until shift <= 56:
compress.BufPush(b, ((v >> shift) & (255 as i64)) as int)
shift += 8
end
end
@en "WriteI16BE"
@fa "نوشتن صحیح۱۶ بزرگ‌انتها"
pub func WriteI16BE(b &: compress.ByteBuf, v: int): WriteU16BE(b, v) end
@en "WriteI16LE"
@fa "نوشتن صحیح۱۶ کوچک‌انتها"
pub func WriteI16LE(b &: compress.ByteBuf, v: int): WriteU16LE(b, v) end
@en "WriteI32BE"
@fa "نوشتن صحیح۳۲ بزرگ‌انتها"
pub func WriteI32BE(b &: compress.ByteBuf, v: int): WriteU32BE(b, v) end
@en "WriteI32LE"
@fa "نوشتن صحیح۳۲ کوچک‌انتها"
pub func WriteI32LE(b &: compress.ByteBuf, v: int): WriteU32LE(b, v) end
@en "WriteI64BE"
@fa "نوشتن صحیح۶۴ بزرگ‌انتها"
pub func WriteI64BE(b &: compress.ByteBuf, v: i64): WriteU64BE(b, v) end
@en "WriteI64LE"
@fa "نوشتن صحیح۶۴ کوچک‌انتها"
pub func WriteI64LE(b &: compress.ByteBuf, v: i64): WriteU64LE(b, v) end
@en "WriteF64"
@fa "نوشتن اعشار۶۴"
pub func WriteF64(b &: compress.ByteBuf, v: f64, big_endian: bool):
bits := f64_bits(v)
if big_endian: WriteU64BE(b, bits) else:
WriteU64LE(b, bits)
end
end
@en "WriteF32"
@fa "نوشتن اعشار۳۲"
pub func WriteF32(b &: compress.ByteBuf, v: f64, big_endian: bool):
bits := f32_bits(v as f32)
if big_endian: WriteU32BE(b, bits) else:
WriteU32LE(b, bits)
end
end
@en "ReadU8"
@fa "خواندن طبیعی۸"
pub func ReadU8(r &: compress.ByteReader): int throws:
if r.bad or r.pos >= r.len: throw _short(r, 1) end
v := _b(r.data, r.pos)
r.pos++
ret v
end
@en "ReadU16BE"
@fa "خواندن طبیعی۱۶ بزرگ‌انتها"
pub func ReadU16BE(r &: compress.ByteReader): int throws:
i := r.pos
if r.bad or i + 2 > r.len: throw _short(r, 2) end
p := r.data
r.pos = i + 2
ret (_b(p, i) << 8) | _b(p, i + 1)
end
@en "ReadU16LE"
@fa "خواندن طبیعی۱۶ کوچک‌انتها"
pub func ReadU16LE(r &: compress.ByteReader): int throws:
i := r.pos
if r.bad or i + 2 > r.len: throw _short(r, 2) end
p := r.data
r.pos = i + 2
ret _b(p, i) | (_b(p, i + 1) << 8)
end
@en "ReadU32BE"
@fa "خواندن طبیعی۳۲ بزرگ‌انتها"
pub func ReadU32BE(r &: compress.ByteReader): int throws:
i := r.pos
if r.bad or i + 4 > r.len: throw _short(r, 4) end
p := r.data
r.pos = i + 4
ret (_b(p, i) << 24) | (_b(p, i + 1) << 16) | (_b(p, i + 2) << 8) | _b(p, i + 3)
end
@en "ReadU32LE"
@fa "خواندن طبیعی۳۲ کوچک‌انتها"
pub func ReadU32LE(r &: compress.ByteReader): int throws:
i := r.pos
if r.bad or i + 4 > r.len: throw _short(r, 4) end
p := r.data
r.pos = i + 4
ret _b(p, i) | (_b(p, i + 1) << 8) | (_b(p, i + 2) << 16) | (_b(p, i + 3) << 24)
end
@en "ReadU64BE"
@fa "خواندن طبیعی۶۴ بزرگ‌انتها"
pub func ReadU64BE(r &: compress.ByteReader): i64 throws:
i := r.pos
if r.bad or i + 8 > r.len: throw _short(r, 8) end
p := r.data
r.pos = i + 8
mut out := 0 as i64
repeat 8 in k:
out = (out << (8 as i64)) | (_b(p, i + k) as i64)
end
ret out
end
@en "ReadU64LE"
@fa "خواندن طبیعی۶۴ کوچک‌انتها"
pub func ReadU64LE(r &: compress.ByteReader): i64 throws:
i := r.pos
if r.bad or i + 8 > r.len: throw _short(r, 8) end
p := r.data
r.pos = i + 8
mut out := 0 as i64
mut k := 7
until k >= 0:
out = (out << (8 as i64)) | (_b(p, i + k) as i64)
k--
end
ret out
end
@en "ReadI16BE"
@fa "خواندن صحیح۱۶ بزرگ‌انتها"
pub func ReadI16BE(r &: compress.ByteReader): int throws:
v := try ReadU16BE(r)
if v >= 32768: ret v - 65536 end
ret v
end
@en "ReadI16LE"
@fa "خواندن صحیح۱۶ کوچک‌انتها"
pub func ReadI16LE(r &: compress.ByteReader): int throws:
v := try ReadU16LE(r)
if v >= 32768: ret v - 65536 end
ret v
end
@en "ReadI32BE"
@fa "خواندن صحیح۳۲ بزرگ‌انتها"
pub func ReadI32BE(r &: compress.ByteReader): int throws: ret try ReadU32BE(r) end
@en "ReadI32LE"
@fa "خواندن صحیح۳۲ کوچک‌انتها"
pub func ReadI32LE(r &: compress.ByteReader): int throws: ret try ReadU32LE(r) end
@en "ReadI64BE"
@fa "خواندن صحیح۶۴ بزرگ‌انتها"
pub func ReadI64BE(r &: compress.ByteReader): i64 throws: ret try ReadU64BE(r) end
@en "ReadI64LE"
@fa "خواندن صحیح۶۴ کوچک‌انتها"
pub func ReadI64LE(r &: compress.ByteReader): i64 throws: ret try ReadU64LE(r) end
@en "ReadF64"
@fa "خواندن اعشار۶۴"
pub func ReadF64(r &: compress.ByteReader, big_endian: bool): f64 throws:
mut bits := 0 as i64
if big_endian: bits = try ReadU64BE(r) else:
bits = try ReadU64LE(r)
end
ret bits_to_f64(bits)
end
@en "ReadF32"
@fa "خواندن اعشار۳۲"
pub func ReadF32(r &: compress.ByteReader, big_endian: bool): f64 throws:
mut bits := 0
if big_endian: bits = try ReadU32BE(r) else:
bits = try ReadU32LE(r)
end
ret bits_to_f32(bits)
end
package binary
import compress
import mem
@en "View"
@fa "نمای بایت"
pub struct View:
@en "data"
@fa "داده"
pub data: void* = null
@en "len"
@fa "طول"
pub len: int = 0
end
func _vget(v: View, off: int, n: int, big: bool): i64:
if v.data == null or off < 0 or n < 0 or off > v.len - n:
ret 0
end
bp := v.data as u8*
mut r := 0 as i64
repeat n in i:
k := big ? i : n - 1 - i
r = (r << 8) | ((bp[off + k] as i64) & 255)
end
ret r
end
func _vput(v: View, off: int, n: int, big: bool, x: i64): bool:
if v.data == null or off < 0 or n < 0 or off > v.len - n:
ret false
end
bp := v.data as u8*
repeat n in i:
k := big ? n - 1 - i : i
bp[off + k] = ((x >> ((i * 8) as i64)) & 255) as u8
end
ret true
end
@en "NewView"
@fa "نمای بایت جدید"
pub func NewView(p: void*, n: int): View:
ret View { data = p, len = n }
end
@en "ViewOf"
@fa "نمای بافر"
pub func ViewOf(b: compress.ByteBuf): View:
ret View { data = b.data, len = b.len }
end
@en "Has"
@fa "دارد"
pub func Has(v: View, off: int, n: int): bool:
ret v.data != null and off >= 0 and n >= 0 and off <= v.len - n
end
@en "GetU8"
@fa "گرفتن طبیعی۸"
pub func GetU8(v: View, off: int): int: ret _vget(v, off, 1, false) as int end
@en "GetU16LE"
@fa "گرفتن طبیعی۱۶ کوچک‌انتها"
pub func GetU16LE(v: View, off: int): int: ret _vget(v, off, 2, false) as int end
@en "GetU16BE"
@fa "گرفتن طبیعی۱۶ بزرگ‌انتها"
pub func GetU16BE(v: View, off: int): int: ret _vget(v, off, 2, true) as int end
@en "GetU32LE"
@fa "گرفتن طبیعی۳۲ کوچک‌انتها"
pub func GetU32LE(v: View, off: int): i64: ret _vget(v, off, 4, false) end
@en "GetU32BE"
@fa "گرفتن طبیعی۳۲ بزرگ‌انتها"
pub func GetU32BE(v: View, off: int): i64: ret _vget(v, off, 4, true) end
@en "GetU64LE"
@fa "گرفتن طبیعی۶۴ کوچک‌انتها"
pub func GetU64LE(v: View, off: int): i64: ret _vget(v, off, 8, false) end
@en "GetU64BE"
@fa "گرفتن طبیعی۶۴ بزرگ‌انتها"
pub func GetU64BE(v: View, off: int): i64: ret _vget(v, off, 8, true) end
@en "PutU8"
@fa "گذاشتن طبیعی۸"
pub func PutU8(v: View, off: int, x: i64): bool: ret _vput(v, off, 1, false, x) end
@en "PutU16LE"
@fa "گذاشتن طبیعی۱۶ کوچک‌انتها"
pub func PutU16LE(v: View, off: int, x: i64): bool: ret _vput(v, off, 2, false, x) end
@en "PutU16BE"
@fa "گذاشتن طبیعی۱۶ بزرگ‌انتها"
pub func PutU16BE(v: View, off: int, x: i64): bool: ret _vput(v, off, 2, true, x) end
@en "PutU32LE"
@fa "گذاشتن طبیعی۳۲ کوچک‌انتها"
pub func PutU32LE(v: View, off: int, x: i64): bool: ret _vput(v, off, 4, false, x) end
@en "PutU32BE"
@fa "گذاشتن طبیعی۳۲ بزرگ‌انتها"
pub func PutU32BE(v: View, off: int, x: i64): bool: ret _vput(v, off, 4, true, x) end
@en "PutU64LE"
@fa "گذاشتن طبیعی۶۴ کوچک‌انتها"
pub func PutU64LE(v: View, off: int, x: i64): bool: ret _vput(v, off, 8, false, x) end
@en "PutU64BE"
@fa "گذاشتن طبیعی۶۴ بزرگ‌انتها"
pub func PutU64BE(v: View, off: int, x: i64): bool: ret _vput(v, off, 8, true, x) end
@en "CStringAt"
@fa "رشته با صفر پایانی"
pub func CStringAt(v: View, off: int): str:
if v.data == null or off < 0 or off >= v.len:
ret ""
end
bp := v.data as u8*
mut end_at := off
until end_at < v.len and bp[end_at] != 0:
end_at++
end
size := end_at - off
buf := mem.Allocate((size + 1) as u64)
mem.Copy(buf, ((bp as i64) + (off as i64)) as void*, size as u64)
out := buf as u8*
out[size] = 0 as u8
ret buf as str
end
@en "FixedStringAt"
@fa "رشته با پهنای ثابت"
pub func FixedStringAt(v: View, off: int, width: int): str:
if v.data == null or off < 0 or width <= 0 or off > v.len - width:
ret ""
end
sub := View { data = v.data, len = off + width }
ret CStringAt(sub, off)
end
@en "csv"
@fa "سی اس وی"
package csv
import str
import mem
inline pure func _bp(s: str): i8*: ret (s as void*) as i8* end
inline pure func _ub(bp: i8*, i: int): int:
mut v := bp[i] as int
if v < 0: v += 256 end
ret v
end
func _sep_byte(sep: str): int:
if sep.len() != 1: ret 0 - 1 end
c := _ub(_bp(sep), 0)
if c == 34 or c == 10 or c == 13: ret 0 - 1 end
ret c
end
func _write_sep(opts: CSVOptions): int:
c := _sep_byte(opts.separator)
if c < 0: ret 44 end
ret c
end
func _read_sep(opts: CSVOptions, err &: Error): int:
c := _sep_byte(opts.separator)
if c < 0:
err = Error.New(ErrorKind.InvalidArgument, "the separator must be one character other than a quote or a line break, got '" + opts.separator + "'").with_code("csv.bad_separator")
end
ret c
end
func _eol_len(bp: i8*, n: int, i: int): int:
c := _ub(bp, i)
if c == 10: ret 1 end
if c == 13:
if i + 1 == n: ret 1 end
if _ub(bp, i + 1) == 10: ret 2 end
end
ret 0
end
func _sep_name(sep: int): str:
if sep == 9: ret "a tab" end
mut sb := str.NewBuilder()
defer str.BufFree(sb)
str.BufAppendChar(sb, 39)
str.BufAppendChar(sb, sep)
str.BufAppendChar(sb, 39)
ret str.BufStr(sb)
end
func _free_fields(fields &: Vector<str>):
repeat fields.len() in i: mem.Free(fields.get(i) as void*) end
fields.free()
end
func _read_quoted(sb &: str.StringBuilder, bp: i8*, n: int, start: int, err &: Error): int:
mut i := start + 1
until i < n:
c := _ub(bp, i)
if c == 34:
if i + 1 < n and _ub(bp, i + 1) == 34:
str.BufAppendChar(sb, 34)
i += 2
else:
ret i + 1
end
else:
str.BufAppendChar(sb, c)
i++
end
end
err = Error.At(ErrorKind.Syntax, "unterminated quoted field", start).with_code("csv.unterminated_quote")
ret n
end
func _read_bare(sb &: str.StringBuilder, bp: i8*, n: int, start: int, sep: int, err &: Error): int:
mut i := start
until i < n:
c := _ub(bp, i)
if c == sep or _eol_len(bp, n, i) > 0: ret i end
if c == 34:
err = Error.At(ErrorKind.Syntax, "a quote inside an unquoted field; quote the whole field and double the quote", i).with_code("csv.bare_quote")
ret n
end
str.BufAppendChar(sb, c)
i++
end
ret n
end
func _read_record(text: str, n: int, start: int, sep: int, row &: Vector<str>, at &: Vector<int>, err &: Error): int:
bp := _bp(text)
mut sb := str.NewBuilder()
defer str.BufFree(sb)
mut i := start
until true:
str.BufReset(sb)
at.push(i)
quoted := i < n and _ub(bp, i) == 34
if quoted:
i = _read_quoted(sb, bp, n, i, err)
else:
i = _read_bare(sb, bp, n, i, sep, err)
end
if err.message != "": ret n end
row.push(str.BufStr(sb))
if i >= n: ret n end
c := _ub(bp, i)
if c == sep:
i++
else:
eol := _eol_len(bp, n, i)
if eol > 0: ret i + eol end
err = Error.At(ErrorKind.Syntax, "unexpected text after a closing quote; expected " + _sep_name(sep) + " or a line break", i).with_code("csv.text_after_quote")
ret n
end
end
end
func _read_line(line: str, sep: int, err &: Error): Vector<str>:
mut row := Vector {} as Vector<str>
mut at := Vector {} as Vector<int>
defer at.free()
n := line.len()
next := _read_record(line, n, 0, sep, row, at, err)
if err.message == "" and next < n:
err = Error.At(ErrorKind.Syntax, "more than one row; read several rows with ReadAll", next).with_code("csv.multiple_rows")
end
if err.message != "": _free_fields(row) end
ret row
end
pure func _needs_quote(field: str, sep: int): bool:
bp := _bp(field)
n := field.len()
repeat n in i:
c := _ub(bp, i)
if c == sep or c == 34 or c == 10 or c == 13: ret true end
end
ret false
end
func _write_line(sb &: str.StringBuilder, fields: Vector<str>, sep: int):
repeat fields.len() in i:
if i > 0:
str.BufAppendChar(sb, sep)
end
f := fields.get(i)
if _needs_quote(f, sep):
str.BufAppendChar(sb, 34)
bp := _bp(f)
repeat f.len() in k:
c := _ub(bp, k)
if c == 34: str.BufAppendChar(sb, 34) end
str.BufAppendChar(sb, c)
end
str.BufAppendChar(sb, 34)
else:
str.BufAppend(sb, f)
end
end
end
@en "ReadLineWith"
@fa "خواندن خط سفارشی"
pub func ReadLineWith(line: str, opts: CSVOptions): Vector<str> throws:
mut err := Error {}
sep := _read_sep(opts, err)
if err.message != "": throw err.wrap("csv") end
row := _read_line(line, sep, err)
if err.message != "": throw err.locate(line).wrap("csv") end
ret row
end
@en "ReadLine"
@fa "خواندن خط"
pub func ReadLine(line: str): Vector<str> throws:
mut err := Error {}
row := _read_line(line, 44, err)
if err.message != "": throw err.locate(line).wrap("csv") end
ret row
end
@en "WriteLineWith"
@fa "نوشتن خط سفارشی"
pub func WriteLineWith(fields: Vector<str>, opts: CSVOptions): str:
mut sb := str.NewBuilder()
defer str.BufFree(sb)
_write_line(sb, fields, _write_sep(opts))
ret str.BufStr(sb)
end
@en "WriteLine"
@fa "نوشتن خط"
pub func WriteLine(fields: Vector<str>): str:
mut sb := str.NewBuilder()
defer str.BufFree(sb)
_write_line(sb, fields, 44)
ret str.BufStr(sb)
end
package csv
import encoding.value
import mem
import str
import conv
@en "CSVRow"
@fa "ردیف سی اس وی"
pub struct CSVRow:
@en "fields"
@fa "خانه‌ها"
pub fields: Vector<str> = Vector {}
end
@en "CSVTable"
@fa "جدول سی اس وی"
pub struct CSVTable:
@en "rows"
@fa "ردیف‌ها"
pub rows: Vector<CSVRow> = Vector {}
end
@en "CSVOptions"
@fa "گزینه‌های سی اس وی"
pub struct CSVOptions:
@en "header"
@fa "سرستون"
pub header: bool = true
@en "separator"
@fa "جداکننده"
pub separator: str = ","
@en "keep_blank"
@fa "نگه داشتن خط خالی"
pub keep_blank: bool = false
end
func _index_key(i: int): str:
ret "col".concat(conv.FormatInt(i as i64))
end
func _free_rows(t &: CSVTable):
repeat t.rows.len() in i:
mut r := t.rows.get(i)
repeat r.fields.len() in j: mem.Free(r.fields.get(j) as void*) end
r.fields.free()
end
t.rows.free()
end
func _read_table(text: str, sep: int, keep_blank: bool, header_at &: Vector<int>, err &: Error): CSVTable:
mut out := CSVTable {}
bp := _bp(text)
n := text.len()
mut at := Vector {} as Vector<int>
defer at.free()
mut pos := 0
until pos < n:
eol := _eol_len(bp, n, pos)
if eol > 0 and keep_blank == false:
pos += eol
continue
end
mut row := CSVRow {}
at.clear()
pos = _read_record(text, n, pos, sep, row.fields, at, err)
if err.message != "":
_free_fields(row.fields)
_free_rows(out)
ret CSVTable {}
end
if out.rows.len() == 0:
repeat at.len() in k: header_at.push(at.get(k)) end
end
out.rows.push(row)
end
ret out
end
func _check_header(table: CSVTable, at: Vector<int>, err &: Error):
header := table.rows.get(0).fields
repeat header.len() in j:
repeat j in k:
if str.Equals(header.get(k), header.get(j)):
mut off := 0
if j < at.len(): off = at.get(j) end
err = Error.At(ErrorKind.AlreadyExists, "duplicate column name '" + header.get(j) + "'", off).with_code("csv.duplicate_header")
ret
end
end
end
end
@en "ReadAllWith"
@fa "خواندن همه سفارشی"
pub func ReadAllWith(text: str, opts: CSVOptions): CSVTable throws:
mut err := Error {}
sep := _read_sep(opts, err)
if err.message != "": throw err.wrap("csv") end
mut hat := Vector {} as Vector<int>
defer hat.free()
out := _read_table(text, sep, opts.keep_blank, hat, err)
if err.message != "": throw err.locate(text).wrap("csv") end
ret out
end
@en "ReadAll"
@fa "خواندن همه"
pub func ReadAll(text: str): CSVTable throws:
ret try ReadAllWith(text, CSVOptions {})
end
@en "FreeTable"
@fa "آزادسازی جدول"
pub func FreeTable(t &: CSVTable):
_free_rows(t)
end
@en "WriteAllWith"
@fa "نوشتن همه سفارشی"
pub func WriteAllWith(table: CSVTable, opts: CSVOptions): str:
sep := _write_sep(opts)
mut sb := str.NewBuilder()
defer str.BufFree(sb)
repeat table.rows.len() in i:
if i > 0: str.BufAppend(sb, "\r\n") end
_write_line(sb, table.rows.get(i).fields, sep)
end
ret str.BufStr(sb)
end
@en "WriteAll"
@fa "نوشتن همه"
pub func WriteAll(table: CSVTable): str:
ret WriteAllWith(table, CSVOptions {})
end
@en "ToValueWith"
@fa "به مقدار سفارشی"
pub func ToValueWith(text: str, opts: CSVOptions): value.Value throws:
mut err := Error {}
sep := _read_sep(opts, err)
if err.message != "": throw err.wrap("csv") end
mut hat := Vector {} as Vector<int>
defer hat.free()
mut table := _read_table(text, sep, opts.keep_blank, hat, err)
if err.message == "" and opts.header and table.rows.len() > 0:
_check_header(table, hat, err)
if err.message != "": _free_rows(table) end
end
if err.message != "": throw err.locate(text).wrap("csv") end
mut out := value.NewValueArray()
if table.rows.len() == 0: ret out end
mut headerIdx := 0
mut header := Vector {} as Vector<str>
if opts.header:
header = table.rows.get(0).fields
headerIdx = 1
end
mut i := headerIdx
until i < table.rows.len():
row := table.rows.get(i).fields
mut obj := value.NewValueObject()
mut j := 0
until j < row.len():
mut key := _index_key(j)
if opts.header and j < header.len(): key = header.get(j) end
value.ObjectSet(obj, key, value.ValueString(row.get(j)))
j++
end
value.ArrayPush(out, obj)
i++
end
ret out
end
@en "ToValue"
@fa "به مقدار"
pub func ToValue(text: str): value.Value throws:
ret try ToValueWith(text, CSVOptions {})
end
@en "FromValueWith"
@fa "از مقدار سفارشی"
pub func FromValueWith(v: value.Value, opts: CSVOptions): str:
mut table := CSVTable {}
n := value.ArrayLen(v)
if n == 0: ret "" end
first := value.ArrayGet(v, 0)
header := value.ObjectKeys(first)
if opts.header:
mut headerRow := CSVRow {}
headerRow.fields = header
table.rows.push(headerRow)
end
mut i := 0
until i < n:
item := value.ArrayGet(v, i)
mut fields := Vector {} as Vector<str>
mut j := 0
until j < header.len():
fields.push(value.AsString(value.ObjectGet(item, header.get(j))))
j++
end
mut r := CSVRow {}
r.fields = fields
table.rows.push(r)
i++
end
ret WriteAllWith(table, opts)
end
@en "FromValue"
@fa "از مقدار"
pub func FromValue(v: value.Value): str:
ret FromValueWith(v, CSVOptions {})
end
@en "encoding"
@fa "کدگذاری"
package encoding
import str
inline pure func _bp(s: str): i8*: ret (s as void*) as i8* end
inline pure func _ub(bp: i8*, i: int): int:
mut v := bp[i] as int
if v < 0: v += 256 end
ret v
end
pure func _b64val(code: int): int:
if code >= 65 and code <= 90: ret code - 65
else code >= 97 and code <= 122: ret code - 71
else code >= 48 and code <= 57: ret code + 4
else code == 43 or code == 45: ret 62
else code == 47 or code == 95: ret 63
else:
ret 0 - 1
end
end
pure func _hexval(code: int): int:
if code >= 48 and code <= 57: ret code - 48
else code >= 97 and code <= 102: ret code - 87
else code >= 65 and code <= 70: ret code - 55
else:
ret 0 - 1
end
end
pure func _url_safe(code: int): bool:
if code >= 65 and code <= 90: ret true
else code >= 97 and code <= 122: ret true
else code >= 48 and code <= 57: ret true
else code == 45 or code == 95 or code == 46 or code == 126: ret true
else:
ret false
end
end
func _byte_desc(code: int): str:
mut sb := str.NewBuilder()
defer str.BufFree(sb)
if code == 32:
str.BufAppend(sb, "space")
else code > 32 and code < 127:
str.BufAppend(sb, "character ")
str.BufAppendChar(sb, 39)
str.BufAppendChar(sb, code)
str.BufAppendChar(sb, 39)
else:
digits := "0123456789ABCDEF"
hp := _bp(digits)
str.BufAppend(sb, "byte 0x")
str.BufAppendChar(sb, _ub(hp, code / 16))
str.BufAppendChar(sb, _ub(hp, code % 16))
end
out := str.BufStr(sb)
ret out
end
func _enc_err(text: str, kind: ErrorKind, message: str, offset: int, context: str): Error:
ret Error.At(kind, message, offset).locate(text).wrap(context)
end
func _b64_decode_into(s: str, sb &: str.StringBuilder, op: u8*, cap: int): int throws:
n := s.len()
bp := _bp(s)
mut written := 0
mut acc := 0
mut nbits := 0
mut digits := 0
mut pad := 0
mut pad_at := 0 - 1
mut extra_pad_at := 0 - 1
mut i := 0
until i < n:
code := _ub(bp, i)
if code == 32 or code == 9 or code == 10 or code == 13:
i++
continue
end
if code == 61:
if pad == 0: pad_at = i end
pad++
if pad == 3: extra_pad_at = i end
i++
continue
end
v := _b64val(code)
if v < 0:
throw _enc_err(s, ErrorKind.Syntax, "invalid " + _byte_desc(code), i, "base64")
end
if pad > 0:
throw _enc_err(s, ErrorKind.Syntax, "data after '=' padding", i, "base64")
end
digits++
acc = (acc << 6) | v
nbits += 6
if nbits >= 8:
nbits -= 8
b := (acc >> nbits) & 255
if cap < 0:
str.BufAppendChar(sb, b)
else written < cap:
op[written] = b as u8
end
written++
acc &= ((1 << nbits) - 1)
end
i++
end
r := digits % 4
if r == 1:
throw _enc_err(s, ErrorKind.UnexpectedEnd, "input ends one character into a group of four", n, "base64")
end
if pad > 0:
mut need := 0
if r == 2: need = 2 end
if r == 3: need = 1 end
if need == 0:
throw _enc_err(s, ErrorKind.Syntax, "unexpected '=' padding", pad_at, "base64")
end
if pad < need:
throw _enc_err(s, ErrorKind.UnexpectedEnd, "missing '=' padding", n, "base64")
end
if pad > need:
mut at := extra_pad_at
if need == 1:
mut j := pad_at + 1
until j < n and _ub(bp, j) != 61:
j++
end
at = j
end
throw _enc_err(s, ErrorKind.Syntax, "too much '=' padding", at, "base64")
end
end
ret written
end
func _b64_encode_bytes(p: void*, n: int): str:
alpha := "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
ap := _bp(alpha)
dp := p as i8*
mut sb := str.NewBuilder()
defer str.BufFree(sb)
mut i := 0
until i < n:
b0 := _ub(dp, i)
mut b1 := 0
mut b2 := 0
if i + 1 < n: b1 = _ub(dp, i + 1) end
if i + 2 < n: b2 = _ub(dp, i + 2) end
str.BufAppendChar(sb, _ub(ap, b0 / 4))
str.BufAppendChar(sb, _ub(ap, (b0 % 4) * 16 + b1 / 16))
if i + 1 < n:
str.BufAppendChar(sb, _ub(ap, (b1 % 16) * 4 + b2 / 64))
else:
str.BufAppendChar(sb, 61)
end
if i + 2 < n:
str.BufAppendChar(sb, _ub(ap, b2 % 64))
else:
str.BufAppendChar(sb, 61)
end
i += 3
end
out := str.BufStr(sb)
ret out
end
@en "Base64Encode"
@fa "کدگذاری پایه۶۴"
pub func Base64Encode(data: str): str:
ret _b64_encode_bytes(data as void*, data.len())
end
@en "Base64EncodeBytes"
@fa "کدگذاری بایت‌ها پایه۶۴"
pub func Base64EncodeBytes(data: void*, n: int): str:
ret _b64_encode_bytes(data, n)
end
@en "Base64Decode"
@fa "کدگشایی پایه۶۴"
pub func Base64Decode(s: str): str throws:
mut sb := str.NewBuilder()
defer str.BufFree(sb)
try _b64_decode_into(s, sb, null, 0 - 1)
out := str.BufStr(sb)
ret out
end
@en "HexEncode"
@fa "کدگذاری شانزده"
pub func HexEncode(data: str): str:
digits := "0123456789abcdef"
hp := _bp(digits)
dp := _bp(data)
n := data.len()
mut sb := str.NewBuilder()
defer str.BufFree(sb)
repeat n in i:
b := _ub(dp, i)
str.BufAppendChar(sb, _ub(hp, b / 16))
str.BufAppendChar(sb, _ub(hp, b % 16))
end
out := str.BufStr(sb)
ret out
end
@en "HexVal"
@fa "مقدار شانزده"
pub inline pure func HexVal(c: str): int: ret _hexval(char_code(c)) end
@en "HexDecode"
@fa "کدگشایی شانزده"
pub func HexDecode(s: str): str throws:
n := s.len()
bp := _bp(s)
mut sb := str.NewBuilder()
defer str.BufFree(sb)
mut i := 0
until i < n:
hi := _hexval(_ub(bp, i))
if hi < 0:
throw _enc_err(s, ErrorKind.Syntax, "invalid " + _byte_desc(_ub(bp, i)), i, "hex")
end
if i + 1 >= n:
throw _enc_err(s, ErrorKind.UnexpectedEnd, "odd number of hex digits", n, "hex")
end
lo := _hexval(_ub(bp, i + 1))
if lo < 0:
throw _enc_err(s, ErrorKind.Syntax, "invalid " + _byte_desc(_ub(bp, i + 1)), i + 1, "hex")
end
str.BufAppendChar(sb, hi * 16 + lo)
i += 2
end
out := str.BufStr(sb)
ret out
end
@en "URLEncode"
@fa "کدگذاری نشانی"
pub func URLEncode(s: str): str:
digits := "0123456789ABCDEF"
hp := _bp(digits)
bp := _bp(s)
n := s.len()
mut sb := str.NewBuilder()
defer str.BufFree(sb)
repeat n in i:
code := _ub(bp, i)
if _url_safe(code):
str.BufAppendChar(sb, code)
else:
str.BufAppendChar(sb, 37)
str.BufAppendChar(sb, _ub(hp, code / 16))
str.BufAppendChar(sb, _ub(hp, code % 16))
end
end
out := str.BufStr(sb)
ret out
end
@en "URLDecode"
@fa "کدگشایی نشانی"
pub func URLDecode(s: str): str throws:
n := s.len()
bp := _bp(s)
mut sb := str.NewBuilder()
defer str.BufFree(sb)
mut i := 0
until i < n:
code := _ub(bp, i)
if code == 37:
if i + 1 < n and _hexval(_ub(bp, i + 1)) < 0:
throw _enc_err(s, ErrorKind.Syntax, "malformed percent escape", i, "url")
end
if i + 2 < n and _hexval(_ub(bp, i + 2)) < 0:
throw _enc_err(s, ErrorKind.Syntax, "malformed percent escape", i, "url")
end
if i + 2 >= n:
throw _enc_err(s, ErrorKind.UnexpectedEnd, "incomplete percent escape", i, "url")
end
str.BufAppendChar(sb, _hexval(_ub(bp, i + 1)) * 16 + _hexval(_ub(bp, i + 2)))
i += 3
else:
if code == 43:
str.BufAppendChar(sb, 32)
else:
str.BufAppendChar(sb, code)
end
i++
end
end
out := str.BufStr(sb)
ret out
end
@en "Base64DecodeBytes"
@fa "کدگشایی پایه۶۴ به بایت"
pub func Base64DecodeBytes(s: str, out: void*, cap: int): int throws:
mut sb := str.NewBuilder()
defer str.BufFree(sb)
mut room := cap
if room < 0: room = 0 end
written := try _b64_decode_into(s, sb, out as u8*, room)
if written > room:
throw Error.New(ErrorKind.OutOfRange, "decoded data needs " + written + " bytes but the buffer holds " + room).wrap("base64")
end
ret written
end
@en "envfile"
@fa "پرونده محیط"
package envfile
import collections
const _LITERAL := 0
const _EXPANDABLE := 1
@en "Doc"
@fa "سند"
pub struct Doc:
@en "m"
@fa "نگاشت"
pub m: collections.OrderedMap = collections.OrderedMap {}
@en "flags"
@fa "پرچم‌های جایگذاری"
pub flags: Vector<int> = Vector {}
end
inline pure func _bp(s: str): i8*: ret (s as void*) as i8* end
inline pure func _ub(bp: i8*, i: int): int:
mut v := bp[i] as int
if v < 0: v += 256 end
ret v
end
func _push(d &: Doc, key: str, val: str, flag: int):
i := d.m.set(key, val)
if i == d.flags.len():
d.flags.push(flag)
else:
d.flags.set(i, flag)
end
end
@en "New"
@fa "جدید"
pub func New(): Doc:
ret Doc {}
end
@en "Len"
@fa "طول"
pub func Len(d &: Doc): int: ret d.m.len() end
@en "Has"
@fa "دارد"
pub func Has(d &: Doc, key: str): bool: ret d.m.has(key) end
@en "Get"
@fa "دریافت"
pub func Get(d &: Doc, key: str): str: ret d.m.get(key) end
@en "GetOr"
@fa "دریافت با پیش فرض"
pub func GetOr(d &: Doc, key: str, def: str): str: ret d.m.get_or(key, def) end
@en "Set"
@fa "تنظیم"
pub func Set(d &: Doc, key: str, val: str):
_push(d, key, val, _LITERAL)
end
@en "Remove"
@fa "حذف"
pub func Remove(d &: Doc, key: str): bool:
i := d.m.remove(key)
if i < 0: ret false end
d.flags.remove_at(i)
ret true
end
@en "KeyAt"
@fa "کلید در"
pub func KeyAt(d &: Doc, i: int): str: ret d.m.key_at(i) end
@en "ValueAt"
@fa "مقدار در"
pub func ValueAt(d &: Doc, i: int): str: ret d.m.val_at(i) end
@en "Keys"
@fa "کلیدها"
pub func Keys(d &: Doc): Vector<str>:
ret d.m.clone_keys()
end
@en "MergeInto"
@fa "ادغام در"
pub func MergeInto(dst &: Doc, src &: Doc):
repeat src.m.len() in i:
_push(dst, src.m.key_at(i), src.m.val_at(i), src.flags.get(i))
end
end
@en "Free"
@fa "آزادسازی"
pub func Free(d &: Doc):
d.m.free()
d.flags.free()
end
package envfile
import str
import collections
struct _DR:
pub name: str = ""
pub def: str = ""
pub has_def: bool = false
pub colon: bool = false
pub next: int = 0
pub ok: bool = false
end
func _is_var_char(c: int): bool:
if c >= 48 and c <= 57: ret true end
if c >= 65 and c <= 90: ret true end
if c >= 97 and c <= 122: ret true end
ret c == 95
end
func _read_var(s: str, i: int, dotted: bool, endpos &: int): str:
n := s.len()
bp := _bp(s)
endpos = i
if i >= n: ret "" end
first := _ub(bp, i)
if _is_var_char(first) == false or (first >= 48 and first <= 57): ret "" end
mut p := i
until p < n:
c := _ub(bp, p)
mut good := _is_var_char(c)
if dotted and c == 46: good = true end
if good == false: break end
p++
end
endpos = p
ret s.substr(i, p - i)
end
func _ref_braced(s: str, i: int): _DR:
n := s.len()
bp := _bp(s)
mut p := 0
name := _read_var(s, i + 2, true, p)
if name.len() == 0: ret _DR { next = i + 1 } end
mut colon := false
mut has_def := false
mut defval := ""
if p < n and _ub(bp, p) == 58:
colon = true
p++
end
if p < n and _ub(bp, p) == 45:
p++
start := p
until p < n and _ub(bp, p) != 125:
p++
end
defval = s.substr(start, p - start)
has_def = true
end
if p >= n or _ub(bp, p) != 125: ret _DR { next = i + 1 } end
ret _DR { name = name, def = defval, has_def = has_def, colon = colon, next = p + 1, ok = true }
end
func _ref_at(s: str, i: int): _DR:
n := s.len()
if i + 1 >= n: ret _DR { next = i + 1 } end
if _ub(_bp(s), i + 1) == 123: ret _ref_braced(s, i) end
mut p := 0
name := _read_var(s, i + 1, false, p)
if name.len() == 0: ret _DR { next = i + 1 } end
ret _DR { name = name, next = p, ok = true }
end
func _lookup(name: str, d &: Doc, base &: Doc, found &: bool): str:
found = true
i := d.m.index_of(name)
if i >= 0: ret d.m.val_at(i) end
j := base.m.index_of(name)
if j >= 0: ret base.m.val_at(j) end
found = false
ret ""
end
func _resolve(r: _DR, d &: Doc, base &: Doc): str:
mut found := false
v := _lookup(r.name, d, base, found)
if found:
if v.len() > 0: ret v end
if r.colon and r.has_def: ret r.def end
ret v
end
if r.has_def: ret r.def end
ret ""
end
func _expand_one(raw: str, d &: Doc, base &: Doc): str:
n := raw.len()
bp := _bp(raw)
mut sb := str.NewBuilder()
defer str.BufFree(sb)
mut p := 0
until p < n:
c := _ub(bp, p)
if c == 92 and p + 1 < n and _ub(bp, p + 1) == 36:
str.BufAppendChar(sb, 36)
p += 2
continue
end
if c != 36:
str.BufAppendChar(sb, c)
p++
continue
end
r := _ref_at(raw, p)
if r.ok == false:
str.BufAppendChar(sb, c)
p++
continue
end
str.BufAppend(sb, _resolve(r, d, base))
p = r.next
end
out := str.BufStr(sb)
ret out
end
func _collect_refs(raw: str, out &: Vector<str>):
n := raw.len()
bp := _bp(raw)
mut p := 0
until p < n:
c := _ub(bp, p)
if c == 92 and p + 1 < n and _ub(bp, p + 1) == 36:
p += 2
continue
end
if c != 36:
p++
continue
end
r := _ref_at(raw, p)
if r.ok and collections.contains(out, r.name) == false:
out.push(r.name)
end
if r.next > p: p = r.next else:
p++
end
end
end
@en "ExpandDoc"
@fa "گسترش سند"
pub func ExpandDoc(d &: Doc, base &: Doc): Doc:
mut out := Doc {}
repeat d.m.len() in i:
k := d.m.key_at(i)
v := d.m.val_at(i)
if d.flags.get(i) == _LITERAL:
_push(out, k, v, _LITERAL)
else:
ev := _expand_one(v, out, base)
_push(out, k, ev, _LITERAL)
end
end
ret out
end
@en "Expand"
@fa "گسترش"
pub func Expand(raw: str, d &: Doc, base &: Doc): str:
ret _expand_one(raw, d, base)
end
@en "RefNames"
@fa "نام‌های ارجاع"
pub func RefNames(d &: Doc): Vector<str>:
mut out := Vector {} as Vector<str>
repeat d.m.len() in i:
if d.flags.get(i) == _EXPANDABLE:
_collect_refs(d.m.val_at(i), out)
end
end
ret out
end
@en "RefNamesIn"
@fa "نام‌های ارجاع در"
pub func RefNamesIn(raw: str): Vector<str>:
mut out := Vector {} as Vector<str>
_collect_refs(raw, out)
ret out
end
package envfile
import str
func _special(c: int): bool:
if c == 32 or c == 9 or c == 10 or c == 13: ret true end
ret c == 35 or c == 59 or c == 34 or c == 39 or c == 36 or c == 92
end
func _needs_quotes(v: str): bool:
n := v.len()
if n == 0: ret false end
if str.Trim(v) != v: ret true end
bp := _bp(v)
repeat n in i:
if _special(_ub(bp, i)): ret true end
end
ret false
end
func _escape_dq(v: str): str:
n := v.len()
bp := _bp(v)
mut sb := str.NewBuilder()
defer str.BufFree(sb)
repeat n in i:
c := _ub(bp, i)
if c == 92 or c == 34 or c == 36:
str.BufAppendChar(sb, 92)
str.BufAppendChar(sb, c)
else c == 10:
str.BufAppend(sb, "\\n")
else c == 13:
str.BufAppend(sb, "\\r")
else c == 9:
str.BufAppend(sb, "\\t")
else:
str.BufAppendChar(sb, c)
end
end
out := str.BufStr(sb)
ret out
end
func _format(d &: Doc, prefix: str): str:
mut b := str.NewBuilder()
defer str.BufFree(b)
repeat d.m.len() in i:
str.BufAppend(b, prefix)
str.BufAppend(b, d.m.key_at(i))
str.BufAppend(b, "=")
str.BufAppend(b, Quote(d.m.val_at(i)))
str.BufAppend(b, "\n")
end
out := str.BufStr(b)
ret out
end
@en "Quote"
@fa "نقل قول"
pub func Quote(v: str): str:
if _needs_quotes(v) == false: ret v end
ret `"`.concat(_escape_dq(v)).concat(`"`)
end
@en "Format"
@fa "قالب"
pub func Format(d &: Doc): str:
ret _format(d, "")
end
@en "FormatExport"
@fa "قالب صادراتی"
pub func FormatExport(d &: Doc): str:
ret _format(d, "export ")
end
package envfile
import str
import mem
struct _DV:
pub value: str = ""
pub next: int = 0
pub flag: int = 1
pub ok: bool = true
pub at: int = -1
end
func _slice(s: str, i: int, ln: int): str:
if ln <= 0: ret "" end
p := mem.AllocateZeroed((ln + 1) as u64)
bp := _bp(s)
src := ((bp as u64) + (i as u64)) as void*
mem.Copy(p, src, ln as u64)
ret p as str
end
func _is_hspace(c: int): bool: ret c == 32 or c == 9 end
func _is_eol(c: int): bool: ret c == 10 or c == 13 end
func _is_key_char(c: int): bool:
if c >= 48 and c <= 57: ret true end
if c >= 65 and c <= 90: ret true end
if c >= 97 and c <= 122: ret true end
ret c == 95 or c == 46 or c == 45
end
func _skip_bom(s: str, n: int, i: int): int:
if n < 3: ret i end
bp := _bp(s)
if _ub(bp, 0) == 239 and _ub(bp, 1) == 187 and _ub(bp, 2) == 191: ret i + 3 end
ret i
end
func _skip_hspace(s: str, n: int, i: int): int:
bp := _bp(s)
mut p := i
until p < n and _is_hspace(_ub(bp, p)):
p++
end
ret p
end
func _skip_to_eol(s: str, n: int, i: int): int:
bp := _bp(s)
mut p := i
until p < n and _is_eol(_ub(bp, p)) == false:
p++
end
if p < n and _ub(bp, p) == 13: p++ end
if p < n and _ub(bp, p) == 10: p++ end
ret p
end
func _skip_blank(s: str, n: int, i: int): int:
bp := _bp(s)
mut p := i
until p < n:
c := _ub(bp, p)
if _is_hspace(c) or _is_eol(c):
p++
else c == 35:
p = _skip_to_eol(s, n, p)
else:
ret p
end
end
ret p
end
func _skip_export(s: str, n: int, i: int): int:
if i + 7 > n: ret i end
bp := _bp(s)
word := "export "
wp := _bp(word)
repeat 7 in k:
if _ub(bp, i + k) != _ub(wp, k): ret i end
end
ret _skip_hspace(s, n, i + 7)
end
func _escape_char(c: int): int:
if c == 110: ret 10 end
if c == 114: ret 13 end
if c == 116: ret 9 end
if c == 98: ret 8 end
if c == 102: ret 12 end
if c == 118: ret 11 end
if c == 92 or c == 34 or c == 39: ret c end
ret 0 - 1
end
func _append_escape(sb &: str.StringBuilder, s: str, p: int): int:
c := _ub(_bp(s), p)
e := _escape_char(c)
if e < 0:
str.BufAppendChar(sb, 92)
str.BufAppendChar(sb, c)
else:
str.BufAppendChar(sb, e)
end
ret p + 1
end
func _read_key(s: str, n: int, i: int): _DV:
bp := _bp(s)
mut p := i
until p < n and _is_key_char(_ub(bp, p)):
p++
end
ret _DV { value = _slice(s, i, p - i), next = p, ok = p > i }
end
func _read_quoted(s: str, n: int, i: int, q: int): _DV:
bp := _bp(s)
mut sb := str.NewBuilder()
defer str.BufFree(sb)
mut p := i
mut closed := false
until p < n:
c := _ub(bp, p)
if c == q:
p++
closed = true
break
end
if c == 92 and q == 34 and p + 1 < n:
p = _append_escape(sb, s, p + 1)
else:
str.BufAppendChar(sb, c)
p++
end
end
out := str.BufStr(sb)
mut flag := _EXPANDABLE
if q == 39: flag = _LITERAL end
ret _DV { value = out, next = _skip_to_eol(s, n, p), flag = flag, ok = closed }
end
func _read_bare(s: str, n: int, i: int, semi: bool): _DV:
bp := _bp(s)
mut p := i
mut cut := i
until p < n:
c := _ub(bp, p)
if _is_eol(c): break end
if (c == 35 or (semi and c == 59)) and p > i and _is_hspace(_ub(bp, p - 1)): break end
p++
if _is_hspace(c) == false: cut = p end
end
ret _DV { value = _slice(s, i, cut - i), next = _skip_to_eol(s, n, p), ok = true }
end
func _read_value(s: str, n: int, i: int, semi: bool): _DV:
if i >= n: ret _DV { value = "", next = i, ok = true } end
c := _ub(_bp(s), i)
if c == 34 or c == 39: ret _read_quoted(s, n, i + 1, c) end
if _is_eol(c): ret _DV { value = "", next = _skip_to_eol(s, n, i), ok = true } end
ret _read_bare(s, n, i, semi)
end
func _parse_entry(d &: Doc, s: str, n: int, i: int): _DV:
bp := _bp(s)
k := _read_key(s, n, _skip_export(s, n, i))
p := _skip_hspace(s, n, k.next)
if k.ok == false or p >= n or _ub(bp, p) != 61:
ret _DV { value = "envfile: expected KEY=VALUE", next = _skip_to_eol(s, n, i), ok = false }
end
vstart := _skip_hspace(s, n, p + 1)
v := _read_value(s, n, vstart, false)
if v.ok == false:
ret _DV { value = "envfile: unterminated quoted value", next = v.next, ok = false, at = vstart }
end
_push(d, k.value, v.value, v.flag)
ret _DV { value = "", next = v.next, ok = true }
end
func _parse_into(d &: Doc, text: str, err &: Error, strict: bool):
n := text.len()
mut p := _skip_bom(text, n, 0)
until p < n:
p = _skip_blank(text, n, p)
if p >= n: ret end
r := _parse_entry(d, text, n, p)
if r.ok == false and strict:
msg := r.value.starts_with("envfile: ") ? r.value.substr(9, r.value.len() - 9) : r.value
err = Error.At(ErrorKind.Syntax, msg, r.at >= 0 ? r.at : p)
ret
end
if r.next > p:
p = r.next
else:
p = _skip_to_eol(text, n, p)
end
end
end
@en "ParseRaw"
@fa "تجزیه خام"
pub func ParseRaw(text: str): Doc:
mut out := Doc {}
mut err := Error {}
_parse_into(out, text, err, false)
ret out
end
@en "Parse"
@fa "تجزیه"
pub func Parse(text: str): Doc:
mut raw := ParseRaw(text)
defer Free(raw)
mut base := Doc {}
defer Free(base)
ret ExpandDoc(raw, base)
end
@en "ParseStrict"
@fa "تجزیه سخت گیرانه"
pub func ParseStrict(text: str): Doc throws:
mut raw := Doc {}
mut err := Error {}
_parse_into(raw, text, err, true)
defer Free(raw)
if err.message != "":
throw err.locate(text).wrap("envfile")
end
mut base := Doc {}
defer Free(base)
ret ExpandDoc(raw, base)
end
@en "Valid"
@fa "معتبر"
pub func Valid(text: str): bool:
try:
mut d := ParseStrict(text)
Free(d)
ret true
catch:
ret false
end
end
@en "ParseScalar"
@fa "تجزیه مقدار"
pub func ParseScalar(raw: str): str:
ret ParseScalarEx(raw, false)
end
@en "ParseScalarEx"
@fa "تجزیه مقدار گسترده"
pub func ParseScalarEx(raw: str, semi: bool): str:
n := raw.len()
v := _read_value(raw, n, _skip_hspace(raw, n, 0), semi)
ret v.value
end
