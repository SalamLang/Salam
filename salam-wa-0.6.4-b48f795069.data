cv.state.cells = mem.Allocate((nc * 16) as u64) as int*
else:
cv.state.cells = mem.Reallocate(cv.state.cells as void*, (nc * 16) as u64) as int*
end
cv.state.cell_cap = nc
end
i = cv.state.r_n
cv.state.r_n++
k := i * 4
cv.state.cells[k] = xx
cv.state.cells[k + 1] = 0
cv.state.cells[k + 2] = 0
cv.state.cells[k + 3] = cv.state.heads[row]
cv.state.heads[row] = i
if y < cv.state.r_ymin:
cv.state.r_ymin = y
end
if y > cv.state.r_ymax:
cv.state.r_ymax = y
end
end
cv.state.r_cur = i
cv.state.r_curx = xx
cv.state.r_cury = y
k := i * 4
cv.state.cells[k + 1] += cover
cv.state.cells[k + 2] += area
end
func _ras_scan(cv &: Canvas, ey: int, x1: int, fy1: int, x2: int, fy2: int):
if fy1 == fy2 or ey < cv.state.cy0 or ey >= cv.state.cy1:
ret
end
ex1 := x1 >> 8
ex2 := x2 >> 8
if ex1 == ex2:
b := ex1 << 8
_ras_cell(cv, ex1, ey, fy2 - fy1, (fy2 - fy1) * ((x1 - b) + (x2 - b)))
ret
end
dx := (x2 - x1) as i64
dy := (fy2 - fy1) as i64
mut xa := x1
mut ya := fy1
mut c := ex1
if dx > (0 as i64):
until c < ex2:
bx := (c + 1) << 8
yb := fy1 + ((dy * ((bx - x1) as i64)) / dx) as int
_ras_cell(cv, c, ey, yb - ya, (yb - ya) * ((xa - (c << 8)) + 256))
c++
xa = bx
ya = yb
end
else:
until c > ex2:
bx := c << 8
yb := fy1 + ((dy * ((bx - x1) as i64)) / dx) as int
_ras_cell(cv, c, ey, yb - ya, (yb - ya) * (xa - (c << 8)))
c--
xa = bx
ya = yb
end
end
b := ex2 << 8
_ras_cell(cv, ex2, ey, fy2 - ya, (fy2 - ya) * ((xa - b) + (x2 - b)))
end
func _ras_line(cv &: Canvas, x0: int, y0: int, x1: int, y1: int):
if y0 == y1:
ret
end
ey0 := y0 >> 8
ey1 := y1 >> 8
if ey0 == ey1:
_ras_scan(cv, ey0, x0, y0 - (ey0 << 8), x1, y1 - (ey0 << 8))
ret
end
dx := (x1 - x0) as i64
dy := (y1 - y0) as i64
mut yt := y0
mut xt := x0
if dy > (0 as i64):
mut ey := ey0
until ey <= ey1:
if ey >= cv.state.cy1:
ret
end
yb := _mini((ey + 1) << 8, y1)
xb := x0 + ((dx * ((yb - y0) as i64)) / dy) as int
if ey >= cv.state.cy0:
_ras_scan(cv, ey, xt, yt - (ey << 8), xb, yb - (ey << 8))
end
yt = yb
xt = xb
ey++
end
else:
mut ey := ey0
until ey >= ey1:
if ey < cv.state.cy0:
ret
end
yb := _maxi(ey << 8, y1)
xb := x0 + ((dx * ((yb - y0) as i64)) / dy) as int
if ey < cv.state.cy1:
_ras_scan(cv, ey, xt, yt - (ey << 8), xb, yb - (ey << 8))
end
yt = yb
xt = xb
ey--
end
end
end
func _uline(cv &: Canvas, ax: int, ay: int, bx: int, byy: int):
_ras_line(cv, _xf_x(cv, ax, ay), _xf_y(cv, ax, ay), _xf_x(cv, bx, byy), _xf_y(cv, bx, byy))
end
inline func _wind(v: i64, evenodd: bool): int:
mut c := ((v < (0 as i64) ? (0 as i64) - v : v) >> 9) as int
if evenodd:
c &= 511
if c > 256:
c = 512 - c
end
ret c
end
ret c > 256 ? 256 : c
end
func _ras_sweep(cv &: Canvas, evenodd: bool, kind: int, color: u32):
mut y0 := _maxi(cv.state.r_ymin, cv.state.cy0)
mut y1 := _mini(cv.state.r_ymax + 1, cv.state.cy1)
if cv.state.has_region:
y0 = _maxi(y0, cv.state.rg_y0)
y1 = _mini(y1, cv.state.rg_y1)
end
if y1 <= y0:
ret
end
cells := cv.state.cells
lim0 := cv.state.cx0
lim1 := cv.state.cx1
repeat y1 - y0 in k:
y := y0 + k
mut m := 0
mut i := cv.state.heads[y - cv.state.cy0]
until i >= 0:
m++
i = cells[i * 4 + 3]
end
if m == 0:
continue
end
idx := _cv_tmp(cv, m + 4)
i = cv.state.heads[y - cv.state.cy0]
mut j := 0
until i >= 0:
mut q := j
xi := cells[i * 4]
until q > 0 and cells[idx[q - 1] * 4] > xi:
idx[q] = idx[q - 1]
q--
end
idx[q] = i
j++
i = cells[i * 4 + 3]
end
out := cv.state.ra
mut n := 0
mut acc := 0 as i64
mut prev := lim0 - 2
repeat m in t:
c := idx[t] * 4
x := cells[c]
if acc != (0 as i64) and x > prev + 1:
a := _maxi(prev + 1, lim0)
b := _mini(x, lim1)
if a < b:
n = _rpush(out, n, a, b, _wind(acc * (512 as i64), evenodd))
end
end
cover := cells[c + 1] as i64
v := (acc + cover) * (512 as i64) - (cells[c + 2] as i64)
if x >= lim0:
n = _rpush(out, n, x, x + 1, _wind(v, evenodd))
end
acc += cover
prev = x
end
if acc != (0 as i64):
a := _maxi(prev + 1, lim0)
if a < lim1:
n = _rpush(out, n, a, lim1, _wind(acc * (512 as i64), evenodd))
end
end
_emit(cv, y, n, kind, color)
end
end
func _poly_lines(cv &: Canvas, pts: int*, n: int):
mut area := 0 as i64
repeat n in i:
j := (i + 1) % n
area += (pts[i * 2] as i64) * (pts[j * 2 + 1] as i64) - (pts[j * 2] as i64) * (pts[i * 2 + 1] as i64)
end
repeat n in i:
j := (i + 1) % n
if area >= (0 as i64):
_uline(cv, pts[i * 2], pts[i * 2 + 1], pts[j * 2], pts[j * 2 + 1])
else:
_uline(cv, pts[j * 2], pts[j * 2 + 1], pts[i * 2], pts[i * 2 + 1])
end
end
end
func _fill_path_kind(cv &: Canvas, p: Path, rule: FillRule, kind: int, color: u32):
_cv_ready(cv)
if cv.pixels == null or p.verbs.len() == 0:
ret
end
_flatten(cv, p, _flat_tol(cv))
_ras_begin(cv)
e := cv.state.edges
mut h := 0
until h < cv.state.f_n:
np := e[h]
if np >= 2:
repeat np in i:
j := (i + 1) % np
a := h + 2 + i * 2
b := h + 2 + j * 2
_uline(cv, e[a], e[a + 1], e[b], e[b + 1])
end
end
h += 2 + np * 2
end
_ras_sweep(cv, rule == FillRule.EvenOdd, kind, color)
end
func _flat_tol(cv &: Canvas): int:
mut m := _maxi(_maxi(_absi(cv.state.xa), _absi(cv.state.xb)), _maxi(_absi(cv.state.xc), _absi(cv.state.xd)))
if m < 1:
m = 1
end
t := ((51 as i64) * (65536 as i64) / (m as i64)) as int
ret _clampi(t, 4, 4096)
end
func _cv_fill_path(cv &: Canvas, p: Path, rule: FillRule, c: Color):
col := _premul(c)
if col == (0 as u32):
ret
end
_fill_path_kind(cv, p, rule, _K_SOLID, col)
end
func _circle_poly(cv &: Canvas, cx: int, cy: int, r: int, buf: int*):
mut n := 8 + (7 * (_isqrt(r as i64) as int)) / 16
n = _mini(n, 128)
repeat n in k:
au := (k * 65536) / n
buf[k * 2] = cx + ((((r as i64) * (_cos_au(au) as i64)) >> 16) as int)
buf[k * 2 + 1] = cy + ((((r as i64) * (_sin_au(au) as i64)) >> 16) as int)
end
_poly_lines(cv, buf, n)
end
func _quad_poly(cv &: Canvas, buf: int*, x0: int, y0: int, x1: int, y1: int, x2: int, y2: int, x3: int, y3: int):
buf[0] = x0
buf[1] = y0
buf[2] = x1
buf[3] = y1
buf[4] = x2
buf[5] = y2
buf[6] = x3
buf[7] = y3
_poly_lines(cv, buf, 4)
end
func _seg_normal(ax: int, ay: int, bx: int, byy: int, hw: int, out: int[]): bool:
dx := (bx - ax) as i64
dy := (byy - ay) as i64
len := _isqrt(dx * dx + dy * dy)
if len <= (0 as i64):
ret false
end
out[0] = (((0 as i64) - dy) * (hw as i64) / len) as int
out[1] = (dx * (hw as i64) / len) as int
ret true
end
func _cap(cv &: Canvas, buf: int*, x: int, y: int, nx: int, ny: int, start: bool, cap: LineCap, hw: int):
switch cap:
LineCap.Butt:
break
end
LineCap.Round:
_circle_poly(cv, x, y, hw, buf)
break
end
LineCap.Square:
tx := start ? 0 - ny : ny
ty := start ? nx : 0 - nx
_quad_poly(cv, buf, x + nx, y + ny, x + nx + tx, y + ny + ty, x - nx + tx, y - ny + ty, x - nx, y - ny)
break
end
end
end
func _join(cv &: Canvas, buf: int*, x: int, y: int, n1: int[2], n2: int[2], d1x: int, d1y: int, d2x: int, d2y: int, s: Stroke, hw: int):
cross := (d1x as i64) * (d2y as i64) - (d1y as i64) * (d2x as i64)
dot := (d1x as i64) * (d2x as i64) + (d1y as i64) * (d2y as i64)
if cross == (0 as i64) and dot >= (0 as i64):
ret
end
if s.join == LineJoin.Round:
_circle_poly(cv, x, y, hw, buf)
ret
end
sg := cross > (0 as i64) ? -1 : 1
o1x := n1[0] * sg
o1y := n1[1] * sg
o2x := n2[0] * sg
o2y := n2[1] * sg
buf[0] = x
buf[1] = y
buf[2] = x + o1x
buf[3] = y + o1y
buf[4] = x + o2x
buf[5] = y + o2y
if s.join == LineJoin.Miter:
h2 := (hw as i64) * (hw as i64)
den := h2 + (o1x as i64) * (o2x as i64) + (o1y as i64) * (o2y as i64)
if den > (0 as i64):
mx := (((o1x + o2x) as i64) * h2) / den
my := (((o1y + o2y) as i64) * h2) / den
lim := ((_fx(s.miter_limit) as i64) * (hw as i64)) >> 8
if mx * mx + my * my <= lim * lim:
_quad_poly(cv, buf, x, y, x + o1x, y + o1y, x + (mx as int), y + (my as int), x + o2x, y + o2y)
ret
end
end
end
_poly_lines(cv, buf, 3)
end
func _stroke_poly(cv &: Canvas, pts: int*, m: int, closed: bool, s: Stroke, hw: int, buf: int*):
if m <= 0:
ret
end
if m == 1:
if s.cap == LineCap.Round:
_circle_poly(cv, pts[0], pts[1], hw, buf)
else s.cap == LineCap.Square:
_quad_poly(cv, buf, pts[0] - hw, pts[1] - hw, pts[0] + hw, pts[1] - hw, pts[0] + hw, pts[1] + hw, pts[0] - hw, pts[1] + hw)
end
ret
end
segs := closed ? m : m - 1
mut n1 := [0, 0]
mut n0 := [0, 0]
mut first := [0, 0]
mut fdx := 0
mut fdy := 0
mut pdx := 0
mut pdy := 0
mut have := false
repeat segs in i:
j := (i + 1) % m
ax := pts[i * 2]
ay := pts[i * 2 + 1]
bx := pts[j * 2]
byy := pts[j * 2 + 1]
if not _seg_normal(ax, ay, bx, byy, hw, n1):
continue
end
_quad_poly(cv, buf, ax + n1[0], ay + n1[1], bx + n1[0], byy + n1[1], bx - n1[0], byy - n1[1], ax - n1[0], ay - n1[1])
if have:
_join(cv, buf, ax, ay, n0, n1, pdx, pdy, bx - ax, byy - ay, s, hw)
else:
first[0] = n1[0]
first[1] = n1[1]
fdx = bx - ax
fdy = byy - ay
if not closed:
_cap(cv, buf, ax, ay, n1[0], n1[1], true, s.cap, hw)
end
end
have = true
n0[0] = n1[0]
n0[1] = n1[1]
pdx = bx - ax
pdy = byy - ay
end
if not have:
_stroke_poly(cv, pts, 1, false, s, hw, buf)
ret
end
if closed:
_join(cv, buf, pts[0], pts[1], n0, first, pdx, pdy, fdx, fdy, s, hw)
else:
_cap(cv, buf, pts[(m - 1) * 2], pts[(m - 1) * 2 + 1], n0[0], n0[1], false, s.cap, hw)
end
end
func _dash_flush(cv &: Canvas, piece: int*, pn: int, s: Stroke, hw: int, buf: int*):
if pn >= 2:
_stroke_poly(cv, piece, pn, false, s, hw, buf)
end
end
func _stroke_dashed(cv &: Canvas, pts: int*, m: int, closed: bool, s: Stroke, hw: int, buf: int*, piece: int*):
dash := _fx(s.dash)
gap := _fx(_posf(s.gap))
period := dash + gap
if dash <= 0 or period <= 0:
_stroke_poly(cv, pts, m, closed, s, hw, buf)
ret
end
mut ph := _fx(s.dash_offset) % period
if ph < 0:
ph += period
end
mut dash_on := ph < dash
mut left := dash_on ? dash - ph : period - ph
mut pn := 0
if dash_on:
piece[0] = pts[0]
piece[1] = pts[1]
pn = 1
end
segs := closed ? m : m - 1
repeat segs in i:
j := (i + 1) % m
ax := pts[i * 2]
ay := pts[i * 2 + 1]
bx := pts[j * 2]
byy := pts[j * 2 + 1]
dx := (bx - ax) as i64
dy := (byy - ay) as i64
len := _isqrt(dx * dx + dy * dy) as int
mut pos := 0
until len - pos > left:
pos += left
px := ax + ((dx * (pos as i64)) / (len as i64)) as int
py := ay + ((dy * (pos as i64)) / (len as i64)) as int
if dash_on:
piece[pn * 2] = px
piece[pn * 2 + 1] = py
pn++
_dash_flush(cv, piece, pn, s, hw, buf)
pn = 0
dash_on = false
left = gap
else:
piece[0] = px
piece[1] = py
pn = 1
dash_on = true
left = dash
end
end
left -= len - pos
if dash_on:
piece[pn * 2] = bx
piece[pn * 2 + 1] = byy
pn++
end
end
if dash_on:
_dash_flush(cv, piece, pn, s, hw, buf)
end
end
func _cv_stroke_path(cv &: Canvas, p: Path, s: Stroke, c: Color):
_cv_ready(cv)
col := _premul(c)
if cv.pixels == null or col == (0 as u32) or p.verbs.len() == 0 or not (s.width > 0.0):
ret
end
hw := _maxi(_fx(s.width / 2.0), 1)
_flatten(cv, p, _flat_tol(cv))
_ras_begin(cv)
total := cv.state.f_n
flat := mem.Allocate((total * 4 + 16) as u64) as int*
repeat total in i:
flat[i] = cv.state.edges[i]
end
pts := mem.Allocate((total * 4 + 16) as u64) as int*
piece := mem.Allocate((total * 4 + 16) as u64) as int*
buf := mem.Allocate((300 * 4) as u64) as int*
mut h := 0
until h < total:
np := flat[h]
closed := flat[h + 1] == 1
mut m := 0
repeat np in i:
x := flat[h + 2 + i * 2]
y := flat[h + 3 + i * 2]
if m == 0 or pts[(m - 1) * 2] != x or pts[(m - 1) * 2 + 1] != y:
pts[m * 2] = x
pts[m * 2 + 1] = y
m++
end
end
mut mm := m
if closed and m > 1 and pts[0] == pts[(m - 1) * 2] and pts[1] == pts[(m - 1) * 2 + 1]:
mm = m - 1
end
if s.dash > 0.0:
_stroke_dashed(cv, pts, mm, closed, s, hw, buf, piece)
else:
_stroke_poly(cv, pts, mm, closed, s, hw, buf)
end
h += 2 + np * 2
end
mem.Free(flat as void*)
mem.Free(pts as void*)
mem.Free(piece as void*)
mem.Free(buf as void*)
_ras_sweep(cv, false, _K_SOLID, col)
end
package paint
func _spread_radius(rv: f64, s: f64): f64:
if rv <= 0.0:
ret 0.0
end
if s < 0.0:
ret _posf(rv + s)
end
if rv >= s:
ret rv + s
end
q := rv / s - 1.0
ret rv + s * (1.0 + q * q * q)
end
func _spread_radii(fr: Radii, s: f64): Radii:
ret Radii {
top_left_x = _spread_radius(fr.top_left_x, s), top_left_y = _spread_radius(fr.top_left_y, s),
top_right_x = _spread_radius(fr.top_right_x, s), top_right_y = _spread_radius(fr.top_right_y, s),
bottom_right_x = _spread_radius(fr.bottom_right_x, s), bottom_right_y = _spread_radius(fr.bottom_right_y, s),
bottom_left_x = _spread_radius(fr.bottom_left_x, s), bottom_left_y = _spread_radius(fr.bottom_left_y, s)
}
end
func _band_push(bd: int*, n: int, ya: int, yb: int, xa: int, xb: int): int:
if n > 0:
k := (n - 1) * 4
if bd[k + 2] == xa and bd[k + 3] == xb and bd[k + 1] == ya:
bd[k + 1] = yb
ret n
end
end
k := n * 4
bd[k] = ya
bd[k + 1] = yb
bd[k + 2] = xa
bd[k + 3] = xb
ret n + 1
end
func _band_slices(sh: int*, o: int, bd: int*, n0: int, ya: int, yb: int, bh: int): int:
mut n := n0
mut y := ya
mut e := [0, 0, 0, 0]
until y < yb:
y2 := y + bh < yb ? y + bh : yb
mid := (y + y2) >> 1
_edge(sh, o, mid, 256, false, e)
_edge(sh, o, mid, 256, true, e)
n = _band_push(bd, n, y, y2, e[0], e[2])
y = y2
end
ret n
end
func _shadow_bands(cv &: Canvas, o: int, sig: int): int:
sh := cv.state.sh
y0 := sh[o + 1]
y1 := sh[o + 3]
bh := sig > 256 ? sig : 256
top_end := y0 + _maxi(sh[o + 5], sh[o + 7])
bot_start := y1 - _maxi(sh[o + 9], sh[o + 11])
mut slices := (y1 - y0) / bh + 4
if top_end <= bot_start:
slices = (top_end - y0) / bh + (y1 - bot_start) / bh + 6
end
bd := _cv_bands(cv, slices * 4 + 8)
mut n := 0
if top_end <= bot_start:
n = _band_slices(sh, o, bd, n, y0, top_end, bh)
if bot_start > top_end:
n = _band_push(bd, n, top_end, bot_start, sh[o], sh[o + 2])
end
n = _band_slices(sh, o, bd, n, bot_start, y1, bh)
else:
n = _band_slices(sh, o, bd, n, y0, y1, bh)
end
ret n
end
inline func _phi_d(d: i64, inv: i64): int:
ret _phi((d * inv) >> 16)
end
func _shadow_profiles(cv &: Canvas, nb: int, sig: int, px0: int, pw: int):
bd := cv.state.bands
inv := ((1 as i64) << 32) / (sig as i64)
cv.state.s_inv = inv
prof := _cv_prof(cv, nb * (pw + 2) + 4)
fr := nb * pw
repeat nb in b:
xa := bd[b * 4 + 2] as i64
xb := bd[b * 4 + 3] as i64
base := b * pw
mut fa := px0 + pw
mut fb := px0
repeat pw in i:
xc := (((px0 + i) as i64) << 8) + (128 as i64)
v := _phi_d(xb - xc, inv) - _phi_d(xa - xc, inv)
prof[base + i] = v
if v >= 65536:
if px0 + i < fa:
fa = px0 + i
end
fb = px0 + i + 1
end
end
prof[fr + b * 2] = fa
prof[fr + b * 2 + 1] = fb
end
end
func _shadow_row(cv &: Canvas, y: int):
cv.state.s_lasty = y
bd := cv.state.bands
tmp := cv.state.tmp
prof := cv.state.prof
fr := cv.state.s_n * cv.state.s_pw
inv := cv.state.s_inv
yc := ((y as i64) << 8) + (128 as i64)
mut m := 0
mut sum := 0
mut fa := -2147483647
mut fb := 2147483647
repeat cv.state.s_n in k:
v := _phi_d((bd[k * 4 + 1] as i64) - yc, inv) - _phi_d((bd[k * 4] as i64) - yc, inv)
if v > 0:
tmp[m * 2] = k
tmp[m * 2 + 1] = v
m++
sum += v
fa = _maxi(fa, prof[fr + k * 2])
fb = _mini(fb, prof[fr + k * 2 + 1])
end
end
cv.state.s_act = m
cv.state.s_sum = sum
cv.state.s_fa = fa
cv.state.s_fb = fb
end
inline func _shadow_alpha(cv &: Canvas, acc: i64): u32:
mut al := (acc >> 16) as int
if al > 65536:
al = 65536
end
if al < 0:
al = 0
end
if cv.state.s_inset:
al = 65536 - al
end
f := (al * 255 + 32768) >> 16
c := cv.state.s_col
ret f >= 255 ? c : _mul8(c, f as u32)
end
func _shadow_shade(cv &: Canvas, y: int, a: int, b: int):
if cv.state.s_lasty != y:
_shadow_row(cv, y)
end
tmp := cv.state.tmp
col := cv.state.col
prof := cv.state.prof
pw := cv.state.s_pw
px0 := cv.state.s_px0
m := cv.state.s_act
fa := _maxi(cv.state.s_fa, a)
fb := _mini(cv.state.s_fb, b)
inset := cv.state.s_inset
c := cv.state.s_col
mut x := a
until x < b:
if x == fa and fa < fb:
cc := _shadow_alpha(cv, (cv.state.s_sum as i64) << 16)
repeat fb - fa in i:
col[fa + i] = cc
end
x = fb
continue
end
mut acc := 0 as i64
if x >= px0 and x < px0 + pw:
off := x - px0
if m == 1:
acc = (tmp[1] as i64) * (prof[tmp[0] * pw + off] as i64)
else:
repeat m in k:
acc += (tmp[k * 2 + 1] as i64) * (prof[tmp[k * 2] * pw + off] as i64)
end
end
end
mut al := (acc >> 16) as int
if al > 65536:
al = 65536
end
if al < 0:
al = 0
end
if inset:
al = 65536 - al
end
f := (al * 255 + 32768) >> 16
col[x] = f >= 255 ? c : _mul8(c, f as u32)
x++
end
end
func _cv_shadow(cv &: Canvas, r: Rect, radii: Radii, s: Shadow):
_cv_ready(cv)
if cv.pixels == null:
ret
end
col := _premul(s.color)
if col == (0 as u32):
ret
end
if not _xf_axis(cv):
mut pad := 2.0
if not s.inset:
pad += _maxf(_posf(s.offset_x), _posf(0.0 - s.offset_x)) + _maxf(_posf(s.offset_y), _posf(0.0 - s.offset_y)) + _posf(s.spread) + _posf(s.blur) * 1.5
end
if _lx_begin(cv, r, pad):
_cv_shadow(cv, r, radii, s)
_lx_end(cv)
end
ret
end
sh := cv.state.sh
if not _shape_from(cv, r, radii, sh, 36):
ret
end
fr := FitRadii(r, radii)
sp := s.spread
mut sr := Rect { x = r.x + s.offset_x - sp, y = r.y + s.offset_y - sp, width = r.width + 2.0 * sp, height = r.height + 2.0 * sp }
mut srad := _spread_radii(fr, sp)
if s.inset:
sr = Rect { x = r.x + s.offset_x + sp, y = r.y + s.offset_y + sp, width = r.width - 2.0 * sp, height = r.height - 2.0 * sp }
srad = _spread_radii(fr, 0.0 - sp)
end
has_s := _shape_from(cv, sr, srad, sh, 24)
scale := cv.state.xa < 0 ? 0 - cv.state.xa : cv.state.xa
mut sig := _scale_abs(_fx(_posf(s.blur) / 2.0), scale)
if sig < 16:
sig = 0
end
lim0 := cv.state.cx0
lim1 := cv.state.cx1
if not s.inset:
if not has_s:
ret
end
ext := sig * 3
mut rows := [0, 0]
if not _clip_rows(cv, sh[25] - ext, sh[27] + ext, rows):
ret
end
mut lo := _maxi((sh[24] - ext) >> 8, lim0)
mut hi := _mini((sh[26] + ext + 255) >> 8, lim1)
_region_cols(cv, lo, hi)
if lo >= hi:
ret
end
if sig > 0:
nb := _shadow_bands(cv, 24, sig)
_shadow_profiles(cv, nb, sig, lo, hi - lo)
_cv_tmp(cv, nb * 2 + 4)
cv.state.s_n = nb
cv.state.s_px0 = lo
cv.state.s_pw = hi - lo
cv.state.s_sig = sig
cv.state.s_inset = false
cv.state.s_col = col
cv.state.s_lasty = -2147483647
end
repeat rows[1] - rows[0] in k:
y := rows[0] + k
nbx := _shape_row(sh, 36, y, lim0, lim1, cv.state.rb)
if sig > 0:
n := _runs_invert(cv.state.rb, nbx, lo, hi, cv.state.ra)
_emit(cv, y, n, _K_SHADOW, 0 as u32)
else:
ns := _shape_row(sh, 24, y, lim0, lim1, cv.state.rc)
ni := _runs_invert(cv.state.rb, nbx, lo, hi, cv.state.ra)
n := _runs_mul(cv.state.rc, ns, cv.state.ra, ni, cv.state.rb)
_copy_runs(cv.state.rb, cv.state.ra, n)
_emit(cv, y, n, _K_SOLID, col)
end
end
ret
end
mut rows := [0, 0]
if not _clip_rows(cv, sh[37], sh[39], rows):
ret
end
mut lo := _maxi(sh[36] >> 8, lim0)
mut hi := _mini((sh[38] + 255) >> 8, lim1)
_region_cols(cv, lo, hi)
if lo >= hi:
ret
end
if has_s and sig > 0:
nb := _shadow_bands(cv, 24, sig)
_shadow_profiles(cv, nb, sig, lo, hi - lo)
_cv_tmp(cv, nb * 2 + 4)
cv.state.s_n = nb
cv.state.s_px0 = lo
cv.state.s_pw = hi - lo
cv.state.s_sig = sig
cv.state.s_inset = true
cv.state.s_col = col
cv.state.s_lasty = -2147483647
end
repeat rows[1] - rows[0] in k:
y := rows[0] + k
nbx := _shape_row(sh, 36, y, lim0, lim1, cv.state.ra)
if not has_s:
_emit(cv, y, nbx, _K_SOLID, col)
else sig > 0:
_emit(cv, y, nbx, _K_SHADOW, 0 as u32)
else:
ns := _shape_row(sh, 24, y, lim0, lim1, cv.state.rc)
ni := _runs_invert(cv.state.rc, ns, lo, hi, cv.state.rb)
n := _runs_mul(cv.state.ra, nbx, cv.state.rb, ni, cv.state.rc)
_copy_runs(cv.state.rc, cv.state.ra, n)
_emit(cv, y, n, _K_SOLID, col)
end
end
end
func _copy_runs(src: int*, dst: int*, n: int):
repeat n * 3 in i:
dst[i] = src[i]
end
end
package paint
func _edge(sh: int*, o: int, ys: int, vh: int, right: bool, e: int[]):
x0 := sh[o]
y0 := sh[o + 1]
x1 := sh[o + 2]
y1 := sh[o + 3]
mut rx := 0
mut ry := 0
mut dy := 0
if right:
if sh[o + 6] > 0 and ys < y0 + sh[o + 7]:
rx = sh[o + 6]
ry = sh[o + 7]
dy = y0 + ry - ys
else sh[o + 8] > 0 and ys > y1 - sh[o + 9]:
rx = sh[o + 8]
ry = sh[o + 9]
dy = ys - (y1 - ry)
end
else:
if sh[o + 4] > 0 and ys < y0 + sh[o + 5]:
rx = sh[o + 4]
ry = sh[o + 5]
dy = y0 + ry - ys
else sh[o + 10] > 0 and ys > y1 - sh[o + 11]:
rx = sh[o + 10]
ry = sh[o + 11]
dy = ys - (y1 - ry)
end
end
k := right ? 2 : 0
if rx <= 0:
e[k] = right ? x1 : x0
e[k + 1] = 256
ret
end
r64 := ry as i64
d64 := dy as i64
s := _isqrt(r64 * r64 - d64 * d64)
xo := (((rx as i64) * s) / r64) as int
mut w := 0
if s <= (0 as i64):
w = 2 * xo
else:
ratio := ((rx as i64) * d64) / r64
mut slope := ((vh as i64) * ratio) / s
if slope > (16777216 as i64):
slope = 16777216 as i64
end
w = _isqrt((65536 as i64) + slope * slope) as int
if w > 2 * xo:
w = 2 * xo
end
end
if w < 256:
w = 256
end
e[k] = right ? x1 - rx + xo : x0 + rx - xo
e[k + 1] = w
end
inline func _cov_lr(x: int, pl: int, wl: int, pr: int, wr: int): int:
px := ((x as i64) << 8) + (128 as i64)
mut cl := (128 as i64) + ((px - (pl as i64)) << 8) / (wl as i64)
if cl < (0 as i64):
ret 0
end
if cl > (256 as i64):
cl = 256 as i64
end
mut cr := (128 as i64) + (((pr as i64) - px) << 8) / (wr as i64)
if cr < (0 as i64):
ret 0
end
if cr > (256 as i64):
cr = 256 as i64
end
v := (cl + cr - (256 as i64)) as int
ret v > 0 ? v : 0
end
func _ramp(out: int*, n0: int, a: int, b: int, e: int[4], vh: int, lim0: int, lim1: int): int:
mut n := n0
s := a > lim0 ? a : lim0
t := b < lim1 ? b : lim1
if s >= t:
ret n
end
repeat t - s in i:
x := s + i
c := (_cov_lr(x, e[0], e[1], e[2], e[3]) * vh) >> 8
n = _rpush(out, n, x, x + 1, c)
end
ret n
end
func _edges_row(e: int[4], vh: int, lim0: int, lim1: int, out: int*, n0: int): int:
lo := (e[0] - e[1] / 2) >> 8
l1 := (e[0] + e[1] / 2 + 255) >> 8
r0 := (e[2] - e[3] / 2) >> 8
hi := (e[2] + e[3] / 2 + 255) >> 8
mut n := n0
if l1 <= r0:
n = _ramp(out, n, lo, l1, e, vh, lim0, lim1)
a := l1 > lim0 ? l1 : lim0
b := r0 < lim1 ? r0 : lim1
if a < b:
n = _rpush(out, n, a, b, vh)
end
n = _ramp(out, n, r0, hi, e, vh, lim0, lim1)
else:
n = _ramp(out, n, lo < r0 ? lo : r0, l1 > hi ? l1 : hi, e, vh, lim0, lim1)
end
ret n
end
func _row_edges(sh: int*, o: int, y: int, e: int[]): int:
y0 := sh[o + 1]
y1 := sh[o + 3]
Y0 := y << 8
Y1 := Y0 + 256
if Y1 <= y0 or Y0 >= y1 or sh[o + 2] <= sh[o]:
ret 0
end
ya := Y0 > y0 ? Y0 : y0
yb := Y1 < y1 ? Y1 : y1
vh := yb - ya
ys := (ya + yb) >> 1
_edge(sh, o, ys, vh, false, e)
_edge(sh, o, ys, vh, true, e)
ret vh
end
func _shape_row(sh: int*, o: int, y: int, lim0: int, lim1: int, out: int*): int:
mut e := [0, 0, 0, 0]
vh := _row_edges(sh, o, y, e)
if vh <= 0:
ret 0
end
ret _edges_row(e, vh, lim0, lim1, out, 0)
end
func _fill_rounded_kind(cv &: Canvas, r: Rect, radii: Radii, kind: int, col: u32):
if not _xf_axis(cv):
mut p := Path {}
p.AddRoundedRect(r, radii)
_fill_path_kind(cv, p, FillRule.NonZero, kind, col)
p.Free()
ret
end
sh := cv.state.sh
if not _shape_from(cv, r, radii, sh, 0):
ret
end
mut rows := [0, 0]
if not _clip_rows(cv, sh[1], sh[3], rows):
ret
end
repeat rows[1] - rows[0] in k:
y := rows[0] + k
n := _shape_row(sh, 0, y, cv.state.cx0, cv.state.cx1, cv.state.ra)
_emit(cv, y, n, kind, col)
end
end
func _cv_fill_rounded(cv &: Canvas, r: Rect, radii: Radii, c: Color):
_cv_ready(cv)
if cv.pixels == null:
ret
end
col := _premul(c)
if col == (0 as u32):
ret
end
_fill_rounded_kind(cv, r, radii, _K_SOLID, col)
end
