package transport
import mem
import sync
import chan
import net.tunnel
@en "MuxMaxPacket"
@fa "بیشینه بسته چندگانه ساز"
pub const MuxMaxPacket := 8192
struct _MuxCore:
pub up: dyn tunnel.Stream = tunnel.TcpStream {}
pub wmu: sync.Mutex = sync.Mutex {}
pub tmu: sync.Mutex = sync.Mutex {}
pub table: i64* = null
pub st: i64* = null
pub incoming: chan.Chan<MuxIncoming> = chan.Chan {} as chan.Chan<MuxIncoming>
pub server: bool = false
end
struct _MuxSess:
pub id: int = 0
pub rx: chan.Chan<Bytes> = chan.Chan {} as chan.Chan<Bytes>
pub st: i64* = null
pub core: _MuxCore* = null
end
struct _MuxStream:
pub s: _MuxSess = _MuxSess {}
pub func Read(max: int): str:
buf := mem.Allocate((max + 1) as u64)
n := _mux_read(this.s, buf, max)
if n <= 0:
mem.Free(buf)
ret ""
end
bp := buf as u8*
bp[n] = 0 as u8
ret buf as str
end
pub func ReadBytes(buf: void*, max: int): int:
ret _mux_read(this.s, buf, max)
end
pub func Write(data: str): int:
ret _mux_write(this.s, data as void*, data.len())
end
pub func WriteBytes(ptr: void*, n: int): int:
ret _mux_write(this.s, ptr, n)
end
pub func SetDeadline(millis: int):
this.s.st[5] = millis as i64
end
pub func Shutdown():
_mux_end(this.s)
end
pub func CloseWrite():
_mux_end(this.s)
end
pub func Close():
_mux_end(this.s)
end
pub func Ok(): bool:
ret this.s.st[1] == 0 as i64 and this.s.core[0].st[1] == 0 as i64
end
end
@en "MuxIncoming"
@fa "نشست پذیرفته"
pub struct MuxIncoming:
@en "stream"
@fa "جریان"
pub stream: dyn tunnel.Stream = tunnel.TcpStream {}
@en "addr"
@fa "نشانی"
pub addr: Addr = Addr {}
@en "udp"
@fa "یو دی پی"
pub udp: bool = false
end
@en "Mux"
@fa "چندگانه ساز"
pub struct Mux:
@en "core"
@fa "هسته"
pub core: void* = null
@en "ok"
@fa "معتبر"
pub ok: bool = false
end
func _up_read_full(up: dyn tunnel.Stream, buf: void*, n: int): bool:
mut got := 0
until got < n:
r := up.ReadBytes(((buf as i64) + (got as i64)) as void*, n - got)
if r <= 0:
ret false
end
got += r
end
ret true
end
func _mux_send(core: _MuxCore, b: Bytes): bool:
sync.Lock(core.wmu)
mut ok := core.st[1] == 0 as i64
if ok:
ok = core.up.WriteBytes(b.p, b.len) == b.len
end
sync.Unlock(core.wmu)
ret ok
end
func _mux_find(core: _MuxCore, id: int, out &: _MuxSess): bool:
mut found := false
sync.Lock(core.tmu)
repeat 256 in i:
pv := core.table[i]
if pv != 0 as i64:
sp := pv as _MuxSess*
if sp[0].id == id:
out = sp[0]
found = true
break
end
end
end
sync.Unlock(core.tmu)
ret found
end
func _mux_register(core: _MuxCore, s: _MuxSess): bool:
mut done := false
sync.Lock(core.tmu)
repeat 256 in i:
if core.table[i] == 0 as i64:
sp := mem.AllocateZeroed(sizeof(_MuxSess) as u64) as _MuxSess*
sp[0] = s
core.table[i] = sp as i64
done = true
break
end
end
sync.Unlock(core.tmu)
ret done
end
func _mux_unregister(core: _MuxCore, id: int):
sync.Lock(core.tmu)
repeat 256 in i:
pv := core.table[i]
if pv != 0 as i64:
sp := pv as _MuxSess*
if sp[0].id == id:
core.table[i] = 0 as i64
mem.Free(sp as void*)
break
end
end
end
sync.Unlock(core.tmu)
end
func _mux_new_sess(core: _MuxCore*, id: int): _MuxSess:
mut s := _MuxSess {}
s.id = id
s.rx.init(64)
s.st = mem.AllocateZeroed(64 as u64) as i64*
s.core = core
ret s
end
func _mux_frame(id: int, status: int, opt: int, extra: Bytes, data: void*, dn: int): Bytes:
mut b := NewBytes(dn + extra.len + 16)
Put16(b, 4 + extra.len)
Put16(b, id)
Put8(b, status)
Put8(b, opt)
PutBytes(b, extra)
if dn >= 0 and opt == 1:
Put16(b, dn)
PutRaw(b, data, dn)
end
ret b
end
func _mux_end(s: _MuxSess):
if s.st[1] != 0 as i64:
ret
end
s.st[1] = 1 as i64
core := s.core[0]
if core.st[1] == 0 as i64:
mut f := _mux_frame(s.id, 3, 0, Bytes {}, null, 0 - 1)
_mux_send(core, f)
FreeBytes(f)
end
chan.Close(s.rx)
_mux_unregister(core, s.id)
end
func _mux_write(s: _MuxSess, p: void*, n: int): int:
if s.st[1] != 0 as i64 or s.core[0].st[1] != 0 as i64:
ret 0 - 1
end
if s.st[7] != 0 as i64 and n > MuxMaxPacket:
ret 0 - 1
end
mut off := 0
until off < n:
mut take := n - off
if take > 16384:
take = 16384
end
mut f := _mux_frame(s.id, 2, 1, Bytes {}, ((p as i64) + (off as i64)) as void*, take)
ok := _mux_send(s.core[0], f)
FreeBytes(f)
if not ok:
ret 0 - 1
end
off += take
end
ret n
end
func _mux_read(s: _MuxSess, buf: void*, max: int): int:
if s.st[2] != 0 as i64 and s.st[4] < s.st[3]:
mut take := (s.st[3] - s.st[4]) as int
if take > max:
take = max
end
mem.Copy(buf, (s.st[2] + s.st[4]) as void*, take as u64)
s.st[4] += take as i64
if s.st[4] >= s.st[3]:
mem.Free(s.st[2] as void*)
s.st[2] = 0 as i64
end
ret take
end
if s.st[0] != 0 as i64:
ret 0
end
mut ok := false
mut b := Bytes {}
if s.st[5] > 0 as i64:
b = chan.RecvTimeout(s.rx, ok, s.st[5])
else:
b = chan.Recv(s.rx, ok)
end
if not ok:
if chan.IsClosed(s.rx):
s.st[0] = 1 as i64
end
ret 0
end
if b.len == 0:
FreeBytes(b)
ret 0
end
mut take := b.len
if take > max:
take = max
end
mem.Copy(buf, b.p, take as u64)
if take < b.len:
keep := mem.Allocate((b.len - take) as u64)
mem.Copy(keep, BytesPtr(b, take), (b.len - take) as u64)
s.st[2] = keep as i64
s.st[3] = (b.len - take) as i64
s.st[4] = 0 as i64
end
FreeBytes(b)
ret take
end
func _mux_eof_all(core: _MuxCore):
sync.Lock(core.tmu)
repeat 256 in i:
pv := core.table[i]
if pv != 0 as i64:
sp := pv as _MuxSess*
chan.Close(sp[0].rx)
end
end
sync.Unlock(core.tmu)
end
func _mux_reader(a: _MuxCore*):
core := a[0]
lenb := mem.Allocate(2 as u64) as u8*
meta := mem.Allocate(600 as u64) as u8*
until true:
if not _up_read_full(core.up, lenb as void*, 2):
break
end
n := (lenb[0] as int) * 256 + (lenb[1] as int)
if n < 4 or n > 512:
break
end
if not _up_read_full(core.up, meta as void*, n):
break
end
id := (meta[0] as int) * 256 + (meta[1] as int)
status := meta[2] as int
opt := meta[3] as int
mut data := Bytes {}
if (opt & 1) != 0:
if not _up_read_full(core.up, lenb as void*, 2):
break
end
dl := (lenb[0] as int) * 256 + (lenb[1] as int)
data = NewBytes(dl + 1)
if dl > 0 and not _up_read_full(core.up, data.p, dl):
FreeBytes(data)
break
end
data.len = dl
end
mut sess := _MuxSess {}
if status == 1:
if core.server and n >= 9:
view := Bytes { p = meta as void*, len = n, cap = n }
mut ad := Addr {}
e := ReadAddr(view, 5, ad)
if e > 0:
s := _mux_new_sess(a, id)
if _mux_register(core, s):
inc := MuxIncoming { stream = _MuxStream { s = s }, addr = ad, udp = (meta[4] as int) == 2 }
s.st[6] = 1 as i64
if inc.udp:
s.st[7] = 1 as i64
end
if not chan.TrySend(core.incoming, inc):
_mux_end(s)
else data.len > 0:
chan.Send(s.rx, data)
data = Bytes {}
end
end
end
end
else status == 2:
if (opt & 1) != 0 and _mux_find(core, id, sess):
if data.len > 0:
chan.Send(sess.rx, data)
data = Bytes {}
end
end
else status == 3:
if _mux_find(core, id, sess):
chan.Close(sess.rx)
sess.st[1] = 1 as i64
_mux_unregister(core, id)
end
end
FreeBytes(data)
end
core.st[1] = 1 as i64
_mux_eof_all(core)
chan.Close(core.incoming)
mem.Free(lenb as void*)
mem.Free(meta as void*)
end
func _mux_new(up: dyn tunnel.Stream, server: bool): Mux:
a := mem.AllocateZeroed(sizeof(_MuxCore) as u64) as _MuxCore*
mut c := _MuxCore {}
c.up = up
c.wmu = sync.NewMutex()
c.tmu = sync.NewMutex()
c.table = mem.AllocateZeroed(2048 as u64) as i64*
c.st = mem.AllocateZeroed(64 as u64) as i64*
c.st[0] = 1 as i64
c.server = server
c.incoming.init(32)
a[0] = c
if not tunnel.Go(_mux_reader, a as void*):
up.Close()
ret Mux {}
end
ret Mux { core = a as void*, ok = true }
end
@en "NewMuxClient"
@fa "چندگانه ساز کارخواه جدید"
pub func NewMuxClient(up: dyn tunnel.Stream): Mux:
ret _mux_new(up, false)
end
@en "NewMuxServer"
@fa "چندگانه ساز کارساز جدید"
pub func NewMuxServer(up: dyn tunnel.Stream): Mux:
ret _mux_new(up, true)
end
@en "MuxOpen"
@fa "باز کردن نشست"
pub func MuxOpen(m: Mux, addr: Addr, udp: bool): dyn tunnel.Stream:
a := m.core as _MuxCore*
core := a[0]
mut s := _mux_new_sess(a, 0)
sync.Lock(core.tmu)
id := core.st[0] as int
core.st[0]++
if core.st[0] > 65535 as i64:
core.st[0] = 1 as i64
end
sync.Unlock(core.tmu)
s.id = id
if udp:
s.st[7] = 1 as i64
end
if core.st[1] != 0 as i64 or not _mux_register(core, s):
s.st[1] = 1 as i64
ret _MuxStream { s = s }
end
mut extra := NewBytes(32)
if udp:
Put8(extra, 2)
else:
Put8(extra, 1)
end
if not PutAddr(extra, addr):
s.st[1] = 1 as i64
FreeBytes(extra)
ret _MuxStream { s = s }
end
mut f := _mux_frame(id, 1, 0, extra, null, 0 - 1)
ok := _mux_send(core, f)
FreeBytes(f)
FreeBytes(extra)
if not ok:
s.st[1] = 1 as i64
end
ret _MuxStream { s = s }
end
@en "MuxAccept"
@fa "پذیرش نشست"
pub func MuxAccept(m: Mux, out &: MuxIncoming): bool:
a := m.core as _MuxCore*
mut ok := false
inc := chan.Recv(a[0].incoming, ok)
if ok:
out = inc
end
ret ok
end
@en "MuxOk"
@fa "چندگانه ساز معتبر"
pub func MuxOk(m: Mux): bool:
if not m.ok:
ret false
end
a := m.core as _MuxCore*
ret a[0].st[1] == 0 as i64
end
@en "MuxClose"
@fa "بستن چندگانه ساز"
pub func MuxClose(m: Mux):
if not m.ok:
ret
end
a := m.core as _MuxCore*
a[0].up.Shutdown()
end
@en "net/transport"
@fa "انتقال شبکه"
package transport
import mem
@en "Bytes"
@fa "بایت‌ها"
pub struct Bytes:
@en "p"
@fa "نشانگر"
pub p: void* = null
@en "len"
@fa "طول"
pub len: int = 0
@en "cap"
@fa "ظرفیت"
pub cap: int = 0
@en "bad"
@fa "خراب"
pub bad: bool = false
end
inline func _ptr_at(p: void*, off: int): void*:
ret ((p as i64) + (off as i64)) as void*
end
func _hexval(c: int): int:
if c >= 48 and c <= 57: ret c - 48 end
if c >= 97 and c <= 102: ret c - 87 end
if c >= 65 and c <= 70: ret c - 55 end
ret 0 - 1
end
@en "NewBytes"
@fa "بایت‌های جدید"
pub func NewBytes(cap0: int): Bytes:
mut c := cap0
if c < 32: c = 32 end
p := mem.AllocateZeroed(c as u64)
if p == null:
ret Bytes { p = null, len = 0, cap = 0, bad = true }
end
ret Bytes { p = p, len = 0, cap = c, bad = false }
end
@en "FreeBytes"
@fa "آزادسازی بایت‌ها"
pub func FreeBytes(b &: Bytes):
if b.p != null:
mem.Set(b.p, 0, b.cap as u64)
mem.Free(b.p)
end
b.p = null
b.len = 0
b.cap = 0
end
@en "ResetBytes"
@fa "بازنشانی بایت‌ها"
pub func ResetBytes(b &: Bytes):
b.len = 0
end
@en "BytesPtr"
@fa "نشانگر بایت‌ها"
pub func BytesPtr(b: Bytes, off: int): void*:
ret _ptr_at(b.p, off)
end
@en "Reserve"
@fa "رزرو"
pub func Reserve(b &: Bytes, need: int):
if b.bad: ret end
if b.len + need <= b.cap: ret end
mut nc := b.cap
if nc < 32: nc = 32 end
until b.len + need > nc:
nc *= 2
end
np := mem.Reallocate(b.p, nc as u64)
if np == null:
b.bad = true
ret
end
b.p = np
b.cap = nc
end
@en "Put8"
@fa "نوشتن بایت"
pub func Put8(b &: Bytes, v: int):
Reserve(b, 1)
if b.bad: ret end
bp := b.p as u8*
bp[b.len] = (v & 0xFF) as u8
b.len++
end
@en "Put16"
@fa "نوشتن شانزده بیت"
pub func Put16(b &: Bytes, v: int):
Put8(b, (v >> 8) & 0xFF)
Put8(b, v & 0xFF)
end
@en "Put32"
@fa "نوشتن سی‌ودو بیت"
pub func Put32(b &: Bytes, v: i64):
Put8(b, ((v >> 24) & 0xFF) as int)
Put8(b, ((v >> 16) & 0xFF) as int)
Put8(b, ((v >> 8) & 0xFF) as int)
Put8(b, (v & 0xFF) as int)
end
@en "Put64"
@fa "نوشتن شصت‌وچهار بیت"
pub func Put64(b &: Bytes, v: u64):
repeat 8 in i:
sh := ((7 - i) * 8) as u64
Put8(b, ((v >> sh) & (0xFF as u64)) as int)
end
end
@en "PutRaw"
@fa "نوشتن خام"
pub func PutRaw(b &: Bytes, src: void*, n: int):
if n <= 0: ret end
Reserve(b, n)
if b.bad: ret end
mem.Copy(_ptr_at(b.p, b.len), src, n as u64)
b.len += n
end
@en "PutBytes"
@fa "نوشتن بایت‌ها"
pub func PutBytes(b &: Bytes, src: Bytes):
PutRaw(b, src.p, src.len)
end
@en "PutStr"
@fa "نوشتن رشته"
pub func PutStr(b &: Bytes, s: str):
PutRaw(b, s as void*, s.len())
end
@en "PutZeros"
@fa "نوشتن صفرها"
pub func PutZeros(b &: Bytes, n: int):
if n <= 0: ret end
Reserve(b, n)
if b.bad: ret end
mem.Set(_ptr_at(b.p, b.len), 0, n as u64)
b.len += n
end
@en "At"
@fa "بایت در"
pub func At(b: Bytes, i: int): int:
if i < 0 or i >= b.len: ret 0 end
bp := b.p as u8*
ret bp[i] as int
end
@en "Set8"
@fa "تنظیم بایت"
pub func Set8(b &: Bytes, i: int, v: int):
if i < 0 or i >= b.len: ret end
bp := b.p as u8*
bp[i] = (v & 0xFF) as u8
end
@en "Peek16"
@fa "خواندن شانزده بیت"
pub func Peek16(b: Bytes, i: int): int:
ret (At(b, i) << 8) | At(b, i + 1)
end
@en "Peek32"
@fa "خواندن سی‌ودو بیت"
pub func Peek32(b: Bytes, i: int): i64:
ret ((At(b, i) as i64) << (24 as i64)) | ((At(b, i + 1) as i64) << (16 as i64)) | ((At(b, i + 2) as i64) << (8 as i64)) | (At(b, i + 3) as i64)
end
@en "Consume"
@fa "مصرف"
pub func Consume(b &: Bytes, n: int):
if n <= 0: ret end
if n >= b.len:
b.len = 0
ret
end
mem.MemMove(b.p, _ptr_at(b.p, n), (b.len - n) as u64)
b.len -= n
end
@en "Equal"
@fa "برابر"
pub func Equal(a: Bytes, b: Bytes): bool:
if a.len != b.len: ret false end
mut diff := 0
repeat a.len in i:
diff |= At(a, i) ^ At(b, i)
end
ret diff == 0
end
@en "ToHex"
@fa "به هگزا"
pub func ToHex(b: Bytes): str:
dp := "0123456789abcdef" as u8*
n := b.len * 2
out := mem.Allocate((n + 1) as u64)
op := out as u8*
repeat b.len in i:
v := At(b, i)
op[2 * i] = dp[(v >> 4) & 15]
op[2 * i + 1] = dp[v & 15]
end
op[n] = 0 as u8
ret out as str
end
@en "FromHex"
@fa "از هگزا"
pub func FromHex(h: str): Bytes:
mut b := NewBytes(h.len() / 2 + 1)
hp := h as u8*
repeat h.len() / 2 in i:
hi := _hexval(hp[2 * i] as int)
lo := _hexval(hp[2 * i + 1] as int)
if hi < 0 or lo < 0:
b.bad = true
ret b
end
Put8(b, hi * 16 + lo)
end
ret b
end
@en "FromStr"
@fa "از رشته"
pub func FromStr(s: str): Bytes:
mut b := NewBytes(s.len() + 1)
PutStr(b, s)
ret b
end
package trojan
import mem
import compress
import crypto
import net.tunnel
@en "Connector"
@fa "اتصال‌دهنده"
pub struct Connector:
@en "server"
@fa "نشانی کارساز"
pub server: tunnel.Addr = tunnel.Addr {}
@en "password"
@fa "گذرواژه"
pub password: str = ""
@en "Server"
@fa "کارساز"
pub func Server(): tunnel.Addr:
ret this.server
end
@en "Handshake"
@fa "دست‌دهی"
pub func Handshake(s: dyn tunnel.Stream, target: tunnel.Addr): bool:
mut hdr := EncodeRequest(this.password, CmdConnect, target.host, target.port)
ok := tunnel.WriteAllBytes(s, hdr.data, hdr.len)
compress.BufFree(hdr)
ret ok
end
@en "Name"
@fa "نام"
pub func Name(): str:
ret "trojan"
end
end
@en "Inbound"
@fa "پذیرنده تروجان"
pub struct Inbound:
@en "hashes"
@fa "درهم گذرواژه‌ها"
pub hashes: Vector<str> = Vector {}
@en "replies"
@fa "شمار پاسخ‌ها"
pub replies: int = 0
@en "Name"
@fa "نام"
pub func Name(): str:
ret "trojan"
end
@en "Handshake"
@fa "دست‌دهی"
pub func Handshake(s: dyn tunnel.Stream): tunnel.Session:
mut seen := compress.NewByteBuf()
defer compress.BufFree(seen)
cap := 2048
tmp := mem.Allocate(cap as u64)
defer mem.Free(tmp)
until true:
n := s.ReadBytes(tmp, cap)
if n <= 0:
break
end
compress.BufPushBytes(seen, tmp, n)
r := ParseRequest(seen.data, seen.len)
if r.status == ParseInvalid:
break
end
if r.status == ParseOK:
mut known := false
repeat this.hashes.len() in i:
if crypto.SecretEquals(this.hashes.get(i), r.hash):
known = true
end
end
if not known:
break
end
rest := seen.len - r.consumed
mut sess := tunnel.Session { ok = true, target = tunnel.NewAddr(r.host, r.port), protocol = "trojan", user = r.hash, command = r.cmd }
if rest > 0:
sess.initial_data = mem.Allocate(rest as u64)
mem.Copy(sess.initial_data, ((seen.data as i64) + (r.consumed as i64)) as void*, rest as u64)
sess.initial_size = rest
end
ret sess
end
end
mut seen_text := ""
if seen.len > 0:
seen_text = _mkstr(seen.data, 0, seen.len)
end
ret tunnel.Session { error = "trojan authentication failed", initial = seen_text }
end
@en "Reply"
@fa "پاسخ"
pub func Reply(_s: dyn tunnel.Stream, _sess: tunnel.Session, _ok: bool):
this.replies++
end
end
@en "NewConnector"
@fa "اتصال‌دهنده جدید"
pub func NewConnector(server_host: str, server_port: int, password: str): Connector:
ret Connector { server = tunnel.NewAddr(server_host, server_port), password = password }
end
@en "NewInbound"
@fa "پذیرنده جدید"
pub func NewInbound(): Inbound:
ret Inbound {}
end
@en "InboundAddPassword"
@fa "افزودن گذرواژه به پذیرنده"
pub func InboundAddPassword(inb &: Inbound, password: str):
inb.hashes.push(PasswordHash(password))
end
package trojan
import net.tcp
import net.websocket
import compress
import tls
@en "ClientConfig"
@fa "پیکربندی کارخواه"
pub struct ClientConfig:
@en "server_host"
@fa "میزبان کارساز"
pub server_host: str = ""
@en "server_port"
@fa "درگاه کارساز"
pub server_port: int = 443
@en "password"
@fa "گذرواژه"
pub password: str = ""
@en "sni"
@fa "نام سرور"
pub sni: str = ""
@en "alpn"
@fa "پروتکل برنامه"
pub alpn: str = ""
@en "insecure"
@fa "ناامن"
pub insecure: bool = false
@en "use_tls"
@fa "با تی ال اس"
pub use_tls: bool = true
@en "use_ws"
@fa "با وب‌سوکت"
pub use_ws: bool = false
@en "ws_path"
@fa "مسیر وب‌سوکت"
pub ws_path: str = "/"
@en "lazy_header"
@fa "سرآیند همراه نخستین داده"
pub lazy_header: bool = false
@en "timeout_ms"
@fa "مهلت اتصال"
pub timeout_ms: int = 10000
end
func _open_transport(cfg: ClientConfig): Link:
if cfg.use_ws:
if cfg.use_tls:
if cfg.insecure:
ret NewWSLink(websocket.DialWSSUnverified(cfg.server_host, cfg.server_port, cfg.ws_path, ""))
end
ret NewWSLink(websocket.DialWSS(cfg.server_host, cfg.server_port, cfg.ws_path))
end
ret NewWSLink(websocket.Dial(cfg.server_host, cfg.server_port, cfg.ws_path))
end
if not cfg.use_tls:
ret NewTCPLink(tcp.DialTimeout(cfg.server_host, cfg.server_port, cfg.timeout_ms))
end
mut name := cfg.sni
if name.len() == 0:
name = cfg.server_host
end
mut tc := tls.NewConfig(name)
tc.insecure_skip_verify = cfg.insecure
tc.alpn = cfg.alpn
ret NewTLSLink(tls.Dial(cfg.server_host, cfg.server_port, tc))
end
func _open_with(cfg: ClientConfig, cmd: int, host: str, port: int): Link:
mut l := _open_transport(cfg)
if not LinkOk(l):
ret l
end
mut hdr := EncodeRequest(cfg.password, cmd, host, port)
if cfg.lazy_header:
l.pending = hdr
ret l
end
ok := LinkWriteBuf(l, hdr)
compress.BufFree(hdr)
if not ok:
LinkClose(l)
end
ret l
end
@en "NewClientConfig"
@fa "پیکربندی کارخواه جدید"
pub func NewClientConfig(server_host: str, server_port: int, password: str): ClientConfig:
ret ClientConfig { server_host = server_host, server_port = server_port, password = password }
end
@en "Dial"
@fa "شماره گیری"
pub func Dial(cfg: ClientConfig, host: str, port: int): Link:
ret _open_with(cfg, CmdConnect, host, port)
end
@en "DialUDP"
@fa "شماره گیری یو دی پی"
pub func DialUDP(cfg: ClientConfig): Link:
ret _open_with(cfg, CmdUDP, "0.0.0.0", 0)
end
@en "SendUDP"
@fa "ارسال یو دی پی"
pub func SendUDP(l &: Link, host: str, port: int, p: void*, n: int): bool:
ret WriteUDPPacket(l, host, port, p, n)
end
package trojan
import mem
import net.tcp
import net.websocket
import net.internal.rawsock
import compress
import tls
@en "LinkTCP"
@fa "پیوند تی سی پی"
pub const LinkTCP := 0
@en "LinkTLS"
@fa "پیوند تی ال اس"
pub const LinkTLS := 1
@en "LinkWS"
@fa "پیوند وب‌سوکت"
pub const LinkWS := 2
struct Pipe:
pub src: Link* = null
pub dst: Link* = null
pub bytes: i64 = 0
end
@en "Link"
@fa "پیوند"
pub struct Link:
@en "kind"
@fa "نوع"
pub kind: int = 0
@en "tc"
@fa "اتصال تی سی پی"
pub tc: tcp.Conn = tcp.Conn {}
@en "sc"
@fa "اتصال امن"
pub sc: tls.Conn = tls.Conn {}
@en "ws"
@fa "اتصال وب‌سوکت"
pub ws: websocket.Conn = websocket.Conn {}
@en "rbuf"
@fa "بافر خواندن"
pub rbuf: compress.ByteBuf = compress.ByteBuf {}
@en "roff"
@fa "جایگاه خواندن"
pub roff: int = 0
@en "ubuf"
@fa "بافر یو دی پی"
pub ubuf: compress.ByteBuf = compress.ByteBuf {}
@en "pending"
@fa "سرآیند معلق"
pub pending: compress.ByteBuf = compress.ByteBuf {}
end
func _fd_of(l: Link): i64:
if l.kind == LinkTCP:
ret l.tc.fd
else l.kind == LinkTLS:
ret tls.Fd(l.sc)
end
ret l.ws.fd
end
func _flush_pending(l &: Link): bool:
if l.pending.len == 0:
ret true
end
mut hdr := l.pending
l.pending = compress.ByteBuf {}
ok := _write_raw(l, hdr.data, hdr.len)
compress.BufFree(hdr)
ret ok
end
func _write_raw(l &: Link, p: void*, n: int): bool:
mut off := 0
until off < n:
src := ((p as i64) + (off as i64)) as void*
mut w := 0
if l.kind == LinkTCP:
w = tcp.WriteBytes(l.tc, src, n - off)
else l.kind == LinkTLS:
w = tls.WriteBytes(l.sc, src, n - off)
else:
if not l.ws.open:
ret false
end
r := websocket.SendBinaryBytes(l.ws, src, n - off)
if r < 0:
ret false
end
w = n - off
end
if w <= 0:
ret false
end
off += w
end
ret true
end
func _seed_udp(l &: Link, p: void*, n: int):
if n > 0:
compress.BufPushBytes(l.ubuf, p, n)
end
end
func _pump(pp: Pipe*):
src := pp[0].src
dst := pp[0].dst
cap := 16384
buf := mem.Allocate(cap as u64)
until true:
n := LinkRead(src[0], buf, cap)
if n <= 0:
break
end
if not LinkWrite(dst[0], buf, n):
break
end
pp[0].bytes += n as i64
end
mem.Free(buf)
LinkShutdown(src[0])
LinkShutdown(dst[0])
end
@en "NewTCPLink"
@fa "پیوند تی سی پی جدید"
pub func NewTCPLink(c: tcp.Conn): Link:
ret Link { kind = LinkTCP, tc = c }
end
@en "NewTLSLink"
@fa "پیوند تی ال اس جدید"
pub func NewTLSLink(c: tls.Conn): Link:
ret Link { kind = LinkTLS, sc = c }
end
@en "NewWSLink"
@fa "پیوند وب‌سوکت جدید"
pub func NewWSLink(c: websocket.Conn): Link:
ret Link { kind = LinkWS, ws = c }
end
@en "LinkOk"
@fa "پیوند معتبر"
pub func LinkOk(l: Link): bool:
if l.kind == LinkTCP:
ret tcp.ConnOk(l.tc)
else l.kind == LinkTLS:
ret tls.ConnOk(l.sc)
end
ret l.ws.open
end
@en "LinkFd"
@fa "توصیفگر پیوند"
pub func LinkFd(l: Link): i64:
ret _fd_of(l)
end
@en "LinkRead"
@fa "خواندن پیوند"
pub func LinkRead(l &: Link, buf: void*, max: int): int:
if l.roff < l.rbuf.len:
mut take := l.rbuf.len - l.roff
if take > max:
take = max
end
mem.Copy(buf, ((l.rbuf.data as i64) + (l.roff as i64)) as void*, take as u64)
l.roff += take
if l.roff >= l.rbuf.len:
compress.BufReset(l.rbuf)
l.roff = 0
end
ret take
end
if l.kind == LinkTCP:
n := tcp.ReadBytes(l.tc, buf, max)
if n < 0:
ret 0
end
ret n
else l.kind == LinkTLS:
ret tls.ReadBytes(l.sc, buf, max)
end
until true:
if not l.ws.open:
ret 0
end
m := websocket.Receive(l.ws)
if m.kind == websocket.BINARY or m.kind == websocket.TEXT:
if m.kind == websocket.BINARY:
compress.BufPushBytes(l.rbuf, m.data, m.len)
else:
compress.BufPushBytes(l.rbuf, m.text as void*, m.text.len())
end
if l.rbuf.len > 0:
ret LinkRead(l, buf, max)
end
else m.kind == websocket.CLOSE or m.kind == websocket.NONE:
ret 0
end
end
end
@en "LinkWrite"
@fa "نوشتن پیوند"
pub func LinkWrite(l &: Link, p: void*, n: int): bool:
if n <= 0:
ret true
end
if l.pending.len > 0:
if not _flush_pending(l):
ret false
end
end
ret _write_raw(l, p, n)
end
@en "LinkWriteBuf"
@fa "نوشتن بافر پیوند"
pub func LinkWriteBuf(l &: Link, b: compress.ByteBuf): bool:
ret LinkWrite(l, b.data, b.len)
end
@en "LinkWriteStr"
@fa "نوشتن متن پیوند"
pub func LinkWriteStr(l &: Link, s: str): bool:
ret LinkWrite(l, s as void*, s.len())
end
@en "LinkSetTimeout"
@fa "تنظیم مهلت پیوند"
pub func LinkSetTimeout(l: Link, millis: int):
fd := _fd_of(l)
if fd >= 0:
rawsock.SetTimeout(rawsock.FromFd(fd), millis)
end
end
@en "LinkShutdown"
@fa "خاموش کردن پیوند"
pub func LinkShutdown(l: Link):
fd := _fd_of(l)
if fd >= 0:
rawsock.Shutdown(rawsock.FromFd(fd))
end
end
@en "LinkClose"
@fa "بستن پیوند"
pub func LinkClose(l &: Link):
if l.kind == LinkTCP:
tcp.Close(l.tc)
else l.kind == LinkTLS:
tls.Close(l.sc)
else:
websocket.Close(l.ws)
end
compress.BufFree(l.rbuf)
compress.BufFree(l.ubuf)
compress.BufFree(l.pending)
l.roff = 0
end
@en "Relay"
@fa "رله"
pub func Relay(a: Link*, b: Link*): i64:
pa := mem.AllocateZeroed(sizeof(Pipe) as u64) as Pipe*
pb := mem.AllocateZeroed(sizeof(Pipe) as u64) as Pipe*
pa[0] = Pipe { src = a, dst = b, bytes = 0 }
pb[0] = Pipe { src = b, dst = a, bytes = 0 }
t := spawn(_pump, pa)
_pump(pb)
join(t)
total := pa[0].bytes + pb[0].bytes
mem.Free(pa as void*)
mem.Free(pb as void*)
ret total
end
@en "NewUDPPacket"
@fa "بسته یو دی پی جدید"
pub func NewUDPPacket(): UDPPacket:
ret UDPPacket {}
end
@en "ReadUDPPacket"
@fa "خواندن بسته یو دی پی"
pub func ReadUDPPacket(l &: Link, pkt &: UDPPacket, payload &: compress.ByteBuf): bool:
cap := 4096
tmp := mem.Allocate(cap as u64)
defer mem.Free(tmp)
until true:
if l.ubuf.len > 0:
r := ParseUDPPacket(l.ubuf.data, l.ubuf.len)
if r.status == ParseInvalid:
ret false
end
if r.status == ParseOK:
compress.BufReset(payload)
src := ((l.ubuf.data as i64) + (r.payload_off as i64)) as void*
compress.BufPushBytes(payload, src, r.payload_len)
rest := l.ubuf.len - r.consumed
if rest > 0:
mem.MemMove(l.ubuf.data, ((l.ubuf.data as i64) + (r.consumed as i64)) as void*, rest as u64)
end
l.ubuf.len = rest
pkt = r
ret true
end
end
n := LinkRead(l, tmp, cap)
if n <= 0:
ret false
end
compress.BufPushBytes(l.ubuf, tmp, n)
end
end
@en "WriteUDPPacket"
@fa "نوشتن بسته یو دی پی"
pub func WriteUDPPacket(l &: Link, host: str, port: int, p: void*, n: int): bool:
mut b := EncodeUDPPacket(host, port, p, n)
ok := LinkWrite(l, b.data, b.len)
compress.BufFree(b)
ret ok
end
package trojan
import mem
import net.tcp
import net.udp
import net.websocket
import compress
import crypto
import sync
import atomic
import tls
import net.internal.rawsock
import net.tunnel
@en "ModeTLS"
@fa "حالت تی ال اس"
pub const ModeTLS := 0
@en "ModePlain"
@fa "حالت ساده"
pub const ModePlain := 1
@en "ModeWS"
@fa "حالت وب‌سوکت"
pub const ModeWS := 2
struct ServerState:
pub cfg: ServerConfig = ServerConfig {}
pub tlscfg: tls.ServerConfig = tls.ServerConfig {}
pub use_tls: bool = true
pub ws: bool = false
pub listen_fd: i64 = 0 - 1
pub port: int = 0
pub stop: i64* = null
pub counters: i64* = null
pub limits: tunnel.ConnLimits = tunnel.ConnLimits {}
end
struct ConnArg:
pub st: ServerState* = null
pub adm: tunnel.Admit = tunnel.Admit {}
pub fd: i64 = 0 - 1
end
struct UdpState:
pub link: Link* = null
pub sock: udp.Socket = udp.Socket {}
pub stop: i64* = null
pub stats: tunnel.Stats = tunnel.Stats {}
end
@en "LinkStream"
@fa "جریان پیوند"
pub struct LinkStream:
@en "link"
@fa "پیوند"
pub link: Link* = null
@en "Read"
@fa "خواندن"
pub func Read(max: int): str:
buf := mem.Allocate((max + 1) as u64)
n := LinkRead(this.link[0], buf, max)
if n <= 0:
mem.Free(buf)
ret ""
end
(buf as u8*)[n] = 0 as u8
ret buf as str
end
@en "ReadBytes"
@fa "خواندن بایت"
pub func ReadBytes(buf: void*, max: int): int:
ret LinkRead(this.link[0], buf, max)
end
@en "Write"
@fa "نوشتن"
pub func Write(data: str): int:
if LinkWrite(this.link[0], data as void*, data.len()):
ret data.len()
end
ret 0 - 1
end
@en "WriteBytes"
@fa "نوشتن بایت"
pub func WriteBytes(ptr: void*, n: int): int:
if LinkWrite(this.link[0], ptr, n):
ret n
end
ret 0 - 1
end
@en "SetDeadline"
@fa "تنظیم مهلت"
pub func SetDeadline(millis: int):
LinkSetTimeout(this.link[0], millis)
end
@en "Shutdown"
@fa "خاموش کردن"
pub func Shutdown():
LinkShutdown(this.link[0])
end
@en "CloseWrite"
@fa "بستن نوشتن"
pub func CloseWrite():
LinkShutdown(this.link[0])
end
@en "Close"
@fa "بستن"
pub func Close():
LinkShutdown(this.link[0])
end
@en "Ok"
@fa "معتبر"
pub func Ok(): bool:
ret LinkOk(this.link[0])
end
end
@en "ServerConfig"
@fa "پیکربندی کارساز"
pub struct ServerConfig:
@en "cert_file"
@fa "پرونده گواهی"
pub cert_file: str = ""
@en "key_file"
@fa "پرونده کلید"
pub key_file: str = ""
@en "hashes"
@fa "درهم گذرواژه‌ها"
pub hashes: Vector<str> = Vector {}
@en "fallback_host"
@fa "میزبان جایگزین"
pub fallback_host: str = ""
@en "fallback_port"
@fa "درگاه جایگزین"
pub fallback_port: int = 0
@en "max_per_source"
@fa "بیشینه دست دادن مبدا"
pub max_per_source: int = 32
@en "handshake_timeout_ms"
@fa "مهلت دست‌دهی"
pub handshake_timeout_ms: int = 5000
@en "connect_timeout_ms"
@fa "مهلت اتصال مقصد"
pub connect_timeout_ms: int = 10000
@en "idle_timeout_ms"
@fa "مهلت بیکاری"
pub idle_timeout_ms: int = 0
@en "mode"
@fa "حالت"
pub mode: int = 0
@en "bind_host"
@fa "میزبان شنود"
pub bind_host: str = ""
@en "dialer"
@fa "شماره‌گیر"
pub dialer: dyn tunnel.Dialer = tunnel.DirectDialer {}
@en "has_dialer"
@fa "دارای شماره‌گیر"
pub has_dialer: bool = false
@en "stats"
@fa "آمار ترافیک"
pub stats: tunnel.Stats = tunnel.Stats {}
@en "has_stats"
@fa "دارای آمار ترافیک"
pub has_stats: bool = false
@en "allow_udp"
@fa "اجازه یو دی پی"
pub allow_udp: bool = true
@en "policy"
@fa "سیاست مقصد"
pub policy: tunnel.DestPolicy = tunnel.DestPolicy {}
@en "router"
@fa "مسیریاب"
pub router: tunnel.RouterDialer = tunnel.RouterDialer {}
@en "has_router"
@fa "دارای مسیریاب"
pub has_router: bool = false
@en "max_connections"
@fa "بیشینه اتصال همزمان"
pub max_connections: int = 1024
@en "handshake_deadline_ms"
@fa "مهلت کل دست‌دهی"
pub handshake_deadline_ms: int = 10000
end
@en "Session"
@fa "نشست"
pub struct Session:
@en "ok"
@fa "معتبر"
pub ok: bool = false
@en "req"
@fa "درخواست"
pub req: Request = Request {}
@en "seen"
@fa "بایت‌های خوانده‌شده"
pub seen: compress.ByteBuf = compress.ByteBuf {}
@en "extra"
@fa "داده همراه"
pub extra: compress.ByteBuf = compress.ByteBuf {}
end
@en "ServerStats"
@fa "آمار کارساز"
pub struct ServerStats:
@en "accepted"
@fa "پذیرفته‌شده"
pub accepted: i64 = 0
@en "authed"
@fa "احراز‌شده"
pub authed: i64 = 0
@en "fallbacks"
@fa "جایگزین‌شده"
pub fallbacks: i64 = 0
end
@en "Server"
@fa "کارساز"
pub struct Server:
@en "ok"
@fa "معتبر"
pub ok: bool = false
@en "port"
@fa "درگاه"
pub port: int = 0
@en "host"
@fa "میزبان"
pub host: str = ""
@en "st"
@fa "وضعیت"
pub st: ServerState* = null
end
func _hash_known(cfg: ServerConfig, h: str): bool:
mut found := false
repeat cfg.hashes.len() in i:
if crypto.SecretEquals(cfg.hashes.get(i), h):
found = true
end
end
ret found
end
func _policy_of(cfg: ServerConfig): tunnel.DestPolicy:
mut h := cfg.bind_host
if h.len() == 0:
if cfg.mode == ModeTLS:
h = "0.0.0.0"
else:
h = "127.0.0.1"
end
end
ret tunnel.PolicyForBind(cfg.policy, h)
end
func _udp_target(cfg: ServerConfig, host: str, port: int, ip &: str): bool:
a := tunnel.NewAddr(host, port)
pl := tunnel.PolicyPlan(_policy_of(cfg), a, true)
mut ok := pl.allowed and pl.ips.len() > 0
if ok: ip = pl.ips[0] end
pl.ips.free()
if ok and cfg.has_router:
d := cfg.router.Pick(cfg.router.router.Match(a))
if d.Name() == "block": ok = false end
else ok and cfg.has_dialer and cfg.dialer.Name() == "block":
ok = false
end
ret ok
end
func _connect_target(cfg: ServerConfig, host: str, port: int): Link:
ret NewTCPLink(tcp.DialTimeout(host, port, cfg.connect_timeout_ms))
end
func _udp_reply_pump(us: UdpState*):
cap := 65536
buf := mem.Allocate(cap as u64)
mut fh := ""
mut fp := 0
until atomic_load(us[0].stop) != 0:
n := udp.ReceiveBytes(us[0].sock, buf, cap, fh, fp)
if n > 0:
if not WriteUDPPacket(us[0].link[0], fh, fp, buf, n):
break
end
atomic.Add(us[0].stats.down, n as i64)
end
end
mem.Free(buf)
end
func _serve_udp(lp: Link*, extra: compress.ByteBuf, stats: tunnel.Stats, cfg: ServerConfig):
_seed_udp(lp[0], extra.data, extra.len)
sock := udp.OpenAny()
if not udp.Ok(sock):
ret
end
udp.SetTimeout(sock, 300)
us := mem.AllocateZeroed(sizeof(UdpState) as u64) as UdpState*
stop := mem.AllocateZeroed(8 as u64) as i64*
atomic_store(stop, 1 as i64)
us[0] = UdpState { link = lp, sock = sock, stop = stop, stats = stats }
t := spawn(_udp_reply_pump, us)
mut pkt := UDPPacket {}
mut payload := compress.NewByteBuf()
until ReadUDPPacket(lp[0], pkt, payload):
mut dest_ip := ""
if _udp_target(cfg, pkt.host, pkt.port, dest_ip):
sent := udp.SendBytes(sock, dest_ip, pkt.port, payload.data, payload.len)
if sent > 0:
atomic.Add(stats.up, sent as i64)
end
else:
atomic.Add(stats.failed, 1 as i64)
end
end
atomic_store(stop, 0 as i64)
join(t)
udp.Close(sock)
compress.BufFree(payload)
mem.Free(stop as void*)
mem.Free(us as void*)
end
func _free_stats(cfg: ServerConfig, st: tunnel.Stats):
if not cfg.has_stats:
tunnel.FreeStats(st)
end
end
func _count(st: ServerState*, idx: int):
_added := atomic_add(((st[0].counters as i64) + (idx * 8) as i64) as i64*, 1 as i64)
end
func _serve_link(lp: Link*, cfg: ServerConfig, lim: tunnel.ConnLimits, adm &: tunnel.Admit): int:
mut s := Handshake(lp[0], cfg)
tunnel.LimitsHandshakeDone(lim, adm)
defer FreeSession(s)
if not s.ok:
if lp[0].kind != LinkWS:
_fb := Fallback(lp, cfg, s.seen)
end
ret 2
end
mut stats := cfg.stats
if not cfg.has_stats:
stats = tunnel.NewStats()
end
defer _free_stats(cfg, stats)
atomic.Add(stats.total, 1 as i64)
if s.req.cmd == CmdUDP:
if not cfg.allow_udp:
atomic.Add(stats.failed, 1 as i64)
ret 3
end
atomic.Add(stats.active, 1 as i64)
_serve_udp(lp, s.extra, stats, cfg)
atomic.Add(stats.active, 0 - 1 as i64)
ret 1
end
mut dialer := cfg.dialer
if not cfg.has_dialer:
dialer = tunnel.DirectDialer { timeout_ms = cfg.connect_timeout_ms }
end
mut guard := tunnel.Guard(dialer, _policy_of(cfg))
if cfg.has_router:
guard = tunnel.GuardRouter(cfg.router, _policy_of(cfg))
end
out := guard.Dial(tunnel.NewAddr(s.req.host, s.req.port))
if not out.Ok():
atomic.Add(stats.failed, 1 as i64)
ret 3
end
if s.extra.len > 0:
if out.WriteBytes(s.extra.data, s.extra.len) != s.extra.len:
out.Close()
atomic.Add(stats.failed, 1 as i64)
ret 3
end
atomic.Add(stats.up, s.extra.len as i64)
end
atomic.Add(stats.active, 1 as i64)
_r := tunnel.RelayWith(AsStream(lp), out, stats, cfg.idle_timeout_ms)
atomic.Add(stats.active, 0 - 1 as i64)
ret 1
end
func _conn_main(a: ConnArg*):
st := a[0].st
fd := a[0].fd
lim := st[0].limits
mut adm := a[0].adm
defer tunnel.LimitsRelease(lim, adm)
mut link := Link {}
if st[0].ws:
if st[0].cfg.handshake_timeout_ms > 0:
tcp.SetReadDeadline(tcp.ConnFromFd(fd), st[0].cfg.handshake_timeout_ms)
end
link = NewWSLink(websocket.AcceptConn(fd))
else st[0].use_tls:
c := tls.WrapServer(fd, st[0].tlscfg)
link = NewTLSLink(c)
else:
link = NewTCPLink(tcp.ConnFromFd(fd))
end
mem.Free(a as void*)
if not LinkOk(link):
tunnel.LimitsHandshakeDone(lim, adm)
LinkClose(link)
ret
end
lp := mem.AllocateZeroed(sizeof(Link) as u64) as Link*
lp[0] = link
_count(st, 0)
r := _serve_link(lp, st[0].cfg, lim, adm)
if r == 1:
_count(st, 1)
else r == 2:
_count(st, 2)
end
LinkClose(lp[0])
mem.Free(lp as void*)
end
func _accept_loop(st: ServerState*):
until atomic_load(st[0].stop) != 0:
mut a := mem.AllocateZeroed(sizeof(ConnArg) as u64) as ConnArg*
c := tcp.Accept(tcp.Server { fd = st[0].listen_fd, port = st[0].port })
if atomic_load(st[0].stop) == 0:
tcp.Close(c)
mem.Free(a as void*)
break
end
if not tcp.ConnOk(c):
mem.Free(a as void*)
continue
end
mut adm := tunnel.LimitsEnter(st[0].limits, c.fd)
if not adm.ok:
tcp.Close(c)
mem.Free(a as void*)
continue
end
a[0] = ConnArg { st = st, fd = c.fd, adm = adm }
if not tunnel.Go(_conn_main, a as void*):
tunnel.LimitsRelease(st[0].limits, adm)
tcp.Close(c)
mem.Free(a as void*)
end
end
end
func _start(cfg: ServerConfig, host: str, port: int, ws: bool, use_tls: bool): Server:
mut srv := Server {}
st := mem.AllocateZeroed(sizeof(ServerState) as u64) as ServerState*
mut tcfg := tls.ServerConfig {}
if use_tls and not ws:
tcfg = tls.NewServerConfig(cfg.cert_file, cfg.key_file)
if not tcfg.ok:
mem.Free(st as void*)
ret srv
end
end
mut lfd := 0 - 1 as i64
mut lport := 0
if ws:
ls := websocket.Server { fd = rawsock.ListenOn(host, port, rawsock.SOCK_STREAM).fd, port = port }
if not websocket.Ok(ls):
mem.Free(st as void*)
ret srv
end
lfd = ls.fd
lport = websocket.Port(ls)
else:
ls := tcp.BindOn(host, port)
if not tcp.Ok(ls):
mem.Free(st as void*)
ret srv
end
lfd = ls.fd
lport = tcp.Port(ls)
end
stop := mem.AllocateZeroed(8 as u64) as i64*
atomic_store(stop, 1 as i64)
counters := mem.AllocateZeroed(24 as u64) as i64*
st[0] = ServerState { cfg = cfg, tlscfg = tcfg, use_tls = use_tls, ws = ws, listen_fd = lfd, port = lport, stop = stop, counters = counters, limits = tunnel.NewConnLimits(cfg.max_connections, cfg.max_per_source, cfg.handshake_deadline_ms) }
_t := spawn(_accept_loop, st)
srv.ok = true
srv.port = lport
srv.host = host
srv.st = st
ret srv
end
@en "NewServerConfig"
@fa "پیکربندی کارساز جدید"
pub func NewServerConfig(cert_file: str, key_file: str): ServerConfig:
ret ServerConfig { cert_file = cert_file, key_file = key_file }
end
@en "SetFallback"
@fa "تعیین جایگزین"
pub func SetFallback(cfg &: ServerConfig, host: str, port: int):
cfg.fallback_host = host
cfg.fallback_port = port
end
@en "AddPassword"
@fa "افزودن گذرواژه"
pub func AddPassword(cfg &: ServerConfig, password: str):
h := PasswordHash(password)
cfg.hashes.push(h)
end
@en "AddPasswordHash"
@fa "افزودن درهم گذرواژه"
pub func AddPasswordHash(cfg &: ServerConfig, hash: str):
cfg.hashes.push(hash)
end
@en "Handshake"
@fa "دست‌دهی"
pub func Handshake(l &: Link, cfg: ServerConfig): Session:
mut s := Session {}
s.seen = compress.NewByteBuf()
s.extra = compress.NewByteBuf()
cap := 2048
tmp := mem.Allocate(cap as u64)
defer mem.Free(tmp)
if cfg.handshake_timeout_ms > 0:
LinkSetTimeout(l, cfg.handshake_timeout_ms)
end
until true:
n := LinkRead(l, tmp, cap)
if n <= 0:
break
end
compress.BufPushBytes(s.seen, tmp, n)
r := ParseRequest(s.seen.data, s.seen.len)
if r.status == ParseInvalid:
break
end
if r.status == ParseOK:
if _hash_known(cfg, r.hash):
s.ok = true
s.req = r
rest := s.seen.len - r.consumed
if rest > 0:
compress.BufPushBytes(s.extra, ((s.seen.data as i64) + (r.consumed as i64)) as void*, rest)
end
end
break
end
end
if cfg.handshake_timeout_ms > 0:
LinkSetTimeout(l, cfg.idle_timeout_ms)
end
ret s
end
@en "FreeSession"
@fa "آزاد کردن نشست"
pub func FreeSession(s &: Session):
compress.BufFree(s.seen)
compress.BufFree(s.extra)
end
@en "Fallback"
@fa "جایگزین"
pub func Fallback(lp: Link*, cfg: ServerConfig, seen: compress.ByteBuf): bool:
if cfg.fallback_port <= 0:
ret false
end
mut host := cfg.fallback_host
if host.len() == 0:
host = "127.0.0.1"
end
tp := mem.AllocateZeroed(sizeof(Link) as u64) as Link*
tp[0] = _connect_target(cfg, host, cfg.fallback_port)
if not LinkOk(tp[0]):
LinkClose(tp[0])
mem.Free(tp as void*)
ret false
end
if seen.len > 0:
if not LinkWrite(tp[0], seen.data, seen.len):
LinkClose(tp[0])
mem.Free(tp as void*)
ret false
end
end
_n := Relay(lp, tp)
LinkClose(tp[0])
mem.Free(tp as void*)
ret true
end
@en "ServeLink"
@fa "پاسخ به پیوند"
pub func ServeLink(lp: Link*, cfg: ServerConfig): int:
mut adm := tunnel.Admit { done = true }
ret _serve_link(lp, cfg, tunnel.ConnLimits {}, adm)
end
@en "AsStream"
@fa "به صورت جریان"
pub func AsStream(lp: Link*): dyn tunnel.Stream:
ret LinkStream { link = lp }
end
@en "SetMode"
@fa "تعیین حالت"
pub func SetMode(cfg &: ServerConfig, mode: int):
cfg.mode = mode
end
@en "SetBind"
@fa "تعیین میزبان شنود"
pub func SetBind(cfg &: ServerConfig, host: str):
cfg.bind_host = host
end
@en "SetDialer"
@fa "تعیین شماره‌گیر"
pub func SetDialer(cfg &: ServerConfig, d: dyn tunnel.Dialer):
cfg.dialer = d
cfg.has_dialer = true
end
@en "SetRouter"
@fa "تعیین مسیریاب"
pub func SetRouter(cfg &: ServerConfig, rd: tunnel.RouterDialer):
cfg.dialer = rd
cfg.has_dialer = true
cfg.router = rd
cfg.has_router = true
end
@en "SetPolicy"
@fa "تعیین سیاست مقصد"
pub func SetPolicy(cfg &: ServerConfig, p: tunnel.DestPolicy):
cfg.policy = p
end
@en "AllowPrivate"
@fa "اجازه آدرس‌های خصوصی"
pub func AllowPrivate(cfg &: ServerConfig, enabled: bool):
cfg.policy.allow_private = enabled
end
@en "SetStats"
@fa "تعیین آمار ترافیک"
pub func SetStats(cfg &: ServerConfig, st: tunnel.Stats):
cfg.stats = st
cfg.has_stats = true
end
@en "Listen"
@fa "شنود"
pub func Listen(cfg: ServerConfig, port: int): Server:
mut host := cfg.bind_host
if host.len() == 0:
if cfg.mode == ModeTLS:
host = "0.0.0.0"
else:
host = "127.0.0.1"
end
end
ret _start(cfg, host, port, cfg.mode == ModeWS, cfg.mode == ModeTLS)
end
@en "Serve"
@fa "سرویس‌دهی"
pub func Serve(cfg: ServerConfig, port: int): Server:
mut c := cfg
c.mode = ModeTLS
ret Listen(c, port)
end
@en "ServePlain"
@fa "سرویس‌دهی بدون رمز"
pub func ServePlain(cfg: ServerConfig, port: int): Server:
mut c := cfg
c.mode = ModePlain
ret Listen(c, port)
end
@en "ServeWS"
@fa "سرویس‌دهی وب‌سوکت"
pub func ServeWS(cfg: ServerConfig, port: int): Server:
mut c := cfg
c.mode = ModeWS
ret Listen(c, port)
end
@en "ServerPort"
@fa "درگاه کارساز"
pub func ServerPort(s: Server): int:
ret s.port
end
@en "Stats"
@fa "آمار"
pub func Stats(s: Server): ServerStats:
if not s.ok:
ret ServerStats {}
end
c := s.st[0].counters
ret ServerStats { accepted = atomic_load(c), authed = atomic_load(((c as i64) + 8) as i64*), fallbacks = atomic_load(((c as i64) + 16) as i64*) }
end
@en "Stop"
@fa "توقف"
pub func Stop(s: Server):
if not s.ok:
ret
end
atomic_store(s.st[0].stop, 0 as i64)
tcp.WakeServer(s.host, s.port)
sync.SleepMs(50)
end
package trojan
import mem
import compress
const K224 := [
0x428a2f98 as u32, 0x71374491 as u32, 0xb5c0fbcf as u32, 0xe9b5dba5 as u32
0x3956c25b as u32, 0x59f111f1 as u32, 0x923f82a4 as u32, 0xab1c5ed5 as u32
0xd807aa98 as u32, 0x12835b01 as u32, 0x243185be as u32, 0x550c7dc3 as u32
0x72be5d74 as u32, 0x80deb1fe as u32, 0x9bdc06a7 as u32, 0xc19bf174 as u32
0xe49b69c1 as u32, 0xefbe4786 as u32, 0x0fc19dc6 as u32, 0x240ca1cc as u32
0x2de92c6f as u32, 0x4a7484aa as u32, 0x5cb0a9dc as u32, 0x76f988da as u32
0x983e5152 as u32, 0xa831c66d as u32, 0xb00327c8 as u32, 0xbf597fc7 as u32
0xc6e00bf3 as u32, 0xd5a79147 as u32, 0x06ca6351 as u32, 0x14292967 as u32
0x27b70a85 as u32, 0x2e1b2138 as u32, 0x4d2c6dfc as u32, 0x53380d13 as u32
0x650a7354 as u32, 0x766a0abb as u32, 0x81c2c92e as u32, 0x92722c85 as u32
0xa2bfe8a1 as u32, 0xa81a664b as u32, 0xc24b8b70 as u32, 0xc76c51a3 as u32
0xd192e819 as u32, 0xd6990624 as u32, 0xf40e3585 as u32, 0x106aa070 as u32
0x19a4c116 as u32, 0x1e376c08 as u32, 0x2748774c as u32, 0x34b0bcb5 as u32
0x391c0cb3 as u32, 0x4ed8aa4a as u32, 0x5b9cca4f as u32, 0x682e6ff3 as u32
0x748f82ee as u32, 0x78a5636f as u32, 0x84c87814 as u32, 0x8cc70208 as u32
0x90befffa as u32, 0xa4506ceb as u32, 0xbef9a3f7 as u32, 0xc67178f2 as u32
]
const IV224 := [
0xc1059ed8 as u32, 0x367cd507 as u32, 0x3070dd17 as u32, 0xf70e5939 as u32
0xffc00b31 as u32, 0x68581511 as u32, 0x64f98fa7 as u32, 0xbefa4fa4 as u32
]
const HEXDIGITS := "0123456789abcdef"
inline func _rotr(x: u32, n: u32): u32:
ret (x >> n) | (x << ((32 as u32) - n))
end
func _sha224_block(h: u32*, p: void*, off: int):
bp := p as u8*
mut w: u32[64]
repeat 16 in t:
o := off + t * 4
w[t] = ((bp[o] as u32) << (24 as u32)) | ((bp[o + 1] as u32) << (16 as u32)) | ((bp[o + 2] as u32) << (8 as u32)) | (bp[o + 3] as u32)
end
repeat 48 in k:
t := k + 16
x15 := w[t - 15]
x2 := w[t - 2]
s0 := _rotr(x15, 7 as u32) ^ _rotr(x15, 18 as u32) ^ (x15 >> (3 as u32))
s1 := _rotr(x2, 17 as u32) ^ _rotr(x2, 19 as u32) ^ (x2 >> (10 as u32))
w[t] = w[t - 16] + s0 + w[t - 7] + s1
end
mut a := h[0]
mut b := h[1]
mut c := h[2]
mut d := h[3]
mut e := h[4]
mut f := h[5]
mut g := h[6]
mut hh := h[7]
repeat 64 in t:
bigs1 := _rotr(e, 6 as u32) ^ _rotr(e, 11 as u32) ^ _rotr(e, 25 as u32)
ch := (e & f) ^ ((~e) & g)
t1 := hh + bigs1 + ch + K224[t] + w[t]
bigs0 := _rotr(a, 2 as u32) ^ _rotr(a, 13 as u32) ^ _rotr(a, 22 as u32)
maj := (a & b) ^ (a & c) ^ (b & c)
t2 := bigs0 + maj
hh = g
g = f
f = e
e = d + t1
d = c
c = b
b = a
a = t1 + t2
end
h[0] += a
h[1] += b
h[2] += c
h[3] += d
h[4] += e
h[5] += f
h[6] += g
h[7] += hh
end
@en "Sha224"
@fa "اس‌اچ‌ای۲۲۴"
pub func Sha224(p: void*, n: int): compress.ByteBuf:
mut msg := compress.NewByteBufCap(n + 72)
defer compress.BufFree(msg)
compress.BufPushBytes(msg, p, n)
compress.BufPush(msg, 0x80)
until msg.len % 64 != 56:
compress.BufPush(msg, 0)
end
bits := (n as u64) * (8 as u64)
repeat 8 in i:
sh := ((7 - i) * 8) as u64
compress.BufPush(msg, ((bits >> sh) & (0xFF as u64)) as int)
end
hp := mem.Allocate(32 as u64) as u32*
defer mem.Free(hp as void*)
repeat 8 in i:
hp[i] = IV224[i]
end
mut off := 0
until off < msg.len:
_sha224_block(hp, msg.data, off)
off += 64
end
mut out := compress.NewByteBufCap(28)
repeat 7 in i:
v := hp[i]
compress.BufPush(out, ((v >> (24 as u32)) & (0xFF as u32)) as int)
compress.BufPush(out, ((v >> (16 as u32)) & (0xFF as u32)) as int)
compress.BufPush(out, ((v >> (8 as u32)) & (0xFF as u32)) as int)
compress.BufPush(out, (v & (0xFF as u32)) as int)
end
ret out
end
@en "HexOf"
@fa "هگز"
pub func HexOf(b: compress.ByteBuf): str:
mut s := ""
repeat b.len in i:
v := compress.BufGet(b, i)
s = s + HEXDIGITS.substr(v >> 4, 1) + HEXDIGITS.substr(v & 15, 1)
end
ret s
end
@en "Sha224Hex"
@fa "اس‌اچ‌ای۲۲۴ هگز"
pub func Sha224Hex(s: str): str:
mut d := Sha224(s as void*, s.len())
defer compress.BufFree(d)
ret HexOf(d)
end
@en "PasswordHash"
@fa "درهم گذرواژه"
pub func PasswordHash(password: str): str:
ret Sha224Hex(password)
end
@en "net/trojan"
@fa "تروجان"
package trojan
import mem
import str
import compress
@en "CmdConnect"
@fa "فرمان اتصال"
pub const CmdConnect := 1
@en "CmdUDP"
@fa "فرمان یو دی پی"
pub const CmdUDP := 3
@en "AtypIPv4"
@fa "نوع نشانی آی‌پی۴"
pub const AtypIPv4 := 1
@en "AtypDomain"
@fa "نوع نشانی دامنه"
pub const AtypDomain := 3
@en "AtypIPv6"
@fa "نوع نشانی آی‌پی۶"
pub const AtypIPv6 := 4
@en "ParseOK"
@fa "تجزیه موفق"
pub const ParseOK := 0
@en "ParseNeedMore"
@fa "تجزیه نیازمند داده بیشتر"
pub const ParseNeedMore := 1
@en "ParseInvalid"
@fa "تجزیه نامعتبر"
pub const ParseInvalid := 2
@en "Request"
@fa "درخواست"
pub struct Request:
@en "status"
@fa "وضعیت"
pub status: int = 1
@en "hash"
@fa "درهم"
pub hash: str = ""
@en "cmd"
@fa "فرمان"
pub cmd: int = 0
@en "atyp"
@fa "نوع نشانی"
pub atyp: int = 0
@en "host"
@fa "میزبان"
pub host: str = ""
@en "port"
@fa "درگاه"
pub port: int = 0
@en "consumed"
@fa "بایت‌های مصرف‌شده"
pub consumed: int = 0
end
@en "UDPPacket"
@fa "بسته یو دی پی"
pub struct UDPPacket:
@en "status"
@fa "وضعیت"
pub status: int = 1
@en "atyp"
@fa "نوع نشانی"
pub atyp: int = 0
@en "host"
@fa "میزبان"
pub host: str = ""
@en "port"
@fa "درگاه"
pub port: int = 0
@en "payload_off"
@fa "آغاز داده"
pub payload_off: int = 0
@en "payload_len"
@fa "طول داده"
pub payload_len: int = 0
@en "consumed"
@fa "بایت‌های مصرف‌شده"
pub consumed: int = 0
end
inline func _ub(p: void*, i: int): int:
ret ((p as u8*)[i]) as int
end
func _mkstr(p: void*, off: int, n: int): str:
buf := mem.Allocate((n + 1) as u64)
if n > 0:
mem.Copy(buf, ((p as i64) + (off as i64)) as void*, n as u64)
end
(buf as u8*)[n] = 0 as u8
ret buf as str
end
func _is_hex(c: int): bool:
ret (c >= 48 and c <= 57) or (c >= 97 and c <= 102) or (c >= 65 and c <= 70)
end
func _hexval(c: int): int:
if c >= 48 and c <= 57:
ret c - 48
end
if c >= 97 and c <= 102:
ret c - 87
end
if c >= 65 and c <= 70:
ret c - 55
end
ret 0 - 1
end
func _all_digits(s: str): bool:
if s.len() == 0 or s.len() > 3:
ret false
end
repeat s.len() in i:
c := (s as u8*)[i] as int
if c < 48 or c > 57:
ret false
end
end
ret true
end
func _hex_group(s: str): int:
n := s.len()
if n == 0 or n > 4:
ret 0 - 1
end
mut v := 0
repeat n in i:
h := _hexval((s as u8*)[i] as int)
if h < 0:
ret 0 - 1
end
v = v * 16 + h
end
ret v
end
func _groups(part: str, out &: Vector<int>): bool:
if part.len() == 0:
ret true
end
items := str.Split(part, ":")
defer items.free()
repeat items.len() in i:
g := _hex_group(items.get(i))
if g < 0:
ret false
end
out.push(g)
end
ret true
end
func _hex16(v: int): str:
digits := "0123456789abcdef"
mut s := ""
mut started := false
mut sh := 12
until sh >= 0:
d := (v >> sh) & 15
if d != 0 or started or sh == 0:
s += digits.substr(d, 1)
started = true
end
sh -= 4
end
ret s
end
@en "ParseIPv4"
@fa "تجزیه آی‌پی۴"
pub func ParseIPv4(text: str, out &: compress.ByteBuf): bool:
parts := str.Split(text, ".")
defer parts.free()
if parts.len() != 4:
ret false
end
mut vals: int[4]
repeat 4 in i:
s := parts.get(i)
if not _all_digits(s):
ret false
end
v := s.to_int()
if v > 255:
ret false
end
vals[i] = v
end
repeat 4 in i:
compress.BufPush(out, vals[i])
end
ret true
end
@en "ParseIPv6"
@fa "تجزیه آی‌پی۶"
pub func ParseIPv6(text: str, out &: compress.ByteBuf): bool:
mut left := Vector {} as Vector<int>
mut right := Vector {} as Vector<int>
defer left.free()
defer right.free()
dc := text.find("::")
mut has_gap := false
if dc >= 0:
has_gap = true
rest := text.substr(dc + 2, text.len() - dc - 2)
if rest.find("::") >= 0:
ret false
end
if not _groups(text.substr(0, dc), left):
ret false
end
if not _groups(rest, right):
ret false
end
else:
if not _groups(text, left):
ret false
end
end
total := left.len() + right.len()
if has_gap and total > 7:
ret false
end
if not has_gap and total != 8:
ret false
end
repeat left.len() in i:
g := left.get(i)
compress.BufPush(out, g >> 8)
compress.BufPush(out, g & 255)
end
repeat 8 - total:
compress.BufPush(out, 0)
compress.BufPush(out, 0)
end
repeat right.len() in i:
g := right.get(i)
compress.BufPush(out, g >> 8)
compress.BufPush(out, g & 255)
end
ret true
end
@en "FormatIPv4"
@fa "قالب‌دهی آی‌پی۴"
pub func FormatIPv4(p: void*, off: int): str:
ret str.FromInt(_ub(p, off) as i64) + "." + str.FromInt(_ub(p, off + 1) as i64) + "." + str.FromInt(_ub(p, off + 2) as i64) + "." + str.FromInt(_ub(p, off + 3) as i64)
end
@en "FormatIPv6"
@fa "قالب‌دهی آی‌پی۶"
pub func FormatIPv6(p: void*, off: int): str:
mut g: int[8]
repeat 8 in i:
g[i] = _ub(p, off + i * 2) * 256 + _ub(p, off + i * 2 + 1)
end
mut best := 0 - 1
mut best_len := 0
mut i := 0
until i < 8:
if g[i] == 0:
mut j := i
until j < 8 and g[j] == 0:
j++
end
if j - i > best_len and j - i >= 2:
best = i
best_len = j - i
end
i = j
else:
i++
end
end
mut s := ""
mut k := 0
until k < 8:
if k == best:
s += "::"
k += best_len
continue
end
if s.len() > 0 and not s.ends_with(":"):
s += ":"
end
s += _hex16(g[k])
k++
end
ret s
end
@en "EncodeAddr"
@fa "کدگذاری نشانی"
pub func EncodeAddr(host: str, port: int): compress.ByteBuf:
mut b := compress.NewByteBufCap(32)
mut raw := compress.NewByteBuf()
defer compress.BufFree(raw)
if ParseIPv4(host, raw):
compress.BufPush(b, AtypIPv4)
compress.BufPushBuf(b, raw)
else host.find(":") >= 0 and ParseIPv6(host, raw):
compress.BufPush(b, AtypIPv6)
compress.BufPushBuf(b, raw)
else:
mut hl := host.len()
if hl > 255:
hl = 255
end
compress.BufPush(b, AtypDomain)
compress.BufPush(b, hl)
compress.BufPushBytes(b, host as void*, hl)
end
compress.BufPush(b, (port >> 8) & 255)
compress.BufPush(b, port & 255)
ret b
end
@en "ParseAddr"
@fa "تجزیه نشانی"
pub func ParseAddr(p: void*, n: int, off: int, atyp &: int, host &: str, port &: int): int:
if off >= n:
ret 0
end
t := _ub(p, off)
mut need := 0
if t == AtypIPv4:
need = 1 + 4 + 2
else t == AtypIPv6:
need = 1 + 16 + 2
else t == AtypDomain:
if off + 1 >= n:
ret 0
end
dl := _ub(p, off + 1)
if dl == 0:
ret 0 - 1
end
need = 2 + dl + 2
else:
ret 0 - 1
end
if off + need > n:
ret 0
end
atyp = t
after := off + need - 2
if t == AtypIPv4:
host = FormatIPv4(p, off + 1)
else t == AtypIPv6:
host = FormatIPv6(p, off + 1)
else:
host = _mkstr(p, off + 2, _ub(p, off + 1))
end
port = _ub(p, after) * 256 + _ub(p, after + 1)
ret need
end
@en "EncodeRequestHash"
@fa "کدگذاری درخواست با درهم"
pub func EncodeRequestHash(hash: str, cmd: int, host: str, port: int): compress.ByteBuf:
mut b := compress.NewByteBufCap(96)
compress.BufPushBytes(b, hash as void*, hash.len())
compress.BufPush(b, 13)
compress.BufPush(b, 10)
compress.BufPush(b, cmd)
mut a := EncodeAddr(host, port)
compress.BufPushBuf(b, a)
compress.BufFree(a)
compress.BufPush(b, 13)
compress.BufPush(b, 10)
ret b
end
@en "EncodeRequest"
@fa "کدگذاری درخواست"
pub func EncodeRequest(password: str, cmd: int, host: str, port: int): compress.ByteBuf:
h := PasswordHash(password)
defer mem.Free(h as void*)
ret EncodeRequestHash(h, cmd, host, port)
end
@en "ParseRequest"
@fa "تجزیه درخواست"
pub func ParseRequest(p: void*, n: int): Request:
mut r := Request {}
lim := n
mut i := 0
until i < 56 and i < lim:
if not _is_hex(_ub(p, i)):
r.status = ParseInvalid
ret r
end
i++
end
if n > 56 and _ub(p, 56) != 13:
r.status = ParseInvalid
ret r
end
if n > 57 and _ub(p, 57) != 10:
r.status = ParseInvalid
ret r
end
if n < 59:
ret r
end
cmd := _ub(p, 58)
if cmd != CmdConnect and cmd != CmdUDP:
r.status = ParseInvalid
ret r
end
mut atyp := 0
mut host := ""
mut port := 0
used := ParseAddr(p, n, 59, atyp, host, port)
if used < 0:
r.status = ParseInvalid
ret r
end
if used == 0:
ret r
end
end_at := 59 + used
if n < end_at + 2:
ret r
end
if _ub(p, end_at) != 13 or _ub(p, end_at + 1) != 10:
r.status = ParseInvalid
ret r
end
r.status = ParseOK
r.hash = _mkstr(p, 0, 56)
r.cmd = cmd
r.atyp = atyp
r.host = host
r.port = port
r.consumed = end_at + 2
ret r
end
@en "EncodeUDPPacket"
@fa "کدگذاری بسته یو دی پی"
pub func EncodeUDPPacket(host: str, port: int, payload: void*, n: int): compress.ByteBuf:
mut b := compress.NewByteBufCap(n + 32)
mut a := EncodeAddr(host, port)
compress.BufPushBuf(b, a)
compress.BufFree(a)
compress.BufPush(b, (n >> 8) & 255)
compress.BufPush(b, n & 255)
compress.BufPush(b, 13)
compress.BufPush(b, 10)
compress.BufPushBytes(b, payload, n)
ret b
end
@en "ParseUDPPacket"
@fa "تجزیه بسته یو دی پی"
pub func ParseUDPPacket(p: void*, n: int): UDPPacket:
mut r := UDPPacket {}
mut atyp := 0
mut host := ""
mut port := 0
used := ParseAddr(p, n, 0, atyp, host, port)
if used < 0:
r.status = ParseInvalid
ret r
end
if used == 0 or n < used + 4:
ret r
end
plen := _ub(p, used) * 256 + _ub(p, used + 1)
if _ub(p, used + 2) != 13 or _ub(p, used + 3) != 10:
r.status = ParseInvalid
ret r
end
if n < used + 4 + plen:
ret r
end
r.status = ParseOK
r.atyp = atyp
r.host = host
r.port = port
r.payload_off = used + 4
r.payload_len = plen
r.consumed = used + 4 + plen
ret r
end
@en "net/tunnel"
@fa "تونل"
package tunnel
import mem
import atomic
import pool
import sync
import net.tcp
import net.internal.rawsock
struct _AcceptJob:
pub server: AcceptServer = AcceptServer {}
pub proto: dyn InboundProtocol = NullProtocol {}
pub handler: dyn Handler = ForwardHandler {}
end
struct _SourceCore:
pub mu: sync.Mutex = sync.Mutex {}
pub keys: Vector<str> = Vector {}
pub counts: Vector<int> = Vector {}
end
@en "Pending"
@fa "اتصال در انتظار"
pub interface Pending:
@en "Valid"
@fa "معتبر"
func Valid(): bool
@en "Open"
@fa "گشودن"
func Open(): dyn Stream
@en "Abort"
@fa "رها کردن"
func Abort()
@en "Remote"
@fa "مبدا"
func Remote(): str
end
@en "SourceTable"
@fa "جدول مبداها"
pub struct SourceTable:
@en "core"
@fa "هسته"
pub core: void* = null
end
@en "Acceptor"
@fa "پذیرنده اتصال"
pub interface Acceptor:
@en "Accept"
@fa "پذیرش"
func Accept(): dyn Pending
@en "Port"
@fa "درگاه"
func Port(): int
@en "Ok"
@fa "معتبر"
func Ok(): bool
@en "Close"
@fa "بستن"
func Close()
end
@en "ReadyConn"
@fa "اتصال آماده"
pub struct ReadyConn:
@en "stream"
@fa "جریان"
pub stream: dyn Stream = ClosedStream {}
@en "ok"
@fa "موفق"
pub ok: bool = false
@en "remote"
@fa "مبدا"
pub remote: str = ""
@en "Valid"
@fa "معتبر"
pub func Valid(): bool:
ret this.ok
end
@en "Open"
@fa "گشودن"
pub func Open(): dyn Stream:
ret this.stream
end
@en "Abort"
@fa "رها کردن"
pub func Abort():
this.stream.Close()
end
@en "Remote"
@fa "مبدا"
pub func Remote(): str:
ret this.remote
end
end
@en "TcpAcceptor"
@fa "پذیرنده تی سی پی"
pub struct TcpAcceptor:
@en "server"
@fa "کارساز"
pub server: tcp.Server = tcp.Server {}
@en "Accept"
@fa "پذیرش"
pub func Accept(): dyn Pending:
c := tcp.Accept(this.server)
if not tcp.ConnOk(c): ret ReadyConn {} end
tcp.SetNoDelay(c, true)
ret ReadyConn { stream = TcpStream { conn = c }, ok = true, remote = rawsock.PeerHost(rawsock.FromFd(c.fd)) }
end
@en "Port"
@fa "درگاه"
pub func Port(): int:
ret tcp.Port(this.server)
end
@en "Ok"
@fa "معتبر"
pub func Ok(): bool:
ret tcp.Ok(this.server)
end
@en "Close"
@fa "بستن"
pub func Close():
tcp.CloseServer(this.server)
end
end
@en "AcceptServer"
@fa "کارساز پذیرش"
pub struct AcceptServer:
@en "acceptor"
@fa "پذیرنده"
pub acceptor: dyn Acceptor = TcpAcceptor {}
@en "host"
@fa "میزبان"
pub host: str = "127.0.0.1"
@en "running"
@fa "فعال"
pub running: atomic.Flag = atomic.Flag {}
@en "workers"
@fa "کارگرها"
pub workers: pool.Pool = pool.Pool {}
@en "handshake_ms"
@fa "مهلت دست‌دهی"
pub handshake_ms: int = 8000
@en "per_source"
@fa "سقف مبدا"
pub per_source: int = 0
@en "sources"
@fa "مبداها"
pub sources: SourceTable = SourceTable {}
@en "Ok"
@fa "معتبر"
pub func Ok(): bool:
ret this.acceptor.Ok()
end
@en "Port"
@fa "درگاه"
pub func Port(): int:
ret this.acceptor.Port()
end
@en "Stop"
@fa "توقف"
pub func Stop():
atomic.Set(this.running, false)
tcp.WakeServer(this.host, this.acceptor.Port())
this.acceptor.Close()
end
end
func _accept_conn(p: dyn Pending, proto: dyn InboundProtocol, h: dyn Handler, handshake_ms: int, sources: SourceTable, host: str):
up := p.Open()
if not up.Ok():
up.Close()
SourceLeave(sources, host)
ret
end
up.SetDeadline(handshake_ms)
sess := proto.Handshake(up)
SourceLeave(sources, host)
if not sess.ok:
up.Close()
ret
end
up.SetDeadline(0)
h.Handle(up, sess)
end
func _accept_loop(srv: AcceptServer, proto: dyn InboundProtocol, h: dyn Handler):
a := srv.acceptor
hs := srv.handshake_ms
limit := srv.per_source
sources := srv.sources
until atomic.Get(srv.running):
p := a.Accept()
if not p.Valid(): continue end
if not atomic.Get(srv.running):
p.Abort()
break
end
host := p.Remote()
if not SourceEnter(sources, host, limit):
p.Abort()
continue
end
pool.Submit(srv.workers, (): _accept_conn(p, proto, h, hs, sources, host) end)
end
end
func _source_find(c: _SourceCore*, host: str): int:
repeat c[0].keys.len() in i:
if c[0].keys.get(i) == host:
ret i
end
end
ret 0 - 1
end
func _accept_thread(jp: _AcceptJob*):
j := jp[0]
mem.Free(jp as void*)
_accept_loop(j.server, j.proto, j.handler)
end
@en "NewSourceTable"
@fa "جدول مبداها جدید"
pub func NewSourceTable(): SourceTable:
p := mem.AllocateZeroed(sizeof(_SourceCore) as u64) as _SourceCore*
p[0] = _SourceCore { mu = sync.NewMutex() }
ret SourceTable { core = p as void* }
end
@en "SourceKey"
@fa "کلید مبدا"
pub func SourceKey(remote: str): str:
h := rawsock.CanonIP(remote)
if rawsock.IsIPv6(h):
k := rawsock.V6Prefix(h, 64)
mem.Free(h as void*)
ret k
end
ret h
end
@en "SourceEnter"
@fa "ورود مبدا"
pub func SourceEnter(t: SourceTable, remote: str, limit: int): bool:
if limit <= 0 or remote.len() == 0 or t.core == null:
ret true
end
host := SourceKey(remote)
c := t.core as _SourceCore*
sync.Lock(c[0].mu)
at := _source_find(c, host)
mut ok := true
if at < 0:
c[0].keys.push(host)
c[0].counts.push(1)
else:
ok = c[0].counts.get(at) < limit
if ok:
c[0].counts.set(at, c[0].counts.get(at) + 1)
end
mem.Free(host as void*)
end
sync.Unlock(c[0].mu)
ret ok
end
@en "SourceLeave"
@fa "خروج مبدا"
pub func SourceLeave(t: SourceTable, remote: str):
if remote.len() == 0 or t.core == null:
ret
end
host := SourceKey(remote)
c := t.core as _SourceCore*
sync.Lock(c[0].mu)
at := _source_find(c, host)
if at >= 0:
n := c[0].counts.get(at)
if n <= 1:
old := c[0].keys.remove_at(at)
c[0].counts.remove_at(at)
mem.Free(old as void*)
else:
c[0].counts.set(at, n - 1)
end
end
sync.Unlock(c[0].mu)
mem.Free(host as void*)
end
@en "NewAcceptServer"
@fa "کارساز پذیرش جدید"
pub func NewAcceptServer(a: dyn Acceptor, host: str): AcceptServer:
ret AcceptServer { acceptor = a, host = host, running = atomic.NewFlag(false), workers = pool.NewElastic(2 as i64, 512 as i64, 1024 as i64), sources = NewSourceTable() }
end
@en "ListenTcpOn"
@fa "شنود تی سی پی روی نشانی"
pub func ListenTcpOn(host: str, port: int): AcceptServer:
s := rawsock.ListenOn(host, port, rawsock.SOCK_STREAM)
mut srv := tcp.Server { fd = s.fd }
if s.fd >= 0: srv.port = rawsock.LocalPort(s) end
ret NewAcceptServer(TcpAcceptor { server = srv }, host)
end
@en "ListenTcpDual"
@fa "شنود تی سی پی دوگانه"
pub func ListenTcpDual(port: int): AcceptServer:
ret ListenTcpOn("::", port)
end
@en "ListenLocal6"
@fa "شنود محلی آی‌پی۶"
pub func ListenLocal6(port: int): AcceptServer:
ret ListenTcpOn("::1", port)
end
@en "ListenLocal"
@fa "شنود محلی"
pub func ListenLocal(port: int): AcceptServer:
ret ListenTcpOn("127.0.0.1", port)
end
@en "StartAccepting"
@fa "شروع پذیرش"
pub func StartAccepting(srv: AcceptServer, proto: dyn InboundProtocol, h: dyn Handler):
atomic.Set(srv.running, true)
jp := mem.AllocateZeroed(sizeof(_AcceptJob) as u64) as _AcceptJob*
jp[0] = _AcceptJob { server = srv, proto = proto, handler = h }
_t := spawn(_accept_thread, jp)
end
@en "net/tunnel"
@fa "تونل"
package tunnel
import mem
import str
@en "ADDR_IPV4"
@fa "نشانی آی‌پی۴"
pub const ADDR_IPV4 := 1
@en "ADDR_DOMAIN"
@fa "نشانی دامنه"
pub const ADDR_DOMAIN := 3
@en "ADDR_IPV6"
@fa "نشانی آی‌پی۶"
pub const ADDR_IPV6 := 4
@en "Addr"
@fa "نشانی"
pub struct Addr:
@en "host"
@fa "میزبان"
pub host: str = ""
@en "port"
@fa "درگاه"
pub port: int = 0
@en "kind"
@fa "نوع"
pub kind: int = 3
@en "valid"
@fa "معتبر"
pub valid: bool = false
@en "size"
@fa "حجم"
pub size: int = 0
@en "String"
@fa "متن"
pub func String(): str:
if this.kind == 4:
ret "[" + this.host + "]:" + this.port
end
ret this.host + ":" + this.port
end
end
func _hexdigit(c: int): int:
if c >= 48 and c <= 57: ret c - 48 end
if c >= 97 and c <= 102: ret c - 87 end
if c >= 65 and c <= 70: ret c - 55 end
ret 0 - 1
end
func _hex4(v: int): str:
digits := "0123456789abcdef"
mut sb := str.NewBuilder()
defer str.BufFree(sb)
mut started := false
mut shift := 12
until shift >= 0:
d := (v >> shift) & 15
if d != 0 or started or shift == 0:
str.BufAppendChar(sb, (digits as u8*)[d] as int)
started = true
end
shift -= 4
end
ret str.BufStr(sb)
end
func _all_digits(s: str): bool:
n := s.len()
if n == 0 or n > 5: ret false end
p := s as u8*
repeat n in i:
c := p[i] as int
if c < 48 or c > 57: ret false end
end
ret true
end
func _put_addr_body(out &: Vector<u8>, a: Addr, atyp_v4: int, atyp_dom: int, atyp_v6: int): bool:
if a.kind == ADDR_IPV4:
v := ParseIPv4(a.host)
defer v.free()
out.push(atyp_v4 as u8)
repeat 4 in i:
out.push(v[i] as u8)
end
ret true
end
if a.kind == ADDR_IPV6:
v := ParseIPv6(a.host)
defer v.free()
out.push(atyp_v6 as u8)
repeat 16 in i:
out.push(v[i] as u8)
end
ret true
end
n := a.host.len()
if n == 0 or n > 255: ret false end
out.push(atyp_dom as u8)
out.push(n as u8)
hp := a.host as u8*
repeat n in i:
out.push(hp[i])
end
ret true
end
func _decode_body(p: u8*, n: int, off: int, atyp: int, v4: int, dom: int, v6: int): Addr:
mut a := Addr {}
mut o := off
if atyp == v4:
if o + 4 > n: ret a end
mut v := Vector {} as Vector<int>
defer v.free()
repeat 4 in i:
v.push(p[o + i] as int)
end
a.host = FormatIP(v)
a.kind = ADDR_IPV4
o += 4
else atyp == v6:
if o + 16 > n: ret a end
mut v := Vector {} as Vector<int>
defer v.free()
repeat 16 in i:
v.push(p[o + i] as int)
end
a.host = FormatIP(v)
a.kind = ADDR_IPV6
o += 16
else atyp == dom:
if o + 1 > n: ret a end
l := p[o] as int
if l == 0 or o + 1 + l > n: ret a end
o++
mut sb := str.NewBuilder()
defer str.BufFree(sb)
repeat l in i:
str.BufAppendChar(sb, p[o + i] as int)
end
a.host = str.BufStr(sb)
a.kind = ADDR_DOMAIN
o += l
else:
ret a
end
a.size = o
a.valid = true
ret a
end
@en "ParseIPv4"
@fa "تجزیه آی‌پی۴"
pub func ParseIPv4(s: str): Vector<int>:
mut out := Vector {} as Vector<int>
n := s.len()
p := s as u8*
mut cur := 0
mut digits := 0
repeat n in i:
c := p[i] as int
if c >= 48 and c <= 57:
cur = cur * 10 + (c - 48)
digits++
if digits > 3 or cur > 255:
out.clear()
ret out
end
else c == 46 and digits > 0 and out.len() < 3:
out.push(cur)
cur = 0
digits = 0
else:
out.clear()
ret out
end
end
if digits == 0 or out.len() != 3:
out.clear()
ret out
end
out.push(cur)
ret out
end
@en "ParseIPv6"
@fa "تجزیه آی‌پی۶"
pub func ParseIPv6(text: str): Vector<int>:
mut out := Vector {} as Vector<int>
mut s := text
if s.includes("."):
cut := str.LastIndex(s, ":")
if cut < 0: ret out end
v4 := ParseIPv4(s.substr(cut + 1, s.len() - cut - 1))
defer v4.free()
if v4.len() != 4: ret out end
s = s.substr(0, cut + 1) + _hex4(v4[0] * 256 + v4[1]) + ":" + _hex4(v4[2] * 256 + v4[3])
end
n := s.len()
p := s as u8*
mut head := Vector {} as Vector<int>
mut tail := Vector {} as Vector<int>
defer head.free()
defer tail.free()
mut dc := false
mut cur := 0
mut digits := 0
mut i := 0
until i < n:
c := p[i] as int
d := _hexdigit(c)
if d >= 0:
cur = cur * 16 + d
digits++
if digits > 4: ret out end
else c == 58:
mut nextc := 0 - 1
if i + 1 < n: nextc = p[i + 1] as int end
if nextc == 58:
if dc: ret out end
if digits > 0:
head.push(cur)
end
dc = true
cur = 0
digits = 0
i++
else:
if digits == 0: ret out end
if dc: tail.push(cur) else:
head.push(cur)
end
cur = 0
digits = 0
end
else:
ret out
end
i++
end
if digits > 0:
if dc: tail.push(cur) else:
head.push(cur)
end
end
total := head.len() + tail.len()
if dc:
if total > 7: ret out end
else:
if total != 8: ret out end
end
repeat head.len() in k:
out.push(head[k] / 256)
out.push(head[k] % 256)
end
if dc:
repeat 16 - total * 2:
out.push(0)
end
repeat tail.len() in k:
out.push(tail[k] / 256)
out.push(tail[k] % 256)
end
end
ret out
end
@en "ParseIP"
@fa "تجزیه آی‌پی"
pub func ParseIP(s: str): Vector<int>:
if s.includes(":"): ret ParseIPv6(s) end
ret ParseIPv4(s)
end
@en "FormatIP"
@fa "قالب‌بندی آی‌پی"
pub func FormatIP(b: Vector<int>): str:
if b.len() == 4:
ret b[0] + "." + b[1] + "." + b[2] + "." + b[3]
end
if b.len() != 16: ret "" end
mut groups := Vector {} as Vector<int>
defer groups.free()
repeat 8 in g:
groups.push(b[g * 2] * 256 + b[g * 2 + 1])
end
mut best := 0 - 1
mut best_len := 0
mut run := 0 - 1
mut run_len := 0
repeat 8 in g:
if groups[g] == 0:
if run < 0:
run = g
run_len = 0
end
run_len++
if run_len > best_len:
best = run
best_len = run_len
end
else:
run = 0 - 1
run_len = 0
end
end
if best_len < 2: best = 0 - 1 end
mut sb := str.NewBuilder()
defer str.BufFree(sb)
mut g := 0
until g < 8:
if g == best:
str.BufAppend(sb, "::")
g += best_len
else:
if g > 0 and g != best + best_len:
str.BufAppend(sb, ":")
end
str.BufAppend(sb, _hex4(groups[g]))
g++
end
end
ret str.BufStr(sb)
end
@en "IsIP"
@fa "آی‌پی است"
pub func IsIP(s: str): bool:
v := ParseIP(s)
defer v.free()
ret v.len() > 0
end
@en "NewAddr"
@fa "نشانی جدید"
pub func NewAddr(host: str, port: int): Addr:
mut h := host
if h.len() > 1 and h.char_at(0) == "[" and h.char_at(h.len() - 1) == "]":
h = h.substr(1, h.len() - 2)
end
mut kind := ADDR_DOMAIN
if h.includes(":"):
v6 := ParseIPv6(h)
defer v6.free()
if v6.len() == 16:
kind = ADDR_IPV6
h = FormatIP(v6)
end
else:
v4 := ParseIPv4(h)
defer v4.free()
if v4.len() == 4: kind = ADDR_IPV4 end
end
ok := port >= 0 and port <= 65535 and h.len() > 0 and h.len() <= 255
if kind == ADDR_DOMAIN and h.includes(":"): ret Addr { host = h, port = port, kind = kind, valid = false } end
ret Addr { host = h, port = port, kind = kind, valid = ok }
end
@en "ParseAddr"
@fa "تجزیه نشانی"
pub func ParseAddr(s: str): Addr:
n := s.len()
if n == 0: ret Addr {} end
if s.char_at(0) == "[":
close := s.find("]")
if close < 0 or close + 2 >= n or s.char_at(close + 1) != ":":
ret Addr {}
end
pt := s.substr(close + 2, n - close - 2)
if not _all_digits(pt): ret Addr {} end
ret NewAddr(s.substr(1, close - 1), pt.to_int())
end
cut := str.LastIndex(s, ":")
if cut < 0 or cut == n - 1: ret Addr {} end
if s.find(":") != cut: ret Addr {} end
pt := s.substr(cut + 1, n - cut - 1)
if not _all_digits(pt): ret Addr {} end
ret NewAddr(s.substr(0, cut), pt.to_int())
end
@en "EncodeSocks"
@fa "کدگذاری ساکس"
pub func EncodeSocks(a: Addr): Vector<u8>:
mut out := Vector {} as Vector<u8>
if not _put_addr_body(out, a, 1, 3, 4):
out.clear()
ret out
end
out.push((a.port / 256) as u8)
out.push((a.port % 256) as u8)
ret out
end
@en "EncodeVless"
@fa "کدگذاری ویلس"
pub func EncodeVless(a: Addr): Vector<u8>:
mut out := Vector {} as Vector<u8>
out.push((a.port / 256) as u8)
out.push((a.port % 256) as u8)
if not _put_addr_body(out, a, 1, 2, 3):
out.clear()
end
ret out
end
@en "DecodeSocks"
@fa "کدگشایی ساکس"
pub func DecodeSocks(ptr: void*, n: int): Addr:
p := ptr as u8*
if n < 1: ret Addr {} end
mut a := _decode_body(p, n, 1, p[0] as int, 1, 3, 4)
if not a.valid: ret a end
if a.size + 2 > n:
a.valid = false
a.size = 0
ret a
end
a.port = (p[a.size] as int) * 256 + (p[a.size + 1] as int)
a.size += 2
ret a
end
@en "DecodeVless"
@fa "کدگشایی ویلس"
pub func DecodeVless(ptr: void*, n: int): Addr:
p := ptr as u8*
if n < 3: ret Addr {} end
mut a := _decode_body(p, n, 3, p[2] as int, 1, 2, 3)
if not a.valid: ret a end
a.port = (p[0] as int) * 256 + (p[1] as int)
ret a
end
@en "VectorBytes"
@fa "بایت‌های بردار"
pub func VectorBytes(v: Vector<u8>): void*:
n := v.len()
p := mem.Allocate((n + 1) as u64)
repeat n in i:
(p as u8*)[i] = v[i]
end
ret p
end
@en "ReadSocksAddr"
@fa "خواندن نشانی ساکس"
pub func ReadSocksAddr(s: dyn Stream): Addr:
buf := mem.AllocateZeroed(300 as u64)
defer mem.Free(buf)
p := buf as u8*
if not ReadFull(s, buf, 1): ret Addr {} end
atyp := p[0] as int
mut need := 0
if atyp == 1:
need = 4
else atyp == 4:
need = 16
else atyp == 3:
if not ReadFull(s, (buf as i64 + 1) as void*, 1): ret Addr {} end
l := p[1] as int
if l == 0: ret Addr {} end
if not ReadFull(s, (buf as i64 + 2) as void*, l + 2): ret Addr {} end
ret DecodeSocks(buf, 2 + l + 2)
else:
ret Addr {}
end
if not ReadFull(s, (buf as i64 + 1) as void*, need + 2): ret Addr {} end
ret DecodeSocks(buf, 1 + need + 2)
end
@en "ReadVlessAddr"
@fa "خواندن نشانی ویلس"
pub func ReadVlessAddr(s: dyn Stream): Addr:
buf := mem.AllocateZeroed(300 as u64)
defer mem.Free(buf)
p := buf as u8*
if not ReadFull(s, buf, 3): ret Addr {} end
atyp := p[2] as int
if atyp == 1:
if not ReadFull(s, (buf as i64 + 3) as void*, 4): ret Addr {} end
ret DecodeVless(buf, 7)
else atyp == 3:
if not ReadFull(s, (buf as i64 + 3) as void*, 16): ret Addr {} end
ret DecodeVless(buf, 19)
else atyp == 2:
if not ReadFull(s, (buf as i64 + 3) as void*, 1): ret Addr {} end
l := p[3] as int
if l == 0: ret Addr {} end
if not ReadFull(s, (buf as i64 + 4) as void*, l): ret Addr {} end
ret DecodeVless(buf, 4 + l)
end
ret Addr {}
end
@en "net/tunnel"
@fa "تونل"
package tunnel
import str
import io
import encoding.json
mut _out_registry := Vector {} as Vector<dyn OutboundMaker>
mut _in_registry := Vector {} as Vector<dyn InboundMaker>
@en "InboundConfig"
@fa "پیکربندی درون‌سو"
pub struct InboundConfig:
@en "tag"
@fa "برچسب"
pub tag: str = ""
@en "protocol"
@fa "پروتکل"
pub protocol: str = ""
@en "listen"
@fa "نشانی شنود"
pub listen: str = "127.0.0.1"
@en "port"
@fa "درگاه"
pub port: int = 0
@en "settings"
@fa "تنظیمات"
pub settings: str = ""
@en "stream_settings"
@fa "تنظیمات جریان"
pub stream_settings: str = ""
end
@en "OutboundConfig"
@fa "پیکربندی خروجی"
pub struct OutboundConfig:
@en "tag"
@fa "برچسب"
pub tag: str = ""
@en "protocol"
@fa "پروتکل"
pub protocol: str = ""
@en "settings"
@fa "تنظیمات"
pub settings: str = ""
@en "stream_settings"
@fa "تنظیمات جریان"
pub stream_settings: str = ""
end
@en "RuleConfig"
@fa "پیکربندی قاعده"
pub struct RuleConfig:
@en "domain"
@fa "دامنه‌ها"
pub domain: Vector<str> = Vector {}
@en "ip"
@fa "آی‌پی‌ها"
pub ip: Vector<str> = Vector {}
@en "port"
@fa "درگاه"
pub port: str = ""
@en "outbound_tag"
@fa "برچسب خروجی"
pub outbound_tag: str = ""
end
@en "Config"
@fa "پیکربندی"
pub struct Config:
@en "log_level"
@fa "سطح گزارش"
pub log_level: str = "warning"
@en "inbounds"
@fa "درون‌سوها"
pub inbounds: Vector<InboundConfig> = Vector {}
@en "outbounds"
@fa "خروجی‌ها"
pub outbounds: Vector<OutboundConfig> = Vector {}
@en "rules"
@fa "قاعده‌ها"
pub rules: Vector<RuleConfig> = Vector {}
@en "default_outbound"
@fa "خروجی پیش‌فرض"
pub default_outbound: str = ""
@en "errors"
@fa "خطاها"
pub errors: Vector<str> = Vector {}
end
@en "OutboundMaker"
@fa "خروجی‌ساز"
pub interface OutboundMaker:
@en "Protocol"
@fa "پروتکل"
func Protocol(): str
@en "Make"
@fa "ساخت"
func Make(cfg: OutboundConfig): dyn Dialer
end
@en "InboundMaker"
@fa "درون‌سوساز"
pub interface InboundMaker:
@en "Protocol"
@fa "پروتکل"
func Protocol(): str
@en "Make"
@fa "ساخت"
func Make(cfg: InboundConfig): dyn InboundProtocol
end
func _items(raw: str): Vector<str>:
ret json.Items(raw)
end
func _strs(raw: str): Vector<str>:
mut out := Vector {} as Vector<str>
items := json.Items(raw)
defer items.free()
repeat items.len() in i:
out.push(json.Unquote(items[i]))
end
ret out
end
func _arr(items: Vector<str>): str:
mut q := Vector {} as Vector<str>
defer q.free()
repeat items.len() in i:
q.push(json.Str(items[i]))
end
ret json.Array(q)
end
func _member_str(m &: Vector<str>, key: str, value: str):
if value.len() > 0: m.push(json.Member(key, value)) end
end
func _is_port(p: int): bool:
ret p >= 1 and p <= 65535
end
func _tag_exists(c: Config, tag: str): bool:
repeat c.outbounds.len() in i:
if c.outbounds[i].tag == tag: ret true end
end
ret false
end
func _csv_to_array(csv: str): str:
mut items := Vector {} as Vector<str>
defer items.free()
parts := csv.split(",")
defer parts.free()
repeat parts.len() in i:
p := str.Trim(parts[i])
if p.len() > 0: items.push(p) end
end
ret _arr(items)
end
func _array_to_csv(raw: str): str:
v := _strs(raw)
defer v.free()
mut out := ""
repeat v.len() in i:
if i > 0: out += "," end
out += v[i]
end
ret out
end
@en "RegisterOutbound"
@fa "ثبت خروجی"
pub func RegisterOutbound(m: dyn OutboundMaker):
name := m.Protocol()
repeat _out_registry.len() in i:
if _out_registry[i].Protocol() == name:
_out_registry[i] = m
ret
end
end
_out_registry.push(m)
end
@en "RegisterInbound"
@fa "ثبت درون‌سو"
pub func RegisterInbound(m: dyn InboundMaker):
name := m.Protocol()
repeat _in_registry.len() in i:
if _in_registry[i].Protocol() == name:
_in_registry[i] = m
ret
end
end
_in_registry.push(m)
end
@en "HasOutbound"
@fa "خروجی ثبت شده"
pub func HasOutbound(name: str): bool:
if name == "freedom" or name == "direct" or name == "blackhole" or name == "block": ret true end
repeat _out_registry.len() in i:
if _out_registry[i].Protocol() == name: ret true end
end
ret false
end
@en "HasInbound"
@fa "درون‌سو ثبت شده"
pub func HasInbound(name: str): bool:
repeat _in_registry.len() in i:
if _in_registry[i].Protocol() == name: ret true end
end
ret false
end
@en "CreateOutbound"
@fa "ساخت خروجی"
pub func CreateOutbound(cfg: OutboundConfig): dyn Dialer:
if cfg.protocol == "freedom" or cfg.protocol == "direct": ret DirectDialer {} end
repeat _out_registry.len() in i:
if _out_registry[i].Protocol() == cfg.protocol:
ret _out_registry[i].Make(cfg)
end
end
ret BlockDialer {}
end
@en "CreateInbound"
@fa "ساخت درون‌سو"
pub func CreateInbound(cfg: InboundConfig): dyn InboundProtocol:
repeat _in_registry.len() in i:
if _in_registry[i].Protocol() == cfg.protocol:
ret _in_registry[i].Make(cfg)
end
end
ret NullProtocol {}
end
@en "ParseConfig"
@fa "تجزیه پیکربندی"
pub func ParseConfig(text: str): Config:
mut c := Config {}
if not json.Valid(text):
c.errors.push("invalid JSON")
ret c
end
ll := json.Get(json.Get(text, "log"), "loglevel")
if ll.len() > 0: c.log_level = ll end
ins := _items(json.Get(text, "inbounds"))
defer ins.free()
repeat ins.len() in i:
raw := ins[i]
mut ib := InboundConfig { tag = json.Get(raw, "tag"), protocol = json.Get(raw, "protocol"), settings = json.Get(raw, "settings"), stream_settings = json.Get(raw, "streamSettings") }
l := json.Get(raw, "listen")
if l.len() > 0: ib.listen = l end
ib.port = json.Get(raw, "port").to_int()
c.inbounds.push(ib)
end
outs := _items(json.Get(text, "outbounds"))
defer outs.free()
repeat outs.len() in i:
raw := outs[i]
c.outbounds.push(OutboundConfig { tag = json.Get(raw, "tag"), protocol = json.Get(raw, "protocol"), settings = json.Get(raw, "settings"), stream_settings = json.Get(raw, "streamSettings") })
end
routing := json.Get(text, "routing")
c.default_outbound = json.Get(routing, "defaultOutbound")
rules := _items(json.Get(routing, "rules"))
defer rules.free()
repeat rules.len() in i:
raw := rules[i]
c.rules.push(RuleConfig { domain = _strs(json.Get(raw, "domain")), ip = _strs(json.Get(raw, "ip")), port = json.Get(raw, "port"), outbound_tag = json.Get(raw, "outboundTag") })
end
if c.default_outbound.len() == 0 and c.outbounds.len() > 0:
c.default_outbound = c.outbounds[0].tag
end
ret c
end
@en "LoadConfig"
@fa "بارگذاری پیکربندی"
pub func LoadConfig(path: str): Config:
text := io.ReadFile(path)
if text.len() == 0:
mut c := Config {}
c.errors.push("cannot read " + path)
ret c
end
ret ParseConfig(text)
end
@en "ValidateConfig"
@fa "اعتبارسنجی پیکربندی"
pub func ValidateConfig(c: Config): Vector<str>:
mut errs := Vector {} as Vector<str>
repeat c.errors.len() in i:
errs.push(c.errors[i])
end
if c.outbounds.len() == 0: errs.push("no outbounds") end
repeat c.inbounds.len() in i:
ib := c.inbounds[i]
if ib.protocol.len() == 0: errs.push("inbound " + i + " has no protocol") end
if not _is_port(ib.port): errs.push("inbound " + i + " has a bad port " + ib.port) end
repeat i in j:
if c.inbounds[j].tag.len() > 0 and c.inbounds[j].tag == ib.tag:
errs.push("duplicate inbound tag " + ib.tag)
end
end
end
repeat c.outbounds.len() in i:
ob := c.outbounds[i]
if ob.tag.len() == 0: errs.push("outbound " + i + " has no tag") end
if ob.protocol.len() == 0: errs.push("outbound " + i + " has no protocol") end
repeat i in j:
if c.outbounds[j].tag == ob.tag and ob.tag.len() > 0:
errs.push("duplicate outbound tag " + ob.tag)
end
end
end
repeat c.rules.len() in i:
r := c.rules[i]
if not _tag_exists(c, r.outbound_tag):
errs.push("rule " + i + " points to unknown outbound '" + r.outbound_tag + "'")
end
if r.domain.len() == 0 and r.ip.len() == 0 and r.port.len() == 0:
errs.push("rule " + i + " has no conditions")
end
if r.port.len() > 0:
mut probe := NewRule("x")
if not RulePort(probe, r.port): errs.push("rule " + i + " has a bad port '" + r.port + "'") end
end
repeat r.ip.len() in k:
mut probe := NewRule("x")
if not RuleIpSpec(probe, r.ip[k]): errs.push("rule " + i + " has a bad ip '" + r.ip[k] + "'") end
end
repeat r.domain.len() in k:
mut probe := NewRule("x")
if not RuleDomainSpec(probe, r.domain[k]): errs.push("rule " + i + " has a bad domain '" + r.domain[k] + "'") end
end
end
if c.default_outbound.len() > 0 and not _tag_exists(c, c.default_outbound):
errs.push("default outbound '" + c.default_outbound + "' does not exist")
end
ret errs
end
@en "ConfigToJson"
@fa "پیکربندی به جیسون"
pub func ConfigToJson(c: Config): str:
mut top := Vector {} as Vector<str>
defer top.free()
mut log := Vector {} as Vector<str>
defer log.free()
log.push(json.Member("loglevel", c.log_level))
top.push(json.MemberRaw("log", json.Object(log)))
mut ins := Vector {} as Vector<str>
defer ins.free()
repeat c.inbounds.len() in i:
ib := c.inbounds[i]
mut m := Vector {} as Vector<str>
_member_str(m, "tag", ib.tag)
m.push(json.Member("listen", ib.listen))
m.push(json.MemberInt("port", ib.port as i64))
m.push(json.Member("protocol", ib.protocol))
if ib.settings.len() > 0: m.push(json.MemberRaw("settings", ib.settings)) end
if ib.stream_settings.len() > 0: m.push(json.MemberRaw("streamSettings", ib.stream_settings)) end
ins.push(json.Object(m))
m.free()
end
top.push(json.MemberRaw("inbounds", json.Array(ins)))
mut outs := Vector {} as Vector<str>
defer outs.free()
repeat c.outbounds.len() in i:
ob := c.outbounds[i]
mut m := Vector {} as Vector<str>
m.push(json.Member("tag", ob.tag))
m.push(json.Member("protocol", ob.protocol))
if ob.settings.len() > 0: m.push(json.MemberRaw("settings", ob.settings)) end
if ob.stream_settings.len() > 0: m.push(json.MemberRaw("streamSettings", ob.stream_settings)) end
outs.push(json.Object(m))
m.free()
end
top.push(json.MemberRaw("outbounds", json.Array(outs)))
mut rules := Vector {} as Vector<str>
defer rules.free()
repeat c.rules.len() in i:
r := c.rules[i]
mut m := Vector {} as Vector<str>
m.push(json.Member("type", "field"))
if r.domain.len() > 0: m.push(json.MemberRaw("domain", _arr(r.domain))) end
if r.ip.len() > 0: m.push(json.MemberRaw("ip", _arr(r.ip))) end
_member_str(m, "port", r.port)
m.push(json.Member("outboundTag", r.outbound_tag))
rules.push(json.Object(m))
m.free()
end
mut routing := Vector {} as Vector<str>
defer routing.free()
_member_str(routing, "defaultOutbound", c.default_outbound)
routing.push(json.MemberRaw("rules", json.Array(rules)))
top.push(json.MemberRaw("routing", json.Object(routing)))
ret json.Object(top)
end
@en "BuildRouter"
@fa "ساخت مسیریاب"
pub func BuildRouter(c: Config): Router:
mut rt := NewRouter(c.default_outbound)
repeat c.rules.len() in i:
r := c.rules[i]
mut rule := NewRule(r.outbound_tag)
repeat r.domain.len() in k:
RuleDomainSpec(rule, r.domain[k])
end
repeat r.ip.len() in k:
RuleIpSpec(rule, r.ip[k])
end
if r.port.len() > 0: RulePort(rule, r.port) end
RouterAdd(rt, rule)
end
ret rt
end
@en "OutboundFromNode"
@fa "خروجی از گره"
pub func OutboundFromNode(n: Node, tag: str): OutboundConfig:
mut o := OutboundConfig { tag = tag, protocol = n.protocol }
mut ep := Vector {} as Vector<str>
defer ep.free()
ep.push(json.Member("address", n.host))
ep.push(json.MemberInt("port", n.port as i64))
if n.protocol == "vmess" or n.protocol == "vless":
mut u := Vector {} as Vector<str>
defer u.free()
u.push(json.Member("id", n.uuid))
if n.protocol == "vmess":
u.push(json.MemberInt("alterId", n.alter_id as i64))
mut sec := n.method
if sec.len() == 0: sec = "auto" end
u.push(json.Member("security", sec))
else:
mut enc := n.encryption
if enc.len() == 0: enc = "none" end
u.push(json.Member("encryption", enc))
_member_str(u, "flow", n.flow)
end
mut ul := Vector {} as Vector<str>
defer ul.free()
ul.push(json.Object(u))
ep.push(json.MemberRaw("users", json.Array(ul)))
mut vn := Vector {} as Vector<str>
defer vn.free()
vn.push(json.Object(ep))
mut s := Vector {} as Vector<str>
defer s.free()
s.push(json.MemberRaw("vnext", json.Array(vn)))
o.settings = json.Object(s)
else:
if n.protocol == "trojan":
ep.push(json.Member("password", n.password))
else:
ep.push(json.Member("method", n.method))
ep.push(json.Member("password", n.password))
_member_str(ep, "plugin", n.plugin)
end
mut sv := Vector {} as Vector<str>
defer sv.free()
sv.push(json.Object(ep))
mut s := Vector {} as Vector<str>
defer s.free()
s.push(json.MemberRaw("servers", json.Array(sv)))
o.settings = json.Object(s)
end
mut st := Vector {} as Vector<str>
defer st.free()
st.push(json.Member("network", n.network))
mut sec := n.security
if sec.len() == 0 and n.tls: sec = "tls" end
if sec.len() > 0 and sec != "none": st.push(json.Member("security", sec)) end
if sec == "tls":
mut t := Vector {} as Vector<str>
defer t.free()
_member_str(t, "serverName", n.sni)
_member_str(t, "fingerprint", n.fingerprint)
if n.alpn.len() > 0: t.push(json.MemberRaw("alpn", _csv_to_array(n.alpn))) end
if n.allow_insecure: t.push(json.MemberRaw("allowInsecure", "true")) end
st.push(json.MemberRaw("tlsSettings", json.Object(t)))
else sec == "reality":
mut t := Vector {} as Vector<str>
defer t.free()
_member_str(t, "serverName", n.sni)
_member_str(t, "fingerprint", n.fingerprint)
_member_str(t, "publicKey", n.public_key)
_member_str(t, "shortId", n.short_id)
_member_str(t, "spiderX", n.spider_x)
st.push(json.MemberRaw("realitySettings", json.Object(t)))
end
if n.network == "ws" or n.network == "httpupgrade":
mut w := Vector {} as Vector<str>
defer w.free()
_member_str(w, "path", n.path)
if n.host_header.len() > 0:
mut h := Vector {} as Vector<str>
defer h.free()
h.push(json.Member("Host", n.host_header))
w.push(json.MemberRaw("headers", json.Object(h)))
end
st.push(json.MemberRaw(n.network == "ws" ? "wsSettings" : "httpupgradeSettings", json.Object(w)))
else n.network == "grpc":
mut g := Vector {} as Vector<str>
defer g.free()
_member_str(g, "serviceName", n.service_name)
if n.grpc_mode == "multi": g.push(json.MemberRaw("multiMode", "true")) end
st.push(json.MemberRaw("grpcSettings", json.Object(g)))
end
o.stream_settings = json.Object(st)
ret o
end
@en "NodeFromOutbound"
@fa "گره از خروجی"
pub func NodeFromOutbound(o: OutboundConfig): Node:
mut n := Node { protocol = o.protocol, remark = o.tag }
mut ep := ""
if o.protocol == "vmess" or o.protocol == "vless":
vn := _items(json.Get(o.settings, "vnext"))
defer vn.free()
if vn.len() == 0:
n.error = "no vnext"
ret n
end
ep = vn[0]
us := _items(json.Get(ep, "users"))
defer us.free()
if us.len() == 0:
n.error = "no users"
ret n
end
n.uuid = json.Get(us[0], "id")
n.alter_id = json.Get(us[0], "alterId").to_int()
if o.protocol == "vmess":
n.method = json.Get(us[0], "security")
else:
n.encryption = json.Get(us[0], "encryption")
n.flow = json.Get(us[0], "flow")
end
else:
sv := _items(json.Get(o.settings, "servers"))
defer sv.free()
if sv.len() == 0:
n.error = "no servers"
ret n
end
ep = sv[0]
n.password = json.Get(ep, "password")
n.method = json.Get(ep, "method")
n.plugin = json.Get(ep, "plugin")
end
n.host = json.Get(ep, "address")
n.port = json.Get(ep, "port").to_int()
ss := o.stream_settings
n.network = json.Get(ss, "network")
if n.network.len() == 0: n.network = "tcp" end
n.security = json.Get(ss, "security")
n.tls = n.security == "tls" or n.security == "reality"
mut ts := json.Get(ss, "tlsSettings")
if n.security == "reality": ts = json.Get(ss, "realitySettings") end
n.sni = json.Get(ts, "serverName")
n.fingerprint = json.Get(ts, "fingerprint")
n.alpn = _array_to_csv(json.Get(ts, "alpn"))
n.allow_insecure = json.Get(ts, "allowInsecure") == "true"
n.public_key = json.Get(ts, "publicKey")
n.short_id = json.Get(ts, "shortId")
n.spider_x = json.Get(ts, "spiderX")
mut ws := json.Get(ss, "wsSettings")
if n.network == "httpupgrade": ws = json.Get(ss, "httpupgradeSettings") end
n.path = json.Get(ws, "path")
n.host_header = json.Get(json.Get(ws, "headers"), "Host")
n.service_name = json.Get(json.Get(ss, "grpcSettings"), "serviceName")
if json.Get(json.Get(ss, "grpcSettings"), "multiMode") == "true": n.grpc_mode = "multi" end
n.valid = n.host.len() > 0 and _is_port(n.port)
if not n.valid: n.error = "bad address" end
ret n
end
@en "ConfigFromNodes"
@fa "پیکربندی از گره‌ها"
pub func ConfigFromNodes(nodes: Vector<Node>, listen_port: int): Config:
mut c := Config {}
c.inbounds.push(InboundConfig { tag = "mixed-in", protocol = "mixed", port = listen_port })
repeat nodes.len() in i:
c.outbounds.push(OutboundFromNode(nodes[i], "proxy-" + (i + 1)))
end
c.outbounds.push(OutboundConfig { tag = "direct", protocol = "freedom" })
c.outbounds.push(OutboundConfig { tag = "block", protocol = "blackhole" })
if nodes.len() > 0:
c.default_outbound = "proxy-1"
else:
c.default_outbound = "direct"
end
mut r := RuleConfig { outbound_tag = "direct" }
r.domain.push("suffix:ir")
r.ip.push("geoip:private")
c.rules.push(r)
ret c
end
@en "net/tunnel"
@fa "تونل"
package tunnel
import sync
import net.internal.rawsock
mut _wd_mu := sync.NewMutex()
mut _wd_fds := Vector {} as Vector<i64>
mut _wd_at := Vector {} as Vector<i64>
mut _wd_ids := Vector {} as Vector<i64>
mut _wd_next := 1 as i64
mut _wd_started := false
mut _wd_expired := 0 as i64
func _wd_reaper():
until true:
sync.SleepMs(100)
now := sync.NowMs()
sync.Lock(_wd_mu)
mut i := 0
until i < _wd_fds.len():
if _wd_at[i] <= now:
rawsock.Shutdown(rawsock.FromFd(_wd_fds[i]))
_wd_expired++
last := _wd_fds.len() - 1
_wd_fds.set(i, _wd_fds[last])
_wd_at.set(i, _wd_at[last])
_wd_ids.set(i, _wd_ids[last])
_wd_fds.pop()
_wd_at.pop()
_wd_ids.pop()
else:
i++
end
end
sync.Unlock(_wd_mu)
end
end
@en "WatchHandshake"
@fa "پایش دست‌دهی"
pub func WatchHandshake(fd: i64, total_ms: int): i64:
if total_ms <= 0 or fd < 0: ret 0 end
sync.Lock(_wd_mu)
id := _wd_next
_wd_next++
_wd_fds.push(fd)
_wd_at.push(sync.NowMs() + (total_ms as i64))
_wd_ids.push(id)
start := not _wd_started
_wd_started = true
sync.Unlock(_wd_mu)
if start:
_t := spawn(_wd_reaper)
end
ret id
end
@en "WatchDone"
@fa "پایان پایش دست‌دهی"
pub func WatchDone(ticket: i64): bool:
if ticket <= 0: ret true end
mut found := false
sync.Lock(_wd_mu)
repeat _wd_ids.len() in i:
if not found and _wd_ids[i] == ticket:
found = true
last := _wd_fds.len() - 1
_wd_fds.set(i, _wd_fds[last])
_wd_at.set(i, _wd_at[last])
_wd_ids.set(i, _wd_ids[last])
_wd_fds.pop()
_wd_at.pop()
_wd_ids.pop()
end
end
sync.Unlock(_wd_mu)
ret found
end
@en "WatchExpired"
@fa "تعداد پایش‌های منقضی"
pub func WatchExpired(): i64:
sync.Lock(_wd_mu)
n := _wd_expired
sync.Unlock(_wd_mu)
ret n
end
@en "net/tunnel"
@fa "تونل"
package tunnel
import net.tcp
@en "Dialer"
@fa "شماره‌گیر"
pub interface Dialer:
@en "Dial"
@fa "اتصال"
func Dial(target: Addr): dyn Stream
@en "Name"
@fa "نام"
func Name(): str
end
@en "Connector"
@fa "اتصال‌دهنده"
pub interface Connector:
@en "Server"
@fa "کارساز"
func Server(): Addr
@en "Handshake"
@fa "دست‌دهی"
func Handshake(s: dyn Stream, target: Addr): bool
@en "Name"
@fa "نام"
func Name(): str
end
@en "DirectDialer"
@fa "شماره‌گیر مستقیم"
pub struct DirectDialer:
@en "timeout_ms"
@fa "مهلت اتصال"
pub timeout_ms: int = 10000
@en "resolver"
@fa "حل‌کننده"
pub resolver: dyn HostResolver = NullResolver {}
@en "has_resolver"
@fa "حل‌کننده دارد"
pub has_resolver: bool = false
@en "prefer_v6"
@fa "ترجیح نسخه شش"
pub prefer_v6: bool = false
@en "Dial"
@fa "اتصال"
pub func Dial(target: Addr): dyn Stream:
if not target.valid: ret ClosedStream {} end
if target.kind == ADDR_DOMAIN and this.has_resolver:
s := this._dial_resolved(target)
if s.Ok(): ret s end
end
ret _wrap_dialed(tcp.DialTimeout(target.host, target.port, this.timeout_ms))
end
func _dial_resolved(target: Addr): dyn Stream:
names := this.resolver.Lookup(target.host).ips
mut ordered := Vector {} as Vector<str>
defer ordered.free()
repeat 2 in pass:
repeat names.len() in i:
is6 := names[i].includes(":")
if (pass == 0) == (is6 == this.prefer_v6): ordered.push(names[i]) end
end
end
if ordered.len() == 0: ret ClosedStream {} end
ret _wrap_dialed(tcp.DialAnyTimeout(ordered, target.port, this.timeout_ms))
end
@en "Name"
@fa "نام"
pub func Name(): str:
ret "direct"
end
end
@en "BlockDialer"
@fa "شماره‌گیر مسدودکننده"
pub struct BlockDialer:
@en "refused"
@fa "ردشده"
pub refused: int = 0
@en "Dial"
@fa "اتصال"
pub func Dial(_target: Addr): dyn Stream:
this.refused++
ret ClosedStream {}
end
@en "Name"
@fa "نام"
pub func Name(): str:
ret "block"
end
end
@en "ProxyDialer"
@fa "شماره‌گیر پراکسی"
pub struct ProxyDialer:
@en "upstream"
@fa "بالادست"
pub upstream: dyn Dialer = DirectDialer {}
@en "hop"
@fa "گام"
pub hop: dyn Connector = NullConnector {}
@en "Dial"
@fa "اتصال"
pub func Dial(target: Addr): dyn Stream:
s := this.upstream.Dial(this.hop.Server())
if not s.Ok(): ret ClosedStream {} end
if not this.hop.Handshake(s, target):
s.Close()
ret ClosedStream {}
end
ret s
end
@en "Name"
@fa "نام"
pub func Name(): str:
ret this.hop.Name()
end
end
@en "NullConnector"
@fa "رابط خالی"
pub struct NullConnector:
@en "unused"
@fa "بی‌کاربرد"
pub unused: int = 0
@en "Server"
@fa "کارساز"
pub func Server(): Addr:
ret Addr {}
end
@en "Handshake"
@fa "دست‌دهی"
pub func Handshake(_s: dyn Stream, _target: Addr): bool:
ret false
end
@en "Name"
@fa "نام"
pub func Name(): str:
ret "null"
end
end
@en "Chain"
@fa "زنجیره"
pub struct Chain:
@en "base"
@fa "پایه"
pub base: dyn Dialer = DirectDialer {}
@en "hops"
@fa "گام‌ها"
pub hops: Vector<dyn Connector> = Vector {}
@en "Dial"
@fa "اتصال"
pub func Dial(target: Addr): dyn Stream:
n := this.hops.len()
if n == 0: ret this.base.Dial(target) end
s := this.base.Dial(this.hops[0].Server())
if not s.Ok(): ret ClosedStream {} end
repeat n in i:
mut next := target
if i + 1 < n: next = this.hops[i + 1].Server() end
if not this.hops[i].Handshake(s, next):
s.Close()
ret ClosedStream {}
end
end
ret s
end
@en "Name"
@fa "نام"
pub func Name(): str:
mut out := "chain"
repeat this.hops.len() in i:
out += ">" + this.hops[i].Name()
end
ret out
end
end
@en "Fallback"
@fa "جایگزین"
pub struct Fallback:
@en "items"
@fa "موارد"
pub items: Vector<dyn Dialer> = Vector {}
@en "Dial"
@fa "اتصال"
pub func Dial(target: Addr): dyn Stream:
repeat this.items.len() in i:
s := this.items[i].Dial(target)
if s.Ok(): ret s end
end
ret ClosedStream {}
end
@en "Name"
@fa "نام"
pub func Name(): str:
ret "fallback"
end
end
func _wrap_dialed(c: tcp.Conn): dyn Stream:
if not tcp.ConnOk(c): ret ClosedStream {} end
tcp.SetNoDelay(c, true)
ret TcpStream { conn = c }
end
@en "NewChain"
@fa "زنجیره جدید"
pub func NewChain(base: dyn Dialer): Chain:
ret Chain { base = base }
end
@en "ChainAdd"
@fa "افزودن گام"
pub func ChainAdd(c &: Chain, hop: dyn Connector):
c.hops.push(hop)
end
