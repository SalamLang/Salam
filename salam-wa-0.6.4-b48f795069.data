if ftype == 1:
if mx > 0:
_vp8_simple(y, yp, 1, ys, limit + 4)
end
if inner:
repeat 3 in k:
_vp8_simple(y, yp + 4 * (k + 1), 1, ys, limit)
end
end
if my > 0:
_vp8_simple(y, yp, ys, 1, limit + 4)
end
if inner:
repeat 3 in k:
_vp8_simple(y, yp + 4 * (k + 1) * ys, ys, 1, limit)
end
end
ret
end
up := my * 8 * uvs + mx * 8
if mx > 0:
_vp8_loop(y, yp, 1, ys, 16, limit + 4, ilevel, hev, true)
_vp8_loop(u, up, 1, uvs, 8, limit + 4, ilevel, hev, true)
_vp8_loop(v, up, 1, uvs, 8, limit + 4, ilevel, hev, true)
end
if inner:
repeat 3 in k:
_vp8_loop(y, yp + 4 * (k + 1), 1, ys, 16, limit, ilevel, hev, false)
end
_vp8_loop(u, up + 4, 1, uvs, 8, limit, ilevel, hev, false)
_vp8_loop(v, up + 4, 1, uvs, 8, limit, ilevel, hev, false)
end
if my > 0:
_vp8_loop(y, yp, ys, 1, 16, limit + 4, ilevel, hev, true)
_vp8_loop(u, up, uvs, 1, 8, limit + 4, ilevel, hev, true)
_vp8_loop(v, up, uvs, 1, 8, limit + 4, ilevel, hev, true)
end
if inner:
repeat 3 in k:
_vp8_loop(y, yp + 4 * (k + 1) * ys, ys, 1, 16, limit, ilevel, hev, false)
end
_vp8_loop(u, up + 4 * uvs, uvs, 1, 8, limit, ilevel, hev, false)
_vp8_loop(v, up + 4 * uvs, uvs, 1, 8, limit, ilevel, hev, false)
end
end
func _vp8_mulhi(v: int, c: int): int:
ret (v * c) >> 8
end
func _vp8_clip8(v: int): int:
ret (v & (0 - 16384)) == 0 ? v >> 6 : (v < 0 ? 0 : 255)
