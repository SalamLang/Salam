@en "Type"
@fa "نوع"
pub struct Type:
@en "handle"
@fa "دسته"
pub handle: void* = null
end
@en "Value"
@fa "مقدار"
pub struct Value:
@en "handle"
@fa "دسته"
pub handle: void* = null
end
@en "BasicBlock"
@fa "بلوک پایه"
pub struct BasicBlock:
@en "handle"
@fa "دسته"
pub handle: void* = null
end
@en "Builder"
@fa "سازنده"
pub struct Builder:
@en "handle"
@fa "دسته"
pub handle: void* = null
end
func _pack_types(v: Vector<Type>): void*:
n := v.len()
if n == 0:
ret null
end
buf := mem.Allocate((n as u64) * 8)
mut i := 0
until i < n:
slot := ((buf as u64) + (i as u64) * 8) as u64*
slot[0] = v.get(i).handle as u64
i++
end
ret buf
end
func _pack_values(v: Vector<Value>): void*:
n := v.len()
if n == 0:
ret null
end
buf := mem.Allocate((n as u64) * 8)
mut i := 0
until i < n:
slot := ((buf as u64) + (i as u64) * 8) as u64*
slot[0] = v.get(i).handle as u64
i++
end
ret buf
end
func _pack_blocks(v: Vector<BasicBlock>): void*:
n := v.len()
if n == 0:
ret null
end
buf := mem.Allocate((n as u64) * 8)
mut i := 0
until i < n:
slot := ((buf as u64) + (i as u64) * 8) as u64*
slot[0] = v.get(i).handle as u64
i++
end
ret buf
end
@en "NewModule"
@fa "ماژول جدید"
pub func NewModule(ctx: Context, name: str): Module:
ret Module { handle = LLVMModuleCreateWithNameInContext(name, ctx.handle) }
end
@en "ModuleToString"
@fa "ماژول به رشته"
pub func ModuleToString(mod: Module): str:
p := LLVMPrintModuleToString(mod.handle)
if p == null:
ret ""
end
out := str.Clone(p as str)
LLVMDisposeMessage(p)
ret out
end
@en "Int1Type"
@fa "نوع یک بیتی"
pub func Int1Type(c: Context): Type: ret Type { handle = LLVMInt1TypeInContext(c.handle) } end
@en "Int8Type"
@fa "نوع هشت بیتی"
pub func Int8Type(c: Context): Type: ret Type { handle = LLVMInt8TypeInContext(c.handle) } end
@en "Int16Type"
@fa "نوع شانزده بیتی"
pub func Int16Type(c: Context): Type: ret Type { handle = LLVMInt16TypeInContext(c.handle) } end
@en "Int32Type"
@fa "نوع سی‌ودو بیتی"
pub func Int32Type(c: Context): Type: ret Type { handle = LLVMInt32TypeInContext(c.handle) } end
@en "Int64Type"
@fa "نوع شصت‌وچهار بیتی"
pub func Int64Type(c: Context): Type: ret Type { handle = LLVMInt64TypeInContext(c.handle) } end
@en "VoidType"
@fa "نوع تهی"
pub func VoidType(c: Context): Type: ret Type { handle = LLVMVoidTypeInContext(c.handle) } end
@en "FloatType"
@fa "نوع اعشاری"
pub func FloatType(c: Context): Type: ret Type { handle = LLVMFloatTypeInContext(c.handle) } end
@en "DoubleType"
@fa "نوع اعشاری دقیق"
pub func DoubleType(c: Context): Type: ret Type { handle = LLVMDoubleTypeInContext(c.handle) } end
@en "PointerType"
@fa "نوع اشاره‌گر"
pub func PointerType(c: Context): Type: ret Type { handle = LLVMPointerTypeInContext(c.handle, 0) } end
@en "ArrayType"
@fa "نوع آرایه"
pub func ArrayType(elem: Type, n: i64): Type:
ret Type { handle = LLVMArrayType2(elem.handle, n as u64) }
end
@en "FunctionType"
@fa "نوع تابعی"
pub func FunctionType(ret_ty: Type, params: Vector<Type>, vararg: bool): Type:
p := _pack_types(params)
t := LLVMFunctionType(ret_ty.handle, p, params.len(), vararg ? 1 : 0)
if p != null: mem.Free(p) end
ret Type { handle = t }
end
@en "AddFunction"
@fa "افزودن تابعی"
pub func AddFunction(mod: Module, name: str, fnty: Type): Value:
ret Value { handle = LLVMAddFunction(mod.handle, name, fnty.handle) }
end
@en "NamedFunction"
@fa "تابع نام‌دار"
pub func NamedFunction(mod: Module, name: str): Value:
ret Value { handle = LLVMGetNamedFunction(mod.handle, name) }
end
@en "Param"
@fa "پارامتر"
pub func Param(fn: Value, idx: int): Value:
ret Value { handle = LLVMGetParam(fn.handle, idx) }
end
@en "SetLinkage"
@fa "تنظیم پیوند"
pub func SetLinkage(v: Value, linkage: int): LLVMSetLinkage(v.handle, linkage) end
@en "AppendBlock"
@fa "افزودن بلوک"
pub func AppendBlock(c: Context, fn: Value, name: str): BasicBlock:
ret BasicBlock { handle = LLVMAppendBasicBlockInContext(c.handle, fn.handle, name) }
end
@en "NewBuilder"
@fa "سازنده جدید"
pub func NewBuilder(c: Context): Builder:
ret Builder { handle = LLVMCreateBuilderInContext(c.handle) }
end
@en "PositionAtEnd"
@fa "قرار دادن در انتها"
pub func PositionAtEnd(b: Builder, bb: BasicBlock): LLVMPositionBuilderAtEnd(b.handle, bb.handle) end
@en "InsertBlock"
@fa "بلوک درج"
pub func InsertBlock(b: Builder): BasicBlock:
ret BasicBlock { handle = LLVMGetInsertBlock(b.handle) }
end
@en "FreeBuilder"
@fa "آزادسازی سازنده"
pub func FreeBuilder(b: Builder): LLVMDisposeBuilder(b.handle) end
@en "ConstInt"
@fa "ثابت صحیح"
pub func ConstInt(ty: Type, v: i64): Value:
ret Value { handle = LLVMConstInt(ty.handle, v as u64, 1) }
end
@en "ConstReal"
@fa "ثابت اعشاری"
pub func ConstReal(ty: Type, v: f64): Value:
ret Value { handle = LLVMConstReal(ty.handle, v) }
end
@en "Ret"
@fa "بازگشت"
pub func Ret(b: Builder, v: Value): Value:
ret Value { handle = LLVMBuildRet(b.handle, v.handle) }
end
@en "RetVoid"
@fa "بازگشت تهی"
pub func RetVoid(b: Builder): Value:
ret Value { handle = LLVMBuildRetVoid(b.handle) }
end
@en "Add"
@fa "جمع"
pub func Add(b: Builder, l: Value, r: Value, name: str): Value:
ret Value { handle = LLVMBuildAdd(b.handle, l.handle, r.handle, name) }
end
@en "Sub"
@fa "تفریق"
pub func Sub(b: Builder, l: Value, r: Value, name: str): Value:
ret Value { handle = LLVMBuildSub(b.handle, l.handle, r.handle, name) }
end
@en "Mul"
@fa "ضرب"
pub func Mul(b: Builder, l: Value, r: Value, name: str): Value:
ret Value { handle = LLVMBuildMul(b.handle, l.handle, r.handle, name) }
end
@en "SDiv"
@fa "تقسیم علامت‌دار"
pub func SDiv(b: Builder, l: Value, r: Value, name: str): Value:
ret Value { handle = LLVMBuildSDiv(b.handle, l.handle, r.handle, name) }
end
@en "SRem"
@fa "باقیمانده علامت‌دار"
pub func SRem(b: Builder, l: Value, r: Value, name: str): Value:
ret Value { handle = LLVMBuildSRem(b.handle, l.handle, r.handle, name) }
end
@en "ICmp"
@fa "مقایسه صحیح"
pub func ICmp(b: Builder, pred: int, l: Value, r: Value, name: str): Value:
ret Value { handle = LLVMBuildICmp(b.handle, pred, l.handle, r.handle, name) }
end
@en "Br"
@fa "پرش"
pub func Br(b: Builder, dest: BasicBlock): Value:
ret Value { handle = LLVMBuildBr(b.handle, dest.handle) }
end
@en "CondBr"
@fa "پرش شرطی"
pub func CondBr(b: Builder, cond: Value, t: BasicBlock, f: BasicBlock): Value:
ret Value { handle = LLVMBuildCondBr(b.handle, cond.handle, t.handle, f.handle) }
end
@en "Phi"
@fa "فای"
pub func Phi(b: Builder, ty: Type, name: str): Value:
ret Value { handle = LLVMBuildPhi(b.handle, ty.handle, name) }
end
@en "AddIncoming"
@fa "افزودن ورودی فای"
pub func AddIncoming(phi: Value, vals: Vector<Value>, blocks: Vector<BasicBlock>):
n := vals.len()
if n == 0 or blocks.len() != n:
ret
end
pv := _pack_values(vals)
pb := _pack_blocks(blocks)
LLVMAddIncoming(phi.handle, pv, pb, n)
mem.Free(pv)
mem.Free(pb)
end
@en "Call"
@fa "فراخوان"
pub func Call(b: Builder, fnty: Type, fn: Value, args: Vector<Value>, name: str): Value:
p := _pack_values(args)
v := LLVMBuildCall2(b.handle, fnty.handle, fn.handle, p, args.len(), name)
if p != null: mem.Free(p) end
ret Value { handle = v }
end
@en "Alloca"
@fa "تخصیص پشته"
pub func Alloca(b: Builder, ty: Type, name: str): Value:
ret Value { handle = LLVMBuildAlloca(b.handle, ty.handle, name) }
end
@en "Load"
@fa "بارگذاری"
pub func Load(b: Builder, ty: Type, ptr: Value, name: str): Value:
ret Value { handle = LLVMBuildLoad2(b.handle, ty.handle, ptr.handle, name) }
end
@en "Store"
@fa "ذخیره"
pub func Store(b: Builder, val: Value, ptr: Value): Value:
ret Value { handle = LLVMBuildStore(b.handle, val.handle, ptr.handle) }
end
@en "GlobalString"
@fa "رشته سراسری"
pub func GlobalString(b: Builder, s: str, name: str): Value:
ret Value { handle = LLVMBuildGlobalStringPtr(b.handle, s, name) }
end
@en "AddGlobal"
@fa "افزودن سراسری"
pub func AddGlobal(mod: Module, ty: Type, name: str): Value:
ret Value { handle = LLVMAddGlobal(mod.handle, ty.handle, name) }
end
@en "SetInitializer"
@fa "تنظیم مقدار اولیه"
pub func SetInitializer(g: Value, v: Value): LLVMSetInitializer(g.handle, v.handle) end
@en "SetGlobalConstant"
@fa "تنظیم ثابت سراسری"
pub func SetGlobalConstant(g: Value, flag: bool): LLVMSetGlobalConstant(g.handle, flag ? 1 : 0) end
package llvm
extern:
func LLVMTargetMachineEmitToFile(tm: void*, mod: void*, path: str, file_type: int, out_err &: void*): int
func LLVMWriteBitcodeToFile(mod: void*, path: str): int
end
@en "EmitResult"
@fa "نتیجه تولید"
pub struct EmitResult:
@en "ok"
@fa "موفق"
pub ok: bool = false
@en "err"
@fa "خطا"
pub err: str = ""
end
func emit_to_file(mod: Module, tm: TargetMachine, path: str, file_type: int): EmitResult:
mut eerr := null as void*
if LLVMTargetMachineEmitToFile(tm.handle, mod.handle, path, file_type, eerr) != 0:
msg := eerr != null ? str.Clone(eerr as str) : "(unknown)"
if eerr != null: LLVMDisposeMessage(eerr) end
ret EmitResult { ok = false, err = "LLVM emit failed for '" + path + "': " + msg }
end
ret EmitResult { ok = true }
end
@en "EmitAsm"
@fa "تولید اسمبلی"
pub func EmitAsm(mod: Module, tm: TargetMachine, path: str): EmitResult:
ret emit_to_file(mod, tm, path, CODEGEN_FILE_ASSEMBLY)
end
@en "EmitObject"
@fa "تولید شیء"
pub func EmitObject(mod: Module, tm: TargetMachine, path: str): EmitResult:
ret emit_to_file(mod, tm, path, CODEGEN_FILE_OBJECT)
end
@en "EmitBitcode"
@fa "تولید بیت‌کد"
pub func EmitBitcode(mod: Module, path: str): EmitResult:
if LLVMWriteBitcodeToFile(mod.handle, path) != 0:
ret EmitResult { ok = false, err = "LLVM bitcode write failed for '" + path + "'" }
end
ret EmitResult { ok = true }
end
package llvm
