"contrast": chain.Add(paint.NewFilter(paint.FilterKind.Contrast, f.amount)) break end
"grayscale": chain.Add(paint.NewFilter(paint.FilterKind.Grayscale, f.amount)) break end
"sepia": chain.Add(paint.NewFilter(paint.FilterKind.Sepia, f.amount)) break end
"saturate": chain.Add(paint.NewFilter(paint.FilterKind.Saturate, f.amount)) break end
