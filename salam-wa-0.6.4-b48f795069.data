noret func _crypto_fatal():
abort()
end
func _os_random_fill(buf: void*, n: int):
if SALAM_OS_WINDOWS:
tmp := mem.Allocate(4 as u64)
defer mem.Free(tmp)
mut filled := 0
until filled < n:
rc := rand_s(tmp)
if rc != 0:
_crypto_fatal()
end
mut k := 0
until k < 4 and filled < n:
_bput(buf, filled, _bget(tmp, k))
filled++
k++
end
end
else:
f := fopen("/dev/urandom", "rb")
if f == null:
_crypto_fatal()
end
mut total := 0
until total < n:
dst := ((buf as i64) + total) as void*
got := fread(dst, 1 as u64, (n - total) as u64, f)
if got == (0 as u64):
fclose(f)
_crypto_fatal()
end
total += got as int
