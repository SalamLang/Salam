mut x := _bget(ap, i)
mut y := _bget(bp, i)
if x >= 65 and x <= 90:
x += 32
end
if y >= 65 and y <= 90:
y += 32
end
if x != y:
ret false
end
end
ret true
end
inline func _sbyte(s: str, i: int): int:
ret _bget(s as void*, i)
end
inline func _lowerb(c: int): int:
if c >= 65 and c <= 90:
ret c + 32
end
ret c
end
func _host_match(pattern: str, host: str): bool:
plen := pattern.len()
hlen := host.len()
if plen == 0 or hlen == 0:
ret false
end
if _sbyte(pattern, 0) != 42:
ret _ascii_eqfold(pattern, host)
end
if plen < 3 or _sbyte(pattern, 1) != 46:
ret false
end
mut dots := 0
mut i := 1
until i < plen:
if _sbyte(pattern, i) == 46:
dots++
end
i++
end
if dots < 2:
ret false
end
mut dot := 0 - 1
mut j := 0
until j < hlen:
if _sbyte(host, j) == 46:
dot = j
j = hlen
else:
j++
end
end
if dot < 0:
ret false
end
if hlen - dot != plen - 1:
ret false
end
mut k := 0
until k < plen - 1:
if _lowerb(_sbyte(pattern, 1 + k)) != _lowerb(_sbyte(host, dot + k)):
ret false
end
k++
end
ret true
end
func _parse_ip4(s: str): Ip4:
mut r := Ip4 {}
n := s.len()
if n < 7 or n > 15:
ret r
end
mut parts := 0
mut val := 0
mut digits := 0
mut i := 0
until i < n:
c := _sbyte(s, i)
if c >= 48 and c <= 57:
if digits == 1 and val == 0:
ret r
end
val = val * 10 + (c - 48)
digits++
if digits > 3 or val > 255:
ret r
end
else if c == 46:
if digits == 0 or parts >= 3:
ret r
end
r.b[parts] = val
parts++
val = 0
digits = 0
else:
ret r
end
i++
end
if digits == 0 or parts != 3:
ret r
end
r.b[3] = val
r.ok = true
ret r
end
func _cert_match_host(c: Cert, host: str): bool:
if not c.has_san:
ret false
end
ipa := _parse_ip4(host)
mut s := c.san
mut seq := _der_seq(s)
if s.bad:
ret false
end
until _rdleft(seq) > 0 and not seq.bad:
t := _der(seq)
if not t.ok:
ret false
end
if t.tag == 0x82:
if not ipa.ok:
name := _rd_to_str(t.body)
if name.len() > 0:
if _host_match(name, host):
ret true
end
end
end
end
if t.tag == 0x87:
if ipa.ok and t.body.len == 4:
mut same := true
repeat 4 in k:
if _rdat(t.body, k) != ipa.b[k]:
same = false
end
end
if same:
ret true
end
end
end
end
ret false
end
