@en "Buf"
@fa "میان‌گیر"
pub struct Buf:
@en "data"
@fa "داده"
pub data: void* = null
@en "len"
@fa "طول"
pub len: int = 0
@en "cap"
@fa "ظرفیت"
pub cap: int = 0
end
@en "Pipe"
@fa "لوله"
pub struct Pipe:
@en "r"
@fa "خواندن"
pub r: i64 = -1
@en "w"
@fa "نوشتن"
pub w: i64 = -1
@en "ok"
@fa "موفق"
pub ok: bool = false
end
if not SALAM_OS_WINDOWS:
if SALAM_ARCH_X86 or SALAM_ARCH_ARM or SALAM_ARCH_WASM:
func _sys_read(fd: int, buf: void*, n: int): int: ret read(fd, buf, n as u32) end
func _sys_write(fd: int, buf: void*, n: int): int: ret write(fd, buf, n as u32) end
else:
func _sys_read(fd: int, buf: void*, n: int): int: ret read(fd, buf, n as u64) as int end
func _sys_write(fd: int, buf: void*, n: int): int: ret write(fd, buf, n as u64) as int end
end
end
func _handle(h: i64): void*:
ret h as void*
end
func _grow(b &: Buf, need: int):
if b.cap - b.len >= need: ret end
mut cap := b.cap
if cap < 4096: cap = 4096 end
until cap - b.len < need:
cap *= 2
end
if b.data == null:
b.data = mem.Allocate(cap as u64)
else:
b.data = mem.Reallocate(b.data, cap as u64)
end
b.cap = cap
end
if SALAM_OS_WINDOWS:
func _poll_once(h: i64): int:
avail := mem.AllocateZeroed(8 as u64)
ok := PeekNamedPipe(_handle(h), null, 0 as u32, null, avail, null)
n := (avail as u32*)[0]
mem.Free(avail)
if ok == 0: ret 1 end
if n > (0 as u32): ret 1 end
ret 0
end
@en "PollRead"
@fa "پایش خواندن"
pub func PollRead(h: i64, ms: int): int:
start := time.NowMillis()
mut r := 0
until true:
if _poll_once(h) == 1:
r = 1
break
end
if ms == 0: break end
if ms > 0 and time.NowMillis() - start >= (ms as i64): break end
Sleep(2)
end
ret r
end
@en "ReadRaw"
@fa "خواندن خام"
pub func ReadRaw(h: i64, buf: void*, n: int): int:
got := mem.AllocateZeroed(8 as u64)
ok := ReadFile(_handle(h), buf, n as u32, got, null)
r := (got as u32*)[0] as int
mem.Free(got)
if ok == 0 or r <= 0: ret 0 - 1 end
ret r
end
@en "WriteRaw"
@fa "نوشتن خام"
pub func WriteRaw(h: i64, buf: void*, n: int): int:
wrote := mem.AllocateZeroed(8 as u64)
ok := WriteFile(_handle(h), buf, n as u32, wrote, null)
r := (wrote as u32*)[0] as int
mem.Free(wrote)
if ok == 0: ret 0 - 1 end
ret r
end
@en "PollTwo"
@fa "پایش دو دسته"
pub func PollTwo(a: i64, b: i64, ms: int): int:
start := time.NowMillis()
mut r := 0
until true:
if a >= 0 and _poll_once(a) == 1: r |= 1 end
if b >= 0 and _poll_once(b) == 1: r |= 2 end
if r != 0: break end
if ms == 0: break end
if ms > 0 and time.NowMillis() - start >= (ms as i64): break end
Sleep(2)
end
ret r
end
@en "PollWrite"
@fa "پایش نوشتن"
pub func PollWrite(_h: i64, _ms: int): int:
ret 1
end
@en "Close"
@fa "بستن"
pub func Close(h: i64):
if h != 0 - 1 and h != 0:
_ignored := CloseHandle(_handle(h))
end
end
else:
func _listed(list: Vector<str>, name: str): bool:
mut i := 0
until i < list.len():
if list.get(i) == name: ret true end
i++
end
ret false
end
func _lookup(program: str, path_env: str): str:
if str.Contains(program, "/"): ret str.Clone(program) end
parts := path_env.split(":")
defer parts.free()
mut found := ""
mut i := 0
until i < parts.len():
dir := parts.get(i)
cand := dir.len() == 0 ? "./" + program : dir + "/" + program
if access(cand, 1) == 0:
found = cand
break
end
mem.Free(cand as void*)
i++
end
each part in parts:
mem.Free(part as void*)
end
ret found.len() > 0 ? found : str.Clone("")
end
@en "PollRead"
@fa "پایش خواندن"
pub func PollRead(h: i64, ms: int): int:
pfd := mem.AllocateZeroed(8 as u64)
defer mem.Free(pfd)
(pfd as int*)[0] = h as int
(pfd as i16*)[2] = 1 as i16
r := poll(pfd, 1 as usize, ms)
if r < 0: ret 0 - 1 end
ret r
end
@en "ReadRaw"
@fa "خواندن خام"
pub func ReadRaw(h: i64, buf: void*, n: int): int:
r := _sys_read(h as int, buf, n)
if r <= 0: ret 0 - 1 end
ret r
end
@en "WriteRaw"
@fa "نوشتن خام"
pub func WriteRaw(h: i64, buf: void*, n: int): int:
r := _sys_write(h as int, buf, n)
if r < 0: ret 0 - 1 end
ret r
end
@en "PollTwo"
@fa "پایش دو دسته"
pub func PollTwo(a: i64, b: i64, ms: int): int:
pfd := mem.AllocateZeroed(16 as u64)
defer mem.Free(pfd)
(pfd as int*)[0] = a as int
(pfd as i16*)[2] = 1 as i16
(pfd as int*)[2] = b as int
(pfd as i16*)[6] = 1 as i16
r := poll(pfd, 2 as usize, ms)
if r < 0: ret 0 - 1 end
mut mask := 0
if a >= 0 and (pfd as i16*)[3] != (0 as i16): mask |= 1 end
if b >= 0 and (pfd as i16*)[7] != (0 as i16): mask |= 2 end
ret mask
end
@en "PollWrite"
@fa "پایش نوشتن"
pub func PollWrite(h: i64, ms: int): int:
pfd := mem.AllocateZeroed(8 as u64)
defer mem.Free(pfd)
(pfd as int*)[0] = h as int
(pfd as i16*)[2] = 4 as i16
r := poll(pfd, 1 as usize, ms)
if r < 0: ret 0 - 1 end
ret r
end
@en "MakePipe"
@fa "ساخت لوله"
pub func MakePipe(): Pipe:
fds := mem.AllocateZeroed(8 as u64)
defer mem.Free(fds)
if pipe(fds) != 0: ret Pipe {} end
p := fds as int*
_a := fcntl(p[0], 2, 1)
_b := fcntl(p[1], 2, 1)
ret Pipe { r = p[0] as i64, w = p[1] as i64, ok = true }
end
@en "Redirect"
@fa "تغییر مسیر"
pub func Redirect(from_fd: int, to_fd: int):
if from_fd == to_fd:
_c := fcntl(from_fd, 2, 0)
else:
_d := dup2(from_fd, to_fd)
end
end
@en "Environ"
@fa "محیط فرآیند"
pub func Environ(): void*:
ret environ
end
@en "ExecVe"
@fa "اجرای برنامه"
pub func ExecVe(path: str, argv: void*, envp: void*): int:
ret execve(path, argv, envp)
end
@en "Resolve"
@fa "یافتن برنامه"
pub func Resolve(program: str, env: HashMap<str, str>, clear_env: bool): str:
mut path_env := "/usr/bin:/bin"
mut owned := false
if env.has("PATH"):
path_env = env.get("PATH")
else not clear_env:
v := getenv("PATH")
if v != null:
path_env = str.Clone(v as str)
owned = true
end
end
out := _lookup(program, path_env)
if owned: mem.Free(path_env as void*) end
ret out
end
@en "BuildArgv"
@fa "ساخت آرگومان ها"
pub func BuildArgv(program: str, args: Vector<str>): void*:
n := args.len()
arr := mem.Allocate(((n + 2) as u64) * (sizeof(str) as u64)) as str*
arr[0] = program
mut i := 0
until i < n:
arr[i + 1] = args.get(i)
i++
end
arr[n + 1] = (null as void*) as str
ret arr as void*
end
@en "BuildEnvp"
@fa "ساخت محیط"
pub func BuildEnvp(clear_env: bool, env: HashMap<str, str>, unset_env: Vector<str>, owned &: Vector<str>): void*:
if not clear_env and env.size() == 0 and unset_env.len() == 0: ret null end
mut items := Vector {} as Vector<str>
defer items.free()
if not clear_env:
pv := environ as void**
mut i := 0
until pv[i] != null:
entry := pv[i] as str
bytes := entry as u8*
mut k := 0
until bytes[k] != (0 as u8) and bytes[k] != (61 as u8):
k++
end
key := str.Substr(entry, 0, k)
if not env.has(key) and not _listed(unset_env, key):
items.push(entry)
end
mem.Free(key as void*)
i++
end
end
each name, value in env:
line := name + "=" + value
owned.push(line)
items.push(line)
end
n := items.len()
arr := mem.Allocate(((n + 1) as u64) * (sizeof(str) as u64)) as str*
mut j := 0
until j < n:
arr[j] = items.get(j)
j++
end
arr[n] = (null as void*) as str
ret arr as void*
end
@en "Close"
@fa "بستن"
pub func Close(h: i64):
if h >= 0:
_ignored := close(h as int)
end
end
end
@en "WriteAll"
@fa "نوشتن همه"
pub func WriteAll(h: i64, ptr: void*, n: int): bool:
mut sent := 0
until sent < n:
r := WriteRaw(h, (ptr as i64 + sent as i64) as void*, n - sent)
if r <= 0: ret false end
sent += r
end
ret true
end
@en "Empty"
@fa "تهی"
pub func Empty(): str:
out := mem.AllocateZeroed(1 as u64)
ret out as str
end
@en "Fill"
@fa "پر کردن"
pub func Fill(b &: Buf, h: i64, ms: int): int:
if h < 0: ret 0 - 1 end
r := PollRead(h, ms)
if r == 0: ret 0 end
if r < 0: ret 0 - 1 end
_grow(b, 4096)
n := ReadRaw(h, (b.data as i64 + b.len as i64) as void*, b.cap - b.len)
if n <= 0: ret 0 - 1 end
b.len += n
ret n
end
@en "Append"
@fa "افزودن"
pub func Append(b &: Buf, ptr: void*, n: int):
_grow(b, n + 1)
mem.Copy((b.data as i64 + b.len as i64) as void*, ptr, n as u64)
b.len += n
end
@en "IndexByte"
@fa "جایگاه بایت"
pub func IndexByte(b: Buf, value: int, from: int): int:
if b.data == null: ret 0 - 1 end
p := b.data as u8*
mut i := from
until i < b.len:
if (p[i] as int) == value: ret i end
i++
end
ret 0 - 1
end
@en "IndexStr"
@fa "جایگاه متن"
pub func IndexStr(b: Buf, needle: str): int:
m := needle.len()
if m == 0: ret 0 end
if b.data == null or b.len < m: ret 0 - 1 end
p := b.data as u8*
q := needle as u8*
mut i := 0
until i + m <= b.len:
mut j := 0
until j < m and p[i + j] == q[j]:
j++
end
if j == m: ret i end
i++
end
ret 0 - 1
end
@en "Take"
@fa "برداشتن"
pub func Take(b &: Buf, n: int): str:
mut k := n
if k > b.len: k = b.len end
out := mem.Allocate((k + 1) as u64) as u8*
if k > 0: mem.Copy(out as void*, b.data, k as u64) end
out[k] = 0 as u8
rest := b.len - k
if rest > 0:
_moved := mem.MemMove(b.data, (b.data as i64 + k as i64) as void*, rest as u64)
end
b.len = rest
ret out as str
end
@en "TakeInto"
@fa "برداشتن در حافظه"
pub func TakeInto(b &: Buf, dst: void*, max: int): int:
mut k := max
if k > b.len: k = b.len end
if k > 0: mem.Copy(dst, b.data, k as u64) end
rest := b.len - k
if rest > 0:
_moved := mem.MemMove(b.data, (b.data as i64 + k as i64) as void*, rest as u64)
end
b.len = rest
ret k
end
@en "Release"
@fa "رها کردن"
pub func Release(b &: Buf):
if b.data != null: mem.Free(b.data) end
b.data = null
b.len = 0
b.cap = 0
end
@en "mmap"
@fa "نگاشت حافظه"
package mmap
if not SALAM_OS_WINDOWS:
extern:
func mmap(addr: void*, len: usize, prot: int, flags: int, fd: int, offset: size): void*
func munmap(addr: void*, len: usize): int
func mprotect(addr: void*, len: usize, prot: int): int
func getpagesize(): int
end
end
@en "PROT_NONE"
@fa "بدون دسترسی"
pub const PROT_NONE := 0
@en "PROT_READ"
@fa "دسترسی خواندن"
pub const PROT_READ := 1
@en "PROT_WRITE"
@fa "دسترسی نوشتن"
pub const PROT_WRITE := 2
@en "PROT_EXEC"
@fa "دسترسی اجرا"
pub const PROT_EXEC := 4
if SALAM_OS_WINDOWS:
const MAP_ANON := 0
else SALAM_OS_MAC or SALAM_OS_FREEBSD:
const MAP_ANON := 4096
else:
const MAP_ANON := 32
end
@en "Supported"
@fa "پشتیبانی می شود"
pub func Supported(): bool:
ret not SALAM_OS_WINDOWS
end
@en "PageSize"
@fa "اندازه صفحه"
pub func PageSize(): int:
if SALAM_OS_WINDOWS:
ret 4096
else:
ret getpagesize()
end
end
@en "Alloc"
@fa "تخصیص"
pub func Alloc(size: int, prot: int): void*:
if SALAM_OS_WINDOWS:
ret null
else:
if size <= 0:
ret null
end
p := mmap(null, size as usize, prot, 2 | MAP_ANON, 0 - 1, 0 as size)
if (p as size) == (0 - 1):
ret null
end
ret p
end
end
@en "Protect"
@fa "تغییر دسترسی"
pub func Protect(p: void*, size: int, prot: int): bool:
if SALAM_OS_WINDOWS:
ret false
else:
if p == null or size <= 0:
ret false
end
ret mprotect(p, size as usize, prot) == 0
end
end
@en "Free"
@fa "آزادسازی"
pub func Free(p: void*, size: int): bool:
if SALAM_OS_WINDOWS:
ret false
else:
if p == null or size <= 0:
ret false
end
ret munmap(p, size as usize) == 0
end
end
@en "os"
@fa "سیستم عامل"
package os
import mem
import str
import io
import filepath
extern:
func salam_open(path: str, mode: str): File*
func salam_os_listdir(path: str, out_count: void*): void*
func getenv(name: str): void*
noret func exit(code: int)
noret func abort()
func remove(path: str): int
func rename(old: str, new_path: str): int
func fopen(path: str, mode: str): void*
func fseek(fp: void*, off: int, whence: int): int
func ftell(fp: void*): int
func fclose(fp: void*): int
func system(cmd: str): int
func fgets(buf: void*, n: int, fp: void*): void*
func fread(ptr: void*, size: u64, nmemb: u64, stream: void*): u64
func fwrite(ptr: void*, size: u64, nmemb: u64, stream: void*): u64
end
if SALAM_OS_WINDOWS:
extern:
func _wmkdir(path: void*): int
func _wrmdir(path: void*): int
func _wchdir(path: void*): int
func GetCurrentDirectoryW(sz: int, buf: void*): int
func GetFileAttributesW(path: void*): int
func CreateFileW(path: void*, access: u32, share: u32, security: void*, disposition: u32, flags: u32, template: void*): void*
func GetFinalPathNameByHandleW(handle: void*, buf: void*, size: u32, flags: u32): u32
func CloseHandle(h: void*): int
func DeleteFileW(path: void*): int
func MoveFileExW(old: void*, new_path: void*, flags: u32): int
func _wopen(path: void*, flags: int, mode: int): int
func _fdopen(fd: int, mode: str): void*
func MultiByteToWideChar(codepage: u32, flags: u32, src: str, srclen: i32, dst: void*, dstlen: i32): i32
func WideCharToMultiByte(codepage: u32, flags: u32, src: void*, srclen: i32, dst: void*, dstlen: i32, def: void*, used: void*): i32
func _popen(cmd: str, mode: str): void*
func _pclose(fp: void*): int
func _getpid(): int
end
else:
extern:
func mkdir(path: str, mode: int): int
func rmdir(path: str): int
func chdir(path: str): int
func access(path: str, mode: int): int
func getcwd(buf: void*, sz: int): void*
func opendir(path: str): void*
func closedir(d: void*): int
func readlink(path: str, buf: void*, sz: usize): int
func realpath(path: str, out: void*): void*
func popen(cmd: str, mode: str): void*
func pclose(fp: void*): int
func getpid(): int
end
end
const COPY_CHUNK := 65536
@en "FileInfo"
@fa "اطلاعات پرونده"
pub struct FileInfo:
@en "size"
@fa "اندازه"
pub size: i64 = 0
@en "is_dir"
@fa "پوشه است"
pub is_dir: bool = false
@en "exists"
@fa "هست"
pub exists: bool = false
end
@en "CmdResult"
@fa "نتیجه فرمان"
pub struct CmdResult:
@en "code"
@fa "کد"
pub code: int = 0
@en "out"
@fa "خروجی"
pub out: str = ""
end
if SALAM_OS_WINDOWS:
func _str_to_wide(s: str): void*:
n := MultiByteToWideChar(65001 as u32, 0 as u32, s, 0 - 1, null, 0)
if n <= 0:
ret mem.Allocate(2 as u64)
end
w := mem.Allocate((n * 2) as u64)
MultiByteToWideChar(65001 as u32, 0 as u32, s, 0 - 1, w, n)
ret w
end
func _wide_to_str(w: void*): str:
if w == null: ret "" end
n := WideCharToMultiByte(65001 as u32, 0 as u32, w, 0 - 1, null, 0, null, null)
if n <= 0: ret "" end
buf := mem.Allocate(n as u64)
WideCharToMultiByte(65001 as u32, 0 as u32, w, 0 - 1, buf, n, null, null)
ret buf as str
end
func _wopen_flags(mode: str): int:
O_RDONLY := 0
O_WRONLY := 1
O_APPEND := 8
O_CREAT := 256
O_TRUNC := 512
O_BINARY := 32768
if mode.len() == 0:
ret O_RDONLY | O_BINARY
end
c := mode.substr(0, 1)
if c == "w":
ret O_WRONLY | O_CREAT | O_TRUNC | O_BINARY
end
if c == "a":
ret O_WRONLY | O_CREAT | O_APPEND | O_BINARY
end
ret O_RDONLY | O_BINARY
end
end
func _fopen_compat(path: str, mode: str): void*:
if SALAM_OS_WINDOWS:
S_IREAD_IWRITE := 384
wpath := _str_to_wide(path)
fd := _wopen(wpath, _wopen_flags(mode), S_IREAD_IWRITE)
mem.Free(wpath)
if fd < 0: ret null end
ret _fdopen(fd, mode)
else:
ret fopen(path, mode)
end
end
if SALAM_OS_WINDOWS:
func _proc_open(cmd: str): void*: ret _popen(cmd, "r") end
func _proc_close(fp: void*): int: ret _pclose(fp) end
func _proc_pid(): int: ret _getpid() end
func _proc_status(code: int): int: ret code end
else:
func _proc_open(cmd: str): void*: ret popen(cmd, "r") end
func _proc_close(fp: void*): int: ret pclose(fp) end
func _proc_pid(): int: ret getpid() end
func _proc_status(code: int): int:
if code < 0: ret -1 end
ret (code / 256) % 256
end
end
if SALAM_OS_WINDOWS:
func _os_mkdir(path: str): int:
w := _str_to_wide(path)
r := _wmkdir(w)
mem.Free(w)
if r == 0: ret 0 end
ret 0 - 1
end
func _os_rmdir(path: str): int:
w := _str_to_wide(path)
r := _wrmdir(w)
mem.Free(w)
if r == 0: ret 0 end
ret 0 - 1
end
func _os_chdir(path: str): int:
w := _str_to_wide(path)
r := _wchdir(w)
mem.Free(w)
if r == 0: ret 0 end
ret 0 - 1
end
func _os_cwd(): str:
buf := mem.Allocate((2048 as u64) * (2 as u64))
n := GetCurrentDirectoryW(2048, buf)
mut s := ""
if n > 0 and n < 2048: s = _wide_to_str(buf) end
mem.Free(buf)
ret s
end
func _os_exists(path: str): bool:
w := _str_to_wide(path)
r := GetFileAttributesW(w)
mem.Free(w)
ret r != (0 - 1)
end
func _os_is_dir(path: str): bool:
w := _str_to_wide(path)
attr := GetFileAttributesW(w)
mem.Free(w)
if attr == (0 - 1): ret false end
ret (attr / 16) % 2 == 1
end
func _os_is_link(path: str): bool:
w := _str_to_wide(path)
attr := GetFileAttributesW(w)
mem.Free(w)
if attr == (0 - 1): ret false end
ret (attr / 1024) % 2 == 1
end
func _os_remove_link(path: str): int:
if _os_is_dir(path): ret _os_rmdir(path) end
ret Remove(path)
end
func _os_real_path(path: str): str:
w := _str_to_wide(path)
handle := CreateFileW(w, 0 as u32, 7 as u32, null, 3 as u32, 0x02000000 as u32, null)
mem.Free(w)
if (handle as size) == (0 - 1):
ret str.Clone("")
end
buf := mem.AllocateZeroed(65536 as u64)
got := GetFinalPathNameByHandleW(handle, buf, 32767 as u32, 0 as u32)
CloseHandle(handle)
if got == (0 as u32) or got >= (32767 as u32):
mem.Free(buf)
ret str.Clone("")
end
full := _wide_to_str(buf)
mem.Free(buf)
mut plain := str.Clone(full)
if str.StartsWith(full, "\\\\?\\UNC\\"):
mem.Free(plain as void*)
tail := full.substr(8, full.len() - 8)
plain = "\\\\" + tail
mem.Free(tail as void*)
else str.StartsWith(full, "\\\\?\\"):
mem.Free(plain as void*)
plain = full.substr(4, full.len() - 4)
end
mem.Free(full as void*)
ret plain
end
else:
func _os_mkdir(path: str): int: if mkdir(path, 511) == 0: ret 0 end ret -1 end
func _os_rmdir(path: str): int: if rmdir(path) == 0: ret 0 end ret -1 end
func _os_chdir(path: str): int: if chdir(path) == 0: ret 0 end ret -1 end
func _os_cwd(): str:
buf := mem.Allocate(2048 as u64)
r := getcwd(buf, 2048)
mut s := ""
if r != null: s = str.Clone(r as str) end
mem.Free(buf)
ret s
end
func _os_exists(path: str): bool:
ret access(path, 0) == 0
end
func _os_is_dir(path: str): bool:
d := opendir(path)
if d == null: ret false end
closedir(d)
ret true
end
func _os_is_link(path: str): bool:
buf := mem.Allocate(8 as u64)
n := readlink(path, buf, 8 as usize)
mem.Free(buf)
ret n >= 0
end
func _os_remove_link(path: str): int:
ret Remove(path)
end
func _os_real_path(path: str): str:
raw := realpath(path, null)
if raw == null:
ret str.Clone("")
end
ret raw as str
end
end
@en "Open"
@fa "بازکردن"
pub func Open(path: str, mode: str): File*: ret salam_open(path, mode) end
@en "Exit"
@fa "خروج"
pub noret func Exit(code: int): exit(code) end
@en "Abort"
@fa "توقف ناگهانی"
pub noret func Abort(): abort() end
@en "Args"
@fa "آرگومان ها"
pub func Args(): Vector<str>: ret args() end
@en "Env"
@fa "متغیر محیطی"
pub func Env(name: str): str:
v := getenv(name)
if v == null: ret str.Clone("") end
ret str.Clone(v as str)
end
@en "Remove"
@fa "حذف"
pub func Remove(path: str): int:
if SALAM_OS_WINDOWS:
w := _str_to_wide(path)
r := DeleteFileW(w)
mem.Free(w)
if r != 0: ret 0 end
ret 0 - 1
else:
if remove(path) == 0: ret 0 end
ret 0 - 1
end
end
@en "Mkdir"
@fa "ساخت پوشه"
pub func Mkdir(path: str): int: ret _os_mkdir(path) end
@en "Rmdir"
@fa "حذف پوشه"
pub func Rmdir(path: str): int: ret _os_rmdir(path) end
@en "Copy"
@fa "کپی"
pub func Copy(src: str, dst: str): int:
fin := _fopen_compat(src, "rb")
if fin == null: ret 0 - 1 end
fout := _fopen_compat(dst, "wb")
if fout == null:
_shut := fclose(fin)
ret 0 - 1
end
buf := mem.Allocate(COPY_CHUNK as u64)
if buf == null:
_a := fclose(fin)
_b := fclose(fout)
ret 0 - 1
end
mut failed := false
mut going := true
until going:
got := fread(buf, 1 as u64, COPY_CHUNK as u64, fin)
if got == 0 as u64:
going = false
else:
if fwrite(buf, 1 as u64, got, fout) != got:
failed = true
going = false
end
end
end
mem.Free(buf)
_a := fclose(fin)
if fclose(fout) != 0: failed = true end
if failed: ret 0 - 1 end
ret 0
end
@en "Move"
@fa "جابجایی"
pub func Move(src: str, dst: str): int:
if SALAM_OS_WINDOWS:
wsrc := _str_to_wide(src)
wdst := _str_to_wide(dst)
r := MoveFileExW(wsrc, wdst, 0 as u32)
mem.Free(wsrc)
mem.Free(wdst)
if r != 0: ret 0 end
ret 0 - 1
else:
if rename(src, dst) == 0: ret 0 end
ret 0 - 1
end
end
@en "ListDir"
@fa "فهرست پوشه"
pub func ListDir(path: str): Vector<str>:
count := mem.MustAllocateZeroed(4 as u64)
raw := salam_os_listdir(path, count)
n := (count as i32*)[0]
items := raw as str*
out := Vector {} as Vector<str>
repeat n in i:
out.push(items[i])
end
mem.Free(count)
mem.Free(raw)
ret out
end
@en "IsDir"
@fa "پوشه است"
pub func IsDir(path: str): bool: ret _os_is_dir(path) end
@en "Walk"
@fa "پیمایش"
pub func Walk(root: str): Vector<str>:
files := Vector {} as Vector<str> stack := Vector {} as Vector<str> defer stack.free()
stack.push(root)
until stack.len() > 0:
dir := stack.pop()
entries := ListDir(dir)
repeat entries.len() in i:
name := entries.get(i)
full := filepath.Join(dir, name)
if _os_is_dir(full):
stack.push(full)
else:
files.push(full)
end
end
entries.free()
end
ret files
end
