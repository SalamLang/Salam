@fa "خط"
pub line: int = 0
end
@en "AstSelection"
@fa "گزینش نحوی"
pub struct AstSelection:
@en "kind"
@fa "نوع"
pub kind: int = SEL_FIELD
@en "name"
@fa "نام"
pub name: str = ""
@en "alias"
@fa "نام مستعار"
pub alias: str = ""
@en "typeCondition"
@fa "شرط نوع"
pub typeCondition: str = ""
@en "hasTypeCondition"
@fa "دارای شرط نوع"
pub hasTypeCondition: bool = false
@en "args"
@fa "آرگومان‌ها"
pub args: Vector<AstArgument> = Vector {}
@en "directives"
@fa "دستورالعمل‌ها"
pub directives: Vector<AstDirective> = Vector {}
@en "selections"
@fa "گزینش‌ها"
pub selections: Vector<int> = Vector {}
@en "line"
@fa "خط"
pub line: int = 0
@en "col"
@fa "ستون"
pub col: int = 0
