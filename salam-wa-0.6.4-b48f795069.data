@en "SetNonBlocking"
@fa "تنظیم حالت غیرمسدود"
pub func SetNonBlocking(sock: Socket, enable: bool):
if SALAM_OS_WINDOWS:
mode := mem.Allocate(4 as u64)
defer mem.Free(mode)
m32 := mode as int*
if enable: m32[0] = 1 else:
m32[0] = 0
end
ioctlsocket(_sk(sock.fd), 0 - 2147195266, mode)
else:
mut flags := fcntl(sock.fd as int, 3, 0)
if flags < 0: ret end
mut nb := 2048
if SALAM_OS_MAC or SALAM_OS_BSD:
nb = 4
end
if enable:
flags |= nb
else:
flags &= (0 - nb - 1)
end
fcntl(sock.fd as int, 4, flags)
end
end
@en "SetTimeout"
@fa "تنظیم مهلت زمانی"
pub func SetTimeout(sock: Socket, millis: int):
if SALAM_OS_WINDOWS:
t := mem.Allocate(4 as u64)
defer mem.Free(t)
t32 := t as int*
t32[0] = millis
setsockopt(_sk(sock.fd), 65535, 4102, t, 4)
setsockopt(_sk(sock.fd), 65535, 4101, t, 4)
else:
tv := mem.Allocate(16 as u64)
defer mem.Free(tv)
memset(tv, 0, 16 as u64)
mut tvlen := 16
if sizeof(void*) == 8:
tv64 := tv as i64*
tv64[0] = (millis / 1000) as i64
tv64[1] = ((millis % 1000) * 1000) as i64
else:
tv32 := tv as i32*
tv32[0] = millis / 1000
tv32[1] = (millis % 1000) * 1000
tvlen = 8
end
if SALAM_OS_MAC or SALAM_OS_BSD:
setsockopt(sock.fd as int, 65535, 4102, tv, tvlen)
setsockopt(sock.fd as int, 65535, 4101, tv, tvlen)
else:
setsockopt(sock.fd as int, 1, 20, tv, tvlen)
setsockopt(sock.fd as int, 1, 21, tv, tvlen)
end
end
end
@en "WaitReadable"
@fa "انتظار برای خواندن"
pub func WaitReadable(sock: Socket, timeout_ms: int): bool:
if sock.fd < 0:
ret false
end
if SALAM_OS_WINDOWS:
pw := sizeof(void*) as i64
p := mem.AllocateZeroed(16 as u64)
defer mem.Free(p)
fdp := p as usize*
fdp[0] = sock.fd as usize
evp := ((p as i64) + pw) as i16*
evp[0] = 256 as i16
ret WSAPoll(p, 1 as u32, timeout_ms) > 0
else:
p := mem.AllocateZeroed(8 as u64)
defer mem.Free(p)
fdp := p as i32*
fdp[0] = sock.fd as i32
evp := ((p as i64) + 4) as i16*
evp[0] = 1 as i16
ret poll(p, 1 as usize, timeout_ms) > 0
end
end
@en "WaitReadable2"
@fa "انتظار برای خواندن دو سوکت"
pub func WaitReadable2(a: Socket, b: Socket, timeout_ms: int): int:
if a.fd < 0 or b.fd < 0:
ret 0
end
mut rc := 0
if SALAM_OS_WINDOWS:
pw := sizeof(void*) as i64
stride := (pw + 4 + pw - 1) / pw * pw
p := mem.AllocateZeroed((stride * 2) as u64)
defer mem.Free(p)
((p as i64) as usize*)[0] = a.fd as usize
(((p as i64) + pw) as i16*)[0] = 256 as i16
(((p as i64) + stride) as usize*)[0] = b.fd as usize
(((p as i64) + stride + pw) as i16*)[0] = 256 as i16
rc = WSAPoll(p, 2 as u32, timeout_ms)
if rc <= 0:
ret 0
end
mut out := 0
if ((((p as i64) + pw + 2) as i16*)[0] as int) != 0:
out |= 1
end
if ((((p as i64) + stride + pw + 2) as i16*)[0] as int) != 0:
out |= 2
end
ret out
else:
p := mem.AllocateZeroed(16 as u64)
defer mem.Free(p)
((p as i64) as i32*)[0] = a.fd as i32
(((p as i64) + 4) as i16*)[0] = 1 as i16
(((p as i64) + 8) as i32*)[0] = b.fd as i32
(((p as i64) + 12) as i16*)[0] = 1 as i16
rc = poll(p, 2 as usize, timeout_ms)
if rc <= 0:
ret 0
end
mut out := 0
if ((((p as i64) + 6) as i16*)[0] as int) != 0:
out |= 1
end
if ((((p as i64) + 14) as i16*)[0] as int) != 0:
out |= 2
end
ret out
end
end
@en "SetKeepAlive"
@fa "تنظیم زنده‌نگه‌داری"
pub func SetKeepAlive(sock: Socket, enable: bool):
opt := mem.Allocate(4 as u64)
defer mem.Free(opt)
o32 := opt as int*
if enable: o32[0] = 1 else:
o32[0] = 0
end
if SALAM_OS_WINDOWS:
setsockopt(_sk(sock.fd), 65535, 8, opt, 4)
else SALAM_OS_MAC or SALAM_OS_BSD:
setsockopt(sock.fd as int, 65535, 8, opt, 4)
else:
setsockopt(sock.fd as int, 1, 9, opt, 4)
end
end
@en "SetNoDelay"
@fa "غیرفعال‌سازی نگل"
pub func SetNoDelay(sock: Socket, enable: bool):
opt := mem.Allocate(4 as u64)
defer mem.Free(opt)
o32 := opt as int*
if enable: o32[0] = 1 else:
o32[0] = 0
end
if SALAM_OS_WINDOWS:
setsockopt(_sk(sock.fd), 6, 1, opt, 4)
else:
setsockopt(sock.fd as int, 6, 1, opt, 4)
end
end
@en "SetOpt"
@fa "تنظیم گزینه سوکت"
pub func SetOpt(sock: Socket, level: int, optname: int, ptr: void*, optlen: int): int:
if SALAM_OS_WINDOWS:
ret setsockopt(_sk(sock.fd), level, optname, ptr, optlen)
else:
ret setsockopt(sock.fd as int, level, optname, ptr, optlen)
end
end
@en "SetBroadcast"
@fa "فعال‌سازی پخش"
pub func SetBroadcast(sock: Socket, enable: bool):
opt := mem.Allocate(4 as u64)
defer mem.Free(opt)
o32 := opt as int*
if enable: o32[0] = 1 else:
o32[0] = 0
end
if SALAM_OS_WINDOWS:
setsockopt(_sk(sock.fd), 65535, 32, opt, 4)
else SALAM_OS_MAC or SALAM_OS_BSD:
setsockopt(sock.fd as int, 65535, 32, opt, 4)
else:
setsockopt(sock.fd as int, 1, 6, opt, 4)
end
end
@en "SendToBytes"
@fa "ارسال بایت به"
pub func SendToBytes(sock: Socket, host: str, port: int, ptr: void*, n: int): int:
mut alen := 0
sa := _sockaddr_for(host, port, alen)
if sa == null:
ret 0 - 1
end
defer mem.Free(sa)
mut r := _sendto_raw(sock.fd, ptr, n, sa, alen)
if r < 0 and _sa_family(sa) == AF_INET:
m := _map4(sa, port)
r = _sendto_raw(sock.fd, ptr, n, m, 28)
mem.Free(m)
end
ret r
end
@en "SendTo"
@fa "ارسال به"
pub func SendTo(sock: Socket, host: str, port: int, data: str): int:
ret SendToBytes(sock, host, port, data as void*, data.len())
end
@en "RecvFromBytes"
@fa "دریافت بایت از"
pub func RecvFromBytes(sock: Socket, buf: void*, max: int, out_host &: str, out_port &: int): int:
sa := mem.AllocateZeroed(136 as u64)
defer mem.Free(sa)
salen := mem.Allocate(4 as u64)
defer mem.Free(salen)
(salen as int*)[0] = 128
mut n := 0
if SALAM_OS_WINDOWS:
n = recvfrom(_sk(sock.fd), buf, max, 0, sa, salen)
else:
n = recvfrom(sock.fd as int, buf, max, 0, sa, salen)
end
if n < 0:
out_host = ""
out_port = 0
ret n
end
out_host = _sa_text(sa, out_port)
ret n
end
@en "RecvFrom"
@fa "دریافت از"
pub func RecvFrom(sock: Socket, max: int, out_host &: str, out_port &: int): str:
mut m := max
if m <= 0: m = 65536 end
buf := mem.Allocate((m + 1) as u64)
defer mem.Free(buf)
memset(buf, 0, (m + 1) as u64)
n := RecvFromBytes(sock, buf, m, out_host, out_port)
if n < 0: ret "" end
ret str.Clone(buf as str).substr(0, n)
end
@en "net/mime"
@fa "مایم"
package mime
import mem
import str
import filepath
import crypto
import compress
@en "ContentTypeParam"
@fa "پارامتر نوع محتوا"
pub struct ContentTypeParam:
@en "key"
@fa "کلید"
pub key: str = ""
@en "value"
@fa "مقدار"
pub value: str = ""
end
@en "ContentTypeParams"
@fa "پارامترهای نوع محتوا"
pub struct ContentTypeParams:
@en "items"
@fa "اقلام"
pub items: Vector<ContentTypeParam> = Vector {}
end
@en "ContentType"
@fa "نوع محتوا"
pub struct ContentType:
@en "media_type"
@fa "نوع رسانه"
pub media_type: str = ""
@en "params"
@fa "پارامترها"
pub params: ContentTypeParams = ContentTypeParams {}
end
@en "MultipartHeader"
@fa "سرآیند بخش"
pub struct MultipartHeader:
@en "key"
@fa "کلید"
pub key: str = ""
@en "value"
@fa "مقدار"
pub value: str = ""
end
@en "MultipartHeaders"
@fa "سرآیندهای بخش"
pub struct MultipartHeaders:
@en "items"
@fa "اقلام"
pub items: Vector<MultipartHeader> = Vector {}
end
@en "MultipartPart"
@fa "بخش چندبخشی"
pub struct MultipartPart:
@en "name"
@fa "نام"
pub name: str = ""
@en "filename"
@fa "نام پرونده"
pub filename: str = ""
@en "content_type"
@fa "نوع محتوا"
pub content_type: str = ""
@en "headers"
@fa "سرآیندها"
pub headers: MultipartHeaders = MultipartHeaders {}
@en "body"
@fa "بدنه"
pub body: compress.ByteBuf = compress.ByteBuf {}
end
@en "MultipartParts"
@fa "بخش‌های چندبخشی"
pub struct MultipartParts:
@en "items"
@fa "اقلام"
pub items: Vector<MultipartPart> = Vector {}
end
@en "MultipartWriter"
@fa "نویسنده چندبخشی"
pub struct MultipartWriter:
@en "boundary"
@fa "مرز"
pub boundary: str = ""
@en "buf"
@fa "بافر"
pub buf: compress.ByteBuf = compress.ByteBuf {}
@en "closed"
@fa "بسته"
pub closed: bool = false
end
func _wbytes(b &: compress.ByteBuf, s: str):
compress.BufPushBytes(b, s as void*, s.len())
end
func _bytes_to_str(p: void*, n: int): str:
buf := mem.Allocate((n + 1) as u64)
defer mem.Free(buf)
mem.Copy(buf, p, n as u64)
bufp := buf as i8*
bufp[n] = 0 as i8
ret str.Clone(buf as str)
end
func _mem_find(hay: void*, hay_len: int, needle: void*, needle_len: int, start: int): int:
if needle_len == 0: ret start end
if needle_len > hay_len: ret 0 - 1 end
hp := hay as i64
np := needle as i64
limit := hay_len - needle_len
mut i := start
until i <= limit:
mut j := 0
mut matched := true
until j < needle_len:
hb := ((hp + i + j) as i8*)[0]
nb := ((np + j) as i8*)[0]
if hb != nb:
matched = false
j = needle_len
else:
j++
end
end
if matched: ret i end
i++
end
ret 0 - 1
end
func _ltrim(s: str): str:
mut a := 0
n := s.len()
until a < n:
c := s.substr(a, 1)
if c == " " or c == "\t":
a++
else:
ret s.substr(a, n - a)
end
end
ret ""
end
func _rtrim(s: str): str:
mut b := s.len()
until b > 0:
c := s.substr(b - 1, 1)
if c == " " or c == "\t" or c == "\r" or c == "\n":
b--
else:
ret s.substr(0, b)
end
end
ret ""
end
func _strip(s: str): str:
ret _rtrim(_ltrim(s))
end
func _unquote(s: str): str:
if s.len() >= 2 and s.starts_with("\"") and s.ends_with("\""):
ret s.substr(1, s.len() - 2)
end
ret s
end
func _header_value(headers: MultipartHeaders, key: str): str:
n := headers.items.len()
mut i := 0
until i < n:
h := headers.items.get(i)
if h.key == key:
ret h.value
end
i++
end
ret ""
end
func _cd_quoted_param(cd: str, key: str): str:
needle := key + "=\""
idx := cd.find(needle)
if idx < 0: ret "" end
start := idx + needle.len()
rest := cd.substr(start, cd.len() - start)
close := rest.find("\"")
if close < 0: ret "" end
ret rest.substr(0, close)
end
func _write_part_header(w &: MultipartWriter, disposition: str, content_type: str):
_wbytes(w.buf, "--" + w.boundary + "\r\n")
_wbytes(w.buf, "Content-Disposition: " + disposition + "\r\n")
if content_type.len() > 0:
_wbytes(w.buf, "Content-Type: " + content_type + "\r\n")
end
_wbytes(w.buf, "\r\n")
end
@en "MimeExt"
@fa "پسوند مایم"
pub func MimeExt(ext: str): str:
if ext == "html" or ext == "htm": ret "text/html; charset=utf-8"
else ext == "css": ret "text/css"
else ext == "js" or ext == "mjs": ret "application/javascript"
else ext == "json": ret "application/json"
else ext == "png": ret "image/png"
else ext == "jpg" or ext == "jpeg": ret "image/jpeg"
else ext == "gif": ret "image/gif"
else ext == "svg": ret "image/svg+xml"
else ext == "ico": ret "image/x-icon"
else ext == "webp": ret "image/webp"
else ext == "txt": ret "text/plain; charset=utf-8"
else ext == "md": ret "text/markdown; charset=utf-8"
else ext == "pdf": ret "application/pdf"
else ext == "xml": ret "application/xml"
else ext == "wasm": ret "application/wasm"
else ext == "map": ret "application/json"
else ext == "zip": ret "application/zip"
else ext == "mp4": ret "video/mp4"
else ext == "webm": ret "video/webm"
else ext == "mp3": ret "audio/mpeg"
else ext == "wav": ret "audio/wav"
else ext == "woff": ret "font/woff"
else ext == "woff2": ret "font/woff2"
else:
ret "application/octet-stream"
end
end
@en "MimeType"
@fa "رده مایم"
pub func MimeType(p: str): str:
e := filepath.Ext(p)
if e.len() == 0:
mem.Free(e as void*)
ret "application/octet-stream"
end
bare := e.substr(1, e.len() - 1)
out := MimeExt(bare)
mem.Free(bare as void*)
mem.Free(e as void*)
ret out
end
@en "StatusText"
@fa "متن وضعیت"
pub func StatusText(code: int): str:
if code == 100: ret "Continue"
else code == 101: ret "Switching Protocols"
else code == 102: ret "Processing"
else code == 103: ret "Early Hints"
else code == 200: ret "OK"
else code == 201: ret "Created"
else code == 202: ret "Accepted"
else code == 203: ret "Non-Authoritative Information"
else code == 204: ret "No Content"
else code == 205: ret "Reset Content"
else code == 206: ret "Partial Content"
else code == 207: ret "Multi-Status"
else code == 208: ret "Already Reported"
else code == 226: ret "IM Used"
else code == 300: ret "Multiple Choices"
else code == 301: ret "Moved Permanently"
else code == 302: ret "Found"
else code == 303: ret "See Other"
else code == 304: ret "Not Modified"
else code == 305: ret "Use Proxy"
else code == 307: ret "Temporary Redirect"
else code == 308: ret "Permanent Redirect"
else code == 400: ret "Bad Request"
else code == 401: ret "Unauthorized"
else code == 402: ret "Payment Required"
else code == 403: ret "Forbidden"
else code == 404: ret "Not Found"
else code == 405: ret "Method Not Allowed"
else code == 406: ret "Not Acceptable"
else code == 407: ret "Proxy Authentication Required"
else code == 408: ret "Request Timeout"
else code == 409: ret "Conflict"
else code == 410: ret "Gone"
else code == 411: ret "Length Required"
else code == 412: ret "Precondition Failed"
else code == 413: ret "Content Too Large"
else code == 414: ret "URI Too Long"
else code == 415: ret "Unsupported Media Type"
else code == 416: ret "Range Not Satisfiable"
else code == 417: ret "Expectation Failed"
else code == 418: ret "I'm a teapot"
else code == 421: ret "Misdirected Request"
else code == 422: ret "Unprocessable Entity"
else code == 423: ret "Locked"
else code == 424: ret "Failed Dependency"
else code == 425: ret "Too Early"
else code == 426: ret "Upgrade Required"
else code == 428: ret "Precondition Required"
else code == 429: ret "Too Many Requests"
else code == 431: ret "Request Header Fields Too Large"
else code == 451: ret "Unavailable For Legal Reasons"
else code == 500: ret "Internal Server Error"
else code == 501: ret "Not Implemented"
else code == 502: ret "Bad Gateway"
else code == 503: ret "Service Unavailable"
else code == 504: ret "Gateway Timeout"
else code == 505: ret "HTTP Version Not Supported"
else code == 506: ret "Variant Also Negotiates"
else code == 507: ret "Insufficient Storage"
else code == 508: ret "Loop Detected"
else code == 510: ret "Not Extended"
else code == 511: ret "Network Authentication Required"
else:
ret "Unknown"
end
end
@en "ParseContentType"
@fa "تجزیه نوع محتوا"
pub func ParseContentType(header: str): ContentType:
mut out := ContentType {}
parts := str.Split(header, ";")
if parts.len() == 0: ret out end
out.media_type = _strip(parts.get(0))
mut i := 1
until i < parts.len():
piece := _strip(parts.get(i))
eq_at := piece.find("=")
if eq_at >= 0:
k := _strip(piece.substr(0, eq_at))
v := _unquote(_strip(piece.substr(eq_at + 1, piece.len() - eq_at - 1)))
out.params.items.push(ContentTypeParam { key = k, value = v })
end
i++
end
ret out
end
@en "ParamGet"
@fa "دریافت پارامتر"
pub func ParamGet(ct: ContentType, key: str): str:
n := ct.params.items.len()
mut i := 0
until i < n:
p := ct.params.items.get(i)
if p.key == key:
ret p.value
end
i++
end
ret ""
end
@en "ParseMultipart"
@fa "تجزیه چندبخشی"
pub func ParseMultipart(data: void*, n: int, boundary: str): MultipartParts:
mut out := MultipartParts {}
delim := "--" + boundary
dbytes := delim as void*
dlen := delim.len()
mut pos := _mem_find(data, n, dbytes, dlen, 0)
if pos < 0: ret out end
pos += dlen
mut done := false
until not done:
if pos + 1 < n:
b0 := ((data as i64 + pos) as i8*)[0]
b1 := ((data as i64 + pos + 1) as i8*)[0]
if b0 == 45 and b1 == 45:
done = true
continue
end
end
crlf := _mem_find(data, n, "\r\n" as void*, 2, pos)
if crlf < 0:
done = true
continue
end
header_start := crlf + 2
sep := _mem_find(data, n, "\r\n\r\n" as void*, 4, header_start)
if sep < 0:
done = true
continue
end
next_boundary := _mem_find(data, n, dbytes, dlen, header_start)
if next_boundary < 0:
done = true
continue
end
header_text := _bytes_to_str((data as i64 + header_start) as void*, sep - header_start)
mut part := MultipartPart {}
lines := str.Split(header_text, "\r\n")
mut li := 0
until li < lines.len():
line := lines.get(li)
colon := line.find(":")
if colon >= 0:
hk := _strip(line.substr(0, colon))
hv := _strip(line.substr(colon + 1, line.len() - colon - 1))
part.headers.items.push(MultipartHeader { key = hk, value = hv })
end
li++
end
cd := _header_value(part.headers, "Content-Disposition")
part.name = _cd_quoted_param(cd, "name")
part.filename = _cd_quoted_param(cd, "filename")
part.content_type = _header_value(part.headers, "Content-Type")
body_start := sep + 4
mut body_end := next_boundary
if body_end - 2 >= body_start:
body_end -= 2
end
blen := body_end - body_start
if blen > 0:
src := (data as i64 + body_start) as void*
compress.BufPushBytes(part.body, src, blen)
end
out.items.push(part)
pos = next_boundary + dlen
end
ret out
end
@en "PartIndex"
@fa "اندیس بخش"
pub func PartIndex(parts: MultipartParts, name: str): int:
n := parts.items.len()
mut i := 0
until i < n:
if parts.items.get(i).name == name: ret i end
i++
end
ret 0 - 1
end
@en "PartValue"
@fa "مقدار بخش"
pub func PartValue(parts: MultipartParts, name: str): str:
i := PartIndex(parts, name)
if i < 0: ret "" end
b := parts.items.get(i).body
if b.len == 0: ret "" end
ret _bytes_to_str(b.data, b.len)
end
@en "FreeMultipart"
@fa "آزادسازی چندبخشی"
pub func FreeMultipart(parts &: MultipartParts):
n := parts.items.len()
mut i := 0
until i < n:
mut part := parts.items.get(i)
compress.BufFree(part.body)
i++
end
parts.items.free()
end
@en "NewMultipartWriter"
@fa "نویسنده چندبخشی جدید"
pub func NewMultipartWriter(): MultipartWriter:
mut w := MultipartWriter {}
w.boundary = "SalamBoundary" + crypto.RandomHex(16)
w.buf = compress.NewByteBuf()
w.closed = false
ret w
end
@en "ContentTypeHeader"
@fa "سرآیند نوع محتوا"
pub func ContentTypeHeader(w: MultipartWriter): str:
ret "multipart/form-data; boundary=" + w.boundary
end
@en "WriteField"
@fa "نوشتن فیلد"
pub func WriteField(w &: MultipartWriter, name: str, value: str):
_write_part_header(w, "form-data; name=\"" + name + "\"", "")
_wbytes(w.buf, value)
_wbytes(w.buf, "\r\n")
end
@en "WriteFileBytes"
@fa "نوشتن پرونده"
pub func WriteFileBytes(w &: MultipartWriter, name: str, filename: str, content_type: str, data: void*, n: int):
mut ct := content_type
if ct.len() == 0: ct = MimeType(filename) end
_write_part_header(w, "form-data; name=\"" + name + "\"; filename=\"" + filename + "\"", ct)
compress.BufPushBytes(w.buf, data, n)
_wbytes(w.buf, "\r\n")
end
@en "WriteFileStr"
@fa "نوشتن پرونده متنی"
pub func WriteFileStr(w &: MultipartWriter, name: str, filename: str, content_type: str, data: str):
WriteFileBytes(w, name, filename, content_type, data as void*, data.len())
end
@en "CloseWriter"
@fa "بستن نویسنده"
pub func CloseWriter(w &: MultipartWriter): compress.ByteBuf:
if not w.closed:
_wbytes(w.buf, "--" + w.boundary + "--\r\n")
w.closed = true
end
ret w.buf
end
package nats
import conv
import str
import encoding
import encoding.json
const JS_API := "$JS.API."
@en "JSResult"
@fa "نتیجه جت‌استریم"
pub struct JSResult:
@en "ok"
@fa "سالم"
pub ok: bool = false
@en "err"
@fa "خطا"
pub err: str = ""
@en "code"
@fa "کد"
pub code: int = 0
@en "raw"
@fa "خام"
pub raw: str = ""
end
@en "StreamState"
@fa "وضعیت جریان"
pub struct StreamState:
@en "ok"
@fa "سالم"
pub ok: bool = false
@en "err"
@fa "خطا"
pub err: str = ""
@en "name"
@fa "نام"
pub name: str = ""
@en "messages"
@fa "پیام ها"
pub messages: int = 0
@en "bytes"
@fa "بایت ها"
pub bytes: int = 0
@en "first_seq"
@fa "نخستین شماره"
pub first_seq: int = 0
@en "last_seq"
@fa "واپسین شماره"
pub last_seq: int = 0
@en "consumers"
@fa "مصرف‌کننده ها"
pub consumers: int = 0
end
@en "PubAck"
@fa "تاییدیه انتشار"
pub struct PubAck:
@en "ok"
@fa "سالم"
pub ok: bool = false
@en "err"
@fa "خطا"
pub err: str = ""
@en "stream"
@fa "جریان"
pub stream: str = ""
@en "seq"
@fa "شماره"
pub seq: int = 0
@en "duplicate"
@fa "تکراری"
pub duplicate: bool = false
end
@en "Batch"
@fa "دسته"
pub struct Batch:
@en "msgs"
@fa "پیام ها"
pub msgs: Vector<Msg> = Vector {} as Vector<Msg>
@en "err"
@fa "خطا"
pub err: str = ""
end
@en "KVEntry"
@fa "ورودی کی‌وی"
pub struct KVEntry:
@en "ok"
@fa "سالم"
pub ok: bool = false
@en "found"
@fa "یافت شد"
pub found: bool = false
@en "deleted"
@fa "حذف شده"
pub deleted: bool = false
@en "key"
@fa "کلید"
pub key: str = ""
@en "value"
@fa "مقدار"
pub value: str = ""
@en "revision"
@fa "ویرایش"
pub revision: int = 0
@en "err"
@fa "خطا"
pub err: str = ""
end
func _unquote(v: str): str:
if v.len() >= 2 and v.starts_with("\"") and v.ends_with("\""):
ret v.substr(1, v.len() - 2)
end
ret v
end
func _js_result(m: Msg): JSResult:
mut r := JSResult {}
if not m.ok:
r.err = m.err
ret r
end
r.raw = m.data
e := json.Get(m.data, "error")
if e.len() > 0:
r.code = json.GetInt(e, "err_code")
r.err = _unquote(json.Get(e, "description"))
if r.err.len() == 0:
r.err = e
end
ret r
end
r.ok = true
ret r
end
func _unb64(v: str): str:
mut out := ""
try:
out = encoding.Base64Decode(v)
catch:
out = ""
end
ret out
end
func _str_array(items: Vector<str>): str:
mut out := "["
repeat items.len() in i:
if i > 0:
out += ","
end
out += json.Str(items.get(i))
end
ret out + "]"
end
@en "JSRequest"
@fa "درخواست جت‌استریم"
pub func JSRequest(nc &: Conn, api: str, body: str, timeout_ms: int): JSResult:
ret _js_result(Request(nc, JS_API + api, body, timeout_ms))
end
@en "AddStream"
@fa "افزودن جریان"
pub func AddStream(nc &: Conn, name: str, subjects: Vector<str>, timeout_ms: int): JSResult:
body := "{" + json.Member("name", name) + `,"subjects":` + _str_array(subjects) + `,"storage":"file","retention":"limits"}`
ret JSRequest(nc, "STREAM.CREATE." + name, body, timeout_ms)
end
@en "DeleteStream"
@fa "حذف جریان"
pub func DeleteStream(nc &: Conn, name: str, timeout_ms: int): JSResult:
ret JSRequest(nc, "STREAM.DELETE." + name, "", timeout_ms)
end
@en "PurgeStream"
@fa "پاکسازی جریان"
pub func PurgeStream(nc &: Conn, name: str, timeout_ms: int): JSResult:
ret JSRequest(nc, "STREAM.PURGE." + name, "", timeout_ms)
end
@en "StreamInfo"
@fa "اطلاعات جریان"
pub func StreamInfo(nc &: Conn, name: str, timeout_ms: int): StreamState:
mut s := StreamState {}
r := JSRequest(nc, "STREAM.INFO." + name, "", timeout_ms)
if not r.ok:
s.err = r.err
ret s
end
st := json.Get(r.raw, "state")
s.ok = true
s.name = name
s.messages = json.GetInt(st, "messages")
s.bytes = json.GetInt(st, "bytes")
s.first_seq = json.GetInt(st, "first_seq")
s.last_seq = json.GetInt(st, "last_seq")
s.consumers = json.GetInt(st, "consumer_count")
ret s
end
@en "JSPublish"
@fa "انتشار جت‌استریم"
pub func JSPublish(nc &: Conn, subject: str, data: str, timeout_ms: int): PubAck:
ret JSPublishHeaders(nc, subject, Header {}, data, timeout_ms)
end
@en "JSPublishHeaders"
@fa "انتشار جت‌استریم با سرآیند"
pub func JSPublishHeaders(nc &: Conn, subject: str, h: Header, data: str, timeout_ms: int): PubAck:
mut a := PubAck {}
r := _js_result(RequestMsg(nc, subject, h, data, timeout_ms))
if not r.ok:
a.err = r.err
ret a
end
a.ok = true
a.stream = _unquote(json.Get(r.raw, "stream"))
a.seq = json.GetInt(r.raw, "seq")
a.duplicate = json.Get(r.raw, "duplicate") == "true"
ret a
end
@en "AddConsumer"
@fa "افزودن مصرف‌کننده"
pub func AddConsumer(nc &: Conn, stream: str, durable: str, filter: str, timeout_ms: int): JSResult:
mut cfg := "{" + json.Member("durable_name", durable) + `,"ack_policy":"explicit"`
if filter.len() > 0:
cfg += "," + json.Member("filter_subject", filter)
end
cfg += "}"
body := "{" + json.Member("stream_name", stream) + `,"config":` + cfg + "}"
ret JSRequest(nc, "CONSUMER.DURABLE.CREATE." + stream + "." + durable, body, timeout_ms)
end
@en "DeleteConsumer"
@fa "حذف مصرف‌کننده"
pub func DeleteConsumer(nc &: Conn, stream: str, durable: str, timeout_ms: int): JSResult:
ret JSRequest(nc, "CONSUMER.DELETE." + stream + "." + durable, "", timeout_ms)
end
@en "Fetch"
@fa "واکشی"
pub func Fetch(nc &: Conn, stream: str, durable: str, batch: int, timeout_ms: int): Batch:
mut out := Batch {}
inbox := NewInbox(nc)
s := Subscribe(nc, inbox)
if not s.ok:
out.err = nc.err
ret out
end
body := "{" + json.MemberInt("batch", batch as i64) + "," + json.MemberInt("expires", (timeout_ms as i64) * 900000 as i64) + "}"
subject := JS_API + "CONSUMER.MSG.NEXT." + stream + "." + durable
if not PublishRequest(nc, subject, inbox, body):
out.err = nc.err
Unsubscribe(nc, s)
ret out
end
until out.msgs.len() < batch:
m := NextMsg(nc, s, timeout_ms)
if not m.ok:
if out.msgs.len() == 0:
out.err = m.err
end
break
end
if m.status == 404 or m.status == 408 or m.status == 409:
if out.msgs.len() == 0:
out.err = m.status_text.len() > 0 ? m.status_text : conv.FormatInt(m.status as i64)
end
break
end
if m.status == STATUS_IDLE_HEARTBEAT:
continue
end
out.msgs.push(m)
end
Unsubscribe(nc, s)
ret out
end
@en "Ack"
@fa "تایید"
pub func Ack(nc &: Conn, m: Msg): bool:
ret Respond(nc, m, "+ACK")
end
@en "Nak"
@fa "رد"
pub func Nak(nc &: Conn, m: Msg): bool:
ret Respond(nc, m, "-NAK")
end
@en "Term"
@fa "خاتمه"
pub func Term(nc &: Conn, m: Msg): bool:
ret Respond(nc, m, "+TERM")
end
@en "InProgress"
@fa "ادامه کار"
pub func InProgress(nc &: Conn, m: Msg): bool:
ret Respond(nc, m, "+WPI")
end
@en "MsgSequence"
@fa "شماره پیام جریان"
pub func MsgSequence(m: Msg): int:
parts := m.reply.split(".")
defer parts.free()
if parts.len() >= 9:
ret parts.get(5).to_int()
end
ret 0
end
@en "AddPushConsumer"
@fa "افزودن مصرف‌کننده فشاری"
pub func AddPushConsumer(nc &: Conn, stream: str, durable: str, filter: str, deliver: str, queue: str, timeout_ms: int): JSResult:
mut cfg := "{" + json.Member("durable_name", durable) + "," + json.Member("deliver_subject", deliver) + `,"ack_policy":"explicit"`
if filter.len() > 0:
cfg += "," + json.Member("filter_subject", filter)
end
if queue.len() > 0:
cfg += "," + json.Member("deliver_group", queue)
else:
cfg += `,"flow_control":true,"idle_heartbeat":5000000000`
end
cfg += "}"
body := "{" + json.Member("stream_name", stream) + `,"config":` + cfg + "}"
ret JSRequest(nc, "CONSUMER.DURABLE.CREATE." + stream + "." + durable, body, timeout_ms)
end
@en "NextPush"
@fa "پیام فشاری بعدی"
pub func NextPush(nc &: Conn, s: Subscription, timeout_ms: int): Msg:
deadline := _now() + timeout_ms as i64
until true:
left := deadline - _now()
if left <= 0:
break
end
m := NextMsg(nc, s, left as int)
if not m.ok:
ret m
end
if m.status == STATUS_IDLE_HEARTBEAT:
if m.reply.len() > 0:
Respond(nc, m, "")
end
continue
end
ret m
end
mut t := Msg {}
t.err = "timeout"
ret t
end
@en "KVCreate"
@fa "ساخت سطل کی‌وی"
pub func KVCreate(nc &: Conn, bucket: str, history: int, timeout_ms: int): JSResult:
keep := history > 0 ? history : 1
mut subjects := Vector {} as Vector<str>
defer subjects.free()
subjects.push("$KV." + bucket + ".>")
body := "{" + json.Member("name", "KV_" + bucket) + `,"subjects":` + _str_array(subjects) + `,"max_msgs_per_subject":` + conv.FormatInt(keep as i64) + `,"discard":"new","allow_rollup_hdr":true,"deny_delete":true,"allow_direct":true,"storage":"file","retention":"limits"}`
ret JSRequest(nc, "STREAM.CREATE.KV_" + bucket, body, timeout_ms)
end
@en "KVDeleteBucket"
@fa "حذف سطل کی‌وی"
pub func KVDeleteBucket(nc &: Conn, bucket: str, timeout_ms: int): JSResult:
ret DeleteStream(nc, "KV_" + bucket, timeout_ms)
end
@en "KVPut"
@fa "نوشتن کی‌وی"
pub func KVPut(nc &: Conn, bucket: str, key: str, value: str, timeout_ms: int): PubAck:
subject := "$KV." + bucket + "." + key
if not ValidSubject(subject):
mut bad := PubAck {}
bad.err = "invalid key"
ret bad
end
ret JSPublish(nc, subject, value, timeout_ms)
end
@en "KVGet"
@fa "خواندن کی‌وی"
pub func KVGet(nc &: Conn, bucket: str, key: str, timeout_ms: int): KVEntry:
mut e := KVEntry {}
e.key = key
subject := "$KV." + bucket + "." + key
if not ValidSubject(subject):
e.err = "invalid key"
ret e
end
r := JSRequest(nc, "STREAM.MSG.GET.KV_" + bucket, "{" + json.Member("last_by_subj", subject) + "}", timeout_ms)
if not r.ok:
e.err = r.code == 10037 ? "key not found" : r.err
e.ok = r.code == 10037
ret e
end
msg := json.Get(r.raw, "message")
hdrs := _unb64(_unquote(json.Get(msg, "hdrs")))
e.ok = true
e.revision = json.GetInt(msg, "seq")
if hdrs.find("KV-Operation: DEL") >= 0 or hdrs.find("KV-Operation: PURGE") >= 0:
e.deleted = true
e.err = "key not found"
ret e
end
e.found = true
e.value = _unb64(_unquote(json.Get(msg, "data")))
ret e
end
@en "KVDelete"
@fa "حذف کی‌وی"
pub func KVDelete(nc &: Conn, bucket: str, key: str, timeout_ms: int): PubAck:
subject := "$KV." + bucket + "." + key
if not ValidSubject(subject):
mut bad := PubAck {}
bad.err = "invalid key"
ret bad
end
mut h := NewHeader()
HeaderAdd(h, "KV-Operation", "DEL")
ret JSPublishHeaders(nc, subject, h, "", timeout_ms)
end
@en "net/nats"
@fa "نتس"
package nats
import net.tcp
import net.internal.rawsock
import tls
import str
import conv
import rand
import sync
import encoding.json
const VERSION := "0.1.0"
const DEFAULT_PORT := 4222
const STATUS_NO_RESPONDERS := 503
const STATUS_IDLE_HEARTBEAT := 100
const KIND_QUEUE := 0
const KIND_HANDLER := 1
const KIND_REPLIER := 2
@en "Header"
@fa "سرآیند"
pub struct Header:
@en "keys"
@fa "کلیدها"
pub keys: Vector<str> = Vector {} as Vector<str>
@en "values"
@fa "مقدارها"
pub values: Vector<str> = Vector {} as Vector<str>
end
@en "Msg"
@fa "پیام"
pub struct Msg:
@en "ok"
@fa "سالم"
pub ok: bool = false
@en "err"
@fa "خطا"
pub err: str = ""
@en "subject"
@fa "موضوع"
pub subject: str = ""
@en "reply"
@fa "پاسخ به"
pub reply: str = ""
@en "data"
@fa "داده"
pub data: str = ""
@en "header"
@fa "سرآیند"
pub header: Header = Header {}
@en "sid"
@fa "شناسه اشتراک"
pub sid: int = 0
@en "status"
@fa "وضعیت"
pub status: int = 0
@en "status_text"
@fa "متن وضعیت"
pub status_text: str = ""
end
@en "Subscription"
@fa "نشانگر اشتراک"
pub struct Subscription:
@en "ok"
@fa "سالم"
pub ok: bool = false
@en "sid"
@fa "شناسه"
pub sid: int = 0
@en "subject"
@fa "موضوع"
pub subject: str = ""
@en "queue"
@fa "صف"
pub queue: str = ""
end
@en "ServerInfo"
@fa "اطلاعات کارگزار"
pub struct ServerInfo:
@en "server_id"
@fa "شناسه کارگزار"
pub server_id: str = ""
@en "server_name"
@fa "نام کارگزار"
pub server_name: str = ""
@en "version"
@fa "نگارش"
pub version: str = ""
@en "host"
@fa "میزبان"
pub host: str = ""
@en "port"
@fa "درگاه"
pub port: int = 0
@en "proto"
@fa "پروتکل"
pub proto: int = 0
@en "client_id"
@fa "شناسه کارخواه"
pub client_id: int = 0
@en "max_payload"
@fa "بیشینه اندازه بار"
pub max_payload: int = 1048576
@en "headers"
@fa "سرآیند پشتیبانی"
pub headers: bool = false
@en "tls_required"
@fa "تی‌ال‌اس لازم"
pub tls_required: bool = false
@en "auth_required"
@fa "احراز هویت لازم"
pub auth_required: bool = false
@en "jetstream"
@fa "جت‌استریم"
pub jetstream: bool = false
@en "raw"
@fa "خام"
pub raw: str = ""
end
@en "Options"
@fa "گزینه ها"
pub struct Options:
@en "name"
@fa "نام"
pub name: str = ""
@en "user"
@fa "کاربر"
pub user: str = ""
@en "password"
@fa "گذرواژه"
pub password: str = ""
@en "token"
@fa "توکن"
pub token: str = ""
@en "no_echo"
@fa "بدون پژواک"
pub no_echo: bool = false
@en "verbose"
@fa "پرگو"
pub verbose: bool = false
@en "pedantic"
@fa "سختگیر"
pub pedantic: bool = false
@en "secure"
@fa "امن"
pub secure: bool = false
@en "insecure_skip_verify"
@fa "بدون راستی آزمایی"
pub insecure_skip_verify: bool = false
@en "timeout_ms"
@fa "مهلت میلی‌ثانیه"
pub timeout_ms: int = 5000
@en "ping_interval_ms"
@fa "فاصله پینگ میلی‌ثانیه"
pub ping_interval_ms: int = 120000
@en "max_pings_out"
@fa "بیشینه پینگ بی‌پاسخ"
pub max_pings_out: int = 2
@en "inbox_prefix"
@fa "پیشوند صندوق"
pub inbox_prefix: str = "_INBOX"
@en "servers"
@fa "کارگزارها"
pub servers: Vector<str> = Vector {} as Vector<str>
@en "max_reconnects"
@fa "بیشینه اتصال دوباره"
pub max_reconnects: int = 0
@en "reconnect_wait_ms"
@fa "انتظار اتصال دوباره میلی‌ثانیه"
pub reconnect_wait_ms: int = 2000
@en "reconnect_buffer"
@fa "بافر اتصال دوباره"
pub reconnect_buffer: int = 8388608
end
@en "Stats"
@fa "آمار"
pub struct Stats:
@en "in_msgs"
@fa "پیام ورودی"
pub in_msgs: i64 = 0
@en "out_msgs"
@fa "پیام خروجی"
pub out_msgs: i64 = 0
@en "in_bytes"
@fa "بایت ورودی"
pub in_bytes: i64 = 0
@en "out_bytes"
@fa "بایت خروجی"
pub out_bytes: i64 = 0
end
@en "Conn"
@fa "اتصال نتس"
pub struct Conn:
@en "ok"
@fa "سالم"
pub ok: bool = false
@en "closed"
@fa "قطع شده"
pub closed: bool = false
@en "draining"
@fa "تخلیه شدن"
pub draining: bool = false
@en "err"
@fa "خطا"
pub err: str = ""
@en "url"
@fa "نشانی"
pub url: str = ""
@en "info"
@fa "اطلاعات"
pub info: ServerInfo = ServerInfo {}
@en "opts"
@fa "گزینه ها"
pub opts: Options = Options {}
@en "stats"
@fa "آمار"
pub stats: Stats = Stats {}
pub _plain: tcp.Conn = tcp.Conn {}
pub _tc: tls.Conn = tls.Conn {}
pub _secure: bool = false
pub _buf: str = ""
pub _pos: int = 0
pub _next_sid: int = 1
pub _pings_sent: int = 0
pub _pongs_recv: int = 0
pub _last_activity: i64 = 0
pub _sub_sid: Vector<int> = Vector {} as Vector<int>
pub _sub_subject: Vector<str> = Vector {} as Vector<str>
pub _sub_queue: Vector<str> = Vector {} as Vector<str>
pub _sub_kind: Vector<int> = Vector {} as Vector<int>
pub _sub_max: Vector<int> = Vector {} as Vector<int>
pub _sub_count: Vector<int> = Vector {} as Vector<int>
pub _sub_slot: Vector<int> = Vector {} as Vector<int>
pub _handlers: Vector<func (Msg)> = Vector {} as Vector<func (Msg)>
pub _repliers: Vector<func (Msg) str> = Vector {} as Vector<func (Msg) str>
pub _inbox: Vector<Msg> = Vector {} as Vector<Msg>
pub _pool: Vector<str> = Vector {} as Vector<str>
pub _sockopen: bool = false
pub _opening: bool = false
pub _reconnecting: bool = false
pub _reconnects: int = 0
pub _attempts: int = 0
pub _last_attempt: i64 = 0
pub _srv_idx: int = 0
pub _pending: str = ""
end
func _now(): i64:
ret sync.NowMs()
end
func _close_sock(nc &: Conn):
if not nc._sockopen:
ret
end
nc._sockopen = false
if nc._secure:
tls.Close(nc._tc)
else:
tcp.Close(nc._plain)
end
nc._secure = false
end
func _shutdown(nc &: Conn):
if nc.closed:
ret
end
nc.closed = true
nc.ok = false
nc._reconnecting = false
nc._pending = ""
_close_sock(nc)
end
func _lost(nc &: Conn):
if nc._opening:
nc.ok = false
_close_sock(nc)
ret
end
if nc.closed or nc._reconnecting:
ret
end
if nc.draining or nc.opts.max_reconnects == 0:
_shutdown(nc)
ret
end
_close_sock(nc)
nc.ok = false
nc._reconnecting = true
nc._attempts = 0
nc._last_attempt = 0
nc._buf = ""
nc._pos = 0
end
func _write(nc &: Conn, data: str): bool:
if nc.closed:
nc.err = "connection closed"
ret false
end
if (nc._reconnecting and not nc._opening) or not nc._sockopen:
nc.err = "reconnecting"
ret false
end
mut n := 0
if nc._secure:
n = tls.Write(nc._tc, data)
else:
n = tcp.Write(nc._plain, data)
end
if n < data.len():
nc.err = "write failed"
_lost(nc)
ret false
end
nc._last_activity = _now()
ret true
end
func _write_pub(nc &: Conn, frame: str): bool:
if not nc._reconnecting:
if _write(nc, frame):
ret true
end
if not nc._reconnecting:
ret false
end
end
if nc._pending.len() + frame.len() > nc.opts.reconnect_buffer:
nc.err = "reconnect buffer full"
ret false
end
nc._pending += frame
ret true
end
func _fill(nc &: Conn, timeout_ms: int): int:
if nc.closed or (nc._reconnecting and not nc._opening) or not nc._sockopen:
ret 0 - 1
end
mut chunk := ""
if nc._secure:
if not tls.Readable(nc._tc):
if not rawsock.WaitReadable(rawsock.FromFd(tls.Fd(nc._tc)), timeout_ms):
ret 0
end
end
chunk = tls.Read(nc._tc, 65536)
else:
if not rawsock.WaitReadable(rawsock.FromFd(nc._plain.fd), timeout_ms):
ret 0
end
chunk = tcp.Read(nc._plain, 65536)
end
if chunk.len() == 0:
if nc.err.len() == 0:
nc.err = "connection lost"
end
_lost(nc)
ret 0 - 1
end
nc._buf += chunk
nc._last_activity = _now()
ret chunk.len()
end
func _find_sub(nc: Conn, sid: int): int:
repeat nc._sub_sid.len() in i:
if nc._sub_sid.get(i) == sid:
ret i
end
end
ret 0 - 1
end
func _tombstone(nc &: Conn, idx: int):
nc._sub_sid.set(idx, 0 - nc._sub_sid.get(idx))
end
func _deliver(nc &: Conn, m: Msg):
idx := _find_sub(nc, m.sid)
if idx < 0:
ret
end
nc.stats.in_msgs++
nc.stats.in_bytes += m.data.len() as i64
cnt := nc._sub_count.get(idx) + 1
nc._sub_count.set(idx, cnt)
kind := nc._sub_kind.get(idx)
slot := nc._sub_slot.get(idx)
mx := nc._sub_max.get(idx)
if mx > 0 and cnt >= mx:
_tombstone(nc, idx)
end
if kind == KIND_HANDLER:
h := nc._handlers.get(slot)
h(m)
else kind == KIND_REPLIER:
r := nc._repliers.get(slot)
answer := r(m)
if m.reply.len() > 0:
_publish_raw(nc, m.reply, "", Header {}, false, answer)
end
else:
nc._inbox.push(m)
end
end
func _split_args(line: str): Vector<str>:
ret str.Fields(line)
end
func _handle_err(nc &: Conn, line: str):
mut text := str.Trim(line.substr(4, line.len() - 4))
if text.len() >= 2 and text.starts_with("'"):
text = text.substr(1, text.len() - 2)
end
nc.err = text
low := str.Lower(text)
if low.find("authorization") >= 0 or low.find("authentication") >= 0 or low.find("stale connection") >= 0 or low.find("maximum connections") >= 0:
_shutdown(nc)
end
end
func _parse_info(line: str): ServerInfo:
mut s := ServerInfo {}
body := str.Trim(line.substr(4, line.len() - 4))
s.raw = body
s.server_id = json.Get(body, "server_id")
s.server_name = json.Get(body, "server_name")
s.version = json.Get(body, "version")
s.host = json.Get(body, "host")
s.port = json.GetInt(body, "port")
s.proto = json.GetInt(body, "proto")
s.client_id = json.GetInt(body, "client_id")
mp := json.GetInt(body, "max_payload")
if mp > 0:
s.max_payload = mp
end
s.headers = json.Get(body, "headers") == "true"
s.tls_required = json.Get(body, "tls_required") == "true"
s.auth_required = json.Get(body, "auth_required") == "true"
s.jetstream = json.Get(body, "jetstream") == "true"
ret s
end
func _process(nc &: Conn): int:
mut handled := 0
until true:
eol := str.IndexFrom(nc._buf, "\r\n", nc._pos)
if eol < 0:
break
end
line := nc._buf.substr(nc._pos, eol - nc._pos)
after := eol + 2
if line.starts_with("MSG ") or line.starts_with("HMSG "):
hm := line.starts_with("HMSG ")
args := _split_args(line)
defer args.free()
want := hm ? 5 : 4
if args.len() != want and args.len() != want + 1:
nc.err = "malformed MSG"
_shutdown(nc)
break
end
has_reply := args.len() == want + 1
mut hlen := 0
mut total := 0
if hm:
hlen = args.get(has_reply ? 4 : 3).to_int()
total = args.get(has_reply ? 5 : 4).to_int()
else:
total = args.get(has_reply ? 4 : 3).to_int()
end
if total < 0 or hlen < 0 or hlen > total:
nc.err = "malformed MSG size"
_shutdown(nc)
break
end
if nc._buf.len() - after < total + 2:
break
end
mut m := Msg {}
m.ok = true
m.subject = args.get(1)
m.sid = args.get(2).to_int()
if has_reply:
m.reply = args.get(3)
end
if hm:
block := nc._buf.substr(after, hlen)
mut st := 0
mut stt := ""
m.header = HeaderParse(block, st, stt)
m.status = st
m.status_text = stt
end
m.data = nc._buf.substr(after + hlen, total - hlen)
nc._pos = after + total + 2
handled++
_deliver(nc, m)
if nc.closed:
break
end
else line.starts_with("PING"):
nc._pos = after
_write(nc, "PONG\r\n")
else line.starts_with("PONG"):
nc._pos = after
nc._pongs_recv++
else line.starts_with("+OK"):
nc._pos = after
else line.starts_with("-ERR"):
nc._pos = after
_handle_err(nc, line)
if nc.closed:
break
end
else line.starts_with("INFO "):
nc._pos = after
nc.info = _parse_info(line)
else:
nc._pos = after
end
end
if nc._pos > 0:
nc._buf = nc._buf.substr(nc._pos, nc._buf.len() - nc._pos)
nc._pos = 0
end
ret handled
end
func _keepalive(nc &: Conn):
if nc.closed or nc._reconnecting or nc.opts.ping_interval_ms <= 0:
ret
end
if _now() - nc._last_activity < nc.opts.ping_interval_ms as i64:
ret
end
if nc._pings_sent - nc._pongs_recv > nc.opts.max_pings_out:
nc.err = "stale connection"
_lost(nc)
ret
end
nc._pings_sent++
_write(nc, "PING\r\n")
end
func _parse_url(raw: str, host &: str, port &: int, user &: str, pass &: str, token &: str, use_tls &: bool): bool:
mut rest := str.Trim(raw)
use_tls = false
sc := rest.find("://")
if sc >= 0:
scheme := str.Lower(rest.substr(0, sc))
if scheme == "tls" or scheme == "wss" or scheme == "nats+tls":
use_tls = true
else scheme != "nats" and scheme != "tcp":
ret false
end
rest = rest.substr(sc + 3, rest.len() - sc - 3)
end
slash := rest.find("/")
if slash >= 0:
rest = rest.substr(0, slash)
end
at := rest.find("@")
if at >= 0:
cred := rest.substr(0, at)
rest = rest.substr(at + 1, rest.len() - at - 1)
colon := cred.find(":")
if colon >= 0:
user = cred.substr(0, colon)
pass = cred.substr(colon + 1, cred.len() - colon - 1)
else:
token = cred
end
end
port = DEFAULT_PORT
colon := rest.find(":")
if colon >= 0:
port = rest.substr(colon + 1, rest.len() - colon - 1).to_int()
rest = rest.substr(0, colon)
end
host = rest
ret host.len() > 0 and port > 0
end
func _fail(nc &: Conn, why: str): Conn:
nc.err = why
_shutdown(nc)
ret nc
end
func _connect_json(nc: Conn, user: str, pass: str, token: str): str:
o := nc.opts
members := Vector {} as Vector<str>
defer members.free()
members.push(json.MemberBool("verbose", o.verbose))
members.push(json.MemberBool("pedantic", o.pedantic))
members.push(json.MemberBool("tls_required", nc._secure))
if o.name.len() > 0:
members.push(json.Member("name", o.name))
end
members.push(json.Member("lang", "salam"))
members.push(json.Member("version", VERSION))
members.push(json.MemberInt("protocol", 1 as i64))
members.push(json.MemberBool("echo", not o.no_echo))
members.push(json.MemberBool("headers", nc.info.headers))
members.push(json.MemberBool("no_responders", nc.info.headers))
if user.len() > 0:
members.push(json.Member("user", user))
members.push(json.Member("pass", pass))
end
if token.len() > 0:
members.push(json.Member("auth_token", token))
end
ret json.Object(members)
end
func _publish_raw(nc &: Conn, subject: str, reply: str, h: Header, with_header: bool, data: str): bool:
if nc.closed:
nc.err = "connection closed"
ret false
end
if not ValidSubject(subject):
nc.err = "invalid subject"
ret false
end
if reply.len() > 0 and not ValidSubject(reply):
nc.err = "invalid reply subject"
ret false
end
mut line := ""
mut frame := ""
mut size := data.len()
if with_header and h.keys.len() > 0:
if not nc.info.headers:
nc.err = "server does not support headers"
ret false
end
hb := HeaderEncode(h)
size = hb.len() + data.len()
line = "HPUB " + subject + (reply.len() > 0 ? " " + reply : "") + " " + conv.FormatInt(hb.len() as i64) + " " + conv.FormatInt(size as i64)
frame = line + "\r\n" + hb + data + "\r\n"
else:
line = "PUB " + subject + (reply.len() > 0 ? " " + reply : "") + " " + conv.FormatInt(size as i64)
frame = line + "\r\n" + data + "\r\n"
end
if size > nc.info.max_payload:
nc.err = "maximum payload exceeded"
ret false
end
if not _write_pub(nc, frame):
ret false
end
nc.stats.out_msgs++
nc.stats.out_bytes += size as i64
ret true
end
func _add_sub(nc &: Conn, subject: str, queue: str, kind: int, slot: int): Subscription:
mut s := Subscription {}
if nc.closed or nc.draining:
nc.err = nc.closed ? "connection closed" : "connection draining"
ret s
end
if not ValidSubject(subject) or queue.find(" ") >= 0:
nc.err = "invalid subject"
ret s
end
sid := nc._next_sid
line := "SUB " + subject + (queue.len() > 0 ? " " + queue : "") + " " + conv.FormatInt(sid as i64) + "\r\n"
if not nc._reconnecting:
if not _write(nc, line):
if not nc._reconnecting:
ret s
end
end
end
nc._next_sid++
nc._sub_sid.push(sid)
nc._sub_subject.push(subject)
nc._sub_queue.push(queue)
nc._sub_kind.push(kind)
nc._sub_max.push(0)
nc._sub_count.push(0)
nc._sub_slot.push(slot)
s.ok = true
s.sid = sid
s.subject = subject
s.queue = queue
ret s
end
func _drop_inbox(nc &: Conn, sid: int):
mut i := nc._inbox.len() - 1
until i >= 0:
if nc._inbox.get(i).sid == sid:
nc._inbox.remove_at(i)
end
i--
end
end
func _take(nc &: Conn, sid: int): Msg:
repeat nc._inbox.len() in i:
if nc._inbox.get(i).sid == sid:
m := nc._inbox.get(i)
nc._inbox.remove_at(i)
ret m
end
end
ret Msg {}
end
func _open(nc &: Conn, url: str): bool:
opts := nc.opts
mut host := ""
mut port := DEFAULT_PORT
mut user := opts.user
mut pass := opts.password
mut token := opts.token
mut want_tls := opts.secure
mut url_tls := false
if not _parse_url(url, host, port, user, pass, token, url_tls):
nc.err = "invalid url"
ret false
end
if url_tls:
want_tls = true
end
tmo := opts.timeout_ms > 0 ? opts.timeout_ms : 5000
nc._buf = ""
nc._pos = 0
nc._secure = false
nc._plain = tcp.DialTimeout(host, port, tmo)
if not tcp.ConnOk(nc._plain):
nc.err = "could not connect to " + host + ":" + conv.FormatInt(port as i64)
ret false
end
nc._sockopen = true
nc._opening = true
nc.url = url
deadline := _now() + tmo as i64
until true:
if str.IndexFrom(nc._buf, "\r\n", 0) >= 0:
if not nc._buf.starts_with("INFO "):
nc.err = "expected INFO from server"
_close_sock(nc)
nc._opening = false
ret false
end
eol := nc._buf.find("\r\n")
nc.info = _parse_info(nc._buf.substr(0, eol))
nc._buf = nc._buf.substr(eol + 2, nc._buf.len() - eol - 2)
break
end
left := deadline - _now()
if left <= 0:
nc.err = "timeout waiting for INFO"
_close_sock(nc)
nc._opening = false
ret false
end
if _fill(nc, left as int) < 0:
nc.err = "connection lost before INFO"
_close_sock(nc)
nc._opening = false
ret false
end
end
if nc.info.tls_required or want_tls:
mut cfg := tls.NewConfig(host)
cfg.insecure_skip_verify = opts.insecure_skip_verify
nc._tc = tcp.UpgradeTLS(nc._plain, cfg)
if not tls.ConnOk(nc._tc):
nc.err = "tls handshake failed: " + tls.ConnError(nc._tc)
_close_sock(nc)
nc._opening = false
ret false
end
nc._secure = true
end
if nc.info.auth_required and user.len() == 0 and token.len() == 0:
nc.err = "authorization required"
_close_sock(nc)
nc._opening = false
ret false
end
cj := _connect_json(nc, user, pass, token)
nc._pings_sent = 1
nc._pongs_recv = 0
if not _write(nc, "CONNECT " + cj + "\r\nPING\r\n"):
nc._opening = false
ret false
end
until nc._pongs_recv >= 1:
left := deadline - _now()
if left <= 0:
nc.err = "timeout waiting for PONG"
_close_sock(nc)
nc._opening = false
ret false
end
_process(nc)
if nc.closed:
nc._opening = false
ret false
end
if nc._pongs_recv < 1:
if _fill(nc, left as int) < 0:
if nc.err.len() == 0 or nc.err == "connection lost":
nc.err = "connection lost during handshake"
end
nc._opening = false
ret false
end
end
end
nc._opening = false
nc.ok = true
nc._last_activity = _now()
ret true
end
func _resubscribe(nc &: Conn): bool:
mut out := ""
repeat nc._sub_sid.len() in i:
sid := nc._sub_sid.get(i)
if sid <= 0:
continue
end
out += "SUB " + nc._sub_subject.get(i) + (nc._sub_queue.get(i).len() > 0 ? " " + nc._sub_queue.get(i) : "") + " " + conv.FormatInt(sid as i64) + "\r\n"
mx := nc._sub_max.get(i)
if mx > 0:
left := mx - nc._sub_count.get(i)
if left > 0:
out += "UNSUB " + conv.FormatInt(sid as i64) + " " + conv.FormatInt(left as i64) + "\r\n"
end
end
end
if nc._pending.len() > 0:
out += nc._pending
end
if out.len() == 0:
ret true
end
if not _write(nc, out):
ret false
end
nc._pending = ""
ret true
end
func _reconnect(nc &: Conn, timeout_ms: int): bool:
deadline := _now() + timeout_ms as i64
if not nc._reconnecting or nc.closed:
ret nc.ok
end
until true:
mx := nc.opts.max_reconnects
if mx > 0 and nc._attempts >= mx:
nc.err = "maximum reconnects exceeded"
_shutdown(nc)
ret false
end
wait := nc.opts.reconnect_wait_ms
since := _now() - nc._last_attempt
if nc._last_attempt > 0 and since < wait as i64:
mut pause := wait as i64 - since
left := deadline - _now()
if pause > left:
pause = left
end
if pause > 0:
sync.SleepMs(pause as int)
end
if _now() - nc._last_attempt < wait as i64:
ret false
end
end
nc._last_attempt = _now()
url := nc._pool.get(nc._srv_idx % nc._pool.len())
nc._srv_idx++
nc._attempts++
if _open(nc, url):
nc._reconnecting = false
nc._reconnects++
nc._attempts = 0
if not _resubscribe(nc):
ret false
end
ret true
end
if nc.closed:
ret false
end
if _now() >= deadline:
ret false
end
end
end
@en "DefaultOptions"
@fa "گزینه های پیش‌فرض"
pub func DefaultOptions(): Options:
ret Options {}
end
@en "NewHeader"
@fa "سرآیند تازه"
pub func NewHeader(): Header:
ret Header {}
end
@en "HeaderAdd"
@fa "افزودن سرآیند"
pub func HeaderAdd(h &: Header, key: str, value: str):
h.keys.push(key)
h.values.push(value)
end
@en "HeaderDel"
@fa "حذف سرآیند"
pub func HeaderDel(h &: Header, key: str):
mut i := h.keys.len() - 1
until i >= 0:
if str.Lower(h.keys.get(i)) == str.Lower(key):
h.keys.remove_at(i)
h.values.remove_at(i)
end
i--
end
end
@en "HeaderSet"
@fa "تنظیم سرآیند"
pub func HeaderSet(h &: Header, key: str, value: str):
HeaderDel(h, key)
HeaderAdd(h, key, value)
end
@en "HeaderGet"
@fa "گرفتن سرآیند"
pub func HeaderGet(h: Header, key: str): str:
repeat h.keys.len() in i:
if str.Lower(h.keys.get(i)) == str.Lower(key):
ret h.values.get(i)
end
end
ret ""
end
@en "HeaderValues"
@fa "مقدارهای سرآیند"
pub func HeaderValues(h: Header, key: str): Vector<str>:
out := Vector {} as Vector<str>
repeat h.keys.len() in i:
if str.Lower(h.keys.get(i)) == str.Lower(key):
out.push(h.values.get(i))
end
end
ret out
end
@en "HeaderHas"
@fa "سرآیند دارد"
pub func HeaderHas(h: Header, key: str): bool:
repeat h.keys.len() in i:
if str.Lower(h.keys.get(i)) == str.Lower(key):
ret true
end
end
ret false
end
@en "HeaderCount"
@fa "شمار سرآیند"
pub func HeaderCount(h: Header): int:
ret h.keys.len()
end
@en "HeaderEncode"
@fa "رمزگذاری سرآیند"
pub func HeaderEncode(h: Header): str:
mut out := "NATS/1.0\r\n"
repeat h.keys.len() in i:
out += h.keys.get(i) + ": " + h.values.get(i) + "\r\n"
end
ret out + "\r\n"
end
@en "HeaderParse"
@fa "تجزیه سرآیند"
pub func HeaderParse(block: str, status &: int, status_text &: str): Header:
mut h := Header {}
status = 0
status_text = ""
lines := block.split("\r\n")
defer lines.free()
repeat lines.len() in i:
line := lines.get(i)
if i == 0:
if line.len() > 9:
rest := str.Trim(line.substr(8, line.len() - 8))
sp := rest.find(" ")
if sp < 0:
status = rest.to_int()
else:
status = rest.substr(0, sp).to_int()
status_text = str.Trim(rest.substr(sp + 1, rest.len() - sp - 1))
end
end
else line.len() > 0:
colon := line.find(":")
if colon > 0:
HeaderAdd(h, line.substr(0, colon), str.Trim(line.substr(colon + 1, line.len() - colon - 1)))
end
end
end
ret h
end
@en "NewInbox"
@fa "صندوق تازه"
pub func NewInbox(nc: Conn): str:
mut prefix := nc.opts.inbox_prefix
if prefix.len() == 0:
prefix = "_INBOX"
end
ret prefix + "." + rand.Alnum(22)
end
@en "ValidSubject"
@fa "موضوع معتبر"
pub func ValidSubject(subject: str): bool:
if subject.len() == 0:
ret false
end
repeat subject.len() in i:
c := char_code(subject.substr(i, 1))
if c <= 32 or c == 127:
ret false
end
end
if subject.starts_with(".") or subject.ends_with("."):
ret false
end
ret subject.find("..") < 0
end
@en "SubjectMatches"
@fa "تطبیق موضوع"
pub func SubjectMatches(pattern: str, subject: str): bool:
pt := pattern.split(".")
st := subject.split(".")
defer pt.free()
defer st.free()
repeat pt.len() in i:
p := pt.get(i)
if p == ">":
ret i < st.len()
end
if i >= st.len():
ret false
end
if p != "*" and p != st.get(i):
ret false
end
end
ret pt.len() == st.len()
end
@en "Pump"
@fa "پردازش"
pub func Pump(nc &: Conn, timeout_ms: int): int:
if nc._reconnecting:
_reconnect(nc, timeout_ms)
ret 0
end
mut handled := _process(nc)
if handled > 0 or nc.closed:
ret handled
end
r := _fill(nc, timeout_ms)
if r > 0:
handled = _process(nc)
end
_keepalive(nc)
ret handled
end
@en "Connect"
@fa "برقراری اتصال"
pub func Connect(url: str): Conn:
ret ConnectWith(url, Options {})
end
@en "ConnectWith"
@fa "برقراری اتصال با گزینه"
pub func ConnectWith(url: str, opts: Options): Conn:
rand.SeedAuto()
mut nc := Conn {}
nc.url = url
nc.opts = opts
nc._pool.push(url)
each sv in opts.servers:
nc._pool.push(sv)
end
mut last := ""
repeat nc._pool.len() in i:
if _open(nc, nc._pool.get(i)):
nc._srv_idx = i + 1
ret nc
end
last = nc.err
if nc.closed:
ret nc
end
end
ret _fail(nc, last)
end
@en "IsConnected"
@fa "وصل است"
pub func IsConnected(nc: Conn): bool:
ret nc.ok and not nc.closed
end
@en "IsClosed"
@fa "بسته شده است"
pub func IsClosed(nc: Conn): bool:
ret nc.closed
end
@en "LastError"
@fa "آخرین خطا"
pub func LastError(nc: Conn): str:
ret nc.err
end
@en "Close"
@fa "بستن"
pub func Close(nc &: Conn):
_shutdown(nc)
end
@en "Publish"
@fa "انتشار"
pub func Publish(nc &: Conn, subject: str, data: str): bool:
if nc.draining and not nc.closed:
nc.err = "connection draining"
ret false
end
ret _publish_raw(nc, subject, "", Header {}, false, data)
end
@en "PublishRequest"
@fa "انتشار درخواست"
pub func PublishRequest(nc &: Conn, subject: str, reply: str, data: str): bool:
if nc.draining and not nc.closed:
nc.err = "connection draining"
ret false
end
ret _publish_raw(nc, subject, reply, Header {}, false, data)
end
@en "PublishHeaders"
@fa "انتشار با سرآیند"
pub func PublishHeaders(nc &: Conn, subject: str, h: Header, data: str): bool:
if nc.draining and not nc.closed:
nc.err = "connection draining"
ret false
end
ret _publish_raw(nc, subject, "", h, true, data)
end
@en "PublishMsg"
@fa "انتشار پیام"
pub func PublishMsg(nc &: Conn, m: Msg): bool:
if nc.draining and not nc.closed:
nc.err = "connection draining"
ret false
end
ret _publish_raw(nc, m.subject, m.reply, m.header, true, m.data)
end
@en "Respond"
@fa "پاسخ"
pub func Respond(nc &: Conn, m: Msg, data: str): bool:
if m.reply.len() == 0:
nc.err = "message has no reply subject"
ret false
end
ret _publish_raw(nc, m.reply, "", Header {}, false, data)
end
@en "Subscribe"
@fa "اشتراک"
pub func Subscribe(nc &: Conn, subject: str): Subscription:
ret _add_sub(nc, subject, "", KIND_QUEUE, 0)
end
@en "QueueSubscribe"
@fa "اشتراک صف"
pub func QueueSubscribe(nc &: Conn, subject: str, queue: str): Subscription:
ret _add_sub(nc, subject, queue, KIND_QUEUE, 0)
end
@en "SubscribeHandler"
@fa "اشتراک با دستگیره"
pub func SubscribeHandler(nc &: Conn, subject: str, queue: str, handler: func (Msg)): Subscription:
slot := nc._handlers.len()
nc._handlers.push(handler)
ret _add_sub(nc, subject, queue, KIND_HANDLER, slot)
end
@en "SubscribeReplier"
@fa "اشتراک پاسخگو"
pub func SubscribeReplier(nc &: Conn, subject: str, queue: str, handler: func (Msg) str): Subscription:
slot := nc._repliers.len()
nc._repliers.push(handler)
ret _add_sub(nc, subject, queue, KIND_REPLIER, slot)
end
@en "Unsubscribe"
@fa "لغو اشتراک"
pub func Unsubscribe(nc &: Conn, s: Subscription): bool:
idx := _find_sub(nc, s.sid)
if idx < 0:
ret false
end
_tombstone(nc, idx)
_drop_inbox(nc, s.sid)
if nc._reconnecting:
ret true
end
ret _write(nc, "UNSUB " + conv.FormatInt(s.sid as i64) + "\r\n")
end
@en "AutoUnsubscribe"
@fa "لغو خودکار اشتراک"
pub func AutoUnsubscribe(nc &: Conn, s: Subscription, max: int): bool:
idx := _find_sub(nc, s.sid)
if idx < 0 or max <= 0:
ret false
end
nc._sub_max.set(idx, max)
if nc._sub_count.get(idx) >= max:
_tombstone(nc, idx)
end
if nc._reconnecting:
ret true
end
ret _write(nc, "UNSUB " + conv.FormatInt(s.sid as i64) + " " + conv.FormatInt(max as i64) + "\r\n")
end
@en "IsValidSubscription"
@fa "اشتراک فعال است"
pub func IsValidSubscription(nc: Conn, s: Subscription): bool:
ret _find_sub(nc, s.sid) >= 0
end
@en "Delivered"
@fa "تحویل شده"
pub func Delivered(nc: Conn, s: Subscription): int:
repeat nc._sub_sid.len() in i:
if nc._sub_sid.get(i) == s.sid or nc._sub_sid.get(i) == 0 - s.sid:
ret nc._sub_count.get(i)
end
end
ret 0
end
@en "Pending"
@fa "صف مانده"
pub func Pending(nc: Conn, s: Subscription): int:
mut n := 0
repeat nc._inbox.len() in i:
if nc._inbox.get(i).sid == s.sid:
n++
end
end
ret n
end
@en "NextMsg"
@fa "پیام بعدی"
pub func NextMsg(nc &: Conn, s: Subscription, timeout_ms: int): Msg:
deadline := _now() + timeout_ms as i64
until true:
m := _take(nc, s.sid)
if m.ok:
ret m
end
if nc.closed:
mut e := Msg {}
e.err = "connection closed"
ret e
end
left := deadline - _now()
if left <= 0:
break
end
wait := left > 1000 ? 1000 : (left as int)
Pump(nc, wait)
end
mut t := Msg {}
t.err = "timeout"
ret t
end
@en "Flush"
@fa "تخلیه"
pub func Flush(nc &: Conn, timeout_ms: int): bool:
if nc.closed:
ret false
end
deadline := _now() + timeout_ms as i64
mut seen := nc._reconnects
mut target := 0
mut sent := false
until true:
if nc.closed:
ret false
end
if not nc._reconnecting and (not sent or seen != nc._reconnects):
seen = nc._reconnects
nc._pings_sent++
target = nc._pings_sent
sent = _write(nc, "PING\r\n")
end
if sent and not nc._reconnecting and seen == nc._reconnects and nc._pongs_recv >= target:
break
end
left := deadline - _now()
if left <= 0:
nc.err = "flush timeout"
ret false
end
Pump(nc, left > 1000 ? 1000 : (left as int))
end
ret true
end
@en "Request"
@fa "درخواست"
pub func Request(nc &: Conn, subject: str, data: str, timeout_ms: int): Msg:
ret RequestMsg(nc, subject, Header {}, data, timeout_ms)
end
@en "RequestMsg"
@fa "درخواست با سرآیند"
pub func RequestMsg(nc &: Conn, subject: str, h: Header, data: str, timeout_ms: int): Msg:
mut fail := Msg {}
inbox := NewInbox(nc)
s := Subscribe(nc, inbox)
if not s.ok:
fail.err = nc.err
ret fail
end
AutoUnsubscribe(nc, s, 1)
if not _publish_raw(nc, subject, inbox, h, true, data):
fail.err = nc.err
ret fail
end
mut m := NextMsg(nc, s, timeout_ms)
if not m.ok:
Unsubscribe(nc, s)
ret m
end
if m.status == STATUS_NO_RESPONDERS:
m.ok = false
m.err = "no responders"
end
ret m
end
@en "Drain"
@fa "تخلیه کامل"
pub func Drain(nc &: Conn, timeout_ms: int): bool:
if nc.closed:
ret false
end
if nc._reconnecting:
_shutdown(nc)
ret false
end
nc.draining = true
repeat nc._sub_sid.len() in i:
sid := nc._sub_sid.get(i)
if sid > 0:
_write(nc, "UNSUB " + conv.FormatInt(sid as i64) + "\r\n")
end
end
ok := Flush(nc, timeout_ms)
_shutdown(nc)
ret ok
end
@en "MaxPayload"
@fa "بیشینه اندازه بار"
pub func MaxPayload(nc: Conn): int:
ret nc.info.max_payload
end
@en "SubscriptionCount"
@fa "شمار اشتراک"
pub func SubscriptionCount(nc: Conn): int:
mut n := 0
repeat nc._sub_sid.len() in i:
if nc._sub_sid.get(i) > 0:
n++
end
end
ret n
end
@en "IsReconnecting"
@fa "در حال اتصال دوباره"
pub func IsReconnecting(nc: Conn): bool:
ret nc._reconnecting and not nc.closed
end
@en "Reconnects"
@fa "شمار اتصال دوباره"
pub func Reconnects(nc: Conn): int:
ret nc._reconnects
end
@en "BufferedBytes"
@fa "بایت‌های بافر شده"
pub func BufferedBytes(nc: Conn): int:
ret nc._pending.len()
end
@en "net"
@fa "شبکه"
package net
@en "net/proxy"
@fa "پراکسی"
package proxy
import mem
import str
import encoding
import net.tcp
@en "TypeHTTP"
@fa "نوع اچ‌تی‌تی‌پی"
pub const TypeHTTP := 0
@en "TypeSOCKS5"
@fa "نوع ساکس۵"
pub const TypeSOCKS5 := 1
struct _AddrParts:
pub host: str = ""
pub port: int = 0
end
@en "Proxy"
@fa "پراکسی"
pub struct Proxy:
@en "kind"
@fa "نوع"
pub kind: int = 0
@en "host"
@fa "میزبان"
pub host: str = ""
@en "port"
@fa "درگاه"
pub port: int = 0
@en "username"
@fa "نام کاربری"
pub username: str = ""
@en "password"
@fa "گذرواژه"
pub password: str = ""
end
@en "Chain"
@fa "زنجیره پراکسی"
pub struct Chain:
@en "items"
@fa "پراکسی‌ها"
pub items: Vector<Proxy> = Vector {}
end
inline pure func _ub(p: i8*, i: int): int:
b := p[i] as int
if b < 0: ret b + 256 end
ret b
end
func _parse_addr(addr: str): _AddrParts:
mut r := _AddrParts {}
idx := addr.find(":")
if idx < 0:
r.host = addr
else:
r.host = addr.substr(0, idx)
r.port = addr.substr(idx + 1, addr.len() - idx - 1).to_int()
end
ret r
end
func _http_connect(conn: tcp.Conn, p: Proxy, host: str, port: int): bool:
hostport := host + ":" + str.FromInt(port as i64)
mut req := "CONNECT " + hostport + " HTTP/1.1\r\nHost: " + hostport + "\r\n"
if p.username.len() > 0:
cred := p.username + ":" + p.password
req += "Proxy-Authorization: Basic " + encoding.Base64Encode(cred) + "\r\n"
end
req += "Proxy-Connection: Keep-Alive\r\n\r\n"
tcp.Write(conn, req)
resp := tcp.Read(conn, 4096)
if resp.len() < 12: ret false end
ret resp.substr(9, 3) == "200"
end
func _socks5_auth(conn: tcp.Conn, p: Proxy): bool:
ulen := p.username.len()
plen := p.password.len()
total := 3 + ulen + plen
buf := mem.Allocate(total as u64)
defer mem.Free(buf)
bp := buf as i8*
bp[0] = 1 as i8
bp[1] = ulen as i8
mem.Copy((buf as i64 + 2) as void*, p.username as void*, ulen as u64)
bp[2 + ulen] = plen as i8
mem.Copy((buf as i64 + 3 + ulen) as void*, p.password as void*, plen as u64)
tcp.WriteBytes(conn, buf, total)
resp := mem.Allocate(2 as u64)
defer mem.Free(resp)
n := tcp.ReadBytes(conn, resp, 2)
if n < 2: ret false end
rp := resp as i8*
ret _ub(rp, 1) == 0
end
func _socks5_negotiate(conn: tcp.Conn, p: Proxy): bool:
mut nmethods := 1
if p.username.len() > 0: nmethods = 2 end
buf := mem.Allocate((2 + nmethods) as u64)
defer mem.Free(buf)
bp := buf as i8*
bp[0] = 5 as i8
bp[1] = nmethods as i8
bp[2] = 0 as i8
if nmethods == 2: bp[3] = 2 as i8 end
tcp.WriteBytes(conn, buf, 2 + nmethods)
resp := mem.Allocate(2 as u64)
defer mem.Free(resp)
n := tcp.ReadBytes(conn, resp, 2)
if n < 2: ret false end
rp := resp as i8*
method := _ub(rp, 1)
if method == 255: ret false end
if method == 2: ret _socks5_auth(conn, p) end
ret true
end
func _socks5_connect(conn: tcp.Conn, host: str, port: int): bool:
hlen := host.len()
total := 4 + 1 + hlen + 2
buf := mem.Allocate(total as u64)
defer mem.Free(buf)
bp := buf as i8*
bp[0] = 5 as i8
bp[1] = 1 as i8
bp[2] = 0 as i8
bp[3] = 3 as i8
bp[4] = hlen as i8
mem.Copy((buf as i64 + 5) as void*, host as void*, hlen as u64)
bp[5 + hlen] = ((port / 256) & 255) as i8
bp[6 + hlen] = (port & 255) as i8
tcp.WriteBytes(conn, buf, total)
resp := mem.Allocate(262 as u64)
defer mem.Free(resp)
n := tcp.ReadBytes(conn, resp, 262)
if n < 4: ret false end
rp := resp as i8*
ret _ub(rp, 1) == 0
end
func _handshake(conn: tcp.Conn, p: Proxy, host: str, port: int): bool:
if p.kind == TypeSOCKS5:
if not _socks5_negotiate(conn, p): ret false end
ret _socks5_connect(conn, host, port)
end
ret _http_connect(conn, p, host, port)
end
@en "NewHTTPProxy"
@fa "پراکسی اچ‌تی‌تی‌پی جدید"
pub func NewHTTPProxy(addr: str): Proxy:
parts := _parse_addr(addr)
ret Proxy { kind = TypeHTTP, host = parts.host, port = parts.port }
end
@en "NewHTTPProxyAuth"
@fa "پراکسی اچ‌تی‌تی‌پی با احراز هویت"
pub func NewHTTPProxyAuth(addr: str, username: str, password: str): Proxy:
mut p := NewHTTPProxy(addr)
p.username = username
p.password = password
ret p
end
@en "NewSOCKS5Proxy"
@fa "پراکسی ساکس۵ جدید"
pub func NewSOCKS5Proxy(addr: str): Proxy:
parts := _parse_addr(addr)
ret Proxy { kind = TypeSOCKS5, host = parts.host, port = parts.port }
end
@en "NewSOCKS5ProxyAuth"
@fa "پراکسی ساکس۵ با احراز هویت"
pub func NewSOCKS5ProxyAuth(addr: str, username: str, password: str): Proxy:
mut p := NewSOCKS5Proxy(addr)
p.username = username
p.password = password
ret p
end
@en "Dial"
@fa "شماره‌گیری"
pub func Dial(p: Proxy, target_host: str, target_port: int): tcp.Conn:
conn := tcp.Dial(p.host, p.port)
if not tcp.ConnOk(conn): ret conn end
ok := _handshake(conn, p, target_host, target_port)
if not ok:
tcp.Close(conn)
ret tcp.Conn {}
end
ret conn
end
@en "NewChain"
@fa "زنجیره جدید"
pub func NewChain(): Chain:
ret Chain {}
end
@en "Add"
@fa "افزودن"
pub func Add(c &: Chain, p: Proxy):
c.items.push(p)
end
@en "DialChain"
@fa "شماره‌گیری زنجیره‌ای"
pub func DialChain(c: Chain, target_host: str, target_port: int): tcp.Conn:
n := c.items.len()
if n == 0: ret tcp.Dial(target_host, target_port) end
first := c.items.get(0)
conn := tcp.Dial(first.host, first.port)
if not tcp.ConnOk(conn): ret conn end
mut i := 0
mut failed := false
until i < n:
p := c.items.get(i)
mut next_host := target_host
mut next_port := target_port
if i + 1 < n:
nxt := c.items.get(i + 1)
next_host = nxt.host
next_port = nxt.port
end
ok := _handshake(conn, p, next_host, next_port)
if not ok:
failed = true
i = n
continue
end
i++
end
if failed:
tcp.Close(conn)
ret tcp.Conn {}
end
ret conn
end
@en "net/reality"
