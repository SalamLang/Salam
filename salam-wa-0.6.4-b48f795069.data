pub func GetInfo(c: Client): Info:
r := Perform(c, "GET", "/", "")
if not r.ok: ret Info {} end
body := r.body
mut dist := json.GetPath(body, "version.distribution")
if dist.len() == 0: dist = str.Clone("elasticsearch") end
ret Info {
ok = true, name = json.Get(body, "name"), cluster_name = json.Get(body, "cluster_name"),
cluster_uuid = json.Get(body, "cluster_uuid"), version = json.GetPath(body, "version.number"),
distribution = dist, build_flavor = json.GetPath(body, "version.build_flavor"), lucene_version = json.GetPath(body, "version.lucene_version"),
tagline = json.Get(body, "tagline")
}
end
