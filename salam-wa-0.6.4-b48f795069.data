m[1] = 0.0
m[2] = 0.0
m[3] = 1.0
m[4] = 0.0
m[5] = 0.0
end
func _m_is_ident(m: f64[]): bool:
ret m[0] == 1.0 and m[1] == 0.0 and m[2] == 0.0 and m[3] == 1.0 and m[4] == 0.0 and m[5] == 0.0
