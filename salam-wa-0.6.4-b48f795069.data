func _pp_i2u(p: _Ppmd, i: int): int:
ret p.i2u[i] as int
end
func _pp_u2i(p: _Ppmd, nu: int): int:
ret p.u2i[nu - 1] as int
end
func _pp_insert_node(p &: _Ppmd, node: int, indx: int):
_pp_s32(p, node, p.free_list[indx])
p.free_list[indx] = node
end
func _pp_remove_node(p &: _Ppmd, indx: int): int:
node := p.free_list[indx]
p.free_list[indx] = _pp_g32(p, node)
ret node
end
func _pp_split_block(p &: _Ppmd, ptr0: int, old_i: int, new_i: int):
nu := _pp_i2u(p, old_i) - _pp_i2u(p, new_i)
ptr := ptr0 + _pp_i2u(p, new_i) * _PP_UNIT
mut i := _pp_u2i(p, nu)
if _pp_i2u(p, i) != nu:
i--
k := _pp_i2u(p, i)
_pp_insert_node(p, ptr + k * _PP_UNIT, nu - k - 1)
end
_pp_insert_node(p, ptr, i)
end
func _pp_glue(p &: _Ppmd):
head := p.align + p.size
mut n := head
p.glue_count = 255
repeat _PP_NUM_INDEXES in i:
nu := _pp_i2u(p, i)
mut next := p.free_list[i]
p.free_list[i] = 0
until next != 0:
node := next
_pp_s32(p, node + 4, n)
_pp_s32(p, n + 8, next)
n = next
next = _pp_g32(p, node)
_pp_s16(p, node, 0)
_pp_s16(p, node + 2, nu)
end
end
_pp_s16(p, head, 1)
_pp_s32(p, head + 4, n)
_pp_s32(p, n + 8, head)
if p.lo_unit != p.hi_unit:
_pp_s16(p, p.lo_unit, 1)
end
until n != head:
node := n
mut nu := _pp_g16(p, node + 2)
until true:
node2 := node + nu * _PP_UNIT
nu += _pp_g16(p, node2 + 2)
if _pp_g16(p, node2) != 0 or nu >= 0x10000:
break
end
_pp_s32(p, _pp_g32(p, node2 + 8) + 4, _pp_g32(p, node2 + 4))
_pp_s32(p, _pp_g32(p, node2 + 4) + 8, _pp_g32(p, node2 + 8))
_pp_s16(p, node + 2, nu)
end
n = _pp_g32(p, node + 4)
end
n = _pp_g32(p, head + 4)
until n != head:
mut node := n
next := _pp_g32(p, node + 4)
mut nu := _pp_g16(p, node + 2)
until nu > 128:
_pp_insert_node(p, node, _PP_NUM_INDEXES - 1)
nu -= 128
node += 128 * _PP_UNIT
end
mut i := _pp_u2i(p, nu)
if _pp_i2u(p, i) != nu:
i--
k := _pp_i2u(p, i)
_pp_insert_node(p, node + k * _PP_UNIT, nu - k - 1)
end
_pp_insert_node(p, node, i)
n = next
end
end
func _pp_alloc_units_rare(p &: _Ppmd, indx: int): int:
if p.glue_count == 0:
_pp_glue(p)
if p.free_list[indx] != 0:
ret _pp_remove_node(p, indx)
end
end
mut i := indx
until true:
i++
if i == _PP_NUM_INDEXES:
nb := _pp_i2u(p, indx) * _PP_UNIT
p.glue_count--
if p.units_start - p.text > nb:
p.units_start -= nb
ret p.units_start
end
ret 0
end
if p.free_list[i] != 0:
break
end
end
r := _pp_remove_node(p, i)
_pp_split_block(p, r, i, indx)
ret r
end
func _pp_alloc_units(p &: _Ppmd, indx: int): int:
if p.free_list[indx] != 0:
ret _pp_remove_node(p, indx)
end
nb := _pp_i2u(p, indx) * _PP_UNIT
if nb <= p.hi_unit - p.lo_unit:
r := p.lo_unit
p.lo_unit += nb
ret r
end
ret _pp_alloc_units_rare(p, indx)
end
func _pp_copy_units(p: _Ppmd, dst: int, src: int, nu: int):
mem.Copy(((p.base as i64) + (dst as i64)) as void*, ((p.base as i64) + (src as i64)) as void*, (nu * _PP_UNIT) as u64)
end
func _pp_shrink_units(p &: _Ppmd, old: int, old_nu: int, new_nu: int): int:
i0 := _pp_u2i(p, old_nu)
i1 := _pp_u2i(p, new_nu)
if i0 == i1:
ret old
end
if p.free_list[i1] != 0:
ptr := _pp_remove_node(p, i1)
_pp_copy_units(p, ptr, old, new_nu)
_pp_insert_node(p, old, i0)
ret ptr
end
_pp_split_block(p, old, i0, i1)
ret old
end
func _pp_restart(p &: _Ppmd):
repeat _PP_NUM_INDEXES in i:
p.free_list[i] = 0
end
p.text = p.align
p.hi_unit = p.text + p.size
p.units_start = p.hi_unit - (p.size / 8 / _PP_UNIT) * 7 * _PP_UNIT
p.lo_unit = p.units_start
p.glue_count = 0
p.order_fall = p.max_order
p.init_rl = -(p.max_order < 12 ? p.max_order : 12) - 1
p.run_length = p.init_rl
p.prev_success = 0
p.hi_unit -= _PP_UNIT
p.min_ctx = p.hi_unit
p.max_ctx = p.hi_unit
_pp_s32(p, p.min_ctx + 8, 0)
_pp_s16(p, p.min_ctx, 256)
_pp_s16(p, p.min_ctx + 2, 257)
p.found = p.lo_unit
p.lo_unit += (256 / 2) * _PP_UNIT
_pp_s32(p, p.min_ctx + 4, p.found)
repeat 256 in i:
s := p.found + i * 6
p.base[s] = i as u8
p.base[s + 1] = 1 as u8
_pp_set_succ(p, s, 0)
end
repeat 128 in i:
repeat 8 in k:
val := _PP_BIN_SCALE - _PP_INIT_BIN_ESC[k] / (i + 2)
mut m := 0
until m < 64:
p.bin_summ[i * 64 + k + m] = val as u16
m += 8
end
end
end
repeat 25 in i:
repeat 16 in k:
p.see_shift[i * 16 + k] = (_PP_PERIOD_BITS - 4) as u8
p.see_summ[i * 16 + k] = ((5 * i + 10) << (_PP_PERIOD_BITS - 4)) as u16
p.see_count[i * 16 + k] = 4 as u8
end
end
end
func _pp_init(p &: _Ppmd, max_order: int):
p.max_order = max_order
_pp_restart(p)
p.see_shift[400] = _PP_PERIOD_BITS as u8
p.see_summ[400] = 0 as u16
p.see_count[400] = 64 as u8
p.ready = true
end
func _pp_create_successors(p &: _Ppmd, skip: bool): int:
mut psl: int[64]
mut c := p.min_ctx
up_branch := _pp_succ(p, p.found)
mut nps := 0
fsym := _pp_sym(p, p.found)
if not skip:
psl[nps] = p.found
nps++
end
until _pp_suffix(p, c) != 0:
c = _pp_suffix(p, c)
mut s := 0
if _pp_ns(p, c) != 1:
s = _pp_stats(p, c)
until _pp_sym(p, s) != fsym:
s += 6
end
else:
s = c + 2
end
succ := _pp_succ(p, s)
if succ != up_branch:
c = succ
if nps == 0:
ret c
end
break
end
psl[nps] = s
nps++
end
up_sym := p.base[up_branch] as int
up_succ := up_branch + 1
mut up_freq := 0
if _pp_ns(p, c) == 1:
up_freq = _pp_freq(p, c + 2)
else:
mut s2 := _pp_stats(p, c)
until _pp_sym(p, s2) != up_sym:
s2 += 6
end
cf := _pp_freq(p, s2) - 1
s0 := _pp_sf(p, c) - _pp_ns(p, c) - cf
if 2 * cf <= s0:
up_freq = 1 + (5 * cf > s0 ? 1 : 0)
else:
up_freq = 1 + (2 * cf + 3 * s0 - 1) / (2 * s0)
end
end
until true:
mut c1 := 0
if p.hi_unit != p.lo_unit:
p.hi_unit -= _PP_UNIT
c1 = p.hi_unit
else p.free_list[0] != 0:
c1 = _pp_remove_node(p, 0)
else:
c1 = _pp_alloc_units_rare(p, 0)
if c1 == 0:
ret 0
end
end
_pp_s16(p, c1, 1)
p.base[c1 + 2] = up_sym as u8
p.base[c1 + 3] = (up_freq & 255) as u8
_pp_set_succ(p, c1 + 2, up_succ)
_pp_s32(p, c1 + 8, c)
nps--
_pp_set_succ(p, psl[nps], c1)
c = c1
if nps == 0:
break
end
end
ret c
end
func _pp_update_model(p &: _Ppmd):
fsym := _pp_sym(p, p.found)
ffreq := _pp_freq(p, p.found)
mut fsucc := _pp_succ(p, p.found)
if ffreq < _PP_MAX_FREQ / 4 and _pp_suffix(p, p.min_ctx) != 0:
c := _pp_suffix(p, p.min_ctx)
if _pp_ns(p, c) == 1:
s := c + 2
if _pp_freq(p, s) < 32:
_pp_set_freq(p, s, _pp_freq(p, s) + 1)
end
else:
mut s := _pp_stats(p, c)
if _pp_sym(p, s) != fsym:
until true:
s += 6
if _pp_sym(p, s) == fsym:
break
end
end
if _pp_freq(p, s) >= _pp_freq(p, s - 6):
_pp_swap_states(p, s, s - 6)
s -= 6
end
end
if _pp_freq(p, s) < _PP_MAX_FREQ - 9:
_pp_set_freq(p, s, _pp_freq(p, s) + 2)
_pp_s16(p, c + 2, _pp_sf(p, c) + 2)
end
end
end
if p.order_fall == 0:
p.min_ctx = _pp_create_successors(p, true)
p.max_ctx = p.min_ctx
if p.min_ctx == 0:
_pp_restart(p)
ret
end
_pp_set_succ(p, p.found, p.min_ctx)
ret
end
p.base[p.text] = fsym as u8
p.text++
mut successor := p.text
if p.text >= p.units_start:
_pp_restart(p)
ret
end
if fsucc != 0:
if fsucc <= successor:
cs := _pp_create_successors(p, false)
if cs == 0:
_pp_restart(p)
ret
end
fsucc = cs
end
p.order_fall--
if p.order_fall == 0:
successor = fsucc
if p.max_ctx != p.min_ctx:
p.text--
end
end
else:
_pp_set_succ(p, p.found, successor)
fsucc = p.min_ctx
end
ns := _pp_ns(p, p.min_ctx)
s0 := _pp_sf(p, p.min_ctx) - ns - (ffreq - 1)
mut c := p.max_ctx
until c != p.min_ctx:
ns1 := _pp_ns(p, c)
if ns1 != 1:
if (ns1 & 1) == 0:
old_nu := ns1 >> 1
i := _pp_u2i(p, old_nu)
if i != _pp_u2i(p, old_nu + 1):
ptr := _pp_alloc_units(p, i + 1)
if ptr == 0:
_pp_restart(p)
ret
end
old_ptr := _pp_stats(p, c)
_pp_copy_units(p, ptr, old_ptr, old_nu)
_pp_insert_node(p, old_ptr, i)
_pp_s32(p, c + 4, ptr)
end
end
sf0 := _pp_sf(p, c)
add := (2 * ns1 < ns ? 1 : 0) + 2 * ((4 * ns1 <= ns and sf0 <= 8 * ns1) ? 1 : 0)
_pp_s16(p, c + 2, sf0 + add)
else:
s := _pp_alloc_units(p, 0)
if s == 0:
_pp_restart(p)
ret
end
_pp_copy_state(p, s, c + 2)
_pp_s32(p, c + 4, s)
mut fr := _pp_freq(p, s)
if fr < _PP_MAX_FREQ / 4 - 1:
fr <<= 1
else:
fr = _PP_MAX_FREQ - 4
end
_pp_set_freq(p, s, fr)
_pp_s16(p, c + 2, fr + p.init_esc + (ns > 3 ? 1 : 0))
end
mut cf := 2 * ffreq * (_pp_sf(p, c) + 6)
sf := s0 + _pp_sf(p, c)
if cf < 6 * sf:
cf = 1 + (cf > sf ? 1 : 0) + (cf >= 4 * sf ? 1 : 0)
_pp_s16(p, c + 2, _pp_sf(p, c) + 3)
else:
cf = 4 + (cf >= 9 * sf ? 1 : 0) + (cf >= 12 * sf ? 1 : 0) + (cf >= 15 * sf ? 1 : 0)
_pp_s16(p, c + 2, _pp_sf(p, c) + cf)
end
ns2 := _pp_stats(p, c) + ns1 * 6
_pp_set_succ(p, ns2, successor)
p.base[ns2] = fsym as u8
p.base[ns2 + 1] = (cf & 255) as u8
_pp_s16(p, c, ns1 + 1)
c = _pp_suffix(p, c)
end
p.max_ctx = fsucc
p.min_ctx = fsucc
end
func _pp_rescale(p &: _Ppmd):
stats := _pp_stats(p, p.min_ctx)
mut s := p.found
if s != stats:
tmp0 := p.base[s]
tmp1 := p.base[s + 1]
tmp2 := p.base[s + 2]
tmp3 := p.base[s + 3]
tmp4 := p.base[s + 4]
tmp5 := p.base[s + 5]
until s != stats:
_pp_copy_state(p, s, s - 6)
s -= 6
end
p.base[s] = tmp0
p.base[s + 1] = tmp1
p.base[s + 2] = tmp2
p.base[s + 3] = tmp3
p.base[s + 4] = tmp4
p.base[s + 5] = tmp5
end
mut esc_freq := _pp_sf(p, p.min_ctx) - _pp_freq(p, s)
adder := p.order_fall != 0 ? 1 : 0
_pp_set_freq(p, s, (_pp_freq(p, s) + 4 + adder) >> 1)
mut sum_freq := _pp_freq(p, s)
mut i := _pp_ns(p, p.min_ctx) - 1
until true:
s += 6
esc_freq -= _pp_freq(p, s)
_pp_set_freq(p, s, (_pp_freq(p, s) + adder) >> 1)
sum_freq += _pp_freq(p, s)
if _pp_freq(p, s) > _pp_freq(p, s - 6):
mut s1 := s
t0 := p.base[s1]
t1 := p.base[s1 + 1]
t2 := p.base[s1 + 2]
t3 := p.base[s1 + 3]
t4 := p.base[s1 + 4]
t5 := p.base[s1 + 5]
tf := t1 as int
until true:
_pp_copy_state(p, s1, s1 - 6)
s1 -= 6
if s1 == stats or tf <= _pp_freq(p, s1 - 6):
break
end
end
p.base[s1] = t0
p.base[s1 + 1] = t1
p.base[s1 + 2] = t2
p.base[s1 + 3] = t3
p.base[s1 + 4] = t4
p.base[s1 + 5] = t5
end
i--
if i == 0:
break
end
end
if _pp_freq(p, s) == 0:
num_stats := _pp_ns(p, p.min_ctx)
mut j := 0
until true:
j++
s -= 6
if _pp_freq(p, s) != 0:
break
end
end
esc_freq += j
_pp_s16(p, p.min_ctx, num_stats - j)
if _pp_ns(p, p.min_ctx) == 1:
mut tf2 := _pp_freq(p, stats)
t_sym := p.base[stats]
t_s2 := p.base[stats + 2]
t_s3 := p.base[stats + 3]
t_s4 := p.base[stats + 4]
t_s5 := p.base[stats + 5]
until true:
tf2 -= (tf2 >> 1)
esc_freq >>= 1
if esc_freq <= 1:
break
end
end
_pp_insert_node(p, stats, _pp_u2i(p, (num_stats + 1) >> 1))
p.found = p.min_ctx + 2
p.base[p.found] = t_sym
p.base[p.found + 1] = (tf2 & 255) as u8
p.base[p.found + 2] = t_s2
p.base[p.found + 3] = t_s3
p.base[p.found + 4] = t_s4
p.base[p.found + 5] = t_s5
ret
end
n0 := (num_stats + 1) >> 1
n1 := (_pp_ns(p, p.min_ctx) + 1) >> 1
if n0 != n1:
_pp_s32(p, p.min_ctx + 4, _pp_shrink_units(p, stats, n0, n1))
end
end
_pp_s16(p, p.min_ctx + 2, sum_freq + esc_freq - (esc_freq >> 1))
p.found = _pp_stats(p, p.min_ctx)
end
func _pp_make_esc_freq(p &: _Ppmd, num_masked: int, esc_out &: int): int:
ns := _pp_ns(p, p.min_ctx)
non_masked := ns - num_masked
if ns != 256:
suf := _pp_suffix(p, p.min_ctx)
mut idx := (p.ns2i[non_masked - 1] as int) * 16
idx += (non_masked < _pp_ns(p, suf) - ns ? 1 : 0)
idx += 2 * (_pp_sf(p, p.min_ctx) < 11 * ns ? 1 : 0)
idx += 4 * (num_masked > non_masked ? 1 : 0)
idx += p.hi_bits
r := (p.see_summ[idx] as int) >> (p.see_shift[idx] as int)
p.see_summ[idx] = ((p.see_summ[idx] as int) - r) as u16
esc_out = r + (r == 0 ? 1 : 0)
ret idx
end
esc_out = 1
ret 400
end
func _pp_next_context(p &: _Ppmd):
c := _pp_succ(p, p.found)
if p.order_fall == 0 and c > p.text:
p.min_ctx = c
p.max_ctx = c
else:
_pp_update_model(p)
end
end
func _pp_update1(p &: _Ppmd):
s := p.found
_pp_set_freq(p, s, _pp_freq(p, s) + 4)
_pp_s16(p, p.min_ctx + 2, _pp_sf(p, p.min_ctx) + 4)
if _pp_freq(p, s) > _pp_freq(p, s - 6):
_pp_swap_states(p, s, s - 6)
p.found = s - 6
if _pp_freq(p, p.found) > _PP_MAX_FREQ:
_pp_rescale(p)
end
end
_pp_next_context(p)
end
func _pp_update1_0(p &: _Ppmd):
p.prev_success = 2 * _pp_freq(p, p.found) > _pp_sf(p, p.min_ctx) ? 1 : 0
p.run_length += p.prev_success
_pp_s16(p, p.min_ctx + 2, _pp_sf(p, p.min_ctx) + 4)
nf := _pp_freq(p, p.found) + 4
_pp_set_freq(p, p.found, nf)
if nf > _PP_MAX_FREQ:
_pp_rescale(p)
end
_pp_next_context(p)
end
func _pp_update_bin(p &: _Ppmd):
f := _pp_freq(p, p.found)
_pp_set_freq(p, p.found, f + (f < 128 ? 1 : 0))
p.prev_success = 1
p.run_length++
_pp_next_context(p)
end
func _pp_update2(p &: _Ppmd):
_pp_s16(p, p.min_ctx + 2, _pp_sf(p, p.min_ctx) + 4)
nf := _pp_freq(p, p.found) + 4
_pp_set_freq(p, p.found, nf)
if nf > _PP_MAX_FREQ:
_pp_rescale(p)
end
p.run_length = p.init_rl
_pp_update_model(p)
end
func _pp_byte(b &: _RarBits): i64:
byte := b.pos >> 3
b.pos = (byte + 1) * 8
if byte < b.n:
ret b.p[byte] as i64
end
ret 0
end
func _pp_rc_init(p &: _Ppmd, b &: _RarBits):
p.rc_code = 0 as i64
p.rc_low = 0 as i64
p.rc_range = 0xffffffff as i64
repeat 4:
p.rc_code = ((p.rc_code << 8) | _pp_byte(b)) & 0xffffffff
end
end
func _pp_rc_norm(p &: _Ppmd, b &: _RarBits):
if p.rc7z:
repeat 2:
if p.rc_range < 0x1000000:
p.rc_code = ((p.rc_code << 8) | _pp_byte(b)) & 0xffffffff
p.rc_range = (p.rc_range << 8) & 0xffffffff
end
end
ret
end
until true:
if ((p.rc_low ^ ((p.rc_low + p.rc_range) & 0xffffffff)) & 0xffffffff) >= 0x1000000:
if p.rc_range >= 0x8000:
break
end
p.rc_range = (0 - p.rc_low) & 0x7fff
end
p.rc_code = ((p.rc_code << 8) | _pp_byte(b)) & 0xffffffff
p.rc_range = (p.rc_range << 8) & 0xffffffff
p.rc_low = (p.rc_low << 8) & 0xffffffff
end
end
func _pp_rc_threshold(p &: _Ppmd, total: int): int:
p.rc_range /= (total as i64)
if p.rc_range == 0:
ret 0x7fffffff
end
ret (((p.rc_code - p.rc_low) & 0xffffffff) / p.rc_range) as int
end
func _pp_rc_decode(p &: _Ppmd, b &: _RarBits, start: int, size: int):
if p.rc7z:
p.rc_code = (p.rc_code - (start as i64) * p.rc_range) & 0xffffffff
p.rc_range = (p.rc_range * (size as i64)) & 0xffffffff
_pp_rc_norm(p, b)
ret
end
p.rc_low = (p.rc_low + (start as i64) * p.rc_range) & 0xffffffff
p.rc_range = (p.rc_range * (size as i64)) & 0xffffffff
_pp_rc_norm(p, b)
end
func _pp_see_update(p &: _Ppmd, see: int):
if (p.see_shift[see] as int) < _PP_PERIOD_BITS:
p.see_count[see] = ((p.see_count[see] as int) - 1) as u8
if (p.see_count[see] as int) == 0:
p.see_summ[see] = (((p.see_summ[see] as int) << 1) & 0xffff) as u16
sh := p.see_shift[see] as int
p.see_count[see] = ((3 << sh) & 255) as u8
p.see_shift[see] = (sh + 1) as u8
end
end
end
func _pp_decode(p &: _Ppmd, b &: _RarBits): int:
if _pp_ns(p, p.min_ctx) != 1:
mut s := _pp_stats(p, p.min_ctx)
sf := _pp_sf(p, p.min_ctx)
count := _pp_rc_threshold(p, sf)
mut hi_cnt := _pp_freq(p, s)
if count < hi_cnt:
_pp_rc_decode(p, b, 0, hi_cnt)
p.found = s
sym := _pp_sym(p, s)
_pp_update1_0(p)
ret sym
end
p.prev_success = 0
mut i := _pp_ns(p, p.min_ctx) - 1
until true:
s += 6
hi_cnt += _pp_freq(p, s)
if hi_cnt > count:
_pp_rc_decode(p, b, hi_cnt - _pp_freq(p, s), _pp_freq(p, s))
p.found = s
sym := _pp_sym(p, s)
_pp_update1(p)
ret sym
end
i--
if i == 0:
break
end
end
if count >= sf:
ret -2
end
p.hi_bits = p.hb2f[_pp_sym(p, p.found)] as int
_pp_rc_decode(p, b, hi_cnt, sf - hi_cnt)
repeat 256 in k:
p.mask[k] = 255 as u8
end
p.mask[_pp_sym(p, s)] = 0 as u8
mut j := _pp_ns(p, p.min_ctx) - 1
until true:
s -= 6
p.mask[_pp_sym(p, s)] = 0 as u8
j--
if j == 0:
break
end
end
else:
os := p.min_ctx + 2
suf := _pp_suffix(p, p.min_ctx)
p.hi_bits = p.hb2f[_pp_sym(p, p.found)] as int
idx := (_pp_freq(p, os) - 1) * 64 + p.prev_success + (p.ns2bs[_pp_ns(p, suf) - 1] as int) + p.hi_bits + 2 * (p.hb2f[_pp_sym(p, os)] as int) + ((p.run_length >> 26) & 0x20)
prob := p.bin_summ[idx] as int
r := p.rc_range >> 14
nb := r * (prob as i64)
mut zero := ((p.rc_code - p.rc_low) & 0xffffffff) < nb
if p.rc7z:
zero = p.rc_code < nb
end
if zero:
p.rc_range = nb
_pp_rc_norm(p, b)
p.bin_summ[idx] = (prob + 128 - ((prob + 32) >> 7)) as u16
p.found = os
sym := _pp_sym(p, os)
_pp_update_bin(p)
ret sym
end
if p.rc7z:
p.rc_code -= nb
p.rc_range -= nb
else:
p.rc_low = (p.rc_low + nb) & 0xffffffff
p.rc_range = (r * ((16384 - prob) as i64)) & 0xffffffff
end
_pp_rc_norm(p, b)
np := prob - ((prob + 32) >> 7)
p.bin_summ[idx] = np as u16
p.init_esc = _PP_EXP_ESCAPE[np >> 10]
repeat 256 in k:
p.mask[k] = 255 as u8
end
p.mask[_pp_sym(p, os)] = 0 as u8
p.prev_success = 0
end
until true:
num_masked := _pp_ns(p, p.min_ctx)
until true:
p.order_fall++
suf2 := _pp_suffix(p, p.min_ctx)
if suf2 == 0:
ret -1
end
p.min_ctx = suf2
if _pp_ns(p, p.min_ctx) != num_masked:
break
end
end
mut hi_cnt := 0
mut s := _pp_stats(p, p.min_ctx)
mut i := 0
num := _pp_ns(p, p.min_ctx) - num_masked
until i != num:
if p.mask[_pp_sym(p, s)] != 0:
hi_cnt += _pp_freq(p, s)
p.ps[i] = s
i++
end
s += 6
end
mut freq_sum := 0
see := _pp_make_esc_freq(p, num_masked, freq_sum)
freq_sum += hi_cnt
count := _pp_rc_threshold(p, freq_sum)
if count < hi_cnt:
mut k := 0
mut acc := 0
until true:
acc += _pp_freq(p, p.ps[k])
if acc > count:
break
end
k++
end
s = p.ps[k]
_pp_rc_decode(p, b, acc - _pp_freq(p, s), _pp_freq(p, s))
_pp_see_update(p, see)
p.found = s
sym := _pp_sym(p, s)
_pp_update2(p)
ret sym
end
if count >= freq_sum:
ret -2
end
_pp_rc_decode(p, b, hi_cnt, freq_sum - hi_cnt)
p.see_summ[see] = (((p.see_summ[see] as int) + freq_sum) & 0xffff) as u16
repeat num in m:
p.mask[_pp_sym(p, p.ps[m])] = 0 as u8
end
end
end
package archive
import compress
import mem
struct _RarSrc:
pub mem: u8*
pub total: i64
pub paths: Vector<str>
pub fps: Vector<i64>
pub pvol: Vector<int>
pub poff: Vector<i64>
pub plen: Vector<i64>
pub aes_on: bool
pub aes: _Aes
pub iv: u8*
pub raw: u8*
pub rawcap: int
pub out: u8*
pub outcap: int
end
func _rsrc_blank_aes(): _Aes:
ret _Aes { rk = null, rounds = 0, m9 = null, m11 = null, m13 = null, m14 = null }
end
func _rsrc_mem(p: u8*, n: int): _RarSrc:
ret _RarSrc {
mem = p
total = n as i64
paths = Vector {} as Vector<str> fps = Vector {} as Vector<i64> pvol = Vector {} as Vector<int> poff = Vector {} as Vector<i64> plen = Vector {} as Vector<i64> aes_on = false
aes = _rsrc_blank_aes()
iv = null
raw = null
rawcap = 0
out = null
outcap = 0
}
end
func _rsrc_files(paths: Vector<str>): _RarSrc:
mut s := _rsrc_mem(null, 0)
repeat paths.len() in i:
s.paths.push(paths.get(i))
s.fps.push(0 as i64)
end
ret s
end
func _rsrc_add(s &: _RarSrc, vol: int, off: i64, len: i64):
s.pvol.push(vol)
s.poff.push(off)
s.plen.push(len)
s.total += len
end
func _rsrc_encrypt(s &: _RarSrc, key: u8*, klen: int, iv: u8*):
if s.aes_on:
_aes_free(s.aes)
end
s.aes = _aes_new(key, klen)
s.aes_on = true
s.iv = iv
end
func _rsrc_free(s &: _RarSrc):
repeat s.fps.len() in i:
fp := s.fps.get(i)
if fp != (0 as i64):
compress.FileClose(fp as void*)
end
end
s.fps.free()
s.paths.free()
s.pvol.free()
s.poff.free()
s.plen.free()
if s.aes_on:
_aes_free(s.aes)
s.aes_on = false
end
mem.Free(s.raw as void*)
mem.Free(s.out as void*)
s.raw = null
s.out = null
end
func _rsrc_fp(s &: _RarSrc, vi: int): void*:
if vi < 0 or vi >= s.fps.len():
ret null
end
cur := s.fps.get(vi)
if cur != (0 as i64):
ret cur as void*
end
fp := compress.FileOpenRead(s.paths.get(vi))
s.fps.set(vi, fp as i64)
ret fp
end
func _rsrc_raw(s &: _RarSrc, pos: i64, dst: u8*, n: int): bool:
if n <= 0:
ret true
end
if pos < (0 as i64) or pos + (n as i64) > s.total:
ret false
end
if s.mem != null:
mem.Copy(dst as void*, ((s.mem as i64) + pos) as void*, n as u64)
ret true
end
mut at := pos
mut done := 0
mut cum := 0 as i64
mut k := 0
until k < s.plen.len() and done < n:
pl := s.plen.get(k)
if at < cum + pl:
inside := at - cum
mut take := pl - inside
if take > ((n - done) as i64):
take = (n - done) as i64
end
fp := _rsrc_fp(s, s.pvol.get(k))
if fp == null:
ret false
end
got := compress.FileReadAt(fp, s.poff.get(k) + inside, ((dst as i64) + (done as i64)) as void*, take as int)
if (got as i64) != take:
ret false
end
done += take as int
at += take
end
cum += pl
k++
end
ret done == n
end
func _rsrc_get(s &: _RarSrc, pos: i64, n: int): u8*:
if n <= 0:
ret s.mem != null ? ((s.mem as i64) + pos) as u8* : s.out
end
if not s.aes_on and s.mem != null:
if pos < (0 as i64) or pos + (n as i64) > s.total:
ret null
end
ret ((s.mem as i64) + pos) as u8*
end
if not s.aes_on:
if s.outcap < n + 16:
mem.Free(s.out as void*)
s.out = mem.AllocateZeroed((n + 16) as u64) as u8*
s.outcap = n + 16
end
if s.out == null or not _rsrc_raw(s, pos, s.out, n):
ret null
end
ret s.out
end
a0 := pos & (~(15 as i64))
e0 := (pos + (n as i64) + (15 as i64)) & (~(15 as i64))
if e0 > (s.total & (~(15 as i64))):
ret null
end
lead := a0 > (0 as i64) ? 16 : 0
rn := (e0 - a0) as int + lead
if s.rawcap < rn + 16:
mem.Free(s.raw as void*)
s.raw = mem.AllocateZeroed((rn + 16) as u64) as u8*
s.rawcap = rn + 16
end
if s.outcap < rn + 16:
mem.Free(s.out as void*)
s.out = mem.AllocateZeroed((rn + 16) as u64) as u8*
s.outcap = rn + 16
end
if s.raw == null or s.out == null:
ret null
end
if not _rsrc_raw(s, a0 - (lead as i64), s.raw, rn):
ret null
end
if lead == 0:
_aes_cbc_decrypt(s.aes, s.iv, s.raw, s.out, rn)
else:
_aes_cbc_decrypt(s.aes, s.raw, _poff(s.raw, 16), s.out, rn - 16)
end
ret _poff(s.out, (pos - a0) as int)
end
package archive
import compress
import crypto
import filepath
import mem
import os
import str
@en "SEVENZIP_OK"
@fa "هفت زد موفق"
pub const SEVENZIP_OK := 0
@en "SEVENZIP_NOT_FOUND"
@fa "هفت زد یافت نشد"
pub const SEVENZIP_NOT_FOUND := 1
@en "SEVENZIP_UNSUPPORTED"
@fa "هفت زد پشتیبانی نمی شود"
pub const SEVENZIP_UNSUPPORTED := 2
@en "SEVENZIP_ENCRYPTED"
@fa "هفت زد رمزگذاری شده"
pub const SEVENZIP_ENCRYPTED := 3
@en "SEVENZIP_CORRUPT"
@fa "هفت زد خراب"
pub const SEVENZIP_CORRUPT := 4
@en "SEVENZIP_BAD_CRC"
@fa "هفت زد چک جمع ناهمخوان"
pub const SEVENZIP_BAD_CRC := 5
@en "SEVENZIP_TOO_BIG"
@fa "هفت زد بیش از حد بزرگ"
pub const SEVENZIP_TOO_BIG := 6
@en "SEVENZIP_UNSAFE_PATH"
@fa "هفت زد مسیر ناامن"
pub const SEVENZIP_UNSAFE_PATH := 7
@en "SEVENZIP_BAD_PASSWORD"
@fa "هفت زد گذرواژه اشتباه"
pub const SEVENZIP_BAD_PASSWORD := 8
@en "SEVENZIP_IO"
@fa "هفت زد خطای پرونده"
pub const SEVENZIP_IO := 10
struct _SzIn:
pub p: u8*
pub n: int
pub buf: compress.ByteBuf
pub owned: bool
end
@en "SevenZipArchive"
@fa "بایگانی هفت زد"
pub struct SevenZipArchive:
@en "data"
@fa "داده"
pub data: void* = null
@en "len"
@fa "طول"
pub len: int = 0
@en "password"
@fa "گذرواژه"
pub password: str = ""
@en "status"
@fa "وضعیت"
pub status: int = 0
@en "own"
@fa "حافظه خودی"
pub own: void* = null
end
func _sz_is(p: void*, n: int): bool:
if n < 6:
ret false
end
b := p as u8*
ret (b[0] as int) == 55 and (b[1] as int) == 122 and (b[2] as int) == 188 and (b[3] as int) == 175 and (b[4] as int) == 39 and (b[5] as int) == 28
end
func _sz_le32(p: u8*, off: int): i64:
ret (p[off] as i64) | ((p[off + 1] as i64) << 8) | ((p[off + 2] as i64) << 16) | ((p[off + 3] as i64) << 24)
end
func _sz_le64(p: u8*, off: int): i64:
ret _sz_le32(p, off) | (_sz_le32(p, off + 4) << 32)
end
func _sz_pack_offset(s: _Sz, idx: int): i64:
ret s.pack_off.get(idx)
end
func _sz_aes_key(password: str, salt: u8*, saltlen: int, cycles: int, key: u8*):
mut pw := _rar_pw_utf16(password)
if cycles == 63:
repeat 32 in i:
key[i] = 0 as u8
end
mut k := 0
repeat saltlen in i:
if k < 32:
key[k] = salt[i]
k++
end
end
repeat pw.len in i:
if k < 32:
key[k] = (compress.BufGet(pw, i)) as u8
k++
end
end
compress.BufFree(pw)
ret
end
mut h := crypto.Sha256New()
count := (1 as i64) << cycles
mut ctr := 0 as i64
cb := mem.AllocateZeroed(8 as u64) as u8*
until ctr < count:
repeat 8 in i:
cb[i] = ((ctr >> (8 * i)) & 255) as u8
end
crypto.Sha256Update(h, salt as void*, saltlen)
crypto.Sha256Update(h, pw.data, pw.len)
crypto.Sha256Update(h, cb as void*, 8)
ctr++
end
crypto.Sha256Final(h, key as void*)
mem.Free(cb as void*)
compress.BufFree(pw)
end
func _sz_aes_setup(c: _SzCoder, password: str, key: u8*, iv: u8*, status &: int): bool:
pr := c.props
if pr.len < 1:
status = SEVENZIP_CORRUPT
ret false
end
if password.len() == 0:
status = SEVENZIP_ENCRYPTED
ret false
end
pp := pr.data as u8*
b0 := pp[0] as int
mut b1 := 0
if pr.len >= 2:
b1 = pp[1] as int
end
ivsize := ((b0 >> 6) & 1) + (b1 & 15)
saltsize := ((b0 >> 7) & 1) + (b1 >> 4)
if 2 + saltsize + ivsize > pr.len or ivsize > 16:
status = SEVENZIP_CORRUPT
ret false
end
if (b0 & 63) > 24 and (b0 & 63) != 63:
status = SEVENZIP_UNSUPPORTED
ret false
end
repeat ivsize in i:
iv[i] = pp[2 + saltsize + i]
end
salt := ((pr.data as i64) + 2) as u8*
_sz_aes_key(password, salt, saltsize, b0 & 63, key)
ret true
end
func _sz_decrypt(c: _SzCoder, inp: _SzIn, out_size: int, password: str, status &: int): compress.ByteBuf:
mut out := compress.NewByteBuf()
key := mem.AllocateZeroed(32 as u64) as u8*
iv := mem.AllocateZeroed(16 as u64) as u8*
if not _sz_aes_setup(c, password, key, iv, status):
mem.Free(key as void*)
mem.Free(iv as void*)
ret out
end
n16 := inp.n & (-16)
if n16 < out_size or out_size < 0:
status = SEVENZIP_CORRUPT
mem.Free(key as void*)
mem.Free(iv as void*)
ret out
end
mut aes := _aes_new(key, 32)
dst := mem.AllocateZeroed((n16 + 16) as u64) as u8*
_aes_cbc_decrypt(aes, iv, inp.p, dst, n16)
_aes_free(aes)
mem.Free(key as void*)
mem.Free(iv as void*)
compress.BufPushBytes(out, dst as void*, out_size)
mem.Free(dst as void*)
ret out
end
func _sz_ppmd(c: _SzCoder, inp: _SzIn, out_size: int, status &: int): compress.ByteBuf:
mut out := compress.NewByteBufCap(out_size > 16777216 ? 16777216 : out_size)
pr := c.props
if pr.len < 5 or inp.n < 5:
status = SEVENZIP_CORRUPT
ret out
end
pp := pr.data as u8*
order := pp[0] as int
msize := _sz_le32(pp, 1)
if order < 2 or order > 64 or msize < (2048 as i64) or msize > (1073741824 as i64):
status = SEVENZIP_UNSUPPORTED
ret out
end
mut m := _pp_new()
m.rc7z = true
if not _pp_alloc(m, msize as int):
_pp_free(m)
status = SEVENZIP_TOO_BIG
ret out
end
_pp_init(m, order)
mut b := _RarBits { p = inp.p, n = inp.n, pos = 0 }
if _pp_byte(b) != (0 as i64):
_pp_free(m)
status = SEVENZIP_CORRUPT
ret out
end
_pp_rc_init(m, b)
mut i := 0
until i < out_size:
sym := _pp_decode(m, b)
if sym < 0:
status = SEVENZIP_CORRUPT
break
end
compress.BufPush(out, sym)
i++
end
_pp_free(m)
ret out
end
func _sz_bcj_kind(id: i64): int:
if id == (4 as i64) or id == (0x03030103 as i64):
ret compress.BcjX86
end
if id == (5 as i64) or id == (0x03030205 as i64):
ret compress.BcjPowerPC
end
if id == (6 as i64) or id == (0x03030401 as i64):
ret compress.BcjIA64
end
if id == (7 as i64) or id == (0x03030501 as i64):
ret compress.BcjARM
end
if id == (8 as i64) or id == (0x03030701 as i64):
ret compress.BcjARMThumb
end
if id == (9 as i64) or id == (0x03030805 as i64):
ret compress.BcjSPARC
end
if id == (10 as i64):
ret compress.BcjARM64
end
if id == (11 as i64):
ret compress.BcjRISCV
end
ret 0
end
func _sz_coder_run(c: _SzCoder, inp: _SzIn, out_size: int, password: str, status &: int): compress.ByteBuf:
mut ok := false
mut out := compress.NewByteBuf()
id := c.id
pr := c.props
pp := pr.data as u8*
if id == (0 as i64):
if inp.n != out_size:
status = SEVENZIP_CORRUPT
ret out
end
compress.BufPushBytes(out, inp.p as void*, inp.n)
ret out
end
if id == (0x21 as i64):
if pr.len < 1:
status = SEVENZIP_CORRUPT
ret out
end
out = compress.Lzma2RawDecompress(pp[0] as int, inp.p as void*, inp.n, out_size, out_size, ok)
else id == (0x030101 as i64):
if pr.len < 5:
status = SEVENZIP_CORRUPT
ret out
end
out = compress.LzmaRawDecompress(pr.data, pr.len, inp.p as void*, inp.n, out_size, out_size, ok)
else id == (0x040202 as i64):
out = compress.Bzip2DecompressMax(inp.p as void*, inp.n, out_size, ok)
if ok and out.len != out_size:
ok = false
end
else id == (0x040108 as i64):
out = compress.RawInflateMax(inp.p as void*, inp.n, out_size, out_size, ok)
if ok and out.len != out_size:
ok = false
end
else id == (0x040109 as i64):
out = compress.RawInflate64Max(inp.p as void*, inp.n, out_size, out_size, ok)
if ok and out.len != out_size:
ok = false
end
else id == (0x020302 as i64) or id == (0x020304 as i64):
if inp.n != out_size:
status = SEVENZIP_CORRUPT
ret out
end
compress.BufPushBytes(out, inp.p as void*, inp.n)
ok = compress.SwapDecode(out.data, out.len, id == (0x020302 as i64) ? 2 : 4)
else id == (0x06F10701 as i64):
out = _sz_decrypt(c, inp, out_size, password, status)
ok = status == SEVENZIP_OK
if not ok:
ret out
end
else id == (0x030401 as i64):
out = _sz_ppmd(c, inp, out_size, status)
ok = status == SEVENZIP_OK
if not ok:
compress.BufFree(out)
ret compress.NewByteBuf()
end
else id == (3 as i64):
if inp.n != out_size or pr.len < 1:
status = SEVENZIP_CORRUPT
ret out
end
compress.BufPushBytes(out, inp.p as void*, inp.n)
compress.DeltaDecode(out.data, out.len, (pp[0] as int) + 1)
ok = true
else:
kind := _sz_bcj_kind(id)
if kind == 0:
status = SEVENZIP_UNSUPPORTED
ret out
end
if inp.n != out_size:
status = SEVENZIP_CORRUPT
ret out
end
compress.BufPushBytes(out, inp.p as void*, inp.n)
mut start := 0
if pr.len == 4:
start = _sz_le32(pp, 0) as int
end
compress.BcjDecode(kind, out.data, out.len, start)
ok = true
end
if not ok:
compress.BufFree(out)
out = compress.NewByteBuf()
status = SEVENZIP_CORRUPT
end
ret out
end
func _szin_free(inp: _SzIn):
if inp.owned:
compress.BufFree(inp.buf)
end
end
func _sz_input_of(s: _Sz, base: u8*, n: i64, fi: int, in_idx: int, password: str, depth: int, status &: int, inp &: _SzIn): bool:
f := s.folders.get(fi)
repeat f.bin.len() in k:
if f.bin.get(k) == in_idx:
inp.buf = _sz_stream_out(s, base, n, fi, f.bout.get(k), password, depth + 1, status)
if status != SEVENZIP_OK:
compress.BufFree(inp.buf)
ret false
end
inp.p = inp.buf.data as u8*
inp.n = inp.buf.len
inp.owned = true
ret true
end
end
repeat f.packed.len() in j:
if f.packed.get(j) == in_idx:
pidx := f.pack_first + j
if pidx >= s.pack_sizes.len():
status = SEVENZIP_CORRUPT
ret false
end
off := _sz_pack_offset(s, pidx)
sz := s.pack_sizes.get(pidx)
if off < (32 as i64) or sz < (0 as i64) or off + sz > n:
status = SEVENZIP_CORRUPT
ret false
end
inp.p = ((base as i64) + off) as u8*
inp.n = sz as int
ret true
end
end
status = SEVENZIP_CORRUPT
ret false
end
func _sz_stream_out(s: _Sz, base: u8*, n: i64, fi: int, out_idx: int, password: str, depth: int, status &: int): compress.ByteBuf:
f := s.folders.get(fi)
if depth > f.coders.len() or out_idx >= f.coders.len() or out_idx >= f.unpack.len():
status = SEVENZIP_CORRUPT
ret compress.NewByteBuf()
end
out_size := f.unpack.get(out_idx)
if out_size < (0 as i64) or out_size > (2147483000 as i64):
status = SEVENZIP_TOO_BIG
ret compress.NewByteBuf()
end
c := f.coders.get(out_idx)
mut first_in := 0
repeat out_idx in q:
first_in += f.coders.get(q).num_in
end
if c.id == (0x0303011B as i64):
if c.num_in != 4:
status = SEVENZIP_CORRUPT
ret compress.NewByteBuf()
end
mut ins := Vector {} as Vector<_SzIn>
mut good := true
repeat 4 in q:
if good:
mut one := _SzIn { p = null as u8*, n = 0, buf = compress.NewByteBuf(), owned = false }
if _sz_input_of(s, base, n, fi, first_in + q, password, depth, status, one):
ins.push(one)
else:
good = false
end
end
end
mut res := compress.NewByteBuf()
if good:
res = _sz_bcj2(ins.get(0), ins.get(1), ins.get(2), ins.get(3), out_size as int, status)
end
repeat ins.len() in q:
_szin_free(ins.get(q))
end
ins.free()
ret res
end
if c.num_in != 1:
status = SEVENZIP_UNSUPPORTED
ret compress.NewByteBuf()
end
mut inp := _SzIn { p = null as u8*, n = 0, buf = compress.NewByteBuf(), owned = false }
if not _sz_input_of(s, base, n, fi, first_in, password, depth, status, inp):
ret compress.NewByteBuf()
end
out := _sz_coder_run(c, inp, out_size as int, password, status)
_szin_free(inp)
ret out
end
func _sz_has_aes(f: _SzFolder): bool:
repeat f.coders.len() in i:
if f.coders.get(i).id == (0x06F10701 as i64):
ret true
end
end
ret false
end
func _sz_unpack_folder(s: _Sz, base: u8*, n: i64, fi: int, password: str, status &: int): compress.ByteBuf:
status = SEVENZIP_OK
f := s.folders.get(fi)
repeat f.coders.len() in i:
c := f.coders.get(i)
if c.num_out != 1 or (c.num_in != 1 and not (c.num_in == 4 and c.id == (0x0303011B as i64))):
status = SEVENZIP_UNSUPPORTED
ret compress.NewByteBuf()
end
end
main := _sz_folder_main_out(f)
mut out := _sz_stream_out(s, base, n, fi, main, password, 0, status)
if status == SEVENZIP_OK and f.crc_def:
if (compress.CRC32(out.data, out.len) as i64) != f.crc:
status = SEVENZIP_BAD_CRC
end
end
if status != SEVENZIP_OK:
if _sz_has_aes(f) and (status == SEVENZIP_CORRUPT or status == SEVENZIP_BAD_CRC):
status = SEVENZIP_BAD_PASSWORD
end
compress.BufFree(out)
ret compress.NewByteBuf()
end
ret out
end
func _sz_parse_header(r &: _SzR, s &: _Sz): int:
until true:
id := _szr_byte(r)
if r.bad:
ret SEVENZIP_CORRUPT
end
if id == _SZ_END:
break
end
if id == _SZ_ARCHIVE_PROPS:
until true:
ty := _szr_num(r)
if r.bad:
ret SEVENZIP_CORRUPT
end
if ty == (0 as i64):
break
end
sz := _szr_count(r, _szr_left(r))
r.pos += sz
end
else id == _SZ_ADD_STREAMS:
mut tmp := _sz_new()
st := _sz_read_streams(r, tmp)
_sz_free(tmp)
if st != 0:
ret st
end
else id == _SZ_MAIN_STREAMS:
st := _sz_read_streams(r, s)
if st != 0:
ret st
end
else id == _SZ_FILES:
st := _sz_read_files(r, s)
if st != 0:
ret st
end
else:
ret SEVENZIP_CORRUPT
end
end
ret SEVENZIP_OK
end
func _sz_method(f: _SzFolder): int:
repeat f.coders.len() in i:
id := f.coders.get(i).id
if id == (0 as i64):
ret 0
end
if id == (0x030101 as i64):
ret 1
end
if id == (0x21 as i64):
ret 2
end
if id == (0x030401 as i64):
ret 3
end
if id == (0x040202 as i64):
ret 4
end
if id == (0x040108 as i64):
ret 5
end
if id == (0x040109 as i64):
ret 6
end
end
ret 9
end
func _sz_folder_packed(s: _Sz, fi: int): i64:
f := s.folders.get(fi)
mut t := 0 as i64
repeat f.packed.len() in j:
idx := f.pack_first + j
if idx < s.pack_sizes.len():
t += s.pack_sizes.get(idx)
end
end
ret t
end
func _sz_is_link(f: _SzFile): bool:
ret f.has_attr and (f.attr & 32768) != 0 and ((f.attr >> 16) & 0xF000) == 0xA000
end
func _sz_unix_mode(f: _SzFile): int:
if f.has_attr and (f.attr & 32768) != 0:
ret (f.attr >> 16) & 4095
end
ret -1
end
func _sz_make_entry(f: _SzFile, method: int, packed: i64, kind: int, mode: int, lnk: str): Entry:
ret Entry {
name = _rar_dup(f.name)
size = f.size
compressed_size = packed
is_dir = f.is_dir
method = method
crc32 = f.crc as u32
mtime = f.mtime
link = lnk
kind = kind
mode = mode
}
end
func _sz_find(s: _Sz, name: str): int:
repeat s.files.len() in i:
f := s.files.get(i)
if not f.anti and f.name == name:
ret i
end
end
ret -1
end
func _sz_apply_meta(f: _SzFile, path: str):
m := _sz_unix_mode(f)
if m >= 0:
_rar_set_mode(path, f.is_dir ? (m | 0x1c0) : m)
end
if f.mtime > (0 as i64):
_rar_set_mtime(path, f.mtime)
end
end
func _sz_start(p: void*, n: int): int:
if n < 32:
ret 0
end
b := p as u8*
if _sz_is(p, n):
ret 0
end
mut lim := n - 32
if lim > 8388608:
lim = 8388608
end
mut i := 1
until i <= lim:
if (b[i] as int) == 55 and (b[i + 1] as int) == 122 and (b[i + 2] as int) == 188 and (b[i + 3] as int) == 175 and (b[i + 4] as int) == 39 and (b[i + 5] as int) == 28 and (b[i + 6] as int) == 0:
if (compress.CRC32(((p as i64) + (i as i64) + 12) as void*, 20) as i64) == _sz_le32(b, i + 8):
ret i
end
end
i++
end
ret 0
end
func _sz_volume_path(first: str, idx: int): str:
n := first.len()
ds := _rar_digits_end(first, n)
if ds == n or n - ds > 9:
ret ""
end
width := n - ds
ns := str.Substr(first, ds, width)
num := str.ToInt(ns) + idx
_rar_free_name(ns)
mut digits := str.FromInt(num as i64)
until digits.len() < width:
grown := "0" + digits
_rar_free_name(digits)
digits = grown
end
head := str.Substr(first, 0, ds)
res := head + digits
_rar_free_name(head)
_rar_free_name(digits)
ret res
end
@en "IsSevenZip"
@fa "هفت زد است"
pub func IsSevenZip(p: void*, n: int): bool:
ret _sz_is(p, n)
end
@en "SevenZipStatusText"
@fa "متن وضعیت هفت زد"
pub func SevenZipStatusText(status: int): str:
if status == SEVENZIP_OK: ret ArchiveStatusText(ARCHIVE_OK) end
if status == SEVENZIP_NOT_FOUND: ret ArchiveStatusText(ARCHIVE_NOT_FOUND) end
if status == SEVENZIP_UNSUPPORTED: ret ArchiveStatusText(ARCHIVE_UNSUPPORTED) end
if status == SEVENZIP_ENCRYPTED: ret ArchiveStatusText(ARCHIVE_ENCRYPTED) end
if status == SEVENZIP_CORRUPT: ret ArchiveStatusText(ARCHIVE_CORRUPT) end
if status == SEVENZIP_BAD_CRC: ret ArchiveStatusText(ARCHIVE_BAD_CRC) end
if status == SEVENZIP_TOO_BIG: ret ArchiveStatusText(ARCHIVE_TOO_BIG) end
if status == SEVENZIP_UNSAFE_PATH: ret ArchiveStatusText(ARCHIVE_UNSAFE_PATH) end
if status == SEVENZIP_BAD_PASSWORD: ret ArchiveStatusText(ARCHIVE_BAD_PASSWORD) end
if status == SEVENZIP_IO: ret ArchiveStatusText(ARCHIVE_IO_ERROR) end
ret ArchiveStatusText(-1)
end
@en "SevenZipOpen"
@fa "بازکردن هفت زد"
pub func SevenZipOpen(p: void*, n: int, password: str): SevenZipArchive:
off := _sz_start(p, n)
ret SevenZipArchive { data = ((p as i64) + (off as i64)) as void*, len = n - off, password = password, status = SEVENZIP_OK }
end
@en "SevenZipReadVolumes"
@fa "خواندن بخش‌های هفت زد"
pub func SevenZipReadVolumes(first: str, ok &: bool): Vector<compress.ByteBuf>:
mut vols := Vector {} as Vector<compress.ByteBuf>
head := ReadBinaryFile(first, ok)
if not ok:
ret vols
end
vols.push(head)
mut idx := 1
until idx < 10000:
path := _sz_volume_path(first, idx)
if path.len() == 0:
break
end
if not os.Exists(path):
mem.Free(path as void*)
break
end
mut more_ok := false
part := ReadBinaryFile(path, more_ok)
mem.Free(path as void*)
if not more_ok:
break
end
vols.push(part)
idx++
end
ret vols
end
@en "SevenZipFreeVolumes"
@fa "آزادسازی بخش‌های هفت زد"
pub func SevenZipFreeVolumes(vols &: Vector<compress.ByteBuf>):
repeat vols.len() in i:
mut b := vols.get(i)
compress.BufFree(b)
end
vols.free()
end
@en "SevenZipOpenVolumes"
@fa "بازکردن بخش‌های هفت زد"
pub func SevenZipOpenVolumes(vols: Vector<compress.ByteBuf>, password: str): SevenZipArchive:
mut total := 0 as i64
repeat vols.len() in i:
total += vols.get(i).len as i64
end
if total > (1900000000 as i64):
ret SevenZipArchive { password = password, status = SEVENZIP_TOO_BIG }
end
mut joined := compress.NewByteBufCap(total as int)
repeat vols.len() in i:
v := vols.get(i)
compress.BufPushBytes(joined, v.data, v.len)
end
mut arc := SevenZipOpen(joined.data, joined.len, password)
arc.own = joined.data
ret arc
end
@en "SevenZipClose"
@fa "بستن هفت زد"
pub func SevenZipClose(arc &: SevenZipArchive):
if arc.own != null:
mem.Free(arc.own)
end
arc.own = null
arc.data = null
arc.len = 0
end
@en "SevenZipEntries"
@fa "مدخل‌های هفت زد"
pub func SevenZipEntries(arc &: SevenZipArchive): Vector<Entry>:
ret SevenZipEntriesOf(arc)
end
@en "SevenZipRead"
@fa "خواندن از هفت زد"
pub func SevenZipRead(arc &: SevenZipArchive, name: str, max: int): compress.ByteBuf:
ret SevenZipReadCap(arc, name, max as i64)
end
@en "SevenZipReadAll"
@fa "خواندن همه از هفت زد"
pub func SevenZipReadAll(arc &: SevenZipArchive, destdir: str): int:
ret SevenZipReadAllCap(arc, destdir, 0 as i64, 0 as i64)
end
@en "SevenZipListStatus"
@fa "فهرست هفت زد با وضعیت"
pub func SevenZipListStatus(p: void*, n: int, status &: int): Vector<Entry>:
mut arc := SevenZipOpen(p, n, "")
out := SevenZipEntries(arc)
status = arc.status
ret out
end
@en "SevenZipList"
@fa "فهرست هفت زد"
pub func SevenZipList(p: void*, n: int): Vector<Entry>:
mut st := 0
ret SevenZipListStatus(p, n, st)
end
@en "SevenZipExtract"
@fa "استخراج هفت زد"
pub func SevenZipExtract(p: void*, n: int, name: str, max: int, status &: int): compress.ByteBuf:
mut arc := SevenZipOpen(p, n, "")
out := SevenZipRead(arc, name, max)
status = arc.status
ret out
end
@en "SevenZipExtractByNameMax"
@fa "استخراج با نام از هفت زد با سقف"
pub func SevenZipExtractByNameMax(p: void*, n: int, name: str, max: int, ok &: bool): compress.ByteBuf:
mut st := 0
out := SevenZipExtract(p, n, name, max, st)
ok = st == SEVENZIP_OK
ret out
end
@en "SevenZipExtractByName"
@fa "استخراج با نام از هفت زد"
pub func SevenZipExtractByName(p: void*, n: int, name: str, ok &: bool): compress.ByteBuf:
ret SevenZipExtractByNameMax(p, n, name, 0, ok)
end
@en "SevenZipExtractAllStatus"
@fa "استخراج همه از هفت زد با وضعیت"
pub func SevenZipExtractAllStatus(p: void*, n: int, destdir: str, status &: int): int:
mut arc := SevenZipOpen(p, n, "")
extracted := SevenZipReadAll(arc, destdir)
status = arc.status
ret extracted
end
@en "SevenZipExtractAll"
@fa "استخراج همه از هفت زد"
pub func SevenZipExtractAll(p: void*, n: int, destdir: str): bool:
mut st := 0
_ := SevenZipExtractAllStatus(p, n, destdir, st)
ret st == SEVENZIP_OK
end
package archive
import compress
import mem
struct _SzSeq:
pub p: u8*
pub n: int
pub pos: int
pub fp: void*
pub off: i64
pub left: i64
pub buf: u8*
pub bad: bool
pub hold: compress.ByteBuf
end
struct _SzB2:
pub probs: i32*
pub code: i64
pub range: i64
pub o: i64
pub limit: i64
pub prev: int
pub ob: u8*
pub obn: int
pub call: _SzSeq*
pub jump: _SzSeq*
pub rc: _SzSeq*
pub bad: bool
end
func _szseq_mem(b: compress.ByteBuf): _SzSeq:
ret _SzSeq { p = b.data as u8*, n = b.len, pos = 0, fp = null, off = 0 as i64, left = 0 as i64, buf = null as u8*, bad = false, hold = b }
end
func _szseq_file(fp: void*, off: i64, len: i64): _SzSeq:
ret _SzSeq { p = null as u8*, n = 0, pos = 0, fp = fp, off = off, left = len, buf = mem.Allocate(65536 as u64) as u8*, bad = false, hold = compress.NewByteBuf() }
end
func _szseq_free(q: _SzSeq*):
compress.BufFree(q[0].hold)
if q[0].buf != null:
mem.Free(q[0].buf as void*)
end
mem.Free(q as void*)
end
func _szseq_byte(q: _SzSeq*): int:
if q[0].pos >= q[0].n:
if q[0].fp == null or q[0].left <= (0 as i64):
q[0].bad = true
ret 0
end
want := q[0].left > (65536 as i64) ? 65536 : (q[0].left as int)
got := compress.FileReadAt(q[0].fp, q[0].off, q[0].buf as void*, want)
if got <= 0:
q[0].bad = true
ret 0
end
q[0].off += got as i64
q[0].left -= got as i64
q[0].p = q[0].buf
q[0].n = got
q[0].pos = 0
end
v := q[0].p[q[0].pos] as int
q[0].pos++
ret v
end
func _szb2_new(limit: i64, call: _SzSeq*, jump: _SzSeq*, rc: _SzSeq*): _SzB2*:
d := mem.AllocateZeroed(sizeof(_SzB2)) as _SzB2*
d[0].probs = mem.AllocateZeroed(1032 as u64) as i32*
repeat 258 in i:
d[0].probs[i] = 1024 as i32
end
d[0].range = 0xFFFFFFFF as i64
d[0].limit = limit
d[0].ob = mem.Allocate(65536 as u64) as u8*
d[0].call = call
d[0].jump = jump
d[0].rc = rc
repeat 5:
d[0].code = ((d[0].code << 8) | (_szseq_byte(rc) as i64)) & 0xFFFFFFFF
end
d[0].bad = rc[0].bad
ret d
end
func _szb2_free(d: _SzB2*):
mem.Free(d[0].probs as void*)
mem.Free(d[0].ob as void*)
_szseq_free(d[0].call)
_szseq_free(d[0].jump)
_szseq_free(d[0].rc)
mem.Free(d as void*)
end
func _szb2_bit(d: _SzB2*, idx: int): int:
ttt := d[0].probs[idx] as i64
bound := (d[0].range >> 11) * ttt
mut bit := 0
if d[0].code < bound:
d[0].range = bound
d[0].probs[idx] = (ttt + ((2048 - ttt) >> 5)) as i32
else:
d[0].range -= bound
d[0].code -= bound
d[0].probs[idx] = (ttt - (ttt >> 5)) as i32
bit = 1
end
if d[0].range < 16777216:
d[0].range = (d[0].range << 8) & 0xFFFFFFFF
d[0].code = ((d[0].code << 8) | (_szseq_byte(d[0].rc) as i64)) & 0xFFFFFFFF
if d[0].rc[0].bad:
d[0].bad = true
end
end
ret bit
end
func _szb2_flush(d: _SzB2*, next: compress.FileSink*): bool:
if d[0].obn > 0:
n := d[0].obn
d[0].obn = 0
ret compress.SinkWrite(next[0], d[0].ob as void*, n)
end
ret true
end
func _szb2_feed(d: _SzB2*, p: u8*, n: int, next: compress.FileSink*): bool:
mut i := 0
until i < n and d[0].o < d[0].limit and not d[0].bad:
bb := p[i] as int
i++
d[0].ob[d[0].obn] = bb as u8
d[0].obn++
d[0].o++
prev := d[0].prev
hit := (bb & 0xFE) == 0xE8 or (prev == 0x0F and (bb & 0xF0) == 0x80)
if not hit:
d[0].prev = bb
else d[0].o < d[0].limit:
mut idx := 257
if bb == 0xE8:
idx = prev
else bb == 0xE9:
idx = 256
end
if _szb2_bit(d, idx) == 0:
d[0].prev = bb
else:
mut src := d[0].jump
if bb == 0xE8:
src = d[0].call
end
b0 := _szseq_byte(src) as i64
b1 := _szseq_byte(src) as i64
b2 := _szseq_byte(src) as i64
b3 := _szseq_byte(src) as i64
if src[0].bad:
d[0].bad = true
else:
v := (b0 << 24) | (b1 << 16) | (b2 << 8) | b3
dest := (v - (d[0].o + (4 as i64))) & 0xFFFFFFFF
repeat 4 in q:
if d[0].o < d[0].limit:
d[0].ob[d[0].obn] = ((dest >> (8 * q)) & 255) as u8
d[0].obn++
d[0].o++
end
end
d[0].prev = ((dest >> 24) & 255) as int
end
end
end
if d[0].obn >= 65000:
if not _szb2_flush(d, next):
ret false
end
end
end
if d[0].bad:
ret false
end
ret _szb2_flush(d, next)
end
func _szf_side(fp: void*, start: i64, avail: i64, s: _Sz, fi: int, in_idx: int, password: str, memcap: i64, depth: int, status &: int): _SzSeq*:
f := s.folders.get(fi)
mut nout := -1
mut pidx := -1
if not _szf_in_of(f, s, in_idx, nout, pidx):
status = SEVENZIP_CORRUPT
ret null as _SzSeq*
end
if nout < 0:
if not _szf_pack_ok(s, pidx, avail):
status = SEVENZIP_CORRUPT
ret null as _SzSeq*
end
q := mem.AllocateZeroed(sizeof(_SzSeq)) as _SzSeq*
q[0] = _szseq_file(fp, start + s.pack_off.get(pidx), s.pack_sizes.get(pidx))
ret q
end
if nout >= f.unpack.len():
status = SEVENZIP_CORRUPT
ret null as _SzSeq*
end
want := f.unpack.get(nout)
if want < (0 as i64):
status = SEVENZIP_CORRUPT
ret null as _SzSeq*
end
if want > (2147483000 as i64) or (memcap > (0 as i64) and want > memcap):
status = SEVENZIP_TOO_BIG
ret null as _SzSeq*
end
holder := mem.AllocateZeroed(sizeof(compress.ByteBuf)) as compress.ByteBuf*
holder[0] = compress.NewByteBufCap(want > (65536 as i64) ? 65536 : (want as int))
emit := (p: void*, n: int, c: void*): ret _szf_buf_emit(p, n, c) end
mut top := mem.AllocateZeroed(sizeof(compress.FileSink)) as compress.FileSink*
top[0] = compress.SinkCallback(0 as i64, emit, holder as void*)
st := _szf_stream(fp, start, avail, s, fi, nout, password, memcap, top, depth + 1)
mem.Free(top as void*)
if st != SEVENZIP_OK or holder[0].len != (want as int):
compress.BufFree(holder[0])
mem.Free(holder as void*)
status = st != SEVENZIP_OK ? st : SEVENZIP_CORRUPT
ret null as _SzSeq*
end
q := mem.AllocateZeroed(sizeof(_SzSeq)) as _SzSeq*
q[0] = _szseq_mem(holder[0])
mem.Free(holder as void*)
ret q
end
func _szf_b2_open(fp: void*, start: i64, avail: i64, s: _Sz, fi: int, ci: int, password: str, memcap: i64, depth: int, fs: _SzF*): int:
f := s.folders.get(fi)
first := _szf_first_in(f, ci)
mut st := SEVENZIP_OK
call := _szf_side(fp, start, avail, s, fi, first + 1, password, memcap, depth, st)
mut jump := null as _SzSeq*
mut rc := null as _SzSeq*
if st == SEVENZIP_OK:
jump = _szf_side(fp, start, avail, s, fi, first + 2, password, memcap, depth, st)
end
if st == SEVENZIP_OK:
rc = _szf_side(fp, start, avail, s, fi, first + 3, password, memcap, depth, st)
end
if st != SEVENZIP_OK:
if call != null:
_szseq_free(call)
end
if jump != null:
_szseq_free(jump)
end
if rc != null:
_szseq_free(rc)
end
ret st
end
fs[0].b2 = _szb2_new(f.unpack.get(ci), call, jump, rc) as void*
ret SEVENZIP_OK
end
package archive
import compress
import mem
func _bcj2_rc_byte(d: _SzIn, pos &: int, bad &: bool): i64:
if pos >= d.n:
bad = true
ret 0
end
v := d.p[pos] as i64
pos++
ret v
end
func _bcj2_bit(d: _SzIn, pos &: int, code &: i64, range &: i64, probs: i32*, idx: int, bad &: bool): int:
ttt := probs[idx] as i64
bound := (range >> 11) * ttt
mut bit := 0
if code < bound:
range = bound
probs[idx] = (ttt + ((2048 - ttt) >> 5)) as i32
else:
range -= bound
code -= bound
probs[idx] = (ttt - (ttt >> 5)) as i32
bit = 1
end
if range < 16777216:
range = (range << 8) & 0xFFFFFFFF
code = ((code << 8) | _bcj2_rc_byte(d, pos, bad)) & 0xFFFFFFFF
end
ret bit
end
func _sz_bcj2(a: _SzIn, b: _SzIn, c: _SzIn, d: _SzIn, out_size: int, status &: int): compress.ByteBuf:
mut out := compress.NewByteBufCap(out_size > 16777216 ? 16777216 : out_size)
if out_size == 0:
ret out
end
if d.n < 5:
status = SEVENZIP_CORRUPT
ret out
end
probs := mem.AllocateZeroed(1032 as u64) as i32*
repeat 258 in i:
probs[i] = 1024 as i32
end
mut code := 0 as i64
mut range := 0xFFFFFFFF as i64
mut rpos := 0
mut bad := false
repeat 5:
code = ((code << 8) | _bcj2_rc_byte(d, rpos, bad)) & 0xFFFFFFFF
end
mut ip := 0
mut bpos := 0
mut cpos := 0
mut o := 0
mut prev := 0
until o < out_size and not bad:
mut hit := false
until ip < a.n and o < out_size and not hit:
bb := a.p[ip] as int
compress.BufPush(out, bb)
o++
if (bb & 0xFE) == 0xE8 or (prev == 0x0F and (bb & 0xF0) == 0x80):
hit = true
else:
ip++
prev = bb
end
end
if not hit or o >= out_size:
break
end
bb := a.p[ip] as int
ip++
mut idx := 257
if bb == 0xE8:
idx = prev
else bb == 0xE9:
idx = 256
end
bit := _bcj2_bit(d, rpos, code, range, probs, idx, bad)
if bit == 0:
prev = bb
else:
mut src := b
mut sp := bpos
if bb != 0xE8:
src = c
sp = cpos
end
if sp + 4 > src.n:
status = SEVENZIP_CORRUPT
break
end
v := ((src.p[sp] as i64) << 24) | ((src.p[sp + 1] as i64) << 16) | ((src.p[sp + 2] as i64) << 8) | (src.p[sp + 3] as i64)
if bb == 0xE8:
bpos += 4
else:
cpos += 4
end
dest := (v - ((o as i64) + 4)) & 0xFFFFFFFF
repeat 4 in q:
if o < out_size:
compress.BufPush(out, ((dest >> (8 * q)) & 255) as int)
o++
end
end
prev = ((dest >> 24) & 255) as int
end
end
mem.Free(probs as void*)
if status == SEVENZIP_OK and (bad or o != out_size):
status = SEVENZIP_CORRUPT
end
if status != SEVENZIP_OK:
compress.BufFree(out)
ret compress.NewByteBuf()
end
ret out
end
package archive
import compress
import filepath
import mem
import os
import str
const _SZF_NOSTREAM := 99
struct _SzX:
pub fidx: Vector<int>
pub mode: Vector<int>
pub paths: Vector<str>
pub sizes: Vector<i64>
pub crcs: Vector<i64>
pub crc_def: Vector<bool>
pub res: Vector<int>
pub links: Vector<str>
pub names: Vector<str>
pub made: Vector<str>
pub cur: int
pub left: i64
pub began: bool
pub sink: compress.FileSink
pub capbuf: compress.ByteBuf
pub last: int
pub done: bool
pub err: int
pub fcrc: u32
pub fcrc_on: bool
pub got: compress.ByteBuf
end
struct _SzF:
pub kind: int
pub dist: int
pub hist: u8*
pub hp: int
pub carry: u8*
pub nc: int
pub tmp: u8*
pub tcap: int
pub bkind: int
pub b2: void*
pub err: int
pub bstate: int
pub bpos: i64
pub next: compress.FileSink*
end
struct _SzMem:
pub p: u8*
pub n: i64
end
@en "SevenZipFile"
@fa "پرونده هفت زد"
pub struct SevenZipFile:
@en "path"
@fa "مسیر"
pub path: str = ""
@en "size"
@fa "اندازه"
pub size: i64 = 0 as i64
@en "start"
@fa "آغاز"
pub start: i64 = 0 as i64
@en "password"
@fa "گذرواژه"
pub password: str = ""
@en "status"
@fa "وضعیت"
pub status: int = 0
@en "header"
@fa "سرایند"
pub hdr: compress.ByteBuf = compress.ByteBuf { data = null, len = 0, cap = 0 }
@en "volumes"
@fa "بخش ها"
pub volumes: Vector<str> = Vector {} as Vector<str>
pub memp: void* = null
pub memn: i64 = 0 as i64
end
func _szx_new(s: _Sz, fi: int, made: Vector<str>): _SzX:
mut x := _SzX {
fidx = Vector {} as Vector<int>, mode = Vector {} as Vector<int>, paths = Vector {} as Vector<str> sizes = Vector {} as Vector<i64>,
crcs = Vector {} as Vector<i64>, crc_def = Vector {} as Vector<bool> res = Vector {} as Vector<int>,
links = Vector {} as Vector<str>, names = Vector {} as Vector<str>, made = made
cur = 0, left = 0 as i64, began = false, sink = compress.FileSink {}, capbuf = compress.NewByteBuf()
last = -1, done = false, err = 0, fcrc = 0 as u32, fcrc_on = false, got = compress.NewByteBuf()
}
repeat s.files.len() in i:
f := s.files.get(i)
if f.anti or not f.has_stream or f.folder != fi or f.size <= (0 as i64):
continue
end
x.fidx.push(i)
x.mode.push(0)
x.paths.push("")
x.sizes.push(f.size)
x.crcs.push(f.crc)
x.crc_def.push(f.crc_def)
x.res.push(SEVENZIP_OK)
x.links.push("")
x.names.push(f.name)
end
ret x
end
func _szx_free(x &: _SzX):
x.fidx.free()
x.mode.free()
x.paths.free()
x.sizes.free()
x.crcs.free()
x.crc_def.free()
x.res.free()
repeat x.links.len() in k:
if x.links.get(k).len() > 0:
mem.Free(x.links.get(k) as void*)
end
end
x.links.free()
x.names.free()
compress.BufFree(x.capbuf)
end
func _szx_pos(x: _SzX, fileidx: int): int:
repeat x.fidx.len() in k:
if x.fidx.get(k) == fileidx:
ret k
end
end
ret -1
end
func _szx_begin(x: _SzX*):
i := x[0].cur
m := x[0].mode.get(i)
x[0].left = x[0].sizes.get(i)
x[0].began = true
compress.BufReset(x[0].capbuf)
if m == 1:
x[0].sink = compress.SinkOpen(x[0].paths.get(i), 0 as i64)
if x[0].sink.failed:
x[0].res.set(i, SEVENZIP_IO)
x[0].mode.set(i, 0)
end
else m >= 2:
x[0].sink = compress.FileSink {}
end
end
func _szx_end(x: _SzX*):
i := x[0].cur
m := x[0].mode.get(i)
if m != 0:
mut closed := true
if m == 1:
closed = compress.SinkClose(x[0].sink)
end
mut bad := not closed
if x[0].res.get(i) == SEVENZIP_OK and bad:
x[0].res.set(i, SEVENZIP_IO)
end
if x[0].crc_def.get(i) and (x[0].sink.crc as i64) != x[0].crcs.get(i):
bad = true
if x[0].res.get(i) == SEVENZIP_OK:
x[0].res.set(i, SEVENZIP_BAD_CRC)
end
end
if m == 1 and bad:
os.Remove(x[0].paths.get(i))
end
if not bad and m == 4:
x[0].got = x[0].capbuf
x[0].capbuf = compress.NewByteBuf()
end
if not bad and m >= 2 and m < 4:
tgt := compress.BufToStrUnsafe(x[0].capbuf)
if m == 3:
x[0].links.set(i, tgt)
else:
nm := x[0].names.get(i)
if not _rar_link_target_ok(nm, tgt, x[0].made):
x[0].res.set(i, SEVENZIP_UNSAFE_PATH)
else _rar_symlink(tgt, x[0].paths.get(i)):
x[0].made.push(_rar_dup(nm))
else:
x[0].res.set(i, SEVENZIP_UNSUPPORTED)
end
_rar_free_name(tgt)
end
end
end
x[0].cur = i + 1
x[0].left = 0 as i64
x[0].began = false
if x[0].cur > x[0].last:
x[0].done = true
end
end
func _szx_emit(x: _SzX*, p: void*, n: int): bool:
mut q := p as u8*
mut k := n
if x[0].fcrc_on:
x[0].fcrc = compress.CRC32Update(x[0].fcrc, p, n)
end
until k > 0:
if x[0].done:
ret false
end
if x[0].cur >= x[0].fidx.len():
ret true
end
if not x[0].began:
_szx_begin(x)
end
left := x[0].left
take := left < (k as i64) ? (left as int) : k
m := x[0].mode.get(x[0].cur)
if m != 0 and take > 0:
if not compress.SinkWrite(x[0].sink, q as void*, take):
x[0].res.set(x[0].cur, SEVENZIP_IO)
x[0].err = SEVENZIP_IO
ret false
end
if m >= 2:
compress.BufPushBytes(x[0].capbuf, q as void*, take)
end
end
x[0].left -= take as i64
q = ((q as i64) + (take as i64)) as u8*
k -= take
if x[0].left == (0 as i64):
_szx_end(x)
end
end
ret not x[0].done
end
func _szx_finish(x: _SzX*, st: int):
if x[0].began and x[0].cur < x[0].fidx.len():
i := x[0].cur
if x[0].mode.get(i) == 1:
compress.SinkClose(x[0].sink)
os.Remove(x[0].paths.get(i))
end
end
if st == SEVENZIP_OK:
ret
end
mut k := x[0].cur
until k < x[0].fidx.len():
if x[0].mode.get(k) != 0 and x[0].res.get(k) == SEVENZIP_OK:
x[0].res.set(k, st)
end
k++
end
end
func _szf_emit(f: _SzF*, p: void*, n: int): bool:
if n <= 0:
ret true
end
if f[0].kind == 1:
if f[0].tcap < n:
if f[0].tmp != null:
mem.Free(f[0].tmp as void*)
end
f[0].tmp = mem.Allocate(n as u64) as u8*
f[0].tcap = n
end
src := p as u8*
d := f[0].dist
mut hp := f[0].hp
repeat n in i:
v := (((src[i] as int) + (f[0].hist[(hp - d) & 255] as int)) & 255)
f[0].hist[hp & 255] = v as u8
f[0].tmp[i] = v as u8
hp++
end
f[0].hp = hp
ret compress.SinkWrite(f[0].next[0], f[0].tmp as void*, n)
end
if f[0].kind == 3:
total := f[0].nc + n
if f[0].tcap < total:
if f[0].tmp != null:
mem.Free(f[0].tmp as void*)
end
f[0].tmp = mem.Allocate(total as u64) as u8*
f[0].tcap = total
end
mem.Copy(f[0].tmp as void*, f[0].carry as void*, f[0].nc as u64)
mem.Copy(((f[0].tmp as i64) + (f[0].nc as i64)) as void*, p, n as u64)
done := compress.BcjStep(f[0].bkind, f[0].tmp as void*, total, f[0].bpos, f[0].bstate)
if done < 0 or total - done > 64:
ret false
end
f[0].bpos += done as i64
f[0].nc = total - done
mem.Copy(f[0].carry as void*, ((f[0].tmp as i64) + (done as i64)) as void*, f[0].nc as u64)
if done > 0:
ret compress.SinkWrite(f[0].next[0], f[0].tmp as void*, done)
end
ret true
end
if f[0].kind == 4:
d := f[0].b2 as _SzB2*
if not _szb2_feed(d, p as u8*, n, f[0].next):
if d[0].bad:
f[0].err = SEVENZIP_CORRUPT
end
ret false
end
ret true
end
w := f[0].dist
total := f[0].nc + n
if f[0].tcap < total:
if f[0].tmp != null:
mem.Free(f[0].tmp as void*)
end
f[0].tmp = mem.Allocate(total as u64) as u8*
f[0].tcap = total
end
repeat f[0].nc in i:
f[0].tmp[i] = f[0].carry[i]
end
mem.Copy(((f[0].tmp as i64) + (f[0].nc as i64)) as void*, p, n as u64)
full := total - (total % w)
if full > 0:
compress.SwapDecode(f[0].tmp as void*, full, w)
end
f[0].nc = total - full
repeat f[0].nc in i:
f[0].carry[i] = f[0].tmp[full + i]
end
if full > 0:
ret compress.SinkWrite(f[0].next[0], f[0].tmp as void*, full)
end
ret true
end
func _szf_finalize(f: _SzF*): bool:
if f[0].kind == 4:
d := f[0].b2 as _SzB2*
if d != null and (d[0].bad or d[0].o != d[0].limit):
f[0].err = SEVENZIP_CORRUPT
ret false
end
ret true
end
if (f[0].kind == 2 or f[0].kind == 3) and f[0].nc > 0:
n := f[0].nc
f[0].nc = 0
ret compress.SinkWrite(f[0].next[0], f[0].carry as void*, n)
end
ret true
end
func _szf_is_aes(id: i64): bool:
ret id == (0x06F10701 as i64)
end
func _szf_filter_kind(id: i64): int:
if id == (3 as i64):
ret 1
end
if id == (0x020302 as i64) or id == (0x020304 as i64):
ret 2
end
if _sz_bcj_kind(id) != 0:
ret 3
end
if id == (0x0303011B as i64):
ret 4
end
ret 0
end
func _szf_source_ok(id: i64): bool:
ret id == (0 as i64) or id == (0x030101 as i64) or id == (0x21 as i64) or id == (0x040108 as i64) or id == (0x040109 as i64) or id == (0x040202 as i64) or id == (0x030401 as i64)
end
func _szf_range(s: _Sz, f: _SzFolder, avail: i64, lo &: i64, hi &: i64): int:
lo = 0x7FFFFFFFFFFFFFF as i64
hi = 0 as i64
repeat f.packed.len() in j:
pidx := f.pack_first + j
if pidx >= s.pack_sizes.len():
ret SEVENZIP_CORRUPT
end
off := s.pack_off.get(pidx)
sz := s.pack_sizes.get(pidx)
if off < (32 as i64) or sz < (0 as i64) or off + sz > avail:
ret SEVENZIP_CORRUPT
end
if off < lo:
lo = off
end
if off + sz > hi:
hi = off + sz
end
end
if hi == (0 as i64):
lo = 32 as i64
hi = 32 as i64
end
ret SEVENZIP_OK
end
func _szf_region(fp: void*, start: i64, avail: i64, s: _Sz, f: _SzFolder, region &: compress.ByteBuf, vb &: i64, vn &: i64): int:
mut lo := 0 as i64
mut hi := 0 as i64
rs := _szf_range(s, f, avail, lo, hi)
if rs != SEVENZIP_OK:
ret rs
end
span := hi - lo
if span > (2000000000 as i64):
ret SEVENZIP_TOO_BIG
end
region = compress.NewByteBufCap(span as int)
if span > (0 as i64):
got := compress.FileReadAt(fp, start + lo, region.data, span as int)
if (got as i64) != span:
ret SEVENZIP_IO
end
end
region.len = span as int
vb = (region.data as i64) - lo
vn = hi
ret SEVENZIP_OK
end
func _szf_fallback(fp: void*, start: i64, avail: i64, s: _Sz, fi: int, password: str, memcap: i64, top: compress.FileSink*): int:
f := s.folders.get(fi)
if memcap > (0 as i64) and _sz_folder_packed(s, fi) > memcap:
ret SEVENZIP_TOO_BIG
end
mut region := compress.NewByteBuf()
mut vb := 0 as i64
mut vn := 0 as i64
mut st := _szf_region(fp, start, avail, s, f, region, vb, vn)
if st == SEVENZIP_OK:
mut out := _sz_unpack_folder(s, vb as u8*, vn, fi, password, st)
if st == SEVENZIP_OK:
if not compress.SinkWrite(top[0], out.data, out.len):
st = SEVENZIP_IO
end
end
compress.BufFree(out)
end
compress.BufFree(region)
ret st
end
func _szf_pack_ok(s: _Sz, pidx: int, avail: i64): bool:
if pidx < 0 or pidx >= s.pack_sizes.len():
ret false
end
off := s.pack_off.get(pidx)
sz := s.pack_sizes.get(pidx)
ret off >= (32 as i64) and sz >= (0 as i64) and off + sz <= avail
end
func _szf_in_of(f: _SzFolder, s: _Sz, in_idx: int, nout &: int, pidx &: int): bool:
nout = -1
pidx = -1
repeat f.bin.len() in k:
if f.bin.get(k) == in_idx:
nout = f.bout.get(k)
ret true
end
end
repeat f.packed.len() in j:
if f.packed.get(j) == in_idx:
pidx = f.pack_first + j
ret pidx < s.pack_sizes.len()
end
end
ret false
end
func _szf_first_in(f: _SzFolder, ci: int): int:
mut n := 0
repeat ci in q:
n += f.coders.get(q).num_in
end
ret n
end
func _szf_source(rfp: void*, roff: i64, rsz: i64, c: _SzCoder, out_size: i64, memcap: i64, sink &: compress.FileSink): int:
if out_size < (0 as i64) or rsz < (0 as i64):
ret SEVENZIP_CORRUPT
end
id := c.id
pp := c.props.data as u8*
mut code := 0
if id == (0 as i64):
if rsz != out_size:
ret SEVENZIP_CORRUPT
end
if not compress.SinkCopyFrom(sink, rfp, roff, rsz):
code = 3
end
else id == (0x21 as i64):
if c.props.len < 1:
ret SEVENZIP_CORRUPT
end
code = compress.Lzma2FileToSink(pp[0] as int, rfp, roff, rsz, out_size, sink, memcap)
else id == (0x030101 as i64):
if c.props.len < 5:
ret SEVENZIP_CORRUPT
end
code = compress.LzmaFileToSink(c.props.data, c.props.len, rfp, roff, rsz, out_size, sink, memcap)
else id == (0x040108 as i64) or id == (0x040109 as i64):
mut br := compress.NewFileBitReader(rfp, roff, rsz)
mut good := not br.bad
if good:
good = compress.RawInflateToSink(br, sink, id == (0x040109 as i64))
end
compress.FileBitReaderFree(br)
if not good:
code = sink.failed or sink.over ? 3 : 1
end
else id == (0x040202 as i64):
if memcap > (0 as i64):
hb := mem.AllocateZeroed(8 as u64) as u8*
hn := compress.FileReadAt(rfp, roff, hb as void*, 4)
level := hn == 4 ? (hb[3] as int) - 48 : 0
mem.Free(hb as void*)
if level >= 1 and level <= 9 and (level as i64) * (500000 as i64) > memcap:
ret SEVENZIP_TOO_BIG
end
end
if sink.cap == (0 as i64) and out_size > (0 as i64):
sink.cap = out_size
end
code = compress.Bzip2FileToSink(rfp, roff, rsz, sink)
else id == (0x030401 as i64):
pst := _szf_ppmd(rfp, roff, rsz, c, out_size, memcap, sink)
if pst != SEVENZIP_OK:
ret pst
end
else:
ret SEVENZIP_UNSUPPORTED
end
if code == 0:
if sink.written != out_size:
ret SEVENZIP_CORRUPT
end
ret SEVENZIP_OK
end
if code == 2:
ret SEVENZIP_TOO_BIG
end
if code == 3:
ret SEVENZIP_IO
end
ret SEVENZIP_CORRUPT
end
func _szf_stream(fp: void*, start: i64, avail: i64, s: _Sz, fi: int, out_start: int, password: str, memcap: i64, top: compress.FileSink*, depth: int): int:
f := s.folders.get(fi)
if depth > 8:
ret _SZF_NOSTREAM
end
femit := (p: void*, n: int, c: void*): ret _szf_emit(c as _SzF*, p, n) end
mut chain := Vector {} as Vector<int>
mut pidx := -1
mut out_idx := out_start
mut ok := true
until ok and pidx < 0:
if chain.len() > f.coders.len() or out_idx < 0 or out_idx >= f.coders.len() or out_idx >= f.unpack.len():
ok = false
break
end
c := f.coders.get(out_idx)
isb2 := c.id == (0x0303011B as i64) and c.num_in == 4
if (c.num_in != 1 and not isb2) or c.num_out != 1:
ok = false
break
end
chain.push(out_idx)
mut nout := -1
if not _szf_in_of(f, s, _szf_first_in(f, out_idx), nout, pidx):
ok = false
end
if nout >= 0:
out_idx = nout
end
end
mut sk := chain.len() - 1
if ok:
until sk > 0 and _szf_is_aes(f.coders.get(chain.get(sk)).id):
sk--
end
if not _szf_source_ok(f.coders.get(chain.get(sk)).id):
ok = false
end
repeat sk in k:
if _szf_filter_kind(f.coders.get(chain.get(k)).id) == 0:
ok = false
end
end
end
if not ok:
chain.free()
ret _SZF_NOSTREAM
end
mut st := SEVENZIP_OK
mut readers := Vector {} as Vector<i64>
mut rfp := fp
mut roff := start + s.pack_off.get(pidx)
mut rsz := s.pack_sizes.get(pidx)
if not _szf_pack_ok(s, pidx, avail):
st = SEVENZIP_CORRUPT
end
mut ak := chain.len() - 1
until st == SEVENZIP_OK and ak > sk:
ci := chain.get(ak)
osz := f.unpack.get(ci)
mut ast := SEVENZIP_OK
r := _szaes_open(rfp, roff, rsz, f.coders.get(ci), osz, password, ast)
if r == null:
st = ast
break
end
readers.push(r as i64)
rfp = r
roff = 0 as i64
rsz = osz
ak--
end
mut stages := Vector {} as Vector<i64>
mut sinks := Vector {} as Vector<i64>
mut nextp := top
if st == SEVENZIP_OK:
repeat sk in k:
c := f.coders.get(chain.get(k))
fk := _szf_filter_kind(c.id)
mut dist := 1
if fk == 1:
dist = 1
if c.props.len >= 1:
dist = ((c.props.data as u8*)[0] as int) + 1
end
else fk == 2:
dist = c.id == (0x020302 as i64) ? 2 : 4
end
fs := mem.AllocateZeroed(sizeof(_SzF)) as _SzF*
fs[0].kind = fk
if fk == 3:
fs[0].bkind = _sz_bcj_kind(c.id)
if c.props.len == 4:
fs[0].bpos = _sz_le32(c.props.data as u8*, 0)
end
end
fs[0].dist = dist
fs[0].hist = mem.AllocateZeroed(256 as u64) as u8*
fs[0].carry = mem.AllocateZeroed(64 as u64) as u8*
fs[0].next = nextp
ns := mem.AllocateZeroed(sizeof(compress.FileSink)) as compress.FileSink*
ns[0] = compress.SinkCallback(0 as i64, femit, fs as void*)
stages.push(fs as i64)
sinks.push(ns as i64)
nextp = ns
if fk == 4 and st == SEVENZIP_OK:
st = _szf_b2_open(fp, start, avail, s, fi, chain.get(k), password, memcap, depth, fs)
end
end
if st == SEVENZIP_OK:
st = _szf_source(rfp, roff, rsz, f.coders.get(chain.get(sk)), f.unpack.get(chain.get(sk)), memcap, nextp[0])
end
mut k := stages.len() - 1
until k >= 0:
fs := stages.get(k) as _SzF*
if st == SEVENZIP_OK and not _szf_finalize(fs):
st = SEVENZIP_IO
end
k--
end
repeat stages.len() in q:
fs := stages.get(q) as _SzF*
if fs[0].err != 0 and (st == SEVENZIP_OK or st == SEVENZIP_IO):
st = fs[0].err
end
end
end
repeat stages.len() in q:
fs := stages.get(q) as _SzF*
mem.Free(fs[0].hist as void*)
mem.Free(fs[0].carry as void*)
if fs[0].b2 != null:
_szb2_free(fs[0].b2 as _SzB2*)
end
if fs[0].tmp != null:
mem.Free(fs[0].tmp as void*)
end
mem.Free(fs as void*)
mem.Free(sinks.get(q) as void*)
end
stages.free()
sinks.free()
repeat readers.len() in q:
_szaes_free(readers.get(q) as void*)
end
readers.free()
chain.free()
ret st
end
func _szf_run(fp: void*, start: i64, avail: i64, s: _Sz, fi: int, password: str, memcap: i64, top: compress.FileSink*, x: _SzX*): int:
f := s.folders.get(fi)
mut st := _szf_stream(fp, start, avail, s, fi, _sz_folder_main_out(f), password, memcap, top, 0)
if st == _SZF_NOSTREAM:
st = _szf_fallback(fp, start, avail, s, fi, password, memcap, top)
if st == SEVENZIP_IO and x != null and x[0].done:
st = SEVENZIP_OK
end
ret st
end
if x != null:
if st == SEVENZIP_IO and x[0].done:
st = SEVENZIP_OK
end
if st == SEVENZIP_OK and f.crc_def and not x[0].done and (x[0].fcrc as i64) != f.crc:
st = SEVENZIP_BAD_CRC
end
if st == SEVENZIP_IO and x[0].err == 0 and not x[0].done:
st = SEVENZIP_CORRUPT
end
end
if _sz_has_aes(f) and (st == SEVENZIP_CORRUPT or st == SEVENZIP_BAD_CRC):
st = SEVENZIP_BAD_PASSWORD
end
ret st
end
func _szf_folder(fp: void*, start: i64, avail: i64, s: _Sz, fi: int, password: str, memcap: i64, x: _SzX*): int:
f := s.folders.get(fi)
xemit := (p: void*, n: int, c: void*): ret _szx_emit(c as _SzX*, p, n) end
mut top := mem.AllocateZeroed(sizeof(compress.FileSink)) as compress.FileSink*
top[0] = compress.SinkCallback(0 as i64, xemit, x as void*)
x[0].fcrc_on = f.crc_def
x[0].fcrc = 0 as u32
st := _szf_run(fp, start, avail, s, fi, password, memcap, top, x)
mem.Free(top as void*)
ret st
end
func _szf_buf_emit(p: void*, n: int, c: void*): bool:
compress.BufPushBytes((c as compress.ByteBuf*)[0], p, n)
ret true
end
func _szf_folder_buf(fp: void*, start: i64, avail: i64, s: _Sz, fi: int, password: str, cap: i64, out &: compress.ByteBuf): int:
f := s.folders.get(fi)
main := _sz_folder_main_out(f)
if main < 0 or main >= f.unpack.len():
ret SEVENZIP_CORRUPT
end
want := f.unpack.get(main)
if want < (0 as i64) or want > cap:
ret SEVENZIP_TOO_BIG
end
holder := mem.AllocateZeroed(sizeof(compress.ByteBuf)) as compress.ByteBuf*
holder[0] = compress.NewByteBufCap(want > (65536 as i64) ? 65536 : (want as int))
emit := (p: void*, n: int, c: void*): ret _szf_buf_emit(p, n, c) end
mut top := mem.AllocateZeroed(sizeof(compress.FileSink)) as compress.FileSink*
top[0] = compress.SinkCallback(0 as i64, emit, holder as void*)
st := _szf_run(fp, start, avail, s, fi, password, 0 as i64, top, null as _SzX*)
mem.Free(top as void*)
if st == SEVENZIP_OK and f.crc_def and (compress.CRC32(holder[0].data, holder[0].len) as i64) != f.crc:
ret _sz_has_aes(f) ? SEVENZIP_BAD_PASSWORD : SEVENZIP_BAD_CRC
end
if st != SEVENZIP_OK:
compress.BufFree(holder[0])
else:
out = holder[0]
end
mem.Free(holder as void*)
ret st
end
func _szm_read(o: i64, d: void*, n: int, c: void*): int:
m := c as _SzMem*
if o < (0 as i64) or o >= m[0].n:
ret 0
end
mut k := n
if (k as i64) > m[0].n - o:
k = (m[0].n - o) as int
end
mem.Copy(d, ((m[0].p as i64) + o) as void*, k as u64)
ret k
end
func _szf_open(sf: SevenZipFile): void*:
if sf.memp != null:
rd := (o: i64, d: void*, n: int, c: void*): ret _szm_read(o, d, n, c) end
ret compress.CallbackOpenRead(sf.memn, rd, sf.memp)
end
if sf.volumes.len() > 1:
ret compress.MultiOpenRead(sf.volumes)
end
ret compress.FileOpenRead(sf.path)
end
func _szf_find_volumes(first: str): Vector<str>:
mut vols := Vector {} as Vector<str>
vols.push(str.Clone(first))
n := first.len()
ds := _rar_digits_end(first, n)
if ds == n or n - ds > 9 or ds < 4:
ret vols
end
stem := str.Substr(first, 0, ds)
stem_ok := str.EndsWith(stem, ".7z.")
mem.Free(stem as void*)
if not stem_ok:
ret vols
end
mut idx := 1
until idx < 10000:
path := _sz_volume_path(first, idx)
if path.len() == 0:
break
end
if not os.Exists(path):
mem.Free(path as void*)
break
end
vols.push(path)
idx++
end
ret vols
end
func _szf_load(fp: void*, sf &: SevenZipFile): int:
sz := sf.size
if sz < (32 as i64):
ret SEVENZIP_UNSUPPORTED
end
sig := mem.Allocate(32 as u64)
got := compress.FileReadAt(fp, 0 as i64, sig, 32)
good := got == 32 and _sz_is(sig, 32)
mem.Free(sig)
mut start := 0 as i64
if not good:
n := sz > (8388640 as i64) ? 8388640 : (sz as int)
buf := mem.Allocate(n as u64)
g := compress.FileReadAt(fp, 0 as i64, buf, n)
off := _sz_start(buf, g)
mem.Free(buf)
if off == 0:
ret SEVENZIP_UNSUPPORTED
end
start = off as i64
end
sf.start = start
avail := sz - start
hd := mem.Allocate(32 as u64)
if compress.FileReadAt(fp, start, hd, 32) != 32:
mem.Free(hd)
ret SEVENZIP_CORRUPT
end
b := hd as u8*
if (b[6] as int) != 0:
mem.Free(hd)
ret SEVENZIP_UNSUPPORTED
end
if (compress.CRC32(((hd as i64) + 12) as void*, 20) as i64) != _sz_le32(b, 8):
mem.Free(hd)
ret SEVENZIP_BAD_CRC
end
noff := _sz_le64(b, 12)
nsize := _sz_le64(b, 20)
want_crc := _sz_le32(b, 28)
mem.Free(hd)
if nsize == (0 as i64):
ret SEVENZIP_OK
end
if noff < (0 as i64) or nsize < (0 as i64) or 32 + noff + nsize > avail:
ret SEVENZIP_CORRUPT
end
if nsize > (2000000000 as i64):
ret SEVENZIP_TOO_BIG
end
mut cur := compress.NewByteBufCap(nsize as int)
if compress.FileReadAt(fp, start + 32 + noff, cur.data, nsize as int) != (nsize as int):
compress.BufFree(cur)
ret SEVENZIP_IO
end
cur.len = nsize as int
if (compress.CRC32(cur.data, cur.len) as i64) != want_crc:
compress.BufFree(cur)
ret SEVENZIP_BAD_CRC
end
mut round := 0
mut status := SEVENZIP_OK
until true:
round++
if round > 4 or cur.len < 1:
status = SEVENZIP_CORRUPT
break
end
first := compress.BufGet(cur, 0)
if first == _SZ_HEADER:
sf.hdr = cur
ret SEVENZIP_OK
end
if first != _SZ_ENCODED_HEADER:
status = SEVENZIP_CORRUPT
break
end
mut r := _SzR { p = cur.data as u8*, pos = 1, end = cur.len, bad = false }
mut tmp := _sz_new()
st := _sz_read_streams(r, tmp)
if st != 0 or tmp.folders.len() < 1:
_sz_free(tmp)
status = st != 0 ? st : SEVENZIP_CORRUPT
break
end
mut next := compress.NewByteBuf()
dst := _szf_folder_buf(fp, start, avail, tmp, 0, sf.password, 1073741824 as i64, next)
_sz_free(tmp)
if dst != SEVENZIP_OK:
status = dst
if dst == SEVENZIP_BAD_PASSWORD and sf.password.len() == 0:
status = SEVENZIP_ENCRYPTED
end
break
end
compress.BufFree(cur)
cur = next
end
compress.BufFree(cur)
ret status
end
func _szf_parse(sf: SevenZipFile, s &: _Sz): int:
if sf.status != SEVENZIP_OK:
ret sf.status
end
if sf.hdr.len < 1:
ret SEVENZIP_OK
end
mut r := _SzR { p = sf.hdr.data as u8*, pos = 1, end = sf.hdr.len, bad = false }
ret _sz_parse_header(r, s)
end
func _szf_links(fp: void*, sf: SevenZipFile, s: _Sz, memcap: i64, kinds: Vector<int>, texts: Vector<str>):
avail := sf.size - sf.start
repeat s.folders.len() in fi:
mut any := false
repeat s.files.len() in i:
f := s.files.get(i)
if kinds.get(i) == 2 and f.folder == fi:
any = true
end
end
if not any:
continue
end
mut x := _szx_new(s, fi, Vector {} as Vector<str>)
repeat s.files.len() in i:
f := s.files.get(i)
if kinds.get(i) == 2 and f.folder == fi:
pos := _szx_pos(x, i)
if pos >= 0:
x.mode.set(pos, 3)
if pos > x.last:
x.last = pos
end
end
end
end
if x.last >= 0:
xp := mem.AllocateZeroed(sizeof(_SzX)) as _SzX*
xp[0] = x
st := _szf_folder(fp, sf.start, avail, s, fi, sf.password, memcap, xp)
_szx_finish(xp, st)
x = xp[0]
repeat x.fidx.len() in k:
if x.mode.get(k) == 3 and x.res.get(k) == SEVENZIP_OK:
texts.set(x.fidx.get(k), x.links.get(k))
x.links.set(k, "")
end
end
mem.Free(xp as void*)
end
x.made.free()
_szx_free(x)
end
end
func _szf_extract(sf: SevenZipFile, s: _Sz, destdir: str, only: int, destpath: str, cap: i64, memcap: i64, made &: Vector<str>, written &: int, got &: compress.ByteBuf): int:
fp := _szf_open(sf)
if fp == null:
ret SEVENZIP_IO
end
avail := sf.size - sf.start
mut first := SEVENZIP_OK
repeat s.folders.len() in fi:
mut x := _szx_new(s, fi, made.copy())
mut want := 0
repeat x.fidx.len() in k:
i := x.fidx.get(k)
f := s.files.get(i)
if only >= 0 and i != only:
continue
end
if only < 0 and not _safe_entry_name(f.name) or only < 0 and _rar_under_link(f.name, made):
x.res.set(k, SEVENZIP_UNSAFE_PATH)
continue
end
if cap > (0 as i64) and f.size > cap:
x.res.set(k, SEVENZIP_TOO_BIG)
continue
end
is_link := only < 0 and _sz_is_link(f)
if is_link and f.size >= (4096 as i64):
x.res.set(k, SEVENZIP_UNSUPPORTED)
continue
end
mut outpath := destpath
if only < 0:
outpath = filepath.Join(destdir, f.name)
parent := filepath.Dir(outpath)
EnsureDir(parent)
mem.Free(parent as void*)
end
if only >= 0 and destpath.len() == 0:
x.mode.set(k, 4)
else is_link:
x.mode.set(k, 2)
else:
x.mode.set(k, 1)
if os.Exists(outpath):
_rar_set_mode(outpath, 0x1a4)
end
end
x.paths.set(k, outpath)
x.last = k
want++
end
if want > 0:
xp := mem.AllocateZeroed(sizeof(_SzX)) as _SzX*
xp[0] = x
st := _szf_folder(fp, sf.start, avail, s, fi, sf.password, memcap, xp)
_szx_finish(xp, st)
x = xp[0]
made = x.made
mem.Free(xp as void*)
if st != SEVENZIP_OK and first == SEVENZIP_OK:
first = st
end
end
repeat x.fidx.len() in k:
mut r := x.res.get(k)
if r == SEVENZIP_BAD_CRC and _sz_has_aes(s.folders.get(fi)):
r = SEVENZIP_BAD_PASSWORD
end
m := x.mode.get(k)
if m == 4:
if r == SEVENZIP_OK:
got = x.got
else:
compress.BufFree(x.got)
end
end
if r == SEVENZIP_OK and m != 0:
written++
if m == 1:
_sz_apply_meta(s.files.get(x.fidx.get(k)), x.paths.get(k))
end
else r != SEVENZIP_OK and first == SEVENZIP_OK:
first = r
end
if x.paths.get(k).len() > 0 and only < 0:
mem.Free(x.paths.get(k) as void*)
end
end
_szx_free(x)
end
compress.FileClose(fp)
ret first
end
func _szf_extract_all(sf: SevenZipFile, destdir: str, cap: i64, memcap: i64, count &: int): int:
count = 0
mut s := _sz_new()
mut first := _szf_parse(sf, s)
if first != SEVENZIP_OK:
_sz_free(s)
ret first
end
mut made := Vector {} as Vector<str>
repeat s.files.len() in i:
f := s.files.get(i)
if f.anti:
continue
end
if not _safe_entry_name(f.name) or _rar_under_link(f.name, made):
if first == SEVENZIP_OK:
first = SEVENZIP_UNSAFE_PATH
end
continue
end
outpath := filepath.Join(destdir, f.name)
if f.is_dir:
EnsureDir(outpath)
count++
else not f.has_stream or f.size == (0 as i64):
parent := filepath.Dir(outpath)
EnsureDir(parent)
mem.Free(parent as void*)
mut empty := compress.SinkOpen(outpath, 0 as i64)
if empty.failed:
if first == SEVENZIP_OK:
first = SEVENZIP_IO
end
else:
compress.SinkClose(empty)
_sz_apply_meta(f, outpath)
count++
end
end
mem.Free(outpath as void*)
end
mut written := 0
mut unused := compress.NewByteBuf()
st := _szf_extract(sf, s, destdir, -1, "", cap, memcap, made, written, unused)
count += written
if first == SEVENZIP_OK:
first = st
end
mut j := s.files.len() - 1
until j >= 0:
f := s.files.get(j)
j--
if f.is_dir and not f.anti and _safe_entry_name(f.name) and not _rar_under_link(f.name, made):
dpath := filepath.Join(destdir, f.name)
if os.IsDir(dpath):
_sz_apply_meta(f, dpath)
end
mem.Free(dpath as void*)
end
end
repeat made.len() in k:
mem.Free(made.get(k) as void*)
end
made.free()
_sz_free(s)
ret first
end
func _szm_open(arc: SevenZipArchive): SevenZipFile:
m := mem.AllocateZeroed(sizeof(_SzMem)) as _SzMem*
m[0].p = arc.data as u8*
m[0].n = arc.len as i64
mut sf := SevenZipFile { password = arc.password, size = arc.len as i64, status = SEVENZIP_CORRUPT, memp = m as void*, memn = arc.len as i64 }
fp := _szf_open(sf)
sf.status = _szf_load(fp, sf)
compress.FileClose(fp)
ret sf
end
func _szm_close(sf &: SevenZipFile):
compress.BufFree(sf.hdr)
sf.volumes.free()
if sf.memp != null:
mem.Free(sf.memp)
end
sf.memp = null
end
func _szm_read_one(sf: SevenZipFile, name: str, cap: i64, out &: compress.ByteBuf): int:
mut s := _sz_new()
mut st := _szf_parse(sf, s)
if st != SEVENZIP_OK:
_sz_free(s)
ret st
end
fi := _sz_find(s, name)
if fi < 0:
_sz_free(s)
ret SEVENZIP_NOT_FOUND
end
f := s.files.get(fi)
if not f.has_stream or f.size == (0 as i64):
_sz_free(s)
ret SEVENZIP_OK
end
mut lim := 2147483000 as i64
if cap > (0 as i64) and cap < lim:
lim = cap
end
if f.size > lim:
_sz_free(s)
ret SEVENZIP_TOO_BIG
end
mut made := Vector {} as Vector<str>
mut written := 0
st = _szf_extract(sf, s, "", fi, "", 0 as i64, 0 as i64, made, written, out)
made.free()
_sz_free(s)
ret st
end
@en "SevenZipOpenFile"
@fa "بازکردن پرونده هفت زد"
pub func SevenZipOpenFile(path: str, password: str): SevenZipFile:
mut sf := SevenZipFile { path = str.Clone(path), password = password.len() > 0 ? str.Clone(password) : "", status = SEVENZIP_CORRUPT }
sf.volumes = _szf_find_volumes(path)
fp := _szf_open(sf)
if fp == null:
sf.status = SEVENZIP_IO
ret sf
end
sf.size = compress.FileSize(fp)
sf.status = _szf_load(fp, sf)
compress.FileClose(fp)
ret sf
end
@en "SevenZipFileClose"
@fa "بستن پرونده هفت زد"
pub func SevenZipFileClose(sf &: SevenZipFile):
compress.BufFree(sf.hdr)
if sf.path.len() > 0:
mem.Free(sf.path as void*)
end
if sf.password.len() > 0:
mem.Free(sf.password as void*)
end
repeat sf.volumes.len() in v:
mem.Free(sf.volumes.get(v) as void*)
end
sf.volumes.free()
sf.path = ""
sf.password = ""
sf.size = 0 as i64
end
@en "SevenZipFileEntries"
@fa "مدخل های پرونده هفت زد"
pub func SevenZipFileEntries(sf &: SevenZipFile): Vector<Entry>:
mut out := Vector {} as Vector<Entry>
mut s := _sz_new()
st := _szf_parse(sf, s)
if st != SEVENZIP_OK:
sf.status = st
_sz_free(s)
ret out
end
mut kinds := Vector {} as Vector<int>
mut texts := Vector {} as Vector<str>
repeat s.files.len() in i:
f := s.files.get(i)
mut k := f.is_dir ? 1 : 0
if _sz_is_link(f) and not f.is_dir:
k = 2
if not f.has_stream or f.size <= (0 as i64) or f.size >= (4096 as i64):
k = 4
end
end
kinds.push(k)
texts.push("")
end
fp := _szf_open(sf)
if fp != null:
_szf_links(fp, sf, s, 0 as i64, kinds, texts)
compress.FileClose(fp)
end
repeat s.files.len() in i:
f := s.files.get(i)
if f.anti:
continue
end
mut method := 0
mut packed := 0 as i64
if f.has_stream and f.folder >= 0:
method = _sz_method(s.folders.get(f.folder))
if f.offset == (0 as i64):
packed = _sz_folder_packed(s, f.folder)
end
end
mut mode := _sz_unix_mode(f)
if mode < 0:
mode = 0
end
mut kind := f.is_dir ? 1 : 0
if kinds.get(i) >= 2:
kind = 2
end
out.push(_sz_make_entry(f, method, packed, kind, mode, texts.get(i)))
end
kinds.free()
texts.free()
_sz_free(s)
ret out
end
@en "SevenZipFileExtractTo"
@fa "استخراج از پرونده هفت زد به پرونده"
pub func SevenZipFileExtractTo(sf &: SevenZipFile, name: str, destpath: str, cap: i64, memcap: i64): int:
mut s := _sz_new()
mut st := _szf_parse(sf, s)
if st != SEVENZIP_OK:
_sz_free(s)
ret st
end
fi := _sz_find(s, name)
if fi < 0:
_sz_free(s)
ret SEVENZIP_NOT_FOUND
end
f := s.files.get(fi)
if cap > (0 as i64) and f.size > cap:
_sz_free(s)
ret SEVENZIP_TOO_BIG
end
if f.is_dir:
_sz_free(s)
ret SEVENZIP_UNSUPPORTED
end
if not f.has_stream or f.size == (0 as i64):
mut empty := compress.SinkOpen(destpath, 0 as i64)
if empty.failed:
st = SEVENZIP_IO
else:
compress.SinkClose(empty)
end
_sz_free(s)
ret st
end
mut made := Vector {} as Vector<str>
mut written := 0
mut unused := compress.NewByteBuf()
st = _szf_extract(sf, s, "", fi, destpath, cap, memcap, made, written, unused)
made.free()
_sz_free(s)
ret st
end
@en "SevenZipFileExtractAll"
@fa "استخراج همه از پرونده هفت زد"
pub func SevenZipFileExtractAll(sf &: SevenZipFile, destdir: str, cap: i64, memcap: i64): int:
mut count := 0
ret _szf_extract_all(sf, destdir, cap, memcap, count)
end
@en "SevenZipReadCap"
@fa "خواندن از هفت زد با سقف"
pub func SevenZipReadCap(arc &: SevenZipArchive, name: str, cap: i64): compress.ByteBuf:
mut sf := _szm_open(arc)
mut out := compress.NewByteBuf()
mut st := sf.status
if st == SEVENZIP_OK:
st = _szm_read_one(sf, name, cap, out)
end
arc.status = st
_szm_close(sf)
ret out
end
@en "SevenZipReadAllCap"
@fa "خواندن همه از هفت زد با سقف"
pub func SevenZipReadAllCap(arc &: SevenZipArchive, destdir: str, cap: i64, memcap: i64): int:
mut sf := _szm_open(arc)
mut count := 0
mut st := sf.status
if st == SEVENZIP_OK:
st = _szf_extract_all(sf, destdir, cap, memcap, count)
end
arc.status = st
_szm_close(sf)
ret count
end
@en "SevenZipEntriesOf"
@fa "مدخل‌های هفت زد در حافظه"
pub func SevenZipEntriesOf(arc &: SevenZipArchive): Vector<Entry>:
mut sf := _szm_open(arc)
mut out := Vector {} as Vector<Entry>
if sf.status == SEVENZIP_OK:
out = SevenZipFileEntries(sf)
end
arc.status = sf.status
_szm_close(sf)
ret out
end
package archive
import compress
import mem
const _SZ_END := 0
const _SZ_HEADER := 1
const _SZ_ARCHIVE_PROPS := 2
const _SZ_ADD_STREAMS := 3
const _SZ_MAIN_STREAMS := 4
const _SZ_FILES := 5
const _SZ_PACK_INFO := 6
const _SZ_UNPACK_INFO := 7
const _SZ_SUB_STREAMS := 8
const _SZ_SIZE := 9
const _SZ_CRC := 10
const _SZ_FOLDER := 11
const _SZ_CODERS_SIZE := 12
const _SZ_NUM_UNPACK := 13
const _SZ_EMPTY_STREAM := 14
const _SZ_EMPTY_FILE := 15
const _SZ_ANTI := 16
const _SZ_NAMES := 17
const _SZ_MTIME := 20
const _SZ_ATTR := 21
const _SZ_ENCODED_HEADER := 23
const _SZ_MAX_CODERS := 32
struct _SzR:
pub p: u8*
pub pos: int
pub
end: int
pub bad: bool
end
struct _SzCoder:
pub id: i64
pub num_in: int
pub num_out: int
pub props: compress.ByteBuf
end
struct _SzFolder:
pub coders: Vector<_SzCoder>
pub bin: Vector<int>
pub bout: Vector<int>
pub packed: Vector<int>
pub unpack: Vector<i64>
pub crc_def: bool
pub crc: i64
pub pack_first: int
pub nsub: int
pub sub_first: int
end
struct _SzFile:
pub name: str
pub has_stream: bool
pub is_dir: bool
pub anti: bool
pub has_attr: bool
pub attr: int
pub mtime: i64
pub size: i64
pub crc_def: bool
pub crc: i64
pub folder: int
pub offset: i64
end
struct _Sz:
pub pack_pos: i64
pub pack_sizes: Vector<i64>
pub pack_off: Vector<i64>
pub folders: Vector<_SzFolder>
pub sub_sizes: Vector<i64>
pub sub_crc_def: Vector<bool>
pub sub_crc: Vector<i64>
pub files: Vector<_SzFile>
end
func _sz_new(): _Sz:
ret _Sz {
pack_pos = 0 as i64, pack_sizes = Vector {} as Vector<i64>, pack_off = Vector {} as Vector<i64>,
folders = Vector {} as Vector<_SzFolder> sub_sizes = Vector {} as Vector<i64>, sub_crc_def = Vector {} as Vector<bool>,
sub_crc = Vector {} as Vector<i64> files = Vector {} as Vector<_SzFile>
}
end
func _sz_free_folders(s &: _Sz):
repeat s.folders.len() in i:
f := s.folders.get(i)
repeat f.coders.len() in j:
c := f.coders.get(j)
mut pb := c.props
compress.BufFree(pb)
end
f.coders.free()
f.bin.free()
f.bout.free()
f.packed.free()
f.unpack.free()
end
s.folders.free()
s.pack_sizes.free()
s.pack_off.free()
s.sub_sizes.free()
s.sub_crc_def.free()
s.sub_crc.free()
end
func _sz_free(s &: _Sz):
repeat s.files.len() in i:
nm := s.files.get(i).name
if nm.len() > 0:
mem.Free(nm as void*)
end
end
s.files.free()
_sz_free_folders(s)
end
func _szr_byte(r &: _SzR): int:
if r.pos >= r.end:
r.bad = true
ret 0
end
v := r.p[r.pos] as int
r.pos++
ret v
end
func _szr_u32(r &: _SzR): i64:
if r.pos + 4 > r.end:
r.bad = true
r.pos = r.end
ret 0
end
v := (r.p[r.pos] as i64) | ((r.p[r.pos + 1] as i64) << 8) | ((r.p[r.pos + 2] as i64) << 16) | ((r.p[r.pos + 3] as i64) << 24)
r.pos += 4
ret v
end
func _szr_u64(r &: _SzR): i64:
lo := _szr_u32(r)
hi := _szr_u32(r)
ret lo | (hi << 32)
end
func _szr_num(r &: _SzR): i64:
first := _szr_byte(r)
mut mask := 128
mut v := 0 as i64
mut i := 0
until i < 8:
if (first & mask) == 0:
hi := (first & (mask - 1)) as i64
ret v | (hi << (8 * i))
end
v |= ((_szr_byte(r) as i64) << (8 * i))
mask >>= 1
i++
end
ret v
end
func _szr_count(r &: _SzR, limit: int): int:
v := _szr_num(r)
if v < (0 as i64) or v > (limit as i64):
r.bad = true
ret 0
end
ret v as int
end
func _szr_size(r &: _SzR): i64:
v := _szr_num(r)
if v < (0 as i64) or v > (0x7fffffffffff as i64):
r.bad = true
ret 0
end
ret v
end
func _szr_left(r: _SzR): int:
ret r.end - r.pos
end
func _szr_bits(r &: _SzR, n: int): Vector<bool>:
mut out := Vector {} as Vector<bool>
mut cur := 0
mut mask := 0
mut i := 0
until i < n:
if mask == 0:
cur = _szr_byte(r)
mask = 128
end
out.push((cur & mask) != 0)
mask >>= 1
i++
end
ret out
end
func _szr_defined(r &: _SzR, n: int): Vector<bool>:
all := _szr_byte(r)
if all != 0:
mut out := Vector {} as Vector<bool>
repeat n:
out.push(true)
end
ret out
end
ret _szr_bits(r, n)
end
func _szr_digests(r &: _SzR, n: int, defs &: Vector<bool>, crcs &: Vector<i64>):
d := _szr_defined(r, n)
repeat n in i:
if d.get(i):
crcs.push(_szr_u32(r))
else:
crcs.push(0 as i64)
end
defs.push(d.get(i))
end
d.free()
end
func _sz_read_folder(r &: _SzR, s &: _Sz): int:
mut f := _SzFolder {
coders = Vector {} as Vector<_SzCoder>, bin = Vector {} as Vector<int>, bout = Vector {} as Vector<int> packed = Vector {} as Vector<int>,
unpack = Vector {} as Vector<i64> crc_def = false, crc = 0 as i64, pack_first = 0, nsub = 1,
sub_first = 0
}
ncoders := _szr_count(r, _SZ_MAX_CODERS)
if r.bad or ncoders == 0:
s.folders.push(f)
ret 4
end
mut tin := 0
mut tout := 0
mut k := 0
until k < ncoders:
flags := _szr_byte(r)
idsize := flags & 15
if idsize > 8 or (flags & 128) != 0:
s.folders.push(f)
ret 2
end
mut id := 0 as i64
mut j := 0
until j < idsize:
id = (id << 8) | (_szr_byte(r) as i64)
j++
end
mut num_in := 1
mut num_out := 1
if (flags & 16) != 0:
num_in = _szr_count(r, 64)
num_out = _szr_count(r, 64)
end
mut props := compress.NewByteBuf()
if (flags & 32) != 0:
psz := _szr_count(r, _szr_left(r))
if r.bad:
s.folders.push(f)
ret 4
end
compress.BufPushBytes(props, ((r.p as i64) + (r.pos as i64)) as void*, psz)
r.pos += psz
end
f.coders.push(_SzCoder { id = id, num_in = num_in, num_out = num_out, props = props })
tin += num_in
tout += num_out
k++
end
if r.bad or tout == 0 or tin < tout - 1:
s.folders.push(f)
ret 4
end
nbind := tout - 1
k = 0
until k < nbind:
a := _szr_count(r, tin)
b := _szr_count(r, tout)
f.bin.push(a)
f.bout.push(b)
k++
end
npacked := tin - nbind
if npacked == 1:
mut idx := 0
until idx < tin:
mut bound := false
repeat nbind in q:
if f.bin.get(q) == idx:
bound = true
end
end
if not bound:
f.packed.push(idx)
break
end
idx++
end
else:
k = 0
until k < npacked:
f.packed.push(_szr_count(r, tin))
k++
end
end
if r.bad or f.packed.len() != npacked:
s.folders.push(f)
ret 4
end
s.folders.push(f)
ret 0
end
func _sz_folder_total_out(f: _SzFolder): int:
mut t := 0
repeat f.coders.len() in i:
t += f.coders.get(i).num_out
end
ret t
end
func _sz_folder_main_out(f: _SzFolder): int:
total := _sz_folder_total_out(f)
mut o := 0
until o < total:
mut used := false
repeat f.bout.len() in q:
if f.bout.get(q) == o:
used = true
end
end
if not used:
ret o
end
o++
end
ret 0
end
func _sz_folder_size(f: _SzFolder): i64:
m := _sz_folder_main_out(f)
if m >= f.unpack.len():
ret 0
end
ret f.unpack.get(m)
end
func _sz_read_pack_info(r &: _SzR, s &: _Sz): int:
s.pack_pos = _szr_size(r)
n := _szr_count(r, _szr_left(r))
until true:
id := _szr_byte(r)
if r.bad:
ret 4
end
if id == _SZ_END:
break
end
if id == _SZ_SIZE:
repeat n:
s.pack_sizes.push(_szr_size(r))
end
else id == _SZ_CRC:
mut dd := Vector {} as Vector<bool>
mut cc := Vector {} as Vector<i64>
_szr_digests(r, n, dd, cc)
dd.free()
cc.free()
else:
ret 4
end
end
if s.pack_sizes.len() != n or r.bad:
ret 4
end
mut off := 32 as i64 + s.pack_pos
repeat n in i:
s.pack_off.push(off)
off += s.pack_sizes.get(i)
end
ret 0
end
func _sz_read_unpack_info(r &: _SzR, s &: _Sz): int:
if _szr_byte(r) != _SZ_FOLDER:
ret 4
end
nf := _szr_count(r, _szr_left(r))
if _szr_byte(r) != 0:
ret 2
end
mut pack_idx := 0
repeat nf:
st := _sz_read_folder(r, s)
if st != 0 or r.bad:
if st != 0:
ret st
end
ret 4
end
mut fl := s.folders.get(s.folders.len() - 1)
fl.pack_first = pack_idx
pack_idx += fl.packed.len()
s.folders.set(s.folders.len() - 1, fl)
end
if _szr_byte(r) != _SZ_CODERS_SIZE:
ret 4
end
repeat nf in i:
mut fl := s.folders.get(i)
total := _sz_folder_total_out(fl)
repeat total:
fl.unpack.push(_szr_size(r))
end
s.folders.set(i, fl)
end
until true:
id := _szr_byte(r)
if r.bad:
ret 4
end
if id == _SZ_END:
break
end
if id == _SZ_CRC:
mut dd := Vector {} as Vector<bool>
mut cc := Vector {} as Vector<i64>
_szr_digests(r, nf, dd, cc)
repeat nf in i:
mut fl := s.folders.get(i)
fl.crc_def = dd.get(i)
fl.crc = cc.get(i)
s.folders.set(i, fl)
end
dd.free()
cc.free()
else:
ret 4
end
end
ret 0
end
func _sz_default_subs(s &: _Sz):
s.sub_sizes.free()
s.sub_crc_def.free()
s.sub_crc.free()
s.sub_sizes = Vector {} as Vector<i64>
s.sub_crc_def = Vector {} as Vector<bool>
s.sub_crc = Vector {} as Vector<i64>
mut first := 0
repeat s.folders.len() in i:
mut fl := s.folders.get(i)
fl.nsub = 1
fl.sub_first = first
first++
s.sub_sizes.push(_sz_folder_size(fl))
s.sub_crc_def.push(fl.crc_def)
s.sub_crc.push(fl.crc)
s.folders.set(i, fl)
end
end
func _sz_read_substreams(r &: _SzR, s &: _Sz): int:
nf := s.folders.len()
mut id := _szr_byte(r)
if id == _SZ_NUM_UNPACK:
repeat nf in i:
mut fl := s.folders.get(i)
fl.nsub = _szr_count(r, _szr_left(r) + 1)
s.folders.set(i, fl)
end
id = _szr_byte(r)
end
s.sub_sizes.free()
s.sub_crc_def.free()
s.sub_crc.free()
s.sub_sizes = Vector {} as Vector<i64>
s.sub_crc_def = Vector {} as Vector<bool>
s.sub_crc = Vector {} as Vector<i64>
mut first := 0
repeat nf in i:
mut fl := s.folders.get(i)
fl.sub_first = first
first += fl.nsub
s.folders.set(i, fl)
end
if r.bad or first > r.end:
ret 4
end
repeat nf in i:
fl := s.folders.get(i)
if fl.nsub == 0:
continue
end
mut sum := 0 as i64
mut j := 0
until j < fl.nsub - 1:
mut sz := 0 as i64
if id == _SZ_SIZE:
sz = _szr_size(r)
end
s.sub_sizes.push(sz)
sum += sz
j++
end
last := _sz_folder_size(fl) - sum
if last < (0 as i64) or (fl.nsub > 1 and id != _SZ_SIZE):
ret 4
end
s.sub_sizes.push(last)
end
if id == _SZ_SIZE:
id = _szr_byte(r)
end
repeat s.sub_sizes.len():
s.sub_crc_def.push(false)
s.sub_crc.push(0 as i64)
end
mut unknown := 0
repeat nf in i:
fl := s.folders.get(i)
if fl.nsub == 1 and fl.crc_def:
s.sub_crc_def.set(fl.sub_first, true)
s.sub_crc.set(fl.sub_first, fl.crc)
else:
unknown += fl.nsub
end
end
until true:
if r.bad:
ret 4
end
if id == _SZ_END:
break
end
if id == _SZ_CRC:
mut dd := Vector {} as Vector<bool>
mut cc := Vector {} as Vector<i64>
_szr_digests(r, unknown, dd, cc)
mut u := 0
repeat nf in i:
fl := s.folders.get(i)
if fl.nsub == 1 and fl.crc_def:
continue
end
repeat fl.nsub in j:
s.sub_crc_def.set(fl.sub_first + j, dd.get(u))
s.sub_crc.set(fl.sub_first + j, cc.get(u))
u++
end
end
dd.free()
cc.free()
else:
ret 4
end
id = _szr_byte(r)
end
ret 0
end
func _sz_read_streams(r &: _SzR, s &: _Sz): int:
mut have_subs := false
until true:
id := _szr_byte(r)
if r.bad:
ret 4
end
if id == _SZ_END:
break
end
mut st := 0
if id == _SZ_PACK_INFO:
st = _sz_read_pack_info(r, s)
else id == _SZ_UNPACK_INFO:
st = _sz_read_unpack_info(r, s)
else id == _SZ_SUB_STREAMS:
st = _sz_read_substreams(r, s)
have_subs = true
else:
ret 4
end
if st != 0:
ret st
end
end
if not have_subs:
_sz_default_subs(s)
end
ret 0
end
func _szr_name(r &: _SzR, endp: int): str:
mut b := compress.NewByteBuf()
until r.pos + 2 <= endp:
u := (r.p[r.pos] as int) | ((r.p[r.pos + 1] as int) << 8)
r.pos += 2
if u == 0:
break
end
mut cp := u
if u >= 55296 and u <= 56319 and r.pos + 2 <= endp:
u2 := (r.p[r.pos] as int) | ((r.p[r.pos + 1] as int) << 8)
if u2 >= 56320 and u2 <= 57343:
r.pos += 2
cp = 65536 + ((u - 55296) << 10) + (u2 - 56320)
end
end
if cp < 128:
compress.BufPush(b, cp)
else cp < 2048:
compress.BufPush(b, 192 | (cp >> 6))
compress.BufPush(b, 128 | (cp & 63))
else cp < 65536:
compress.BufPush(b, 224 | (cp >> 12))
compress.BufPush(b, 128 | ((cp >> 6) & 63))
compress.BufPush(b, 128 | (cp & 63))
else:
compress.BufPush(b, 240 | (cp >> 18))
compress.BufPush(b, 128 | ((cp >> 12) & 63))
compress.BufPush(b, 128 | ((cp >> 6) & 63))
compress.BufPush(b, 128 | (cp & 63))
end
end
out := compress.BufToStrUnsafe(b)
compress.BufFree(b)
ret out
end
func _sz_read_files(r &: _SzR, s &: _Sz): int:
n := _szr_count(r, _szr_left(r))
if r.bad:
ret 4
end
repeat n:
s.files.push(
_SzFile {
name = "", has_stream = true, is_dir = false, anti = false, has_attr = false, attr = 0
mtime = 0 as i64, size = 0 as i64, crc_def = false, crc = 0 as i64, folder = -1, offset = 0 as i64
}
)
end
mut empty := Vector {} as Vector<bool>
mut empty_file := Vector {} as Vector<bool>
mut anti := Vector {} as Vector<bool>
mut empty_count := 0
mut st := 0
until true:
ty := _szr_num(r)
if r.bad:
st = 4
break
end
if ty == (_SZ_END as i64):
break
end
size := _szr_count(r, _szr_left(r))
if r.bad:
st = 4
break
end
endp := r.pos + size
if ty == (_SZ_EMPTY_STREAM as i64):
empty.free()
empty = _szr_bits(r, n)
empty_count = 0
repeat n in i:
if empty.get(i):
empty_count++
end
end
else ty == (_SZ_EMPTY_FILE as i64):
empty_file.free()
empty_file = _szr_bits(r, empty_count)
else ty == (_SZ_ANTI as i64):
anti.free()
anti = _szr_bits(r, empty_count)
else ty == (_SZ_NAMES as i64):
if _szr_byte(r) != 0:
st = 2
break
end
repeat n in i:
mut f := s.files.get(i)
f.name = _szr_name(r, endp)
s.files.set(i, f)
end
else ty == (_SZ_MTIME as i64):
defs := _szr_defined(r, n)
if _szr_byte(r) != 0:
st = 2
defs.free()
break
end
repeat n in i:
if defs.get(i):
ft := _szr_u64(r)
mut f := s.files.get(i)
f.mtime = ft / (10000000 as i64) - (11644473600 as i64)
s.files.set(i, f)
end
end
defs.free()
else ty == (_SZ_ATTR as i64):
defs := _szr_defined(r, n)
if _szr_byte(r) != 0:
st = 2
defs.free()
break
end
repeat n in i:
if defs.get(i):
a := _szr_u32(r)
mut f := s.files.get(i)
f.has_attr = true
f.attr = a as int
s.files.set(i, f)
end
end
defs.free()
end
if r.bad or endp > r.end:
st = 4
break
end
r.pos = endp
end
if st == 0:
mut k := 0
mut next_sub := 0
mut cur_folder := 0
mut in_folder := 0
mut off := 0 as i64
repeat n in i:
mut f := s.files.get(i)
is_empty := empty.len() > i and empty.get(i)
if is_empty:
f.has_stream = false
f.is_dir = true
if empty_file.len() > k and empty_file.get(k):
f.is_dir = false
end
if anti.len() > k and anti.get(k):
f.anti = true
end
k++
else:
until cur_folder < s.folders.len() and in_folder >= s.folders.get(cur_folder).nsub:
cur_folder++
in_folder = 0
off = 0 as i64
end
if cur_folder >= s.folders.len() or next_sub >= s.sub_sizes.len():
st = 4
break
end
f.folder = cur_folder
f.offset = off
f.size = s.sub_sizes.get(next_sub)
f.crc_def = s.sub_crc_def.get(next_sub)
f.crc = s.sub_crc.get(next_sub)
off += f.size
in_folder++
next_sub++
end
if f.has_attr and (f.attr & 16) != 0:
f.is_dir = true
end
s.files.set(i, f)
end
end
empty.free()
empty_file.free()
anti.free()
ret st
end
package archive
import compress
import mem
struct _SzAesR:
pub inner: void*
pub ioff: i64
pub ileft: i64
pub oleft: i64
pub pos: i64
pub aes: _Aes
pub iv: u8*
pub cbuf: u8*
pub pbuf: u8*
pub pstart: int
pub pend: int
end
func _szaes_read(off: i64, dst: void*, n: int, ctx: void*): int:
r := ctx as _SzAesR*
if off != r[0].pos:
ret 0
end
mut done := 0
until done < n:
if r[0].pstart == r[0].pend:
if r[0].oleft <= (0 as i64) or r[0].ileft < (16 as i64):
break
end
mut want := 65536
if (want as i64) > r[0].ileft:
want = (r[0].ileft as int) & (-16)
end
got := compress.FileReadAt(r[0].inner, r[0].ioff, r[0].cbuf as void*, want)
g := got & (-16)
if g < 16:
break
end
_aes_cbc_decrypt(r[0].aes, r[0].iv, r[0].cbuf, r[0].pbuf, g)
repeat 16 in q:
r[0].iv[q] = r[0].cbuf[g - 16 + q]
end
r[0].ioff += g as i64
r[0].ileft -= g as i64
r[0].pstart = 0
r[0].pend = g
if (g as i64) > r[0].oleft:
r[0].pend = r[0].oleft as int
end
end
mut take := n - done
if take > r[0].pend - r[0].pstart:
take = r[0].pend - r[0].pstart
end
mem.Copy(((dst as i64) + (done as i64)) as void*, ((r[0].pbuf as i64) + (r[0].pstart as i64)) as void*, take as u64)
r[0].pstart += take
done += take
r[0].pos += take as i64
r[0].oleft -= take as i64
end
ret done
end
func _szaes_open(inner: void*, ioff: i64, ilen: i64, c: _SzCoder, osz: i64, password: str, status &: int): void*:
key := mem.AllocateZeroed(32 as u64) as u8*
iv := mem.AllocateZeroed(16 as u64) as u8*
if not _sz_aes_setup(c, password, key, iv, status):
mem.Free(key as void*)
mem.Free(iv as void*)
