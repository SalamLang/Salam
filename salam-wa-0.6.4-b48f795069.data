@en "Transform"
@fa "ماتریس‌تبدیل"
pub struct Transform:
@en "a"
@fa "مولفه آ"
pub a: f64 = 1.0
@en "b"
@fa "مولفه ب"
pub b: f64 = 0.0
@en "c"
@fa "مولفه ث"
pub c: f64 = 0.0
@en "d"
@fa "مولفه د"
pub d: f64 = 1.0
@en "e"
@fa "مولفه ه"
pub e: f64 = 0.0
@en "f"
@fa "مولفه ف"
pub f: f64 = 0.0
@en "Then"
@fa "سپس"
pub func Then(o: Transform): Transform:
ret Transform {
a = o.a * this.a + o.c * this.b, b = o.b * this.a + o.d * this.b, c = o.a * this.c + o.c * this.d,
d = o.b * this.c + o.d * this.d, e = o.a * this.e + o.c * this.f + o.e, f = o.b * this.e + o.d * this.f + o.f
}
end
@en "Apply"
@fa "اعمال روی نقطه"
pub func Apply(p: Point): Point:
ret Point { x = this.a * p.x + this.c * p.y + this.e, y = this.b * p.x + this.d * p.y + this.f }
end
@en "Invert"
@fa "وارون تبدیل"
pub func Invert(): Transform:
det := this.a * this.d - this.b * this.c
if det == 0.0 or not (det == det):
ret Transform {}
end
ia := this.d / det
ib := 0.0 - this.b / det
ic := 0.0 - this.c / det
id := this.a / det
ret Transform { a = ia, b = ib, c = ic, d = id, e = 0.0 - (ia * this.e + ic * this.f), f = 0.0 - (ib * this.e + id * this.f) }
end
@en "MapRect"
@fa "نگاشت مستطیل"
pub func MapRect(r: Rect): Rect:
mut x0 := 1.0e300
mut y0 := 1.0e300
mut x1 := -1.0e300
mut y1 := -1.0e300
repeat 4 in i:
px := (i & 1) == 0 ? r.x : r.x + r.width
py := (i & 2) == 0 ? r.y : r.y + r.height
tx := this.a * px + this.c * py + this.e
ty := this.b * px + this.d * py + this.f
x0 = _minf(x0, tx)
y0 = _minf(y0, ty)
x1 = _maxf(x1, tx)
y1 = _maxf(y1, ty)
end
ret Rect { x = x0, y = y0, width = x1 - x0, height = y1 - y0 }
end
@en "IsIdentity"
@fa "همانی است"
pub func IsIdentity(): bool:
ret this.a == 1.0 and this.b == 0.0 and this.c == 0.0 and this.d == 1.0 and this.e == 0.0 and this.f == 0.0
end
end
