mut k := -1
repeat f.alt_w.len() in i:
if f.alt_w[i] == width:
k = i
end
end
if k >= 0 and _va_tb_count(f0) == 0:
got := f.alt_lay[k]
f.alt_lay.remove_at(k)
f.alt_w.remove_at(k)
if f.has_lay:
f.alt_lay.push(f.lay)
f.alt_w.push(f.lay_w)
end
f.lay = got
f.lay_w = width
f.has_lay = true
