func _pk_check(id: Identity, n_hex: str, e_hex: str, d_hex: str, phi_hex: str, label: str):
_ck(id.ok, label + ": parses successfully")
if not id.ok:
ret
end
_ckhex(_hex_of(id.n.p, id.n.len), n_hex, label + ": modulus n matches the independent oracle")
_ckhex(_hex_of(id.e.p, id.e.len), e_hex, label + ": public exponent e matches the independent oracle")
_ckhex(_hex_of(id.d.p, id.d.len), d_hex, label + ": private exponent d matches the independent oracle")
_ckhex(_hex_of(id.phi.p, id.phi.len), phi_hex, label + ": phi=(p-1)(q-1) matches the independent oracle")
end
func _selftest_privatekey():
id_pkcs1 := _load_identity_pem(_PK_K1_PKCS1_PEM)
_pk_check(id_pkcs1, _PK_K1_N, _PK_K1_E, _PK_K1_D, _PK_K1_PHI, "privatekey: PKCS#1 PEM (K1)")
mut id_pkcs1m := id_pkcs1
_identity_free(id_pkcs1m)
id_pkcs8 := _load_identity_pem(_PK_K2_PKCS8_PEM)
_pk_check(id_pkcs8, _PK_K2_N, _PK_K2_E, _PK_K2_D, _PK_K2_PHI, "privatekey: PKCS#8 PEM (K2)")
mut id_pkcs8m := id_pkcs8
_identity_free(id_pkcs8m)
id_openssh := _load_identity_pem(_PK_K1_OPENSSH)
_pk_check(id_openssh, _PK_K1_N, _PK_K1_E, _PK_K1_D, _PK_K1_PHI, "privatekey: OpenSSH container format (same key as K1)")
mut id_opensshm := id_openssh
_identity_free(id_opensshm)
dir := os.TempDir()
path := dir + "/salam_ssh_selftest_id_rsa"
_wrote := io.WriteFile(path, _PK_K1_PKCS1_PEM)
id_file := _load_identity_file(path)
_pk_check(id_file, _PK_K1_N, _PK_K1_E, _PK_K1_D, _PK_K1_PHI, "privatekey: _load_identity_file reads PEM from disk")
mut id_filem := id_file
_identity_free(id_filem)
_removed := os.Remove(path)
nonexistent := _load_identity_file(dir + "/salam_ssh_selftest_id_rsa_missing")
_ck(not nonexistent.ok, "privatekey: loading a nonexistent file fails cleanly, not a crash")
empty := _load_identity_pem("")
_ck(not empty.ok, "privatekey: an empty string is rejected")
garbage := _load_identity_pem("this is not a PEM file at all")
_ck(not garbage.ok, "privatekey: non-PEM garbage is rejected")
fakeopenssh := "-----BEGIN OPENSSH PRIVATE KEY-----\nQUJDRA==\n-----END OPENSSH PRIVATE KEY-----\n"
fake := _load_identity_pem(fakeopenssh)
_ck(not fake.ok, "privatekey: an OpenSSH-tagged block with a bad magic/body is rejected, not crashed on")
badpem := "-----BEGIN RSA PRIVATE KEY-----\n!!!not-valid-base64!!!\n-----END RSA PRIVATE KEY-----\n"
badid := _load_identity_pem(badpem)
_ck(not badid.ok, "privatekey: a corrupted PKCS#1 PEM body is rejected, not crashed on")
end
package ssh
const _RSA_TV_N := "c1ba848ca7709a56853f3ab248f650505753ed6fa69c50bdfaf0960391ace24e3a01f996a46488f16d7960ee9c5903166bd3dfed7c18366a621144de00e704666d85df47b8940f0854d2b9f5b199ad5da15f5ee028dd8155688d5dbc1497530abefdb8aead999e45b894a165fa87a883845f42b2e0eda79474d8d87f83d48fe3"
const _RSA_TV_E := "010001"
const _RSA_TV_D := "292ca44964b90904849378bd35c6ac31372e4e53a19cad88835229001f31187439ddfb9729df783f9fdde15d357bb1ad4d439ddf52b5aeb3139ec9fd4941d06c39918a12dcce2ec8394f8283b8d1a8534f28f52b57727e7e60e96f76db626e4b1afd465dd22300e01969f8248f990dcdfb9a651ef0ffc9e962e3fea37dc161b1"
const _RSA_TV_PHI := "c1ba848ca7709a56853f3ab248f650505753ed6fa69c50bdfaf0960391ace24e3a01f996a46488f16d7960ee9c5903166bd3dfed7c18366a621144de00e70464adf87543d0e549b046210ac6390969a434ca06f3e64da1a89d9d3d141a9015b721fd5772dbeff496acfbd1e0ef52bfd24c92d2fa52b7f3f70bbb95c2a88cfe30"
const _RSA_TV_DIGEST := "6d25c56cfc4e70a2b697335c0e9578f81e1e66d9f6e8b80081b33350903bc88b"
const _RSA_TV_SIG := "8c0ed807e4f283d5ab88de91cc1f826371396e11a0bec48b4e4e392a9fb82d1dbf8b23df2a2c791c2036d5acf336ca1d40eceae508004d2316f813a449459365ac434c6c00dc7a6f3323851680c6ff81439ea46ae0a92cf992b6c4b8a4fb009e47955ecd9957f1d1d3448df2c1817ef8852a849432e8c40e64f18d4f8b86c31e"
func _selftest_rsa():
mut n := _hexbuf(_RSA_TV_N)
mut e := _hexbuf(_RSA_TV_E)
mut d := _hexbuf(_RSA_TV_D)
mut phi := _hexbuf(_RSA_TV_PHI)
mut digest := _hexbuf(_RSA_TV_DIGEST)
mut refsig := _hexbuf(_RSA_TV_SIG)
_ck(n.len == 128, "rsa: test key modulus is 128 bytes (1024-bit)")
_ck(digest.len == 32, "rsa: test digest is 32 bytes (sha256)")
_ck(refsig.len == 128, "rsa: reference signature is 128 bytes")
ok_verify_real := _rsa_verify_pkcs1(SSH_HASH_SHA256, digest.p, n.p, n.len, e.p, e.len, refsig.p, refsig.len)
_ck(ok_verify_real, "rsa: verify an openssl-produced rsa-sha2-256 signature")
mut mysig := NewBuf(n.len)
BufPutZeros(mysig, n.len)
ok_sign := _rsa_sign_pkcs1(SSH_HASH_SHA256, digest.p, n, e, d, phi, mysig.p)
_ck(ok_sign, "rsa: sign with our own blinded private-key operation")
ok_verify_own := _rsa_verify_pkcs1(SSH_HASH_SHA256, digest.p, n.p, n.len, e.p, e.len, mysig.p, mysig.len)
_ck(ok_verify_own, "rsa: verify our own signature")
_ckhex(_hex_of(mysig.p, mysig.len), _RSA_TV_SIG, "rsa: our signature byte-for-byte matches openssl's")
mut baddigest := NewBuf(32)
BufPutBytes(baddigest, digest.p, 32)
_bput(baddigest.p, 0, _bget(baddigest.p, 0) ^ 0x01)
ok_bad := _rsa_verify_pkcs1(SSH_HASH_SHA256, baddigest.p, n.p, n.len, e.p, e.len, refsig.p, refsig.len)
_ck(not ok_bad, "rsa: a tampered digest is rejected")
FreeBuf(n)
FreeBuf(e)
FreeBuf(d)
FreeBuf(phi)
FreeBuf(digest)
FreeBuf(refsig)
FreeBuf(mysig)
FreeBuf(baddigest)
end
package ssh
func _selftest_sftp():
mut b0 := NewBuf(4)
BufPutUint32(b0, 0 as u32)
mut r0 := NewReader(b0.p, b0.len)
info0 := _sftp_parse_attrs(r0)
_ck(not r0.bad, "sftp attrs: flags=0 reads cleanly with nothing left to consume")
_ck(info0.size == (0 as i64), "sftp attrs: flags=0 leaves size at its zero default")
_ck(not info0.is_dir, "sftp attrs: flags=0 leaves is_dir at its false default")
FreeBuf(b0)
mut b1 := NewBuf(12)
BufPutUint32(b1, SFTP_ATTR_SIZE as u32)
BufPutUint64(b1, 123456 as u64)
mut r1 := NewReader(b1.p, b1.len)
info1 := _sftp_parse_attrs(r1)
_ck(not r1.bad, "sftp attrs: SIZE-only decodes without error")
_ck(info1.size == (123456 as i64), "sftp attrs: SIZE field value round-trips")
FreeBuf(b1)
mut b2 := NewBuf(8)
BufPutUint32(b2, SFTP_ATTR_PERMISSIONS as u32)
BufPutUint32(b2, 0x41ED as u32)
mut r2 := NewReader(b2.p, b2.len)
info2 := _sftp_parse_attrs(r2)
_ck(info2.permissions == (0x41ED as u32), "sftp attrs: PERMISSIONS field value round-trips")
_ck(info2.is_dir, "sftp attrs: S_IFDIR permission bits set is_dir")
FreeBuf(b2)
mut b3 := NewBuf(8)
BufPutUint32(b3, SFTP_ATTR_PERMISSIONS as u32)
BufPutUint32(b3, 0x81A4 as u32)
mut r3 := NewReader(b3.p, b3.len)
info3 := _sftp_parse_attrs(r3)
_ck(not info3.is_dir, "sftp attrs: S_IFREG permission bits do NOT set is_dir")
FreeBuf(b3)
mut b4 := NewBuf(32)
BufPutUint32(b4, 0x0000000F as u32)
BufPutUint64(b4, 999 as u64)
BufPutUint32(b4, 1000 as u32)
BufPutUint32(b4, 1000 as u32)
BufPutUint32(b4, 0x81A4 as u32)
BufPutUint32(b4, 1700000000 as u32)
BufPutUint32(b4, 1700000001 as u32)
BufPutUint32(b4, 0xCAFEBABE as u32)
mut r4 := NewReader(b4.p, b4.len)
info4 := _sftp_parse_attrs(r4)
_ck(not r4.bad, "sftp attrs: all four optional groups together decode without error")
_ck(info4.size == (999 as i64), "sftp attrs: SIZE survives alongside UIDGID/PERMISSIONS/ACMODTIME")
_ck(info4.permissions == (0x81A4 as u32), "sftp attrs: PERMISSIONS survives alongside the other groups")
marker := RGetUint32(r4)
_ck(not r4.bad and marker == (0xCAFEBABE as u32), "sftp attrs: the byte immediately after all four groups is read at the right offset")
FreeBuf(b4)
mut cf1 := NewBuf(8)
repeat 8 in i:
BufPutByte(cf1, i)
end
_buf_consume_front(cf1, 3)
_ck(cf1.len == 5, "consume-front: dropping 3 of 8 bytes leaves len 5")
_ckhex(_hex_of(cf1.p, 5), "0304050607", "consume-front: remaining bytes shift down correctly")
FreeBuf(cf1)
mut cf2 := NewBuf(4)
repeat 4 in i:
BufPutByte(cf2, i)
end
_buf_consume_front(cf2, 0)
_ck(cf2.len == 4, "consume-front: n=0 is a no-op")
FreeBuf(cf2)
mut cf3 := NewBuf(4)
repeat 4 in i:
BufPutByte(cf3, i)
end
_buf_consume_front(cf3, 4)
_ck(cf3.len == 0, "consume-front: consuming exactly len bytes empties the buffer")
FreeBuf(cf3)
mut cf4 := NewBuf(4)
repeat 4 in i:
BufPutByte(cf4, i)
end
_buf_consume_front(cf4, 100)
_ck(cf4.len == 0, "consume-front: consuming more than len clamps to empty rather than going negative")
FreeBuf(cf4)
end
package ssh
const _X25519_TV_A := "030a11181f262d343b424950575e656c737a81888f969da4abb2b9c0c7ced5dc"
const _X25519_TV_B := "c9d6e3f0fd0a1724313e4b5865727f8c99a6b3c0cddae7f4010e1b2835424f5c"
func _selftest_x25519():
mut alice_sk := _hexbuf(_X25519_TV_A)
mut bob_sk := _hexbuf(_X25519_TV_B)
_ck(alice_sk.len == 32, "x25519: test scalar A is 32 bytes")
_ck(bob_sk.len == 32, "x25519: test scalar B is 32 bytes")
mut alice_pk := NewBuf(32)
BufPutZeros(alice_pk, 32)
_x25519_base(alice_sk.p, alice_pk.p)
mut bob_pk := NewBuf(32)
BufPutZeros(bob_pk, 32)
_x25519_base(bob_sk.p, bob_pk.p)
mut apk_or := 0
repeat 32 in i:
apk_or |= _bget(alice_pk.p, i)
end
_ck(apk_or != 0, "x25519: base-point multiply is non-trivial")
mut shared1 := NewBuf(32)
BufPutZeros(shared1, 32)
ok1 := _x25519_shared(alice_sk.p, bob_pk.p, shared1.p)
mut shared2 := NewBuf(32)
BufPutZeros(shared2, 32)
ok2 := _x25519_shared(bob_sk.p, alice_pk.p, shared2.p)
_ck(ok1 and ok2, "x25519: shared secret computed on both sides")
_ckhex(_hex_of(shared1.p, 32), _hex_of(shared2.p, 32), "x25519: ECDH is commutative (Alice==Bob)")
FreeBuf(alice_sk)
FreeBuf(bob_sk)
FreeBuf(alice_pk)
FreeBuf(bob_pk)
FreeBuf(shared1)
FreeBuf(shared2)
end
package ssh
import str
@en "Session"
@fa "نشست"
pub struct Session:
@en "ch"
@fa "کانال"
pub ch: Channel = Channel {}
@en "ok"
@fa "موفق"
pub ok: bool = false
end
@en "ExecResult"
@fa "نتیجه اجرا"
pub struct ExecResult:
@en "stdout"
@fa "خروجی"
pub stdout: str = ""
@en "stderr"
@fa "خروجی خطا"
pub stderr: str = ""
@en "exit_code"
@fa "کد خروج"
pub exit_code: int = 0 - 1
@en "ok"
@fa "موفق"
pub ok: bool = false
end
func _buf_to_str_lossy(b: Buf): str:
if b.len == 0:
ret ""
end
mut z := NewBuf(b.len + 1)
BufPutBuf(z, b)
BufPutByte(z, 0)
ret str.Clone(z.p as str)
end
@en "NewSession"
@fa "نشست جدید"
pub func NewSession(client &: Client): Session:
mut s := Session {}
s.ch = _channel_open_session(client.transport)
s.ok = s.ch.open
ret s
end
@en "RequestPty"
@fa "درخواست پی تی وای"
pub func RequestPty(session &: Session, client &: Client, term: str, cols: int, rows: int): bool:
ret _channel_pty(client.transport, session.ch, term, cols, rows)
end
@en "Start"
@fa "شروع"
pub func Start(session &: Session, client &: Client, cmd: str): bool:
ret _channel_exec(client.transport, session.ch, cmd)
end
@en "Shell"
@fa "پوسته"
pub func Shell(session &: Session, client &: Client): bool:
ret _channel_shell(client.transport, session.ch)
end
@en "Wait"
@fa "انتظار"
pub func Wait(session &: Session, client &: Client): int:
_channel_pump_to_close(client.transport, session.ch)
ret session.ch.exit_status
end
@en "ReadStep"
@fa "گام خواندن"
pub func ReadStep(session &: Session, client &: Client): bool:
code := _channel_pump_step(client.transport, session.ch)
ret code != 3 and code != (0 - 1)
end
@en "Output"
@fa "خروجی"
pub func Output(session: Session): str:
ret _buf_to_str_lossy(session.ch.stdout)
end
@en "StderrOutput"
@fa "خروجی خطا"
pub func StderrOutput(session: Session): str:
ret _buf_to_str_lossy(session.ch.stderr)
end
@en "DrainOutput"
@fa "تخلیه خروجی"
pub func DrainOutput(session &: Session): str:
out := _buf_to_str_lossy(session.ch.stdout)
FreeBuf(session.ch.stdout)
session.ch.stdout = NewBuf(256)
ret out
end
@en "DrainStderrOutput"
@fa "تخلیه خروجی خطا"
pub func DrainStderrOutput(session &: Session): str:
out := _buf_to_str_lossy(session.ch.stderr)
FreeBuf(session.ch.stderr)
session.ch.stderr = NewBuf(256)
ret out
end
@en "ExitCode"
@fa "کد خروج"
pub func ExitCode(session: Session): int:
ret session.ch.exit_status
end
@en "SessionClosed"
@fa "نشست بسته شده"
pub func SessionClosed(session: Session): bool:
ret session.ch.close_received
end
@en "WriteInput"
@fa "نوشتن ورودی"
pub func WriteInput(session &: Session, client &: Client, data: str): bool:
ret _channel_write(client.transport, session.ch, data as void*, data.len())
end
@en "CloseInput"
@fa "بستن ورودی"
pub func CloseInput(session &: Session, client &: Client):
_channel_send_eof(client.transport, session.ch)
end
@en "CloseSession"
@fa "بستن نشست"
pub func CloseSession(session &: Session, client &: Client):
if not session.ch.close_received:
_channel_send_eof(client.transport, session.ch)
_channel_send_close(client.transport, session.ch)
end
_channel_free(session.ch)
end
@en "Exec"
@fa "اجرا"
pub func Exec(client &: Client, cmd: str): ExecResult:
mut result := ExecResult {}
mut s := NewSession(client)
if not s.ok:
ret result
end
if not Start(s, client, cmd):
CloseSession(s, client)
ret result
end
exit_code := Wait(s, client)
result.stdout = Output(s)
result.stderr = StderrOutput(s)
result.exit_code = exit_code
result.ok = true
CloseSession(s, client)
ret result
end
package ssh
import os
import mem
import str
import fs
import fs.dir
import filepath
extern:
func fopen(path: str, mode: str): void*
func fclose(stream: void*): int
func fread(ptr: void*, size: u64, nmemb: u64, stream: void*): u64
func fwrite(ptr: void*, size: u64, nmemb: u64, stream: void*): u64
end
const SSH_FXP_INIT := 1
const SSH_FXP_VERSION := 2
const SSH_FXP_OPEN := 3
const SSH_FXP_CLOSE := 4
const SSH_FXP_READ := 5
const SSH_FXP_WRITE := 6
const SSH_FXP_LSTAT := 7
const SSH_FXP_FSTAT := 8
const SSH_FXP_OPENDIR := 11
const SSH_FXP_READDIR := 12
const SSH_FXP_REMOVE := 13
const SSH_FXP_MKDIR := 14
const SSH_FXP_RMDIR := 15
const SSH_FXP_REALPATH := 16
const SSH_FXP_STAT := 17
const SSH_FXP_RENAME := 18
const SSH_FXP_STATUS := 101
const SSH_FXP_HANDLE := 102
const SSH_FXP_DATA := 103
const SSH_FXP_NAME := 104
const SSH_FXP_ATTRS := 105
const SSH_FXF_READ := 0x00000001
const SSH_FXF_WRITE := 0x00000002
const SSH_FXF_CREAT := 0x00000008
const SSH_FXF_TRUNC := 0x00000010
const SSH_FX_OK := 0
const SSH_FX_EOF := 1
const SFTP_ATTR_SIZE := 0x00000001
const SFTP_ATTR_PERMISSIONS := 0x00000004
const _SFTP_CHUNK := 32768
const _RAW_IO_CHUNK := 65536
struct SftpPacket:
pub msgtype: int = 0 - 1
pub body: Reader = Reader {}
pub bodybuf: Buf = Buf {}
pub ok: bool = false
end
@en "Sftp"
@fa "اس اف تی پی"
pub struct Sftp:
@en "ch"
@fa "کانال"
pub ch: Channel = Channel {}
@en "ok"
@fa "موفق"
pub ok: bool = false
@en "next_id"
@fa "شناسه بعدی"
pub next_id: u32 = 1 as u32
end
@en "SftpFileInfo"
@fa "اطلاعات فایل اس اف تی پی"
pub struct SftpFileInfo:
@en "name"
@fa "نام"
pub name: str = ""
@en "size"
@fa "اندازه"
pub size: i64 = 0 as i64
@en "is_dir"
@fa "پوشه است"
pub is_dir: bool = false
@en "permissions"
@fa "مجوزها"
pub permissions: u32 = 0 as u32
end
func _fs_import_workaround(): i64:
ret fs.ModTime(".")
end
func _read_file_bytes(path: str): Buf:
stream := fopen(path, "rb")
if stream == null:
ret NewBuf(0)
end
mut contents := NewBuf(_RAW_IO_CHUNK)
mut chunk := NewBuf(_RAW_IO_CHUNK)
BufPutZeros(chunk, _RAW_IO_CHUNK)
mut reading := true
until reading:
n_read := fread(chunk.p, 1 as u64, _RAW_IO_CHUNK as u64, stream)
if n_read == (0 as u64):
reading = false
else:
BufPutBytes(contents, chunk.p, n_read as int)
if n_read < (_RAW_IO_CHUNK as u64):
reading = false
end
end
end
FreeBuf(chunk)
fclose(stream)
ret contents
end
func _write_file_bytes(path: str, bytes: void*, n: int): bool:
stream := fopen(path, "wb")
if stream == null:
ret false
end
written := fwrite(bytes, 1 as u64, n as u64, stream)
fclose(stream)
ret written == (n as u64)
end
func _sftp_alloc_id(sftp &: Sftp): u32:
id := sftp.next_id
sftp.next_id++
ret id
end
func _buf_consume_front(b &: Buf, n: int):
if n <= 0:
ret
end
if n >= b.len:
b.len = 0
ret
end
remaining := b.len - n
mem.Copy(b.p, (b.p as i64 + n) as void*, remaining as u64)
b.len = remaining
end
func _sftp_send(t &: Transport, sftp &: Sftp, msgtype: int, body: Buf): bool:
mut pkt := NewBuf(5 + body.len)
BufPutUint32(pkt, (1 + body.len) as u32)
BufPutByte(pkt, msgtype)
BufPutBuf(pkt, body)
ok := _channel_write(t, sftp.ch, pkt.p, pkt.len)
FreeBuf(pkt)
ret ok
end
func _sftp_read_packet(t &: Transport, sftp &: Sftp): SftpPacket:
mut steps := 0
until sftp.ch.stdout.len < 4 and steps < 200000:
code := _channel_pump_step(t, sftp.ch)
if code == (0 - 1) or code == 3:
ret SftpPacket {}
end
steps++
end
if sftp.ch.stdout.len < 4:
ret SftpPacket {}
end
payload_len := ((_bget(sftp.ch.stdout.p, 0) as u32) << (24 as u32)) | ((_bget(sftp.ch.stdout.p, 1) as u32) << (16 as u32)) | ((_bget(sftp.ch.stdout.p, 2) as u32) << (8 as u32)) | (_bget(sftp.ch.stdout.p, 3) as u32)
packet_len := 4 + (payload_len as int)
until sftp.ch.stdout.len < packet_len and steps < 200000:
code := _channel_pump_step(t, sftp.ch)
if code == (0 - 1) or code == 3:
ret SftpPacket {}
end
steps++
end
if sftp.ch.stdout.len < packet_len:
ret SftpPacket {}
end
msgtype := _bget(sftp.ch.stdout.p, 4)
mut body := NewBuf(payload_len as int - 1)
BufPutBytes(body, (sftp.ch.stdout.p as i64 + 5) as void*, (payload_len as int) - 1)
_buf_consume_front(sftp.ch.stdout, packet_len)
mut pkt := SftpPacket {}
pkt.msgtype = msgtype
pkt.bodybuf = body
pkt.body = ReaderFromBuf(body)
pkt.ok = true
ret pkt
end
func _sftp_expect_status_ok(t &: Transport, sftp &: Sftp): bool:
pkt := _sftp_read_packet(t, sftp)
if not pkt.ok:
ret false
end
ok := pkt.msgtype == SSH_FXP_STATUS
mut r := pkt.body
_id := RGetUint32(r)
code := RGetUint32(r)
result := ok and not r.bad and code == (SSH_FX_OK as u32)
FreeBuf(pkt.bodybuf)
ret result
end
func _sftp_open_handle(t &: Transport, sftp &: Sftp, path: str, pflags: u32): Buf:
id := _sftp_alloc_id(sftp)
mut body := NewBuf(32 + path.len())
BufPutUint32(body, id)
BufPutStringStr(body, path)
BufPutUint32(body, pflags)
BufPutUint32(body, 0 as u32)
ok := _sftp_send(t, sftp, SSH_FXP_OPEN, body)
FreeBuf(body)
if not ok:
ret NewBuf(0)
end
pkt := _sftp_read_packet(t, sftp)
if not pkt.ok or pkt.msgtype != SSH_FXP_HANDLE:
FreeBuf(pkt.bodybuf)
ret NewBuf(0)
end
mut r := pkt.body
_rid := RGetUint32(r)
mut handle := RGetStringCopy(r)
FreeBuf(pkt.bodybuf)
if r.bad:
FreeBuf(handle)
ret NewBuf(0)
end
ret handle
end
func _sftp_close_handle(t &: Transport, sftp &: Sftp, handle: Buf):
id := _sftp_alloc_id(sftp)
mut body := NewBuf(8 + handle.len)
BufPutUint32(body, id)
BufPutStringBuf(body, handle)
_sent_ok := _sftp_send(t, sftp, SSH_FXP_CLOSE, body)
FreeBuf(body)
_status_ok := _sftp_expect_status_ok(t, sftp)
end
func _sftp_parse_attrs(r &: Reader): SftpFileInfo:
mut info := SftpFileInfo {}
flags := RGetUint32(r)
if (flags & (SFTP_ATTR_SIZE as u32)) != (0 as u32):
info.size = RGetUint64(r) as i64
end
if (flags & (0x00000002 as u32)) != (0 as u32):
_uid := RGetUint32(r)
_gid := RGetUint32(r)
end
if (flags & (SFTP_ATTR_PERMISSIONS as u32)) != (0 as u32):
info.permissions = RGetUint32(r)
info.is_dir = (info.permissions & (0xF000 as u32)) == (0x4000 as u32)
end
if (flags & (0x00000008 as u32)) != (0 as u32):
_atime := RGetUint32(r)
_mtime := RGetUint32(r)
end
ret info
end
@en "SftpOpen"
@fa "باز کردن اس اف تی پی"
pub func SftpOpen(client &: Client): Sftp:
_fs_workaround_probe := _fs_import_workaround()
mut sftp := Sftp {}
sftp.ch = _channel_open_session(client.transport)
sftp.next_id = 1 as u32
if not sftp.ch.open:
ret sftp
end
mut extra := NewBuf(16)
BufPutStringStr(extra, "sftp")
if not _channel_send_request(client.transport, sftp.ch, "subsystem", true, extra):
FreeBuf(extra)
ret sftp
end
FreeBuf(extra)
mut init_body := NewBuf(4)
BufPutUint32(init_body, 3 as u32)
if not _sftp_send(client.transport, sftp, SSH_FXP_INIT, init_body):
FreeBuf(init_body)
ret sftp
end
FreeBuf(init_body)
pkt := _sftp_read_packet(client.transport, sftp)
if pkt.ok and pkt.msgtype == SSH_FXP_VERSION:
sftp.ok = true
end
FreeBuf(pkt.bodybuf)
ret sftp
end
@en "SftpClose"
@fa "بستن اس اف تی پی"
pub func SftpClose(client &: Client, sftp &: Sftp):
_channel_send_eof(client.transport, sftp.ch)
_channel_send_close(client.transport, sftp.ch)
_channel_free(sftp.ch)
sftp.ok = false
end
@en "Upload"
@fa "بارگذاری"
pub func Upload(client &: Client, sftp &: Sftp, local_path: str, remote_path: str): bool:
if not os.Exists(local_path):
ret false
end
mut handle := _sftp_open_handle(client.transport, sftp, remote_path, (SSH_FXF_WRITE | SSH_FXF_CREAT | SSH_FXF_TRUNC) as u32)
if handle.len == 0:
ret false
end
mut content := _read_file_bytes(local_path)
total := content.len
mut offset := 0 as u64
mut ok := true
mut sent := 0
until sent < total and ok:
mut chunk := total - sent
if chunk > _SFTP_CHUNK:
chunk = _SFTP_CHUNK
end
id := _sftp_alloc_id(sftp)
mut body := NewBuf(24 + handle.len + chunk)
BufPutUint32(body, id)
BufPutStringBuf(body, handle)
BufPutUint64(body, offset)
BufPutString(body, (content.p as i64 + sent) as void*, chunk)
ok = _sftp_send(client.transport, sftp, SSH_FXP_WRITE, body)
FreeBuf(body)
if ok:
ok = _sftp_expect_status_ok(client.transport, sftp)
end
offset += (chunk as u64)
sent += chunk
end
_sftp_close_handle(client.transport, sftp, handle)
FreeBuf(handle)
FreeBuf(content)
ret ok
end
@en "Download"
@fa "دانلود"
pub func Download(client &: Client, sftp &: Sftp, remote_path: str, local_path: str): bool:
mut handle := _sftp_open_handle(client.transport, sftp, remote_path, SSH_FXF_READ as u32)
if handle.len == 0:
ret false
end
mut downloaded := NewBuf(_RAW_IO_CHUNK)
mut offset := 0 as u64
mut done := false
mut ok := true
until not done and ok:
id := _sftp_alloc_id(sftp)
mut body := NewBuf(20 + handle.len)
BufPutUint32(body, id)
BufPutStringBuf(body, handle)
BufPutUint64(body, offset)
BufPutUint32(body, _SFTP_CHUNK as u32)
ok = _sftp_send(client.transport, sftp, SSH_FXP_READ, body)
FreeBuf(body)
if not ok:
continue
end
pkt := _sftp_read_packet(client.transport, sftp)
if not pkt.ok:
ok = false
else if pkt.msgtype == SSH_FXP_STATUS:
mut r := pkt.body
_rid := RGetUint32(r)
_status_code := RGetUint32(r)
done = true
FreeBuf(pkt.bodybuf)
else if pkt.msgtype == SSH_FXP_DATA:
mut r := pkt.body
_rid := RGetUint32(r)
data := RGetStringView(r)
if r.bad:
ok = false
else:
BufPutBytes(downloaded, data.p, data.len)
offset += (data.len as u64)
if data.len == 0:
done = true
end
end
FreeBuf(pkt.bodybuf)
else:
FreeBuf(pkt.bodybuf)
ok = false
end
end
_sftp_close_handle(client.transport, sftp, handle)
FreeBuf(handle)
if ok:
ok = _write_file_bytes(local_path, downloaded.p, downloaded.len)
end
FreeBuf(downloaded)
ret ok
end
@en "Mkdir"
@fa "ساخت پوشه"
pub func Mkdir(client &: Client, sftp &: Sftp, path: str): bool:
id := _sftp_alloc_id(sftp)
mut body := NewBuf(32 + path.len())
BufPutUint32(body, id)
BufPutStringStr(body, path)
BufPutUint32(body, 0 as u32)
ok := _sftp_send(client.transport, sftp, SSH_FXP_MKDIR, body)
FreeBuf(body)
if not ok:
ret false
end
ret _sftp_expect_status_ok(client.transport, sftp)
end
@en "Remove"
@fa "حذف"
pub func Remove(client &: Client, sftp &: Sftp, path: str): bool:
id := _sftp_alloc_id(sftp)
mut body := NewBuf(16 + path.len())
BufPutUint32(body, id)
BufPutStringStr(body, path)
ok := _sftp_send(client.transport, sftp, SSH_FXP_REMOVE, body)
FreeBuf(body)
if not ok:
ret false
end
ret _sftp_expect_status_ok(client.transport, sftp)
end
@en "Rmdir"
@fa "حذف پوشه"
pub func Rmdir(client &: Client, sftp &: Sftp, path: str): bool:
id := _sftp_alloc_id(sftp)
mut body := NewBuf(16 + path.len())
BufPutUint32(body, id)
BufPutStringStr(body, path)
ok := _sftp_send(client.transport, sftp, SSH_FXP_RMDIR, body)
FreeBuf(body)
if not ok:
ret false
end
ret _sftp_expect_status_ok(client.transport, sftp)
end
@en "Rename"
@fa "تغییر نام"
pub func Rename(client &: Client, sftp &: Sftp, old_path: str, new_path: str): bool:
id := _sftp_alloc_id(sftp)
mut body := NewBuf(32 + old_path.len() + new_path.len())
BufPutUint32(body, id)
BufPutStringStr(body, old_path)
BufPutStringStr(body, new_path)
ok := _sftp_send(client.transport, sftp, SSH_FXP_RENAME, body)
FreeBuf(body)
if not ok:
ret false
end
ret _sftp_expect_status_ok(client.transport, sftp)
end
@en "Stat"
@fa "وضعیت"
pub func Stat(client &: Client, sftp &: Sftp, path: str): SftpFileInfo:
id := _sftp_alloc_id(sftp)
mut body := NewBuf(16 + path.len())
BufPutUint32(body, id)
BufPutStringStr(body, path)
ok := _sftp_send(client.transport, sftp, SSH_FXP_STAT, body)
FreeBuf(body)
if not ok:
ret SftpFileInfo {}
end
pkt := _sftp_read_packet(client.transport, sftp)
if not pkt.ok or pkt.msgtype != SSH_FXP_ATTRS:
FreeBuf(pkt.bodybuf)
ret SftpFileInfo {}
end
mut r := pkt.body
_rid := RGetUint32(r)
info := _sftp_parse_attrs(r)
FreeBuf(pkt.bodybuf)
info.name = path
ret info
end
@en "Exists"
@fa "وجود دارد"
pub func Exists(client &: Client, sftp &: Sftp, path: str): bool:
id := _sftp_alloc_id(sftp)
mut body := NewBuf(16 + path.len())
BufPutUint32(body, id)
BufPutStringStr(body, path)
ok := _sftp_send(client.transport, sftp, SSH_FXP_STAT, body)
FreeBuf(body)
if not ok:
ret false
end
pkt := _sftp_read_packet(client.transport, sftp)
result := pkt.ok and pkt.msgtype == SSH_FXP_ATTRS
FreeBuf(pkt.bodybuf)
ret result
end
@en "ListDir"
@fa "لیست پوشه"
pub func ListDir(client &: Client, sftp &: Sftp, path: str): Vector<SftpFileInfo>:
mut entries := Vector {} as Vector<SftpFileInfo>
id := _sftp_alloc_id(sftp)
mut body := NewBuf(16 + path.len())
BufPutUint32(body, id)
BufPutStringStr(body, path)
ok := _sftp_send(client.transport, sftp, SSH_FXP_OPENDIR, body)
FreeBuf(body)
if not ok:
ret entries
end
open_pkt := _sftp_read_packet(client.transport, sftp)
if not open_pkt.ok or open_pkt.msgtype != SSH_FXP_HANDLE:
FreeBuf(open_pkt.bodybuf)
ret entries
end
mut open_reader := open_pkt.body
_open_rid := RGetUint32(open_reader)
mut handle := RGetStringCopy(open_reader)
FreeBuf(open_pkt.bodybuf)
mut done := false
until not done:
read_id := _sftp_alloc_id(sftp)
mut read_body := NewBuf(8 + handle.len)
BufPutUint32(read_body, read_id)
BufPutStringBuf(read_body, handle)
read_ok := _sftp_send(client.transport, sftp, SSH_FXP_READDIR, read_body)
FreeBuf(read_body)
if not read_ok:
done = true
continue
end
pkt := _sftp_read_packet(client.transport, sftp)
if not pkt.ok:
done = true
continue
end
if pkt.msgtype == SSH_FXP_STATUS:
done = true
FreeBuf(pkt.bodybuf)
continue
end
if pkt.msgtype != SSH_FXP_NAME:
done = true
FreeBuf(pkt.bodybuf)
continue
end
mut r := pkt.body
_rid := RGetUint32(r)
count := RGetUint32(r) as int
repeat count:
entry_name := RGetStringAsStr(r)
_longname := RGetStringAsStr(r)
info := _sftp_parse_attrs(r)
if not str.Equals(entry_name, ".") and not str.Equals(entry_name, ".."):
mut entry := info
entry.name = entry_name
entries.push(entry)
end
end
FreeBuf(pkt.bodybuf)
end
_sftp_close_handle(client.transport, sftp, handle)
FreeBuf(handle)
ret entries
end
@en "SftpMkdirAll"
@fa "ساخت مسیر کامل"
pub func MkdirAll(client &: Client, sftp &: Sftp, path: str): bool:
parts := str.Split(path, "/")
defer parts.free()
absolute := path.starts_with("/")
mut cur := ""
each part in parts:
if part.len() > 0:
if cur.len() == 0:
if absolute:
cur = "/" + part
else:
cur = part
end
else:
cur = cur + "/" + part
end
if not Exists(client, sftp, cur):
Mkdir(client, sftp, cur)
end
end
end
info := Stat(client, sftp, path)
ret info.is_dir
end
@en "SftpRemoveAll"
@fa "حذف همه"
pub func RemoveAll(client &: Client, sftp &: Sftp, path: str): bool:
info := Lstat(client, sftp, path)
is_link := (info.permissions & (0xF000 as u32)) == (0xA000 as u32)
if is_link or not info.is_dir:
ret Remove(client, sftp, path)
end
entries := ListDir(client, sftp, path)
defer entries.free()
mut ok := true
each e in entries:
if e.name != "." and e.name != "..":
child := path + "/" + e.name
if e.is_dir and not IsLink(client, sftp, child):
if not RemoveAll(client, sftp, child): ok = false end
else:
if not Remove(client, sftp, child): ok = false end
end
end
end
if not Rmdir(client, sftp, path): ok = false end
ret ok
end
@en "SftpDownloadDir"
@fa "دریافت پوشه"
pub func DownloadDir(client &: Client, sftp &: Sftp, remote_path: str, local_path: str): bool:
if not Stat(client, sftp, remote_path).is_dir:
ret false
end
dir.MkdirAll(local_path)
if not os.IsDir(local_path):
ret false
end
entries := ListDir(client, sftp, remote_path)
defer entries.free()
mut ok := true
each e in entries:
if e.name != "." and e.name != ".." and e.name.find("/") < 0 and e.name.len() > 0:
rchild := remote_path + "/" + e.name
lchild := filepath.Join(local_path, e.name)
if e.is_dir:
if not DownloadDir(client, sftp, rchild, lchild): ok = false end
else:
if not Download(client, sftp, rchild, lchild): ok = false end
end
end
end
ret ok
end
@en "SftpUploadDir"
@fa "ارسال پوشه"
pub func UploadDir(client &: Client, sftp &: Sftp, local_path: str, remote_path: str): bool:
if not os.IsDir(local_path) or not MkdirAll(client, sftp, remote_path):
ret false
end
names := os.ListDir(local_path)
defer names.free()
mut ok := true
each name in names:
if name != "." and name != "..":
lchild := filepath.Join(local_path, name)
rchild := remote_path + "/" + name
if os.IsDir(lchild):
if not UploadDir(client, sftp, lchild, rchild): ok = false end
else:
if not Upload(client, sftp, lchild, rchild): ok = false end
end
end
end
ret ok
end
@en "SftpLstat"
@fa "وضعیت پیوند"
pub func Lstat(client &: Client, sftp &: Sftp, path: str): SftpFileInfo:
id := _sftp_alloc_id(sftp)
mut body := NewBuf(16 + path.len())
BufPutUint32(body, id)
BufPutStringStr(body, path)
ok := _sftp_send(client.transport, sftp, SSH_FXP_LSTAT, body)
FreeBuf(body)
if not ok:
ret SftpFileInfo {}
end
pkt := _sftp_read_packet(client.transport, sftp)
if not pkt.ok or pkt.msgtype != SSH_FXP_ATTRS:
FreeBuf(pkt.bodybuf)
ret SftpFileInfo {}
end
mut r := pkt.body
_rid := RGetUint32(r)
mut info := _sftp_parse_attrs(r)
FreeBuf(pkt.bodybuf)
info.name = path
ret info
end
@en "SftpIsLink"
@fa "پیوند است"
pub func IsLink(client &: Client, sftp &: Sftp, path: str): bool:
info := Lstat(client, sftp, path)
ret (info.permissions & (0xF000 as u32)) == (0xA000 as u32)
end
@en "ssh"
@fa "اس اس اچ"
package ssh
@en "DefaultPort"
@fa "پورت پیش فرض"
pub const DefaultPort := 22
@en "ClientVersion"
@fa "نسخه کلاینت"
pub const ClientVersion := "SSH-2.0-Salam_1.0"
package ssh
import net.internal.rawsock
import str
import crypto
struct Transport:
pub ps: PacketState = PacketState {}
pub session_id: Buf = Buf {}
pub hostkey: HostKey = HostKey {}
pub cipher_name: str = ""
pub mac_name: str = ""
pub ok: bool = false
pub errmsg: str = ""
end
struct KexinitInfo:
pub kex: str = ""
pub hostkey_algo: str = ""
pub cipher: str = ""
pub mac: str = ""
pub ok: bool = false
end
func _transport_fail(msg: str): Transport:
mut t := Transport {}
t.ok = false
t.errmsg = msg
ret t
end
func _read_ident_line(sock: rawsock.Socket): str:
mut attempt := 0
until attempt < 50:
mut lb := NewBuf(128)
mut done := false
mut toolong := false
mut ch := NewBuf(1)
BufPutZeros(ch, 1)
until not done:
if not _read_exact(sock, ch.p, 1):
FreeBuf(ch)
FreeBuf(lb)
ret ""
end
b := _bget(ch.p, 0)
if b == 10:
done = true
else if b != 13:
if lb.len > 255:
toolong = true
else:
BufPutByte(lb, b)
end
end
end
FreeBuf(ch)
mut z := NewBuf(lb.len + 1)
BufPutBuf(z, lb)
BufPutByte(z, 0)
line := str.Clone(z.p as str)
FreeBuf(z)
FreeBuf(lb)
if not toolong and str.StartsWith(line, "SSH-"):
ret line
end
attempt++
end
ret ""
end
func _build_kexinit(): Buf:
mut b := NewBuf(256)
BufPutByte(b, SSH_MSG_KEXINIT)
mut cookie := NewBuf(16)
BufPutZeros(cookie, 16)
crypto.RandomBytes(cookie.p, 16)
BufPutBytes(b, cookie.p, 16)
FreeBuf(cookie)
BufPutStringStr(b, KEX_ALGORITHMS)
BufPutStringStr(b, HOSTKEY_ALGORITHMS)
BufPutStringStr(b, CIPHER_ALGORITHMS)
BufPutStringStr(b, CIPHER_ALGORITHMS)
BufPutStringStr(b, MAC_ALGORITHMS)
BufPutStringStr(b, MAC_ALGORITHMS)
BufPutStringStr(b, COMPRESSION_ALGORITHMS)
BufPutStringStr(b, COMPRESSION_ALGORITHMS)
BufPutStringStr(b, "")
BufPutStringStr(b, "")
BufPutBool(b, false)
BufPutUint32(b, 0 as u32)
ret b
end
func _parse_kexinit(payload: Buf): KexinitInfo:
mut r := ReaderFromBuf(payload)
msgtype := RGetByte(r)
if r.bad or msgtype != SSH_MSG_KEXINIT:
ret KexinitInfo {}
end
RSkip(r, 16)
kex_list := RGetNameList(r)
hostkey_list := RGetNameList(r)
enc_c2s := RGetNameList(r)
_enc_s2c := RGetNameList(r)
mac_c2s := RGetNameList(r)
_mac_s2c := RGetNameList(r)
_comp_c2s := RGetNameList(r)
_comp_s2c := RGetNameList(r)
_lang1 := RGetNameList(r)
_lang2 := RGetNameList(r)
_follows := RGetBool(r)
_reserved := RGetUint32(r)
if r.bad:
ret KexinitInfo {}
end
mut info := KexinitInfo {}
info.kex = NegotiateFirstMatch(KEX_ALGORITHMS, kex_list)
info.hostkey_algo = NegotiateFirstMatch(HOSTKEY_ALGORITHMS, hostkey_list)
info.cipher = NegotiateFirstMatch(CIPHER_ALGORITHMS, enc_c2s)
info.mac = NegotiateFirstMatch(MAC_ALGORITHMS, mac_c2s)
info.ok = info.kex.len() > 0 and info.hostkey_algo.len() > 0 and info.cipher.len() > 0 and info.mac.len() > 0
ret info
end
func _hash_bytes(sha256: bool, p: void*, n: int, out: void*):
if sha256:
crypto.Sha256Bytes(p, n, out)
ret
end
crypto.Sha1Bytes(p, n, out)
end
func _compute_exchange_hash(sha256: bool, client_ver: str, server_ver: str, i_c: Buf, i_s: Buf, hostkey_blob: Buf, client_kex_pub: Buf, server_kex_pub: Buf, k_mpint: Buf, curve25519: bool): Buf:
mut m := NewBuf(512)
BufPutStringStr(m, client_ver)
BufPutStringStr(m, server_ver)
BufPutStringBuf(m, i_c)
BufPutStringBuf(m, i_s)
BufPutStringBuf(m, hostkey_blob)
if curve25519:
BufPutStringBuf(m, client_kex_pub)
BufPutStringBuf(m, server_kex_pub)
else:
BufPutMpintBuf(m, client_kex_pub)
BufPutMpintBuf(m, server_kex_pub)
end
BufPutBuf(m, k_mpint)
hlen := sha256 ? 32 : 20
mut h := NewBuf(hlen)
BufPutZeros(h, hlen)
_hash_bytes(sha256, m.p, m.len, h.p)
FreeBuf(m)
ret h
end
@en "Handshake"
@fa "دست دهی"
func _transport_handshake(sock: rawsock.Socket): Transport:
mut ps := _packet_state_new(sock)
banner := ClientVersion + "\r\n"
sent := rawsock.SendBytes(sock, banner as void*, banner.len())
if sent != banner.len():
ret _transport_fail("failed to send version banner")
end
server_ver := _read_ident_line(sock)
if server_ver.len() == 0:
ret _transport_fail("server did not send an SSH identification string")
end
mut ckex := _build_kexinit()
if not _packet_send(ps, ckex):
FreeBuf(ckex)
ret _transport_fail("failed to send KEXINIT")
end
mut skex := _packet_recv(ps)
if skex.bad:
FreeBuf(ckex)
ret _transport_fail("failed to receive server KEXINIT")
end
info := _parse_kexinit(skex)
if not info.ok:
FreeBuf(ckex)
FreeBuf(skex)
ret _transport_fail("no compatible algorithm with server")
end
sha256 := _kex_uses_sha256(info.kex)
curve25519 := _kex_is_curve25519(info.kex)
mut hostkey_blob := NewBuf(1)
mut client_pub := NewBuf(1)
mut server_pub := NewBuf(1)
mut k_mpint := NewBuf(1)
mut sig_blob := NewBuf(1)
mut kex_ok := false
if curve25519:
mut sk := NewBuf(32)
BufPutZeros(sk, 32)
crypto.RandomBytes(sk.p, 32)
mut pk := NewBuf(32)
BufPutZeros(pk, 32)
_x25519_base(sk.p, pk.p)
mut initmsg := NewBuf(1 + 4 + 32)
BufPutByte(initmsg, SSH_MSG_KEXDH_INIT)
BufPutString(initmsg, pk.p, 32)
if _packet_send(ps, initmsg):
FreeBuf(initmsg)
mut reply := _packet_recv(ps)
if not reply.bad:
mut rr := ReaderFromBuf(reply)
msgtype := RGetByte(rr)
hostkey_blob = RGetStringCopy(rr)
mut server_q := RGetStringCopy(rr)
sig_blob = RGetStringCopy(rr)
if not rr.bad and msgtype == SSH_MSG_KEXDH_REPLY and server_q.len == 32:
mut shared := NewBuf(32)
BufPutZeros(shared, 32)
shared_ok := _x25519_shared(sk.p, server_q.p, shared.p)
if shared_ok:
FreeBuf(client_pub)
client_pub = NewBuf(32)
BufPutBuf(client_pub, pk)
FreeBuf(server_pub)
server_pub = server_q
FreeBuf(k_mpint)
k_mpint = NewBuf(36)
BufPutMpintBytes(k_mpint, shared.p, 32)
kex_ok = true
else:
FreeBuf(server_q)
end
FreeBuf(shared)
else:
FreeBuf(server_q)
end
end
FreeBuf(reply)
else:
FreeBuf(initmsg)
end
FreeBuf(sk)
FreeBuf(pk)
else:
kp := _dh14_generate()
mut initmsg := NewBuf(1 + 4 + kp.public.len)
BufPutByte(initmsg, SSH_MSG_KEXDH_INIT)
BufPutMpintBuf(initmsg, kp.public)
if _packet_send(ps, initmsg):
FreeBuf(initmsg)
mut reply := _packet_recv(ps)
if not reply.bad:
mut rr := ReaderFromBuf(reply)
msgtype := RGetByte(rr)
hostkey_blob = RGetStringCopy(rr)
mut server_f := RGetMpintCopy(rr)
sig_blob = RGetStringCopy(rr)
if not rr.bad and msgtype == SSH_MSG_KEXDH_REPLY:
mut shared := _dh14_shared(kp.secret, server_f)
if shared.len > 0:
FreeBuf(client_pub)
client_pub = NewBuf(kp.public.len)
BufPutBuf(client_pub, kp.public)
FreeBuf(server_pub)
server_pub = server_f
FreeBuf(k_mpint)
k_mpint = NewBuf(shared.len + 8)
BufPutMpintBytes(k_mpint, shared.p, shared.len)
kex_ok = true
else:
FreeBuf(server_f)
end
FreeBuf(shared)
else:
FreeBuf(server_f)
end
end
FreeBuf(reply)
else:
FreeBuf(initmsg)
end
FreeBuf(kp.secret)
FreeBuf(kp.public)
end
if not kex_ok:
FreeBuf(ckex)
FreeBuf(skex)
FreeBuf(hostkey_blob)
FreeBuf(client_pub)
FreeBuf(server_pub)
FreeBuf(k_mpint)
FreeBuf(sig_blob)
ret _transport_fail("key exchange failed")
end
hk := _hostkey_parse(hostkey_blob)
if not hk.ok:
FreeBuf(ckex)
FreeBuf(skex)
FreeBuf(hostkey_blob)
FreeBuf(client_pub)
FreeBuf(server_pub)
FreeBuf(k_mpint)
FreeBuf(sig_blob)
ret _transport_fail("could not parse server host key")
end
mut h := _compute_exchange_hash(sha256, ClientVersion, server_ver, ckex, skex, hostkey_blob, client_pub, server_pub, k_mpint, curve25519)
sig_ok := _hostkey_verify(hk, h, sig_blob)
FreeBuf(ckex)
FreeBuf(skex)
FreeBuf(client_pub)
FreeBuf(server_pub)
FreeBuf(sig_blob)
if not sig_ok:
FreeBuf(hostkey_blob)
FreeBuf(k_mpint)
FreeBuf(h)
ret _transport_fail("host key signature verification failed")
end
mut newkeys := NewBuf(1)
BufPutByte(newkeys, SSH_MSG_NEWKEYS)
if not _packet_send(ps, newkeys):
FreeBuf(newkeys)
FreeBuf(hostkey_blob)
FreeBuf(k_mpint)
FreeBuf(h)
ret _transport_fail("failed to send NEWKEYS")
end
FreeBuf(newkeys)
mut peer_newkeys := _packet_recv(ps)
peer_newkeys_ok := not peer_newkeys.bad and peer_newkeys.len == 1 and _bget(peer_newkeys.p, 0) == SSH_MSG_NEWKEYS
if not peer_newkeys_ok:
FreeBuf(peer_newkeys)
FreeBuf(hostkey_blob)
FreeBuf(k_mpint)
FreeBuf(h)
ret _transport_fail("did not receive NEWKEYS from server")
end
FreeBuf(peer_newkeys)
ekeylen := _cipher_key_len(info.cipher)
ivlen := _cipher_iv_len(info.cipher)
mkeylen := _mac_key_len(info.mac)
iv_c2s := _derive_key(sha256, k_mpint, h, h, KDF_IV_CTOS, ivlen)
iv_s2c := _derive_key(sha256, k_mpint, h, h, KDF_IV_STOC, ivlen)
mut key_c2s := _derive_key(sha256, k_mpint, h, h, KDF_KEY_CTOS, ekeylen)
mut key_s2c := _derive_key(sha256, k_mpint, h, h, KDF_KEY_STOC, ekeylen)
mac_c2s := _derive_key(sha256, k_mpint, h, h, KDF_MAC_CTOS, mkeylen)
mac_s2c := _derive_key(sha256, k_mpint, h, h, KDF_MAC_STOC, mkeylen)
ps.cipher_write = _aes_init(key_c2s.p, ekeylen)
ps.cipher_read = _aes_init(key_s2c.p, ekeylen)
ps.counter_write = iv_c2s
ps.counter_read = iv_s2c
ps.mac_kind_write = _mac_kind_for(info.mac)
ps.mac_kind_read = _mac_kind_for(info.mac)
ps.mac_key_write = mac_c2s
ps.mac_key_read = mac_s2c
ps.block_size_write = 16
ps.block_size_read = 16
ps.encrypted = true
FreeBuf(key_c2s)
FreeBuf(key_s2c)
mut t := Transport {}
t.ps = ps
t.session_id = h
t.hostkey = hk
t.cipher_name = info.cipher
t.mac_name = info.mac
t.ok = true
_unused_kmp := k_mpint
FreeBuf(k_mpint)
FreeBuf(hostkey_blob)
ret t
end
package ssh
const SSH_X25519_SIZE := 32
struct Gf:
pub v: i64[16] = [
0 as i64, 0 as i64, 0 as i64, 0 as i64
0 as i64, 0 as i64, 0 as i64, 0 as i64
0 as i64, 0 as i64, 0 as i64, 0 as i64
0 as i64, 0 as i64, 0 as i64, 0 as i64
]
end
func _gf_121665(): Gf:
mut g := Gf {}
g.v[0] = 0xDB41 as i64
g.v[1] = 1 as i64
ret g
end
func _gf_add(a: Gf, b: Gf): Gf:
mut o := Gf {}
repeat 16 in i:
o.v[i] = a.v[i] + b.v[i]
end
ret o
end
func _gf_sub(a: Gf, b: Gf): Gf:
mut o := Gf {}
repeat 16 in i:
o.v[i] = a.v[i] - b.v[i]
end
ret o
end
func _gf_car(o &: Gf):
repeat 16 in i:
o.v[i] += (1 as i64) << (16 as i64)
c := o.v[i] >> (16 as i64)
if i < 15:
o.v[i + 1] += c - 1
else:
o.v[0] += 38 * (c - 1)
end
o.v[i] -= c << (16 as i64)
end
end
func _gf_mul(a: Gf, b: Gf): Gf:
mut t: i64[31]
repeat 31 in i:
t[i] = 0 as i64
end
repeat 16 in i:
repeat 16 in j:
t[i + j] += a.v[i] * b.v[j]
end
end
repeat 15 in i:
t[i] += 38 * t[i + 16]
end
mut o := Gf {}
repeat 16 in i:
o.v[i] = t[i]
end
_gf_car(o)
_gf_car(o)
ret o
end
func _gf_sq(a: Gf): Gf:
ret _gf_mul(a, a)
end
func _gf_sel(p &: Gf, q &: Gf, b: int):
c := ~((b as i64) - (1 as i64))
repeat 16 in i:
t := c & (p.v[i] ^ q.v[i])
p.v[i] ^= t
q.v[i] ^= t
end
end
func _gf_unpack(p: void*): Gf:
mut o := Gf {}
repeat 16 in i:
o.v[i] = (_bget(p, 2 * i) as i64) + ((_bget(p, 2 * i + 1) as i64) << (8 as i64))
end
o.v[15] &= (0x7fff as i64)
ret o
end
func _gf_pack(n: Gf, out: void*):
mut t := n
_gf_car(t)
_gf_car(t)
_gf_car(t)
repeat 2:
mut m := Gf {}
m.v[0] = t.v[0] - (0xffed as i64)
mut i := 1
until i < 15:
m.v[i] = t.v[i] - (0xffff as i64) - ((m.v[i - 1] >> (16 as i64)) & (1 as i64))
m.v[i - 1] &= (0xffff as i64)
i++
end
m.v[15] = t.v[15] - (0x7fff as i64) - ((m.v[14] >> (16 as i64)) & (1 as i64))
b := ((m.v[15] >> (16 as i64)) & (1 as i64)) as int
m.v[14] &= (0xffff as i64)
_gf_sel(t, m, 1 - b)
end
repeat 16 in i:
_bput(out, 2 * i, (t.v[i] & (0xff as i64)) as int)
_bput(out, 2 * i + 1, ((t.v[i] >> (8 as i64)) & (0xff as i64)) as int)
end
end
func _gf_inv(i: Gf): Gf:
mut c := i
mut a := 253
until a >= 0:
c = _gf_sq(c)
if a != 2 and a != 4:
c = _gf_mul(c, i)
end
a--
end
ret c
end
func _x25519_scalarmult(scalar: void*, point: void*, out: void*):
mut z := NewBuf(32)
repeat 31 in i:
BufPutByte(z, _bget(scalar, i))
end
BufPutByte(z, (_bget(scalar, 31) & 127) | 64)
_bput(z.p, 0, _bget(z.p, 0) & 248)
x := _gf_unpack(point)
mut a := Gf {}
mut b := x
mut c := Gf {}
mut d := Gf {}
a.v[0] = 1 as i64
d.v[0] = 1 as i64
mut i := 254
until i >= 0:
r := (_bget(z.p, i >> 3) >> (i & 7)) & 1
_gf_sel(a, b, r)
_gf_sel(c, d, r)
mut e := _gf_add(a, c)
a = _gf_sub(a, c)
c = _gf_add(b, d)
b = _gf_sub(b, d)
d = _gf_sq(e)
f := _gf_sq(a)
a = _gf_mul(c, a)
c = _gf_mul(b, e)
e = _gf_add(a, c)
a = _gf_sub(a, c)
b = _gf_sq(a)
c = _gf_sub(d, f)
a = _gf_mul(c, _gf_121665())
a = _gf_add(a, d)
c = _gf_mul(c, a)
a = _gf_mul(d, f)
d = _gf_mul(b, x)
b = _gf_sq(e)
_gf_sel(a, b, r)
_gf_sel(c, d, r)
i--
end
c = _gf_inv(c)
a = _gf_mul(a, c)
_gf_pack(a, out)
WipeBuf(z)
end
func _x25519_base(scalar: void*, out: void*):
mut bp := NewBuf(32)
BufPutByte(bp, 9)
BufPutZeros(bp, 31)
_x25519_scalarmult(scalar, bp.p, out)
FreeBuf(bp)
end
func _x25519_shared(scalar: void*, peer: void*, out: void*): bool:
_x25519_scalarmult(scalar, peer, out)
mut acc := 0
repeat 32 in i:
acc |= _bget(out, i)
end
ret acc != 0
end
package ssl
@en "Wrap"
@fa "پوشاندن"
pub func Wrap(ctx: Context, fd: i64): Conn:
if ctx.handle == null or fd < 0:
ret Conn { handle = null }
end
s := mem.AllocateZeroed(sizeof(_Session) as u64) as _Session*
s[0] = _Session {}
s[0].ctx = ctx.handle
s[0].fd = fd
ret Conn { handle = s as void* }
end
@en "ConnOk"
@fa "اتصال معتبر"
pub func ConnOk(c: Conn): bool:
ret c.handle != null
end
@en "Connect"
@fa "اتصال برقرار کردن"
pub func Connect(c: Conn): bool:
if c.handle == null:
ret false
end
s := _session_of(c)
if s[0].attached:
ret s[0].live
end
cx := s[0].ctx as _Ctx*
if cx[0].server:
ret _fail(s, "Connect needs a client context")
end
mut cfg := tls.NewConfig(s[0].host)
cfg.ca_file = cx[0].ca_file
cfg.insecure_skip_verify = cx[0].verify == VERIFY_NONE
if not cfg.insecure_skip_verify and s[0].host.len() == 0:
ret _fail(s, "call SetHostname before Connect so the peer certificate can be checked")
end
s[0].conn = tls.WrapClient(s[0].fd, cfg)
if not _finish(s):
ret false
end
if cfg.insecure_skip_verify:
s[0].verify_result = _VERIFY_SKIPPED
else:
s[0].verify_result = CERT_OK
end
ret true
end
@en "Accept"
@fa "پذیرش"
pub func Accept(c: Conn): bool:
if c.handle == null:
ret false
end
s := _session_of(c)
if s[0].attached:
ret s[0].live
end
cx := s[0].ctx as _Ctx*
if not cx[0].server:
ret _fail(s, "Accept needs a server context")
end
s[0].conn = tls.WrapServer(s[0].fd, cx[0].scfg)
if not _finish(s):
ret false
end
s[0].verify_result = CERT_OK
ret true
end
@en "Read"
@fa "خواندن"
pub func Read(c: Conn, max: int): str:
if c.handle == null or max <= 0:
ret ""
end
s := _session_of(c)
if not s[0].live:
ret ""
end
ret tls.Read(s[0].conn, max)
end
@en "Write"
@fa "نوشتن"
pub func Write(c: Conn, data: str): int:
if c.handle == null:
ret 0
end
s := _session_of(c)
if not s[0].live:
ret 0
end
ret tls.Write(s[0].conn, data)
end
@en "Shutdown"
@fa "خاموش‌ کردن"
pub func Shutdown(c: Conn):
if c.handle == null:
ret
end
s := _session_of(c)
if s[0].live:
s[0].closed = true
end
_release(s)
end
@en "Close"
@fa "بستن"
pub func Close(c: Conn):
if c.handle == null:
ret
end
_release(_session_of(c))
mem.Free(c.handle)
end
package ssl
func _new_ctx(server: bool): Context:
p := mem.AllocateZeroed(sizeof(_Ctx) as u64) as _Ctx*
p[0] = _Ctx {}
p[0].server = server
ret Context { handle = p as void* }
end
@en "NewClientContext"
@fa "زمینه جدید مشتری"
pub func NewClientContext(): Context:
ret _new_ctx(false)
end
@en "NewServerContext"
@fa "زمینه جدید سرور"
pub func NewServerContext(cert_file: str, key_file: str): Context:
mut scfg := tls.NewServerConfig(cert_file, key_file)
if not scfg.ok:
tls.FreeRoots(scfg.chain)
tls.FreePrivateKey(scfg.key)
_last_error = "could not load the certificate or key file"
ret Context { handle = null }
end
ctx := _new_ctx(true)
p := _ctx_of(ctx)
p[0].scfg = scfg
ret ctx
end
@en "CtxOk"
@fa "زمینه معتبر"
pub func CtxOk(ctx: Context): bool:
ret ctx.handle != null
end
@en "SetVerify"
@fa "تنظیم تایید"
pub func SetVerify(ctx: Context, mode: int):
if ctx.handle == null:
ret
end
p := _ctx_of(ctx)
p[0].verify = mode
end
@en "LoadVerifyLocationsFile"
@fa "بارگذاری مکان تایید"
pub func LoadVerifyLocationsFile(ctx: Context, path: str): bool:
if ctx.handle == null:
ret false
end
mut roots := tls.LoadRoots(path)
n := tls.RootCount(roots)
tls.FreeRoots(roots)
if n == 0:
_last_error = "no certificates found in " + path
ret false
end
p := _ctx_of(ctx)
p[0].ca_file = path
ret true
end
@en "SetDefaultVerifyPaths"
@fa "تنظیم مسیرهای پیش‌فرض تایید"
pub func SetDefaultVerifyPaths(ctx: Context): bool:
if ctx.handle == null:
ret false
end
p := _ctx_of(ctx)
p[0].ca_file = ""
ret true
end
@en "SetMinVersion"
@fa "تنظیم کمینه نسخه"
pub func SetMinVersion(ctx: Context, version: i64): bool:
if ctx.handle == null or version < 0 or version > TLS1_3:
ret false
end
p := _ctx_of(ctx)
p[0].min_version = version
ret true
end
@en "CloseContext"
@fa "بستن زمینه"
pub func CloseContext(ctx: Context):
if ctx.handle == null:
ret
end
p := _ctx_of(ctx)
if p[0].server:
tls.FreeRoots(p[0].scfg.chain)
tls.FreePrivateKey(p[0].scfg.key)
end
mem.Free(ctx.handle)
end
package ssl
import str
@en "ErrorCode"
@fa "کد خطا"
pub func ErrorCode(c: Conn, rc: int): int:
if c.handle == null or rc > 0:
ret _ERROR_NONE
end
s := _session_of(c)
if s[0].err.len() > 0:
ret _ERROR_SSL
end
if s[0].closed:
ret _ERROR_ZERO_RETURN
end
ret _ERROR_SYSCALL
end
@en "ConnErrorString"
@fa "متن خطای اتصال"
pub func ConnErrorString(c: Conn): str:
if c.handle == null:
ret ""
end
ret str.Clone(_session_of(c)[0].err)
end
@en "LastErrorString"
@fa "آخرین متن خطا"
pub func LastErrorString(): str:
msg := _last_error
_last_error = ""
ret msg
end
@en "ssl"
@fa "اس اس ال"
package ssl
import mem
import tls
@en "VERIFY_NONE"
@fa "بدون تایید"
pub const VERIFY_NONE := 0
@en "VERIFY_PEER"
@fa "تایید طرف مقابل"
pub const VERIFY_PEER := 1
@en "FILETYPE_PEM"
@fa "نوع فایل پم"
pub const FILETYPE_PEM := 1
@en "TLS1_2"
@fa "تی ال اس۱۲"
pub const TLS1_2 := 771
@en "TLS1_3"
@fa "تی ال اس۱۳"
pub const TLS1_3 := 772
@en "CERT_OK"
@fa "گواهی معتبر"
pub const CERT_OK := 0 as i64
const _VERIFY_FAILED := 1 as i64
const _VERIFY_SKIPPED := 50 as i64
const _ERROR_NONE := 0
const _ERROR_SSL := 1
const _ERROR_SYSCALL := 5
const _ERROR_ZERO_RETURN := 6
mut _last_error := ""
struct _Ctx:
pub server: bool = false
pub verify: int = VERIFY_PEER
pub ca_file: str = ""
pub min_version: i64 = TLS1_2
pub scfg: tls.ServerConfig = tls.ServerConfig {}
end
struct _Session:
pub ctx: void* = null
pub fd: i64 = 0 - 1
pub host: str = ""
pub conn: tls.Conn = tls.Conn {}
pub attached: bool = false
pub live: bool = false
pub closed: bool = false
pub verify_result: i64 = 0 - 1
pub err: str = ""
end
@en "Context"
@fa "زمینه"
pub struct Context:
@en "handle"
@fa "دسته"
pub handle: void* = null
end
@en "Conn"
@fa "اتصال"
pub struct Conn:
@en "handle"
@fa "دسته"
pub handle: void* = null
end
func _ctx_of(ctx: Context): _Ctx*:
ret ctx.handle as _Ctx*
end
func _session_of(c: Conn): _Session*:
ret c.handle as _Session*
end
func _fail(s: _Session*, msg: str): bool:
s[0].err = msg
_last_error = msg
ret false
end
func _release(s: _Session*):
if s[0].attached:
tls.Detach(s[0].conn)
s[0].attached = false
end
s[0].live = false
end
func _finish(s: _Session*): bool:
s[0].attached = true
if not tls.ConnOk(s[0].conn):
msg := tls.ConnError(s[0].conn)
if msg.find("certificate verification failed") >= 0:
s[0].verify_result = _VERIFY_FAILED
end
_release(s)
ret _fail(s, msg)
end
cx := s[0].ctx as _Ctx*
if cx[0].min_version >= TLS1_3 and tls.Version(s[0].conn) != "TLS1.3":
_release(s)
ret _fail(s, "the peer does not support the minimum TLS version")
end
s[0].live = true
ret true
end
package ssl
@en "SetHostname"
@fa "تنظیم نام میزبان"
pub func SetHostname(c: Conn, host: str): bool:
if c.handle == null or host.len() == 0:
ret false
end
s := _session_of(c)
if s[0].attached:
ret false
end
s[0].host = host
ret true
end
@en "VerifyResult"
@fa "نتیجه تایید"
pub func VerifyResult(c: Conn): i64:
if c.handle == null:
ret 0 - 1
end
s := _session_of(c)
ret s[0].verify_result
end
@en "PeerVerified"
@fa "طرف مقابل تاییدشده"
pub func PeerVerified(c: Conn): bool:
ret VerifyResult(c) == CERT_OK
end
@en "stats"
@fa "آمار"
package stats
import math
import sort
import collections
func _sorted(v: Vector<f64>): Vector<f64>:
c := collections.clone(v)
sort.Sort(c)
ret c
end
func _variance(v: Vector<f64>, sample: bool): f64:
n := v.len()
mut denom := n
if sample: denom = n - 1 end
if denom <= 0: ret 0.0 end
mu := Mean(v)
mut acc := 0.0
repeat n in i:
d := v.get(i) - mu
acc += d * d
end
ret acc / (denom as f64)
end
@en "Sum"
@fa "مجموع"
pub func Sum(v: Vector<f64>): f64:
mut s := 0.0
repeat v.len() in i:
s += v.get(i)
end
ret s
end
@en "Mean"
@fa "میانگین"
pub func Mean(v: Vector<f64>): f64:
if v.len() == 0: ret 0.0 end
ret Sum(v) / (v.len() as f64)
end
@en "Min"
@fa "کمینه"
pub func Min(v: Vector<f64>): f64:
if v.len() == 0: ret 0.0 end
mut m := v.get(0)
repeat v.len() in i:
x := v.get(i)
if x < m: m = x end
end
ret m
end
@en "Max"
@fa "بیشینه"
pub func Max(v: Vector<f64>): f64:
if v.len() == 0: ret 0.0 end
mut m := v.get(0)
repeat v.len() in i:
x := v.get(i)
if x > m: m = x end
end
ret m
end
@en "Median"
@fa "میانه"
pub func Median(v: Vector<f64>): f64:
n := v.len()
if n == 0: ret 0.0 end
c := _sorted(v)
defer c.free()
mut m := 0.0
if n % 2 == 1:
m = c.get(n / 2)
else:
m = (c.get(n / 2 - 1) + c.get(n / 2)) / 2.0
end
ret m
end
@en "Variance"
@fa "واریانس"
pub func Variance(v: Vector<f64>): f64: ret _variance(v, true) end
@en "PopVariance"
@fa "واریانس جامعه"
pub func PopVariance(v: Vector<f64>): f64: ret _variance(v, false) end
@en "Stdev"
@fa "انحراف معیار"
pub func Stdev(v: Vector<f64>): f64: ret math.Sqrt(_variance(v, true)) end
@en "PopStdev"
@fa "انحراف معیار جامعه"
pub func PopStdev(v: Vector<f64>): f64: ret math.Sqrt(_variance(v, false)) end
@en "Geomean"
@fa "میانگین هندسی"
pub func Geomean(v: Vector<f64>): f64:
n := v.len()
if n == 0: ret 0.0 end
mut acc := 0.0
repeat n in i:
x := v.get(i)
if x <= 0.0: ret 0.0 end
acc += math.Log(x)
end
ret math.Exp(acc / (n as f64))
end
@en "Percentile"
@fa "صدک"
pub func Percentile(v: Vector<f64>, p: f64): f64:
n := v.len()
if n == 0: ret 0.0 end
c := _sorted(v)
defer c.free()
mut q := p
if q < 0.0: q = 0.0 end
if q > 100.0: q = 100.0 end
pos := q / 100.0 * ((n - 1) as f64)
lo := math.Floor(pos) as int
mut hi := lo + 1
if hi >= n: hi = n - 1 end
frac := pos - (lo as f64)
out := c.get(lo) + (c.get(hi) - c.get(lo)) * frac
ret out
end
package str
@en "Len"
@fa "طول"
pub inline pure func Len(s: str): int: ret s.len() end
@en "ByteLen"
@fa "طول بایتی"
pub inline pure func ByteLen(s: str): int: ret _blen(s) end
@en "ByteSub"
@fa "زیررشته بایتی"
pub inline func ByteSub(s: str, start: int, n: int): str: ret _bsub(s, start, n) end
@en "Concat"
@fa "پیوست"
pub inline pure func Concat(a: str, b: str): str: ret a.concat(b) end
@en "Compare"
@fa "مقایسه"
pub inline pure func Compare(a: str, b: str): int:
c := strcmp(a, b)
if c < 0: ret 0 - 1 end
ret c > 0 ? 1 : 0
end
@en "Equals"
@fa "یکسان است"
pub inline pure func Equals(a: str, b: str): bool: ret strcmp(a, b) == 0 end
@en "Substr"
@fa "زیررشته"
pub inline pure func Substr(s: str, start: int, n: int): str: ret s.substr(start, n) end
@en "SubstrIn"
@fa "زیررشته درون"
pub func SubstrIn(s: str, start: int, n: int): str:
slen := s.len()
mut st := start
mut ln := n
if st < 0: st = 0 end
if st > slen: st = slen end
if ln < 0: ln = 0 end
if ln > slen - st: ln = slen - st end
r := mem.MustAllocateZeroed((ln + 1) as u64)
if ln > 0:
mem.Copy(r, ((_bp(s) as void*) as i64 + (st as i64)) as void*, ln as u64)
end
ret r as str
end
@en "Find"
@fa "یافتن"
pub inline pure func Find(s: str, sub: str): int: ret s.find(sub) end
@en "Split"
@fa "تفکیک کردن"
pub pure func Split(s: str, delim: str): Vector<str>: ret s.split(delim) end
@en "Join"
@fa "بپیوند"
pub func Join(parts: Vector<str>, sep: str): str:
mut sb := NewBuilder()
defer BufFree(sb)
repeat parts.len() in i:
if i > 0: BufAppend(sb, sep) end
BufAppend(sb, parts.get(i))
end
out := BufStr(sb)
ret out
end
@en "Trim"
@fa "پیرایش"
pub inline pure func Trim(s: str): str: ret s.trim() end
@en "ToInt"
@fa "تبدیل به عدد"
pub inline pure func ToInt(s: str): int: ret s.to_int() end
@en "ToFloat"
@fa "تبدیل به اعشار"
pub inline pure func ToFloat(s: str): f64: ret s.to_float() end
@en "IsEmpty"
@fa "خالی است"
pub inline pure func IsEmpty(s: str): bool: ret s.len() == 0 end
@en "Clone"
@fa "رونوشت"
pub func Clone(s: str): str:
n := s.len() as i64
r := mem.MustAllocateZeroed((n + 1) as u64)
mem.Copy(r, s as void*, n as u64)
ret r as str
end
@en "Replace"
@fa "جایگزینی"
pub func Replace(s: str, find: str, replacement: str): str:
fl := find.len()
if fl == 0: ret Clone(s) end
n := s.len()
mut idx := _find_n(s, n, find, fl, 0)
if idx < 0: ret Clone(s) end
rl := replacement.len()
mut sb := NewBuilder()
defer BufFree(sb)
mut i := 0
until idx >= 0:
_buf_append_range(sb, s, i, idx - i)
_buf_append_range(sb, replacement, 0, rl)
i = idx + fl
idx = _find_n(s, n, find, fl, i)
end
_buf_append_range(sb, s, i, n - i)
ret BufStr(sb)
end
@en "FromInt"
@fa "از عدد"
pub func FromInt(i: i64): str: ret numfmt.FormatInt(i) end
if not SALAM_KERNEL:
@en "FromFloat"
@fa "از اعشار"
pub func FromFloat(f: f64): str: ret numfmt.FormatFloat(f) end
end
package str
@en "NewBuilder"
@fa "سازنده"
pub func NewBuilder(): StringBuilder:
ret StringBuilder { data = null, len = 0, cap = 0 }
end
@en "BufAppend"
@fa "افزودن به بافر"
pub func BufAppend(b &: StringBuilder, s: str):
n := s.len() as i64
if n <= 0: ret end
_buf_ensure(b, b.len + n)
dst := ((b.data as i64) + b.len) as void*
mem.Copy(dst, s as void*, n as u64)
b.len += n
end
@en "BufAppendChar"
@fa "افزودن نویسه به بافر"
pub func BufAppendChar(b &: StringBuilder, code: int):
_buf_ensure(b, b.len + 1)
p := b.data as i8*
p[b.len as int] = code as i8
b.len++
end
@en "BufAppendCp"
@fa "افزودن کدنقطه به بافر"
pub func BufAppendCp(b &: StringBuilder, cp: int):
mut c := cp
if c < 0 or c > 0x10FFFF: c = 0xFFFD end
if c < 0x80:
BufAppendChar(b, c)
else c < 0x800:
BufAppendChar(b, 0xC0 | (c >> 6))
BufAppendChar(b, 0x80 | (c & 0x3F))
else c < 0x10000:
BufAppendChar(b, 0xE0 | (c >> 12))
BufAppendChar(b, 0x80 | ((c >> 6) & 0x3F))
BufAppendChar(b, 0x80 | (c & 0x3F))
else:
BufAppendChar(b, 0xF0 | (c >> 18))
BufAppendChar(b, 0x80 | ((c >> 12) & 0x3F))
BufAppendChar(b, 0x80 | ((c >> 6) & 0x3F))
BufAppendChar(b, 0x80 | (c & 0x3F))
end
end
@en "BufAppendInt"
@fa "افزودن عدد به بافر"
pub func BufAppendInt(b &: StringBuilder, n: i64):
if n == 0:
BufAppendChar(b, 48)
ret
end
mut u := n as u64
if n < 0:
BufAppendChar(b, 45)
u = (0 as u64) - u
end
start := b.len
until u > (0 as u64):
BufAppendChar(b, 48 + ((u % (10 as u64)) as int))
u /= (10 as u64)
end
mut i := start
mut j := b.len - 1
p := b.data as i8*
until i < j:
lo := p[i as int]
hi := p[j as int]
p[i as int] = hi
p[j as int] = lo
i++
j--
end
end
@en "BufLen"
@fa "طول بافر"
pub func BufLen(b &: StringBuilder): i64: ret b.len end
@en "BufIsEmpty"
@fa "بافر خالی است"
pub func BufIsEmpty(b &: StringBuilder): bool: ret b.len == 0 end
@en "BufStr"
@fa "رشته بافر"
pub func BufStr(b &: StringBuilder): str:
if b.data == null: ret Clone("") end
p := b.data as i8*
p[b.len as int] = 0 as i8
ret Clone(b.data as str)
end
@en "BufReset"
@fa "بازنشانی بافر"
pub func BufReset(b &: StringBuilder): b.len = 0 end
@en "BufFree"
@fa "آزادسازی بافر"
pub func BufFree(b &: StringBuilder):
if b.data != null: mem.Free(b.data) end
b.data = null
b.len = 0
b.cap = 0
end
package str
func _fold_next(bp: i8*, n: int, i &: int, src &: int, k &: int): int:
if src >= 0 and k < unicode.FullFoldLen(src):
cp := unicode.FullFoldAt(src, k)
k++
ret cp
end
if i >= n: ret 0 - 1 end
mut cur := 0
i = _decode_at(bp, n, i, cur)
src = cur
k = 1
ret unicode.FullFoldAt(cur, 0)
end
func _fold_all(s: str): Vector<int>:
n := _blen(s)
bp := _bp(s)
out := Vector {} as Vector<int>
mut i := 0
mut src := 0 - 1
mut k := 0
until true:
c := _fold_next(bp, n, i, src, k)
if c < 0: ret out end
out.push(c)
end
end
@en "Upper"
@fa "بزرگ"
pub inline pure func Upper(s: str): str: ret s.upper() end
@en "Lower"
@fa "کوچک"
pub inline pure func Lower(s: str): str: ret s.lower() end
@en "Title"
@fa "حالت عنوانی"
pub func Title(s: str): str:
n := _blen(s)
bp := _bp(s)
mut sb := NewBuilder()
defer BufFree(sb)
mut start := true
mut i := 0
mut cp := 0
until i < n:
i = _decode_at(bp, n, i, cp)
if IsSpace(cp):
start = true
BufAppendCp(sb, cp)
else:
if start:
BufAppendCp(sb, unicode.ToTitle(cp))
else:
BufAppendCp(sb, unicode.ToLower(cp))
end
start = false
end
end
out := BufStr(sb)
ret out
end
@en "EqualFold"
@fa "یکسان بدون حساسیت"
pub func EqualFold(a: str, b: str): bool:
an := _blen(a)
bn := _blen(b)
ap := _bp(a)
bq := _bp(b)
mut ai := 0
mut asrc := 0 - 1
mut ak := 0
mut bi := 0
mut bsrc := 0 - 1
mut bk := 0
until true:
ca := _fold_next(ap, an, ai, asrc, ak)
cb := _fold_next(bq, bn, bi, bsrc, bk)
if ca != cb: ret false end
if ca < 0: ret true end
end
end
@en "CompareFold"
@fa "مقایسه بدون حساسیت"
pub func CompareFold(a: str, b: str): int:
an := _blen(a)
bn := _blen(b)
ap := _bp(a)
bq := _bp(b)
mut ai := 0
mut asrc := 0 - 1
mut ak := 0
mut bi := 0
mut bsrc := 0 - 1
mut bk := 0
until true:
ca := _fold_next(ap, an, ai, asrc, ak)
cb := _fold_next(bq, bn, bi, bsrc, bk)
if ca != cb: ret ca - cb end
if ca < 0: ret 0 end
end
end
@en "StartsWithFold"
@fa "شروع با بدون حساسیت"
pub func StartsWithFold(s: str, prefix: str): bool:
sn := _blen(s)
pn := _blen(prefix)
sp := _bp(s)
pp := _bp(prefix)
mut si := 0
mut ssrc := 0 - 1
mut sk := 0
mut pi := 0
mut psrc := 0 - 1
mut pk := 0
until true:
cp := _fold_next(pp, pn, pi, psrc, pk)
if cp < 0: ret true end
cs := _fold_next(sp, sn, si, ssrc, sk)
if cs != cp: ret false end
end
end
@en "EndsWithFold"
@fa "پایان با بدون حساسیت"
pub func EndsWithFold(s: str, suffix: str): bool:
a := _fold_all(s)
b := _fold_all(suffix)
defer a.free()
defer b.free()
off := a.len() - b.len()
if off < 0: ret false end
repeat b.len() in i:
if a.get(off + i) != b.get(i): ret false end
end
ret true
end
package str
import unicode
@en "IsAscii"
@fa "اسکی است"
pub inline pure func IsAscii(code: int): bool:
ret code >= 0 and code <= 127
end
@en "IsAsciiSpace"
@fa "فاصله اسکی است"
pub inline pure func IsAsciiSpace(code: int): bool:
ret code == 32 or (code >= 9 and code <= 13)
end
@en "IsAsciiDigit"
@fa "رقم اسکی است"
pub inline pure func IsAsciiDigit(code: int): bool:
ret code >= 48 and code <= 57
end
@en "IsAsciiUpper"
@fa "بزرگ اسکی است"
pub inline pure func IsAsciiUpper(code: int): bool:
ret code >= 65 and code <= 90
end
@en "IsAsciiLower"
@fa "کوچک اسکی است"
pub inline pure func IsAsciiLower(code: int): bool:
ret code >= 97 and code <= 122
end
@en "IsAsciiAlpha"
@fa "حرف اسکی است"
pub inline pure func IsAsciiAlpha(code: int): bool:
ret IsAsciiUpper(code) or IsAsciiLower(code)
end
@en "IsAsciiAlnum"
@fa "الفبایی عددی اسکی است"
pub inline pure func IsAsciiAlnum(code: int): bool:
ret IsAsciiAlpha(code) or IsAsciiDigit(code)
end
@en "IsSpace"
@fa "فاصله است"
pub pure func IsSpace(code: int): bool:
if IsAscii(code): ret IsAsciiSpace(code) end
ret unicode.IsSpace(code)
end
@en "IsDigit"
@fa "رقم است"
pub pure func IsDigit(code: int): bool:
if IsAscii(code): ret IsAsciiDigit(code) end
ret unicode.IsDigit(code)
end
@en "IsUpper"
@fa "بزرگ است"
pub pure func IsUpper(code: int): bool:
if IsAscii(code): ret IsAsciiUpper(code) end
ret unicode.IsUpper(code)
end
@en "IsLower"
@fa "کوچک است"
pub pure func IsLower(code: int): bool:
if IsAscii(code): ret IsAsciiLower(code) end
ret unicode.IsLower(code)
end
@en "IsAlpha"
@fa "حرف است"
pub pure func IsAlpha(code: int): bool:
if IsAscii(code): ret IsAsciiAlpha(code) end
ret unicode.IsAlphabetic(code)
end
@en "IsAlnum"
@fa "الفبایی عددی است"
pub pure func IsAlnum(code: int): bool:
if IsAscii(code): ret IsAsciiAlnum(code) end
ret unicode.IsAlnum(code)
end
@en "IsPunct"
@fa "نشانه نگارشی است"
pub pure func IsPunct(code: int): bool:
ret unicode.IsPunct(code)
end
@en "IsMark"
@fa "نشانه است"
pub pure func IsMark(code: int): bool:
ret unicode.IsMark(code)
end
@en "IsControl"
@fa "کنترلی است"
pub pure func IsControl(code: int): bool:
ret unicode.IsControl(code)
end
package str
const _DIGIT_ASCII_BASE := 0x30
const _DIGIT_ARABIC_BASE := 0x0660
const _DIGIT_PERSIAN_BASE := 0x06F0
pure func _digit_value(cp: int): int:
if cp >= _DIGIT_ASCII_BASE and cp <= _DIGIT_ASCII_BASE + 9: ret cp - _DIGIT_ASCII_BASE
else cp >= _DIGIT_ARABIC_BASE and cp <= _DIGIT_ARABIC_BASE + 9: ret cp - _DIGIT_ARABIC_BASE
else cp >= _DIGIT_PERSIAN_BASE and cp <= _DIGIT_PERSIAN_BASE + 9: ret cp - _DIGIT_PERSIAN_BASE
else:
ret 0 - 1
end
end
func _append_digit(b &: StringBuilder, digit: int, base: int):
BufAppendCp(b, base + digit)
end
func _convert_digits(s: str, base: int): str:
n := _blen(s)
bp := _bp(s)
mut b := NewBuilder()
defer BufFree(b)
mut i := 0
until i < n:
mut cp := 0
next_i := _decode_at(bp, n, i, cp)
digit := _digit_value(cp)
if digit >= 0:
_append_digit(b, digit, base)
else:
_buf_append_range(b, s, i, next_i - i)
end
i = next_i
end
ret BufStr(b)
end
func _has_digit_script(s: str, base: int): bool:
n := _blen(s)
bp := _bp(s)
mut i := 0
until i < n:
mut cp := 0
next_i := _decode_at(bp, n, i, cp)
if cp >= base and cp <= base + 9: ret true end
i = next_i
end
ret false
end
@en "DigitValue"
@fa "مقدار رقم"
pub inline pure func DigitValue(cp: int): int: ret _digit_value(cp) end
@en "IsArabicDigit"
@fa "رقم عربی است"
pub inline pure func IsArabicDigit(cp: int): bool:
ret cp >= _DIGIT_ARABIC_BASE and cp <= _DIGIT_ARABIC_BASE + 9
end
@en "IsPersianDigit"
@fa "رقم فارسی است"
pub inline pure func IsPersianDigit(cp: int): bool:
ret cp >= _DIGIT_PERSIAN_BASE and cp <= _DIGIT_PERSIAN_BASE + 9
end
@en "IsAnyDigit"
@fa "رقم فارسی عربی انگلیسی است"
pub inline pure func IsAnyDigit(cp: int): bool: ret _digit_value(cp) >= 0 end
@en "ToEnglishDigits"
@fa "به رقم انگلیسی"
pub func ToEnglishDigits(s: str): str: ret _convert_digits(s, _DIGIT_ASCII_BASE) end
@en "ToArabicDigits"
@fa "به رقم عربی"
pub func ToArabicDigits(s: str): str: ret _convert_digits(s, _DIGIT_ARABIC_BASE) end
@en "ToPersianDigits"
@fa "به رقم فارسی"
pub func ToPersianDigits(s: str): str: ret _convert_digits(s, _DIGIT_PERSIAN_BASE) end
@en "HasEnglishDigits"
@fa "دارای رقم انگلیسی است"
pub func HasEnglishDigits(s: str): bool: ret _has_digit_script(s, _DIGIT_ASCII_BASE) end
@en "HasArabicDigits"
@fa "دارای رقم عربی است"
pub func HasArabicDigits(s: str): bool: ret _has_digit_script(s, _DIGIT_ARABIC_BASE) end
@en "HasPersianDigits"
@fa "دارای رقم فارسی است"
pub func HasPersianDigits(s: str): bool: ret _has_digit_script(s, _DIGIT_PERSIAN_BASE) end
package str
@en "Repeat"
@fa "تکرار"
pub inline pure func Repeat(s: str, n: int): str: ret s.repeat(n) end
@en "Fields"
@fa "واژه ها"
pub func Fields(s: str): Vector<str>:
out := Vector {} as Vector<str> n := _blen(s)
bp := _bp(s)
mut i := 0
mut cp := 0
until i < n:
until i < n:
next := _decode_at(bp, n, i, cp)
if IsSpace(cp) == false: break end
i = next
end
start := i
until i < n:
next := _decode_at(bp, n, i, cp)
if IsSpace(cp): break end
i = next
end
if i > start:
out.push(_bslice(s, start, i - start))
end
end
ret out
end
package str
func _gcb_is_break(prev: int, curr: int, ri_run: int, pict_zwj: bool, conjunct: bool): bool:
pc := unicode.GraphemeBreak(prev)
cc := unicode.GraphemeBreak(curr)
if pc == unicode.GcbCR and cc == unicode.GcbLF: ret false end
if pc == unicode.GcbControl or pc == unicode.GcbCR or pc == unicode.GcbLF: ret true end
if cc == unicode.GcbControl or cc == unicode.GcbCR or cc == unicode.GcbLF: ret true end
if pc == unicode.GcbL:
if cc == unicode.GcbL or cc == unicode.GcbV or cc == unicode.GcbLV or cc == unicode.GcbLVT: ret false end
end
if pc == unicode.GcbLV or pc == unicode.GcbV:
if cc == unicode.GcbV or cc == unicode.GcbT: ret false end
end
if pc == unicode.GcbLVT or pc == unicode.GcbT:
if cc == unicode.GcbT: ret false end
end
if cc == unicode.GcbExtend or cc == unicode.GcbZWJ: ret false end
if cc == unicode.GcbSpacingMark: ret false end
if pc == unicode.GcbPrepend: ret false end
if conjunct and unicode.ConjunctBreak(curr) == unicode.IncbConsonant: ret false end
if pc == unicode.GcbZWJ and cc == unicode.GcbExtendedPictographic and pict_zwj: ret false end
if pc == unicode.GcbRegionalIndicator and cc == unicode.GcbRegionalIndicator:
if ri_run % 2 == 1: ret false end
end
ret true
end
func _gcb_pict_next(state: int, cp: int): int:
k := unicode.GraphemeBreak(cp)
if k == unicode.GcbExtendedPictographic: ret 1 end
if state == 1 and k == unicode.GcbExtend: ret 1 end
if state == 1 and k == unicode.GcbZWJ: ret 2 end
ret 0
end
func _gcb_conj_next(state: int, cp: int): int:
k := unicode.ConjunctBreak(cp)
if k == unicode.IncbConsonant: ret 1 end
if state > 0 and k == unicode.IncbLinker: ret 2 end
if state > 0 and k == unicode.IncbExtend: ret state end
ret 0
end
@en "GraphemeCount"
@fa "شمار خوشه"
pub func GraphemeCount(s: str): int:
n := _blen(s)
if n == 0: ret 0 end
bp := _bp(s)
mut count := 1
mut prev := 0
mut i := _decode_at(bp, n, 0, prev)
mut ri_run := 0
if unicode.GraphemeBreak(prev) == unicode.GcbRegionalIndicator: ri_run = 1 end
mut pict := _gcb_pict_next(0, prev)
mut conj := _gcb_conj_next(0, prev)
mut curr := 0
until i < n:
i = _decode_at(bp, n, i, curr)
if _gcb_is_break(prev, curr, ri_run, pict == 2, conj == 2):
count++
ri_run = 0
end
if unicode.GraphemeBreak(curr) == unicode.GcbRegionalIndicator:
ri_run++
else:
ri_run = 0
end
pict = _gcb_pict_next(pict, curr)
conj = _gcb_conj_next(conj, curr)
prev = curr
end
ret count
end
@en "Graphemes"
@fa "خوشه ها"
pub func Graphemes(s: str): Vector<str>:
out := Vector {} as Vector<str>
n := _blen(s)
if n == 0: ret out end
bp := _bp(s)
mut prev := 0
mut start := 0
mut i := _decode_at(bp, n, 0, prev)
mut ri_run := 0
if unicode.GraphemeBreak(prev) == unicode.GcbRegionalIndicator: ri_run = 1 end
mut pict := _gcb_pict_next(0, prev)
mut conj := _gcb_conj_next(0, prev)
mut curr := 0
until i < n:
at := i
i = _decode_at(bp, n, i, curr)
if _gcb_is_break(prev, curr, ri_run, pict == 2, conj == 2):
out.push(_bslice(s, start, at - start))
start = at
ri_run = 0
end
if unicode.GraphemeBreak(curr) == unicode.GcbRegionalIndicator:
ri_run++
else:
ri_run = 0
end
pict = _gcb_pict_next(pict, curr)
conj = _gcb_conj_next(conj, curr)
prev = curr
end
out.push(_bslice(s, start, n - start))
ret out
end
@en "ReverseGraphemes"
@fa "برعکس خوشه ای"
pub func ReverseGraphemes(s: str): str:
parts := Graphemes(s)
defer parts.free()
mut sb := NewBuilder()
defer BufFree(sb)
mut i := parts.len() - 1
until i >= 0:
BufAppend(sb, parts.get(i))
i--
end
ret BufStr(sb)
end
package str
func _canonical_order(buf &: Vector<int>):
n := buf.len()
mut i := 1
until i < n:
cp := buf.get(i)
cc := unicode.CombiningClass(cp)
if cc != 0:
mut j := i - 1
until j >= 0 and unicode.CombiningClass(buf.get(j)) > cc:
buf.set(j + 1, buf.get(j))
j--
end
buf.set(j + 1, cp)
end
i++
end
end
func _decompose(s: str, compat: bool): Vector<int>:
mut out := Vector {} as Vector<int>
n := _blen(s)
bp := _bp(s)
mut i := 0
mut cp := 0
until i < n:
i = _decode_at(bp, n, i, cp)
if cp < 0: cp = 0xFFFD end
mut count := unicode.DecompLen(cp)
if compat: count = unicode.CompatDecompLen(cp) end
mut k := 0
until k < count:
if compat:
out.push(unicode.CompatDecompAt(cp, k))
else:
out.push(unicode.DecompAt(cp, k))
end
k++
end
end
_canonical_order(out)
ret out
end
func _compose_canonical(buf: Vector<int>): Vector<int>:
out := Vector {} as Vector<int>
n := buf.len()
if n == 0: ret out end
mut starter_pos := 0
mut starter := buf.get(0)
out.push(starter)
mut last_class := unicode.CombiningClass(starter)
if last_class != 0: last_class = 256 end
mut pos := 1
until pos < n:
ch := buf.get(pos)
ch_class := unicode.CombiningClass(ch)
composite := unicode.Compose(starter, ch)
if composite >= 0 and (last_class < ch_class or last_class == 0):
out.set(starter_pos, composite)
starter = composite
else:
if ch_class == 0:
starter_pos = out.len()
starter = ch
end
last_class = ch_class
out.push(ch)
end
pos++
end
ret out
end
func _cps_to_str(cps: Vector<int>): str:
mut sb := NewBuilder()
defer BufFree(sb)
repeat cps.len() in i:
BufAppendCp(sb, cps.get(i))
end
ret BufStr(sb)
end
@en "NFD"
@fa "تجزیه متعارف"
pub func NFD(s: str): str:
cps := _decompose(s, false)
defer cps.free()
ret _cps_to_str(cps)
end
@en "NFC"
@fa "ترکیب متعارف"
pub func NFC(s: str): str:
d := _decompose(s, false)
defer d.free()
c := _compose_canonical(d)
defer c.free()
ret _cps_to_str(c)
end
@en "NFKD"
@fa "تجزیه سازگاری"
pub func NFKD(s: str): str:
cps := _decompose(s, true)
defer cps.free()
ret _cps_to_str(cps)
end
@en "NFKC"
@fa "ترکیب سازگاری"
pub func NFKC(s: str): str:
d := _decompose(s, true)
defer d.free()
c := _compose_canonical(d)
defer c.free()
ret _cps_to_str(c)
end
@en "IsNFC"
@fa "متعارف است"
pub func IsNFC(s: str): bool:
ret NFC(s) == s
end
package str
import mem
extern:
func strtod(s: str, endptr: void*): f64
end
export:
func salam_strcat(a: str, b: str): str:
la := a.len() as i64
lb := b.len() as i64
r := mem.MustAllocateZeroed((la + lb + 1) as u64)
mem.Copy(r, a as void*, la as u64)
mem.Copy(((r as i64) + la) as void*, b as void*, lb as u64)
ret r as str
end
func salam_strcat_v(n: int, parts: str*, own: u8*): str:
mut total := 0 as i64
repeat n in i:
total += parts[i].len() as i64
end
r := mem.MustAllocateZeroed((total + 1) as u64)
mut off := 0 as i64
repeat n in j:
l := parts[j].len() as i64
mem.Copy(((r as i64) + off) as void*, parts[j] as void*, l as u64)
off += l
end
repeat n in k:
if own[k] != 0:
mem.Free(parts[k] as void*)
end
end
ret r as str
end
func salam_strcat_own(a: str, fa: int, b: str, fb: int): str:
r := salam_strcat(a, b)
if fa != 0: mem.Free(a as void*) end
if fb != 0: mem.Free(b as void*) end
ret r
end
func salam_char_from_code(c: int): str:
r := mem.MustAllocateZeroed(2 as u64)
mem.Set(r, c, 1 as u64)
ret r as str
end
func salam_uchar_code(c: str): int:
n := _blen(c)
if n == 0:
ret 0
end
mut cp := 0
_decode_at(_bp(c), n, 0, cp)
if cp < 0:
ret 0xFFFD
end
ret cp
end
func salam_uchar_from_code(cp: int): str:
mut sb := NewBuilder()
defer BufFree(sb)
BufAppendCp(sb, cp)
ret BufStr(sb)
end
func salam_str_piece(s: str, start: int, n: int): str:
r := mem.MustAllocateZeroed((n + 1) as u64)
mem.Copy(r, ((_bp(s) as void*) as i64 + (start as i64)) as void*, n as u64)
ret r as str
end
func salam_str_substr(s: str, start: int, n: int): str:
slen := s.len()
mut st := start
mut ln := n
if st < 0: st = 0 end
if st > slen: st = slen end
if ln < 0: ln = 0 end
if ln > slen - st: ln = slen - st end
r := mem.MustAllocateZeroed((ln + 1) as u64)
if ln > 0:
mem.Copy(r, ((_bp(s) as void*) as i64 + (st as i64)) as void*, ln as u64)
end
ret r as str
end
func salam_str_char_count(s: str): int:
ret CharCount(s)
end
func salam_str_char_at(s: str, i: int): str:
ret CharAtIndex(s, i)
end
func salam_str_char_substr(s: str, start: int, n: int): str:
ret CharSubstr(s, start, n)
end
func salam_str_char_find(s: str, sub: str): int:
ret CharFind(s, sub)
end
func salam_str_ascii_digits(s: str): str:
n := s.len()
p := _bp(s)
mut hit := false
mut i := 0
until i + 1 < n and not hit:
hit = _ub(p, i) == 0xDB or _ub(p, i) == 0xD9
i++
end
if not hit:
ret s
end
r := mem.MustAllocateZeroed((n + 1) as u64)
rp := r as i8*
mut j := 0
mut k := 0
until j < n:
b0 := _ub(p, j)
mut b1 := 0
if j + 1 < n: b1 = _ub(p, j + 1) end
if b0 == 0xDB and b1 >= 0xB0 and b1 <= 0xB9:
rp[k] = (48 + b1 - 0xB0) as i8
j += 2
else b0 == 0xD9 and b1 >= 0xA0 and b1 <= 0xA9:
rp[k] = (48 + b1 - 0xA0) as i8
j += 2
else b0 == 0xD9 and b1 == 0xAB:
rp[k] = 46 as i8
j += 2
else:
rp[k] = p[j]
j++
end
k++
end
ret r as str
end
func salam_strtof64(s: str): f64:
t := salam_str_ascii_digits(s)
v := strtod(t, null)
if (t as void*) != (s as void*):
mem.Free(t as void*)
end
ret v
end
func salam_strtoi32(s: str): int:
t := salam_str_ascii_digits(s)
v := salam_strtoi32_ascii(t)
if (t as void*) != (s as void*):
mem.Free(t as void*)
end
ret v
end
func salam_strtoi32_ascii(s: str): int:
n := s.len()
p := _bp(s)
mut i := 0
until i < n and (_ub(p, i) == 32 or _ub(p, i) == 9 or _ub(p, i) == 10 or _ub(p, i) == 13):
i++
end
mut neg := false
if i < n and _ub(p, i) == 45:
neg = true
i++
else i < n and _ub(p, i) == 43:
i++
end
mut lim := 2147483647 as u64
if neg: lim = 2147483648 as u64 end
mut acc := 0 as u64
until i < n and _ub(p, i) >= 48 and _ub(p, i) <= 57:
d := (_ub(p, i) - 48) as u64
if acc > (lim - d) / (10 as u64):
acc = lim
else:
acc = acc * (10 as u64) + d
end
i++
end
if neg: ret (0 - (acc as i64)) as int end
ret acc as int
end
end
package str
@en "Contains"
@fa "شامل است"
pub inline pure func Contains(s: str, sub: str): bool:
ret s.find(sub) >= 0
end
@en "StartsWith"
@fa "شروع با"
pub pure func StartsWith(s: str, prefix: str): bool:
m := _blen(prefix)
if m > _blen(s): ret false end
ret _match_at(_bp(s), 0, _bp(prefix), m)
end
@en "EndsWith"
@fa "پایان با"
pub pure func EndsWith(s: str, suffix: str): bool:
m := _blen(suffix)
n := _blen(s)
if m > n: ret false end
ret _match_at(_bp(s), n - m, _bp(suffix), m)
end
@en "Search"
@fa "جستجو"
pub inline pure func Search(s: str, sub: str): int: ret s.search(sub) end
@en "IndexOf"
@fa "اندیس"
pub inline pure func IndexOf(s: str, sub: str): int: ret s.indexOf(sub) end
@en "IndexFrom"
@fa "اندیس از"
pub pure func IndexFrom(s: str, sub: str, from: int): int:
n := _blen(s)
mut i := from
if i < 0: i = 0 end
i = _bidx_in(s, i)
if i > n: ret 0 - 1 end
tail := (((s as void*) as i64 + i) as void*) as str
hit := tail.find(sub)
if hit < 0: ret 0 - 1 end
ret _bidx_out(s, i + hit)
end
@en "Count"
@fa "شمارش"
pub pure func Count(s: str, sub: str): int:
m := _blen(sub)
if m == 0: ret 0 end
n := _blen(s)
hp := _bp(s)
np := _bp(sub)
mut count := 0
mut i := 0
until i + m <= n:
if _match_at(hp, i, np, m):
count++
i += m
else:
i++
end
end
ret count
end
@en "LastIndex"
@fa "آخرین اندیس"
pub pure func LastIndex(s: str, sub: str): int:
n := _blen(s)
m := _blen(sub)
if m == 0 or m > n: ret 0 - 1 end
hp := _bp(s)
np := _bp(sub)
mut i := n - m
until i >= 0:
if _match_at(hp, i, np, m): ret _bidx_out(s, i) end
i--
end
ret 0 - 1
end
@en "StartsWithAny"
@fa "شروع با یکی از"
pub func StartsWithAny(s: str, prefixes: Vector<str>): bool:
repeat prefixes.len() in i:
if s.starts_with(prefixes.get(i)): ret true end
end
ret false
end
@en "EndsWithAny"
@fa "پایان با یکی از"
pub func EndsWithAny(s: str, suffixes: Vector<str>): bool:
repeat suffixes.len() in i:
if s.ends_with(suffixes.get(i)): ret true end
end
ret false
end
@en "CutPrefix"
@fa "برش پیشوند"
pub func CutPrefix(s: str, prefix: str, ok &: bool): str:
ok = s.starts_with(prefix)
if ok: ret _bsub(s, _blen(prefix), _blen(s) - _blen(prefix)) end
ret Clone(s)
end
@en "CutSuffix"
@fa "برش پسوند"
pub func CutSuffix(s: str, suffix: str, ok &: bool): str:
ok = s.ends_with(suffix)
if ok: ret _bsub(s, 0, _blen(s) - _blen(suffix)) end
ret Clone(s)
end
@en "StartsWithBytes"
@fa "شروع بایتی"
pub pure func StartsWithBytes(data: void*, n: int, prefix: void*, m: int): bool:
if m < 0 or m > n: ret false end
ret _match_at(data as i8*, 0, prefix as i8*, m)
end
@en "EndsWithBytes"
@fa "پایان بایتی"
pub pure func EndsWithBytes(data: void*, n: int, suffix: void*, m: int): bool:
if m < 0 or m > n: ret false end
ret _match_at(data as i8*, n - m, suffix as i8*, m)
end
@fa "رشته"
@en "str"
package str
import mem
import conv.numfmt
import unicode
extern:
pure func strcmp(a: str, b: str): int
end
@en "StringBuilder"
@fa "سازنده رشته"
pub struct StringBuilder:
@en "data"
@fa "داده"
pub data: void* = null
@en "len"
@fa "طول"
pub len: i64 = 0
@en "cap"
@fa "ظرفیت"
pub cap: i64 = 0
end
inline pure func _bp(s: str): i8*: ret (s as void*) as i8* end
inline pure func _ub(bp: i8*, i: int): int:
mut v := bp[i] as int
if v < 0: v += 256 end
ret v
end
inline pure func _blen(s: str): int: ret s.len() end
inline pure func _bidx_in(s: str, i: int): int: ret i end
inline pure func _bidx_out(s: str, b: int): int: ret b end
inline func _bsub(s: str, start: int, n: int): str: ret s.substr(start, n) end
pure func _match_at(hp: i8*, hi: int, np: i8*, n: int): bool:
repeat n in k:
if hp[hi + k] != np[k]: ret false end
end
ret true
end
pure func _find_n(s: str, n: int, sub: str, m: int, from: int): int:
hp := _bp(s)
np := _bp(sub)
mut i := from
until i + m <= n:
if _match_at(hp, i, np, m): ret i end
i++
end
ret 0 - 1
end
func _buf_ensure(b &: StringBuilder, need: i64):
if need + 1 <= b.cap: ret end
mut c := b.cap
if c == 0: c = 64 end
until c < need + 1: c *= 2 end
b.data = mem.MustReallocate(b.data, c as u64)
b.cap = c
end
if SALAM_JS:
func _bslice(s: str, start: int, n: int): str: ret _bsub(s, start, n) end
else:
func _bslice(s: str, start: int, n: int): str:
r := mem.MustAllocateZeroed((n + 1) as u64)
if n > 0: mem.Copy(r, ((s as void*) as i64 + (start as i64)) as void*, n as u64) end
p := r as i8*
p[n] = 0 as i8
ret r as str
end
end
if SALAM_JS:
func _buf_append_range(b &: StringBuilder, s: str, start: int, n: int):
BufAppend(b, _bsub(s, start, n))
end
else:
func _buf_append_range(b &: StringBuilder, s: str, start: int, n: int):
if n <= 0: ret end
_buf_ensure(b, b.len + (n as i64))
dst := ((b.data as i64) + b.len) as void*
mem.Copy(dst, ((s as void*) as i64 + (start as i64)) as void*, n as u64)
b.len += n as i64
end
end
package str
@en "TrimLeft"
@fa "پیرایش چپ"
pub func TrimLeft(s: str): str:
n := _blen(s)
bp := _bp(s)
mut i := 0
mut cp := 0
until i < n:
next := _decode_at(bp, n, i, cp)
if IsSpace(cp) == false: break end
i = next
end
if i == 0: ret Clone(s) end
ret _bsub(s, i, n - i)
end
@en "TrimRight"
@fa "پیرایش راست"
pub func TrimRight(s: str): str:
n := _blen(s)
bp := _bp(s)
mut e := n
mut cp := 0
until e > 0:
start := _prev_boundary(bp, e)
_dropped := _decode_at(bp, n, start, cp)
if IsSpace(cp) == false: break end
e = start
end
if e == n: ret Clone(s) end
ret _bsub(s, 0, e)
end
@en "TrimPrefix"
@fa "حذف پیشوند"
pub func TrimPrefix(s: str, prefix: str): str:
if StartsWith(s, prefix):
ret _bsub(s, _blen(prefix), _blen(s) - _blen(prefix))
end
ret Clone(s)
end
@en "TrimSuffix"
@fa "حذف پسوند"
pub func TrimSuffix(s: str, suffix: str): str:
if EndsWith(s, suffix):
ret _bsub(s, 0, _blen(s) - _blen(suffix))
end
ret Clone(s)
end
package str
func _decode_at(bp: i8*, n: int, i: int, cp &: int): int:
b0 := _ub(bp, i)
char_len := CharLen(b0)
next_i := i + char_len
if next_i > n:
cp = 0 - 1
ret n
end
if char_len == 1:
cp = b0
else char_len == 2:
cp = ((b0 & 0x1F) << 6) | (_ub(bp, i + 1) & 0x3F)
else char_len == 3:
cp = ((b0 & 0x0F) << 12) | ((_ub(bp, i + 1) & 0x3F) << 6) | (_ub(bp, i + 2) & 0x3F)
else:
cp = ((b0 & 0x07) << 18) | ((_ub(bp, i + 1) & 0x3F) << 12) | ((_ub(bp, i + 2) & 0x3F) << 6) | (_ub(bp, i + 3) & 0x3F)
end
ret next_i
end
pure func _prev_boundary(bp: i8*, e: int): int:
mut b := e - 1
until b > 0 and _ub(bp, b) >= 128 and _ub(bp, b) < 192:
b--
end
ret b
end
pure func _char_advance(bp: i8*, n: int, from: int, k: int): int:
mut i := from
mut c := 0
until c < k and i < n:
mut char_len := CharLen(_ub(bp, i))
if i + char_len > n: char_len = n - i end
i += char_len
c++
end
ret i
end
@en "CodePointAt"
@fa "کدنقطه در"
pub func CodePointAt(s: str, i: int, cp &: int): int:
n := _blen(s)
bi := _bidx_in(s, i)
if bi < 0 or bi >= n:
cp = 0 - 1
ret _bidx_out(s, n)
end
ret _bidx_out(s, _decode_at(_bp(s), n, bi, cp))
end
@en "CharLen"
@fa "طول نویسه"
pub inline pure func CharLen(lead: int): int:
if lead >= 240: ret 4
else lead >= 224: ret 3
else lead >= 192: ret 2
else:
ret 1
end
end
@en "CharAt"
@fa "نویسه در"
pub func CharAt(s: str, i: int): str:
n := _blen(s)
bi := _bidx_in(s, i)
if bi < 0 or bi >= n: ret "" end
mut char_len := CharLen(_ub(_bp(s), bi))
if bi + char_len > n: char_len = n - bi end
ret _bsub(s, bi, char_len)
end
@en "Reverse"
@fa "برعکس"
pub func Reverse(s: str): str:
n := _blen(s)
bp := _bp(s)
mut sb := NewBuilder()
defer BufFree(sb)
mut e := n
until e > 0:
b := _prev_boundary(bp, e)
_buf_append_range(sb, s, b, e - b)
e = b
end
out := BufStr(sb)
ret out
end
@en "CharCount"
@fa "شمارنویسه"
pub pure func CharCount(s: str): int:
n := _blen(s)
bp := _bp(s)
mut count := 0
mut i := 0
until i < n:
mut char_len := CharLen(_ub(bp, i))
if i + char_len > n: char_len = n - i end
count++
i += char_len
end
ret count
end
@en "CharSubstr"
@fa "زیررشته نویسه"
pub func CharSubstr(s: str, start: int, n: int): str:
total := _blen(s)
bp := _bp(s)
mut st := start
mut ln := n
if st < 0: st = 0 end
if ln < 0: ln = 0 end
b0 := _char_advance(bp, total, 0, st)
b1 := _char_advance(bp, total, b0, ln)
ret _bsub(s, b0, b1 - b0)
end
@en "CharAtIndex"
@fa "نویسه شماره"
pub func CharAtIndex(s: str, i: int): str:
ret CharSubstr(s, i, i < 0 ? 0 : 1)
end
@en "CharFind"
@fa "بیاب نویسه"
pub pure func CharFind(s: str, sub: str): int:
found := s.find(sub)
if found < 0: ret 0 - 1 end
off := _bidx_in(s, found)
bp := _bp(s)
mut count := 0
mut i := 0
until i < off:
i += CharLen(_ub(bp, i))
count++
end
ret count
end
@en "CodePoints"
@fa "کدنقطه ها"
pub func CodePoints(s: str): Vector<int>:
out := Vector {} as Vector<int>
n := _blen(s)
bp := _bp(s)
mut i := 0
mut cp := 0
until i < n:
i = _decode_at(bp, n, i, cp)
if cp < 0: cp = 0xFFFD end
out.push(cp)
end
ret out
end
@en "FromCodePoints"
@fa "از کدنقطه ها"
pub func FromCodePoints(cps: Vector<int>): str:
mut sb := NewBuilder()
defer BufFree(sb)
repeat cps.len() in i:
BufAppendCp(sb, cps.get(i))
end
ret BufStr(sb)
end
@en "AllAscii"
@fa "همه اسکی"
pub pure func AllAscii(s: str): bool:
n := _blen(s)
bp := _bp(s)
repeat n in i:
if _ub(bp, i) >= 128: ret false end
end
ret true
end
@en "Chars"
@fa "نویسه ها"
pub func Chars(s: str): Vector<str>:
out := Vector {} as Vector<str> n := _blen(s)
bp := _bp(s)
mut i := 0
until i < n:
mut char_len := CharLen(_ub(bp, i))
if i + char_len > n: char_len = n - i end
out.push(_bslice(s, i, char_len))
i += char_len
end
ret out
end
@en "sync"
@fa "همگام سازی"
package sync
import mem
if SALAM_OS_UNIX:
if not defined(SALAM_CC_TCC):
link dynamic "pthread"
end
end
if SALAM_OS_WINDOWS:
link dynamic "kernel32"
extern:
func InitializeCriticalSection(cs: void*)
func EnterCriticalSection(cs: void*)
func LeaveCriticalSection(cs: void*)
func DeleteCriticalSection(cs: void*)
func GetModuleHandleA(name: str): void*
func GetProcAddress(mod: void*, name: str): void*
func GetTickCount(): u32
func Sleep(ms: int)
func InitializeConditionVariable(cv: void*)
func SleepConditionVariableCS(cv: void*, cs: void*, ms: int): int
func WakeConditionVariable(cv: void*)
func WakeAllConditionVariable(cv: void*)
func GetTickCount64(): u64
end
else:
extern:
func pthread_mutex_init(mutex: void*, attr: void*): int
func pthread_mutex_lock(mutex: void*): int
func pthread_mutex_unlock(mutex: void*): int
func pthread_mutex_destroy(mutex: void*): int
func pthread_cond_init(cond: void*, attr: void*): int
func pthread_cond_wait(cond: void*, mutex: void*): int
func pthread_cond_timedwait(cond: void*, mutex: void*, abstime: void*): int
func clock_gettime(clk: int, ts: void*): int
func pthread_cond_signal(cond: void*): int
func pthread_cond_broadcast(cond: void*): int
func pthread_cond_destroy(cond: void*): int
func usleep(us: u32): int
end
end
const MUTEX_BYTES := 128
const COND_BYTES := 128
if SALAM_OS_WINDOWS:
_k32 := GetModuleHandleA("kernel32.dll")
_cv_init_fn := GetProcAddress(_k32, "InitializeConditionVariable")
_cv_sleep_fn := GetProcAddress(_k32, "SleepConditionVariableCS")
_cv_wake_fn := GetProcAddress(_k32, "WakeConditionVariable")
_cv_wake_all_fn := GetProcAddress(_k32, "WakeAllConditionVariable")
_tick64_fn := GetProcAddress(_k32, "GetTickCount64")
end
@en "Mutex"
@fa "قفل"
pub struct Mutex:
@en "handle"
@fa "دستگیره"
pub handle: void* = null
end
@en "CondVar"
@fa "متغیر شرط"
pub struct CondVar:
@en "handle"
@fa "دستگیره"
pub handle: void* = null
end
@en "WaitGroup"
@fa "گروه انتظار"
pub struct WaitGroup:
@en "counter"
@fa "شمارنده"
pub counter: i64* = null
@en "mu"
@fa "قفل درونی"
pub mu: void* = null
@en "cv"
@fa "شرط درونی"
pub cv: void* = null
end
@en "RWMutex"
@fa "قفل خواندن نوشتن"
pub struct RWMutex:
@en "state"
@fa "وضعیت"
pub state: i64* = null
@en "mu"
@fa "قفل درونی"
pub mu: void* = null
@en "cv"
@fa "شرط درونی"
pub cv: void* = null
end
@en "Semaphore"
@fa "نشانگر"
pub struct Semaphore:
@en "permits"
@fa "مجوزها"
pub permits: i64* = null
@en "mu"
@fa "قفل درونی"
pub mu: void* = null
@en "cv"
@fa "شرط درونی"
pub cv: void* = null
end
@en "Once"
@fa "یک بار"
pub struct Once:
@en "done"
@fa "انجام شد"
pub done: i64* = null
@en "mu"
@fa "قفل درونی"
pub mu: void* = null
end
if SALAM_OS_WINDOWS:
func mutex_new(): void*:
m := mem.MustAllocate(MUTEX_BYTES as u64)
InitializeCriticalSection(m)
ret m
end
func mutex_lock(h: void*): int:
EnterCriticalSection(h)
ret 0
end
func mutex_unlock(h: void*): int:
LeaveCriticalSection(h)
ret 0
end
func mutex_free(h: void*):
DeleteCriticalSection(h)
mem.Free(h)
end
if SALAM_ARCH_X86:
func cond_new(): void*:
c := mem.MustAllocate(COND_BYTES as u64)
InitializeConditionVariable(c)
ret c
end
func cond_wait(c: void*, m: void*):
SleepConditionVariableCS(c, m, 0 - 1)
end
func cond_timedwait(c: void*, m: void*, ms: i64): bool:
ret SleepConditionVariableCS(c, m, ms as int) != 0
end
func now_ms_os(): i64:
ret GetTickCount64() as i64
end
func cond_signal(c: void*):
WakeConditionVariable(c)
end
func cond_broadcast(c: void*):
WakeAllConditionVariable(c)
end
else:
func cond_new(): void*:
c := mem.MustAllocate(COND_BYTES as u64)
if _cv_init_fn != null:
f := _cv_init_fn as extern func (void*) void
f(c)
end
ret c
end
func cond_wait(c: void*, m: void*):
if _cv_sleep_fn == null:
LeaveCriticalSection(m)
Sleep(1)
EnterCriticalSection(m)
ret
end
f := _cv_sleep_fn as extern func (void*, void*, int) int
f(c, m, 0 - 1)
end
func cond_timedwait(c: void*, m: void*, ms: i64): bool:
if _cv_sleep_fn == null:
LeaveCriticalSection(m)
mut nap := ms
if nap > 1: nap = 1 end
if nap < 0: nap = 0 end
Sleep(nap as int)
EnterCriticalSection(m)
ret false
end
f := _cv_sleep_fn as extern func (void*, void*, int) int
ret f(c, m, ms as int) != 0
end
func now_ms_os(): i64:
if _tick64_fn == null: ret GetTickCount() as i64 end
f := _tick64_fn as extern func () u64
ret f() as i64
end
func cond_signal(c: void*):
if _cv_wake_fn == null: ret end
f := _cv_wake_fn as extern func (void*) void
f(c)
end
func cond_broadcast(c: void*):
if _cv_wake_all_fn == null: ret end
f := _cv_wake_all_fn as extern func (void*) void
f(c)
end
end
func cond_free(c: void*): mem.Free(c) end
func _sync_sleep_ms(ms: int): Sleep(ms) end
else:
func mutex_new(): void*:
m := mem.MustAllocate(MUTEX_BYTES as u64)
pthread_mutex_init(m, null)
ret m
end
func mutex_lock(h: void*): int:
if pthread_mutex_lock(h) == 0: ret 0 end
ret 0 - 1
end
func mutex_unlock(h: void*): int:
if pthread_mutex_unlock(h) == 0: ret 0 end
ret 0 - 1
end
func mutex_free(h: void*):
pthread_mutex_destroy(h)
mem.Free(h)
end
func cond_new(): void*:
c := mem.MustAllocate(COND_BYTES as u64)
pthread_cond_init(c, null)
ret c
end
func cond_wait(c: void*, m: void*):
pthread_cond_wait(c, m)
end
func ts_read_sec(ts: void*): i64:
if sizeof(void*) == 8:
q := ts as i64*
ret q[0]
end
q32 := ts as i32*
ret q32[0]
end
func ts_read_nsec(ts: void*): i64:
if sizeof(void*) == 8:
q := ts as i64*
ret q[1]
end
q32 := ts as i32*
ret q32[1]
end
func ts_write(ts: void*, sec: i64, nsec: i64):
if sizeof(void*) == 8:
q := ts as i64*
q[0] = sec
q[1] = nsec
ret
end
q32 := ts as i32*
q32[0] = sec as i32
q32[1] = nsec as i32
end
func cond_timedwait(c: void*, m: void*, ms: i64): bool:
ts := mem.MustAllocateZeroed(32 as u64)
clock_gettime(0, ts)
total := ts_read_nsec(ts) + (ms % 1000) * 1000000
ts_write(ts, ts_read_sec(ts) + (ms / 1000) + (total / 1000000000), total % 1000000000)
rc := pthread_cond_timedwait(c, m, ts)
mem.Free(ts)
ret rc == 0
end
func now_ms_os(): i64:
ts := mem.MustAllocateZeroed(32 as u64)
clock_gettime(0, ts)
ms := ts_read_sec(ts) * 1000 + ts_read_nsec(ts) / 1000000
mem.Free(ts)
ret ms
end
func cond_signal(c: void*): pthread_cond_signal(c) end
func cond_broadcast(c: void*): pthread_cond_broadcast(c) end
func cond_free(c: void*):
pthread_cond_destroy(c)
mem.Free(c)
end
func _sync_sleep_ms(ms: int):
if ms > 0: usleep((ms * 1000) as u32) end
end
end
@en "NewMutex"
@fa "قفل جدید"
pub func NewMutex(): Mutex: ret Mutex { handle = mutex_new() } end
@en "Lock"
@fa "قفل کردن"
pub func Lock(m: Mutex): int: ret mutex_lock(m.handle) end
@en "Unlock"
@fa "باز کردن قفل"
pub func Unlock(m: Mutex): int: ret mutex_unlock(m.handle) end
@en "Destroy"
@fa "نابودسازی"
pub func Destroy(m: Mutex): mutex_free(m.handle) end
@en "SleepMs"
@fa "خواب میلی ثانیه"
pub func SleepMs(ms: int): _sync_sleep_ms(ms) end
@en "NewCondVar"
@fa "متغیر شرط جدید"
pub func NewCondVar(): CondVar: ret CondVar { handle = cond_new() } end
@en "WaitCond"
@fa "انتظار شرط"
pub func WaitCond(cv: CondVar, m: Mutex): cond_wait(cv.handle, m.handle) end
@en "WaitCondTimeout"
@fa "انتظار شرط با مهلت"
pub func WaitCondTimeout(cv: CondVar, m: Mutex, ms: i64): bool:
ret cond_timedwait(cv.handle, m.handle, ms)
end
@en "NowMs"
@fa "اکنون میلی ثانیه"
pub func NowMs(): i64: ret now_ms_os() end
@en "Signal"
@fa "اعلام"
pub func Signal(cv: CondVar): cond_signal(cv.handle) end
@en "Broadcast"
@fa "اعلام سراسری"
pub func Broadcast(cv: CondVar): cond_broadcast(cv.handle) end
@en "DestroyCondVar"
@fa "نابودسازی متغیر شرط"
pub func DestroyCondVar(cv: CondVar): cond_free(cv.handle) end
@en "NewWaitGroup"
@fa "گروه انتظار جدید"
pub func NewWaitGroup(): WaitGroup:
c := mem.MustAllocate(8 as u64) as i64*
c[0] = 0
ret WaitGroup { counter = c, mu = mutex_new(), cv = cond_new() }
end
@en "Add"
@fa "افزودن"
pub func Add(wg: WaitGroup, delta: i64):
c := wg.counter
mutex_lock(wg.mu)
c[0] += delta
if c[0] <= 0: cond_broadcast(wg.cv) end
mutex_unlock(wg.mu)
end
@en "Done"
@fa "اتمام"
pub func Done(wg: WaitGroup):
c := wg.counter
mutex_lock(wg.mu)
c[0]--
if c[0] <= 0: cond_broadcast(wg.cv) end
mutex_unlock(wg.mu)
end
@en "Wait"
@fa "انتظار"
pub func Wait(wg: WaitGroup):
c := wg.counter
mutex_lock(wg.mu)
until c[0] > 0:
cond_wait(wg.cv, wg.mu)
end
mutex_unlock(wg.mu)
end
@en "DestroyWaitGroup"
@fa "نابودسازی گروه انتظار"
pub func DestroyWaitGroup(wg: WaitGroup):
mem.Free(wg.counter as void*)
cond_free(wg.cv)
mutex_free(wg.mu)
end
@en "NewRWMutex"
@fa "قفل خواندن نوشتن جدید"
pub func NewRWMutex(): RWMutex:
s := mem.MustAllocate(24 as u64) as i64*
s[0] = 0
s[1] = 0
s[2] = 0
ret RWMutex { state = s, mu = mutex_new(), cv = cond_new() }
end
@en "RLock"
@fa "قفل خواندن"
pub func RLock(rw: RWMutex):
s := rw.state
mutex_lock(rw.mu)
until s[1] != 0 or s[2] > 0:
cond_wait(rw.cv, rw.mu)
end
s[0]++
mutex_unlock(rw.mu)
end
@en "RUnlock"
@fa "باز کردن قفل خواندن"
pub func RUnlock(rw: RWMutex):
s := rw.state
mutex_lock(rw.mu)
s[0]--
if s[0] <= 0: cond_broadcast(rw.cv) end
mutex_unlock(rw.mu)
end
@en "WLock"
@fa "قفل نوشتن"
pub func WLock(rw: RWMutex):
s := rw.state
mutex_lock(rw.mu)
s[2]++
until s[1] != 0 or s[0] > 0:
cond_wait(rw.cv, rw.mu)
end
s[2]--
s[1] = 1
mutex_unlock(rw.mu)
end
@en "WUnlock"
@fa "باز کردن قفل نوشتن"
pub func WUnlock(rw: RWMutex):
s := rw.state
mutex_lock(rw.mu)
s[1] = 0
cond_broadcast(rw.cv)
mutex_unlock(rw.mu)
end
@en "DestroyRWMutex"
@fa "نابودسازی قفل خواندن نوشتن"
pub func DestroyRWMutex(rw: RWMutex):
mem.Free(rw.state as void*)
cond_free(rw.cv)
mutex_free(rw.mu)
end
@en "NewSemaphore"
@fa "نشانگر جدید"
pub func NewSemaphore(permits: i64): Semaphore:
p := mem.MustAllocate(8 as u64) as i64*
p[0] = permits
ret Semaphore { permits = p, mu = mutex_new(), cv = cond_new() }
end
@en "Acquire"
@fa "گرفتن"
pub func Acquire(sem: Semaphore):
p := sem.permits
mutex_lock(sem.mu)
until p[0] <= 0:
cond_wait(sem.cv, sem.mu)
end
p[0]--
mutex_unlock(sem.mu)
end
@en "TryAcquire"
@fa "کوشش برای گرفتن"
pub func TryAcquire(sem: Semaphore): bool:
p := sem.permits
mutex_lock(sem.mu)
mut got := false
if p[0] > 0:
p[0]--
got = true
end
mutex_unlock(sem.mu)
ret got
end
@en "Release"
@fa "رها کردن"
pub func Release(sem: Semaphore):
p := sem.permits
mutex_lock(sem.mu)
p[0]++
cond_signal(sem.cv)
mutex_unlock(sem.mu)
end
@en "DestroySemaphore"
@fa "نابودسازی نشانگر"
pub func DestroySemaphore(sem: Semaphore):
mem.Free(sem.permits as void*)
cond_free(sem.cv)
mutex_free(sem.mu)
end
@en "NewOnce"
@fa "یک بار جدید"
pub func NewOnce(): Once:
d := mem.MustAllocate(8 as u64) as i64*
d[0] = 0
ret Once { done = d, mu = mutex_new() }
end
@en "Do"
@fa "انجام"
pub func Do(o: Once, f: func ()):
d := o.done
mutex_lock(o.mu)
if d[0] == 0:
f()
d[0] = 1
end
mutex_unlock(o.mu)
end
@en "DestroyOnce"
@fa "نابودسازی یک بار"
pub func DestroyOnce(o: Once):
mem.Free(o.done as void*)
mutex_free(o.mu)
end
@en "telegram.bot"
