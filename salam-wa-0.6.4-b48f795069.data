func _md5_init(): Md5:
mut s := Md5 {}
s.h[0] = 0x67452301 as u32
s.h[1] = 0xefcdab89 as u32
s.h[2] = 0x98badcfe as u32
s.h[3] = 0x10325476 as u32
s.blen = 0
s.total = 0 as u64
ret s
end
func _md5_block(s &: Md5):
mut m: u32[16]
repeat 16 in t:
o := t * 4
m[t] = (s.blk[o] as u32) | ((s.blk[o + 1] as u32) << (8 as u32)) | ((s.blk[o + 2] as u32) << (16 as u32)) | ((s.blk[o + 3] as u32) << (24 as u32))
end
mut a := s.h[0]
mut b := s.h[1]
mut c := s.h[2]
mut d := s.h[3]
repeat 64 in i:
mut f := 0 as u32
mut g := 0
if i < 16:
f = (b & c) | ((~b) & d)
g = i
else if i < 32:
f = (d & b) | ((~d) & c)
g = (5 * i + 1) % 16
else if i < 48:
f = b ^ c ^ d
g = (3 * i + 5) % 16
else:
f = c ^ (b | (~d))
g = (7 * i) % 16
end
tmp := d
d = c
c = b
rot := MD5_S[(i / 16) * 4 + (i % 4)]
x := a + f + MD5_K[i] + m[g]
b += ((x << rot) | (x >> ((32 as u32) - rot)))
a = tmp
end
s.h[0] += a
s.h[1] += b
s.h[2] += c
s.h[3] += d
end
func _md5_update(s &: Md5, p: void*, n: int):
mut i := 0
until i < n:
space := MD5_BLOCK - s.blen
mut take := n - i
if take > space:
take = space
end
repeat take in j:
s.blk[s.blen + j] = _bget(p, i + j) as u8
end
s.blen += take
i += take
s.total += take as u64
if s.blen == MD5_BLOCK:
_md5_block(s)
s.blen = 0
end
end
end
func _md5_final(s0: Md5, out: void*):
mut s := s0
bits := s.total * (8 as u64)
s.blk[s.blen] = 0x80 as u8
s.blen++
if s.blen > 56:
until s.blen < MD5_BLOCK:
s.blk[s.blen] = 0 as u8
s.blen++
end
_md5_block(s)
s.blen = 0
end
until s.blen < 56:
s.blk[s.blen] = 0 as u8
s.blen++
end
repeat 8 in i:
sh := (i * 8) as u64
s.blk[56 + i] = ((bits >> sh) & (0xFF as u64)) as u8
end
_md5_block(s)
repeat 4 in i:
v := s.h[i]
_bput(out, i * 4, (v & (0xFF as u32)) as int)
_bput(out, i * 4 + 1, ((v >> (8 as u32)) & (0xFF as u32)) as int)
_bput(out, i * 4 + 2, ((v >> (16 as u32)) & (0xFF as u32)) as int)
_bput(out, i * 4 + 3, ((v >> (24 as u32)) & (0xFF as u32)) as int)
end
end
func _md5(p: void*, n: int, out: void*):
mut s := _md5_init()
_md5_update(s, p, n)
_md5_final(s, out)
end
@en "Md5Bytes"
@fa "ام دی۵ بایت"
pub func Md5Bytes(p: void*, n: int, out: void*):
_md5(p, n, out)
end
@en "Md5Hex"
@fa "ام دی۵ شانزدهی"
pub func Md5Hex(data: str): str:
d := mem.Allocate(MD5_SIZE as u64)
defer mem.Free(d)
_md5(data as void*, data.len(), d)
mut r := ""
repeat MD5_SIZE in i:
r = r.concat(_hex_byte(_bget(d, i)))
end
ret r
end
package crypto
@en "Pbkdf2HmacSha256Hex"
@fa "پی بی کِی دی اف۲ شانزدهی"
pub func Pbkdf2HmacSha256Hex(password: str, salt: str, iterations: int, keylen: int): str:
plen := password.len()
slen := salt.len()
outp := mem.Allocate(keylen as u64)
defer mem.Free(outp)
_pbkdf2_hmac_sha256_core(password as void*, plen, salt as void*, slen, iterations, outp, keylen)
mut result := ""
repeat keylen in i:
result = result.concat(_hex_byte(_bget(outp, i)))
end
ret result
end
@en "HashPassword"
@fa "درهم گذرواژه"
pub func HashPassword(password: str): str:
salt := RandomHex(16)
dk := Pbkdf2HmacSha256Hex(password, salt, PBKDF2_DEFAULT_ITERATIONS, 32)
ret "pbkdf2-sha256$".concat(conv.FormatInt(PBKDF2_DEFAULT_ITERATIONS as i64)).concat("$").concat(salt).concat("$").concat(dk)
end
@en "VerifyPassword"
@fa "تایید گذرواژه"
pub func VerifyPassword(password: str, encoded: str): bool:
parts := str.Split(encoded, "$")
if parts.len() != 4:
ret false
end
if parts.get(0) != "pbkdf2-sha256":
ret false
end
iterations := conv.AtoiOr(parts.get(1), 0)
if iterations <= 0:
ret false
end
salt := parts.get(2)
stored := parts.get(3)
keylen := stored.len() / 2
computed := Pbkdf2HmacSha256Hex(password, salt, iterations, keylen)
ret _consttime_eq(computed, stored)
end
@en "SecretEquals"
@fa "برابری راز"
pub func SecretEquals(a: str, b: str): bool:
ret _consttime_eq(a, b)
end
package crypto
@en "RandomHex"
@fa "تصادفی ایمن شانزدهی"
pub func RandomHex(n: int): str:
if n <= 0:
ret ""
end
buf := mem.Allocate(n as u64)
defer mem.Free(buf)
_os_random_fill(buf, n)
mut result := ""
repeat n in i:
result = result.concat(_hex_byte(_bget(buf, i)))
end
ret result
end
@en "RandomToken"
@fa "توکن تصادفی ایمن"
pub func RandomToken(n: int): str:
ret RandomHex(n)
end
@en "RandomBytes"
@fa "بایت های تصادفی"
pub func RandomBytes(p: void*, n: int):
if n <= 0:
ret
end
_os_random_fill(p, n)
end
package crypto
@en "Sha1Hex"
@fa "شا۱ شانزدهی"
pub func Sha1Hex(data: str): str:
dlen := data.len()
out := mem.Allocate(20 as u64)
defer mem.Free(out)
_sha1_core(data as void*, dlen, out)
mut result := ""
repeat 5 in i:
base := i * 4
w := (_bget(out, base) as i64) * 16777216 + (_bget(out, base + 1) as i64) * 65536 + (_bget(out, base + 2) as i64) * 256 + (_bget(out, base + 3) as i64)
result = result.concat(_hex32(w))
end
ret result
end
@en "Sha1Base64"
@fa "شا۱ پایه۶۴"
pub func Sha1Base64(data: str): str:
dlen := data.len()
out := mem.Allocate(20 as u64)
defer mem.Free(out)
_sha1_core(data as void*, dlen, out)
result := encoding.Base64EncodeBytes(out, 20)
ret result
end
@en "Sha1Bytes"
@fa "شا۱ بایت"
pub func Sha1Bytes(p: void*, n: int, out: void*):
_sha1_core(p, n, out)
end
