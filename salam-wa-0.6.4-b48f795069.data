package opencv
import mem
import ai.image
@en "FromImage"
@fa "از تصویر"
pub func FromImage(img: image.Image): Mat:
if img.pixels == null or img.width <= 0 or img.height <= 0:
ret Mat { handle = null }
end
n := img.width * img.height
buf := mem.Allocate((n * 3) as u64)
defer mem.Free(buf)
src := img.pixels as u8*
dst := buf as u8*
mut i := 0
until i < n:
so := i * 4
do := i * 3
dst[do] = src[so]
dst[do + 1] = src[so + 1]
dst[do + 2] = src[so + 2]
i++
end
ret Mat { handle = scv_from_buffer(buf, img.width, img.height, 3) }
end
@en "ToImage"
@fa "به تصویر"
pub func ToImage(m: Mat): image.Image:
if m.handle == null: ret image.New(0, 0) end
w := m.width()
h := m.height()
mut out := image.New(w, h)
mut y := 0
until y < h:
mut x := 0
until x < w:
c := m.at(x, y)
image.SetPixel(out, x, y, image.RGBA(c.r, c.g, c.b, 255))
x++
end
y++
end
ret out
end
package opencv
import mem
import collections
@en "Mat"
@fa "ماتریس"
pub struct Mat:
@en "handle"
@fa "دسته"
pub handle: void* = null
@en "ok"
@fa "معتبر"
pub func ok(): bool: ret this.handle != null end
@en "empty"
@fa "خالی"
pub func empty(): bool:
if this.handle == null: ret true end
ret scv_empty(this.handle) != 0
end
@en "width"
@fa "عرض"
pub func width(): int:
if this.handle == null: ret 0 end
ret scv_width(this.handle)
end
@en "height"
@fa "ارتفاع"
pub func height(): int:
if this.handle == null: ret 0 end
ret scv_height(this.handle)
end
@en "channels"
@fa "کانال‌ها"
pub func channels(): int:
if this.handle == null: ret 0 end
ret scv_channels(this.handle)
end
@en "size"
@fa "اندازه"
pub func size(): Size: ret Size { width = this.width(), height = this.height() } end
@en "clone"
@fa "کپی"
pub func clone(): Mat:
if this.handle == null: ret Mat { handle = null } end
ret Mat { handle = scv_clone(this.handle) }
end
@en "free"
@fa "آزادسازی"
pub func free():
if this.handle != null:
scv_free(this.handle)
end
this.handle = null
end
@en "save"
@fa "ذخیره"
pub func save(path: str): bool:
if this.handle == null: ret false end
ret scv_write(path, this.handle) != 0
end
@en "data"
