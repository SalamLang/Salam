end
@en "Reindex"
@fa "نمایه‌سازی دوباره"
pub func Reindex(c: Client, source: str, dest: str): i64:
mut m := Vector {} as Vector<str>
m.push(json.MemberRaw("source", _one("index", json.Str(source))))
m.push(json.MemberRaw("dest", _one("index", json.Str(dest))))
r := Perform(c, "POST", "/_reindex?refresh=true", json.Object(m))
if not r.ok: ret -1 end
ret _i64(json.Get(r.body, "created")) + _i64(json.Get(r.body, "updated"))
end
@en "Analyze"
@fa "تحلیل"
pub func Analyze(c: Client, index: str, analyzer: str, text: str): Vector<str>:
mut out := Vector {} as Vector<str>
mut m := Vector {} as Vector<str>
if analyzer.len() > 0: m.push(json.Member("analyzer", analyzer)) end
m.push(json.Member("text", text))
mut path := "/_analyze"
if index.len() > 0: path = _ipath(index, "_analyze") end
r := Perform(c, "POST", path, json.Object(m))
if not r.ok: ret out end
each raw in json.Items(json.Get(r.body, "tokens")):
out.push(json.Get(raw, "token"))
end
ret out
end
package elasticsearch
import str
import conv
import encoding.json
func _wrap(kind: str, body: str): str:
mut m := Vector {} as Vector<str>
m.push(json.MemberRaw(kind, body))
ret json.Object(m)
end
func _field_obj(kind: str, field: str, raw: str): str:
mut inner := Vector {} as Vector<str>
inner.push(json.MemberRaw(field, raw))
ret _wrap(kind, json.Object(inner))
end
func _one(key: str, raw: str): str:
mut m := Vector {} as Vector<str>
m.push(json.MemberRaw(key, raw))
ret json.Object(m)
end
func _append_member(obj: str, member: str): str:
t := str.Trim(obj)
if t.len() < 2 or not str.StartsWith(t, "{"):
ret _one_member(member)
end
body := str.Trim(t.substr(1, t.len() - 2))
if body.len() == 0: ret "{" + member + "}" end
ret "{" + body + ", " + member + "}"
end
func _one_member(member: str): str:
mut m := Vector {} as Vector<str>
m.push(member)
ret json.Object(m)
end
func _bool_part(m &: Vector<str>, key: str, clauses: Vector<str>):
if clauses.len() == 0: ret end
m.push(json.MemberRaw(key, json.Array(clauses)))
end
