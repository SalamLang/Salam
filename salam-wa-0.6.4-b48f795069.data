o += s1
if not _zs_huf_stream(d, _zs_at(q, o), s2, _zs_at(d.lit, seg), seg):
ret 0 - 1
end
o += s2
if not _zs_huf_stream(d, _zs_at(q, o), s3, _zs_at(d.lit, 2 * seg), seg):
ret 0 - 1
end
o += s3
