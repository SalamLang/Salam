@en "ftp"
@fa "اف‌تی‌پی"
package ftp
import net.tcp
import tls
import conv
import mem
import str
import filepath
import fs.dir
extern:
func fopen(path: str, mode: str): void*
func fclose(stream: void*): int
func fread(ptr: void*, size: u64, nmemb: u64, stream: void*): u64
func fwrite(ptr: void*, size: u64, nmemb: u64, stream: void*): u64
end
mut _tls_slots := Vector {} as Vector<tls.Conn>
struct DataConn:
pub conn: tcp.Conn = tcp.Conn {}
pub tls_idx: int = 0 - 1
pub secure: bool = false
pub ok: bool = false
end
struct Bytes:
pub p: void* = null
pub len: int = 0
pub cap: int = 0
end
@en "FileInfo"
@fa "اطلاعات پرونده"
pub struct FileInfo:
@en "name"
@fa "نام"
pub name: str = ""
@en "size"
@fa "اندازه"
pub size: i64 = 0 as i64
@en "is_dir"
@fa "پوشه"
pub is_dir: bool = false
@en "is_link"
@fa "پیوند"
pub is_link: bool = false
@en "mode"
@fa "مجوزها"
pub mode: str = ""
@en "raw_date"
@fa "تاریخ خام"
pub raw_date: str = ""
end
@en "Client"
@fa "کارخواه"
pub struct Client:
@en "conn"
@fa "اتصال"
pub conn: tcp.Conn = tcp.Conn {}
@en "ok"
@fa "سالم"
pub ok: bool = false
@en "host"
@fa "میزبان"
pub host: str = ""
@en "port"
@fa "درگاه"
pub port: int = 21
@en "rxbuf"
@fa "بافر دریافت"
pub rxbuf: str = ""
@en "last_reply"
@fa "آخرین پاسخ"
pub last_reply: str = ""
@en "last_code"
@fa "آخرین کد"
pub last_code: int = 0
@en "secure"
@fa "امن"
pub secure: bool = false
@en "tls_idx"
@fa "شناسه درونی تی‌ال‌اس"
pub tls_idx: int = 0 - 1
@en "prot_p"
@fa "داده رمزشده"
pub prot_p: bool = false
@en "tls_cfg"
@fa "پیکربندی تی‌ال‌اس"
pub tls_cfg: tls.Config = tls.Config {}
end
func _bytes_new(cap: int): Bytes:
mut b := Bytes {}
mut want := cap
if want < 1024: want = 1024 end
b.p = mem.Allocate(want as u64)
b.cap = want
b.len = 0
ret b
end
func _bytes_grow(b &: Bytes, need: int):
if b.len + need <= b.cap: ret end
mut want := b.cap * 2
until want < b.len + need:
want *= 2
end
b.p = mem.Reallocate(b.p, want as u64)
b.cap = want
end
func _bytes_append(b &: Bytes, src: void*, n: int):
if n <= 0: ret end
_bytes_grow(b, n)
dst := ((b.p as i64) + (b.len as i64)) as void*
mem.Copy(dst, src, n as u64)
b.len += n
end
func _bytes_free(b &: Bytes):
if b.p != null: mem.Free(b.p) end
b.p = null
b.len = 0
b.cap = 0
end
func _is_digits(s: str, from: int, n: int): bool:
if s.len() < from + n: ret false end
mut ok := true
repeat n in i:
ch := s.substr(from + i, 1)
if ch < "0" or ch > "9": ok = false end
end
ret ok
end
func _code_of(line: str): int:
if not _is_digits(line, 0, 3): ret 0 end
ret line.substr(0, 3).to_int()
end
func _is_final(line: str): bool:
if line.len() < 4: ret false end
if not _is_digits(line, 0, 3): ret false end
ret line.substr(3, 1) == " "
end
func _fill(c &: Client): bool:
mut chunk := ""
if c.secure:
mut tc := _tls_slots.get(c.tls_idx)
chunk = tls.Read(tc, 4096)
_tls_slots.set(c.tls_idx, tc)
else:
chunk = tcp.Read(c.conn, 4096)
end
if chunk.len() == 0: ret false end
c.rxbuf += chunk
ret true
end
func _read_line(c &: Client): str:
mut idx := c.rxbuf.find("\r\n")
mut spin := 0
until idx < 0 and spin < 400:
if not _fill(c):
spin = 400
else:
idx = c.rxbuf.find("\r\n")
spin++
end
end
if idx < 0:
line := c.rxbuf
c.rxbuf = ""
ret line
end
line := c.rxbuf.substr(0, idx)
c.rxbuf = c.rxbuf.substr(idx + 2, c.rxbuf.len() - idx - 2)
ret line
end
func _read_reply(c &: Client): int:
mut full := ""
mut done := false
mut guard := 0
mut opened := 0
until not done and guard < 2000:
line := _read_line(c)
if guard == 0: opened = _code_of(line) end
if full.len() > 0: full += "\r\n" end
full += line
if line.len() == 0:
done = true
else _is_final(line) and _code_of(line) == opened:
done = true
end
guard++
end
c.last_reply = full
c.last_code = _code_of(full)
ret c.last_code
end
func _send(c &: Client, line: str): int:
if c.secure:
mut tc := _tls_slots.get(c.tls_idx)
n := tls.Write(tc, line + "\r\n")
_tls_slots.set(c.tls_idx, tc)
ret n
end
ret tcp.Write(c.conn, line + "\r\n")
end
func _cmd(c &: Client, line: str): int:
if line.find("\r") >= 0 or line.find("\n") >= 0:
c.last_reply = "500 refused locally: command contains CR or LF"
c.last_code = 500
ret 500
end
_send(c, line)
ret _read_reply(c)
end
func _good(code: int): bool:
ret code >= 100 and code < 400
end
func _fields(s: str): Vector<str>:
mut out := Vector {} as Vector<str>
mut cur := ""
repeat s.len() in i:
ch := s.substr(i, 1)
if ch == " " or ch == "\t":
if cur.len() > 0:
out.push(cur)
cur = ""
end
else:
cur += ch
end
end
if cur.len() > 0: out.push(cur) end
ret out
end
func _skip_fields(s: str, n: int): int:
mut pos := 0
mut seen := 0
until seen < n and pos < s.len():
until pos < s.len() and (s.substr(pos, 1) == " " or s.substr(pos, 1) == "\t"):
pos++
end
if pos >= s.len(): ret pos end
until pos < s.len() and s.substr(pos, 1) != " " and s.substr(pos, 1) != "\t":
pos++
end
seen++
end
until pos < s.len() and (s.substr(pos, 1) == " " or s.substr(pos, 1) == "\t"):
pos++
end
ret pos
end
func _parse_pasv(reply: str): str:
open_at := reply.find("(")
if open_at < 0: ret "" end
rest := reply.substr(open_at + 1, reply.len() - open_at - 1)
close_at := rest.find(")")
if close_at < 0: ret "" end
inner := rest.substr(0, close_at)
parts := str.Split(inner, ",")
defer parts.free()
if parts.len() < 6: ret "" end
mut host := ""
repeat 4 in i:
if i > 0: host += "." end
host += str.Trim(parts.get(i))
end
hi := str.Trim(parts.get(4)).to_int()
lo := str.Trim(parts.get(5)).to_int()
port := hi * 256 + lo
if port <= 0 or port > 65535: ret "" end
ret host + ":" + conv.FormatInt(port as i64)
end
func _parse_epsv(reply: str): int:
open_at := reply.find("(")
if open_at < 0: ret 0 end
rest := reply.substr(open_at + 1, reply.len() - open_at - 1)
close_at := rest.find(")")
if close_at < 0: ret 0 end
inner := rest.substr(0, close_at)
if inner.len() == 0: ret 0 end
delim := inner.substr(0, 1)
parts := str.Split(inner, delim)
defer parts.free()
mut port := 0
each p in parts:
t := str.Trim(p)
if t.len() > 0 and _is_digits(t, 0, t.len()):
port = t.to_int()
end
end
if port <= 0 or port > 65535: ret 0 end
ret port
end
func _parse_list_line(line: str): FileInfo:
mut fi := FileInfo {}
t := str.Trim(line)
if t.len() == 0: ret fi end
f := _fields(t)
defer f.free()
if f.len() < 4: ret fi end
first := f.get(0)
if first.len() >= 8 and first.find("-") == 2:
fi.raw_date = first + " " + f.get(1)
third := f.get(2)
if third == "<DIR>":
fi.is_dir = true
else:
fi.size = third.to_int() as i64
end
at := _skip_fields(t, 3)
if at < t.len(): fi.name = str.Trim(t.substr(at, t.len() - at)) end
ret fi
end
if first.len() < 10 or f.len() < 9: ret fi end
kind := first.substr(0, 1)
fi.is_dir = kind == "d"
fi.is_link = kind == "l"
fi.mode = first.substr(1, first.len() - 1)
fi.size = f.get(4).to_int() as i64
fi.raw_date = f.get(5) + " " + f.get(6) + " " + f.get(7)
at := _skip_fields(t, 8)
mut name := ""
if at < t.len(): name = str.Trim(t.substr(at, t.len() - at)) end
arrow := name.find(" -> ")
if fi.is_link and arrow > 0: name = name.substr(0, arrow) end
fi.name = name
ret fi
end
func _data_open(c &: Client): DataConn:
mut d := DataConn {}
mut raw := tcp.Conn {}
if _good(_cmd(c, "EPSV")) and c.last_code == 229:
port := _parse_epsv(c.last_reply)
if port > 0:
raw = tcp.Dial(c.host, port)
end
end
if not tcp.ConnOk(raw) and _cmd(c, "PASV") == 227:
addr := _parse_pasv(c.last_reply)
if addr.len() > 0:
sep := addr.find(":")
port := addr.substr(sep + 1, addr.len() - sep - 1).to_int()
raw = tcp.Dial(c.host, port)
end
end
if not tcp.ConnOk(raw): ret d end
if c.prot_p:
tc := tcp.UpgradeTLS(raw, c.tls_cfg)
if not tls.ConnOk(tc): ret d end
_tls_slots.push(tc)
d.tls_idx = _tls_slots.len() - 1
d.secure = true
d.ok = true
ret d
end
d.conn = raw
d.ok = true
ret d
end
func _data_read(d &: DataConn, max: int): str:
if d.secure:
mut tc := _tls_slots.get(d.tls_idx)
chunk := tls.Read(tc, max)
_tls_slots.set(d.tls_idx, tc)
ret chunk
end
ret tcp.Read(d.conn, max)
end
func _data_write(d &: DataConn, payload: str): int:
if d.secure:
mut tc := _tls_slots.get(d.tls_idx)
n := tls.Write(tc, payload)
_tls_slots.set(d.tls_idx, tc)
ret n
end
ret tcp.Write(d.conn, payload)
end
func _data_read_bytes(d &: DataConn, buf: void*, max: int): int:
if d.secure:
mut tc := _tls_slots.get(d.tls_idx)
n := tls.ReadBytes(tc, buf, max)
_tls_slots.set(d.tls_idx, tc)
ret n
end
ret tcp.ReadBytes(d.conn, buf, max)
end
func _data_write_bytes(d &: DataConn, ptr: void*, n: int): int:
if d.secure:
mut tc := _tls_slots.get(d.tls_idx)
w := tls.WriteBytes(tc, ptr, n)
_tls_slots.set(d.tls_idx, tc)
ret w
end
ret tcp.WriteBytes(d.conn, ptr, n)
end
func _drain_bytes(d &: DataConn): Bytes:
mut out := _bytes_new(16384)
chunk := mem.Allocate(16384 as u64)
mut more := true
until more:
n := _data_read_bytes(d, chunk, 16384)
if n <= 0:
more = false
else:
_bytes_append(out, chunk, n)
end
end
mem.Free(chunk)
ret out
end
func _data_close(d &: DataConn):
if d.secure:
mut tc := _tls_slots.get(d.tls_idx)
tls.Close(tc)
_tls_slots.set(d.tls_idx, tc)
else:
tcp.Close(d.conn)
end
d.ok = false
end
func _drain(d &: DataConn): str:
mut out := ""
mut more := true
until more:
chunk := _data_read(d, 8192)
if chunk.len() == 0:
more = false
else:
out += chunk
end
end
ret out
end
func _xfer_in(c &: Client, command: str): str:
mut dc := _data_open(c)
if not dc.ok: ret "" end
code := _cmd(c, command)
if not _good(code):
_data_close(dc)
ret ""
end
body := _drain(dc)
_data_close(dc)
_read_reply(c)
ret body
end
func _xfer_out(c &: Client, command: str, payload: str): bool:
mut dc := _data_open(c)
if not dc.ok: ret false end
code := _cmd(c, command)
if not _good(code):
_data_close(dc)
ret false
end
mut sent := 0
if payload.len() > 0: sent = _data_write(dc, payload) end
_data_close(dc)
final := _read_reply(c)
ret _good(final) and (payload.len() == 0 or sent > 0)
end
func _xfer_in_bytes(c &: Client, command: str): Bytes:
mut dc := _data_open(c)
if not dc.ok: ret _bytes_new(0) end
code := _cmd(c, command)
if not _good(code):
_data_close(dc)
ret _bytes_new(0)
end
body := _drain_bytes(dc)
_data_close(dc)
_read_reply(c)
ret body
end
func _xfer_out_bytes(c &: Client, command: str, ptr: void*, n: int): bool:
mut dc := _data_open(c)
if not dc.ok: ret false end
code := _cmd(c, command)
if not _good(code):
_data_close(dc)
ret false
end
mut sent := 0
if n > 0: sent = _data_write_bytes(dc, ptr, n) end
_data_close(dc)
final := _read_reply(c)
ret _good(final) and (n == 0 or sent == n)
end
func _safe_component(name: str): bool:
if name.len() == 0: ret false end
if name == "." or name == "..": ret false end
if name.find("/") >= 0: ret false end
if name.find("\\") >= 0: ret false end
ret true
end
func _remote_join(base: str, name: str): str:
if base.len() == 0: ret name end
if base.ends_with("/"): ret base + name end
ret base + "/" + name
end
@en "Dial"
@fa "اتصال"
pub func Dial(host: str, port: int): Client:
mut c := Client {}
c.host = host
c.port = port
c.conn = tcp.Dial(host, port)
if not tcp.ConnOk(c.conn): ret c end
c.ok = _read_reply(c) == 220
ret c
end
@en "AuthTLSWith"
@fa "ارتقا به تی‌ال‌اس"
pub func AuthTLSWith(c &: Client, cfg: tls.Config): bool:
if not c.ok or c.secure: ret false end
if _cmd(c, "AUTH TLS") != 234: ret false end
c.tls_cfg = cfg
tc := tcp.UpgradeTLS(c.conn, cfg)
if not tls.ConnOk(tc): ret false end
_tls_slots.push(tc)
c.tls_idx = _tls_slots.len() - 1
c.secure = true
c.rxbuf = ""
if _cmd(c, "PBSZ 0") == 200:
c.prot_p = _cmd(c, "PROT P") == 200
end
ret true
end
@en "AuthTLS"
@fa "احراز تی‌ال‌اس"
pub func AuthTLS(c &: Client): bool:
ret AuthTLSWith(c, tls.NewConfig(c.host))
end
@en "DialTLS"
@fa "اتصال امن"
pub func DialTLS(host: str, port: int): Client:
mut c := Dial(host, port)
if not c.ok: ret c end
if not AuthTLS(c): c.ok = false end
ret c
end
@en "DialTLSWith"
@fa "اتصال امن با تنظیمات"
pub func DialTLSWith(host: str, port: int, cfg: tls.Config): Client:
mut c := Dial(host, port)
if not c.ok: ret c end
if not AuthTLSWith(c, cfg): c.ok = false end
ret c
end
@en "Secure"
@fa "امن"
pub func Secure(c: Client): bool: ret c.secure end
@en "SecureData"
@fa "داده امن"
pub func SecureData(c: Client): bool: ret c.prot_p end
@en "Login"
@fa "ورود"
pub func Login(c &: Client, user: str, password: str): bool:
if not c.ok: ret false end
code := _cmd(c, "USER " + user)
if code == 230: ret true end
if code != 331: ret false end
ret _cmd(c, "PASS " + password) == 230
end
@en "Quit"
@fa "خروج"
pub func Quit(c &: Client):
if tcp.ConnOk(c.conn):
_bye := _cmd(c, "QUIT")
if c.secure:
mut tc := _tls_slots.get(c.tls_idx)
tls.Close(tc)
_tls_slots.set(c.tls_idx, tc)
c.secure = false
else:
tcp.Close(c.conn)
end
end
c.ok = false
end
@en "Close"
@fa "بستن"
pub func Close(c &: Client):
Quit(c)
end
@en "Ok"
@fa "سالم"
pub func Ok(c: Client): bool: ret c.ok end
@en "LastReply"
@fa "آخرین پاسخ"
pub func LastReply(c: Client): str: ret c.last_reply end
@en "LastCode"
@fa "آخرین کد"
pub func LastCode(c: Client): int: ret c.last_code end
@en "Command"
@fa "فرمان"
pub func Command(c &: Client, line: str): int: ret _cmd(c, line) end
@en "Noop"
@fa "بی‌کار"
pub func Noop(c &: Client): bool: ret _cmd(c, "NOOP") == 200 end
@en "System"
@fa "سامانه"
pub func System(c &: Client): str:
if _cmd(c, "SYST") != 215: ret "" end
ret c.last_reply
end
@en "Features"
@fa "قابلیت‌ها"
pub func Features(c &: Client): str:
if not _good(_cmd(c, "FEAT")): ret "" end
ret c.last_reply
end
@en "Binary"
@fa "دودویی"
pub func Binary(c &: Client): bool: ret _cmd(c, "TYPE I") == 200 end
@en "Ascii"
@fa "متنی"
pub func Ascii(c &: Client): bool: ret _cmd(c, "TYPE A") == 200 end
@en "Pwd"
@fa "مسیر جاری"
pub func Pwd(c &: Client): str:
if _cmd(c, "PWD") != 257: ret "" end
q := c.last_reply.find("\"")
if q < 0: ret "" end
rest := c.last_reply.substr(q + 1, c.last_reply.len() - q - 1)
q2 := rest.find("\"")
if q2 < 0: ret "" end
ret rest.substr(0, q2)
end
@en "Cwd"
@fa "تغییر مسیر"
pub func Cwd(c &: Client, path: str): bool: ret _cmd(c, "CWD " + path) == 250 end
@en "CdUp"
@fa "یک سطح بالا"
pub func CdUp(c &: Client): bool:
code := _cmd(c, "CDUP")
ret code == 250 or code == 200
end
@en "Mkdir"
@fa "ساخت پوشه"
pub func Mkdir(c &: Client, path: str): bool: ret _cmd(c, "MKD " + path) == 257 end
@en "Rmdir"
@fa "حذف پوشه"
pub func Rmdir(c &: Client, path: str): bool: ret _cmd(c, "RMD " + path) == 250 end
@en "MkdirAll"
@fa "ساخت مسیر کامل"
pub func MkdirAll(c &: Client, path: str): bool:
parts := str.Split(path, "/")
defer parts.free()
mut cur := ""
if path.starts_with("/"): cur = "" end
mut ok := true
each part in parts:
if part.len() > 0:
cur = _remote_join(cur, part)
if path.starts_with("/") and not cur.starts_with("/"): cur = "/" + cur end
if not IsDir(c, cur): Mkdir(c, cur) end
end
end
ok = IsDir(c, path)
ret ok
end
@en "ListRaw"
@fa "فهرست خام"
pub func ListRaw(c &: Client, path: str): str:
mut command := "LIST"
if path.len() > 0: command = "LIST " + path end
ret _xfer_in(c, command)
end
@en "List"
@fa "فهرست"
pub func List(c &: Client, path: str): Vector<FileInfo>:
mut out := Vector {} as Vector<FileInfo>
body := ListRaw(c, path)
if body.len() == 0: ret out end
lines := str.Split(body, "\n")
defer lines.free()
each line in lines:
fi := _parse_list_line(line)
if fi.name.len() > 0 and fi.name != "." and fi.name != "..":
out.push(fi)
end
end
ret out
end
@en "NameList"
@fa "فهرست نام‌ها"
pub func NameList(c &: Client, path: str): Vector<str>:
mut out := Vector {} as Vector<str>
mut command := "NLST"
if path.len() > 0: command = "NLST " + path end
body := _xfer_in(c, command)
if body.len() == 0: ret out end
lines := str.Split(body, "\n")
defer lines.free()
each line in lines:
t := str.Trim(line)
if t.len() > 0 and t != "." and t != "..": out.push(t) end
end
ret out
end
@en "Size"
@fa "اندازه"
pub func Size(c &: Client, path: str): i64:
if _cmd(c, "SIZE " + path) != 213: ret 0 - 1 as i64 end
f := _fields(c.last_reply)
defer f.free()
if f.len() < 2: ret 0 - 1 as i64 end
ret f.get(1).to_int()
end
@en "ModTime"
@fa "زمان تغییر"
pub func ModTime(c &: Client, path: str): str:
if _cmd(c, "MDTM " + path) != 213: ret "" end
f := _fields(c.last_reply)
defer f.free()
if f.len() < 2: ret "" end
ret f.get(1)
end
@en "IsDir"
@fa "پوشه است"
pub func IsDir(c &: Client, path: str): bool:
here := Pwd(c)
if not Cwd(c, path): ret false end
if here.len() > 0: Cwd(c, here) end
ret true
end
@en "IsLink"
@fa "پیوند است"
pub func IsLink(c &: Client, path: str): bool:
mut slash := 0 - 1
repeat path.len() in i:
if path.substr(i, 1) == "/": slash = i end
end
mut parent := ""
mut name := path
if slash >= 0:
parent = path.substr(0, slash)
name = path.substr(slash + 1, path.len() - slash - 1)
if parent.len() == 0: parent = "/" end
end
if name.len() == 0: ret false end
entries := List(c, parent)
defer entries.free()
mut found := false
each e in entries:
if e.name == name and e.is_link: found = true end
end
ret found
end
@en "Exists"
@fa "وجود دارد"
pub func Exists(c &: Client, path: str): bool:
if Size(c, path) >= (0 as i64): ret true end
ret IsDir(c, path)
end
@en "Read"
@fa "خواندن"
pub func Read(c &: Client, remote: str): str:
ret _xfer_in(c, "RETR " + remote)
end
@en "Write"
@fa "نوشتن"
pub func Write(c &: Client, remote: str, data: str): bool:
ret _xfer_out(c, "STOR " + remote, data)
end
@en "Append"
@fa "افزودن"
pub func Append(c &: Client, remote: str, data: str): bool:
ret _xfer_out(c, "APPE " + remote, data)
end
@en "Download"
@fa "دریافت"
pub func Download(c &: Client, remote: str, local: str): bool:
mut body := _xfer_in_bytes(c, "RETR " + remote)
if not _good(c.last_code):
_bytes_free(body)
ret false
end
out := fopen(local, "wb")
if out == null:
_bytes_free(body)
ret false
end
mut wrote := 0 as u64
if body.len > 0:
wrote = fwrite(body.p, 1 as u64, body.len as u64, out)
end
fclose(out)
ok := wrote == (body.len as u64)
_bytes_free(body)
ret ok
end
@en "Upload"
@fa "ارسال"
pub func Upload(c &: Client, local: str, remote: str): bool:
src := fopen(local, "rb")
if src == null: ret false end
mut buf := _bytes_new(65536)
chunk := mem.Allocate(65536 as u64)
mut more := true
until more:
n := fread(chunk, 1 as u64, 65536 as u64, src)
if n == (0 as u64):
more = false
else:
_bytes_append(buf, chunk, n as int)
end
end
mem.Free(chunk)
fclose(src)
ok := _xfer_out_bytes(c, "STOR " + remote, buf.p, buf.len)
_bytes_free(buf)
ret ok
end
@en "Delete"
@fa "حذف"
pub func Delete(c &: Client, path: str): bool: ret _cmd(c, "DELE " + path) == 250 end
@en "Rename"
@fa "تغییر نام"
pub func Rename(c &: Client, from_path: str, to_path: str): bool:
if _cmd(c, "RNFR " + from_path) != 350: ret false end
ret _cmd(c, "RNTO " + to_path) == 250
end
@en "Move"
@fa "انتقال"
pub func Move(c &: Client, from_path: str, to_path: str): bool:
ret Rename(c, from_path, to_path)
end
@en "RemoveAll"
@fa "حذف همه"
pub func RemoveAll(c &: Client, path: str): bool:
if IsLink(c, path): ret Delete(c, path) end
if not IsDir(c, path): ret Delete(c, path) end
entries := List(c, path)
defer entries.free()
mut ok := true
each e in entries:
child := _remote_join(path, e.name)
if e.is_dir and not e.is_link:
if not RemoveAll(c, child): ok = false end
else:
if not Delete(c, child): ok = false end
end
end
if not Rmdir(c, path): ok = false end
ret ok
end
@en "DownloadDir"
@fa "دریافت پوشه"
pub func DownloadDir(c &: Client, remote: str, local: str): bool:
dir.MkdirAll(local)
entries := List(c, remote)
defer entries.free()
mut ok := true
each e in entries:
if not _safe_component(e.name):
ok = false
continue
end
rchild := _remote_join(remote, e.name)
lchild := filepath.Join(local, e.name)
if e.is_dir:
if not DownloadDir(c, rchild, lchild): ok = false end
else not e.is_link:
if not Download(c, rchild, lchild): ok = false end
end
end
ret ok
end
@en "UploadDir"
@fa "ارسال پوشه"
pub func UploadDir(c &: Client, local: str, remote: str): bool:
MkdirAll(c, remote)
names := dir.List(local)
defer names.free()
mut ok := true
each name in names:
if not _safe_component(name):
ok = false
continue
end
lchild := filepath.Join(local, name)
rchild := _remote_join(remote, name)
if dir.IsDir(lchild):
if not UploadDir(c, lchild, rchild): ok = false end
else:
if not Upload(c, lchild, rchild): ok = false end
end
end
ret ok
end
@en "ReplyCode"
@fa "کد پاسخ"
pub func ReplyCode(line: str): int: ret _code_of(line) end
@en "IsFinalLine"
@fa "خط پایانی است"
pub func IsFinalLine(line: str): bool: ret _is_final(line) end
@en "ParsePasv"
@fa "تحلیل پسیو"
pub func ParsePasv(reply: str): str: ret _parse_pasv(reply) end
@en "ParseEpsv"
@fa "تحلیل پسیو گسترده"
pub func ParseEpsv(reply: str): int: ret _parse_epsv(reply) end
@en "ParseListLine"
@fa "تحلیل خط فهرست"
pub func ParseListLine(line: str): FileInfo: ret _parse_list_line(line) end
@en "google"
@fa "گوگل"
package google
import mem
import sync
import str
import net.http
import encoding
import encoding.json
import crypto
import tls
import time
const RENEW_MARGIN_SECONDS := 60
const ASSERTION_TTL_SECONDS := 3600
const GRANT_TYPE := "urn:ietf:params:oauth:grant-type:jwt-bearer"
@en "SCOPE_FCM"
@fa "دامنه اف سی ام"
pub const SCOPE_FCM := "https://www.googleapis.com/auth/firebase.messaging"
@en "SCOPE_STORAGE"
@fa "دامنه ذخیره‌سازی"
pub const SCOPE_STORAGE := "https://www.googleapis.com/auth/devstorage.read_write"
@en "SCOPE_CLOUD"
@fa "دامنه ابر"
pub const SCOPE_CLOUD := "https://www.googleapis.com/auth/cloud-platform"
mut _cache_lock := sync.NewMutex()
mut _cache_keys := Vector {} as Vector<str>
mut _cache_tokens := Vector {} as Vector<str>
mut _cache_expiry := Vector {} as Vector<i64>
@en "ServiceAccount"
@fa "حساب سرویس"
pub struct ServiceAccount:
@en "client_email"
@fa "ایمیل حساب"
pub client_email: str = ""
@en "private_key"
@fa "کلید خصوصی"
pub private_key: str = ""
@en "token_uri"
@fa "نشانی توکن"
pub token_uri: str = "https://oauth2.googleapis.com/token"
@en "project_id"
@fa "شناسه پروژه"
pub project_id: str = ""
@en "ok"
@fa "موفق"
pub ok: bool = false
end
func _b64url(standard: str): str:
mut out := str.Replace(str.Replace(standard, "+", "-"), "/", "_")
until out.ends_with("="):
out = out.substr(0, out.len() - 1)
end
ret out
end
func _part(payload: str): str:
ret _b64url(encoding.Base64Encode(payload))
end
func _digest(signing_input: str): str:
out := mem.AllocateZeroed(32 as u64)
defer mem.Free(out)
crypto.Sha256Bytes(signing_input as void*, signing_input.len(), out)
ret encoding.Base64EncodeBytes(out, 32)
end
func _assertion(sa: ServiceAccount, scope: str, now: i64): str:
header := _part(`{"alg":"RS256","typ":"JWT"}`)
claims := _part(
`{"iss":"` + sa.client_email + `","scope":"` + scope + `","aud":"` + sa.token_uri + `","iat":` + _num(now) + `,"exp":` + _num(now + (ASSERTION_TTL_SECONDS as i64)) + `}`
)
signing_input := header + "." + claims
mut ok := false
signature := tls.RsaSignPkcs1Sha256(sa.private_key, _digest(signing_input), ok)
if not ok: ret "" end
ret signing_input + "." + _b64url(signature)
end
func _num(value: i64): str:
mut v := value
if v <= 0 as i64: ret "0" end
mut out := ""
until v > 0 as i64:
out = "0123456789".substr((v % (10 as i64)) as int, 1) + out
v /= (10 as i64)
end
ret out
end
func _cached(key: str, now: i64): str:
repeat _cache_keys.len() in i:
if _cache_keys.get(i) == key and _cache_expiry.get(i) > now:
ret _cache_tokens.get(i)
end
end
ret ""
end
func _remember(key: str, token: str, expires_at: i64):
repeat _cache_keys.len() in i:
if _cache_keys.get(i) == key:
_cache_tokens.set(i, token)
_cache_expiry.set(i, expires_at)
ret
end
end
_cache_keys.push(key)
_cache_tokens.push(token)
_cache_expiry.push(expires_at)
end
func _exchange(sa: ServiceAccount, scope: str, now: i64, ok &: bool): str:
ok = false
assertion := _assertion(sa, scope, now)
if assertion.len() == 0: ret "" end
mut headers := http.NewHeaders()
defer headers.free()
headers.put("Content-Type", "application/x-www-form-urlencoded")
body := "grant_type=" + encoding.URLEncode(GRANT_TYPE) + "&assertion=" + assertion
response := http.PostWith(sa.token_uri, body, headers)
if not http.Ok(response): ret "" end
token := json.Get(http.Body(response), "access_token")
if token.len() == 0: ret "" end
ok = true
ret token
end
func _mint(sa: ServiceAccount, scope: str, key: str, now: i64, ok &: bool): str:
token := _exchange(sa, scope, now, ok)
if not ok: ret "" end
sync.Lock(_cache_lock)
_remember(key, token, now + (ASSERTION_TTL_SECONDS as i64) - (RENEW_MARGIN_SECONDS as i64))
sync.Unlock(_cache_lock)
ret token
end
@en "ParseServiceAccount"
@fa "تجزیه حساب سرویس"
pub func ParseServiceAccount(document: str): ServiceAccount:
if document.len() == 0: ret ServiceAccount {} end
email := json.Get(document, "client_email")
key := json.Get(document, "private_key")
if email.len() == 0 or key.len() == 0: ret ServiceAccount {} end
mut sa := ServiceAccount {
client_email = email, private_key = key, project_id = json.Get(document, "project_id"), ok = true
}
uri := json.Get(document, "token_uri")
if uri.len() > 0: sa.token_uri = uri end
ret sa
end
@en "AccessToken"
@fa "توکن دسترسی"
pub func AccessToken(sa: ServiceAccount, scope: str, ok &: bool): str:
ok = false
if not sa.ok or scope.len() == 0: ret "" end
now := time.Now()
key := sa.client_email + "|" + scope
sync.Lock(_cache_lock)
hit := _cached(key, now)
sync.Unlock(_cache_lock)
if hit.len() > 0:
ok = true
ret hit
end
ret _mint(sa, scope, key, now, ok)
end
@en "Forget"
@fa "فراموش کردن توکن"
pub func Forget(sa: ServiceAccount):
sync.Lock(_cache_lock)
mut keys := Vector {} as Vector<str>
mut tokens := Vector {} as Vector<str>
mut expiry := Vector {} as Vector<i64>
repeat _cache_keys.len() in i:
if not str.StartsWith(_cache_keys.get(i), sa.client_email + "|"):
keys.push(_cache_keys.get(i))
tokens.push(_cache_tokens.get(i))
expiry.push(_cache_expiry.get(i))
end
end
_cache_keys.free()
_cache_tokens.free()
_cache_expiry.free()
_cache_keys = keys
_cache_tokens = tokens
_cache_expiry = expiry
sync.Unlock(_cache_lock)
end
@en "Authorization"
@fa "سرآیند مجوز"
pub func Authorization(token: str): str:
ret "Bearer " + token
end
package graph
@en "FloydWarshall"
@fa "فلوید وارشال"
pub func FloydWarshall(g &: Graph): Matrix:
mut next := NewIntMatrix(0, 0, 0)
m := FloydWarshallPaths(g, next)
defer next.free()
ret m
end
@en "FloydWarshallPaths"
@fa "فلوید وارشال با مسیر"
pub func FloydWarshallPaths(g &: Graph, next &: IntMatrix): Matrix:
n := g.n
mut d := WeightMatrix(g)
next.rows = n
next.cols = n
FillInt(next.a, n * n, GRAPH_NONE)
_init_next(g, d, next)
repeat n in k:
repeat n in i:
if d.at(i, k) < GRAPH_INF: _fw_row(d, next, i, k, n) end
end
end
ret d
end
@en "FloydPath"
@fa "مسیر فلوید"
pub func FloydPath(next &: IntMatrix, s: int, t: int): Vector<int>:
mut out := Vector {} as Vector<int>
if next.at(s, t) == GRAPH_NONE: ret out end
mut u := s
out.push(u)
until u != t:
u = next.at(u, t)
out.push(u)
end
ret out
end
@en "Johnson"
@fa "جانسون"
pub func Johnson(g &: Graph): Matrix:
n := g.n
mut out := NewMatrix(n, n)
mut pot := Vector {} as Vector<f64>
defer pot.free()
mut parent := Vector {} as Vector<int>
defer parent.free()
FillFloat(pot, n, 0.0)
FillInt(parent, n, GRAPH_NONE)
mut round := 0
until round < n:
if _bf_pass(g, pot, parent) == false: break end
round++
end
if round == n: ret _all_inf(out, n) end
_johnson_rows(g, pot, out)
ret out
end
@en "AStar"
@fa "ای‌استار"
pub func AStar(g &: Graph, src: int, target: int, heuristic: Vector<f64>): Vector<int>:
mut dist := Vector {} as Vector<f64>
defer dist.free()
mut parent := Vector {} as Vector<int>
defer parent.free()
FillFloat(dist, g.n, GRAPH_INF)
FillInt(parent, g.n, GRAPH_NONE)
mut h := MinHeap {}
defer h.free()
dist.set(src, 0.0)
h.push(heuristic.get(src), src)
until h.is_empty() == false:
u := h.pop()
if u == target: break end
_relax_astar(g, u, dist, parent, h, heuristic)
end
ret PathFromParents(parent, src, target)
end
@en "KShortestLengths"
@fa "کوتاه‌ترین طول‌ها"
pub func KShortestLengths(g &: Graph, s: int, t: int, k: int): Vector<f64>:
mut out := Vector {} as Vector<f64>
mut count := Vector {} as Vector<int>
defer count.free()
FillInt(count, g.n, 0)
mut h := MinHeap {}
defer h.free()
h.push(0.0, s)
until h.is_empty() == false:
if out.len() >= k: break end
d := h.top_key()
u := h.pop()
if count.get(u) < k:
count.set(u, count.get(u) + 1)
if u == t: out.push(d) end
_push_successors(g, u, d, h)
end
end
ret out
end
@en "AllPairsHops"
@fa "همه فاصله‌های گامی"
pub func AllPairsHops(g &: Graph): IntMatrix:
n := g.n
mut m := NewIntMatrix(n, n, GRAPH_NONE)
mut dist := Vector {} as Vector<int>
defer dist.free()
mut parent := Vector {} as Vector<int>
defer parent.free()
repeat n in s:
BFSFrom(g, s, dist, parent)
repeat n in t: m.set(s, t, dist.get(t)) end
end
ret m
end
package graph
import math
func _brandes_bfs(g &: Graph, s: int, dist &: Vector<int>, sigma &: Vector<f64>, order &: Vector<int>):
FillInt(dist, g.n, GRAPH_NONE)
FillFloat(sigma, g.n, 0.0)
order.clear()
dist.set(s, 0)
sigma.set(s, 1.0)
order.push(s)
mut head := 0
until head < order.len():
u := order.get(head)
head++
_brandes_scan(g, u, dist, sigma, order)
end
end
func _brandes_scan(g &: Graph, u: int, dist &: Vector<int>, sigma &: Vector<f64>, order &: Vector<int>):
mut k := g.adj_start(u)
stop := g.adj_stop(u)
until k < stop:
v := g.adj_node(k)
if dist.get(v) == GRAPH_NONE:
dist.set(v, dist.get(u) + 1)
order.push(v)
end
if dist.get(v) == dist.get(u) + 1: sigma.set(v, sigma.get(v) + sigma.get(u)) end
k++
end
end
func _brandes_back(g &: Graph, s: int, dist: Vector<int>, sigma: Vector<f64>, order: Vector<int>, delta &: Vector<f64>, score &: Vector<f64>, edge_score &: Vector<f64>):
FillFloat(delta, g.n, 0.0)
mut i := order.len() - 1
until i >= 0:
w := order.get(i)
_brandes_push(g, w, dist, sigma, delta, edge_score)
if w != s: score.set(w, score.get(w) + delta.get(w)) end
i--
end
end
func _brandes_push(g &: Graph, w: int, dist: Vector<int>, sigma: Vector<f64>, delta &: Vector<f64>, edge_score &: Vector<f64>):
mut k := g.in_start(w)
stop := g.in_stop(w)
until k < stop:
v := g.in_node(k)
if dist.get(v) == dist.get(w) - 1:
share := sigma.get(v) / sigma.get(w) * (1.0 + delta.get(w))
delta.set(v, delta.get(v) + share)
if edge_score.len() > 0:
e := g.in_edge(k)
edge_score.set(e, edge_score.get(e) + share)
end
end
k++
end
end
func _normalize(v &: Vector<f64>):
mut norm := 0.0
repeat v.len() in i: norm += v.get(i) * v.get(i) end
norm = math.Sqrt(norm)
if norm <= 0.0: ret end
repeat v.len() in i: v.set(i, v.get(i) / norm) end
end
func _scale_to_sum(v &: Vector<f64>):
mut s := 0.0
repeat v.len() in i: s += v.get(i) end
if s <= 0.0: ret end
repeat v.len() in i: v.set(i, v.get(i) / s) end
end
func _delta_of(a: Vector<f64>, b: Vector<f64>): f64:
mut d := 0.0
repeat a.len() in i: d += math.Abs(a.get(i) - b.get(i)) end
ret d
end
func _spread_out(g &: Graph, src: Vector<f64>, dst &: Vector<f64>):
FillFloat(dst, g.n, 0.0)
repeat g.n in u:
mut k := g.adj_start(u)
stop := g.adj_stop(u)
until k < stop:
v := g.adj_node(k)
dst.set(v, dst.get(v) + src.get(u))
k++
end
end
end
func _spread_in(g &: Graph, src: Vector<f64>, dst &: Vector<f64>):
FillFloat(dst, g.n, 0.0)
repeat g.n in u:
mut k := g.in_start(u)
stop := g.in_stop(u)
until k < stop:
v := g.in_node(k)
dst.set(v, dst.get(v) + src.get(u))
k++
end
end
end
func _pagerank_step(g &: Graph, cur: Vector<f64>, nxt &: Vector<f64>, damping: f64):
n := g.n
mut sink := 0.0
FillFloat(nxt, n, 0.0)
repeat n in u:
d := g.out_degree(u)
if d == 0: sink += cur.get(u)
else:
_pagerank_spread(g, u, cur.get(u) / (d as f64), nxt)
end
end
base := (1.0 - damping) / (n as f64) + damping * sink / (n as f64)
repeat n in u: nxt.set(u, base + damping * nxt.get(u)) end
end
func _pagerank_spread(g &: Graph, u: int, share: f64, nxt &: Vector<f64>):
mut k := g.adj_start(u)
stop := g.adj_stop(u)
until k < stop:
v := g.adj_node(k)
nxt.set(v, nxt.get(v) + share)
k++
end
end
func _closeness_of(dist: Vector<int>, n: int): f64:
mut total := 0.0
mut reached := 0
repeat n in v:
d := dist.get(v)
if d > 0:
total += d as f64
reached++
end
end
if reached == 0: ret 0.0 end
if n < 2: ret 0.0 end
ret ((reached as f64) / total) * ((reached as f64) / ((n - 1) as f64))
end
func _brandes_all(g &: Graph, score &: Vector<f64>, edge_score &: Vector<f64>):
mut dist := Vector {} as Vector<int>
defer dist.free()
mut sigma := Vector {} as Vector<f64>
defer sigma.free()
mut order := Vector {} as Vector<int>
defer order.free()
mut delta := Vector {} as Vector<f64>
defer delta.free()
repeat g.n in s:
_brandes_bfs(g, s, dist, sigma, order)
_brandes_back(g, s, dist, sigma, order, delta, score, edge_score)
end
end
@en "DegreeCentrality"
@fa "مرکزیت درجه"
pub func DegreeCentrality(g &: Graph): Vector<f64>:
mut out := Vector {} as Vector<f64>
if g.n < 2: ret out end
d := (g.n - 1) as f64
repeat g.n in u: out.push((g.degree(u) as f64) / d) end
ret out
end
@en "InDegreeCentrality"
@fa "مرکزیت درجه ورودی"
pub func InDegreeCentrality(g &: Graph): Vector<f64>:
mut out := Vector {} as Vector<f64>
if g.n < 2: ret out end
d := (g.n - 1) as f64
repeat g.n in u: out.push((g.in_degree(u) as f64) / d) end
ret out
end
@en "OutDegreeCentrality"
@fa "مرکزیت درجه خروجی"
pub func OutDegreeCentrality(g &: Graph): Vector<f64>:
mut out := Vector {} as Vector<f64>
if g.n < 2: ret out end
d := (g.n - 1) as f64
repeat g.n in u: out.push((g.out_degree(u) as f64) / d) end
ret out
end
@en "ClosenessCentrality"
@fa "مرکزیت نزدیکی"
pub func ClosenessCentrality(g &: Graph): Vector<f64>:
mut out := Vector {} as Vector<f64>
mut dist := Vector {} as Vector<int>
defer dist.free()
mut parent := Vector {} as Vector<int>
defer parent.free()
repeat g.n in u:
BFSFrom(g, u, dist, parent)
out.push(_closeness_of(dist, g.n))
end
ret out
end
@en "HarmonicCentrality"
@fa "مرکزیت هارمونیک"
pub func HarmonicCentrality(g &: Graph): Vector<f64>:
mut out := Vector {} as Vector<f64>
mut dist := Vector {} as Vector<int>
defer dist.free()
mut parent := Vector {} as Vector<int>
defer parent.free()
repeat g.n in u:
BFSFrom(g, u, dist, parent)
mut s := 0.0
repeat g.n in v:
if v != u:
d := dist.get(v)
if d > 0: s += 1.0 / (d as f64) end
end
end
if g.n > 1: s /= ((g.n - 1) as f64) end
out.push(s)
end
ret out
end
@en "BetweennessCentrality"
@fa "مرکزیت بینابینی"
pub func BetweennessCentrality(g &: Graph): Vector<f64>:
mut score := Vector {} as Vector<f64>
mut edge_score := Vector {} as Vector<f64>
defer edge_score.free()
FillFloat(score, g.n, 0.0)
_brandes_all(g, score, edge_score)
if g.directed == false:
repeat g.n in u: score.set(u, score.get(u) / 2.0) end
end
ret score
end
@en "EdgeBetweenness"
@fa "بینابینی یال"
pub func EdgeBetweenness(g &: Graph): Vector<f64>:
mut score := Vector {} as Vector<f64>
defer score.free()
mut edge_score := Vector {} as Vector<f64>
FillFloat(score, g.n, 0.0)
FillFloat(edge_score, g.size(), 0.0)
_brandes_all(g, score, edge_score)
if g.directed == false:
repeat g.size() in e: edge_score.set(e, edge_score.get(e) / 2.0) end
end
ret edge_score
end
@en "EigenvectorCentrality"
@fa "مرکزیت بردار ویژه"
pub func EigenvectorCentrality(g &: Graph, iters: int, tol: f64): Vector<f64>:
mut cur := Vector {} as Vector<f64>
mut nxt := Vector {} as Vector<f64>
defer nxt.free()
FillFloat(cur, g.n, 1.0)
_normalize(cur)
mut step := 0
until step < iters:
_spread_out(g, cur, nxt)
_normalize(nxt)
d := _delta_of(cur, nxt)
repeat g.n in u: cur.set(u, nxt.get(u)) end
if d < tol: break end
step++
end
ret cur
end
@en "KatzCentrality"
@fa "مرکزیت کاتز"
pub func KatzCentrality(g &: Graph, alpha: f64, beta: f64, iters: int, tol: f64): Vector<f64>:
mut cur := Vector {} as Vector<f64>
mut nxt := Vector {} as Vector<f64>
defer nxt.free()
FillFloat(cur, g.n, beta)
mut step := 0
until step < iters:
_spread_out(g, cur, nxt)
repeat g.n in u: nxt.set(u, beta + alpha * nxt.get(u)) end
d := _delta_of(cur, nxt)
repeat g.n in u: cur.set(u, nxt.get(u)) end
if d < tol: break end
step++
end
ret cur
end
@en "PageRank"
@fa "رتبه‌بندی صفحه"
pub func PageRank(g &: Graph, damping: f64, iters: int, tol: f64): Vector<f64>:
mut cur := Vector {} as Vector<f64>
mut nxt := Vector {} as Vector<f64>
defer nxt.free()
if g.n == 0: ret cur end
FillFloat(cur, g.n, 1.0 / (g.n as f64))
mut step := 0
until step < iters:
_pagerank_step(g, cur, nxt, damping)
d := _delta_of(cur, nxt)
repeat g.n in u: cur.set(u, nxt.get(u)) end
if d < tol: break end
step++
end
ret cur
end
@en "HITS"
@fa "هیتس"
pub func HITS(g &: Graph, iters: int, tol: f64, hubs &: Vector<f64>, auth &: Vector<f64>):
FillFloat(hubs, g.n, 1.0)
FillFloat(auth, g.n, 1.0)
mut tmp := Vector {} as Vector<f64>
defer tmp.free()
mut step := 0
until step < iters:
_spread_out(g, hubs, tmp)
_normalize(tmp)
d := _delta_of(auth, tmp)
repeat g.n in u: auth.set(u, tmp.get(u)) end
_spread_in(g, auth, tmp)
_normalize(tmp)
repeat g.n in u: hubs.set(u, tmp.get(u)) end
if d < tol: break end
step++
end
end
@en "TopNode"
@fa "برترین گره"
pub func TopNode(score: Vector<f64>): int:
mut best := GRAPH_NONE
repeat score.len() in u:
if best == GRAPH_NONE: best = u
else score.get(u) > score.get(best): best = u
end
end
ret best
end
@en "ScaleToSum"
@fa "مقیاس به مجموع"
pub func ScaleToSum(v &: Vector<f64>): _scale_to_sum(v) end
package graph
import math
func _has_loop(g &: Graph): bool:
repeat g.size() in e:
if g.edge_from(e) == g.edge_to(e): ret true end
end
ret false
end
func _contract(g &: Graph, drop: int, u: int, v: int): Graph:
mut map := Vector {} as Vector<int>
defer map.free()
mut next := 0
repeat g.n in x:
if x == v: map.push(GRAPH_NONE)
else:
map.push(next)
next++
end
end
map.set(v, map.get(u))
mut h := New(next, false)
repeat g.size() in e:
if e != drop:
h.add_edge(map.get(g.edge_from(e)), map.get(g.edge_to(e)))
end
end
ret h
end
func _delete_edge(g &: Graph, drop: int): Graph:
mut h := New(g.n, false)
repeat g.size() in e:
if e != drop: h.add_edge(g.edge_from(e), g.edge_to(e)) end
end
ret h
end
func _count_colorings(g &: Graph, k: int): f64:
if _has_loop(g): ret 0.0 end
if g.size() == 0: ret math.Pow(k as f64, g.n as f64) end
e := 0
u := g.edge_from(e)
v := g.edge_to(e)
mut del := _delete_edge(g, e)
mut con := _contract(g, e, u, v)
a := _count_colorings(del, k)
b := _count_colorings(con, k)
defer del.free()
defer con.free()
ret a - b
end
@en "CountColorings"
@fa "شمار رنگ‌آمیزی‌ها"
pub func CountColorings(g &: Graph, k: int): f64:
mut s := Simplify(g)
repeat g.size() in e:
if g.edge_from(e) == g.edge_to(e):
s.free()
ret 0.0
end
end
v := _count_colorings(s, k)
defer s.free()
ret v
end
package graph
import math
func _bk_pivot(adj &: HashMap<i64, bool>, n: int, p: Vector<int>, x: Vector<int>): int:
mut best := GRAPH_NONE
mut bestc := GRAPH_NONE
repeat p.len() in i: _bk_offer(adj, n, p, p.get(i), best, bestc) end
repeat x.len() in i: _bk_offer(adj, n, p, x.get(i), best, bestc) end
ret best
end
func _bk_offer(adj &: HashMap<i64, bool>, n: int, p: Vector<int>, u: int, best &: int, bestc &: int):
mut c := 0
repeat p.len() in i:
if adj.has(_color_key(n, u, p.get(i))): c++ end
end
if c > bestc:
bestc = c
best = u
end
end
func _bk_filter(adj &: HashMap<i64, bool>, n: int, src: Vector<int>, v: int, out &: Vector<int>):
out.clear()
repeat src.len() in i:
u := src.get(i)
if adj.has(_color_key(n, v, u)): out.push(u) end
end
end
func _bk_run(adj &: HashMap<i64, bool>, n: int, r &: Vector<int>, p: Vector<int>, x: Vector<int>, best &: Vector<int>):
if p.len() == 0:
if x.len() == 0: _bk_record(r, best) end
ret
end
pivot := _bk_pivot(adj, n, p, x)
mut cand := Vector {} as Vector<int>
defer cand.free()
repeat p.len() in i:
v := p.get(i)
if adj.has(_color_key(n, pivot, v)) == false: cand.push(v) end
end
mut px := Vector {} as Vector<int>
defer px.free()
mut xx := Vector {} as Vector<int>
defer xx.free()
_bk_branch(adj, n, r, p, x, best, cand, px, xx)
end
func _bk_branch(adj &: HashMap<i64, bool>, n: int, r &: Vector<int>, p: Vector<int>, x: Vector<int>, best &: Vector<int>, cand: Vector<int>, px &: Vector<int>, xx &: Vector<int>):
mut live := Vector {} as Vector<int>
defer live.free()
mut done := Vector {} as Vector<int>
defer done.free()
repeat p.len() in i: live.push(p.get(i)) end
repeat x.len() in i: done.push(x.get(i)) end
repeat cand.len() in i:
v := cand.get(i)
_bk_filter(adj, n, live, v, px)
_bk_filter(adj, n, done, v, xx)
r.push(v)
_bk_run(adj, n, r, px, xx, best)
r.pop()
_bk_drop(live, v)
done.push(v)
end
end
func _bk_drop(v &: Vector<int>, x: int):
mut keep := Vector {} as Vector<int>
repeat v.len() in i:
if v.get(i) != x: keep.push(v.get(i)) end
end
v.clear()
repeat keep.len() in i: v.push(keep.get(i)) end
defer keep.free()
end
func _bk_record(r: Vector<int>, best &: Vector<int>):
if r.len() <= best.len(): ret end
best.clear()
repeat r.len() in i: best.push(r.get(i)) end
end
@en "MaxClique"
@fa "بیشینه خوشه"
pub func MaxClique(g &: Graph): Vector<int>:
mut adj := _color_adj(g)
defer adj.free()
mut r := Vector {} as Vector<int>
defer r.free()
mut p := Vector {} as Vector<int>
defer p.free()
mut x := Vector {} as Vector<int>
defer x.free()
mut best := Vector {} as Vector<int>
Iota(p, g.n)
_bk_run(adj, g.n, r, p, x, best)
ret best
end
@en "CliqueNumber"
@fa "عدد خوشه"
pub func CliqueNumber(g &: Graph): int:
mut c := MaxClique(g)
defer c.free()
ret c.len()
end
@en "MaximumIndependentSet"
@fa "بیشینه مجموعه مستقل"
pub func MaximumIndependentSet(g &: Graph): Vector<int>:
mut c := Complement(g)
best := MaxClique(c)
defer c.free()
ret best
end
@en "IndependenceNumber"
@fa "عدد استقلال"
pub func IndependenceNumber(g &: Graph): int:
mut s := MaximumIndependentSet(g)
defer s.free()
ret s.len()
end
@en "VertexCoverNumber"
@fa "عدد پوشش رأسی"
pub func VertexCoverNumber(g &: Graph): int:
ret g.n - IndependenceNumber(g)
end
@en "GreedyVertexCover"
@fa "پوشش رأسی حریصانه"
pub func GreedyVertexCover(g &: Graph, cover &: Vector<bool>): int:
FillBool(cover, g.n, false)
mut count := 0
repeat g.size() in e:
u := g.edge_from(e)
v := g.edge_to(e)
if u != v:
if cover.get(u) == false:
if cover.get(v) == false:
cover.set(u, true)
cover.set(v, true)
count += 2
end
end
end
end
ret count
end
package graph
import math
@en "LocalClustering"
@fa "خوشگی محلی"
pub func LocalClustering(g &: Graph, u: int): f64:
mut adj := _adjacency_set(g)
defer adj.free()
mut nb := Vector {} as Vector<int>
defer nb.free()
_distinct_neighbors(g, u, nb)
k := nb.len()
if k < 2: ret 0.0 end
links := _links_among(adj, nb, g.n)
ret 2.0 * (links as f64) / ((k as f64) * ((k as f64) - 1.0))
end
@en "AverageClustering"
@fa "میانگین خوشگی"
pub func AverageClustering(g &: Graph): f64:
if g.n == 0: ret 0.0 end
mut adj := _adjacency_set(g)
defer adj.free()
mut nb := Vector {} as Vector<int>
defer nb.free()
mut total := 0.0
repeat g.n in u:
_distinct_neighbors(g, u, nb)
k := nb.len()
if k > 1:
links := _links_among(adj, nb, g.n)
total += 2.0 * (links as f64) / ((k as f64) * ((k as f64) - 1.0))
end
end
ret total / (g.n as f64)
end
@en "Transitivity"
@fa "تعدی"
pub func Transitivity(g &: Graph): f64:
mut adj := _adjacency_set(g)
defer adj.free()
mut nb := Vector {} as Vector<int>
defer nb.free()
mut closed := 0
mut triples := 0
repeat g.n in u:
_distinct_neighbors(g, u, nb)
k := nb.len()
triples += k * (k - 1) / 2
closed += _links_among(adj, nb, g.n)
end
if triples == 0: ret 0.0 end
ret (closed as f64) / (triples as f64)
end
@en "TriangleCount"
@fa "شمار مثلث"
pub func TriangleCount(g &: Graph): int:
mut adj := _adjacency_set(g)
defer adj.free()
mut nb := Vector {} as Vector<int>
defer nb.free()
mut total := 0
repeat g.n in u:
_distinct_neighbors(g, u, nb)
total += _links_among(adj, nb, g.n)
end
ret total / 3
end
@en "Assortativity"
@fa "همگون‌گرایی"
pub func Assortativity(g &: Graph): f64:
m := g.size()
if m == 0: ret 0.0 end
mut s1 := 0.0
mut s2 := 0.0
mut s3 := 0.0
repeat m in e:
a := (g.degree(g.edge_from(e)) as f64) - 1.0
b := (g.degree(g.edge_to(e)) as f64) - 1.0
s1 += a * b
s2 += a + b
s3 += a * a + b * b
end
mf := m as f64
num := s1 / mf - (s2 / (2.0 * mf)) * (s2 / (2.0 * mf))
den := s3 / (2.0 * mf) - (s2 / (2.0 * mf)) * (s2 / (2.0 * mf))
if math.Abs(den) < 0.000000000001: ret 0.0 end
ret num / den
end
@en "CircuitRank"
@fa "رتبه مدار"
pub func CircuitRank(g &: Graph): int:
ret g.size() - g.n + ComponentCount(g)
end
@en "WeightedDiameter"
@fa "قطر وزنی"
pub func WeightedDiameter(g &: Graph): f64:
mut best := 0.0
mut dist := Vector {} as Vector<f64>
defer dist.free()
mut parent := Vector {} as Vector<int>
defer parent.free()
repeat g.n in s:
Dijkstra(g, s, dist, parent)
repeat g.n in t:
d := dist.get(t)
if d < GRAPH_INF:
if d > best: best = d end
end
end
end
ret best
end
package graph
func _color_key(n: int, u: int, v: int): i64: ret (u as i64) * (n as i64) + (v as i64) end
func _color_adj(g &: Graph): HashMap<i64, bool>:
mut s := HashMap {} as HashMap<i64, bool>
repeat g.size() in e:
u := g.edge_from(e)
v := g.edge_to(e)
if u != v:
s.put(_color_key(g.n, u, v), true)
s.put(_color_key(g.n, v, u), true)
end
end
ret s
end
func _lowest_free(g &: Graph, u: int, color: Vector<int>, used &: Vector<bool>): int:
FillBool(used, g.n + 1, false)
mut k := g.adj_start(u)
stop := g.adj_stop(u)
until k < stop:
v := g.adj_node(k)
c := color.get(v)
if c != GRAPH_NONE: used.set(c, true) end
k++
end
mut c := 0
until used.get(c): c++ end
ret c
end
func _saturation(g &: Graph, u: int, color: Vector<int>, seen &: Vector<bool>): int:
FillBool(seen, g.n + 1, false)
mut count := 0
mut k := g.adj_start(u)
stop := g.adj_stop(u)
until k < stop:
c := color.get(g.adj_node(k))
if c != GRAPH_NONE:
if seen.get(c) == false:
seen.set(c, true)
count++
end
end
k++
end
ret count
end
func _dsatur_pick(g &: Graph, color: Vector<int>, seen &: Vector<bool>): int:
mut best := GRAPH_NONE
mut bestsat := GRAPH_NONE
repeat g.n in u:
if color.get(u) == GRAPH_NONE:
sat := _saturation(g, u, color, seen)
if _dsatur_better(g, u, best, sat, bestsat):
best = u
bestsat = sat
end
end
end
ret best
end
func _dsatur_better(g &: Graph, u: int, best: int, sat: int, bestsat: int): bool:
if best == GRAPH_NONE: ret true end
if sat > bestsat: ret true end
if sat < bestsat: ret false end
ret g.degree(u) > g.degree(best)
end
func _can_use(g &: Graph, u: int, c: int, color: Vector<int>): bool:
mut k := g.adj_start(u)
stop := g.adj_stop(u)
until k < stop:
v := g.adj_node(k)
if v != u:
if color.get(v) == c: ret false end
end
k++
end
ret true
end
func _color_search(g &: Graph, k: int, u: int, color &: Vector<int>, high: int): bool:
if u >= g.n: ret true end
mut top := high + 1
if top > k - 1: top = k - 1 end
mut c := 0
until c <= top:
if _can_use(g, u, c, color):
color.set(u, c)
mut nh := high
if c > nh: nh = c end
if _color_search(g, k, u + 1, color, nh): ret true end
color.set(u, GRAPH_NONE)
end
c++
end
ret false
end
func _mark_incident(g &: Graph, u: int, ecolor: Vector<int>, used &: Vector<bool>):
mut k := g.adj_start(u)
stop := g.adj_stop(u)
until k < stop:
c := ecolor.get(g.adj_edge(k))
if c != GRAPH_NONE: used.set(c, true) end
k++
end
end
@en "GreedyColoring"
@fa "رنگ‌آمیزی حریصانه"
pub func GreedyColoring(g &: Graph, order: Vector<int>): Vector<int>:
mut color := Vector {} as Vector<int>
mut used := Vector {} as Vector<bool>
defer used.free()
FillInt(color, g.n, GRAPH_NONE)
repeat order.len() in i:
u := order.get(i)
color.set(u, _lowest_free(g, u, color, used))
end
ret color
end
@en "GreedyColoringNatural"
@fa "رنگ‌آمیزی حریصانه طبیعی"
pub func GreedyColoringNatural(g &: Graph): Vector<int>:
mut order := Vector {} as Vector<int>
defer order.free()
Iota(order, g.n)
ret GreedyColoring(g, order)
end
@en "WelshPowell"
@fa "ولش پاول"
pub func WelshPowell(g &: Graph): Vector<int>:
mut h := MinHeap {}
defer h.free()
repeat g.n in u: h.push(0.0 - (g.degree(u) as f64), u) end
mut order := Vector {} as Vector<int>
defer order.free()
until h.is_empty() == false: order.push(h.pop()) end
ret GreedyColoring(g, order)
end
@en "DSatur"
@fa "دی‌سچور"
pub func DSatur(g &: Graph): Vector<int>:
mut color := Vector {} as Vector<int>
mut used := Vector {} as Vector<bool>
defer used.free()
mut seen := Vector {} as Vector<bool>
defer seen.free()
FillInt(color, g.n, GRAPH_NONE)
repeat g.n:
u := _dsatur_pick(g, color, seen)
if u == GRAPH_NONE: break end
color.set(u, _lowest_free(g, u, color, used))
end
ret color
end
@en "ColorCount"
@fa "شمار رنگ"
pub func ColorCount(color: Vector<int>): int:
mut best := GRAPH_NONE
repeat color.len() in u:
if color.get(u) > best: best = color.get(u) end
end
ret best + 1
end
@en "IsProperColoring"
@fa "رنگ‌آمیزی معتبر است"
pub func IsProperColoring(g &: Graph, color: Vector<int>): bool:
repeat g.size() in e:
u := g.edge_from(e)
v := g.edge_to(e)
if u != v:
if color.get(u) == color.get(v): ret false end
end
end
ret true
end
@en "ChromaticNumber"
@fa "عدد رنگی"
pub func ChromaticNumber(g &: Graph): int:
if g.n == 0: ret 0 end
repeat g.size() in e:
if g.edge_from(e) == g.edge_to(e): ret GRAPH_NONE end
end
mut color := Vector {} as Vector<int>
defer color.free()
mut upper := DSatur(g)
limit := ColorCount(upper)
defer upper.free()
mut k := 1
until k <= limit:
FillInt(color, g.n, GRAPH_NONE)
if _color_search(g, k, 0, color, GRAPH_NONE): ret k end
k++
end
ret limit
end
@en "EdgeColoringGreedy"
@fa "رنگ‌آمیزی یالی حریصانه"
pub func EdgeColoringGreedy(g &: Graph): Vector<int>:
mut ecolor := Vector {} as Vector<int>
mut used := Vector {} as Vector<bool>
defer used.free()
FillInt(ecolor, g.size(), GRAPH_NONE)
repeat g.size() in e:
FillBool(used, 2 * g.n + 2, false)
_mark_incident(g, g.edge_from(e), ecolor, used)
_mark_incident(g, g.edge_to(e), ecolor, used)
mut c := 0
until used.get(c): c++ end
ecolor.set(e, c)
end
ret ecolor
end
package graph
func _degrees_now(g &: Graph, alive: Vector<bool>, deg &: Vector<int>):
FillInt(deg, g.n, 0)
repeat g.size() in e:
u := g.edge_from(e)
v := g.edge_to(e)
if u != v:
if alive.get(u):
if alive.get(v):
deg.set(u, deg.get(u) + 1)
deg.set(v, deg.get(v) + 1)
end
end
end
end
end
func _densify(labels &: Vector<int>): int:
mut map := HashMap {} as HashMap<i64, int>
defer map.free()
mut next := 0
repeat labels.len() in u:
k := labels.get(u) as i64
if map.has(k) == false:
map.put(k, next)
next++
end
labels.set(u, map.get(k))
end
ret next
end
func _weighted_degrees(g &: Graph, deg &: Vector<f64>): f64:
FillFloat(deg, g.n, 0.0)
mut total := 0.0
repeat g.size() in e:
u := g.edge_from(e)
v := g.edge_to(e)
w := g.edge_weight(e)
deg.set(u, deg.get(u) + w)
deg.set(v, deg.get(v) + w)
total += w
end
ret total
end
func _best_move(g &: Graph, u: int, comm &: Vector<int>, ktot &: Vector<f64>, deg: Vector<f64>, m2: f64): int:
mut links := HashMap {} as HashMap<i64, f64>
defer links.free()
_neighbor_weights(g, u, comm, links)
mut best := comm.get(u)
mut bestgain := 0.0
repeat g.n in c:
if links.has(c as i64):
gain := links.get(c as i64) - ktot.get(c) * deg.get(u) / m2
if gain > bestgain:
bestgain = gain
best = c
end
end
end
ret best
end
func _neighbor_weights(g &: Graph, u: int, comm &: Vector<int>, links &: HashMap<i64, f64>):
mut k := g.adj_start(u)
stop := g.adj_stop(u)
until k < stop:
v := g.adj_node(k)
if v != u:
c := comm.get(v) as i64
mut cur := 0.0
if links.has(c): cur = links.get(c) end
links.put(c, cur + g.adj_weight(k))
end
k++
end
end
func _louvain_phase(g &: Graph, comm &: Vector<int>): bool:
mut deg := Vector {} as Vector<f64>
defer deg.free()
mut ktot := Vector {} as Vector<f64>
defer ktot.free()
total := _weighted_degrees(g, deg)
m2 := 2.0 * total
if m2 <= 0.0: ret false end
FillFloat(ktot, g.n, 0.0)
repeat g.n in u: ktot.set(comm.get(u), ktot.get(comm.get(u)) + deg.get(u)) end
mut moved := false
mut round := 0
until round < 20:
if _louvain_sweep(g, comm, ktot, deg, m2) == false: break end
moved = true
round++
end
ret moved
end
func _louvain_sweep(g &: Graph, comm &: Vector<int>, ktot &: Vector<f64>, deg: Vector<f64>, m2: f64): bool:
mut changed := false
repeat g.n in u:
old := comm.get(u)
ktot.set(old, ktot.get(old) - deg.get(u))
best := _best_move(g, u, comm, ktot, deg, m2)
comm.set(u, best)
ktot.set(best, ktot.get(best) + deg.get(u))
if best != old: changed = true end
end
ret changed
end
func _aggregate(g &: Graph, comm: Vector<int>, k: int): Graph:
mut h := New(k, false)
mut acc := HashMap {} as HashMap<i64, f64>
defer acc.free()
mut order := Vector {} as Vector<i64>
defer order.free()
repeat g.size() in e:
a := comm.get(g.edge_from(e))
b := comm.get(g.edge_to(e))
mut lo := a
mut hi := b
if lo > hi:
lo = b
hi = a
end
key := (lo as i64) * (k as i64) + (hi as i64)
if acc.has(key) == false: order.push(key) end
mut cur := 0.0
if acc.has(key): cur = acc.get(key) end
acc.put(key, cur + g.edge_weight(e))
end
_emit_aggregate(h, acc, order, k)
ret h
end
func _emit_aggregate(h &: Graph, acc &: HashMap<i64, f64>, order: Vector<i64>, k: int):
repeat order.len() in i:
key := order.get(i)
a := (key / (k as i64)) as int
b := (key % (k as i64)) as int
h.add_weighted(a, b, acc.get(key))
end
end
func _label_round(g &: Graph, comm &: Vector<int>): bool:
mut changed := false
repeat g.n in u:
best := _majority_label(g, u, comm)
if best != GRAPH_NONE:
if best != comm.get(u):
comm.set(u, best)
changed = true
end
end
end
ret changed
end
func _majority_label(g &: Graph, u: int, comm &: Vector<int>): int:
mut tally := HashMap {} as HashMap<i64, f64>
defer tally.free()
_neighbor_weights(g, u, comm, tally)
mut best := GRAPH_NONE
mut bestw := 0.0
repeat g.n in c:
if tally.has(c as i64):
w := tally.get(c as i64)
if w > bestw:
bestw = w
best = c
end
end
end
ret best
end
func _peel_below(g &: Graph, alive &: Vector<bool>, deg: Vector<int>, core &: Vector<int>, k: int): int:
mut removed := 0
repeat g.n in u:
if alive.get(u):
if deg.get(u) <= k:
core.set(u, k)
alive.set(u, false)
removed++
end
end
end
ret removed
end
func _remap(comm &: Vector<int>, mapping &: Vector<int>, local: Vector<int>):
repeat comm.len() in u:
cur := mapping.get(u)
comm.set(u, local.get(cur))
end
repeat mapping.len() in u: mapping.set(u, comm.get(u)) end
end
func _weakest_link(g &: Graph): int:
if g.size() == 0: ret GRAPH_NONE end
mut eb := EdgeBetweenness(g)
defer eb.free()
mut best := 0
repeat eb.len() in e:
if eb.get(e) > eb.get(best): best = e end
end
ret best
end
func _drop_kth_kept(keep &: Vector<bool>, w: int):
mut c := 0
repeat keep.len() in e:
if keep.get(e):
if c == w:
keep.set(e, false)
ret
end
c++
end
end
end
@en "KCore"
@fa "هسته کا"
pub func KCore(g &: Graph, k: int, alive &: Vector<bool>): int:
FillBool(alive, g.n, true)
mut deg := Vector {} as Vector<int>
defer deg.free()
mut left := g.n
mut peeled := true
until peeled:
peeled = false
_degrees_now(g, alive, deg)
repeat g.n in u:
if alive.get(u):
if deg.get(u) < k:
alive.set(u, false)
left--
peeled = true
end
end
end
end
ret left
end
@en "CoreNumbers"
@fa "شماره‌های هسته"
pub func CoreNumbers(g &: Graph): Vector<int>:
mut core := Vector {} as Vector<int>
mut alive := Vector {} as Vector<bool>
defer alive.free()
mut deg := Vector {} as Vector<int>
defer deg.free()
FillInt(core, g.n, 0)
FillBool(alive, g.n, true)
mut k := 0
mut left := g.n
until left > 0:
_degrees_now(g, alive, deg)
removed := _peel_below(g, alive, deg, core, k)
if removed == 0:
k++
else:
left -= removed
end
end
ret core
end
@en "Degeneracy"
@fa "تباهیدگی"
pub func Degeneracy(g &: Graph): int:
mut core := CoreNumbers(g)
defer core.free()
ret MaxInt(core)
end
@en "Modularity"
@fa "پیمانگی"
pub func Modularity(g &: Graph, comm: Vector<int>): f64:
mut deg := Vector {} as Vector<f64>
defer deg.free()
total := _weighted_degrees(g, deg)
if total <= 0.0: ret 0.0 end
mut inside := 0.0
repeat g.size() in e:
if comm.get(g.edge_from(e)) == comm.get(g.edge_to(e)): inside += g.edge_weight(e) end
end
mut expected := 0.0
k := MaxInt(comm) + 1
mut ktot := Vector {} as Vector<f64>
defer ktot.free()
FillFloat(ktot, k, 0.0)
repeat g.n in u: ktot.set(comm.get(u), ktot.get(comm.get(u)) + deg.get(u)) end
repeat k in c: expected += (ktot.get(c) / (2.0 * total)) * (ktot.get(c) / (2.0 * total)) end
ret inside / total - expected
end
@en "LabelPropagation"
@fa "انتشار برچسب"
pub func LabelPropagation(g &: Graph, comm &: Vector<int>): int:
Iota(comm, g.n)
mut round := 0
until round < 100:
if _label_round(g, comm) == false: break end
round++
end
ret _densify(comm)
end
@en "Louvain"
@fa "لوون"
pub func Louvain(g &: Graph, comm &: Vector<int>): int:
Iota(comm, g.n)
if g.size() == 0: ret g.n end
mut level := Clone(g)
mut mapping := Vector {} as Vector<int>
defer mapping.free()
Iota(mapping, g.n)
mut depth := 0
until depth < 10:
mut local := Vector {} as Vector<int>
Iota(local, level.n)
improved := _louvain_phase(level, local)
k := _densify(local)
if improved == false:
local.free()
break
end
_remap(comm, mapping, local)
next := _aggregate(level, local, k)
level.free()
level = next
local.free()
depth++
end
defer level.free()
ret _densify(comm)
end
@en "GirvanNewman"
@fa "گیروان نیومن"
pub func GirvanNewman(g &: Graph, want: int, comm &: Vector<int>): int:
mut work := Clone(g)
mut keep := Vector {} as Vector<bool>
defer keep.free()
FillBool(keep, g.size(), true)
mut count := Components(work, comm)
mut guard := 0
until count < want:
if guard >= g.size(): break end
e := _weakest_link(work)
if e == GRAPH_NONE: break end
_drop_kth_kept(keep, e)
next := EdgeSubgraph(g, keep)
work.free()
work = next
count = Components(work, comm)
guard++
end
defer work.free()
ret count
end
package graph
@en "Components"
@fa "مؤلفه‌ها"
pub func Components(g &: Graph, comp &: Vector<int>): int:
FillInt(comp, g.n, GRAPH_NONE)
mut id := 0
repeat g.n in u:
if comp.get(u) == GRAPH_NONE:
_comp_bfs(g, u, id, comp)
id++
end
end
ret id
end
@en "ComponentCount"
@fa "شمار مؤلفه"
pub func ComponentCount(g &: Graph): int:
mut comp := Vector {} as Vector<int>
defer comp.free()
ret Components(g, comp)
end
@en "ComponentSizes"
@fa "اندازه مؤلفه‌ها"
pub func ComponentSizes(g &: Graph): Vector<int>:
mut comp := Vector {} as Vector<int>
defer comp.free()
c := Components(g, comp)
mut out := Vector {} as Vector<int>
FillInt(out, c, 0)
repeat g.n in u:
i := comp.get(u)
out.set(i, out.get(i) + 1)
end
ret out
end
@en "IsConnected"
@fa "همبند است"
pub func IsConnected(g &: Graph): bool:
if g.n == 0: ret true end
ret ComponentCount(g) == 1
end
@en "IsBipartite"
@fa "دوبخشی است"
pub func IsBipartite(g &: Graph, color &: Vector<int>): bool:
FillInt(color, g.n, GRAPH_NONE)
if g.directed == false: ret _bipartite_all(g, color, g.n) end
mut u := ToUndirected(g)
ok := _bipartite_all(u, color, g.n)
defer u.free()
ret ok
end
@en "Bipartite"
@fa "دوبخشی"
pub func Bipartite(g &: Graph): bool:
mut color := Vector {} as Vector<int>
defer color.free()
ret IsBipartite(g, color)
end
@en "TopologicalSort"
@fa "مرتب‌سازی توپولوژیک"
pub func TopologicalSort(g &: Graph, order &: Vector<int>): bool:
order.clear()
mut deg := Vector {} as Vector<int>
defer deg.free()
_indegrees(g, deg)
mut q := Vector {} as Vector<int>
defer q.free()
repeat g.n in u:
if deg.get(u) == 0: q.push(u) end
end
mut head := 0
until head < q.len():
u := q.get(head)
head++
order.push(u)
_relax_indegree(g, u, deg, q)
end
ret order.len() == g.n
end
@en "TopologicalSortLex"
@fa "مرتب‌سازی توپولوژیک الفبایی"
pub func TopologicalSortLex(g &: Graph, order &: Vector<int>): bool:
order.clear()
mut deg := Vector {} as Vector<int>
defer deg.free()
_indegrees(g, deg)
mut h := MinHeap {}
defer h.free()
repeat g.n in u:
if deg.get(u) == 0: h.push(u as f64, u) end
end
until h.is_empty() == false:
u := h.pop()
order.push(u)
_relax_indegree_heap(g, u, deg, h)
end
ret order.len() == g.n
end
@en "IsDAG"
@fa "گراف جهت‌دار بی‌دور است"
pub func IsDAG(g &: Graph): bool:
if g.directed == false: ret false end
mut order := Vector {} as Vector<int>
defer order.free()
ret TopologicalSort(g, order)
end
@en "FindCycle"
@fa "یافتن دور"
pub func FindCycle(g &: Graph): Vector<int>:
mut out := Vector {} as Vector<int>
mut state := Vector {} as Vector<int>
defer state.free()
FillInt(state, g.n, 0)
repeat g.n in u:
if state.get(u) == 0:
if _find_cycle_from(g, u, state, out): ret out end
end
end
ret out
end
@en "HasCycle"
@fa "دارای دور"
pub func HasCycle(g &: Graph): bool:
mut c := FindCycle(g)
defer c.free()
ret c.len() > 0
end
package graph
func _tarjan_walk(g &: Graph, root: int, disc &: Vector<int>, low &: Vector<int>, comp &: Vector<int>, onstk &: Vector<bool>, timer &: int, ncomp &: int):
mut stk := Vector {} as Vector<int>
defer stk.free()
mut call := Vector {} as Vector<int>
defer call.free()
mut it := Vector {} as Vector<int>
defer it.free()
_tarjan_open(g, root, disc, low, onstk, stk, call, it, timer)
until call.len() > 0:
u := call.last()
k := it.last()
if k < g.adj_stop(u):
it.set(it.len() - 1, k + 1)
_tarjan_edge(g, u, g.adj_node(k), disc, low, onstk, stk, call, it, timer)
else:
_tarjan_close(u, disc, low, comp, onstk, stk, call, it, ncomp)
end
end
end
func _tarjan_open(g &: Graph, v: int, disc &: Vector<int>, low &: Vector<int>, onstk &: Vector<bool>, stk &: Vector<int>, call &: Vector<int>, it &: Vector<int>, timer &: int):
disc.set(v, timer)
low.set(v, timer)
timer++
stk.push(v)
onstk.set(v, true)
call.push(v)
it.push(g.adj_start(v))
end
func _tarjan_edge(g &: Graph, u: int, v: int, disc &: Vector<int>, low &: Vector<int>, onstk &: Vector<bool>, stk &: Vector<int>, call &: Vector<int>, it &: Vector<int>, timer &: int):
if disc.get(v) == GRAPH_NONE:
_tarjan_open(g, v, disc, low, onstk, stk, call, it, timer)
ret
end
if onstk.get(v):
if disc.get(v) < low.get(u): low.set(u, disc.get(v)) end
end
end
func _tarjan_close(u: int, disc &: Vector<int>, low &: Vector<int>, comp &: Vector<int>, onstk &: Vector<bool>, stk &: Vector<int>, call &: Vector<int>, it &: Vector<int>, ncomp &: int):
if low.get(u) == disc.get(u):
until true:
w := stk.pop()
onstk.set(w, false)
comp.set(w, ncomp)
if w == u: break end
end
ncomp++
end
call.pop()
it.pop()
if call.len() > 0:
p := call.last()
if low.get(u) < low.get(p): low.set(p, low.get(u)) end
end
end
func _bcc_open(g &: Graph, v: int, e: int, disc &: Vector<int>, low &: Vector<int>, call &: Vector<int>, it &: Vector<int>, via &: Vector<int>, kids &: Vector<int>, timer &: int):
disc.set(v, timer)
low.set(v, timer)
timer++
call.push(v)
it.push(g.adj_start(v))
via.push(e)
kids.push(0)
end
func _bcc_close(u: int, p: int, root: int, disc &: Vector<int>, low &: Vector<int>, isart &: Vector<bool>, bridge &: Vector<bool>, ecomp &: Vector<int>, estack &: Vector<int>, kids: Vector<int>, e: int, ncomp &: int):
if low.get(u) < low.get(p): low.set(p, low.get(u)) end
if low.get(u) > disc.get(p): bridge.set(e, true) end
if low.get(u) >= disc.get(p):
if p != root: isart.set(p, true)
else kids.get(kids.len() - 1) > 1: isart.set(p, true)
end
until true:
f := estack.pop()
ecomp.set(f, ncomp)
if f == e: break end
end
ncomp++
end
end
func _bcc_walk(g &: Graph, root: int, disc &: Vector<int>, low &: Vector<int>, isart &: Vector<bool>, bridge &: Vector<bool>, ecomp &: Vector<int>, timer &: int, ncomp &: int):
mut call := Vector {} as Vector<int>
defer call.free()
mut it := Vector {} as Vector<int>
defer it.free()
mut via := Vector {} as Vector<int>
defer via.free()
mut kids := Vector {} as Vector<int>
defer kids.free()
mut estack := Vector {} as Vector<int>
defer estack.free()
_bcc_open(g, root, GRAPH_NONE, disc, low, call, it, via, kids, timer)
until call.len() > 0:
u := call.last()
k := it.last()
if k < g.adj_stop(u):
it.set(it.len() - 1, k + 1)
_bcc_step(g, u, k, disc, low, call, it, via, kids, estack, timer)
else:
_bcc_pop(u, root, disc, low, isart, bridge, ecomp, estack, call, it, via, kids, ncomp)
end
end
end
func _bcc_step(g &: Graph, u: int, k: int, disc &: Vector<int>, low &: Vector<int>, call &: Vector<int>, it &: Vector<int>, via &: Vector<int>, kids &: Vector<int>, estack &: Vector<int>, timer &: int):
e := g.adj_edge(k)
v := g.adj_node(k)
if e == via.last(): ret end
if disc.get(v) == GRAPH_NONE:
estack.push(e)
kids.set(kids.len() - 1, kids.last() + 1)
_bcc_open(g, v, e, disc, low, call, it, via, kids, timer)
ret
end
if disc.get(v) < disc.get(u):
estack.push(e)
if disc.get(v) < low.get(u): low.set(u, disc.get(v)) end
end
end
func _bcc_pop(u: int, root: int, disc &: Vector<int>, low &: Vector<int>, isart &: Vector<bool>, bridge &: Vector<bool>, ecomp &: Vector<int>, estack &: Vector<int>, call &: Vector<int>, it &: Vector<int>, via &: Vector<int>, kids &: Vector<int>, ncomp &: int):
e := via.last()
call.pop()
it.pop()
via.pop()
kids.pop()
if call.len() > 0:
p := call.last()
_bcc_close(u, p, root, disc, low, isart, bridge, ecomp, estack, kids, e, ncomp)
end
end
func _dedupe_arc(seen &: HashMap<i64, bool>, h &: Graph, a: int, b: int, n: int):
k := (a as i64) * (n as i64) + (b as i64)
if seen.has(k): ret end
seen.put(k, true)
h.add_edge(a, b)
end
func _kosaraju_pass(t &: Graph, order: Vector<int>, comp &: Vector<int>): int:
mut ncomp := 0
mut i := order.len() - 1
until i >= 0:
u := order.get(i)
if comp.get(u) == GRAPH_NONE:
_label_reachable(t, u, ncomp, comp)
ncomp++
end
i--
end
ret ncomp
end
func _label_reachable(t &: Graph, s: int, id: int, comp &: Vector<int>):
mut q := Vector {} as Vector<int>
defer q.free()
comp.set(s, id)
q.push(s)
mut head := 0
until head < q.len():
u := q.get(head)
head++
mut k := t.adj_start(u)
stop := t.adj_stop(u)
until k < stop:
v := t.adj_node(k)
if comp.get(v) == GRAPH_NONE:
comp.set(v, id)
q.push(v)
end
k++
end
end
end
func _bcc_all(g &: Graph, isart &: Vector<bool>, bridge &: Vector<bool>, ecomp &: Vector<int>): int:
if g.directed == false: ret _bcc_run(g, isart, bridge, ecomp) end
mut u := ToUndirected(g)
c := _bcc_run(u, isart, bridge, ecomp)
defer u.free()
ret c
end
func _bcc_run(g &: Graph, isart &: Vector<bool>, bridge &: Vector<bool>, ecomp &: Vector<int>): int:
mut disc := Vector {} as Vector<int>
defer disc.free()
mut low := Vector {} as Vector<int>
defer low.free()
FillInt(disc, g.n, GRAPH_NONE)
FillInt(low, g.n, 0)
FillBool(isart, g.n, false)
FillBool(bridge, g.size(), false)
FillInt(ecomp, g.size(), GRAPH_NONE)
mut timer := 0
mut ncomp := 0
repeat g.n in u:
if disc.get(u) == GRAPH_NONE:
_bcc_walk(g, u, disc, low, isart, bridge, ecomp, timer, ncomp)
end
end
ret ncomp
end
@en "StronglyConnected"
@fa "مؤلفه‌های همبند قوی"
pub func StronglyConnected(g &: Graph, comp &: Vector<int>): int:
mut disc := Vector {} as Vector<int>
defer disc.free()
mut low := Vector {} as Vector<int>
defer low.free()
mut onstk := Vector {} as Vector<bool>
defer onstk.free()
FillInt(disc, g.n, GRAPH_NONE)
FillInt(low, g.n, 0)
FillBool(onstk, g.n, false)
FillInt(comp, g.n, GRAPH_NONE)
mut timer := 0
mut ncomp := 0
repeat g.n in u:
if disc.get(u) == GRAPH_NONE:
_tarjan_walk(g, u, disc, low, comp, onstk, timer, ncomp)
end
end
ret ncomp
end
@en "SCCCount"
@fa "شمار مؤلفه قوی"
pub func SCCCount(g &: Graph): int:
mut comp := Vector {} as Vector<int>
defer comp.free()
ret StronglyConnected(g, comp)
end
@en "IsStronglyConnected"
@fa "همبند قوی است"
pub func IsStronglyConnected(g &: Graph): bool:
if g.n == 0: ret true end
ret SCCCount(g) == 1
end
@en "Kosaraju"
@fa "کوساراجو"
pub func Kosaraju(g &: Graph, comp &: Vector<int>): int:
mut order := Vector {} as Vector<int>
defer order.free()
mut seen := Vector {} as Vector<bool>
defer seen.free()
mut pre := Vector {} as Vector<int>
defer pre.free()
FillBool(seen, g.n, false)
repeat g.n in u: _dfs_walk(g, u, pre, order, seen) end
mut t := Transpose(g)
FillInt(comp, g.n, GRAPH_NONE)
ncomp := _kosaraju_pass(t, order, comp)
defer t.free()
ret ncomp
end
@en "Condensation"
@fa "چگالش"
pub func Condensation(g &: Graph, comp &: Vector<int>): Graph:
ncomp := StronglyConnected(g, comp)
mut h := New(ncomp, true)
mut seen := HashMap {} as HashMap<i64, bool>
defer seen.free()
repeat g.size() in e:
a := comp.get(g.edge_from(e))
b := comp.get(g.edge_to(e))
if a != b: _dedupe_arc(seen, h, a, b, ncomp) end
end
ret h
end
@en "Bridges"
@fa "پل‌ها"
pub func Bridges(g &: Graph): Vector<int>:
mut isart := Vector {} as Vector<bool>
defer isart.free()
mut bridge := Vector {} as Vector<bool>
defer bridge.free()
mut ecomp := Vector {} as Vector<int>
defer ecomp.free()
_bcc_all(g, isart, bridge, ecomp)
mut out := Vector {} as Vector<int>
repeat g.size() in e:
if bridge.get(e): out.push(e) end
end
ret out
end
@en "ArticulationPoints"
@fa "نقاط برش"
pub func ArticulationPoints(g &: Graph): Vector<int>:
mut isart := Vector {} as Vector<bool>
defer isart.free()
mut bridge := Vector {} as Vector<bool>
defer bridge.free()
mut ecomp := Vector {} as Vector<int>
defer ecomp.free()
_bcc_all(g, isart, bridge, ecomp)
mut out := Vector {} as Vector<int>
repeat g.n in u:
if isart.get(u): out.push(u) end
end
ret out
end
@en "BiconnectedComponents"
@fa "مؤلفه‌های دوهمبند"
pub func BiconnectedComponents(g &: Graph, ecomp &: Vector<int>): int:
mut isart := Vector {} as Vector<bool>
defer isart.free()
mut bridge := Vector {} as Vector<bool>
defer bridge.free()
ret _bcc_all(g, isart, bridge, ecomp)
end
@en "IsBiconnected"
@fa "دوهمبند است"
pub func IsBiconnected(g &: Graph): bool:
if g.n < 3: ret false end
if IsConnected(g) == false: ret false end
mut a := ArticulationPoints(g)
defer a.free()
ret a.len() == 0
end
@en "IsTwoEdgeConnected"
@fa "دو یال همبند است"
pub func IsTwoEdgeConnected(g &: Graph): bool:
if g.n < 2: ret false end
if IsConnected(g) == false: ret false end
mut b := Bridges(g)
defer b.free()
ret b.len() == 0
end
@en "TwoEdgeComponents"
@fa "مؤلفه‌های دویالی"
pub func TwoEdgeComponents(g &: Graph, comp &: Vector<int>): int:
mut bridge := Vector {} as Vector<bool>
defer bridge.free()
mut isart := Vector {} as Vector<bool>
defer isart.free()
mut ecomp := Vector {} as Vector<int>
defer ecomp.free()
_bcc_all(g, isart, bridge, ecomp)
mut keep := Vector {} as Vector<bool>
defer keep.free()
repeat g.size() in e: keep.push(bridge.get(e) == false) end
mut h := EdgeSubgraph(g, keep)
c := Components(h, comp)
defer h.free()
ret c
end
package graph
func _sw_matrix(g &: Graph): Matrix:
mut w := NewMatrix(g.n, g.n)
repeat g.size() in e:
u := g.edge_from(e)
v := g.edge_to(e)
if u != v:
w.add_at(u, v, g.edge_weight(e))
w.add_at(v, u, g.edge_weight(e))
end
end
ret w
end
func _sw_phase(w &: Matrix, active &: Vector<int>, wsum &: Vector<f64>, added &: Vector<bool>): f64:
k := active.len()
FillBool(added, w.rows, false)
FillFloat(wsum, w.rows, 0.0)
mut prev := GRAPH_NONE
mut last := GRAPH_NONE
repeat k:
sel := _sw_select(active, wsum, added)
added.set(sel, true)
prev = last
last = sel
_sw_absorb(w, active, wsum, added, sel)
end
cut := wsum.get(last)
_sw_merge(w, active, prev, last)
ret cut
end
func _sw_select(active: Vector<int>, wsum: Vector<f64>, added: Vector<bool>): int:
mut best := GRAPH_NONE
repeat active.len() in i:
v := active.get(i)
if added.get(v) == false:
if best == GRAPH_NONE: best = v
else wsum.get(v) > wsum.get(best): best = v
end
end
end
ret best
end
func _sw_absorb(w &: Matrix, active: Vector<int>, wsum &: Vector<f64>, added: Vector<bool>, sel: int):
repeat active.len() in i:
v := active.get(i)
if added.get(v) == false: wsum.set(v, wsum.get(v) + w.at(sel, v)) end
end
end
func _sw_merge(w &: Matrix, active &: Vector<int>, prev: int, last: int):
if prev == GRAPH_NONE: ret end
repeat active.len() in i:
v := active.get(i)
if v != last:
if v != prev:
w.set(prev, v, w.at(prev, v) + w.at(last, v))
w.set(v, prev, w.at(prev, v))
end
end
end
mut keep := Vector {} as Vector<int>
repeat active.len() in i:
v := active.get(i)
if v != last: keep.push(v) end
end
active.clear()
repeat keep.len() in i: active.push(keep.get(i)) end
defer keep.free()
end
func _split_net(g &: Graph): FlowNet:
n := g.n
mut f := NewFlowNet(2 * n)
repeat n in v: f.add_arc(v, v + n, 1.0) end
repeat g.size() in e:
u := g.edge_from(e)
v := g.edge_to(e)
f.add_arc(u + n, v, GRAPH_INF)
if g.directed == false: f.add_arc(v + n, u, GRAPH_INF) end
end
ret f
end
func _unit_net(g &: Graph): FlowNet:
mut f := NewFlowNet(g.n)
repeat g.size() in e:
u := g.edge_from(e)
v := g.edge_to(e)
if g.directed: f.add_arc(u, v, 1.0)
else:
f.add_edge(u, v, 1.0)
end
end
ret f
end
func _kuhn_try(g &: Graph, u: int, seen &: Vector<bool>, mate &: Vector<int>): bool:
mut k := g.adj_start(u)
stop := g.adj_stop(u)
until k < stop:
v := g.adj_node(k)
if seen.get(v) == false:
seen.set(v, true)
if _kuhn_take(g, u, v, seen, mate): ret true end
end
k++
end
ret false
end
func _kuhn_take(g &: Graph, u: int, v: int, seen &: Vector<bool>, mate &: Vector<int>): bool:
w := mate.get(v)
if w == GRAPH_NONE:
mate.set(v, u)
mate.set(u, v)
ret true
end
if _kuhn_try(g, w, seen, mate):
mate.set(v, u)
mate.set(u, v)
ret true
end
ret false
end
func _matching_run(g &: Graph, color: Vector<int>, mate &: Vector<int>): int:
FillInt(mate, g.n, GRAPH_NONE)
mut seen := Vector {} as Vector<bool>
defer seen.free()
mut count := 0
repeat g.n in u:
if _needs_match(color, mate, u):
FillBool(seen, g.n, false)
if _kuhn_try(g, u, seen, mate): count++ end
end
end
ret count
end
func _needs_match(color: Vector<int>, mate: Vector<int>, u: int): bool:
if color.get(u) != 0: ret false end
ret mate.get(u) == GRAPH_NONE
end
func _alternating_reach(g &: Graph, color: Vector<int>, mate: Vector<int>, seen &: Vector<bool>):
FillBool(seen, g.n, false)
mut q := Vector {} as Vector<int>
defer q.free()
repeat g.n in u:
if color.get(u) == 0:
if mate.get(u) == GRAPH_NONE:
seen.set(u, true)
q.push(u)
end
end
end
mut head := 0
until head < q.len():
u := q.get(head)
head++
_alternating_step(g, color, mate, seen, q, u)
end
end
func _alternating_step(g &: Graph, color: Vector<int>, mate: Vector<int>, seen &: Vector<bool>, q &: Vector<int>, u: int):
mut k := g.adj_start(u)
stop := g.adj_stop(u)
until k < stop:
v := g.adj_node(k)
ok := color.get(u) == 0
matched := mate.get(u) == v
if ok != matched:
if seen.get(v) == false:
seen.set(v, true)
q.push(v)
end
end
k++
end
end
func _cover_from(g &: Graph, color: Vector<int>, seen: Vector<bool>, cover &: Vector<bool>): int:
mut count := 0
repeat g.n in u:
left := color.get(u) == 0
mut take := seen.get(u)
if left: take = seen.get(u) == false end
if take:
if g.degree(u) > 0:
cover.set(u, true)
count++
end
end
end
ret count
end
func _kappa_row(s &: Graph, f &: FlowNet, a: int, best &: int):
repeat s.n in b:
if a != b:
if s.has_edge(a, b) == false:
f.reset()
v := MaxFlow(f, a + s.n, b)
if v < (best as f64): best = v as int end
end
end
end
end
func _directed_edge_connectivity(g &: Graph): int:
mut f := _unit_net(g)
mut best := GRAPH_INF
repeat g.n in t:
if t != 0:
f.reset()
a := MaxFlow(f, 0, t)
if a < best: best = a end
f.reset()
b := MaxFlow(f, t, 0)
if b < best: best = b end
end
end
defer f.free()
if best >= GRAPH_INF: ret 0 end
ret (best + 0.5) as int
end
@en "GlobalMinCut"
@fa "کمینه برش سراسری"
pub func GlobalMinCut(g &: Graph): f64:
if g.n < 2: ret 0.0 end
mut w := _sw_matrix(g)
mut active := Vector {} as Vector<int>
defer active.free()
mut wsum := Vector {} as Vector<f64>
defer wsum.free()
mut added := Vector {} as Vector<bool>
defer added.free()
Iota(active, g.n)
mut best := GRAPH_INF
until active.len() > 1:
cut := _sw_phase(w, active, wsum, added)
if cut < best: best = cut end
end
defer w.free()
ret best
end
@en "EdgeConnectivity"
@fa "همبندی یالی"
pub func EdgeConnectivity(g &: Graph): int:
if g.n < 2: ret 0 end
if g.directed: ret _directed_edge_connectivity(g) end
mut u := Clone(g)
repeat u.size() in e: u.set_weight(e, 1.0) end
v := GlobalMinCut(u)
defer u.free()
if v >= GRAPH_INF: ret 0 end
ret (v + 0.5) as int
end
@en "VertexConnectivity"
@fa "همبندی رأسی"
pub func VertexConnectivity(g &: Graph): int:
if g.n < 2: ret 0 end
if IsConnected(g) == false: ret 0 end
mut s := Simplify(g)
mut best := s.n - 1
mut f := _split_net(s)
repeat s.n in a:
_kappa_row(s, f, a, best)
end
defer f.free()
defer s.free()
ret best
end
@en "BipartiteMatching"
@fa "جورسازی دوبخشی"
pub func BipartiteMatching(g &: Graph, mate &: Vector<int>): int:
mut color := Vector {} as Vector<int>
defer color.free()
if IsBipartite(g, color) == false: ret GRAPH_NONE end
repeat g.n in u:
if color.get(u) == GRAPH_NONE: color.set(u, 0) end
end
if g.directed == false: ret _matching_run(g, color, mate) end
mut ug := ToUndirected(g)
c := _matching_run(ug, color, mate)
defer ug.free()
ret c
end
@en "MaximalMatching"
@fa "جورسازی بیشینه‌ای"
pub func MaximalMatching(g &: Graph, mate &: Vector<int>): int:
FillInt(mate, g.n, GRAPH_NONE)
mut count := 0
repeat g.size() in e:
u := g.edge_from(e)
v := g.edge_to(e)
if u != v:
if mate.get(u) == GRAPH_NONE:
if mate.get(v) == GRAPH_NONE:
mate.set(u, v)
mate.set(v, u)
count++
end
end
end
end
ret count
end
@en "MinimumVertexCover"
@fa "کمینه پوشش رأسی"
pub func MinimumVertexCover(g &: Graph, cover &: Vector<bool>): int:
mut color := Vector {} as Vector<int>
defer color.free()
FillBool(cover, g.n, false)
if IsBipartite(g, color) == false: ret GRAPH_NONE end
repeat g.n in u:
if color.get(u) == GRAPH_NONE: color.set(u, 0) end
end
mut mate := Vector {} as Vector<int>
defer mate.free()
_matching_run(g, color, mate)
mut seen := Vector {} as Vector<bool>
defer seen.free()
_alternating_reach(g, color, mate, seen)
ret _cover_from(g, color, seen, cover)
end
@en "MaximumIndependentSetBipartite"
@fa "بیشینه مجموعه مستقل دوبخشی"
pub func MaximumIndependentSetBipartite(g &: Graph, pick &: Vector<bool>): int:
mut cover := Vector {} as Vector<bool>
defer cover.free()
c := MinimumVertexCover(g, cover)
if c == GRAPH_NONE: ret GRAPH_NONE end
FillBool(pick, g.n, false)
mut count := 0
repeat g.n in u:
if cover.get(u) == false:
pick.set(u, true)
count++
end
end
ret count
end
package graph
func _dag_order(g &: Graph, order &: Vector<int>): bool:
if g.directed == false: ret false end
ret TopologicalSort(g, order)
end
func _relax_forward(g &: Graph, u: int, dist &: Vector<f64>, parent &: Vector<int>, longest: bool):
mut k := g.adj_start(u)
stop := g.adj_stop(u)
until k < stop:
v := g.adj_node(k)
new_dist := dist.get(u) + g.adj_weight(k)
if _better(new_dist, dist.get(v), longest):
dist.set(v, new_dist)
parent.set(v, u)
end
k++
end
end
func _better(candidate: f64, current: f64, longest: bool): bool:
if longest: ret candidate > current end
ret candidate < current
end
func _closure_row(g &: Graph, s: int, m &: IntMatrix):
mut r := Reachable(g, s)
defer r.free()
repeat g.n in t:
if r.get(t):
if t != s: m.set(s, t, 1) end
end
end
end
func _is_redundant(g &: Graph, closure &: IntMatrix, u: int, v: int): bool:
repeat g.n in w:
if w != u:
if w != v:
if closure.at(u, w) == 1:
if closure.at(w, v) == 1: ret true end
end
end
end
end
ret false
end
func _dag_relax(g &: Graph, src: int, dist &: Vector<f64>, parent &: Vector<int>, longest: bool): bool:
mut order := Vector {} as Vector<int>
defer order.free()
mut start := GRAPH_INF
if longest: start = 0.0 - GRAPH_INF end
FillFloat(dist, g.n, start)
FillInt(parent, g.n, GRAPH_NONE)
if _dag_order(g, order) == false: ret false end
dist.set(src, 0.0)
repeat order.len() in i:
u := order.get(i)
if dist.get(u) != start: _relax_forward(g, u, dist, parent, longest) end
end
ret true
end
func _spread_ways(g &: Graph, u: int, ways &: Vector<f64>):
mut k := g.adj_start(u)
stop := g.adj_stop(u)
until k < stop:
v := g.adj_node(k)
ways.set(v, ways.get(v) + ways.get(u))
k++
end
end
func _push_layer(g &: Graph, u: int, layer &: Vector<int>):
mut k := g.adj_start(u)
stop := g.adj_stop(u)
until k < stop:
v := g.adj_node(k)
if layer.get(v) < layer.get(u) + 1: layer.set(v, layer.get(u) + 1) end
k++
end
end
func _argmax(dist: Vector<f64>): int:
mut best := 0
repeat dist.len() in u:
if dist.get(u) > dist.get(best): best = u end
end
ret best
end
func _path_root(parent: Vector<int>, t: int): int:
mut u := t
until parent.get(u) != GRAPH_NONE: u = parent.get(u) end
ret u
end
func _reduce_edge(g &: Graph, h &: Graph, closure &: IntMatrix, seen &: HashMap<i64, bool>, u: int, v: int):
if u == v: ret end
k := (u as i64) * (g.n as i64) + (v as i64)
if seen.has(k): ret end
seen.put(k, true)
if _is_redundant(g, closure, u, v): ret end
h.add_edge(u, v)
end
@en "DAGShortestPath"
@fa "کوتاه‌ترین مسیر بی‌دور"
pub func DAGShortestPath(g &: Graph, src: int, dist &: Vector<f64>, parent &: Vector<int>): bool:
ret _dag_relax(g, src, dist, parent, false)
end
@en "DAGLongestPath"
@fa "بلندترین مسیر بی‌دور"
pub func DAGLongestPath(g &: Graph, src: int, dist &: Vector<f64>, parent &: Vector<int>): bool:
ret _dag_relax(g, src, dist, parent, true)
end
@en "CriticalPath"
@fa "مسیر بحرانی"
pub func CriticalPath(g &: Graph): Vector<int>:
mut order := Vector {} as Vector<int>
defer order.free()
out := Vector {} as Vector<int>
if _dag_order(g, order) == false: ret out end
mut dist := Vector {} as Vector<f64>
defer dist.free()
mut parent := Vector {} as Vector<int>
defer parent.free()
FillFloat(dist, g.n, 0.0)
FillInt(parent, g.n, GRAPH_NONE)
repeat order.len() in i: _relax_forward(g, order.get(i), dist, parent, true) end
ret PathFromParents(parent, _path_root(parent, _argmax(dist)), _argmax(dist))
end
@en "CountPaths"
@fa "شمار مسیرها"
pub func CountPaths(g &: Graph, s: int, t: int): f64:
mut order := Vector {} as Vector<int>
defer order.free()
if _dag_order(g, order) == false: ret 0.0 end
mut ways := Vector {} as Vector<f64>
defer ways.free()
FillFloat(ways, g.n, 0.0)
ways.set(s, 1.0)
repeat order.len() in i:
u := order.get(i)
if ways.get(u) > 0.0: _spread_ways(g, u, ways) end
end
ret ways.get(t)
end
@en "PathCounts"
@fa "شمارش مسیرها"
pub func PathCounts(g &: Graph, src: int): Vector<f64>:
mut order := Vector {} as Vector<int>
defer order.free()
mut ways := Vector {} as Vector<f64>
FillFloat(ways, g.n, 0.0)
if _dag_order(g, order) == false: ret ways end
ways.set(src, 1.0)
repeat order.len() in i:
u := order.get(i)
if ways.get(u) > 0.0: _spread_ways(g, u, ways) end
end
ret ways
end
@en "TransitiveClosure"
@fa "بستار تعدی"
pub func TransitiveClosure(g &: Graph): IntMatrix:
mut m := NewIntMatrix(g.n, g.n, 0)
repeat g.n in s: _closure_row(g, s, m) end
ret m
end
@en "TransitiveReduction"
@fa "کاهش تعدی"
pub func TransitiveReduction(g &: Graph): Graph:
mut h := New(g.n, true)
if IsDAG(g) == false: ret h end
mut closure := TransitiveClosure(g)
defer closure.free()
mut seen := HashMap {} as HashMap<i64, bool>
defer seen.free()
repeat g.size() in e:
u := g.edge_from(e)
v := g.edge_to(e)
_reduce_edge(g, h, closure, seen, u, v)
end
ret h
end
@en "TopologicalLayers"
@fa "لایه‌های توپولوژیک"
pub func TopologicalLayers(g &: Graph, layer &: Vector<int>): int:
mut order := Vector {} as Vector<int>
defer order.free()
FillInt(layer, g.n, 0)
if _dag_order(g, order) == false: ret GRAPH_NONE end
repeat order.len() in i: _push_layer(g, order.get(i), layer) end
ret MaxInt(layer) + 1
end
@en "IsTotalOrder"
@fa "ترتیب کلی است"
pub func IsTotalOrder(g &: Graph): bool:
mut order := Vector {} as Vector<int>
defer order.free()
if _dag_order(g, order) == false: ret false end
mut closure := TransitiveClosure(g)
defer closure.free()
mut i := 0
until i < order.len() - 1:
if closure.at(order.get(i), order.get(i + 1)) == 0: ret false end
i++
end
ret true
end
package graph
func _dinic_bfs(f &: FlowNet, s: int, t: int, level &: Vector<int>): bool:
FillInt(level, f.n, GRAPH_NONE)
mut q := Vector {} as Vector<int>
defer q.free()
level.set(s, 0)
q.push(s)
mut head := 0
until head < q.len():
u := q.get(head)
head++
mut e := f.head.get(u)
until e != GRAPH_NONE:
_dinic_visit(f, u, e, level, q)
e = f.nxt.get(e)
end
end
ret level.get(t) != GRAPH_NONE
end
func _dinic_visit(f &: FlowNet, u: int, e: int, level &: Vector<int>, q &: Vector<int>):
v := f.to.get(e)
if f.cap.get(e) <= 0.0: ret end
if level.get(v) != GRAPH_NONE: ret end
level.set(v, level.get(u) + 1)
q.push(v)
end
func _dinic_step(f &: FlowNet, u: int, level &: Vector<int>, iter &: Vector<int>): int:
mut e := iter.get(u)
until e != GRAPH_NONE:
v := f.to.get(e)
if f.cap.get(e) > 0.0:
if level.get(v) == level.get(u) + 1: ret e end
end
e = f.nxt.get(e)
iter.set(u, e)
end
ret GRAPH_NONE
end
func _apply_path(f &: FlowNet, path: Vector<int>): f64:
mut bottleneck := GRAPH_INF
repeat path.len() in i:
c := f.cap.get(path.get(i))
if c < bottleneck: bottleneck = c end
end
repeat path.len() in i:
e := path.get(i)
f.cap.set(e, f.cap.get(e) - bottleneck)
r := e ^ 1
f.cap.set(r, f.cap.get(r) + bottleneck)
end
ret bottleneck
end
func _dinic_path(f &: FlowNet, s: int, t: int, level &: Vector<int>, iter &: Vector<int>): f64:
mut path := Vector {} as Vector<int>
defer path.free()
mut u := s
mut result := 0.0
until true:
if u == t:
result = _apply_path(f, path)
break
end
e := _dinic_step(f, u, level, iter)
if e != GRAPH_NONE:
path.push(e)
u = f.to.get(e)
else:
if u == s: break end
level.set(u, GRAPH_NONE)
back := path.pop()
u = f.to.get(back ^ 1)
iter.set(u, f.nxt.get(iter.get(u)))
end
end
ret result
end
func _ek_bfs(f &: FlowNet, s: int, t: int, via &: Vector<int>): bool:
FillInt(via, f.n, GRAPH_NONE)
mut seen := Vector {} as Vector<bool>
defer seen.free()
FillBool(seen, f.n, false)
mut q := Vector {} as Vector<int>
defer q.free()
seen.set(s, true)
q.push(s)
mut head := 0
until head < q.len():
u := q.get(head)
head++
mut e := f.head.get(u)
until e != GRAPH_NONE:
_ek_visit(f, e, seen, via, q)
e = f.nxt.get(e)
end
end
ret seen.get(t)
end
func _ek_visit(f &: FlowNet, e: int, seen &: Vector<bool>, via &: Vector<int>, q &: Vector<int>):
v := f.to.get(e)
if f.cap.get(e) <= 0.0: ret end
if seen.get(v): ret end
seen.set(v, true)
via.set(v, e)
q.push(v)
end
func _ek_augment(f &: FlowNet, s: int, t: int, via: Vector<int>): f64:
mut path := Vector {} as Vector<int>
defer path.free()
mut u := t
until u != s:
e := via.get(u)
path.push(e)
u = f.to.get(e ^ 1)
end
ret _apply_path(f, path)
end
func _spfa(f &: FlowNet, s: int, t: int, dist &: Vector<f64>, via &: Vector<int>): bool:
FillFloat(dist, f.n, GRAPH_INF)
FillInt(via, f.n, GRAPH_NONE)
dist.set(s, 0.0)
mut round := 0
until round < f.n:
if _spfa_pass(f, dist, via) == false: break end
round++
end
ret dist.get(t) < GRAPH_INF
end
func _spfa_pass(f &: FlowNet, dist &: Vector<f64>, via &: Vector<int>): bool:
mut changed := false
repeat f.n in u:
if dist.get(u) < GRAPH_INF:
mut e := f.head.get(u)
until e != GRAPH_NONE:
if _spfa_relax(f, u, e, dist, via): changed = true end
e = f.nxt.get(e)
end
end
end
ret changed
end
func _spfa_relax(f &: FlowNet, u: int, e: int, dist &: Vector<f64>, via &: Vector<int>): bool:
if f.cap.get(e) <= 0.0: ret false end
v := f.to.get(e)
new_dist := dist.get(u) + f.cost.get(e)
if new_dist < dist.get(v):
dist.set(v, new_dist)
via.set(v, e)
ret true
end
ret false
end
func _residual_side(f &: FlowNet, s: int, side &: Vector<bool>):
FillBool(side, f.n, false)
mut q := Vector {} as Vector<int>
defer q.free()
side.set(s, true)
q.push(s)
mut head := 0
until head < q.len():
u := q.get(head)
head++
mut e := f.head.get(u)
until e != GRAPH_NONE:
v := f.to.get(e)
if f.cap.get(e) > 0.0:
if side.get(v) == false:
side.set(v, true)
q.push(v)
end
end
e = f.nxt.get(e)
end
end
end
func _mcf_augment(f &: FlowNet, s: int, t: int, via: Vector<int>, room: f64): f64:
mut path := Vector {} as Vector<int>
defer path.free()
mut u := t
mut bottleneck := room
until u != s:
e := via.get(u)
if f.cap.get(e) < bottleneck: bottleneck = f.cap.get(e) end
path.push(e)
u = f.to.get(e ^ 1)
end
repeat path.len() in i:
e := path.get(i)
f.cap.set(e, f.cap.get(e) - bottleneck)
r := e ^ 1
f.cap.set(r, f.cap.get(r) + bottleneck)
end
ret bottleneck
end
@en "NewFlowNet"
@fa "شبکه شار جدید"
pub func NewFlowNet(n: int): FlowNet:
mut f := FlowNet {}
f.n = n
FillInt(f.head, n, GRAPH_NONE)
ret f
end
@en "FlowFromGraph"
@fa "شار از گراف"
pub func FlowFromGraph(g &: Graph): FlowNet:
mut f := NewFlowNet(g.n)
repeat g.size() in e:
if g.directed: f.add_arc(g.edge_from(e), g.edge_to(e), g.edge_weight(e))
else:
f.add_edge(g.edge_from(e), g.edge_to(e), g.edge_weight(e))
end
end
ret f
end
@en "MaxFlow"
@fa "بیشینه شار"
pub func MaxFlow(f &: FlowNet, s: int, t: int): f64:
mut level := Vector {} as Vector<int>
defer level.free()
mut iter := Vector {} as Vector<int>
defer iter.free()
mut total := 0.0
if s == t: ret 0.0 end
FillInt(iter, f.n, GRAPH_NONE)
until _dinic_bfs(f, s, t, level):
repeat f.n in u: iter.set(u, f.head.get(u)) end
mut aug := _dinic_path(f, s, t, level, iter)
until aug > 0.0:
total += aug
aug = _dinic_path(f, s, t, level, iter)
end
end
ret total
end
@en "MaxFlowEdmondsKarp"
@fa "بیشینه شار ادموندز کارپ"
pub func MaxFlowEdmondsKarp(f &: FlowNet, s: int, t: int): f64:
mut via := Vector {} as Vector<int>
defer via.free()
mut total := 0.0
if s == t: ret 0.0 end
until _ek_bfs(f, s, t, via):
total += _ek_augment(f, s, t, via)
end
ret total
end
@en "MinCut"
@fa "کمینه برش"
pub func MinCut(f &: FlowNet, s: int, t: int, side &: Vector<bool>): f64:
v := MaxFlow(f, s, t)
_residual_side(f, s, side)
ret v
end
@en "MaxFlowValue"
@fa "مقدار بیشینه شار"
pub func MaxFlowValue(g &: Graph, s: int, t: int): f64:
mut f := FlowFromGraph(g)
v := MaxFlow(f, s, t)
defer f.free()
ret v
end
@en "MinCutEdges"
@fa "یال‌های کمینه برش"
pub func MinCutEdges(g &: Graph, s: int, t: int, cut &: Vector<int>): f64:
mut f := FlowFromGraph(g)
mut side := Vector {} as Vector<bool>
defer side.free()
v := MinCut(f, s, t, side)
cut.clear()
repeat g.size() in e:
a := side.get(g.edge_from(e))
b := side.get(g.edge_to(e))
if a != b: cut.push(e) end
end
defer f.free()
ret v
end
@en "MinCostFlow"
@fa "شار کم‌هزینه"
pub func MinCostFlow(f &: FlowNet, s: int, t: int, want: f64, sent &: f64): f64:
mut dist := Vector {} as Vector<f64>
defer dist.free()
mut via := Vector {} as Vector<int>
defer via.free()
mut total := 0.0
sent = 0.0
until _spfa(f, s, t, dist, via):
if sent >= want: break end
pushed := _mcf_augment(f, s, t, via, want - sent)
if pushed <= 0.0: break end
sent += pushed
total += pushed * dist.get(t)
end
ret total
end
package graph
@en "FlowNet"
@fa "شبکه شار"
pub struct FlowNet:
@en "n"
@fa "شمار گره‌ها"
pub n: int = 0
@en "head"
@fa "آغاز کمان‌ها"
pub head: Vector<int> = Vector {}
@en "to"
@fa "مقصد"
pub to: Vector<int> = Vector {}
@en "cap"
@fa "ظرفیت باقی‌مانده"
pub cap: Vector<f64> = Vector {}
@en "cost"
@fa "هزینه"
pub cost: Vector<f64> = Vector {}
@en "orig"
@fa "ظرفیت اصلی"
pub orig: Vector<f64> = Vector {}
@en "nxt"
@fa "کمان بعدی"
pub nxt: Vector<int> = Vector {}
@en "arc_count"
@fa "شمار کمان"
pub func arc_count(): int: ret this.to.len() end
@en "add_arc"
@fa "افزودن کمان"
pub func add_arc(u: int, v: int, c: f64): int:
ret this.add_cost_arc(u, v, c, 0.0)
end
@en "add_cost_arc"
@fa "افزودن کمان هزینه‌دار"
pub func add_cost_arc(u: int, v: int, c: f64, k: f64): int:
e := this.to.len()
this._push(u, v, c, k)
this._push(v, u, 0.0, 0.0 - k)
ret e
end
@en "add_edge"
@fa "افزودن یال"
pub func add_edge(u: int, v: int, c: f64): int:
e := this.to.len()
this._push(u, v, c, 0.0)
this._push(v, u, c, 0.0)
ret e
end
func _push(u: int, v: int, c: f64, k: f64):
this.to.push(v)
this.cap.push(c)
this.orig.push(c)
this.cost.push(k)
this.nxt.push(this.head.get(u))
this.head.set(u, this.to.len() - 1)
end
@en "flow_on"
@fa "شار روی"
pub func flow_on(e: int): f64: ret this.orig.get(e) - this.cap.get(e) end
@en "reset"
@fa "بازنشانی"
pub func reset():
repeat this.cap.len() in e: this.cap.set(e, this.orig.get(e)) end
end
@en "free"
@fa "آزادسازی"
pub func free():
this.head.free()
this.to.free()
this.cap.free()
this.cost.free()
this.orig.free()
this.nxt.free()
end
end
package graph
import rand
func _link_all(g &: Graph, a: int, b: int):
mut i := a
until i < b:
mut j := i + 1
until j < b:
g.add_edge(i, j)
j++
end
i++
end
end
func _grid_index(r: int, c: int, cols: int): int: ret r * cols + c end
func _tree_size(branch: int, depth: int): int:
mut total := 1
mut level := 1
repeat depth:
level *= branch
total += level
end
ret total
end
func _hypercube_bit(u: int, b: int): int: ret u ^ (1 << b) end
func _ba_targets(pool: Vector<int>, m: int, picked &: Vector<int>):
picked.clear()
mut guard := 0
until picked.len() < m:
if guard > 1000: break end
guard++
if pool.len() == 0: break end
cand := pool.get(rand.IntN(pool.len() as i64) as int)
if _already(picked, cand) == false: picked.push(cand) end
end
end
func _already(v: Vector<int>, x: int): bool:
repeat v.len() in i:
if v.get(i) == x: ret true end
end
ret false
end
func _circ_link(g &: Graph, seen &: HashMap<i64, bool>, u: int, off: int, n: int):
if off <= 0: ret end
v := (u + off) % n
if v == u: ret end
mut lo := u
mut hi := v
if lo > hi:
lo = v
hi = u
end
key := (lo as i64) * (n as i64) + (hi as i64)
if seen.has(key): ret end
seen.put(key, true)
g.add_edge(lo, hi)
end
func _random_edge(g &: Graph, seen &: HashMap<i64, bool>, n: int): bool:
u := rand.IntN(n as i64) as int
v := rand.IntN(n as i64) as int
if u == v: ret false end
mut lo := u
mut hi := v
if lo > hi:
lo = v
hi = u
end
key := (lo as i64) * (n as i64) + (hi as i64)
if seen.has(key): ret false end
seen.put(key, true)
g.add_edge(lo, hi)
ret true
end
func _seed_pool(g &: Graph, pool &: Vector<int>):
repeat g.size() in e:
pool.push(g.edge_from(e))
pool.push(g.edge_to(e))
end
end
func _ba_attach(g &: Graph, pool &: Vector<int>, picked: Vector<int>, v: int):
repeat picked.len() in i:
t := picked.get(i)
g.add_edge(v, t)
pool.push(v)
pool.push(t)
end
end
func _rewire(ring &: Graph, p: f64, n: int): Graph:
mut g := New(n, false)
mut seen := HashMap {} as HashMap<i64, bool>
defer seen.free()
repeat ring.size() in e:
u := ring.edge_from(e)
mut v := ring.edge_to(e)
if rand.Float() < p: v = rand.IntN(n as i64) as int end
if v != u: _circ_link(g, seen, u, (v - u + n) % n, n) end
end
ret g
end
@en "EmptyGraph"
@fa "گراف تهی"
pub func EmptyGraph(n: int): Graph: ret New(n, false) end
@en "CompleteGraph"
@fa "گراف کامل"
pub func CompleteGraph(n: int): Graph:
mut g := New(n, false)
_link_all(g, 0, n)
ret g
end
@en "CompleteBipartite"
@fa "دوبخشی کامل"
pub func CompleteBipartite(a: int, b: int): Graph:
mut g := New(a + b, false)
repeat a in i:
repeat b in j: g.add_edge(i, a + j) end
end
ret g
end
@en "PathGraph"
@fa "گراف مسیر"
pub func PathGraph(n: int): Graph:
mut g := New(n, false)
mut i := 0
until i < n - 1:
g.add_edge(i, i + 1)
i++
end
ret g
end
@en "CycleGraph"
@fa "گراف دور"
pub func CycleGraph(n: int): Graph:
mut g := PathGraph(n)
if n > 2: g.add_edge(n - 1, 0) end
ret g
end
@en "StarGraph"
@fa "گراف ستاره"
pub func StarGraph(n: int): Graph:
mut g := New(n, false)
mut i := 1
until i < n:
g.add_edge(0, i)
i++
end
ret g
end
@en "WheelGraph"
@fa "گراف چرخ"
pub func WheelGraph(n: int): Graph:
if n < 4: ret CycleGraph(n) end
mut g := New(n, false)
mut i := 1
until i < n - 1:
g.add_edge(i, i + 1)
i++
end
g.add_edge(n - 1, 1)
mut j := 1
until j < n:
g.add_edge(0, j)
j++
end
ret g
end
@en "GridGraph"
@fa "گراف شبکه"
pub func GridGraph(rows: int, cols: int): Graph:
mut g := New(rows * cols, false)
repeat rows in r:
repeat cols in c:
if c + 1 < cols: g.add_edge(_grid_index(r, c, cols), _grid_index(r, c + 1, cols)) end
if r + 1 < rows: g.add_edge(_grid_index(r, c, cols), _grid_index(r + 1, c, cols)) end
end
end
ret g
end
@en "HypercubeGraph"
@fa "گراف مکعبی"
pub func HypercubeGraph(d: int): Graph:
n := 1 << d
mut g := New(n, false)
repeat n in u:
repeat d in b:
v := _hypercube_bit(u, b)
if v > u: g.add_edge(u, v) end
end
end
ret g
end
@en "PetersenGraph"
@fa "گراف پترسن"
pub func PetersenGraph(): Graph:
mut g := New(10, false)
repeat 5 in i:
g.add_edge(i, (i + 1) % 5)
g.add_edge(i, i + 5)
g.add_edge(5 + i, 5 + (i + 2) % 5)
end
ret g
end
@en "CirculantGraph"
@fa "گراف دوری"
pub func CirculantGraph(n: int, offsets: Vector<int>): Graph:
mut g := New(n, false)
mut seen := HashMap {} as HashMap<i64, bool>
defer seen.free()
repeat n in u:
repeat offsets.len() in k:
_circ_link(g, seen, u, offsets.get(k), n)
end
end
ret g
end
@en "BalancedTree"
@fa "درخت متوازن"
pub func BalancedTree(branch: int, depth: int): Graph:
n := _tree_size(branch, depth)
mut g := New(n, false)
mut i := 1
until i < n:
g.add_edge((i - 1) / branch, i)
i++
end
ret g
end
@en "ErdosRenyi"
@fa "اردوش رنی"
pub func ErdosRenyi(n: int, p: f64): Graph:
mut g := New(n, false)
repeat n in u:
mut v := u + 1
until v < n:
if rand.Float() < p: g.add_edge(u, v) end
v++
end
end
ret g
end
@en "RandomGraph"
@fa "گراف تصادفی"
pub func RandomGraph(n: int, m: int): Graph:
mut g := New(n, false)
mut seen := HashMap {} as HashMap<i64, bool>
defer seen.free()
mut added := 0
mut guard := 0
until added < m:
if guard > 100 * m + 1000: break end
guard++
if _random_edge(g, seen, n): added++ end
end
ret g
end
@en "RandomTree"
@fa "درخت تصادفی"
pub func RandomTree(n: int): Graph:
if n < 2: ret New(n, false) end
mut code := Vector {} as Vector<int>
defer code.free()
repeat n - 2: code.push(rand.IntN(n as i64) as int) end
ret PruferDecode(code)
end
@en "BarabasiAlbert"
@fa "باراباشی آلبرت"
pub func BarabasiAlbert(n: int, m: int): Graph:
if n <= m: ret CompleteGraph(n) end
mut g := CompleteGraph(m + 1)
mut pool := Vector {} as Vector<int>
defer pool.free()
_seed_pool(g, pool)
mut picked := Vector {} as Vector<int>
defer picked.free()
mut v := m + 1
until v < n:
_ba_targets(pool, m, picked)
_ba_attach(g, pool, picked, v)
v++
end
ret g
end
@en "WattsStrogatz"
@fa "واتس استروگاتز"
pub func WattsStrogatz(n: int, k: int, p: f64): Graph:
mut ring := New(n, false)
half := k / 2
repeat n in u:
mut d := 1
until d <= half:
ring.add_edge(u, (u + d) % n)
d++
end
end
g := _rewire(ring, p, n)
defer ring.free()
ret g
end
package graph
import str
import conv
func _label(g &: Graph, u: int): str:
s := g.name(u)
if str.Len(s) > 0: ret s end
ret conv.FormatInt(u as i64)
end
func _quote(s: str): str: ret "\"" + s + "\"" end
func _weight_text(w: f64): str: ret conv.FormatFloat(w) end
func _arrow(g &: Graph): str:
if g.directed: ret " -> " end
ret " -- "
end
func _is_blank(line: str): bool:
t := str.Trim(line)
if str.Len(t) == 0: ret true end
ret str.StartsWith(t, "#")
end
func _parse_line(g &: Graph, line: str):
if _is_blank(line): ret end
mut parts := str.Fields(str.Trim(line))
defer parts.free()
if parts.len() < 2: ret end
u := str.ToInt(parts.get(0)) as int
v := str.ToInt(parts.get(1)) as int
if parts.len() >= 3: g.add_weighted(u, v, str.ToFloat(parts.get(2)))
else:
g.add_edge(u, v)
end
end
func _max_node(text: str): int:
mut best := 0
mut lines := str.Split(text, "\n")
defer lines.free()
repeat lines.len() in i:
if _is_blank(lines.get(i)) == false:
mut parts := str.Fields(str.Trim(lines.get(i)))
repeat parts.len() in k:
if k < 2:
v := str.ToInt(parts.get(k)) as int
if v > best: best = v end
end
end
parts.free()
end
end
ret best
end
func _json_links(g &: Graph): str:
mut out := ""
repeat g.size() in e:
if e > 0: out += "," end
out = out + "{\"source\":" + conv.FormatInt(g.edge_from(e) as i64)
out = out + ",\"target\":" + conv.FormatInt(g.edge_to(e) as i64)
out = out + ",\"weight\":" + _weight_text(g.edge_weight(e)) + "}"
end
ret out
end
@en "ToEdgeList"
@fa "به فهرست یال"
pub func ToEdgeList(g &: Graph): str:
mut out := ""
repeat g.size() in e:
out = out + conv.FormatInt(g.edge_from(e) as i64) + " " + conv.FormatInt(g.edge_to(e) as i64)
out = out + " " + _weight_text(g.edge_weight(e)) + "\n"
end
ret out
end
@en "FromEdgeList"
@fa "از فهرست یال"
pub func FromEdgeList(text: str, n: int, directed: bool): Graph:
mut want := _max_node(text) + 1
if n > want: want = n end
mut g := New(want, directed)
mut lines := str.Split(text, "\n")
defer lines.free()
repeat lines.len() in i: _parse_line(g, lines.get(i)) end
ret g
end
@en "ToAdjacencyList"
@fa "به فهرست مجاورت"
pub func ToAdjacencyList(g &: Graph): str:
mut out := ""
repeat g.n in u:
out = out + _label(g, u) + ":"
mut k := g.adj_start(u)
stop := g.adj_stop(u)
until k < stop:
out = out + " " + _label(g, g.adj_node(k))
k++
end
out += "\n"
end
ret out
end
@en "ToMatrixText"
@fa "به متن ماتریس"
pub func ToMatrixText(g &: Graph): str:
mut a := AdjacencyMatrix(g)
mut out := ""
repeat g.n in i:
repeat g.n in j:
if j > 0: out += " " end
out += conv.FormatInt(a.at(i, j) as i64)
end
out += "\n"
end
defer a.free()
ret out
end
@en "ToDot"
@fa "به دات"
pub func ToDot(g &: Graph): str:
mut out := "graph G {\n"
if g.directed: out = "digraph G {\n" end
repeat g.n in u:
out = out + "  " + _quote(_label(g, u)) + ";\n"
end
repeat g.size() in e:
out = out + "  " + _quote(_label(g, g.edge_from(e))) + _arrow(g) + _quote(_label(g, g.edge_to(e)))
if IsClose(g.edge_weight(e), 1.0) == false:
out = out + " [label=" + _quote(_weight_text(g.edge_weight(e))) + "]"
end
out += ";\n"
end
ret out + "}\n"
end
@en "ToMermaid"
@fa "به مرمید"
pub func ToMermaid(g &: Graph): str:
mut out := "graph LR\n"
mut link := " --- "
if g.directed: link = " --> " end
repeat g.size() in e:
out = out + "  " + _label(g, g.edge_from(e)) + link + _label(g, g.edge_to(e)) + "\n"
end
ret out
end
@en "ToJSON"
@fa "به جیسون"
pub func ToJSON(g &: Graph): str:
mut out := "{\"directed\":"
if g.directed: out += "true"
else:
out += "false"
end
out += ",\"nodes\":["
repeat g.n in u:
if u > 0: out += "," end
out = out + "{\"id\":" + conv.FormatInt(u as i64) + ",\"name\":" + _quote(_label(g, u)) + "}"
end
out += "],\"links\":["
out += _json_links(g)
ret out + "]}"
end
@en "Describe"
@fa "توصیف"
pub func Describe(g &: Graph): str:
mut out := "n=" + conv.FormatInt(g.n as i64) + " m=" + conv.FormatInt(g.size() as i64)
if g.directed: out += " directed"
else:
out += " undirected"
end
out = out + " components=" + conv.FormatInt(ComponentCount(g) as i64)
if IsSimple(g): out += " simple" end
if Bipartite(g): out += " bipartite" end
if IsTree(g): out += " tree" end
if g.directed:
if IsDAG(g): out += " dag" end
end
ret out
end
package graph
func _iso_invariants_match(a &: Graph, b &: Graph): bool:
if a.n != b.n: ret false end
if a.size() != b.size(): ret false end
mut da := DegreeSequence(a)
defer da.free()
mut db := DegreeSequence(b)
defer db.free()
repeat da.len() in i:
if da.get(i) != db.get(i): ret false end
end
ret TriangleCount(a) == TriangleCount(b)
end
func _iso_adj(g &: Graph): HashMap<i64, bool>:
mut s := HashMap {} as HashMap<i64, bool>
repeat g.size() in e:
u := g.edge_from(e)
v := g.edge_to(e)
s.put((u as i64) * (g.n as i64) + (v as i64), true)
s.put((v as i64) * (g.n as i64) + (u as i64), true)
end
ret s
end
func _linked(adj &: HashMap<i64, bool>, n: int, u: int, v: int): bool:
ret adj.has((u as i64) * (n as i64) + (v as i64))
end
func _iso_extend(a &: Graph, b &: Graph, adja &: HashMap<i64, bool>, adjb &: HashMap<i64, bool>, map &: Vector<int>, used &: Vector<bool>, u: int): bool:
if u >= a.n: ret true end
repeat b.n in v:
if used.get(v) == false:
if a.degree(u) == b.degree(v):
if _iso_consistent(a, b, adja, adjb, map, u, v):
map.set(u, v)
used.set(v, true)
if _iso_extend(a, b, adja, adjb, map, used, u + 1): ret true end
map.set(u, GRAPH_NONE)
used.set(v, false)
end
end
end
end
ret false
end
func _iso_consistent(a &: Graph, b &: Graph, adja &: HashMap<i64, bool>, adjb &: HashMap<i64, bool>, map: Vector<int>, u: int, v: int): bool:
repeat u in w:
img := map.get(w)
if _linked(adja, a.n, u, w) != _linked(adjb, b.n, v, img): ret false end
end
ret true
end
func _count_maps(g &: Graph, adj &: HashMap<i64, bool>, map &: Vector<int>, used &: Vector<bool>, u: int): int:
if u >= g.n: ret 1 end
mut total := 0
repeat g.n in v:
if used.get(v) == false:
if g.degree(u) == g.degree(v):
if _iso_consistent(g, g, adj, adj, map, u, v):
map.set(u, v)
used.set(v, true)
total += _count_maps(g, adj, map, used, u + 1)
map.set(u, GRAPH_NONE)
used.set(v, false)
end
end
end
end
ret total
end
func _sorted_copy(seq: Vector<int>): Vector<int>:
mut out := Vector {} as Vector<int>
repeat seq.len() in i: out.push(seq.get(i)) end
mut i := 1
until i < out.len():
x := out.get(i)
mut j := i - 1
until j >= 0:
if out.get(j) >= x: break end
out.set(j + 1, out.get(j))
j--
end
out.set(j + 1, x)
i++
end
ret out
end
func _erdos_gallai(d: Vector<int>, n: int): bool:
mut k := 1
until k <= n:
mut lhs := 0
repeat k in i: lhs += d.get(i) end
mut rhs := k * (k - 1)
mut j := k
until j < n:
mut t := d.get(j)
if t > k: t = k end
rhs += t
j++
end
if lhs > rhs: ret false end
k++
end
ret true
end
func _largest_left(left: Vector<int>, n: int): int:
mut best := GRAPH_NONE
repeat n in i:
if left.get(i) > 0:
if best == GRAPH_NONE: best = i
else left.get(i) > left.get(best): best = i
end
end
end
ret best
end
func _hh_connect(g &: Graph, left &: Vector<int>, u: int, n: int):
need := left.get(u)
left.set(u, 0)
repeat need:
v := _largest_left(left, n)
if v == GRAPH_NONE: ret end
g.add_edge(u, v)
left.set(v, left.get(v) - 1)
end
end
@en "Isomorphic"
@fa "یکریخت"
pub func Isomorphic(a &: Graph, b &: Graph): bool:
if _iso_invariants_match(a, b) == false: ret false end
if a.n == 0: ret true end
mut adja := _iso_adj(a)
defer adja.free()
mut adjb := _iso_adj(b)
defer adjb.free()
mut map := Vector {} as Vector<int>
defer map.free()
mut used := Vector {} as Vector<bool>
defer used.free()
FillInt(map, a.n, GRAPH_NONE)
FillBool(used, b.n, false)
ret _iso_extend(a, b, adja, adjb, map, used, 0)
end
@en "IsomorphismMap"
@fa "نگاشت یکریختی"
pub func IsomorphismMap(a &: Graph, b &: Graph, map &: Vector<int>): bool:
FillInt(map, a.n, GRAPH_NONE)
if _iso_invariants_match(a, b) == false: ret false end
mut adja := _iso_adj(a)
defer adja.free()
mut adjb := _iso_adj(b)
defer adjb.free()
mut used := Vector {} as Vector<bool>
defer used.free()
FillBool(used, b.n, false)
ret _iso_extend(a, b, adja, adjb, map, used, 0)
end
@en "AutomorphismCount"
@fa "شمار خودریختی"
pub func AutomorphismCount(g &: Graph): int:
if g.n == 0: ret 1 end
mut adj := _iso_adj(g)
defer adj.free()
mut map := Vector {} as Vector<int>
defer map.free()
mut used := Vector {} as Vector<bool>
defer used.free()
FillInt(map, g.n, GRAPH_NONE)
FillBool(used, g.n, false)
ret _count_maps(g, adj, map, used, 0)
end
@en "IsGraphical"
@fa "گرافیک است"
pub func IsGraphical(seq: Vector<int>): bool:
mut d := _sorted_copy(seq)
defer d.free()
n := d.len()
mut total := 0
repeat n in i:
if d.get(i) < 0: ret false end
if d.get(i) > n - 1: ret false end
total += d.get(i)
end
if total % 2 == 1: ret false end
ret _erdos_gallai(d, n)
end
@en "HavelHakimi"
@fa "هاول حکیمی"
pub func HavelHakimi(seq: Vector<int>): Graph:
n := seq.len()
mut g := New(n, false)
if IsGraphical(seq) == false: ret g end
mut left := Vector {} as Vector<int>
defer left.free()
repeat n in i: left.push(seq.get(i)) end
repeat n:
u := _largest_left(left, n)
if u == GRAPH_NONE: break end
_hh_connect(g, left, u, n)
end
ret g
end
@en "SameDegreeSequence"
@fa "دنباله درجه یکسان"
pub func SameDegreeSequence(a &: Graph, b &: Graph): bool:
if a.n != b.n: ret false end
mut da := DegreeSequence(a)
defer da.free()
mut db := DegreeSequence(b)
defer db.free()
repeat da.len() in i:
if da.get(i) != db.get(i): ret false end
end
ret true
end
package graph
import math
@en "Matrix"
@fa "ماتریس"
pub struct Matrix:
@en "rows"
@fa "سطرها"
pub rows: int = 0
@en "cols"
@fa "ستون‌ها"
pub cols: int = 0
@en "a"
@fa "درایه‌ها"
pub a: Vector<f64> = Vector {}
@en "at"
@fa "عنصر"
pub func at(i: int, j: int): f64: ret this.a.get(i * this.cols + j) end
@en "set"
@fa "تنظیم"
pub func set(i: int, j: int, v: f64): this.a.set(i * this.cols + j, v) end
@en "add_at"
@fa "افزودن در"
pub func add_at(i: int, j: int, v: f64):
this.a.set(i * this.cols + j, this.a.get(i * this.cols + j) + v)
end
@en "trace"
@fa "رد"
pub func trace(): f64:
mut s := 0.0
mut n := this.rows
if this.cols < n: n = this.cols end
repeat n in i: s += this.at(i, i) end
ret s
end
@en "row_sum"
@fa "مجموع سطر"
pub func row_sum(i: int): f64:
mut s := 0.0
repeat this.cols in j: s += this.at(i, j) end
ret s
end
@en "free"
@fa "آزادسازی"
pub func free(): this.a.free() end
end
@en "IntMatrix"
@fa "ماتریس صحیح"
pub struct IntMatrix:
@en "rows"
@fa "سطرها"
pub rows: int = 0
@en "cols"
@fa "ستون‌ها"
pub cols: int = 0
@en "a"
@fa "درایه‌ها"
pub a: Vector<int> = Vector {}
@en "at"
@fa "عنصر"
pub func at(i: int, j: int): int: ret this.a.get(i * this.cols + j) end
@en "set"
@fa "تنظیم"
pub func set(i: int, j: int, v: int): this.a.set(i * this.cols + j, v) end
@en "free"
@fa "آزادسازی"
pub func free(): this.a.free() end
end
func _matrix_copy(x &: Matrix): Matrix:
mut r := NewMatrix(x.rows, x.cols)
repeat x.rows * x.cols in i: r.a.set(i, x.a.get(i)) end
ret r
end
func _fill_weights(g &: Graph, m &: Matrix):
repeat g.size() in e:
u := g.edge_from(e)
v := g.edge_to(e)
w := g.edge_weight(e)
if w < m.at(u, v): m.set(u, v, w) end
if g.directed == false:
if w < m.at(v, u): m.set(v, u, w) end
end
end
end
func _fill_normalized(g &: Graph, a &: Matrix, m &: Matrix):
repeat g.n in i:
di := g.degree(i) as f64
repeat g.n in j:
dj := g.degree(j) as f64
if di > 0.0:
if i == j: m.set(i, j, 1.0)
else dj > 0.0: m.set(i, j, (0.0 - a.at(i, j)) / math.Sqrt(di * dj))
end
end
end
end
end
func _pivot(m &: Matrix, c: int, n: int): int:
mut best := GRAPH_NONE
mut bv := 0.000000001
mut r := c
until r < n:
v := math.Abs(m.at(r, c))
if v > bv:
bv = v
best = r
end
r++
end
ret best
end
func _swap_rows(m &: Matrix, i: int, j: int, n: int):
repeat n in c:
t := m.at(i, c)
m.set(i, c, m.at(j, c))
m.set(j, c, t)
end
end
func _eliminate(m &: Matrix, c: int, n: int):
mut r := c + 1
until r < n:
f := m.at(r, c) / m.at(c, c)
if f != 0.0:
mut j := c
until j < n:
m.set(r, j, m.at(r, j) - f * m.at(c, j))
j++
end
end
r++
end
end
func _off_diagonal(m &: Matrix, n: int): f64:
mut s := 0.0
repeat n in i:
repeat n in j:
if i != j: s += m.at(i, j) * m.at(i, j) end
end
end
ret s
end
func _jacobi_rotate(m &: Matrix, n: int, p: int, q: int):
apq := m.at(p, q)
if math.Abs(apq) < 1.0e-290: ret end
theta := (m.at(q, q) - m.at(p, p)) / (2.0 * apq)
mut t := 1.0 / (math.Abs(theta) + math.Sqrt(theta * theta + 1.0))
if theta < 0.0: t = 0.0 - t end
c := 1.0 / math.Sqrt(t * t + 1.0)
s := t * c
_apply_rotation(m, n, p, q, c, s)
end
func _apply_rotation(m &: Matrix, n: int, p: int, q: int, c: f64, s: f64):
repeat n in k:
akp := m.at(k, p)
akq := m.at(k, q)
m.set(k, p, c * akp - s * akq)
m.set(k, q, s * akp + c * akq)
end
repeat n in k:
apk := m.at(p, k)
aqk := m.at(q, k)
m.set(p, k, c * apk - s * aqk)
m.set(q, k, s * apk + c * aqk)
end
end
func _jacobi_sweep(m &: Matrix, n: int):
mut p := 0
until p < n - 1:
mut q := p + 1
until q < n:
_jacobi_rotate(m, n, p, q)
q++
end
p++
end
end
func _sort_floats(v &: Vector<f64>):
mut i := 1
until i < v.len():
x := v.get(i)
mut j := i - 1
until j >= 0:
if v.get(j) <= x: break end
v.set(j + 1, v.get(j))
j--
end
v.set(j + 1, x)
i++
end
end
@en "NewMatrix"
@fa "ماتریس جدید"
pub func NewMatrix(rows: int, cols: int): Matrix:
mut m := Matrix {}
m.rows = rows
m.cols = cols
FillFloat(m.a, rows * cols, 0.0)
ret m
end
@en "NewIntMatrix"
@fa "ماتریس صحیح جدید"
pub func NewIntMatrix(rows: int, cols: int, fill: int): IntMatrix:
mut m := IntMatrix {}
m.rows = rows
m.cols = cols
FillInt(m.a, rows * cols, fill)
ret m
end
@en "AdjacencyMatrix"
@fa "ماتریس مجاورت"
pub func AdjacencyMatrix(g &: Graph): Matrix:
mut m := NewMatrix(g.n, g.n)
repeat g.size() in e:
u := g.edge_from(e)
v := g.edge_to(e)
m.add_at(u, v, 1.0)
if g.directed == false:
m.add_at(v, u, 1.0)
end
end
ret m
end
@en "WeightMatrix"
@fa "ماتریس وزن"
pub func WeightMatrix(g &: Graph): Matrix:
mut m := NewMatrix(g.n, g.n)
repeat g.n in i:
repeat g.n in j:
if i == j: m.set(i, j, 0.0)
else:
m.set(i, j, GRAPH_INF)
end
end
end
_fill_weights(g, m)
ret m
end
@en "DegreeMatrix"
@fa "ماتریس درجه"
pub func DegreeMatrix(g &: Graph): Matrix:
mut m := NewMatrix(g.n, g.n)
repeat g.n in u: m.set(u, u, g.degree(u) as f64) end
ret m
end
@en "LaplacianMatrix"
@fa "ماتریس لاپلاس"
pub func LaplacianMatrix(g &: Graph): Matrix:
mut a := AdjacencyMatrix(g)
mut m := NewMatrix(g.n, g.n)
repeat g.n in i:
repeat g.n in j:
if i == j: m.set(i, j, a.row_sum(i) - a.at(i, i))
else:
m.set(i, j, 0.0 - a.at(i, j))
end
end
end
defer a.free()
ret m
end
@en "NormalizedLaplacian"
@fa "لاپلاس بهنجار"
pub func NormalizedLaplacian(g &: Graph): Matrix:
mut a := AdjacencyMatrix(g)
mut m := NewMatrix(g.n, g.n)
_fill_normalized(g, a, m)
defer a.free()
ret m
end
@en "IncidenceMatrix"
@fa "ماتریس وقوع"
pub func IncidenceMatrix(g &: Graph): Matrix:
m := g.size()
mut r := NewMatrix(g.n, m)
repeat m in e:
u := g.edge_from(e)
v := g.edge_to(e)
if g.directed:
r.add_at(u, e, 0.0 - 1.0)
r.add_at(v, e, 1.0)
else:
r.add_at(u, e, 1.0)
r.add_at(v, e, 1.0)
end
end
ret r
end
@en "MatrixMultiply"
@fa "ضرب ماتریس"
pub func MatrixMultiply(x &: Matrix, y &: Matrix): Matrix:
mut r := NewMatrix(x.rows, y.cols)
repeat x.rows in i:
repeat x.cols in k:
v := x.at(i, k)
if v != 0.0:
repeat y.cols in j: r.add_at(i, j, v * y.at(k, j)) end
end
end
end
ret r
end
@en "MatrixIdentity"
@fa "ماتریس همانی"
pub func MatrixIdentity(n: int): Matrix:
mut r := NewMatrix(n, n)
repeat n in i: r.set(i, i, 1.0) end
ret r
end
@en "MatrixPower"
@fa "توان ماتریس"
pub func MatrixPower(x &: Matrix, k: int): Matrix:
mut result := MatrixIdentity(x.rows)
mut base := _matrix_copy(x)
mut e := k
until e > 0:
if e % 2 == 1:
t := MatrixMultiply(result, base)
result.free()
result = t
end
e /= 2
if e > 0:
s := MatrixMultiply(base, base)
base.free()
base = s
end
end
defer base.free()
ret result
end
@en "WalkCount"
@fa "شمار گشت"
pub func WalkCount(g &: Graph, k: int, u: int, v: int): f64:
mut a := AdjacencyMatrix(g)
mut p := MatrixPower(a, k)
r := p.at(u, v)
defer p.free()
defer a.free()
ret r
end
package graph
import math
func _pair_key(n: int, u: int, v: int): i64: ret (u as i64) * (n as i64) + (v as i64) end
func _sort_desc(v &: Vector<int>):
mut i := 1
until i < v.len():
x := v.get(i)
mut j := i - 1
until j >= 0:
if v.get(j) >= x: break end
v.set(j + 1, v.get(j))
j--
end
v.set(j + 1, x)
i++
end
end
func _adjacency_set(g &: Graph): HashMap<i64, bool>:
mut s := HashMap {} as HashMap<i64, bool>
repeat g.size() in e:
u := g.edge_from(e)
v := g.edge_to(e)
if u != v:
s.put(_pair_key(g.n, u, v), true)
s.put(_pair_key(g.n, v, u), true)
end
end
ret s
end
func _distinct_neighbors(g &: Graph, u: int, out &: Vector<int>):
out.clear()
mut seen := HashMap {} as HashMap<i64, bool>
mut k := g.adj_start(u)
stop := g.adj_stop(u)
until k < stop:
v := g.adj_node(k)
if v != u:
if seen.has(v as i64) == false:
seen.put(v as i64, true)
out.push(v)
end
end
k++
end
defer seen.free()
end
func _links_among(adj &: HashMap<i64, bool>, nb: Vector<int>, n: int): int:
mut links := 0
repeat nb.len() in i:
repeat nb.len() in j:
if i < j:
if adj.has(_pair_key(n, nb.get(i), nb.get(j))): links++ end
end
end
end
ret links
end
func _girth_from(g &: Graph, s: int, dist &: Vector<int>, via &: Vector<int>, best: int): int:
FillInt(dist, g.n, GRAPH_NONE)
FillInt(via, g.n, GRAPH_NONE)
mut q := Vector {} as Vector<int>
defer q.free()
mut found := best
dist.set(s, 0)
q.push(s)
mut head := 0
until head < q.len():
u := q.get(head)
head++
if 2 * dist.get(u) < found: found = _girth_scan(g, u, dist, via, q, found) end
end
ret found
end
func _girth_scan(g &: Graph, u: int, dist &: Vector<int>, via &: Vector<int>, q &: Vector<int>, best: int): int:
mut found := best
mut k := g.adj_start(u)
stop := g.adj_stop(u)
until k < stop:
v := g.adj_node(k)
e := g.adj_edge(k)
if e != via.get(u):
if dist.get(v) == GRAPH_NONE:
dist.set(v, dist.get(u) + 1)
via.set(v, e)
q.push(v)
else:
c := dist.get(u) + dist.get(v) + 1
if c < found: found = c end
end
end
k++
end
ret found
end
@en "Density"
@fa "چگالی"
pub func Density(g &: Graph): f64:
if g.n < 2: ret 0.0 end
m := g.size() as f64
n := g.n as f64
if g.directed: ret m / (n * (n - 1.0)) end
ret 2.0 * m / (n * (n - 1.0))
end
@en "AverageDegree"
@fa "میانگین درجه"
pub func AverageDegree(g &: Graph): f64:
if g.n == 0: ret 0.0 end
mut s := 0
repeat g.n in u: s += g.degree(u) end
ret (s as f64) / (g.n as f64)
end
@en "MaxDegree"
@fa "بیشینه درجه"
pub func MaxDegree(g &: Graph): int:
mut b := 0
repeat g.n in u:
if g.degree(u) > b: b = g.degree(u) end
end
ret b
end
@en "MinDegree"
@fa "کمینه درجه"
pub func MinDegree(g &: Graph): int:
if g.n == 0: ret 0 end
mut b := g.degree(0)
repeat g.n in u:
if g.degree(u) < b: b = g.degree(u) end
end
ret b
end
@en "DegreeSequence"
@fa "دنباله درجه"
pub func DegreeSequence(g &: Graph): Vector<int>:
mut out := Vector {} as Vector<int>
repeat g.n in u: out.push(g.degree(u)) end
_sort_desc(out)
ret out
end
@en "DegreeHistogram"
@fa "بافت‌نگار درجه"
pub func DegreeHistogram(g &: Graph): Vector<int>:
mut out := Vector {} as Vector<int>
FillInt(out, MaxDegree(g) + 1, 0)
repeat g.n in u:
d := g.degree(u)
out.set(d, out.get(d) + 1)
end
ret out
end
@en "IsRegular"
@fa "منتظم است"
pub func IsRegular(g &: Graph): bool:
if g.n == 0: ret true end
ret MinDegree(g) == MaxDegree(g)
end
@en "IsComplete"
@fa "کامل است"
pub func IsComplete(g &: Graph): bool:
mut s := Simplify(g)
mut want := g.n * (g.n - 1) / 2
got := s.size()
if g.directed: want = g.n * (g.n - 1) end
defer s.free()
ret got == want
end
@en "Eccentricity"
@fa "برون‌مرکزی"
pub func Eccentricity(g &: Graph, u: int): int:
mut d := BFS(g, u)
defer d.free()
mut best := GRAPH_NONE
repeat g.n in v:
if d.get(v) > best: best = d.get(v) end
end
ret best
end
@en "EccentricityAll"
@fa "همه برون‌مرکزی‌ها"
pub func EccentricityAll(g &: Graph): Vector<int>:
mut out := Vector {} as Vector<int>
repeat g.n in u: out.push(Eccentricity(g, u)) end
ret out
end
@en "Diameter"
@fa "قطر"
pub func Diameter(g &: Graph): int:
mut e := EccentricityAll(g)
defer e.free()
ret MaxInt(e)
end
@en "Radius"
@fa "شعاع"
pub func Radius(g &: Graph): int:
mut e := EccentricityAll(g)
defer e.free()
mut best := GRAPH_NONE
repeat e.len() in u:
if e.get(u) != GRAPH_NONE:
if best == GRAPH_NONE: best = e.get(u)
else e.get(u) < best: best = e.get(u)
end
end
end
ret best
end
@en "Center"
@fa "مرکز"
pub func Center(g &: Graph): Vector<int>:
mut e := EccentricityAll(g)
defer e.free()
r := Radius(g)
mut out := Vector {} as Vector<int>
repeat e.len() in u:
if e.get(u) == r: out.push(u) end
end
ret out
end
@en "Periphery"
@fa "پیرامون"
pub func Periphery(g &: Graph): Vector<int>:
mut e := EccentricityAll(g)
defer e.free()
d := Diameter(g)
mut out := Vector {} as Vector<int>
repeat e.len() in u:
if e.get(u) == d: out.push(u) end
end
ret out
end
@en "AveragePathLength"
@fa "میانگین طول مسیر"
pub func AveragePathLength(g &: Graph): f64:
mut total := 0.0
mut pairs := 0.0
mut d := Vector {} as Vector<int>
defer d.free()
mut p := Vector {} as Vector<int>
defer p.free()
repeat g.n in s:
BFSFrom(g, s, d, p)
repeat g.n in t:
if t != s:
if d.get(t) != GRAPH_NONE:
total += d.get(t) as f64
pairs++
end
end
end
end
if pairs == 0.0: ret 0.0 end
ret total / pairs
end
@en "WienerIndex"
@fa "شاخص وینر"
pub func WienerIndex(g &: Graph): f64:
mut total := 0.0
mut d := Vector {} as Vector<int>
defer d.free()
mut p := Vector {} as Vector<int>
defer p.free()
repeat g.n in s:
BFSFrom(g, s, d, p)
repeat g.n in t:
if t != s:
if d.get(t) != GRAPH_NONE: total += d.get(t) as f64 end
end
end
end
if g.directed: ret total end
ret total / 2.0
end
@en "Girth"
@fa "کمر"
pub func Girth(g &: Graph): int:
cap := g.n + 2
mut best := cap
repeat g.size() in e:
if g.edge_from(e) == g.edge_to(e): ret 1 end
end
mut dist := Vector {} as Vector<int>
defer dist.free()
mut via := Vector {} as Vector<int>
defer via.free()
repeat g.n in s: best = _girth_from(g, s, dist, via, best) end
if best >= cap: ret GRAPH_NONE end
ret best
end
package graph
func _sorted_edges(g &: Graph, order &: Vector<int>, sign: f64):
mut h := MinHeap {}
repeat g.size() in e: h.push(sign * g.edge_weight(e), e) end
order.clear()
until h.is_empty() == false: order.push(h.pop()) end
defer h.free()
end
func _kruskal_run(g &: Graph, chosen &: Vector<int>, sign: f64): f64:
mut order := Vector {} as Vector<int>
defer order.free()
_sorted_edges(g, order, sign)
mut ds := NewDisjointSet(g.n)
defer ds.free()
chosen.clear()
mut total := 0.0
repeat order.len() in i:
e := order.get(i)
if ds.union(g.edge_from(e), g.edge_to(e)):
chosen.push(e)
total += g.edge_weight(e)
end
end
ret total
end
func _prim_scan(g &: Graph, u: int, inside &: Vector<bool>, best &: Vector<f64>, parent &: Vector<int>, h &: MinHeap):
mut k := g.adj_start(u)
stop := g.adj_stop(u)
until k < stop:
v := g.adj_node(k)
w := g.adj_weight(k)
if inside.get(v) == false:
if w < best.get(v):
best.set(v, w)
parent.set(v, u)
h.push(w, v)
end
end
k++
end
end
func _prim_run(g &: Graph, root: int, parent &: Vector<int>): f64:
mut inside := Vector {} as Vector<bool>
defer inside.free()
mut best := Vector {} as Vector<f64>
defer best.free()
FillBool(inside, g.n, false)
FillFloat(best, g.n, GRAPH_INF)
FillInt(parent, g.n, GRAPH_NONE)
if g.n == 0: ret 0.0 end
mut h := MinHeap {}
defer h.free()
mut total := 0.0
best.set(root, 0.0)
h.push(0.0, root)
until h.is_empty() == false:
u := h.pop()
if inside.get(u) == false:
inside.set(u, true)
total += best.get(u)
_prim_scan(g, u, inside, best, parent, h)
end
end
ret total
end
func _boruvka_round(g &: Graph, ds &: DisjointSet, pick &: Vector<int>):
FillInt(pick, g.n, GRAPH_NONE)
repeat g.size() in e:
a := ds.find(g.edge_from(e))
b := ds.find(g.edge_to(e))
if a != b:
_boruvka_offer(g, pick, a, e)
_boruvka_offer(g, pick, b, e)
end
end
end
func _boruvka_offer(g &: Graph, pick &: Vector<int>, comp: int, e: int):
cur := pick.get(comp)
if cur == GRAPH_NONE:
pick.set(comp, e)
ret
end
if g.edge_weight(e) < g.edge_weight(cur):
pick.set(comp, e)
ret
end
if g.edge_weight(e) == g.edge_weight(cur):
if e < cur: pick.set(comp, e) end
end
end
@en "Kruskal"
@fa "کروسکال"
pub func Kruskal(g &: Graph, chosen &: Vector<int>): f64:
ret _kruskal_run(g, chosen, 1.0)
end
@en "MaximumSpanningTree"
@fa "درخت پوشای بیشینه"
pub func MaximumSpanningTree(g &: Graph, chosen &: Vector<int>): f64:
ret _kruskal_run(g, chosen, 0.0 - 1.0)
end
@en "Prim"
@fa "پریم"
pub func Prim(g &: Graph, root: int, parent &: Vector<int>): f64:
if g.directed == false: ret _prim_run(g, root, parent) end
mut u := ToUndirected(g)
t := _prim_run(u, root, parent)
defer u.free()
ret t
end
@en "Boruvka"
@fa "بوروفکا"
pub func Boruvka(g &: Graph, chosen &: Vector<int>): f64:
chosen.clear()
mut ds := NewDisjointSet(g.n)
defer ds.free()
mut pick := Vector {} as Vector<int>
defer pick.free()
mut total := 0.0
mut progress := true
until progress:
progress = false
_boruvka_round(g, ds, pick)
repeat g.n in c:
e := pick.get(c)
if e != GRAPH_NONE:
if ds.union(g.edge_from(e), g.edge_to(e)):
chosen.push(e)
total += g.edge_weight(e)
progress = true
end
end
end
end
ret total
end
@en "MSTWeight"
@fa "وزن درخت پوشا"
pub func MSTWeight(g &: Graph): f64:
mut chosen := Vector {} as Vector<int>
defer chosen.free()
ret Kruskal(g, chosen)
end
@en "MinimumSpanningTree"
@fa "درخت پوشای کمینه"
pub func MinimumSpanningTree(g &: Graph): Graph:
mut chosen := Vector {} as Vector<int>
defer chosen.free()
Kruskal(g, chosen)
mut h := New(g.n, false)
repeat chosen.len() in i:
e := chosen.get(i)
h.add_weighted(g.edge_from(e), g.edge_to(e), g.edge_weight(e))
end
ret h
end
@en "SpanningAgreement"
@fa "توافق پوشا"
pub func SpanningAgreement(g &: Graph): bool:
mut a := Vector {} as Vector<int>
defer a.free()
mut b := Vector {} as Vector<int>
defer b.free()
mut p := Vector {} as Vector<int>
defer p.free()
ka := Kruskal(g, a)
kb := Boruvka(g, b)
if IsClose(ka, kb) == false: ret false end
if IsConnected(g) == false: ret true end
pr := Prim(g, 0, p)
ret IsClose(ka, pr)
end
package graph
import str
func _key(n: int, u: int, v: int): i64: ret (u as i64) * (n as i64) + (v as i64) end
func _kept(keep: Vector<bool>, i: int): bool:
if i >= keep.len(): ret false end
ret keep.get(i)
end
func _copy_names(src &: Graph, dst &: Graph, shift: int):
repeat src.names.len() in u:
s := src.name(u)
if str.Len(s) > 0: dst.set_name(u + shift, s) end
end
end
func _append_edges(src &: Graph, dst &: Graph, shift: int):
repeat src.size() in e:
dst.add_weighted(src.edge_from(e) + shift, src.edge_to(e) + shift, src.edge_weight(e))
end
end
func _fill_sub(g &: Graph, h &: Graph, map: Vector<int>):
repeat g.size() in e:
a := map.get(g.edge_from(e))
b := map.get(g.edge_to(e))
if a != GRAPH_NONE:
if b != GRAPH_NONE: h.add_weighted(a, b, g.edge_weight(e)) end
end
end
end
func _fill_complement(g &: Graph, h &: Graph, seen &: HashMap<i64, bool>):
repeat g.n in u:
repeat g.n in v:
if u != v:
if seen.has(_key(g.n, u, v)) == false:
if g.directed: h.add_edge(u, v)
else v > u: h.add_edge(u, v)
end
end
end
end
end
end
func _link_incident(g &: Graph, h &: Graph, seen &: HashMap<i64, bool>, u: int, m: int):
start := g.adj_start(u)
stop := g.adj_stop(u)
mut i := start
until i < stop:
mut j := i + 1
until j < stop:
a := g.adj_edge(i)
b := g.adj_edge(j)
if a != b:
mut lo := a
mut hi := b
if lo > hi:
lo = b
hi = a
end
k := _key(m, lo, hi)
if seen.has(k) == false:
seen.put(k, true)
h.add_edge(lo, hi)
end
end
j++
end
i++
end
end
func _collect_best(g &: Graph, best &: HashMap<i64, f64>, order &: Vector<i64>):
repeat g.size() in e:
u := g.edge_from(e)
v := g.edge_to(e)
if u != v:
mut a := u
mut b := v
if g.directed == false:
if a > b:
a = v
b = u
end
end
k := _key(g.n, a, b)
w := g.edge_weight(e)
if best.has(k):
if w < best.get(k): best.put(k, w) end
else:
best.put(k, w)
order.push(k)
end
end
end
end
@en "Clone"
@fa "همانندسازی"
pub func Clone(g &: Graph): Graph:
mut h := New(g.n, g.directed)
m := g.size()
repeat m in e:
h.add_weighted(g.edge_from(e), g.edge_to(e), g.edge_weight(e))
end
_copy_names(g, h, 0)
ret h
end
@en "Transpose"
@fa "ترانهاده"
pub func Transpose(g &: Graph): Graph:
mut h := New(g.n, g.directed)
m := g.size()
repeat m in e:
h.add_weighted(g.edge_to(e), g.edge_from(e), g.edge_weight(e))
end
_copy_names(g, h, 0)
ret h
end
@en "Reverse"
@fa "برعکس"
pub func Reverse(g &: Graph): Graph: ret Transpose(g) end
@en "ToUndirected"
@fa "به بی‌جهت"
pub func ToUndirected(g &: Graph): Graph:
mut h := New(g.n, false)
m := g.size()
repeat m in e:
h.add_weighted(g.edge_from(e), g.edge_to(e), g.edge_weight(e))
end
_copy_names(g, h, 0)
ret h
end
@en "ToDirected"
@fa "به جهت‌دار"
pub func ToDirected(g &: Graph): Graph:
mut h := New(g.n, true)
m := g.size()
repeat m in e:
u := g.edge_from(e)
v := g.edge_to(e)
w := g.edge_weight(e)
h.add_weighted(u, v, w)
if u != v: h.add_weighted(v, u, w) end
end
_copy_names(g, h, 0)
ret h
end
@en "SubgraphMap"
@fa "زیرگراف با نگاشت"
pub func SubgraphMap(g &: Graph, keep: Vector<bool>, map &: Vector<int>): Graph:
map.clear()
mut k := 0
repeat g.n in u:
if _kept(keep, u):
map.push(k)
k++
else:
map.push(GRAPH_NONE)
end
end
mut h := New(k, g.directed)
_fill_sub(g, h, map)
repeat g.n in u:
if map.get(u) != GRAPH_NONE: h.set_name(map.get(u), g.name(u)) end
end
ret h
end
@en "Subgraph"
@fa "زیرگراف"
pub func Subgraph(g &: Graph, keep: Vector<bool>): Graph:
mut map := Vector {} as Vector<int>
defer map.free()
ret SubgraphMap(g, keep, map)
end
@en "EdgeSubgraph"
@fa "زیرگراف یالی"
pub func EdgeSubgraph(g &: Graph, keep: Vector<bool>): Graph:
mut h := New(g.n, g.directed)
m := g.size()
repeat m in e:
if _kept(keep, e): h.add_weighted(g.edge_from(e), g.edge_to(e), g.edge_weight(e)) end
end
_copy_names(g, h, 0)
ret h
end
@en "Complement"
@fa "مکمل"
pub func Complement(g &: Graph): Graph:
mut h := New(g.n, g.directed)
mut seen := HashMap {} as HashMap<i64, bool>
defer seen.free()
m := g.size()
repeat m in e:
seen.put(_key(g.n, g.edge_from(e), g.edge_to(e)), true)
if g.directed == false: seen.put(_key(g.n, g.edge_to(e), g.edge_from(e)), true) end
end
_fill_complement(g, h, seen)
_copy_names(g, h, 0)
ret h
end
@en "Union"
@fa "اجتماع"
pub func Union(a &: Graph, b &: Graph): Graph:
mut n := a.n
if b.n > n: n = b.n end
mut h := New(n, a.directed)
_append_edges(a, h, 0)
_append_edges(b, h, 0)
_copy_names(a, h, 0)
ret h
end
@en "DisjointUnion"
@fa "اجتماع مجزا"
pub func DisjointUnion(a &: Graph, b &: Graph): Graph:
mut h := New(a.n + b.n, a.directed)
_append_edges(a, h, 0)
_append_edges(b, h, a.n)
_copy_names(a, h, 0)
_copy_names(b, h, a.n)
ret h
end
@en "Intersection"
@fa "اشتراک"
pub func Intersection(a &: Graph, b &: Graph): Graph:
mut n := a.n
if b.n > n: n = b.n end
mut h := New(n, a.directed)
mut seen := HashMap {} as HashMap<i64, bool>
defer seen.free()
m := a.size()
repeat m in e:
u := a.edge_from(e)
v := a.edge_to(e)
k := _key(n, u, v)
if seen.has(k) == false:
if b.has_edge(u, v):
seen.put(k, true)
h.add_weighted(u, v, a.edge_weight(e))
end
end
end
ret h
end
@en "LineGraph"
@fa "گراف یالی"
pub func LineGraph(g &: Graph): Graph:
m := g.size()
mut h := New(m, false)
mut seen := HashMap {} as HashMap<i64, bool>
defer seen.free()
repeat g.n in u:
_link_incident(g, h, seen, u, m)
end
ret h
end
@en "Simplify"
@fa "ساده‌سازی"
pub func Simplify(g &: Graph): Graph:
mut h := New(g.n, g.directed)
mut best := HashMap {} as HashMap<i64, f64>
defer best.free()
mut order := Vector {} as Vector<i64>
defer order.free()
_collect_best(g, best, order)
repeat order.len() in i:
k := order.get(i)
h.add_weighted((k / (g.n as i64)) as int, (k % (g.n as i64)) as int, best.get(k))
end
_copy_names(g, h, 0)
ret h
end
@en "RemoveSelfLoops"
@fa "حذف طوقه‌ها"
pub func RemoveSelfLoops(g &: Graph): Graph:
mut h := New(g.n, g.directed)
m := g.size()
repeat m in e:
if g.edge_from(e) != g.edge_to(e):
h.add_weighted(g.edge_from(e), g.edge_to(e), g.edge_weight(e))
end
end
_copy_names(g, h, 0)
ret h
end
@en "SelfLoopCount"
@fa "شمار طوقه"
pub func SelfLoopCount(g &: Graph): int:
mut c := 0
repeat g.size() in e:
if g.edge_from(e) == g.edge_to(e): c++ end
end
ret c
end
@en "HasSelfLoop"
@fa "دارای طوقه"
pub func HasSelfLoop(g &: Graph): bool: ret SelfLoopCount(g) > 0 end
@en "ParallelEdgeCount"
@fa "شمار یال موازی"
pub func ParallelEdgeCount(g &: Graph): int:
mut seen := HashMap {} as HashMap<i64, bool>
defer seen.free()
mut c := 0
repeat g.size() in e:
u := g.edge_from(e)
v := g.edge_to(e)
k := _key(g.n, u, v)
if seen.has(k): c++
else:
seen.put(k, true)
end
if g.directed == false: seen.put(_key(g.n, v, u), true) end
end
ret c
end
@en "IsSimple"
@fa "ساده است"
pub func IsSimple(g &: Graph): bool:
if HasSelfLoop(g): ret false end
ret ParallelEdgeCount(g) == 0
end
@en "TotalWeight"
@fa "وزن کل"
pub func TotalWeight(g &: Graph): f64:
mut s := 0.0
repeat g.size() in e: s += g.edge_weight(e) end
ret s
end
package graph
func _has_negative(g &: Graph): bool:
repeat g.size() in e:
if g.edge_weight(e) < 0.0: ret true end
end
ret false
end
func _relax_heap(g &: Graph, u: int, d: f64, dist &: Vector<f64>, parent &: Vector<int>, h &: MinHeap):
mut k := g.adj_start(u)
stop := g.adj_stop(u)
until k < stop:
v := g.adj_node(k)
new_dist := d + g.adj_weight(k)
if new_dist < dist.get(v):
dist.set(v, new_dist)
parent.set(v, u)
h.push(new_dist, v)
end
k++
end
end
func _relax_astar(g &: Graph, u: int, dist &: Vector<f64>, parent &: Vector<int>, h &: MinHeap, hs: Vector<f64>):
mut k := g.adj_start(u)
stop := g.adj_stop(u)
until k < stop:
v := g.adj_node(k)
new_dist := dist.get(u) + g.adj_weight(k)
if new_dist < dist.get(v):
dist.set(v, new_dist)
parent.set(v, u)
h.push(new_dist + hs.get(v), v)
end
k++
end
end
func _bf_pass(g &: Graph, dist &: Vector<f64>, parent &: Vector<int>): bool:
mut changed := false
repeat g.size() in e:
u := g.edge_from(e)
v := g.edge_to(e)
w := g.edge_weight(e)
if _bf_edge(u, v, w, dist, parent): changed = true end
if g.directed == false:
if _bf_edge(v, u, w, dist, parent): changed = true end
end
end
ret changed
end
func _bf_edge(u: int, v: int, w: f64, dist &: Vector<f64>, parent &: Vector<int>): bool:
if dist.get(u) >= GRAPH_INF: ret false end
new_dist := dist.get(u) + w
if new_dist < dist.get(v):
dist.set(v, new_dist)
parent.set(v, u)
ret true
end
ret false
end
func _cycle_at(parent: Vector<int>, start: int, n: int): Vector<int>:
mut c := start
repeat n: c = parent.get(c) end
mut out := Vector {} as Vector<int>
mut seen := Vector {} as Vector<bool>
FillBool(seen, parent.len(), false)
mut x := c
until seen.get(x) == false:
seen.set(x, true)
x = parent.get(x)
end
mut y := x
until true:
out.push(y)
y = parent.get(y)
if y == x: break end
end
defer seen.free()
ReverseInt(out)
ret out
end
func _deque_pop_front(front &: Vector<int>, back &: Vector<int>): int:
if front.len() == 0:
mut i := back.len() - 1
until i >= 0:
front.push(back.get(i))
i--
end
back.clear()
end
ret front.pop()
end
func _reweight(g &: Graph, pot: Vector<f64>): Graph:
mut h := New(g.n, true)
repeat g.size() in e:
u := g.edge_from(e)
v := g.edge_to(e)
w := g.edge_weight(e)
h.add_weighted(u, v, w + pot.get(u) - pot.get(v))
if g.directed == false:
h.add_weighted(v, u, w + pot.get(v) - pot.get(u))
end
end
ret h
end
func _bf_mark(g &: Graph, dist &: Vector<f64>, parent &: Vector<int>): int:
mut last := GRAPH_NONE
repeat g.size() in e:
u := g.edge_from(e)
v := g.edge_to(e)
w := g.edge_weight(e)
if _bf_edge(u, v, w, dist, parent): last = v end
if g.directed == false:
if _bf_edge(v, u, w, dist, parent): last = u end
end
end
ret last
end
func _zero_one_ok(g &: Graph): bool:
repeat g.size() in e:
w := g.edge_weight(e)
if w != 0.0:
if w != 1.0: ret false end
end
end
ret true
end
func _relax_zero_one(g &: Graph, u: int, dist &: Vector<f64>, parent &: Vector<int>, front &: Vector<int>, back &: Vector<int>):
mut k := g.adj_start(u)
stop := g.adj_stop(u)
until k < stop:
v := g.adj_node(k)
w := g.adj_weight(k)
new_dist := dist.get(u) + w
if new_dist < dist.get(v):
dist.set(v, new_dist)
parent.set(v, u)
if w == 0.0: front.push(v)
else:
back.push(v)
end
end
k++
end
end
func _init_next(g &: Graph, d &: Matrix, next &: IntMatrix):
repeat g.n in i:
repeat g.n in j:
if d.at(i, j) < GRAPH_INF: next.set(i, j, j) end
end
end
end
func _fw_row(d &: Matrix, next &: IntMatrix, i: int, k: int, n: int):
dik := d.at(i, k)
repeat n in j:
if d.at(k, j) < GRAPH_INF:
new_dist := dik + d.at(k, j)
if new_dist < d.at(i, j):
d.set(i, j, new_dist)
next.set(i, j, next.at(i, k))
end
end
end
end
func _all_inf(out &: Matrix, n: int): Matrix:
repeat n in i:
repeat n in j: out.set(i, j, GRAPH_INF) end
end
ret out
end
func _johnson_rows(g &: Graph, pot: Vector<f64>, out &: Matrix):
mut r := _reweight(g, pot)
mut dist := Vector {} as Vector<f64>
mut parent := Vector {} as Vector<int>
repeat g.n in s:
Dijkstra(r, s, dist, parent)
_johnson_row(pot, dist, out, s, g.n)
end
defer dist.free()
defer parent.free()
defer r.free()
end
func _johnson_row(pot: Vector<f64>, dist: Vector<f64>, out &: Matrix, s: int, n: int):
repeat n in t:
d := dist.get(t)
if d >= GRAPH_INF: out.set(s, t, GRAPH_INF)
else:
out.set(s, t, d - pot.get(s) + pot.get(t))
end
end
end
func _push_successors(g &: Graph, u: int, d: f64, h &: MinHeap):
mut k := g.adj_start(u)
stop := g.adj_stop(u)
until k < stop:
h.push(d + g.adj_weight(k), g.adj_node(k))
k++
end
end
@en "Dijkstra"
@fa "دایکسترا"
pub func Dijkstra(g &: Graph, src: int, dist &: Vector<f64>, parent &: Vector<int>): bool:
FillFloat(dist, g.n, GRAPH_INF)
FillInt(parent, g.n, GRAPH_NONE)
if src < 0: ret false end
if src >= g.n: ret false end
if _has_negative(g): ret false end
mut h := MinHeap {}
defer h.free()
dist.set(src, 0.0)
h.push(0.0, src)
until h.is_empty() == false:
d := h.top_key()
u := h.pop()
if d <= dist.get(u): _relax_heap(g, u, d, dist, parent, h) end
end
ret true
end
@en "DijkstraDist"
@fa "فاصله دایکسترا"
pub func DijkstraDist(g &: Graph, src: int): Vector<f64>:
mut dist := Vector {} as Vector<f64>
mut parent := Vector {} as Vector<int>
defer parent.free()
Dijkstra(g, src, dist, parent)
ret dist
end
@en "ShortestPath"
@fa "کوتاه‌ترین مسیر"
pub func ShortestPath(g &: Graph, s: int, t: int): Vector<int>:
mut dist := Vector {} as Vector<f64>
defer dist.free()
mut parent := Vector {} as Vector<int>
defer parent.free()
if _has_negative(g): BellmanFord(g, s, dist, parent)
else:
Dijkstra(g, s, dist, parent)
end
ret PathFromParents(parent, s, t)
end
@en "ShortestPathLength"
@fa "طول کوتاه‌ترین مسیر"
pub func ShortestPathLength(g &: Graph, s: int, t: int): f64:
mut dist := Vector {} as Vector<f64>
defer dist.free()
mut parent := Vector {} as Vector<int>
defer parent.free()
if _has_negative(g): BellmanFord(g, s, dist, parent)
else:
Dijkstra(g, s, dist, parent)
end
if t < 0: ret GRAPH_INF end
if t >= g.n: ret GRAPH_INF end
ret dist.get(t)
end
@en "BellmanFord"
@fa "بلمن فورد"
pub func BellmanFord(g &: Graph, src: int, dist &: Vector<f64>, parent &: Vector<int>): bool:
FillFloat(dist, g.n, GRAPH_INF)
FillInt(parent, g.n, GRAPH_NONE)
if src < 0: ret false end
if src >= g.n: ret false end
dist.set(src, 0.0)
mut round := 0
until round < g.n - 1:
if _bf_pass(g, dist, parent) == false: ret true end
round++
end
ret _bf_pass(g, dist, parent) == false
end
@en "FindNegativeCycle"
@fa "یافتن دور منفی"
pub func FindNegativeCycle(g &: Graph): Vector<int>:
mut dist := Vector {} as Vector<f64>
defer dist.free()
mut parent := Vector {} as Vector<int>
defer parent.free()
FillFloat(dist, g.n, 0.0)
FillInt(parent, g.n, GRAPH_NONE)
mut round := 0
mut last := GRAPH_NONE
until round < g.n:
last = _bf_mark(g, dist, parent)
if last == GRAPH_NONE: break end
round++
end
if last == GRAPH_NONE: ret Vector {} end
ret _cycle_at(parent, last, g.n)
end
@en "HasNegativeCycle"
@fa "دارای دور منفی"
pub func HasNegativeCycle(g &: Graph): bool:
mut c := FindNegativeCycle(g)
defer c.free()
ret c.len() > 0
end
@en "ZeroOneBFS"
@fa "پیمایش صفر یک"
pub func ZeroOneBFS(g &: Graph, src: int, dist &: Vector<f64>, parent &: Vector<int>): bool:
FillFloat(dist, g.n, GRAPH_INF)
FillInt(parent, g.n, GRAPH_NONE)
if _zero_one_ok(g) == false: ret false end
if src < 0: ret false end
if src >= g.n: ret false end
mut front := Vector {} as Vector<int>
defer front.free()
mut back := Vector {} as Vector<int>
defer back.free()
dist.set(src, 0.0)
front.push(src)
until front.len() + back.len() > 0:
u := _deque_pop_front(front, back)
_relax_zero_one(g, u, dist, parent, front, back)
end
ret true
end
package graph
import math
@en "Determinant"
@fa "دترمینان"
pub func Determinant(x &: Matrix): f64:
n := x.rows
mut m := _matrix_copy(x)
mut det := 1.0
repeat n in c:
p := _pivot(m, c, n)
if p == GRAPH_NONE:
m.free()
ret 0.0
end
if p != c:
_swap_rows(m, p, c, n)
det = 0.0 - det
end
det *= m.at(c, c)
_eliminate(m, c, n)
end
defer m.free()
ret det
end
@en "SpanningTreeCount"
@fa "شمار درخت پوشا"
pub func SpanningTreeCount(g &: Graph): f64:
if g.n == 0: ret 0.0 end
if g.n == 1: ret 1.0 end
mut u := ToUndirected(g)
mut l := LaplacianMatrix(u)
mut minor := NewMatrix(g.n - 1, g.n - 1)
repeat g.n - 1 in i:
repeat g.n - 1 in j: minor.set(i, j, l.at(i + 1, j + 1)) end
end
d := Determinant(minor)
defer minor.free()
defer l.free()
defer u.free()
ret math.Round(d)
end
@en "SymmetricEigenvalues"
@fa "مقادیر ویژه متقارن"
pub func SymmetricEigenvalues(x &: Matrix): Vector<f64>:
n := x.rows
mut m := _matrix_copy(x)
mut sweep := 0
until sweep < 60:
off := _off_diagonal(m, n)
if off < 0.000000000001: break end
_jacobi_sweep(m, n)
sweep++
end
mut out := Vector {} as Vector<f64>
repeat n in i: out.push(m.at(i, i)) end
defer m.free()
_sort_floats(out)
ret out
end
@en "AdjacencySpectrum"
@fa "طیف مجاورت"
pub func AdjacencySpectrum(g &: Graph): Vector<f64>:
mut a := AdjacencyMatrix(g)
s := SymmetricEigenvalues(a)
defer a.free()
ret s
end
@en "LaplacianSpectrum"
@fa "طیف لاپلاس"
pub func LaplacianSpectrum(g &: Graph): Vector<f64>:
mut u := ToUndirected(g)
mut l := LaplacianMatrix(u)
s := SymmetricEigenvalues(l)
defer l.free()
defer u.free()
ret s
end
@en "SpectralRadius"
@fa "شعاع طیفی"
pub func SpectralRadius(g &: Graph): f64:
mut s := AdjacencySpectrum(g)
mut best := 0.0
repeat s.len() in i:
v := math.Abs(s.get(i))
if v > best: best = v end
end
defer s.free()
ret best
end
@en "AlgebraicConnectivity"
@fa "همبندی جبری"
pub func AlgebraicConnectivity(g &: Graph): f64:
if g.n < 2: ret 0.0 end
mut s := LaplacianSpectrum(g)
v := s.get(1)
defer s.free()
if v < 0.0: ret 0.0 end
ret v
end
package graph
func _odd_count(g &: Graph): int:
mut c := 0
repeat g.n in u:
if g.degree(u) % 2 == 1: c++ end
end
ret c
end
func _edges_connected(g &: Graph): bool:
mut start := GRAPH_NONE
repeat g.n in u:
if g.degree(u) > 0:
if start == GRAPH_NONE: start = u end
end
end
if start == GRAPH_NONE: ret true end
mut r := Reachable(g, start)
defer r.free()
mut ok := true
repeat g.n in u:
if g.degree(u) > 0:
if r.get(u) == false: ok = false end
end
end
ret ok
end
func _balanced(g &: Graph): bool:
repeat g.n in u:
if g.in_degree(u) != g.out_degree(u): ret false end
end
ret true
end
func _hierholzer(g &: Graph, start: int): Vector<int>:
mut used := Vector {} as Vector<bool>
defer used.free()
mut iter := Vector {} as Vector<int>
defer iter.free()
mut stack := Vector {} as Vector<int>
defer stack.free()
mut out := Vector {} as Vector<int>
FillBool(used, g.size(), false)
FillInt(iter, g.n, 0)
repeat g.n in u: iter.set(u, g.adj_start(u)) end
stack.push(start)
until stack.len() > 0:
u := stack.last()
e := _next_unused(g, u, used, iter)
if e == GRAPH_NONE:
out.push(u)
stack.pop()
else:
used.set(g.adj_edge(e), true)
stack.push(g.adj_node(e))
end
end
ReverseInt(out)
ret out
end
func _next_unused(g &: Graph, u: int, used &: Vector<bool>, iter &: Vector<int>): int:
mut k := iter.get(u)
stop := g.adj_stop(u)
until k < stop:
if used.get(g.adj_edge(k)) == false:
iter.set(u, k)
ret k
end
k++
iter.set(u, k)
end
ret GRAPH_NONE
end
func _euler_start(g &: Graph): int:
if g.directed: ret _euler_start_directed(g) end
mut odd := GRAPH_NONE
mut any := GRAPH_NONE
repeat g.n in u:
if g.degree(u) > 0:
if any == GRAPH_NONE: any = u end
if g.degree(u) % 2 == 1:
if odd == GRAPH_NONE: odd = u end
end
end
end
if odd != GRAPH_NONE: ret odd end
ret any
end
func _euler_start_directed(g &: Graph): int:
mut any := GRAPH_NONE
repeat g.n in u:
if g.out_degree(u) > 0:
if any == GRAPH_NONE: any = u end
if g.out_degree(u) - g.in_degree(u) == 1: ret u end
end
end
ret any
end
func _ham_extend(g &: Graph, path &: Vector<int>, onpath &: Vector<bool>, want_cycle: bool): bool:
if path.len() == g.n: ret _ham_finish(g, path, want_cycle) end
u := path.last()
mut k := g.adj_start(u)
stop := g.adj_stop(u)
until k < stop:
v := g.adj_node(k)
if onpath.get(v) == false:
onpath.set(v, true)
path.push(v)
if _ham_extend(g, path, onpath, want_cycle): ret true end
path.pop()
onpath.set(v, false)
end
k++
end
ret false
end
func _ham_finish(g &: Graph, path &: Vector<int>, want_cycle: bool): bool:
if want_cycle == false: ret true end
ret g.has_edge(path.last(), path.get(0))
end
func _nn_tour(g &: Graph, w &: Matrix, start: int): Vector<int>:
mut seen := Vector {} as Vector<bool>
defer seen.free()
FillBool(seen, g.n, false)
mut tour := Vector {} as Vector<int>
mut cur := start
seen.set(cur, true)
tour.push(cur)
repeat g.n - 1:
nxt := _nearest(w, cur, seen, g.n)
if nxt == GRAPH_NONE: break end
seen.set(nxt, true)
tour.push(nxt)
cur = nxt
end
ret tour
end
func _nearest(w &: Matrix, cur: int, seen: Vector<bool>, n: int): int:
mut best := GRAPH_NONE
repeat n in v:
if seen.get(v) == false:
if w.at(cur, v) < GRAPH_INF:
if best == GRAPH_NONE: best = v
else w.at(cur, v) < w.at(cur, best): best = v
end
end
end
end
ret best
end
func _two_opt_pass(w &: Matrix, tour &: Vector<int>): bool:
n := tour.len()
mut improved := false
mut i := 0
until i < n - 2:
mut j := i + 2
until j < n:
if _two_opt_gain(w, tour, i, j, n) < 0.0:
_reverse_span(tour, i + 1, j)
improved = true
end
j++
end
i++
end
ret improved
end
func _two_opt_gain(w &: Matrix, tour: Vector<int>, i: int, j: int, n: int): f64:
a := tour.get(i)
b := tour.get(i + 1)
c := tour.get(j)
d := tour.get((j + 1) % n)
if a == d: ret 0.0 end
before := w.at(a, b) + w.at(c, d)
after := w.at(a, c) + w.at(b, d)
if before >= GRAPH_INF: ret 0.0 end
if after >= GRAPH_INF: ret 0.0 end
ret after - before
end
func _reverse_span(tour &: Vector<int>, lo: int, hi: int):
mut i := lo
mut j := hi
until i < j:
a := tour.get(i)
b := tour.get(j)
tour.set(i, b)
tour.set(j, a)
i++
j--
end
end
func _directed_path_ok(g &: Graph): bool:
mut extra_out := 0
mut extra_in := 0
repeat g.n in u:
d := g.out_degree(u) - g.in_degree(u)
if d == 1: extra_out++
else d == 0 - 1: extra_in++
else d != 0: ret false
end
end
if extra_out == 0:
ret extra_in == 0
end
if extra_out != 1: ret false end
ret extra_in == 1
end
func _ham_search(g &: Graph, want_cycle: bool): Vector<int>:
mut path := Vector {} as Vector<int>
mut onpath := Vector {} as Vector<bool>
defer onpath.free()
if g.n == 0: ret path end
mut start := 0
until start < g.n:
FillBool(onpath, g.n, false)
path.clear()
onpath.set(start, true)
path.push(start)
if _ham_extend(g, path, onpath, want_cycle): ret path end
if want_cycle: break end
start++
end
path.clear()
ret path
end
@en "HasEulerianCircuit"
@fa "دارای دور اویلری"
pub func HasEulerianCircuit(g &: Graph): bool:
if g.size() == 0: ret true end
if _edges_connected(g) == false: ret false end
if g.directed: ret _balanced(g) end
ret _odd_count(g) == 0
end
@en "HasEulerianPath"
@fa "دارای مسیر اویلری"
pub func HasEulerianPath(g &: Graph): bool:
if g.size() == 0: ret true end
if _edges_connected(g) == false: ret false end
if g.directed: ret _directed_path_ok(g) end
odd := _odd_count(g)
if odd == 0: ret true end
ret odd == 2
end
@en "EulerianCircuit"
@fa "دور اویلری"
pub func EulerianCircuit(g &: Graph): Vector<int>:
mut out := Vector {} as Vector<int>
if HasEulerianCircuit(g) == false: ret out end
if g.size() == 0: ret out end
defer out.free()
ret _hierholzer(g, _euler_start(g))
end
@en "EulerianPath"
@fa "مسیر اویلری"
pub func EulerianPath(g &: Graph): Vector<int>:
mut out := Vector {} as Vector<int>
if HasEulerianPath(g) == false: ret out end
if g.size() == 0: ret out end
defer out.free()
ret _hierholzer(g, _euler_start(g))
end
@en "HamiltonianPath"
@fa "مسیر همیلتونی"
pub func HamiltonianPath(g &: Graph): Vector<int>:
ret _ham_search(g, false)
end
@en "HamiltonianCycle"
@fa "دور همیلتونی"
pub func HamiltonianCycle(g &: Graph): Vector<int>:
ret _ham_search(g, true)
end
@en "HasHamiltonianCycle"
@fa "دارای دور همیلتونی"
pub func HasHamiltonianCycle(g &: Graph): bool:
mut c := HamiltonianCycle(g)
defer c.free()
ret c.len() > 0
end
@en "TourLength"
@fa "طول تور"
pub func TourLength(g &: Graph, tour: Vector<int>): f64:
if tour.len() < 2: ret 0.0 end
mut w := WeightMatrix(g)
mut total := 0.0
repeat tour.len() in i:
a := tour.get(i)
b := tour.get((i + 1) % tour.len())
total += w.at(a, b)
end
defer w.free()
if total >= GRAPH_INF: ret GRAPH_INF end
ret total
end
@en "TSPNearestNeighbor"
@fa "نزدیک‌ترین همسایه"
pub func TSPNearestNeighbor(g &: Graph, start: int): Vector<int>:
mut w := WeightMatrix(g)
tour := _nn_tour(g, w, start)
defer w.free()
ret tour
end
@en "TSPTwoOpt"
@fa "دوبهینه"
pub func TSPTwoOpt(g &: Graph, tour &: Vector<int>): f64:
mut w := WeightMatrix(g)
mut rounds := 0
until rounds < 1000:
if _two_opt_pass(w, tour) == false: break end
rounds++
end
defer w.free()
ret TourLength(g, tour)
end
@en "TSPHeuristic"
@fa "ابتکاری فروشنده دوره‌گرد"
pub func TSPHeuristic(g &: Graph, start: int): Vector<int>:
mut tour := TSPNearestNeighbor(g, start)
TSPTwoOpt(g, tour)
ret tour
end
package graph
func _visit_out(g &: Graph, u: int, id: int, comp &: Vector<int>, q &: Vector<int>):
mut k := g.adj_start(u)
stop := g.adj_stop(u)
until k < stop:
v := g.adj_node(k)
if comp.get(v) == GRAPH_NONE:
comp.set(v, id)
q.push(v)
end
k++
end
end
func _visit_in(g &: Graph, u: int, id: int, comp &: Vector<int>, q &: Vector<int>):
mut k := g.in_start(u)
stop := g.in_stop(u)
until k < stop:
v := g.in_node(k)
if comp.get(v) == GRAPH_NONE:
comp.set(v, id)
q.push(v)
end
k++
end
end
func _comp_bfs(g &: Graph, s: int, id: int, comp &: Vector<int>):
mut q := Vector {} as Vector<int>
defer q.free()
q.push(s)
comp.set(s, id)
mut head := 0
until head < q.len():
u := q.get(head)
head++
_visit_out(g, u, id, comp, q)
if g.directed: _visit_in(g, u, id, comp, q) end
end
end
func _dfs_walk(g &: Graph, src: int, pre &: Vector<int>, post &: Vector<int>, seen &: Vector<bool>):
if seen.get(src): ret end
mut stack := Vector {} as Vector<int>
defer stack.free()
mut it := Vector {} as Vector<int>
defer it.free()
seen.set(src, true)
pre.push(src)
stack.push(src)
it.push(g.adj_start(src))
until stack.len() > 0:
u := stack.last()
k := it.last()
if k < g.adj_stop(u):
it.set(it.len() - 1, k + 1)
v := g.adj_node(k)
if seen.get(v) == false:
seen.set(v, true)
pre.push(v)
stack.push(v)
it.push(g.adj_start(v))
end
else:
post.push(u)
stack.pop()
it.pop()
end
end
end
func _color_bfs(g &: Graph, s: int, color &: Vector<int>): bool:
mut q := Vector {} as Vector<int>
defer q.free()
mut ok := true
color.set(s, 0)
q.push(s)
mut head := 0
until head < q.len():
u := q.get(head)
head++
if _color_step(g, u, color, q) == false: ok = false end
end
ret ok
end
func _color_step(g &: Graph, u: int, color &: Vector<int>, q &: Vector<int>): bool:
mut ok := true
mut k := g.adj_start(u)
stop := g.adj_stop(u)
until k < stop:
v := g.adj_node(k)
if color.get(v) == GRAPH_NONE:
color.set(v, 1 - color.get(u))
q.push(v)
else color.get(v) == color.get(u):
ok = false
end
k++
end
ret ok
end
func _stack_index(stack: Vector<int>, v: int): int:
mut i := stack.len() - 1
until i >= 0:
if stack.get(i) == v: ret i end
i--
end
ret GRAPH_NONE
end
func _cycle_from(stack: Vector<int>, at: int): Vector<int>:
mut out := Vector {} as Vector<int>
mut i := at
until i < stack.len():
out.push(stack.get(i))
i++
end
ret out
end
func _find_cycle_from(g &: Graph, src: int, state &: Vector<int>, out &: Vector<int>): bool:
mut stack := Vector {} as Vector<int>
defer stack.free()
mut it := Vector {} as Vector<int>
defer it.free()
mut via := Vector {} as Vector<int>
defer via.free()
state.set(src, 1)
stack.push(src)
it.push(g.adj_start(src))
via.push(GRAPH_NONE)
until stack.len() > 0:
u := stack.last()
k := it.last()
if k >= g.adj_stop(u):
state.set(u, 2)
stack.pop()
it.pop()
via.pop()
continue
end
it.set(it.len() - 1, k + 1)
e := g.adj_edge(k)
v := g.adj_node(k)
if g.directed == false:
if e == via.last(): continue end
end
if state.get(v) == 1:
at := _stack_index(stack, v)
mut c := _cycle_from(stack, at)
repeat c.len() in i: out.push(c.get(i)) end
c.free()
ret true
end
if state.get(v) == 0:
state.set(v, 1)
stack.push(v)
it.push(g.adj_start(v))
via.push(e)
end
end
ret false
end
func _relax_indegree(g &: Graph, u: int, deg &: Vector<int>, q &: Vector<int>):
mut k := g.adj_start(u)
stop := g.adj_stop(u)
until k < stop:
v := g.adj_node(k)
deg.set(v, deg.get(v) - 1)
if deg.get(v) == 0: q.push(v) end
k++
end
end
func _relax_indegree_heap(g &: Graph, u: int, deg &: Vector<int>, h &: MinHeap):
mut k := g.adj_start(u)
stop := g.adj_stop(u)
until k < stop:
v := g.adj_node(k)
deg.set(v, deg.get(v) - 1)
if deg.get(v) == 0: h.push(v as f64, v) end
k++
end
end
func _bipartite_all(g &: Graph, color &: Vector<int>, n: int): bool:
mut ok := true
repeat n in s:
if color.get(s) == GRAPH_NONE:
if _color_bfs(g, s, color) == false: ok = false end
end
end
ret ok
end
func _indegrees(g &: Graph, deg &: Vector<int>):
FillInt(deg, g.n, 0)
repeat g.size() in e:
v := g.edge_to(e)
deg.set(v, deg.get(v) + 1)
end
end
@en "BFSFrom"
@fa "پیمایش سطحی از"
pub func BFSFrom(g &: Graph, src: int, dist &: Vector<int>, parent &: Vector<int>):
FillInt(dist, g.n, GRAPH_NONE)
FillInt(parent, g.n, GRAPH_NONE)
if src < 0: ret end
if src >= g.n: ret end
mut q := Vector {} as Vector<int>
defer q.free()
dist.set(src, 0)
q.push(src)
mut head := 0
until head < q.len():
u := q.get(head)
head++
mut k := g.adj_start(u)
stop := g.adj_stop(u)
until k < stop:
v := g.adj_node(k)
if dist.get(v) == GRAPH_NONE:
dist.set(v, dist.get(u) + 1)
parent.set(v, u)
q.push(v)
end
k++
end
end
end
@en "BFS"
@fa "پیمایش سطحی"
pub func BFS(g &: Graph, src: int): Vector<int>:
mut dist := Vector {} as Vector<int>
mut parent := Vector {} as Vector<int>
defer parent.free()
BFSFrom(g, src, dist, parent)
ret dist
end
@en "BFSOrder"
@fa "ترتیب سطحی"
pub func BFSOrder(g &: Graph, src: int): Vector<int>:
mut out := Vector {} as Vector<int>
if src < 0: ret out end
if src >= g.n: ret out end
mut seen := Vector {} as Vector<bool>
defer seen.free()
FillBool(seen, g.n, false)
seen.set(src, true)
out.push(src)
mut head := 0
until head < out.len():
u := out.get(head)
head++
mut k := g.adj_start(u)
stop := g.adj_stop(u)
until k < stop:
v := g.adj_node(k)
if seen.get(v) == false:
seen.set(v, true)
out.push(v)
end
k++
end
end
ret out
end
@en "DFSOrder"
@fa "ترتیب عمقی"
pub func DFSOrder(g &: Graph, src: int): Vector<int>:
mut pre := Vector {} as Vector<int>
mut post := Vector {} as Vector<int>
defer post.free()
mut seen := Vector {} as Vector<bool>
defer seen.free()
FillBool(seen, g.n, false)
_dfs_walk(g, src, pre, post, seen)
ret pre
end
@en "DFSPostOrder"
@fa "ترتیب پسین عمقی"
pub func DFSPostOrder(g &: Graph, src: int): Vector<int>:
mut pre := Vector {} as Vector<int>
defer pre.free()
mut post := Vector {} as Vector<int>
mut seen := Vector {} as Vector<bool>
defer seen.free()
FillBool(seen, g.n, false)
_dfs_walk(g, src, pre, post, seen)
ret post
end
@en "DFSForest"
@fa "جنگل عمقی"
pub func DFSForest(g &: Graph): Vector<int>:
mut pre := Vector {} as Vector<int>
mut post := Vector {} as Vector<int>
defer post.free()
mut seen := Vector {} as Vector<bool>
defer seen.free()
FillBool(seen, g.n, false)
repeat g.n in u: _dfs_walk(g, u, pre, post, seen) end
ret pre
end
@en "Reachable"
@fa "دست‌یافتنی"
pub func Reachable(g &: Graph, src: int): Vector<bool>:
mut dist := Vector {} as Vector<int>
defer dist.free()
mut parent := Vector {} as Vector<int>
defer parent.free()
BFSFrom(g, src, dist, parent)
mut out := Vector {} as Vector<bool>
repeat g.n in u: out.push(dist.get(u) != GRAPH_NONE) end
ret out
end
@en "ReachableCount"
@fa "شمار دست‌یافتنی"
pub func ReachableCount(g &: Graph, src: int): int:
mut r := Reachable(g, src)
defer r.free()
mut c := 0
repeat r.len() in u:
if r.get(u): c++ end
end
ret c
end
@en "HopDistance"
@fa "فاصله گامی"
pub func HopDistance(g &: Graph, s: int, t: int): int:
mut d := BFS(g, s)
defer d.free()
if t < 0: ret GRAPH_NONE end
if t >= g.n: ret GRAPH_NONE end
ret d.get(t)
end
@en "PathFromParents"
@fa "مسیر از والدها"
pub func PathFromParents(parent: Vector<int>, s: int, t: int): Vector<int>:
mut out := Vector {} as Vector<int>
if t < 0: ret out end
if t >= parent.len(): ret out end
if t != s:
if parent.get(t) == GRAPH_NONE: ret out end
end
mut c := t
until c != GRAPH_NONE:
out.push(c)
if c == s: break end
c = parent.get(c)
end
ReverseInt(out)
ret out
end
@en "HopPath"
@fa "مسیر گامی"
pub func HopPath(g &: Graph, s: int, t: int): Vector<int>:
mut dist := Vector {} as Vector<int>
defer dist.free()
mut parent := Vector {} as Vector<int>
defer parent.free()
BFSFrom(g, s, dist, parent)
ret PathFromParents(parent, s, t)
end
package graph
import math
import str
import conv
func _tree_far(g &: Graph, s: int, dist &: Vector<int>, parent &: Vector<int>): int:
BFSFrom(g, s, dist, parent)
mut best := s
repeat g.n in u:
if dist.get(u) != GRAPH_NONE:
if dist.get(u) > dist.get(best): best = u end
end
end
ret best
end
func _lift_levels(n: int): int:
mut k := 1
mut span := 1
until span < n:
span *= 2
k++
end
ret k
end
func _peel_leaves(g &: Graph, alive &: Vector<bool>, deg &: Vector<int>, left: int): Vector<int>:
mut remaining := left
mut layer := Vector {} as Vector<int>
repeat g.n in u:
if alive.get(u):
if deg.get(u) <= 1: layer.push(u) end
end
end
until remaining > 2:
remaining -= layer.len()
mut nxt := Vector {} as Vector<int>
_peel_step(g, alive, deg, layer, nxt)
layer.free()
layer = nxt
end
ret layer
end
func _peel_step(g &: Graph, alive &: Vector<bool>, deg &: Vector<int>, layer: Vector<int>, nxt &: Vector<int>):
repeat layer.len() in i:
u := layer.get(i)
alive.set(u, false)
mut k := g.adj_start(u)
stop := g.adj_stop(u)
until k < stop:
v := g.adj_node(k)
if alive.get(v):
deg.set(v, deg.get(v) - 1)
if deg.get(v) == 1: nxt.push(v) end
end
k++
end
end
end
func _ahu_name(g &: Graph, u: int, parent: int): str:
mut parts := Vector {} as Vector<str>
defer parts.free()
mut k := g.adj_start(u)
stop := g.adj_stop(u)
until k < stop:
v := g.adj_node(k)
if v != parent: parts.push(_ahu_name(g, v, u)) end
k++
end
_sort_strings(parts)
mut out := "("
repeat parts.len() in i: out += parts.get(i) end
ret out + ")"
end
func _sort_strings(v &: Vector<str>):
mut i := 1
until i < v.len():
x := v.get(i)
mut j := i - 1
until j >= 0:
if str.Compare(v.get(j), x) <= 0: break end
v.set(j + 1, v.get(j))
j--
end
v.set(j + 1, x)
i++
end
end
func _canonical_rooted(g &: Graph): str:
mut c := TreeCenter(g)
defer c.free()
if c.len() == 0: ret "" end
a := _ahu_name(g, c.get(0), GRAPH_NONE)
if c.len() == 1: ret a end
b := _ahu_name(g, c.get(1), GRAPH_NONE)
if str.Compare(a, b) <= 0: ret a + b end
ret b + a
end
func _render(g &: Graph, u: int, parent: int): str:
mut out := conv.FormatInt(u as i64)
mut kids := Vector {} as Vector<str>
defer kids.free()
mut k := g.adj_start(u)
stop := g.adj_stop(u)
until k < stop:
v := g.adj_node(k)
if v != parent: kids.push(_render(g, v, u)) end
k++
end
if kids.len() == 0: ret out end
out += "("
repeat kids.len() in i:
if i > 0: out += " " end
out += kids.get(i)
end
ret out + ")"
end
func _is_centroid(g &: Graph, u: int, size: Vector<int>, parent: Vector<int>): bool:
half := g.n / 2
mut biggest := g.n - size.get(u)
mut k := g.adj_start(u)
stop := g.adj_stop(u)
until k < stop:
v := g.adj_node(k)
if parent.get(v) == u:
if size.get(v) > biggest: biggest = size.get(v) end
end
k++
end
ret biggest <= half
end
func _lca_depths(g &: Graph, root: int, parent: Vector<int>, order: Vector<int>, ix &: LCAIndex):
FillInt(ix.depth, g.n, 0)
repeat order.len() in i:
u := order.get(i)
p := parent.get(u)
if p != GRAPH_NONE: ix.depth.set(u, ix.depth.get(p) + 1) end
end
ix.depth.set(root, 0)
end
func _lca_table(parent: Vector<int>, ix &: LCAIndex):
n := ix.n
FillInt(ix.up, ix.levels * n, GRAPH_NONE)
repeat n in v:
p := parent.get(v)
if p == GRAPH_NONE: ix.up.set(v, v)
else:
ix.up.set(v, p)
end
end
mut k := 1
until k < ix.levels:
repeat n in v:
mid := ix.up.get((k - 1) * n + v)
ix.up.set(k * n + v, ix.up.get((k - 1) * n + mid))
end
k++
end
end
func _lift_to(ix &: LCAIndex, u0: int, want: int): int:
mut u := u0
mut k := ix.levels - 1
until k >= 0:
if ix.depth.get(ix.ancestor(k, u)) >= want: u = ix.ancestor(k, u) end
k--
end
ret u
end
func _lowest_leaf(deg: Vector<int>, alive: Vector<bool>, n: int): int:
repeat n in u:
if alive.get(u):
if deg.get(u) == 1: ret u end
end
end
ret GRAPH_NONE
end
func _only_neighbor(g &: Graph, u: int, alive: Vector<bool>): int:
mut k := g.adj_start(u)
stop := g.adj_stop(u)
until k < stop:
v := g.adj_node(k)
if alive.get(v): ret v end
k++
end
ret GRAPH_NONE
end
func _prufer_build(g &: Graph, code: Vector<int>, deg &: Vector<int>, n: int):
mut h := MinHeap {}
defer h.free()
repeat n in u:
if deg.get(u) == 1: h.push(u as f64, u) end
end
repeat code.len() in i:
p := code.get(i)
leaf := h.pop()
g.add_edge(leaf, p)
deg.set(p, deg.get(p) - 1)
if deg.get(p) == 1: h.push(p as f64, p) end
end
a := h.pop()
b := h.pop()
g.add_edge(a, b)
end
@en "IsTree"
@fa "درخت است"
pub func IsTree(g &: Graph): bool:
if g.n == 0: ret false end
mut s := Simplify(g)
ok := s.size() == g.n - 1
defer s.free()
if ok == false: ret false end
if HasSelfLoop(g): ret false end
ret IsConnected(g)
end
@en "IsForest"
@fa "جنگل است"
pub func IsForest(g &: Graph): bool:
if HasSelfLoop(g): ret false end
mut s := Simplify(g)
ok := s.size() == g.n - ComponentCount(g)
defer s.free()
ret ok
end
@en "RootTree"
@fa "ریشه‌دار کردن"
pub func RootTree(g &: Graph, root: int, parent &: Vector<int>, order &: Vector<int>):
mut dist := Vector {} as Vector<int>
defer dist.free()
BFSFrom(g, root, dist, parent)
order.clear()
mut best := 0
repeat g.n in u:
if dist.get(u) != GRAPH_NONE:
if dist.get(u) > best: best = dist.get(u) end
end
end
mut d := 0
until d <= best:
repeat g.n in u:
if dist.get(u) == d: order.push(u) end
end
d++
end
end
@en "SubtreeSizes"
@fa "اندازه زیردرخت‌ها"
pub func SubtreeSizes(g &: Graph, root: int): Vector<int>:
mut parent := Vector {} as Vector<int>
defer parent.free()
mut order := Vector {} as Vector<int>
defer order.free()
RootTree(g, root, parent, order)
mut size := Vector {} as Vector<int>
FillInt(size, g.n, 1)
mut i := order.len() - 1
until i >= 0:
u := order.get(i)
p := parent.get(u)
if p != GRAPH_NONE: size.set(p, size.get(p) + size.get(u)) end
i--
end
ret size
end
@en "TreeDiameter"
@fa "قطر درخت"
pub func TreeDiameter(g &: Graph, ends &: Vector<int>): int:
ends.clear()
if g.n == 0: ret GRAPH_NONE end
mut dist := Vector {} as Vector<int>
defer dist.free()
mut parent := Vector {} as Vector<int>
defer parent.free()
a := _tree_far(g, 0, dist, parent)
b := _tree_far(g, a, dist, parent)
ends.push(a)
ends.push(b)
ret dist.get(b)
end
@en "TreeCenter"
@fa "مرکز درخت"
pub func TreeCenter(g &: Graph): Vector<int>:
mut out := Vector {} as Vector<int>
if g.n == 0: ret out end
if g.n <= 2:
repeat g.n in u: out.push(u) end
ret out
end
mut alive := Vector {} as Vector<bool>
defer alive.free()
mut deg := Vector {} as Vector<int>
defer deg.free()
FillBool(alive, g.n, true)
FillInt(deg, g.n, 0)
repeat g.n in u: deg.set(u, g.degree(u)) end
defer out.free()
ret _peel_leaves(g, alive, deg, g.n)
end
@en "TreeCentroid"
@fa "مرکز ثقل درخت"
pub func TreeCentroid(g &: Graph): Vector<int>:
mut out := Vector {} as Vector<int>
if g.n == 0: ret out end
mut size := SubtreeSizes(g, 0)
defer size.free()
mut parent := Vector {} as Vector<int>
defer parent.free()
mut order := Vector {} as Vector<int>
defer order.free()
RootTree(g, 0, parent, order)
repeat g.n in u:
if _is_centroid(g, u, size, parent): out.push(u) end
end
ret out
end
package graph
import math
import str
import conv
@en "LCAIndex"
@fa "نمایه نیای مشترک"
pub struct LCAIndex:
@en "n"
@fa "شمار گره‌ها"
pub n: int = 0
@en "levels"
@fa "سطح‌ها"
pub levels: int = 0
@en "depth"
@fa "عمق"
pub depth: Vector<int> = Vector {}
@en "up"
@fa "جدول نیاها"
pub up: Vector<int> = Vector {}
@en "ancestor"
@fa "نیا"
pub func ancestor(k: int, v: int): int: ret this.up.get(k * this.n + v) end
@en "free"
@fa "آزادسازی"
pub func free():
this.depth.free()
this.up.free()
end
end
@en "BuildLCA"
@fa "ساخت نیای مشترک"
pub func BuildLCA(g &: Graph, root: int): LCAIndex:
mut ix := LCAIndex {}
ix.n = g.n
ix.levels = _lift_levels(g.n)
mut parent := Vector {} as Vector<int>
defer parent.free()
mut order := Vector {} as Vector<int>
defer order.free()
RootTree(g, root, parent, order)
_lca_depths(g, root, parent, order, ix)
_lca_table(parent, ix)
ret ix
end
@en "LCA"
@fa "نیای مشترک"
pub func LCA(ix &: LCAIndex, u0: int, v0: int): int:
mut u := u0
mut v := v0
if ix.depth.get(u) < ix.depth.get(v):
t := u
u = v
v = t
end
u = _lift_to(ix, u, ix.depth.get(v))
if u == v: ret u end
mut k := ix.levels - 1
until k >= 0:
if ix.ancestor(k, u) != ix.ancestor(k, v):
u = ix.ancestor(k, u)
v = ix.ancestor(k, v)
end
k--
end
ret ix.ancestor(0, u)
end
@en "TreeDistance"
@fa "فاصله درختی"
pub func TreeDistance(ix &: LCAIndex, u: int, v: int): int:
a := LCA(ix, u, v)
if a == GRAPH_NONE: ret GRAPH_NONE end
ret ix.depth.get(u) + ix.depth.get(v) - 2 * ix.depth.get(a)
end
@en "PruferEncode"
@fa "کد پروفر"
pub func PruferEncode(g &: Graph): Vector<int>:
mut code := Vector {} as Vector<int>
if g.n < 2: ret code end
mut deg := Vector {} as Vector<int>
defer deg.free()
mut alive := Vector {} as Vector<bool>
defer alive.free()
FillInt(deg, g.n, 0)
FillBool(alive, g.n, true)
repeat g.n in u: deg.set(u, g.degree(u)) end
repeat g.n - 2:
leaf := _lowest_leaf(deg, alive, g.n)
p := _only_neighbor(g, leaf, alive)
code.push(p)
alive.set(leaf, false)
deg.set(p, deg.get(p) - 1)
end
ret code
end
@en "PruferDecode"
@fa "کدگشایی پروفر"
pub func PruferDecode(code: Vector<int>): Graph:
n := code.len() + 2
mut g := New(n, false)
mut deg := Vector {} as Vector<int>
defer deg.free()
FillInt(deg, n, 1)
repeat code.len() in i:
p := code.get(i)
deg.set(p, deg.get(p) + 1)
end
_prufer_build(g, code, deg, n)
ret g
end
@en "TreeIsomorphic"
@fa "درخت‌های یکریخت"
pub func TreeIsomorphic(a &: Graph, b &: Graph): bool:
if a.n != b.n: ret false end
if IsTree(a) == false: ret false end
if IsTree(b) == false: ret false end
ca := _canonical_rooted(a)
cb := _canonical_rooted(b)
ret str.Equals(ca, cb)
end
@en "TreeCanonicalForm"
@fa "شکل متعارف درخت"
pub func TreeCanonicalForm(g &: Graph): str:
if IsTree(g) == false: ret "" end
ret _canonical_rooted(g)
end
@en "LabeledTreeCount"
@fa "شمار درخت برچسب‌دار"
pub func LabeledTreeCount(n: int): f64:
if n < 1: ret 0.0 end
if n < 3: ret 1.0 end
ret math.Pow(n as f64, (n - 2) as f64)
end
@en "TreeToString"
@fa "درخت به رشته"
pub func TreeToString(g &: Graph, root: int): str:
if g.n == 0: ret "" end
ret _render(g, root, GRAPH_NONE)
end
package graph
@en "MinHeap"
@fa "هرم کمینه"
pub struct MinHeap:
@en "key"
@fa "کلیدها"
pub key: Vector<f64> = Vector {}
@en "val"
@fa "مقدارها"
pub val: Vector<int> = Vector {}
func _swap(i: int, j: int):
ka := this.key.get(i)
kb := this.key.get(j)
this.key.set(i, kb)
this.key.set(j, ka)
va := this.val.get(i)
vb := this.val.get(j)
this.val.set(i, vb)
this.val.set(j, va)
end
@en "push"
@fa "افزودن"
pub func push(k: f64, v: int):
this.key.push(k)
this.val.push(v)
mut i := this.key.len() - 1
until i > 0:
p := (i - 1) / 2
if this.key.get(p) <= this.key.get(i): break end
this._swap(i, p)
i = p
end
end
@en "size"
@fa "اندازه"
pub func size(): int: ret this.val.len() end
@en "is_empty"
@fa "تهی است"
pub func is_empty(): bool: ret this.val.len() == 0 end
@en "top_key"
@fa "کلید بالا"
pub func top_key(): f64: ret this.key.get(0) end
@en "top_value"
@fa "مقدار بالا"
pub func top_value(): int: ret this.val.get(0) end
@en "pop"
@fa "برداشتن"
pub func pop(): int:
top := this.val.get(0)
last := this.val.len() - 1
this.key.set(0, this.key.get(last))
this.val.set(0, this.val.get(last))
this.key.pop()
this.val.pop()
this._sift(0)
ret top
end
func _sift(from: int):
n := this.val.len()
mut i := from
until true:
l := 2 * i + 1
if l >= n: break end
mut s := l
r := l + 1
if r < n:
if this.key.get(r) < this.key.get(l): s = r end
end
if this.key.get(i) <= this.key.get(s): break end
this._swap(i, s)
i = s
end
end
@en "clear"
@fa "پاکسازی"
pub func clear():
this.key.clear()
this.val.clear()
end
@en "free"
@fa "آزادسازی"
pub func free():
this.key.free()
this.val.free()
end
end
@en "DisjointSet"
@fa "مجموعه‌های مجزا"
pub struct DisjointSet:
@en "parent"
@fa "والدها"
pub parent: Vector<int> = Vector {}
@en "sz"
@fa "اندازه‌ها"
pub sz: Vector<int> = Vector {}
@en "groups"
@fa "شمار مجموعه‌ها"
pub groups: int = 0
@en "reset"
@fa "بازنشانی"
pub func reset(n: int):
this.parent.clear()
this.sz.clear()
repeat n in i:
this.parent.push(i)
this.sz.push(1)
end
this.groups = n
end
@en "find"
@fa "یافتن"
pub func find(x: int): int:
mut r := x
until this.parent.get(r) != r: r = this.parent.get(r) end
mut c := x
until this.parent.get(c) != c:
nx := this.parent.get(c)
this.parent.set(c, r)
c = nx
end
ret r
end
@en "union"
@fa "یکی‌سازی"
pub func union(a: int, b: int): bool:
mut ra := this.find(a)
mut rb := this.find(b)
if ra == rb: ret false end
if this.sz.get(ra) < this.sz.get(rb):
t := ra
ra = rb
rb = t
end
this.parent.set(rb, ra)
this.sz.set(ra, this.sz.get(ra) + this.sz.get(rb))
this.groups--
ret true
end
@en "connected"
@fa "متصل"
pub func connected(a: int, b: int): bool: ret this.find(a) == this.find(b) end
@en "set_size"
@fa "اندازه مجموعه"
pub func set_size(a: int): int: ret this.sz.get(this.find(a)) end
@en "count"
@fa "شمار"
pub func count(): int: ret this.groups end
@en "free"
@fa "آزادسازی"
pub func free():
this.parent.free()
this.sz.free()
end
end
@en "NewDisjointSet"
@fa "مجموعه مجزا جدید"
pub func NewDisjointSet(n: int): DisjointSet:
mut d := DisjointSet {}
d.reset(n)
ret d
end
@en "FillInt"
@fa "پرکردن صحیح"
pub func FillInt(v &: Vector<int>, n: int, x: int):
v.clear()
repeat n: v.push(x) end
end
@en "FillFloat"
@fa "پرکردن اعشاری"
pub func FillFloat(v &: Vector<f64>, n: int, x: f64):
v.clear()
repeat n: v.push(x) end
end
@en "FillBool"
@fa "پرکردن منطقی"
pub func FillBool(v &: Vector<bool>, n: int, x: bool):
v.clear()
repeat n: v.push(x) end
end
@en "Iota"
@fa "دنباله"
pub func Iota(v &: Vector<int>, n: int):
v.clear()
repeat n in i: v.push(i) end
end
@en "MaxInt"
@fa "بیشینه صحیح"
pub func MaxInt(v: Vector<int>): int:
if v.len() == 0: ret 0 end
mut b := v.get(0)
repeat v.len() in i:
if v.get(i) > b: b = v.get(i) end
end
ret b
end
@en "SumInt"
@fa "مجموع صحیح"
pub func SumInt(v: Vector<int>): int:
mut s := 0
repeat v.len() in i: s += v.get(i) end
ret s
end
@en "SumFloat"
@fa "مجموع اعشاری"
pub func SumFloat(v: Vector<f64>): f64:
mut s := 0.0
repeat v.len() in i: s += v.get(i) end
ret s
end
@en "ReverseInt"
@fa "وارونه‌سازی"
pub func ReverseInt(v &: Vector<int>):
mut i := 0
mut j := v.len() - 1
until i < j:
a := v.get(i)
b := v.get(j)
v.set(i, b)
v.set(j, a)
i++
j--
end
end
@en "graph"
@fa "گراف"
package graph
const _GRAPH_EPS := 0.000000000001
@en "GRAPH_INF"
@fa "بی‌نهایت گراف"
pub const GRAPH_INF := 1.0e300
@en "GRAPH_NONE"
@fa "هیچ"
pub const GRAPH_NONE := -1
@en "Graph"
@fa "گراف"
pub struct Graph:
@en "directed"
@fa "جهت‌دار"
pub directed: bool = false
@en "n"
@fa "شمار گره‌ها"
pub n: int = 0
@en "eu"
@fa "آغاز یال‌ها"
pub eu: Vector<int> = Vector {}
@en "ev"
@fa "انتهای یال‌ها"
pub ev: Vector<int> = Vector {}
@en "ew"
@fa "وزن یال‌ها"
pub ew: Vector<f64> = Vector {}
@en "names"
@fa "نام گره‌ها"
pub names: Vector<str> = Vector {}
@en "off"
@fa "آغاز مجاورت‌ها"
pub off: Vector<int> = Vector {}
@en "nbr"
@fa "گره‌های مجاور"
pub nbr: Vector<int> = Vector {}
@en "eix"
@fa "یال‌های مجاور"
pub eix: Vector<int> = Vector {}
@en "roff"
@fa "آغاز ورودی‌ها"
pub roff: Vector<int> = Vector {}
@en "rnbr"
@fa "گره‌های‌ورودی"
pub rnbr: Vector<int> = Vector {}
@en "reix"
@fa "یال‌های‌ورودی"
pub reix: Vector<int> = Vector {}
@en "built"
@fa "ساخته شده"
pub built: bool = false
@en "add_node"
@fa "افزودن گره"
pub func add_node(): int:
id := this.n
this.n++
this.built = false
ret id
end
@en "add_nodes"
@fa "افزودن گره‌ها"
pub func add_nodes(k: int):
if k <= 0: ret end
this.n += k
this.built = false
end
@en "add_edge"
@fa "افزودن یال"
pub func add_edge(u: int, v: int): int:
ret this.add_weighted(u, v, 1.0)
end
@en "add_weighted"
@fa "افزودن یال وزن‌دار"
pub func add_weighted(u: int, v: int, w: f64): int:
if u < 0: ret GRAPH_NONE end
if v < 0: ret GRAPH_NONE end
if u >= this.n: this.n = u + 1 end
if v >= this.n: this.n = v + 1 end
this.eu.push(u)
this.ev.push(v)
this.ew.push(w)
this.built = false
ret this.eu.len() - 1
end
@en "order"
@fa "مرتبه"
pub func order(): int: ret this.n end
@en "size"
@fa "اندازه"
pub func size(): int: ret this.eu.len() end
@en "edge_from"
@fa "سر یال"
pub func edge_from(e: int): int: ret this.eu.get(e) end
@en "edge_to"
@fa "ته یال"
pub func edge_to(e: int): int: ret this.ev.get(e) end
@en "edge_weight"
@fa "وزن یال"
pub func edge_weight(e: int): f64: ret this.ew.get(e) end
@en "set_weight"
@fa "تنظیم وزن"
pub func set_weight(e: int, w: f64): this.ew.set(e, w) end
@en "set_name"
@fa "تنظیم نام"
pub func set_name(u: int, s: str):
if u < 0: ret end
if u >= this.n: this.n = u + 1 end
until this.names.len() <= u: this.names.push("") end
this.names.set(u, s)
end
@en "name"
@fa "نام"
pub func name(u: int): str:
if u < 0: ret "" end
if u >= this.names.len(): ret "" end
ret this.names.get(u)
end
@en "build"
@fa "ساخت"
pub func build():
if this.built: ret end
_csr(this.eu, this.ev, this.n, this.directed == false, this.off, this.nbr, this.eix)
if this.directed:
_csr(this.ev, this.eu, this.n, false, this.roff, this.rnbr, this.reix)
end
this.built = true
end
@en "adj_start"
@fa "آغاز مجاورت"
pub func adj_start(u: int): int:
this.build()
ret this.off.get(u)
end
@en "adj_stop"
@fa "پایان مجاورت"
pub func adj_stop(u: int): int:
this.build()
ret this.off.get(u + 1)
end
@en "adj_node"
@fa "گره مجاور"
pub func adj_node(k: int): int: ret this.nbr.get(k) end
@en "adj_edge"
@fa "یال مجاور"
pub func adj_edge(k: int): int: ret this.eix.get(k) end
@en "adj_weight"
@fa "وزن مجاور"
pub func adj_weight(k: int): f64: ret this.ew.get(this.eix.get(k)) end
@en "in_start"
@fa "آغاز ورودی"
pub func in_start(u: int): int:
this.build()
if this.directed: ret this.roff.get(u) end
ret this.off.get(u)
end
@en "in_stop"
@fa "پایان ورودی"
pub func in_stop(u: int): int:
this.build()
if this.directed: ret this.roff.get(u + 1) end
ret this.off.get(u + 1)
end
@en "in_node"
@fa "گره ورودی"
pub func in_node(k: int): int:
if this.directed: ret this.rnbr.get(k) end
ret this.nbr.get(k)
end
@en "in_edge"
@fa "یال ورودی"
pub func in_edge(k: int): int:
if this.directed: ret this.reix.get(k) end
ret this.eix.get(k)
end
@en "out_degree"
@fa "درجه خروجی"
pub func out_degree(u: int): int:
ret this.adj_stop(u) - this.adj_start(u)
end
@en "in_degree"
@fa "درجه ورودی"
pub func in_degree(u: int): int:
ret this.in_stop(u) - this.in_start(u)
end
@en "degree"
@fa "درجه"
pub func degree(u: int): int:
if this.directed: ret this.out_degree(u) + this.in_degree(u) end
ret this.out_degree(u)
end
@en "has_edge"
@fa "دارای یال"
pub func has_edge(u: int, v: int): bool:
ret this.find_edge(u, v) != GRAPH_NONE
end
@en "find_edge"
@fa "یافتن یال"
pub func find_edge(u: int, v: int): int:
if u < 0: ret GRAPH_NONE end
if u >= this.n: ret GRAPH_NONE end
mut k := this.adj_start(u)
stop := this.adj_stop(u)
until k < stop:
if this.adj_node(k) == v: ret this.adj_edge(k) end
k++
end
ret GRAPH_NONE
end
@en "weight_between"
@fa "وزن میان"
pub func weight_between(u: int, v: int): f64:
e := this.find_edge(u, v)
if e == GRAPH_NONE: ret GRAPH_INF end
ret this.ew.get(e)
end
@en "neighbors"
@fa "همسایگان"
pub func neighbors(u: int): Vector<int>:
mut out := Vector {} as Vector<int>
mut k := this.adj_start(u)
stop := this.adj_stop(u)
until k < stop:
out.push(this.adj_node(k))
k++
end
ret out
end
@en "free"
@fa "آزادسازی"
pub func free():
this.eu.free()
this.ev.free()
this.ew.free()
this.names.free()
this.off.free()
this.nbr.free()
this.eix.free()
this.roff.free()
this.rnbr.free()
this.reix.free()
end
end
func _csr(a: Vector<int>, b: Vector<int>, n: int, both: bool, off &: Vector<int>, nbr &: Vector<int>, eix &: Vector<int>):
m := a.len()
off.zeros(n + 1)
repeat m in i:
_bump(off, a.get(i) + 1)
if both: _bump(off, b.get(i) + 1) end
end
repeat n in i:
off.set(i + 1, off.get(i + 1) + off.get(i))
end
total := off.get(n)
nbr.clear()
eix.clear()
if total > 0:
nbr.zeros(total)
eix.zeros(total)
end
mut cur := Vector {} as Vector<int>
defer cur.free()
cur.zeros(n + 1)
repeat n + 1 in i: cur.set(i, off.get(i)) end
repeat m in i:
_place(cur, nbr, eix, a.get(i), b.get(i), i)
if both: _place(cur, nbr, eix, b.get(i), a.get(i), i) end
end
end
func _bump(v &: Vector<int>, i: int): v.set(i, v.get(i) + 1) end
func _place(cur &: Vector<int>, nbr &: Vector<int>, eix &: Vector<int>, u: int, v: int, e: int):
p := cur.get(u)
nbr.set(p, v)
eix.set(p, e)
cur.set(u, p + 1)
end
@en "New"
@fa "جدید"
pub func New(n: int, directed: bool): Graph:
mut g := Graph {}
g.directed = directed
g.add_nodes(n)
ret g
end
@en "NewUndirected"
@fa "بی‌جهت جدید"
pub func NewUndirected(n: int): Graph: ret New(n, false) end
@en "NewDirected"
@fa "جهت‌دار جدید"
pub func NewDirected(n: int): Graph: ret New(n, true) end
@en "FromEdges"
@fa "از یال‌ها"
pub func FromEdges(n: int, us: Vector<int>, vs: Vector<int>, directed: bool): Graph:
mut g := New(n, directed)
m := us.len()
repeat m in i:
g.add_edge(us.get(i), vs.get(i))
end
ret g
end
@en "IsClose"
@fa "نزدیک است"
pub func IsClose(a: f64, b: f64): bool:
d := a - b
if d < 0.0: ret 0.0 - d < _GRAPH_EPS end
ret d < _GRAPH_EPS
end
package graphql
@en "VAL_NULL"
@fa "مقدار تهی"
pub const VAL_NULL := 0
@en "VAL_BOOL"
@fa "مقدار بولی"
pub const VAL_BOOL := 1
@en "VAL_INT"
@fa "مقدار صحیح"
pub const VAL_INT := 2
@en "VAL_FLOAT"
@fa "مقدار اعشاری"
pub const VAL_FLOAT := 3
@en "VAL_STRING"
@fa "مقدار رشته"
pub const VAL_STRING := 4
@en "VAL_ENUM"
@fa "مقدار شمارشی"
pub const VAL_ENUM := 5
@en "VAL_LIST"
@fa "مقدار فهرست"
pub const VAL_LIST := 6
@en "VAL_OBJECT"
@fa "مقدار شیء"
pub const VAL_OBJECT := 7
@en "VAL_VARIABLE"
@fa "مقدار متغیر"
pub const VAL_VARIABLE := 8
@en "TREF_NAMED"
@fa "ارجاع نوع نام‌دار"
pub const TREF_NAMED := 0
@en "TREF_LIST"
@fa "ارجاع نوع فهرست"
pub const TREF_LIST := 1
@en "SEL_FIELD"
@fa "گزینش فیلد"
pub const SEL_FIELD := 0
@en "SEL_FRAGMENT_SPREAD"
@fa "گزینش پخش قطعه"
pub const SEL_FRAGMENT_SPREAD := 1
@en "SEL_INLINE_FRAGMENT"
@fa "گزینش قطعه درون‌خطی"
pub const SEL_INLINE_FRAGMENT := 2
@en "OP_QUERY"
@fa "عملیات پرسمان"
pub const OP_QUERY := 0
@en "OP_MUTATION"
@fa "عملیات تغییر"
pub const OP_MUTATION := 1
@en "OP_SUBSCRIPTION"
@fa "عملیات اشتراک"
pub const OP_SUBSCRIPTION := 2
@en "AstValue"
@fa "مقدار نحوی"
pub struct AstValue:
@en "kind"
@fa "نوع"
pub kind: int = VAL_NULL
@en "b"
@fa "مقدار منطقی"
pub b: bool = false
@en "i"
@fa "مقدار صحیح"
pub i: i64 = 0
@en "f"
@fa "مقدار اعشاری"
pub f: f64 = 0.0
@en "s"
@fa "مقدار رشته"
pub s: str = ""
@en "items"
@fa "عناصر"
pub items: Vector<int> = Vector {}
@en "keys"
@fa "کلیدها"
pub keys: Vector<str> = Vector {}
@en "line"
@fa "خط"
pub line: int = 0
end
@en "AstTypeRef"
@fa "ارجاع نوع"
pub struct AstTypeRef:
@en "kind"
@fa "نوع"
pub kind: int = TREF_NAMED
@en "name"
@fa "نام"
pub name: str = ""
@en "inner"
@fa "درونی"
pub inner: int = 0 - 1
@en "nonNull"
@fa "غیرتهی"
pub nonNull: bool = false
end
@en "AstArgument"
@fa "آرگومان نحوی"
pub struct AstArgument:
@en "name"
@fa "نام"
pub name: str = ""
@en "value"
@fa "مقدار"
pub value: int = 0 - 1
@en "line"
@fa "خط"
