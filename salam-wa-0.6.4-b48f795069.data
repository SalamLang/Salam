@en "AsyncSearch"
@fa "جستجوی ناهمگام"
pub struct AsyncSearch:
@en "ok"
@fa "موفق"
pub ok: bool = false
@en "id"
@fa "شناسه"
pub id: str = ""
@en "running"
@fa "روان"
pub running: bool = false
@en "partial"
@fa "ناقص"
pub partial: bool = false
@en "result"
@fa "نتیجه"
pub result: SearchResult = SearchResult {}
@en "error"
@fa "خطا"
pub error: str = ""
end
@en "Task"
@fa "کار"
pub struct Task:
@en "ok"
@fa "موفق"
pub ok: bool = false
@en "id"
@fa "شناسه"
pub id: str = ""
@en "completed"
@fa "تمام‌شده"
pub completed: bool = false
@en "action"
@fa "عملیات"
pub action: str = ""
@en "response"
@fa "پاسخ"
pub response: str = ""
@en "raw"
@fa "خام"
pub raw: str = ""
end
func _task_seg(id: str): str:
ret str.Replace(_seg(id), "%3A", ":")
end
func _raw_or_empty(r: Response): str:
if not r.ok: ret str.Clone("") end
ret r.body
end
func _task_id(r: Response): str:
if not r.ok: ret str.Clone("") end
ret json.Get(r.body, "task")
end
func _async_of(r: Response): AsyncSearch:
if not r.ok: ret AsyncSearch { error = r.error } end
body := r.body
mut res := ParseSearchResult(json.Get(body, "response"))
res.status = r.status
ret AsyncSearch {
ok = true, id = json.Get(body, "id"), running = json.Get(body, "is_running") == "true" or json.Get(body, "state") == "RUNNING",
partial = json.Get(body, "is_partial") == "true", result = res
}
end
