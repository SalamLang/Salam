@en "AddAttr"
@fa "افزودن ویژگی"
pub func AddAttr(name: str, value: str):
this.attr_names.push(name)
this.attr_values.push(value)
end
@en "AddMedia"
@fa "افزودن رسانه"
pub func AddMedia(condition: str, declarations: str):
this.media_conditions.push(condition)
this.media_declarations.push(declarations)
end
@en "HasAttr"
@fa "ویژگی دارد"
pub func HasAttr(name: str): bool:
repeat this.attr_names.len() in i:
if this.attr_names[i] == name:
ret true
end
end
ret false
end
@en "Free"
@fa "آزادسازی عنصر"
pub func Free():
this.attr_names.free()
this.attr_values.free()
this.media_conditions.free()
this.media_declarations.free()
this.decl_dyn.free()
end
end
package css
import str
import gui.cssbox
func grid_tok_name(tk: Tok): str:
if tk.raw.len() > 0:
ret tk.raw
end
ret tk.s
end
func grid_text(t: Vector<Tok>, s: int, e: int, cx: Cx, out &: str): bool:
mut b := str.NewBuilder()
mut ok := true
mut prev_open := false
mut i := s
until i < e:
tk := t[i]
mut piece := ""
mut own := false
switch tk.k:
TK_IDENT:
piece = grid_tok_name(tk)
break
end
TK_NUM:
piece = fmt_sig(tk.n)
own = true
break
end
TK_PCT:
n := fmt_sig(tk.n)
piece = n + "%"
sfree(n)
own = true
break
end
TK_DIM:
if tk.id == KW_FR:
n := fmt_sig(tk.n)
piece = n + "fr"
sfree(n)
own = true
else:
mut l := Len {}
if not p_len(t, i, i + 1, cx, false, true, l) or l.calc.len() > 0:
ok = false
else:
piece = px_text(l.px)
own = true
end
end
break
end
TK_FUNC:
piece = tk.s + "("
own = true
break
end
TK_CLOSE:
piece = ")"
break
end
TK_COMMA:
piece = ","
break
end
TK_STR:
piece = "\"" + tk.s + "\""
own = true
break
end
TK_DELIM:
if tk.d == 91:
piece = "["
else tk.d == 93:
piece = "]"
else tk.d == 46:
piece = "."
else:
ok = false
end
break
end
else:
ok = false
end
end
if not ok:
break
end
if i > s and not (prev_open or piece == ")" or piece == "]" or piece == ","):
str.BufAppend(b, " ")
end
str.BufAppend(b, piece)
prev_open = piece.ends_with("(") or piece == "["
if piece == ",":
str.BufAppend(b, " ")
prev_open = true
end
if own:
sfree(piece)
end
i++
end
r := str.BufStr(b)
str.BufFree(b)
if not ok:
sfree(r)
ret false
end
out = intern_own(r)
ret true
end
func apply_grid_prop(cs &: ComputedStyle, p: int, t: Vector<Tok>, s: int, e: int, cx: Cx): bool:
k := kw_id_at(t, s, e)
switch p:
P_GRID_TEMPLATE_COLUMNS, P_GRID_TEMPLATE_ROWS:
mut v := ""
if k == KW_NONE:
v = ""
else:
if not grid_text(t, s, e, cx, v) or not cssbox.IsTrackList(v):
ret false
end
end
if p == P_GRID_TEMPLATE_COLUMNS:
cs.grid_template_columns = v
else:
cs.grid_template_rows = v
end
ret true
end
P_GRID_TEMPLATE_AREAS:
mut v := ""
if k != KW_NONE:
if not grid_text(t, s, e, cx, v) or not cssbox.IsGridAreas(v):
ret false
end
end
cs.grid_template_areas = v
ret true
end
P_GRID_AUTO_COLUMNS, P_GRID_AUTO_ROWS:
mut v := ""
if not grid_text(t, s, e, cx, v) or not cssbox.IsTrackSizes(v):
ret false
end
if k == KW_AUTO:
v = ""
end
if p == P_GRID_AUTO_COLUMNS:
cs.grid_auto_columns = v
else:
cs.grid_auto_rows = v
end
ret true
end
P_GRID_AUTO_FLOW:
mut col := false
mut dense := false
mut seen_dir := false
mut i := s
until i < e:
if t[i].k != TK_IDENT:
ret false
end
w := t[i].id
if w == KW_ROW and not seen_dir:
seen_dir = true
else w == KW_COLUMN and not seen_dir:
col = true
seen_dir = true
else w == KW_DENSE and not dense:
dense = true
else:
ret false
end
i = nxt(t, i)
end
if col:
cs.grid_auto_flow = dense ? cssbox.GridAutoFlow.ColumnDense : cssbox.GridAutoFlow.Column
else:
cs.grid_auto_flow = dense ? cssbox.GridAutoFlow.RowDense : cssbox.GridAutoFlow.Row
end
ret true
end
P_GRID_ROW_START, P_GRID_ROW_END, P_GRID_COLUMN_START, P_GRID_COLUMN_END:
mut v := ""
if not grid_text(t, s, e, cx, v) or not cssbox.IsGridLine(v):
ret false
end
if k == KW_AUTO:
v = ""
end
switch p:
P_GRID_ROW_START: cs.grid_row_start = v break end
P_GRID_ROW_END: cs.grid_row_end = v break end
P_GRID_COLUMN_START: cs.grid_column_start = v break end
else: cs.grid_column_end = v break end
end
ret true
end
P_CAPTION_SIDE:
switch k:
KW_TOP, KW_BLOCK_START: cs.caption_side = cssbox.CaptionSide.Top break end
KW_BOTTOM, KW_BLOCK_END: cs.caption_side = cssbox.CaptionSide.Bottom break end
else: ret false end
end
ret true
end
else:
ret false
end
end
ret false
end
func grid_slash_parts(t: Vector<Tok>, s: int, e: int, out &: Vector<int>):
out.push(s)
mut i := s
until i < e:
if t[i].k == TK_DELIM and t[i].d == 47:
out.push(i)
out.push(i + 1)
end
i = nxt(t, i)
end
out.push(e)
end
func grid_is_ident(t: Vector<Tok>, s: int, e: int): bool:
ret single(t, s, e) and t[s].k == TK_IDENT and t[s].id != KW_AUTO and t[s].id != KW_SPAN
end
func expand_grid_line(src: str, t: Vector<Tok>, s: int, e: int, a: int, b: int, ids &: Vector<int>, vals &: Vector<str>): bool:
mut parts := Vector {} as Vector<int>
defer parts.free()
grid_slash_parts(t, s, e, parts)
n := parts.len() / 2
if n < 1 or n > 2:
ret false
end
if parts[0] >= parts[1]:
ret false
end
push_val(ids, vals, a, tok_text(src, t, parts[0], parts[1]))
if n == 2:
if parts[2] >= parts[3]:
ret false
end
push_val(ids, vals, b, tok_text(src, t, parts[2], parts[3]))
else grid_is_ident(t, parts[0], parts[1]):
push_val(ids, vals, b, tok_text(src, t, parts[0], parts[1]))
else:
push_lit(ids, vals, b, "auto")
end
ret true
end
func expand_grid_area(src: str, t: Vector<Tok>, s: int, e: int, ids &: Vector<int>, vals &: Vector<str>): bool:
mut parts := Vector {} as Vector<int>
defer parts.free()
grid_slash_parts(t, s, e, parts)
n := parts.len() / 2
if n < 1 or n > 4:
ret false
end
repeat n in i:
if parts[2 * i] >= parts[2 * i + 1]:
ret false
end
end
order := [P_GRID_ROW_START, P_GRID_COLUMN_START, P_GRID_ROW_END, P_GRID_COLUMN_END]
mut srcp := [0, 1, 2, 3]
repeat 4 in i:
if i < n:
srcp[i] = i
else:
from := i == 3 ? srcp[1] : srcp[0]
if from >= 0 and grid_is_ident(t, parts[2 * from], parts[2 * from + 1]):
srcp[i] = from
else:
srcp[i] = -1
end
end
if srcp[i] >= 0:
k := srcp[i]
push_val(ids, vals, order[i], tok_text(src, t, parts[2 * k], parts[2 * k + 1]))
else:
push_lit(ids, vals, order[i], "auto")
end
end
ret true
end
func expand_grid_template(src: str, t: Vector<Tok>, s: int, e: int, full: bool, ids &: Vector<int>, vals &: Vector<str>): bool:
if kw_id_at(t, s, e) == KW_NONE:
push_lit(ids, vals, P_GRID_TEMPLATE_ROWS, "none")
push_lit(ids, vals, P_GRID_TEMPLATE_COLUMNS, "none")
push_lit(ids, vals, P_GRID_TEMPLATE_AREAS, "none")
if full:
push_lit(ids, vals, P_GRID_AUTO_ROWS, "auto")
push_lit(ids, vals, P_GRID_AUTO_COLUMNS, "auto")
push_lit(ids, vals, P_GRID_AUTO_FLOW, "row")
end
ret true
end
mut parts := Vector {} as Vector<int>
defer parts.free()
grid_slash_parts(t, s, e, parts)
n := parts.len() / 2
if n > 2:
ret false
end
if full and n == 2:
a0 := parts[0]
b0 := parts[2]
if t[b0].k == TK_IDENT and t[b0].id == KW_AUTO_FLOW:
mut j := nxt(t, b0)
mut dense := false
if j < parts[3] and t[j].k == TK_IDENT and t[j].id == KW_DENSE:
dense = true
j = nxt(t, j)
end
push_val(ids, vals, P_GRID_TEMPLATE_ROWS, tok_text(src, t, a0, parts[1]))
push_lit(ids, vals, P_GRID_TEMPLATE_COLUMNS, "none")
push_lit(ids, vals, P_GRID_TEMPLATE_AREAS, "none")
push_lit(ids, vals, P_GRID_AUTO_FLOW, dense ? "column dense" : "column")
push_lit(ids, vals, P_GRID_AUTO_ROWS, "auto")
if j < parts[3]:
push_val(ids, vals, P_GRID_AUTO_COLUMNS, tok_text(src, t, j, parts[3]))
else:
push_lit(ids, vals, P_GRID_AUTO_COLUMNS, "auto")
end
ret true
end
if t[a0].k == TK_IDENT and t[a0].id == KW_AUTO_FLOW:
mut j := nxt(t, a0)
mut dense := false
if j < parts[1] and t[j].k == TK_IDENT and t[j].id == KW_DENSE:
dense = true
j = nxt(t, j)
end
push_lit(ids, vals, P_GRID_TEMPLATE_ROWS, "none")
push_val(ids, vals, P_GRID_TEMPLATE_COLUMNS, tok_text(src, t, b0, parts[3]))
push_lit(ids, vals, P_GRID_TEMPLATE_AREAS, "none")
push_lit(ids, vals, P_GRID_AUTO_FLOW, dense ? "row dense" : "row")
push_lit(ids, vals, P_GRID_AUTO_COLUMNS, "auto")
if j < parts[1]:
push_val(ids, vals, P_GRID_AUTO_ROWS, tok_text(src, t, j, parts[1]))
else:
push_lit(ids, vals, P_GRID_AUTO_ROWS, "auto")
end
ret true
end
end
mut has_str := false
mut i := parts[0]
until i < parts[1]:
if t[i].k == TK_STR:
has_str = true
end
i = nxt(t, i)
end
if has_str:
mut areas := str.NewBuilder()
mut rows := str.NewBuilder()
mut pending := false
i = parts[0]
until i < parts[1]:
tk := t[i]
if tk.k == TK_STR:
if pending:
str.BufAppend(rows, " auto")
end
str.BufAppend(areas, " \"" + tk.s + "\"")
pending = true
else:
txt := tok_text(src, t, i, nxt(t, i))
str.BufAppend(rows, " " + txt)
sfree(txt)
if not (tk.k == TK_DELIM and tk.d == 91):
pending = false
end
end
i = nxt(t, i)
end
if pending:
str.BufAppend(rows, " auto")
end
a := str.BufStr(areas)
r := str.BufStr(rows)
str.BufFree(areas)
str.BufFree(rows)
ids.push(P_GRID_TEMPLATE_AREAS)
vals.push(str.Trim(a))
ids.push(P_GRID_TEMPLATE_ROWS)
vals.push(str.Trim(r))
sfree(a)
sfree(r)
if n == 2:
push_val(ids, vals, P_GRID_TEMPLATE_COLUMNS, tok_text(src, t, parts[2], parts[3]))
else:
push_lit(ids, vals, P_GRID_TEMPLATE_COLUMNS, "none")
end
else:
if n != 2 or parts[0] >= parts[1] or parts[2] >= parts[3]:
ret false
end
push_val(ids, vals, P_GRID_TEMPLATE_ROWS, tok_text(src, t, parts[0], parts[1]))
push_val(ids, vals, P_GRID_TEMPLATE_COLUMNS, tok_text(src, t, parts[2], parts[3]))
push_lit(ids, vals, P_GRID_TEMPLATE_AREAS, "none")
end
if full:
push_lit(ids, vals, P_GRID_AUTO_ROWS, "auto")
push_lit(ids, vals, P_GRID_AUTO_COLUMNS, "auto")
push_lit(ids, vals, P_GRID_AUTO_FLOW, "row")
end
ret true
end
package css
import str
func media_len(t: Vector<Tok>, i: int, e: int, out &: f64): bool:
cx := Cx {}
mut l := Len {}
if not p_len(t, i, e, cx, false, true, l) or l.calc.len() > 0:
ret false
end
out = l.px
ret true
end
func media_ratio(t: Vector<Tok>, i: int, e: int, out &: f64, next &: int): bool:
cx := Cx {}
mut a := 0.0
if not p_num(t, i, e, cx, a):
ret false
end
mut j := nxt(t, i)
mut b := 1.0
if is_delim(t, j, e, 47):
if not p_num(t, j + 1, e, cx, b) or b == 0.0:
ret false
end
j = nxt(t, j + 1)
end
out = a / b
next = j
ret true
end
func feature_value(name: str, env: Env, out &: f64, is_len &: bool): bool:
is_len = true
switch name:
"width", "device-width": out = env.width break end
"height", "device-height": out = env.height break end
"aspect-ratio", "device-aspect-ratio":
is_len = false
out = env.height > 0.0 ? env.width / env.height : 0.0
break
end
"resolution":
is_len = false
out = 1.0
break
end
"color":
is_len = false
out = 8.0
break
end
"monochrome", "color-index", "grid":
is_len = false
out = 0.0
break
end
else: ret false end
end
ret true
end
func compare(a: f64, op: str, b: f64): bool:
switch op:
"<": ret a < b end
"<=": ret a <= b end
">": ret a > b end
">=": ret a >= b end
else: ret a == b end
end
ret false
end
func read_op(t: Vector<Tok>, i: int, e: int, op &: str): int:
if i >= e or t[i].k != TK_DELIM:
ret -1
end
d := t[i].d
if d == 61:
op = "="
ret i + 1
end
if d == 60 or d == 62:
if i + 1 < e and t[i + 1].k == TK_DELIM and t[i + 1].d == 61 and not t[i + 1].ws:
op = d == 60 ? "<=" : ">="
ret i + 2
end
op = d == 60 ? "<" : ">"
ret i + 1
end
ret -1
end
func flip(op: str): str:
switch op:
"<": ret ">" end
"<=": ret ">=" end
">": ret "<" end
">=": ret "<=" end
else: ret "=" end
end
ret "="
end
func read_mvalue(t: Vector<Tok>, i: int, e: int, is_len: bool, out &: f64): int:
if is_len:
if not media_len(t, i, e, out):
ret -1
end
ret nxt(t, i)
end
mut j := 0
if t[i].k == TK_DIM and (t[i].s == "dppx" or t[i].s == "x" or t[i].s == "dpi" or t[i].s == "dpcm"):
switch t[i].s:
"dpi": out = t[i].n / 96.0 break end
"dpcm": out = t[i].n * 2.54 / 96.0 break end
else: out = t[i].n end
end
ret i + 1
end
if not media_ratio(t, i, e, out, j):
ret -1
end
ret j
end
func media_feature(t: Vector<Tok>, s: int, e: int, env: Env): bool:
if s >= e:
ret false
end
if t[s].k == TK_IDENT and s + 1 < e and t[s + 1].k == TK_DELIM and t[s + 1].d == 58:
name := t[s].s
vs := s + 2
mut prefix := 0
if str.StartsWith(name, "min-"):
prefix = 1
else str.StartsWith(name, "max-"):
prefix = 2
end
base := prefix != 0 ? name.substr(4, name.len() - 4) : str.Clone(name)
defer sfree(base)
k := kw_at(t, vs, e)
switch base:
"orientation":
portrait := env.height >= env.width
ret (k == "portrait" and portrait) or (k == "landscape" and not portrait)
end
"prefers-color-scheme":
ret (k == "dark" and env.dark) or (k == "light" and not env.dark)
end
"prefers-reduced-motion":
ret (k == "reduce" and env.reduced_motion) or (k == "no-preference" and not env.reduced_motion)
end
"hover", "any-hover":
ret (k == "hover" and env.hover) or (k == "none" and not env.hover)
end
"pointer", "any-pointer":
if k == "fine":
ret env.fine_pointer
end
if k == "coarse":
ret not env.fine_pointer
end
ret false
end
"prefers-contrast", "prefers-reduced-transparency", "prefers-reduced-data":
ret k == "no-preference"
end
"forced-colors", "inverted-colors":
ret k == "none"
end
"display-mode":
ret k == "browser" or k == "standalone"
end
"scripting":
ret k == "enabled"
end
"update":
ret k == "fast"
end
"color-gamut":
ret k == "srgb"
end
"dynamic-range", "video-dynamic-range":
ret k == "standard"
end
else:
end
end
mut v := 0.0
mut is_len := true
if not feature_value(base, env, v, is_len):
ret false
end
mut want := 0.0
if read_mvalue(t, vs, e, is_len, want) != e:
ret false
end
switch prefix:
1: ret v >= want end
2: ret v <= want end
else: ret v == want end
end
ret false
end
if single(t, s, e) and t[s].k == TK_IDENT:
name := t[s].s
switch name:
"hover", "any-hover": ret env.hover end
"pointer", "any-pointer": ret true end
"color": ret true end
"monochrome", "grid", "prefers-reduced-motion", "forced-colors", "inverted-colors", "prefers-contrast", "prefers-reduced-transparency":
ret name == "prefers-reduced-motion" and env.reduced_motion
end
"prefers-color-scheme": ret true end
else:
mut v := 0.0
mut il := true
ret feature_value(name, env, v, il) and v != 0.0
end
end
end
mut i := s
mut v1 := 0.0
mut op1 := ""
mut fname := ""
mut has_left := false
if t[i].k != TK_IDENT:
mut il := true
if t[i].k == TK_NUM:
il = false
end
j := read_mvalue(t, i, e, il, v1)
if j < 0:
ret false
end
k := read_op(t, j, e, op1)
if k < 0:
ret false
end
i = k
has_left = true
end
if i >= e or t[i].k != TK_IDENT:
ret false
end
fname = t[i].s
mut fv := 0.0
mut flen := true
if not feature_value(fname, env, fv, flen):
ret false
end
i++
if has_left and not compare(v1, op1, fv) and op1 != "=":
ret false
end
if has_left and op1 == "=" and v1 != fv:
ret false
end
if i >= e:
ret has_left
end
mut op2 := ""
k2 := read_op(t, i, e, op2)
if k2 < 0:
ret false
end
mut v2 := 0.0
if read_mvalue(t, k2, e, flen, v2) != e:
ret false
end
ret compare(fv, op2, v2)
end
func media_cond(t: Vector<Tok>, s: int, e: int, env: Env): bool:
if is_kw(t, s, e, "not"):
ret not media_in_parens(t, s + 1, e, env)
end
mut result := media_in_parens(t, s, e, env)
mut i := nxt(t, s)
until i < e:
if not (t[i].k == TK_IDENT and (t[i].s == "and" or t[i].s == "or")) or i + 1 >= e:
ret false
end
r := media_in_parens(t, i + 1, nxt(t, i + 1), env)
if t[i].s == "and":
result = result and r
else:
result = result or r
end
i = nxt(t, i + 1)
end
ret result
end
func media_in_parens(t: Vector<Tok>, s: int, e: int, env: Env): bool:
if s >= e or t[s].k != TK_FUNC or t[s].s.len() != 0:
ret false
end
is := s + 1
ie := t[s].close
if is < ie and (t[is].k == TK_FUNC and t[is].s.len() == 0 or is_kw(t, is, ie, "not")):
ret media_cond(t, is, ie, env)
end
ret media_feature(t, is, ie, env)
end
func media_query(t: Vector<Tok>, s: int, e: int, env: Env): bool:
if s >= e:
ret false
end
if t[s].k == TK_FUNC:
ret media_cond(t, s, e, env)
end
mut i := s
mut negate := false
if is_kw(t, i, e, "not"):
negate = true
i++
else is_kw(t, i, e, "only"):
i++
end
if i >= e or t[i].k != TK_IDENT:
ret false
end
typ := t[i].s
mut ok := typ == "all" or typ == "screen"
if not ok and typ != "print" and typ != "speech" and typ != "tty" and typ != "tv" and typ != "projection" and typ != "handheld" and typ != "braille" and typ != "embossed" and typ != "aural":
ret false
end
i++
if i < e:
if not is_kw(t, i, e, "and") or i + 1 >= e:
ret false
end
ok = ok and media_cond(t, i + 1, e, env)
end
ret negate ? not ok : ok
end
func media_toks_match(t: Vector<Tok>, s: int, e: int, env: Env): bool:
if e <= s:
ret true
end
mut result := false
mut parts := Vector {} as Vector<int>
split_commas(t, s, e, parts)
mut k := 0
until k + 1 < parts.len():
if media_query(t, parts[k], parts[k + 1], env):
result = true
end
k += 2
end
parts.free()
ret result
end
func media_matches(text: str, env: Env): bool:
mut t := Vector {} as Vector<Tok>
tokenize(text, t)
result := media_toks_match(t, 0, t.len(), env)
free_toks(t, 0)
t.free()
ret result
end
package css
const KW_A := 0
const KW_A98_RGB := 1
const KW_ABS := 2
const KW_ABSOLUTE := 3
const KW_ACCENT_COLOR := 4
const KW_ACCENTCOLOR := 5
const KW_ACCENTCOLORTEXT := 6
const KW_ACTIVETEXT := 7
const KW_ALIAS := 8
const KW_ALIGN_CONTENT := 9
const KW_ALIGN_ITEMS := 10
const KW_ALIGN_SELF := 11
const KW_ALL := 12
const KW_ALL_PETITE_CAPS := 13
const KW_ALL_SCROLL := 14
const KW_ALL_SMALL_CAPS := 15
const KW_ALPHA := 16
