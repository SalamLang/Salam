@en "Address"
@fa "نشانی"
pub struct Address:
@en "kind"
@fa "نوع"
pub kind: int = 0
@en "host"
@fa "میزبان"
pub host: str = ""
@en "port"
@fa "درگاه"
pub port: int = 0
end
@en "Request"
@fa "درخواست"
pub struct Request:
@en "version"
@fa "نسخه"
pub version: int = 0
@en "cmd"
@fa "فرمان"
pub cmd: int = 0
@en "addr"
@fa "نشانی"
pub addr: Address = Address {}
@en "user"
@fa "کاربر"
pub user: str = ""
end
@en "Reply"
@fa "پاسخ"
pub struct Reply:
@en "version"
@fa "نسخه"
pub version: int = 0
@en "code"
@fa "کد"
pub code: int = 0
@en "addr"
@fa "نشانی"
pub addr: Address = Address {}
end
@en "UDPHeader"
@fa "سرآیند یو دی پی"
pub struct UDPHeader:
@en "frag"
@fa "قطعه"
pub frag: int = 0
@en "addr"
@fa "نشانی"
pub addr: Address = Address {}
@en "length"
@fa "طول سرآیند"
pub length: int = 0
end
inline func _b(v: Vector<u8>, i: int): int:
ret v.get(i) as int
end
func _digit(c: int): int:
if c >= 48 and c <= 57: ret c - 48 end
if c >= 97 and c <= 102: ret c - 87 end
if c >= 65 and c <= 70: ret c - 55 end
ret 0 - 1
end
func _ch(s: str, i: int): int:
p := s as u8*
ret p[i] as int
end
func _put16(v &: Vector<u8>, n: int):
v.push(((n >> 8) & 255) as u8)
v.push((n & 255) as u8)
end
func _put_str(v &: Vector<u8>, s: str):
n := s.len()
repeat n in i:
v.push(_ch(s, i) as u8)
end
end
func _bytes_str(v: Vector<u8>, off: int, n: int): str:
buf := mem.AllocateZeroed((n + 1) as u64)
defer mem.Free(buf)
p := buf as u8*
repeat n in i:
p[i] = v.get(off + i)
end
ret str.Clone(buf as str)
end
func _v6_groups(part: str, groups &: Vector<int>): bool:
n := part.len()
if n == 0: ret true end
mut val := 0
mut digits := 0
mut i := 0
mut seg_start := 0
until i <= n:
mut c := 58
if i < n: c = _ch(part, i) end
if c == 58:
if digits == 0: ret false end
groups.push(val)
val = 0
digits = 0
seg_start = i + 1
else c == 46:
tail := part.substr(seg_start, n - seg_start)
mut b4 := Vector {} as Vector<u8>
defer b4.free()
if not ParseIPv4(tail, b4): ret false end
if groups.len() > 0 and digits == 0 and seg_start == i: ret false end
groups.push(_b(b4, 0) * 256 + _b(b4, 1))
groups.push(_b(b4, 2) * 256 + _b(b4, 3))
ret true
else:
d := _digit(c)
if d < 0: ret false end
val = val * 16 + d
digits++
if digits > 4: ret false end
end
i++
end
ret true
end
func _hex(n: int): str:
digits := "0123456789abcdef"
mut out := ""
mut x := n
if x == 0: ret "0" end
until x > 0:
out = digits.substr(x & 15, 1) + out
x >>= 4
end
ret out
end
@en "ParseIPv4"
@fa "تجزیه آی‌پی۴"
pub func ParseIPv4(s: str, out &: Vector<u8>): bool:
n := s.len()
if n < 7 or n > 15: ret false end
mut parts := 0
mut val := 0
mut digits := 0
mut tmp := Vector {} as Vector<u8>
defer tmp.free()
repeat n in i:
c := _ch(s, i)
if c == 46:
if digits == 0: ret false end
tmp.push(val as u8)
parts++
val = 0
digits = 0
else c >= 48 and c <= 57:
val = val * 10 + (c - 48)
digits++
if digits > 3 or val > 255: ret false end
else:
ret false
end
end
if digits == 0 or parts != 3: ret false end
tmp.push(val as u8)
out.clear()
repeat 4 in k:
out.push(tmp.get(k))
end
ret true
end
@en "ParseIPv6"
@fa "تجزیه آی‌پی۶"
pub func ParseIPv6(s: str, out &: Vector<u8>): bool:
n := s.len()
if n < 2 or n > 45: ret false end
dc := s.find("::")
mut head := Vector {} as Vector<int>
mut tail := Vector {} as Vector<int>
defer head.free()
defer tail.free()
mut ok := false
if dc < 0:
ok = _v6_groups(s, head)
if not ok or head.len() != 8: ret false end
else:
rest := s.substr(dc + 2, n - dc - 2)
if rest.find("::") >= 0: ret false end
if not _v6_groups(s.substr(0, dc), head): ret false end
if not _v6_groups(rest, tail): ret false end
if head.len() + tail.len() > 7: ret false end
mut fill := 8 - head.len() - tail.len()
until fill > 0:
head.push(0)
fill--
end
repeat tail.len() in i:
head.push(tail.get(i))
end
end
out.clear()
repeat 8 in g:
w := head.get(g)
out.push(((w >> 8) & 255) as u8)
out.push((w & 255) as u8)
end
ret true
end
@en "FormatIPv4"
@fa "قالب آی‌پی۴"
pub func FormatIPv4(v: Vector<u8>, off: int): str:
ret str.FromInt(_b(v, off) as i64) + "." + str.FromInt(_b(v, off + 1) as i64) + "." + str.FromInt(_b(v, off + 2) as i64) + "." + str.FromInt(_b(v, off + 3) as i64)
end
@en "FormatIPv6"
@fa "قالب آی‌پی۶"
pub func FormatIPv6(v: Vector<u8>, off: int): str:
mut g := Vector {} as Vector<int>
defer g.free()
repeat 8 in i:
g.push(_b(v, off + 2 * i) * 256 + _b(v, off + 2 * i + 1))
end
mut best_at := 0 - 1
mut best_len := 0
mut i := 0
until i < 8:
if g.get(i) == 0:
mut j := i
until j < 8 and g.get(j) == 0:
j++
end
if j - i > best_len:
best_len = j - i
best_at = i
end
i = j
else:
i++
end
end
if best_len < 2: best_at = 0 - 1 end
mut out := ""
mut k := 0
until k < 8:
if k == best_at:
out += "::"
k += best_len
else:
if out.len() > 0 and not out.ends_with(":"): out += ":" end
out += _hex(g.get(k))
k++
end
end
ret out
end
@en "ClassifyHost"
@fa "دسته‌بندی میزبان"
pub func ClassifyHost(host: str): int:
mut b := Vector {} as Vector<u8>
defer b.free()
if ParseIPv4(host, b): ret AtypIPv4 end
if host.find(":") >= 0 and ParseIPv6(host, b): ret AtypIPv6 end
ret AtypDomain
end
@en "NewAddress"
@fa "نشانی جدید"
pub func NewAddress(host: str, port: int): Address:
mut h := host
n := h.len()
if n > 2 and h.char_at(0) == "[" and h.char_at(n - 1) == "]":
h = h.substr(1, n - 2)
end
ret Address { kind = ClassifyHost(h), host = h, port = port }
end
@en "EncodeAddress"
@fa "رمزگذاری نشانی"
pub func EncodeAddress(a: Address): Vector<u8>:
mut v := Vector {} as Vector<u8>
if a.port < 0 or a.port > 65535: ret v end
if a.kind == AtypIPv4:
mut b := Vector {} as Vector<u8>
defer b.free()
if not ParseIPv4(a.host, b): ret v end
v.push(1 as u8)
repeat 4 in i:
v.push(b.get(i))
end
else a.kind == AtypIPv6:
mut b := Vector {} as Vector<u8>
defer b.free()
if not ParseIPv6(a.host, b): ret v end
v.push(4 as u8)
repeat 16 in i:
v.push(b.get(i))
end
else a.kind == AtypDomain:
n := a.host.len()
if n < 1 or n > 255: ret v end
v.push(3 as u8)
v.push(n as u8)
_put_str(v, a.host)
else:
ret v
end
_put16(v, a.port)
ret v
end
@en "DecodeAddress"
@fa "رمزگشایی نشانی"
pub func DecodeAddress(data: Vector<u8>, off: int, out &: Address): int:
have := data.len() - off
if have < 1: ret 0 end
t := _b(data, off)
if t == AtypIPv4:
if have < 7: ret 0 end
out.kind = AtypIPv4
out.host = FormatIPv4(data, off + 1)
out.port = _b(data, off + 5) * 256 + _b(data, off + 6)
ret 7
else t == AtypIPv6:
if have < 19: ret 0 end
out.kind = AtypIPv6
out.host = FormatIPv6(data, off + 1)
out.port = _b(data, off + 17) * 256 + _b(data, off + 18)
ret 19
else t == AtypDomain:
if have < 2: ret 0 end
n := _b(data, off + 1)
if n == 0: ret 0 - 1 end
if have < 4 + n: ret 0 end
out.kind = AtypDomain
out.host = _bytes_str(data, off + 2, n)
out.port = _b(data, off + 2 + n) * 256 + _b(data, off + 3 + n)
ret 4 + n
end
ret 0 - 1
end
@en "EncodeGreeting"
@fa "رمزگذاری سلام"
pub func EncodeGreeting(methods: Vector<u8>): Vector<u8>:
mut v := Vector {} as Vector<u8>
v.push(5 as u8)
v.push(methods.len() as u8)
repeat methods.len() in i:
v.push(methods.get(i))
end
ret v
end
@en "EncodeMethodChoice"
@fa "رمزگذاری انتخاب روش"
pub func EncodeMethodChoice(method: int): Vector<u8>:
mut v := Vector {} as Vector<u8>
v.push(5 as u8)
v.push(method as u8)
ret v
end
@en "EncodeAuthRequest"
@fa "رمزگذاری درخواست احراز هویت"
pub func EncodeAuthRequest(user: str, pass: str): Vector<u8>:
mut v := Vector {} as Vector<u8>
if user.len() < 1 or user.len() > 255 or pass.len() > 255: ret v end
v.push(1 as u8)
v.push(user.len() as u8)
_put_str(v, user)
v.push(pass.len() as u8)
_put_str(v, pass)
ret v
end
@en "EncodeAuthReply"
@fa "رمزگذاری پاسخ احراز هویت"
pub func EncodeAuthReply(ok: bool): Vector<u8>:
mut v := Vector {} as Vector<u8>
v.push(1 as u8)
if ok: v.push(0 as u8) else:
v.push(1 as u8)
end
ret v
end
@en "EncodeRequest"
@fa "رمزگذاری درخواست"
pub func EncodeRequest(cmd: int, a: Address): Vector<u8>:
mut v := Vector {} as Vector<u8>
enc := EncodeAddress(a)
defer enc.free()
if enc.len() == 0: ret v end
v.push(5 as u8)
v.push(cmd as u8)
v.push(0 as u8)
repeat enc.len() in i:
v.push(enc.get(i))
end
ret v
end
@en "EncodeReply"
@fa "رمزگذاری پاسخ"
pub func EncodeReply(code: int, a: Address): Vector<u8>:
mut v := Vector {} as Vector<u8>
mut addr := a
if addr.kind == 0: addr = Address { kind = AtypIPv4, host = "0.0.0.0", port = 0 } end
enc := EncodeAddress(addr)
defer enc.free()
if enc.len() == 0: ret v end
v.push(5 as u8)
v.push(code as u8)
v.push(0 as u8)
repeat enc.len() in i:
v.push(enc.get(i))
end
ret v
end
@en "DecodeRequest"
@fa "رمزگشایی درخواست"
pub func DecodeRequest(data: Vector<u8>, out &: Request): int:
if data.len() < 4: ret 0 end
if _b(data, 0) != 5 or _b(data, 2) != 0: ret 0 - 1 end
mut a := Address {}
n := DecodeAddress(data, 3, a)
if n <= 0: ret n end
out.version = 5
out.cmd = _b(data, 1)
out.addr = a
ret 3 + n
end
@en "DecodeReply"
@fa "رمزگشایی پاسخ"
pub func DecodeReply(data: Vector<u8>, out &: Reply): int:
if data.len() < 4: ret 0 end
if _b(data, 0) != 5 or _b(data, 2) != 0: ret 0 - 1 end
mut a := Address {}
n := DecodeAddress(data, 3, a)
if n <= 0: ret n end
out.version = 5
out.code = _b(data, 1)
out.addr = a
ret 3 + n
end
@en "EncodeUDPHeader"
@fa "رمزگذاری سرآیند یو دی پی"
pub func EncodeUDPHeader(a: Address, frag: int): Vector<u8>:
mut v := Vector {} as Vector<u8>
enc := EncodeAddress(a)
defer enc.free()
if enc.len() == 0: ret v end
v.push(0 as u8)
v.push(0 as u8)
v.push(frag as u8)
repeat enc.len() in i:
v.push(enc.get(i))
end
ret v
end
@en "DecodeUDPHeader"
@fa "رمزگشایی سرآیند یو دی پی"
pub func DecodeUDPHeader(data: Vector<u8>, out &: UDPHeader): bool:
if data.len() < 4: ret false end
if _b(data, 0) != 0 or _b(data, 1) != 0: ret false end
mut a := Address {}
n := DecodeAddress(data, 3, a)
if n <= 0: ret false end
out.frag = _b(data, 2)
out.addr = a
out.length = 3 + n
ret true
end
@en "Encode4Request"
@fa "رمزگذاری درخواست ساکس۴"
pub func Encode4Request(cmd: int, host: str, port: int, user: str): Vector<u8>:
mut v := Vector {} as Vector<u8>
if port < 0 or port > 65535 or user.len() > 255: ret v end
mut ip := Vector {} as Vector<u8>
defer ip.free()
mut domain := false
if not ParseIPv4(host, ip):
if host.len() < 1 or host.len() > 255: ret v end
domain = true
end
v.push(4 as u8)
v.push(cmd as u8)
_put16(v, port)
if domain:
v.push(0 as u8)
v.push(0 as u8)
v.push(0 as u8)
v.push(1 as u8)
else:
repeat 4 in i:
v.push(ip.get(i))
end
end
_put_str(v, user)
v.push(0 as u8)
if domain:
_put_str(v, host)
v.push(0 as u8)
end
ret v
end
@en "Decode4Request"
@fa "رمزگشایی درخواست ساکس۴"
pub func Decode4Request(data: Vector<u8>, out &: Request): int:
n := data.len()
if n < 9: ret 0 end
if _b(data, 0) != 4: ret 0 - 1 end
mut pos := 8
until pos < n and _b(data, pos) != 0:
pos++
if pos - 8 > 255: ret 0 - 1 end
end
if pos >= n: ret 0 end
user := _bytes_str(data, 8, pos - 8)
pos++
port := _b(data, 2) * 256 + _b(data, 3)
mut host := ""
mut kind := AtypIPv4
if _b(data, 4) == 0 and _b(data, 5) == 0 and _b(data, 6) == 0 and _b(data, 7) != 0:
start := pos
until pos < n and _b(data, pos) != 0:
pos++
if pos - start > 255: ret 0 - 1 end
end
if pos >= n: ret 0 end
if pos == start: ret 0 - 1 end
host = _bytes_str(data, start, pos - start)
kind = AtypDomain
pos++
else:
host = FormatIPv4(data, 4)
end
out.version = 4
out.cmd = _b(data, 1)
out.user = user
out.addr = Address { kind = kind, host = host, port = port }
ret pos
end
@en "Encode4Reply"
@fa "رمزگذاری پاسخ ساکس۴"
pub func Encode4Reply(code: int, host: str, port: int): Vector<u8>:
mut v := Vector {} as Vector<u8>
v.push(0 as u8)
v.push(code as u8)
_put16(v, port)
mut ip := Vector {} as Vector<u8>
defer ip.free()
if not ParseIPv4(host, ip):
repeat 4:
ip.push(0 as u8)
end
end
repeat 4 in i:
v.push(ip.get(i))
end
ret v
end
@en "Decode4Reply"
@fa "رمزگشایی پاسخ ساکس۴"
pub func Decode4Reply(data: Vector<u8>, out &: Reply): bool:
if data.len() < 8: ret false end
if _b(data, 0) != 0: ret false end
out.version = 4
out.code = _b(data, 1)
out.addr = Address { kind = AtypIPv4, host = FormatIPv4(data, 4), port = _b(data, 2) * 256 + _b(data, 3) }
ret true
end
@en "ReplyText"
@fa "متن پاسخ"
pub func ReplyText(code: int): str:
switch code:
0: ret "succeeded" end
1: ret "general SOCKS server failure" end
2: ret "connection not allowed by ruleset" end
3: ret "network unreachable" end
4: ret "host unreachable" end
5: ret "connection refused" end
6: ret "TTL expired" end
7: ret "command not supported" end
8: ret "address type not supported" end
90: ret "request granted" end
91: ret "request rejected or failed" end
92: ret "request rejected, identd unreachable" end
93: ret "request rejected, identd mismatch" end
end
ret "unknown reply code"
end
@en "ToHex"
@fa "به هگز"
pub func ToHex(v: Vector<u8>): str:
mut out := ""
repeat v.len() in i:
b := _b(v, i)
if b < 16: out += "0" end
out += _hex(b)
end
ret out
end
@en "net/tcp"
@fa "تی سی پی"
package tcp
import net.internal.rawsock
import conv
import sync
import tls
@en "Server"
@fa "سرور"
pub struct Server:
@en "fd"
@fa "توصیفگر"
pub fd: i64 = 0 - 1
@en "port"
@fa "درگاه"
pub port: int = 0
end
@en "Conn"
@fa "اتصال شبکه"
pub struct Conn:
@en "fd"
@fa "توصیفگر"
pub fd: i64 = 0 - 1
end
@en "PoolEntry"
@fa "مدخل استخر"
pub struct PoolEntry:
@en "key"
@fa "کلید"
pub key: str = ""
@en "conn"
@fa "اتصال"
pub conn: Conn = Conn {}
@en "put_at_ms"
@fa "زمان بازگشت میلی‌ثانیه"
pub put_at_ms: i64 = 0
end
@en "PoolEntries"
@fa "مدخل‌های استخر"
pub struct PoolEntries:
@en "items"
@fa "مدخل‌ها"
pub items: Vector<PoolEntry> = Vector {}
end
@en "Pool"
@fa "استخر اتصال"
pub struct Pool:
@en "entries"
@fa "اتصال‌های بی‌کار"
pub entries: PoolEntries = PoolEntries {}
@en "idle_ttl_ms"
@fa "بیشترین بی‌کاری میلی‌ثانیه"
pub idle_ttl_ms: i64 = 30000
end
func _sock(fd: i64): rawsock.Socket:
ret rawsock.FromFd(fd)
end
func _pool_key(host: str, port: int): str:
ret host + ":" + conv.FormatInt(port as i64)
end
@en "Bind"
@fa "پیوند"
pub func Bind(port: int): Server:
ret Server { fd = rawsock.Listen(port).fd, port = port }
end
@en "BindOn"
@fa "پیوند روی"
pub func BindOn(host: str, port: int): Server:
ret Server { fd = rawsock.ListenOn(host, port, rawsock.SOCK_STREAM).fd, port = port }
end
@en "BindDual"
@fa "پیوند دوگانه"
pub func BindDual(port: int): Server:
ret Server { fd = rawsock.ListenDual(port, rawsock.SOCK_STREAM).fd, port = port }
end
@en "BindV6"
@fa "پیوند آی‌پی۶"
pub func BindV6(host: str, port: int, v6only: bool): Server:
ret Server { fd = rawsock.ListenV6(host, port, rawsock.SOCK_STREAM, v6only).fd, port = port }
end
@en "Ok"
@fa "معتبر"
pub func Ok(srv: Server): bool:
ret srv.fd >= 0
end
@en "Port"
@fa "درگاه"
pub func Port(srv: Server): int:
ret rawsock.LocalPort(_sock(srv.fd))
end
@en "Accept"
@fa "پذیرش"
pub func Accept(srv: Server): Conn:
ret Conn { fd = rawsock.Accept(_sock(srv.fd)).fd }
end
@en "LocalAddr"
@fa "نشانی سرور"
pub func LocalAddr(srv: Server): str:
mut port := 0
ret rawsock.LocalAddr(_sock(srv.fd), port)
end
@en "PeerAddr"
@fa "نشانی همتای اتصال"
pub func PeerAddr(c: Conn): str:
mut port := 0
ret rawsock.PeerAddr(_sock(c.fd), port)
end
@en "PeerPort"
@fa "درگاه همتای اتصال"
pub func PeerPort(c: Conn): int:
mut port := 0
rawsock.PeerAddr(_sock(c.fd), port)
ret port
end
@en "ConnLocalAddr"
@fa "نشانی محلی اتصال"
pub func ConnLocalAddr(c: Conn): str:
mut port := 0
ret rawsock.LocalAddr(_sock(c.fd), port)
end
@en "JoinHostPort"
@fa "ساخت نشانی میزبان درگاه"
pub func JoinHostPort(host: str, port: int): str:
ret rawsock.HostPort(host, port)
end
@en "CloseServer"
@fa "بستن سرور"
pub func CloseServer(srv: Server):
rawsock.Close(_sock(srv.fd))
end
@en "ConnOk"
@fa "اتصال معتبر"
pub func ConnOk(c: Conn): bool:
ret c.fd >= 0
end
@en "Read"
@fa "خواندن"
pub func Read(c: Conn, max: int): str:
ret rawsock.Recv(_sock(c.fd), max)
end
@en "Write"
@fa "نوشتن"
pub func Write(c: Conn, data: str): int:
ret rawsock.Send(_sock(c.fd), data)
end
@en "ReadBytes"
@fa "خواندن بایت"
pub func ReadBytes(c: Conn, buf: void*, max: int): int:
ret rawsock.RecvBytes(_sock(c.fd), buf, max)
end
@en "WriteBytes"
@fa "نوشتن بایت"
pub func WriteBytes(c: Conn, ptr: void*, n: int): int:
ret rawsock.SendBytes(_sock(c.fd), ptr, n)
end
@en "Close"
@fa "بستن"
pub func Close(c: Conn):
rawsock.Close(_sock(c.fd))
end
@en "FreePort"
@fa "درگاه آزاد"
pub func FreePort(): int:
srv := Bind(0)
if not Ok(srv): ret 0 end
port := Port(srv)
CloseServer(srv)
ret port
end
@en "WaitListening"
@fa "انتظار شنود"
pub func WaitListening(host: str, port: int, timeout_ms: int): bool:
deadline := sync.NowMs() + (timeout_ms as i64)
mut up := false
mut waiting := true
until waiting:
c := Dial(host, port)
if ConnOk(c):
Close(c)
up = true
waiting = false
else sync.NowMs() >= deadline:
waiting = false
else:
sync.SleepMs(20)
end
end
ret up
end
@en "Dial"
@fa "شماره گیری"
pub func Dial(host: str, port: int): Conn:
ret Conn { fd = rawsock.Connect(host, port).fd }
end
@en "DialTimeout"
@fa "شماره گیری با مهلت"
pub func DialTimeout(host: str, port: int, millis: int): Conn:
ret Conn { fd = rawsock.ConnectTimeout(host, port, millis).fd }
end
@en "DialAnyTimeout"
@fa "شماره گیری چند نشانی با مهلت"
pub func DialAnyTimeout(hosts &: Vector<str>, port: int, millis: int): Conn:
ret Conn { fd = rawsock.ConnectAnyTimeout(hosts, port, millis).fd }
end
@en "WakeServer"
@fa "بیدار کردن سرور"
pub func WakeServer(host: str, port: int):
h := rawsock.CanonIP(host)
mut targets := Vector {} as Vector<str>
if h.len() == 0 or h == "0.0.0.0":
targets.push("127.0.0.1")
else h == "::":
targets.push("127.0.0.1")
targets.push("::1")
else:
targets.push(h)
end
repeat targets.len() in i:
c := DialTimeout(targets.get(i), port, 1000)
if ConnOk(c):
Close(c)
targets.free()
ret
end
end
targets.free()
end
@en "DialTLS"
@fa "شماره گیری امن"
pub func DialTLS(host: str, port: int): tls.Conn:
cfg := tls.NewConfig(host)
ret tls.Dial(host, port, cfg)
end
@en "UpgradeTLS"
@fa "ارتقا به تی ال اس"
pub func UpgradeTLS(c: Conn, cfg: tls.Config): tls.Conn:
ret tls.WrapClient(c.fd, cfg)
end
@en "ConnFromFd"
@fa "اتصال از توصیف‌گر"
pub func ConnFromFd(fd: i64): Conn:
ret Conn { fd = fd }
end
@en "WriteHTTP"
@fa "نوشتن اچ تی تی پی"
pub func WriteHTTP(c: Conn, status_line: str, content_type: str, body: str):
blen := conv.FormatInt(len(body) as i64)
resp := "HTTP/1.1 " + status_line + "\r\n" + "Content-Type: " + content_type + "\r\n" + "Content-Length: " + blen + "\r\n" + "Connection: close\r\n\r\n" + body
rawsock.Send(_sock(c.fd), resp)
end
@en "SetReadDeadline"
@fa "تنظیم مهلت خواندن"
pub func SetReadDeadline(c: Conn, millis: int):
rawsock.SetTimeout(_sock(c.fd), millis)
end
@en "SetWriteDeadline"
@fa "تنظیم مهلت نوشتن"
pub func SetWriteDeadline(c: Conn, millis: int):
rawsock.SetTimeout(_sock(c.fd), millis)
end
@en "SetDeadline"
@fa "تنظیم مهلت"
pub func SetDeadline(c: Conn, millis: int):
rawsock.SetTimeout(_sock(c.fd), millis)
end
@en "SetKeepAlive"
@fa "تنظیم زنده‌نگه‌داری"
pub func SetKeepAlive(c: Conn, enable: bool):
rawsock.SetKeepAlive(_sock(c.fd), enable)
end
@en "SetNoDelay"
@fa "غیرفعال‌سازی نگل"
pub func SetNoDelay(c: Conn, enable: bool):
rawsock.SetNoDelay(_sock(c.fd), enable)
end
@en "NewPool"
@fa "استخر جدید"
pub func NewPool(): Pool:
ret Pool { entries = PoolEntries {}, idle_ttl_ms = 30000 }
end
@en "Get"
@fa "دریافت اتصال"
pub func Get(p &: Pool, host: str, port: int, now_ms: i64): Conn:
key := _pool_key(host, port)
n := p.entries.items.len()
mut i := 0
until i < n:
e := p.entries.items.get(i)
if e.key == key:
p.entries.items.remove_at(i)
if ConnOk(e.conn) and (now_ms - e.put_at_ms) < p.idle_ttl_ms:
ret e.conn
end
Close(e.conn)
ret Dial(host, port)
end
i++
end
ret Dial(host, port)
end
@en "Put"
@fa "بازگرداندن اتصال"
pub func Put(p &: Pool, host: str, port: int, c: Conn, now_ms: i64):
if not ConnOk(c):
ret
end
entry := PoolEntry { key = _pool_key(host, port), conn = c, put_at_ms = now_ms }
p.entries.items.push(entry)
end
@en "PoolLen"
@fa "تعداد استخر"
pub func PoolLen(p: Pool): int:
ret p.entries.items.len()
end
package transport
import mem
import str
@en "AddrIPv4"
@fa "نشانی آی پی چهار"
pub const AddrIPv4 := 1
@en "AddrDomain"
@fa "نشانی دامنه"
pub const AddrDomain := 2
@en "AddrIPv6"
@fa "نشانی آی پی شش"
pub const AddrIPv6 := 3
@en "Addr"
@fa "نشانی"
pub struct Addr:
@en "kind"
@fa "نوع"
pub kind: int = 2
@en "host"
@fa "میزبان"
pub host: str = ""
@en "port"
@fa "درگاه"
pub port: int = 0
end
func _parse_ipv4(s: str, out: u8*): bool:
sp := s as u8*
n := s.len()
mut part := 0
mut digits := 0
mut idx := 0
repeat n + 1 in i:
mut ch := 46
if i < n:
ch = sp[i] as int
end
if ch == 46:
if digits == 0 or idx > 3 or part > 255:
ret false
end
out[idx] = part as u8
idx++
part = 0
digits = 0
else ch >= 48 and ch <= 57:
part = part * 10 + (ch - 48)
digits++
if digits > 3:
ret false
end
else:
ret false
end
end
ret idx == 4
end
func _hexdigit(c: int): int:
if c >= 48 and c <= 57: ret c - 48 end
if c >= 97 and c <= 102: ret c - 87 end
if c >= 65 and c <= 70: ret c - 55 end
ret 0 - 1
end
func _parse_groups(s: str, out: int*, start: int): int:
n := s.len()
if n == 0:
ret 0
end
sp := s as u8*
mut count := 0
mut val := 0
mut digits := 0
repeat n + 1 in i:
mut ch := 58
if i < n:
ch = sp[i] as int
end
if ch == 58:
if digits == 0 or digits > 4 or start + count >= 8:
ret 0 - 1
end
out[start + count] = val
count++
val = 0
digits = 0
else:
h := _hexdigit(ch)
if h < 0:
ret 0 - 1
end
val = val * 16 + h
digits++
end
end
ret count
end
func _parse_ipv6(s: str, out: u8*): bool:
groups := mem.AllocateZeroed(64 as u64) as int*
defer mem.Free(groups as void*)
dc := s.find("::")
if dc < 0:
if _parse_groups(s, groups, 0) != 8:
ret false
end
else:
left := s.substr(0, dc)
right := s.substr(dc + 2, s.len() - dc - 2)
if right.find("::") >= 0:
ret false
end
nl := _parse_groups(left, groups, 0)
if nl < 0:
ret false
end
rg := mem.AllocateZeroed(64 as u64) as int*
defer mem.Free(rg as void*)
nr := _parse_groups(right, rg, 0)
if nr < 0 or nl + nr > 7:
ret false
end
repeat nr in i:
groups[8 - nr + i] = rg[i]
end
end
repeat 8 in i:
out[2 * i] = ((groups[i] >> 8) & 255) as u8
out[2 * i + 1] = (groups[i] & 255) as u8
end
ret true
end
@en "DetectKind"
@fa "تشخیص نوع نشانی"
pub func DetectKind(host: str): int:
tmp := mem.AllocateZeroed(16 as u64) as u8*
defer mem.Free(tmp as void*)
if _parse_ipv4(host, tmp):
ret AddrIPv4
end
if host.find(":") >= 0 and _parse_ipv6(host, tmp):
ret AddrIPv6
end
ret AddrDomain
end
@en "NewAddr"
@fa "نشانی جدید"
pub func NewAddr(host: str, port: int): Addr:
mut h := host
if h.len() > 2 and h.starts_with("["):
h = h.substr(1, h.len() - 2)
end
ret Addr { kind = DetectKind(h), host = h, port = port }
end
@en "PutAddr"
@fa "نوشتن نشانی"
pub func PutAddr(b &: Bytes, a: Addr): bool:
Put16(b, a.port)
tmp := mem.AllocateZeroed(16 as u64) as u8*
defer mem.Free(tmp as void*)
if a.kind == AddrIPv4:
if not _parse_ipv4(a.host, tmp): ret false end
Put8(b, 1)
PutRaw(b, tmp as void*, 4)
else a.kind == AddrIPv6:
if not _parse_ipv6(a.host, tmp): ret false end
Put8(b, 3)
PutRaw(b, tmp as void*, 16)
else:
hl := a.host.len()
if hl == 0 or hl > 255: ret false end
Put8(b, 2)
Put8(b, hl)
PutStr(b, a.host)
end
ret true
end
@en "FormatIPv6"
@fa "قالب آی پی شش"
pub func FormatIPv6(p: u8*): str:
mut best := 0 - 1
mut best_len := 0
mut cur := 0 - 1
mut cur_len := 0
repeat 8 in i:
z := (p[2 * i] as int) == 0 and (p[2 * i + 1] as int) == 0
if z:
if cur < 0:
cur = i
cur_len = 0
end
cur_len++
if cur_len > best_len:
best = cur
best_len = cur_len
end
else:
cur = 0 - 1
cur_len = 0
end
end
if best_len < 2:
best = 0 - 1
end
mut out := ""
mut i := 0
until i < 8:
if i == best:
out += "::"
i += best_len
else:
if out.len() > 0 and not out.ends_with(":"):
out += ":"
end
v := (p[2 * i] as int) * 256 + (p[2 * i + 1] as int)
mut g := ""
mut started := false
repeat 4 in k:
d := (v >> (12 - 4 * k)) & 15
if d != 0 or started or k == 3:
started = true
g += "0123456789abcdef".substr(d, 1)
end
end
out += g
i++
end
end
ret out
end
@en "ReadAddr"
@fa "خواندن نشانی"
pub func ReadAddr(b: Bytes, off: int, a &: Addr): int:
if off + 4 > b.len: ret 0 - 1 end
a.port = Peek16(b, off)
k := At(b, off + 2)
mut p := off + 3
if k == 1:
if p + 4 > b.len: ret 0 - 1 end
a.kind = 1
a.host = str.FromInt(At(b, p) as i64) + "." + str.FromInt(At(b, p + 1) as i64) + "." + str.FromInt(At(b, p + 2) as i64) + "." + str.FromInt(At(b, p + 3) as i64)
ret p + 4
else k == 3:
if p + 16 > b.len: ret 0 - 1 end
a.kind = 3
a.host = FormatIPv6(((b.p as i64) + (p as i64)) as u8*)
ret p + 16
else k == 2:
hl := At(b, p)
p++
if hl == 0 or p + hl > b.len: ret 0 - 1 end
a.kind = 2
raw := mem.Allocate((hl + 1) as u64)
mem.Copy(raw, ((b.p as i64) + (p as i64)) as void*, hl as u64)
rp := raw as u8*
rp[hl] = 0 as u8
a.host = raw as str
ret p + hl
end
ret 0 - 1
end
@en "ParseUUID"
@fa "تجزیه یو یو آی دی"
pub func ParseUUID(s: str): Bytes:
mut b := NewBytes(16)
sp := s as u8*
mut hi := 0 - 1
repeat s.len() in i:
ch := sp[i] as int
if ch == 45:
continue
end
h := _hexdigit(ch)
if h < 0:
b.bad = true
ret b
end
if hi < 0:
hi = h
else:
Put8(b, hi * 16 + h)
hi = 0 - 1
end
end
if hi >= 0 or b.len != 16:
b.bad = true
end
ret b
end
@en "FormatUUID"
@fa "قالب یو یو آی دی"
pub func FormatUUID(b: Bytes): str:
h := ToHex(b)
if h.len() != 32:
ret h
end
ret h.substr(0, 8) + "-" + h.substr(8, 4) + "-" + h.substr(12, 4) + "-" + h.substr(16, 4) + "-" + h.substr(20, 12)
end
package transport
import mem
import sync
import str
import crypto
import rand
import encoding
import tls
import chan
import net.tcp
import net.internal.rawsock
import net.websocket
import net.tunnel
import net.reality
@en "KindTCP"
@fa "نوع تی سی پی"
pub const KindTCP := 0
@en "KindTLS"
@fa "نوع تی ال اس"
pub const KindTLS := 1
@en "KindStream"
@fa "نوع جریان"
pub const KindStream := 2
struct _Hs:
pub host: str = ""
pub fd: i64 = 0 - 1
pub l: Listener = Listener {}
pub st: i64* = null
pub mu: sync.Mutex = sync.Mutex {}
pub cv: sync.CondVar = sync.CondVar {}
end
struct _StreamAdapter:
pub c: Conn = Conn {}
pub func Read(max: int): str:
buf := mem.Allocate((max + 1) as u64)
n := _stream_read(this.c, buf, max)
if n <= 0:
mem.Free(buf)
ret ""
end
bp := buf as u8*
bp[n] = 0 as u8
ret buf as str
end
pub func ReadBytes(buf: void*, max: int): int:
ret _stream_read(this.c, buf, max)
end
pub func Write(data: str): int:
if not _stream_write(this.c, data as void*, data.len()):
ret 0 - 1
end
ret data.len()
end
pub func WriteBytes(ptr: void*, n: int): int:
if not _stream_write(this.c, ptr, n):
ret 0 - 1
end
ret n
end
pub func SetDeadline(millis: int):
if millis == tunnel.DeadlineDirect:
SwitchDirect(this.c)
ret
end
_stream_timeout(this.c, millis)
end
pub func Shutdown():
ShutdownConn(this.c)
end
pub func CloseWrite():
CloseWriteConn(this.c)
end
pub func Close():
_stream_close(this.c)
end
pub func Ok(): bool:
ret this.c.open
end
end
@en "Settings"
@fa "تنظیمات"
pub struct Settings:
@en "network"
@fa "شبکه"
pub network: str = "tcp"
@en "tls"
@fa "تی ال اس"
pub tls: bool = false
@en "sni"
@fa "نام سرور"
pub sni: str = ""
@en "alpn"
@fa "الپن"
pub alpn: str = ""
@en "fingerprint"
@fa "اثر انگشت"
pub fingerprint: str = ""
@en "allow_insecure"
@fa "اجازه ناامن"
pub allow_insecure: bool = false
@en "ca_file"
@fa "پرونده گواهی ریشه"
pub ca_file: str = ""
@en "path"
@fa "مسیر"
pub path: str = "/"
@en "host"
@fa "سربرگ میزبان"
pub host: str = ""
@en "headers"
@fa "سربرگ ها"
pub headers: str = ""
@en "early_data"
@fa "داده زودهنگام"
pub early_data: int = 0
