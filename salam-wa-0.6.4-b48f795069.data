@en "SelectBooleanWith"
@fa "انتخاب منطقی با متغیرها"
pub func SelectBooleanWith(d: Document, context: int, expression: str, variables: XPathVariables): bool throws:
mut v := try EvaluateWith(d, context, expression, variables)
