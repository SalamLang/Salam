const PEM_BEGIN := "-----BEGIN CERTIFICATE-----"
const PEM_END := "-----END CERTIFICATE-----"
const CA_PATH_0 := "/etc/ssl/certs/ca-certificates.crt"
const CA_PATH_1 := "/etc/pki/tls/certs/ca-bundle.crt"
const CA_PATH_2 := "/etc/ssl/ca-bundle.pem"
const CA_PATH_3 := "/etc/ssl/cert.pem"
const CA_PATH_4 := "/usr/local/etc/ssl/cert.pem"
const CA_PATH_5 := "/usr/local/share/certs/ca-root-nss.crt"
const CA_PATH_6 := "/etc/ssl/certs/ca-bundle.crt"
const CA_PATH_7 := "C:/Program Files/Git/mingw64/etc/ssl/certs/ca-bundle.crt"
const CA_PATH_8 := "C:/Program Files/Git/usr/ssl/certs/ca-bundle.crt"
const CA_PATH_9 := "C:/msys64/etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem"
const CA_PATH_10 := "/usr/pkg/etc/openssl/certs/ca-certificates.crt"
const CA_PATH_COUNT := 11
mut _shared_roots := Roots {}
mut _shared_key := ""
mut _shared_ready := false
func _ca_path(i: int): str:
if i == 0: ret CA_PATH_0 end
if i == 1: ret CA_PATH_1 end
if i == 2: ret CA_PATH_2 end
if i == 3: ret CA_PATH_3 end
if i == 4: ret CA_PATH_4 end
if i == 5: ret CA_PATH_5 end
if i == 6: ret CA_PATH_6 end
if i == 7: ret CA_PATH_7 end
if i == 8: ret CA_PATH_8 end
if i == 9: ret CA_PATH_9 end
if i == 10: ret CA_PATH_10 end
ret ""
end
func _roots_add_pem(r &: Roots, pem: str): int:
mut added := 0
mut pos := 0
n := pem.len()
until pos < n:
b := str.IndexFrom(pem, PEM_BEGIN, pos)
if b < 0:
ret added
end
body := b + PEM_BEGIN.len()
e := str.IndexFrom(pem, PEM_END, body)
if e < 0:
ret added
end
room := (e - body) / 4 * 3 + 8
mut der := _newbuf(room)
mut good := false
b64 := pem.substr(body, e - body)
mut got := 0
try:
got = encoding.Base64DecodeBytes(b64, der.p, room)
good = true
catch:
good = false
end
mem.Free(b64 as void*)
if good and got > 0:
c := _cert_parse(der.p, got)
if c.ok:
_roots_add(r, der.p, got)
added++
end
end
_buf_free(der)
pos = e + PEM_END.len()
end
ret added
end
func _embedded_roots_pem(): str:
ret ""
end
if SALAM_OS_WIN64:
func _roots_load_native(r &: Roots): int:
store := CertOpenSystemStoreA(0, "ROOT")
if store == null:
ret 0
end
mut added := 0
mut ctx := null as void*
mut going := true
until going:
ctx = CertEnumCertificatesInStore(store, ctx)
if ctx == null:
going = false
else:
pp := (ctx as i64 + 8) as i64*
lp := (ctx as i64 + 16) as int*
der := pp[0] as void*
dlen := lp[0]
if der != null and dlen > 0:
_roots_add(r, der, dlen)
added++
end
end
end
CertCloseStore(store, 0)
ret added
end
else:
if SALAM_OS_MAC:
func _roots_load_native(r &: Roots): int:
outbuf := mem.Allocate(8 as u64)
defer mem.Free(outbuf)
outp := outbuf as i64*
outp[0] = 0
status := SecTrustCopyAnchorCertificates(outbuf)
if status != 0:
ret 0
end
arr := outp[0] as void*
if arr == null:
ret 0
end
defer CFRelease(arr)
n := CFArrayGetCount(arr)
mut added := 0
mut i := 0 as i64
until i >= n:
cert := CFArrayGetValueAtIndex(arr, i)
if cert != null:
data := SecCertificateCopyData(cert)
if data != null:
p := CFDataGetBytePtr(data)
dlen := CFDataGetLength(data)
if p != null and dlen > 0:
_roots_add(r, p, dlen as int)
added++
end
CFRelease(data)
end
end
i++
end
ret added
end
else:
func _roots_load_native(_r &: Roots): int:
ret 0
end
end
end
func _roots_load_file(r &: Roots, path: str): int:
if path.len() == 0:
ret 0
end
if not os.Exists(path):
ret 0
end
pem := io.ReadFile(path)
if pem.len() == 0:
mem.Free(pem as void*)
ret 0
end
added := _roots_add_pem(r, pem)
mem.Free(pem as void*)
ret added
end
func _roots_shared(ca_file: str): Roots:
if _shared_ready and _shared_key == ca_file:
ret _shared_roots
end
if _shared_ready:
_roots_free(_shared_roots)
end
_shared_roots = _roots_load(ca_file)
_shared_key = ca_file
_shared_ready = true
ret _shared_roots
end
func _roots_load(ca_file: str): Roots:
mut r := _roots_new()
if ca_file.len() > 0:
_roots_load_file(r, ca_file)
ret r
end
env := os.Env("SSL_CERT_FILE")
if env.len() > 0:
_roots_load_file(r, env)
ret r
end
if _roots_load_native(r) > 0:
ret r
end
mut i := 0
until i < CA_PATH_COUNT:
if _roots_load_file(r, _ca_path(i)) > 0:
ret r
end
i++
end
emb := _embedded_roots_pem()
if emb.len() > 0:
_roots_add_pem(r, emb)
end
ret r
end
package tls
const RSA_MAX_BYTES := 1024
func _rsa_digestinfo(kind: int): str:
if kind == HASH_SHA384:
ret "3041300d060960864801650304020205000430"
end
if kind == HASH_SHA512:
ret "3051300d060960864801650304020305000440"
end
ret "3031300d060960864801650304020105000420"
end
func _rsa_verify_pkcs1(kind: int, digest: void*, nmod: void*, nlen: int, expo: void*, elen: int, sig: void*, siglen: int): bool:
klen := nlen
if klen < 16 or klen > RSA_MAX_BYTES:
ret false
end
if siglen != klen:
ret false
end
hlen := _hash_size(kind)
mut di := _hexbuf(_rsa_digestinfo(kind))
defer _buf_free(di)
mut want := _newbuf(klen)
defer _buf_free(want)
tlen := di.len + hlen
if klen < tlen + 11:
ret false
end
_put8(want, 0x00)
_put8(want, 0x01)
pslen := klen - tlen - 3
repeat pslen:
_put8(want, 0xFF)
end
_put8(want, 0x00)
_putbuf(want, di)
_putraw(want, digest, hlen)
mut got := _newbuf(klen)
defer _buf_free(got)
_putzeros(got, klen)
if not _rsa_public_op(sig, siglen, nmod, nlen, expo, elen, got.p, klen):
ret false
end
ret _cteq(got.p, want.p, klen)
end
func _mgf1(kind: int, seed: void*, seedlen: int, out: void*, outlen: int):
hlen := _hash_size(kind)
mut ctr := _newbuf(4)
defer _buf_free(ctr)
_putzeros(ctr, 4)
mut blk := _newbuf(hlen)
defer _buf_free(blk)
_putzeros(blk, hlen)
mut done := 0
mut counter := 0
until done < outlen:
_bufset(ctr, 0, (counter >> 24) & 0xFF)
_bufset(ctr, 1, (counter >> 16) & 0xFF)
_bufset(ctr, 2, (counter >> 8) & 0xFF)
_bufset(ctr, 3, counter & 0xFF)
mut h := _hash_init(kind)
_hash_update(h, seed, seedlen)
_hash_update(h, ctr.p, 4)
_hash_final(h, blk.p)
mut take := outlen - done
if take > hlen:
take = hlen
end
repeat take in i:
_bput(out, done + i, _bufat(blk, i))
end
done += take
counter++
end
end
func _rsa_verify_pss(kind: int, digest: void*, nmod: void*, nlen: int, expo: void*, elen: int, sig: void*, siglen: int, slen: int): bool:
klen := nlen
if klen < 16 or klen > RSA_MAX_BYTES:
ret false
end
if siglen != klen:
ret false
end
hlen := _hash_size(kind)
mut nbig := _big_from_bytes(nmod, nlen)
defer _big_free(nbig)
modbits := _big_bitlen(nbig)
if modbits < 2:
ret false
end
emlen := (modbits - 1 + 7) / 8
if emlen < hlen + slen + 2:
ret false
end
mut em := _newbuf(klen)
defer _buf_free(em)
_putzeros(em, klen)
if not _rsa_public_op(sig, siglen, nmod, nlen, expo, elen, em.p, klen):
ret false
end
skip := klen - emlen
repeat skip in i:
if _bufat(em, i) != 0:
ret false
end
end
if _bufat(em, klen - 1) != 0xbc:
ret false
end
dblen := emlen - hlen - 1
hoff := skip + dblen
unused := 8 * emlen - (modbits - 1)
topmask := (0xFF >> unused) & 0xFF
if (_bufat(em, skip) & ~topmask & 0xFF) != 0:
ret false
end
mut dbmask := _newbuf(dblen)
defer _buf_free(dbmask)
_putzeros(dbmask, dblen)
_mgf1(kind, _bufptr(em, hoff), hlen, dbmask.p, dblen)
mut db := _newbuf(dblen)
defer _buf_free(db)
repeat dblen in i:
_put8(db, _bufat(em, skip + i) ^ _bufat(dbmask, i))
end
_bufset(db, 0, _bufat(db, 0) & topmask)
pslen := dblen - slen - 1
repeat pslen in i:
if _bufat(db, i) != 0:
ret false
end
end
if _bufat(db, pslen) != 0x01:
ret false
end
mut mprime := _newbuf(8 + hlen + slen)
defer _buf_free(mprime)
_putzeros(mprime, 8)
_putraw(mprime, digest, hlen)
repeat slen in i:
_put8(mprime, _bufat(db, pslen + 1 + i))
end
mut hprime := _newbuf(hlen)
defer _buf_free(hprime)
_putzeros(hprime, hlen)
_hash_oneshot(kind, mprime.p, mprime.len, hprime.p)
ret _cteq(hprime.p, _bufptr(em, hoff), hlen)
end
