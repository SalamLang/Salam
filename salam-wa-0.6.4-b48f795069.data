r1 := a[1] * b[0] + a[3] * b[1]
r2 := a[0] * b[2] + a[2] * b[3]
r3 := a[1] * b[2] + a[3] * b[3]
r4 := a[0] * b[4] + a[2] * b[5] + a[4]
r5 := a[1] * b[4] + a[3] * b[5] + a[5]
