package opencv
@en "VideoCapture"
@fa "ضبط ویدیو"
pub struct VideoCapture:
@en "handle"
@fa "دسته"
pub handle: void* = null
@en "ok"
@fa "معتبر"
pub func ok(): bool:
if this.handle == null: ret false end
ret scv_video_ok(this.handle) != 0
end
@en "read"
@fa "خواندن"
pub func read(): Mat:
if this.handle == null: ret Mat { handle = null } end
ret Mat { handle = scv_video_read(this.handle) }
end
@en "fps"
@fa "فریم در ثانیه"
pub func fps(): f64:
if this.handle == null: ret 0.0 end
ret scv_video_fps(this.handle)
end
@en "frame_count"
@fa "تعداد فریم"
pub func frame_count(): int:
if this.handle == null: ret 0 end
ret scv_video_frame_count(this.handle)
end
@en "close"
@fa "بستن"
pub func close():
if this.handle != null: scv_video_release(this.handle) end
this.handle = null
end
end
@en "VideoWriter"
@fa "نویسنده ویدیو"
pub struct VideoWriter:
@en "handle"
@fa "دسته"
pub handle: void* = null
@en "ok"
@fa "معتبر"
pub func ok(): bool: ret this.handle != null end
@en "write"
@fa "نوشتن"
pub func write(frame: Mat): bool:
if this.handle == null or frame.handle == null: ret false end
ret scv_writer_write(this.handle, frame.handle) != 0
end
@en "close"
@fa "بستن"
pub func close():
if this.handle != null: scv_writer_release(this.handle) end
this.handle = null
end
end
@en "OpenVideo"
@fa "بازکردن ویدیو"
pub func OpenVideo(path: str): VideoCapture:
ret VideoCapture { handle = scv_video_open_file(path) }
end
@en "OpenCamera"
@fa "بازکردن دوربین"
pub func OpenCamera(index: int): VideoCapture:
ret VideoCapture { handle = scv_video_open_camera(index) }
end
@en "NewVideoWriter"
@fa "نویسنده ویدیو جدید"
pub func NewVideoWriter(path: str, fourcc: str, fps: f64, width: int, height: int): VideoWriter:
ret VideoWriter { handle = scv_writer_open(path, fourcc, fps, width, height) }
end
package optim
import ai.nn
import ai.tensor
extern:
pure func sqrtf(x: f32): f32
end
@en "Adam"
@fa "آدام"
pub struct Adam:
@en "lr"
@fa "نرخ یادگیری"
pub lr: f64 = 0.001
@en "beta1"
@fa "بتای یک"
pub beta1: f64 = 0.9
@en "beta2"
@fa "بتای دو"
pub beta2: f64 = 0.999
@en "eps"
@fa "اپسیلون"
pub eps: f64 = 0.00000001
@en "weight_decay"
@fa "کاهش وزن"
pub weight_decay: f64 = 0.0
@en "decoupled"
@fa "کاهش وزن جدا"
pub decoupled: bool = false
t: i64 = 0
m: Vector<tensor.Tensor> = Vector {}
v: Vector<tensor.Tensor> = Vector {}
@en "step"
@fa "گام"
pub func step(ps &: nn.ParamStore):
_ensure_state(this.m, ps)
_ensure_state(this.v, ps)
this.t++
mut p1 := 1.0
mut p2 := 1.0
mut i := 0 as i64
until i < this.t:
p1 *= this.beta1
p2 *= this.beta2
i++
end
c1 := (1.0 / (1.0 - p1)) as f32
c2 := (1.0 / (1.0 - p2)) as f32
lr := this.lr as f32
b1 := this.beta1 as f32
b2 := this.beta2 as f32
one := 1.0 as f32
ef := this.eps as f32
wd := this.weight_decay as f32
zero := 0.0 as f32
repeat ps.count() in pi:
mut p := ps.items.get(pi)
n := p.value.numel()
pw := p.value.data.data
pg := p.grad.data.data
mt := this.m.get(pi)
vt := this.v.get(pi)
pm := mt.data.data
pv := vt.data.data
if this.decoupled and wd != zero:
repeat n in k: pw[k] -= lr * wd * pw[k] end
end
repeat n in k:
mut g := pg[k]
if this.decoupled == false and wd != zero: g += wd * pw[k] end
nm := b1 * pm[k] + (one - b1) * g
nv := b2 * pv[k] + (one - b2) * g * g
pm[k] = nm
pv[k] = nv
pw[k] = pw[k] - lr * (nm * c1) / (sqrtf(nv * c2) + ef)
end
end
end
@en "free"
@fa "آزادسازی"
pub func free():
_free_state(this.m)
_free_state(this.v)
end
end
@en "RMSProp"
@fa "آر ام اس پراپ"
pub struct RMSProp:
@en "lr"
@fa "نرخ یادگیری"
pub lr: f64 = 0.01
@en "alpha"
@fa "ضریب میانگین"
pub alpha: f64 = 0.99
@en "eps"
@fa "اپسیلون"
pub eps: f64 = 0.00000001
@en "weight_decay"
@fa "کاهش وزن"
pub weight_decay: f64 = 0.0
sq: Vector<tensor.Tensor> = Vector {}
@en "step"
@fa "گام"
pub func step(ps &: nn.ParamStore):
_ensure_state(this.sq, ps)
lr := this.lr as f32
al := this.alpha as f32
one := 1.0 as f32
ef := this.eps as f32
wd := this.weight_decay as f32
zero := 0.0 as f32
repeat ps.count() in pi:
mut p := ps.items.get(pi)
n := p.value.numel()
pw := p.value.data.data
pg := p.grad.data.data
st := this.sq.get(pi)
pv := st.data.data
repeat n in k:
mut g := pg[k]
if wd != zero: g += wd * pw[k] end
nv := al * pv[k] + (one - al) * g * g
pv[k] = nv
pw[k] = pw[k] - lr * g / (sqrtf(nv) + ef)
end
end
end
@en "free"
@fa "آزادسازی"
pub func free(): _free_state(this.sq) end
end
@en "NewAdamW"
@fa "آدام دابلیو جدید"
pub func NewAdamW(lr: f64, weight_decay: f64): Adam:
mut a := Adam {}
a.lr = lr
a.weight_decay = weight_decay
a.decoupled = true
ret a
end
package optim
import math
@en "StepLR"
@fa "نرخ پله‌ای"
pub func StepLR(base: f64, step: i64, every: i64, gamma: f64): f64:
if every <= 0: ret base end
mut lr := base
mut k := step / every
until k > 0:
lr *= gamma
k--
end
ret lr
end
@en "CosineLR"
@fa "نرخ کسینوسی"
pub func CosineLR(base: f64, step: i64, total: i64, min_lr: f64): f64:
if total <= 0 or step >= total: ret min_lr end
if step <= 0: ret base end
frac := (step as f64) / (total as f64)
ret min_lr + (base - min_lr) * 0.5 * (1.0 + math.Cos(math.PI * frac))
end
@en "WarmupCosine"
@fa "گرمایش سپس کسینوس"
pub func WarmupCosine(base: f64, step: i64, warmup: i64, total: i64, min_lr: f64): f64:
if warmup > 0 and step < warmup:
ret base * ((step + 1) as f64) / (warmup as f64)
end
ret CosineLR(base, step - warmup, total - warmup, min_lr)
end
@en "optim"
@fa "بهینه‌سازی"
package optim
import math
import ai.nn
import ai.tensor
@en "SGD"
@fa "گرادیان کاهشی تصادفی"
pub struct SGD:
@en "lr"
@fa "نرخ یادگیری"
pub lr: f64 = 0.01
@en "momentum"
@fa "تکانه"
pub momentum: f64 = 0.0
@en "weight_decay"
@fa "کاهش وزن"
pub weight_decay: f64 = 0.0
@en "nesterov"
@fa "نستروف"
pub nesterov: bool = false
vel: Vector<tensor.Tensor> = Vector {}
@en "step"
@fa "گام"
pub func step(ps &: nn.ParamStore):
if this.momentum != 0.0: _ensure_state(this.vel, ps) end
lr := this.lr as f32
wd := this.weight_decay as f32
mom := this.momentum as f32
zero := 0.0 as f32
repeat ps.count() in i:
mut p := ps.items.get(i)
n := p.value.numel()
pw := p.value.data.data
pg := p.grad.data.data
if mom == zero:
if wd == zero:
repeat n in k: pw[k] -= lr * pg[k] end
else:
repeat n in k: pw[k] -= lr * (pg[k] + wd * pw[k]) end
end
else:
v := this.vel.get(i)
pv := v.data.data
if this.nesterov:
repeat n in k:
g := pg[k] + wd * pw[k]
nv := mom * pv[k] + g
pv[k] = nv
pw[k] -= lr * (g + mom * nv)
end
else:
repeat n in k:
g := pg[k] + wd * pw[k]
nv := mom * pv[k] + g
pv[k] = nv
pw[k] -= lr * nv
end
end
end
end
end
@en "free"
@fa "آزادسازی"
pub func free(): _free_state(this.vel) end
end
func _ensure_state(state &: Vector<tensor.Tensor>, ps &: nn.ParamStore):
until state.len() < ps.count():
mut p := ps.items.get(state.len())
state.push(tensor.Zeros(p.value.shape))
end
end
func _free_state(state &: Vector<tensor.Tensor>):
repeat state.len() in i:
mut t := state.get(i)
t.free()
end
state.free()
end
@en "ClipGradNorm"
@fa "برش نُرم گرادیان"
pub func ClipGradNorm(ps &: nn.ParamStore, max_norm: f64): f64:
mut total := 0.0
repeat ps.count() in i:
mut p := ps.items.get(i)
n := p.grad.numel()
pg := p.grad.data.data
repeat n in k:
v := pg[k] as f64
total += v * v
end
end
norm := math.Sqrt(total)
if norm > max_norm and norm > 0.0:
scale := (max_norm / norm) as f32
repeat ps.count() in i:
mut p := ps.items.get(i)
n := p.grad.numel()
pg := p.grad.data.data
repeat n in k: pg[k] *= scale end
end
end
ret norm
end
@en "ClipGradValue"
@fa "برش مقدار گرادیان"
pub func ClipGradValue(ps &: nn.ParamStore, limit: f64):
hi := limit as f32
lo := (0.0 - limit) as f32
repeat ps.count() in i:
mut p := ps.items.get(i)
n := p.grad.numel()
pg := p.grad.data.data
repeat n in k:
mut v := pg[k]
if v > hi: v = hi end
if v < lo: v = lo end
pg[k] = v
end
end
end
@en "tensor"
@fa "تانسور"
package tensor
import matrix
extern:
pure func expf(x: f32): f32
pure func logf(x: f32): f32
pure func tanhf(x: f32): f32
pure func powf(x: f32, y: f32): f32
pure func sqrtf(x: f32): f32
pure func fabsf(x: f32): f32
end
@en "TSR_TOL"
@fa "رواداری تانسور"
pub const TSR_TOL := 1.0e-5
@en "Tensor"
@fa "تانسور"
pub struct Tensor:
@en "data"
@fa "درایه‌ها"
pub data: Vector<f32> = Vector {}
@en "shape"
@fa "شکل"
pub shape: Vector<int> = Vector {}
@en "rank"
@fa "رتبه"
pub func rank(): int: ret this.shape.len() end
@en "numel"
@fa "شمار درایه‌ها"
pub func numel(): int:
r := this.shape.len()
if r == 0: ret 0 end
mut n := 1
repeat r in i: n *= this.shape.get(i) end
ret n
end
@en "dim"
@fa "بعد"
pub func dim(i: int): int: ret this.shape.get(i) end
@en "is_empty"
@fa "تهی است"
pub func is_empty(): bool: ret this.data.len() == 0 end
@en "same_shape"
@fa "هم‌شکل"
pub func same_shape(o &: Tensor): bool:
r := this.shape.len()
if r != o.shape.len(): ret false end
repeat r in i:
if this.shape.get(i) != o.shape.get(i): ret false end
end
ret true
end
@en "at"
@fa "عنصر"
pub func at(i: int): f64: ret this.data.get(i) as f64 end
@en "set_at"
@fa "تنظیم در"
pub func set_at(i: int, v: f64): this.data.set(i, v as f32) end
@en "add_at"
@fa "افزودن در"
pub func add_at(i: int, v: f64):
this.data.set(i, this.data.get(i) + (v as f32))
end
@en "at2"
@fa "در دو"
pub func at2(i: int, j: int): f64:
ret this.data.get(i * this.shape.get(1) + j) as f64
end
@en "set_at2"
@fa "تنظیم در دو"
pub func set_at2(i: int, j: int, v: f64):
this.data.set(i * this.shape.get(1) + j, v as f32)
end
@en "reshape_"
@fa "تغییر شکل درجا"
pub func reshape_(shape &: Vector<int>): bool:
mut n := 1
if shape.len() == 0: n = 0 end
repeat shape.len() in i: n *= shape.get(i) end
if n != this.numel(): ret false end
this.shape.clear()
repeat shape.len() in i: this.shape.push(shape.get(i)) end
ret true
end
@en "operator +"
@fa "عملگر جمع"
pub func + (other: Tensor): Tensor:
mut me := Tensor {}
me.data = this.data
me.shape = this.shape
mut o := other
ret Add(me, o)
end
@en "operator -"
@fa "عملگر تفریق"
pub func -(other: Tensor): Tensor:
mut me := Tensor {}
me.data = this.data
me.shape = this.shape
mut o := other
ret Sub(me, o)
end
@en "operator *"
@fa "عملگر ضرب"
pub func *(other: Tensor): Tensor:
mut me := Tensor {}
me.data = this.data
me.shape = this.shape
mut o := other
ret Mul(me, o)
end
@en "operator /"
@fa "عملگر تقسیم"
pub func / (other: Tensor): Tensor:
mut me := Tensor {}
me.data = this.data
me.shape = this.shape
mut o := other
ret Div(me, o)
end
@en "free"
@fa "آزادسازی"
pub func free():
this.data.free()
this.shape.free()
end
end
func _copy_shape(shape &: Vector<int>): Vector<int>:
mut s := Vector {} as Vector<int>
n := shape.len()
if n > 0:
s.alloc(n)
repeat n in i: s.set(i, shape.get(i)) end
end
ret s
end
func _numel_of(shape &: Vector<int>): int:
r := shape.len()
if r == 0: ret 0 end
mut n := 1
repeat r in i: n *= shape.get(i) end
ret n
end
func _raw(shape &: Vector<int>): Tensor:
mut t := Tensor {}
t.shape = _copy_shape(shape)
n := _numel_of(shape)
if n > 0: t.data.alloc(n) end
ret t
end
func _raw_like(x &: Tensor): Tensor:
ret _raw(x.shape)
end
@en "Empty"
@fa "تهی"
pub func Empty(): Tensor: ret Tensor {} end
@en "Shape1"
@fa "شکل یک"
pub func Shape1(n: int): Vector<int>:
mut s := Vector {} as Vector<int>
s.push(n)
ret s
end
@en "Shape2"
@fa "شکل دو"
pub func Shape2(a: int, b: int): Vector<int>:
mut s := Vector {} as Vector<int>
s.push(a)
s.push(b)
ret s
end
@en "Shape3"
@fa "شکل سه"
pub func Shape3(a: int, b: int, c: int): Vector<int>:
mut s := Vector {} as Vector<int>
s.push(a)
s.push(b)
s.push(c)
ret s
end
@en "Shape4"
@fa "شکل چهار"
pub func Shape4(a: int, b: int, c: int, d: int): Vector<int>:
mut s := Vector {} as Vector<int>
s.push(a)
s.push(b)
s.push(c)
s.push(d)
ret s
end
@en "Zeros"
@fa "صفرها"
pub func Zeros(shape &: Vector<int>): Tensor:
mut t := Tensor {}
t.shape = _copy_shape(shape)
n := _numel_of(shape)
if n > 0: t.data.zeros(n) end
ret t
end
@en "Zeros1"
@fa "صفرها یک"
pub func Zeros1(n: int): Tensor:
mut s := Shape1(n)
t := Zeros(s)
s.free()
ret t
end
@en "Zeros2"
@fa "صفرها دو"
pub func Zeros2(r: int, c: int): Tensor:
mut s := Shape2(r, c)
t := Zeros(s)
s.free()
ret t
end
@en "Zeros3"
@fa "صفرها سه"
pub func Zeros3(a: int, b: int, c: int): Tensor:
mut s := Shape3(a, b, c)
t := Zeros(s)
s.free()
ret t
end
@en "Zeros4"
@fa "صفرها چهار"
pub func Zeros4(a: int, b: int, c: int, d: int): Tensor:
mut s := Shape4(a, b, c, d)
t := Zeros(s)
s.free()
ret t
end
@en "Full"
@fa "پرشده"
pub func Full(shape &: Vector<int>, x: f64): Tensor:
t := _raw(shape)
n := t.data.len()
if n <= 0: ret t end
v := x as f32
p := t.data.data
repeat n in k: p[k] = v end
ret t
end
@en "Ones"
@fa "یک‌ها"
pub func Ones(shape &: Vector<int>): Tensor: ret Full(shape, 1.0) end
@en "Scalar"
@fa "اسکالر"
pub func Scalar(x: f64): Tensor:
mut s := Shape1(1)
t := Full(s, x)
s.free()
ret t
end
@en "FromArray"
@fa "از آرایه"
pub func FromArray(shape &: Vector<int>, data &: Vector<f32>): Tensor:
n := _numel_of(shape)
if n != data.len(): ret Empty() end
t := _raw(shape)
if n <= 0: ret t end
p := t.data.data
q := data.data
repeat n in k: p[k] = q[k] end
ret t
end
@en "Arange"
@fa "بازه گام"
pub func Arange(n: int): Tensor:
t := Zeros1(n)
p := t.data.data
repeat n in k: p[k] = k as f32 end
ret t
end
@en "Clone"
@fa "همانند"
pub func Clone(x &: Tensor): Tensor:
t := _raw_like(x)
n := t.data.len()
if n <= 0: ret t end
p := t.data.data
q := x.data.data
repeat n in k: p[k] = q[k] end
ret t
end
@en "CopyInto"
@fa "رونوشت در"
pub func CopyInto(dst &: Tensor, src &: Tensor):
if dst.same_shape(src) == false: ret end
n := src.data.len()
if n <= 0: ret end
p := dst.data.data
q := src.data.data
repeat n in k: p[k] = q[k] end
end
@en "Free"
@fa "آزادسازی"
pub func Free(x &: Tensor):
x.data.free()
x.shape.free()
end
@en "SetAll"
@fa "تنظیم همه"
pub func SetAll(x &: Tensor, v: f64):
n := x.data.len()
if n <= 0: ret end
s := v as f32
p := x.data.data
repeat n in k: p[k] = s end
end
@en "SameShape"
@fa "هم‌شکل"
pub func SameShape(x &: Tensor, y &: Tensor): bool: ret x.same_shape(y) end
@en "ToMatrix"
@fa "به ماتریس"
pub func ToMatrix(x &: Tensor): matrix.Matrix:
r := x.rank()
if r != 1 and r != 2: ret matrix.Matrix {} end
mut rows := 1
mut cols := x.shape.get(0)
if r == 2:
rows = x.shape.get(0)
cols = x.shape.get(1)
end
mut m := matrix.Zeros(rows, cols)
n := x.data.len()
q := x.data.data
repeat n in k: m.a.set(k, q[k] as f64) end
ret m
end
@en "FromMatrix"
@fa "از ماتریس"
pub func FromMatrix(m &: matrix.Matrix): Tensor:
if m.is_empty(): ret Empty() end
t := Zeros2(m.rows, m.cols)
n := m.count()
p := t.data.data
repeat n in k: p[k] = m.a.get(k) as f32 end
ret t
end
package tensor
func _conv_out(size: int, k: int, s: int, p: int): int:
ret (size + 2 * p - k) / s + 1
end
func _im2col_sample(px: f32*, c: int, h: int, w: int, kh: int, kw: int, sh: int, sw: int, ph: int, pw: int, cols: f32*):
oh := _conv_out(h, kh, sh, ph)
ow := _conv_out(w, kw, sw, pw)
p := oh * ow
zero := 0.0 as f32
repeat c in ci:
plane := ci * h * w
repeat kh in ki:
repeat kw in kj:
row := ((ci * kh + ki) * kw + kj) * p
repeat oh in oi:
ii := oi * sh - ph + ki
base := row + oi * ow
if ii < 0 or ii >= h:
repeat ow in oj: cols[base + oj] = zero end
else:
src := plane + ii * w
repeat ow in oj:
jj := oj * sw - pw + kj
mut v := zero
if jj >= 0 and jj < w: v = px[src + jj] end
cols[base + oj] = v
end
end
end
end
end
end
end
func _col2im_sample(cols: f32*, c: int, h: int, w: int, kh: int, kw: int, sh: int, sw: int, ph: int, pw: int, px: f32*):
oh := _conv_out(h, kh, sh, ph)
ow := _conv_out(w, kw, sw, pw)
p := oh * ow
repeat c in ci:
plane := ci * h * w
repeat kh in ki:
repeat kw in kj:
row := ((ci * kh + ki) * kw + kj) * p
repeat oh in oi:
ii := oi * sh - ph + ki
if ii >= 0 and ii < h:
dst := plane + ii * w
base := row + oi * ow
repeat ow in oj:
jj := oj * sw - pw + kj
if jj >= 0 and jj < w:
px[dst + jj] += cols[base + oj]
end
end
end
end
end
end
end
end
@en "ConvOutSize"
@fa "اندازه خروجی پیچش"
pub func ConvOutSize(size: int, k: int, s: int, p: int): int:
ret _conv_out(size, k, s, p)
end
@en "Im2Col"
@fa "تصویر به ستون"
pub func Im2Col(x &: Tensor, sample: int, kh: int, kw: int, sh: int, sw: int, ph: int, pw: int): Tensor:
if x.rank() != 4: ret Empty() end
c := x.shape.get(1)
h := x.shape.get(2)
w := x.shape.get(3)
oh := _conv_out(h, kh, sh, ph)
ow := _conv_out(w, kw, sw, pw)
if oh <= 0 or ow <= 0 or sample < 0 or sample >= x.shape.get(0): ret Empty() end
t := Zeros2(c * kh * kw, oh * ow)
_im2col_sample(_p32(x.data.data, sample * c * h * w), c, h, w, kh, kw, sh, sw, ph, pw, t.data.data)
ret t
end
@en "Col2ImAcc"
@fa "ستون به تصویر انباشته"
pub func Col2ImAcc(cols &: Tensor, dx &: Tensor, sample: int, kh: int, kw: int, sh: int, sw: int, ph: int, pw: int): bool:
if dx.rank() != 4 or cols.rank() != 2: ret false end
c := dx.shape.get(1)
h := dx.shape.get(2)
w := dx.shape.get(3)
if sample < 0 or sample >= dx.shape.get(0): ret false end
_col2im_sample(cols.data.data, c, h, w, kh, kw, sh, sw, ph, pw, _p32(dx.data.data, sample * c * h * w))
ret true
end
@en "Conv2DForward"
@fa "پیچش دوبعدی پیشرو"
pub func Conv2DForward(x &: Tensor, w &: Tensor, bias &: Tensor, sh: int, sw: int, ph: int, pw: int): Tensor:
if x.rank() != 4 or w.rank() != 4: ret Empty() end
if x.shape.get(1) != w.shape.get(1): ret Empty() end
n := x.shape.get(0)
c := x.shape.get(1)
h := x.shape.get(2)
wd := x.shape.get(3)
oc := w.shape.get(0)
kh := w.shape.get(2)
kw := w.shape.get(3)
oh := _conv_out(h, kh, sh, ph)
ow := _conv_out(wd, kw, sw, pw)
if oh <= 0 or ow <= 0: ret Empty() end
if bias.is_empty() == false and bias.numel() != oc: ret Empty() end
kdim := c * kh * kw
p := oh * ow
t := Zeros4(n, oc, oh, ow)
mut cols := Vector {} as Vector<f32>
cols.alloc(kdim * p)
px := x.data.data
pw2 := w.data.data
pr := t.data.data
repeat n in i:
_im2col_sample(_p32(px, i * c * h * wd), c, h, wd, kh, kw, sh, sw, ph, pw, cols.data)
_gemm_acc(pw2, cols.data, _p32(pr, i * oc * p), oc, kdim, p)
end
cols.free()
if bias.is_empty() == false:
pb := bias.data.data
repeat n in i:
sbase := i * oc * p
repeat oc in o:
b := pb[o]
obase := sbase + o * p
repeat p in k: pr[obase + k] += b end
end
end
end
ret t
end
@en "MaxPool2DForward"
@fa "بیشینه‌گیری دوبعدی پیشرو"
pub func MaxPool2DForward(x &: Tensor, kh: int, kw: int, sh: int, sw: int, argmax_out &: Tensor): Tensor:
if x.rank() != 4: ret Empty() end
n := x.shape.get(0)
c := x.shape.get(1)
h := x.shape.get(2)
w := x.shape.get(3)
oh := _conv_out(h, kh, sh, 0)
ow := _conv_out(w, kw, sw, 0)
if oh <= 0 or ow <= 0: ret Empty() end
t := Zeros4(n, c, oh, ow)
argmax_out.free()
am := Zeros4(n, c, oh, ow)
px := x.data.data
pr := t.data.data
pa := am.data.data
planes := n * c
repeat planes in pl:
ibase := pl * h * w
obase := pl * oh * ow
repeat oh in oi:
repeat ow in oj:
mut best := px[ibase + (oi * sh) * w + (oj * sw)]
mut bidx := (oi * sh) * w + (oj * sw)
repeat kh in ki:
ii := oi * sh + ki
if ii < h:
repeat kw in kj:
jj := oj * sw + kj
if jj < w:
v := px[ibase + ii * w + jj]
if v > best:
best = v
bidx = ii * w + jj
end
end
end
end
end
pr[obase + oi * ow + oj] = best
pa[obase + oi * ow + oj] = bidx as f32
end
end
end
argmax_out = am
ret t
end
@en "AvgPool2DForward"
@fa "میانگین‌گیری دوبعدی پیشرو"
pub func AvgPool2DForward(x &: Tensor, kh: int, kw: int, sh: int, sw: int): Tensor:
if x.rank() != 4: ret Empty() end
n := x.shape.get(0)
c := x.shape.get(1)
h := x.shape.get(2)
w := x.shape.get(3)
oh := _conv_out(h, kh, sh, 0)
ow := _conv_out(w, kw, sw, 0)
if oh <= 0 or ow <= 0: ret Empty() end
t := Zeros4(n, c, oh, ow)
px := x.data.data
pr := t.data.data
planes := n * c
repeat planes in pl:
ibase := pl * h * w
obase := pl * oh * ow
repeat oh in oi:
repeat ow in oj:
mut s := 0.0 as f32
mut cnt := 0
repeat kh in ki:
ii := oi * sh + ki
if ii < h:
repeat kw in kj:
jj := oj * sw + kj
if jj < w:
s += px[ibase + ii * w + jj]
cnt++
end
end
end
end
pr[obase + oi * ow + oj] = s / (cnt as f32)
end
end
end
ret t
end
package tensor
const _BC_BAD := 0 - 1
const _BC_SAME := 0
const _BC_SCALAR := 1
const _BC_SUFFIX := 2
const _BC_COL := 3
const _U_EXP := 0
const _U_LOG := 1
const _U_TANH := 2
const _U_SIGMOID := 3
const _U_RELU := 4
const _U_GELU := 5
const _U_SQRT := 6
const _U_ABS := 7
const _U_SQUARE := 8
const _U_NEG := 9
const _U_SILU := 10
func _k_same(pa: f32*, pb: f32*, pr: f32*, n: int, op: int):
if op == 0:
repeat n in k: pr[k] = pa[k] + pb[k] end
else op == 1:
repeat n in k: pr[k] = pa[k] - pb[k] end
else op == 2:
repeat n in k: pr[k] = pa[k] * pb[k] end
else:
zero := 0.0 as f32
repeat n in k:
v := pb[k]
if v == zero: pr[k] = zero
else:
pr[k] = pa[k] / v
end
end
end
end
func _k_scalar(pa: f32*, s: f32, pr: f32*, n: int, op: int, swapped: bool):
zero := 0.0 as f32
if op == 0:
repeat n in k: pr[k] = pa[k] + s end
else op == 1:
if swapped:
repeat n in k: pr[k] = s - pa[k] end
else:
repeat n in k: pr[k] = pa[k] - s end
end
else op == 2:
repeat n in k: pr[k] = pa[k] * s end
else:
if swapped:
repeat n in k:
v := pa[k]
if v == zero: pr[k] = zero
else:
pr[k] = s / v
end
end
else:
if s == zero:
repeat n in k: pr[k] = zero end
else:
inv := (1.0 as f32) / s
repeat n in k: pr[k] = pa[k] * inv end
end
end
end
end
func _k_suffix(pbig: f32*, psmall: f32*, pr: f32*, outer: int, inner: int, op: int, swapped: bool):
zero := 0.0 as f32
repeat outer in o:
base := o * inner
if op == 0:
repeat inner in k: pr[base + k] = pbig[base + k] + psmall[k] end
else op == 1:
if swapped:
repeat inner in k: pr[base + k] = psmall[k] - pbig[base + k] end
else:
repeat inner in k: pr[base + k] = pbig[base + k] - psmall[k] end
end
else op == 2:
repeat inner in k: pr[base + k] = pbig[base + k] * psmall[k] end
else:
if swapped:
repeat inner in k:
v := pbig[base + k]
if v == zero: pr[base + k] = zero
else:
pr[base + k] = psmall[k] / v
end
end
else:
repeat inner in k:
v := psmall[k]
if v == zero: pr[base + k] = zero
else:
pr[base + k] = pbig[base + k] / v
end
end
end
end
end
end
func _k_col(pbig: f32*, psmall: f32*, pr: f32*, rows: int, width: int, op: int, swapped: bool):
zero := 0.0 as f32
repeat rows in r:
base := r * width
s := psmall[r]
if op == 0:
repeat width in k: pr[base + k] = pbig[base + k] + s end
else op == 1:
if swapped:
repeat width in k: pr[base + k] = s - pbig[base + k] end
else:
repeat width in k: pr[base + k] = pbig[base + k] - s end
end
else op == 2:
repeat width in k: pr[base + k] = pbig[base + k] * s end
else:
if swapped:
repeat width in k:
v := pbig[base + k]
if v == zero: pr[base + k] = zero
else:
pr[base + k] = s / v
end
end
else:
if s == zero:
repeat width in k: pr[base + k] = zero end
else:
repeat width in k: pr[base + k] = pbig[base + k] / s end
end
end
end
end
end
func _bc_mode(big &: Tensor, small &: Tensor): int:
if big.same_shape(small): ret _BC_SAME end
if small.numel() == 1: ret _BC_SCALAR end
br := big.rank()
sr := small.rank()
if sr < br:
repeat sr in i:
if small.shape.get(i) != big.shape.get(br - sr + i): ret _BC_BAD end
end
ret _BC_SUFFIX
end
if sr == br and sr >= 2:
if small.shape.get(0) == 1:
mut lead_one := true
repeat sr - 1 in i:
if small.shape.get(i + 1) != big.shape.get(i + 1): lead_one = false end
end
if lead_one: ret _BC_SUFFIX end
end
if small.shape.get(sr - 1) == 1:
mut ok := true
repeat sr - 1 in i:
if small.shape.get(i) != big.shape.get(i): ok = false end
end
if ok: ret _BC_COL end
end
end
ret _BC_BAD
end
func _bin_ord(big &: Tensor, small &: Tensor, op: int, swapped: bool): Tensor:
mode := _bc_mode(big, small)
if mode == _BC_BAD: ret Empty() end
r := _raw_like(big)
n := big.numel()
if n <= 0: ret r end
pb := big.data.data
ps := small.data.data
pr := r.data.data
if mode == _BC_SAME:
_par_zip(pb, ps, pr, n, op)
else mode == _BC_SCALAR:
_k_scalar(pb, ps[0], pr, n, op, swapped)
else mode == _BC_SUFFIX:
inner := small.numel()
_k_suffix(pb, ps, pr, n / inner, inner, op, swapped)
else:
width := big.shape.get(big.rank() - 1)
_k_col(pb, ps, pr, n / width, width, op, swapped)
end
ret r
end
func _bin(a &: Tensor, b &: Tensor, op: int): Tensor:
if a.is_empty() or b.is_empty(): ret Empty() end
if a.numel() >= b.numel(): ret _bin_ord(a, b, op, false) end
ret _bin_ord(b, a, op, true)
end
func _same_into(a &: Tensor, b &: Tensor, out &: Tensor, op: int): bool:
if a.same_shape(b) == false: ret false end
if a.same_shape(out) == false: ret false end
n := a.numel()
if n <= 0: ret true end
_par_zip(a.data.data, b.data.data, out.data.data, n, op)
ret true
end
func _u_range(p: f32*, pr: f32*, n: int, op: int):
zero := 0.0 as f32
one := 1.0 as f32
if op == _U_EXP:
repeat n in k: pr[k] = expf(p[k]) end
else op == _U_LOG:
repeat n in k: pr[k] = logf(p[k]) end
else op == _U_TANH:
repeat n in k: pr[k] = tanhf(p[k]) end
else op == _U_SIGMOID:
repeat n in k: pr[k] = one / (one + expf(zero - p[k])) end
else op == _U_RELU:
repeat n in k:
v := p[k]
mut o := zero
if v > zero: o = v end
pr[k] = o
end
else op == _U_GELU:
c0 := 0.7978845608028654 as f32
c1 := 0.044715 as f32
half := 0.5 as f32
repeat n in k:
v := p[k]
inner := c0 * (v + c1 * v * v * v)
pr[k] = half * v * (one + tanhf(inner))
end
else op == _U_SQRT:
repeat n in k: pr[k] = sqrtf(p[k]) end
else op == _U_ABS:
repeat n in k: pr[k] = fabsf(p[k]) end
else op == _U_SQUARE:
repeat n in k:
v := p[k]
pr[k] = v * v
end
else op == _U_SILU:
repeat n in k:
v := p[k]
pr[k] = v / (one + expf(zero - v))
end
else:
repeat n in k: pr[k] = zero - p[k] end
end
end
func _map(x &: Tensor, op: int): Tensor:
r := _raw_like(x)
n := x.data.len()
if n <= 0: ret r end
_par_map(x.data.data, r.data.data, n, op)
ret r
end
@en "Add"
@fa "جمع"
pub func Add(x &: Tensor, y &: Tensor): Tensor: ret _bin(x, y, 0) end
@en "Sub"
@fa "تفریق"
pub func Sub(x &: Tensor, y &: Tensor): Tensor: ret _bin(x, y, 1) end
@en "Mul"
@fa "ضرب درایه‌ای"
pub func Mul(x &: Tensor, y &: Tensor): Tensor: ret _bin(x, y, 2) end
@en "Div"
@fa "تقسیم درایه‌ای"
pub func Div(x &: Tensor, y &: Tensor): Tensor: ret _bin(x, y, 3) end
@en "AddInto"
@fa "جمع در"
pub func AddInto(x &: Tensor, y &: Tensor, out &: Tensor): bool:
ret _same_into(x, y, out, 0)
end
@en "SubInto"
@fa "تفریق در"
pub func SubInto(x &: Tensor, y &: Tensor, out &: Tensor): bool:
ret _same_into(x, y, out, 1)
end
@en "MulInto"
@fa "ضرب در"
pub func MulInto(x &: Tensor, y &: Tensor, out &: Tensor): bool:
ret _same_into(x, y, out, 2)
end
@en "DivInto"
@fa "تقسیم در"
pub func DivInto(x &: Tensor, y &: Tensor, out &: Tensor): bool:
ret _same_into(x, y, out, 3)
end
@en "AddScalar"
@fa "جمع با عدد"
pub func AddScalar(x &: Tensor, s: f64): Tensor:
r := _raw_like(x)
n := x.data.len()
if n > 0: _k_scalar(x.data.data, s as f32, r.data.data, n, 0, false) end
ret r
end
@en "SubScalar"
@fa "تفریق عدد"
pub func SubScalar(x &: Tensor, s: f64): Tensor: ret AddScalar(x, 0.0 - s) end
@en "Scale"
@fa "مقیاس"
pub func Scale(x &: Tensor, s: f64): Tensor:
r := _raw_like(x)
n := x.data.len()
if n > 0: _k_scalar(x.data.data, s as f32, r.data.data, n, 2, false) end
ret r
end
@en "DivScalar"
@fa "تقسیم با عدد"
pub func DivScalar(x &: Tensor, s: f64): Tensor:
if s == 0.0: ret Zeros(x.shape) end
ret Scale(x, 1.0 / s)
end
@en "Neg"
@fa "قرینه"
pub func Neg(x &: Tensor): Tensor: ret _map(x, _U_NEG) end
@en "AddInPlace"
@fa "جمع درجا"
pub func AddInPlace(dst &: Tensor, src &: Tensor):
if dst.same_shape(src) == false: ret end
n := dst.data.len()
if n <= 0: ret end
p := dst.data.data
q := src.data.data
repeat n in k: p[k] += q[k] end
end
@en "SubInPlace"
@fa "تفریق درجا"
pub func SubInPlace(dst &: Tensor, src &: Tensor):
if dst.same_shape(src) == false: ret end
n := dst.data.len()
if n <= 0: ret end
p := dst.data.data
q := src.data.data
repeat n in k: p[k] -= q[k] end
end
@en "MulInPlace"
@fa "ضرب درجا"
pub func MulInPlace(dst &: Tensor, src &: Tensor):
if dst.same_shape(src) == false: ret end
n := dst.data.len()
if n <= 0: ret end
p := dst.data.data
q := src.data.data
repeat n in k: p[k] *= q[k] end
end
@en "ScaleInPlace"
@fa "مقیاس درجا"
pub func ScaleInPlace(dst &: Tensor, s: f64):
n := dst.data.len()
if n <= 0: ret end
v := s as f32
p := dst.data.data
repeat n in k: p[k] *= v end
end
@en "AddScalarInPlace"
@fa "جمع عدد درجا"
pub func AddScalarInPlace(dst &: Tensor, s: f64):
n := dst.data.len()
if n <= 0: ret end
v := s as f32
p := dst.data.data
repeat n in k: p[k] += v end
end
@en "AddScaled"
@fa "جمع مقیاس‌دار"
pub func AddScaled(dst &: Tensor, src &: Tensor, alpha: f64):
if dst.same_shape(src) == false: ret end
n := dst.data.len()
if n <= 0: ret end
a := alpha as f32
p := dst.data.data
q := src.data.data
repeat n in k: p[k] += a * q[k] end
end
@en "Exp"
@fa "نمایی"
pub func Exp(x &: Tensor): Tensor: ret _map(x, _U_EXP) end
@en "Log"
@fa "لگاریتم"
pub func Log(x &: Tensor): Tensor: ret _map(x, _U_LOG) end
@en "Tanh"
@fa "تانژانت هذلولی"
pub func Tanh(x &: Tensor): Tensor: ret _map(x, _U_TANH) end
@en "Sigmoid"
@fa "سیگموئید"
pub func Sigmoid(x &: Tensor): Tensor: ret _map(x, _U_SIGMOID) end
@en "Relu"
@fa "یکسوساز"
pub func Relu(x &: Tensor): Tensor: ret _map(x, _U_RELU) end
@en "Gelu"
@fa "گلو"
pub func Gelu(x &: Tensor): Tensor: ret _map(x, _U_GELU) end
@en "Sqrt"
@fa "ریشه دوم"
pub func Sqrt(x &: Tensor): Tensor: ret _map(x, _U_SQRT) end
@en "Abs"
@fa "قدر مطلق"
pub func Abs(x &: Tensor): Tensor: ret _map(x, _U_ABS) end
@en "Square"
@fa "مربع"
pub func Square(x &: Tensor): Tensor: ret _map(x, _U_SQUARE) end
@en "Silu"
@fa "سیلو"
pub func Silu(x &: Tensor): Tensor: ret _map(x, _U_SILU) end
@en "PowScalar"
@fa "توان عددی"
pub func PowScalar(x &: Tensor, p: f64): Tensor:
r := _raw_like(x)
n := x.data.len()
if n <= 0: ret r end
e := p as f32
q := x.data.data
pr := r.data.data
repeat n in k: pr[k] = powf(q[k], e) end
ret r
end
@en "Clip"
@fa "برش"
pub func Clip(x &: Tensor, lo: f64, hi: f64): Tensor:
r := _raw_like(x)
n := x.data.len()
if n <= 0: ret r end
a := lo as f32
b := hi as f32
q := x.data.data
pr := r.data.data
repeat n in k:
mut v := q[k]
if v < a: v = a end
if v > b: v = b end
pr[k] = v
end
ret r
end
package tensor
import str
const _FMT_MAX := 16
@en "ShapeString"
@fa "رشته شکل"
pub func ShapeString(x &: Tensor): str:
r := x.rank()
mut sb := str.NewBuilder()
if r == 0:
str.BufAppend(sb, "empty")
else:
repeat r in i:
if i > 0: str.BufAppendChar(sb, 120) end
str.BufAppendInt(sb, x.shape.get(i) as i64)
end
end
out := str.BufStr(sb)
str.BufFree(sb)
ret out
end
@en "ToString"
@fa "به رشته"
pub func ToString(x &: Tensor): str:
mut s := "tensor(" + ShapeString(x) + ")["
n := x.data.len()
mut show := n
if show > _FMT_MAX: show = _FMT_MAX end
repeat show in k:
if k > 0: s += " " end
s += (x.data.get(k) as f64)
end
if n > show: s += " ..." end
s += "]"
ret s
end
@en "Print"
@fa "چاپ"
pub func Print(x &: Tensor):
println ToString(x)
end
@en "MaxAbsDiff"
@fa "بیشینه اختلاف مطلق"
pub func MaxAbsDiff(x &: Tensor, y &: Tensor): f64:
if x.same_shape(y) == false: ret 1.0e300 end
n := x.data.len()
p := x.data.data
q := y.data.data
mut worst := 0.0
repeat n in k:
d := (p[k] as f64) - (q[k] as f64)
mut a := d
if a < 0.0: a = 0.0 - a end
if a > worst: worst = a end
end
ret worst
end
@en "AllClose"
@fa "همه نزدیک"
pub func AllClose(x &: Tensor, y &: Tensor, tol: f64): bool:
ret MaxAbsDiff(x, y) <= tol
end
@en "Equal"
@fa "یکسان"
pub func Equal(x &: Tensor, y &: Tensor): bool:
if x.same_shape(y) == false: ret false end
n := x.data.len()
p := x.data.data
q := y.data.data
mut same := true
repeat n in k:
if p[k] != q[k]: same = false end
end
ret same
end
package tensor
import mem
const _T_BLOCK := 32
const _MR := 4
const _NR := 16
const _KC := 512
const _MC := 128
const _NC := 1024
inline func _p32(p: f32*, off: int): f32*:
ret (p as i64 + (off as i64) * (sizeof(f32) as i64)) as f32*
end
inline func _p3264(p: f32*, off: i64): f32*:
ret (p as i64 + off * (sizeof(f32) as i64)) as f32*
end
func _gmin(a: int, b: int): int:
if a < b: ret a end
ret b
end
func _gg_pack_a(px: f32*, xc: int, i0: int, k0: int, kc: int, dst: f32*):
a0 := _p32(px, i0 * xc + k0)
a1 := _p32(px, (i0 + 1) * xc + k0)
a2 := _p32(px, (i0 + 2) * xc + k0)
a3 := _p32(px, (i0 + 3) * xc + k0)
repeat kc in k:
d := _p32(dst, k * _MR)
d[0] = a0[k]
d[1] = a1[k]
d[2] = a2[k]
d[3] = a3[k]
end
end
func _gg_pack_b(py: f32*, yc: int, k0: int, k1: int, j0: int, dst: f32*):
mut k := k0
mut o := 0
until k < k1:
src := _p32(py, k * yc + j0)
d := _p32(dst, o)
repeat _NR in t: d[t] = src[t] end
o += _NR
k++
end
end
func _gg_micro(pa: f32*, pb: f32*, kn: i64, c0: f32*, c1: f32*, c2: f32*, c3: f32*):
