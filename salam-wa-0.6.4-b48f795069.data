func _vp8_filter2(pl: u8*, p: int, step: int):
p1 := _vp8_pg(pl, p - 2 * step)
p0 := _vp8_pg(pl, p - step)
q0 := _vp8_pg(pl, p)
q1 := _vp8_pg(pl, p + step)
a := 3 * (q0 - p0) + _vp8_sclip(p1 - q1, 0 - 128, 127)
a1 := _vp8_sclip((a + 4) >> 3, 0 - 16, 15)
a2 := _vp8_sclip((a + 3) >> 3, 0 - 16, 15)
pl[p - step] = _vp8_clamp(p0 + a2, 255) as u8
pl[p] = _vp8_clamp(q0 - a1, 255) as u8
end
func _vp8_filter4(pl: u8*, p: int, step: int):
p1 := _vp8_pg(pl, p - 2 * step)
p0 := _vp8_pg(pl, p - step)
q0 := _vp8_pg(pl, p)
q1 := _vp8_pg(pl, p + step)
a := 3 * (q0 - p0)
a1 := _vp8_sclip((a + 4) >> 3, 0 - 16, 15)
a2 := _vp8_sclip((a + 3) >> 3, 0 - 16, 15)
