@fa "اسکریپت ارسال"
pub func PostScript(): str:
ret _wv_bk_post_script()
end
@en "create"
@fa "ایجاد"
pub func Create(debug: bool = false, visible: bool = true): WebView:
id := _wv_register()
if not _wv_bk_create(id, debug, visible):
_wv_mark_closed(id)
end
ret WebView { id = id }
end
@en "Engine"
@fa "موتور"
pub func Engine(): str:
if _wv_is_cef():
ret ENGINE_CHROMIUM
else:
ret ENGINE_SYSTEM
end
end
@en "EngineName"
@fa "نام موتور"
pub func EngineName(): str:
if _wv_is_cef():
ret "Chromium Embedded Framework"
