import crypto
import mem
import sync
const MM_WINDOW := 5
const MM_TABLE := 32
const RSA_BLIND_USES := 64
mut _rsa_blind_mu := sync.NewMutex()
struct MontCtx:
pub n: int = 0
pub n0: u32 = 0 as u32
pub m: u32* = null
pub rr: u32* = null
pub one: u32* = null
end
struct RsaCrt:
pub nn: MontCtx* = null
pub np: MontCtx* = null
pub nq: MontCtx* = null
pub dp: u32* = null
pub dq: u32* = null
pub qinv: u32* = null
pub q: u32* = null
pub e: Buf = Buf {}
pub vi: u32* = null
pub vf: u32* = null
pub uses: int = 0
