const _R1_POSHF2 := [0, 0, 0, 0, 0, 0, 2, 7, 53, 117, 233, 0, 0]
const _R1_DECHF3 := [0x800, 0x2400, 0xee00, 0xfe80, 0xffff, 0xffff, 0xffff]
const _R1_POSHF3 := [0, 0, 0, 0, 0, 0, 0, 2, 16, 218, 251, 0, 0]
const _R1_DECHF4 := [0xff00, 0xffff, 0xffff, 0xffff, 0xffff, 0xffff]
const _R1_POSHF4 := [0, 0, 0, 0, 0, 0, 0, 0, 0, 255, 0, 0, 0]
const _R1_SHORTLEN1 := [1, 3, 4, 4, 5, 6, 7, 8, 8, 4, 4, 5, 6, 6, 4, 0]
const _R1_SHORTXOR1 := [0, 0xa0, 0xd0, 0xe0, 0xf0, 0xf8, 0xfc, 0xfe, 0xff, 0xc0, 0x80, 0x90, 0x98, 0x9c, 0xb0]
const _R1_SHORTLEN2 := [2, 3, 3, 3, 4, 4, 5, 6, 6, 4, 4, 5, 6, 6, 4, 0]
const _R1_SHORTXOR2 := [0, 0x40, 0x60, 0xa0, 0xd0, 0xe0, 0xf0, 0xf8, 0xfc, 0xc0, 0x80, 0x90, 0x98, 0x9c, 0xb0]
struct _ROld:
pub win: u8*
pub wsize: int
pub wmask: int
pub wp: int
pub fl: int
pub total: i64
pub left: i64
pub od: int*
pub od_ptr: int
pub last_len: int
pub last_dist: int
pub ld: _RarHuff
pub dd: _RarHuff
pub rd: _RarHuff
pub bd: _RarHuff
pub md0: _RarHuff
pub md1: _RarHuff
pub md2: _RarHuff
pub md3: _RarHuff
pub old_table: u8*
pub tbl: u8*
pub av: int*
pub tables_read: bool
pub audio: bool
pub channels: int
pub cur_channel: int
pub channel_delta: int
pub ch_set: u16*
pub ch_set_a: u16*
pub ch_set_b: u16*
pub ch_set_c: u16*
pub n_pl: u8*
pub n_pl_b: u8*
pub n_pl_c: u8*
pub avr_plc_b: int
pub avr_ln1: int
pub avr_ln2: int
pub avr_ln3: int
pub num_huf: int
pub buf60: int
pub avr_plc: int
pub max_dist3: int
pub nhfb: int
pub nlzb: int
pub flags_cnt: int
pub flag_buf: int
pub st_mode: int
pub l_count: int
pub lax: bool
end
func _ro_new(ws: int): _ROld:
ret _ROld {
win = mem.AllocateZeroed(ws as u64) as u8*
wsize = ws
wmask = ws - 1
wp = 0
fl = 0
total = 0 as i64
left = 0 as i64
od = mem.AllocateZeroed(16 as u64) as int*
od_ptr = 0
last_len = 0
last_dist = 0
ld = _rh_new(_R2_NC)
dd = _rh_new(_R2_DC)
rd = _rh_new(_R2_RC)
bd = _rh_new(_R2_BC)
md0 = _rh_new(_R2_MC)
md1 = _rh_new(_R2_MC)
md2 = _rh_new(_R2_MC)
md3 = _rh_new(_R2_MC)
old_table = mem.AllocateZeroed(1100 as u64) as u8*
tbl = mem.AllocateZeroed(1100 as u64) as u8*
av = mem.AllocateZeroed((4 * 24 * 4) as u64) as int*
tables_read = false
audio = false
channels = 1
cur_channel = 0
channel_delta = 0
ch_set = mem.AllocateZeroed(520 as u64) as u16*
ch_set_a = mem.AllocateZeroed(520 as u64) as u16*
ch_set_b = mem.AllocateZeroed(520 as u64) as u16*
ch_set_c = mem.AllocateZeroed(520 as u64) as u16*
n_pl = mem.AllocateZeroed(256 as u64) as u8*
n_pl_b = mem.AllocateZeroed(256 as u64) as u8*
n_pl_c = mem.AllocateZeroed(256 as u64) as u8*
avr_plc_b = 0
avr_ln1 = 0
avr_ln2 = 0
avr_ln3 = 0
num_huf = 0
buf60 = 0
avr_plc = 0x3500
max_dist3 = 0x2001
nhfb = 0x80
nlzb = 0x80
flags_cnt = 0
flag_buf = 0
st_mode = 0
l_count = 0
lax = false
}
end
func _ro_free(o &: _ROld):
mem.Free(o.win as void*)
mem.Free(o.od as void*)
mem.Free(o.old_table as void*)
mem.Free(o.tbl as void*)
mem.Free(o.av as void*)
mem.Free(o.ch_set as void*)
mem.Free(o.ch_set_a as void*)
mem.Free(o.ch_set_b as void*)
mem.Free(o.ch_set_c as void*)
mem.Free(o.n_pl as void*)
mem.Free(o.n_pl_b as void*)
mem.Free(o.n_pl_c as void*)
_rh_free(o.ld)
_rh_free(o.dd)
_rh_free(o.rd)
_rh_free(o.bd)
_rh_free(o.md0)
_rh_free(o.md1)
_rh_free(o.md2)
_rh_free(o.md3)
end
func _ro_setwin(o &: _ROld, wsize: int): bool:
if wsize == o.wsize:
ret true
end
mem.Free(o.win as void*)
o.win = mem.AllocateZeroed(wsize as u64) as u8*
if o.win == null:
o.wsize = 0
o.wmask = 0
ret false
end
o.wsize = wsize
o.wmask = wsize - 1
ret true
end
func _ro_corr_huff(cs: u16*, np: u8*):
mut k := 0
mut i := 7
until i >= 0:
repeat 32:
cs[k] = (((cs[k] as int) & (~0xff)) | i) as u16
k++
end
i--
end
repeat 256 in j:
np[j] = 0 as u8
end
mut m := 6
until m >= 0:
np[m] = ((7 - m) * 32) as u8
m--
end
end
func _ro_init_huff(o &: _ROld):
repeat 256 in i:
o.ch_set[i] = (i << 8) as u16
o.ch_set_b[i] = (i << 8) as u16
o.ch_set_a[i] = i as u16
o.ch_set_c[i] = ((((~i) + 1) & 0xff) << 8) as u16
end
repeat 256 in j:
o.n_pl[j] = 0 as u8
o.n_pl_b[j] = 0 as u8
o.n_pl_c[j] = 0 as u8
end
_ro_corr_huff(o.ch_set_b, o.n_pl_b)
end
func _ro_reset(o &: _ROld):
o.wp = 0
o.fl = 0
o.total = 0 as i64
o.last_len = 0
o.last_dist = 0
o.od_ptr = 0
o.tables_read = false
o.audio = false
o.channel_delta = 0
o.cur_channel = 0
o.channels = 1
repeat 4 in i:
o.od[i] = 0
end
repeat 96 in i:
o.av[i] = 0
end
repeat 1100 in i:
o.old_table[i] = 0 as u8
end
o.avr_plc_b = 0
o.avr_ln1 = 0
o.avr_ln2 = 0
o.avr_ln3 = 0
o.num_huf = 0
o.buf60 = 0
o.avr_plc = 0x3500
o.max_dist3 = 0x2001
o.nhfb = 0x80
o.nlzb = 0x80
_ro_init_huff(o)
end
func _ro_drain(out &: compress.ByteBuf, sink &: compress.FileSink): bool:
if out.len > 0 and not compress.SinkWrite(sink, out.data, out.len):
ret false
end
out.len = 0
ret true
end
func _ro_flush(o &: _ROld, out &: compress.ByteBuf):
if o.wp > o.fl:
compress.BufPushBytes(out, ((o.win as i64) + (o.fl as i64)) as void*, o.wp - o.fl)
else o.wp < o.fl:
compress.BufPushBytes(out, ((o.win as i64) + (o.fl as i64)) as void*, o.wsize - o.fl)
if o.wp > 0:
compress.BufPushBytes(out, o.win as void*, o.wp)
end
end
o.fl = o.wp
end
func _ro_put(o &: _ROld, c: int):
o.win[o.wp] = c as u8
o.wp = (o.wp + 1) & o.wmask
o.total++
o.left--
end
func _ro_copy(o &: _ROld, len: int, dist: int): bool:
mut lim := o.total
if lim > (o.wsize as i64):
lim = o.wsize as i64
end
if len < 0:
ret false
end
mut wp := o.wp
if dist <= 0 or (dist as i64) > lim:
if not o.lax:
ret false
end
repeat len:
o.win[wp] = 0 as u8
wp = (wp + 1) & o.wmask
end
o.wp = wp
o.total += len as i64
o.left -= len as i64
ret true
end
mut src := (o.wp - dist) & o.wmask
repeat len:
o.win[wp] = o.win[src]
wp = (wp + 1) & o.wmask
src = (src + 1) & o.wmask
end
o.wp = wp
o.total += len as i64
o.left -= len as i64
ret true
end
func _ro_md(o &: _ROld, b &: _RarBits, ch: int): int:
if ch == 0:
ret _rh_decode(o.md0, b)
end
if ch == 1:
ret _rh_decode(o.md1, b)
end
if ch == 2:
ret _rh_decode(o.md2, b)
end
ret _rh_decode(o.md3, b)
end
func _ro_md_build(o &: _ROld, ch: int): bool:
lens := _poff(o.tbl, ch * _R2_MC)
if ch == 0:
ret _rh_build(o.md0, lens, _R2_MC)
end
if ch == 1:
ret _rh_build(o.md1, lens, _R2_MC)
end
if ch == 2:
ret _rh_build(o.md2, lens, _R2_MC)
end
ret _rh_build(o.md3, lens, _R2_MC)
end
func _ro20_tables(o &: _ROld, b &: _RarBits): bool:
bf := _rb_peek(b, 16)
o.audio = (bf & 0x8000) != 0
if (bf & 0x4000) == 0:
repeat 1100 in i:
o.old_table[i] = 0 as u8
end
end
b.pos += 2
mut size := _R2_NC + _R2_DC + _R2_RC
if o.audio:
o.channels = ((bf >> 12) & 3) + 1
if o.cur_channel >= o.channels:
o.cur_channel = 0
end
b.pos += 2
size = _R2_MC * o.channels
end
bl := _poff(o.tbl, 1050)
repeat _R2_BC in i:
bl[i] = _rb_read(b, 4) as u8
end
if not _rh_build(o.bd, bl, _R2_BC):
ret false
end
mut i := 0
until i < size:
if b.pos > b.n * 8:
ret false
end
num := _rh_decode(o.bd, b)
if num < 0:
ret false
end
if num < 16:
o.tbl[i] = ((num + (o.old_table[i] as int)) & 15) as u8
i++
else num == 16:
mut cnt := _rb_read(b, 2) + 3
if i == 0:
ret false
end
until cnt > 0 and i < size:
o.tbl[i] = o.tbl[i - 1]
i++
cnt--
end
else:
mut cnt := 0
if num == 17:
cnt = _rb_read(b, 3) + 3
else:
cnt = _rb_read(b, 7) + 11
end
until cnt > 0 and i < size:
o.tbl[i] = 0 as u8
i++
cnt--
end
end
end
o.tables_read = true
if b.pos > b.n * 8:
ret true
end
if o.audio:
repeat o.channels in c:
if not _ro_md_build(o, c):
ret false
end
end
else:
if not _rh_build(o.ld, o.tbl, _R2_NC):
ret false
end
if not _rh_build(o.dd, _poff(o.tbl, _R2_NC), _R2_DC):
ret false
end
if not _rh_build(o.rd, _poff(o.tbl, _R2_NC + _R2_DC), _R2_RC):
ret false
end
end
repeat size in j:
o.old_table[j] = o.tbl[j]
end
ret true
end
func _ro20_audio(o &: _ROld, delta: int): int:
v := o.cur_channel * 24
av := o.av
av[v + 11]++
av[v + 8] = av[v + 7]
av[v + 7] = av[v + 6]
av[v + 6] = av[v + 9] - av[v + 5]
av[v + 5] = av[v + 9]
mut pch := 8 * av[v + 10] + av[v] * av[v + 5] + av[v + 1] * av[v + 6] + av[v + 2] * av[v + 7] + av[v + 3] * av[v + 8] + av[v + 4] * o.channel_delta
pch = (pch >> 3) & 255
ch := (pch - delta) & 255
d := _r3_s8(delta) << 3
av[v + 12] += _r3_abs(d)
av[v + 13] += _r3_abs(d - av[v + 5])
av[v + 14] += _r3_abs(d + av[v + 5])
av[v + 15] += _r3_abs(d - av[v + 6])
av[v + 16] += _r3_abs(d + av[v + 6])
av[v + 17] += _r3_abs(d - av[v + 7])
av[v + 18] += _r3_abs(d + av[v + 7])
av[v + 19] += _r3_abs(d - av[v + 8])
av[v + 20] += _r3_abs(d + av[v + 8])
av[v + 21] += _r3_abs(d - o.channel_delta)
av[v + 22] += _r3_abs(d + o.channel_delta)
nd := _r3_s8((ch - av[v + 10]) & 255)
o.channel_delta = nd
av[v + 9] = nd
av[v + 10] = ch
if (av[v + 11] & 0x1f) == 0:
mut mind := av[v + 12]
mut nm := 0
av[v + 12] = 0
mut k := 1
until k < 11:
if av[v + 12 + k] < mind:
mind = av[v + 12 + k]
nm = k
end
av[v + 12 + k] = 0
k++
end
if nm >= 1 and nm <= 10:
w := (nm - 1) >> 1
if (nm & 1) == 1:
if av[v + w] >= -16:
av[v + w]--
end
else:
if av[v + w] < 16:
av[v + w]++
end
end
end
end
ret ch
end
func _ro20_decode(o &: _ROld, p: u8*, n: int, unp: i64, limit: i64, solid: bool, out &: compress.ByteBuf, sink &: compress.FileSink, stream: bool): int:
mut s := _rsrc_mem(p, n)
st := _ro20_decode_src(o, s, unp, limit, solid, out, sink, stream)
_rsrc_free(s)
ret st
end
func _ro20_decode_src(o &: _ROld, s &: _RarSrc, unp: i64, limit: i64, solid: bool, out &: compress.ByteBuf, sink &: compress.FileSink, stream: bool): int:
if unp < 0:
ret 2
end
mut sm := _RarStrm { base = 0 as i64, soff = 0 as i64, stream = false, cap = 0 }
mut b := _rb_open(s, sm)
st := _ro20_run(o, b, sm, s, unp, limit, solid, out, sink, stream)
_rb_close(b, sm)
ret st
end
func _ro20_run(o &: _ROld, b &: _RarBits, sm &: _RarStrm, s &: _RarSrc, unp: i64, limit: i64, solid: bool, out &: compress.ByteBuf, sink &: compress.FileSink, stream: bool): int:
base := out.len
start_total := o.total
o.fl = o.wp
o.left = unp
o.lax = false
if not solid or not o.tables_read:
if not _ro20_tables(o, b):
ret 4
end
end
mut gpos := -1 as i64
mut gtot := o.total - (1 as i64)
mut stall := 0
until o.left > 0:
_rb_fill(b, sm, s)
if _rb_done(b, sm, s):
break
end
if _rb_apos(b, sm) == gpos and o.total == gtot:
stall++
if stall > 1000:
ret 4
end
else:
stall = 0
end
gpos = _rb_apos(b, sm)
gtot = o.total
if (o.total - start_total) > limit:
ret 7
end
if ((o.wp - o.fl) & o.wmask) >= (o.wsize >> 1):
_ro_flush(o, out)
if stream and not _ro_drain(out, sink):
ret 7
end
end
if o.audio:
an := _ro_md(o, b, o.cur_channel)
if an < 0:
ret 4
end
if an == 256:
if not _ro20_tables(o, b):
ret 4
end
continue
end
_ro_put(o, _ro20_audio(o, an))
o.cur_channel++
if o.cur_channel == o.channels:
o.cur_channel = 0
end
continue
end
num := _rh_decode(o.ld, b)
if num < 0:
ret 4
end
if num < 256:
_ro_put(o, num)
else num > 269:
sl := num - 270
mut ml := _R2_LDEC[sl] + 3
lb := _R2_LBITS[sl]
if lb > 0:
ml += _rb_read(b, lb)
end
dn := _rh_decode(o.dd, b)
if dn < 0:
ret 4
end
mut dist := _R2_DDEC[dn] + 1
db := _R2_DBITS[dn]
if db > 0:
dist += _rb_read(b, db)
end
if dist >= 0x2000:
ml++
if dist >= 0x40000:
ml++
end
end
o.last_dist = dist
o.od[o.od_ptr] = dist
o.od_ptr = (o.od_ptr + 1) & 3
o.last_len = ml
if not _ro_copy(o, ml, dist):
ret 4
end
else num == 269:
if not _ro20_tables(o, b):
ret 4
end
else num == 256:
o.od[o.od_ptr] = o.last_dist
o.od_ptr = (o.od_ptr + 1) & 3
if not _ro_copy(o, o.last_len, o.last_dist):
ret 4
end
else num < 261:
dist := o.od[(o.od_ptr - (num - 256)) & 3]
ln := _rh_decode(o.rd, b)
if ln < 0:
ret 4
end
mut ml := _R2_LDEC[ln] + 2
lb := _R2_LBITS[ln]
if lb > 0:
ml += _rb_read(b, lb)
end
if dist >= 0x101:
ml++
if dist >= 0x2000:
ml++
if dist >= 0x40000:
ml++
end
end
end
o.last_dist = dist
o.od[o.od_ptr] = dist
o.od_ptr = (o.od_ptr + 1) & 3
o.last_len = ml
if not _ro_copy(o, ml, dist):
ret 4
end
else:
sn := num - 261
mut dist := _R2_SDEC[sn] + 1
sb := _R2_SBITS[sn]
if sb > 0:
dist += _rb_read(b, sb)
end
o.last_dist = dist
o.od[o.od_ptr] = dist
o.od_ptr = (o.od_ptr + 1) & 3
o.last_len = 2
if not _ro_copy(o, 2, dist):
ret 4
end
end
end
if (b.n * 8 - b.pos) >= 40:
if o.audio:
if _ro_md(o, b, o.cur_channel) == 256:
_ro20_tables(o, b)
end
else:
if _rh_decode(o.ld, b) == 269:
_ro20_tables(o, b)
end
end
end
_ro_flush(o, out)
produced := o.total - start_total
if produced < unp:
ret 4
end
if produced > unp:
if stream:
if produced - unp > (out.len as i64):
ret 4
end
out.len -= ((produced - unp) as int)
else:
out.len = base + (unp as int)
end
end
if stream and not _ro_drain(out, sink):
ret 7
end
ret 0
end
func _r1_num(b &: _RarBits, num0: int, start0: int, dec: int[], pos: int[]): int:
num := num0 & 0xfff0
mut start := start0
mut i := 0
until dec[i] <= num:
start++
i++
end
b.pos += start
mut base := 0
if i > 0:
base = dec[i - 1]
end
ret ((num - base) >> (16 - start)) + pos[start]
end
func _r1_flags(o &: _ROld, b &: _RarBits):
fp := _r1_num(b, _rb_peek(b, 16), 5, _R1_DECHF2, _R1_POSHF2)
if fp >= 256:
ret
end
mut nfp := 0
mut fl := 0
until true:
fl = o.ch_set_c[fp] as int
o.flag_buf = fl >> 8
nfp = o.n_pl_c[fl & 0xff] as int
o.n_pl_c[fl & 0xff] = ((nfp + 1) & 255) as u8
fl++
if (fl & 0xff) != 0:
break
end
_ro_corr_huff(o.ch_set_c, o.n_pl_c)
end
o.ch_set_c[fp] = o.ch_set_c[nfp]
o.ch_set_c[nfp] = (fl & 0xffff) as u16
end
func _r1_push_dist(o &: _ROld, dist: int, len: int):
o.od[o.od_ptr] = dist
o.od_ptr = (o.od_ptr + 1) & 3
o.last_len = len
o.last_dist = dist
end
func _r1_huff(o &: _ROld, b &: _RarBits): bool:
mut bf := _rb_peek(b, 16)
mut bp := 0
if o.avr_plc > 0x75ff:
bp = _r1_num(b, bf, 8, _R1_DECHF4, _R1_POSHF4)
else o.avr_plc > 0x5dff:
bp = _r1_num(b, bf, 6, _R1_DECHF3, _R1_POSHF3)
else o.avr_plc > 0x35ff:
bp = _r1_num(b, bf, 5, _R1_DECHF2, _R1_POSHF2)
else o.avr_plc > 0x0dff:
bp = _r1_num(b, bf, 5, _R1_DECHF1, _R1_POSHF1)
else:
bp = _r1_num(b, bf, 4, _R1_DECHF0, _R1_POSHF0)
end
bp &= 0xff
if o.st_mode != 0:
if bp == 0 and bf > 0xfff:
bp = 0x100
end
bp--
if bp == -1:
bf = _rb_peek(b, 16)
b.pos++
if (bf & 0x8000) != 0:
o.num_huf = 0
o.st_mode = 0
ret true
end
mut length := 3
if (bf & 0x4000) != 0:
length = 4
end
b.pos++
mut dist := _r1_num(b, _rb_peek(b, 16), 5, _R1_DECHF2, _R1_POSHF2)
dist = (dist << 5) | (_rb_peek(b, 16) >> 11)
b.pos += 5
ret _ro_copy(o, length, dist)
end
else:
o.num_huf++
if o.num_huf > 16 and o.flags_cnt == 0:
o.st_mode = 1
end
end
o.avr_plc += bp
o.avr_plc -= o.avr_plc >> 8
o.nhfb += 16
if o.nhfb > 0xff:
o.nhfb = 0x90
o.nlzb >>= 1
end
if bp > 255:
ret false
end
_ro_put(o, (o.ch_set[bp] as int) >> 8)
mut cur := 0
mut nbp := 0
until true:
cur = o.ch_set[bp] as int
nbp = o.n_pl[cur & 0xff] as int
o.n_pl[cur & 0xff] = ((nbp + 1) & 255) as u8
cur++
if (cur & 0xff) > 0xa1:
_ro_corr_huff(o.ch_set, o.n_pl)
else:
