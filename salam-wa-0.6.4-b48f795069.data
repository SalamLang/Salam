func _str_len_of(p: Paragraph): int:
ret str.Len(p.text)
end
func _first_face(p: Paragraph): int:
each c in p.chars:
if c.face >= 0:
ret c.face
end
end
ret -1
end
@en "LayoutParagraph"
@fa "چیدن بند"
pub func LayoutParagraph(p &: Paragraph, fc &: FontCollection, max_width: f64): TextLayout:
mut l := TextLayout {}
l.max_width = max_width
mut max26 := 0
if max_width > 0.0:
max26 = _to26(max_width)
end
mut lines := Vector {} as Vector<_LLine>
defer lines.free()
_break_lines(p, max26, lines)
mut count := lines.len()
if p.style.max_lines > 0 and count > p.style.max_lines:
count = p.style.max_lines
l.truncated = true
end
nowrap := not _ws_wraps(p.style.white_space)
mut top := 0
mut i := 0
until i < count:
ll := lines.get(i)
last := i == lines.len() - 1
mut ell := false
if p.style.ellipsis and max26 > 0:
if l.truncated and i == count - 1:
ell = true
else nowrap and _width(p, ll.s, _content_end(p, ll.s, ll.e)) > max26:
ell = true
l.truncated = true
end
end
_place_line(p, fc, l, ll, max26, last, ell, top)
i++
end
mut w := 0.0
each lb in l.lines:
if lb.width > w:
w = lb.width
end
end
if max_width > 0.0:
l.width = max_width
else:
l.width = w
end
l.height = _from26(top)
ret l
end
@en "FreeLayout"
@fa "آزادسازی چیدمان"
pub func FreeLayout(l &: TextLayout):
l.lines.free()
l.runs.free()
l.glyphs.free()
l.lines = Vector {} as Vector<LineBox>
l.runs = Vector {} as Vector<GlyphRun>
l.glyphs = Vector {} as Vector<PlacedGlyph>
end
package typeset
import unicode
const _LB_AL := 0
const _LB_BK := 1
const _LB_CR := 2
const _LB_LF := 3
const _LB_NL := 4
const _LB_SP := 5
const _LB_ZW := 6
const _LB_WJ := 7
const _LB_GL := 8
const _LB_ZWJ := 9
const _LB_CM := 10
const _LB_BA := 11
const _LB_HY := 12
const _LB_B2 := 13
const _LB_BB := 14
const _LB_OP := 15
const _LB_CL := 16
const _LB_CP := 17
const _LB_QU := 18
const _LB_EX := 19
const _LB_IS := 20
const _LB_SY := 21
const _LB_NU := 22
const _LB_PR := 23
const _LB_PO := 24
const _LB_ID := 25
const _LB_NS := 26
const _LB_IN := 27
const _BRK_NONE := 0
const _BRK_ALLOW := 1
const _BRK_MUST := 2
func _lb_cjk(cp: int): int:
switch cp:
0x3000: ret _LB_BA end
0x3001, 0x3002, 0xFF0C, 0xFF0E, 0xFF09, 0xFF3D, 0xFF5D: ret _LB_CL end
0x3005, 0x30FC, 0x309D, 0x309E, 0x30FD, 0x30FE, 0xFF1A, 0xFF1B: ret _LB_NS end
0x3008, 0x300A, 0x300C, 0x300E, 0x3010, 0x3014, 0x3016, 0x3018, 0x301A, 0xFF08, 0xFF3B, 0xFF5B: ret _LB_OP end
0x3009, 0x300B, 0x300D, 0x300F, 0x3011, 0x3015, 0x3017, 0x3019, 0x301B: ret _LB_CL end
0xFF01, 0xFF1F: ret _LB_EX end
else: ret _LB_ID end
end
ret _LB_ID
end
func _lb_special(cp: int): int:
switch cp:
0x85: ret _LB_NL end
0xA0, 0x202F, 0x2007, 0x2011, 0x0F0C: ret _LB_GL end
0xAD, 0x2010, 0x2012, 0x2013, 0x058A, 0x2027, 0x1680, 0x2000, 0x2001, 0x2002, 0x2003, 0x2004, 0x2005, 0x2006, 0x2008, 0x2009, 0x200A: ret _LB_BA end
0x2014: ret _LB_B2 end
0x200B: ret _LB_ZW end
0x2060, 0xFEFF: ret _LB_WJ end
0x200D: ret _LB_ZWJ end
0x2028, 0x2029: ret _LB_BK end
0xAB, 0xBB, 0x2018, 0x2019, 0x201A, 0x201B, 0x201C, 0x201D, 0x201E, 0x201F, 0x2039, 0x203A: ret _LB_QU end
0x060C, 0x060D, 0x066B, 0x066C: ret _LB_IS end
0x061B, 0x061F, 0x06D4, 0x203C, 0x2049: ret _LB_EX end
0x066A, 0x2030, 0x2031, 0x2032, 0x2033, 0x00B0, 0x2103: ret _LB_PO end
0x00A3, 0x00A5, 0x20AC, 0x20B9, 0xFDFC, 0x00B1, 0x2116: ret _LB_PR end
0x2024, 0x2025, 0x2026: ret _LB_IN end
0x00B4, 0x02C8, 0x02CC: ret _LB_BB end
