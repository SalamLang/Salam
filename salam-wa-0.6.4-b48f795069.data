pub fn: func (Builder) = (_b: Builder): _sc_touched.clear() end
pub dnode: int = -1
pub pre: int = 0
pub count: int = 0
pub bstart: int = 0
pub comp: int = -1
pub slot: int = -1
pub fresh: bool = false
pub taken: bool = false
pub alive: bool = false
pub dirty: bool = false
end
func _sc_new(): int:
if _sc_free.len() > 0:
id := _sc_free.pop()
mut s := _sc.ref(id)
s.kids = Vector {} as Vector<int>
s.alive = true
s.dirty = false
s.taken = false
s.fresh = false
s.comp = -1
s.slot = -1
s.count = 0
s.pre = 0
s.key = ""
ret id
end
mut s := _Scope { alive = true }
s.kids = Vector {} as Vector<int>
_sc.push(s)
ret _sc.len() - 1
end
func _sc_slot_alloc(comp: int): int:
repeat _sc_slot_free_c.len() in i:
if _sc_slot_free_c[i] == comp:
s := _sc_slot_free_s[i]
_sc_slot_free_c.remove_at(i)
_sc_slot_free_s.remove_at(i)
ret s
end
end
until _sc_slot_next.len() <= comp:
_sc_slot_next.push(0)
end
s := _sc_slot_next[comp]
_sc_slot_next[comp] = s + 1
ret s
end
func _sc_release(id: int):
if id < 0 or id >= _sc.len() or not _sc[id].alive:
ret
end
kids := _sc[id].kids
each k in kids:
_sc_release(k)
end
mut s := _sc.ref(id)
if s.slot >= 0 and s.comp >= 0:
_sc_slot_free_c.push(s.comp)
_sc_slot_free_s.push(s.slot)
end
s.slot = -1
s.alive = false
if s.key.len() > 0:
_sfree(s.key)
s.key = ""
end
s.kids.free()
s.kids = Vector {} as Vector<int>
_sc_free.push(id)
end
func _sc_release_all():
repeat _sc.len() in i:
if _sc[i].alive:
mut s := _sc.ref(i)
s.alive = false
if s.key.len() > 0:
_sfree(s.key)
s.key = ""
end
s.kids.free()
s.kids = Vector {} as Vector<int>
end
end
_sc.clear()
_sc_free.clear()
_sc_root = -1
end
func _sc_reset():
_sc_release_all()
_sc_on = false
_sc_words = 0
_sc_site_mask.clear()
_sc_site_comp.clear()
_sc_runs = 0
_sc_invalid = false
_sc_touch_comp.clear()
_sc_touch_slot.clear()
_sc_slot_next.clear()
_sc_slot_free_c.clear()
_sc_slot_free_s.clear()
_sc_dead = 0
_sc_cur = -1
end
func _sc_pos(id: int): int:
s := _sc[id]
p := s.parent
if p < 0:
ret s.pre
end
mut base := 0
if _sc[p].dnode == s.dnode:
base = _sc_pos(p)
end
base += s.pre
each k in _sc[p].kids:
if k == id:
break
end
if _sc[k].dnode == s.dnode:
base += _sc[k].count
end
end
ret base
end
func _sc_open(site: int, key: str, fn: func (Builder)):
d := _b_top()
parent := _sc_cur
id := _sc_new()
start := _bd.nodes[d].kids.len()
mut base := 0
mut nth := 0
if parent >= 0:
if _sc[parent].dnode == d:
base = _sc[parent].bstart
end
each k in _sc[parent].kids:
if _sc[k].dnode == d:
base += _sc[k].count
end
if _sc[k].site == site and _sc[k].key == key:
nth++
end
end
end
mut old := -1
mut seen := 0
each m in _sc_match:
if _sc[m].site == site and _sc[m].key == key:
if seen == nth:
if not _sc[m].taken:
old = m
end
break
end
seen++
end
end
mut sc := _sc.ref(id)
sc.site = site
if key.len() > 0:
sc.key = str.Clone(key)
end
sc.parent = parent
sc.fn = fn
sc.dnode = d
sc.bstart = start
sc.pre = start - base
if old >= 0:
mut o := _sc.ref(old)
o.taken = true
sc.comp = o.comp
sc.slot = o.slot
o.slot = -1
end
if parent >= 0:
mut ps := _sc.ref(parent)
ps.kids.push(id)
else:
_sc_root = id
end
saved := _sc_match
if old >= 0:
_sc_match = _sc[old].kids
else:
_sc_match = Vector {} as Vector<int>
end
_sc_cur = id
fn(Builder {})
_sc_cur = parent
if old < 0:
_sc_match.free()
end
_sc_match = saved
mut sc2 := _sc.ref(id)
sc2.count = _bd.nodes[d].kids.len() - start
end
func _sc_instance(comp: int): int:
if _sc_cur < 0:
ret 0
end
mut s := _sc.ref(_sc_cur)
if s.slot < 0:
s.comp = comp
s.slot = _sc_slot_alloc(comp)
s.fresh = true
else:
s.fresh = false
end
ret s.slot
end
func _sc_is_fresh(): bool:
