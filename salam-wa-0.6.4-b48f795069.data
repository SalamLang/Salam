_poly_flush_blk(st, 0 as u32)
end
mut h0 := st.h[0]
mut h1 := st.h[1]
mut h2 := st.h[2]
mut h3 := st.h[3]
mut h4 := st.h[4]
mut c := h1 >> (26 as u32)
h1 &= POLY_MASK26
h2 += c
c = h2 >> (26 as u32)
h2 &= POLY_MASK26
h3 += c
c = h3 >> (26 as u32)
h3 &= POLY_MASK26
h4 += c
c = h4 >> (26 as u32)
h4 &= POLY_MASK26
h0 += c * (5 as u32)
c = h0 >> (26 as u32)
h0 &= POLY_MASK26
h1 += c
mut g0 := h0 + (5 as u32)
c = g0 >> (26 as u32)
g0 &= POLY_MASK26
mut g1 := h1 + c
c = g1 >> (26 as u32)
g1 &= POLY_MASK26
mut g2 := h2 + c
c = g2 >> (26 as u32)
g2 &= POLY_MASK26
mut g3 := h3 + c
c = g3 >> (26 as u32)
g3 &= POLY_MASK26
g4 := h4 + c - ((1 as u32) << (26 as u32))
mut mask := (g4 >> (31 as u32)) - (1 as u32)
g0 &= mask
g1 &= mask
g2 &= mask
g3 &= mask
g4m := g4 & mask
mask = ~mask
h0 = (h0 & mask) | g0
h1 = (h1 & mask) | g1
h2 = (h2 & mask) | g2
h3 = (h3 & mask) | g3
h4 = (h4 & mask) | g4m
h0 |= (h1 << (26 as u32))
h1 = ((h1 >> (6 as u32)) | (h2 << (20 as u32)))
h2 = ((h2 >> (12 as u32)) | (h3 << (14 as u32)))
h3 = ((h3 >> (18 as u32)) | (h4 << (8 as u32)))
mut f := (h0 as u64) + (st.pad[0] as u64)
h0 = f as u32
f = (h1 as u64) + (st.pad[1] as u64) + (f >> (32 as u64))
h1 = f as u32
f = (h2 as u64) + (st.pad[2] as u64) + (f >> (32 as u64))
h2 = f as u32
f = (h3 as u64) + (st.pad[3] as u64) + (f >> (32 as u64))
h3 = f as u32
_ple32(h0, out, 0)
_ple32(h1, out, 4)
_ple32(h2, out, 8)
_ple32(h3, out, 12)
end
func _poly1305(key: void*, msg: void*, n: int, out: void*):
mut st := _poly_init(key)
_poly_update(st, msg, n)
_poly_final(st, out)
end
func _poly_pad16(st &: Poly1305, n: int):
if n % 16 == 0:
ret
end
until st.blen < 16:
st.blk[st.blen] = 0 as u8
st.blen++
end
_poly_flush_blk(st, (1 as u32) << (24 as u32))
end
func _cha20poly_tag(key: void*, nonce: void*, aad: void*, aadlen: int, ct: void*, ctlen: int, tag: void*):
otk := mem.Allocate(64 as u64)
_cha_block(key, 0 as u32, nonce, otk)
mut st := _poly_init(otk)
_wipe(otk, 64)
mem.Free(otk)
if aadlen > 0:
_poly_update(st, aad, aadlen)
end
_poly_pad16(st, aadlen)
if ctlen > 0:
_poly_update(st, ct, ctlen)
end
_poly_pad16(st, ctlen)
_poly_words(st, aadlen as u32, 0 as u32, ctlen as u32, 0 as u32, (1 as u32) << (24 as u32))
_poly_final(st, tag)
end
func _cha20poly_seal(key: void*, nonce: void*, aad: void*, aadlen: int, pt: void*, ct: void*, n: int, tag: void*):
_cha20_xor(key, 1 as u32, nonce, pt, ct, n)
_cha20poly_tag(key, nonce, aad, aadlen, ct, n, tag)
end
func _cha20poly_open(key: void*, nonce: void*, aad: void*, aadlen: int, ct: void*, n: int, tag: void*, pt: void*): bool:
want := mem.Allocate(16 as u64)
_cha20poly_tag(key, nonce, aad, aadlen, ct, n, want)
good := _cteq(want, tag, 16)
mem.Free(want)
if not good:
ret false
end
_cha20_xor(key, 1 as u32, nonce, ct, pt, n)
ret true
end
package tls
import mem
import net.internal.rawsock
@en "Config"
@fa "پیکربندی"
pub struct Config:
@en "server_name"
@fa "نام کارساز"
pub server_name: str = ""
@en "ca_file"
@fa "پرونده گواهی ریشه"
pub ca_file: str = ""
@en "insecure_skip_verify"
@fa "بدون بررسی گواهی"
pub insecure_skip_verify: bool = false
@en "alpn"
@fa "پروتکل برنامه"
pub alpn: str = ""
@en "aes_only"
@fa "فقط ای‌ای‌اس"
pub aes_only: bool = false
@en "frag_tls"
@fa "تکه تکه کردن رکورد"
pub frag_tls: bool = false
@en "frag_tcp"
@fa "تکه تکه کردن بسته"
pub frag_tcp: bool = false
@en "frag_sni"
@fa "برش نام سرور"
pub frag_sni: bool = false
@en "frag_min"
@fa "کمینه اندازه تکه"
pub frag_min: int = 5
@en "frag_max"
@fa "بیشینه اندازه تکه"
pub frag_max: int = 20
@en "frag_delay_ms"
@fa "تاخیر بین تکه ها"
pub frag_delay_ms: int = 0
@en "frag_writes"
@fa "شمار نوشتن های تکه شده"
pub frag_writes: int = 1
end
@en "Conn"
@fa "اتصال"
pub struct Conn:
@en "h"
@fa "دست‌دهی"
pub h: Handshake = Handshake {}
@en "host"
@fa "میزبان"
pub host: str = ""
@en "open"
@fa "باز"
pub open: bool = false
@en "insecure"
@fa "ناامن"
pub insecure: bool = false
@en "pending"
@fa "داده معلق"
pub pending: Buf = Buf {}
@en "err"
@fa "خطا"
pub err: str = ""
@en "rdone"
@fa "پایان خواندن"
pub rdone: bool = false
@en "wdone"
@fa "پایان نوشتن"
pub wdone: bool = false
@en "direct"
@fa "خواندن مستقیم"
pub direct: bool = false
end
func _conn_fail(c &: Conn, msg: str): bool:
if c.err.len() == 0:
c.err = msg
end
c.open = false
ret false
end
func _traffic_update(h &: Handshake, secret &: Buf): bool:
mut next := _newbuf(h.hlen)
defer _buf_wipe(next)
_putzeros(next, h.hlen)
if not _hkdf_expand_label(h.hash, secret.p, secret.len, "traffic upd", null, 0, next.p, h.hlen):
ret false
end
_bufreset(secret)
_putbuf(secret, next)
ret true
end
func _do_key_update(c &: Conn, requested: bool): bool:
if c.h.ver != TLS13:
ret false
end
if not _traffic_update(c.h, c.h.s_ap_secret):
ret false
end
_tk_free(c.h.rec.rxk)
c.h.rec.rxk = _tk_derive(c.h.s_ap_secret.p, c.h.s_ap_secret.len, c.h.cipher)
if not c.h.rec.rxk.live:
ret false
end
if not requested:
ret true
end
mut msg := _newbuf(8)
defer _buf_free(msg)
_put8(msg, HS_KEY_UPDATE)
_put24(msg, 1)
_put8(msg, 0)
if not _rec_write(c.h.rec, REC_HANDSHAKE, msg.p, msg.len):
ret false
end
if not _traffic_update(c.h, c.h.c_ap_secret):
ret false
end
_tk_free(c.h.rec.txk)
c.h.rec.txk = _tk_derive(c.h.c_ap_secret.p, c.h.c_ap_secret.len, c.h.cipher)
ret c.h.rec.txk.live
end
func _fill_pending(c &: Conn): bool:
mut guard := 0
until c.pending.len == 0 and guard < 64:
guard++
mut typ := 0
mut p := null as void*
mut n := 0
if not _rec_open(c.h.rec, typ, p, n):
c.open = false
if c.h.rec.err.len() > 0:
c.err = c.h.rec.err
end
ret false
end
frag := Buf { p = p, len = n, cap = n, bad = false }
if typ == REC_APPLICATION_DATA:
c.pending = frag
else if typ == REC_ALERT:
c.open = false
if _bufat(frag, 1) == ALERT_CLOSE_NOTIFY:
c.rdone = true
end
if _bufat(frag, 1) != ALERT_CLOSE_NOTIFY:
c.err = _alert_text(frag)
end
ret false
else if typ == REC_HANDSHAKE:
if frag.len >= 4:
if _bufat(frag, 0) == HS_KEY_UPDATE:
req := _bufat(frag, 4) == 1
if not _do_key_update(c, req):
c.open = false
c.err = "key update failed"
ret false
end
end
end
continue
end
end
ret true
end
func _pending_take(c &: Conn, n: int):
c.pending.p = ((c.pending.p as i64) + (n as i64)) as void*
c.pending.len -= n
end
@en "NewConfig"
@fa "پیکربندی جدید"
pub func NewConfig(server_name: str): Config:
mut c := Config {}
c.server_name = server_name
ret c
end
@en "Dial"
@fa "اتصال امن"
pub func Dial(host: str, port: int, cfg: Config): Conn:
mut c := Conn {}
c.insecure = cfg.insecure_skip_verify
mut conf := cfg
if conf.server_name.len() == 0:
conf.server_name = host
end
c.host = conf.server_name
s := rawsock.Connect(host, port)
if not rawsock.Ok(s):
c.err = "could not connect to " + host
ret c
end
c.h = Handshake {}
c.h.rec = _rec_new(s.fd)
c.h.priv = _newbuf(32)
c.h.pub_key = _newbuf(32)
c.h.shared = _newbuf(32)
c.h.hs_secret = _newbuf(48)
c.h.master = _newbuf(48)
c.h.c_hs_secret = _newbuf(48)
c.h.s_hs_secret = _newbuf(48)
c.h.c_ap_secret = _newbuf(48)
c.h.s_ap_secret = _newbuf(48)
c.h.certs = _newbuf(8192)
c.h.cert_off = _newbuf(128)
c.h.crand = _newbuf(32)
c.h.srand = _newbuf(32)
c.h.ecpriv = _newbuf(32)
c.h.ecpub = _newbuf(65)
_rec_set_fragment(c.h.rec, conf)
c.h.rec.read_deadline_ms = HANDSHAKE_READ_TIMEOUT_MS
_do_handshake(c, conf)
c.h.rec.read_deadline_ms = 0
_rec_uncork(c.h.rec)
ret c
end
@en "WrapClient"
@fa "پوشش کارخواه"
pub func WrapClient(fd: i64, cfg: Config): Conn:
mut c := Conn {}
c.insecure = cfg.insecure_skip_verify
conf := cfg
c.host = conf.server_name
if fd < 0:
c.err = "invalid fd"
ret c
end
c.h = Handshake {}
c.h.rec = _rec_new(fd)
c.h.priv = _newbuf(32)
c.h.pub_key = _newbuf(32)
c.h.shared = _newbuf(32)
c.h.hs_secret = _newbuf(48)
c.h.master = _newbuf(48)
c.h.c_hs_secret = _newbuf(48)
c.h.s_hs_secret = _newbuf(48)
c.h.c_ap_secret = _newbuf(48)
c.h.s_ap_secret = _newbuf(48)
c.h.certs = _newbuf(8192)
c.h.cert_off = _newbuf(128)
c.h.crand = _newbuf(32)
c.h.srand = _newbuf(32)
c.h.ecpriv = _newbuf(32)
c.h.ecpub = _newbuf(65)
_rec_set_fragment(c.h.rec, conf)
c.h.rec.read_deadline_ms = HANDSHAKE_READ_TIMEOUT_MS
_do_handshake(c, conf)
c.h.rec.read_deadline_ms = 0
_rec_uncork(c.h.rec)
ret c
end
@en "NewServerConfig"
@fa "پیکربندی کارساز جدید"
pub func NewServerConfig(cert_file: str, key_file: str): ServerConfig:
mut cfg := ServerConfig {}
cfg.chain = LoadCertChainFile(cert_file)
cfg.key = LoadPrivateKeyFile(key_file)
cfg.ok = cfg.chain.count > 0 and cfg.key.ok
ret cfg
end
@en "WrapServer"
@fa "پوشش کارساز"
pub func WrapServer(fd: i64, cfg: ServerConfig): Conn:
mut c := Conn {}
if not cfg.ok:
c.err = "server config did not load (bad certificate or key file)"
ret c
end
c.h = Handshake {}
c.h.rec = _rec_new(fd)
c.h.priv = _newbuf(32)
c.h.pub_key = _newbuf(32)
c.h.shared = _newbuf(32)
c.h.hs_secret = _newbuf(48)
c.h.master = _newbuf(48)
c.h.c_hs_secret = _newbuf(48)
c.h.s_hs_secret = _newbuf(48)
c.h.c_ap_secret = _newbuf(48)
c.h.s_ap_secret = _newbuf(48)
c.h.certs = _newbuf(8192)
c.h.cert_off = _newbuf(128)
c.h.crand = _newbuf(32)
c.h.srand = _newbuf(32)
c.h.ecpriv = _newbuf(32)
c.h.ecpub = _newbuf(65)
c.h.rec.read_deadline_ms = HANDSHAKE_READ_TIMEOUT_MS
_do_server_handshake(c, cfg)
c.h.rec.read_deadline_ms = 0
_rec_uncork(c.h.rec)
if SALAM_OS_LINUX:
if c.open:
_rec_ack_now(c.h.rec)
end
end
ret c
end
@en "ConnOk"
@fa "اتصال معتبر"
pub func ConnOk(c: Conn): bool:
ret c.open
end
@en "ConnError"
@fa "خطای اتصال"
pub func ConnError(c: Conn): str:
ret c.err
end
@en "Write"
@fa "نوشتن"
pub func Write(c &: Conn, data: str): int:
ret WriteBytes(c, data as void*, data.len())
end
@en "WriteBytes"
@fa "نوشتن بایت"
pub func WriteBytes(c &: Conn, ptr: void*, n: int): int:
if c.wdone or (not c.open and not c.rdone):
ret 0 - 1
end
if not _rec_write(c.h.rec, REC_APPLICATION_DATA, ptr, n):
_conn_fail(c, "write failed: " + c.h.rec.err)
ret 0 - 1
end
ret n
end
@en "Cork"
@fa "نگه داشتن نوشتن"
pub func Cork(c &: Conn):
c.h.rec.corked = true
end
@en "Flush"
@fa "فرستادن نوشته ها"
pub func Flush(c &: Conn): bool:
if not c.open:
ret false
end
if not _rec_uncork(c.h.rec):
_conn_fail(c, "write failed: " + c.h.rec.err)
ret false
end
ret true
end
@en "Read"
@fa "خواندن"
pub func Read(c &: Conn, max: int): str:
if not c.open:
ret ""
end
if not _fill_pending(c):
ret ""
end
if c.pending.len == 0:
ret ""
end
mut take := c.pending.len
if max > 0 and take > max:
take = max
end
out := Buf { p = c.pending.p, len = take, cap = take, bad = false }
text := _bufstr(out)
_pending_take(c, take)
ret text
end
@en "ReadBytes"
@fa "خواندن بایت"
pub func ReadBytes(c &: Conn, buf: void*, max: int): int:
if not c.open:
ret 0
end
if c.direct and c.pending.len == 0:
ret _rec_read_raw(c.h.rec, buf, max)
end
if not _fill_pending(c):
ret 0
end
if c.pending.len == 0:
ret 0
end
mut take := c.pending.len
if max > 0 and take > max:
take = max
end
mem.Copy(buf, c.pending.p, take as u64)
_pending_take(c, take)
ret take
end
@en "SwitchDirect"
@fa "تغییر به خواندن مستقیم"
pub func SwitchDirect(c &: Conn):
c.direct = true
end
@en "Pending"
@fa "در انتظار"
pub func Pending(c: Conn): int:
ret c.pending.len
end
@en "Readable"
@fa "خواندنی"
pub func Readable(c: Conn): bool:
if c.pending.len > 0:
ret true
end
ret _rec_buffered(c.h.rec) > 0
end
@en "Fd"
@fa "توصیفگر"
pub func Fd(c: Conn): i64:
ret c.h.rec.fd
end
@en "CloseWrite"
@fa "بستن نوشتن"
pub func CloseWrite(c &: Conn):
if c.wdone or (not c.open and not c.rdone):
ret
end
c.wdone = true
_rec_send_alert(c.h.rec, 1, ALERT_CLOSE_NOTIFY)
if c.h.rec.fd >= 0:
rawsock.ShutdownWrite(rawsock.FromFd(c.h.rec.fd))
end
end
@en "Detach"
@fa "جداسازی اتصال"
pub func Detach(c &: Conn):
if c.open and not c.wdone:
_rec_send_alert(c.h.rec, 1, ALERT_CLOSE_NOTIFY)
end
c.open = false
_rec_free(c.h.rec)
_hs_free(c.h)
c.pending = Buf {}
end
@en "Close"
@fa "بستن اتصال"
pub func Close(c &: Conn):
fd := c.h.rec.fd
Detach(c)
if fd >= 0:
rawsock.Close(rawsock.FromFd(fd))
end
end
@en "Version"
@fa "نسخه"
pub func Version(c: Conn): str:
if c.h.ver == TLS13:
ret "TLS1.3"
end
if c.h.ver == TLS12:
ret "TLS1.2"
end
ret "none"
end
@en "CipherName"
@fa "نام رمز"
pub func CipherName(c: Conn): str:
s := c.h.suite
if s == TLS_CHACHA20_POLY1305_SHA256:
ret "TLS_CHACHA20_POLY1305_SHA256"
end
if s == TLS_AES_128_GCM_SHA256:
ret "TLS_AES_128_GCM_SHA256"
end
if s == TLS_AES_256_GCM_SHA384:
ret "TLS_AES_256_GCM_SHA384"
end
if s == TLS12_ECDHE_ECDSA_AES128_GCM_SHA256:
ret "TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256"
end
if s == TLS12_ECDHE_RSA_AES128_GCM_SHA256:
ret "TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256"
end
if s == TLS12_ECDHE_ECDSA_AES256_GCM_SHA384:
ret "TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384"
end
if s == TLS12_ECDHE_RSA_AES256_GCM_SHA384:
ret "TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384"
end
if s == TLS12_ECDHE_RSA_CHACHA20_SHA256:
ret "TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305_SHA256"
end
if s == TLS12_ECDHE_ECDSA_CHACHA20_SHA256:
ret "TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305_SHA256"
end
ret "none"
end
@en "PeerCertCount"
@fa "تعداد گواهی همتا"
pub func PeerCertCount(c: Conn): int:
ret c.h.ncerts
end
package tls
func _hs_next_msg(h &: Handshake, buf &: Buf, typ &: int, body &: Buf): bool:
mut frag := _newbuf(REC_MAX_PLAINTEXT)
defer _buf_free(frag)
mut guard := 0
until guard < 4096:
guard++
if buf.len >= 4:
mlen := (_bufat(buf, 1) << 16) | (_bufat(buf, 2) << 8) | _bufat(buf, 3)
if mlen > REC_MAX_PLAINTEXT * 4:
ret _hs_fail(h, "handshake message too large")
end
if buf.len >= 4 + mlen:
typ = _bufat(buf, 0)
_hash_update(h.tr, buf.p, 4 + mlen)
_bufreset(body)
repeat mlen in i:
_put8(body, _bufat(buf, 4 + i))
end
_bufconsume(buf, 4 + mlen)
ret true
end
end
mut rtyp := 0
if not _rec_read(h.rec, rtyp, frag):
ret _hs_fail(h, "connection closed during handshake")
end
if rtyp == REC_CHANGE_CIPHER_SPEC:
continue
end
if rtyp == REC_ALERT:
ret _hs_fail(h, _alert_text(frag))
end
if rtyp != REC_HANDSHAKE:
ret _hs_fail(h, "unexpected record type during handshake")
end
_putbuf(buf, frag)
end
ret _hs_fail(h, "handshake did not converge")
end
func _alert_text(a: Buf): str:
if a.len < 2:
ret "malformed alert"
end
d := _bufat(a, 1)
if d == ALERT_CLOSE_NOTIFY: ret "peer closed the connection" end
if d == ALERT_BAD_RECORD_MAC: ret "peer reported bad record MAC" end
if d == ALERT_HANDSHAKE_FAILURE: ret "peer reported handshake failure" end
if d == ALERT_BAD_CERTIFICATE: ret "peer rejected our certificate" end
if d == ALERT_ILLEGAL_PARAMETER: ret "peer reported illegal parameter" end
if d == ALERT_DECODE_ERROR: ret "peer could not decode our message" end
if d == ALERT_DECRYPT_ERROR: ret "peer reported decrypt error" end
if d == ALERT_PROTOCOL_VERSION: ret "peer does not support TLS 1.3" end
ret "peer sent alert " + d
end
func _install_keys(h &: Handshake, rx: Buf, tx: Buf):
_tk_free(h.rec.rxk)
_tk_free(h.rec.txk)
h.rec.rxk = _tk_derive(rx.p, rx.len, h.cipher)
h.rec.txk = _tk_derive(tx.p, tx.len, h.cipher)
end
func _do_handshake12(c &: Conn, h &: Handshake, cfg: Config, buf &: Buf): bool:
mut typ := 0
mut body := _newbuf(REC_MAX_PLAINTEXT)
defer _buf_free(body)
mut sesshash := _newbuf(64)
defer _buf_free(sesshash)
if not _hs_next_msg(h, buf, typ, body):
ret _conn_fail(c, h.err)
end
if typ != HS_CERTIFICATE:
ret _conn_fail(c, "expected Certificate")
end
if not _hs_read_cert_list(h, _readerof(body), false):
ret _conn_fail(c, h.err)
end
if not _hs_next_msg(h, buf, typ, body):
ret _conn_fail(c, h.err)
end
if typ != HS_SERVER_KEY_EXCHANGE:
ret _conn_fail(c, "expected ServerKeyExchange (static RSA suites are not offered)")
end
sker := _readerof(body)
if not _tls12_parse_ske(h, sker):
ret _conn_fail(c, h.err)
end
if not _hs_next_msg(h, buf, typ, body):
ret _conn_fail(c, h.err)
end
mut cert_requested := false
if typ == HS_CERTIFICATE_REQUEST:
cert_requested = true
if not _hs_next_msg(h, buf, typ, body):
ret _conn_fail(c, h.err)
end
end
if typ != HS_SERVER_HELLO_DONE:
ret _conn_fail(c, "expected ServerHelloDone")
end
if not _verify_peer_chain(c, h, cfg):
ret false
end
if cert_requested:
mut ccert := _newbuf(8)
defer _buf_free(ccert)
_put8(ccert, HS_CERTIFICATE)
_put24(ccert, 3)
_put24(ccert, 0)
_hash_update(h.tr, ccert.p, ccert.len)
if not _rec_write(h.rec, REC_HANDSHAKE, ccert.p, ccert.len):
ret _conn_fail(c, "could not send client Certificate")
end
end
mut cke := _newbuf(256)
defer _buf_free(cke)
_tls12_client_key_exchange(h, h.group, cke)
_hash_update(h.tr, cke.p, cke.len)
if not _rec_write(h.rec, REC_HANDSHAKE, cke.p, cke.len):
ret _conn_fail(c, "could not send ClientKeyExchange")
end
_bufreset(h.master)
_putzeros(h.master, MASTER_SECRET_LEN)
if h.ems:
_hs_transcript(h, sesshash)
_tls12_master_ext(h.hash, h.shared.p, h.shared.len, sesshash, h.master.p)
else:
_tls12_master(h.hash, h.shared.p, h.shared.len, h.crand, h.srand, h.master.p)
end
h.master.len = MASTER_SECRET_LEN
mut ccs := _newbuf(1)
defer _buf_free(ccs)
_put8(ccs, 1)
_rec_write_plain(h.rec, REC_CHANGE_CIPHER_SPEC, ccs.p, 1)
if not _tls12_install_keys(h):
ret _conn_fail(c, "could not install TLS 1.2 keys")
end
mut th := _newbuf(64)
defer _buf_free(th)
_hs_transcript(h, th)
mut fin := _newbuf(32)
defer _buf_free(fin)
_tls12_finished_msg(h, PRF_LABEL_CLIENT_FINISHED, th, fin)
_hash_update(h.tr, fin.p, fin.len)
if not _rec_write(h.rec, REC_HANDSHAKE, fin.p, fin.len):
ret _conn_fail(c, "could not send Finished")
end
mut th2 := _newbuf(64)
defer _buf_free(th2)
_hs_transcript(h, th2)
mut want := _newbuf(32)
defer _buf_free(want)
_tls12_finished_msg(h, PRF_LABEL_SERVER_FINISHED, th2, want)
if not _hs_next_msg(h, buf, typ, body):
ret _conn_fail(c, h.err)
end
if typ != HS_FINISHED:
ret _conn_fail(c, "expected server Finished")
end
if body.len != VERIFY_DATA_LEN or not _cteq(body.p, _bufptr(want, 4), VERIFY_DATA_LEN):
_rec_send_alert(h.rec, 2, ALERT_DECRYPT_ERROR)
ret _conn_fail(c, "server Finished did not verify")
end
h.ok = true
c.open = true
ret true
end
func _verify_peer_chain(c &: Conn, h &: Handshake, cfg: Config): bool:
if cfg.insecure_skip_verify:
ret true
end
roots := _roots_shared(cfg.ca_file)
if roots.count == 0:
ret _conn_fail(c, "no trusted roots available")
end
mut chain: Reader[8]
repeat 8 in i:
chain[i] = _newreader(null, 0)
end
repeat h.ncerts in i:
chain[i] = _newreader(_bufptr(h.certs, _cert_start(h, i)), _cert_len(h, i))
end
vr := _verify_chain(chain, h.ncerts, roots, c.host, _now_stamp())
if vr != VERR_NONE:
_rec_send_alert(h.rec, 2, ALERT_BAD_CERTIFICATE)
ret _conn_fail(c, "certificate verification failed: " + _verr_str(vr))
end
ret true
end
func _read_server_hello(h &: Handshake, frag &: Buf, shlen &: int, err &: str): bool:
mut rtyp := 0
mut got := false
mut guard := 0
until not got and guard < 16:
guard++
if not _rec_read(h.rec, rtyp, frag):
err = "no ServerHello: " + h.rec.err
ret false
end
if rtyp == REC_CHANGE_CIPHER_SPEC:
continue
end
if rtyp == REC_ALERT:
err = _alert_text(frag)
ret false
end
if rtyp != REC_HANDSHAKE:
err = "expected ServerHello"
ret false
end
got = true
end
if not got or frag.len < 4 or _bufat(frag, 0) != HS_SERVER_HELLO:
err = "expected ServerHello"
ret false
end
shlen = (_bufat(frag, 1) << 16) | (_bufat(frag, 2) << 8) | _bufat(frag, 3)
if frag.len < 4 + shlen:
err = "truncated ServerHello"
ret false
end
ret true
end
func _do_handshake(c &: Conn, cfg: Config): bool:
mut h := c.h
mut ch := _newbuf(512)
defer _buf_free(ch)
if not _hs_build_client_hello(h, cfg.server_name, cfg.alpn, cfg.aes_only, ch):
c.h = h
ret _conn_fail(c, "could not build ClientHello")
end
if not _rec_write(h.rec, REC_HANDSHAKE, ch.p, ch.len):
c.h = h
ret _conn_fail(c, "could not send ClientHello: " + h.rec.err)
end
mut buf := _newbuf(REC_MAX_PLAINTEXT)
defer _buf_free(buf)
mut typ := 0
mut body := _newbuf(REC_MAX_PLAINTEXT)
defer _buf_free(body)
mut frag := _newbuf(REC_MAX_PLAINTEXT)
defer _buf_free(frag)
mut shlen := 0
mut sherr := ""
if not _read_server_hello(h, frag, shlen, sherr):
c.h = h
ret _conn_fail(c, sherr)
end
shr := _newreader(_bufptr(frag, 4), shlen)
if not _hs_parse_server_hello(h, shr):
c.h = h
ret _conn_fail(c, h.err)
end
if h.hrr:
mut synth := _newbuf(4 + 64)
defer _buf_free(synth)
_put8(synth, HS_MESSAGE_HASH)
_put24(synth, h.hlen)
_putzeros(synth, h.hlen)
_hash_oneshot(h.hash, ch.p, ch.len, _bufptr(synth, 4))
h.tr = _hash_init(h.hash)
_hash_update(h.tr, synth.p, synth.len)
_hash_update(h.tr, frag.p, 4 + shlen)
if not _hs_build_client_hello(h, cfg.server_name, cfg.alpn, cfg.aes_only, ch):
c.h = h
ret _conn_fail(c, "could not build the second ClientHello: " + h.err)
end
if not _rec_write(h.rec, REC_HANDSHAKE, ch.p, ch.len):
c.h = h
ret _conn_fail(c, "could not send the second ClientHello: " + h.rec.err)
end
_hash_update(h.tr, ch.p, ch.len)
_bufreset(frag)
if not _read_server_hello(h, frag, shlen, sherr):
c.h = h
ret _conn_fail(c, sherr)
end
shr2 := _newreader(_bufptr(frag, 4), shlen)
if not _hs_parse_server_hello(h, shr2):
c.h = h
ret _conn_fail(c, h.err)
end
if h.ver != TLS13:
c.h = h
ret _conn_fail(c, "server switched to TLS 1.2 after a HelloRetryRequest")
end
_hash_update(h.tr, frag.p, 4 + shlen)
else:
h.tr = _hash_init(h.hash)
_hash_update(h.tr, ch.p, ch.len)
_hash_update(h.tr, frag.p, 4 + shlen)
end
if frag.len > 4 + shlen:
_putraw(buf, _bufptr(frag, 4 + shlen), frag.len - (4 + shlen))
end
if h.ver == TLS12:
ok12 := _do_handshake12(c, h, cfg, buf)
c.h = h
ret ok12
end
if not _hs_key_schedule(h):
c.h = h
ret _conn_fail(c, "key schedule failed")
end
_install_keys(h, h.s_hs_secret, h.c_hs_secret)
if not _hs_next_msg(h, buf, typ, body):
c.h = h
ret _conn_fail(c, h.err)
end
if typ != HS_ENCRYPTED_EXTENSIONS:
c.h = h
ret _conn_fail(c, "expected EncryptedExtensions")
end
if not _hs_next_msg(h, buf, typ, body):
c.h = h
ret _conn_fail(c, h.err)
end
mut cert_ctx := _newbuf(256)
defer _buf_free(cert_ctx)
mut cert_requested := false
if typ == HS_CERTIFICATE_REQUEST:
if body.len < 1 or _bufat(body, 0) + 1 > body.len:
c.h = h
ret _conn_fail(c, "malformed CertificateRequest")
end
repeat _bufat(body, 0) in i:
_put8(cert_ctx, _bufat(body, 1 + i))
end
cert_requested = true
if not _hs_next_msg(h, buf, typ, body):
c.h = h
ret _conn_fail(c, h.err)
end
end
if typ != HS_CERTIFICATE:
c.h = h
ret _conn_fail(c, "expected Certificate")
end
certr := _readerof(body)
if not _hs_parse_certificate(h, certr):
c.h = h
ret _conn_fail(c, h.err)
end
mut th_cv := _newbuf(64)
defer _buf_free(th_cv)
_hs_transcript(h, th_cv)
if not _hs_next_msg(h, buf, typ, body):
c.h = h
ret _conn_fail(c, h.err)
end
if typ != HS_CERTIFICATE_VERIFY:
c.h = h
ret _conn_fail(c, "expected CertificateVerify")
end
cvr := _readerof(body)
if not _hs_verify_cert_verify(h, cvr, th_cv):
c.h = h
ret _conn_fail(c, h.err)
end
if not _verify_peer_chain(c, h, cfg):
c.h = h
ret false
end
mut th_fin := _newbuf(64)
defer _buf_free(th_fin)
_hs_transcript(h, th_fin)
if not _hs_next_msg(h, buf, typ, body):
c.h = h
ret _conn_fail(c, h.err)
end
if typ != HS_FINISHED:
c.h = h
ret _conn_fail(c, "expected Finished")
end
mut expect := _newbuf(64)
defer _buf_free(expect)
if not _hs_finished_mac(h, h.s_hs_secret, th_fin, expect):
c.h = h
ret _conn_fail(c, "could not compute Finished MAC")
end
if body.len != expect.len or not _cteq(body.p, expect.p, expect.len):
c.h = h
_rec_send_alert(h.rec, 2, ALERT_DECRYPT_ERROR)
ret _conn_fail(c, "server Finished did not verify")
end
mut th_app := _newbuf(64)
defer _buf_free(th_app)
_hs_transcript(h, th_app)
if not _hs_derive(h, h.master, "c ap traffic", th_app, h.c_ap_secret):
c.h = h
ret _conn_fail(c, "could not derive client application secret")
end
if not _hs_derive(h, h.master, "s ap traffic", th_app, h.s_ap_secret):
c.h = h
ret _conn_fail(c, "could not derive server application secret")
end
mut ccs := _newbuf(1)
defer _buf_free(ccs)
_put8(ccs, 1)
_rec_write_plain(h.rec, REC_CHANGE_CIPHER_SPEC, ccs.p, 1)
mut th_cfin := _newbuf(64)
defer _buf_free(th_cfin)
if cert_requested:
mut ccert := _newbuf(16 + cert_ctx.len)
defer _buf_free(ccert)
_put8(ccert, HS_CERTIFICATE)
_put24(ccert, 1 + cert_ctx.len + 3)
_put8(ccert, cert_ctx.len)
_putbuf(ccert, cert_ctx)
_put24(ccert, 0)
_hash_update(h.tr, ccert.p, ccert.len)
if not _rec_write(h.rec, REC_HANDSHAKE, ccert.p, ccert.len):
c.h = h
ret _conn_fail(c, "could not send client Certificate")
end
end
_hs_transcript(h, th_cfin)
mut cfin := _newbuf(64)
defer _buf_free(cfin)
if not _hs_finished_mac(h, h.c_hs_secret, th_cfin, cfin):
c.h = h
ret _conn_fail(c, "could not compute client Finished")
end
mut fmsg := _newbuf(64)
defer _buf_free(fmsg)
_put8(fmsg, HS_FINISHED)
_put24(fmsg, cfin.len)
_putbuf(fmsg, cfin)
if not _rec_write(h.rec, REC_HANDSHAKE, fmsg.p, fmsg.len):
c.h = h
ret _conn_fail(c, "could not send Finished")
end
_install_keys(h, h.s_ap_secret, h.c_ap_secret)
h.ok = true
c.h = h
c.open = true
ret true
end
package tls
const FE_LIMBS := 12
struct Fe:
pub v: u32[12] = [
0 as u32, 0 as u32, 0 as u32, 0 as u32
0 as u32, 0 as u32, 0 as u32, 0 as u32
0 as u32, 0 as u32, 0 as u32, 0 as u32
]
end
struct Curve:
pub nl: int = 0
pub nb: int = 0
pub p: u32[12] = [
0 as u32, 0 as u32, 0 as u32, 0 as u32
0 as u32, 0 as u32, 0 as u32, 0 as u32
0 as u32, 0 as u32, 0 as u32, 0 as u32
]
pub n: u32[12] = [
0 as u32, 0 as u32, 0 as u32, 0 as u32
0 as u32, 0 as u32, 0 as u32, 0 as u32
0 as u32, 0 as u32, 0 as u32, 0 as u32
]
pub r2p: u32[12] = [
0 as u32, 0 as u32, 0 as u32, 0 as u32
0 as u32, 0 as u32, 0 as u32, 0 as u32
0 as u32, 0 as u32, 0 as u32, 0 as u32
]
pub r2n: u32[12] = [
0 as u32, 0 as u32, 0 as u32, 0 as u32
0 as u32, 0 as u32, 0 as u32, 0 as u32
0 as u32, 0 as u32, 0 as u32, 0 as u32
]
pub one: u32[12] = [
0 as u32, 0 as u32, 0 as u32, 0 as u32
0 as u32, 0 as u32, 0 as u32, 0 as u32
0 as u32, 0 as u32, 0 as u32, 0 as u32
]
pub b: u32[12] = [
0 as u32, 0 as u32, 0 as u32, 0 as u32
0 as u32, 0 as u32, 0 as u32, 0 as u32
0 as u32, 0 as u32, 0 as u32, 0 as u32
]
pub gx: u32[12] = [
0 as u32, 0 as u32, 0 as u32, 0 as u32
0 as u32, 0 as u32, 0 as u32, 0 as u32
0 as u32, 0 as u32, 0 as u32, 0 as u32
]
pub gy: u32[12] = [
0 as u32, 0 as u32, 0 as u32, 0 as u32
0 as u32, 0 as u32, 0 as u32, 0 as u32
0 as u32, 0 as u32, 0 as u32, 0 as u32
]
pub n0p: u32 = 0 as u32
pub n0n: u32 = 0 as u32
end
struct Jac:
pub x: Fe = Fe {}
pub y: Fe = Fe {}
pub z: Fe = Fe {}
end
func _fe_from(c: u32[12], nl: int): Fe:
mut r := Fe {}
repeat nl in i:
r.v[i] = c[i]
end
ret r
end
func _fe_zero(): Fe:
ret Fe {}
end
func _fe_one_plain(): Fe:
mut o := Fe {}
o.v[0] = 1 as u32
ret o
end
func _fe_is_zero(a: Fe, nl: int): bool:
mut acc := 0 as u32
repeat nl in i:
acc |= a.v[i]
end
ret acc == (0 as u32)
end
func _fe_eq(a: Fe, b: Fe, nl: int): bool:
mut acc := 0 as u32
repeat nl in i:
acc |= (a.v[i] ^ b.v[i])
end
ret acc == (0 as u32)
end
func _fe_cmov(r &: Fe, a: Fe, c: int, nl: int):
mask := (0 as u32) - (c as u32)
repeat nl in i:
r.v[i] = (r.v[i] & ~mask) | (a.v[i] & mask)
end
end
func _fe_add_raw(r &: Fe, a: Fe, b: Fe, nl: int): u32:
mut carry := 0 as u64
repeat nl in i:
s := (a.v[i] as u64) + (b.v[i] as u64) + carry
r.v[i] = s as u32
carry = s >> (32 as u64)
end
ret carry as u32
end
func _fe_sub_raw(r &: Fe, a: Fe, b: Fe, nl: int): u32:
mut borrow := 0 as u64
repeat nl in i:
d := (a.v[i] as u64) - (b.v[i] as u64) - borrow
r.v[i] = d as u32
borrow = (d >> (32 as u64)) & (1 as u64)
end
ret borrow as u32
end
func _fe_reduce_once(r &: Fe, carry: u32, m: u32[12], nl: int):
mm := _fe_from(m, nl)
mut t := Fe {}
borrow := _fe_sub_raw(t, r, mm, nl)
use := ((carry | (borrow ^ (1 as u32))) & (1 as u32)) as int
_fe_cmov(r, t, use, nl)
end
func _fe_add_mod(r &: Fe, a: Fe, b: Fe, m: u32[12], nl: int):
c := _fe_add_raw(r, a, b, nl)
_fe_reduce_once(r, c, m, nl)
end
func _fe_sub_mod(r &: Fe, a: Fe, b: Fe, m: u32[12], nl: int):
borrow := _fe_sub_raw(r, a, b, nl)
mm := _fe_from(m, nl)
mut t := Fe {}
_fe_add_raw(t, r, mm, nl)
_fe_cmov(r, t, borrow as int, nl)
end
func _fe_mont_mul(r &: Fe, a: Fe, b: Fe, m: u32[12], nl: int, n0inv: u32):
mut t: u32[14]
repeat 14 in i:
t[i] = 0 as u32
end
repeat nl in i:
mut carry := 0 as u64
ai := a.v[i] as u64
repeat nl in j:
s := (t[j] as u64) + ai * (b.v[j] as u64) + carry
t[j] = s as u32
carry = s >> (32 as u64)
end
sN := (t[nl] as u64) + carry
t[nl] = sN as u32
t[nl + 1] += ((sN >> (32 as u64)) as u32)
u := (t[0] as u64) * (n0inv as u64)
um := (u as u32) as u64
carry = 0 as u64
repeat nl in j:
s := (t[j] as u64) + um * (m[j] as u64) + carry
t[j] = s as u32
carry = s >> (32 as u64)
end
sM := (t[nl] as u64) + carry
t[nl] = sM as u32
t[nl + 1] += ((sM >> (32 as u64)) as u32)
repeat nl + 1 in k:
t[k] = t[k + 1]
end
t[nl + 1] = 0 as u32
end
repeat nl in i:
r.v[i] = t[i]
end
repeat FE_LIMBS - nl in i:
r.v[nl + i] = 0 as u32
end
_fe_reduce_once(r, t[nl], m, nl)
end
func _fe_to_mont(r &: Fe, a: Fe, m: u32[12], r2: u32[12], nl: int, n0inv: u32):
_fe_mont_mul(r, a, _fe_from(r2, nl), m, nl, n0inv)
end
func _fe_from_mont(r &: Fe, a: Fe, m: u32[12], nl: int, n0inv: u32):
_fe_mont_mul(r, a, _fe_one_plain(), m, nl, n0inv)
end
func _fe_inv(r &: Fe, a: Fe, m: u32[12], one: u32[12], nl: int, n0inv: u32):
if nl == 8:
_pf_inv_fe(r, a, m[0] == P256_N[0])
ret
end
mm := _fe_from(m, nl)
mut two := Fe {}
two.v[0] = 2 as u32
mut e := Fe {}
_fe_sub_raw(e, mm, two, nl)
mut acc := _fe_from(one, nl)
mut cur := a
bits := nl * 32
mut i := 0
until i < bits:
bit := ((e.v[i / 32] >> ((i % 32) as u32)) & (1 as u32)) as int
mut prod := Fe {}
_fe_mont_mul(prod, acc, cur, m, nl, n0inv)
_fe_cmov(acc, prod, bit, nl)
mut sq := Fe {}
_fe_mont_mul(sq, cur, cur, m, nl, n0inv)
cur = sq
i++
end
repeat nl in k:
r.v[k] = acc.v[k]
end
end
func _fe_lt(a: Fe, m: u32[12], nl: int): bool:
mut i := nl - 1
until i >= 0:
if a.v[i] != m[i]:
ret a.v[i] < m[i]
end
i--
end
ret false
end
func _fe_from_bytes(p: void*, nb: int): Fe:
mut r := Fe {}
nl := nb / 4
repeat nl in i:
o := nb - 4 * (i + 1)
r.v[i] = ((_bget(p, o) as u32) << (24 as u32)) | ((_bget(p, o + 1) as u32) << (16 as u32)) | ((_bget(p, o + 2) as u32) << (8 as u32)) | (_bget(p, o + 3) as u32)
end
ret r
end
func _fe_to_bytes(a: Fe, out: void*, nb: int):
nl := nb / 4
repeat nl in i:
o := nb - 4 * (i + 1)
v := a.v[i]
_bput(out, o, ((v >> (24 as u32)) & (0xFF as u32)) as int)
_bput(out, o + 1, ((v >> (16 as u32)) & (0xFF as u32)) as int)
_bput(out, o + 2, ((v >> (8 as u32)) & (0xFF as u32)) as int)
_bput(out, o + 3, (v & (0xFF as u32)) as int)
end
end
func _jac_infinity(cv: Curve): Jac:
mut j := Jac {}
j.x = _fe_from(cv.one, cv.nl)
j.y = _fe_from(cv.one, cv.nl)
j.z = _fe_zero()
ret j
end
func _jac_is_infinity(j: Jac, nl: int): bool:
ret _fe_is_zero(j.z, nl)
end
func _jac_generator(cv: Curve): Jac:
mut j := Jac {}
j.x = _fe_from(cv.gx, cv.nl)
j.y = _fe_from(cv.gy, cv.nl)
j.z = _fe_from(cv.one, cv.nl)
ret j
end
func _jac_double(cv: Curve, pt: Jac): Jac:
nl := cv.nl
n0 := cv.n0p
mut delta := Fe {}
_fe_mont_mul(delta, pt.z, pt.z, cv.p, nl, n0)
mut gamma := Fe {}
_fe_mont_mul(gamma, pt.y, pt.y, cv.p, nl, n0)
mut beta := Fe {}
_fe_mont_mul(beta, pt.x, gamma, cv.p, nl, n0)
mut t1 := Fe {}
_fe_sub_mod(t1, pt.x, delta, cv.p, nl)
mut t2 := Fe {}
_fe_add_mod(t2, pt.x, delta, cv.p, nl)
mut t3 := Fe {}
_fe_mont_mul(t3, t1, t2, cv.p, nl, n0)
mut alpha := Fe {}
_fe_add_mod(alpha, t3, t3, cv.p, nl)
_fe_add_mod(alpha, alpha, t3, cv.p, nl)
r := Jac {}
mut a2 := Fe {}
_fe_mont_mul(a2, alpha, alpha, cv.p, nl, n0)
mut b8 := Fe {}
_fe_add_mod(b8, beta, beta, cv.p, nl)
_fe_add_mod(b8, b8, b8, cv.p, nl)
_fe_add_mod(b8, b8, b8, cv.p, nl)
_fe_sub_mod(r.x, a2, b8, cv.p, nl)
mut zy := Fe {}
_fe_add_mod(zy, pt.y, pt.z, cv.p, nl)
mut zy2 := Fe {}
_fe_mont_mul(zy2, zy, zy, cv.p, nl, n0)
_fe_sub_mod(zy2, zy2, gamma, cv.p, nl)
_fe_sub_mod(r.z, zy2, delta, cv.p, nl)
mut b4 := Fe {}
_fe_add_mod(b4, beta, beta, cv.p, nl)
_fe_add_mod(b4, b4, b4, cv.p, nl)
_fe_sub_mod(b4, b4, r.x, cv.p, nl)
mut ay := Fe {}
_fe_mont_mul(ay, alpha, b4, cv.p, nl, n0)
mut g2 := Fe {}
_fe_mont_mul(g2, gamma, gamma, cv.p, nl, n0)
mut g8 := Fe {}
_fe_add_mod(g8, g2, g2, cv.p, nl)
_fe_add_mod(g8, g8, g8, cv.p, nl)
_fe_add_mod(g8, g8, g8, cv.p, nl)
_fe_sub_mod(r.y, ay, g8, cv.p, nl)
ret r
end
func _jac_add(cv: Curve, pt: Jac, q: Jac): Jac:
nl := cv.nl
n0 := cv.n0p
if _jac_is_infinity(pt, nl):
ret q
end
if _jac_is_infinity(q, nl):
ret pt
end
mut z1z1 := Fe {}
_fe_mont_mul(z1z1, pt.z, pt.z, cv.p, nl, n0)
mut z2z2 := Fe {}
_fe_mont_mul(z2z2, q.z, q.z, cv.p, nl, n0)
mut u1 := Fe {}
_fe_mont_mul(u1, pt.x, z2z2, cv.p, nl, n0)
mut u2 := Fe {}
_fe_mont_mul(u2, q.x, z1z1, cv.p, nl, n0)
mut s1 := Fe {}
_fe_mont_mul(s1, pt.y, q.z, cv.p, nl, n0)
_fe_mont_mul(s1, s1, z2z2, cv.p, nl, n0)
mut s2 := Fe {}
_fe_mont_mul(s2, q.y, pt.z, cv.p, nl, n0)
_fe_mont_mul(s2, s2, z1z1, cv.p, nl, n0)
if _fe_eq(u1, u2, nl):
if _fe_eq(s1, s2, nl):
ret _jac_double(cv, pt)
end
ret _jac_infinity(cv)
end
mut h := Fe {}
_fe_sub_mod(h, u2, u1, cv.p, nl)
mut i := Fe {}
_fe_add_mod(i, h, h, cv.p, nl)
_fe_mont_mul(i, i, i, cv.p, nl, n0)
mut j := Fe {}
_fe_mont_mul(j, h, i, cv.p, nl, n0)
mut rr := Fe {}
_fe_sub_mod(rr, s2, s1, cv.p, nl)
_fe_add_mod(rr, rr, rr, cv.p, nl)
mut v := Fe {}
_fe_mont_mul(v, u1, i, cv.p, nl, n0)
out := Jac {}
mut r2 := Fe {}
_fe_mont_mul(r2, rr, rr, cv.p, nl, n0)
_fe_sub_mod(out.x, r2, j, cv.p, nl)
_fe_sub_mod(out.x, out.x, v, cv.p, nl)
_fe_sub_mod(out.x, out.x, v, cv.p, nl)
mut vx := Fe {}
_fe_sub_mod(vx, v, out.x, cv.p, nl)
_fe_mont_mul(vx, rr, vx, cv.p, nl, n0)
mut s1j := Fe {}
_fe_mont_mul(s1j, s1, j, cv.p, nl, n0)
_fe_add_mod(s1j, s1j, s1j, cv.p, nl)
_fe_sub_mod(out.y, vx, s1j, cv.p, nl)
mut zz := Fe {}
_fe_add_mod(zz, pt.z, q.z, cv.p, nl)
_fe_mont_mul(zz, zz, zz, cv.p, nl, n0)
_fe_sub_mod(zz, zz, z1z1, cv.p, nl)
_fe_sub_mod(zz, zz, z2z2, cv.p, nl)
_fe_mont_mul(out.z, zz, h, cv.p, nl, n0)
ret out
end
func _jac_to_affine(cv: Curve, j: Jac, xout: void*, yout: void*): bool:
nl := cv.nl
n0 := cv.n0p
if _jac_is_infinity(j, nl):
ret false
end
mut zinv := Fe {}
_fe_inv(zinv, j.z, cv.p, cv.one, nl, n0)
mut z2 := Fe {}
_fe_mont_mul(z2, zinv, zinv, cv.p, nl, n0)
mut z3 := Fe {}
_fe_mont_mul(z3, z2, zinv, cv.p, nl, n0)
mut x := Fe {}
_fe_mont_mul(x, j.x, z2, cv.p, nl, n0)
mut y := Fe {}
_fe_mont_mul(y, j.y, z3, cv.p, nl, n0)
mut xn := Fe {}
_fe_from_mont(xn, x, cv.p, nl, n0)
mut yn := Fe {}
_fe_from_mont(yn, y, cv.p, nl, n0)
_fe_to_bytes(xn, xout, cv.nb)
_fe_to_bytes(yn, yout, cv.nb)
ret true
end
func _jac_mul(cv: Curve, k: Fe, pt: Jac): Jac:
nl := cv.nl
if nl == 8:
ret _pf_mul_point(k, pt)
end
mut acc := _jac_infinity(cv)
mut i := nl * 32 - 1
until i >= 0:
acc = _jac_double(cv, acc)
bit := ((k.v[i / 32] >> ((i % 32) as u32)) & (1 as u32)) as int
cand := _jac_add(cv, acc, pt)
_fe_cmov(acc.x, cand.x, bit, nl)
_fe_cmov(acc.y, cand.y, bit, nl)
_fe_cmov(acc.z, cand.z, bit, nl)
i--
end
ret acc
end
func _jac_mul_base(cv: Curve, k: Fe): Jac:
if cv.nl == 8:
ret _pf_mul_base(k)
end
ret _jac_mul(cv, k, _jac_generator(cv))
end
func _jac_mul_double_vartime(cv: Curve, k1: Fe, p1: Jac, k2: Fe, p2: Jac): Jac:
nl := cv.nl
if nl == 8:
ret _jac_add(cv, _pf_mul_base(k1), _pf_mul_point(k2, p2))
end
mut acc := _jac_infinity(cv)
mut i := nl * 32 - 1
until i >= 0:
acc = _jac_double(cv, acc)
b1 := ((k1.v[i / 32] >> ((i % 32) as u32)) & (1 as u32)) as int
if b1 == 1:
acc = _jac_add(cv, acc, p1)
end
b2 := ((k2.v[i / 32] >> ((i % 32) as u32)) & (1 as u32)) as int
if b2 == 1:
acc = _jac_add(cv, acc, p2)
end
i--
end
ret acc
end
func _ec_point_from_bytes(cv: Curve, p: void*, n: int, out &: Jac): bool:
nl := cv.nl
n0 := cv.n0p
if n != 1 + 2 * cv.nb:
ret false
end
if _bget(p, 0) != 0x04:
ret false
end
xa := _fe_from_bytes(((p as i64) + 1) as void*, cv.nb)
ya := _fe_from_bytes(((p as i64) + (1 + cv.nb) as i64) as void*, cv.nb)
if not _fe_lt(xa, cv.p, nl) or not _fe_lt(ya, cv.p, nl):
ret false
end
mut xm := Fe {}
_fe_to_mont(xm, xa, cv.p, cv.r2p, nl, n0)
mut ym := Fe {}
_fe_to_mont(ym, ya, cv.p, cv.r2p, nl, n0)
mut lhs := Fe {}
_fe_mont_mul(lhs, ym, ym, cv.p, nl, n0)
mut x3 := Fe {}
_fe_mont_mul(x3, xm, xm, cv.p, nl, n0)
_fe_mont_mul(x3, x3, xm, cv.p, nl, n0)
mut tx := Fe {}
_fe_add_mod(tx, xm, xm, cv.p, nl)
_fe_add_mod(tx, tx, xm, cv.p, nl)
mut rhs := Fe {}
_fe_sub_mod(rhs, x3, tx, cv.p, nl)
_fe_add_mod(rhs, rhs, _fe_from(cv.b, nl), cv.p, nl)
if not _fe_eq(lhs, rhs, nl):
ret false
end
out.x = xm
out.y = ym
out.z = _fe_from(cv.one, nl)
ret true
end
func _ec_base_mul(cv: Curve, scalar: void*, xout: void*, yout: void*): bool:
k := _fe_from_bytes(scalar, cv.nb)
if _fe_is_zero(k, cv.nl) or not _fe_lt(k, cv.n, cv.nl):
ret false
end
r := _jac_mul_base(cv, k)
ret _jac_to_affine(cv, r, xout, yout)
end
func _ec_ecdh(cv: Curve, scalar: void*, peer: void*, peerlen: int, out: void*): bool:
k := _fe_from_bytes(scalar, cv.nb)
if _fe_is_zero(k, cv.nl) or not _fe_lt(k, cv.n, cv.nl):
ret false
end
mut q := Jac {}
if not _ec_point_from_bytes(cv, peer, peerlen, q):
ret false
end
r := _jac_mul(cv, k, q)
mut ybuf := _newbuf(cv.nb)
defer _buf_wipe(ybuf)
_putzeros(ybuf, cv.nb)
ret _jac_to_affine(cv, r, out, ybuf.p)
end
package tls
func _sn_mul(cv: Curve, r &: Fe, a: Fe, b: Fe):
_fe_mont_mul(r, a, b, cv.n, cv.nl, cv.n0n)
end
func _sn_to_mont(cv: Curve, r &: Fe, a: Fe):
_fe_mont_mul(r, a, _fe_from(cv.r2n, cv.nl), cv.n, cv.nl, cv.n0n)
end
func _sn_from_mont(cv: Curve, r &: Fe, a: Fe):
_fe_mont_mul(r, a, _fe_one_plain(), cv.n, cv.nl, cv.n0n)
end
func _sn_inv(cv: Curve, r &: Fe, a: Fe):
mut onen := Fe {}
_sn_to_mont(cv, onen, _fe_one_plain())
mut onearr: u32[12]
repeat 12 in i:
onearr[i] = 0 as u32
end
repeat cv.nl in i:
onearr[i] = onen.v[i]
end
_fe_inv(r, a, cv.n, onearr, cv.nl, cv.n0n)
end
func _ecdsa_digest_scalar(cv: Curve, digest: void*, dlen: int): Fe:
mut buf := _newbuf(cv.nb)
defer _buf_free(buf)
mut take := dlen
if take > cv.nb:
take = cv.nb
end
repeat cv.nb - take:
_put8(buf, 0)
end
_putraw(buf, digest, take)
mut z := _fe_from_bytes(buf.p, cv.nb)
mut t := Fe {}
borrow := _fe_sub_raw(t, z, _fe_from(cv.n, cv.nl), cv.nl)
_fe_cmov(z, t, ((borrow ^ (1 as u32)) & (1 as u32)) as int, cv.nl)
ret z
end
func _ecdsa_verify(cv: Curve, digest: void*, dlen: int, rbytes: void*, sbytes: void*, pubkey: void*, publen: int): bool:
mut q := Jac {}
if not _ec_point_from_bytes(cv, pubkey, publen, q):
ret false
end
r := _fe_from_bytes(rbytes, cv.nb)
s := _fe_from_bytes(sbytes, cv.nb)
if _fe_is_zero(r, cv.nl) or _fe_is_zero(s, cv.nl):
ret false
end
if not _fe_lt(r, cv.n, cv.nl) or not _fe_lt(s, cv.n, cv.nl):
ret false
end
z := _ecdsa_digest_scalar(cv, digest, dlen)
mut sm := Fe {}
_sn_to_mont(cv, sm, s)
mut wm := Fe {}
_sn_inv(cv, wm, sm)
mut zm := Fe {}
_sn_to_mont(cv, zm, z)
mut u1m := Fe {}
_sn_mul(cv, u1m, zm, wm)
mut u1 := Fe {}
_sn_from_mont(cv, u1, u1m)
mut rm := Fe {}
_sn_to_mont(cv, rm, r)
mut u2m := Fe {}
_sn_mul(cv, u2m, rm, wm)
mut u2 := Fe {}
_sn_from_mont(cv, u2, u2m)
pt := _jac_mul_double_vartime(cv, u1, _jac_generator(cv), u2, q)
if _jac_is_infinity(pt, cv.nl):
ret false
end
mut xb := _newbuf(cv.nb)
defer _buf_free(xb)
_putzeros(xb, cv.nb)
mut yb := _newbuf(cv.nb)
defer _buf_free(yb)
_putzeros(yb, cv.nb)
if not _jac_to_affine(cv, pt, xb.p, yb.p):
ret false
end
mut x := _fe_from_bytes(xb.p, cv.nb)
mut t := Fe {}
borrow := _fe_sub_raw(t, x, _fe_from(cv.n, cv.nl), cv.nl)
_fe_cmov(x, t, ((borrow ^ (1 as u32)) & (1 as u32)) as int, cv.nl)
ret _fe_eq(x, r, cv.nl)
end
func _ecdsa_p256_verify(digest: void*, dlen: int, rbytes: void*, sbytes: void*, pubkey: void*, publen: int): bool:
ret _ecdsa_verify(_curve_p256(), digest, dlen, rbytes, sbytes, pubkey, publen)
end
func _ecdsa_p384_verify(digest: void*, dlen: int, rbytes: void*, sbytes: void*, pubkey: void*, publen: int): bool:
ret _ecdsa_verify(_curve_p384(), digest, dlen, rbytes, sbytes, pubkey, publen)
end
func _p256_base_mul(scalar: void*, xout: void*, yout: void*): bool:
ret _ec_base_mul(_curve_p256(), scalar, xout, yout)
end
func _p256_ecdh(scalar: void*, peer: void*, peerlen: int, out: void*): bool:
ret _ec_ecdh(_curve_p256(), scalar, peer, peerlen, out)
end
func _p384_base_mul(scalar: void*, xout: void*, yout: void*): bool:
ret _ec_base_mul(_curve_p384(), scalar, xout, yout)
end
func _p384_ecdh(scalar: void*, peer: void*, peerlen: int, out: void*): bool:
ret _ec_ecdh(_curve_p384(), scalar, peer, peerlen, out)
end
package tls
func _rfc6979_k(cv: Curve, kind: int, dbytes: void*, h1: void*, h1len: int, kout: void*): bool:
hlen := _hash_size(kind)
rlen := cv.nb
z := _ecdsa_digest_scalar(cv, h1, h1len)
mut h1oct := _newbuf(rlen)
defer _buf_wipe(h1oct)
_putzeros(h1oct, rlen)
_fe_to_bytes(z, h1oct.p, rlen)
mut v := _newbuf(hlen)
defer _buf_wipe(v)
_putzeros(v, hlen)
repeat hlen in i:
_bufset(v, i, 0x01)
end
mut k := _newbuf(hlen)
defer _buf_wipe(k)
_putzeros(k, hlen)
mut scratch := _newbuf(hlen)
defer _buf_wipe(scratch)
_putzeros(scratch, hlen)
mut seed := _newbuf(hlen + 1 + 2 * rlen)
defer _buf_wipe(seed)
_bufreset(seed)
_putraw(seed, v.p, hlen)
_put8(seed, 0x00)
_putraw(seed, dbytes, rlen)
_putraw(seed, h1oct.p, rlen)
_hmac(kind, k.p, hlen, seed.p, seed.len, scratch.p)
mem.Copy(k.p, scratch.p, hlen as u64)
_hmac(kind, k.p, hlen, v.p, hlen, scratch.p)
mem.Copy(v.p, scratch.p, hlen as u64)
_bufreset(seed)
_putraw(seed, v.p, hlen)
_put8(seed, 0x01)
_putraw(seed, dbytes, rlen)
_putraw(seed, h1oct.p, rlen)
_hmac(kind, k.p, hlen, seed.p, seed.len, scratch.p)
mem.Copy(k.p, scratch.p, hlen as u64)
_hmac(kind, k.p, hlen, v.p, hlen, scratch.p)
mem.Copy(v.p, scratch.p, hlen as u64)
mut t := _newbuf(rlen + hlen)
defer _buf_wipe(t)
mut tries := 0
mut found := false
until tries < 256 and not found:
_bufreset(t)
until t.len < rlen:
_hmac(kind, k.p, hlen, v.p, hlen, scratch.p)
mem.Copy(v.p, scratch.p, hlen as u64)
_putraw(t, v.p, hlen)
end
cand := _fe_from_bytes(t.p, rlen)
if not _fe_is_zero(cand, cv.nl) and _fe_lt(cand, cv.n, cv.nl):
_fe_to_bytes(cand, kout, rlen)
found = true
else:
_bufreset(seed)
_putraw(seed, v.p, hlen)
_put8(seed, 0x00)
_hmac(kind, k.p, hlen, seed.p, seed.len, scratch.p)
mem.Copy(k.p, scratch.p, hlen as u64)
_hmac(kind, k.p, hlen, v.p, hlen, scratch.p)
mem.Copy(v.p, scratch.p, hlen as u64)
tries++
end
end
ret found
end
func _ecdsa_sign(cv: Curve, kind: int, dbytes: void*, digest: void*, dlen: int, rout: void*, sout: void*): bool:
mut kbuf := _newbuf(cv.nb)
defer _buf_wipe(kbuf)
_putzeros(kbuf, cv.nb)
if not _rfc6979_k(cv, kind, dbytes, digest, dlen, kbuf.p):
ret false
end
kfe := _fe_from_bytes(kbuf.p, cv.nb)
if _fe_is_zero(kfe, cv.nl) or not _fe_lt(kfe, cv.n, cv.nl):
ret false
end
r := _jac_mul_base(cv, kfe)
mut xb := _newbuf(cv.nb)
defer _buf_free(xb)
_putzeros(xb, cv.nb)
mut yb := _newbuf(cv.nb)
defer _buf_free(yb)
_putzeros(yb, cv.nb)
if not _jac_to_affine(cv, r, xb.p, yb.p):
ret false
end
mut x1 := _fe_from_bytes(xb.p, cv.nb)
mut rn := Fe {}
borrow := _fe_sub_raw(rn, x1, _fe_from(cv.n, cv.nl), cv.nl)
_fe_cmov(x1, rn, ((borrow ^ (1 as u32)) & (1 as u32)) as int, cv.nl)
if _fe_is_zero(x1, cv.nl):
ret false
end
z := _ecdsa_digest_scalar(cv, digest, dlen)
dfe := _fe_from_bytes(dbytes, cv.nb)
mut km := Fe {}
_sn_to_mont(cv, km, kfe)
mut kinv := Fe {}
_sn_inv(cv, kinv, km)
mut rm := Fe {}
_sn_to_mont(cv, rm, x1)
mut dm := Fe {}
_sn_to_mont(cv, dm, dfe)
mut rdm := Fe {}
_sn_mul(cv, rdm, rm, dm)
mut rd := Fe {}
_sn_from_mont(cv, rd, rdm)
mut zrd := Fe {}
_fe_add_mod(zrd, z, rd, cv.n, cv.nl)
mut zrdm := Fe {}
_sn_to_mont(cv, zrdm, zrd)
mut sm := Fe {}
_sn_mul(cv, sm, kinv, zrdm)
mut s := Fe {}
_sn_from_mont(cv, s, sm)
if _fe_is_zero(s, cv.nl):
ret false
end
_fe_to_bytes(x1, rout, cv.nb)
_fe_to_bytes(s, sout, cv.nb)
ret true
end
func _ecdsa_p256_sign(dbytes: void*, digest: void*, dlen: int, rout: void*, sout: void*): bool:
ret _ecdsa_sign(_curve_p256(), HASH_SHA256, dbytes, digest, dlen, rout, sout)
end
func _ecdsa_p384_sign(dbytes: void*, digest: void*, dlen: int, rout: void*, sout: void*): bool:
ret _ecdsa_sign(_curve_p384(), HASH_SHA384, dbytes, digest, dlen, rout, sout)
end
func _der_put_uint_from_bytes(out &: Buf, p: void*, n: int):
mut i := 0
until i < n - 1 and _bget(p, i) == 0:
i++
end
mut vlen := n - i
mut needpad := false
if _bget(p, i) >= 0x80:
needpad = true
vlen++
end
_put8(out, ASN1_INTEGER)
_put8(out, vlen)
if needpad:
_put8(out, 0x00)
end
_putraw(out, ((p as i64) + (i as i64)) as void*, n - i)
end
func _ecdsa_der_encode(rbytes: void*, sbytes: void*, width: int, out &: Buf):
_bufreset(out)
mut body := _newbuf(2 * width + 8)
defer _buf_free(body)
_der_put_uint_from_bytes(body, rbytes, width)
_der_put_uint_from_bytes(body, sbytes, width)
_put8(out, ASN1_SEQUENCE)
if body.len < 128:
_put8(out, body.len)
else:
_put8(out, 0x81)
_put8(out, body.len)
end
_putbuf(out, body)
end
package tls
import mem
const ED_L := [
237 as i64, 211 as i64, 245 as i64, 92 as i64, 26 as i64, 99 as i64, 18 as i64, 88 as i64
214 as i64, 156 as i64, 247 as i64, 162 as i64, 222 as i64, 249 as i64, 222 as i64, 20 as i64
]
const ED_SQRTM1 := "b0a00e4a271beec478e42fad0618432fa7d7fb3d99004d2b0bdfc14f8024832b"
const ED_BASE := "5866666666666666666666666666666666666666666666666666666666666666"
const ED_CX_SLOTS := 16
const ED_PT := 320
func _bptr_off(p: void*, off: int): void*:
ret ((p as i64) + (off as i64)) as void*
end
func _ed_l(j: int): i64:
if j < 16:
ret ED_L[j]
end
if j == 31:
ret 16
end
ret 0
end
func _ed_modl(r: void*, x: i64*):
mut i := 63
until i >= 32:
mut carry := 0 as i64
mut j := i - 32
until j < i - 12:
x[j] += carry - (16 as i64) * x[i] * _ed_l(j - (i - 32))
carry = (x[j] + (128 as i64)) >> (8 as i64)
x[j] -= carry << (8 as i64)
j++
end
x[j] += carry
x[i] = 0 as i64
i--
end
mut carry := 0 as i64
repeat 32 in j:
x[j] += carry - (x[31] >> (4 as i64)) * _ed_l(j)
carry = x[j] >> (8 as i64)
x[j] &= (255 as i64)
end
repeat 32 in j:
x[j] -= carry * _ed_l(j)
end
repeat 32 in k:
x[k + 1] += x[k] >> (8 as i64)
_bput(r, k, (x[k] & (255 as i64)) as int)
end
end
func _ed_reduce64(r: void*, h: void*):
x := mem.AllocateZeroed(512 as u64) as i64*
repeat 64 in i:
x[i] = _bget(h, i) as i64
end
_ed_modl(r, x)
mem.Free(x as void*)
end
func _ed_less_l(s: void*): bool:
mut i := 31
until i >= 0:
l := _ed_l(i)
b := _bget(s, i) as i64
if b < l:
ret true
end
if b > l:
ret false
end
i--
end
ret false
end
func _ed_fe_zero(f: i64*):
repeat X_LIMBS in i:
f[i] = 0 as i64
end
end
func _ed_fe_one(f: i64*):
_ed_fe_zero(f)
f[0] = 1 as i64
end
func _ed_fe_iszero(f: i64*): bool:
mut b_b := _newbuf(32)
defer _buf_wipe(b_b)
_putzeros(b_b, 32)
_fe25519_tobytes(b_b.p, f)
mut acc := 0
repeat 32 in i:
acc |= _bget(b_b.p, i)
end
ret acc == 0
end
func _ed_fe_neg(h: i64*, f: i64*):
repeat X_LIMBS in i:
h[i] = (0 as i64) - f[i]
end
end
func _ed_fe_parity(f: i64*): int:
mut b_b := _newbuf(32)
defer _buf_wipe(b_b)
_putzeros(b_b, 32)
_fe25519_tobytes(b_b.p, f)
ret _bget(b_b.p, 0) & 1
end
func _ed_pow22523(out: i64*, z: i64*, t0: i64*, t1: i64*, t2: i64*, t3: i64*):
_fe25519_sq(t0, z)
_fe25519_sqn(t1, t0, 2)
_fe25519_mul(t1, z, t1)
_fe25519_mul(t0, t0, t1)
_fe25519_sq(t2, t0)
_fe25519_mul(t1, t1, t2)
_fe25519_sqn(t2, t1, 5)
_fe25519_mul(t1, t2, t1)
_fe25519_sqn(t2, t1, 10)
_fe25519_mul(t2, t2, t1)
_fe25519_sqn(t3, t2, 20)
_fe25519_mul(t2, t3, t2)
_fe25519_sqn(t2, t2, 10)
_fe25519_mul(t1, t2, t1)
_fe25519_sqn(t2, t1, 50)
_fe25519_mul(t2, t2, t1)
_fe25519_sqn(t3, t2, 100)
_fe25519_mul(t2, t3, t2)
_fe25519_sqn(t2, t2, 50)
_fe25519_mul(t1, t2, t1)
_fe25519_sqn(t1, t1, 2)
_fe25519_mul(out, t1, z)
end
func _ed_cx_new(): i64*:
cx := mem.AllocateZeroed((X_SLOT * ED_CX_SLOTS) as u64) as i64*
d := _x_slot(cx, 0)
d2 := _x_slot(cx, 1)
sq := _x_slot(cx, 2)
t0 := _x_slot(cx, 3)
t1 := _x_slot(cx, 4)
t2 := _x_slot(cx, 5)
t3 := _x_slot(cx, 6)
num := _x_slot(cx, 7)
_ed_fe_zero(num)
num[0] = 121665 as i64
_ed_fe_zero(t0)
t0[0] = 121666 as i64
_fe25519_invert(t1, t0, d, t2, t3, sq)
_fe25519_mul(d, num, t1)
_ed_fe_neg(d, d)
_fe25519_add(d2, d, d)
mut sb := _hexbuf(ED_SQRTM1)
_fe25519_frombytes(sq, sb.p)
_buf_free(sb)
ret cx
end
func _ed_cx_free(cx: i64*):
mem.Free(cx as void*)
end
func _ed_pt_zero(p: i64*):
_ed_fe_zero(_x_slot(p, 0))
_ed_fe_one(_x_slot(p, 1))
_ed_fe_one(_x_slot(p, 2))
_ed_fe_zero(_x_slot(p, 3))
end
func _ed_pt_copy(r: i64*, p: i64*):
repeat 4 in i:
_fe25519_copy(_x_slot(r, i), _x_slot(p, i))
end
end
func _ed_pt_cswap(p: i64*, q: i64*, b: i64):
repeat 4 in i:
_fe25519_cswap(_x_slot(p, i), _x_slot(q, i), b)
end
end
func _ed_pt_add(r: i64*, p: i64*, q: i64*, cx: i64*):
d2 := _x_slot(cx, 1)
a := _x_slot(cx, 8)
b := _x_slot(cx, 9)
c := _x_slot(cx, 10)
dd := _x_slot(cx, 11)
e := _x_slot(cx, 12)
f := _x_slot(cx, 13)
t := _x_slot(cx, 14)
u := _x_slot(cx, 15)
x1 := _x_slot(p, 0)
y1 := _x_slot(p, 1)
z1 := _x_slot(p, 2)
t1 := _x_slot(p, 3)
x2 := _x_slot(q, 0)
y2 := _x_slot(q, 1)
z2 := _x_slot(q, 2)
t2 := _x_slot(q, 3)
_fe25519_sub(t, y1, x1)
_fe25519_sub(u, y2, x2)
_fe25519_mul(a, t, u)
_fe25519_add(t, y1, x1)
_fe25519_add(u, y2, x2)
_fe25519_mul(b, t, u)
_fe25519_mul(c, t1, t2)
_fe25519_mul(c, c, d2)
_fe25519_mul(dd, z1, z2)
_fe25519_add(dd, dd, dd)
_fe25519_sub(e, b, a)
_fe25519_sub(f, dd, c)
_fe25519_add(dd, dd, c)
_fe25519_add(a, b, a)
_fe25519_mul(_x_slot(r, 0), e, f)
_fe25519_mul(_x_slot(r, 1), dd, a)
_fe25519_mul(_x_slot(r, 3), e, a)
_fe25519_mul(_x_slot(r, 2), f, dd)
end
func _ed_scalarmult(r: i64*, p: i64*, s: void*, cx: i64*):
acc := mem.AllocateZeroed(ED_PT as u64) as i64*
tmp := mem.AllocateZeroed(ED_PT as u64) as i64*
base := mem.AllocateZeroed(ED_PT as u64) as i64*
_ed_pt_zero(acc)
_ed_pt_copy(base, p)
mut i := 255
until i >= 0:
bit := ((_bget(s, i >> 3) >> (i & 7)) & 1) as i64
_ed_pt_add(tmp, acc, acc, cx)
_ed_pt_copy(acc, tmp)
_ed_pt_add(tmp, acc, base, cx)
_ed_pt_cswap(acc, tmp, bit)
i--
end
_ed_pt_copy(r, acc)
_wipe(acc as void*, ED_PT)
mem.Free(acc as void*)
mem.Free(tmp as void*)
mem.Free(base as void*)
end
func _ed_pt_encode(out: void*, p: i64*, cx: i64*):
zi := _x_slot(cx, 8)
x := _x_slot(cx, 9)
y := _x_slot(cx, 10)
t0 := _x_slot(cx, 11)
t1 := _x_slot(cx, 12)
t2 := _x_slot(cx, 13)
t3 := _x_slot(cx, 14)
_fe25519_invert(zi, _x_slot(p, 2), t0, t1, t2, t3)
_fe25519_mul(x, _x_slot(p, 0), zi)
_fe25519_mul(y, _x_slot(p, 1), zi)
_fe25519_tobytes(out, y)
_bput(out, 31, _bget(out, 31) ^ (_ed_fe_parity(x) << 7))
end
func _ed_pt_decode(r: i64*, s: void*, cx: i64*): bool:
d := _x_slot(cx, 0)
sq := _x_slot(cx, 2)
y := _x_slot(cx, 8)
u := _x_slot(cx, 9)
v := _x_slot(cx, 10)
v3 := _x_slot(cx, 11)
t := _x_slot(cx, 12)
x := _x_slot(cx, 13)
c := _x_slot(cx, 14)
w := _x_slot(cx, 15)
sign := (_bget(s, 31) >> 7) & 1
_fe25519_frombytes(y, s)
one := _x_slot(r, 2)
_ed_fe_one(one)
_fe25519_sq(u, y)
_fe25519_mul(v, u, d)
_fe25519_sub(u, u, one)
_fe25519_add(v, v, one)
_fe25519_sq(v3, v)
_fe25519_mul(v3, v3, v)
_fe25519_sq(x, v3)
_fe25519_mul(x, x, v)
_fe25519_mul(x, x, u)
p0 := _x_slot(r, 0)
p1 := _x_slot(r, 1)
p3 := _x_slot(r, 3)
_ed_pow22523(p0, x, p1, p3, t, c)
_fe25519_mul(p0, p0, v3)
_fe25519_mul(p0, p0, u)
_fe25519_sq(c, p0)
_fe25519_mul(c, c, v)
_fe25519_sub(w, c, u)
if not _ed_fe_iszero(w):
_fe25519_add(w, c, u)
if not _ed_fe_iszero(w):
ret false
end
_fe25519_mul(p0, p0, sq)
end
if _ed_fe_iszero(p0) and sign == 1:
ret false
end
if _ed_fe_parity(p0) != sign:
_ed_fe_neg(p0, p0)
end
_fe25519_copy(p1, y)
_fe25519_mul(p3, p0, p1)
ret true
end
func _ed_base(cx: i64*, b: i64*): bool:
mut bb := _hexbuf(ED_BASE)
ok := _ed_pt_decode(b, bb.p, cx)
_buf_free(bb)
ret ok
end
@en "Ed25519PublicKey"
@fa "کلید عمومی ایدی۲۵۵۱۹"
pub func Ed25519PublicKey(seed: void*, out: void*):
mut h_b := _newbuf(64)
defer _buf_wipe(h_b)
_putzeros(h_b, 64)
_sha512(seed, 32, h_b.p)
_bput(h_b.p, 0, _bget(h_b.p, 0) & 248)
_bput(h_b.p, 31, (_bget(h_b.p, 31) & 127) | 64)
cx := _ed_cx_new()
b := mem.AllocateZeroed(ED_PT as u64) as i64*
p := mem.AllocateZeroed(ED_PT as u64) as i64*
_ed_base(cx, b)
_ed_scalarmult(p, b, h_b.p, cx)
_ed_pt_encode(out, p, cx)
_wipe(h_b.p, 64)
mem.Free(b as void*)
mem.Free(p as void*)
_ed_cx_free(cx)
end
@en "Ed25519Sign"
@fa "امضای ایدی۲۵۵۱۹"
pub func Ed25519Sign(seed: void*, msg: void*, n: int, out: void*):
mut h_b := _newbuf(64)
defer _buf_wipe(h_b)
_putzeros(h_b, 64)
hp := h_b.p
_sha512(seed, 32, hp)
_bput(hp, 0, _bget(hp, 0) & 248)
_bput(hp, 31, (_bget(hp, 31) & 127) | 64)
cx := _ed_cx_new()
b := mem.AllocateZeroed(ED_PT as u64) as i64*
p := mem.AllocateZeroed(ED_PT as u64) as i64*
_ed_base(cx, b)
mut pubk_b := _newbuf(32)
defer _buf_wipe(pubk_b)
_putzeros(pubk_b, 32)
pk := pubk_b.p
_ed_scalarmult(p, b, hp, cx)
_ed_pt_encode(pk, p, cx)
mut buf := _newbuf(32 + n + 64)
_putraw(buf, _bptr_off(hp, 32), 32)
_putraw(buf, msg, n)
mut rh_b := _newbuf(64)
defer _buf_wipe(rh_b)
_putzeros(rh_b, 64)
_sha512(buf.p, buf.len, rh_b.p)
mut r_b := _newbuf(32)
defer _buf_wipe(r_b)
_putzeros(r_b, 32)
_ed_reduce64(r_b.p, rh_b.p)
_ed_scalarmult(p, b, r_b.p, cx)
_ed_pt_encode(out, p, cx)
_bufreset(buf)
_putraw(buf, out, 32)
_putraw(buf, pk, 32)
_putraw(buf, msg, n)
_sha512(buf.p, buf.len, rh_b.p)
mut k_b := _newbuf(32)
defer _buf_wipe(k_b)
_putzeros(k_b, 32)
_ed_reduce64(k_b.p, rh_b.p)
x := mem.AllocateZeroed(512 as u64) as i64*
repeat 32 in i:
x[i] = _bget(r_b.p, i) as i64
end
repeat 32 in i:
repeat 32 in j:
x[i + j] += (_bget(k_b.p, i) as i64) * (_bget(hp, j) as i64)
end
end
_ed_modl(_bptr_off(out, 32), x)
mem.Free(x as void*)
_wipe(hp, 64)
_wipe(r_b.p, 32)
_buf_free(buf)
mem.Free(b as void*)
mem.Free(p as void*)
_ed_cx_free(cx)
end
@en "Ed25519Verify"
@fa "بررسی امضای ایدی۲۵۵۱۹"
pub func Ed25519Verify(pubk: void*, msg: void*, n: int, sig: void*): bool:
if not _ed_less_l(_bptr_off(sig, 32)):
ret false
end
cx := _ed_cx_new()
b := mem.AllocateZeroed(ED_PT as u64) as i64*
a := mem.AllocateZeroed(ED_PT as u64) as i64*
rp := mem.AllocateZeroed(ED_PT as u64) as i64*
sb := mem.AllocateZeroed(ED_PT as u64) as i64*
ha := mem.AllocateZeroed(ED_PT as u64) as i64*
mut ok := _ed_base(cx, b)
if ok and not _ed_pt_decode(a, pubk, cx):
ok = false
end
if ok and not _ed_pt_decode(rp, sig, cx):
ok = false
end
mut good := false
if ok:
mut buf := _newbuf(64 + n + 64)
_putraw(buf, sig, 32)
_putraw(buf, pubk, 32)
_putraw(buf, msg, n)
mut rh_b := _newbuf(64)
defer _buf_wipe(rh_b)
_putzeros(rh_b, 64)
_sha512(buf.p, buf.len, rh_b.p)
_buf_free(buf)
mut k_b := _newbuf(32)
defer _buf_wipe(k_b)
_putzeros(k_b, 32)
_ed_reduce64(k_b.p, rh_b.p)
_ed_scalarmult(sb, b, _bptr_off(sig, 32), cx)
_ed_scalarmult(ha, a, k_b.p, cx)
_ed_pt_add(ha, rp, ha, cx)
mut e1_b := _newbuf(32)
defer _buf_wipe(e1_b)
_putzeros(e1_b, 32)
mut e2_b := _newbuf(32)
defer _buf_wipe(e2_b)
_putzeros(e2_b, 32)
_ed_pt_encode(e1_b.p, sb, cx)
_ed_pt_encode(e2_b.p, ha, cx)
good = _cteq(e1_b.p, e2_b.p, 32)
end
mem.Free(b as void*)
mem.Free(a as void*)
mem.Free(rp as void*)
mem.Free(sb as void*)
mem.Free(ha as void*)
_ed_cx_free(cx)
ret good
end
package tls
import mem
import sync
import rand
import net.internal.rawsock
func _rec_set_fragment(r &: RecordLayer, cfg: Config):
r.frag_tls = cfg.frag_tls
r.frag_tcp = cfg.frag_tcp
r.frag_sni = cfg.frag_sni
r.frag_min = cfg.frag_min
r.frag_max = cfg.frag_max
r.frag_delay_ms = cfg.frag_delay_ms
r.frag_left = 0
if cfg.frag_tls or cfg.frag_tcp:
r.frag_left = cfg.frag_writes
if r.frag_left < 1:
r.frag_left = 1
end
end
end
func _frag_u8(p: void*, i: int): int:
bp := p as u8*
ret bp[i] as int
end
func _frag_sni(p: void*, n: int, host_len &: int): int:
host_len = 0
if n < 44 or _frag_u8(p, 0) != HS_CLIENT_HELLO:
ret 0 - 1
end
mut off := 38
off += 1 + _frag_u8(p, off)
if off + 2 > n:
ret 0 - 1
end
off += 2 + ((_frag_u8(p, off) << 8) | _frag_u8(p, off + 1))
if off + 1 > n:
ret 0 - 1
end
off += 1 + _frag_u8(p, off)
if off + 2 > n:
ret 0 - 1
end
mut ext_end := off + 2 + ((_frag_u8(p, off) << 8) | _frag_u8(p, off + 1))
off += 2
if ext_end > n:
ext_end = n
end
until off + 4 <= ext_end:
et := (_frag_u8(p, off) << 8) | _frag_u8(p, off + 1)
el := (_frag_u8(p, off + 2) << 8) | _frag_u8(p, off + 3)
if et == EXT_SERVER_NAME and el >= 5 and off + 4 + el <= ext_end:
nl := (_frag_u8(p, off + 7) << 8) | _frag_u8(p, off + 8)
if off + 9 + nl <= ext_end:
host_len = nl
ret off + 9
end
ret 0 - 1
end
off += 4 + el
end
ret 0 - 1
end
func _frag_cuts(total: int, lo0: int, hi0: int, sni_cut: int): Vector<int>:
mut cuts := Vector {} as Vector<int>
mut lo := lo0
mut hi := hi0
if hi > 0:
if lo < 1:
lo = 1
end
if hi < lo:
hi = lo
end
mut at := 0
until at + lo < total:
mut step := rand.IntRange(lo as i64, hi as i64) as int
if step < lo:
step = lo
end
at += step
if at < total:
cuts.push(at)
end
end
end
if sni_cut > 0 and sni_cut < total:
mut placed := false
mut out := Vector {} as Vector<int>
repeat cuts.len() in i:
c := cuts.get(i)
if not placed and c >= sni_cut:
if c != sni_cut:
out.push(sni_cut)
end
placed = true
end
out.push(c)
end
if not placed:
out.push(sni_cut)
end
cuts.free()
ret out
end
ret cuts
end
func _frag_send(r: RecordLayer, p: void*, n: int, cuts: Vector<int>): bool:
sock := rawsock.FromFd(r.fd)
mut off := 0
mut idx := 0
until off < n:
mut stop := n
if idx < cuts.len():
stop = cuts.get(idx)
end
idx++
if stop > n:
stop = n
end
if stop > off:
sent := rawsock.SendBytes(sock, ((p as i64) + (off as i64)) as void*, stop - off)
if sent != stop - off:
ret false
end
off = stop
if off < n and r.frag_delay_ms > 0:
sync.SleepMs(r.frag_delay_ms)
end
end
end
ret true
end
func _rec_flush_fragmented(r &: RecordLayer): bool:
n := r.tx.len
mut sni_len := 0
mut sni_at := 0 - 1
mut rec_split := false
if r.frag_tls and n > REC_HEADER and _bget(r.tx.p, 0) == REC_HANDSHAKE:
rec_len := (_bget(r.tx.p, 3) << 8) | _bget(r.tx.p, 4)
if rec_len + REC_HEADER <= n and rec_len > 1:
rec_split = true
sni_at = _frag_sni(_bufptr(r.tx, REC_HEADER), rec_len, sni_len)
end
else if r.frag_sni and n > REC_HEADER and _bget(r.tx.p, 0) == REC_HANDSHAKE:
sni_at = _frag_sni(_bufptr(r.tx, REC_HEADER), n - REC_HEADER, sni_len)
end
mut sni_cut := 0 - 1
if r.frag_sni and sni_at >= 0:
sni_cut = sni_at + sni_len / 2
end
if rec_split:
rec_len := (_bget(r.tx.p, 3) << 8) | _bget(r.tx.p, 4)
mut pcuts := _frag_cuts(rec_len, r.frag_min, r.frag_max, sni_cut)
mut out := _newbuf(n + REC_HEADER * (pcuts.len() + 2))
defer _buf_free(out)
mut tcp_sni := 0 - 1
mut off := 0
repeat pcuts.len() + 1 in k:
mut stop := rec_len
if k < pcuts.len():
stop = pcuts.get(k)
end
_put8(out, REC_HANDSHAKE)
_put8(out, _bget(r.tx.p, 1))
_put8(out, _bget(r.tx.p, 2))
_put16(out, stop - off)
if sni_cut >= off and sni_cut < stop and tcp_sni < 0:
tcp_sni = out.len + (sni_cut - off)
end
_putraw(out, _bufptr(r.tx, REC_HEADER + off), stop - off)
off = stop
end
pcuts.free()
if rec_len + REC_HEADER < n:
_putraw(out, _bufptr(r.tx, REC_HEADER + rec_len), n - REC_HEADER - rec_len)
end
if out.bad:
_rec_fail(r, "out of memory")
ret false
end
mut tcuts := Vector {} as Vector<int>
if r.frag_tcp:
tcuts = _frag_cuts(out.len, r.frag_min, r.frag_max, tcp_sni)
else:
mut at := 0
mut left := out.len
until left > 0:
rl := REC_HEADER + ((_bget(out.p, at + 3) << 8) | _bget(out.p, at + 4))
at += rl
left -= rl
if left > 0:
tcuts.push(at)
end
end
end
ok := _frag_send(r, out.p, out.len, tcuts)
tcuts.free()
if not ok:
_rec_fail(r, "short write")
end
ret ok
end
mut tcp_cut := 0 - 1
if sni_cut >= 0:
tcp_cut = REC_HEADER + sni_cut
end
mut tc := Vector {} as Vector<int>
if r.frag_tcp:
tc = _frag_cuts(n, r.frag_min, r.frag_max, tcp_cut)
end
ok := _frag_send(r, r.tx.p, n, tc)
tc.free()
if not ok:
_rec_fail(r, "short write")
end
ret ok
end
package tls
import mem
struct Ghash:
pub h0: u64 = 0 as u64
pub h1: u64 = 0 as u64
pub h0r: u64 = 0 as u64
pub h1r: u64 = 0 as u64
pub h2: u64 = 0 as u64
pub h2r: u64 = 0 as u64
pub y0: u64 = 0 as u64
pub y1: u64 = 0 as u64
end
struct GcmCtx:
pub aes: Aes = Aes {}
pub g: Ghash = Ghash {}
end
inline func _be64(p: void*, o: int): u64:
bp := p as u8*
ret ((bp[o] as u64) << (56 as u64)) | ((bp[o + 1] as u64) << (48 as u64)) | ((bp[o + 2] as u64) << (40 as u64)) | ((bp[o + 3] as u64) << (32 as u64)) | ((bp[o + 4] as u64) << (24 as u64)) | ((bp[o + 5] as u64) << (16 as u64)) | ((bp[o + 6] as u64) << (8 as u64)) | (bp[o + 7] as u64)
end
inline func _pbe64(v: u64, p: void*, o: int):
bp := p as u8*
bp[o] = (v >> (56 as u64)) as u8
bp[o + 1] = (v >> (48 as u64)) as u8
bp[o + 2] = (v >> (40 as u64)) as u8
bp[o + 3] = (v >> (32 as u64)) as u8
bp[o + 4] = (v >> (24 as u64)) as u8
bp[o + 5] = (v >> (16 as u64)) as u8
bp[o + 6] = (v >> (8 as u64)) as u8
bp[o + 7] = v as u8
end
inline func _rev64(v: u64): u64:
mut x := v
x = ((x & (0x5555555555555555 as u64)) << (1 as u64)) | ((x >> (1 as u64)) & (0x5555555555555555 as u64))
x = ((x & (0x3333333333333333 as u64)) << (2 as u64)) | ((x >> (2 as u64)) & (0x3333333333333333 as u64))
x = ((x & (0x0F0F0F0F0F0F0F0F as u64)) << (4 as u64)) | ((x >> (4 as u64)) & (0x0F0F0F0F0F0F0F0F as u64))
x = ((x & (0x00FF00FF00FF00FF as u64)) << (8 as u64)) | ((x >> (8 as u64)) & (0x00FF00FF00FF00FF as u64))
x = ((x & (0x0000FFFF0000FFFF as u64)) << (16 as u64)) | ((x >> (16 as u64)) & (0x0000FFFF0000FFFF as u64))
ret (x << (32 as u64)) | (x >> (32 as u64))
end
inline func _bmul64(x: u64, y: u64): u64:
x0 := x & AES_M1
x1 := x & AES_M2
x2 := x & AES_M4
x3 := x & AES_M8
y0 := y & AES_M1
y1 := y & AES_M2
y2 := y & AES_M4
y3 := y & AES_M8
z0 := (x0 * y0) ^ (x1 * y3) ^ (x2 * y2) ^ (x3 * y1)
z1 := (x0 * y1) ^ (x1 * y0) ^ (x2 * y3) ^ (x3 * y2)
z2 := (x0 * y2) ^ (x1 * y1) ^ (x2 * y0) ^ (x3 * y3)
z3 := (x0 * y3) ^ (x1 * y2) ^ (x2 * y1) ^ (x3 * y0)
ret (z0 & AES_M1) | (z1 & AES_M2) | (z2 & AES_M4) | (z3 & AES_M8)
end
inline func _ghash_mix(g &: Ghash, w1: u64, w0: u64):
y1 := g.y1 ^ w1
y0 := g.y0 ^ w0
y0r := _rev64(y0)
y1r := _rev64(y1)
y2 := y0 ^ y1
y2r := y0r ^ y1r
z0 := _bmul64(y0, g.h0)
z1 := _bmul64(y1, g.h1)
z2 := _bmul64(y2, g.h2) ^ z0 ^ z1
z0h := _bmul64(y0r, g.h0r)
z1h := _bmul64(y1r, g.h1r)
z2h := _bmul64(y2r, g.h2r) ^ z0h ^ z1h
r0 := _rev64(z0h) >> (1 as u64)
r1 := _rev64(z1h) >> (1 as u64)
r2 := _rev64(z2h) >> (1 as u64)
a1 := r0 ^ z2
a2 := z1 ^ r2
b3 := (r1 << (1 as u64)) | (a2 >> (63 as u64))
b2 := (a2 << (1 as u64)) | (a1 >> (63 as u64))
b1 := (a1 << (1 as u64)) | (z0 >> (63 as u64))
b0 := z0 << (1 as u64)
c2 := b2 ^ b0 ^ (b0 >> (1 as u64)) ^ (b0 >> (2 as u64)) ^ (b0 >> (7 as u64))
c1 := b1 ^ (b0 << (63 as u64)) ^ (b0 << (62 as u64)) ^ (b0 << (57 as u64))
g.y1 = b3 ^ c1 ^ (c1 >> (1 as u64)) ^ (c1 >> (2 as u64)) ^ (c1 >> (7 as u64))
g.y0 = c2 ^ (c1 << (63 as u64)) ^ (c1 << (62 as u64)) ^ (c1 << (57 as u64))
end
func _ghash_data(g &: Ghash, p: void*, n: int):
mut off := 0
until n - off >= 16:
_ghash_mix(g, _be64(p, off), _be64(p, off + 8))
off += 16
end
if off < n:
bp := p as u8*
mut w1 := 0 as u64
mut w0 := 0 as u64
repeat n - off in i:
if i < 8:
w1 |= ((bp[off + i] as u64) << ((56 - i * 8) as u64))
else:
w0 |= ((bp[off + i] as u64) << ((120 - i * 8) as u64))
end
end
_ghash_mix(g, w1, w0)
end
end
func _ghash_key(a: Aes): Ghash:
mem.Set(a.ks, 0, 16 as u64)
_aes_encrypt_block(a, a.ks, a.ks)
mut g := Ghash {}
g.h1 = _be64(a.ks, 0)
g.h0 = _be64(a.ks, 8)
g.h0r = _rev64(g.h0)
g.h1r = _rev64(g.h1)
g.h2 = g.h0 ^ g.h1
g.h2r = g.h0r ^ g.h1r
ret g
end
func _gcm_new(key: void*, keylen: int): GcmCtx*:
c := mem.AllocateZeroed(sizeof(GcmCtx) as u64) as GcmCtx*
c.aes = _aes_init(key, keylen)
c.g = _ghash_key(c.aes)
ret c
end
func _gcm_free(c: GcmCtx*):
if c == null:
ret
end
_aes_free(c.aes)
_wipe(c as void*, sizeof(GcmCtx) as int)
mem.Free(c as void*)
end
func _gcm_ctr(a: Aes, nonce: void*, inp: void*, out: void*, n: int):
mut off := 0
mut skip := 16
mut ctr := 1 as u32
until off < n:
mut take := AES_BATCH - skip
if take > n - off:
take = n - off
end
_xor3(((out as i64) + (off as i64)) as void*, ((inp as i64) + (off as i64)) as void*, ((a.ks as i64) + (skip as i64)) as void*, take)
off += take
skip = 0
if off < n:
ctr += 4 as u32
_aes_ctr_batch(a, nonce, ctr)
end
end
end
func _gcm_hash(g &: Ghash, aad: void*, aadlen: int, ct: void*, n: int):
if aadlen > 0:
_ghash_data(g, aad, aadlen)
end
if n > 0:
_ghash_data(g, ct, n)
end
_ghash_mix(g, (aadlen as u64) * (8 as u64), (n as u64) * (8 as u64))
end
func _gcm_seal_with(a: Aes, g0: Ghash, nonce: void*, aad: void*, aadlen: int, pt: void*, ct: void*, n: int, tag: void*):
mut g := g0
_aes_ctr_batch(a, nonce, 1 as u32)
m1 := _be64(a.ks, 0)
m0 := _be64(a.ks, 8)
_gcm_ctr(a, nonce, pt, ct, n)
_gcm_hash(g, aad, aadlen, ct, n)
_pbe64(g.y1 ^ m1, tag, 0)
_pbe64(g.y0 ^ m0, tag, 8)
end
func _gcm_open_with(a: Aes, g0: Ghash, nonce: void*, aad: void*, aadlen: int, ct: void*, n: int, tag: void*, pt: void*): bool:
mut g := g0
_gcm_hash(g, aad, aadlen, ct, n)
_aes_ctr_batch(a, nonce, 1 as u32)
d1 := g.y1 ^ _be64(a.ks, 0) ^ _be64(tag, 0)
d0 := g.y0 ^ _be64(a.ks, 8) ^ _be64(tag, 8)
if (d1 | d0) != (0 as u64):
ret false
end
_gcm_ctr(a, nonce, ct, pt, n)
ret true
end
func _gcm_seal(a: Aes, nonce: void*, aad: void*, aadlen: int, pt: void*, ct: void*, n: int, tag: void*):
_gcm_seal_with(a, _ghash_key(a), nonce, aad, aadlen, pt, ct, n, tag)
end
func _gcm_open(a: Aes, nonce: void*, aad: void*, aadlen: int, ct: void*, n: int, tag: void*, pt: void*): bool:
ret _gcm_open_with(a, _ghash_key(a), nonce, aad, aadlen, ct, n, tag, pt)
end
package tls
const HS_CLIENT_HELLO := 1
const HS_SERVER_HELLO := 2
const HS_NEW_SESSION_TICKET := 4
const HS_ENCRYPTED_EXTENSIONS := 8
const HS_CERTIFICATE := 11
const HS_CERTIFICATE_REQUEST := 13
const HS_CERTIFICATE_VERIFY := 15
const HS_FINISHED := 20
const HS_KEY_UPDATE := 24
const HS_MESSAGE_HASH := 254
struct Handshake:
pub rec: RecordLayer = RecordLayer {}
pub cipher: int = 0
pub hash: int = 0
pub hlen: int = 0
pub tr: Hash = Hash {}
pub priv: Buf = Buf {}
pub pub_key: Buf = Buf {}
pub shared: Buf = Buf {}
pub pq_seed: Buf = Buf {}
pub hs_secret: Buf = Buf {}
pub master: Buf = Buf {}
pub c_hs_secret: Buf = Buf {}
pub s_hs_secret: Buf = Buf {}
pub c_ap_secret: Buf = Buf {}
pub s_ap_secret: Buf = Buf {}
pub certs: Buf = Buf {}
pub cert_off: Buf = Buf {}
pub ncerts: int = 0
pub suite: int = 0
pub ver: int = 0
pub crand: Buf = Buf {}
pub srand: Buf = Buf {}
pub ems: bool = false
pub group: int = 0
pub ecpriv: Buf = Buf {}
pub ecpub: Buf = Buf {}
pub hrr: bool = false
pub share_group: int = 0
pub cookie: Buf = Buf {}
pub sid: Buf = Buf {}
pub ok: bool = false
pub err: str = ""
end
func _hs_free(h &: Handshake):
_buf_wipe(h.priv)
_buf_free(h.pub_key)
_buf_wipe(h.shared)
_buf_wipe(h.pq_seed)
_buf_wipe(h.hs_secret)
_buf_wipe(h.master)
_buf_wipe(h.c_hs_secret)
_buf_wipe(h.s_hs_secret)
_buf_wipe(h.c_ap_secret)
_buf_wipe(h.s_ap_secret)
_buf_free(h.certs)
_buf_free(h.cert_off)
_buf_free(h.crand)
_buf_free(h.srand)
_buf_wipe(h.ecpriv)
_buf_free(h.ecpub)
_buf_free(h.cookie)
_buf_free(h.sid)
end
func _hs_fail(h &: Handshake, msg: str): bool:
if h.err.len() == 0:
h.err = msg
end
ret false
end
func _hs_transcript(h: Handshake, out &: Buf):
_bufreset(out)
_putzeros(out, h.hlen)
_hash_final(h.tr, out.p)
end
func _hs_derive(h: Handshake, secret: Buf, label: str, th: Buf, out &: Buf): bool:
_bufreset(out)
_putzeros(out, h.hlen)
ret _derive_secret(h.hash, secret.p, secret.len, label, th.p, th.len, out.p)
end
func _hs_key_schedule(h &: Handshake): bool:
mut zeros := _newbuf(h.hlen)
defer _buf_wipe(zeros)
_putzeros(zeros, h.hlen)
mut early := _newbuf(h.hlen)
defer _buf_wipe(early)
_putzeros(early, h.hlen)
_hkdf_extract(h.hash, zeros.p, 0, zeros.p, h.hlen, early.p)
mut emptyhash := _newbuf(h.hlen)
defer _buf_free(emptyhash)
_putzeros(emptyhash, h.hlen)
_hash_oneshot(h.hash, zeros.p, 0, emptyhash.p)
mut derived := _newbuf(h.hlen)
defer _buf_wipe(derived)
if not _hs_derive(h, early, "derived", emptyhash, derived):
ret false
end
_bufreset(h.hs_secret)
_putzeros(h.hs_secret, h.hlen)
_hkdf_extract(h.hash, derived.p, h.hlen, h.shared.p, h.shared.len, h.hs_secret.p)
mut th := _newbuf(h.hlen)
defer _buf_free(th)
_hs_transcript(h, th)
if not _hs_derive(h, h.hs_secret, "c hs traffic", th, h.c_hs_secret):
ret false
end
if not _hs_derive(h, h.hs_secret, "s hs traffic", th, h.s_hs_secret):
ret false
end
mut derived2 := _newbuf(h.hlen)
defer _buf_wipe(derived2)
if not _hs_derive(h, h.hs_secret, "derived", emptyhash, derived2):
ret false
end
_bufreset(h.master)
_putzeros(h.master, h.hlen)
_hkdf_extract(h.hash, derived2.p, h.hlen, zeros.p, h.hlen, h.master.p)
ret true
end
func _hs_finished_mac(h: Handshake, secret: Buf, th: Buf, out &: Buf): bool:
mut fk := _newbuf(h.hlen)
defer _buf_wipe(fk)
_putzeros(fk, h.hlen)
if not _hkdf_expand_label(h.hash, secret.p, secret.len, "finished", null, 0, fk.p, h.hlen):
ret false
end
_bufreset(out)
_putzeros(out, h.hlen)
_hmac(h.hash, fk.p, h.hlen, th.p, th.len, out.p)
ret true
end
func _hs_read_cert_list(h &: Handshake, msg: Reader, tls13: bool): bool:
mut r := msg
if tls13:
ctx := _rdvec8(r)
if r.bad or ctx.len != 0:
ret _hs_fail(h, "unexpected certificate context")
end
end
mut list := _rdvec24(r)
if r.bad:
ret _hs_fail(h, "malformed Certificate message")
end
_bufreset(h.certs)
_bufreset(h.cert_off)
h.ncerts = 0
until _rdleft(list) > 0 and not list.bad:
cert := _rdvec24(list)
if tls13:
mut exts := _rdvec16(list)
_rdskip(exts, exts.len)
end
if list.bad:
ret _hs_fail(h, "malformed certificate entry")
end
if h.ncerts < MAX_CHAIN_DEPTH:
begin := h.certs.len
repeat cert.len in i:
_put8(h.certs, _rdat(cert, i))
end
_put32(h.cert_off, begin as i64)
_put32(h.cert_off, cert.len as i64)
h.ncerts++
end
end
if h.ncerts == 0:
ret _hs_fail(h, "server sent no certificates")
end
ret true
end
func _hs_parse_certificate(h &: Handshake, msg: Reader): bool:
ret _hs_read_cert_list(h, msg, true)
end
func _hs_cv_content(_h: Handshake, th: Buf, out &: Buf):
_bufreset(out)
repeat 64:
_put8(out, 0x20)
end
_putstr(out, "TLS 1.3, server CertificateVerify")
_put8(out, 0)
_putbuf(out, th)
end
func _hs_verify_cert_verify(h &: Handshake, msg: Reader, th: Buf): bool:
mut r := msg
scheme := _rd16(r)
sig := _rdvec16(r)
if r.bad or _rdleft(r) != 0:
ret _hs_fail(h, "malformed CertificateVerify")
end
mut content := _newbuf(128)
defer _buf_free(content)
_hs_cv_content(h, th, content)
leaf := _cert_parse(_bufptr(h.certs, 0), _cert_len(h, 0))
if not leaf.ok:
ret _hs_fail(h, "server leaf certificate did not parse")
end
if not _tls_verify_leaf_sig(leaf, scheme, content, sig, false):
ret _hs_fail(h, "CertificateVerify signature invalid")
end
ret true
end
func _cert_len(h: Handshake, i: int): int:
mut l := 0
repeat 4 in k:
l = (l << 8) | _bufat(h.cert_off, i * 8 + 4 + k)
end
ret l
end
func _cert_start(h: Handshake, i: int): int:
mut o := 0
repeat 4 in k:
o = (o << 8) | _bufat(h.cert_off, i * 8 + k)
end
ret o
end
package tls
const EXT_SERVER_NAME := 0
const EXT_SUPPORTED_GROUPS := 10
const EXT_SIGNATURE_ALGORITHMS := 13
const EXT_ALPN := 16
const EXT_SUPPORTED_VERSIONS := 43
const EXT_KEY_SHARE := 51
const EXT_COOKIE := 44
const GROUP_X25519 := 0x001D
const GROUP_SECP256R1 := 0x0017
const GROUP_SECP384R1 := 0x0018
const GROUP_X25519MLKEM768 := 0x11EC
const SA_RSA_PKCS1_SHA256 := 0x0401
const SA_RSA_PKCS1_SHA384 := 0x0501
const SA_ECDSA_P256_SHA256 := 0x0403
const SA_ECDSA_P384_SHA384 := 0x0503
const SA_RSA_PSS_RSAE_SHA256 := 0x0804
const SA_RSA_PSS_RSAE_SHA384 := 0x0805
const SA_RSA_PSS_PSS_SHA256 := 0x0809
const HRR_RANDOM := "cf21ad74e59a6111be1d8c021e65b891c2a211167abb8c5e079e09e2c8a8339c"
func _ext_open(b &: Buf, id: int): int:
_put16(b, id)
_put16(b, 0)
ret b.len
end
func _ext_close(b &: Buf, mark: int):
_patch16(b, mark - 2, b.len - mark)
end
func _hs_build_client_hello(h &: Handshake, host: str, alpn: str, aes_only: bool, out &: Buf): bool:
retry := h.hrr
_bufreset(out)
_put8(out, HS_CLIENT_HELLO)
lenmark := out.len
_put24(out, 0)
body := out.len
_put16(out, TLS12)
if not retry:
_bufreset(h.crand)
_putzeros(h.crand, 32)
crypto.RandomBytes(h.crand.p, 32)
_buf_free(h.sid)
h.sid = _newbuf(32)
_putzeros(h.sid, 32)
crypto.RandomBytes(h.sid.p, 32)
end
_putbuf(out, h.crand)
_put8(out, 32)
_putbuf(out, h.sid)
if aes_only:
_put16(out, 6)
_put16(out, TLS_AES_128_GCM_SHA256)
_put16(out, TLS12_ECDHE_ECDSA_AES128_GCM_SHA256)
_put16(out, TLS12_ECDHE_RSA_AES128_GCM_SHA256)
else:
_put16(out, 16)
_put16(out, TLS_CHACHA20_POLY1305_SHA256)
_put16(out, TLS_AES_128_GCM_SHA256)
_put16(out, TLS12_ECDHE_ECDSA_CHACHA20_SHA256)
_put16(out, TLS12_ECDHE_RSA_CHACHA20_SHA256)
_put16(out, TLS12_ECDHE_ECDSA_AES128_GCM_SHA256)
_put16(out, TLS12_ECDHE_RSA_AES128_GCM_SHA256)
_put16(out, TLS12_ECDHE_ECDSA_AES256_GCM_SHA384)
_put16(out, TLS12_ECDHE_RSA_AES256_GCM_SHA384)
end
_put8(out, 1)
_put8(out, 0)
extmark := out.len
_put16(out, 0)
extstart := out.len
if host.len() > 0:
m := _ext_open(out, EXT_SERVER_NAME)
_put16(out, host.len() + 3)
_put8(out, 0)
_put16(out, host.len())
_putstr(out, host)
_ext_close(out, m)
end
m2 := _ext_open(out, EXT_SUPPORTED_GROUPS)
_put16(out, 6)
_put16(out, GROUP_X25519)
_put16(out, GROUP_SECP256R1)
_put16(out, GROUP_SECP384R1)
_ext_close(out, m2)
m3 := _ext_open(out, EXT_SIGNATURE_ALGORITHMS)
_put16(out, 12)
_put16(out, SA_ECDSA_P256_SHA256)
_put16(out, SA_ECDSA_P384_SHA384)
_put16(out, SA_RSA_PSS_RSAE_SHA256)
_put16(out, SA_RSA_PSS_RSAE_SHA384)
_put16(out, SA_RSA_PKCS1_SHA256)
_put16(out, SA_RSA_PKCS1_SHA384)
_ext_close(out, m3)
m4 := _ext_open(out, EXT_SUPPORTED_VERSIONS)
_put8(out, 4)
_put16(out, TLS13)
_put16(out, TLS12)
_ext_close(out, m4)
m7 := _ext_open(out, EXT_EC_POINT_FORMATS)
_put8(out, 1)
_put8(out, 0)
_ext_close(out, m7)
m8 := _ext_open(out, EXT_EXTENDED_MASTER_SECRET)
_ext_close(out, m8)
if not retry:
h.share_group = GROUP_X25519
end
m5 := _ext_open(out, EXT_KEY_SHARE)
if h.share_group == GROUP_X25519:
_bufreset(h.priv)
_putzeros(h.priv, 32)
crypto.RandomBytes(h.priv.p, 32)
_bufreset(h.pub_key)
_putzeros(h.pub_key, 32)
_x25519_base(h.priv.p, h.pub_key.p)
_put16(out, 36)
_put16(out, GROUP_X25519)
_put16(out, 32)
_putbuf(out, h.pub_key)
else:
mut cv := _curve_p256()
if h.share_group == GROUP_SECP384R1:
cv = _curve_p384()
end
if not _tls12_gen_ec_key(h, cv):
ret _hs_fail(h, "could not generate a key share")
end
_put16(out, h.ecpub.len + 4)
_put16(out, h.share_group)
_put16(out, h.ecpub.len)
_putbuf(out, h.ecpub)
end
_ext_close(out, m5)
if retry and h.cookie.len > 0:
mc := _ext_open(out, EXT_COOKIE)
_put16(out, h.cookie.len)
_putbuf(out, h.cookie)
_ext_close(out, mc)
end
if alpn.len() > 0:
m6 := _ext_open(out, EXT_ALPN)
_put16(out, alpn.len() + 1)
_put8(out, alpn.len())
_putstr(out, alpn)
_ext_close(out, m6)
end
_patch16(out, extmark, out.len - extstart)
_patch24(out, lenmark, out.len - body)
ret true
end
func _hs_parse_server_hello(h &: Handshake, msg: Reader): bool:
mut r := msg
ver := _rd16(r)
if ver != TLS12:
if ver == TLS10 or ver == TLS11:
ret _hs_fail(h, "server requires TLS 1.0/1.1, which this client does not implement (deprecated by RFC 8996)")
end
ret _hs_fail(h, "unexpected legacy_version in ServerHello")
end
srand := _rdbytes(r, 32)
_bufreset(h.srand)
repeat 32 in i:
_put8(h.srand, _rdat(srand, i))
end
mut hrr := _hexbuf(HRR_RANDOM)
defer _buf_free(hrr)
is_hrr := _cteq(srand.p, hrr.p, 32)
if is_hrr and h.hrr:
ret _hs_fail(h, "server sent a second HelloRetryRequest")
end
mut sid := _rdvec8(r)
_rdskip(sid, sid.len)
suite := _rd16(r)
comp := _rd8(r)
if r.bad:
ret _hs_fail(h, "malformed ServerHello")
end
if comp != 0:
ret _hs_fail(h, "server selected a compression method")
end
suite13 := _cipher_from_wire(suite)
suite12 := _tls12_cipher(suite)
if suite13 == CIPHER_NONE and suite12 == CIPHER_NONE:
ret _hs_fail(h, "server selected an unsupported cipher suite")
end
mut exts := _rdvec16(r)
if r.bad:
ret _hs_fail(h, "malformed ServerHello extensions")
end
mut got_version := false
mut peer := _newreader(null, 0)
until _rdleft(exts) > 0 and not exts.bad:
id := _rd16(exts)
mut body := _rdvec16(exts)
if exts.bad:
ret _hs_fail(h, "malformed ServerHello extension")
end
if id == EXT_SUPPORTED_VERSIONS:
v := _rd16(body)
if body.bad or v != TLS13:
ret _hs_fail(h, "server selected an unknown version")
end
got_version = true
else if id == EXT_EXTENDED_MASTER_SECRET:
h.ems = true
else if id == EXT_KEY_SHARE and is_hrr:
g := _rd16(body)
if body.bad or (g != GROUP_SECP256R1 and g != GROUP_SECP384R1 and g != GROUP_X25519) or g == h.share_group:
ret _hs_fail(h, "HelloRetryRequest asked for an unsupported group")
end
h.share_group = g
else if id == EXT_COOKIE and is_hrr:
ck := _rdvec16(body)
if body.bad or ck.len == 0:
ret _hs_fail(h, "malformed HelloRetryRequest cookie")
end
_buf_free(h.cookie)
h.cookie = _newbuf(ck.len)
repeat ck.len in i:
_put8(h.cookie, _rdat(ck, i))
end
else if id == EXT_KEY_SHARE:
g := _rd16(body)
if g == GROUP_X25519MLKEM768 and h.pq_seed.len == 64 and h.share_group == GROUP_X25519:
h.share_group = g
end
if g != h.share_group:
ret _hs_fail(h, "server selected a group we did not offer a share for")
end
peer = _rdvec16(body)
if body.bad:
ret _hs_fail(h, "malformed key share")
end
end
end
if is_hrr:
if not got_version or suite13 == CIPHER_NONE:
ret _hs_fail(h, "malformed HelloRetryRequest")
end
h.hrr = true
h.suite = suite
h.cipher = suite13
h.hash = _cipher_hash(h.cipher)
h.hlen = _hash_size(h.hash)
ret true
end
if not got_version:
if suite12 == CIPHER_NONE:
ret _hs_fail(h, "server picked a TLS 1.3 suite without selecting TLS 1.3")
end
h.ver = TLS12
h.suite = suite
h.cipher = suite12
h.hash = _cipher_hash(h.cipher)
h.hlen = _hash_size(h.hash)
ret true
end
if suite13 == CIPHER_NONE:
ret _hs_fail(h, "server picked a TLS 1.2 suite while selecting TLS 1.3")
end
if h.hrr and suite != h.suite:
ret _hs_fail(h, "ServerHello cipher suite differs from the HelloRetryRequest")
end
h.ver = TLS13
h.suite = suite
h.cipher = suite13
h.hash = _cipher_hash(h.cipher)
h.hlen = _hash_size(h.hash)
if peer.len == 0:
ret _hs_fail(h, "server sent no key share")
end
h.group = h.share_group
_bufreset(h.shared)
if h.share_group == GROUP_X25519MLKEM768:
if peer.len != 1088 + 32:
ret _hs_fail(h, "malformed key share")
end
_putzeros(h.shared, 64)
mlkem_ss := h.shared.p
Mlkem768Decapsulate(h.pq_seed.p, peer.p, mlkem_ss)
if not _x25519_shared(h.priv.p, ((peer.p as i64) + 1088) as void*, _bufptr(h.shared, 32)):
ret _hs_fail(h, "peer key share produced a degenerate shared secret")
end
ret true
end
if h.share_group == GROUP_X25519:
if peer.len != 32:
ret _hs_fail(h, "malformed key share")
end
_putzeros(h.shared, 32)
if not _x25519_shared(h.priv.p, peer.p, h.shared.p):
ret _hs_fail(h, "peer key share produced a degenerate shared secret")
end
ret true
end
mut cv := _curve_p256()
if h.share_group == GROUP_SECP384R1:
cv = _curve_p384()
end
_putzeros(h.shared, cv.nb)
if not _ec_ecdh(cv, h.ecpriv.p, peer.p, peer.len, h.shared.p):
ret _hs_fail(h, "invalid EC key share from the server")
end
ret true
end
package tls
struct ClientHelloInfo:
pub crand: Buf = Buf {}
pub session_id: Buf = Buf {}
pub want_tls13: bool = false
pub suites: Buf = Buf {}
pub nsuites: int = 0
pub kx_group: int = 0
pub kx_pub: Buf = Buf {}
pub sig_algos: Buf = Buf {}
pub nsigalgos: int = 0
pub server_name: str = ""
pub alpn: Buf = Buf {}
pub nalpn: int = 0
pub ext_ems: bool = false
pub ok: bool = false
end
func _chi_free(i &: ClientHelloInfo):
_buf_free(i.crand)
_buf_free(i.session_id)
_buf_free(i.suites)
_buf_free(i.kx_pub)
_buf_free(i.sig_algos)
_buf_free(i.alpn)
end
func _chi_suite_at(i: ClientHelloInfo, idx: int): int:
ret (_bufat(i.suites, idx * 2) << 8) | _bufat(i.suites, idx * 2 + 1)
end
func _chi_sigalgo_at(i: ClientHelloInfo, idx: int): int:
ret (_bufat(i.sig_algos, idx * 2) << 8) | _bufat(i.sig_algos, idx * 2 + 1)
end
func _hs_parse_client_hello(msg: Reader): ClientHelloInfo:
mut info := ClientHelloInfo {}
mut r := msg
_rd16(r)
crand := _rdbytes(r, 32)
if r.bad:
ret info
end
info.crand = _newbuf(32)
repeat 32 in i:
_put8(info.crand, _rdat(crand, i))
end
sid := _rdvec8(r)
if r.bad:
ret info
end
info.session_id = _newbuf(sid.len)
repeat sid.len in i:
_put8(info.session_id, _rdat(sid, i))
end
suitesr := _rdvec16(r)
if r.bad or suitesr.len % 2 != 0:
ret info
end
info.nsuites = suitesr.len / 2
info.suites = _newbuf(suitesr.len)
repeat suitesr.len in i:
_put8(info.suites, _rdat(suitesr, i))
end
_rdvec8(r)
if r.bad:
ret info
end
mut exts := _rdvec16(r)
if r.bad:
ret info
end
until _rdleft(exts) > 0 and not exts.bad:
id := _rd16(exts)
mut body := _rdvec16(exts)
if exts.bad:
ret info
end
if id == EXT_SUPPORTED_VERSIONS:
n := _rd8(body)
mut has13 := false
mut j := 0
until j < n / 2:
v := _rd16(body)
if v == TLS13:
has13 = true
end
j++
end
info.want_tls13 = has13
else if id == EXT_EXTENDED_MASTER_SECRET:
info.ext_ems = true
else if id == EXT_SERVER_NAME:
listlen := _rd16(body)
if listlen > 0:
nametype := _rd8(body)
namelen := _rd16(body)
nr := _rdbytes(body, namelen)
if not body.bad and nametype == 0:
info.server_name = _rd_to_str(nr)
end
end
else if id == EXT_SIGNATURE_ALGORITHMS:
n := _rd16(body)
info.nsigalgos = n / 2
info.sig_algos = _newbuf(n)
repeat n:
_put8(info.sig_algos, _rd8(body))
end
else if id == EXT_KEY_SHARE:
n := _rd16(body)
mut left := n
until left > 3 and info.kx_group == 0:
g := _rd16(body)
plen := _rd16(body)
pr := _rdbytes(body, plen)
left -= 4 + plen
if not body.bad:
if g == GROUP_X25519 and plen == 32:
info.kx_group = g
info.kx_pub = _newbuf(plen)
repeat plen in i:
_put8(info.kx_pub, _rdat(pr, i))
end
else if (g == GROUP_SECP256R1 or g == GROUP_SECP384R1) and plen == (1 + 2 * _group_nb(g)):
info.kx_group = g
info.kx_pub = _newbuf(plen)
repeat plen in i:
_put8(info.kx_pub, _rdat(pr, i))
end
end
end
end
else if id == EXT_ALPN:
n := _rd16(body)
info.alpn = _newbuf(n)
repeat n:
_put8(info.alpn, _rd8(body))
end
end
end
if r.bad:
ret info
end
info.ok = true
ret info
end
func _group_nb(g: int): int:
if g == GROUP_SECP384R1:
ret 48
end
ret 32
end
package tls
const HASH_SHA256 := 0
const HASH_SHA384 := 1
const HASH_SHA512 := 2
struct Hash:
pub kind: int = 0
pub s256: Sha256 = Sha256 {}
pub s384: Sha512 = Sha512 {}
end
struct Hmac:
pub kind: int = 0
pub inner: Hash = Hash {}
pub outer: Hash = Hash {}
end
func _hash_size(kind: int): int:
if kind == HASH_SHA384:
ret SHA384_SIZE
end
if kind == HASH_SHA512:
ret SHA512_SIZE
end
ret SHA256_SIZE
end
func _hash_blocksize(kind: int): int:
if kind == HASH_SHA384 or kind == HASH_SHA512:
ret SHA512_BLOCK
end
ret SHA256_BLOCK
end
func _hash_init(kind: int): Hash:
mut h := Hash { kind = kind }
if kind == HASH_SHA384:
h.s384 = _sha384_init()
else kind == HASH_SHA512:
h.s384 = _sha512_init()
else:
h.s256 = _sha256_init()
end
ret h
end
func _hash_update(h &: Hash, p: void*, n: int):
if h.kind == HASH_SHA384 or h.kind == HASH_SHA512:
_sha512_update(h.s384, p, n)
else:
_sha256_update(h.s256, p, n)
end
end
func _hash_final(h: Hash, out: void*):
if h.kind == HASH_SHA384 or h.kind == HASH_SHA512:
_sha512_final(h.s384, out)
else:
_sha256_final(h.s256, out)
end
end
func _hash_oneshot(kind: int, p: void*, n: int, out: void*):
mut h := _hash_init(kind)
_hash_update(h, p, n)
_hash_final(h, out)
end
func _hmac_init(kind: int, key: void*, klen: int): Hmac:
bs := _hash_blocksize(kind)
hs := _hash_size(kind)
mut m := Hmac {}
m.kind = kind
m.inner = _hash_init(kind)
m.outer = _hash_init(kind)
mut k0 := _newbuf(bs)
defer _buf_wipe(k0)
if klen > bs:
_putzeros(k0, hs)
_hash_oneshot(kind, key, klen, k0.p)
else:
_putraw(k0, key, klen)
end
until k0.len < bs:
_put8(k0, 0)
end
mut pad := _newbuf(bs)
defer _buf_wipe(pad)
repeat bs in i:
_put8(pad, _bufat(k0, i) ^ 0x36)
end
_hash_update(m.inner, pad.p, bs)
_bufreset(pad)
repeat bs in i:
_put8(pad, _bufat(k0, i) ^ 0x5C)
end
_hash_update(m.outer, pad.p, bs)
ret m
end
func _hmac_update(m &: Hmac, p: void*, n: int):
_hash_update(m.inner, p, n)
end
func _hmac_final(m: Hmac, out: void*):
hs := _hash_size(m.kind)
mut id := _newbuf(hs)
defer _buf_wipe(id)
_putzeros(id, hs)
_hash_final(m.inner, id.p)
mut o := m.outer
_hash_update(o, id.p, hs)
_hash_final(o, out)
end
func _hmac(kind: int, key: void*, klen: int, msg: void*, mlen: int, out: void*):
mut m := _hmac_init(kind, key, klen)
_hmac_update(m, msg, mlen)
_hmac_final(m, out)
end
func _hkdf_extract(kind: int, salt: void*, saltlen: int, ikm: void*, ikmlen: int, out: void*):
_hmac(kind, salt, saltlen, ikm, ikmlen, out)
end
func _hkdf_expand(kind: int, prk: void*, prklen: int, info: void*, infolen: int, out: void*, olen: int): bool:
hs := _hash_size(kind)
if olen < 0 or olen > 255 * hs:
ret false
end
mut t := _newbuf(hs)
defer _buf_wipe(t)
mut cb := _newbuf(1)
defer _buf_free(cb)
_put8(cb, 0)
mut tlen := 0
mut done := 0
mut ctr := 1
until done < olen:
_bufset(cb, 0, ctr)
mut m := _hmac_init(kind, prk, prklen)
if tlen > 0:
_hmac_update(m, t.p, tlen)
end
if infolen > 0:
_hmac_update(m, info, infolen)
end
_hmac_update(m, cb.p, 1)
_bufreset(t)
_putzeros(t, hs)
_hmac_final(m, t.p)
tlen = hs
mut take := olen - done
if take > hs:
take = hs
end
repeat take in i:
_bput(out, done + i, _bufat(t, i))
end
done += take
ctr++
end
ret true
end
func _hkdf_expand_label(kind: int, secret: void*, slen: int, label: str, ctx: void*, ctxlen: int, out: void*, olen: int): bool:
full := "tls13 " + label
if full.len() > 255 or ctxlen > 255:
ret false
end
mut info := _newbuf(64)
defer _buf_free(info)
_put16(info, olen)
_put8(info, full.len())
_putstr(info, full)
_put8(info, ctxlen)
_putraw(info, ctx, ctxlen)
ret _hkdf_expand(kind, secret, slen, info.p, info.len, out, olen)
end
func _derive_secret(kind: int, secret: void*, slen: int, label: str, th: void*, thlen: int, out: void*): bool:
ret _hkdf_expand_label(kind, secret, slen, label, th, thlen, out, _hash_size(kind))
end
package tls
import mem
const KECCAK_RC := [
0x0000000000000001 as u64, 0x0000000000008082 as u64, 0x800000000000808a as u64, 0x8000000080008000 as u64
0x000000000000808b as u64, 0x0000000080000001 as u64, 0x8000000080008081 as u64, 0x8000000000008009 as u64
0x000000000000008a as u64, 0x0000000000000088 as u64, 0x0000000080008009 as u64, 0x000000008000000a as u64
0x000000008000808b as u64, 0x800000000000008b as u64, 0x8000000000008089 as u64, 0x8000000000008003 as u64
0x8000000000008002 as u64, 0x8000000000000080 as u64, 0x000000000000800a as u64, 0x800000008000000a as u64
0x8000000080008081 as u64, 0x8000000000008080 as u64, 0x0000000080000001 as u64, 0x8000000080008008 as u64
]
const KECCAK_ROT := [1, 3, 6, 10, 15, 21, 28, 36, 45, 55, 2, 14, 27, 41, 56, 8, 25, 43, 62, 18, 39, 61, 20, 44]
const KECCAK_PI := [10, 7, 11, 17, 18, 3, 5, 16, 8, 21, 24, 4, 15, 23, 19, 13, 12, 2, 20, 14, 22, 9, 6, 1]
struct _Sponge:
pub st: u64* = null
pub rate: int = 0
pub pos: int = 0
pub ds: int = 0
end
inline func _rotl64(x: u64, n: int): u64:
ret (x << (n as u64)) | (x >> ((64 - n) as u64))
end
func _keccak_f(st: u64*):
bc := mem.AllocateZeroed(40 as u64) as u64*
repeat 24 in r:
repeat 5 in i:
bc[i] = st[i] ^ st[i + 5] ^ st[i + 10] ^ st[i + 15] ^ st[i + 20]
end
repeat 5 in i:
t := bc[(i + 4) % 5] ^ _rotl64(bc[(i + 1) % 5], 1)
repeat 5 in j:
st[j * 5 + i] ^= t
end
end
mut t := st[1]
repeat 24 in i:
j := KECCAK_PI[i]
bc[0] = st[j]
st[j] = _rotl64(t, KECCAK_ROT[i])
t = bc[0]
end
repeat 5 in j:
repeat 5 in i:
bc[i] = st[j * 5 + i]
end
repeat 5 in i:
st[j * 5 + i] ^= (~bc[(i + 1) % 5]) & bc[(i + 2) % 5]
end
end
st[0] ^= KECCAK_RC[r]
end
mem.Free(bc as void*)
end
func _sp_new(rate: int, ds: int): _Sponge:
ret _Sponge { st = mem.AllocateZeroed(200 as u64) as u64*, rate = rate, pos = 0, ds = ds }
end
func _sp_free(s &: _Sponge):
mem.Free(s.st as void*)
s.st = null
end
func _sp_xor(s: _Sponge, i: int, b: int):
s.st[i >> 3] ^= (b as u64) << ((8 * (i & 7)) as u64)
end
func _sp_absorb(s &: _Sponge, p: void*, n: int):
bp := p as u8*
repeat n in i:
_sp_xor(s, s.pos, bp[i] as int)
s.pos++
if s.pos == s.rate:
_keccak_f(s.st)
s.pos = 0
end
end
end
func _sp_finish(s &: _Sponge):
_sp_xor(s, s.pos, s.ds)
_sp_xor(s, s.rate - 1, 0x80)
_keccak_f(s.st)
s.pos = 0
end
func _sp_squeeze(s &: _Sponge, out: void*, n: int):
op := out as u8*
repeat n in i:
if s.pos == s.rate:
_keccak_f(s.st)
s.pos = 0
end
op[i] = ((s.st[s.pos >> 3] >> ((8 * (s.pos & 7)) as u64)) & (0xFF as u64)) as u8
s.pos++
end
end
func _sha3_256(data: void*, n: int, out: void*):
mut s := _sp_new(136, 0x06)
_sp_absorb(s, data, n)
_sp_finish(s)
_sp_squeeze(s, out, 32)
_sp_free(s)
end
func _sha3_512(data: void*, n: int, out: void*):
mut s := _sp_new(72, 0x06)
_sp_absorb(s, data, n)
_sp_finish(s)
_sp_squeeze(s, out, 64)
_sp_free(s)
end
func _shake256(data: void*, n: int, out: void*, outlen: int):
mut s := _sp_new(136, 0x1F)
_sp_absorb(s, data, n)
_sp_finish(s)
_sp_squeeze(s, out, outlen)
_sp_free(s)
end
package tls
struct TrafficKeys:
pub key: Buf = Buf {}
pub iv: Buf = Buf {}
pub seq: u64 = 0 as u64
pub cipher: int = 0
pub live: bool = false
pub is12: bool = false
pub explicit_len: int = 0
pub gcm: GcmCtx* = null
end
func _cipher_hash(c: int): int:
if c == CIPHER_AES256_GCM_SHA384:
ret HASH_SHA384
end
ret HASH_SHA256
end
func _cipher_keylen(c: int): int:
if c == CIPHER_CHACHA20_SHA256:
ret 32
end
if c == CIPHER_AES256_GCM_SHA384:
ret 32
end
ret 16
end
func _cipher_from_wire(w: int): int:
if w == TLS_AES_128_GCM_SHA256:
ret CIPHER_AES128_GCM_SHA256
end
if w == TLS_CHACHA20_POLY1305_SHA256:
ret CIPHER_CHACHA20_SHA256
end
if w == TLS_AES_256_GCM_SHA384:
ret CIPHER_AES256_GCM_SHA384
end
ret CIPHER_NONE
end
func _tk_cipher_setup(t &: TrafficKeys):
if t.cipher != CIPHER_CHACHA20_SHA256:
t.gcm = _gcm_new(t.key.p, t.key.len)
end
end
func _tk_free(t &: TrafficKeys):
_gcm_free(t.gcm)
t.gcm = null
_buf_wipe(t.key)
_buf_wipe(t.iv)
t.seq = 0 as u64
t.live = false
end
func _tk_derive(secret: void*, slen: int, cipher: int): TrafficKeys:
kind := _cipher_hash(cipher)
klen := _cipher_keylen(cipher)
mut t := TrafficKeys {}
t.cipher = cipher
t.key = _newbuf(klen)
_putzeros(t.key, klen)
t.iv = _newbuf(12)
_putzeros(t.iv, 12)
mut ok := _hkdf_expand_label(kind, secret, slen, "key", null, 0, t.key.p, klen)
if not _hkdf_expand_label(kind, secret, slen, "iv", null, 0, t.iv.p, 12):
ok = false
end
t.seq = 0 as u64
t.live = ok
if ok:
_tk_cipher_setup(t)
end
ret t
end
func _tk_from_block(kb: Buf, koff: int, klen: int, ivoff: int, ivlen: int, cipher: int): TrafficKeys:
mut t := TrafficKeys {}
t.cipher = cipher
t.is12 = true
t.key = _newbuf(klen)
repeat klen in i:
_put8(t.key, _bufat(kb, koff + i))
end
t.iv = _newbuf(ivlen)
repeat ivlen in i:
_put8(t.iv, _bufat(kb, ivoff + i))
end
if cipher == CIPHER_CHACHA20_SHA256:
t.explicit_len = 0
else:
t.explicit_len = 8
end
t.seq = 0 as u64
t.live = true
_tk_cipher_setup(t)
ret t
end
func _tk12_ivlen(cipher: int): int:
if cipher == CIPHER_CHACHA20_SHA256:
ret 12
end
ret 4
end
func _tk12_aad(seq: u64, typ: int, plen: int, out &: Buf):
_bufreset(out)
_put64(out, seq)
_put8(out, typ)
_put16(out, TLS12)
_put16(out, plen)
end
func _tk_nonce(t: TrafficKeys, out &: Buf):
_bufreset(out)
if t.is12 and t.explicit_len > 0:
_putraw(out, t.iv.p, 4)
_put64(out, t.seq)
ret
end
_putraw(out, t.iv.p, 12)
mut s := t.seq
mut i := 11
until i >= 4:
_bput(out.p, i, _bget(out.p, i) ^ ((s & (0xFF as u64)) as int))
s >>= (8 as u64)
i--
end
end
func _tk_advance(t &: TrafficKeys): bool:
if t.seq == (18446744073709551615 as u64):
ret false
end
t.seq++
ret true
end
func _aead_seal(t: TrafficKeys, nonce: Buf, aad: void*, aadlen: int, pt: void*, ct: void*, n: int, tag: void*):
if t.cipher == CIPHER_CHACHA20_SHA256:
_cha20poly_seal(t.key.p, nonce.p, aad, aadlen, pt, ct, n, tag)
ret
end
_gcm_seal_with(t.gcm.aes, t.gcm.g, nonce.p, aad, aadlen, pt, ct, n, tag)
end
func _aead_open(t: TrafficKeys, nonce: Buf, aad: void*, aadlen: int, ct: void*, n: int, tag: void*, pt: void*): bool:
if t.cipher == CIPHER_CHACHA20_SHA256:
ret _cha20poly_open(t.key.p, nonce.p, aad, aadlen, ct, n, tag, pt)
end
ret _gcm_open_with(t.gcm.aes, t.gcm.g, nonce.p, aad, aadlen, ct, n, tag, pt)
end
package tls
const LEG_MD5_LEN := 16
const LEG_SHA1_LEN := 20
func _legacy_hmac(use_sha1: bool, key: void*, klen: int, msg: void*, mlen: int, out: void*):
mut hlen := LEG_MD5_LEN
if use_sha1:
hlen = LEG_SHA1_LEN
end
mut k0 := _newbuf(64)
defer _buf_wipe(k0)
if klen > 64:
_putzeros(k0, hlen)
if use_sha1:
crypto.Sha1Bytes(key, klen, k0.p)
else:
crypto.Md5Bytes(key, klen, k0.p)
end
else:
_putraw(k0, key, klen)
end
until k0.len < 64:
_put8(k0, 0)
end
mut inner := _newbuf(64 + mlen)
defer _buf_wipe(inner)
repeat 64 in i:
_put8(inner, _bufat(k0, i) ^ 0x36)
end
_putraw(inner, msg, mlen)
mut ih := _newbuf(hlen)
defer _buf_wipe(ih)
_putzeros(ih, hlen)
if use_sha1:
crypto.Sha1Bytes(inner.p, inner.len, ih.p)
else:
crypto.Md5Bytes(inner.p, inner.len, ih.p)
end
mut outer := _newbuf(64 + hlen)
defer _buf_wipe(outer)
repeat 64 in i:
_put8(outer, _bufat(k0, i) ^ 0x5C)
end
_putbuf(outer, ih)
if use_sha1:
crypto.Sha1Bytes(outer.p, outer.len, out)
else:
crypto.Md5Bytes(outer.p, outer.len, out)
end
end
func _legacy_p_hash(use_sha1: bool, secret: void*, slen: int, seed: Buf, out: void*, olen: int):
mut hlen := LEG_MD5_LEN
if use_sha1:
hlen = LEG_SHA1_LEN
end
mut a := _newbuf(hlen)
defer _buf_wipe(a)
_putzeros(a, hlen)
_legacy_hmac(use_sha1, secret, slen, seed.p, seed.len, a.p)
mut blk := _newbuf(hlen)
defer _buf_wipe(blk)
_putzeros(blk, hlen)
mut msg := _newbuf(hlen + seed.len)
defer _buf_free(msg)
mut done := 0
until done < olen:
_bufreset(msg)
_putbuf(msg, a)
_putbuf(msg, seed)
_legacy_hmac(use_sha1, secret, slen, msg.p, msg.len, blk.p)
mut take := olen - done
if take > hlen:
take = hlen
end
repeat take in i:
_bput(out, done + i, _bufat(blk, i))
end
done += take
_legacy_hmac(use_sha1, secret, slen, a.p, hlen, a.p)
end
end
func _legacy_prf(secret: void*, slen: int, label: str, seed: Buf, out: void*, olen: int):
half := (slen + 1) / 2
s1 := secret
s2 := ((secret as i64) + ((slen - half) as i64)) as void*
mut ls := _newbuf(label.len() + seed.len)
defer _buf_free(ls)
_putstr(ls, label)
_putbuf(ls, seed)
_legacy_p_hash(false, s1, half, ls, out, olen)
mut tmp := _newbuf(olen)
defer _buf_wipe(tmp)
_putzeros(tmp, olen)
_legacy_p_hash(true, s2, half, ls, tmp.p, olen)
repeat olen in i:
_bput(out, i, _bget(out, i) ^ _bufat(tmp, i))
end
end
package tls
import mem
const MLKEM_Q := 3329
const MLKEM_EK_LEN := 1184
const MLKEM_CT_LEN := 1088
func _mk_pow(base: int, e: int): int:
mut r := 1
mut b := base % MLKEM_Q
mut k := e
until k > 0:
if (k & 1) == 1:
r = (r * b) % MLKEM_Q
end
b = (b * b) % MLKEM_Q
