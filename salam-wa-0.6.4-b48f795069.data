inline func _sha2_rotr32(x: u32, n: u32): u32:
ret (x >> n) | (x << ((32 as u32) - n))
end
func _sha256_init(): Sha256:
mut s := Sha256 {}
repeat 8 in i:
s.h[i] = SHA2_IV256[i]
end
s.blen = 0
s.total = 0 as u64
ret s
end
func _sha256_block(s &: Sha256):
mut w: u32[64]
repeat 16 in t:
o := t * 4
w[t] = ((s.blk[o] as u32) << (24 as u32)) | ((s.blk[o + 1] as u32) << (16 as u32)) | ((s.blk[o + 2] as u32) << (8 as u32)) | (s.blk[o + 3] as u32)
end
repeat 48 in k:
t := k + 16
x15 := w[t - 15]
x2 := w[t - 2]
s0 := _sha2_rotr32(x15, 7 as u32) ^ _sha2_rotr32(x15, 18 as u32) ^ (x15 >> (3 as u32))
s1 := _sha2_rotr32(x2, 17 as u32) ^ _sha2_rotr32(x2, 19 as u32) ^ (x2 >> (10 as u32))
w[t] = w[t - 16] + s0 + w[t - 7] + s1
end
mut a := s.h[0]
mut b := s.h[1]
mut c := s.h[2]
mut d := s.h[3]
mut e := s.h[4]
mut f := s.h[5]
mut g := s.h[6]
mut hh := s.h[7]
repeat 64 in t:
bigs1 := _sha2_rotr32(e, 6 as u32) ^ _sha2_rotr32(e, 11 as u32) ^ _sha2_rotr32(e, 25 as u32)
ch := (e & f) ^ ((~e) & g)
t1 := hh + bigs1 + ch + SHA2_K256[t] + w[t]
bigs0 := _sha2_rotr32(a, 2 as u32) ^ _sha2_rotr32(a, 13 as u32) ^ _sha2_rotr32(a, 22 as u32)
maj := (a & b) ^ (a & c) ^ (b & c)
t2 := bigs0 + maj
hh = g
g = f
f = e
e = d + t1
d = c
c = b
b = a
a = t1 + t2
end
s.h[0] += a
s.h[1] += b
s.h[2] += c
s.h[3] += d
s.h[4] += e
s.h[5] += f
s.h[6] += g
s.h[7] += hh
end
func _sha256_update(s &: Sha256, p: void*, n: int):
mut i := 0
until i < n:
space := SHA2_SHA256_BLOCK - s.blen
mut take := n - i
if take > space:
take = space
end
repeat take in j:
s.blk[s.blen + j] = _bget(p, i + j) as u8
end
s.blen += take
i += take
s.total += take as u64
if s.blen == SHA2_SHA256_BLOCK:
_sha256_block(s)
s.blen = 0
end
end
end
func _sha256_final(s0: Sha256, out: void*):
mut s := s0
bits := s.total * (8 as u64)
s.blk[s.blen] = 0x80 as u8
s.blen++
if s.blen > 56:
until s.blen < SHA2_SHA256_BLOCK:
s.blk[s.blen] = 0 as u8
s.blen++
end
_sha256_block(s)
s.blen = 0
end
until s.blen < 56:
s.blk[s.blen] = 0 as u8
s.blen++
end
repeat 8 in i:
sh := ((7 - i) * 8) as u64
s.blk[56 + i] = ((bits >> sh) & (0xFF as u64)) as u8
end
_sha256_block(s)
repeat 8 in i:
v := s.h[i]
_bput(out, i * 4, ((v >> (24 as u32)) & (0xFF as u32)) as int)
_bput(out, i * 4 + 1, ((v >> (16 as u32)) & (0xFF as u32)) as int)
_bput(out, i * 4 + 2, ((v >> (8 as u32)) & (0xFF as u32)) as int)
_bput(out, i * 4 + 3, (v & (0xFF as u32)) as int)
end
end
inline func _sha2_rotr64(x: u64, n: u64): u64:
ret (x >> n) | (x << ((64 as u64) - n))
end
func _sha512_init_with(iv: u64[8], outlen: int): Sha512:
mut s := Sha512 {}
repeat 8 in i:
s.h[i] = iv[i]
end
s.blen = 0
s.total = 0 as u64
s.outlen = outlen
ret s
end
func _sha512_init(): Sha512:
ret _sha512_init_with(SHA2_IV512, SHA2_SHA512_SIZE)
end
func _sha384_init(): Sha512:
ret _sha512_init_with(SHA2_IV384, SHA2_SHA384_SIZE)
end
func _sha512_block(s &: Sha512):
mut w: u64[80]
repeat 16 in t:
o := t * 8
mut v := 0 as u64
repeat 8 in j:
v = (v << (8 as u64)) | (s.blk[o + j] as u64)
end
w[t] = v
end
repeat 64 in k:
t := k + 16
x15 := w[t - 15]
x2 := w[t - 2]
s0 := _sha2_rotr64(x15, 1 as u64) ^ _sha2_rotr64(x15, 8 as u64) ^ (x15 >> (7 as u64))
s1 := _sha2_rotr64(x2, 19 as u64) ^ _sha2_rotr64(x2, 61 as u64) ^ (x2 >> (6 as u64))
w[t] = w[t - 16] + s0 + w[t - 7] + s1
end
mut a := s.h[0]
mut b := s.h[1]
mut c := s.h[2]
mut d := s.h[3]
mut e := s.h[4]
mut f := s.h[5]
mut g := s.h[6]
mut hh := s.h[7]
repeat 80 in t:
bigs1 := _sha2_rotr64(e, 14 as u64) ^ _sha2_rotr64(e, 18 as u64) ^ _sha2_rotr64(e, 41 as u64)
ch := (e & f) ^ ((~e) & g)
t1 := hh + bigs1 + ch + SHA2_K512[t] + w[t]
bigs0 := _sha2_rotr64(a, 28 as u64) ^ _sha2_rotr64(a, 34 as u64) ^ _sha2_rotr64(a, 39 as u64)
maj := (a & b) ^ (a & c) ^ (b & c)
t2 := bigs0 + maj
hh = g
g = f
f = e
e = d + t1
d = c
c = b
b = a
a = t1 + t2
end
s.h[0] += a
s.h[1] += b
s.h[2] += c
s.h[3] += d
s.h[4] += e
s.h[5] += f
s.h[6] += g
s.h[7] += hh
end
func _sha512_update(s &: Sha512, p: void*, n: int):
mut i := 0
until i < n:
space := SHA2_SHA512_BLOCK - s.blen
mut take := n - i
if take > space:
take = space
end
repeat take in j:
s.blk[s.blen + j] = _bget(p, i + j) as u8
end
s.blen += take
i += take
s.total += take as u64
if s.blen == SHA2_SHA512_BLOCK:
_sha512_block(s)
s.blen = 0
end
end
end
func _sha512_final(s0: Sha512, out: void*):
mut s := s0
bits := s.total * (8 as u64)
s.blk[s.blen] = 0x80 as u8
s.blen++
if s.blen > 112:
until s.blen < SHA2_SHA512_BLOCK:
s.blk[s.blen] = 0 as u8
s.blen++
end
_sha512_block(s)
s.blen = 0
end
until s.blen < 112:
s.blk[s.blen] = 0 as u8
s.blen++
end
repeat 8 in i:
s.blk[112 + i] = 0 as u8
end
repeat 8 in i:
sh := ((7 - i) * 8) as u64
s.blk[120 + i] = ((bits >> sh) & (0xFF as u64)) as u8
end
_sha512_block(s)
n := s.outlen
repeat n in i:
word := s.h[i / 8]
sh := ((7 - (i % 8)) * 8) as u64
_bput(out, i, ((word >> sh) & (0xFF as u64)) as int)
end
end
func _sha256(p: void*, n: int, out: void*):
mut s := _sha256_init()
_sha256_update(s, p, n)
_sha256_final(s, out)
end
func _sha384(p: void*, n: int, out: void*):
mut s := _sha384_init()
_sha512_update(s, p, n)
_sha512_final(s, out)
end
func _sha512(p: void*, n: int, out: void*):
mut s := _sha512_init()
_sha512_update(s, p, n)
_sha512_final(s, out)
end
@en "Sha256Bytes"
@fa "شا۲۵۶ بایت"
pub func Sha256Bytes(p: void*, n: int, out: void*):
_sha256(p, n, out)
end
@en "Sha384Bytes"
@fa "شا۳۸۴ بایت"
pub func Sha384Bytes(p: void*, n: int, out: void*):
_sha384(p, n, out)
end
@en "Sha512Bytes"
@fa "شا۵۱۲ بایت"
pub func Sha512Bytes(p: void*, n: int, out: void*):
_sha512(p, n, out)
end
@en "Sha256New"
@fa "شا۲۵۶ جدید"
pub func Sha256New(): Sha256:
ret _sha256_init()
end
@en "Sha256Update"
@fa "به روز رسانی شا۲۵۶"
pub func Sha256Update(s &: Sha256, p: void*, n: int):
_sha256_update(s, p, n)
end
@en "Sha256Final"
@fa "نهایی شا۲۵۶"
pub func Sha256Final(s: Sha256, out: void*):
_sha256_final(s, out)
end
@en "Sha384New"
@fa "شا۳۸۴ جدید"
pub func Sha384New(): Sha512:
ret _sha384_init()
end
@en "Sha512New"
@fa "شا۵۱۲ جدید"
pub func Sha512New(): Sha512:
ret _sha512_init()
end
@en "Sha512Update"
@fa "به روز رسانی شا۵۱۲"
pub func Sha512Update(s &: Sha512, p: void*, n: int):
_sha512_update(s, p, n)
end
@en "Sha512Final"
@fa "نهایی شا۵۱۲"
pub func Sha512Final(s: Sha512, out: void*):
_sha512_final(s, out)
end
package crypto
@en "Sha256Hex"
@fa "شا۲۵۶ شانزدهی"
pub func Sha256Hex(data: str): str:
dlen := data.len()
out := mem.Allocate(32 as u64)
defer mem.Free(out)
_sha256_core(data as void*, dlen, out)
mut result := ""
repeat 8 in i:
base := i * 4
w := (_bget(out, base) as i64) * 16777216 + (_bget(out, base + 1) as i64) * 65536 + (_bget(out, base + 2) as i64) * 256 + (_bget(out, base + 3) as i64)
result = result.concat(_hex32(w))
end
ret result
end
package crypto
@en "Sha512Hex"
@fa "شا۵۱۲ شانزدهی"
pub func Sha512Hex(data: str): str:
dlen := data.len()
out := mem.Allocate(64 as u64)
defer mem.Free(out)
_sha512_core(data as void*, dlen, out)
mut result := ""
repeat 16 in i:
base := i * 4
w := (_bget(out, base) as i64) * 16777216 + (_bget(out, base + 1) as i64) * 65536 + (_bget(out, base + 2) as i64) * 256 + (_bget(out, base + 3) as i64)
result = result.concat(_hex32(w))
end
ret result
end
@en "ctx"
@fa "زمینه"
package ctx
import mem
import sync
@en "Context"
@fa "زمینه"
pub struct Context:
@en "state"
@fa "وضعیت"
pub state: i64* = null
@en "parent"
@fa "والد"
pub parent: Context* = null
@en "mu"
@fa "قفل"
pub mu: sync.Mutex = sync.Mutex {}
@en "cv"
@fa "متغیر شرطی"
pub cv: sync.CondVar = sync.CondVar {}
@en "is_root"
@fa "ریشه است"
pub is_root: bool = false
end
func done_chain(c: Context, reason &: int): bool:
mut cur := c
until true:
s := cur.state
if s[0] != 0:
reason = 1
ret true
end
if s[2] != 0 and sync.NowMs() >= s[1]:
reason = 2
ret true
end
if cur.parent == null:
break
end
cur = cur.parent[0]
end
reason = 0
ret false
end
func nearest_deadline(c: Context): i64:
mut cur := c
mut best := 0 as i64
until true:
s := cur.state
if s[2] != 0:
if best == 0 or s[1] < best:
best = s[1]
end
end
if cur.parent == null:
break
end
cur = cur.parent[0]
end
ret best
end
func child_of(parent: Context, deadline: i64, has_deadline: bool): Context:
p := mem.AllocateZeroed(sizeof(Context) as u64) as Context*
p[0] = parent
st := mem.AllocateZeroed(24 as u64) as i64*
if has_deadline:
st[1] = deadline
st[2] = 1
end
ret Context { state = st, parent = p, mu = parent.mu, cv = parent.cv, is_root = false }
end
@en "Background"
@fa "پس زمینه"
pub func Background(): Context:
st := mem.AllocateZeroed(24 as u64) as i64*
ret Context {
state = st, parent = null, mu = sync.NewMutex(), cv = sync.NewCondVar(), is_root = true
}
end
@en "WithCancel"
@fa "با لغو"
pub func WithCancel(parent: Context): Context:
ret child_of(parent, 0 as i64, false)
end
@en "WithTimeout"
@fa "با مهلت"
pub func WithTimeout(parent: Context, ms: i64): Context:
ret child_of(parent, sync.NowMs() + ms, true)
end
@en "WithDeadline"
@fa "با موعد"
pub func WithDeadline(parent: Context, at_ms: i64): Context:
ret child_of(parent, at_ms, true)
end
@en "Cancel"
@fa "لغو"
pub func Cancel(c: Context):
s := c.state
sync.Lock(c.mu)
s[0] = 1
sync.Broadcast(c.cv)
sync.Unlock(c.mu)
end
@en "IsDone"
@fa "تمام شده"
pub func IsDone(c: Context): bool:
mut why := 0
sync.Lock(c.mu)
r := done_chain(c, why)
sync.Unlock(c.mu)
ret r
end
@en "Err"
@fa "خطا"
pub func Err(c: Context): str:
mut why := 0
sync.Lock(c.mu)
_ := done_chain(c, why)
sync.Unlock(c.mu)
if why == 1:
ret "cancelled"
end
if why == 2:
ret "deadline exceeded"
end
ret ""
end
@en "Deadline"
@fa "موعد"
pub func Deadline(c: Context): i64:
sync.Lock(c.mu)
d := nearest_deadline(c)
sync.Unlock(c.mu)
ret d
end
@en "Wait"
@fa "انتظار"
pub func Wait(c: Context, ms: i64): bool:
mut why := 0
sync.Lock(c.mu)
until_ms := sync.NowMs() + ms
mut fin := done_chain(c, why)
until not fin:
mut left := until_ms - sync.NowMs()
dl := nearest_deadline(c)
if dl > 0:
dleft := dl - sync.NowMs()
if dleft < left:
left = dleft
end
end
if left <= 0:
break
end
_ := sync.WaitCondTimeout(c.cv, c.mu, left)
fin = done_chain(c, why)
end
sync.Unlock(c.mu)
ret fin
end
@en "Free"
@fa "آزادسازی"
pub func Free(c: Context):
mem.Free(c.state as void*)
if c.parent != null:
mem.Free(c.parent as void*)
end
if c.is_root:
sync.DestroyCondVar(c.cv)
sync.Destroy(c.mu)
end
end
@en "data"
@fa "داده"
package data
@en "COL_FLOAT"
@fa "ستون اعشاری"
pub const COL_FLOAT := 0
@en "COL_INT"
@fa "ستون صحیح"
pub const COL_INT := 1
@en "COL_CAT"
@fa "ستون رده‌ای"
pub const COL_CAT := 2
@en "COL_STR"
@fa "ستون رشته‌ای"
pub const COL_STR := 3
package data
import conv
import encoding.csv
import io
import mem
import math
import matrix
import os
import str
@en "Table"
@fa "جدول"
pub struct Table:
@en "names"
@fa "نام‌ها"
pub names: Vector<str> = Vector {}
@en "kinds"
@fa "گونه‌ها"
pub kinds: Vector<int> = Vector {}
@en "cats"
@fa "سطح‌ها"
pub cats: Vector<Vector<str>> = Vector {}
@en "raw"
@fa "متن خام"
pub raw: Vector<Vector<str>> = Vector {}
@en "cells"
@fa "خانه‌ها"
pub cells: matrix.Matrix = matrix.Matrix {}
@en "rows"
@fa "سطرها"
pub func rows(): int: ret this.cells.rows end
@en "cols"
@fa "ستون‌ها"
pub func cols(): int: ret this.names.len() end
@en "col_index"
@fa "نمایه ستون"
pub func col_index(name: str): int:
repeat this.names.len() in j:
if str.Equals(this.names.get(j), name): ret j end
end
ret 0 - 1
end
@en "cat_levels"
@fa "سطوح رده‌ای"
pub func cat_levels(name: str): Vector<str>:
mut out := Vector {} as Vector<str>
j := this.col_index(name)
if j < 0 or this.kinds.get(j) != COL_CAT: ret out end
lv := this.cats.get(j)
repeat lv.len() in i: out.push(lv.get(i)) end
ret out
end
@en "to_matrix"
@fa "به ماتریس"
pub func to_matrix(): matrix.Matrix:
mut keep := Vector {} as Vector<int>
repeat this.kinds.len() in j:
if this.kinds.get(j) != COL_STR: keep.push(j) end
end
r := _select_cols(this.cells, keep)
keep.free()
ret r
end
@en "split_xy"
@fa "جداسازی ویژگی از برچسب"
pub func split_xy(label: str, x &: matrix.Matrix, y &: matrix.Matrix): bool:
lj := this.col_index(label)
if lj < 0 or this.kinds.get(lj) == COL_STR: ret false end
mut keep := Vector {} as Vector<int>
repeat this.kinds.len() in j:
if j != lj and this.kinds.get(j) != COL_STR: keep.push(j) end
end
matrix.Free(x)
matrix.Free(y)
x = _select_cols(this.cells, keep)
mut one := Vector {} as Vector<int>
one.push(lj)
y = _select_cols(this.cells, one)
keep.free()
one.free()
ret true
end
@en "free"
@fa "آزادسازی"
pub func free():
repeat this.names.len() in j: mem.Free(this.names.get(j) as void*) end
this.names.free()
this.kinds.free()
repeat this.cats.len() in j:
mut lv := this.cats.get(j)
_free_strs(lv)
end
this.cats.free()
repeat this.raw.len() in j:
mut rv := this.raw.get(j)
_free_strs(rv)
end
this.raw.free()
matrix.Free(this.cells)
end
end
inline pure func _bp(s: str): i8*: ret (s as void*) as i8* end
inline pure func _ub(bp: i8*, i: int): int:
mut v := bp[i] as int
if v < 0: v += 256 end
ret v
end
func _free_strs(v &: Vector<str>):
repeat v.len() in i: mem.Free(v.get(i) as void*) end
v.free()
end
func _trim(s: str): str:
mid := str.TrimRight(s)
out := str.TrimLeft(mid)
mem.Free(mid as void*)
ret out
end
func _is_number(s: str, whole &: bool): bool:
n := str.Len(s)
bp := _bp(s)
mut i := 0
if i < n and (_ub(bp, i) == 43 or _ub(bp, i) == 45): i++ end
mut digits := 0
until i < n and _ub(bp, i) >= 48 and _ub(bp, i) <= 57:
i++
digits++
end
whole = true
if i < n and _ub(bp, i) == 46:
whole = false
i++
until i < n and _ub(bp, i) >= 48 and _ub(bp, i) <= 57:
i++
digits++
end
end
if digits == 0: ret false end
if i < n and (_ub(bp, i) == 101 or _ub(bp, i) == 69):
whole = false
i++
if i < n and (_ub(bp, i) == 43 or _ub(bp, i) == 45): i++ end
mut ed := 0
until i < n and _ub(bp, i) >= 48 and _ub(bp, i) <= 57:
i++
ed++
end
if ed == 0: ret false end
end
ret i == n
end
func _select_cols(cells &: matrix.Matrix, keep &: Vector<int>): matrix.Matrix:
mut r := matrix.Zeros(cells.rows, keep.len())
repeat cells.rows in i:
repeat keep.len() in t: r.set(i, t, cells.at(i, keep.get(t))) end
end
ret r
end
func _level_index(levels &: Vector<str>, v: str): int:
repeat levels.len() in i:
if str.Equals(levels.get(i), v): ret i end
end
ret 0 - 1
end
@en "LoadCsv"
@fa "بارگذاری سی‌اس‌وی"
pub func LoadCsv(text: str, header: bool): Table throws:
mut t := Table {}
mut parsed := try csv.ReadAll(text)
total := parsed.rows.len()
if total == 0: ret t end
mut first := 0
ncols := parsed.rows.get(0).fields.len()
if header:
hdr := parsed.rows.get(0)
repeat ncols in j: t.names.push(_trim(hdr.fields.get(j))) end
first = 1
else:
repeat ncols in j: t.names.push("col" + j) end
end
n := total - first
t.cells = matrix.Zeros(n, ncols)
nan := math.NaN()
repeat ncols in j:
mut all_int := true
mut all_num := true
mut levels := Vector {} as Vector<str>
mut texts := Vector {} as Vector<str>
repeat n in i:
row := parsed.rows.get(first + i)
mut cell := ""
if j < row.fields.len(): cell = _trim(row.fields.get(j)) end
texts.push(cell)
if str.Len(cell) > 0:
mut whole := false
if _is_number(cell, whole):
if whole == false: all_int = false end
else:
all_int = false
all_num = false
end
end
if _level_index(levels, cell) < 0: levels.push(str.Clone(cell)) end
end
mut kind := COL_STR
if all_num:
kind = COL_FLOAT
if all_int: kind = COL_INT end
else:
mut cap := n / 10
if cap < 20: cap = 20 end
if levels.len() <= cap and levels.len() < n: kind = COL_CAT end
end
t.kinds.push(kind)
repeat n in i:
cell := texts.get(i)
mut v := nan
if kind == COL_CAT:
v = _level_index(levels, cell) as f64
else kind != COL_STR:
if str.Len(cell) > 0: v = conv.ParseFloatOr(cell, nan) end
end
t.cells.set(i, j, v)
end
if kind == COL_CAT:
t.cats.push(levels)
else:
_free_strs(levels)
t.cats.push(Vector {} as Vector<str>)
end
if kind == COL_STR:
t.raw.push(texts)
else:
_free_strs(texts)
t.raw.push(Vector {} as Vector<str>)
end
end
csv.FreeTable(parsed)
ret t
end
@en "LoadCsvFile"
@fa "بارگذاری پرونده سی‌اس‌وی"
pub func LoadCsvFile(path: str, header: bool): Table throws:
if os.Exists(path) == false:
throw Error.New(ErrorKind.NotFound, "file not found").with_path(path)
end
text := io.ReadFile(path)
defer mem.Free(text as void*)
try:
ret LoadCsv(text, header)
catch e:
throw e.with_path(path)
end
end
package data
import matrix
import ai.tensor
@en "BatchIter"
@fa "پیمایشگر دسته"
pub struct BatchIter:
@en "x"
@fa "ویژگی‌ها"
pub x: matrix.Matrix = matrix.Matrix {}
@en "y"
@fa "برچسب‌ها"
pub y: matrix.Matrix = matrix.Matrix {}
@en "batch"
@fa "اندازه دسته"
pub batch: int = 32
@en "shuffle"
@fa "درهم‌ریزی"
pub shuffle: bool = true
@en "seed"
@fa "بذر"
pub seed: i64 = 0
@en "order"
@fa "ترتیب"
pub order: Vector<int> = Vector {}
@en "pos"
@fa "جایگاه"
pub pos: int = 0
@en "reset"
@fa "بازنشانی"
pub func reset(epoch: i64):
n := this.x.rows
this.order.clear()
repeat n in i: this.order.push(i) end
if this.shuffle:
mut g := matrix.NewRng(this.seed + epoch)
mut i := n - 1
until i > 0:
j := (g.next_float() * ((i + 1) as f64)) as int
t := this.order.get(i)
this.order.set(i, this.order.get(j))
this.order.set(j, t)
i--
end
end
this.pos = 0
end
@en "next"
@fa "بعدی"
pub func next(x_out &: matrix.Matrix, y_out &: matrix.Matrix): bool:
n := this.order.len()
if this.pos >= n: ret false end
mut cnt := this.batch
if this.pos + cnt > n: cnt = n - this.pos end
matrix.Free(x_out)
matrix.Free(y_out)
x_out = matrix.Zeros(cnt, this.x.cols)
y_out = matrix.Zeros(cnt, this.y.cols)
repeat cnt in i:
src := this.order.get(this.pos + i)
repeat this.x.cols in j: x_out.set(i, j, this.x.at(src, j)) end
repeat this.y.cols in j: y_out.set(i, j, this.y.at(src, j)) end
end
this.pos += cnt
ret true
end
@en "next_tensor"
@fa "بعدی تانسور"
pub func next_tensor(x_out &: tensor.Tensor, labels_out &: Vector<int>): bool:
n := this.order.len()
if this.pos >= n: ret false end
mut cnt := this.batch
if this.pos + cnt > n: cnt = n - this.pos end
x_out.free()
x_out = tensor.Zeros2(cnt, this.x.cols)
labels_out.clear()
p := x_out.data.data
repeat cnt in i:
src := this.order.get(this.pos + i)
repeat this.x.cols in j: p[i * this.x.cols + j] = this.x.at(src, j) as f32 end
labels_out.push(this.y.at(src, 0) as int)
end
this.pos += cnt
ret true
end
@en "batches_per_epoch"
@fa "شمار دسته در دور"
pub func batches_per_epoch(): int:
n := this.x.rows
if this.batch <= 0: ret 0 end
ret (n + this.batch - 1) / this.batch
end
@en "free"
@fa "آزادسازی"
pub func free(): this.order.free() end
end
@en "MatrixDataset"
@fa "مجموعه‌داده ماتریسی"
pub struct MatrixDataset:
@en "x"
@fa "ویژگی‌ها"
pub x: matrix.Matrix = matrix.Matrix {}
@en "y"
@fa "برچسب‌ها"
pub y: matrix.Matrix = matrix.Matrix {}
@en "len"
@fa "طول"
pub func len(): int: ret this.x.rows end
@en "batches"
@fa "دسته‌ها"
pub func batches(batch: int, shuffle: bool, seed: i64): BatchIter:
mut it := BatchIter {}
it.x = this.x
it.y = this.y
it.batch = batch
it.shuffle = shuffle
it.seed = seed
it.reset(0)
ret it
end
@en "free"
@fa "آزادسازی"
pub func free():
matrix.Free(this.x)
matrix.Free(this.y)
end
end
@en "XTensor"
@fa "تانسور ویژگی"
pub func XTensor(x &: matrix.Matrix): tensor.Tensor:
ret tensor.FromMatrix(x)
end
@en "YLabels"
@fa "برچسب‌ها"
pub func YLabels(y &: matrix.Matrix): Vector<int>:
mut out := Vector {} as Vector<int>
repeat y.rows in i: out.push(y.at(i, 0) as int) end
ret out
end
package data
import archive
import compress
import encoding.binary
import matrix
const _IDX_U8 := 8
const _IDX_I8 := 9
const _IDX_I16 := 11
const _IDX_I32 := 12
const _IDX_F32 := 13
const _IDX_F64 := 14
func _idx_elem(rd &: compress.ByteReader, kind: int): f64 throws:
if kind == _IDX_U8: ret (try binary.ReadU8(rd)) as f64 end
if kind == _IDX_I8:
mut v := try binary.ReadU8(rd)
if v >= 128: v -= 256 end
ret v as f64
end
if kind == _IDX_I16:
mut v := try binary.ReadU16BE(rd)
if v >= 32768: v -= 65536 end
ret v as f64
end
if kind == _IDX_I32: ret (try binary.ReadU32BE(rd)) as f64 end
if kind == _IDX_F32: ret try binary.ReadF32(rd, true) end
ret try binary.ReadF64(rd, true)
end
func _idx_size(kind: int): int:
if kind == _IDX_U8 or kind == _IDX_I8: ret 1 end
if kind == _IDX_I16: ret 2 end
if kind == _IDX_I32 or kind == _IDX_F32: ret 4 end
ret 8
end
func _idx_err(kind: ErrorKind, msg: str, at: int, code: str): Error:
ret Error.At(kind, msg, at).with_code(code)
end
func _parse_idx(p: void*, n: int): matrix.Matrix throws:
mut rd := compress.NewByteReader(p, n)
z0 := try binary.ReadU8(rd)
z1 := try binary.ReadU8(rd)
if z0 != 0 or z1 != 0:
throw _idx_err(ErrorKind.Syntax, "not an IDX file (the first two bytes must be zero)", 0, "idx.bad_magic")
end
kind := try binary.ReadU8(rd)
ndim := try binary.ReadU8(rd)
if kind != _IDX_U8 and kind != _IDX_I8 and kind != _IDX_I16 and kind != _IDX_I32 and kind != _IDX_F32 and kind != _IDX_F64:
throw _idx_err(ErrorKind.Unsupported, "unknown IDX element type " + kind, 2, "idx.type")
end
if ndim < 1 or ndim > 4:
throw _idx_err(ErrorKind.Unsupported, "IDX files with " + ndim + " dimensions are not supported (1 to 4)", 3, "idx.ndim")
end
rows := try binary.ReadU32BE(rd)
mut inner := 1
repeat ndim - 1: inner *= (try binary.ReadU32BE(rd)) end
if rows < 0 or inner < 0:
throw _idx_err(ErrorKind.OutOfRange, "the dimensions are too large", 4, "idx.size")
end
need := (rows as i64) * (inner as i64) * (_idx_size(kind) as i64)
if (compress.RdLeft(rd) as i64) < need:
throw _idx_err(ErrorKind.UnexpectedEnd, "the data ends early: " + need + " bytes needed, " + compress.RdLeft(rd) + " left", rd.pos, "idx.truncated")
end
mut m := matrix.Zeros(rows, inner)
repeat rows * inner in k: m.a.set(k, try _idx_elem(rd, kind)) end
ret m
end
@en "ParseIdx"
@fa "تجزیه آی‌دی‌ایکس"
pub func ParseIdx(p: void*, n: int): matrix.Matrix throws:
try:
ret _parse_idx(p, n)
catch e:
throw e.wrap("idx")
end
end
@en "LoadIdx"
@fa "بارگذاری آی‌دی‌ایکس"
pub func LoadIdx(path: str): matrix.Matrix throws:
mut fok := false
mut raw := archive.ReadBinaryFile(path, fok)
defer compress.BufFree(raw)
if fok == false:
throw Error.New(ErrorKind.NotFound, "cannot open file").with_path(path).wrap("idx")
end
n := compress.BufLen(raw)
try:
if n >= 2 and compress.BufGet(raw, 0) == 31 and compress.BufGet(raw, 1) == 139:
mut zok := false
mut plain := compress.GzipDecompressBuf(raw, zok)
defer compress.BufFree(plain)
if zok == false:
throw Error.New(ErrorKind.Syntax, "the gzip stream is damaged").with_code("idx.gzip")
end
ret _parse_idx(plain.data, compress.BufLen(plain))
end
ret _parse_idx(raw.data, n)
catch e:
throw e.with_path(path).wrap("idx")
end
end
@en "LoadMnist"
@fa "بارگذاری ام‌نیست"
pub func LoadMnist(images_path: str, labels_path: str, x &: matrix.Matrix, y &: matrix.Matrix) throws:
mut xi := try LoadIdx(images_path)
mut yl := matrix.Matrix {}
try:
yl = LoadIdx(labels_path)
catch e:
matrix.Free(xi)
throw e
end
if yl.rows != xi.rows:
rows_x := xi.rows
rows_y := yl.rows
matrix.Free(xi)
matrix.Free(yl)
throw Error.New(ErrorKind.InvalidArgument, "the images have " + rows_x + " rows but the labels have " + rows_y).with_code("idx.mismatch").wrap("mnist")
end
matrix.ScaleInPlace(xi, 1.0 / 255.0)
matrix.Free(x)
matrix.Free(y)
x = xi
y = yl
end
package data
import filepath
import ai.image
import os
import str
import ai.tensor
inline pure func _sbp(s: str): i8*: ret (s as void*) as i8* end
inline pure func _sub(bp: i8*, i: int): int:
mut v := bp[i] as int
if v < 0: v += 256 end
ret v
end
func _str_less(a: str, b: str): bool:
na := str.Len(a)
nb := str.Len(b)
pa := _sbp(a)
pb := _sbp(b)
mut i := 0
until i < na and i < nb:
ca := _sub(pa, i)
cb := _sub(pb, i)
if ca != cb: ret ca < cb end
i++
end
ret na < nb
end
func _sort_names(v &: Vector<str>):
n := v.len()
mut i := 1
until i < n:
key := v.get(i)
mut j := i - 1
until j >= 0 and _str_less(key, v.get(j)):
v.set(j + 1, v.get(j))
j--
end
v.set(j + 1, key)
i++
end
end
func _listing(dir: str): Vector<str>:
mut raw := os.ListDir(dir)
mut out := Vector {} as Vector<str>
repeat raw.len() in i:
e := raw.get(i)
if str.Equals(e, ".") or str.Equals(e, ".."): continue end
if os.Exists(e) and str.StartsWith(e, dir):
out.push(e)
else:
out.push(filepath.Join(dir, e))
end
end
raw.free()
_sort_names(out)
ret out
end
func _base_name(path: str): str:
n := str.Len(path)
bp := _sbp(path)
mut i := n - 1
until i >= 0 and _sub(bp, i) != 47 and _sub(bp, i) != 92: i-- end
ret str.Substr(path, i + 1, n - i - 1)
end
func _pack(img: image.Image, p: f32*, s: int, c: int, h: int, w: int):
inv := (1.0 / 255.0) as f32
repeat h in y:
repeat w in x:
px := image.GetPixel(img, x, y)
r := (px.r as int) as f32
g := (px.g as int) as f32
b := (px.b as int) as f32
base := s * c * h * w
if c == 1:
lum := (0.299 as f32) * r + (0.587 as f32) * g + (0.114 as f32) * b
p[base + y * w + x] = lum * inv
else:
p[base + y * w + x] = r * inv
p[base + h * w + y * w + x] = g * inv
p[base + 2 * h * w + y * w + x] = b * inv
end
end
end
end
@en "LoadImageFolder"
@fa "بارگذاری پوشه تصویر"
pub func LoadImageFolder(root: str, width: int, height: int, gray: bool, x &: tensor.Tensor, labels &: Vector<int>, classes &: Vector<str>): bool:
labels.clear()
classes.clear()
if width <= 0 or height <= 0 or os.IsDir(root) == false: ret false end
mut dirs := _listing(root)
mut files := Vector {} as Vector<str>
mut file_class := Vector {} as Vector<int>
repeat dirs.len() in d:
dpath := dirs.get(d)
if os.IsDir(dpath) == false: continue end
cls := classes.len()
classes.push(_base_name(dpath))
mut inner := _listing(dpath)
repeat inner.len() in f:
if os.IsDir(inner.get(f)) == false:
files.push(inner.get(f))
file_class.push(cls)
end
end
inner.free()
end
dirs.free()
mut c := 3
if gray: c = 1 end
mut imgs := Vector {} as Vector<image.Image>
repeat files.len() in f:
mut ok := false
mut img := image.Open(files.get(f), ok)
if ok and img.width > 0 and img.height > 0:
sized := image.ResizeNearestNeighbor(img, width, height)
image.Free(img)
imgs.push(sized)
labels.push(file_class.get(f))
else:
image.Free(img)
end
end
files.free()
file_class.free()
n := imgs.len()
x.free()
if n == 0:
imgs.free()
ret false
end
x = tensor.Zeros4(n, c, height, width)
p := x.data.data
repeat n in s:
mut img := imgs.get(s)
_pack(img, p, s, c, height, width)
image.Free(img)
end
imgs.free()
ret true
end
package data
import math
import matrix
func _centers(g &: matrix.Rng, k: int, p: int): matrix.Matrix:
mut c := matrix.Zeros(k, p)
repeat k * p in i:
c.a.set(i, 0.0 - 10.0 + 20.0 * g.next_float())
end
ret c
end
@en "MakeBlobs"
@fa "ساخت خوشه‌ها"
pub func MakeBlobs(n: int, centers: int, p: int, spread: f64, seed: i64, y &: matrix.Matrix): matrix.Matrix:
if n <= 0 or centers <= 0 or p <= 0: ret matrix.Matrix {} end
mut g := matrix.NewRng(seed)
mut c := _centers(g, centers, p)
defer matrix.Free(c)
mut x := matrix.Zeros(n, p)
y = matrix.Zeros(n, 1)
repeat n in i:
cls := i % centers
y.set(i, 0, cls as f64)
repeat p in j:
x.set(i, j, c.at(cls, j) + spread * g.next_normal())
end
end
ret x
end
@en "MakeMoons"
@fa "ساخت هلال‌ها"
pub func MakeMoons(n: int, noise: f64, seed: i64, y &: matrix.Matrix): matrix.Matrix:
if n <= 0: ret matrix.Matrix {} end
mut g := matrix.NewRng(seed)
mut x := matrix.Zeros(n, 2)
y = matrix.Zeros(n, 1)
repeat n in i:
cls := i % 2
t := math.PI * g.next_float()
mut px := math.Cos(t)
mut py := math.Sin(t)
if cls == 1:
px = 1.0 - px
py = 0.5 - py
end
x.set(i, 0, px + noise * g.next_normal())
x.set(i, 1, py + noise * g.next_normal())
y.set(i, 0, cls as f64)
end
ret x
end
@en "MakeCircles"
@fa "ساخت دایره‌ها"
pub func MakeCircles(n: int, noise: f64, factor: f64, seed: i64, y &: matrix.Matrix): matrix.Matrix:
if n <= 0: ret matrix.Matrix {} end
mut g := matrix.NewRng(seed)
mut x := matrix.Zeros(n, 2)
y = matrix.Zeros(n, 1)
repeat n in i:
cls := i % 2
t := 2.0 * math.PI * g.next_float()
mut r := 1.0
if cls == 1: r = factor end
x.set(i, 0, r * math.Cos(t) + noise * g.next_normal())
x.set(i, 1, r * math.Sin(t) + noise * g.next_normal())
y.set(i, 0, cls as f64)
end
ret x
end
@en "MakeRegression"
@fa "ساخت رگرسیون"
pub func MakeRegression(n: int, p: int, noise: f64, seed: i64, y &: matrix.Matrix, true_coef &: matrix.Matrix): matrix.Matrix:
if n <= 0 or p <= 0: ret matrix.Matrix {} end
mut g := matrix.NewRng(seed)
true_coef = matrix.Zeros(p, 1)
repeat p in j:
true_coef.set(j, 0, 0.0 - 2.0 + 4.0 * g.next_float())
end
mut x := matrix.Zeros(n, p)
y = matrix.Zeros(n, 1)
repeat n in i:
mut acc := 0.0
repeat p in j:
v := g.next_normal()
x.set(i, j, v)
acc += v * true_coef.at(j, 0)
end
y.set(i, 0, acc + noise * g.next_normal())
end
ret x
end
@en "MakeClassification"
@fa "ساخت دسته‌بندی"
pub func MakeClassification(n: int, p: int, classes: int, sep: f64, seed: i64, y &: matrix.Matrix): matrix.Matrix:
if n <= 0 or p <= 0 or classes <= 0: ret matrix.Matrix {} end
mut g := matrix.NewRng(seed)
mut c := matrix.Zeros(classes, p)
repeat classes * p in i:
c.a.set(i, sep * (0.0 - 1.0 + 2.0 * g.next_float()))
end
mut x := matrix.Zeros(n, p)
y = matrix.Zeros(n, 1)
repeat n in i:
cls := i % classes
y.set(i, 0, cls as f64)
repeat p in j:
x.set(i, j, c.at(cls, j) + g.next_normal())
end
end
matrix.Free(c)
ret x
end
package clickhouse
import db
struct _DbRows:
rows: Rows = Rows {}
@en "Ok"
@fa "معتبر"
pub func Ok(): bool:
ret this.rows.Ok()
end
@en "Next"
@fa "بعدی"
pub func Next(): bool:
ret this.rows.Next()
end
@en "ColumnCount"
@fa "تعداد ستون"
pub func ColumnCount(): int:
ret this.rows.ColumnCount()
end
@en "ColumnName"
@fa "نام ستون"
pub func ColumnName(col: int): str:
ret this.rows.ColumnName(col)
end
@en "ColumnType"
@fa "نوع ستون"
pub func ColumnType(col: int): int:
if this.rows.IsNull(col): ret db.TYPE_NULL end
kind := this.rows.ColumnKind(col)
if kind == KIND_INT or kind == KIND_UINT or kind == KIND_BOOL: ret db.TYPE_INT end
if kind == KIND_FLOAT or kind == KIND_DECIMAL: ret db.TYPE_FLOAT end
ret db.TYPE_TEXT
end
@en "IsNull"
@fa "خالی است"
pub func IsNull(col: int): bool:
ret this.rows.IsNull(col)
end
@en "Text"
@fa "متن"
pub func Text(col: int): str:
ret this.rows.Text(col)
end
@en "Int"
@fa "عدد صحیح"
pub func Int(col: int): int:
ret this.rows.Int(col)
end
@en "Int64"
@fa "عدد صحیح۶۴"
pub func Int64(col: int): i64:
ret this.rows.Int64(col)
end
@en "Float"
@fa "عدد اعشار"
pub func Float(col: int): f64:
ret this.rows.Float(col)
end
@en "Close"
@fa "بستن"
pub func Close(): int:
this.rows.Close()
ret 0
end
end
struct _DbTx:
conn: Conn = Conn {}
@en "Ok"
@fa "معتبر"
pub func Ok(): bool:
ret this.conn.connected
end
@en "Exec"
@fa "اجرا"
pub func Exec(sql: str): int:
ret this.conn.ExecParams(sql, HashMap {} as HashMap<str, str>) ? 0 : -1
end
@en "Query"
@fa "پرسمان"
pub func Query(sql: str): dyn db.Rows:
ret _DbRows { rows = this.conn.QueryParams(sql, HashMap {} as HashMap<str, str>) }
end
@en "Commit"
@fa "ثبت تراکنش"
pub func Commit(): int:
ret 0
end
@en "Rollback"
@fa "بازگردانی"
pub func Rollback(): int:
ret -1
end
end
struct _DbConn:
conn: Conn = Conn {}
@en "Kind"
@fa "نوع"
pub func Kind(): str:
ret db.CLICKHOUSE
end
@en "Ok"
@fa "معتبر"
pub func Ok(): bool:
ret this.conn.connected
end
@en "Ping"
@fa "پینگ"
pub func Ping(): bool:
ret this.conn.Ping()
end
@en "Exec"
@fa "اجرا"
pub func Exec(sql: str): int:
ret this.conn.ExecParams(sql, HashMap {} as HashMap<str, str>) ? 0 : -1
end
@en "Query"
@fa "پرسمان"
pub func Query(sql: str): dyn db.Rows:
ret _DbRows { rows = this.conn.QueryParams(sql, HashMap {} as HashMap<str, str>) }
end
@en "Begin"
@fa "شروع تراکنش"
pub func Begin(): dyn db.Tx:
ret _DbTx { conn = this.conn }
end
@en "LastInsertId"
@fa "شناسه آخرین درج"
pub func LastInsertId(): i64:
ret 0
end
@en "Changes"
@fa "تعداد تغییرات"
pub func Changes(): i64:
ret this.conn.written_rows
end
@en "Error"
@fa "خطا"
pub func Error(): str:
ret this.conn.Error()
end
@en "Quote"
@fa "نقل قول"
pub func Quote(s: str): str:
ret StrArg(s)
end
@en "Close"
@fa "بستن"
pub func Close(): int:
this.conn.Close()
ret 0
end
end
@en "AsDb"
@fa "به دیتابیس"
pub func AsDb(c: Conn): dyn db.Connection:
ret _DbConn { conn = c }
end
package clickhouse
import str
import math
import conv
import encoding.json
@en "Rows"
@fa "ردیف‌ها"
pub struct Rows:
@en "names"
@fa "نام‌ها"
pub names: Vector<str> = Vector {}
@en "types"
@fa "نوع‌ها"
pub types: Vector<str> = Vector {}
@en "rows"
@fa "ردیف‌ها"
pub rows: Vector<str> = Vector {}
@en "cells"
@fa "سلول‌ها"
pub cells: Vector<str> = Vector {}
@en "pos"
@fa "جایگاه"
pub pos: int = -1
@en "total"
@fa "جمع"
pub total: i64 = 0
@en "err"
@fa "پیام خطا"
pub err: str = ""
@en "Ok"
@fa "معتبر"
pub func Ok(): bool:
ret this.err.len() == 0
end
@en "Error"
@fa "خطا"
pub func Error(): str:
ret this.err
end
@en "Next"
@fa "بعدی"
pub func Next(): bool:
if this.err.len() > 0 or this.pos + 1 >= this.rows.len(): ret false end
this.pos++
this.cells = json.Items(this.rows.get(this.pos))
ret true
end
@en "RowCount"
@fa "تعداد ردیف"
pub func RowCount(): int:
ret this.rows.len()
end
@en "ColumnCount"
@fa "تعداد ستون"
pub func ColumnCount(): int:
ret this.names.len()
end
@en "ColumnName"
@fa "نام ستون"
pub func ColumnName(col: int): str:
if col < 0 or col >= this.names.len(): ret "" end
ret this.names.get(col)
end
@en "ColumnType"
@fa "نوع ستون"
pub func ColumnType(col: int): str:
if col < 0 or col >= this.types.len(): ret "" end
ret this.types.get(col)
end
@en "ColumnKind"
@fa "دسته ستون"
pub func ColumnKind(col: int): int:
ret TypeKind(this.ColumnType(col))
end
@en "ColumnIndex"
@fa "شماره ستون"
pub func ColumnIndex(name: str): int:
repeat this.names.len() in i:
if this.names.get(i) == name: ret i end
end
ret -1
end
func _raw(col: int): str:
if col < 0 or col >= this.cells.len(): ret "" end
ret this.cells.get(col)
end
@en "Raw"
@fa "خام"
pub func Raw(col: int): str:
ret this._raw(col)
end
@en "IsNull"
@fa "تهی است"
pub func IsNull(col: int): bool:
raw := this._raw(col)
ret raw == "null" or raw.len() == 0
end
@en "Text"
@fa "متن"
pub func Text(col: int): str:
ret _cell_text(this._raw(col))
end
@en "Int64"
@fa "صحیح۶۴"
pub func Int64(col: int): i64:
ret _to_i64(_cell_text(this._raw(col)))
end
@en "Int"
@fa "صحیح"
pub func Int(col: int): int:
ret this.Int64(col) as int
end
@en "UInt64"
@fa "طبیعی۶۴"
pub func UInt64(col: int): u64:
ret _to_u64(_cell_text(this._raw(col)))
end
@en "Float"
@fa "اعشار"
pub func Float(col: int): f64:
ret _to_f64(_cell_text(this._raw(col)))
end
@en "Bool"
@fa "منطقی"
pub func Bool(col: int): bool:
t := _cell_text(this._raw(col))
ret t == "true" or t == "1"
end
@en "List"
@fa "فهرست"
pub func List(col: int): Vector<str>:
mut out := Vector {} as Vector<str>
each item in json.Items(this._raw(col)):
out.push(_cell_text(item))
end
ret out
end
@en "TextBy"
@fa "متن با نام"
pub func TextBy(name: str): str:
ret this.Text(this.ColumnIndex(name))
end
@en "Int64By"
@fa "صحیح۶۴ با نام"
pub func Int64By(name: str): i64:
ret this.Int64(this.ColumnIndex(name))
end
@en "FloatBy"
@fa "اعشار با نام"
pub func FloatBy(name: str): f64:
ret this.Float(this.ColumnIndex(name))
end
@en "Row"
@fa "ردیف"
pub func Row(): Vector<str>:
mut out := Vector {} as Vector<str>
repeat this.cells.len() in i:
out.push(this.Text(i))
end
ret out
end
@en "Close"
@fa "بستن"
pub func Close():
this.rows.free()
this.cells.free()
this.rows = Vector {} as Vector<str>
this.cells = Vector {} as Vector<str>
this.pos = -1
end
end
@en "Batch"
@fa "دسته"
pub struct Batch:
@en "head"
@fa "سرآیند"
pub head: str = ""
@en "width"
@fa "پهنا"
pub width: int = 0
@en "rows"
@fa "ردیف‌ها"
pub rows: Vector<str> = Vector {}
@en "err"
@fa "پیام خطا"
pub err: str = ""
@en "Append"
@fa "افزودن"
pub func Append(values: Vector<str>): bool:
if this.width > 0 and values.len() != this.width:
this.err = "the row has " + str.FromInt(values.len() as i64) + " values but the insert names " + str.FromInt(this.width as i64) + " columns"
ret false
end
this.rows.push("(" + str.Join(values, ", ") + ")")
ret true
end
@en "Len"
@fa "طول"
pub func Len(): int:
ret this.rows.len()
end
@en "Error"
@fa "خطا"
pub func Error(): str:
ret this.err
end
@en "Abort"
@fa "رها کردن"
pub func Abort():
this.rows.free()
this.rows = Vector {} as Vector<str>
this.err = ""
end
end
func _cell_text(raw: str): str:
if raw == "null": ret str.Clone("") end
if str.StartsWith(raw, "\""): ret json.Unquote(raw) end
ret raw
end
func _to_i64(text: str): i64:
ret conv.ParseIntOr(text, 0 as i64)
end
func _to_u64(text: str): u64:
mut out := 0 as u64
n := str.ByteLen(text)
repeat n in i:
d := "0123456789".find(str.ByteSub(text, i, 1))
if d < 0: ret 0 end
out = out * (10 as u64) + (d as u64)
end
ret out
end
func _to_f64(text: str): f64:
if text == "nan": ret math.NaN() end
if text == "inf": ret math.Inf() end
if text == "-inf": ret 0.0 - math.Inf() end
ret conv.ParseFloatOr(text, 0.0)
end
func _parse_rows(body: str): Rows:
if not json.Valid(body): ret Rows { err = "the server sent a reply that is not JSON" } end
mut r := Rows {}
each m in json.Items(json.Get(body, "meta")):
r.names.push(json.Get(m, "name"))
r.types.push(json.Get(m, "type"))
end
r.rows = json.Items(json.Get(body, "data"))
r.total = conv.ParseIntOr(json.Get(body, "rows"), 0 as i64)
ret r
end
func _new_batch(sql: str): Batch:
mut head := str.Trim(sql)
until str.EndsWith(head, ";"):
head = str.Trim(head.substr(0, head.len() - 1))
end
if str.EndsWith(head.upper(), " VALUES"):
head = str.Trim(head.substr(0, head.len() - 7))
end
if not str.StartsWith(head.upper(), "INSERT INTO "):
ret Batch { err = "a batch must start with INSERT INTO" }
end
mut width := 0
open_at := head.find("(")
if open_at >= 0:
close_at := str.IndexFrom(head, ")", open_at)
if close_at > open_at:
width = head.substr(open_at + 1, close_at - open_at - 1).split(",").len()
end
end
ret Batch { head = head, width = width }
end
package clickhouse
import str
import math
import conv
func _bind(sql: str, args: Vector<str>, good &: bool): str:
good = true
n := str.ByteLen(sql)
mut sb := str.NewBuilder()
defer str.BufFree(sb)
mut used := 0
mut i := 0
until i < n:
ch := str.ByteSub(sql, i, 1)
if ch == "'" or ch == "\"" or ch == "`":
str.BufAppend(sb, ch)
i++
until i < n:
c2 := str.ByteSub(sql, i, 1)
str.BufAppend(sb, c2)
i++
if c2 == "\\" and i < n:
str.BufAppend(sb, str.ByteSub(sql, i, 1))
i++
else c2 == ch:
break
end
end
else ch == "-" and i + 1 < n and str.ByteSub(sql, i + 1, 1) == "-":
until i < n and str.ByteSub(sql, i, 1) != "\n":
str.BufAppend(sb, str.ByteSub(sql, i, 1))
i++
end
else ch == "/" and i + 1 < n and str.ByteSub(sql, i + 1, 1) == "*":
str.BufAppend(sb, "/*")
i += 2
until i < n and not (str.ByteSub(sql, i, 1) == "*" and i + 1 < n and str.ByteSub(sql, i + 1, 1) == "/"):
str.BufAppend(sb, str.ByteSub(sql, i, 1))
i++
end
if i < n:
str.BufAppend(sb, "*/")
i += 2
end
else ch == "?":
if used >= args.len():
good = false
ret str.Clone("")
end
str.BufAppend(sb, args.get(used))
used++
i++
else:
str.BufAppend(sb, ch)
i++
end
end
if used != args.len():
good = false
ret str.Clone("")
end
ret str.BufStr(sb)
end
@en "StrArg"
@fa "آرگومان رشته"
pub func StrArg(s: str): str:
mut sb := str.NewBuilder()
defer str.BufFree(sb)
str.BufAppend(sb, "'")
n := str.ByteLen(s)
repeat n in i:
ch := str.ByteSub(s, i, 1)
if ch == "'":
str.BufAppend(sb, "\\'")
else ch == "\\":
str.BufAppend(sb, "\\\\")
else ch == "\n":
str.BufAppend(sb, "\\n")
else ch == "\t":
str.BufAppend(sb, "\\t")
else ch == "\r":
str.BufAppend(sb, "\\r")
else:
str.BufAppend(sb, ch)
end
end
str.BufAppend(sb, "'")
ret str.BufStr(sb)
end
@en "QuoteIdent"
@fa "نقل قول شناسه"
pub func QuoteIdent(name: str): str:
ret "`" + str.Replace(str.Replace(name, "\\", "\\\\"), "`", "\\`") + "`"
end
@en "IntArg"
@fa "آرگومان صحیح"
pub func IntArg(n: i64): str:
ret conv.FormatInt(n)
end
@en "UIntArg"
@fa "آرگومان طبیعی"
pub func UIntArg(n: u64): str:
ret conv.FormatUint(n)
end
@en "FloatArg"
@fa "آرگومان اعشاری"
pub func FloatArg(x: f64): str:
if math.IsNaN(x): ret str.Clone("nan") end
if math.IsInf(x):
if x < 0.0: ret str.Clone("-inf") end
ret str.Clone("inf")
end
ret conv.FormatFloatShort(x)
end
@en "BoolArg"
@fa "آرگومان منطقی"
pub func BoolArg(b: bool): str:
if b: ret str.Clone("true") end
ret str.Clone("false")
end
@en "NullArg"
@fa "آرگومان تهی"
pub func NullArg(): str:
ret str.Clone("NULL")
end
@en "RawArg"
@fa "آرگومان خام"
pub func RawArg(sql: str): str:
ret sql
end
@en "ArrayArg"
@fa "آرگومان آرایه"
pub func ArrayArg(items: Vector<str>): str:
ret "[" + str.Join(items, ", ") + "]"
end
@en "TupleArg"
@fa "آرگومان چندتایی"
pub func TupleArg(items: Vector<str>): str:
ret "(" + str.Join(items, ", ") + ")"
end
@en "MapArg"
@fa "آرگومان نگاشت"
pub func MapArg(keys: Vector<str>, values: Vector<str>): str:
mut parts := Vector {} as Vector<str>
defer parts.free()
n := keys.len() < values.len() ? keys.len() : values.len()
repeat n in i:
parts.push(keys.get(i))
parts.push(values.get(i))
end
ret "map(" + str.Join(parts, ", ") + ")"
end
@en "Args"
@fa "آرگومان‌ها"
pub func Args(items: Vector<str>): Vector<str>:
ret items
end
@en "Bind"
@fa "پیوند"
pub func Bind(sql: str, args: Vector<str>): str:
mut good := true
out := _bind(sql, args, good)
if not good: ret str.Clone("") end
ret out
end
@en "BaseType"
@fa "نوع پایه"
pub func BaseType(t: str): str:
mut cur := str.Trim(t)
until true:
if str.StartsWith(cur, "Nullable(") and str.EndsWith(cur, ")"):
cur = str.Trim(cur.substr(9, cur.len() - 10))
else str.StartsWith(cur, "LowCardinality(") and str.EndsWith(cur, ")"):
cur = str.Trim(cur.substr(15, cur.len() - 16))
else:
break
end
end
ret cur
end
@en "IsNullableType"
@fa "نوع تهی‌پذیر است"
pub func IsNullableType(t: str): bool:
cur := str.Trim(t)
if str.StartsWith(cur, "LowCardinality(") and str.EndsWith(cur, ")"):
ret IsNullableType(cur.substr(15, cur.len() - 16))
end
ret str.StartsWith(cur, "Nullable(")
end
@en "TypeKind"
@fa "دسته نوع"
pub func TypeKind(t: str): int:
b := BaseType(t)
if str.StartsWith(b, "Array("): ret KIND_ARRAY end
if str.StartsWith(b, "Map("): ret KIND_MAP end
if str.StartsWith(b, "Tuple("): ret KIND_TUPLE end
if str.StartsWith(b, "Nested("): ret KIND_ARRAY end
if str.StartsWith(b, "UInt"): ret KIND_UINT end
if str.StartsWith(b, "Int"): ret KIND_INT end
if str.StartsWith(b, "Float"): ret KIND_FLOAT end
if str.StartsWith(b, "Decimal"): ret KIND_DECIMAL end
if b == "Bool": ret KIND_BOOL end
if str.StartsWith(b, "DateTime"): ret KIND_DATETIME end
if str.StartsWith(b, "Date"): ret KIND_DATE end
if b == "String" or str.StartsWith(b, "FixedString(") or b == "UUID" or str.StartsWith(b, "Enum") or b == "IPv4" or b == "IPv6": ret KIND_STRING end
ret KIND_OTHER
end
@en "ElementType"
@fa "نوع عنصر"
pub func ElementType(t: str): str:
b := BaseType(t)
if str.StartsWith(b, "Array(") and str.EndsWith(b, ")"):
ret str.Trim(b.substr(6, b.len() - 7))
end
ret str.Clone("")
end
@en "clickhouse"
@fa "کلیک هاوس"
package clickhouse
import str
import conv
import encoding
import encoding.json
import encoding.url
import net.http
@en "DEFAULT_PORT"
@fa "درگاه پیش‌فرض"
pub const DEFAULT_PORT := 8123
@en "DEFAULT_SECURE_PORT"
@fa "درگاه امن پیش‌فرض"
pub const DEFAULT_SECURE_PORT := 8443
@en "KIND_OTHER"
@fa "نوع دیگر"
pub const KIND_OTHER := 0
@en "KIND_INT"
@fa "نوع صحیح"
pub const KIND_INT := 1
@en "KIND_UINT"
@fa "نوع طبیعی"
pub const KIND_UINT := 2
@en "KIND_FLOAT"
@fa "نوع اعشاری"
pub const KIND_FLOAT := 3
@en "KIND_DECIMAL"
@fa "نوع دهدهی"
pub const KIND_DECIMAL := 4
@en "KIND_STRING"
@fa "نوع رشته"
pub const KIND_STRING := 5
@en "KIND_BOOL"
@fa "نوع منطقی"
pub const KIND_BOOL := 6
@en "KIND_DATE"
@fa "نوع تاریخ"
pub const KIND_DATE := 7
@en "KIND_DATETIME"
@fa "نوع تاریخ‌زمان"
pub const KIND_DATETIME := 8
@en "KIND_ARRAY"
@fa "نوع آرایه"
pub const KIND_ARRAY := 9
@en "KIND_MAP"
@fa "نوع نگاشت"
pub const KIND_MAP := 10
@en "KIND_TUPLE"
@fa "نوع چندتایی"
pub const KIND_TUPLE := 11
@en "Options"
@fa "گزینه‌ها"
pub struct Options:
@en "addr"
@fa "نشانی"
pub addr: str = "localhost:8123"
@en "database"
@fa "پایگاه داده"
pub database: str = ""
@en "username"
@fa "نام کاربری"
pub username: str = "default"
@en "password"
@fa "گذرواژه"
pub password: str = ""
@en "secure"
@fa "امن"
pub secure: bool = false
@en "timeout_ms"
@fa "مهلت میلی‌ثانیه"
pub timeout_ms: int = 30000
@en "settings"
@fa "تنظیمات"
pub settings: HashMap<str, str> = HashMap {} as HashMap<str, str>
@en "headers"
@fa "سرآیندها"
pub headers: HashMap<str, str> = HashMap {} as HashMap<str, str>
end
@en "Conn"
@fa "اتصال"
pub struct Conn:
@en "opts"
@fa "گزینه‌ها"
pub opts: Options = Options {}
@en "base"
@fa "پایه"
pub base: str = ""
@en "connected"
@fa "باز"
pub connected: bool = false
@en "status"
@fa "وضعیت"
pub status: int = 0
@en "err"
@fa "پیام خطا"
pub err: str = ""
@en "code"
@fa "کد خطا"
pub code: int = 0
@en "query_id"
@fa "شناسه پرسمان"
pub query_id: str = ""
@en "read_rows"
@fa "ردیف‌های خوانده"
pub read_rows: i64 = 0
@en "written_rows"
@fa "ردیف‌های نوشته"
pub written_rows: i64 = 0
@en "Ok"
@fa "معتبر"
pub func Ok(): bool:
ret this.connected and this.err.len() == 0
end
@en "Error"
@fa "خطا"
pub func Error(): str:
ret this.err
end
@en "Code"
@fa "کد"
pub func Code(): int:
ret this.code
end
@en "Close"
@fa "بستن"
pub func Close():
this.connected = false
end
func _send(method: str, path: str, qs: str, body: str): http.Response:
this.err = ""
this.code = 0
this.status = 0
if not this.connected:
this.err = "the connection is closed"
ret http.Response { err = this.err }
end
opts := http.RequestOptions { timeout_ms = this.opts.timeout_ms }
r := http.Do(method, this.base + path + qs, _headers(this.opts), body, opts)
if r.err.len() > 0:
this.err = r.err
ret r
end
this.status = r.status
this.query_id = http.GetHeader(r, "X-ClickHouse-Query-Id")
summary := http.GetHeader(r, "X-ClickHouse-Summary")
if summary.len() > 0:
this.read_rows = conv.ParseIntOr(json.Get(summary, "read_rows"), 0 as i64)
this.written_rows = conv.ParseIntOr(json.Get(summary, "written_rows"), 0 as i64)
end
if r.status < 200 or r.status >= 300:
this.code = _exception_code(r)
this.err = str.Trim(r.body)
if this.err.len() == 0: this.err = "HTTP " + str.FromInt(r.status as i64) end
else:
hc := _header_code(r)
at := _exception_at(r.body)
if at >= 0:
this.code = _code_in(r.body, at)
if this.code == 0: this.code = hc end
this.err = _exception_text(r.body, at)
else hc != 0:
this.code = hc
this.err = "the server reported exception code " + str.FromInt(hc as i64)
end
end
ret r
end
@en "Ping"
@fa "پینگ"
pub func Ping(): bool:
r := this._send("GET", "/ping", "", "")
if this.err.len() > 0: ret false end
ret str.StartsWith(r.body, "Ok")
end
@en "Exec"
@fa "اجرا"
pub func Exec(sql: str, args: Vector<str>): bool:
mut good := true
bound := _bind(sql, args, good)
if not good:
this.err = "the number of placeholders does not match the number of arguments"
ret false
end
ret this.ExecParams(bound, HashMap {} as HashMap<str, str>)
end
@en "ExecParams"
@fa "اجرا با پارامتر"
pub func ExecParams(sql: str, params: HashMap<str, str>): bool:
ret this.ExecFull(sql, params, HashMap {} as HashMap<str, str>)
end
@en "ExecWith"
@fa "اجرا با تنظیمات"
pub func ExecWith(sql: str, args: Vector<str>, settings: HashMap<str, str>): bool:
mut good := true
bound := _bind(sql, args, good)
if not good:
this.err = "the number of placeholders does not match the number of arguments"
ret false
end
ret this.ExecFull(bound, HashMap {} as HashMap<str, str>, settings)
end
@en "ExecFull"
@fa "اجرای کامل"
pub func ExecFull(sql: str, params: HashMap<str, str>, extra: HashMap<str, str>): bool:
_ := this._send("POST", "/", _query_string(this.opts, params, extra, false), sql)
ret this.err.len() == 0
end
@en "Query"
@fa "پرسمان"
pub func Query(sql: str, args: Vector<str>): Rows:
mut good := true
bound := _bind(sql, args, good)
if not good:
this.err = "the number of placeholders does not match the number of arguments"
ret Rows { err = this.err }
end
ret this.QueryParams(bound, HashMap {} as HashMap<str, str>)
end
@en "QueryParams"
@fa "پرسمان با پارامتر"
pub func QueryParams(sql: str, params: HashMap<str, str>): Rows:
ret this.QueryFull(sql, params, HashMap {} as HashMap<str, str>)
end
@en "QueryWith"
@fa "پرسمان با تنظیمات"
pub func QueryWith(sql: str, args: Vector<str>, settings: HashMap<str, str>): Rows:
mut good := true
bound := _bind(sql, args, good)
if not good:
this.err = "the number of placeholders does not match the number of arguments"
ret Rows { err = this.err }
end
ret this.QueryFull(bound, HashMap {} as HashMap<str, str>, settings)
end
@en "QueryRow"
@fa "پرسمان یک ردیف"
pub func QueryRow(sql: str, args: Vector<str>): Vector<str>:
mut rows := this.Query(sql, args)
mut out := Vector {} as Vector<str>
if rows.Next(): out = rows.Row() end
rows.Close()
ret out
end
@en "QueryFull"
@fa "پرسمان کامل"
pub func QueryFull(sql: str, params: HashMap<str, str>, extra: HashMap<str, str>): Rows:
r := this._send("POST", "/", _query_string(this.opts, params, extra, true), sql)
if this.err.len() > 0: ret Rows { err = this.err } end
ret _parse_rows(r.body)
end
@en "QueryText"
@fa "پرسمان متن"
pub func QueryText(sql: str): str:
mut rows := this.QueryParams(sql, HashMap {} as HashMap<str, str>)
mut out := ""
if rows.Next(): out = rows.Text(0) end
rows.Close()
ret out
end
@en "QueryInt"
@fa "پرسمان عدد"
pub func QueryInt(sql: str): i64:
mut rows := this.QueryParams(sql, HashMap {} as HashMap<str, str>)
mut out := 0 as i64
if rows.Next(): out = rows.Int64(0) end
rows.Close()
ret out
end
@en "ServerVersion"
@fa "نسخه کارگزار"
pub func ServerVersion(): str:
ret this.QueryText("SELECT version()")
end
@en "PrepareBatch"
@fa "آماده‌سازی دسته"
pub func PrepareBatch(sql: str): Batch:
ret _new_batch(sql)
end
@en "SendBatch"
@fa "ارسال دسته"
pub func SendBatch(b: Batch): bool:
if b.err.len() > 0:
this.err = b.err
ret false
end
if b.rows.len() == 0:
this.err = "the batch has no rows"
ret false
end
ret this.ExecParams(b.head + " VALUES " + str.Join(b.rows, ","), HashMap {} as HashMap<str, str>)
end
end
func _base_url(o: Options): str:
mut addr := str.Trim(o.addr)
if addr.len() == 0: addr = "localhost" end
mut scheme := o.secure ? "https" : "http"
if str.StartsWith(addr, "https://"):
scheme = "https"
addr = addr.substr(8, addr.len() - 8)
else str.StartsWith(addr, "http://"):
addr = addr.substr(7, addr.len() - 7)
end
until str.EndsWith(addr, "/"):
addr = addr.substr(0, addr.len() - 1)
end
if addr.find(":") < 0 and not str.StartsWith(addr, "["):
port := scheme == "https" ? DEFAULT_SECURE_PORT : DEFAULT_PORT
addr = addr + ":" + str.FromInt(port as i64)
end
ret scheme + "://" + addr
end
func _query_string(o: Options, params: HashMap<str, str>, extra: HashMap<str, str>, reading: bool): str:
mut parts := Vector {} as Vector<str>
defer parts.free()
if o.database.len() > 0: parts.push("database=" + encoding.URLEncode(o.database)) end
each k, v in o.settings:
parts.push(encoding.URLEncode(k) + "=" + encoding.URLEncode(v))
end
each k, v in extra:
parts.push(encoding.URLEncode(k) + "=" + encoding.URLEncode(v))
end
each k, v in params:
parts.push("param_" + encoding.URLEncode(k) + "=" + encoding.URLEncode(v))
end
if reading:
parts.push("default_format=JSONCompact")
parts.push("output_format_json_quote_64bit_integers=1")
parts.push("output_format_json_quote_denormals=1")
end
if parts.len() == 0: ret str.Clone("") end
ret "?" + str.Join(parts, "&")
end
func _headers(o: Options): HashMap<str, str>:
mut h := http.NewHeaders()
h.put("Content-Type", "text/plain; charset=utf-8")
if o.username.len() > 0: h.put("X-ClickHouse-User", o.username) end
if o.password.len() > 0: h.put("X-ClickHouse-Key", o.password) end
each k, v in o.headers:
h.put(k, v)
end
ret h
end
func _header_code(r: http.Response): int:
hv := http.GetHeader(r, "X-ClickHouse-Exception-Code")
if hv.len() > 0: ret conv.ParseIntOr(hv, 0 as i64) as int end
ret 0
end
func _code_in(body: str, at: int): int:
mut start := body.find("Code: ")
if at >= 0: start = str.IndexFrom(body, "Code: ", at) end
if start < 0: ret 0 end
mut stop := start + 6
until stop < body.len() and "0123456789".find(str.ByteSub(body, stop, 1)) >= 0:
stop++
end
ret conv.ParseIntOr(body.substr(start + 6, stop - start - 6), 0 as i64) as int
end
func _exception_code(r: http.Response): int:
hc := _header_code(r)
if hc != 0: ret hc end
if str.StartsWith(r.body, "Code: "): ret _code_in(r.body, 0) end
ret 0
end
func _marker_at(body: str): int:
mut pos := 0
until pos >= 0:
mark := str.IndexFrom(body, "__exception__", pos)
if mark < 0: ret -1 end
if mark == 0 or str.ByteSub(body, mark - 1, 1) == "\n": ret mark end
pos = mark + 13
end
ret -1
end
func _exception_at(body: str): int:
mark := _marker_at(body)
if mark >= 0:
at := str.IndexFrom(body, "Code: ", mark)
if at >= 0: ret at end
ret mark
end
mut pos := 0
until pos >= 0:
at := str.IndexFrom(body, "Code: ", pos)
if at < 0: ret -1 end
eol := str.IndexFrom(body, "\n", at)
mut line := body.substr(at, body.len() - at)
if eol >= 0: line = body.substr(at, eol - at) end
lead := at == 0 or str.ByteSub(body, at - 1, 1) == "\n"
if lead and line.find("DB::Exception") >= 0: ret at end
pos = at + 6
end
ret -1
end
func _exception_text(body: str, at: int): str:
mut text := str.Trim(body.substr(at, body.len() - at))
mark := text.find("__exception__")
if mark >= 0:
text = str.Trim(text.substr(0, mark))
nl := text.find("\n")
if nl >= 0: text = str.Trim(text.substr(0, nl)) end
end
if text.len() == 0: text = "the server reported an exception while sending the reply" end
ret text
end
@en "DefaultOptions"
@fa "گزینه‌های پیش‌فرض"
pub func DefaultOptions(): Options:
ret Options {}
end
@en "Open"
@fa "باز کردن"
pub func Open(o: Options): Conn:
ret Conn { opts = o, base = _base_url(o), connected = true }
end
@en "OpenURL"
@fa "باز کردن نشانی"
pub func OpenURL(dsn: str): Conn:
mut text := str.Trim(dsn)
if str.StartsWith(text, "clickhouse://"):
text = "http://" + text.substr(13, text.len() - 13)
else str.StartsWith(text, "clickhouses://"):
text = "https://" + text.substr(14, text.len() - 14)
end
mut u := url.URL {}
try:
u = url.Parse(text)
catch:
ret Conn { err = "invalid ClickHouse address: " + dsn }
end
mut o := Options {}
o.secure = u.scheme.lower() == "https"
if u.host.len() == 0: ret Conn { err = "invalid ClickHouse address: " + dsn } end
mut port := DEFAULT_PORT
if u.port > 0:
port = u.port
else o.secure:
port = DEFAULT_SECURE_PORT
end
o.addr = u.host + ":" + str.FromInt(port as i64)
if u.userinfo.len() > 0:
mut info := u.userinfo
try:
info = url.DecodedUserinfo(u)
catch:
info = u.userinfo
end
colon := info.find(":")
if colon >= 0:
o.username = info.substr(0, colon)
o.password = info.substr(colon + 1, info.len() - colon - 1)
else:
o.username = info
end
end
if u.path.len() > 1: o.database = u.path.substr(1, u.path.len() - 1) end
if u.raw_query.len() > 0:
each pair in u.raw_query.split("&"):
eqi := pair.find("=")
if eqi > 0:
k := pair.substr(0, eqi)
mut v := pair.substr(eqi + 1, pair.len() - eqi - 1)
try:
v = encoding.URLDecode(v)
catch:
v = pair.substr(eqi + 1, pair.len() - eqi - 1)
end
if k == "database":
o.database = v
else k == "username":
o.username = v
else k == "password":
o.password = v
else k == "secure":
o.secure = v == "true" or v == "1"
else k == "timeout":
o.timeout_ms = conv.ParseIntOr(v, 30000 as i64) as int
else:
o.settings.put(k, v)
end
end
end
end
ret Open(o)
end
