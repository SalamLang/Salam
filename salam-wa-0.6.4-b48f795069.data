pub name: str = ""
@en "typeRef"
@fa "ارجاع نوع"
pub typeRef: int = 0 - 1
@en "defaultValue"
@fa "مقدار پیش‌فرض"
pub defaultValue: int = 0 - 1
@en "hasDefault"
@fa "دارای پیش‌فرض"
pub hasDefault: bool = false
@en "directives"
@fa "دستورالعمل‌ها"
pub directives: Vector<AstDirective> = Vector {}
@en "line"
@fa "خط"
pub line: int = 0
