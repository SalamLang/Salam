else:
tl.push(0)
td.push(i)
cg.set(_wpd_ch(p, 8), cg.get(_wpd_ch(p, 8)) + 1)
cr.set(_wpd_ch(p, 16), cr.get(_wpd_ch(p, 16)) + 1)
cb.set(_wpd_ch(p, 0), cb.get(_wpd_ch(p, 0)) + 1)
ca.set(_wpd_ch(p, 24), ca.get(_wpd_ch(p, 24)) + 1)
end
end
i += step
until inserted < i:
if cache_size > 0:
q := px.get(inserted)
cache.set(_wpd_hash(q, cache_bits), q)
end
if inserted + 1 < total:
k := _wp_key(px, inserted)
chain.set(inserted, head.get(k))
head.set(k, inserted)
end
inserted++
end
end
if cache_size > 0:
compress.BitWriteBit(w, 1)
