func _pair(keys &: Vector<str>, vals &: Vector<str>, raws &: Vector<bool>, key: str, value: str, raw: bool):
keys.push(key)
vals.push(value)
raws.push(raw)
end
func _is_number(s: str): bool:
l := str.ByteLen(s)
if l == 0: ret false end
bp := _bp(s)
mut digits := 0
repeat l in i:
code := _ub(bp, i)
if code >= 48 and code <= 57:
digits++
else code == 45:
if i != 0: ret false end
else code == 46:
if digits == 0: ret false end
else:
ret false
end
end
ret digits > 0
end
func _params(p: SearchParams, keys &: Vector<str>, vals &: Vector<str>, raws &: Vector<bool>):
if p.q.len() > 0: _pair(keys, vals, raws, "q", p.q, false) end
if p.query_by.len() > 0: _pair(keys, vals, raws, "query_by", p.query_by, false) end
if p.query_by_weights.len() > 0: _pair(keys, vals, raws, "query_by_weights", p.query_by_weights, false) end
if p.text_match_type.len() > 0: _pair(keys, vals, raws, "text_match_type", p.text_match_type, false) end
if p.prefix.len() > 0: _pair(keys, vals, raws, "prefix", p.prefix, false) end
if p.infix.len() > 0: _pair(keys, vals, raws, "infix", p.infix, false) end
if p.filter_by.len() > 0: _pair(keys, vals, raws, "filter_by", p.filter_by, false) end
if p.sort_by.len() > 0: _pair(keys, vals, raws, "sort_by", p.sort_by, false) end
if p.facet_by.len() > 0: _pair(keys, vals, raws, "facet_by", p.facet_by, false) end
if p.facet_query.len() > 0: _pair(keys, vals, raws, "facet_query", p.facet_query, false) end
if p.max_facet_values > 0: _pair(keys, vals, raws, "max_facet_values", str.FromInt(p.max_facet_values as i64), true) end
if p.group_by.len() > 0: _pair(keys, vals, raws, "group_by", p.group_by, false) end
if p.group_limit > 0: _pair(keys, vals, raws, "group_limit", str.FromInt(p.group_limit as i64), true) end
if p.include_fields.len() > 0: _pair(keys, vals, raws, "include_fields", p.include_fields, false) end
if p.exclude_fields.len() > 0: _pair(keys, vals, raws, "exclude_fields", p.exclude_fields, false) end
if p.highlight_fields.len() > 0: _pair(keys, vals, raws, "highlight_fields", p.highlight_fields, false) end
if p.highlight_full_fields.len() > 0: _pair(keys, vals, raws, "highlight_full_fields", p.highlight_full_fields, false) end
if p.highlight_start_tag.len() > 0: _pair(keys, vals, raws, "highlight_start_tag", p.highlight_start_tag, false) end
if p.highlight_end_tag.len() > 0: _pair(keys, vals, raws, "highlight_end_tag", p.highlight_end_tag, false) end
if p.snippet_threshold > 0: _pair(keys, vals, raws, "snippet_threshold", str.FromInt(p.snippet_threshold as i64), true) end
if p.num_typos.len() > 0: _pair(keys, vals, raws, "num_typos", p.num_typos, false) end
if p.typo_tokens_threshold > 0: _pair(keys, vals, raws, "typo_tokens_threshold", str.FromInt(p.typo_tokens_threshold as i64), true) end
if p.drop_tokens_threshold > 0: _pair(keys, vals, raws, "drop_tokens_threshold", str.FromInt(p.drop_tokens_threshold as i64), true) end
if p.page > 0: _pair(keys, vals, raws, "page", str.FromInt(p.page as i64), true) end
if p.per_page > 0: _pair(keys, vals, raws, "per_page", str.FromInt(p.per_page as i64), true) end
if p.offset > 0: _pair(keys, vals, raws, "offset", str.FromInt(p.offset as i64), true) end
if p.limit > 0: _pair(keys, vals, raws, "limit", str.FromInt(p.limit as i64), true) end
if p.pinned_hits.len() > 0: _pair(keys, vals, raws, "pinned_hits", p.pinned_hits, false) end
if p.hidden_hits.len() > 0: _pair(keys, vals, raws, "hidden_hits", p.hidden_hits, false) end
if p.override_tags.len() > 0: _pair(keys, vals, raws, "override_tags", p.override_tags, false) end
if p.preset.len() > 0: _pair(keys, vals, raws, "preset", p.preset, false) end
if p.vector_query.len() > 0: _pair(keys, vals, raws, "vector_query", p.vector_query, false) end
if p.stopwords.len() > 0: _pair(keys, vals, raws, "stopwords", p.stopwords, false) end
if p.exhaustive_search: _pair(keys, vals, raws, "exhaustive_search", "true", true) end
if p.search_cutoff_ms > 0: _pair(keys, vals, raws, "search_cutoff_ms", str.FromInt(p.search_cutoff_ms as i64), true) end
if p.use_cache: _pair(keys, vals, raws, "use_cache", "true", true) end
if p.cache_ttl > 0: _pair(keys, vals, raws, "cache_ttl", str.FromInt(p.cache_ttl as i64), true) end
if p.conversation: _pair(keys, vals, raws, "conversation", "true", true) end
if p.conversation_id.len() > 0: _pair(keys, vals, raws, "conversation_id", p.conversation_id, false) end
if p.conversation_model_id.len() > 0: _pair(keys, vals, raws, "conversation_model_id", p.conversation_model_id, false) end
if p.nl_query: _pair(keys, vals, raws, "nl_query", "true", true) end
if p.nl_model_id.len() > 0: _pair(keys, vals, raws, "nl_model_id", p.nl_model_id, false) end
repeat p.keys.len() in i:
v := p.values.get(i)
_pair(keys, vals, raws, p.keys.get(i), v, v == "true" or v == "false" or _is_number(v))
end
end
func _params_json(p: SearchParams, extra: Vector<str>): str:
mut keys := Vector {} as Vector<str>
mut vals := Vector {} as Vector<str>
mut raws := Vector {} as Vector<bool>
_params(p, keys, vals, raws)
mut m := Vector {} as Vector<str>
each e in extra:
m.push(e)
end
repeat keys.len() in i:
if raws.get(i):
m.push(json.MemberRaw(keys.get(i), vals.get(i)))
else:
m.push(json.Member(keys.get(i), vals.get(i)))
end
end
ret json.Object(m)
end
func _hit(raw: str): Hit:
ret Hit {
document = _get_raw(raw, "document"), text_match = _get_i64(raw, "text_match", 0 as i64), highlight = _get_raw(raw, "highlight"),
highlights = _get_raw(raw, "highlights"), text_match_info = _get_raw(raw, "text_match_info"),
geo_distance_meters = _get_raw(raw, "geo_distance_meters"), vector_distance = _f64(json.Get(raw, "vector_distance")),
hybrid_search_info = _get_raw(raw, "hybrid_search_info"), curated = _get_bool(raw, "curated"),
collection = _get_str(raw, "collection"), search_index = _get_i64(raw, "search_index", 0 as i64) as int,
raw = raw
}
end
func _hits(raw: str): Vector<Hit>:
mut out := Vector {} as Vector<Hit>
each item in _items(raw):
out.push(_hit(item))
end
ret out
end
func _facet(raw: str): Facet:
mut counts := Vector {} as Vector<FacetCount>
each item in _items(_get_raw(raw, "counts")):
counts.push(
FacetCount {
value = _get_str(item, "value"), count = _get_i64(item, "count", 0 as i64), highlighted = _get_str(item, "highlighted")
}
)
end
ret Facet {
field_name = _get_str(raw, "field_name"), counts = counts, sampled = _get_bool(raw, "sampled"),
stats = _get_raw(raw, "stats")
}
end
func _search_get(c: Client, collection: str, p: SearchParams, err &: Error): str:
mut keys := Vector {} as Vector<str>
mut vals := Vector {} as Vector<str>
mut raws := Vector {} as Vector<bool>
_params(p, keys, vals, raws)
q := _query(keys, vals)
if q.len() <= MAX_GET_QUERY:
ret _call(c, "GET", _dpath(collection) + "/search" + q, "", err)
end
mut extra := Vector {} as Vector<str>
extra.push(json.Member("collection", collection))
mut searches := Vector {} as Vector<str>
searches.push(_params_json(p, extra))
mut body := Vector {} as Vector<str>
body.push(json.MemberRaw("searches", json.Array(searches)))
out := _call(c, "POST", "/multi_search", json.Object(body), err)
if not _ts_ok(err): ret "" end
results := _items(_get_raw(out, "results"))
if results.len() == 0:
_fail(err, 0, KIND_DECODE, "multi_search returned no result")
ret ""
end
first := results.get(0)
code := _get_i64(first, "code", 0 as i64) as int
if code >= 400:
_fail(err, code, KIND_HTTP, _get_str(first, "error"))
ret ""
end
ret first
end
func _multi_body(searches: Vector<SearchRequest>, union: bool): str:
mut items := Vector {} as Vector<str>
each s in searches:
mut extra := Vector {} as Vector<str>
if s.collection.len() > 0: extra.push(json.Member("collection", s.collection)) end
if s.api_key.len() > 0: extra.push(json.Member("x-typesense-api-key", s.api_key)) end
items.push(_params_json(s.params, extra))
end
mut body := Vector {} as Vector<str>
if union: body.push(json.MemberBool("union", true)) end
body.push(json.MemberRaw("searches", json.Array(items)))
ret json.Object(body)
end
func _common_query(common: SearchParams): str:
mut keys := Vector {} as Vector<str>
mut vals := Vector {} as Vector<str>
mut raws := Vector {} as Vector<bool>
_params(common, keys, vals, raws)
ret _query(keys, vals)
end
@en "NewSearch"
@fa "جستجوی جدید"
pub func NewSearch(q: str, query_by: str): SearchParams:
ret SearchParams { q = q, query_by = query_by }
end
@en "Set"
@fa "تنظیم پارامتر"
pub func Set(p &: SearchParams, key: str, value: str):
repeat p.keys.len() in i:
if p.keys.get(i) == key:
p.values.set(i, value)
ret
end
end
p.keys.push(key)
p.values.push(value)
end
@en "SearchQuery"
@fa "متن پرسمان جستجو"
pub func SearchQuery(p: SearchParams): str:
mut keys := Vector {} as Vector<str>
mut vals := Vector {} as Vector<str>
mut raws := Vector {} as Vector<bool>
_params(p, keys, vals, raws)
q := _query(keys, vals)
if q.len() == 0: ret "" end
ret q.substr(1, q.len() - 1)
end
@en "SearchParamsJSON"
@fa "جیسون پارامترهای جستجو"
pub func SearchParamsJSON(p: SearchParams): str:
ret _params_json(p, Vector {} as Vector<str>)
end
@en "ParseSearchResult"
@fa "تجزیه نتیجه جستجو"
pub func ParseSearchResult(body: str): SearchResult:
mut groups := Vector {} as Vector<Group>
each item in _items(_get_raw(body, "grouped_hits")):
groups.push(
Group {
key = _strings(_get_raw(item, "group_key")), found = _get_i64(item, "found", 0 as i64), hits = _hits(_get_raw(item, "hits"))
}
)
end
mut facets := Vector {} as Vector<Facet>
each item in _items(_get_raw(body, "facet_counts")):
facets.push(_facet(item))
end
ret SearchResult {
found = _get_i64(body, "found", 0 as i64), found_docs = _get_i64(body, "found_docs", 0 as i64),
out_of = _get_i64(body, "out_of", 0 as i64), page = _get_i64(body, "page", 0 as i64) as int,
search_time_ms = _get_i64(body, "search_time_ms", 0 as i64), search_cutoff = _get_bool(body, "search_cutoff"),
hits = _hits(_get_raw(body, "hits")), groups = groups, facets = facets, request_params = _get_raw(body, "request_params"),
conversation = _get_raw(body, "conversation"), parsed_nl_query = _get_raw(body, "parsed_nl_query"),
code = _get_i64(body, "code", 0 as i64) as int, error = _get_str(body, "error"), raw = body
}
end
@en "SearchRaw"
@fa "جستجوی خام"
pub func SearchRaw(c: Client, collection: str, p: SearchParams, err &: Error): str:
ret _search_get(c, collection, p, err)
end
@en "Search"
@fa "جستجو"
pub func Search(c: Client, collection: str, p: SearchParams, err &: Error): SearchResult:
body := _search_get(c, collection, p, err)
if not _ts_ok(err): ret SearchResult {} end
ret ParseSearchResult(body)
end
@en "MultiSearchRaw"
@fa "جستجوی چندگانه خام"
pub func MultiSearchRaw(c: Client, searches: Vector<SearchRequest>, common: SearchParams, err &: Error): str:
ret _call(c, "POST", "/multi_search" + _common_query(common), _multi_body(searches, false), err)
end
@en "MultiSearch"
@fa "جستجوی چندگانه"
pub func MultiSearch(c: Client, searches: Vector<SearchRequest>, common: SearchParams, err &: Error): Vector<SearchResult>:
body := MultiSearchRaw(c, searches, common, err)
mut out := Vector {} as Vector<SearchResult>
if not _ts_ok(err): ret out end
each item in _items(_get_raw(body, "results")):
out.push(ParseSearchResult(item))
end
ret out
end
@en "UnionSearch"
@fa "جستجوی اجتماع"
pub func UnionSearch(c: Client, searches: Vector<SearchRequest>, common: SearchParams, err &: Error): SearchResult:
body := _call(c, "POST", "/multi_search" + _common_query(common), _multi_body(searches, true), err)
if not _ts_ok(err): ret SearchResult {} end
ret ParseSearchResult(body)
end
@en "HitsAs"
@fa "یافته ها به نوع"
pub func HitsAs<T>(r: SearchResult, out &: Vector<T>, err &: Error): bool:
each h in r.hits:
mut v := T {}
try:
json.UnmarshalLenient(h.document, v)
catch e:
_ts_decode_fail(e.message, err)
ret false
end
out.push(v)
end
ret true
end
@en "Highlight"
@fa "برجسته"
pub func Highlight(h: Hit, field: str): str:
f := _get_raw(h.highlight, field)
if f.len() == 0: ret "" end
if _starts_with_byte(f, 123):
ret _get_str(f, "snippet")
end
mut parts := Vector {} as Vector<str>
each item in _items(f):
s := _get_str(item, "snippet")
if s.len() > 0: parts.push(s) end
end
ret str.Join(parts, " ")
end
@en "FreeResult"
@fa "آزادسازی نتیجه"
pub func FreeResult(r &: SearchResult):
each g in r.groups:
mut hits := g.hits
hits.free()
mut key := g.key
key.free()
end
each f in r.facets:
mut counts := f.counts
counts.free()
end
r.hits.free()
r.groups.free()
r.facets.free()
r.hits = Vector {} as Vector<Hit>
r.groups = Vector {} as Vector<Group>
r.facets = Vector {} as Vector<Facet>
end
@en "typesense"
@fa "تایپسنس"
package typesense
import mem
import str
import conv
import time
import crypto
import encoding
import encoding.json
import net.http
@en "VERSION"
@fa "نسخه کلاینت"
pub const VERSION := "1.0.0"
@en "KIND_HTTP"
@fa "نوع اچ تی تی پی"
pub const KIND_HTTP := "http"
@en "KIND_NETWORK"
@fa "نوع شبکه"
pub const KIND_NETWORK := "network"
@en "KIND_INVALID"
@fa "نوع نامعتبر"
pub const KIND_INVALID := "invalid"
@en "KIND_DECODE"
@fa "نوع رمزگشایی"
pub const KIND_DECODE := "decode"
@en "Client"
@fa "کلاینت"
pub struct Client:
@en "nodes"
@fa "گره‌ها"
pub nodes: Vector<str> = Vector {} as Vector<str>
@en "nearest"
@fa "نزدیک‌ترین"
pub nearest: str = ""
@en "api_key"
@fa "کلید دسترسی"
pub api_key: str = ""
@en "timeout_ms"
@fa "مهلت میلی‌ثانیه"
pub timeout_ms: int = 10000
@en "retries"
@fa "تعداد کوشش"
pub retries: int = 3
@en "retry_interval_ms"
@fa "فاصله کوشش میلی‌ثانیه"
pub retry_interval_ms: int = 100
@en "healthcheck_ms"
@fa "بازه سلامت‌سنجی میلی‌ثانیه"
pub healthcheck_ms: int = 60000
@en "headers"
@fa "سرآیندها"
pub headers: Vector<str> = Vector {} as Vector<str>
@en "state"
@fa "وضعیت"
pub state: Vector<i64> = Vector {} as Vector<i64>
end
@en "Error"
@fa "خطا"
pub struct Error:
@en "status"
@fa "وضعیت"
pub status: int = 0
@en "kind"
@fa "نوع"
pub kind: str = ""
@en "message"
@fa "پیام"
pub message: str = ""
end
@en "ClusterStatus"
@fa "وضعیت خوشه"
pub struct ClusterStatus:
@en "state"
@fa "وضعیت"
pub state: str = ""
@en "committed_index"
@fa "اندیس ثبت‌شده"
pub committed_index: i64 = 0
@en "queued_writes"
@fa "نوشتن‌های صف‌شده"
pub queued_writes: i64 = 0
end
inline pure func _bp(s: str): i8*: ret (s as void*) as i8* end
inline pure func _ub(bp: i8*, i: int): int:
mut v := bp[i] as int
if v < 0: v += 256 end
ret v
end
func _ws(s: str, i: int): int:
l := str.ByteLen(s)
bp := _bp(s)
mut p := i
until p < l:
code := _ub(bp, p)
if code != 32 and code != 9 and code != 10 and code != 13: ret p end
p++
end
ret p
end
func _value_end(s: str, i: int): int:
l := str.ByteLen(s)
bp := _bp(s)
mut p := i
mut depth := 0
mut in_str := false
until p < l:
code := _ub(bp, p)
if in_str:
if code == 92:
p++
else code == 34:
in_str = false
if depth == 0: ret p + 1 end
end
else code == 34:
in_str = true
else code == 123 or code == 91:
depth++
else code == 125 or code == 93:
if depth == 0: ret p end
depth--
if depth == 0: ret p + 1 end
else code == 44:
if depth == 0: ret p end
end
p++
end
ret p
end
func _items(raw: str): Vector<str>:
mut out := Vector {} as Vector<str>
l := str.ByteLen(raw)
bp := _bp(raw)
mut p := _ws(raw, 0)
if p >= l or _ub(bp, p) != 91: ret out end
p = _ws(raw, p + 1)
until p < l:
if _ub(bp, p) == 93: ret out end
e := _value_end(raw, p)
if e <= p: ret out end
out.push(str.TrimRight(str.ByteSub(raw, p, e - p)))
p = _ws(raw, e)
if p < l and _ub(bp, p) == 44:
p = _ws(raw, p + 1)
end
end
ret out
end
func _starts_with_byte(raw: str, code: int): bool:
l := str.ByteLen(raw)
p := _ws(raw, 0)
ret p < l and _ub(_bp(raw), p) == code
end
func _unquote(raw: str): str:
if raw.len() == 0: ret "" end
if _ub(_bp(raw), 0) != 34: ret raw end
ret json.Get(`{"v":` + raw + `}`, "v")
end
func _strings(raw: str): Vector<str>:
mut out := Vector {} as Vector<str>
each item in _items(raw):
out.push(_unquote(item))
end
ret out
end
func _strs_json(items: Vector<str>): str:
mut quoted := Vector {} as Vector<str>
each item in items:
quoted.push(json.Str(item))
end
ret json.Array(quoted)
end
func _i64(text: str): i64:
l := str.ByteLen(text)
bp := _bp(text)
mut p := 0
mut neg := false
if l > 0 and _ub(bp, 0) == 45:
neg = true
p = 1
end
mut n := 0 as i64
until p < l:
code := _ub(bp, p)
if code < 48 or code > 57: break end
n = n * (10 as i64) + ((code - 48) as i64)
p++
end
if neg: ret 0 as i64 - n end
ret n
end
func _f64(text: str): f64:
if text.len() == 0 or text == "null": ret 0.0 end
ret conv.ParseFloatOr(text, 0.0)
end
func _get_i64(text: str, key: str, fallback: i64): i64:
v := json.Get(text, key)
if v.len() == 0 or v == "null": ret fallback end
ret _i64(v)
end
func _get_str(text: str, key: str): str:
v := json.Get(text, key)
if v == "null": ret "" end
ret v
end
func _get_bool(text: str, key: str): bool:
ret json.Get(text, key) == "true"
end
func _get_raw(text: str, key: str): str:
v := json.Get(text, key)
if v == "null": ret "" end
ret v
end
func _object_with(members: Vector<str>, extra: str): str:
mut all := Vector {} as Vector<str>
each m in members:
all.push(m)
end
inner := _object_inner(extra)
if inner.len() > 0: all.push(inner) end
ret json.Object(all)
end
func _object_inner(raw: str): str:
t := str.Trim(raw)
if t.len() < 2: ret "" end
if not _starts_with_byte(t, 123): ret "" end
ret str.Trim(t.substr(1, t.len() - 2))
end
func _esc(segment: str): str:
ret encoding.URLEncode(segment)
end
func _query(keys: Vector<str>, vals: Vector<str>): str:
mut out := ""
repeat keys.len() in i:
if i == 0:
out += "?"
else:
out += "&"
end
out = out + _esc(keys.get(i)) + "=" + _esc(vals.get(i))
end
ret out
end
func _clear(err &: Error):
err.status = 0
err.kind = ""
err.message = ""
end
func _fail(err &: Error, status: int, kind: str, message: str):
err.status = status
err.kind = kind
err.message = message
end
func _ts_ok(err: Error): bool:
ret err.kind.len() == 0
end
func _raw_str(r: http.RawResponse): str:
if r.data == null or r.len <= 0: ret "" end
d := mem.Allocate((r.len + 1) as u64)
if d == null: ret "" end
mem.Copy(d, r.data, r.len as u64)
bp := d as u8*
bp[r.len] = 0 as u8
ret d as str
end
func _node_path(node: str): str:
at := node.find("://")
if at < 0: ret "" end
rest := node.substr(at + 3, node.len() - at - 3)
slash := rest.find("/")
if slash < 0: ret "" end
ret rest.substr(slash, rest.len() - slash)
end
func _host_header(ep: http.Endpoint): str:
if ep.secure and ep.port == 443: ret ep.host end
if not ep.secure and ep.port == 80: ret ep.host end
ret ep.host + ":" + ep.port
end
func _normalize(url: str): str:
mut h := str.Trim(url)
until h.ends_with("/"):
h = h.substr(0, h.len() - 1)
end
if h.len() > 0 and h.find("://") < 0:
h = "http://" + h
end
ret h
end
func _reset_state(c &: Client):
c.state.free()
c.state = Vector {} as Vector<i64>
c.state.push(0 as i64 - 1)
repeat c.nodes.len() + 1:
c.state.push(0 as i64)
end
end
func _pick(c: Client): int:
n := c.nodes.len()
if c.state.len() < n + 2: ret 0 - 2 end
now := time.NowMillis()
if c.nearest.len() > 0 and c.state.get(n + 1) <= now: ret 0 - 1 end
if n == 0:
if c.nearest.len() > 0: ret 0 - 1 end
ret 0 - 2
end
mut cursor := c.state.get(0) as int
repeat n:
cursor = (cursor + 1) % n
if c.state.get(cursor + 1) <= now:
c.state.set(0, cursor as i64)
ret cursor
end
end
cursor = (cursor + 1) % n
c.state.set(0, cursor as i64)
ret cursor
end
func _mark(c: Client, idx: int, healthy: bool):
n := c.nodes.len()
if c.state.len() < n + 2: ret end
mut slot := idx + 1
if idx < 0: slot = n + 1 end
if healthy:
c.state.set(slot, 0 as i64)
else:
c.state.set(slot, time.NowMillis() + (c.healthcheck_ms as i64))
end
end
func _head(c: Client, ep: http.Endpoint, method: str, target: str, ctype: str, n: int): str:
mut h := method + " " + target + " HTTP/1.1\r\n"
h = h + "Host: " + _host_header(ep) + "\r\n"
h = h + "User-Agent: typesense-salam/" + VERSION + "\r\n"
h += "Accept: application/json\r\n"
if c.api_key.len() > 0:
h = h + "X-TYPESENSE-API-KEY: " + c.api_key + "\r\n"
end
each line in c.headers:
h = h + line + "\r\n"
end
if n > 0 or method == "POST" or method == "PUT" or method == "PATCH":
if ctype.len() > 0:
h = h + "Content-Type: " + ctype + "\r\n"
end
h = h + "Content-Length: " + n + "\r\n"
end
ret h + "Connection: close\r\n\r\n"
end
func _http_error(status: int, body: str, err &: Error):
mut msg := ""
if json.Valid(body):
msg = _get_str(body, "message")
end
if msg.len() == 0: msg = str.Trim(body) end
if msg.len() == 0: msg = "HTTP " + status end
_fail(err, status, KIND_HTTP, msg)
end
func _send(c: Client, method: str, path: str, ctype: str, body: str, err &: Error): str:
_clear(err)
mut attempts := c.retries + 1
if attempts < 1: attempts = 1 end
repeat attempts in attempt:
idx := _pick(c)
if idx == -2:
_fail(err, 0, KIND_INVALID, "client has no nodes")
ret ""
end
mut node := c.nearest
if idx >= 0: node = c.nodes.get(idx) end
ep := http.ParseEndpoint(node)
if not ep.ok:
_fail(err, 0, KIND_INVALID, "not a node url: " + node)
ret ""
end
head := _head(c, ep, method, _node_path(node) + path, ctype, body.len())
mut r := http.SendRawTimeout(ep, head, body as void*, body.len(), c.timeout_ms)
if r.status == 0 or r.status >= 500:
if r.status == 0:
mut msg := r.error
if msg.len() == 0: msg = "no answer from " + node end
_fail(err, 0, KIND_NETWORK, msg)
else:
_http_error(r.status, _raw_str(r), err)
end
http.FreeRaw(r)
_mark(c, idx, false)
if attempt + 1 < attempts and c.retry_interval_ms > 0:
time.Sleep(c.retry_interval_ms)
end
continue
end
_mark(c, idx, true)
_clear(err)
text := _raw_str(r)
http.FreeRaw(r)
if r.status >= 200 and r.status < 300:
ret text
end
_http_error(r.status, text, err)
ret ""
end
ret ""
end
func _call(c: Client, method: str, path: str, body: str, err &: Error): str:
mut ct := ""
if body.len() > 0 or method == "POST" or method == "PUT" or method == "PATCH":
ct = "application/json"
end
ret _send(c, method, path, ct, body, err)
end
func _success(body: str): bool:
ret _get_bool(body, "success")
end
func _cpath(collection: str): str:
ret "/collections/" + _esc(collection)
end
@en "New"
@fa "جدید"
pub func New(url: str, api_key: str): Client:
mut nodes := Vector {} as Vector<str>
nodes.push(url)
ret NewCluster(nodes, api_key)
end
@en "NewCluster"
@fa "خوشه جدید"
pub func NewCluster(urls: Vector<str>, api_key: str): Client:
mut c := Client { api_key = api_key }
each u in urls:
n := _normalize(u)
if n.len() > 0: c.nodes.push(n) end
end
_reset_state(c)
ret c
end
@en "SetNearestNode"
@fa "تنظیم نزدیک‌ترین گره"
pub func SetNearestNode(c &: Client, url: str):
c.nearest = _normalize(url)
_reset_state(c)
end
@en "AddNode"
@fa "افزودن گره"
pub func AddNode(c &: Client, url: str):
n := _normalize(url)
if n.len() == 0: ret end
c.nodes.push(n)
_reset_state(c)
end
@en "AddHeader"
@fa "افزودن سرصفحه"
pub func AddHeader(c &: Client, name: str, value: str):
c.headers.push(name + ": " + value)
end
@en "Free"
@fa "آزادسازی"
pub func Free(c &: Client):
c.nodes.free()
c.headers.free()
c.state.free()
c.nodes = Vector {} as Vector<str>
c.headers = Vector {} as Vector<str>
c.state = Vector {} as Vector<i64>
end
@en "NodeHealthy"
@fa "گره سالم است"
pub func NodeHealthy(c: Client, index: int): bool:
n := c.nodes.len()
if c.state.len() < n + 2: ret false end
mut slot := index + 1
if index < 0: slot = n + 1 end
if slot < 1 or slot > n + 1: ret false end
ret c.state.get(slot) <= time.NowMillis()
end
@en "Ok"
@fa "موفق"
pub func Ok(err: Error): bool:
ret err.kind.len() == 0
end
@en "IsNotFound"
@fa "پیدا نشد"
pub func IsNotFound(err: Error): bool:
ret err.status == 404
end
@en "IsConflict"
@fa "تداخل دارد"
pub func IsConflict(err: Error): bool:
ret err.status == 409
end
@en "ErrorString"
@fa "متن خطا"
pub func ErrorString(err: Error): str:
if err.kind.len() == 0: ret "" end
mut out := "typesense"
if err.status > 0:
out = out + " " + err.status
else:
out = out + " " + err.kind
end
if err.message.len() > 0:
out = out + ": " + err.message
end
ret out
end
