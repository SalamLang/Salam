package autograd
import math
import ai.tensor
func _bk_bmm(tp &: Tape, n &: Node, dc &: tensor.Tensor):
va := Value(tp, n.a)
vb := Value(tp, n.b)
b := va.shape.get(0)
rows := va.shape.get(1)
kn := va.shape.get(2)
m := vb.shape.get(2)
pd := dc.data.data
if tp.needs.get(n.a):
ga := _grad_of(tp, n.a)
repeat b in i:
mut bt := tensor.TransposeRaw(_off(vb.data.data, i * kn * m), kn, m)
tensor.GemmAcc(_off(pd, i * rows * m), bt.data.data, _off(ga.data.data, i * rows * kn), rows, m, kn)
bt.free()
end
end
if tp.needs.get(n.b):
gb := _grad_of(tp, n.b)
repeat b in i:
mut at := tensor.TransposeRaw(_off(va.data.data, i * rows * kn), rows, kn)
tensor.GemmAcc(at.data.data, _off(pd, i * rows * m), _off(gb.data.data, i * kn * m), kn, rows, m)
at.free()
end
end
end
func _bk_permute(tp &: Tape, n &: Node, dc &: tensor.Tensor):
if tp.needs.get(n.a) == false: ret end
perm := Value(tp, n.aux)
r := perm.numel()
mut inv := Vector {} as Vector<int>
inv.zeros(r)
repeat r in i: inv.set(perm.at(i) as int, i) end
mut t := tensor.Permute(dc, inv)
inv.free()
g := _grad_of(tp, n.a)
_bk_flat_add(g.data.data, t.data.data, t.numel())
t.free()
end
func _bk_embed(tp &: Tape, n &: Node, dc &: tensor.Tensor):
if tp.needs.get(n.a) == false: ret end
vw := Value(tp, n.a)
idx := Value(tp, n.aux)
g := _grad_of(tp, n.a)
d := vw.shape.get(1)
cnt := idx.numel()
pg := g.data.data
pd := dc.data.data
pi := idx.data.data
repeat cnt in i:
row := (pi[i] as int) * d
src := i * d
repeat d in k: pg[row + k] += pd[src + k] end
end
end
func _outer_inner(t &: tensor.Tensor, axis: int, outer &: int, inner &: int):
outer = 1
repeat axis in i: outer = outer * t.shape.get(i) end
inner = 1
r := t.rank()
repeat r - axis - 1 in i: inner = inner * t.shape.get(axis + 1 + i) end
end
func _bk_narrow(tp &: Tape, n &: Node, dc &: tensor.Tensor):
if tp.needs.get(n.a) == false: ret end
mut va := Value(tp, n.a)
g := _grad_of(tp, n.a)
axis := n.s0
start := n.s1
cnt := dc.shape.get(axis)
mid := va.shape.get(axis)
mut outer := 1
mut inner := 1
_outer_inner(va, axis, outer, inner)
pg := g.data.data
pd := dc.data.data
block := cnt * inner
repeat outer in o:
gbase := (o * mid + start) * inner
dbase := o * block
repeat block in k: pg[gbase + k] += pd[dbase + k] end
end
end
func _bk_concat2(tp &: Tape, n &: Node, dc &: tensor.Tensor):
mut va := Value(tp, n.a)
vb := Value(tp, n.b)
axis := n.s0
ma := va.shape.get(axis)
mb := vb.shape.get(axis)
mut outer := 1
mut inner := 1
_outer_inner(va, axis, outer, inner)
pd := dc.data.data
blocka := ma * inner
blockb := mb * inner
stride := blocka + blockb
if tp.needs.get(n.a):
g := _grad_of(tp, n.a)
pg := g.data.data
repeat outer in o:
repeat blocka in k: pg[o * blocka + k] += pd[o * stride + k] end
end
end
if tp.needs.get(n.b):
g := _grad_of(tp, n.b)
pg := g.data.data
repeat outer in o:
repeat blockb in k: pg[o * blockb + k] += pd[o * stride + blocka + k] end
end
end
end
func _rope_apply(src: f32*, dst: f32*, rows: int, seq: int, heads: int, dh: int, offset: int, theta: f64, sign: f64, accumulate: bool):
half := dh / 2
d := heads * dh
repeat rows in r:
pos := ((r % seq) + offset) as f64
repeat half in i:
freq := math.Pow(theta, 0.0 - (2.0 * (i as f64)) / (dh as f64))
angle := pos * freq * sign
c := math.Cos(angle) as f32
s := math.Sin(angle) as f32
repeat heads in h:
i0 := r * d + h * dh + i
i1 := i0 + half
x0 := src[i0]
x1 := src[i1]
y0 := x0 * c - x1 * s
y1 := x0 * s + x1 * c
if accumulate:
dst[i0] += y0
dst[i1] += y1
else:
dst[i0] = y0
dst[i1] = y1
end
end
end
end
end
func _bk_rope(tp &: Tape, n &: Node, dc &: tensor.Tensor):
if tp.needs.get(n.a) == false: ret end
va := Value(tp, n.a)
g := _grad_of(tp, n.a)
seq := n.s0
heads := n.s1
rows := va.shape.get(0)
d := va.numel() / rows
_rope_apply(dc.data.data, g.data.data, rows, seq, heads, d / heads, n.aux, n.f0, 0.0 - 1.0, true)
end
func _bk_dropout(tp &: Tape, n &: Node, dc &: tensor.Tensor):
if tp.needs.get(n.a) == false: ret end
mask := Value(tp, n.aux)
g := _grad_of(tp, n.a)
scale := (1.0 / (1.0 - n.f0)) as f32
cnt := mask.numel()
pg := g.data.data
pd := dc.data.data
pm := mask.data.data
repeat cnt in k: pg[k] += pd[k] * pm[k] * scale end
end
@en "BatchMatMul"
@fa "ضرب ماتریسی دسته‌ای"
pub func BatchMatMul(tp &: Tape, a: int, b: int): int:
mut va := Value(tp, a)
mut vb := Value(tp, b)
out := tensor.BatchMatMul(va, vb)
needs_grad := tp.needs.get(a) or tp.needs.get(b)
id := _push_val(tp, out, true, needs_grad)
if needs_grad: _record(tp, _OP_BMM, a, b, id, 0 - 1, 0, 0, 0.0) end
ret id
end
@en "Permute"
@fa "جایگشت"
pub func Permute(tp &: Tape, a: int, perm &: Vector<int>): int:
mut va := Value(tp, a)
out := tensor.Permute(va, perm)
needs_grad := tp.needs.get(a)
mut aux := 0 - 1
if needs_grad:
r := perm.len()
pt := tensor.Zeros1(r)
pp := pt.data.data
repeat r in i: pp[i] = perm.get(i) as f32 end
aux = _push_val(tp, pt, true, false)
end
id := _push_val(tp, out, true, needs_grad)
if needs_grad: _record(tp, _OP_PERMUTE, a, 0 - 1, id, aux, 0, 0, 0.0) end
ret id
end
@en "Embedding"
@fa "جاسازی"
pub func Embedding(tp &: Tape, weight: int, indices &: Vector<int>): int:
vw := Value(tp, weight)
if vw.rank() != 2: ret _push_val(tp, tensor.Empty(), true, false) end
v := vw.shape.get(0)
d := vw.shape.get(1)
cnt := indices.len()
out := tensor.Zeros2(cnt, d)
it := tensor.Zeros1(cnt)
pw := vw.data.data
po := out.data.data
pi := it.data.data
mut ok := true
repeat cnt in i:
row := indices.get(i)
if row < 0 or row >= v: ok = false end
pi[i] = row as f32
end
if ok == false:
it.free()
out.free()
ret _push_val(tp, tensor.Empty(), true, false)
end
repeat cnt in i:
src := (pi[i] as int) * d
dst := i * d
repeat d in k: po[dst + k] = pw[src + k] end
end
needs_grad := tp.needs.get(weight)
aux := _push_val(tp, it, true, false)
id := _push_val(tp, out, true, needs_grad)
if needs_grad: _record(tp, _OP_EMBED, weight, 0 - 1, id, aux, 0, 0, 0.0) end
ret id
end
@en "Dropout"
@fa "حذف تصادفی"
pub func Dropout(tp &: Tape, a: int, p: f64): int:
if tp.training == false or p <= 0.0: ret a end
if p >= 1.0: ret a end
mut va := Value(tp, a)
mut mask := tensor.Zeros(va.shape)
tensor.FillBernoulli(mask, 1.0 - p, tp.rng)
mut out := tensor.Mul(va, mask)
tensor.ScaleInPlace(out, 1.0 / (1.0 - p))
needs_grad := tp.needs.get(a)
aux := _push_val(tp, mask, true, false)
id := _push_val(tp, out, true, needs_grad)
if needs_grad: _record(tp, _OP_DROPOUT, a, 0 - 1, id, aux, 0, 0, p) end
ret id
end
@en "Narrow"
@fa "باریک‌سازی"
pub func Narrow(tp &: Tape, a: int, axis: int, start: int, len: int): int:
mut va := Value(tp, a)
out := tensor.Narrow(va, axis, start, len)
needs_grad := tp.needs.get(a)
id := _push_val(tp, out, true, needs_grad)
if needs_grad: _record(tp, _OP_NARROW, a, 0 - 1, id, 0 - 1, axis, start, 0.0) end
ret id
end
@en "SliceAxis0"
@fa "برش محور صفر"
pub func SliceAxis0(tp &: Tape, a: int, start: int, len: int): int:
ret Narrow(tp, a, 0, start, len)
end
@en "Concat2"
@fa "پیوند دو"
pub func Concat2(tp &: Tape, a: int, b: int, axis: int): int:
mut va := Value(tp, a)
mut vb := Value(tp, b)
out := tensor.Concat2(va, vb, axis)
needs_grad := tp.needs.get(a) or tp.needs.get(b)
id := _push_val(tp, out, true, needs_grad)
if needs_grad: _record(tp, _OP_CONCAT2, a, b, id, 0 - 1, axis, 0, 0.0) end
ret id
end
@en "RoPE"
@fa "جاسازی چرخشی"
pub func RoPE(tp &: Tape, a: int, seq: int, heads: int, offset: int, theta: f64): int:
va := Value(tp, a)
if va.rank() != 2 or seq <= 0 or heads <= 0: ret _push_val(tp, tensor.Empty(), true, false) end
rows := va.shape.get(0)
d := va.shape.get(1)
if d % heads != 0 or (d / heads) % 2 != 0: ret _push_val(tp, tensor.Empty(), true, false) end
out := tensor.Zeros(va.shape)
_rope_apply(va.data.data, out.data.data, rows, seq, heads, d / heads, offset, theta, 1.0, false)
needs_grad := tp.needs.get(a)
id := _push_val(tp, out, true, needs_grad)
if needs_grad: _record(tp, _OP_ROPE, a, 0 - 1, id, offset, seq, heads, theta) end
ret id
end
@en "autograd"
@fa "مشتق‌گیری خودکار"
package autograd
import ai.tensor
const _OP_ADD := 1
const _OP_SUB := 2
const _OP_MUL := 3
const _OP_DIV := 4
const _OP_NEG := 5
const _OP_SCALE := 6
const _OP_ADDS := 7
const _OP_EXP := 8
const _OP_LOG := 9
const _OP_TANH := 10
const _OP_SIGMOID := 11
const _OP_RELU := 12
const _OP_GELU := 13
const _OP_SQRT := 14
const _OP_SQUARE := 15
const _OP_POWS := 16
const _OP_MATMUL := 17
const _OP_SUM := 18
const _OP_MEAN := 19
const _OP_SUMAXIS := 20
const _OP_MEANAXIS := 21
const _OP_SOFTMAX := 22
const _OP_LOGSOFTMAX := 23
const _OP_RESHAPE := 24
const _OP_TRANSPOSE2D := 25
const _OP_CELOSS := 26
const _OP_BCEWL := 27
const _OP_CONV2D := 28
const _OP_MAXPOOL := 29
const _OP_AVGPOOL := 30
const _OP_BMM := 31
const _OP_PERMUTE := 32
const _OP_EMBED := 33
const _OP_DROPOUT := 34
const _OP_LAYERNORM := 35
const _OP_NARROW := 36
const _OP_CONCAT2 := 37
const _OP_SILU := 38
const _OP_ROPE := 39
const _OP_RMSNORM := 40
const _OP_BATCHNORM := 41
const _OP_GROUPNORM := 42
@en "Node"
@fa "گره"
pub struct Node:
@en "op"
@fa "عملیات"
pub op: int = 0
@en "a"
@fa "ورودی نخست"
pub a: int = 0 - 1
@en "b"
@fa "ورودی دوم"
pub b: int = 0 - 1
@en "out"
@fa "خروجی"
pub out: int = 0 - 1
@en "aux"
@fa "داده کمکی"
pub aux: int = 0 - 1
@en "s0"
@fa "پارامتر صحیح نخست"
pub s0: int = 0
@en "s1"
@fa "پارامتر صحیح دوم"
pub s1: int = 0
@en "f0"
@fa "پارامتر اعشاری"
pub f0: f64 = 0.0
end
@en "Tape"
@fa "نوار"
pub struct Tape:
@en "vals"
@fa "مقدارها"
pub vals: Vector<tensor.Tensor> = Vector {}
@en "grads"
@fa "گرادیان‌ها"
pub grads: Vector<tensor.Tensor> = Vector {}
@en "owns_val"
@fa "مالک مقدار"
pub owns_val: Vector<bool> = Vector {}
@en "owns_grad"
@fa "مالک گرادیان"
pub owns_grad: Vector<bool> = Vector {}
@en "needs"
@fa "نیازمند گرادیان"
pub needs: Vector<bool> = Vector {}
@en "nodes"
@fa "گره‌ها"
pub nodes: Vector<Node> = Vector {}
@en "training"
@fa "آموزش"
pub training: bool = true
@en "rng"
@fa "مولد تصادفی"
pub rng: tensor.Rng = tensor.Rng {}
@en "len"
@fa "طول"
pub func len(): int: ret this.vals.len() end
@en "reset"
@fa "بازنشانی"
pub func reset():
n := this.vals.len()
repeat n in i:
if this.owns_val.get(i):
mut v := this.vals.get(i)
v.free()
end
if this.owns_grad.get(i):
mut g := this.grads.get(i)
g.free()
end
end
this.vals.clear()
this.grads.clear()
this.owns_val.clear()
this.owns_grad.clear()
this.needs.clear()
this.nodes.clear()
end
@en "free"
@fa "آزادسازی"
pub func free():
this.reset()
this.vals.free()
this.grads.free()
this.owns_val.free()
this.owns_grad.free()
this.needs.free()
this.nodes.free()
end
end
func _alias(t &: tensor.Tensor): tensor.Tensor:
mut h := tensor.Tensor {}
h.data = t.data
h.shape = t.shape
ret h
end
func _push_val(tp &: Tape, t: tensor.Tensor, owned: bool, needs_grad: bool): int:
id := tp.vals.len()
tp.vals.push(t)
tp.grads.push(tensor.Tensor {})
tp.owns_val.push(owned)
tp.owns_grad.push(false)
tp.needs.push(needs_grad)
ret id
end
func _record(tp &: Tape, op: int, a: int, b: int, out: int, aux: int, s0: int, s1: int, f0: f64):
mut n := Node {}
n.op = op
n.a = a
n.b = b
n.out = out
n.aux = aux
n.s0 = s0
n.s1 = s1
n.f0 = f0
tp.nodes.push(n)
end
func _grad_of(tp &: Tape, v: int): tensor.Tensor:
mut g := tp.grads.get(v)
if g.data.len() == 0:
val := tp.vals.get(v)
g = tensor.Zeros(val.shape)
tp.grads.set(v, g)
tp.owns_grad.set(v, true)
end
ret g
end
@en "NewTape"
@fa "نوار جدید"
pub func NewTape(seed: i64): Tape:
mut tp := Tape {}
tp.rng = tensor.NewRng(seed)
ret tp
end
@en "Input"
@fa "ورودی"
pub func Input(tp &: Tape, t &: tensor.Tensor): int:
ret _push_val(tp, _alias(t), false, false)
end
@en "Constant"
@fa "ثابت"
pub func Constant(tp &: Tape, t &: tensor.Tensor): int:
ret _push_val(tp, tensor.Clone(t), true, false)
end
@en "Watch"
@fa "پایش"
pub func Watch(tp &: Tape, t &: tensor.Tensor): int:
ret _push_val(tp, _alias(t), false, true)
end
@en "Param"
@fa "پارامتر"
pub func Param(tp &: Tape, val &: tensor.Tensor, grad &: tensor.Tensor): int:
id := _push_val(tp, _alias(val), false, true)
tp.grads.set(id, _alias(grad))
ret id
end
@en "Value"
@fa "مقدار"
pub func Value(tp &: Tape, v: int): tensor.Tensor:
mut t := tp.vals.get(v)
ret _alias(t)
end
@en "Grad"
@fa "گرادیان"
pub func Grad(tp &: Tape, v: int): tensor.Tensor:
g := _grad_of(tp, v)
ret g
end
@en "Backward"
@fa "پس‌انتشار"
pub func Backward(tp &: Tape, loss: int):
if loss < 0 or loss >= tp.vals.len(): ret end
mut seed := _grad_of(tp, loss)
tensor.SetAll(seed, 1.0)
mut i := tp.nodes.len() - 1
until i >= 0:
mut n := tp.nodes.get(i)
g := tp.grads.get(n.out)
if g.data.len() > 0:
_backprop_node(tp, n)
end
i--
end
end
@en "GradCheck"
@fa "بررسی گرادیان"
pub func GradCheck(f: func (tensor.Tensor) f64, x &: tensor.Tensor, analytic &: tensor.Tensor, h: f64, tol: f64): bool:
if x.same_shape(analytic) == false: ret false end
hx := _alias(x)
n := x.numel()
mut ok := true
repeat n in k:
orig := x.at(k)
x.set_at(k, orig + h)
fp := f(hx)
x.set_at(k, orig - h)
fm := f(hx)
x.set_at(k, orig)
numeric := (fp - fm) / (2.0 * h)
want := analytic.at(k)
mut diff := numeric - want
if diff < 0.0: diff = 0.0 - diff end
mut scale := 1.0
mut aw := want
if aw < 0.0: aw = 0.0 - aw end
if aw > scale: scale = aw end
if diff > tol * scale: ok = false end
end
ret ok
end
@en "gguf"
@fa "جی‌جی‌یو‌اف"
package gguf
import archive
import compress
import encoding.binary
import mem
import str
@en "GGML_F32"
@fa "نوع اعشاری سی‌ودو"
pub const GGML_F32 := 0
@en "GGML_F16"
@fa "نوع اعشاری شانزده"
pub const GGML_F16 := 1
@en "GGML_Q4_0"
@fa "نوع کوانتیزه چهار صفر"
pub const GGML_Q4_0 := 2
@en "GGML_Q4_1"
@fa "نوع کوانتیزه چهار یک"
pub const GGML_Q4_1 := 3
@en "GGML_Q8_0"
@fa "نوع کوانتیزه هشت صفر"
pub const GGML_Q8_0 := 8
@en "META_STRING"
@fa "فراداده رشته"
pub const META_STRING := 8
@en "META_ARRAY"
@fa "فراداده آرایه"
pub const META_ARRAY := 9
@en "MetaValue"
@fa "مقدار فراداده"
pub struct MetaValue:
@en "kind"
@fa "گونه"
pub kind: int = 0
@en "elem_kind"
@fa "نوع عنصر"
pub elem_kind: int = 0
@en "i"
@fa "مقدار صحیح"
pub i: i64 = 0
@en "f"
@fa "مقدار اعشاری"
pub f: f64 = 0.0
@en "s"
@fa "مقدار رشته"
pub s: str = ""
@en "ints"
@fa "آرایه صحیح"
pub ints: Vector<i64> = Vector {}
@en "floats"
@fa "آرایه اعشاری"
pub floats: Vector<f64> = Vector {}
@en "strs"
@fa "آرایه رشته"
pub strs: Vector<str> = Vector {}
@en "free"
@fa "آزادسازی"
pub func free():
this.ints.free()
this.floats.free()
_free_read_str(this.s)
repeat this.strs.len() in i: _free_read_str(this.strs.get(i)) end
this.strs.free()
end
end
@en "TensorInfo"
@fa "اطلاعات تانسور"
pub struct TensorInfo:
@en "name"
@fa "نام"
pub name: str = ""
@en "dims"
@fa "ابعاد"
pub dims: Vector<int> = Vector {}
@en "ggml_type"
@fa "نوع وزن"
pub ggml_type: int = 0
@en "offset"
@fa "جابجایی"
pub offset: i64 = 0
@en "count"
@fa "شمار"
pub func count(): int:
mut n := 1
repeat this.dims.len() in i: n *= this.dims.get(i) end
ret n
end
@en "free"
@fa "آزادسازی"
pub func free():
_free_read_str(this.name)
this.dims.free()
end
end
@en "Gguf"
@fa "جی‌جی‌یو‌اف"
pub struct Gguf:
@en "version"
@fa "نسخه"
pub version: int = 0
@en "keys"
@fa "کلیدها"
pub keys: Vector<str> = Vector {}
@en "values"
@fa "مقدارها"
pub values: Vector<MetaValue> = Vector {}
@en "tensors"
@fa "تانسورها"
pub tensors: Vector<TensorInfo> = Vector {}
@en "alignment"
@fa "هم‌ترازی"
pub alignment: int = 32
@en "data_offset"
@fa "آغاز داده"
pub data_offset: int = 0
@en "raw"
@fa "بایت‌های خام"
pub raw: compress.ByteBuf = compress.ByteBuf {}
@en "meta_index"
@fa "نمایه فراداده"
pub func meta_index(key: str): int:
repeat this.keys.len() in i:
if str.Equals(this.keys.get(i), key): ret i end
end
ret 0 - 1
end
@en "meta_int"
@fa "فراداده صحیح"
pub func meta_int(key: str, dflt: i64): i64:
k := this.meta_index(key)
if k < 0: ret dflt end
ret this.values.get(k).i
end
@en "meta_str"
@fa "فراداده رشته"
pub func meta_str(key: str): str:
k := this.meta_index(key)
if k < 0: ret "" end
ret this.values.get(k).s
end
@en "tensor_index"
@fa "نمایه تانسور"
pub func tensor_index(name: str): int:
repeat this.tensors.len() in i:
t := this.tensors.get(i)
if str.Equals(t.name, name): ret i end
end
ret 0 - 1
end
@en "free"
@fa "آزادسازی"
pub func free():
repeat this.keys.len() in i: _free_read_str(this.keys.get(i)) end
this.keys.free()
repeat this.values.len() in i:
mut v := this.values.get(i)
v.free()
end
this.values.free()
repeat this.tensors.len() in i:
mut t := this.tensors.get(i)
t.free()
end
this.tensors.free()
compress.BufFree(this.raw)
end
end
func _free_read_str(s: str):
if str.Len(s) > 0: mem.Free(s as void*) end
end
func _gg_err(kind: ErrorKind, msg: str, at: int, code: str): Error:
ret Error.At(kind, msg, at).with_code(code)
end
func _read_str(rd &: compress.ByteReader): str throws:
at := rd.pos
n := try binary.ReadU64LE(rd)
if n < 0 or n > (compress.RdLeft(rd) as i64):
throw _gg_err(ErrorKind.UnexpectedEnd, "a string of " + n + " bytes but " + compress.RdLeft(rd) + " are left", at, "gguf.truncated")
end
mut b := compress.RdBytes(rd, n as int)
out := compress.BufToStrUnsafe(b)
compress.BufFree(b)
ret out
end
func _read_scalar(rd &: compress.ByteReader, kind: int, iv &: i64, fv &: f64) throws:
if kind == 0:
iv = (try binary.ReadU8(rd)) as i64
else kind == 1:
mut x := try binary.ReadU8(rd)
if x >= 128: x -= 256 end
iv = x as i64
else kind == 2:
iv = (try binary.ReadU16LE(rd)) as i64
else kind == 3:
mut x := try binary.ReadU16LE(rd)
if x >= 32768: x -= 65536 end
iv = x as i64
else kind == 4:
mut x := (try binary.ReadU32LE(rd)) as i64
if x < 0: x += 4294967296 end
iv = x
else kind == 5:
iv = (try binary.ReadU32LE(rd)) as i64
else kind == 6:
fv = try binary.ReadF32(rd, false)
else kind == 7:
iv = (try binary.ReadU8(rd)) as i64
else kind == 10 or kind == 11:
iv = try binary.ReadU64LE(rd)
else kind == 12:
fv = try binary.ReadF64(rd, false)
else:
throw _gg_err(ErrorKind.Unsupported, "unknown metadata type " + kind, rd.pos - 4, "gguf.meta_type")
end
end
func _read_value(rd &: compress.ByteReader, kind: int, v &: MetaValue) throws:
v.kind = kind
if kind == META_STRING:
v.s = try _read_str(rd)
ret
end
if kind == META_ARRAY:
at := rd.pos
ek := try binary.ReadU32LE(rd)
cnt := try binary.ReadU64LE(rd)
if cnt < 0 or cnt > (compress.RdLeft(rd) as i64):
throw _gg_err(ErrorKind.UnexpectedEnd, "an array of " + cnt + " items but " + compress.RdLeft(rd) + " bytes are left", at, "gguf.truncated")
end
v.elem_kind = ek
repeat cnt as int:
if ek == META_STRING:
v.strs.push(try _read_str(rd))
else ek == 6 or ek == 12:
mut f := 0.0
mut iv := 0 as i64
try _read_scalar(rd, ek, iv, f)
v.floats.push(f)
else:
mut f := 0.0
mut iv := 0 as i64
try _read_scalar(rd, ek, iv, f)
v.ints.push(iv)
end
end
ret
end
try _read_scalar(rd, kind, v.i, v.f)
end
func _parse(g &: Gguf) throws:
mut rd := compress.ReaderFromBuf(g.raw)
magic := try binary.ReadU32BE(rd)
if magic != 0x47475546:
throw _gg_err(ErrorKind.Syntax, "not a GGUF file (bad magic bytes)", 0, "gguf.bad_magic")
end
g.version = try binary.ReadU32LE(rd)
if g.version != 2 and g.version != 3:
throw _gg_err(ErrorKind.Unsupported, "unsupported GGUF version " + g.version, 4, "gguf.version")
end
ntensors := try binary.ReadU64LE(rd)
nkv := try binary.ReadU64LE(rd)
if ntensors < 0 or nkv < 0 or ntensors > (compress.RdLeft(rd) as i64) or nkv > (compress.RdLeft(rd) as i64):
throw _gg_err(ErrorKind.Syntax, "impossible counts: " + ntensors + " tensors, " + nkv + " metadata entries", 8, "gguf.counts")
end
repeat nkv as int:
key := try _read_str(rd)
g.keys.push(key)
kind := try binary.ReadU32LE(rd)
mut v := MetaValue {}
try:
_read_value(rd, kind, v)
catch e:
v.free()
throw e.with_path(str.Clone(key))
end
g.values.push(v)
end
repeat ntensors as int:
mut t := TensorInfo {}
t.name = try _read_str(rd)
try:
at := rd.pos
nd := binary.ReadU32LE(rd)
if nd < 0 or nd > 8:
throw _gg_err(ErrorKind.Syntax, "tensor rank " + nd + " (at most 8)", at, "gguf.rank")
end
repeat nd: t.dims.push(binary.ReadU64LE(rd) as int) end
t.ggml_type = binary.ReadU32LE(rd)
t.offset = binary.ReadU64LE(rd)
catch e:
path := str.Clone(t.name)
t.free()
throw e.with_path(path)
end
g.tensors.push(t)
end
al := g.meta_int("general.alignment", 32)
if al > 0: g.alignment = al as int end
mut off := rd.pos
if off % g.alignment != 0: off += (g.alignment - off % g.alignment) end
g.data_offset = off
end
@en "ParseGguf"
@fa "تجزیه جی‌جی‌یو‌اف"
pub func ParseGguf(buf: compress.ByteBuf): Gguf throws:
mut g := Gguf {}
g.raw = buf
try:
_parse(g)
catch e:
g.raw = compress.ByteBuf {}
g.free()
throw e.wrap("gguf")
end
ret g
end
@en "LoadGguf"
@fa "بارگذاری جی‌جی‌یو‌اف"
pub func LoadGguf(path: str): Gguf throws:
mut fok := false
mut raw := archive.ReadBinaryFile(path, fok)
if fok == false:
compress.BufFree(raw)
throw Error.New(ErrorKind.NotFound, "cannot open file").with_path(path).wrap("gguf")
end
try:
ret ParseGguf(raw)
catch e:
compress.BufFree(raw)
if e.path == "": throw e.with_path(path) end
throw e.with_path(path + ":" + e.path)
end
end
package gguf
import compress
import encoding.binary
import math
import ai.tensor
func _half(bits: int): f64:
sign := (bits >> 15) & 1
exp := (bits >> 10) & 31
frac := bits & 1023
mut v := 0.0
if exp == 0:
v = (frac as f64) * math.Pow(2.0, 0.0 - 24.0)
else exp == 31:
if frac == 0: v = 1.0e300 * 1.0e300 else:
v = 0.0 / 0.0
end
else:
v = (1.0 + (frac as f64) / 1024.0) * math.Pow(2.0, (exp - 15) as f64)
end
if sign == 1: v = 0.0 - v end
ret v
end
func _bytes_of(t &: TensorInfo): int:
n := t.count()
if t.ggml_type == GGML_F32: ret n * 4 end
if t.ggml_type == GGML_F16: ret n * 2 end
if t.ggml_type == GGML_Q8_0: ret (n / 32) * 34 end
if t.ggml_type == GGML_Q4_0: ret (n / 32) * 18 end
if t.ggml_type == GGML_Q4_1: ret (n / 32) * 20 end
ret 0 - 1
end
@en "TensorBytes"
@fa "بایت‌های تانسور"
pub func TensorBytes(g &: Gguf, index: int): int:
if index < 0 or index >= g.tensors.len(): ret 0 - 1 end
mut t := g.tensors.get(index)
ret _bytes_of(t)
end
@en "LoadTensorF32"
@fa "بارگذاری تانسور اعشاری"
pub func LoadTensorF32(g &: Gguf, index: int): tensor.Tensor throws:
if index < 0 or index >= g.tensors.len():
throw Error.New(ErrorKind.OutOfRange, "tensor index " + index + " is out of range for " + g.tensors.len() + " tensors").with_code("gguf.index").wrap("gguf")
end
mut t := g.tensors.get(index)
nbytes := _bytes_of(t)
if nbytes < 0:
throw Error.New(ErrorKind.Unsupported, "unsupported tensor type " + t.ggml_type).with_code("gguf.tensor_type").with_path(t.name).wrap("gguf")
end
n := t.count()
if t.ggml_type != GGML_F32 and t.ggml_type != GGML_F16 and n % 32 != 0:
throw Error.New(ErrorKind.Syntax, "a quantized tensor needs a multiple of 32 elements, got " + n).with_code("gguf.block").with_path(t.name).wrap("gguf")
end
start := (g.data_offset as i64) + t.offset
if t.offset < 0 or start + (nbytes as i64) > (compress.BufLen(g.raw) as i64):
throw Error.At(ErrorKind.UnexpectedEnd, "the tensor data (" + nbytes + " bytes) runs past the end of the file", start as int).with_code("gguf.truncated").with_path(t.name).wrap("gguf")
end
mut shape := Vector {} as Vector<int>
mut i := t.dims.len() - 1
until i >= 0:
shape.push(t.dims.get(i))
i--
end
if shape.len() == 0: shape.push(1) end
out := tensor.Zeros(shape)
shape.free()
p := out.data.data
mut rd := compress.NewByteReader(((g.raw.data as i64) + start) as void*, nbytes)
if t.ggml_type == GGML_F32:
repeat n in k: p[k] = try binary.ReadF32(rd, false) as f32 end
else t.ggml_type == GGML_F16:
repeat n in k: p[k] = _half(try binary.ReadU16LE(rd)) as f32 end
else t.ggml_type == GGML_Q8_0:
repeat n / 32 in b:
d := _half(try binary.ReadU16LE(rd))
repeat 32 in j:
mut q := try binary.ReadU8(rd)
if q >= 128: q -= 256 end
p[b * 32 + j] = (d * (q as f64)) as f32
end
end
else t.ggml_type == GGML_Q4_0:
repeat n / 32 in b:
d := _half(try binary.ReadU16LE(rd))
repeat 16 in j:
byte := try binary.ReadU8(rd)
lo := (byte & 15) - 8
hi := (byte >> 4) - 8
p[b * 32 + j] = (d * (lo as f64)) as f32
p[b * 32 + j + 16] = (d * (hi as f64)) as f32
end
end
else:
repeat n / 32 in b:
d := _half(try binary.ReadU16LE(rd))
m := _half(try binary.ReadU16LE(rd))
repeat 16 in j:
byte := try binary.ReadU8(rd)
lo := byte & 15
hi := byte >> 4
p[b * 32 + j] = (d * (lo as f64) + m) as f32
p[b * 32 + j + 16] = (d * (hi as f64) + m) as f32
end
end
end
ret out
end
package image
import mem
import math
@en "Histogram"
@fa "بافت‌نگار"
pub struct Histogram:
@en "r"
@fa "قرمز"
pub r: void* = null
@en "g"
@fa "سبز"
pub g: void* = null
@en "b"
@fa "آبی"
pub b: void* = null
@en "luma"
@fa "روشنایی"
pub luma: void* = null
end
func _hist_alloc(): void*:
ret mem.AllocateZeroed(256 * 4 as u64)
end
func _hist_bump(buf: void*, bucket: int):
p := buf as i32*
p[bucket]++
end
@en "ComputeHistogram"
@fa "محاسبه بافت‌نگار"
pub func ComputeHistogram(img: Image): Histogram:
mut h := Histogram { r = _hist_alloc(), g = _hist_alloc() }
h.b = _hist_alloc()
h.luma = _hist_alloc()
if img.pixels == null:
ret h
end
bp := img.pixels as u8*
mut i := 0
n := img.width * img.height
until i < n:
off := i * 4
r := bp[off] as int
g := bp[off + 1] as int
b := bp[off + 2] as int
_hist_bump(h.r, r)
_hist_bump(h.g, g)
_hist_bump(h.b, b)
_hist_bump(h.luma, (r * 299 + g * 587 + b * 114) / 1000)
i++
end
ret h
end
@en "HistogramGet"
@fa "خواندن بافت‌نگار"
pub func HistogramGet(channel: void*, bucket: int): int:
if channel == null or bucket < 0 or bucket > 255:
ret 0
end
p := channel as i32*
ret p[bucket]
end
@en "HistogramFree"
@fa "آزادسازی بافت‌نگار"
pub func HistogramFree(h &: Histogram):
if h.r != null: mem.Free(h.r) end
if h.g != null: mem.Free(h.g) end
if h.b != null: mem.Free(h.b) end
if h.luma != null: mem.Free(h.luma) end
h.r = null
h.g = null
h.b = null
h.luma = null
end
@en "Diff"
@fa "تفاوت"
pub func Diff(a: Image, b: Image): Image:
w := a.width > b.width ? a.width : b.width
h := a.height > b.height ? a.height : b.height
mut out := New(w, h)
mut y := 0
until y < h:
mut x := 0
until x < w:
ca := GetPixel(a, x, y)
cb := GetPixel(b, x, y)
dr := ca.r as int - (cb.r as int)
dg := ca.g as int - (cb.g as int)
db := ca.b as int - (cb.b as int)
SetPixel(out, x, y, RGB(_iabs(dr), _iabs(dg), _iabs(db)))
x++
end
y++
end
ret out
end
@en "MeanAbsError"
@fa "میانگین خطای مطلق"
pub func MeanAbsError(a: Image, b: Image): f64:
w := a.width > b.width ? a.width : b.width
h := a.height > b.height ? a.height : b.height
if w == 0 or h == 0: ret 0.0 end
mut total := 0.0
mut y := 0
until y < h:
mut x := 0
until x < w:
ca := GetPixel(a, x, y)
cb := GetPixel(b, x, y)
total += (_iabs(ca.r as int - (cb.r as int)) as f64)
total += (_iabs(ca.g as int - (cb.g as int)) as f64)
total += (_iabs(ca.b as int - (cb.b as int)) as f64)
x++
end
y++
end
ret total / ((w * h * 3) as f64)
end
@en "PSNR"
@fa "نسبت سیگنال به نویز"
pub func PSNR(a: Image, b: Image): f64:
w := a.width > b.width ? a.width : b.width
h := a.height > b.height ? a.height : b.height
if w == 0 or h == 0: ret 100.0 end
mut sq_sum := 0.0
mut y := 0
until y < h:
mut x := 0
until x < w:
ca := GetPixel(a, x, y)
cb := GetPixel(b, x, y)
dr := (ca.r as int) - (cb.r as int)
dg := (ca.g as int) - (cb.g as int)
db := (ca.b as int) - (cb.b as int)
sq_sum += (dr * dr + dg * dg + db * db) as f64
x++
end
y++
end
mse := sq_sum / ((w * h * 3) as f64)
if mse <= 0.0: ret 100.0 end
ret 10.0 * math.Log10(65025.0 / mse)
end
package image
import str
@en "FontWidth"
@fa "عرض قلم"
pub const FontWidth := 5
@en "FontHeight"
@fa "ارتفاع قلم"
pub const FontHeight := 7
func _glyph(ch: int): str:
if ch == 48: ret ".###." + "#...#" + "#..##" + "#.#.#" + "##..#" + "#...#" + ".###." end
if ch == 49: ret "..#.." + ".##.." + "..#.." + "..#.." + "..#.." + "..#.." + ".###." end
if ch == 50: ret ".###." + "#...#" + "....#" + "...#." + "..#.." + ".#..." + "#####" end
if ch == 51: ret ".###." + "#...#" + "....#" + "..##." + "....#" + "#...#" + ".###." end
if ch == 52: ret "...#." + "..##." + ".#.#." + "#..#." + "#####" + "...#." + "...#." end
if ch == 53: ret "#####" + "#...." + "####." + "....#" + "....#" + "#...#" + ".###." end
if ch == 54: ret ".###." + "#...." + "#...." + "####." + "#...#" + "#...#" + ".###." end
if ch == 55: ret "#####" + "....#" + "...#." + "..#.." + "..#.." + "..#.." + "..#.." end
if ch == 56: ret ".###." + "#...#" + "#...#" + ".###." + "#...#" + "#...#" + ".###." end
if ch == 57: ret ".###." + "#...#" + "#...#" + ".####" + "....#" + "....#" + ".###." end
if ch == 65: ret "..#.." + ".#.#." + "#...#" + "#####" + "#...#" + "#...#" + "#...#" end
if ch == 66: ret "####." + "#...#" + "#...#" + "####." + "#...#" + "#...#" + "####." end
if ch == 67: ret ".###." + "#...#" + "#...." + "#...." + "#...." + "#...#" + ".###." end
if ch == 68: ret "####." + "#...#" + "#...#" + "#...#" + "#...#" + "#...#" + "####." end
if ch == 69: ret "#####" + "#...." + "#...." + "####." + "#...." + "#...." + "#####" end
if ch == 70: ret "#####" + "#...." + "#...." + "####." + "#...." + "#...." + "#...." end
if ch == 71: ret ".###." + "#...#" + "#...." + "#.###" + "#...#" + "#...#" + ".####" end
if ch == 72: ret "#...#" + "#...#" + "#...#" + "#####" + "#...#" + "#...#" + "#...#" end
if ch == 73: ret ".###." + "..#.." + "..#.." + "..#.." + "..#.." + "..#.." + ".###." end
if ch == 74: ret "..###" + "...#." + "...#." + "...#." + "...#." + "#..#." + ".##.." end
if ch == 75: ret "#...#" + "#..#." + "#.#.." + "##..." + "#.#.." + "#..#." + "#...#" end
if ch == 76: ret "#...." + "#...." + "#...." + "#...." + "#...." + "#...." + "#####" end
if ch == 77: ret "#...#" + "##.##" + "#.#.#" + "#...#" + "#...#" + "#...#" + "#...#" end
if ch == 78: ret "#...#" + "##..#" + "#.#.#" + "#..##" + "#...#" + "#...#" + "#...#" end
if ch == 79: ret ".###." + "#...#" + "#...#" + "#...#" + "#...#" + "#...#" + ".###." end
if ch == 80: ret "####." + "#...#" + "#...#" + "####." + "#...." + "#...." + "#...." end
if ch == 81: ret ".###." + "#...#" + "#...#" + "#...#" + "#.#.#" + "#..#." + ".##.#" end
if ch == 82: ret "####." + "#...#" + "#...#" + "####." + "#.#.." + "#..#." + "#...#" end
if ch == 83: ret ".####" + "#...." + "#...." + ".###." + "....#" + "....#" + "####." end
if ch == 84: ret "#####" + "..#.." + "..#.." + "..#.." + "..#.." + "..#.." + "..#.." end
if ch == 85: ret "#...#" + "#...#" + "#...#" + "#...#" + "#...#" + "#...#" + ".###." end
if ch == 86: ret "#...#" + "#...#" + "#...#" + "#...#" + "#...#" + ".#.#." + "..#.." end
if ch == 87: ret "#...#" + "#...#" + "#...#" + "#.#.#" + "#.#.#" + "##.##" + "#...#" end
if ch == 88: ret "#...#" + "#...#" + ".#.#." + "..#.." + ".#.#." + "#...#" + "#...#" end
if ch == 89: ret "#...#" + "#...#" + ".#.#." + "..#.." + "..#.." + "..#.." + "..#.." end
if ch == 90: ret "#####" + "....#" + "...#." + "..#.." + ".#..." + "#...." + "#####" end
if ch == 46: ret "....." + "....." + "....." + "....." + "....." + "..#.." + "..#.." end
if ch == 44: ret "....." + "....." + "....." + "....." + "....." + "..#.." + ".#..." end
if ch == 45: ret "....." + "....." + "....." + "#####" + "....." + "....." + "....." end
if ch == 58: ret "....." + "..#.." + "....." + "....." + "..#.." + "....." + "....." end
if ch == 33: ret "..#.." + "..#.." + "..#.." + "..#.." + "..#.." + "....." + "..#.." end
if ch == 63: ret ".###." + "#...#" + "....#" + "..##." + "..#.." + "....." + "..#.." end
ret "....." + "....." + "....." + "....." + "....." + "....." + "....."
end
func _text_glyph_byte(s: str, i: int): int:
bp := s as u8*
ret bp[i] as int
end
@en "DrawText"
@fa "نوشتن متن"
pub func DrawText(img &: Image, x: int, y: int, text: str, c: Color, scale: int):
s := scale < 1 ? 1 : scale
n := str.Len(text)
bp := text as u8*
mut pen_x := x
mut i := 0
until i < n:
ch := bp[i] as int
glyph := _glyph(ch)
mut row := 0
until row < FontHeight:
mut col := 0
until col < FontWidth:
gp := _text_glyph_byte(glyph, row * FontWidth + col)
if gp == 35:
DrawRectFilled(img, pen_x + col * s, y + row * s, s, s, c)
end
col++
end
row++
end
pen_x += (FontWidth + 1) * s
i++
end
end
@en "TextWidth"
@fa "عرض متن"
pub func TextWidth(text: str, scale: int): int:
s := scale < 1 ? 1 : scale
ret str.Len(text) * (FontWidth + 1) * s
end
package image
import compress
import archive
import mem
func _row_stride(width: int, bytes_per_pixel: int): int:
ret ((width * bytes_per_pixel + 3) / 4) * 4
end
func _bmp_channel(v: int, mask: int): int:
if mask == 0:
ret 0
end
mut m := mask
mut shift := 0
until (m & 1) == 0 and shift < 32:
m = (m >> 1) & 2147483647
shift++
end
mut bits := 0
until (m & 1) == 1 and bits < 32:
m = (m >> 1) & 2147483647
bits++
end
val := ((v >> shift) & ((1 << bits) - 1))
if bits >= 8:
ret (val >> (bits - 8)) & 255
end
mut out := val << (8 - bits)
mut s := bits
until s < 8:
out |= (out >> s)
s *= 2
end
ret out & 255
end
func _bmp_put(dst: u8*, width: int, height: int, top_down: bool, x: int, row: int, c: int):
if x < 0 or x >= width or row < 0 or row >= height:
ret
end
y := top_down ? row : height - 1 - row
o := (y * width + x) * 4
dst[o] = ((c >> 16) & 255) as u8
dst[o + 1] = ((c >> 8) & 255) as u8
dst[o + 2] = (c & 255) as u8
dst[o + 3] = 255 as u8
end
func _bmp_rle(bp: u8*, off: int, n: int, four: bool, width: int, height: int, top_down: bool, pal: Vector<int>, dst: u8*): bool:
mut at := off
mut x := 0
mut row := 0
until at + 1 < n and row < height:
count := bp[at] as int
val := bp[at + 1] as int
at += 2
if count > 0:
repeat count in k:
idx := four ? ((k % 2) == 0 ? val >> 4 : val & 15) : val
_bmp_put(dst, width, height, top_down, x, row, idx < pal.len() ? pal.get(idx) : 0)
x++
end
else val == 0:
x = 0
row++
else val == 1:
ret true
else val == 2:
if at + 1 >= n:
ret true
end
x += bp[at] as int
row += bp[at + 1] as int
at += 2
else:
bytes := four ? (val + 1) / 2 : val
if at + bytes > n:
ret true
end
repeat val in k:
mut idx := 0
if four:
b := bp[at + k / 2] as int
idx = (k % 2) == 0 ? b >> 4 : b & 15
else:
idx = bp[at + k] as int
end
_bmp_put(dst, width, height, top_down, x, row, idx < pal.len() ? pal.get(idx) : 0)
x++
end
at += bytes + (bytes % 2)
end
end
ret true
end
@en "EncodeBMP"
@fa "کدگذاری بی‌ام‌پی"
pub func EncodeBMP(img: Image): compress.ByteBuf:
mut out := compress.NewByteBuf()
w := img.width
h := img.height
pixel_bytes := w * h * 4
file_size := 138 + pixel_bytes
compress.BufPush(out, 66)
compress.BufPush(out, 77)
archive.LEPut32(out, file_size)
archive.LEPut32(out, 0)
archive.LEPut32(out, 138)
archive.LEPut32(out, 124)
archive.LEPut32(out, w)
archive.LEPut32(out, h)
archive.LEPut16(out, 1)
archive.LEPut16(out, 32)
archive.LEPut32(out, 3)
archive.LEPut32(out, pixel_bytes)
archive.LEPut32(out, 2835)
archive.LEPut32(out, 2835)
archive.LEPut32(out, 0)
archive.LEPut32(out, 0)
archive.LEPut32(out, 16711680)
archive.LEPut32(out, 65280)
archive.LEPut32(out, 255)
archive.LEPut32(out, 0 - 16777216)
archive.LEPut32(out, 1934772034)
repeat 12:
archive.LEPut32(out, 0)
end
archive.LEPut32(out, 4)
repeat 3:
archive.LEPut32(out, 0)
end
if img.pixels != null:
mut y := h - 1
until y >= 0:
mut x := 0
until x < w:
c := GetPixel(img, x, y)
compress.BufPush(out, c.b as int)
compress.BufPush(out, c.g as int)
compress.BufPush(out, c.r as int)
compress.BufPush(out, c.a as int)
x++
end
y--
end
end
ret out
end
@en "SaveBMP"
@fa "ذخیره بی‌ام‌پی"
pub func SaveBMP(img: Image, path: str): bool:
mut buf := EncodeBMP(img)
ok := archive.WriteBinaryFileBuf(path, buf)
compress.BufFree(buf)
ret ok
end
@en "DecodeBMP"
@fa "کدگشایی بی‌ام‌پی"
pub func DecodeBMP(p: void*, n: int, ok &: bool): Image:
ok = false
if n < 26:
ret New(0, 0)
end
bp := p as u8*
if (bp[0] as int) != 66 or (bp[1] as int) != 77:
ret New(0, 0)
end
off := archive.LEGet32(p, 10)
dib := archive.LEGet32(p, 14)
mut width := 0
mut height := 0
mut bpp := 0
mut comp := 0
mut used := 0
mut entry := 4
if dib == 12:
width = archive.LEGet16(p, 18)
height = archive.LEGet16(p, 20)
bpp = archive.LEGet16(p, 24)
entry = 3
else dib >= 16 and dib <= 124 and n >= 14 + dib:
width = archive.LEGet32(p, 18)
height = archive.LEGet32(p, 22)
bpp = archive.LEGet16(p, 28)
if dib >= 20:
comp = archive.LEGet32(p, 30)
end
if dib >= 36:
used = archive.LEGet32(p, 46)
end
if dib == 64 and (comp == 3 or comp == 4):
ret New(0, 0)
end
else:
ret New(0, 0)
end
if comp == 4 or comp == 5:
if off <= 0 or off >= n:
ret New(0, 0)
end
inner := ((p as i64) + (off as i64)) as void*
ret comp == 4 ? DecodeJPEG(inner, n - off, ok) : DecodePNG(inner, n - off, ok)
end
top_down := height < 0
if top_down:
height = 0 - height
end
if width <= 0 or height <= 0 or (width as i64) * (height as i64) > (268435456 as i64):
ret New(0, 0)
end
if bpp != 1 and bpp != 2 and bpp != 4 and bpp != 8 and bpp != 16 and bpp != 24 and bpp != 32:
ret New(0, 0)
end
if comp != 0 and comp != 1 and comp != 2 and comp != 3 and comp != 6:
ret New(0, 0)
end
if (comp == 1 and bpp != 8) or (comp == 2 and bpp != 4) or ((comp == 3 or comp == 6) and bpp != 16 and bpp != 32):
ret New(0, 0)
end
mut rmask := 0
mut gmask := 0
mut bmask := 0
mut amask := 0
mut explicit_alpha := false
mut pal_at := 14 + dib
if comp == 3 or comp == 6:
mat := 54
if dib == 40:
pal_at += comp == 6 ? 16 : 12
end
if mat + 12 > n:
ret New(0, 0)
end
rmask = archive.LEGet32(p, mat)
gmask = archive.LEGet32(p, mat + 4)
bmask = archive.LEGet32(p, mat + 8)
if (comp == 6 or dib >= 56) and mat + 16 <= n:
amask = archive.LEGet32(p, mat + 12)
explicit_alpha = amask != 0
end
else bpp == 16:
rmask = 31744
gmask = 992
bmask = 31
else bpp == 32:
rmask = 16711680
gmask = 65280
bmask = 255
amask = 0 - 16777216
end
mut pal := Vector {} as Vector<int>
if bpp <= 8:
count := used > 0 and used < (1 << bpp) ? used : 1 << bpp
repeat count in i:
at := pal_at + i * entry
if at + 3 <= n and (off <= 0 or at + 3 <= off or off < pal_at):
pal.push(((bp[at + 2] as int) << 16) | ((bp[at + 1] as int) << 8) | (bp[at] as int))
end
end
end
if off <= 0 or off >= n:
pal.free()
ret New(0, 0)
end
out := New(width, height)
dst := out.pixels as u8*
mut good := true
if comp == 1 or comp == 2:
good = _bmp_rle(bp, off, n, comp == 2, width, height, top_down, pal, dst)
else:
stride64 := (((width as i64) * (bpp as i64) + (31 as i64)) / (32 as i64)) * (4 as i64)
if (off as i64) + stride64 * (height as i64) > (n as i64):
good = false
else:
stride := stride64 as int
mut any_alpha := false
repeat height in row:
y := top_down ? row : height - 1 - row
at := off + row * stride
repeat width in x:
o := (y * width + x) * 4
if bpp <= 8:
bit := x * bpp
idx := ((bp[at + bit / 8] as int) >> (8 - bpp - bit % 8)) & ((1 << bpp) - 1)
c := idx < pal.len() ? pal.get(idx) : 0
dst[o] = ((c >> 16) & 255) as u8
dst[o + 1] = ((c >> 8) & 255) as u8
dst[o + 2] = (c & 255) as u8
dst[o + 3] = 255 as u8
else bpp == 24:
q := at + x * 3
dst[o] = bp[q + 2]
dst[o + 1] = bp[q + 1]
dst[o + 2] = bp[q]
dst[o + 3] = 255 as u8
else:
mut v := 0
if bpp == 16:
v = archive.LEGet16(p, at + x * 2)
else:
v = archive.LEGet32(p, at + x * 4)
end
dst[o] = _bmp_channel(v, rmask) as u8
dst[o + 1] = _bmp_channel(v, gmask) as u8
dst[o + 2] = _bmp_channel(v, bmask) as u8
a := amask != 0 ? _bmp_channel(v, amask) : 255
if a != 0:
any_alpha = true
end
dst[o + 3] = a as u8
end
end
end
if bpp == 32 and not explicit_alpha and not any_alpha:
repeat width * height in i:
dst[i * 4 + 3] = 255 as u8
end
end
end
end
pal.free()
if not good:
mut bad := out
Free(bad)
ret New(0, 0)
end
ok = true
ret out
end
@en "OpenBMP"
@fa "بازکردن بی‌ام‌پی"
pub func OpenBMP(path: str, ok &: bool): Image:
mut read_ok := false
mut buf := archive.ReadBinaryFile(path, read_ok)
if not read_ok:
ok = false
ret New(0, 0)
end
out := DecodeBMP(buf.data, buf.len, ok)
compress.BufFree(buf)
ret out
end
package image
import compress
import archive
import str
import filepath
@en "FormatUnknown"
@fa "قالب نامشخص"
pub const FormatUnknown := 0
@en "FormatPNG"
@fa "قالب پی‌ان‌جی"
pub const FormatPNG := 1
@en "FormatBMP"
@fa "قالب بی‌ام‌پی"
pub const FormatBMP := 2
@en "FormatJPEG"
@fa "قالب جی‌پگ"
pub const FormatJPEG := 3
@en "FormatWebP"
@fa "قالب وب‌پی"
pub const FormatWebP := 4
@en "FormatGIF"
@fa "قالب گیف"
pub const FormatGIF := 5
@en "DetectFormat"
@fa "شناسایی قالب"
pub func DetectFormat(p: void*, n: int): int:
if n < 12:
ret FormatUnknown
end
bp := p as u8*
if n >= 8 and (bp[0] as int) == 137 and (bp[1] as int) == 80 and (bp[2] as int) == 78 and (bp[3] as int) == 71:
ret FormatPNG
end
if (bp[0] as int) == 66 and (bp[1] as int) == 77:
ret FormatBMP
end
if (bp[0] as int) == 0xFF and (bp[1] as int) == 0xD8:
ret FormatJPEG
end
if (bp[0] as int) == 82 and (bp[1] as int) == 73 and (bp[2] as int) == 70 and (bp[3] as int) == 70 and (bp[8] as int) == 87 and (bp[9] as int) == 69 and (bp[10] as int) == 66 and (bp[11] as int) == 80:
ret FormatWebP
end
if IsGIF(p, n):
ret FormatGIF
end
ret FormatUnknown
end
@en "FormatFromExt"
@fa "قالب از پسوند"
pub func FormatFromExt(path: str): int:
ext := str.Lower(filepath.Ext(path))
if ext == ".png": ret FormatPNG end
if ext == ".bmp": ret FormatBMP end
if ext == ".jpg" or ext == ".jpeg": ret FormatJPEG end
if ext == ".webp": ret FormatWebP end
if ext == ".gif": ret FormatGIF end
ret FormatUnknown
end
@en "Decode"
@fa "کدگشایی"
pub func Decode(p: void*, n: int, ok &: bool): Image:
fmt := DetectFormat(p, n)
if fmt == FormatPNG: ret DecodePNG(p, n, ok) end
if fmt == FormatBMP: ret DecodeBMP(p, n, ok) end
if fmt == FormatJPEG: ret DecodeJPEG(p, n, ok) end
if fmt == FormatWebP: ret DecodeWebP(p, n, ok) end
if fmt == FormatGIF: ret DecodeGIF(p, n, ok) end
ok = false
ret New(0, 0)
end
@en "Open"
@fa "بازکردن"
pub func Open(path: str, ok &: bool): Image:
mut read_ok := false
mut buf := archive.ReadBinaryFile(path, read_ok)
if not read_ok:
ok = false
ret New(0, 0)
end
out := Decode(buf.data, buf.len, ok)
compress.BufFree(buf)
ret out
end
@en "FlattenAlpha"
@fa "تخت کردن آلفا"
pub func FlattenAlpha(img: Image, bg: Color): Image:
mut out := New(img.width, img.height)
Fill(out, bg)
mut y := 0
until y < img.height:
mut x := 0
until x < img.width:
BlendPixel(out, x, y, GetPixel(img, x, y))
x++
end
y++
end
ret out
end
@en "Convert"
@fa "تبدیل"
pub func Convert(img: Image, format: int): Image:
if format == FormatJPEG:
ret FlattenAlpha(img, RGB(255, 255, 255))
end
ret Clone(img)
end
@en "Encode"
@fa "کدگذاری"
pub func Encode(img: Image, format: int, quality: int): compress.ByteBuf:
if format == FormatPNG: ret EncodePNG(img) end
if format == FormatBMP: ret EncodeBMP(img) end
if format == FormatWebP: ret EncodeWebPQuality(img, quality) end
if format == FormatGIF: ret EncodeGIF(img) end
if format == FormatJPEG:
mut flat := Convert(img, format)
out := EncodeJPEG(flat, quality)
Free(flat)
ret out
end
ret compress.NewByteBuf()
end
@en "SaveQuality"
@fa "ذخیره با کیفیت"
pub func SaveQuality(img: Image, path: str, quality: int): bool:
format := FormatFromExt(path)
if format == FormatUnknown:
ret false
end
mut buf := Encode(img, format, quality)
if buf.len == 0:
compress.BufFree(buf)
ret false
end
ok := archive.WriteBinaryFileBuf(path, buf)
compress.BufFree(buf)
ret ok
end
@en "Save"
@fa "ذخیره"
pub func Save(img: Image, path: str): bool:
ret SaveQuality(img, path, 90)
end
package image
import math
func _iabs(v: int): int:
if v < 0: ret -v end
ret v
end
func _imin(a: int, b: int): int:
if a < b: ret a end
ret b
end
func _imax(a: int, b: int): int:
if a > b: ret a end
ret b
end
@en "DrawLine"
@fa "رسم خط"
pub func DrawLine(img &: Image, x0: int, y0: int, x1: int, y1: int, c: Color):
dx := _iabs(x1 - x0)
dy := -_iabs(y1 - y0)
mut sx := 1
if x0 >= x1: sx = -1 end
mut sy := 1
if y0 >= y1: sy = -1 end
mut err := dx + dy
mut x := x0
mut y := y0
until true:
BlendPixel(img, x, y, c)
if x == x1 and y == y1: break end
e2 := 2 * err
if e2 >= dy:
err += dy
x += sx
end
if e2 <= dx:
err += dx
y += sy
end
end
end
@en "DrawRect"
@fa "رسم مستطیل"
pub func DrawRect(img &: Image, x: int, y: int, w: int, h: int, c: Color):
if w <= 0 or h <= 0: ret end
x1 := x + w - 1
y1 := y + h - 1
DrawLine(img, x, y, x1, y, c)
DrawLine(img, x, y1, x1, y1, c)
DrawLine(img, x, y, x, y1, c)
DrawLine(img, x1, y, x1, y1, c)
end
@en "DrawRectFilled"
@fa "رسم مستطیل پر"
pub func DrawRectFilled(img &: Image, x: int, y: int, w: int, h: int, c: Color):
if w <= 0 or h <= 0: ret end
x0 := _imax(x, 0)
y0 := _imax(y, 0)
x1 := _imin(x + w, img.width)
y1 := _imin(y + h, img.height)
mut yy := y0
until yy < y1:
mut xx := x0
until xx < x1:
BlendPixel(img, xx, yy, c)
xx++
end
yy++
end
end
@en "DrawCircle"
@fa "رسم دایره"
pub func DrawCircle(img &: Image, cx: int, cy: int, radius: int, c: Color):
if radius <= 0:
BlendPixel(img, cx, cy, c)
ret
end
mut x := radius
mut y := 0
mut err := 0
until y <= x:
BlendPixel(img, cx + x, cy + y, c)
BlendPixel(img, cx + y, cy + x, c)
BlendPixel(img, cx - y, cy + x, c)
BlendPixel(img, cx - x, cy + y, c)
BlendPixel(img, cx - x, cy - y, c)
BlendPixel(img, cx - y, cy - x, c)
BlendPixel(img, cx + y, cy - x, c)
BlendPixel(img, cx + x, cy - y, c)
y++
if err <= 0:
err += 2 * y + 1
end
if err > 0:
x--
err -= 2 * x + 1
end
end
end
@en "DrawCircleFilled"
@fa "رسم دایره پر"
pub func DrawCircleFilled(img &: Image, cx: int, cy: int, radius: int, c: Color):
if radius <= 0:
BlendPixel(img, cx, cy, c)
ret
end
r2 := radius * radius
mut dy := -radius
until dy <= radius:
dx_max := math.Sqrt((r2 - dy * dy) as f64) as int
mut dx := -dx_max
until dx <= dx_max:
BlendPixel(img, cx + dx, cy + dy, c)
dx++
end
dy++
end
end
package image
func _clamp255(v: int): int:
if v < 0: ret 0 end
if v > 255: ret 255 end
ret v
end
func _copy_pixels(dst &: Image, src: Image):
if dst.pixels == null or src.pixels == null: ret end
n := (src.width * src.height * 4) as u64
mut i := 0 as u64
dp := dst.pixels as u8*
sp := src.pixels as u8*
until i < n:
dp[i as int] = sp[i as int]
i++
end
end
@en "Grayscale"
@fa "خاکستری کردن"
pub func Grayscale(img &: Image):
if img.pixels == null: ret end
bp := img.pixels as u8*
mut i := 0
n := img.width * img.height
until i < n:
off := i * 4
r := bp[off] as int
g := bp[off + 1] as int
b := bp[off + 2] as int
l := (r * 299 + g * 587 + b * 114) / 1000
lv := l as u8
bp[off] = lv
bp[off + 1] = lv
bp[off + 2] = lv
i++
end
end
@en "Invert"
@fa "معکوس کردن"
pub func Invert(img &: Image):
if img.pixels == null: ret end
bp := img.pixels as u8*
mut i := 0
n := img.width * img.height
until i < n:
off := i * 4
bp[off] = (255 - (bp[off] as int)) as u8
bp[off + 1] = (255 - (bp[off + 1] as int)) as u8
bp[off + 2] = (255 - (bp[off + 2] as int)) as u8
i++
end
end
@en "Brightness"
@fa "روشنایی"
pub func Brightness(img &: Image, delta: int):
if img.pixels == null: ret end
bp := img.pixels as u8*
mut i := 0
n := img.width * img.height
until i < n:
off := i * 4
bp[off] = _clamp255((bp[off] as int) + delta) as u8
bp[off + 1] = _clamp255((bp[off + 1] as int) + delta) as u8
bp[off + 2] = _clamp255((bp[off + 2] as int) + delta) as u8
i++
end
end
@en "Contrast"
@fa "کنتراست"
pub func Contrast(img &: Image, factor: f64):
if img.pixels == null: ret end
bp := img.pixels as u8*
mut i := 0
n := img.width * img.height
until i < n:
off := i * 4
r := (((bp[off] as f64) - 128.0) * factor + 128.0) as int
g := (((bp[off + 1] as f64) - 128.0) * factor + 128.0) as int
b := (((bp[off + 2] as f64) - 128.0) * factor + 128.0) as int
bp[off] = _clamp255(r) as u8
bp[off + 1] = _clamp255(g) as u8
bp[off + 2] = _clamp255(b) as u8
i++
end
end
@en "Threshold"
@fa "آستانه"
pub func Threshold(img &: Image, level: int):
if img.pixels == null: ret end
bp := img.pixels as u8*
mut i := 0
n := img.width * img.height
until i < n:
off := i * 4
r := bp[off] as int
g := bp[off + 1] as int
b := bp[off + 2] as int
l := (r * 299 + g * 587 + b * 114) / 1000
mut v := 0 as u8
if l >= level: v = 255 as u8 end
bp[off] = v
bp[off + 1] = v
bp[off + 2] = v
i++
end
end
@en "Blurred"
@fa "تار شده"
pub func Blurred(img: Image, radius: int): Image:
mut out := New(img.width, img.height)
if IsEmpty(img) or radius <= 0:
if not IsEmpty(img): _copy_pixels(out, img) end
ret out
end
mut y := 0
until y < img.height:
mut x := 0
until x < img.width:
mut sr := 0
mut sg := 0
mut sb := 0
mut sa := 0
mut count := 0
mut dy := -radius
until dy <= radius:
sy := _clampi(y + dy, 0, img.height - 1)
mut dx := -radius
until dx <= radius:
sx := _clampi(x + dx, 0, img.width - 1)
c := GetPixel(img, sx, sy)
sr += c.r as int
sg += c.g as int
sb += c.b as int
sa += c.a as int
count++
dx++
end
dy++
end
SetPixel(out, x, y, RGBA(sr / count, sg / count, sb / count, sa / count))
x++
end
y++
end
ret out
end
@en "Sharpened"
@fa "تیزتر شده"
pub func Sharpened(img: Image, amount: f64): Image:
mut out := New(img.width, img.height)
if IsEmpty(img):
ret out
end
mut y := 0
until y < img.height:
mut x := 0
until x < img.width:
center := GetPixel(img, x, y)
up := GetPixel(img, x, _clampi(y - 1, 0, img.height - 1))
down := GetPixel(img, x, _clampi(y + 1, 0, img.height - 1))
left := GetPixel(img, _clampi(x - 1, 0, img.width - 1), y)
right := GetPixel(img, _clampi(x + 1, 0, img.width - 1), y)
cr := (center.r as f64) * (1.0 + 4.0 * amount) - amount * ((up.r as f64) + (down.r as f64) + (left.r as f64) + (right.r as f64))
cg := (center.g as f64) * (1.0 + 4.0 * amount) - amount * ((up.g as f64) + (down.g as f64) + (left.g as f64) + (right.g as f64))
cb := (center.b as f64) * (1.0 + 4.0 * amount) - amount * ((up.b as f64) + (down.b as f64) + (left.b as f64) + (right.b as f64))
SetPixel(out, x, y, RGBA(cr as int, cg as int, cb as int, center.a as int))
x++
end
y++
end
ret out
end
@en "Overlay"
@fa "روپوش"
pub func Overlay(base &: Image, mark: Image, x: int, y: int, opacity: f64):
if IsEmpty(mark): ret end
mut op := opacity
if op < 0.0: op = 0.0 end
if op > 1.0: op = 1.0 end
mut yy := 0
until yy < mark.height:
mut xx := 0
until xx < mark.width:
c := GetPixel(mark, xx, yy)
a := ((c.a as f64) * op) as int
if a > 0:
BlendPixel(base, x + xx, y + yy, RGBA(c.r as int, c.g as int, c.b as int, a))
end
xx++
end
yy++
end
end
package image
import compress
import archive
struct _GifLzw:
pub w: compress.BitWriter = compress.BitWriter {}
pub min: int = 2
pub dsize: int = 3
pub dnext: int = 6
pub dprev: bool = false
end
func _gif_u16(bp: u8*, at: int): int:
ret (bp[at] as int) | ((bp[at + 1] as int) << 8)
end
func _gif_lzw(data: compress.ByteBuf, min: int, total: int, out &: Vector<int>): bool:
if min < 2 or min > 8:
ret false
end
clear := 1 << min
eoi := clear + 1
mut prefix := Vector {} as Vector<int>
mut suffix := Vector {} as Vector<int>
mut length := Vector {} as Vector<int>
repeat 4096 in i:
prefix.push(0 - 1)
suffix.push(i < clear ? i : 0)
length.push(i < clear ? 1 : 0)
end
mut r := compress.NewBitReader(data.data, compress.BufLen(data))
mut size := min + 1
mut next := eoi + 1
mut prev := 0 - 1
mut good := true
mut done := false
until not done and out.len() < total:
code := compress.BitReadBits(r, size)
if r.bad:
done = true
else code == clear:
size = min + 1
next = eoi + 1
prev = 0 - 1
else code == eoi:
done = true
else:
cur := code
mut first := 0
if code < next and length.get(code) > 0:
mut c := code
until prefix.get(c) >= 0:
c = prefix.get(c)
end
first = suffix.get(c)
else code == next and prev >= 0:
mut c := prev
until prefix.get(c) >= 0:
c = prefix.get(c)
end
first = suffix.get(c)
else:
good = false
done = true
end
if not done:
if prev >= 0 and next < 4096:
prefix.set(next, prev)
suffix.set(next, first)
length.set(next, length.get(prev) + 1)
next++
if next == (1 << size) and size < 12:
size++
end
end
n := length.get(cur)
base := out.len()
repeat n:
out.push(0)
end
mut k := base + n - 1
mut c := cur
until c >= 0:
if k < total:
out.set(k, suffix.get(c))
end
k--
c = prefix.get(c)
end
prev = code
end
end
end
prefix.free()
suffix.free()
length.free()
until out.len() > total:
out.pop()
end
ret good
end
func _gif_find(keys: Vector<int>, key: int): int:
mask := keys.len() - 1
mut h := ((((key as i64) * (40503 as i64)) >> 4) & (mask as i64)) as int
until keys.get(h) != 0 - 1 and keys.get(h) != key:
h = (h + 1) & mask
end
ret h
end
func _gif_exact(bp: u8*, total: int, limit: int, pal &: Vector<int>, keys &: Vector<int>, vals &: Vector<int>): bool:
repeat 1024:
keys.push(0 - 1)
vals.push(0)
end
repeat total in i:
if (bp[i * 4 + 3] as int) >= 128:
rgb := ((bp[i * 4] as int) << 16) | ((bp[i * 4 + 1] as int) << 8) | (bp[i * 4 + 2] as int)
h := _gif_find(keys, rgb)
if keys.get(h) != rgb:
if pal.len() >= limit:
ret false
end
keys.set(h, rgb)
vals.set(h, pal.len())
pal.push(rgb)
end
end
end
ret true
end
func _gif_bin(r: int, g: int, b: int): int:
ret ((r >> 3) << 10) | ((g >> 3) << 5) | (b >> 3)
end
func _gif_median(bp: u8*, total: int, limit: int, pal &: Vector<int>):
mut cnt := Vector {} as Vector<int>
mut sr := Vector {} as Vector<int>
mut sg := Vector {} as Vector<int>
mut sb := Vector {} as Vector<int>
repeat 32768:
cnt.push(0)
sr.push(0)
sg.push(0)
sb.push(0)
end
repeat total in i:
if (bp[i * 4 + 3] as int) >= 128:
r := bp[i * 4] as int
g := bp[i * 4 + 1] as int
b := bp[i * 4 + 2] as int
k := _gif_bin(r, g, b)
cnt.set(k, cnt.get(k) + 1)
sr.set(k, sr.get(k) + r)
sg.set(k, sg.get(k) + g)
sb.set(k, sb.get(k) + b)
end
end
mut bins := Vector {} as Vector<int>
repeat 32768 in k:
if cnt.get(k) > 0:
bins.push(k)
end
end
mut lo := Vector {} as Vector<int>
mut hi := Vector {} as Vector<int>
lo.push(0)
hi.push(bins.len())
mut tmp := Vector {} as Vector<int>
repeat bins.len():
tmp.push(0)
end
mut more := bins.len() > 0
until more and lo.len() < limit:
mut pick := 0 - 1
mut pick_score := 0
mut pick_ch := 0
repeat lo.len() in bi:
if hi.get(bi) - lo.get(bi) > 1:
mut mins := [31, 31, 31]
mut maxs := [0, 0, 0]
mut pixels := 0
mut j := lo.get(bi)
until j < hi.get(bi):
k := bins.get(j)
repeat 3 in c:
v := (k >> (10 - 5 * c)) & 31
if v < mins[c]:
mins[c] = v
end
if v > maxs[c]:
maxs[c] = v
end
end
pixels += cnt.get(k)
j++
end
mut ch := 0
repeat 3 in c:
if maxs[c] - mins[c] > maxs[ch] - mins[ch]:
ch = c
end
end
score := (maxs[ch] - mins[ch] + 1) * pixels
if maxs[ch] > mins[ch] and score > pick_score:
pick = bi
pick_score = score
pick_ch = ch
end
end
end
if pick < 0:
more = false
else:
a := lo.get(pick)
z := hi.get(pick)
shift := 10 - 5 * pick_ch
mut buckets := Vector {} as Vector<int>
repeat 33:
buckets.push(0)
end
mut j := a
until j < z:
v := (bins.get(j) >> shift) & 31
buckets.set(v + 1, buckets.get(v + 1) + 1)
j++
end
repeat 32 in v:
buckets.set(v + 1, buckets.get(v + 1) + buckets.get(v))
end
j = a
until j < z:
k := bins.get(j)
v := (k >> shift) & 31
tmp.set(a + buckets.get(v), k)
buckets.set(v, buckets.get(v) + 1)
j++
end
j = a
mut total_px := 0
until j < z:
bins.set(j, tmp.get(j))
total_px += cnt.get(bins.get(j))
j++
end
mut half := 0
mut cut := a + 1
j = a
until j < z - 1 and half + cnt.get(bins.get(j)) <= total_px / 2:
half += cnt.get(bins.get(j))
j++
end
cut = j > a ? j : a + 1
if cut >= z:
cut = z - 1
end
hi.set(pick, cut)
lo.push(cut)
hi.push(z)
buckets.free()
end
end
repeat lo.len() in bi:
mut tr := 0
mut tg := 0
mut tb := 0
mut tc := 0
mut j := lo.get(bi)
until j < hi.get(bi):
k := bins.get(j)
tr += sr.get(k)
tg += sg.get(k)
tb += sb.get(k)
tc += cnt.get(k)
j++
end
if tc > 0:
pal.push((((tr + tc / 2) / tc) << 16) | (((tg + tc / 2) / tc) << 8) | ((tb + tc / 2) / tc))
end
end
cnt.free()
sr.free()
sg.free()
sb.free()
bins.free()
lo.free()
hi.free()
tmp.free()
end
func _gif_nearest(pal: Vector<int>, r: int, g: int, b: int): int:
mut best := 0
mut best_d := 0 - 1
repeat pal.len() in i:
c := pal.get(i)
dr := ((c >> 16) & 255) - r
dg := ((c >> 8) & 255) - g
db := (c & 255) - b
d := dr * dr * 2 + dg * dg * 4 + db * db * 3
if best_d < 0 or d < best_d:
best_d = d
best = i
end
end
ret best
end
func _gif_clamp(v: int): int:
ret v < 0 ? 0 : (v > 255 ? 255 : v)
end
func _gif_emit(z &: _GifLzw, code: int):
compress.BitWriteBits(z.w, code, z.dsize)
clear := 1 << z.min
if code == clear:
z.dsize = z.min + 1
z.dnext = clear + 2
z.dprev = false
ret
end
if z.dprev and z.dnext < 4096:
z.dnext++
if z.dnext == (1 << z.dsize) and z.dsize < 12:
z.dsize++
end
end
z.dprev = true
end
func _gif_lzw_encode(idx: Vector<int>, min: int): compress.ByteBuf:
clear := 1 << min
mut z := _GifLzw { w = compress.NewBitWriter(), min = min, dsize = min + 1, dnext = clear + 2 }
mut keys := Vector {} as Vector<int>
mut codes := Vector {} as Vector<int>
repeat 8192:
keys.push(0 - 1)
codes.push(0)
end
_gif_emit(z, clear)
mut next := clear + 2
mut cur := 0 - 1
repeat idx.len() in i:
c := idx.get(i)
if cur < 0:
cur = c
else:
key := (cur << 8) | c
h := _gif_find(keys, key)
if keys.get(h) == key:
cur = codes.get(h)
else:
_gif_emit(z, cur)
if next < 4096:
keys.set(h, key)
codes.set(h, next)
next++
end
if next == 4096:
_gif_emit(z, clear)
next = clear + 2
repeat 8192 in k:
keys.set(k, 0 - 1)
end
end
cur = c
end
end
end
if cur >= 0:
_gif_emit(z, cur)
end
_gif_emit(z, clear + 1)
compress.BitFlush(z.w)
keys.free()
codes.free()
ret z.w.buf
end
@en "IsGIF"
@fa "گیف است"
pub func IsGIF(p: void*, n: int): bool:
if n < 6:
ret false
end
bp := p as u8*
ret (bp[0] as int) == 71 and (bp[1] as int) == 73 and (bp[2] as int) == 70 and (bp[3] as int) == 56 and ((bp[4] as int) == 55 or (bp[4] as int) == 57) and (bp[5] as int) == 97
end
@en "DecodeGIF"
@fa "کدگشایی گیف"
pub func DecodeGIF(p: void*, n: int, ok &: bool): Image:
ok = false
if not IsGIF(p, n) or n < 13:
ret New(0, 0)
end
bp := p as u8*
width := _gif_u16(bp, 6)
height := _gif_u16(bp, 8)
flags := bp[10] as int
mut at := 13
mut gct := 0
mut gct_at := 0
if (flags & 128) != 0:
gct = 1 << ((flags & 7) + 1)
gct_at = at
at += gct * 3
end
mut transparent := 0 - 1
until at < n:
b := bp[at] as int
if b == 33:
if at + 2 > n:
ret New(0, 0)
end
label := bp[at + 1] as int
at += 2
if label == 249 and at + 5 <= n and (bp[at] as int) >= 4:
transparent = ((bp[at + 1] as int) & 1) == 1 ? bp[at + 4] as int : 0 - 1
end
until at < n and (bp[at] as int) != 0:
at += (bp[at] as int) + 1
end
at++
else b == 44:
if at + 11 > n:
ret New(0, 0)
end
fx := _gif_u16(bp, at + 1)
fy := _gif_u16(bp, at + 3)
fw := _gif_u16(bp, at + 5)
fh := _gif_u16(bp, at + 7)
iflags := bp[at + 9] as int
at += 10
mut ct := gct
mut ct_at := gct_at
if (iflags & 128) != 0:
ct = 1 << ((iflags & 7) + 1)
ct_at = at
at += ct * 3
end
if ct == 0 or at >= n or fw == 0 or fh == 0 or width == 0 or height == 0 or (width as i64) * (height as i64) > (268435456 as i64):
ret New(0, 0)
end
min := bp[at] as int
at++
mut data := compress.NewByteBuf()
until at < n and (bp[at] as int) != 0:
len := bp[at] as int
if at + 1 + len > n:
compress.BufFree(data)
ret New(0, 0)
end
compress.BufPushBytes(data, ((p as i64) + ((at + 1) as i64)) as void*, len)
at += len + 1
end
mut idx := Vector {} as Vector<int>
good := _gif_lzw(data, min, fw * fh, idx)
compress.BufFree(data)
if not good or idx.len() == 0:
idx.free()
ret New(0, 0)
end
img := New(width, height)
dst := img.pixels as u8*
interlaced := (iflags & 64) != 0
mut row := 0
mut pass := 0
mut step := 8
repeat fh in j:
mut y := j
if interlaced:
if j > 0:
row += step
until row >= fh and pass < 3:
pass++
row = pass == 1 ? 4 : (pass == 2 ? 2 : 1)
step = pass == 1 ? 8 : (pass == 2 ? 4 : 2)
end
end
y = row
end
repeat fw in x:
k := j * fw + x
if k < idx.len() and fy + y < height and fx + x < width:
c := idx.get(k)
if c != transparent and c < ct:
o := ((fy + y) * width + fx + x) * 4
dst[o] = bp[ct_at + c * 3]
dst[o + 1] = bp[ct_at + c * 3 + 1]
dst[o + 2] = bp[ct_at + c * 3 + 2]
dst[o + 3] = 255 as u8
end
end
end
end
idx.free()
ok = true
ret img
else:
ret New(0, 0)
end
end
ret New(0, 0)
end
@en "OpenGIF"
@fa "بازکردن گیف"
pub func OpenGIF(path: str, ok &: bool): Image:
mut read_ok := false
mut buf := archive.ReadBinaryFile(path, read_ok)
ok = false
if not read_ok:
ret New(0, 0)
end
img := DecodeGIF(buf.data, compress.BufLen(buf), ok)
compress.BufFree(buf)
ret img
end
@en "EncodeGIF"
@fa "کدگذاری گیف"
pub func EncodeGIF(img: Image): compress.ByteBuf:
mut out := compress.NewByteBuf()
if IsEmpty(img) or img.width > 65535 or img.height > 65535:
ret out
end
bp := img.pixels as u8*
w := img.width
h := img.height
total := w * h
mut has_clear := false
repeat total in i:
if (bp[i * 4 + 3] as int) < 128:
has_clear = true
end
end
limit := has_clear ? 255 : 256
mut pal := Vector {} as Vector<int>
mut keys := Vector {} as Vector<int>
mut vals := Vector {} as Vector<int>
exact := _gif_exact(bp, total, limit, pal, keys, vals)
mut idx := Vector {} as Vector<int>
if exact:
repeat total in i:
if (bp[i * 4 + 3] as int) < 128:
idx.push(pal.len())
else:
rgb := ((bp[i * 4] as int) << 16) | ((bp[i * 4 + 1] as int) << 8) | (bp[i * 4 + 2] as int)
idx.push(vals.get(_gif_find(keys, rgb)))
end
end
else:
pal.clear()
_gif_median(bp, total, limit, pal)
mut cache := Vector {} as Vector<int>
repeat 32768:
cache.push(0 - 1)
end
mut err := Vector {} as Vector<int>
repeat (w + 2) * 6:
err.push(0)
end
repeat h in y:
cur := (y % 2) * (w + 2) * 3
nxt := ((y + 1) % 2) * (w + 2) * 3
repeat (w + 2) * 3 in k:
err.set(nxt + k, 0)
end
repeat w in x:
i := y * w + x
if (bp[i * 4 + 3] as int) < 128:
idx.push(pal.len())
else:
e := cur + (x + 1) * 3
r := _gif_clamp((bp[i * 4] as int) + err.get(e) / 16)
g := _gif_clamp((bp[i * 4 + 1] as int) + err.get(e + 1) / 16)
b := _gif_clamp((bp[i * 4 + 2] as int) + err.get(e + 2) / 16)
k := _gif_bin(r, g, b)
if cache.get(k) < 0:
cache.set(k, _gif_nearest(pal, (r & 248) | 4, (g & 248) | 4, (b & 248) | 4))
end
pi := cache.get(k)
idx.push(pi)
c := pal.get(pi)
dr := r - ((c >> 16) & 255)
dg := g - ((c >> 8) & 255)
db := b - (c & 255)
ds := [dr, dg, db]
repeat 3 in ch:
d := ds[ch]
err.set(e + 3 + ch, err.get(e + 3 + ch) + d * 7)
err.set(nxt + x * 3 + ch, err.get(nxt + x * 3 + ch) + d * 3)
err.set(nxt + (x + 1) * 3 + ch, err.get(nxt + (x + 1) * 3 + ch) + d * 5)
err.set(nxt + (x + 2) * 3 + ch, err.get(nxt + (x + 2) * 3 + ch) + d)
end
end
end
end
cache.free()
err.free()
end
used := pal.len() + (has_clear ? 1 : 0)
mut bits := 1
until (1 << bits) < used:
bits++
end
compress.BufPushBytes(out, "GIF89a" as void*, 6)
compress.BufPush(out, w & 255)
compress.BufPush(out, w >> 8)
compress.BufPush(out, h & 255)
compress.BufPush(out, h >> 8)
compress.BufPush(out, 240 | (bits - 1))
compress.BufPush(out, 0)
compress.BufPush(out, 0)
repeat 1 << bits in i:
c := i < pal.len() ? pal.get(i) : 0
compress.BufPush(out, (c >> 16) & 255)
compress.BufPush(out, (c >> 8) & 255)
compress.BufPush(out, c & 255)
end
if has_clear:
each b in [33, 249, 4, 1, 0, 0]:
compress.BufPush(out, b)
end
compress.BufPush(out, pal.len())
compress.BufPush(out, 0)
end
each b in [44, 0, 0, 0, 0]:
compress.BufPush(out, b)
end
compress.BufPush(out, w & 255)
compress.BufPush(out, w >> 8)
compress.BufPush(out, h & 255)
compress.BufPush(out, h >> 8)
compress.BufPush(out, 0)
min := bits < 2 ? 2 : bits
compress.BufPush(out, min)
mut data := _gif_lzw_encode(idx, min)
dlen := compress.BufLen(data)
mut at := 0
until at < dlen:
len := dlen - at > 255 ? 255 : dlen - at
compress.BufPush(out, len)
compress.BufPushBytes(out, ((data.data as i64) + (at as i64)) as void*, len)
at += len
end
compress.BufPush(out, 0)
compress.BufPush(out, 59)
compress.BufFree(data)
pal.free()
keys.free()
vals.free()
idx.free()
ret out
end
@en "SaveGIF"
@fa "ذخیره گیف"
pub func SaveGIF(img: Image, path: str): bool:
mut buf := EncodeGIF(img)
if compress.BufLen(buf) == 0:
compress.BufFree(buf)
ret false
end
ok := archive.WriteBinaryFileBuf(path, buf)
compress.BufFree(buf)
ret ok
end
@en "image"
@fa "تصویر"
package image
import mem
@en "Image"
@fa "تصویر"
pub struct Image:
@en "width"
@fa "عرض"
pub width: int = 0
@en "height"
@fa "ارتفاع"
pub height: int = 0
@en "pixels"
@fa "پیکسل‌ها"
pub pixels: void* = null
end
@en "Color"
@fa "رنگ"
pub struct Color:
@en "r"
@fa "قرمز"
pub r: u8 = 0 as u8
@en "g"
@fa "سبز"
pub g: u8 = 0 as u8
@en "b"
@fa "آبی"
pub b: u8 = 0 as u8
@en "a"
@fa "آلفا"
pub a: u8 = 255 as u8
end
inline func _px_off(img: Image, x: int, y: int): int:
ret (y * img.width + x) * 4
end
@en "New"
@fa "جدید"
pub func New(width: int, height: int): Image:
if width <= 0 or height <= 0:
ret Image { width = 0, height = 0 }
end
pixels := (width as i64) * (height as i64)
if pixels > (536870912 as i64):
ret Image { width = 0, height = 0 }
end
p := mem.AllocateZeroed((pixels * (4 as i64)) as u64)
if p == null:
ret Image { width = 0, height = 0 }
end
mut img := Image { width = width, height = height }
img.pixels = p
ret img
end
@en "NewFilled"
@fa "جدید با رنگ"
pub func NewFilled(width: int, height: int, c: Color): Image:
mut img := New(width, height)
Fill(img, c)
ret img
end
@en "Free"
@fa "آزادسازی"
pub func Free(img &: Image):
if img.pixels != null:
mem.Free(img.pixels)
end
img.pixels = null
img.width = 0
img.height = 0
end
@en "Clone"
@fa "کپی"
pub func Clone(img: Image): Image:
out := New(img.width, img.height)
if out.pixels != null and img.pixels != null:
mem.Copy(out.pixels, img.pixels, (img.width * img.height * 4) as u64)
end
ret out
end
@en "IsEmpty"
@fa "خالی است"
pub func IsEmpty(img: Image): bool:
ret img.width <= 0 or img.height <= 0 or img.pixels == null
end
@en "InBounds"
@fa "در محدوده"
pub func InBounds(img: Image, x: int, y: int): bool:
ret x >= 0 and y >= 0 and x < img.width and y < img.height
end
@en "GetPixel"
@fa "دریافت پیکسل"
pub func GetPixel(img: Image, x: int, y: int): Color:
if img.pixels == null or not InBounds(img, x, y):
ret Color { r = 0 as u8, g = 0 as u8, b = 0 as u8, a = 0 as u8 }
end
bp := img.pixels as u8*
off := _px_off(img, x, y)
mut c := Color { r = bp[off], g = bp[off + 1] }
c.b = bp[off + 2]
c.a = bp[off + 3]
ret c
end
@en "SetPixel"
@fa "تنظیم پیکسل"
pub func SetPixel(img &: Image, x: int, y: int, c: Color):
if img.pixels == null or not InBounds(img, x, y):
ret
end
bp := img.pixels as u8*
off := _px_off(img, x, y)
bp[off] = c.r
bp[off + 1] = c.g
bp[off + 2] = c.b
bp[off + 3] = c.a
end
@en "BlendPixel"
@fa "ترکیب پیکسل"
pub func BlendPixel(img &: Image, x: int, y: int, c: Color):
if c.a == (255 as u8):
SetPixel(img, x, y, c)
ret
end
if c.a == (0 as u8):
ret
end
under := GetPixel(img, x, y)
SetPixel(img, x, y, Blend(under, c))
end
@en "Fill"
@fa "پر کردن"
pub func Fill(img &: Image, c: Color):
if img.pixels == null:
ret
end
bp := img.pixels as u8*
mut i := 0
n := img.width * img.height
until i < n:
off := i * 4
bp[off] = c.r
bp[off + 1] = c.g
bp[off + 2] = c.b
bp[off + 3] = c.a
i++
end
end
@en "FillHex"
@fa "پر کردن با هگز"
pub func FillHex(img &: Image, hex: str):
Fill(img, ParseHex(hex))
end
package image
