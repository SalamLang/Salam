pub func value(): T: ret this.items.get(this.pos) end
@en "next"
@fa "بعدی"
pub func next(): this.pos++ end
end
package collections
@en "Vector"
@fa "بردار"
pub struct Vector<T>:
@en "data"
@fa "داده"
pub data: T* = null
count: int = 0
capacity: int = 0
@en "reserve"
@fa "رزرو"
pub func reserve(need: int):
if need <= this.capacity: ret end
mut c := this.capacity
if c == 0: c = 4 end
until c < need: c *= 2 end
this.data = mem.MustReallocate(this.data as void*, (c as u64) * sizeof(T)) as T*
this.capacity = c
end
@en "push"
@fa "افزودن"
pub func push(x: T):
this.reserve(this.count + 1)
d := this.data
d[this.count] = x
this.count++
end
@en "pop"
@fa "برداشتن"
pub func pop(): T:
if SALAM_SAFE:
if this.count <= 0: salam_panic("Vector.pop: empty") end
end
this.count--
d := this.data
ret d[this.count]
end
@en "get"
@fa "دریافت"
pub func get(i: int): T:
if SALAM_SAFE:
if (i as u32) >= (this.count as u32):
salam_panic("Vector.get: index out of bounds")
end
end
d := this.data
ret d[i]
end
@en "ref"
@fa "ارجاع"
pub func ref(i: int): T*:
if SALAM_SAFE:
if (i as u32) >= (this.count as u32):
salam_panic("Vector.ref: index out of bounds")
end
end
ret (this.data as i64 + (i as i64) * (sizeof(T) as i64)) as T*
end
@en "set"
@fa "تنظیم"
pub func set(i: int, x: T):
if SALAM_SAFE:
if (i as u32) >= (this.count as u32):
salam_panic("Vector.set: index out of bounds")
end
end
d := this.data
d[i] = x
end
@en "resize_set"
@fa "تنظیم با تغییر اندازه"
pub func resize_set(i: int, x: T):
if SALAM_SAFE:
if i < 0: salam_panic("Vector.resize_set: negative index") end
end
if i >= this.count:
this.reserve(i + 1)
this.count = i + 1
end
d := this.data
d[i] = x
end
@en "zeros"
@fa "صفرها"
pub func zeros(n: int):
if n <= 0: ret end
if this.data != null: mem.Free(this.data as void*) end
this.data = mem.MustAllocateZeroed((n as u64) * sizeof(T)) as T*
this.capacity = n
this.count = n
end
@en "alloc"
@fa "تخصیص"
pub func alloc(n: int):
if n <= 0:
this.count = 0
ret
end
if this.data != null: mem.Free(this.data as void*) end
this.data = mem.MustAllocate((n as u64) * sizeof(T)) as T*
this.capacity = n
this.count = n
end
@en "len"
@fa "طول"
pub func len(): int: ret this.count end
@en "cap"
@fa "ظرفیت"
pub func cap(): int: ret this.capacity end
@en "is_empty"
@fa "خالی است"
pub func is_empty(): bool: ret this.count == 0 end
@en "first"
@fa "اول"
pub func first(): T: ret this.get(0) end
@en "last"
@fa "آخر"
pub func last(): T: ret this.get(this.count - 1) end
@en "clear"
@fa "پاک‌سازی"
pub func clear(): this.count = 0 end
@en "insert"
@fa "درج"
pub func insert(i: int, x: T):
if SALAM_SAFE:
if i < 0 or i > this.count: salam_panic("Vector.insert: index out of bounds") end
end
this.reserve(this.count + 1)
d := this.data
mut j := this.count
until j > i:
d[j] = d[j - 1]
j--
end
d[i] = x
this.count++
end
@en "remove_at"
@fa "حذف در"
pub func remove_at(i: int): T:
if SALAM_SAFE:
if i < 0 or i >= this.count: salam_panic("Vector.remove_at: index out of bounds") end
end
d := this.data
out := d[i]
mut j := i
until j < this.count - 1:
d[j] = d[j + 1]
j++
end
this.count--
ret out
end
@en "operator_index"
@fa "عملگر اندیس"
pub func operator_index(i: int): T:
ret this.get(i)
end
@en "operator_index_set"
@fa "تنظیم عملگر اندیس"
pub func operator_index_set(i: int, x: T):
this.set(i, x)
end
@en "iter"
@fa "پیمایشگر"
pub func iter(): VectorIter<T>:
it := VectorIter {} as VectorIter<T> it.data = this.data
it.len = this.count
it.pos = 0
ret it
end
@en "free"
@fa "آزادسازی"
pub func free():
if this.data != null: mem.Free(this.data as void*) end
this.data = null
this.count = 0
this.capacity = 0
end
end
@en "VectorIter"
@fa "پیمایشگر بردار"
pub struct VectorIter<T>:
@en "data"
@fa "داده"
pub data: T* = null
@en "len"
@fa "طول"
pub len: int = 0
@en "pos"
@fa "جایگاه"
pub pos: int = 0
@en "has_next"
@fa "بعدی دارد"
pub func has_next(): bool: ret this.pos < this.len end
@en "value"
@fa "مقدار"
pub func value(): T:
d := this.data
ret d[this.pos]
end
@en "next"
@fa "بعدی"
pub func next(): this.pos++ end
end
package collections
@en "contains"
@fa "دارد"
pub func contains<T>(v: Vector<T>, x: T): bool: repeat v.len() in i: if v.get(i) == x: ret true
end
end
ret false
end
@en "index_of"
@fa "اندیس"
pub func index_of<T>(v: Vector<T>, x: T): int: repeat v.len() in i: if v.get(i) == x: ret i
end
end
ret 0 - 1
end
@en "reverse"
@fa "برعکس"
pub func reverse<T>(v: Vector<T>): Vector<T>: mut out := Vector {} as Vector<T> mut i := v.len() - 1
until i >= 0:
out.push(v.get(i))
i--
end
ret out
end
@en "clone"
@fa "رونوشت"
pub func clone<T>(v: Vector<T>): Vector<T>: out := Vector {} as Vector<T> mut i := 0
until i < v.len():
out.push(v.get(i))
i++
end
ret out
end
@en "slice"
@fa "برش"
pub func slice<T>(v: Vector<T>, start: int, count: int): Vector<T>: mut out := Vector {} as Vector<T> mut s := start
if s < 0: s = 0 end
mut e := s + count
if e > v.len(): e = v.len() end
mut i := s
until i < e:
out.push(v.get(i))
i++
end
ret out
end
@en "swap"
@fa "جابجایی"
pub func swap<T>(v: Vector<T>, i: int, j: int):
t := v.get(i)
v.set(i, v.get(j))
v.set(j, t)
end
@en "count_of"
@fa "شمارش"
pub func count_of<T>(v: Vector<T>, x: T): int: mut n := 0
repeat v.len() in i:
if v.get(i) == x: n++ end
end
ret n
end
@en "last_index_of"
@fa "آخرین اندیس"
pub func last_index_of<T>(v: Vector<T>, x: T): int: mut i := v.len() - 1
until i >= 0:
if v.get(i) == x: ret i end
i--
end
ret 0 - 1
end
@en "extend"
@fa "گسترش"
pub func extend<T>(dst &: Vector<T>, src: Vector<T>):
repeat src.len() in i:
dst.push(src.get(i))
end
end
package compress
@en "MethodNone"
@fa "روش هیچ"
pub const MethodNone := 0
@en "MethodRLE"
@fa "روش آر ال ای"
pub const MethodRLE := 1
@en "MethodHuffman"
@fa "روش هافمن"
pub const MethodHuffman := 2
@en "MethodLZ77"
@fa "روش الزد۷۷"
pub const MethodLZ77 := 3
@en "MethodLZW"
@fa "روش ال زد دبلیو"
pub const MethodLZW := 4
@en "MethodDeflate"
@fa "روش دیفلیت"
pub const MethodDeflate := 5
@en "MethodBWT"
@fa "روش باروز ویلر"
pub const MethodBWT := 6
func _raw_copy(p: void*, n: int): ByteBuf:
mut out := NewByteBuf()
BufPushU32(out, n)
BufPushBytes(out, p, n)
ret out
end
func _raw_restore(p: void*, n: int, ok &: bool): ByteBuf:
ok = false
mut r := NewByteReader(p, n)
origLen := RdU32(r)
if r.bad or origLen < 0 or origLen != n - 4: ret NewByteBuf() end
src := ((r.data as i64) + (r.pos as i64)) as void*
mut out := NewByteBufCap(origLen)
BufPushBytes(out, src, origLen)
ok = true
ret out
end
@en "Compress"
@fa "فشرده سازی"
pub func Compress(method: int, p: void*, n: int): ByteBuf:
if method == MethodRLE: ret RLECompress(p, n) end
if method == MethodHuffman: ret HuffmanCompress(p, n) end
if method == MethodLZ77: ret LZ77Compress(p, n) end
if method == MethodLZW: ret LZWCompress(p, n) end
if method == MethodDeflate: ret DeflateCompress(p, n) end
if method == MethodBWT: ret BWTCompress(p, n) end
ret _raw_copy(p, n)
end
@en "DecompressMax"
@fa "کدگشایی با سقف"
pub func DecompressMax(method: int, p: void*, n: int, max: int, ok &: bool): ByteBuf:
if method == MethodRLE: ret RLEDecompressMax(p, n, max, ok) end
if method == MethodHuffman: ret HuffmanDecompressMax(p, n, max, ok) end
if method == MethodLZ77: ret LZ77DecompressMax(p, n, max, ok) end
if method == MethodLZW: ret LZWDecompressMax(p, n, max, ok) end
if method == MethodDeflate: ret DeflateDecompressMax(p, n, max, ok) end
if method == MethodBWT: ret BWTDecompressMax(p, n, max, ok) end
mut out := _raw_restore(p, n, ok)
if ok and max > 0 and out.len > max:
BufFree(out)
ok = false
ret NewByteBuf()
end
ret out
end
@en "Decompress"
@fa "کدگشایی"
pub func Decompress(method: int, p: void*, n: int): ByteBuf:
mut ok := false
ret DecompressMax(method, p, n, 0, ok)
end
@en "CompressStr"
@fa "فشرده سازی رشته"
pub func CompressStr(method: int, s: str): ByteBuf:
ret Compress(method, s as void*, s.len())
end
@en "CompressBuf"
@fa "فشرده سازی بافر"
pub func CompressBuf(method: int, b: ByteBuf): ByteBuf:
ret Compress(method, b.data, b.len)
end
@en "DecompressBuf"
@fa "کدگشایی بافر"
pub func DecompressBuf(method: int, b: ByteBuf): ByteBuf:
ret Decompress(method, b.data, b.len)
end
@en "CompressBest"
@fa "بهترین فشرده سازی"
pub func CompressBest(p: void*, n: int, method_out &: int): ByteBuf:
mut best := _raw_copy(p, n)
method_out = MethodNone
mut cand := RLECompress(p, n)
if BufLen(cand) < BufLen(best):
BufFree(best)
best = cand
method_out = MethodRLE
else:
BufFree(cand)
end
cand = HuffmanCompress(p, n)
if BufLen(cand) < BufLen(best):
BufFree(best)
best = cand
method_out = MethodHuffman
else:
BufFree(cand)
end
cand = LZ77Compress(p, n)
if BufLen(cand) < BufLen(best):
BufFree(best)
best = cand
method_out = MethodLZ77
else:
BufFree(cand)
end
cand = LZWCompress(p, n)
if BufLen(cand) < BufLen(best):
BufFree(best)
best = cand
method_out = MethodLZW
else:
BufFree(cand)
end
cand = DeflateCompress(p, n)
if BufLen(cand) < BufLen(best):
BufFree(best)
best = cand
method_out = MethodDeflate
else:
BufFree(cand)
end
cand = BWTCompress(p, n)
if BufLen(cand) < BufLen(best):
BufFree(best)
best = cand
method_out = MethodBWT
else:
BufFree(cand)
end
ret best
end
@en "Ratio"
@fa "نسبت"
pub func Ratio(compressed_len: int, original_len: int): f64:
if original_len == 0: ret 0.0 end
ret (compressed_len as f64) / (original_len as f64)
end
package compress
import mem
@en "BitWriter"
@fa "نویسنده بیت"
pub struct BitWriter:
@en "buf"
@fa "بافر"
pub buf: ByteBuf = ByteBuf { data = null, len = 0, cap = 0 }
@en "acc"
@fa "انباره"
pub acc: int = 0
@en "nbits"
@fa "شمار بیت‌ها"
pub nbits: int = 0
end
@en "BitReader"
@fa "خواننده بیت"
pub struct BitReader:
@en "data"
@fa "داده"
pub data: void* = null
@en "len"
@fa "طول"
pub len: int = 0
@en "pos"
@fa "جایگاه"
pub pos: int = 0
@en "acc"
@fa "انباره"
pub acc: int = 0
@en "nbits"
@fa "شمار بیت‌ها"
pub nbits: int = 0
@en "bad"
@fa "خراب"
pub bad: bool = false
@en "fp"
@fa "پرونده"
pub fp: void* = null
@en "left"
@fa "باقی مانده"
pub left: i64 = 0 as i64
@en "foff"
@fa "جایگاه پرونده"
pub foff: i64 = 0 as i64
end
func _br_refill(r &: BitReader): bool:
if r.fp == null or r.left <= (0 as i64):
ret false
end
want := r.left > (65536 as i64) ? 65536 : (r.left as int)
got := FileReadAt(r.fp, r.foff, r.data, want)
if got <= 0:
ret false
end
r.foff += got as i64
r.len = got
r.pos = 0
r.left -= got as i64
ret true
end
@en "NewBitWriter"
@fa "نویسنده بیت جدید"
pub func NewBitWriter(): BitWriter:
ret BitWriter { acc = 0, nbits = 0 }
end
@en "BitWriteBit"
@fa "نوشتن بیت"
pub func BitWriteBit(w &: BitWriter, bit: int):
if bit != 0:
w.acc |= (1 << w.nbits)
end
w.nbits++
if w.nbits == 8:
BufPush(w.buf, w.acc)
w.acc = 0
w.nbits = 0
end
end
@en "BitWriteBits"
@fa "نوشتن بیت‌ها"
pub func BitWriteBits(w &: BitWriter, value: int, count: int):
mut v := value
mut left := count
until left > 0:
take := left > 16 ? 16 : left
w.acc |= ((v & ((1 << take) - 1)) << w.nbits)
w.nbits += take
until w.nbits >= 8:
BufPush(w.buf, w.acc & 255)
w.acc >>= 8
w.nbits -= 8
end
v >>= take
left -= take
end
end
@en "BitFlush"
@fa "تخلیه بیت"
pub func BitFlush(w &: BitWriter):
if w.nbits > 0:
BufPush(w.buf, w.acc)
w.acc = 0
w.nbits = 0
end
end
@en "BitWriterLen"
@fa "طول نویسنده بیت"
pub func BitWriterLen(w &: BitWriter): int: ret BufLen(w.buf) end
@en "BitWriterFree"
@fa "آزادسازی نویسنده بیت"
pub func BitWriterFree(w &: BitWriter): BufFree(w.buf) end
@en "NewBitReader"
@fa "خواننده بیت جدید"
pub func NewBitReader(p: void*, n: int): BitReader:
ret BitReader { data = p, len = n, pos = 0, acc = 0, nbits = 0, bad = false }
end
@en "NewFileBitReader"
@fa "خواننده بیت از پرونده"
pub func NewFileBitReader(fp: void*, off: i64, len: i64): BitReader:
mut r := BitReader { data = null, len = 0, pos = 0, acc = 0, nbits = 0, bad = false, fp = fp, left = len, foff = off }
if off < (0 as i64):
r.bad = true
ret r
end
r.data = mem.Allocate(65536 as u64)
ret r
end
@en "FileBitReaderFree"
@fa "آزادسازی خواننده بیت پرونده"
pub func FileBitReaderFree(r &: BitReader):
if r.fp != null and r.data != null:
mem.Free(r.data)
r.data = null
end
end
@en "BitReaderFromBuf"
@fa "خواننده بیت از بافر"
pub func BitReaderFromBuf(b: ByteBuf): BitReader:
ret NewBitReader(b.data, b.len)
end
@en "BitReadBit"
@fa "خواندن بیت"
pub func BitReadBit(r &: BitReader): int:
if r.nbits == 0:
if r.bad:
ret 0
end
if r.pos >= r.len and not _br_refill(r):
r.bad = true
ret 0
end
r.acc = _bget(r.data, r.pos)
r.pos++
r.nbits = 8
end
bit := r.acc & 1
r.acc >>= 1
r.nbits--
ret bit
end
@en "BitReadBits"
@fa "خواندن بیت‌ها"
pub func BitReadBits(r &: BitReader, count: int): int:
if count <= 0:
ret 0
end
until r.nbits < count:
if r.bad or (r.pos >= r.len and not _br_refill(r)):
r.bad = true
part := r.acc & ((1 << r.nbits) - 1)
r.acc = 0
r.nbits = 0
ret part
end
r.acc |= _bget(r.data, r.pos) << r.nbits
r.pos++
r.nbits += 8
end
v := r.acc & ((1 << count) - 1)
r.acc >>= count
r.nbits -= count
ret v
end
package compress
import mem
import str
import encoding
const _DEC_DEFAULT_MAX := 1073741824
@en "DecodeOk"
@fa "کدگشایی موفق"
pub const DecodeOk := 0
@en "DecodeCorrupt"
@fa "کدگشایی خراب"
pub const DecodeCorrupt := 1
@en "DecodeTooBig"
@fa "کدگشایی بزرگ"
pub const DecodeTooBig := 2
@en "DecodeIo"
@fa "خطای ورودی خروجی کدگشایی"
pub const DecodeIo := 3
func _buf_grow(b &: ByteBuf, need: int):
want := (b.len as i64) + (need as i64)
if want <= (b.cap as i64):
ret
end
top := 2147483640 as i64
if want > top:
ret
end
mut nc := b.cap as i64
if nc < (32 as i64): nc = 32 as i64 end
until nc < want: nc *= (2 as i64) end
if nc > top:
nc = top
end
b.data = mem.Reallocate(b.data, nc as u64)
b.cap = nc as int
end
func _dec_size_ok(orig: int, n: int, max: int): bool:
cap := max > 0 ? max : _DEC_DEFAULT_MAX
if orig < 0 or orig > cap: ret false end
ret (orig as i64) <= ((n as i64) + (16 as i64)) * (8192 as i64)
end
func _dec_cap(orig: int): int:
ret orig < 1048576 ? orig : 1048576
end
func _rd_need(r &: ByteReader, n: int): bool:
if r.bad: ret false end
if n < 0 or r.pos + n > r.len:
r.bad = true
ret false
end
ret true
end
@en "NewByteBuf"
@fa "بافر بایت جدید"
pub func NewByteBuf(): ByteBuf:
ret ByteBuf { data = null, len = 0, cap = 0 }
end
@en "NewByteBufCap"
@fa "بافر بایت جدید با ظرفیت"
pub func NewByteBufCap(capacity: int): ByteBuf:
mut b := ByteBuf { data = null, len = 0, cap = 0 }
if capacity > 0:
_buf_grow(b, capacity)
end
ret b
end
@en "BufPush"
@fa "افزودن بایت"
pub func BufPush(b &: ByteBuf, v: int):
_buf_grow(b, 1)
if b.len >= b.cap:
ret
end
_bput(b.data, b.len, v)
b.len++
end
@en "BufPushBytes"
@fa "افزودن بایت‌ها"
pub func BufPushBytes(b &: ByteBuf, p: void*, n: int):
if n <= 0: ret end
_buf_grow(b, n)
if (b.len as i64) + (n as i64) > (b.cap as i64): ret end
dst := ((b.data as i64) + (b.len as i64)) as void*
mem.Copy(dst, p, n as u64)
b.len += n
end
@en "BufPushBuf"
@fa "افزودن بافر"
pub func BufPushBuf(b &: ByteBuf, src: ByteBuf):
BufPushBytes(b, src.data, src.len)
end
@en "BufPushU32"
@fa "افزودن عدد۳۲"
pub func BufPushU32(b &: ByteBuf, v: int):
BufPush(b, (v >> 24) & 255)
BufPush(b, (v >> 16) & 255)
BufPush(b, (v >> 8) & 255)
BufPush(b, v & 255)
end
@en "BufGet"
@fa "دریافت بایت"
pub func BufGet(b: ByteBuf, i: int): int:
if i < 0 or i >= b.len: ret 0 end
ret _bget(b.data, i)
end
@en "BufSet"
@fa "تنظیم بایت"
pub func BufSet(b &: ByteBuf, i: int, v: int):
if i < 0 or i >= b.len: ret end
_bput(b.data, i, v)
end
@en "BufLen"
@fa "طول بافر"
pub func BufLen(b: ByteBuf): int: ret b.len end
@en "BufFree"
@fa "آزادسازی بافر"
pub func BufFree(b &: ByteBuf):
if b.data != null: mem.Free(b.data) end
b.data = null
b.len = 0
b.cap = 0
end
@en "BufReset"
@fa "بازنشانی بافر"
pub func BufReset(b &: ByteBuf): b.len = 0 end
@en "BufClone"
@fa "کپی بافر"
pub func BufClone(b: ByteBuf): ByteBuf:
mut out := NewByteBufCap(b.len)
BufPushBytes(out, b.data, b.len)
ret out
end
@en "BufEquals"
@fa "برابری بافر"
pub func BufEquals(a: ByteBuf, b: ByteBuf): bool:
if a.len != b.len: ret false end
mut i := 0
until i < a.len:
if BufGet(a, i) != BufGet(b, i): ret false end
i++
end
ret true
end
@en "BufFromStr"
@fa "بافر از رشته"
pub func BufFromStr(s: str): ByteBuf:
n := s.len()
mut out := NewByteBufCap(n)
BufPushBytes(out, s as void*, n)
ret out
end
@en "BufToStrUnsafe"
@fa "بافر به رشته"
pub func BufToStrUnsafe(b: ByteBuf): str:
if b.len <= 0: ret "" end
d := mem.Allocate((b.len + 1) as u64)
mem.Copy(d, b.data, b.len as u64)
_bput(d, b.len, 0)
ret d as str
end
@en "BufToBase64"
@fa "بافر به پایه۶۴"
pub func BufToBase64(b: ByteBuf): str:
ret encoding.Base64EncodeBytes(b.data, b.len)
end
@en "NewByteReader"
@fa "خواننده بایت جدید"
pub func NewByteReader(p: void*, n: int): ByteReader:
ret ByteReader { data = p, len = n, pos = 0, bad = false }
end
@en "ReaderFromBuf"
@fa "خواننده از بافر"
pub func ReaderFromBuf(b: ByteBuf): ByteReader:
ret NewByteReader(b.data, b.len)
end
@en "RdLeft"
@fa "باقیمانده"
pub func RdLeft(r: ByteReader): int:
if r.bad: ret 0 end
ret r.len - r.pos
end
@en "RdByte"
@fa "خواندن بایت"
pub func RdByte(r &: ByteReader): int:
if not _rd_need(r, 1): ret 0 end
v := _bget(r.data, r.pos)
r.pos++
ret v
end
@en "RdU32"
@fa "خواندن عدد۳۲"
pub func RdU32(r &: ByteReader): int:
a := RdByte(r)
b := RdByte(r)
c := RdByte(r)
d := RdByte(r)
ret (a << 24) | (b << 16) | (c << 8) | d
end
@en "RdBytes"
@fa "خواندن بایت‌ها"
pub func RdBytes(r &: ByteReader, n: int): ByteBuf:
if not _rd_need(r, n): ret NewByteBuf() end
mut out := NewByteBufCap(n)
src := ((r.data as i64) + (r.pos as i64)) as void*
BufPushBytes(out, src, n)
r.pos += n
ret out
end
package compress
func _bwt_cmp(p: void*, n: int, a: int, b: int): int:
bp := p as u8*
mut k := 0
until k < n:
ca := bp[(a + k) % n] as int
cb := bp[(b + k) % n] as int
if ca != cb:
if ca < cb: ret -1 end
ret 1
end
k++
end
ret 0
end
func _bwt_quicksort(idx &: Vector<int>, p: void*, n: int, lo: int, hi: int):
if lo >= hi: ret end
pivot := idx.get((lo + hi) / 2)
mut i := lo
mut j := hi
until i <= j:
until _bwt_cmp(p, n, idx.get(i), pivot) < 0:
i++
end
until _bwt_cmp(p, n, idx.get(j), pivot) > 0:
j--
end
if i <= j:
tmp := idx.get(i)
idx.set(i, idx.get(j))
idx.set(j, tmp)
i++
j--
end
end
if lo < j: _bwt_quicksort(idx, p, n, lo, j) end
if i < hi: _bwt_quicksort(idx, p, n, i, hi) end
end
@en "MTFEncode"
@fa "کدگذاری انتقال به جلو"
pub func MTFEncode(inbuf: ByteBuf): ByteBuf:
mut table: int[256]
repeat 256 in i: table[i] = i end
mut out := NewByteBufCap(inbuf.len)
mut k := 0
until k < inbuf.len:
b := BufGet(inbuf, k)
mut pos := 0
until table[pos] != b:
pos++
end
BufPush(out, pos)
mut j := pos
until j > 0:
table[j] = table[j - 1]
j--
end
table[0] = b
k++
end
ret out
end
@en "MTFDecode"
@fa "کدگشایی انتقال به جلو"
pub func MTFDecode(inbuf: ByteBuf): ByteBuf:
mut table: int[256]
repeat 256 in i: table[i] = i end
mut out := NewByteBufCap(inbuf.len)
mut k := 0
until k < inbuf.len:
pos := BufGet(inbuf, k)
b := table[pos]
BufPush(out, b)
mut j := pos
until j > 0:
table[j] = table[j - 1]
j--
end
table[0] = b
k++
end
ret out
end
@en "BWTTransform"
@fa "تبدیل باروز ویلر"
pub func BWTTransform(p: void*, n: int, primary_out &: int): ByteBuf:
mut out := NewByteBufCap(n)
if n == 0:
primary_out = 0
ret out
end
mut idx := Vector {} as Vector<int>
defer idx.free()
repeat n in i: idx.push(i) end
_bwt_quicksort(idx, p, n, 0, n - 1)
bp := p as u8*
mut primary := 0
mut k := 0
until k < n:
rot := idx.get(k)
if rot == 0:
primary = k
end
last := (rot - 1 + n) % n
BufPush(out, bp[last] as int)
k++
end
primary_out = primary
ret out
end
@en "BWTInverse"
@fa "معکوس باروز ویلر"
pub func BWTInverse(p: void*, n: int, primary: int): ByteBuf:
if n <= 0 or primary < 0 or primary >= n: ret NewByteBuf() end
mut out := NewByteBufCap(n)
bp := p as u8*
mut count: int[256]
repeat 256 in i: count[i] = 0 end
mut k := 0
until k < n:
count[bp[k] as int]++
k++
end
mut cum: int[256]
mut total := 0
repeat 256 in i:
cum[i] = total
total += count[i]
end
mut occ: int[256]
repeat 256 in i: occ[i] = 0 end
mut t := Vector {} as Vector<int>
defer t.free()
k = 0
until k < n:
b := bp[k] as int
t.push(cum[b] + occ[b])
occ[b]++
k++
end
repeat n: BufPush(out, 0) end
mut row := primary
mut i := n - 1
until i >= 0:
BufSet(out, i, bp[row] as int)
row = t.get(row)
i--
end
ret out
end
@en "BWTCompress"
@fa "فشرده سازی باروز ویلر"
pub func BWTCompress(p: void*, n: int): ByteBuf:
mut out := NewByteBuf()
BufPushU32(out, n)
if n == 0: ret out end
mut primary := 0
mut bwtbuf := BWTTransform(p, n, primary)
BufPushU32(out, primary)
mut mtfbuf := MTFEncode(bwtbuf)
BufFree(bwtbuf)
mut rlebuf := RLECompress(mtfbuf.data, mtfbuf.len)
BufFree(mtfbuf)
mut huffbuf := HuffmanCompress(rlebuf.data, rlebuf.len)
BufFree(rlebuf)
BufPushBuf(out, huffbuf)
BufFree(huffbuf)
ret out
end
@en "BWTDecompressMax"
@fa "کدگشایی باروز ویلر با سقف"
pub func BWTDecompressMax(p: void*, n: int, max: int, ok &: bool): ByteBuf:
ok = false
mut r := NewByteReader(p, n)
origLen := RdU32(r)
primary := RdU32(r)
if r.bad or not _dec_size_ok(origLen, n, max): ret NewByteBuf() end
if origLen == 0:
ok = true
ret NewByteBuf()
end
remaining := RdLeft(r)
huffSrc := ((r.data as i64) + (r.pos as i64)) as void*
mut hok := false
mut rlebuf := HuffmanDecompressMax(huffSrc, remaining, max, hok)
mut rok := false
mut mtfbuf := RLEDecompressMax(rlebuf.data, rlebuf.len, max, rok)
BufFree(rlebuf)
mut bwtbuf := MTFDecode(mtfbuf)
BufFree(mtfbuf)
if not hok or not rok or bwtbuf.len != origLen or primary < 0 or primary >= origLen:
BufFree(bwtbuf)
ret NewByteBuf()
end
out := BWTInverse(bwtbuf.data, bwtbuf.len, primary)
BufFree(bwtbuf)
ok = true
ret out
end
@en "BWTDecompress"
@fa "کدگشایی باروز ویلر"
pub func BWTDecompress(p: void*, n: int): ByteBuf:
mut ok := false
ret BWTDecompressMax(p, n, 0, ok)
end
