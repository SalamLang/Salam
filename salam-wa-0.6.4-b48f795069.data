func _tone(c: css.Color, dark: bool): css.Color:
r := c.r as f64
g := c.g as f64
b := c.b as f64
if dark:
if r * r + g * g + b * b <= 3072.0:
ret css.Color { r = math.MinI(255, c.r + 84), g = math.MinI(255, c.g + 84), b = math.MinI(255, c.b + 84), a = c.a }
end
v := math.Max(r, math.Max(g, b)) / 255.0
m := math.Max(0.0, (v - 0.33) / v)
ret css.Color { r = _tone_ch(m, c.r), g = _tone_ch(m, c.g), b = _tone_ch(m, c.b), a = c.a }
end
