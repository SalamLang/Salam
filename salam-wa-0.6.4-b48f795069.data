@en "CommandName"
@fa "نام دستور"
pub func CommandName(text: str): str:
if not IsCommand(text): ret "" end
sp := text.find(" ")
mut head := text
if sp >= 0: head = text.substr(0, sp) end
at := head.find("@")
if at >= 0: head = head.substr(0, at) end
ret head.substr(1, head.len() - 1)
end
@en "CommandArgs"
@fa "آرگومان های دستور"
pub func CommandArgs(text: str): str:
sp := text.find(" ")
if sp < 0: ret "" end
ret text.substr(sp + 1, text.len() - sp - 1).trim()
end
@en "Poll"
@fa "حلقه دریافت"
pub func Poll(bot: Bot, timeout: i64, handler: func (Update)):
mut offset := 0 as i64
until true:
resp := GetUpdates(bot, offset, 100, timeout)
if resp.ok:
updates := ParseUpdates(resp.result)
repeat updates.len() in i:
u := updates.get(i)
handler(u)
if u.update_id >= offset: offset = u.update_id + 1 end
end
updates.free()
else:
printerr "getUpdates failed (HTTP " + str.FromInt(resp.http_status) + ", code " + str.FromInt(resp.error_code) + "): " + resp.description
time.Sleep(1000)
end
end
end
package bot
import encoding.json
@en "SECRET_HEADER"
@fa "سرآیند راز"
pub const SECRET_HEADER := "X-Telegram-Bot-Api-Secret-Token"
func _reply(members: Vector<str>): str:
out := json.Object(members)
members.free()
ret out
end
@en "SetWebhookSecret"
@fa "تنظیم وب هوک با رمز"
pub func SetWebhookSecret(bot: Bot, url: str, secret_token: str): ApiResponse:
mut params := _new_params()
params.put("url", url)
params.put("secret_token", secret_token)
params.put("drop_pending_updates", "true")
ret _call(bot, "setWebhook", params)
end
@en "ReplyMessage"
@fa "پاسخ پیام"
pub func ReplyMessage(chat_id: i64, text: str): str:
ret ReplyMessageOptions(chat_id, text, SendOptions {})
end
@en "ReplyMessageOptions"
@fa "پاسخ پیام با گزینه ها"
pub func ReplyMessageOptions(chat_id: i64, text: str, opts: SendOptions): str:
mut m := Vector {} as Vector<str>
m.push(json.Member("method", "sendMessage"))
m.push(json.MemberInt("chat_id", chat_id))
m.push(json.Member("text", text))
if opts.parse_mode.len() > 0: m.push(json.Member("parse_mode", opts.parse_mode)) end
if opts.disable_notification: m.push(json.MemberBool("disable_notification", true)) end
if opts.reply_to_message_id > 0: m.push(json.MemberInt("reply_to_message_id", opts.reply_to_message_id)) end
if opts.reply_markup.len() > 0: m.push(json.MemberRaw("reply_markup", opts.reply_markup)) end
ret _reply(m)
end
@en "ReplyEditMessageText"
@fa "پاسخ ویرایش متن پیام"
pub func ReplyEditMessageText(chat_id: i64, message_id: i64, text: str, reply_markup: str): str:
mut m := Vector {} as Vector<str>
m.push(json.Member("method", "editMessageText"))
m.push(json.MemberInt("chat_id", chat_id))
m.push(json.MemberInt("message_id", message_id))
m.push(json.Member("text", text))
if reply_markup.len() > 0: m.push(json.MemberRaw("reply_markup", reply_markup)) end
ret _reply(m)
end
@en "ReplyAnswerCallbackQuery"
@fa "پاسخ فوری پرسمان بازخوان"
pub func ReplyAnswerCallbackQuery(callback_query_id: str, text: str, show_alert: bool): str:
mut m := Vector {} as Vector<str>
m.push(json.Member("method", "answerCallbackQuery"))
m.push(json.Member("callback_query_id", callback_query_id))
if text.len() > 0: m.push(json.Member("text", text)) end
if show_alert: m.push(json.MemberBool("show_alert", true)) end
ret _reply(m)
end
@en "ReplyChatAction"
@fa "پاسخ کنش گفتگو"
pub func ReplyChatAction(chat_id: i64, action: str): str:
mut m := Vector {} as Vector<str>
m.push(json.Member("method", "sendChatAction"))
m.push(json.MemberInt("chat_id", chat_id))
m.push(json.Member("action", action))
ret _reply(m)
end
@en "telegram"
@fa "تلگرام"
package telegram
@en "template"
@fa "قالب"
package template
import mem
import str
func _lookup(ctx: HashMap<str, str>, key: str): str:
if ctx.has(key): ret ctx.get(key) end
ret ""
end
func _truthy(ctx: HashMap<str, str>, key: str): bool:
if ctx.has(key) == false: ret false end
v := ctx.get(key)
ret v != "" and v != "false" and v != "0"
end
func _all_true(stack: Vector<bool>): bool:
repeat stack.len() in i:
if stack.get(i) == false: ret false end
end
ret true
end
func _find2(p: i8 *, n: int, from: int, x: int, y: int): int:
mut i := from
until i + 1 < n:
if p[i] == (x as i8) and p[i + 1] == (y as i8): ret i end
i++
end
ret 0 - 1
end
func _append_range(b &: str.StringBuilder, p: i8 *, lo: int, hi: int):
mut k := lo
until k < hi:
str.BufAppendChar(b, p[k] as int)
k++
end
end
func _render(tmpl: str, ctx: HashMap<str, str>, escape: bool): str:
mut b := str.NewBuilder()
defer str.BufFree(b)
stack := Vector {} as Vector<bool> defer stack.free()
n := tmpl.len()
p := tmpl as i8 *
mut i := 0
until i < n:
lb := _find2(p, n, i, 123, 123)
if lb < 0:
if _all_true(stack):
_append_range(b, p, i, n)
end
i = n
else:
if lb > i and _all_true(stack):
_append_range(b, p, i, lb)
end
rb := _find2(p, n, lb + 2, 125, 125)
if rb < 0:
if _all_true(stack):
_append_range(b, p, lb, n)
end
i = n
else:
raw := tmpl.substr(lb + 2, rb - lb - 2)
tag := str.Trim(raw)
mem.Free(raw as void *)
if str.StartsWith(tag, "#if "):
rest := str.TrimPrefix(tag, "#if ")
key := str.Trim(rest)
mem.Free(rest as void *)
stack.push(_truthy(ctx, key))
mem.Free(key as void *)
else tag == "else":
if stack.len() > 0:
top := stack.pop()
stack.push(top == false)
end
else tag == "/if":
if stack.len() > 0:
_dropped := stack.pop()
end
else str.StartsWith(tag, "!") == false and _all_true(stack):
v := _lookup(ctx, tag)
if escape:
e := EscapeHTML(v)
str.BufAppend(b, e)
mem.Free(e as void *)
else:
str.BufAppend(b, v)
end
end
mem.Free(tag as void *)
i = rb + 2
end
end
end
out := str.BufStr(b)
ret out
end
@en "NewContext"
@fa "زمینه جدید"
pub func NewContext(): HashMap<str, str>:
m := HashMap {} as HashMap<str, str> ret m
end
@en "EscapeHTML"
@fa "گریز اچ تی ام ال"
pub func EscapeHTML(s: str): str:
n := s.len()
p := s as i8 *
mut b := str.NewBuilder()
defer str.BufFree(b)
repeat n in i:
c := p[i] as int
if c == 38:
str.BufAppend(b, "&amp;")
else c == 60:
str.BufAppend(b, "&lt;")
else c == 62:
str.BufAppend(b, "&gt;")
else c == 34:
str.BufAppend(b, "&quot;")
else c == 39:
str.BufAppend(b, "&#39;")
else:
str.BufAppendChar(b, c)
end
end
out := str.BufStr(b)
ret out
end
@en "Render"
@fa "رندر"
pub func Render(tmpl: str, ctx: HashMap<str, str>): str:
ret _render(tmpl, ctx, false)
end
@en "RenderHTML"
@fa "رندر اچ تی ام ال"
pub func RenderHTML(tmpl: str, ctx: HashMap<str, str>): str:
ret _render(tmpl, ctx, true)
end
@en "Var"
@fa "متغیر"
pub func Var(name: str): str:
ret "{{".concat(name).concat("}}")
end
@en "term"
@fa "پایانه"
package term
import str
import mem
extern:
func printf(fmt: str, ...): int
func fflush(stream: void*): int
func getenv(name: str): void*
func memset(ptr: void*, val: int, n: u64): void*
end
if SALAM_OS_WINDOWS:
extern:
func _isatty(fd: int): int
func GetStdHandle(which: int): void*
func GetConsoleMode(h: void*, mode: void*): int
func SetConsoleMode(h: void*, mode: int): int
func GetConsoleScreenBufferInfo(h: void*, info: void*): int
end
else:
extern:
func isatty(fd: int): int
func ioctl(fd: int, req: usize, ...): int
func tcgetattr(fd: int, t: void*): int
func tcsetattr(fd: int, act: int, t: void*): int
func cfmakeraw(t: void*)
end
end
@en "StdinFd"
@fa "شناسه ورودی"
pub const StdinFd := 0
@en "StdoutFd"
@fa "شناسه خروجی"
pub const StdoutFd := 1
@en "StderrFd"
@fa "شناسه خطا"
pub const StderrFd := 2
@en "Esc"
@fa "گریز"
pub const Esc := "\x1b"
@en "Csi"
@fa "آغازگر دنباله"
pub const Csi := "\x1b["
@en "ColorAuto"
@fa "رنگ خودکار"
pub const ColorAuto := 0
@en "ColorAlways"
@fa "رنگ همیشه"
pub const ColorAlways := 1
@en "ColorNever"
@fa "بدون رنگ"
pub const ColorNever := 2
const _TCSAFLUSH := 2
const _TERMIOS_CAP := 128
const _TIOCGWINSZ_LINUX := 0x5413
const _TIOCGWINSZ_BSD := 0x40087468
const _ECHO := 0x8
mut _color_mode := 0
mut _color_auto := 0
@en "TermState"
@fa "وضعیت پایانه"
pub struct TermState:
@en "fd"
@fa "شناسه پرونده"
pub fd: int = 0
@en "saved"
@fa "تنظیمات قبلی"
pub saved: void* = null
@en "mode_in"
@fa "حالت قبلی‌ورودی"
pub mode_in: int = 0
@en "mode_out"
@fa "حالت قبلی خروجی"
pub mode_out: int = 0
@en "ok"
@fa "موفق"
pub ok: bool = false
end
@en "WinSize"
@fa "اندازه پنجره"
pub struct WinSize:
@en "cols"
@fa "ستون‌ها"
pub cols: int = 80
@en "rows"
@fa "سطرها"
pub rows: int = 24
end
func _env(name: str): str:
v := getenv(name)
if v == null: ret "" end
ret str.Clone(v as str)
end
func _lflag_off(): int:
if SALAM_OS_MAC: ret 24 else:
ret 12
end
end
func _vmin_off(): int:
if SALAM_OS_MAC: ret 48
else SALAM_OS_BSD: ret 32
else:
ret 23
end
end
func _vtime_off(): int:
if SALAM_OS_MAC: ret 49
else SALAM_OS_BSD: ret 33
else:
ret 22
end
end
func _icanon_bit(): int:
if SALAM_OS_MAC or SALAM_OS_BSD: ret 0x100 else:
ret 0x2
end
end
func _winsz_req(): u64:
if SALAM_OS_MAC or SALAM_OS_BSD: ret _TIOCGWINSZ_BSD
else:
ret _TIOCGWINSZ_LINUX
end
end
func _win_handle(_fd: int): void*:
if SALAM_OS_WINDOWS:
if _fd == StdinFd: ret GetStdHandle(0 - 10) end
if _fd == StderrFd: ret GetStdHandle(0 - 12) end
ret GetStdHandle(0 - 11)
else:
ret null
end
end
func _win_mode(_fd: int): int:
if SALAM_OS_WINDOWS:
h := _win_handle(_fd)
if h == null: ret 0 end
buf := mem.Allocate(8 as u64)
defer mem.Free(buf)
memset(buf, 0, 8 as u64)
if GetConsoleMode(h, buf) == 0: ret 0 end
p := buf as int*
ret p[0]
else:
ret 0
end
end
func _detect_color(): bool:
if getenv("NO_COLOR") != null: ret false end
force := _env("CLICOLOR_FORCE")
if force.len() > 0 and force != "0": ret true end
if _env("TERM") == "dumb": ret false end
ret IsTTY(StdoutFd)
end
func _set_mode(fd: int, full: bool): TermState:
mut st := TermState { fd = fd }
if SALAM_OS_WINDOWS:
h := _win_handle(fd)
if h == null: ret st end
st.mode_in = _win_mode(fd)
st.mode_out = _win_mode(StdoutFd)
mut m := st.mode_in & ~(0x2 | 0x4)
if full: m &= ~0x1 end
m |= 0x200
if SetConsoleMode(h, m) == 0: ret st end
_vt := EnableAnsi()
st.ok = true
ret st
else:
saved := mem.Allocate(_TERMIOS_CAP as u64)
memset(saved, 0, _TERMIOS_CAP as u64)
if tcgetattr(fd, saved) != 0:
mem.Free(saved)
ret st
end
work := mem.Allocate(_TERMIOS_CAP as u64)
defer mem.Free(work)
mem.Copy(work, saved, _TERMIOS_CAP as u64)
if full:
cfmakeraw(work)
else:
lf := ((work as i64) + _lflag_off()) as int*
lf[0] = lf[0] & ~(_ECHO | _icanon_bit())
end
vmin := ((work as i64) + _vmin_off()) as i8*
vtime := ((work as i64) + _vtime_off()) as i8*
vmin[0] = 1 as i8
vtime[0] = 0 as i8
if tcsetattr(fd, _TCSAFLUSH, work) != 0:
mem.Free(saved)
ret st
end
st.saved = saved
st.ok = true
ret st
end
end
@en "Write"
@fa "نوشتن"
pub func Write(s: str):
_n := printf("%s", s)
end
@en "WriteErr"
@fa "نوشتن خطا"
pub func WriteErr(s: str):
printerr s
end
@en "Flush"
@fa "تخلیه"
pub func Flush():
_r := fflush(null as void*)
end
@en "Emit"
@fa "فرستادن"
pub func Emit(s: str):
Write(s)
Flush()
end
@en "IsTTY"
@fa "پایانه است"
pub func IsTTY(fd: int): bool:
if SALAM_OS_WINDOWS:
if _isatty(fd) == 0: ret false end
if fd != StdinFd and fd != StdoutFd and fd != StderrFd: ret true end
mode := mem.Allocate(4 as u64)
defer mem.Free(mode)
ret GetConsoleMode(_win_handle(fd), mode) != 0
else:
ret isatty(fd) != 0
end
end
@en "IsTerminal"
@fa "پایانه دارد"
pub func IsTerminal(): bool: ret IsTTY(StdoutFd) end
@en "Size"
@fa "اندازه"
pub func Size(): WinSize:
mut out := WinSize {}
if SALAM_OS_WINDOWS:
h := _win_handle(StdoutFd)
if h != null:
info := mem.Allocate(32 as u64)
defer mem.Free(info)
memset(info, 0, 32 as u64)
if GetConsoleScreenBufferInfo(h, info) != 0:
base := info as i64
left := ((base + 10) as i16*)[0] as int
top := ((base + 12) as i16*)[0] as int
right := ((base + 14) as i16*)[0] as int
bottom := ((base + 16) as i16*)[0] as int
c := right - left + 1
r := bottom - top + 1
if c > 0 and r > 0:
out.cols = c
out.rows = r
ret out
end
end
end
else:
ws := mem.Allocate(16 as u64)
defer mem.Free(ws)
req := _winsz_req()
mut fd := StdoutFd
until fd <= StderrFd:
memset(ws, 0, 16 as u64)
if ioctl(fd, req as usize, ws) == 0:
p := ws as u16*
r := p[0] as int
c := p[1] as int
if c > 0 and r > 0:
out.cols = c
out.rows = r
ret out
end
end
fd++
end
end
envc := str.ToInt(_env("COLUMNS"))
envr := str.ToInt(_env("LINES"))
if envc > 0: out.cols = envc end
if envr > 0: out.rows = envr end
ret out
end
@en "Cols"
@fa "ستون ها"
pub func Cols(): int:
s := Size()
ret s.cols
end
@en "Rows"
@fa "سطرها"
pub func Rows(): int:
s := Size()
ret s.rows
end
@en "SetColorMode"
@fa "تنظیم حالت رنگ"
pub func SetColorMode(mode: int):
_color_mode = mode
end
@en "ColorMode"
@fa "حالت رنگ"
pub func ColorMode(): int: ret _color_mode end
@en "SupportsColor"
@fa "رنگ پشتیبانی می‌شود"
pub func SupportsColor(): bool:
if _color_mode == ColorAlways: ret true end
if _color_mode == ColorNever: ret false end
if _color_auto == 0:
if _detect_color():
_color_auto = 1
else:
_color_auto = 2
end
end
ret _color_auto == 1
end
@en "Supports256Color"
@fa "رنگ۲۵۶ پشتیبانی می‌شود"
pub func Supports256Color(): bool:
if str.Contains(_env("TERM"), "256color"): ret true end
if _env("COLORTERM").len() > 0: ret true end
ret false
end
@en "SupportsTrueColor"
@fa "رنگ کامل پشتیبانی می‌شود"
pub func SupportsTrueColor(): bool:
ct := _env("COLORTERM")
ret ct == "truecolor" or ct == "24bit"
end
@en "EnableAnsi"
@fa "فعال‌سازی انسی"
pub func EnableAnsi(): bool:
if SALAM_OS_WINDOWS:
h := _win_handle(StdoutFd)
if h == null: ret false end
buf := mem.Allocate(8 as u64)
defer mem.Free(buf)
memset(buf, 0, 8 as u64)
if GetConsoleMode(h, buf) == 0: ret true end
p := buf as int*
ret SetConsoleMode(h, p[0] | 0x4) != 0
else:
ret true
end
end
@en "MakeRaw"
@fa "حالت خام"
pub func MakeRaw(fd: int): TermState: ret _set_mode(fd, true) end
@en "MakeCbreak"
@fa "حالت نیمه‌خام"
pub func MakeCbreak(fd: int): TermState: ret _set_mode(fd, false) end
@en "Restore"
@fa "بازگردانی"
pub func Restore(st &: TermState): bool:
if not st.ok: ret false end
mut done := false
if SALAM_OS_WINDOWS:
h := _win_handle(st.fd)
if h != null: done = SetConsoleMode(h, st.mode_in) != 0 end
else:
if st.saved != null:
done = tcsetattr(st.fd, _TCSAFLUSH, st.saved) == 0
mem.Free(st.saved)
st.saved = null
end
end
st.ok = false
ret done
end
@en "Bell"
@fa "زنگ"
pub func Bell(): Emit("\x07") end
@en "SeqTitle"
@fa "دنباله عنوان"
pub func SeqTitle(title: str): str: ret Esc + "]0;" + title + "\x07" end
@en "SetTitle"
@fa "تنظیم عنوان"
pub func SetTitle(title: str): Emit(SeqTitle(title)) end
