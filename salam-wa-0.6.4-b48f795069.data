@en "ListenerCount"
@fa "شمار شنونده"
pub func ListenerCount(c: Client, name: str): int:
if c.p == null:
ret 0
end
sp := _sock(c)
mut n := 0
repeat sp[0].handlers.len() in i:
h := sp[0].handlers.get(i)
if h.alive and h.name == name:
n++
end
end
ret n
end
@en "HasListeners"
@fa "شنونده دارد"
pub func HasListeners(c: Client, name: str): bool:
ret ListenerCount(c, name) > 0
end
@en "AnyListenerCount"
@fa "شمار شنونده دلخواه"
pub func AnyListenerCount(c: Client): int:
if c.p == null:
ret 0
end
sp := _sock(c)
ret sp[0].any_handlers.len() + sp[0].out_handlers.len()
end
