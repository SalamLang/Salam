struct Simple:
pub k: int = 0
pub name: str = ""
pub value: str = ""
pub op: int = 0
pub a: int = 0
pub b: int = 0
pub icase: bool = false
end
struct Compound:
pub s0: int = 0
pub n: int = 0
pub comb: int = CB_NONE
end
struct Selector:
pub c0: int = 0
pub n: int = 0
pub spec: int = 0
pub state_left: bool = false
pub sibling: bool = false
end
struct SelParser:
pub src: str = ""
pub p: u8* = null
pub n: int = 0
pub i: int = 0
end
struct Dom:
pub count: int = 0
pub tags: Vector<str> = Vector {}
pub ids: Vector<str> = Vector {}
pub cls0: Vector<int> = Vector {}
pub clsn: Vector<int> = Vector {}
pub classes: Vector<str> = Vector {}
pub parent: Vector<int> = Vector {}
pub prev: Vector<int> = Vector {}
pub next: Vector<int> = Vector {}
pub first: Vector<int> = Vector {}
pub last: Vector<int> = Vector {}
pub state: Vector<int> = Vector {}
pub els: Vector<Element> = Vector {}
pub root_dir: str = "ltr"
pub root_lang: str = "en"
end
func sp_peek(sp: SelParser, off: int): int:
j := sp.i + off
if j < sp.n:
ret sp.p[j] as int
end
ret 0
end
func sp_ws(sp &: SelParser): bool:
mut any := false
until sp.i < sp.n and is_space(sp.p[sp.i] as int):
sp.i++
any = true
end
ret any
end
func sp_ident(sp &: SelParser): str:
st := sp.i
mut j := sp.i
if j < sp.n and (sp.p[j] as int) == 45:
j++
end
if j < sp.n and (sp.p[j] as int) == 45:
j++
end
if j >= sp.n or not (is_name_start(sp.p[j] as int) or (sp.p[j] as int) == 92):
ret ""
end
e := name_end(sp.p, sp.n, j)
sp.i = e
raw := sp.src.substr(st, e - st)
r := unescape(raw)
sfree(raw)
ret r
end
func parse_nth(text: str, a &: int, b &: int): bool:
t := lower_ascii(text)
defer sfree(t)
mut s := str.Trim(t)
defer sfree(s)
if s == "odd":
a = 2
b = 1
ret true
end
if s == "even":
a = 2
b = 0
ret true
end
p := (s as void*) as u8*
n := s.len()
mut i := 0
mut sign := 1
mut has_n := false
mut av := 0
mut bv := 0
if i < n and ((p[i] as int) == 43 or (p[i] as int) == 45):
sign = (p[i] as int) == 45 ? -1 : 1
i++
end
mut digits := 0
mut num := 0
until i < n and is_digit(p[i] as int):
num = num * 10 + (p[i] as int) - 48
digits++
i++
end
if i < n and (p[i] as int) == 110:
has_n = true
av = sign * (digits > 0 ? num : 1)
i++
until i < n and is_space(p[i] as int):
i++
end
if i < n:
mut bs := 1
if (p[i] as int) == 43:
bs = 1
else (p[i] as int) == 45:
bs = -1
else:
ret false
end
i++
until i < n and is_space(p[i] as int):
i++
end
mut bd := 0
mut bn := 0
until i < n and is_digit(p[i] as int):
bn = bn * 10 + (p[i] as int) - 48
bd++
i++
end
if bd == 0:
ret false
end
bv = bs * bn
end
else:
if digits == 0:
ret false
end
bv = sign * num
end
if i != n:
ret false
end
a = has_n ? av : 0
b = bv
ret true
end
func pseudo_code(name: str): int:
switch name:
"hover": ret PS_HOVER end
"focus": ret PS_FOCUS end
"focus-visible": ret PS_FOCUS_VISIBLE end
"focus-within": ret PS_FOCUS_WITHIN end
"active": ret PS_ACTIVE end
"first-child": ret PS_FIRST_CHILD end
"last-child": ret PS_LAST_CHILD end
"only-child": ret PS_ONLY_CHILD end
"root": ret PS_ROOT end
"empty": ret PS_EMPTY end
"first-of-type": ret PS_FIRST_OF_TYPE end
"last-of-type": ret PS_LAST_OF_TYPE end
"only-of-type": ret PS_ONLY_OF_TYPE end
"checked": ret PS_CHECKED end
"disabled": ret PS_DISABLED end
"enabled": ret PS_ENABLED end
"required": ret PS_REQUIRED end
"optional": ret PS_OPTIONAL end
"link", "any-link", "-webkit-any-link": ret PS_LINK end
"visited", "target", "indeterminate", "invalid", "user-invalid", "fullscreen", "modal", "autofill", "-webkit-autofill", "popover-open", "defined", "playing", "paused", "default", "in-range", "out-of-range", "valid", "user-valid", "scope", "target-within", "blank":
ret PS_NEVER
end
"placeholder-shown": ret PS_PLACEHOLDER_SHOWN end
"read-only": ret PS_READ_ONLY end
"read-write": ret PS_READ_WRITE end
"open": ret PS_OPEN end
else: ret 0 end
end
ret 0
end
func paren_body(sp &: SelParser, out &: str): bool:
if sp.i >= sp.n or (sp.p[sp.i] as int) != 40:
ret false
end
st := sp.i + 1
mut depth := 1
mut j := st
mut q := 0
until j < sp.n:
c := sp.p[j] as int
if q != 0:
if c == q:
q = 0
end
else c == 34 or c == 39:
q = c
else c == 40:
depth++
else c == 41:
depth--
if depth == 0:
break
end
end
j++
end
if depth != 0:
ret false
end
out = sp.src.substr(st, j - st)
sp.i = j + 1
ret true
end
func parse_attr_sel(sp &: SelParser, out &: Simple): bool:
sp.i++
_w := sp_ws(sp)
name := sp_ident(sp)
if name.len() == 0:
ret false
end
out.k = SK_ATTR
out.name = intern_own(lower_ascii(name))
sfree(name)
_w2 := sp_ws(sp)
c := sp_peek(sp, 0)
if c == 93:
sp.i++
out.op = AT_HAS
ret true
end
mut op := -1
if c == 61:
op = AT_EQ
sp.i++
else sp_peek(sp, 1) == 61:
switch c:
126: op = AT_INCL break end
124: op = AT_DASH break end
94: op = AT_PREFIX break end
36: op = AT_SUFFIX break end
42: op = AT_SUB break end
else: ret false end
end
sp.i += 2
else:
ret false
end
out.op = op
_w3 := sp_ws(sp)
q := sp_peek(sp, 0)
if q == 34 or q == 39:
st := sp.i + 1
mut j := st
until j < sp.n and (sp.p[j] as int) != q:
if (sp.p[j] as int) == 92:
j++
end
j++
end
if j >= sp.n:
ret false
end
raw := sp.src.substr(st, j - st)
out.value = intern_own(unescape(raw))
sfree(raw)
sp.i = j + 1
else:
v := sp_ident(sp)
if v.len() == 0:
mut j := sp.i
until j < sp.n and is_digit(sp.p[j] as int):
j++
end
if j == sp.i:
ret false
end
out.value = intern_own(sp.src.substr(sp.i, j - sp.i))
sp.i = j
else:
out.value = intern_own(v)
end
end
_w4 := sp_ws(sp)
f := sp_peek(sp, 0)
if f == 105 or f == 73:
out.icase = true
sp.i++
_w5 := sp_ws(sp)
else f == 115 or f == 83:
sp.i++
_w6 := sp_ws(sp)
end
if sp_peek(sp, 0) != 93:
ret false
end
sp.i++
ret true
end
func parse_pseudo(sd &: SheetData, sp &: SelParser, out &: Simple, spec &: int): bool:
sp.i++
if sp_peek(sp, 0) == 58:
ret false
end
raw := sp_ident(sp)
if raw.len() == 0:
ret false
end
name := lower_ascii(raw)
sfree(raw)
defer sfree(name)
if name == "before" or name == "after" or name == "first-line" or name == "first-letter":
ret false
end
if sp_peek(sp, 0) == 40:
mut body := ""
if not paren_body(sp, body):
ret false
end
defer sfree(body)
switch name:
"nth-child", "nth-last-child", "nth-of-type", "nth-last-of-type":
mut a := 0
mut b := 0
if not parse_nth(body, a, b):
ret false
end
out.k = SK_NTH
out.a = a
out.b = b
switch name:
"nth-child": out.op = NTH_CHILD break end
"nth-last-child": out.op = NTH_LAST_CHILD break end
"nth-of-type": out.op = NTH_OF_TYPE break end
else: out.op = NTH_LAST_OF_TYPE end
end
spec += 1000
ret true
end
"not", "is", "where", "matches", "-webkit-any", "any":
mut sels := Vector {} as Vector<int>
defer sels.free()
if not parse_selector_list(sd, body, sels):
ret false
end
out.k = SK_LIST
out.op = name == "not" ? LIST_NOT : (name == "where" ? LIST_WHERE : LIST_IS)
out.a = sels.len() > 0 ? sels[0] : 0
out.b = sels.len()
if out.op != LIST_WHERE:
mut best := 0
repeat sels.len() in k:
sv := sd.selectors[sels[k]].spec
if sv > best:
best = sv
end
end
spec += best
end
ret true
end
"dir":
out.k = SK_PSEUDO
tb := str.Trim(body)
out.a = tb == "rtl" ? PS_DIR_RTL : PS_DIR_LTR
sfree(tb)
spec += 1000
ret true
end
"lang":
out.k = SK_PSEUDO
out.a = PS_LANG
out.value = intern_own(str.Trim(body))
spec += 1000
ret true
end
else:
ret false
end
end
end
code := pseudo_code(name)
if code == 0:
ret false
end
out.k = SK_PSEUDO
out.a = code
spec += 1000
ret true
end
func parse_compound(sd &: SheetData, sp &: SelParser, spec &: int, state &: bool, c &: Compound): bool:
mut local := Vector {} as Vector<Simple>
defer local.free()
mut count := 0
until sp.i < sp.n:
ch := sp.p[sp.i] as int
mut sm := Simple {}
if ch == 42:
sp.i++
count++
continue
else ch == 35:
sp.i++
id := sp_ident(sp)
if id.len() == 0:
ret false
end
sm.k = SK_ID
sm.name = intern_own(id)
spec += 1000000
else ch == 46:
sp.i++
cl := sp_ident(sp)
if cl.len() == 0:
ret false
end
sm.k = SK_CLASS
sm.name = intern_own(cl)
spec += 1000
else ch == 91:
if not parse_attr_sel(sp, sm):
ret false
end
spec += 1000
else ch == 58:
if not parse_pseudo(sd, sp, sm, spec):
ret false
end
if sm.k == SK_PSEUDO and (sm.a == PS_HOVER or sm.a == PS_FOCUS or sm.a == PS_FOCUS_VISIBLE or sm.a == PS_ACTIVE or sm.a == PS_FOCUS_WITHIN):
state = true
end
if sm.k == SK_LIST:
state = true
end
else is_name_start(ch) or ch == 45 or ch == 92:
if count > 0:
ret false
end
tg := sp_ident(sp)
if tg.len() == 0:
ret false
end
sm.k = SK_TAG
sm.name = intern_own(lower_ascii(tg))
sfree(tg)
spec++
else:
break
end
local.push(sm)
count++
end
c.s0 = sd.simples.len()
repeat local.len() in k:
sd.simples.push(local[k])
end
c.n = local.len()
ret count > 0
end
func parse_complex(sd &: SheetData, text: str, out &: int): bool:
mut sp := SelParser { src = text, p = (text as void*) as u8*, n = text.len() }
_w := sp_ws(sp)
mut comps := Vector {} as Vector<Compound>
defer comps.free()
mut spec := 0
mut comb := CB_NONE
mut state_left := false
mut last_state := false
mut sibling := false
mut need := false
until sp.i < sp.n:
mut st := false
mut c := Compound {}
if not parse_compound(sd, sp, spec, st, c):
ret false
end
need = false
c.comb = comb
comps.push(c)
if last_state:
state_left = true
end
last_state = st
ws := sp_ws(sp)
if sp.i >= sp.n:
break
end
ch := sp.p[sp.i] as int
if ch == 62 or ch == 43 or ch == 126:
need = true
end
if ch == 62:
comb = CB_CHILD
sp.i++
_w2 := sp_ws(sp)
else ch == 43:
comb = CB_ADJ
sibling = true
sp.i++
_w3 := sp_ws(sp)
else ch == 126:
comb = CB_SIB
sibling = true
sp.i++
_w4 := sp_ws(sp)
else ws:
comb = CB_DESC
else:
ret false
end
end
if need:
ret false
end
if comps.len() == 0:
ret false
end
c0 := sd.compounds.len()
repeat comps.len() in k:
sd.compounds.push(comps[k])
end
sd.selectors.push(Selector { c0 = c0, n = comps.len(), spec = spec, state_left = state_left, sibling = sibling })
out = sd.selectors.len() - 1
ret true
end
func split_top_commas(text: str, out &: Vector<str>):
n := text.len()
p := (text as void*) as u8*
mut depth := 0
mut q := 0
mut st := 0
repeat n in i:
c := p[i] as int
if q != 0:
if c == q:
q = 0
end
else c == 34 or c == 39:
q = c
else c == 40 or c == 91:
depth++
else (c == 41 or c == 93) and depth > 0:
depth--
else c == 44 and depth == 0:
out.push(text.substr(st, i - st))
st = i + 1
end
end
out.push(text.substr(st, n - st))
end
func parse_selector_list(sd &: SheetData, text: str, out &: Vector<int>): bool:
mut parts := Vector {} as Vector<str>
split_top_commas(text, parts)
mut ok := true
repeat parts.len() in i:
mut si := 0
if ok and not parse_complex(sd, parts[i], si):
ok = false
end
if ok:
out.push(si)
end
sfree(parts[i])
end
parts.free()
ret ok and out.len() > 0
end
func dom_parent(d &: Dom, i: int): int:
ret d.parent[i]
end
func attr_of(d &: Dom, i: int, name: str, out &: str): bool:
if i == d.count:
if name == "dir":
out = d.root_dir
ret true
end
if name == "lang":
out = d.root_lang
ret true
end
ret false
end
e := d.els[i]
repeat e.attr_names.len() in k:
if e.attr_names[k] == name:
out = e.attr_values[k]
ret true
end
end
if name == "id" and d.ids[i].len() > 0:
out = d.ids[i]
ret true
end
if name == "class" and e.classes.len() > 0:
out = e.classes
ret true
end
ret false
end
func eq_case(a: str, b: str, icase: bool): bool:
if not icase:
ret a == b
end
la := lower_ascii(a)
lb := lower_ascii(b)
r := la == lb
sfree(la)
sfree(lb)
ret r
end
func attr_match(d &: Dom, i: int, sm &: Simple): bool:
mut v := ""
if not attr_of(d, i, sm.name, v):
ret false
end
switch sm.op:
AT_HAS: ret true end
AT_EQ: ret eq_case(v, sm.value, sm.icase) end
AT_INCL:
mut parts := str.Fields(v)
mut found := false
repeat parts.len() in k:
if eq_case(parts[k], sm.value, sm.icase):
found = true
end
end
parts.free()
ret found
end
AT_DASH:
ret eq_case(v, sm.value, sm.icase) or str.StartsWith(v, sm.value + "-")
end
AT_PREFIX: ret sm.value.len() > 0 and str.StartsWith(v, sm.value) end
AT_SUFFIX: ret sm.value.len() > 0 and str.EndsWith(v, sm.value) end
else: ret sm.value.len() > 0 and str.Contains(v, sm.value) end
end
ret false
end
func sib_index(d &: Dom, i: int, from_end: bool, of_type: bool): int:
mut k := 1
mut j := from_end ? d.next[i] : d.prev[i]
until j >= 0:
if not of_type or d.tags[j] == d.tags[i]:
k++
end
j = from_end ? d.next[j] : d.prev[j]
end
ret k
end
func nth_ok(a: int, b: int, idx: int): bool:
if a == 0:
ret idx == b
end
diff := idx - b
if diff % a != 0:
ret false
end
ret diff / a >= 0
end
func has_state_desc(d &: Dom, i: int, mask: int): bool:
mut c := d.first[i]
until c >= 0:
if (d.state[c] & mask) != 0 or has_state_desc(d, c, mask):
ret true
end
c = d.next[c]
end
ret false
end
func lang_of(d &: Dom, i: int): str:
mut j := i
until j >= 0:
mut v := ""
if attr_of(d, j, "lang", v):
ret v
end
j = d.parent[j]
end
ret ""
end
func dir_of(d &: Dom, i: int): str:
mut j := i
until j >= 0:
mut v := ""
if attr_of(d, j, "dir", v) and (v == "rtl" or v == "ltr"):
ret v
end
j = d.parent[j]
end
ret "ltr"
end
func is_form_control(tag: str): bool:
ret tag == "input" or tag == "button" or tag == "select" or tag == "textarea" or tag == "option" or tag == "optgroup" or tag == "fieldset"
end
func pseudo_match(d &: Dom, i: int, code: int): bool:
st := d.state[i]
switch code:
PS_HOVER: ret (st & ST_HOVER) != 0 end
PS_FOCUS: ret (st & ST_FOCUS) != 0 end
PS_FOCUS_VISIBLE: ret (st & ST_FOCUS_VISIBLE) != 0 end
PS_ACTIVE: ret (st & ST_ACTIVE) != 0 end
PS_FOCUS_WITHIN: ret (st & ST_FOCUS) != 0 or has_state_desc(d, i, ST_FOCUS) end
PS_FIRST_CHILD: ret i != d.count and d.prev[i] < 0 end
PS_LAST_CHILD: ret i != d.count and d.next[i] < 0 end
PS_ONLY_CHILD: ret i != d.count and d.prev[i] < 0 and d.next[i] < 0 end
PS_ROOT: ret i == d.count end
PS_EMPTY: ret d.first[i] < 0 end
PS_FIRST_OF_TYPE: ret i != d.count and sib_index(d, i, false, true) == 1 end
PS_LAST_OF_TYPE: ret i != d.count and sib_index(d, i, true, true) == 1 end
PS_ONLY_OF_TYPE: ret i != d.count and sib_index(d, i, false, true) == 1 and sib_index(d, i, true, true) == 1 end
PS_CHECKED:
mut v := ""
ret attr_of(d, i, "checked", v) or attr_of(d, i, "selected", v)
end
PS_DISABLED:
mut v := ""
ret is_form_control(d.tags[i]) and attr_of(d, i, "disabled", v)
end
PS_ENABLED:
mut v := ""
ret is_form_control(d.tags[i]) and not attr_of(d, i, "disabled", v)
end
PS_REQUIRED:
mut v := ""
ret attr_of(d, i, "required", v)
end
PS_OPTIONAL:
mut v := ""
tg := d.tags[i]
ret (tg == "input" or tg == "select" or tg == "textarea") and not attr_of(d, i, "required", v)
end
PS_LINK:
mut v := ""
ret d.tags[i] == "a" and attr_of(d, i, "href", v)
end
PS_DIR_RTL: ret dir_of(d, i) == "rtl" end
PS_DIR_LTR: ret dir_of(d, i) == "ltr" end
PS_PLACEHOLDER_SHOWN:
mut v := ""
mut w := ""
ret attr_of(d, i, "placeholder", v) and not (attr_of(d, i, "value", w) and w.len() > 0)
end
PS_READ_ONLY, PS_READ_WRITE:
tg := d.tags[i]
mut v := ""
editable := (tg == "input" or tg == "textarea") and not attr_of(d, i, "readonly", v) and not attr_of(d, i, "disabled", v)
ret code == PS_READ_WRITE ? editable : not editable
end
PS_OPEN:
mut v := ""
ret attr_of(d, i, "open", v)
end
else: ret false end
end
ret false
end
func match_simple(sd &: SheetData, d &: Dom, i: int, sm &: Simple): bool:
switch sm.k:
SK_TAG: ret d.tags[i] == sm.name end
SK_ID: ret d.ids[i] == sm.name end
SK_CLASS:
c0 := d.cls0[i]
repeat d.clsn[i] in k:
if d.classes[c0 + k] == sm.name:
ret true
end
end
ret false
end
SK_ATTR: ret attr_match(d, i, sm) end
SK_PSEUDO:
if sm.a == PS_LANG:
l := lang_of(d, i)
ret eq_case(l, sm.value, true) or str.StartsWith(lower_ascii(l), lower_ascii(sm.value) + "-")
end
ret pseudo_match(d, i, sm.a)
end
SK_NTH:
if i == d.count:
ret false
end
idx := sib_index(d, i, sm.op == NTH_LAST_CHILD or sm.op == NTH_LAST_OF_TYPE, sm.op == NTH_OF_TYPE or sm.op == NTH_LAST_OF_TYPE)
ret nth_ok(sm.a, sm.b, idx)
end
SK_LIST:
mut any := false
repeat sm.b in k:
if match_selector(sd, d, sm.a + k, i):
any = true
break
end
end
ret sm.op == LIST_NOT ? not any : any
end
else: ret false end
end
ret false
end
func match_compound(sd &: SheetData, d &: Dom, ci: int, i: int): bool:
c := sd.compounds[ci]
repeat c.n in k:
if not match_simple(sd, d, i, sd.simples[c.s0 + k]):
ret false
end
end
ret true
end
func match_from(sd &: SheetData, d &: Dom, sel: Selector, k: int, i: int): bool:
ci := sel.c0 + k
if not match_compound(sd, d, ci, i):
ret false
end
if k == 0:
ret true
end
switch sd.compounds[ci].comb:
CB_CHILD:
p := d.parent[i]
ret p >= 0 and match_from(sd, d, sel, k - 1, p)
end
CB_DESC:
mut p := d.parent[i]
until p >= 0:
if match_from(sd, d, sel, k - 1, p):
ret true
end
p = d.parent[p]
end
ret false
end
CB_ADJ:
s := d.prev[i]
ret s >= 0 and match_from(sd, d, sel, k - 1, s)
end
CB_SIB:
mut s := d.prev[i]
until s >= 0:
if match_from(sd, d, sel, k - 1, s):
ret true
end
s = d.prev[s]
end
ret false
end
else: ret false end
end
ret false
end
func match_selector(sd &: SheetData, d &: Dom, si: int, i: int): bool:
sel := sd.selectors[si]
ret match_from(sd, d, sel, sel.n - 1, i)
end
func selector_key(sd: SheetData, si: int): str:
sel := sd.selectors[si]
c := sd.compounds[sel.c0 + sel.n - 1]
mut cls := ""
mut tag := ""
repeat c.n in k:
sm := sd.simples[c.s0 + k]
if sm.k == SK_ID:
ret "#" + sm.name
end
if sm.k == SK_CLASS and cls.len() == 0:
cls = sm.name
end
if sm.k == SK_TAG:
tag = sm.name
end
end
if cls.len() > 0:
ret "." + cls
end
if tag.len() > 0:
ret str.Clone(tag)
end
ret str.Clone("*")
end
package css
import str
import math
import gui.cssbox
func fmt_sig(v: f64): str:
if v != v:
ret str.Clone("0")
end
neg := v < 0.0
av := math.Abs(v)
mut digits := 1
mut t := av
until t >= 10.0:
t /= 10.0
digits++
end
mut d := 6 - digits
if d < 0:
d = 0
end
mut pw := 1 as i64
repeat d:
pw *= 10
end
scaled := math.Floor(av * pw as f64 + 0.5) as i64
ip := scaled / pw
mut fp := scaled % pw
mut b := str.NewBuilder()
if neg and scaled != 0:
str.BufAppend(b, "-")
end
str.BufAppendInt(b, ip)
if fp != 0:
mut fd := d
until fp % 10 == 0:
fp /= 10
fd--
end
str.BufAppend(b, ".")
fs := str.FromInt(fp)
repeat fd - fs.len():
str.BufAppend(b, "0")
end
str.BufAppend(b, fs)
sfree(fs)
end
out := str.BufStr(b)
str.BufFree(b)
ret out
end
func px_text(v: f64): str:
n := fmt_sig(v)
out := n + "px"
sfree(n)
ret out
end
func lenx(l: Len): str:
if l.kind == LenKind.Length and l.calc.len() == 0 and not (l.has_pct and l.px != 0.0):
if l.has_pct:
n := fmt_sig(l.pct)
out := n + "%"
sfree(n)
ret out
end
ret px_text(l.px)
end
ret len_text(l)
end
func align_text(a: cssbox.Align): str:
switch a:
cssbox.Align.Auto: ret "auto" end
cssbox.Align.Normal: ret "normal" end
cssbox.Align.Start: ret "start" end
cssbox.Align.End: ret "end" end
cssbox.Align.FlexStart: ret "flex-start" end
cssbox.Align.FlexEnd: ret "flex-end" end
cssbox.Align.Center: ret "center" end
cssbox.Align.Baseline: ret "baseline" end
cssbox.Align.Stretch: ret "stretch" end
cssbox.Align.SpaceBetween: ret "space-between" end
cssbox.Align.SpaceAround: ret "space-around" end
else: ret "space-evenly" end
end
ret "normal"
end
func display_text(d: Display): str:
switch d:
Display.Block: ret "block" end
Display.Inline: ret "inline" end
Display.InlineBlock: ret "inline-block" end
Display.FlowRoot: ret "flow-root" end
Display.Flex: ret "flex" end
Display.InlineFlex: ret "inline-flex" end
Display.Grid: ret "grid" end
Display.InlineGrid: ret "inline-grid" end
Display.ListItem: ret "list-item" end
Display.Table: ret "table" end
Display.InlineTable: ret "inline-table" end
Display.TableRowGroup: ret "table-row-group" end
Display.TableHeaderGroup: ret "table-header-group" end
Display.TableFooterGroup: ret "table-footer-group" end
Display.TableRow: ret "table-row" end
Display.TableCell: ret "table-cell" end
Display.TableColumn: ret "table-column" end
Display.TableColumnGroup: ret "table-column-group" end
Display.TableCaption: ret "table-caption" end
Display.Contents: ret "contents" end
else: ret "none" end
end
ret "none"
end
func style_text(s: BorderStyle): str:
switch s:
BorderStyle.None: ret "none" end
BorderStyle.Hidden: ret "hidden" end
BorderStyle.Solid: ret "solid" end
BorderStyle.Dashed: ret "dashed" end
BorderStyle.Dotted: ret "dotted" end
BorderStyle.Double: ret "double" end
BorderStyle.Groove: ret "groove" end
BorderStyle.Ridge: ret "ridge" end
BorderStyle.Inset: ret "inset" end
BorderStyle.Outset: ret "outset" end
else: ret "auto" end
end
ret "none"
end
func overflow_text(o: cssbox.Overflow): str:
switch o:
cssbox.Overflow.Visible: ret "visible" end
cssbox.Overflow.Hidden: ret "hidden" end
cssbox.Overflow.Clip: ret "clip" end
cssbox.Overflow.Scroll: ret "scroll" end
else: ret "auto" end
end
ret "visible"
end
func shadows_text(v: Vector<Shadow>, text: bool): str:
if v.len() == 0:
ret str.Clone("none")
end
mut b := str.NewBuilder()
repeat v.len() in i:
s := v[i]
if i > 0:
str.BufAppend(b, ", ")
end
c := color_text(s.color)
str.BufAppend(b, c)
sfree(c)
vals := [s.x, s.y, s.blur, s.spread]
n := text ? 3 : 4
repeat n in k:
str.BufAppend(b, " ")
t := px_text(vals[k])
str.BufAppend(b, t)
sfree(t)
end
if s.inset:
str.BufAppend(b, " inset")
end
end
out := str.BufStr(b)
str.BufFree(b)
ret out
end
func stops_text(b &: str.StringBuilder, l: BgLayer):
repeat l.stops.len() in i:
st := l.stops[i]
str.BufAppend(b, ", ")
if not st.hint:
c := color_text(st.color)
str.BufAppend(b, c)
sfree(c)
end
if st.has_pos:
if not st.hint:
str.BufAppend(b, " ")
end
mut p := ""
if l.image == ImageKind.Conic and not st.pos.has_pct:
n := fmt_sig(st.pos.px)
p = n + "deg"
sfree(n)
else:
p = lenx(st.pos)
end
str.BufAppend(b, p)
sfree(p)
end
end
end
func at_text(parts &: str.StringBuilder, l: BgLayer):
cxs := lenx(l.center_x)
cys := lenx(l.center_y)
if cxs != "50%" or cys != "50%":
if str.BufLen(parts) > 0:
str.BufAppend(parts, " ")
end
str.BufAppend(parts, "at ")
str.BufAppend(parts, cxs)
str.BufAppend(parts, " ")
str.BufAppend(parts, cys)
end
sfree(cxs)
sfree(cys)
end
func strip_lead(s: str): str:
i := str.IndexOf(s, "(, ")
if i < 0:
ret s
end
a := s.substr(0, i + 1)
b := s.substr(i + 3, s.len() - i - 3)
out := a + b
sfree(a)
sfree(b)
sfree(s)
ret out
end
func interp_text(l: BgLayer): str:
if not l.interpolation_set:
ret ""
end
names := ["srgb", "srgb-linear", "display-p3", "a98-rgb", "prophoto-rgb", "rec2020", "xyz-d50", "xyz-d65", "lab", "lch", "oklab", "oklch", "hsl", "hwb"]
if l.interpolation < 0 or l.interpolation >= len(names):
ret ""
end
mut out := "in " + names[l.interpolation]
if l.interpolation == SP_LCH or l.interpolation == SP_OKLCH or l.interpolation == SP_HSL or l.interpolation == SP_HWB:
hues := ["", "longer", "increasing", "decreasing"]
if l.hue_interpolation > 0 and l.hue_interpolation < 4:
o2 := out + " " + hues[l.hue_interpolation] + " hue"
sfree(out)
out = o2
end
end
ret out
end
func image_text(l: BgLayer): str:
switch l.image:
ImageKind.None: ret str.Clone("none") end
ImageKind.Url: ret "url(\"" + l.url + "\")" end
else:
end
end
mut b := str.NewBuilder()
if l.repeating:
str.BufAppend(b, "repeating-")
end
switch l.image:
ImageKind.Linear:
str.BufAppend(b, "linear-gradient(")
if l.to_x != 0 or l.to_y != 0:
str.BufAppend(b, "to ")
str.BufAppend(b, l.to_y < 0 ? "top " : "bottom ")
str.BufAppend(b, l.to_x < 0 ? "left" : "right")
else:
n := fmt_sig(l.angle)
str.BufAppend(b, n)
str.BufAppend(b, "deg")
sfree(n)
end
it := interp_text(l)
if it.len() > 0:
str.BufAppend(b, " ")
str.BufAppend(b, it)
sfree(it)
end
break
end
ImageKind.Radial:
str.BufAppend(b, "radial-gradient(")
mut parts := str.NewBuilder()
if l.extent == RadialExtent.Explicit:
rx := lenx(l.radius_x)
str.BufAppend(parts, rx)
sfree(rx)
if l.shape == RadialShape.Ellipse:
ry := lenx(l.radius_y)
str.BufAppend(parts, " ")
str.BufAppend(parts, ry)
sfree(ry)
end
else:
if l.shape == RadialShape.Circle:
str.BufAppend(parts, "circle")
end
mut ek := ""
switch l.extent:
RadialExtent.FarthestSide: ek = "farthest-side" break end
RadialExtent.ClosestCorner: ek = "closest-corner" break end
RadialExtent.ClosestSide: ek = "closest-side" break end
else: ek = "" end
end
if ek.len() > 0:
if str.BufLen(parts) > 0:
str.BufAppend(parts, " ")
end
str.BufAppend(parts, ek)
end
end
at_text(parts, l)
it := interp_text(l)
if it.len() > 0:
if str.BufLen(parts) > 0:
str.BufAppend(parts, " ")
end
str.BufAppend(parts, it)
sfree(it)
end
pt := str.BufStr(parts)
str.BufFree(parts)
str.BufAppend(b, pt)
if pt.len() == 0:
stops_text(b, l)
sfree(pt)
str.BufAppend(b, ")")
out0 := str.BufStr(b)
str.BufFree(b)
ret strip_lead(out0)
end
sfree(pt)
break
end
else:
str.BufAppend(b, "conic-gradient(")
mut parts := str.NewBuilder()
if l.angle != 0.0:
n := fmt_sig(l.angle)
str.BufAppend(parts, "from ")
str.BufAppend(parts, n)
str.BufAppend(parts, "deg")
sfree(n)
end
at_text(parts, l)
it := interp_text(l)
if it.len() > 0:
if str.BufLen(parts) > 0:
str.BufAppend(parts, " ")
end
str.BufAppend(parts, it)
sfree(it)
end
pt := str.BufStr(parts)
str.BufFree(parts)
str.BufAppend(b, pt)
if pt.len() == 0:
stops_text(b, l)
sfree(pt)
str.BufAppend(b, ")")
out0 := str.BufStr(b)
str.BufFree(b)
ret strip_lead(out0)
end
sfree(pt)
end
end
stops_text(b, l)
str.BufAppend(b, ")")
out := str.BufStr(b)
str.BufFree(b)
ret out
end
func layers_text(cs: ComputedStyle, which: int): str:
mut b := str.NewBuilder()
repeat cs.backgrounds.len() in i:
l := cs.backgrounds[i]
if i > 0:
str.BufAppend(b, ", ")
end
mut t := ""
switch which:
0: t = image_text(l) break end
1: t = lenx(l.position_x) break end
2: t = lenx(l.position_y) break end
3:
if l.size_kind == SizeKind.Cover:
t = str.Clone("cover")
else l.size_kind == SizeKind.Contain:
t = str.Clone("contain")
else:
w := lenx(l.size_w)
h := lenx(l.size_h)
t = h == "auto" ? str.Clone(w) : w + " " + h
sfree(w)
sfree(h)
end
break
end
else:
rx := l.repeat_x
ry := l.repeat_y
if rx == Repeat.Repeat and ry == Repeat.NoRepeat:
t = str.Clone("repeat-x")
else rx == Repeat.NoRepeat and ry == Repeat.Repeat:
t = str.Clone("repeat-y")
else:
a := repeat_text(rx)
t = rx == ry ? str.Clone(a) : a + " " + repeat_text(ry)
end
end
end
str.BufAppend(b, t)
sfree(t)
end
out := str.BufStr(b)
str.BufFree(b)
ret out
end
func repeat_text(r: Repeat): str:
switch r:
Repeat.Repeat: ret "repeat" end
Repeat.NoRepeat: ret "no-repeat" end
Repeat.Space: ret "space" end
else: ret "round" end
end
ret "repeat"
end
func timing_text(t: Timing): str:
switch t.kind:
TimingKind.Linear: ret str.Clone("linear") end
TimingKind.Steps:
n := str.FromInt(t.steps as i64)
mut pos := ""
switch t.step_position:
StepPosition.JumpStart: pos = ", jump-start" break end
StepPosition.JumpNone: pos = ", jump-none" break end
StepPosition.JumpBoth: pos = ", jump-both" break end
else: pos = "" end
end
out := "steps(" + n + pos + ")"
sfree(n)
ret out
end
else:
if t.x1 == 0.25 and t.y1 == 0.1 and t.x2 == 0.25 and t.y2 == 1.0:
ret str.Clone("ease")
end
if t.x1 == 0.42 and t.y1 == 0.0 and t.x2 == 1.0 and t.y2 == 1.0:
ret str.Clone("ease-in")
end
if t.x1 == 0.0 and t.y1 == 0.0 and t.x2 == 0.58 and t.y2 == 1.0:
ret str.Clone("ease-out")
end
if t.x1 == 0.42 and t.y1 == 0.0 and t.x2 == 0.58 and t.y2 == 1.0:
ret str.Clone("ease-in-out")
end
a := fmt_sig(t.x1)
b := fmt_sig(t.y1)
c := fmt_sig(t.x2)
d := fmt_sig(t.y2)
out := "cubic-bezier(" + a + ", " + b + ", " + c + ", " + d + ")"
sfree(a)
sfree(b)
sfree(c)
sfree(d)
ret out
end
end
ret str.Clone("ease")
end
func seconds_text(ms: f64): str:
n := fmt_sig(ms / 1000.0)
out := n + "s"
sfree(n)
ret out
end
func transitions_text(cs: ComputedStyle, which: int): str:
mut b := str.NewBuilder()
repeat cs.transitions.len() in i:
t := cs.transitions[i]
if i > 0:
str.BufAppend(b, ", ")
end
mut s := ""
switch which:
0: s = str.Clone(t.property) break end
1: s = seconds_text(t.duration) break end
2: s = timing_text(t.timing) break end
else: s = seconds_text(t.delay) end
end
str.BufAppend(b, s)
sfree(s)
end
out := str.BufStr(b)
str.BufFree(b)
ret out
end
func families_text(f: str): str:
mut parts := str.Split(f, ", ")
mut b := str.NewBuilder()
repeat parts.len() in i:
if i > 0:
str.BufAppend(b, ", ")
end
p := parts[i]
if str.Contains(p, " ") and not is_generic_family(name_id(p)):
str.BufAppend(b, "\"")
str.BufAppend(b, p)
str.BufAppend(b, "\"")
else:
str.BufAppend(b, p)
end
sfree(p)
end
parts.free()
out := str.BufStr(b)
str.BufFree(b)
ret out
end
func corner_text(c: Corner): str:
h := lenx(c.h)
v := lenx(c.v)
if h == v:
sfree(v)
ret h
end
out := h + " " + v
sfree(h)
sfree(v)
ret out
end
func matrix_text(cs: ComputedStyle): str:
if cs.transforms.len() == 0:
ret str.Clone("none")
end
mut c := cs
c.transform_origin_x = Len {}
c.transform_origin_y = Len {}
c.translate_x = Len {}
c.translate_y = Len {}
c.rotate = 0.0
c.scale_x = 1.0
c.scale_y = 1.0
m := matrix_of(c, 0.0, 0.0)
vals := [m.a, m.b, m.c, m.d, m.e, m.f]
mut b := str.NewBuilder()
str.BufAppend(b, "matrix(")
repeat 6 in k:
if k > 0:
str.BufAppend(b, ", ")
end
n := fmt_sig(vals[k])
str.BufAppend(b, n)
sfree(n)
end
str.BufAppend(b, ")")
out := str.BufStr(b)
str.BufFree(b)
ret out
end
func bi_four(a: Len, b: Len, c: Len, d: Len): str:
sa := lenx(a)
sb := lenx(b)
sc := lenx(c)
sd := lenx(d)
mut out := ""
if sb == sd:
if sa == sc:
out = sa == sb ? str.Clone(sa) : sa + " " + sb
else:
out = sa + " " + sb + " " + sc
end
else:
out = sa + " " + sb + " " + sc + " " + sd
end
sfree(sa)
sfree(sb)
sfree(sc)
sfree(sd)
ret out
end
func bi_repeat_text(r: Repeat): str:
ret r == Repeat.Stretch ? "stretch" : repeat_text(r)
end
func value_text(cs: ComputedStyle, name: str): str:
switch name:
"display": ret str.Clone(display_text(cs.display)) end
"position":
switch cs.position:
cssbox.Position.Static: ret str.Clone("static") end
cssbox.Position.Relative: ret str.Clone("relative") end
cssbox.Position.Absolute: ret str.Clone("absolute") end
cssbox.Position.Fixed: ret str.Clone("fixed") end
else: ret str.Clone("sticky") end
end
end
"top": ret lenx(cs.top) end
"border-image-source": ret image_text(cs.border_image.source) end
"border-image-slice":
bs := bi_four(cs.border_image.slice_top, cs.border_image.slice_right, cs.border_image.slice_bottom, cs.border_image.slice_left)
if cs.border_image.fill:
out := bs + " fill"
sfree(bs)
ret out
end
ret bs
end
"border-image-width": ret bi_four(cs.border_image.width_top, cs.border_image.width_right, cs.border_image.width_bottom, cs.border_image.width_left) end
"border-image-outset": ret bi_four(cs.border_image.outset_top, cs.border_image.outset_right, cs.border_image.outset_bottom, cs.border_image.outset_left) end
"border-image-repeat":
a := bi_repeat_text(cs.border_image.repeat_x)
ret cs.border_image.repeat_x == cs.border_image.repeat_y ? str.Clone(a) : a + " " + bi_repeat_text(cs.border_image.repeat_y)
end
"right": ret lenx(cs.right) end
"bottom": ret lenx(cs.bottom) end
"left": ret lenx(cs.left) end
"width": ret lenx(cs.width) end
"height": ret lenx(cs.height) end
"min-width": ret lenx(cs.min_width) end
"min-height": ret lenx(cs.min_height) end
"max-width": ret lenx(cs.max_width) end
"max-height": ret lenx(cs.max_height) end
"margin-top": ret lenx(cs.margin_top) end
"margin-right": ret lenx(cs.margin_right) end
"margin-bottom": ret lenx(cs.margin_bottom) end
"margin-left": ret lenx(cs.margin_left) end
"padding-top": ret lenx(cs.padding_top) end
"padding-right": ret lenx(cs.padding_right) end
"padding-bottom": ret lenx(cs.padding_bottom) end
"padding-left": ret lenx(cs.padding_left) end
"border-top-width": ret px_text(cs.border_top.width) end
"border-right-width": ret px_text(cs.border_right.width) end
"border-bottom-width": ret px_text(cs.border_bottom.width) end
"border-left-width": ret px_text(cs.border_left.width) end
"border-top-style": ret str.Clone(style_text(cs.border_top.style)) end
"border-right-style": ret str.Clone(style_text(cs.border_right.style)) end
"border-bottom-style": ret str.Clone(style_text(cs.border_bottom.style)) end
"border-left-style": ret str.Clone(style_text(cs.border_left.style)) end
"border-top-color": ret color_text(cs.border_top.color) end
"border-right-color": ret color_text(cs.border_right.color) end
"border-bottom-color": ret color_text(cs.border_bottom.color) end
"border-left-color": ret color_text(cs.border_left.color) end
"border-top-left-radius": ret corner_text(cs.radius_top_left) end
"border-top-right-radius": ret corner_text(cs.radius_top_right) end
"border-bottom-right-radius": ret corner_text(cs.radius_bottom_right) end
"border-bottom-left-radius": ret corner_text(cs.radius_bottom_left) end
"color": ret color_text(cs.color) end
"background-color": ret color_text(cs.background_color) end
"background-image": ret layers_text(cs, 0) end
"background-position-x": ret layers_text(cs, 1) end
"background-position-y": ret layers_text(cs, 2) end
"background-size": ret layers_text(cs, 3) end
"background-repeat": ret layers_text(cs, 4) end
"box-shadow": ret shadows_text(cs.box_shadows, false) end
"text-shadow": ret shadows_text(cs.text_shadows, true) end
"outline-width": ret px_text(cs.outline.width) end
"outline-style": ret str.Clone(style_text(cs.outline.style)) end
"outline-color": ret color_text(cs.outline.color) end
"outline-offset": ret px_text(cs.outline_offset) end
"opacity": ret fmt_sig(cs.opacity) end
"transform": ret matrix_text(cs) end
"visibility":
switch cs.visibility:
Visibility.Visible: ret str.Clone("visible") end
Visibility.Hidden: ret str.Clone("hidden") end
else: ret str.Clone("collapse") end
end
end
"cursor": ret str.Clone(cs.cursor) end
"pointer-events": ret str.Clone(cs.pointer_events ? "auto" : "none") end
"font-family": ret families_text(cs.font_family) end
"font-size": ret px_text(cs.font_size) end
"font-weight": ret str.FromInt(cs.font_weight as i64) end
"font-style":
switch cs.font_style:
FontStyle.Normal: ret str.Clone("normal") end
FontStyle.Italic: ret str.Clone("italic") end
else: ret str.Clone("oblique") end
end
end
"line-height":
if cs.line_height_normal:
ret str.Clone("normal")
end
ret px_text(cs.line_height)
end
"letter-spacing":
if cs.letter_spacing == 0.0:
ret str.Clone("normal")
end
ret px_text(cs.letter_spacing)
end
"word-spacing": ret px_text(cs.word_spacing) end
"text-align":
switch cs.text_align:
TextAlign.Start: ret str.Clone("start") end
TextAlign.End: ret str.Clone("end") end
TextAlign.Left: ret str.Clone("left") end
TextAlign.Right: ret str.Clone("right") end
TextAlign.Center: ret str.Clone("center") end
TextAlign.Justify: ret str.Clone("justify") end
else: ret str.Clone("match-parent") end
end
end
"text-indent": ret lenx(cs.text_indent) end
"text-transform":
switch cs.text_transform:
TextTransform.None: ret str.Clone("none") end
TextTransform.Capitalize: ret str.Clone("capitalize") end
TextTransform.Uppercase: ret str.Clone("uppercase") end
TextTransform.Lowercase: ret str.Clone("lowercase") end
else: ret str.Clone("full-width") end
end
end
"white-space":
switch cs.white_space:
WhiteSpace.Normal: ret str.Clone("normal") end
WhiteSpace.Pre: ret str.Clone("pre") end
WhiteSpace.NoWrap: ret str.Clone("nowrap") end
WhiteSpace.PreWrap: ret str.Clone("pre-wrap") end
WhiteSpace.PreLine: ret str.Clone("pre-line") end
else: ret str.Clone("break-spaces") end
end
end
"text-decoration-line":
if not cs.underline and not cs.overline and not cs.line_through:
ret str.Clone("none")
end
mut b := str.NewBuilder()
if cs.underline:
str.BufAppend(b, "underline")
end
if cs.overline:
if str.BufLen(b) > 0:
str.BufAppend(b, " ")
end
str.BufAppend(b, "overline")
end
if cs.line_through:
if str.BufLen(b) > 0:
str.BufAppend(b, " ")
end
str.BufAppend(b, "line-through")
end
out := str.BufStr(b)
str.BufFree(b)
ret out
end
"text-decoration-color": ret color_text(cs.decoration_color) end
"list-style-type": ret str.Clone(cs.list_style_type) end
"list-style-position": ret str.Clone(cs.list_style_position == ListPosition.Inside ? "inside" : "outside") end
"border-collapse": ret str.Clone(cs.border_collapse == BorderCollapse.Collapse ? "collapse" : "separate") end
"border-spacing":
h := px_text(cs.border_spacing_x)
if cs.border_spacing_x == cs.border_spacing_y:
ret h
end
v := px_text(cs.border_spacing_y)
out := h + " " + v
sfree(h)
sfree(v)
ret out
end
"table-layout": ret str.Clone(cs.table_layout == TableLayout.Fixed ? "fixed" : "auto") end
"caption-side": ret str.Clone(cs.caption_side == cssbox.CaptionSide.Bottom ? "bottom" : "top") end
"grid-template-columns": ret str.Clone(cs.grid_template_columns.len() > 0 ? cs.grid_template_columns : "none") end
"grid-template-rows": ret str.Clone(cs.grid_template_rows.len() > 0 ? cs.grid_template_rows : "none") end
"grid-template-areas": ret str.Clone(cs.grid_template_areas.len() > 0 ? cs.grid_template_areas : "none") end
"grid-auto-columns": ret str.Clone(cs.grid_auto_columns.len() > 0 ? cs.grid_auto_columns : "auto") end
"grid-auto-rows": ret str.Clone(cs.grid_auto_rows.len() > 0 ? cs.grid_auto_rows : "auto") end
"grid-auto-flow":
switch cs.grid_auto_flow:
cssbox.GridAutoFlow.Column: ret str.Clone("column") end
cssbox.GridAutoFlow.RowDense: ret str.Clone("row dense") end
cssbox.GridAutoFlow.ColumnDense: ret str.Clone("column dense") end
else: ret str.Clone("row") end
end
end
"grid-row-start": ret str.Clone(cs.grid_row_start.len() > 0 ? cs.grid_row_start : "auto") end
"grid-row-end": ret str.Clone(cs.grid_row_end.len() > 0 ? cs.grid_row_end : "auto") end
"grid-column-start": ret str.Clone(cs.grid_column_start.len() > 0 ? cs.grid_column_start : "auto") end
"grid-column-end": ret str.Clone(cs.grid_column_end.len() > 0 ? cs.grid_column_end : "auto") end
"transition-property": ret transitions_text(cs, 0) end
"transition-duration": ret transitions_text(cs, 1) end
"transition-timing-function": ret transitions_text(cs, 2) end
"transition-delay": ret transitions_text(cs, 3) end
"z-index":
if cs.z_auto:
ret str.Clone("auto")
end
ret str.FromInt(cs.z_index as i64)
end
"order": ret str.FromInt(cs.order as i64) end
"flex-grow": ret fmt_sig(cs.flex_grow) end
"flex-shrink": ret fmt_sig(cs.flex_shrink) end
"flex-basis": ret lenx(cs.flex_basis) end
"flex-direction":
switch cs.flex_direction:
cssbox.FlexDirection.Row: ret str.Clone("row") end
cssbox.FlexDirection.RowReverse: ret str.Clone("row-reverse") end
cssbox.FlexDirection.Column: ret str.Clone("column") end
else: ret str.Clone("column-reverse") end
end
end
"flex-wrap":
switch cs.flex_wrap:
cssbox.FlexWrap.NoWrap: ret str.Clone("nowrap") end
cssbox.FlexWrap.Wrap: ret str.Clone("wrap") end
else: ret str.Clone("wrap-reverse") end
end
end
"align-items": ret str.Clone(align_text(cs.align_items)) end
"align-self": ret str.Clone(align_text(cs.align_self)) end
"align-content": ret str.Clone(align_text(cs.align_content)) end
"justify-content": ret str.Clone(align_text(cs.justify_content)) end
"justify-items": ret str.Clone(align_text(cs.justify_items)) end
"justify-self": ret str.Clone(align_text(cs.justify_self)) end
"row-gap": ret lenx(cs.row_gap) end
"column-gap": ret lenx(cs.column_gap) end
"overflow-x": ret str.Clone(overflow_text(cs.overflow_x)) end
"overflow-y": ret str.Clone(overflow_text(cs.overflow_y)) end
"direction": ret str.Clone(cs.direction == cssbox.Direction.Rtl ? "rtl" : "ltr") end
"box-sizing": ret str.Clone(cs.box_sizing == cssbox.BoxSizing.BorderBox ? "border-box" : "content-box") end
"vertical-align":
switch cs.vertical_align:
VerticalAlign.Baseline: ret str.Clone("baseline") end
VerticalAlign.Sub: ret str.Clone("sub") end
VerticalAlign.Super: ret str.Clone("super") end
VerticalAlign.Top: ret str.Clone("top") end
VerticalAlign.TextTop: ret str.Clone("text-top") end
VerticalAlign.Middle: ret str.Clone("middle") end
VerticalAlign.Bottom: ret str.Clone("bottom") end
VerticalAlign.TextBottom: ret str.Clone("text-bottom") end
else: ret lenx(cs.vertical_align_len) end
end
end
"appearance": ret str.Clone(cs.appearance) end
"aspect-ratio":
if cs.aspect_ratio == 0.0:
ret str.Clone("auto")
end
ret fmt_sig(cs.aspect_ratio)
end
else: ret str.Clone("") end
end
ret str.Clone("")
end
package css
import str
const W_NONE := 0
const W_INHERIT := 1
const W_INITIAL := 2
const W_UNSET := 3
struct Decl:
pub prop: int = -1
pub name: str = ""
pub value: str = ""
pub important: bool = false
pub ts: int = 0
pub te: int = 0
pub has_var: bool = false
pub wide: int = W_NONE
pub sch: bool = false
end
struct Block:
pub d0: int = 0
pub n: int = 0
pub sch: bool = false
end
struct Rule:
pub sel: int = 0
pub block: int = 0
pub order: int = 0
pub ua: bool = false
pub media: int = -1
pub next: int = -1
end
struct MediaEntry:
pub text: str = ""
pub parent: int = -1
pub ts: int = 0
pub te: int = 0
end
struct ProgMap:
pub pid: int = -1
pub simples: Vector<int> = Vector {}
pub compounds: Vector<int> = Vector {}
pub selectors: Vector<int> = Vector {}
pub media: Vector<int> = Vector {}
pub blocks: Vector<int> = Vector {}
pub rules: int = 0
end
struct SheetData:
pub simples: Vector<Simple> = Vector {}
pub compounds: Vector<Compound> = Vector {}
pub selectors: Vector<Selector> = Vector {}
pub rules: Vector<Rule> = Vector {}
pub buckets: HashMap<str, int> = HashMap {}
pub bheads: Vector<int> = Vector {}
pub btails: Vector<int> = Vector {}
pub media_list: Vector<MediaEntry> = Vector {}
pub decls: Vector<Decl> = Vector {}
pub blocks: Vector<Block> = Vector {}
pub block_cache: HashMap<str, int> = HashMap {}
pub toks: Vector<Tok> = Vector {}
pub adding_ua: bool = false
pub state_left: bool = false
pub sibling: bool = false
pub version: int = 0
pub collect: bool = false
pub errs: Vector<str> = Vector {}
pub media_cache: HashMap<str, int> = HashMap {}
pub dyn_cache: HashMap<str, int> = HashMap {}
pub maps: Vector<ProgMap> = Vector {}
pub main_map: int = -1
end
func sheet_new(): SheetData:
mut sd := SheetData {}
sd.simples = Vector {} as Vector<Simple>
sd.compounds = Vector {} as Vector<Compound>
sd.selectors = Vector {} as Vector<Selector>
sd.rules = Vector {} as Vector<Rule>
sd.buckets = HashMap {} as HashMap<str, int>
sd.bheads = Vector {} as Vector<int>
sd.btails = Vector {} as Vector<int>
sd.media_list = Vector {} as Vector<MediaEntry>
sd.decls = Vector {} as Vector<Decl>
sd.blocks = Vector {} as Vector<Block>
sd.block_cache = HashMap {} as HashMap<str, int>
sd.toks = Vector {} as Vector<Tok>
sd.errs = Vector {} as Vector<str>
sd.media_cache = HashMap {} as HashMap<str, int>
sd.dyn_cache = HashMap {} as HashMap<str, int>
sd.maps = Vector {} as Vector<ProgMap>
ret sd
end
func sheet_free(sd &: SheetData):
sd.simples.free()
sd.compounds.free()
sd.selectors.free()
sd.rules.free()
free_keys(sd.buckets)
sd.bheads.free()
sd.btails.free()
repeat sd.media_list.len() in i:
sfree(sd.media_list[i].text)
end
sd.media_list.free()
repeat sd.decls.len() in i:
d := sd.decls[i]
sfree(d.name)
sfree(d.value)
end
sd.decls.free()
sd.blocks.free()
free_keys(sd.block_cache)
free_toks(sd.toks, 0)
sd.toks.free()
repeat sd.errs.len() in i:
sfree(sd.errs[i])
end
sd.errs.free()
free_keys(sd.media_cache)
free_keys(sd.dyn_cache)
repeat sd.maps.len() in i:
mut m := sd.maps.ref(i)
m.simples.free()
m.compounds.free()
m.selectors.free()
m.media.free()
m.blocks.free()
end
sd.maps.free()
end
func wide_kw(t: Vector<Tok>, s: int, e: int): int:
k := kw_at(t, s, e)
switch k:
"inherit": ret W_INHERIT end
"initial": ret W_INITIAL end
"unset", "revert", "revert-layer": ret W_UNSET end
else: ret W_NONE end
end
ret W_NONE
end
func has_var_fn(t: Vector<Tok>, s: int, e: int): bool:
mut i := s
until i < e:
if t[i].k == TK_FUNC and (t[i].s == "var" or t[i].s == "env"):
ret true
end
i++
end
ret false
end
func validate(sd &: SheetData, p: int, ts: int, te: int): bool:
mut q := p
if q >= L_FIRST and q <= L_LAST:
q = logical_to_physical(q, false)
end
mut cs := initial_style()
ok := apply_prop(cs, q, sd.toks, ts, te, Cx {})
free_style(cs)
ret ok
end
func push_decl(sd &: SheetData, prop: int, name: str, value: str, important: bool, out_n &: int): bool:
ts := sd.toks.len()
tokenize(value, sd.toks)
te := sd.toks.len()
mut d := Decl { prop = prop, name = str.Clone(name), value = str.Clone(value), important = important, ts = ts, te = te }
d.wide = wide_kw(sd.toks, ts, te)
d.has_var = d.wide == W_NONE and has_var_fn(sd.toks, ts, te)
if prop == P_CUSTOM:
sd.decls.push(d)
out_n++
ret true
end
if d.wide == W_NONE and not d.has_var and ts == te:
if sd.collect:
sd.errs.push("empty value for '" + name + "'")
end
sfree(d.name)
sfree(d.value)
free_toks(sd.toks, ts)
ret false
end
if d.wide == W_NONE and not d.has_var and not validate(sd, prop, ts, te):
if sd.collect:
sd.errs.push("invalid value for '" + name + "': " + value)
end
sfree(d.name)
sfree(d.value)
free_toks(sd.toks, ts)
ret false
end
if d.wide == W_NONE and not d.has_var:
resolve_decl(sd, prop, ts)
d.te = sd.toks.len()
if sd.collect and not validate(sd, prop, d.ts, d.te):
sd.errs.push("internal: resolved value for '" + name + "' does not apply: " + value)
end
end
d.sch = decl_sch(sd.toks, d.ts, d.te, prop, d.has_var)
sd.decls.push(d)
out_n++
ret true
end
func add_declaration(sd &: SheetData, name: str, value: str, important: bool, out_n &: int):
p := prop_id(name)
if p < 0:
if sd.collect:
sd.errs.push("unknown property '" + name + "'")
end
ret
end
if p < S_FIRST or p > S_LAST or p == P_CUSTOM:
_ok := push_decl(sd, p, name, value, important, out_n)
ret
end
mut toks := Vector {} as Vector<Tok>
tokenize(value, toks)
n := toks.len()
w := wide_kw(toks, 0, n)
hv := has_var_fn(toks, 0, n)
if hv:
free_toks(toks, 0)
toks.free()
_ok := push_decl(sd, p, name, value, important, out_n)
ret
end
mut ids := Vector {} as Vector<int>
mut vals := Vector {} as Vector<str>
if w != W_NONE:
longhands_of(p, ids)
repeat ids.len():
vals.push(str.Clone(value))
end
else not expand(p, value, toks, 0, n, ids, vals):
if sd.collect:
sd.errs.push("invalid value for '" + name + "': " + value)
end
repeat vals.len() in i:
sfree(vals[i])
end
ids.free()
vals.free()
free_toks(toks, 0)
toks.free()
ret
end
free_toks(toks, 0)
toks.free()
mark := sd.decls.len()
mark_t := sd.toks.len()
mut ok := true
mut cnt := 0
repeat ids.len() in i:
if ok and not push_decl(sd, ids[i], name, vals[i], important, cnt):
ok = false
end
sfree(vals[i])
end
ids.free()
vals.free()
if not ok:
until sd.decls.len() > mark:
d := sd.decls.pop()
sfree(d.name)
sfree(d.value)
end
free_toks(sd.toks, mark_t)
ret
end
out_n += cnt
end
func trim_range(p: u8*, s: int, e: int, os &: int, oe &: int):
mut a := s
mut b := e
until a < b and is_space(p[a] as int):
a++
end
until b > a and is_space(p[b - 1] as int):
b--
end
os = a
oe = b
end
func parse_block(sd &: SheetData, text: str): int:
if sd.block_cache.has(text):
ret sd.block_cache.get(text)
end
d0 := sd.decls.len()
mut n := 0
p := (text as void*) as u8*
len := text.len()
mut i := 0
until i < len:
mut j := i
mut depth := 0
mut q := 0
until j < len:
c := p[j] as int
if q != 0:
if c == 92:
j++
else c == q:
q = 0
end
else c == 34 or c == 39:
q = c
else c == 40 or c == 91 or c == 123:
depth++
else (c == 41 or c == 93 or c == 125) and depth > 0:
depth--
else c == 59 and depth == 0:
break
end
j++
end
mut a := 0
mut b := 0
trim_range(p, i, j, a, b)
mut colon := -1
mut k := a
until k < b:
if (p[k] as int) == 58:
colon = k
break
end
k++
end
if colon > a:
mut na := 0
mut nb := 0
trim_range(p, a, colon, na, nb)
mut va := 0
mut vb := 0
trim_range(p, colon + 1, b, va, vb)
mut important := false
mut bang := vb - 1
until bang >= va and (p[bang] as int) != 33:
bang--
end
if bang >= va:
tail := text.substr(bang + 1, vb - bang - 1)
tl := lower_ascii(tail)
tt := str.Trim(tl)
if tt == "important":
important = true
mut nvb := bang
until nvb > va and is_space(p[nvb - 1] as int):
nvb--
end
vb = nvb
end
sfree(tail)
sfree(tl)
sfree(tt)
end
rawname := text.substr(na, nb - na)
mut name := rawname
if not str.StartsWith(rawname, "--"):
name = lower_ascii(rawname)
sfree(rawname)
end
value := text.substr(va, vb - va)
add_declaration(sd, name, value, important, n)
sfree(name)
sfree(value)
end
i = j + 1
end
sd.blocks.push(Block { d0 = d0, n = n, sch = block_sch(sd, d0, n) })
idx := sd.blocks.len() - 1
sd.block_cache.put(str.Clone(text), idx)
ret idx
end
func add_rule_to_bucket(sd &: SheetData, ri: int):
key := selector_key(sd, sd.rules[ri].sel)
if sd.buckets.has(key):
bi := sd.buckets.get(key)
sfree(key)
t := sd.btails[bi]
mut r := sd.rules.ref(t)
r.next = ri
sd.btails[bi] = ri
else:
sd.bheads.push(ri)
sd.btails.push(ri)
sd.buckets.put(key, sd.bheads.len() - 1)
end
end
func add_rule_text(sd &: SheetData, selector: str, decls: str, media: int): bool:
mut sels := Vector {} as Vector<int>
defer sels.free()
if not parse_selector_list(sd, selector, sels):
if sd.collect:
sd.errs.push("invalid selector '" + selector + "'")
end
ret false
end
blk := parse_block(sd, decls)
repeat sels.len() in i:
sel := sd.selectors[sels[i]]
if sel.state_left:
sd.state_left = true
end
if sel.sibling:
sd.sibling = true
end
sd.rules.push(Rule { sel = sels[i], block = blk, order = sd.rules.len(), ua = sd.adding_ua, media = media })
add_rule_to_bucket(sd, sd.rules.len() - 1)
end
sd.version++
ret true
end
func add_media(sd &: SheetData, cond: str, parent: int): int:
ts := sd.toks.len()
tokenize(cond, sd.toks)
sd.media_list.push(MediaEntry { text = str.Clone(cond), parent = parent, ts = ts, te = sd.toks.len() })
ret sd.media_list.len() - 1
end
func skip_ws_comments(p: u8*, n: int, i0: int): int:
mut i := i0
until i < n:
c := p[i] as int
if is_space(c):
i++
else c == 47 and i + 1 < n and (p[i + 1] as int) == 42:
mut j := i + 2
until j + 1 < n and not ((p[j] as int) == 42 and (p[j + 1] as int) == 47):
j++
end
i = j + 2
else c == 60 and i + 3 < n and (p[i + 1] as int) == 33:
i += 4
else c == 45 and i + 2 < n and (p[i + 1] as int) == 45 and (p[i + 2] as int) == 62:
i += 3
else:
break
end
end
ret i
end
func find_char(p: u8*, n: int, i0: int, want: int, stop: int): int:
mut i := i0
mut q := 0
mut depth := 0
until i < n:
c := p[i] as int
if q != 0:
if c == 92:
i++
else c == q:
q = 0
end
else c == 34 or c == 39:
q = c
else c == 47 and i + 1 < n and (p[i + 1] as int) == 42:
mut j := i + 2
until j + 1 < n and not ((p[j] as int) == 42 and (p[j + 1] as int) == 47):
j++
end
i = j + 1
else c == 40 or c == 91:
depth++
else (c == 41 or c == 93) and depth > 0:
depth--
else depth == 0 and (c == want or c == stop):
ret i
end
i++
end
ret n
end
func block_end(p: u8*, n: int, open: int): int:
mut i := open + 1
mut depth := 1
mut q := 0
until i < n:
c := p[i] as int
if q != 0:
if c == 92:
i++
else c == q:
q = 0
end
else c == 34 or c == 39:
q = c
else c == 47 and i + 1 < n and (p[i + 1] as int) == 42:
mut j := i + 2
until j + 1 < n and not ((p[j] as int) == 42 and (p[j + 1] as int) == 47):
j++
end
i = j + 1
else c == 123:
depth++
else c == 125:
depth--
if depth == 0:
ret i
end
end
i++
end
ret n
end
func parse_css(sd &: SheetData, text: str, s: int, e: int, media: int): int:
p := (text as void*) as u8*
mut count := 0
mut i := s
until i < e:
i = skip_ws_comments(p, e, i)
if i >= e:
break
end
c := p[i] as int
if c == 125 or c == 59:
i++
continue
end
if c == 64:
ne := name_end(p, e, i + 1)
at := text.substr(i + 1, ne - i - 1)
atl := lower_ascii(at)
sfree(at)
brace := find_char(p, e, ne, 123, 59)
if brace >= e or (p[brace] as int) == 59:
sfree(atl)
i = brace + 1
continue
end
close := block_end(p, e, brace)
mut ps := 0
mut pe := 0
trim_range(p, ne, brace, ps, pe)
if atl == "media":
prelude := text.substr(ps, pe - ps)
mi := add_media(sd, prelude, media)
sfree(prelude)
count += parse_css(sd, text, brace + 1, close, mi)
else atl == "supports" or atl == "layer" or atl == "document" or atl == "scope" or atl == "starting-style":
if atl != "starting-style":
count += parse_css(sd, text, brace + 1, close, media)
end
end
sfree(atl)
i = close + 1
continue
end
brace := find_char(p, e, i, 123, 125)
if brace >= e or (p[brace] as int) == 125:
i = brace + 1
continue
end
close := block_end(p, e, brace)
mut ss := 0
mut se := 0
trim_range(p, i, brace, ss, se)
sel := text.substr(ss, se - ss)
body := text.substr(brace + 1, close - brace - 1)
if add_rule_text(sd, sel, body, media):
count++
end
sfree(sel)
sfree(body)
i = close + 1
end
ret count
end
package css
import str
func longhands_of(id: int, out &: Vector<int>):
switch id:
S_MARGIN, S_PADDING, S_INSET, S_BORDER_WIDTH, S_BORDER_STYLE, S_BORDER_COLOR, S_BORDER_RADIUS:
mut base := P_MARGIN_TOP
switch id:
S_PADDING: base = P_PADDING_TOP break end
S_INSET: base = P_TOP break end
S_BORDER_WIDTH: base = P_BORDER_TOP_WIDTH break end
S_BORDER_STYLE: base = P_BORDER_TOP_STYLE break end
S_BORDER_COLOR: base = P_BORDER_TOP_COLOR break end
S_BORDER_RADIUS: base = P_RADIUS_TL break end
else: end
end
repeat 4 in i:
out.push(base + i)
end
break
end
S_BORDER:
repeat 12 in i:
out.push(P_BORDER_TOP_WIDTH + i)
end
repeat 5 in i:
out.push(P_BI_SOURCE + i)
end
break
end
S_BORDER_IMAGE:
repeat 5 in i:
out.push(P_BI_SOURCE + i)
end
break
end
S_BORDER_TOP, S_BORDER_RIGHT, S_BORDER_BOTTOM, S_BORDER_LEFT:
side := id - S_BORDER_TOP
out.push(P_BORDER_TOP_WIDTH + side)
out.push(P_BORDER_TOP_STYLE + side)
out.push(P_BORDER_TOP_COLOR + side)
break
end
S_OUTLINE:
out.push(P_OUTLINE_WIDTH)
out.push(P_OUTLINE_STYLE)
out.push(P_OUTLINE_COLOR)
break
end
S_OVERFLOW:
out.push(P_OVERFLOW_X)
out.push(P_OVERFLOW_Y)
break
end
S_FLEX:
out.push(P_FLEX_GROW)
out.push(P_FLEX_SHRINK)
out.push(P_FLEX_BASIS)
break
end
S_FLEX_FLOW:
out.push(P_FLEX_DIRECTION)
out.push(P_FLEX_WRAP)
break
end
S_GAP:
out.push(P_ROW_GAP)
out.push(P_COLUMN_GAP)
break
end
S_PLACE_ITEMS:
out.push(P_ALIGN_ITEMS)
out.push(P_JUSTIFY_ITEMS)
break
end
S_PLACE_CONTENT:
out.push(P_ALIGN_CONTENT)
out.push(P_JUSTIFY_CONTENT)
break
end
S_PLACE_SELF:
out.push(P_ALIGN_SELF)
out.push(P_JUSTIFY_SELF)
break
end
S_GRID_ROW:
out.push(P_GRID_ROW_START)
out.push(P_GRID_ROW_END)
break
end
S_GRID_COLUMN:
out.push(P_GRID_COLUMN_START)
out.push(P_GRID_COLUMN_END)
break
end
S_GRID_AREA:
out.push(P_GRID_ROW_START)
out.push(P_GRID_COLUMN_START)
out.push(P_GRID_ROW_END)
out.push(P_GRID_COLUMN_END)
break
end
S_GRID_TEMPLATE:
out.push(P_GRID_TEMPLATE_ROWS)
out.push(P_GRID_TEMPLATE_COLUMNS)
out.push(P_GRID_TEMPLATE_AREAS)
break
end
S_GRID:
out.push(P_GRID_TEMPLATE_ROWS)
out.push(P_GRID_TEMPLATE_COLUMNS)
out.push(P_GRID_TEMPLATE_AREAS)
out.push(P_GRID_AUTO_ROWS)
out.push(P_GRID_AUTO_COLUMNS)
out.push(P_GRID_AUTO_FLOW)
break
end
S_BACKGROUND:
out.push(P_BG_IMAGE)
out.push(P_BG_POS_X)
out.push(P_BG_POS_Y)
out.push(P_BG_SIZE)
out.push(P_BG_REPEAT)
out.push(P_BG_ATTACH)
out.push(P_BG_ORIGIN)
out.push(P_BG_CLIP)
out.push(P_BG_COLOR)
break
end
S_BG_POSITION:
out.push(P_BG_POS_X)
out.push(P_BG_POS_Y)
break
end
S_FONT:
out.push(P_FONT_STYLE)
out.push(P_FONT_VARIANT_CAPS)
out.push(P_FONT_WEIGHT)
out.push(P_FONT_STRETCH)
out.push(P_FONT_SIZE)
out.push(P_LINE_HEIGHT)
out.push(P_FONT_FAMILY)
break
end
S_FONT_VARIANT:
out.push(P_FONT_VARIANT_CAPS)
break
end
S_LIST_STYLE:
out.push(P_LIST_TYPE)
out.push(P_LIST_POSITION)
out.push(P_LIST_IMAGE)
break
end
S_TEXT_DECORATION:
out.push(P_TD_LINE)
out.push(P_TD_STYLE)
out.push(P_TD_COLOR)
out.push(P_TD_THICKNESS)
break
end
S_TRANSITION:
out.push(P_TR_PROPERTY)
out.push(P_TR_DURATION)
out.push(P_TR_TIMING)
out.push(P_TR_DELAY)
break
end
S_MARGIN_BLOCK, S_PADDING_BLOCK, S_INSET_BLOCK, S_BORDER_BLOCK_WIDTH, S_BORDER_BLOCK_STYLE, S_BORDER_BLOCK_COLOR:
b := block_base(id)
out.push(b)
out.push(b + 1)
break
end
S_MARGIN_INLINE, S_PADDING_INLINE, S_INSET_INLINE, S_BORDER_INLINE_WIDTH, S_BORDER_INLINE_STYLE, S_BORDER_INLINE_COLOR:
b := block_base(id)
out.push(b + 2)
out.push(b + 3)
break
end
S_BORDER_BLOCK, S_BORDER_INLINE:
off := id == S_BORDER_BLOCK ? 0 : 2
repeat 2 in k:
out.push(L_BW + off + k)
out.push(L_BS + off + k)
out.push(L_BC + off + k)
end
break
end
S_BORDER_BLOCK_START, S_BORDER_BLOCK_END, S_BORDER_INLINE_START, S_BORDER_INLINE_END:
side := id - S_BORDER_BLOCK_START
out.push(L_BW + side)
out.push(L_BS + side)
out.push(L_BC + side)
break
end
else:
out.push(id)
end
end
end
func block_base(id: int): int:
switch id:
S_MARGIN_BLOCK, S_MARGIN_INLINE: ret L_MARGIN end
S_PADDING_BLOCK, S_PADDING_INLINE: ret L_PADDING end
S_INSET_BLOCK, S_INSET_INLINE: ret L_INSET end
S_BORDER_BLOCK_WIDTH, S_BORDER_INLINE_WIDTH: ret L_BW end
S_BORDER_BLOCK_STYLE, S_BORDER_INLINE_STYLE: ret L_BS end
else: ret L_BC end
end
ret L_MARGIN
end
func tok_text(src: str, t: Vector<Tok>, s: int, e: int): str:
if s >= e:
ret str.Clone("")
end
mut last := s
mut i := s
until i < e:
last = i
i = nxt(t, i)
end
p0 := t[s].p0
mut p1 := t[last].p1
if t[last].k == TK_FUNC and t[last].close >= 0:
p1 = t[t[last].close].p1
end
ret src.substr(p0, p1 - p0)
end
func push_val(ids &: Vector<int>, vals &: Vector<str>, id: int, v: str):
ids.push(id)
vals.push(v)
end
func push_lit(ids &: Vector<int>, vals &: Vector<str>, id: int, v: str):
ids.push(id)
vals.push(str.Clone(v))
end
func items_of(t: Vector<Tok>, s: int, e: int, out &: Vector<int>):
mut i := s
until i < e:
out.push(i)
i = nxt(t, i)
end
out.push(e)
end
func four_sides(src: str, t: Vector<Tok>, s: int, e: int, base: int, ids &: Vector<int>, vals &: Vector<str>): bool:
mut it := Vector {} as Vector<int>
defer it.free()
items_of(t, s, e, it)
n := it.len() - 1
if n < 1 or n > 4:
ret false
end
pick := [[0, 0, 0, 0], [0, 1, 0, 1], [0, 1, 2, 1], [0, 1, 2, 3]]
repeat 4 in k:
j := pick[n - 1][k]
push_val(ids, vals, base + k, tok_text(src, t, it[j], it[j + 1]))
end
ret true
end
func two_sides(src: str, t: Vector<Tok>, s: int, e: int, a: int, b: int, ids &: Vector<int>, vals &: Vector<str>): bool:
mut it := Vector {} as Vector<int>
defer it.free()
items_of(t, s, e, it)
n := it.len() - 1
if n < 1 or n > 2:
ret false
end
push_val(ids, vals, a, tok_text(src, t, it[0], it[1]))
j := n == 2 ? 1 : 0
push_val(ids, vals, b, tok_text(src, t, it[j], it[j + 1]))
ret true
end
func border_parts(src: str, t: Vector<Tok>, s: int, e: int, w &: str, st &: str, c &: str): bool:
cx := Cx {}
mut i := s
mut hw := false
mut hs := false
mut hc := false
until i < e:
j := nxt(t, i)
mut wv := 0.0
mut bs := BorderStyle.None
if not hs and t[i].k == TK_IDENT and border_style_of(t[i].id, false, bs):
st = tok_text(src, t, i, j)
hs = true
else not hw and border_width_of(t, i, j, cx, wv):
w = tok_text(src, t, i, j)
hw = true
else not hc and is_color_start(t, i):
c = tok_text(src, t, i, j)
hc = true
else:
ret false
end
i = j
end
if not hw:
w = str.Clone("medium")
end
if not hs:
st = str.Clone("none")
end
if not hc:
c = str.Clone("currentcolor")
end
ret true
end
func outline_parts(src: str, t: Vector<Tok>, s: int, e: int, w &: str, st &: str, c &: str): bool:
cx := Cx {}
mut i := s
mut hw := false
mut hs := false
mut hc := false
until i < e:
j := nxt(t, i)
mut wv := 0.0
mut bs := BorderStyle.None
if not hs and t[i].k == TK_IDENT and border_style_of(t[i].id, true, bs):
st = tok_text(src, t, i, j)
hs = true
else not hw and border_width_of(t, i, j, cx, wv):
w = tok_text(src, t, i, j)
hw = true
else not hc and (is_color_start(t, i) or is_kw_id(t, i, j, KW_INVERT)):
c = tok_text(src, t, i, j)
hc = true
else:
ret false
end
i = j
end
if not hw:
w = str.Clone("medium")
end
if not hs:
st = str.Clone("none")
end
if not hc:
c = str.Clone("currentcolor")
end
ret true
end
func is_pos_item(t: Vector<Tok>, i: int, e: int): bool:
tk := t[i]
if tk.k == TK_IDENT:
ret tk.id == KW_LEFT or tk.id == KW_RIGHT or tk.id == KW_TOP or tk.id == KW_BOTTOM or tk.id == KW_CENTER
end
mut l := Len {}
ret p_len(t, i, e, Cx {}, true, true, l)
end
func position_texts(src: str, t: Vector<Tok>, s: int, e: int, xs &: str, ys &: str): bool:
mut it := Vector {} as Vector<int>
defer it.free()
items_of(t, s, e, it)
n := it.len() - 1
if n == 1:
a := t[it[0]]
if a.k == TK_IDENT and (a.id == KW_TOP or a.id == KW_BOTTOM):
xs = str.Clone("center")
ys = tok_text(src, t, it[0], it[1])
else:
xs = tok_text(src, t, it[0], it[1])
ys = str.Clone("center")
end
ret true
end
if n == 2:
a := t[it[0]]
b := t[it[1]]
if (a.k == TK_IDENT and (a.id == KW_TOP or a.id == KW_BOTTOM)) or (b.k == TK_IDENT and (b.id == KW_LEFT or b.id == KW_RIGHT)):
xs = tok_text(src, t, it[1], it[2])
ys = tok_text(src, t, it[0], it[1])
else:
xs = tok_text(src, t, it[0], it[1])
ys = tok_text(src, t, it[1], it[2])
end
ret true
end
if n == 3 or n == 4:
mut have_x := false
mut have_y := false
mut k := 0
until k < n:
a := t[it[k]]
if a.k != TK_IDENT:
ret false
end
mut ge := k + 1
if k + 1 < n and t[it[k + 1]].k != TK_IDENT:
ge = k + 2
end
txt := tok_text(src, t, it[k], it[ge])
horizontal := a.id == KW_LEFT or a.id == KW_RIGHT or (a.id == KW_CENTER and not have_x)
if horizontal and not have_x:
xs = txt
have_x = true
else not have_y:
ys = txt
have_y = true
else:
sfree(txt)
ret false
end
k = ge
end
if not have_x:
xs = str.Clone("center")
end
if not have_y:
ys = str.Clone("center")
end
ret true
end
ret false
end
func is_image_item(t: Vector<Tok>, i: int): bool:
tk := t[i]
if tk.k == TK_URL:
ret true
end
if tk.k == TK_FUNC:
ret tk.id == KW_URL or str.EndsWith(tk.s, "gradient") or tk.id == KW_IMAGE_SET or tk.s == "-webkit-image-set"
end
ret tk.k == TK_IDENT and tk.id == KW_NONE
end
func is_repeat_kw(t: Vector<Tok>, i: int): bool:
tk := t[i]
ret tk.k == TK_IDENT and (tk.id == KW_REPEAT or tk.id == KW_REPEAT_X or tk.id == KW_REPEAT_Y or tk.id == KW_NO_REPEAT or tk.id == KW_SPACE or tk.id == KW_ROUND)
end
func join_into(b &: str.StringBuilder, first: bool, v: str):
if not first:
str.BufAppend(b, ", ")
end
str.BufAppend(b, v)
end
func expand_background(src: str, t: Vector<Tok>, s: int, e: int, ids &: Vector<int>, vals &: Vector<str>): bool:
mut parts := Vector {} as Vector<int>
defer parts.free()
split_commas(t, s, e, parts)
mut bi := str.NewBuilder()
mut bx := str.NewBuilder()
mut bpy := str.NewBuilder()
mut bz := str.NewBuilder()
mut br := str.NewBuilder()
mut ba := str.NewBuilder()
mut bo := str.NewBuilder()
mut bc := str.NewBuilder()
mut color := str.Clone("transparent")
mut ok := true
nl := parts.len() / 2
mut k := 0
until k + 1 < parts.len() and ok:
ls := parts[k]
le := parts[k + 1]
last := k + 2 >= parts.len()
first := k == 0
mut img := "none"
mut img_own := false
mut px := "0%"
mut py := "0%"
mut pos_own := false
mut size := "auto"
mut size_own := false
mut rep := "repeat"
mut rep_own := false
mut att := "scroll"
mut origin := "padding-box"
mut clip := "border-box"
mut boxes := 0
mut have_img := false
mut have_pos := false
mut have_color := false
mut i := ls
if ls >= le:
ok = false
end
until i < le and ok:
j := nxt(t, i)
tk := t[i]
if not have_img and is_image_item(t, i):
img = tok_text(src, t, i, j)
img_own = true
have_img = true
i = j
continue
end
if is_repeat_kw(t, i):
if rep_own:
ok = false
break
end
mut je := j
if je < le and (t[je].k == TK_IDENT and (t[je].id == KW_REPEAT or t[je].id == KW_NO_REPEAT or t[je].id == KW_SPACE or t[je].id == KW_ROUND)) and tk.id != KW_REPEAT_X and tk.id != KW_REPEAT_Y:
je = nxt(t, je)
end
rep = tok_text(src, t, i, je)
rep_own = true
i = je
continue
end
if tk.k == TK_IDENT and (tk.id == KW_SCROLL or tk.id == KW_FIXED or tk.id == KW_LOCAL):
att = tk.s
i = j
continue
end
if tk.k == TK_IDENT and (tk.id == KW_BORDER_BOX or tk.id == KW_PADDING_BOX or tk.id == KW_CONTENT_BOX or tk.id == KW_TEXT):
if boxes == 0:
origin = tk.id == KW_TEXT ? "padding-box" : tk.s
clip = tk.s
else boxes == 1:
clip = tk.s
else:
ok = false
break
end
boxes++
i = j
continue
end
if not have_pos and is_pos_item(t, i, le):
mut pe := i
until pe < le and is_pos_item(t, pe, le):
pe = nxt(t, pe)
end
mut xs := ""
mut ys := ""
if not position_texts(src, t, i, pe, xs, ys):
ok = false
break
end
px = xs
py = ys
pos_own = true
have_pos = true
i = pe
if is_delim(t, i, le, 47):
mut se := i + 1
mut cnt := 0
until se < le and cnt < 2 and (is_kw_id(t, se, le, KW_AUTO) or is_kw_id(t, se, le, KW_COVER) or is_kw_id(t, se, le, KW_CONTAIN) or t[se].k != TK_IDENT) and not is_color_start(t, se):
se = nxt(t, se)
cnt++
end
if cnt == 0:
ok = false
break
end
size = tok_text(src, t, i + 1, se)
size_own = true
i = se
end
continue
end
if last and not have_color and is_color_start(t, i):
sfree(color)
color = tok_text(src, t, i, j)
have_color = true
i = j
continue
end
ok = false
end
join_into(bi, first, img)
join_into(bx, first, px)
join_into(bpy, first, py)
join_into(bz, first, size)
join_into(br, first, rep)
join_into(ba, first, att)
join_into(bo, first, origin)
join_into(bc, first, clip)
if img_own:
sfree(img)
end
if pos_own:
sfree(px)
sfree(py)
end
if size_own:
sfree(size)
end
if rep_own:
sfree(rep)
end
k += 2
end
if nl == 0:
ok = false
end
push_val(ids, vals, P_BG_IMAGE, str.BufStr(bi))
push_val(ids, vals, P_BG_POS_X, str.BufStr(bx))
push_val(ids, vals, P_BG_POS_Y, str.BufStr(bpy))
push_val(ids, vals, P_BG_SIZE, str.BufStr(bz))
push_val(ids, vals, P_BG_REPEAT, str.BufStr(br))
push_val(ids, vals, P_BG_ATTACH, str.BufStr(ba))
push_val(ids, vals, P_BG_ORIGIN, str.BufStr(bo))
push_val(ids, vals, P_BG_CLIP, str.BufStr(bc))
push_val(ids, vals, P_BG_COLOR, color)
str.BufFree(bi)
str.BufFree(bx)
str.BufFree(bpy)
str.BufFree(bz)
str.BufFree(br)
str.BufFree(ba)
str.BufFree(bo)
str.BufFree(bc)
ret ok
end
func is_font_size_item(t: Vector<Tok>, i: int, e: int): bool:
tk := t[i]
if tk.k == TK_IDENT:
mut v := 0.0
ret font_size_kw(tk.id, 16.0, v)
end
if tk.k == TK_NUM:
ret false
end
mut l := Len {}
ret p_len(t, i, e, Cx {}, true, false, l)
end
func expand_font(src: str, t: Vector<Tok>, s: int, e: int, ids &: Vector<int>, vals &: Vector<str>): bool:
k := kw_at(t, s, e)
switch k:
"caption", "icon", "menu", "message-box", "small-caption", "status-bar", "-webkit-small-control", "-webkit-mini-control", "-webkit-control":
push_lit(ids, vals, P_FONT_STYLE, "normal")
push_lit(ids, vals, P_FONT_VARIANT_CAPS, "normal")
push_lit(ids, vals, P_FONT_WEIGHT, "normal")
push_lit(ids, vals, P_FONT_STRETCH, "normal")
push_lit(ids, vals, P_FONT_SIZE, "13.333333px")
push_lit(ids, vals, P_LINE_HEIGHT, "normal")
push_lit(ids, vals, P_FONT_FAMILY, "Arial")
ret true
end
else:
end
end
mut style := ""
mut variant := ""
mut weight := ""
mut stretch := ""
mut i := s
mut size_at := -1
cx := Cx {}
until i < e:
j := nxt(t, i)
if is_font_size_item(t, i, e):
size_at = i
break
end
tk := t[i]
mut fw := 0
mut fsr := 0.0
if tk.k == TK_IDENT and tk.id == KW_NORMAL:
i = j
continue
end
if style.len() == 0 and tk.k == TK_IDENT and (tk.id == KW_ITALIC or tk.id == KW_OBLIQUE):
style = tk.s
else variant.len() == 0 and tk.k == TK_IDENT and tk.id == KW_SMALL_CAPS:
variant = tk.s
else weight.len() == 0 and font_weight_of(t, i, j, cx, 400, fw):
weight = tok_text(src, t, i, j)
else stretch.len() == 0 and font_stretch_of(t, i, j, fsr):
stretch = tk.s
else:
sfree(weight)
ret false
end
i = j
end
if size_at < 0:
sfree(weight)
ret false
end
mut j := nxt(t, size_at)
mut lh := "normal"
mut lh_own := false
if is_delim(t, j, e, 47):
if j + 1 >= e:
sfree(weight)
ret false
end
lh = tok_text(src, t, j + 1, nxt(t, j + 1))
lh_own = true
j = nxt(t, j + 1)
end
if j >= e:
sfree(weight)
if lh_own:
sfree(lh)
end
ret false
end
push_lit(ids, vals, P_FONT_STYLE, style.len() > 0 ? style : "normal")
push_lit(ids, vals, P_FONT_VARIANT_CAPS, variant.len() > 0 ? variant : "normal")
if weight.len() > 0:
push_val(ids, vals, P_FONT_WEIGHT, weight)
else:
push_lit(ids, vals, P_FONT_WEIGHT, "normal")
end
push_lit(ids, vals, P_FONT_STRETCH, stretch.len() > 0 ? stretch : "normal")
push_val(ids, vals, P_FONT_SIZE, tok_text(src, t, size_at, nxt(t, size_at)))
if lh_own:
push_val(ids, vals, P_LINE_HEIGHT, lh)
else:
push_lit(ids, vals, P_LINE_HEIGHT, "normal")
end
push_val(ids, vals, P_FONT_FAMILY, tok_text(src, t, j, e))
ret true
end
func is_time_item(t: Vector<Tok>, i: int, e: int): bool:
mut v := 0.0
ret p_time(t, i, e, Cx {}, v)
end
func is_timing_item(t: Vector<Tok>, i: int): bool:
mut tm := Timing {}
ret timing_of(t, i, Cx {}, tm)
end
func expand_transition(src: str, t: Vector<Tok>, s: int, e: int, ids &: Vector<int>, vals &: Vector<str>): bool:
mut parts := Vector {} as Vector<int>
defer parts.free()
split_commas(t, s, e, parts)
mut bp := str.NewBuilder()
mut bd := str.NewBuilder()
mut bt := str.NewBuilder()
mut bl := str.NewBuilder()
mut ok := true
mut k := 0
until k + 1 < parts.len() and ok:
ps := parts[k]
pe := parts[k + 1]
first := k == 0
mut prop := "all"
mut dur := "0s"
mut del := "0s"
mut tim := "ease"
mut dur_own := false
mut del_own := false
mut tim_own := false
mut times := 0
mut have_prop := false
mut have_tim := false
mut i := ps
if ps >= pe:
ok = false
end
until i < pe and ok:
j := nxt(t, i)
if is_time_item(t, i, pe):
if times == 0:
dur = tok_text(src, t, i, j)
dur_own = true
else times == 1:
del = tok_text(src, t, i, j)
del_own = true
else:
ok = false
end
times++
else not have_tim and is_timing_item(t, i):
tim = tok_text(src, t, i, j)
tim_own = true
have_tim = true
else not have_prop and t[i].k == TK_IDENT:
prop = t[i].s
have_prop = true
else:
ok = false
end
i = j
end
join_into(bp, first, prop)
join_into(bd, first, dur)
join_into(bt, first, tim)
join_into(bl, first, del)
if dur_own:
sfree(dur)
end
if del_own:
sfree(del)
end
if tim_own:
sfree(tim)
end
k += 2
end
push_val(ids, vals, P_TR_PROPERTY, str.BufStr(bp))
push_val(ids, vals, P_TR_DURATION, str.BufStr(bd))
push_val(ids, vals, P_TR_TIMING, str.BufStr(bt))
push_val(ids, vals, P_TR_DELAY, str.BufStr(bl))
str.BufFree(bp)
str.BufFree(bd)
str.BufFree(bt)
str.BufFree(bl)
ret ok
end
func expand_flex(src: str, t: Vector<Tok>, s: int, e: int, ids &: Vector<int>, vals &: Vector<str>): bool:
k := kw_at(t, s, e)
if k == "none":
push_lit(ids, vals, P_FLEX_GROW, "0")
push_lit(ids, vals, P_FLEX_SHRINK, "0")
push_lit(ids, vals, P_FLEX_BASIS, "auto")
ret true
end
if k == "auto":
push_lit(ids, vals, P_FLEX_GROW, "1")
push_lit(ids, vals, P_FLEX_SHRINK, "1")
push_lit(ids, vals, P_FLEX_BASIS, "auto")
ret true
end
cx := Cx {}
mut grow := ""
mut shrink := ""
mut basis := ""
mut i := s
mut ok := true
until i < e and ok:
j := nxt(t, i)
mut v := 0.0
if p_num(t, i, j, cx, v) and not (t[i].k == TK_NUM and t[i].n == 0.0 and grow.len() > 0 and shrink.len() > 0):
if grow.len() == 0:
grow = tok_text(src, t, i, j)
else shrink.len() == 0 and basis.len() == 0:
shrink = tok_text(src, t, i, j)
else:
ok = false
end
else basis.len() == 0:
mut l := Len {}
if is_kw_id(t, i, j, KW_CONTENT) or is_kw_id(t, i, j, KW_AUTO) or p_size_len(t, i, j, cx, KW_AUTO, l):
basis = tok_text(src, t, i, j)
else:
ok = false
end
else:
ok = false
end
i = j
end
if not ok:
sfree(grow)
sfree(shrink)
sfree(basis)
ret false
end
if grow.len() > 0:
push_val(ids, vals, P_FLEX_GROW, grow)
else:
push_lit(ids, vals, P_FLEX_GROW, "1")
end
if shrink.len() > 0:
push_val(ids, vals, P_FLEX_SHRINK, shrink)
else:
push_lit(ids, vals, P_FLEX_SHRINK, "1")
end
if basis.len() > 0:
push_val(ids, vals, P_FLEX_BASIS, basis)
else:
push_lit(ids, vals, P_FLEX_BASIS, "0%")
end
ret true
end
func expand_place(src: str, t: Vector<Tok>, s: int, e: int, a: int, b: int, ids &: Vector<int>, vals &: Vector<str>): bool:
mut it := Vector {} as Vector<int>
defer it.free()
items_of(t, s, e, it)
n := it.len() - 1
mut split := -1
mut j := 0
until j < n:
kw := t[it[j]].k == TK_IDENT ? t[it[j]].s : ""
if kw == "safe" or kw == "unsafe" or kw == "first" or kw == "last":
j += 2
else:
j++
end
if split < 0 and j < n:
split = j
end
end
if split < 0:
push_val(ids, vals, a, tok_text(src, t, s, e))
push_val(ids, vals, b, tok_text(src, t, s, e))
ret true
end
push_val(ids, vals, a, tok_text(src, t, s, it[split]))
push_val(ids, vals, b, tok_text(src, t, it[split], e))
ret true
end
func expand_list_style(src: str, t: Vector<Tok>, s: int, e: int, ids &: Vector<int>, vals &: Vector<str>): bool:
mut typ := ""
mut pos := ""
mut img := ""
mut nones := 0
mut i := s
until i < e:
j := nxt(t, i)
tk := t[i]
if tk.k == TK_IDENT and tk.id == KW_NONE:
nones++
else pos.len() == 0 and tk.k == TK_IDENT and (tk.id == KW_INSIDE or tk.id == KW_OUTSIDE):
pos = tok_text(src, t, i, j)
else img.len() == 0 and (tk.k == TK_URL or (tk.k == TK_FUNC and (tk.id == KW_URL or str.EndsWith(tk.s, "gradient")))):
img = tok_text(src, t, i, j)
else typ.len() == 0 and (tk.k == TK_IDENT or tk.k == TK_STR):
typ = tok_text(src, t, i, j)
else:
sfree(typ)
sfree(pos)
sfree(img)
ret false
end
i = j
end
if typ.len() > 0 and img.len() > 0 and nones > 0:
ret false
end
if typ.len() > 0:
push_val(ids, vals, P_LIST_TYPE, typ)
else:
push_lit(ids, vals, P_LIST_TYPE, nones > 0 ? "none" : "disc")
end
if pos.len() > 0:
push_val(ids, vals, P_LIST_POSITION, pos)
else:
push_lit(ids, vals, P_LIST_POSITION, "outside")
end
if img.len() > 0:
push_val(ids, vals, P_LIST_IMAGE, img)
else:
push_lit(ids, vals, P_LIST_IMAGE, "none")
end
ret true
end
func expand_text_decoration(src: str, t: Vector<Tok>, s: int, e: int, ids &: Vector<int>, vals &: Vector<str>): bool:
mut lines := str.NewBuilder()
mut nlines := 0
mut style := ""
mut color := ""
mut thick := ""
mut i := s
mut ok := true
cx := Cx {}
until i < e and ok:
j := nxt(t, i)
tk := t[i]
if tk.k == TK_IDENT and (tk.id == KW_UNDERLINE or tk.id == KW_OVERLINE or tk.id == KW_LINE_THROUGH or tk.id == KW_BLINK or tk.id == KW_NONE):
if nlines > 0:
str.BufAppend(lines, " ")
end
str.BufAppend(lines, tk.s)
nlines++
else style.len() == 0 and tk.k == TK_IDENT and (tk.id == KW_SOLID or tk.id == KW_DOUBLE or tk.id == KW_DOTTED or tk.id == KW_DASHED or tk.id == KW_WAVY):
style = tk.s
else color.len() == 0 and is_color_start(t, i):
color = tok_text(src, t, i, j)
else thick.len() == 0:
mut l := Len {}
if is_kw_id(t, i, j, KW_AUTO) or is_kw_id(t, i, j, KW_FROM_FONT) or p_len(t, i, j, cx, true, false, l):
thick = tok_text(src, t, i, j)
else:
ok = false
end
else:
ok = false
end
i = j
end
lv := str.BufStr(lines)
str.BufFree(lines)
if not ok:
sfree(lv)
sfree(color)
sfree(thick)
ret false
end
if nlines > 0:
push_val(ids, vals, P_TD_LINE, lv)
else:
sfree(lv)
push_lit(ids, vals, P_TD_LINE, "none")
end
push_lit(ids, vals, P_TD_STYLE, style.len() > 0 ? style : "solid")
if color.len() > 0:
push_val(ids, vals, P_TD_COLOR, color)
else:
push_lit(ids, vals, P_TD_COLOR, "currentcolor")
end
if thick.len() > 0:
push_val(ids, vals, P_TD_THICKNESS, thick)
else:
push_lit(ids, vals, P_TD_THICKNESS, "auto")
end
ret true
end
func expand_radius(src: str, t: Vector<Tok>, s: int, e: int, ids &: Vector<int>, vals &: Vector<str>): bool:
mut slash := -1
mut i := s
until i < e:
if is_delim(t, i, e, 47):
slash = i
end
i = nxt(t, i)
end
mut hi := Vector {} as Vector<int>
defer hi.free()
mut vi := Vector {} as Vector<int>
defer vi.free()
he := slash >= 0 ? slash : e
items_of(t, s, he, hi)
if slash >= 0:
items_of(t, slash + 1, e, vi)
else:
items_of(t, s, he, vi)
end
nh := hi.len() - 1
nv := vi.len() - 1
if nh < 1 or nh > 4 or nv < 1 or nv > 4:
ret false
end
pick := [[0, 0, 0, 0], [0, 1, 0, 1], [0, 1, 2, 1], [0, 1, 2, 3]]
repeat 4 in k:
a := pick[nh - 1][k]
b := pick[nv - 1][k]
hs := tok_text(src, t, hi[a], hi[a + 1])
vs := tok_text(src, t, vi[b], vi[b + 1])
push_val(ids, vals, P_RADIUS_TL + k, hs + " " + vs)
sfree(hs)
sfree(vs)
end
ret true
end
func bi_initial(p: int): str:
switch p:
P_BI_SOURCE: ret "none" end
P_BI_SLICE: ret "100%" end
P_BI_WIDTH: ret "1" end
P_BI_OUTSET: ret "0" end
else: ret "stretch" end
end
ret ""
end
func bi_num_item(t: Vector<Tok>, i: int, slice: bool): bool:
tk := t[i]
if tk.k == TK_NUM or tk.k == TK_PCT or (tk.k == TK_FUNC and is_math_fn(tk.s)):
ret true
end
if slice:
ret tk.k == TK_IDENT and tk.id == KW_FILL
end
ret tk.k == TK_DIM or (tk.k == TK_IDENT and tk.id == KW_AUTO)
end
func bi_rep_item(t: Vector<Tok>, i: int): bool:
tk := t[i]
ret tk.k == TK_IDENT and (tk.id == KW_STRETCH or tk.id == KW_REPEAT or tk.id == KW_ROUND or tk.id == KW_SPACE)
end
func expand_border_image(src: str, t: Vector<Tok>, s: int, e: int, ids &: Vector<int>, vals &: Vector<str>): bool:
mut parts := ["", "", "", "", ""]
mut have := [false, false, false, false, false]
mut i := s
mut ok := true
until i < e:
if not have[0] and is_image_item(t, i):
j := nxt(t, i)
parts[0] = tok_text(src, t, i, j)
have[0] = true
i = j
continue
end
if not have[4] and bi_rep_item(t, i):
mut j := nxt(t, i)
if j < e and bi_rep_item(t, j):
j = nxt(t, j)
end
parts[4] = tok_text(src, t, i, j)
have[4] = true
i = j
continue
end
if not have[1] and bi_num_item(t, i, true):
mut j := i
until j < e and bi_num_item(t, j, true):
j = nxt(t, j)
end
parts[1] = tok_text(src, t, i, j)
have[1] = true
if is_delim(t, j, e, 47):
mut k := j + 1
until k < e and bi_num_item(t, k, false):
k = nxt(t, k)
end
if k > j + 1:
parts[2] = tok_text(src, t, j + 1, k)
have[2] = true
end
if is_delim(t, k, e, 47):
mut m := k + 1
until m < e and bi_num_item(t, m, false) and not (t[m].k == TK_IDENT):
m = nxt(t, m)
end
if m == k + 1:
ok = false
break
end
parts[3] = tok_text(src, t, k + 1, m)
have[3] = true
k = m
else not have[2]:
ok = false
break
end
j = k
end
i = j
continue
end
ok = false
break
end
if not ok or i == s:
repeat 5 in k:
if have[k]:
sfree(parts[k])
end
end
ret false
end
repeat 5 in k:
if have[k]:
push_val(ids, vals, P_BI_SOURCE + k, parts[k])
else:
push_lit(ids, vals, P_BI_SOURCE + k, bi_initial(P_BI_SOURCE + k))
end
end
ret true
end
func expand(id: int, src: str, t: Vector<Tok>, s: int, e: int, ids &: Vector<int>, vals &: Vector<str>): bool:
switch id:
S_MARGIN: ret four_sides(src, t, s, e, P_MARGIN_TOP, ids, vals) end
S_PADDING: ret four_sides(src, t, s, e, P_PADDING_TOP, ids, vals) end
S_INSET: ret four_sides(src, t, s, e, P_TOP, ids, vals) end
S_BORDER_WIDTH: ret four_sides(src, t, s, e, P_BORDER_TOP_WIDTH, ids, vals) end
S_BORDER_STYLE: ret four_sides(src, t, s, e, P_BORDER_TOP_STYLE, ids, vals) end
S_BORDER_COLOR: ret four_sides(src, t, s, e, P_BORDER_TOP_COLOR, ids, vals) end
S_BORDER_RADIUS: ret expand_radius(src, t, s, e, ids, vals) end
S_BORDER_IMAGE: ret expand_border_image(src, t, s, e, ids, vals) end
S_BORDER, S_BORDER_TOP, S_BORDER_RIGHT, S_BORDER_BOTTOM, S_BORDER_LEFT, S_BORDER_BLOCK, S_BORDER_INLINE, S_BORDER_BLOCK_START, S_BORDER_BLOCK_END, S_BORDER_INLINE_START, S_BORDER_INLINE_END:
mut w := ""
mut st := ""
mut c := ""
if not border_parts(src, t, s, e, w, st, c):
sfree(w)
sfree(st)
sfree(c)
ret false
end
mut lh := Vector {} as Vector<int>
longhands_of(id, lh)
repeat lh.len() in k:
p := lh[k]
if p >= P_BI_SOURCE and p <= P_BI_REPEAT:
push_lit(ids, vals, p, bi_initial(p))
continue
end
mut what := 0
if (p >= P_BORDER_TOP_STYLE and p < P_BORDER_TOP_STYLE + 4) or (p >= L_BS and p < L_BS + 4):
what = 1
else (p >= P_BORDER_TOP_COLOR and p < P_BORDER_TOP_COLOR + 4) or (p >= L_BC and p < L_BC + 4):
what = 2
end
push_lit(ids, vals, p, what == 0 ? w : (what == 1 ? st : c))
end
lh.free()
sfree(w)
sfree(st)
sfree(c)
ret true
end
S_OUTLINE:
mut w := ""
mut st := ""
mut c := ""
if not outline_parts(src, t, s, e, w, st, c):
sfree(w)
sfree(st)
sfree(c)
ret false
end
push_val(ids, vals, P_OUTLINE_WIDTH, w)
push_val(ids, vals, P_OUTLINE_STYLE, st)
push_val(ids, vals, P_OUTLINE_COLOR, c)
ret true
end
S_OVERFLOW: ret two_sides(src, t, s, e, P_OVERFLOW_X, P_OVERFLOW_Y, ids, vals) end
S_GAP: ret two_sides(src, t, s, e, P_ROW_GAP, P_COLUMN_GAP, ids, vals) end
S_GRID_ROW: ret expand_grid_line(src, t, s, e, P_GRID_ROW_START, P_GRID_ROW_END, ids, vals) end
S_GRID_COLUMN: ret expand_grid_line(src, t, s, e, P_GRID_COLUMN_START, P_GRID_COLUMN_END, ids, vals) end
S_GRID_AREA: ret expand_grid_area(src, t, s, e, ids, vals) end
S_GRID_TEMPLATE: ret expand_grid_template(src, t, s, e, false, ids, vals) end
S_GRID: ret expand_grid_template(src, t, s, e, true, ids, vals) end
S_FLEX: ret expand_flex(src, t, s, e, ids, vals) end
S_FLEX_FLOW:
mut dir := ""
mut wrap := ""
mut i := s
until i < e:
k := t[i].k == TK_IDENT ? t[i].s : ""
if dir.len() == 0 and (k == "row" or k == "row-reverse" or k == "column" or k == "column-reverse"):
dir = k
else wrap.len() == 0 and (k == "nowrap" or k == "wrap" or k == "wrap-reverse"):
wrap = k
else:
ret false
end
i = nxt(t, i)
end
push_lit(ids, vals, P_FLEX_DIRECTION, dir.len() > 0 ? dir : "row")
push_lit(ids, vals, P_FLEX_WRAP, wrap.len() > 0 ? wrap : "nowrap")
ret true
end
S_PLACE_ITEMS: ret expand_place(src, t, s, e, P_ALIGN_ITEMS, P_JUSTIFY_ITEMS, ids, vals) end
S_PLACE_CONTENT: ret expand_place(src, t, s, e, P_ALIGN_CONTENT, P_JUSTIFY_CONTENT, ids, vals) end
S_PLACE_SELF: ret expand_place(src, t, s, e, P_ALIGN_SELF, P_JUSTIFY_SELF, ids, vals) end
S_BACKGROUND: ret expand_background(src, t, s, e, ids, vals) end
S_BG_POSITION:
mut parts := Vector {} as Vector<int>
defer parts.free()
split_commas(t, s, e, parts)
mut bx := str.NewBuilder()
mut bpy := str.NewBuilder()
mut ok := true
mut k := 0
until k + 1 < parts.len():
mut xs := ""
mut ys := ""
if not position_texts(src, t, parts[k], parts[k + 1], xs, ys):
ok = false
break
end
join_into(bx, k == 0, xs)
join_into(bpy, k == 0, ys)
sfree(xs)
sfree(ys)
k += 2
end
push_val(ids, vals, P_BG_POS_X, str.BufStr(bx))
push_val(ids, vals, P_BG_POS_Y, str.BufStr(bpy))
str.BufFree(bx)
str.BufFree(bpy)
ret ok
end
S_FONT: ret expand_font(src, t, s, e, ids, vals) end
S_FONT_VARIANT:
k := kw_at(t, s, e)
if k == "small-caps" or k == "all-small-caps" or k == "petite-caps" or k == "all-petite-caps":
push_lit(ids, vals, P_FONT_VARIANT_CAPS, k)
else:
push_lit(ids, vals, P_FONT_VARIANT_CAPS, "normal")
end
ret true
end
S_LIST_STYLE: ret expand_list_style(src, t, s, e, ids, vals) end
S_TEXT_DECORATION: ret expand_text_decoration(src, t, s, e, ids, vals) end
S_TRANSITION: ret expand_transition(src, t, s, e, ids, vals) end
S_MARGIN_BLOCK, S_PADDING_BLOCK, S_INSET_BLOCK, S_BORDER_BLOCK_WIDTH, S_BORDER_BLOCK_STYLE, S_BORDER_BLOCK_COLOR:
b := block_base(id)
ret two_sides(src, t, s, e, b, b + 1, ids, vals)
end
S_MARGIN_INLINE, S_PADDING_INLINE, S_INSET_INLINE, S_BORDER_INLINE_WIDTH, S_BORDER_INLINE_STYLE, S_BORDER_INLINE_COLOR:
b := block_base(id)
ret two_sides(src, t, s, e, b + 2, b + 3, ids, vals)
end
else:
ret false
end
end
ret false
end
package css
import str
import mem
const TK_IDENT := 1
const TK_NUM := 2
const TK_DIM := 3
const TK_PCT := 4
const TK_HASH := 5
const TK_STR := 6
const TK_FUNC := 7
const TK_CLOSE := 8
const TK_COMMA := 9
const TK_DELIM := 10
const TK_URL := 11
const TK_BAD := 12
const TK_COLOR := 13
struct Tok:
pub k: int = 0
pub s: str = ""
pub raw: str = ""
pub n: f64 = 0.0
pub d: int = 0
pub close: int = -1
pub p0: int = 0
pub p1: int = 0
pub ws: bool = false
pub int_like: bool = false
pub c: i64 = 0
pub c2: i64 = 0
pub stat: bool = false
pub id: int = -1
end
inline func _ub(p: u8*, i: int): int:
ret p[i] as int
end
func sfree(s: str):
if s.len() > 0:
mem.Free(s as void*)
end
end
func is_name_start(c: int): bool:
ret (c >= 97 and c <= 122) or (c >= 65 and c <= 90) or c == 95 or c >= 128
end
func is_name_char(c: int): bool:
ret is_name_start(c) or (c >= 48 and c <= 57) or c == 45
end
func is_digit(c: int): bool:
ret c >= 48 and c <= 57
end
func is_space(c: int): bool:
ret c == 32 or c == 9 or c == 10 or c == 13 or c == 12
end
func lower_ascii(s: str): str:
n := s.len()
p := (s as void*) as u8*
mut need := false
repeat n in i:
c := _ub(p, i)
if c >= 65 and c <= 90:
need = true
break
end
end
if not need:
ret str.Clone(s)
end
mut b := str.NewBuilder()
repeat n in i:
c := _ub(p, i)
if c >= 65 and c <= 90:
str.BufAppendChar(b, c + 32)
else:
str.BufAppendChar(b, c)
end
end
out := str.BufStr(b)
str.BufFree(b)
ret out
end
func pow10(k: int): f64:
mut r := 1.0
repeat k:
r *= 10.0
end
ret r
end
func number_at(p: u8*, n: int, start: int, out &: f64, intl &: bool): int:
mut i := start
mut neg := false
if i < n and (_ub(p, i) == 43 or _ub(p, i) == 45):
neg = _ub(p, i) == 45
i++
end
mut mant := 0 as i64
mut scale := 0
mut digits := 0
mut extra := 0
until i < n and is_digit(_ub(p, i)):
if digits < 17:
mant = mant * 10 + (_ub(p, i) - 48) as i64
digits++
else:
extra++
end
i++
end
mut is_int := true
if i + 1 < n and _ub(p, i) == 46 and is_digit(_ub(p, i + 1)):
is_int = false
i++
until i < n and is_digit(_ub(p, i)):
if digits < 17:
mant = mant * 10 + (_ub(p, i) - 48) as i64
digits++
scale++
end
i++
end
end
mut ex := 0
if i + 1 < n and (_ub(p, i) == 101 or _ub(p, i) == 69):
mut j := i + 1
mut eneg := false
if j < n and (_ub(p, j) == 43 or _ub(p, j) == 45):
eneg = _ub(p, j) == 45
j++
end
if j < n and is_digit(_ub(p, j)):
is_int = false
until j < n and is_digit(_ub(p, j)):
if ex < 400:
ex = ex * 10 + _ub(p, j) - 48
end
j++
end
if eneg:
ex = 0 - ex
end
i = j
end
end
mut v := mant as f64
e10 := ex + extra - scale
if e10 > 0:
v *= pow10(e10)
else e10 < 0:
v /= pow10(0 - e10)
end
out = neg ? 0.0 - v : v
intl = is_int
ret i
end
func starts_number(p: u8*, n: int, i: int): bool:
c := _ub(p, i)
if is_digit(c):
ret true
end
if c == 46:
ret i + 1 < n and is_digit(_ub(p, i + 1))
end
if c == 43 or c == 45:
if i + 1 < n and is_digit(_ub(p, i + 1)):
ret true
end
ret i + 2 < n and _ub(p, i + 1) == 46 and is_digit(_ub(p, i + 2))
end
ret false
end
func name_end(p: u8*, n: int, i: int): int:
mut j := i
until j < n:
c := _ub(p, j)
if is_name_char(c):
j++
else c == 92 and j + 1 < n:
j += 2
else:
break
end
end
ret j
end
func unescape(s: str): str:
if str.IndexOf(s, "\\") < 0:
ret str.Clone(s)
end
n := s.len()
p := (s as void*) as u8*
mut b := str.NewBuilder()
mut i := 0
until i < n:
c := _ub(p, i)
if c == 92 and i + 1 < n:
mut j := i + 1
mut cp := 0
mut hex := 0
until j < n and hex < 6:
h := _ub(p, j)
mut hv := -1
if h >= 48 and h <= 57:
hv = h - 48
else h >= 97 and h <= 102:
hv = h - 87
else h >= 65 and h <= 70:
hv = h - 55
end
if hv < 0:
break
end
cp = cp * 16 + hv
hex++
j++
end
if hex > 0:
str.BufAppendCp(b, cp)
if j < n and is_space(_ub(p, j)):
j++
end
i = j
else:
str.BufAppendChar(b, _ub(p, i + 1))
i += 2
end
else:
str.BufAppendChar(b, c)
i++
end
end
out := str.BufStr(b)
str.BufFree(b)
ret out
end
func tokenize(src: str, out &: Vector<Tok>):
first := out.len()
n := src.len()
p := (src as void*) as u8*
mut stack := Vector {} as Vector<int>
defer stack.free()
mut i := 0
mut ws := false
until i < n:
c := _ub(p, i)
if is_space(c):
ws = true
i++
continue
end
if c == 47 and i + 1 < n and _ub(p, i + 1) == 42:
mut j := i + 2
until j + 1 < n and not (_ub(p, j) == 42 and _ub(p, j + 1) == 47):
j++
end
i = j + 2
ws = true
continue
end
mut t := Tok { p0 = i, ws = ws }
ws = false
if starts_number(p, n, i):
mut v := 0.0
mut il := false
j := number_at(p, n, i, v, il)
t.n = v
t.int_like = il
if j < n and _ub(p, j) == 37:
t.k = TK_PCT
t.p1 = j + 1
else j < n and (is_name_start(_ub(p, j)) or (_ub(p, j) == 45 and j + 1 < n and is_name_start(_ub(p, j + 1)))):
e := name_end(p, n, j)
t.k = TK_DIM
u := src.substr(j, e - j)
t.s = lower_ascii(u)
sfree(u)
t.p1 = e
else:
t.k = TK_NUM
t.p1 = j
end
t.raw = src.substr(i, t.p1 - i)
i = t.p1
out.push(t)
continue
end
if is_name_start(c) or c == 92 or (c == 45 and i + 1 < n and (is_name_start(_ub(p, i + 1)) or _ub(p, i + 1) == 45 or _ub(p, i + 1) == 92)):
e := name_end(p, n, i)
rawname := src.substr(i, e - i)
name := unescape(rawname)
sfree(rawname)
if e < n and _ub(p, e) == 40:
lname := lower_ascii(name)
if lname == "url":
mut j := e + 1
until j < n and is_space(_ub(p, j)):
j++
end
if j < n and (_ub(p, j) == 34 or _ub(p, j) == 39):
t.k = TK_FUNC
t.s = lname
t.raw = name
t.p1 = e + 1
out.push(t)
stack.push(out.len() - 1)
i = e + 1
continue
end
mut k := j
until k < n and _ub(p, k) != 41:
k++
end
mut ke := k
until ke > j and is_space(_ub(p, ke - 1)):
ke--
end
t.k = TK_URL
t.s = src.substr(j, ke - j)
t.raw = src.substr(i, k + 1 - i)
t.p1 = k < n ? k + 1 : n
i = t.p1
sfree(lname)
sfree(name)
out.push(t)
continue
end
t.k = TK_FUNC
t.s = lname
t.raw = name
t.p1 = e + 1
out.push(t)
stack.push(out.len() - 1)
i = e + 1
continue
end
t.k = TK_IDENT
t.s = lower_ascii(name)
t.raw = name
t.p1 = e
i = e
out.push(t)
continue
end
if c == 34 or c == 39:
mut j := i + 1
until j < n and _ub(p, j) != c:
if _ub(p, j) == 92:
j++
end
j++
end
if j > n:
j = n
end
body := src.substr(i + 1, j - i - 1)
t.k = TK_STR
t.s = unescape(body)
sfree(body)
t.p1 = j < n ? j + 1 : n
t.raw = src.substr(i, t.p1 - i)
i = t.p1
out.push(t)
continue
end
if c == 35 and i + 1 < n and is_name_char(_ub(p, i + 1)):
e := name_end(p, n, i + 1)
t.k = TK_HASH
t.raw = src.substr(i + 1, e - i - 1)
t.s = lower_ascii(t.raw)
t.p1 = e
i = e
out.push(t)
continue
end
if c == 40:
t.k = TK_FUNC
t.s = ""
t.raw = ""
t.p1 = i + 1
out.push(t)
stack.push(out.len() - 1)
i++
continue
end
if c == 41:
if stack.len() > 0:
o := stack.pop()
t.k = TK_CLOSE
t.p1 = i + 1
out.push(t)
mut open_tok := out.ref(o)
open_tok.close = out.len() - 1
open_tok.p1 = i + 1
end
i++
continue
end
if c == 44:
t.k = TK_COMMA
t.p1 = i + 1
out.push(t)
i++
continue
end
t.k = TK_DELIM
t.d = c
t.p1 = i + 1
out.push(t)
i++
end
until stack.len() > 0:
o := stack.pop()
t := Tok { k = TK_CLOSE, p0 = n, p1 = n }
out.push(t)
mut open_tok := out.ref(o)
open_tok.close = out.len() - 1
open_tok.p1 = n
end
mut q := first
until q < out.len():
kq := out[q].k
if kq == TK_IDENT or kq == TK_FUNC or kq == TK_DIM:
mut tq := out.ref(q)
tq.id = name_id(tq.s)
end
q++
end
end
func free_toks(v &: Vector<Tok>, from: int):
mut i := v.len() - 1
until i >= from:
t := v[i]
if not t.stat:
if t.s.len() > 0:
sfree(t.s)
end
if t.raw.len() > 0:
sfree(t.raw)
end
end
_x := v.pop()
i--
end
end
func nxt(t: Vector<Tok>, i: int): int:
if t[i].k == TK_FUNC and t[i].close > i:
ret t[i].close + 1
end
ret i + 1
end
func is_kw(t: Vector<Tok>, i: int, e: int, kw: str): bool:
ret i < e and t[i].k == TK_IDENT and t[i].s == kw
end
func is_kw_id(t: Vector<Tok>, i: int, e: int, id: int): bool:
ret i < e and t[i].k == TK_IDENT and t[i].id == id
end
func is_delim(t: Vector<Tok>, i: int, e: int, d: int): bool:
ret i < e and t[i].k == TK_DELIM and t[i].d == d
end
func count_items(t: Vector<Tok>, s: int, e: int): int:
mut c := 0
mut i := s
until i < e:
c++
i = nxt(t, i)
end
ret c
end
func split_commas(t: Vector<Tok>, s: int, e: int, out &: Vector<int>):
out.push(s)
mut i := s
until i < e:
if t[i].k == TK_COMMA:
out.push(i)
out.push(i + 1)
end
i = nxt(t, i)
end
out.push(e)
end
package css
import str
func block_sch(sd &: SheetData, d0: int, n: int): bool:
repeat n in k:
if d0 + k < sd.decls.len() and sd.decls[d0 + k].sch:
ret true
end
end
ret false
end
func decl_sch(t: Vector<Tok>, s: int, e: int, prop: int, has_var: bool): bool:
if has_var or prop == P_COLOR_SCHEME:
ret true
end
mut i := s
until i < e:
tk := t[i]
if tk.k == TK_COLOR and (tk.d & 1) != 0:
ret true
end
if tk.k == TK_FUNC and tk.s == "light-dark":
ret true
end
if tk.k == TK_IDENT:
mut c := Color {}
mut c2 := Color {}
if system_color(tk.s, false, c) and system_color(tk.s, true, c2) and pack_color(c) != pack_color(c2):
ret true
end
end
i++
end
ret false
end
func is_color_prop(p: int): bool:
if p >= P_BORDER_TOP_COLOR and p < P_BORDER_TOP_COLOR + 4:
ret true
end
if p >= L_BC and p < L_BC + 4:
ret true
end
switch p:
P_COLOR, P_BG_COLOR, P_OUTLINE_COLOR, P_TD_COLOR, P_CARET_COLOR, P_ACCENT_COLOR, P_BOX_SHADOW, P_TEXT_SHADOW:
ret true
end
else:
ret false
end
end
ret false
end
func is_color_fn(name: str): bool:
switch name:
"rgb", "rgba", "hsl", "hsla", "hwb", "lab", "lch", "oklab", "oklch", "color", "color-mix", "light-dark":
ret true
end
else:
ret false
end
end
ret false
end
func try_color(t: Vector<Tok>, s: int, e: int, out &: Tok): bool:
cur1 := Color { r = 1, g = 2, b = 3 }
cur2 := Color { r = 200, g = 100, b = 50, a = 128 }
mut a := CF {}
if not parse_cf_at(t, s, e, false, cur1, a):
ret false
end
mut a2 := CF {}
if not parse_cf_at(t, s, e, false, cur2, a2):
ret false
end
cl := pack_color(cf_to_color(a))
if cl != pack_color(cf_to_color(a2)):
ret false
end
mut d := CF {}
if not parse_cf_at(t, s, e, true, cur1, d):
ret false
end
cd := pack_color(cf_to_color(d))
mut flags := 0
if cd != cl:
flags |= 1
end
if not a.legacy:
flags |= 2
end
out = Tok { k = TK_COLOR, c = cl, c2 = cd, d = flags, ws = t[s].ws, stat = true }
ret true
end
func try_calc(t: Vector<Tok>, i: int, out &: Tok): bool:
a := calc_fn(t, i, Cx {})
b := calc_fn(t, i, Cx { fs = 11.0, pfs = 13.0, rfs = 17.0, vw = 333.0, vh = 444.0, pkw = 1.5 })
ok := a.ok and b.ok and a.nl.len() == 0 and b.nl.len() == 0 and not a.has_pct and not b.has_pct and a.kind == b.kind and a.v == b.v
lin_free(a)
lin_free(b)
if not ok:
ret false
end
switch a.kind:
K_LEN:
if a.v < 0.0:
ret false
end
out = Tok { k = TK_DIM, n = a.v, s = name_of(name_id("px")), id = name_id("px"), stat = true }
break
end
K_NUM:
if a.v < 0.0:
ret false
end
out = Tok { k = TK_NUM, n = a.v, int_like = true, stat = true }
break
end
K_ANG:
out = Tok { k = TK_DIM, n = a.v, s = name_of(name_id("deg")), id = name_id("deg"), stat = true }
break
end
else:
if a.v < 0.0:
ret false
end
out = Tok { k = TK_DIM, n = a.v, s = name_of(name_id("ms")), id = name_id("ms"), stat = true }
break
end
end
out.ws = t[i].ws
ret true
end
func canon_dim(tk &: Tok):
switch tk.s:
"in", "cm", "mm", "q", "pt", "pc", "rad", "grad", "turn":
break
end
else:
ret
end
end
mut v := 0.0
mut kind := K_LEN
cx := Cx {}
if not unit_value(tk.n, tk.id, cx, v, kind):
ret
end
if not tk.stat:
sfree(tk.s)
sfree(tk.raw)
end
tk.n = v
tk.s = name_of(name_id(kind == K_ANG ? "deg" : "px"))
tk.id = name_id(tk.s)
tk.raw = ""
tk.stat = true
end
func drop_toks(t: Vector<Tok>, s: int, e: int):
mut i := s
until i < e:
tk := t[i]
if not tk.stat:
sfree(tk.s)
sfree(tk.raw)
end
i++
end
end
func resolve_decl(sd &: SheetData, prop: int, ts: int):
mut src := Vector {} as Vector<Tok>
defer src.free()
repeat sd.toks.len() - ts in k:
mut tk := sd.toks[ts + k]
if tk.close >= 0:
tk.close -= ts
end
src.push(tk)
end
until sd.toks.len() > ts:
_x := sd.toks.pop()
end
col := is_color_prop(prop)
grad := prop == P_BG_IMAGE or prop == P_BI_SOURCE
mut stack := Vector {} as Vector<int>
defer stack.free()
mut gdepth := -1
mut i := 0
until i < src.len():
mut tk := src[i]
n := nxt(src, i)
depth := stack.len()
cand := (col and depth == 0) or (grad and gdepth >= 0 and depth == gdepth + 1)
fcol := (col or (grad and gdepth >= 0)) and tk.k == TK_FUNC and is_color_fn(tk.s)
if (cand and (tk.k == TK_HASH or tk.k == TK_IDENT)) or fcol:
mut ct := Tok {}
if try_color(src, i, n, ct):
drop_toks(src, i, n)
sd.toks.push(ct)
i = n
continue
end
end
if tk.k == TK_FUNC and is_math_fn(tk.s):
mut mt := Tok {}
if try_calc(src, i, mt):
drop_toks(src, i, n)
sd.toks.push(mt)
i = n
continue
end
end
if tk.k == TK_DIM:
canon_dim(tk)
end
if tk.k == TK_FUNC:
if grad and gdepth < 0 and str.EndsWith(tk.s, "gradient"):
gdepth = depth
end
stack.push(sd.toks.len())
tk.close = -1
end
if tk.k == TK_CLOSE and stack.len() > 0:
o := stack.pop()
mut open_tok := sd.toks[o]
open_tok.close = sd.toks.len()
sd.toks[o] = open_tok
if gdepth == stack.len():
gdepth = -1
end
end
sd.toks.push(tk)
i++
end
end
@en "KeywordId"
@fa "شناسه کلیدواژه"
pub func KeywordId(name: str): int:
ret name_id(name)
end
@en "KeywordName"
@fa "نام کلیدواژه"
pub func KeywordName(id: int): str:
ret str.Clone(name_of(id))
end
@en "PropertyId"
@fa "شناسه ویژگی سبک"
pub func PropertyId(name: str): int:
ret prop_id(name)
end
@en "PropertyName"
@fa "نام ویژگی سبک"
pub func PropertyName(id: int): str:
ret str.Clone(prop_name(id))
end
@en "KwId"
@fa "کلیدواژه با شناسه"
pub func KwId(id: int): Piece:
ret Piece { kind = TK_IDENT, id = id }
end
@en "DimId"
@fa "کمیت با شناسه واحد"
pub func DimId(value: f64, unit: int): Piece:
ret Piece { kind = TK_DIM, num = value, id = unit }
end
@en "FnId"
@fa "کارکرد با شناسه"
pub func FnId(id: int): Piece:
ret Piece { kind = TK_FUNC, id = id }
end
@en "ColorValue"
@fa "رنگ حل شده"
pub func ColorValue(light: i64, dark: i64, flags: int): Piece:
ret Piece { kind = TK_COLOR, color = light, dark = dark, code = flags }
end
package css
import str
const UA_CSS := `
html, address, blockquote, body, center, dialog, div, figure, figcaption, footer, form, header, hr, legend, listing, main, p, plaintext, pre, search, xmp { display: block }
area, base, datalist, head, link, meta, noscript, param, rp, script, style, template, title, track, source { display: none }
[hidden] { display: none }
html { color: canvastext }
body { margin: 8px }
p { margin-block: 1em; margin-inline: 0 }
address, cite, dfn, em, i, var { font-style: italic }
blockquote, figure { margin-block: 1em; margin-inline: 40px }
center { text-align: center }
hr { color: gray; overflow: hidden; margin-block: 0.5em; margin-inline: auto; border-style: inset; border-width: 1px }
article, aside, footer, header, hgroup, main, nav, section, search { display: block }
h1, h2, h3, h4, h5, h6 { display: block; font-weight: bold; margin-inline: 0 }
h1 { font-size: 2em; margin-block: 0.67em }
h2 { font-size: 1.5em; margin-block: 0.83em }
h3 { font-size: 1.17em; margin-block: 1em }
h4 { margin-block: 1.33em }
h5 { font-size: 0.83em; margin-block: 1.67em }
h6 { font-size: 0.67em; margin-block: 2.33em }
ul, menu, dir { display: block; list-style-type: disc; margin-block: 1em; margin-inline: 0; padding-inline-start: 40px }
ol { display: block; list-style-type: decimal; margin-block: 1em; margin-inline: 0; padding-inline-start: 40px }
li { display: list-item; text-align: match-parent }
ul ul, ol ul, menu ul, ul menu, ol menu, menu menu { list-style-type: circle }
ul ul ul, ul ol ul, ol ul ul, ol ol ul, ul ul menu, ol ol menu, ul ol menu, ol ul menu { list-style-type: square }
ul ul, ul ol, ul dl, ul menu, ol ul, ol ol, ol dl, ol menu, dl ul, dl ol, dl dl, dl menu, menu ul, menu ol, menu dl, menu menu { margin-block: 0 }
dd { display: block; margin-inline-start: 40px }
dl { display: block; margin-block: 1em; margin-inline: 0 }
dt { display: block }
table { display: table; box-sizing: border-box; border-spacing: 2px; border-collapse: separate; text-indent: 0 }
caption { display: table-caption; text-align: center }
thead { display: table-header-group; vertical-align: middle; border-color: inherit }
tbody { display: table-row-group; vertical-align: middle; border-color: inherit }
tfoot { display: table-footer-group; vertical-align: middle; border-color: inherit }
col { display: table-column }
colgroup { display: table-column-group }
tr { display: table-row; vertical-align: inherit; border-color: inherit }
td, th { display: table-cell; vertical-align: inherit; padding: 1px }
th { font-weight: bold; text-align: center }
b, strong { font-weight: bolder }
code, kbd, samp, tt { font-family: monospace }
pre, xmp, plaintext, listing { font-family: monospace; white-space: pre; margin-block: 1em; margin-inline: 0 }
big { font-size: larger }
small { font-size: smaller }
sub { vertical-align: sub; font-size: smaller }
sup { vertical-align: super; font-size: smaller }
s, strike, del { text-decoration: line-through }
u, ins { text-decoration: underline }
abbr[title], acronym[title] { text-decoration: dotted underline }
mark { background-color: mark; color: marktext }
a:any-link { color: linktext; text-decoration: underline; cursor: pointer }
a:any-link:active { color: activetext }
ruby { display: ruby }
rt { font-size: 50% }
nobr { white-space: nowrap }
wbr { display: inline }
details, summary { display: block }
details > summary:first-of-type { display: list-item; list-style: disclosure-closed inside }
details[open] > summary:first-of-type { list-style-type: disclosure-open }
dialog { position: absolute; inset-inline-start: 0; inset-inline-end: 0; width: fit-content; height: fit-content; margin: auto; border: solid; padding: 1em; background-color: canvas; color: canvastext }
dialog:not([open]) { display: none }
fieldset { display: block; margin-inline: 2px; border: 2px groove buttonface; padding-block: 0.35em 0.625em; padding-inline: 0.75em; min-inline-size: min-content }
legend { display: block; padding-inline: 2px }
input, textarea, select, button { margin: 0; font: -webkit-small-control; color: fieldtext; letter-spacing: normal; word-spacing: normal; line-height: normal; text-transform: none; text-indent: 0; text-shadow: none; display: inline-block; text-align: start }
input { appearance: auto; padding-block: 1px; padding-inline: 2px; background-color: field; border: 2px inset light-dark(rgb(118, 118, 118), rgb(133, 133, 133)); cursor: text; overflow: clip }
input[type="hidden"] { display: none }
input[type="checkbox"] { appearance: auto; box-sizing: border-box; margin: 3px 3px 3px 4px; padding: 0; border: 0 none; background-color: transparent; cursor: default; overflow: visible }
input[type="radio"] { appearance: auto; box-sizing: border-box; margin: 3px 3px 0 5px; padding: 0; border: 0 none; background-color: transparent; cursor: default; overflow: visible; border-radius: 50% }
input[type="range"] { appearance: auto; margin: 2px; padding: 0; border: 0 none; cursor: default; color: rgb(157, 150, 142); overflow: visible }
input[type="color"] { appearance: auto; inline-size: 50px; block-size: 27px; border: 1px solid light-dark(rgb(118, 118, 118), rgb(133, 133, 133)); padding: 1px 2px; background-color: buttonface; cursor: default; box-sizing: border-box }
input[type="file"] { appearance: none; padding: 0; border: 0 none; background-color: transparent; cursor: default }
input[type="button"], input[type="submit"], input[type="reset"] { white-space: pre }
input[type="button"], input[type="submit"], input[type="reset"], button { appearance: auto; padding-block: 1px; padding-inline: 6px; border: 2px outset buttonborder; background-color: buttonface; color: buttontext; text-align: center; cursor: default; box-sizing: border-box }
textarea { appearance: auto; font-family: monospace; overflow: auto; border: 1px solid light-dark(rgb(118, 118, 118), rgb(133, 133, 133)); padding: 2px; background-color: field; white-space: pre-wrap; overflow-wrap: break-word; cursor: text }
select { appearance: auto; box-sizing: border-box; align-items: center; border: 1px solid light-dark(rgb(118, 118, 118), rgb(133, 133, 133)); border-radius: 0; white-space: pre; background-color: buttonface; cursor: default; overflow: clip }
option { display: block; padding-inline: 2px; padding-block-end: 1px; white-space: nowrap; min-block-size: 1.2em; gap: 0.5em; align-items: center }
optgroup { display: block; font-weight: bolder }
progress { appearance: auto; box-sizing: border-box; display: inline-block; block-size: 1em; inline-size: 10em; vertical-align: -0.2em }
meter { appearance: auto; box-sizing: border-box; display: inline-block; block-size: 1em; inline-size: 5em; vertical-align: -0.2em }
label { cursor: default }
img, video, canvas { overflow: clip }
video { object-fit: contain }
audio:not([controls]) { display: none }
[dir="rtl"] { direction: rtl }
[dir="ltr"] { direction: ltr }
:focus-visible { outline: auto 1px rgb(16, 16, 16) }
input:focus-visible, textarea:focus-visible, select:focus-visible { outline-offset: 0 }
a:focus-visible { outline-offset: 1px }
`
func norm_kind(kind: str): str:
lk := lower_ascii(kind)
r := str.Replace(lk, "_", " ")
sfree(lk)
ret r
end
func tag_of(kind: str): str:
k := norm_kind(kind)
defer sfree(k)
switch k:
"page", "layout": ret "body" end
"box": ret "div" end
"abbreviation": ret "abbr" end
"sidebar", "aside": ret "aside" end
"block quote", "blockquote": ret "blockquote" end
"bold", "b": ret "b" end
"break", "br": ret "br" end
"cell", "column": ret "td" end
"column definition", "col": ret "col" end
"column group", "colgroup": ret "colgroup" end
"data list", "datalist": ret "datalist" end
"definition", "dfn": ret "dfn" end
"deleted", "del": ret "del" end
"description", "dd", "description in box": ret "dd" end
"description list", "dl": ret "dl" end
"direction override", "bdo": ret "bdo" end
"emphasis", "em": ret "em" end
"field set", "fieldset": ret "fieldset" end
"figure caption", "figcaption": ret "figcaption" end
"head link": ret "link" end
"heading": ret "h1" end
"heading group", "hgroup": ret "hgroup" end
"image", "img": ret "img" end
"image map", "map": ret "map" end
"inserted", "ins": ret "ins" end
"isolate", "bdi": ret "bdi" end
"italic", "i": ret "i" end
"item", "li": ret "li" end
"keyboard", "kbd": ret "kbd" end
"line", "hr": ret "hr" end
"link", "a": ret "a" end
"list", "ul": ret "ul" end
"mark", "highlight": ret "mark" end
"meter", "gauge": ret "meter" end
"no script", "noscript": ret "noscript" end
"option group", "optgroup": ret "optgroup" end
"ordered list", "numbered list", "ol": ret "ol" end
"paragraph", "p": ret "p" end
"preformatted", "pre": ret "pre" end
"quote", "q": ret "q" end
"row", "tr": ret "tr" end
"ruby parenthesis", "rp": ret "rp" end
"ruby text", "rt": ret "rt" end
"sample", "samp": ret "samp" end
"select", "dropdown": ret "select" end
"strikethrough", "s": ret "s" end
"subscript", "sub": ret "sub" end
"superscript", "sup": ret "sup" end
"term", "dt", "term in box": ret "dt" end
"text area", "textarea": ret "textarea" end
"underline", "u": ret "u" end
"variable", "var": ret "var" end
"word break", "wbr": ret "wbr" end
"table head", "thead": ret "thead" end
"table body", "tbody": ret "tbody" end
"table foot", "tfoot": ret "tfoot" end
"header cell", "th": ret "th" end
else:
p := (k as void*) as u8*
mut ok := k.len() > 0
repeat k.len() in i:
c := p[i] as int
if not ((c >= 97 and c <= 122) or (c >= 48 and c <= 57)):
ok = false
end
end
if ok:
ret intern(k)
end
ret "div"
end
end
ret "div"
end
