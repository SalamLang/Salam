s >>= (32 as u64)
s += t7 + c * (0xffffffff as u64)
t6 = s & PF_M
s >>= (32 as u64)
s += t8
t7 = s & PF_M
t8 = s >> (32 as u64)
c = 0 as u64
s = t0 + a7 * b0 + c
t0 = s & PF_M
c = s >> (32 as u64)
s = t1 + a7 * b1 + c
t1 = s & PF_M
c = s >> (32 as u64)
