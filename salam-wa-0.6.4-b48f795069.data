else:
comb = _bz_rotl1(comb) ^ bc
end
else:
more = false
if m1 == 0x177245 and m2 == 0x385090:
hi := _bz_get(s, 16)
lo := _bz_get(s, 16)
stored := ((hi as u32) << 16) | (lo as u32)
if not s.bad and stored == comb:
st = 0
s.cnt -= s.cnt % 8
end
end
end
end
end
mem.Free(tt as void*)
mem.Free(ll as void*)
ret st
end
inline func _bz_put(w &: _BzOut, k: int, v: int):
w.acc = (w.acc << k) | (v as i64)
w.cnt += k
until w.cnt >= 8:
w.cnt -= 8
BufPush(w.buf, ((w.acc >> w.cnt) & (255 as i64)) as int)
end
w.acc &= (((1 as i64) << w.cnt) - (1 as i64))
end
func _bz_bwt(blk: u8*, n: int, last: u8*, p0: int*, c0: int*, pn: int*, cn0: int*, cnt: int*, orig &: int):
mut p := p0
mut c := c0
mut cn := cn0
repeat 256 in i: cnt[i] = 0 end
repeat n in i: cnt[blk[i] as int]++ end
mut sum := 0
repeat 256 in i:
t := cnt[i]
cnt[i] = sum
sum += t
end
repeat n in i:
ch := blk[i] as int
p[cnt[ch]] = i
cnt[ch]++
end
c[p[0]] = 0
mut classes := 1
mut i := 1
until i < n:
if blk[p[i]] != blk[p[i - 1]]: classes++ end
c[p[i]] = classes - 1
i++
end
mut len := 1
until len < n and classes < n:
i = 0
until i < n:
mut v := p[i] - len
if v < 0: v += n end
pn[i] = v
i++
end
i = 0
until i < classes:
cnt[i] = 0
i++
end
i = 0
until i < n:
cnt[c[pn[i]]]++
i++
end
sum = 0
i = 0
until i < classes:
t := cnt[i]
cnt[i] = sum
sum += t
i++
end
i = 0
until i < n:
x := pn[i]
k := c[x]
p[cnt[k]] = x
cnt[k]++
i++
end
cn[p[0]] = 0
classes = 1
i = 1
until i < n:
a := p[i]
b := p[i - 1]
mut a2 := a + len
if a2 >= n: a2 -= n end
mut b2 := b + len
if b2 >= n: b2 -= n end
if c[a] != c[b] or c[a2] != c[b2]: classes++ end
cn[a] = classes - 1
i++
end
tmp := c
c = cn
cn = tmp
len <<= 1
end
i = 0
until i < n:
mut r := p[i]
if r == 0:
orig = i
r = n
end
last[i] = blk[r - 1]
i++
end
end
func _bz_lengths(lens: int*, lo: int, freq: int*, fo: int, alpha: int, maxlen: int):
mut wt: int[516]
mut par: int[516]
mut dep: int[516]
mut act: int[258]
mut f: int[258]
repeat alpha in i:
f[i] = freq[fo + i]
if f[i] == 0: f[i] = 1 end
end
mut more := true
until more:
repeat alpha in i:
wt[i] = f[i] << 8
dep[i] = 0
par[i] = -1
act[i] = i
end
mut na := alpha
mut nn := alpha
until na > 1:
mut a := 0
repeat na in k:
x := act[k]
y := act[a]
if wt[x] < wt[y] or (wt[x] == wt[y] and dep[x] < dep[y]): a = k end
end
n1 := act[a]
act[a] = act[na - 1]
na--
mut b := 0
repeat na in k:
x := act[k]
y := act[b]
if wt[x] < wt[y] or (wt[x] == wt[y] and dep[x] < dep[y]): b = k end
end
n2 := act[b]
wt[nn] = wt[n1] + wt[n2]
mut dd := dep[n1]
if dep[n2] > dd: dd = dep[n2] end
dep[nn] = dd + 1
par[n1] = nn
par[n2] = nn
par[nn] = -1
act[b] = nn
nn++
end
mut tooLong := false
repeat alpha in i:
mut d := 0
mut j := i
until par[j] >= 0:
j = par[j]
d++
end
lens[lo + i] = d
if d > maxlen: tooLong = true end
end
if tooLong:
repeat alpha in i:
f[i] = 1 + f[i] / 2
end
else:
more = false
end
end
end
func _bz_emit_block(w &: _BzOut, blk: u8*, n: int, crc: u32, wp: int*, wc: int*, wq: int*, wd: int*, wcnt: int*, mtfv: u16*, last: u8*): int:
mut orig := 0
_bz_bwt(blk, n, last, wp, wc, wq, wd, wcnt, orig)
mut inuse: bool[256]
mut u2s: int[256]
repeat 256 in i:
inuse[i] = false
u2s[i] = 0
end
repeat n in i: inuse[blk[i] as int] = true end
mut nuse := 0
repeat 256 in i:
if inuse[i]:
u2s[i] = nuse
nuse++
end
end
eob := nuse + 1
alpha := nuse + 2
mut yy: int[256]
repeat 256 in i: yy[i] = i end
mut gf: int[258]
repeat 258 in i: gf[i] = 0 end
mut wr := 0
mut zp := 0
mut i := 0
until i < n:
li := u2s[last[i] as int]
if yy[0] == li:
zp++
else:
if zp > 0:
zp--
mut more := true
until more:
if (zp & 1) != 0:
mtfv[wr] = 1 as u16
gf[1]++
else:
mtfv[wr] = 0 as u16
gf[0]++
end
wr++
if zp < 2:
more = false
else:
zp = (zp - 2) / 2
end
end
zp = 0
end
mut j := 0
until yy[j] != li: j++ end
mut k := j
until k > 0:
yy[k] = yy[k - 1]
k--
end
yy[0] = li
mtfv[wr] = (j + 1) as u16
gf[j + 1]++
wr++
end
i++
end
if zp > 0:
zp--
mut more := true
until more:
if (zp & 1) != 0:
mtfv[wr] = 1 as u16
gf[1]++
else:
mtfv[wr] = 0 as u16
gf[0]++
end
wr++
if zp < 2:
more = false
else:
zp = (zp - 2) / 2
end
end
end
mtfv[wr] = eob as u16
gf[eob]++
wr++
nmtf := wr
mut ng := 6
if nmtf < 2400: ng = 5 end
if nmtf < 1200: ng = 4 end
if nmtf < 600: ng = 3 end
if nmtf < 200: ng = 2 end
lens := mem.Allocate((1548 * 4) as u64) as int*
freq := mem.Allocate((1548 * 4) as u64) as int*
codes := mem.Allocate((1548 * 4) as u64) as int*
