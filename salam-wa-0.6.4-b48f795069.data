c.pk_alg = PK_EC_P256
ret true
end
if _oid_is(curve, OID_SECP384R1):
if key.len != 97 or _rdat(key, 0) != 0x04:
ret false
end
c.ec_point = key
c.pk_alg = PK_EC_P384
ret true
end
ret false
end
ret false
end
