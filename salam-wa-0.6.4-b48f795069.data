@en "TotalMemory"
@fa "کل حافظه"
pub func TotalMemory(): i64:
reply := os.Output(`powershell -NoProfile -Command "(Get-CimInstance Win32_ComputerSystem).TotalPhysicalMemory"`)
digits := extract_digits(reply)
if digits.len() == 0: ret 0 - 1 end
ret conv.ParseIntOr(digits, 0 - 1)
end
@en "AvailableMemory"
@fa "حافظه موجود"
pub func AvailableMemory(): i64:
reply := os.Output(`powershell -NoProfile -Command "(Get-CimInstance Win32_OperatingSystem).FreePhysicalMemory"`)
digits := extract_digits(reply)
kb := conv.ParseIntOr(digits, 0 - 1)
if kb < 0: ret 0 - 1 end
ret kb * 1024
end
else:
if SALAM_OS_LINUX:
@en "CpuCount"
@fa "تعداد پردازنده"
pub func CpuCount(): int: ret sysconf(_SC_NPROCESSORS_ONLN) as int end
else:
@en "CpuCount"
@fa "تعداد پردازنده"
pub func CpuCount(): int:
reply := os.Output("sysctl -n hw.ncpu")
if reply.len() == 0: ret 0 - 1 end
ret conv.AtoiOr(reply, 0 - 1)
end
end
@en "TotalMemory"
@fa "کل حافظه"
pub func TotalMemory(): i64:
if SALAM_OS_LINUX:
ret _meminfo_field("MemTotal:")
else:
reply := os.Output("sysctl -n hw.memsize 2>/dev/null || sysctl -n hw.physmem 2>/dev/null")
if reply.len() == 0: ret 0 - 1 end
ret conv.ParseIntOr(reply, 0 - 1)
end
end
@en "AvailableMemory"
@fa "حافظه موجود"
pub func AvailableMemory(): i64:
if SALAM_OS_LINUX:
ret _meminfo_field("MemAvailable:")
else:
ret 0 - 1
end
end
end
package os
@en "Run"
@fa "اجرا"
pub func Run(cmd: str): int:
ret _proc_status(system(cmd))
end
@en "RunCapture"
@fa "اجرا با خروجی"
pub func RunCapture(cmd: str): CmdResult:
res := CmdResult {}
fp := _proc_open(cmd)
if fp == null:
res.code = 0 - 1
ret res
end
buf := mem.Allocate(4096 as u64)
mut sb := str.NewBuilder()
mut go := true
until go:
r := fgets(buf, 4096, fp)
if r == null:
go = false
else:
str.BufAppend(sb, buf as str)
end
end
mem.Free(buf)
res.out = str.BufStr(sb)
str.BufFree(sb)
res.code = _proc_status(_proc_close(fp))
ret res
end
@en "Output"
@fa "خروجی فرمان"
pub func Output(cmd: str): str:
res := RunCapture(cmd)
ret res.out
end
@en "Pid"
