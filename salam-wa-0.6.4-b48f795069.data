func _zs_hb(x: int): int:
mut v := x
mut r := 0
until v > 1:
v >>= 1
r++
end
ret r
end
func _zb_init(r &: _ZBr, p: u8*, n: int): bool:
r.p = p
r.pos = 0
if n < 1:
ret false
end
last := p[n - 1] as int
if last == 0:
ret false
end
r.pos = (n - 1) * 8 + _zs_hb(last)
