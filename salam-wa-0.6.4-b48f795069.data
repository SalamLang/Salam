a /= sx
b /= sx
end
mut skew := a * c + b * dd
c -= a * skew
dd -= b * skew
sy := math.Sqrt(c * c + dd * dd)
if sy > 0.0:
c /= sy
dd /= sy
skew /= sy
end
if a * dd - b * c < 0.0:
sx = 0.0 - sx
a = 0.0 - a
b = 0.0 - b
skew = 0.0 - skew
