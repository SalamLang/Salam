@en "SpawnOptions"
@fa "گزینه های راه اندازی"
pub struct SpawnOptions:
@en "path"
@fa "مسیر"
pub path: str = ""
@en "args"
@fa "آرگومان ها"
pub args: Vector<str> = Vector {}
@en "raw_args"
@fa "آرگومان های خام"
pub raw_args: str = ""
@en "cwd"
@fa "پوشه کاری"
pub cwd: str = ""
@en "output"
@fa "پرونده خروجی"
pub output: str = ""
end
if SALAM_OS_WINDOWS:
func _spawn_wide(s: str): void*:
needed := MultiByteToWideChar(65001 as u32, 0 as u32, s, 0 - 1, null, 0)
buf := mem.Allocate(((needed + 1) as u64) * (2 as u64))
MultiByteToWideChar(65001 as u32, 0 as u32, s, 0 - 1, buf, needed + 1)
ret buf
end
func _spawn_quote(sb &: str.StringBuilder, arg: str):
n := str.Len(arg)
bytes := arg as u8*
mut plain := n > 0
repeat n in i:
c := bytes[i] as int
if c == 32 or c == 9 or c == 34:
plain = false
end
end
if plain:
str.BufAppend(sb, arg)
ret
end
str.BufAppendChar(sb, 34)
mut slashes := 0
repeat n in i:
c := bytes[i] as int
if c == 92:
slashes++
str.BufAppendChar(sb, 92)
continue
end
if c == 34:
repeat slashes + 1:
str.BufAppendChar(sb, 92)
end
end
slashes = 0
str.BufAppendChar(sb, c)
end
repeat slashes:
str.BufAppendChar(sb, 92)
end
str.BufAppendChar(sb, 34)
end
func _spawn_cmdline(o: SpawnOptions): str:
mut sb := str.NewBuilder()
_spawn_quote(sb, o.path)
each arg in o.args:
str.BufAppendChar(sb, 32)
_spawn_quote(sb, arg)
end
if o.raw_args.len() > 0:
str.BufAppendChar(sb, 32)
str.BufAppend(sb, o.raw_args)
end
out := str.BufStr(sb)
str.BufFree(sb)
ret out
end
@en "Spawn"
@fa "راه اندازی"
pub func Spawn(o: SpawnOptions): Process:
cmdline := _spawn_wide(_spawn_cmdline(o))
defer mem.Free(cmdline)
wide_cwd := o.cwd.len() > 0 ? _spawn_wide(o.cwd) : null
si := mem.AllocateZeroed(104 as u64)
defer mem.Free(si)
_u32_set(si, 0, _si_size() as u32)
mut p := Process {}
out_h := o.output.len() > 0 ? _open_inheritable(o.output, 1073741824 as u32, 2 as u32) : null
if o.output.len() > 0 and out_h == null:
error.Set(error.ProcessFailed, "cannot open the output file", "Spawn", o.output, -1)
ret p
end
in_h := _open_inheritable("NUL", 2147483648 as u32, 3 as u32)
if out_h != null:
_u32_set(si, _si_flags_at(), 256 as u32)
_ptr_set(si, _si_handles_at(), in_h)
_ptr_set(si, _si_handles_at() + _word(), out_h)
_ptr_set(si, _si_handles_at() + _word() * 2, out_h)
end
pi := mem.AllocateZeroed(24 as u64)
defer mem.Free(pi)
ok := CreateProcessW(null, cmdline, null, null, 1, 0x08000000 as u32, null, wide_cwd, si, pi)
if in_h != null: CloseHandle(in_h) end
if out_h != null: CloseHandle(out_h) end
if wide_cwd != null: mem.Free(wide_cwd) end
if ok == 0:
error.Set(error.ProcessFailed, "CreateProcess failed", "Spawn", o.path, GetLastError())
ret p
end
p.pid = _u32_at(pi, _pi_pid_at()) as int
p.handle = _ptr_at(pi, 0)
CloseHandle(_ptr_at(pi, _word()))
p.running = true
ret p
end
@en "TryWait"
@fa "انتظار بدون توقف"
pub func TryWait(p &: Process): bool:
if p.handle == null: ret true end
if WaitForSingleObject(p.handle, 0) != 0:
ret false
end
buf := mem.AllocateZeroed(4 as u64)
GetExitCodeProcess(p.handle, buf)
p.exit_code = _u32_at(buf, 0) as int
mem.Free(buf)
CloseHandle(p.handle)
p.handle = null
p.running = false
ret true
end
@en "KillTree"
@fa "کشتن درخت"
pub func KillTree(p &: Process):
if p.pid <= 0 or p.handle == null: ret end
mut args := Vector {} as Vector<str>
defer args.free()
args.push("/PID")
args.push(str.FromInt(p.pid as i64))
args.push("/T")
args.push("/F")
mut killer := Spawn(SpawnOptions { path = "taskkill", args = args })
_code := Wait(killer)
end
else:
@en "Spawn"
@fa "راه اندازی"
pub func Spawn(o: SpawnOptions): Process:
argv := _build_argv(o.path, o.args)
out_fd := o.output.len() > 0 ? open(o.output, _open_flags(), 0o600) : -1
if o.output.len() > 0 and out_fd < 0:
mem.Free(argv)
error.Set(error.ProcessFailed, "cannot open the output file", "Spawn", o.output, -1)
ret Process {}
end
in_fd := open("/dev/null", 0, 0)
pid := fork()
if pid == 0:
_pg := setpgid(0, 0)
if o.cwd.len() > 0 and chdir(o.cwd) != 0:
_exit(126)
end
if in_fd >= 0:
_in := dup2(in_fd, 0)
end
if out_fd >= 0:
_o1 := dup2(out_fd, 1)
_o2 := dup2(out_fd, 2)
end
_gone := execvp(o.path, argv)
_exit(127)
end
mem.Free(argv)
if out_fd >= 0: close(out_fd) end
if in_fd >= 0: close(in_fd) end
mut p := Process {}
if pid < 0:
error.Set(error.ProcessFailed, "fork failed", "Spawn", o.path, pid)
ret p
end
_pg2 := setpgid(pid, pid)
p.pid = pid
p.running = true
ret p
end
@en "TryWait"
@fa "انتظار بدون توقف"
pub func TryWait(p &: Process): bool:
if p.pid <= 0: ret true end
statusbuf := mem.AllocateZeroed(4 as u64)
defer mem.Free(statusbuf)
rc := waitpid(p.pid, statusbuf, 1)
if rc == 0:
ret false
end
if rc < 0:
p.running = false
ret true
end
status := (statusbuf as int*)[0]
low := status % 128
if low == 0:
p.exit_code = (status / 256) % 256
else:
p.exit_code = 128 + low
end
p.running = false
ret true
end
@en "KillTree"
@fa "کشتن درخت"
pub func KillTree(p &: Process):
if p.pid > 0:
_sent := kill(0 - p.pid, 9)
end
end
end
@en "pty"
@fa "پایانه مجازی"
package pty
import mem
import str
import os.error
import os.internal.fdio
import os.process
if SALAM_OS_WINDOWS:
link dynamic "kernel32"
else:
extern:
func posix_openpt(flags: int): int
func grantpt(fd: int): int
func unlockpt(fd: int): int
func ptsname(fd: int): str
func ioctl(fd: int, req: usize, ...): int
func setsid(): int
func fork(): int
func waitpid(pid: int, status: void*, options: int): int
func chdir(path: str): int
func open(path: str, flags: int, ...): int
func fcntl(fd: int, cmd: int, ...): int
noret func _exit(code: int)
end
end
if SALAM_OS_LINUX:
const _OPEN_FLAGS := 258
const _TIOCSWINSZ := 0x5414
const _TIOCGWINSZ := 0x5413
const _TIOCSCTTY := 0x540E
else SALAM_OS_MAC:
const _OPEN_FLAGS := 131074
const _TIOCSWINSZ := 0x80087467
const _TIOCGWINSZ := 0x40087468
const _TIOCSCTTY := 0x20007461
else SALAM_OS_BSD:
const _OPEN_FLAGS := 32770
const _TIOCSWINSZ := 0x80087467
const _TIOCGWINSZ := 0x40087468
const _TIOCSCTTY := 0x20007461
end
@en "Size"
@fa "اندازه پنجره"
pub struct Size:
@en "rows"
@fa "سطرها"
pub rows: int = 0
@en "cols"
@fa "ستون ها"
pub cols: int = 0
end
func _fail(message: str, program: str): process.Child:
error.Set(error.ProcessFailed, message, "Open", program, 0 - 1)
ret process.Child { error = message }
end
if SALAM_OS_WINDOWS:
func _open_impl(c: process.Command, _rows: int, _cols: int): process.Child:
ret _fail("a pseudo terminal is not available on Windows", c.program)
end
@en "Resize"
@fa "تغییر اندازه"
pub func Resize(_c: process.Child, _rows: int, _cols: int): bool:
ret false
end
@en "GetSize"
@fa "گرفتن اندازه"
pub func GetSize(_c: process.Child): Size:
ret Size {}
end
else:
func _set_size(fd: int, rows: int, cols: int): bool:
ws := mem.AllocateZeroed(8 as u64)
defer mem.Free(ws)
p := ws as u16*
p[0] = rows as u16
p[1] = cols as u16
ret ioctl(fd, _TIOCSWINSZ as usize, ws) == 0
end
func _open_impl(c: process.Command, rows: int, cols: int): process.Child:
if c.program.len() == 0: ret _fail("no program given", c.program) end
resolved := fdio.Resolve(c.program, c.env, c.clear_env)
if resolved.len() == 0:
mem.Free(resolved as void*)
ret _fail("program not found", c.program)
end
master := posix_openpt(_OPEN_FLAGS)
if master < 0:
mem.Free(resolved as void*)
ret _fail("cannot open a pseudo terminal", c.program)
end
_g := grantpt(master)
_u := unlockpt(master)
slave_name := str.Clone(ptsname(master))
_c := fcntl(master, 2, 1)
mut r := rows
mut w := cols
if r <= 0: r = 24 end
if w <= 0: w = 80 end
_s := _set_size(master, r, w)
ep := fdio.MakePipe()
argv := fdio.BuildArgv(c.program, c.args)
mut owned := Vector {} as Vector<str>
envp := fdio.BuildEnvp(c.clear_env, c.env, c.unset_env, owned)
use_env := envp == null ? fdio.Environ() : envp
wmark := mem.AllocateZeroed(1 as u64)
pid := fork()
if pid == 0:
_sid := setsid()
slave := open(slave_name, 2, 0)
mut stage := 0
if slave < 0:
stage = 2
end
if stage == 0:
_ct := ioctl(slave, _TIOCSCTTY as usize, 0)
fdio.Redirect(slave, 0)
fdio.Redirect(slave, 1)
fdio.Redirect(slave, 2)
if slave > 2: fdio.Close(slave as i64) end
if c.cwd.len() > 0 and chdir(c.cwd) != 0: stage = 1 end
end
if stage == 0:
_gone := fdio.ExecVe(resolved, argv, use_env)
stage = 2
end
(wmark as u8*)[0] = stage as u8
_wr := fdio.WriteRaw(ep.w, wmark, 1)
_exit(127)
end
fdio.Close(ep.w)
mem.Free(argv)
mem.Free(wmark)
if envp != null: mem.Free(envp) end
each line in owned:
mem.Free(line as void*)
end
owned.free()
mem.Free(resolved as void*)
mem.Free(slave_name as void*)
if pid < 0:
fdio.Close(master as i64)
fdio.Close(ep.r)
ret _fail("fork failed", c.program)
end
mark := mem.AllocateZeroed(1 as u64)
got := fdio.ReadRaw(ep.r, mark, 1)
stage := (mark as u8*)[0] as int
mem.Free(mark)
fdio.Close(ep.r)
if got > 0:
sb := mem.AllocateZeroed(4 as u64)
_reaped := waitpid(pid, sb, 0)
mem.Free(sb)
fdio.Close(master as i64)
if stage == 1: ret _fail("cannot enter the folder", c.program) end
ret _fail("cannot run the program", c.program)
end
ret process.Child { pid = pid, ok = true, h_in = master as i64, h_out = master as i64 }
end
@en "Resize"
@fa "تغییر اندازه"
pub func Resize(c: process.Child, rows: int, cols: int): bool:
if c.h_out < 0: ret false end
ret _set_size(c.h_out as int, rows, cols)
end
@en "GetSize"
@fa "گرفتن اندازه"
pub func GetSize(c: process.Child): Size:
if c.h_out < 0: ret Size {} end
ws := mem.AllocateZeroed(8 as u64)
defer mem.Free(ws)
if ioctl(c.h_out as int, _TIOCGWINSZ as usize, ws) != 0: ret Size {} end
p := ws as u16*
ret Size { rows = p[0] as int, cols = p[1] as int }
end
end
@en "Supported"
@fa "پشتیبانی می شود"
pub func Supported(): bool:
ret not SALAM_OS_WINDOWS
end
@en "Open"
@fa "باز کردن"
pub func Open(c: process.Command, rows: int, cols: int): process.Child:
ret _open_impl(c, rows, cols)
end
@en "shell"
@fa "پوسته"
package shell
import os.process
if SALAM_OS_WINDOWS:
extern:
func system(cmd: str): int
end
end
@en "CmdResult"
@fa "نتیجه فرمان"
pub struct CmdResult:
@en "code"
@fa "کد"
pub code: int = 0
@en "out"
@fa "خروجی"
pub out: str = ""
@en "err"
@fa "خروجی خطا"
pub err: str = ""
end
@en "Run"
@fa "اجرا"
pub func Run(command: str, args: Vector<str>): CmdResult:
mut p := process.StartCaptured(command, args)
if p.pid <= 0:
process.Cleanup(p)
ret CmdResult { code = 0 - 1 }
end
code := process.Wait(p)
out := process.ReadStdout(p)
err := process.ReadStderr(p)
process.Cleanup(p)
ret CmdResult { code = code, out = out, err = err }
end
@en "Exec"
@fa "اجرا با متن فرمان"
pub func Exec(command: str): CmdResult:
parts := command.split(" ")
defer parts.free()
n := parts.len()
if n == 0: ret CmdResult { code = 0 - 1 } end
exe := parts.get(0)
args := Vector {} as Vector<str>
mut i := 1
until i < n:
seg := parts.get(i)
if seg.len() > 0: args.push(seg) end
i++
end
ret Run(exe, args)
end
@en "System"
@fa "اجرای پوسته"
pub func System(command: str): int:
if SALAM_OS_WINDOWS:
ret system(command)
else:
mut args := Vector {} as Vector<str>
args.push("-c")
args.push(command)
mut p := process.Start("/bin/sh", args)
args.free()
if p.pid <= 0:
ret 127
end
ret process.Wait(p)
end
end
@en "temp"
@fa "موقت"
package temp
import os
import fs
import fs.path
import io
import crypto
import os.error
@en "File"
@fa "پرونده موقت"
pub func File(): str:
name := "salam-".concat(crypto.RandomHex(8)).concat(".tmp")
p := path.Join(os.TempDir(), name)
io.WriteFile(p, "")
fs.Chmod(p, 384)
ret p
end
@en "Directory"
@fa "پوشه موقت"
pub func Directory(): str:
name := "salam-".concat(crypto.RandomHex(8))
p := path.Join(os.TempDir(), name)
if os.Mkdir(p) != 0:
error.Set(error.IOError, "failed to create temp dir", "Directory", p, 0)
ret ""
end
fs.Chmod(p, 448)
ret p
end
@en "Remove"
@fa "حذف"
pub func Remove(p: str): int:
if os.Remove(p) != 0:
error.Set(error.IOError, "failed to remove temp file", "Remove", p, 0)
ret 0 - 1
end
ret 0
end
@en "RemoveDir"
@fa "حذف پوشه"
pub func RemoveDir(p: str): int:
if os.RemoveAll(p) != 0:
error.Set(error.IOError, "failed to remove temp dir", "RemoveDir", p, 0)
ret 0 - 1
end
ret 0
end
@en "user"
@fa "کاربر"
package user
import os
import fs.path
if SALAM_OS_WINDOWS == false:
extern:
func getuid(): int
func getgid(): int
func getpwuid(uid: int): void*
end
func _pw_name(): str:
pw := getpwuid(getuid())
if pw == null: ret "" end
words := pw as i64*
if words[0] == 0: ret "" end
slots := pw as str*
ret slots[0]
end
end
