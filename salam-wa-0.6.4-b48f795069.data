end
mut lg := Vector {} as Vector<int>
mut kg := Vector {} as Vector<int>
mut lr := Vector {} as Vector<int>
mut kr := Vector {} as Vector<int>
mut lbl := Vector {} as Vector<int>
mut kb := Vector {} as Vector<int>
