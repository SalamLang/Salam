r.a6 = ((d6 & mask) | (t6 & ~mask)) as u32
r.a7 = ((d7 & mask) | (t7 & ~mask)) as u32
end
func _pf_add(r &: F8, a &: F8, b &: F8):
mut s := 0 as u64
s = (a.a0 as u64) + (b.a0 as u64) + (s >> (32 as u64))
t0 := s & PF_M
s = (a.a1 as u64) + (b.a1 as u64) + (s >> (32 as u64))
t1 := s & PF_M
s = (a.a2 as u64) + (b.a2 as u64) + (s >> (32 as u64))
t2 := s & PF_M
s = (a.a3 as u64) + (b.a3 as u64) + (s >> (32 as u64))
t3 := s & PF_M
s = (a.a4 as u64) + (b.a4 as u64) + (s >> (32 as u64))
t4 := s & PF_M
s = (a.a5 as u64) + (b.a5 as u64) + (s >> (32 as u64))
t5 := s & PF_M
s = (a.a6 as u64) + (b.a6 as u64) + (s >> (32 as u64))
t6 := s & PF_M
s = (a.a7 as u64) + (b.a7 as u64) + (s >> (32 as u64))
t7 := s & PF_M
t8 := s >> (32 as u64)
mut bw := 0 as u64
d0 := t0 - (0xffffffff as u64) - bw
bw = (d0 >> (32 as u64)) & (1 as u64)
d1 := t1 - (0xffffffff as u64) - bw
bw = (d1 >> (32 as u64)) & (1 as u64)
d2 := t2 - (0xffffffff as u64) - bw
bw = (d2 >> (32 as u64)) & (1 as u64)
d3 := t3 - (0x0 as u64) - bw
bw = (d3 >> (32 as u64)) & (1 as u64)
d4 := t4 - (0x0 as u64) - bw
bw = (d4 >> (32 as u64)) & (1 as u64)
d5 := t5 - (0x0 as u64) - bw
bw = (d5 >> (32 as u64)) & (1 as u64)
d6 := t6 - (0x1 as u64) - bw
bw = (d6 >> (32 as u64)) & (1 as u64)
d7 := t7 - (0xffffffff as u64) - bw
bw = (d7 >> (32 as u64)) & (1 as u64)
mask := (0 as u64) - ((t8 | (bw ^ (1 as u64))) & (1 as u64))
r.a0 = ((d0 & mask) | (t0 & ~mask)) as u32
r.a1 = ((d1 & mask) | (t1 & ~mask)) as u32
r.a2 = ((d2 & mask) | (t2 & ~mask)) as u32
r.a3 = ((d3 & mask) | (t3 & ~mask)) as u32
r.a4 = ((d4 & mask) | (t4 & ~mask)) as u32
r.a5 = ((d5 & mask) | (t5 & ~mask)) as u32
r.a6 = ((d6 & mask) | (t6 & ~mask)) as u32
r.a7 = ((d7 & mask) | (t7 & ~mask)) as u32
end
func _pf_sub(r &: F8, a &: F8, b &: F8):
mut bw := 0 as u64
t0 := (a.a0 as u64) - (b.a0 as u64) - bw
bw = (t0 >> (32 as u64)) & (1 as u64)
t1 := (a.a1 as u64) - (b.a1 as u64) - bw
bw = (t1 >> (32 as u64)) & (1 as u64)
t2 := (a.a2 as u64) - (b.a2 as u64) - bw
bw = (t2 >> (32 as u64)) & (1 as u64)
t3 := (a.a3 as u64) - (b.a3 as u64) - bw
bw = (t3 >> (32 as u64)) & (1 as u64)
t4 := (a.a4 as u64) - (b.a4 as u64) - bw
bw = (t4 >> (32 as u64)) & (1 as u64)
t5 := (a.a5 as u64) - (b.a5 as u64) - bw
bw = (t5 >> (32 as u64)) & (1 as u64)
t6 := (a.a6 as u64) - (b.a6 as u64) - bw
bw = (t6 >> (32 as u64)) & (1 as u64)
t7 := (a.a7 as u64) - (b.a7 as u64) - bw
bw = (t7 >> (32 as u64)) & (1 as u64)
mask := (0 as u64) - bw
mut c := 0 as u64
c = (t0 & PF_M) + ((0xffffffff as u64) & mask) + (c >> (32 as u64))
r.a0 = c as u32
c = (t1 & PF_M) + ((0xffffffff as u64) & mask) + (c >> (32 as u64))
r.a1 = c as u32
c = (t2 & PF_M) + ((0xffffffff as u64) & mask) + (c >> (32 as u64))
r.a2 = c as u32
c = (t3 & PF_M) + ((0x0 as u64) & mask) + (c >> (32 as u64))
r.a3 = c as u32
c = (t4 & PF_M) + ((0x0 as u64) & mask) + (c >> (32 as u64))
r.a4 = c as u32
c = (t5 & PF_M) + ((0x0 as u64) & mask) + (c >> (32 as u64))
r.a5 = c as u32
c = (t6 & PF_M) + ((0x1 as u64) & mask) + (c >> (32 as u64))
r.a6 = c as u32
c = (t7 & PF_M) + ((0xffffffff as u64) & mask) + (c >> (32 as u64))
r.a7 = c as u32
end
inline func _pf_cmov(r &: F8, a &: F8, mask: u32):
r.a0 = (r.a0 & ~mask) | (a.a0 & mask)
r.a1 = (r.a1 & ~mask) | (a.a1 & mask)
r.a2 = (r.a2 & ~mask) | (a.a2 & mask)
r.a3 = (r.a3 & ~mask) | (a.a3 & mask)
r.a4 = (r.a4 & ~mask) | (a.a4 & mask)
r.a5 = (r.a5 & ~mask) | (a.a5 & mask)
r.a6 = (r.a6 & ~mask) | (a.a6 & mask)
r.a7 = (r.a7 & ~mask) | (a.a7 & mask)
end
inline func _pf_load(r &: F8, p: u32*, off: int):
r.a0 = p[off + 0]
r.a1 = p[off + 1]
r.a2 = p[off + 2]
r.a3 = p[off + 3]
r.a4 = p[off + 4]
r.a5 = p[off + 5]
r.a6 = p[off + 6]
r.a7 = p[off + 7]
end
inline func _pf_store(p: u32*, off: int, a &: F8):
p[off + 0] = a.a0
p[off + 1] = a.a1
p[off + 2] = a.a2
p[off + 3] = a.a3
p[off + 4] = a.a4
p[off + 5] = a.a5
p[off + 6] = a.a6
p[off + 7] = a.a7
end
inline func _pf_or_mask_load(r &: F8, p: u32*, off: int, mask: u32):
r.a0 |= (p[off + 0] & mask)
r.a1 |= (p[off + 1] & mask)
r.a2 |= (p[off + 2] & mask)
r.a3 |= (p[off + 3] & mask)
r.a4 |= (p[off + 4] & mask)
r.a5 |= (p[off + 5] & mask)
r.a6 |= (p[off + 6] & mask)
r.a7 |= (p[off + 7] & mask)
end
inline func _pf_iszero_mask(a &: F8): u32:
x := a.a0 | a.a1 | a.a2 | a.a3 | a.a4 | a.a5 | a.a6 | a.a7
ret (0 as u32) - ((((x as u64) - (1 as u64)) >> (63 as u64)) as u32)
end
func _pf_from_fe(r &: F8, f: Fe):
r.a0 = f.v[0]
r.a1 = f.v[1]
r.a2 = f.v[2]
r.a3 = f.v[3]
r.a4 = f.v[4]
r.a5 = f.v[5]
r.a6 = f.v[6]
r.a7 = f.v[7]
end
func _pf_to_fe(a &: F8, f &: Fe):
f.v[0] = a.a0
f.v[1] = a.a1
f.v[2] = a.a2
f.v[3] = a.a3
f.v[4] = a.a4
f.v[5] = a.a5
f.v[6] = a.a6
f.v[7] = a.a7
end
func _pf_one(): F8:
mut f := F8 {}
f.a0 = 1 as u32
f.a3 = 0xffffffff as u32
f.a4 = 0xffffffff as u32
f.a5 = 0xffffffff as u32
f.a6 = 0xfffffffe as u32
ret f
end
func _pf_sqn(r &: F8, a &: F8, n: int):
_pf_mul(r, a, a)
repeat n - 1:
_pf_mul(r, r, r)
end
end
func _pf_inv(r &: F8, a &: F8):
mut x2 := F8 {}
_pf_mul(x2, a, a)
_pf_mul(x2, x2, a)
mut x3 := F8 {}
_pf_mul(x3, x2, x2)
_pf_mul(x3, x3, a)
mut x6 := F8 {}
_pf_sqn(x6, x3, 3)
_pf_mul(x6, x6, x3)
mut x12 := F8 {}
_pf_sqn(x12, x6, 6)
_pf_mul(x12, x12, x6)
mut x15 := F8 {}
_pf_sqn(x15, x12, 3)
_pf_mul(x15, x15, x3)
mut x30 := F8 {}
_pf_sqn(x30, x15, 15)
_pf_mul(x30, x30, x15)
mut x32 := F8 {}
_pf_sqn(x32, x30, 2)
_pf_mul(x32, x32, x2)
mut t := F8 {}
_pf_sqn(t, x32, 32)
_pf_mul(t, t, a)
_pf_sqn(t, t, 128)
_pf_mul(t, t, x32)
_pf_sqn(t, t, 32)
_pf_mul(t, t, x32)
_pf_sqn(t, t, 30)
_pf_mul(t, t, x30)
_pf_sqn(t, t, 2)
_pf_mul(r, t, a)
end
func _pfn_inv(r &: F8, a &: F8):
tab := mem.Allocate((PF_ENTRIES * 32) as u64) as u32*
_pf_store(tab, 0, a)
mut t := F8 {}
t = a
mut i := 1
until i < PF_ENTRIES:
_pfn_mul(t, t, a)
_pf_store(tab, i * 8, t)
i++
end
mut started := false
mut w := 63
until w >= 0:
limb := P256_N[w / 8]
mut digit := ((limb >> ((4 * (w % 8)) as u32)) & (15 as u32)) as int
if w == 1:
digit--
else w == 0:
digit = (digit + 16 - 2) & 15
end
if started:
_pfn_mul(t, t, t)
_pfn_mul(t, t, t)
_pfn_mul(t, t, t)
_pfn_mul(t, t, t)
end
if digit != 0:
mut e := F8 {}
_pf_load(e, tab, (digit - 1) * 8)
if started:
_pfn_mul(t, t, e)
else:
t = e
started = true
end
end
w--
end
r = t
_wipe(tab as void*, PF_ENTRIES * 32)
mem.Free(tab as void*)
end
func _pf_double(r &: J8, p &: J8):
mut delta := F8 {}
_pf_mul(delta, p.z, p.z)
mut gamma := F8 {}
_pf_mul(gamma, p.y, p.y)
mut beta := F8 {}
_pf_mul(beta, p.x, gamma)
mut t1 := F8 {}
_pf_sub(t1, p.x, delta)
mut t2 := F8 {}
_pf_add(t2, p.x, delta)
mut t3 := F8 {}
_pf_mul(t3, t1, t2)
mut alpha := F8 {}
_pf_add(alpha, t3, t3)
_pf_add(alpha, alpha, t3)
mut b4 := F8 {}
_pf_add(b4, beta, beta)
_pf_add(b4, b4, b4)
mut b8 := F8 {}
_pf_add(b8, b4, b4)
mut x3 := F8 {}
_pf_mul(x3, alpha, alpha)
_pf_sub(x3, x3, b8)
mut z3 := F8 {}
_pf_add(z3, p.y, p.z)
_pf_mul(z3, z3, z3)
_pf_sub(z3, z3, gamma)
_pf_sub(z3, z3, delta)
mut y3 := F8 {}
_pf_sub(b4, b4, x3)
_pf_mul(y3, alpha, b4)
mut g2 := F8 {}
_pf_mul(g2, gamma, gamma)
_pf_add(g2, g2, g2)
_pf_add(g2, g2, g2)
_pf_add(g2, g2, g2)
_pf_sub(r.y, y3, g2)
r.x = x3
r.z = z3
end
func _pf_madd(r &: J8, p &: J8, x2 &: F8, y2 &: F8):
mut z1z1 := F8 {}
_pf_mul(z1z1, p.z, p.z)
mut u2 := F8 {}
_pf_mul(u2, x2, z1z1)
mut s2 := F8 {}
_pf_mul(s2, y2, p.z)
_pf_mul(s2, s2, z1z1)
mut h := F8 {}
_pf_sub(h, u2, p.x)
mut hh := F8 {}
_pf_mul(hh, h, h)
mut i := F8 {}
_pf_add(i, hh, hh)
_pf_add(i, i, i)
mut j := F8 {}
_pf_mul(j, h, i)
mut rr := F8 {}
_pf_sub(rr, s2, p.y)
_pf_add(rr, rr, rr)
mut v := F8 {}
_pf_mul(v, p.x, i)
mut x3 := F8 {}
_pf_mul(x3, rr, rr)
_pf_sub(x3, x3, j)
_pf_sub(x3, x3, v)
_pf_sub(x3, x3, v)
mut y3 := F8 {}
_pf_sub(y3, v, x3)
_pf_mul(y3, rr, y3)
mut yj := F8 {}
_pf_mul(yj, p.y, j)
_pf_add(yj, yj, yj)
_pf_sub(y3, y3, yj)
mut z3 := F8 {}
_pf_add(z3, p.z, h)
_pf_mul(z3, z3, z3)
_pf_sub(z3, z3, z1z1)
_pf_sub(r.z, z3, hh)
r.x = x3
r.y = y3
end
func _pf_jadd(r &: J8, p &: J8, q &: J8):
mut z1z1 := F8 {}
_pf_mul(z1z1, p.z, p.z)
mut z2z2 := F8 {}
_pf_mul(z2z2, q.z, q.z)
mut u1 := F8 {}
_pf_mul(u1, p.x, z2z2)
mut u2 := F8 {}
_pf_mul(u2, q.x, z1z1)
mut s1 := F8 {}
_pf_mul(s1, p.y, q.z)
_pf_mul(s1, s1, z2z2)
mut s2 := F8 {}
_pf_mul(s2, q.y, p.z)
_pf_mul(s2, s2, z1z1)
mut h := F8 {}
_pf_sub(h, u2, u1)
mut i := F8 {}
_pf_add(i, h, h)
_pf_mul(i, i, i)
mut j := F8 {}
_pf_mul(j, h, i)
mut rr := F8 {}
_pf_sub(rr, s2, s1)
_pf_add(rr, rr, rr)
mut v := F8 {}
_pf_mul(v, u1, i)
mut x3 := F8 {}
_pf_mul(x3, rr, rr)
_pf_sub(x3, x3, j)
_pf_sub(x3, x3, v)
_pf_sub(x3, x3, v)
mut y3 := F8 {}
_pf_sub(y3, v, x3)
_pf_mul(y3, rr, y3)
mut sj := F8 {}
_pf_mul(sj, s1, j)
_pf_add(sj, sj, sj)
_pf_sub(y3, y3, sj)
mut z3 := F8 {}
_pf_add(z3, p.z, q.z)
_pf_mul(z3, z3, z3)
_pf_sub(z3, z3, z1z1)
_pf_sub(z3, z3, z2z2)
_pf_mul(r.z, z3, h)
r.x = x3
r.y = y3
end
inline func _pfj_load(r &: J8, p: u32*, off: int):
_pf_load(r.x, p, off)
_pf_load(r.y, p, off + 8)
_pf_load(r.z, p, off + 16)
end
inline func _pfj_store(p: u32*, off: int, a &: J8):
_pf_store(p, off, a.x)
_pf_store(p, off + 8, a.y)
_pf_store(p, off + 16, a.z)
end
func _pf_table_build():
count := PF_WINDOWS * PF_ENTRIES
jac := mem.Allocate((count * 96) as u64) as u32*
prod := mem.Allocate((count * 32) as u64) as u32*
tab := mem.Allocate((count * 64) as u64) as u32*
mut base := J8 {}
_pf_from_fe(base.x, _fe_from(_curve_p256().gx, 8))
_pf_from_fe(base.y, _fe_from(_curve_p256().gy, 8))
base.z = _pf_one()
repeat PF_WINDOWS in w:
row := w * PF_ENTRIES
_pfj_store(jac, row * 24, base)
mut d := 2
until d <= PF_ENTRIES:
mut e := J8 {}
if d % 2 == 0:
mut half := J8 {}
_pfj_load(half, jac, (row + d / 2 - 1) * 24)
_pf_double(e, half)
else:
mut prev := J8 {}
_pfj_load(prev, jac, (row + d - 2) * 24)
_pf_jadd(e, prev, base)
end
_pfj_store(jac, (row + d - 1) * 24, e)
d++
end
repeat 4:
_pf_double(base, base)
end
end
mut acc := _pf_one()
repeat count in i:
mut z := F8 {}
_pf_load(z, jac, i * 24 + 16)
_pf_store(prod, i * 8, acc)
_pf_mul(acc, acc, z)
end
mut inv := F8 {}
_pf_inv(inv, acc)
mut i := count - 1
until i >= 0:
mut z := F8 {}
_pf_load(z, jac, i * 24 + 16)
mut before := F8 {}
_pf_load(before, prod, i * 8)
mut zi := F8 {}
_pf_mul(zi, inv, before)
_pf_mul(inv, inv, z)
mut zi2 := F8 {}
_pf_mul(zi2, zi, zi)
mut x := F8 {}
_pf_load(x, jac, i * 24)
_pf_mul(x, x, zi2)
mut y := F8 {}
_pf_load(y, jac, i * 24 + 8)
_pf_mul(zi2, zi2, zi)
_pf_mul(y, y, zi2)
_pf_store(tab, i * PF_ENTRY_WORDS, x)
_pf_store(tab, i * PF_ENTRY_WORDS + 8, y)
i--
end
mem.Free(jac as void*)
mem.Free(prod as void*)
_pf_tab = tab
end
func _pf_table(): u32*:
sync.Lock(_pf_tab_mu)
if _pf_tab == null:
_pf_table_build()
end
t := _pf_tab
sync.Unlock(_pf_tab_mu)
ret t
end
inline func _pf_digit(k: Fe, w: int): int:
ret ((k.v[w / 8] >> ((4 * (w % 8)) as u32)) & (15 as u32)) as int
end
inline func _pf_eq_mask(a: int, b: int): u32:
x := (a ^ b) as u32
ret (0 as u32) - ((((x as u64) - (1 as u64)) >> (63 as u64)) as u32)
end
func _pf_base_mul(k: Fe, out &: J8):
tab := _pf_table()
mut one := _pf_one()
mut acc := J8 {}
acc.x = one
acc.y = one
repeat PF_WINDOWS in w:
d := _pf_digit(k, w)
mut x := F8 {}
mut y := F8 {}
row := w * PF_ENTRIES
repeat PF_ENTRIES in e:
mask := _pf_eq_mask(d, e + 1)
off := (row + e) * PF_ENTRY_WORDS
_pf_or_mask_load(x, tab, off, mask)
_pf_or_mask_load(y, tab, off + 8, mask)
end
mut sum := J8 {}
_pf_madd(sum, acc, x, y)
inf := _pf_iszero_mask(acc.z)
_pf_cmov(sum.x, x, inf)
_pf_cmov(sum.y, y, inf)
_pf_cmov(sum.z, one, inf)
keep := _pf_eq_mask(d, 0)
_pf_cmov(sum.x, acc.x, keep)
_pf_cmov(sum.y, acc.y, keep)
_pf_cmov(sum.z, acc.z, keep)
acc = sum
end
out = acc
end
func _pf_point_mul(k: Fe, p &: J8, out &: J8):
tab := mem.Allocate((PF_ENTRIES * 96) as u64) as u32*
_pfj_store(tab, 0, p)
mut d := 2
until d <= PF_ENTRIES:
mut e := J8 {}
if d % 2 == 0:
mut half := J8 {}
_pfj_load(half, tab, (d / 2 - 1) * 24)
_pf_double(e, half)
else:
mut prev := J8 {}
_pfj_load(prev, tab, (d - 2) * 24)
_pf_jadd(e, prev, p)
end
_pfj_store(tab, (d - 1) * 24, e)
d++
end
one := _pf_one()
mut acc := J8 {}
acc.x = one
acc.y = one
mut w := PF_WINDOWS - 1
until w >= 0:
if w != PF_WINDOWS - 1:
repeat 4:
_pf_double(acc, acc)
end
end
dg := _pf_digit(k, w)
mut q := J8 {}
repeat PF_ENTRIES in e:
mask := _pf_eq_mask(dg, e + 1)
off := e * 24
_pf_or_mask_load(q.x, tab, off, mask)
_pf_or_mask_load(q.y, tab, off + 8, mask)
_pf_or_mask_load(q.z, tab, off + 16, mask)
end
mut sum := J8 {}
_pf_jadd(sum, acc, q)
inf := _pf_iszero_mask(acc.z)
_pf_cmov(sum.x, q.x, inf)
_pf_cmov(sum.y, q.y, inf)
_pf_cmov(sum.z, q.z, inf)
keep := _pf_eq_mask(dg, 0)
_pf_cmov(sum.x, acc.x, keep)
_pf_cmov(sum.y, acc.y, keep)
_pf_cmov(sum.z, acc.z, keep)
acc = sum
w--
end
out = acc
_wipe(tab as void*, PF_ENTRIES * 96)
mem.Free(tab as void*)
end
func _pf_jac_out(a &: J8): Jac:
mut j := Jac {}
_pf_to_fe(a.x, j.x)
_pf_to_fe(a.y, j.y)
_pf_to_fe(a.z, j.z)
ret j
end
func _pf_mul_base(k: Fe): Jac:
mut r := J8 {}
_pf_base_mul(k, r)
ret _pf_jac_out(r)
end
func _pf_mul_point(k: Fe, pt: Jac): Jac:
mut p := J8 {}
_pf_from_fe(p.x, pt.x)
_pf_from_fe(p.y, pt.y)
_pf_from_fe(p.z, pt.z)
mut r := J8 {}
_pf_point_mul(k, p, r)
ret _pf_jac_out(r)
end
func _pf_inv_fe(r &: Fe, a: Fe, modn: bool):
mut x := F8 {}
_pf_from_fe(x, a)
mut y := F8 {}
if modn:
_pfn_inv(y, x)
else:
_pf_inv(y, x)
end
_pf_to_fe(y, r)
end
package tls
const P384_SIZE := 48
const P384_P := [
0xffffffff as u32, 0x00000000 as u32, 0x00000000 as u32, 0xffffffff as u32
0xfffffffe as u32, 0xffffffff as u32, 0xffffffff as u32, 0xffffffff as u32
0xffffffff as u32, 0xffffffff as u32, 0xffffffff as u32, 0xffffffff as u32
]
const P384_N := [
0xccc52973 as u32, 0xecec196a as u32, 0x48b0a77a as u32, 0x581a0db2 as u32
0xf4372ddf as u32, 0xc7634d81 as u32, 0xffffffff as u32, 0xffffffff as u32
0xffffffff as u32, 0xffffffff as u32, 0xffffffff as u32, 0xffffffff as u32
]
const P384_R2 := [
0x00000001 as u32, 0xfffffffe as u32, 0x00000000 as u32, 0x00000002 as u32
0x00000000 as u32, 0xfffffffe as u32, 0x00000000 as u32, 0x00000002 as u32
0x00000001 as u32, 0x00000000 as u32, 0x00000000 as u32, 0x00000000 as u32
]
const P384_R2N := [
0x19b409a9 as u32, 0x2d319b24 as u32, 0xdf1aa419 as u32, 0xff3d81e5 as u32
0xfcb82947 as u32, 0xbc3e483a as u32, 0x4aab1cc5 as u32, 0xd40d4917 as u32
0x28266895 as u32, 0x3fb05b7a as u32, 0x2b39bf21 as u32, 0x0c84ee01 as u32
]
const P384_ONE_MONT := [
0x00000001 as u32, 0xffffffff as u32, 0xffffffff as u32, 0x00000000 as u32
0x00000001 as u32, 0x00000000 as u32, 0x00000000 as u32, 0x00000000 as u32
0x00000000 as u32, 0x00000000 as u32, 0x00000000 as u32, 0x00000000 as u32
]
const P384_B_MONT := [
0x9d412dcc as u32, 0x08118871 as u32, 0x7a4c32ec as u32, 0xf729add8 as u32
0x1920022e as u32, 0x77f2209b as u32, 0x94938ae2 as u32, 0xe3374bee as u32
0x1f022094 as u32, 0xb62b21f4 as u32, 0x604fbff9 as u32, 0xcd08114b as u32
]
const P384_GX_MONT := [
0x49c0b528 as u32, 0x3dd07566 as u32, 0xa0d6ce38 as u32, 0x20e378e2 as u32
0x541b4d6e as u32, 0x879c3afc as u32, 0x59a30eff as u32, 0x64548684 as u32
0x614ede2b as u32, 0x812ff723 as u32, 0x299e1513 as u32, 0x4d3aadc2 as u32
]
const P384_GY_MONT := [
0x4b03a4fe as u32, 0x23043dad as u32, 0x7bb4a9ac as u32, 0xa1bfa8bf as u32
0x2e83b050 as u32, 0x8bade756 as u32, 0x68f4ffd9 as u32, 0xc6c35219 as u32
0x3969a840 as u32, 0xdd800226 as u32, 0x5a15c5e9 as u32, 0x2b78abc2 as u32
]
const P384_N0INV := 0xe88fdc45 as u32
func _curve_p384(): Curve:
mut c := Curve {}
c.nl = 12
c.nb = P384_SIZE
repeat 12 in i:
c.p[i] = P384_P[i]
c.n[i] = P384_N[i]
c.r2p[i] = P384_R2[i]
c.r2n[i] = P384_R2N[i]
c.one[i] = P384_ONE_MONT[i]
c.b[i] = P384_B_MONT[i]
c.gx[i] = P384_GX_MONT[i]
c.gy[i] = P384_GY_MONT[i]
end
c.n0p = 1 as u32
c.n0n = P384_N0INV
ret c
end
package tls
const PRF_LABEL_MASTER := "master secret"
const PRF_LABEL_EXT_MASTER := "extended master secret"
const PRF_LABEL_KEY_EXPANSION := "key expansion"
const PRF_LABEL_CLIENT_FINISHED := "client finished"
const PRF_LABEL_SERVER_FINISHED := "server finished"
const MASTER_SECRET_LEN := 48
const VERIFY_DATA_LEN := 12
func _p_hash(kind: int, secret: void*, slen: int, seed: Buf, out: void*, olen: int):
hlen := _hash_size(kind)
mut a := _newbuf(hlen)
defer _buf_wipe(a)
_putzeros(a, hlen)
_hmac(kind, secret, slen, seed.p, seed.len, a.p)
mut blk := _newbuf(hlen)
defer _buf_wipe(blk)
_putzeros(blk, hlen)
mut msg := _newbuf(hlen + seed.len)
defer _buf_free(msg)
mut done := 0
until done < olen:
_bufreset(msg)
_putbuf(msg, a)
_putbuf(msg, seed)
_hmac(kind, secret, slen, msg.p, msg.len, blk.p)
mut take := olen - done
if take > hlen:
take = hlen
end
repeat take in i:
_bput(out, done + i, _bufat(blk, i))
end
done += take
_hmac(kind, secret, slen, a.p, hlen, a.p)
end
end
func _prf(kind: int, secret: void*, slen: int, label: str, seed: Buf, out: void*, olen: int):
mut ls := _newbuf(label.len() + seed.len)
defer _buf_free(ls)
_putstr(ls, label)
_putbuf(ls, seed)
_p_hash(kind, secret, slen, ls, out, olen)
end
func _tls12_master(kind: int, pms: void*, pmslen: int, crand: Buf, srand: Buf, out: void*):
mut seed := _newbuf(64)
defer _buf_free(seed)
_putbuf(seed, crand)
_putbuf(seed, srand)
_prf(kind, pms, pmslen, PRF_LABEL_MASTER, seed, out, MASTER_SECRET_LEN)
end
func _tls12_master_ext(kind: int, pms: void*, pmslen: int, session_hash: Buf, out: void*):
_prf(kind, pms, pmslen, PRF_LABEL_EXT_MASTER, session_hash, out, MASTER_SECRET_LEN)
end
func _tls12_key_block(kind: int, master: void*, mlen: int, srand: Buf, crand: Buf, out: void*, olen: int):
mut seed := _newbuf(64)
defer _buf_free(seed)
_putbuf(seed, srand)
_putbuf(seed, crand)
_prf(kind, master, mlen, PRF_LABEL_KEY_EXPANSION, seed, out, olen)
end
func _tls12_verify_data(kind: int, master: void*, mlen: int, label: str, th: Buf, out: void*):
_prf(kind, master, mlen, label, th, out, VERIFY_DATA_LEN)
end
package tls
struct PrivateKey:
pub pk_alg: int = 0
pub rsa_n: Buf = Buf {}
pub rsa_e: Buf = Buf {}
pub rsa_d: Buf = Buf {}
pub rsa_phi: Buf = Buf {}
pub rsa_crt: RsaCrt* = null
pub ec_scalar: Buf = Buf {}
pub ok: bool = false
end
func _der_octetstring(r &: Reader): Reader:
t := _der_tag(r, ASN1_OCTETSTRING)
if not t.ok:
ret _newreader(null, 0)
end
ret t.body
end
func _parse_rsa_pkcs1_body(body: Reader, k &: PrivateKey): bool:
mut r := body
mut seq := _der_seq(r)
if r.bad:
ret false
end
_der_skip(seq)
n := _der_uint(seq)
e := _der_uint(seq)
d := _der_uint(seq)
p := _der_uint(seq)
q := _der_uint(seq)
if seq.bad:
ret false
end
if n.len < 128:
ret false
end
if e.len == 0 or d.len == 0 or p.len == 0 or q.len == 0:
ret false
end
k.rsa_n = _newbuf(n.len)
repeat n.len in i:
_put8(k.rsa_n, _rdat(n, i))
end
k.rsa_e = _newbuf(e.len)
repeat e.len in i:
_put8(k.rsa_e, _rdat(e, i))
end
k.rsa_d = _newbuf(d.len)
repeat d.len in i:
_put8(k.rsa_d, _rdat(d, i))
end
mut pbig := _big_from_bytes(p.p, p.len)
defer _big_wipe_free(pbig)
mut qbig := _big_from_bytes(q.p, q.len)
defer _big_wipe_free(qbig)
mut one := _big_new(1)
defer _big_free(one)
_big_set_u32(one, 1 as u32)
mut pm1 := _big_new(pbig.n + 1)
defer _big_wipe_free(pm1)
mut qm1 := _big_new(qbig.n + 1)
defer _big_wipe_free(qm1)
if pbig.bad or qbig.bad or one.bad or pm1.bad or qm1.bad:
ret false
end
if not _big_sub(pm1, pbig, one) or not _big_sub(qm1, qbig, one):
ret false
end
mut phi := _big_new(pm1.n + qm1.n)
defer _big_wipe_free(phi)
if phi.bad:
ret false
end
_big_mul(phi, pm1, qm1)
if phi.bad:
ret false
end
philen := _big_bytelen(phi)
k.rsa_phi = _newbuf(philen)
_putzeros(k.rsa_phi, philen)
if not _big_to_bytes(phi, k.rsa_phi.p, philen):
ret false
end
k.rsa_crt = _rsa_crt_new(n, e, d, p, q)
if k.rsa_crt == null:
ret false
end
k.pk_alg = PK_RSA
k.ok = true
ret true
end
func _parse_ec_sec1_body(body: Reader, curve_hint: int, k &: PrivateKey): bool:
mut r := body
mut seq := _der_seq(r)
if r.bad:
ret false
end
_der_skip(seq)
priv := _der_octetstring(seq)
if seq.bad:
ret false
end
mut alg := curve_hint
if _der_is(seq, ASN1_CTX0):
pt := _der_tag(seq, ASN1_CTX0)
if not pt.ok:
ret false
end
mut pb := pt.body
curve_oid := _der_oid(pb)
if pb.bad:
ret false
end
if _oid_is(curve_oid, OID_PRIME256V1):
alg = PK_EC_P256
else if _oid_is(curve_oid, OID_SECP384R1):
alg = PK_EC_P384
else:
ret false
end
end
if alg == PK_UNKNOWN:
if priv.len == 32:
alg = PK_EC_P256
else if priv.len == 48:
alg = PK_EC_P384
else:
ret false
end
end
mut width := 32
if alg == PK_EC_P384:
width = 48
end
if priv.len > width or priv.len == 0:
ret false
end
k.ec_scalar = _newbuf(width)
_putzeros(k.ec_scalar, width - priv.len)
repeat priv.len in i:
_put8(k.ec_scalar, _rdat(priv, i))
end
k.pk_alg = alg
k.ok = true
ret true
end
func _parse_pkcs8_body(body: Reader, k &: PrivateKey): bool:
mut r := body
mut seq := _der_seq(r)
if r.bad:
ret false
end
_der_skip(seq)
mut params := _newreader(null, 0)
alg_oid := _der_algid(seq, params)
if seq.bad:
ret false
end
pkoct := _der_octetstring(seq)
if seq.bad:
ret false
end
if _oid_is(alg_oid, OID_RSA_ENCRYPTION):
ret _parse_rsa_pkcs1_body(pkoct, k)
end
if _oid_is(alg_oid, OID_EC_PUBLICKEY):
mut pkcs8_curve := 0
mut pp := params
curve_oid := _der_oid(pp)
if not pp.bad:
if _oid_is(curve_oid, OID_PRIME256V1):
pkcs8_curve = PK_EC_P256
else if _oid_is(curve_oid, OID_SECP384R1):
pkcs8_curve = PK_EC_P384
end
end
ret _parse_ec_sec1_body(pkoct, pkcs8_curve, k)
end
ret false
end
@en "FreePrivateKey"
@fa "آزادسازی کلید خصوصی"
pub func FreePrivateKey(k &: PrivateKey):
_buf_wipe(k.rsa_d)
_buf_wipe(k.rsa_phi)
_rsa_crt_free(k.rsa_crt)
k.rsa_crt = null
_buf_free(k.rsa_n)
_buf_free(k.rsa_e)
_buf_wipe(k.ec_scalar)
k.ok = false
end
@en "ParsePrivateKeyPEM"
@fa "تجزیه کلید خصوصی پم"
pub func ParsePrivateKeyPEM(pem: str): PrivateKey:
mut k := PrivateKey {}
mut markers: str[3]
markers[0] = "RSA PRIVATE KEY"
markers[1] = "EC PRIVATE KEY"
markers[2] = "PRIVATE KEY"
mut mi := 0
until mi < 3:
begintag := "-----BEGIN " + markers[mi] + "-----"
endtag := "-----END " + markers[mi] + "-----"
b := pem.find(begintag)
if b >= 0:
bodystart := b + begintag.len()
e := str.IndexFrom(pem, endtag, bodystart)
if e >= 0:
room := (e - bodystart) / 4 * 3 + 8
mut der := _newbuf(room)
mut good := false
mut got := 0
try:
got = encoding.Base64DecodeBytes(pem.substr(bodystart, e - bodystart), der.p, room)
good = true
catch:
good = false
end
if good and got > 0:
rd := _newreader(der.p, got)
if mi == 0:
_parse_rsa_pkcs1_body(rd, k)
else if mi == 1:
_parse_ec_sec1_body(rd, PK_UNKNOWN, k)
else:
_parse_pkcs8_body(rd, k)
end
end
_buf_wipe(der)
if k.ok:
ret k
end
end
end
mi++
end
ret k
end
@en "LoadPrivateKeyFile"
@fa "بارگذاری فایل کلید خصوصی"
pub func LoadPrivateKeyFile(path: str): PrivateKey:
if not os.Exists(path):
k := PrivateKey {}
ret k
end
pem := io.ReadFile(path)
ret ParsePrivateKeyPEM(pem)
end
package tls
const ED_SPKI_LEN := 32
func _raw_new(fd: i64): Conn:
mut c := Conn {}
c.h = Handshake {}
c.h.rec = _rec_new(fd)
c.h.priv = _newbuf(32)
c.h.pub_key = _newbuf(32)
c.h.shared = _newbuf(32)
c.h.hs_secret = _newbuf(48)
c.h.master = _newbuf(48)
c.h.c_hs_secret = _newbuf(48)
c.h.s_hs_secret = _newbuf(48)
c.h.c_ap_secret = _newbuf(48)
c.h.s_ap_secret = _newbuf(48)
c.h.certs = _newbuf(8192)
c.h.cert_off = _newbuf(128)
c.h.crand = _newbuf(32)
c.h.srand = _newbuf(32)
c.h.ecpriv = _newbuf(32)
c.h.ecpub = _newbuf(65)
ret c
end
func _der_read(p: void*, n: int, off: int, tag &: int, dlen &: int, cstart &: int): bool:
if off + 2 > n:
ret false
end
tag = _bget(p, off)
l := _bget(p, off + 1)
mut start := off + 2
mut len := l
if l >= 0x80:
nb := l & 0x7F
if nb == 0 or nb > 3 or off + 2 + nb > n:
ret false
end
len = 0
repeat nb in i:
len = (len << 8) | _bget(p, off + 2 + i)
end
start = off + 2 + nb
end
if start + len > n:
ret false
end
dlen = len
cstart = start
ret true
end
func _der_ed25519(p: void*, n: int, pubout: void*, sigout: void*): bool:
mut tag := 0
mut cl := 0
mut cs := 0
if not _der_read(p, n, 0, tag, cl, cs) or tag != 0x30:
ret false
end
mut ts := 0
mut tl := 0
if not _der_read(p, n, cs, tag, tl, ts) or tag != 0x30:
ret false
end
mut o := ts + tl
mut al := 0
mut asx := 0
if not _der_read(p, n, o, tag, al, asx) or tag != 0x30:
ret false
end
o = asx + al
mut sl := 0
mut ss := 0
if not _der_read(p, n, o, tag, sl, ss) or tag != 0x03 or sl != 65 or _bget(p, ss) != 0:
ret false
end
repeat 64 in i:
_bput(sigout, i, _bget(p, ss + 1 + i))
end
mut e := ts
mut el := 0
mut es := 0
if not _der_read(p, n, e, tag, el, es):
ret false
end
if tag == 0xA0:
e = es + el
end
mut skip := 0
until skip < 5:
if not _der_read(p, n, e, tag, el, es):
ret false
end
e = es + el
skip++
end
mut kl := 0
mut ks := 0
if not _der_read(p, n, e, tag, kl, ks) or tag != 0x30:
ret false
end
mut gl := 0
mut gs := 0
if not _der_read(p, n, ks, tag, gl, gs) or tag != 0x30 or gl != 5:
ret false
end
if _bget(p, gs) != 0x06 or _bget(p, gs + 1) != 3 or _bget(p, gs + 2) != 0x2b or _bget(p, gs + 3) != 0x65 or _bget(p, gs + 4) != 0x70:
ret false
end
mut bl := 0
mut bs := 0
if not _der_read(p, n, gs + gl, tag, bl, bs) or tag != 0x03 or bl != 33 or _bget(p, bs) != 0:
ret false
end
repeat 32 in i:
_bput(pubout, i, _bget(p, bs + 1 + i))
end
ret true
end
func _raw_cv_verify_reality(h &: Handshake, msg: Reader, th: Buf, auth: void*, authlen: int): bool:
mut r := msg
scheme := _rd16(r)
sigr := _rdvec16(r)
if r.bad or _rdleft(r) != 0:
ret _hs_fail(h, "malformed CertificateVerify")
end
if scheme != 0x0807 or sigr.len != 64:
ret _hs_fail(h, "reality: server did not sign with ed25519")
end
mut pubk := _newbuf(32)
defer _buf_free(pubk)
_putzeros(pubk, 32)
mut cs := _newbuf(64)
defer _buf_free(cs)
_putzeros(cs, 64)
if not _der_ed25519(_bufptr(h.certs, _cert_start(h, 0)), _cert_len(h, 0), pubk.p, cs.p):
ret _hs_fail(h, "reality: certificate is not an ed25519 certificate")
end
mut mac := _newbuf(64)
defer _buf_free(mac)
_putzeros(mac, 64)
_hmac(HASH_SHA512, auth, authlen, pubk.p, 32, mac.p)
if not _cteq(mac.p, cs.p, 64):
ret _hs_fail(h, "reality: server certificate failed authentication")
end
mut sig := _newbuf(64)
defer _buf_free(sig)
repeat 64 in i:
_put8(sig, _rdat(sigr, i))
end
mut content := _newbuf(128)
defer _buf_free(content)
_hs_cv_content(h, th, content)
if not Ed25519Verify(pubk.p, content.p, content.len, sig.p):
ret _hs_fail(h, "reality: CertificateVerify signature invalid")
end
ret true
end
func _raw_client13(c &: Conn, h &: Handshake, cfg: Config, buf &: Buf, auth: void*, authlen: int): bool:
mut typ := 0
mut body := _newbuf(REC_MAX_PLAINTEXT)
defer _buf_free(body)
if not _hs_key_schedule(h):
ret _conn_fail(c, "key schedule failed")
end
_install_keys(h, h.s_hs_secret, h.c_hs_secret)
if not _hs_next_msg(h, buf, typ, body):
ret _conn_fail(c, h.err)
end
if typ != HS_ENCRYPTED_EXTENSIONS:
ret _conn_fail(c, "expected EncryptedExtensions")
end
if not _hs_next_msg(h, buf, typ, body):
ret _conn_fail(c, h.err)
end
mut cert_ctx := _newbuf(256)
defer _buf_free(cert_ctx)
mut cert_requested := false
if typ == HS_CERTIFICATE_REQUEST:
if body.len < 1 or _bufat(body, 0) + 1 > body.len:
ret _conn_fail(c, "malformed CertificateRequest")
end
repeat _bufat(body, 0) in i:
_put8(cert_ctx, _bufat(body, 1 + i))
end
cert_requested = true
if not _hs_next_msg(h, buf, typ, body):
ret _conn_fail(c, h.err)
end
end
if typ != HS_CERTIFICATE:
ret _conn_fail(c, "expected Certificate")
end
if not _hs_parse_certificate(h, _readerof(body)):
ret _conn_fail(c, h.err)
end
mut th_cv := _newbuf(64)
defer _buf_free(th_cv)
_hs_transcript(h, th_cv)
if not _hs_next_msg(h, buf, typ, body):
ret _conn_fail(c, h.err)
end
if typ != HS_CERTIFICATE_VERIFY:
ret _conn_fail(c, "expected CertificateVerify")
end
if authlen > 0:
if not _raw_cv_verify_reality(h, _readerof(body), th_cv, auth, authlen):
ret _conn_fail(c, h.err)
end
else:
if not _hs_verify_cert_verify(h, _readerof(body), th_cv):
ret _conn_fail(c, h.err)
end
if not _verify_peer_chain(c, h, cfg):
ret false
end
end
mut th_fin := _newbuf(64)
defer _buf_free(th_fin)
_hs_transcript(h, th_fin)
if not _hs_next_msg(h, buf, typ, body):
ret _conn_fail(c, h.err)
end
if typ != HS_FINISHED:
ret _conn_fail(c, "expected Finished")
end
mut expect := _newbuf(64)
defer _buf_free(expect)
if not _hs_finished_mac(h, h.s_hs_secret, th_fin, expect):
ret _conn_fail(c, "could not compute Finished MAC")
end
if body.len != expect.len or not _cteq(body.p, expect.p, expect.len):
_rec_send_alert(h.rec, 2, ALERT_DECRYPT_ERROR)
ret _conn_fail(c, "server Finished did not verify")
end
mut th_app := _newbuf(64)
defer _buf_free(th_app)
_hs_transcript(h, th_app)
if not _hs_derive(h, h.master, "c ap traffic", th_app, h.c_ap_secret):
ret _conn_fail(c, "could not derive client application secret")
end
if not _hs_derive(h, h.master, "s ap traffic", th_app, h.s_ap_secret):
ret _conn_fail(c, "could not derive server application secret")
end
mut ccs := _newbuf(1)
defer _buf_free(ccs)
_put8(ccs, 1)
_rec_write_plain(h.rec, REC_CHANGE_CIPHER_SPEC, ccs.p, 1)
if cert_requested:
mut ccert := _newbuf(16 + cert_ctx.len)
defer _buf_free(ccert)
_put8(ccert, HS_CERTIFICATE)
_put24(ccert, 1 + cert_ctx.len + 3)
_put8(ccert, cert_ctx.len)
_putbuf(ccert, cert_ctx)
_put24(ccert, 0)
_hash_update(h.tr, ccert.p, ccert.len)
if not _rec_write(h.rec, REC_HANDSHAKE, ccert.p, ccert.len):
ret _conn_fail(c, "could not send client Certificate")
end
end
mut th_cfin := _newbuf(64)
defer _buf_free(th_cfin)
_hs_transcript(h, th_cfin)
mut cfin := _newbuf(64)
defer _buf_free(cfin)
if not _hs_finished_mac(h, h.c_hs_secret, th_cfin, cfin):
ret _conn_fail(c, "could not compute client Finished")
end
mut fmsg := _newbuf(64)
defer _buf_free(fmsg)
_put8(fmsg, HS_FINISHED)
_put24(fmsg, cfin.len)
_putbuf(fmsg, cfin)
if not _rec_write(h.rec, REC_HANDSHAKE, fmsg.p, fmsg.len):
ret _conn_fail(c, "could not send Finished")
end
_install_keys(h, h.s_ap_secret, h.c_ap_secret)
h.ok = true
c.open = true
ret true
end
func _raw_client(c &: Conn, hello: void*, hlen: int, xpriv: void*, pq_seed: void*, auth: void*, authlen: int, cfg: Config): bool:
mut h := c.h
if pq_seed != null:
h.pq_seed = _newbuf(64)
_putraw(h.pq_seed, pq_seed, 64)
end
_bufreset(h.priv)
_putraw(h.priv, xpriv, 32)
h.share_group = GROUP_X25519
_bufreset(h.pub_key)
_putzeros(h.pub_key, 32)
_x25519_base(h.priv.p, h.pub_key.p)
mut rec := _newbuf(hlen + 5)
defer _buf_free(rec)
_put8(rec, REC_HANDSHAKE)
_put16(rec, TLS10)
_put16(rec, hlen)
_putraw(rec, hello, hlen)
_putraw(h.rec.tx, rec.p, rec.len)
if not _rec_flush(h.rec):
c.h = h
ret _conn_fail(c, "could not send ClientHello: " + h.rec.err)
end
mut frag := _newbuf(REC_MAX_PLAINTEXT)
defer _buf_free(frag)
mut shlen := 0
mut sherr := ""
if not _read_server_hello(h, frag, shlen, sherr):
c.h = h
ret _conn_fail(c, sherr)
end
if not _hs_parse_server_hello(h, _newreader(_bufptr(frag, 4), shlen)):
c.h = h
ret _conn_fail(c, h.err)
end
if h.hrr:
c.h = h
ret _conn_fail(c, "server sent a HelloRetryRequest, which a custom ClientHello cannot answer")
end
if h.ver != TLS13:
c.h = h
ret _conn_fail(c, "server did not select TLS 1.3")
end
h.tr = _hash_init(h.hash)
_hash_update(h.tr, hello, hlen)
_hash_update(h.tr, frag.p, 4 + shlen)
mut buf := _newbuf(REC_MAX_PLAINTEXT)
defer _buf_free(buf)
if frag.len > 4 + shlen:
_putraw(buf, _bufptr(frag, 4 + shlen), frag.len - (4 + shlen))
end
ok := _raw_client13(c, h, cfg, buf, auth, authlen)
c.h = h
ret ok
end
func _raw_server13(c &: Conn, h &: Handshake, chi: ClientHelloInfo, suite: int, cert: void*, certlen: int, seed: void*): bool:
mut buf := _newbuf(REC_MAX_PLAINTEXT)
defer _buf_free(buf)
if not _hs_server_kx(h, chi.kx_group, chi.kx_pub):
ret _conn_fail(c, "key exchange failed")
end
mut sh := _newbuf(256)
defer _buf_free(sh)
if not _hs_build_server_hello(h, chi, suite, true, sh):
ret _conn_fail(c, "could not build ServerHello")
end
_hash_update(h.tr, sh.p, sh.len)
if not _rec_write(h.rec, REC_HANDSHAKE, sh.p, sh.len):
ret _conn_fail(c, "could not send ServerHello")
end
mut ccs := _newbuf(1)
defer _buf_free(ccs)
_put8(ccs, 1)
_rec_write_plain(h.rec, REC_CHANGE_CIPHER_SPEC, ccs.p, 1)
if not _hs_key_schedule(h):
ret _conn_fail(c, "key schedule failed")
end
_install_keys(h, h.c_hs_secret, h.s_hs_secret)
mut ee := _newbuf(64)
defer _buf_free(ee)
_hs_build_encrypted_extensions(ee)
_hash_update(h.tr, ee.p, ee.len)
if not _rec_write(h.rec, REC_HANDSHAKE, ee.p, ee.len):
ret _conn_fail(c, "could not send EncryptedExtensions")
end
mut certmsg := _newbuf(certlen + 16)
defer _buf_free(certmsg)
_put8(certmsg, HS_CERTIFICATE)
_put24(certmsg, certlen + 9)
_put8(certmsg, 0)
_put24(certmsg, certlen + 5)
_put24(certmsg, certlen)
_putraw(certmsg, cert, certlen)
_put16(certmsg, 0)
_hash_update(h.tr, certmsg.p, certmsg.len)
if not _rec_write(h.rec, REC_HANDSHAKE, certmsg.p, certmsg.len):
ret _conn_fail(c, "could not send Certificate")
end
mut th_cv := _newbuf(64)
defer _buf_free(th_cv)
_hs_transcript(h, th_cv)
mut content := _newbuf(128)
defer _buf_free(content)
_hs_cv_content(h, th_cv, content)
mut sig := _newbuf(64)
defer _buf_free(sig)
_putzeros(sig, 64)
Ed25519Sign(seed, content.p, content.len, sig.p)
mut cv := _newbuf(96)
defer _buf_free(cv)
_put8(cv, HS_CERTIFICATE_VERIFY)
_put24(cv, 68)
_put16(cv, 0x0807)
_put16(cv, 64)
_putbuf(cv, sig)
_hash_update(h.tr, cv.p, cv.len)
if not _rec_write(h.rec, REC_HANDSHAKE, cv.p, cv.len):
ret _conn_fail(c, "could not send CertificateVerify")
end
mut th_fin := _newbuf(64)
defer _buf_free(th_fin)
_hs_transcript(h, th_fin)
mut sfin := _newbuf(64)
defer _buf_free(sfin)
if not _hs_finished_mac(h, h.s_hs_secret, th_fin, sfin):
ret _conn_fail(c, "could not compute server Finished")
end
mut sfmsg := _newbuf(64)
defer _buf_free(sfmsg)
_put8(sfmsg, HS_FINISHED)
_put24(sfmsg, sfin.len)
_putbuf(sfmsg, sfin)
_hash_update(h.tr, sfmsg.p, sfmsg.len)
if not _rec_write(h.rec, REC_HANDSHAKE, sfmsg.p, sfmsg.len):
ret _conn_fail(c, "could not send server Finished")
end
mut th_app := _newbuf(64)
defer _buf_free(th_app)
_hs_transcript(h, th_app)
if not _hs_derive(h, h.master, "c ap traffic", th_app, h.c_ap_secret):
ret _conn_fail(c, "could not derive client application secret")
end
if not _hs_derive(h, h.master, "s ap traffic", th_app, h.s_ap_secret):
ret _conn_fail(c, "could not derive server application secret")
end
mut typ := 0
mut cfinbody := _newbuf(64)
defer _buf_free(cfinbody)
if not _hs_next_msg(h, buf, typ, cfinbody):
ret _conn_fail(c, h.err)
end
if typ != HS_FINISHED:
ret _conn_fail(c, "expected client Finished")
end
mut want := _newbuf(64)
defer _buf_free(want)
if not _hs_finished_mac(h, h.c_hs_secret, th_app, want):
ret _conn_fail(c, "could not compute expected client Finished")
end
if cfinbody.len != want.len or not _cteq(cfinbody.p, want.p, want.len):
_rec_send_alert(h.rec, 2, ALERT_DECRYPT_ERROR)
ret _conn_fail(c, "client Finished did not verify")
end
_install_keys(h, h.c_ap_secret, h.s_ap_secret)
h.ok = true
c.open = true
ret true
end
func _raw_server(c &: Conn, ch: void*, chlen: int, cert: void*, certlen: int, seed: void*): bool:
mut h := c.h
if chlen < 4 or _bget(ch, 0) != HS_CLIENT_HELLO:
c.h = h
ret _conn_fail(c, "expected ClientHello")
end
mut chi := _hs_parse_client_hello(_newreader(((ch as i64) + 4) as void*, chlen - 4))
defer _chi_free(chi)
if not chi.ok or not chi.want_tls13 or chi.kx_group != GROUP_X25519:
c.h = h
ret _conn_fail(c, "ClientHello is not usable for TLS 1.3 with x25519")
end
_bufreset(h.crand)
_putbuf(h.crand, chi.crand)
suite := _pick_suite13(chi)
if suite == 0:
c.h = h
ret _conn_fail(c, "no common TLS 1.3 cipher suite")
end
h.ver = TLS13
h.suite = suite
h.cipher = _cipher_from_wire(suite)
h.hash = _cipher_hash(h.cipher)
h.hlen = _hash_size(h.hash)
h.tr = _hash_init(h.hash)
_hash_update(h.tr, ch, chlen)
ok := _raw_server13(c, h, chi, suite, cert, certlen, seed)
c.h = h
ret ok
end
@en "WrapClientRaw"
@fa "پوشش کارخواه با سلام خام"
pub func WrapClientRaw(fd: i64, hello: void*, hlen: int, xpriv: void*, auth: void*, authlen: int, cfg: Config): Conn:
ret WrapClientRawPq(fd, hello, hlen, xpriv, null, auth, authlen, cfg)
end
@en "WrapClientRawPq"
@fa "پوشش کارخواه خام پسا کوانتومی"
pub func WrapClientRawPq(fd: i64, hello: void*, hlen: int, xpriv: void*, pq_seed: void*, auth: void*, authlen: int, cfg: Config): Conn:
mut c := _raw_new(fd)
c.insecure = cfg.insecure_skip_verify
c.host = cfg.server_name
if fd < 0:
c.err = "invalid fd"
ret c
end
c.h.rec.read_deadline_ms = HANDSHAKE_READ_TIMEOUT_MS
_raw_client(c, hello, hlen, xpriv, pq_seed, auth, authlen, cfg)
c.h.rec.read_deadline_ms = 0
_rec_uncork(c.h.rec)
ret c
end
@en "X25519Public"
@fa "کلید عمومی ایکس۲۵۵۱۹"
pub func X25519Public(priv: void*, out: void*):
_x25519_base(priv, out)
end
@en "X25519Shared"
@fa "راز مشترک ایکس۲۵۵۱۹"
pub func X25519Shared(priv: void*, peer: void*, out: void*): bool:
ret _x25519_shared(priv, peer, out)
end
@en "HkdfSha256Derive"
@fa "اشتقاق اچ کی دی اف"
pub func HkdfSha256Derive(ikm: void*, ikmlen: int, salt: void*, saltlen: int, info: str, out: void*, outlen: int): bool:
mut prk := _newbuf(32)
defer _buf_wipe(prk)
_putzeros(prk, 32)
_hkdf_extract(HASH_SHA256, salt, saltlen, ikm, ikmlen, prk.p)
ret _hkdf_expand(HASH_SHA256, prk.p, 32, info as void*, info.len(), out, outlen)
end
@en "HmacSha512Raw"
@fa "اچ مک شا۵۱۲ خام"
pub func HmacSha512Raw(key: void*, klen: int, msg: void*, mlen: int, out: void*):
_hmac(HASH_SHA512, key, klen, msg, mlen, out)
end
@en "WrapServerRaw"
@fa "پوشش کارساز با سلام خام"
pub func WrapServerRaw(fd: i64, ch: void*, chlen: int, cert: void*, certlen: int, seed: void*): Conn:
mut c := _raw_new(fd)
c.h.rec.read_deadline_ms = HANDSHAKE_READ_TIMEOUT_MS
_raw_server(c, ch, chlen, cert, certlen, seed)
c.h.rec.read_deadline_ms = 0
_rec_uncork(c.h.rec)
if SALAM_OS_LINUX:
if c.open:
_rec_ack_now(c.h.rec)
end
end
ret c
end
package tls
import mem
import net.internal.rawsock
const REC_CHANGE_CIPHER_SPEC := 20
const REC_ALERT := 21
const REC_HANDSHAKE := 22
const REC_APPLICATION_DATA := 23
const REC_MAX_PLAINTEXT := 16384
const REC_MAX_CIPHERTEXT := 16640
const REC_HEADER := 5
const REC_RX_CAP := 16645 + 16384
const REC_SEAL_ROOM := 64
const REC_TX_BATCH := 33024
const REC_IPPROTO_TCP := 6
const REC_TCP_QUICKACK := 12
const CIPHER_NONE := 0
const CIPHER_AES128_GCM_SHA256 := 1
const CIPHER_CHACHA20_SHA256 := 2
const CIPHER_AES256_GCM_SHA384 := 3
const TLS_AES_128_GCM_SHA256 := 0x1301
const TLS_AES_256_GCM_SHA384 := 0x1302
const TLS_CHACHA20_POLY1305_SHA256 := 0x1303
const ALERT_CLOSE_NOTIFY := 0
const ALERT_UNEXPECTED_MESSAGE := 10
const ALERT_BAD_RECORD_MAC := 20
const ALERT_HANDSHAKE_FAILURE := 40
const ALERT_BAD_CERTIFICATE := 42
const ALERT_CERTIFICATE_EXPIRED := 45
const ALERT_CERTIFICATE_UNKNOWN := 46
const ALERT_ILLEGAL_PARAMETER := 47
const ALERT_DECODE_ERROR := 50
const ALERT_DECRYPT_ERROR := 51
const ALERT_PROTOCOL_VERSION := 70
const ALERT_INTERNAL_ERROR := 80
const HANDSHAKE_READ_TIMEOUT_MS := 10000
struct RecordLayer:
pub fd: i64 = 0 - 1
pub rx: Buf = Buf {}
pub rpos: int = 0
pub tx: Buf = Buf {}
pub corked: bool = false
pub rnonce: Buf = Buf {}
pub raad: Buf = Buf {}
pub tnonce: Buf = Buf {}
pub taad: Buf = Buf {}
pub rxk: TrafficKeys = TrafficKeys {}
pub txk: TrafficKeys = TrafficKeys {}
pub eof: bool = false
pub failed: bool = false
pub err: str = ""
pub read_deadline_ms: int = 0
pub frag_tls: bool = false
pub frag_tcp: bool = false
pub frag_sni: bool = false
pub frag_min: int = 5
pub frag_max: int = 20
pub frag_delay_ms: int = 0
pub frag_left: int = 0
end
func _rec_new(fd: i64): RecordLayer:
mut r := RecordLayer {}
r.fd = fd
r.rx = _newbuf(REC_RX_CAP)
r.tx = _newbuf(REC_MAX_PLAINTEXT + REC_SEAL_ROOM)
r.rnonce = _newbuf(12)
r.raad = _newbuf(16)
r.tnonce = _newbuf(12)
r.taad = _newbuf(16)
r.corked = true
ret r
end
func _rec_free(r &: RecordLayer):
_buf_wipe(r.rx)
_buf_wipe(r.tx)
_buf_free(r.rnonce)
_buf_free(r.raad)
_buf_free(r.tnonce)
_buf_free(r.taad)
_tk_free(r.rxk)
_tk_free(r.txk)
end
func _rec_fail(r &: RecordLayer, msg: str):
if not r.failed:
r.failed = true
r.err = msg
end
end
func _rec_flush(r &: RecordLayer): bool:
if r.tx.len == 0:
ret true
end
n := r.tx.len
if r.frag_left > 0:
r.frag_left--
ok := _rec_flush_fragmented(r)
r.tx.len = 0
ret ok
end
sent := rawsock.SendBytes(rawsock.FromFd(r.fd), r.tx.p, n)
r.tx.len = 0
if sent != n:
_rec_fail(r, "short write")
ret false
end
ret true
end
func _rec_uncork(r &: RecordLayer): bool:
r.corked = false
ret _rec_flush(r)
end
if SALAM_OS_LINUX:
func _rec_ack_now(r: RecordLayer):
opt := mem.Allocate(4 as u64) as int*
opt[0] = 1
rawsock.SetOpt(rawsock.FromFd(r.fd), REC_IPPROTO_TCP, REC_TCP_QUICKACK, opt as void*, 4)
mem.Free(opt as void*)
end
end
func _rec_fill(r &: RecordLayer): bool:
if r.corked and not _rec_flush(r):
r.eof = true
ret false
end
if r.read_deadline_ms > 0:
if not rawsock.WaitReadable(rawsock.FromFd(r.fd), r.read_deadline_ms):
_rec_fail(r, "timed out waiting for the peer")
r.eof = true
ret false
end
end
n := rawsock.RecvBytes(rawsock.FromFd(r.fd), _bufptr(r.rx, r.rx.len), r.rx.cap - r.rx.len)
if n <= 0:
r.eof = true
ret false
end
r.rx.len += n
ret true
end
func _rec_need(r &: RecordLayer, n: int): bool:
if r.rx.len - r.rpos >= n:
ret true
end
if r.rpos > 0:
left := r.rx.len - r.rpos
if left > 0:
mem.MemMove(r.rx.p, _bufptr(r.rx, r.rpos), left as u64)
end
r.rx.len = left
r.rpos = 0
end
until r.rx.len < n:
if not _rec_fill(r):
ret false
end
end
ret true
end
func _rec_read_raw(r &: RecordLayer, buf: void*, max: int): int:
left := r.rx.len - r.rpos
if left > 0:
mut take := max
if take > left:
take = left
end
mem.Copy(buf, _bufptr(r.rx, r.rpos), take as u64)
r.rpos += take
ret take
end
if r.eof:
ret 0
end
if r.read_deadline_ms > 0:
if not rawsock.WaitReadable(rawsock.FromFd(r.fd), r.read_deadline_ms):
_rec_fail(r, "timed out waiting for the peer")
r.eof = true
ret 0
end
end
n := rawsock.RecvBytes(rawsock.FromFd(r.fd), buf, max)
if n <= 0:
r.eof = true
ret 0
end
ret n
end
func _rec_buffered(r: RecordLayer): int:
left := r.rx.len - r.rpos
if left < REC_HEADER:
ret 0
end
length := (_bget(r.rx.p, r.rpos + 3) << 8) | _bget(r.rx.p, r.rpos + 4)
if left < REC_HEADER + length:
ret 0
end
ret left
end
func _rec_open(r &: RecordLayer, typ &: int, out &: void*, out_len &: int): bool:
out = null
out_len = 0
if r.failed:
ret false
end
if not _rec_need(r, REC_HEADER):
ret false
end
ctype := _bget(r.rx.p, r.rpos)
length := (_bget(r.rx.p, r.rpos + 3) << 8) | _bget(r.rx.p, r.rpos + 4)
if length > REC_MAX_CIPHERTEXT:
_rec_fail(r, "record too large")
ret false
end
if not _rec_need(r, REC_HEADER + length):
_rec_fail(r, "truncated record")
ret false
end
base := r.rpos
body := _bufptr(r.rx, base + REC_HEADER)
r.rpos = base + REC_HEADER + length
if not r.rxk.live:
out = body
out_len = length
typ = ctype
ret true
end
if ctype == REC_CHANGE_CIPHER_SPEC:
typ = REC_CHANGE_CIPHER_SPEC
ret true
end
if length < 17:
_rec_fail(r, "encrypted record shorter than its tag")
ret false
end
if r.rxk.is12:
exp := r.rxk.explicit_len
if length < exp + 17:
_rec_fail(r, "encrypted record too short")
ret false
end
content_len := length - exp - 16
_bufreset(r.rnonce)
if exp > 0:
_putraw(r.rnonce, r.rxk.iv.p, 4)
_putraw(r.rnonce, body, 8)
else:
_putzeros(r.rnonce, 12)
_tk_nonce(r.rxk, r.rnonce)
end
_tk12_aad(r.rxk.seq, ctype, content_len, r.raad)
cp := ((body as i64) + (exp as i64)) as void*
tp := ((cp as i64) + (content_len as i64)) as void*
if not _aead_open(r.rxk, r.rnonce, r.raad.p, r.raad.len, cp, content_len, tp, cp):
_rec_fail(r, "bad record MAC")
ret false
end
if not _tk_advance(r.rxk):
_rec_fail(r, "sequence number exhausted")
ret false
end
out = cp
out_len = content_len
typ = ctype
ret true
end
ctlen := length - 16
_bufreset(r.rnonce)
_putzeros(r.rnonce, 12)
_tk_nonce(r.rxk, r.rnonce)
tagp := ((body as i64) + (ctlen as i64)) as void*
if not _aead_open(r.rxk, r.rnonce, _bufptr(r.rx, base), REC_HEADER, body, ctlen, tagp, body):
_rec_fail(r, "bad record MAC")
ret false
end
if not _tk_advance(r.rxk):
_rec_fail(r, "sequence number exhausted")
ret false
end
mut last := ctlen - 1
until last >= 0 and _bget(body, last) == 0:
last--
end
if last < 0:
_rec_fail(r, "record with no content type")
ret false
end
typ = _bget(body, last)
out = body
out_len = last
ret true
end
func _rec_read(r &: RecordLayer, typ &: int, out &: Buf): bool:
mut p := null as void*
mut n := 0
if not _rec_open(r, typ, p, n):
ret false
end
_bufreset(out)
_putraw(out, p, n)
ret true
end
func _rec_header(r &: RecordLayer, typ: int, body_len: int):
_put8(r.tx, typ)
_put16(r.tx, TLS12)
_put16(r.tx, body_len)
end
func _rec_append_plain(r &: RecordLayer, typ: int, p: void*, n: int):
_rec_header(r, typ, n)
_putraw(r.tx, p, n)
end
func _rec_append(r &: RecordLayer, typ: int, p: void*, n: int): bool:
_buf_grow(r.tx, n + REC_SEAL_ROOM)
if r.tx.bad:
_rec_fail(r, "out of memory")
ret false
end
if not r.txk.live:
_rec_append_plain(r, typ, p, n)
ret true
end
if r.txk.is12:
exp := r.txk.explicit_len
_rec_header(r, typ, exp + n + 16)
_bufreset(r.tnonce)
_putzeros(r.tnonce, 12)
_tk_nonce(r.txk, r.tnonce)
if exp > 0:
_putraw(r.tx, _bufptr(r.tnonce, 4), 8)
end
_tk12_aad(r.txk.seq, typ, n, r.taad)
ctp := _bufptr(r.tx, r.tx.len)
_aead_seal(r.txk, r.tnonce, r.taad.p, r.taad.len, p, ctp, n, ((ctp as i64) + (n as i64)) as void*)
r.tx.len += n + 16
else:
hdr := _bufptr(r.tx, r.tx.len)
_rec_header(r, REC_APPLICATION_DATA, n + 17)
ctp := _bufptr(r.tx, r.tx.len)
if n > 0:
mem.Copy(ctp, p, n as u64)
end
_bput(ctp, n, typ)
_bufreset(r.tnonce)
_putzeros(r.tnonce, 12)
_tk_nonce(r.txk, r.tnonce)
_aead_seal(r.txk, r.tnonce, hdr, REC_HEADER, ctp, ctp, n + 1, ((ctp as i64) + ((n + 1) as i64)) as void*)
r.tx.len += n + 17
end
if not _tk_advance(r.txk):
_rec_fail(r, "sequence number exhausted")
ret false
end
ret true
end
func _rec_write(r &: RecordLayer, typ: int, p: void*, n: int): bool:
if r.failed:
ret false
end
if n == 0:
if not _rec_append(r, typ, p, 0):
ret false
end
end
mut off := 0
until off < n:
mut take := n - off
if take > REC_MAX_PLAINTEXT:
take = REC_MAX_PLAINTEXT
end
if r.tx.len > 0 and r.tx.len + take + REC_SEAL_ROOM > REC_TX_BATCH:
if not _rec_flush(r):
ret false
end
end
if not _rec_append(r, typ, ((p as i64) + (off as i64)) as void*, take):
ret false
end
off += take
end
if r.corked:
ret true
end
ret _rec_flush(r)
end
func _rec_write_plain(r &: RecordLayer, typ: int, p: void*, n: int): bool:
_rec_append_plain(r, typ, p, n)
if r.corked:
ret true
end
ret _rec_flush(r)
end
func _rec_send_alert(r &: RecordLayer, level: int, desc: int):
mut a := _newbuf(2)
defer _buf_free(a)
_put8(a, level)
_put8(a, desc)
_rec_write(r, REC_ALERT, a.p, 2)
_rec_flush(r)
end
package tls
if SALAM_OS_WIN64:
link dynamic "crypt32"
extern:
func CertOpenSystemStoreA(hprov: i64, subsystem: str): void*
func CertEnumCertificatesInStore(store: void*, prev: void*): void*
func CertCloseStore(store: void*, flags: int): int
end
else:
if SALAM_OS_MAC:
link framework "Security"
link framework "CoreFoundation"
extern:
func SecTrustCopyAnchorCertificates(anchors: void*): int
func CFArrayGetCount(arr: void*): i64
func CFArrayGetValueAtIndex(arr: void*, idx: i64): void*
func SecCertificateCopyData(cert: void*): void*
func CFDataGetBytePtr(data: void*): void*
func CFDataGetLength(data: void*): i64
func CFRelease(obj: void*)
