struct FastGcm:
pub rk: u32* = null
pub ht: u64* = null
pub nr: int = 0
end
struct FgY:
pub hi: u64 = 0 as u64
pub lo: u64 = 0 as u64
end
inline func _fg_sub(x: u32): u32:
ret ((FG_SBOX[((x >> (24 as u32)) & (255 as u32)) as int] as u32) << (24 as u32)) | ((FG_SBOX[((x >> (16 as u32)) & (255 as u32)) as int] as u32) << (16 as u32)) | ((FG_SBOX[((x >> (8 as u32)) & (255 as u32)) as int] as u32) << (8 as u32)) | (FG_SBOX[(x & (255 as u32)) as int] as u32)
end
inline func _fg_be32(p: void*, o: int): u32:
bp := p as u8*
ret ((bp[o] as u32) << (24 as u32)) | ((bp[o + 1] as u32) << (16 as u32)) | ((bp[o + 2] as u32) << (8 as u32)) | (bp[o + 3] as u32)
end
inline func _fg_pbe32(v: u32, p: void*, o: int):
bp := p as u8*
bp[o] = (v >> (24 as u32)) as u8
bp[o + 1] = (v >> (16 as u32)) as u8
bp[o + 2] = (v >> (8 as u32)) as u8
bp[o + 3] = v as u8
end
inline func _fg_step(ht: u64*, z &: FgY, b: u64):
rem := (z.lo & (255 as u64)) as int
z.lo = (z.hi << (56 as u64)) | (z.lo >> (8 as u64))
z.hi = (z.hi >> (8 as u64)) ^ FG_REM[rem]
i := (b as int) * 2
z.hi ^= ht[i]
z.lo ^= ht[i + 1]
end
inline func _fg_word(ht: u64*, z &: FgY, x: u64):
mut w := x
repeat 8:
_fg_step(ht, z, w & (255 as u64))
w >>= (8 as u64)
end
end
inline func _fg_mix(ht: u64*, y &: FgY, bhi: u64, blo: u64):
mut z := FgY {}
_fg_word(ht, z, y.lo ^ blo)
_fg_word(ht, z, y.hi ^ bhi)
y.hi = z.hi
y.lo = z.lo
end
func _fg_ghash(ht: u64*, y &: FgY, p: void*, n: int):
mut off := 0
until n - off >= 16:
_fg_mix(ht, y, _be64(p, off), _be64(p, off + 8))
off += 16
end
if off < n:
bp := p as u8*
mut w1 := 0 as u64
mut w0 := 0 as u64
repeat n - off in i:
if i < 8:
w1 |= ((bp[off + i] as u64) << ((56 - i * 8) as u64))
else:
w0 |= ((bp[off + i] as u64) << ((120 - i * 8) as u64))
end
end
_fg_mix(ht, y, w1, w0)
end
end
func _fg_block(c: FastGcm*, s0i: u32, s1i: u32, s2i: u32, s3i: u32, out: void*, o: int):
rk := c.rk
mut s0 := s0i ^ rk[0]
mut s1 := s1i ^ rk[1]
mut s2 := s2i ^ rk[2]
mut s3 := s3i ^ rk[3]
mut r := 1
until r < c.nr:
k := r * 4
t0 := FG_TE0[(s0 >> (24 as u32)) as int] ^ FG_TE1[((s1 >> (16 as u32)) & (255 as u32)) as int] ^ FG_TE2[((s2 >> (8 as u32)) & (255 as u32)) as int] ^ FG_TE3[(s3 & (255 as u32)) as int] ^ rk[k]
t1 := FG_TE0[(s1 >> (24 as u32)) as int] ^ FG_TE1[((s2 >> (16 as u32)) & (255 as u32)) as int] ^ FG_TE2[((s3 >> (8 as u32)) & (255 as u32)) as int] ^ FG_TE3[(s0 & (255 as u32)) as int] ^ rk[k + 1]
t2 := FG_TE0[(s2 >> (24 as u32)) as int] ^ FG_TE1[((s3 >> (16 as u32)) & (255 as u32)) as int] ^ FG_TE2[((s0 >> (8 as u32)) & (255 as u32)) as int] ^ FG_TE3[(s1 & (255 as u32)) as int] ^ rk[k + 2]
t3 := FG_TE0[(s3 >> (24 as u32)) as int] ^ FG_TE1[((s0 >> (16 as u32)) & (255 as u32)) as int] ^ FG_TE2[((s1 >> (8 as u32)) & (255 as u32)) as int] ^ FG_TE3[(s2 & (255 as u32)) as int] ^ rk[k + 3]
s0 = t0
s1 = t1
s2 = t2
s3 = t3
r++
end
k := c.nr * 4
_fg_pbe32(_fg_sub4(s0, s1, s2, s3) ^ rk[k], out, o)
_fg_pbe32(_fg_sub4(s1, s2, s3, s0) ^ rk[k + 1], out, o + 4)
_fg_pbe32(_fg_sub4(s2, s3, s0, s1) ^ rk[k + 2], out, o + 8)
_fg_pbe32(_fg_sub4(s3, s0, s1, s2) ^ rk[k + 3], out, o + 12)
end
inline func _fg_sub4(a: u32, b: u32, c: u32, d: u32): u32:
ret ((FG_SBOX[(a >> (24 as u32)) as int] as u32) << (24 as u32)) | ((FG_SBOX[((b >> (16 as u32)) & (255 as u32)) as int] as u32) << (16 as u32)) | ((FG_SBOX[((c >> (8 as u32)) & (255 as u32)) as int] as u32) << (8 as u32)) | (FG_SBOX[(d & (255 as u32)) as int] as u32)
end
func _fg_new(key: void*, keylen: int): FastGcm*:
if keylen != 16 and keylen != 32:
ret null
end
c := mem.AllocateZeroed(sizeof(FastGcm) as u64) as FastGcm*
c.nr = keylen == 16 ? 10 : 14
nk := keylen / 4
total := (c.nr + 1) * 4
mem_ := mem.AllocateZeroed(4352 as u64)
c.rk = mem_ as u32*
c.ht = ((mem_ as i64) + (256 as i64)) as u64*
rk := c.rk
repeat nk in i:
rk[i] = _fg_be32(key, i * 4)
end
mut i := nk
until i < total:
mut t := rk[i - 1]
if i % nk == 0:
t = _fg_sub((t << (8 as u32)) | (t >> (24 as u32))) ^ ((FG_RCON[i / nk - 1] as u32) << (24 as u32))
else nk > 6 and i % nk == 4:
t = _fg_sub(t)
end
rk[i] = rk[i - nk] ^ t
i++
end
hb := mem.AllocateZeroed(16 as u64)
_fg_block(c, 0 as u32, 0 as u32, 0 as u32, 0 as u32, hb, 0)
mut vh := _be64(hb, 0)
mut vl := _be64(hb, 8)
mem.Free(hb)
ht := c.ht
ht[256] = vh
ht[257] = vl
mut k := 64
until k > 0:
t := (vl & (1 as u64)) * (0xE100000000000000 as u64)
vl = (vh << (63 as u64)) | (vl >> (1 as u64))
vh = (vh >> (1 as u64)) ^ t
ht[k * 2] = vh
ht[k * 2 + 1] = vl
k >>= 1
end
mut a := 2
until a < 256:
repeat a - 1 in j:
b := j + 1
ht[(a + b) * 2] = ht[a * 2] ^ ht[b * 2]
ht[(a + b) * 2 + 1] = ht[a * 2 + 1] ^ ht[b * 2 + 1]
end
a <<= 1
end
ret c
end
func _fg_free(c: FastGcm*):
if c == null:
ret
end
_wipe(c.rk as void*, 4352)
mem.Free(c.rk as void*)
_wipe(c as void*, sizeof(FastGcm) as int)
mem.Free(c as void*)
end
func _fg_ctr(c: FastGcm*, nonce: void*, first: int, inp: void*, out: void*, n: int):
n0 := _fg_be32(nonce, 0)
n1 := _fg_be32(nonce, 4)
n2 := _fg_be32(nonce, 8)
mut ctr := first as u32
ks := mem.AllocateZeroed(16 as u64)
mut off := 0
until off < n:
_fg_block(c, n0, n1, n2, ctr, ks, 0)
ctr++
left := n - off
if left >= 16:
ip := ((inp as i64) + (off as i64)) as void*
op := ((out as i64) + (off as i64)) as void*
_ple64(_le64(ip, 0) ^ _le64(ks, 0), op, 0)
_ple64(_le64(ip, 8) ^ _le64(ks, 8), op, 8)
off += 16
else:
ib := inp as u8*
kb := ks as u8*
ob := out as u8*
repeat left in j:
ob[off + j] = ib[off + j] ^ (kb[j])
end
off += left
end
end
_wipe(ks, 16)
mem.Free(ks)
end
func _fg_tag(c: FastGcm*, nonce: void*, aad: void*, aadlen: int, ct: void*, n: int, mask &: FgY):
mut y := FgY {}
if aadlen > 0:
_fg_ghash(c.ht, y, aad, aadlen)
end
if n > 0:
_fg_ghash(c.ht, y, ct, n)
end
_fg_mix(c.ht, y, (aadlen as u64) * (8 as u64), (n as u64) * (8 as u64))
m := mem.AllocateZeroed(16 as u64)
_fg_block(c, _fg_be32(nonce, 0), _fg_be32(nonce, 4), _fg_be32(nonce, 8), 1 as u32, m, 0)
mask.hi = y.hi ^ _be64(m, 0)
mask.lo = y.lo ^ _be64(m, 8)
mem.Free(m)
end
func _fg_seal(c: FastGcm*, nonce: void*, aad: void*, aadlen: int, pt: void*, ct: void*, n: int, tag: void*):
_fg_ctr(c, nonce, 2, pt, ct, n)
mut t := FgY {}
_fg_tag(c, nonce, aad, aadlen, ct, n, t)
_pbe64(t.hi, tag, 0)
_pbe64(t.lo, tag, 8)
end
func _fg_open(c: FastGcm*, nonce: void*, aad: void*, aadlen: int, ct: void*, n: int, tag: void*, pt: void*): bool:
mut t := FgY {}
_fg_tag(c, nonce, aad, aadlen, ct, n, t)
d1 := t.hi ^ _be64(tag, 0)
d0 := t.lo ^ _be64(tag, 8)
if (d1 | d0) != (0 as u64):
ret false
end
_fg_ctr(c, nonce, 2, ct, pt, n)
ret true
end
package tls
const ASN1_BOOLEAN := 0x01
const ASN1_INTEGER := 0x02
const ASN1_BITSTRING := 0x03
const ASN1_OCTETSTRING := 0x04
const ASN1_NULL := 0x05
const ASN1_OID := 0x06
const ASN1_UTF8STRING := 0x0C
const ASN1_PRINTABLESTRING := 0x13
const ASN1_T61STRING := 0x14
const ASN1_IA5STRING := 0x16
const ASN1_UTCTIME := 0x17
const ASN1_GENERALIZEDTIME := 0x18
const ASN1_SEQUENCE := 0x30
const ASN1_SET := 0x31
const ASN1_CTX0 := 0xA0
const ASN1_CTX1 := 0xA1
const ASN1_CTX2 := 0xA2
const ASN1_CTX3 := 0xA3
struct Tlv:
pub tag: int = 0
pub body: Reader = Reader {}
pub full: Reader = Reader {}
pub ok: bool = false
end
func _der(r &: Reader): Tlv:
mut t := Tlv {}
if r.bad:
ret t
end
start := r.pos
tag := _rd8(r)
if r.bad:
ret t
end
if (tag & 0x1F) == 0x1F:
r.bad = true
ret t
end
first := _rd8(r)
if r.bad:
ret t
end
mut length := 0
if first < 0x80:
length = first
else:
nbytes := first & 0x7F
if nbytes == 0:
r.bad = true
ret t
end
if nbytes > 4:
r.bad = true
ret t
end
mut v := 0
repeat nbytes:
v = (v << 8) | _rd8(r)
end
if r.bad:
ret t
end
if v < 0x80:
r.bad = true
ret t
end
if nbytes > 1 and v < (1 << (8 * (nbytes - 1))):
r.bad = true
ret t
end
if v < 0:
r.bad = true
ret t
end
length = v
end
body := _rdbytes(r, length)
if r.bad:
ret t
end
t.tag = tag
t.body = body
t.full = _subreader(r, start, r.pos - start)
t.ok = true
ret t
end
func _der_tag(r &: Reader, want: int): Tlv:
mut t := _der(r)
if not t.ok:
ret t
end
if t.tag != want:
r.bad = true
t.ok = false
end
ret t
end
func _der_peek(r: Reader): int:
if r.bad or r.pos >= r.len:
ret 0 - 1
end
ret _rdat(r, r.pos)
end
func _der_is(r: Reader, tag: int): bool:
ret _der_peek(r) == tag
end
func _der_seq(r &: Reader): Reader:
t := _der_tag(r, ASN1_SEQUENCE)
if not t.ok:
ret _newreader(null, 0)
end
ret t.body
end
func _der_int_raw(r &: Reader): Reader:
t := _der_tag(r, ASN1_INTEGER)
if not t.ok:
ret _newreader(null, 0)
end
b := t.body
if b.len == 0:
r.bad = true
ret _newreader(null, 0)
end
if b.len > 1:
f := _rdat(b, 0)
s := _rdat(b, 1)
if f == 0x00 and s < 0x80:
r.bad = true
ret _newreader(null, 0)
end
if f == 0xFF and s >= 0x80:
r.bad = true
ret _newreader(null, 0)
end
end
ret b
end
func _der_strip_sign(b: Reader): Reader:
if b.len > 1 and _rdat(b, 0) == 0x00:
ret _subreader(b, 1, b.len - 1)
end
ret b
end
func _der_int(r &: Reader): Reader:
b := _der_int_raw(r)
if r.bad:
ret b
end
ret _der_strip_sign(b)
end
func _der_uint(r &: Reader): Reader:
b := _der_int_raw(r)
if r.bad:
ret b
end
if b.len > 0 and _rdat(b, 0) >= 0x80:
r.bad = true
ret _newreader(null, 0)
end
ret _der_strip_sign(b)
end
func _der_bitstring(r &: Reader, allow_unused: bool): Reader:
t := _der_tag(r, ASN1_BITSTRING)
if not t.ok:
ret _newreader(null, 0)
end
b := t.body
if b.len < 1:
r.bad = true
ret _newreader(null, 0)
end
unused := _rdat(b, 0)
if unused > 7:
r.bad = true
ret _newreader(null, 0)
end
if unused != 0 and not allow_unused:
r.bad = true
ret _newreader(null, 0)
end
ret _subreader(b, 1, b.len - 1)
end
func _der_oid(r &: Reader): Reader:
t := _der_tag(r, ASN1_OID)
if not t.ok:
ret _newreader(null, 0)
end
ret t.body
end
func _oid_is(o: Reader, hexoid: str): bool:
mut want := _hexbuf(hexoid)
defer _buf_free(want)
if o.len != want.len:
ret false
end
repeat o.len in i:
if _rdat(o, i) != _bufat(want, i):
ret false
end
end
ret true
end
func _der_algid(r &: Reader, params &: Reader): Reader:
mut s := _der_seq(r)
if r.bad:
ret _newreader(null, 0)
end
o := _der_oid(s)
if s.bad:
r.bad = true
ret _newreader(null, 0)
end
params = _rdrest(s)
ret o
end
func _der_skip(r &: Reader):
t := _der(r)
if not t.ok:
r.bad = true
end
end
func _rd_to_str(r: Reader): str:
mut b := _newbuf(r.len + 1)
defer _buf_free(b)
repeat r.len in i:
c := _rdat(r, i)
if c == 0:
ret ""
end
_put8(b, c)
end
ret _bufstr(b)
end
package tls
struct Big:
pub b: Buf = Buf {}
pub cap: int = 0
pub n: int = 0
pub bad: bool = false
end
struct Barrett:
pub m: Big = Big {}
pub mu: Big = Big {}
pub k: int = 0
end
inline func _limb(x: Big, i: int): u32:
p := x.b.p as u32*
ret p[i]
end
inline func _setlimb(x: Big, i: int, v: u32):
p := x.b.p as u32*
p[i] = v
end
func _big_new(limbs: int): Big:
mut nl := limbs
if nl < 1:
nl = 1
end
bb := _newbuf(nl * 4)
mut x := Big {}
x.b = bb
x.cap = nl
x.n = 0
x.bad = bb.bad
if bb.bad:
x.cap = 0
ret x
end
repeat nl in i:
_setlimb(x, i, 0 as u32)
end
ret x
end
func _big_free(x &: Big):
_buf_free(x.b)
x.cap = 0
x.n = 0
end
func _big_wipe_free(x &: Big):
_buf_wipe(x.b)
x.cap = 0
x.n = 0
end
func _big_trim(x &: Big):
until x.n >= 1:
if _limb(x, x.n - 1) != (0 as u32):
ret
end
x.n--
end
end
func _big_zero(x &: Big):
nc := x.cap
repeat nc in i:
_setlimb(x, i, 0 as u32)
end
x.n = 0
end
func _big_is_zero(x: Big): bool:
ret x.n == 0
end
func _big_set_u32(x &: Big, v: u32):
_big_zero(x)
if v != (0 as u32):
_setlimb(x, 0, v)
x.n = 1
end
end
func _big_copy(dst &: Big, src: Big):
if dst.cap < src.n:
dst.bad = true
ret
end
dc := dst.cap
repeat dc in i:
_setlimb(dst, i, 0 as u32)
end
sn := src.n
repeat sn in i:
_setlimb(dst, i, _limb(src, i))
end
dst.n = src.n
end
func _big_cmp(a: Big, b: Big): int:
if a.n != b.n:
if a.n < b.n:
ret 0 - 1
end
ret 1
end
mut i := a.n - 1
until i >= 0:
av := _limb(a, i)
bv := _limb(b, i)
if av != bv:
if av < bv:
ret 0 - 1
end
ret 1
end
i--
end
ret 0
end
func _big_bitlen(x: Big): int:
if x.n == 0:
ret 0
end
top := _limb(x, x.n - 1)
mut bits := 0
mut v := top
until v != (0 as u32):
bits++
v >>= (1 as u32)
end
ret (x.n - 1) * 32 + bits
end
func _big_bit(x: Big, i: int): int:
if i < 0:
ret 0
end
li := i / 32
if li >= x.n:
ret 0
end
ret ((_limb(x, li) >> ((i % 32) as u32)) & (1 as u32)) as int
end
func _big_setbit(x &: Big, i: int):
li := i / 32
if li >= x.cap:
x.bad = true
ret
end
_setlimb(x, li, _limb(x, li) | ((1 as u32) << ((i % 32) as u32)))
if li + 1 > x.n:
x.n = li + 1
end
end
func _big_add(r &: Big, a: Big, b: Big):
mut maxn := a.n
if b.n > maxn:
maxn = b.n
end
if r.cap < maxn + 1:
r.bad = true
ret
end
_big_zero(r)
mut carry := 0 as u64
repeat maxn in i:
mut s := carry
if i < a.n:
s += _limb(a, i) as u64
end
if i < b.n:
s += _limb(b, i) as u64
end
_setlimb(r, i, s as u32)
carry = s >> (32 as u64)
end
mut n := maxn
if carry != (0 as u64):
_setlimb(r, maxn, carry as u32)
n = maxn + 1
end
r.n = n
_big_trim(r)
end
func _big_sub(r &: Big, a: Big, b: Big): bool:
if _big_cmp(a, b) < 0:
ret false
end
if r.cap < a.n:
r.bad = true
ret false
end
_big_zero(r)
an := a.n
mut borrow := 0 as i64
repeat an in i:
mut d := (_limb(a, i) as i64) - borrow
if i < b.n:
d -= _limb(b, i) as i64
end
if d < 0:
d += 4294967296
borrow = 1
else:
borrow = 0
end
_setlimb(r, i, d as u32)
end
r.n = a.n
_big_trim(r)
ret true
end
func _big_mul(r &: Big, a: Big, b: Big):
if r.cap < a.n + b.n:
r.bad = true
ret
end
_big_zero(r)
if a.n == 0 or b.n == 0:
ret
end
an := a.n
bn := b.n
repeat an in i:
mut carry := 0 as u64
av := _limb(a, i) as u64
repeat bn in j:
cur := (_limb(r, i + j) as u64) + av * (_limb(b, j) as u64) + carry
_setlimb(r, i + j, cur as u32)
carry = cur >> (32 as u64)
end
mut k := i + bn
until carry != (0 as u64):
cur := (_limb(r, k) as u64) + carry
_setlimb(r, k, cur as u32)
carry = cur >> (32 as u64)
k++
end
end
r.n = a.n + b.n
_big_trim(r)
end
func _big_shl1(x &: Big):
mut carry := 0 as u32
lim := x.n
repeat lim in i:
v := _limb(x, i)
_setlimb(x, i, (v << (1 as u32)) | carry)
carry = v >> (31 as u32)
end
if carry != (0 as u32):
if x.n >= x.cap:
x.bad = true
ret
end
_setlimb(x, x.n, carry)
x.n++
end
end
func _big_divmod(q &: Big, rem &: Big, a: Big, m: Big): bool:
if m.n == 0:
ret false
end
if q.cap < a.n or rem.cap < m.n + 1:
q.bad = true
ret false
end
_big_zero(q)
_big_zero(rem)
mut scratch := _big_new(m.n + 2)
defer _big_free(scratch)
if scratch.bad:
ret false
end
mut i := _big_bitlen(a) - 1
until i >= 0:
_big_shl1(rem)
if rem.bad:
ret false
end
if _big_bit(a, i) == 1:
if rem.n == 0:
_setlimb(rem, 0, 1 as u32)
rem.n = 1
else:
_setlimb(rem, 0, _limb(rem, 0) | (1 as u32))
end
end
if _big_cmp(rem, m) >= 0:
if not _big_sub(scratch, rem, m):
ret false
end
_big_copy(rem, scratch)
_big_setbit(q, i)
end
i--
end
_big_trim(q)
_big_trim(rem)
ret true
end
func _big_mod(r &: Big, a: Big, m: Big): bool:
mut q := _big_new(a.n + 1)
defer _big_free(q)
if q.bad:
ret false
end
ret _big_divmod(q, r, a, m)
end
func _big_modexp(r &: Big, base: Big, e: Big, m: Big): bool:
if m.n == 0:
ret false
end
mut acc := _big_new(m.n + 1)
defer _big_free(acc)
mut cur := _big_new(m.n + 1)
defer _big_free(cur)
mut prod := _big_new(2 * m.n + 2)
defer _big_free(prod)
mut red := _big_new(m.n + 2)
defer _big_free(red)
if acc.bad or cur.bad or prod.bad or red.bad:
ret false
end
_big_set_u32(acc, 1 as u32)
if not _big_mod(cur, base, m):
ret false
end
bits := _big_bitlen(e)
mut i := 0
until i < bits:
if _big_bit(e, i) == 1:
_big_mul(prod, acc, cur)
if prod.bad or not _big_mod(red, prod, m):
ret false
end
_big_copy(acc, red)
end
if i + 1 < bits:
_big_mul(prod, cur, cur)
if prod.bad or not _big_mod(red, prod, m):
ret false
end
_big_copy(cur, red)
end
i++
end
_big_copy(r, acc)
ret not r.bad
end
func _big_shr_limbs(x: Big, s: int): Big:
mut nn := x.n - s
if nn < 0:
nn = 0
end
mut r := _big_new(nn + 1)
repeat nn in i:
_setlimb(r, i, _limb(x, i + s))
end
r.n = nn
_big_trim(r)
ret r
end
func _big_low_limbs(x: Big, s: int): Big:
mut nn := x.n
if nn > s:
nn = s
end
mut r := _big_new(s + 1)
repeat nn in i:
_setlimb(r, i, _limb(x, i))
end
r.n = nn
_big_trim(r)
ret r
end
func _barrett_new(m: Big): Barrett:
mut bt := Barrett {}
k := m.n
mut bk2 := _big_new(2 * k + 4)
_big_setbit(bk2, 2 * k * 32)
mut mu := _big_new(2 * k + 4)
mut rem := _big_new(k + 4)
_dok := _big_divmod(mu, rem, bk2, m)
_big_free(bk2)
_big_free(rem)
mut mcopy := _big_new(k + 4)
_big_copy(mcopy, m)
bt.m = mcopy
bt.mu = mu
bt.k = k
ret bt
end
func _barrett_free(bt &: Barrett):
_big_free(bt.m)
_big_free(bt.mu)
bt.k = 0
end
func _barrett_reduce(bt: Barrett, x: Big, r &: Big): bool:
k := bt.k
if x.n > 2 * k:
ret false
end
mut q1 := _big_shr_limbs(x, k - 1)
mut q2 := _big_new(q1.n + bt.mu.n + 4)
_big_mul(q2, q1, bt.mu)
mut q3 := _big_shr_limbs(q2, k + 1)
_big_free(q1)
_big_free(q2)
mut r1 := _big_low_limbs(x, k + 1)
mut prod := _big_new(q3.n + bt.m.n + 4)
_big_mul(prod, q3, bt.m)
mut r2 := _big_low_limbs(prod, k + 1)
_big_free(q3)
_big_free(prod)
mut wide := _big_new(k + 6)
if _big_cmp(r1, r2) >= 0:
_s1 := _big_sub(wide, r1, r2)
else:
mut base := _big_new(k + 6)
_big_setbit(base, (k + 1) * 32)
mut r1adj := _big_new(k + 6)
_big_add(r1adj, r1, base)
_s3 := _big_sub(wide, r1adj, r2)
_big_free(base)
_big_free(r1adj)
end
_big_free(r1)
_big_free(r2)
mut cur := wide
mut guard := 0
until _big_cmp(cur, bt.m) >= 0 and guard <= 4:
mut nxt := _big_new(k + 6)
_s4 := _big_sub(nxt, cur, bt.m)
_big_free(cur)
cur = nxt
guard++
end
_big_copy(r, cur)
_big_free(cur)
ret not r.bad
end
func _big_modexp_barrett(r &: Big, base: Big, e: Big, m: Big): bool:
if m.n == 0:
ret false
end
mut bt := _barrett_new(m)
mut acc := _big_new(m.n + 1)
_big_set_u32(acc, 1 as u32)
mut cur := _big_new(m.n + 1)
_dok2 := _big_mod(cur, base, m)
bits := _big_bitlen(e)
mut i := 0
mut ok := true
until i < bits and ok:
if _big_bit(e, i) == 1:
mut prod := _big_new(acc.n + cur.n)
_big_mul(prod, acc, cur)
mut red := _big_new(m.n + 1)
if prod.bad or not _barrett_reduce(bt, prod, red):
ok = false
end
_big_free(prod)
_big_copy(acc, red)
_big_free(red)
end
if ok and i + 1 < bits:
mut sq := _big_new(cur.n + cur.n)
_big_mul(sq, cur, cur)
mut red2 := _big_new(m.n + 1)
if sq.bad or not _barrett_reduce(bt, sq, red2):
ok = false
end
_big_free(sq)
_big_copy(cur, red2)
_big_free(red2)
end
i++
end
if ok:
_big_copy(r, acc)
end
_big_free(acc)
_big_free(cur)
_barrett_free(bt)
ret ok and not r.bad
end
func _big_from_bytes(p: void*, len: int): Big:
mut nl := (len + 3) / 4
if nl < 1:
nl = 1
end
mut x := _big_new(nl)
if x.bad:
ret x
end
repeat len in i:
v := _bget(p, len - 1 - i)
li := i / 4
sh := ((i % 4) * 8) as u32
_setlimb(x, li, _limb(x, li) | ((v as u32) << sh))
end
x.n = nl
_big_trim(x)
ret x
end
func _big_bytelen(x: Big): int:
bl := _big_bitlen(x)
ret (bl + 7) / 8
end
func _big_to_bytes(x: Big, out: void*, len: int): bool:
if _big_bytelen(x) > len:
ret false
end
repeat len in i:
_bput(out, i, 0)
end
total := x.n * 4
repeat total in i:
li := i / 4
sh := ((i % 4) * 8) as u32
v := ((_limb(x, li) >> sh) & (0xFF as u32)) as int
pos := len - 1 - i
if pos >= 0:
_bput(out, pos, v)
end
end
ret true
end
@en "tls"
@fa "تی ال اس"
package tls
import mem
import str
import time
import io
import os
import encoding
import crypto
const HEXDIGITS := "0123456789abcdef"
struct Buf:
pub p: void* = null
pub len: int = 0
pub cap: int = 0
pub bad: bool = false
end
struct Reader:
pub p: void* = null
pub len: int = 0
pub pos: int = 0
pub bad: bool = false
end
inline func _bget(p: void*, i: int): int:
bp := p as u8*
ret bp[i] as int
end
inline func _bput(p: void*, i: int, v: int):
bp := p as u8*
bp[i] = v as u8
end
func _newbuf(cap0: int): Buf:
mut c := cap0
if c < 32:
c = 32
end
p := mem.Allocate(c as u64)
if p == null:
ret Buf { p = null, len = 0, cap = 0, bad = true }
end
ret Buf { p = p, len = 0, cap = c, bad = false }
end
func _buf_free(b &: Buf):
if b.p != null:
mem.Free(b.p)
end
b.p = null
b.len = 0
b.cap = 0
end
func _wipe(p: void*, n: int):
if p != null and n > 0:
mem.Set(p, 0, n as u64)
end
end
func _buf_wipe(b &: Buf):
_wipe(b.p, b.cap)
_buf_free(b)
end
func _buf_grow(b &: Buf, need: int):
if b.bad:
ret
end
if b.len + need <= b.cap:
ret
end
mut nc := b.cap
if nc < 32:
nc = 32
end
until b.len + need > nc:
nc *= 2
end
np := mem.Reallocate(b.p, nc as u64)
if np == null:
b.bad = true
ret
end
b.p = np
b.cap = nc
end
func _put8(b &: Buf, v: int):
_buf_grow(b, 1)
if b.bad:
ret
end
_bput(b.p, b.len, v & 0xFF)
b.len++
end
func _put16(b &: Buf, v: int):
_put8(b, (v >> 8) & 0xFF)
_put8(b, v & 0xFF)
end
func _put24(b &: Buf, v: int):
_put8(b, (v >> 16) & 0xFF)
_put8(b, (v >> 8) & 0xFF)
_put8(b, v & 0xFF)
end
func _put32(b &: Buf, v: i64):
_put8(b, ((v >> 24) & 0xFF) as int)
_put8(b, ((v >> 16) & 0xFF) as int)
_put8(b, ((v >> 8) & 0xFF) as int)
_put8(b, (v & 0xFF) as int)
end
func _put64(b &: Buf, v: u64):
repeat 8 in i:
sh := ((7 - i) * 8) as u64
_put8(b, ((v >> sh) & (0xFF as u64)) as int)
end
end
func _putraw(b &: Buf, src: void*, n: int):
if n <= 0:
ret
end
_buf_grow(b, n)
if b.bad:
ret
end
dst := ((b.p as i64) + (b.len as i64)) as void*
mem.Copy(dst, src, n as u64)
b.len += n
end
func _putbuf(b &: Buf, src: Buf):
_putraw(b, src.p, src.len)
end
func _putstr(b &: Buf, s: str):
_putraw(b, s as void*, s.len())
end
func _putzeros(b &: Buf, n: int):
if n <= 0:
ret
end
_buf_grow(b, n)
if b.bad:
ret
end
mem.Set(_bufptr(b, b.len), 0, n as u64)
b.len += n
end
func _bufat(b: Buf, i: int): int:
if i < 0 or i >= b.len:
ret 0
end
ret _bget(b.p, i)
end
func _bufset(b &: Buf, i: int, v: int):
if i < 0 or i >= b.len:
ret
end
_bput(b.p, i, v & 0xFF)
end
func _patch16(b &: Buf, off: int, v: int):
_bufset(b, off, (v >> 8) & 0xFF)
_bufset(b, off + 1, v & 0xFF)
