curr++
end
until curr > tgt:
_bz_put(w, 2, 3)
curr--
end
_bz_put(w, 1, 0)
end
end
mut g := 0
gs = 0
until gs < nmtf:
mut ge := gs + 49
if ge >= nmtf: ge = nmtf - 1 end
