package socketio
import net.websocket
import mem
@en "TransportAuto"
@fa "حمل‌ونقل خودکار"
pub const TRANSPORT_AUTO := 0
@en "TransportWebSocket"
@fa "حمل‌ونقل وب‌سوکت"
pub const TRANSPORT_WEBSOCKET := 1
@en "TransportPolling"
@fa "حمل‌ونقل نظرخواهی"
pub const TRANSPORT_POLLING := 2
@en "EventNone"
@fa "بدون رویداد"
pub const EV_NONE := 0
@en "EventMessage"
@fa "رویداد پیام"
pub const EV_EVENT := 1
@en "EventConnect"
@fa "رویداد اتصال"
pub const EV_CONNECT := 2
@en "EventDisconnect"
@fa "رویداد قطع"
pub const EV_DISCONNECT := 3
@en "EventConnectError"
@fa "رویداد خطای اتصال"
pub const EV_CONNECT_ERROR := 4
@en "EventError"
@fa "رویداد خطا"
pub const EV_ERROR := 5
@en "EventReconnect"
@fa "رویداد اتصال دوباره"
pub const EV_RECONNECT := 6
@en "EventReconnectAttempt"
@fa "رویداد کوشش دوباره"
pub const EV_RECONNECT_ATTEMPT := 7
@en "EventReconnectError"
@fa "رویداد خطای دوباره"
pub const EV_RECONNECT_ERROR := 8
@en "EventReconnectFailed"
@fa "رویداد شکست دوباره"
pub const EV_RECONNECT_FAILED := 9
@en "EventPing"
@fa "رویداد پینگ"
pub const EV_PING := 10
@en "EventTimeout"
@fa "رویداد مهلت"
pub const EV_TIMEOUT := 11
@en "EventUpgrade"
@fa "رویداد ارتقا"
pub const EV_UPGRADE := 12
@en "ReasonServerDisconnect"
@fa "قطع توسط سرور"
pub const REASON_SERVER_DISCONNECT := "io server disconnect"
@en "ReasonClientDisconnect"
@fa "قطع توسط کارخواه"
pub const REASON_CLIENT_DISCONNECT := "io client disconnect"
@en "ReasonPingTimeout"
@fa "دلیل مهلت پینگ"
pub const REASON_PING_TIMEOUT := "ping timeout"
@en "ReasonTransportClose"
@fa "بسته شدن حمل‌ونقل"
pub const REASON_TRANSPORT_CLOSE := "transport close"
@en "ReasonTransportError"
@fa "خطای حمل‌ونقل"
pub const REASON_TRANSPORT_ERROR := "transport error"
@en "ReasonParseError"
@fa "خطای تجزیه"
pub const REASON_PARSE_ERROR := "parse error"
@en "PumpOk"
@fa "پمپ موفق"
pub const PUMP_OK := 0
@en "PumpTimeout"
@fa "پمپ مهلت"
pub const PUMP_TIMEOUT := 1
@en "PumpClosed"
@fa "پمپ بسته"
pub const PUMP_CLOSED := 2
const ST_CLOSED := 0
const ST_OPEN := 1
const ST_WAITING := 2
struct Handler:
pub name: str = ""
pub once: bool = false
pub alive: bool = true
pub cb: func (Event) = (_e: Event): end
end
struct Outgoing:
pub text: str = ""
pub bins: Vector<Bytes> = Vector {}
end
struct AckWaiter:
pub id: int = 0 - 1
pub deadline: i64 = 0
pub has_deadline: bool = false
pub alive: bool = true
pub has_cb: bool = false
pub cb: func (Ack) = (_a: Ack): end
pub retries_left: int = 0
pub interval: int = 0
pub internal: bool = false
pub has_packet: bool = false
pub packet: Outgoing = Outgoing {}
end
struct SockState:
pub mgr: void* = null
pub nsp: str = "/"
pub id: str = ""
pub connected: bool = false
pub active: bool = false
pub pid: str = ""
pub last_offset: str = ""
pub recovered: bool = false
pub auth: str = ""
pub refused: bool = false
pub refusal: str = ""
pub ack_seq: int = 0
pub handlers: Vector<Handler> = Vector {}
pub any_handlers: Vector<Handler> = Vector {}
pub out_handlers: Vector<Handler> = Vector {}
pub waiters: Vector<AckWaiter> = Vector {}
pub results: Vector<Ack> = Vector {}
pub outbuf: Vector<Outgoing> = Vector {}
pub inbox: Vector<Event> = Vector {}
pub queueing: bool = true
pub max_queue: int = 256
end
struct MgrState:
pub ep: Endpoint = Endpoint {}
pub opts: Options = Options {}
pub socks: Vector<Client> = Vector {}
pub state: int = ST_CLOSED
pub transport: int = TRANSPORT_POLLING
pub ws: websocket.Conn = websocket.Conn {}
pub sid: str = ""
pub ping_interval: int = 25000
pub ping_timeout: int = 20000
pub max_payload: int = 1000000
pub can_upgrade: bool = false
pub upgraded_before: bool = false
pub last_rx: i64 = 0
pub cookies: HashMap<str, str> = HashMap {} as HashMap<str, str>
pub attempts: int = 0
pub retry_at: i64 = 0
pub last_error: str = ""
pub dispatching: int = 0
pub pollout: Vector<str> = Vector {}
pub batching: bool = false
pub recon: bool = false
pub recon_pkt: Packet = Packet {}
pub recon_bins: Vector<Bytes> = Vector {}
end
@en "Options"
@fa "گزینه‌ها"
pub struct Options:
@en "path"
@fa "مسیر"
pub path: str = "/socket.io"
@en "query"
@fa "پرسمان"
pub query: str = ""
@en "auth"
@fa "احراز هویت"
pub auth: str = ""
@en "headers"
@fa "سرآیندها"
pub headers: str = ""
@en "transports"
@fa "حمل‌ونقل"
pub transports: int = TRANSPORT_AUTO
@en "reconnection"
@fa "اتصال دوباره"
pub reconnection: bool = true
@en "reconnection_attempts"
@fa "تعداد کوشش اتصال دوباره"
pub reconnection_attempts: int = 0
@en "reconnection_delay"
@fa "تاخیر اتصال دوباره"
pub reconnection_delay: int = 1000
@en "reconnection_delay_max"
@fa "بیشترین تاخیر اتصال دوباره"
pub reconnection_delay_max: int = 5000
@en "randomization_factor"
@fa "ضریب تصادفی"
pub randomization_factor: int = 50
@en "timeout"
@fa "مهلت"
pub timeout: int = 20000
@en "insecure"
@fa "ناامن"
pub insecure: bool = false
@en "auto_connect"
@fa "اتصال خودکار"
pub auto_connect: bool = true
@en "event_queue"
@fa "صف رویداد"
pub event_queue: int = 256
@en "ack_timeout"
@fa "مهلت تایید"
pub ack_timeout: int = 0
@en "retries"
@fa "کوشش دوباره"
pub retries: int = 0
@en "trailing_slash"
@fa "اسلش پایانی"
pub trailing_slash: bool = true
@en "remember_upgrade"
@fa "به خاطر سپردن ارتقا"
pub remember_upgrade: bool = false
end
@en "Client"
@fa "کارخواه"
pub struct Client:
@en "p"
@fa "اشاره‌گر داخلی"
pub p: void* = null
end
@en "Manager"
@fa "مدیر"
pub struct Manager:
@en "p"
@fa "اشاره‌گر داخلی"
pub p: void* = null
end
@en "Event"
@fa "رویداد"
pub struct Event:
@en "kind"
@fa "نوع"
pub kind: int = EV_NONE
@en "name"
@fa "نام"
pub name: str = ""
@en "nsp"
@fa "فضای نام"
pub nsp: str = "/"
@en "data"
@fa "داده"
pub data: str = "[]"
@en "ack_id"
@fa "شماره تایید"
pub ack_id: int = 0 - 1
@en "message"
@fa "پیام"
pub message: str = ""
@en "bins"
@fa "بخش‌های دودویی"
pub bins: Vector<Bytes> = Vector {}
@en "client"
@fa "کارخواه"
pub client: Client = Client {}
end
@en "Ack"
@fa "تایید"
pub struct Ack:
@en "ok"
@fa "رسیده"
pub ok: bool = false
@en "id"
@fa "شماره تایید"
pub id: int = 0 - 1
@en "data"
@fa "داده"
pub data: str = "[]"
@en "bins"
@fa "بخش‌های دودویی"
pub bins: Vector<Bytes> = Vector {}
end
func _sock(c: Client): SockState*:
ret c.p as SockState*
end
func _mgr(m: Manager): MgrState*:
ret m.p as MgrState*
end
func _mgr_of(c: Client): MgrState*:
ret _sock(c)[0].mgr as MgrState*
end
func _new_sock(mgr: void*, nsp: str): Client:
raw := mem.AllocateZeroed(sizeof(SockState) as u64)
if raw == null:
ret Client {}
end
mut sp := raw as SockState*
sp[0] = SockState { mgr = mgr, nsp = nsp }
ret Client { p = raw }
end
func _new_mgr(ep: Endpoint, opts: Options): Manager:
raw := mem.AllocateZeroed(sizeof(MgrState) as u64)
if raw == null:
ret Manager {}
end
mut mp := raw as MgrState*
mp[0] = MgrState { ep = ep, opts = opts }
ret Manager { p = raw }
end
func _free_bins(v &: Vector<Bytes>):
repeat v.len() in i:
mut b := v.get(i)
BytesFree(b)
end
v.free()
end
package socketio
import str
@en "Endpoint"
@fa "مشخصات نقطه پایانی"
pub struct Endpoint:
@en "secure"
@fa "امن"
pub secure: bool = false
@en "host"
@fa "میزبان"
pub host: str = "localhost"
@en "port"
@fa "درگاه"
pub port: int = 80
@en "path"
@fa "مسیر"
pub path: str = "/socket.io"
@en "namespace"
@fa "فضای نام"
pub namespace: str = "/"
@en "query"
@fa "پرسمان"
pub query: str = ""
@en "ok"
@fa "معتبر"
pub ok: bool = false
end
func _port_of(s: str): int:
if not _all_digits(s) or s.len() > 5:
ret 0
end
v := s.to_int()
if v < 1 or v > 65535:
ret 0
end
ret v
end
func _all_digits(s: str): bool:
if s.len() == 0:
ret false
end
mut ok := true
repeat s.len() in i:
c := char_code(s.substr(i, 1))
if c < 48 or c > 57:
ok = false
end
end
ret ok
end
@en "ParseURL"
@fa "تجزیه نشانی"
pub func ParseURL(raw: str): Endpoint:
mut e := Endpoint {}
s := str.Trim(raw)
if s.len() == 0:
ret e
end
mut rest := s
mut scheme := ""
si := str.Find(rest, "://")
if si >= 0:
scheme = str.Lower(rest.substr(0, si))
rest = rest.substr(si + 3, rest.len() - si - 3)
end
if scheme == "https" or scheme == "wss":
e.secure = true
else scheme == "http" or scheme == "ws" or scheme == "":
e.secure = false
else:
ret e
end
qi := str.Find(rest, "?")
if qi >= 0:
e.query = rest.substr(qi + 1, rest.len() - qi - 1)
rest = rest.substr(0, qi)
end
hi := str.Find(rest, "#")
if hi >= 0:
rest = rest.substr(0, hi)
end
mut authority := rest
mut ns := "/"
pi := str.Find(rest, "/")
if pi >= 0:
authority = rest.substr(0, pi)
ns = rest.substr(pi, rest.len() - pi)
end
ui := str.LastIndex(authority, "@")
if ui >= 0:
authority = authority.substr(ui + 1, authority.len() - ui - 1)
end
mut host := authority
mut port := 0
if str.StartsWith(authority, "["):
rb := str.Find(authority, "]")
if rb < 0:
ret e
end
host = authority.substr(1, rb - 1)
after := authority.substr(rb + 1, authority.len() - rb - 1)
if str.StartsWith(after, ":"):
port = _port_of(after.substr(1, after.len() - 1))
if port == 0:
ret e
end
end
else:
ci := str.LastIndex(authority, ":")
if ci >= 0:
port = _port_of(authority.substr(ci + 1, authority.len() - ci - 1))
if port == 0:
ret e
end
host = authority.substr(0, ci)
end
end
if host.len() == 0:
ret e
end
if port <= 0:
port = 80
if e.secure:
port = 443
end
end
until ns.len() > 1 and str.EndsWith(ns, "/"):
ns = ns.substr(0, ns.len() - 1)
end
if ns.len() == 0:
ns = "/"
end
e.host = host
e.port = port
e.namespace = ns
e.ok = true
ret e
end
@en "Origin"
@fa "مبدا"
pub func Origin(e: Endpoint): str:
mut sch := "http"
mut standard := 80
if e.secure:
sch = "https"
standard = 443
end
mut h := e.host
if str.Contains(h, ":"):
h = "[" + h + "]"
end
if e.port == standard:
ret sch + "://" + h
end
ret sch + "://" + h + ":" + e.port
end
package socks
import net.tunnel
@en "Socks5Inbound"
@fa "ورودی ساکس۵"
pub struct Socks5Inbound:
@en "config"
@fa "پیکربندی"
pub config: ServerConfig = ServerConfig {}
@en "Name"
@fa "نام"
pub func Name(): str:
ret "socks5"
end
@en "Handshake"
@fa "دست‌دهی"
pub func Handshake(s: dyn tunnel.Stream): tunnel.Session:
v := tunnel.ReadByte(s)
if v != 5: ret tunnel.Session { error = "not a SOCKS5 client" } end
mut req := Request {}
mut user := ""
if not _hs5(this.config, s, req, user):
ret tunnel.Session { error = "SOCKS5 handshake failed" }
end
if req.cmd != CmdConnect:
_reply(s, 5, RepCmdNotSupported, _wild())
ret tunnel.Session { error = "SOCKS5 command not supported here" }
end
if not this.config.allow(CmdConnect, req.addr.host, req.addr.port):
_reply(s, 5, RepNotAllowed, _wild())
ret tunnel.Session { error = "target not allowed" }
end
ret tunnel.Session { ok = true, target = tunnel.NewAddr(req.addr.host, req.addr.port), protocol = "socks5", user = user, command = 1 }
end
@en "Reply"
@fa "پاسخ"
pub func Reply(s: dyn tunnel.Stream, sess: tunnel.Session, ok: bool):
if ok:
_reply(s, 5, RepSucceeded, _wild())
else sess.refused:
_reply(s, 5, RepNotAllowed, _wild())
else:
_reply(s, 5, RepHostUnreachable, _wild())
end
end
end
@en "Socks4Inbound"
@fa "ورودی ساکس۴"
pub struct Socks4Inbound:
@en "config"
@fa "پیکربندی"
pub config: ServerConfig = ServerConfig {}
@en "Name"
@fa "نام"
pub func Name(): str:
ret "socks4"
end
@en "Handshake"
@fa "دست‌دهی"
pub func Handshake(s: dyn tunnel.Stream): tunnel.Session:
v := tunnel.ReadByte(s)
if v != 4: ret tunnel.Session { error = "not a SOCKS4 client" } end
mut req := Request {}
if not _hs4(this.config, s, req):
ret tunnel.Session { error = "SOCKS4 handshake failed" }
end
if req.cmd != CmdConnect:
_reply(s, 4, RepCmdNotSupported, _wild())
ret tunnel.Session { error = "SOCKS4 command not supported here" }
end
if not this.config.allow(CmdConnect, req.addr.host, req.addr.port):
_reply(s, 4, RepNotAllowed, _wild())
ret tunnel.Session { error = "target not allowed" }
end
ret tunnel.Session { ok = true, target = tunnel.NewAddr(req.addr.host, req.addr.port), protocol = "socks4", user = req.user, command = 1 }
end
@en "Reply"
@fa "پاسخ"
pub func Reply(s: dyn tunnel.Stream, _sess: tunnel.Session, ok: bool):
if ok:
_reply(s, 4, RepSucceeded, _wild())
else:
_reply(s, 4, RepGeneralFailure, _wild())
end
end
end
@en "SocksConnector"
@fa "رابط ساکس"
pub struct SocksConnector:
@en "client"
@fa "کلاینت"
pub client: Client = Client {}
@en "Server"
@fa "کارساز"
pub func Server(): tunnel.Addr:
ret tunnel.NewAddr(this.client.host, this.client.port)
end
@en "Handshake"
@fa "دست‌دهی"
pub func Handshake(s: dyn tunnel.Stream, target: tunnel.Addr): bool:
ret ClientHandshake(s, this.client, CmdConnect, target.host, target.port).ok
end
@en "Name"
@fa "نام"
pub func Name(): str:
if this.client.version == Socks5: ret "socks5" end
if this.client.version == Socks4a: ret "socks4a" end
ret "socks4"
end
end
@en "NewConnector"
@fa "رابط جدید"
pub func NewConnector(c: Client): SocksConnector:
ret SocksConnector { client = c }
end
@en "NewInbound"
@fa "ورودی جدید"
pub func NewInbound(cfg: ServerConfig): Socks5Inbound:
ret Socks5Inbound { config = cfg }
end
@en "NewInbound4"
@fa "ورودی جدید ساکس۴"
pub func NewInbound4(cfg: ServerConfig): Socks4Inbound:
ret Socks4Inbound { config = cfg }
end
@en "SetDialer"
@fa "تعیین شماره‌گیر"
pub func SetDialer(cfg &: ServerConfig, d: dyn tunnel.Dialer):
cfg.has_connect = true
cfg.connect = (h: str, p: int):
s := d.Dial(tunnel.NewAddr(h, p))
if not s.Ok(): ret Outbound { ok = false, code = RepHostUnreachable, err = "dial failed via " + d.Name() } end
ret Outbound { ok = true, code = RepSucceeded, stream = s }
end
end
package socks
import mem
import str
import net.tcp
import net.udp
import net.internal.rawsock
import net.tunnel
import tls
@en "Socks5"
@fa "ساکس۵"
pub const Socks5 := 5
@en "Socks4"
@fa "ساکس۴"
pub const Socks4 := 4
@en "Socks4a"
@fa "ساکس۴ای"
pub const Socks4a := 40
@en "Client"
@fa "کلاینت"
pub struct Client:
@en "version"
@fa "نسخه"
pub version: int = 5
@en "host"
@fa "میزبان"
pub host: str = ""
@en "port"
@fa "درگاه"
pub port: int = 0
@en "username"
@fa "نام کاربری"
pub username: str = ""
@en "password"
@fa "گذرواژه"
pub password: str = ""
@en "timeout_ms"
@fa "مهلت میلی‌ثانیه"
pub timeout_ms: int = 10000
@en "tls"
@fa "امن"
pub tls: bool = false
@en "server_name"
@fa "نام سرور"
pub server_name: str = ""
@en "insecure"
@fa "بدون اعتبارسنجی"
pub insecure: bool = false
end
@en "HandshakeResult"
@fa "نتیجه دست‌دهی"
pub struct HandshakeResult:
@en "ok"
@fa "موفق"
pub ok: bool = false
@en "code"
@fa "کد"
pub code: int = 0
@en "err"
@fa "خطا"
pub err: str = ""
@en "bound"
@fa "نشانی محلی"
pub bound: Address = Address {}
end
@en "ConnectResult"
@fa "نتیجه اتصال"
pub struct ConnectResult:
@en "ok"
@fa "موفق"
pub ok: bool = false
@en "code"
@fa "کد"
pub code: int = 0
@en "err"
@fa "خطا"
pub err: str = ""
@en "stream"
@fa "جریان"
pub stream: dyn tunnel.Stream = tunnel.TcpStream {}
@en "bound"
@fa "نشانی محلی"
pub bound: Address = Address {}
end
@en "UDPSession"
@fa "نشست یو دی پی"
pub struct UDPSession:
@en "ok"
@fa "موفق"
pub ok: bool = false
@en "err"
@fa "خطا"
pub err: str = ""
@en "control"
@fa "کنترل"
pub control: dyn tunnel.Stream = tunnel.TcpStream {}
@en "sock"
@fa "سوکت"
pub sock: udp.Socket = udp.Socket {}
@en "relay_host"
@fa "میزبان رله"
pub relay_host: str = ""
@en "relay_port"
@fa "درگاه رله"
pub relay_port: int = 0
end
func _fail(code: int, err: str): HandshakeResult:
ret HandshakeResult { ok = false, code = code, err = err }
end
func _send(s: dyn tunnel.Stream, v: Vector<u8>): bool:
n := v.len()
if n == 0: ret false end
buf := mem.Allocate(n as u64)
defer mem.Free(buf)
p := buf as u8*
repeat n in i:
p[i] = v.get(i)
end
ret s.WriteBytes(buf, n) == n
end
func _recv(s: dyn tunnel.Stream, v &: Vector<u8>, n: int): bool:
buf := mem.Allocate(n as u64)
defer mem.Free(buf)
if not tunnel.ReadFull(s, buf, n): ret false end
p := buf as u8*
repeat n in i:
v.push(p[i])
end
ret true
end
func _recv_reply5(s: dyn tunnel.Stream, out &: Reply): int:
mut v := Vector {} as Vector<u8>
defer v.free()
if not _recv(s, v, 4): ret 0 - 1 end
t := _b(v, 3)
mut more := 0
if t == AtypIPv4:
more = 6
else t == AtypIPv6:
more = 18
else t == AtypDomain:
if not _recv(s, v, 1): ret 0 - 1 end
more = _b(v, 4) + 2
else:
ret 0 - 2
end
if not _recv(s, v, more): ret 0 - 1 end
if DecodeReply(v, out) <= 0: ret 0 - 2 end
ret 0
end
func _auth5(s: dyn tunnel.Stream, c: Client): HandshakeResult:
req := EncodeAuthRequest(c.username, c.password)
defer req.free()
if req.len() == 0: ret _fail(RepGeneralFailure, "bad username or password length") end
if not _send(s, req): ret _fail(RepGeneralFailure, "auth write failed") end
mut v := Vector {} as Vector<u8>
defer v.free()
if not _recv(s, v, 2): ret _fail(RepGeneralFailure, "auth reply truncated") end
if _b(v, 0) != 1: ret _fail(RepGeneralFailure, "bad auth reply version") end
if _b(v, 1) != 0: ret _fail(RepNotAllowed, "authentication failed") end
ret HandshakeResult { ok = true }
end
func _negotiate5(s: dyn tunnel.Stream, c: Client): HandshakeResult:
mut methods := Vector {} as Vector<u8>
defer methods.free()
methods.push(0 as u8)
if c.username.len() > 0: methods.push(2 as u8) end
g := EncodeGreeting(methods)
defer g.free()
if not _send(s, g): ret _fail(RepGeneralFailure, "greeting write failed") end
mut v := Vector {} as Vector<u8>
defer v.free()
if not _recv(s, v, 2): ret _fail(RepGeneralFailure, "greeting reply truncated") end
if _b(v, 0) != 5: ret _fail(RepGeneralFailure, "not a SOCKS5 server") end
m := _b(v, 1)
if m == AuthNoAcceptable: ret _fail(RepNotAllowed, "no acceptable auth method") end
if m == AuthUserPass:
if c.username.len() == 0: ret _fail(RepNotAllowed, "server requires credentials") end
ret _auth5(s, c)
end
if m != AuthNone: ret _fail(RepGeneralFailure, "server chose an unsupported method") end
ret HandshakeResult { ok = true }
end
func _command5(s: dyn tunnel.Stream, c: Client, cmd: int, host: str, port: int): HandshakeResult:
n := _negotiate5(s, c)
if not n.ok: ret n end
req := EncodeRequest(cmd, NewAddress(host, port))
defer req.free()
if req.len() == 0: ret _fail(RepAtypNotSupported, "bad target address") end
if not _send(s, req): ret _fail(RepGeneralFailure, "request write failed") end
ret _read_reply(s)
end
func _read_reply(s: dyn tunnel.Stream): HandshakeResult:
mut r := Reply {}
rc := _recv_reply5(s, r)
if rc == 0 - 1: ret _fail(RepGeneralFailure, "reply truncated") end
if rc == 0 - 2: ret _fail(RepGeneralFailure, "malformed reply") end
if r.code != RepSucceeded: ret HandshakeResult { ok = false, code = r.code, err = ReplyText(r.code), bound = r.addr } end
ret HandshakeResult { ok = true, code = 0, bound = r.addr }
end
func _command4(s: dyn tunnel.Stream, c: Client, cmd: int, host: str, port: int): HandshakeResult:
mut h := host
mut ip := Vector {} as Vector<u8>
defer ip.free()
if not ParseIPv4(h, ip):
if c.version == Socks4:
h = rawsock.Resolve(host)
if h.len() == 0 or not ParseIPv4(h, ip): ret _fail(Rep4Rejected, "socks4 needs an IPv4 target") end
end
end
req := Encode4Request(cmd, h, port, c.username)
defer req.free()
if req.len() == 0: ret _fail(Rep4Rejected, "bad target address") end
if not _send(s, req): ret _fail(Rep4Rejected, "request write failed") end
mut v := Vector {} as Vector<u8>
defer v.free()
if not _recv(s, v, 8): ret _fail(Rep4Rejected, "reply truncated") end
mut r := Reply {}
if not Decode4Reply(v, r): ret _fail(Rep4Rejected, "malformed reply") end
if r.code != Rep4Granted: ret HandshakeResult { ok = false, code = r.code, err = ReplyText(r.code), bound = r.addr } end
ret HandshakeResult { ok = true, code = r.code, bound = r.addr }
end
func _open(c: Client): ConnectResult:
mut r := ConnectResult {}
if c.tls:
mut cfg := tls.NewConfig(c.server_name)
if c.server_name.len() == 0: cfg = tls.NewConfig(c.host) end
cfg.insecure_skip_verify = c.insecure
t := tls.Dial(c.host, c.port, cfg)
if not tls.ConnOk(t):
r.err = "tls dial to proxy failed: " + tls.ConnError(t)
ret r
end
r.stream = tunnel.TlsStream { conn = t }
r.ok = true
ret r
end
conn := tcp.DialTimeout(c.host, c.port, c.timeout_ms)
if not tcp.ConnOk(conn):
r.err = "cannot reach proxy " + c.host + ":" + str.FromInt(c.port as i64)
ret r
end
r.stream = tunnel.TcpStream { conn = conn }
r.ok = true
ret r
end
@en "NewClient"
@fa "کلاینت جدید"
pub func NewClient(host: str, port: int): Client:
ret Client { host = host, port = port }
end
@en "NewClientAuth"
@fa "کلاینت جدید با احراز هویت"
pub func NewClientAuth(host: str, port: int, username: str, password: str): Client:
ret Client { host = host, port = port, username = username, password = password }
end
@en "ClientHandshake"
@fa "دست‌دهی کلاینت"
pub func ClientHandshake(s: dyn tunnel.Stream, c: Client, cmd: int, host: str, port: int): HandshakeResult:
s.SetDeadline(c.timeout_ms)
mut r := HandshakeResult {}
if c.version == Socks5:
r = _command5(s, c, cmd, host, port)
else:
r = _command4(s, c, cmd, host, port)
end
s.SetDeadline(0)
ret r
end
@en "Connect"
@fa "اتصال"
pub func Connect(c: Client, host: str, port: int): ConnectResult:
mut r := _open(c)
if not r.ok: ret r end
h := ClientHandshake(r.stream, c, CmdConnect, host, port)
if not h.ok:
r.stream.Close()
r.ok = false
r.code = h.code
r.err = h.err
ret r
end
r.code = h.code
r.bound = h.bound
ret r
end
@en "DialConn"
@fa "شماره‌گیری اتصال"
pub func DialConn(c: Client, host: str, port: int): tcp.Conn:
mut cc := c
cc.tls = false
conn := tcp.DialTimeout(cc.host, cc.port, cc.timeout_ms)
if not tcp.ConnOk(conn): ret conn end
st := tunnel.TcpStream { conn = conn }
h := ClientHandshake(st, cc, CmdConnect, host, port)
if not h.ok:
tcp.Close(conn)
ret tcp.Conn {}
end
ret conn
end
@en "Bind"
@fa "پیوند درخواست"
pub func Bind(c: Client, host: str, port: int): ConnectResult:
mut r := _open(c)
if not r.ok: ret r end
h := ClientHandshake(r.stream, c, CmdBind, host, port)
if not h.ok:
r.stream.Close()
r.ok = false
r.code = h.code
r.err = h.err
ret r
end
r.code = h.code
r.bound = h.bound
ret r
end
@en "BindAccept"
@fa "پذیرش پیوند"
pub func BindAccept(s: dyn tunnel.Stream, c: Client): HandshakeResult:
s.SetDeadline(c.timeout_ms)
r := HandshakeResult {}
mut out := r
if c.version == Socks5:
out = _read_reply(s)
else:
mut v := Vector {} as Vector<u8>
defer v.free()
if not _recv(s, v, 8):
out = _fail(Rep4Rejected, "reply truncated")
else:
mut rep := Reply {}
if not Decode4Reply(v, rep) or rep.code != Rep4Granted:
out = _fail(rep.code, ReplyText(rep.code))
else:
out = HandshakeResult { ok = true, code = rep.code, bound = rep.addr }
end
end
end
s.SetDeadline(0)
ret out
end
@en "Associate"
@fa "ایجاد نشست یو دی پی"
pub func Associate(c: Client): UDPSession:
mut u := UDPSession {}
if c.version != Socks5:
u.err = "UDP associate needs SOCKS5"
ret u
end
mut r := _open(c)
if not r.ok:
u.err = r.err
ret u
end
h := ClientHandshake(r.stream, c, CmdUDPAssociate, "0.0.0.0", 0)
if not h.ok:
r.stream.Close()
u.err = h.err
ret u
end
mut relay := h.bound.host
if relay == "0.0.0.0" or relay == "::" or relay.len() == 0: relay = c.host end
mut sock := udp.Bind(0)
if rawsock.IsIPv6(relay): sock = udp.BindOn("::", 0) end
if not udp.Ok(sock):
r.stream.Close()
u.err = "cannot open UDP socket"
ret u
end
u.control = r.stream
u.sock = sock
u.relay_host = relay
u.relay_port = h.bound.port
u.ok = true
ret u
end
@en "UDPSendBytes"
@fa "ارسال بایت یو دی پی"
pub func UDPSendBytes(u: UDPSession, host: str, port: int, ptr: void*, n: int): int:
hdr := EncodeUDPHeader(NewAddress(host, port), 0)
defer hdr.free()
hl := hdr.len()
if hl == 0: ret 0 - 1 end
buf := mem.Allocate((hl + n) as u64)
defer mem.Free(buf)
p := buf as u8*
repeat hl in i:
p[i] = hdr.get(i)
end
if n > 0: mem.Copy(((buf as i64) + (hl as i64)) as void*, ptr, n as u64) end
sent := udp.SendBytes(u.sock, u.relay_host, u.relay_port, buf, hl + n)
if sent < hl: ret 0 - 1 end
ret n
end
@en "UDPSend"
@fa "ارسال یو دی پی"
pub func UDPSend(u: UDPSession, host: str, port: int, data: str): int:
ret UDPSendBytes(u, host, port, data as void*, data.len())
end
@en "UDPReceiveBytes"
@fa "دریافت بایت یو دی پی"
pub func UDPReceiveBytes(u: UDPSession, buf: void*, max: int, from &: Address): int:
cap := max + 300
raw := mem.Allocate(cap as u64)
defer mem.Free(raw)
mut fh := ""
mut fp := 0
n := udp.ReceiveBytes(u.sock, raw, cap, fh, fp)
if n < 4: ret 0 - 1 end
mut v := Vector {} as Vector<u8>
defer v.free()
rp := raw as u8*
m := n
repeat m in i:
v.push(rp[i])
end
mut hd := UDPHeader {}
if not DecodeUDPHeader(v, hd): ret 0 - 1 end
if hd.frag != 0: ret 0 - 1 end
mut plen := n - hd.length
if plen > max: plen = max end
if plen > 0: mem.Copy(buf, ((raw as i64) + (hd.length as i64)) as void*, plen as u64) end
from = hd.addr
ret plen
end
@en "UDPSetTimeout"
@fa "تنظیم مهلت یو دی پی"
pub func UDPSetTimeout(u: UDPSession, millis: int):
udp.SetTimeout(u.sock, millis)
end
@en "CloseUDP"
@fa "بستن نشست یو دی پی"
pub func CloseUDP(u: UDPSession):
udp.Close(u.sock)
u.control.Close()
end
package socks
import mem
import str
import net.tcp
import net.internal.rawsock
import net.tunnel
if SALAM_OS_WINDOWS:
extern:
func _beginthread(start: void *, stack: u32, arg: void *): usize
end
else:
extern:
func pthread_create(thread: void *, attr: void *, start: void *, arg: void *): int
func pthread_detach(thread: u64): int
end
end
struct _Pump:
pub src: dyn tunnel.Stream = tunnel.TcpStream {}
pub dst: dyn tunnel.Stream = tunnel.TcpStream {}
pub total: i64 = 0
end
@en "Outbound"
@fa "خروجی"
pub struct Outbound:
@en "ok"
@fa "موفق"
pub ok: bool = false
@en "code"
@fa "کد"
pub code: int = 1
@en "err"
@fa "خطا"
pub err: str = ""
@en "stream"
@fa "جریان"
pub stream: dyn tunnel.Stream = tunnel.TcpStream {}
@en "bound"
@fa "نشانی محلی"
pub bound: Address = Address {}
end
@en "RelayStats"
@fa "آمار رله"
pub struct RelayStats:
@en "a_to_b"
@fa "از اول به دوم"
pub a_to_b: i64 = 0
@en "b_to_a"
@fa "از دوم به اول"
pub b_to_a: i64 = 0
end
if SALAM_OS_WINDOWS:
export:
func salam_vpn_go(fn: i64, arg: i64): i64:
h := _beginthread(fn as void *, 0 as u32, arg as void *)
if h == (0 as usize) or h == (0 - 1 as usize):
ret 0
end
ret 1
end
end
else:
export:
func salam_vpn_go(fn: i64, arg: i64): i64:
t := mem.Allocate(8 as u64)
if pthread_create(t, null, fn as void *, arg as void *) != 0:
mem.Free(t)
ret 0
end
tp := t as i64 *
pthread_detach(tp[0] as u64)
mem.Free(t)
ret 1
end
end
end
func _pump_run(p: _Pump*, cell: i64*):
buf := mem.Allocate(65536 as u64)
defer mem.Free(buf)
mut total := 0 as i64
mut live := true
until live:
n := p[0].src.ReadBytes(buf, 65536)
if n <= 0:
live = false
else p[0].dst.WriteBytes(buf, n) != n:
live = false
else:
total += n as i64
end
end
p[0].dst.Shutdown()
p[0].src.Shutdown()
cell[0] = total
end
func _pump_thread(arg: void*):
p := arg as _Pump*
_pump_run(p, ((arg as i64) + (sizeof(_Pump) as i64)) as i64*)
end
@en "Go"
@fa "برو"
pub func Go(fn: i64, arg: void*): bool:
ret salam_vpn_go(fn, arg as i64) != 0
end
@en "Relay"
@fa "رله"
pub func Relay(a: dyn tunnel.Stream, b: dyn tunnel.Stream, idle_ms: int): RelayStats:
if idle_ms > 0:
a.SetDeadline(idle_ms)
b.SetDeadline(idle_ms)
else:
a.SetDeadline(0)
b.SetDeadline(0)
end
sz := sizeof(_Pump) as i64
block := mem.AllocateZeroed((sz + 8 as i64) as u64)
pa := block as _Pump*
pa[0] = _Pump { src = a, dst = b }
cell_a := ((block as i64) + sz) as i64*
t := spawn(_pump_thread, block)
block2 := mem.AllocateZeroed((sz + 8 as i64) as u64)
pb := block2 as _Pump*
pb[0] = _Pump { src = b, dst = a }
cell_b := ((block2 as i64) + sz) as i64*
_pump_run(pb, cell_b)
join(t)
st := RelayStats { a_to_b = cell_a[0], b_to_a = cell_b[0] }
mem.Free(block)
mem.Free(block2)
a.Close()
b.Close()
ret st
end
@en "DirectConnect"
@fa "اتصال مستقیم"
pub func DirectConnect(host: str, port: int, timeout_ms: int): Outbound:
mut o := Outbound {}
c := tcp.DialTimeout(host, port, timeout_ms)
if not tcp.ConnOk(c):
o.ok = false
o.err = "cannot connect to " + host + ":" + str.FromInt(port as i64)
if rawsock.ResolveAny(host).len() == 0:
o.code = RepHostUnreachable
else:
o.code = RepConnRefused
end
ret o
end
o.ok = true
o.code = RepSucceeded
o.stream = tunnel.TcpStream { conn = c }
ret o
end
@en "PolicyConnect"
@fa "اتصال با سیاست"
pub func PolicyConnect(p: tunnel.DestPolicy, host: str, port: int, timeout_ms: int): Outbound:
mut o := Outbound {}
pl := tunnel.PolicyPlan(p, tunnel.NewAddr(host, port), true)
defer pl.ips.free()
if not pl.allowed:
o.code = RepNotAllowed
o.err = pl.reason
ret o
end
if pl.ips.len() == 0:
o.code = RepHostUnreachable
o.err = "cannot resolve " + host
ret o
end
mut tries := 0
repeat pl.ips.len() in i:
if tries < 4 and not o.ok:
tries++
o = DirectConnect(pl.ips[i], port, timeout_ms)
end
end
ret o
end
package socks
import mem
import sync
import net.tcp
import net.udp
import net.internal.rawsock
import net.tunnel
struct _AcceptJob:
pub cfg: ServerConfig = ServerConfig {}
pub listener: tcp.Server = tcp.Server {}
pub stop: i64* = null
pub limits: tunnel.ConnLimits = tunnel.ConnLimits {}
end
struct _ConnJob:
pub cfg: ServerConfig = ServerConfig {}
pub st: dyn tunnel.Stream = tunnel.TcpStream {}
pub peer: str = ""
pub limits: tunnel.ConnLimits = tunnel.ConnLimits {}
pub adm: tunnel.Admit = tunnel.Admit {}
end
struct _UState:
pub learned: bool = false
pub ch: str = ""
pub cp: int = 0
end
struct _UDPJob:
pub cfg: ServerConfig = ServerConfig {}
pub sock: udp.Socket = udp.Socket {}
pub osock: udp.Socket = udp.Socket {}
pub chost: str = ""
pub cport: int = 0
pub stop: i64* = null
end
@en "ServerConfig"
@fa "پیکربندی سرور"
pub struct ServerConfig:
@en "port"
@fa "درگاه"
pub port: int = 0
@en "require_auth"
@fa "نیاز به احراز هویت"
pub require_auth: bool = false
@en "users"
@fa "کاربران"
pub users: HashMap<str, str> = HashMap {}
@en "auth"
@fa "احراز هویت"
pub auth: func (str, str) bool = (_u: str, _p: str): ret false end
@en "has_auth"
@fa "دارای احراز هویت سفارشی"
pub has_auth: bool = false
@en "allow_v4"
@fa "اجازه ساکس۴"
pub allow_v4: bool = true
@en "allow_bind"
@fa "اجازه پیوند"
pub allow_bind: bool = false
@en "allow_udp"
@fa "اجازه یو دی پی"
pub allow_udp: bool = true
@en "bind_host"
@fa "میزبان پیوند"
pub bind_host: str = "127.0.0.1"
@en "handshake_timeout_ms"
@fa "مهلت دست‌دهی میلی‌ثانیه"
pub handshake_timeout_ms: int = 10000
@en "idle_timeout_ms"
@fa "مهلت بی‌کاری میلی‌ثانیه"
pub idle_timeout_ms: int = 0
@en "connect"
@fa "اتصال به مقصد"
pub connect: func (str, int) Outbound = (h: str, p: int): ret DirectConnect(h, p, 10000) end
@en "allow"
@fa "اجازه"
pub allow: func (int, str, int) bool = (_c: int, _h: str, _p: int): ret true end
@en "policy"
@fa "سیاست مقصد"
pub policy: tunnel.DestPolicy = tunnel.DestPolicy {}
@en "has_connect"
@fa "اتصال سفارشی دارد"
pub has_connect: bool = false
@en "max_connections"
@fa "بیشینه اتصال همزمان"
pub max_connections: int = 1024
@en "max_per_source"
@fa "بیشینه دست دادن مبدا"
pub max_per_source: int = 32
@en "handshake_deadline_ms"
@fa "مهلت کل دست‌دهی"
pub handshake_deadline_ms: int = 10000
end
@en "Server"
@fa "سرور"
pub struct Server:
@en "ok"
@fa "موفق"
pub ok: bool = false
@en "port"
@fa "درگاه"
pub port: int = 0
@en "host"
@fa "میزبان"
pub host: str = ""
@en "listener"
@fa "شنونده"
pub listener: tcp.Server = tcp.Server {}
@en "stop_cell"
@fa "پرچم توقف"
pub stop_cell: i64* = null
end
func _ct_eq(a: str, b: str): bool:
n := a.len()
m := b.len()
mut diff := n ^ m
pa := a as u8*
pb := b as u8*
mut i := 0
until i < n:
mut y := 0
if i < m: y = pb[i] as int end
diff |= (pa[i] as int) ^ y
i++
end
ret diff == 0
end
func _authorized(cfg: ServerConfig, user: str, pass: str): bool:
if cfg.users.has(user):
if _ct_eq(cfg.users.get(user), pass): ret true end
end
if cfg.has_auth: ret cfg.auth(user, pass) end
ret false
end
func _reply(s: dyn tunnel.Stream, ver: int, code: int, a: Address): bool:
if ver == 5:
v := EncodeReply(code, a)
defer v.free()
ret _send(s, v)
end
mut c := Rep4Rejected
if code == RepSucceeded: c = Rep4Granted end
mut host := "0.0.0.0"
if a.kind == AtypIPv4: host = a.host end
v := Encode4Reply(c, host, a.port)
defer v.free()
ret _send(s, v)
end
func _bind_host(cfg: ServerConfig): str:
if cfg.bind_host.len() == 0:
ret "127.0.0.1"
end
ret rawsock.CanonIP(cfg.bind_host)
end
func _wild(): Address:
ret Address { kind = AtypIPv4, host = "0.0.0.0", port = 0 }
end
func _read_cstr(s: dyn tunnel.Stream, v &: Vector<u8>, max: int): bool:
mut n := 0
until n <= max:
b := tunnel.ReadByte(s)
if b < 0: ret false end
v.push(b as u8)
if b == 0: ret true end
n++
end
ret false
end
func _policy(cfg: ServerConfig): tunnel.DestPolicy:
ret tunnel.PolicyForBind(cfg.policy, _bind_host(cfg))
end
func _outbound(cfg: ServerConfig, a: Address): Outbound:
pol := _policy(cfg)
if cfg.has_connect:
pl := tunnel.PolicyPlan(pol, tunnel.NewAddr(a.host, a.port), false)
if not pl.allowed:
ret Outbound { ok = false, code = RepNotAllowed, err = pl.reason }
end
ret cfg.connect(a.host, a.port)
end
ret PolicyConnect(pol, a.host, a.port, 10000)
end
func _do_connect(cfg: ServerConfig, s: dyn tunnel.Stream, ver: int, a: Address):
if not cfg.allow(CmdConnect, a.host, a.port):
_reply(s, ver, RepNotAllowed, _wild())
s.Close()
ret
end
out := _outbound(cfg, a)
if not out.ok:
mut code := out.code
if code == RepSucceeded: code = RepGeneralFailure end
_reply(s, ver, code, _wild())
s.Close()
ret
end
mut bound := out.bound
if bound.kind == 0: bound = _wild() end
if not _reply(s, ver, RepSucceeded, bound):
out.stream.Close()
s.Close()
ret
end
Relay(s, out.stream, cfg.idle_timeout_ms)
end
func _do_bind(cfg: ServerConfig, s: dyn tunnel.Stream, ver: int, a: Address):
if not cfg.allow_bind:
_reply(s, ver, RepCmdNotSupported, _wild())
s.Close()
ret
end
if not cfg.allow(CmdBind, a.host, a.port) or not tunnel.PolicyPlan(_policy(cfg), tunnel.NewAddr(a.host, a.port), false).allowed:
_reply(s, ver, RepNotAllowed, _wild())
s.Close()
ret
end
mut bh := _bind_host(cfg)
if a.kind == AtypIPv6 and rawsock.IsIPv4(bh):
if bh == "0.0.0.0":
bh = "::"
else:
bh = "::1"
end
end
ls := tcp.BindOn(bh, 0)
if not tcp.Ok(ls):
_reply(s, ver, RepGeneralFailure, _wild())
s.Close()
ret
end
port := tcp.Port(ls)
if not _reply(s, ver, RepSucceeded, NewAddress(bh, port)):
tcp.CloseServer(ls)
s.Close()
ret
end
waited := rawsock.WaitReadable(rawsock.FromFd(ls.fd), 60000)
if not waited:
tcp.CloseServer(ls)
_reply(s, ver, RepGeneralFailure, _wild())
s.Close()
ret
end
conn := tcp.Accept(ls)
tcp.CloseServer(ls)
if not tcp.ConnOk(conn):
_reply(s, ver, RepGeneralFailure, _wild())
s.Close()
ret
end
peer := tunnel.TcpStream { conn = conn }
mut pport := 0
phost := rawsock.PeerAddr(rawsock.FromFd(conn.fd), pport)
if not tunnel.PolicyCheckIP(_policy(cfg), phost):
peer.Close()
_reply(s, ver, RepNotAllowed, _wild())
s.Close()
ret
end
mut paddr := _wild()
if phost.len() > 0: paddr = NewAddress(phost, pport) end
if not _reply(s, ver, RepSucceeded, paddr):
peer.Close()
s.Close()
ret
end
Relay(s, peer, cfg.idle_timeout_ms)
end
func _decode_head(ibuf: void*, n: int, hd &: UDPHeader): bool:
mut hv := Vector {} as Vector<u8>
ip := ibuf as u8*
mut lim := n
if lim > 300: lim = 300 end
repeat lim in i:
hv.push(ip[i])
end
ok := DecodeUDPHeader(hv, hd)
hv.free()
ret ok
end
func _udp_forward(cfg: ServerConfig, osock: udp.Socket, ibuf: void*, n: int, hd: UDPHeader):
if hd.frag == 0 and cfg.allow(CmdUDPAssociate, hd.addr.host, hd.addr.port):
pl := tunnel.PolicyPlan(_policy(cfg), tunnel.NewAddr(hd.addr.host, hd.addr.port), true)
if pl.allowed and pl.ips.len() > 0:
plen := n - hd.length
udp.SendBytes(osock, pl.ips[0], hd.addr.port, ((ibuf as i64) + (hd.length as i64)) as void*, plen)
end
pl.ips.free()
end
end
func _udp_wrap(sock: udp.Socket, st: _UState, obuf: void*, ibuf: void*, n: int, fh: str, fp: int):
hdr := EncodeUDPHeader(NewAddress(fh, fp), 0)
hl := hdr.len()
if hl > 0:
op := obuf as u8*
repeat hl in i:
op[i] = hdr.get(i)
end
mem.Copy(((obuf as i64) + (hl as i64)) as void*, ibuf, n as u64)
udp.SendBytes(sock, st.ch, st.cp, obuf, hl + n)
end
hdr.free()
end
func _udp_thread(arg: i64):
jp := (arg as void*) as _UDPJob*
cfg := jp[0].cfg
sock := jp[0].sock
osock := jp[0].osock
chost := jp[0].chost
cport := jp[0].cport
stop := jp[0].stop
mem.Free(jp as void*)
split := osock.fd != sock.fd
cap := 65535 + 300
ibuf := mem.Allocate(cap as u64)
obuf := mem.Allocate(cap as u64)
mut st := _UState {}
mut expect := rawsock.CanonIP(chost)
if expect == "0.0.0.0" or expect == "::": expect = "" end
if cport != 0 and expect.len() > 0:
st.learned = true
st.ch = expect
st.cp = cport
end
rs := rawsock.FromFd(sock.fd)
ro := rawsock.FromFd(osock.fd)
until atomic_load(stop) != 0:
mut ready := 1
if split:
ready = rawsock.WaitReadable2(rs, ro, 400)
else:
if not rawsock.WaitReadable(rs, 400): ready = 0 end
end
if (ready & 1) != 0:
mut fh := ""
mut fp := 0
n := udp.ReceiveBytes(sock, ibuf, cap, fh, fp)
if n > 0:
mut hd := UDPHeader {}
if st.learned and fh == st.ch and fp == st.cp:
if _decode_head(ibuf, n, hd): _udp_forward(cfg, osock, ibuf, n, hd) end
else not st.learned and (expect.len() == 0 or fh == expect):
if _decode_head(ibuf, n, hd):
st.learned = true
st.ch = fh
st.cp = fp
_udp_forward(cfg, osock, ibuf, n, hd)
end
else st.learned and not split:
_udp_wrap(sock, st, obuf, ibuf, n, fh, fp)
end
end
end
if split and (ready & 2) != 0:
mut fh := ""
mut fp := 0
n := udp.ReceiveBytes(osock, ibuf, cap, fh, fp)
if n > 0 and st.learned:
_udp_wrap(sock, st, obuf, ibuf, n, fh, fp)
end
end
end
udp.Close(sock)
if split:
udp.Close(osock)
end
mem.Free(stop as void*)
mem.Free(ibuf)
mem.Free(obuf)
end
func _do_udp(cfg: ServerConfig, s: dyn tunnel.Stream, a: Address, peer: str):
if not cfg.allow_udp:
_reply(s, 5, RepCmdNotSupported, _wild())
s.Close()
ret
end
bh := _bind_host(cfg)
us := udp.BindOn(bh, 0)
if not udp.Ok(us):
_reply(s, 5, RepGeneralFailure, _wild())
s.Close()
ret
end
mut os := us
if bh != "::":
wide := udp.OpenAny()
if udp.Ok(wide): os = wide end
end
stop := mem.AllocateZeroed(8 as u64) as i64*
atomic_store(stop, 1 as i64)
jb := mem.AllocateZeroed(sizeof(_UDPJob) as u64) as _UDPJob*
mut chost := a.host
if (chost == "0.0.0.0" or chost == "::" or chost.len() == 0) and peer.len() > 0:
chost = peer
end
jb[0] = _UDPJob { cfg = cfg, sock = us, osock = os, chost = chost, cport = a.port, stop = stop }
if not _reply(s, 5, RepSucceeded, NewAddress(bh, udp.Port(us))):
udp.Close(us)
if os.fd != us.fd: udp.Close(os) end
mem.Free(stop as void*)
mem.Free(jb as void*)
s.Close()
ret
end
Go(_udp_thread, jb as void*)
s.SetDeadline(0)
buf := mem.Allocate(64 as u64)
until s.ReadBytes(buf, 64) > 0:
continue
end
mem.Free(buf)
atomic_store(stop, 0 as i64)
s.Close()
end
func _hs5(cfg: ServerConfig, s: dyn tunnel.Stream, req &: Request, user &: str): bool:
nm := tunnel.ReadByte(s)
if nm <= 0:
ret false
end
mut mv := Vector {} as Vector<u8>
defer mv.free()
if not _recv(s, mv, nm):
ret false
end
mut has0 := false
mut has2 := false
repeat nm in i:
if _b(mv, i) == AuthNone: has0 = true end
if _b(mv, i) == AuthUserPass: has2 = true end
end
mut choice := AuthNoAcceptable
if cfg.require_auth:
if has2: choice = AuthUserPass end
else has0:
choice = AuthNone
end
cv := EncodeMethodChoice(choice)
_send(s, cv)
cv.free()
if choice == AuthNoAcceptable:
ret false
end
if choice == AuthUserPass:
if tunnel.ReadByte(s) != 1:
ret false
end
ul := tunnel.ReadByte(s)
mut uv := Vector {} as Vector<u8>
defer uv.free()
if ul < 1 or not _recv(s, uv, ul):
ret false
end
pl := tunnel.ReadByte(s)
mut pv := Vector {} as Vector<u8>
defer pv.free()
if pl < 0 or (pl > 0 and not _recv(s, pv, pl)):
ret false
end
uname := _bytes_str(uv, 0, ul)
okp := _authorized(cfg, uname, _bytes_str(pv, 0, pl))
ar := EncodeAuthReply(okp)
_send(s, ar)
ar.free()
if not okp:
ret false
end
user = uname
end
mut rq := Vector {} as Vector<u8>
defer rq.free()
if not _recv(s, rq, 4):
ret false
end
t := _b(rq, 3)
mut more := 0
if t == AtypIPv4:
more = 6
else t == AtypIPv6:
more = 18
else t == AtypDomain:
if not _recv(s, rq, 1):
ret false
end
more = _b(rq, 4) + 2
else:
_reply(s, 5, RepAtypNotSupported, _wild())
ret false
end
if not _recv(s, rq, more):
ret false
end
if DecodeRequest(rq, req) <= 0:
_reply(s, 5, RepGeneralFailure, _wild())
ret false
end
ret true
end
func _serve5(cfg: ServerConfig, s: dyn tunnel.Stream, peer: str, lim: tunnel.ConnLimits, adm &: tunnel.Admit):
mut req := Request {}
mut user := ""
okh := _hs5(cfg, s, req, user)
tunnel.LimitsHandshakeDone(lim, adm)
if not okh:
s.Close()
ret
end
switch req.cmd:
1:
_do_connect(cfg, s, 5, req.addr)
break
end
2:
_do_bind(cfg, s, 5, req.addr)
break
end
3:
_do_udp(cfg, s, req.addr, peer)
break
end
else:
_reply(s, 5, RepCmdNotSupported, _wild())
s.Close()
end
end
end
func _hs4(cfg: ServerConfig, s: dyn tunnel.Stream, req &: Request): bool:
mut v := Vector {} as Vector<u8>
defer v.free()
v.push(4 as u8)
if not _recv(s, v, 7):
ret false
end
if not _read_cstr(s, v, 255):
ret false
end
if _b(v, 4) == 0 and _b(v, 5) == 0 and _b(v, 6) == 0 and _b(v, 7) != 0:
if not _read_cstr(s, v, 255):
ret false
end
end
if Decode4Request(v, req) <= 0:
_reply(s, 4, RepGeneralFailure, _wild())
ret false
end
if cfg.require_auth:
bad := Encode4Reply(Rep4BadUser, "0.0.0.0", 0)
_send(s, bad)
bad.free()
ret false
end
ret true
end
func _serve4(cfg: ServerConfig, s: dyn tunnel.Stream, lim: tunnel.ConnLimits, adm &: tunnel.Admit):
mut req := Request {}
okh := _hs4(cfg, s, req)
tunnel.LimitsHandshakeDone(lim, adm)
if not okh:
s.Close()
ret
end
switch req.cmd:
1:
_do_connect(cfg, s, 4, req.addr)
break
end
2:
_do_bind(cfg, s, 4, req.addr)
break
end
else:
_reply(s, 4, RepCmdNotSupported, _wild())
s.Close()
end
end
end
func _handle(cfg: ServerConfig, s: dyn tunnel.Stream, peer: str, lim: tunnel.ConnLimits, adm &: tunnel.Admit):
s.SetDeadline(cfg.handshake_timeout_ms)
v := tunnel.ReadByte(s)
if v == 5:
_serve5(cfg, s, peer, lim, adm)
else v == 4 and cfg.allow_v4:
_serve4(cfg, s, lim, adm)
else:
tunnel.LimitsHandshakeDone(lim, adm)
s.Close()
end
end
func _conn_thread(arg: i64):
jp := (arg as void*) as _ConnJob*
cfg := jp[0].cfg
st := jp[0].st
peer := jp[0].peer
lim := jp[0].limits
mut adm := jp[0].adm
mem.Free(jp as void*)
_handle(cfg, st, peer, lim, adm)
tunnel.LimitsRelease(lim, adm)
end
func _accept_thread(arg: i64):
jp := (arg as void*) as _AcceptJob*
cfg := jp[0].cfg
lst := jp[0].listener
stop := jp[0].stop
limits := jp[0].limits
mem.Free(jp as void*)
until atomic_load(stop) != 0:
c := tcp.Accept(lst)
if atomic_load(stop) == 0:
if tcp.ConnOk(c): tcp.Close(c) end
else not tcp.ConnOk(c):
sync.SleepMs(5)
else:
adm := tunnel.LimitsEnter(limits, c.fd)
if not adm.ok:
tcp.Close(c)
else:
cj := mem.AllocateZeroed(sizeof(_ConnJob) as u64) as _ConnJob*
cj[0] = _ConnJob { cfg = cfg, st = tunnel.TcpStream { conn = c }, peer = adm.host, limits = limits, adm = adm }
if not Go(_conn_thread, cj as void*):
mut failed := adm
tunnel.LimitsRelease(limits, failed)
tcp.Close(c)
mem.Free(cj as void*)
end
end
end
end
tcp.CloseServer(lst)
mem.Free(stop as void*)
end
@en "NewServerConfig"
@fa "پیکربندی سرور جدید"
pub func NewServerConfig(port: int): ServerConfig:
ret ServerConfig { port = port }
end
@en "AddUser"
@fa "افزودن کاربر"
pub func AddUser(cfg &: ServerConfig, user: str, pass: str):
cfg.users.put(user, pass)
cfg.require_auth = true
end
@en "SetAuth"
@fa "تعیین احراز هویت"
pub func SetAuth(cfg &: ServerConfig, check: func (str, str) bool):
cfg.auth = check
cfg.has_auth = true
cfg.require_auth = true
end
@en "SetConnector"
@fa "تعیین اتصال به مقصد"
pub func SetConnector(cfg &: ServerConfig, connect: func (str, int) Outbound):
cfg.connect = connect
cfg.has_connect = true
end
@en "SetPolicy"
@fa "تعیین سیاست مقصد"
pub func SetPolicy(cfg &: ServerConfig, p: tunnel.DestPolicy):
cfg.policy = p
end
@en "AllowPrivate"
@fa "اجازه آدرس‌های خصوصی"
pub func AllowPrivate(cfg &: ServerConfig, enabled: bool):
cfg.policy.allow_private = enabled
end
@en "Handle"
@fa "رسیدگی"
pub func Handle(cfg: ServerConfig, s: dyn tunnel.Stream):
mut adm := tunnel.Admit { done = true }
_handle(cfg, s, "", tunnel.ConnLimits {}, adm)
end
@en "Start"
@fa "شروع"
pub func Start(cfg: ServerConfig): Server:
mut sv := Server {}
ls := tcp.BindOn(_bind_host(cfg), cfg.port)
if not tcp.Ok(ls): ret sv end
stop := mem.AllocateZeroed(8 as u64) as i64*
atomic_store(stop, 1 as i64)
jb := mem.AllocateZeroed(sizeof(_AcceptJob) as u64) as _AcceptJob*
jb[0] = _AcceptJob { cfg = cfg, listener = ls, stop = stop, limits = tunnel.NewConnLimits(cfg.max_connections, cfg.max_per_source, cfg.handshake_deadline_ms) }
sv.ok = true
sv.port = tcp.Port(ls)
sv.host = _bind_host(cfg)
sv.listener = ls
sv.stop_cell = stop
Go(_accept_thread, jb as void*)
ret sv
end
@en "Stop"
@fa "توقف"
pub func Stop(sv: Server):
if not sv.ok: ret end
atomic_store(sv.stop_cell, 0 as i64)
rawsock.Shutdown(rawsock.FromFd(sv.listener.fd))
tcp.WakeServer(sv.host, sv.port)
end
@en "Serve"
@fa "خدمت‌رسانی"
pub func Serve(cfg: ServerConfig): bool:
sv := Start(cfg)
if not sv.ok: ret false end
until sv.ok:
sync.SleepMs(1000)
end
ret true
end
@en "net/socks"
@fa "ساکس"
package socks
import mem
import str
@en "VerSocks5"
@fa "نسخه ساکس۵"
pub const VerSocks5 := 5
@en "VerSocks4"
@fa "نسخه ساکس۴"
pub const VerSocks4 := 4
