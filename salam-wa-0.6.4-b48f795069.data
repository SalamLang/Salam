ci = ci + "port=" + conv.FormatInt(port as i64) + " "
end
if user != "":
ci = ci + "user=" + user + " "
end
if pass != "":
ci = ci + "password=" + pass + " "
end
if dbname != "":
ci = ci + "dbname=" + dbname
end
ret Open(ci)
end
