@en "keys"
@fa "کلیدها"
package keys
import dom
tracked: str[32]
held: bool[32]
once: bool[32]
mut ntracked := 0
func find(k: str): int:
repeat ntracked in i:
if tracked[i] == k: ret i end
end
ret -1
end
@en "Track"
@fa "پیگیری"
pub func Track(k: str):
if find(k) >= 0: ret end
if ntracked >= 32: ret end
tracked[ntracked] = k
held[ntracked] = false
once[ntracked] = false
ntracked++
end
@en "Init"
@fa "آماده سازی"
pub func Init():
Track("ArrowUp")
Track("ArrowDown")
Track("ArrowLeft")
Track("ArrowRight")
Track("Enter")
Track(" ")
dom.OnWindowE(
"keydown", (ev: i64): i := find(dom.EventKey(ev)) if i >= 0: if not held[i]: once[i] = true end held[i] = true dom.PreventDefault(ev) end end
)
dom.OnWindowE(
"keyup", (ev: i64): i := find(dom.EventKey(ev)) if i >= 0: held[i] = false end end
)
end
@en "Down"
@fa "نگه داشته"
pub func Down(k: str): bool:
i := find(k)
ret i >= 0 and held[i]
end
@en "Pressed"
@fa "فشرده شد"
pub func Pressed(k: str): bool:
i := find(k)
if i < 0: ret false end
if once[i]:
once[i] = false
ret true
end
ret false
end
package web
import str
mut g_web_color_names := HashMap {} as HashMap<str, int>
mut g_web_color_rgb := HashMap {} as HashMap<int, str>
mut g_web_colors_ready := false
@en "Url"
@fa "نشانی وب"
pub struct Url:
value: str = ""
@en "set"
@fa "تنظیم"
