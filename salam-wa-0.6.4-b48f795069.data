defer out_lines.free()
mut started := false
n := lines.len()
mut i := 0
until i < n:
raw := lines.get(i)
t := str.Trim(raw)
is_sep := t == "---"
is_end := t == "..."
blank := t == ""
mem.Free(t as void *)
if is_sep:
if started: break end
else is_end:
break
else:
if not blank: started = true end
out_lines.push(raw)
end
i++
end
out := str.Join(out_lines, "\n")
repeat n in k:
mem.Free(lines.get(k) as void *)
end
ret out
end
func _parse_document(text: str): _YR:
