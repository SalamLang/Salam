@fa "مجموعه فیلترشده"
pub func FilteredSet(): DomainSet:
mut s := NewDomainSet()
_n := AddRules(s, FilteredList())
ret s
end
package censor
import mem
import crypto
import compress
@en "SplitEven"
@fa "تقسیم مساوی"
pub const SplitEven := 0
@en "SplitRandom"
@fa "تقسیم تصادفی"
pub const SplitRandom := 1
@en "SplitFirst"
@fa "تقسیم پس از نخستین تکه"
pub const SplitFirst := 2
@en "MaxRecordPayload"
@fa "بیشینه داده رکورد"
pub const MaxRecordPayload := 16000
func _next(state &: u64): u64:
mut x := state
x ^= (x << (13 as u64))
x ^= (x >> (7 as u64))
x ^= (x << (17 as u64))
state = x
ret x
end
func _seed_of(seed: i64): u64:
if seed != 0:
ret seed as u64
end
buf := mem.Allocate(8 as u64)
defer mem.Free(buf)
crypto.RandomBytes(buf, 8)
mut v := 0 as u64
repeat 8 in i:
v = (v << (8 as u64)) | (((buf as u8*)[i]) as u64)
end
if v == (0 as u64):
v = 88172645463325252 as u64
end
ret v
end
@en "SplitSizes"
@fa "اندازه تکه‌ها"
pub func SplitSizes(total: int, policy: int, pieces: int, param: int, seed: i64): Vector<int>:
mut out := Vector {} as Vector<int>
if total <= 0:
ret out
end
mut k := pieces
if k < 1:
k = 1
end
if k > total:
k = total
end
if policy == SplitFirst:
mut f := param
if f < 1:
f = 1
end
if f >= total:
out.push(total)
ret out
end
out.push(f)
out.push(total - f)
ret out
end
if policy == SplitRandom:
mut st := _seed_of(seed)
mut cuts := Vector {} as Vector<int>
defer cuts.free()
until cuts.len() < k - 1:
c := 1 + ((_next(st) % ((total - 1) as u64)) as int)
mut dup := false
repeat cuts.len() in i:
if cuts.get(i) == c:
dup = true
end
end
if not dup:
cuts.push(c)
end
end
mut sorted := Vector {} as Vector<int>
defer sorted.free()
mut prev := 0
repeat k - 1:
mut best := 0 - 1
repeat cuts.len() in i:
v := cuts.get(i)
if v > prev and (best < 0 or v < best):
best = v
end
end
sorted.push(best)
prev = best
end
mut last := 0
repeat sorted.len() in i:
out.push(sorted.get(i) - last)
last = sorted.get(i)
end
out.push(total - last)
ret out
end
base := total / k
extra := total % k
repeat k in i:
mut s := base
if i < extra:
s++
end
out.push(s)
end
ret out
end
@en "SNISplitSizes"
@fa "اندازه تکه‌ها از روی نام سرور"
pub func SNISplitSizes(p: void*, n: int, head_first: bool): Vector<int>:
mut out := Vector {} as Vector<int>
ch := ParseClientHello(p, n)
if not ch.ok or ch.sni_offset < 0 or ch.sni_len < 2:
ret SplitSizes(n, SplitEven, 2, 0, 1 as i64)
end
cut := ch.sni_offset + ch.sni_len / 2
if head_first and cut > 1:
out.push(1)
out.push(cut - 1)
else:
out.push(cut)
end
if n - cut > 0:
out.push(n - cut)
end
ret out
end
@en "Slice"
@fa "برش"
pub func Slice(p: void*, n: int, sizes: Vector<int>): Vector<compress.ByteBuf>:
mut out := Vector {} as Vector<compress.ByteBuf>
mut off := 0
repeat sizes.len() in i:
mut s := sizes.get(i)
if i == sizes.len() - 1:
s = n - off
end
if s <= 0 or off + s > n:
break
end
mut b := compress.NewByteBufCap(s)
compress.BufPushBytes(b, ((p as i64) + (off as i64)) as void*, s)
out.push(b)
off += s
end
ret out
end
@en "FragmentRecords"
@fa "تکه‌تکه کردن رکوردها"
pub func FragmentRecords(p: void*, n: int, sizes: Vector<int>): Vector<compress.ByteBuf>:
mut out := Vector {} as Vector<compress.ByteBuf>
if n < 6:
ret out
end
ctype := _ub(p, 0)
v1 := _ub(p, 1)
v2 := _ub(p, 2)
payload_len := n - 5
body := ((p as i64) + 5) as void*
mut off := 0
repeat sizes.len() in i:
mut s := sizes.get(i)
if i == sizes.len() - 1:
s = payload_len - off
end
if s <= 0 or off + s > payload_len:
break
end
mut b := compress.NewByteBufCap(s + 5)
compress.BufPush(b, ctype)
compress.BufPush(b, v1)
compress.BufPush(b, v2)
compress.BufPush(b, (s >> 8) & 255)
compress.BufPush(b, s & 255)
compress.BufPushBytes(b, ((body as i64) + (off as i64)) as void*, s)
out.push(b)
off += s
end
ret out
end
@en "FragmentClientHello"
@fa "تکه‌تکه کردن پیام آغازین"
pub func FragmentClientHello(p: void*, n: int, pieces: int, policy: int, seed: i64): Vector<compress.ByteBuf>:
if n < 6 or _ub(p, 0) != 22:
ret Vector {}
end
sizes := SplitSizes(n - 5, policy, pieces, 1, seed)
defer sizes.free()
ret FragmentRecords(p, n, sizes)
end
@en "Concat"
@fa "پیوست"
pub func Concat(pieces: Vector<compress.ByteBuf>): compress.ByteBuf:
mut b := compress.NewByteBuf()
repeat pieces.len() in i:
compress.BufPushBuf(b, pieces.get(i))
end
ret b
end
@en "FreePieces"
@fa "آزاد کردن تکه‌ها"
pub func FreePieces(pieces &: Vector<compress.ByteBuf>):
repeat pieces.len() in i:
mut b := pieces.get(i)
compress.BufFree(b)
end
pieces.free()
end
package censor
import mem
import crypto
import compress
@en "RandomInt"
@fa "عدد تصادفی"
pub func RandomInt(lo: int, hi: int): int:
if hi <= lo:
ret lo
end
buf := mem.Allocate(4 as u64)
defer mem.Free(buf)
crypto.RandomBytes(buf, 4)
mut v := 0
repeat 3 in i:
v = v * 256 + (((buf as u8*)[i]) as int)
end
ret lo + v % (hi - lo + 1)
end
@en "RandomBytes"
@fa "بایت‌های تصادفی"
pub func RandomBytes(n: int): compress.ByteBuf:
mut b := compress.NewByteBufCap(n)
if n > 0:
tmp := mem.Allocate(n as u64)
crypto.RandomBytes(tmp, n)
compress.BufPushBytes(b, tmp, n)
mem.Free(tmp)
end
ret b
end
@en "PadLength"
@fa "طول لایه"
pub func PadLength(payload_len: int, min_pad: int, max_pad: int, block: int): int:
mut pad := RandomInt(min_pad, max_pad)
if block > 1:
rem := (payload_len + pad) % block
if rem != 0:
pad += block - rem
end
end
ret pad
end
@en "WrapRecord"
@fa "پوشاندن رکورد"
pub func WrapRecord(p: void*, n: int, pad: int): compress.ByteBuf:
mut out := compress.NewByteBuf()
body := n + pad + 4
if n < 0 or pad < 0 or body > 16384:
ret out
end
compress.BufPush(out, 23)
compress.BufPush(out, 3)
compress.BufPush(out, 3)
compress.BufPush(out, (body >> 8) & 255)
compress.BufPush(out, body & 255)
compress.BufPush(out, (n >> 8) & 255)
compress.BufPush(out, n & 255)
compress.BufPush(out, (pad >> 8) & 255)
compress.BufPush(out, pad & 255)
compress.BufPushBytes(out, p, n)
mut junk := RandomBytes(pad)
compress.BufPushBuf(out, junk)
compress.BufFree(junk)
ret out
end
@en "UnwrapRecord"
@fa "گشودن رکورد"
pub func UnwrapRecord(p: void*, n: int, payload &: compress.ByteBuf): int:
if n < 1:
ret 0
end
if _ub(p, 0) != 23:
ret 0 - 1
end
if n >= 2 and _ub(p, 1) != 3:
ret 0 - 1
end
if n >= 3 and _ub(p, 2) != 3:
ret 0 - 1
end
if n < 5:
ret 0
end
body := _u16(p, 3)
if body < 4 or body > 16384:
ret 0 - 1
end
if n < 5 + body:
ret 0
end
plen := _u16(p, 5)
pad := _u16(p, 7)
if plen + pad + 4 != body:
ret 0 - 1
end
compress.BufPushBytes(payload, ((p as i64) + 9) as void*, plen)
ret 5 + body
end
@en "WrapStream"
@fa "پوشاندن جریان"
pub func WrapStream(p: void*, n: int, min_pad: int, max_pad: int): compress.ByteBuf:
mut out := compress.NewByteBuf()
mut off := 0
until off < n:
mut take := n - off
if take > MaxRecordPayload:
take = MaxRecordPayload
end
pad := PadLength(take, min_pad, max_pad, 0)
mut rec := WrapRecord(((p as i64) + (off as i64)) as void*, take, pad)
compress.BufPushBuf(out, rec)
compress.BufFree(rec)
off += take
end
ret out
end
package censor
import str
@en "ProbeGuard"
@fa "نگهبان کاوش"
pub struct ProbeGuard:
@en "max_fails"
@fa "بیشینه شکست"
pub max_fails: int = 5
@en "window_ms"
@fa "بازه شمارش"
pub window_ms: i64 = 60000
@en "ban_ms"
@fa "مدت مسدودی"
pub ban_ms: i64 = 600000
@en "fails"
@fa "شکست‌ها"
pub fails: HashMap<str, int> = HashMap {}
@en "first_ms"
@fa "آغاز بازه"
pub first_ms: HashMap<str, i64> = HashMap {}
@en "banned_until"
@fa "زمان رفع مسدودی"
pub banned_until: HashMap<str, i64> = HashMap {}
end
@en "ReplayCache"
@fa "حافظه تکرار"
pub struct ReplayCache:
@en "ttl_ms"
@fa "ماندگاری"
pub ttl_ms: i64 = 120000
@en "max_entries"
@fa "بیشینه ورودی"
pub max_entries: int = 4096
@en "seen"
@fa "دیده‌شده"
pub seen: HashMap<str, i64> = HashMap {}
end
@en "NewProbeGuard"
@fa "نگهبان کاوش جدید"
pub func NewProbeGuard(max_fails: int, window_ms: i64, ban_ms: i64): ProbeGuard:
ret ProbeGuard { max_fails = max_fails, window_ms = window_ms, ban_ms = ban_ms }
end
@en "GuardAllowed"
@fa "اجازه نگهبان"
pub func GuardAllowed(g: ProbeGuard, ip: str, now_ms: i64): bool:
if not g.banned_until.has(ip):
ret true
end
ret now_ms >= g.banned_until.get(ip)
end
@en "GuardRecordFail"
@fa "ثبت شکست"
pub func GuardRecordFail(g &: ProbeGuard, ip: str, now_ms: i64): bool:
mut n := 0
if g.fails.has(ip) and now_ms - g.first_ms.get(ip) <= g.window_ms:
n = g.fails.get(ip)
else:
g.first_ms.put(ip, now_ms)
end
n++
g.fails.put(ip, n)
if n >= g.max_fails:
g.banned_until.put(ip, now_ms + g.ban_ms)
g.fails.put(ip, 0)
ret true
end
ret false
end
@en "GuardRecordOK"
@fa "ثبت موفقیت"
pub func GuardRecordOK(g &: ProbeGuard, ip: str):
g.fails.put(ip, 0)
end
@en "FreeProbeGuard"
@fa "آزاد کردن نگهبان"
pub func FreeProbeGuard(g &: ProbeGuard):
g.fails.free()
g.first_ms.free()
g.banned_until.free()
end
@en "NewReplayCache"
@fa "حافظه تکرار جدید"
pub func NewReplayCache(ttl_ms: i64, max_entries: int): ReplayCache:
ret ReplayCache { ttl_ms = ttl_ms, max_entries = max_entries }
end
@en "ReplaySeen"
@fa "تکراری است"
pub func ReplaySeen(c &: ReplayCache, key: str, now_ms: i64): bool:
if c.seen.has(key):
if now_ms - c.seen.get(key) <= c.ttl_ms:
ret true
end
end
if c.seen.size() >= c.max_entries:
mut old := Vector {} as Vector<str>
defer old.free()
each k, v in c.seen:
if now_ms - v > c.ttl_ms:
old.push(k)
end
end
repeat old.len() in i:
c.seen.remove(old.get(i))
end
end
c.seen.put(key, now_ms)
ret false
end
@en "FreeReplayCache"
@fa "آزاد کردن حافظه تکرار"
pub func FreeReplayCache(c &: ReplayCache):
c.seen.free()
end
@en "ShouldFallback"
@fa "باید جایگزین شود"
pub func ShouldFallback(authenticated: bool): bool:
ret not authenticated
end
@en "DelayMs"
@fa "تاخیر تصادفی"
pub func DelayMs(min_ms: int, max_ms: int): int:
ret RandomInt(min_ms, max_ms)
end
@en "DecoyResponse"
@fa "پاسخ طعمه"
pub func DecoyResponse(): str:
body := "<html>\r\n<head><title>404 Not Found</title></head>\r\n<body>\r\n<center><h1>404 Not Found</h1></center>\r\n<hr><center>nginx</center>\r\n</body>\r\n</html>\r\n"
ret "HTTP/1.1 404 Not Found\r\nServer: nginx\r\nContent-Type: text/html\r\nContent-Length: " + str.FromInt(body.len() as i64) + "\r\nConnection: close\r\n\r\n" + body
end
