mut c := _e.ctl.ref(f)
old_pre := c.preedit
c.preedit = ""
_sfree(old_pre)
_replace_selection(f, clean)
_refresh_control(f)
mut ev := _make_event("input", f)
ev.text = clean
_fire_ev(f, ev, true)
