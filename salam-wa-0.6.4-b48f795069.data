b = k
end
end
end
alive.set(a, false)
alive.set(b, false)
weight.push(weight.get(a) + weight.get(b))
parent.push(0 - 1)
leaf.push(0 - 1)
alive.push(true)
node := weight.len() - 1
parent.set(a, node)
parent.set(b, node)
live--
