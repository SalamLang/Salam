@en "debug"
@fa "اشکال زدایی"
package debug
import str
import conv
import time
import mem
if SALAM_OS_WINDOWS:
link dynamic "kernel32"
extern:
func DebugBreak()
end
else:
extern:
func raise(sig: int): int
end
end
extern:
noret func abort()
end
mut _frames := Vector {} as Vector<str>
mut _trace_enabled := false
mut _timer_names := Vector {} as Vector<str>
mut _timer_starts := Vector {} as Vector<i64>
func _find_timer(name: str): int:
repeat _timer_names.len() in i:
if _timer_names.get(i) == name: ret i end
end
ret 0 - 1
end
@en "Assert"
@fa "ادعا"
pub func Assert(cond: bool, msg: str):
if cond == false:
printerrln "assertion failed: ".concat(msg)
abort()
end
end
@en "AssertNotNil"
@fa "ادعای خالی نبودن"
pub func AssertNotNil(p: void*, msg: str): Assert(p != null, msg) end
@en "Enter"
@fa "ورود"
pub func Enter(frame: str):
_frames.push(frame)
if _trace_enabled: Trace("enter") end
end
@en "Exit"
@fa "خروج"
pub func Exit():
n := _frames.len()
if n > 0:
if _trace_enabled: Trace("exit") end
_frames.remove_at(n - 1)
end
end
@en "Stack"
@fa "پشته"
pub func Stack(): str:
mut b := str.NewBuilder()
defer str.BufFree(b)
repeat _frames.len() in i:
if i > 0: str.BufAppend(b, " > ") end
str.BufAppend(b, _frames.get(i))
end
ret str.BufStr(b)
end
@en "Depth"
@fa "عمق"
pub func Depth(): int: ret _frames.len() end
@en "EnableTrace"
@fa "فعال‌سازی ردیابی"
pub func EnableTrace(enabled: bool): _trace_enabled = enabled end
@en "TraceEnabled"
@fa "ردیابی فعال است"
pub func TraceEnabled(): bool: ret _trace_enabled end
@en "Trace"
@fa "ردیابی"
pub func Trace(msg: str):
if _trace_enabled == false: ret end
mut line := "[TRACE] "
s := Stack()
if s.len() > 0: line = line.concat(s).concat(": ") end
line = line.concat(msg)
printerrln line
end
@en "StartTimer"
@fa "شروع تایمر"
pub func StartTimer(name: str):
idx := _find_timer(name)
now := time.MonoNanos()
if idx >= 0:
_timer_starts.set(idx, now)
else:
_timer_names.push(name)
_timer_starts.push(now)
end
end
@en "StopTimer"
@fa "پایان تایمر"
pub func StopTimer(name: str): f64:
idx := _find_timer(name)
if idx < 0: ret 0.0 end
started := _timer_starts.get(idx)
now := time.MonoNanos()
ret ((now - started) as f64) / 1000000.0
end
@en "Break"
@fa "شکست‌نقطه"
pub func Break():
if SALAM_OS_WINDOWS:
DebugBreak()
else:
raise(5)
end
end
@en "MemStats"
@fa "آمار حافظه"
pub func MemStats(): str:
if mem.MemDebugActive() == false:
ret "mem stats unavailable (build with -DSALAM_MEM_DEBUG or --asan to enable)"
end
mut b := str.NewBuilder()
defer str.BufFree(b)
str.BufAppend(b, "allocs=")
str.BufAppend(b, conv.FormatInt(mem.AllocCount()))
str.BufAppend(b, " frees=")
str.BufAppend(b, conv.FormatInt(mem.FreeCount()))
str.BufAppend(b, " live=")
str.BufAppend(b, conv.FormatInt(mem.LiveBytes()))
str.BufAppend(b, " peak=")
str.BufAppend(b, conv.FormatInt(mem.PeakBytes()))
ret str.BufStr(b)
end
package decimal
import bigint
import str
func _emit_digits(b &: str.StringBuilder, digits: str, scale: int):
n := str.Len(digits)
if scale <= 0:
str.BufAppend(b, digits)
ret
end
if n <= scale:
str.BufAppendChar(b, 48)
str.BufAppendChar(b, 46)
repeat scale - n: str.BufAppendChar(b, 48) end
str.BufAppend(b, digits)
ret
end
cut := n - scale
repeat cut in i: str.BufAppendChar(b, digits[i] as int) end
str.BufAppendChar(b, 46)
mut i := cut
until i < n:
str.BufAppendChar(b, digits[i] as int)
i++
end
end
@en "ToStr"
@fa "به رشته"
pub func ToStr(d: Dec): str:
if d.scale <= 0: ret bigint.ToStr(d.unscaled) end
mut a := bigint.Abs(d.unscaled)
digits := bigint.ToStr(a)
a.free()
mut b := str.NewBuilder()
if d.unscaled.sign() < 0: str.BufAppendChar(b, 45) end
_emit_digits(b, digits, d.scale)
out := str.BufStr(b)
str.BufFree(b)
ret out
end
@en "ToStrFixed"
@fa "به رشته ثابت"
pub func ToStrFixed(d: Dec, scale: int): str:
mut r := Round(d, scale)
s := ToStr(r)
r.free()
ret s
end
@en "FormatGrouped"
@fa "قالب گروهی"
pub func FormatGrouped(d: Dec, scale: int, group: str, point: str): str:
mut r := Round(d, scale)
mut a := bigint.Abs(r.unscaled)
digits := bigint.ToStr(a)
a.free()
neg := r.unscaled.sign() < 0
sc := r.scale
r.free()
n := str.Len(digits)
wn := n - sc
mut b := str.NewBuilder()
if neg: str.BufAppendChar(b, 45) end
if wn <= 0:
str.BufAppendChar(b, 48)
else:
repeat wn in i:
rem := wn - i
if i > 0 and rem % 3 == 0: str.BufAppend(b, group) end
str.BufAppendChar(b, digits[i] as int)
end
end
if sc > 0:
str.BufAppend(b, point)
if wn < 0: repeat 0 - wn: str.BufAppendChar(b, 48) end end
mut i := wn
if i < 0: i = 0 end
until i < n:
str.BufAppendChar(b, digits[i] as int)
i++
end
end
out := str.BufStr(b)
str.BufFree(b)
ret out
end
@en "Parse"
@fa "تجزیه"
pub func Parse(s: str, ok &: bool): Dec:
ok = false
mut norm := s
if str.HasPersianDigits(s) or str.HasArabicDigits(s):
norm = str.ToEnglishDigits(s)
end
n := str.Len(norm)
mut i := 0
until i < n and (norm[i] as int) == 32: i++ end
mut neg := false
if i < n:
c := norm[i] as int
if c == 45: neg = true i++
else c == 43: i++
end
end
mut digits := str.NewBuilder()
mut seen := 0
mut frac := 0
mut dot := false
mut bad := false
until i < n:
c := norm[i] as int
if c == 95:
if seen == 0: bad = true break end
i++
continue
end
if c == 46:
if dot: bad = true break end
dot = true
i++
continue
end
if c < 48 or c > 57: break end
str.BufAppendChar(digits, c)
seen++
if dot: frac++ end
i++
end
mut ex := 0
if not bad and i < n:
c := norm[i] as int
if c == 101 or c == 69:
i++
mut eneg := false
if i < n:
sc := norm[i] as int
if sc == 45: eneg = true i++
else sc == 43: i++
end
end
mut edig := 0
until i < n:
c2 := norm[i] as int
if c2 < 48 or c2 > 57: break end
if ex < 1000000: ex = ex * 10 + (c2 - 48) end
edig++
i++
end
if edig == 0: bad = true end
if eneg: ex = 0 - ex end
end
end
until i < n and (norm[i] as int) == 32: i++ end
if i < n: bad = true end
body := str.BufStr(digits)
str.BufFree(digits)
if bad or seen == 0: ret Dec {} end
mut pok := false
mut u := bigint.Parse(body, pok)
if not pok:
u.free()
ret Dec {}
end
if neg: bigint.NegateIn(u) end
ok = true
ret _adopt(u, frac - ex)
end
@en "ParseOr"
@fa "تجزیه با پیش فرض"
pub func ParseOr(s: str): Dec:
mut ok := false
mut v := Parse(s, ok)
if not ok:
v.free()
ret Dec {}
end
ret v
end
@en "ToInt"
@fa "به صحیح"
pub func ToInt(d: Dec, ok &: bool): i64:
mut t := Truncate(d, 0)
v := bigint.ToInt(t.unscaled, ok)
t.free()
ret v
end
@en "ToFloat"
@fa "به اعشاری ماشین"
pub func ToFloat(d: Dec): f64:
mut f := bigint.ToFloat(d.unscaled)
repeat d.scale: f /= 10.0 end
ret f
end
package decimal
import bigint
@en "Neg"
@fa "قرینه"
pub func Neg(d: Dec): Dec: ret _adopt(bigint.Neg(d.unscaled), d.scale) end
@en "Abs"
@fa "قدرمطلق"
pub func Abs(d: Dec): Dec: ret _adopt(bigint.Abs(d.unscaled), d.scale) end
@en "Add"
@fa "جمع"
pub func Add(a: Dec, b: Dec): Dec:
mut s := a.scale
if b.scale > s: s = b.scale end
mut ax := _shift10(a.unscaled, s - a.scale)
mut bx := _shift10(b.unscaled, s - b.scale)
sum := bigint.Add(ax, bx)
ax.free()
bx.free()
ret _adopt(sum, s)
end
@en "Sub"
@fa "تفریق"
pub func Sub(a: Dec, b: Dec): Dec:
mut s := a.scale
if b.scale > s: s = b.scale end
mut ax := _shift10(a.unscaled, s - a.scale)
mut bx := _shift10(b.unscaled, s - b.scale)
diff := bigint.Sub(ax, bx)
ax.free()
bx.free()
ret _adopt(diff, s)
end
@en "Mul"
@fa "ضرب"
pub func Mul(a: Dec, b: Dec): Dec:
ret _adopt(bigint.Mul(a.unscaled, b.unscaled), a.scale + b.scale)
end
@en "Div"
@fa "تقسیم"
pub func Div(a: Dec, b: Dec, scale: int, mode: Rounding): Dec:
mut sc := scale
if sc < 0: sc = 0 end
k := sc + b.scale - a.scale
mut num := a.unscaled.clone()
mut den := b.unscaled.clone()
if k >= 0:
t := _shift10(num, k)
num.free()
num = t
else:
t := _shift10(den, 0 - k)
den.free()
den = t
end
q := _div_round(num, den, mode)
num.free()
den.free()
ret _adopt(q, sc)
end
@en "DivRound"
@fa "تقسیم گردشده"
pub func DivRound(a: Dec, b: Dec, scale: int): Dec:
ret Div(a, b, scale, Rounding.HalfEven)
end
@en "Pow"
@fa "توان"
pub func Pow(d: Dec, n: int): Dec:
if n < 0: ret Dec {} end
if n == 0: ret FromInt(1 as i64) end
ret _adopt(bigint.Pow(d.unscaled, n), d.scale * n)
end
@en "MulInt"
@fa "ضرب صحیح"
pub func MulInt(d: Dec, v: i64): Dec:
ret _adopt(bigint.MulInt(d.unscaled, v), d.scale)
end
@en "AddInt"
@fa "جمع صحیح"
pub func AddInt(d: Dec, v: i64): Dec:
mut b := FromInt(v)
defer b.free()
ret Add(d, b)
end
@en "SubInt"
@fa "تفریق صحیح"
pub func SubInt(d: Dec, v: i64): Dec:
mut b := FromInt(v)
defer b.free()
ret Sub(d, b)
end
@en "DivInt"
@fa "تقسیم صحیح"
pub func DivInt(d: Dec, v: i64, scale: int, mode: Rounding): Dec:
mut b := FromInt(v)
defer b.free()
ret Div(d, b, scale, mode)
end
@en "Percent"
@fa "درصد"
pub func Percent(d: Dec, pct: Dec, scale: int): Dec:
mut p := Mul(d, pct)
defer p.free()
mut hundred := FromInt(100 as i64)
defer hundred.free()
ret Div(p, hundred, scale, Rounding.HalfEven)
end
@en "Sum"
@fa "مجموع"
pub func Sum(items: Vector<Dec>): Dec:
mut total := Dec {}
repeat items.len() in i:
next := Add(total, items.get(i))
total.free()
total = next
end
ret total
end
package decimal
import bigint
func _ulp_parts(q: bigint.Int, extra: int, sc: int): Dec:
if extra == 0: ret _adopt(q.clone(), sc) end
mut one := bigint.FromInt(extra as i64)
r := bigint.Add(q, one)
one.free()
ret _adopt(r, sc)
end
@en "Split"
@fa "تقسیم مساوی"
pub func Split(total: Dec, n: int): Vector<Dec>:
mut out := Vector {} as Vector<Dec>
if n < 1: ret out end
mut divisor := bigint.FromInt(n as i64)
mut q := bigint.Int {}
mut r := bigint.Int {}
_ok := bigint.FloorDivMod(total.unscaled, divisor, q, r)
divisor.free()
extra := bigint.ToIntClamped(r) as int
r.free()
repeat n in i:
mut bonus := 0
if i < extra: bonus = 1 end
out.push(_ulp_parts(q, bonus, total.scale))
end
q.free()
ret out
end
@en "Allocate"
@fa "تخصیص نسبی"
pub func Allocate(total: Dec, ratios: Vector<i64>): Vector<Dec>:
mut out := Vector {} as Vector<Dec>
k := ratios.len()
if k == 0: ret out end
mut sum := bigint.Int {}
mut negative_ratio := false
repeat k in i:
if ratios.get(i) < 0 as i64: negative_ratio = true end
bigint.AddIntTo(sum, ratios.get(i))
end
if negative_ratio or sum.sign() <= 0:
sum.free()
ret out
end
mut shares := Vector {} as Vector<bigint.Int>
mut given := bigint.Int {}
repeat k in i:
mut num := bigint.MulInt(total.unscaled, ratios.get(i))
s := bigint.FloorDiv(num, sum)
num.free()
bigint.AddTo(given, s)
shares.push(s)
end
sum.free()
mut left := bigint.Sub(total.unscaled, given)
given.free()
extra := bigint.ToIntClamped(left) as int
left.free()
repeat k in i:
mut bonus := 0
if i < extra: bonus = 1 end
out.push(_ulp_parts(shares.get(i), bonus, total.scale))
mut s := shares.get(i)
s.free()
end
shares.free()
ret out
end
@en "FreeAll"
@fa "آزادسازی همه"
pub func FreeAll(v &: Vector<Dec>):
repeat v.len() in i:
mut d := v.get(i)
d.free()
end
v.free()
end
package decimal
import bigint
func _div_round(num: bigint.Int, den: bigint.Int, mode: Rounding): bigint.Int:
mut q := bigint.Int {}
mut r := bigint.Int {}
if not bigint.DivMod(num, den, q, r):
r.free()
ret q
end
if r.is_zero():
r.free()
ret q
end
neg := (num.sign() * den.sign()) < 0
mut ar := bigint.Abs(r)
r.free()
mut twice := bigint.Shl(ar, 1)
ar.free()
mut ad := bigint.Abs(den)
c := bigint.Cmp(twice, ad)
twice.free()
ad.free()
mut bump := false
if mode == Rounding.Up: bump = true
else mode == Rounding.Ceil: bump = not neg
else mode == Rounding.Floor: bump = neg
else mode == Rounding.HalfUp: bump = c >= 0
else mode == Rounding.HalfDown: bump = c > 0
else mode == Rounding.HalfEven:
if c > 0: bump = true
else c == 0: bump = bigint.IsOdd(q)
end
end
if bump:
mut one := bigint.FromInt(1 as i64)
if neg: bigint.NegateIn(one) end
nq := bigint.Add(q, one)
one.free()
q.free()
q = nq
end
ret q
end
@en "Rescale"
@fa "تغییر مقیاس"
pub func Rescale(d: Dec, scale: int, mode: Rounding): Dec:
mut sc := scale
if sc < 0: sc = 0 end
if sc >= d.scale:
ret _adopt(_shift10(d.unscaled, sc - d.scale), sc)
end
mut den := bigint.Pow10(d.scale - sc)
q := _div_round(d.unscaled, den, mode)
den.free()
ret _adopt(q, sc)
end
@en "Round"
@fa "گردکردن"
pub func Round(d: Dec, scale: int): Dec: ret Rescale(d, scale, Rounding.HalfEven) end
@en "RoundHalfUp"
@fa "گردکردن نیم بالا"
pub func RoundHalfUp(d: Dec, scale: int): Dec: ret Rescale(d, scale, Rounding.HalfUp) end
@en "Truncate"
@fa "بریدن"
pub func Truncate(d: Dec, scale: int): Dec: ret Rescale(d, scale, Rounding.Down) end
@en "Trim"
@fa "پیراستن"
pub func Trim(d: Dec): Dec:
mut u := d.unscaled.clone()
mut sc := d.scale
mut ten := bigint.FromInt(10 as i64)
until sc > 0:
mut q := bigint.Int {}
mut r := bigint.Int {}
_ok := bigint.DivMod(u, ten, q, r)
divisible := r.is_zero()
r.free()
if not divisible:
q.free()
break
end
u.free()
u = q
sc--
end
ten.free()
ret _adopt(u, sc)
end
@en "decimal"
@fa "اعشاری"
package decimal
import bigint
@en "Rounding"
@fa "شیوه گردکردن"
pub enum Rounding:
@en "Down"
@fa "به سمت صفر"
Down
@en "Up"
@fa "دور از صفر"
Up
@en "Floor"
@fa "رو به پایین"
Floor
@en "Ceil"
@fa "رو به بالا"
Ceil
@en "HalfUp"
@fa "نیم رو به بالا"
HalfUp
@en "HalfDown"
@fa "نیم رو به پایین"
HalfDown
@en "HalfEven"
@fa "نیم به زوج"
HalfEven
end
@en "Dec"
@fa "اعشاری"
pub struct Dec:
@en "unscaled"
@fa "مقدار بدون مقیاس"
pub unscaled: bigint.Int = bigint.Int {}
@en "scale"
@fa "مقیاس"
pub scale: int = 0
@en "free"
@fa "آزادسازی"
pub func free(): this.unscaled.free() end
@en "is_zero"
@fa "صفر است"
pub func is_zero(): bool: ret this.unscaled.is_zero() end
@en "sign"
@fa "علامت"
pub func sign(): int: ret this.unscaled.sign() end
@en "clone"
@fa "همانند"
pub func clone(): Dec:
mut r := Dec {}
r.unscaled = this.unscaled.clone()
r.scale = this.scale
ret r
end
@en "to_str"
@fa "به رشته"
pub func to_str(): str: ret ToStr(this[0]) end
end
func _adopt(u: bigint.Int, scale: int): Dec:
mut d := Dec {}
if scale < 0:
mut p := bigint.Pow10(0 - scale)
d.unscaled = bigint.Mul(u, p)
p.free()
mut tmp := u
tmp.free()
d.scale = 0
ret d
end
d.unscaled = u
d.scale = scale
ret d
end
func _shift10(x: bigint.Int, k: int): bigint.Int:
if k <= 0: ret x.clone() end
mut p := bigint.Pow10(k)
r := bigint.Mul(x, p)
p.free()
ret r
end
@en "Zero"
@fa "صفر"
pub func Zero(): Dec: ret Dec {} end
@en "FromInt"
@fa "از صحیح"
pub func FromInt(v: i64): Dec: ret _adopt(bigint.FromInt(v), 0) end
@en "FromScaled"
@fa "از مقیاس"
pub func FromScaled(unscaled: i64, scale: int): Dec:
ret _adopt(bigint.FromInt(unscaled), scale)
end
@en "New"
@fa "جدید"
pub func New(unscaled: bigint.Int, scale: int): Dec:
ret _adopt(unscaled.clone(), scale)
end
@en "Clone"
@fa "همانند"
pub func Clone(d: Dec): Dec: ret d.clone() end
@en "Free"
@fa "آزادسازی"
pub func Free(d &: Dec): d.unscaled.free() end
@en "FromFloat"
@fa "از اعشاری ماشین"
pub func FromFloat(f: f64, scale: int): Dec:
mut sc := scale
if sc < 0: sc = 0 end
mut scaled := f
repeat sc: scaled *= 10.0 end
if scaled < 0.0:
scaled -= 0.5
else:
scaled += 0.5
end
ret _adopt(bigint.FromInt(scaled as i64), sc)
end
@en "IsZero"
@fa "صفر است"
pub func IsZero(d: Dec): bool: ret d.unscaled.is_zero() end
@en "Sign"
@fa "علامت"
pub func Sign(d: Dec): int: ret d.unscaled.sign() end
@en "IsNegative"
@fa "منفی است"
pub func IsNegative(d: Dec): bool: ret d.unscaled.sign() < 0 end
@en "Scale"
@fa "مقیاس"
pub func Scale(d: Dec): int: ret d.scale end
@en "Unscaled"
@fa "بی‌مقیاس"
pub func Unscaled(d: Dec): bigint.Int: ret d.unscaled.clone() end
@en "Cmp"
@fa "مقایسه"
pub func Cmp(a: Dec, b: Dec): int:
mut s := a.scale
if b.scale > s: s = b.scale end
mut ax := _shift10(a.unscaled, s - a.scale)
mut bx := _shift10(b.unscaled, s - b.scale)
c := bigint.Cmp(ax, bx)
ax.free()
bx.free()
ret c
end
@en "Equals"
@fa "یکسان است"
pub func Equals(a: Dec, b: Dec): bool: ret Cmp(a, b) == 0 end
@en "Less"
@fa "کمتر است"
pub func Less(a: Dec, b: Dec): bool: ret Cmp(a, b) < 0 end
@en "Greater"
@fa "بیشتر است"
pub func Greater(a: Dec, b: Dec): bool: ret Cmp(a, b) > 0 end
@en "Min"
@fa "کمینه"
pub func Min(a: Dec, b: Dec): Dec:
if Cmp(a, b) <= 0: ret a.clone() end
ret b.clone()
end
@en "Max"
@fa "بیشینه"
pub func Max(a: Dec, b: Dec): Dec:
if Cmp(a, b) >= 0: ret a.clone() end
ret b.clone()
end
@en "dependency"
@fa "وابستگی"
package dependency
import mem
import str
struct Provider:
pub deps: Vector<str> = Vector {}
pub make: func (void*) void* = (_c: void*): ret null as void* end
pub close: func (void*) = (_b: void*): end
pub has_close: bool = false
pub is_alias: bool = false
pub target: str = ""
end
struct State:
pub providers: HashMap<str, Provider> = HashMap {}
pub names: Vector<str> = Vector {}
pub dupes: Vector<str> = Vector {}
pub boxes: HashMap<str, void*> = HashMap {}
pub order: Vector<str> = Vector {}
pub resolving: Vector<str> = Vector {}
pub error: str = ""
pub closed: bool = false
end
@en "Container"
@fa "ظرف"
pub struct Container:
@en "st"
@fa "وضعیت"
pub st: State* = null
end
func split_deps(spec: str): Vector<str>:
mut out := Vector {} as Vector<str>
parts := str.Split(spec, ",")
each p in parts:
t := str.Trim(p)
if str.Len(t) > 0:
out.push(t)
end
end
parts.free()
ret out
end
func register(c: Container, name: str, p: Provider):
st := c.st
if st[0].providers.has(name):
st[0].dupes.push(name)
ret
end
st[0].providers.put(name, p)
st[0].names.push(name)
end
func dfs(st: State*, name: str, path &: Vector<str>, state &: HashMap<str, int>): str:
if not st[0].providers.has(name):
ret ""
end
if state.has(name):
if state.get(name) == 1:
mut chain := ""
each n in path:
chain = chain + n + " -> "
end
ret "dependency cycle: " + chain + name
end
ret ""
end
state.put(name, 1)
path.push(name)
p := st[0].providers.get(name)
mut err := ""
each d in p.deps:
if str.Len(err) == 0:
err = dfs(st, d, path, state)
end
end
path.pop()
state.put(name, 2)
ret err
end
func construct(c: Container, name: str): void*:
st := c.st
if st[0].boxes.has(name):
ret st[0].boxes.get(name)
end
if not st[0].providers.has(name):
st[0].error = "missing provider: " + name
ret null
end
each r in st[0].resolving:
if str.Equals(r, name):
st[0].error = "dependency cycle at " + name
ret null
end
end
p := st[0].providers.get(name)
st[0].resolving.push(name)
mut b := null as void*
if p.is_alias:
b = construct(c, p.target)
else:
b = p.make(null)
end
st[0].resolving.pop()
if b == null:
ret null
end
st[0].boxes.put(name, b)
if not p.is_alias:
st[0].order.push(name)
end
ret b
end
@en "New"
@fa "ساخت"
pub func New(): Container:
p := mem.AllocateZeroed(sizeof(State)) as State*
p[0].providers = HashMap {} as HashMap<str, Provider>
p[0].names = Vector {} as Vector<str>
p[0].dupes = Vector {} as Vector<str>
p[0].boxes = HashMap {} as HashMap<str, void*>
p[0].order = Vector {} as Vector<str>
p[0].resolving = Vector {} as Vector<str>
p[0].error = ""
ret Container { st = p }
end
@en "Provide"
@fa "فراهم کردن"
pub func Provide<T>(c: Container, name: str, needs: str, _witness: T, factory: func (Container) T):
mut p := Provider {}
p.deps = split_deps(needs)
cc := c
p.make = (_cx: void*):
v := factory(cc)
b := mem.Allocate(sizeof(T)) as T*
b[0] = v
ret b as void*
end
register(c, name, p)
end
@en "Value"
@fa "مقدار"
pub func Value<T>(c: Container, name: str, v: T):
mut p := Provider {}
p.make = (_cx: void*):
b := mem.Allocate(sizeof(T)) as T*
b[0] = v
ret b as void*
end
register(c, name, p)
end
@en "Bind"
@fa "پیوند"
pub func Bind(c: Container, iface: str, concrete: str):
mut p := Provider {}
p.is_alias = true
p.target = concrete
p.deps.push(concrete)
register(c, iface, p)
end
@en "OnClose"
@fa "هنگام بستن"
pub func OnClose<T>(c: Container, name: str, _witness: T, f: func (T)):
st := c.st
if not st[0].providers.has(name):
st[0].error = "OnClose: no provider named " + name
ret
end
mut p := st[0].providers.get(name)
p.close = (b: void*):
f((b as T*)[0])
end
p.has_close = true
st[0].providers.put(name, p)
end
@en "Build"
@fa "ساختن گراف"
pub func Build(c: Container): str:
st := c.st
if str.Len(st[0].error) > 0:
ret st[0].error
end
if st[0].dupes.len() > 0:
ret "duplicate provider: " + st[0].dupes.get(0)
end
each n in st[0].names:
p := st[0].providers.get(n)
each d in p.deps:
if not st[0].providers.has(d):
ret "missing dependency: " + n + " needs " + d
end
end
end
mut state := HashMap {} as HashMap<str, int>
defer state.free()
mut path := Vector {} as Vector<str>
defer path.free()
each n in st[0].names:
err := dfs(st, n, path, state)
if str.Len(err) > 0:
ret err
end
end
ret ""
end
@en "Get"
@fa "گرفتن"
pub func Get<T>(c: Container, name: str, out &: T): bool:
b := construct(c, name)
if b == null:
ret false
end
out = (b as T*)[0]
ret true
end
@en "Error"
@fa "خطا"
pub func Error(c: Container): str:
st := c.st
ret st[0].error
end
@en "Count"
@fa "تعداد"
pub func Count(c: Container): int:
st := c.st
ret st[0].names.len()
end
@en "Built"
@fa "ساخته شده"
pub func Built(c: Container): Vector<str>:
st := c.st
mut out := Vector {} as Vector<str>
each n in st[0].order:
out.push(n)
end
ret out
end
@en "Close"
@fa "بستن"
pub func Close(c: Container):
st := c.st
if st[0].closed:
ret
end
st[0].closed = true
mut i := st[0].order.len() - 1
until i >= 0:
n := st[0].order.get(i)
p := st[0].providers.get(n)
b := st[0].boxes.get(n)
if p.has_close:
p.close(b)
end
mem.Free(b)
i--
end
each pn in st[0].names:
pv := st[0].providers.get(pn)
pv.deps.free()
end
st[0].providers.free()
st[0].names.free()
st[0].dupes.free()
st[0].boxes.free()
st[0].order.free()
st[0].resolving.free()
mem.Free(st as void*)
end
