func _zs_fbits(p: u8*, n: int, bp: int, k: int): int:
mut v := 0 as i64
mut i := 0
until i < k:
idx := (bp + i) >> 3
if idx < n:
v |= (((p[idx] as i64) >> ((bp + i) & 7)) & 1) << i
end
i++
end
ret v as int
end
func _zs_read_norm(d &: _Zd, p: u8*, n: int, maxlog: int, maxsym: int, log_out &: int, nsym_out &: int): int:
