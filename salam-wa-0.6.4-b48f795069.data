pub title: str = "Salam"
@en "width"
@fa "پهنا"
pub width: f64 = 800.0
@en "height"
@fa "بلندی"
pub height: f64 = 600.0
@en "min_width"
@fa "کمترین پهنا"
pub min_width: f64 = 0.0
@en "min_height"
@fa "کمترین بلندی"
pub min_height: f64 = 0.0
@en "max_width"
@fa "بیشترین پهنا"
pub max_width: f64 = 0.0
@en "max_height"
@fa "بیشترین بلندی"
pub max_height: f64 = 0.0
@en "resizable"
@fa "تغییرپذیر"
pub resizable: bool = true
@en "decorated"
@fa "قاب دار"
pub decorated: bool = true
@en "centered"
@fa "وسط صفحه نمایش"
pub centered: bool = true
@en "x"
@fa "ایکس"
pub x: f64 = 0.0
@en "y"
@fa "ایگرگ"
pub y: f64 = 0.0
@en "background"
