defer cps.free()
if GlyphIndex(f, 0x2026) != 0:
cps.push(0x2026)
else:
cps.push(0x2E)
cps.push(0x2E)
cps.push(0x2E)
end
mut forms := Vector {} as Vector<int>
mut skip := Vector {} as Vector<bool>
defer forms.free()
defer skip.free()
