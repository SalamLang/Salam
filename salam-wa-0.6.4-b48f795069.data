else sf == 2:
hdr = 4
if n < 4:
ret 0 - 1
end
v := (b0 as i64) | ((p[1] as i64) << 8) | ((p[2] as i64) << 16) | ((p[3] as i64) << 24)
rsz = ((v >> 4) & 0x3fff) as int
csz = ((v >> 18) & 0x3fff) as int
streams = 4
else:
hdr = 5
if n < 5:
ret 0 - 1
end
v := (b0 as i64) | ((p[1] as i64) << 8) | ((p[2] as i64) << 16) | ((p[3] as i64) << 24) | ((p[4] as i64) << 32)
rsz = ((v >> 4) & 0x3ffff) as int
csz = ((v >> 22) & 0x3ffff) as int
streams = 4
end
end
if rsz > _ZS_MAXBLOCK:
ret 0 - 1
