func _zs_build_dt(d &: _Zd, tbl: u32*, log: int, nsym: int): bool:
size := 1 << log
mut high := size - 1
repeat nsym in s:
c := d.norm[s]
if c == 0 - 1:
d.spr[high] = s as u8
high--
d.nxt[s] = 1
else:
d.nxt[s] = c
end
end
step := (size >> 1) + (size >> 3) + 3
mask := size - 1
mut pos := 0
repeat nsym in s:
c := d.norm[s]
if c > 0:
repeat c:
d.spr[pos] = s as u8
pos = (pos + step) & mask
until pos > high:
pos = (pos + step) & mask
end
end
end
end
if pos != 0:
ret false
end
repeat size in u:
s := d.spr[u] as int
nx := d.nxt[s]
d.nxt[s] = nx + 1
nb := log - _zs_hb(nx)
base := (nx << nb) - size
tbl[u] = (s | (nb << 8) | (base << 16)) as u32
end
ret true
end
func _zs_predef(d &: _Zd, tbl: u32*, which: int): int:
mut n := 0
mut log := 6
if which == 0:
n = 36
