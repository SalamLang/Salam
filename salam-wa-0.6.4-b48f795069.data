end
end
func _nat_clip_get(): str:
if _x_sel_text.len() > 0:
mem.Free(_x_sel_text as void*)
end
_x_sel_text = ""
_x_sel_done = false
XConvertSelection(_xd, _x_atoms[11], _x_atoms[3], _x_atoms[13], _x_helper, 0 as usize)
XFlush(_xd)
start := time.MonoMillis()
until not _x_sel_done and time.MonoMillis() - start < (1000 as i64):
_nat_pump(20)
end
if _x_sel_text.len() == 0:
ret str.Clone("")
end
text := _x_sel_text
_x_sel_text = ""
ret text
end
func _nat_clip_set(text: str): bool:
if _x_clip_owned:
mem.Free(_x_clip as void*)
end
_x_clip = str.Clone(text)
_x_clip_owned = true
XSetSelectionOwner(_xd, _x_atoms[11], _x_helper, 0 as usize)
XFlush(_xd)
ret XGetSelectionOwner(_xd, _x_atoms[11]) == _x_helper
end
func _nat_scheme(): ColorScheme:
theme := os.Env("GTK_THEME")
dark := str.Contains(str.Lower(theme), "dark")
mem.Free(theme as void*)
ret dark ? ColorScheme.Dark : ColorScheme.Light
end
func _nat_shown(id: int, x: int, y: int): u32:
image := XGetImage(_xd, _x_wins[id].win, x, y, 1 as u32, 1 as u32, (0 as usize) - (1 as usize), 2)
if image == null:
ret 0
end
data := (((image as i64) + (16 as i64)) as void**)[0]
value := (data as u32*)[0]
_d := XDestroyImage(image)
ret (value & (0xFFFFFF as u32)) | (0xFF000000 as u32)
end
func _nat_handle(id: int): void*:
ret (_x_wins[id].win as size) as void*
end
end
@en "i18n"
@fa "بین‌المللی‌سازی"
package i18n
import str
import env
import config
@en "Catalog"
@fa "فهرست ترجمه"
pub struct Catalog:
@en "keys"
@fa "کلیدها"
pub keys: Vector<str> = Vector {}
@en "vals"
@fa "ترجمه‌ها"
pub vals: Vector<str> = Vector {}
@en "fallback"
@fa "زبان پشتیبان"
pub fallback: str = "en"
end
func _combine(locale: str, key: str): str: ret locale.concat(":").concat(key) end
func _find(c &: Catalog, locale: str, key: str): int:
combined := _combine(locale, key)
repeat c.keys.len() in i:
if c.keys.get(i) == combined: ret i end
end
ret 0 - 1
end
func _normalize_locale(v: str): str:
mut s := str.Trim(v)
dot := s.find(".")
if dot >= 0: s = s.substr(0, dot) end
us := s.find("_")
if us >= 0: s = s.substr(0, us) end
dash := s.find("-")
if dash >= 0: s = s.substr(0, dash) end
ret str.Lower(s)
end
@en "New"
@fa "جدید"
pub func New(default_locale: str): Catalog: ret Catalog { fallback = default_locale } end
@en "Set"
@fa "تنظیم"
pub func Set(c &: Catalog, locale: str, key: str, val: str):
idx := _find(c, locale, key)
if idx >= 0:
c.vals.set(idx, val)
else:
c.keys.push(_combine(locale, key))
c.vals.push(val)
end
end
@en "Has"
@fa "دارد"
pub func Has(c &: Catalog, locale: str, key: str): bool: ret _find(c, locale, key) >= 0 end
@en "RawGet"
@fa "دریافت خام"
pub func RawGet(c &: Catalog, locale: str, key: str): str:
idx := _find(c, locale, key)
if idx < 0: ret "" end
ret c.vals.get(idx)
end
@en "T"
@fa "ترجمه"
pub func T(c &: Catalog, locale: str, key: str): str:
v := RawGet(c, locale, key)
if v.len() > 0: ret v end
if locale != c.fallback:
fv := RawGet(c, c.fallback, key)
if fv.len() > 0: ret fv end
end
ret key
end
@en "Interpolate"
@fa "جایگذاری"
pub func Interpolate(msg: str, param_names: Vector<str>, param_vals: Vector<str>): str:
mut out := msg
repeat param_names.len() in i:
placeholder := "{".concat(param_names.get(i)).concat("}")
out = str.Replace(out, placeholder, param_vals.get(i))
end
ret out
end
@en "Tf"
@fa "ترجمه قالبی"
pub func Tf(c &: Catalog, locale: str, key: str, param_names: Vector<str>, param_vals: Vector<str>): str:
ret Interpolate(T(c, locale, key), param_names, param_vals)
end
@en "Plural"
@fa "جمع"
pub func Plural(c &: Catalog, locale: str, key: str, n: i64): str:
mut suffix := ".other"
if n == (1 as i64): suffix = ".one" end
combined_key := key.concat(suffix)
if Has(c, locale, combined_key) or Has(c, c.fallback, combined_key):
ret T(c, locale, combined_key)
end
ret T(c, locale, key)
end
@en "LoadLocale"
@fa "بارگذاری زبان"
pub func LoadLocale(c &: Catalog, locale: str, path: str): int:
mut cfg := config.LoadEnv(path)
keys := config.Keys(cfg)
defer keys.free()
repeat keys.len() in i:
k := keys.get(i)
Set(c, locale, k, config.Get(cfg, k))
end
ret keys.len()
end
@en "DetectLocale"
@fa "تشخیص زبان"
pub func DetectLocale(): str:
mut v := env.Get("SALAM_LOCALE")
if v.len() > 0: ret _normalize_locale(v) end
v = env.Get("LANG")
if v.len() > 0: ret _normalize_locale(v) end
v = env.Get("LC_ALL")
if v.len() > 0: ret _normalize_locale(v) end
ret "en"
end
@en "Free"
@fa "آزادسازی"
pub func Free(c &: Catalog):
c.keys.free()
c.vals.free()
end
@en "io"
@fa "ورودی خروجی"
package io
import str
import mem
extern:
func salam_open(path: str, mode: str): File*
func salam_file_read(f: File*, size: u64): str
func salam_file_readline(f: File*): str
func salam_file_write(f: File*, data: str): int
func salam_file_close(f: File*)
func salam_file_seek(f: File*, off: i64, whence: int): int
func fflush(stream: void*): int
func fread(ptr: void*, size: u64, nmemb: u64, stream: void*): u64
func fwrite(ptr: void*, size: u64, nmemb: u64, stream: void*): u64
end
if SALAM_OS_LINUX or SALAM_OS_ANDROID:
extern:
func openat(dirfd: int, path: str, flags: int): int
func close(fd: int): int
end
if SALAM_ARCH_X86 or SALAM_ARCH_ARM:
extern:
func read(fd: int, buf: void*, n: u32): int
end
else:
extern:
func read(fd: int, buf: void*, n: u64): i64
end
end
end
const COPY_CHUNK := 65536
if SALAM_OS_LINUX or SALAM_OS_ANDROID:
if SALAM_ARCH_X86 or SALAM_ARCH_ARM:
func _fd_read(fd: int, buf: void*, n: int): int: ret read(fd, buf, n as u32) end
else:
func _fd_read(fd: int, buf: void*, n: int): int: ret read(fd, buf, n as u64) as int end
end
func _read_file_fast(path: str, out &: str): bool:
fd := openat(0 - 100, path, 0)
if fd < 0: ret false end
mut cap := COPY_CHUNK
mut buf := mem.MustAllocate((cap + 1) as u64)
mut used := 0
until 1 == 1:
if used == cap:
cap *= 2
buf = mem.MustReallocate(buf, (cap + 1) as u64)
end
n := _fd_read(fd, ((buf as i64) + (used as i64)) as void*, cap - used)
if n <= 0: break end
used += n
end
close(fd)
buf = mem.MustReallocate(buf, (used + 1) as u64)
mem.Set(((buf as i64) + (used as i64)) as void*, 0, 1 as u64)
out = buf as str
ret true
end
else:
func _read_file_fast(path: str, out &: str): bool: ret false end
end
@en "Input"
@fa "بخوان"
pub func Input(): str: ret input () end
@en "Read"
@fa "خواندن"
pub func Read(f: File*, size: u64): str: ret f.read(size) end
@en "Readline"
@fa "خواندن خط"
pub func Readline(f: File*): str: ret f.readline() end
@en "Write"
@fa "نوشتن"
pub func Write(f: File*, data: str): int: ret f.write(data) end
@en "Seek"
@fa "جابجایی مکان نما"
pub func Seek(f: File*, offset: i64, whence: int): int: ret f.seek(offset, whence) end
@en "Close"
@fa "بستن"
pub func Close(f: File*): f.close() end
@en "ReadFile"
@fa "خواندن پرونده"
pub func ReadFile(path: str): str:
mut quick := ""
if _read_file_fast(path, quick): ret quick end
f := salam_open(path, "rb")
if f == null:
ret ""
end
out := ReadAll(f)
f.close()
ret out
end
@en "WriteFile"
@fa "نوشتن پرونده"
pub func WriteFile(path: str, data: str): int:
f := salam_open(path, "wb")
if f == null:
ret 0 - 1
end
n := f.write(data)
f.close()
ret n
end
@en "AppendFile"
@fa "افزودن به پرونده"
pub func AppendFile(path: str, data: str): int:
f := salam_open(path, "ab")
if f == null:
ret 0 - 1
end
n := f.write(data)
f.close()
ret n
end
@en "Lines"
@fa "خط ها"
pub func Lines(path: str): Vector<str>:
text := ReadFile(path)
ret text.trim().split("\n")
end
@en "EPrint"
@fa "نوشتن خطا"
pub func EPrint(s: str): printerr s end
@en "EPrintln"
@fa "نوشتن خطا با خط جدید"
pub func EPrintln(s: str): printerrln s end
@en "Flush"
@fa "تخلیه"
pub func Flush():
_r := fflush(null as void*)
end
@en "ReadAll"
@fa "خواندن همه"
pub func ReadAll(f: File*): str:
if f == null:
ret ""
end
mut sb := str.NewBuilder()
defer str.BufFree(sb)
mut chunk := f.read(4096)
until chunk.len() > 0:
str.BufAppend(sb, chunk)
mem.Free(chunk as void*)
chunk = f.read(4096)
end
mem.Free(chunk as void*)
out := str.BufStr(sb)
ret out
end
@en "Copy"
@fa "کپی"
pub func Copy(dst: File*, src: File*): i64:
if src == null or dst == null:
ret 0
end
buf := mem.Allocate(COPY_CHUNK as u64)
if buf == null:
ret 0
end
sp := src as void*
dp := dst as void*
mut total := 0 as i64
mut going := true
until going:
got := fread(buf, 1 as u64, COPY_CHUNK as u64, sp)
if got == 0 as u64:
going = false
else:
put := fwrite(buf, 1 as u64, got, dp)
total += put as i64
if put != got: going = false end
end
end
mem.Free(buf)
ret total
end
@en "WriteLines"
@fa "نوشتن خط ها"
pub func WriteLines(path: str, lines: Vector<str>): int:
f := salam_open(path, "wb")
if f == null:
ret 0 - 1
end
mut total := 0
repeat lines.len() in i:
total += f.write(lines.get(i))
total += f.write("\n")
end
f.close()
ret total
end
@en "jwt"
@fa "جی دبلیو تی"
package jwt
import str
import mem
import conv
import time
import crypto
import encoding
@en "JWT_HS256"
@fa "الگوریتم اچ اس۲۵۶"
pub const JWT_HS256 := "HS256"
@en "JWT_HS384"
@fa "الگوریتم اچ اس۳۸۴"
pub const JWT_HS384 := "HS384"
@en "JWT_HS512"
@fa "الگوریتم اچ اس۵۱۲"
pub const JWT_HS512 := "HS512"
func _jwt_err(kind: ErrorKind, code: str, message: str): Error:
ret Error.New(kind, message).with_code("jwt." + code).wrap("jwt")
end
@en "IsSupportedAlg"
@fa "الگوریتم پشتیبانی می شود"
pub pure func IsSupportedAlg(alg: str): bool:
ret alg == JWT_HS256 or alg == JWT_HS384 or alg == JWT_HS512
end
@en "DigestSize"
@fa "اندازه چکیده"
pub pure func DigestSize(alg: str): int:
if alg == JWT_HS256: ret 32 end
if alg == JWT_HS384: ret 48 end
if alg == JWT_HS512: ret 64 end
ret 0
end
package jwt
inline pure func _bp(s: str): i8*: ret (s as void*) as i8* end
inline pure func _ub(bp: i8*, i: int): int:
mut v := bp[i] as int
if v < 0: v += 256 end
ret v
end
pure func _b64url_ok(code: int): bool:
if code >= 65 and code <= 90: ret true end
if code >= 97 and code <= 122: ret true end
if code >= 48 and code <= 57: ret true end
ret code == 45 or code == 95
end
func _to_url_alphabet(s: str): str:
n := s.len()
bp := _bp(s)
mut sb := str.NewBuilder()
defer str.BufFree(sb)
repeat n in i:
code := _ub(bp, i)
if code == 43:
str.BufAppendChar(sb, 45)
else code == 47:
str.BufAppendChar(sb, 95)
else code != 61:
str.BufAppendChar(sb, code)
end
end
out := str.BufStr(sb)
ret out
end
func _byte_text(code: int): str:
mut sb := str.NewBuilder()
defer str.BufFree(sb)
if code == 32:
str.BufAppend(sb, "space")
else code > 32 and code < 127:
str.BufAppend(sb, "character ")
str.BufAppendChar(sb, 39)
str.BufAppendChar(sb, code)
str.BufAppendChar(sb, 39)
else:
digits := "0123456789ABCDEF"
hp := _bp(digits)
str.BufAppend(sb, "byte 0x")
str.BufAppendChar(sb, _ub(hp, code / 16))
str.BufAppendChar(sb, _ub(hp, code % 16))
end
out := str.BufStr(sb)
ret out
end
func _b64url_err(kind: ErrorKind, message: str, offset: int): Error:
ret Error.At(kind, message, offset).with_code("jwt.bad_base64").wrap("base64url")
end
@en "B64UrlEncodeBytes"
@fa "کدگذاری پایه۶۴ نشانی بایت"
pub func B64UrlEncodeBytes(p: void*, n: int): str:
std64 := encoding.Base64EncodeBytes(p, n)
ret _to_url_alphabet(std64)
end
@en "B64UrlEncode"
@fa "کدگذاری پایه۶۴ نشانی"
pub func B64UrlEncode(s: str): str:
ret B64UrlEncodeBytes(s as void*, s.len())
end
@en "B64UrlDecode"
@fa "کدگشایی پایه۶۴ نشانی"
pub func B64UrlDecode(s: str): str throws:
n := s.len()
bp := _bp(s)
repeat n in i:
code := _ub(bp, i)
if not _b64url_ok(code):
throw _b64url_err(ErrorKind.Syntax, "invalid " + _byte_text(code), i)
end
end
if n % 4 == 1:
throw _b64url_err(ErrorKind.UnexpectedEnd, "input ends one character into a group of four", n)
end
ret try encoding.Base64Decode(s)
end
package jwt
@en "Claims"
@fa "ادعاها"
pub struct Claims:
@en "iss"
@fa "صادرکننده"
pub iss: str = ""
@en "sub"
@fa "موضوع"
pub sub: str = ""
@en "aud"
@fa "مخاطب"
pub aud: str = ""
@en "aud_raw"
@fa "مخاطب جیسون"
pub aud_raw: str = ""
@en "exp"
@fa "زمان انقضا"
pub exp: i64 = 0
@en "nbf"
@fa "آغاز اعتبار"
pub nbf: i64 = 0
@en "iat"
@fa "زمان صدور"
pub iat: i64 = 0
@en "jti"
@fa "شناسه توکن"
pub jti: str = ""
@en "extra"
@fa "ادعاهای دیگر"
pub extra: str = ""
end
pure func _is_registered(key: str): bool:
if key == "iss" or key == "sub" or key == "aud": ret true end
if key == "exp" or key == "nbf" or key == "iat": ret true end
ret key == "jti"
end
func _append_member(c &: Claims, key: str, rendered_value: str):
if c.extra.len() > 0:
c.extra = c.extra.concat(",")
end
c.extra = c.extra.concat(_quoted(key)).concat(":").concat(rendered_value)
end
func _emit(sb &: str.StringBuilder, count: int, key: str, rendered: str): int:
if count > 0: str.BufAppendChar(sb, 44) end
str.BufAppend(sb, _quoted(key))
str.BufAppendChar(sb, 58)
str.BufAppend(sb, rendered)
ret count + 1
end
@en "NewClaims"
@fa "ادعاهای جدید"
pub func NewClaims(): Claims:
ret Claims {}
end
@en "SetStr"
@fa "تنظیم رشته"
pub func SetStr(c &: Claims, key: str, value: str):
if key == "iss": c.iss = value ret end
if key == "sub": c.sub = value ret end
if key == "aud": c.aud = value ret end
if key == "jti": c.jti = value ret end
_append_member(c, key, _quoted(value))
end
@en "SetInt"
@fa "تنظیم عدد"
pub func SetInt(c &: Claims, key: str, value: i64):
if key == "exp": c.exp = value ret end
if key == "nbf": c.nbf = value ret end
if key == "iat": c.iat = value ret end
_append_member(c, key, conv.FormatInt(value))
end
@en "SetBool"
@fa "تنظیم منطقی"
pub func SetBool(c &: Claims, key: str, value: bool):
_append_member(c, key, conv.FormatBool(value))
end
@en "SetRaw"
@fa "تنظیم خام"
pub func SetRaw(c &: Claims, key: str, raw: str):
if key == "aud": c.aud_raw = raw ret end
if _is_registered(key):
ret
end
_append_member(c, key, raw)
end
@en "ExpiresIn"
@fa "انقضا در"
pub func ExpiresIn(c &: Claims, seconds: i64):
now := time.Now()
c.iat = now
c.exp = now + seconds
end
@en "NotBeforeIn"
@fa "معتبر نه پیش از"
pub func NotBeforeIn(c &: Claims, seconds: i64):
c.nbf = time.Now() + seconds
end
@en "ClaimsJSON"
@fa "جیسون ادعاها"
pub func ClaimsJSON(c: Claims): str:
mut sb := str.NewBuilder()
defer str.BufFree(sb)
str.BufAppendChar(sb, 123)
mut count := 0
if c.iss.len() > 0:
count = _emit(sb, count, "iss", _quoted(c.iss))
end
if c.sub.len() > 0:
count = _emit(sb, count, "sub", _quoted(c.sub))
end
if c.aud_raw.len() > 0:
count = _emit(sb, count, "aud", c.aud_raw)
else c.aud.len() > 0:
count = _emit(sb, count, "aud", _quoted(c.aud))
end
if c.exp != 0 as i64:
count = _emit(sb, count, "exp", conv.FormatInt(c.exp))
end
if c.nbf != 0 as i64:
count = _emit(sb, count, "nbf", conv.FormatInt(c.nbf))
end
if c.iat != 0 as i64:
count = _emit(sb, count, "iat", conv.FormatInt(c.iat))
end
if c.jti.len() > 0:
count = _emit(sb, count, "jti", _quoted(c.jti))
end
if c.extra.len() > 0:
if count > 0: str.BufAppendChar(sb, 44) end
str.BufAppend(sb, c.extra)
end
str.BufAppendChar(sb, 125)
out := str.BufStr(sb)
ret out
end
package jwt
import net.http
@en "Guard"
@fa "نگهبان"
pub struct Guard:
@en "secret"
@fa "کلید امضا"
pub secret: str = ""
@en "opts"
@fa "گزینه‌ها"
pub opts: Options = Options {}
@en "cookie"
@fa "کوکی"
pub cookie: str = ""
@en "realm"
@fa "قلمرو"
pub realm: str = "api"
end
pure func _lower_ascii(c: int): int:
if c >= 65 and c <= 90: ret c + 32 end
ret c
end
func _strip_bearer(value: str): str:
n := value.len()
if n < 7: ret "" end
want := "bearer"
p := (value as void*) as i8*
w := (want as void*) as i8*
repeat 6 in i:
mut a := p[i] as int
if a < 0: a += 256 end
mut b := w[i] as int
if b < 0: b += 256 end
if _lower_ascii(a) != b: ret "" end
end
if value.substr(6, 1) != " ": ret "" end
mut start := 6
until start < n and value.substr(start, 1) == " ":
start++
end
if start >= n: ret "" end
ret value.substr(start, n - start)
end
func _json_error(code: str, reason: str): str:
ret `{"error":"`.concat(code).concat(`","reason":"`).concat(reason).concat(`"}`)
end
func _challenge(ctx: i64, g: Guard, token_was_offered: bool):
http.SetStatus(ctx, 401)
mut value := `Bearer realm="`.concat(g.realm).concat(`"`)
if token_was_offered:
value = value.concat(`, error="invalid_token"`)
end
http.SetHeader(ctx, "WWW-Authenticate", value)
end
@en "NewGuard"
@fa "نگهبان جدید"
pub func NewGuard(secret: str): Guard:
ret Guard { secret = secret, opts = DefaultOptions() }
end
@en "ParseBearer"
@fa "تجزیه حامل"
pub func ParseBearer(header_value: str): str:
ret _strip_bearer(header_value)
end
@en "BearerToken"
@fa "توکن حامل"
pub func BearerToken(ctx: i64): str:
ret _strip_bearer(http.Header(ctx, "Authorization"))
end
@en "TokenFrom"
@fa "توکن از"
pub func TokenFrom(ctx: i64, g: Guard): str:
bearer := BearerToken(ctx)
if bearer.len() > 0: ret bearer end
if g.cookie.len() > 0: ret http.CookieValue(ctx, g.cookie) end
ret ""
end
@en "Check"
@fa "بررسی"
pub func Check(ctx: i64, g: Guard): Token throws:
raw := TokenFrom(ctx, g)
if raw.len() == 0:
throw _jwt_err(ErrorKind.NotFound, "missing_token", "missing bearer token")
end
ret try Verify(raw, g.secret, g.opts)
end
@en "Unauthorized"
@fa "غیرمجاز"
pub func Unauthorized(ctx: i64, g: Guard, reason: str):
_challenge(ctx, g, true)
http.Json(ctx, _json_error("unauthorized", reason))
end
@en "MissingCredential"
@fa "بدون گواهی"
pub func MissingCredential(ctx: i64, g: Guard):
_challenge(ctx, g, false)
http.Json(ctx, _json_error("unauthorized", "missing bearer token"))
end
@en "Forbidden"
@fa "ممنوع"
pub func Forbidden(ctx: i64, reason: str):
http.SetStatus(ctx, 403)
http.Json(ctx, _json_error("forbidden", reason))
end
@en "Require"
@fa "نیاز"
pub func Require(ctx: i64, g: Guard, t &: Token): bool:
raw := TokenFrom(ctx, g)
if raw.len() == 0:
MissingCredential(ctx, g)
ret false
end
try:
t = Verify(raw, g.secret, g.opts)
catch e:
Unauthorized(ctx, g, e.message)
ret false
end
ret true
end
@en "RequireScope"
@fa "نیاز به دامنه"
pub func RequireScope(ctx: i64, g: Guard, scope: str, t &: Token): bool:
if not Require(ctx, g, t): ret false end
if not HasScope(t, scope):
Forbidden(ctx, "missing scope: ".concat(scope))
ret false
end
ret true
end
@en "RequireClaim"
@fa "نیاز به ادعا"
pub func RequireClaim(ctx: i64, g: Guard, key: str, value: str, t &: Token): bool:
if not Require(ctx, g, t): ret false end
if not ListHas(t, key, value):
Forbidden(ctx, "missing ".concat(key).concat(": ").concat(value))
ret false
end
ret true
end
@en "RequireSubject"
@fa "نیاز به موضوع"
pub func RequireSubject(ctx: i64, g: Guard, subject: str, t &: Token): bool:
if not Require(ctx, g, t): ret false end
if t.claims.sub != subject:
Forbidden(ctx, "not your resource")
ret false
end
ret true
end
package jwt
pure func _is_ws(code: int): bool:
ret code == 32 or code == 9 or code == 10 or code == 13
end
func _skip_ws(s: str, from: int): int:
n := s.len()
bp := _bp(s)
mut i := from
until i < n and _is_ws(_ub(bp, i)):
i++
end
ret i
end
func _end_of_string(s: str, p: int): int:
n := s.len()
bp := _bp(s)
mut i := p + 1
until i < n:
code := _ub(bp, i)
if code == 92:
i += 2
continue
end
if code == 34: ret i + 1 end
i++
end
ret 0 - 1
end
func _end_of_group(s: str, p: int): int:
n := s.len()
bp := _bp(s)
mut depth := 0
mut i := p
until i < n:
code := _ub(bp, i)
if code == 34:
e := _end_of_string(s, i)
if e < 0: ret 0 - 1 end
i = e
continue
end
if code == 123 or code == 91:
depth++
else code == 125 or code == 93:
depth--
if depth == 0: ret i + 1 end
end
i++
end
ret 0 - 1
end
func _end_of_value(s: str, p: int): int:
n := s.len()
if p >= n: ret 0 - 1 end
bp := _bp(s)
code := _ub(bp, p)
if code == 34: ret _end_of_string(s, p) end
if code == 123 or code == 91: ret _end_of_group(s, p) end
mut i := p
until i < n:
c := _ub(bp, i)
if c == 44 or c == 125 or c == 93 or _is_ws(c): ret i end
i++
end
ret n
end
func _slice_eq(text: str, start: int, length: int, key: str): bool:
if length != key.len(): ret false end
tp := _bp(text)
kp := _bp(key)
repeat length in i:
if _ub(tp, start + i) != _ub(kp, i): ret false end
end
ret true
end
func _key_eq(text: str, start: int, length: int, key: str): bool:
tp := _bp(text)
mut escaped := false
repeat length in i:
if _ub(tp, start + i) == 92:
escaped = true
break
end
end
if escaped: ret _unescape(text.substr(start, length)) == key end
ret _slice_eq(text, start, length, key)
end
func _member_all(text: str, key: str, count &: int): str:
count = 0
mut first := ""
n := text.len()
if n == 0: ret "" end
bp := _bp(text)
mut p := _skip_ws(text, 0)
if p >= n or _ub(bp, p) != 123: ret "" end
p++
until p < n:
p = _skip_ws(text, p)
if p >= n or _ub(bp, p) == 125: ret first end
if _ub(bp, p) != 34: ret first end
ke := _end_of_string(text, p)
if ke < 0: ret first end
matched := _key_eq(text, p + 1, ke - p - 2, key)
p = _skip_ws(text, ke)
if p >= n or _ub(bp, p) != 58: ret first end
vs := _skip_ws(text, p + 1)
ve := _end_of_value(text, vs)
if ve < 0: ret first end
if matched:
if count == 0: first = text.substr(vs, ve - vs) end
count++
end
p = _skip_ws(text, ve)
if p < n and _ub(bp, p) == 44:
p++
continue
end
ret first
end
ret first
end
func _member_raw(text: str, key: str, found &: bool): str:
mut count := 0
v := _member_all(text, key, count)
found = count > 0
ret v
end
func _member_count(text: str, key: str): int:
mut count := 0
_v := _member_all(text, key, count)
ret count
end
func _raw_to_str(raw: str): str:
if raw.len() == 0: ret "" end
bp := _bp(raw)
c := _ub(bp, 0)
if c == 34:
ret _unescape(raw.substr(1, raw.len() - 2))
end
if c == 123 or c == 91: ret "" end
if raw == "null": ret "" end
ret raw
end
pure func _raw_to_i64(raw: str): i64:
n := raw.len()
if n == 0: ret 0 end
bp := _bp(raw)
mut i := 0
mut neg := false
if _ub(bp, 0) == 45:
neg = true
i = 1
else _ub(bp, 0) == 43:
i = 1
end
mut v := 0 as i64
mut digits := 0
until i < n:
c := _ub(bp, i)
if c < 48 or c > 57: break end
v = v * (10 as i64) + ((c - 48) as i64)
digits++
i++
end
if digits == 0: ret 0 end
if neg: ret 0 as i64 - v end
ret v
end
func _raw_has_string(raw: str, want: str): bool:
n := raw.len()
if n == 0: ret false end
bp := _bp(raw)
if _ub(bp, 0) == 34:
ret _raw_to_str(raw) == want
end
if _ub(bp, 0) != 91: ret false end
mut i := 1
until i < n:
i = _skip_ws(raw, i)
if i >= n or _ub(bp, i) == 93: ret false end
e := _end_of_value(raw, i)
if e < 0: ret false end
if _raw_to_str(raw.substr(i, e - i)) == want: ret true end
i = _skip_ws(raw, e)
if i < n and _ub(bp, i) == 44:
i++
continue
end
ret false
end
ret false
end
package jwt
func _utf8_append(sb &: str.StringBuilder, cp: int):
if cp < 0x80:
str.BufAppendChar(sb, cp)
else cp < 0x800:
str.BufAppendChar(sb, 0xC0 | (cp >> 6))
str.BufAppendChar(sb, 0x80 | (cp & 0x3F))
else cp < 0x10000:
str.BufAppendChar(sb, 0xE0 | (cp >> 12))
str.BufAppendChar(sb, 0x80 | ((cp >> 6) & 0x3F))
str.BufAppendChar(sb, 0x80 | (cp & 0x3F))
else:
str.BufAppendChar(sb, 0xF0 | (cp >> 18))
str.BufAppendChar(sb, 0x80 | ((cp >> 12) & 0x3F))
str.BufAppendChar(sb, 0x80 | ((cp >> 6) & 0x3F))
str.BufAppendChar(sb, 0x80 | (cp & 0x3F))
end
end
pure func _hex_digit(code: int): int:
if code >= 48 and code <= 57: ret code - 48 end
if code >= 97 and code <= 102: ret code - 87 end
if code >= 65 and code <= 70: ret code - 55 end
ret 0 - 1
end
func _hex4(s: str, i: int): int:
if i + 3 >= s.len(): ret 0 - 1 end
bp := _bp(s)
mut v := 0
repeat 4 in k:
d := _hex_digit(_ub(bp, i + k))
if d < 0: ret 0 - 1 end
v = v * 16 + d
end
ret v
end
func _unescape(s: str): str:
n := s.len()
bp := _bp(s)
mut sb := str.NewBuilder()
defer str.BufFree(sb)
mut i := 0
until i < n:
code := _ub(bp, i)
if code != 92:
str.BufAppendChar(sb, code)
i++
continue
end
if i + 1 >= n: break end
esc := _ub(bp, i + 1)
i += 2
if esc == 110: str.BufAppendChar(sb, 10)
else esc == 116: str.BufAppendChar(sb, 9)
else esc == 114: str.BufAppendChar(sb, 13)
else esc == 98: str.BufAppendChar(sb, 8)
else esc == 102: str.BufAppendChar(sb, 12)
else esc == 117:
cp := _hex4(s, i)
if cp < 0: continue end
i += 4
if cp >= 0xD800 and cp <= 0xDBFF and i + 1 < n and _ub(bp, i) == 92 and _ub(bp, i + 1) == 117:
lo := _hex4(s, i + 2)
if lo >= 0xDC00 and lo <= 0xDFFF:
i += 6
_utf8_append(sb, 0x10000 + ((cp - 0xD800) << 10) + (lo - 0xDC00))
continue
end
end
_utf8_append(sb, cp)
else:
str.BufAppendChar(sb, esc)
end
end
out := str.BufStr(sb)
ret out
end
func _hexchar(v: int): int:
if v < 10: ret 48 + v end
ret 87 + v
end
func _escape(s: str): str:
n := s.len()
bp := _bp(s)
mut sb := str.NewBuilder()
defer str.BufFree(sb)
repeat n in i:
code := _ub(bp, i)
if code == 34:
str.BufAppend(sb, `\"`)
else code == 92:
str.BufAppend(sb, `\\`)
else code == 10:
str.BufAppend(sb, `\n`)
else code == 9:
str.BufAppend(sb, `\t`)
else code == 13:
str.BufAppend(sb, `\r`)
else code == 8:
str.BufAppend(sb, `\b`)
else code == 12:
str.BufAppend(sb, `\f`)
else code < 32:
str.BufAppend(sb, `\u00`)
str.BufAppendChar(sb, _hexchar(code / 16))
str.BufAppendChar(sb, _hexchar(code % 16))
else:
str.BufAppendChar(sb, code)
end
end
out := str.BufStr(sb)
ret out
end
func _quoted(s: str): str:
ret `"`.concat(_escape(s)).concat(`"`)
end
package jwt
import crypto
func _cookie_name(g: Guard): str:
if g.cookie.len() > 0: ret g.cookie end
ret "session"
end
func _refresh_id(subject: str): str:
ret subject.concat("-").concat(crypto.RandomHex(16))
end
func _write_session_cookie(ctx: i64, g: Guard, token: str, max_age: int, secure: bool):
mut c := http.Cookie {}
c.name = _cookie_name(g)
c.value = token
c.path = "/"
c.max_age = max_age
c.has_max_age = true
c.http_only = true
c.secure = secure
c.same_site = "Lax"
http.SetCookie(ctx, c)
end
@en "Issue"
@fa "صدور"
pub func Issue(g: Guard, c: Claims, ttl: i64): str throws:
mut claims := c
ExpiresIn(claims, ttl)
if g.opts.issuer.len() > 0 and claims.iss.len() == 0:
claims.iss = g.opts.issuer
end
if g.opts.audience.len() > 0 and claims.aud.len() == 0 and claims.aud_raw.len() == 0:
claims.aud = g.opts.audience
end
mut alg := g.opts.alg
if alg.len() == 0: alg = JWT_HS256 end
ret try Sign(claims, alg, g.secret)
end
@en "IssueFor"
@fa "صدور برای"
pub func IssueFor(g: Guard, subject: str, ttl: i64): str throws:
mut c := NewClaims()
c.sub = subject
ret try Issue(g, c, ttl)
end
@en "IssuePair"
@fa "صدور جفت"
pub func IssuePair(g: Guard, subject: str, access_ttl: i64, refresh_ttl: i64, access &: str, refresh &: str) throws:
mut a := NewClaims()
a.sub = subject
SetStr(a, "kind", "access")
first := try Issue(g, a, access_ttl)
mut r := NewClaims()
r.sub = subject
r.jti = _refresh_id(subject)
SetStr(r, "kind", "refresh")
second := try Issue(g, r, refresh_ttl)
access = first
refresh = second
end
@en "SetSessionCookie"
@fa "تنظیم کوکی نشست"
pub func SetSessionCookie(ctx: i64, g: Guard, token: str, max_age: int):
_write_session_cookie(ctx, g, token, max_age, true)
end
@en "SetSessionCookieInsecure"
@fa "تنظیم کوکی نشست ناامن"
pub func SetSessionCookieInsecure(ctx: i64, g: Guard, token: str, max_age: int):
_write_session_cookie(ctx, g, token, max_age, false)
end
@en "ClearSessionCookie"
@fa "پاک کردن کوکی نشست"
pub func ClearSessionCookie(ctx: i64, g: Guard):
http.ClearCookie(ctx, _cookie_name(g))
end
package jwt
func _header_json(alg: str, kid: str): str:
mut sb := str.NewBuilder()
defer str.BufFree(sb)
str.BufAppend(sb, `{"alg":`)
str.BufAppend(sb, _quoted(alg))
str.BufAppend(sb, `,"typ":"JWT"`)
if kid.len() > 0:
str.BufAppend(sb, `,"kid":`)
str.BufAppend(sb, _quoted(kid))
end
str.BufAppendChar(sb, 125)
out := str.BufStr(sb)
ret out
end
func _signature(alg: str, secret: str, signing_input: str): str:
n := DigestSize(alg)
if n == 0: ret "" end
out := mem.Allocate(n as u64)
defer mem.Free(out)
if alg == JWT_HS256:
crypto.HmacSha256Bytes(secret, signing_input, out)
else alg == JWT_HS384:
crypto.HmacSha384Bytes(secret, signing_input, out)
else:
crypto.HmacSha512Bytes(secret, signing_input, out)
end
sig := B64UrlEncodeBytes(out, n)
ret sig
end
@en "SignJSON"
@fa "امضای جیسون"
pub func SignJSON(payload_json: str, alg: str, kid: str, secret: str): str throws:
if not IsSupportedAlg(alg):
throw _jwt_err(ErrorKind.Unsupported, "bad_alg", "unsupported algorithm")
end
if secret.len() == 0:
throw _jwt_err(ErrorKind.InvalidArgument, "empty_secret", "empty secret")
end
signing_input := B64UrlEncode(_header_json(alg, kid)).concat(".").concat(B64UrlEncode(payload_json))
ret signing_input.concat(".").concat(_signature(alg, secret, signing_input))
end
@en "SignatureOf"
@fa "امضای ورودی"
pub func SignatureOf(signing_input: str, alg: str, secret: str): str:
if secret.len() == 0: ret "" end
ret _signature(alg, secret, signing_input)
end
@en "SignWithKid"
@fa "امضا با شناسه کلید"
pub func SignWithKid(c: Claims, alg: str, kid: str, secret: str): str throws:
ret try SignJSON(ClaimsJSON(c), alg, kid, secret)
end
@en "Sign"
@fa "امضا"
pub func Sign(c: Claims, alg: str, secret: str): str throws:
ret try SignJSON(ClaimsJSON(c), alg, "", secret)
end
@en "SignHS256"
@fa "امضای اچ اس۲۵۶"
pub func SignHS256(c: Claims, secret: str): str throws:
ret try SignJSON(ClaimsJSON(c), JWT_HS256, "", secret)
end
@en "SignHS384"
@fa "امضای اچ اس۳۸۴"
pub func SignHS384(c: Claims, secret: str): str throws:
ret try SignJSON(ClaimsJSON(c), JWT_HS384, "", secret)
end
@en "SignHS512"
@fa "امضای اچ اس۵۱۲"
pub func SignHS512(c: Claims, secret: str): str throws:
ret try SignJSON(ClaimsJSON(c), JWT_HS512, "", secret)
end
package jwt
@en "Token"
@fa "توکن"
pub struct Token:
@en "alg"
@fa "الگوریتم"
pub alg: str = ""
@en "typ"
@fa "نوع"
pub typ: str = ""
@en "kid"
@fa "شناسه کلید"
pub kid: str = ""
@en "claims"
@fa "ادعاها"
pub claims: Claims = Claims {}
@en "header_json"
@fa "سرآیند جیسون"
pub header_json: str = ""
@en "payload_json"
@fa "بدنه جیسون"
pub payload_json: str = ""
@en "signing_input"
@fa "ورودی امضا"
pub signing_input: str = ""
@en "signature"
@fa "امضا"
pub signature: str = ""
@en "valid"
@fa "معتبر"
pub valid: bool = false
end
func _claim_raw(t: Token, key: str, found &: bool): str:
ret _member_raw(t.payload_json, key, found)
end
@en "Has"
@fa "دارد"
pub func Has(t: Token, key: str): bool:
mut found := false
_unused := _claim_raw(t, key, found)
ret found
end
@en "Raw"
@fa "خام"
pub func Raw(t: Token, key: str): str:
mut found := false
raw := _claim_raw(t, key, found)
if not found: ret "" end
ret raw
end
@en "Str"
@fa "رشته"
pub func Str(t: Token, key: str): str:
mut found := false
raw := _claim_raw(t, key, found)
if not found: ret "" end
ret _raw_to_str(raw)
end
@en "Int"
@fa "عدد"
pub func Int(t: Token, key: str): i64:
mut found := false
raw := _claim_raw(t, key, found)
if not found: ret 0 end
ret _raw_to_i64(raw)
end
@en "Bool"
@fa "منطقی"
pub func Bool(t: Token, key: str): bool:
mut found := false
raw := _claim_raw(t, key, found)
if not found: ret false end
ret raw == "true"
end
@en "HasAudience"
@fa "مخاطب دارد"
pub func HasAudience(t: Token, want: str): bool:
mut found := false
raw := _claim_raw(t, "aud", found)
if not found: ret false end
ret _raw_has_string(raw, want)
end
@en "ListHas"
@fa "فهرست دارد"
pub func ListHas(t: Token, key: str, want: str): bool:
mut found := false
raw := _claim_raw(t, key, found)
if not found: ret false end
ret _raw_has_string(raw, want)
end
@en "HasScope"
@fa "دامنه دارد"
pub func HasScope(t: Token, want: str): bool:
scopes := Str(t, "scope")
if scopes.len() == 0 or want.len() == 0: ret false end
n := scopes.len()
w := want.len()
mut i := 0
until i < n:
mut e := i
until e < n and scopes.substr(e, 1) != " ":
e++
end
if e - i == w and scopes.substr(i, w) == want: ret true end
i = e + 1
end
ret false
end
@en "SecondsRemaining"
@fa "ثانیه های باقی مانده"
pub func SecondsRemaining(t: Token): i64:
if t.claims.exp == 0 as i64: ret 0 end
ret t.claims.exp - time.Now()
end
package jwt
@en "Options"
@fa "گزینه ها"
pub struct Options:
@en "alg"
@fa "الگوریتم"
pub alg: str = "HS256"
@en "issuer"
@fa "صادرکننده"
pub issuer: str = ""
@en "audience"
@fa "مخاطب"
pub audience: str = ""
@en "subject"
@fa "موضوع"
pub subject: str = ""
@en "leeway"
@fa "تحمل اختلاف"
pub leeway: i64 = 0
@en "now"
@fa "اکنون"
pub now: i64 = 0
@en "require_exp"
@fa "انقضا لازم"
pub require_exp: bool = false
@en "require_nbf"
@fa "آغاز اعتبار لازم"
pub require_nbf: bool = false
@en "require_iat"
@fa "زمان صدور لازم"
pub require_iat: bool = false
@en "require_sub"
@fa "موضوع لازم"
pub require_sub: bool = false
@en "require_jti"
@fa "شناسه لازم"
pub require_jti: bool = false
@en "check_typ"
@fa "بررسی نوع"
pub check_typ: bool = true
end
func _split3(token: str, a &: str, b &: str, c &: str): bool:
n := token.len()
bp := _bp(token)
mut d1 := 0 - 1
mut d2 := 0 - 1
repeat n in i:
if _ub(bp, i) == 46:
if d1 < 0:
d1 = i
else d2 < 0:
d2 = i
else:
ret false
end
end
end
if d1 < 0 or d2 < 0: ret false end
if d1 == 0 or d2 == d1 + 1: ret false end
a = token.substr(0, d1)
b = token.substr(d1 + 1, d2 - d1 - 1)
c = token.substr(d2 + 1, n - d2 - 1)
ret true
end
func _once(text: str, key: str, dup &: str): str:
mut count := 0
value := _member_all(text, key, count)
if count > 1 and dup.len() == 0: dup = key end
ret value
end
func _read_claims(payload: str, c &: Claims, dup &: str):
c.iss = _raw_to_str(_once(payload, "iss", dup))
c.sub = _raw_to_str(_once(payload, "sub", dup))
c.jti = _raw_to_str(_once(payload, "jti", dup))
aud := _once(payload, "aud", dup)
if aud.len() > 0:
c.aud_raw = aud
c.aud = _raw_to_str(aud)
end
c.exp = _raw_to_i64(_once(payload, "exp", dup))
c.nbf = _raw_to_i64(_once(payload, "nbf", dup))
c.iat = _raw_to_i64(_once(payload, "iat", dup))
end
func _segment(text: str, start: int, part: str): str throws:
try:
ret B64UrlDecode(text)
catch e:
throw Error.At(ErrorKind.Syntax, "invalid base64url segment", start + e.offset).with_code("jwt.bad_base64").with_path(part).wrap("jwt")
end
end
func _bad_json(member: str): Error:
ret _jwt_err(ErrorKind.Syntax, "bad_json", "invalid JSON in header or payload").with_path(member)
end
func _parse(token: str): Token throws:
mut h := ""
mut p := ""
mut s := ""
if not _split3(token, h, p, s):
throw _jwt_err(ErrorKind.Syntax, "malformed", "malformed token")
end
header := try _segment(h, 0, "header")
payload := try _segment(p, h.len() + 1, "payload")
mut t := Token {}
mut alg_count := 0
alg := _raw_to_str(_member_all(header, "alg", alg_count))
if alg_count != 1:
throw _bad_json("alg")
end
mut dup := ""
t.alg = alg
t.typ = _raw_to_str(_once(header, "typ", dup))
t.kid = _raw_to_str(_once(header, "kid", dup))
t.header_json = header
t.payload_json = payload
t.signing_input = h.concat(".").concat(p)
t.signature = s
mut c := Claims {}
_read_claims(payload, c, dup)
t.claims = c
if dup.len() > 0:
throw _bad_json(dup)
end
ret t
end
func _typ_ok(typ: str): bool:
n := typ.len()
if n == 0: ret true end
if _lower(typ) == "jwt": ret true end
if n < 4: ret false end
ret _lower(typ.substr(n - 4, 4)) == "+jwt"
end
func _lower(s: str): str:
n := s.len()
bp := _bp(s)
mut sb := str.NewBuilder()
defer str.BufFree(sb)
repeat n in i:
mut c := _ub(bp, i)
if c >= 65 and c <= 90: c += 32 end
str.BufAppendChar(sb, c)
end
out := str.BufStr(sb)
ret out
end
func _rejected(code: str, message: str): Error:
ret _jwt_err(ErrorKind.PermissionDenied, code, message)
end
func _bad_claim(message: str, claim: str): Error:
ret _rejected("bad_claim", message).with_path(claim)
end
func _missing(claim: str): Error:
ret _jwt_err(ErrorKind.MissingKey, "missing_claim", "required claim missing").with_path(claim)
end
func _check_time(t: Token, opts: Options) throws:
mut now := opts.now
if now == 0 as i64: now = time.Now() end
if t.claims.exp != 0 as i64 and now - opts.leeway >= t.claims.exp:
throw _rejected("expired", "token expired")
end
if t.claims.nbf != 0 as i64 and now + opts.leeway < t.claims.nbf:
throw _rejected("not_yet_valid", "token not yet valid")
end
if t.claims.iat != 0 as i64 and now + opts.leeway < t.claims.iat:
throw _rejected("issued_in_future", "token issued in the future")
end
end
func _check_required(t: Token, opts: Options) throws:
if opts.require_exp and t.claims.exp == 0 as i64: throw _missing("exp") end
if opts.require_nbf and t.claims.nbf == 0 as i64: throw _missing("nbf") end
if opts.require_iat and t.claims.iat == 0 as i64: throw _missing("iat") end
if opts.require_sub and t.claims.sub.len() == 0: throw _missing("sub") end
if opts.require_jti and t.claims.jti.len() == 0: throw _missing("jti") end
end
func _check_claims(t: Token, opts: Options) throws:
if opts.issuer.len() > 0 and opts.issuer != t.claims.iss:
throw _bad_claim("issuer mismatch", "iss")
end
if opts.subject.len() > 0 and opts.subject != t.claims.sub:
throw _bad_claim("subject mismatch", "sub")
end
if opts.audience.len() > 0 and not HasAudience(t, opts.audience):
throw _bad_claim("audience mismatch", "aud")
end
try _check_required(t, opts)
try _check_time(t, opts)
end
@en "DefaultOptions"
@fa "گزینه های پیش فرض"
pub func DefaultOptions(): Options:
ret Options {}
end
@en "OptionsFor"
@fa "گزینه ها برای"
pub func OptionsFor(alg: str): Options:
ret Options { alg = alg }
end
@en "Decode"
@fa "کدگشایی"
pub func Decode(token: str): Token throws:
ret try _parse(token)
end
@en "Verify"
@fa "تایید"
pub func Verify(token: str, secret: str, opts: Options): Token throws:
mut t := try _parse(token)
if secret.len() == 0:
throw _jwt_err(ErrorKind.InvalidArgument, "empty_secret", "empty secret")
end
if not IsSupportedAlg(t.alg):
throw _jwt_err(ErrorKind.Unsupported, "bad_alg", "unsupported algorithm")
end
if opts.alg.len() > 0 and opts.alg != t.alg:
throw _rejected("alg_mismatch", "algorithm mismatch")
end
if opts.check_typ and not _typ_ok(t.typ):
throw _jwt_err(ErrorKind.Unsupported, "bad_typ", "unexpected typ header")
end
if _member_count(t.header_json, "crit") > 0:
throw _jwt_err(ErrorKind.Unsupported, "crit", "unsupported crit header")
end
expected := _signature(t.alg, secret, t.signing_input)
if not crypto.SecretEquals(expected, t.signature):
throw _rejected("bad_signature", "signature does not match")
end
try _check_claims(t, opts)
t.valid = true
ret t
end
@en "VerifyHS256"
@fa "تایید اچ اس۲۵۶"
pub func VerifyHS256(token: str, secret: str): Token throws:
ret try Verify(token, secret, Options {})
end
@en "IsValid"
@fa "معتبر است"
pub func IsValid(token: str, secret: str, opts: Options): bool:
try:
t := Verify(token, secret, opts)
ret t.valid
catch:
ret false
end
end
