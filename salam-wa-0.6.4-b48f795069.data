@en "AstDirective"
@fa "دستورالعمل نحوی"
pub struct AstDirective:
@en "name"
@fa "نام"
pub name: str = ""
@en "args"
@fa "آرگومان‌ها"
pub args: Vector<AstArgument> = Vector {}
