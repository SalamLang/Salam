@en "config"
@fa "پیکربندی"
package config
import str
import conv
import io
import collections
import encoding.yaml
import encoding.envfile
@en "Config"
@fa "پیکربندی"
pub struct Config:
@en "m"
@fa "نگاشت"
pub m: collections.OrderedMap = collections.OrderedMap {}
end
func _yaml_flatten(out &: Config, text: str, path: str):
keys := yaml.Keys(text, path)
defer keys.free()
repeat keys.len() in i:
k := keys.get(i)
mut full := k
if path.len() > 0: full = path.concat(".").concat(k) end
t := yaml.TypeOf(text, full)
if t == "map":
_yaml_flatten(out, text, full)
else:
Set(out, full, yaml.Get(text, full))
end
end
end
func _parse_value(raw: str): str:
ret envfile.ParseScalarEx(raw, true)
end
func _from_doc(d &: envfile.Doc): Config:
mut out := Config {}
repeat envfile.Len(d) in i:
Set(out, envfile.KeyAt(d, i), envfile.ValueAt(d, i))
end
ret out
end
func _to_doc(c &: Config): envfile.Doc:
mut d := envfile.New()
repeat c.m.len() in i:
envfile.Set(d, c.m.key_at(i), c.m.val_at(i))
end
ret d
end
func _section_of(key: str): str:
dot := key.find(".")
if dot < 0: ret "" end
ret key.substr(0, dot)
end
func _name_of(key: str): str:
dot := key.find(".")
if dot < 0: ret key end
ret key.substr(dot + 1, key.len() - dot - 1)
end
@en "New"
@fa "جدید"
pub func New(): Config:
ret Config {}
end
@en "Len"
@fa "طول"
pub func Len(c &: Config): int: ret c.m.len() end
@en "Has"
@fa "دارد"
pub func Has(c &: Config, key: str): bool: ret c.m.has(key) end
@en "Set"
@fa "تنظیم"
pub func Set(c &: Config, key: str, val: str):
c.m.set(key, val)
end
@en "Get"
@fa "دریافت"
pub func Get(c &: Config, key: str): str: ret c.m.get(key) end
@en "GetOr"
@fa "دریافت با پیش فرض"
pub func GetOr(c &: Config, key: str, def: str): str: ret c.m.get_or(key, def) end
@en "GetInt"
@fa "دریافت صحیح"
pub func GetInt(c &: Config, key: str, def: i64): i64:
i := c.m.index_of(key)
if i < 0: ret def end
ret conv.ParseIntOr(c.m.val_at(i), def)
end
@en "GetFloat"
@fa "دریافت اعشاری"
pub func GetFloat(c &: Config, key: str, def: f64): f64:
i := c.m.index_of(key)
if i < 0: ret def end
ret conv.ParseFloatOr(c.m.val_at(i), def)
end
@en "GetBool"
@fa "دریافت منطقی"
pub func GetBool(c &: Config, key: str, def: bool): bool:
i := c.m.index_of(key)
if i < 0: ret def end
ret conv.ParseBoolOr(c.m.val_at(i), def)
end
@en "Remove"
@fa "حذف"
pub func Remove(c &: Config, key: str): bool:
ret c.m.remove(key) >= 0
end
@en "Keys"
@fa "کلیدها"
pub func Keys(c &: Config): Vector<str>:
ret c.m.clone_keys()
end
@en "Section"
@fa "بخش"
pub func Section(c &: Config, name: str): Config:
mut out := Config {}
prefix := name.concat(".")
repeat c.m.len() in i:
k := c.m.key_at(i)
if str.StartsWith(k, prefix):
Set(out, k.substr(prefix.len(), k.len() - prefix.len()), c.m.val_at(i))
end
end
ret out
end
@en "Merge"
@fa "ادغام"
pub func Merge(base &: Config, override &: Config): Config:
mut out := Config {}
repeat base.m.len() in i:
Set(out, base.m.key_at(i), base.m.val_at(i))
end
repeat override.m.len() in i:
Set(out, override.m.key_at(i), override.m.val_at(i))
end
ret out
end
@en "Free"
@fa "آزادسازی"
pub func Free(c &: Config):
c.m.free()
end
@en "ParseINI"
@fa "تجزیه آی ان آی"
pub func ParseINI(text: str): Config:
mut out := Config {}
mut section := ""
lines := text.split("\n")
defer lines.free()
repeat lines.len() in i:
line := str.Trim(lines.get(i))
mut head := ""
if line.len() > 0: head = line.substr(0, 1) end
if head != "" and head != "#" and head != ";":
if head == "[" and str.EndsWith(line, "]"):
section = str.Trim(line.substr(1, line.len() - 2))
else:
eq_at := line.find("=")
if eq_at > 0:
mut key := str.Trim(line.substr(0, eq_at))
val := _parse_value(line.substr(eq_at + 1, line.len() - eq_at - 1))
if section.len() > 0:
key = section.concat(".").concat(key)
end
Set(out, key, val)
end
end
end
end
ret out
end
@en "ParseEnv"
@fa "تجزیه محیط"
pub func ParseEnv(text: str): Config:
mut d := envfile.Parse(text)
defer envfile.Free(d)
ret _from_doc(d)
end
@en "ParseYAML"
@fa "تجزیه یامل"
pub func ParseYAML(text: str): Config:
mut out := Config {}
_yaml_flatten(out, text, "")
ret out
end
@en "LoadINI"
@fa "بارگذاری آی ان آی"
pub func LoadINI(path: str): Config:
ret ParseINI(io.ReadFile(path))
end
@en "LoadEnv"
@fa "بارگذاری محیط"
pub func LoadEnv(path: str): Config:
ret ParseEnv(io.ReadFile(path))
end
@en "LoadYAML"
@fa "بارگذاری یامل"
pub func LoadYAML(path: str): Config:
ret ParseYAML(io.ReadFile(path))
end
@en "FormatINI"
@fa "قالب آی ان آی"
pub func FormatINI(c &: Config): str:
mut b := str.NewBuilder()
defer str.BufFree(b)
repeat c.m.len() in i:
k := c.m.key_at(i)
if _section_of(k) == "":
str.BufAppend(b, k)
str.BufAppend(b, " = ")
str.BufAppend(b, envfile.Quote(c.m.val_at(i)))
str.BufAppend(b, "\n")
end
end
done := Vector {} as Vector<str> defer done.free()
repeat c.m.len() in i:
sec := _section_of(c.m.key_at(i))
if sec != "" and collections.contains(done, sec) == false:
done.push(sec)
str.BufAppend(b, "[")
str.BufAppend(b, sec)
str.BufAppend(b, "]\n")
repeat c.m.len() in j:
kj := c.m.key_at(j)
if _section_of(kj) == sec:
str.BufAppend(b, _name_of(kj))
str.BufAppend(b, " = ")
str.BufAppend(b, envfile.Quote(c.m.val_at(j)))
str.BufAppend(b, "\n")
end
end
end
end
out := str.BufStr(b)
ret out
end
@en "FormatEnv"
@fa "قالب محیط"
pub func FormatEnv(c &: Config): str:
mut d := _to_doc(c)
defer envfile.Free(d)
ret envfile.Format(d)
end
@en "FormatEnvExport"
@fa "قالب محیط صادراتی"
pub func FormatEnvExport(c &: Config): str:
mut d := _to_doc(c)
defer envfile.Free(d)
ret envfile.FormatExport(d)
end
@en "console"
@fa "کنسول"
package console
import mem
import conv.numfmt
import str
extern:
func printf(fmt: str, ...): int
end
if SALAM_OS_WINDOWS:
extern:
func _write(fd: int, buf: void*, n: u32): int
end
else not (SALAM_ARCH_X86 or SALAM_ARCH_ARM or SALAM_ARCH_WASM):
extern:
func write(fd: int, buf: void*, n: u64): i64
end
else:
extern:
func write(fd: int, buf: void*, n: u32): int
end
end
export:
func salam_tostr_i32(x: int): str: ret numfmt.FormatInt(x as i64) end
func salam_tostr_i64(x: i64): str: ret numfmt.FormatInt(x) end
func salam_tostr_u32(x: u32): str: ret numfmt.FormatUint(x as u64) end
func salam_tostr_u64(x: u64): str: ret numfmt.FormatUint(x) end
func salam_tostr_bool(b: bool): str:
ret str.Clone(numfmt.FormatBool(b))
end
func salam_tostr_char(c: char): str:
ret char_from_code(c as int)
end
end
if not SALAM_KERNEL:
export:
func salam_tostr_f64(x: f64): str: ret numfmt.FormatFloat(x) end
end
end
if SALAM_OS_WINDOWS:
func _err_raw(s: str): _write(2, s as void*, s.len() as u32) end
func _out_raw(s: str): _write(1, s as void*, s.len() as u32) end
else not (SALAM_ARCH_X86 or SALAM_ARCH_ARM or SALAM_ARCH_WASM):
func _err_raw(s: str): write(2, s as void*, s.len() as u64) end
func _out_raw(s: str): write(1, s as void*, s.len() as u64) end
else:
func _err_raw(s: str): write(2, s as void*, s.len() as u32) end
func _out_raw(s: str): write(1, s as void*, s.len() as u32) end
end
export:
func salam_emit(s: str, err: int):
if err != 0:
_err_raw(s)
else:
if SALAM_FREESTANDING:
_out_raw(s)
else:
printf("%s", s)
end
end
end
func salam_emit_owned(s: str, err: int):
salam_emit(s, err)
mem.Free(s as void*)
end
end
@en "conv"
@fa "تبدیل"
package conv
import conv.numfmt
import mem
func _fill_hex(p: i8*, x: u64, ndigits: int):
p[ndigits] = 0 as i8
mut v := x
mut i := ndigits - 1
until i >= 0:
d := (v % (16 as u64)) as int
if d < 10:
p[i] = (d + 48) as i8
else:
p[i] = (d + 87) as i8
end
v /= (16 as u64)
i--
end
end
inline pure func _bp(s: str): i8*: ret (s as void*) as i8* end
inline pure func _ub(bp: i8*, i: int): int:
mut v := bp[i] as int
if v < 0: v += 256 end
ret v
end
pure func _native_digit(bp: i8*, i: int, n: int): int:
if i + 1 >= n:
ret 0 - 1
end
c := _ub(bp, i)
d := _ub(bp, i + 1)
if c == 219 and d >= 176 and d <= 185:
ret d - 176
end
if c == 217 and d >= 160 and d <= 169:
ret d - 160
end
ret 0 - 1
end
inline pure func _is_space(c: int): bool:
ret c == 32 or c == 9 or c == 10 or c == 13
end
pure func _kw(bp: i8*, i: int, w: int, kw: str): bool:
if w != kw.len(): ret false end
kp := _bp(kw)
repeat w in k:
if bp[i + k] != kp[k]: ret false end
end
ret true
end
pure func _kw_ci(bp: i8*, i: int, w: int, kw: str): bool:
if w != kw.len(): ret false end
kp := _bp(kw)
repeat w in k:
mut c := _ub(bp, i + k)
if c >= 65 and c <= 90: c += 32 end
if c != _ub(kp, k): ret false end
end
ret true
end
pure func _lead(bp: i8*, n: int): int:
mut i := 0
until i < n and _is_space(_ub(bp, i)):
i++
end
ret i
end
pure func _trail(bp: i8*, i: int, n: int): int:
mut e := n
until e > i and _is_space(_ub(bp, e - 1)):
e--
end
ret e
end
func _conv_err(s: str, kind: ErrorKind, message: str, offset: int, code: str): Error:
bp := _bp(s)
lim := offset < s.len() ? offset : s.len()
mut line := 1
mut column := 1
repeat lim in i:
b := _ub(bp, i)
if b == 10:
line++
column = 1
else (b & 192) != 128:
column++
end
end
ret Error.At(kind, message, offset).with_position(offset, line, column).with_code(code).wrap("conv")
end
pure func _char_desc(s: str, bp: i8*, i: int, n: int): str:
c := _ub(bp, i)
if c == 32: ret "space" end
if c == 9: ret "tab" end
if c == 10: ret "line break" end
if c == 13: ret "carriage return" end
if c > 32 and c < 127: ret "character '" + char_from_code(c) + "'" end
mut w := 0
if c >= 194 and c <= 223: w = 2
else c >= 224 and c <= 239: w = 3
else c >= 240 and c <= 244: w = 4
end
if w > 0 and i + w <= n:
mut whole := true
mut k := 1
until k < w:
if (_ub(bp, i + k) & 192) != 128: whole = false end
k++
end
if whole: ret "character '" + s.substr(i, w) + "'" end
end
hex := "0123456789ABCDEF"
ret "byte 0x" + hex.substr(c / 16, 1) + hex.substr(c % 16, 1)
end
func _bad_char(s: str, bp: i8*, i: int, n: int): Error:
ret _conv_err(s, ErrorKind.Syntax, "invalid " + _char_desc(s, bp, i, n), i, "conv.invalid_char")
end
func _empty_err(s: str, at: int): Error:
ret _conv_err(s, ErrorKind.Syntax, "empty input", at, "conv.empty")
end
func _parse_int(s: str, max_pos: i64, bits: str): i64 throws:
n := s.len()
bp := _bp(s)
mut i := _lead(bp, n)
e := _trail(bp, i, n)
if i >= e:
throw _empty_err(s, i)
end
start := i
c0 := _ub(bp, i)
mut neg := false
if c0 == 45 or c0 == 43:
neg = c0 == 45
i++
end
lim := neg ? 0 - max_pos - 1 : 0 - max_pos
mut v := 0 as i64
mut any := false
until i < e:
c := _ub(bp, i)
mut d := 0 - 1
mut w := 1
if c >= 48 and c <= 57:
d = c - 48
else:
d = _native_digit(bp, i, n)
w = 2
end
if d < 0:
throw _bad_char(s, bp, i, n)
end
if v < (lim + (d as i64)) / 10:
throw _conv_err(s, ErrorKind.OutOfRange, "number does not fit in " + bits, start, "conv.overflow")
end
v = v * 10 - (d as i64)
any = true
i += w
end
if not any:
throw _conv_err(s, ErrorKind.Syntax, "no digits after '" + char_from_code(c0) + "'", i, "conv.no_digits")
end
if neg: ret v end
ret 0 - v
end
pure func _hex_digit(c: int): int:
if c >= 48 and c <= 57: ret c - 48
else c >= 97 and c <= 102: ret c - 87
else c >= 65 and c <= 70: ret c - 55
else:
ret 0 - 1
end
end
pure func _float_digit(bp: i8*, i: int, n: int): int:
c := _ub(bp, i)
if c >= 48 and c <= 57: ret 1 end
if _native_digit(bp, i, n) >= 0: ret 2 end
ret 0
end
func _float_check(s: str): int throws:
n := s.len()
bp := _bp(s)
mut i := _lead(bp, n)
e := _trail(bp, i, n)
if i >= e:
throw _empty_err(s, i)
end
start := i
c0 := _ub(bp, i)
if c0 == 45 or c0 == 43:
i++
end
w := e - i
if _kw_ci(bp, i, w, "inf") or _kw_ci(bp, i, w, "infinity") or _kw_ci(bp, i, w, "nan"):
ret 0 - 1
end
mut digits := false
mut point := false
until i < e:
c := _ub(bp, i)
dw := _float_digit(bp, i, n)
if dw > 0:
digits = true
i += dw
else not point and c == 46:
point = true
i++
else not point and c == 217 and i + 1 < n and _ub(bp, i + 1) == 171:
point = true
i += 2
else:
break
end
end
if not digits:
if i < e:
throw _bad_char(s, bp, i, n)
end
throw _conv_err(s, ErrorKind.Syntax, "no digits after '" + s.substr(start, i - start) + "'", i, "conv.no_digits")
end
if i < e and (_ub(bp, i) == 101 or _ub(bp, i) == 69):
i++
if i < e and (_ub(bp, i) == 43 or _ub(bp, i) == 45):
i++
end
mut ed := false
until i < e:
dw := _float_digit(bp, i, n)
if dw == 0: break end
ed = true
i += dw
end
if not ed:
if i < e:
throw _bad_char(s, bp, i, n)
end
throw _conv_err(s, ErrorKind.Syntax, "no digits in the exponent", i, "conv.no_digits")
end
end
if i < e:
throw _bad_char(s, bp, i, n)
end
ret start
end
if not SALAM_KERNEL:
func _digits6(d: i64): str:
mut ds := ""
mut t := d
until t > 0:
ds = char_from_code((t % 10) as int + 48).concat(ds)
t /= 10
end
until ds.len() > 1 and ds.ends_with("0"):
ds = ds.substr(0, ds.len() - 1)
end
ret ds
end
func _exp_str(e: int): str:
mut es := "e+"
mut ea := e
if e < 0:
es = "e-"
ea = 0 - e
end
en := FormatInt(ea as i64)
if ea < 10: ret es.concat("0").concat(en) end
ret es.concat(en)
end
end
@en "FormatUint"
@fa "قالب عدد بی علامت"
pub func FormatUint(x: u64): str: ret numfmt.FormatUint(x) end
@en "FormatInt"
@fa "قالب عدد"
pub func FormatInt(n: i64): str: ret numfmt.FormatInt(n) end
@en "FormatBool"
@fa "قالب منطقی"
pub inline pure func FormatBool(b: bool): str:
if b: ret "true" end
ret "false"
end
@en "ParseBool"
@fa "تجزیه منطقی"
pub func ParseBool(s: str): bool throws:
n := s.len()
bp := _bp(s)
i := _lead(bp, n)
e := _trail(bp, i, n)
w := e - i
if w == 0:
throw _empty_err(s, i)
end
if _kw(bp, i, w, "true") or _kw(bp, i, w, "1") or _kw(bp, i, w, "yes") or _kw(bp, i, w, "on"):
ret true
end
if _kw(bp, i, w, "false") or _kw(bp, i, w, "0") or _kw(bp, i, w, "no") or _kw(bp, i, w, "off"):
ret false
end
throw _conv_err(s, ErrorKind.Syntax, "'" + s.substr(i, w) + "' is not a boolean", i, "conv.not_bool")
end
@en "ParseBoolOr"
@fa "تجزیه منطقی با پیش فرض"
pub func ParseBoolOr(s: str, fallback: bool): bool:
try:
ret ParseBool(s)
catch:
ret fallback
end
end
@en "ParseInt"
@fa "تجزیه عدد"
pub func ParseInt(s: str): i64 throws:
ret try _parse_int(s, 9223372036854775807 as i64, "64 bits")
end
@en "ParseIntOr"
@fa "تجزیه عدد با پیش فرض"
pub func ParseIntOr(s: str, fallback: i64): i64:
try:
ret ParseInt(s)
catch:
ret fallback
end
end
@en "Atoi"
@fa "رشته به عدد"
pub inline func Atoi(s: str): int throws:
ret (try _parse_int(s, 2147483647 as i64, "32 bits")) as int
end
@en "AtoiOr"
@fa "رشته به عدد با پیش فرض"
pub func AtoiOr(s: str, fallback: int): int:
try:
ret Atoi(s)
catch:
ret fallback
end
end
if not SALAM_KERNEL:
@en "ParseFloat"
@fa "تجزیه اعشار"
pub func ParseFloat(s: str): f64 throws:
start := try _float_check(s)
v := numfmt.ScanFloat(s)
if start >= 0 and v != 0.0 and v / 2.0 == v:
throw _conv_err(s, ErrorKind.OutOfRange, "number does not fit in a 64-bit float", start, "conv.overflow")
end
ret v
end
@en "ParseFloatOr"
@fa "تجزیه اعشار با پیش فرض"
pub func ParseFloatOr(s: str, fallback: f64): f64:
try:
ret ParseFloat(s)
catch:
ret fallback
end
end
@en "IsNaNF"
@fa "نامعتبر است"
pub inline pure func IsNaNF(x: f64): bool: ret x != x end
@en "FormatFloat"
@fa "قالب اعشار"
pub func FormatFloat(x: f64): str: ret numfmt.FormatFloat(x) end
@en "FormatFloatShort"
@fa "قالب اعشار کوتاه"
pub func FormatFloatShort(x: f64): str:
if x != x: ret "nan" end
mut v := x
mut sign := ""
if v < 0.0:
sign = "-"
v = 0.0 - v
end
if v == 0.0: ret sign.concat("0") end
if v / 2.0 == v: ret sign.concat("inf") end
mut e := 0
until v >= 10.0:
v /= 10.0
e++
end
until v < 1.0:
v *= 10.0
e--
end
mut d := (v * 100000.0 + 0.5) as i64
if d >= 1000000:
d /= 10
e++
end
ds := _digits6(d)
if e < (0 - 4) or e >= 6:
mut m := ds.substr(0, 1)
if ds.len() > 1:
m = m.concat(".").concat(ds.substr(1, ds.len() - 1))
end
ret sign.concat(m).concat(_exp_str(e))
else e >= 0:
k := e + 1
if ds.len() <= k:
mut out := ds
mut pad := k - ds.len()
until pad > 0:
out = out.concat("0")
pad--
end
ret sign.concat(out)
end
ret sign.concat(ds.substr(0, k)).concat(".").concat(ds.substr(k, ds.len() - k))
else:
mut zeros := ""
mut z := 0 - e - 1
until z > 0:
zeros = zeros.concat("0")
z--
end
ret sign.concat("0.").concat(zeros).concat(ds)
end
end
@en "FormatFloatPrec"
@fa "قالب اعشار با دقت"
pub func FormatFloatPrec(x: f64, prec: int): str:
if x != x: ret "nan" end
mut v := x
mut sign := ""
if v < 0.0:
sign = "-"
v = 0.0 - v
end
if v / 2.0 == v and v > 0.0: ret sign.concat("inf") end
mut p := prec
if p < 0: p = 0 end
if p > 15: p = 15 end
if v > 900000000000000.0: ret sign.concat(FormatFloat(v)) end
mut scale := 1 as i64
repeat p:
scale *= 10
end
total := (v * (scale as f64) + 0.5) as i64
ip := total / scale
if p == 0: ret sign.concat(FormatUint(ip as u64)) end
fp := total % scale
mut fs := FormatUint(fp as u64)
until fs.len() < p:
fs = "0".concat(fs)
end
ret sign.concat(FormatUint(ip as u64)).concat(".").concat(fs)
end
end
@en "FormatHex"
@fa "قالب شانزده"
pub func FormatHex(x: u64): str:
mut ndigits := 1
mut t := x
until t >= (16 as u64):
t /= (16 as u64)
ndigits++
end
buf := mem.MustAllocate((ndigits + 1) as u64) as str
_fill_hex(buf as i8*, x, ndigits)
ret buf
end
@en "ParseHex"
@fa "تجزیه شانزده"
pub func ParseHex(s: str): i64 throws:
n := s.len()
bp := _bp(s)
mut i := _lead(bp, n)
e := _trail(bp, i, n)
if i >= e:
throw _empty_err(s, i)
end
start := i
if i + 1 < e and _ub(bp, i) == 48 and _ub(bp, i + 1) == 120:
i += 2
end
mut v := 0 as u64
mut any := false
until i < e:
d := _hex_digit(_ub(bp, i))
if d < 0:
throw _bad_char(s, bp, i, n)
end
if v > (1152921504606846975 as u64):
throw _conv_err(s, ErrorKind.OutOfRange, "number does not fit in 64 bits", start, "conv.overflow")
end
v = v * (16 as u64) + (d as u64)
any = true
i++
end
if not any:
throw _conv_err(s, ErrorKind.Syntax, "no digits after '0x'", i, "conv.no_digits")
end
ret v as i64
end
@en "ParseHexOr"
@fa "تجزیه شانزده با پیش فرض"
pub func ParseHexOr(s: str, fallback: i64): i64:
try:
ret ParseHex(s)
catch:
ret fallback
end
end
package numfmt
const BN_CAP := 264
const BN_BYTES := 1064
const DEC_CHUNK := 1000000000
const POW5_13 := 1220703125
const POW5_13_EXP := 13
const POW2_29_EXP := 29
const MAX_DIGITS := 800
const DIGIT_BUF := 1200
const EXP_BIAS := 1023
const MANT_BITS := 52
const SUBNORMAL_EXP := -1074
const BN_REGS := 7
const OFF_DIGITS := 7448
const OFF_PUN := 8648
const SCRATCH_BYTES := 8704
const TWO52 := 0x10000000000000
const TWO53 := 0x20000000000000
mut _scratch := 0 as u64
mut _ready := false
func _bn_len(b: u32*): int:
ret b[0] as int
end
func _bn_set_len(b: u32*, n: int):
b[0] = n as u32
end
