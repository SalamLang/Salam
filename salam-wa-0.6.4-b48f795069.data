pub struct ClosedStream:
@en "unused"
@fa "بی‌کاربرد"
pub unused: int = 0
@en "Read"
@fa "خواندن"
pub func Read(_max: int): str:
ret ""
end
@en "ReadBytes"
@fa "خواندن بایت"
pub func ReadBytes(_buf: void*, _max: int): int:
ret 0
end
@en "Write"
@fa "نوشتن"
pub func Write(_data: str): int:
ret 0 - 1
end
@en "WriteBytes"
@fa "نوشتن بایت"
pub func WriteBytes(_ptr: void*, _n: int): int:
ret 0 - 1
end
@en "SetDeadline"
@fa "تنظیم مهلت"
pub func SetDeadline(millis: int):
this.unused = millis
end
@en "Shutdown"
@fa "خاموش کردن"
pub func Shutdown():
this.unused = 1
end
@en "CloseWrite"
@fa "بستن نوشتن"
pub func CloseWrite():
this.unused = 1
end
@en "Close"
@fa "بستن"
pub func Close():
this.unused = 1
end
@en "Ok"
@fa "معتبر"
pub func Ok(): bool:
ret false
end
end
