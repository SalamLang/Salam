end
_bz_put(w, 1, 0)
mut k := j
until k > 0:
pos6[k] = pos6[k - 1]
k--
end
pos6[0] = sv
end
repeat ng in t:
mut curr := lens[t * 258]
_bz_put(w, 5, curr)
repeat alpha in v:
tgt := lens[t * 258 + v]
until curr < tgt:
