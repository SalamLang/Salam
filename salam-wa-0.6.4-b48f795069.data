mut _huf := HufTables {}
func _huf_build():
if _huf.ready: ret end
mut counts := Vector {} as Vector<int>
mut first := Vector {} as Vector<int>
mut syms := Vector {} as Vector<int>
mut i := 0
until i <= _HUF_MAX_BITS + 1:
counts.push(0)
first.push(0)
i++
end
i = 0
until i < 257:
b := _HUF_BITS[i]
counts.set(b, counts.get(b) + 1)
i++
end
mut code := 0
mut len := 1
until len <= _HUF_MAX_BITS:
first.set(len, code)
mut s := 0
until s < 257:
if _HUF_BITS[s] == len: syms.push(s) end
s++
end
code = (code + counts.get(len)) * 2
len++
end
_huf.counts = counts
_huf.first = first
_huf.syms = syms
_huf.ready = true
end
func _byte_at(p: void*, i: int): int:
bp := p as i8*
mut v := bp[i] as int
if v < 0: v += 256 end
ret v
end
@en "HuffmanEncodedLen"
@fa "طول کدشده هافمن"
pub func HuffmanEncodedLen(p: void*, n: int): int:
mut bits := 0
mut i := 0
until i < n:
bits += _HUF_BITS[_byte_at(p, i)]
i++
end
ret (bits + 7) / 8
end
@en "HuffmanEncodedLenStr"
@fa "طول کدشده متن"
pub func HuffmanEncodedLenStr(s: str): int:
ret HuffmanEncodedLen(s as void*, s.len())
end
@en "HuffmanEncode"
@fa "کدگذاری هافمن"
pub func HuffmanEncode(out &: compress.ByteBuf, p: void*, n: int):
mut acc := 0 as u64
mut nbits := 0
mut i := 0
until i < n:
sym := _byte_at(p, i)
code := _HUF_CODE[sym]
bits := _HUF_BITS[sym]
acc = (acc << (bits as u64)) | (code as u64)
nbits += bits
until nbits >= 8:
nbits -= 8
compress.BufPush(out, ((acc >> (nbits as u64)) & (255 as u64)) as int)
end
i++
end
if nbits > 0:
pad := 8 - nbits
acc = (acc << (pad as u64)) | (((1 as u64) << (pad as u64)) - (1 as u64))
compress.BufPush(out, (acc & (255 as u64)) as int)
end
end
@en "HuffmanEncodeStr"
@fa "کدگذاری متن هافمن"
pub func HuffmanEncodeStr(s: str): compress.ByteBuf:
mut out := compress.NewByteBufCap(s.len() + 8)
HuffmanEncode(out, s as void*, s.len())
ret out
end
@en "HuffmanDecode"
@fa "کدگشایی هافمن"
pub func HuffmanDecode(src: compress.ByteBuf, from: int, len: int, ok &: bool): compress.ByteBuf:
_huf_build()
mut out := compress.NewByteBufCap(len * 2 + 8)
mut code := 0
mut code_len := 0
mut index := 0
mut firstc := 0
mut i := 0
until i < len:
b := compress.BufGet(src, from + i)
mut bit := 7
until bit >= 0:
code = (code * 2) | ((b >> bit) & 1)
code_len++
if code_len > _HUF_MAX_BITS:
ok = false
ret out
end
cnt := _huf.counts.get(code_len)
firstc = _huf.first.get(code_len)
if cnt > 0 and code - firstc < cnt and code >= firstc:
sym := _huf.syms.get(index + (code - firstc))
if sym >= 256:
ok = false
ret out
end
compress.BufPush(out, sym)
code = 0
code_len = 0
index = 0
firstc = 0
bit--
continue
end
index += cnt
bit--
end
i++
end
if code_len > 7:
ok = false
ret out
end
if code_len > 0:
allones := (1 << code_len) - 1
if code != allones:
ok = false
ret out
end
end
ok = true
ret out
end
@en "HuffmanDecodeBuf"
@fa "کدگشایی بافر هافمن"
pub func HuffmanDecodeBuf(src: compress.ByteBuf, ok &: bool): compress.ByteBuf:
ret HuffmanDecode(src, 0, compress.BufLen(src), ok)
end
