func _sc_same_shape(o: int, n: int): bool:
old_nd := _e.dom.nodes[o]
new_nd := _e.dom.nodes[n]
if old_nd.tag != new_nd.tag or old_nd.kids.len() != new_nd.kids.len():
ret false
end
if _attr(_e.dom, o, "key") != _attr(_e.dom, n, "key"):
ret false
end
repeat old_nd.kids.len() in i:
if not _sc_same_shape(old_nd.kids[i], new_nd.kids[i]):
ret false
end
end
ret true
end
func _sc_patch(o: int, n: int, map &: Vector<int>, nbefore: int):
map[n - nbefore] = o
old_nd := _e.dom.nodes[o]
new_nd := _e.dom.nodes[n]
if old_nd.text != new_nd.text:
mut a := _e.dom.nodes.ref(o)
mut b := _e.dom.nodes.ref(n)
t := a.text
a.text = b.text
b.text = t
_sc_text_nodes.push(o)
end
same := _sc_same_list(old_nd.names, new_nd.names) and _sc_same_list(old_nd.values, new_nd.values) and old_nd.d_base == new_nd.d_base and old_nd.d_hover == new_nd.d_hover and old_nd.d_focus == new_nd.d_focus and old_nd.d_active == new_nd.d_active and _sc_same_ints(old_nd.dyn, new_nd.dyn)
if not same:
mut a2 := _e.dom.nodes.ref(o)
mut b2 := _e.dom.nodes.ref(n)
tn := a2.names
a2.names = b2.names
b2.names = tn
tv := a2.values
a2.values = b2.values
b2.values = tv
td := a2.dyn
a2.dyn = b2.dyn
b2.dyn = td
a2.d_base = b2.d_base
a2.d_hover = b2.d_hover
a2.d_focus = b2.d_focus
a2.d_active = b2.d_active
_sc_el_changed.push(o)
end
repeat old_nd.kids.len() in i:
_sc_patch(old_nd.kids[i], new_nd.kids[i], map, nbefore)
end
end
func _sc_free_node(i: int):
