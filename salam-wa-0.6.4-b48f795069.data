@en "Detection"
@fa "شناسایی"
pub struct Detection:
@en "class_id"
@fa "شماره رده"
pub class_id: int = 0
@en "confidence"
@fa "اطمینان"
pub confidence: f64 = 0.0
@en "x"
@fa "افقی"
pub x: int = 0
@en "y"
@fa "عمودی"
pub y: int = 0
@en "width"
@fa "عرض"
pub width: int = 0
@en "height"
@fa "ارتفاع"
pub height: int = 0
end
@en "LoadNet"
@fa "بارگذاری شبکه"
pub func LoadNet(model_path: str, config_path: str): Net:
ret Net { handle = scv_dnn_load(model_path, config_path) }
end
@en "LoadNetSingleFile"
@fa "بارگذاری شبکه تک‌فایل"
pub func LoadNetSingleFile(path: str): Net:
ret LoadNet(path, "")
end
@en "ParseSSDDetections"
@fa "تجزیه شناسایی‌های اس‌اس‌دی"
pub func ParseSSDDetections(output: Mat, img_width: int, img_height: int, confidence_threshold: f64): Vector<Detection>:
mut out := Vector {} as Vector<Detection>
if output.handle == null: ret out end
n := output.total() / 7
p := output.data() as f32*
mut i := 0
until i < n:
base := i * 7
confidence := p[base + 2] as f64
if confidence >= confidence_threshold:
x1 := ((p[base + 3] as f64) * (img_width as f64)) as int
y1 := ((p[base + 4] as f64) * (img_height as f64)) as int
x2 := ((p[base + 5] as f64) * (img_width as f64)) as int
y2 := ((p[base + 6] as f64) * (img_height as f64)) as int
out.push(
Detection {
class_id = p[base + 1] as int, confidence = confidence, x = x1, y = y1, width = x2 - x1, height = y2 - y1,
}
)
end
i++
end
ret out
end
import ai.opencv
import os
func main:
args := os.Args()
mut path := "input.jpg"
if args.len() > 1:
path = args.get(1)
end
img := opencv.Read(path)
if not img.ok():
println "failed to read", path, "-", opencv.LastError()
ret 1
end
println "loaded", path, "-", img.width(), "x", img.height(), img.channels(), "channels"
gray := img.to_gray()
edges := gray.canny(50.0, 150.0)
opencv.Write("edges.png", edges)
println "wrote edges.png"
resized := img.resize(800, 600, opencv.INTERP_LINEAR)
opencv.Write("resized.png", resized)
println "wrote resized.png"
defer img.free()
defer gray.free()
defer edges.free()
defer resized.free()
ret 0
end
import ai.opencv
func main:
cam := opencv.OpenCamera(0)
if not cam.ok():
println "could not open camera 0 -", opencv.LastError()
ret 1
end
println "camera open - press 'q' or Esc to quit"
mut running := true
until running:
frame := cam.read()
if not frame.ok():
println "frame read failed -", opencv.LastError()
running = false
else:
edges := frame.to_gray().canny(50.0, 150.0)
opencv.Imshow("Camera", frame)
opencv.Imshow("Edges", edges)
frame.free()
edges.free()
key := opencv.WaitKey(1)
if key == 113 or key == 27:
running = false
end
end
end
cam.close()
opencv.DestroyAllWindows()
ret 0
end
import ai.opencv
import os
func main:
args := os.Args()
if args.len() < 3:
println "usage: 03_feature_matching <image_a> <image_b>"
ret 1
end
path_a := args.get(1)
path_b := args.get(2)
a := opencv.Read(path_a)
b := opencv.Read(path_b)
if not a.ok() or not b.ok():
println "failed to read one of the images -", opencv.LastError()
ret 1
end
kp_a := a.detect_orb(500)
kp_b := b.detect_orb(500)
println path_a, "-", kp_a.count(), "keypoints"
println path_b, "-", kp_b.count(), "keypoints"
desc_a := kp_a.descriptors()
desc_b := kp_b.descriptors()
matches := opencv.MatchDescriptors(desc_a, desc_b, 30, opencv.NORM_HAMMING) as Vector<opencv.Match>
println matches.len(), "matches (best first)"
mut i := 0
until i < matches.len():
m := matches.get(i)
println "  query", m.query_idx, "-> train", m.train_idx, "distance", m.distance
i++
end
defer a.free()
defer b.free()
defer kp_a.free()
defer kp_b.free()
defer desc_a.free()
defer desc_b.free()
ret 0
end
import ai.opencv
import os
func main:
args := os.Args()
if args.len() < 3:
println "usage: 04_face_detection <image> <cascade.xml>"
ret 1
end
img := opencv.Read(args.get(1))
if not img.ok():
println "failed to read image -", opencv.LastError()
ret 1
end
cascade := opencv.LoadCascade(args.get(2))
if not cascade.ok():
println "failed to load cascade -", opencv.LastError()
ret 1
end
gray := img.to_gray()
faces := cascade.detect(gray, 1.1, 3, 50) as Vector<opencv.DetectedObject>
println "found", faces.len(), "face(s)"
mut i := 0
until i < faces.len():
f := faces.get(i)
println "  face at (", f.x, ",", f.y, ") size", f.width, "x", f.height
img.rectangle(f.x, f.y, f.width, f.height, opencv.RGB(0, 255, 0), 2)
i++
end
opencv.Write("faces.png", img)
println "wrote faces.png"
defer img.free()
defer gray.free()
defer cascade.free()
ret 0
end
import ai.opencv
import os
func main:
args := os.Args()
mut path := "photo.jpg"
if args.len() > 1:
path = args.get(1)
end
img := opencv.Read(path)
if not img.ok():
println "failed to read", path, "-", opencv.LastError()
ret 1
end
gray := img.to_gray()
blurred := gray.gaussian_blur(5, 0.0)
edges := blurred.threshold_otsu(255.0)
cs := edges.find_contours()
println "found", cs.count(), "contour(s)"
mut best_idx := -1
mut best_area := 0.0
mut i := 0
until i < cs.count():
a := cs.area(i)
if a > best_area:
best_area = a
best_idx = i
end
i++
end
if best_idx < 0:
println "no document-sized contour found"
ret 1
end
println "largest contour area:", best_area
r := cs.bounding_rect(best_idx)
println "bounding box:", r.x, r.y, r.width, r.height
corners := Vector {} as Vector<opencv.Point>
corners.push(opencv.Point { x = r.x, y = r.y })
corners.push(opencv.Point { x = r.x + r.width, y = r.y })
corners.push(opencv.Point { x = r.x + r.width, y = r.y + r.height })
corners.push(opencv.Point { x = r.x, y = r.y + r.height })
flattened := img.warp_perspective(corners, 800, 1000)
opencv.Write("scanned.png", flattened)
println "wrote scanned.png"
defer img.free()
defer gray.free()
defer blurred.free()
defer edges.free()
defer cs.free()
defer flattened.free()
ret 0
end
import ai.opencv
import os
func main:
args := os.Args()
if args.len() < 3:
println "usage: 06_dnn_classification <image> <model.onnx>"
ret 1
end
img := opencv.Read(args.get(1))
if not img.ok():
println "failed to read image -", opencv.LastError()
ret 1
end
net := opencv.LoadNetSingleFile(args.get(2))
if not net.ok():
println "failed to load model -", opencv.LastError()
ret 1
end
ok := net.set_input(img, 1.0 / 255.0, opencv.RGB(0, 0, 0), true, opencv.Size { width = 224, height = 224 })
if not ok:
println "set_input failed -", opencv.LastError()
ret 1
end
output := net.forward()
if not output.ok():
println "forward pass failed -", opencv.LastError()
ret 1
end
n := output.total()
p := output.data() as f32*
mut best_idx := 0
mut best_score := p[0]
mut i := 1
until i < n:
if p[i] > best_score:
best_score = p[i]
best_idx = i
end
i++
end
println "predicted class:", best_idx, "score:", best_score
defer img.free()
defer net.free()
defer output.free()
ret 0
end
