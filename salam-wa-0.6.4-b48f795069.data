inline pure func _ub(p: void*, i: int): int:
b := ((p as i64 + i) as i8*)[0] as int
if b < 0: ret b + 256 end
ret b
end
func _bytes_to_str(p: void*, n: int): str:
buf := mem.Allocate((n + 1) as u64)
defer mem.Free(buf)
mem.Copy(buf, p, n as u64)
bufp := buf as i8*
bufp[n] = 0 as i8
ret str.Clone(buf as str)
end
func _is_space(c: str): bool:
ret c == " " or c == "\t" or c == "\r" or c == "\n"
end
func _ltrim(s: str): str:
mut a := 0
n := s.len()
until a < n:
if _is_space(s.substr(a, 1)):
a++
else:
ret s.substr(a, n - a)
end
end
ret ""
end
func _rtrim(s: str): str:
mut b := s.len()
until b > 0:
if _is_space(s.substr(b - 1, 1)):
b--
else:
ret s.substr(0, b)
end
end
ret ""
end
func _strip(s: str): str:
ret _rtrim(_ltrim(s))
end
func _put_u16(b &: compress.ByteBuf, v: int):
compress.BufPush(b, (v / 256) & 255)
compress.BufPush(b, v & 255)
end
func _encode_name(b &: compress.ByteBuf, name: str):
if name.len() == 0:
compress.BufPush(b, 0)
ret
end
labels := str.Split(name, ".")
mut i := 0
until i < labels.len():
lbl := labels.get(i)
compress.BufPush(b, lbl.len())
compress.BufPushBytes(b, lbl as void*, lbl.len())
i++
end
compress.BufPush(b, 0)
end
func _decode_name(data: void*, n: int, start: int, out_consumed &: int): str:
mut labels := Vector {} as Vector<str>
mut pos := start
mut jumped := false
mut consumed := 0
mut safety := 0
mut done := false
until not done:
safety++
if safety > 128 or pos < 0 or pos >= n:
done = true
continue
end
b0 := _ub(data, pos)
if (b0 & 192) == 192:
if pos + 1 >= n:
done = true
continue
end
b1 := _ub(data, pos + 1)
offset := ((b0 & 63) * 256) + b1
if not jumped:
consumed = (pos - start) + 2
end
jumped = true
pos = offset
else b0 == 0:
if not jumped:
consumed = (pos - start) + 1
end
done = true
else:
label_start := pos + 1
if label_start + b0 > n:
done = true
continue
end
labels.push(_bytes_to_str((data as i64 + label_start) as void*, b0))
pos = label_start + b0
end
end
out_consumed = consumed
mut name := ""
mut i := 0
until i < labels.len():
if i > 0: name += "." end
name += labels.get(i)
i++
end
ret name
end
func _format_ipv4(data: void*, pos: int): str:
a := _ub(data, pos)
b := _ub(data, pos + 1)
c := _ub(data, pos + 2)
d := _ub(data, pos + 3)
ret str.FromInt(a as i64) + "." + str.FromInt(b as i64) + "." + str.FromInt(c as i64) + "." + str.FromInt(d as i64)
end
func _hex1(v: int): str:
digits := "0123456789abcdef"
ret digits.substr(v, 1)
end
func _format_ipv6(data: void*, pos: int): str:
mut out := ""
mut i := 0
until i < 16:
hi := _ub(data, pos + i)
lo := _ub(data, pos + i + 1)
g := (hi * 256) + lo
mut piece := ""
mut started := false
mut shift := 12
until shift >= 0:
nib := (g >> shift) & 15
if nib != 0 or started or shift == 0:
piece += _hex1(nib)
started = true
end
shift -= 4
end
out += piece
if i < 14: out += ":" end
i += 2
end
ret out
end
func _decode_txt(data: void*, pos: int, rdlength: int): str:
mut out := ""
mut p := pos
end_pos := pos + rdlength
until p < end_pos:
label_len := _ub(data, p)
cstart := p + 1
if cstart + label_len > end_pos: ret out end
out += _bytes_to_str((data as i64 + cstart) as void*, label_len)
p = cstart + label_len
end
ret out
end
func _decode_rr(data: void*, n: int, pos: int, out_next &: int): Record:
mut rec := Record {}
mut consumed := 0
rec.name = _decode_name(data, n, pos, consumed)
p := pos + consumed
if p + 10 > n:
out_next = n
ret rec
end
rec.rtype = (_ub(data, p) * 256) + _ub(data, p + 1)
rec.rclass = (_ub(data, p + 2) * 256) + _ub(data, p + 3)
rec.ttl = (_ub(data, p + 4) * 16777216) + (_ub(data, p + 5) * 65536) + (_ub(data, p + 6) * 256) + _ub(data, p + 7)
rdlength := (_ub(data, p + 8) * 256) + _ub(data, p + 9)
rdata_start := p + 10
if rdata_start + rdlength > n:
out_next = n
ret rec
end
if rec.rtype == TypeA and rdlength == 4:
rec.data = _format_ipv4(data, rdata_start)
else rec.rtype == TypeAAAA and rdlength == 16:
rec.data = _format_ipv6(data, rdata_start)
else rec.rtype == TypeCNAME or rec.rtype == TypeNS or rec.rtype == TypePTR:
mut nl := 0
rec.data = _decode_name(data, n, rdata_start, nl)
else rec.rtype == TypeMX and rdlength >= 2:
rec.priority = (_ub(data, rdata_start) * 256) + _ub(data, rdata_start + 1)
mut nl2 := 0
rec.data = _decode_name(data, n, rdata_start + 2, nl2)
else rec.rtype == TypeTXT:
rec.data = _decode_txt(data, rdata_start, rdlength)
else:
rec.data = ""
end
out_next = rdata_start + rdlength
ret rec
end
func _random_id(): int:
buf := mem.Allocate(2 as u64)
defer mem.Free(buf)
crypto.RandomBytes(buf, 2)
bp := buf as i8*
mut b0 := bp[0] as int
mut b1 := bp[1] as int
if b0 < 0: b0 += 256 end
if b1 < 0: b1 += 256 end
ret (b0 * 256) + b1
end
func _reverse_name4(ip: str): str:
parts := str.Split(ip, ".")
if parts.len() != 4: ret "" end
p0 := parts.get(0)
p1 := parts.get(1)
p2 := parts.get(2)
p3 := parts.get(3)
ret p3 + "." + p2 + "." + p1 + "." + p0 + ".in-addr.arpa"
end
func _reverse_name6(ip: str): str:
hex := rawsock.HexIPv6(ip)
if hex.len() != 32: ret "" end
mut out := ""
mut i := 31
until i >= 0:
out += hex.substr(i, 1) + "."
i--
end
ret out + "ip6.arpa"
end
func _lookup_records(name: str, qtype: int): Records:
mut out := Records {}
servers := DefaultServers()
mut si := 0
until si < servers.len():
msg := QueryServer(servers.get(si), name, qtype, 3000)
if msg.answers.items.len() > 0:
mut i := 0
until i < msg.answers.items.len():
rec := msg.answers.items.get(i)
if rec.rtype == qtype:
out.items.push(rec)
end
i++
end
si = servers.len()
continue
end
si++
end
ret out
end
func _records_to_strings(recs: Records): Vector<str>:
mut out := Vector {} as Vector<str>
mut i := 0
until i < recs.items.len():
out.push(recs.items.get(i).data)
i++
end
ret out
end
@en "EncodeQuery"
@fa "کدگذاری پرسش"
pub func EncodeQuery(name: str, qtype: int, id: int): compress.ByteBuf:
mut b := compress.NewByteBuf()
_put_u16(b, id)
_put_u16(b, 256)
_put_u16(b, 1)
_put_u16(b, 0)
_put_u16(b, 0)
_put_u16(b, 0)
_encode_name(b, name)
_put_u16(b, qtype)
_put_u16(b, ClassIN)
ret b
end
@en "Decode"
@fa "کدگشایی"
pub func Decode(data: void*, n: int): Message:
mut msg := Message {}
if n < 12: ret msg end
flags0 := _ub(data, 2)
flags1 := _ub(data, 3)
msg.id = (_ub(data, 0) * 256) + _ub(data, 1)
msg.qr = (flags0 & 128) != 0
msg.opcode = (flags0 >> 3) & 15
msg.aa = (flags0 & 4) != 0
msg.tc = (flags0 & 2) != 0
msg.rd = (flags0 & 1) != 0
msg.ra = (flags1 & 128) != 0
msg.rcode = flags1 & 15
qdcount := (_ub(data, 4) * 256) + _ub(data, 5)
ancount := (_ub(data, 6) * 256) + _ub(data, 7)
nscount := (_ub(data, 8) * 256) + _ub(data, 9)
arcount := (_ub(data, 10) * 256) + _ub(data, 11)
mut pos := 12
mut qi := 0
until qi < qdcount:
mut consumed := 0
qname := _decode_name(data, n, pos, consumed)
if consumed <= 0 or pos + 4 > n:
qi = qdcount
continue
end
pos += consumed
if pos + 4 > n:
qi = qdcount
continue
end
qtype := (_ub(data, pos) * 256) + _ub(data, pos + 1)
qclass := (_ub(data, pos + 2) * 256) + _ub(data, pos + 3)
pos += 4
msg.questions.items.push(Question { name = qname, qtype = qtype, qclass = qclass })
qi++
end
mut ai := 0
until ai < ancount:
mut nextp := 0
rec := _decode_rr(data, n, pos, nextp)
if nextp <= pos:
ai = ancount
continue
end
pos = nextp
msg.answers.items.push(rec)
ai++
end
mut ni := 0
until ni < nscount:
mut nextp := 0
rec := _decode_rr(data, n, pos, nextp)
if nextp <= pos:
ni = nscount
continue
end
pos = nextp
msg.authorities.items.push(rec)
ni++
end
mut xi := 0
until xi < arcount:
mut nextp := 0
rec := _decode_rr(data, n, pos, nextp)
if nextp <= pos:
xi = arcount
continue
end
pos = nextp
msg.extras.items.push(rec)
xi++
end
ret msg
end
@en "Lookup"
@fa "جستجو"
pub func Lookup(host: str): str:
ret rawsock.Resolve(host)
end
@en "QueryServer"
@fa "پرسش از کارگزار"
pub func QueryServer(server: str, name: str, qtype: int, timeout_ms: int): Message:
msg := Message {}
sock := udp.OpenAny()
if not udp.Ok(sock): ret msg end
defer udp.Close(sock)
udp.SetTimeout(sock, timeout_ms)
id := _random_id()
q := EncodeQuery(name, qtype, id)
sent := udp.SendBytes(sock, server, 53, q.data, q.len)
if sent < 0: ret msg end
cap := 4096
buf := mem.Allocate(cap as u64)
defer mem.Free(buf)
mut fh := ""
mut fp := 0
n := udp.ReceiveBytes(sock, buf, cap, fh, fp)
if n <= 0: ret msg end
ret Decode(buf, n)
end
@en "DefaultServers"
@fa "کارگزارهای پیش‌فرض"
pub func DefaultServers(): Vector<str>:
mut out := Vector {} as Vector<str>
if SALAM_OS_UNIX:
if os.Exists("/etc/resolv.conf"):
content := io.ReadFile("/etc/resolv.conf")
lines := str.Split(content, "\n")
mut i := 0
until i < lines.len():
line := _strip(lines.get(i))
if line.len() > 11 and line.starts_with("nameserver "):
ip := _strip(line.substr(11, line.len() - 11))
if ip.len() > 0: out.push(ip) end
end
i++
end
end
end
if out.len() == 0:
out.push("8.8.8.8")
out.push("1.1.1.1")
end
ret out
end
@en "LookupA"
@fa "جستجوی آ"
pub func LookupA(name: str): Vector<str>:
ret _records_to_strings(_lookup_records(name, TypeA))
end
@en "LookupAAAA"
@fa "جستجوی کواداِی"
pub func LookupAAAA(name: str): Vector<str>:
ret _records_to_strings(_lookup_records(name, TypeAAAA))
end
@en "LookupCNAME"
@fa "جستجوی سی‌نیم"
pub func LookupCNAME(name: str): str:
recs := _lookup_records(name, TypeCNAME)
if recs.items.len() > 0: ret recs.items.get(0).data end
ret ""
end
@en "LookupMX"
@fa "جستجوی ام‌ایکس"
pub func LookupMX(name: str): Records:
ret _lookup_records(name, TypeMX)
end
@en "LookupTXT"
@fa "جستجوی تی‌ایکس‌تی"
pub func LookupTXT(name: str): Vector<str>:
ret _records_to_strings(_lookup_records(name, TypeTXT))
end
@en "LookupPTR"
@fa "جستجوی معکوس"
pub func LookupPTR(ip: str): Vector<str>:
mut rname := _reverse_name4(ip)
if rname.len() == 0: rname = _reverse_name6(ip) end
if rname.len() == 0: ret Vector {} end
ret _records_to_strings(_lookup_records(rname, TypePTR))
end
package doh
import mem
import str
import crypto
import compress
import net.dns
import net.tcp
import net.udp
import net.internal.rawsock
import sync
import time
import tls
import net.http2
const MAX_HTTP_REPLY := 1048576
mut _pool_mu := sync.NewMutex()
mut _h2_only := HashMap {} as HashMap<str, bool>
mut _pool_items := Vector {} as Vector<PoolItem>
mut _pool_reused := 0 as i64
struct PoolItem:
pub key: str = ""
pub io: Io = Io {}
pub at_ms: i64 = 0
end
struct Io:
pub use_tls: bool = false
pub tc: tcp.Conn = tcp.Conn {}
pub sc: tls.Conn = tls.Conn {}
pub ok: bool = false
end
@en "Response"
@fa "پاسخ"
pub struct Response:
@en "ok"
@fa "معتبر"
pub ok: bool = false
@en "raw"
@fa "پاسخ خام"
pub raw: compress.ByteBuf = compress.ByteBuf {}
@en "msg"
@fa "پیام"
pub msg: dns.Message = dns.Message {}
@en "rtt_ms"
@fa "زمان رفت‌وبرگشت"
pub rtt_ms: i64 = 0
@en "server"
@fa "کارگزار"
pub server: str = ""
@en "err"
@fa "خطا"
pub err: str = ""
end
func _dial(addr: str, port: int, use_tls: bool, sni: str, insecure: bool, timeout_ms: int): Io:
mut io := Io { use_tls = use_tls }
if use_tls:
mut cfg := tls.NewConfig(sni)
cfg.insecure_skip_verify = insecure
io.sc = tls.Dial(addr, port, cfg)
io.ok = tls.ConnOk(io.sc)
if io.ok:
rawsock.SetTimeout(rawsock.FromFd(tls.Fd(io.sc)), timeout_ms)
end
else:
io.tc = tcp.DialTimeout(addr, port, timeout_ms)
io.ok = tcp.ConnOk(io.tc)
if io.ok:
tcp.SetReadDeadline(io.tc, timeout_ms)
end
end
ret io
end
func _io_write(io &: Io, p: void*, n: int): bool:
mut off := 0
until off < n:
src := ((p as i64) + (off as i64)) as void*
mut w := 0
if io.use_tls:
w = tls.WriteBytes(io.sc, src, n - off)
else:
w = tcp.WriteBytes(io.tc, src, n - off)
end
if w <= 0:
ret false
end
off += w
end
ret true
end
func _io_read(io &: Io, buf: void*, max: int): int:
if io.use_tls:
ret tls.ReadBytes(io.sc, buf, max)
end
ret tcp.ReadBytes(io.tc, buf, max)
end
func _io_timeout(io &: Io, ms: int):
if io.use_tls:
rawsock.SetTimeout(rawsock.FromFd(tls.Fd(io.sc)), ms)
else:
tcp.SetReadDeadline(io.tc, ms)
end
end
func _pool_key(srv: Server, addr: str): str:
mut k := addr + ":" + str.FromInt(srv.port as i64) + ":" + srv.host
if srv.use_tls:
k += ":t"
end
if srv.insecure:
k += ":i"
end
ret k
end
func _pool_take(key: str): Io:
mut got := Io {}
_l := sync.Lock(_pool_mu)
now := sync.NowMs()
total := _pool_items.len()
repeat total in k:
i := total - 1 - k
it := _pool_items.get(i)
if now - it.at_ms > 30000:
mut dead := it.io
_io_close(dead)
_gone := _pool_items.remove_at(i)
else it.key == key and not got.ok:
got = it.io
_gone := _pool_items.remove_at(i)
_pool_reused++
end
end
_u := sync.Unlock(_pool_mu)
ret got
end
func _pool_put(key: str, io: Io):
_l := sync.Lock(_pool_mu)
if _pool_items.len() >= 8:
mut old := _pool_items.get(0).io
_io_close(old)
_gone2 := _pool_items.remove_at(0)
end
_pool_items.push(PoolItem { key = key, io = io, at_ms = sync.NowMs() })
_u := sync.Unlock(_pool_mu)
end
func _io_close(io &: Io):
if io.use_tls:
tls.Close(io.sc)
else:
tcp.Close(io.tc)
end
end
func _find_bytes(b: compress.ByteBuf, pat: str, from: int): int:
pl := pat.len()
mut i := from
until i + pl <= b.len:
mut m := true
repeat pl in j:
if compress.BufGet(b, i + j) != (pat as u8*)[j] as int:
m = false
break
end
end
if m:
ret i
end
i++
end
ret 0 - 1
end
func _slice_str(b: compress.ByteBuf, off: int, n: int): str:
buf := mem.Allocate((n + 1) as u64)
if n > 0:
mem.Copy(buf, ((b.data as i64) + (off as i64)) as void*, n as u64)
end
(buf as u8*)[n] = 0 as u8
ret buf as str
end
func _header_value(head: str, name: str): str:
lower := head.lower()
idx := lower.find("\r\n" + name + ":")
if idx < 0:
ret ""
end
start := idx + 2 + name.len() + 1
rest := head.substr(start, head.len() - start)
mut e := rest.find("\r\n")
if e < 0:
e = rest.len()
end
ret str.Trim(rest.substr(0, e))
end
func _hex_num(s: str): int:
mut v := 0
repeat s.len() in i:
h := _hexval((s as u8*)[i] as int)
if h < 0:
break
end
v = v * 16 + h
if v > 16777216:
ret 0 - 1
end
end
ret v
end
func _all_digits(s: str): bool:
if s.len() == 0 or s.len() > 8:
ret false
end
repeat s.len() in i:
c := (s as u8*)[i] as int
if c < 48 or c > 57:
ret false
end
end
ret true
end
func _dechunk(raw: compress.ByteBuf, start: int, out &: compress.ByteBuf): bool:
mut pos := start
until true:
eol := _find_bytes(raw, "\r\n", pos)
if eol < 0:
ret false
end
size := _hex_num(_slice_str(raw, pos, eol - pos))
pos = eol + 2
if size < 0:
ret false
end
if size == 0:
ret true
end
if size > raw.len - pos:
ret false
end
compress.BufPushBytes(out, ((raw.data as i64) + (pos as i64)) as void*, size)
pos += size + 2
end
end
func _http_done(raw: compress.ByteBuf): bool:
hend := _find_bytes(raw, "\r\n\r\n", 0)
if hend < 0:
ret false
end
head := _slice_str(raw, 0, hend)
cl := _header_value(head, "content-length")
if cl.len() > 0:
if not _all_digits(cl):
ret true
end
ret raw.len >= hend + 4 + cl.to_int()
end
te := _header_value(head, "transfer-encoding").lower()
if te.find("chunked") >= 0:
ret raw.len >= hend + 9 and _find_bytes(raw, "0\r\n\r\n", raw.len - 5) >= 0
end
ret false
end
func _read_http_body(io &: Io, body &: compress.ByteBuf, keep &: bool): str:
keep = false
mut raw := compress.NewByteBuf()
defer compress.BufFree(raw)
cap := 8192
buf := mem.Allocate(cap as u64)
defer mem.Free(buf)
until true:
n := _io_read(io, buf, cap)
if n <= 0:
break
end
compress.BufPushBytes(raw, buf, n)
if raw.len > MAX_HTTP_REPLY:
ret "response too large"
end
if _http_done(raw):
break
end
end
hend := _find_bytes(raw, "\r\n\r\n", 0)
if hend < 0:
ret "no http response"
end
head := _slice_str(raw, 0, hend)
sp := head.find(" ")
if sp < 0:
ret "bad status line"
end
status := head.substr(sp + 1, 3)
if status != "200":
ret "http " + status
end
te := _header_value(head, "transfer-encoding").lower()
conn := _header_value(head, "connection").lower()
start := hend + 4
if te.find("chunked") >= 0:
if not _dechunk(raw, start, body):
ret "bad chunked body"
end
keep = conn.find("close") < 0 and head.starts_with("HTTP/1.1")
ret ""
end
cl := _header_value(head, "content-length")
if cl.len() > 0 and not _all_digits(cl):
ret "bad content-length"
end
mut take := raw.len - start
if cl.len() > 0 and cl.to_int() < take:
take = cl.to_int()
end
compress.BufPushBytes(body, ((raw.data as i64) + (start as i64)) as void*, take)
keep = cl.len() > 0 and raw.len == start + take and conn.find("close") < 0 and head.starts_with("HTTP/1.1")
ret ""
end
func _b64url(b: compress.ByteBuf): str:
mut s := compress.BufToBase64(b)
s = str.Replace(s, "+", "-")
s = str.Replace(s, "/", "_")
s = str.Replace(s, "=", "")
ret s
end
func _random_id(): int:
buf := mem.Allocate(2 as u64)
defer mem.Free(buf)
crypto.RandomBytes(buf, 2)
ret ((buf as u8*)[0] as int) * 256 + ((buf as u8*)[1] as int)
end
func _check_response(raw: compress.ByteBuf, wire: compress.ByteBuf, want_id: int, check_id: bool): str:
if raw.len < 12:
ret "short dns message"
end
if (compress.BufGet(raw, 2) & 128) == 0:
ret "not a response"
end
if check_id and compress.BufGet(raw, 0) * 256 + compress.BufGet(raw, 1) != want_id:
ret "id mismatch"
end
if not _same_question(wire.data, wire.len, raw.data, raw.len):
ret "question mismatch"
end
ret ""
end
func _doh_request(srv: Server, wire: compress.ByteBuf): compress.ByteBuf:
mut host_header := srv.host
if srv.port != 443 and srv.port != 80:
host_header = srv.host + ":" + str.FromInt(srv.port as i64)
end
mut req := ""
mut full := compress.NewByteBuf()
if srv.kind == KindDoHGet:
mut sep := "?"
if srv.path.find("?") >= 0:
sep = "&"
end
req = "GET " + srv.path + sep + "dns=" + _b64url(wire) + " HTTP/1.1\r\nHost: " + host_header + "\r\nAccept: application/dns-message\r\nUser-Agent: salam-doh\r\nConnection: keep-alive\r\n\r\n"
compress.BufPushBytes(full, req as void*, req.len())
else:
req = "POST " + srv.path + " HTTP/1.1\r\nHost: " + host_header + "\r\nAccept: application/dns-message\r\nContent-Type: application/dns-message\r\nUser-Agent: salam-doh\r\nConnection: keep-alive\r\nContent-Length: " + str.FromInt(wire.len as i64) + "\r\n\r\n"
compress.BufPushBytes(full, req as void*, req.len())
compress.BufPushBuf(full, wire)
end
ret full
end
func _doh_exchange(io &: Io, full: compress.ByteBuf, out &: compress.ByteBuf, keep &: bool): str:
if not _io_write(io, full.data, full.len):
ret "write failed"
end
ret _read_http_body(io, out, keep)
end
func _h2_required(key: str): bool:
sync.Lock(_pool_mu)
r := _h2_only.has(key)
sync.Unlock(_pool_mu)
ret r
end
func _query_doh_h2(srv: Server, addr: str, wire: compress.ByteBuf, timeout_ms: int, out &: compress.ByteBuf): str:
mut cfg := tls.NewConfig(srv.host)
cfg.insecure_skip_verify = srv.insecure
cfg.alpn = "h2"
sec := tls.Dial(addr, srv.port, cfg)
if not tls.ConnOk(sec):
ret "connect failed"
end
if timeout_ms > 0:
tcp.SetReadDeadline(tcp.ConnFromFd(tls.Fd(sec)), timeout_ms)
end
mut c := http2.NewConn(http2.TLSTransport(sec), false)
defer http2.CloseConn(c)
if not http2.ClientHandshake(c):
ret "h2 handshake failed"
end
if http2.Poll(c) == http2.H2_POLL_ERROR:
ret "no h2 settings"
end
sid := http2.NextStreamId(c)
mut hl := http2.HeaderList {}
get := srv.kind == KindDoHGet
mut path := srv.path
if get:
mut sep := "?"
if path.find("?") >= 0:
sep = "&"
end
path = path + sep + "dns=" + _b64url(wire)
http2.HeadersAdd(hl, ":method", "GET")
else:
http2.HeadersAdd(hl, ":method", "POST")
end
http2.HeadersAdd(hl, ":scheme", "https")
http2.HeadersAdd(hl, ":authority", srv.host)
http2.HeadersAdd(hl, ":path", path)
http2.HeadersAdd(hl, "accept", "application/dns-message")
http2.HeadersAdd(hl, "user-agent", "salam-doh")
if not get:
http2.HeadersAdd(hl, "content-type", "application/dns-message")
http2.HeadersAdd(hl, "content-length", str.FromInt(wire.len as i64))
end
if not http2.SendHeaders(c, sid, hl, get):
ret "h2 write failed"
end
if not get and not http2.SendData(c, sid, wire, true):
ret "h2 write failed"
end
if not http2.AwaitStreamEnd(c, sid, 400):
ret "h2 read failed"
end
st := http2.StreamAt(c, sid)
status := http2.HeadersGet(st.headers, ":status")
if status != "200":
ret "http " + status
end
compress.BufPushBuf(out, st.data)
ret ""
end
func _query_doh(srv: Server, addr: str, wire: compress.ByteBuf, timeout_ms: int, out &: compress.ByteBuf): str:
key := _pool_key(srv, addr)
if srv.use_tls and _h2_required(key):
ret _query_doh_h2(srv, addr, wire, timeout_ms, out)
end
mut full := _doh_request(srv, wire)
defer compress.BufFree(full)
mut io := _pool_take(key)
reused := io.ok
if reused:
_io_timeout(io, timeout_ms)
else:
io = _dial(addr, srv.port, srv.use_tls, srv.host, srv.insecure, timeout_ms)
if not io.ok:
ret "connect failed"
end
end
mut keep := false
mut err := _doh_exchange(io, full, out, keep)
if err.len() > 0 and reused:
_io_close(io)
compress.BufReset(out)
io = _dial(addr, srv.port, srv.use_tls, srv.host, srv.insecure, timeout_ms)
if not io.ok:
ret "connect failed"
end
err = _doh_exchange(io, full, out, keep)
end
if err.len() == 0 and keep:
_pool_put(key, io)
else:
_io_close(io)
end
if err == "http 505" and srv.use_tls:
compress.BufReset(out)
sync.Lock(_pool_mu)
_h2_only.put(key, true)
sync.Unlock(_pool_mu)
ret _query_doh_h2(srv, addr, wire, timeout_ms, out)
end
ret err
end
func _query_dot(srv: Server, addr: str, wire: compress.ByteBuf, timeout_ms: int, out &: compress.ByteBuf): str:
mut io := _dial(addr, srv.port, true, srv.host, srv.insecure, timeout_ms)
if not io.ok:
ret "connect failed"
end
defer _io_close(io)
mut full := compress.NewByteBufCap(wire.len + 2)
compress.BufPush(full, (wire.len >> 8) & 255)
compress.BufPush(full, wire.len & 255)
compress.BufPushBuf(full, wire)
ok := _io_write(io, full.data, full.len)
compress.BufFree(full)
if not ok:
ret "write failed"
end
mut raw := compress.NewByteBuf()
defer compress.BufFree(raw)
buf := mem.Allocate(4096 as u64)
defer mem.Free(buf)
until true:
if raw.len >= 2:
want := compress.BufGet(raw, 0) * 256 + compress.BufGet(raw, 1)
if raw.len >= 2 + want:
compress.BufPushBytes(out, ((raw.data as i64) + 2) as void*, want)
ret ""
end
end
n := _io_read(io, buf, 4096)
if n <= 0:
break
end
compress.BufPushBytes(raw, buf, n)
end
ret "dot read failed"
end
func _question_end(b: void*, n: int): int:
p := b as u8*
mut i := 12
until i < n:
l := p[i] as int
if l == 0:
if i + 5 > n: ret 0 - 1 end
ret i + 5
end
if l >= 64: ret 0 - 1 end
i += l + 1
end
ret 0 - 1
end
func _lower_byte(c: int): int:
if c >= 65 and c <= 90: ret c + 32 end
ret c
end
func _same_question(q: void*, qn: int, r: void*, rn: int): bool:
qe := _question_end(q, qn)
if qe < 0: ret false end
if rn < 12: ret false end
rp := r as u8*
if ((rp[4] as int) * 256 + (rp[5] as int)) != 1: ret false end
if _question_end(r, rn) != qe: ret false end
qp := q as u8*
mut i := 12
until i < qe - 4:
l := qp[i] as int
if (rp[i] as int) != l: ret false end
mut k := 1
until k <= l:
if _lower_byte(qp[i + k] as int) != _lower_byte(rp[i + k] as int): ret false end
k++
end
i += l + 1
end
if i < 0: ret false end
repeat 4 in j:
if qp[i + j] != rp[i + j]: ret false end
end
ret true
end
func _udp_reply_ok(wire: compress.ByteBuf, buf: void*, n: int): bool:
if n < 12: ret false end
rp := buf as u8*
if ((rp[2] as int) & 128) == 0: ret false end
if (rp[0] as int) != compress.BufGet(wire, 0) or (rp[1] as int) != compress.BufGet(wire, 1): ret false end
ret _same_question(wire.data, wire.len, buf, n)
end
func _open_random_port(addr: str): udp.Socket:
v6 := rawsock.IsIPv6(addr)
mut host := "0.0.0.0"
if v6: host = "::" end
rnd := mem.Allocate(2 as u64)
defer mem.Free(rnd)
repeat 8:
crypto.RandomBytes(rnd, 2)
port := 20000 + (((rnd as u8*)[0] as int) * 256 + ((rnd as u8*)[1] as int)) % 40000
sock := udp.BindOn(host, port)
if udp.Ok(sock): ret sock end
end
ret udp.OpenFor(addr)
end
func _query_udp(srv: Server, addr: str, wire: compress.ByteBuf, timeout_ms: int, out &: compress.ByteBuf): str:
sock := _open_random_port(addr)
if not udp.Ok(sock):
ret "socket failed"
end
defer udp.Close(sock)
mut port := srv.port
if port <= 0:
port = 53
end
if udp.SendBytes(sock, addr, port, wire.data, wire.len) < 0:
ret "send failed"
end
cap := 4096
buf := mem.Allocate(cap as u64)
defer mem.Free(buf)
want := rawsock.CanonIP(addr)
deadline := time.MonoMillis() + (timeout_ms as i64)
until true:
left := deadline - time.MonoMillis()
if left <= (0 as i64): ret "timeout" end
udp.SetTimeout(sock, left as int)
mut fh := ""
mut fp := 0
n := udp.ReceiveBytes(sock, buf, cap, fh, fp)
if n <= 0: ret "timeout" end
if fh == want and fp == port and _udp_reply_ok(wire, buf, n):
compress.BufPushBytes(out, buf, n)
ret ""
end
end
end
@en "QueryAddr"
@fa "پرسش از نشانی"
pub func QueryAddr(srv: Server, addr: str, name: str, qtype: int, timeout_ms: int): Response:
mut r := Response { server = srv.name }
id := _random_id()
mut wire_id := id
if srv.kind == KindDoH or srv.kind == KindDoHGet:
wire_id = 0
end
mut wire := dns.EncodeQuery(name, qtype, wire_id)
defer compress.BufFree(wire)
start := time.MonoMillis()
mut raw := compress.NewByteBuf()
mut err := ""
if srv.kind == KindDoT:
err = _query_dot(srv, addr, wire, timeout_ms, raw)
else srv.kind == KindUDP:
err = _query_udp(srv, addr, wire, timeout_ms, raw)
else:
err = _query_doh(srv, addr, wire, timeout_ms, raw)
end
if err.len() == 0:
err = _check_response(raw, wire, wire_id, srv.kind != KindDoH and srv.kind != KindDoHGet)
end
r.rtt_ms = time.MonoMillis() - start
if err.len() > 0:
compress.BufFree(raw)
r.err = err
ret r
end
r.raw = raw
r.msg = dns.Decode(raw.data, raw.len)
r.ok = true
ret r
end
@en "Query"
@fa "پرسش"
pub func Query(srv: Server, name: str, qtype: int, timeout_ms: int): Response:
mut last := Response { server = srv.name, err = "no address" }
repeat srv.addrs.len() in i:
r := QueryAddr(srv, srv.addrs.get(i), name, qtype, timeout_ms)
if r.ok:
ret r
end
last = r
end
if srv.addrs.len() == 0 and srv.host.len() > 0:
mut ip := srv.host
if not IsIP(ip):
ip = rawsock.ResolveAny(srv.host)
end
if ip.len() > 0:
r := QueryAddr(srv, ip, name, qtype, timeout_ms)
if r.ok or IsIP(srv.host) or rawsock.IsIPv6(ip):
ret r
end
ip6 := rawsock.Resolve6(srv.host)
if ip6.len() > 0:
ret QueryAddr(srv, ip6, name, qtype, timeout_ms)
end
ret r
end
end
ret last
end
@en "FreeResponse"
@fa "آزاد کردن پاسخ"
pub func FreeResponse(r &: Response):
compress.BufFree(r.raw)
end
@en "ReusedConnections"
@fa "اتصال‌های بازاستفاده‌شده"
pub func ReusedConnections(): i64:
_l := sync.Lock(_pool_mu)
n := _pool_reused
_u := sync.Unlock(_pool_mu)
ret n
end
@en "CloseIdleConnections"
@fa "بستن اتصال‌های بی‌کار"
pub func CloseIdleConnections():
_l := sync.Lock(_pool_mu)
until _pool_items.len() > 0:
mut io := _pool_items.get(0).io
_io_close(io)
_gone := _pool_items.remove_at(0)
end
_u := sync.Unlock(_pool_mu)
end
@en "net/doh"
@fa "دی‌اوه‌اچ"
package doh
import str
import compress
import net.dns
@en "KindDoH"
@fa "نوع دی‌اوه‌اچ پست"
pub const KindDoH := 0
@en "KindDoHGet"
@fa "نوع دی‌اوه‌اچ گت"
pub const KindDoHGet := 1
@en "KindDoT"
@fa "نوع دی‌اوه‌تی"
pub const KindDoT := 2
@en "KindUDP"
@fa "نوع یو دی پی ساده"
pub const KindUDP := 3
@en "Server"
@fa "کارگزار"
pub struct Server:
@en "name"
@fa "نام"
pub name: str = ""
@en "kind"
@fa "نوع"
pub kind: int = 0
@en "url"
@fa "نشانی"
pub url: str = ""
@en "host"
@fa "میزبان"
pub host: str = ""
@en "port"
@fa "درگاه"
pub port: int = 0
@en "path"
@fa "مسیر"
pub path: str = ""
@en "use_tls"
@fa "با تی ال اس"
pub use_tls: bool = true
@en "addrs"
@fa "نشانی‌های راه‌انداز"
pub addrs: Vector<str> = Vector {}
@en "insecure"
@fa "ناامن"
pub insecure: bool = false
end
@en "Url"
@fa "نشانی وب"
pub struct Url:
@en "ok"
@fa "معتبر"
pub ok: bool = false
@en "use_tls"
@fa "با تی ال اس"
pub use_tls: bool = true
@en "host"
@fa "میزبان"
pub host: str = ""
@en "port"
@fa "درگاه"
pub port: int = 0
@en "path"
@fa "مسیر"
pub path: str = ""
end
func _ip_digits(s: str): bool:
if s.len() == 0 or s.len() > 3:
ret false
end
repeat s.len() in i:
c := (s as u8*)[i] as int
if c < 48 or c > 57:
ret false
end
end
ret true
end
func _hexval(c: int): int:
if c >= 48 and c <= 57:
ret c - 48
end
if c >= 97 and c <= 102:
ret c - 87
end
if c >= 65 and c <= 70:
ret c - 55
end
ret 0 - 1
end
func _hex_group(s: str): int:
n := s.len()
if n == 0 or n > 4:
ret 0 - 1
end
mut v := 0
repeat n in i:
h := _hexval((s as u8*)[i] as int)
if h < 0:
ret 0 - 1
end
v = v * 16 + h
end
ret v
end
func _groups(part: str, out &: Vector<int>): bool:
if part.len() == 0:
ret true
end
items := str.Split(part, ":")
defer items.free()
repeat items.len() in i:
g := _hex_group(items.get(i))
if g < 0:
ret false
end
out.push(g)
end
ret true
end
func _put_u16(b &: compress.ByteBuf, v: int):
compress.BufPush(b, (v >> 8) & 255)
compress.BufPush(b, v & 255)
end
func _put_name(b &: compress.ByteBuf, name: str):
mut n := name
if n.ends_with("."):
n = n.substr(0, n.len() - 1)
end
if n.len() > 0:
labels := str.Split(n, ".")
defer labels.free()
repeat labels.len() in i:
l := labels.get(i)
compress.BufPush(b, l.len())
compress.BufPushBytes(b, l as void*, l.len())
end
end
compress.BufPush(b, 0)
end
func _put_rdata(b &: compress.ByteBuf, rec: dns.Record):
mut rd := compress.NewByteBuf()
defer compress.BufFree(rd)
if rec.rtype == dns.TypeA:
_a := ParseIPv4(rec.data, rd)
else rec.rtype == dns.TypeAAAA:
_b := ParseIPv6(rec.data, rd)
else rec.rtype == dns.TypeCNAME or rec.rtype == dns.TypeNS or rec.rtype == dns.TypePTR:
_put_name(rd, rec.data)
else rec.rtype == dns.TypeMX:
_put_u16(rd, rec.priority)
_put_name(rd, rec.data)
else rec.rtype == dns.TypeTXT:
mut off := 0
total := rec.data.len()
if total == 0:
compress.BufPush(rd, 0)
end
until off < total:
mut take := total - off
if take > 255:
take = 255
end
compress.BufPush(rd, take)
compress.BufPushBytes(rd, (((rec.data as void*) as i64) + (off as i64)) as void*, take)
off += take
end
end
_put_u16(b, rd.len)
compress.BufPushBuf(b, rd)
end
@en "ParseIPv4"
@fa "تجزیه آی‌پی۴"
pub func ParseIPv4(text: str, out &: compress.ByteBuf): bool:
parts := str.Split(text, ".")
defer parts.free()
if parts.len() != 4:
ret false
end
mut vals: int[4]
repeat 4 in i:
s := parts.get(i)
if not _ip_digits(s):
ret false
end
v := s.to_int()
if v > 255:
ret false
end
vals[i] = v
end
repeat 4 in i:
compress.BufPush(out, vals[i])
end
ret true
end
@en "ParseIPv6"
@fa "تجزیه آی‌پی۶"
pub func ParseIPv6(text: str, out &: compress.ByteBuf): bool:
mut left := Vector {} as Vector<int>
mut right := Vector {} as Vector<int>
defer left.free()
defer right.free()
dc := text.find("::")
mut has_gap := false
if dc >= 0:
has_gap = true
rest := text.substr(dc + 2, text.len() - dc - 2)
if rest.find("::") >= 0:
ret false
end
if not _groups(text.substr(0, dc), left):
ret false
end
if not _groups(rest, right):
ret false
end
else:
if not _groups(text, left):
ret false
end
end
total := left.len() + right.len()
if has_gap and total > 7:
ret false
end
if not has_gap and total != 8:
ret false
end
repeat left.len() in i:
_put_u16(out, left.get(i))
end
repeat 8 - total:
_put_u16(out, 0)
end
repeat right.len() in i:
_put_u16(out, right.get(i))
end
ret true
end
@en "IsIP"
@fa "نشانی آی‌پی است"
pub func IsIP(host: str): bool:
mut b := compress.NewByteBuf()
defer compress.BufFree(b)
if ParseIPv4(host, b):
ret true
end
compress.BufReset(b)
ret host.find(":") >= 0 and ParseIPv6(host, b)
end
@en "ParseURL"
@fa "تجزیه نشانی وب"
pub func ParseURL(raw: str): Url:
mut u := Url {}
mut rest := raw
if raw.len() > 8 and raw.starts_with("https://"):
rest = raw.substr(8, raw.len() - 8)
u.use_tls = true
u.port = 443
else raw.len() > 7 and raw.starts_with("http://"):
rest = raw.substr(7, raw.len() - 7)
u.use_tls = false
u.port = 80
else:
ret u
end
slash := rest.find("/")
mut authority := rest
u.path = "/"
if slash >= 0:
authority = rest.substr(0, slash)
u.path = rest.substr(slash, rest.len() - slash)
end
if authority.len() == 0:
ret u
end
colon := authority.find(":")
if colon > 0 and authority.find("[") < 0:
pv := authority.substr(colon + 1, authority.len() - colon - 1)
if not _ip_digits(pv) and pv.len() > 5:
ret u
end
u.port = pv.to_int()
authority = authority.substr(0, colon)
end
u.host = authority
u.ok = true
ret u
end
@en "NewServer"
@fa "کارگزار جدید"
pub func NewServer(name: str, kind: int, url: str): Server:
mut s := Server { name = name, kind = kind, url = url }
if kind == KindDoH or kind == KindDoHGet:
u := ParseURL(url)
s.host = u.host
s.port = u.port
s.path = u.path
s.use_tls = u.use_tls
end
ret s
end
@en "NewDoT"
@fa "کارگزار دی‌اوه‌تی جدید"
pub func NewDoT(name: str, host: str, addr: str): Server:
mut s := Server { name = name, kind = KindDoT, host = host, port = 853, use_tls = true }
if addr.len() > 0:
s.addrs.push(addr)
end
ret s
end
@en "NewPlain"
@fa "کارگزار ساده جدید"
pub func NewPlain(name: str, addr: str): Server:
mut s := Server { name = name, kind = KindUDP, host = addr, port = 53, use_tls = false }
s.addrs.push(addr)
ret s
end
@en "WithBootstrap"
@fa "با نشانی راه‌انداز"
pub func WithBootstrap(s: Server, addr: str): Server:
mut c := s
c.addrs = Vector {} as Vector<str>
repeat s.addrs.len() in i:
c.addrs.push(s.addrs.get(i))
end
c.addrs.push(addr)
ret c
end
@en "WithIPv6"
@fa "با نشانی آی‌پی۶"
pub func WithIPv6(s: Server): Server:
mut c := s
c.addrs = Vector {} as Vector<str>
repeat s.addrs.len() in i:
c.addrs.push(s.addrs.get(i))
end
h := s.host
if h == "cloudflare-dns.com" or h == "one.one.one.one" or h == "1dot1dot1dot1.cloudflare-dns.com":
c.addrs.push("2606:4700:4700::1111")
c.addrs.push("2606:4700:4700::1001")
else h == "dns.google":
c.addrs.push("2001:4860:4860::8888")
c.addrs.push("2001:4860:4860::8844")
else h == "dns.quad9.net":
c.addrs.push("2620:fe::fe")
c.addrs.push("2620:fe::9")
end
ret c
end
