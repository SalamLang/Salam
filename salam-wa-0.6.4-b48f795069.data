@fa "بازه با عملگر"
pub func RangeOp(field: str, op: str, value: str): str:
ret _os_field_obj("range", field, _os_one(op, json.Str(value)))
end
@en "DateRange"
@fa "بازه تاریخ"
pub func DateRange(field: str, low: str, high: str, format: str, time_zone: str): str:
mut m := Vector {} as Vector<str>
if low.len() > 0: m.push(_os_m("gte", json.Str(low))) end
if high.len() > 0: m.push(_os_m("lte", json.Str(high))) end
if format.len() > 0: m.push(_os_m("format", json.Str(format))) end
if time_zone.len() > 0: m.push(_os_m("time_zone", json.Str(time_zone))) end
ret _os_field_obj("range", field, _os_obj(m))
end
