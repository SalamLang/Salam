@en "ai"
@fa "هوش مصنوعی"
package ai
package autograd
import ai.tensor
extern:
pure func expf(x: f32): f32
pure func tanhf(x: f32): f32
pure func powf(x: f32, y: f32): f32
end
func _bk_flat_add(pg: f32*, pd: f32*, n: int):
repeat n in k: pg[k] += pd[k] end
end
func _acc_reduced(tp &: Tape, v: int, dc &: tensor.Tensor):
if tp.needs.get(v) == false: ret end
target := Value(tp, v)
g := _grad_of(tp, v)
pg := g.data.data
pd := dc.data.data
tn := target.numel()
dn := dc.numel()
if target.same_shape(dc):
_bk_flat_add(pg, pd, dn)
ret
end
if tn == 1:
pg[0] = pg[0] + (tensor.SumAll(dc) as f32)
ret
end
tr := target.rank()
dr := dc.rank()
if tr == dr and target.shape.get(tr - 1) == 1:
width := dc.shape.get(dr - 1)
rows := dn / width
repeat rows in r:
base := r * width
mut s := 0.0 as f32
repeat width in k: s += pd[base + k] end
pg[r] += s
end
ret
end
inner := tn
outer := dn / inner
repeat outer in o:
base := o * inner
repeat inner in k: pg[k] += pd[base + k] end
end
end
func _bk_mul(tp &: Tape, n &: Node, dc &: tensor.Tensor):
mut va := Value(tp, n.a)
mut vb := Value(tp, n.b)
if tp.needs.get(n.a):
mut t := tensor.Mul(dc, vb)
_acc_reduced(tp, n.a, t)
t.free()
end
if tp.needs.get(n.b):
mut t := tensor.Mul(dc, va)
_acc_reduced(tp, n.b, t)
t.free()
end
end
func _bk_div(tp &: Tape, n &: Node, dc &: tensor.Tensor):
mut vb := Value(tp, n.b)
mut vo := Value(tp, n.out)
if tp.needs.get(n.a):
mut t := tensor.Div(dc, vb)
_acc_reduced(tp, n.a, t)
t.free()
end
if tp.needs.get(n.b):
mut t := tensor.Mul(dc, vo)
mut t2 := tensor.Div(t, vb)
tensor.ScaleInPlace(t2, 0.0 - 1.0)
_acc_reduced(tp, n.b, t2)
t.free()
t2.free()
end
end
func _bk_unary(op: int, pin: f32*, pout: f32*, pd: f32*, pg: f32*, cnt: int, f0: f64):
zero := 0.0 as f32
one := 1.0 as f32
if op == _OP_NEG:
repeat cnt in k: pg[k] -= pd[k] end
else op == _OP_SCALE:
s := f0 as f32
repeat cnt in k: pg[k] += s * pd[k] end
else op == _OP_ADDS:
repeat cnt in k: pg[k] += pd[k] end
else op == _OP_EXP:
repeat cnt in k: pg[k] += pd[k] * pout[k] end
else op == _OP_LOG:
repeat cnt in k:
v := pin[k]
if v != zero: pg[k] += pd[k] / v end
end
else op == _OP_TANH:
repeat cnt in k:
o := pout[k]
pg[k] += pd[k] * (one - o * o)
end
else op == _OP_SIGMOID:
repeat cnt in k:
o := pout[k]
pg[k] += pd[k] * o * (one - o)
end
else op == _OP_RELU:
repeat cnt in k:
mut m := zero
if pin[k] > zero: m = one end
pg[k] += pd[k] * m
end
else op == _OP_GELU:
c0 := 0.7978845608028654 as f32
c1 := 0.044715 as f32
half := 0.5 as f32
three := 3.0 as f32
repeat cnt in k:
x := pin[k]
u := c0 * (x + c1 * x * x * x)
t := tanhf(u)
du := c0 * (one + three * c1 * x * x)
d := half * (one + t) + half * x * (one - t * t) * du
pg[k] += pd[k] * d
end
else op == _OP_SQRT:
half := 0.5 as f32
repeat cnt in k:
o := pout[k]
if o != zero: pg[k] += pd[k] * half / o end
end
else op == _OP_SQUARE:
two := 2.0 as f32
repeat cnt in k: pg[k] += pd[k] * two * pin[k] end
else op == _OP_SILU:
repeat cnt in k:
x := pin[k]
s := one / (one + expf(zero - x))
pg[k] += pd[k] * s * (one + x * (one - s))
end
else:
p := f0 as f32
pm1 := (f0 - 1.0) as f32
repeat cnt in k: pg[k] = pg[k] + pd[k] * p * powf(pin[k], pm1) end
end
end
func _bk_matmul(tp &: Tape, n &: Node, dc &: tensor.Tensor):
if tp.needs.get(n.a):
mut vb := Value(tp, n.b)
mut tb := tensor.Transpose2D(vb)
mut ga := _grad_of(tp, n.a)
tensor.MatMulAcc(dc, tb, ga)
tb.free()
end
if tp.needs.get(n.b):
mut va := Value(tp, n.a)
mut ta := tensor.Transpose2D(va)
mut gb := _grad_of(tp, n.b)
tensor.MatMulAcc(ta, dc, gb)
ta.free()
end
end
func _bk_sum_axis(tp &: Tape, n &: Node, dc &: tensor.Tensor, mean: bool):
if tp.needs.get(n.a) == false: ret end
va := Value(tp, n.a)
g := _grad_of(tp, n.a)
axis := n.s0
cnt := va.shape.get(axis)
mut outer := 1
repeat axis in i: outer *= va.shape.get(i) end
inner := va.numel() / (outer * cnt)
pg := g.data.data
pd := dc.data.data
mut scale := 1.0 as f32
if mean: scale = (1.0 / (cnt as f64)) as f32 end
repeat outer in o:
dbase := o * inner
repeat cnt in i:
gbase := (o * cnt + i) * inner
repeat inner in k: pg[gbase + k] += scale * pd[dbase + k] end
end
end
end
func _bk_softmax(tp &: Tape, n &: Node, dc &: tensor.Tensor, logform: bool):
if tp.needs.get(n.a) == false: ret end
vo := Value(tp, n.out)
g := _grad_of(tp, n.a)
width := vo.shape.get(vo.rank() - 1)
rows := vo.numel() / width
pg := g.data.data
pd := dc.data.data
po := vo.data.data
repeat rows in r:
base := r * width
if logform:
mut s := 0.0 as f32
repeat width in k: s += pd[base + k] end
repeat width in k:
pg[base + k] = pg[base + k] + pd[base + k] - expf(po[base + k]) * s
end
else:
mut s := 0.0 as f32
repeat width in k: s += pd[base + k] * po[base + k] end
repeat width in k:
pg[base + k] += po[base + k] * (pd[base + k] - s)
end
end
end
end
func _bk_celoss(tp &: Tape, n &: Node, dc &: tensor.Tensor):
if tp.needs.get(n.a) == false: ret end
vl := Value(tp, n.a)
idx := Value(tp, n.aux)
g := _grad_of(tp, n.a)
width := vl.shape.get(vl.rank() - 1)
rows := vl.numel() / width
p := vl.data.data
pi := idx.data.data
pg := g.data.data
scale := (dc.at(0) / (rows as f64)) as f32
one := 1.0 as f32
repeat rows in r:
base := r * width
mut m := p[base]
repeat width in k:
v := p[base + k]
if v > m: m = v end
end
mut s := 0.0 as f32
repeat width in k: s += expf(p[base + k] - m) end
inv := one / s
t := pi[r] as int
repeat width in k:
mut sm := expf(p[base + k] - m) * inv
if k == t: sm -= one end
pg[base + k] += scale * sm
end
end
end
func _bk_bcewl(tp &: Tape, n &: Node, dc &: tensor.Tensor):
vl := Value(tp, n.a)
vt := Value(tp, n.b)
cnt := vl.numel()
scale := (dc.at(0) / (cnt as f64)) as f32
one := 1.0 as f32
zero := 0.0 as f32
p := vl.data.data
q := vt.data.data
if tp.needs.get(n.a):
g := _grad_of(tp, n.a)
pg := g.data.data
repeat cnt in k:
sg := one / (one + expf(zero - p[k]))
pg[k] += scale * (sg - q[k])
end
end
if tp.needs.get(n.b):
g := _grad_of(tp, n.b)
pg := g.data.data
repeat cnt in k:
pg[k] -= scale * p[k]
end
end
end
func _bk_transpose2d(tp &: Tape, n &: Node, dc &: tensor.Tensor):
if tp.needs.get(n.a) == false: ret end
mut t := tensor.Transpose2D(dc)
g := _grad_of(tp, n.a)
_bk_flat_add(g.data.data, t.data.data, t.numel())
t.free()
end
func _backprop_node(tp &: Tape, n &: Node):
mut dc := tp.grads.get(n.out)
if n.op == _OP_ADD:
_acc_reduced(tp, n.a, dc)
_acc_reduced(tp, n.b, dc)
else n.op == _OP_SUB:
_acc_reduced(tp, n.a, dc)
if tp.needs.get(n.b):
mut t := tensor.Neg(dc)
_acc_reduced(tp, n.b, t)
t.free()
end
else n.op == _OP_MUL:
_bk_mul(tp, n, dc)
else n.op == _OP_DIV:
_bk_div(tp, n, dc)
else n.op == _OP_MATMUL:
_bk_matmul(tp, n, dc)
else n.op == _OP_SUM:
if tp.needs.get(n.a):
mut g := _grad_of(tp, n.a)
tensor.AddScalarInPlace(g, dc.at(0))
end
else n.op == _OP_MEAN:
if tp.needs.get(n.a):
mut g := _grad_of(tp, n.a)
va := Value(tp, n.a)
tensor.AddScalarInPlace(g, dc.at(0) / (va.numel() as f64))
end
else n.op == _OP_SUMAXIS:
_bk_sum_axis(tp, n, dc, false)
else n.op == _OP_MEANAXIS:
_bk_sum_axis(tp, n, dc, true)
else n.op == _OP_SOFTMAX:
_bk_softmax(tp, n, dc, false)
else n.op == _OP_LOGSOFTMAX:
_bk_softmax(tp, n, dc, true)
else n.op == _OP_RESHAPE:
if tp.needs.get(n.a):
g := _grad_of(tp, n.a)
_bk_flat_add(g.data.data, dc.data.data, dc.numel())
end
else n.op == _OP_TRANSPOSE2D:
_bk_transpose2d(tp, n, dc)
else n.op == _OP_CELOSS:
_bk_celoss(tp, n, dc)
else n.op == _OP_BCEWL:
_bk_bcewl(tp, n, dc)
else n.op == _OP_CONV2D:
_bk_conv2d(tp, n, dc)
else n.op == _OP_MAXPOOL:
_bk_maxpool(tp, n, dc)
else n.op == _OP_AVGPOOL:
_bk_avgpool(tp, n, dc)
else n.op == _OP_BMM:
_bk_bmm(tp, n, dc)
else n.op == _OP_PERMUTE:
_bk_permute(tp, n, dc)
else n.op == _OP_EMBED:
_bk_embed(tp, n, dc)
else n.op == _OP_DROPOUT:
_bk_dropout(tp, n, dc)
else n.op == _OP_LAYERNORM:
_bk_layernorm(tp, n, dc)
else n.op == _OP_NARROW:
_bk_narrow(tp, n, dc)
else n.op == _OP_CONCAT2:
_bk_concat2(tp, n, dc)
else n.op == _OP_ROPE:
_bk_rope(tp, n, dc)
else n.op == _OP_RMSNORM:
_bk_rmsnorm(tp, n, dc)
else n.op == _OP_BATCHNORM:
_bk_batchnorm(tp, n, dc)
else n.op == _OP_GROUPNORM:
_bk_groupnorm(tp, n, dc)
else:
if tp.needs.get(n.a):
va := Value(tp, n.a)
vo := Value(tp, n.out)
g := _grad_of(tp, n.a)
_bk_unary(n.op, va.data.data, vo.data.data, dc.data.data, g.data.data, va.numel(), n.f0)
end
end
end
package autograd
import ai.tensor
inline func _off(p: f32*, off: int): f32*:
ret (p as i64 + (off as i64) * (sizeof(f32) as i64)) as f32*
end
func _bk_conv2d(tp &: Tape, n &: Node, dc &: tensor.Tensor):
mut vx := Value(tp, n.a)
vw := Value(tp, n.b)
sh := n.s0 / 256
sw := n.s0 % 256
ph := n.s1 / 256
pw := n.s1 % 256
batch := vx.shape.get(0)
c := vx.shape.get(1)
h := vx.shape.get(2)
wd := vx.shape.get(3)
oc := vw.shape.get(0)
kh := vw.shape.get(2)
kw := vw.shape.get(3)
oh := tensor.ConvOutSize(h, kh, sh, ph)
ow := tensor.ConvOutSize(wd, kw, sw, pw)
kdim := c * kh * kw
p := oh * ow
pd := dc.data.data
need_x := tp.needs.get(n.a)
need_w := tp.needs.get(n.b)
mut wt := tensor.Empty()
if need_x: wt = tensor.TransposeRaw(vw.data.data, oc, kdim) end
mut dcols := tensor.Empty()
if need_x: dcols = tensor.Zeros2(kdim, p) end
repeat batch in i:
doff := i * oc * p
if need_w:
mut cols := tensor.Im2Col(vx, i, kh, kw, sh, sw, ph, pw)
mut colst := tensor.Transpose2D(cols)
gw := _grad_of(tp, n.b)
tensor.GemmAcc(_off(pd, doff), colst.data.data, gw.data.data, oc, p, kdim)
cols.free()
colst.free()
end
if need_x:
zp := dcols.data.data
zero := 0.0 as f32
repeat kdim * p in z: zp[z] = zero end
tensor.GemmAcc(wt.data.data, _off(pd, doff), zp, kdim, oc, p)
mut gx := _grad_of(tp, n.a)
tensor.Col2ImAcc(dcols, gx, i, kh, kw, sh, sw, ph, pw)
end
end
if need_x:
wt.free()
dcols.free()
end
if n.aux >= 0 and tp.needs.get(n.aux):
gb := _grad_of(tp, n.aux)
pg := gb.data.data
repeat batch in i:
sbase := i * oc * p
repeat oc in o:
obase := sbase + o * p
mut s := 0.0 as f32
repeat p in k: s += pd[obase + k] end
pg[o] += s
end
end
end
end
func _bk_maxpool(tp &: Tape, n &: Node, dc &: tensor.Tensor):
if tp.needs.get(n.a) == false: ret end
vx := Value(tp, n.a)
am := Value(tp, n.aux)
g := _grad_of(tp, n.a)
h := vx.shape.get(2)
w := vx.shape.get(3)
planes := vx.shape.get(0) * vx.shape.get(1)
op := am.numel() / planes
pg := g.data.data
pd := dc.data.data
pa := am.data.data
repeat planes in pl:
ibase := pl * h * w
obase := pl * op
repeat op in k:
idx := pa[obase + k] as int
pg[ibase + idx] += pd[obase + k]
end
end
end
func _bk_avgpool(tp &: Tape, n &: Node, dc &: tensor.Tensor):
if tp.needs.get(n.a) == false: ret end
vx := Value(tp, n.a)
vo := Value(tp, n.out)
g := _grad_of(tp, n.a)
kh := n.s0 / 256
kw := n.s0 % 256
sh := n.s1 / 256
sw := n.s1 % 256
h := vx.shape.get(2)
w := vx.shape.get(3)
oh := vo.shape.get(2)
ow := vo.shape.get(3)
planes := vx.shape.get(0) * vx.shape.get(1)
pg := g.data.data
pd := dc.data.data
repeat planes in pl:
ibase := pl * h * w
obase := pl * oh * ow
repeat oh in oi:
repeat ow in oj:
mut cnt := 0
repeat kh in ki:
if oi * sh + ki < h:
repeat kw in kj:
if oj * sw + kj < w: cnt++ end
end
end
end
share := pd[obase + oi * ow + oj] / (cnt as f32)
repeat kh in ki:
ii := oi * sh + ki
if ii < h:
repeat kw in kj:
jj := oj * sw + kj
if jj < w:
pg[ibase + ii * w + jj] += share
end
end
end
end
end
end
end
end
@en "Conv2D"
@fa "پیچش دوبعدی"
pub func Conv2D(tp &: Tape, x: int, w: int, b: int, sh: int, sw: int, ph: int, pw: int): int:
mut vx := Value(tp, x)
mut vw := Value(tp, w)
mut vb := tensor.Empty()
if b >= 0: vb = Value(tp, b) end
out := tensor.Conv2DForward(vx, vw, vb, sh, sw, ph, pw)
mut needs_grad := tp.needs.get(x) or tp.needs.get(w)
if b >= 0 and tp.needs.get(b): needs_grad = true end
id := _push_val(tp, out, true, needs_grad)
if needs_grad:
_record(tp, _OP_CONV2D, x, w, id, b, sh * 256 + sw, ph * 256 + pw, 0.0)
end
ret id
end
@en "MaxPool2D"
@fa "بیشینه‌گیری دوبعدی"
pub func MaxPool2D(tp &: Tape, x: int, kh: int, kw: int, sh: int, sw: int): int:
mut vx := Value(tp, x)
mut am := tensor.Empty()
out := tensor.MaxPool2DForward(vx, kh, kw, sh, sw, am)
needs_grad := tp.needs.get(x)
aux := _push_val(tp, am, true, false)
id := _push_val(tp, out, true, needs_grad)
if needs_grad:
_record(tp, _OP_MAXPOOL, x, 0 - 1, id, aux, kh * 256 + kw, sh * 256 + sw, 0.0)
end
ret id
end
@en "AvgPool2D"
@fa "میانگین‌گیری دوبعدی"
pub func AvgPool2D(tp &: Tape, x: int, kh: int, kw: int, sh: int, sw: int): int:
mut vx := Value(tp, x)
out := tensor.AvgPool2DForward(vx, kh, kw, sh, sw)
needs_grad := tp.needs.get(x)
id := _push_val(tp, out, true, needs_grad)
if needs_grad:
_record(tp, _OP_AVGPOOL, x, 0 - 1, id, 0 - 1, kh * 256 + kw, sh * 256 + sw, 0.0)
end
ret id
end
package autograd
import math
import ai.tensor
func _ce_forward(logits &: tensor.Tensor, idx &: tensor.Tensor): f64:
width := logits.shape.get(logits.rank() - 1)
rows := logits.numel() / width
p := logits.data.data
pi := idx.data.data
mut total := 0.0
repeat rows in r:
base := r * width
mut m := p[base]
repeat width in k:
v := p[base + k]
if v > m: m = v end
end
mut s := 0.0
repeat width in k: s += math.Exp((p[base + k] - m) as f64) end
t := pi[r] as int
total += (math.Log(s) + (m as f64)) - (p[base + t] as f64)
end
ret total / (rows as f64)
end
@en "MSELoss"
@fa "خطای میانگین مربعات"
pub func MSELoss(tp &: Tape, pred: int, target: int): int:
ret Mean(tp, Square(tp, Sub(tp, pred, target)))
end
@en "CrossEntropyLogits"
@fa "آنتروپی متقاطع لوجیت"
pub func CrossEntropyLogits(tp &: Tape, logits: int, targets &: Vector<int>): int:
mut vl := Value(tp, logits)
if vl.is_empty() or vl.rank() < 2: ret _push_val(tp, tensor.Empty(), true, false) end
width := vl.shape.get(vl.rank() - 1)
rows := vl.numel() / width
if targets.len() != rows: ret _push_val(tp, tensor.Empty(), true, false) end
ti := tensor.Zeros1(rows)
pt := ti.data.data
repeat rows in r: pt[r] = targets.get(r) as f32 end
aux := _push_val(tp, ti, true, false)
mut tv := Value(tp, aux)
out := tensor.Scalar(_ce_forward(vl, tv))
needs_grad := tp.needs.get(logits)
id := _push_val(tp, out, true, needs_grad)
if needs_grad: _record(tp, _OP_CELOSS, logits, 0 - 1, id, aux, 0, 0, 0.0) end
ret id
end
@en "BCEWithLogits"
@fa "آنتروپی دودویی لوجیت"
pub func BCEWithLogits(tp &: Tape, logits: int, target: int): int:
vl := Value(tp, logits)
mut vt := Value(tp, target)
if vl.is_empty() or vl.same_shape(vt) == false:
ret _push_val(tp, tensor.Empty(), true, false)
end
n := vl.numel()
p := vl.data.data
q := vt.data.data
mut total := 0.0
repeat n in k:
x := p[k] as f64
y := q[k] as f64
mut mx := x
if mx < 0.0: mx = 0.0 end
mut ax := x
if ax < 0.0: ax = 0.0 - ax end
total += mx - x * y + math.Log(1.0 + math.Exp(0.0 - ax))
end
out := tensor.Scalar(total / (n as f64))
needs_grad := tp.needs.get(logits) or tp.needs.get(target)
id := _push_val(tp, out, true, needs_grad)
if needs_grad: _record(tp, _OP_BCEWL, logits, target, id, 0 - 1, 0, 0, 0.0) end
ret id
end
package autograd
import ai.tensor
extern:
pure func sqrtf(x: f32): f32
end
func _bk_layernorm(tp &: Tape, n &: Node, dc &: tensor.Tensor):
vx := Value(tp, n.a)
vg := Value(tp, n.b)
st := Value(tp, n.aux)
beta := n.s0
d := vx.shape.get(vx.rank() - 1)
rows := vx.numel() / d
px := vx.data.data
pgam := vg.data.data
ps := st.data.data
pd := dc.data.data
need_x := tp.needs.get(n.a)
need_g := tp.needs.get(n.b)
need_b := tp.needs.get(beta)
mut gx := tensor.Empty()
mut gg := tensor.Empty()
mut gb := tensor.Empty()
if need_x: gx = _grad_of(tp, n.a) end
if need_g: gg = _grad_of(tp, n.b) end
if need_b: gb = _grad_of(tp, beta) end
pgx := gx.data.data
pgg := gg.data.data
pgb := gb.data.data
inv_d := (1.0 / (d as f64)) as f32
repeat rows in r:
base := r * d
mean := ps[r * 2]
rstd := ps[r * 2 + 1]
mut s1 := 0.0 as f32
mut s2 := 0.0 as f32
repeat d in k:
xhat := (px[base + k] - mean) * rstd
dxhat := pd[base + k] * pgam[k]
s1 += dxhat
s2 += dxhat * xhat
if need_g: pgg[k] += pd[base + k] * xhat end
if need_b: pgb[k] += pd[base + k] end
end
if need_x:
m1 := s1 * inv_d
m2 := s2 * inv_d
repeat d in k:
xhat := (px[base + k] - mean) * rstd
dxhat := pd[base + k] * pgam[k]
pgx[base + k] += rstd * (dxhat - m1 - xhat * m2)
end
end
end
end
func _bk_rmsnorm(tp &: Tape, n &: Node, dc &: tensor.Tensor):
vx := Value(tp, n.a)
vg := Value(tp, n.b)
st := Value(tp, n.aux)
d := vx.shape.get(vx.rank() - 1)
rows := vx.numel() / d
px := vx.data.data
pgam := vg.data.data
ps := st.data.data
pd := dc.data.data
need_x := tp.needs.get(n.a)
need_g := tp.needs.get(n.b)
mut gx := tensor.Empty()
mut gg := tensor.Empty()
if need_x: gx = _grad_of(tp, n.a) end
if need_g: gg = _grad_of(tp, n.b) end
pgx := gx.data.data
pgg := gg.data.data
inv_d := (1.0 / (d as f64)) as f32
repeat rows in r:
base := r * d
rs := ps[r]
mut s2 := 0.0 as f32
repeat d in k:
xhat := px[base + k] * rs
dxhat := pd[base + k] * pgam[k]
s2 += dxhat * xhat
if need_g: pgg[k] += pd[base + k] * xhat end
end
if need_x:
m2 := s2 * inv_d
repeat d in k:
xhat := px[base + k] * rs
dxhat := pd[base + k] * pgam[k]
pgx[base + k] += rs * (dxhat - xhat * m2)
end
end
end
end
func _bk_batchnorm(tp &: Tape, n &: Node, dc &: tensor.Tensor):
vx := Value(tp, n.a)
vg := Value(tp, n.b)
st := Value(tp, n.aux)
beta := n.s0
inference := n.s1 == 1
nb := vx.shape.get(0)
c := vx.shape.get(1)
inner := vx.numel() / (nb * c)
cnt := nb * inner
px := vx.data.data
pgam := vg.data.data
ps := st.data.data
pd := dc.data.data
need_x := tp.needs.get(n.a)
need_g := tp.needs.get(n.b)
need_b := tp.needs.get(beta)
mut gx := tensor.Empty()
mut gg := tensor.Empty()
mut gb := tensor.Empty()
if need_x: gx = _grad_of(tp, n.a) end
if need_g: gg = _grad_of(tp, n.b) end
if need_b: gb = _grad_of(tp, beta) end
pgx := gx.data.data
pgg := gg.data.data
pgb := gb.data.data
inv_cnt := (1.0 / (cnt as f64)) as f32
repeat c in ch:
mean := ps[ch * 2]
rstd := ps[ch * 2 + 1]
gamma := pgam[ch]
mut s1 := 0.0 as f32
mut s2 := 0.0 as f32
repeat nb in i:
base := (i * c + ch) * inner
repeat inner in k:
xhat := (px[base + k] - mean) * rstd
dy := pd[base + k]
s1 += dy
s2 += dy * xhat
end
end
if need_g: pgg[ch] += s2 end
if need_b: pgb[ch] += s1 end
if need_x:
m1 := s1 * gamma * inv_cnt
m2 := s2 * gamma * inv_cnt
repeat nb in i:
base := (i * c + ch) * inner
repeat inner in k:
dxhat := pd[base + k] * gamma
if inference:
pgx[base + k] += rstd * dxhat
else:
xhat := (px[base + k] - mean) * rstd
pgx[base + k] += rstd * (dxhat - m1 - xhat * m2)
end
end
end
end
end
end
func _bk_groupnorm(tp &: Tape, n &: Node, dc &: tensor.Tensor):
vx := Value(tp, n.a)
vg := Value(tp, n.b)
st := Value(tp, n.aux)
beta := n.s0
groups := n.s1
nb := vx.shape.get(0)
c := vx.shape.get(1)
inner := vx.numel() / (nb * c)
cpg := c / groups
m := cpg * inner
px := vx.data.data
pgam := vg.data.data
ps := st.data.data
pd := dc.data.data
need_x := tp.needs.get(n.a)
need_g := tp.needs.get(n.b)
need_b := tp.needs.get(beta)
mut gx := tensor.Empty()
mut gg := tensor.Empty()
mut gb := tensor.Empty()
if need_x: gx = _grad_of(tp, n.a) end
if need_g: gg = _grad_of(tp, n.b) end
if need_b: gb = _grad_of(tp, beta) end
pgx := gx.data.data
pgg := gg.data.data
pgb := gb.data.data
inv_m := (1.0 / (m as f64)) as f32
repeat nb in bi:
repeat groups in g:
mean := ps[(bi * groups + g) * 2]
rstd := ps[(bi * groups + g) * 2 + 1]
mut s1 := 0.0 as f32
mut s2 := 0.0 as f32
repeat cpg in cc:
ch := g * cpg + cc
base := (bi * c + ch) * inner
repeat inner in s:
xhat := (px[base + s] - mean) * rstd
dxhat := pd[base + s] * pgam[ch]
s1 += dxhat
s2 += dxhat * xhat
if need_g: pgg[ch] += pd[base + s] * xhat end
if need_b: pgb[ch] += pd[base + s] end
end
end
if need_x:
m1 := s1 * inv_m
m2 := s2 * inv_m
repeat cpg in cc:
ch := g * cpg + cc
base := (bi * c + ch) * inner
repeat inner in s:
xhat := (px[base + s] - mean) * rstd
dxhat := pd[base + s] * pgam[ch]
pgx[base + s] += rstd * (dxhat - m1 - xhat * m2)
end
end
end
end
end
end
@en "LayerNorm"
@fa "نرمال‌سازی لایه"
pub func LayerNorm(tp &: Tape, x: int, gamma: int, beta: int, eps: f64): int:
vx := Value(tp, x)
vg := Value(tp, gamma)
vb := Value(tp, beta)
if vx.is_empty(): ret _push_val(tp, tensor.Empty(), true, false) end
d := vx.shape.get(vx.rank() - 1)
if vg.numel() != d or vb.numel() != d: ret _push_val(tp, tensor.Empty(), true, false) end
rows := vx.numel() / d
out := tensor.Zeros(vx.shape)
st := tensor.Zeros2(rows, 2)
px := vx.data.data
pg := vg.data.data
pb := vb.data.data
po := out.data.data
ps := st.data.data
ef := eps as f32
inv_d := (1.0 / (d as f64)) as f32
one := 1.0 as f32
repeat rows in r:
base := r * d
mut s := 0.0 as f32
repeat d in k: s += px[base + k] end
mean := s * inv_d
mut v := 0.0 as f32
repeat d in k:
dlt := px[base + k] - mean
v += dlt * dlt
end
rstd := one / sqrtf(v * inv_d + ef)
ps[r * 2] = mean
ps[r * 2 + 1] = rstd
repeat d in k:
po[base + k] = pg[k] * ((px[base + k] - mean) * rstd) + pb[k]
end
end
needs_grad := tp.needs.get(x) or tp.needs.get(gamma) or tp.needs.get(beta)
aux := _push_val(tp, st, true, false)
id := _push_val(tp, out, true, needs_grad)
if needs_grad: _record(tp, _OP_LAYERNORM, x, gamma, id, aux, beta, 0, eps) end
ret id
end
@en "RMSNorm"
@fa "نرمال‌سازی جذر میانگین مربعات"
pub func RMSNorm(tp &: Tape, x: int, gamma: int, eps: f64): int:
vx := Value(tp, x)
vg := Value(tp, gamma)
if vx.is_empty(): ret _push_val(tp, tensor.Empty(), true, false) end
d := vx.shape.get(vx.rank() - 1)
if vg.numel() != d: ret _push_val(tp, tensor.Empty(), true, false) end
rows := vx.numel() / d
out := tensor.Zeros(vx.shape)
st := tensor.Zeros1(rows)
px := vx.data.data
pg := vg.data.data
po := out.data.data
ps := st.data.data
ef := eps as f32
inv_d := (1.0 / (d as f64)) as f32
one := 1.0 as f32
repeat rows in r:
base := r * d
mut s := 0.0 as f32
repeat d in k: s += px[base + k] * px[base + k] end
rs := one / sqrtf(s * inv_d + ef)
ps[r] = rs
repeat d in k: po[base + k] = pg[k] * px[base + k] * rs end
end
needs_grad := tp.needs.get(x) or tp.needs.get(gamma)
aux := _push_val(tp, st, true, false)
id := _push_val(tp, out, true, needs_grad)
if needs_grad: _record(tp, _OP_RMSNORM, x, gamma, id, aux, 0, 0, eps) end
ret id
end
@en "BatchNorm"
@fa "نرمال‌سازی دسته"
pub func BatchNorm(tp &: Tape, x: int, gamma: int, beta: int, running_mean &: tensor.Tensor, running_var &: tensor.Tensor, momentum: f64, eps: f64): int:
vx := Value(tp, x)
vg := Value(tp, gamma)
vb := Value(tp, beta)
if vx.rank() != 2 and vx.rank() != 4: ret _push_val(tp, tensor.Empty(), true, false) end
nb := vx.shape.get(0)
c := vx.shape.get(1)
if vg.numel() != c or vb.numel() != c or running_mean.numel() != c or running_var.numel() != c:
ret _push_val(tp, tensor.Empty(), true, false)
end
inner := vx.numel() / (nb * c)
cnt := nb * inner
out := tensor.Zeros(vx.shape)
st := tensor.Zeros2(c, 2)
px := vx.data.data
pg := vg.data.data
pb := vb.data.data
po := out.data.data
ps := st.data.data
prm := running_mean.data.data
prv := running_var.data.data
ef := eps as f32
one := 1.0 as f32
mom := momentum as f32
inv_cnt := (1.0 / (cnt as f64)) as f32
repeat c in ch:
mut mean := 0.0 as f32
mut var := 0.0 as f32
if tp.training:
mut s := 0.0 as f32
repeat nb in i:
base := (i * c + ch) * inner
repeat inner in k: s += px[base + k] end
end
mean = s * inv_cnt
mut v := 0.0 as f32
repeat nb in i:
base := (i * c + ch) * inner
repeat inner in k:
dlt := px[base + k] - mean
v += dlt * dlt
end
end
var = v * inv_cnt
mut unbiased := var
if cnt > 1: unbiased = v / ((cnt - 1) as f32) end
prm[ch] = (one - mom) * prm[ch] + mom * mean
prv[ch] = (one - mom) * prv[ch] + mom * unbiased
else:
mean = prm[ch]
var = prv[ch]
end
rstd := one / sqrtf(var + ef)
ps[ch * 2] = mean
ps[ch * 2 + 1] = rstd
repeat nb in i:
base := (i * c + ch) * inner
repeat inner in k: po[base + k] = pg[ch] * ((px[base + k] - mean) * rstd) + pb[ch] end
end
end
needs_grad := tp.needs.get(x) or tp.needs.get(gamma) or tp.needs.get(beta)
aux := _push_val(tp, st, true, false)
id := _push_val(tp, out, true, needs_grad)
mut mode := 0
if tp.training == false: mode = 1 end
if needs_grad: _record(tp, _OP_BATCHNORM, x, gamma, id, aux, beta, mode, eps) end
ret id
end
@en "GroupNorm"
@fa "نرمال‌سازی گروهی"
pub func GroupNorm(tp &: Tape, x: int, gamma: int, beta: int, groups: int, eps: f64): int:
vx := Value(tp, x)
vg := Value(tp, gamma)
vb := Value(tp, beta)
if vx.rank() < 2 or groups < 1: ret _push_val(tp, tensor.Empty(), true, false) end
nb := vx.shape.get(0)
c := vx.shape.get(1)
if c % groups != 0 or vg.numel() != c or vb.numel() != c:
ret _push_val(tp, tensor.Empty(), true, false)
end
inner := vx.numel() / (nb * c)
cpg := c / groups
m := cpg * inner
out := tensor.Zeros(vx.shape)
st := tensor.Zeros2(nb * groups, 2)
px := vx.data.data
pg := vg.data.data
pb := vb.data.data
po := out.data.data
ps := st.data.data
ef := eps as f32
inv_m := (1.0 / (m as f64)) as f32
one := 1.0 as f32
repeat nb in bi:
repeat groups in g:
mut sum := 0.0 as f32
repeat cpg in cc:
base := (bi * c + g * cpg + cc) * inner
repeat inner in s: sum += px[base + s] end
end
mean := sum * inv_m
mut var := 0.0 as f32
repeat cpg in cc:
base := (bi * c + g * cpg + cc) * inner
repeat inner in s:
dlt := px[base + s] - mean
var += dlt * dlt
end
end
rstd := one / sqrtf(var * inv_m + ef)
ps[(bi * groups + g) * 2] = mean
ps[(bi * groups + g) * 2 + 1] = rstd
repeat cpg in cc:
ch := g * cpg + cc
base := (bi * c + ch) * inner
repeat inner in s:
po[base + s] = pg[ch] * ((px[base + s] - mean) * rstd) + pb[ch]
end
end
end
end
needs_grad := tp.needs.get(x) or tp.needs.get(gamma) or tp.needs.get(beta)
aux := _push_val(tp, st, true, false)
id := _push_val(tp, out, true, needs_grad)
if needs_grad: _record(tp, _OP_GROUPNORM, x, gamma, id, aux, beta, groups, eps) end
ret id
end
package autograd
import ai.tensor
func _bin_op(tp &: Tape, op: int, a: int, b: int): int:
mut va := Value(tp, a)
mut vb := Value(tp, b)
mut out := tensor.Empty()
if op == _OP_ADD:
out = tensor.Add(va, vb)
else op == _OP_SUB:
out = tensor.Sub(va, vb)
else op == _OP_MUL:
out = tensor.Mul(va, vb)
else:
out = tensor.Div(va, vb)
end
needs_grad := tp.needs.get(a) or tp.needs.get(b)
id := _push_val(tp, out, true, needs_grad)
if needs_grad: _record(tp, op, a, b, id, 0 - 1, 0, 0, 0.0) end
ret id
end
func _un_op(tp &: Tape, op: int, a: int, f0: f64): int:
mut va := Value(tp, a)
mut out := tensor.Empty()
if op == _OP_NEG:
out = tensor.Neg(va)
else op == _OP_SCALE:
out = tensor.Scale(va, f0)
else op == _OP_ADDS:
out = tensor.AddScalar(va, f0)
else op == _OP_EXP:
out = tensor.Exp(va)
else op == _OP_LOG:
out = tensor.Log(va)
else op == _OP_TANH:
out = tensor.Tanh(va)
else op == _OP_SIGMOID:
out = tensor.Sigmoid(va)
else op == _OP_RELU:
out = tensor.Relu(va)
else op == _OP_GELU:
out = tensor.Gelu(va)
else op == _OP_SQRT:
out = tensor.Sqrt(va)
else op == _OP_SQUARE:
out = tensor.Square(va)
else op == _OP_SILU:
out = tensor.Silu(va)
else:
out = tensor.PowScalar(va, f0)
end
needs_grad := tp.needs.get(a)
id := _push_val(tp, out, true, needs_grad)
if needs_grad: _record(tp, op, a, 0 - 1, id, 0 - 1, 0, 0, f0) end
ret id
end
@en "Add"
@fa "جمع"
pub func Add(tp &: Tape, a: int, b: int): int: ret _bin_op(tp, _OP_ADD, a, b) end
@en "Sub"
@fa "تفریق"
pub func Sub(tp &: Tape, a: int, b: int): int: ret _bin_op(tp, _OP_SUB, a, b) end
@en "Mul"
@fa "ضرب درایه‌ای"
pub func Mul(tp &: Tape, a: int, b: int): int: ret _bin_op(tp, _OP_MUL, a, b) end
@en "Div"
@fa "تقسیم درایه‌ای"
pub func Div(tp &: Tape, a: int, b: int): int: ret _bin_op(tp, _OP_DIV, a, b) end
@en "Neg"
@fa "قرینه"
pub func Neg(tp &: Tape, a: int): int: ret _un_op(tp, _OP_NEG, a, 0.0) end
@en "Scale"
@fa "مقیاس"
pub func Scale(tp &: Tape, a: int, s: f64): int: ret _un_op(tp, _OP_SCALE, a, s) end
@en "AddScalar"
@fa "جمع با عدد"
pub func AddScalar(tp &: Tape, a: int, s: f64): int: ret _un_op(tp, _OP_ADDS, a, s) end
@en "Exp"
@fa "نمایی"
pub func Exp(tp &: Tape, a: int): int: ret _un_op(tp, _OP_EXP, a, 0.0) end
@en "Log"
@fa "لگاریتم"
pub func Log(tp &: Tape, a: int): int: ret _un_op(tp, _OP_LOG, a, 0.0) end
@en "Tanh"
@fa "تانژانت هذلولی"
pub func Tanh(tp &: Tape, a: int): int: ret _un_op(tp, _OP_TANH, a, 0.0) end
@en "Sigmoid"
@fa "سیگموئید"
pub func Sigmoid(tp &: Tape, a: int): int: ret _un_op(tp, _OP_SIGMOID, a, 0.0) end
@en "Relu"
@fa "یکسوساز"
pub func Relu(tp &: Tape, a: int): int: ret _un_op(tp, _OP_RELU, a, 0.0) end
@en "Gelu"
@fa "گلو"
pub func Gelu(tp &: Tape, a: int): int: ret _un_op(tp, _OP_GELU, a, 0.0) end
@en "Sqrt"
@fa "ریشه دوم"
pub func Sqrt(tp &: Tape, a: int): int: ret _un_op(tp, _OP_SQRT, a, 0.0) end
@en "Square"
@fa "مربع"
pub func Square(tp &: Tape, a: int): int: ret _un_op(tp, _OP_SQUARE, a, 0.0) end
@en "PowScalar"
@fa "توان عددی"
pub func PowScalar(tp &: Tape, a: int, p: f64): int: ret _un_op(tp, _OP_POWS, a, p) end
@en "Silu"
@fa "سیلو"
pub func Silu(tp &: Tape, a: int): int: ret _un_op(tp, _OP_SILU, a, 0.0) end
@en "MatMul"
@fa "ضرب ماتریسی"
pub func MatMul(tp &: Tape, a: int, b: int): int:
mut va := Value(tp, a)
mut vb := Value(tp, b)
out := tensor.MatMul(va, vb)
needs_grad := tp.needs.get(a) or tp.needs.get(b)
id := _push_val(tp, out, true, needs_grad)
if needs_grad: _record(tp, _OP_MATMUL, a, b, id, 0 - 1, 0, 0, 0.0) end
ret id
end
