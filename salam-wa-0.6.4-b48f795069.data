@en "gui/webview/pack"
@fa "دارایی فشرده"
package pack
import mem
import str
import os
import filepath
import compress
extern:
func fread(ptr: void*, size: u64, count: u64, stream: void*): u64
func fwrite(ptr: void*, size: u64, count: u64, stream: void*): u64
end
const _PACK_MAGIC := "SLMPACK1"
const _FOOTER_SIZE := 16
const _METHOD_RAW := 0
const _METHOD_DEFLATE := 1
struct _PackEntry:
pub path: str = ""
pub offset: i64 = 0
pub stored: i64 = 0
pub plain: i64 = 0
pub method: int = 0
end
@en "Blob"
@fa "داده"
pub struct Blob:
@en "data"
@fa "داده"
pub data: void* = null
@en "size"
@fa "اندازه"
pub size: i64 = 0
end
@en "Pack"
@fa "فشرده"
pub struct Pack:
@en "path"
@fa "مسیر"
pub path: str = ""
@en "key"
@fa "کلید"
pub key: str = ""
start: i64 = 0
entries: Vector<_PackEntry> = Vector {}
@en "Count"
@fa "شمار"
pub func Count(): int:
ret this.entries.len()
end
@en "Read"
@fa "خواندن"
pub func Read(name: str): Blob:
each e in this.entries:
if e.path == name:
raw := ReadRange(this.path, this.start + e.offset, e.stored)
if raw == null:
ret Blob {}
end
_scramble(raw, e.stored, _fnv(this.key) ^ _fnv(name))
if e.method == _METHOD_DEFLATE:
out := compress.Decompress(compress.MethodDeflate, raw, e.stored as int)
mem.Free(raw)
ret Blob { data = out.data, size = out.len as i64 }
end
ret Blob { data = raw, size = e.stored }
end
end
ret Blob {}
end
end
func _fnv(text: str): u64:
mut h := 0xCBF29CE484222325 as u64
bytes := text as u8*
n := str.Len(text)
repeat n in i:
h ^= (bytes[i] as u64)
h *= (0x100000001B3 as u64)
end
ret h
end
func _scramble(data: void*, n: i64, seed: u64):
mut x := seed
if x == (0 as u64):
x = 0x9E3779B97F4A7C15 as u64
end
bytes := data as u8*
mut i := 0 as i64
until i < n:
x ^= (x << 13)
x ^= (x >> 7)
x ^= (x << 17)
bytes[i] ^= ((x & (0xFF as u64)) as u8)
i++
end
end
func _put_u32(buf &: compress.ByteBuf, v: i64):
compress.BufPush(buf, (v & 0xFF) as int)
compress.BufPush(buf, ((v >> 8) & 0xFF) as int)
compress.BufPush(buf, ((v >> 16) & 0xFF) as int)
compress.BufPush(buf, ((v >> 24) & 0xFF) as int)
end
func _put_u64(buf &: compress.ByteBuf, v: i64):
_put_u32(buf, v & 0xFFFFFFFF)
_put_u32(buf, (v >> 32) & 0xFFFFFFFF)
end
func _get_u32(bytes: u8*, at: i64): i64:
mut v := 0 as i64
repeat 4 in i:
v |= ((bytes[at + (i as i64)] as i64) << (i * 8))
end
ret v
end
func _get_u64(bytes: u8*, at: i64): i64:
ret _get_u32(bytes, at) | (_get_u32(bytes, at + 4) << 32)
end
func _worth_compressing(path: str): bool:
ext := filepath.Ext(path)
defer mem.Free(ext as void*)
each skip in ["png", "jpg", "jpeg", "gif", "webp", "woff", "woff2", "mp3", "mp4", "webm", "zip", "gz", "ico"]:
if str.EqualFold(ext, skip) or str.EqualFold(ext, ".".concat(skip)):
ret false
end
end
ret true
end
func _walk_assets(root: str, rel: str, out &: Vector<str>):
full := rel.len() == 0 ? root : filepath.Join(root, rel)
names := os.ListDir(full)
defer names.free()
each name in names:
if name == "." or name == ".." or name == ".DS_Store":
continue
end
child := rel.len() == 0 ? str.Clone(name) : rel.concat("/").concat(name)
if os.IsDir(filepath.Join(root, child)):
_walk_assets(root, child, out)
else:
out.push(child)
end
end
end
@en "ReadRange"
@fa "خواندن بازه"
pub func ReadRange(path: str, offset: i64, n: i64): void*:
f := os.Open(path, "rb")
if f == null:
ret null
end
defer f.close()
if offset > 0:
_moved := f.seek(offset, 0)
end
buf := mem.Allocate((n + 1) as u64)
got := fread(buf, 1 as u64, n as u64, f as void*)
if got != (n as u64):
mem.Free(buf)
ret null
end
(buf as u8*)[n] = 0 as u8
ret buf
end
@en "Open"
@fa "باز کردن"
pub func Open(path: str, key: str, out &: Pack): bool:
size := os.FileSize(path)
if size < (_FOOTER_SIZE as i64) + 4:
ret false
end
foot := ReadRange(path, size - (_FOOTER_SIZE as i64), _FOOTER_SIZE as i64)
if foot == null:
ret false
end
defer mem.Free(foot)
foot_bytes := foot as u8*
magic := _PACK_MAGIC as u8*
repeat 8 in i:
if foot_bytes[8 + i] != magic[i]:
ret false
end
end
total := _get_u64(foot_bytes, 0 as i64)
start := size - (_FOOTER_SIZE as i64) - total
if total < 4 or start < 0:
ret false
end
head := ReadRange(path, start, 4 as i64)
if head == null:
ret false
end
table_size := _get_u32(head as u8*, 0 as i64)
mem.Free(head)
if table_size < 4 or table_size + 4 > total:
ret false
end
table := ReadRange(path, start + 4, table_size)
if table == null:
ret false
end
defer mem.Free(table)
seed := _fnv(key)
_scramble(table, table_size, seed)
bytes := table as u8*
count := _get_u32(bytes, 0 as i64)
mut at := 4 as i64
mut entries := Vector {} as Vector<_PackEntry>
mut n := 0 as i64
until n < count:
if at + 4 > table_size:
entries.free()
ret false
end
name_size := _get_u32(bytes, at)
at += 4
if name_size <= 0 or at + name_size + 28 > table_size:
entries.free()
ret false
end
name := mem.Allocate((name_size + 1) as u64)
mem.Copy(name, ((bytes as i64) + at) as void*, name_size as u64)
(name as u8*)[name_size] = 0 as u8
at += name_size
entries.push(
_PackEntry {
path = name as str, offset = _get_u64(bytes, at), stored = _get_u64(bytes, at + 8), plain = _get_u64(bytes, at + 16),
method = _get_u32(bytes, at + 24) as int
}
)
at += 28
n++
end
out = Pack { path = str.Clone(path), key = str.Clone(key), start = start + 4 + table_size, entries = entries }
ret true
end
@en "PackDir"
@fa "فشرده کردن پوشه"
pub func PackDir(dir: str, out_path: str, key: str): int:
if not os.IsDir(dir):
ret -1
end
mut names := Vector {} as Vector<str>
defer names.free()
_walk_assets(dir, "", names)
mut body := compress.NewByteBuf()
mut table := compress.NewByteBuf()
defer compress.BufFree(body)
defer compress.BufFree(table)
_put_u32(table, names.len() as i64)
seed := _fnv(key)
each name in names:
full := filepath.Join(dir, name)
plain := os.FileSize(full)
raw := ReadRange(full, 0 as i64, plain)
if raw == null:
ret -1
end
mut method := _METHOD_RAW
mut stored := raw
mut stored_size := plain
mut packed := compress.NewByteBuf()
if plain > 256 and _worth_compressing(name):
packed = compress.Compress(compress.MethodDeflate, raw, plain as int)
if (packed.len as i64) < plain:
method = _METHOD_DEFLATE
stored = packed.data
stored_size = packed.len as i64
end
end
offset := compress.BufLen(body) as i64
copy := mem.Allocate((stored_size + 1) as u64)
mem.Copy(copy, stored, stored_size as u64)
_scramble(copy, stored_size, seed ^ _fnv(name))
compress.BufPushBytes(body, copy, stored_size as int)
mem.Free(copy)
mem.Free(raw)
compress.BufFree(packed)
name_size := str.Len(name) as i64
_put_u32(table, name_size)
compress.BufPushBytes(table, name as void*, name_size as int)
_put_u64(table, offset)
_put_u64(table, stored_size)
_put_u64(table, plain)
_put_u32(table, method as i64)
end
table_size := compress.BufLen(table) as i64
_scramble(table.data, table_size, seed)
mut head := compress.NewByteBuf()
defer compress.BufFree(head)
_put_u32(head, table_size)
total := 4 + table_size + (compress.BufLen(body) as i64)
mut foot := compress.NewByteBuf()
defer compress.BufFree(foot)
_put_u64(foot, total)
f := os.Open(out_path, "wb")
if f == null:
ret -1
end
defer f.close()
fp := f as void*
fwrite(head.data, 1 as u64, 4 as u64, fp)
fwrite(table.data, 1 as u64, table_size as u64, fp)
fwrite(body.data, 1 as u64, compress.BufLen(body) as u64, fp)
fwrite(foot.data, 1 as u64, 8 as u64, fp)
fwrite(_PACK_MAGIC as void*, 1 as u64, 8 as u64, fp)
ret names.len()
end
@en "AppendPack"
@fa "افزودن فشرده"
pub func AppendPack(exe_path: str, pack_path: str): bool:
size := os.FileSize(pack_path)
data := ReadRange(pack_path, 0 as i64, size)
if data == null:
ret false
end
defer mem.Free(data)
f := os.Open(exe_path, "ab")
if f == null:
ret false
end
defer f.close()
ret fwrite(data, 1 as u64, size as u64, f as void*) == (size as u64)
end
package webview
mut _menu_ids := Vector {} as Vector<str>
mut _on_menu := (_id: str): ret end
mut _on_tray_click := (): ret end
mut _on_second := (_args: Vector<str>): ret end
mut _on_notify_click := (): ret end
@en "MenuItem"
@fa "مورد‌منو"
pub struct MenuItem:
@en "id"
@fa "شناسه"
pub id: str = ""
@en "label"
@fa "برچسب"
pub label: str = ""
@en "separator"
@fa "جداکننده"
pub separator: bool = false
@en "children"
@fa "زیرمنو"
pub children: Vector<MenuItem> = Vector {}
end
func _menu_id(id: str): int:
_menu_ids.push(str.Clone(id))
ret _menu_ids.len() + 999
end
func _fire_menu(native: int):
at := native - 1000
if at >= 0 and at < _menu_ids.len():
_on_menu(_menu_ids[at])
end
end
func _parent_native(): void*:
mut last := null as void*
each w in _wins:
if not w.view.IsClosed():
if w.view.IsActive():
ret w.view.Native()
end
last = w.view.Native()
end
end
ret last
end
func _secret_file(key: str): str:
dir := DataDir()
defer mem.Free(dir as void*)
folder := filepath.Join(dir, "secrets")
_mk := os.MkdirAll(folder)
_private := fs.Chmod(folder, 0o700)
name := crypto.Sha256Hex(key)
defer mem.Free(name as void*)
out := filepath.Join(folder, name)
mem.Free(folder as void*)
ret out
end
func _secret_id(): str:
ret _cfg.id.len() > 0 ? _cfg.id : "ir.salamlang.app"
end
func _split_args(data: void*, size: int): Vector<str>:
mut out := Vector {} as Vector<str>
bytes := data as u8*
mut start := 0
repeat size in i:
if bytes[i] == (0 as u8):
piece := mem.Allocate((i - start + 1) as u64)
mem.Copy(piece, ((data as i64) + (start as i64)) as void*, (i - start) as u64)
(piece as u8*)[i - start] = 0 as u8
out.push(piece as str)
start = i + 1
end
end
ret out
end
func _join_args(size_out &: int): void*:
args := os.Args()
mut total := 0
each a in args:
total += str.Len(a) + 1
end
buf := mem.AllocateZeroed((total + 1) as u64)
mut at := 0
each a in args:
n := str.Len(a)
mem.Copy(((buf as i64) + (at as i64)) as void*, a as void*, n as u64)
at += n + 1
end
size_out = total
ret buf
end
@en "OpenURL"
@fa "باز کردن نشانی"
pub func OpenURL(url: str): bool:
if str.StartsWith(url, "http://") or str.StartsWith(url, "https://") or str.StartsWith(url, "mailto:") or str.StartsWith(url, "tel:"):
ret _open_external(url)
end
ret false
end
@en "PickFolder"
@fa "انتخاب پوشه"
pub func PickFolder(title: str = "Select a folder"): str:
ret _os_pick(title, 1, "", "", "")
end
@en "PickFile"
@fa "انتخاب پرونده"
pub func PickFile(title: str = "Open", filter_name: str = "", patterns: str = ""): str:
ret _os_pick(title, 0, "", filter_name, patterns)
end
@en "SaveFile"
@fa "ذخیره پرونده"
pub func SaveFile(title: str = "Save", default_name: str = ""): str:
ret _os_pick(title, 2, default_name, "", "")
end
@en "Message"
@fa "پیام"
pub func Message(title: str, text: str):
_ignored := _os_message(title, text, false)
end
@en "Confirm"
@fa "تایید"
pub func Confirm(title: str, text: str): bool:
ret _os_message(title, text, true)
end
@en "Notify"
@fa "اعلان"
pub func Notify(title: str, body: str, sound: str = ""): bool:
ret _os_notify(title, body, sound)
end
@en "OnNotifyClick"
@fa "هنگام کلیک اعلان"
pub func OnNotifyClick(handler: func ()):
_on_notify_click = handler
end
@en "RequestAttention"
@fa "درخواست توجه"
pub func RequestAttention(window: Window):
_os_attention(window.Native())
end
@en "SecretSet"
@fa "ذخیره راز"
pub func SecretSet(key: str, value: str): bool:
path := _secret_file(key)
defer mem.Free(path as void*)
if _os_secret_set(_secret_id(), key, value):
if os.Exists(path):
_removed := os.Remove(path)
end
ret true
end
if fs.WriteBytes(path, value) < 0:
ret false
end
_private := fs.Chmod(path, 0o600)
ret true
end
@en "SecretGet"
@fa "خواندن راز"
pub func SecretGet(key: str): str:
stored := _os_secret_get(_secret_id(), key)
if stored.len() > 0:
ret stored
end
path := _secret_file(key)
defer mem.Free(path as void*)
if os.Exists(path):
mem.Free(stored as void*)
ret io.ReadFile(path)
end
ret stored
end
@en "SecretDelete"
@fa "حذف راز"
pub func SecretDelete(key: str):
_gone := _os_secret_delete(_secret_id(), key)
path := _secret_file(key)
defer mem.Free(path as void*)
if os.Exists(path):
_removed := os.Remove(path)
end
end
@en "Item"
@fa "مورد"
pub func Item(id: str, label: str): MenuItem:
ret MenuItem { id = id, label = label }
end
@en "Separator"
@fa "خط جداکننده"
pub func Separator(): MenuItem:
ret MenuItem { separator = true }
end
@en "Submenu"
@fa "زیرمنوی تازه"
pub func Submenu(label: str, items: Vector<MenuItem>): MenuItem:
ret MenuItem { label = label, children = items }
end
@en "OnMenu"
@fa "هنگام منو"
pub func OnMenu(handler: func (str)):
_on_menu = handler
OnCommand((native: int): _fire_menu(native) end)
end
@en "SetMenu"
@fa "تنظیم منو"
pub func SetMenu(window: Window, items: Vector<MenuItem>):
if window.index >= 0 and window.index < _wins.len():
_os_set_menu(_wins[window.index].view, items)
end
end
@en "SetTray"
@fa "تنظیم سینی"
pub func SetTray(icon: str, tooltip: str, items: Vector<MenuItem>): bool:
_startup()
ret _os_set_tray(icon, tooltip, items)
end
@en "RemoveTray"
@fa "حذف سینی"
pub func RemoveTray():
_os_remove_tray()
end
@en "OnTrayClick"
@fa "هنگام کلیک سینی"
pub func OnTrayClick(handler: func ()):
_on_tray_click = handler
end
@en "SingleInstance"
@fa "نمونه یکتا"
pub func SingleInstance(on_second: func (Vector<str>)): bool:
_on_second = on_second
ret _os_single_instance()
end
@en "webview"
@fa "نمایش وب"
package webview
import io
import mem
import os
import str
import sync
@en "HintNone"
@fa "بدون اشاره"
pub const HINT_NONE := 0
@en "HintFixed"
@fa "اشاره ثابت"
pub const HINT_FIXED := 1
@en "ENGINE_SYSTEM"
@fa "موتور سیستم"
pub const ENGINE_SYSTEM := "system"
@en "ENGINE_CHROMIUM"
@fa "موتور کرومیوم"
pub const ENGINE_CHROMIUM := "chromium"
mut _wv_hooks := Vector {} as Vector<_Hooks>
mut _wv_open := 0
mut _wv_quit := false
mut _wv_tasks := Vector {} as Vector<_Task>
mut _wv_lock := sync.NewMutex()
mut _wv_schemes := Vector {} as Vector<_Scheme>
mut _wv_data_dir := ""
mut _wv_app_id := ""
mut _wv_app_name := ""
mut _wv_touches := 0
mut _wv_nav_main := true
mut _wv_last_error := ""
mut _wv_trace_path := ""
mut _wv_trace_read := false
mut _wv_on_command := (_id: int): ret end
mut _wv_on_tray := (_event: int): ret end
mut _wv_on_copy_data := (_data: void*, _size: int): ret end
struct _Hooks:
pub on_message: func (str)
pub on_navigate: func (str) bool
pub on_new_window: func (str)
pub on_close: func () bool
pub on_load: func (str, bool)
pub on_crash: func ()
pub on_resize: func (int, int)
pub closed: bool = false
pub devtools_enabled: bool = true
pub translate_enabled: bool = true
end
struct _Task:
pub view: int = -1
pub js: str = ""
pub run: func ()
pub has_run: bool = false
end
struct _Scheme:
pub name: str = ""
pub handler: func (Request) Response
end
@en "Request"
@fa "درخواست"
pub struct Request:
@en "url"
@fa "نشانی"
pub url: str = ""
@en "scheme"
@fa "طرح"
pub scheme: str = ""
@en "method"
@fa "روش"
pub method: str = "GET"
@en "path"
@fa "مسیر"
pub path: str = "/"
@en "query"
@fa "پرسش"
pub query: str = ""
end
@en "Response"
@fa "پاسخ"
pub struct Response:
@en "status"
@fa "وضعیت"
pub status: int = 200
@en "mime"
@fa "نوع محتوا"
pub mime: str = "text/html"
@en "data"
@fa "داده"
pub data: void* = null
@en "size"
@fa "اندازه"
pub size: i64 = 0
@en "headers"
@fa "سرآیندها"
pub headers: Vector<str> = Vector {}
@en "Header"
@fa "افزودن سرآیند"
pub func Header(name: str, value: str):
this.headers.push(name)
this.headers.push(value)
end
end
@en "WebView"
@fa "نمایش وب"
pub struct WebView:
@en "id"
@fa "شناسه"
pub id: int = -1
@en "destroy"
@fa "نابود کردن"
pub func Destroy():
if _wv_alive(this.id):
_wv_bk_destroy(this.id)
_wv_mark_closed(this.id)
end
end
@en "run"
@fa "اجرا"
pub func Run():
_wv_drain()
until _wv_alive(this.id) and not _wv_quit:
_wv_bk_iter()
_wv_drain()
end
_wv_quit = false
end
@en "terminate"
@fa "پایان دادن"
pub func Terminate():
Quit()
end
@en "SetTitle"
@fa "تنظیم عنوان"
pub func SetTitle(title: str):
