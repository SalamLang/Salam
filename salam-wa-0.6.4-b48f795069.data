p := _flow_ws(s, i)
n := s.len()
if depth > 512:
ret _YR { value = "null", next = n, ok = false }
end
bp := _bp(s)
if p < n and _ub(bp, p) == 123: ret _flow_object(s, p, depth) end
if p < n and _ub(bp, p) == 91: ret _flow_array(s, p, depth) end
ret _flow_scalar(s, p)
end
func _flow_object(s: str, i: int, depth: int): _YR:
n := s.len()
bp := _bp(s)
members := Vector {} as Vector<str>
defer members.free()
mut p := _flow_ws(s, i + 1)
if p < n and _ub(bp, p) == 125:
ret _YR { value = "{}", next = p + 1 }
end
mut closed := false
mut all_ok := true
until p < n:
p = _flow_ws(s, p)
k := _flow_key(s, p)
if k.ok == false: all_ok = false end
p = _flow_ws(s, k.next)
if p < n and _ub(bp, p) == 58: p++ end
p = _flow_ws(s, p)
v := _flow_value(s, p, depth + 1)
if v.ok == false: all_ok = false end
members.push(_json_str_literal(k.value).concat(": ").concat(v.value))
p = _flow_ws(s, v.next)
if p < n and _ub(bp, p) == 44:
p++
continue
end
if p < n and _ub(bp, p) == 125:
p++
closed = true
end
break
end
out := Object(members)
ret _YR { value = out, next = p, ok = closed and all_ok }
end
func _flow_array(s: str, i: int, depth: int): _YR:
n := s.len()
bp := _bp(s)
items := Vector {} as Vector<str>
defer items.free()
mut p := _flow_ws(s, i + 1)
if p < n and _ub(bp, p) == 93:
ret _YR { value = "[]", next = p + 1 }
end
mut closed := false
mut all_ok := true
until p < n:
v := _flow_value(s, p, depth + 1)
if v.ok == false: all_ok = false end
items.push(v.value)
p = _flow_ws(s, v.next)
if p < n and _ub(bp, p) == 44:
p++
continue
end
if p < n and _ub(bp, p) == 93:
p++
closed = true
end
break
end
out := Array(items)
ret _YR { value = out, next = p, ok = closed and all_ok }
end
func _parse_block_scalar(lines: Vector<str>, li: int, indicator: str): _YR:
mut folded := false
if indicator.starts_with(">"): folded = true end
mut chomp := 0
k := 1
ilen := indicator.len()
if k < ilen:
ch := indicator.substr(k, 1)
if ch == "-":
chomp = 1
else ch == "+":
chomp = 2
end
end
n := lines.len()
mut bi := li + 1
mut base := 0 - 1
until bi < n and base < 0:
raw := lines.get(bi)
if str.Trim(raw) != "":
base = _raw_indent(raw)
else:
bi++
end
end
if base < 0:
ret _YR { value = _json_str_literal(""), next = li + 1 }
end
body_lines := Vector {} as Vector<str>
defer body_lines.free()
mut cur := li + 1
until cur < n:
raw := lines.get(cur)
if str.Trim(raw) == "":
body_lines.push("")
cur++
else:
ind := _raw_indent(raw)
if ind < base: break end
mut piece := ""
if raw.len() >= base: piece = raw.substr(base, raw.len() - base) end
body_lines.push(str.TrimRight(piece))
cur++
end
end
mut endi := body_lines.len()
until endi > 0 and body_lines.get(endi - 1) == "":
endi--
end
mut sb := str.NewBuilder()
defer str.BufFree(sb)
mut prev_blank := false
repeat endi in idx:
line := body_lines.get(idx)
if idx > 0:
if folded:
if line == "" or prev_blank:
str.BufAppendChar(sb, 10)
else:
str.BufAppendChar(sb, 32)
end
else:
str.BufAppendChar(sb, 10)
end
end
str.BufAppend(sb, line)
prev_blank = line == ""
end
mut result := str.BufStr(sb)
if chomp == 2:
trailing := body_lines.len() - endi
mut t := 0
until t < trailing + 1:
result = result.concat("\n")
t++
end
else chomp == 0:
if endi > 0: result = result.concat("\n") end
end
ret _YR { value = _json_str_literal(result), next = cur }
end
func _dump_indent(sb &: str.StringBuilder, unit: str, depth: int):
repeat depth:
str.BufAppend(sb, unit)
end
end
func _dump_scalar(s: str, n: int, i: int, sb &: str.StringBuilder): int:
bp := _bp(s)
if i < n and _ub(bp, i) == 34:
e := _cstr_end(s, n, i)
raw := _json_unescape(s.substr(i + 1, e - i - 2))
if _needs_quote(raw):
str.BufAppend(sb, _json_str_literal(raw))
else:
str.BufAppend(sb, raw)
end
ret e
end
e := _cval_end(s, n, i)
str.BufAppend(sb, s.substr(i, e - i))
ret e
end
func _dump_collection_or_scalar(s: str, n: int, vs: int, sb &: str.StringBuilder, unit: str, depth: int): int:
bp := _bp(s)
vc := _ub(bp, vs)
if vc == 123 or vc == 91:
mut closec := 125
if vc == 91: closec = 93 end
inner := _cws(s, n, vs + 1)
if inner < n and _ub(bp, inner) == closec:
str.BufAppendChar(sb, 32)
if vc == 123: str.BufAppend(sb, "{}") else:
str.BufAppend(sb, "[]")
end
ret inner + 1
end
str.BufAppendChar(sb, 10)
ret _dump_block(s, n, vs, sb, unit, depth + 1)
end
str.BufAppendChar(sb, 32)
ret _dump_scalar(s, n, vs, sb)
end
func _dump_block(s: str, n: int, i0: int, sb &: str.StringBuilder, unit: str, depth: int): int:
i := _cws(s, n, i0)
bp := _bp(s)
if i >= n:
str.BufAppend(sb, "null")
ret i
end
c := _ub(bp, i)
if c == 123:
mut p := _cws(s, n, i + 1)
if p < n and _ub(bp, p) == 125:
str.BufAppend(sb, "{}")
ret p + 1
end
mut first := true
until p < n:
p = _cws(s, n, p)
ke := _cstr_end(s, n, p)
keyraw := _json_unescape(s.substr(p + 1, ke - p - 2))
if first == false: str.BufAppendChar(sb, 10) end
first = false
_dump_indent(sb, unit, depth)
if _needs_quote(keyraw):
str.BufAppend(sb, _json_str_literal(keyraw))
else:
str.BufAppend(sb, keyraw)
end
str.BufAppendChar(sb, 58)
p = _cws(s, n, ke)
if p < n and _ub(bp, p) == 58: p++ end
vs := _cws(s, n, p)
p = _dump_collection_or_scalar(s, n, vs, sb, unit, depth)
p = _cws(s, n, p)
if p < n and _ub(bp, p) == 44:
p++
continue
end
if p < n and _ub(bp, p) == 125: p++ end
break
end
ret p
end
if c == 91:
mut p := _cws(s, n, i + 1)
if p < n and _ub(bp, p) == 93:
str.BufAppend(sb, "[]")
ret p + 1
end
mut first := true
until p < n:
if first == false: str.BufAppendChar(sb, 10) end
first = false
_dump_indent(sb, unit, depth)
str.BufAppendChar(sb, 45)
vs := _cws(s, n, p)
p = _dump_collection_or_scalar(s, n, vs, sb, unit, depth)
p = _cws(s, n, p)
if p < n and _ub(bp, p) == 44:
p++
continue
end
if p < n and _ub(bp, p) == 93: p++ end
break
end
ret p
end
ret _dump_scalar(s, n, i, sb)
end
@en "Parse"
@fa "تجزیه"
pub func Parse(text: str): str:
r := _parse_document(text)
ret r.value
end
@en "ToJSON"
@fa "به جیسون"
pub func ToJSON(text: str): str:
ret Parse(text)
end
@en "Valid"
@fa "معتبر"
pub func Valid(text: str): bool:
r := _parse_document(text)
if r.ok == false: ret false end
t := _truncate_to_first_doc(text)
lines := t.split("\n")
defer lines.free()
tail := _skip_noise(lines, r.next)
total := lines.len()
ret tail >= total
end
@en "SplitDocuments"
@fa "تفکیک کردن اسناد"
pub func SplitDocuments(text: str): Vector<str>:
lines := text.split("\n")
defer lines.free()
out := Vector {} as Vector<str>
mut cur := str.NewBuilder()
mut any := false
n := lines.len()
mut i := 0
until i < n:
raw := lines.get(i)
t := str.Trim(raw)
if t == "---":
if any: out.push(str.BufStr(cur)) end
str.BufReset(cur)
any = true
else t == "...":
if any: out.push(str.BufStr(cur)) end
str.BufReset(cur)
any = false
else:
if str.BufIsEmpty(cur) == false: str.BufAppendChar(cur, 10) end
str.BufAppend(cur, raw)
any = true
end
i++
end
if any: out.push(str.BufStr(cur)) end
str.BufFree(cur)
ret out
end
@en "env"
@fa "محیط"
package env
import str
import conv
import io
import fs.path
import encoding.envfile
if SALAM_OS_WINDOWS:
extern:
func getenv(name: str): void*
func _putenv_s(name: str, value: str): int
end
else:
extern:
func getenv(name: str): void*
func setenv(name: str, value: str, overwrite: int): int
func unsetenv(name: str): int
end
end
func _base_from_names(names: Vector<str>): envfile.Doc:
mut base := envfile.New()
repeat names.len() in i:
n := names.get(i)
if Has(n): envfile.Set(base, n, Get(n)) end
end
ret base
end
func _env_base(raw &: envfile.Doc): envfile.Doc:
names := envfile.RefNames(raw)
defer names.free()
ret _base_from_names(names)
end
func _apply_doc(d &: envfile.Doc, override: bool): int:
mut count := 0
repeat envfile.Len(d) in i:
k := envfile.KeyAt(d, i)
if override or Has(k) == false:
Set(k, envfile.ValueAt(d, i))
count++
end
end
ret count
end
func _apply_raw(raw &: envfile.Doc, override: bool): int:
mut base := _env_base(raw)
defer envfile.Free(base)
mut d := envfile.ExpandDoc(raw, base)
defer envfile.Free(d)
ret _apply_doc(d, override)
end
func _apply_text(text: str, override: bool): int:
mut raw := envfile.ParseRaw(text)
defer envfile.Free(raw)
ret _apply_raw(raw, override)
end
func _merge_file(dst &: envfile.Doc, p: str):
mut raw := envfile.ParseRaw(io.ReadFile(p))
defer envfile.Free(raw)
envfile.MergeInto(dst, raw)
end
@en "Get"
@fa "دریافت"
pub func Get(name: str): str:
v := getenv(name)
if v == null: ret "" end
ret str.Clone(v as str)
end
@en "GetOr"
@fa "دریافت با پیش فرض"
pub func GetOr(name: str, def: str): str:
v := Get(name)
if v.len() == 0: ret def end
ret v
end
@en "Has"
@fa "دارد"
pub func Has(name: str): bool: ret getenv(name) != null end
@en "GetInt"
@fa "دریافت صحیح"
pub func GetInt(name: str, def: i64): i64:
v := Get(name)
if v.len() == 0: ret def end
ret conv.ParseIntOr(v, def)
end
@en "GetFloat"
@fa "دریافت اعشاری"
pub func GetFloat(name: str, def: f64): f64:
v := Get(name)
if v.len() == 0: ret def end
ret conv.ParseFloatOr(v, def)
end
@en "GetBool"
@fa "دریافت منطقی"
pub func GetBool(name: str, def: bool): bool:
v := Get(name)
if v.len() == 0: ret def end
ret conv.ParseBoolOr(v, def)
end
if SALAM_OS_WINDOWS:
@en "Set"
@fa "تنظیم"
pub func Set(name: str, value: str): bool: ret _putenv_s(name, value) == 0 end
@en "Unset"
@fa "حذف"
pub func Unset(name: str): bool: ret _putenv_s(name, "") == 0 end
else:
@en "Set"
@fa "تنظیم"
pub func Set(name: str, value: str): bool: ret setenv(name, value, 1) == 0 end
@en "Unset"
@fa "حذف"
pub func Unset(name: str): bool: ret unsetenv(name) == 0 end
end
@en "Mask"
@fa "پوشاندن"
pub func Mask(value: str): str:
n := value.len()
if n == 0: ret "" end
if n <= 8:
mut out := ""
repeat n: out = out.concat("*") end
ret out
end
ret value.substr(0, 2).concat("****").concat(value.substr(n - 2, 2))
end
@en "GetMasked"
@fa "دریافت پوشیده"
pub func GetMasked(name: str): str: ret Mask(Get(name)) end
@en "Profile"
@fa "نمایه"
pub func Profile(): str:
v := GetOr("SALAM_ENV", GetOr("APP_ENV", GetOr("ENV", "development")))
ret str.Lower(v)
end
@en "IsProduction"
@fa "تولید است"
pub func IsProduction(): bool: ret Profile() == "production" or Profile() == "prod" end
@en "IsDevelopment"
@fa "توسعه است"
pub func IsDevelopment(): bool: ret Profile() == "development" or Profile() == "dev" end
@en "IsTest"
@fa "آزمایش است"
pub func IsTest(): bool: ret Profile() == "test" or Profile() == "testing" end
@en "IsStaging"
@fa "آزمایشی است"
pub func IsStaging(): bool: ret Profile() == "staging" end
@en "Load"
@fa "بارگذاری"
pub func Load(path: str): int:
ret _apply_text(io.ReadFile(path), false)
end
@en "Overload"
@fa "بارگذاری اجباری"
pub func Overload(path: str): int:
ret _apply_text(io.ReadFile(path), true)
end
@en "LoadText"
@fa "بارگذاری متن"
pub func LoadText(text: str): int:
ret _apply_text(text, false)
end
@en "LoadDotEnv"
@fa "بارگذاری نقطه‌محیط"
pub func LoadDotEnv(path: str): int:
ret _apply_text(io.ReadFile(path), true)
end
@en "LoadProfile"
@fa "بارگذاری نمایه"
pub func LoadProfile(dir: str): int:
p := Profile()
mut d := envfile.New()
defer envfile.Free(d)
_merge_file(d, path.Join(dir, ".env"))
_merge_file(d, path.Join(dir, ".env.local"))
_merge_file(d, path.Join(dir, ".env.".concat(p)))
_merge_file(d, path.Join(dir, ".env.".concat(p).concat(".local")))
ret _apply_raw(d, false)
end
@en "Expand"
@fa "گسترش"
pub func Expand(text: str): str:
names := envfile.RefNamesIn(text)
defer names.free()
mut base := _base_from_names(names)
defer envfile.Free(base)
mut none := envfile.New()
defer envfile.Free(none)
ret envfile.Expand(text, none, base)
end
@en "error"
@fa "خطاها"
package error
@en "RetryPolicy"
@fa "سیاست تکرار"
pub struct RetryPolicy:
@en "max_attempts"
@fa "بیشترین کوشش"
pub max_attempts: int = 3
@en "base_delay_ms"
@fa "تأخیر پایه میلی‌ثانیه"
pub base_delay_ms: int = 100
@en "max_delay_ms"
@fa "سقف تأخیر میلی‌ثانیه"
pub max_delay_ms: int = 5000
end
@en "KindName"
@fa "نام نوع"
pub func KindName(kind: ErrorKind): str:
e := Error { kind = kind }
ret e.kind_name()
end
@en "IsRetryable"
@fa "قابل تکرار است"
pub func IsRetryable(e: Error): bool:
ret e.kind == ErrorKind.Timeout or e.kind == ErrorKind.Unavailable or e.kind == ErrorKind.Io
end
@en "NewRetryPolicy"
@fa "سیاست تکرار جدید"
pub func NewRetryPolicy(max_attempts: int, base_delay_ms: int, max_delay_ms: int): RetryPolicy:
ret RetryPolicy { max_attempts = max_attempts, base_delay_ms = base_delay_ms, max_delay_ms = max_delay_ms }
end
@en "DelayForAttempt"
@fa "تاخیر برای کوشش"
pub func DelayForAttempt(p &: RetryPolicy, attempt: int): int:
if attempt <= 1: ret p.base_delay_ms end
mut delay := p.base_delay_ms
mut i := 1
until i < attempt:
delay *= 2
if delay >= p.max_delay_ms: ret p.max_delay_ms end
i++
end
ret delay
end
@en "ShouldRetry"
@fa "باید تکرار شود"
pub func ShouldRetry(p &: RetryPolicy, e: Error, attempt: int): bool:
if attempt >= p.max_attempts: ret false end
ret IsRetryable(e)
end
@en "events"
@fa "رویدادها"
package events
import mem
import str
import sync
const _NEXT := 0
const _CLOSED := 1
const _PENDING := 3
const _COUNT := 4
const _CAP := 5
const _QHEAD := 6
const _QLEN := 7
const _QCAP := 8
@en "Event"
@fa "رویداد"
pub struct Event<T>:
@en "topic"
@fa "موضوع"
pub topic: str = ""
@en "data"
@fa "داده"
pub data: T
end
@en "Handler"
@fa "کنشگر"
pub struct Handler<T>:
@en "id"
@fa "شناسه"
pub id: int = 0
@en "pattern"
@fa "الگو"
pub pattern: str = ""
@en "once"
@fa "یک بار"
pub once: bool = false
@en "cb"
@fa "تابع"
pub cb: func (Event<T>)
end
@en "Emitter"
@fa "انتشاردهنده"
pub struct Emitter<T>:
@en "hs"
@fa "کنشگرها"
pub hs: Handler<T>**= null
@en "mu"
@fa "قفل"
pub mu: sync.Mutex = sync.Mutex {}
@en "ctl"
@fa "وضعیت درونی"
pub ctl: i64* = null
@en "async"
@fa "ناهمگام"
pub async: bool = false
@en "qbuf"
@fa "صف"
pub qbuf: Event<T>*= null
@en "cv"
@fa "شرط"
pub cv: sync.CondVar = sync.CondVar {}
end
func _make<T>(): Emitter<T>:
mut e := Emitter {} as Emitter<T>
e.mu = sync.NewMutex()
e.ctl = mem.AllocateZeroed(((_QCAP + 1) * 8) as u64) as i64*
e.ctl[_CAP] = 8
e.hs = mem.AllocateZeroed(8 as u64) as Handler<T>**
e.hs[0] = mem.AllocateZeroed((8 * (sizeof(Handler<T>) as i64)) as u64) as Handler<T>*
ret e
end
func _push<T>(e: Emitter<T>, h: Handler<T>):
if e.ctl[_COUNT] >= e.ctl[_CAP]:
e.ctl[_CAP] *= 2
e.hs[0] = mem.Reallocate(e.hs[0] as void*, (e.ctl[_CAP] * (sizeof(Handler<T>) as i64)) as u64) as Handler<T>*
end
e.hs[0][e.ctl[_COUNT] as int] = h
e.ctl[_COUNT]++
end
func _remove_at<T>(e: Emitter<T>, at: int):
mut i := at
until i < (e.ctl[_COUNT] as int) - 1:
e.hs[0][i] = e.hs[0][i + 1]
i++
end
e.ctl[_COUNT]--
end
func _match(pattern: str, topic: str): bool:
if pattern == topic:
ret true
end
ps := str.Split(pattern, ".")
ts := str.Split(topic, ".")
mut ok := true
mut i := 0
mut done := false
until not done:
if i >= ps.len():
ok = i >= ts.len()
done = true
else i >= 0 and ps.get(i) == "#":
ok = true
done = true
else i >= ts.len():
ok = false
done = true
else ps.get(i) != "*" and ps.get(i) != ts.get(i):
ok = false
done = true
else:
i++
end
end
ps.free()
ts.free()
ret ok
end
func _dispatch<T>(e: Emitter<T>, ev: Event<T>): int:
sync.Lock(e.mu)
snap := mem.AllocateZeroed(((e.ctl[_COUNT] + 1) * (sizeof(Handler<T>) as i64)) as u64) as Handler<T>*
mut n := 0
mut i := 0
until i < (e.ctl[_COUNT] as int):
h := e.hs[0][i]
if _match(h.pattern, ev.topic):
snap[n] = h
n++
if h.once:
_remove_at(e, i)
else:
i++
end
else:
i++
end
end
sync.Unlock(e.mu)
repeat n in k:
h := snap[k]
h.cb(ev)
end
mem.Free(snap as void*)
ret n
end
func _add<T>(e: Emitter<T>, pattern: str, once: bool, cb: func (Event<T>)): int:
sync.Lock(e.mu)
e.ctl[_NEXT]++
id := e.ctl[_NEXT] as int
_push(e, Handler { id = id, pattern = pattern, once = once, cb = cb } as Handler<T>)
sync.Unlock(e.mu)
ret id
end
@en "New"
@fa "جدید"
pub func New<T>(): Emitter<T>:
ret _make()
end
@en "On"
@fa "روی"
pub func On<T>(e: Emitter<T>, pattern: str, cb: func (Event<T>)): int:
ret _add(e, pattern, false, cb)
end
@en "Once"
@fa "یک‌بار"
pub func Once<T>(e: Emitter<T>, pattern: str, cb: func (Event<T>)): int:
ret _add(e, pattern, true, cb)
end
@en "OnAny"
@fa "روی همه"
pub func OnAny<T>(e: Emitter<T>, cb: func (Event<T>)): int:
ret _add(e, "#", false, cb)
end
@en "Off"
@fa "خاموش"
pub func Off<T>(e: Emitter<T>, id: int): bool:
mut found := false
sync.Lock(e.mu)
mut i := 0
until i < (e.ctl[_COUNT] as int) and not found:
if e.hs[0][i].id == id:
_remove_at(e, i)
found = true
else:
i++
end
end
sync.Unlock(e.mu)
ret found
end
@en "OffTopic"
@fa "خاموش موضوع"
pub func OffTopic<T>(e: Emitter<T>, pattern: str): int:
mut removed := 0
sync.Lock(e.mu)
mut i := 0
until i < (e.ctl[_COUNT] as int):
if e.hs[0][i].pattern == pattern:
_remove_at(e, i)
removed++
else:
i++
end
end
sync.Unlock(e.mu)
ret removed
end
@en "Count"
@fa "شمار"
pub func Count<T>(e: Emitter<T>, topic: str): int:
mut n := 0
sync.Lock(e.mu)
repeat (e.ctl[_COUNT] as int) in i:
if _match(e.hs[0][i].pattern, topic):
n++
end
end
sync.Unlock(e.mu)
ret n
end
@en "Len"
@fa "تعداد"
pub func Len<T>(e: Emitter<T>): int:
sync.Lock(e.mu)
n := (e.ctl[_COUNT] as int)
sync.Unlock(e.mu)
ret n
end
@en "Emit"
@fa "انتشار"
pub func Emit<T>(e: Emitter<T>, topic: str, data: T): int:
ev := Event { topic = topic, data = data } as Event<T>
ret _dispatch(e, ev)
end
@en "NewAsync"
@fa "جدید ناهمگام"
pub func NewAsync<T>(capacity: int): Emitter<T>:
mut e := _make() as Emitter<T>
mut cap := capacity as i64
if cap < 1:
cap = 1
end
e.async = true
e.cv = sync.NewCondVar()
e.ctl[_QCAP] = cap
e.qbuf = mem.AllocateZeroed((cap * (sizeof(Event<T>) as i64)) as u64) as Event<T>*
ret e
end
@en "EmitAsync"
@fa "انتشار ناهمگام"
pub func EmitAsync<T>(e: Emitter<T>, topic: str, data: T): bool:
if not e.async:
ret false
end
ev := Event { topic = topic, data = data } as Event<T>
sync.Lock(e.mu)
until e.ctl[_QLEN] >= e.ctl[_QCAP] and e.ctl[_CLOSED] == 0:
sync.WaitCond(e.cv, e.mu)
end
if e.ctl[_CLOSED] != 0:
sync.Unlock(e.mu)
ret false
end
at := (e.ctl[_QHEAD] + e.ctl[_QLEN]) % e.ctl[_QCAP]
e.qbuf[at as int] = ev
e.ctl[_QLEN]++
e.ctl[_PENDING]++
sync.Broadcast(e.cv)
sync.Unlock(e.mu)
ret true
end
@en "Pending"
@fa "در انتظار"
pub func Pending<T>(e: Emitter<T>): int:
sync.Lock(e.mu)
n := e.ctl[_PENDING] as int
sync.Unlock(e.mu)
ret n
end
@en "Flush"
@fa "تخلیه"
pub func Flush<T>(e: Emitter<T>):
if not e.async:
ret
end
sync.Lock(e.mu)
until e.ctl[_PENDING] > 0:
sync.WaitCond(e.cv, e.mu)
end
sync.Unlock(e.mu)
end
@en "Drain"
@fa "پردازش صف"
pub func Drain<T>(e: Emitter<T>):
mut running := true
until running:
sync.Lock(e.mu)
until e.ctl[_QLEN] == 0 and e.ctl[_CLOSED] == 0:
sync.WaitCond(e.cv, e.mu)
end
if e.ctl[_QLEN] == 0:
sync.Unlock(e.mu)
running = false
else:
ev := e.qbuf[e.ctl[_QHEAD] as int]
e.ctl[_QHEAD] = (e.ctl[_QHEAD] + 1) % e.ctl[_QCAP]
e.ctl[_QLEN]--
sync.Broadcast(e.cv)
sync.Unlock(e.mu)
_dispatch(e, ev)
sync.Lock(e.mu)
e.ctl[_PENDING]--
sync.Broadcast(e.cv)
sync.Unlock(e.mu)
end
end
end
@en "Close"
@fa "بستن"
pub func Close<T>(e: Emitter<T>):
if not e.async:
ret
end
sync.Lock(e.mu)
if e.ctl[_CLOSED] != 0:
sync.Unlock(e.mu)
ret
end
e.ctl[_CLOSED] = 1
sync.Broadcast(e.cv)
sync.Unlock(e.mu)
end
@en "Free"
@fa "آزادکن"
pub func Free<T>(e: Emitter<T>):
Close(e)
if e.async:
mem.Free(e.qbuf as void*)
sync.DestroyCondVar(e.cv)
end
mem.Free(e.hs[0] as void*)
mem.Free(e.hs as void*)
mem.Free(e.ctl as void*)
sync.Destroy(e.mu)
end
package excel
import conv
import time
@en "CellEmpty"
@fa "سلول خالی"
pub const CellEmpty := 0
@en "CellString"
@fa "سلول رشته‌ای"
pub const CellString := 1
@en "CellNumber"
@fa "سلول عددی"
pub const CellNumber := 2
@en "CellBool"
@fa "سلول منطقی"
pub const CellBool := 3
@en "CellDate"
@fa "سلول تاریخ"
pub const CellDate := 4
@en "CellFormula"
@fa "سلول فرمول"
pub const CellFormula := 5
@en "CellError"
@fa "سلول خطا"
pub const CellError := 6
@en "Cell"
@fa "سلول"
pub struct Cell:
@en "row"
@fa "سطر"
pub row: int = 0
@en "col"
@fa "ستون"
pub col: int = 0
@en "kind"
@fa "نوع"
pub kind: int = 0
@en "text"
@fa "متن"
pub text: str = ""
@en "num"
@fa "عدد"
pub num: f64 = 0.0
@en "flag"
@fa "منطقی"
pub flag: bool = false
@en "formula"
@fa "فرمول"
pub formula: str = ""
@en "style_id"
@fa "شماره سبک"
pub style_id: int = -1
end
@en "CellPos"
@fa "موقعیت سلول"
pub struct CellPos:
@en "row"
@fa "سطر"
pub row: int = 0
@en "col"
@fa "ستون"
pub col: int = 0
end
inline pure func _bp(s: str): i8*: ret (s as void*) as i8* end
inline pure func _ub(bp: i8*, i: int): int:
mut v := bp[i] as int
if v < 0: v += 256 end
ret v
end
func _pad2(n: int): str:
if n < 10: ret "0" + conv.FormatInt(n as i64) end
ret conv.FormatInt(n as i64)
end
func _date_text(epoch: i64): str:
ret conv.FormatInt(time.YearUTC(epoch) as i64) + "-" + _pad2(time.MonthUTC(epoch)) + "-" + _pad2(time.DayUTC(epoch))
end
func _datetime_text(epoch: i64): str:
ret _date_text(epoch) + "T" + _pad2(time.HourUTC(epoch)) + ":" + _pad2(time.MinuteUTC(epoch)) + ":" + _pad2(time.SecondUTC(epoch))
end
@en "NewStringCell"
@fa "سلول رشته‌ای جدید"
pub func NewStringCell(row: int, col: int, value: str): Cell:
ret Cell { row = row, col = col, kind = CellString, text = value }
end
@en "NewNumberCell"
@fa "سلول عددی جدید"
pub func NewNumberCell(row: int, col: int, value: f64): Cell:
ret Cell { row = row, col = col, kind = CellNumber, num = value }
end
@en "NewBoolCell"
@fa "سلول منطقی جدید"
pub func NewBoolCell(row: int, col: int, value: bool): Cell:
ret Cell { row = row, col = col, kind = CellBool, flag = value }
end
@en "NewDateCell"
@fa "سلول تاریخ جدید"
pub func NewDateCell(row: int, col: int, epoch: i64): Cell:
ret Cell { row = row, col = col, kind = CellDate, num = EpochToSerial(epoch) }
end
@en "NewFormulaCell"
@fa "سلول فرمول جدید"
pub func NewFormulaCell(row: int, col: int, formula: str, cached: f64): Cell:
ret Cell { row = row, col = col, kind = CellFormula, formula = formula, num = cached }
end
@en "ColumnLabel"
@fa "برچسب ستون"
pub func ColumnLabel(col: int): str:
mut n := col + 1
mut out := ""
until n > 0:
n--
rem := n % 26
out = char_from_code(65 + rem).concat(out)
n /= 26
end
ret out
end
@en "ColumnIndex"
@fa "اندیس ستون"
pub func ColumnIndex(label: str): int:
up := label.upper()
n := up.len()
if n == 0: ret -1 end
bp := _bp(up)
mut idx := 0
mut i := 0
until i < n:
code := _ub(bp, i)
if code < 65 or code > 90: ret -1 end
idx = idx * 26 + (code - 64)
i++
end
ret idx - 1
end
@en "CellRef"
@fa "ارجاع سلول"
pub func CellRef(row: int, col: int): str:
ret ColumnLabel(col).concat(conv.FormatInt((row + 1) as i64))
end
@en "ParseCellRef"
@fa "تجزیه ارجاع سلول"
pub func ParseCellRef(ref: str, row_out &: int, col_out &: int): bool:
n := ref.len()
if n == 0: ret false end
bp := _bp(ref)
mut i := 0
until i < n:
code := _ub(bp, i)
mut is_alpha := false
if code >= 65 and code <= 90: is_alpha = true
else code >= 97 and code <= 122: is_alpha = true
end
if not is_alpha: break end
i++
end
if i == 0 or i >= n: ret false end
col := ColumnIndex(ref.substr(0, i))
if col < 0: ret false end
rowpart := ref.substr(i, n - i)
rp := _bp(rowpart)
mut j := 0
until j < rowpart.len():
c := _ub(rp, j)
if c < 48 or c > 57: ret false end
j++
end
row1 := conv.AtoiOr(rowpart, 0)
if row1 <= 0: ret false end
row_out = row1 - 1
col_out = col
ret true
end
@en "EpochToSerial"
@fa "تبدیل زمان به سریال"
pub func EpochToSerial(epoch: i64): f64:
ret (epoch as f64) / 86400.0 + 25569.0
end
@en "SerialToEpoch"
@fa "تبدیل سریال به زمان"
pub func SerialToEpoch(serial: f64): i64:
ret ((serial - 25569.0) * 86400.0) as i64
end
package excel
import encoding.csv
import os
import str
@en "SheetToCSV"
@fa "برگه به سی‌اس‌وی"
pub func SheetToCSV(sheet: Sheet): str:
mut sb := str.NewBuilder()
defer str.BufFree(sb)
nr := sheet.row_count()
nc := sheet.col_count()
mut r := 0
until r < nr:
mut fields := Vector {} as Vector<str>
mut c := 0
until c < nc:
fields.push(sheet.get_string(r, c))
c++
end
str.BufAppend(sb, csv.WriteLine(fields))
fields.free()
if r < nr - 1: str.BufAppend(sb, "\n") end
r++
end
out := str.BufStr(sb)
ret out
end
@en "CSVToSheet"
@fa "سی‌اس‌وی به برگه"
pub func CSVToSheet(text: str, sheet_name: str): Sheet throws:
mut table := try csv.ReadAllWith(text, csv.CSVOptions { keep_blank = true })
mut sh := NewSheet(sheet_name)
repeat table.rows.len() in r:
mut fields := table.rows.get(r).fields
repeat fields.len() in c:
sh.set_string(r, c, fields.get(c))
end
fields.free()
end
table.rows.free()
ret sh
end
@en "ReadCSVWorkbook"
@fa "خواندن کتاب کار سی‌اس‌وی"
pub func ReadCSVWorkbook(path: str, ok &: bool, err &: str): Workbook:
ok = false
err = ""
if not os.Exists(path):
err = "cannot open file: ".concat(path)
ret NewWorkbook()
end
text := os.ReadFile(path)
mut book := NewWorkbook()
try:
sh := CSVToSheet(text, "Sheet1")
book.sheets.push(sh)
catch e:
err = e.with_path(path).to_str()
ret book
end
book.format = FormatCSV
book.source_path = path
ok = true
ret book
end
@en "WriteCSVWorkbook"
@fa "نوشتن کتاب کار سی‌اس‌وی"
pub func WriteCSVWorkbook(book &: Workbook, path: str): bool:
if book.sheets.len() == 0: ret false end
mut idx := book.active_sheet
if idx < 0 or idx >= book.sheets.len(): idx = 0 end
sh := book.sheets.get(idx)
text := SheetToCSV(sh)
ret os.WriteFile(path, text) >= 0
end
@en "excel"
@fa "اکسل"
package excel
import archive
import compress
import conv
import encoding.csv
import filepath
import encoding.json
import os
import str
import time
@en "FormatUnknown"
@fa "قالب نامشخص"
pub const FormatUnknown := 0
@en "FormatXLSX"
@fa "قالب ایکس‌ال‌اس‌ایکس"
pub const FormatXLSX := 1
@en "FormatXLS"
@fa "قالب ایکس‌ال‌اس"
pub const FormatXLS := 2
@en "FormatODS"
@fa "قالب اُدی‌اس"
pub const FormatODS := 3
@en "FormatCSV"
@fa "قالب سی‌اس‌وی"
pub const FormatCSV := 4
@en "DetectFormat"
@fa "تشخیص قالب"
pub func DetectFormat(path: str): int:
ext := filepath.Ext(path).lower()
if ext == ".xlsx": ret FormatXLSX end
if ext == ".xls": ret FormatXLS end
if ext == ".ods": ret FormatODS end
if ext == ".csv": ret FormatCSV end
ret FormatUnknown
end
@en "New"
@fa "جدید"
pub func New(): Workbook:
ret NewWorkbook()
end
@en "Open"
@fa "بازکردن"
pub func Open(path: str, ok &: bool, err &: str): Workbook:
fmt := DetectFormat(path)
if fmt == FormatXLSX:
ret ReadXLSX(path, ok, err)
end
if fmt == FormatODS:
ret ReadODS(path, ok, err)
end
if fmt == FormatXLS:
ret ReadXLS(path, ok, err)
end
if fmt == FormatCSV:
ret ReadCSVWorkbook(path, ok, err)
end
ok = false
err = "unsupported file extension: ".concat(filepath.Ext(path))
ret NewWorkbook()
end
@en "Save"
@fa "ذخیره"
pub func Save(book &: Workbook, path: str): bool:
fmt := DetectFormat(path)
if fmt == FormatXLSX:
ret WriteXLSX(book, path)
end
if fmt == FormatODS:
ret WriteODS(book, path)
end
if fmt == FormatCSV:
ret WriteCSVWorkbook(book, path)
end
ret false
end
package excel
import encoding.json
import str
func _json_ws(s: str, i: int): int:
n := s.len()
bp := _bp(s)
mut p := i
until p < n:
c := _ub(bp, p)
if c != 32 and c != 9 and c != 10 and c != 13: ret p end
p++
end
ret p
end
func _json_parse_string(s: str, i: int, out_val &: str): int:
n := s.len()
bp := _bp(s)
if i >= n or _ub(bp, i) != 34: ret -1 end
mut p := i + 1
mut sb := str.NewBuilder()
defer str.BufFree(sb)
until p < n:
c := _ub(bp, p)
if c == 34:
out_val = str.BufStr(sb)
ret p + 1
end
if c == 92 and p + 1 < n:
nc := _ub(bp, p + 1)
if nc == 34: str.BufAppendChar(sb, 34)
else nc == 92: str.BufAppendChar(sb, 92)
else nc == 110: str.BufAppendChar(sb, 10)
else nc == 116: str.BufAppendChar(sb, 9)
else nc == 114: str.BufAppendChar(sb, 13)
else:
str.BufAppendChar(sb, nc)
end
p += 2
else:
str.BufAppendChar(sb, c)
p++
end
end
ret -1
end
func _json_parse_token(s: str, i: int, out_val &: str): int:
n := s.len()
bp := _bp(s)
mut p := i
until p < n:
c := _ub(bp, p)
if c == 44 or c == 93 or c == 32 or c == 9 or c == 10 or c == 13: break end
p++
end
out_val = s.substr(i, p - i)
ret p
end
func _json_parse_value(s: str, i: int, out_val &: str): int:
p := _json_ws(s, i)
n := s.len()
if p >= n: ret -1 end
bp := _bp(s)
if _ub(bp, p) == 34: ret _json_parse_string(s, p, out_val) end
ret _json_parse_token(s, p, out_val)
end
func _json_parse_row_array(s: str, i: int, out &: Vector<str>): int:
mut p := _json_ws(s, i)
n := s.len()
if p >= n: ret -1 end
bp := _bp(s)
if _ub(bp, p) != 91: ret -1 end
p++
p = _json_ws(s, p)
if p < n and _ub(bp, p) == 93: ret p + 1 end
until true:
mut val := ""
p = _json_parse_value(s, p, val)
if p < 0: ret -1 end
out.push(val)
p = _json_ws(s, p)
if p >= n: ret -1 end
c := _ub(bp, p)
if c == 44:
p++
p = _json_ws(s, p)
else c == 93:
ret p + 1
else:
ret -1
end
end
end
@en "SheetToJSON"
@fa "برگه به جیسون"
pub func SheetToJSON(sheet: Sheet): str:
mut rows := Vector {} as Vector<str>
defer rows.free()
nr := sheet.row_count()
nc := sheet.col_count()
mut r := 0
until r < nr:
mut cells := Vector {} as Vector<str>
mut c := 0
until c < nc:
cells.push(json.Str(sheet.get_string(r, c)))
c++
end
rows.push(json.Array(cells))
cells.free()
r++
end
out := json.Array(rows)
ret out
end
@en "JSONToSheet"
@fa "جیسون به برگه"
pub func JSONToSheet(text: str, sheet_name: str): Sheet:
mut sh := NewSheet(sheet_name)
n := text.len()
p := _json_ws(text, 0)
if p >= n: ret sh end
bp := _bp(text)
if _ub(bp, p) != 91: ret sh end
mut pos := p + 1
pos = _json_ws(text, pos)
if pos < n and _ub(bp, pos) == 93: ret sh end
mut row := 0
mut go := true
until go:
mut fields := Vector {} as Vector<str>
np := _json_parse_row_array(text, pos, fields)
if np < 0:
fields.free()
go = false
else:
mut c := 0
until c < fields.len():
sh.set_string(row, c, fields.get(c))
c++
end
fields.free()
pos = _json_ws(text, np)
if pos >= n:
go = false
else:
cc := _ub(bp, pos)
if cc == 44:
pos++
pos = _json_ws(text, pos)
row++
else:
go = false
end
end
end
end
ret sh
end
package excel
import os
@en "FileMeta"
@fa "فراداده پرونده"
pub struct FileMeta:
@en "path"
@fa "مسیر"
pub path: str = ""
@en "format"
@fa "قالب"
pub format: int = 0
@en "exists"
@fa "وجود دارد"
pub exists: bool = false
@en "size"
@fa "اندازه"
pub size: i64 = 0
@en "sheet_names"
@fa "نام برگه‌ها"
pub sheet_names: Vector<str> = Vector {} as Vector<str>
@en "sheet_rows"
@fa "سطرهای برگه‌ها"
pub sheet_rows: Vector<int> = Vector {} as Vector<int>
@en "sheet_cols"
@fa "ستون‌های برگه‌ها"
pub sheet_cols: Vector<int> = Vector {} as Vector<int>
@en "free"
@fa "آزادسازی"
pub func free():
this.sheet_names.free()
this.sheet_rows.free()
this.sheet_cols.free()
end
end
@en "Inspect"
@fa "بازرسی"
pub func Inspect(path: str, ok &: bool, err &: str): FileMeta:
ok = false
err = ""
mut meta := FileMeta { path = path }
if not os.Exists(path):
err = "file does not exist: ".concat(path)
ret meta
end
meta.exists = true
meta.size = os.FileSize(path)
meta.format = DetectFormat(path)
mut open_ok := false
mut open_err := ""
mut book := Open(path, open_ok, open_err)
if not open_ok:
err = open_err
book.free()
ret meta
end
mut i := 0
until i < book.sheets.len():
sh := book.sheets.get(i)
meta.sheet_names.push(sh.name)
meta.sheet_rows.push(sh.row_count())
meta.sheet_cols.push(sh.col_count())
i++
end
defer book.free()
ok = true
ret meta
end
package excel
import archive
import compress
import conv
import str
func _ods_days_from_civil(y: i64, m: i64, d: i64): i64:
mut yy := y
if m <= (2 as i64): yy-- end
mut era := 0 as i64
if yy >= (0 as i64): era = yy / (400 as i64)
else:
era = (yy - (399 as i64)) / (400 as i64)
end
yoe := yy - era * (400 as i64)
mp := (m + (9 as i64)) % (12 as i64)
doy := ((153 as i64) * mp + (2 as i64)) / (5 as i64) + d - (1 as i64)
doe := yoe * (365 as i64) + yoe / (4 as i64) - yoe / (100 as i64) + doy
ret era * (146097 as i64) + doe - (719468 as i64)
end
func _ods_parse_iso_date(s: str): i64:
if s.len() < 10: ret 0 end
year := conv.ParseIntOr(s.substr(0, 4), 0)
month := conv.ParseIntOr(s.substr(5, 2), 0)
day := conv.ParseIntOr(s.substr(8, 2), 0)
mut hour := 0 as i64
mut minute := 0 as i64
mut second := 0 as i64
if s.len() >= 19:
hour = conv.ParseIntOr(s.substr(11, 2), 0)
minute = conv.ParseIntOr(s.substr(14, 2), 0)
second = conv.ParseIntOr(s.substr(17, 2), 0)
end
days := _ods_days_from_civil(year, month, day)
ret days * (86400 as i64) + hour * (3600 as i64) + minute * (60 as i64) + second
end
func _ods_strip_formula_prefix(f: str): str:
if str.StartsWith(f, "of:="): ret f.substr(4, f.len() - 4) end
if str.StartsWith(f, "="): ret f.substr(1, f.len() - 1) end
ret f
end
func _ods_collect_text(xml: str, from: int, to_pos: int): str:
mut out := ""
mut pos := from
until true:
idx := XmlFind(xml, "text:p", pos)
if idx < 0 or idx >= to_pos: break end
if XmlSelfClosing(xml, idx):
pos = XmlTagEnd(xml, idx)
else:
cs := XmlTagEnd(xml, idx)
ce := XmlFindClose(xml, "text:p", cs)
if ce < 0 or ce > to_pos: break end
if out.len() > 0: out = out.concat("\n") end
out = out.concat(XmlUnescape(xml.substr(cs, ce - cs)))
pos = XmlTagEnd(xml, ce)
end
end
ret out
end
func _ods_align_from_str(h: str): int:
if h == "start" or h == "left": ret AlignLeft end
if h == "center": ret AlignCenter end
if h == "end" or h == "right": ret AlignRight end
ret AlignDefault
end
func _ods_strip_hash(c: str): str:
if str.StartsWith(c, "#"): ret c.substr(1, c.len() - 1) end
ret c
end
func _ods_parse_automatic_styles(xml: str): HashMap<str, Style>:
mut out := HashMap {} as HashMap<str, Style>
start := XmlFind(xml, "office:automatic-styles", 0)
if start < 0: ret out end
if XmlSelfClosing(xml, start): ret out end
cs := XmlTagEnd(xml, start)
ce := XmlFindClose(xml, "office:automatic-styles", cs)
if ce < 0: ret out end
mut pos := cs
until true:
idx := XmlFind(xml, "style:style", pos)
if idx < 0 or idx >= ce: break end
name := XmlAttr(xml, idx, "style:name")
family := XmlAttr(xml, idx, "style:family")
if XmlSelfClosing(xml, idx):
pos = XmlTagEnd(xml, idx)
else:
scs := XmlTagEnd(xml, idx)
sce := XmlFindClose(xml, "style:style", scs)
if sce < 0 or sce > ce: break end
if family == "table-cell" and name.len() > 0:
mut st := Style {}
tpidx := XmlFind(xml, "style:text-properties", scs)
if tpidx >= 0 and tpidx < sce:
if XmlAttr(xml, tpidx, "fo:font-weight") == "bold": st.bold = true end
if XmlAttr(xml, tpidx, "fo:font-style") == "italic": st.italic = true end
us := XmlAttr(xml, tpidx, "style:text-underline-style")
if us.len() > 0 and us != "none": st.underline = true end
fsz := XmlAttr(xml, tpidx, "fo:font-size")
if fsz.len() > 0:
mut numpart := fsz
if str.EndsWith(fsz, "pt"): numpart = fsz.substr(0, fsz.len() - 2) end
st.font_size = conv.ParseFloatOr(numpart, st.font_size as f64) as int
end
fc := XmlAttr(xml, tpidx, "fo:color")
if fc.len() > 0: st.font_color = _ods_strip_hash(fc) end
end
cpidx := XmlFind(xml, "style:table-cell-properties", scs)
if cpidx >= 0 and cpidx < sce:
bg := XmlAttr(xml, cpidx, "fo:background-color")
if bg.len() > 0: st.bg_color = _ods_strip_hash(bg) end
end
ppidx := XmlFind(xml, "style:paragraph-properties", scs)
if ppidx >= 0 and ppidx < sce:
align := XmlAttr(xml, ppidx, "fo:text-align")
if align.len() > 0: st.align_h = _ods_align_from_str(align) end
end
out.put(name, st)
end
pos = XmlTagEnd(xml, sce)
end
end
ret out
end
func _ods_parse_row_into(xml: str, from: int, to_pos: int, sheet &: Sheet, row: int, styles &: StyleSheet, style_by_name: HashMap<str, Style>):
mut pos := from
mut col := 0
until true:
cidx := XmlFind(xml, "table:table-cell", pos)
covidx := XmlFind(xml, "table:covered-table-cell", pos)
mut idx := cidx
mut is_covered := false
if covidx >= 0 and (cidx < 0 or covidx < cidx):
idx = covidx
is_covered = true
end
if idx < 0 or idx >= to_pos: break end
rep_str := XmlAttr(xml, idx, "table:number-columns-repeated")
mut rep := 1
if rep_str.len() > 0: rep = conv.AtoiOr(rep_str, 1) end
if rep < 1: rep = 1 end
if is_covered:
col += rep
pos = XmlTagEnd(xml, idx)
else:
if XmlSelfClosing(xml, idx):
pos = XmlTagEnd(xml, idx)
else:
vtype := XmlAttr(xml, idx, "office:value-type")
cs := XmlTagEnd(xml, idx)
ce := XmlFindClose(xml, "table:table-cell", cs)
if ce < 0 or ce > to_pos: break end
if vtype == "string":
sheet.set_string(row, col, _ods_collect_text(xml, cs, ce))
else vtype == "boolean":
bv := XmlAttr(xml, idx, "office:boolean-value")
sheet.set_bool(row, col, bv == "true")
else vtype == "date":
dv := XmlAttr(xml, idx, "office:date-value")
sheet.set_date(row, col, _ods_parse_iso_date(dv))
else vtype == "float" or vtype == "currency" or vtype == "percentage":
vv := XmlAttr(xml, idx, "office:value")
num := conv.ParseFloatOr(vv, 0.0)
formula := XmlAttr(xml, idx, "table:formula")
if formula.len() > 0:
sheet.set_formula(row, col, _ods_strip_formula_prefix(formula), num)
else:
sheet.set_number(row, col, num)
end
end
span_cols_str := XmlAttr(xml, idx, "table:number-columns-spanned")
span_rows_str := XmlAttr(xml, idx, "table:number-rows-spanned")
if span_cols_str.len() > 0 or span_rows_str.len() > 0:
mut sc := 1
mut sr := 1
if span_cols_str.len() > 0: sc = conv.AtoiOr(span_cols_str, 1) end
if span_rows_str.len() > 0: sr = conv.AtoiOr(span_rows_str, 1) end
if sc > 1 or sr > 1:
sheet.merge_cells(row, col, row + sr - 1, col + sc - 1)
end
end
sname := XmlAttr(xml, idx, "table:style-name")
if sname.len() > 0 and style_by_name.has(sname):
sid := styles.get_or_add(style_by_name.get(sname))
sheet.set_style(row, col, sid)
end
pos = XmlTagEnd(xml, ce)
end
col += rep
end
end
end
func _ods_parse_table_into(xml: str, from: int, to_pos: int, sheet &: Sheet, styles &: StyleSheet, style_by_name: HashMap<str, Style>):
mut pos := from
mut row := 0
until true:
ridx := XmlFind(xml, "table:table-row", pos)
if ridx < 0 or ridx >= to_pos: break end
rep_str := XmlAttr(xml, ridx, "table:number-rows-repeated")
mut rep := 1
if rep_str.len() > 0: rep = conv.AtoiOr(rep_str, 1) end
if rep < 1: rep = 1 end
if XmlSelfClosing(xml, ridx):
row += rep
pos = XmlTagEnd(xml, ridx)
else:
rcs := XmlTagEnd(xml, ridx)
rce := XmlFindClose(xml, "table:table-row", rcs)
if rce < 0 or rce > to_pos: break end
_ods_parse_row_into(xml, rcs, rce, sheet, row, styles, style_by_name)
row += rep
pos = XmlTagEnd(xml, rce)
end
end
end
@en "ReadODS"
@fa "خواندن اُدی‌اس"
pub func ReadODS(path: str, ok &: bool, err &: str): Workbook:
ok = false
err = ""
mut book := NewWorkbook()
mut read_ok := false
mut data := archive.ReadBinaryFile(path, read_ok)
if not read_ok:
err = "cannot open file: ".concat(path)
compress.BufFree(data)
ret book
end
mut content_ok := false
mut contentbuf := archive.ZipExtractByName(data.data, data.len, "content.xml", content_ok)
if not content_ok:
err = "not a valid .ods file (missing content.xml)"
compress.BufFree(contentbuf)
compress.BufFree(data)
ret book
end
xml := compress.BufToStrUnsafe(contentbuf)
style_by_name := _ods_parse_automatic_styles(xml)
mut pos := 0
until true:
tidx := XmlFind(xml, "table:table", pos)
if tidx < 0: break end
name := XmlAttr(xml, tidx, "table:name")
mut sh := NewSheet(name)
if XmlSelfClosing(xml, tidx):
pos = XmlTagEnd(xml, tidx)
else:
tcs := XmlTagEnd(xml, tidx)
tce := XmlFindClose(xml, "table:table", tcs)
if tce < 0:
pos = XmlTagEnd(xml, tidx)
else:
_ods_parse_table_into(xml, tcs, tce, sh, book.styles, style_by_name)
pos = XmlTagEnd(xml, tce)
end
end
book.sheets.push(sh)
end
defer style_by_name.free()
compress.BufFree(contentbuf)
compress.BufFree(data)
book.format = FormatODS
book.source_path = path
ok = true
ret book
end
package excel
import archive
import conv
import str
const _ODS_MIME := "application/vnd.oasis.opendocument.spreadsheet"
func _ods_style_name(idx: int): str:
ret "ce".concat(conv.FormatInt(idx as i64))
end
func _ods_text_props(st: Style): str:
mut out := "<style:text-properties"
if st.bold: out = out.concat(` fo:font-weight="bold"`) end
if st.italic: out = out.concat(` fo:font-style="italic"`) end
if st.underline: out = out.concat(` style:text-underline-style="solid" style:text-underline-type="single"`) end
out = out.concat(` fo:font-size="`).concat(conv.FormatInt(st.font_size as i64)).concat(`pt"`)
if st.font_color.len() > 0: out = out.concat(` fo:color="#`).concat(st.font_color).concat(`"`) end
out = out.concat("/>")
ret out
end
func _ods_align_value(h: int): str:
if h == AlignLeft: ret "start" end
if h == AlignCenter: ret "center" end
if h == AlignRight: ret "end" end
ret ""
end
func _ods_automatic_styles(styles: StyleSheet): str:
mut sb := str.NewBuilder()
defer str.BufFree(sb)
n := styles.count()
mut i := 0
until i < n:
st := styles.get(i)
str.BufAppend(sb, `<style:style style:name="`)
str.BufAppend(sb, _ods_style_name(i))
str.BufAppend(sb, `" style:family="table-cell">`)
str.BufAppend(sb, _ods_text_props(st))
if st.bg_color.len() > 0:
str.BufAppend(sb, `<style:table-cell-properties fo:background-color="#`.concat(st.bg_color).concat(`"/>`))
end
align := _ods_align_value(st.align_h)
if align.len() > 0:
str.BufAppend(sb, `<style:paragraph-properties fo:text-align="`.concat(align).concat(`"/>`))
end
str.BufAppend(sb, "</style:style>")
i++
end
out := str.BufStr(sb)
ret out
end
func _ods_cell_xml(c: Cell): str:
mut style_attr := ""
if c.style_id >= 0: style_attr = ` table:style-name="`.concat(_ods_style_name(c.style_id)).concat(`"`) end
if c.kind == CellString:
ret `<table:table-cell office:value-type="string"`.concat(style_attr).concat("><text:p>").concat(XmlEscape(c.text)).concat("</text:p></table:table-cell>")
else c.kind == CellBool:
mut bv := "false"
mut disp := "FALSE"
if c.flag:
bv = "true"
disp = "TRUE"
end
ret `<table:table-cell office:value-type="boolean" office:boolean-value="`.concat(bv).concat(`"`).concat(style_attr).concat("><text:p>").concat(disp).concat("</text:p></table:table-cell>")
else c.kind == CellDate:
epoch := SerialToEpoch(c.num)
iso := _datetime_text(epoch)
disp := _date_text(epoch)
ret `<table:table-cell office:value-type="date" office:date-value="`.concat(iso).concat(`"`).concat(style_attr).concat("><text:p>").concat(disp).concat("</text:p></table:table-cell>")
else c.kind == CellFormula:
ret `<table:table-cell table:formula="of:=`.concat(XmlEscape(c.formula)).concat(`" office:value-type="float" office:value="`).concat(conv.FormatFloat(c.num)).concat(`"`).concat(style_attr).concat("><text:p>").concat(conv.FormatFloat(c.num)).concat("</text:p></table:table-cell>")
else c.kind == CellError:
ret `<table:table-cell office:value-type="string"`.concat(style_attr).concat("><text:p>").concat(XmlEscape(c.text)).concat("</text:p></table:table-cell>")
else c.kind == CellNumber:
ret `<table:table-cell office:value-type="float" office:value="`.concat(conv.FormatFloat(c.num)).concat(`"`).concat(style_attr).concat("><text:p>").concat(conv.FormatFloat(c.num)).concat("</text:p></table:table-cell>")
else:
ret "<table:table-cell/>"
end
end
func _ods_splice_span(cellxml: str, cols: int, rows: int): str:
prefix := "<table:table-cell"
if not str.StartsWith(cellxml, prefix): ret cellxml end
rest := cellxml.substr(prefix.len(), cellxml.len() - prefix.len())
span := ` table:number-columns-spanned="`.concat(conv.FormatInt(cols as i64)).concat(`" table:number-rows-spanned="`).concat(conv.FormatInt(rows as i64)).concat(`"`)
ret prefix.concat(span).concat(rest)
end
func _ods_sheet_xml(sheet: Sheet): str:
mut sb := str.NewBuilder()
defer str.BufFree(sb)
str.BufAppend(sb, `<table:table table:name="`)
str.BufAppend(sb, XmlEscape(sheet.name))
str.BufAppend(sb, `">`)
nr := sheet.row_count()
nc := sheet.col_count()
if nc > 0:
str.BufAppend(sb, `<table:table-column table:number-columns-repeated="`)
str.BufAppendInt(sb, nc as i64)
str.BufAppend(sb, `"/>`)
end
mut r := 0
until r < nr:
str.BufAppend(sb, "<table:table-row>")
mut c := 0
until c < nc:
mut found := false
rg := sheet.merged_range(r, c, found)
if found and rg.row1 == r and rg.col1 == c:
span_cols := rg.col2 - rg.col1 + 1
span_rows := rg.row2 - rg.row1 + 1
cell := sheet.get_cell(r, c)
str.BufAppend(sb, _ods_splice_span(_ods_cell_xml(cell), span_cols, span_rows))
else found:
str.BufAppend(sb, "<table:covered-table-cell/>")
else:
if sheet.has_cell(r, c):
str.BufAppend(sb, _ods_cell_xml(sheet.get_cell(r, c)))
else:
str.BufAppend(sb, "<table:table-cell/>")
end
end
c++
end
str.BufAppend(sb, "</table:table-row>")
r++
end
str.BufAppend(sb, "</table:table>")
out := str.BufStr(sb)
ret out
end
func _ods_content_xml(book &: Workbook): str:
mut sb := str.NewBuilder()
defer str.BufFree(sb)
str.BufAppend(sb, `<?xml version="1.0" encoding="UTF-8"?><office:document-content xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:version="1.2">`)
str.BufAppend(sb, "<office:automatic-styles>")
str.BufAppend(sb, _ods_automatic_styles(book.styles))
str.BufAppend(sb, "</office:automatic-styles>")
str.BufAppend(sb, "<office:body><office:spreadsheet>")
mut i := 0
until i < book.sheets.len():
sh := book.sheets.get(i)
str.BufAppend(sb, _ods_sheet_xml(sh))
i++
end
str.BufAppend(sb, "</office:spreadsheet></office:body></office:document-content>")
out := str.BufStr(sb)
ret out
end
func _ods_manifest_xml(): str:
ret `<?xml version="1.0" encoding="UTF-8"?><manifest:manifest xmlns:manifest="urn:oasis:names:tc:opendocument:xmlns:manifest:1.0" manifest:version="1.2"><manifest:file-entry manifest:full-path="/" manifest:version="1.2" manifest:media-type="application/vnd.oasis.opendocument.spreadsheet"/><manifest:file-entry manifest:full-path="content.xml" manifest:media-type="text/xml"/></manifest:manifest>`
end
@en "WriteODS"
@fa "نوشتن اُدی‌اس"
pub func WriteODS(book &: Workbook, path: str): bool:
n := book.sheets.len()
if n == 0: ret false end
mut files := Vector {} as Vector<archive.ZipFileInput>
defer files.free()
files.push(archive.MakeZipFileInput("mimetype", _ODS_MIME as void*, _ODS_MIME.len(), 0))
manifest := _ods_manifest_xml()
files.push(archive.MakeZipFileInput("META-INF/manifest.xml", manifest as void*, manifest.len(), 8))
content := _ods_content_xml(book)
files.push(archive.MakeZipFileInput("content.xml", content as void*, content.len(), 8))
ret archive.ZipCreateFile(files, path)
end
package excel
import conv
import str
@en "MergeRange"
@fa "بازه ادغام"
pub struct MergeRange:
@en "row1"
@fa "سطر آغاز"
pub row1: int = 0
@en "col1"
@fa "ستون آغاز"
pub col1: int = 0
@en "row2"
@fa "سطر انتها"
pub row2: int = 0
@en "col2"
@fa "ستون انتها"
pub col2: int = 0
end
@en "Sheet"
@fa "برگه"
pub struct Sheet:
@en "name"
@fa "نام"
pub name: str = ""
@en "cells"
@fa "سلول‌ها"
pub cells: HashMap<str, Cell> = HashMap {} as HashMap<str, Cell>
@en "max_row"
@fa "بیشترین سطر"
pub max_row: int = -1
@en "max_col"
@fa "بیشترین ستون"
pub max_col: int = -1
@en "merges"
@fa "ادغام‌ها"
pub merges: Vector<MergeRange> = Vector {} as Vector<MergeRange>
@en "rtl"
@fa "راست‌به‌چپ"
pub rtl: bool = false
@en "freeze_rows"
@fa "سطرهای ثابت"
pub freeze_rows: int = 0
@en "freeze_cols"
@fa "ستون‌های ثابت"
pub freeze_cols: int = 0
@en "col_widths"
@fa "پهنای ستون‌ها"
pub col_widths: Vector<f64> = Vector {} as Vector<f64>
@en "auto_filter"
@fa "فیلتر خودکار"
pub auto_filter: str = ""
func _touch(row: int, col: int):
if row > this.max_row: this.max_row = row end
if col > this.max_col: this.max_col = col end
end
@en "set_string"
@fa "تنظیم رشته"
pub func set_string(row: int, col: int, value: str):
this.cells.put(_cell_key(row, col), NewStringCell(row, col, value))
this._touch(row, col)
end
@en "set_cell"
@fa "تنظیم سلول"
pub func set_cell(row: int, col: int, value: str):
this.set_string(row, col, value)
end
@en "set_number"
@fa "تنظیم عدد"
pub func set_number(row: int, col: int, value: f64):
this.cells.put(_cell_key(row, col), NewNumberCell(row, col, value))
this._touch(row, col)
end
@en "set_int"
@fa "تنظیم عدد صحیح"
pub func set_int(row: int, col: int, value: i64):
this.set_number(row, col, value as f64)
end
@en "set_bool"
@fa "تنظیم منطقی"
pub func set_bool(row: int, col: int, value: bool):
this.cells.put(_cell_key(row, col), NewBoolCell(row, col, value))
this._touch(row, col)
end
@en "set_date"
@fa "تنظیم تاریخ"
pub func set_date(row: int, col: int, epoch: i64):
this.cells.put(_cell_key(row, col), NewDateCell(row, col, epoch))
this._touch(row, col)
end
@en "set_formula"
@fa "تنظیم فرمول"
pub func set_formula(row: int, col: int, formula: str, cached: f64):
this.cells.put(_cell_key(row, col), NewFormulaCell(row, col, formula, cached))
this._touch(row, col)
end
@en "set_error"
@fa "تنظیم خطا"
pub func set_error(row: int, col: int, code: str):
c := Cell { row = row, col = col, kind = CellError, text = code }
this.cells.put(_cell_key(row, col), c)
this._touch(row, col)
end
@en "set_style"
@fa "تنظیم سبک"
pub func set_style(row: int, col: int, style_id: int):
mut c := this.get_cell(row, col)
c.style_id = style_id
this.cells.put(_cell_key(row, col), c)
this._touch(row, col)
end
@en "clear_cell"
@fa "پاک‌سازی سلول"
pub func clear_cell(row: int, col: int):
this.cells.remove(_cell_key(row, col))
end
@en "has_cell"
@fa "دارای سلول"
pub func has_cell(row: int, col: int): bool:
ret this.cells.has(_cell_key(row, col))
end
@en "get_cell"
@fa "دریافت سلول"
pub func get_cell(row: int, col: int): Cell:
key := _cell_key(row, col)
if this.cells.has(key): ret this.cells.get(key) end
ret Cell { row = row, col = col, kind = CellEmpty }
end
@en "get_string"
@fa "دریافت رشته"
pub func get_string(row: int, col: int): str:
ret _cell_display(this.get_cell(row, col))
end
@en "get_number"
@fa "دریافت عدد"
pub func get_number(row: int, col: int): f64:
c := this.get_cell(row, col)
if c.kind == CellNumber: ret c.num
else c.kind == CellDate: ret c.num
else c.kind == CellFormula: ret c.num
else c.kind == CellBool:
if c.flag: ret 1.0 end
ret 0.0
else:
ret 0.0
end
end
@en "get_bool"
@fa "دریافت منطقی"
pub func get_bool(row: int, col: int): bool:
c := this.get_cell(row, col)
if c.kind == CellBool: ret c.flag end
if c.kind == CellNumber: ret c.num != 0.0 end
ret false
end
@en "get_formula"
@fa "دریافت فرمول"
pub func get_formula(row: int, col: int): str:
ret this.get_cell(row, col).formula
end
@en "row_count"
@fa "شمار سطرها"
pub func row_count(): int: ret this.max_row + 1 end
@en "col_count"
@fa "شمار ستون‌ها"
pub func col_count(): int: ret this.max_col + 1 end
@en "set_row"
@fa "تنظیم سطر"
pub func set_row(row: int, values: Vector<str>):
mut i := 0
until i < values.len():
this.set_string(row, i, values.get(i))
i++
end
end
@en "set_column"
@fa "تنظیم ستون"
pub func set_column(col: int, values: Vector<str>):
mut i := 0
until i < values.len():
this.set_string(i, col, values.get(i))
i++
end
end
@en "set_table"
@fa "تنظیم جدول"
pub func set_table(start_row: int, start_col: int, flat: Vector<str>, num_cols: int):
if num_cols <= 0: ret end
mut i := 0
until i < flat.len():
r := start_row + i / num_cols
c := start_col + i % num_cols
this.set_string(r, c, flat.get(i))
i++
end
end
@en "get_row"
@fa "دریافت سطر"
pub func get_row(row: int): Vector<Cell>:
mut out := Vector {} as Vector<Cell>
mut c := 0
n := this.col_count()
until c < n:
out.push(this.get_cell(row, c))
c++
end
ret out
end
@en "get_column"
@fa "دریافت ستون"
pub func get_column(col: int): Vector<Cell>:
mut out := Vector {} as Vector<Cell>
mut r := 0
n := this.row_count()
until r < n:
out.push(this.get_cell(r, col))
r++
end
ret out
end
@en "get_all"
@fa "دریافت همه"
pub func get_all(): Vector<Cell>:
mut out := Vector {} as Vector<Cell>
nr := this.row_count()
nc := this.col_count()
mut r := 0
until r < nr:
mut c := 0
until c < nc:
out.push(this.get_cell(r, c))
c++
end
r++
end
ret out
end
@en "find"
@fa "جستجو"
pub func find(value: str): Vector<CellPos>:
mut out := Vector {} as Vector<CellPos>
mut it := this.cells.iter()
until it.has_next():
cell := it.value()
if _cell_display(cell) == value:
out.push(CellPos { row = cell.row, col = cell.col })
end
it.next()
end
ret out
end
@en "filter_rows_equals"
@fa "پالایش سطرها"
pub func filter_rows_equals(col: int, value: str): Vector<int>:
mut out := Vector {} as Vector<int>
mut r := 0
n := this.row_count()
until r < n:
if this.get_string(r, col) == value:
out.push(r)
end
r++
end
ret out
end
@en "merge_cells"
@fa "ادغام سلول‌ها"
pub func merge_cells(row1: int, col1: int, row2: int, col2: int):
this.merges.push(MergeRange { row1 = row1, col1 = col1, row2 = row2, col2 = col2 })
this._touch(row2, col2)
end
@en "is_merged"
@fa "ادغام‌شده است"
pub func is_merged(row: int, col: int): bool:
mut i := 0
until i < this.merges.len():
m := this.merges.get(i)
if row >= m.row1 and row <= m.row2 and col >= m.col1 and col <= m.col2:
ret true
end
i++
end
ret false
end
@en "merged_range"
@fa "بازه ادغام‌شده"
pub func merged_range(row: int, col: int, found &: bool): MergeRange:
mut i := 0
until i < this.merges.len():
m := this.merges.get(i)
if row >= m.row1 and row <= m.row2 and col >= m.col1 and col <= m.col2:
found = true
ret m
end
i++
end
found = false
ret MergeRange {}
end
@en "set_column_width"
@fa "تنظیم پهنای ستون"
pub func set_column_width(col: int, width: f64):
until this.col_widths.len() <= col:
this.col_widths.push(0.0)
end
this.col_widths.set(col, width)
end
@en "auto_fit"
@fa "پهنای خودکار"
pub func auto_fit():
mut c := 0
until c <= this.max_col:
mut longest := 0
mut r := 0
until r <= this.max_row:
if this.has_cell(r, c) and not this.is_merged(r, c):
n := str.CharCount(_cell_display(this.get_cell(r, c)))
if n > longest: longest = n end
end
r++
end
mut w := (longest as f64) * 1.2 + 2.0
if w < 6.0: w = 6.0 end
if w > 80.0: w = 80.0 end
this.set_column_width(c, w)
c++
end
end
@en "freeze"
@fa "ثابت کردن"
pub func freeze(rows: int, cols: int):
this.freeze_rows = rows
this.freeze_cols = cols
end
@en "set_auto_filter"
@fa "تنظیم فیلتر خودکار"
pub func set_auto_filter(row1: int, col1: int, row2: int, col2: int):
this.auto_filter = CellRef(row1, col1).concat(":").concat(CellRef(row2, col2))
end
@en "free"
@fa "آزادسازی"
pub func free():
this.cells.free()
this.merges.free()
this.col_widths.free()
end
end
func _cell_key(row: int, col: int): str:
ret conv.FormatInt(row as i64).concat(":").concat(conv.FormatInt(col as i64))
end
func _cell_display(c: Cell): str:
if c.kind == CellString: ret c.text
else c.kind == CellNumber: ret conv.FormatFloat(c.num)
else c.kind == CellBool: ret conv.FormatBool(c.flag)
else c.kind == CellDate: ret _date_text(SerialToEpoch(c.num))
else c.kind == CellFormula: ret conv.FormatFloat(c.num)
else c.kind == CellError: ret c.text
else:
ret ""
end
end
@en "NewSheet"
@fa "برگه جدید"
pub func NewSheet(name: str): Sheet:
ret Sheet { name = name }
end
package excel
@en "AlignDefault"
@fa "آرایش پیش‌فرض"
pub const AlignDefault := 0
@en "AlignLeft"
@fa "چپ‌چین"
pub const AlignLeft := 1
@en "AlignCenter"
@fa "میان‌چین"
pub const AlignCenter := 2
@en "AlignRight"
@fa "راست‌چین"
pub const AlignRight := 3
@en "AlignTop"
@fa "بالاچین"
pub const AlignTop := 1
@en "AlignMiddle"
@fa "میان‌چین عمودی"
pub const AlignMiddle := 2
@en "AlignBottom"
@fa "پایین‌چین"
pub const AlignBottom := 3
@en "Style"
@fa "سبک"
pub struct Style:
@en "bold"
@fa "پررنگ"
pub bold: bool = false
@en "italic"
@fa "کج"
pub italic: bool = false
@en "underline"
@fa "زیرخط"
pub underline: bool = false
@en "font_name"
@fa "نام قلم"
pub font_name: str = "Calibri"
@en "font_size"
@fa "اندازه قلم"
pub font_size: int = 11
@en "font_color"
@fa "رنگ متن"
pub font_color: str = ""
@en "bg_color"
@fa "رنگ زمینه"
pub bg_color: str = ""
@en "align_h"
@fa "چینش افقی"
pub align_h: int = 0
@en "align_v"
@fa "چینش عمودی"
pub align_v: int = 0
@en "num_format"
@fa "قالب عدد"
pub num_format: str = ""
@en "border"
@fa "کادر"
pub border: bool = false
@en "wrap"
@fa "شکستن خط"
pub wrap: bool = false
@en "equals"
@fa "یکسان است"
pub func equals(other: Style): bool:
if this.bold != other.bold: ret false end
if this.italic != other.italic: ret false end
if this.underline != other.underline: ret false end
if this.font_name != other.font_name: ret false end
if this.font_size != other.font_size: ret false end
if this.font_color != other.font_color: ret false end
if this.bg_color != other.bg_color: ret false end
if this.align_h != other.align_h: ret false end
if this.align_v != other.align_v: ret false end
if this.num_format != other.num_format: ret false end
if this.border != other.border: ret false end
if this.wrap != other.wrap: ret false end
ret true
end
end
@en "StyleSheet"
@fa "جدول سبک‌ها"
pub struct StyleSheet:
@en "styles"
@fa "سبک‌ها"
pub styles: Vector<Style> = Vector {} as Vector<Style>
@en "get_or_add"
@fa "دریافت با افزودن"
pub func get_or_add(s: Style): int:
mut i := 0
until i < this.styles.len():
if this.styles.get(i).equals(s):
ret i
end
i++
end
this.styles.push(s)
ret this.styles.len() - 1
end
@en "get"
@fa "دریافت"
pub func get(id: int): Style:
if id < 0 or id >= this.styles.len(): ret Style {} end
ret this.styles.get(id)
end
@en "count"
@fa "شمار"
pub func count(): int: ret this.styles.len() end
@en "free"
@fa "آزادسازی"
pub func free(): this.styles.free() end
end
@en "NewStyleSheet"
@fa "جدول سبک جدید"
pub func NewStyleSheet(): StyleSheet:
mut ss := StyleSheet {}
ss.styles.push(Style {})
ret ss
end
package excel
@en "Workbook"
@fa "کتاب کار"
pub struct Workbook:
@en "sheets"
@fa "برگه‌ها"
pub sheets: Vector<Sheet> = Vector {} as Vector<Sheet>
@en "styles"
@fa "سبک‌ها"
pub styles: StyleSheet = StyleSheet {}
@en "active_sheet"
@fa "شماره برگه فعال"
pub active_sheet: int = 0
@en "source_path"
@fa "مسیر منبع"
pub source_path: str = ""
@en "format"
@fa "قالب"
pub format: int = 0
@en "last_error"
@fa "آخرین خطا"
pub last_error: str = ""
@en "add_sheet"
@fa "افزودن برگه"
pub func add_sheet(name: str): Sheet*:
this.sheets.push(NewSheet(name))
ret this.sheets.ref(this.sheets.len() - 1)
end
@en "remove_sheet"
@fa "حذف برگه"
pub func remove_sheet(idx: int): bool:
if idx < 0 or idx >= this.sheets.len(): ret false end
this.sheets.ref(idx)[0].free()
this.sheets.remove_at(idx)
if this.active_sheet >= this.sheets.len():
this.active_sheet = this.sheets.len() - 1
end
ret true
end
@en "remove_sheet_named"
@fa "حذف برگه با نام"
pub func remove_sheet_named(name: str): bool:
idx := this.sheet_index(name)
if idx < 0: ret false end
ret this.remove_sheet(idx)
end
@en "rename_sheet"
@fa "تغییر نام برگه"
pub func rename_sheet(idx: int, new_name: str): bool:
if idx < 0 or idx >= this.sheets.len(): ret false end
p := this.sheets.ref(idx)
p[0].name = new_name
ret true
end
@en "sheet_index"
@fa "اندیس برگه"
pub func sheet_index(name: str): int:
mut i := 0
until i < this.sheets.len():
if this.sheets.get(i).name == name: ret i end
i++
end
ret -1
end
@en "sheet_count"
@fa "شمار برگه‌ها"
pub func sheet_count(): int: ret this.sheets.len() end
@en "sheet_names"
@fa "نام برگه‌ها"
pub func sheet_names(): Vector<str>:
mut out := Vector {} as Vector<str>
mut i := 0
until i < this.sheets.len():
out.push(this.sheets.get(i).name)
i++
end
ret out
end
@en "sheet_at"
@fa "برگه در"
pub func sheet_at(idx: int): Sheet*:
if idx < 0 or idx >= this.sheets.len(): ret null end
ret this.sheets.ref(idx)
end
@en "sheet"
@fa "برگه"
pub func sheet(name: str): Sheet*:
ret this.sheet_at(this.sheet_index(name))
end
@en "active"
@fa "برگه فعال"
pub func active(): Sheet*:
ret this.sheet_at(this.active_sheet)
end
@en "set_active"
@fa "تنظیم برگه فعال"
pub func set_active(idx: int): bool:
if idx < 0 or idx >= this.sheets.len(): ret false end
this.active_sheet = idx
ret true
end
@en "save"
@fa "ذخیره"
pub func save(path: str): bool:
ret Save(this[0], path)
end
@en "free"
@fa "آزادسازی"
pub func free():
mut i := 0
until i < this.sheets.len():
this.sheets.ref(i)[0].free()
i++
end
this.sheets.free()
this.styles.free()
end
end
@en "NewWorkbook"
@fa "کتاب کار جدید"
pub func NewWorkbook(): Workbook:
ret Workbook {}
end
package excel
import archive
import compress
import conv
import mem
import str
const _XL_ENDCHAIN := 4294967294 as i64
const _XL_FREE := 4294967295 as i64
const _XL_MINI_CUTOFF_DEFAULT := 4096
struct _OleEntry:
pub name: str = ""
pub kind: int = 0
pub start: i64 = 0
pub size: i64 = 0
end
struct _BiffSheet:
pub name: str = ""
pub offset: i64 = 0
end
struct _SstReader:
pub data: void* = null
pub starts: Vector<int> = Vector {}
pub lens: Vector<int> = Vector {}
pub seg: int = 0
pub pos: int = 0
end
inline func _xl_u8(p: void*, i: int): int:
bp := p as u8*
ret bp[i] as int
end
func _xl_u16(p: void*, i: int): int:
ret _xl_u8(p, i) | (_xl_u8(p, i + 1) << 8)
end
func _xl_u32(p: void*, i: int): i64:
ret (_xl_u8(p, i) as i64) | ((_xl_u8(p, i + 1) as i64) << 8) | ((_xl_u8(p, i + 2) as i64) << 16) | ((_xl_u8(p, i + 3) as i64) << 24)
end
func _xl_f64(p: void*, i: int): f64:
bits := (_xl_u32(p, i) | (_xl_u32(p, i + 4) << 32))
buf := mem.Allocate(8 as u64)
q := buf as i64*
q[0] = bits
d := buf as f64*
v := d[0]
mem.Free(buf)
ret v
end
func _xl_bits_f64(bits: i64): f64:
buf := mem.Allocate(8 as u64)
q := buf as i64*
q[0] = bits
d := buf as f64*
v := d[0]
mem.Free(buf)
ret v
end
func _xl_utf16_name(p: void*, off: int, chars: int): str:
mut sb := str.NewBuilder()
defer str.BufFree(sb)
mut i := 0
until i < chars:
cp := _xl_u16(p, off + i * 2)
if cp == 0: break end
if cp < 128:
str.BufAppendChar(sb, cp)
else:
str.BufAppendChar(sb, 63)
end
i++
end
ret str.BufStr(sb)
end
func _xl_chain(fat: Vector<i64>, start: i64, limit: int): Vector<i64>:
mut out := Vector {} as Vector<i64>
mut sec := start
mut guard := 0
until sec >= 0 and sec != _XL_ENDCHAIN and sec != _XL_FREE and guard <= limit:
out.push(sec)
if sec >= fat.len() as i64: break end
sec = fat.get(sec as int)
guard++
end
ret out
end
func _xl_sector_ok(off: i64, size: int, n: int): bool:
ret off >= 0 and off + (size as i64) <= (n as i64)
end
func _xl_read_fat(data: void*, n: int, sector_size: int, first_difat: i64, num_difat: int): Vector<i64>:
mut fat := Vector {} as Vector<i64>
mut difat := Vector {} as Vector<i64>
mut i := 0
until i < 109:
s := _xl_u32(data, 76 + i * 4)
if s != _XL_FREE and s != _XL_ENDCHAIN: difat.push(s) end
i++
end
mut sec := first_difat
mut guard := 0
per := sector_size / 4 - 1
until sec < 0 or sec == _XL_ENDCHAIN or sec == _XL_FREE or guard > num_difat + 4:
off := (sec + 1) * (sector_size as i64)
if not _xl_sector_ok(off, sector_size, n): break end
mut k := 0
until k < per:
s := _xl_u32(data, (off + (k as i64) * 4) as int)
if s != _XL_FREE and s != _XL_ENDCHAIN: difat.push(s) end
k++
end
sec = _xl_u32(data, (off + (per as i64) * 4) as int)
guard++
end
mut fi := 0
until fi < difat.len():
off := (difat.get(fi) + 1) * (sector_size as i64)
if _xl_sector_ok(off, sector_size, n):
mut k := 0
until k < sector_size / 4:
fat.push(_xl_u32(data, (off + (k as i64) * 4) as int))
k++
end
end
fi++
end
difat.free()
ret fat
end
func _xl_read_dir(data: void*, n: int, fat: Vector<i64>, first_dir: i64, sector_size: int): Vector<_OleEntry>:
mut out := Vector {} as Vector<_OleEntry>
chain := _xl_chain(fat, first_dir, fat.len() + 4)
mut ci := 0
until ci < chain.len():
off := (chain.get(ci) + 1) * (sector_size as i64)
if not _xl_sector_ok(off, sector_size, n): break end
mut e := 0
until e < sector_size / 128:
base := (off + (e as i64) * 128) as int
name_len := _xl_u16(data, base + 64)
mut entry := _OleEntry {}
if name_len >= 2 and name_len <= 64:
entry.name = _xl_utf16_name(data, base, name_len / 2 - 1)
end
entry.kind = _xl_u8(data, base + 66)
entry.start = _xl_u32(data, base + 116)
entry.size = _xl_u32(data, base + 120)
if entry.kind != 0:
out.push(entry)
end
e++
end
ci++
end
chain.free()
ret out
end
func _xl_find_entry(entries: Vector<_OleEntry>, name: str): int:
mut i := 0
until i < entries.len():
if entries.get(i).name == name: ret i end
i++
end
ret -1
end
func _xl_read_chain(data: void*, n: int, fat: Vector<i64>, start: i64, size: i64, sector_size: int): compress.ByteBuf:
mut out := compress.NewByteBufCap(size as int)
if size <= 0: ret out end
chain := _xl_chain(fat, start, fat.len() + 4)
mut left := size
mut ci := 0
until ci < chain.len() and left > 0:
off := (chain.get(ci) + 1) * (sector_size as i64)
if not _xl_sector_ok(off, sector_size, n): break end
mut take := sector_size as i64
if take > left: take = left end
compress.BufPushBytes(out, ((data as i64) + off) as void*, take as int)
left -= take
ci++
end
chain.free()
ret out
end
func _xl_read_mini(mini_fat: Vector<i64>, mini_stream: compress.ByteBuf, start: i64, size: i64, mini_size: int): compress.ByteBuf:
mut out := compress.NewByteBufCap(size as int)
if size <= 0: ret out end
chain := _xl_chain(mini_fat, start, mini_fat.len() + 4)
mut left := size
mut ci := 0
until ci < chain.len() and left > 0:
off := chain.get(ci) * (mini_size as i64)
if off < 0 or off + (mini_size as i64) > (mini_stream.len as i64): break end
mut take := mini_size as i64
if take > left: take = left end
compress.BufPushBytes(out, ((mini_stream.data as i64) + off) as void*, take as int)
left -= take
ci++
end
chain.free()
ret out
end
func _xl_read_mini_fat(data: void*, n: int, fat: Vector<i64>, first_mini_fat: i64, num_mini_fat: int, sector_size: int): Vector<i64>:
mut out := Vector {} as Vector<i64>
chain := _xl_chain(fat, first_mini_fat, fat.len() + 4)
mut ci := 0
until ci < chain.len():
off := (chain.get(ci) + 1) * (sector_size as i64)
if not _xl_sector_ok(off, sector_size, n): break end
mut k := 0
until k < sector_size / 4:
out.push(_xl_u32(data, (off + (k as i64) * 4) as int))
k++
end
ci++
end
chain.free()
_unused := num_mini_fat
ret out
end
func _xl_stream_of(data: void*, n: int, fat: Vector<i64>, entries: Vector<_OleEntry>, which: int, sector_size: int, cutoff: int, mini_fat: Vector<i64>, mini_stream: compress.ByteBuf, mini_size: int): compress.ByteBuf:
e := entries.get(which)
if e.size < (cutoff as i64) and e.kind == 2:
ret _xl_read_mini(mini_fat, mini_stream, e.start, e.size, mini_size)
end
ret _xl_read_chain(data, n, fat, e.start, e.size, sector_size)
end
func _xl_biff_string(p: void*, n: int, off: int, next &: int): str:
if off + 3 > n: ret "" end
cch := _xl_u16(p, off)
flags := _xl_u8(p, off + 2)
mut o := off + 3
mut runs := 0
mut ext := 0
if (flags & 8) != 0:
if o + 2 > n: ret "" end
runs = _xl_u16(p, o)
o += 2
end
if (flags & 4) != 0:
if o + 4 > n: ret "" end
ext = _xl_u32(p, o) as int
o += 4
end
wide := (flags & 1) != 0
mut sb := str.NewBuilder()
defer str.BufFree(sb)
mut i := 0
until i < cch:
if wide:
if o + 2 > n: break end
str.BufAppendCp(sb, _xl_u16(p, o))
o += 2
else:
if o + 1 > n: break end
str.BufAppendChar(sb, _xl_u8(p, o))
o++
end
i++
end
next = o + runs * 4 + ext
ret str.BufStr(sb)
end
func _sst_fix(s &: _SstReader):
until s.seg < s.starts.len() and s.pos >= s.lens.get(s.seg):
if s.seg >= s.starts.len(): ret end
s.seg++
s.pos = 0
end
end
func _sst_u8(s &: _SstReader): int:
_sst_fix(s)
if s.seg >= s.starts.len(): ret 0 end
v := _xl_u8(s.data, s.starts.get(s.seg) + s.pos)
s.pos++
ret v
end
func _sst_u16(s &: _SstReader): int:
ret _sst_u8(s) | (_sst_u8(s) << 8)
end
func _sst_u32(s &: _SstReader): int:
ret _sst_u8(s) | (_sst_u8(s) << 8) | (_sst_u8(s) << 16) | (_sst_u8(s) << 24)
end
func _sst_skip(s &: _SstReader, count: int):
mut left := count
until left > 0:
_sst_fix(s)
if s.seg >= s.starts.len(): ret end
avail := s.lens.get(s.seg) - s.pos
if avail <= 0:
s.seg++
s.pos = 0
continue
end
mut take := avail
if take > left: take = left end
s.pos += take
left -= take
end
end
func _sst_string(s &: _SstReader): str:
cch := _sst_u16(s)
flags := _sst_u8(s)
mut wide := (flags & 1) != 0
mut runs := 0
mut ext := 0
if (flags & 8) != 0: runs = _sst_u16(s) end
if (flags & 4) != 0: ext = _sst_u32(s) end
mut sb := str.NewBuilder()
defer str.BufFree(sb)
mut i := 0
until i < cch:
_sst_fix(s)
if s.seg >= s.starts.len(): break end
if s.pos >= s.lens.get(s.seg):
s.seg++
s.pos = 0
if s.seg >= s.starts.len(): break end
nf := _sst_u8(s)
wide = (nf & 1) != 0
end
if wide:
if s.pos + 2 > s.lens.get(s.seg):
cp := _sst_u8(s)
str.BufAppendChar(sb, cp)
else:
str.BufAppendCp(sb, _sst_u16(s))
end
else:
str.BufAppendChar(sb, _sst_u8(s))
end
i++
end
_sst_skip(s, runs * 4 + ext)
ret str.BufStr(sb)
end
func _xls_builtin_date(id: int): bool:
if id >= 14 and id <= 22: ret true end
if id >= 45 and id <= 47: ret true end
ret false
end
func _xls_format_date(code: str): bool:
if code.len() == 0: ret false end
lc := code.lower()
if str.Contains(lc, "y") or str.Contains(lc, "d") or str.Contains(lc, "h") or str.Contains(lc, "s"): ret true end
if str.Contains(lc, "mmm"): ret true end
ret false
end
func _xls_error_text(code: int): str:
if code == 0x00: ret "#NULL!" end
if code == 0x07: ret "#DIV/0!" end
if code == 0x0f: ret "#VALUE!" end
if code == 0x17: ret "#REF!" end
if code == 0x1d: ret "#NAME?" end
if code == 0x24: ret "#NUM!" end
if code == 0x2a: ret "#N/A" end
ret "#ERR"
end
func _xls_put(sheet &: Sheet, c: Cell):
sheet.cells.put(_cell_key(c.row, c.col), c)
if c.row > sheet.max_row: sheet.max_row = c.row end
if c.col > sheet.max_col: sheet.max_col = c.col end
end
func _xls_rk(raw: i64): f64:
rk := raw as int
mut v := 0.0
if (rk & 2) != 0:
v = ((rk >> 2) as f64)
else:
v = _xl_bits_f64((rk & (0 - 4)) as i64)
end
if (rk & 1) != 0: v /= 100.0 end
ret v
end
func _xls_cell_kind(sheet &: Sheet, row: int, col: int, xf: int, date_flags: Vector<bool>, date1904: bool, value: Cell):
mut c := value
c.row = row
c.col = col
c.style_id = xf
if c.kind == CellNumber and xf >= 0 and xf < date_flags.len() and date_flags.get(xf):
c.kind = CellDate
if date1904: c.num += 1462.0 end
end
_xls_put(sheet, c)
end
func _xls_sheet_into(p: void*, n: int, offset: int, sheet &: Sheet, sst: Vector<str>, date_flags: Vector<bool>, date1904: bool, err &: str):
if offset < 0 or offset + 8 > n:
err = "the sheet starts outside the workbook stream"
ret
end
if _xl_u16(p, offset) != 0x0809:
err = "missing the sheet start record"
ret
end
mut pos := offset + 4 + _xl_u16(p, offset + 2) as int
mut pending_row := 0 - 1
mut pending_col := 0
mut pending_xf := 0
until pos + 4 <= n:
id := _xl_u16(p, pos)
len := _xl_u16(p, pos + 2)
body := pos + 4
if body + len > n: break end
if id == 0x000a: break end
if id == 0x00fd and len >= 10:
row := _xl_u16(p, body)
col := _xl_u16(p, body + 2)
xf := _xl_u16(p, body + 4)
idx := _xl_u32(p, body + 6) as int
if idx >= 0 and idx < sst.len():
_xls_cell_kind(sheet, row, col, xf, date_flags, date1904, NewStringCell(row, col, sst.get(idx)))
end
else id == 0x0204 and len >= 6:
row := _xl_u16(p, body)
col := _xl_u16(p, body + 2)
xf := _xl_u16(p, body + 4)
mut next := 0
text := _xl_biff_string(p, body + len, body + 6, next)
_xls_cell_kind(sheet, row, col, xf, date_flags, date1904, NewStringCell(row, col, text))
else id == 0x0203 and len >= 14:
row := _xl_u16(p, body)
col := _xl_u16(p, body + 2)
xf := _xl_u16(p, body + 4)
_xls_cell_kind(sheet, row, col, xf, date_flags, date1904, NewNumberCell(row, col, _xl_f64(p, body + 6)))
else id == 0x027e and len >= 10:
row := _xl_u16(p, body)
col := _xl_u16(p, body + 2)
xf := _xl_u16(p, body + 4)
_xls_cell_kind(sheet, row, col, xf, date_flags, date1904, NewNumberCell(row, col, _xls_rk(_xl_u32(p, body + 6))))
else id == 0x00bd and len >= 12:
row := _xl_u16(p, body)
first := _xl_u16(p, body + 2)
mut off := body + 4
mut ci := 0
until off + 6 <= body + len - 2:
xf := _xl_u16(p, off)
_xls_cell_kind(sheet, row, first + ci, xf, date_flags, date1904, NewNumberCell(row, first + ci, _xls_rk(_xl_u32(p, off + 2))))
off += 6
ci++
end
else id == 0x0205 and len >= 8:
row := _xl_u16(p, body)
col := _xl_u16(p, body + 2)
xf := _xl_u16(p, body + 4)
val := _xl_u8(p, body + 6)
is_err := _xl_u8(p, body + 7)
if is_err != 0:
_xls_put(sheet, Cell { row = row, col = col, kind = CellError, text = _xls_error_text(val), style_id = xf })
else:
_xls_cell_kind(sheet, row, col, xf, date_flags, date1904, NewBoolCell(row, col, val != 0))
end
else id == 0x0006 and len >= 14:
row := _xl_u16(p, body)
col := _xl_u16(p, body + 2)
xf := _xl_u16(p, body + 4)
if _xl_u16(p, body + 12) == 0xffff:
kind := _xl_u8(p, body + 6)
if kind == 0:
pending_row = row
pending_col = col
pending_xf = xf
else kind == 1:
_xls_cell_kind(sheet, row, col, xf, date_flags, date1904, NewBoolCell(row, col, _xl_u8(p, body + 8) != 0))
else kind == 2:
_xls_put(sheet, Cell { row = row, col = col, kind = CellError, text = _xls_error_text(_xl_u8(p, body + 8)), style_id = xf })
end
else:
_xls_cell_kind(sheet, row, col, xf, date_flags, date1904, NewNumberCell(row, col, _xl_f64(p, body + 6)))
end
else id == 0x0207 and len >= 3 and pending_row >= 0:
mut next := 0
text := _xl_biff_string(p, body + len, body, next)
_xls_cell_kind(sheet, pending_row, pending_col, pending_xf, date_flags, date1904, NewStringCell(pending_row, pending_col, text))
pending_row = 0 - 1
else id == 0x00e5 and len >= 2:
count := _xl_u16(p, body)
mut k := 0
mut off := body + 2
until k < count and off + 8 <= body + len:
r1 := _xl_u16(p, off)
r2 := _xl_u16(p, off + 2)
c1 := _xl_u16(p, off + 4)
c2 := _xl_u16(p, off + 6)
sheet.merge_cells(r1, c1, r2, c2)
off += 8
k++
end
end
pos = body + len
end
end
func _xl_bound_sheet_name(p: void*, body: int, len: int): str:
if len < 8: ret "" end
cch := _xl_u8(p, body + 6)
flags := _xl_u8(p, body + 7)
if (flags & 1) != 0:
ret _xl_utf16_name(p, body + 8, cch)
end
mut sb := str.NewBuilder()
defer str.BufFree(sb)
mut i := 0
until i < cch and 8 + i < len:
str.BufAppendChar(sb, _xl_u8(p, body + 8 + i))
i++
end
ret str.BufStr(sb)
end
func _xl_globals(p: void*, n: int, sheets &: Vector<_BiffSheet>, sst &: Vector<str>, xf_fmt &: Vector<int>, formats &: HashMap<int, str>, date1904 &: bool, err &: str):
if n < 8 or _xl_u16(p, 0) != 0x0809:
err = "not a BIFF workbook stream"
ret
end
if _xl_u16(p, 4) != 0x0600:
err = "only BIFF8 .xls workbooks are supported"
ret
end
mut pos := 4 + _xl_u16(p, 2) as int
until pos + 4 <= n:
id := _xl_u16(p, pos)
len := _xl_u16(p, pos + 2)
body := pos + 4
if body + len > n: break end
if id == 0x000a: break end
if id == 0x0085 and len >= 8:
off := _xl_u32(p, body)
name := _xl_bound_sheet_name(p, body, len)
sheets.push(_BiffSheet { name = name, offset = off })
else id == 0x00e0 and len >= 4:
xf_fmt.push(_xl_u16(p, body + 2))
else id == 0x041e and len >= 4:
ifmt := _xl_u16(p, body)
mut next := 0
text := _xl_biff_string(p, body + len, body + 2, next)
formats.put(ifmt, text)
else id == 0x0022 and len >= 2:
date1904 = _xl_u16(p, body) != 0
else id == 0x00fc and len >= 8:
total := _xl_u32(p, body)
unique := _xl_u32(p, body + 4) as int
mut reader := _SstReader { data = p }
reader.starts.push(body)
reader.lens.push(len)
mut q := body + len
until q + 4 <= n:
nid := _xl_u16(p, q)
nlen := _xl_u16(p, q + 2)
if nid != 0x003c or q + 4 + nlen > n: break end
reader.starts.push(q + 4)
reader.lens.push(nlen)
q += 4 + nlen
end
_sst_skip(reader, 8)
mut i := 0
until i < unique:
sst.push(_sst_string(reader))
i++
end
reader.starts.free()
reader.lens.free()
_unused := total
pos = q
continue
end
pos = body + len
end
end
func _ole2_sig_match(p: void*, n: int): bool:
if n < 8: ret false end
bp := p as u8*
ret bp[0] as int == 0xd0 and bp[1] as int == 0xcf and bp[2] as int == 0x11 and bp[3] as int == 0xe0 and bp[4] as int == 0xa1 and bp[5] as int == 0xb1 and bp[6] as int == 0x1a and bp[7] as int == 0xe1
end
@en "IsXLS"
@fa "ایکس‌ال‌اس است"
pub func IsXLS(p: void*, n: int): bool:
ret _ole2_sig_match(p, n)
end
@en "ReadXLS"
@fa "خواندن ایکس‌ال‌اس"
pub func ReadXLS(path: str, ok &: bool, err &: str): Workbook:
ok = false
err = ""
mut book := NewWorkbook()
mut read_ok := false
mut data := archive.ReadBinaryFile(path, read_ok)
if not read_ok:
err = "cannot open file: " + path
compress.BufFree(data)
ret book
end
p := data.data
n := data.len
if not _ole2_sig_match(p, n):
err = "not a legacy .xls file (missing the OLE2 signature)"
compress.BufFree(data)
ret book
end
sector_size := 1 << _xl_u16(p, 30)
if sector_size < 128 or sector_size > 65536:
err = "the OLE2 sector size is invalid"
compress.BufFree(data)
ret book
end
mut mini_size := 1 << _xl_u16(p, 32)
if mini_size < 8 or mini_size > 4096: mini_size = 64 end
first_dir := _xl_u32(p, 48)
mut cutoff := _xl_u32(p, 56) as int
if cutoff <= 0: cutoff = _XL_MINI_CUTOFF_DEFAULT end
first_mini := _xl_u32(p, 60)
num_mini := _xl_u32(p, 64) as int
first_difat := _xl_u32(p, 68)
num_difat := _xl_u32(p, 72) as int
mut fat := _xl_read_fat(p, n, sector_size, first_difat, num_difat)
if fat.len() == 0:
err = "the .xls file has no allocation table"
fat.free()
compress.BufFree(data)
ret book
end
mut entries := _xl_read_dir(p, n, fat, first_dir, sector_size)
if entries.len() == 0:
err = "the .xls file has no directory"
entries.free()
fat.free()
compress.BufFree(data)
ret book
end
mut mini_stream := compress.NewByteBuf()
root := _xl_find_entry(entries, "Root Entry")
if root >= 0:
mini_stream = _xl_read_chain(p, n, fat, entries.get(root).start, entries.get(root).size, sector_size)
end
mut mini_fat := _xl_read_mini_fat(p, n, fat, first_mini, num_mini, sector_size)
mut wb := _xl_find_entry(entries, "Workbook")
if wb < 0: wb = _xl_find_entry(entries, "Book") end
if wb < 0:
err = "the .xls file has no Workbook stream"
mini_fat.free()
compress.BufFree(mini_stream)
entries.free()
fat.free()
compress.BufFree(data)
ret book
end
mut stream := _xl_stream_of(p, n, fat, entries, wb, sector_size, cutoff, mini_fat, mini_stream, mini_size)
mut sheets := Vector {} as Vector<_BiffSheet>
mut sst := Vector {} as Vector<str>
mut xf_fmt := Vector {} as Vector<int>
mut formats := HashMap {} as HashMap<int, str>
mut date1904 := false
_xl_globals(stream.data, stream.len, sheets, sst, xf_fmt, formats, date1904, err)
if err != "":
formats.free()
xf_fmt.free()
sst.free()
sheets.free()
compress.BufFree(stream)
mini_fat.free()
compress.BufFree(mini_stream)
entries.free()
fat.free()
compress.BufFree(data)
ret book
end
mut date_flags := Vector {} as Vector<bool>
mut xi := 0
until xi < xf_fmt.len():
fid := xf_fmt.get(xi)
mut is_date := _xls_builtin_date(fid)
if not is_date and formats.has(fid): is_date = _xls_format_date(formats.get(fid)) end
date_flags.push(is_date)
xi++
end
mut si := 0
until si < sheets.len():
mut sh := NewSheet(sheets.get(si).name)
mut sheet_err := ""
_xls_sheet_into(stream.data, stream.len, sheets.get(si).offset as int, sh, sst, date_flags, date1904, sheet_err)
if sheet_err == "": book.sheets.push(sh) end
si++
end
book.format = FormatXLS
book.source_path = path
book.active_sheet = 0
ok = true
date_flags.free()
formats.free()
xf_fmt.free()
sst.free()
sheets.free()
compress.BufFree(stream)
mini_fat.free()
compress.BufFree(mini_stream)
entries.free()
fat.free()
compress.BufFree(data)
ret book
end
package excel
import archive
import compress
import conv
import str
func _xlsx_resolve_target(target: str): str:
if str.StartsWith(target, "/"):
ret target.substr(1, target.len() - 1)
end
ret "xl/".concat(target)
end
func _xlsx_parse_rels(xml: str): HashMap<str, str>:
mut out := HashMap {} as HashMap<str, str>
mut pos := 0
until true:
idx := XmlFind(xml, "Relationship", pos)
if idx < 0: break end
id := XmlAttr(xml, idx, "Id")
target := XmlAttr(xml, idx, "Target")
if id.len() > 0:
out.put(id, target)
end
pos = XmlTagEnd(xml, idx)
end
ret out
end
func _xlsx_collect_text(body: str): str:
mut out := ""
mut pos := 0
until true:
idx := XmlFind(body, "t", pos)
if idx < 0: break end
if XmlSelfClosing(body, idx):
pos = XmlTagEnd(body, idx)
else:
cs := XmlTagEnd(body, idx)
ce := XmlFindClose(body, "t", cs)
if ce < 0: break end
out = out.concat(XmlUnescape(body.substr(cs, ce - cs)))
pos = XmlTagEnd(body, ce)
end
end
ret out
end
func _xlsx_parse_shared_strings(xml: str): Vector<str>:
mut out := Vector {} as Vector<str>
mut pos := 0
until true:
idx := XmlFind(xml, "si", pos)
if idx < 0: break end
if XmlSelfClosing(xml, idx):
out.push("")
pos = XmlTagEnd(xml, idx)
else:
cs := XmlTagEnd(xml, idx)
ce := XmlFindClose(xml, "si", cs)
if ce < 0: break end
out.push(_xlsx_collect_text(xml.substr(cs, ce - cs)))
pos = XmlTagEnd(xml, ce)
end
end
ret out
end
func _xlsx_parse_numfmts(xml: str): HashMap<int, str>:
mut out := HashMap {} as HashMap<int, str>
start := XmlFind(xml, "numFmts", 0)
if start < 0: ret out end
if XmlSelfClosing(xml, start): ret out end
cs := XmlTagEnd(xml, start)
ce := XmlFindClose(xml, "numFmts", cs)
if ce < 0: ret out end
mut pos := cs
until true:
idx := XmlFind(xml, "numFmt", pos)
if idx < 0 or idx >= ce: break end
id_str := XmlAttr(xml, idx, "numFmtId")
code := XmlAttr(xml, idx, "formatCode")
fid := conv.AtoiOr(id_str, 0 - 1)
if fid >= 0:
out.put(fid, code)
end
pos = XmlTagEnd(xml, idx)
end
ret out
end
func _xlsx_builtin_is_date(id: int): bool:
if id >= 14 and id <= 22: ret true end
if id >= 45 and id <= 47: ret true end
ret false
end
func _xlsx_code_looks_like_date(code: str): bool:
if code.len() == 0: ret false end
lc := code.lower()
if str.Contains(lc, "y") or str.Contains(lc, "d") or str.Contains(lc, "h"): ret true end
ret false
end
func _xlsx_parse_cellxfs_date_flags(xml: str, numfmt_codes: HashMap<int, str>): Vector<bool>:
mut out := Vector {} as Vector<bool>
xfs_start := XmlFind(xml, "cellXfs", 0)
if xfs_start < 0: ret out end
if XmlSelfClosing(xml, xfs_start): ret out end
cs := XmlTagEnd(xml, xfs_start)
ce := XmlFindClose(xml, "cellXfs", cs)
if ce < 0: ret out end
mut pos := cs
until true:
idx := XmlFind(xml, "xf", pos)
if idx < 0 or idx >= ce: break end
id_str := XmlAttr(xml, idx, "numFmtId")
mut is_date := false
if id_str.len() > 0:
fid := conv.AtoiOr(id_str, 0 - 1)
if _xlsx_builtin_is_date(fid):
is_date = true
else numfmt_codes.has(fid):
is_date = _xlsx_code_looks_like_date(numfmt_codes.get(fid))
end
end
out.push(is_date)
pos = XmlTagEnd(xml, idx)
end
ret out
end
func _xlsx_parse_fonts(xml: str): Vector<Style>:
mut out := Vector {} as Vector<Style>
start := XmlFind(xml, "fonts", 0)
if start < 0: ret out end
if XmlSelfClosing(xml, start): ret out end
cs := XmlTagEnd(xml, start)
ce := XmlFindClose(xml, "fonts", cs)
if ce < 0: ret out end
mut pos := cs
until true:
idx := XmlFind(xml, "font", pos)
if idx < 0 or idx >= ce: break end
if XmlSelfClosing(xml, idx):
out.push(Style {})
pos = XmlTagEnd(xml, idx)
else:
fcs := XmlTagEnd(xml, idx)
fce := XmlFindClose(xml, "font", fcs)
if fce < 0 or fce > ce: break end
mut st := Style {}
bidx := XmlFind(xml, "b", fcs)
if bidx >= 0 and bidx < fce: st.bold = true end
iidx := XmlFind(xml, "i", fcs)
if iidx >= 0 and iidx < fce: st.italic = true end
uidx := XmlFind(xml, "u", fcs)
if uidx >= 0 and uidx < fce: st.underline = true end
szidx := XmlFind(xml, "sz", fcs)
if szidx >= 0 and szidx < fce:
szv := XmlAttr(xml, szidx, "val")
if szv.len() > 0: st.font_size = conv.ParseFloatOr(szv, st.font_size as f64) as int end
end
coloridx := XmlFind(xml, "color", fcs)
if coloridx >= 0 and coloridx < fce:
rgb := XmlAttr(xml, coloridx, "rgb")
if rgb.len() == 8: st.font_color = rgb.substr(2, 6)
else rgb.len() == 6: st.font_color = rgb
end
end
nameidx := XmlFind(xml, "name", fcs)
if nameidx >= 0 and nameidx < fce:
nv := XmlAttr(xml, nameidx, "val")
if nv.len() > 0: st.font_name = nv end
end
out.push(st)
pos = XmlTagEnd(xml, fce)
end
end
ret out
end
func _xlsx_parse_fills(xml: str): Vector<str>:
mut out := Vector {} as Vector<str>
start := XmlFind(xml, "fills", 0)
if start < 0: ret out end
if XmlSelfClosing(xml, start): ret out end
cs := XmlTagEnd(xml, start)
ce := XmlFindClose(xml, "fills", cs)
if ce < 0: ret out end
mut pos := cs
until true:
idx := XmlFind(xml, "fill", pos)
if idx < 0 or idx >= ce: break end
if XmlSelfClosing(xml, idx):
out.push("")
pos = XmlTagEnd(xml, idx)
else:
fcs := XmlTagEnd(xml, idx)
fce := XmlFindClose(xml, "fill", fcs)
if fce < 0 or fce > ce: break end
mut bg := ""
fgidx := XmlFind(xml, "fgColor", fcs)
if fgidx >= 0 and fgidx < fce:
rgb := XmlAttr(xml, fgidx, "rgb")
if rgb.len() == 8: bg = rgb.substr(2, 6)
else rgb.len() == 6: bg = rgb
end
end
out.push(bg)
pos = XmlTagEnd(xml, fce)
end
end
ret out
end
func _xlsx_align_from_str(h: str): int:
if h == "left": ret AlignLeft end
if h == "center": ret AlignCenter end
if h == "right": ret AlignRight end
ret AlignDefault
end
func _xlsx_valign_from_str(v: str): int:
if v == "top": ret AlignTop end
if v == "center": ret AlignMiddle end
if v == "bottom": ret AlignBottom end
ret AlignDefault
end
func _xlsx_parse_styles(xml: str): StyleSheet:
mut result := StyleSheet {}
fonts := _xlsx_parse_fonts(xml)
fills := _xlsx_parse_fills(xml)
numfmt_codes := _xlsx_parse_numfmts(xml)
xfs_start := XmlFind(xml, "cellXfs", 0)
mut ce := -1
mut cs := -1
if xfs_start >= 0 and not XmlSelfClosing(xml, xfs_start):
cs = XmlTagEnd(xml, xfs_start)
ce = XmlFindClose(xml, "cellXfs", cs)
end
if ce >= 0:
mut pos := cs
until true:
idx := XmlFind(xml, "xf", pos)
if idx < 0 or idx >= ce: break end
font_id_str := XmlAttr(xml, idx, "fontId")
fill_id_str := XmlAttr(xml, idx, "fillId")
numfmt_id_str := XmlAttr(xml, idx, "numFmtId")
mut st := Style {}
if font_id_str.len() > 0:
fid := conv.AtoiOr(font_id_str, 0 - 1)
if fid >= 0 and fid < fonts.len():
fst := fonts.get(fid)
st.bold = fst.bold
st.italic = fst.italic
st.underline = fst.underline
st.font_size = fst.font_size
st.font_color = fst.font_color
st.font_name = fst.font_name
end
end
if fill_id_str.len() > 0:
flid := conv.AtoiOr(fill_id_str, 0 - 1)
if flid >= 0 and flid < fills.len():
st.bg_color = fills.get(flid)
end
end
if numfmt_id_str.len() > 0:
nfid := conv.AtoiOr(numfmt_id_str, 0 - 1)
if numfmt_codes.has(nfid):
st.num_format = numfmt_codes.get(nfid)
end
end
if XmlSelfClosing(xml, idx):
pos = XmlTagEnd(xml, idx)
else:
xcs := XmlTagEnd(xml, idx)
xce := XmlFindClose(xml, "xf", xcs)
if xce < 0 or xce > ce: break end
aidx := XmlFind(xml, "alignment", xcs)
if aidx >= 0 and aidx < xce:
st.align_h = _xlsx_align_from_str(XmlAttr(xml, aidx, "horizontal"))
st.align_v = _xlsx_valign_from_str(XmlAttr(xml, aidx, "vertical"))
wrap := XmlAttr(xml, aidx, "wrapText")
st.wrap = wrap == "1" or wrap == "true"
end
pos = XmlTagEnd(xml, xce)
end
result.styles.push(st)
end
end
defer fonts.free()
defer fills.free()
defer numfmt_codes.free()
ret result
end
func _xlsx_parse_row_into(xml: str, from: int, to_pos: int, sheet &: Sheet, date_flags: Vector<bool>, shared: Vector<str>):
mut pos := from
until true:
cidx := XmlFind(xml, "c", pos)
if cidx < 0 or cidx >= to_pos: break end
cref := XmlAttr(xml, cidx, "r")
mut row := 0
mut col := 0
has_ref := ParseCellRef(cref, row, col)
ttype := XmlAttr(xml, cidx, "t")
sid_str := XmlAttr(xml, cidx, "s")
mut sid := -1
if sid_str.len() > 0: sid = conv.AtoiOr(sid_str, 0 - 1) end
if XmlSelfClosing(xml, cidx):
pos = XmlTagEnd(xml, cidx)
else:
ccs := XmlTagEnd(xml, cidx)
cce := XmlFindClose(xml, "c", ccs)
if cce < 0: break end
body := xml.substr(ccs, cce - ccs)
if has_ref:
if ttype == "inlineStr":
sheet.set_string(row, col, _xlsx_collect_text(body))
else ttype == "str":
sheet.set_string(row, col, XmlUnescape(XmlInner(body, "v", 0)))
else ttype == "s":
idx := conv.AtoiOr(XmlInner(body, "v", 0), 0 - 1)
if idx >= 0 and idx < shared.len():
sheet.set_string(row, col, shared.get(idx))
end
else ttype == "b":
sheet.set_bool(row, col, XmlInner(body, "v", 0) == "1")
else ttype == "e":
sheet.set_error(row, col, XmlInner(body, "v", 0))
else:
fidx := XmlFind(body, "f", 0)
vtxt := XmlInner(body, "v", 0)
num := conv.ParseFloatOr(vtxt, 0.0)
if fidx >= 0:
sheet.set_formula(row, col, XmlUnescape(XmlInner(body, "f", 0)), num)
else:
mut is_date := false
if sid >= 0 and sid < date_flags.len(): is_date = date_flags.get(sid) end
if is_date:
sheet.set_date(row, col, SerialToEpoch(num))
else:
sheet.set_number(row, col, num)
end
end
end
if sid >= 0: sheet.set_style(row, col, sid) end
end
pos = XmlTagEnd(xml, cce)
end
end
end
func _xlsx_parse_sheet_into(xml: str, sheet &: Sheet, date_flags: Vector<bool>, shared: Vector<str>):
mut pos := 0
until true:
ridx := XmlFind(xml, "row", pos)
if ridx < 0: break end
if XmlSelfClosing(xml, ridx):
pos = XmlTagEnd(xml, ridx)
else:
rcs := XmlTagEnd(xml, ridx)
rce := XmlFindClose(xml, "row", rcs)
if rce < 0: break end
_xlsx_parse_row_into(xml, rcs, rce, sheet, date_flags, shared)
pos = XmlTagEnd(xml, rce)
end
end
fidx := XmlFind(xml, "autoFilter", 0)
if fidx >= 0: sheet.auto_filter = XmlAttr(xml, fidx, "ref") end
mut mpos := 0
until true:
midx := XmlFind(xml, "mergeCell", mpos)
if midx < 0: break end
ref := XmlAttr(xml, midx, "ref")
colon := str.IndexOf(ref, ":")
if colon > 0:
mut r1 := 0
mut c1 := 0
mut r2 := 0
mut c2 := 0
if ParseCellRef(ref.substr(0, colon), r1, c1) and ParseCellRef(ref.substr(colon + 1, ref.len() - colon - 1), r2, c2):
sheet.merge_cells(r1, c1, r2, c2)
end
end
mpos = XmlTagEnd(xml, midx)
end
end
@en "ReadXLSX"
@fa "خواندن ایکس‌ال‌اس‌ایکس"
pub func ReadXLSX(path: str, ok &: bool, err &: str): Workbook:
ok = false
err = ""
mut book := NewWorkbook()
mut read_ok := false
mut data := archive.ReadBinaryFile(path, read_ok)
if not read_ok:
err = "cannot open file: ".concat(path)
compress.BufFree(data)
ret book
end
mut wb_ok := false
mut wbbuf := archive.ZipExtractByName(data.data, data.len, "xl/workbook.xml", wb_ok)
if not wb_ok:
err = "not a valid .xlsx file (missing xl/workbook.xml)"
compress.BufFree(wbbuf)
compress.BufFree(data)
ret book
end
wbxml := compress.BufToStrUnsafe(wbbuf)
mut rels_ok := false
mut relsbuf := archive.ZipExtractByName(data.data, data.len, "xl/_rels/workbook.xml.rels", rels_ok)
mut rels := HashMap {} as HashMap<str, str>
if rels_ok:
rels = _xlsx_parse_rels(compress.BufToStrUnsafe(relsbuf))
end
compress.BufFree(relsbuf)
mut shared := Vector {} as Vector<str>
mut ss_ok := false
mut ssbuf := archive.ZipExtractByName(data.data, data.len, "xl/sharedStrings.xml", ss_ok)
if ss_ok:
shared = _xlsx_parse_shared_strings(compress.BufToStrUnsafe(ssbuf))
end
compress.BufFree(ssbuf)
mut date_flags := Vector {} as Vector<bool>
mut styles_ok := false
mut stylesbuf := archive.ZipExtractByName(data.data, data.len, "xl/styles.xml", styles_ok)
if styles_ok:
stylesxml := compress.BufToStrUnsafe(stylesbuf)
numfmt_codes := _xlsx_parse_numfmts(stylesxml)
date_flags = _xlsx_parse_cellxfs_date_flags(stylesxml, numfmt_codes)
book.styles = _xlsx_parse_styles(stylesxml)
numfmt_codes.free()
end
compress.BufFree(stylesbuf)
mut pos := 0
until true:
sidx := XmlFind(wbxml, "sheet", pos)
if sidx < 0: break end
name := XmlAttr(wbxml, sidx, "name")
mut rid := XmlAttr(wbxml, sidx, "r:id")
if rid.len() == 0: rid = XmlAttr(wbxml, sidx, "id") end
mut sh := NewSheet(name)
if rels.has(rid):
target := rels.get(rid)
if target.len() > 0:
partpath := _xlsx_resolve_target(target)
mut sheet_ok := false
mut sheetbuf := archive.ZipExtractByName(data.data, data.len, partpath, sheet_ok)
if sheet_ok:
_xlsx_parse_sheet_into(compress.BufToStrUnsafe(sheetbuf), sh, date_flags, shared)
end
compress.BufFree(sheetbuf)
end
end
book.sheets.push(sh)
pos = XmlTagEnd(wbxml, sidx)
end
defer rels.free()
defer shared.free()
defer date_flags.free()
compress.BufFree(wbbuf)
compress.BufFree(data)
book.format = FormatXLSX
book.source_path = path
ok = true
ret book
end
package excel
import archive
import conv
import str
func _xlsx_align_attrs(align_h: int, align_v: int, wrap: bool): str:
mut h := ""
if align_h == AlignLeft: h = "left"
else align_h == AlignCenter: h = "center"
else align_h == AlignRight: h = "right"
end
mut v := ""
if align_v == AlignTop: v = "top"
else align_v == AlignMiddle: v = "center"
else align_v == AlignBottom: v = "bottom"
end
if h.len() == 0 and v.len() == 0 and not wrap: ret "" end
mut out := "<alignment"
if h.len() > 0: out = out.concat(` horizontal="`).concat(h).concat(`"`) end
if v.len() > 0: out = out.concat(` vertical="`).concat(v).concat(`"`) end
if wrap: out = out.concat(` wrapText="1"`) end
out = out.concat("/>")
ret out
end
func _xlsx_cell_xml(c: Cell, date_style_id: int): str:
ref := CellRef(c.row, c.col)
mut sid := c.style_id
if c.kind == CellDate and sid < 0: sid = date_style_id end
mut s_attr := ""
if sid >= 0: s_attr = ` s="`.concat(conv.FormatInt(sid as i64)).concat(`"`) end
if c.kind == CellString:
ret `<c r="`.concat(ref).concat(`"`).concat(s_attr).concat(` t="inlineStr"><is><t xml:space="preserve">`).concat(XmlEscape(c.text)).concat("</t></is></c>")
else c.kind == CellBool:
mut v := "0"
if c.flag: v = "1" end
ret `<c r="`.concat(ref).concat(`"`).concat(s_attr).concat(` t="b"><v>`).concat(v).concat("</v></c>")
else c.kind == CellFormula:
ret `<c r="`.concat(ref).concat(`"`).concat(s_attr).concat("><f>").concat(XmlEscape(c.formula)).concat("</f><v>").concat(conv.FormatFloat(c.num)).concat("</v></c>")
else c.kind == CellError:
ret `<c r="`.concat(ref).concat(`"`).concat(s_attr).concat(` t="e"><v>`).concat(XmlEscape(c.text)).concat("</v></c>")
else c.kind == CellNumber or c.kind == CellDate:
ret `<c r="`.concat(ref).concat(`"`).concat(s_attr).concat("><v>").concat(conv.FormatFloat(c.num)).concat("</v></c>")
else sid >= 0:
ret `<c r="`.concat(ref).concat(`"`).concat(s_attr).concat("/>")
else:
ret ""
end
end
func _xlsx_sheet_body(sheet: Sheet, date_style_id: int): str:
mut sb := str.NewBuilder()
defer str.BufFree(sb)
nr := sheet.row_count()
nc := sheet.col_count()
mut r := 0
until r < nr:
mut has_any := false
mut c := 0
until c < nc:
if sheet.has_cell(r, c): has_any = true end
c++
end
if has_any:
str.BufAppend(sb, `<row r="`)
str.BufAppendInt(sb, (r + 1) as i64)
str.BufAppend(sb, `">`)
mut cc := 0
until cc < nc:
if sheet.has_cell(r, cc):
cell := sheet.get_cell(r, cc)
str.BufAppend(sb, _xlsx_cell_xml(cell, date_style_id))
end
cc++
end
str.BufAppend(sb, "</row>")
end
r++
end
out := str.BufStr(sb)
ret out
end
func _xlsx_sheet_xml(sheet: Sheet, date_style_id: int): str:
mut out := `<?xml version="1.0" encoding="UTF-8" standalone="yes"?><worksheet xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main">`
out = out.concat(_xlsx_sheet_views(sheet)).concat(_xlsx_cols(sheet))
out = out.concat("<sheetData>").concat(_xlsx_sheet_body(sheet, date_style_id)).concat("</sheetData>")
if sheet.auto_filter.len() > 0: out = out.concat(`<autoFilter ref="`).concat(sheet.auto_filter).concat(`"/>`) end
if sheet.merges.len() > 0:
out = out.concat(`<mergeCells count="`).concat(conv.FormatInt(sheet.merges.len() as i64)).concat(`">`)
mut i := 0
until i < sheet.merges.len():
m := sheet.merges.get(i)
ref := CellRef(m.row1, m.col1).concat(":").concat(CellRef(m.row2, m.col2))
out = out.concat(`<mergeCell ref="`).concat(ref).concat(`"/>`)
i++
end
out = out.concat("</mergeCells>")
end
out = out.concat("</worksheet>")
ret out
end
func _xlsx_border_id(st: Style): str:
if st.border: ret "1" end
ret "0"
end
func _xlsx_sheet_views(sheet: Sheet): str:
if not sheet.rtl and sheet.freeze_rows <= 0 and sheet.freeze_cols <= 0: ret "" end
mut out := `<sheetViews><sheetView workbookViewId="0"`
if sheet.rtl: out = out.concat(` rightToLeft="1"`) end
out = out.concat(">")
if sheet.freeze_rows > 0 or sheet.freeze_cols > 0:
out = out.concat("<pane")
if sheet.freeze_cols > 0: out = out.concat(` xSplit="`).concat(conv.FormatInt(sheet.freeze_cols as i64)).concat(`"`) end
if sheet.freeze_rows > 0: out = out.concat(` ySplit="`).concat(conv.FormatInt(sheet.freeze_rows as i64)).concat(`"`) end
mut pane := "bottomLeft"
if sheet.freeze_rows > 0 and sheet.freeze_cols > 0: pane = "bottomRight"
else sheet.freeze_cols > 0: pane = "topRight" end
out = out.concat(` topLeftCell="`).concat(CellRef(sheet.freeze_rows, sheet.freeze_cols)).concat(`" activePane="`).concat(pane).concat(`" state="frozen"/>`)
end
ret out.concat("</sheetView></sheetViews>")
end
func _xlsx_cols(sheet: Sheet): str:
mut any := false
mut out := "<cols>"
mut i := 0
until i < sheet.col_widths.len():
wd := sheet.col_widths.get(i)
if wd > 0.0:
any = true
n := conv.FormatInt((i + 1) as i64)
out = out.concat(`<col min="`).concat(n).concat(`" max="`).concat(n).concat(`" width="`).concat(conv.FormatFloat(wd)).concat(`" customWidth="1"/>`)
end
i++
end
if not any: ret "" end
ret out.concat("</cols>")
end
func _xlsx_styles_xml(styles: StyleSheet): str:
n := styles.count()
mut numfmts := str.NewBuilder()
defer str.BufFree(numfmts)
mut fonts := str.NewBuilder()
defer str.BufFree(fonts)
mut fills := str.NewBuilder()
defer str.BufFree(fills)
mut xfs := str.NewBuilder()
defer str.BufFree(xfs)
mut numfmt_count := 0
mut i := 0
until i < n:
st := styles.get(i)
str.BufAppend(fonts, "<font>")
if st.bold: str.BufAppend(fonts, "<b/>") end
if st.italic: str.BufAppend(fonts, "<i/>") end
if st.underline: str.BufAppend(fonts, "<u/>") end
str.BufAppend(fonts, `<sz val="`)
str.BufAppendInt(fonts, st.font_size as i64)
str.BufAppend(fonts, `"/>`)
if st.font_color.len() > 0:
str.BufAppend(fonts, `<color rgb="FF`.concat(st.font_color).concat(`"/>`))
end
str.BufAppend(fonts, `<name val="`.concat(XmlEscape(st.font_name)).concat(`"/>`))
str.BufAppend(fonts, "</font>")
if st.bg_color.len() > 0:
str.BufAppend(fills, `<fill><patternFill patternType="solid"><fgColor rgb="FF`.concat(st.bg_color).concat(`"/><bgColor indexed="64"/></patternFill></fill>`))
else:
str.BufAppend(fills, `<fill><patternFill patternType="none"/></fill>`)
end
mut numfmt_id := 0
if st.num_format.len() > 0:
numfmt_id = 164 + numfmt_count
str.BufAppend(numfmts, `<numFmt numFmtId="`.concat(conv.FormatInt(numfmt_id as i64)).concat(`" formatCode="`).concat(XmlEscape(st.num_format)).concat(`"/>`))
numfmt_count++
end
align_attrs := _xlsx_align_attrs(st.align_h, st.align_v, st.wrap)
fill_id := i + 2
font_id := i
str.BufAppend(xfs, `<xf numFmtId="`.concat(conv.FormatInt(numfmt_id as i64)).concat(`" fontId="`).concat(conv.FormatInt(font_id as i64)).concat(`" fillId="`).concat(conv.FormatInt(fill_id as i64)).concat(`" borderId="`).concat(_xlsx_border_id(st)).concat(`" xfId="0" applyFont="1" applyFill="1" applyNumberFormat="1" applyBorder="1"`))
if align_attrs.len() > 0:
str.BufAppend(xfs, ` applyAlignment="1">`)
str.BufAppend(xfs, align_attrs)
str.BufAppend(xfs, "</xf>")
else:
str.BufAppend(xfs, "/>")
end
i++
end
numfmts_str := str.BufStr(numfmts)
fonts_str := str.BufStr(fonts)
fills_str := str.BufStr(fills)
xfs_str := str.BufStr(xfs)
mut out := `<?xml version="1.0" encoding="UTF-8" standalone="yes"?><styleSheet xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main">`
if numfmt_count > 0:
out = out.concat(`<numFmts count="`).concat(conv.FormatInt(numfmt_count as i64)).concat(`">`).concat(numfmts_str).concat("</numFmts>")
end
out = out.concat(`<fonts count="`).concat(conv.FormatInt(n as i64)).concat(`">`).concat(fonts_str).concat("</fonts>")
out = out.concat(`<fills count="`).concat(conv.FormatInt((n + 2) as i64)).concat(`">`)
out = out.concat(`<fill><patternFill patternType="none"/></fill>`)
out = out.concat(`<fill><patternFill patternType="gray125"/></fill>`)
out = out.concat(fills_str).concat("</fills>")
out = out.concat(`<borders count="2"><border><left/><right/><top/><bottom/><diagonal/></border><border><left style="thin"><color indexed="64"/></left><right style="thin"><color indexed="64"/></right><top style="thin"><color indexed="64"/></top><bottom style="thin"><color indexed="64"/></bottom><diagonal/></border></borders>`)
out = out.concat(`<cellStyleXfs count="1"><xf numFmtId="0" fontId="0" fillId="0" borderId="0"/></cellStyleXfs>`)
out = out.concat(`<cellXfs count="`).concat(conv.FormatInt(n as i64)).concat(`">`).concat(xfs_str).concat("</cellXfs>")
out = out.concat(`<cellStyles count="1"><cellStyle name="Normal" xfId="0" builtinId="0"/></cellStyles>`)
out = out.concat("</styleSheet>")
ret out
end
func _xlsx_content_types(sheet_count: int): str:
mut out := `<?xml version="1.0" encoding="UTF-8" standalone="yes"?><Types xmlns="http://schemas.openxmlformats.org/package/2006/content-types">`
out = out.concat(`<Default Extension="rels" ContentType="application/vnd.openxmlformats-package.relationships+xml"/>`)
out = out.concat(`<Default Extension="xml" ContentType="application/xml"/>`)
out = out.concat(`<Override PartName="/xl/workbook.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet.main+xml"/>`)
out = out.concat(`<Override PartName="/xl/styles.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.styles+xml"/>`)
mut i := 0
until i < sheet_count:
out = out.concat(`<Override PartName="/xl/worksheets/sheet`).concat(conv.FormatInt((i + 1) as i64)).concat(`.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.worksheet+xml"/>`)
i++
end
out = out.concat("</Types>")
ret out
end
func _xlsx_root_rels(): str:
ret `<?xml version="1.0" encoding="UTF-8" standalone="yes"?><Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships"><Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument" Target="xl/workbook.xml"/></Relationships>`
end
func _xlsx_absolute_range(ref_in: str): str:
ref := str.Replace(ref_in, "$", "")
mut out := ""
mut at_start := true
mut in_row := false
repeat ref.len() in i:
ch := ref.substr(i, 1)
if ch == ":":
at_start = true
in_row = false
else at_start:
out = out.concat("$")
at_start = false
else not in_row and ch >= "0" and ch <= "9":
out = out.concat("$")
in_row = true
end
out = out.concat(ch)
end
ret out
end
func _xlsx_defined_names(sheets: Vector<Sheet>): str:
mut out := ""
repeat sheets.len() in i:
sh := sheets.get(i)
if sh.auto_filter.len() == 0: continue end
quoted := "'".concat(str.Replace(sh.name, "'", "''")).concat("'!").concat(_xlsx_absolute_range(sh.auto_filter))
out = out.concat(`<definedName name="_xlnm._FilterDatabase" localSheetId="`).concat(conv.FormatInt(i as i64)).concat(`" hidden="1">`).concat(XmlEscape(quoted)).concat("</definedName>")
end
if out.len() == 0: ret "" end
ret "<definedNames>".concat(out).concat("</definedNames>")
end
func _xlsx_workbook_xml(names: Vector<str>, defined: str): str:
mut out := `<?xml version="1.0" encoding="UTF-8" standalone="yes"?><workbook xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships"><sheets>`
mut i := 0
until i < names.len():
out = out.concat(`<sheet name="`).concat(XmlEscape(names.get(i))).concat(`" sheetId="`).concat(conv.FormatInt((i + 1) as i64)).concat(`" r:id="rId`).concat(conv.FormatInt((i + 1) as i64)).concat(`"/>`)
i++
end
out = out.concat("</sheets>").concat(defined).concat("</workbook>")
ret out
end
func _xlsx_workbook_rels(sheet_count: int): str:
mut out := `<?xml version="1.0" encoding="UTF-8" standalone="yes"?><Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships">`
mut i := 0
until i < sheet_count:
out = out.concat(`<Relationship Id="rId`).concat(conv.FormatInt((i + 1) as i64)).concat(`" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/worksheet" Target="worksheets/sheet`).concat(conv.FormatInt((i + 1) as i64)).concat(`.xml"/>`)
i++
end
out = out.concat(`<Relationship Id="rId`).concat(conv.FormatInt((sheet_count + 1) as i64)).concat(`" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/styles" Target="styles.xml"/>`)
out = out.concat("</Relationships>")
ret out
end
@en "WriteXLSX"
@fa "نوشتن ایکس‌ال‌اس‌ایکس"
pub func WriteXLSX(book &: Workbook, path: str): bool:
n := book.sheets.len()
if n == 0: ret false end
date_style_id := book.styles.get_or_add(Style { num_format = "yyyy-mm-dd hh:mm:ss" })
mut files := Vector {} as Vector<archive.ZipFileInput>
defer files.free()
ct := _xlsx_content_types(n)
files.push(archive.MakeZipFileInput("[Content_Types].xml", ct as void*, ct.len(), 8))
rr := _xlsx_root_rels()
files.push(archive.MakeZipFileInput("_rels/.rels", rr as void*, rr.len(), 8))
names := book.sheet_names()
wbxml := _xlsx_workbook_xml(names, _xlsx_defined_names(book.sheets))
defer names.free()
files.push(archive.MakeZipFileInput("xl/workbook.xml", wbxml as void*, wbxml.len(), 8))
wbrels := _xlsx_workbook_rels(n)
files.push(archive.MakeZipFileInput("xl/_rels/workbook.xml.rels", wbrels as void*, wbrels.len(), 8))
stylesxml := _xlsx_styles_xml(book.styles)
files.push(archive.MakeZipFileInput("xl/styles.xml", stylesxml as void*, stylesxml.len(), 8))
mut i := 0
until i < n:
sh := book.sheets.get(i)
sxml := _xlsx_sheet_xml(sh, date_style_id)
name := "xl/worksheets/sheet".concat(conv.FormatInt((i + 1) as i64)).concat(".xml")
files.push(archive.MakeZipFileInput(name, sxml as void*, sxml.len(), 8))
i++
end
ret archive.ZipCreateFile(files, path)
end
package excel
import str
func _is_name_boundary(code: int): bool:
if code == 32 or code == 9 or code == 10 or code == 13: ret true end
if code == 62 or code == 47: ret true end
ret false
end
@en "XmlEscape"
@fa "اسکیپ ایکس‌ام‌ال"
pub func XmlEscape(s: str): str:
mut out := s
out = str.Replace(out, "&", "&amp;")
out = str.Replace(out, "<", "&lt;")
out = str.Replace(out, ">", "&gt;")
out = str.Replace(out, `"`, "&quot;")
out = str.Replace(out, "'", "&apos;")
ret out
end
@en "XmlUnescape"
@fa "برگرداندن اسکیپ ایکس‌ام‌ال"
pub func XmlUnescape(s: str): str:
mut out := s
out = str.Replace(out, "&lt;", "<")
out = str.Replace(out, "&gt;", ">")
out = str.Replace(out, "&quot;", `"`)
out = str.Replace(out, "&apos;", "'")
out = str.Replace(out, "&amp;", "&")
ret out
end
@en "XmlFind"
@fa "یافتن ایکس‌ام‌ال"
pub func XmlFind(xml: str, tag: str, from: int): int:
needle := "<".concat(tag)
n := xml.len()
bp := _bp(xml)
mut pos := from
if pos < 0: pos = 0 end
until pos <= n:
idx := str.IndexFrom(xml, needle, pos)
if idx < 0: ret -1 end
after := idx + needle.len()
if after >= n:
ret idx
end
if _is_name_boundary(_ub(bp, after)):
ret idx
end
pos = idx + 1
end
ret -1
end
@en "XmlTagEnd"
@fa "پایان برچسب ایکس‌ام‌ال"
pub func XmlTagEnd(xml: str, start: int): int:
n := xml.len()
bp := _bp(xml)
mut i := start
mut in_quote := false
mut quote := 34
until i < n:
code := _ub(bp, i)
if in_quote:
if code == quote: in_quote = false end
else code == 34 or code == 39:
in_quote = true
quote = code
else code == 62:
ret i + 1
end
i++
end
ret n
end
@en "XmlSelfClosing"
@fa "بستن خودکار ایکس‌ام‌ال"
pub func XmlSelfClosing(xml: str, start: int): bool:
e := XmlTagEnd(xml, start)
if e < start + 2: ret false end
bp := _bp(xml)
ret _ub(bp, e - 2) == 47
end
@en "XmlAttr"
@fa "ویژگی ایکس‌ام‌ال"
pub func XmlAttr(xml: str, start: int, attr: str): str:
e := XmlTagEnd(xml, start)
bp := _bp(xml)
mut i := start
until i < e:
if _is_name_boundary(_ub(bp, i)): break end
i++
end
until i < e:
until i < e:
code := _ub(bp, i)
if code != 32 and code != 9 and code != 10 and code != 13: break end
i++
end
if i >= e: break end
c0 := _ub(bp, i)
if c0 == 62 or c0 == 47: break end
name_start := i
until i < e:
code := _ub(bp, i)
if code == 61 or code == 32 or code == 62 or code == 47: break end
i++
end
name := xml.substr(name_start, i - name_start)
mut val := ""
mut has_val := false
if i < e and _ub(bp, i) == 61:
i++
if i < e:
q := _ub(bp, i)
if q == 34 or q == 39:
i++
val_start := i
until i < e:
if _ub(bp, i) == q: break end
i++
end
val = xml.substr(val_start, i - val_start)
has_val = true
if i < e: i++ end
end
end
end
if has_val and name == attr:
ret XmlUnescape(val)
end
end
ret ""
end
@en "XmlFindClose"
@fa "یافتن بستن ایکس‌ام‌ال"
pub func XmlFindClose(xml: str, tag: str, content_start: int): int:
close_tag := "/".concat(tag)
mut depth := 1
mut pos := content_start
until depth > 0:
open_idx := XmlFind(xml, tag, pos)
close_idx := XmlFind(xml, close_tag, pos)
if close_idx < 0: ret -1 end
if open_idx >= 0 and open_idx < close_idx:
if XmlSelfClosing(xml, open_idx):
pos = XmlTagEnd(xml, open_idx)
else:
depth++
pos = XmlTagEnd(xml, open_idx)
end
else:
depth--
if depth <= 0: ret close_idx end
pos = XmlTagEnd(xml, close_idx)
end
end
ret -1
end
@en "XmlInner"
@fa "درون ایکس‌ام‌ال"
pub func XmlInner(xml: str, tag: str, from: int): str:
open_idx := XmlFind(xml, tag, from)
if open_idx < 0: ret "" end
if XmlSelfClosing(xml, open_idx): ret "" end
content_start := XmlTagEnd(xml, open_idx)
close_idx := XmlFindClose(xml, tag, content_start)
if close_idx < 0: ret "" end
ret xml.substr(content_start, close_idx - content_start)
end
@en "filepath"
@fa "مسیر پرونده"
package filepath
import mem
import str
if SALAM_OS_WINDOWS:
extern:
func GetCurrentDirectoryA(sz: int, buf: void*): int
end
else:
extern:
func getcwd(buf: void*, sz: int): void*
end
end
@en "Separator"
@fa "جداکننده"
pub const Separator := "/"
inline func _fp_sep(c: int): bool: ret c == 47 or c == 92 end
inline func _fp_end(c: int): bool: ret c == 0 or c == 47 or c == 92 end
inline func _fp_drive_len(src: u8*, n: int): int:
if n >= 2:
c := src[0] as int
if ((c >= 65 and c <= 90) or (c >= 97 and c <= 122)) and src[1] as int == 58:
if n >= 3 and _fp_sep(src[2] as int):
ret 3
end
ret 2
end
end
ret 0
end
func _fp_put(dst: u8*, at: int, src: u8*, from: int, n: int):
repeat n in i:
c := src[from + i]
dst[at + i] = c as int == 92 ? 47 as u8 : c
end
end
func _fp_cwd(): str:
buf := mem.Allocate(2048 as u64)
mut s := ""
if SALAM_OS_WINDOWS:
n := GetCurrentDirectoryA(2048, buf)
if n > 0 and n < 2048: s = str.Clone(buf as str) end
else:
r := getcwd(buf, 2048)
if r != null: s = str.Clone(r as str) end
end
mem.Free(buf)
ret s
end
func _fp_segments(p: str): Vector<str>:
parts := p.split("/")
defer parts.free()
out := Vector {} as Vector<str>
repeat parts.len() in i:
seg := parts.get(i)
if seg.len() > 0:
out.push(seg)
end
end
ret out
end
@en "Normalize"
@fa "نرمال سازی"
pub func Normalize(p: str): str:
n := p.len()
out := mem.Allocate((n + 1) as u64) as u8*
_fp_put(out, 0, p as u8*, 0, n)
out[n] = 0 as u8
ret out as str
end
@en "IsAbs"
@fa "مطلق است"
pub func IsAbs(p: str): bool:
n := p.len()
if n == 0: ret false end
src := p as u8*
if _fp_sep(src[0] as int): ret true end
ret _fp_drive_len(src, n) == 3
end
@en "Join"
@fa "پیوند"
pub func Join(a: str, b: str): str:
na := a.len()
nb := b.len()
if na == 0: ret Normalize(b) end
if nb == 0: ret Normalize(a) end
ap := a as u8*
bp := b as u8*
out := mem.Allocate((na + nb + 2) as u64) as u8*
_fp_put(out, 0, ap, 0, na)
mut w := na
a_sep := _fp_sep(ap[na - 1] as int)
b_sep := _fp_sep(bp[0] as int)
mut from := 0
if a_sep and b_sep:
from = 1
else not a_sep and not b_sep:
out[w] = 47 as u8
w++
end
_fp_put(out, w, bp, from, nb - from)
out[w + nb - from] = 0 as u8
ret out as str
end
@en "Base"
@fa "نام پایه"
pub func Base(p: str): str:
mut q := Normalize(p)
dlen := _fp_drive_len(q as u8*, q.len())
if dlen == 3 and q.len() == 3:
mem.Free(q as void*)
ret str.Clone("/")
end
until q.len() > 1 and str.EndsWith(q, "/"):
if dlen == 3 and q.len() <= 3:
break
end
shorter := q.substr(0, q.len() - 1)
mem.Free(q as void*)
q = shorter
end
if q == "/" or (dlen == 3 and q.len() == 3):
mem.Free(q as void*)
ret str.Clone("/")
else q.len() == 0:
mem.Free(q as void*)
ret str.Clone(".")
end
idx := str.LastIndex(q, "/")
if idx < 0: ret q end
out := q.substr(idx + 1, q.len() - idx - 1)
mem.Free(q as void*)
ret out
end
@en "Dir"
@fa "پوشه"
pub func Dir(p: str): str:
mut q := Normalize(p)
dlen := _fp_drive_len(q as u8*, q.len())
if dlen == 3 and q.len() == 3:
ret q
end
until q.len() > 1 and str.EndsWith(q, "/"):
if dlen == 3 and q.len() <= 3:
break
end
t := q.substr(0, q.len() - 1)
mem.Free(q as void*)
q = t
end
if dlen == 3 and q.len() == 3:
ret q
end
idx := str.LastIndex(q, "/")
mut out := ""
if idx < 0:
if dlen == 2:
out = q.substr(0, 2)
else:
out = str.Clone(".")
end
else idx == 0:
out = str.Clone("/")
else dlen == 3 and idx == 2:
out = q.substr(0, 3)
else:
out = q.substr(0, idx)
end
mem.Free(q as void*)
ret out
end
@en "Ext"
@fa "پسوند"
pub func Ext(p: str): str:
b := Base(p)
idx := str.LastIndex(b, ".")
if idx <= 0:
mem.Free(b as void*)
ret str.Clone("")
end
out := b.substr(idx, b.len() - idx)
mem.Free(b as void*)
ret out
end
@en "Stem"
@fa "نام بدون پسوند"
pub func Stem(p: str): str:
b := Base(p)
idx := str.LastIndex(b, ".")
if idx <= 0: ret b end
out := b.substr(0, idx)
mem.Free(b as void*)
ret out
end
@en "Clean"
@fa "پاک سازی"
pub func Clean(p: str): str:
n := p.len()
if n == 0: ret str.Clone(".") end
src := p as u8*
out := mem.Allocate((n + 3) as u64) as u8*
dlen := _fp_drive_len(src, n)
mut rooted := false
mut r := 0
mut w := 0
mut dotdot := 0
if dlen == 3:
out[0] = src[0]
out[1] = 58 as u8
out[2] = 47 as u8
w = 3
r = 3
rooted = true
dotdot = 3
else dlen == 2:
out[0] = src[0]
out[1] = 58 as u8
w = 2
r = 2
dotdot = 2
else _fp_sep(src[0] as int):
out[0] = 47 as u8
w = 1
r = 1
rooted = true
dotdot = 1
end
until r < n:
c := src[r] as int
if _fp_sep(c):
r++
else c == 46 and _fp_end(src[r + 1] as int):
r++
else c == 46 and src[r + 1] as int == 46 and _fp_end(src[r + 2] as int):
r += 2
if w > dotdot:
w--
until w > dotdot and out[w] as int != 47:
w--
end
else not rooted:
if (dlen == 2 and w > 2) or (dlen != 2 and w > 0):
out[w] = 47 as u8
w++
end
out[w] = 46 as u8
out[w + 1] = 46 as u8
w += 2
dotdot = w
end
else:
if (rooted and w != dotdot) or (not rooted and w != dlen):
out[w] = 47 as u8
w++
end
until r < n and not _fp_sep(src[r] as int):
out[w] = src[r]
w++
r++
end
end
end
if w == 0:
out[0] = 46 as u8
w = 1
end
out[w] = 0 as u8
ret out as str
end
@en "Abs"
@fa "مسیر مطلق"
pub func Abs(p: str): str:
if IsAbs(p): ret Clean(p) end
cwd := _fp_cwd()
ret Clean(Join(cwd, p))
end
@en "Rel"
@fa "مسیر نسبی"
pub func Rel(base: str, target: str): str:
ab := Abs(base)
at := Abs(target)
bs := _fp_segments(ab)
defer bs.free()
ts := _fp_segments(at)
defer ts.free()
mut common := 0
until common < bs.len() and common < ts.len() and bs.get(common) == ts.get(common):
common++
end
out := Vector {} as Vector<str>
defer out.free()
mut up := common
until up < bs.len():
out.push("..")
up++
end
mut i := common
until i < ts.len():
out.push(ts.get(i))
i++
end
if out.len() == 0: ret "." end
ret str.Join(out, "/")
end
@en "Validate"
@fa "اعتبارسنجی مسیر"
pub func Validate(p: str): bool:
ret p.len() > 0
end
@en "IsSafe"
@fa "مسیر امن است"
pub func IsSafe(base: str, p: str): bool:
if Validate(p) == false: ret false end
b := Clean(Abs(base))
full := Clean(Join(b, p))
if full == b: ret true end
prefix := b.concat("/")
ret str.StartsWith(full, prefix)
end
package filepath
func _gl_len(lead: int): int:
if lead >= 240: ret 4 end
if lead >= 224: ret 3 end
if lead >= 192: ret 2 end
ret 1
end
func _gl_cp(bp: u8*, n: int, at: int): int:
lead := bp[at] as int
size := _gl_len(lead)
if size == 1 or at + size > n:
ret lead
end
mut cp := 0
if size == 2:
cp = lead & 31
else size == 3:
cp = lead & 15
else:
cp = lead & 7
end
repeat size - 1 in k:
cp = (cp << 6) | ((bp[at + 1 + k] as int) & 63)
end
ret cp
end
func _gl_class(pp: u8*, pn: int, open: int, cp: int, after &: int): bool:
mut i := open + 1
mut negate := false
if i < pn and (pp[i] == 33 or pp[i] == 94):
negate = true
i++
end
mut hit := false
mut first := true
until i < pn and (pp[i] != 93 or first):
first = false
mut lo := 0
if pp[i] == 92 and i + 1 < pn:
i++
end
lo = _gl_cp(pp, pn, i)
i += _gl_len(pp[i] as int)
mut hi := lo
if i + 1 < pn and pp[i] == 45 and pp[i + 1] != 93:
i++
if pp[i] == 92 and i + 1 < pn:
i++
end
hi = _gl_cp(pp, pn, i)
i += _gl_len(pp[i] as int)
end
if cp >= lo and cp <= hi:
hit = true
end
end
if i >= pn:
after = 0 - 1
ret false
end
after = i + 1
ret hit != negate
end
func _gl_match(pp: u8*, pn: int, pi: int, sp: u8*, sn: int, si: int): bool:
mut p := pi
mut s := si
until p < pn:
c := pp[p] as int
if c == 42:
mut stars := 0
until p < pn and pp[p] == 42:
stars++
p++
end
deep := stars >= 2
mut dirs := false
if deep and p < pn and pp[p] == 47:
dirs = true
p++
end
if p >= pn:
if deep: ret true end
mut k := s
until k < sn:
if sp[k] == 47: ret false end
k++
end
ret true
end
mut k := s
until k <= sn:
if not dirs or k == s or sp[k - 1] == 47:
if _gl_match(pp, pn, p, sp, sn, k):
ret true
end
end
if k < sn and sp[k] == 47 and not deep:
break
end
if k < sn:
k += _gl_len(sp[k] as int)
else:
k++
end
end
ret false
end
if s >= sn:
ret false
end
if c == 63:
if sp[s] == 47: ret false end
s += _gl_len(sp[s] as int)
p++
else c == 91:
if sp[s] == 47: ret false end
mut after := 0
ok := _gl_class(pp, pn, p, _gl_cp(sp, sn, s), after)
if after < 0 or not ok: ret false end
s += _gl_len(sp[s] as int)
p = after
else:
mut lit := p
if c == 92 and p + 1 < pn:
lit = p + 1
end
if pp[lit] != sp[s]: ret false end
p = lit + 1
s++
end
end
ret s >= sn
end
@en "Match"
@fa "تطبیق الگو"
pub func Match(pattern: str, name: str): bool:
ret _gl_match(pattern as u8*, pattern.len(), 0, name as u8*, name.len(), 0)
end
@en "HasMeta"
@fa "الگو دارد"
pub func HasMeta(pattern: str): bool:
n := pattern.len()
bp := pattern as u8*
repeat n in i:
c := bp[i]
if c == 42 or c == 63 or c == 91 or c == 92:
ret true
end
end
ret false
end
@en "flag"
@fa "پرچم"
package flag
import str
import conv
import collections
@en "FlagKindBool"
@fa "نوع منطقی"
pub const FlagKindBool := 0
@en "FlagKindStr"
@fa "نوع رشته"
pub const FlagKindStr := 1
@en "FlagKindInt"
@fa "نوع صحیح"
pub const FlagKindInt := 2
@en "FlagKindFloat"
@fa "نوع اعشاری"
pub const FlagKindFloat := 3
@en "FlagSet"
@fa "مجموعه پرچم"
pub struct FlagSet:
@en "prog"
@fa "برنامه"
pub prog: str = ""
@en "desc"
@fa "شرح"
pub desc: str = ""
@en "names"
@fa "نام‌ها"
pub names: Vector<str> = Vector {}
@en "shorts"
@fa "نام‌های کوتاه"
pub shorts: Vector<str> = Vector {}
@en "kinds"
@fa "گونه‌ها"
pub kinds: Vector<int> = Vector {}
@en "vals"
@fa "مقدارها"
pub vals: Vector<str> = Vector {}
@en "defs"
@fa "پیش‌فرض‌ها"
pub defs: Vector<str> = Vector {}
@en "helps"
@fa "راهنماها"
pub helps: Vector<str> = Vector {}
@en "was_set"
@fa "تنظیم‌شده"
pub was_set: Vector<bool> = Vector {}
@en "pos"
@fa "موقعیتی‌ها"
pub pos: Vector<str> = Vector {}
@en "err"
@fa "خطا"
pub err: str = ""
@en "help_wanted"
@fa "راهنما خواسته شد"
pub help_wanted: bool = false
end
func _register(fs &: FlagSet, name: str, short: str, kind: int, def: str, help: str):
fs.names.push(name)
fs.shorts.push(short)
fs.kinds.push(kind)
fs.defs.push(def)
fs.vals.push(def)
fs.helps.push(help)
fs.was_set.push(false)
end
func _find(fs &: FlagSet, name: str): int:
repeat fs.names.len() in i:
if fs.names.get(i) == name: ret i end
end
ret 0 - 1
end
func _find_short(fs &: FlagSet, short: str): int:
repeat fs.shorts.len() in i:
s := fs.shorts.get(i)
if s.len() > 0 and s == short: ret i end
end
ret 0 - 1
end
func _assign(fs &: FlagSet, idx: int, val: str):
fs.vals.set(idx, val)
fs.was_set.set(idx, true)
end
func _valid_number(raw: str, kind: int): bool:
t := str.Replace(str.ToEnglishDigits(str.Trim(raw)), "٫", ".")
n := t.len()
mut i := 0
if n > 0 and (t.starts_with("-") or t.starts_with("+")):
i = 1
end
mut digits := 0
mut dots := 0
mut exp := false
until i < n:
c := t.substr(i, 1)
if str.IsAsciiDigit(char_code(c)):
digits++
else kind == 3 and c == "." and dots == 0 and not exp:
dots++
else kind == 3 and (c == "e" or c == "E") and digits > 0 and not exp:
exp = true
if i + 1 < n and (t.substr(i + 1, 1) == "-" or t.substr(i + 1, 1) == "+"):
i++
end
else:
ret false
end
i++
end
ret digits > 0
end
func _kind_hint(kind: int): str:
if kind == 1: ret " <string>"
else kind == 2: ret " <int>"
else kind == 3: ret " <float>"
else:
ret ""
end
end
@en "New"
@fa "جدید"
pub func New(prog_name: str, description: str): FlagSet:
fs := FlagSet {}
fs.prog = prog_name
fs.desc = description
ret fs
end
@en "AddBool"
@fa "افزودن منطقی"
pub func AddBool(fs &: FlagSet, name: str, short: str, def: bool, help: str):
_register(fs, name, short, 0, conv.FormatBool(def), help)
end
@en "AddStr"
@fa "افزودن رشته"
pub func AddStr(fs &: FlagSet, name: str, short: str, def: str, help: str):
_register(fs, name, short, 1, def, help)
end
@en "AddInt"
@fa "افزودن صحیح"
pub func AddInt(fs &: FlagSet, name: str, short: str, def: i64, help: str):
_register(fs, name, short, 2, conv.FormatInt(def), help)
end
@en "AddFloat"
@fa "افزودن اعشاری"
pub func AddFloat(fs &: FlagSet, name: str, short: str, def: f64, help: str):
_register(fs, name, short, 3, conv.FormatFloat(def), help)
end
@en "Parse"
@fa "تجزیه"
pub func Parse(fs &: FlagSet, arglist: Vector<str>): bool:
fs.err = ""
mut i := 0
mut only_pos := false
until i < arglist.len():
arg := arglist.get(i)
if only_pos:
fs.pos.push(arg)
i++
else:
if arg == "--":
only_pos = true
i++
else:
if str.StartsWith(arg, "--") or (str.StartsWith(arg, "-") and arg.len() > 1):
mut body := arg.substr(1, arg.len() - 1)
mut long := false
if str.StartsWith(arg, "--"):
body = arg.substr(2, arg.len() - 2)
long = true
end
mut name := body
mut inline_val := ""
mut has_inline := false
eq_at := body.find("=")
if eq_at >= 0:
name = body.substr(0, eq_at)
inline_val = body.substr(eq_at + 1, body.len() - eq_at - 1)
has_inline = true
end
if name == "help" or name == "h":
fs.help_wanted = true
i++
else:
mut idx := 0 - 1
if long:
idx = _find(fs, name)
else:
idx = _find_short(fs, name)
if idx < 0: idx = _find(fs, name) end
end
if idx < 0:
fs.err = "unknown flag: ".concat(arg)
ret false
end
if fs.kinds.get(idx) == 0:
if has_inline:
_assign(fs, idx, inline_val)
else:
_assign(fs, idx, "true")
end
i++
else:
if has_inline:
_assign(fs, idx, inline_val)
i++
else:
if i + 1 >= arglist.len():
fs.err = "missing value for flag: ".concat(arg)
ret false
end
_assign(fs, idx, arglist.get(i + 1))
i += 2
end
end
end
else:
fs.pos.push(arg)
i++
end
end
end
end
repeat fs.names.len() in k:
kind := fs.kinds.get(k)
if (kind == 2 or kind == 3) and fs.was_set.get(k) and not _valid_number(fs.vals.get(k), kind):
fs.err = "invalid " + (kind == 2 ? "int" : "float") + " value for --" + fs.names.get(k) + ": " + fs.vals.get(k)
ret false
end
end
ret true
end
@en "GetStr"
@fa "دریافت رشته"
pub func GetStr(fs &: FlagSet, name: str): str:
idx := _find(fs, name)
if idx < 0: ret "" end
ret fs.vals.get(idx)
end
@en "GetInt"
@fa "دریافت صحیح"
pub func GetInt(fs &: FlagSet, name: str): i64:
idx := _find(fs, name)
if idx < 0: ret 0 end
ret conv.ParseIntOr(fs.vals.get(idx), 0)
end
@en "GetFloat"
@fa "دریافت اعشاری"
pub func GetFloat(fs &: FlagSet, name: str): f64:
idx := _find(fs, name)
if idx < 0: ret 0.0 end
ret conv.ParseFloatOr(fs.vals.get(idx), 0.0)
end
@en "GetBool"
@fa "دریافت منطقی"
pub func GetBool(fs &: FlagSet, name: str): bool:
idx := _find(fs, name)
if idx < 0: ret false end
ret conv.ParseBoolOr(fs.vals.get(idx), false)
end
@en "WasSet"
@fa "تنظیم شده"
pub func WasSet(fs &: FlagSet, name: str): bool:
idx := _find(fs, name)
if idx < 0: ret false end
ret fs.was_set.get(idx)
end
@en "Positional"
@fa "موقعیتی"
pub func Positional(fs &: FlagSet): Vector<str>:
ret collections.clone(fs.pos)
end
@en "HelpWanted"
@fa "راهنما خواسته"
pub func HelpWanted(fs &: FlagSet): bool: ret fs.help_wanted end
@en "Error"
@fa "خطا"
pub func Error(fs &: FlagSet): str: ret fs.err end
@en "Usage"
@fa "راهنما"
pub func Usage(fs &: FlagSet): str:
mut b := str.NewBuilder()
defer str.BufFree(b)
str.BufAppend(b, "Usage: ")
str.BufAppend(b, fs.prog)
str.BufAppend(b, " [options] [args]\n")
if fs.desc.len() > 0:
str.BufAppend(b, "  ")
str.BufAppend(b, fs.desc)
str.BufAppend(b, "\n")
end
str.BufAppend(b, "Options:\n")
repeat fs.names.len() in i:
str.BufAppend(b, "  ")
short := fs.shorts.get(i)
if short.len() > 0:
str.BufAppend(b, "-")
str.BufAppend(b, short)
str.BufAppend(b, ", ")
end
str.BufAppend(b, "--")
str.BufAppend(b, fs.names.get(i))
str.BufAppend(b, _kind_hint(fs.kinds.get(i)))
help := fs.helps.get(i)
if help.len() > 0:
str.BufAppend(b, "  ")
str.BufAppend(b, help)
end
def := fs.defs.get(i)
if fs.kinds.get(i) != 0 and def.len() > 0:
str.BufAppend(b, " (default: ")
str.BufAppend(b, def)
str.BufAppend(b, ")")
end
str.BufAppend(b, "\n")
end
str.BufAppend(b, "  -h, --help  show this help\n")
out := str.BufStr(b)
ret out
end
@en "Free"
@fa "آزادسازی"
pub func Free(fs &: FlagSet):
fs.names.free()
fs.shorts.free()
fs.kinds.free()
fs.vals.free()
fs.defs.free()
fs.helps.free()
fs.was_set.free()
fs.pos.free()
end
@en "fmt"
@fa "قالب بندی"
package fmt
import str
import conv
@en "Int"
@fa "عدد صحیح"
pub inline func Int(i: i64): str: ret conv.FormatInt(i) end
@en "Float"
@fa "عدد اعشار"
pub inline func Float(f: f64): str: ret str.FromFloat(f) end
@en "Bool"
@fa "منطقی"
pub inline pure func Bool(b: bool): str: ret conv.FormatBool(b) end
@en "PadLeft"
@fa "پرکردن چپ"
pub func PadLeft(s: str, width: int): str:
gap := width - str.CharCount(s)
if gap <= 0:
ret s
end
ret str.Repeat(" ", gap).concat(s)
end
@en "PadRight"
@fa "پرکردن راست"
pub func PadRight(s: str, width: int): str:
gap := width - str.CharCount(s)
if gap <= 0:
ret s
end
ret s.concat(str.Repeat(" ", gap))
end
@en "Center"
@fa "وسط چین"
pub func Center(s: str, width: int): str:
gap := width - str.CharCount(s)
if gap <= 0:
ret s
end
left := gap / 2
ret str.Repeat(" ", left).concat(s).concat(str.Repeat(" ", gap - left))
end
@en "Sprintf"
@fa "قالب رشته"
pub func Sprintf(tmpl: str, args: Vector<str>): str:
parts := tmpl.split("{}")
defer parts.free()
mut out := parts.get(0)
mut i := 1
until i < parts.len():
if i - 1 < args.len():
out = out.concat(args.get(i - 1))
end
out = out.concat(parts.get(i))
i++
end
ret out
end
@en "Fprintf"
