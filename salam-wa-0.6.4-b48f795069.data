mut done := false
until not done:
mut weight := Vector {} as Vector<i64>
mut parent := Vector {} as Vector<int>
mut leaf := Vector {} as Vector<int>
mut alive := Vector {} as Vector<bool>
repeat n in i:
c := counts.get(i)
if c > 0:
w := c < floor ? floor : c
