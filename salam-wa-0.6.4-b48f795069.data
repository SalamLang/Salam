typ := b0 & 3
sf := (b0 >> 2) & 3
mut hdr := 1
mut rsz := 0
mut csz := 0
mut streams := 1
if typ < 2:
if sf == 0 or sf == 2:
rsz = b0 >> 3
else sf == 1:
hdr = 2
if n < 2:
ret 0 - 1
end
rsz = (b0 >> 4) + ((p[1] as int) << 4)
else:
hdr = 3
if n < 3:
ret 0 - 1
end
rsz = (b0 >> 4) + ((p[1] as int) << 4) + ((p[2] as int) << 12)
end
else:
if sf <= 1:
hdr = 3
if n < 3:
ret 0 - 1
