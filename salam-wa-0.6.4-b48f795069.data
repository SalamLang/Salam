ret css.Color { r = math.MinI(255, c.r + 168), g = math.MinI(255, c.g + 168), b = math.MinI(255, c.b + 168), a = c.a }
end
if (255.0 - r) * (255.0 - r) + (255.0 - g) * (255.0 - g) + (255.0 - b) * (255.0 - b) < 1200.0:
ret c
end
v := math.Max(r, math.Max(g, b)) / 255.0
m := math.Min(1.0, v + 0.33) / v
ret css.Color { r = _tone_ch(m, c.r), g = _tone_ch(m, c.g), b = _tone_ch(m, c.b), a = c.a }
end
