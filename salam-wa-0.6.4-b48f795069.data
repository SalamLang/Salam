end
@en "GzipDecompressBuf"
@fa "کدگشایی جی زیپ بافر"
pub func GzipDecompressBuf(b: ByteBuf, ok &: bool): ByteBuf:
ret GzipDecompress(b.data, b.len, ok)
end
package compress
const _HUFF_ALPHA := 256
const _HUFF_MAX_NODES := 512
func _huff_canonical_codes(lengths: int[:], codes_out: int[:]):
mut blcount: int[256]
repeat 256 in i: blcount[i] = 0 end
mut maxlen := 0
repeat _HUFF_ALPHA in s:
l := lengths[s]
if l > maxlen: maxlen = l end
if l > 0: blcount[l]++ end
end
mut nextcode: int[256]
repeat 256 in i: nextcode[i] = 0 end
mut code := 0
mut len := 1
until len <= maxlen:
code = (code + blcount[len - 1]) * 2
nextcode[len] = code
len++
end
repeat _HUFF_ALPHA in s:
l := lengths[s]
if l > 0:
codes_out[s] = nextcode[l]
nextcode[l]++
else:
codes_out[s] = 0
end
end
end
func _huff_lengths(p: void*, n: int, lengths_out: int[:]): int:
mut freq: i64[256]
repeat 256 in i: freq[i] = 0 as i64 end
bp := p as u8*
mut i := 0
until i < n:
b := bp[i] as int
freq[b]++
i++
end
mut nfreq: i64[512]
mut nleft: int[512]
mut nright: int[512]
mut nsym: int[512]
mut nleaf: bool[512]
repeat _HUFF_MAX_NODES in k:
nfreq[k] = 0 as i64
nleft[k] = -1
nright[k] = -1
nsym[k] = -1
nleaf[k] = false
end
mut nodecount := 0
mut active: int[256]
mut activecount := 0
repeat 256 in s:
if freq[s] > (0 as i64):
nfreq[nodecount] = freq[s]
nleaf[nodecount] = true
nsym[nodecount] = s
active[activecount] = nodecount
activecount++
nodecount++
end
end
distinct := activecount
if distinct == 0: ret 0 end
if distinct == 1:
lengths_out[nsym[active[0]]] = 1
ret 1
end
until activecount > 1:
mut i1 := 0
repeat activecount in k:
if nfreq[active[k]] < nfreq[active[i1]]: i1 = k end
end
idx1 := active[i1]
active[i1] = active[activecount - 1]
activecount--
mut i2 := 0
repeat activecount in k:
if nfreq[active[k]] < nfreq[active[i2]]: i2 = k end
end
idx2 := active[i2]
active[i2] = active[activecount - 1]
activecount--
newidx := nodecount
nfreq[newidx] = nfreq[idx1] + nfreq[idx2]
nleft[newidx] = idx1
nright[newidx] = idx2
nleaf[newidx] = false
nodecount++
active[activecount] = newidx
activecount++
end
root := active[0]
mut stacknode: int[512]
mut stackdepth: int[512]
stacknode[0] = root
stackdepth[0] = 0
mut stacktop := 1
until stacktop > 0:
stacktop--
cur := stacknode[stacktop]
d := stackdepth[stacktop]
if nleaf[cur]:
lengths_out[nsym[cur]] = d
else:
stacknode[stacktop] = nleft[cur]
stackdepth[stacktop] = d + 1
stacktop++
stacknode[stacktop] = nright[cur]
stackdepth[stacktop] = d + 1
stacktop++
end
end
ret distinct
end
@en "HuffmanCompress"
@fa "فشرده سازی هافمن"
pub func HuffmanCompress(p: void*, n: int): ByteBuf:
mut lengths: int[256]
repeat 256 in i: lengths[i] = 0 end
distinct := _huff_lengths(p, n, lengths[:])
mut out := NewByteBuf()
BufPushU32(out, n)
if distinct == 0:
BufPush(out, 0)
ret out
end
BufPush(out, 2)
mut codes: int[256]
repeat 256 in i: codes[i] = 0 end
_huff_canonical_codes(lengths[:], codes[:])
repeat 256 in s:
BufPush(out, lengths[s])
end
mut w := NewBitWriter()
bp := p as u8*
mut i := 0
until i < n:
b := bp[i] as int
len := lengths[b]
code := codes[b]
mut bit := len - 1
until bit >= 0:
BitWriteBit(w, (code >> bit) & 1)
bit--
end
i++
end
BitFlush(w)
BufPushBuf(out, w.buf)
BitWriterFree(w)
ret out
end
@en "HuffmanDecompressMax"
@fa "کدگشایی هافمن با سقف"
pub func HuffmanDecompressMax(p: void*, n: int, max: int, ok &: bool): ByteBuf:
ok = false
mut r := NewByteReader(p, n)
origLen := RdU32(r)
mode := RdByte(r)
if r.bad or not _dec_size_ok(origLen, n, max): ret NewByteBuf() end
mut out := NewByteBufCap(_dec_cap(origLen))
if mode == 0:
ok = origLen == 0
ret out
end
mut lengths: int[256]
repeat 256 in s:
lengths[s] = RdByte(r)
if lengths[s] > 60 or lengths[s] < 0: r.bad = true end
end
if r.bad:
BufFree(out)
ret NewByteBuf()
end
mut codes: int[256]
repeat 256 in i: codes[i] = 0 end
_huff_canonical_codes(lengths[:], codes[:])
mut tleft: int[512]
mut tright: int[512]
mut tsym: int[512]
mut tleaf: bool[512]
repeat _HUFF_MAX_NODES in k:
tleft[k] = -1
tright[k] = -1
tsym[k] = -1
tleaf[k] = false
end
mut nodecount := 1
mut good := true
repeat 256 in s:
len := lengths[s]
if len > 0 and good:
code := codes[s]
mut cur := 0
mut bit := len - 1
until bit >= 0 and good:
b := (code >> bit) & 1
if nodecount >= _HUFF_MAX_NODES - 1:
good = false
else b == 0:
if tleft[cur] < 0:
tleft[cur] = nodecount
nodecount++
end
cur = tleft[cur]
else:
if tright[cur] < 0:
tright[cur] = nodecount
nodecount++
end
cur = tright[cur]
end
bit--
end
if good:
tleaf[cur] = true
tsym[cur] = s
end
end
end
if not good:
BufFree(out)
ret NewByteBuf()
end
remaining := RdLeft(r)
mut br := NewBitReader(((r.data as i64) + (r.pos as i64)) as void*, remaining)
until BufLen(out) < origLen and good:
mut cur := 0
until not tleaf[cur] and good:
bit := BitReadBit(br)
if br.bad:
good = false
else bit == 0:
cur = tleft[cur]
else:
cur = tright[cur]
end
if cur < 0:
good = false
cur = 0
end
end
if good: BufPush(out, tsym[cur]) end
end
if not good:
BufFree(out)
ret NewByteBuf()
end
ok = true
ret out
end
@en "HuffmanDecompress"
@fa "کدگشایی هافمن"
pub func HuffmanDecompress(p: void*, n: int): ByteBuf:
mut ok := false
ret HuffmanDecompressMax(p, n, 0, ok)
end
package compress
const _LZ_WINDOW := 4096
const _LZ_MIN_MATCH := 3
const _LZ_MAX_MATCH := 18
func _lz77_find_match(p: void*, n: int, pos: int, bestlen &: int, bestdist &: int):
bp := p as u8*
bestlen = 0
bestdist = 0
mut winstart := pos - _LZ_WINDOW
if winstart < 0: winstart = 0 end
mut cand := winstart
until cand < pos:
mut len := 0
until len < _LZ_MAX_MATCH and pos + len < n and (bp[cand + len] as int) == (bp[pos + len] as int):
len++
end
if len > bestlen:
bestlen = len
bestdist = pos - cand
end
cand++
end
end
@en "LZ77Compress"
@fa "فشرده سازی الزد۷۷"
pub func LZ77Compress(p: void*, n: int): ByteBuf:
mut out := NewByteBuf()
BufPushU32(out, n)
mut w := NewBitWriter()
bp := p as u8*
mut pos := 0
until pos < n:
mut bestlen := 0
mut bestdist := 0
_lz77_find_match(p, n, pos, bestlen, bestdist)
if bestlen >= _LZ_MIN_MATCH:
BitWriteBit(w, 1)
BitWriteBits(w, bestdist - 1, 12)
BitWriteBits(w, bestlen - _LZ_MIN_MATCH, 4)
pos += bestlen
else:
BitWriteBit(w, 0)
BitWriteBits(w, bp[pos] as int, 8)
pos++
end
end
BitFlush(w)
BufPushBuf(out, w.buf)
BitWriterFree(w)
ret out
end
@en "LZ77DecompressMax"
@fa "کدگشایی الزد۷۷ با سقف"
pub func LZ77DecompressMax(p: void*, n: int, max: int, ok &: bool): ByteBuf:
ok = false
mut r := NewByteReader(p, n)
origLen := RdU32(r)
if r.bad or not _dec_size_ok(origLen, n, max): ret NewByteBuf() end
mut out := NewByteBufCap(_dec_cap(origLen))
remaining := RdLeft(r)
mut br := NewBitReader(((r.data as i64) + (r.pos as i64)) as void*, remaining)
mut good := true
until BufLen(out) < origLen and good:
bit := BitReadBit(br)
if bit == 0:
b := BitReadBits(br, 8)
BufPush(out, b)
else:
dist := BitReadBits(br, 12) + 1
length := BitReadBits(br, 4) + _LZ_MIN_MATCH
start := BufLen(out) - dist
if start < 0:
good = false
else:
mut k := 0
until k < length:
BufPush(out, BufGet(out, start + k))
k++
end
end
end
if br.bad: good = false end
end
if not good or BufLen(out) != origLen:
BufFree(out)
ret NewByteBuf()
end
ok = true
ret out
end
@en "LZ77Decompress"
@fa "کدگشایی الزد۷۷"
pub func LZ77Decompress(p: void*, n: int): ByteBuf:
mut ok := false
ret LZ77DecompressMax(p, n, 0, ok)
end
package compress
import mem
const _LZ_ISMATCH := 0
const _LZ_ISREP := 192
const _LZ_ISREPG0 := 204
const _LZ_ISREPG1 := 216
const _LZ_ISREPG2 := 228
const _LZ_ISREP0LONG := 240
const _LZ_POSSLOT := 432
const _LZ_SPECPOS := 688
const _LZ_ALIGN := 816
const _LZ_LENMATCH := 832
const _LZ_LENREP := 1346
const _LZ_LITERAL := 1860
const _LZ_MAXLCP := 4
const _LZ_NOLIMIT := 0x3FFFF000
@en "LzmaMaxDictSize"
@fa "بیشینه اندازه واژه نامه الزد ام ای"
pub const LzmaMaxDictSize := 1073741824
struct _Lz:
pub ip: u8*
pub ipos: int
pub iend: int
pub rng: i64
pub code: i64
pub bad: bool
pub over: bool
pub probs: u16*
pub nprobs: int
pub lc: int
pub lp: int
pub pb: int
pub state: int
pub rep0: int
pub rep1: int
pub rep2: int
pub rep3: int
pub dsize: i64
pub dstart: int
pub ffp: void*
pub foff: i64
pub fleft: i64
pub refill: bool
pub ibuf: u8*
pub win: u8*
pub wsize: int
pub wpos: int
pub wfl: int
pub total: i64
pub dstart_t: i64
end
func _lz_new(dsize: i64): _Lz:
ret _Lz {
ip = null as u8*, ipos = 0, iend = 0, rng = 0xFFFFFFFF as i64, code = 0 as i64, bad = false, over = false
probs = null as u16*, nprobs = 0, lc = 0, lp = 0, pb = 0, state = 0
rep0 = 0, rep1 = 0, rep2 = 0, rep3 = 0, dsize = dsize, dstart = 0
ffp = null, foff = 0 as i64, fleft = 0 as i64, refill = false, ibuf = null as u8*
win = null as u8*, wsize = 0, wpos = 0, wfl = 0, total = 0 as i64, dstart_t = 0 as i64
}
end
func _lz_free(d &: _Lz):
if d.probs != null:
mem.Free(d.probs as void*)
end
d.probs = null as u16*
d.nprobs = 0
end
func _lz_alloc(d &: _Lz, lcp: int):
need := _LZ_LITERAL + (768 << lcp)
if d.probs != null and d.nprobs >= need:
ret
end
if d.probs != null:
mem.Free(d.probs as void*)
end
d.probs = mem.Allocate((need * 2) as u64) as u16*
d.nprobs = need
end
func _lz_reset_state(d &: _Lz):
total := _LZ_LITERAL + (768 << (d.lc + d.lp))
mut i := 0
until i < total:
d.probs[i] = 1024 as u16
i++
end
d.state = 0
d.rep0 = 0
d.rep1 = 0
d.rep2 = 0
d.rep3 = 0
end
func _lz_set_props(d &: _Lz, pbyte: int, maxlcp: int): bool:
if pbyte >= 225:
ret false
end
lc := pbyte % 9
rest := pbyte / 9
lp := rest % 5
pb := rest / 5
if lc + lp > maxlcp:
ret false
end
d.lc = lc
d.lp = lp
d.pb = pb
ret true
end
func _lz_rc_init(d &: _Lz, p: void*, start: int, endp: int): bool:
if endp - start < 5:
ret false
end
d.ip = p as u8*
d.ipos = start
d.iend = endp
d.bad = false
if (d.ip[start] as int) != 0:
ret false
end
d.code = ((d.ip[start + 1] as i64) << 24) | ((d.ip[start + 2] as i64) << 16) | ((d.ip[start + 3] as i64) << 8) | (d.ip[start + 4] as i64)
d.rng = 0xFFFFFFFF as i64
d.ipos = start + 5
ret true
end
func _lz_refill(d &: _Lz): bool:
if d.fleft <= (0 as i64) or d.ibuf == null:
ret false
end
want := d.fleft > (65536 as i64) ? 65536 : (d.fleft as int)
got := FileReadAt(d.ffp, d.foff, d.ibuf as void*, want)
if got <= 0:
ret false
end
d.foff += got as i64
d.fleft -= got as i64
d.ip = d.ibuf
d.ipos = 0
d.iend = got
ret true
end
inline func _lz_norm(d &: _Lz):
if d.rng < 16777216:
d.rng = (d.rng << 8) & 0xFFFFFFFF
mut b := 0 as i64
if d.ipos < d.iend:
b = d.ip[d.ipos] as i64
d.ipos++
else d.refill and _lz_refill(d):
b = d.ip[0] as i64
d.ipos = 1
else:
d.bad = true
end
d.code = ((d.code << 8) | b) & 0xFFFFFFFF
end
end
inline func _lz_bit(d &: _Lz, idx: int): int:
_lz_norm(d)
prob := d.probs[idx] as i64
bound := (d.rng >> 11) * prob
if d.code < bound:
d.rng = bound
d.probs[idx] = (prob + ((2048 - prob) >> 5)) as u16
ret 0
end
d.rng -= bound
d.code -= bound
d.probs[idx] = (prob - (prob >> 5)) as u16
ret 1
end
func _lz_tree(d &: _Lz, base: int, nbits: int): int:
mut m := 1
mut i := 0
until i < nbits:
m = (m << 1) + _lz_bit(d, base + m)
i++
end
ret m - (1 << nbits)
end
func _lz_rtree(d &: _Lz, base: int, nbits: int): int:
mut m := 1
mut sym := 0
mut i := 0
until i < nbits:
bit := _lz_bit(d, base + m)
m = (m << 1) + bit
sym |= (bit << i)
i++
end
ret sym
end
func _lz_len(d &: _Lz, base: int, pos_state: int): int:
if _lz_bit(d, base) == 0:
ret _lz_tree(d, base + 2 + pos_state * 8, 3)
end
if _lz_bit(d, base + 1) == 0:
ret 8 + _lz_tree(d, base + 130 + pos_state * 8, 3)
end
ret 16 + _lz_tree(d, base + 258, 8)
end
func _lz_dist(d &: _Lz, len: int): i64:
mut ls := len
if ls > 3:
ls = 3
end
slot := _lz_tree(d, _LZ_POSSLOT + ls * 64, 6)
if slot < 4:
ret slot
end
nb := (slot >> 1) - 1
mut dist := ((2 | (slot & 1)) as i64) << nb
if slot < 14:
dist += (_lz_rtree(d, _LZ_SPECPOS + (dist as int) - slot - 1, nb) as i64)
ret dist
end
mut r := 0 as i64
mut i := 0
until i < nb - 4:
_lz_norm(d)
d.rng >>= 1
if d.code >= d.rng:
d.code -= d.rng
r = (r << 1) | (1 as i64)
else:
r <<= 1
end
i++
end
dist += (r << 4)
dist += (_lz_rtree(d, _LZ_ALIGN, 4) as i64)
ret dist
end
func _lz_run(d &: _Lz, out &: ByteBuf, limit: int, allow_end: bool): int:
mut pos := out.len
pb_mask := (1 << d.pb) - 1
lp_mask := (1 << d.lp) - 1
lc := d.lc
until pos < limit:
if d.bad:
out.len = pos
ret -1
end
if pos + 280 > out.cap:
out.len = pos
_buf_grow(out, 280)
end
buf := out.data as u8*
rel := pos - d.dstart
pos_state := rel & pb_mask
st := d.state
if _lz_bit(d, _LZ_ISMATCH + st * 16 + pos_state) == 0:
mut prev := 0
if rel > 0:
prev = buf[pos - 1] as int
end
lit_state := ((rel & lp_mask) << lc) + (prev >> (8 - lc))
base := _LZ_LITERAL + 768 * lit_state
mut sym := 1
if st >= 7:
mut mb := buf[pos - d.rep0 - 1] as int
mut offs := 256
until sym < 256:
mb <<= 1
mbit := mb & offs
bit := _lz_bit(d, base + offs + mbit + sym)
sym = (sym << 1) | bit
if bit == 0:
offs &= (mbit ^ 0xFFFF)
else:
offs &= mbit
end
end
else:
until sym < 256:
sym = (sym << 1) | _lz_bit(d, base + sym)
end
end
