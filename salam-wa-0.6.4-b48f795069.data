out[1] = r1
out[2] = r2
out[3] = r3
out[4] = r4
out[5] = r5
end
func _m_set(m: f64[], a: f64, b: f64, c: f64, d: f64, e: f64, f: f64):
m[0] = a
m[1] = b
m[2] = c
m[3] = d
m[4] = e
m[5] = f
end
func _m_then(m: f64[], a: f64, b: f64, c: f64, d: f64, e: f64, f: f64):
