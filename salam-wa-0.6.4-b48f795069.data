BufPush(out, 0x28)
BufPush(out, 0xB5)
BufPush(out, 0x2F)
BufPush(out, 0xFD)
mut fcsf := 2
if single:
fcsf = 0
if len > (255 as i64):
fcsf = 1
end
if len > (65791 as i64):
fcsf = 2
end
else len >= (4294967296 as i64):
fcsf = 3
end
mut fhd := fcsf << 6
if single:
fhd |= 32
end
fhd |= 4
BufPush(out, fhd)
if not single:
BufPush(out, (wlog - 10) << 3)
end
mut fsz := 1
if fcsf == 1:
fsz = 2
else fcsf == 2:
fsz = 4
else fcsf == 3:
fsz = 8
end
mut fv := len
if fcsf == 1:
fv -= (256 as i64)
end
repeat fsz in i:
BufPush(out, ((fv >> (8 * i)) & (255 as i64)) as int)
end
if len == (0 as i64):
BufPush(out, 1)
BufPush(out, 0)
BufPush(out, 0)
end
mut xx := _xxs_new()
mut ok := SinkWrite(sink, out.data, out.len)
BufReset(out)
mut bs := 0
mut filled := 0
mut at := off
