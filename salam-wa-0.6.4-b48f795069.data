saved.free()
if env_block != null: mem.Free(env_block) end
if wide_cwd != null: mem.Free(wide_cwd) end
if own_in: fdio.Close(h_in) end
if own_out: fdio.Close(h_out) end
if own_err: fdio.Close(h_err) end
if ok == 0:
fdio.Close(p_in)
fdio.Close(p_out)
fdio.Close(p_err)
ret _fail(ch, "CreateProcess failed", c.program)
end
ch.pid = _u32_at(pi, _pi_pid_at()) as int
ch.h_proc = _ptr_at(pi, 0) as i64
_t := CloseHandle(_ptr_at(pi, _word()))
ch.ok = true
ch.h_in = p_in
ch.h_out = p_out
ch.h_err = p_err
ret ch
end
else:
func _open_null(flags: int): int:
fd := open("/dev/null", flags, 0)
if fd >= 0:
_c := fcntl(fd, 2, 1)
end
ret fd
end
func _launch(c: Command): Child:
mut ch := Child {}
if c.program.len() == 0: ret _fail(ch, "no program given", c.program) end
if not _sigpipe_ignored:
_prev := signal(13, (1 as i64) as void*)
_sigpipe_ignored = true
end
resolved := fdio.Resolve(c.program, c.env, c.clear_env)
if resolved.len() == 0:
mem.Free(resolved as void*)
ret _fail(ch, "program not found", c.program)
end
mut c_in := -1
mut c_out := -1
mut c_err := -1
mut p_in := -1
mut p_out := -1
mut p_err := -1
mut bad := false
if c.stdin_mode == 1:
pp := fdio.MakePipe()
if pp.ok:
c_in = pp.r as int
p_in = pp.w as int
else:
bad = true
end
else c.stdin_mode == 2:
c_in = _open_null(0)
end
if c.stdout_mode == 1:
pp := fdio.MakePipe()
if pp.ok:
c_out = pp.w as int
p_out = pp.r as int
else:
bad = true
end
else c.stdout_mode == 2:
c_out = _open_null(1)
end
if c.stderr_mode == 1:
pp := fdio.MakePipe()
if pp.ok:
c_err = pp.w as int
p_err = pp.r as int
else:
bad = true
end
else c.stderr_mode == 2:
c_err = _open_null(1)
end
ep := fdio.MakePipe()
if not ep.ok: bad = true end
if bad:
fdio.Close(c_in as i64)
fdio.Close(c_out as i64)
fdio.Close(c_err as i64)
fdio.Close(p_in as i64)
fdio.Close(p_out as i64)
fdio.Close(p_err as i64)
fdio.Close(ep.r)
fdio.Close(ep.w)
mem.Free(resolved as void*)
ret _fail(ch, "cannot create the pipes", c.program)
end
argv := fdio.BuildArgv(c.program, c.args)
mut owned := Vector {} as Vector<str>
envp := fdio.BuildEnvp(c.clear_env, c.env, c.unset_env, owned)
use_env := envp == null ? fdio.Environ() : envp
merge := c.stderr_mode == 3
wmark := mem.AllocateZeroed(1 as u64)
pid := fork()
if pid == 0:
if c.new_group:
_g := setpgid(0, 0)
end
mut stage := 0
if c.cwd.len() > 0 and chdir(c.cwd) != 0:
stage = 1
end
if stage == 0:
if c_in >= 0: fdio.Redirect(c_in, 0) end
if c_out >= 0: fdio.Redirect(c_out, 1) end
if merge:
fdio.Redirect(1, 2)
else c_err >= 0:
fdio.Redirect(c_err, 2)
end
_gone := fdio.ExecVe(resolved, argv, use_env)
stage = 2
end
(wmark as u8*)[0] = stage as u8
_w := fdio.WriteRaw(ep.w, wmark, 1)
_exit(127)
end
fdio.Close(c_in as i64)
fdio.Close(c_out as i64)
fdio.Close(c_err as i64)
fdio.Close(ep.w)
mem.Free(argv)
mem.Free(wmark)
if envp != null: mem.Free(envp) end
each line in owned:
mem.Free(line as void*)
end
owned.free()
mem.Free(resolved as void*)
if pid < 0:
fdio.Close(p_in as i64)
fdio.Close(p_out as i64)
fdio.Close(p_err as i64)
fdio.Close(ep.r)
ret _fail(ch, "fork failed", c.program)
end
if c.new_group:
_g2 := setpgid(pid, pid)
end
mark := mem.AllocateZeroed(1 as u64)
got := fdio.ReadRaw(ep.r, mark, 1)
fail_stage := (mark as u8*)[0] as int
mem.Free(mark)
fdio.Close(ep.r)
if got > 0:
statusbuf := mem.AllocateZeroed(4 as u64)
_reaped := waitpid(pid, statusbuf, 0)
mem.Free(statusbuf)
fdio.Close(p_in as i64)
fdio.Close(p_out as i64)
fdio.Close(p_err as i64)
if fail_stage == 1: ret _fail(ch, "cannot enter the folder", c.program) end
ret _fail(ch, "cannot run the program", c.program)
end
ch.pid = pid
ch.ok = true
ch.h_in = p_in as i64
ch.h_out = p_out as i64
ch.h_err = p_err as i64
ret ch
end
end
@en "Launch"
@fa "اجرای فرزند"
pub func Launch(c: Command): Child:
ret _launch(c)
end
@en "NewCommand"
@fa "فرمان تازه"
pub func NewCommand(program: str): Command:
ret Command { program = program }
end
@en "RunCommand"
@fa "اجرای فرمان با مهلت"
pub func RunCommand(c: Command, text: str, timeout_ms: int): RunResult:
mut cmd := c
cmd.stdin_mode = 1
cmd.stdout_mode = 1
if cmd.stderr_mode != 3: cmd.stderr_mode = 1 end
cmd.new_group = true
mut ch := Launch(cmd)
if not ch.ok: ret RunResult {} end
deadline := _now() + (timeout_ms as i64)
in_len := text.len()
mut in_off := 0
mut out_eof := ch.h_out < 0
mut err_eof := ch.h_err < 0
mut timed_out := false
if in_len == 0: ch.CloseStdin() end
until true:
if ch.h_in >= 0:
if fdio.PollWrite(ch.h_in, 0) > 0:
mut piece := in_len - in_off
if piece > 512: piece = 512 end
w := fdio.WriteRaw(ch.h_in, ((text as void*) as i64 + in_off as i64) as void*, piece)
if w <= 0:
in_off = in_len
else:
in_off += w
end
end
if in_off >= in_len: ch.CloseStdin() end
end
if out_eof and err_eof: break end
left := _left(deadline, timeout_ms)
if timeout_ms >= 0 and left == 0:
timed_out = true
break
end
mut slice := left
if ch.h_in >= 0 and (slice < 0 or slice > 2): slice = 2 end
mask := fdio.PollTwo(out_eof ? -1 : ch.h_out, err_eof ? -1 : ch.h_err, slice)
if mask < 0: break end
if (mask & 1) != 0 and fdio.Fill(ch.out_buf, ch.h_out, 0) < 0: out_eof = true end
if (mask & 2) != 0 and fdio.Fill(ch.err_buf, ch.h_err, 0) < 0: err_eof = true end
end
if not timed_out:
st := ch.Wait(_left(deadline, timeout_ms))
if st.timed_out: timed_out = true end
end
if timed_out:
_k := ch.KillGroup()
_k2 := ch.Kill()
_st := ch.Wait(0 - 1)
mut more := true
until more:
more = fdio.Fill(ch.out_buf, ch.h_out, 0) > 0
end
more = true
until more:
more = fdio.Fill(ch.err_buf, ch.h_err, 0) > 0
end
end
mut status := ch.status
status.timed_out = timed_out
out := _take_all(ch.out_buf, true)
err := _take_all(ch.err_buf, true)
ch.Close()
ret RunResult { started = true, status = status, stdout = out.data, stderr = err.data, timed_out = timed_out }
end
@en "RunTimeout"
@fa "اجرا با مهلت"
pub func RunTimeout(program: str, args: Vector<str>, text: str, timeout_ms: int): RunResult:
cmd := Command { program = program, args = args }
ret RunCommand(cmd, text, timeout_ms)
end
@en "process"
@fa "فرآیند"
package process
import mem
import str
import io
import os
import os.error
import os.temp
if SALAM_OS_WINDOWS:
link dynamic "kernel32"
extern:
func CreateProcessA(app: void*, cmdline: void*, pattr: void*, tattr: void*, inherit: int, flags: int, envp: void*, cwd: void*, si: void*, pi: void*): int
func WaitForSingleObject(h: void*, ms: int): int
func GetExitCodeProcess(h: void*, code: void*): int
func TerminateProcess(h: void*, code: int): int
func CloseHandle(h: void*): int
func GetLastError(): int
noret func ExitProcess(code: int)
func CreateFileW(path: void*, access: u32, share: u32, security: void*, disposition: u32, flags: u32, template: void*): void*
end
else:
extern:
func waitpid(pid: int, status: void*, options: int): int
func kill(pid: int, sig: int): int
func fork(): int
noret func _exit(code: int)
end
if SALAM_OS_ANDROID:
extern:
func pipe2(fds: void*, flags: int): int
func read(fd: int, buf: void*, n: size): i64
func write(fd: int, buf: void*, n: size): i64
func __errno(): int*
end
end
if not SALAM_OS_ANDROID:
extern:
environ: void*
func posix_spawnp(pid: void*, file: str, file_actions: void*, attrp: void*, argv: void*, envp: void*): int
func posix_spawn_file_actions_init(actions: void*): int
func posix_spawn_file_actions_destroy(actions: void*): int
func posix_spawn_file_actions_addopen(actions: void*, fd: int, path: str, flags: int, mode: int): int
end
end
end
@en "Process"
@fa "فرآیند"
pub struct Process:
@en "pid"
@fa "شناسه"
pub pid: int = 0
@en "handle"
@fa "دسته"
pub handle: void* = null
@en "running"
@fa "فعال"
pub running: bool = false
@en "exit_code"
@fa "کد خروج"
pub exit_code: int = 0
@en "stdout_path"
@fa "مسیر خروجی"
pub stdout_path: str = ""
@en "stderr_path"
@fa "مسیر خروجی خطا"
pub stderr_path: str = ""
end
func _strptr(s: str): i64:
v := s as void*
ret v as i64
end
if SALAM_OS_WINDOWS:
func _u32_at(base: void*, off: i64): u32:
p := ((base as i64) + off) as u32*
ret p[0]
end
func _u32_set(base: void*, off: i64, v: u32):
p := ((base as i64) + off) as u32*
p[0] = v
end
func _ptr_at(base: void*, off: i64): void*:
p := ((base as i64) + off) as void**
ret p[0]
end
func _ptr_set(base: void*, off: i64, v: void*):
p := ((base as i64) + off) as void**
p[0] = v
end
func _word(): i64:
ret sizeof(void*) as i64
end
func _si_size(): i64:
ret _word() == 8 ? 104 as i64 : 68 as i64
end
func _si_flags_at(): i64:
ret _word() == 8 ? 60 as i64 : 44 as i64
end
func _si_handles_at(): i64:
ret _word() == 8 ? 80 as i64 : 56 as i64
end
func _pi_pid_at(): i64:
ret _word() * 2
end
func _needs_quotes(s: str): bool:
if s.len() == 0: ret true end
ret str.Contains(s, " ")
end
func _append_token(sb &: str.StringBuilder, tok: str):
if _needs_quotes(tok):
str.BufAppendChar(sb, 34)
str.BufAppend(sb, tok)
str.BufAppendChar(sb, 34)
else:
str.BufAppend(sb, tok)
end
end
func _build_cmdline(path: str, args: Vector<str>): str:
mut sb := str.NewBuilder()
_append_token(sb, path)
n := args.len()
mut i := 0
until i < n:
str.BufAppendChar(sb, 32)
_append_token(sb, args.get(i))
i++
end
out := str.BufStr(sb)
str.BufFree(sb)
ret out
end
func _build_sa(): void*:
word := _word()
sa := mem.AllocateZeroed(24 as u64)
_u32_set(sa, 0, (word * 3) as u32)
_u32_set(sa, word * 2, 1 as u32)
ret sa
end
func _open_inheritable(path: str, access: u32, disp: u32): void*:
sa := _build_sa()
wide := _spawn_wide(path)
h := CreateFileW(wide, access, 3 as u32, sa, disp, 128 as u32, null)
mem.Free(wide)
mem.Free(sa)
if (h as size) == -1: ret null end
ret h
end
else:
func _build_argv(path: str, args: Vector<str>): void*:
n := args.len()
arr := mem.Allocate(((n + 2) as u64) * (sizeof(str) as u64)) as str*
arr[0] = path
mut i := 0
until i < n:
arr[i + 1] = args.get(i)
i++
end
arr[n + 1] = (null as void*) as str
ret arr as void*
end
func _open_flags(): int:
if SALAM_OS_MAC or SALAM_OS_BSD: ret 1 + 512 + 1024 else:
ret 1 + 64 + 512
end
end
if SALAM_OS_ANDROID:
func _spawn_posix(path: str, argv: void*, capture: bool, out_path: str, err_path: str): int:
mut in_fd := 0 - 1
mut out_fd := 0 - 1
mut err_fd := 0 - 1
if capture:
in_fd = open("/dev/null", 0, 0)
out_fd = open(out_path, _open_flags(), 420)
err_fd = open(err_path, _open_flags(), 420)
end
status := mem.AllocateZeroed(8 as u64)
sp := status as int*
sp[0] = 0 - 1
sp[1] = 0 - 1
if pipe2(status, 524288) != 0:
sp[0] = 0 - 1
sp[1] = 0 - 1
end
pid := fork()
if pid == 0:
if capture:
_i0 := dup2(in_fd, 0)
_o1 := dup2(out_fd, 1)
_e2 := dup2(err_fd, 2)
if in_fd > 2: close(in_fd) end
if out_fd > 2: close(out_fd) end
if err_fd > 2: close(err_fd) end
end
_gone := execvp(path, argv)
eno := __errno()
eb := mem.Allocate(4 as u64) as int*
eb[0] = eno[0]
_w := write(sp[1], eb as void*, 4 as size)
_exit(127)
end
if in_fd >= 0: close(in_fd) end
if out_fd >= 0: close(out_fd) end
if err_fd >= 0: close(err_fd) end
rfd := sp[0]
wfd := sp[1]
if wfd >= 0: close(wfd) end
mut failed := 0
if pid > 0 and rfd >= 0:
eb := mem.AllocateZeroed(4 as u64)
n := read(rfd, eb, 4 as size)
if n == (4 as i64):
failed = (eb as int*)[0]
if failed == 0: failed = 1 end
end
mem.Free(eb)
end
if rfd >= 0: close(rfd) end
mem.Free(status)
if pid < 0: ret 0 - 1 end
if failed != 0:
reaped := mem.AllocateZeroed(4 as u64)
waitpid(pid, reaped, 0)
mem.Free(reaped)
ret 0 - failed
end
ret pid
end
else:
func _spawn_posix(path: str, argv: void*, capture: bool, out_path: str, err_path: str): int:
pidbuf := mem.AllocateZeroed(4 as u64)
mut actions := null as void*
if capture:
actions = mem.AllocateZeroed(256 as u64)
posix_spawn_file_actions_init(actions)
posix_spawn_file_actions_addopen(actions, 0, "/dev/null", 0, 0)
posix_spawn_file_actions_addopen(actions, 1, out_path, _open_flags(), 420)
posix_spawn_file_actions_addopen(actions, 2, err_path, _open_flags(), 420)
end
rc := posix_spawnp(pidbuf, path, actions, null, argv, environ)
if capture:
posix_spawn_file_actions_destroy(actions)
mem.Free(actions)
end
pidp := pidbuf as int*
pid := pidp[0]
mem.Free(pidbuf)
if rc != 0: ret 0 - rc end
ret pid
end
end
end
