c.anchor = c.caret
c.text_scroll = 0.0
end
if _has_attr(od, o, "checked") != _has_attr(nd, n, "checked"):
c.has_checked = false
end
if tag == "select":
mut changed := false
ok := od.nodes[o].kids.len()
if ok != nd.nodes[n].kids.len():
changed = true
end
if changed:
