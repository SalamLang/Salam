pub yo: Vector<int> = Vector {}
pub att: Vector<int> = Vector {}
pub next_lig: int = 1
end
struct _Ctx:
pub table: int = 0
pub gsub: bool = true
pub flag: int = 0
pub mark_set: int = -1
pub depth: int = 0
end
func _r16(f: Font, off: int): int:
ret _ttf_u16(f.data, f.size, off)
end
func _rs16(f: Font, off: int): int:
ret _ttf_i16(f.data, f.size, off)
end
func _r32(f: Font, off: int): int:
ret _ttf_u32(f.data, f.size, off)
end
func _tag(s: str): int:
bp := s as u8*
mut t := 0
mut i := 0
mut ended := false
until i < 4:
mut c := 32
if not ended:
c = bp[i] as int
if c == 0:
ended = true
c = 32
end
end
t = (t << 8) | c
i++
end
ret t
end
func _buf_free(b &: _Buf):
b.g.free()
b.cl.free()
b.cp.free()
b.mask.free()
b.cls.free()
b.lig_id.free()
b.lig_comp.free()
b.xa.free()
b.xo.free()
b.yo.free()
b.att.free()
end
func _buf_push(b &: _Buf, gid: int, cl: int, cp: int, mask: int, cls: int):
b.g.push(gid)
b.cl.push(cl)
b.cp.push(cp)
b.mask.push(mask)
b.cls.push(cls)
b.lig_id.push(0)
b.lig_comp.push(0)
b.xa.push(0)
b.xo.push(0)
b.yo.push(0)
b.att.push(-1)
end
func _buf_insert_copy(b &: _Buf, i: int, gid: int):
b.g.insert(i + 1, gid)
b.cl.insert(i + 1, b.cl.get(i))
b.cp.insert(i + 1, b.cp.get(i))
b.mask.insert(i + 1, b.mask.get(i))
b.cls.insert(i + 1, b.cls.get(i))
b.lig_id.insert(i + 1, b.lig_id.get(i))
b.lig_comp.insert(i + 1, b.lig_comp.get(i))
b.xa.insert(i + 1, 0)
b.xo.insert(i + 1, 0)
b.yo.insert(i + 1, 0)
b.att.insert(i + 1, -1)
end
func _buf_insert_at(b &: _Buf, at: int, gid: int, cl: int, cp: int, mask: int, cls: int):
b.g.insert(at, gid)
b.cl.insert(at, cl)
b.cp.insert(at, cp)
b.mask.insert(at, mask)
b.cls.insert(at, cls)
b.lig_id.insert(at, 0)
b.lig_comp.insert(at, 0)
b.xa.insert(at, 0)
b.xo.insert(at, 0)
b.yo.insert(at, 0)
b.att.insert(at, -1)
end
func _buf_remove(b &: _Buf, i: int):
b.g.remove_at(i)
b.cl.remove_at(i)
b.cp.remove_at(i)
b.mask.remove_at(i)
b.cls.remove_at(i)
b.lig_id.remove_at(i)
b.lig_comp.remove_at(i)
b.xa.remove_at(i)
b.xo.remove_at(i)
b.yo.remove_at(i)
b.att.remove_at(i)
end
func _coverage(f: Font, cov: int, g: int): int:
if cov == 0:
ret -1
end
fmt := _r16(f, cov)
n := _r16(f, cov + 2)
mut lo := 0
mut hi := n
if fmt == 1:
until lo < hi:
mid := (lo + hi) / 2
v := _r16(f, cov + 4 + mid * 2)
if g < v:
hi = mid
else g > v:
lo = mid + 1
else:
ret mid
end
end
ret -1
end
if fmt == 2:
until lo < hi:
mid := (lo + hi) / 2
rec := cov + 4 + mid * 6
if g < _r16(f, rec):
hi = mid
else g > _r16(f, rec + 2):
lo = mid + 1
else:
ret _r16(f, rec + 4) + g - _r16(f, rec)
end
end
end
ret -1
end
func _classdef(f: Font, cd: int, g: int): int:
if cd == 0:
ret 0
end
fmt := _r16(f, cd)
if fmt == 1:
start := _r16(f, cd + 2)
count := _r16(f, cd + 4)
if g >= start and g < start + count:
ret _r16(f, cd + 6 + (g - start) * 2)
end
ret 0
end
if fmt == 2:
n := _r16(f, cd + 2)
mut lo := 0
mut hi := n
until lo < hi:
mid := (lo + hi) / 2
rec := cd + 4 + mid * 6
if g < _r16(f, rec):
hi = mid
else g > _r16(f, rec + 2):
lo = mid + 1
else:
ret _r16(f, rec + 4)
end
end
end
ret 0
end
func _gdef_off(f: Font, field: int): int:
if f.gdef == 0:
ret 0
end
o := _r16(f, f.gdef + field)
if o == 0:
ret 0
end
ret f.gdef + o
end
func _glyph_class(f: Font, g: int, cp: int): int:
cd := _gdef_off(f, 4)
if cd != 0:
ret _classdef(f, cd, g)
end
if cp >= 0 and unicode.IsMark(cp):
ret 3
end
ret 1
end
func _mark_attach_class(f: Font, g: int): int:
cd := _gdef_off(f, 10)
if cd == 0:
ret 0
end
ret _classdef(f, cd, g)
end
func _in_mark_set(f: Font, set_index: int, g: int): bool:
if f.gdef == 0 or _r16(f, f.gdef + 2) < 2:
ret false
end
msd := _gdef_off(f, 12)
if msd == 0 or set_index >= _r16(f, msd + 2):
ret false
end
ret _coverage(f, msd + _r32(f, msd + 4 + set_index * 4), g) >= 0
end
func _skippable(f: Font, c: _Ctx, b &: _Buf, i: int): bool:
if b.cp.get(i) == 0x200D:
ret true
end
k := b.cls.get(i)
if k == 1 and (c.flag & _LF_IGNORE_BASE) != 0: ret true end
if k == 2 and (c.flag & _LF_IGNORE_LIGS) != 0: ret true end
if k == 3:
if (c.flag & _LF_IGNORE_MARKS) != 0: ret true end
if (c.flag & _LF_FILTER_SET) != 0 and c.mark_set >= 0:
ret not _in_mark_set(f, c.mark_set, b.g.get(i))
end
mat := (c.flag >> 8) & 0xFF
if mat != 0 and _mark_attach_class(f, b.g.get(i)) != mat:
ret true
end
end
ret false
end
func _next_idx(f: Font, c: _Ctx, b &: _Buf, i: int): int:
mut j := i + 1
until j < b.g.len():
if not _skippable(f, c, b, j):
ret j
end
j++
end
ret -1
end
func _prev_idx(f: Font, c: _Ctx, b &: _Buf, i: int): int:
mut j := i - 1
until j >= 0:
if not _skippable(f, c, b, j):
ret j
end
j--
end
ret -1
end
func _lookup_off(f: Font, table: int, index: int): int:
ll := table + _r16(f, table + 8)
if index < 0 or index >= _r16(f, ll):
ret 0
end
ret ll + _r16(f, ll + 2 + index * 2)
end
func _script_off(f: Font, table: int, tag: int): int:
sl := table + _r16(f, table + 4)
n := _r16(f, sl)
mut i := 0
until i < n:
rec := sl + 2 + i * 6
if _r32(f, rec) == tag:
ret sl + _r16(f, rec + 4)
end
i++
end
ret 0
end
func _langsys_off(f: Font, table: int, script_tag: int, lang_tag: int): int:
mut sc := _script_off(f, table, script_tag)
if sc == 0: sc = _script_off(f, table, _tag("DFLT")) end
if sc == 0: sc = _script_off(f, table, _tag("dflt")) end
if sc == 0: sc = _script_off(f, table, _tag("latn")) end
if sc == 0:
ret 0
end
if lang_tag != 0:
n := _r16(f, sc + 2)
mut i := 0
until i < n:
rec := sc + 4 + i * 6
if _r32(f, rec) == lang_tag:
ret sc + _r16(f, rec + 4)
end
i++
end
end
d := _r16(f, sc)
if d == 0:
ret 0
end
ret sc + d
end
func _has_script(f: Font, table: int, script_tag: int): bool:
if table == 0:
ret false
end
ret _script_off(f, table, script_tag) != 0
end
func _feature_lookups(f: Font, table: int, langsys: int, ftag: int, out &: Vector<int>): bool:
if langsys == 0:
ret false
end
fl := table + _r16(f, table + 6)
nfeat := _r16(f, fl)
req := _r16(f, langsys + 2)
cnt := _r16(f, langsys + 4)
mut found := false
mut k := -1
until k < cnt:
mut fi := 0
if k < 0:
fi = req
else:
fi = _r16(f, langsys + 6 + k * 2)
end
k++
if fi == 0xFFFF or fi >= nfeat:
continue
end
rec := fl + 2 + fi * 6
if _r32(f, rec) != ftag:
continue
end
feat := fl + _r16(f, rec + 4)
lc := _r16(f, feat + 2)
mut j := 0
until j < lc:
out.push(_r16(f, feat + 4 + j * 2))
j++
end
found = true
end
ret found
end
func _anchor(f: Font, a: int, x &: int, y &: int):
x = _rs16(f, a + 2)
y = _rs16(f, a + 4)
end
package typeset
func _match_one(f: Font, g: int, v: int, kind: int, cd: int, base: int): bool:
if kind == 0: ret g == v end
if kind == 1: ret _classdef(f, cd, g) == v end
ret _coverage(f, base + v, g) >= 0
end
func _match_input(f: Font, c: _Ctx, b &: _Buf, i: int, count: int, arr: int, kind: int, cd: int, base: int, pos &: Vector<int>): bool:
pos.clear()
pos.push(i)
mut j := i
mut k := 1
until k < count:
j = _next_idx(f, c, b, j)
if j < 0:
ret false
end
if not _match_one(f, b.g.get(j), _r16(f, arr + (k - 1) * 2), kind, cd, base):
ret false
end
pos.push(j)
k++
end
ret true
end
func _match_back(f: Font, c: _Ctx, b &: _Buf, i: int, count: int, arr: int, kind: int, cd: int, base: int): bool:
mut j := i
mut k := 0
until k < count:
j = _prev_idx(f, c, b, j)
if j < 0:
ret false
end
if not _match_one(f, b.g.get(j), _r16(f, arr + k * 2), kind, cd, base):
ret false
end
k++
end
ret true
end
func _match_ahead(f: Font, c: _Ctx, b &: _Buf, last: int, count: int, arr: int, kind: int, cd: int, base: int): bool:
mut j := last
mut k := 0
until k < count:
j = _next_idx(f, c, b, j)
if j < 0:
ret false
end
if not _match_one(f, b.g.get(j), _r16(f, arr + k * 2), kind, cd, base):
ret false
end
k++
end
ret true
end
func _apply_records(f: Font, c: _Ctx, b &: _Buf, pos &: Vector<int>, nrec: int, recs: int): int:
mut r := 0
until r < nrec:
seq := _r16(f, recs + r * 4)
lidx := _r16(f, recs + r * 4 + 2)
r++
if seq >= pos.len():
continue
end
p := pos.get(seq)
if p < 0 or p >= b.g.len():
continue
end
before := b.g.len()
_apply_lookup_at(f, c.table, c.gsub, lidx, b, p, c.depth + 1)
d := b.g.len() - before
if d != 0:
mut q := seq + 1
until q < pos.len():
pos.set(q, pos.get(q) + d)
q++
end
end
end
mut nxt := pos.get(pos.len() - 1) + 1
if nxt <= pos.get(0):
nxt = pos.get(0) + 1
end
if nxt > b.g.len():
nxt = b.g.len()
end
ret nxt
end
func _context_rules(f: Font, c: _Ctx, b &: _Buf, i: int, rs: int, kind: int, cd: int, chain: bool, bcd: int, lcd: int): int:
if rs == 0:
ret -1
end
nrules := _r16(f, rs)
mut pos := Vector {} as Vector<int>
defer pos.free()
mut k := 0
until k < nrules:
rule := rs + _r16(f, rs + 2 + k * 2)
k++
if not chain:
gc := _r16(f, rule)
sc := _r16(f, rule + 2)
if gc == 0:
continue
end
if _match_input(f, c, b, i, gc, rule + 4, kind, cd, 0, pos):
ret _apply_records(f, c, b, pos, sc, rule + 4 + (gc - 1) * 2)
end
continue
end
bc := _r16(f, rule)
barr := rule + 2
ic_at := barr + bc * 2
ic := _r16(f, ic_at)
iarr := ic_at + 2
lc_at := iarr + (ic - 1) * 2
lc := _r16(f, lc_at)
larr := lc_at + 2
sc_at := larr + lc * 2
sc := _r16(f, sc_at)
if ic == 0:
continue
end
if not _match_input(f, c, b, i, ic, iarr, kind, cd, 0, pos):
continue
end
mut bkind := kind
mut lkind := kind
if kind == 1:
bkind = 1
lkind = 1
end
if not _match_back(f, c, b, i, bc, barr, bkind, bcd, 0):
continue
end
if not _match_ahead(f, c, b, pos.get(pos.len() - 1), lc, larr, lkind, lcd, 0):
continue
end
ret _apply_records(f, c, b, pos, sc, sc_at + 2)
end
ret -1
end
func _apply_context(f: Font, c: _Ctx, b &: _Buf, i: int, sub: int, chain: bool): int:
fmt := _r16(f, sub)
g := b.g.get(i)
if fmt == 1:
ci := _coverage(f, sub + _r16(f, sub + 2), g)
if ci < 0 or ci >= _r16(f, sub + 4):
ret -1
end
off := _r16(f, sub + 6 + ci * 2)
if off == 0:
ret -1
end
ret _context_rules(f, c, b, i, sub + off, 0, 0, chain, 0, 0)
end
if fmt == 2:
if _coverage(f, sub + _r16(f, sub + 2), g) < 0:
ret -1
end
if not chain:
cd := sub + _r16(f, sub + 4)
cls := _classdef(f, cd, g)
if cls >= _r16(f, sub + 6):
ret -1
end
off := _r16(f, sub + 8 + cls * 2)
if off == 0:
ret -1
end
ret _context_rules(f, c, b, i, sub + off, 1, cd, false, 0, 0)
end
bo := _r16(f, sub + 4)
lo := _r16(f, sub + 8)
bcd := bo == 0 ? 0 : sub + bo
icd := sub + _r16(f, sub + 6)
lcd := lo == 0 ? 0 : sub + lo
cls := _classdef(f, icd, g)
if cls >= _r16(f, sub + 10):
ret -1
end
off := _r16(f, sub + 12 + cls * 2)
if off == 0:
ret -1
end
ret _context_rules(f, c, b, i, sub + off, 1, icd, true, bcd, lcd)
end
if fmt == 3:
mut pos := Vector {} as Vector<int>
defer pos.free()
if not chain:
gc := _r16(f, sub + 2)
sc := _r16(f, sub + 4)
if gc == 0 or _coverage(f, sub + _r16(f, sub + 6), g) < 0:
ret -1
end
if not _match_input(f, c, b, i, gc, sub + 8, 2, 0, sub, pos):
ret -1
end
ret _apply_records(f, c, b, pos, sc, sub + 6 + gc * 2)
end
bc := _r16(f, sub + 2)
barr := sub + 4
ic_at := barr + bc * 2
ic := _r16(f, ic_at)
iarr := ic_at + 2
lc_at := iarr + ic * 2
lc := _r16(f, lc_at)
larr := lc_at + 2
sc_at := larr + lc * 2
sc := _r16(f, sc_at)
if ic == 0 or _coverage(f, sub + _r16(f, iarr), g) < 0:
ret -1
end
if not _match_input(f, c, b, i, ic, iarr + 2, 2, 0, sub, pos):
ret -1
end
if not _match_back(f, c, b, i, bc, barr, 2, 0, sub):
ret -1
end
if not _match_ahead(f, c, b, pos.get(pos.len() - 1), lc, larr, 2, 0, sub):
ret -1
end
ret _apply_records(f, c, b, pos, sc, sc_at + 2)
end
ret -1
end
func _set_glyph(f: Font, b &: _Buf, i: int, g: int):
b.g.set(i, g)
if _gdef_off(f, 4) != 0:
b.cls.set(i, _classdef(f, _gdef_off(f, 4), g))
end
end
func _gsub_single(f: Font, b &: _Buf, i: int, sub: int): int:
fmt := _r16(f, sub)
ci := _coverage(f, sub + _r16(f, sub + 2), b.g.get(i))
if ci < 0:
ret -1
end
if fmt == 1:
_set_glyph(f, b, i, (b.g.get(i) + _rs16(f, sub + 4)) & 0xFFFF)
ret i + 1
end
if fmt == 2 and ci < _r16(f, sub + 4):
_set_glyph(f, b, i, _r16(f, sub + 6 + ci * 2))
ret i + 1
end
ret -1
end
func _gsub_multiple(f: Font, b &: _Buf, i: int, sub: int): int:
ci := _coverage(f, sub + _r16(f, sub + 2), b.g.get(i))
if ci < 0 or ci >= _r16(f, sub + 4):
ret -1
end
seq := sub + _r16(f, sub + 6 + ci * 2)
n := _r16(f, seq)
if n == 0:
_buf_remove(b, i)
ret i
end
_set_glyph(f, b, i, _r16(f, seq + 2))
mut k := 1
until k < n:
_buf_insert_copy(b, i + k - 1, _r16(f, seq + 2 + k * 2))
_set_glyph(f, b, i + k, _r16(f, seq + 2 + k * 2))
k++
end
ret i + n
end
func _gsub_alternate(f: Font, b &: _Buf, i: int, sub: int): int:
ci := _coverage(f, sub + _r16(f, sub + 2), b.g.get(i))
if ci < 0 or ci >= _r16(f, sub + 4):
ret -1
end
alt := sub + _r16(f, sub + 6 + ci * 2)
if _r16(f, alt) == 0:
ret -1
end
_set_glyph(f, b, i, _r16(f, alt + 2))
ret i + 1
end
func _gsub_ligature(f: Font, c: _Ctx, b &: _Buf, i: int, sub: int): int:
ci := _coverage(f, sub + _r16(f, sub + 2), b.g.get(i))
if ci < 0 or ci >= _r16(f, sub + 4):
ret -1
end
ls := sub + _r16(f, sub + 6 + ci * 2)
nlig := _r16(f, ls)
mut pos := Vector {} as Vector<int>
defer pos.free()
mut k := 0
until k < nlig:
lig := ls + _r16(f, ls + 2 + k * 2)
k++
comp := _r16(f, lig + 2)
if comp == 0:
continue
end
if not _match_input(f, c, b, i, comp, lig + 4, 0, 0, 0, pos):
continue
end
id := b.next_lig
b.next_lig++
mut m := 0
until m + 1 < comp:
mut q := pos.get(m) + 1
until q < pos.get(m + 1):
if b.cls.get(q) == 3:
b.lig_id.set(q, id)
b.lig_comp.set(q, m + 1)
end
q++
end
m++
end
_set_glyph(f, b, i, _r16(f, lig))
if _gdef_off(f, 4) == 0 and comp > 1:
b.cls.set(i, 2)
end
b.lig_id.set(i, comp > 1 ? id : 0)
b.lig_comp.set(i, 0)
mut r := comp - 1
until r >= 1:
_buf_remove(b, pos.get(r))
r--
end
ret i + 1
end
ret -1
end
func _gsub_reverse(f: Font, c: _Ctx, b &: _Buf, i: int, sub: int): int:
ci := _coverage(f, sub + _r16(f, sub + 2), b.g.get(i))
if ci < 0:
ret -1
end
bc := _r16(f, sub + 4)
lc_at := sub + 6 + bc * 2
lc := _r16(f, lc_at)
gc_at := lc_at + 2 + lc * 2
if ci >= _r16(f, gc_at):
ret -1
end
if not _match_back(f, c, b, i, bc, sub + 6, 2, 0, sub):
ret -1
end
if not _match_ahead(f, c, b, i, lc, lc_at + 2, 2, 0, sub):
ret -1
end
_set_glyph(f, b, i, _r16(f, gc_at + 2 + ci * 2))
ret i + 1
end
func _value_size(fmt: int): int:
mut n := 0
mut v := fmt & 0xFF
until v != 0:
n += v & 1
v >>= 1
end
ret n * 2
end
func _apply_value(f: Font, fmt: int, at: int, b &: _Buf, i: int):
mut p := at
if (fmt & 1) != 0:
b.xo.set(i, b.xo.get(i) + _rs16(f, p))
p += 2
end
if (fmt & 2) != 0:
b.yo.set(i, b.yo.get(i) + _rs16(f, p))
p += 2
end
if (fmt & 4) != 0:
b.xa.set(i, b.xa.get(i) + _rs16(f, p))
end
end
func _gpos_single(f: Font, b &: _Buf, i: int, sub: int): int:
fmt := _r16(f, sub)
ci := _coverage(f, sub + _r16(f, sub + 2), b.g.get(i))
if ci < 0:
ret -1
end
vf := _r16(f, sub + 4)
if fmt == 1:
_apply_value(f, vf, sub + 6, b, i)
ret i + 1
end
if fmt == 2 and ci < _r16(f, sub + 6):
_apply_value(f, vf, sub + 8 + ci * _value_size(vf), b, i)
ret i + 1
end
ret -1
end
func _gpos_pair(f: Font, c: _Ctx, b &: _Buf, i: int, sub: int): int:
fmt := _r16(f, sub)
ci := _coverage(f, sub + _r16(f, sub + 2), b.g.get(i))
if ci < 0:
ret -1
end
j := _next_idx(f, c, b, i)
if j < 0:
ret -1
end
vf1 := _r16(f, sub + 4)
vf2 := _r16(f, sub + 6)
s1 := _value_size(vf1)
s2 := _value_size(vf2)
g2 := b.g.get(j)
if fmt == 1:
if ci >= _r16(f, sub + 8):
ret -1
end
ps := sub + _r16(f, sub + 10 + ci * 2)
n := _r16(f, ps)
rec_size := 2 + s1 + s2
mut lo := 0
mut hi := n
until lo < hi:
mid := (lo + hi) / 2
rec := ps + 2 + mid * rec_size
sg := _r16(f, rec)
if g2 < sg:
hi = mid
else g2 > sg:
lo = mid + 1
else:
_apply_value(f, vf1, rec + 2, b, i)
_apply_value(f, vf2, rec + 2 + s1, b, j)
if vf2 != 0:
ret j + 1
end
ret j
end
end
ret -1
end
if fmt == 2:
c1 := _classdef(f, sub + _r16(f, sub + 8), b.g.get(i))
c2 := _classdef(f, sub + _r16(f, sub + 10), g2)
n1 := _r16(f, sub + 12)
n2 := _r16(f, sub + 14)
if c1 >= n1 or c2 >= n2:
ret -1
end
rec := sub + 16 + (c1 * n2 + c2) * (s1 + s2)
_apply_value(f, vf1, rec, b, i)
_apply_value(f, vf2, rec + s1, b, j)
if vf2 != 0:
ret j + 1
end
ret j
end
ret -1
end
func _attach_mark(f: Font, b &: _Buf, i: int, j: int, mark_anchor: int, base_anchor: int):
mut mx := 0
mut my := 0
mut bx := 0
mut ay := 0
_anchor(f, mark_anchor, mx, my)
_anchor(f, base_anchor, bx, ay)
b.xo.set(i, bx - mx)
b.yo.set(i, ay - my)
b.att.set(i, j)
end
func _gpos_mark_base(f: Font, b &: _Buf, i: int, sub: int, kind: int): int:
mi := _coverage(f, sub + _r16(f, sub + 2), b.g.get(i))
if mi < 0:
ret -1
end
mut j := i - 1
if kind == 6:
until j >= 0 and b.cp.get(j) == 0x200D:
j--
end
if j < 0 or b.cls.get(j) != 3:
ret -1
end
else:
until j >= 0 and b.cls.get(j) == 3:
j--
end
if j < 0:
ret -1
end
end
bi := _coverage(f, sub + _r16(f, sub + 4), b.g.get(j))
if bi < 0:
ret -1
end
ncls := _r16(f, sub + 6)
ma := sub + _r16(f, sub + 8)
if mi >= _r16(f, ma):
ret -1
end
mcls := _r16(f, ma + 2 + mi * 4)
manc := ma + _r16(f, ma + 2 + mi * 4 + 2)
if mcls >= ncls:
ret -1
end
arr := sub + _r16(f, sub + 10)
if kind == 5:
if bi >= _r16(f, arr):
ret -1
end
att := arr + _r16(f, arr + 2 + bi * 2)
ncomp := _r16(f, att)
if ncomp == 0:
ret -1
end
mut comp := ncomp - 1
if b.lig_id.get(j) != 0 and b.lig_id.get(j) == b.lig_id.get(i) and b.lig_comp.get(i) > 0:
comp = b.lig_comp.get(i) - 1
if comp >= ncomp:
comp = ncomp - 1
end
end
aoff := _r16(f, att + 2 + (comp * ncls + mcls) * 2)
if aoff == 0:
ret -1
end
_attach_mark(f, b, i, j, manc, att + aoff)
ret i + 1
end
if bi >= _r16(f, arr):
ret -1
end
aoff := _r16(f, arr + 2 + (bi * ncls + mcls) * 2)
if aoff == 0:
ret -1
end
_attach_mark(f, b, i, j, manc, arr + aoff)
ret i + 1
end
func _apply_sub(f: Font, c: _Ctx, b &: _Buf, i: int, ltype: int, sub: int): int:
mut t := ltype
mut s := sub
if (c.gsub and t == 7) or (not c.gsub and t == 9):
t = _r16(f, s + 2)
s = s + _r32(f, s + 4)
end
if c.gsub:
switch t:
1: ret _gsub_single(f, b, i, s) end
2: ret _gsub_multiple(f, b, i, s) end
3: ret _gsub_alternate(f, b, i, s) end
4: ret _gsub_ligature(f, c, b, i, s) end
5: ret _apply_context(f, c, b, i, s, false) end
6: ret _apply_context(f, c, b, i, s, true) end
8: ret _gsub_reverse(f, c, b, i, s) end
else: ret -1 end
end
end
switch t:
1: ret _gpos_single(f, b, i, s) end
2: ret _gpos_pair(f, c, b, i, s) end
4, 5, 6: ret _gpos_mark_base(f, b, i, s, t) end
7: ret _apply_context(f, c, b, i, s, false) end
8: ret _apply_context(f, c, b, i, s, true) end
else: ret -1 end
end
ret -1
end
func _lookup_ctx(f: Font, table: int, gsub: bool, lk: int, depth: int): _Ctx:
mut c := _Ctx {}
c.table = table
c.gsub = gsub
c.flag = _r16(f, lk + 2)
c.depth = depth
if (c.flag & _LF_FILTER_SET) != 0:
c.mark_set = _r16(f, lk + 6 + _r16(f, lk + 4) * 2)
end
ret c
end
func _apply_lookup_at(f: Font, table: int, gsub: bool, lidx: int, b &: _Buf, i: int, depth: int): int:
if depth > _OTL_MAX_DEPTH:
ret -1
end
lk := _lookup_off(f, table, lidx)
if lk == 0:
ret -1
end
c := _lookup_ctx(f, table, gsub, lk, depth)
if _skippable(f, c, b, i):
ret -1
end
ltype := _r16(f, lk)
n := _r16(f, lk + 4)
mut k := 0
until k < n:
r := _apply_sub(f, c, b, i, ltype, lk + _r16(f, lk + 6 + k * 2))
if r >= 0:
ret r
end
k++
end
ret -1
end
func _apply_lookup_pass(f: Font, table: int, gsub: bool, lidx: int, mask: int, b &: _Buf):
lk := _lookup_off(f, table, lidx)
if lk == 0:
ret
end
mut ltype := _r16(f, lk)
if gsub and ltype == 7 and _r16(f, lk + 4) > 0:
s := lk + _r16(f, lk + 6)
ltype = _r16(f, s + 2)
end
if gsub and ltype == 8:
mut i := b.g.len() - 1
until i >= 0:
if (b.mask.get(i) & mask) != 0:
_apply_lookup_at(f, table, gsub, lidx, b, i, 0)
end
i--
end
ret
end
mut i := 0
mut guard := 0
until i < b.g.len() and guard < 100000:
guard++
if (b.mask.get(i) & mask) != 0:
r := _apply_lookup_at(f, table, gsub, lidx, b, i, 0)
if r > i:
i = r
continue
end
if r == i and r >= 0:
continue
end
end
i++
end
end
package typeset
import str
