bp += 4
if log > maxlog:
ret 0 - 1
end
mut remaining := (1 << log) + 1
mut thresh := 1 << log
mut nbits := log + 1
mut sym := 0
mut prevz := false
until remaining > 1 and sym <= maxsym:
if prevz:
mut n0 := sym
until true:
r := _zs_fbits(p, n, bp, 2)
bp += 2
n0 += r
if r != 3:
break
end
if n0 > maxsym + 3:
ret 0 - 1
end
end
if n0 > maxsym:
ret 0 - 1
end
until sym < n0:
d.norm[sym] = 0
sym++
end
end
mx := (2 * thresh - 1) - remaining
mut count := _zs_fbits(p, n, bp, nbits - 1)
if count < mx:
bp += nbits - 1
else:
count = _zs_fbits(p, n, bp, nbits)
if count >= thresh:
count -= mx
end
bp += nbits
end
count--
if count < 0:
remaining--
else:
remaining -= count
end
if remaining < 1:
ret 0 - 1
end
d.norm[sym] = count
sym++
prevz = count == 0
until remaining < thresh:
nbits--
thresh >>= 1
end
end
if remaining != 1 or bp > n * 8:
ret 0 - 1
end
log_out = log
nsym_out = sym
ret (bp + 7) >> 3
