ret v
end
func _fill_mag(p: i8*, x: u64, neg: bool, total: int, lead: int):
p[total] = 0 as i8
if neg: p[0] = 45 as i8 end
mut v := x
mut i := total - 1
until i >= lead:
p[i] = ((v % (10 as u64)) as int + 48) as i8
v /= (10 as u64)
i--
end
end
func _format_mag(x: u64, neg: bool): str:
lead := neg ? 1 : 0
mut ndigits := 1
mut t := x
until t >= (10 as u64):
t /= (10 as u64)
ndigits++
end
total := ndigits + lead
buf := mem.MustAllocate((total + 1) as u64) as str
_fill_mag(buf as i8*, x, neg, total, lead)
ret buf
end
pure func _native_digit(bp: i8*, i: int, n: int): int:
if i + 1 >= n:
ret 0 - 1
end
c := _ub(bp, i)
d := _ub(bp, i + 1)
if c == 219 and d >= 176 and d <= 185:
ret d - 176
end
if c == 217 and d >= 160 and d <= 169:
ret d - 160
end
ret 0 - 1
end
if not SALAM_KERNEL:
func _ascii_digits(s: str): str:
n := s.len()
bp := _bp(s)
mut hit := false
repeat n in j:
if _native_digit(bp, j, n) >= 0:
hit = true
break
end
end
if not hit:
ret s
end
buf := mem.MustAllocate((n + 1) as u64) as str
_fill_ascii(buf as i8*, bp, n)
ret buf
end
func _fill_ascii(p: i8*, bp: i8*, n: int):
mut i := 0
mut k := 0
until i < n:
d := _native_digit(bp, i, n)
if d >= 0:
p[k] = (d + 48) as i8
i += 2
else _ub(bp, i) == 217 and i + 1 < n and _ub(bp, i + 1) == 171:
p[k] = 46 as i8
i += 2
else:
p[k] = _ub(bp, i) as i8
i++
end
k++
end
p[k] = 0 as i8
end
func _cstr_len(p: i8*): int:
mut n := 0
until _ub(p, n) != 0:
n++
end
ret n
end
func _set_nul(p: i8*): p[0] = 0 as i8 end
func _fix_exp(p: i8*):
mut n := 0
until _ub(p, n) != 0:
n++
end
mut e := 0
until e < n and _ub(p, e) != 101:
e++
end
if e >= n:
ret
end
mut d := e + 1
if d < n and (_ub(p, d) == 43 or _ub(p, d) == 45):
d++
end
mut z := d
until n - z > 2 and _ub(p, z) == 48:
z++
end
if z == d:
ret
end
mut i := d
mut j := z
until j <= n:
p[i] = p[j]
i++
j++
end
end
end
@en "FormatUint"
@fa "قالب عدد بی علامت"
pub func FormatUint(x: u64): str: ret _format_mag(x, false) end
@en "FormatInt"
@fa "قالب عدد"
pub func FormatInt(n: i64): str:
if n >= 0: ret _format_mag(n as u64, false) end
ret _format_mag((0 as u64) - (n as u64), true)
end
@en "FormatBool"
@fa "قالب منطقی"
pub inline pure func FormatBool(b: bool): str:
if b: ret "true" end
ret "false"
end
if not SALAM_KERNEL:
@en "FormatFloat"
@fa "قالب اعشار"
pub func FormatFloat(x: f64): str:
cap := 64 as u64
tmp := mem.MustAllocate(cap)
n := _dtoa_shortest(x, tmp, cap as int)
if n <= 0 or n >= (cap as int):
_set_nul(tmp as i8*)
else:
_fix_exp(tmp as i8*)
end
ln := _cstr_len(tmp as i8*)
r := mem.MustAllocateZeroed((ln + 1) as u64)
mem.Copy(r, tmp, ln as u64)
mem.Free(tmp)
ret r as str
end
@en "ScanFloat"
@fa "خواندن اعشار"
pub func ScanFloat(s: str): f64:
t := _ascii_digits(s)
v := _dtoa_parse(t, null)
if (t as void*) != (s as void*):
mem.Free(t as void*)
end
ret v
end
end
