pub func String(): str: ret str.BufStr(this.buf) end
@en "Close"
@fa "بستن"
pub func Close():
if this.useFile and this.dst != null: this.dst.close() end
end
end
@en "JSONDecoder"
@fa "کدگشای جیسون"
pub struct JSONDecoder:
@en "src"
@fa "منبع"
pub src: File* = null
@en "useFile"
@fa "روی پرونده"
pub useFile: bool = false
@en "buf"
@fa "انبار"
pub buf: str = ""
@en "pos"
@fa "جایگاه"
pub pos: int = 0
@en "loaded"
@fa "خوانده شده"
pub loaded: bool = false
@en "eof"
@fa "پایان پرونده"
pub eof: bool = false
@en "bad"
@fa "خراب"
pub bad: bool = false
func _ensureLoaded():
if this.loaded: ret end
if this.useFile: this.buf = io.ReadAll(this.src) end
this.loaded = true
end
@en "More"
@fa "باز هم"
pub func More(): bool:
this._ensureLoaded()
p := _skip_ws(this.buf, this.pos)
ret p < this.buf.len()
end
@en "Decode"
@fa "کدگشایی"
pub func Decode(): value.Value throws:
this._ensureLoaded()
p := _skip_ws(this.buf, this.pos)
if p >= this.buf.len():
this.eof = true
ret value.ValueNull()
end
mut ep := p
mut err := Error {}
v := _pval(this.buf, p, ep, err)
if err.message != "":
this.bad = true
this.eof = true
throw err.locate(this.buf).wrap("json")
end
this.pos = ep
ret v
end
end
@en "NewEncoder"
@fa "کدگذار جدید"
pub func NewEncoder(f: File*): JSONEncoder:
mut e := JSONEncoder {}
e.dst = f
e.useFile = true
ret e
end
@en "NewEncoderIndent"
@fa "کدگذار جدید با تورفتگی"
pub func NewEncoderIndent(f: File*, unit: str): JSONEncoder:
mut e := NewEncoder(f)
e.indent = unit
ret e
end
@en "NewBufEncoder"
@fa "کدگذار حافظه"
pub func NewBufEncoder(): JSONEncoder:
ret JSONEncoder {}
end
@en "NewBufEncoderIndent"
@fa "کدگذار حافظه با تورفتگی"
pub func NewBufEncoderIndent(unit: str): JSONEncoder:
mut e := JSONEncoder {}
e.indent = unit
ret e
end
@en "NewDecoder"
@fa "کدگشای جدید"
pub func NewDecoder(f: File*): JSONDecoder:
mut d := JSONDecoder {}
d.src = f
d.useFile = true
ret d
end
@en "NewBufDecoder"
@fa "کدگشای رشته"
pub func NewBufDecoder(s: str): JSONDecoder:
mut d := JSONDecoder {}
d.buf = s
d.loaded = true
ret d
end
package json
import compress
import encoding.value
import encoding
import conv
import str
@en "JSONOptions"
@fa "گزینه‌های جیسون"
pub struct JSONOptions:
@en "indent"
@fa "تورفتگی"
pub indent: str = ""
@en "sort_keys"
@fa "چیدن کلیدها"
pub sort_keys: bool = false
@en "ignore_null"
@fa "چشم‌پوشی از تهی"
pub ignore_null: bool = false
end
func _skip_ws_n(s: str, n: int, i: int): int:
mut p := i
until p < n:
c := _ub(_bp(s), p)
if c != 32 and c != 9 and c != 10 and c != 13: ret p end
p++
end
ret p
end
func _skip_ws(s: str, i: int): int: ret _skip_ws_n(s, str.ByteLen(s), i) end
func _pstr_n(s: str, n: int, i: int, endpos &: int, err &: Error): str:
bp := _bp(s)
if i >= n or _ub(bp, i) != 34:
err = Error.At(ErrorKind.Syntax, `expected '"'`, i)
endpos = i
ret ""
end
mut sb := str.NewBuilder()
defer str.BufFree(sb)
mut p := i + 1
until p < n:
c := _ub(bp, p)
if c == 34:
endpos = p + 1
ret str.BufStr(sb)
end
if c == 92:
p++
if p >= n:
err = Error.At(ErrorKind.UnexpectedEnd, "unexpected end of input", p)
endpos = p
ret str.BufStr(sb)
end
e := _ub(bp, p)
if e == 34: str.BufAppendChar(sb, 34)
else e == 92: str.BufAppendChar(sb, 92)
else e == 47: str.BufAppendChar(sb, 47)
else e == 98: str.BufAppendChar(sb, 8)
else e == 102: str.BufAppendChar(sb, 12)
else e == 110: str.BufAppendChar(sb, 10)
else e == 114: str.BufAppendChar(sb, 13)
else e == 116: str.BufAppendChar(sb, 9)
else e == 117:
q := __jdcp(s, p, sb)
if q < 0:
err = Error.At(ErrorKind.Syntax, "invalid \\u escape", p)
endpos = p
ret str.BufStr(sb)
end
p = q
else:
str.BufAppendChar(sb, e)
end
p++
else:
str.BufAppendChar(sb, c)
p++
end
end
err = Error.At(ErrorKind.UnexpectedEnd, "unexpected end of input", p)
endpos = p
ret str.BufStr(sb)
end
func _pval(s: str, i: int, endpos &: int, err &: Error): value.Value:
ret _pval_d_n(s, str.ByteLen(s), i, endpos, err, 0)
end
func _pval_d_n(s: str, n: int, i: int, endpos &: int, err &: Error, depth: int): value.Value:
if err.message != "":
endpos = i
ret value.ValueNull()
end
if depth > 512:
err = Error.At(ErrorKind.OutOfRange, "JSON nesting is deeper than 512 levels", i)
endpos = i
ret value.ValueNull()
end
p0 := _skip_ws_n(s, n, i)
if p0 >= n:
err = Error.At(ErrorKind.UnexpectedEnd, "unexpected end of input", p0)
endpos = p0
ret value.ValueNull()
end
bp := _bp(s)
c := _ub(bp, p0)
if c == 34:
mut ep := p0
text := _pstr_n(s, n, p0, ep, err)
endpos = ep
ret value.ValueString(text)
end
if c == 123:
mut out := value.NewValueObject()
mut q := _skip_ws_n(s, n, p0 + 1)
if q < n and _ub(bp, q) == 125:
endpos = q + 1
ret out
end
until true:
q = _skip_ws_n(s, n, q)
if q >= n or _ub(bp, q) != 34:
err = q >= n ? Error.At(ErrorKind.UnexpectedEnd, "unexpected end of input", q) : Error.At(ErrorKind.Syntax, "expected object key", q)
endpos = q
ret out
end
mut kend := q
key := _pstr_n(s, n, q, kend, err)
if err.message != "": endpos = kend ret out end
q = _skip_ws_n(s, n, kend)
if q >= n or _ub(bp, q) != 58:
err = q >= n ? Error.At(ErrorKind.UnexpectedEnd, "unexpected end of input", q) : Error.At(ErrorKind.Syntax, "expected ':'", q)
endpos = q
ret out
end
mut vend := q + 1
v := _pval_d_n(s, n, q + 1, vend, err, depth + 1)
if err.message != "": endpos = vend ret out end
value.ObjectSet(out, key, v)
q = _skip_ws_n(s, n, vend)
if q < n and _ub(bp, q) == 44:
q++
continue
end
if q < n and _ub(bp, q) == 125:
endpos = q + 1
ret out
end
err = q >= n ? Error.At(ErrorKind.UnexpectedEnd, "unexpected end of input", q) : Error.At(ErrorKind.Syntax, "expected ',' or '}'", q)
endpos = q
ret out
end
end
if c == 91:
mut out := value.NewValueArray()
mut q := _skip_ws_n(s, n, p0 + 1)
if q < n and _ub(bp, q) == 93:
endpos = q + 1
ret out
end
until true:
mut vend := q
v := _pval_d_n(s, n, q, vend, err, depth + 1)
if err.message != "": endpos = vend ret out end
value.ArrayPush(out, v)
q = _skip_ws_n(s, n, vend)
if q < n and _ub(bp, q) == 44:
q++
continue
end
if q < n and _ub(bp, q) == 93:
endpos = q + 1
ret out
end
err = q >= n ? Error.At(ErrorKind.UnexpectedEnd, "unexpected end of input", q) : Error.At(ErrorKind.Syntax, "expected ',' or ']'", q)
endpos = q
ret out
end
end
if p0 + 4 <= n and _match_at(bp, p0, _bp("true"), 4):
endpos = p0 + 4
ret value.ValueBool(true)
end
if p0 + 5 <= n and _match_at(bp, p0, _bp("false"), 5):
endpos = p0 + 5
ret value.ValueBool(false)
end
if p0 + 4 <= n and _match_at(bp, p0, _bp("null"), 4):
endpos = p0 + 4
ret value.ValueNull()
end
ep := _jnum_n(s, n, p0)
if ep < 0 or ep == p0:
err = Error.At(ErrorKind.Syntax, "invalid value", p0)
endpos = p0
ret value.ValueNull()
end
numtext := __jdslice(s, p0, ep)
endpos = ep
if str.Contains(numtext, ".") or str.Contains(numtext, "e") or str.Contains(numtext, "E"):
ret value.ValueFloat(numtext.to_float())
end
mut fits := true
v := _parse_i64(numtext, fits)
if not fits:
ret value.ValueFloat(numtext.to_float())
end
ret value.ValueInt(v)
end
func _parse_i64(text: str, fits &: bool): i64:
fits = true
n := str.ByteLen(text)
mut i := 0
mut neg := false
if n > 0 and str.ByteSub(text, 0, 1) == "-":
neg = true
i = 1
end
mut limit := 9223372036854775807 as u64
if neg:
limit = 9223372036854775808 as u64
end
mut acc := 0 as u64
until i < n:
d := (str.ByteSub(text, i, 1).to_int()) as u64
if acc > (limit - d) / 10:
fits = false
ret 0
end
acc = acc * 10 + d
i++
end
if neg:
ret (0 as u64 - acc) as i64
end
ret acc as i64
end
func _sort_keys(keys &: Vector<str>):
n := keys.len()
mut i := 1
until i < n:
mut j := i
until j > 0:
a := keys.get(j - 1)
b := keys.get(j)
if a <= b: break end
keys.set(j - 1, b)
keys.set(j, a)
j--
end
i++
end
end
func _encode_value(v: value.Value, opts: JSONOptions): str:
if value.IsNull(v): ret "null" end
if value.IsBool(v):
if value.AsBool(v): ret "true" end
ret "false"
end
if value.IsInt(v): ret conv.FormatInt(value.AsInt(v)) end
if value.IsFloat(v):
if SALAM_KERNEL:
ret "null"
else:
ret conv.FormatFloat(value.AsFloat(v))
end
end
if value.IsString(v): ret Str(value.AsString(v)) end
if value.IsBytes(v):
mut b := value.BytesToBuf(v)
out := Str(encoding.Base64EncodeBytes(b.data, b.len))
compress.BufFree(b)
ret out
end
if value.IsExt(v):
mut b := value.ExtDataToBuf(v)
data := encoding.Base64EncodeBytes(b.data, b.len)
compress.BufFree(b)
mut parts := Vector {} as Vector<str>
parts.push(MemberInt("$ext_type", value.ExtType(v) as i64))
parts.push(Member("$ext_data", data))
ret Object(parts)
end
if value.IsArray(v):
mut parts := Vector {} as Vector<str>
mut i := 0
n := value.ArrayLen(v)
until i < n:
parts.push(_encode_value(value.ArrayGet(v, i), opts))
i++
end
ret Array(parts)
end
if value.IsObject(v):
mut keys := value.ObjectKeys(v)
if opts.sort_keys: _sort_keys(keys) end
mut parts := Vector {} as Vector<str>
mut i := 0
until i < keys.len():
k := keys.get(i)
fv := value.ObjectGet(v, k)
if opts.ignore_null and value.IsNull(fv):
i++
continue
end
parts.push(MemberRaw(k, _encode_value(fv, opts)))
i++
end
ret Object(parts)
end
ret "null"
end
@en "Decode"
@fa "کدگشایی"
pub func Decode(text: str): value.Value throws:
mut err := Error {}
mut endpos := 0
v := _pval(text, 0, endpos, err)
if err.message == "":
p := _skip_ws(text, endpos)
if p < str.ByteLen(text):
err = Error.At(ErrorKind.Syntax, "trailing data after JSON value", p).with_code("json.trailing_data")
end
end
if err.message != "":
throw err.locate(text).wrap("json")
end
ret v
end
@en "Encode"
@fa "کدگذاری"
pub func Encode(v: value.Value, opts: JSONOptions): str:
text := _encode_value(v, opts)
if opts.indent != "": ret IndentWith(text, opts.indent) end
ret text
end
@en "EncodeDefault"
@fa "کدگذاری پیش فرض"
pub func EncodeDefault(v: value.Value): str:
ret Encode(v, JSONOptions {})
end
@en "msgpack"
@fa "مسج‌پک"
package msgpack
import compress
import encoding.binary
import encoding.value
@en "MsgpackOptions"
@fa "گزینه‌های مسج‌پک"
pub struct MsgpackOptions:
@en "use_str8"
@fa "قالب کوتاه رشته"
pub use_str8: bool = true
end
func _fits_u8(v: i64): bool: ret v >= 0 and v <= 255 end
func _fits_u16(v: i64): bool: ret v >= 0 and v <= 65535 end
func _fits_u32(v: i64): bool: ret v >= 0 and v <= 4294967295 end
func _fits_i8(v: i64): bool: ret v >= (0 - 128) and v <= 127 end
func _fits_i16(v: i64): bool: ret v >= (0 - 32768) and v <= 32767 end
func _fits_i32(v: i64): bool: ret v >= (0 - 2147483648) and v <= 2147483647 end
func _marshal_int(buf &: compress.ByteBuf, v: i64):
if v >= 0 and v <= 127:
binary.WriteU8(buf, v as int)
ret
end
if v < 0 and v >= (0 - 32):
binary.WriteU8(buf, (v as int) & 255)
ret
end
if v >= 0:
if _fits_u8(v):
binary.WriteU8(buf, 0xcc)
binary.WriteU8(buf, v as int)
else _fits_u16(v):
binary.WriteU8(buf, 0xcd)
binary.WriteU16BE(buf, v as int)
else _fits_u32(v):
binary.WriteU8(buf, 0xce)
binary.WriteU32BE(buf, v as int)
else:
binary.WriteU8(buf, 0xcf)
binary.WriteU64BE(buf, v)
end
ret
end
if _fits_i8(v):
binary.WriteU8(buf, 0xd0)
binary.WriteU8(buf, (v as int) & 255)
else _fits_i16(v):
binary.WriteU8(buf, 0xd1)
binary.WriteU16BE(buf, (v as int) & 65535)
else _fits_i32(v):
binary.WriteU8(buf, 0xd2)
binary.WriteU32BE(buf, v as int)
else:
binary.WriteU8(buf, 0xd3)
binary.WriteI64BE(buf, v)
end
end
func _marshal_str(buf &: compress.ByteBuf, s: str, use_str8: bool):
n := s.len()
if n <= 31:
binary.WriteU8(buf, 0xa0 | n)
else n <= 255 and use_str8:
binary.WriteU8(buf, 0xd9)
binary.WriteU8(buf, n)
else n <= 65535:
binary.WriteU8(buf, 0xda)
binary.WriteU16BE(buf, n)
else:
binary.WriteU8(buf, 0xdb)
binary.WriteU32BE(buf, n)
end
compress.BufPushBytes(buf, s as void*, n)
end
func _marshal_bytes(buf &: compress.ByteBuf, p: void*, n: int):
if n <= 255:
binary.WriteU8(buf, 0xc4)
binary.WriteU8(buf, n)
else n <= 65535:
binary.WriteU8(buf, 0xc5)
binary.WriteU16BE(buf, n)
else:
binary.WriteU8(buf, 0xc6)
binary.WriteU32BE(buf, n)
end
compress.BufPushBytes(buf, p, n)
end
func _marshal_ext(buf &: compress.ByteBuf, typeId: int, p: void*, n: int):
t := typeId & 255
if n == 1: binary.WriteU8(buf, 0xd4)
else n == 2: binary.WriteU8(buf, 0xd5)
else n == 4: binary.WriteU8(buf, 0xd6)
else n == 8: binary.WriteU8(buf, 0xd7)
else n == 16: binary.WriteU8(buf, 0xd8)
else n <= 255:
binary.WriteU8(buf, 0xc7)
binary.WriteU8(buf, n)
else n <= 65535:
binary.WriteU8(buf, 0xc8)
binary.WriteU16BE(buf, n)
else:
binary.WriteU8(buf, 0xc9)
binary.WriteU32BE(buf, n)
end
binary.WriteU8(buf, t)
compress.BufPushBytes(buf, p, n)
end
func _marshal(buf &: compress.ByteBuf, v: value.Value, opts: MsgpackOptions):
if value.IsNull(v):
binary.WriteU8(buf, 0xc0)
ret
end
if value.IsBool(v):
if value.AsBool(v): binary.WriteU8(buf, 0xc3) else:
binary.WriteU8(buf, 0xc2)
end
ret
end
if value.IsInt(v):
_marshal_int(buf, value.AsInt(v))
ret
end
if value.IsFloat(v):
binary.WriteU8(buf, 0xcb)
binary.WriteF64(buf, value.AsFloat(v), true)
ret
end
if value.IsString(v):
_marshal_str(buf, value.AsString(v), opts.use_str8)
ret
end
if value.IsBytes(v):
mut b := value.BytesToBuf(v)
_marshal_bytes(buf, b.data, b.len)
compress.BufFree(b)
ret
end
if value.IsExt(v):
mut b := value.ExtDataToBuf(v)
_marshal_ext(buf, value.ExtType(v), b.data, b.len)
compress.BufFree(b)
ret
end
if value.IsArray(v):
n := value.ArrayLen(v)
if n <= 15:
binary.WriteU8(buf, 0x90 | n)
else n <= 65535:
binary.WriteU8(buf, 0xdc)
binary.WriteU16BE(buf, n)
else:
binary.WriteU8(buf, 0xdd)
binary.WriteU32BE(buf, n)
end
mut i := 0
until i < n:
_marshal(buf, value.ArrayGet(v, i), opts)
i++
end
ret
end
if value.IsObject(v):
n := value.ObjectLen(v)
if n <= 15:
binary.WriteU8(buf, 0x80 | n)
else n <= 65535:
binary.WriteU8(buf, 0xde)
binary.WriteU16BE(buf, n)
else:
binary.WriteU8(buf, 0xdf)
binary.WriteU32BE(buf, n)
end
keys := value.ObjectKeys(v)
mut i := 0
until i < keys.len():
k := keys.get(i)
_marshal_str(buf, k, opts.use_str8)
_marshal(buf, value.ObjectGet(v, k), opts)
i++
end
ret
end
end
func _read_str(r &: compress.ByteReader, n: int): str:
mut b := compress.RdBytes(r, n)
out := compress.BufToStrUnsafe(b)
compress.BufFree(b)
ret out
end
func _read_bin(r &: compress.ByteReader, n: int, err &: Error): value.Value:
if not _mp_fits(r, n, 1, err): ret value.ValueNull() end
mut b := compress.RdBytes(r, n)
out := value.ValueBinary(b.data, b.len)
compress.BufFree(b)
ret out
end
func _read_ext(r &: compress.ByteReader, typeId: int, n: int, err &: Error): value.Value:
if not _mp_fits(r, n, 1, err): ret value.ValueNull() end
mut b := compress.RdBytes(r, n)
out := value.ValueExt(typeId, b.data, b.len)
compress.BufFree(b)
ret out
end
func _mp_fits(r &: compress.ByteReader, n: int, per: int, err &: Error): bool:
if r.bad or n < 0 or (n as i64) * (per as i64) > ((r.len - r.pos) as i64):
err = Error.At(ErrorKind.UnexpectedEnd, "unexpected end of input", r.pos)
ret false
end
ret true
end
func _unmarshal(r &: compress.ByteReader, err &: Error): value.Value:
ret _unmarshal_d(r, err, 0)
end
func _unmarshal_tag(r &: compress.ByteReader, err &: Error, depth: int): value.Value throws:
tag := try binary.ReadU8(r)
if tag <= 0x7f: ret value.ValueInt(tag as i64) end
if tag >= 0xe0: ret value.ValueInt((tag - 256) as i64) end
if tag >= 0x80 and tag <= 0x8f:
n := tag & 15
ret _unmarshal_map(r, n, err, depth)
end
if tag >= 0x90 and tag <= 0x9f:
n := tag & 15
ret _unmarshal_array(r, n, err, depth)
end
if tag >= 0xa0 and tag <= 0xbf:
n := tag & 31
ret _mp_fits(r, n, 1, err) ? value.ValueString(_read_str(r, n)) : value.ValueNull()
end
if tag == 0xc0: ret value.ValueNull() end
if tag == 0xc2: ret value.ValueBool(false) end
if tag == 0xc3: ret value.ValueBool(true) end
if tag == 0xca: ret value.ValueFloat(try binary.ReadF32(r, true)) end
if tag == 0xcb: ret value.ValueFloat(try binary.ReadF64(r, true)) end
if tag == 0xcc: ret value.ValueInt(try binary.ReadU8(r) as i64) end
if tag == 0xcd: ret value.ValueInt(try binary.ReadU16BE(r) as i64) end
if tag == 0xce: ret value.ValueInt(try binary.ReadU32BE(r) as i64) end
if tag == 0xcf: ret value.ValueInt(try binary.ReadU64BE(r)) end
if tag == 0xd0:
b := try binary.ReadU8(r)
mut sv := b as i64
if b > 127: sv -= 256 end
ret value.ValueInt(sv)
end
if tag == 0xd1:
b := try binary.ReadU16BE(r)
mut sv := b as i64
if b > 32767: sv -= 65536 end
ret value.ValueInt(sv)
end
if tag == 0xd2:
b := try binary.ReadU32BE(r)
mut sv := b as i64
if b > 2147483647: sv -= 4294967296 end
ret value.ValueInt(sv)
end
if tag == 0xd3: ret value.ValueInt(try binary.ReadI64BE(r)) end
if tag == 0xd9:
n := try binary.ReadU8(r)
ret _mp_fits(r, n, 1, err) ? value.ValueString(_read_str(r, n)) : value.ValueNull()
end
if tag == 0xda:
n := try binary.ReadU16BE(r)
ret _mp_fits(r, n, 1, err) ? value.ValueString(_read_str(r, n)) : value.ValueNull()
end
if tag == 0xdb:
n := try binary.ReadU32BE(r)
ret _mp_fits(r, n, 1, err) ? value.ValueString(_read_str(r, n)) : value.ValueNull()
end
if tag == 0xc4:
n := try binary.ReadU8(r)
ret _read_bin(r, n, err)
end
if tag == 0xc5:
n := try binary.ReadU16BE(r)
ret _read_bin(r, n, err)
end
if tag == 0xc6:
n := try binary.ReadU32BE(r)
ret _read_bin(r, n, err)
end
if tag >= 0xd4 and tag <= 0xd8:
mut n := 1
if tag == 0xd5: n = 2
else tag == 0xd6: n = 4
else tag == 0xd7: n = 8
else tag == 0xd8: n = 16
end
t := try binary.ReadU8(r)
mut tv := t
if t > 127: tv -= 256 end
ret _read_ext(r, tv, n, err)
end
if tag == 0xc7 or tag == 0xc8 or tag == 0xc9:
mut n := 0
if tag == 0xc7: n = try binary.ReadU8(r)
else tag == 0xc8: n = try binary.ReadU16BE(r)
else:
n = try binary.ReadU32BE(r)
end
t := try binary.ReadU8(r)
mut tv := t
if t > 127: tv -= 256 end
ret _read_ext(r, tv, n, err)
end
if tag == 0xdc:
n := try binary.ReadU16BE(r)
ret _unmarshal_array(r, n, err, depth)
end
if tag == 0xdd:
n := try binary.ReadU32BE(r)
ret _unmarshal_array(r, n, err, depth)
end
if tag == 0xde:
n := try binary.ReadU16BE(r)
ret _unmarshal_map(r, n, err, depth)
end
if tag == 0xdf:
n := try binary.ReadU32BE(r)
ret _unmarshal_map(r, n, err, depth)
end
err = Error.At(ErrorKind.Unsupported, "unsupported msgpack tag " + tag, r.pos)
ret value.ValueNull()
end
func _unmarshal_d(r &: compress.ByteReader, err &: Error, depth: int): value.Value:
if err.message != "": ret value.ValueNull() end
if depth > 512:
err = Error.At(ErrorKind.OutOfRange, "msgpack nesting is deeper than 512 levels", r.pos)
ret value.ValueNull()
end
try:
ret _unmarshal_tag(r, err, depth)
catch e:
err = e
ret value.ValueNull()
end
end
func _unmarshal_array(r &: compress.ByteReader, n: int, err &: Error, depth: int): value.Value:
if not _mp_fits(r, n, 1, err): ret value.ValueNull() end
mut out := value.NewValueArray()
mut i := 0
until i < n:
item := _unmarshal_d(r, err, depth + 1)
if err.message != "": ret value.ValueNull() end
value.ArrayPush(out, item)
i++
end
ret out
end
func _unmarshal_map(r &: compress.ByteReader, n: int, err &: Error, depth: int): value.Value:
if not _mp_fits(r, n, 2, err): ret value.ValueNull() end
mut out := value.NewValueObject()
mut i := 0
until i < n:
k := _unmarshal_d(r, err, depth + 1)
if err.message != "": ret value.ValueNull() end
v := _unmarshal_d(r, err, depth + 1)
if err.message != "": ret value.ValueNull() end
value.ObjectSet(out, value.AsString(k), v)
i++
end
ret out
end
@en "MarshalWith"
@fa "سریال سازی سفارشی"
pub func MarshalWith(v: value.Value, opts: MsgpackOptions): compress.ByteBuf:
mut buf := compress.NewByteBuf()
_marshal(buf, v, opts)
ret buf
end
@en "Marshal"
@fa "سریال سازی"
pub func Marshal(v: value.Value): compress.ByteBuf:
ret MarshalWith(v, MsgpackOptions {})
end
@en "UnmarshalBytes"
@fa "واسریال سازی بایت‌ها"
pub func UnmarshalBytes(p: void*, n: int): value.Value throws:
mut r := compress.NewByteReader(p, n)
mut err := Error {}
v := _unmarshal(r, err)
if err.message != "":
throw err.wrap("msgpack")
end
ret v
end
@en "Unmarshal"
@fa "واسریال سازی"
pub func Unmarshal(b: compress.ByteBuf): value.Value throws:
ret try UnmarshalBytes(b.data, b.len)
end
