t := _get_clipboard()
if t.len() > 0:
_push_undo(f)
_replace_selection(f, t)
changed = true
end
end
break
end
window.Key.Z:
if ctrl and not readonly and c.undo.len() > 0:
mut cc := _e.ctl.ref(f)
last := cc.undo.pop()
_set_value(f, last)
mut c2 := _e.ctl.ref(f)
c2.caret = last.len()
c2.anchor = c2.caret
changed = true
end
break
end
window.Key.Enter:
if _e.dom.nodes[f].tag == "textarea":
if not readonly:
_push_undo(f)
_replace_selection(f, "\n")
changed = true
end
else:
_maybe_change(f)
_remember_committed(f)
_submit(_ancestor_tag(f, "form"))
end
break
end
else:
break
end
end
if moved:
mut cc := _e.ctl.ref(f)
cc.caret = caret
if not shift:
cc.anchor = caret
end
_scroll_caret(f)
_damage_node(f)
end
if changed:
_refresh_control(f)
ev := _make_event("input", f)
_fire_ev(f, ev, true)
end
end
func _visual_step(f: int, caret: int, right: bool, logical: bool): int:
fi := _e.node_ifc[f]
v := _control_value(f)
plain := not (_e.dom.nodes[f].tag == "input" and _input_type(f) == "password") and v.len() > 0
