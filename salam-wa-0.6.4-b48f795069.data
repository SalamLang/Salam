@en "Accepted"
@fa "پذیرفته شده"
pub struct Accepted:
@en "ok"
@fa "معتبر"
pub ok: bool = false
@en "proxied"
@fa "پروکسی شده"
pub proxied: bool = false
@en "conn"
@fa "اتصال"
pub conn: tls.Conn = tls.Conn {}
@en "sni"
@fa "نام سرور"
pub sni: str = ""
@en "short_id"
@fa "شناسه کوتاه"
pub short_id: str = ""
@en "client_version"
@fa "نسخه کارخواه"
pub client_version: str = ""
@en "err"
@fa "خطا"
pub err: str = ""
end
func _bnew(cap0: int): _B:
mut c := cap0
if c < 64:
c = 64
end
ret _B { p = mem.AllocateZeroed(c as u64), len = 0, cap = c }
end
func _bfree(b &: _B):
if b.p != null:
mem.Free(b.p)
end
b.p = null
b.len = 0
b.cap = 0
end
func _bput(b &: _B, v: int):
if b.len + 1 > b.cap:
b.p = mem.Reallocate(b.p, (b.cap * 2) as u64)
b.cap *= 2
end
bp := b.p as u8*
bp[b.len] = (v & 0xFF) as u8
b.len++
end
func _braw(b &: _B, src: void*, n: int):
repeat n in i:
sp := src as u8*
_bput(b, sp[i] as int)
end
end
func _at(p: void*, i: int): int:
bp := p as u8*
ret bp[i] as int
end
func _off(p: void*, n: int): void*:
ret ((p as i64) + (n as i64)) as void*
end
func _der(tag: int, body: _B): _B:
mut o := _bnew(body.len + 8)
_bput(o, tag)
if body.len < 128:
_bput(o, body.len)
else if body.len < 256:
_bput(o, 0x81)
_bput(o, body.len)
else:
_bput(o, 0x82)
_bput(o, body.len >> 8)
_bput(o, body.len)
end
_braw(o, body.p, body.len)
ret o
end
func _b64val(ch: int): int:
if ch >= 65 and ch <= 90:
ret ch - 65
end
if ch >= 97 and ch <= 122:
ret ch - 71
end
if ch >= 48 and ch <= 57:
ret ch + 4
end
if ch == 45 or ch == 43:
ret 62
end
if ch == 95 or ch == 47:
ret 63
end
ret 0 - 1
end
func _b64decode(s: str, out: void*, want: int): bool:
mut n := s.len()
bp := s as u8*
until n > 0 and (bp[n - 1] as int) == 61:
n--
end
mut acc := 0
mut bits := 0
mut o := 0
repeat n in i:
v := _b64val(bp[i] as int)
if v < 0:
ret false
end
acc = (acc << 6) | v
bits += 6
if bits >= 8:
bits -= 8
if o >= want:
ret false
end
ob := out as u8*
ob[o] = ((acc >> bits) & 0xFF) as u8
o++
end
end
ret o == want
end
func _b64encode(p: void*, n: int): str:
mut parts := Vector {} as Vector<str>
defer parts.free()
mut acc := 0
mut bits := 0
repeat n in i:
acc = ((acc << 8) | _at(p, i)) & 0xFFFFFF
bits += 8
until bits >= 6:
bits -= 6
parts.push(str.Substr(_B64, (acc >> bits) & 63, 1))
end
end
if bits > 0:
parts.push(str.Substr(_B64, (acc << (6 - bits)) & 63, 1))
end
ret str.Join(parts, "")
end
func _hexval(ch: int): int:
if ch >= 48 and ch <= 57:
ret ch - 48
end
if ch >= 97 and ch <= 102:
ret ch - 87
end
if ch >= 65 and ch <= 70:
ret ch - 55
end
ret 0 - 1
end
func _short_id_bytes(s: str, out: void*): bool:
n := s.len()
if n > 16 or n % 2 != 0:
ret false
end
bp := s as u8*
repeat 8 in i:
ob := out as u8*
ob[i] = 0 as u8
end
repeat n / 2 in i:
hi := _hexval(bp[i * 2] as int)
lo := _hexval(bp[i * 2 + 1] as int)
if hi < 0 or lo < 0:
ret false
end
ob := out as u8*
ob[i] = ((hi << 4) | lo) as u8
end
ret true
end
func _auth_key(shared: void*, random: void*, out: void*): bool:
ret tls.HkdfSha256Derive(shared, 32, random, 20, "REALITY", out, 32)
end
func _fail_conn(msg: str): tls.Conn:
mut c := tls.Conn {}
c.err = msg
ret c
end
func _seal_session(h &: utls.Hello, spub: void*, short8: void*, offset: int): bool:
sid := mem.AllocateZeroed(32 as u64)
defer mem.Free(sid)
utls.SetSessionId(h, sid)
plain := mem.AllocateZeroed(16 as u64)
defer mem.Free(plain)
pb := plain as u8*
pb[0] = 26 as u8
pb[1] = 3 as u8
pb[2] = 27 as u8
now := time.Now() + (offset as i64)
pb[4] = ((now >> (24 as i64)) & (255 as i64)) as u8
pb[5] = ((now >> (16 as i64)) & (255 as i64)) as u8
pb[6] = ((now >> (8 as i64)) & (255 as i64)) as u8
pb[7] = (now & (255 as i64)) as u8
repeat 8 in i:
pb[8 + i] = _at(short8, i) as u8
end
shared := mem.AllocateZeroed(32 as u64)
defer mem.Free(shared)
if not tls.X25519Shared(h.priv.p, spub, shared):
ret false
end
key := mem.AllocateZeroed(32 as u64)
defer mem.Free(key)
random := _off(h.raw.p, 6)
if not _auth_key(shared, random, key):
ret false
end
sealed := mem.AllocateZeroed(48 as u64)
defer mem.Free(sealed)
if not tls.AesGcmSealRaw(key, 32, _off(random, 20), h.raw.p, h.raw.len, plain, 16, sealed):
ret false
end
utls.SetSessionId(h, sealed)
ret true
end
func _parse_hello(p: void*, n: int): _Parsed:
mut r := _Parsed {}
if n < 43 or _at(p, 0) != 1:
ret r
end
r.random_off = 6
mut o := 38
sl := _at(p, o)
r.sid_off = o + 1
r.sid_len = sl
o += 1 + sl
if o + 2 > n:
ret r
end
o += 2 + ((_at(p, o) << 8) | _at(p, o + 1))
if o + 1 > n:
ret r
end
o += 1 + _at(p, o)
if o + 2 > n:
ret r
end
el := (_at(p, o) << 8) | _at(p, o + 1)
o += 2
end_at := o + el
if end_at > n:
ret r
end
until o + 4 <= end_at:
id := (_at(p, o) << 8) | _at(p, o + 1)
l := (_at(p, o + 2) << 8) | _at(p, o + 3)
b := o + 4
if b + l > end_at:
ret r
end
if id == 0 and l >= 5:
nl := (_at(p, b + 3) << 8) | _at(p, b + 4)
if b + 5 + nl <= b + l:
nbuf := mem.AllocateZeroed((nl + 1) as u64)
mem.Copy(nbuf, _off(p, b + 5), nl as u64)
r.sni = nbuf as str
end
else if id == 43 and l >= 1:
vl := _at(p, b)
mut j := 0
until j < vl and 1 + j + 1 < l:
if _at(p, b + 1 + j) == 3 and _at(p, b + 2 + j) == 4:
r.tls13 = true
end
j += 2
end
else if id == 51 and l >= 2:
mut j := 2
until j + 4 <= l:
g := (_at(p, b + j) << 8) | _at(p, b + j + 1)
kl := (_at(p, b + j + 2) << 8) | _at(p, b + j + 3)
if g == 0x001D and kl == 32 and j + 4 + kl <= l:
r.share_off = b + j + 4
end
j += 4 + kl
end
end
o = b + l
end
r.ok = true
ret r
end
func _csv_has(list: str, item: str): bool:
if list.len() == 0:
ret false
end
mut parts := str.Split(list, ",")
defer parts.free()
repeat parts.len() in i:
if str.Trim(parts.get(i)) == item:
ret true
end
end
ret false
end
func _short_id_hex(p: void*): str:
mut parts := Vector {} as Vector<str>
defer parts.free()
digits := "0123456789abcdef"
repeat 8 in i:
v := _at(p, i)
parts.push(str.Substr(digits, v >> 4, 1) + str.Substr(digits, v & 15, 1))
end
ret str.Join(parts, "")
end
func _short_id_known(ss: ServerSettings, id8: void*): bool:
if ss.short_ids.len() == 0:
ret false
end
mut parts := str.Split(ss.short_ids, ",")
defer parts.free()
cand := mem.AllocateZeroed(8 as u64)
defer mem.Free(cand)
mut found := false
repeat parts.len() in i:
if _short_id_bytes(str.Trim(parts.get(i)), cand):
mut diff := 0
repeat 8 in j:
diff |= _at(cand, j) ^ _at(id8, j)
end
if diff == 0:
found = true
end
end
end
ret found
end
func _make_cert(seed: void*, auth: void*): _B:
pubk := mem.AllocateZeroed(32 as u64)
defer mem.Free(pubk)
tls.Ed25519PublicKey(seed, pubk)
mac := mem.AllocateZeroed(64 as u64)
defer mem.Free(mac)
tls.HmacSha512Raw(auth, 32, pubk, 32, mac)
mut oid := _bnew(8)
_bput(oid, 0x06)
_bput(oid, 3)
_bput(oid, 0x2b)
_bput(oid, 0x65)
_bput(oid, 0x70)
mut algid := _der(0x30, oid)
mut ver0 := _bnew(8)
_bput(ver0, 0x02)
_bput(ver0, 1)
_bput(ver0, 2)
mut ver := _der(0xA0, ver0)
mut serial := _bnew(8)
_bput(serial, 0x02)
_bput(serial, 1)
_bput(serial, 1)
mut empty := _bnew(8)
mut name := _der(0x30, empty)
mut val := _bnew(40)
nb := "260101000000Z"
na := "360101000000Z"
_bput(val, 0x17)
_bput(val, 13)
_braw(val, nb as void*, 13)
_bput(val, 0x17)
_bput(val, 13)
_braw(val, na as void*, 13)
mut validity := _der(0x30, val)
mut kb := _bnew(40)
_bput(kb, 0)
_braw(kb, pubk, 32)
mut kbs := _der(0x03, kb)
mut spki_body := _bnew(64)
_braw(spki_body, algid.p, algid.len)
_braw(spki_body, kbs.p, kbs.len)
mut spki := _der(0x30, spki_body)
mut tbs_body := _bnew(256)
_braw(tbs_body, ver.p, ver.len)
_braw(tbs_body, serial.p, serial.len)
_braw(tbs_body, algid.p, algid.len)
_braw(tbs_body, name.p, name.len)
_braw(tbs_body, validity.p, validity.len)
_braw(tbs_body, name.p, name.len)
_braw(tbs_body, spki.p, spki.len)
mut tbs := _der(0x30, tbs_body)
mut sg := _bnew(80)
_bput(sg, 0)
_braw(sg, mac, 64)
mut sgs := _der(0x03, sg)
mut cert_body := _bnew(256)
_braw(cert_body, tbs.p, tbs.len)
_braw(cert_body, algid.p, algid.len)
_braw(cert_body, sgs.p, sgs.len)
cert := _der(0x30, cert_body)
_bfree(oid)
_bfree(algid)
_bfree(ver0)
_bfree(ver)
_bfree(serial)
_bfree(empty)
_bfree(name)
_bfree(val)
_bfree(validity)
_bfree(kb)
_bfree(kbs)
_bfree(spki_body)
_bfree(spki)
_bfree(tbs_body)
_bfree(tbs)
_bfree(sg)
_bfree(sgs)
_bfree(cert_body)
ret cert
end
func _dest_parts(dest: str, host &: str, port &: int): bool:
mut parts := str.Split(dest, ":")
defer parts.free()
if parts.len() < 2:
ret false
end
mut h := parts.get(0)
repeat parts.len() - 2 in i:
h = h + ":" + parts.get(i + 1)
end
host = h
port = str.ToInt(parts.get(parts.len() - 1)) as int
ret port > 0
end
func _proxy_to_dest(c: tcp.Conn, ss: ServerSettings, data: void*, n: int): bool:
mut host := ""
mut port := 0
if not _dest_parts(ss.dest, host, port):
tcp.Close(c)
ret false
end
mut upstream := tunnel.DialTcp(host, port, ss.dest_timeout_ms)
if not upstream.Ok():
tcp.Close(c)
ret false
end
if n > 0:
upstream.WriteBytes(data, n)
end
client := tunnel.WrapTcp(c)
tunnel.Relay(client, upstream)
ret true
end
func _read_exact(c: tcp.Conn, buf: void*, n: int): bool:
mut got := 0
until got < n:
r := tcp.ReadBytes(c, _off(buf, got), n - got)
if r <= 0:
ret false
end
got += r
end
ret true
end
func _query_get(q: str, key: str): str:
mut parts := str.Split(q, "&")
defer parts.free()
repeat parts.len() in i:
kv := parts.get(i)
if str.StartsWith(kv, key + "="):
ret tunnel.PctDecode(str.Substr(kv, key.len() + 1, kv.len() - key.len() - 1))
end
end
ret ""
end
@en "GenerateKey"
@fa "ساخت کلید"
pub func GenerateKey(): KeyPair:
priv := mem.AllocateZeroed(32 as u64)
pubk := mem.AllocateZeroed(32 as u64)
crypto.RandomBytes(priv, 32)
tls.X25519Public(priv, pubk)
kp := KeyPair { private_key = _b64encode(priv, 32), public_key = _b64encode(pubk, 32) }
mem.Free(priv)
mem.Free(pubk)
ret kp
end
@en "PublicKeyOf"
@fa "کلید عمومی از خصوصی"
pub func PublicKeyOf(private_key: str): str:
priv := mem.AllocateZeroed(32 as u64)
pubk := mem.AllocateZeroed(32 as u64)
mut out := ""
if _b64decode(private_key, priv, 32):
tls.X25519Public(priv, pubk)
out = _b64encode(pubk, 32)
end
mem.Free(priv)
mem.Free(pubk)
ret out
end
@en "NewShortId"
@fa "شناسه کوتاه جدید"
pub func NewShortId(bytes: int): str:
mut n := bytes
if n < 1:
n = 1
end
if n > 8:
n = 8
end
raw := mem.AllocateZeroed(8 as u64)
crypto.RandomBytes(raw, n)
mut parts := Vector {} as Vector<str>
defer parts.free()
digits := "0123456789abcdef"
repeat n in i:
v := _at(raw, i)
parts.push(str.Substr(digits, v >> 4, 1) + str.Substr(digits, v & 15, 1))
end
mem.Free(raw)
ret str.Join(parts, "")
end
@en "ValidPublicKey"
@fa "کلید عمومی معتبر"
pub func ValidPublicKey(public_key: str): bool:
k := mem.AllocateZeroed(32 as u64)
ok := _b64decode(public_key, k, 32)
mem.Free(k)
ret ok
end
@en "ValidShortId"
@fa "شناسه کوتاه معتبر"
pub func ValidShortId(short_id: str): bool:
k := mem.AllocateZeroed(8 as u64)
ok := _short_id_bytes(short_id, k)
mem.Free(k)
ret ok
end
@en "DialOver"
@fa "اتصال روی"
pub func DialOver(fd: i64, s: Settings): tls.Conn:
spub := mem.AllocateZeroed(32 as u64)
defer mem.Free(spub)
if not _b64decode(s.public_key, spub, 32):
ret _fail_conn("reality: public key must be 43 base64url characters")
end
short8 := mem.AllocateZeroed(8 as u64)
defer mem.Free(short8)
if not _short_id_bytes(s.short_id, short8):
ret _fail_conn("reality: short id must be 0 to 16 hex digits, an even count")
end
mut name := s.fingerprint
if name.len() == 0:
name = "chrome"
end
sp := utls.Profile(name)
if not sp.ok:
ret _fail_conn("reality: unknown fingerprint " + name)
end
mut o := utls.Options {}
o.server_name = s.server_name
o.alpn = s.alpn
o.pq = true
mut h := utls.Build(sp, o)
if not h.ok:
ret _fail_conn(h.err)
end
if not _seal_session(h, spub, short8, s.clock_offset):
utls.FreeHello(h)
ret _fail_conn("reality: could not derive the session key")
end
auth := mem.AllocateZeroed(32 as u64)
defer mem.Free(auth)
shared := mem.AllocateZeroed(32 as u64)
tls.X25519Shared(h.priv.p, spub, shared)
_auth_key(shared, _off(h.raw.p, 6), auth)
mem.Free(shared)
cfg := tls.NewConfig(s.server_name)
conn := tls.WrapClientRawPq(fd, h.raw.p, h.raw.len, h.priv.p, utls.PqSeed(h), auth, 32, cfg)
utls.FreeHello(h)
ret conn
end
@en "Accept"
@fa "پذیرش"
pub func Accept(fd: i64, ss: ServerSettings): Accepted:
mut res := Accepted {}
c := tcp.ConnFromFd(fd)
tcp.SetReadDeadline(c, 10000)
buf := mem.AllocateZeroed(16700 as u64)
defer mem.Free(buf)
if not _read_exact(c, buf, 5):
tcp.Close(c)
res.err = "no data"
ret res
end
mut have := 5
rl := (_at(buf, 3) << 8) | _at(buf, 4)
if _at(buf, 0) != 0x16 or rl < 40 or rl > 16384 or _at(buf, 1) != 3:
res.proxied = _proxy_to_dest(c, ss, buf, have)
res.err = "not a TLS ClientHello"
ret res
end
if not _read_exact(c, _off(buf, 5), rl):
tcp.Close(c)
res.err = "truncated ClientHello"
ret res
end
have += rl
msg := _off(buf, 5)
p := _parse_hello(msg, rl)
ok_shape := p.ok and p.sid_len == 32 and p.tls13 and p.share_off > 0
mut authed := false
auth := mem.AllocateZeroed(32 as u64)
defer mem.Free(auth)
id8 := mem.AllocateZeroed(16 as u64)
defer mem.Free(id8)
if ok_shape and _csv_has(ss.server_names, p.sni):
priv := mem.AllocateZeroed(32 as u64)
defer mem.Free(priv)
shared := mem.AllocateZeroed(32 as u64)
defer mem.Free(shared)
if _b64decode(ss.private_key, priv, 32) and tls.X25519Shared(priv, _off(msg, p.share_off), shared):
if _auth_key(shared, _off(msg, p.random_off), auth):
aad := mem.AllocateZeroed((rl + 1) as u64)
defer mem.Free(aad)
mem.Copy(aad, msg, rl as u64)
repeat 32 in i:
ab := aad as u8*
ab[p.sid_off + i] = 0 as u8
end
if tls.AesGcmOpenRaw(auth, 32, _off(msg, p.random_off + 20), aad, rl, _off(msg, p.sid_off), 32, id8):
ok_id := _short_id_known(ss, _off(id8, 8))
mut ok_time := true
if ss.max_time_diff > 0:
t := ((_at(id8, 4) as i64) << (24 as i64)) | ((_at(id8, 5) as i64) << (16 as i64)) | ((_at(id8, 6) as i64) << (8 as i64)) | (_at(id8, 7) as i64)
now := time.Now()
mut d := now - t
if d < (0 as i64):
d = (0 as i64) - d
end
ok_time = d * (1000 as i64) <= (ss.max_time_diff as i64)
end
authed = ok_id and ok_time
end
end
end
end
if not authed:
res.proxied = _proxy_to_dest(c, ss, buf, have)
res.err = "not authenticated"
ret res
end
seed := mem.AllocateZeroed(32 as u64)
defer mem.Free(seed)
crypto.RandomBytes(seed, 32)
mut cert := _make_cert(seed, auth)
res.conn = tls.WrapServerRaw(fd, msg, rl, cert.p, cert.len, seed)
_bfree(cert)
res.sni = p.sni
res.short_id = _short_id_hex(_off(id8, 8))
res.client_version = str.FromInt(_at(id8, 0) as i64) + "." + str.FromInt(_at(id8, 1) as i64) + "." + str.FromInt(_at(id8, 2) as i64)
res.ok = tls.ConnOk(res.conn)
if not res.ok:
res.err = tls.ConnError(res.conn)
end
ret res
end
@en "ParseParams"
@fa "خواندن پارامترها"
pub func ParseParams(query: str): Settings:
mut s := Settings {}
s.public_key = _query_get(query, "pbk")
s.short_id = _query_get(query, "sid")
s.spider_x = _query_get(query, "spx")
s.server_name = _query_get(query, "sni")
s.flow = _query_get(query, "flow")
s.alpn = _query_get(query, "alpn")
fp := _query_get(query, "fp")
if fp.len() > 0:
s.fingerprint = fp
end
ret s
end
@en "FormatParams"
@fa "نوشتن پارامترها"
pub func FormatParams(s: Settings): str:
mut q := "security=reality&pbk=" + s.public_key
if s.short_id.len() > 0:
q += "&sid=" + s.short_id
end
if s.spider_x.len() > 0:
q += "&spx=" + s.spider_x
end
if s.server_name.len() > 0:
q += "&sni=" + s.server_name
end
if s.fingerprint.len() > 0:
q += "&fp=" + s.fingerprint
end
if s.flow.len() > 0:
q += "&flow=" + s.flow
end
ret q
end
@en "net/router"
@fa "مسیریاب"
package router
import mem
const _CH_SLASH := 47
const _CH_COLON := 58
const _CH_STAR := 42
@en "Param"
@fa "پارامتر"
pub struct Param:
@en "key"
@fa "کلید"
pub key: str = ""
@en "value"
@fa "مقدار"
pub value: str = ""
end
@en "ParamList"
@fa "پارامترها"
pub struct ParamList:
@en "items"
@fa "اقلام"
pub items: Vector<Param> = Vector {}
end
@en "Route"
@fa "مسیر مسیریابی"
pub struct Route:
@en "method"
@fa "روش"
pub method: str = ""
@en "pattern"
@fa "الگو"
pub pattern: str = ""
@en "fn"
@fa "گرداننده"
pub fn: i64 = 0
@en "mid"
@fa "شناسه روش"
pub mid: int = 0
@en "spec"
@fa "نوع الگو"
pub spec: int = 0
end
@en "Router"
@fa "مسیریاب"
pub struct Router:
@en "routes"
@fa "مسیرها"
pub routes: Vector<Route> = Vector {}
@en "static_prefix"
@fa "پیشوند ایستا"
pub static_prefix: str = ""
@en "static_dir"
@fa "پوشه ایستا"
pub static_dir: str = ""
@en "has_static"
@fa "ایستا فعال"
pub has_static: bool = false
@en "static_listing"
@fa "فهرست ایستا"
pub static_listing: bool = false
@en "fallback"
@fa "مدیر پیش‌فرض"
pub fallback: i64 = 0
@en "idx"
@fa "جدول نمایه"
pub idx: Vector<int> = Vector {}
@en "idx_mask"
@fa "پوشش نمایه"
pub idx_mask: int = 0
@en "n_literal"
@fa "شمار ثابت‌ها"
pub n_literal: int = 0
@en "n_dynamic"
@fa "شمار پویاها"
pub n_dynamic: int = 0
end
@en "Match"
@fa "تطابق"
pub struct Match:
@en "matched"
@fa "پیدا شد"
pub matched: bool = false
@en "fn"
@fa "گرداننده"
pub fn: i64 = 0
@en "params"
@fa "پارامترها"
pub params: ParamList = ParamList {}
end
func _free_params(p &: ParamList):
n := p.items.len()
mut i := 0
until i < n:
kv := p.items.get(i)
mem.Free(kv.key as void *)
mem.Free(kv.value as void *)
i++
end
p.items.free()
p.items = Vector {} as Vector<Param>
end
func _method_id(m: str): int:
if m == "GET": ret 1 end
if m == "POST": ret 2 end
if m == "PUT": ret 3 end
if m == "DELETE": ret 4 end
if m == "PATCH": ret 5 end
if m == "HEAD": ret 6 end
if m == "OPTIONS": ret 7 end
ret 0
end
func _hash_key(mid: int, s: str): int:
mut h := 2166136261 as i64
h = ((h ^ (mid as i64)) * 16777619) & 4294967295
p := s as i8 *
n := s.len()
mut i := 0
until i < n:
h = ((h ^ ((p[i] as i64) & 255)) * 16777619) & 4294967295
i++
end
ret (h & 2147483647) as int
end
func _param_get(p: ParamList, key: str): str:
n := p.items.len()
mut i := 0
until i < n:
kv := p.items.get(i)
if kv.key == key: ret kv.value end
i++
end
ret ""
end
func _specificity(pattern: str): int:
if pattern.find("*") >= 0: ret 2 end
if pattern.find(":") >= 0: ret 1 end
ret 0
end
func _byte_at(s: str, i: int): int:
p := s as i8 *
ret p[i]
end
func _try_match(pattern: str, path: str, out_params &: ParamList): bool:
mut pi := 0
mut pp := 0
plen := pattern.len()
pathlen := path.len()
until pi < plen or pp < pathlen:
if pi < plen and _byte_at(pattern, pi) == _CH_STAR:
ret true
end
if pi < plen and _byte_at(pattern, pi) == _CH_COLON:
mut ne := pi + 1
until ne < plen and _byte_at(pattern, ne) != _CH_SLASH:
ne++
end
pname := pattern.substr(pi + 1, ne - pi - 1)
mut ve := pp
until ve < pathlen and _byte_at(path, ve) != _CH_SLASH:
ve++
end
pval := path.substr(pp, ve - pp)
out_params.items.push(Param { key = pname, value = pval })
pi = ne
pp = ve
else:
if pi >= plen or pp >= pathlen:
break
end
if _byte_at(pattern, pi) != _byte_at(path, pp):
ret false
end
pi++
pp++
end
end
until pi < plen and _byte_at(pattern, pi) == _CH_SLASH: pi++ end
until pp < pathlen and _byte_at(path, pp) == _CH_SLASH: pp++ end
ret pi == plen and pp == pathlen
end
func _idx_insert(r &: Router, ri: int):
route := r.routes.get(ri)
if route.spec != 0: ret end
mut slot := _hash_key(route.mid, route.pattern) & r.idx_mask
until r.idx.get(slot) != 0:
prev := r.routes.get(r.idx.get(slot) - 1)
if prev.mid == route.mid and prev.method == route.method and prev.pattern == route.pattern:
ret
end
slot = (slot + 1) & r.idx_mask
end
r.idx.set(slot, ri + 1)
end
func _idx_grow(r &: Router, cap: int):
r.idx.free()
r.idx = Vector {} as Vector<int>
repeat cap in _:
r.idx.push(0)
end
r.idx_mask = cap - 1
n := r.routes.len()
mut i := 0
until i < n:
_idx_insert(r, i)
i++
end
end
func _add(r &: Router, method: str, pattern: str, fn: i64):
mut rt := Route {}
rt.method = method
rt.pattern = pattern
rt.fn = fn
rt.spec = _specificity(pattern)
rt.mid = _method_id(method)
r.routes.push(rt)
if rt.spec != 0:
r.n_dynamic++
ret
end
r.n_literal++
cap := r.idx_mask + 1
if (r.n_literal * 2) > cap:
mut want := 16
until want < (r.n_literal * 4):
want *= 2
end
_idx_grow(r, want)
else:
_idx_insert(r, r.routes.len() - 1)
end
end
func _dispatch_exact(r: Router, method: str, path: str): Match:
mut m := Match {}
mid := _method_id(method)
if r.idx_mask > 0:
mut slot := _hash_key(mid, path) & r.idx_mask
until r.idx.get(slot) != 0:
route := r.routes.get(r.idx.get(slot) - 1)
if route.mid == mid and route.pattern == path:
if mid != 0 or route.method == method:
m.matched = true
m.fn = route.fn
ret m
end
end
slot = (slot + 1) & r.idx_mask
end
end
if r.n_dynamic == 0: ret m end
n := r.routes.len()
mut best := 3
mut i := 0
until i < n:
route := r.routes.get(i)
if route.spec != 0 and route.mid == mid and route.spec < best:
if mid != 0 or route.method == method:
mut params := ParamList {}
if _try_match(route.pattern, path, params):
_free_params(m.params)
m.matched = true
m.fn = route.fn
m.params = params
best = route.spec
else:
_free_params(params)
end
end
end
i++
end
ret m
end
@en "NewRouter"
@fa "مسیریاب جدید"
pub func NewRouter(): Router:
ret Router {}
end
@en "Get"
@fa "دریافت"
pub func Get(r &: Router, path: str, fn: i64): _add(r, "GET", path, fn) end
@en "Post"
@fa "ارسال"
pub func Post(r &: Router, path: str, fn: i64): _add(r, "POST", path, fn) end
@en "Put"
@fa "قراردادن"
pub func Put(r &: Router, path: str, fn: i64): _add(r, "PUT", path, fn) end
@en "Delete"
@fa "حذف"
pub func Delete(r &: Router, path: str, fn: i64): _add(r, "DELETE", path, fn) end
@en "Patch"
@fa "وصله"
pub func Patch(r &: Router, path: str, fn: i64): _add(r, "PATCH", path, fn) end
@en "Head"
@fa "سر"
pub func Head(r &: Router, path: str, fn: i64): _add(r, "HEAD", path, fn) end
@en "Options"
@fa "گزینه ها"
pub func Options(r &: Router, path: str, fn: i64): _add(r, "OPTIONS", path, fn) end
@en "Method"
@fa "روش"
pub func Method(r &: Router, method: str, path: str, fn: i64):
_add(r, method, path, fn)
end
@en "Group"
@fa "گروه"
pub func Group(r &: Router, prefix: str, method: str, path: str, fn: i64):
_add(r, method, prefix + path, fn)
end
@en "Static"
@fa "ایستا"
pub func Static(r &: Router, prefix: str, dir: str):
r.static_prefix = prefix
r.static_dir = dir
r.has_static = true
end
@en "EnableListing"
@fa "فعال سازی فهرست پوشه"
pub func EnableListing(r &: Router):
r.static_listing = true
end
@en "SetFallback"
@fa "تنظیم مدیر پیش‌فرض"
pub func SetFallback(r &: Router, fn: i64):
r.fallback = fn
end
@en "ParamGet"
@fa "دریافت پارامتر"
pub func ParamGet(m: Match, key: str): str:
ret _param_get(m.params, key)
end
@en "Dispatch"
@fa "اعزام"
pub func Dispatch(r: Router, method: str, path: str): Match:
m := _dispatch_exact(r, method, path)
if not m.matched and method == "HEAD":
ret _dispatch_exact(r, "GET", path)
end
ret m
end
@en "FreeMatch"
@fa "آزادسازی تطابق"
pub func FreeMatch(m &: Match):
_free_params(m.params)
end
package shadowsocks
import mem
import str
@en "ATYP_IPV4"
@fa "نوع آدرس آی پی۴"
pub const ATYP_IPV4 := 1
@en "ATYP_DOMAIN"
@fa "نوع آدرس دامنه"
pub const ATYP_DOMAIN := 3
@en "ATYP_IPV6"
@fa "نوع آدرس آی پی۶"
pub const ATYP_IPV6 := 4
@en "Target"
@fa "مقصد"
pub struct Target:
@en "host"
@fa "میزبان"
pub host: str = ""
@en "port"
@fa "درگاه"
pub port: int = 0
end
func _parse_v4(s: str, out: void*): bool:
n := s.len()
mut part := 0
mut digits := 0
mut idx := 0
repeat n + 1 in i:
mut c := 46
if i < n:
c = _getb(s as void*, i)
end
if c == 46:
if digits == 0 or idx > 3:
ret false
end
_setb(out, idx, part)
idx++
part = 0
digits = 0
else c >= 48 and c <= 57:
part = part * 10 + (c - 48)
digits++
if part > 255 or digits > 3:
ret false
end
else:
ret false
end
end
ret idx == 4
end
func _hexdigit(c: int): int:
if c >= 48 and c <= 57:
ret c - 48
end
if c >= 97 and c <= 102:
ret c - 87
end
if c >= 65 and c <= 70:
ret c - 55
end
ret 0 - 1
end
func _parse_v6(s0: str, out: void*): bool:
mut s := s0
n0 := s.len()
if n0 >= 2 and _getb(s as void*, 0) == 91 and _getb(s as void*, n0 - 1) == 93:
s = str.Substr(s, 1, n0 - 2)
end
n := s.len()
groups := mem.AllocateZeroed(16 as u64)
defer mem.Free(groups)
mut gi := 0
mut gap := 0 - 1
mut i := 0
until i < n:
c := _getb(s as void*, i)
if c == 58:
if i + 1 < n and _getb(s as void*, i + 1) == 58:
if gap >= 0:
ret false
end
gap = gi
i += 2
if i >= n:
break
end
else:
if i == 0 or i + 1 >= n:
ret false
end
i++
end
end
mut v := 0
mut nd := 0
until i < n and _hexdigit(_getb(s as void*, i)) >= 0:
v = v * 16 + _hexdigit(_getb(s as void*, i))
nd++
i++
if nd > 4:
ret false
end
end
if nd == 0:
ret false
end
if gi >= 8:
ret false
end
_setb(groups, gi * 2, v >> 8)
_setb(groups, gi * 2 + 1, v)
gi++
end
_wipe(out, 16)
if gap < 0:
if gi != 8:
ret false
end
mem.Copy(out, groups, 16 as u64)
ret true
end
if gi > 7:
ret false
end
mem.Copy(out, groups, (gap * 2) as u64)
tail := gi - gap
mem.Copy(_at(out, 16 - tail * 2), _at(groups, gap * 2), (tail * 2) as u64)
ret true
end
func _cstr(p: void*, n: int): str:
d := mem.Allocate((n + 1) as u64)
mem.Copy(d, p, n as u64)
_setb(d, n, 0)
ret d as str
end
func _hex4(v: int): str:
digits := "0123456789abcdef"
mut r := ""
mut x := v
if x == 0:
ret "0"
end
until x > 0:
r = str.Substr(digits, x % 16, 1) + r
x /= 16
end
ret r
end
func _fmt_v6(p: void*): str:
mut best := 0 - 1
mut blen := 0
mut i := 0
until i < 8:
if _getb(p, i * 2) == 0 and _getb(p, i * 2 + 1) == 0:
mut j := i
until j < 8 and _getb(p, j * 2) == 0 and _getb(p, j * 2 + 1) == 0:
j++
end
if j - i > blen and j - i >= 2:
best = i
blen = j - i
end
i = j
else:
i++
end
end
mut r := ""
mut k := 0
until k < 8:
if k == best:
r += "::"
k += blen
else:
if k > 0 and k != best + blen:
r += ":"
end
v := _getb(p, k * 2) * 256 + _getb(p, k * 2 + 1)
r += _hex4(v)
k++
end
end
ret r
end
@en "EncodeTarget"
@fa "رمزگذاری مقصد"
pub func EncodeTarget(host: str, port: int, out &: Buf): bool:
if port < 0 or port > 65535:
ret false
end
tmp := mem.AllocateZeroed(16 as u64)
defer mem.Free(tmp)
if _parse_v4(host, tmp):
BufAppendByte(out, ATYP_IPV4)
BufAppend(out, tmp, 4)
else _parse_v6(host, tmp):
BufAppendByte(out, ATYP_IPV6)
BufAppend(out, tmp, 16)
else:
hl := host.len()
if hl < 1 or hl > 255:
ret false
end
BufAppendByte(out, ATYP_DOMAIN)
BufAppendByte(out, hl)
BufAppend(out, host as void*, hl)
end
BufAppendByte(out, port >> 8)
BufAppendByte(out, port)
ret true
end
@en "ParseTarget"
@fa "تجزیه مقصد"
pub func ParseTarget(p: void*, n: int, t &: Target): int:
if n < 1:
ret 0
end
atyp := _getb(p, 0)
mut hlen := 0
mut hoff := 1
if atyp == ATYP_IPV4:
hlen = 4
else atyp == ATYP_IPV6:
hlen = 16
else atyp == ATYP_DOMAIN:
if n < 2:
ret 0
end
hlen = _getb(p, 1)
hoff = 2
if hlen == 0:
ret 0 - 1
end
else:
ret 0 - 1
end
total := hoff + hlen + 2
if n < total:
ret 0
end
mut host := ""
if atyp == ATYP_IPV4:
host = str.FromInt(_getb(p, 1) as i64) + "." + str.FromInt(_getb(p, 2) as i64) + "." + str.FromInt(_getb(p, 3) as i64) + "." + str.FromInt(_getb(p, 4) as i64)
else atyp == ATYP_IPV6:
host = _fmt_v6(_at(p, 1))
else:
host = _cstr(_at(p, hoff), hlen)
end
t.host = host
t.port = _getb(p, hoff + hlen) * 256 + _getb(p, hoff + hlen + 1)
ret total
end
package shadowsocks
import mem
const B3_CHUNK_START := 1 as u32
const B3_CHUNK_END := 2 as u32
const B3_PARENT := 4 as u32
const B3_ROOT := 8 as u32
const B3_KEYED_HASH := 16 as u32
const B3_DERIVE_CONTEXT := 32 as u32
const B3_DERIVE_MATERIAL := 64 as u32
const B3_STACK_WORDS := 8 * 64
func _b3_iv(i: int): u32:
if i == 0:
ret 0x6A09E667
end
if i == 1:
ret 0xBB67AE85
end
if i == 2:
ret 0x3C6EF372
end
if i == 3:
ret 0xA54FF53A
end
if i == 4:
ret 0x510E527F
end
if i == 5:
ret 0x9B05688C
end
if i == 6:
ret 0x1F83D9AB
end
ret 0x5BE0CD19
end
inline func _b3_rotr(x: u32, n: int): u32:
ret (x >> (n as u32)) | (x << ((32 - n) as u32))
end
inline func _b3_g(v: u32*, a: int, b: int, c: int, d: int, mx: u32, my: u32):
v[a] = v[a] + v[b] + mx
v[d] = _b3_rotr(v[d] ^ v[a], 16)
v[c] += v[d]
v[b] = _b3_rotr(v[b] ^ v[c], 12)
v[a] = v[a] + v[b] + my
v[d] = _b3_rotr(v[d] ^ v[a], 8)
v[c] += v[d]
v[b] = _b3_rotr(v[b] ^ v[c], 7)
end
func _b3_round(v: u32*, m: u32*):
_b3_g(v, 0, 4, 8, 12, m[0], m[1])
_b3_g(v, 1, 5, 9, 13, m[2], m[3])
_b3_g(v, 2, 6, 10, 14, m[4], m[5])
_b3_g(v, 3, 7, 11, 15, m[6], m[7])
_b3_g(v, 0, 5, 10, 15, m[8], m[9])
_b3_g(v, 1, 6, 11, 12, m[10], m[11])
_b3_g(v, 2, 7, 8, 13, m[12], m[13])
_b3_g(v, 3, 4, 9, 14, m[14], m[15])
end
func _b3_permute(m: u32*, t: u32*):
perm := [2, 6, 3, 10, 7, 0, 4, 13, 1, 11, 12, 5, 9, 14, 15, 8]
repeat 16 in i:
t[i] = m[perm[i]]
end
repeat 16 in j:
m[j] = t[j]
end
end
func _b3_compress(cv: u32*, block: u32*, counter: u64, blen: u32, flags: u32, out: u32*):
v := mem.Allocate(64 as u64) as u32*
m := mem.Allocate(64 as u64) as u32*
t := mem.Allocate(64 as u64) as u32*
repeat 8 in i:
v[i] = cv[i]
end
repeat 4 in j:
v[8 + j] = _b3_iv(j)
end
v[12] = (counter & (0xFFFFFFFF as u64)) as u32
v[13] = (counter >> (32 as u64)) as u32
v[14] = blen
v[15] = flags
repeat 16 in k:
m[k] = block[k]
end
repeat 7 in r:
_b3_round(v, m)
if r < 6:
_b3_permute(m, t)
end
end
repeat 8 in x:
out[x] = v[x] ^ v[x + 8]
out[x + 8] = v[x + 8] ^ cv[x]
end
mem.Free(v as void*)
mem.Free(m as void*)
mem.Free(t as void*)
end
func _b3_load(data: void*, n: int, block: u32*):
bp := data as u8*
repeat 16 in w:
mut x := 0 as u32
repeat 4 in b:
idx := w * 4 + b
if idx < n:
x |= (bp[idx] as u32) << ((b * 8) as u32)
end
end
block[w] = x
end
end
func _b3_chunk_out(key: u32*, data: void*, n: int, counter: u64, base: u32, o: u32*):
mut nblocks := (n + 63) / 64
if nblocks == 0:
nblocks = 1
end
tmp := mem.Allocate(64 as u64) as u32*
repeat 8 in i:
o[i] = key[i]
end
repeat nblocks in b:
mut blen := n - b * 64
if blen > 64:
blen = 64
end
_b3_load(_at(data, b * 64), blen, _b3_at(o, 8))
mut fl := base
if b == 0:
fl |= B3_CHUNK_START
end
if b == nblocks - 1:
fl |= B3_CHUNK_END
end
o[24] = (counter & (0xFFFFFFFF as u64)) as u32
o[25] = (counter >> (32 as u64)) as u32
o[26] = blen as u32
o[27] = fl
if b < nblocks - 1:
_b3_compress(o, _b3_at(o, 8), counter, blen as u32, fl, tmp)
repeat 8 in j:
o[j] = tmp[j]
end
end
end
mem.Free(tmp as void*)
end
inline func _b3_at(p: u32*, off: int): u32*:
ret (((p as i64) + ((off * 4) as i64)) as void*) as u32*
end
func _b3_out_cv(o: u32*, cv: u32*):
tmp := mem.Allocate(64 as u64) as u32*
counter := (o[24] as u64) | ((o[25] as u64) << (32 as u64))
_b3_compress(o, _b3_at(o, 8), counter, o[26], o[27], tmp)
repeat 8 in i:
cv[i] = tmp[i]
end
mem.Free(tmp as void*)
end
func _b3_parent_out(key: u32*, left: u32*, right: u32*, base: u32, o: u32*):
repeat 8 in i:
o[i] = key[i]
o[8 + i] = left[i]
o[16 + i] = right[i]
end
o[24] = 0 as u32
o[25] = 0 as u32
o[26] = 64 as u32
o[27] = B3_PARENT | base
end
func _b3_root(o: u32*, out: void*, outlen: int):
tmp := mem.Allocate(64 as u64) as u32*
mut done := 0
mut t := 0 as u64
until done < outlen:
_b3_compress(o, _b3_at(o, 8), t, o[26], o[27] | B3_ROOT, tmp)
mut take := outlen - done
if take > 64:
take = 64
end
repeat take in i:
w := tmp[i / 4]
_setb(out, done + i, ((w >> (((i % 4) * 8) as u32)) & (0xFF as u32)) as int)
end
done += take
t++
end
mem.Free(tmp as void*)
end
func _b3_hash_with(key: u32*, base: u32, p: void*, n: int, out: void*, outlen: int):
mut nchunks := (n + 1023) / 1024
if nchunks == 0:
nchunks = 1
end
stack := mem.Allocate((B3_STACK_WORDS * 4) as u64) as u32*
o := mem.Allocate(112 as u64) as u32*
o2 := mem.Allocate(112 as u64) as u32*
cv := mem.Allocate(32 as u64) as u32*
mut sp := 0
repeat nchunks - 1 in ci:
_b3_chunk_out(key, _at(p, ci * 1024), 1024, ci as u64, base, o)
_b3_out_cv(o, cv)
mut tt := ci + 1
until tt % 2 == 0:
sp--
_b3_parent_out(key, _b3_at(stack, sp * 8), cv, base, o2)
_b3_out_cv(o2, cv)
tt /= 2
end
repeat 8 in w:
stack[sp * 8 + w] = cv[w]
end
sp++
end
last := nchunks - 1
mut lastlen := n - last * 1024
if lastlen < 0:
lastlen = 0
end
_b3_chunk_out(key, _at(p, last * 1024), lastlen, last as u64, base, o)
until sp > 0:
sp--
_b3_out_cv(o, cv)
_b3_parent_out(key, _b3_at(stack, sp * 8), cv, base, o2)
repeat 28 in w:
o[w] = o2[w]
end
end
_b3_root(o, out, outlen)
mem.Free(stack as void*)
mem.Free(o as void*)
mem.Free(o2 as void*)
mem.Free(cv as void*)
end
func _b3_key_words(key: void*, out: u32*):
repeat 8 in i:
mut x := 0 as u32
repeat 4 in b:
x |= (_getb(key, i * 4 + b) as u32) << ((b * 8) as u32)
end
out[i] = x
end
end
func _b3_iv_key(out: u32*):
repeat 8 in i:
out[i] = _b3_iv(i)
end
end
@en "Blake3Hash"
@fa "هش بلیک۳"
pub func Blake3Hash(p: void*, n: int, out: void*, outlen: int):
key := mem.Allocate(32 as u64) as u32*
_b3_iv_key(key)
_b3_hash_with(key, 0 as u32, p, n, out, outlen)
mem.Free(key as void*)
end
@en "Blake3KeyedHash"
@fa "هش کلیددار بلیک۳"
pub func Blake3KeyedHash(key32: void*, p: void*, n: int, out: void*, outlen: int):
key := mem.Allocate(32 as u64) as u32*
_b3_key_words(key32, key)
_b3_hash_with(key, B3_KEYED_HASH, p, n, out, outlen)
mem.Free(key as void*)
end
@en "Blake3DeriveKey"
@fa "اشتقاق کلید بلیک۳"
pub func Blake3DeriveKey(context: str, p: void*, n: int, out: void*, outlen: int):
key := mem.Allocate(32 as u64) as u32*
_b3_iv_key(key)
cbytes := mem.AllocateZeroed(32 as u64)
_b3_hash_with(key, B3_DERIVE_CONTEXT, context as void*, context.len(), cbytes, 32)
_b3_key_words(cbytes, key)
_b3_hash_with(key, B3_DERIVE_MATERIAL, p, n, out, outlen)
mem.Free(cbytes)
mem.Free(key as void*)
end
@en "Blake3SessionKey"
@fa "کلید نشست بلیک۳"
pub func Blake3SessionKey(psk: void*, klen: int, salt: void*, slen: int, out: void*):
mat := mem.AllocateZeroed((klen + slen) as u64)
mem.Copy(mat, psk, klen as u64)
mem.Copy(_at(mat, klen), salt, slen as u64)
Blake3DeriveKey("shadowsocks 2022 session subkey", mat, klen + slen, out, klen)
_wipe(mat, klen + slen)
mem.Free(mat)
end
package shadowsocks
import mem
import tls
@en "Encoder"
@fa "رمزگذار"
pub struct Encoder:
@en "method"
@fa "روش"
pub method: Method = Method {}
@en "ctx"
@fa "زمینه"
pub ctx: void* = null
@en "nonce"
@fa "نانس"
pub nonce: void* = null
@en "salt"
@fa "نمک"
pub salt: Buf = Buf {}
@en "salt_sent"
@fa "نمک فرستاده شد"
pub salt_sent: bool = false
@en "max_chunk"
@fa "بیشینه تکه"
pub max_chunk: int = 0x3fff
end
@en "Decoder"
@fa "رمزگشا"
pub struct Decoder:
@en "method"
@fa "روش"
pub method: Method = Method {}
@en "master"
@fa "کلید اصلی"
pub master: void* = null
@en "ctx"
@fa "زمینه"
pub ctx: void* = null
@en "nonce"
@fa "نانس"
pub nonce: void* = null
@en "salt"
@fa "نمک"
pub salt: Buf = Buf {}
@en "have_salt"
@fa "نمک دریافت شد"
pub have_salt: bool = false
@en "inb"
@fa "ورودی"
pub inb: Buf = Buf {}
@en "off"
@fa "جابجایی"
pub off: int = 0
@en "need"
@fa "نیاز"
pub need: int = 0 - 1
@en "tmp"
@fa "موقت"
pub tmp: Buf = Buf {}
@en "bad"
@fa "خراب"
pub bad: bool = false
@en "max_chunk"
@fa "بیشینه تکه"
pub max_chunk: int = 0x3fff
end
func _nonce_inc(n: void*):
mut i := 0
until i < 12:
v := _getb(n, i) + 1
_setb(n, i, v)
if v < 256:
break
end
i++
end
end
func _derive_key(m: Method, master: void*, salt: void*, out: void*):
if m.v2022:
Blake3SessionKey(master, m.key_len, salt, m.salt_len, out)
else:
SessionSubkey(m, master, salt, out)
end
end
func _open_ctx(m: Method, master: void*, salt: void*): void*:
sub := mem.AllocateZeroed(32 as u64)
_derive_key(m, master, salt, sub)
c := tls.AeadNew(m.kind, sub)
_wipe(sub, 32)
mem.Free(sub)
ret c
end
@en "NewEncoder"
@fa "رمزگذار جدید"
pub func NewEncoder(m: Method, master: void*, salt: void*): Encoder:
mut e := Encoder { method = m }
if m.v2022:
e.max_chunk = 0xffff
end
e.salt = NewBuf(m.salt_len)
BufAppend(e.salt, salt, m.salt_len)
e.ctx = _open_ctx(m, master, salt)
e.nonce = mem.AllocateZeroed(12 as u64)
ret e
end
@en "NewEncoderRandom"
@fa "رمزگذار جدید تصادفی"
pub func NewEncoderRandom(m: Method, master: void*): Encoder:
s := mem.AllocateZeroed(m.salt_len as u64)
RandomSalt(m, s)
e := NewEncoder(m, master, s)
mem.Free(s)
ret e
end
@en "EncoderFree"
@fa "آزادسازی رمزگذار"
pub func EncoderFree(e &: Encoder):
tls.AeadFree(e.ctx)
e.ctx = null
if e.nonce != null:
mem.Free(e.nonce)
end
e.nonce = null
BufFree(e.salt)
end
@en "SealFrame"
@fa "مهر قاب"
pub func SealFrame(e &: Encoder, pt: void*, n: int, out &: Buf):
BufReserve(out, n + TAG_LEN)
if out.bad:
ret
end
tls.AeadSeal(e.ctx, e.nonce, null, 0, pt, n, _at(out.p, out.len))
out.len += n + TAG_LEN
_nonce_inc(e.nonce)
end
@en "EmitSalt"
@fa "ارسال نمک"
pub func EmitSalt(e &: Encoder, out &: Buf):
if e.salt_sent:
ret
end
BufAppend(out, e.salt.p, e.salt.len)
e.salt_sent = true
end
@en "EncodeStream"
@fa "رمزگذاری جریان"
pub func EncodeStream(e &: Encoder, data: void*, n: int, out &: Buf):
EmitSalt(e, out)
hdr := mem.AllocateZeroed(2 as u64)
mut off := 0
until off < n:
mut take := n - off
if take > e.max_chunk:
take = e.max_chunk
end
_setb(hdr, 0, take >> 8)
_setb(hdr, 1, take)
SealFrame(e, hdr, 2, out)
SealFrame(e, _at(data, off), take, out)
off += take
end
mem.Free(hdr)
end
@en "NewDecoder"
@fa "رمزگشا جدید"
pub func NewDecoder(m: Method, master: void*): Decoder:
mut d := Decoder { method = m }
if m.v2022:
d.max_chunk = 0xffff
end
d.master = mem.AllocateZeroed(32 as u64)
mem.Copy(d.master, master, m.key_len as u64)
d.salt = NewBuf(m.salt_len)
d.inb = NewBuf(4096)
d.tmp = NewBuf(64)
d.nonce = mem.AllocateZeroed(12 as u64)
ret d
end
@en "DecoderFree"
@fa "آزادسازی رمزگشا"
pub func DecoderFree(d &: Decoder):
tls.AeadFree(d.ctx)
d.ctx = null
if d.master != null:
_wipe(d.master, 32)
mem.Free(d.master)
end
d.master = null
if d.nonce != null:
mem.Free(d.nonce)
end
d.nonce = null
BufFree(d.salt)
BufWipe(d.inb)
BufFree(d.inb)
BufFree(d.tmp)
end
@en "Feed"
@fa "خوراندن"
pub func Feed(d &: Decoder, data: void*, n: int):
if d.off > 0 and d.off == d.inb.len:
d.off = 0
d.inb.len = 0
else d.off > 32768:
BufConsume(d.inb, d.off)
d.off = 0
end
BufAppend(d.inb, data, n)
end
@en "TakeSalt"
@fa "گرفتن نمک"
pub func TakeSalt(d &: Decoder): bool:
if d.have_salt:
ret true
end
sl := d.method.salt_len
if d.inb.len - d.off < sl:
ret false
end
BufAppend(d.salt, _at(d.inb.p, d.off), sl)
d.off += sl
d.ctx = _open_ctx(d.method, d.master, d.salt.p)
d.have_salt = true
ret true
end
@en "TakeFrame"
@fa "گرفتن قاب"
pub func TakeFrame(d &: Decoder, n: int, out &: Buf): int:
if d.bad:
ret 0 - 1
end
if not TakeSalt(d):
ret 0
end
if d.inb.len - d.off < n + TAG_LEN:
ret 0
end
BufReserve(out, n + 1)
if out.bad:
ret 0 - 1
end
if not tls.AeadOpen(d.ctx, d.nonce, null, 0, _at(d.inb.p, d.off), n, _at(out.p, out.len)):
d.bad = true
ret 0 - 1
end
_nonce_inc(d.nonce)
d.off += n + TAG_LEN
out.len += n
ret 1
end
@en "NextChunk"
@fa "تکه بعدی"
pub func NextChunk(d &: Decoder, out &: Buf): int:
if d.need < 0:
d.tmp.len = 0
r := TakeFrame(d, 2, d.tmp)
if r <= 0:
ret r
end
ln := (_getb(d.tmp.p, 0) << 8) | _getb(d.tmp.p, 1)
if ln > d.max_chunk:
d.bad = true
ret 0 - 1
end
d.need = ln
end
r2 := TakeFrame(d, d.need, out)
if r2 == 1:
d.need = 0 - 1
end
ret r2
end
@en "DecodeAll"
@fa "رمزگشایی همه"
pub func DecodeAll(d &: Decoder, data: void*, n: int, out &: Buf): bool:
Feed(d, data, n)
until true:
r := NextChunk(d, out)
if r < 0:
ret false
end
if r == 0:
break
end
end
ret true
end
package shadowsocks
import mem
import str
import tls
@en "IDENTITY_CONTEXT"
@fa "زمینه هویت"
pub const IDENTITY_CONTEXT := "shadowsocks 2022 identity subkey"
@en "EIH_LEN"
@fa "طول سرآیند هویت"
pub const EIH_LEN := 16
@en "KeyChain"
@fa "زنجیره کلید"
pub struct KeyChain:
@en "keys"
@fa "کلیدها"
pub keys: Buf = Buf {}
@en "count"
@fa "تعداد"
pub count: int = 0
@en "key_len"
@fa "طول کلید"
pub key_len: int = 0
@en "ok"
@fa "معتبر"
pub ok: bool = false
end
@en "ChainOf"
@fa "زنجیره از"
pub func ChainOf(m: Method, password: str): KeyChain:
mut c := KeyChain { key_len = m.key_len }
if not m.v2022 or not m.ok:
ret c
end
parts := str.Split(password, ":")
n := parts.len()
if n < 1 or n > 8:
ret c
end
c.keys = NewBuf(n * m.key_len)
each part in parts:
mut k := _b64_key(part, m.key_len)
if k.bad:
BufWipe(k)
BufFree(k)
BufWipe(c.keys)
BufFree(c.keys)
ret KeyChain { key_len = m.key_len }
end
BufAppend(c.keys, k.p, m.key_len)
BufWipe(k)
BufFree(k)
end
c.count = n
c.ok = true
ret c
end
@en "ChainKey"
@fa "کلید زنجیره"
pub func ChainKey(c: KeyChain, i: int): void*:
ret _at(c.keys.p, i * c.key_len)
end
@en "ChainFree"
@fa "آزادسازی زنجیره"
pub func ChainFree(c &: KeyChain):
BufWipe(c.keys)
BufFree(c.keys)
c.count = 0
c.ok = false
end
@en "IdentityHash"
@fa "هش هویت"
pub func IdentityHash(psk: void*, klen: int, out16: void*):
Blake3Hash(psk, klen, out16, 16)
end
@en "IdentityKey"
@fa "کلید هویت"
pub func IdentityKey(ipsk: void*, klen: int, salt: void*, slen: int, out: void*):
mat := mem.AllocateZeroed((klen + slen) as u64)
mem.Copy(mat, ipsk, klen as u64)
mem.Copy(_at(mat, klen), salt, slen as u64)
Blake3DeriveKey(IDENTITY_CONTEXT, mat, klen + slen, out, klen)
_wipe(mat, klen + slen)
mem.Free(mat)
end
@en "EihSeal"
@fa "مهر سرآیند هویت"
pub func EihSeal(ipsk: void*, klen: int, salt: void*, slen: int, next_psk: void*, out16: void*): bool:
ik := mem.AllocateZeroed(32 as u64)
IdentityKey(ipsk, klen, salt, slen, ik)
h := mem.AllocateZeroed(16 as u64)
IdentityHash(next_psk, klen, h)
ok := tls.AesEcbBlock(ik, klen, h, out16, false)
_wipe(ik, 32)
mem.Free(ik)
mem.Free(h)
ret ok
end
@en "EihOpen"
@fa "گشودن سرآیند هویت"
pub func EihOpen(ipsk: void*, klen: int, salt: void*, slen: int, block16: void*, out_hash16: void*): bool:
ik := mem.AllocateZeroed(32 as u64)
IdentityKey(ipsk, klen, salt, slen, ik)
ok := tls.AesEcbBlock(ik, klen, block16, out_hash16, true)
_wipe(ik, 32)
mem.Free(ik)
ret ok
end
package shadowsocks
import mem
import encoding
import sync
@en "SaltFilter"
@fa "فیلتر نمک"
pub struct SaltFilter:
@en "cur"
@fa "نسل جاری"
pub cur: HashMap<str, bool> = HashMap {} as HashMap<str, bool>
@en "old"
@fa "نسل پیشین"
pub old: HashMap<str, bool> = HashMap {} as HashMap<str, bool>
@en "cap"
@fa "ظرفیت"
pub cap: int = 0
@en "lock"
@fa "قفل"
pub lock: sync.Mutex = sync.Mutex {}
end
func _b64_key(text: str, klen: int): Buf:
mut b := NewBuf(klen + 64)
b.len = 0
mut got := 0
try:
got = encoding.Base64DecodeBytes(text, b.p, b.cap)
catch:
got = 0 - 1
end
if got != klen:
b.bad = true
b.len = 0
ret b
end
b.len = got
ret b
end
@en "NewSaltFilter"
@fa "فیلتر نمک جدید"
pub func NewSaltFilter(cap: int): SaltFilter:
mut c := cap
if c < 16:
c = 16
end
ret SaltFilter { cap = c, lock = sync.NewMutex() }
end
@en "FilterSeen"
@fa "نمک دیده شده"
pub func FilterSeen(f &: SaltFilter, salt: void*, n: int): bool:
key := HexOf(salt, n)
sync.Lock(f.lock)
seen := f.cur.has(key) or f.old.has(key)
sync.Unlock(f.lock)
mem.Free(key as void*)
ret seen
end
@en "FilterCheck"
@fa "بررسی فیلتر"
pub func FilterCheck(f &: SaltFilter, salt: void*, n: int): bool:
key := HexOf(salt, n)
sync.Lock(f.lock)
if f.cur.has(key) or f.old.has(key):
sync.Unlock(f.lock)
mem.Free(key as void*)
ret false
end
if f.cur.size() >= f.cap:
each k, _ in f.old:
mem.Free(k as void*)
end
f.old.free()
f.old = f.cur
f.cur = HashMap {} as HashMap<str, bool>
end
f.cur.put(key, true)
sync.Unlock(f.lock)
ret true
end
@en "FilterFree"
@fa "آزادسازی فیلتر"
pub func FilterFree(f &: SaltFilter):
each k, _ in f.cur:
mem.Free(k as void*)
end
each k2, _ in f.old:
mem.Free(k2 as void*)
end
f.cur.free()
f.old.free()
sync.Destroy(f.lock)
end
@en "MakeKey"
@fa "ساخت کلید"
pub func MakeKey(m: Method, password: str): Buf:
if m.v2022:
ret _b64_key(password, m.key_len)
end
ret PasswordKey(m, password)
end
package shadowsocks
if SALAM_OS_WINDOWS:
extern:
func shutdown(s: usize, how: int): int
end
else:
extern:
func shutdown(s: int, how: int): int
end
end
const SHUT_WR := 1
func _shut_wr(fd: i64):
if fd < 0:
ret
end
if SALAM_OS_WINDOWS:
shutdown(fd as usize, SHUT_WR)
else:
shutdown(fd as int, SHUT_WR)
end
end
package shadowsocks
import mem
import crypto
import tls
@en "MAX_CHUNK"
@fa "بیشینه تکه"
pub const MAX_CHUNK := 0x3fff
@en "TAG_LEN"
@fa "طول برچسب"
pub const TAG_LEN := 16
@en "Method"
@fa "روش"
pub struct Method:
@en "name"
@fa "نام"
pub name: str = ""
@en "kind"
@fa "نوع"
pub kind: int = 0
@en "key_len"
@fa "طول کلید"
pub key_len: int = 0
@en "salt_len"
@fa "طول نمک"
pub salt_len: int = 0
@en "v2022"
@fa "نسخه۲۰۲۲"
pub v2022: bool = false
@en "ok"
@fa "معتبر"
pub ok: bool = false
end
@en "LookupMethod"
@fa "یافتن روش"
pub func LookupMethod(name: str): Method:
if name == "aes-128-gcm":
ret Method { name = name, kind = tls.AEAD_AES_128_GCM, key_len = 16, salt_len = 16, ok = true }
end
if name == "aes-256-gcm":
ret Method { name = name, kind = tls.AEAD_AES_256_GCM, key_len = 32, salt_len = 32, ok = true }
end
if name == "chacha20-ietf-poly1305" or name == "chacha20-poly1305":
ret Method { name = "chacha20-ietf-poly1305", kind = tls.AEAD_CHACHA20_POLY1305, key_len = 32, salt_len = 32, ok = true }
end
if name == "2022-blake3-aes-128-gcm":
ret Method { name = name, kind = tls.AEAD_AES_128_GCM, key_len = 16, salt_len = 16, v2022 = true, ok = true }
end
if name == "2022-blake3-aes-256-gcm":
ret Method { name = name, kind = tls.AEAD_AES_256_GCM, key_len = 32, salt_len = 32, v2022 = true, ok = true }
end
if name == "2022-blake3-chacha20-poly1305":
ret Method { name = name, kind = tls.AEAD_CHACHA20_POLY1305, key_len = 32, salt_len = 32, v2022 = true, ok = true }
end
ret Method {}
end
@en "BytesToKey"
@fa "بایت به کلید"
pub func BytesToKey(password: str, klen: int, out: void*):
plen := password.len()
msg := mem.Allocate((16 + plen + 1) as u64)
d := mem.AllocateZeroed(16 as u64)
mut have := 0
mut first := true
until have < klen:
mut mlen := plen
if first:
mem.Copy(msg, password as void*, plen as u64)
else:
mem.Copy(msg, d, 16 as u64)
mem.Copy(_at(msg, 16), password as void*, plen as u64)
mlen = 16 + plen
end
first = false
crypto.Md5Bytes(msg, mlen, d)
mut take := 16
if take > klen - have:
take = klen - have
end
mem.Copy(_at(out, have), d, take as u64)
have += take
end
_wipe(msg, 16 + plen)
mem.Free(msg)
mem.Free(d)
end
@en "HkdfSha1"
@fa "اچ کی دی اف شا۱"
pub func HkdfSha1(key: void*, klen: int, salt: void*, slen: int, info: str, out: void*, olen: int):
prk := mem.AllocateZeroed(20 as u64)
crypto.HmacSha1Raw(salt, slen, key, klen, prk)
ilen := info.len()
blk := mem.AllocateZeroed((20 + ilen + 1) as u64)
t := mem.AllocateZeroed(20 as u64)
mut have := 0
mut counter := 1
mut tlen := 0
until have < olen:
mem.Copy(blk, t, tlen as u64)
mem.Copy(_at(blk, tlen), info as void*, ilen as u64)
_setb(blk, tlen + ilen, counter)
crypto.HmacSha1Raw(prk, 20, blk, tlen + ilen + 1, t)
tlen = 20
mut take := 20
if take > olen - have:
take = olen - have
end
mem.Copy(_at(out, have), t, take as u64)
have += take
counter++
end
_wipe(prk, 20)
_wipe(t, 20)
mem.Free(prk)
mem.Free(blk)
mem.Free(t)
end
@en "SessionSubkey"
@fa "زیرکلید نشست"
pub func SessionSubkey(m: Method, master: void*, salt: void*, out: void*):
HkdfSha1(master, m.key_len, salt, m.salt_len, "ss-subkey", out, m.key_len)
end
@en "RandomSalt"
@fa "نمک تصادفی"
pub func RandomSalt(m: Method, out: void*):
crypto.RandomBytes(out, m.salt_len)
end
@en "PasswordKey"
@fa "کلید گذرواژه"
pub func PasswordKey(m: Method, password: str): Buf:
mut b := NewBuf(m.key_len)
BufReserve(b, m.key_len)
BytesToKey(password, m.key_len, b.p)
b.len = m.key_len
ret b
end
package shadowsocks
import mem
import str
import crypto
import encoding
@en "OBFS_NONE"
@fa "بدون پوشش"
pub const OBFS_NONE := 0
@en "OBFS_HTTP"
@fa "پوشش اچ تی تی پی"
pub const OBFS_HTTP := 1
@en "OBFS_TLS"
@fa "پوشش تی ال اس"
pub const OBFS_TLS := 2
const TLS_RECORD_MAX := 16384
@en "Obfs"
@fa "پوشش"
pub struct Obfs:
@en "mode"
@fa "حالت"
pub mode: int = 0
@en "server"
@fa "سمت سرور"
pub server: bool = false
@en "host"
@fa "میزبان"
pub host: str = ""
@en "sent_first"
@fa "ارسال نخست انجام شد"
pub sent_first: bool = false
@en "got_first"
@fa "دریافت نخست انجام شد"
pub got_first: bool = false
@en "seen_hello"
@fa "پیام آغاز دیده شد"
pub seen_hello: bool = false
@en "rx"
@fa "دریافتی"
pub rx: Buf = Buf {}
@en "frame_left"
@fa "باقیمانده قاب"
pub frame_left: int = 0
@en "ws_key"
@fa "کلید وب سوکت"
pub ws_key: str = ""
end
func _find(p: void*, n: int, pat: str): int:
pl := pat.len()
if pl == 0 or n < pl:
ret 0 - 1
end
mut i := 0
until i + pl <= n:
mut hit := true
mut j := 0
until j < pl and hit:
if _getb(p, i + j) != _getb(pat as void*, j):
hit = false
end
j++
end
if hit:
ret i
end
i++
end
ret 0 - 1
end
func _rand_b64(n: int): str:
r := mem.AllocateZeroed(n as u64)
crypto.RandomBytes(r, n)
out := encoding.Base64EncodeBytes(r, n)
mem.Free(r)
ret out
end
func _rand_int(max: int): int:
r := mem.AllocateZeroed(2 as u64)
crypto.RandomBytes(r, 2)
v := _getb(r, 0) * 256 + _getb(r, 1)
mem.Free(r)
ret v % max
end
func _put16(b &: Buf, v: int):
BufAppendByte(b, v >> 8)
BufAppendByte(b, v)
end
func _put_random(b &: Buf, n: int):
BufReserve(b, n)
crypto.RandomBytes(_at(b.p, b.len), n)
b.len += n
end
func _tls_ext_hello(host: str, data: void*, n: int, out &: Buf):
sni := host
mut ext := NewBuf(256 + n)
_put16(ext, 0x0023)
_put16(ext, n)
BufAppend(ext, data, n)
_put16(ext, 0x0000)
_put16(ext, sni.len() + 5)
_put16(ext, sni.len() + 3)
BufAppendByte(ext, 0)
_put16(ext, sni.len())
BufAppendStr(ext, sni)
_put16(ext, 0x000b)
_put16(ext, 4)
BufAppendByte(ext, 3)
BufAppendByte(ext, 1)
BufAppendByte(ext, 0)
BufAppendByte(ext, 2)
_put16(ext, 0x000a)
_put16(ext, 10)
_put16(ext, 8)
_put16(ext, 0x001d)
_put16(ext, 0x0017)
_put16(ext, 0x0019)
_put16(ext, 0x0018)
_put16(ext, 0x000d)
_put16(ext, 30)
_put16(ext, 28)
sigs := "\x06\x01\x06\x02\x06\x03\x05\x01\x05\x02\x05\x03\x04\x01\x04\x02\x04\x03\x03\x01\x03\x02\x03\x03\x02\x01\x02\x02\x02\x03"
BufAppend(ext, sigs as void*, 28)
_put16(ext, 0x0016)
_put16(ext, 0)
_put16(ext, 0x0017)
_put16(ext, 0)
suites := "\xc0\x2c\xc0\x30\x00\x9f\xcc\xa9\xcc\xa8\xcc\xaa\xc0\x2b\xc0\x2f\x00\x9e\xc0\x24\xc0\x28\x00\x6b\xc0\x23\xc0\x27\x00\x67\xc0\x0a\xc0\x14\x00\x39\xc0\x09\xc0\x13\x00\x33\x00\x9d\x00\x9c\x00\x3d\x00\x3c\x00\x35\x00\x2f\x00\xff"
mut body := NewBuf(512 + n)
_put16(body, 0x0303)
_put_random(body, 32)
BufAppendByte(body, 32)
_put_random(body, 32)
_put16(body, 56)
BufAppend(body, suites as void*, 56)
BufAppendByte(body, 1)
BufAppendByte(body, 0)
_put16(body, ext.len)
BufAppend(body, ext.p, ext.len)
BufAppendByte(out, 0x16)
_put16(out, 0x0301)
_put16(out, body.len + 4)
BufAppendByte(out, 1)
BufAppendByte(out, 0)
_put16(out, body.len)
BufAppend(out, body.p, body.len)
BufFree(ext)
BufFree(body)
end
func _tls_server_hello(out &: Buf):
BufAppendByte(out, 0x16)
_put16(out, 0x0303)
_put16(out, 91)
BufAppendByte(out, 2)
BufAppendByte(out, 0)
_put16(out, 87)
_put16(out, 0x0303)
_put_random(out, 32)
BufAppendByte(out, 32)
_put_random(out, 32)
_put16(out, 0xcca8)
BufAppendByte(out, 0)
_put16(out, 15)
_put16(out, 0x0017)
_put16(out, 0)
_put16(out, 0xff01)
_put16(out, 1)
BufAppendByte(out, 0)
_put16(out, 0x000b)
_put16(out, 2)
BufAppendByte(out, 1)
BufAppendByte(out, 0)
BufAppendByte(out, 0x14)
_put16(out, 0x0303)
_put16(out, 1)
BufAppendByte(out, 1)
end
func _tls_records(p: void*, n: int, out &: Buf):
mut off := 0
until off < n:
mut take := n - off
if take > TLS_RECORD_MAX:
take = TLS_RECORD_MAX
end
BufAppendByte(out, 0x17)
_put16(out, 0x0303)
_put16(out, take)
BufAppend(out, _at(p, off), take)
off += take
end
end
func _http_unwrap(o &: Obfs, out &: Buf): int:
if o.got_first:
BufAppend(out, o.rx.p, o.rx.len)
o.rx.len = 0
ret 1
end
e := _find(o.rx.p, o.rx.len, "\r\n\r\n")
if e < 0:
if o.rx.len > 8192:
ret 0 - 1
end
ret 1
end
if o.server:
k := _find(o.rx.p, e, "Sec-WebSocket-Key:")
if k >= 0:
mut j := k + 18
until j < e and _getb(o.rx.p, j) == 32:
j++
end
mut z := j
until z < e and _getb(o.rx.p, z) != 13:
z++
end
o.ws_key = _cstr(_at(o.rx.p, j), z - j)
end
end
o.got_first = true
BufConsume(o.rx, e + 4)
BufAppend(out, o.rx.p, o.rx.len)
o.rx.len = 0
ret 1
end
func _tls_find_ticket(p: void*, n: int, out &: Buf): int:
if n < 5:
ret 1
end
if _getb(p, 0) != 0x16:
ret 0 - 1
end
rl := _getb(p, 3) * 256 + _getb(p, 4)
if n < 5 + rl:
ret 1
end
mut o := 5 + 4 + 2 + 32
if o + 1 > 5 + rl:
ret 0 - 1
end
o += 1 + _getb(p, o)
if o + 2 > 5 + rl:
ret 0 - 1
end
o += 2 + _getb(p, o) * 256 + _getb(p, o + 1)
if o + 1 > 5 + rl:
ret 0 - 1
end
o += 1 + _getb(p, o)
if o + 2 > 5 + rl:
ret 0 - 1
end
elen := _getb(p, o) * 256 + _getb(p, o + 1)
o += 2
end0 := o + elen
if end0 > 5 + rl:
ret 0 - 1
end
until o + 4 <= end0:
et := _getb(p, o) * 256 + _getb(p, o + 1)
el := _getb(p, o + 2) * 256 + _getb(p, o + 3)
if o + 4 + el > end0:
ret 0 - 1
end
if et == 0x0023:
BufAppend(out, _at(p, o + 4), el)
end
o += 4 + el
end
ret 5 + rl
end
func _tls_step(o &: Obfs, out &: Buf): int:
if o.rx.len == 0:
ret 1
end
if o.frame_left > 0:
mut take := o.frame_left
if take > o.rx.len:
take = o.rx.len
end
BufAppend(out, o.rx.p, take)
BufConsume(o.rx, take)
o.frame_left -= take
ret 2
end
if not o.got_first:
if o.server:
c := _tls_find_ticket(o.rx.p, o.rx.len, out)
if c < 0:
ret 0 - 1
end
if c == 1:
ret 1
end
BufConsume(o.rx, c)
o.got_first = true
ret 2
end
if o.rx.len < 5:
ret 1
end
t := _getb(o.rx.p, 0)
rl := _getb(o.rx.p, 3) * 256 + _getb(o.rx.p, 4)
if t == 0x14 or (t == 0x16 and not o.seen_hello):
if o.rx.len < 5 + rl:
ret 1
end
if t == 0x16:
o.seen_hello = true
end
BufConsume(o.rx, 5 + rl)
ret 2
end
if (t == 0x17 or t == 0x16) and o.seen_hello:
o.got_first = true
ret 2
end
ret 0 - 1
end
if o.rx.len < 5:
ret 1
end
if _getb(o.rx.p, 0) != 0x17 and _getb(o.rx.p, 0) != 0x16:
ret 0 - 1
end
o.frame_left = _getb(o.rx.p, 3) * 256 + _getb(o.rx.p, 4)
BufConsume(o.rx, 5)
ret 2
end
func _tls_unwrap(o &: Obfs, out &: Buf): int:
mut r := 2
until r == 2:
r = _tls_step(o, out)
end
ret r
end
@en "ObfsWrap"
@fa "پوشاندن داده"
pub func ObfsWrap(o &: Obfs, p: void*, n: int, out &: Buf):
if o.mode == OBFS_NONE:
BufAppend(out, p, n)
ret
end
if o.mode == OBFS_HTTP:
if o.sent_first:
BufAppend(out, p, n)
ret
end
o.sent_first = true
if o.server:
accept := crypto.Sha1Base64(o.ws_key + "258EAFA5-E914-47DA-95CA-C5AB0DC85B11")
hdr := "HTTP/1.1 101 Switching Protocols\r\nServer: nginx/1." + str.FromInt((10 + _rand_int(10)) as i64) + "." + str.FromInt(_rand_int(10) as i64) + "\r\nDate: Mon, 09 Nov 2026 10:00:00 GMT\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: " + accept + "\r\n\r\n"
BufAppendStr(out, hdr)
else:
hdr := "GET / HTTP/1.1\r\nHost: " + o.host + "\r\nUser-Agent: curl/7." + str.FromInt((50 + _rand_int(30)) as i64) + "." + str.FromInt(_rand_int(10) as i64) + "\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: " + _rand_b64(16) + "\r\nContent-Length: " + str.FromInt(n as i64) + "\r\n\r\n"
BufAppendStr(out, hdr)
end
BufAppend(out, p, n)
ret
end
if not o.sent_first:
o.sent_first = true
if o.server:
_tls_server_hello(out)
mut first := n
if first > TLS_RECORD_MAX:
first = TLS_RECORD_MAX
end
BufAppendByte(out, 0x16)
_put16(out, 0x0303)
_put16(out, first)
BufAppend(out, p, first)
if n > first:
_tls_records(_at(p, first), n - first, out)
end
else:
if n > 8000:
_tls_ext_hello(o.host, p, 8000, out)
_tls_records(_at(p, 8000), n - 8000, out)
else:
_tls_ext_hello(o.host, p, n, out)
end
end
ret
end
_tls_records(p, n, out)
end
@en "ObfsUnwrap"
@fa "برداشتن پوشش"
pub func ObfsUnwrap(o &: Obfs, p: void*, n: int, out &: Buf): int:
if o.mode == OBFS_NONE:
BufAppend(out, p, n)
ret 1
end
BufAppend(o.rx, p, n)
if o.mode == OBFS_HTTP:
ret _http_unwrap(o, out)
end
ret _tls_unwrap(o, out)
end
@en "ObfsInit"
@fa "آماده سازی پوشش"
pub func ObfsInit(mode: int, server: bool, host: str): Obfs:
mut o := Obfs { mode = mode, server = server, host = host }
o.rx = NewBuf(1024)
ret o
end
@en "ObfsFree"
@fa "آزادسازی پوشش"
pub func ObfsFree(o &: Obfs):
BufFree(o.rx)
end
@en "ObfsMode"
@fa "حالت پوشش"
pub func ObfsMode(name: str): int:
if name == "http":
ret OBFS_HTTP
end
if name == "tls":
ret OBFS_TLS
end
ret OBFS_NONE
end
package shadowsocks
import mem
import net.tcp
import net.internal.rawsock
import pool
import chan
import net.tunnel
import tls
const RELAY_BUF := 16384
const RELAY_HALF_MS := 120000
const PROBE_MIN_MS := 1500
const PROBE_SPAN_MS := 3000
struct _PipeJob:
pub st: ConnState* = null
pub tgt: tcp.Conn = tcp.Conn {}
end
@en "ServerState"
@fa "وضعیت سرور"
pub struct ServerState:
@en "ls"
@fa "شنونده"
pub ls: tcp.Server = tcp.Server {}
@en "host"
@fa "میزبان شنود"
pub host: str = ""
@en "method"
@fa "روش"
pub method: Method = Method {}
@en "key"
@fa "کلید"
pub key: Buf = Buf {}
@en "filter"
@fa "فیلتر"
pub filter: SaltFilter = SaltFilter {}
@en "workers"
@fa "کارگرها"
pub workers: pool.Pool = pool.Pool {}
@en "stop"
@fa "توقف"
pub stop: i64* = null
@en "jobs"
@fa "صف اتصال ها"
pub jobs: chan.Chan<i64> = chan.Chan {} as chan.Chan<i64>
@en "obfs_mode"
@fa "حالت پوشش"
pub obfs_mode: str = ""
@en "users"
@fa "کاربران"
pub users: HashMap<str, Buf> = HashMap {} as HashMap<str, Buf>
@en "user_names"
@fa "نام کاربران"
pub user_names: HashMap<str, str> = HashMap {} as HashMap<str, str>
@en "user_n"
@fa "تعداد کاربران"
pub user_n: int = 0
end
@en "Server"
@fa "سرور"
pub struct Server:
@en "st"
@fa "وضعیت"
pub st: ServerState* = null
end
func _take_eih(ss: ServerState*, st: ConnState*): int:
if st.dec.inb.len - st.dec.off < 16:
ret 0
end
kl := st.method.key_len
h := mem.AllocateZeroed(16 as u64)
defer mem.Free(h)
if not EihOpen(ss.key.p, kl, st.dec.salt.p, st.method.salt_len, _at(st.dec.inb.p, st.dec.off), h):
ret 0 - 1
end
id := HexOf(h, 16)
if not ss.users.has(id):
ret 0 - 1
end
uk := ss.users.get(id)
st.user = ss.user_names.get(id)
st.dec.off += 16
tls.AeadFree(st.dec.ctx)
st.dec.ctx = _open_ctx(st.method, uk.p, st.dec.salt.p)
EncoderFree(st.enc)
st.enc = NewEncoderRandom(st.method, uk.p)
st.eih_done = true
ret 1
end
func _handshake(ss: ServerState*, st: ConnState*): bool:
mut checked := false
mut res := 2
until res == 2:
n := _rx(st, st.rd, RD_SIZE)
if n <= 0:
res = 0
else:
Feed(st.dec, st.rd, n)
if not checked and TakeSalt(st.dec):
checked = true
if FilterSeen(ss.filter, st.dec.salt.p, st.method.salt_len):
res = 0
end
end
mut ready := true
if res == 2 and ss.user_n > 0 and st.dec.have_salt and not st.eih_done:
er := _take_eih(ss, st)
if er < 0:
res = 0
else er == 0:
ready = false
end
end
if res == 2 and ready:
mut more := true
until more:
r := _next(st)
if r < 0:
res = 0
end
if r <= 0:
more = false
end
end
if res == 2 and st.v2022:
if st.target_ok:
res = 1
end
else res == 2:
pn := ParseTarget(st.plain.p, st.plain.len, st.target)
if pn > 0:
st.plain_pos = pn
res = 1
else pn < 0:
res = 0
end
end
end
end
end
if res == 1 and not FilterCheck(ss.filter, st.dec.salt.p, st.method.salt_len):
res = 0
end
ret res == 1
end
func _server_state(ss: ServerState*): ConnState*:
mut k := NewBuf(ss.key.len)
BufAppend(k, ss.key.p, ss.key.len)
st := _new_state(ss.method, k, ObfsMode(ss.obfs_mode), true, "")
st.dec = NewDecoder(ss.method, k.p)
st.enc = NewEncoderRandom(ss.method, k.p)
ret st
end
func _probe_drain(st: ConnState*):
tcp.SetReadDeadline(st.sock, PROBE_MIN_MS + _rand_int(PROBE_SPAN_MS))
limit := 4096 + _rand_int(60000)
mut total := 0
until total < limit:
n := tcp.ReadBytes(st.sock, st.rd, RD_SIZE)
if n <= 0:
break
end
total += n
end
end
func _server_conn(ss: ServerState*, raw: tcp.Conn, drain: bool): Conn:
st := _server_state(ss)
st.sock = raw
if not _handshake(ss, st):
if drain:
_probe_drain(st)
end
_raw_shutdown(st)
tcp.Close(raw)
_free_state(st)
ret Conn {}
end
ret Conn { st = st }
end
func _pipe_down(job: _PipeJob*):
st := job.st
buf := mem.Allocate(RELAY_BUF as u64)
cc := Conn { st = st }
mut go := true
until go:
n := tcp.ReadBytes(job.tgt, buf, RELAY_BUF)
if n <= 0:
go = false
else:
if Write(cc, buf, n) < 0:
go = false
end
end
end
mem.Free(buf)
if st.use_up:
_raw_shutdown(st)
else:
_shut_wr(st.sock.fd)
tcp.SetReadDeadline(st.sock, RELAY_HALF_MS)
end
end
func _serve_one(ss: ServerState*, raw: tcp.Conn, handler: func (Conn)):
c := _server_conn(ss, raw, true)
if c.st != null:
handler(c)
end
end
func _serve_next(ss: ServerState*, handler: func (Conn), jobs: chan.Chan<i64>):
mut ok := true
fd := jobs.recv(ok)
if ok:
_serve_one(ss, tcp.Conn { fd = fd }, handler)
end
end
func _listen(host: str, port: int, method: str, password: str, obfs: str): Server:
m := LookupMethod(method)
if not m.ok:
ret Server {}
end
key := MakeKey(m, password)
if key.bad:
ret Server {}
end
mut ls := tcp.Server {}
if host == "":
ls = tcp.Bind(port)
else:
ls = tcp.Server { fd = rawsock.ListenOn(host, port, rawsock.SOCK_STREAM).fd, port = port }
end
if not tcp.Ok(ls):
mut k := key
BufFree(k)
ret Server {}
end
ss := mem.AllocateZeroed(sizeof(ServerState) as u64) as ServerState*
ss.ls = ls
ss.host = host
ss.method = m
ss.key = key
ss.filter = NewSaltFilter(100000)
ss.workers = pool.NewElastic(2 as i64, 512 as i64, 64 as i64)
ss.jobs = chan.Chan {} as chan.Chan<i64>
ss.users = HashMap {} as HashMap<str, Buf>
ss.user_names = HashMap {} as HashMap<str, str>
ss.jobs.init(1024 as i64)
ss.stop = mem.AllocateZeroed(8 as u64) as i64*
ss.obfs_mode = obfs
ret Server { st = ss }
end
@en "Listen"
@fa "گوش دادن"
pub func Listen(port: int, method: str, password: str): Server:
ret ListenObfs(port, method, password, "")
end
@en "ListenOn"
@fa "گوش دادن روی نشانی"
pub func ListenOn(host: str, port: int, method: str, password: str, obfs: str): Server:
ret _listen(host, port, method, password, obfs)
end
@en "ListenObfs"
@fa "گوش دادن با پوشش"
pub func ListenObfs(port: int, method: str, password: str, obfs: str): Server:
ret _listen("", port, method, password, obfs)
end
@en "AddUser"
@fa "افزودن کاربر"
pub func AddUser(s: Server, name: str, password: str): bool:
ss := s.st
if ss == null or not ss.method.v2022 or ss.method.kind == tls.AEAD_CHACHA20_POLY1305:
ret false
end
k := MakeKey(ss.method, password)
if k.bad:
ret false
end
h := mem.AllocateZeroed(16 as u64)
IdentityHash(k.p, ss.method.key_len, h)
id := HexOf(h, 16)
mem.Free(h)
ss.users.put(id, k)
ss.user_names.put(id, name)
ss.user_n = ss.users.size()
ret true
end
@en "ServerOk"
@fa "سرور معتبر"
pub func ServerOk(s: Server): bool:
ret s.st != null
end
@en "ServerPort"
@fa "درگاه سرور"
pub func ServerPort(s: Server): int:
ret tcp.Port(s.st.ls)
end
@en "Accept"
@fa "پذیرش"
pub func Accept(s: Server): Conn:
ss := s.st
mut res := Conn {}
mut done := false
until not done:
raw := tcp.Accept(ss.ls)
if not tcp.ConnOk(raw):
done = true
else:
res = _server_conn(ss, raw, false)
if res.st != null:
done = true
end
end
end
ret res
end
@en "AcceptOver"
@fa "پذیرش روی جریان"
pub func AcceptOver(s: Server, io: dyn tunnel.Stream): Conn:
ss := s.st
st := _server_state(ss)
st.up = io
st.use_up = true
if not _handshake(ss, st):
_raw_shutdown(st)
_free_state(st)
ret Conn {}
end
ret Conn { st = st }
end
@en "Relay"
@fa "رله"
pub func Relay(c: Conn):
st := c.st
if st == null:
ret
end
tgt := tcp.Dial(st.target.host, st.target.port)
if not tcp.ConnOk(tgt):
Close(c)
ret
end
job := mem.AllocateZeroed(sizeof(_PipeJob) as u64) as _PipeJob*
job.st = st
job.tgt = tgt
th := spawn(_pipe_down, job)
buf := mem.Allocate(RELAY_BUF as u64)
mut go := true
mut hard := false
until go:
n := Read(c, buf, RELAY_BUF)
if n <= 0:
go = false
else:
w := tcp.WriteBytes(tgt, buf, n)
if w < n:
go = false
hard = true
end
end
end
mem.Free(buf)
if hard:
_raw_shutdown(st)
rawsock.Shutdown(rawsock.Socket { fd = tgt.fd })
else:
_shut_wr(tgt.fd)
tcp.SetReadDeadline(tgt, RELAY_HALF_MS)
end
join(th)
mem.Free(job as void*)
tcp.Close(tgt)
Close(c)
end
@en "Serve"
@fa "خدمت"
pub func Serve(s: Server, handler: func (Conn)):
ss := s.st
jobs := ss.jobs
task := (): _serve_next(ss, handler, jobs) end
until atomic_load(ss.stop) == 0 as i64:
raw := tcp.Accept(ss.ls)
if tcp.ConnOk(raw) and atomic_load(ss.stop) == 0 as i64:
jobs.send(raw.fd)
pool.Submit(ss.workers, task)
else tcp.ConnOk(raw):
tcp.Close(raw)
end
end
end
@en "ServeRelay"
@fa "خدمت رله"
pub func ServeRelay(s: Server):
Serve(s, (c: Conn): Relay(c) end)
end
@en "Stop"
@fa "توقف سرور"
pub func Stop(s: Server):
ss := s.st
if ss == null:
ret
end
atomic_store(ss.stop, 1 as i64)
rawsock.Shutdown(rawsock.Socket { fd = ss.ls.fd })
tcp.WakeServer(ss.host, tcp.Port(ss.ls))
end
@en "Destroy"
@fa "نابودی سرور"
pub func Destroy(s: Server):
ss := s.st
if ss == null:
ret
end
tcp.CloseServer(ss.ls)
pool.Stop(ss.workers)
ss.jobs.close()
ss.jobs.free()
FilterFree(ss.filter)
each uid, uk in ss.users:
mut kk := uk
BufWipe(kk)
BufFree(kk)
mem.Free(uid as void*)
end
ss.users.free()
ss.user_names.free()
BufWipe(ss.key)
BufFree(ss.key)
mem.Free(ss.stop as void*)
mem.Free(ss as void*)
end
@en "net/shadowsocks"
@fa "شدوساکس"
package shadowsocks
import mem
@en "Buf"
@fa "بافر"
pub struct Buf:
@en "p"
@fa "اشاره گر"
pub p: void* = null
@en "len"
@fa "طول"
pub len: int = 0
@en "cap"
@fa "ظرفیت"
pub cap: int = 0
@en "bad"
@fa "خراب"
pub bad: bool = false
end
inline func _at(p: void*, off: int): void*:
ret ((p as i64) + (off as i64)) as void*
end
inline func _getb(p: void*, i: int): int:
bp := p as u8*
ret bp[i] as int
end
inline func _setb(p: void*, i: int, v: int):
bp := p as u8*
bp[i] = (v & 0xFF) as u8
end
func _wipe(p: void*, n: int):
if p != null and n > 0:
mem.Set(p, 0, n as u64)
end
end
func _hexval(c: int): int:
if c >= 48 and c <= 57:
ret c - 48
end
if c >= 97 and c <= 102:
ret c - 87
end
if c >= 65 and c <= 70:
ret c - 55
end
ret 0 - 1
end
@en "BufAt"
@fa "بافر در"
pub func BufAt(b: Buf, off: int): void*:
ret _at(b.p, off)
end
@en "PtrAt"
@fa "اشاره گر در"
pub func PtrAt(p: void*, off: int): void*:
ret _at(p, off)
end
@en "NewBuf"
@fa "بافر جدید"
pub func NewBuf(cap0: int): Buf:
mut c := cap0
if c < 64:
c = 64
end
p := mem.Allocate(c as u64)
if p == null:
ret Buf { bad = true }
end
ret Buf { p = p, len = 0, cap = c, bad = false }
end
@en "BufFree"
@fa "آزادسازی بافر"
pub func BufFree(b &: Buf):
if b.p != null:
mem.Free(b.p)
end
b.p = null
b.len = 0
b.cap = 0
end
@en "BufWipe"
@fa "پاکسازی بافر"
pub func BufWipe(b &: Buf):
_wipe(b.p, b.cap)
b.len = 0
end
@en "BufReserve"
@fa "رزرو بافر"
pub func BufReserve(b &: Buf, extra: int):
if b.bad:
ret
end
if b.p == null:
nb := NewBuf(extra)
b.p = nb.p
b.cap = nb.cap
b.bad = nb.bad
b.len = 0
ret
end
need := b.len + extra
if need <= b.cap:
ret
end
mut nc := b.cap * 2
if nc < need:
nc = need
end
np := mem.Reallocate(b.p, nc as u64)
if np == null:
b.bad = true
ret
end
b.p = np
b.cap = nc
end
@en "BufAppend"
@fa "افزودن به بافر"
pub func BufAppend(b &: Buf, src: void*, n: int):
if n <= 0:
ret
end
BufReserve(b, n)
if b.bad:
ret
end
mem.Copy(_at(b.p, b.len), src, n as u64)
b.len += n
end
@en "BufAppendByte"
@fa "افزودن بایت به بافر"
pub func BufAppendByte(b &: Buf, v: int):
BufReserve(b, 1)
if b.bad:
ret
end
_setb(b.p, b.len, v)
b.len++
end
@en "BufAppendStr"
@fa "افزودن رشته به بافر"
pub func BufAppendStr(b &: Buf, s: str):
BufAppend(b, s as void*, s.len())
end
@en "BufConsume"
@fa "مصرف بافر"
pub func BufConsume(b &: Buf, n: int):
if n <= 0:
ret
end
if n >= b.len:
b.len = 0
ret
end
mem.MemMove(b.p, _at(b.p, n), (b.len - n) as u64)
b.len -= n
end
@en "BufToStr"
@fa "بافر به رشته"
pub func BufToStr(b: Buf): str:
if b.len <= 0:
ret ""
end
d := mem.Allocate((b.len + 1) as u64)
mem.Copy(d, b.p, b.len as u64)
_setb(d, b.len, 0)
ret d as str
end
@en "BufToHex"
@fa "بافر به هگز"
pub func BufToHex(b: Buf): str:
ret HexOf(b.p, b.len)
end
@en "HexOf"
@fa "هگز از"
pub func HexOf(p: void*, n: int): str:
digits := "0123456789abcdef"
d := mem.Allocate((n * 2 + 1) as u64)
repeat n in i:
v := _getb(p, i)
_setb(d, i * 2, _getb(digits as void*, (v >> 4) & 15))
_setb(d, i * 2 + 1, _getb(digits as void*, v & 15))
end
_setb(d, n * 2, 0)
ret d as str
end
@en "BufFromHex"
@fa "بافر از هگز"
pub func BufFromHex(hex: str): Buf:
n := hex.len()
mut b := NewBuf(n / 2 + 1)
if n % 2 != 0:
b.bad = true
ret b
end
mut i := 0
until i < n:
hi := _hexval(_getb(hex as void*, i))
lo := _hexval(_getb(hex as void*, i + 1))
if hi < 0 or lo < 0:
b.bad = true
ret b
end
BufAppendByte(b, hi * 16 + lo)
i += 2
end
ret b
end
package shadowsocks
import mem
import time
import net.tcp
import net.internal.rawsock
import sync
import pool
import net.tunnel
const RD_SIZE := 32768
const WR_SLICE := 65536
struct SsStream:
pub c: Conn = Conn {}
pub func Read(max: int): str:
ret _cread_str(this.c, max)
end
pub func ReadBytes(buf: void*, max: int): int:
ret _cread(this.c, buf, max)
end
pub func Write(data: str): int:
ret _cwrite_str(this.c, data)
end
pub func WriteBytes(ptr: void*, n: int): int:
ret _cwrite(this.c, ptr, n)
end
pub func SetDeadline(millis: int):
if this.c.st != null and not this.c.st.use_up:
tcp.SetDeadline(this.c.st.sock, millis)
end
end
pub func Shutdown():
_cshut(this.c)
end
pub func CloseWrite():
_cshut(this.c)
end
pub func Close():
_cclose(this.c)
end
pub func Ok(): bool:
ret this.c.st != null
end
end
@en "Config"
@fa "پیکربندی"
pub struct Config:
@en "host"
@fa "میزبان"
pub host: str = ""
@en "port"
@fa "درگاه"
pub port: int = 0
@en "method"
@fa "روش"
pub method: str = "aes-256-gcm"
@en "password"
@fa "گذرواژه"
pub password: str = ""
@en "obfs"
@fa "پوشش"
pub obfs: str = ""
@en "obfs_host"
@fa "میزبان پوشش"
pub obfs_host: str = "www.bing.com"
end
@en "ConnState"
@fa "وضعیت اتصال"
pub struct ConnState:
@en "sock"
@fa "سوکت"
pub sock: tcp.Conn = tcp.Conn {}
@en "method"
@fa "روش"
pub method: Method = Method {}
@en "key"
@fa "کلید"
pub key: Buf = Buf {}
@en "enc"
@fa "رمزگذار"
pub enc: Encoder = Encoder {}
@en "dec"
@fa "رمزگشا"
pub dec: Decoder = Decoder {}
@en "plain"
@fa "متن ساده"
pub plain: Buf = Buf {}
@en "plain_pos"
@fa "موقعیت متن ساده"
pub plain_pos: int = 0
@en "out"
@fa "خروجی"
pub out: Buf = Buf {}
@en "rd"
@fa "خواندن"
pub rd: void* = null
@en "pending"
@fa "سرآیند معلق"
pub pending: Buf = Buf {}
@en "target"
@fa "مقصد"
pub target: Target = Target {}
@en "obfs"
@fa "پوشش"
pub obfs: Obfs = Obfs {}
@en "up"
@fa "جریان زیرین"
pub up: dyn tunnel.Stream = tunnel.TcpStream {}
@en "use_up"
@fa "استفاده از جریان زیرین"
pub use_up: bool = false
@en "obuf"
@fa "خروجی پوشش"
pub obuf: Buf = Buf {}
@en "oin"
@fa "ورودی پوشش"
pub oin: Buf = Buf {}
@en "rd2"
@fa "خواندن خام"
pub rd2: void* = null
@en "v2022"
@fa "نسخه۲۰۲۲"
pub v2022: bool = false
@en "is_server"
@fa "سمت سرور"
pub is_server: bool = false
@en "wphase"
@fa "مرحله نوشتن"
pub wphase: int = 0
@en "rphase"
@fa "مرحله خواندن"
pub rphase: int = 0
@en "first_len"
@fa "طول نخستین"
pub first_len: int = 0
@en "target_ok"
@fa "مقصد دریافت شد"
pub target_ok: bool = false
@en "vtmp"
@fa "موقت متغیر"
pub vtmp: Buf = Buf {}
@en "live"
@fa "زنده"
pub live: bool = false
@en "eih"
@fa "سرآیند هویت"
pub eih: Buf = Buf {}
@en "eih_n"
@fa "تعداد سرآیند هویت"
pub eih_n: int = 0
@en "eih_done"
@fa "سرآیند هویت خوانده شد"
pub eih_done: bool = false
@en "user"
@fa "کاربر"
pub user: str = ""
end
@en "Conn"
@fa "اتصال"
pub struct Conn:
@en "st"
@fa "وضعیت"
pub st: ConnState* = null
end
func _cread(c: Conn, buf: void*, max: int): int:
ret Read(c, buf, max)
end
func _cread_str(c: Conn, max: int): str:
ret ReadStr(c, max)
end
func _cwrite(c: Conn, p: void*, n: int): int:
ret Write(c, p, n)
end
func _cwrite_str(c: Conn, d: str): int:
ret WriteStr(c, d)
end
func _cshut(c: Conn):
Shutdown(c)
end
func _cclose(c: Conn):
Close(c)
end
func _rawtx(st: ConnState*, p: void*, n: int): bool:
mut off := 0
until off < n:
mut w := 0
if st.use_up:
w = st.up.WriteBytes(_at(p, off), n - off)
else:
w = tcp.WriteBytes(st.sock, _at(p, off), n - off)
end
if w <= 0:
ret false
end
off += w
end
ret true
end
func _rawrx(st: ConnState*, buf: void*, max: int): int:
if st.use_up:
ret st.up.ReadBytes(buf, max)
end
ret tcp.ReadBytes(st.sock, buf, max)
end
func _tx(st: ConnState*, p: void*, n: int): bool:
if st.obfs.mode == OBFS_NONE:
ret _rawtx(st, p, n)
end
st.obuf.len = 0
ObfsWrap(st.obfs, p, n, st.obuf)
ret _rawtx(st, st.obuf.p, st.obuf.len)
end
func _rx(st: ConnState*, buf: void*, max: int): int:
if st.obfs.mode == OBFS_NONE:
ret _rawrx(st, buf, max)
end
until st.oin.len == 0:
n := _rawrx(st, st.rd2, RD_SIZE)
if n <= 0:
ret n
end
if ObfsUnwrap(st.obfs, st.rd2, n, st.oin) < 0:
ret 0 - 1
end
end
mut take := st.oin.len
if take > max:
take = max
end
mem.Copy(buf, st.oin.p, take as u64)
BufConsume(st.oin, take)
ret take
end
func _raw_shutdown(st: ConnState*):
if st.use_up:
st.up.Shutdown()
else:
rawsock.Shutdown(rawsock.Socket { fd = st.sock.fd })
end
end
func _new_state(m: Method, key: Buf, obfs_mode: int, server: bool, host: str): ConnState*:
st := mem.AllocateZeroed(sizeof(ConnState) as u64) as ConnState*
st.method = m
st.key = key
st.plain = NewBuf(RD_SIZE)
st.out = NewBuf(4096)
st.pending = NewBuf(300)
st.rd = mem.Allocate(RD_SIZE as u64)
st.obfs = ObfsInit(obfs_mode, server, host)
st.v2022 = m.v2022
st.is_server = server
st.vtmp = NewBuf(1024)
if obfs_mode != OBFS_NONE:
st.obuf = NewBuf(4096)
st.oin = NewBuf(4096)
st.rd2 = mem.Allocate(RD_SIZE as u64)
end
st.live = true
ret st
end
func _free_state(st: ConnState*):
if st == null:
ret
end
EncoderFree(st.enc)
DecoderFree(st.dec)
if st.is_server and (st.target.host as void*) != null:
mem.Free(st.target.host as void*)
end
BufWipe(st.key)
BufFree(st.key)
BufWipe(st.eih)
BufFree(st.eih)
BufFree(st.plain)
BufFree(st.out)
BufFree(st.pending)
BufFree(st.vtmp)
ObfsFree(st.obfs)
BufFree(st.obuf)
BufFree(st.oin)
if st.rd2 != null:
mem.Free(st.rd2)
end
if st.rd != null:
mem.Free(st.rd)
end
mem.Free(st as void*)
end
func _put64be(b &: Buf, v: i64):
repeat 8 in i:
BufAppendByte(b, ((v >> (((7 - i) * 8) as i64)) & (255 as i64)) as int)
end
end
func _get64be(p: void*): i64:
mut v := 0 as i64
repeat 8 in i:
v = (v << (8 as i64)) | (_getb(p, i) as i64)
end
ret v
end
func _first_write_2022(st: ConnState*, data: void*, n: int): bool:
mut fixed := NewBuf(64)
now := time.Now()
if st.is_server:
mut take := n
if take > 0xffff:
take = 0xffff
end
EmitSalt(st.enc, st.out)
BufAppendByte(fixed, 1)
_put64be(fixed, now)
BufAppend(fixed, st.dec.salt.p, st.dec.salt.len)
BufAppendByte(fixed, take >> 8)
BufAppendByte(fixed, take)
SealFrame(st.enc, fixed.p, fixed.len, st.out)
SealFrame(st.enc, data, take, st.out)
st.wphase = 1
BufWipe(fixed)
BufFree(fixed)
if n > take:
EncodeStream(st.enc, _at(data, take), n - take, st.out)
end
ret true
end
mut padlen := 0
if n == 0:
padlen = 1 + _rand_int(900)
end
mut take := n
room := 0xffff - st.pending.len - 2 - padlen
if take > room:
take = room
end
mut v := NewBuf(st.pending.len + 2 + padlen + take + 16)
BufAppend(v, st.pending.p, st.pending.len)
BufAppendByte(v, padlen >> 8)
BufAppendByte(v, padlen)
_put_random(v, padlen)
BufAppend(v, data, take)
BufAppendByte(fixed, 0)
_put64be(fixed, now)
BufAppendByte(fixed, v.len >> 8)
BufAppendByte(fixed, v.len)
EmitSalt(st.enc, st.out)
repeat st.eih_n in i:
mut nxt := st.key.p
if i + 1 < st.eih_n:
nxt = _at(st.eih.p, (i + 1) * st.method.key_len)
end
blk := mem.AllocateZeroed(16 as u64)
EihSeal(_at(st.eih.p, i * st.method.key_len), st.method.key_len, st.enc.salt.p, st.method.salt_len, nxt, blk)
BufAppend(st.out, blk, 16)
mem.Free(blk)
end
SealFrame(st.enc, fixed.p, fixed.len, st.out)
SealFrame(st.enc, v.p, v.len, st.out)
BufFree(v)
BufFree(fixed)
st.pending.len = 0
st.wphase = 1
if n > take:
EncodeStream(st.enc, _at(data, take), n - take, st.out)
end
ret true
end
func _send_plain(st: ConnState*, data: void*, n: int): bool:
st.out.len = 0
if st.v2022 and st.wphase == 0:
if st.is_server and n <= 0:
ret true
end
_first_write_2022(st, data, n)
else:
if st.pending.len > 0:
mut pt := NewBuf(st.pending.len + n)
BufAppend(pt, st.pending.p, st.pending.len)
BufAppend(pt, data, n)
EncodeStream(st.enc, pt.p, pt.len, st.out)
BufFree(pt)
st.pending.len = 0
else:
if n <= 0:
ret true
end
EncodeStream(st.enc, data, n, st.out)
end
end
if st.out.bad:
ret false
end
ret _tx(st, st.out.p, st.out.len)
end
func _hdr_fixed_ok(st: ConnState*): bool:
v := st.vtmp.p
t := _getb(v, 0)
mut want := 1
if st.is_server:
want = 0
end
if t != want:
ret false
end
skew := time.Now() - _get64be(_at(v, 1))
if skew > (30 as i64) or skew < (0 - 30) as i64:
ret false
end
mut off := 9
if not st.is_server:
sl := st.method.salt_len
mut i := 0
mut same := true
until i < sl:
if _getb(_at(v, 9), i) != _getb(st.enc.salt.p, i):
same = false
end
i++
end
if not same:
ret false
end
off += sl
end
st.first_len = _getb(v, off) * 256 + _getb(v, off + 1)
ret true
end
func _server_var(st: ConnState*): bool:
v := st.vtmp.p
n := st.vtmp.len
pn := ParseTarget(v, n, st.target)
if pn <= 0 or pn + 2 > n:
ret false
end
off := pn + 2 + _getb(v, pn) * 256 + _getb(v, pn + 1)
if off > n:
ret false
end
BufAppend(st.plain, _at(v, off), n - off)
ret true
end
func _next(st: ConnState*): int:
if not st.v2022 or st.rphase == 2:
ret NextChunk(st.dec, st.plain)
end
st.vtmp.len = 0
if st.rphase == 0:
mut flen := 11
if not st.is_server:
flen += st.method.salt_len
end
r := TakeFrame(st.dec, flen, st.vtmp)
if r <= 0:
ret r
end
if not _hdr_fixed_ok(st):
ret 0 - 1
end
st.rphase = 1
ret 1
end
if not st.is_server:
r2 := TakeFrame(st.dec, st.first_len, st.plain)
if r2 == 1:
st.rphase = 2
end
ret r2
end
r3 := TakeFrame(st.dec, st.first_len, st.vtmp)
if r3 <= 0:
ret r3
end
if not _server_var(st):
ret 0 - 1
end
st.target_ok = true
st.rphase = 2
ret 1
end
func _fill(st: ConnState*): int:
mut res := 2
until res == 2:
if st.plain_pos < st.plain.len:
res = 1
else:
st.plain.len = 0
st.plain_pos = 0
r := _next(st)
if r < 0:
res = 0 - 1
else r == 0:
n := _rx(st, st.rd, RD_SIZE)
if n == 0:
res = 0
else n < 0:
res = 0 - 1
else:
Feed(st.dec, st.rd, n)
end
end
end
end
ret res
end
func _client_state(cfg: Config, target_host: str, target_port: int): ConnState*:
m := LookupMethod(cfg.method)
if not m.ok:
ret null
end
mut chain := ChainOf(m, cfg.password)
mut key := MakeKey(m, cfg.password)
if m.v2022:
if not chain.ok:
ret null
end
key = NewBuf(m.key_len)
BufAppend(key, ChainKey(chain, chain.count - 1), m.key_len)
else key.bad:
ret null
end
st := _new_state(m, key, ObfsMode(cfg.obfs), false, cfg.obfs_host)
if m.v2022 and chain.count > 1:
st.eih = NewBuf(chain.count * m.key_len)
BufAppend(st.eih, chain.keys.p, (chain.count - 1) * m.key_len)
st.eih_n = chain.count - 1
end
if m.v2022:
ChainFree(chain)
end
mut hdr := NewBuf(300)
if not EncodeTarget(target_host, target_port, hdr):
BufFree(hdr)
_free_state(st)
ret null
end
BufAppend(st.pending, hdr.p, hdr.len)
BufFree(hdr)
st.enc = NewEncoderRandom(m, key.p)
st.dec = NewDecoder(m, key.p)
ret st
end
@en "Ok"
@fa "معتبر"
pub func Ok(c: Conn): bool:
ret c.st != null
end
@en "TargetOf"
@fa "مقصد اتصال"
pub func TargetOf(c: Conn): Target:
if c.st == null:
ret Target {}
end
if (c.st.target.host as void*) == null:
ret Target {}
end
ret c.st.target
end
@en "Write"
@fa "نوشتن"
pub func Write(c: Conn, data: void*, n: int): int:
st := c.st
if st == null:
ret 0 - 1
end
mut off := 0
mut first := true
until first or off < n:
first = false
mut take := n - off
if take > WR_SLICE:
take = WR_SLICE
end
if not _send_plain(st, _at(data, off), take):
ret 0 - 1
end
off += take
end
ret n
end
@en "WriteStr"
@fa "نوشتن رشته"
pub func WriteStr(c: Conn, s: str): int:
ret Write(c, s as void*, s.len())
end
@en "Read"
@fa "خواندن"
pub func Read(c: Conn, buf: void*, max: int): int:
st := c.st
if st == null:
ret 0 - 1
end
if st.pending.len > 0:
if not _send_plain(st, null, 0):
ret 0 - 1
end
end
r := _fill(st)
if r <= 0:
ret r
end
mut take := st.plain.len - st.plain_pos
if take > max:
take = max
end
mem.Copy(buf, _at(st.plain.p, st.plain_pos), take as u64)
st.plain_pos += take
ret take
end
@en "ReadStr"
@fa "خواندن رشته"
pub func ReadStr(c: Conn, max: int): str:
b := mem.Allocate((max + 1) as u64)
n := Read(c, b, max)
if n <= 0:
mem.Free(b)
ret ""
end
_setb(b, n, 0)
ret b as str
end
@en "Close"
@fa "بستن"
pub func Close(c: Conn):
st := c.st
if st == null:
ret
end
_raw_shutdown(st)
if st.use_up:
st.up.Close()
else:
tcp.Close(st.sock)
end
_free_state(st)
end
@en "Shutdown"
@fa "قطع"
pub func Shutdown(c: Conn):
if c.st == null:
ret
end
_raw_shutdown(c.st)
end
@en "Dial"
@fa "برقراری اتصال"
pub func Dial(cfg: Config, target_host: str, target_port: int): Conn:
st := _client_state(cfg, target_host, target_port)
if st == null:
ret Conn {}
end
sock := tcp.Dial(cfg.host, cfg.port)
if not tcp.ConnOk(sock):
_free_state(st)
ret Conn {}
end
st.sock = sock
ret Conn { st = st }
end
@en "DialOver"
@fa "اتصال روی جریان"
pub func DialOver(s: dyn tunnel.Stream, cfg: Config, target_host: str, target_port: int): Conn:
st := _client_state(cfg, target_host, target_port)
if st == null:
ret Conn {}
end
st.up = s
st.use_up = true
ret Conn { st = st }
end
@en "AsStream"
@fa "به عنوان جریان"
pub func AsStream(c: Conn): dyn tunnel.Stream:
ret SsStream { c = c }
end
package shadowsocks
import mem
import time
import str
import net.udp
import tls
const UDP_MAX := 65536
const UDP_IDLE_MS := 60000
@en "UdpClient"
@fa "کلاینت یو دی پی"
pub struct UdpClient:
@en "sock"
@fa "سوکت"
pub sock: udp.Socket = udp.Socket {}
@en "host"
@fa "میزبان"
pub host: str = ""
@en "port"
@fa "درگاه"
pub port: int = 0
@en "method"
@fa "روش"
pub method: Method = Method {}
@en "key"
@fa "کلید"
pub key: Buf = Buf {}
@en "rbuf"
@fa "بافر دریافت"
pub rbuf: void* = null
@en "ok"
@fa "معتبر"
pub ok: bool = false
@en "sess"
@fa "نشست"
pub sess: UdpSession* = null
@en "eih"
@fa "سرآیند هویت"
pub eih: Buf = Buf {}
@en "eih_n"
@fa "تعداد سرآیند هویت"
pub eih_n: int = 0
end
@en "UdpServer"
@fa "سرور یو دی پی"
pub struct UdpServer:
@en "sock"
@fa "سوکت"
pub sock: udp.Socket = udp.Socket {}
@en "method"
@fa "روش"
pub method: Method = Method {}
@en "key"
@fa "کلید"
pub key: Buf = Buf {}
@en "rbuf"
@fa "بافر دریافت"
pub rbuf: void* = null
@en "assoc"
@fa "ارتباط ها"
pub assoc: HashMap<str, udp.Socket> = HashMap {} as HashMap<str, udp.Socket>
@en "seen"
@fa "آخرین فعالیت"
pub seen: HashMap<str, i64> = HashMap {} as HashMap<str, i64>
@en "clients"
@fa "کلاینت ها"
pub clients: HashMap<str, Target> = HashMap {} as HashMap<str, Target>
@en "stopc"
@fa "پرچم توقف"
pub stopc: i64* = null
@en "ok"
@fa "معتبر"
pub ok: bool = false
@en "sess"
@fa "نشست ها"
pub sess: HashMap<str, UdpSession> = HashMap {} as HashMap<str, UdpSession>
@en "skeys"
@fa "کلید نشست ها"
pub skeys: HashMap<str, Buf> = HashMap {} as HashMap<str, Buf>
@en "users"
@fa "کاربران"
pub users: HashMap<str, Buf> = HashMap {} as HashMap<str, Buf>
@en "user_n"
@fa "تعداد کاربران"
pub user_n: int = 0
@en "filter"
@fa "فیلتر"
pub filter: SaltFilter = SaltFilter {}
end
func _udp_ctx(m: Method, key: void*, salt: void*): void*:
sub := mem.AllocateZeroed(32 as u64)
SessionSubkey(m, key, salt, sub)
c := tls.AeadNew(m.kind, sub)
_wipe(sub, 32)
mem.Free(sub)
ret c
end
func _u22_resolve(s &: UdpServer, n: int, ukey &: void*, skip &: int): bool:
ukey = s.key.p
skip = 0
if s.method.kind == tls.AEAD_CHACHA20_POLY1305 or s.user_n == 0:
ret true
end
if n < 32:
ret false
end
id16 := mem.AllocateZeroed(16 as u64)
mut ok := Udp2022Identity(s.method, s.key.p, s.rbuf, n, id16)
if ok:
id := HexOf(id16, 16)
if s.users.has(id):
uk := s.users.get(id)
ukey = uk.p
skip = 16
else:
ok = false
end
end
mem.Free(id16)
ret ok
end
func _udp_forward(s &: UdpServer, ck0: str, from_host: str, from_port: int, n: int):
mut ck := ck0
mut t := Target {}
mut pl := NewBuf(n)
if s.method.v2022:
mut ukey := s.key.p
mut skip := 0
if not _u22_resolve(s, n, ukey, skip):
BufFree(pl)
ret
end
mut probe := UdpSession {}
if not UnpackUdp2022(s.method, ukey, s.key.p, skip, false, s.rbuf, n, probe, t, pl):
BufFree(pl)
ret
end
ck = "u" + str.FromInt(probe.peer)
mut sess := UdpSession {}
if s.sess.has(ck):
sess = s.sess.get(ck)
else:
sess = NewUdpSession()
sess.peer = probe.peer
mut kc := NewBuf(s.method.key_len)
BufAppend(kc, ukey, s.method.key_len)
s.skeys.put(ck, kc)
end
if not SessionAccept(sess, probe.last):
BufFree(pl)
ret
end
s.sess.put(ck, sess)
else:
if FilterSeen(s.filter, s.rbuf, s.method.salt_len):
BufFree(pl)
ret
end
if not UnpackUdp(s.method, s.key.p, s.rbuf, n, t, pl):
BufFree(pl)
ret
end
if not FilterCheck(s.filter, s.rbuf, s.method.salt_len):
BufFree(pl)
ret
end
end
mut out := udp.Socket {}
if s.assoc.has(ck):
out = s.assoc.get(ck)
else:
out = udp.OpenAny()
udp.SetTimeout(out, 1)
s.assoc.put(ck, out)
end
s.clients.put(ck, Target { host = from_host, port = from_port })
s.seen.put(ck, time.NowMillis())
udp.SendBytes(out, t.host, t.port, pl.p, pl.len)
BufFree(pl)
end
func _udp_drain(s &: UdpServer, ck: str, out: udp.Socket, cli: Target):
mut fh := ""
mut fp := 0
buf := mem.Allocate(UDP_MAX as u64)
n := udp.ReceiveBytes(out, buf, UDP_MAX, fh, fp)
if n > 0:
mut pkt := NewBuf(n + 1400)
mut packed := false
if s.method.v2022:
mut sess := s.sess.get(ck)
uk := s.skeys.get(ck)
packed = PackUdp2022(s.method, uk.p, uk.p, Buf {}, 0, sess, false, fh, fp, buf, n, pkt)
s.sess.put(ck, sess)
else:
packed = PackUdp(s.method, s.key.p, fh, fp, buf, n, pkt)
end
if packed:
udp.SendBytes(s.sock, cli.host, cli.port, pkt.p, pkt.len)
end
BufFree(pkt)
end
mem.Free(buf)
end
func _udp_sweep(s &: UdpServer):
now := time.NowMillis()
mut dead := Vector {} as Vector<str>
defer dead.free()
each ck, out in s.assoc:
_udp_drain(s, ck, out, s.clients.get(ck))
if now - s.seen.get(ck) > (UDP_IDLE_MS as i64):
dead.push(ck)
end
end
each ck in dead:
udp.Close(s.assoc.get(ck))
s.assoc.remove(ck)
s.clients.remove(ck)
s.seen.remove(ck)
if s.sess.has(ck):
s.sess.remove(ck)
mut kb := s.skeys.get(ck)
BufWipe(kb)
BufFree(kb)
s.skeys.remove(ck)
end
end
end
func _udp_listen(host: str, port: int, method: str, password: str): UdpServer:
m := LookupMethod(method)
mut s := UdpServer { method = m }
if not m.ok:
ret s
end
s.key = MakeKey(m, password)
if s.key.bad:
ret s
end
s.sock = udp.BindOn(host, port)
if not udp.Ok(s.sock):
ret s
end
udp.SetTimeout(s.sock, 20)
s.rbuf = mem.Allocate(UDP_MAX as u64)
s.filter = NewSaltFilter(100000)
s.sess = HashMap {} as HashMap<str, UdpSession>
s.skeys = HashMap {} as HashMap<str, Buf>
s.users = HashMap {} as HashMap<str, Buf>
s.stopc = mem.AllocateZeroed(8 as u64) as i64*
s.ok = true
ret s
end
@en "PackUdp"
@fa "بسته بندی یو دی پی"
pub func PackUdp(m: Method, key: void*, host: str, port: int, data: void*, n: int, out &: Buf): bool:
if m.v2022:
ret false
end
mut pt := NewBuf(n + 300)
if not EncodeTarget(host, port, pt):
BufFree(pt)
ret false
end
BufAppend(pt, data, n)
salt := mem.AllocateZeroed(m.salt_len as u64)
RandomSalt(m, salt)
BufAppend(out, salt, m.salt_len)
ctx := _udp_ctx(m, key, salt)
nonce := mem.AllocateZeroed(12 as u64)
BufReserve(out, pt.len + TAG_LEN)
tls.AeadSeal(ctx, nonce, null, 0, pt.p, pt.len, _at(out.p, out.len))
out.len += pt.len + TAG_LEN
tls.AeadFree(ctx)
mem.Free(nonce)
mem.Free(salt)
BufWipe(pt)
BufFree(pt)
ret not out.bad
end
@en "UnpackUdp"
@fa "بازکردن یو دی پی"
pub func UnpackUdp(m: Method, key: void*, p: void*, n: int, t &: Target, out &: Buf): bool:
if m.v2022 or n < m.salt_len + TAG_LEN + 7:
ret false
end
ctx := _udp_ctx(m, key, p)
nonce := mem.AllocateZeroed(12 as u64)
cl := n - m.salt_len - TAG_LEN
pt := mem.Allocate((cl + 1) as u64)
ok := tls.AeadOpen(ctx, nonce, null, 0, _at(p, m.salt_len), cl, pt)
tls.AeadFree(ctx)
mem.Free(nonce)
mut good := false
if ok:
hl := ParseTarget(pt, cl, t)
if hl > 0:
BufAppend(out, _at(pt, hl), cl - hl)
good = true
end
end
_wipe(pt, cl)
mem.Free(pt)
ret good
end
@en "UdpDial"
@fa "اتصال یو دی پی"
pub func UdpDial(cfg: Config): UdpClient:
m := LookupMethod(cfg.method)
mut c := UdpClient { host = cfg.host, port = cfg.port, method = m }
if not m.ok:
ret c
end
if m.v2022:
mut chain := ChainOf(m, cfg.password)
if not chain.ok:
ret c
end
c.key = NewBuf(m.key_len)
BufAppend(c.key, ChainKey(chain, chain.count - 1), m.key_len)
if chain.count > 1:
c.eih = NewBuf(chain.count * m.key_len)
BufAppend(c.eih, chain.keys.p, (chain.count - 1) * m.key_len)
c.eih_n = chain.count - 1
end
ChainFree(chain)
c.sess = mem.AllocateZeroed(sizeof(UdpSession) as u64) as UdpSession*
c.sess.sid = NewUdpSession().sid
else:
c.key = MakeKey(m, cfg.password)
if c.key.bad:
ret c
end
end
c.sock = udp.OpenAny()
c.rbuf = mem.Allocate(UDP_MAX as u64)
c.ok = udp.Ok(c.sock)
ret c
end
@en "UdpSend"
@fa "ارسال یو دی پی"
pub func UdpSend(c: UdpClient, host: str, port: int, data: void*, n: int): bool:
mut out := NewBuf(n + 1400)
if c.method.v2022:
mut hk := c.key.p
if c.eih_n > 0:
hk = c.eih.p
end
if not PackUdp2022(c.method, c.key.p, hk, c.eih, c.eih_n, c.sess, true, host, port, data, n, out):
BufFree(out)
ret false
end
else:
if not PackUdp(c.method, c.key.p, host, port, data, n, out):
BufFree(out)
ret false
end
end
w := udp.SendBytes(c.sock, c.host, c.port, out.p, out.len)
BufFree(out)
ret w > 0
end
@en "UdpRecv"
@fa "دریافت یو دی پی"
pub func UdpRecv(c: UdpClient, buf: void*, max: int, from &: Target): int:
mut fh := ""
mut fp := 0
n := udp.ReceiveBytes(c.sock, c.rbuf, UDP_MAX, fh, fp)
if n <= 0:
ret 0 - 1
end
mut out := NewBuf(n)
if c.method.v2022:
if not UnpackUdp2022(c.method, c.key.p, c.key.p, 0, true, c.rbuf, n, c.sess, from, out):
BufFree(out)
ret 0 - 1
end
else:
if not UnpackUdp(c.method, c.key.p, c.rbuf, n, from, out):
BufFree(out)
ret 0 - 1
end
end
mut take := out.len
if take > max:
take = max
end
mem.Copy(buf, out.p, take as u64)
BufFree(out)
ret take
end
@en "UdpSetTimeout"
@fa "مهلت یو دی پی"
pub func UdpSetTimeout(c: UdpClient, millis: int):
udp.SetTimeout(c.sock, millis)
end
@en "UdpClose"
@fa "بستن یو دی پی"
pub func UdpClose(c: UdpClient):
udp.Close(c.sock)
if c.rbuf != null:
mem.Free(c.rbuf)
end
mut k := c.key
BufWipe(k)
BufFree(k)
mut e := c.eih
BufWipe(e)
BufFree(e)
if c.sess != null:
mem.Free(c.sess as void*)
end
end
@en "UdpListen"
@fa "گوش دادن یو دی پی"
pub func UdpListen(port: int, method: str, password: str): UdpServer:
ret _udp_listen("", port, method, password)
end
@en "UdpListenOn"
@fa "گوش دادن یو دی پی روی نشانی"
pub func UdpListenOn(host: str, port: int, method: str, password: str): UdpServer:
ret _udp_listen(host, port, method, password)
end
@en "UdpAddUser"
@fa "افزودن کاربر یو دی پی"
pub func UdpAddUser(s &: UdpServer, password: str): bool:
if not s.method.v2022 or s.method.kind == tls.AEAD_CHACHA20_POLY1305:
ret false
end
k := MakeKey(s.method, password)
if k.bad:
ret false
end
h := mem.AllocateZeroed(16 as u64)
IdentityHash(k.p, s.method.key_len, h)
s.users.put(HexOf(h, 16), k)
s.user_n = s.users.size()
mem.Free(h)
ret true
end
@en "UdpServerPort"
@fa "درگاه سرور یو دی پی"
pub func UdpServerPort(s: UdpServer): int:
ret udp.Port(s.sock)
end
@en "UdpStep"
@fa "گام یو دی پی"
pub func UdpStep(s &: UdpServer): int:
mut fh := ""
mut fp := 0
mut worked := 0
n := udp.ReceiveBytes(s.sock, s.rbuf, UDP_MAX, fh, fp)
if n > 0:
_udp_forward(s, fh + ":" + str.FromInt(fp as i64), fh, fp, n)
worked = 1
end
_udp_sweep(s)
ret worked
end
@en "UdpServe"
@fa "خدمت یو دی پی"
pub func UdpServe(s &: UdpServer):
until atomic_load(s.stopc) == 0 as i64:
_step := UdpStep(s)
end
end
@en "UdpStop"
@fa "توقف یو دی پی"
pub func UdpStop(s: UdpServer):
atomic_store(s.stopc, 1 as i64)
end
@en "UdpDestroy"
@fa "نابودی یو دی پی"
pub func UdpDestroy(s &: UdpServer):
each _, out in s.assoc:
udp.Close(out)
end
s.assoc.free()
s.sess.free()
each _, kb in s.skeys:
mut kk := kb
BufWipe(kk)
BufFree(kk)
end
s.skeys.free()
each uid, ub in s.users:
mut uk := ub
BufWipe(uk)
BufFree(uk)
mem.Free(uid as void*)
end
s.users.free()
FilterFree(s.filter)
s.clients.free()
s.seen.free()
udp.Close(s.sock)
if s.rbuf != null:
mem.Free(s.rbuf)
end
if s.stopc != null:
mem.Free(s.stopc as void*)
end
mut k := s.key
BufWipe(k)
BufFree(k)
end
package shadowsocks
import mem
import time
import crypto
import tls
const UDP22_SKEW := 30
const UDP22_WINDOW := 64
@en "UdpSession"
@fa "نشست یو دی پی"
pub struct UdpSession:
@en "sid"
@fa "شناسه نشست"
pub sid: i64 = 0
@en "pid"
@fa "شناسه بسته"
pub pid: i64 = 0
@en "peer"
@fa "شناسه نشست همتا"
pub peer: i64 = 0
@en "top"
@fa "بالاترین شناسه"
pub top: i64 = 0
@en "bits"
@fa "بیت های پنجره"
pub bits: u64 = 0 as u64
@en "any"
@fa "بسته دریافت شد"
pub any: bool = false
@en "last"
@fa "آخرین شناسه دریافتی"
pub last: i64 = 0
end
func _u22_put64(p: void*, off: int, v: i64):
repeat 8 in i:
_setb(p, off + i, ((v >> (((7 - i) * 8) as i64)) & (255 as i64)) as int)
end
end
func _u22_skew_ok(ts: i64): bool:
d := time.Now() - ts
ret d <= (UDP22_SKEW as i64) and d >= (0 - UDP22_SKEW) as i64
end
func _u22_pt_parse(client: bool, pt: void*, n: int, own_sid: i64, t &: Target, out &: Buf): bool:
mut off := 9
if n < 11:
ret false
end
want := client ? 1 : 0
if _getb(pt, 0) != want:
ret false
end
if not _u22_skew_ok(_get64be(_at(pt, 1))):
ret false
end
if client:
if n < off + 8 + 2:
ret false
end
if _get64be(_at(pt, off)) != own_sid:
ret false
end
off += 8
end
padlen := _getb(pt, off) * 256 + _getb(pt, off + 1)
off += 2 + padlen
if off >= n:
ret false
end
hl := ParseTarget(_at(pt, off), n - off, t)
if hl <= 0:
ret false
end
off += hl
BufAppend(out, _at(pt, off), n - off)
ret true
end
func _u22_xor16(a: void*, b: void*, out: void*):
repeat 16 in i:
_setb(out, i, _getb(a, i) ^ _getb(b, i))
end
end
func _u22_eih_seal(ipsk: void*, klen: int, hdr: void*, next_psk: void*, out16: void*): bool:
h := mem.AllocateZeroed(16 as u64)
IdentityHash(next_psk, klen, h)
_u22_xor16(h, hdr, h)
ok := tls.AesEcbBlock(ipsk, klen, h, out16, false)
mem.Free(h)
ret ok
end
func _u22_eih_open(ipsk: void*, klen: int, hdr: void*, block16: void*, out_hash16: void*): bool:
ok := tls.AesEcbBlock(ipsk, klen, block16, out_hash16, true)
_u22_xor16(out_hash16, hdr, out_hash16)
ret ok
end
func _u22_ctx(m: Method, ukey: void*, hdr: void*): void*:
sub := mem.AllocateZeroed(32 as u64)
Blake3SessionKey(ukey, m.key_len, hdr, 8, sub)
c := tls.AeadNew(m.kind, sub)
_wipe(sub, 32)
mem.Free(sub)
ret c
end
@en "NewUdpSession"
@fa "نشست یو دی پی جدید"
pub func NewUdpSession(): UdpSession:
r := mem.AllocateZeroed(8 as u64)
crypto.RandomBytes(r, 8)
sid := _get64be(r)
mem.Free(r)
ret UdpSession { sid = sid }
end
@en "SessionAccept"
@fa "پذیرش شناسه بسته"
pub func SessionAccept(s &: UdpSession, pid: i64): bool:
if not s.any:
s.any = true
s.top = pid
s.bits = 1 as u64
ret true
end
if pid > s.top:
shift := pid - s.top
if shift >= (UDP22_WINDOW as i64):
s.bits = 1 as u64
else:
s.bits = (s.bits << (shift as u64)) | (1 as u64)
end
s.top = pid
ret true
end
d := s.top - pid
if d >= (UDP22_WINDOW as i64):
ret false
end
mask := (1 as u64) << (d as u64)
if (s.bits & mask) != (0 as u64):
ret false
end
s.bits |= mask
ret true
end
@en "PackUdp2022"
@fa "بسته بندی یو دی پی نسخه جدید"
pub func PackUdp2022(
m: Method, ukey: void*, hdr_key: void*, eih: Buf, eih_n: int, s &: UdpSession, client: bool, host: str,
port: int, data: void*, n: int, out &: Buf
): bool:
if not m.v2022:
ret false
end
klen := m.key_len
mut pt := NewBuf(n + 1300)
BufAppendByte(pt, client ? 0 : 1)
_put64be(pt, time.Now())
if not client:
_put64be(pt, s.peer)
end
mut padlen := 0
if client and port == 53:
padlen = _rand_int(901)
end
BufAppendByte(pt, padlen >> 8)
BufAppendByte(pt, padlen)
_put_random(pt, padlen)
if not EncodeTarget(host, port, pt):
BufFree(pt)
ret false
end
BufAppend(pt, data, n)
hdr := mem.AllocateZeroed(16 as u64)
_u22_put64(hdr, 0, s.sid)
_u22_put64(hdr, 8, s.pid)
s.pid++
if m.kind == tls.AEAD_CHACHA20_POLY1305:
nonce := mem.AllocateZeroed(24 as u64)
crypto.RandomBytes(nonce, 24)
BufAppend(out, nonce, 24)
mut full := NewBuf(pt.len + 16)
BufAppend(full, hdr, 16)
BufAppend(full, pt.p, pt.len)
BufReserve(out, full.len + TAG_LEN)
tls.XChaCha20Poly1305SealRaw(ukey, nonce, null, 0, full.p, full.len, _at(out.p, out.len))
out.len += full.len + TAG_LEN
BufWipe(full)
BufFree(full)
mem.Free(nonce)
else:
enc := mem.AllocateZeroed(16 as u64)
tls.AesEcbBlock(hdr_key, klen, hdr, enc, false)
BufAppend(out, enc, 16)
mem.Free(enc)
repeat eih_n in i:
mut nxt := ukey
if i + 1 < eih_n:
nxt = _at(eih.p, (i + 1) * klen)
end
blk := mem.AllocateZeroed(16 as u64)
_u22_eih_seal(_at(eih.p, i * klen), klen, hdr, nxt, blk)
BufAppend(out, blk, 16)
mem.Free(blk)
end
ctx := _u22_ctx(m, ukey, hdr)
BufReserve(out, pt.len + TAG_LEN)
tls.AeadSeal(ctx, _at(hdr, 4), null, 0, pt.p, pt.len, _at(out.p, out.len))
out.len += pt.len + TAG_LEN
tls.AeadFree(ctx)
end
mem.Free(hdr)
BufWipe(pt)
BufFree(pt)
ret not out.bad
end
@en "Udp2022Peek"
@fa "نگاه به یو دی پی نسخه جدید"
pub func Udp2022Peek(m: Method, hdr_key: void*, p: void*, n: int, sid &: i64): bool:
if not m.v2022 or m.kind == tls.AEAD_CHACHA20_POLY1305 or n < 16:
ret false
end
hdr := mem.AllocateZeroed(16 as u64)
ok := tls.AesEcbBlock(hdr_key, m.key_len, p, hdr, true)
sid = _get64be(hdr)
mem.Free(hdr)
ret ok
end
@en "UnpackUdp2022"
@fa "بازکردن یو دی پی نسخه جدید"
pub func UnpackUdp2022(
m: Method, ukey: void*, hdr_key: void*, skip: int, client: bool, p: void*, n: int, s &: UdpSession,
t &: Target, out &: Buf
): bool:
if not m.v2022:
ret false
end
hdr := mem.AllocateZeroed(16 as u64)
pt := mem.Allocate((n + 1) as u64)
mut ptn := 0
mut ok := false
if m.kind == tls.AEAD_CHACHA20_POLY1305:
if n >= 24 + 16 + 16 + 11:
ok = tls.XChaCha20Poly1305OpenRaw(ukey, p, null, 0, _at(p, 24), n - 24, pt)
if ok:
ptn = n - 24 - TAG_LEN - 16
mem.Copy(hdr, pt, 16 as u64)
mem.MemMove(pt, _at(pt, 16), ptn as u64)
end
end
else:
if n >= 16 + skip + TAG_LEN + 11:
if tls.AesEcbBlock(hdr_key, m.key_len, p, hdr, true):
ctx := _u22_ctx(m, ukey, hdr)
ptn = n - 16 - skip - TAG_LEN
ok = tls.AeadOpen(ctx, _at(hdr, 4), null, 0, _at(p, 16 + skip), ptn, pt)
tls.AeadFree(ctx)
end
end
end
mut good := false
if ok:
sid := _get64be(hdr)
pid := _get64be(_at(hdr, 8))
if _u22_pt_parse(client, pt, ptn, s.sid, t, out):
s.last = pid
if client:
if s.peer != 0 and sid != s.peer:
good = false
else:
if s.peer == 0:
s.peer = sid
end
good = SessionAccept(s, pid)
end
else:
s.peer = sid
good = true
end
end
end
_wipe(pt, n)
mem.Free(pt)
mem.Free(hdr)
ret good
end
@en "Udp2022Identity"
@fa "هویت یو دی پی نسخه جدید"
pub func Udp2022Identity(m: Method, ipsk: void*, p: void*, n: int, out_hash16: void*): bool:
if not m.v2022 or m.kind == tls.AEAD_CHACHA20_POLY1305 or n < 32:
ret false
end
hd := mem.AllocateZeroed(16 as u64)
mut ok := tls.AesEcbBlock(ipsk, m.key_len, p, hd, true)
if ok:
ok = _u22_eih_open(ipsk, m.key_len, hd, _at(p, 16), out_hash16)
end
mem.Free(hd)
ret ok
end
package shadowsocks
import str
import encoding
@en "Plugin"
@fa "افزونه"
pub struct Plugin:
@en "name"
@fa "نام"
pub name: str = ""
@en "keys"
@fa "کلیدها"
pub keys: Vector<str> = Vector {} as Vector<str>
@en "values"
@fa "مقدارها"
pub values: Vector<str> = Vector {} as Vector<str>
end
@en "Uri"
@fa "نشانی"
pub struct Uri:
@en "method"
@fa "روش"
pub method: str = ""
@en "password"
@fa "گذرواژه"
pub password: str = ""
@en "host"
@fa "میزبان"
pub host: str = ""
@en "port"
@fa "درگاه"
pub port: int = 0
@en "plugin"
@fa "افزونه"
pub plugin: str = ""
@en "tag"
@fa "برچسب"
pub tag: str = ""
@en "ok"
@fa "معتبر"
pub ok: bool = false
end
func _b64_decode(s0: str): str:
mut s := str.Replace(str.Replace(s0, "-", "+"), "_", "/")
mut pad := (4 - s.len() % 4) % 4
until pad > 0:
s += "="
pad--
end
mut out := ""
try:
out = encoding.Base64Decode(s)
catch:
out = ""
end
ret out
end
func _b64url_encode(s: str): str:
mut e := encoding.Base64Encode(s)
e = str.Replace(str.Replace(e, "+", "-"), "/", "_")
ret str.TrimSuffix(str.TrimSuffix(e, "="), "=")
end
func _pct_decode(s: str): str:
mut out := s
try:
out = encoding.URLDecode(s)
catch:
out = s
end
ret out
end
func _split_hostport(hp: str, host &: str, port &: int): bool:
n := hp.len()
if n < 3:
ret false
end
mut cut := 0 - 1
mut i := n - 1
until i >= 0 and cut < 0:
if _getb(hp as void*, i) == 58:
cut = i
end
i--
end
if cut <= 0 or cut >= n - 1:
ret false
end
mut h := str.Substr(hp, 0, cut)
if h.len() >= 2 and _getb(h as void*, 0) == 91 and _getb(h as void*, h.len() - 1) == 93:
h = str.Substr(h, 1, h.len() - 2)
end
ps := str.Substr(hp, cut + 1, n - cut - 1)
pv := str.ToInt(ps)
if pv <= 0 or pv > 65535 or h == "":
ret false
end
host = h
port = pv
ret true
end
func _split_creds(c: str, method &: str, password &: str): bool:
k := str.IndexOf(c, ":")
if k <= 0:
ret false
end
method = str.Substr(c, 0, k)
password = str.Substr(c, k + 1, c.len() - k - 1)
ret true
end
func _find_char(s: str, ch: int, from: int): int:
n := s.len()
mut i := from
until i < n:
if _getb(s as void*, i) == ch:
ret i
end
i++
end
ret 0 - 1
end
func _query_param(q: str, name: str): str:
mut start := 0
n := q.len()
until start < n:
mut e := _find_char(q, 38, start)
if e < 0:
e = n
end
part := str.Substr(q, start, e - start)
eqi := _find_char(part, 61, 0)
if eqi > 0 and str.Substr(part, 0, eqi) == name:
ret _pct_decode(str.Substr(part, eqi + 1, part.len() - eqi - 1))
end
start = e + 1
end
ret ""
end
@en "ParseUri"
@fa "تجزیه نشانی"
pub func ParseUri(text: str): Uri:
mut u := Uri {}
if not str.StartsWith(text, "ss://"):
ret u
end
mut s := str.Substr(text, 5, text.len() - 5)
h := _find_char(s, 35, 0)
if h >= 0:
u.tag = _pct_decode(str.Substr(s, h + 1, s.len() - h - 1))
s = str.Substr(s, 0, h)
end
mut query := ""
q := _find_char(s, 63, 0)
if q >= 0:
query = str.Substr(s, q + 1, s.len() - q - 1)
s = str.Substr(s, 0, q)
end
s = str.TrimSuffix(s, "/")
u.plugin = _query_param(query, "plugin")
mut at := 0 - 1
mut i := s.len() - 1
until i >= 0 and at < 0:
if _getb(s as void*, i) == 64:
at = i
end
i--
end
mut creds := ""
mut hp := ""
if at >= 0:
ui := str.Substr(s, 0, at)
hp = str.Substr(s, at + 1, s.len() - at - 1)
if _find_char(ui, 58, 0) >= 0 or _find_char(ui, 37, 0) >= 0:
creds = _pct_decode(ui)
else:
creds = _b64_decode(ui)
end
else:
dec := _b64_decode(s)
k := _find_char(dec, 64, 0)
if k < 0:
ret u
end
creds = str.Substr(dec, 0, k)
hp = str.Substr(dec, k + 1, dec.len() - k - 1)
end
if not _split_creds(creds, u.method, u.password):
ret u
end
if not _split_hostport(hp, u.host, u.port):
ret u
end
u.ok = LookupMethod(u.method).ok
ret u
end
@en "FormatUri"
@fa "قالب بندی نشانی"
pub func FormatUri(u: Uri): str:
mut host := u.host
if _find_char(host, 58, 0) >= 0:
host = "[" + host + "]"
end
m := LookupMethod(u.method)
mut out := "ss://"
if m.v2022:
out = out + encoding.URLEncode(u.method) + ":" + encoding.URLEncode(u.password)
else:
out += _b64url_encode(u.method + ":" + u.password)
end
out = out + "@" + host + ":" + str.FromInt(u.port as i64)
if u.plugin != "":
out = out + "/?plugin=" + encoding.URLEncode(u.plugin)
end
if u.tag != "":
out = out + "#" + encoding.URLEncode(u.tag)
end
ret out
end
@en "ParsePlugin"
@fa "تجزیه افزونه"
pub func ParsePlugin(text: str): Plugin:
mut p := Plugin {}
mut cur := ""
mut tokens := Vector {} as Vector<str>
defer tokens.free()
n := text.len()
mut i := 0
until i < n:
c := _getb(text as void*, i)
if c == 92 and i + 1 < n:
cur += str.Substr(text, i + 1, 1)
i += 2
else c == 59:
tokens.push(cur)
cur = ""
i++
else:
cur += str.Substr(text, i, 1)
i++
end
end
tokens.push(cur)
p.name = tokens.get(0)
mut t := 1
until t < tokens.len():
tok := tokens.get(t)
mut k := 0 - 1
mut j := 0
until j < tok.len() and k < 0:
if _getb(tok as void*, j) == 61:
k = j
end
j++
end
if k < 0:
p.keys.push(tok)
p.values.push("")
else:
p.keys.push(str.Substr(tok, 0, k))
p.values.push(str.Substr(tok, k + 1, tok.len() - k - 1))
end
t++
end
ret p
end
@en "PluginGet"
@fa "گرفتن گزینه افزونه"
pub func PluginGet(p: Plugin, key: str, fallback: str): str:
mut i := 0
until i < p.keys.len():
if p.keys.get(i) == key:
ret p.values.get(i)
end
i++
end
ret fallback
end
@en "PluginHas"
@fa "گزینه افزونه موجود است"
pub func PluginHas(p: Plugin, key: str): bool:
mut i := 0
until i < p.keys.len():
if p.keys.get(i) == key:
ret true
end
i++
end
ret false
end
@en "PluginFree"
@fa "آزادسازی افزونه"
pub func PluginFree(p: Plugin):
p.keys.free()
p.values.free()
end
@en "ToConfig"
@fa "تبدیل به پیکربندی"
pub func ToConfig(u: Uri): Config:
mut cfg := Config { host = u.host, port = u.port, method = u.method, password = u.password }
if u.plugin != "":
p := ParsePlugin(u.plugin)
if p.name == "obfs-local" or p.name == "simple-obfs":
cfg.obfs = PluginGet(p, "obfs", "")
cfg.obfs_host = PluginGet(p, "obfs-host", "www.bing.com")
end
PluginFree(p)
end
ret cfg
end
package socketio
import encoding.json
import encoding.value
import conv
@en "Args"
@fa "آرگومان‌ها"
pub struct Args:
@en "items"
@fa "آرگومان‌ها"
pub items: Vector<str> = Vector {}
@en "bins"
@fa "بخش‌های دودویی"
pub bins: Vector<Bytes> = Vector {}
end
func _decode_one(frag: str): value.Value:
ret try json.Decode(frag) catch value.ValueNull()
end
@en "NewArgs"
@fa "آرگومان جدید"
pub func NewArgs(): Args:
ret Args {}
end
@en "AddStr"
@fa "افزودن رشته"
pub func AddStr(a &: Args, s: str):
a.items.push(json.Str(s))
end
@en "AddInt"
@fa "افزودن عدد"
pub func AddInt(a &: Args, n: i64):
a.items.push("" + n)
end
@en "AddFloat"
@fa "افزودن اعشاری"
pub func AddFloat(a &: Args, n: f64):
a.items.push("" + n)
end
@en "AddBool"
@fa "افزودن بولی"
pub func AddBool(a &: Args, b: bool):
if b:
a.items.push("true")
else:
a.items.push("false")
end
end
@en "AddNull"
@fa "افزودن تهی"
pub func AddNull(a &: Args):
a.items.push("null")
end
@en "AddJSON"
@fa "افزودن جیسون"
pub func AddJSON(a &: Args, raw: str):
if raw.len() == 0:
a.items.push("null")
else:
a.items.push(raw)
end
end
@en "AddValue"
@fa "افزودن مقدار"
pub func AddValue(a &: Args, v: value.Value):
a.items.push(json.EncodeDefault(v))
end
@en "AddBytes"
@fa "افزودن بایت"
pub func AddBytes(a &: Args, ptr: void*, n: int):
a.items.push(Placeholder(a.bins.len()))
a.bins.push(NewBytes(ptr, n))
end
@en "AddBinaryStr"
@fa "افزودن رشته دودویی"
pub func AddBinaryStr(a &: Args, s: str):
AddBytes(a, s as void*, s.len())
end
@en "ArgsCount"
@fa "شمار آرگومان"
pub func ArgsCount(a: Args): int:
ret a.items.len()
end
@en "ArgsFree"
@fa "آزادسازی آرگومان"
pub func ArgsFree(a &: Args):
repeat a.bins.len() in i:
mut b := a.bins.get(i)
BytesFree(b)
end
a.bins.free()
a.items.free()
end
@en "ArgsJSON"
@fa "جیسون آرگومان"
pub func ArgsJSON(a: Args, name: str): str:
mut out := "["
mut first := true
if name.len() > 0:
out += json.Str(name)
first = false
end
repeat a.items.len() in i:
if not first:
out += ","
end
out += a.items.get(i)
first = false
end
ret out + "]"
end
@en "ItemCount"
@fa "شمار عنصر"
pub func ItemCount(raw: str): int:
mut parts := SplitJSONArray(raw)
defer parts.free()
ret parts.len()
end
@en "Item"
@fa "عنصر"
pub func Item(raw: str, i: int): str:
mut parts := SplitJSONArray(raw)
defer parts.free()
if i < 0 or i >= parts.len():
ret ""
end
ret parts.get(i)
end
@en "ItemStr"
@fa "عنصر رشته‌ای"
pub func ItemStr(raw: str, i: int): str:
frag := Item(raw, i)
if frag.len() == 0:
ret ""
end
mut v := _decode_one(frag)
defer value.ValueFree(v)
if value.IsString(v):
ret value.AsString(v)
end
ret frag
end
@en "ItemInt"
@fa "عنصر عددی"
pub func ItemInt(raw: str, i: int): i64:
mut v := _decode_one(Item(raw, i))
defer value.ValueFree(v)
if value.IsString(v):
ret conv.ParseIntOr(value.AsString(v), 0)
end
ret value.AsInt(v)
end
@en "ItemFloat"
@fa "عنصر اعشاری"
pub func ItemFloat(raw: str, i: int): f64:
mut v := _decode_one(Item(raw, i))
defer value.ValueFree(v)
if value.IsString(v):
ret conv.ParseFloatOr(value.AsString(v), 0.0)
end
ret value.AsFloat(v)
end
@en "ItemBool"
@fa "عنصر بولی"
pub func ItemBool(raw: str, i: int): bool:
mut v := _decode_one(Item(raw, i))
defer value.ValueFree(v)
if value.IsBool(v):
ret value.AsBool(v)
end
if value.IsNumber(v):
ret value.AsInt(v) != 0
end
if value.IsString(v):
t := value.AsString(v)
ret t == "true" or t == "1"
end
ret false
end
@en "ItemValue"
@fa "مقدار عنصر"
pub func ItemValue(raw: str, i: int): value.Value:
ret _decode_one(Item(raw, i))
end
package socketio
import net.http
import str
import time
import rand
import encoding
import encoding.json
func _now(): i64:
ret time.MonoMillis()
end
func _cookie_header(m: MgrState*): str:
if m[0].cookies.size() == 0:
ret ""
end
ck := http.CookieHeader(m[0].cookies)
if ck.len() == 0:
ret ""
end
ret "Cookie: " + ck + "\r\n"
end
func _headers_of(m: MgrState*): str:
mut own := m[0].opts.headers
if str.Trim(own).len() == 0:
own = ""
else not str.EndsWith(own, "\r\n"):
own += "\r\n"
end
ret own + _cookie_header(m)
end
func _absorb_cookies(m: MgrState*, r: http.Response):
mut got := http.CookieMap(r)
defer got.free()
each k, v in got:
m[0].cookies.put(k, v)
end
end
func _query_of(m: MgrState*, transport: str, sid: str): str:
mut q := "EIO=4&transport=" + transport
if sid.len() > 0:
q += "&sid=" + sid
end
q += "&t=" + time.NowMillis() + "-" + rand.Int32Range(0, 999999)
mut extra := _clean_query(m[0].ep.query)
own := _clean_query(m[0].opts.query)
if own.len() > 0:
if extra.len() > 0:
extra += "&"
end
extra += own
end
if extra.len() > 0:
q += "&" + extra
end
ret q
end
func _mount(m: MgrState*): str:
if m[0].opts.trailing_slash and m[0].ep.path != "/":
ret m[0].ep.path + "/?"
end
ret m[0].ep.path + "?"
end
func _clean_query(q: str): str:
mut out := str.Trim(q)
until str.StartsWith(out, "?") or str.StartsWith(out, "&"):
out = out.substr(1, out.len() - 1)
end
ret out
end
func _poll_url(m: MgrState*, sid: str): str:
ret Origin(m[0].ep) + _mount(m) + _query_of(m, "polling", sid)
end
func _ws_path(m: MgrState*, sid: str): str:
ret _mount(m) + _query_of(m, "websocket", sid)
end
func _read_open(m: MgrState*, body: str): bool:
if json.Get(body, "sid").len() == 0:
ret false
end
m[0].sid = json.Get(body, "sid")
if json.Has(body, "pingInterval"):
m[0].ping_interval = json.GetInt(body, "pingInterval")
end
if json.Has(body, "pingTimeout"):
m[0].ping_timeout = json.GetInt(body, "pingTimeout")
end
if json.Has(body, "maxPayload"):
m[0].max_payload = json.GetInt(body, "maxPayload")
end
m[0].can_upgrade = str.Contains(json.Get(body, "upgrades"), "websocket")
m[0].last_rx = _now()
ret true
end
func _ws_open(m: MgrState*, sid: str): bool:
path := _ws_path(m, sid)
hdrs := _headers_of(m)
if m[0].ep.secure and m[0].opts.insecure:
m[0].ws = websocket.DialWSSUnverified(m[0].ep.host, m[0].ep.port, path, hdrs)
else m[0].ep.secure:
m[0].ws = websocket.DialWSSWith(m[0].ep.host, m[0].ep.port, path, hdrs)
else:
m[0].ws = websocket.DialWith(m[0].ep.host, m[0].ep.port, path, hdrs)
end
if not websocket.IsOpen(m[0].ws):
m[0].last_error = "websocket handshake to " + Origin(m[0].ep) + " was refused"
ret false
end
ret true
end
func _ws_direct(m: MgrState*): bool:
if not _ws_open(m, ""):
ret false
end
msg := websocket.Poll(m[0].ws, _connect_timeout(m))
if msg.kind != websocket.TEXT:
m[0].last_error = "no open packet from the server"
websocket.Close(m[0].ws)
ret false
end
if EngineKind(msg.text) != EIO_OPEN:
m[0].last_error = "expected an open packet, got " + msg.text
websocket.Close(m[0].ws)
ret false
end
if not _read_open(m, EngineBody(msg.text)):
m[0].last_error = "malformed open packet"
websocket.Close(m[0].ws)
ret false
end
m[0].transport = TRANSPORT_WEBSOCKET
m[0].upgraded_before = true
ret true
end
func _poll_handshake(m: MgrState*): bool:
r := http.RequestRaw("GET", _poll_url(m, ""), _headers_of(m), "")
if r.status != 200:
if r.err.len() > 0:
m[0].last_error = r.err
else:
m[0].last_error = "handshake to " + m[0].ep.path + " answered " + r.status
end
ret false
end
_absorb_cookies(m, r)
mut payloads := SplitPayloads(r.body)
defer payloads.free()
if payloads.len() == 0:
m[0].last_error = "empty handshake response"
ret false
end
first := payloads.get(0)
if EngineKind(first) != EIO_OPEN:
m[0].last_error = "expected an open packet, got " + first
ret false
end
if not _read_open(m, EngineBody(first)):
m[0].last_error = "malformed open packet"
ret false
end
m[0].transport = TRANSPORT_POLLING
mut i := 1
until i < payloads.len():
_engine_payload(m, payloads.get(i))
i++
end
ret true
end
func _try_upgrade(m: MgrState*): bool:
if not m[0].can_upgrade:
ret false
end
if not _ws_open(m, m[0].sid):
ret false
end
if websocket.SendText(m[0].ws, EncodeEngine(EIO_PING, "probe")) != 0:
websocket.Close(m[0].ws)
ret false
end
deadline := _now() + (_connect_timeout(m) as i64)
mut probed := false
mut going := true
until going:
left := (deadline - _now()) as int
if left <= 0:
going = false
else:
msg := websocket.Poll(m[0].ws, left)
if msg.kind == websocket.TIMEOUT:
going = false
else msg.kind != websocket.TEXT:
going = false
else EngineKind(msg.text) == EIO_PONG and EngineBody(msg.text) == "probe":
probed = true
going = false
end
end
end
if not probed:
websocket.Close(m[0].ws)
ret false
end
if websocket.SendText(m[0].ws, EncodeEngine(EIO_UPGRADE, "")) != 0:
websocket.Close(m[0].ws)
ret false
end
m[0].transport = TRANSPORT_WEBSOCKET
m[0].upgraded_before = true
m[0].last_rx = _now()
_broadcast_lifecycle(m, EV_UPGRADE, "websocket")
ret true
end
func _engine_open(m: MgrState*): bool:
m[0].last_error = ""
m[0].sid = ""
m[0].recon = false
m[0].pollout.clear()
remembered := m[0].opts.remember_upgrade and m[0].upgraded_before and m[0].opts.transports == TRANSPORT_AUTO
if m[0].opts.transports == TRANSPORT_WEBSOCKET or remembered or (m[0].ep.secure and m[0].opts.insecure):
if _ws_direct(m):
m[0].state = ST_OPEN
ret true
end
if not remembered:
ret false
end
m[0].upgraded_before = false
m[0].last_error = ""
end
if not _poll_handshake(m):
ret false
end
if m[0].opts.transports == TRANSPORT_AUTO:
_try_upgrade(m)
end
m[0].state = ST_OPEN
ret true
end
func _engine_close(m: MgrState*):
if m[0].transport == TRANSPORT_POLLING and m[0].state == ST_OPEN and m[0].sid.len() > 0:
m[0].pollout.push(EncodeEngine(EIO_CLOSE, ""))
_poll_flush(m)
end
if websocket.IsOpen(m[0].ws):
if m[0].transport == TRANSPORT_WEBSOCKET:
websocket.SendText(m[0].ws, EncodeEngine(EIO_CLOSE, ""))
end
websocket.Close(m[0].ws)
end
m[0].state = ST_CLOSED
m[0].sid = ""
end
func _poll_flush(m: MgrState*): bool:
if m[0].pollout.len() == 0:
ret true
end
mut cap := m[0].max_payload
if cap < 1024:
cap = 1024
end
mut batch := Vector {} as Vector<str>
defer batch.free()
mut used := 0
mut ok := true
repeat m[0].pollout.len() in i:
one := m[0].pollout.get(i)
if batch.len() > 0 and used + one.len() + 1 > cap:
if not _poll_post(m, batch):
ok = false
end
batch.clear()
used = 0
end
batch.push(one)
used += one.len() + 1
end
if batch.len() > 0 and ok:
if not _poll_post(m, batch):
ok = false
end
end
m[0].pollout.clear()
ret ok
end
func _poll_post(m: MgrState*, items: Vector<str>): bool:
body := JoinPayloads(items)
hdrs := _headers_of(m) + "Content-Type: text/plain;charset=UTF-8\r\n"
r := http.RequestRaw("POST", _poll_url(m, m[0].sid), hdrs, body)
if r.status != 200:
m[0].last_error = "polling write answered " + r.status
ret false
end
_absorb_cookies(m, r)
ret true
end
func _engine_write(m: MgrState*, payload: str): bool:
if m[0].state != ST_OPEN:
ret false
end
if m[0].transport == TRANSPORT_WEBSOCKET:
ret websocket.SendText(m[0].ws, payload) == 0
end
m[0].pollout.push(payload)
if m[0].batching:
ret true
end
ret _poll_flush(m)
end
func _engine_write_bytes(m: MgrState*, b: Bytes): bool:
if m[0].state != ST_OPEN:
ret false
end
if m[0].transport == TRANSPORT_WEBSOCKET:
ret websocket.SendBinaryBytes(m[0].ws, b.ptr, b.len) == 0
end
m[0].pollout.push("b" + BytesToBase64(b))
if m[0].batching:
ret true
end
ret _poll_flush(m)
end
func _heartbeat_expired(m: MgrState*): bool:
if m[0].state != ST_OPEN:
ret false
end
limit := (m[0].ping_interval + m[0].ping_timeout) as i64
ret _now() - m[0].last_rx > limit
end
func _engine_payload(m: MgrState*, payload: str):
if payload.len() == 0:
ret
end
m[0].last_rx = _now()
k := EngineKind(payload)
if k == EIO_PING:
_engine_write(m, EncodeEngine(EIO_PONG, ""))
_broadcast_lifecycle(m, EV_PING, "")
else k == EIO_CLOSE:
_engine_shutdown(m, REASON_TRANSPORT_CLOSE)
else k == EIO_MESSAGE:
_on_socketio_text(m, EngineBody(payload))
end
end
func _engine_binary(m: MgrState*, b: Bytes):
m[0].last_rx = _now()
_on_socketio_binary(m, b)
end
func _poll_turn(m: MgrState*): int:
if not _poll_flush(m):
ret PUMP_CLOSED
end
r := http.RequestRaw("GET", _poll_url(m, m[0].sid), _headers_of(m), "")
if r.status != 200:
m[0].last_error = "long-poll answered " + r.status
ret PUMP_CLOSED
end
_absorb_cookies(m, r)
mut payloads := SplitPayloads(r.body)
defer payloads.free()
mut got := false
repeat payloads.len() in i:
p := payloads.get(i)
if p.len() > 0:
got = true
if str.StartsWith(p, "b"):
_poll_binary(m, p.substr(1, p.len() - 1))
else:
_engine_payload(m, p)
end
end
end
if not got:
ret PUMP_TIMEOUT
end
ret PUMP_OK
end
func _poll_binary(m: MgrState*, encoded: str):
if encoded.len() == 0:
ret
end
cap := (encoded.len() / 4) * 3 + 4
buf := mem.Allocate(cap as u64)
if buf == null:
ret
end
defer mem.Free(buf)
mut ok := false
mut n := 0
try:
n = encoding.Base64DecodeBytes(encoded, buf, cap)
ok = true
catch:
ok = false
end
if not ok or n <= 0:
ret
end
mut b := NewBytes(buf, n)
_engine_binary(m, b)
BytesFree(b)
end
func _ws_turn(m: MgrState*, timeout_ms: int): int:
msg := websocket.Poll(m[0].ws, timeout_ms)
if msg.kind == websocket.TIMEOUT:
ret PUMP_TIMEOUT
end
if msg.kind == websocket.TEXT:
_engine_payload(m, msg.text)
ret PUMP_OK
end
if msg.kind == websocket.BINARY:
mut b := NewBytes(msg.data, msg.len)
_engine_binary(m, b)
BytesFree(b)
ret PUMP_OK
end
if msg.kind == websocket.PONG:
ret PUMP_TIMEOUT
end
ret PUMP_CLOSED
end
func _transport_read(m: MgrState*, timeout_ms: int): int:
if m[0].state != ST_OPEN:
ret PUMP_CLOSED
end
if m[0].transport == TRANSPORT_WEBSOCKET:
ret _ws_turn(m, timeout_ms)
end
ret _poll_turn(m)
end
package socketio
import str
import mem
import encoding
@en "EngineOpen"
@fa "باز کردن موتور"
pub const EIO_OPEN := 0
@en "EngineClose"
@fa "بستن موتور"
pub const EIO_CLOSE := 1
@en "EnginePing"
@fa "پینگ موتور"
pub const EIO_PING := 2
@en "EnginePong"
@fa "پونگ موتور"
pub const EIO_PONG := 3
@en "EngineMessage"
@fa "پیام موتور"
pub const EIO_MESSAGE := 4
@en "EngineUpgrade"
@fa "ارتقای موتور"
pub const EIO_UPGRADE := 5
@en "EngineNoop"
@fa "بی‌کار موتور"
pub const EIO_NOOP := 6
@en "ConnectPacket"
@fa "بسته اتصال"
pub const PKT_CONNECT := 0
@en "DisconnectPacket"
@fa "بسته قطع اتصال"
pub const PKT_DISCONNECT := 1
@en "EventPacket"
@fa "بسته رویداد"
pub const PKT_EVENT := 2
@en "AckPacket"
@fa "بسته تایید"
pub const PKT_ACK := 3
@en "ConnectError"
@fa "خطای اتصال"
pub const PKT_CONNECT_ERROR := 4
@en "BinaryEvent"
@fa "رویداد دودویی"
pub const PKT_BINARY_EVENT := 5
@en "BinaryAck"
@fa "تایید دودویی"
pub const PKT_BINARY_ACK := 6
const RS := 30
const MAX_ATTACHMENTS := 1024
const MAX_ACK_ID := 1000000000
@en "Bytes"
@fa "بایت‌ها"
pub struct Bytes:
@en "ptr"
@fa "اشاره‌گر"
pub ptr: void* = null
@en "len"
@fa "طول"
pub len: int = 0
end
@en "Packet"
@fa "بسته"
pub struct Packet:
@en "kind"
@fa "نوع"
pub kind: int = 0 - 1
@en "nsp"
@fa "فضای نام"
pub nsp: str = "/"
@en "id"
@fa "شماره تایید"
pub id: int = 0 - 1
@en "data"
@fa "داده"
pub data: str = ""
@en "attachments"
@fa "پیوست‌ها"
pub attachments: int = 0
@en "ok"
@fa "خوانده‌شده"
pub ok: bool = false
end
func _digit_at(s: str, i: int): int:
if i < 0 or i >= s.len():
ret 0 - 1
end
c := char_code(s.substr(i, 1))
if c < 48 or c > 57:
ret 0 - 1
end
ret c - 48
end
func _is_ws(ch: str): bool:
ret ch == " " or ch == "\t" or ch == "\n" or ch == "\r"
end
@en "EncodePacket"
@fa "رمزگذاری بسته"
pub func EncodePacket(p: Packet): str:
mut out := "" + p.kind
if p.attachments > 0 and (p.kind == PKT_BINARY_EVENT or p.kind == PKT_BINARY_ACK):
out += "" + p.attachments + "-"
end
if p.nsp.len() > 0 and p.nsp != "/":
out += p.nsp + ","
end
if p.id >= 0:
out += "" + p.id
end
out += p.data
ret out
end
@en "DecodePacket"
@fa "رمزگشایی بسته"
pub func DecodePacket(text: str): Packet:
mut p := Packet {}
n := text.len()
if n == 0:
ret p
end
k := _digit_at(text, 0)
if k < 0 or k > PKT_BINARY_ACK:
ret p
end
p.kind = k
mut i := 1
if k == PKT_BINARY_EVENT or k == PKT_BINARY_ACK:
mut num := 0
mut seen := false
until _digit_at(text, i) >= 0 and num <= MAX_ATTACHMENTS:
num = num * 10 + _digit_at(text, i)
seen = true
i++
end
if not seen or num > MAX_ATTACHMENTS or i >= n or text.substr(i, 1) != "-":
ret p
end
p.attachments = num
i++
end
if i < n and text.substr(i, 1) == "/":
c := str.IndexFrom(text, ",", i)
if c < 0:
p.nsp = text.substr(i, n - i)
i = n
else:
p.nsp = text.substr(i, c - i)
i = c + 1
end
end
if _digit_at(text, i) >= 0:
mut id := 0
until _digit_at(text, i) >= 0 and id <= MAX_ACK_ID:
id = id * 10 + _digit_at(text, i)
i++
end
if id > MAX_ACK_ID:
ret p
end
p.id = id
end
if i < n:
p.data = text.substr(i, n - i)
end
p.ok = true
ret p
end
@en "EncodeEngine"
@fa "رمزگذاری موتور"
pub func EncodeEngine(kind: int, body: str): str:
ret "" + kind + body
end
@en "EngineKind"
@fa "نوع موتور"
pub func EngineKind(payload: str): int:
ret _digit_at(payload, 0)
end
@en "EngineBody"
@fa "بدنه موتور"
pub func EngineBody(payload: str): str:
if payload.len() < 2:
ret ""
end
ret payload.substr(1, payload.len() - 1)
end
@en "SplitPayloads"
@fa "جداسازی بارها"
pub func SplitPayloads(body: str): Vector<str>:
mut out := Vector {} as Vector<str>
n := body.len()
if n == 0:
ret out
end
mut start := 0
mut i := 0
until i < n:
if char_code(body.substr(i, 1)) == RS:
out.push(body.substr(start, i - start))
start = i + 1
end
i++
end
out.push(body.substr(start, n - start))
ret out
end
@en "JoinPayloads"
@fa "پیوستن بارها"
pub func JoinPayloads(items: Vector<str>): str:
mut sb := str.NewBuilder()
defer str.BufFree(sb)
repeat items.len() in i:
if i > 0:
str.BufAppendChar(sb, RS)
end
str.BufAppend(sb, items.get(i))
end
ret str.BufStr(sb)
end
@en "SplitJSONArray"
@fa "جداسازی آرایه جیسون"
pub func SplitJSONArray(text: str): Vector<str>:
mut out := Vector {} as Vector<str>
s := str.Trim(text)
if not str.StartsWith(s, "["):
ret out
end
n := s.len()
mut i := 1
mut depth := 0
mut instr := false
mut esc := false
mut start := 0 - 1
mut done := false
until i < n and not done:
ch := s.substr(i, 1)
if instr:
if esc:
esc = false
else ch == "\\":
esc = true
else ch == "\"":
instr = false
end
else ch == "\"":
instr = true
if start < 0:
start = i
end
else ch == "[" or ch == "{":
if start < 0:
start = i
end
depth++
else ch == "]" and depth == 0:
if start >= 0:
out.push(str.Trim(s.substr(start, i - start)))
end
done = true
else ch == "]" or ch == "}":
depth--
else ch == "," and depth == 0:
if start >= 0:
out.push(str.Trim(s.substr(start, i - start)))
else:
out.push("")
end
start = 0 - 1
else:
if not _is_ws(ch) and start < 0:
start = i
end
end
i++
end
ret out
end
@en "Placeholder"
@fa "جانگهدار"
pub func Placeholder(num: int): str:
ret `{"_placeholder":true,"num":` + num + "}"
end
@en "PlaceholderNum"
@fa "شماره جانگهدار"
pub func PlaceholderNum(frag: str): int:
if not str.Contains(frag, "_placeholder"):
ret 0 - 1
end
k := str.Find(frag, "\"num\"")
if k < 0:
ret 0 - 1
end
c := str.IndexFrom(frag, ":", k)
if c < 0:
ret 0 - 1
end
mut i := c + 1
until _is_ws(frag.substr(i, 1)):
i++
end
if _digit_at(frag, i) < 0:
ret 0 - 1
end
mut num := 0
until _digit_at(frag, i) >= 0 and num <= MAX_ATTACHMENTS:
num = num * 10 + _digit_at(frag, i)
i++
end
if num > MAX_ATTACHMENTS:
ret 0 - 1
end
ret num
end
@en "NewBytes"
@fa "بایت جدید"
pub func NewBytes(ptr: void*, n: int): Bytes:
if ptr == null or n <= 0:
ret Bytes {}
end
buf := mem.Allocate(n as u64)
if buf == null:
ret Bytes {}
end
mem.Copy(buf, ptr, n as u64)
ret Bytes { ptr = buf, len = n }
end
@en "BytesFromStr"
@fa "بایت از رشته"
pub func BytesFromStr(s: str): Bytes:
ret NewBytes(s as void*, s.len())
end
@en "BytesToStr"
@fa "بایت به رشته"
pub func BytesToStr(b: Bytes): str:
if b.ptr == null or b.len <= 0:
ret ""
end
mut sb := str.NewBuilder()
defer str.BufFree(sb)
bp := b.ptr as i8*
repeat b.len in i:
mut v := bp[i] as int
if v < 0:
v += 256
end
if v == 0:
ret str.BufStr(sb)
end
str.BufAppendChar(sb, v)
end
ret str.BufStr(sb)
end
@en "BytesToBase64"
@fa "بایت به بیس۶۴"
pub func BytesToBase64(b: Bytes): str:
if b.ptr == null or b.len <= 0:
ret ""
end
ret encoding.Base64EncodeBytes(b.ptr, b.len)
end
@en "BytesAt"
@fa "بایت در"
pub func BytesAt(b: Bytes, i: int): int:
if b.ptr == null or i < 0 or i >= b.len:
ret 0 - 1
end
bp := b.ptr as i8*
mut v := bp[i] as int
if v < 0:
v += 256
end
ret v
end
@en "BytesFree"
@fa "آزادسازی بایت"
pub func BytesFree(b &: Bytes):
if b.ptr != null:
mem.Free(b.ptr)
b.ptr = null
end
b.len = 0
end
@en "net/socketio"
@fa "سوکت‌آیاو"
package socketio
import str
import mem
import time
import encoding.json
import encoding.value
const RESERVED := "|connect|connect_error|disconnect|disconnecting|newListener|removeListener|"
func _lifecycle_name(kind: int): str:
if kind == EV_CONNECT:
ret "connect"
end
if kind == EV_DISCONNECT:
ret "disconnect"
end
if kind == EV_CONNECT_ERROR:
ret "connect_error"
end
if kind == EV_ERROR:
ret "error"
end
if kind == EV_RECONNECT:
ret "reconnect"
end
if kind == EV_RECONNECT_ATTEMPT:
ret "reconnect_attempt"
end
if kind == EV_RECONNECT_ERROR:
ret "reconnect_error"
end
if kind == EV_RECONNECT_FAILED:
ret "reconnect_failed"
end
if kind == EV_PING:
ret "ping"
end
if kind == EV_UPGRADE:
ret "upgrade"
end
ret ""
end
func _event_name(ev: Event): str:
if ev.kind == EV_EVENT:
ret ev.name
end
ret _lifecycle_name(ev.kind)
end
func _compact_handlers(v &: Vector<Handler>):
mut kept := Vector {} as Vector<Handler>
repeat v.len() in i:
h := v.get(i)
if h.alive:
kept.push(h)
end
end
v.free()
v = kept
end
func _deliver(c: Client, ev0: Event):
sp := _sock(c)
m := sp[0].mgr as MgrState*
mut ev := ev0
ev.client = c
mut dead := false
m[0].dispatching++
if ev.kind == EV_EVENT:
n := sp[0].any_handlers.len()
mut i := 0
until i < n and i < sp[0].any_handlers.len():
h := sp[0].any_handlers.get(i)
if h.alive:
h.cb(ev)
end
i++
end
end
want := _event_name(ev)
if want.len() > 0:
n := sp[0].handlers.len()
mut i := 0
until i < n and i < sp[0].handlers.len():
mut h := sp[0].handlers.get(i)
if h.alive and h.name == want:
h.cb(ev)
if h.once:
h.alive = false
sp[0].handlers.set(i, h)
dead = true
end
end
i++
end
end
if dead:
_compact_handlers(sp[0].handlers)
end
m[0].dispatching--
if sp[0].queueing and sp[0].max_queue > 0:
sp[0].inbox.push(ev)
until sp[0].inbox.len() > sp[0].max_queue:
mut old := sp[0].inbox.get(0)
_free_bins(old.bins)
sp[0].inbox.remove_at(0)
end
else:
_free_bins(ev.bins)
end
end
func _notify_outgoing(c: Client, name: str, data: str, ack_id: int):
sp := _sock(c)
if sp[0].out_handlers.len() == 0:
ret
end
ev := Event { kind = EV_EVENT, name = name, nsp = sp[0].nsp, data = data, ack_id = ack_id, client = c }
n := sp[0].out_handlers.len()
mut i := 0
until i < n and i < sp[0].out_handlers.len():
h := sp[0].out_handlers.get(i)
if h.alive:
h.cb(ev)
end
i++
end
end
func _broadcast_lifecycle(m: MgrState*, kind: int, message: str):
repeat m[0].socks.len() in i:
c := m[0].socks.get(i)
_deliver(c, Event { kind = kind, nsp = _sock(c)[0].nsp, message = message, data = "[]" })
end
end
func _find_sock(m: MgrState*, nsp: str): Client:
repeat m[0].socks.len() in i:
c := m[0].socks.get(i)
if _sock(c)[0].nsp == nsp:
ret c
end
end
ret Client {}
end
func _resolve_ack(c: Client, id: int, data: str, bins &: Vector<Bytes>): bool:
sp := _sock(c)
repeat sp[0].waiters.len() in i:
mut w := sp[0].waiters.get(i)
if w.alive and w.id == id:
w.alive = false
if w.has_packet:
mut kept := w.packet
_free_bins(kept.bins)
w.has_packet = false
end
sp[0].waiters.set(i, w)
mut a := Ack { ok = true, id = id, data = data, bins = bins }
if w.has_cb:
w.cb(a)
_free_bins(a.bins)
else if w.internal:
_free_bins(a.bins)
else:
sp[0].results.push(a)
end
ret true
end
end
_free_bins(bins)
ret false
end
func _expire_acks(m: MgrState*):
now := time.MonoMillis()
repeat m[0].socks.len() in s:
c := m[0].socks.get(s)
sp := _sock(c)
mut dead := false
repeat sp[0].waiters.len() in i:
mut w := sp[0].waiters.get(i)
if not w.alive:
dead = true
else w.has_deadline and now >= w.deadline:
if w.internal and m[0].state != ST_OPEN:
w.deadline = now + (w.interval as i64)
sp[0].waiters.set(i, w)
else w.retries_left > 0 and w.has_packet:
w.retries_left--
w.deadline = now + (w.interval as i64)
sp[0].waiters.set(i, w)
_write_packet(m, w.packet.text, w.packet.bins)
else:
w.alive = false
dead = true
if w.has_packet:
mut p := w.packet
_free_bins(p.bins)
w.has_packet = false
end
sp[0].waiters.set(i, w)
a := Ack { ok = false, id = w.id, data = "[]" }
if w.has_cb:
w.cb(a)
else if not w.internal:
sp[0].results.push(a)
end
end
end
end
if dead:
_drop_dead_waiters(sp)
end
end
end
func _free_waiter_packets(sp: SockState*):
repeat sp[0].waiters.len() in i:
w := sp[0].waiters.get(i)
if w.has_packet:
mut p := w.packet
_free_bins(p.bins)
end
end
end
func _fail_pending_acks(sp: SockState*):
mut dead := false
repeat sp[0].waiters.len() in i:
mut w := sp[0].waiters.get(i)
if w.alive and not w.internal:
w.alive = false
sp[0].waiters.set(i, w)
dead = true
a := Ack { ok = false, id = w.id, data = "[]" }
if w.has_cb:
w.cb(a)
else:
sp[0].results.push(a)
end
end
end
if dead:
_drop_dead_waiters(sp)
end
end
func _drop_dead_waiters(sp: SockState*):
mut kept := Vector {} as Vector<AckWaiter>
repeat sp[0].waiters.len() in i:
w := sp[0].waiters.get(i)
if w.alive:
kept.push(w)
end
end
sp[0].waiters.free()
sp[0].waiters = kept
end
func _take_result(sp: SockState*, id: int, out &: Ack): bool:
repeat sp[0].results.len() in i:
a := sp[0].results.get(i)
if a.id == id:
out = a
sp[0].results.remove_at(i)
ret true
end
end
ret false
end
func _on_connect_packet(c: Client, p: Packet):
sp := _sock(c)
sp[0].id = json.Get(p.data, "sid")
newpid := json.Get(p.data, "pid")
sp[0].recovered = newpid.len() > 0 and sp[0].pid.len() > 0 and sp[0].pid == newpid
if newpid.len() > 0:
sp[0].pid = newpid
end
sp[0].connected = true
_flush_outbuf(c)
_deliver(c, Event { kind = EV_CONNECT, nsp = sp[0].nsp, data = "[]" })
end
func _on_event_packet(c: Client, p: Packet, bins &: Vector<Bytes>):
sp := _sock(c)
mut parts := SplitJSONArray(p.data)
defer parts.free()
if parts.len() == 0:
_free_bins(bins)
ret
end
name := ItemStr(p.data, 0)
mut rest := "["
mut i := 1
until i < parts.len():
if i > 1:
rest += ","
end
rest += parts.get(i)
i++
end
rest += "]"
if sp[0].pid.len() > 0 and parts.len() > 1:
last := parts.get(parts.len() - 1)
if str.StartsWith(last, "\""):
sp[0].last_offset = ItemStr(p.data, parts.len() - 1)
end
end
_deliver(c, Event { kind = EV_EVENT, name = name, nsp = sp[0].nsp, data = rest, ack_id = p.id, bins = bins })
end
func _handle_packet(m: MgrState*, p: Packet, bins &: Vector<Bytes>):
c := _find_sock(m, p.nsp)
if c.p == null:
_free_bins(bins)
ret
end
sp := _sock(c)
if p.kind == PKT_CONNECT:
_free_bins(bins)
_on_connect_packet(c, p)
else p.kind == PKT_CONNECT_ERROR:
_free_bins(bins)
sp[0].connected = false
mut why := json.Get(p.data, "message")
if why.len() == 0:
why = p.data
end
sp[0].refused = true
sp[0].refusal = why
_deliver(c, Event { kind = EV_CONNECT_ERROR, nsp = sp[0].nsp, message = why, data = "[]" })
else p.kind == PKT_DISCONNECT:
_free_bins(bins)
sp[0].connected = false
sp[0].id = ""
sp[0].active = false
_fail_pending_acks(sp)
_deliver(c, Event { kind = EV_DISCONNECT, nsp = sp[0].nsp, message = REASON_SERVER_DISCONNECT, data = "[]" })
else p.kind == PKT_EVENT or p.kind == PKT_BINARY_EVENT:
_on_event_packet(c, p, bins)
else p.kind == PKT_ACK or p.kind == PKT_BINARY_ACK:
_resolve_ack(c, p.id, p.data, bins)
else:
_free_bins(bins)
end
end
func _on_socketio_text(m: MgrState*, text: str):
p := DecodePacket(text)
if not p.ok:
_broadcast_lifecycle(m, EV_ERROR, REASON_PARSE_ERROR + ": " + text)
ret
end
if p.attachments > 0 and (p.kind == PKT_BINARY_EVENT or p.kind == PKT_BINARY_ACK):
_free_bins(m[0].recon_bins)
m[0].recon_bins = Vector {} as Vector<Bytes>
m[0].recon_pkt = p
m[0].recon = true
ret
end
mut none := Vector {} as Vector<Bytes>
_handle_packet(m, p, none)
end
func _on_socketio_binary(m: MgrState*, b: Bytes):
if not m[0].recon:
ret
end
m[0].recon_bins.push(NewBytes(b.ptr, b.len))
if m[0].recon_bins.len() < m[0].recon_pkt.attachments:
ret
end
p := m[0].recon_pkt
mut bins := m[0].recon_bins
m[0].recon_bins = Vector {} as Vector<Bytes>
m[0].recon = false
_handle_packet(m, p, bins)
end
func _write_packet(m: MgrState*, text: str, bins: Vector<Bytes>): bool:
if not _engine_write(m, text):
ret false
end
repeat bins.len() in i:
if not _engine_write_bytes(m, bins.get(i)):
ret false
end
end
ret true
end
func _send_connect(m: MgrState*, c: Client):
sp := _sock(c)
sp[0].refused = false
sp[0].refusal = ""
mut payload := ""
if sp[0].pid.len() > 0:
payload = `{"pid":` + json.Str(sp[0].pid) + `,"offset":` + json.Str(sp[0].last_offset) + "}"
else sp[0].auth.len() > 0:
payload = sp[0].auth
end
p := Packet { kind = PKT_CONNECT, nsp = sp[0].nsp, data = payload }
_engine_write(m, EncodeEngine(EIO_MESSAGE, EncodePacket(p)))
end
func _flush_outbuf(c: Client):
sp := _sock(c)
m := sp[0].mgr as MgrState*
if sp[0].outbuf.len() == 0:
ret
end
mut pending := sp[0].outbuf
sp[0].outbuf = Vector {} as Vector<Outgoing>
m[0].batching = true
repeat pending.len() in i:
mut o := pending.get(i)
_write_packet(m, o.text, o.bins)
_free_bins(o.bins)
end
m[0].batching = false
pending.free()
_poll_flush(m)
end
func _reconnect_namespaces(m: MgrState*):
repeat m[0].socks.len() in i:
c := m[0].socks.get(i)
if _sock(c)[0].active:
_send_connect(m, c)
end
end
end
func _engine_shutdown(m: MgrState*, reason: str):
if m[0].state == ST_CLOSED:
ret
end
_engine_close(m)
m[0].last_error = reason
mut wants_more := false
repeat m[0].socks.len() in i:
c := m[0].socks.get(i)
sp := _sock(c)
was := sp[0].connected
sp[0].connected = false
sp[0].id = ""
if sp[0].active:
wants_more = true
end
if was:
_fail_pending_acks(sp)
_deliver(c, Event { kind = EV_DISCONNECT, nsp = sp[0].nsp, message = reason, data = "[]" })
end
end
if m[0].opts.reconnection and wants_more:
m[0].state = ST_WAITING
m[0].retry_at = time.MonoMillis() + _backoff(m)
end
end
func _backoff(m: MgrState*): i64:
cap := m[0].opts.reconnection_delay_max as i64
mut d := m[0].opts.reconnection_delay as i64
if d < 1:
d = 1
end
mut i := 0
until i < m[0].attempts and d < cap:
d *= 2
i++
end
if d > cap:
d = cap
end
spread := (d * (m[0].opts.randomization_factor as i64)) / 100
if spread > 0:
d += rand.Int32Range(0, spread as int) as i64
end
ret d
end
func _reconnect_step(m: MgrState*, timeout_ms: int): int:
if m[0].state != ST_WAITING:
ret PUMP_CLOSED
end
limit := m[0].opts.reconnection_attempts
if limit > 0 and m[0].attempts >= limit:
m[0].state = ST_CLOSED
_broadcast_lifecycle(m, EV_RECONNECT_FAILED, "gave up after " + m[0].attempts + " attempts")
ret PUMP_CLOSED
end
now := time.MonoMillis()
if now < m[0].retry_at:
mut nap := (m[0].retry_at - now) as int
if timeout_ms >= 0 and nap > timeout_ms:
nap = timeout_ms
end
if nap > 0:
time.Sleep(nap)
end
ret PUMP_TIMEOUT
end
m[0].attempts++
_broadcast_lifecycle(m, EV_RECONNECT_ATTEMPT, "" + m[0].attempts)
if _engine_open(m):
m[0].attempts = 0
_reconnect_namespaces(m)
_broadcast_lifecycle(m, EV_RECONNECT, "")
ret PUMP_OK
end
_broadcast_lifecycle(m, EV_RECONNECT_ERROR, m[0].last_error)
m[0].retry_at = time.MonoMillis() + _backoff(m)
ret PUMP_TIMEOUT
end
func _pump_mgr(m: MgrState*, timeout_ms: int): int:
_expire_acks(m)
if m[0].state == ST_OPEN and _heartbeat_expired(m):
_engine_shutdown(m, REASON_PING_TIMEOUT)
end
if m[0].state != ST_OPEN:
ret _reconnect_step(m, timeout_ms)
end
rc := _transport_read(m, timeout_ms)
if rc == PUMP_CLOSED:
_engine_shutdown(m, REASON_TRANSPORT_CLOSE)
ret PUMP_CLOSED
end
ret rc
end
func _copy_outgoing(text: str, a: Args): Outgoing:
mut o := Outgoing { text = text }
repeat a.bins.len() in i:
b := a.bins.get(i)
o.bins.push(NewBytes(b.ptr, b.len))
end
ret o
end
func _emit_raw(c: Client, kind: int, name: str, a: Args, ack_id0: int, volatile: bool): bool:
sp := _sock(c)
m := sp[0].mgr as MgrState*
mut ack_id := ack_id0
mut retrying := false
if kind == PKT_EVENT and ack_id < 0 and m[0].opts.retries > 0 and m[0].opts.ack_timeout > 0:
ack_id = _next_ack_id(sp)
retrying = true
end
data := ArgsJSON(a, name)
mut p := Packet { kind = kind, nsp = sp[0].nsp, id = ack_id, data = data }
if a.bins.len() > 0:
if kind == PKT_EVENT:
p.kind = PKT_BINARY_EVENT
else:
p.kind = PKT_BINARY_ACK
end
p.attachments = a.bins.len()
end
text := EncodeEngine(EIO_MESSAGE, EncodePacket(p))
if kind == PKT_EVENT:
_notify_outgoing(c, name, data, ack_id0)
end
if retrying:
mut w := AckWaiter { id = ack_id, alive = true, internal = true, has_deadline = true, has_packet = true }
w.deadline = time.MonoMillis() + (m[0].opts.ack_timeout as i64)
w.interval = m[0].opts.ack_timeout
w.retries_left = m[0].opts.retries
w.packet = _copy_outgoing(text, a)
sp[0].waiters.push(w)
end
if not sp[0].connected:
if volatile:
ret false
end
sp[0].outbuf.push(_copy_outgoing(text, a))
ret true
end
ret _write_packet(m, text, a.bins)
end
func _wait_connected(c: Client, deadline: i64): bool:
sp := _sock(c)
m := sp[0].mgr as MgrState*
until not sp[0].connected and not sp[0].refused and time.MonoMillis() < deadline:
left := (deadline - time.MonoMillis()) as int
if left <= 0:
ret sp[0].connected
end
rc := _pump_mgr(m, left)
if rc == PUMP_CLOSED and m[0].state == ST_CLOSED:
ret sp[0].connected
end
end
ret sp[0].connected
end
func _reserved(name: str): bool:
ret str.Contains(RESERVED, "|" + name + "|")
end
func _norm_nsp(nsp: str): str:
mut s := str.Trim(nsp)
if s.len() == 0:
ret "/"
end
if not str.StartsWith(s, "/"):
s = "/" + s
end
ret s
end
func _norm_path(path: str): str:
mut s := str.Trim(path)
if s.len() == 0:
ret "/socket.io"
end
if not str.StartsWith(s, "/"):
s = "/" + s
end
until s.len() > 1 and str.EndsWith(s, "/"):
s = s.substr(0, s.len() - 1)
end
ret s
end
func _connect_timeout(m: MgrState*): int:
if m[0].opts.timeout > 0:
ret m[0].opts.timeout
end
ret 20000
end
func _ack_wait(m: MgrState*, timeout_ms: int): int:
if timeout_ms > 0:
ret timeout_ms
end
if timeout_ms < 0:
ret 0
end
ret m[0].opts.ack_timeout
end
func _next_ack_id(sp: SockState*): int:
id := sp[0].ack_seq
sp[0].ack_seq++
ret id
end
func _register_waiter(sp: SockState*, id: int, timeout_ms: int, has_cb: bool, cb: func (Ack)):
mut w := AckWaiter { id = id, alive = true, has_cb = has_cb, cb = cb }
if timeout_ms > 0:
w.has_deadline = true
w.deadline = time.MonoMillis() + (timeout_ms as i64)
end
sp[0].waiters.push(w)
end
func _free_sock(c: Client):
if c.p == null:
ret
end
sp := _sock(c)
sp[0].handlers.free()
sp[0].any_handlers.free()
sp[0].out_handlers.free()
_free_waiter_packets(sp)
sp[0].waiters.free()
repeat sp[0].outbuf.len() in i:
mut o := sp[0].outbuf.get(i)
_free_bins(o.bins)
end
sp[0].outbuf.free()
repeat sp[0].inbox.len() in i:
mut ev := sp[0].inbox.get(i)
_free_bins(ev.bins)
end
sp[0].inbox.free()
repeat sp[0].results.len() in i:
mut a := sp[0].results.get(i)
_free_bins(a.bins)
end
sp[0].results.free()
mem.Free(c.p)
end
func _any_active(m: MgrState*): bool:
mut any := false
repeat m[0].socks.len() in i:
if _sock(m[0].socks.get(i))[0].active:
any = true
end
end
ret any
end
@en "NewOptions"
@fa "گزینه‌های جدید"
pub func NewOptions(): Options:
ret Options {}
end
@en "NewManager"
@fa "مدیر جدید"
pub func NewManager(url: str, opts: Options): Manager:
mut ep := ParseURL(url)
mut o := opts
o.path = _norm_path(opts.path)
ep.path = o.path
m := _new_mgr(ep, o)
if m.p != null and not ep.ok:
mp := _mgr(m)
mp[0].last_error = "could not read the server URL: " + url
end
ret m
end
@en "Of"
@fa "از"
pub func Of(m: Manager, nsp: str): Client:
if m.p == null:
ret Client {}
end
mp := _mgr(m)
ns := _norm_nsp(nsp)
existing := _find_sock(mp, ns)
if existing.p != null:
ret existing
end
c := _new_sock(m.p, ns)
if c.p == null:
ret c
end
sp := _sock(c)
sp[0].auth = mp[0].opts.auth
sp[0].max_queue = mp[0].opts.event_queue
sp[0].queueing = mp[0].opts.event_queue > 0
mp[0].socks.push(c)
ret c
end
@en "ManagerOf"
@fa "مدیر کلاینت"
pub func ManagerOf(c: Client): Manager:
if c.p == null:
ret Manager {}
end
ret Manager { p = _sock(c)[0].mgr }
end
@en "Dial"
@fa "اتصال"
pub func Dial(url: str): Client:
ret DialWith(url, NewOptions())
end
@en "DialWith"
@fa "اتصال با"
pub func DialWith(url: str, opts: Options): Client:
m := NewManager(url, opts)
if m.p == null:
ret Client {}
end
mp := _mgr(m)
c := Of(m, mp[0].ep.namespace)
if not mp[0].ep.ok:
ret c
end
if mp[0].opts.auto_connect:
Connect(c)
end
ret c
end
@en "Connect"
@fa "وصل شدن"
pub func Connect(c: Client): bool:
if c.p == null:
ret false
end
sp := _sock(c)
m := sp[0].mgr as MgrState*
sp[0].active = true
if sp[0].connected:
ret true
end
if not m[0].ep.ok:
_deliver(c, Event { kind = EV_CONNECT_ERROR, nsp = sp[0].nsp, message = m[0].last_error, data = "[]" })
ret false
end
if m[0].state != ST_OPEN:
if not _engine_open(m):
if m[0].opts.reconnection:
m[0].state = ST_WAITING
m[0].retry_at = time.MonoMillis() + _backoff(m)
end
_deliver(c, Event { kind = EV_CONNECT_ERROR, nsp = sp[0].nsp, message = m[0].last_error, data = "[]" })
ret false
end
m[0].attempts = 0
end
_send_connect(m, c)
ret _wait_connected(c, time.MonoMillis() + (_connect_timeout(m) as i64))
end
@en "Disconnect"
@fa "قطع اتصال"
pub func Disconnect(c: Client):
if c.p == null:
ret
end
sp := _sock(c)
m := sp[0].mgr as MgrState*
sp[0].active = false
if sp[0].connected:
p := Packet { kind = PKT_DISCONNECT, nsp = sp[0].nsp }
_engine_write(m, EncodeEngine(EIO_MESSAGE, EncodePacket(p)))
sp[0].connected = false
sp[0].id = ""
_fail_pending_acks(sp)
_deliver(c, Event { kind = EV_DISCONNECT, nsp = sp[0].nsp, message = REASON_CLIENT_DISCONNECT, data = "[]" })
end
if not _any_active(m):
_engine_close(m)
m[0].state = ST_CLOSED
end
end
@en "CloseManager"
@fa "بستن مدیر"
pub func CloseManager(m: Manager):
if m.p == null:
ret
end
mp := _mgr(m)
if mp[0].dispatching > 0:
repeat mp[0].socks.len() in i:
Disconnect(mp[0].socks.get(i))
end
ret
end
repeat mp[0].socks.len() in i:
Disconnect(mp[0].socks.get(i))
end
_engine_close(mp)
repeat mp[0].socks.len() in i:
_free_sock(mp[0].socks.get(i))
end
mp[0].socks.free()
mp[0].cookies.free()
mp[0].pollout.free()
_free_bins(mp[0].recon_bins)
mem.Free(m.p)
end
@en "Close"
@fa "بستن"
pub func Close(c: Client):
if c.p == null:
ret
end
m := ManagerOf(c)
mp := _mgr(m)
Disconnect(c)
if mp[0].dispatching > 0:
ret
end
if mp[0].socks.len() <= 1:
CloseManager(m)
ret
end
mut kept := Vector {} as Vector<Client>
repeat mp[0].socks.len() in i:
other := mp[0].socks.get(i)
if other.p != c.p:
kept.push(other)
end
end
mp[0].socks.free()
mp[0].socks = kept
_free_sock(c)
end
@en "Pump"
@fa "پمپ"
pub func Pump(c: Client, timeout_ms: int): int:
if c.p == null:
ret PUMP_CLOSED
end
ret _pump_mgr(_mgr_of(c), timeout_ms)
end
@en "PumpManager"
@fa "پمپ مدیر"
pub func PumpManager(m: Manager, timeout_ms: int): int:
if m.p == null:
ret PUMP_CLOSED
end
ret _pump_mgr(_mgr(m), timeout_ms)
end
@en "Next"
@fa "بعدی"
pub func Next(c: Client, timeout_ms: int): Event:
if c.p == null:
ret Event { kind = EV_TIMEOUT }
end
sp := _sock(c)
m := sp[0].mgr as MgrState*
if sp[0].max_queue <= 0:
sp[0].max_queue = 256
end
sp[0].queueing = true
deadline := time.MonoMillis() + (timeout_ms as i64)
mut out := Event { kind = EV_TIMEOUT, nsp = sp[0].nsp, client = c }
mut going := true
mut finished := false
until going:
if sp[0].inbox.len() > 0:
out = sp[0].inbox.get(0)
sp[0].inbox.remove_at(0)
going = false
else finished:
going = false
else:
mut left := (deadline - time.MonoMillis()) as int
if timeout_ms < 0:
left = 0 - 1
else left <= 0:
going = false
end
if going:
rc := _pump_mgr(m, left)
if rc == PUMP_CLOSED and m[0].state == ST_CLOSED:
finished = true
end
end
end
end
ret out
end
@en "NextEvent"
@fa "رویداد بعدی"
pub func NextEvent(c: Client, timeout_ms: int): Event:
if c.p == null:
ret Event { kind = EV_TIMEOUT }
end
sp := _sock(c)
m := sp[0].mgr as MgrState*
deadline := time.MonoMillis() + (timeout_ms as i64)
mut out := Event { kind = EV_TIMEOUT, nsp = sp[0].nsp, client = c }
mut going := true
until going:
mut left := 0 - 1
if timeout_ms >= 0:
left = (deadline - time.MonoMillis()) as int
if left <= 0:
going = false
end
end
if going:
mut ev := Next(c, left)
if ev.kind == EV_EVENT or ev.kind == EV_TIMEOUT:
out = ev
going = false
else ev.kind == EV_DISCONNECT and (not sp[0].active or m[0].state == ST_CLOSED):
out = ev
going = false
else:
EventFree(ev)
end
end
end
ret out
end
@en "Run"
@fa "اجرا"
pub func Run(c: Client):
if c.p == null:
ret
end
sp := _sock(c)
m := sp[0].mgr as MgrState*
until sp[0].active and m[0].state != ST_CLOSED:
_pump_mgr(m, 1000)
end
end
@en "RunFor"
@fa "اجرا برای"
pub func RunFor(c: Client, ms: int):
if c.p == null:
ret
end
sp := _sock(c)
m := sp[0].mgr as MgrState*
deadline := time.MonoMillis() + (ms as i64)
until sp[0].active and m[0].state != ST_CLOSED and time.MonoMillis() < deadline:
mut left := (deadline - time.MonoMillis()) as int
if left > 250:
left = 250
end
if left <= 0:
ret
end
_pump_mgr(m, left)
end
end
@en "On"
@fa "روی"
pub func On(c: Client, name: str, cb: func (Event)):
if c.p == null:
ret
end
sp := _sock(c)
sp[0].handlers.push(Handler { name = name, cb = cb })
end
@en "Once"
@fa "یک‌بار"
pub func Once(c: Client, name: str, cb: func (Event)):
if c.p == null:
ret
end
sp := _sock(c)
sp[0].handlers.push(Handler { name = name, once = true, cb = cb })
end
@en "Off"
@fa "خاموش"
pub func Off(c: Client, name: str):
if c.p == null:
ret
end
sp := _sock(c)
repeat sp[0].handlers.len() in i:
mut h := sp[0].handlers.get(i)
if h.name == name:
h.alive = false
sp[0].handlers.set(i, h)
end
end
_compact_handlers(sp[0].handlers)
end
@en "OffAll"
@fa "خاموش همه"
pub func OffAll(c: Client):
if c.p == null:
ret
end
sp := _sock(c)
sp[0].handlers.free()
sp[0].handlers = Vector {} as Vector<Handler>
sp[0].any_handlers.free()
sp[0].any_handlers = Vector {} as Vector<Handler>
end
@en "OnAny"
@fa "روی دلخواه"
pub func OnAny(c: Client, cb: func (Event)):
if c.p == null:
ret
end
sp := _sock(c)
sp[0].any_handlers.push(Handler { name = "*", cb = cb })
end
@en "OffAny"
@fa "خاموش دلخواه"
pub func OffAny(c: Client):
if c.p == null:
ret
end
sp := _sock(c)
sp[0].any_handlers.free()
sp[0].any_handlers = Vector {} as Vector<Handler>
end
@en "EmitArgs"
@fa "ارسال با آرگومان"
pub func EmitArgs(c: Client, name: str, a: Args): bool:
if c.p == null or _reserved(name):
ret false
end
ret _emit_raw(c, PKT_EVENT, name, a, 0 - 1, false)
end
@en "EmitVolatile"
@fa "ارسال ناپایدار"
pub func EmitVolatile(c: Client, name: str, a: Args): bool:
if c.p == null or _reserved(name):
ret false
end
ret _emit_raw(c, PKT_EVENT, name, a, 0 - 1, true)
end
@en "Emit"
@fa "ارسال"
pub func Emit(c: Client, name: str): bool:
mut a := NewArgs()
defer ArgsFree(a)
ret EmitArgs(c, name, a)
end
@en "EmitStr"
@fa "ارسال رشته"
pub func EmitStr(c: Client, name: str, s: str): bool:
mut a := NewArgs()
defer ArgsFree(a)
AddStr(a, s)
ret EmitArgs(c, name, a)
end
@en "EmitInt"
@fa "ارسال عدد"
pub func EmitInt(c: Client, name: str, n: i64): bool:
