c.p[i] = P256_P[i]
c.n[i] = P256_N[i]
c.r2p[i] = P256_R2[i]
c.r2n[i] = P256_R2N[i]
c.one[i] = P256_ONE_MONT[i]
c.b[i] = P256_B_MONT[i]
c.gx[i] = P256_GX_MONT[i]
c.gy[i] = P256_GY_MONT[i]
end
c.n0p = 1 as u32
c.n0n = P256_N0INV
ret c
