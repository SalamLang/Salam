mut s2 := _zb_read(r, log)
if r.pos < 0:
ret 0 - 1
end
until true:
e1 := d.ftmp[s1] as int
d.wt[cnt] = (e1 & 255) as u8
cnt++
s1 = (e1 >> 16) + _zb_read(r, (e1 >> 8) & 255)
if r.pos < 0:
e2 := d.ftmp[s2] as int
d.wt[cnt] = (e2 & 255) as u8
cnt++
break
end
if cnt >= 255:
ret 0 - 1
end
e2 := d.ftmp[s2] as int
d.wt[cnt] = (e2 & 255) as u8
cnt++
s2 = (e2 >> 16) + _zb_read(r, (e2 >> 8) & 255)
if r.pos < 0:
e3 := d.ftmp[s1] as int
d.wt[cnt] = (e3 & 255) as u8
cnt++
break
end
if cnt >= 255:
ret 0 - 1
end
end
used = 1 + hb
