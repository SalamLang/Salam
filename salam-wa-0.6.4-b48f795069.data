repeat 1548 in v: freq[v] = 0 end
nsel = 0
gs = 0
until gs < nmtf:
mut ge := gs + 49
if ge >= nmtf: ge = nmtf - 1 end
mut best := 0
mut bestc := 1000000000
repeat ng in t:
mut cost := 0
mut x := gs
until x <= ge:
cost += lens[t * 258 + (mtfv[x] as int)]
x++
end
if cost < bestc:
bestc = cost
best = t
end
end
sels[nsel] = best as u8
nsel++
mut x := gs
until x <= ge:
freq[best * 258 + (mtfv[x] as int)]++
x++
end
gs = ge + 1
end
repeat ng in t:
_bz_lengths(lens, t * 258, freq, t * 258, alpha, 17)
end
end
repeat ng in t:
mut mn := 32
mut mx := 0
repeat alpha in v:
if lens[t * 258 + v] > mx: mx = lens[t * 258 + v] end
if lens[t * 258 + v] < mn: mn = lens[t * 258 + v] end
end
mut vec := 0
mut l := mn
until l <= mx:
repeat alpha in v:
if lens[t * 258 + v] == l:
codes[t * 258 + v] = vec
vec++
end
end
vec <<= 1
l++
end
end
_bz_put(w, 24, 0x314159)
_bz_put(w, 24, 0x265359)
_bz_put(w, 16, ((crc >> 16) & (65535 as u32)) as int)
_bz_put(w, 16, (crc & (65535 as u32)) as int)
_bz_put(w, 1, 0)
_bz_put(w, 24, orig)
repeat 16 in a:
mut any := 0
repeat 16 in b:
if inuse[a * 16 + b]: any = 1 end
end
_bz_put(w, 1, any)
end
repeat 16 in a:
mut any := false
repeat 16 in b:
if inuse[a * 16 + b]: any = true end
end
if any:
repeat 16 in b:
if inuse[a * 16 + b]:
_bz_put(w, 1, 1)
else:
_bz_put(w, 1, 0)
end
end
end
end
_bz_put(w, 3, ng)
_bz_put(w, 15, nsel)
mut pos6: int[6]
repeat 6 in t: pos6[t] = t end
repeat nsel in g:
sv := sels[g] as int
