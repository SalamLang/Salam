d.norm[i] = _ZS_LL_DEF[i]
end
else which == 1:
n = 29
log = 5
repeat n in i:
d.norm[i] = _ZS_OF_DEF[i]
end
else:
n = 53
repeat n in i:
d.norm[i] = _ZS_ML_DEF[i]
end
end
if not _zs_build_dt(d, tbl, log, n):
ret 0 - 1
end
ret log
end
func _zs_huf_read(d &: _Zd, p: u8*, n: int): int:
if n < 1:
