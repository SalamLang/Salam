if i == 14: ret 4 end
if i == 15: ret 5 end
if i == 16: ret 12 end
if i == 17: ret 19 end
if i == 18: ret 26 end
if i == 19: ret 33 end
if i == 20: ret 40 end
if i == 21: ret 48 end
if i == 22: ret 41 end
if i == 23: ret 34 end
if i == 24: ret 27 end
if i == 25: ret 20 end
if i == 26: ret 13 end
if i == 27: ret 6 end
if i == 28: ret 7 end
if i == 29: ret 14 end
if i == 30: ret 21 end
if i == 31: ret 28 end
if i == 32: ret 35 end
if i == 33: ret 42 end
if i == 34: ret 49 end
if i == 35: ret 56 end
if i == 36: ret 57 end
if i == 37: ret 50 end
if i == 38: ret 43 end
if i == 39: ret 36 end
if i == 40: ret 29 end
if i == 41: ret 22 end
if i == 42: ret 15 end
if i == 43: ret 23 end
if i == 44: ret 30 end
if i == 45: ret 37 end
if i == 46: ret 44 end
if i == 47: ret 51 end
if i == 48: ret 58 end
if i == 49: ret 59 end
if i == 50: ret 52 end
if i == 51: ret 45 end
if i == 52: ret 38 end
if i == 53: ret 31 end
if i == 54: ret 39 end
if i == 55: ret 46 end
if i == 56: ret 53 end
if i == 57: ret 60 end
if i == 58: ret 61 end
if i == 59: ret 54 end
if i == 60: ret 47 end
if i == 61: ret 55 end
