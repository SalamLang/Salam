@en "binary"
@fa "دودویی"
package binary
import compress
import mem
@en "BinaryOptions"
@fa "گزینه‌های دودویی"
pub struct BinaryOptions:
pub big_endian: bool = false
end
func f64_bits(v: f64): i64:
buf := mem.Allocate(8 as u64)
p := buf as f64*
p[0] = v
q := buf as i64*
bits := q[0]
mem.Free(buf)
ret bits
end
func bits_to_f64(bits: i64): f64:
buf := mem.Allocate(8 as u64)
p := buf as i64*
p[0] = bits
q := buf as f64*
v := q[0]
mem.Free(buf)
ret v
end
func f32_bits(v: f32): int:
buf := mem.Allocate(4 as u64)
p := buf as f32*
p[0] = v
q := buf as u32*
bits := q[0] as int
mem.Free(buf)
ret bits
end
func bits_to_f32(bits: int): f32:
buf := mem.Allocate(4 as u64)
p := buf as u32*
p[0] = bits as u32
q := buf as f32*
v := q[0]
mem.Free(buf)
ret v
end
@en "WriteU8"
@fa "نوشتن طبیعی۸"
pub func WriteU8(b &: compress.ByteBuf, v: int): compress.BufPush(b, v & 255) end
@en "WriteU16BE"
@fa "نوشتن طبیعی۱۶ بزرگ‌انتها"
pub func WriteU16BE(b &: compress.ByteBuf, v: int):
compress.BufPush(b, (v >> 8) & 255)
compress.BufPush(b, v & 255)
end
@en "WriteU16LE"
@fa "نوشتن طبیعی۱۶ کوچک‌انتها"
pub func WriteU16LE(b &: compress.ByteBuf, v: int):
compress.BufPush(b, v & 255)
compress.BufPush(b, (v >> 8) & 255)
end
@en "WriteU32BE"
@fa "نوشتن طبیعی۳۲ بزرگ‌انتها"
pub func WriteU32BE(b &: compress.ByteBuf, v: int): compress.BufPushU32(b, v) end
@en "WriteU32LE"
@fa "نوشتن طبیعی۳۲ کوچک‌انتها"
pub func WriteU32LE(b &: compress.ByteBuf, v: int):
compress.BufPush(b, v & 255)
compress.BufPush(b, (v >> 8) & 255)
compress.BufPush(b, (v >> 16) & 255)
compress.BufPush(b, (v >> 24) & 255)
end
@en "WriteU64BE"
@fa "نوشتن طبیعی۶۴ بزرگ‌انتها"
pub func WriteU64BE(b &: compress.ByteBuf, v: i64):
mut shift := 56
until shift >= 0:
compress.BufPush(b, ((v >> shift) & (255 as i64)) as int)
shift -= 8
end
end
@en "WriteU64LE"
@fa "نوشتن طبیعی۶۴ کوچک‌انتها"
pub func WriteU64LE(b &: compress.ByteBuf, v: i64):
mut shift := 0
until shift <= 56:
compress.BufPush(b, ((v >> shift) & (255 as i64)) as int)
shift += 8
end
end
@en "WriteI16BE"
@fa "نوشتن صحیح۱۶ بزرگ‌انتها"
pub func WriteI16BE(b &: compress.ByteBuf, v: int): WriteU16BE(b, v) end
@en "WriteI16LE"
@fa "نوشتن صحیح۱۶ کوچک‌انتها"
pub func WriteI16LE(b &: compress.ByteBuf, v: int): WriteU16LE(b, v) end
@en "WriteI32BE"
@fa "نوشتن صحیح۳۲ بزرگ‌انتها"
pub func WriteI32BE(b &: compress.ByteBuf, v: int): WriteU32BE(b, v) end
@en "WriteI32LE"
@fa "نوشتن صحیح۳۲ کوچک‌انتها"
pub func WriteI32LE(b &: compress.ByteBuf, v: int): WriteU32LE(b, v) end
@en "WriteI64BE"
@fa "نوشتن صحیح۶۴ بزرگ‌انتها"
pub func WriteI64BE(b &: compress.ByteBuf, v: i64): WriteU64BE(b, v) end
@en "WriteI64LE"
@fa "نوشتن صحیح۶۴ کوچک‌انتها"
pub func WriteI64LE(b &: compress.ByteBuf, v: i64): WriteU64LE(b, v) end
@en "WriteF64"
@fa "نوشتن اعشار۶۴"
pub func WriteF64(b &: compress.ByteBuf, v: f64, big_endian: bool):
bits := f64_bits(v)
if big_endian: WriteU64BE(b, bits) else:
WriteU64LE(b, bits)
end
end
@en "WriteF32"
@fa "نوشتن اعشار۳۲"
pub func WriteF32(b &: compress.ByteBuf, v: f64, big_endian: bool):
bits := f32_bits(v as f32)
if big_endian: WriteU32BE(b, bits) else:
WriteU32LE(b, bits)
end
end
@en "ReadU8"
@fa "خواندن طبیعی۸"
pub func ReadU8(r &: compress.ByteReader): int: ret compress.RdByte(r) end
@en "ReadU16BE"
@fa "خواندن طبیعی۱۶ بزرگ‌انتها"
pub func ReadU16BE(r &: compress.ByteReader): int:
a := compress.RdByte(r)
b := compress.RdByte(r)
ret (a << 8) | b
end
@en "ReadU16LE"
@fa "خواندن طبیعی۱۶ کوچک‌انتها"
pub func ReadU16LE(r &: compress.ByteReader): int:
a := compress.RdByte(r)
b := compress.RdByte(r)
ret (b << 8) | a
end
@en "ReadU32BE"
@fa "خواندن طبیعی۳۲ بزرگ‌انتها"
pub func ReadU32BE(r &: compress.ByteReader): int: ret compress.RdU32(r) end
@en "ReadU32LE"
@fa "خواندن طبیعی۳۲ کوچک‌انتها"
pub func ReadU32LE(r &: compress.ByteReader): int:
a := compress.RdByte(r)
b := compress.RdByte(r)
c := compress.RdByte(r)
d := compress.RdByte(r)
ret (d << 24) | (c << 16) | (b << 8) | a
end
@en "ReadU64BE"
@fa "خواندن طبیعی۶۴ بزرگ‌انتها"
pub func ReadU64BE(r &: compress.ByteReader): i64:
mut out := 0 as i64
mut i := 0
until i < 8:
out = (out << (8 as i64)) | (compress.RdByte(r) as i64)
i += 1
end
ret out
end
@en "ReadU64LE"
@fa "خواندن طبیعی۶۴ کوچک‌انتها"
pub func ReadU64LE(r &: compress.ByteReader): i64:
mut out := 0 as i64
mut shift := 0 as i64
mut i := 0
until i < 8:
out = out | ((compress.RdByte(r) as i64) << shift)
shift += 8 as i64
i += 1
end
ret out
end
@en "ReadI16BE"
@fa "خواندن صحیح۱۶ بزرگ‌انتها"
pub func ReadI16BE(r &: compress.ByteReader): int:
v := ReadU16BE(r)
if v >= 32768: ret v - 65536 end
ret v
end
@en "ReadI16LE"
@fa "خواندن صحیح۱۶ کوچک‌انتها"
pub func ReadI16LE(r &: compress.ByteReader): int:
v := ReadU16LE(r)
if v >= 32768: ret v - 65536 end
ret v
end
@en "ReadI32BE"
@fa "خواندن صحیح۳۲ بزرگ‌انتها"
pub func ReadI32BE(r &: compress.ByteReader): int: ret ReadU32BE(r) end
@en "ReadI32LE"
@fa "خواندن صحیح۳۲ کوچک‌انتها"
pub func ReadI32LE(r &: compress.ByteReader): int: ret ReadU32LE(r) end
@en "ReadI64BE"
@fa "خواندن صحیح۶۴ بزرگ‌انتها"
pub func ReadI64BE(r &: compress.ByteReader): i64: ret ReadU64BE(r) end
@en "ReadI64LE"
@fa "خواندن صحیح۶۴ کوچک‌انتها"
pub func ReadI64LE(r &: compress.ByteReader): i64: ret ReadU64LE(r) end
@en "ReadF64"
@fa "خواندن اعشار۶۴"
pub func ReadF64(r &: compress.ByteReader, big_endian: bool): f64:
mut bits := 0 as i64
if big_endian: bits = ReadU64BE(r) else:
bits = ReadU64LE(r)
end
ret bits_to_f64(bits)
end
@en "ReadF32"
@fa "خواندن اعشار۳۲"
pub func ReadF32(r &: compress.ByteReader, big_endian: bool): f64:
mut bits := 0
if big_endian: bits = ReadU32BE(r) else:
bits = ReadU32LE(r)
end
ret bits_to_f32(bits)
end
@en "csv"
@fa "سی اس وی"
package csv
import str
inline pure func _bp(s: str): i8*: ret (s as void*) as i8* end
inline pure func _ub(bp: i8*, i: int): int:
mut v := bp[i] as int
if v < 0: v = v + 256 end
ret v
end
pure func _needs_quote(field: str): bool:
ret field.find(",") >= 0 or field.find(`"`) >= 0
end
@en "ReadLine"
@fa "خواندن خط"
pub func ReadLine(line: str): Vector<str>:
result := Vector {} as Vector<str> n := line.len()
bp := _bp(line)
mut sb := str.NewBuilder()
defer str.BufFree(sb)
mut i := 0
mut done := false
until done == false:
str.BufReset(sb)
if i < n and _ub(bp, i) == 34:
i += 1
mut in_q := true
until i < n and in_q:
c := _ub(bp, i)
if c == 34:
if i + 1 < n and _ub(bp, i + 1) == 34:
str.BufAppendChar(sb, 34)
i += 2
else:
i += 1
in_q = false
end
else:
str.BufAppendChar(sb, c)
i += 1
end
end
else:
mut at_sep := false
until i < n and at_sep == false:
c := _ub(bp, i)
if c == 44:
at_sep = true
else:
str.BufAppendChar(sb, c)
i += 1
end
end
end
result.push(str.BufStr(sb))
if i < n and _ub(bp, i) == 44:
i += 1
else:
done = true
end
end
ret result
end
@en "WriteLine"
@fa "نوشتن خط"
pub func WriteLine(fields: Vector<str>): str:
mut sb := str.NewBuilder()
defer str.BufFree(sb)
repeat fields.len() in i:
if i > 0:
str.BufAppendChar(sb, 44)
end
f := fields.get(i)
if _needs_quote(f):
str.BufAppendChar(sb, 34)
str.BufAppend(sb, str.Replace(f, `"`, `""`))
str.BufAppendChar(sb, 34)
else:
str.BufAppend(sb, f)
end
end
out := str.BufStr(sb)
ret out
end
package csv
import encoding.value
import mem
import str
import conv
@en "CSVRow"
@fa "ردیف سی اس وی"
pub struct CSVRow:
pub fields: Vector<str> = Vector {}
end
@en "CSVTable"
@fa "جدول سی اس وی"
pub struct CSVTable:
pub rows: Vector<CSVRow> = Vector {}
end
@en "CSVOptions"
@fa "گزینه‌های سی اس وی"
pub struct CSVOptions:
pub header: bool = true
end
func _split_lines(text: str): Vector<str>:
norm := str.Replace(text, "\r\n", "\n")
out := str.Split(norm, "\n")
mem.Free(norm as void*)
ret out
end
func _free_lines(lines &: Vector<str>):
repeat lines.len() in i: mem.Free(lines.get(i) as void*) end
lines.free()
end
func _index_key(i: int): str:
ret "col".concat(conv.FormatInt(i as i64))
end
@en "ReadAll"
@fa "خواندن همه"
pub func ReadAll(text: str): CSVTable:
mut out := CSVTable {}
mut lines := _split_lines(text)
mut i := 0
until i < lines.len():
line := lines.get(i)
i += 1
if line.len() == 0: continue end
mut row := CSVRow {}
row.fields = ReadLine(line)
out.rows.push(row)
end
_free_lines(lines)
ret out
end
@en "FreeTable"
@fa "آزادسازی جدول"
pub func FreeTable(t &: CSVTable):
repeat t.rows.len() in i:
mut r := t.rows.get(i)
repeat r.fields.len() in j: mem.Free(r.fields.get(j) as void*) end
r.fields.free()
end
t.rows.free()
end
@en "WriteAll"
@fa "نوشتن همه"
pub func WriteAll(table: CSVTable): str:
mut sb := str.NewBuilder()
defer str.BufFree(sb)
mut i := 0
until i < table.rows.len():
if i > 0: str.BufAppend(sb, "\r\n") end
str.BufAppend(sb, WriteLine(table.rows.get(i).fields))
i += 1
end
ret str.BufStr(sb)
end
@en "ToValueWith"
@fa "به مقدار سفارشی"
pub func ToValueWith(text: str, opts: CSVOptions): value.Value:
table := ReadAll(text)
mut out := value.NewValueArray()
if table.rows.len() == 0: ret out end
mut headerIdx := 0
mut header := Vector {} as Vector<str>
if opts.header:
header = table.rows.get(0).fields
headerIdx = 1
end
mut i := headerIdx
until i < table.rows.len():
row := table.rows.get(i).fields
mut obj := value.NewValueObject()
mut j := 0
until j < row.len():
mut key := _index_key(j)
if opts.header and j < header.len(): key = header.get(j) end
value.ObjectSet(obj, key, value.ValueString(row.get(j)))
j += 1
end
value.ArrayPush(out, obj)
i += 1
end
ret out
end
@en "ToValue"
@fa "به مقدار"
pub func ToValue(text: str): value.Value:
ret ToValueWith(text, CSVOptions {})
end
@en "FromValueWith"
@fa "از مقدار سفارشی"
pub func FromValueWith(v: value.Value, opts: CSVOptions): str:
mut table := CSVTable {}
n := value.ArrayLen(v)
if n == 0: ret "" end
first := value.ArrayGet(v, 0)
header := value.ObjectKeys(first)
if opts.header:
mut headerRow := CSVRow {}
headerRow.fields = header
table.rows.push(headerRow)
end
mut i := 0
until i < n:
item := value.ArrayGet(v, i)
mut fields := Vector {} as Vector<str>
mut j := 0
until j < header.len():
fields.push(value.AsString(value.ObjectGet(item, header.get(j))))
j += 1
end
mut r := CSVRow {}
r.fields = fields
table.rows.push(r)
i += 1
end
ret WriteAll(table)
end
@en "FromValue"
@fa "از مقدار"
pub func FromValue(v: value.Value): str:
ret FromValueWith(v, CSVOptions {})
end
@en "encerr"
@fa "خطای کدگذاری"
package encerr
@en "KindNone"
@fa "نوع بدون خطا"
pub const KindNone := 0
@en "KindUnexpectedEOF"
@fa "نوع اتمام ناگهانی"
pub const KindUnexpectedEOF := 1
@en "KindUnexpectedToken"
@fa "نوع نشانه نابجا"
pub const KindUnexpectedToken := 2
@en "KindInvalidUTF8"
@fa "نوع یوتی‌اف۸ نامعتبر"
pub const KindInvalidUTF8 := 3
@en "KindInvalidNumber"
@fa "نوع عدد نامعتبر"
pub const KindInvalidNumber := 4
@en "KindDepthExceeded"
@fa "نوع عمق بیش از حد"
pub const KindDepthExceeded := 5
@en "KindTypeMismatch"
@fa "نوع ناهمخوانی"
pub const KindTypeMismatch := 6
@en "KindKeyNotFound"
@fa "نوع کلید یافت نشد"
pub const KindKeyNotFound := 7
@en "KindTrailingData"
@fa "نوع داده اضافی"
pub const KindTrailingData := 8
@en "KindCustom"
@fa "نوع سفارشی"
pub const KindCustom := 99
@en "EncodingError"
@fa "خطای کدگذاری"
pub struct EncodingError:
pub kind: int = KindNone
pub message: str = ""
pub position: int = 0 - 1
end
@en "NoError"
@fa "بدون خطا"
pub func NoError(): EncodingError: ret EncodingError {} end
@en "NewError"
@fa "خطای جدید"
pub func NewError(kind: int, message: str, position: int): EncodingError:
ret EncodingError { kind = kind, message = message, position = position }
end
@en "ErrUnexpectedEOF"
@fa "خطای اتمام ناگهانی"
pub func ErrUnexpectedEOF(position: int): EncodingError:
ret NewError(KindUnexpectedEOF, "unexpected end of input", position)
end
@en "ErrUnexpectedToken"
@fa "خطای نشانه نابجا"
pub func ErrUnexpectedToken(message: str, position: int): EncodingError:
ret NewError(KindUnexpectedToken, message, position)
end
@en "ErrTypeMismatch"
@fa "خطای ناهمخوانی"
pub func ErrTypeMismatch(expected: str, position: int): EncodingError:
ret NewError(KindTypeMismatch, "expected ".concat(expected), position)
end
@en "IsError"
@fa "خطا است"
pub func IsError(e: EncodingError): bool: ret e.kind != KindNone end
@en "encoding"
@fa "کدگذاری"
package encoding
import str
inline pure func _bp(s: str): i8*: ret (s as void*) as i8* end
inline pure func _ub(bp: i8*, i: int): int:
mut v := bp[i] as int
if v < 0: v = v + 256 end
ret v
end
pure func _b64val(code: int): int:
if code >= 65 and code <= 90: ret code - 65
else code >= 97 and code <= 122: ret code - 71
else code >= 48 and code <= 57: ret code + 4
else code == 43: ret 62
else code == 47: ret 63
else:
ret 0 - 1
end
end
pure func _hexval(code: int): int:
if code >= 48 and code <= 57: ret code - 48
else code >= 97 and code <= 102: ret code - 87
else code >= 65 and code <= 70: ret code - 55
else:
ret 0 - 1
end
end
pure func _url_safe(code: int): bool:
if code >= 65 and code <= 90: ret true
else code >= 97 and code <= 122: ret true
else code >= 48 and code <= 57: ret true
else code == 45 or code == 95 or code == 46 or code == 126: ret true
else:
ret false
end
end
func _b64_encode_bytes(p: void*, n: int): str:
alpha := "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
ap := _bp(alpha)
dp := p as i8*
mut sb := str.NewBuilder()
defer str.BufFree(sb)
mut i := 0
until i < n:
b0 := _ub(dp, i)
mut b1 := 0
mut b2 := 0
if i + 1 < n: b1 = _ub(dp, i + 1) end
if i + 2 < n: b2 = _ub(dp, i + 2) end
str.BufAppendChar(sb, _ub(ap, b0 / 4))
str.BufAppendChar(sb, _ub(ap, (b0 % 4) * 16 + b1 / 16))
if i + 1 < n:
str.BufAppendChar(sb, _ub(ap, (b1 % 16) * 4 + b2 / 64))
else:
str.BufAppendChar(sb, 61)
end
if i + 2 < n:
str.BufAppendChar(sb, _ub(ap, b2 % 64))
else:
str.BufAppendChar(sb, 61)
end
i += 3
end
out := str.BufStr(sb)
ret out
end
@en "Base64Encode"
@fa "کدگذاری پایه۶۴"
pub func Base64Encode(data: str): str:
ret _b64_encode_bytes(data as void*, data.len())
end
@en "Base64EncodeBytes"
@fa "کدگذاری بایت‌ها پایه۶۴"
pub func Base64EncodeBytes(data: void*, n: int): str:
ret _b64_encode_bytes(data, n)
end
@en "Base64Decode"
@fa "کدگشایی پایه۶۴"
pub func Base64Decode(s: str): str:
n := s.len()
bp := _bp(s)
mut sb := str.NewBuilder()
defer str.BufFree(sb)
mut qi := 0
mut q0 := 0
mut q1 := 0
mut q2 := 0
mut i := 0
until i < n:
code := _ub(bp, i)
i += 1
if code != 32 and code != 9 and code != 10 and code != 13:
v := _b64val(code)
if v >= 0:
if qi == 0:
q0 = v
qi = 1
else qi == 1:
q1 = v
qi = 2
else qi == 2:
q2 = v
qi = 3
else:
str.BufAppendChar(sb, q0 * 4 + q1 / 16)
str.BufAppendChar(sb, (q1 % 16) * 16 + q2 / 4)
str.BufAppendChar(sb, (q2 % 4) * 64 + v)
qi = 0
end
end
end
end
if qi >= 2:
str.BufAppendChar(sb, q0 * 4 + q1 / 16)
end
if qi >= 3:
str.BufAppendChar(sb, (q1 % 16) * 16 + q2 / 4)
end
out := str.BufStr(sb)
ret out
end
@en "HexEncode"
@fa "کدگذاری شانزده"
pub func HexEncode(data: str): str:
digits := "0123456789abcdef"
hp := _bp(digits)
dp := _bp(data)
n := data.len()
mut sb := str.NewBuilder()
defer str.BufFree(sb)
repeat n in i:
b := _ub(dp, i)
str.BufAppendChar(sb, _ub(hp, b / 16))
str.BufAppendChar(sb, _ub(hp, b % 16))
end
out := str.BufStr(sb)
ret out
end
@en "HexVal"
@fa "مقدار شانزده"
pub inline pure func HexVal(c: str): int: ret _hexval(char_code(c)) end
@en "HexDecode"
@fa "کدگشایی شانزده"
pub func HexDecode(s: str): str:
n := s.len()
bp := _bp(s)
mut sb := str.NewBuilder()
defer str.BufFree(sb)
mut i := 0
until i + 1 < n:
hi := _hexval(_ub(bp, i))
lo := _hexval(_ub(bp, i + 1))
if hi < 0 or lo < 0:
out0 := str.BufStr(sb)
ret out0
end
str.BufAppendChar(sb, hi * 16 + lo)
i += 2
end
out := str.BufStr(sb)
ret out
end
@en "URLEncode"
@fa "کدگذاری نشانی"
pub func URLEncode(s: str): str:
digits := "0123456789ABCDEF"
hp := _bp(digits)
bp := _bp(s)
n := s.len()
mut sb := str.NewBuilder()
defer str.BufFree(sb)
repeat n in i:
code := _ub(bp, i)
if _url_safe(code):
str.BufAppendChar(sb, code)
else:
str.BufAppendChar(sb, 37)
str.BufAppendChar(sb, _ub(hp, code / 16))
str.BufAppendChar(sb, _ub(hp, code % 16))
end
end
out := str.BufStr(sb)
ret out
end
@en "URLDecode"
@fa "کدگشایی نشانی"
pub func URLDecode(s: str): str:
n := s.len()
bp := _bp(s)
mut sb := str.NewBuilder()
defer str.BufFree(sb)
mut i := 0
until i < n:
code := _ub(bp, i)
if code == 37 and i + 2 < n:
hi := _hexval(_ub(bp, i + 1))
lo := _hexval(_ub(bp, i + 2))
if hi >= 0 and lo >= 0:
str.BufAppendChar(sb, hi * 16 + lo)
i += 3
else:
str.BufAppendChar(sb, code)
i += 1
end
else:
if code == 43:
str.BufAppendChar(sb, 32)
else:
str.BufAppendChar(sb, code)
end
i += 1
end
end
out := str.BufStr(sb)
ret out
end
@en "Base64DecodeStrict"
@fa "کدگشایی پایه۶۴ سخت گیرانه"
pub func Base64DecodeStrict(s: str, ok &: bool): str:
ok = true
n := s.len()
bp := _bp(s)
mut sb := str.NewBuilder()
defer str.BufFree(sb)
mut acc := 0
mut nbits := 0
mut pad := 0
mut ndigits := 0
mut i := 0
until i < n:
code := _ub(bp, i)
i += 1
if code == 32 or code == 9 or code == 10 or code == 13:
continue
end
if code == 61:
pad += 1
if pad > 2:
ok = false
ret ""
end
continue
end
if pad > 0:
ok = false
ret ""
end
v := _b64val(code)
if v < 0:
ok = false
ret ""
end
ndigits += 1
acc = acc * 64 + v
nbits += 6
if nbits >= 8:
nbits -= 8
mut shift := 1
repeat nbits:
shift = shift * 2
end
str.BufAppendChar(sb, (acc / shift) % 256)
acc = acc % shift
end
end
if (ndigits + pad) % 4 != 0:
ok = false
ret ""
end
out := str.BufStr(sb)
ret out
end
@en "Base64DecodeBytes"
@fa "کدگشایی پایه۶۴ به بایت"
pub func Base64DecodeBytes(s: str, out: void*, cap: int, ok &: bool): int:
ok = true
n := s.len()
bp := _bp(s)
op := out as u8*
mut written := 0
mut acc := 0
mut nbits := 0
mut pad := 0
mut ndigits := 0
mut i := 0
until i < n:
code := _ub(bp, i)
i += 1
if code == 32 or code == 9 or code == 10 or code == 13:
continue
end
if code == 61:
pad += 1
if pad > 2:
ok = false
ret 0
end
continue
end
if pad > 0:
ok = false
ret 0
end
v := _b64val(code)
if v < 0:
ok = false
ret 0
end
ndigits += 1
acc = acc * 64 + v
nbits += 6
if nbits >= 8:
nbits -= 8
mut shift := 1
repeat nbits:
shift = shift * 2
end
if written >= cap:
ok = false
ret 0
end
op[written] = ((acc / shift) % 256) as u8
written += 1
acc = acc % shift
end
end
if (ndigits + pad) % 4 != 0:
ok = false
ret 0
end
ret written
end
@en "envfile"
@fa "پرونده محیط"
package envfile
import collections
const _LITERAL := 0
const _EXPANDABLE := 1
@en "Doc"
@fa "سند"
pub struct Doc:
pub m: collections.OrderedMap = collections.OrderedMap {}
pub flags: Vector<int> = Vector {}
end
inline pure func _bp(s: str): i8*: ret (s as void*) as i8* end
inline pure func _ub(bp: i8*, i: int): int:
mut v := bp[i] as int
if v < 0: v = v + 256 end
ret v
end
func _push(d &: Doc, key: str, val: str, flag: int):
i := d.m.set(key, val)
if i == d.flags.len():
d.flags.push(flag)
else:
d.flags.set(i, flag)
end
end
@en "New"
@fa "جدید"
pub func New(): Doc:
ret Doc {}
end
@en "Len"
@fa "طول"
pub func Len(d &: Doc): int: ret d.m.len() end
@en "Has"
@fa "دارد"
pub func Has(d &: Doc, key: str): bool: ret d.m.has(key) end
@en "Get"
@fa "دریافت"
pub func Get(d &: Doc, key: str): str: ret d.m.get(key) end
@en "GetOr"
@fa "دریافت با پیش فرض"
pub func GetOr(d &: Doc, key: str, def: str): str: ret d.m.get_or(key, def) end
@en "Set"
@fa "تنظیم"
pub func Set(d &: Doc, key: str, val: str):
_push(d, key, val, _LITERAL)
end
@en "Remove"
@fa "حذف"
pub func Remove(d &: Doc, key: str): bool:
i := d.m.remove(key)
if i < 0: ret false end
d.flags.remove_at(i)
ret true
end
@en "KeyAt"
@fa "کلید در"
pub func KeyAt(d &: Doc, i: int): str: ret d.m.key_at(i) end
@en "ValueAt"
@fa "مقدار در"
pub func ValueAt(d &: Doc, i: int): str: ret d.m.val_at(i) end
@en "Keys"
@fa "کلیدها"
pub func Keys(d &: Doc): Vector<str>:
ret d.m.clone_keys()
end
@en "MergeInto"
@fa "ادغام در"
pub func MergeInto(dst &: Doc, src &: Doc):
repeat src.m.len() in i:
_push(dst, src.m.key_at(i), src.m.val_at(i), src.flags.get(i))
end
end
@en "Free"
@fa "آزادسازی"
pub func Free(d &: Doc):
d.m.free()
d.flags.free()
end
package envfile
import str
import collections
struct _DR:
pub name: str = ""
pub def: str = ""
pub has_def: bool = false
pub colon: bool = false
pub next: int = 0
pub ok: bool = false
end
func _is_var_char(c: int): bool:
if c >= 48 and c <= 57: ret true end
if c >= 65 and c <= 90: ret true end
if c >= 97 and c <= 122: ret true end
ret c == 95
end
func _read_var(s: str, i: int, dotted: bool, endpos &: int): str:
n := s.len()
bp := _bp(s)
endpos = i
if i >= n: ret "" end
first := _ub(bp, i)
if _is_var_char(first) == false or (first >= 48 and first <= 57): ret "" end
mut p := i
until p < n:
c := _ub(bp, p)
mut good := _is_var_char(c)
if dotted and c == 46: good = true end
if good == false: break end
p += 1
end
endpos = p
ret s.substr(i, p - i)
end
func _ref_braced(s: str, i: int): _DR:
n := s.len()
bp := _bp(s)
mut p := 0
name := _read_var(s, i + 2, true, p)
if name.len() == 0: ret _DR { next = i + 1 } end
mut colon := false
mut has_def := false
mut defval := ""
if p < n and _ub(bp, p) == 58:
colon = true
p += 1
end
if p < n and _ub(bp, p) == 45:
p += 1
start := p
until p < n and _ub(bp, p) != 125:
p += 1
end
defval = s.substr(start, p - start)
has_def = true
end
if p >= n or _ub(bp, p) != 125: ret _DR { next = i + 1 } end
ret _DR { name = name, def = defval, has_def = has_def, colon = colon, next = p + 1, ok = true }
end
func _ref_at(s: str, i: int): _DR:
n := s.len()
if i + 1 >= n: ret _DR { next = i + 1 } end
if _ub(_bp(s), i + 1) == 123: ret _ref_braced(s, i) end
mut p := 0
name := _read_var(s, i + 1, false, p)
if name.len() == 0: ret _DR { next = i + 1 } end
ret _DR { name = name, next = p, ok = true }
end
func _lookup(name: str, d &: Doc, base &: Doc, found &: bool): str:
found = true
i := d.m.index_of(name)
if i >= 0: ret d.m.val_at(i) end
j := base.m.index_of(name)
if j >= 0: ret base.m.val_at(j) end
found = false
ret ""
end
func _resolve(r: _DR, d &: Doc, base &: Doc): str:
mut found := false
v := _lookup(r.name, d, base, found)
if found:
if v.len() > 0: ret v end
if r.colon and r.has_def: ret r.def end
ret v
end
if r.has_def: ret r.def end
ret ""
end
func _expand_one(raw: str, d &: Doc, base &: Doc): str:
n := raw.len()
bp := _bp(raw)
mut sb := str.NewBuilder()
defer str.BufFree(sb)
mut p := 0
until p < n:
c := _ub(bp, p)
if c == 92 and p + 1 < n and _ub(bp, p + 1) == 36:
str.BufAppendChar(sb, 36)
p += 2
continue
end
if c != 36:
str.BufAppendChar(sb, c)
p += 1
continue
end
r := _ref_at(raw, p)
if r.ok == false:
str.BufAppendChar(sb, c)
p += 1
continue
end
str.BufAppend(sb, _resolve(r, d, base))
p = r.next
end
out := str.BufStr(sb)
ret out
end
func _collect_refs(raw: str, out &: Vector<str>):
n := raw.len()
bp := _bp(raw)
mut p := 0
until p < n:
c := _ub(bp, p)
if c == 92 and p + 1 < n and _ub(bp, p + 1) == 36:
p += 2
continue
end
if c != 36:
p += 1
continue
end
r := _ref_at(raw, p)
if r.ok and collections.contains(out, r.name) == false:
out.push(r.name)
end
if r.next > p: p = r.next else:
p = p + 1
end
end
end
@en "ExpandDoc"
@fa "گسترش سند"
pub func ExpandDoc(d &: Doc, base &: Doc): Doc:
mut out := Doc {}
repeat d.m.len() in i:
k := d.m.key_at(i)
v := d.m.val_at(i)
if d.flags.get(i) == _LITERAL:
_push(out, k, v, _LITERAL)
else:
ev := _expand_one(v, out, base)
_push(out, k, ev, _LITERAL)
end
end
ret out
end
@en "Expand"
@fa "گسترش"
pub func Expand(raw: str, d &: Doc, base &: Doc): str:
ret _expand_one(raw, d, base)
end
@en "RefNames"
@fa "نام‌های ارجاع"
pub func RefNames(d &: Doc): Vector<str>:
mut out := Vector {} as Vector<str>
repeat d.m.len() in i:
if d.flags.get(i) == _EXPANDABLE:
_collect_refs(d.m.val_at(i), out)
end
end
ret out
end
@en "RefNamesIn"
@fa "نام‌های ارجاع در"
pub func RefNamesIn(raw: str): Vector<str>:
mut out := Vector {} as Vector<str>
_collect_refs(raw, out)
ret out
end
package envfile
import str
func _special(c: int): bool:
if c == 32 or c == 9 or c == 10 or c == 13: ret true end
ret c == 35 or c == 59 or c == 34 or c == 39 or c == 36 or c == 92
end
func _needs_quotes(v: str): bool:
n := v.len()
if n == 0: ret false end
if str.Trim(v) != v: ret true end
bp := _bp(v)
repeat n in i:
if _special(_ub(bp, i)): ret true end
end
ret false
end
func _escape_dq(v: str): str:
n := v.len()
bp := _bp(v)
mut sb := str.NewBuilder()
defer str.BufFree(sb)
repeat n in i:
c := _ub(bp, i)
if c == 92 or c == 34 or c == 36:
str.BufAppendChar(sb, 92)
str.BufAppendChar(sb, c)
else c == 10:
str.BufAppend(sb, "\\n")
else c == 13:
str.BufAppend(sb, "\\r")
else c == 9:
str.BufAppend(sb, "\\t")
else:
str.BufAppendChar(sb, c)
end
end
out := str.BufStr(sb)
ret out
end
func _format(d &: Doc, prefix: str): str:
mut b := str.NewBuilder()
defer str.BufFree(b)
repeat d.m.len() in i:
str.BufAppend(b, prefix)
str.BufAppend(b, d.m.key_at(i))
str.BufAppend(b, "=")
str.BufAppend(b, Quote(d.m.val_at(i)))
str.BufAppend(b, "\n")
end
out := str.BufStr(b)
ret out
end
@en "Quote"
@fa "نقل قول"
pub func Quote(v: str): str:
if _needs_quotes(v) == false: ret v end
ret `"`.concat(_escape_dq(v)).concat(`"`)
end
@en "Format"
@fa "قالب"
pub func Format(d &: Doc): str:
ret _format(d, "")
end
@en "FormatExport"
@fa "قالب صادراتی"
pub func FormatExport(d &: Doc): str:
ret _format(d, "export ")
end
package envfile
import str
import mem
import encoding.encerr
struct _DV:
pub value: str = ""
pub next: int = 0
pub flag: int = 1
pub ok: bool = true
end
func _slice(s: str, i: int, ln: int): str:
if ln <= 0: ret "" end
p := mem.AllocateZeroed((ln + 1) as u64)
bp := _bp(s)
src := ((bp as u64) + (i as u64)) as void*
mem.Copy(p, src, ln as u64)
ret p as str
end
func _is_hspace(c: int): bool: ret c == 32 or c == 9 end
func _is_eol(c: int): bool: ret c == 10 or c == 13 end
func _is_key_char(c: int): bool:
if c >= 48 and c <= 57: ret true end
if c >= 65 and c <= 90: ret true end
if c >= 97 and c <= 122: ret true end
ret c == 95 or c == 46 or c == 45
end
func _skip_bom(s: str, n: int, i: int): int:
if n < 3: ret i end
bp := _bp(s)
if _ub(bp, 0) == 239 and _ub(bp, 1) == 187 and _ub(bp, 2) == 191: ret i + 3 end
ret i
end
func _skip_hspace(s: str, n: int, i: int): int:
bp := _bp(s)
mut p := i
until p < n and _is_hspace(_ub(bp, p)):
p += 1
end
ret p
end
func _skip_to_eol(s: str, n: int, i: int): int:
bp := _bp(s)
mut p := i
until p < n and _is_eol(_ub(bp, p)) == false:
p += 1
end
if p < n and _ub(bp, p) == 13: p += 1 end
if p < n and _ub(bp, p) == 10: p += 1 end
ret p
end
func _skip_blank(s: str, n: int, i: int): int:
bp := _bp(s)
mut p := i
until p < n:
c := _ub(bp, p)
if _is_hspace(c) or _is_eol(c):
p += 1
else c == 35:
p = _skip_to_eol(s, n, p)
else:
ret p
end
end
ret p
end
func _skip_export(s: str, n: int, i: int): int:
if i + 7 > n: ret i end
bp := _bp(s)
word := "export "
wp := _bp(word)
repeat 7 in k:
if _ub(bp, i + k) != _ub(wp, k): ret i end
end
ret _skip_hspace(s, n, i + 7)
end
func _escape_char(c: int): int:
if c == 110: ret 10 end
if c == 114: ret 13 end
if c == 116: ret 9 end
if c == 98: ret 8 end
if c == 102: ret 12 end
if c == 118: ret 11 end
if c == 92 or c == 34 or c == 39: ret c end
ret 0 - 1
end
func _append_escape(sb &: str.StringBuilder, s: str, p: int): int:
c := _ub(_bp(s), p)
e := _escape_char(c)
if e < 0:
str.BufAppendChar(sb, 92)
str.BufAppendChar(sb, c)
else:
str.BufAppendChar(sb, e)
end
ret p + 1
end
func _read_key(s: str, n: int, i: int): _DV:
bp := _bp(s)
mut p := i
until p < n and _is_key_char(_ub(bp, p)):
p += 1
end
ret _DV { value = _slice(s, i, p - i), next = p, ok = p > i }
end
func _read_quoted(s: str, n: int, i: int, q: int): _DV:
bp := _bp(s)
mut sb := str.NewBuilder()
defer str.BufFree(sb)
mut p := i
mut closed := false
until p < n:
c := _ub(bp, p)
if c == q:
p += 1
closed = true
break
end
if c == 92 and q == 34 and p + 1 < n:
p = _append_escape(sb, s, p + 1)
else:
str.BufAppendChar(sb, c)
p += 1
end
end
out := str.BufStr(sb)
mut flag := _EXPANDABLE
if q == 39: flag = _LITERAL end
ret _DV { value = out, next = _skip_to_eol(s, n, p), flag = flag, ok = closed }
end
func _read_bare(s: str, n: int, i: int, semi: bool): _DV:
bp := _bp(s)
mut p := i
mut cut := i
until p < n:
c := _ub(bp, p)
if _is_eol(c): break end
if (c == 35 or (semi and c == 59)) and p > i and _is_hspace(_ub(bp, p - 1)): break end
p += 1
if _is_hspace(c) == false: cut = p end
end
ret _DV { value = _slice(s, i, cut - i), next = _skip_to_eol(s, n, p), ok = true }
end
func _read_value(s: str, n: int, i: int, semi: bool): _DV:
if i >= n: ret _DV { value = "", next = i, ok = true } end
c := _ub(_bp(s), i)
if c == 34 or c == 39: ret _read_quoted(s, n, i + 1, c) end
if _is_eol(c): ret _DV { value = "", next = _skip_to_eol(s, n, i), ok = true } end
ret _read_bare(s, n, i, semi)
end
func _parse_entry(d &: Doc, s: str, n: int, i: int): _DV:
bp := _bp(s)
k := _read_key(s, n, _skip_export(s, n, i))
p := _skip_hspace(s, n, k.next)
if k.ok == false or p >= n or _ub(bp, p) != 61:
ret _DV { value = "envfile: expected KEY=VALUE", next = _skip_to_eol(s, n, i), ok = false }
end
v := _read_value(s, n, _skip_hspace(s, n, p + 1), false)
if v.ok == false:
ret _DV { value = "envfile: unterminated quoted value", next = v.next, ok = false }
end
_push(d, k.value, v.value, v.flag)
ret _DV { value = "", next = v.next, ok = true }
end
func _parse_into(d &: Doc, text: str, err &: encerr.EncodingError, strict: bool):
n := text.len()
mut p := _skip_bom(text, n, 0)
until p < n:
p = _skip_blank(text, n, p)
if p >= n: ret end
r := _parse_entry(d, text, n, p)
if r.ok == false and strict:
err = encerr.ErrUnexpectedToken(r.value, p)
ret
end
if r.next > p:
p = r.next
else:
p = _skip_to_eol(text, n, p)
end
end
end
@en "ParseRaw"
@fa "تجزیه خام"
pub func ParseRaw(text: str): Doc:
mut out := Doc {}
mut err := encerr.NoError()
_parse_into(out, text, err, false)
ret out
end
@en "Parse"
@fa "تجزیه"
pub func Parse(text: str): Doc:
mut raw := ParseRaw(text)
defer Free(raw)
mut base := Doc {}
defer Free(base)
ret ExpandDoc(raw, base)
end
@en "ParseStrict"
@fa "تجزیه سخت گیرانه"
pub func ParseStrict(text: str, err &: encerr.EncodingError): Doc:
mut raw := Doc {}
err = encerr.NoError()
_parse_into(raw, text, err, true)
defer Free(raw)
mut base := Doc {}
defer Free(base)
ret ExpandDoc(raw, base)
end
@en "Valid"
@fa "معتبر"
pub func Valid(text: str): bool:
mut err := encerr.NoError()
mut d := ParseStrict(text, err)
defer Free(d)
ret encerr.IsError(err) == false
end
@en "ParseScalar"
@fa "تجزیه مقدار"
pub func ParseScalar(raw: str): str:
ret ParseScalarEx(raw, false)
end
@en "ParseScalarEx"
@fa "تجزیه مقدار گسترده"
pub func ParseScalarEx(raw: str, semi: bool): str:
n := raw.len()
v := _read_value(raw, n, _skip_hspace(raw, n, 0), semi)
ret v.value
end
@en "json"
@fa "جیسون"
package json
import conv
import str
inline pure func _bp(s: str): i8*: ret (s as void*) as i8* end
inline pure func _ub(bp: i8*, i: int): int:
mut v := bp[i] as int
if v < 0: v = v + 256 end
ret v
end
pure func _match_at(hp: i8*, hi: int, np: i8*, n: int): bool:
repeat n in k:
if hp[hi + k] != np[k]: ret false end
end
ret true
end
pure func _jws(s: str, i: int): int:
l := str.ByteLen(s)
bp := _bp(s)
mut p := i
until p < l:
code := _ub(bp, p)
if code != 32 and code != 9 and code != 10 and code != 13:
ret p
end
p += 1
end
ret p
end
pure func _jstr(s: str, i: int): int:
l := str.ByteLen(s)
bp := _bp(s)
if i >= l or _ub(bp, i) != 34: ret -1 end
mut p := i + 1
until p < l:
code := _ub(bp, p)
if code == 34: ret p + 1
else code == 92:
p += 1
if p >= l: ret -1 end
end
p += 1
end
ret -1
end
pure func _jnum(s: str, i: int): int:
l := str.ByteLen(s)
bp := _bp(s)
mut p := i
if p < l and _ub(bp, p) == 45: p = p + 1 end
start := p
until p < l:
code := _ub(bp, p)
if code < 48 or code > 57: break end
p += 1
end
if p == start: ret -1 end
if p < l and _ub(bp, p) == 46:
p += 1
until p < l:
code := _ub(bp, p)
if code < 48 or code > 57: break end
p += 1
end
end
if p < l and (_ub(bp, p) == 101 or _ub(bp, p) == 69):
p += 1
if p < l and (_ub(bp, p) == 43 or _ub(bp, p) == 45): p = p + 1 end
until p < l:
code := _ub(bp, p)
if code < 48 or code > 57: break end
p += 1
end
end
ret p
end
pure func _jval(s: str, i: int): int:
p0 := _jws(s, i)
l := str.ByteLen(s)
if p0 >= l: ret -1 end
bp := _bp(s)
c := _ub(bp, p0)
if c == 34: ret _jstr(s, p0)
else c == 123:
mut q := _jws(s, p0 + 1)
if q < l and _ub(bp, q) == 125: ret q + 1 end
until q < l:
q = _jws(s, q)
qk := _jstr(s, q)
if qk < 0: ret -1 end
q = _jws(s, qk)
if q >= l or _ub(bp, q) != 58: ret -1 end
q = _jval(s, q + 1)
if q < 0: ret -1 end
q = _jws(s, q)
if q < l and _ub(bp, q) == 44:
q += 1
continue
end
if q < l and _ub(bp, q) == 125: ret q + 1 end
ret -1
end
else c == 91:
mut q := _jws(s, p0 + 1)
if q < l and _ub(bp, q) == 93: ret q + 1 end
until q < l:
q = _jval(s, q)
if q < 0: ret -1 end
q = _jws(s, q)
if q < l and _ub(bp, q) == 44:
q += 1
continue
end
if q < l and _ub(bp, q) == 93: ret q + 1 end
ret -1
