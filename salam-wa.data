repeat size:
lens.push(0)
end
if compress.BitReadBit(r) == 1:
num := compress.BitReadBit(r) + 1
first8 := compress.BitReadBit(r)
s0 := compress.BitReadBits(r, 1 + 7 * first8)
if s0 < size:
lens.set(s0, 1)
end
if num == 2:
s1 := compress.BitReadBits(r, 8)
if s1 < size:
lens.set(s1, 1)
end
end
c := _wpd_build(lens)
lens.free()
ret c
end
mut clc := Vector {} as Vector<int>
repeat 19:
clc.push(0)
end
num := 4 + compress.BitReadBits(r, 4)
repeat num in k:
clc.set(_WPD_CLC_ORDER[k], compress.BitReadBits(r, 3))
end
lc := _wpd_build(clc)
clc.free()
mut max_symbol := size
if compress.BitReadBit(r) == 1:
nbits := 2 + 2 * compress.BitReadBits(r, 3)
max_symbol = 2 + compress.BitReadBits(r, nbits)
end
mut prev := 8
mut sym := 0
until sym < size and max_symbol > 0 and not r.bad:
max_symbol -= 1
v := _wpd_read(r, lc)
if v < 16:
lens.set(sym, v)
sym += 1
if v != 0:
prev = v
end
else:
mut rep := 0
mut val := 0
if v == 16:
rep = 3 + compress.BitReadBits(r, 2)
val = prev
else v == 17:
rep = 3 + compress.BitReadBits(r, 3)
else:
rep = 11 + compress.BitReadBits(r, 7)
end
if sym + rep > size:
r.bad = true
rep = size - sym
end
repeat rep:
lens.set(sym, val)
sym += 1
end
end
end
c := _wpd_build(lens)
lens.free()
ret c
end
func _wpd_value(r &: compress.BitReader, prefix: int): int:
if prefix < 4:
ret prefix + 1
end
extra := (prefix - 2) >> 1
offset := (2 + (prefix & 1)) << extra
ret offset + compress.BitReadBits(r, extra) + 1
end
func _wpd_argb(a: int, r: int, g: int, b: int): i64:
ret ((a as i64) << 24) | ((r as i64) << 16) | ((g as i64) << 8) | (b as i64)
end
func _wpd_hash(argb: i64, bits: int): int:
ret ((((argb * (0x1e35a7bd as i64)) & (4294967295 as i64)) >> (32 - bits)) as int)
end
func _wpd_pixels(r &: compress.BitReader, xsize: int, ysize: int, main: bool, out &: Vector<i64>):
mut cache_bits := 0
if compress.BitReadBit(r) == 1:
cache_bits = compress.BitReadBits(r, 4)
if cache_bits < 1 or cache_bits > 11:
r.bad = true
ret
end
end
mut prefix_bits := 0
mut entropy := Vector {} as Vector<i64>
mut pw := 0
mut groups := 1
if main and compress.BitReadBit(r) == 1:
prefix_bits = compress.BitReadBits(r, 3) + 2
pw = (xsize + (1 << prefix_bits) - 1) >> prefix_bits
ph := (ysize + (1 << prefix_bits) - 1) >> prefix_bits
_wpd_pixels(r, pw, ph, false, entropy)
repeat entropy.len() in i:
m := ((entropy.get(i) >> 8) & (65535 as i64)) as int
if m + 1 > groups:
groups = m + 1
end
end
end
cache_size := cache_bits > 0 ? 1 << cache_bits : 0
mut codes := Vector {} as Vector<_WpdCode>
repeat groups:
codes.push(_wpd_code(r, 256 + 24 + cache_size))
codes.push(_wpd_code(r, 256))
codes.push(_wpd_code(r, 256))
codes.push(_wpd_code(r, 256))
codes.push(_wpd_code(r, 40))
end
mut cache := Vector {} as Vector<i64>
repeat cache_size:
cache.push(0 as i64)
end
total := xsize * ysize
mut cached := 0
until out.len() < total and not r.bad:
pos := out.len()
mut g := 0
if prefix_bits > 0:
x := pos % xsize
y := pos / xsize
g = ((entropy.get((y >> prefix_bits) * pw + (x >> prefix_bits)) >> 8) & (65535 as i64)) as int
end
base := g * 5
s := _wpd_read(r, codes.get(base))
if s < 256:
red := _wpd_read(r, codes.get(base + 1))
blue := _wpd_read(r, codes.get(base + 2))
alpha := _wpd_read(r, codes.get(base + 3))
out.push(_wpd_argb(alpha, red, s, blue))
else s < 280:
length := _wpd_value(r, s - 256)
