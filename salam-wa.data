c0_13 += v0 * b13
c0_14 += v0 * b14
c0_15 += v0 * b15
v1 := pak[1]
c1_0 += v1 * b0
c1_1 += v1 * b1
c1_2 += v1 * b2
c1_3 += v1 * b3
c1_4 += v1 * b4
c1_5 += v1 * b5
