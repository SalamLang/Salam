end
package autograd
import math
import tensor
func _bk_bmm(tp &: Tape, n &: Node, dc &: tensor.Tensor):
va := Value(tp, n.a)
vb := Value(tp, n.b)
b := va.shape.get(0)
rows := va.shape.get(1)
kn := va.shape.get(2)
m := vb.shape.get(2)
pd := dc.data.data
if tp.needs.get(n.a):
ga := _grad_of(tp, n.a)
repeat b in i:
mut bt := tensor.TransposeRaw(_off(vb.data.data, i * kn * m), kn, m)
tensor.GemmAcc(_off(pd, i * rows * m), bt.data.data, _off(ga.data.data, i * rows * kn), rows, m, kn)
bt.free()
end
end
if tp.needs.get(n.b):
gb := _grad_of(tp, n.b)
repeat b in i:
mut at := tensor.TransposeRaw(_off(va.data.data, i * rows * kn), rows, kn)
tensor.GemmAcc(at.data.data, _off(pd, i * rows * m), _off(gb.data.data, i * kn * m), kn, rows, m)
at.free()
end
end
end
func _bk_permute(tp &: Tape, n &: Node, dc &: tensor.Tensor):
if tp.needs.get(n.a) == false: ret end
perm := Value(tp, n.aux)
r := perm.numel()
mut inv := Vector {} as Vector<int>
inv.zeros(r)
repeat r in i: inv.set(perm.at(i) as int, i) end
mut t := tensor.Permute(dc, inv)
inv.free()
g := _grad_of(tp, n.a)
_bk_flat_add(g.data.data, t.data.data, t.numel())
t.free()
end
func _bk_embed(tp &: Tape, n &: Node, dc &: tensor.Tensor):
if tp.needs.get(n.a) == false: ret end
vw := Value(tp, n.a)
idx := Value(tp, n.aux)
g := _grad_of(tp, n.a)
d := vw.shape.get(1)
cnt := idx.numel()
pg := g.data.data
pd := dc.data.data
pi := idx.data.data
repeat cnt in i:
row := (pi[i] as int) * d
src := i * d
repeat d in k: pg[row + k] = pg[row + k] + pd[src + k] end
end
end
func _outer_inner(t &: tensor.Tensor, axis: int, outer &: int, inner &: int):
outer = 1
repeat axis in i: outer = outer * t.shape.get(i) end
inner = 1
r := t.rank()
repeat r - axis - 1 in i: inner = inner * t.shape.get(axis + 1 + i) end
end
func _bk_narrow(tp &: Tape, n &: Node, dc &: tensor.Tensor):
if tp.needs.get(n.a) == false: ret end
va := Value(tp, n.a)
g := _grad_of(tp, n.a)
axis := n.s0
start := n.s1
cnt := dc.shape.get(axis)
mid := va.shape.get(axis)
mut outer := 1
mut inner := 1
_outer_inner(va, axis, outer, inner)
pg := g.data.data
pd := dc.data.data
block := cnt * inner
repeat outer in o:
gbase := (o * mid + start) * inner
dbase := o * block
repeat block in k: pg[gbase + k] = pg[gbase + k] + pd[dbase + k] end
end
end
func _bk_concat2(tp &: Tape, n &: Node, dc &: tensor.Tensor):
va := Value(tp, n.a)
vb := Value(tp, n.b)
axis := n.s0
ma := va.shape.get(axis)
mb := vb.shape.get(axis)
mut outer := 1
mut inner := 1
_outer_inner(va, axis, outer, inner)
pd := dc.data.data
blocka := ma * inner
blockb := mb * inner
stride := blocka + blockb
if tp.needs.get(n.a):
g := _grad_of(tp, n.a)
pg := g.data.data
repeat outer in o:
repeat blocka in k: pg[o * blocka + k] = pg[o * blocka + k] + pd[o * stride + k] end
end
end
if tp.needs.get(n.b):
g := _grad_of(tp, n.b)
pg := g.data.data
repeat outer in o:
repeat blockb in k: pg[o * blockb + k] = pg[o * blockb + k] + pd[o * stride + blocka + k] end
end
end
end
func _rope_apply(src: f32*, dst: f32*, rows: int, seq: int, heads: int, dh: int, offset: int, theta: f64, sign: f64, accumulate: bool):
half := dh / 2
d := heads * dh
repeat rows in r:
pos := ((r % seq) + offset) as f64
repeat half in i:
freq := math.Pow(theta, 0.0 - (2.0 * (i as f64)) / (dh as f64))
angle := pos * freq * sign
c := math.Cos(angle) as f32
s := math.Sin(angle) as f32
repeat heads in h:
i0 := r * d + h * dh + i
i1 := i0 + half
x0 := src[i0]
x1 := src[i1]
y0 := x0 * c - x1 * s
y1 := x0 * s + x1 * c
if accumulate:
dst[i0] = dst[i0] + y0
dst[i1] = dst[i1] + y1
else:
dst[i0] = y0
dst[i1] = y1
end
end
end
end
end
func _bk_rope(tp &: Tape, n &: Node, dc &: tensor.Tensor):
if tp.needs.get(n.a) == false: ret end
va := Value(tp, n.a)
g := _grad_of(tp, n.a)
seq := n.s0
heads := n.s1
rows := va.shape.get(0)
d := va.numel() / rows
_rope_apply(dc.data.data, g.data.data, rows, seq, heads, d / heads, n.aux, n.f0, 0.0 - 1.0, true)
end
func _bk_dropout(tp &: Tape, n &: Node, dc &: tensor.Tensor):
if tp.needs.get(n.a) == false: ret end
mask := Value(tp, n.aux)
g := _grad_of(tp, n.a)
scale := (1.0 / (1.0 - n.f0)) as f32
cnt := mask.numel()
pg := g.data.data
pd := dc.data.data
pm := mask.data.data
repeat cnt in k: pg[k] = pg[k] + pd[k] * pm[k] * scale end
end
@en "BatchMatMul"
@fa "ضرب ماتریسی دسته‌ای"
pub func BatchMatMul(tp &: Tape, a: int, b: int): int:
va := Value(tp, a)
vb := Value(tp, b)
out := tensor.BatchMatMul(va, vb)
needs_grad := tp.needs.get(a) or tp.needs.get(b)
id := _push_val(tp, out, true, needs_grad)
if needs_grad: _record(tp, _OP_BMM, a, b, id, 0 - 1, 0, 0, 0.0) end
ret id
end
@en "Permute"
@fa "جایگشت"
pub func Permute(tp &: Tape, a: int, perm &: Vector<int>): int:
va := Value(tp, a)
out := tensor.Permute(va, perm)
needs_grad := tp.needs.get(a)
mut aux := 0 - 1
if needs_grad:
r := perm.len()
pt := tensor.Zeros1(r)
pp := pt.data.data
repeat r in i: pp[i] = perm.get(i) as f32 end
aux = _push_val(tp, pt, true, false)
end
id := _push_val(tp, out, true, needs_grad)
if needs_grad: _record(tp, _OP_PERMUTE, a, 0 - 1, id, aux, 0, 0, 0.0) end
ret id
end
@en "Embedding"
@fa "جاسازی"
pub func Embedding(tp &: Tape, weight: int, indices &: Vector<int>): int:
vw := Value(tp, weight)
if vw.rank() != 2: ret _push_val(tp, tensor.Empty(), true, false) end
v := vw.shape.get(0)
d := vw.shape.get(1)
cnt := indices.len()
out := tensor.Zeros2(cnt, d)
it := tensor.Zeros1(cnt)
pw := vw.data.data
po := out.data.data
pi := it.data.data
mut ok := true
repeat cnt in i:
row := indices.get(i)
if row < 0 or row >= v: ok = false end
pi[i] = row as f32
end
if ok == false:
it.free()
out.free()
ret _push_val(tp, tensor.Empty(), true, false)
end
repeat cnt in i:
src := (pi[i] as int) * d
dst := i * d
repeat d in k: po[dst + k] = pw[src + k] end
end
needs_grad := tp.needs.get(weight)
aux := _push_val(tp, it, true, false)
id := _push_val(tp, out, true, needs_grad)
if needs_grad: _record(tp, _OP_EMBED, weight, 0 - 1, id, aux, 0, 0, 0.0) end
ret id
end
@en "Dropout"
@fa "حذف تصادفی"
pub func Dropout(tp &: Tape, a: int, p: f64): int:
if tp.training == false or p <= 0.0: ret a end
if p >= 1.0: ret a end
va := Value(tp, a)
mut mask := tensor.Zeros(va.shape)
tensor.FillBernoulli(mask, 1.0 - p, tp.rng)
out := tensor.Mul(va, mask)
tensor.ScaleInPlace(out, 1.0 / (1.0 - p))
needs_grad := tp.needs.get(a)
aux := _push_val(tp, mask, true, false)
id := _push_val(tp, out, true, needs_grad)
if needs_grad: _record(tp, _OP_DROPOUT, a, 0 - 1, id, aux, 0, 0, p) end
ret id
end
@en "Narrow"
@fa "باریک‌سازی"
pub func Narrow(tp &: Tape, a: int, axis: int, start: int, len: int): int:
va := Value(tp, a)
out := tensor.Narrow(va, axis, start, len)
needs_grad := tp.needs.get(a)
id := _push_val(tp, out, true, needs_grad)
if needs_grad: _record(tp, _OP_NARROW, a, 0 - 1, id, 0 - 1, axis, start, 0.0) end
ret id
end
@en "SliceAxis0"
@fa "برش محور صفر"
pub func SliceAxis0(tp &: Tape, a: int, start: int, len: int): int:
ret Narrow(tp, a, 0, start, len)
end
@en "Concat2"
@fa "پیوند دو"
pub func Concat2(tp &: Tape, a: int, b: int, axis: int): int:
va := Value(tp, a)
vb := Value(tp, b)
out := tensor.Concat2(va, vb, axis)
needs_grad := tp.needs.get(a) or tp.needs.get(b)
id := _push_val(tp, out, true, needs_grad)
if needs_grad: _record(tp, _OP_CONCAT2, a, b, id, 0 - 1, axis, 0, 0.0) end
ret id
end
@en "RoPE"
@fa "جاسازی چرخشی"
pub func RoPE(tp &: Tape, a: int, seq: int, heads: int, offset: int, theta: f64): int:
va := Value(tp, a)
if va.rank() != 2 or seq <= 0 or heads <= 0: ret _push_val(tp, tensor.Empty(), true, false) end
rows := va.shape.get(0)
d := va.shape.get(1)
if d % heads != 0 or (d / heads) % 2 != 0: ret _push_val(tp, tensor.Empty(), true, false) end
out := tensor.Zeros(va.shape)
_rope_apply(va.data.data, out.data.data, rows, seq, heads, d / heads, offset, theta, 1.0, false)
needs_grad := tp.needs.get(a)
id := _push_val(tp, out, true, needs_grad)
if needs_grad: _record(tp, _OP_ROPE, a, 0 - 1, id, offset, seq, heads, theta) end
ret id
end
@en "autograd"
@fa "مشتق‌گیری خودکار"
package autograd
import tensor
const _OP_ADD := 1
const _OP_SUB := 2
const _OP_MUL := 3
const _OP_DIV := 4
const _OP_NEG := 5
const _OP_SCALE := 6
const _OP_ADDS := 7
const _OP_EXP := 8
const _OP_LOG := 9
const _OP_TANH := 10
const _OP_SIGMOID := 11
const _OP_RELU := 12
const _OP_GELU := 13
const _OP_SQRT := 14
const _OP_SQUARE := 15
const _OP_POWS := 16
const _OP_MATMUL := 17
const _OP_SUM := 18
const _OP_MEAN := 19
const _OP_SUMAXIS := 20
const _OP_MEANAXIS := 21
const _OP_SOFTMAX := 22
const _OP_LOGSOFTMAX := 23
const _OP_RESHAPE := 24
const _OP_TRANSPOSE2D := 25
const _OP_CELOSS := 26
const _OP_BCEWL := 27
const _OP_CONV2D := 28
const _OP_MAXPOOL := 29
const _OP_AVGPOOL := 30
const _OP_BMM := 31
const _OP_PERMUTE := 32
const _OP_EMBED := 33
const _OP_DROPOUT := 34
const _OP_LAYERNORM := 35
const _OP_NARROW := 36
const _OP_CONCAT2 := 37
const _OP_SILU := 38
const _OP_ROPE := 39
const _OP_RMSNORM := 40
const _OP_BATCHNORM := 41
const _OP_GROUPNORM := 42
@en "Node"
@fa "گره"
pub struct Node:
pub op: int = 0
pub a: int = 0 - 1
pub b: int = 0 - 1
pub out: int = 0 - 1
pub aux: int = 0 - 1
pub s0: int = 0
pub s1: int = 0
pub f0: f64 = 0.0
end
@en "Tape"
@fa "نوار"
pub struct Tape:
pub vals: Vector<tensor.Tensor> = Vector {}
pub grads: Vector<tensor.Tensor> = Vector {}
pub owns_val: Vector<bool> = Vector {}
pub owns_grad: Vector<bool> = Vector {}
pub needs: Vector<bool> = Vector {}
pub nodes: Vector<Node> = Vector {}
pub training: bool = true
pub rng: tensor.Rng = tensor.Rng {}
@en "len"
@fa "طول"
pub func len(): int: ret this.vals.len() end
@en "reset"
@fa "بازنشانی"
pub func reset():
n := this.vals.len()
repeat n in i:
if this.owns_val.get(i):
mut v := this.vals.get(i)
v.free()
end
if this.owns_grad.get(i):
mut g := this.grads.get(i)
g.free()
end
end
this.vals.clear()
this.grads.clear()
this.owns_val.clear()
this.owns_grad.clear()
this.needs.clear()
this.nodes.clear()
end
@en "free"
@fa "آزادسازی"
pub func free():
this.reset()
this.vals.free()
this.grads.free()
this.owns_val.free()
this.owns_grad.free()
this.needs.free()
this.nodes.free()
end
end
func _alias(t &: tensor.Tensor): tensor.Tensor:
mut h := tensor.Tensor {}
h.data = t.data
h.shape = t.shape
ret h
end
func _push_val(tp &: Tape, t: tensor.Tensor, owned: bool, needs_grad: bool): int:
id := tp.vals.len()
tp.vals.push(t)
tp.grads.push(tensor.Tensor {})
tp.owns_val.push(owned)
tp.owns_grad.push(false)
tp.needs.push(needs_grad)
ret id
end
func _record(tp &: Tape, op: int, a: int, b: int, out: int, aux: int, s0: int, s1: int, f0: f64):
mut n := Node {}
n.op = op
n.a = a
n.b = b
n.out = out
n.aux = aux
n.s0 = s0
n.s1 = s1
n.f0 = f0
tp.nodes.push(n)
end
func _grad_of(tp &: Tape, v: int): tensor.Tensor:
mut g := tp.grads.get(v)
if g.data.len() == 0:
val := tp.vals.get(v)
g = tensor.Zeros(val.shape)
tp.grads.set(v, g)
tp.owns_grad.set(v, true)
end
ret g
end
@en "NewTape"
@fa "نوار جدید"
pub func NewTape(seed: i64): Tape:
mut tp := Tape {}
tp.rng = tensor.NewRng(seed)
ret tp
end
@en "Input"
@fa "ورودی"
pub func Input(tp &: Tape, t &: tensor.Tensor): int:
ret _push_val(tp, _alias(t), false, false)
end
@en "Constant"
@fa "ثابت"
pub func Constant(tp &: Tape, t &: tensor.Tensor): int:
ret _push_val(tp, tensor.Clone(t), true, false)
end
@en "Watch"
@fa "پایش"
pub func Watch(tp &: Tape, t &: tensor.Tensor): int:
ret _push_val(tp, _alias(t), false, true)
end
@en "Param"
@fa "پارامتر"
pub func Param(tp &: Tape, val &: tensor.Tensor, grad &: tensor.Tensor): int:
id := _push_val(tp, _alias(val), false, true)
tp.grads.set(id, _alias(grad))
ret id
end
@en "Value"
@fa "مقدار"
pub func Value(tp &: Tape, v: int): tensor.Tensor:
mut t := tp.vals.get(v)
ret _alias(t)
end
@en "Grad"
@fa "گرادیان"
pub func Grad(tp &: Tape, v: int): tensor.Tensor:
g := _grad_of(tp, v)
ret g
end
@en "Backward"
@fa "پس‌انتشار"
pub func Backward(tp &: Tape, loss: int):
if loss < 0 or loss >= tp.vals.len(): ret end
mut seed := _grad_of(tp, loss)
tensor.SetAll(seed, 1.0)
mut i := tp.nodes.len() - 1
until i >= 0:
n := tp.nodes.get(i)
g := tp.grads.get(n.out)
if g.data.len() > 0:
_backprop_node(tp, n)
end
i -= 1
end
end
@en "GradCheck"
@fa "بررسی گرادیان"
pub func GradCheck(f: func (tensor.Tensor) f64, x &: tensor.Tensor, analytic &: tensor.Tensor, h: f64, tol: f64): bool:
if x.same_shape(analytic) == false: ret false end
hx := _alias(x)
n := x.numel()
mut ok := true
repeat n in k:
orig := x.at(k)
x.set_at(k, orig + h)
fp := f(hx)
x.set_at(k, orig - h)
fm := f(hx)
x.set_at(k, orig)
numeric := (fp - fm) / (2.0 * h)
want := analytic.at(k)
mut diff := numeric - want
if diff < 0.0: diff = 0.0 - diff end
mut scale := 1.0
mut aw := want
if aw < 0.0: aw = 0.0 - aw end
if aw > scale: scale = aw end
if diff > tol * scale: ok = false end
end
ret ok
end
@en "aws"
@fa "ای دبلیو اس"
package aws
@en "SERVICE_S3"
@fa "سرویس اس۳"
pub const SERVICE_S3 := "s3"
@en "ALGORITHM"
@fa "الگوریتم امضا"
pub const ALGORITHM := "AWS4-HMAC-SHA256"
@en "EMPTY_SHA256"
@fa "چکیده بدنه خالی"
pub const EMPTY_SHA256 := "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
@en "UNSIGNED_PAYLOAD"
@fa "بار امضانشده"
pub const UNSIGNED_PAYLOAD := "UNSIGNED-PAYLOAD"
@en "Config"
@fa "پیکربندی"
pub struct Config:
pub endpoint: str = ""
pub region: str = "us-east-1"
pub bucket: str = ""
pub access_key: str = ""
pub secret_key: str = ""
pub session_token: str = ""
pub path_style: bool = true
pub service: str = "s3"
pub expires: int = 900
pub retry: int = 3
pub retry_base_ms: int = 100
pub anonymous: bool = false
pub request_payer: bool = false
pub timeout_ms: int = 0
end
@en "Result"
@fa "نتیجه"
pub struct Result:
pub ok: bool = false
pub status: int = 0
pub body: str = ""
pub etag: str = ""
pub length: i64 = 0
pub error: str = ""
pub head: str = ""
pub code: str = ""
pub request_id: str = ""
pub version_id: str = ""
end
@en "NewConfig"
@fa "پیکربندی جدید"
pub func NewConfig(endpoint: str, bucket: str): Config:
ret Config { endpoint = endpoint, bucket = bucket }
end
@en "WithCredentials"
@fa "با اعتبارنامه"
pub func WithCredentials(cfg: Config, access_key: str, secret_key: str): Config:
mut out := cfg
out.access_key = access_key
out.secret_key = secret_key
ret out
end
@en "Configured"
@fa "پیکربندی شده"
pub func Configured(cfg: Config): bool:
if cfg.endpoint.len() == 0 or cfg.bucket.len() == 0: ret false end
if cfg.anonymous: ret true end
ret cfg.access_key.len() > 0 and cfg.secret_key.len() > 0
end
@en "Failure"
@fa "شکست"
pub func Failure(reason: str): Result:
ret Result { ok = false, error = reason }
end
package aws
import str
import time
import env
import os
import net.httpx
const _IMDS_HOST := "http://169.254.169.254"
const _ECS_HOST := "http://169.254.170.2"
const _IMDS_TIMEOUT_MS := 1000
const _IMDS_TTL := "21600"
@en "SOURCE_ENV"
@fa "منبع محیط"
pub const SOURCE_ENV := "environment"
@en "SOURCE_PROFILE"
@fa "منبع نمایه"
pub const SOURCE_PROFILE := "profile"
@en "SOURCE_WEB_IDENTITY"
@fa "منبع هویت وب"
pub const SOURCE_WEB_IDENTITY := "web-identity"
@en "SOURCE_CONTAINER"
@fa "منبع کانتینر"
pub const SOURCE_CONTAINER := "container"
@en "SOURCE_INSTANCE"
@fa "منبع ماشین"
pub const SOURCE_INSTANCE := "instance"
@en "ChainOptions"
@fa "گزینه‌های زنجیره"
pub struct ChainOptions:
pub use_env: bool = true
pub use_profile: bool = true
pub profile: str = ""
pub use_web_identity: bool = false
pub use_container: bool = false
pub use_instance: bool = false
pub follow_roles: bool = true
pub max_role_depth: int = 4
pub session_name: str = ""
pub duration: int = 0
pub timeout_ms: int = 1000
end
func _http_get(
url: str, path: str, headers: str, method: str, timeout_ms: int, status &: int
): str:
ep := httpx.ParseEndpoint(url)
status = 0
if not ep.ok: ret "" end
head := method + " " + path + " HTTP/1.1\r\nHost: " + ep.host + "\r\n" + headers + "Content-Length: 0\r\nConnection: close\r\n\r\n"
mut raw := httpx.SendRawTimeout(ep, head, null, 0, timeout_ms)
defer httpx.FreeRaw(raw)
status = raw.status
if raw.error.len() > 0: ret "" end
ret httpx.RawText(raw)
end
func _imds_token(timeout_ms: int): str:
mut status := 0
ret _http_get(
_IMDS_HOST, "/latest/api/token", "X-aws-ec2-metadata-token-ttl-seconds: " + _IMDS_TTL + "\r\n",
"PUT", timeout_ms, status
).trim()
end
func _imds_get(token: str, path: str, timeout_ms: int, status &: int): str:
ret _http_get(
_IMDS_HOST, path, "X-aws-ec2-metadata-token: " + token + "\r\n", "GET", timeout_ms, status
)
end
func _creds_from_json(body: str, source: str): Credentials:
if body.len() == 0:
ret Credentials {
error = "no credential document was returned", code = "NoCredentials", source = source
}
end
mut out := Credentials {
access_key = _json_field(body, "AccessKeyId"), secret_key = _json_field(body, "SecretAccessKey"),
session_token = _json_field(body, "Token"), expires = _json_field(body, "Expiration"), source = source
}
if out.session_token.len() == 0:
out.session_token = _json_field(body, "SessionToken")
end
out.expires_epoch = _iso_epoch(out.expires)
if out.access_key.len() == 0 or out.secret_key.len() == 0:
out.error = "the credential document was incomplete"
out.code = "MalformedDocument"
ret out
end
out.ok = true
ret out
end
func _profile_text(path: str): str:
if path.len() == 0 or not os.Exists(path): ret "" end
ret os.ReadFile(path)
end
func _config_value(text: str, profile: str, key: str): str:
direct := ParseIni(text, profile, key)
if direct.len() > 0: ret direct end
ret ParseIni(text, "profile " + profile, key)
end
func _static_from_profile(
creds_text: str, config_text: str, profile: str
): Credentials:
mut out := Credentials {
access_key = ParseIni(creds_text, profile, "aws_access_key_id"), secret_key = ParseIni(creds_text, profile, "aws_secret_access_key"),
session_token = ParseIni(creds_text, profile, "aws_session_token"), source = SOURCE_PROFILE + " " + profile
}
if out.access_key.len() == 0:
out.access_key = _config_value(config_text, profile, "aws_access_key_id")
out.secret_key = _config_value(config_text, profile, "aws_secret_access_key")
out.session_token = _config_value(config_text, profile, "aws_session_token")
end
out.ok = out.access_key.len() > 0 and out.secret_key.len() > 0
if not out.ok:
out.error = "profile '" + profile + "' carries no credentials"
out.code = "NoCredentials"
end
ret out
end
func _resolve_profile(profile: str, o: ChainOptions, depth: int): Credentials:
mut name := profile
if name.len() == 0: name = env.Get("AWS_PROFILE") end
if name.len() == 0: name = "default" end
if depth > o.max_role_depth:
ret Credentials {
error = "the profile chain from '" + name + "' is longer than " + o.max_role_depth + " steps; it is probably a loop",
code = "ProfileLoop", source = SOURCE_PROFILE
}
end
creds_text := _profile_text(CredentialsPath())
config_text := _profile_text(ConfigPath())
role_arn := _config_value(config_text, name, "role_arn")
if role_arn.len() == 0 or not o.follow_roles:
ret _static_from_profile(creds_text, config_text, name)
end
token_file := _config_value(config_text, name, "web_identity_token_file")
mut base := Config { region = _config_value(config_text, name, "region") }
if base.region.len() == 0: base.region = "us-east-1" end
base.timeout_ms = o.timeout_ms
mut session := _config_value(config_text, name, "role_session_name")
if session.len() == 0: session = o.session_name end
if token_file.len() > 0:
if not os.Exists(token_file):
ret Credentials {
error = "the web identity token file '" + token_file + "' named by profile '" + name + "' is not there",
code = "NoCredentials", source = SOURCE_WEB_IDENTITY
}
end
mut got := AssumeRoleWithWebIdentity(
base, role_arn, session, os.ReadFile(token_file).trim(), o.duration
)
got.source = SOURCE_PROFILE + " " + name + " -> " + got.source
ret got
end
source_profile := _config_value(config_text, name, "source_profile")
credential_source := _config_value(config_text, name, "credential_source")
mut start := Credentials {}
if source_profile.len() > 0:
start = _resolve_profile(source_profile, o, depth + 1)
else credential_source.lower() == "ec2instancemetadata":
start = FromInstanceCredentials(o.timeout_ms)
else credential_source.lower() == "ecscontainer":
start = FromContainerCredentials(o.timeout_ms)
else credential_source.lower() == "environment":
start = FromEnvironmentCredentials()
else:
start = _static_from_profile(creds_text, config_text, name)
end
if not start.ok:
if start.code == "ProfileLoop": ret start end
ret Credentials {
error = "profile '" + name + "' names a role but its starting " + "credential could not be found: " + start.error,
code = start.code, source = SOURCE_PROFILE + " " + name
}
end
mut assumed := AssumeRole(Apply(base, start), role_arn, session, o.duration)
assumed.source = SOURCE_PROFILE + " " + name + " -> " + assumed.source
ret assumed
end
@en "FromEnvironmentCredentials"
@fa "اعتبارنامه از محیط"
pub func FromEnvironmentCredentials(): Credentials:
mut out := Credentials {
access_key = env.Get("AWS_ACCESS_KEY_ID"), secret_key = env.Get("AWS_SECRET_ACCESS_KEY"),
session_token = env.Get("AWS_SESSION_TOKEN"), source = SOURCE_ENV
}
out.ok = out.access_key.len() > 0 and out.secret_key.len() > 0
if not out.ok:
out.error = "AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY are not both set"
out.code = "NoCredentials"
end
ret out
end
@en "FromProfileCredentials"
@fa "اعتبارنامه از نمایه"
pub func FromProfileCredentials(profile: str, o: ChainOptions): Credentials:
ret _resolve_profile(profile, o, 0)
end
@en "FromWebIdentityCredentials"
@fa "اعتبارنامه از هویت وب"
pub func FromWebIdentityCredentials(o: ChainOptions): Credentials:
token_file := env.Get("AWS_WEB_IDENTITY_TOKEN_FILE")
role_arn := env.Get("AWS_ROLE_ARN")
if token_file.len() == 0 or role_arn.len() == 0:
ret Credentials {
error = "AWS_WEB_IDENTITY_TOKEN_FILE and AWS_ROLE_ARN are not both set", code = "NoCredentials",
source = SOURCE_WEB_IDENTITY
}
end
if not os.Exists(token_file):
ret Credentials {
error = "the web identity token file '" + token_file + "' is not there", code = "NoCredentials",
source = SOURCE_WEB_IDENTITY
}
end
mut session := env.Get("AWS_ROLE_SESSION_NAME")
if session.len() == 0: session = o.session_name end
mut base := Config { region = env.GetOr("AWS_REGION", "us-east-1") }
base.timeout_ms = o.timeout_ms
ret AssumeRoleWithWebIdentity(
base, role_arn, session, os.ReadFile(token_file).trim(), o.duration
)
end
@en "FromContainerCredentials"
@fa "اعتبارنامه از کانتینر"
pub func FromContainerCredentials(timeout_ms: int): Credentials:
relative := env.Get("AWS_CONTAINER_CREDENTIALS_RELATIVE_URI")
full := env.Get("AWS_CONTAINER_CREDENTIALS_FULL_URI")
if relative.len() == 0 and full.len() == 0:
ret Credentials {
error = "no container credential address is set", code = "NoCredentials", source = SOURCE_CONTAINER
}
end
mut headers := ""
auth := env.Get("AWS_CONTAINER_AUTHORIZATION_TOKEN")
if auth.len() > 0: headers = "Authorization: " + auth + "\r\n" end
mut host := _ECS_HOST
mut path := relative
if relative.len() == 0:
ep := httpx.ParseEndpoint(full)
if not ep.ok:
ret Credentials {
error = "AWS_CONTAINER_CREDENTIALS_FULL_URI could not be parsed", code = "Config", source = SOURCE_CONTAINER
}
end
host = full
slash := str.IndexFrom(full, "/", full.find("://") + 3)
path = "/"
if slash >= 0:
host = full.substr(0, slash)
path = full.substr(slash, full.len() - slash)
end
end
mut status := 0
body := _http_get(host, path, headers, "GET", timeout_ms, status)
if status != 200:
ret Credentials {
error = "the container credential provider answered " + status, code = "NoCredentials", source = SOURCE_CONTAINER
}
end
ret _creds_from_json(body, SOURCE_CONTAINER)
end
@en "FromInstanceCredentials"
@fa "اعتبارنامه از ماشین"
pub func FromInstanceCredentials(timeout_ms: int): Credentials:
mut ms := timeout_ms
if ms <= 0: ms = _IMDS_TIMEOUT_MS end
token := _imds_token(ms)
if token.len() == 0:
ret Credentials {
error = "no instance metadata service answered; this is probably not an EC2 instance", code = "NoCredentials",
source = SOURCE_INSTANCE
}
end
mut status := 0
role := _imds_get(
token, "/latest/meta-data/iam/security-credentials/", ms, status
).trim()
if status != 200 or role.len() == 0:
ret Credentials {
error = "the instance carries no role", code = "NoCredentials", source = SOURCE_INSTANCE
}
end
mut first := role
nl := role.find("\n")
if nl >= 0: first = role.substr(0, nl).trim() end
body := _imds_get(
token, "/latest/meta-data/iam/security-credentials/" + first, ms, status
)
if status != 200:
ret Credentials {
error = "the metadata service answered " + status + " for role " + first, code = "NoCredentials",
source = SOURCE_INSTANCE
}
end
ret _creds_from_json(body, SOURCE_INSTANCE + " " + first)
end
@en "InstanceRegion"
@fa "منطقه ماشین"
pub func InstanceRegion(timeout_ms: int): str:
mut ms := timeout_ms
if ms <= 0: ms = _IMDS_TIMEOUT_MS end
token := _imds_token(ms)
if token.len() == 0: ret "" end
mut status := 0
where := _imds_get(token, "/latest/meta-data/placement/region", ms, status)
if status != 200: ret "" end
ret where.trim()
end
@en "DefaultChain"
@fa "زنجیره پیش‌فرض"
pub func DefaultChain(): ChainOptions:
ret ChainOptions {}
end
@en "ContainerChain"
@fa "زنجیره کانتینر"
pub func ContainerChain(): ChainOptions:
ret ChainOptions {
use_env = true, use_profile = false, use_web_identity = true, use_container = true, use_instance = true
}
end
@en "Resolve"
@fa "یافتن اعتبارنامه"
pub func Resolve(o: ChainOptions): Credentials:
mut last := Credentials {
error = "no credential source was enabled", code = "NoCredentials"
}
if o.use_env:
got := FromEnvironmentCredentials()
if got.ok: ret got end
last = got
end
if o.use_web_identity:
got := FromWebIdentityCredentials(o)
if got.ok: ret got end
last = got
end
if o.use_profile:
got := FromProfileCredentials(o.profile, o)
if got.ok: ret got end
last = got
end
if o.use_container:
got := FromContainerCredentials(o.timeout_ms)
if got.ok: ret got end
last = got
end
if o.use_instance:
got := FromInstanceCredentials(o.timeout_ms)
if got.ok: ret got end
last = got
end
ret last
end
@en "ResolveConfig"
@fa "یافتن پیکربندی"
pub func ResolveConfig(bucket: str, region: str, o: ChainOptions): Config:
creds := Resolve(o)
mut cfg := ForAws(region, bucket)
cfg.timeout_ms = o.timeout_ms
if not creds.ok: ret cfg end
ret Apply(cfg, creds)
end
package aws
import mem
import str
import time
import crypto
import encoding
const _S3_MD5_LEN := 16
const _S3_SHA_LEN := 32
@en "PutOptions"
@fa "گزینه‌های نوشتن"
pub struct PutOptions:
pub content_type: str = ""
pub cache_control: str = ""
pub content_disposition: str = ""
pub content_encoding: str = ""
pub content_language: str = ""
pub expires: str = ""
pub storage_class: str = ""
pub acl: str = ""
pub sse: str = ""
pub sse_kms_key: str = ""
pub tagging: str = ""
pub if_none_match: str = ""
pub if_match: str = ""
pub checksum_md5: bool = false
pub checksum_sha256: bool = false
pub unsigned_payload: bool = false
pub meta: Headers = Headers {}
pub part_size: int = 0
end
@en "GetOptions"
@fa "گزینه‌های خواندن"
pub struct GetOptions:
pub range_start: i64 = -1
pub range_end: i64 = -1
pub version_id: str = ""
pub if_none_match: str = ""
pub if_match: str = ""
pub if_modified_since: str = ""
pub if_unmodified_since: str = ""
pub response_content_type: str = ""
pub response_content_disposition: str = ""
pub part_number: int = 0
end
@en "CopyOptions"
@fa "گزینه‌های رونوشت"
pub struct CopyOptions:
pub source_bucket: str = ""
pub source_version_id: str = ""
pub replace_metadata: bool = false
pub content_type: str = ""
pub cache_control: str = ""
pub content_disposition: str = ""
pub storage_class: str = ""
pub acl: str = ""
pub sse: str = ""
pub tagging: str = ""
pub if_match: str = ""
pub if_none_match: str = ""
pub if_modified_since: str = ""
pub if_unmodified_since: str = ""
pub meta: Headers = Headers {}
end
@en "ObjectInfo"
@fa "اطلاعات شیء"
pub struct ObjectInfo:
pub ok: bool = false
pub status: int = 0
pub key: str = ""
pub size: i64 = 0
pub etag: str = ""
pub content_type: str = ""
pub content_encoding: str = ""
pub cache_control: str = ""
pub content_disposition: str = ""
pub last_modified: str = ""
pub modified_epoch: i64 = 0
pub storage_class: str = ""
pub version_id: str = ""
pub sse: str = ""
pub delete_marker: bool = false
pub parts: int = 0
pub meta: Headers = Headers {}
pub error: str = ""
pub code: str = ""
end
func _range_header(o: GetOptions): str:
if o.range_start < 0 and o.range_end < 0: ret "" end
if o.range_start < 0: ret "bytes=-" + str.FromInt(o.range_end) end
if o.range_end < 0: ret "bytes=" + str.FromInt(o.range_start) + "-" end
ret "bytes=" + str.FromInt(o.range_start) + "-" + str.FromInt(o.range_end)
end
func _content_md5(p: void*, n: int): str:
digest := mem.Allocate(_S3_MD5_LEN as u64)
defer mem.Free(digest)
if digest == null: ret "" end
crypto.Md5Bytes(p, n, digest)
ret encoding.Base64EncodeBytes(digest, _S3_MD5_LEN)
end
func _checksum_sha256(p: void*, n: int): str:
digest := mem.Allocate(_S3_SHA_LEN as u64)
defer mem.Free(digest)
if digest == null: ret "" end
crypto.Sha256Bytes(p, n, digest)
ret encoding.Base64EncodeBytes(digest, _S3_SHA_LEN)
end
func _apply_meta(r &: Request, meta: Headers):
mut i := 0
until i < meta.names.len():
name := meta.names.get(i)
if name.len() > 0:
SetHeader(r, "x-amz-meta-" + name.lower(), meta.values.get(i))
end
i += 1
end
end
func _apply_put(r &: Request, o: PutOptions):
SetHeader(r, "Content-Type", o.content_type)
SetHeader(r, "Cache-Control", o.cache_control)
SetHeader(r, "Content-Disposition", o.content_disposition)
SetHeader(r, "Content-Encoding", o.content_encoding)
SetHeader(r, "Content-Language", o.content_language)
SetHeader(r, "Expires", o.expires)
SetHeader(r, "x-amz-storage-class", o.storage_class)
SetHeader(r, "x-amz-acl", o.acl)
SetHeader(r, "x-amz-server-side-encryption", o.sse)
SetHeader(r, "x-amz-server-side-encryption-aws-kms-key-id", o.sse_kms_key)
SetHeader(r, "x-amz-tagging", o.tagging)
SetHeader(r, "If-None-Match", o.if_none_match)
SetHeader(r, "If-Match", o.if_match)
_apply_meta(r, o.meta)
if o.unsigned_payload: SetUnsignedPayload(r) end
end
func _apply_get(r &: Request, o: GetOptions):
SetHeader(r, "Range", _range_header(o))
SetHeader(r, "If-None-Match", o.if_none_match)
SetHeader(r, "If-Match", o.if_match)
SetHeader(r, "If-Modified-Since", o.if_modified_since)
SetHeader(r, "If-Unmodified-Since", o.if_unmodified_since)
if o.version_id.len() > 0: SetQuery(r, "versionId", o.version_id) end
if o.part_number > 0: SetQueryInt(r, "partNumber", o.part_number) end
if o.response_content_type.len() > 0:
SetQuery(r, "response-content-type", o.response_content_type)
end
if o.response_content_disposition.len() > 0:
SetQuery(r, "response-content-disposition", o.response_content_disposition)
end
end
func _meta_from_head(head: str): Headers:
mut out := Headers {}
lower := head.lower()
mut pos := 0
until true:
at := str.IndexFrom(lower, "\r\nx-amz-meta-", pos)
if at < 0: break end
start := at + 13
colon := str.IndexFrom(head, ":", start)
if colon < 0: break end
mut eol := str.IndexFrom(head, "\r\n", colon)
if eol < 0: eol = head.len() end
HeaderSet(
out, head.substr(start, colon - start), head.substr(colon + 1, eol - colon - 1).trim()
)
pos = eol
end
ret out
end
func _copy_source(cfg: Config, key: str, o: CopyOptions): str:
mut bucket := o.source_bucket
if bucket.len() == 0: bucket = cfg.bucket end
mut src := "/" + bucket + EncodeKey(key)
if o.source_version_id.len() > 0:
src = src + "?versionId=" + UriEncode(o.source_version_id, false)
end
ret src
end
@en "S3PutBytes"
@fa "اس۳ نوشتن بایت"
pub func S3PutBytes(
cfg: Config, key: str, body: void*, n: int, content_type: str
): Result:
ret S3PutBytesWith(cfg, key, body, n, PutOptions { content_type = content_type })
end
@en "S3PutBytesWith"
@fa "اس۳ نوشتن بایت با گزینه"
pub func S3PutBytesWith(
cfg: Config, key: str, body: void*, n: int, o: PutOptions
): Result:
mut r := NewRequest("PUT", key)
SetBody(r, body, n)
_apply_put(r, o)
if o.checksum_md5 and n > 0:
SetHeader(r, "Content-MD5", _content_md5(body, n))
end
if o.checksum_sha256 and n > 0:
SetHeader(r, "x-amz-checksum-sha256", _checksum_sha256(body, n))
end
ret Do(cfg, r)
end
@en "S3Put"
@fa "اس۳ نوشتن"
pub func S3Put(cfg: Config, key: str, body: str, content_type: str): Result:
ret S3PutWith(cfg, key, body, PutOptions { content_type = content_type })
end
@en "S3PutWith"
@fa "اس۳ نوشتن با گزینه"
pub func S3PutWith(cfg: Config, key: str, body: str, o: PutOptions): Result:
if body.len() == 0: ret S3PutBytesWith(cfg, key, null, 0, o) end
ret S3PutBytesWith(cfg, key, body as void*, body.len(), o)
end
@en "S3Get"
@fa "اس۳ خواندن"
pub func S3Get(cfg: Config, key: str): Result:
ret Do(cfg, NewRequest("GET", key))
end
@en "S3GetWith"
@fa "اس۳ خواندن با گزینه"
pub func S3GetWith(cfg: Config, key: str, o: GetOptions): Result:
mut r := NewRequest("GET", key)
_apply_get(r, o)
ret Do(cfg, r)
end
@en "S3GetBytes"
@fa "اس۳ خواندن بایت"
pub func S3GetBytes(cfg: Config, key: str): Bytes:
ret DoBytes(cfg, NewRequest("GET", key))
end
@en "S3GetBytesWith"
@fa "اس۳ خواندن بایت با گزینه"
pub func S3GetBytesWith(cfg: Config, key: str, o: GetOptions): Bytes:
mut r := NewRequest("GET", key)
_apply_get(r, o)
ret DoBytes(cfg, r)
end
@en "S3GetRange"
@fa "اس۳ خواندن بازه"
pub func S3GetRange(cfg: Config, key: str, start: i64, stop: i64): Bytes:
ret S3GetBytesWith(cfg, key, GetOptions { range_start = start, range_end = stop })
end
@en "S3Head"
@fa "اس۳ سرآیند شیء"
pub func S3Head(cfg: Config, key: str): Result:
ret Do(cfg, NewRequest("HEAD", key))
end
@en "S3Stat"
@fa "اس۳ اطلاعات شیء"
pub func S3Stat(cfg: Config, key: str): ObjectInfo:
ret S3StatVersion(cfg, key, "")
end
@en "S3StatVersion"
@fa "اس۳ اطلاعات نسخه"
pub func S3StatVersion(cfg: Config, key: str, version_id: str): ObjectInfo:
mut r := NewRequest("HEAD", key)
if version_id.len() > 0: SetQuery(r, "versionId", version_id) end
res := Do(cfg, r)
mut out := ObjectInfo {
ok = res.ok, status = res.status, key = key, etag = Unquote(res.etag), error = res.error, code = res.code,
version_id = res.version_id
}
if res.head.len() == 0: ret out end
out.content_type = ResultHeader(res, "Content-Type")
out.content_encoding = ResultHeader(res, "Content-Encoding")
out.cache_control = ResultHeader(res, "Cache-Control")
out.content_disposition = ResultHeader(res, "Content-Disposition")
out.last_modified = ResultHeader(res, "Last-Modified")
out.storage_class = ResultHeader(res, "x-amz-storage-class")
out.sse = ResultHeader(res, "x-amz-server-side-encryption")
out.delete_marker = ResultHeader(res, "x-amz-delete-marker") == "true"
out.size = res.length
parts := ResultHeader(res, "x-amz-mp-parts-count")
if parts.len() > 0: out.parts = parts.to_int() end
if out.last_modified.len() > 0:
when := time.ParseHTTPDate(out.last_modified)
if when.ok: out.modified_epoch = when.epoch end
end
out.meta = _meta_from_head(res.head)
ret out
end
@en "S3Delete"
@fa "اس۳ حذف"
pub func S3Delete(cfg: Config, key: str): Result:
ret Do(cfg, NewRequest("DELETE", key))
end
@en "S3DeleteVersion"
@fa "اس۳ حذف نسخه"
pub func S3DeleteVersion(cfg: Config, key: str, version_id: str): Result:
mut r := NewRequest("DELETE", key)
SetQuery(r, "versionId", version_id)
ret Do(cfg, r)
end
@en "S3Exists"
@fa "اس۳ وجود دارد"
pub func S3Exists(cfg: Config, key: str): bool:
ret S3Head(cfg, key).ok
end
@en "S3Size"
@fa "اس۳ اندازه"
pub func S3Size(cfg: Config, key: str): i64:
info := S3Stat(cfg, key)
if not info.ok: ret -1 end
ret info.size
end
@en "S3Copy"
@fa "اس۳ رونوشت"
pub func S3Copy(cfg: Config, src_key: str, dst_key: str): Result:
ret S3CopyWith(cfg, src_key, dst_key, CopyOptions {})
end
@en "S3CopyWith"
@fa "اس۳ رونوشت با گزینه"
pub func S3CopyWith(
cfg: Config, src_key: str, dst_key: str, o: CopyOptions
): Result:
mut r := NewRequest("PUT", dst_key)
SetHeader(r, "x-amz-copy-source", _copy_source(cfg, src_key, o))
SetHeader(r, "x-amz-copy-source-if-match", o.if_match)
SetHeader(r, "x-amz-copy-source-if-none-match", o.if_none_match)
SetHeader(r, "x-amz-copy-source-if-modified-since", o.if_modified_since)
SetHeader(r, "x-amz-copy-source-if-unmodified-since", o.if_unmodified_since)
SetHeader(r, "x-amz-storage-class", o.storage_class)
SetHeader(r, "x-amz-acl", o.acl)
SetHeader(r, "x-amz-server-side-encryption", o.sse)
SetHeader(r, "x-amz-tagging", o.tagging)
if o.replace_metadata:
SetHeader(r, "x-amz-metadata-directive", "REPLACE")
SetHeader(r, "Content-Type", o.content_type)
SetHeader(r, "Cache-Control", o.cache_control)
SetHeader(r, "Content-Disposition", o.content_disposition)
if o.tagging.len() > 0:
SetHeader(r, "x-amz-tagging-directive", "REPLACE")
end
_apply_meta(r, o.meta)
end
res := Do(cfg, r)
if not res.ok: ret res end
if res.body.find("<Error") >= 0 or res.body.find("<Code>") >= 0:
mut bad := res
bad.ok = false
bad.code = ResultErrorCode(res.body)
bad.error = ResultErrorMessage(res.body, res.status)
ret bad
end
ret res
end
@en "S3Move"
@fa "اس۳ جابجایی"
pub func S3Move(cfg: Config, src_key: str, dst_key: str): Result:
copied := S3Copy(cfg, src_key, dst_key)
if not copied.ok: ret copied end
removed := S3Delete(cfg, src_key)
if not removed.ok: ret removed end
ret copied
end
@en "S3Touch"
@fa "اس۳ به‌روزرسانی زمان"
pub func S3Touch(cfg: Config, key: str, o: CopyOptions): Result:
mut opts := o
opts.replace_metadata = true
ret S3CopyWith(cfg, key, key, opts)
end
@en "S3Restore"
@fa "اس۳ بازگردانی از آرشیو"
pub func S3Restore(cfg: Config, key: str, days: int, tier: str): Result:
mut r := NewRequest("POST", key)
SetFlag(r, "restore")
mut t := tier
if t.len() == 0: t = "Standard" end
body := "<RestoreRequest><Days>" + days + "</Days>" + "<GlacierJobParameters><Tier>" + t + "</Tier></GlacierJobParameters>" + "</RestoreRequest>"
SetText(r, body)
SetHeader(r, "Content-Type", "application/xml")
ret Do(cfg, r)
end
@en "S3ContentHash"
@fa "اس۳ چکیده محتوا"
pub func S3ContentHash(body: void*, n: int): str:
ret Sha256Bytes(body, n)
end
@en "S3ContentMd5"
@fa "اس۳ ام دی۵ محتوا"
pub func S3ContentMd5(body: void*, n: int): str:
ret _content_md5(body, n)
end
@en "S3ChecksumSha256"
@fa "اس۳ چکیده شا۲۵۶"
pub func S3ChecksumSha256(body: void*, n: int): str:
ret _checksum_sha256(body, n)
end
@en "S3ObjectChecksum"
@fa "اس۳ چکیده شیء"
pub func S3ObjectChecksum(cfg: Config, key: str): str:
mut r := NewRequest("HEAD", key)
SetHeader(r, "x-amz-checksum-mode", "ENABLED")
res := Do(cfg, r)
if not res.ok: ret "" end
ret ResultHeader(res, "x-amz-checksum-sha256")
end
package aws
import str
import encoding.xml
func _bucket_request(method: str, bucket: str): Request:
if bucket.len() == 0: ret NewRequest(method, "") end
ret NewBucketRequest(method, bucket, "")
end
func _create_body(region: str): str:
if region.len() == 0 or region == "us-east-1": ret "" end
ret "<CreateBucketConfiguration>" + "<LocationConstraint>" + _xml_escape(region) + "</LocationConstraint>" + "</CreateBucketConfiguration>"
end
func _tag_body(tags: Headers): str:
mut sb := str.NewBuilder()
defer str.BufFree(sb)
str.BufAppend(sb, "<Tagging><TagSet>")
mut i := 0
until i < tags.names.len():
str.BufAppend(sb, "<Tag><Key>")
str.BufAppend(sb, _xml_escape(tags.names.get(i)))
str.BufAppend(sb, "</Key><Value>")
str.BufAppend(sb, _xml_escape(tags.values.get(i)))
str.BufAppend(sb, "</Value></Tag>")
i += 1
end
str.BufAppend(sb, "</TagSet></Tagging>")
ret str.BufStr(sb)
end
func _parse_tags(res: Result): Headers:
mut out := Headers {}
if not res.ok: ret out end
mut ok := false
root := xml.DecodeStrict(res.body, ok)
if not ok: ret out end
set := xml.Child(root, "TagSet")
if not xml.Found(set): ret out end
rows := xml.Children(set, "Tag")
mut i := 0
until i < rows.items.len():
node := rows.items.get(i)
HeaderSet(out, _xml_text(node, "Key"), _xml_text(node, "Value"))
i += 1
end
ret out
end
@en "S3CreateBucket"
@fa "اس۳ ساخت سطل"
pub func S3CreateBucket(cfg: Config, bucket: str): Result:
mut r := _bucket_request("PUT", bucket)
body := _create_body(cfg.region)
if body.len() > 0:
SetText(r, body)
SetHeader(r, "Content-Type", "application/xml")
end
ret Do(cfg, r)
end
@en "S3CreateBucketAcl"
@fa "اس۳ ساخت سطل با دسترسی"
pub func S3CreateBucketAcl(cfg: Config, bucket: str, acl: str): Result:
mut r := _bucket_request("PUT", bucket)
SetHeader(r, "x-amz-acl", acl)
body := _create_body(cfg.region)
if body.len() > 0:
SetText(r, body)
SetHeader(r, "Content-Type", "application/xml")
end
ret Do(cfg, r)
end
@en "S3DeleteBucket"
@fa "اس۳ حذف سطل"
pub func S3DeleteBucket(cfg: Config, bucket: str): Result:
ret Do(cfg, _bucket_request("DELETE", bucket))
end
@en "S3HeadBucket"
@fa "اس۳ سرآیند سطل"
pub func S3HeadBucket(cfg: Config, bucket: str): Result:
ret Do(cfg, _bucket_request("HEAD", bucket))
end
@en "S3BucketExists"
@fa "اس۳ سطل وجود دارد"
pub func S3BucketExists(cfg: Config, bucket: str): bool:
ret S3HeadBucket(cfg, bucket).ok
end
@en "S3ListBuckets"
@fa "اس۳ فهرست سطل‌ها"
pub func S3ListBuckets(cfg: Config): BucketList:
res := Do(cfg, NewServiceRequest("GET"))
if not res.ok:
ret BucketList { status = res.status, error = res.error, code = res.code }
end
mut ok := false
root := xml.DecodeStrict(res.body, ok)
if not ok:
ret BucketList {
status = res.status, error = "the bucket listing could not be parsed", code = "MalformedXML"
}
end
mut out := BucketList { ok = true, status = res.status }
owner := xml.Child(root, "Owner")
if xml.Found(owner):
out.owner = _xml_text(owner, "DisplayName")
if out.owner.len() == 0: out.owner = _xml_text(owner, "ID") end
end
holder := xml.Child(root, "Buckets")
if not xml.Found(holder): ret out end
rows := xml.Children(holder, "Bucket")
mut i := 0
until i < rows.items.len():
node := rows.items.get(i)
mut b := BucketEntry {
name = _xml_text(node, "Name"), created = _xml_text(node, "CreationDate"), region = _xml_text(node, "BucketRegion")
}
b.created_epoch = _iso_epoch(b.created)
out.items.push(b)
i += 1
end
ret out
end
@en "BucketCount"
@fa "شمار سطل‌ها"
pub func BucketCount(l: BucketList): int: ret l.items.len() end
@en "BucketAt"
@fa "سطل شماره"
pub func BucketAt(l: BucketList, i: int): BucketEntry:
if i < 0 or i >= l.items.len(): ret BucketEntry {} end
ret l.items.get(i)
end
@en "BucketListFree"
@fa "آزادسازی فهرست سطل‌ها"
pub func BucketListFree(l &: BucketList): l.items.free() end
@en "S3BucketRegion"
@fa "اس۳ منطقه سطل"
pub func S3BucketRegion(cfg: Config, bucket: str): str:
mut r := _bucket_request("GET", bucket)
SetFlag(r, "location")
res := Do(cfg, r)
if not res.ok:
hinted := ResultHeader(res, "x-amz-bucket-region")
if hinted.len() > 0: ret hinted end
ret ""
end
where := ResultTag(res.body, "LocationConstraint").trim()
if where.len() == 0: ret "us-east-1" end
ret where
end
@en "S3SetVersioning"
@fa "اس۳ تنظیم نسخه‌بندی"
pub func S3SetVersioning(cfg: Config, bucket: str, enabled: bool): Result:
