end
ret _YR { value = _json_str_literal(raw), next = e }
end
func _flow_value(s: str, i: int, depth: int): _YR:
p := _flow_ws(s, i)
n := s.len()
if depth > 512:
ret _YR { value = "null", next = n, ok = false }
end
bp := _bp(s)
if p < n and _ub(bp, p) == 123: ret _flow_object(s, p, depth) end
if p < n and _ub(bp, p) == 91: ret _flow_array(s, p, depth) end
ret _flow_scalar(s, p)
end
func _flow_object(s: str, i: int, depth: int): _YR:
n := s.len()
bp := _bp(s)
members := Vector {} as Vector<str>
defer members.free()
mut p := _flow_ws(s, i + 1)
if p < n and _ub(bp, p) == 125:
ret _YR { value = "{}", next = p + 1 }
end
mut closed := false
mut all_ok := true
until p < n:
p = _flow_ws(s, p)
k := _flow_key(s, p)
if k.ok == false: all_ok = false end
p = _flow_ws(s, k.next)
if p < n and _ub(bp, p) == 58: p = p + 1 end
p = _flow_ws(s, p)
v := _flow_value(s, p, depth + 1)
if v.ok == false: all_ok = false end
members.push(_json_str_literal(k.value).concat(": ").concat(v.value))
p = _flow_ws(s, v.next)
if p < n and _ub(bp, p) == 44:
p = p + 1
continue
end
if p < n and _ub(bp, p) == 125:
p = p + 1
closed = true
end
break
end
out := Object(members)
ret _YR { value = out, next = p, ok = closed and all_ok }
end
func _flow_array(s: str, i: int, depth: int): _YR:
n := s.len()
bp := _bp(s)
items := Vector {} as Vector<str>
defer items.free()
mut p := _flow_ws(s, i + 1)
if p < n and _ub(bp, p) == 93:
ret _YR { value = "[]", next = p + 1 }
end
