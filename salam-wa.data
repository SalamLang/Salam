mut p := i + 1
until p < n:
c := _ub(bp, p)
if c == 92 and p + 1 < n:
p = p + 2
continue
end
if c == 34: ret p + 1 end
p = p + 1
end
ret p
end
func _cval_end(s: str, i0: int): int:
i := _cws(s, i0)
n := s.len()
bp := _bp(s)
if i >= n: ret i end
c := _ub(bp, i)
