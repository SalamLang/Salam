func salam_hash_bytes(p: void*, n: u64): u64:
bp := p as i8*
ni := n as int
mut h := 14695981039346656037 as u64
repeat ni in i:
mut c := bp[i] as int
if c < 0: c = c + 256 end
h *= (1099511628211 as u64)
h += (c as u64)
end
ret h
end
end
inline func _xor32(a0: i64, b0: i64): i64:
ret (a0 ^ b0) & (4294967295 as i64)
end
inline func _and32(a0: i64, b0: i64): i64:
ret a0 & b0 & (4294967295 as i64)
end
inline func _not32(a0: i64): i64:
ret 4294967295 - (a0 % 4294967296)
end
func _rotr32(x0: i64, n: int): i64:
x := x0 % 4294967296
if n == 0:
ret x
end
hi := x % POW2[n]
lo := x / POW2[n]
ret lo + hi * POW2[32 - n]
end
func _shr32(x0: i64, n: int): i64:
x := x0 % 4294967296
if n == 0:
ret x
end
if n >= 32:
ret 0
end
ret x / POW2[n]
end
func _rotr32_2(x0: i64): i64:
x := x0 % 4294967296
