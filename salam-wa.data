@en "Remove"
@fa "حذف"
pub func Remove(path: str): int:
if SALAM_OS_WINDOWS:
w := _str_to_wide(path)
r := DeleteFileW(w)
mem.Free(w)
if r != 0: ret 0 end
ret 0 - 1
else:
if remove(path) == 0: ret 0 end
ret 0 - 1
end
