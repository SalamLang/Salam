const ST_CLOSED := 0
const ST_OPEN := 1
const ST_WAITING := 2
struct Handler:
pub name: str = ""
pub once: bool = false
pub alive: bool = true
pub cb: func (Event) = (e: Event): end
end
struct Outgoing:
pub text: str = ""
pub bins: Vector<Bytes> = Vector {}
end
struct AckWaiter:
pub id: int = 0 - 1
pub deadline: i64 = 0
pub has_deadline: bool = false
pub alive: bool = true
pub has_cb: bool = false
pub cb: func (Ack) = (a: Ack): end
pub retries_left: int = 0
pub interval: int = 0
pub internal: bool = false
pub has_packet: bool = false
pub packet: Outgoing = Outgoing {}
end
struct SockState:
pub mgr: void* = null
pub nsp: str = "/"
pub id: str = ""
pub connected: bool = false
pub active: bool = false
pub pid: str = ""
pub last_offset: str = ""
pub recovered: bool = false
pub auth: str = ""
pub refused: bool = false
pub refusal: str = ""
pub ack_seq: int = 0
pub handlers: Vector<Handler> = Vector {}
pub any_handlers: Vector<Handler> = Vector {}
pub out_handlers: Vector<Handler> = Vector {}
pub waiters: Vector<AckWaiter> = Vector {}
pub results: Vector<Ack> = Vector {}
pub outbuf: Vector<Outgoing> = Vector {}
pub inbox: Vector<Event> = Vector {}
pub queueing: bool = true
pub max_queue: int = 256
end
struct MgrState:
pub ep: Endpoint = Endpoint {}
pub opts: Options = Options {}
pub socks: Vector<Client> = Vector {}
pub state: int = ST_CLOSED
pub transport: int = TRANSPORT_POLLING
pub ws: websocket.Conn = websocket.Conn {}
pub sid: str = ""
pub ping_interval: int = 25000
pub ping_timeout: int = 20000
pub max_payload: int = 1000000
pub can_upgrade: bool = false
pub upgraded_before: bool = false
pub last_rx: i64 = 0
pub cookies: HashMap<str, str> = HashMap {} as HashMap<str, str>
pub attempts: int = 0
pub retry_at: i64 = 0
pub last_error: str = ""
pub dispatching: int = 0
pub pollout: Vector<str> = Vector {}
pub batching: bool = false
pub recon: bool = false
pub recon_pkt: Packet = Packet {}
pub recon_bins: Vector<Bytes> = Vector {}
end
@en "Options"
@fa "گزینه‌ها"
pub struct Options:
pub path: str = "/socket.io"
pub query: str = ""
pub auth: str = ""
pub headers: str = ""
pub transports: int = TRANSPORT_AUTO
pub reconnection: bool = true
pub reconnection_attempts: int = 0
pub reconnection_delay: int = 1000
pub reconnection_delay_max: int = 5000
pub randomization_factor: int = 50
pub timeout: int = 20000
pub insecure: bool = false
pub auto_connect: bool = true
pub event_queue: int = 256
pub ack_timeout: int = 0
pub retries: int = 0
pub trailing_slash: bool = true
pub remember_upgrade: bool = false
end
@en "Client"
@fa "کارخواه"
pub struct Client:
pub p: void* = null
end
@en "Manager"
@fa "مدیر"
pub struct Manager:
pub p: void* = null
end
@en "Event"
@fa "رویداد"
pub struct Event:
pub kind: int = EV_NONE
pub name: str = ""
pub nsp: str = "/"
pub data: str = "[]"
pub ack_id: int = 0 - 1
pub message: str = ""
pub bins: Vector<Bytes> = Vector {}
pub client: Client = Client {}
end
@en "Ack"
@fa "تایید"
pub struct Ack:
pub ok: bool = false
pub id: int = 0 - 1
pub data: str = "[]"
pub bins: Vector<Bytes> = Vector {}
end
func _sock(c: Client): SockState*:
ret c.p as SockState*
end
func _mgr(m: Manager): MgrState*:
ret m.p as MgrState*
end
func _mgr_of(c: Client): MgrState*:
ret _sock(c)[0].mgr as MgrState*
end
func _new_sock(mgr: void*, nsp: str): Client:
raw := mem.AllocateZeroed(sizeof(SockState) as u64)
if raw == null:
ret Client {}
end
mut sp := raw as SockState*
sp[0] = SockState { mgr = mgr, nsp = nsp }
ret Client { p = raw }
end
func _new_mgr(ep: Endpoint, opts: Options): Manager:
raw := mem.AllocateZeroed(sizeof(MgrState) as u64)
if raw == null:
ret Manager {}
end
mut mp := raw as MgrState*
mp[0] = MgrState { ep = ep, opts = opts }
ret Manager { p = raw }
end
func _free_bins(v &: Vector<Bytes>):
repeat v.len() in i:
mut b := v.get(i)
BytesFree(b)
end
v.free()
end
package socketio
import str
@en "Endpoint"
@fa "مشخصات نقطه پایانی"
pub struct Endpoint:
pub secure: bool = false
pub host: str = "localhost"
pub port: int = 80
pub path: str = "/socket.io"
pub namespace: str = "/"
pub query: str = ""
pub ok: bool = false
end
func _port_of(s: str): int:
if not _all_digits(s) or s.len() > 5:
ret 0
end
v := s.to_int()
if v < 1 or v > 65535:
ret 0
end
ret v
end
func _all_digits(s: str): bool:
if s.len() == 0:
ret false
end
mut ok := true
repeat s.len() in i:
c := char_code(s.substr(i, 1))
if c < 48 or c > 57:
ok = false
end
end
ret ok
end
@en "ParseURL"
@fa "تجزیه نشانی"
pub func ParseURL(raw: str): Endpoint:
mut e := Endpoint {}
s := str.Trim(raw)
if s.len() == 0:
ret e
end
mut rest := s
mut scheme := ""
si := str.Find(rest, "://")
if si >= 0:
scheme = str.Lower(rest.substr(0, si))
rest = rest.substr(si + 3, rest.len() - si - 3)
end
if scheme == "https" or scheme == "wss":
e.secure = true
else scheme == "http" or scheme == "ws" or scheme == "":
e.secure = false
else:
ret e
end
qi := str.Find(rest, "?")
if qi >= 0:
e.query = rest.substr(qi + 1, rest.len() - qi - 1)
rest = rest.substr(0, qi)
end
hi := str.Find(rest, "#")
if hi >= 0:
rest = rest.substr(0, hi)
end
mut authority := rest
mut ns := "/"
pi := str.Find(rest, "/")
if pi >= 0:
authority = rest.substr(0, pi)
ns = rest.substr(pi, rest.len() - pi)
end
ui := str.LastIndex(authority, "@")
if ui >= 0:
authority = authority.substr(ui + 1, authority.len() - ui - 1)
end
mut host := authority
mut port := 0
if str.StartsWith(authority, "["):
rb := str.Find(authority, "]")
if rb < 0:
ret e
end
host = authority.substr(1, rb - 1)
after := authority.substr(rb + 1, authority.len() - rb - 1)
if str.StartsWith(after, ":"):
port = _port_of(after.substr(1, after.len() - 1))
if port == 0:
ret e
end
end
else:
ci := str.LastIndex(authority, ":")
if ci >= 0:
port = _port_of(authority.substr(ci + 1, authority.len() - ci - 1))
if port == 0:
ret e
end
host = authority.substr(0, ci)
end
end
if host.len() == 0:
ret e
end
if port <= 0:
port = 80
if e.secure:
port = 443
end
end
until ns.len() > 1 and str.EndsWith(ns, "/"):
ns = ns.substr(0, ns.len() - 1)
end
if ns.len() == 0:
ns = "/"
end
e.host = host
e.port = port
e.namespace = ns
e.ok = true
ret e
end
@en "Origin"
@fa "مبدا"
pub func Origin(e: Endpoint): str:
mut sch := "http"
mut standard := 80
if e.secure:
sch = "https"
standard = 443
end
mut h := e.host
if str.Contains(h, ":"):
h = "[" + h + "]"
end
if e.port == standard:
ret sch + "://" + h
end
ret sch + "://" + h + ":" + e.port
end
@en "net/tcp"
@fa "تی سی پی"
package tcp
import net.internal.rawsock
import conv
import tls
@en "Server"
@fa "سرور"
pub struct Server:
pub fd: i64 = 0 - 1
pub port: int = 0
end
@en "Conn"
@fa "اتصال شبکه"
pub struct Conn:
pub fd: i64 = 0 - 1
end
@en "PoolEntry"
@fa "مدخل استخر"
pub struct PoolEntry:
pub key: str = ""
pub conn: Conn = Conn {}
pub put_at_ms: i64 = 0
end
@en "PoolEntries"
@fa "مدخل‌های استخر"
pub struct PoolEntries:
pub items: Vector<PoolEntry> = Vector {}
end
@en "Pool"
@fa "استخر اتصال"
pub struct Pool:
pub entries: PoolEntries = PoolEntries {}
pub idle_ttl_ms: i64 = 30000
end
func _sock(fd: i64): rawsock.Socket:
