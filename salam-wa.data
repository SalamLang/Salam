repeat total in i:
li := i / 4
sh := ((i % 4) * 8) as u32
v := ((_limb(x, li) >> sh) & (0xFF as u32)) as int
pos := len - 1 - i
if pos >= 0:
_bput(out, pos, v)
end
end
ret true
end
@en "tls"
@fa "تی ال اس"
package tls
import mem
import str
import time
import io
import os
import encoding
import crypto
const HEXDIGITS := "0123456789abcdef"
struct Buf:
pub p: void* = null
pub len: int = 0
pub cap: int = 0
pub bad: bool = false
end
struct Reader:
pub p: void* = null
pub len: int = 0
pub pos: int = 0
pub bad: bool = false
end
inline func _bget(p: void*, i: int): int:
bp := p as u8*
ret bp[i] as int
end
inline func _bput(p: void*, i: int, v: int):
bp := p as u8*
bp[i] = v as u8
end
func _newbuf(cap0: int): Buf:
mut c := cap0
if c < 32:
c = 32
end
p := mem.Allocate(c as u64)
if p == null:
ret Buf { p = null, len = 0, cap = 0, bad = true }
end
ret Buf { p = p, len = 0, cap = c, bad = false }
end
func _buf_free(b &: Buf):
if b.p != null:
mem.Free(b.p)
end
b.p = null
b.len = 0
b.cap = 0
end
func _wipe(p: void*, n: int):
if p != null and n > 0:
mem.Set(p, 0, n as u64)
end
end
func _buf_wipe(b &: Buf):
_wipe(b.p, b.cap)
