until len < 16:
code = code | compress.BitReadBit(r)
n := c.count.get(len)
if code - first < n:
ret c.syms.get(index + code - first)
end
index += n
first = (first + n) << 1
code = code << 1
len += 1
end
r.bad = true
ret 0
end
func _wpd_code(r &: compress.BitReader, size: int): _WpdCode:
