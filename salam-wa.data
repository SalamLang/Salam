end
end
end
func _vp8_loop(pl: u8*, p: int, step: int, along: int, size: int, thresh: int, it: int, hev: int, six: bool):
t2 := 2 * thresh + 1
repeat size in i:
q := p + i * along
if _vp8_needs2(pl, q, step, t2, it):
if _vp8_hev(pl, q, step, hev):
