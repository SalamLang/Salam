@fa "بهینه‌سازی یک"
pub const OPT_O1 := 1
@en "OPT_O2"
@fa "بهینه‌سازی دو"
pub const OPT_O2 := 2
@en "OPT_O3"
@fa "بهینه‌سازی سه"
pub const OPT_O3 := 3
@en "OPT_OS"
@fa "بهینه‌سازی اندازه"
pub const OPT_OS := 4
@en "OPT_OZ"
@fa "بهینه‌سازی کمینه اندازه"
pub const OPT_OZ := 5
@en "OUT_IR"
@fa "خروجی آی آر"
pub const OUT_IR := 0
@en "OUT_ASM"
@fa "خروجی اسمبلی"
pub const OUT_ASM := 1
@en "OUT_OBJ"
@fa "خروجی شیء"
pub const OUT_OBJ := 2
@en "OUT_BITCODE"
@fa "خروجی بیت‌کد"
pub const OUT_BITCODE := 3
@en "OUT_EXEC"
@fa "خروجی اجرایی"
pub const OUT_EXEC := 4
@en "OUT_JIT"
@fa "خروجی جیت"
pub const OUT_JIT := 5
@en "CODEGEN_FILE_ASSEMBLY"
@fa "پرونده اسمبلی"
pub const CODEGEN_FILE_ASSEMBLY := 0
@en "CODEGEN_FILE_OBJECT"
@fa "پرونده شیء"
pub const CODEGEN_FILE_OBJECT := 1
@en "CODEGEN_LEVEL_NONE"
@fa "سطح تولید بدون بهینه‌سازی"
pub const CODEGEN_LEVEL_NONE := 0
@en "CODEGEN_LEVEL_LESS"
@fa "سطح تولید کم"
pub const CODEGEN_LEVEL_LESS := 1
