c1_12 += v1 * b12
c1_13 += v1 * b13
c1_14 += v1 * b14
c1_15 += v1 * b15
v2 := pak[2]
c2_0 += v2 * b0
c2_1 += v2 * b1
c2_2 += v2 * b2
