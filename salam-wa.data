b = _gf_sub(b, d)
d = _gf_sq(e)
f := _gf_sq(a)
a = _gf_mul(c, a)
c = _gf_mul(b, e)
e = _gf_add(a, c)
a = _gf_sub(a, c)
b = _gf_sq(a)
c = _gf_sub(d, f)
a = _gf_mul(c, _gf_121665())
