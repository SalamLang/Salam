@en "ArgBytes"
@fa "آرگومان بایتی"
pub func ArgBytes(ev: Event, i: int): Bytes:
n := PlaceholderNum(Item(ev.data, i))
if n < 0 or n >= ev.bins.len():
ret Bytes {}
end
ret ev.bins.get(n)
