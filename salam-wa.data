end
func _buf_grow(b &: Buf, need: int):
if b.bad:
ret
end
if b.len + need <= b.cap:
ret
end
mut nc := b.cap
if nc < 32:
nc = 32
end
until b.len + need > nc:
nc *= 2
end
np := mem.Reallocate(b.p, nc as u64)
if np == null:
b.bad = true
ret
end
b.p = np
b.cap = nc
end
func _put8(b &: Buf, v: int):
