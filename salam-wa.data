keep := node.attr_int("keepdims", 1) != 0
mut axes := Vector {} as Vector<int>
k := node.attr_index("axes")
if k >= 0:
a := node.attrs.get(k)
repeat a.ints.len() in i: axes.push(_norm_axis(a.ints.get(i), x.rank())) end
else if node.inputs.len() > 1 and str.Len(node.inputs.get(1)) > 0:
