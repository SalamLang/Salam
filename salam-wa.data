bp[i + 2] = _vp8_clip8(_vp8_mulhi(y, 19077) + _vp8_mulhi(u, 33050) - 17685) as u8
bp[i + 3] = 255 as u8
end
func _vp8_line(bp: u8*, w: int, row: int, y: u8*, yrow: int, tu: int, tv: int, cu: int, cv: int, u: u8*, v: u8*, bottom: bool):
out := row * w * 4
mut tl_u := u[tu] as int
mut tl_v := v[tv] as int
mut l_u := u[cu] as int
mut l_v := v[cv] as int
if bottom:
_vp8_rgb(bp, out, y[yrow] as int, (3 * l_u + tl_u + 2) >> 2, (3 * l_v + tl_v + 2) >> 2)
else:
_vp8_rgb(bp, out, y[yrow] as int, (3 * tl_u + l_u + 2) >> 2, (3 * tl_v + l_v + 2) >> 2)
end
last := (w - 1) >> 1
mut x := 1
until x <= last:
t_u := u[tu + x] as int
t_v := v[tv + x] as int
c_u := u[cu + x] as int
c_v := v[cv + x] as int
avg_u := tl_u + t_u + l_u + c_u + 8
avg_v := tl_v + t_v + l_v + c_v + 8
d12_u := (avg_u + 2 * (t_u + l_u)) >> 3
d12_v := (avg_v + 2 * (t_v + l_v)) >> 3
d03_u := (avg_u + 2 * (tl_u + c_u)) >> 3
d03_v := (avg_v + 2 * (tl_v + c_v)) >> 3
if bottom:
_vp8_rgb(bp, out + (2 * x - 1) * 4, y[yrow + 2 * x - 1] as int, (d03_u + l_u) >> 1, (d03_v + l_v) >> 1)
_vp8_rgb(bp, out + 2 * x * 4, y[yrow + 2 * x] as int, (d12_u + c_u) >> 1, (d12_v + c_v) >> 1)
else:
_vp8_rgb(bp, out + (2 * x - 1) * 4, y[yrow + 2 * x - 1] as int, (d12_u + tl_u) >> 1, (d12_v + tl_v) >> 1)
_vp8_rgb(bp, out + 2 * x * 4, y[yrow + 2 * x] as int, (d03_u + t_u) >> 1, (d03_v + t_v) >> 1)
end
tl_u = t_u
tl_v = t_v
l_u = c_u
l_v = c_v
x += 1
end
if (w & 1) == 0:
if bottom:
_vp8_rgb(bp, out + (w - 1) * 4, y[yrow + w - 1] as int, (3 * l_u + tl_u + 2) >> 2, (3 * l_v + tl_v + 2) >> 2)
else:
_vp8_rgb(bp, out + (w - 1) * 4, y[yrow + w - 1] as int, (3 * tl_u + l_u + 2) >> 2, (3 * tl_v + l_v + 2) >> 2)
end
end
end
func _vp8_upsample(img: Image, y: u8*, ys: int, u: u8*, v: u8*, uvs: int):
bp := img.pixels as u8*
w := img.width
h := img.height
_vp8_line(bp, w, 0, y, 0, 0, 0, 0, 0, u, v, false)
mut k := 1
until 2 * k <= h - 1:
top := (k - 1) * uvs
cur := k * uvs
_vp8_line(bp, w, 2 * k - 1, y, (2 * k - 1) * ys, top, top, cur, cur, u, v, false)
_vp8_line(bp, w, 2 * k, y, 2 * k * ys, top, top, cur, cur, u, v, true)
k += 1
end
if (h & 1) == 0 and h > 1:
last := (h / 2 - 1) * uvs
_vp8_line(bp, w, h - 1, y, (h - 1) * ys, last, last, last, last, u, v, false)
end
