@fa "آزادسازی"
pub func free(): matrix.Free(this.coef) end
end
@en "Ridge"
@fa "رگرسیون ستیغی"
pub struct Ridge:
pub alpha: f64 = 1.0
pub fit_intercept: bool = true
pub coef: matrix.Matrix = matrix.Matrix {}
pub intercept: f64 = 0.0
pub ok: bool = false
@en "fit"
@fa "برازش"
pub func fit(x &: matrix.Matrix, y &: matrix.Matrix): bool:
this.ok = false
if x.is_empty() or y.rows != x.rows or y.cols != 1: ret false end
mut xm := matrix.Zeros(1, x.cols)
mut ym := 0.0
mut xc := _centered(x, this.fit_intercept, xm)
mut yc := _centered_col(y, this.fit_intercept, ym)
mut g := matrix.TransposeMul(xc, xc)
repeat x.cols in j: g.add_at(j, j, this.alpha) end
mut rhs := matrix.TransposeMul(xc, yc)
w := matrix.SolveSPD(g, rhs)
matrix.Free(xc)
matrix.Free(yc)
matrix.Free(g)
matrix.Free(rhs)
if w.is_empty():
matrix.Free(xm)
ret false
end
matrix.Free(this.coef)
this.coef = w
this.intercept = _intercept_of(xm, ym, this.coef)
matrix.Free(xm)
this.ok = true
ret true
end
@en "predict"
@fa "پیش‌بینی"
pub func predict(x &: matrix.Matrix): matrix.Matrix:
if this.ok == false or x.cols != this.coef.rows: ret matrix.Matrix {} end
ret _linear_predict(x, this.coef, this.intercept)
end
@en "score"
@fa "امتیاز"
pub func score(x &: matrix.Matrix, y &: matrix.Matrix): f64:
mut p := this.predict(x)
if p.is_empty(): ret 0.0 end
r := R2Score(y, p)
matrix.Free(p)
ret r
end
@en "free"
@fa "آزادسازی"
pub func free(): matrix.Free(this.coef) end
end
@en "Lasso"
@fa "لاسو"
pub struct Lasso:
pub alpha: f64 = 1.0
pub l1_ratio: f64 = 1.0
pub fit_intercept: bool = true
pub max_iter: int = 1000
pub tol: f64 = 0.0001
pub coef: matrix.Matrix = matrix.Matrix {}
pub intercept: f64 = 0.0
pub n_iter: int = 0
pub ok: bool = false
@en "fit"
@fa "برازش"
pub func fit(x &: matrix.Matrix, y &: matrix.Matrix): bool:
this.ok = false
if x.is_empty() or y.rows != x.rows or y.cols != 1: ret false end
n := x.rows
p := x.cols
mut xm := matrix.Zeros(1, p)
mut ym := 0.0
mut xc := _centered(x, this.fit_intercept, xm)
mut yc := _centered_col(y, this.fit_intercept, ym)
mut w := matrix.Zeros(p, 1)
mut r := matrix.Clone(yc)
nf := n as f64
l1 := this.alpha * this.l1_ratio
l2 := this.alpha * (1.0 - this.l1_ratio)
mut colsq := Vector {} as Vector<f64>
repeat p in j:
mut s := 0.0
repeat n in i: s += xc.at(i, j) * xc.at(i, j) end
colsq.push(s / nf)
end
mut it := 0
mut converged := false
until it < this.max_iter and converged == false:
mut max_delta := 0.0
repeat p in j:
wj := w.at(j, 0)
mut rho := 0.0
repeat n in i: rho += xc.at(i, j) * (r.at(i, 0) + xc.at(i, j) * wj) end
rho = rho / nf
mut nw := 0.0
denom := colsq.get(j) + l2
if denom > 0.0:
mut soft := 0.0
if rho > l1: soft = rho - l1
else rho < 0.0 - l1: soft = rho + l1 end
nw = soft / denom
end
d := nw - wj
if d != 0.0:
repeat n in i: r.set(i, 0, r.at(i, 0) - xc.at(i, j) * d) end
w.set(j, 0, nw)
end
mut ad := d
if ad < 0.0: ad = 0.0 - ad end
if ad > max_delta: max_delta = ad end
end
it += 1
if max_delta < this.tol: converged = true end
end
this.n_iter = it
colsq.free()
matrix.Free(xc)
matrix.Free(yc)
matrix.Free(r)
matrix.Free(this.coef)
this.coef = w
this.intercept = _intercept_of(xm, ym, this.coef)
matrix.Free(xm)
this.ok = true
ret true
end
@en "predict"
@fa "پیش‌بینی"
pub func predict(x &: matrix.Matrix): matrix.Matrix:
if this.ok == false or x.cols != this.coef.rows: ret matrix.Matrix {} end
ret _linear_predict(x, this.coef, this.intercept)
end
@en "score"
@fa "امتیاز"
pub func score(x &: matrix.Matrix, y &: matrix.Matrix): f64:
mut p := this.predict(x)
if p.is_empty(): ret 0.0 end
r := R2Score(y, p)
matrix.Free(p)
ret r
end
@en "free"
@fa "آزادسازی"
pub func free(): matrix.Free(this.coef) end
end
@en "LogisticRegression"
@fa "رگرسیون لجستیک"
pub struct LogisticRegression:
pub alpha: f64 = 0.0001
pub fit_intercept: bool = true
pub max_iter: int = 500
pub tol: f64 = 0.000001
pub coef: matrix.Matrix = matrix.Matrix {}
pub intercept: matrix.Matrix = matrix.Matrix {}
pub n_classes: int = 0
pub n_iter: int = 0
pub ok: bool = false
@en "fit"
@fa "برازش"
pub func fit(x &: matrix.Matrix, y &: matrix.Matrix): bool:
this.ok = false
if x.is_empty() or y.rows != x.rows or y.cols != 1: ret false end
n := x.rows
p := x.cols
k := CountClasses(y)
if k < 2: ret false end
nf := n as f64
mut xm := matrix.Zeros(1, p)
mut xc := _centered(x, this.fit_intercept, xm)
mut w := matrix.Zeros(p, k)
mut b := matrix.Zeros(1, k)
mut frob := 0.0
repeat n * p in t: frob += xc.a.get(t) * xc.a.get(t) end
step := 1.0 / (0.25 * frob / nf + this.alpha + 1.0e-12)
mut wv := matrix.Zeros(p, k)
mut bv := matrix.Zeros(1, k)
mut prev_w := matrix.Zeros(p, k)
mut prev_b := matrix.Zeros(1, k)
mut gw := matrix.Zeros(p, k)
mut gb := matrix.Zeros(1, k)
mut probs := matrix.Zeros(n, k)
mut it := 0
mut done := false
until it < this.max_iter and done == false:
_softmax_scores(xc, wv, bv, probs)
matrix.SetAll(gw, 0.0)
matrix.SetAll(gb, 0.0)
repeat n in i:
t := y.at(i, 0) as int
repeat k in c:
mut d := probs.at(i, c)
if c == t: d = d - 1.0 end
d = d / nf
gb.add_at(0, c, d)
repeat p in j: gw.add_at(j, c, xc.at(i, j) * d) end
end
end
repeat p * k in t: gw.a.set(t, gw.a.get(t) + this.alpha * wv.a.get(t)) end
mom := (it as f64) / ((it + 3) as f64)
mut max_delta := 0.0
repeat p * k in t:
nw := wv.a.get(t) - step * gw.a.get(t)
d := nw - prev_w.a.get(t)
mut ad := d
if ad < 0.0: ad = 0.0 - ad end
if ad > max_delta: max_delta = ad end
wv.a.set(t, nw + mom * d)
prev_w.a.set(t, nw)
w.a.set(t, nw)
end
if this.fit_intercept:
repeat k in c:
nb := bv.at(0, c) - step * gb.at(0, c)
d := nb - prev_b.at(0, c)
bv.set(0, c, nb + mom * d)
prev_b.set(0, c, nb)
b.set(0, c, nb)
end
end
it += 1
if max_delta < this.tol: done = true end
end
this.n_iter = it
matrix.Free(this.coef)
matrix.Free(this.intercept)
this.coef = w
repeat k in c:
mut shift := 0.0
repeat p in j: shift += xm.at(0, j) * w.at(j, c) end
b.set(0, c, b.at(0, c) - shift)
end
this.intercept = b
this.n_classes = k
matrix.Free(xc)
matrix.Free(xm)
matrix.Free(wv)
matrix.Free(bv)
matrix.Free(prev_w)
matrix.Free(prev_b)
matrix.Free(gw)
matrix.Free(gb)
matrix.Free(probs)
this.ok = true
ret true
end
@en "predict_proba"
@fa "پیش‌بینی احتمال"
pub func predict_proba(x &: matrix.Matrix): matrix.Matrix:
if this.ok == false or x.cols != this.coef.rows: ret matrix.Matrix {} end
mut probs := matrix.Zeros(x.rows, this.n_classes)
_softmax_scores(x, this.coef, this.intercept, probs)
ret probs
end
@en "predict"
@fa "پیش‌بینی"
pub func predict(x &: matrix.Matrix): matrix.Matrix:
mut probs := this.predict_proba(x)
if probs.is_empty(): ret probs end
mut out := matrix.Zeros(x.rows, 1)
repeat x.rows in i:
mut best := 0
repeat this.n_classes in c:
if probs.at(i, c) > probs.at(i, best): best = c end
end
out.set(i, 0, best as f64)
end
matrix.Free(probs)
ret out
end
@en "score"
@fa "امتیاز"
pub func score(x &: matrix.Matrix, y &: matrix.Matrix): f64:
mut p := this.predict(x)
if p.is_empty(): ret 0.0 end
r := Accuracy(y, p)
matrix.Free(p)
ret r
end
@en "free"
@fa "آزادسازی"
pub func free():
matrix.Free(this.coef)
matrix.Free(this.intercept)
end
end
func _centered(x &: matrix.Matrix, center: bool, mean_out &: matrix.Matrix): matrix.Matrix:
mut r := matrix.Clone(x)
if center == false: ret r end
repeat x.cols in j:
m := _col_mean(x, j)
mean_out.set(0, j, m)
repeat x.rows in i: r.set(i, j, x.at(i, j) - m) end
end
ret r
end
func _centered_col(y &: matrix.Matrix, center: bool, mean_out &: f64): matrix.Matrix:
mut r := matrix.Clone(y)
mean_out = 0.0
if center == false: ret r end
m := _col_mean(y, 0)
mean_out = m
repeat y.rows in i: r.set(i, 0, y.at(i, 0) - m) end
ret r
end
func _intercept_of(xm &: matrix.Matrix, ym: f64, w &: matrix.Matrix): f64:
mut s := ym
repeat w.rows in j: s -= xm.at(0, j) * w.at(j, 0) end
ret s
end
func _linear_predict(x &: matrix.Matrix, w &: matrix.Matrix, b: f64): matrix.Matrix:
mut p := matrix.MatMul(x, w)
repeat p.rows in i: p.add_at(i, 0, b) end
ret p
end
func _softmax_scores(x &: matrix.Matrix, w &: matrix.Matrix, b &: matrix.Matrix, out &: matrix.Matrix):
mut z := matrix.MatMul(x, w)
k := w.cols
repeat x.rows in i:
mut m := z.at(i, 0) + b.at(0, 0)
repeat k in c:
v := z.at(i, c) + b.at(0, c)
if v > m: m = v end
end
mut s := 0.0
repeat k in c:
e := math.Exp(z.at(i, c) + b.at(0, c) - m)
out.set(i, c, e)
s += e
end
repeat k in c: out.set(i, c, out.at(i, c) / s) end
end
matrix.Free(z)
end
@en "NewElasticNet"
@fa "شبکه کشسان جدید"
pub func NewElasticNet(alpha: f64, l1_ratio: f64): Lasso:
mut m := Lasso {}
m.alpha = alpha
m.l1_ratio = l1_ratio
ret m
end
package ml
import math
import matrix
@en "TSNE"
@fa "تی‌اس‌ان‌ای"
pub struct TSNE:
pub n_components: int = 2
pub perplexity: f64 = 30.0
pub learning_rate: f64 = 0.0
pub n_iter: int = 500
pub early_exaggeration: f64 = 12.0
pub seed: i64 = 42
pub embedding: matrix.Matrix = matrix.Matrix {}
pub kl: f64 = 0.0
pub ok: bool = false
@en "fit_transform"
@fa "برازش سپس تبدیل"
pub func fit_transform(x &: matrix.Matrix): matrix.Matrix:
n := x.rows
m := this.n_components
this.ok = false
if n < 4 or m < 1: ret matrix.Matrix {} end
mut perp := this.perplexity
if perp >= ((n - 1) as f64): perp = ((n - 1) as f64) / 3.0 end
mut lr := this.learning_rate
if lr <= 0.0:
lr = (n as f64) / this.early_exaggeration / 4.0
if lr < 50.0: lr = 50.0 end
end
mut d := _pairwise_sq(x)
mut p := _joint_p(d, n, perp)
d.free()
mut y := matrix.Zeros(n, m)
mut g := matrix.NewRng(this.seed)
repeat n * m in k: y.a.set(k, 0.0001 * g.next_normal()) end
mut grad := Vector {} as Vector<f64>
mut vel := Vector {} as Vector<f64>
mut gains := Vector {} as Vector<f64>
repeat n * m:
grad.push(0.0)
vel.push(0.0)
gains.push(1.0)
end
mut num := Vector {} as Vector<f64>
repeat n * n: num.push(0.0) end
repeat this.n_iter in it:
exag := it < 250 ? this.early_exaggeration : 1.0
momentum := it < 250 ? 0.5 : 0.8
sumq := _student_num(y, num)
_tsne_grad(y, p, num, sumq, exag, grad)
repeat n * m in k:
gk := grad.get(k)
vk := vel.get(k)
mut gn := gains.get(k)
if (gk > 0.0) != (vk > 0.0): gn += 0.2 else:
gn = gn * 0.8
end
if gn < 0.01: gn = 0.01 end
gains.set(k, gn)
nv := momentum * vk - lr * gn * gk
vel.set(k, nv)
y.a.set(k, y.a.get(k) + nv)
end
_center_rows(y)
end
sumq := _student_num(y, num)
this.kl = _kl(p, num, sumq, n)
p.free()
num.free()
grad.free()
vel.free()
gains.free()
this.embedding.free()
this.embedding = matrix.Clone(y)
this.ok = true
ret y
end
@en "free"
@fa "آزادسازی"
pub func free(): this.embedding.free() end
end
func _pairwise_sq(x &: matrix.Matrix): Vector<f64>:
n := x.rows
p := x.cols
mut d := Vector {} as Vector<f64>
repeat n * n: d.push(0.0) end
repeat n in i:
repeat i in j:
mut s := 0.0
repeat p in k:
t := x.at(i, k) - x.at(j, k)
s += t * t
end
d.set(i * n + j, s)
d.set(j * n + i, s)
end
end
ret d
end
func _row_p(d &: Vector<f64>, n: int, i: int, beta: f64, p &: Vector<f64>): f64:
mut sum := 0.0
mut dsum := 0.0
repeat n in j:
if j == i:
p.set(i * n + j, 0.0)
continue
end
v := math.Exp(0.0 - d.get(i * n + j) * beta)
p.set(i * n + j, v)
sum += v
dsum += d.get(i * n + j) * v
end
if sum <= 0.0: ret 0.0 end
repeat n in j: p.set(i * n + j, p.get(i * n + j) / sum) end
ret math.Log(sum) + beta * dsum / sum
end
func _joint_p(d &: Vector<f64>, n: int, perp: f64): Vector<f64>:
target := math.Log(perp)
mut p := Vector {} as Vector<f64>
repeat n * n: p.push(0.0) end
repeat n in i:
mut beta := 1.0
mut lo := 0.0
mut hi := 0.0
mut has_hi := false
repeat 50:
h := _row_p(d, n, i, beta, p)
diff := h - target
if diff < 0.00001 and diff > 0.0 - 0.00001: continue end
if diff > 0.0:
lo = beta
if has_hi: beta = (lo + hi) / 2.0 else:
beta = beta * 2.0
end
else:
hi = beta
has_hi = true
beta = (lo + hi) / 2.0
end
end
end
mut total := 0.0
repeat n in i:
repeat i in j:
v := (p.get(i * n + j) + p.get(j * n + i)) / 2.0
p.set(i * n + j, v)
p.set(j * n + i, v)
total += 2.0 * v
end
end
if total > 0.0:
repeat n * n in k:
mut v := p.get(k) / total
if v < 0.000000000001: v = 0.000000000001 end
p.set(k, v)
end
end
repeat n in i: p.set(i * n + i, 0.0) end
ret p
end
func _student_num(y &: matrix.Matrix, num &: Vector<f64>): f64:
n := y.rows
m := y.cols
mut total := 0.0
repeat n in i:
num.set(i * n + i, 0.0)
repeat i in j:
mut s := 0.0
repeat m in k:
t := y.at(i, k) - y.at(j, k)
s += t * t
end
v := 1.0 / (1.0 + s)
num.set(i * n + j, v)
num.set(j * n + i, v)
total += 2.0 * v
end
end
ret total
end
func _tsne_grad(y &: matrix.Matrix, p &: Vector<f64>, num &: Vector<f64>, sumq: f64, exag: f64, grad &: Vector<f64>):
n := y.rows
m := y.cols
repeat n * m in k: grad.set(k, 0.0) end
repeat n in i:
repeat n in j:
if j == i: continue end
nij := num.get(i * n + j)
q := nij / sumq
mult := 4.0 * (exag * p.get(i * n + j) - q) * nij
repeat m in k:
grad.set(i * m + k, grad.get(i * m + k) + mult * (y.at(i, k) - y.at(j, k)))
end
end
end
end
func _center_rows(y &: matrix.Matrix):
n := y.rows
m := y.cols
repeat m in k:
mut s := 0.0
repeat n in i: s += y.at(i, k) end
mean := s / (n as f64)
repeat n in i: y.set(i, k, y.at(i, k) - mean) end
end
end
func _kl(p &: Vector<f64>, num &: Vector<f64>, sumq: f64, n: int): f64:
mut kl := 0.0
repeat n in i:
repeat n in j:
if j == i: continue end
pij := p.get(i * n + j)
mut q := num.get(i * n + j) / sumq
if q < 0.000000000001: q = 0.000000000001 end
if pij > 0.0: kl += pij * math.Log(pij / q) end
end
end
ret kl
end
package ml
import math
import matrix
import sort
func _abs(v: f64): f64:
if v < 0.0: ret 0.0 - v end
ret v
end
func _counts(y &: matrix.Matrix, pred &: matrix.Matrix, positive: f64, tp &: int, fp &: int, fn &: int):
tp = 0
fp = 0
fn = 0
repeat y.rows in i:
t := y.at(i, 0) == positive
p := pred.at(i, 0) == positive
if t and p: tp += 1 end
if not t and p: fp += 1 end
if t and not p: fn += 1 end
end
end
func _safe_div(a: f64, b: f64): f64:
if b == 0.0: ret 0.0 end
ret a / b
end
func _by_score_desc(score &: matrix.Matrix): Vector<int>:
n := score.rows
mut order := Vector {} as Vector<int>
repeat n in i: order.push(i) end
mut keys := Vector {} as Vector<f64>
repeat n in i: keys.push(score.at(i, 0)) end
sort.SortIndexDesc(order, keys)
keys.free()
ret order
end
func _pos_neg(y &: matrix.Matrix, npos &: int, nneg &: int):
npos = 0
nneg = 0
repeat y.rows in i:
if y.at(i, 0) == 1.0: npos += 1 else:
nneg += 1
end
end
end
@en "Accuracy"
@fa "دقت"
pub func Accuracy(y &: matrix.Matrix, pred &: matrix.Matrix): f64:
if y.rows == 0 or y.rows != pred.rows: ret 0.0 end
mut hits := 0
repeat y.rows in i:
if y.at(i, 0) == pred.at(i, 0): hits += 1 end
end
ret (hits as f64) / (y.rows as f64)
end
@en "ConfusionMatrix"
@fa "ماتریس درهم‌ریختگی"
pub func ConfusionMatrix(y &: matrix.Matrix, pred &: matrix.Matrix, n_classes: int): matrix.Matrix:
if y.rows != pred.rows or n_classes <= 0: ret matrix.Matrix {} end
mut c := matrix.Zeros(n_classes, n_classes)
repeat y.rows in i:
t := y.at(i, 0) as int
p := pred.at(i, 0) as int
if t >= 0 and t < n_classes and p >= 0 and p < n_classes: c.add_at(t, p, 1.0) end
end
ret c
end
@en "Precision"
@fa "صحت"
pub func Precision(y &: matrix.Matrix, pred &: matrix.Matrix, positive: f64): f64:
mut tp := 0
mut fp := 0
mut fn := 0
_counts(y, pred, positive, tp, fp, fn)
ret _safe_div(tp as f64, (tp + fp) as f64)
end
@en "Recall"
@fa "بازیابی"
pub func Recall(y &: matrix.Matrix, pred &: matrix.Matrix, positive: f64): f64:
mut tp := 0
mut fp := 0
mut fn := 0
_counts(y, pred, positive, tp, fp, fn)
ret _safe_div(tp as f64, (tp + fn) as f64)
end
@en "F1"
@fa "اف یک"
pub func F1(y &: matrix.Matrix, pred &: matrix.Matrix, positive: f64): f64:
p := Precision(y, pred, positive)
r := Recall(y, pred, positive)
ret _safe_div(2.0 * p * r, p + r)
end
@en "MacroF1"
@fa "اف یک کلان"
pub func MacroF1(y &: matrix.Matrix, pred &: matrix.Matrix, n_classes: int): f64:
if n_classes <= 0: ret 0.0 end
mut s := 0.0
repeat n_classes in k: s += F1(y, pred, k as f64) end
ret s / (n_classes as f64)
end
@en "RocAuc"
@fa "سطح زیر منحنی"
pub func RocAuc(y &: matrix.Matrix, score &: matrix.Matrix): f64:
n := y.rows
if n == 0 or score.rows != n: ret 0.0 end
mut order := Vector {} as Vector<int>
repeat n in i: order.push(i) end
mut keys := Vector {} as Vector<f64>
repeat n in i: keys.push(score.at(i, 0)) end
sort.SortIndex(order, keys)
mut ranks := Vector {} as Vector<f64>
ranks.zeros(n)
mut i := 0
until i < n:
mut j := i
until j + 1 < n and keys.get(order.get(j + 1)) == keys.get(order.get(i)): j += 1 end
avg := ((i + 1 + j + 1) as f64) / 2.0
mut k := i
until k <= j:
ranks.set(order.get(k), avg)
k += 1
end
i = j + 1
end
mut npos := 0
mut rank_sum := 0.0
repeat n in t:
if y.at(t, 0) == 1.0:
npos += 1
rank_sum += ranks.get(t)
end
end
nneg := n - npos
order.free()
keys.free()
ranks.free()
if npos == 0 or nneg == 0: ret 0.0 end
ret (rank_sum - ((npos as f64) * ((npos + 1) as f64)) / 2.0) / ((npos as f64) * (nneg as f64))
end
@en "LogLoss"
@fa "خطای لگاریتمی"
pub func LogLoss(y &: matrix.Matrix, proba &: matrix.Matrix): f64:
n := y.rows
if n == 0 or proba.rows != n: ret 0.0 end
mut s := 0.0
repeat n in i:
k := y.at(i, 0) as int
mut p := 0.0
if k >= 0 and k < proba.cols: p = proba.at(i, k) end
if p < 1.0e-15: p = 1.0e-15 end
if p > 1.0 - 1.0e-15: p = 1.0 - 1.0e-15 end
s -= math.Log(p)
end
ret s / (n as f64)
end
@en "MSE"
@fa "میانگین مربعات خطا"
pub func MSE(y &: matrix.Matrix, pred &: matrix.Matrix): f64:
n := y.rows
if n == 0 or pred.rows != n: ret 0.0 end
mut s := 0.0
repeat n in i:
d := y.at(i, 0) - pred.at(i, 0)
s += d * d
end
ret s / (n as f64)
end
@en "MAE"
@fa "میانگین قدرمطلق خطا"
pub func MAE(y &: matrix.Matrix, pred &: matrix.Matrix): f64:
n := y.rows
if n == 0 or pred.rows != n: ret 0.0 end
mut s := 0.0
repeat n in i: s += _abs(y.at(i, 0) - pred.at(i, 0)) end
ret s / (n as f64)
end
@en "RMSE"
@fa "ریشه میانگین مربعات خطا"
pub func RMSE(y &: matrix.Matrix, pred &: matrix.Matrix): f64:
ret math.Sqrt(MSE(y, pred))
end
@en "R2Score"
@fa "ضریب تعیین"
pub func R2Score(y &: matrix.Matrix, pred &: matrix.Matrix): f64:
n := y.rows
if n == 0 or pred.rows != n: ret 0.0 end
mut mean := 0.0
repeat n in i: mean += y.at(i, 0) end
mean = mean / (n as f64)
mut ss_res := 0.0
mut ss_tot := 0.0
repeat n in i:
r := y.at(i, 0) - pred.at(i, 0)
t := y.at(i, 0) - mean
ss_res += r * r
ss_tot += t * t
end
if ss_tot == 0.0: ret 0.0 end
ret 1.0 - ss_res / ss_tot
end
@en "RocCurve"
@fa "منحنی راک"
pub func RocCurve(y &: matrix.Matrix, score &: matrix.Matrix): matrix.Matrix:
n := y.rows
if n == 0 or score.rows != n: ret matrix.Matrix {} end
mut npos := 0
mut nneg := 0
_pos_neg(y, npos, nneg)
if npos == 0 or nneg == 0: ret matrix.Matrix {} end
mut order := _by_score_desc(score)
mut rows := Vector {} as Vector<f64>
rows.push(1.0e300)
rows.push(0.0)
rows.push(0.0)
mut tp := 0.0
mut fp := 0.0
mut i := 0
until i < n:
t := score.at(order.get(i), 0)
mut j := i
until j < n and score.at(order.get(j), 0) == t:
if y.at(order.get(j), 0) == 1.0: tp += 1.0 else:
fp += 1.0
end
j += 1
end
rows.push(t)
rows.push(fp / (nneg as f64))
rows.push(tp / (npos as f64))
i = j
end
order.free()
m := rows.len() / 3
mut out := matrix.Zeros(m, 3)
repeat rows.len() in k: out.a.set(k, rows.get(k)) end
rows.free()
ret out
end
@en "PrecisionRecallCurve"
@fa "منحنی صحت بازیابی"
pub func PrecisionRecallCurve(y &: matrix.Matrix, score &: matrix.Matrix): matrix.Matrix:
n := y.rows
if n == 0 or score.rows != n: ret matrix.Matrix {} end
mut npos := 0
mut nneg := 0
_pos_neg(y, npos, nneg)
if npos == 0: ret matrix.Matrix {} end
mut order := _by_score_desc(score)
mut rows := Vector {} as Vector<f64>
mut tp := 0.0
mut fp := 0.0
mut i := 0
until i < n:
t := score.at(order.get(i), 0)
mut j := i
until j < n and score.at(order.get(j), 0) == t:
if y.at(order.get(j), 0) == 1.0: tp += 1.0 else:
fp += 1.0
end
j += 1
end
rows.push(t)
rows.push(tp / (npos as f64))
rows.push(tp / (tp + fp))
i = j
end
order.free()
m := rows.len() / 3
mut out := matrix.Zeros(m, 3)
repeat rows.len() in k: out.a.set(k, rows.get(k)) end
rows.free()
ret out
end
@en "AveragePrecision"
@fa "میانگین صحت"
pub func AveragePrecision(y &: matrix.Matrix, score &: matrix.Matrix): f64:
mut c := PrecisionRecallCurve(y, score)
if c.is_empty(): ret 0.0 end
mut ap := 0.0
mut prev := 0.0
repeat c.rows in i:
r := c.at(i, 1)
ap += (r - prev) * c.at(i, 2)
prev = r
end
matrix.Free(c)
ret ap
end
@en "BalancedAccuracy"
@fa "دقت متوازن"
pub func BalancedAccuracy(y &: matrix.Matrix, pred &: matrix.Matrix): f64:
n := y.rows
if n == 0 or pred.rows != n: ret 0.0 end
k := CountClasses(y)
if k < 1: ret 0.0 end
mut hits := Vector {} as Vector<f64>
mut total := Vector {} as Vector<f64>
repeat k:
hits.push(0.0)
total.push(0.0)
end
repeat n in i:
c := y.at(i, 0) as int
if c < 0 or c >= k: continue end
total.set(c, total.get(c) + 1.0)
if pred.at(i, 0) == y.at(i, 0): hits.set(c, hits.get(c) + 1.0) end
end
mut s := 0.0
mut seen := 0
repeat k in c:
if total.get(c) > 0.0:
s += hits.get(c) / total.get(c)
seen += 1
end
end
hits.free()
total.free()
if seen == 0: ret 0.0 end
ret s / (seen as f64)
end
@en "MatthewsCorrCoef"
@fa "ضریب همبستگی متیوز"
pub func MatthewsCorrCoef(y &: matrix.Matrix, pred &: matrix.Matrix): f64:
k := CountClasses(y)
if k < 1: ret 0.0 end
mut cm := ConfusionMatrix(y, pred, k)
if cm.is_empty(): ret 0.0 end
mut total := 0.0
mut correct := 0.0
mut rowsum := Vector {} as Vector<f64>
mut colsum := Vector {} as Vector<f64>
repeat k:
rowsum.push(0.0)
colsum.push(0.0)
end
repeat k in i:
repeat k in j:
v := cm.at(i, j)
total += v
rowsum.set(i, rowsum.get(i) + v)
colsum.set(j, colsum.get(j) + v)
if i == j: correct += v end
end
end
mut dot := 0.0
mut rr := 0.0
mut cc := 0.0
repeat k in i:
dot += rowsum.get(i) * colsum.get(i)
rr += rowsum.get(i) * rowsum.get(i)
cc += colsum.get(i) * colsum.get(i)
end
rowsum.free()
colsum.free()
matrix.Free(cm)
den := math.Sqrt(total * total - rr) * math.Sqrt(total * total - cc)
if den == 0.0: ret 0.0 end
ret (correct * total - dot) / den
end
@en "CohenKappa"
@fa "کاپای کوهن"
pub func CohenKappa(y &: matrix.Matrix, pred &: matrix.Matrix): f64:
k := CountClasses(y)
if k < 1: ret 0.0 end
mut cm := ConfusionMatrix(y, pred, k)
if cm.is_empty(): ret 0.0 end
mut total := 0.0
mut correct := 0.0
mut rowsum := Vector {} as Vector<f64>
mut colsum := Vector {} as Vector<f64>
repeat k:
rowsum.push(0.0)
colsum.push(0.0)
end
repeat k in i:
repeat k in j:
v := cm.at(i, j)
total += v
rowsum.set(i, rowsum.get(i) + v)
colsum.set(j, colsum.get(j) + v)
if i == j: correct += v end
end
end
mut chance := 0.0
repeat k in i: chance += rowsum.get(i) * colsum.get(i) end
rowsum.free()
colsum.free()
matrix.Free(cm)
if total == 0.0: ret 0.0 end
po := correct / total
pe := chance / (total * total)
if pe == 1.0: ret 0.0 end
ret (po - pe) / (1.0 - pe)
end
@en "ExplainedVariance"
@fa "واریانس تبیین‌شده"
pub func ExplainedVariance(y &: matrix.Matrix, pred &: matrix.Matrix): f64:
n := y.rows
if n == 0 or pred.rows != n: ret 0.0 end
nf := n as f64
mut mr := 0.0
mut my := 0.0
repeat n in i:
mr += y.at(i, 0) - pred.at(i, 0)
my += y.at(i, 0)
end
mr = mr / nf
my = my / nf
mut vr := 0.0
mut vy := 0.0
repeat n in i:
a := (y.at(i, 0) - pred.at(i, 0)) - mr
b := y.at(i, 0) - my
vr += a * a
vy += b * b
end
if vy == 0.0: ret 0.0 end
ret 1.0 - vr / vy
end
@en "MedianAbsoluteError"
@fa "میانه خطای مطلق"
pub func MedianAbsoluteError(y &: matrix.Matrix, pred &: matrix.Matrix): f64:
n := y.rows
if n == 0 or pred.rows != n: ret 0.0 end
mut d := Vector {} as Vector<f64>
repeat n in i: d.push(math.Abs(y.at(i, 0) - pred.at(i, 0))) end
sort.Sort(d)
mut m := d.get(n / 2)
if n % 2 == 0: m = (d.get(n / 2 - 1) + d.get(n / 2)) / 2.0 end
d.free()
ret m
end
@en "MAPE"
@fa "میانگین درصد خطای مطلق"
pub func MAPE(y &: matrix.Matrix, pred &: matrix.Matrix): f64:
n := y.rows
if n == 0 or pred.rows != n: ret 0.0 end
mut s := 0.0
mut seen := 0
repeat n in i:
t := y.at(i, 0)
if t == 0.0: continue end
s += math.Abs((t - pred.at(i, 0)) / t)
seen += 1
end
if seen == 0: ret 0.0 end
ret s / (seen as f64)
end
package ml
import math
import matrix
@en "SilhouetteScore"
@fa "امتیاز سایه‌نما"
pub func SilhouetteScore(x &: matrix.Matrix, labels &: matrix.Matrix): f64:
n := x.rows
if n < 2 or labels.rows != n: ret 0.0 end
k := CountClasses(labels)
if k < 2: ret 0.0 end
mut counts := Vector {} as Vector<int>
counts.zeros(k)
repeat n in i:
c := labels.at(i, 0) as int
if c >= 0: counts.set(c, counts.get(c) + 1) end
end
mut sums := Vector {} as Vector<f64>
mut total := 0.0
mut scored := 0
repeat n in i:
ci := labels.at(i, 0) as int
if ci < 0 or counts.get(ci) < 2: continue end
sums.clear()
repeat k: sums.push(0.0) end
repeat n in j:
cj := labels.at(j, 0) as int
if j != i and cj >= 0:
sums.set(cj, sums.get(cj) + math.Sqrt(_sqdist(x, i, x, j)))
end
end
a := sums.get(ci) / ((counts.get(ci) - 1) as f64)
mut b := 1.0e300
repeat k in c:
if c != ci and counts.get(c) > 0:
v := sums.get(c) / (counts.get(c) as f64)
if v < b: b = v end
end
end
mut denom := a
if b > denom: denom = b end
if denom > 0.0: total += (b - a) / denom end
scored += 1
end
counts.free()
sums.free()
if scored == 0: ret 0.0 end
ret total / (scored as f64)
end
@en "AdjustedRandIndex"
@fa "شاخص رند تعدیل‌شده"
pub func AdjustedRandIndex(a &: matrix.Matrix, b &: matrix.Matrix): f64:
n := a.rows
if n < 2 or b.rows != n: ret 0.0 end
ka := CountClasses(a) + 1
kb := CountClasses(b) + 1
mut table := matrix.Zeros(ka, kb)
repeat n in i:
mut ia := a.at(i, 0) as int
mut ib := b.at(i, 0) as int
if ia < 0: ia = ka - 1 end
if ib < 0: ib = kb - 1 end
table.add_at(ia, ib, 1.0)
end
mut sum_cells := 0.0
mut sum_rows := 0.0
mut sum_cols := 0.0
repeat ka in i:
mut r := 0.0
repeat kb in j:
v := table.at(i, j)
sum_cells += v * (v - 1.0) / 2.0
r += v
end
sum_rows += r * (r - 1.0) / 2.0
end
repeat kb in j:
mut c := 0.0
repeat ka in i: c += table.at(i, j) end
sum_cols += c * (c - 1.0) / 2.0
end
matrix.Free(table)
nf := n as f64
total := nf * (nf - 1.0) / 2.0
expected := sum_rows * sum_cols / total
max_index := (sum_rows + sum_cols) / 2.0
if max_index == expected: ret 1.0 end
ret (sum_cells - expected) / (max_index - expected)
end
package ml
import matrix
import sort
@en "KNNClassifier"
@fa "دسته‌بند نزدیک‌ترین همسایه"
pub struct KNNClassifier:
pub k: int = 5
pub weighted: bool = false
pub algorithm: int = KNN_BRUTE
pub leaf_size: int = 16
pub workers: int = 0
pub xtrain: matrix.Matrix = matrix.Matrix {}
pub ytrain: matrix.Matrix = matrix.Matrix {}
pub tree: KDTree = KDTree {}
pub n_classes: int = 0
pub ok: bool = false
@en "fit"
@fa "برازش"
pub func fit(x &: matrix.Matrix, y &: matrix.Matrix): bool:
this.ok = false
if x.is_empty() or y.rows != x.rows or y.cols != 1 or this.k < 1: ret false end
matrix.Free(this.xtrain)
matrix.Free(this.ytrain)
this.xtrain = matrix.Clone(x)
this.ytrain = matrix.Clone(y)
this.n_classes = CountClasses(y)
this.tree.free()
if this.algorithm == KNN_KDTREE:
this.tree.leaf_size = this.leaf_size
if not this.tree.build(x): ret false end
end
this.ok = this.n_classes > 0
ret this.ok
end
@en "predict_proba"
@fa "پیش‌بینی احتمال"
pub func predict_proba(x &: matrix.Matrix): matrix.Matrix:
if this.ok == false or x.cols != this.xtrain.cols: ret matrix.Matrix {} end
mut out := matrix.Zeros(x.rows, this.n_classes)
_knn_run(x, this.xtrain, this.ytrain, this.tree, out, this.k, this.weighted, this.n_classes, this.algorithm, this.workers)
ret out
end
@en "predict"
@fa "پیش‌بینی"
pub func predict(x &: matrix.Matrix): matrix.Matrix:
mut probs := this.predict_proba(x)
if probs.is_empty(): ret probs end
mut out := matrix.Zeros(x.rows, 1)
repeat x.rows in i:
mut best := 0
repeat this.n_classes in c:
if probs.at(i, c) > probs.at(i, best): best = c end
end
out.set(i, 0, best as f64)
end
matrix.Free(probs)
ret out
end
@en "score"
@fa "امتیاز"
pub func score(x &: matrix.Matrix, y &: matrix.Matrix): f64:
mut p := this.predict(x)
if p.is_empty(): ret 0.0 end
r := Accuracy(y, p)
matrix.Free(p)
ret r
end
@en "free"
@fa "آزادسازی"
pub func free():
matrix.Free(this.xtrain)
matrix.Free(this.ytrain)
this.tree.free()
end
end
@en "KNNRegressor"
@fa "رگرسور نزدیک‌ترین همسایه"
pub struct KNNRegressor:
pub k: int = 5
pub weighted: bool = false
pub algorithm: int = KNN_BRUTE
pub leaf_size: int = 16
pub workers: int = 0
pub xtrain: matrix.Matrix = matrix.Matrix {}
pub ytrain: matrix.Matrix = matrix.Matrix {}
pub tree: KDTree = KDTree {}
pub ok: bool = false
@en "fit"
@fa "برازش"
pub func fit(x &: matrix.Matrix, y &: matrix.Matrix): bool:
this.ok = false
if x.is_empty() or y.rows != x.rows or y.cols != 1 or this.k < 1: ret false end
matrix.Free(this.xtrain)
matrix.Free(this.ytrain)
this.xtrain = matrix.Clone(x)
this.ytrain = matrix.Clone(y)
this.tree.free()
if this.algorithm == KNN_KDTREE:
this.tree.leaf_size = this.leaf_size
if not this.tree.build(x): ret false end
end
this.ok = true
ret true
end
@en "predict"
@fa "پیش‌بینی"
pub func predict(x &: matrix.Matrix): matrix.Matrix:
if this.ok == false or x.cols != this.xtrain.cols: ret matrix.Matrix {} end
mut out := matrix.Zeros(x.rows, 1)
_knn_run(x, this.xtrain, this.ytrain, this.tree, out, this.k, this.weighted, 0, this.algorithm, this.workers)
ret out
end
@en "score"
@fa "امتیاز"
pub func score(x &: matrix.Matrix, y &: matrix.Matrix): f64:
mut p := this.predict(x)
if p.is_empty(): ret 0.0 end
r := R2Score(y, p)
matrix.Free(p)
ret r
end
@en "free"
@fa "آزادسازی"
pub func free():
matrix.Free(this.xtrain)
matrix.Free(this.ytrain)
this.tree.free()
end
end
func _nearest(xtrain &: matrix.Matrix, x &: matrix.Matrix, qi: int, k: int, dist_out &: Vector<f64>): Vector<int>:
n := xtrain.rows
p := xtrain.cols
mut d := Vector {} as Vector<f64>
repeat n in i:
mut s := 0.0
repeat p in j:
t := x.at(qi, j) - xtrain.at(i, j)
s += t * t
end
d.push(s)
end
mut idx := Vector {} as Vector<int>
repeat n in i: idx.push(i) end
sort.SortIndex(idx, d)
mut out := Vector {} as Vector<int>
dist_out.clear()
mut kk := k
if kk > n: kk = n end
repeat kk in i:
out.push(idx.get(i))
dist_out.push(d.get(idx.get(i)))
end
d.free()
idx.free()
ret out
end
package ml
import math
import matrix
import sort
import str
@en "StandardScaler"
@fa "مقیاس‌گر استاندارد"
pub struct StandardScaler:
pub with_mean: bool = true
pub with_std: bool = true
pub mean: matrix.Matrix = matrix.Matrix {}
pub std: matrix.Matrix = matrix.Matrix {}
pub ok: bool = false
@en "fit"
@fa "برازش"
pub func fit(x &: matrix.Matrix): bool:
this.ok = false
if x.is_empty(): ret false end
matrix.Free(this.mean)
matrix.Free(this.std)
this.mean = matrix.Zeros(1, x.cols)
this.std = matrix.Ones(1, x.cols)
repeat x.cols in j:
m := _col_mean(x, j)
this.mean.set(0, j, m)
s := _col_std(x, j, m)
if s > 0.0: this.std.set(0, j, s) end
end
this.ok = true
ret true
end
@en "transform"
@fa "تبدیل"
pub func transform(x &: matrix.Matrix): matrix.Matrix:
if this.ok == false or x.cols != this.mean.cols: ret matrix.Matrix {} end
mut r := matrix.Clone(x)
repeat x.cols in j:
mut m := 0.0
if this.with_mean: m = this.mean.at(0, j) end
mut s := 1.0
if this.with_std: s = this.std.at(0, j) end
repeat x.rows in i: r.set(i, j, (x.at(i, j) - m) / s) end
end
ret r
end
@en "fit_transform"
@fa "برازش سپس تبدیل"
pub func fit_transform(x &: matrix.Matrix): matrix.Matrix:
if this.fit(x) == false: ret matrix.Matrix {} end
ret this.transform(x)
end
@en "inverse_transform"
@fa "تبدیل معکوس"
pub func inverse_transform(x &: matrix.Matrix): matrix.Matrix:
if this.ok == false or x.cols != this.mean.cols: ret matrix.Matrix {} end
mut r := matrix.Clone(x)
repeat x.cols in j:
mut m := 0.0
if this.with_mean: m = this.mean.at(0, j) end
mut s := 1.0
if this.with_std: s = this.std.at(0, j) end
repeat x.rows in i: r.set(i, j, x.at(i, j) * s + m) end
end
ret r
end
@en "free"
@fa "آزادسازی"
pub func free():
matrix.Free(this.mean)
matrix.Free(this.std)
end
end
@en "MinMaxScaler"
@fa "مقیاس‌گر کمینه‌بیشینه"
pub struct MinMaxScaler:
pub lo: f64 = 0.0
pub hi: f64 = 1.0
pub data_min: matrix.Matrix = matrix.Matrix {}
pub data_range: matrix.Matrix = matrix.Matrix {}
pub ok: bool = false
@en "fit"
@fa "برازش"
pub func fit(x &: matrix.Matrix): bool:
this.ok = false
if x.is_empty(): ret false end
matrix.Free(this.data_min)
matrix.Free(this.data_range)
this.data_min = matrix.Zeros(1, x.cols)
this.data_range = matrix.Ones(1, x.cols)
repeat x.cols in j:
mut mn := x.at(0, j)
mut mx := mn
repeat x.rows in i:
v := x.at(i, j)
if v < mn: mn = v end
if v > mx: mx = v end
end
this.data_min.set(0, j, mn)
if mx > mn: this.data_range.set(0, j, mx - mn) end
end
this.ok = true
ret true
end
@en "transform"
@fa "تبدیل"
pub func transform(x &: matrix.Matrix): matrix.Matrix:
if this.ok == false or x.cols != this.data_min.cols: ret matrix.Matrix {} end
mut r := matrix.Clone(x)
span := this.hi - this.lo
repeat x.cols in j:
mn := this.data_min.at(0, j)
rg := this.data_range.at(0, j)
repeat x.rows in i: r.set(i, j, this.lo + (x.at(i, j) - mn) / rg * span) end
end
ret r
end
@en "fit_transform"
@fa "برازش سپس تبدیل"
pub func fit_transform(x &: matrix.Matrix): matrix.Matrix:
if this.fit(x) == false: ret matrix.Matrix {} end
ret this.transform(x)
end
@en "inverse_transform"
@fa "تبدیل معکوس"
pub func inverse_transform(x &: matrix.Matrix): matrix.Matrix:
if this.ok == false or x.cols != this.data_min.cols: ret matrix.Matrix {} end
mut r := matrix.Clone(x)
span := this.hi - this.lo
repeat x.cols in j:
mn := this.data_min.at(0, j)
rg := this.data_range.at(0, j)
repeat x.rows in i: r.set(i, j, (x.at(i, j) - this.lo) / span * rg + mn) end
end
ret r
end
@en "free"
@fa "آزادسازی"
pub func free():
matrix.Free(this.data_min)
matrix.Free(this.data_range)
end
end
@en "LabelEncoder"
@fa "رمزگذار برچسب"
pub struct LabelEncoder:
pub classes: Vector<str> = Vector {}
pub ok: bool = false
@en "fit"
@fa "برازش"
pub func fit(labels &: Vector<str>): bool:
this.classes.clear()
repeat labels.len() in i:
if this.index_of(labels.get(i)) < 0: this.classes.push(labels.get(i)) end
end
this.ok = this.classes.len() > 0
ret this.ok
end
@en "index_of"
@fa "نمایه"
pub func index_of(label: str): int:
repeat this.classes.len() in i:
if str.Equals(this.classes.get(i), label): ret i end
end
ret 0 - 1
end
@en "transform"
@fa "تبدیل"
pub func transform(labels &: Vector<str>): matrix.Matrix:
if this.ok == false: ret matrix.Matrix {} end
mut y := matrix.Zeros(labels.len(), 1)
repeat labels.len() in i: y.set(i, 0, this.index_of(labels.get(i)) as f64) end
ret y
end
@en "fit_transform"
@fa "برازش سپس تبدیل"
pub func fit_transform(labels &: Vector<str>): matrix.Matrix:
if this.fit(labels) == false: ret matrix.Matrix {} end
ret this.transform(labels)
end
@en "inverse_transform"
@fa "تبدیل معکوس"
pub func inverse_transform(y &: matrix.Matrix): Vector<str>:
mut out := Vector {} as Vector<str>
repeat y.rows in i:
k := y.at(i, 0) as int
if k >= 0 and k < this.classes.len():
out.push(this.classes.get(k))
else:
out.push("")
end
end
ret out
end
@en "free"
@fa "آزادسازی"
pub func free(): this.classes.free() end
end
@en "OneHotEncoder"
@fa "رمزگذار تک‌داغ"
pub struct OneHotEncoder:
pub n_classes: int = 0
pub ok: bool = false
@en "fit"
@fa "برازش"
pub func fit(y &: matrix.Matrix): bool:
this.n_classes = CountClasses(y)
this.ok = this.n_classes > 0
ret this.ok
end
@en "transform"
@fa "تبدیل"
pub func transform(y &: matrix.Matrix): matrix.Matrix:
if this.ok == false: ret matrix.Matrix {} end
mut r := matrix.Zeros(y.rows, this.n_classes)
repeat y.rows in i:
k := y.at(i, 0) as int
if k >= 0 and k < this.n_classes: r.set(i, k, 1.0) end
end
ret r
end
@en "fit_transform"
@fa "برازش سپس تبدیل"
pub func fit_transform(y &: matrix.Matrix): matrix.Matrix:
if this.fit(y) == false: ret matrix.Matrix {} end
ret this.transform(y)
end
@en "inverse_transform"
@fa "تبدیل معکوس"
pub func inverse_transform(onehot &: matrix.Matrix): matrix.Matrix:
mut y := matrix.Zeros(onehot.rows, 1)
repeat onehot.rows in i:
mut best := 0
repeat onehot.cols in j:
if onehot.at(i, j) > onehot.at(i, best): best = j end
end
y.set(i, 0, best as f64)
end
ret y
end
end
@en "SimpleImputer"
@fa "جایگذار ساده"
pub struct SimpleImputer:
pub strategy: int = IMPUTE_MEAN
pub fill: f64 = 0.0
pub stats: matrix.Matrix = matrix.Matrix {}
pub ok: bool = false
@en "fit"
@fa "برازش"
pub func fit(x &: matrix.Matrix): bool:
this.ok = false
if x.is_empty(): ret false end
matrix.Free(this.stats)
this.stats = matrix.Zeros(1, x.cols)
repeat x.cols in j:
mut v := this.fill
if this.strategy == IMPUTE_MEAN:
v = _col_mean_nan(x, j)
else this.strategy == IMPUTE_MEDIAN:
v = _col_median_nan(x, j)
end
this.stats.set(0, j, v)
end
this.ok = true
ret true
end
@en "transform"
@fa "تبدیل"
pub func transform(x &: matrix.Matrix): matrix.Matrix:
if this.ok == false or x.cols != this.stats.cols: ret matrix.Matrix {} end
mut r := matrix.Clone(x)
repeat x.cols in j:
v := this.stats.at(0, j)
repeat x.rows in i:
if math.IsNaN(x.at(i, j)): r.set(i, j, v) end
end
end
ret r
end
@en "fit_transform"
@fa "برازش سپس تبدیل"
pub func fit_transform(x &: matrix.Matrix): matrix.Matrix:
if this.fit(x) == false: ret matrix.Matrix {} end
ret this.transform(x)
end
@en "free"
@fa "آزادسازی"
pub func free(): matrix.Free(this.stats) end
end
@en "PolynomialFeatures"
@fa "ویژگی چندجمله‌ای"
pub struct PolynomialFeatures:
pub degree: int = 2
pub include_bias: bool = false
@en "transform"
@fa "تبدیل"
pub func transform(x &: matrix.Matrix): matrix.Matrix:
if x.is_empty() or this.degree < 1: ret matrix.Matrix {} end
p := x.cols
mut cols := _poly_count(p, this.degree)
mut offset := 0
if this.include_bias:
cols += 1
offset = 1
end
mut r := matrix.Zeros(x.rows, cols)
if this.include_bias:
repeat x.rows in i: r.set(i, 0, 1.0) end
end
mut col := offset
repeat this.degree in kk:
k := kk + 1
mut idx := Vector {} as Vector<int>
idx.zeros(k)
mut more := true
until more:
repeat x.rows in i:
mut v := 1.0
repeat k in t: v = v * x.at(i, idx.get(t)) end
r.set(i, col, v)
end
col += 1
mut pos := k - 1
until pos >= 0 and idx.get(pos) == p - 1: pos -= 1 end
if pos < 0:
more = false
else:
nv := idx.get(pos) + 1
mut t := pos
until t < k:
idx.set(t, nv)
t += 1
end
end
end
idx.free()
end
ret r
end
end
func _col_mean(x &: matrix.Matrix, j: int): f64:
mut s := 0.0
repeat x.rows in i: s += x.at(i, j) end
ret s / (x.rows as f64)
end
func _col_std(x &: matrix.Matrix, j: int, mean: f64): f64:
mut s := 0.0
repeat x.rows in i:
d := x.at(i, j) - mean
s += d * d
end
ret math.Sqrt(s / (x.rows as f64))
end
func _col_mean_nan(x &: matrix.Matrix, j: int): f64:
mut s := 0.0
mut c := 0
repeat x.rows in i:
v := x.at(i, j)
if math.IsNaN(v) == false:
s += v
c += 1
end
end
if c == 0: ret 0.0 end
ret s / (c as f64)
end
func _col_median_nan(x &: matrix.Matrix, j: int): f64:
mut vals := Vector {} as Vector<f64>
repeat x.rows in i:
v := x.at(i, j)
if math.IsNaN(v) == false: vals.push(v) end
end
n := vals.len()
if n == 0:
vals.free()
ret 0.0
end
sort.Sort(vals)
mut m := vals.get(n / 2)
if n % 2 == 0: m = (vals.get(n / 2 - 1) + vals.get(n / 2)) / 2.0 end
vals.free()
ret m
end
func _poly_count(p: int, d: int): int:
mut total := 0
repeat d in kk:
k := kk + 1
mut c := 1
repeat k in i:
c = c * (p + i) / (i + 1)
end
total += c
end
ret total
end
package ml
import matrix
import pool
@en "Split"
@fa "تقسیم"
pub struct Split:
pub x_train: matrix.Matrix = matrix.Matrix {}
pub x_test: matrix.Matrix = matrix.Matrix {}
pub y_train: matrix.Matrix = matrix.Matrix {}
pub y_test: matrix.Matrix = matrix.Matrix {}
@en "free"
@fa "آزادسازی"
pub func free():
matrix.Free(this.x_train)
matrix.Free(this.x_test)
matrix.Free(this.y_train)
matrix.Free(this.y_test)
end
end
@en "Folds"
@fa "برش‌ها"
pub struct Folds:
pub train: Vector<Vector<int>> = Vector {}
pub test: Vector<Vector<int>> = Vector {}
@en "count"
@fa "شمار"
pub func count(): int: ret this.test.len() end
@en "free"
@fa "آزادسازی"
pub func free():
repeat this.train.len() in i:
mut t := this.train.get(i)
t.free()
end
repeat this.test.len() in i:
mut t := this.test.get(i)
t.free()
end
this.train.free()
this.test.free()
end
end
@en "GridResult"
@fa "نتیجه جستجوی شبکه‌ای"
pub struct GridResult:
pub scores: Vector<f64> = Vector {}
pub best: int = 0 - 1
pub best_score: f64 = 0.0
@en "free"
@fa "آزادسازی"
pub func free(): this.scores.free() end
end
@en "Candidate"
@fa "نامزد"
pub struct Candidate:
pub name: str = ""
pub fit: func (matrix.Matrix, matrix.Matrix, matrix.Matrix) matrix.Matrix = (a: matrix.Matrix, b: matrix.Matrix, c: matrix.Matrix): ret matrix.Matrix {} end
end
func _permutation(n: int, seed: i64): Vector<int>:
mut p := Vector {} as Vector<int>
repeat n in i: p.push(i) end
mut g := matrix.NewRng(seed)
mut i := n - 1
until i > 0:
j := (g.next_float() * ((i + 1) as f64)) as int
t := p.get(i)
p.set(i, p.get(j))
p.set(j, t)
i -= 1
end
ret p
end
func _take_rows(x &: matrix.Matrix, idx &: Vector<int>): matrix.Matrix:
mut r := matrix.Zeros(idx.len(), x.cols)
repeat idx.len() in i:
src := idx.get(i)
repeat x.cols in j: r.set(i, j, x.at(src, j)) end
end
ret r
end
func _complete_folds(n: int, f &: Folds):
repeat f.test.len() in k:
mut mask := Vector {} as Vector<bool>
mask.zeros(n)
tv := f.test.get(k)
repeat tv.len() in i: mask.set(tv.get(i), true) end
mut tr := Vector {} as Vector<int>
repeat n in i:
if mask.get(i) == false: tr.push(i) end
end
mask.free()
f.train.push(tr)
end
end
@en "TrainTestSplit"
@fa "تقسیم آموزش‌آزمون"
pub func TrainTestSplit(x &: matrix.Matrix, y &: matrix.Matrix, test_frac: f64, seed: i64): Split:
mut s := Split {}
n := x.rows
if n == 0 or y.rows != n: ret s end
mut ntest := (test_frac * (n as f64) + 0.5) as int
if ntest < 1: ntest = 1 end
if ntest >= n: ntest = n - 1 end
mut perm := _permutation(n, seed)
mut te := Vector {} as Vector<int>
mut tr := Vector {} as Vector<int>
repeat n in i:
if i < ntest: te.push(perm.get(i))
else:
tr.push(perm.get(i))
end
end
s.x_train = _take_rows(x, tr)
s.y_train = _take_rows(y, tr)
s.x_test = _take_rows(x, te)
s.y_test = _take_rows(y, te)
perm.free()
te.free()
tr.free()
ret s
end
@en "KFold"
@fa "کی برش"
pub func KFold(n: int, k: int, shuffle: bool, seed: i64): Folds:
mut f := Folds {}
if k < 2 or n < k: ret f end
mut order := Vector {} as Vector<int>
if shuffle:
order = _permutation(n, seed)
else:
repeat n in i: order.push(i) end
end
mut start := 0
repeat k in fold:
mut size := n / k
if fold < n % k: size += 1 end
mut te := Vector {} as Vector<int>
repeat size in i: te.push(order.get(start + i)) end
f.test.push(te)
start += size
end
order.free()
_complete_folds(n, f)
ret f
end
@en "StratifiedKFold"
@fa "کی برش طبقه‌ای"
pub func StratifiedKFold(y &: matrix.Matrix, k: int, seed: i64): Folds:
mut f := Folds {}
n := y.rows
if k < 2 or n < k: ret f end
repeat k: f.test.push(Vector {} as Vector<int>) end
nc := CountClasses(y)
mut perm := _permutation(n, seed)
repeat nc in c:
mut dealt := 0
repeat n in i:
row := perm.get(i)
if (y.at(row, 0) as int) == c:
mut te := f.test.get(dealt % k)
te.push(row)
f.test.set(dealt % k, te)
dealt += 1
end
end
end
perm.free()
_complete_folds(n, f)
ret f
end
@en "CrossValScore"
@fa "امتیاز اعتبارسنجی متقاطع"
pub func CrossValScore(fitpred: func (matrix.Matrix, matrix.Matrix, matrix.Matrix) matrix.Matrix, metric: func (matrix.Matrix, matrix.Matrix) f64, x &: matrix.Matrix, y &: matrix.Matrix, folds &: Folds): Vector<f64>:
mut scores := Vector {} as Vector<f64>
repeat folds.count() in k:
tr := folds.train.get(k)
te := folds.test.get(k)
mut xtr := _take_rows(x, tr)
mut ytr := _take_rows(y, tr)
mut xte := _take_rows(x, te)
mut yte := _take_rows(y, te)
mut pred := fitpred(xtr, ytr, xte)
mut sc := 0.0
if pred.is_empty() == false: sc = metric(yte, pred) end
scores.push(sc)
matrix.Free(xtr)
matrix.Free(ytr)
matrix.Free(xte)
matrix.Free(yte)
matrix.Free(pred)
end
ret scores
end
@en "MeanScore"
@fa "میانگین امتیاز"
pub func MeanScore(scores &: Vector<f64>): f64:
if scores.len() == 0: ret 0.0 end
mut s := 0.0
repeat scores.len() in i: s += scores.get(i) end
ret s / (scores.len() as f64)
end
@en "CrossValScoreParallel"
@fa "امتیاز اعتبارسنجی متقاطع موازی"
pub func CrossValScoreParallel(fitpred: func (matrix.Matrix, matrix.Matrix, matrix.Matrix) matrix.Matrix, metric: func (matrix.Matrix, matrix.Matrix) f64, x &: matrix.Matrix, y &: matrix.Matrix, folds &: Folds, workers: int): Vector<f64>:
mut w := workers
if w < 0: w = pool.CPUCount() as int end
if w <= 1: ret CrossValScore(fitpred, metric, x, y, folds) end
k := folds.count()
mut scores := Vector {} as Vector<f64>
repeat k: scores.push(0.0) end
xs := x
ys := y
fs := folds
pool.ParallelFor(
k as i64, w as i64, (i: i64): f := i as int tr := fs.train.get(f) te := fs.test.get(f) mut xtr := _take_rows(xs, tr) mut ytr := _take_rows(ys, tr) mut xte := _take_rows(xs, te) mut yte := _take_rows(ys, te) mut pred := fitpred(xtr, ytr, xte) mut sc := 0.0 if pred.is_empty() == false: sc = metric(yte, pred) end scores.set(f, sc) matrix.Free(xtr) matrix.Free(ytr) matrix.Free(xte) matrix.Free(yte) matrix.Free(pred) end
)
ret scores
end
@en "GridSearch"
@fa "جستجوی شبکه‌ای"
pub func GridSearch(candidates &: Vector<Candidate>, metric: func (matrix.Matrix, matrix.Matrix) f64, x &: matrix.Matrix, y &: matrix.Matrix, folds &: Folds, workers: int): GridResult:
mut r := GridResult {}
n := candidates.len()
repeat n: r.scores.push(0.0) end
mut w := workers
if w < 0: w = pool.CPUCount() as int end
if w <= 1 or n <= 1:
repeat n in c:
mut sc := CrossValScore(candidates.get(c).fit, metric, x, y, folds)
r.scores.set(c, MeanScore(sc))
sc.free()
end
else:
xs := x
ys := y
fs := folds
cs := candidates
out := r.scores
pool.ParallelFor(
n as i64, w as i64, (i: i64): c := i as int mut sc := CrossValScore(cs.get(c).fit, metric, xs, ys, fs) out.set(c, MeanScore(sc)) sc.free() end
)
end
repeat n in c:
if r.best < 0 or r.scores.get(c) > r.best_score:
r.best = c
r.best_score = r.scores.get(c)
end
end
ret r
end
package ml
import math
import matrix
@en "KERNEL_LINEAR"
@fa "هسته خطی"
pub const KERNEL_LINEAR := 0
@en "KERNEL_RBF"
@fa "هسته شعاعی"
pub const KERNEL_RBF := 1
@en "KERNEL_POLY"
@fa "هسته چندجمله‌ای"
pub const KERNEL_POLY := 2
@en "LinearSVM"
@fa "ماشین بردار پشتیبان خطی"
pub struct LinearSVM:
pub c: f64 = 1.0
pub max_iter: int = 1000
pub tol: f64 = 0.0001
pub seed: i64 = 42
pub coef: matrix.Matrix = matrix.Matrix {}
pub intercept: matrix.Matrix = matrix.Matrix {}
pub n_classes: int = 0
pub ok: bool = false
@en "fit"
@fa "برازش"
pub func fit(x &: matrix.Matrix, y &: matrix.Matrix): bool:
this.ok = false
if x.is_empty() or y.rows != x.rows or y.cols != 1: ret false end
k := CountClasses(y)
if k < 2: ret false end
p := x.cols
mut ncol := k
if k == 2: ncol = 1 end
matrix.Free(this.coef)
matrix.Free(this.intercept)
this.coef = matrix.Zeros(p, ncol)
this.intercept = matrix.Zeros(1, ncol)
repeat ncol in c:
mut target := c
if k == 2: target = 1 end
mut w := matrix.Zeros(p + 1, 1)
_dual_cd(x, y, target, this.c, this.max_iter, this.tol, this.seed + (c as i64), w)
repeat p in j: this.coef.set(j, c, w.at(j, 0)) end
this.intercept.set(0, c, w.at(p, 0))
matrix.Free(w)
end
this.n_classes = k
this.ok = true
ret true
end
@en "decision"
@fa "تصمیم"
pub func decision(x &: matrix.Matrix): matrix.Matrix:
if this.ok == false or x.cols != this.coef.rows: ret matrix.Matrix {} end
mut d := matrix.MatMul(x, this.coef)
repeat d.rows in i:
repeat d.cols in c: d.add_at(i, c, this.intercept.at(0, c)) end
end
ret d
end
@en "predict"
@fa "پیش‌بینی"
pub func predict(x &: matrix.Matrix): matrix.Matrix:
mut d := this.decision(x)
if d.is_empty(): ret d end
mut out := matrix.Zeros(x.rows, 1)
repeat x.rows in i:
if this.n_classes == 2:
if d.at(i, 0) > 0.0: out.set(i, 0, 1.0) end
else:
mut best := 0
repeat d.cols in c:
if d.at(i, c) > d.at(i, best): best = c end
end
out.set(i, 0, best as f64)
end
end
matrix.Free(d)
ret out
end
@en "score"
@fa "امتیاز"
pub func score(x &: matrix.Matrix, y &: matrix.Matrix): f64:
mut p := this.predict(x)
if p.is_empty(): ret 0.0 end
r := Accuracy(y, p)
matrix.Free(p)
ret r
end
@en "free"
@fa "آزادسازی"
pub func free():
matrix.Free(this.coef)
matrix.Free(this.intercept)
end
end
@en "SVC"
@fa "دسته‌بند بردار پشتیبان"
pub struct SVC:
pub c: f64 = 1.0
pub kernel: int = KERNEL_RBF
pub gamma: f64 = 0.0
pub degree: int = 3
pub coef0: f64 = 1.0
pub max_passes: int = 20
pub tol: f64 = 0.001
pub seed: i64 = 42
pub support: matrix.Matrix = matrix.Matrix {}
pub dual: matrix.Matrix = matrix.Matrix {}
pub bias: matrix.Matrix = matrix.Matrix {}
pub n_classes: int = 0
pub ok: bool = false
@en "fit"
@fa "برازش"
pub func fit(x &: matrix.Matrix, y &: matrix.Matrix): bool:
this.ok = false
if x.is_empty() or y.rows != x.rows or y.cols != 1: ret false end
k := CountClasses(y)
if k < 2: ret false end
n := x.rows
p := x.cols
mut gm := this.gamma
if gm <= 0.0: gm = 1.0 / (p as f64) end
mut ncol := k
if k == 2: ncol = 1 end
matrix.Free(this.support)
matrix.Free(this.dual)
matrix.Free(this.bias)
this.support = matrix.Clone(x)
this.dual = matrix.Zeros(n, ncol)
this.bias = matrix.Zeros(1, ncol)
mut km := matrix.Zeros(n, n)
repeat n in i:
repeat n in j:
if j >= i:
v := _kernel(x, i, x, j, this.kernel, gm, this.degree, this.coef0)
km.set(i, j, v)
km.set(j, i, v)
end
end
end
repeat ncol in c:
mut target := c
if k == 2: target = 1 end
mut yv := Vector {} as Vector<f64>
repeat n in i:
if (y.at(i, 0) as int) == target: yv.push(1.0) else:
yv.push(0.0 - 1.0)
end
end
mut alpha := Vector {} as Vector<f64>
alpha.zeros(n)
mut b := 0.0
_smo(km, yv, this.c, this.tol, this.max_passes, this.seed + (c as i64), alpha, b)
repeat n in i: this.dual.set(i, c, alpha.get(i) * yv.get(i)) end
this.bias.set(0, c, b)
yv.free()
alpha.free()
end
matrix.Free(km)
this.gamma = gm
this.n_classes = k
this.ok = true
ret true
end
@en "decision"
@fa "تصمیم"
pub func decision(x &: matrix.Matrix): matrix.Matrix:
if this.ok == false or x.cols != this.support.cols: ret matrix.Matrix {} end
ncol := this.dual.cols
mut d := matrix.Zeros(x.rows, ncol)
repeat x.rows in i:
repeat this.support.rows in s:
mut any := false
repeat ncol in c:
if this.dual.at(s, c) != 0.0: any = true end
end
if any:
kv := _kernel(x, i, this.support, s, this.kernel, this.gamma, this.degree, this.coef0)
repeat ncol in c: d.add_at(i, c, this.dual.at(s, c) * kv) end
end
end
repeat ncol in c: d.add_at(i, c, this.bias.at(0, c)) end
end
ret d
end
@en "predict"
@fa "پیش‌بینی"
pub func predict(x &: matrix.Matrix): matrix.Matrix:
mut d := this.decision(x)
if d.is_empty(): ret d end
mut out := matrix.Zeros(x.rows, 1)
repeat x.rows in i:
if this.n_classes == 2:
if d.at(i, 0) > 0.0: out.set(i, 0, 1.0) end
else:
mut best := 0
repeat d.cols in c:
if d.at(i, c) > d.at(i, best): best = c end
end
out.set(i, 0, best as f64)
end
end
matrix.Free(d)
ret out
end
@en "n_support"
@fa "شمار بردار پشتیبان"
pub func n_support(): int:
mut cnt := 0
repeat this.dual.rows in s:
mut any := false
repeat this.dual.cols in c:
if this.dual.at(s, c) != 0.0: any = true end
end
if any: cnt += 1 end
end
ret cnt
end
@en "score"
@fa "امتیاز"
pub func score(x &: matrix.Matrix, y &: matrix.Matrix): f64:
mut p := this.predict(x)
if p.is_empty(): ret 0.0 end
r := Accuracy(y, p)
matrix.Free(p)
ret r
end
@en "free"
@fa "آزادسازی"
pub func free():
matrix.Free(this.support)
matrix.Free(this.dual)
matrix.Free(this.bias)
end
end
func _kernel(a &: matrix.Matrix, i: int, b &: matrix.Matrix, j: int, kind: int, gamma: f64, degree: int, coef0: f64): f64:
mut dot := 0.0
mut sq := 0.0
repeat a.cols in t:
u := a.at(i, t)
v := b.at(j, t)
dot += u * v
d := u - v
sq += d * d
end
if kind == KERNEL_RBF: ret math.Exp(0.0 - gamma * sq) end
if kind == KERNEL_POLY: ret math.Pow(gamma * dot + coef0, degree as f64) end
ret dot
end
func _dual_cd(x &: matrix.Matrix, y &: matrix.Matrix, target: int, c: f64, max_iter: int, tol: f64, seed: i64, w &: matrix.Matrix):
n := x.rows
p := x.cols
mut alpha := Vector {} as Vector<f64>
alpha.zeros(n)
mut q := Vector {} as Vector<f64>
repeat n in i:
mut s := 1.0
repeat p in j: s += x.at(i, j) * x.at(i, j) end
q.push(s)
end
mut lab := Vector {} as Vector<f64>
repeat n in i:
if (y.at(i, 0) as int) == target: lab.push(1.0) else:
lab.push(0.0 - 1.0)
end
end
mut order := Vector {} as Vector<int>
repeat n in i: order.push(i) end
mut g := matrix.NewRng(seed)
mut it := 0
mut done := false
until it < max_iter and done == false:
mut k := n - 1
until k > 0:
r := (g.next_float() * ((k + 1) as f64)) as int
t := order.get(k)
order.set(k, order.get(r))
order.set(r, t)
k -= 1
end
mut max_change := 0.0
repeat n in oi:
i := order.get(oi)
yi := lab.get(i)
mut margin := w.at(p, 0)
repeat p in j: margin += w.at(j, 0) * x.at(i, j) end
grad := yi * margin - 1.0
a := alpha.get(i)
mut pg := grad
if a == 0.0 and grad > 0.0: pg = 0.0 end
if a == c and grad < 0.0: pg = 0.0 end
if pg != 0.0:
mut na := a - grad / q.get(i)
if na < 0.0: na = 0.0 end
if na > c: na = c end
d := (na - a) * yi
if d != 0.0:
repeat p in j: w.add_at(j, 0, d * x.at(i, j)) end
w.add_at(p, 0, d)
alpha.set(i, na)
end
mut ad := na - a
if ad < 0.0: ad = 0.0 - ad end
if ad > max_change: max_change = ad end
end
end
it += 1
if max_change < tol: done = true end
end
alpha.free()
q.free()
lab.free()
order.free()
end
func _smo(km &: matrix.Matrix, yv &: Vector<f64>, c: f64, tol: f64, max_passes: int, seed: i64, alpha &: Vector<f64>, b &: f64):
n := km.rows
mut g := matrix.NewRng(seed)
mut passes := 0
mut total_iter := 0
until passes < max_passes and total_iter < 200:
mut changed := 0
repeat n in i:
ei := _smo_f(km, yv, alpha, b, i) - yv.get(i)
ai := alpha.get(i)
yi := yv.get(i)
if (yi * ei < 0.0 - tol and ai < c) or (yi * ei > tol and ai > 0.0):
mut j := (g.next_float() * (n as f64)) as int
if j == i: j = (j + 1) % n end
ej := _smo_f(km, yv, alpha, b, j) - yv.get(j)
aj := alpha.get(j)
yj := yv.get(j)
mut lo := 0.0
mut hi := c
if yi != yj:
lo = aj - ai
if lo < 0.0: lo = 0.0 end
hi = c + aj - ai
if hi > c: hi = c end
else:
lo = ai + aj - c
if lo < 0.0: lo = 0.0 end
hi = ai + aj
if hi > c: hi = c end
end
if lo < hi:
eta := 2.0 * km.at(i, j) - km.at(i, i) - km.at(j, j)
if eta < 0.0:
mut naj := aj - yj * (ei - ej) / eta
if naj > hi: naj = hi end
if naj < lo: naj = lo end
mut daj := naj - aj
if daj < 0.0: daj = 0.0 - daj end
if daj > 1.0e-6:
nai := ai + yi * yj * (aj - naj)
b1 := b - ei - yi * (nai - ai) * km.at(i, i) - yj * (naj - aj) * km.at(i, j)
b2 := b - ej - yi * (nai - ai) * km.at(i, j) - yj * (naj - aj) * km.at(j, j)
if nai > 0.0 and nai < c: b = b1
else naj > 0.0 and naj < c: b = b2
else:
b = (b1 + b2) / 2.0
end
alpha.set(i, nai)
alpha.set(j, naj)
changed += 1
end
end
end
end
end
if changed == 0: passes += 1 else:
passes = 0
end
total_iter += 1
end
end
func _smo_f(km &: matrix.Matrix, yv &: Vector<f64>, alpha &: Vector<f64>, b: f64, i: int): f64:
mut s := b
repeat km.rows in t:
a := alpha.get(t)
if a != 0.0: s += a * yv.get(t) * km.at(t, i) end
end
ret s
end
package ml
import math
import matrix
import sort
struct _TreeFrame:
pub node: int = 0
pub lo: int = 0
pub hi: int = 0
pub depth: int = 0
end
@en "DecisionTree"
@fa "درخت تصمیم"
pub struct DecisionTree:
pub criterion: int = TREE_GINI
pub max_depth: int = 16
pub min_samples_split: int = 2
pub min_samples_leaf: int = 1
pub max_features: int = 0
pub seed: i64 = 42
pub n_classes_hint: int = 0
pub feature: Vector<int> = Vector {}
pub threshold: Vector<f64> = Vector {}
pub left: Vector<int> = Vector {}
pub right: Vector<int> = Vector {}
pub value: matrix.Matrix = matrix.Matrix {}
pub n_classes: int = 0
pub ok: bool = false
@en "is_regression"
@fa "رگرسیون است"
pub func is_regression(): bool: ret this.criterion == TREE_MSE end
@en "node_count"
@fa "شمار گره"
pub func node_count(): int: ret this.feature.len() end
@en "fit"
@fa "برازش"
pub func fit(x &: matrix.Matrix, y &: matrix.Matrix): bool:
this.ok = false
if x.is_empty() or y.rows != x.rows or y.cols != 1: ret false end
this.feature.clear()
this.threshold.clear()
this.left.clear()
this.right.clear()
matrix.Free(this.value)
mut k := 1
if this.is_regression() == false:
k = CountClasses(y)
if this.n_classes_hint > k: k = this.n_classes_hint end
if k < 1: ret false end
end
this.n_classes = k
mut values := Vector {} as Vector<f64>
mut me := DecisionTree {}
me.criterion = this.criterion
me.max_depth = this.max_depth
me.min_samples_split = this.min_samples_split
me.min_samples_leaf = this.min_samples_leaf
me.max_features = this.max_features
me.seed = this.seed
_grow_tree(me, x, y, k, values)
this.feature = me.feature
this.threshold = me.threshold
this.left = me.left
this.right = me.right
this.value = matrix.Zeros(this.feature.len(), k)
repeat this.feature.len() * k in t: this.value.a.set(t, values.get(t)) end
values.free()
this.ok = true
ret true
end
@en "apply_row"
@fa "اعمال سطر"
pub func apply_row(x &: matrix.Matrix, i: int): int:
mut node := 0
until this.feature.get(node) >= 0:
if x.at(i, this.feature.get(node)) <= this.threshold.get(node):
node = this.left.get(node)
else:
node = this.right.get(node)
end
end
ret node
end
@en "predict_proba"
@fa "پیش‌بینی احتمال"
pub func predict_proba(x &: matrix.Matrix): matrix.Matrix:
if this.ok == false or this.is_regression(): ret matrix.Matrix {} end
mut out := matrix.Zeros(x.rows, this.n_classes)
repeat x.rows in i:
node := this.apply_row(x, i)
mut total := 0.0
repeat this.n_classes in c: total += this.value.at(node, c) end
if total > 0.0:
repeat this.n_classes in c: out.set(i, c, this.value.at(node, c) / total) end
end
end
ret out
end
@en "predict"
@fa "پیش‌بینی"
pub func predict(x &: matrix.Matrix): matrix.Matrix:
if this.ok == false: ret matrix.Matrix {} end
mut out := matrix.Zeros(x.rows, 1)
repeat x.rows in i:
node := this.apply_row(x, i)
if this.is_regression():
out.set(i, 0, this.value.at(node, 0))
else:
mut best := 0
repeat this.n_classes in c:
if this.value.at(node, c) > this.value.at(node, best): best = c end
end
out.set(i, 0, best as f64)
end
end
ret out
end
@en "score"
@fa "امتیاز"
pub func score(x &: matrix.Matrix, y &: matrix.Matrix): f64:
mut p := this.predict(x)
if p.is_empty(): ret 0.0 end
mut r := 0.0
if this.is_regression(): r = R2Score(y, p)
else:
r = Accuracy(y, p)
end
matrix.Free(p)
ret r
end
@en "free"
@fa "آزادسازی"
pub func free():
this.feature.free()
this.threshold.free()
this.left.free()
this.right.free()
matrix.Free(this.value)
end
end
func _impurity(counts &: Vector<f64>, total: f64, criterion: int): f64:
if total <= 0.0: ret 0.0 end
mut s := 0.0
repeat counts.len() in c:
p := counts.get(c) / total
if p > 0.0:
if criterion == TREE_ENTROPY:
s -= p * math.Log(p)
else:
s += p * (1.0 - p)
end
end
end
ret s
end
func _node_value(x_rows &: Vector<int>, y &: matrix.Matrix, lo: int, hi: int, k: int, regression: bool, values &: Vector<f64>):
if regression:
mut s := 0.0
repeat hi - lo in t: s += y.at(x_rows.get(lo + t), 0) end
values.push(s / ((hi - lo) as f64))
ret
end
mut counts := Vector {} as Vector<f64>
counts.zeros(k)
repeat hi - lo in t:
c := y.at(x_rows.get(lo + t), 0) as int
counts.set(c, counts.get(c) + 1.0)
end
repeat k in c: values.push(counts.get(c)) end
counts.free()
end
func _best_split(tree &: DecisionTree, x &: matrix.Matrix, y &: matrix.Matrix, rows &: Vector<int>, lo: int, hi: int, k: int, feats &: Vector<int>, best_f &: int, best_t &: f64): f64:
n := hi - lo
regression := tree.is_regression()
nf := n as f64
mut parent := 0.0
mut total_counts := Vector {} as Vector<f64>
mut ysum := 0.0
mut ysq := 0.0
if regression:
repeat n in t:
v := y.at(rows.get(lo + t), 0)
ysum += v
ysq += v * v
end
parent = ysq / nf - (ysum / nf) * (ysum / nf)
else:
total_counts.zeros(k)
repeat n in t:
c := y.at(rows.get(lo + t), 0) as int
total_counts.set(c, total_counts.get(c) + 1.0)
end
parent = _impurity(total_counts, nf, tree.criterion)
end
mut best_gain := 0.0
best_f = 0 - 1
best_t = 0.0
mut order := Vector {} as Vector<int>
repeat n in t: order.push(rows.get(lo + t)) end
mut keys := Vector {} as Vector<f64>
keys.zeros(n)
mut lcounts := Vector {} as Vector<f64>
if regression == false: lcounts.zeros(k) end
min_leaf := tree.min_samples_leaf
repeat feats.len() in fi:
f := feats.get(fi)
repeat n in t: keys.set(t, x.at(order.get(t), f)) end
mut idx := Vector {} as Vector<int>
repeat n in t: idx.push(t) end
sort.SortIndex(idx, keys)
if regression == false:
repeat k in c: lcounts.set(c, 0.0) end
end
mut lsum := 0.0
mut lsq := 0.0
repeat n - 1 in t:
r := order.get(idx.get(t))
if regression:
v := y.at(r, 0)
lsum += v
lsq += v * v
else:
c := y.at(r, 0) as int
lcounts.set(c, lcounts.get(c) + 1.0)
end
nl := t + 1
nr := n - nl
if nl < min_leaf or nr < min_leaf: continue end
kv := keys.get(idx.get(t))
kn := keys.get(idx.get(t + 1))
if kv == kn: continue end
nlf := nl as f64
nrf := nr as f64
mut child := 0.0
if regression:
rsum := ysum - lsum
rsq := ysq - lsq
lvar := lsq / nlf - (lsum / nlf) * (lsum / nlf)
rvar := rsq / nrf - (rsum / nrf) * (rsum / nrf)
child = (nlf * lvar + nrf * rvar) / nf
else:
mut rcounts := Vector {} as Vector<f64>
repeat k in c: rcounts.push(total_counts.get(c) - lcounts.get(c)) end
child = (nlf * _impurity(lcounts, nlf, tree.criterion) + nrf * _impurity(rcounts, nrf, tree.criterion)) / nf
rcounts.free()
end
gain := parent - child
if gain > best_gain + 1.0e-12:
best_gain = gain
best_f = f
best_t = (kv + kn) / 2.0
end
end
idx.free()
end
order.free()
keys.free()
lcounts.free()
total_counts.free()
ret best_gain
end
func _partition(x &: matrix.Matrix, rows &: Vector<int>, lo: int, hi: int, f: int, t: f64): int:
mut i := lo
mut j := hi - 1
until i <= j:
if x.at(rows.get(i), f) <= t:
i += 1
else:
tmp := rows.get(i)
rows.set(i, rows.get(j))
rows.set(j, tmp)
j -= 1
end
end
ret i
end
func _grow_tree(tree &: DecisionTree, x &: matrix.Matrix, y &: matrix.Matrix, k: int, values &: Vector<f64>):
n := x.rows
p := x.cols
regression := tree.is_regression()
mut rows := Vector {} as Vector<int>
repeat n in i: rows.push(i) end
mut g := matrix.NewRng(tree.seed)
tree.feature.push(0 - 1)
tree.threshold.push(0.0)
tree.left.push(0 - 1)
tree.right.push(0 - 1)
_node_value(rows, y, 0, n, k, regression, values)
mut stack := Vector {} as Vector<_TreeFrame>
stack.push(_TreeFrame { node = 0, lo = 0, hi = n, depth = 0 })
mut feats := Vector {} as Vector<int>
until stack.len() > 0:
fr := stack.pop()
cnt := fr.hi - fr.lo
if fr.depth >= tree.max_depth or cnt < tree.min_samples_split or cnt < 2 * tree.min_samples_leaf: continue end
feats.clear()
if tree.max_features > 0 and tree.max_features < p:
mut pool := Vector {} as Vector<int>
repeat p in j: pool.push(j) end
repeat tree.max_features in t:
pick := t + ((g.next_float() * ((p - t) as f64)) as int)
tmp := pool.get(t)
pool.set(t, pool.get(pick))
pool.set(pick, tmp)
feats.push(pool.get(t))
end
pool.free()
else:
repeat p in j: feats.push(j) end
end
mut bf := 0 - 1
mut bt := 0.0
gain := _best_split(tree, x, y, rows, fr.lo, fr.hi, k, feats, bf, bt)
if bf < 0 or gain <= 0.0: continue end
mid := _partition(x, rows, fr.lo, fr.hi, bf, bt)
if mid == fr.lo or mid == fr.hi: continue end
lid := tree.feature.len()
tree.feature.push(0 - 1)
tree.threshold.push(0.0)
tree.left.push(0 - 1)
tree.right.push(0 - 1)
_node_value(rows, y, fr.lo, mid, k, regression, values)
rid := tree.feature.len()
tree.feature.push(0 - 1)
tree.threshold.push(0.0)
tree.left.push(0 - 1)
tree.right.push(0 - 1)
_node_value(rows, y, mid, fr.hi, k, regression, values)
tree.feature.set(fr.node, bf)
tree.threshold.set(fr.node, bt)
tree.left.set(fr.node, lid)
tree.right.set(fr.node, rid)
stack.push(_TreeFrame { node = lid, lo = fr.lo, hi = mid, depth = fr.depth + 1 })
stack.push(_TreeFrame { node = rid, lo = mid, hi = fr.hi, depth = fr.depth + 1 })
end
feats.free()
stack.free()
rows.free()
end
@en "net/dns"
@fa "دی‌ان‌اس"
package dns
import mem
import str
import io
import os
import crypto
import compress
import net.udp
import net.internal.rawsock
@en "TypeA"
@fa "نوع آ"
pub const TypeA := 1
@en "TypeNS"
@fa "نوع ان‌اس"
pub const TypeNS := 2
@en "TypeCNAME"
@fa "نوع سی‌نیم"
pub const TypeCNAME := 5
@en "TypeSOA"
@fa "نوع اس‌اُاِی"
pub const TypeSOA := 6
@en "TypePTR"
@fa "نوع پی‌تی‌آر"
pub const TypePTR := 12
@en "TypeMX"
@fa "نوع ام‌ایکس"
pub const TypeMX := 15
@en "TypeTXT"
@fa "نوع تی‌ایکس‌تی"
pub const TypeTXT := 16
@en "TypeAAAA"
@fa "نوع کواداِی"
pub const TypeAAAA := 28
@en "ClassIN"
@fa "رده اینترنت"
pub const ClassIN := 1
@en "Question"
@fa "پرسش"
pub struct Question:
pub name: str = ""
pub qtype: int = 0
pub qclass: int = 0
end
@en "Questions"
@fa "پرسش‌ها"
pub struct Questions:
pub items: Vector<Question> = Vector {}
end
@en "Record"
@fa "رکورد"
pub struct Record:
pub name: str = ""
pub rtype: int = 0
pub rclass: int = 0
pub ttl: int = 0
pub priority: int = 0
pub data: str = ""
end
@en "Records"
@fa "رکوردها"
pub struct Records:
pub items: Vector<Record> = Vector {}
end
@en "Message"
@fa "پیام"
pub struct Message:
pub id: int = 0
pub qr: bool = false
pub opcode: int = 0
pub aa: bool = false
pub tc: bool = false
pub rd: bool = false
pub ra: bool = false
pub rcode: int = 0
pub questions: Questions = Questions {}
pub answers: Records = Records {}
pub authorities: Records = Records {}
pub extras: Records = Records {}
end
inline pure func _ub(p: void*, i: int): int:
b := ((p as i64 + i) as i8*)[0] as int
if b < 0: ret b + 256 end
ret b
end
func _bytes_to_str(p: void*, n: int): str:
buf := mem.Allocate((n + 1) as u64)
defer mem.Free(buf)
mem.Copy(buf, p, n as u64)
bufp := buf as i8*
bufp[n] = 0 as i8
ret str.Clone(buf as str)
end
func _is_space(c: str): bool:
ret c == " " or c == "\t" or c == "\r" or c == "\n"
end
func _ltrim(s: str): str:
mut a := 0
n := s.len()
until a < n:
if _is_space(s.substr(a, 1)):
a += 1
else:
ret s.substr(a, n - a)
end
end
ret ""
end
func _rtrim(s: str): str:
mut b := s.len()
until b > 0:
if _is_space(s.substr(b - 1, 1)):
b -= 1
else:
ret s.substr(0, b)
end
end
ret ""
end
func _strip(s: str): str:
ret _rtrim(_ltrim(s))
end
func _put_u16(b &: compress.ByteBuf, v: int):
compress.BufPush(b, (v / 256) & 255)
compress.BufPush(b, v & 255)
end
func _encode_name(b &: compress.ByteBuf, name: str):
if name.len() == 0:
compress.BufPush(b, 0)
ret
end
labels := str.Split(name, ".")
mut i := 0
until i < labels.len():
lbl := labels.get(i)
compress.BufPush(b, lbl.len())
compress.BufPushBytes(b, lbl as void*, lbl.len())
i += 1
end
compress.BufPush(b, 0)
end
func _decode_name(data: void*, n: int, start: int, out_consumed &: int): str:
mut labels := Vector {} as Vector<str>
mut pos := start
mut jumped := false
mut consumed := 0
mut safety := 0
mut done := false
until not done:
safety += 1
if safety > 128 or pos < 0 or pos >= n:
done = true
continue
end
b0 := _ub(data, pos)
if (b0 & 192) == 192:
if pos + 1 >= n:
done = true
continue
end
b1 := _ub(data, pos + 1)
offset := ((b0 & 63) * 256) + b1
if not jumped:
consumed = (pos - start) + 2
end
jumped = true
pos = offset
else b0 == 0:
if not jumped:
consumed = (pos - start) + 1
end
done = true
else:
label_start := pos + 1
if label_start + b0 > n:
done = true
continue
end
labels.push(_bytes_to_str((data as i64 + label_start) as void*, b0))
pos = label_start + b0
end
end
out_consumed = consumed
mut name := ""
mut i := 0
until i < labels.len():
if i > 0: name += "." end
name += labels.get(i)
i += 1
end
ret name
end
func _format_ipv4(data: void*, pos: int): str:
a := _ub(data, pos)
b := _ub(data, pos + 1)
c := _ub(data, pos + 2)
d := _ub(data, pos + 3)
ret str.FromInt(a as i64) + "." + str.FromInt(b as i64) + "." + str.FromInt(c as i64) + "." + str.FromInt(d as i64)
end
func _hex1(v: int): str:
digits := "0123456789abcdef"
ret digits.substr(v, 1)
end
func _format_ipv6(data: void*, pos: int): str:
mut out := ""
mut i := 0
until i < 16:
hi := _ub(data, pos + i)
lo := _ub(data, pos + i + 1)
g := (hi * 256) + lo
mut piece := ""
mut started := false
mut shift := 12
until shift >= 0:
nib := (g >> shift) & 15
if nib != 0 or started or shift == 0:
piece += _hex1(nib)
started = true
end
shift -= 4
end
out += piece
if i < 14: out += ":" end
i += 2
end
ret out
end
func _decode_txt(data: void*, pos: int, rdlength: int): str:
mut out := ""
mut p := pos
end_pos := pos + rdlength
until p < end_pos:
label_len := _ub(data, p)
cstart := p + 1
if cstart + label_len > end_pos: ret out end
out += _bytes_to_str((data as i64 + cstart) as void*, label_len)
p = cstart + label_len
end
ret out
end
func _decode_rr(data: void*, n: int, pos: int, out_next &: int): Record:
mut rec := Record {}
mut consumed := 0
rec.name = _decode_name(data, n, pos, consumed)
p := pos + consumed
if p + 10 > n:
out_next = n
ret rec
end
rec.rtype = (_ub(data, p) * 256) + _ub(data, p + 1)
rec.rclass = (_ub(data, p + 2) * 256) + _ub(data, p + 3)
rec.ttl = (_ub(data, p + 4) * 16777216) + (_ub(data, p + 5) * 65536) + (_ub(data, p + 6) * 256) + _ub(data, p + 7)
rdlength := (_ub(data, p + 8) * 256) + _ub(data, p + 9)
rdata_start := p + 10
if rdata_start + rdlength > n:
out_next = n
ret rec
end
if rec.rtype == TypeA and rdlength == 4:
rec.data = _format_ipv4(data, rdata_start)
else rec.rtype == TypeAAAA and rdlength == 16:
rec.data = _format_ipv6(data, rdata_start)
else rec.rtype == TypeCNAME or rec.rtype == TypeNS or rec.rtype == TypePTR:
mut nl := 0
rec.data = _decode_name(data, n, rdata_start, nl)
else rec.rtype == TypeMX and rdlength >= 2:
rec.priority = (_ub(data, rdata_start) * 256) + _ub(data, rdata_start + 1)
mut nl2 := 0
rec.data = _decode_name(data, n, rdata_start + 2, nl2)
else rec.rtype == TypeTXT:
rec.data = _decode_txt(data, rdata_start, rdlength)
else:
rec.data = ""
end
out_next = rdata_start + rdlength
ret rec
end
func _random_id(): int:
buf := mem.Allocate(2 as u64)
defer mem.Free(buf)
crypto.RandomBytes(buf, 2)
bp := buf as i8*
mut b0 := bp[0] as int
mut b1 := bp[1] as int
if b0 < 0: b0 += 256 end
if b1 < 0: b1 += 256 end
ret (b0 * 256) + b1
end
func _reverse_name4(ip: str): str:
parts := str.Split(ip, ".")
if parts.len() != 4: ret "" end
p0 := parts.get(0)
p1 := parts.get(1)
p2 := parts.get(2)
p3 := parts.get(3)
ret p3 + "." + p2 + "." + p1 + "." + p0 + ".in-addr.arpa"
end
func _lookup_records(name: str, qtype: int): Records:
mut out := Records {}
servers := DefaultServers()
mut si := 0
until si < servers.len():
msg := QueryServer(servers.get(si), name, qtype, 3000)
if msg.answers.items.len() > 0:
mut i := 0
until i < msg.answers.items.len():
rec := msg.answers.items.get(i)
if rec.rtype == qtype:
out.items.push(rec)
end
i += 1
end
si = servers.len()
continue
end
si += 1
end
ret out
end
func _records_to_strings(recs: Records): Vector<str>:
mut out := Vector {} as Vector<str>
mut i := 0
until i < recs.items.len():
out.push(recs.items.get(i).data)
i += 1
end
ret out
end
@en "EncodeQuery"
@fa "کدگذاری پرسش"
pub func EncodeQuery(name: str, qtype: int, id: int): compress.ByteBuf:
mut b := compress.NewByteBuf()
_put_u16(b, id)
_put_u16(b, 256)
_put_u16(b, 1)
_put_u16(b, 0)
_put_u16(b, 0)
_put_u16(b, 0)
_encode_name(b, name)
_put_u16(b, qtype)
_put_u16(b, ClassIN)
ret b
end
@en "Decode"
@fa "کدگشایی"
pub func Decode(data: void*, n: int): Message:
mut msg := Message {}
if n < 12: ret msg end
flags0 := _ub(data, 2)
flags1 := _ub(data, 3)
msg.id = (_ub(data, 0) * 256) + _ub(data, 1)
msg.qr = (flags0 & 128) != 0
msg.opcode = (flags0 >> 3) & 15
msg.aa = (flags0 & 4) != 0
msg.tc = (flags0 & 2) != 0
msg.rd = (flags0 & 1) != 0
msg.ra = (flags1 & 128) != 0
msg.rcode = flags1 & 15
qdcount := (_ub(data, 4) * 256) + _ub(data, 5)
ancount := (_ub(data, 6) * 256) + _ub(data, 7)
nscount := (_ub(data, 8) * 256) + _ub(data, 9)
arcount := (_ub(data, 10) * 256) + _ub(data, 11)
mut pos := 12
mut qi := 0
until qi < qdcount:
mut consumed := 0
qname := _decode_name(data, n, pos, consumed)
if consumed <= 0 or pos + 4 > n:
qi = qdcount
continue
end
pos += consumed
if pos + 4 > n:
qi = qdcount
continue
end
qtype := (_ub(data, pos) * 256) + _ub(data, pos + 1)
qclass := (_ub(data, pos + 2) * 256) + _ub(data, pos + 3)
pos += 4
msg.questions.items.push(Question { name = qname, qtype = qtype, qclass = qclass })
qi += 1
end
mut ai := 0
until ai < ancount:
mut nextp := 0
rec := _decode_rr(data, n, pos, nextp)
if nextp <= pos:
ai = ancount
continue
end
pos = nextp
msg.answers.items.push(rec)
ai += 1
end
mut ni := 0
until ni < nscount:
mut nextp := 0
rec := _decode_rr(data, n, pos, nextp)
if nextp <= pos:
ni = nscount
continue
end
pos = nextp
msg.authorities.items.push(rec)
ni += 1
end
mut xi := 0
until xi < arcount:
mut nextp := 0
rec := _decode_rr(data, n, pos, nextp)
if nextp <= pos:
xi = arcount
continue
end
pos = nextp
msg.extras.items.push(rec)
xi += 1
end
ret msg
end
@en "Lookup"
@fa "جستجو"
pub func Lookup(host: str): str:
ret rawsock.Resolve(host)
end
@en "QueryServer"
@fa "پرسش از کارگزار"
pub func QueryServer(server: str, name: str, qtype: int, timeout_ms: int): Message:
msg := Message {}
sock := udp.Open()
if not udp.Ok(sock): ret msg end
defer udp.Close(sock)
udp.SetTimeout(sock, timeout_ms)
id := _random_id()
q := EncodeQuery(name, qtype, id)
sent := udp.SendBytes(sock, server, 53, q.data, q.len)
if sent < 0: ret msg end
cap := 4096
buf := mem.Allocate(cap as u64)
defer mem.Free(buf)
mut fh := ""
mut fp := 0
n := udp.ReceiveBytes(sock, buf, cap, fh, fp)
if n <= 0: ret msg end
ret Decode(buf, n)
end
@en "DefaultServers"
@fa "کارگزارهای پیش‌فرض"
pub func DefaultServers(): Vector<str>:
mut out := Vector {} as Vector<str>
if SALAM_OS_UNIX:
if os.Exists("/etc/resolv.conf"):
content := io.ReadFile("/etc/resolv.conf")
lines := str.Split(content, "\n")
mut i := 0
until i < lines.len():
line := _strip(lines.get(i))
if line.len() > 11 and line.substr(0, 11) == "nameserver ":
ip := _strip(line.substr(11, line.len() - 11))
if ip.len() > 0: out.push(ip) end
end
i += 1
end
end
end
if out.len() == 0:
out.push("8.8.8.8")
out.push("1.1.1.1")
end
ret out
end
@en "LookupA"
@fa "جستجوی آ"
pub func LookupA(name: str): Vector<str>:
ret _records_to_strings(_lookup_records(name, TypeA))
end
@en "LookupAAAA"
@fa "جستجوی کواداِی"
pub func LookupAAAA(name: str): Vector<str>:
ret _records_to_strings(_lookup_records(name, TypeAAAA))
end
@en "LookupCNAME"
@fa "جستجوی سی‌نیم"
pub func LookupCNAME(name: str): str:
recs := _lookup_records(name, TypeCNAME)
if recs.items.len() > 0: ret recs.items.get(0).data end
ret ""
end
@en "LookupMX"
@fa "جستجوی ام‌ایکس"
pub func LookupMX(name: str): Records:
ret _lookup_records(name, TypeMX)
end
@en "LookupTXT"
@fa "جستجوی تی‌ایکس‌تی"
pub func LookupTXT(name: str): Vector<str>:
ret _records_to_strings(_lookup_records(name, TypeTXT))
end
@en "LookupPTR"
@fa "جستجوی معکوس"
pub func LookupPTR(ip: str): Vector<str>:
rname := _reverse_name4(ip)
if rname.len() == 0: ret Vector {} end
ret _records_to_strings(_lookup_records(rname, TypePTR))
end
@en "net/email"
@fa "پست الکترونیک"
package email
package email
import str
import conv
import net.tcp
import tls
mut _imap_tls_slots := Vector {} as Vector<tls.Conn>
@en "IMAPClient"
@fa "کارخواه آی‌مپ"
pub struct IMAPClient:
pub conn: tcp.Conn = tcp.Conn {}
pub secure: bool = false
pub tls_idx: int = 0 - 1
pub ok: bool = false
pub rxbuf: str = ""
pub tag_counter: int = 0
end
@en "IMAPReply"
@fa "پاسخ آی‌مپ"
pub struct IMAPReply:
pub ok: bool = false
pub status: str = ""
pub lines: Vector<str> = Vector {}
end
func _imap_tls_store(tc: tls.Conn): int:
_imap_tls_slots.push(tc)
ret _imap_tls_slots.len() - 1
end
func _imap_tls_get(idx: int): tls.Conn:
ret _imap_tls_slots.get(idx)
end
func _imap_tls_put(idx: int, tc: tls.Conn):
_imap_tls_slots.set(idx, tc)
end
func _imap_fill(c &: IMAPClient):
mut chunk := ""
if c.secure:
mut tc := _imap_tls_get(c.tls_idx)
chunk = tls.Read(tc, 4096)
_imap_tls_put(c.tls_idx, tc)
else:
chunk = tcp.Read(c.conn, 4096)
end
c.rxbuf += chunk
end
func _imap_read_line(c &: IMAPClient): str:
mut idx := c.rxbuf.find("\r\n")
mut tries := 0
until idx < 0 and tries < 200:
_imap_fill(c)
idx = c.rxbuf.find("\r\n")
tries += 1
end
if idx < 0:
line := c.rxbuf
c.rxbuf = ""
ret line
end
line := c.rxbuf.substr(0, idx)
c.rxbuf = c.rxbuf.substr(idx + 2, c.rxbuf.len() - idx - 2)
ret line
end
func _imap_send_line(c &: IMAPClient, line: str): int:
if c.secure:
mut tc := _imap_tls_get(c.tls_idx)
n := tls.Write(tc, line + "\r\n")
_imap_tls_put(c.tls_idx, tc)
ret n
end
ret tcp.Write(c.conn, line + "\r\n")
end
func _imap_next_tag(c &: IMAPClient): str:
c.tag_counter += 1
ret "A" + conv.FormatInt(c.tag_counter as i64)
end
func _imap_read_reply(c &: IMAPClient, tag: str): IMAPReply:
mut r := IMAPReply {}
mut done := false
mut safety := 0
until not done:
safety += 1
line := _imap_read_line(c)
if line.len() >= tag.len() and line.substr(0, tag.len()) == tag:
r.status = line
r.ok = str.Contains(line, " OK")
done = true
else:
r.lines.push(line)
if line.len() == 0 or safety > 10000:
done = true
end
end
end
ret r
end
func _imap_connect_common(conn: tcp.Conn): IMAPClient:
mut c := IMAPClient { conn = conn }
if not tcp.ConnOk(conn):
c.ok = false
ret c
end
greeting := _imap_read_line(c)
c.ok = str.Contains(greeting, "* OK")
ret c
end
@en "DialIMAP"
@fa "اتصال آی‌مپ"
pub func DialIMAP(host: str, port: int): IMAPClient:
ret _imap_connect_common(tcp.Dial(host, port))
end
@en "DialIMAPTLS"
@fa "اتصال امن آی‌مپ"
pub func DialIMAPTLS(host: str, port: int): IMAPClient:
cfg := tls.NewConfig(host)
tc := tls.Dial(host, port, cfg)
mut c := IMAPClient {}
c.secure = true
c.tls_idx = _imap_tls_store(tc)
if not tls.ConnOk(tc):
c.ok = false
ret c
end
greeting := _imap_read_line(c)
c.ok = str.Contains(greeting, "* OK")
ret c
end
@en "Command"
@fa "دستور"
pub func Command(c &: IMAPClient, cmd: str): IMAPReply:
tag := _imap_next_tag(c)
_imap_send_line(c, tag + " " + cmd)
ret _imap_read_reply(c, tag)
end
@en "Login"
@fa "ورود"
pub func Login(c &: IMAPClient, username: str, password: str): bool:
r := Command(c, "LOGIN \"" + username + "\" \"" + password + "\"")
ret r.ok
end
@en "LoginXOAuth2"
@fa "ورود ایکس‌اواث۲"
pub func LoginXOAuth2(c &: IMAPClient, username: str, access_token: str): bool:
r := Command(c, "AUTHENTICATE XOAUTH2 " + BuildXOAuth2(username, access_token))
ret r.ok
end
@en "Select"
@fa "انتخاب"
pub func Select(c &: IMAPClient, mailbox: str): bool:
r := Command(c, "SELECT \"" + mailbox + "\"")
ret r.ok
end
@en "List"
@fa "فهرست صندوق‌ها"
pub func List(c &: IMAPClient, reference: str, pattern: str): Vector<str>:
r := Command(c, "LIST \"" + reference + "\" \"" + pattern + "\"")
ret r.lines
end
@en "Fetch"
@fa "دریافت پیام‌ها"
pub func Fetch(c &: IMAPClient, seq: str, items: str): Vector<str>:
r := Command(c, "FETCH " + seq + " (" + items + ")")
ret r.lines
end
@en "Logout"
@fa "خروج آی‌مپ"
pub func Logout(c &: IMAPClient):
Command(c, "LOGOUT")
if c.secure:
mut tc := _imap_tls_get(c.tls_idx)
tls.Close(tc)
_imap_tls_put(c.tls_idx, tc)
else:
tcp.Close(c.conn)
end
end
package email
import str
import encoding
@en "BuildXOAuth2"
@fa "ساخت ایکس‌اواث۲"
pub func BuildXOAuth2(username: str, access_token: str): str:
mut sb := str.NewBuilder()
defer str.BufFree(sb)
str.BufAppend(sb, "user=")
str.BufAppend(sb, username)
str.BufAppendChar(sb, 1)
str.BufAppend(sb, "auth=Bearer ")
str.BufAppend(sb, access_token)
str.BufAppendChar(sb, 1)
str.BufAppendChar(sb, 1)
raw := str.BufStr(sb)
ret encoding.Base64Encode(raw)
end
package email
import str
import net.tcp
import tls
mut _pop3_tls_slots := Vector {} as Vector<tls.Conn>
@en "POP3Client"
@fa "کارخواه پاپ۳"
pub struct POP3Client:
pub conn: tcp.Conn = tcp.Conn {}
pub secure: bool = false
pub tls_idx: int = 0 - 1
pub ok: bool = false
pub rxbuf: str = ""
end
func _pop3_tls_store(tc: tls.Conn): int:
_pop3_tls_slots.push(tc)
ret _pop3_tls_slots.len() - 1
end
func _pop3_tls_get(idx: int): tls.Conn:
ret _pop3_tls_slots.get(idx)
end
func _pop3_tls_put(idx: int, tc: tls.Conn):
_pop3_tls_slots.set(idx, tc)
end
func _pop3_fill(c &: POP3Client):
mut chunk := ""
if c.secure:
mut tc := _pop3_tls_get(c.tls_idx)
chunk = tls.Read(tc, 4096)
_pop3_tls_put(c.tls_idx, tc)
else:
chunk = tcp.Read(c.conn, 4096)
end
c.rxbuf += chunk
end
func _pop3_read_line(c &: POP3Client): str:
mut idx := c.rxbuf.find("\r\n")
mut tries := 0
until idx < 0 and tries < 200:
_pop3_fill(c)
idx = c.rxbuf.find("\r\n")
tries += 1
end
if idx < 0:
line := c.rxbuf
c.rxbuf = ""
ret line
end
line := c.rxbuf.substr(0, idx)
c.rxbuf = c.rxbuf.substr(idx + 2, c.rxbuf.len() - idx - 2)
ret line
end
func _pop3_send_line(c &: POP3Client, line: str): int:
if c.secure:
mut tc := _pop3_tls_get(c.tls_idx)
n := tls.Write(tc, line + "\r\n")
_pop3_tls_put(c.tls_idx, tc)
ret n
end
ret tcp.Write(c.conn, line + "\r\n")
end
func _pop3_command(c &: POP3Client, line: str): str:
_pop3_send_line(c, line)
ret _pop3_read_line(c)
end
func _pop3_ok(reply: str): bool:
ret reply.len() >= 3 and reply.substr(0, 3) == "+OK"
end
func _pop3_read_multiline(c &: POP3Client): Vector<str>:
mut out := Vector {} as Vector<str>
mut done := false
mut safety := 0
until not done:
safety += 1
line := _pop3_read_line(c)
if line == "." or safety > 100000:
done = true
else:
if line.len() >= 2 and line.substr(0, 2) == "..":
out.push(line.substr(1, line.len() - 1))
else:
out.push(line)
end
end
end
ret out
end
func _pop3_connect_common(conn: tcp.Conn): POP3Client:
mut c := POP3Client { conn = conn }
if not tcp.ConnOk(conn):
c.ok = false
ret c
end
greeting := _pop3_read_line(c)
c.ok = _pop3_ok(greeting)
ret c
end
@en "DialPOP3"
@fa "اتصال پاپ۳"
pub func DialPOP3(host: str, port: int): POP3Client:
ret _pop3_connect_common(tcp.Dial(host, port))
end
@en "DialPOP3TLS"
@fa "اتصال امن پاپ۳"
pub func DialPOP3TLS(host: str, port: int): POP3Client:
cfg := tls.NewConfig(host)
tc := tls.Dial(host, port, cfg)
mut c := POP3Client {}
c.secure = true
c.tls_idx = _pop3_tls_store(tc)
if not tls.ConnOk(tc):
c.ok = false
ret c
end
greeting := _pop3_read_line(c)
c.ok = _pop3_ok(greeting)
ret c
end
@en "User"
@fa "کاربر"
pub func User(c &: POP3Client, username: str): bool:
ret _pop3_ok(_pop3_command(c, "USER " + username))
end
@en "Pass"
@fa "گذرواژه"
pub func Pass(c &: POP3Client, password: str): bool:
ret _pop3_ok(_pop3_command(c, "PASS " + password))
end
@en "Stat"
@fa "وضعیت"
pub func Stat(c &: POP3Client): str:
ret _pop3_command(c, "STAT")
end
@en "POP3List"
@fa "فهرست پیام‌های پاپ۳"
pub func POP3List(c &: POP3Client): Vector<str>:
reply := _pop3_command(c, "LIST")
if not _pop3_ok(reply): ret Vector {} end
ret _pop3_read_multiline(c)
end
@en "Retr"
@fa "دریافت پیام پاپ۳"
pub func Retr(c &: POP3Client, msgnum: int): str:
reply := _pop3_command(c, "RETR " + str.FromInt(msgnum as i64))
if not _pop3_ok(reply): ret "" end
lines := _pop3_read_multiline(c)
ret str.Join(lines, "\r\n")
end
@en "Dele"
@fa "حذف"
pub func Dele(c &: POP3Client, msgnum: int): bool:
ret _pop3_ok(_pop3_command(c, "DELE " + str.FromInt(msgnum as i64)))
end
@en "POP3Quit"
@fa "خروج پاپ۳"
pub func POP3Quit(c &: POP3Client):
_pop3_command(c, "QUIT")
if c.secure:
mut tc := _pop3_tls_get(c.tls_idx)
tls.Close(tc)
_pop3_tls_put(c.tls_idx, tc)
else:
tcp.Close(c.conn)
end
end
package email
import mem
import str
import encoding
import crypto
import net.tcp
import tls
mut _smtp_tls_slots := Vector {} as Vector<tls.Conn>
@en "SMTPClient"
@fa "کارخواه اس‌ام‌تی‌پی"
pub struct SMTPClient:
pub conn: tcp.Conn = tcp.Conn {}
pub secure: bool = false
pub tls_idx: int = 0 - 1
pub ok: bool = false
pub rxbuf: str = ""
pub last_reply: str = ""
end
func _smtp_tls_store(tc: tls.Conn): int:
_smtp_tls_slots.push(tc)
ret _smtp_tls_slots.len() - 1
end
func _smtp_tls_get(idx: int): tls.Conn:
ret _smtp_tls_slots.get(idx)
end
func _smtp_tls_put(idx: int, tc: tls.Conn):
_smtp_tls_slots.set(idx, tc)
end
func _smtp_fill(c &: SMTPClient):
mut chunk := ""
if c.secure:
mut tc := _smtp_tls_get(c.tls_idx)
chunk = tls.Read(tc, 4096)
_smtp_tls_put(c.tls_idx, tc)
else:
chunk = tcp.Read(c.conn, 4096)
end
c.rxbuf += chunk
end
func _smtp_read_line(c &: SMTPClient): str:
mut idx := c.rxbuf.find("\r\n")
mut tries := 0
until idx < 0 and tries < 200:
_smtp_fill(c)
idx = c.rxbuf.find("\r\n")
tries += 1
end
if idx < 0:
line := c.rxbuf
c.rxbuf = ""
ret line
end
line := c.rxbuf.substr(0, idx)
c.rxbuf = c.rxbuf.substr(idx + 2, c.rxbuf.len() - idx - 2)
ret line
end
func _smtp_read_reply(c &: SMTPClient): str:
mut full := ""
mut done := false
until not done:
line := _smtp_read_line(c)
full += line + "\r\n"
if line.len() == 0:
done = true
else line.len() >= 4 and line.substr(3, 1) == " ":
done = true
end
end
ret full
end
func _smtp_send_line(c &: SMTPClient, line: str): int:
if c.secure:
mut tc := _smtp_tls_get(c.tls_idx)
n := tls.Write(tc, line + "\r\n")
_smtp_tls_put(c.tls_idx, tc)
ret n
end
ret tcp.Write(c.conn, line + "\r\n")
end
func _smtp_code(reply: str): int:
if reply.len() < 3: ret 0 end
ret reply.substr(0, 3).to_int()
end
func _smtp_command(c &: SMTPClient, line: str): bool:
_smtp_send_line(c, line)
c.last_reply = _smtp_read_reply(c)
code := _smtp_code(c.last_reply)
ret code > 0 and code < 400
end
func _dot_stuff(body: str): str:
lines := str.Split(body, "\r\n")
mut out := ""
mut i := 0
until i < lines.len():
line := lines.get(i)
if line.len() > 0 and line.substr(0, 1) == ".":
out += "."
end
out += line
if i < lines.len() - 1:
out += "\r\n"
end
i += 1
end
ret out
end
func _hdr_line(name: str, value: str): str:
ret name + ": " + value + "\r\n"
end
func _smtp_connect_common(conn: tcp.Conn): SMTPClient:
mut c := SMTPClient { conn = conn }
if not tcp.ConnOk(conn):
c.ok = false
ret c
end
c.last_reply = _smtp_read_reply(c)
c.ok = _smtp_code(c.last_reply) == 220
ret c
end
@en "DialSMTP"
@fa "اتصال اس‌ام‌تی‌پی"
pub func DialSMTP(host: str, port: int): SMTPClient:
ret _smtp_connect_common(tcp.Dial(host, port))
end
@en "DialSMTPTLS"
@fa "اتصال امن اس‌ام‌تی‌پی"
pub func DialSMTPTLS(host: str, port: int): SMTPClient:
cfg := tls.NewConfig(host)
tc := tls.Dial(host, port, cfg)
mut c := SMTPClient {}
c.secure = true
c.tls_idx = _smtp_tls_store(tc)
if not tls.ConnOk(tc):
c.ok = false
ret c
end
c.last_reply = _smtp_read_reply(c)
c.ok = _smtp_code(c.last_reply) == 220
ret c
end
@en "Hello"
@fa "سلام"
pub func Hello(c &: SMTPClient, domain: str): bool:
ret _smtp_command(c, "EHLO " + domain)
end
@en "StartTLS"
@fa "شروع تی‌ال‌اس"
pub func StartTLS(c &: SMTPClient, host: str): bool:
if not _smtp_command(c, "STARTTLS"): ret false end
cfg := tls.NewConfig(host)
tc := tls.WrapClient(c.conn.fd, cfg)
if not tls.ConnOk(tc): ret false end
c.secure = true
c.tls_idx = _smtp_tls_store(tc)
c.rxbuf = ""
ret true
end
@en "AuthLogin"
@fa "ورود با احراز هویت"
pub func AuthLogin(c &: SMTPClient, username: str, password: str): bool:
if not _smtp_command(c, "AUTH LOGIN"): ret false end
if not _smtp_command(c, encoding.Base64Encode(username)): ret false end
ret _smtp_command(c, encoding.Base64Encode(password))
end
@en "AuthPlain"
@fa "ورود ساده"
pub func AuthPlain(c &: SMTPClient, username: str, password: str): bool:
mut sb := str.NewBuilder()
defer str.BufFree(sb)
str.BufAppendChar(sb, 0)
str.BufAppend(sb, username)
str.BufAppendChar(sb, 0)
str.BufAppend(sb, password)
raw := str.BufStr(sb)
ret _smtp_command(c, "AUTH PLAIN " + encoding.Base64Encode(raw))
end
@en "AuthXOAuth2"
@fa "احراز هویت ایکس‌اواث۲"
pub func AuthXOAuth2(c &: SMTPClient, username: str, access_token: str): bool:
ret _smtp_command(c, "AUTH XOAUTH2 " + BuildXOAuth2(username, access_token))
end
@en "MailFrom"
@fa "فرستنده"
pub func MailFrom(c &: SMTPClient, addr: str): bool:
ret _smtp_command(c, "MAIL FROM:<" + addr + ">")
end
@en "RcptTo"
@fa "گیرنده"
pub func RcptTo(c &: SMTPClient, addr: str): bool:
ret _smtp_command(c, "RCPT TO:<" + addr + ">")
end
@en "Data"
@fa "داده"
pub func Data(c &: SMTPClient, raw_message: str): bool:
if not _smtp_command(c, "DATA"): ret false end
_smtp_send_line(c, _dot_stuff(raw_message))
ret _smtp_command(c, ".")
end
@en "Quit"
@fa "خروج اس‌ام‌تی‌پی"
pub func Quit(c &: SMTPClient):
_smtp_command(c, "QUIT")
if c.secure:
mut tc := _smtp_tls_get(c.tls_idx)
tls.Close(tc)
_smtp_tls_put(c.tls_idx, tc)
else:
tcp.Close(c.conn)
end
end
@en "BuildMessage"
@fa "ساخت پیام"
pub func BuildMessage(from: str, to_addr: str, subject: str, text_body: str, html_body: str): str:
mut headers := _hdr_line("From", from)
headers += _hdr_line("To", to_addr)
headers += _hdr_line("Subject", subject)
headers += _hdr_line("MIME-Version", "1.0")
if html_body.len() == 0:
headers += _hdr_line("Content-Type", "text/plain; charset=utf-8")
ret headers + "\r\n" + text_body
end
if text_body.len() == 0:
headers += _hdr_line("Content-Type", "text/html; charset=utf-8")
ret headers + "\r\n" + html_body
end
boundary := "SalamAltBoundary" + crypto.RandomHex(12)
headers += _hdr_line("Content-Type", "multipart/alternative; boundary=" + boundary)
mut body := "--" + boundary + "\r\n"
body += "Content-Type: text/plain; charset=utf-8\r\n\r\n"
body += text_body + "\r\n"
body += "--" + boundary + "\r\n"
body += "Content-Type: text/html; charset=utf-8\r\n\r\n"
body += html_body + "\r\n"
body += "--" + boundary + "--\r\n"
ret headers + "\r\n" + body
end
@en "Send"
@fa "ارسال"
pub func Send(host: str, port: int, use_tls: bool, username: str, password: str, from: str, to_addr: str, subject: str, text_body: str, html_body: str): bool:
mut c := SMTPClient {}
if use_tls:
c = DialSMTPTLS(host, port)
else:
c = DialSMTP(host, port)
end
if not c.ok: ret false end
if not Hello(c, "localhost"): ret false end
if not use_tls:
if not StartTLS(c, host):
Quit(c)
ret false
end
if not Hello(c, "localhost"):
Quit(c)
ret false
end
end
if username.len() > 0:
if not AuthPlain(c, username, password): ret false end
end
if not MailFrom(c, from): ret false end
if not RcptTo(c, to_addr): ret false end
msg := BuildMessage(from, to_addr, subject, text_body, html_body)
ok := Data(c, msg)
Quit(c)
ret ok
end
package http
