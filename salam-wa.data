use = oldc > newc
end
newp.push(use ? np : old_p)
upd.push(use ? 1 : 0)
end
st.ones.free()
st.seen.free()
tw.probs = newp
_vp8_token_pass(tw, all_lv, modes, mbw, mbh)
_vp8w_flush(tw)
total := mbw * mbh
use_skip := skips > 0
mut skip_p := ((total - skips) * 255) / total
if skip_p < 1:
skip_p = 1
end
if skip_p > 254:
skip_p = 254
end
mut hw := _vp8w_new()
_vp8w_put(hw, 0, 128)
_vp8w_put(hw, 0, 128)
_vp8w_put(hw, 0, 128)
_vp8w_put(hw, 0, 128)
_vp8w_bits(hw, level, 6)
_vp8w_bits(hw, 0, 3)
_vp8w_put(hw, 0, 128)
_vp8w_bits(hw, 0, 2)
_vp8w_bits(hw, q, 7)
repeat 5:
_vp8w_put(hw, 0, 128)
end
_vp8w_put(hw, 0, 128)
