@en "Strip"
@fa "پاک‌سازی"
pub func Strip(s: str): str:
n := s.len()
bp := _bp(s)
mut b := str.NewBuilder()
defer str.BufFree(b)
mut i := 0
until i < n:
if _ub(bp, i) == 27:
i = _esc_end(s, i, n)
else:
str.BufAppendChar(b, _ub(bp, i))
i += 1
end
end
out := str.BufStr(b)
ret out
end
@en "Width"
@fa "پهنا"
pub func Width(s: str): int:
n := s.len()
bp := _bp(s)
mut count := 0
mut i := 0
until i < n:
if _ub(bp, i) == 27:
i = _esc_end(s, i, n)
else:
i += str.CharLen(_ub(bp, i))
count += 1
end
end
ret count
end
@en "Truncate"
@fa "کوتاه‌سازی"
pub func Truncate(s: str, n: int): str:
if n <= 0: ret "" end
if Width(s) <= n: ret s end
total := s.len()
bp := _bp(s)
mut b := str.NewBuilder()
defer str.BufFree(b)
mut styled := false
mut count := 0
mut i := 0
until i < total and count < n:
if _ub(bp, i) == 27:
e := _esc_end(s, i, total)
str.BufAppend(b, str.Substr(s, i, e - i))
styled = true
i = e
else:
w := str.CharLen(_ub(bp, i))
str.BufAppend(b, str.Substr(s, i, w))
i += w
count += 1
end
end
if styled: str.BufAppend(b, Reset) end
out := str.BufStr(b)
ret out
end
@en "PadRight"
@fa "پرکردن راست"
pub func PadRight(s: str, n: int): str:
w := Width(s)
if w >= n: ret s end
ret s + str.Repeat(" ", n - w)
end
@en "PadLeft"
@fa "پرکردن چپ"
pub func PadLeft(s: str, n: int): str:
w := Width(s)
if w >= n: ret s end
ret str.Repeat(" ", n - w) + s
end
@en "Center"
@fa "وسط‌چین"
pub func Center(s: str, n: int): str:
w := Width(s)
if w >= n: ret s end
left := (n - w) / 2
ret str.Repeat(" ", left) + s + str.Repeat(" ", n - w - left)
end
