package opencv
@en "VideoCapture"
@fa "ضبط ویدیو"
pub struct VideoCapture:
pub handle: void* = null
@en "ok"
@fa "معتبر"
pub func ok(): bool:
if this.handle == null: ret false end
ret scv_video_ok(this.handle) != 0
end
@en "read"
@fa "خواندن"
pub func read(): Mat:
if this.handle == null: ret Mat { handle = null } end
ret Mat { handle = scv_video_read(this.handle) }
end
@en "fps"
@fa "فریم در ثانیه"
pub func fps(): f64:
if this.handle == null: ret 0.0 end
ret scv_video_fps(this.handle)
end
@en "frame_count"
@fa "تعداد فریم"
pub func frame_count(): int:
if this.handle == null: ret 0 end
ret scv_video_frame_count(this.handle)
end
@en "close"
@fa "بستن"
pub func close():
if this.handle != null: scv_video_release(this.handle) end
this.handle = null
end
end
@en "VideoWriter"
@fa "نویسنده ویدیو"
pub struct VideoWriter:
pub handle: void* = null
@en "ok"
@fa "معتبر"
pub func ok(): bool: ret this.handle != null end
@en "write"
@fa "نوشتن"
pub func write(frame: Mat): bool:
if this.handle == null or frame.handle == null: ret false end
ret scv_writer_write(this.handle, frame.handle) != 0
end
@en "close"
@fa "بستن"
pub func close():
if this.handle != null: scv_writer_release(this.handle) end
this.handle = null
end
end
@en "OpenVideo"
@fa "بازکردن ویدیو"
pub func OpenVideo(path: str): VideoCapture:
ret VideoCapture { handle = scv_video_open_file(path) }
end
@en "OpenCamera"
@fa "بازکردن دوربین"
pub func OpenCamera(index: int): VideoCapture:
ret VideoCapture { handle = scv_video_open_camera(index) }
end
@en "NewVideoWriter"
@fa "نویسنده ویدیو جدید"
pub func NewVideoWriter(path: str, fourcc: str, fps: f64, width: int, height: int): VideoWriter:
ret VideoWriter { handle = scv_writer_open(path, fourcc, fps, width, height) }
end
package optim
import nn
import tensor
extern:
pure func sqrtf(x: f32): f32
end
@en "Adam"
@fa "آدام"
pub struct Adam:
pub lr: f64 = 0.001
pub beta1: f64 = 0.9
pub beta2: f64 = 0.999
pub eps: f64 = 0.00000001
pub weight_decay: f64 = 0.0
pub decoupled: bool = false
t: i64 = 0
m: Vector<tensor.Tensor> = Vector {}
v: Vector<tensor.Tensor> = Vector {}
@en "step"
@fa "گام"
pub func step(ps &: nn.ParamStore):
_ensure_state(this.m, ps)
_ensure_state(this.v, ps)
this.t += 1
mut p1 := 1.0
mut p2 := 1.0
mut i := 0 as i64
until i < this.t:
p1 = p1 * this.beta1
p2 = p2 * this.beta2
i += 1
end
c1 := (1.0 / (1.0 - p1)) as f32
c2 := (1.0 / (1.0 - p2)) as f32
lr := this.lr as f32
b1 := this.beta1 as f32
b2 := this.beta2 as f32
one := 1.0 as f32
ef := this.eps as f32
wd := this.weight_decay as f32
zero := 0.0 as f32
repeat ps.count() in pi:
mut p := ps.items.get(pi)
n := p.value.numel()
pw := p.value.data.data
pg := p.grad.data.data
mt := this.m.get(pi)
vt := this.v.get(pi)
pm := mt.data.data
pv := vt.data.data
if this.decoupled and wd != zero:
repeat n in k: pw[k] = pw[k] - lr * wd * pw[k] end
end
repeat n in k:
mut g := pg[k]
if this.decoupled == false and wd != zero: g = g + wd * pw[k] end
nm := b1 * pm[k] + (one - b1) * g
nv := b2 * pv[k] + (one - b2) * g * g
pm[k] = nm
pv[k] = nv
pw[k] = pw[k] - lr * (nm * c1) / (sqrtf(nv * c2) + ef)
end
end
end
@en "free"
@fa "آزادسازی"
pub func free():
_free_state(this.m)
_free_state(this.v)
end
end
@en "RMSProp"
@fa "آر ام اس پراپ"
pub struct RMSProp:
pub lr: f64 = 0.01
pub alpha: f64 = 0.99
pub eps: f64 = 0.00000001
pub weight_decay: f64 = 0.0
sq: Vector<tensor.Tensor> = Vector {}
@en "step"
@fa "گام"
pub func step(ps &: nn.ParamStore):
_ensure_state(this.sq, ps)
lr := this.lr as f32
al := this.alpha as f32
one := 1.0 as f32
ef := this.eps as f32
wd := this.weight_decay as f32
zero := 0.0 as f32
repeat ps.count() in pi:
mut p := ps.items.get(pi)
n := p.value.numel()
pw := p.value.data.data
pg := p.grad.data.data
st := this.sq.get(pi)
pv := st.data.data
repeat n in k:
mut g := pg[k]
if wd != zero: g = g + wd * pw[k] end
nv := al * pv[k] + (one - al) * g * g
pv[k] = nv
pw[k] = pw[k] - lr * g / (sqrtf(nv) + ef)
end
end
end
@en "free"
@fa "آزادسازی"
pub func free(): _free_state(this.sq) end
end
@en "NewAdamW"
@fa "آدام دابلیو جدید"
pub func NewAdamW(lr: f64, weight_decay: f64): Adam:
mut a := Adam {}
a.lr = lr
a.weight_decay = weight_decay
a.decoupled = true
ret a
end
package optim
import math
@en "StepLR"
@fa "نرخ پله‌ای"
pub func StepLR(base: f64, step: i64, every: i64, gamma: f64): f64:
if every <= 0: ret base end
mut lr := base
mut k := step / every
until k > 0:
lr = lr * gamma
k -= 1
end
ret lr
end
@en "CosineLR"
@fa "نرخ کسینوسی"
pub func CosineLR(base: f64, step: i64, total: i64, min_lr: f64): f64:
if total <= 0 or step >= total: ret min_lr end
if step <= 0: ret base end
frac := (step as f64) / (total as f64)
ret min_lr + (base - min_lr) * 0.5 * (1.0 + math.Cos(math.PI * frac))
end
@en "WarmupCosine"
@fa "گرمایش سپس کسینوس"
pub func WarmupCosine(base: f64, step: i64, warmup: i64, total: i64, min_lr: f64): f64:
if warmup > 0 and step < warmup:
ret base * ((step + 1) as f64) / (warmup as f64)
end
ret CosineLR(base, step - warmup, total - warmup, min_lr)
end
@en "optim"
@fa "بهینه‌سازی"
package optim
import math
import nn
import tensor
@en "SGD"
@fa "گرادیان کاهشی تصادفی"
pub struct SGD:
pub lr: f64 = 0.01
pub momentum: f64 = 0.0
pub weight_decay: f64 = 0.0
pub nesterov: bool = false
vel: Vector<tensor.Tensor> = Vector {}
@en "step"
@fa "گام"
pub func step(ps &: nn.ParamStore):
if this.momentum != 0.0: _ensure_state(this.vel, ps) end
lr := this.lr as f32
wd := this.weight_decay as f32
mom := this.momentum as f32
zero := 0.0 as f32
repeat ps.count() in i:
mut p := ps.items.get(i)
n := p.value.numel()
pw := p.value.data.data
pg := p.grad.data.data
if mom == zero:
if wd == zero:
repeat n in k: pw[k] = pw[k] - lr * pg[k] end
else:
repeat n in k: pw[k] = pw[k] - lr * (pg[k] + wd * pw[k]) end
end
else:
v := this.vel.get(i)
pv := v.data.data
if this.nesterov:
repeat n in k:
g := pg[k] + wd * pw[k]
nv := mom * pv[k] + g
pv[k] = nv
pw[k] = pw[k] - lr * (g + mom * nv)
end
else:
repeat n in k:
g := pg[k] + wd * pw[k]
nv := mom * pv[k] + g
pv[k] = nv
pw[k] = pw[k] - lr * nv
end
end
end
end
end
@en "free"
@fa "آزادسازی"
pub func free(): _free_state(this.vel) end
end
func _ensure_state(state &: Vector<tensor.Tensor>, ps &: nn.ParamStore):
until state.len() < ps.count():
mut p := ps.items.get(state.len())
state.push(tensor.Zeros(p.value.shape))
end
end
func _free_state(state &: Vector<tensor.Tensor>):
repeat state.len() in i:
mut t := state.get(i)
t.free()
end
state.free()
end
@en "ClipGradNorm"
@fa "برش نُرم گرادیان"
pub func ClipGradNorm(ps &: nn.ParamStore, max_norm: f64): f64:
mut total := 0.0
repeat ps.count() in i:
mut p := ps.items.get(i)
n := p.grad.numel()
pg := p.grad.data.data
repeat n in k:
v := pg[k] as f64
total += v * v
end
end
norm := math.Sqrt(total)
if norm > max_norm and norm > 0.0:
scale := (max_norm / norm) as f32
repeat ps.count() in i:
mut p := ps.items.get(i)
n := p.grad.numel()
pg := p.grad.data.data
repeat n in k: pg[k] = pg[k] * scale end
end
end
ret norm
end
@en "ClipGradValue"
@fa "برش مقدار گرادیان"
pub func ClipGradValue(ps &: nn.ParamStore, limit: f64):
hi := limit as f32
lo := (0.0 - limit) as f32
repeat ps.count() in i:
mut p := ps.items.get(i)
n := p.grad.numel()
pg := p.grad.data.data
repeat n in k:
mut v := pg[k]
if v > hi: v = hi end
if v < lo: v = lo end
pg[k] = v
end
end
end
@en "option"
@fa "اختیاری"
package option
import mem
extern:
noret func salam_panic(msg: str)
end
@en "Option"
@fa "اختیاری"
pub struct Option<T>:
pub value: T
pub present: bool
end
@en "Some"
@fa "یک مقدار"
pub func Some<T>(x: T): Option<T>: ret Option { value = x, present = true }
end
@en "None"
@fa "هیچ مقدار"
pub func None<T>(): Option<T>: p := mem.AllocateZeroed(sizeof(T))
vp := p as T*
v := vp[0]
mem.Free(p)
ret Option { value = v, present = false }
end
@en "IsSome"
@fa "دارد"
pub func IsSome<T>(o: Option<T>): bool: ret o.present
end
@en "IsNone"
@fa "ندارد"
pub func IsNone<T>(o: Option<T>): bool: ret o.present == false
end
@en "UnwrapOr"
@fa "یابرگردان"
pub func UnwrapOr<T>(o: Option<T>, fallback: T): T: if o.present: ret o.value
end
ret fallback
end
@en "Unwrap"
@fa "بازکن"
pub func Unwrap<T>(o: Option<T>): T: if o.present == false: salam_panic("called Unwrap on a None value")
end
ret o.value
end
@en "Expect"
@fa "انتظار"
pub func Expect<T>(o: Option<T>, msg: str): T: if o.present == false: salam_panic(msg)
end
ret o.value
end
package os
@en "MkdirAll"
@fa "ساخت پوشه ها"
pub func MkdirAll(path: str): int:
if path.len() == 0: ret 0 - 1 end
if _os_is_dir(path): ret 0 end
parts := path.split("/")
mut cur := ""
mut owns := false
repeat parts.len() in i:
part := parts.get(i)
if part.len() == 0:
if i == 0:
cur = "/"
owns = false
end
else:
mut sb := str.NewBuilder()
str.BufAppend(sb, cur)
if cur.len() > 0 and cur != "/": str.BufAppend(sb, "/") end
str.BufAppend(sb, part)
next := str.BufStr(sb)
str.BufFree(sb)
if owns: mem.Free(cur as void *) end
cur = next
owns = true
if _os_is_dir(cur) == false:
_os_mkdir(cur)
end
end
end
if owns: mem.Free(cur as void *) end
repeat parts.len() in i:
mem.Free(parts.get(i) as void *)
end
parts.free()
if _os_is_dir(path): ret 0 end
ret 0 - 1
end
@en "RemoveAll"
@fa "حذف همه"
pub func RemoveAll(path: str): int:
if _os_exists(path) == false: ret 0 end
if _os_is_dir(path) == false:
ret Remove(path)
end
entries := listdir(path)
mut rc := 0
repeat entries.len() in i:
full := filepath.Join(path, entries.get(i))
if RemoveAll(full) != 0: rc = 0 - 1 end
mem.Free(full as void *)
end
repeat entries.len() in i:
mem.Free(entries.get(i) as void *)
end
entries.free()
if _os_rmdir(path) != 0: rc = 0 - 1 end
ret rc
end
@en "CopyTree"
@fa "کپی درخت"
pub func CopyTree(src: str, dst: str): int:
if _os_is_dir(src) == false: ret 0 - 1 end
if MkdirAll(dst) != 0: ret 0 - 1 end
entries := listdir(src)
defer entries.free()
mut rc := 0
repeat entries.len() in i:
name := entries.get(i)
s := filepath.Join(src, name)
d := filepath.Join(dst, name)
if _os_is_dir(s):
if CopyTree(s, d) != 0: rc = 0 - 1 end
else:
if Copy(s, d) != 0: rc = 0 - 1 end
end
end
ret rc
end
@en "ListDirs"
@fa "فهرست پوشه ها"
pub func ListDirs(path: str): Vector<str>:
out := Vector {} as Vector<str> entries := listdir(path)
defer entries.free()
repeat entries.len() in i:
name := entries.get(i)
if _os_is_dir(filepath.Join(path, name)):
out.push(name)
end
end
ret out
end
