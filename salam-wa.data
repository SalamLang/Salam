end
if k >= node.inputs.len() or str.Len(node.inputs.get(k)) == 0: ret false end
mut t := tensor.Empty()
if _env_get(env, node.inputs.get(k), t) == false:
model.error = node.op + ": unbound input " + node.inputs.get(k)
ret false
end
repeat t.numel() in i: out.push(t.at(i) as int) end
ret true
end
func _exec_node2(model &: Model, node: Node, env &: _Env): bool:
op := node.op
if str.Equals(op, "Abs") or str.Equals(op, "Erf") or str.Equals(op, "Softplus") or str.Equals(op, "Elu") or str.Equals(op, "Selu") or str.Equals(op, "HardSigmoid") or str.Equals(op, "Floor") or str.Equals(op, "Ceil") or str.Equals(op, "Round") or str.Equals(op, "Reciprocal") or str.Equals(op, "Sign") or str.Equals(op, "Cast") or str.Equals(op, "Gelu"):
ret _unary2(model, node, env)
end
if str.Equals(op, "Pow"): ret _pow(model, node, env) end
if str.Equals(op, "Min") or str.Equals(op, "Max") or str.Equals(op, "Sum") or str.Equals(op, "Mean"): ret _variadic(model, node, env) end
if str.Equals(op, "ReduceMean") or str.Equals(op, "ReduceSum") or str.Equals(op, "ReduceMax") or str.Equals(op, "ReduceMin"): ret _reduce(model, node, env) end
if str.Equals(op, "Gather"): ret _gather(model, node, env) end
if str.Equals(op, "Slice"): ret _slice(model, node, env) end
if str.Equals(op, "Split"): ret _split(model, node, env) end
if str.Equals(op, "Shape"): ret _shape_op(model, node, env) end
if str.Equals(op, "Expand"): ret _expand(model, node, env) end
if str.Equals(op, "Equal") or str.Equals(op, "Greater") or str.Equals(op, "Less"): ret _compare(model, node, env) end
if str.Equals(op, "Where"): ret _where(model, node, env) end
if str.Equals(op, "PRelu"): ret _prelu(model, node, env) end
if str.Equals(op, "LayerNormalization") or str.Equals(op, "InstanceNormalization"): ret _layernorm(model, node, env) end
ret false
end
package onnx
import str
import compress
import encoding.binary
import encoding.protobuf
import mem
import tensor
const _DT_FLOAT := 1
const _DT_INT32 := 6
const _DT_INT64 := 7
const _DT_DOUBLE := 11
struct _RawTensor:
pub name: str = ""
pub dtype: int = 0
pub dims: Vector<int> = Vector {}
pub values: Vector<f64> = Vector {}
pub raw: compress.ByteBuf = compress.ByteBuf {}
pub has_raw: bool = false
end
func _skip(rd &: compress.ByteReader, wt: int): bool:
mut ok := false
if wt == protobuf.WT_VARINT:
protobuf.ReadVarint(rd, ok)
else wt == protobuf.WT_FIXED64:
protobuf.ReadFixed64(rd, ok)
else wt == protobuf.WT_LEN:
mut b := protobuf.ReadLenPrefixedBuf(rd, ok)
compress.BufFree(b)
else wt == protobuf.WT_FIXED32:
protobuf.ReadFixed32(rd, ok)
else:
ret false
end
ret ok
end
func _read_ints(rd &: compress.ByteReader, wt: int, out &: Vector<i64>): bool:
mut ok := false
if wt == protobuf.WT_LEN:
mut b := protobuf.ReadLenPrefixedBuf(rd, ok)
if ok:
mut sub := compress.ReaderFromBuf(b)
until compress.RdLeft(sub) > 0 and ok:
v := protobuf.ReadVarint(sub, ok)
if ok: out.push(v as i64) end
end
end
compress.BufFree(b)
ret ok
end
v := protobuf.ReadVarint(rd, ok)
if ok: out.push(v as i64) end
ret ok
end
func _read_floats(rd &: compress.ByteReader, wt: int, out &: Vector<f64>): bool:
mut ok := false
if wt == protobuf.WT_LEN:
mut b := protobuf.ReadLenPrefixedBuf(rd, ok)
if ok:
mut sub := compress.ReaderFromBuf(b)
until compress.RdLeft(sub) >= 4 and ok:
v := protobuf.ReadFloat(sub, ok)
if ok: out.push(v) end
end
end
compress.BufFree(b)
ret ok
end
v := protobuf.ReadFloat(rd, ok)
if ok: out.push(v) end
ret ok
end
func _read_doubles(rd &: compress.ByteReader, wt: int, out &: Vector<f64>): bool:
mut ok := false
if wt == protobuf.WT_LEN:
mut b := protobuf.ReadLenPrefixedBuf(rd, ok)
if ok:
mut sub := compress.ReaderFromBuf(b)
until compress.RdLeft(sub) >= 8 and ok:
v := protobuf.ReadDouble(sub, ok)
if ok: out.push(v) end
end
end
compress.BufFree(b)
ret ok
end
v := protobuf.ReadDouble(rd, ok)
if ok: out.push(v) end
ret ok
end
func _raw_to_tensor(rt &: _RawTensor, out &: tensor.Tensor): bool:
mut shape := Vector {} as Vector<int>
mut total := 1
repeat rt.dims.len() in i:
shape.push(rt.dims.get(i))
total = total * rt.dims.get(i)
end
if shape.len() == 0:
shape.push(1)
total = 1
end
out.free()
out = tensor.Zeros(shape)
shape.free()
p := out.data.data
if rt.has_raw:
n := compress.BufLen(rt.raw)
if rt.dtype == _DT_FLOAT:
if n < total * 4: ret false end
mem.Copy(p as void*, rt.raw.data, (total * 4) as u64)
else rt.dtype == _DT_INT64:
if n < total * 8: ret false end
mut rd := compress.ReaderFromBuf(rt.raw)
repeat total in k: p[k] = binary.ReadU64LE(rd) as f32 end
else rt.dtype == _DT_INT32:
if n < total * 4: ret false end
mut rd := compress.ReaderFromBuf(rt.raw)
repeat total in k: p[k] = binary.ReadU32LE(rd) as f32 end
else rt.dtype == _DT_DOUBLE:
if n < total * 8: ret false end
mut rd := compress.ReaderFromBuf(rt.raw)
repeat total in k: p[k] = binary.ReadF64(rd, false) as f32 end
else:
ret false
end
ret true
end
if rt.values.len() < total: ret false end
repeat total in k: p[k] = rt.values.get(k) as f32 end
