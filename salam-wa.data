end
p3 := _vp8_pg(pl, p - 4 * step)
p2 := _vp8_pg(pl, p - 3 * step)
p1 := _vp8_pg(pl, p - 2 * step)
p0 := _vp8_pg(pl, p - step)
q0 := _vp8_pg(pl, p)
q1 := _vp8_pg(pl, p + step)
q2 := _vp8_pg(pl, p + 2 * step)
q3 := _vp8_pg(pl, p + 3 * step)
ret _vp8_abs(p3 - p2) <= it and _vp8_abs(p2 - p1) <= it and _vp8_abs(p1 - p0) <= it and _vp8_abs(q3 - q2) <= it and _vp8_abs(q2 - q1) <= it and _vp8_abs(q1 - q0) <= it
end
func _vp8_hev(pl: u8*, p: int, step: int, t: int): bool:
ret _vp8_abs(_vp8_pg(pl, p - 2 * step) - _vp8_pg(pl, p - step)) > t or _vp8_abs(_vp8_pg(pl, p + step) - _vp8_pg(pl, p)) > t
end
func _vp8_simple(pl: u8*, p: int, step: int, along: int, thresh: int):
t2 := 2 * thresh + 1
