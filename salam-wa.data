mut d := dcode - 120
if dcode < 1:
r.bad = true
else dcode <= 120:
dx := _WPD_DIST[(dcode - 1) * 2]
dy := _WPD_DIST[(dcode - 1) * 2 + 1]
d = dx + dy * xsize
