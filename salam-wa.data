@en "SubstrIn"
@fa "زیررشته درون"
pub func SubstrIn(s: str, start: int, n: int): str:
mut ln := n
if ln < 0: ln = 0 end
r := _str_alloc((ln + 1) as u64)
mem.Copy(r, ((_bp(s) as void*) as i64 + (start as i64)) as void*, ln as u64)
ret r as str
end
@en "Find"
@fa "یافتن"
pub inline pure func Find(s: str, sub: str): int: ret s.find(sub) end
@en "Split"
@fa "تفکیک کردن"
pub pure func Split(s: str, delim: str): Vector<str>: ret s.split(delim) end
@en "Join"
@fa "بپیوند"
pub func Join(parts: Vector<str>, sep: str): str:
mut sb := NewBuilder()
defer BufFree(sb)
repeat parts.len() in i:
if i > 0: BufAppend(sb, sep) end
BufAppend(sb, parts.get(i))
end
out := BufStr(sb)
ret out
end
@en "Trim"
@fa "پیرایش"
pub inline pure func Trim(s: str): str: ret s.trim() end
@en "ToInt"
@fa "تبدیل به عدد"
pub inline pure func ToInt(s: str): int: ret s.to_int() end
@en "ToFloat"
@fa "تبدیل به اعشار"
pub inline pure func ToFloat(s: str): f64: ret s.to_float() end
@en "IsEmpty"
@fa "خالی است"
pub inline pure func IsEmpty(s: str): bool: ret s.len() == 0 end
@en "Clone"
@fa "رونوشت"
pub func Clone(s: str): str:
n := s.len() as i64
r := _str_alloc((n + 1) as u64)
mem.Copy(r, s as void*, n as u64)
ret r as str
end
@en "Replace"
@fa "جایگزینی"
pub func Replace(s: str, find: str, replacement: str): str:
fl := find.len()
if fl == 0: ret Clone(s) end
n := s.len()
mut idx := IndexFrom(s, find, 0)
if idx < 0: ret Clone(s) end
mut sb := NewBuilder()
defer BufFree(sb)
mut i := 0
until idx >= 0:
if idx > i:
head := s.substr(i, idx - i)
BufAppend(sb, head)
mem.Free(head as void*)
end
BufAppend(sb, replacement)
i = idx + fl
idx = IndexFrom(s, find, i)
end
if i < n:
tail := s.substr(i, n - i)
BufAppend(sb, tail)
mem.Free(tail as void*)
end
ret BufStr(sb)
end
@en "FromInt"
@fa "از عدد"
pub func FromInt(i: i64): str: ret conv.FormatInt(i) end
if not SALAM_KERNEL:
@en "FromFloat"
@fa "از اعشار"
pub func FromFloat(f: f64): str: ret conv.FormatFloat(f) end
end
package str
@en "NewBuilder"
@fa "سازنده"
pub func NewBuilder(): StringBuilder:
ret StringBuilder { data = null, len = 0, cap = 0 }
end
@en "BufAppend"
@fa "افزودن به بافر"
pub func BufAppend(b &: StringBuilder, s: str):
n := s.len() as i64
if n <= 0: ret end
_buf_ensure(b, b.len + n)
dst := ((b.data as i64) + b.len) as void*
mem.Copy(dst, s as void*, n as u64)
b.len += n
end
@en "BufAppendChar"
@fa "افزودن نویسه به بافر"
pub func BufAppendChar(b &: StringBuilder, code: int):
_buf_ensure(b, b.len + 1)
p := b.data as i8*
p[b.len as int] = code as i8
b.len += 1
end
@en "BufAppendCp"
@fa "افزودن کدنقطه به بافر"
pub func BufAppendCp(b &: StringBuilder, cp: int):
mut c := cp
if c < 0 or c > 0x10FFFF: c = 0xFFFD end
if c < 0x80:
BufAppendChar(b, c)
else c < 0x800:
BufAppendChar(b, 0xC0 | (c >> 6))
BufAppendChar(b, 0x80 | (c & 0x3F))
else c < 0x10000:
BufAppendChar(b, 0xE0 | (c >> 12))
BufAppendChar(b, 0x80 | ((c >> 6) & 0x3F))
BufAppendChar(b, 0x80 | (c & 0x3F))
else:
BufAppendChar(b, 0xF0 | (c >> 18))
BufAppendChar(b, 0x80 | ((c >> 12) & 0x3F))
BufAppendChar(b, 0x80 | ((c >> 6) & 0x3F))
BufAppendChar(b, 0x80 | (c & 0x3F))
end
end
@en "BufAppendInt"
@fa "افزودن عدد به بافر"
pub func BufAppendInt(b &: StringBuilder, n: i64):
if n == 0:
BufAppendChar(b, 48)
ret
end
mut v := n
if v < 0:
BufAppendChar(b, 45)
v = 0 - v
end
start := b.len
until v > 0:
BufAppendChar(b, 48 + ((v % 10) as int))
v = v / 10
end
mut i := start
mut j := b.len - 1
p := b.data as i8*
until i < j:
lo := p[i as int]
hi := p[j as int]
p[i as int] = hi
p[j as int] = lo
i += 1
j -= 1
end
end
@en "BufLen"
@fa "طول بافر"
pub func BufLen(b &: StringBuilder): i64: ret b.len end
@en "BufIsEmpty"
@fa "بافر خالی است"
pub func BufIsEmpty(b &: StringBuilder): bool: ret b.len == 0 end
@en "BufStr"
@fa "رشته بافر"
pub func BufStr(b &: StringBuilder): str:
if b.data == null: ret Clone("") end
p := b.data as i8*
p[b.len as int] = 0 as i8
ret Clone(b.data as str)
end
@en "BufReset"
@fa "بازنشانی بافر"
pub func BufReset(b &: StringBuilder): b.len = 0 end
@en "BufFree"
@fa "آزادسازی بافر"
pub func BufFree(b &: StringBuilder):
if b.data != null: mem.Free(b.data) end
b.data = null
b.len = 0
b.cap = 0
end
package str
func _fold_next(bp: i8*, n: int, i &: int, src &: int, k &: int): int:
if src >= 0 and k < unicode.FullFoldLen(src):
cp := unicode.FullFoldAt(src, k)
k += 1
ret cp
end
if i >= n: ret 0 - 1 end
mut cur := 0
i = _decode_at(bp, n, i, cur)
src = cur
k = 1
ret unicode.FullFoldAt(cur, 0)
end
@en "Upper"
@fa "بزرگ"
pub inline pure func Upper(s: str): str: ret s.upper() end
@en "Lower"
@fa "کوچک"
pub inline pure func Lower(s: str): str: ret s.lower() end
@en "Title"
@fa "حالت عنوانی"
pub func Title(s: str): str:
n := _blen(s)
bp := _bp(s)
mut sb := NewBuilder()
defer BufFree(sb)
mut start := true
mut i := 0
mut cp := 0
until i < n:
i = _decode_at(bp, n, i, cp)
if IsSpace(cp):
start = true
BufAppendCp(sb, cp)
else:
if start:
BufAppendCp(sb, unicode.ToTitle(cp))
else:
BufAppendCp(sb, unicode.ToLower(cp))
end
start = false
end
end
out := BufStr(sb)
ret out
end
@en "EqualFold"
@fa "یکسان بدون حساسیت"
pub func EqualFold(a: str, b: str): bool:
an := _blen(a)
bn := _blen(b)
ap := _bp(a)
bq := _bp(b)
mut ai := 0
mut asrc := 0 - 1
mut ak := 0
mut bi := 0
mut bsrc := 0 - 1
mut bk := 0
until true:
ca := _fold_next(ap, an, ai, asrc, ak)
cb := _fold_next(bq, bn, bi, bsrc, bk)
if ca != cb: ret false end
if ca < 0: ret true end
end
end
@en "CompareFold"
@fa "مقایسه بدون حساسیت"
pub func CompareFold(a: str, b: str): int:
an := _blen(a)
bn := _blen(b)
ap := _bp(a)
bq := _bp(b)
mut ai := 0
mut asrc := 0 - 1
mut ak := 0
mut bi := 0
mut bsrc := 0 - 1
mut bk := 0
until true:
ca := _fold_next(ap, an, ai, asrc, ak)
cb := _fold_next(bq, bn, bi, bsrc, bk)
if ca != cb: ret ca - cb end
if ca < 0: ret 0 end
end
end
package str
import unicode
@en "IsAscii"
@fa "اسکی است"
pub inline pure func IsAscii(code: int): bool:
ret code >= 0 and code <= 127
end
@en "IsAsciiSpace"
@fa "فاصله اسکی است"
pub inline pure func IsAsciiSpace(code: int): bool:
ret code == 32 or (code >= 9 and code <= 13)
end
@en "IsAsciiDigit"
@fa "رقم اسکی است"
pub inline pure func IsAsciiDigit(code: int): bool:
ret code >= 48 and code <= 57
end
@en "IsAsciiUpper"
@fa "بزرگ اسکی است"
pub inline pure func IsAsciiUpper(code: int): bool:
ret code >= 65 and code <= 90
end
@en "IsAsciiLower"
@fa "کوچک اسکی است"
pub inline pure func IsAsciiLower(code: int): bool:
ret code >= 97 and code <= 122
end
@en "IsAsciiAlpha"
@fa "حرف اسکی است"
pub inline pure func IsAsciiAlpha(code: int): bool:
ret IsAsciiUpper(code) or IsAsciiLower(code)
end
@en "IsAsciiAlnum"
@fa "الفبایی عددی اسکی است"
pub inline pure func IsAsciiAlnum(code: int): bool:
ret IsAsciiAlpha(code) or IsAsciiDigit(code)
end
@en "IsSpace"
@fa "فاصله است"
pub pure func IsSpace(code: int): bool:
if IsAscii(code): ret IsAsciiSpace(code) end
ret unicode.IsSpace(code)
end
@en "IsDigit"
@fa "رقم است"
pub pure func IsDigit(code: int): bool:
if IsAscii(code): ret IsAsciiDigit(code) end
ret unicode.IsDigit(code)
end
@en "IsUpper"
@fa "بزرگ است"
pub pure func IsUpper(code: int): bool:
if IsAscii(code): ret IsAsciiUpper(code) end
ret unicode.IsUpper(code)
end
@en "IsLower"
@fa "کوچک است"
pub pure func IsLower(code: int): bool:
if IsAscii(code): ret IsAsciiLower(code) end
ret unicode.IsLower(code)
end
@en "IsAlpha"
@fa "حرف است"
pub pure func IsAlpha(code: int): bool:
if IsAscii(code): ret IsAsciiAlpha(code) end
ret unicode.IsAlphabetic(code)
end
@en "IsAlnum"
@fa "الفبایی عددی است"
pub pure func IsAlnum(code: int): bool:
if IsAscii(code): ret IsAsciiAlnum(code) end
ret unicode.IsAlnum(code)
end
@en "IsPunct"
@fa "نشانه نگارشی است"
pub pure func IsPunct(code: int): bool:
ret unicode.IsPunct(code)
end
@en "IsMark"
@fa "نشانه است"
pub pure func IsMark(code: int): bool:
ret unicode.IsMark(code)
end
@en "IsControl"
@fa "کنترلی است"
pub pure func IsControl(code: int): bool:
ret unicode.IsControl(code)
end
package str
const _DIGIT_ASCII_BASE := 0x30
const _DIGIT_ARABIC_BASE := 0x0660
const _DIGIT_PERSIAN_BASE := 0x06F0
pure func _digit_value(cp: int): int:
if cp >= _DIGIT_ASCII_BASE and cp <= _DIGIT_ASCII_BASE + 9: ret cp - _DIGIT_ASCII_BASE
else cp >= _DIGIT_ARABIC_BASE and cp <= _DIGIT_ARABIC_BASE + 9: ret cp - _DIGIT_ARABIC_BASE
else cp >= _DIGIT_PERSIAN_BASE and cp <= _DIGIT_PERSIAN_BASE + 9: ret cp - _DIGIT_PERSIAN_BASE
else:
ret 0 - 1
end
end
func _append_digit(b &: StringBuilder, digit: int, base: int):
BufAppendCp(b, base + digit)
end
func _convert_digits(s: str, base: int): str:
n := _blen(s)
bp := _bp(s)
mut b := NewBuilder()
defer BufFree(b)
mut i := 0
until i < n:
mut cp := 0
next_i := _decode_at(bp, n, i, cp)
digit := _digit_value(cp)
if digit >= 0:
_append_digit(b, digit, base)
else:
_buf_append_range(b, s, i, next_i - i)
end
i = next_i
end
ret BufStr(b)
end
func _has_digit_script(s: str, base: int): bool:
n := _blen(s)
bp := _bp(s)
mut i := 0
until i < n:
mut cp := 0
next_i := _decode_at(bp, n, i, cp)
if cp >= base and cp <= base + 9: ret true end
i = next_i
end
ret false
end
@en "DigitValue"
@fa "مقدار رقم"
pub inline pure func DigitValue(cp: int): int: ret _digit_value(cp) end
@en "IsArabicDigit"
@fa "رقم عربی است"
pub inline pure func IsArabicDigit(cp: int): bool:
ret cp >= _DIGIT_ARABIC_BASE and cp <= _DIGIT_ARABIC_BASE + 9
end
@en "IsPersianDigit"
@fa "رقم فارسی است"
pub inline pure func IsPersianDigit(cp: int): bool:
ret cp >= _DIGIT_PERSIAN_BASE and cp <= _DIGIT_PERSIAN_BASE + 9
end
@en "IsAnyDigit"
@fa "رقم فارسی عربی انگلیسی است"
pub inline pure func IsAnyDigit(cp: int): bool: ret _digit_value(cp) >= 0 end
@en "ToEnglishDigits"
@fa "به رقم انگلیسی"
pub func ToEnglishDigits(s: str): str: ret _convert_digits(s, _DIGIT_ASCII_BASE) end
@en "ToArabicDigits"
@fa "به رقم عربی"
pub func ToArabicDigits(s: str): str: ret _convert_digits(s, _DIGIT_ARABIC_BASE) end
@en "ToPersianDigits"
@fa "به رقم فارسی"
pub func ToPersianDigits(s: str): str: ret _convert_digits(s, _DIGIT_PERSIAN_BASE) end
@en "HasEnglishDigits"
@fa "دارای رقم انگلیسی است"
pub func HasEnglishDigits(s: str): bool: ret _has_digit_script(s, _DIGIT_ASCII_BASE) end
@en "HasArabicDigits"
@fa "دارای رقم عربی است"
pub func HasArabicDigits(s: str): bool: ret _has_digit_script(s, _DIGIT_ARABIC_BASE) end
@en "HasPersianDigits"
@fa "دارای رقم فارسی است"
pub func HasPersianDigits(s: str): bool: ret _has_digit_script(s, _DIGIT_PERSIAN_BASE) end
package str
@en "Repeat"
@fa "تکرار"
pub inline pure func Repeat(s: str, n: int): str: ret s.repeat(n) end
@en "Fields"
@fa "واژه ها"
pub func Fields(s: str): Vector<str>:
out := Vector {} as Vector<str> n := _blen(s)
bp := _bp(s)
mut i := 0
mut cp := 0
until i < n:
until i < n:
next := _decode_at(bp, n, i, cp)
if IsSpace(cp) == false: break end
i = next
end
start := i
until i < n:
next := _decode_at(bp, n, i, cp)
if IsSpace(cp): break end
i = next
end
if i > start:
out.push(_bsub(s, start, i - start))
end
end
ret out
end
package str
func _gcb_is_break(prev: int, curr: int, ri_run: int, pict_zwj: bool, conjunct: bool): bool:
pc := unicode.GraphemeBreak(prev)
cc := unicode.GraphemeBreak(curr)
if pc == unicode.GcbCR and cc == unicode.GcbLF: ret false end
if pc == unicode.GcbControl or pc == unicode.GcbCR or pc == unicode.GcbLF: ret true end
if cc == unicode.GcbControl or cc == unicode.GcbCR or cc == unicode.GcbLF: ret true end
if pc == unicode.GcbL:
if cc == unicode.GcbL or cc == unicode.GcbV or cc == unicode.GcbLV or cc == unicode.GcbLVT: ret false end
end
if pc == unicode.GcbLV or pc == unicode.GcbV:
if cc == unicode.GcbV or cc == unicode.GcbT: ret false end
end
if pc == unicode.GcbLVT or pc == unicode.GcbT:
if cc == unicode.GcbT: ret false end
end
if cc == unicode.GcbExtend or cc == unicode.GcbZWJ: ret false end
if cc == unicode.GcbSpacingMark: ret false end
if pc == unicode.GcbPrepend: ret false end
if conjunct and unicode.ConjunctBreak(curr) == unicode.IncbConsonant: ret false end
if pc == unicode.GcbZWJ and cc == unicode.GcbExtendedPictographic and pict_zwj: ret false end
if pc == unicode.GcbRegionalIndicator and cc == unicode.GcbRegionalIndicator:
if ri_run % 2 == 1: ret false end
end
ret true
end
func _gcb_pict_next(state: int, cp: int): int:
k := unicode.GraphemeBreak(cp)
if k == unicode.GcbExtendedPictographic: ret 1 end
if state == 1 and k == unicode.GcbExtend: ret 1 end
if state == 1 and k == unicode.GcbZWJ: ret 2 end
ret 0
end
func _gcb_conj_next(state: int, cp: int): int:
k := unicode.ConjunctBreak(cp)
if k == unicode.IncbConsonant: ret 1 end
if state > 0 and k == unicode.IncbLinker: ret 2 end
if state > 0 and k == unicode.IncbExtend: ret state end
ret 0
end
@en "GraphemeCount"
@fa "شمار خوشه"
pub func GraphemeCount(s: str): int:
n := _blen(s)
if n == 0: ret 0 end
bp := _bp(s)
mut count := 1
mut prev := 0
mut i := _decode_at(bp, n, 0, prev)
mut ri_run := 0
if unicode.GraphemeBreak(prev) == unicode.GcbRegionalIndicator: ri_run = 1 end
mut pict := _gcb_pict_next(0, prev)
mut conj := _gcb_conj_next(0, prev)
mut curr := 0
until i < n:
i = _decode_at(bp, n, i, curr)
if _gcb_is_break(prev, curr, ri_run, pict == 2, conj == 2):
count += 1
ri_run = 0
end
if unicode.GraphemeBreak(curr) == unicode.GcbRegionalIndicator:
ri_run += 1
else:
ri_run = 0
end
pict = _gcb_pict_next(pict, curr)
conj = _gcb_conj_next(conj, curr)
prev = curr
end
ret count
end
@en "Graphemes"
@fa "خوشه ها"
pub func Graphemes(s: str): Vector<str>:
out := Vector {} as Vector<str>
n := _blen(s)
if n == 0: ret out end
bp := _bp(s)
mut prev := 0
mut start := 0
mut i := _decode_at(bp, n, 0, prev)
mut ri_run := 0
if unicode.GraphemeBreak(prev) == unicode.GcbRegionalIndicator: ri_run = 1 end
mut pict := _gcb_pict_next(0, prev)
mut conj := _gcb_conj_next(0, prev)
mut curr := 0
until i < n:
at := i
i = _decode_at(bp, n, i, curr)
if _gcb_is_break(prev, curr, ri_run, pict == 2, conj == 2):
out.push(_bsub(s, start, at - start))
start = at
ri_run = 0
end
if unicode.GraphemeBreak(curr) == unicode.GcbRegionalIndicator:
ri_run += 1
else:
ri_run = 0
end
pict = _gcb_pict_next(pict, curr)
conj = _gcb_conj_next(conj, curr)
prev = curr
end
out.push(_bsub(s, start, n - start))
ret out
end
@en "ReverseGraphemes"
@fa "برعکس خوشه ای"
pub func ReverseGraphemes(s: str): str:
parts := Graphemes(s)
defer parts.free()
mut sb := NewBuilder()
defer BufFree(sb)
mut i := parts.len() - 1
until i >= 0:
BufAppend(sb, parts.get(i))
i -= 1
end
ret BufStr(sb)
end
package str
func _canonical_order(buf &: Vector<int>):
n := buf.len()
mut i := 1
until i < n:
cp := buf.get(i)
cc := unicode.CombiningClass(cp)
if cc != 0:
mut j := i - 1
until j >= 0 and unicode.CombiningClass(buf.get(j)) > cc:
buf.set(j + 1, buf.get(j))
j -= 1
end
buf.set(j + 1, cp)
end
i += 1
end
end
func _decompose(s: str, compat: bool): Vector<int>:
out := Vector {} as Vector<int>
n := _blen(s)
bp := _bp(s)
mut i := 0
mut cp := 0
until i < n:
i = _decode_at(bp, n, i, cp)
if cp < 0: cp = 0xFFFD end
mut count := unicode.DecompLen(cp)
if compat: count = unicode.CompatDecompLen(cp) end
mut k := 0
until k < count:
if compat:
out.push(unicode.CompatDecompAt(cp, k))
else:
out.push(unicode.DecompAt(cp, k))
end
k += 1
end
end
_canonical_order(out)
ret out
end
func _compose_canonical(buf: Vector<int>): Vector<int>:
out := Vector {} as Vector<int>
n := buf.len()
if n == 0: ret out end
mut starter_pos := 0
mut starter := buf.get(0)
out.push(starter)
mut last_class := unicode.CombiningClass(starter)
if last_class != 0: last_class = 256 end
mut pos := 1
until pos < n:
ch := buf.get(pos)
ch_class := unicode.CombiningClass(ch)
composite := unicode.Compose(starter, ch)
if composite >= 0 and (last_class < ch_class or last_class == 0):
out.set(starter_pos, composite)
starter = composite
else:
if ch_class == 0:
starter_pos = out.len()
starter = ch
end
last_class = ch_class
out.push(ch)
end
pos += 1
end
ret out
end
func _cps_to_str(cps: Vector<int>): str:
mut sb := NewBuilder()
defer BufFree(sb)
repeat cps.len() in i:
BufAppendCp(sb, cps.get(i))
end
ret BufStr(sb)
end
@en "NFD"
@fa "تجزیه متعارف"
pub func NFD(s: str): str:
cps := _decompose(s, false)
defer cps.free()
ret _cps_to_str(cps)
end
@en "NFC"
@fa "ترکیب متعارف"
pub func NFC(s: str): str:
d := _decompose(s, false)
defer d.free()
c := _compose_canonical(d)
defer c.free()
ret _cps_to_str(c)
end
@en "NFKD"
@fa "تجزیه سازگاری"
pub func NFKD(s: str): str:
cps := _decompose(s, true)
defer cps.free()
ret _cps_to_str(cps)
end
@en "NFKC"
@fa "ترکیب سازگاری"
pub func NFKC(s: str): str:
d := _decompose(s, true)
defer d.free()
c := _compose_canonical(d)
defer c.free()
ret _cps_to_str(c)
end
@en "IsNFC"
@fa "متعارف است"
pub func IsNFC(s: str): bool:
ret NFC(s) == s
end
package str
import mem
extern:
func strtod(s: str, endptr: void*): f64
noret func abort()
end
noret func _str_oom():
printerrln "salam: out of memory while building a string"
abort()
end
func _str_alloc(n: u64): void*:
p := mem.AllocateZeroed(n)
if p == null:
_str_oom()
end
ret p
end
export:
func salam_strcat(a: str, b: str): str:
la := a.len() as i64
lb := b.len() as i64
r := _str_alloc((la + lb + 1) as u64)
mem.Copy(r, a as void*, la as u64)
mem.Copy(((r as i64) + la) as void*, b as void*, lb as u64)
ret r as str
end
func salam_strcat_own(a: str, fa: int, b: str, fb: int): str:
r := salam_strcat(a, b)
if fa != 0: mem.Free(a as void*) end
if fb != 0: mem.Free(b as void*) end
ret r
end
func salam_char_from_code(c: int): str:
r := _str_alloc(2 as u64)
mem.Set(r, c, 1 as u64)
ret r as str
end
func salam_uchar_code(c: str): int:
n := _blen(c)
if n == 0:
ret 0
end
mut cp := 0
_decode_at(_bp(c), n, 0, cp)
if cp < 0:
ret 0xFFFD
end
ret cp
end
func salam_uchar_from_code(cp: int): str:
mut sb := NewBuilder()
defer BufFree(sb)
BufAppendCp(sb, cp)
ret BufStr(sb)
end
func salam_str_substr(s: str, start: int, n: int): str:
slen := s.len()
mut st := start
mut ln := n
if st < 0: st = 0 end
if st > slen: st = slen end
if ln < 0: ln = 0 end
if st + ln > slen: ln = slen - st end
r := _str_alloc((ln + 1) as u64)
mem.Copy(r, ((_bp(s) as void*) as i64 + (st as i64)) as void*, ln as u64)
ret r as str
end
func salam_str_char_count(s: str): int:
ret CharCount(s)
end
func salam_str_char_at(s: str, i: int): str:
ret CharAtIndex(s, i)
end
func salam_str_char_substr(s: str, start: int, n: int): str:
ret CharSubstr(s, start, n)
end
func salam_str_char_find(s: str, sub: str): int:
ret CharFind(s, sub)
end
func salam_str_ascii_digits(s: str): str:
n := s.len()
p := _bp(s)
mut hit := false
mut i := 0
until i + 1 < n and not hit:
hit = _ub(p, i) == 0xDB or _ub(p, i) == 0xD9
i += 1
end
if not hit:
ret s
end
r := _str_alloc((n + 1) as u64)
rp := r as i8*
mut j := 0
mut k := 0
until j < n:
b0 := _ub(p, j)
mut b1 := 0
if j + 1 < n: b1 = _ub(p, j + 1) end
if b0 == 0xDB and b1 >= 0xB0 and b1 <= 0xB9:
rp[k] = (48 + b1 - 0xB0) as i8
j += 2
else b0 == 0xD9 and b1 >= 0xA0 and b1 <= 0xA9:
rp[k] = (48 + b1 - 0xA0) as i8
j += 2
else b0 == 0xD9 and b1 == 0xAB:
rp[k] = 46 as i8
j += 2
else:
rp[k] = p[j]
j += 1
end
k += 1
end
ret r as str
end
func salam_strtof64(s: str): f64:
t := salam_str_ascii_digits(s)
v := strtod(t, null)
if (t as void*) != (s as void*):
mem.Free(t as void*)
end
ret v
end
func salam_strtoi32(s: str): int:
t := salam_str_ascii_digits(s)
v := salam_strtoi32_ascii(t)
if (t as void*) != (s as void*):
mem.Free(t as void*)
end
ret v
end
func salam_strtoi32_ascii(s: str): int:
n := s.len()
p := _bp(s)
mut i := 0
until i < n and (_ub(p, i) == 32 or _ub(p, i) == 9 or _ub(p, i) == 10 or _ub(p, i) == 13):
i += 1
end
mut neg := false
if i < n and _ub(p, i) == 45:
neg = true
i += 1
else i < n and _ub(p, i) == 43:
i += 1
end
mut lim := 2147483647 as u64
if neg: lim = 2147483648 as u64 end
mut acc := 0 as u64
until i < n and _ub(p, i) >= 48 and _ub(p, i) <= 57:
d := (_ub(p, i) - 48) as u64
if acc > (lim - d) / (10 as u64):
acc = lim
else:
acc = acc * (10 as u64) + d
end
i += 1
end
if neg: ret (0 - (acc as i64)) as int end
ret acc as int
end
end
package str
@en "Contains"
@fa "شامل است"
pub inline pure func Contains(s: str, sub: str): bool:
ret s.find(sub) >= 0
end
@en "StartsWith"
@fa "شروع با"
pub pure func StartsWith(s: str, prefix: str): bool:
m := _blen(prefix)
if m > _blen(s): ret false end
ret _match_at(_bp(s), 0, _bp(prefix), m)
end
@en "EndsWith"
@fa "پایان با"
pub pure func EndsWith(s: str, suffix: str): bool:
m := _blen(suffix)
n := _blen(s)
if m > n: ret false end
ret _match_at(_bp(s), n - m, _bp(suffix), m)
end
@en "Search"
@fa "جستجو"
pub inline pure func Search(s: str, sub: str): int: ret s.search(sub) end
@en "IndexOf"
@fa "اندیس"
pub inline pure func IndexOf(s: str, sub: str): int: ret s.indexOf(sub) end
@en "IndexFrom"
@fa "اندیس از"
pub pure func IndexFrom(s: str, sub: str, from: int): int:
n := _blen(s)
m := _blen(sub)
mut i := from
if i < 0: i = 0 end
i = _bidx_in(s, i)
if i > n: ret 0 - 1 end
if m == 0: ret _bidx_out(s, i) end
hp := _bp(s)
np := _bp(sub)
until i + m <= n:
if _match_at(hp, i, np, m): ret _bidx_out(s, i) end
i += 1
end
ret 0 - 1
end
@en "Count"
@fa "شمارش"
pub pure func Count(s: str, sub: str): int:
m := _blen(sub)
if m == 0: ret 0 end
n := _blen(s)
hp := _bp(s)
np := _bp(sub)
mut count := 0
mut i := 0
until i + m <= n:
if _match_at(hp, i, np, m):
count += 1
i += m
else:
i += 1
end
end
ret count
end
@en "LastIndex"
@fa "آخرین اندیس"
pub pure func LastIndex(s: str, sub: str): int:
n := _blen(s)
m := _blen(sub)
if m == 0 or m > n: ret 0 - 1 end
hp := _bp(s)
np := _bp(sub)
mut i := n - m
until i >= 0:
if _match_at(hp, i, np, m): ret _bidx_out(s, i) end
i -= 1
end
ret 0 - 1
end
@fa "رشته"
@en "str"
package str
import mem
import conv
import unicode
extern:
pure func strcmp(a: str, b: str): int
end
@en "StringBuilder"
@fa "سازنده رشته"
pub struct StringBuilder:
pub data: void* = null
pub len: i64 = 0
pub cap: i64 = 0
end
inline pure func _bp(s: str): i8*: ret (s as void*) as i8* end
inline pure func _ub(bp: i8*, i: int): int:
mut v := bp[i] as int
if v < 0: v = v + 256 end
ret v
end
inline pure func _blen(s: str): int: ret s.len() end
inline pure func _bidx_in(s: str, i: int): int: ret i end
inline pure func _bidx_out(s: str, b: int): int: ret b end
inline func _bsub(s: str, start: int, n: int): str: ret s.substr(start, n) end
pure func _match_at(hp: i8*, hi: int, np: i8*, n: int): bool:
repeat n in k:
if hp[hi + k] != np[k]: ret false end
end
ret true
end
func _buf_ensure(b &: StringBuilder, need: i64):
if need + 1 <= b.cap: ret end
mut c := b.cap
if c == 0: c = 64 end
until c < need + 1: c = c * 2 end
b.data = mem.Reallocate(b.data, c as u64)
b.cap = c
end
if SALAM_JS:
func _buf_append_range(b &: StringBuilder, s: str, start: int, n: int):
BufAppend(b, _bsub(s, start, n))
end
else:
func _buf_append_range(b &: StringBuilder, s: str, start: int, n: int):
if n <= 0: ret end
_buf_ensure(b, b.len + (n as i64))
dst := ((b.data as i64) + b.len) as void*
mem.Copy(dst, ((s as void*) as i64 + (start as i64)) as void*, n as u64)
b.len += n as i64
end
end
package str
@en "TrimLeft"
@fa "پیرایش چپ"
pub func TrimLeft(s: str): str:
n := _blen(s)
bp := _bp(s)
mut i := 0
mut cp := 0
until i < n:
next := _decode_at(bp, n, i, cp)
if IsSpace(cp) == false: break end
i = next
end
if i == 0: ret Clone(s) end
ret _bsub(s, i, n - i)
end
@en "TrimRight"
@fa "پیرایش راست"
pub func TrimRight(s: str): str:
n := _blen(s)
bp := _bp(s)
mut e := n
mut cp := 0
until e > 0:
start := _prev_boundary(bp, e)
_dropped := _decode_at(bp, n, start, cp)
if IsSpace(cp) == false: break end
e = start
end
if e == n: ret Clone(s) end
ret _bsub(s, 0, e)
end
@en "TrimPrefix"
@fa "حذف پیشوند"
pub func TrimPrefix(s: str, prefix: str): str:
if StartsWith(s, prefix):
ret _bsub(s, _blen(prefix), _blen(s) - _blen(prefix))
end
ret Clone(s)
end
@en "TrimSuffix"
@fa "حذف پسوند"
pub func TrimSuffix(s: str, suffix: str): str:
if EndsWith(s, suffix):
ret _bsub(s, 0, _blen(s) - _blen(suffix))
end
ret Clone(s)
end
package str
func _decode_at(bp: i8*, n: int, i: int, cp &: int): int:
b0 := _ub(bp, i)
char_len := CharLen(b0)
next_i := i + char_len
if next_i > n:
cp = 0 - 1
ret n
end
if char_len == 1:
cp = b0
else char_len == 2:
cp = ((b0 & 0x1F) << 6) | (_ub(bp, i + 1) & 0x3F)
else char_len == 3:
cp = ((b0 & 0x0F) << 12) | ((_ub(bp, i + 1) & 0x3F) << 6) | (_ub(bp, i + 2) & 0x3F)
else:
cp = ((b0 & 0x07) << 18) | ((_ub(bp, i + 1) & 0x3F) << 12) | ((_ub(bp, i + 2) & 0x3F) << 6) | (_ub(bp, i + 3) & 0x3F)
end
ret next_i
end
pure func _prev_boundary(bp: i8*, e: int): int:
mut b := e - 1
until b > 0 and _ub(bp, b) >= 128 and _ub(bp, b) < 192:
b -= 1
end
ret b
end
pure func _char_advance(bp: i8*, n: int, from: int, k: int): int:
mut i := from
mut c := 0
until c < k and i < n:
mut char_len := CharLen(_ub(bp, i))
if i + char_len > n: char_len = n - i end
i += char_len
c += 1
end
ret i
end
@en "CodePointAt"
@fa "کدنقطه در"
pub func CodePointAt(s: str, i: int, cp &: int): int:
n := _blen(s)
bi := _bidx_in(s, i)
if bi < 0 or bi >= n:
cp = 0 - 1
ret _bidx_out(s, n)
end
ret _bidx_out(s, _decode_at(_bp(s), n, bi, cp))
end
@en "CharLen"
@fa "طول نویسه"
pub inline pure func CharLen(lead: int): int:
if lead >= 240: ret 4
else lead >= 224: ret 3
else lead >= 192: ret 2
else:
ret 1
end
end
@en "CharAt"
@fa "نویسه در"
pub func CharAt(s: str, i: int): str:
n := _blen(s)
bi := _bidx_in(s, i)
if bi < 0 or bi >= n: ret "" end
mut char_len := CharLen(_ub(_bp(s), bi))
if bi + char_len > n: char_len = n - bi end
ret _bsub(s, bi, char_len)
end
@en "Reverse"
@fa "برعکس"
pub func Reverse(s: str): str:
n := _blen(s)
bp := _bp(s)
mut sb := NewBuilder()
defer BufFree(sb)
mut e := n
until e > 0:
b := _prev_boundary(bp, e)
_buf_append_range(sb, s, b, e - b)
e = b
end
out := BufStr(sb)
ret out
end
@en "CharCount"
@fa "شمارنویسه"
pub pure func CharCount(s: str): int:
n := _blen(s)
bp := _bp(s)
mut count := 0
mut i := 0
until i < n:
mut char_len := CharLen(_ub(bp, i))
if i + char_len > n: char_len = n - i end
count += 1
i += char_len
end
ret count
end
@en "CharSubstr"
@fa "زیررشته نویسه"
pub func CharSubstr(s: str, start: int, n: int): str:
total := _blen(s)
bp := _bp(s)
mut st := start
mut ln := n
if st < 0: st = 0 end
if ln < 0: ln = 0 end
b0 := _char_advance(bp, total, 0, st)
b1 := _char_advance(bp, total, b0, ln)
ret _bsub(s, b0, b1 - b0)
end
@en "CharAtIndex"
@fa "نویسه شماره"
pub func CharAtIndex(s: str, i: int): str:
ret CharSubstr(s, i, i < 0 ? 0 : 1)
end
@en "CharFind"
@fa "بیاب نویسه"
pub pure func CharFind(s: str, sub: str): int:
found := s.find(sub)
if found < 0: ret 0 - 1 end
off := _bidx_in(s, found)
bp := _bp(s)
mut count := 0
mut i := 0
until i < off:
i += CharLen(_ub(bp, i))
count += 1
end
ret count
end
@en "CodePoints"
@fa "کدنقطه ها"
pub func CodePoints(s: str): Vector<int>:
out := Vector {} as Vector<int>
n := _blen(s)
bp := _bp(s)
mut i := 0
mut cp := 0
until i < n:
i = _decode_at(bp, n, i, cp)
if cp < 0: cp = 0xFFFD end
out.push(cp)
end
ret out
end
@en "FromCodePoints"
@fa "از کدنقطه ها"
pub func FromCodePoints(cps: Vector<int>): str:
mut sb := NewBuilder()
defer BufFree(sb)
repeat cps.len() in i:
BufAppendCp(sb, cps.get(i))
end
ret BufStr(sb)
end
@en "AllAscii"
@fa "همه اسکی"
pub pure func AllAscii(s: str): bool:
n := _blen(s)
bp := _bp(s)
repeat n in i:
if _ub(bp, i) >= 128: ret false end
end
ret true
end
@en "Chars"
@fa "نویسه ها"
pub func Chars(s: str): Vector<str>:
out := Vector {} as Vector<str> n := _blen(s)
bp := _bp(s)
mut i := 0
until i < n:
mut char_len := CharLen(_ub(bp, i))
if i + char_len > n: char_len = n - i end
out.push(_bsub(s, i, char_len))
i += char_len
end
ret out
end
@en "sync"
@fa "همگام سازی"
package sync
import mem
if SALAM_OS_UNIX:
if not defined(SALAM_CC_TCC):
link dynamic "pthread"
end
end
if SALAM_OS_WINDOWS:
link dynamic "kernel32"
extern:
func InitializeCriticalSection(cs: void*)
func EnterCriticalSection(cs: void*)
func LeaveCriticalSection(cs: void*)
func DeleteCriticalSection(cs: void*)
func GetModuleHandleA(name: str): void*
func GetProcAddress(mod: void*, name: str): void*
func GetTickCount(): u32
func Sleep(ms: int)
end
else:
extern:
func pthread_mutex_init(mutex: void*, attr: void*): int
func pthread_mutex_lock(mutex: void*): int
func pthread_mutex_unlock(mutex: void*): int
func pthread_mutex_destroy(mutex: void*): int
func pthread_cond_init(cond: void*, attr: void*): int
func pthread_cond_wait(cond: void*, mutex: void*): int
func pthread_cond_timedwait(cond: void*, mutex: void*, abstime: void*): int
func clock_gettime(clk: int, ts: void*): int
func pthread_cond_signal(cond: void*): int
func pthread_cond_broadcast(cond: void*): int
func pthread_cond_destroy(cond: void*): int
func usleep(us: u32): int
end
end
const MUTEX_BYTES := 128
const COND_BYTES := 128
if SALAM_OS_WINDOWS:
_k32 := GetModuleHandleA("kernel32.dll")
_cv_init_fn := GetProcAddress(_k32, "InitializeConditionVariable")
_cv_sleep_fn := GetProcAddress(_k32, "SleepConditionVariableCS")
_cv_wake_fn := GetProcAddress(_k32, "WakeConditionVariable")
_cv_wake_all_fn := GetProcAddress(_k32, "WakeAllConditionVariable")
_tick64_fn := GetProcAddress(_k32, "GetTickCount64")
end
@en "Mutex"
@fa "قفل"
pub struct Mutex:
pub handle: void* = null
end
@en "CondVar"
@fa "متغیر شرط"
pub struct CondVar:
pub handle: void* = null
end
@en "WaitGroup"
@fa "گروه انتظار"
pub struct WaitGroup:
pub counter: i64* = null
pub mu: void* = null
pub cv: void* = null
end
@en "RWMutex"
@fa "قفل خواندن نوشتن"
pub struct RWMutex:
pub state: i64* = null
pub mu: void* = null
pub cv: void* = null
end
@en "Semaphore"
@fa "نشانگر"
pub struct Semaphore:
pub permits: i64* = null
pub mu: void* = null
pub cv: void* = null
end
@en "Once"
@fa "یک بار"
pub struct Once:
pub done: i64* = null
pub mu: void* = null
end
if SALAM_OS_WINDOWS:
func mutex_new(): void*:
m := mem.Allocate(MUTEX_BYTES as u64)
InitializeCriticalSection(m)
ret m
end
func mutex_lock(h: void*): int:
EnterCriticalSection(h)
ret 0
end
func mutex_unlock(h: void*): int:
LeaveCriticalSection(h)
ret 0
end
func mutex_free(h: void*):
DeleteCriticalSection(h)
mem.Free(h)
end
func cond_new(): void*:
c := mem.Allocate(COND_BYTES as u64)
if _cv_init_fn != null:
f := _cv_init_fn as extern func (void*) void
f(c)
end
ret c
end
func cond_wait(c: void*, m: void*):
if _cv_sleep_fn == null:
LeaveCriticalSection(m)
Sleep(1)
EnterCriticalSection(m)
ret
end
f := _cv_sleep_fn as extern func (void*, void*, int) int
f(c, m, 0 - 1)
end
func cond_timedwait(c: void*, m: void*, ms: i64): bool:
if _cv_sleep_fn == null:
LeaveCriticalSection(m)
mut nap := ms
if nap > 1: nap = 1 end
if nap < 0: nap = 0 end
Sleep(nap as int)
EnterCriticalSection(m)
ret false
end
f := _cv_sleep_fn as extern func (void*, void*, int) int
ret f(c, m, ms as int) == 0
end
func now_ms_os(): i64:
if _tick64_fn == null: ret GetTickCount() as i64 end
f := _tick64_fn as extern func () u64
ret f() as i64
end
func cond_signal(c: void*):
if _cv_wake_fn == null: ret end
f := _cv_wake_fn as extern func (void*) void
f(c)
end
func cond_broadcast(c: void*):
if _cv_wake_all_fn == null: ret end
f := _cv_wake_all_fn as extern func (void*) void
f(c)
end
func cond_free(c: void*): mem.Free(c) end
func _sync_sleep_ms(ms: int): Sleep(ms) end
else:
func mutex_new(): void*:
m := mem.Allocate(MUTEX_BYTES as u64)
pthread_mutex_init(m, null)
ret m
end
func mutex_lock(h: void*): int:
if pthread_mutex_lock(h) == 0: ret 0 end
ret 0 - 1
end
func mutex_unlock(h: void*): int:
if pthread_mutex_unlock(h) == 0: ret 0 end
ret 0 - 1
end
func mutex_free(h: void*):
pthread_mutex_destroy(h)
mem.Free(h)
end
func cond_new(): void*:
c := mem.Allocate(COND_BYTES as u64)
pthread_cond_init(c, null)
ret c
end
func cond_wait(c: void*, m: void*):
pthread_cond_wait(c, m)
end
func ts_read_sec(ts: void*): i64:
if sizeof(void*) == 8:
q := ts as i64*
ret q[0]
end
q32 := ts as i32*
ret q32[0]
end
func ts_read_nsec(ts: void*): i64:
if sizeof(void*) == 8:
q := ts as i64*
ret q[1]
end
q32 := ts as i32*
ret q32[1]
end
func ts_write(ts: void*, sec: i64, nsec: i64):
if sizeof(void*) == 8:
q := ts as i64*
q[0] = sec
q[1] = nsec
ret
end
q32 := ts as i32*
q32[0] = sec as i32
q32[1] = nsec as i32
end
func cond_timedwait(c: void*, m: void*, ms: i64): bool:
ts := mem.AllocateZeroed(32 as u64)
clock_gettime(0, ts)
total := ts_read_nsec(ts) + (ms % 1000) * 1000000
ts_write(ts, ts_read_sec(ts) + (ms / 1000) + (total / 1000000000), total % 1000000000)
rc := pthread_cond_timedwait(c, m, ts)
mem.Free(ts)
ret rc != 0
end
func now_ms_os(): i64:
ts := mem.AllocateZeroed(32 as u64)
clock_gettime(0, ts)
ms := ts_read_sec(ts) * 1000 + ts_read_nsec(ts) / 1000000
mem.Free(ts)
ret ms
end
func cond_signal(c: void*): pthread_cond_signal(c) end
func cond_broadcast(c: void*): pthread_cond_broadcast(c) end
func cond_free(c: void*):
pthread_cond_destroy(c)
mem.Free(c)
end
func _sync_sleep_ms(ms: int):
if ms > 0: usleep((ms * 1000) as u32) end
end
end
@en "NewMutex"
@fa "قفل جدید"
pub func NewMutex(): Mutex: ret Mutex { handle = mutex_new() } end
@en "Lock"
@fa "قفل کردن"
pub func Lock(m: Mutex): int: ret mutex_lock(m.handle) end
@en "Unlock"
@fa "باز کردن قفل"
pub func Unlock(m: Mutex): int: ret mutex_unlock(m.handle) end
@en "Destroy"
@fa "نابودسازی"
pub func Destroy(m: Mutex): mutex_free(m.handle) end
@en "SleepMs"
@fa "خواب میلی ثانیه"
pub func SleepMs(ms: int): _sync_sleep_ms(ms) end
@en "NewCondVar"
@fa "متغیر شرط جدید"
pub func NewCondVar(): CondVar: ret CondVar { handle = cond_new() } end
@en "WaitCond"
@fa "انتظار شرط"
pub func WaitCond(cv: CondVar, m: Mutex): cond_wait(cv.handle, m.handle) end
@en "WaitCondTimeout"
@fa "انتظار شرط با مهلت"
pub func WaitCondTimeout(cv: CondVar, m: Mutex, ms: i64): bool:
ret cond_timedwait(cv.handle, m.handle, ms)
end
@en "NowMs"
@fa "اکنون میلی ثانیه"
pub func NowMs(): i64: ret now_ms_os() end
@en "Signal"
@fa "اعلام"
pub func Signal(cv: CondVar): cond_signal(cv.handle) end
@en "Broadcast"
@fa "اعلام سراسری"
pub func Broadcast(cv: CondVar): cond_broadcast(cv.handle) end
@en "DestroyCondVar"
@fa "نابودسازی متغیر شرط"
pub func DestroyCondVar(cv: CondVar): cond_free(cv.handle) end
@en "NewWaitGroup"
@fa "گروه انتظار جدید"
pub func NewWaitGroup(): WaitGroup:
c := mem.Allocate(8 as u64) as i64*
c[0] = 0
ret WaitGroup { counter = c, mu = mutex_new(), cv = cond_new() }
end
@en "Add"
@fa "افزودن"
pub func Add(wg: WaitGroup, delta: i64):
c := wg.counter
mutex_lock(wg.mu)
c[0] = c[0] + delta
if c[0] <= 0: cond_broadcast(wg.cv) end
mutex_unlock(wg.mu)
end
@en "Done"
@fa "اتمام"
pub func Done(wg: WaitGroup):
c := wg.counter
mutex_lock(wg.mu)
c[0] = c[0] - 1
if c[0] <= 0: cond_broadcast(wg.cv) end
mutex_unlock(wg.mu)
end
@en "Wait"
@fa "انتظار"
pub func Wait(wg: WaitGroup):
c := wg.counter
mutex_lock(wg.mu)
until c[0] > 0:
cond_wait(wg.cv, wg.mu)
end
mutex_unlock(wg.mu)
end
@en "DestroyWaitGroup"
@fa "نابودسازی گروه انتظار"
pub func DestroyWaitGroup(wg: WaitGroup):
mem.Free(wg.counter as void*)
cond_free(wg.cv)
mutex_free(wg.mu)
end
@en "NewRWMutex"
@fa "قفل خواندن نوشتن جدید"
pub func NewRWMutex(): RWMutex:
s := mem.Allocate(24 as u64) as i64*
s[0] = 0
s[1] = 0
s[2] = 0
ret RWMutex { state = s, mu = mutex_new(), cv = cond_new() }
end
@en "RLock"
@fa "قفل خواندن"
pub func RLock(rw: RWMutex):
s := rw.state
mutex_lock(rw.mu)
until s[1] != 0 or s[2] > 0:
cond_wait(rw.cv, rw.mu)
end
s[0] = s[0] + 1
mutex_unlock(rw.mu)
end
@en "RUnlock"
@fa "باز کردن قفل خواندن"
pub func RUnlock(rw: RWMutex):
s := rw.state
mutex_lock(rw.mu)
s[0] = s[0] - 1
if s[0] <= 0: cond_broadcast(rw.cv) end
mutex_unlock(rw.mu)
end
@en "WLock"
@fa "قفل نوشتن"
pub func WLock(rw: RWMutex):
s := rw.state
mutex_lock(rw.mu)
s[2] = s[2] + 1
until s[1] != 0 or s[0] > 0:
cond_wait(rw.cv, rw.mu)
end
s[2] = s[2] - 1
s[1] = 1
mutex_unlock(rw.mu)
end
@en "WUnlock"
@fa "باز کردن قفل نوشتن"
pub func WUnlock(rw: RWMutex):
s := rw.state
mutex_lock(rw.mu)
s[1] = 0
cond_broadcast(rw.cv)
mutex_unlock(rw.mu)
end
@en "DestroyRWMutex"
@fa "نابودسازی قفل خواندن نوشتن"
pub func DestroyRWMutex(rw: RWMutex):
mem.Free(rw.state as void*)
cond_free(rw.cv)
mutex_free(rw.mu)
end
@en "NewSemaphore"
@fa "نشانگر جدید"
pub func NewSemaphore(permits: i64): Semaphore:
p := mem.Allocate(8 as u64) as i64*
p[0] = permits
ret Semaphore { permits = p, mu = mutex_new(), cv = cond_new() }
end
@en "Acquire"
@fa "گرفتن"
pub func Acquire(sem: Semaphore):
p := sem.permits
mutex_lock(sem.mu)
until p[0] <= 0:
cond_wait(sem.cv, sem.mu)
end
p[0] = p[0] - 1
mutex_unlock(sem.mu)
end
@en "TryAcquire"
@fa "تلاش برای گرفتن"
pub func TryAcquire(sem: Semaphore): bool:
p := sem.permits
mutex_lock(sem.mu)
mut got := false
if p[0] > 0:
p[0] = p[0] - 1
got = true
end
mutex_unlock(sem.mu)
ret got
end
@en "Release"
@fa "رها کردن"
pub func Release(sem: Semaphore):
p := sem.permits
mutex_lock(sem.mu)
p[0] = p[0] + 1
cond_signal(sem.cv)
mutex_unlock(sem.mu)
end
@en "DestroySemaphore"
@fa "نابودسازی نشانگر"
pub func DestroySemaphore(sem: Semaphore):
mem.Free(sem.permits as void*)
cond_free(sem.cv)
mutex_free(sem.mu)
end
@en "NewOnce"
@fa "یک بار جدید"
pub func NewOnce(): Once:
d := mem.Allocate(8 as u64) as i64*
d[0] = 0
ret Once { done = d, mu = mutex_new() }
end
@en "Do"
@fa "انجام"
pub func Do(o: Once, f: func ()):
d := o.done
mutex_lock(o.mu)
if d[0] == 0:
f()
d[0] = 1
end
mutex_unlock(o.mu)
end
@en "DestroyOnce"
@fa "نابودسازی یک بار"
pub func DestroyOnce(o: Once):
mem.Free(o.done as void*)
mutex_free(o.mu)
end
@en "telegram.bot"
@fa "بات"
package bot
import net.http
import encoding.json
import str
import conv
import time
@en "User"
@fa "کاربر"
pub struct User:
pub id: i64 = 0
pub is_bot: bool = false
pub first_name: str = ""
pub last_name: str = ""
pub username: str = ""
pub language_code: str = ""
end
@en "Chat"
@fa "گفتگو"
pub struct Chat:
pub id: i64 = 0
pub chat_type: str = ""
pub title: str = ""
pub username: str = ""
pub first_name: str = ""
pub last_name: str = ""
end
@en "ReplyTo"
@fa "پاسخ به"
pub struct ReplyTo:
pub message_id: i64 = 0
pub user_id: i64 = 0
pub user_name: str = ""
end
@en "Message"
@fa "پیام"
pub struct Message:
pub message_id: i64 = 0
pub date: i64 = 0
pub chat: Chat = Chat {}
pub from_user: User = User {}
pub text: str = ""
pub caption: str = ""
pub reply_to: ReplyTo = ReplyTo {}
end
@en "CallbackQuery"
@fa "پرسمان بازخوان"
pub struct CallbackQuery:
pub id: str = ""
pub from_user: User = User {}
pub message: Message = Message {}
pub has_message: bool = false
pub data: str = ""
end
@en "InlineQuery"
@fa "پرسمان درون خطی"
pub struct InlineQuery:
pub id: str = ""
pub from_user: User = User {}
pub query: str = ""
pub offset: str = ""
end
@en "Update"
@fa "بروزرسانی"
pub struct Update:
pub update_id: i64 = 0
pub message: Message = Message {}
pub has_message: bool = false
pub channel_post: Message = Message {}
pub has_channel_post: bool = false
pub callback_query: CallbackQuery = CallbackQuery {}
pub has_callback_query: bool = false
pub inline_query: InlineQuery = InlineQuery {}
pub has_inline_query: bool = false
end
@en "ApiResponse"
@fa "پاسخ ای پی آی"
pub struct ApiResponse:
pub ok: bool = false
pub result: str = ""
pub description: str = ""
pub error_code: i64 = 0
pub http_status: int = 0
pub http_err: str = ""
end
@en "SendOptions"
@fa "گزینه های ارسال"
pub struct SendOptions:
pub parse_mode: str = ""
pub disable_notification: bool = false
pub reply_to_message_id: i64 = 0
pub reply_markup: str = ""
end
@en "Bot"
@fa "بات"
pub struct Bot:
pub token: str = ""
end
func _new_params(): HashMap<str, str>:
ret HashMap {}
end
func _put_chat_id(params: HashMap<str, str>, chat_id: i64):
params.put("chat_id", str.FromInt(chat_id))
end
func _put_chat_id(params: HashMap<str, str>, chat_id: str):
params.put("chat_id", chat_id)
end
func _msg_params(chat_id: i64, message_id: i64): HashMap<str, str>:
mut params := _new_params()
_put_chat_id(params, chat_id)
params.put("message_id", str.FromInt(message_id))
ret params
end
func _user_params(chat_id: i64, user_id: i64): HashMap<str, str>:
mut params := _new_params()
_put_chat_id(params, chat_id)
params.put("user_id", str.FromInt(user_id))
ret params
end
func _api_url(bot: Bot, method: str): str:
ret "https://api.telegram.org/bot".concat(bot.token).concat("/").concat(method)
end
func _call(bot: Bot, method: str, params: HashMap<str, str>): ApiResponse:
url := http.WithQuery(_api_url(bot, method), params)
defer params.free()
r := http.Get(url)
mut resp := ApiResponse {}
resp.http_status = r.status
resp.http_err = r.err
if r.err.len() > 0:
resp.description = r.err
ret resp
end
resp.ok = json.Get(r.body, "ok") == "true"
resp.result = json.Get(r.body, "result")
resp.description = json.Get(r.body, "description")
resp.error_code = conv.ParseInt(json.Get(r.body, "error_code"))
if not resp.ok and resp.description.len() == 0:
resp.description = "no 'description' field in response (HTTP " + str.FromInt(r.status) + "): " + r.body
end
ret resp
end
func _send_media(bot: Bot, chat_id: i64, method: str, field: str, media: str, caption: str): ApiResponse:
mut params := _new_params()
_put_chat_id(params, chat_id)
params.put(field, media)
if caption.len() > 0: params.put("caption", caption) end
ret _call(bot, method, params)
end
func _bp(s: str): i8*: ret (s as void*) as i8* end
func _ub(bp: i8*, i: int): int:
mut v := bp[i] as int
if v < 0: v = v + 256 end
ret v
end
func _split_json_array(raw: str): Vector<str>:
mut out := Vector {} as Vector<str>
l := raw.len()
if l < 2: ret out end
bp := _bp(raw)
mut i := 0
until i < l:
if _ub(bp, i) == 91: break end
i += 1
end
if i >= l: ret out end
i += 1
mut depth := 0
mut in_str := false
mut start := i
until i < l:
code := _ub(bp, i)
if in_str:
if code == 92:
i += 1
else code == 34:
in_str = false
end
else code == 34:
in_str = true
else code == 123 or code == 91:
depth += 1
else code == 125 or code == 93:
if depth == 0:
if i > start:
item := raw.substr(start, i - start).trim()
if item.len() > 0: out.push(item) end
end
ret out
end
depth -= 1
else code == 44 and depth == 0:
item := raw.substr(start, i - start).trim()
if item.len() > 0: out.push(item) end
start = i + 1
end
i += 1
end
ret out
end
@en "ParseUser"
@fa "تجزیه کاربر"
pub func ParseUser(raw: str): User:
mut u := User {}
if raw.len() == 0: ret u end
u.id = conv.ParseInt(json.Get(raw, "id"))
u.is_bot = json.Get(raw, "is_bot") == "true"
u.first_name = json.Get(raw, "first_name")
u.last_name = json.Get(raw, "last_name")
u.username = json.Get(raw, "username")
u.language_code = json.Get(raw, "language_code")
ret u
end
@en "ParseChat"
@fa "تجزیه گفتگو"
pub func ParseChat(raw: str): Chat:
mut c := Chat {}
if raw.len() == 0: ret c end
c.id = conv.ParseInt(json.Get(raw, "id"))
c.chat_type = json.Get(raw, "type")
c.title = json.Get(raw, "title")
c.username = json.Get(raw, "username")
c.first_name = json.Get(raw, "first_name")
c.last_name = json.Get(raw, "last_name")
ret c
end
@en "ParseMessage"
@fa "تجزیه پیام"
pub func ParseMessage(raw: str): Message:
mut m := Message {}
if raw.len() == 0: ret m end
m.message_id = conv.ParseInt(json.Get(raw, "message_id"))
m.date = conv.ParseInt(json.Get(raw, "date"))
m.chat = ParseChat(json.Get(raw, "chat"))
m.from_user = ParseUser(json.Get(raw, "from"))
m.text = json.Get(raw, "text")
m.caption = json.Get(raw, "caption")
reply_raw := json.Get(raw, "reply_to_message")
if reply_raw.len() > 0:
reply_user := ParseUser(json.Get(reply_raw, "from"))
m.reply_to.message_id = conv.ParseInt(json.Get(reply_raw, "message_id"))
m.reply_to.user_id = reply_user.id
m.reply_to.user_name = reply_user.first_name
end
ret m
end
@en "ParseCallbackQuery"
@fa "تجزیه پرسمان بازخوان"
pub func ParseCallbackQuery(raw: str): CallbackQuery:
mut q := CallbackQuery {}
if raw.len() == 0: ret q end
q.id = json.Get(raw, "id")
q.from_user = ParseUser(json.Get(raw, "from"))
msg_raw := json.Get(raw, "message")
if msg_raw.len() > 0:
q.message = ParseMessage(msg_raw)
q.has_message = true
end
q.data = json.Get(raw, "data")
ret q
end
@en "ParseInlineQuery"
@fa "تجزیه پرسمان درون خطی"
pub func ParseInlineQuery(raw: str): InlineQuery:
mut q := InlineQuery {}
if raw.len() == 0: ret q end
q.id = json.Get(raw, "id")
q.from_user = ParseUser(json.Get(raw, "from"))
q.query = json.Get(raw, "query")
q.offset = json.Get(raw, "offset")
ret q
end
@en "ParseUpdate"
@fa "تجزیه بروزرسانی"
pub func ParseUpdate(raw: str): Update:
mut u := Update {}
if raw.len() == 0: ret u end
u.update_id = conv.ParseInt(json.Get(raw, "update_id"))
msg_raw := json.Get(raw, "message")
if msg_raw.len() > 0:
u.message = ParseMessage(msg_raw)
u.has_message = true
end
post_raw := json.Get(raw, "channel_post")
if post_raw.len() > 0:
u.channel_post = ParseMessage(post_raw)
u.has_channel_post = true
end
cq_raw := json.Get(raw, "callback_query")
if cq_raw.len() > 0:
u.callback_query = ParseCallbackQuery(cq_raw)
u.has_callback_query = true
end
iq_raw := json.Get(raw, "inline_query")
if iq_raw.len() > 0:
u.inline_query = ParseInlineQuery(iq_raw)
u.has_inline_query = true
end
ret u
end
@en "ParseUpdates"
@fa "تجزیه بروزرسانی ها"
pub func ParseUpdates(raw: str): Vector<Update>:
mut out := Vector {} as Vector<Update>
items := _split_json_array(raw)
repeat items.len() in i:
out.push(ParseUpdate(items.get(i)))
end
defer items.free()
ret out
end
@en "NewBot"
@fa "بات جدید"
pub func NewBot(token: str): Bot:
ret Bot { token = token }
end
@en "Ok"
@fa "موفق"
pub func Ok(resp: ApiResponse): bool:
ret resp.ok
end
@en "Call"
@fa "فراخوان"
pub func Call(bot: Bot, method: str, params: HashMap<str, str>): ApiResponse:
ret _call(bot, method, params)
end
@en "GetMe"
@fa "دریافت من"
pub func GetMe(bot: Bot): ApiResponse:
ret _call(bot, "getMe", _new_params())
end
@en "GetUpdates"
@fa "دریافت بروزرسانی ها"
pub func GetUpdates(bot: Bot, offset: i64, limit: i64, timeout: i64): ApiResponse:
mut params := _new_params()
if offset != 0: params.put("offset", str.FromInt(offset)) end
if limit > 0: params.put("limit", str.FromInt(limit)) end
if timeout > 0: params.put("timeout", str.FromInt(timeout)) end
ret _call(bot, "getUpdates", params)
end
@en "SendMessage"
@fa "ارسال پیام"
pub func SendMessage(bot: Bot, chat_id: i64, text: str): ApiResponse:
mut params := _new_params()
_put_chat_id(params, chat_id)
params.put("text", text)
ret _call(bot, "sendMessage", params)
end
@en "SendMessage"
@fa "ارسال پیام"
pub func SendMessage(bot: Bot, chat_id: str, text: str): ApiResponse:
mut params := _new_params()
_put_chat_id(params, chat_id)
params.put("text", text)
ret _call(bot, "sendMessage", params)
end
@en "SendMessageOptions"
@fa "ارسال پیام با گزینه ها"
pub func SendMessageOptions(bot: Bot, chat_id: i64, text: str, opts: SendOptions): ApiResponse:
mut params := _new_params()
_put_chat_id(params, chat_id)
params.put("text", text)
if opts.parse_mode.len() > 0: params.put("parse_mode", opts.parse_mode) end
if opts.disable_notification: params.put("disable_notification", "true") end
if opts.reply_to_message_id > 0: params.put("reply_to_message_id", str.FromInt(opts.reply_to_message_id)) end
if opts.reply_markup.len() > 0: params.put("reply_markup", opts.reply_markup) end
ret _call(bot, "sendMessage", params)
end
