mut _targets_inited := false
@en "TargetMachine"
@fa "ماشین هدف"
pub struct TargetMachine:
pub handle: void* = null
end
@en "TargetData"
@fa "داده هدف"
pub struct TargetData:
pub handle: void* = null
end
@en "TargetMachineResult"
@fa "نتیجه ماشین هدف"
pub struct TargetMachineResult:
pub tm: TargetMachine = TargetMachine {}
pub ok: bool = false
pub err: str = ""
end
func default_target_cpu(triple: str): str:
if str.StartsWith(triple, "x86_64") or str.StartsWith(triple, "amd64"):
ret "x86-64"
end
if str.StartsWith(triple, "i386") or str.StartsWith(triple, "i486"):
ret "pentium4"
end
if str.StartsWith(triple, "i586") or str.StartsWith(triple, "i686"):
ret "pentium4"
end
if str.StartsWith(triple, "aarch64") or str.StartsWith(triple, "arm64"):
ret "generic"
end
ret ""
end
@en "InitTargets"
@fa "مقداردهی اهداف"
pub func InitTargets():
if _targets_inited:
ret
end
_targets_inited = true
salam_llvm_init_all_target_infos()
salam_llvm_init_all_targets()
salam_llvm_init_all_target_mcs()
salam_llvm_init_all_asm_printers()
salam_llvm_init_all_asm_parsers()
end
@en "CodeGenLevelOf"
@fa "سطح تولید کد"
pub func CodeGenLevelOf(opt_level: int): int:
if opt_level == OPT_O0: ret CODEGEN_LEVEL_NONE end
if opt_level == OPT_O1: ret CODEGEN_LEVEL_LESS end
if opt_level == OPT_O3: ret CODEGEN_LEVEL_AGGRESSIVE end
ret CODEGEN_LEVEL_DEFAULT
end
@en "PassPipelineOf"
@fa "خط لوله پاس"
pub func PassPipelineOf(opt_level: int): str:
if opt_level == OPT_O1: ret "default<O1>" end
if opt_level == OPT_O2: ret "default<O2>" end
if opt_level == OPT_O3: ret "default<O3>" end
if opt_level == OPT_OS: ret "default<Os>" end
if opt_level == OPT_OZ: ret "default<Oz>" end
ret ""
end
@en "DefaultTriple"
@fa "سه‌تایی پیش‌فرض"
pub func DefaultTriple(): str:
raw := LLVMGetDefaultTargetTriple()
if str.Len(raw) == 0:
ret ""
end
ret LLVMNormalizeTargetTriple(raw)
end
@en "NewTargetMachine"
@fa "ماشین هدف جدید"
pub func NewTargetMachine(triple: str, opt_level: int, native_cpu: bool): TargetMachineResult:
InitTargets()
mut t := triple
if str.Len(t) == 0:
t = DefaultTriple()
end
if str.Len(t) == 0:
ret TargetMachineResult { ok = false, err = "no default target triple available" }
end
mut target := null as void*
mut terr := null as void*
if LLVMGetTargetFromTriple(t, target, terr) != 0:
msg := terr != null ? str.Clone(terr as str) : "(unavailable)"
ret TargetMachineResult { ok = false, err = "LLVM target '" + t + "': " + msg }
end
mut cpu := default_target_cpu(t)
mut features := ""
host := DefaultTriple()
is_host_target := str.Len(host) > 0 and str.EqualFold(host, t)
if native_cpu and is_host_target:
hc := LLVMGetHostCPUName()
hf := LLVMGetHostCPUFeatures()
cpu = str.Len(hc) > 0 ? hc : cpu
features = str.Len(hf) > 0 ? hf : ""
end
tm := LLVMCreateTargetMachine(
target, t, cpu, features, CodeGenLevelOf(opt_level), RELOC_PIC, CODE_MODEL_DEFAULT
)
if tm == null:
ret TargetMachineResult { ok = false, err = "LLVMCreateTargetMachine failed for '" + t + "'" }
end
ret TargetMachineResult { tm = TargetMachine { handle = tm }, ok = true }
end
@en "FreeTargetMachine"
@fa "آزادسازی ماشین هدف"
pub func FreeTargetMachine(tm: TargetMachine):
if tm.handle != null:
LLVMDisposeTargetMachine(tm.handle)
end
end
@en "ApplyDataLayout"
@fa "اعمال آرایش داده"
pub func ApplyDataLayout(mod: Module, tm: TargetMachine):
td := LLVMCreateTargetDataLayout(tm.handle)
LLVMSetModuleDataLayout(mod.handle, td)
LLVMDisposeTargetData(td)
end
@en "llvm/triple"
@fa "سه‌گانه هدف"
package triple
import str
const k_w64 := [
"x86_64", "amd64", "aarch64", "arm64", "riscv64", "wasm64", "powerpc64", "ppc64", "mips64",
"sparc64", "s390x", "loongarch64"
]
const k_w16 := ["msp430", "avr"]
const k_w32 := [
"i386", "i486", "i586", "i686", "wasm32", "armv6", "armv7", "armv5", "thumb", "mipsel", "mips",
"riscv32", "powerpc", "ppc", "arm"
]
func host_bits(): int:
if SALAM_ARCH_X64 or SALAM_ARCH_ARM64:
ret 64
else:
ret 32
end
end
@en "HostDatalayout"
@fa "آرایش داده میزبان"
pub func HostDatalayout(): str:
if SALAM_ARCH_X64 and SALAM_OS_WINDOWS:
ret "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
else SALAM_ARCH_X64 and SALAM_OS_MAC:
ret "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
else SALAM_ARCH_X64:
ret "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
else SALAM_ARCH_ARM64 and SALAM_OS_MAC:
ret "e-m:o-i64:64-i128:128-n32:64-S128"
else SALAM_ARCH_ARM64:
ret "e-m:e-i8:8:32-i16:16:32-i64:64-i128:128-n32:64-S128"
else SALAM_ARCH_X86:
ret "e-m:e-p:32:32-p270:32:32-p271:32:32-p272:64:64-i128:128-f64:32:64-f80:32-n8:16:32-S128"
else:
ret ""
end
end
@en "Datalayout"
@fa "آرایش داده"
pub func Datalayout(t: str): str:
dl_x64_elf := "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
dl_x64_win := "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
dl_x64_mac := "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
dl_x86_elf := "e-m:e-p:32:32-p270:32:32-p271:32:32-p272:64:64-i128:128-f64:32:64-f80:32-n8:16:32-S128"
dl_a64_elf := "e-m:e-i8:8:32-i16:16:32-i64:64-i128:128-n32:64-S128"
dl_a64_mac := "e-m:o-i64:64-i128:128-n32:64-S128"
dl_rv64 := "e-m:e-p:64:64-i64:64-i128:128-n32:64-S128"
dl_arm_le := "e-m:e-p:32:32-Fi8-i64:64-v128:64:128-a:0:32-n32-S64"
dl_arm_be := "E-m:e-p:32:32-Fi8-i64:64-v128:64:128-a:0:32-n32-S64"
if str.Len(t) == 0:
ret HostDatalayout()
end
win := str.Contains(t, "windows")
mac := str.Contains(t, "apple") or str.Contains(t, "darwin") or str.Contains(t, "macos")
if str.Contains(t, "x86_64") or str.Contains(t, "amd64"):
ret win ? dl_x64_win : (mac ? dl_x64_mac : dl_x64_elf)
end
if str.Contains(t, "aarch64") or str.Contains(t, "arm64"):
ret mac ? dl_a64_mac : dl_a64_elf
end
if not win and not mac and (
str.Contains(t, "i686") or str.Contains(t, "i586") or str.Contains(t, "i486") or str.Contains(t, "i386")
):
ret dl_x86_elf
end
if str.Contains(t, "riscv64"):
ret dl_rv64
end
if str.Contains(t, "thumb") or str.Contains(t, "arm"):
ret (str.Contains(t, "thumbeb") or str.Contains(t, "armeb")) ? dl_arm_be : dl_arm_le
end
ret ""
end
@en "PointerBits"
@fa "بیت‌های اشاره‌گر"
pub func PointerBits(t: str): int:
if str.Len(t) == 0:
ret host_bits()
end
repeat 12 in i:
if str.Contains(t, k_w64[i]):
ret 64
end
end
repeat 2 in k:
if str.Contains(t, k_w16[k]):
ret 16
end
end
repeat 15 in j:
if str.Contains(t, k_w32[j]):
ret 32
end
end
ret host_bits()
end
@en "IsWindows"
@fa "ویندوز است"
pub func IsWindows(t: str): bool:
if str.Len(t) > 0:
ret str.Contains(t, "windows") or str.Contains(t, "mingw") or str.Contains(t, "win32")
end
if SALAM_OS_WINDOWS:
ret true
else:
ret false
end
end
@en "IsGlibc"
@fa "گلیبسی است"
pub func IsGlibc(t: str): bool:
if str.Len(t) == 0: ret false end
if str.Contains(t, "musl"): ret false end
if str.Contains(t, "darwin") or str.Contains(t, "apple"): ret false end
if str.Contains(t, "windows") or str.Contains(t, "wasm"): ret false end
ret str.Contains(t, "linux")
end
@en "log"
@fa "گزارش"
package log
import str
import time
import fmt
import io
import os
import conv
import encoding.json
extern:
noret func exit(code: int)
func salam_open(path: str, mode: str): File*
end
@en "LevelDebug"
@fa "سطح اشکال زدایی"
pub const LevelDebug := 0
@en "LevelInfo"
@fa "سطح اطلاعات"
pub const LevelInfo := 1
@en "LevelWarn"
@fa "سطح هشدار"
pub const LevelWarn := 2
@en "LevelError"
@fa "سطح خطا"
pub const LevelError := 3
@en "FormatText"
@fa "قالب متن"
pub const FormatText := 0
@en "FormatJSON"
@fa "قالب جیسون"
pub const FormatJSON := 1
mut _level := 1
mut _prefix := ""
mut _show_time := true
mut _sink := 0
mut _file := null as File*
mut _format := 0
mut _file_path := ""
mut _rotate_max_bytes := 0 as i64
mut _rotate_max_backups := 5
mut _bytes_since_rotate := 0 as i64
func _level_name(l: int): str:
if l <= 0: ret "DEBUG"
else l == 1: ret "INFO"
else l == 2: ret "WARN"
else:
ret "ERROR"
end
end
func _rotate_if_needed():
if _rotate_max_bytes <= (0 as i64) or _sink != 2 or _file_path == "": ret end
if _bytes_since_rotate < _rotate_max_bytes: ret end
if _file != null: _file.close() end
mut i := _rotate_max_backups
until i >= 2:
src := _file_path.concat(".").concat(conv.FormatInt(i - 1 as i64))
dst := _file_path.concat(".").concat(conv.FormatInt(i as i64))
if os.Exists(src):
os.Remove(dst)
os.Move(src, dst)
end
i -= 1
end
if os.Exists(_file_path):
bak1 := _file_path.concat(".1")
os.Remove(bak1)
os.Move(_file_path, bak1)
end
_file = salam_open(_file_path, "ab")
_bytes_since_rotate = 0 as i64
end
func _text_line(l: int, msg: str, keys: Vector<str>, vals: Vector<str>): str:
mut line := ""
if _show_time:
line = line.concat(time.Format(time.Now())).concat(" ")
end
line = line.concat("[").concat(_level_name(l)).concat("]")
if _prefix.len() > 0:
line = line.concat(" ").concat(_prefix)
end
line = line.concat(" ").concat(msg)
repeat keys.len() in i:
line = line.concat(" ").concat(Field(keys.get(i), vals.get(i)))
end
ret line
end
func _json_line(l: int, msg: str, keys: Vector<str>, vals: Vector<str>): str:
mut b := str.NewBuilder()
defer str.BufFree(b)
str.BufAppend(b, "{")
mut first := true
if _show_time:
str.BufAppend(b, json.Member("time", time.FormatISO(time.Now())))
first = false
end
if first == false: str.BufAppend(b, ", ") end
str.BufAppend(b, json.Member("level", _level_name(l)))
if _prefix.len() > 0:
str.BufAppend(b, ", ")
str.BufAppend(b, json.Member("prefix", _prefix))
end
str.BufAppend(b, ", ")
str.BufAppend(b, json.Member("msg", msg))
repeat keys.len() in i:
str.BufAppend(b, ", ")
str.BufAppend(b, json.Member(keys.get(i), vals.get(i)))
end
str.BufAppend(b, "}")
ret str.BufStr(b)
end
func _emit_kv(l: int, msg: str, keys: Vector<str>, vals: Vector<str>):
if l < _level: ret end
mut line := ""
if _format == 1:
line = _json_line(l, msg, keys, vals)
else:
line = _text_line(l, msg, keys, vals)
end
if _sink == 2 and _file != null:
_rotate_if_needed()
_file.write(line.concat("\n"))
_bytes_since_rotate += (line.len() as i64) + (1 as i64)
else:
if _sink == 1:
println line
else:
io.EPrintln(line)
end
end
end
func _emit(l: int, msg: str):
empty := Vector {} as Vector<str>
_emit_kv(l, msg, empty, empty)
end
@en "LevelName"
@fa "نام سطح"
pub func LevelName(l: int): str: ret _level_name(l) end
@en "ParseLevel"
@fa "تجزیه سطح"
pub func ParseLevel(s: str): int:
u := str.Upper(str.Trim(s))
if u == "DEBUG": ret 0
else u == "INFO": ret 1
else u == "WARN": ret 2
else u == "WARNING": ret 2
else u == "ERROR": ret 3
else:
ret 1
end
end
@en "SetLevel"
@fa "تنظیم سطح"
pub func SetLevel(l: int): _level = l end
@en "GetLevel"
@fa "دریافت سطح"
pub func GetLevel(): int: ret _level end
@en "SetPrefix"
@fa "تنظیم پیشوند"
pub func SetPrefix(p: str): _prefix = p end
@en "ShowTime"
@fa "نمایش زمان"
pub func ShowTime(b: bool): _show_time = b end
@en "SetFormat"
@fa "تنظیم قالب"
pub func SetFormat(f: int): _format = f end
@en "GetFormat"
@fa "دریافت قالب"
pub func GetFormat(): int: ret _format end
@en "SetRotation"
@fa "تنظیم چرخش"
pub func SetRotation(max_bytes: i64, max_backups: int):
_rotate_max_bytes = max_bytes
_rotate_max_backups = max_backups
end
@en "ToStderr"
@fa "به خطای استاندارد"
pub func ToStderr():
_sink = 0
end
@en "ToStdout"
@fa "به خروجی استاندارد"
pub func ToStdout():
_sink = 1
end
@en "ToFile"
@fa "به پرونده"
pub func ToFile(path: str): int:
f := salam_open(path, "ab")
if f == null: ret 0 - 1 end
if _sink == 2 and _file != null: _file.close() end
_file = f
_file_path = path
_sink = 2
existing := os.FileSize(path)
if existing > (0 as i64):
_bytes_since_rotate = existing
else:
_bytes_since_rotate = 0 as i64
end
ret 0
end
@en "CloseFile"
@fa "بستن پرونده"
pub func CloseFile():
if _sink == 2 and _file != null: _file.close() end
_file = null
_sink = 0
end
@en "Log"
@fa "ثبت"
pub func Log(l: int, msg: str): _emit(l, msg) end
@en "Debug"
@fa "اشکال زدایی"
pub func Debug(msg: str): _emit(0, msg) end
@en "Info"
@fa "اطلاعات"
pub func Info(msg: str): _emit(1, msg) end
@en "Warn"
@fa "هشدار"
pub func Warn(msg: str): _emit(2, msg) end
@en "Error"
@fa "خطا"
pub func Error(msg: str): _emit(3, msg) end
@en "Debugf"
@fa "اشکال زدایی قالبی"
pub func Debugf(tmpl: str, args: Vector<str>): _emit(0, fmt.Sprintf(tmpl, args)) end
@en "Infof"
@fa "اطلاعات قالبی"
pub func Infof(tmpl: str, args: Vector<str>): _emit(1, fmt.Sprintf(tmpl, args)) end
@en "Warnf"
@fa "هشدار قالبی"
pub func Warnf(tmpl: str, args: Vector<str>): _emit(2, fmt.Sprintf(tmpl, args)) end
@en "Errorf"
@fa "خطا قالبی"
pub func Errorf(tmpl: str, args: Vector<str>): _emit(3, fmt.Sprintf(tmpl, args)) end
@en "Fatal"
@fa "مهلک"
pub noret func Fatal(msg: str):
_emit(3, msg)
if _sink == 2 and _file != null: _file.close() end
exit(1)
end
@en "Field"
@fa "فیلد"
pub func Field(key: str, val: str): str:
if str.Contains(val, " ") or str.Contains(val, `"`):
ret key.concat(`="`).concat(str.Replace(val, `"`, `\"`)).concat(`"`)
end
ret key.concat("=").concat(val)
end
@en "FieldInt"
@fa "فیلد عدد"
pub func FieldInt(key: str, val: i64): str:
ret key.concat("=").concat(str.FromInt(val))
end
@en "FieldBool"
@fa "فیلد منطقی"
pub func FieldBool(key: str, val: bool): str:
if val: ret key.concat("=true") end
ret key.concat("=false")
end
@en "KV"
@fa "کلید مقدار"
pub func KV(msg: str, fields: Vector<str>): str:
mut out := msg
repeat fields.len() in i:
out = out.concat(" ").concat(fields.get(i))
end
ret out
end
@en "DebugKV"
@fa "اشکال زدایی با فیلد"
pub func DebugKV(msg: str, keys: Vector<str>, vals: Vector<str>): _emit_kv(0, msg, keys, vals) end
@en "InfoKV"
@fa "اطلاعات با فیلد"
pub func InfoKV(msg: str, keys: Vector<str>, vals: Vector<str>): _emit_kv(1, msg, keys, vals) end
@en "WarnKV"
@fa "هشدار با فیلد"
pub func WarnKV(msg: str, keys: Vector<str>, vals: Vector<str>): _emit_kv(2, msg, keys, vals) end
@en "ErrorKV"
@fa "خطا با فیلد"
pub func ErrorKV(msg: str, keys: Vector<str>, vals: Vector<str>): _emit_kv(3, msg, keys, vals) end
@en "map"
@fa "نگاشت"
package map
import mem
func _ptrstr(p: i64): str:
v := p as void*
ret v as str
end
func _m_keykind(m: void*): int:
p := m as int*
ret p[0]
end
func _m_cap(m: void*): i64:
p := m as i64*
ret p[1]
end
func _m_count(m: void*): i64:
p := m as i64*
ret p[2]
end
func _m_state(m: void*): int*:
p := m as i64*
sp := p[3] as void*
ret sp as int*
end
func _m_keys(m: void*): i64*:
p := m as i64*
kp := p[4] as void*
ret kp as i64*
end
func _m_vals(m: void*): i64*:
p := m as i64*
vp := p[5] as void*
ret vp as i64*
end
func _m_set_cap(m: void*, v: i64):
p := m as i64*
p[1] = v
end
func _m_set_count(m: void*, v: i64):
p := m as i64*
p[2] = v
end
func _m_set_state(m: void*, v: void*):
p := m as i64*
p[3] = v as i64
end
func _m_set_keys(m: void*, v: void*):
p := m as i64*
p[4] = v as i64
end
func _m_set_vals(m: void*, v: void*):
p := m as i64*
p[5] = v as i64
end
func _m_hash(m: void*, key: i64): u64:
if _m_keykind(m) == 1:
bp := (key as void*) as i8*
mut h := 5381 as u64
mut j := 0
until bp[j] != 0:
mut c := bp[j] as int
if c < 0: c = c + 256 end
h = h * (33 as u64) + (c as u64)
j += 1
end
ret h
end
ret (key as u64) * (2654435761 as u64)
end
func _m_keq(m: void*, a: i64, b: i64): bool:
if _m_keykind(m) == 1:
ret _ptrstr(a) == _ptrstr(b)
end
ret a == b
end
func _m_find(m: void*, key: i64): i64:
cap := _m_cap(m)
st := _m_state(m)
keys := _m_keys(m)
h := _m_hash(m, key)
mut i := (h % (cap as u64)) as i64
mut free_slot := (0 - 1) as i64
repeat cap:
s := st[i]
if s == 0:
if free_slot != (0 - 1): ret free_slot * 2 end
ret i * 2
else s == 2:
if free_slot == (0 - 1): free_slot = i end
else:
if _m_keq(m, keys[i], key):
ret i * 2 + 1
end
end
i += 1
if i >= cap: i = 0 end
end
ret free_slot * 2
end
func _m_raw_insert(m: void*, key: i64, val: i64):
i := _m_find(m, key) / 2
st := _m_state(m)
keys := _m_keys(m)
vals := _m_vals(m)
st[i] = 1
keys[i] = key
vals[i] = val
_m_set_count(m, _m_count(m) + 1)
end
func _m_grow(m: void*):
oc := _m_cap(m)
ost := _m_state(m)
okeys := _m_keys(m)
ovals := _m_vals(m)
ncap := oc * 2
_m_set_cap(m, ncap)
_m_set_count(m, 0)
_m_set_state(m, mem.AllocateZeroed((ncap * 4) as u64))
_m_set_keys(m, mem.AllocateZeroed((ncap * 8) as u64))
_m_set_vals(m, mem.AllocateZeroed((ncap * 8) as u64))
repeat oc in idx:
if ost[idx] == 1:
_m_raw_insert(m, okeys[idx], ovals[idx])
end
end
mem.Free(ost as void*)
mem.Free(okeys as void*)
mem.Free(ovals as void*)
end
export:
func salam_map_new(key_kind: int, val_size: int): void*:
m := mem.AllocateZeroed(48 as u64)
mi32 := m as int*
mi32[0] = key_kind
mut vs := val_size
if vs <= 0: vs = 1 end
mi32[1] = vs
_m_set_cap(m, 16)
_m_set_count(m, 0)
_m_set_state(m, mem.AllocateZeroed((16 * 4) as u64))
_m_set_keys(m, mem.AllocateZeroed((16 * 8) as u64))
_m_set_vals(m, mem.AllocateZeroed((16 * 8) as u64))
ret m
end
func salam_map_put(m: void*, key: i64, val: i64):
if (_m_count(m) + 1) * 10 >= _m_cap(m) * 7:
_m_grow(m)
end
r := _m_find(m, key)
i := r / 2
st := _m_state(m)
keys := _m_keys(m)
vals := _m_vals(m)
if r % 2 == 0:
st[i] = 1
keys[i] = key
_m_set_count(m, _m_count(m) + 1)
end
vals[i] = val
end
func salam_map_get(m: void*, key: i64): i64:
r := _m_find(m, key)
if r % 2 == 0: ret 0 end
vals := _m_vals(m)
ret vals[r / 2]
end
func salam_map_has(m: void*, key: i64): int:
r := _m_find(m, key)
ret (r % 2) as int
end
func salam_map_remove(m: void*, key: i64): int:
r := _m_find(m, key)
if r % 2 == 0: ret 0 end
st := _m_state(m)
st[r / 2] = 2
_m_set_count(m, _m_count(m) - 1)
ret 1
end
func salam_map_size(m: void*): int:
ret _m_count(m) as int
end
end
func _it_map(it: void*): void*:
p := it as i64*
ret p[0] as void*
end
func _it_i(it: void*): i64:
p := it as i64*
ret p[1]
end
func _it_set_i(it: void*, v: i64):
p := it as i64*
p[1] = v
end
func _it_seek(it: void*):
m := _it_map(it)
cap := _m_cap(m)
st := _m_state(m)
mut i := _it_i(it)
until i < cap:
if st[i] == 1:
_it_set_i(it, i)
ret
end
i += 1
end
_it_set_i(it, cap)
end
export:
func salam_map_iter_new(m: void*): void*:
it := mem.AllocateZeroed(16 as u64)
p := it as i64*
p[0] = m as i64
p[1] = 0
_it_seek(it)
ret it
end
func salam_map_iter_valid(it: void*): int:
m := _it_map(it)
if _it_i(it) < _m_cap(m): ret 1 end
ret 0
end
func salam_map_iter_key(it: void*): i64:
m := _it_map(it)
keys := _m_keys(m)
ret keys[_it_i(it)]
end
func salam_map_iter_value(it: void*): i64:
m := _it_map(it)
vals := _m_vals(m)
ret vals[_it_i(it)]
end
func salam_map_iter_next(it: void*):
_it_set_i(it, _it_i(it) + 1)
_it_seek(it)
end
end
@en "math"
@fa "ریاضی"
package math
extern:
pure func sqrt(x: f64): f64
pure func sin(x: f64): f64
pure func cos(x: f64): f64
pure func tan(x: f64): f64
pure func asin(x: f64): f64
pure func acos(x: f64): f64
pure func atan(x: f64): f64
pure func atan2(y: f64, x: f64): f64
pure func log(x: f64): f64
pure func log10(x: f64): f64
pure func exp(x: f64): f64
pure func floor(x: f64): f64
pure func ceil(x: f64): f64
pure func fabs(x: f64): f64
pure func fmod(x: f64, y: f64): f64
pure func pow(x: f64, y: f64): f64
end
@en "PI"
@fa "پی"
pub const PI := 3.141592653589793
@en "E"
@fa "ای"
pub const E := 2.718281828459045
@en "TAU"
@fa "تاو"
pub const TAU := 6.283185307179586
@en "Sqrt"
@fa "جذر"
pub inline pure func Sqrt(x: f64): f64: ret sqrt(x) end
@en "Sin"
@fa "سینوس"
pub inline pure func Sin(x: f64): f64: ret sin(x) end
@en "Cos"
@fa "کسینوس"
pub inline pure func Cos(x: f64): f64: ret cos(x) end
@en "Tan"
@fa "تانژانت"
pub inline pure func Tan(x: f64): f64: ret tan(x) end
@en "Asin"
@fa "وارون سینوس"
pub inline pure func Asin(x: f64): f64: ret asin(x) end
@en "Acos"
@fa "وارون کسینوس"
pub inline pure func Acos(x: f64): f64: ret acos(x) end
@en "Atan"
@fa "وارون تانژانت"
pub inline pure func Atan(x: f64): f64: ret atan(x) end
@en "Atan2"
@fa "وارون تانژانت دو"
pub inline pure func Atan2(y: f64, x: f64): f64: ret atan2(y, x) end
@en "Log"
@fa "لگاریتم"
pub inline pure func Log(x: f64): f64: ret log(x) end
@en "Log10"
@fa "لگاریتم ده"
pub inline pure func Log10(x: f64): f64: ret log10(x) end
@en "Log2"
@fa "لگاریتم دو"
pub inline pure func Log2(x: f64): f64: ret log(x) / log(2.0) end
@en "Exp"
@fa "نمایی"
pub inline pure func Exp(x: f64): f64: ret exp(x) end
@en "Floor"
@fa "کف"
pub inline pure func Floor(x: f64): f64: ret floor(x) end
@en "Ceil"
@fa "سقف"
pub inline pure func Ceil(x: f64): f64: ret ceil(x) end
@en "Round"
@fa "گردکردن"
pub inline pure func Round(x: f64): f64: ret floor(x + 0.5) end
@en "Abs"
@fa "قدرمطلق"
pub inline pure func Abs(x: f64): f64: ret fabs(x) end
@en "Pow"
@fa "توان"
pub inline pure func Pow(base: f64, power: f64): f64: ret pow(base, power) end
@en "Cbrt"
@fa "ریشه سوم"
pub pure func Cbrt(x: f64): f64:
a := fabs(x)
if a == 0.0 or a != a or a > 1.0e300:
ret x
end
mut y := pow(a, 0.3333333333333333)
y = y - (y * y * y - a) / (3.0 * y * y)
ret x < 0.0 ? 0.0 - y : y
end
@en "Hypot"
@fa "وتر"
pub inline pure func Hypot(x: f64, y: f64): f64: ret sqrt(x * x + y * y) end
@en "Sign"
@fa "علامت"
pub inline pure func Sign(x: f64): f64:
if x > 0.0: ret 1.0 end
if x < 0.0: ret 0.0 - 1.0 end
ret 0.0
end
@en "Min"
@fa "کمینه"
pub inline pure func Min(a: f64, b: f64): f64: if a < b: ret a end ret b end
@en "Max"
@fa "بیشینه"
pub inline pure func Max(a: f64, b: f64): f64: if a > b: ret a end ret b end
@en "ClampF"
@fa "محدودسازی اعشار"
pub inline pure func ClampF(x: f64, lo: f64, hi: f64): f64:
if x < lo: ret lo end
if x > hi: ret hi end
ret x
end
@en "MinI"
@fa "کمینه صحیح"
pub inline pure func MinI(a: int, b: int): int: if a < b: ret a end ret b end
@en "MaxI"
@fa "بیشینه صحیح"
pub inline pure func MaxI(a: int, b: int): int: if a > b: ret a end ret b end
@en "AbsI"
@fa "قدرمطلق صحیح"
pub inline pure func AbsI(x: int): int: if x < 0: ret 0 - x end ret x end
@en "ClampI"
@fa "محدودسازی صحیح"
pub inline pure func ClampI(x: int, lo: int, hi: int): int:
if x < lo: ret lo end
if x > hi: ret hi end
ret x
end
@en "Gcd"
@fa "بزرگترین مقسوم علیه مشترک"
pub pure func Gcd(a: int, b: int): int:
mut x := a
mut y := b
if x < 0: x = 0 - x end
if y < 0: y = 0 - y end
until y != 0:
t := y
y = x % y
x = t
end
ret x
end
@en "Lcm"
@fa "کوچکترین مضرب مشترک"
pub pure func Lcm(a: int, b: int): int:
if a == 0:
ret 0
end
if b == 0:
ret 0
end
g := Gcd(a, b)
p := a / g * b
if p < 0: ret 0 - p end
ret p
end
@en "AbsI64"
@fa "قدرمطلق صحیح۶۴"
pub inline pure func AbsI64(x: i64): i64: if x < 0: ret 0 - x end ret x end
@en "Mod"
@fa "باقیمانده"
pub inline pure func Mod(x: f64, y: f64): f64: ret fmod(x, y) end
@en "Trunc"
@fa "بریدن"
pub inline pure func Trunc(x: f64): f64:
if x < 0.0: ret ceil(x) end
ret floor(x)
end
@en "IsNaN"
@fa "نامعدد است"
pub inline pure func IsNaN(x: f64): bool: ret x != x end
@en "Inf"
@fa "بی نهایت"
pub inline pure func Inf(): f64:
big := 1.0e308
ret big * 10.0
end
@en "NaN"
@fa "نامعدد"
pub inline pure func NaN(): f64:
z := 0.0
ret z / z
end
@en "IsInf"
@fa "بی نهایت است"
pub inline pure func IsInf(x: f64): bool:
mut v := x
if v < 0.0: v = 0.0 - v end
ret v > 0.0 and v / 2.0 == v
end
@en "Sinh"
@fa "سینوس هذلولی"
pub inline pure func Sinh(x: f64): f64: ret (exp(x) - exp(0.0 - x)) / 2.0 end
@en "Cosh"
@fa "کسینوس هذلولی"
pub inline pure func Cosh(x: f64): f64: ret (exp(x) + exp(0.0 - x)) / 2.0 end
@en "Tanh"
@fa "تانژانت هذلولی"
pub inline pure func Tanh(x: f64): f64:
if x > 20.0: ret 1.0 end
if x < 0.0 - 20.0: ret 0.0 - 1.0 end
e2 := exp(2.0 * x)
ret (e2 - 1.0) / (e2 + 1.0)
end
@en "Pow10"
@fa "توان ده"
pub pure func Pow10(n: int): f64:
mut r := 1.0
mut k := n
if k >= 0:
until k > 0:
r *= 10.0
k -= 1
end
else:
until k < 0:
r /= 10.0
k += 1
end
end
ret r
end
@en "Lerp"
@fa "درون یابی خطی"
pub inline pure func Lerp(a: f64, b: f64, t: f64): f64: ret a + (b - a) * t end
@en "Radians"
@fa "رادیان"
pub inline pure func Radians(deg: f64): f64: ret deg * PI / 180.0 end
@en "Degrees"
@fa "درجه"
pub inline pure func Degrees(rad: f64): f64: ret rad * 180.0 / PI end
@en "Factorial"
@fa "فاکتوریل"
pub pure func Factorial(n: int): i64:
mut r := 1 as i64
mut i := 2 as i64
until i <= n as i64:
r *= i
i += 1
end
ret r
end
@en "GcdI64"
@fa "ب م م۶۴"
pub pure func GcdI64(a: i64, b: i64): i64:
mut x := a
mut y := b
if x < 0: x = 0 - x end
if y < 0: y = 0 - y end
until y != 0:
t := y
y = x % y
x = t
end
ret x
end
@en "MinI64"
@fa "کمینه صحیح۶۴"
pub inline pure func MinI64(a: i64, b: i64): i64: if a < b: ret a end ret b end
@en "MaxI64"
@fa "بیشینه صحیح۶۴"
pub inline pure func MaxI64(a: i64, b: i64): i64: if a > b: ret a end ret b end
package matrix
import math
const _OP_ABS := 0
const _OP_SQRT := 1
const _OP_EXP := 2
const _OP_LOG := 3
const _OP_LOG10 := 4
const _OP_LOG2 := 5
const _OP_SIN := 6
const _OP_COS := 7
const _OP_TAN := 8
const _OP_ASIN := 9
const _OP_ACOS := 10
const _OP_ATAN := 11
const _OP_SINH := 12
const _OP_COSH := 13
const _OP_TANH := 14
const _OP_FLOOR := 15
const _OP_CEIL := 16
const _OP_ROUND := 17
const _OP_TRUNC := 18
const _OP_SIGN := 19
const _OP_SQUARE := 20
const _OP_RECIP := 21
const _OP_CBRT := 22
func _scalar_lo(v: f64, op: int): f64:
if op == _OP_ABS: ret math.Abs(v) end
if op == _OP_SQRT: ret math.Sqrt(v) end
if op == _OP_EXP: ret math.Exp(v) end
if op == _OP_LOG: ret math.Log(v) end
if op == _OP_LOG10: ret math.Log10(v) end
if op == _OP_LOG2: ret math.Log2(v) end
if op == _OP_SIN: ret math.Sin(v) end
if op == _OP_COS: ret math.Cos(v) end
if op == _OP_TAN: ret math.Tan(v) end
if op == _OP_ASIN: ret math.Asin(v) end
if op == _OP_ACOS: ret math.Acos(v) end
ret math.Atan(v)
end
func _scalar_hi(v: f64, op: int): f64:
if op == _OP_SINH: ret math.Sinh(v) end
if op == _OP_COSH: ret math.Cosh(v) end
if op == _OP_TANH: ret math.Tanh(v) end
if op == _OP_FLOOR: ret math.Floor(v) end
if op == _OP_CEIL: ret math.Ceil(v) end
if op == _OP_ROUND: ret math.Round(v) end
if op == _OP_TRUNC: ret math.Trunc(v) end
if op == _OP_SIGN: ret math.Sign(v) end
if op == _OP_SQUARE: ret v * v end
if op == _OP_RECIP:
if v == 0.0: ret 0.0 end
ret 1.0 / v
end
ret math.Cbrt(v)
end
func _map(x &: Matrix, op: int): Matrix:
r := _raw(x.rows, x.cols)
n := x.count()
if n <= 0: ret r end
px := x.a.data
pr := r.a.data
if op <= _OP_ATAN:
repeat n in k: pr[k] = _scalar_lo(px[k], op) end
ret r
end
repeat n in k: pr[k] = _scalar_hi(px[k], op) end
ret r
end
func _ipow(v: f64, n: int): f64:
mut acc := 1.0
mut b := v
mut e := n
until e > 0:
if e % 2 == 1: acc = acc * b end
b = b * b
e = e / 2
end
ret acc
end
@en "Abs"
@fa "قدرمطلق"
pub func Abs(x &: Matrix): Matrix: ret _map(x, _OP_ABS) end
@en "Sqrt"
@fa "جذر"
pub func Sqrt(x &: Matrix): Matrix: ret _map(x, _OP_SQRT) end
@en "Exp"
@fa "نمایی"
pub func Exp(x &: Matrix): Matrix: ret _map(x, _OP_EXP) end
@en "Log"
@fa "لگاریتم"
pub func Log(x &: Matrix): Matrix: ret _map(x, _OP_LOG) end
@en "Log10"
@fa "لگاریتم ده"
pub func Log10(x &: Matrix): Matrix: ret _map(x, _OP_LOG10) end
@en "Log2"
@fa "لگاریتم دو"
pub func Log2(x &: Matrix): Matrix: ret _map(x, _OP_LOG2) end
@en "Sin"
@fa "سینوس"
pub func Sin(x &: Matrix): Matrix: ret _map(x, _OP_SIN) end
@en "Cos"
@fa "کسینوس"
pub func Cos(x &: Matrix): Matrix: ret _map(x, _OP_COS) end
@en "Tan"
@fa "تانژانت"
pub func Tan(x &: Matrix): Matrix: ret _map(x, _OP_TAN) end
@en "Asin"
@fa "وارون سینوس"
pub func Asin(x &: Matrix): Matrix: ret _map(x, _OP_ASIN) end
@en "Acos"
@fa "وارون کسینوس"
pub func Acos(x &: Matrix): Matrix: ret _map(x, _OP_ACOS) end
@en "Atan"
@fa "وارون تانژانت"
pub func Atan(x &: Matrix): Matrix: ret _map(x, _OP_ATAN) end
@en "Sinh"
@fa "سینوس هذلولی"
pub func Sinh(x &: Matrix): Matrix: ret _map(x, _OP_SINH) end
@en "Cosh"
@fa "کسینوس هذلولی"
pub func Cosh(x &: Matrix): Matrix: ret _map(x, _OP_COSH) end
@en "Tanh"
@fa "تانژانت هذلولی"
pub func Tanh(x &: Matrix): Matrix: ret _map(x, _OP_TANH) end
@en "Floor"
@fa "کف"
pub func Floor(x &: Matrix): Matrix: ret _map(x, _OP_FLOOR) end
@en "Ceil"
@fa "سقف"
pub func Ceil(x &: Matrix): Matrix: ret _map(x, _OP_CEIL) end
@en "Round"
@fa "گرد"
pub func Round(x &: Matrix): Matrix: ret _map(x, _OP_ROUND) end
@en "Trunc"
@fa "برش"
pub func Trunc(x &: Matrix): Matrix: ret _map(x, _OP_TRUNC) end
@en "Sign"
@fa "علامت"
pub func Sign(x &: Matrix): Matrix: ret _map(x, _OP_SIGN) end
@en "Square"
@fa "مربع"
pub func Square(x &: Matrix): Matrix: ret _map(x, _OP_SQUARE) end
@en "Reciprocal"
@fa "وارون درایه‌ای"
pub func Reciprocal(x &: Matrix): Matrix: ret _map(x, _OP_RECIP) end
@en "Cbrt"
@fa "ریشه سوم"
pub func Cbrt(x &: Matrix): Matrix: ret _map(x, _OP_CBRT) end
@en "PowElem"
@fa "توان درایه‌ای"
pub func PowElem(x &: Matrix, p: f64): Matrix:
mut r := Zeros(x.rows, x.cols)
ip := p as int
exact := (ip as f64) == p and ip >= 0 and ip <= 64
repeat x.count() in k:
v := x.a.get(k)
if exact:
r.a.set(k, _ipow(v, ip))
else:
r.a.set(k, math.Pow(v, p))
end
end
ret r
end
@en "Clip"
@fa "برش بازه"
pub func Clip(x &: Matrix, lo: f64, hi: f64): Matrix:
mut r := Zeros(x.rows, x.cols)
repeat x.count() in k:
mut v := x.a.get(k)
if v < lo: v = lo end
if v > hi: v = hi end
r.a.set(k, v)
end
ret r
end
@en "MaxScalar"
@fa "بیشینه با عدد"
pub func MaxScalar(x &: Matrix, s: f64): Matrix: ret Clip(x, s, MAT_INF) end
@en "MinScalar"
@fa "کمینه با عدد"
pub func MinScalar(x &: Matrix, s: f64): Matrix:
ret Clip(x, 0.0 - MAT_INF, s)
end
@en "Chop"
@fa "حذف ریزه"
pub func Chop(x &: Matrix, tol: f64): Matrix:
mut r := Clone(x)
repeat r.count() in k:
if math.Abs(r.a.get(k)) < tol: r.a.set(k, 0.0) end
end
ret r
end
package matrix
import math
@en "LDL"
@fa "ال‌دی‌ال"
pub struct LDL:
pub n: int = 0
pub l: Matrix = Matrix {}
pub d: Matrix = Matrix {}
pub ok: bool = false
@en "free"
@fa "آزادسازی"
pub func free():
this.l.free()
this.d.free()
end
end
func _chol_dot(l &: Matrix, i: int, j: int, k: int): f64:
mut s := 0.0
repeat k in p: s += l.at(i, p) * l.at(j, p) end
ret s
end
func _chol_col(l &: Matrix, a &: Matrix, j: int, n: int): bool:
d := a.at(j, j) - _chol_dot(l, j, j, j)
if d <= 0.0: ret false end
p := math.Sqrt(d)
l.set(j, j, p)
mut i := j + 1
until i < n:
l.set(i, j, (a.at(i, j) - _chol_dot(l, i, j, j)) / p)
i += 1
end
ret true
end
func _tri_forward(l &: Matrix, b &: Matrix, n: int):
repeat b.cols in c:
repeat n in i:
mut s := b.at(i, c)
repeat i in j: s -= l.at(i, j) * b.at(j, c) end
b.set(i, c, s / l.at(i, i))
end
end
end
func _tri_backward_t(l &: Matrix, b &: Matrix, n: int):
repeat b.cols in c:
mut i := n - 1
until i >= 0:
mut s := b.at(i, c)
mut j := i + 1
until j < n:
s -= l.at(j, i) * b.at(j, c)
j += 1
end
b.set(i, c, s / l.at(i, i))
i -= 1
end
end
end
func _unit_forward(l &: Matrix, b &: Matrix, n: int):
repeat b.cols in c:
repeat n in i:
mut s := b.at(i, c)
repeat i in j: s -= l.at(i, j) * b.at(j, c) end
b.set(i, c, s)
end
end
end
func _unit_backward_t(l &: Matrix, b &: Matrix, n: int):
repeat b.cols in c:
mut i := n - 1
until i >= 0:
mut s := b.at(i, c)
mut j := i + 1
until j < n:
s -= l.at(j, i) * b.at(j, c)
j += 1
end
b.set(i, c, s)
i -= 1
end
end
end
func _ldl_col(f &: LDL, a &: Matrix, j: int, n: int):
mut d := a.at(j, j)
repeat j in p: d -= f.l.at(j, p) * f.l.at(j, p) * f.d.at(0, p) end
f.d.set(0, j, d)
f.l.set(j, j, 1.0)
if d == 0.0: ret end
mut i := j + 1
until i < n:
mut s := a.at(i, j)
repeat j in p: s -= f.l.at(i, p) * f.l.at(j, p) * f.d.at(0, p) end
f.l.set(i, j, s / d)
i += 1
end
end
func _ldl_nonsingular(f &: LDL): bool:
repeat f.n in i:
if f.d.at(0, i) == 0.0: ret false end
end
ret true
end
func _ldl_scale(f &: LDL, b &: Matrix):
repeat f.n in i:
d := f.d.at(0, i)
repeat b.cols in c: b.set(i, c, b.at(i, c) / d) end
end
end
func _tally(r &: Matrix, d: f64):
if d > 0.0:
r.add_at(0, 0, 1.0)
ret
end
if d < 0.0:
r.add_at(0, 1, 1.0)
ret
end
r.add_at(0, 2, 1.0)
end
@en "Cholesky"
@fa "چولسکی"
pub func Cholesky(x &: Matrix): Matrix:
if x.is_square() == false: ret Zeros(0, 0) end
n := x.rows
mut l := Zeros(n, n)
repeat n in j:
if _chol_col(l, x, j, n) == false:
l.free()
ret Zeros(0, 0)
end
end
ret l
end
@en "SolveSPD"
@fa "حل معین مثبت"
pub func SolveSPD(a &: Matrix, b &: Matrix): Matrix:
mut l := Cholesky(a)
if l.is_empty(): ret Zeros(0, 0) end
r := CholeskySolve(l, b)
defer l.free()
ret r
end
@en "CholeskySolve"
@fa "حل چولسکی"
pub func CholeskySolve(l &: Matrix, b &: Matrix): Matrix:
if l.rows != b.rows: ret Zeros(0, 0) end
mut r := Clone(b)
_tri_forward(l, r, l.rows)
_tri_backward_t(l, r, l.rows)
ret r
end
@en "InverseSPD"
@fa "وارون معین مثبت"
pub func InverseSPD(x &: Matrix): Matrix:
mut id := Eye(x.rows)
r := SolveSPD(x, id)
defer id.free()
ret r
end
@en "DetSPD"
@fa "دترمینان معین مثبت"
pub func DetSPD(x &: Matrix): f64:
mut l := Cholesky(x)
if l.is_empty(): ret 0.0 end
mut p := 1.0
repeat l.rows in i: p = p * l.at(i, i) end
defer l.free()
ret p * p
end
@en "LogDetSPD"
@fa "لگاریتم دترمینان معین مثبت"
pub func LogDetSPD(x &: Matrix): f64:
mut l := Cholesky(x)
if l.is_empty(): ret 0.0 - MAT_INF end
mut s := 0.0
repeat l.rows in i: s += math.Log(l.at(i, i)) end
defer l.free()
ret 2.0 * s
end
@en "LDLDecompose"
@fa "تجزیه ال‌دی‌ال"
pub func LDLDecompose(x &: Matrix): LDL:
mut f := LDL {}
if x.is_square() == false: ret f end
n := x.rows
f.n = n
f.l = Zeros(n, n)
f.d = Zeros(1, n)
repeat n in j: _ldl_col(f, x, j, n) end
f.ok = _ldl_nonsingular(f)
ret f
end
@en "LDLSolve"
@fa "حل ال‌دی‌ال"
pub func LDLSolve(f &: LDL, b &: Matrix): Matrix:
if f.ok == false or f.n != b.rows: ret Zeros(0, 0) end
mut r := Clone(b)
_unit_forward(f.l, r, f.n)
_ldl_scale(f, r)
_unit_backward_t(f.l, r, f.n)
ret r
end
@en "Inertia"
@fa "لختی"
pub func Inertia(x &: Matrix): Matrix:
mut f := LDLDecompose(x)
mut r := Zeros(1, 3)
repeat f.n in i: _tally(r, f.d.at(0, i)) end
defer f.free()
ret r
end
package matrix
import math
const _QR_MAX_ITER := 120
const _QR_EXCEPTIONAL := 10
@en "Eigen"
@fa "ویژه"
pub struct Eigen:
pub n: int = 0
pub re: Matrix = Matrix {}
pub im: Matrix = Matrix {}
pub iterations: int = 0
pub ok: bool = false
@en "free"
@fa "آزادسازی"
pub func free():
this.re.free()
this.im.free()
end
end
func _hess_step(a &: Matrix, k: int, n: int):
mut scale := 0.0
mut i := k + 1
until i < n:
scale += math.Abs(a.at(i, k))
i += 1
end
if scale == 0.0: ret end
mut h := 0.0
mut v := Zeros(n, 1)
mut p := k + 1
until p < n:
val := a.at(p, k) / scale
v.set(p, 0, val)
h += val * val
p += 1
end
_hess_reflect(a, v, k, n, h, scale)
defer v.free()
end
func _hess_reflect(a &: Matrix, v &: Matrix, k: int, n: int, h0: f64, scale: f64):
mut g := math.Sqrt(h0)
if v.at(k + 1, 0) > 0.0: g = 0.0 - g end
h := h0 - v.at(k + 1, 0) * g
v.set(k + 1, 0, v.at(k + 1, 0) - g)
_hess_rows(a, v, k, n, h)
_hess_cols(a, v, k, n, h)
a.set(k + 1, k, scale * g)
mut i := k + 2
until i < n:
a.set(i, k, 0.0)
i += 1
end
end
func _hess_rows(a &: Matrix, v &: Matrix, k: int, n: int, h: f64):
mut j := k
until j < n:
mut f := 0.0
mut i := k + 1
until i < n:
f += v.at(i, 0) * a.at(i, j)
i += 1
end
f = f / h
mut p := k + 1
until p < n:
a.add_at(p, j, 0.0 - f * v.at(p, 0))
p += 1
end
j += 1
end
end
func _hess_cols(a &: Matrix, v &: Matrix, k: int, n: int, h: f64):
repeat n in i:
mut f := 0.0
mut j := k + 1
until j < n:
f += v.at(j, 0) * a.at(i, j)
j += 1
end
f = f / h
mut q := k + 1
until q < n:
a.add_at(i, q, 0.0 - f * v.at(q, 0))
q += 1
end
end
end
func _find_split(h &: Matrix, lo: int, hi: int): int:
mut l := hi
until l > lo:
s := math.Abs(h.at(l - 1, l - 1)) + math.Abs(h.at(l, l))
mut ref := s
if ref == 0.0: ref = 1.0 end
if math.Abs(h.at(l, l - 1)) <= MAT_EPS * ref:
h.set(l, l - 1, 0.0)
ret l
end
l -= 1
end
ret lo
end
func _wilkinson(h &: Matrix, hi: int): f64:
a := h.at(hi - 1, hi - 1)
b := h.at(hi - 1, hi)
c := h.at(hi, hi - 1)
d := h.at(hi, hi)
tr := a + d
disc := (a - d) * (a - d) * 0.25 + b * c
if disc < 0.0: ret tr * 0.5 end
root := math.Sqrt(disc)
up := tr * 0.5 + root
down := tr * 0.5 - root
if math.Abs(up - d) < math.Abs(down - d): ret up end
ret down
end
func _qr_step(h &: Matrix, lo: int, hi: int, mu: f64):
mut cs := Zeros(1, hi + 1)
mut sn := Zeros(1, hi + 1)
mut k := lo
until k <= hi:
h.add_at(k, k, 0.0 - mu)
k += 1
end
_qr_left(h, lo, hi, cs, sn)
_qr_right(h, lo, hi, cs, sn)
mut j := lo
until j <= hi:
h.add_at(j, j, mu)
j += 1
end
defer cs.free()
defer sn.free()
end
func _qr_left(h &: Matrix, lo: int, hi: int, cs &: Matrix, sn &: Matrix):
n := h.cols
mut k := lo
until k < hi:
a := h.at(k, k)
b := h.at(k + 1, k)
r := math.Hypot(a, b)
mut c := 1.0
mut s := 0.0
if r != 0.0:
c = a / r
s = b / r
end
cs.set(0, k, c)
sn.set(0, k, s)
_rot_rows(h, k, c, s, k, n)
k += 1
end
end
func _rot_rows(h &: Matrix, k: int, c: f64, s: f64, lo: int, hi: int):
mut j := lo
until j < hi:
u := h.at(k, j)
w := h.at(k + 1, j)
h.set(k, j, c * u + s * w)
h.set(k + 1, j, c * w - s * u)
j += 1
end
end
func _qr_right(h &: Matrix, lo: int, hi: int, cs &: Matrix, sn &: Matrix):
mut k := lo
until k < hi:
c := cs.at(0, k)
s := sn.at(0, k)
mut top := k + 2
if top > hi: top = hi end
mut i := lo
until i <= top:
u := h.at(i, k)
w := h.at(i, k + 1)
h.set(i, k, c * u + s * w)
h.set(i, k + 1, c * w - s * u)
i += 1
end
k += 1
end
end
func _emit_pair(h &: Matrix, r &: Eigen, hi: int):
a := h.at(hi - 1, hi - 1)
b := h.at(hi - 1, hi)
c := h.at(hi, hi - 1)
d := h.at(hi, hi)
half := (a + d) * 0.5
disc := (a - d) * (a - d) * 0.25 + b * c
if disc >= 0.0:
root := math.Sqrt(disc)
_emit(r, hi - 1, half + root, 0.0)
_emit(r, hi, half - root, 0.0)
ret
end
root := math.Sqrt(0.0 - disc)
_emit(r, hi - 1, half, root)
_emit(r, hi, half, 0.0 - root)
end
func _emit(r &: Eigen, k: int, re: f64, im: f64):
r.re.set(0, k, re)
r.im.set(0, k, im)
end
func _exceptional(h &: Matrix, hi: int): f64:
s := math.Abs(h.at(hi, hi - 1)) + math.Abs(h.at(hi - 1, hi - 2))
ret h.at(hi, hi) + 0.75 * s
end
func _choose_shift(h &: Matrix, hi: int, its: int): f64:
if its > 0 and its % _QR_EXCEPTIONAL == 0:
if hi >= 2: ret _exceptional(h, hi) end
end
ret _wilkinson(h, hi)
end
func _qr_iterate(h &: Matrix, r &: Eigen, n: int): bool:
mut hi := n - 1
mut its := 0
mut total := 0
until hi >= 0:
l := _find_split(h, 0, hi)
if l == hi:
_emit(r, hi, h.at(hi, hi), 0.0)
hi -= 1
its = 0
else l == hi - 1:
_emit_pair(h, r, hi)
hi -= 2
its = 0
else:
if its >= _QR_MAX_ITER: ret false end
_qr_step(h, l, hi, _choose_shift(h, hi, its))
its += 1
total += 1
end
end
r.iterations = total
ret true
end
func _faddeev(a &: Matrix, m &: Matrix, c &: Matrix, k: int, n: int):
mut t := MatMul(a, m)
ShiftDiagonal(t, c.at(0, n - k + 1))
CopyInto(m, t)
defer t.free()
mut am := MatMul(a, m)
c.set(0, n - k, 0.0 - Trace(am) / (k as f64))
defer am.free()
end
func _inverse_step(f &: LU, v &: Matrix):
mut w := LUSolve(f, v)
if w.is_empty(): ret end
nrm := NormFrobenius(w)
if nrm > 0.0: ScaleInPlace(w, 1.0 / nrm) end
CopyInto(v, w)
defer w.free()
end
@en "Hessenberg"
@fa "هسنبرگ"
pub func Hessenberg(x &: Matrix): Matrix:
if x.is_square() == false: ret Zeros(0, 0) end
mut h := Clone(x)
n := x.rows
mut k := 0
until k < n - 2:
_hess_step(h, k, n)
k += 1
end
ret h
end
@en "EigVals"
@fa "مقادیر ویژه"
pub func EigVals(x &: Matrix): Eigen:
mut r := Eigen {}
if x.is_square() == false: ret r end
n := x.rows
r.n = n
r.re = Zeros(1, n)
r.im = Zeros(1, n)
mut h := Hessenberg(x)
r.ok = _qr_iterate(h, r, n)
defer h.free()
ret r
end
@en "EigValsAuto"
@fa "مقادیر ویژه خودکار"
pub func EigValsAuto(x &: Matrix): Eigen:
if IsSymmetric(x, MAT_TOL) == false: ret EigVals(x) end
mut r := Eigen {}
r.n = x.rows
r.re = EigValsSym(x)
r.im = Zeros(1, x.rows)
r.ok = true
ret r
end
@en "SpectralRadius"
@fa "شعاع طیفی"
pub func SpectralRadius(x &: Matrix): f64:
mut e := EigValsAuto(x)
mut m := 0.0
repeat e.n in k:
v := math.Hypot(e.re.a.get(k), e.im.a.get(k))
if v > m: m = v end
end
defer e.free()
ret m
end
@en "CharPoly"
@fa "چندجمله‌ای مشخصه"
pub func CharPoly(x &: Matrix): Matrix:
if x.is_square() == false: ret Zeros(0, 0) end
n := x.rows
mut c := Zeros(1, n + 1)
c.set(0, n, 1.0)
mut m := Zeros(n, n)
repeat n in step: _faddeev(x, m, c, step + 1, n) end
defer m.free()
ret c
end
@en "EigVecFor"
@fa "بردار ویژه برای"
pub func EigVecFor(x &: Matrix, lambda: f64, iters: int): Matrix:
if x.is_square() == false: ret Zeros(0, 0) end
n := x.rows
mut shifted := Clone(x)
ShiftDiagonal(shifted, 0.0 - lambda - MAT_EPS * (1.0 + math.Abs(lambda)))
mut f := Decompose(shifted)
mut v := Full(n, 1, 1.0 / math.Sqrt(n as f64))
repeat iters: _inverse_step(f, v) end
defer shifted.free()
defer f.free()
ret v
end
package matrix
import math
const _EIG_MAX_SWEEPS := 100
@en "EigenSym"
@fa "تجزیه ویژه متقارن"
pub struct EigenSym:
pub n: int = 0
pub values: Matrix = Matrix {}
pub vectors: Matrix = Matrix {}
pub sweeps: int = 0
pub ok: bool = false
@en "free"
@fa "آزادسازی"
pub func free():
this.values.free()
this.vectors.free()
end
end
func _off_norm(a &: Matrix, n: int): f64:
mut s := 0.0
repeat n in i:
mut j := i + 1
until j < n:
s += a.at(i, j) * a.at(i, j)
j += 1
end
end
ret math.Sqrt(2.0 * s)
end
func _sym_rotate(a &: Matrix, v &: Matrix, p: int, q: int, c: f64, s: f64):
n := a.rows
repeat n in k:
akp := a.at(k, p)
akq := a.at(k, q)
a.set(k, p, c * akp - s * akq)
a.set(k, q, s * akp + c * akq)
end
repeat n in k:
apk := a.at(p, k)
aqk := a.at(q, k)
a.set(p, k, c * apk - s * aqk)
a.set(q, k, s * apk + c * aqk)
end
repeat n in k:
vkp := v.at(k, p)
vkq := v.at(k, q)
v.set(k, p, c * vkp - s * vkq)
v.set(k, q, s * vkp + c * vkq)
end
end
func _sym_step(a &: Matrix, v &: Matrix, p: int, q: int, tol: f64): bool:
apq := a.at(p, q)
if math.Abs(apq) <= tol: ret false end
theta := (a.at(q, q) - a.at(p, p)) / (2.0 * apq)
mut t := 1.0 / (math.Abs(theta) + math.Sqrt(theta * theta + 1.0))
if theta < 0.0: t = 0.0 - t end
c := 1.0 / math.Sqrt(t * t + 1.0)
s := t * c
_sym_rotate(a, v, p, q, c, s)
ret true
end
func _sym_sweep(a &: Matrix, v &: Matrix, n: int, tol: f64):
mut p := 0
until p < n - 1:
mut q := p + 1
until q < n:
_sym_step(a, v, p, q, tol)
q += 1
end
p += 1
end
end
func _eig_sort(vals &: Matrix, vecs &: Matrix, n: int):
repeat n in i:
mut best := i
mut j := i + 1
until j < n:
if vals.at(0, j) > vals.at(0, best): best = j end
j += 1
end
if best != i:
t := vals.at(0, i)
vals.set(0, i, vals.at(0, best))
vals.set(0, best, t)
SwapCols(vecs, i, best)
end
end
end
func _fix_signs(vecs &: Matrix, n: int):
repeat n in j:
mut bi := 0
repeat vecs.rows in i:
if math.Abs(vecs.at(i, j)) > math.Abs(vecs.at(bi, j)): bi = i end
end
if vecs.at(bi, j) < 0.0:
repeat vecs.rows in i: vecs.set(i, j, 0.0 - vecs.at(i, j)) end
end
end
end
func _eig_iterate(r &: EigenSym, work &: Matrix, n: int, tol: f64):
mut sweeps := 0
until _off_norm(work, n) > tol and sweeps < _EIG_MAX_SWEEPS:
_sym_sweep(work, r.vectors, n, tol * 0.001)
sweeps += 1
end
r.sweeps = sweeps
r.ok = sweeps < _EIG_MAX_SWEEPS
end
func _pow_eigval(f &: EigenSym, k: int, p: f64):
v := f.values.a.get(k)
if v <= 0.0:
f.values.a.set(k, 0.0)
ret
end
f.values.a.set(k, math.Pow(v, p))
end
@en "EigSym"
@fa "ویژه متقارن"
pub func EigSym(x &: Matrix): EigenSym:
mut r := EigenSym {}
if x.is_square() == false: ret r end
n := x.rows
r.n = n
mut work := SymPart(x)
r.vectors = Eye(n)
tol := MAT_EPS * NormFrobenius(work)
_eig_iterate(r, work, n, tol)
r.values = Diagonal(work)
_eig_sort(r.values, r.vectors, n)
_fix_signs(r.vectors, n)
defer work.free()
ret r
end
@en "EigValsSym"
@fa "مقادیر ویژه متقارن"
pub func EigValsSym(x &: Matrix): Matrix:
mut f := EigSym(x)
v := Clone(f.values)
defer f.free()
ret v
end
@en "EigReconstruct"
@fa "بازسازی ویژه"
pub func EigReconstruct(f &: EigenSym): Matrix:
mut d := Diag(f.values.a)
mut t := MatMul(f.vectors, d)
r := MulTranspose(t, f.vectors)
defer d.free()
defer t.free()
ret r
end
@en "SpectralRadiusSym"
@fa "شعاع طیفی متقارن"
pub func SpectralRadiusSym(x &: Matrix): f64:
mut v := EigValsSym(x)
mut m := 0.0
repeat v.count() in k:
a := math.Abs(v.a.get(k))
if a > m: m = a end
end
defer v.free()
ret m
end
@en "PowSym"
@fa "توان متقارن"
pub func PowSym(x &: Matrix, p: f64): Matrix:
mut f := EigSym(x)
repeat f.values.count() in k: _pow_eigval(f, k, p) end
r := EigReconstruct(f)
defer f.free()
ret r
end
@en "SqrtSym"
@fa "جذر متقارن"
pub func SqrtSym(x &: Matrix): Matrix: ret PowSym(x, 0.5) end
package matrix
func _elem_ok(x &: Matrix, y &: Matrix): bool:
if x.rows != y.rows: ret false end
if x.cols != y.cols: ret false end
ret true
end
func _zip(x &: Matrix, y &: Matrix, op: int): Matrix:
if _elem_ok(x, y) == false: ret Zeros(0, 0) end
r := _raw(x.rows, x.cols)
n := x.count()
if n <= 0: ret r end
px := x.a.data
py := y.a.data
pr := r.a.data
if op == 0:
repeat n in k: pr[k] = px[k] + py[k] end
else op == 1:
repeat n in k: pr[k] = px[k] - py[k] end
else op == 2:
repeat n in k: pr[k] = px[k] * py[k] end
else:
repeat n in k:
v := py[k]
if v == 0.0: pr[k] = 0.0
else:
pr[k] = px[k] / v
end
end
end
ret r
end
@en "Add"
@fa "جمع"
pub func Add(x &: Matrix, y &: Matrix): Matrix: ret _zip(x, y, 0) end
@en "Sub"
@fa "تفریق"
pub func Sub(x &: Matrix, y &: Matrix): Matrix: ret _zip(x, y, 1) end
@en "MulElem"
@fa "ضرب درایه‌ای"
pub func MulElem(x &: Matrix, y &: Matrix): Matrix: ret _zip(x, y, 2) end
@en "DivElem"
@fa "تقسیم درایه‌ای"
pub func DivElem(x &: Matrix, y &: Matrix): Matrix: ret _zip(x, y, 3) end
@en "Neg"
@fa "قرینه"
pub func Neg(x &: Matrix): Matrix: ret Scale(x, 0.0 - 1.0) end
@en "AddScalar"
@fa "جمع با عدد"
pub func AddScalar(x &: Matrix, s: f64): Matrix:
mut r := Clone(x)
AddScalarInPlace(r, s)
ret r
end
@en "SubScalar"
@fa "تفریق عدد"
pub func SubScalar(x &: Matrix, s: f64): Matrix: ret AddScalar(x, 0.0 - s) end
@en "Scale"
@fa "مقیاس"
pub func Scale(x &: Matrix, s: f64): Matrix:
mut r := Clone(x)
ScaleInPlace(r, s)
ret r
end
@en "DivScalar"
@fa "تقسیم با عدد"
pub func DivScalar(x &: Matrix, s: f64): Matrix:
if s == 0.0: ret Zeros(x.rows, x.cols) end
ret Scale(x, 1.0 / s)
end
@en "AddInPlace"
@fa "جمع درجا"
pub func AddInPlace(dst &: Matrix, src &: Matrix):
if _elem_ok(dst, src) == false: ret end
repeat dst.count() in k: dst.a.set(k, dst.a.get(k) + src.a.get(k)) end
end
@en "SubInPlace"
@fa "تفریق درجا"
pub func SubInPlace(dst &: Matrix, src &: Matrix):
if _elem_ok(dst, src) == false: ret end
repeat dst.count() in k: dst.a.set(k, dst.a.get(k) - src.a.get(k)) end
end
@en "MulElemInPlace"
@fa "ضرب درایه‌ای درجا"
pub func MulElemInPlace(dst &: Matrix, src &: Matrix):
if _elem_ok(dst, src) == false: ret end
repeat dst.count() in k: dst.a.set(k, dst.a.get(k) * src.a.get(k)) end
end
@en "ScaleInPlace"
@fa "مقیاس درجا"
pub func ScaleInPlace(dst &: Matrix, s: f64):
repeat dst.count() in k: dst.a.set(k, dst.a.get(k) * s) end
end
@en "AddScalarInPlace"
@fa "جمع عدد درجا"
pub func AddScalarInPlace(dst &: Matrix, s: f64):
repeat dst.count() in k: dst.a.set(k, dst.a.get(k) + s) end
end
@en "NegInPlace"
@fa "قرینه درجا"
pub func NegInPlace(dst &: Matrix): ScaleInPlace(dst, 0.0 - 1.0) end
@en "AddScaled"
@fa "جمع مقیاس‌دار"
pub func AddScaled(dst &: Matrix, src &: Matrix, alpha: f64):
if _elem_ok(dst, src) == false: ret end
repeat dst.count() in k:
dst.a.set(k, dst.a.get(k) + alpha * src.a.get(k))
end
end
@en "Combine"
@fa "ترکیب"
pub func Combine(x &: Matrix, a: f64, y &: Matrix, b: f64): Matrix:
if _elem_ok(x, y) == false: ret Zeros(0, 0) end
mut r := Zeros(x.rows, x.cols)
repeat x.count() in k:
r.a.set(k, a * x.a.get(k) + b * y.a.get(k))
end
ret r
end
@en "MaxElem"
@fa "بیشینه درایه‌ای"
pub func MaxElem(x &: Matrix, y &: Matrix): Matrix:
if _elem_ok(x, y) == false: ret Zeros(0, 0) end
mut r := Zeros(x.rows, x.cols)
repeat x.count() in k:
u := x.a.get(k)
v := y.a.get(k)
if u > v:
r.a.set(k, u)
else:
r.a.set(k, v)
end
end
ret r
end
@en "MinElem"
@fa "کمینه درایه‌ای"
pub func MinElem(x &: Matrix, y &: Matrix): Matrix:
if _elem_ok(x, y) == false: ret Zeros(0, 0) end
mut r := Zeros(x.rows, x.cols)
repeat x.count() in k:
u := x.a.get(k)
v := y.a.get(k)
if u < v:
r.a.set(k, u)
else:
r.a.set(k, v)
end
end
ret r
end
@en "AddRowVector"
@fa "جمع بردار سطری"
pub func AddRowVector(x &: Matrix, row &: Matrix): Matrix:
if row.rows != 1 or row.cols != x.cols: ret Zeros(0, 0) end
mut r := Clone(x)
repeat x.rows in i:
repeat x.cols in j: r.add_at(i, j, row.at(0, j)) end
end
ret r
end
@en "AddColVector"
@fa "جمع بردار ستونی"
pub func AddColVector(x &: Matrix, col &: Matrix): Matrix:
if col.cols != 1 or col.rows != x.rows: ret Zeros(0, 0) end
mut r := Clone(x)
repeat x.rows in i:
repeat x.cols in j: r.add_at(i, j, col.at(i, 0)) end
end
ret r
end
@en "MulRowVector"
@fa "ضرب بردار سطری"
pub func MulRowVector(x &: Matrix, row &: Matrix): Matrix:
if row.rows != 1 or row.cols != x.cols: ret Zeros(0, 0) end
mut r := Clone(x)
repeat x.rows in i:
repeat x.cols in j: r.mul_at(i, j, row.at(0, j)) end
end
ret r
end
@en "MulColVector"
@fa "ضرب بردار ستونی"
pub func MulColVector(x &: Matrix, col &: Matrix): Matrix:
if col.cols != 1 or col.rows != x.rows: ret Zeros(0, 0) end
mut r := Clone(x)
repeat x.rows in i:
repeat x.cols in j: r.mul_at(i, j, col.at(i, 0)) end
end
ret r
end
package matrix
import conv
import math
func _entry(v: f64, prec: int): str:
mut x := v
if x == 0.0: x = 0.0 end
if math.IsNaN(x): ret "nan" end
if math.IsInf(x): ret _inf_text(x) end
ret conv.FormatFloatPrec(x, prec)
end
func _inf_text(x: f64): str:
if x < 0.0: ret "-inf" end
ret "inf"
end
func _width_of(x &: Matrix, prec: int): int:
mut w := 1
repeat x.count() in k:
n := _entry(x.a.get(k), prec).len()
if n > w: w = n end
end
ret w
end
func _pad(s: str, width: int): str:
mut out := ""
mut n := width - s.len()
until n > 0:
out = out + " "
n -= 1
end
ret out + s
end
func _row_text(x &: Matrix, i: int, prec: int, width: int): str:
mut line := ""
repeat x.cols in j:
if j > 0: line = line + " " end
line = line + _pad(_entry(x.at(i, j), prec), width)
end
ret line
end
func _csv_row(x &: Matrix, i: int, prec: int): str:
mut line := ""
repeat x.cols in j:
if j > 0: line = line + "," end
line = line + _entry(x.at(i, j), prec)
end
ret line
end
@en "ToStringPrec"
@fa "به رشته با دقت"
pub func ToStringPrec(x &: Matrix, prec: int): str:
if x.is_empty(): ret "[]" end
w := _width_of(x, prec)
mut out := ""
repeat x.rows in i:
if i > 0: out = out + "\n" end
out = out + _row_text(x, i, prec, w)
end
ret out
end
@en "ToString"
@fa "به رشته"
pub func ToString(x &: Matrix): str: ret ToStringPrec(x, 4) end
@en "ShapeString"
@fa "رشته شکل"
pub func ShapeString(x &: Matrix): str:
ret conv.FormatInt(x.rows as i64) + "x" + conv.FormatInt(x.cols as i64)
end
@en "Print"
@fa "چاپ"
pub func Print(x &: Matrix): println ToString(x) end
@en "PrintPrec"
@fa "چاپ با دقت"
pub func PrintPrec(x &: Matrix, prec: int): println ToStringPrec(x, prec) end
@en "PrintLabeled"
@fa "چاپ برچسب‌دار"
pub func PrintLabeled(label: str, x &: Matrix):
println label + " (" + ShapeString(x) + ")"
println ToString(x)
end
@en "ToCSV"
@fa "به سی‌اس‌وی"
pub func ToCSV(x &: Matrix, prec: int): str:
mut out := ""
repeat x.rows in i:
if i > 0: out = out + "\n" end
out = out + _csv_row(x, i, prec)
end
ret out
end
@en "ToRepr"
@fa "به بازنمایی"
pub func ToRepr(x &: Matrix, prec: int): str:
mut out := "["
repeat x.rows in i:
if i > 0: out = out + "; " end
out = out + _csv_row(x, i, prec)
end
ret out + "]"
end
package matrix
import math
const _PADE_Q := 6
const _EXPM_MAX_SQUARINGS := 60
const _SQRTM_MAX_ITER := 60
const _SIGN_MAX_ITER := 100
func _pade_coeff(k: int, q: int): f64:
mut c := 1.0
mut i := 1
until i <= k:
c = c * ((q - i + 1) as f64) / (((2 * q - i + 1) * i) as f64)
i += 1
end
ret c
end
func _expm_squarings(x &: Matrix): int:
nrm := NormInf(x)
mut s := 0
mut v := nrm
until v > 0.5 and s < _EXPM_MAX_SQUARINGS:
v = v * 0.5
s += 1
end
ret s
end
func _pade_accumulate(a &: Matrix, num &: Matrix, den &: Matrix, n: int):
mut power := Eye(n)
mut k := 1
until k <= _PADE_Q:
t := MatMul(power, a)
power.free()
power = t
c := _pade_coeff(k, _PADE_Q)
AddScaled(num, power, c)
mut sign := c
if k % 2 == 1: sign = 0.0 - c end
AddScaled(den, power, sign)
k += 1
end
defer power.free()
end
func _db_step(y &: Matrix, z &: Matrix):
mut yi := Inverse(y)
mut zi := Inverse(z)
if yi.is_empty() or zi.is_empty():
yi.free()
zi.free()
ret
end
mut ny := Combine(y, 0.5, zi, 0.5)
mut nz := Combine(z, 0.5, yi, 0.5)
CopyInto(y, ny)
CopyInto(z, nz)
defer yi.free()
defer zi.free()
defer ny.free()
defer nz.free()
end
func _converged(a &: Matrix, b &: Matrix, tol: f64): bool:
d := Distance(a, b)
scale := NormFrobenius(b)
if scale == 0.0: ret d <= tol end
ret d <= tol * scale
end
func _pade_core(a &: Matrix, n: int): Matrix:
mut num := Eye(n)
mut den := Eye(n)
_pade_accumulate(a, num, den, n)
mut r := Solve(den, num)
defer num.free()
defer den.free()
if r.is_empty(): ret Eye(n) end
ret r
end
func _square_in_place(r &: Matrix):
mut t := MatMul(r, r)
CopyInto(r, t)
defer t.free()
end
func _log_eigval(f &: EigenSym, k: int):
v := f.values.a.get(k)
if v <= 0.0:
f.values.a.set(k, math.NaN())
ret
end
f.values.a.set(k, math.Log(v))
end
@en "Expm"
@fa "نمایی ماتریسی"
pub func Expm(x &: Matrix): Matrix:
if x.is_square() == false: ret Zeros(0, 0) end
n := x.rows
s := _expm_squarings(x)
mut a := Scale(x, math.Pow(0.5, s as f64))
mut r := _pade_core(a, n)
defer a.free()
repeat s: _square_in_place(r) end
ret r
end
@en "Sqrtm"
@fa "جذر ماتریسی"
pub func Sqrtm(x &: Matrix): Matrix:
if x.is_square() == false: ret Zeros(0, 0) end
mut y := Clone(x)
mut z := Eye(x.rows)
mut prev := Clone(y)
mut i := 0
until i < _SQRTM_MAX_ITER:
_db_step(y, z)
if _converged(prev, y, MAT_TOL): break end
CopyInto(prev, y)
i += 1
end
defer z.free()
defer prev.free()
ret y
end
@en "MatrixSign"
@fa "علامت ماتریسی"
pub func MatrixSign(x &: Matrix): Matrix:
if x.is_square() == false: ret Zeros(0, 0) end
mut s := Clone(x)
mut prev := Clone(x)
mut i := 0
until i < _SIGN_MAX_ITER:
mut inv := Inverse(s)
if inv.is_empty(): break end
mut nx := Combine(s, 0.5, inv, 0.5)
CopyInto(s, nx)
inv.free()
nx.free()
if _converged(prev, s, MAT_TOL): break end
CopyInto(prev, s)
i += 1
end
defer prev.free()
ret s
end
@en "PolyEval"
@fa "ارزیابی چندجمله‌ای"
pub func PolyEval(x &: Matrix, coeffs &: Matrix): Matrix:
if x.is_square() == false: ret Zeros(0, 0) end
n := coeffs.count()
if n == 0: ret Zeros(x.rows, x.cols) end
mut acc := Full(x.rows, x.cols, 0.0)
ShiftDiagonal(acc, coeffs.a.get(n - 1))
mut k := n - 2
until k >= 0:
mut t := MatMul(acc, x)
ShiftDiagonal(t, coeffs.a.get(k))
CopyInto(acc, t)
t.free()
k -= 1
end
ret acc
end
@en "CayleyHamilton"
@fa "کیلی همیلتون"
pub func CayleyHamilton(x &: Matrix): Matrix:
mut p := CharPoly(x)
r := PolyEval(x, p)
defer p.free()
ret r
end
@en "LogmSym"
@fa "لگاریتم متقارن"
pub func LogmSym(x &: Matrix): Matrix:
if IsSymmetric(x, MAT_TOL) == false: ret Zeros(0, 0) end
mut f := EigSym(x)
mut ok := true
repeat f.values.count() in k: _log_eigval(f, k) end
repeat f.values.count() in k:
if math.IsNaN(f.values.a.get(k)): ok = false end
end
mut r := EigReconstruct(f)
defer f.free()
if ok: ret r end
defer r.free()
ret Zeros(0, 0)
end
package matrix
import math
@en "IterResult"
@fa "نتیجه تکرار"
pub struct IterResult:
pub x: Matrix = Matrix {}
pub iterations: int = 0
pub residual: f64 = 0.0
pub converged: bool = false
@en "free"
@fa "آزادسازی"
pub func free(): this.x.free() end
end
func _resid_norm(a &: Matrix, x &: Matrix, b &: Matrix): f64:
mut ax := MatVec(a, x)
mut r := Sub(b, ax)
v := NormFrobenius(r)
defer ax.free()
defer r.free()
ret v
end
func _sweep(a &: Matrix, x &: Matrix, xo &: Matrix, b &: Matrix, omega: f64, in_place: bool):
n := a.rows
repeat n in i:
d := a.at(i, i)
if d != 0.0:
mut s := b.at(i, 0)
repeat n in j:
if j != i: s -= a.at(i, j) * _pick(x, xo, j, in_place) end
end
_relax(x, i, s / d, omega)
end
end
end
func _pick(x &: Matrix, xo &: Matrix, j: int, in_place: bool): f64:
if in_place: ret x.at(j, 0) end
ret xo.at(j, 0)
end
func _relax(x &: Matrix, i: int, candidate: f64, omega: f64):
if omega == 1.0:
x.set(i, 0, candidate)
ret
end
x.set(i, 0, (1.0 - omega) * x.at(i, 0) + omega * candidate)
end
func _stationary(a &: Matrix, b &: Matrix, omega: f64, in_place: bool, iters: int, tol: f64): IterResult:
mut r := IterResult {}
if a.is_square() == false or a.rows != b.rows or b.cols != 1: ret r end
r.x = Zeros(a.rows, 1)
mut prev := Zeros(a.rows, 1)
mut k := 0
until k < iters:
CopyInto(prev, r.x)
_sweep(a, r.x, prev, b, omega, in_place)
k += 1
if _resid_norm(a, r.x, b) <= tol: break end
end
defer prev.free()
r.iterations = k
r.residual = _resid_norm(a, r.x, b)
r.converged = r.residual <= tol
ret r
end
func _cg_loop(a &: Matrix, out &: IterResult, r &: Matrix, p &: Matrix, iters: int, tol: f64):
mut rs := Dot(r, r)
mut k := 0
until k < iters:
if math.Sqrt(rs) <= tol: break end
rs = _cg_step(a, out.x, r, p, rs)
k += 1
end
out.iterations = k
end
func _cg_step(a &: Matrix, x &: Matrix, r &: Matrix, p &: Matrix, rs: f64): f64:
mut ap := MatVec(a, p)
denom := Dot(p, ap)
if denom == 0.0:
ap.free()
ret 0.0
end
alpha := rs / denom
AddScaled(x, p, alpha)
AddScaled(r, ap, 0.0 - alpha)
rs_new := Dot(r, r)
_cg_direction(p, r, rs_new / rs)
defer ap.free()
ret rs_new
end
func _cg_direction(p &: Matrix, r &: Matrix, beta: f64):
repeat p.count() in k: p.a.set(k, r.a.get(k) + beta * p.a.get(k)) end
end
func _power_step(a &: Matrix, v &: Matrix):
mut w := MatVec(a, v)
nrm := NormFrobenius(w)
if nrm > 0.0:
ScaleInPlace(w, 1.0 / nrm)
CopyInto(v, w)
end
defer w.free()
end
func _rayleigh(a &: Matrix, x &: Matrix): f64:
d := Dot(x, x)
if d == 0.0: ret 0.0 end
mut ax := MatVec(a, x)
v := Dot(x, ax) / d
defer ax.free()
ret v
end
@en "IsDiagonallyDominant"
@fa "غالب قطری است"
pub func IsDiagonallyDominant(a &: Matrix): bool:
if a.is_square() == false: ret false end
repeat a.rows in i:
mut off := 0.0
repeat a.cols in j:
if j != i: off += math.Abs(a.at(i, j)) end
end
if math.Abs(a.at(i, i)) <= off: ret false end
end
ret true
end
@en "SolveJacobi"
@fa "حل ژاکوبی"
pub func SolveJacobi(a &: Matrix, b &: Matrix, iters: int, tol: f64): IterResult:
ret _stationary(a, b, 1.0, false, iters, tol)
end
@en "SolveGaussSeidel"
@fa "حل گاوس زایدل"
pub func SolveGaussSeidel(a &: Matrix, b &: Matrix, iters: int, tol: f64): IterResult:
ret _stationary(a, b, 1.0, true, iters, tol)
end
@en "SolveSOR"
@fa "حل فوق‌آسایش"
pub func SolveSOR(a &: Matrix, b &: Matrix, omega: f64, iters: int, tol: f64): IterResult:
ret _stationary(a, b, omega, true, iters, tol)
end
@en "SolveCG"
@fa "حل گرادیان مزدوج"
pub func SolveCG(a &: Matrix, b &: Matrix, iters: int, tol: f64): IterResult:
mut out := IterResult {}
if a.is_square() == false or a.rows != b.rows or b.cols != 1: ret out end
out.x = Zeros(a.rows, 1)
mut r := Clone(b)
mut p := Clone(b)
_cg_loop(a, out, r, p, iters, tol)
out.residual = NormFrobenius(r)
out.converged = out.residual <= tol
defer r.free()
defer p.free()
ret out
end
@en "PowerIteration"
@fa "تکرار توانی"
pub func PowerIteration(a &: Matrix, iters: int): Matrix:
if a.is_square() == false: ret Zeros(0, 0) end
n := a.rows
mut v := Full(n, 1, 1.0 / math.Sqrt(n as f64))
repeat iters: _power_step(a, v) end
lambda := _rayleigh(a, v)
mut r := Zeros(n + 1, 1)
repeat n in i: r.set(i, 0, v.at(i, 0)) end
r.set(n, 0, lambda)
defer v.free()
ret r
end
@en "Rayleigh"
@fa "خارج‌قسمت ریلی"
pub func Rayleigh(a &: Matrix, x &: Matrix): f64: ret _rayleigh(a, x) end
@en "ShiftedInverseIteration"
@fa "تکرار وارون شیفت‌دار"
pub func ShiftedInverseIteration(a &: Matrix, shift: f64, iters: int): f64:
mut v := EigVecFor(a, shift, iters)
if v.is_empty(): ret shift end
lambda := _rayleigh(a, v)
defer v.free()
ret lambda
end
package matrix
import math
@en "LU"
@fa "تجزیه پایین بالا"
pub struct LU:
pub n: int = 0
pub lu: Matrix = Matrix {}
pub piv: Vector<int> = Vector {}
pub sign: int = 1
pub singular: bool = false
@en "free"
@fa "آزادسازی"
pub func free():
this.lu.free()
this.piv.free()
end
end
func _lu_pivot(m &: Matrix, k: int, n: int): int:
mut best := k
mut bv := math.Abs(m.at(k, k))
mut i := k + 1
until i < n:
v := math.Abs(m.at(i, k))
if v > bv:
bv = v
best = i
end
i += 1
end
ret best
end
func _lu_swap(m &: Matrix, piv &: Vector<int>, i: int, j: int):
repeat m.cols in c:
t := m.at(i, c)
m.set(i, c, m.at(j, c))
m.set(j, c, t)
end
t := piv.get(i)
piv.set(i, piv.get(j))
piv.set(j, t)
end
func _lu_eliminate(m &: Matrix, k: int, n: int):
pk := m.at(k, k)
mut i := k + 1
until i < n:
f := m.at(i, k) / pk
m.set(i, k, f)
if f != 0.0:
mut j := k + 1
until j < n:
m.set(i, j, m.at(i, j) - f * m.at(k, j))
j += 1
end
end
i += 1
end
end
func _lu_forward(l &: Matrix, b &: Matrix, n: int):
repeat b.cols in c:
repeat n in i:
mut s := b.at(i, c)
repeat i in j: s -= l.at(i, j) * b.at(j, c) end
b.set(i, c, s)
end
end
end
func _lu_backward(u &: Matrix, b &: Matrix, n: int):
repeat b.cols in c:
mut i := n - 1
until i >= 0:
mut s := b.at(i, c)
mut j := i + 1
until j < n:
s -= u.at(i, j) * b.at(j, c)
j += 1
end
b.set(i, c, s / u.at(i, i))
i -= 1
end
end
end
func _lu_permute(f &: LU, b &: Matrix): Matrix:
mut r := Zeros(b.rows, b.cols)
repeat b.rows in i:
src := f.piv.get(i)
repeat b.cols in c: r.set(i, c, b.at(src, c)) end
end
ret r
end
func _lu_tiny(x &: Matrix): f64:
mut mx := 0.0
repeat x.count() in k:
v := math.Abs(x.a.get(k))
if v > mx: mx = v end
end
if mx == 0.0: ret MAT_EPS end
ret mx * MAT_EPS * (x.rows as f64) * 8.0
end
func _det_small(x &: Matrix): f64:
if x.rows == 1: ret x.at(0, 0) end
if x.rows == 2: ret x.at(0, 0) * x.at(1, 1) - x.at(0, 1) * x.at(1, 0) end
a := x.at(0, 0) * (x.at(1, 1) * x.at(2, 2) - x.at(1, 2) * x.at(2, 1))
b := x.at(0, 1) * (x.at(1, 0) * x.at(2, 2) - x.at(1, 2) * x.at(2, 0))
c := x.at(0, 2) * (x.at(1, 0) * x.at(2, 1) - x.at(1, 1) * x.at(2, 0))
ret a - b + c
end
func _lu_step(f &: LU, k: int, n: int, tiny: f64):
p := _lu_pivot(f.lu, k, n)
if p != k:
_lu_swap(f.lu, f.piv, k, p)
f.sign = 0 - f.sign
end
if math.Abs(f.lu.at(k, k)) <= tiny:
f.singular = true
ret
end
_lu_eliminate(f.lu, k, n)
end
func _det_from(f &: LU): f64:
mut d := f.sign as f64
repeat f.n in i: d = d * f.lu.at(i, i) end
ret d
end
func _cofactor(x &: Matrix, i: int, j: int): f64:
mut sub := Minor(x, i, j)
d := Det(sub)
defer sub.free()
if (i + j) % 2 == 1: ret 0.0 - d end
ret d
end
@en "Decompose"
@fa "تجزیه"
pub func Decompose(x &: Matrix): LU:
mut f := LU {}
if x.is_square() == false: ret f end
n := x.rows
f.n = n
f.lu = Clone(x)
repeat n in i: f.piv.push(i) end
tiny := _lu_tiny(x)
repeat n in k: _lu_step(f, k, n, tiny) end
ret f
end
@en "Det"
@fa "دترمینان"
pub func Det(x &: Matrix): f64:
if x.is_square() == false: ret 0.0 end
if x.rows == 0: ret 1.0 end
if x.rows <= 3: ret _det_small(x) end
mut f := Decompose(x)
mut d := 0.0
if f.singular == false: d = _det_from(f) end
defer f.free()
ret d
end
@en "LogAbsDet"
@fa "لگاریتم قدرمطلق دترمینان"
pub func LogAbsDet(x &: Matrix): f64:
if x.is_square() == false: ret 0.0 end
mut f := Decompose(x)
mut s := 0.0
if f.singular: s = 0.0 - MAT_INF end
if f.singular == false:
repeat f.n in i: s += math.Log(math.Abs(f.lu.at(i, i))) end
end
defer f.free()
ret s
end
@en "Solve"
@fa "حل"
pub func Solve(a &: Matrix, b &: Matrix): Matrix:
if a.is_square() == false or a.rows != b.rows: ret Zeros(0, 0) end
mut f := Decompose(a)
r := LUSolve(f, b)
defer f.free()
ret r
end
@en "LUSolve"
@fa "حل با تجزیه"
pub func LUSolve(f &: LU, b &: Matrix): Matrix:
if f.singular or f.n != b.rows: ret Zeros(0, 0) end
mut r := _lu_permute(f, b)
_lu_forward(f.lu, r, f.n)
_lu_backward(f.lu, r, f.n)
ret r
end
@en "SolveVec"
@fa "حل برداری"
pub func SolveVec(a &: Matrix, b &: Matrix): Matrix:
if b.cols != 1: ret Zeros(0, 0) end
ret Solve(a, b)
end
@en "Inverse"
@fa "وارون"
pub func Inverse(x &: Matrix): Matrix:
if x.is_square() == false: ret Zeros(0, 0) end
mut id := Eye(x.rows)
r := Solve(x, id)
defer id.free()
ret r
end
@en "Adjugate"
@fa "الحاقی"
pub func Adjugate(x &: Matrix): Matrix:
if x.is_square() == false: ret Zeros(0, 0) end
n := x.rows
mut r := Zeros(n, n)
repeat n in i:
repeat n in j: r.set(j, i, _cofactor(x, i, j)) end
end
ret r
end
package matrix
import mem
const _MAT_BLOCK := 64
const _T_BLOCK := 32
const _MR := 4
const _NR := 8
const _KC := 512
const _MC := 128
const _NC := 512
const _STRASSEN_MIN := 512
inline func _row(p: f64*, off: int): f64*:
ret (p as i64 + (off as i64) * (sizeof(f64) as i64)) as f64*
end
inline func _row64(p: f64*, off: i64): f64*:
ret (p as i64 + off * (sizeof(f64) as i64)) as f64*
end
func _min2(a: int, b: int): int:
if a < b: ret a end
ret b
end
func _mm_end(start: int, limit: int): int:
e := start + _MAT_BLOCK
if e > limit: ret limit end
ret e
end
func _mm_axpy(pr: f64*, v: f64, py: f64*, cnt: int):
repeat cnt in t: pr[t] = pr[t] + v * py[t] end
end
func _mm_tile(r &: Matrix, x &: Matrix, y &: Matrix, ii: int, kk: int, jj: int):
i1 := _mm_end(ii, r.rows)
k1 := _mm_end(kk, x.cols)
j1 := _mm_end(jj, r.cols)
pr := r.a.data
px := x.a.data
py := y.a.data
rc := r.cols
xc := x.cols
yc := y.cols
cnt := j1 - jj
mut i := ii
until i < i1:
xo := i * xc
rrow := _row(pr, i * rc + jj)
mut k := kk
until k < k1:
v := px[xo + k]
if v != 0.0: _mm_axpy(rrow, v, _row(py, k * yc + jj), cnt) end
k += 1
end
i += 1
end
end
func _mm_pack_a(px: f64*, xc: int, i0: int, k0: int, kc: int, dst: f64*):
a0 := _row(px, i0 * xc + k0)
a1 := _row(px, (i0 + 1) * xc + k0)
a2 := _row(px, (i0 + 2) * xc + k0)
a3 := _row(px, (i0 + 3) * xc + k0)
repeat kc in k:
d := _row(dst, k * _MR)
d[0] = a0[k]
d[1] = a1[k]
d[2] = a2[k]
d[3] = a3[k]
end
end
func _mm_pack_b(py: f64*, yc: int, k0: int, k1: int, j0: int, dst: f64*):
mut k := k0
mut o := 0
until k < k1:
src := _row(py, k * yc + j0)
d := _row(dst, o)
repeat _NR in t: d[t] = src[t] end
o += _NR
k += 1
end
end
func _mm_micro(pa: f64*, pb: f64*, kn: i64, c0: f64*, c1: f64*, c2: f64*, c3: f64*):
mut c00 := c0[0]
mut c01 := c0[1]
mut c02 := c0[2]
mut c03 := c0[3]
mut c04 := c0[4]
mut c05 := c0[5]
mut c06 := c0[6]
mut c07 := c0[7]
mut c10 := c1[0]
mut c11 := c1[1]
mut c12 := c1[2]
mut c13 := c1[3]
mut c14 := c1[4]
mut c15 := c1[5]
mut c16 := c1[6]
mut c17 := c1[7]
mut c20 := c2[0]
mut c21 := c2[1]
mut c22 := c2[2]
mut c23 := c2[3]
mut c24 := c2[4]
mut c25 := c2[5]
mut c26 := c2[6]
mut c27 := c2[7]
mut c30 := c3[0]
mut c31 := c3[1]
mut c32 := c3[2]
mut c33 := c3[3]
mut c34 := c3[4]
mut c35 := c3[5]
mut c36 := c3[6]
mut c37 := c3[7]
repeat kn in k:
pak := _row64(pa, k * (_MR as i64))
pbk := _row64(pb, k * (_NR as i64))
b0 := pbk[0]
b1 := pbk[1]
b2 := pbk[2]
b3 := pbk[3]
b4 := pbk[4]
b5 := pbk[5]
b6 := pbk[6]
b7 := pbk[7]
v0 := pak[0]
c00 += v0 * b0
c01 += v0 * b1
c02 += v0 * b2
c03 += v0 * b3
c04 += v0 * b4
c05 += v0 * b5
c06 += v0 * b6
c07 += v0 * b7
v1 := pak[1]
c10 += v1 * b0
c11 += v1 * b1
c12 += v1 * b2
c13 += v1 * b3
c14 += v1 * b4
c15 += v1 * b5
c16 += v1 * b6
c17 += v1 * b7
v2 := pak[2]
c20 += v2 * b0
c21 += v2 * b1
c22 += v2 * b2
c23 += v2 * b3
c24 += v2 * b4
c25 += v2 * b5
c26 += v2 * b6
c27 += v2 * b7
v3 := pak[3]
c30 += v3 * b0
c31 += v3 * b1
c32 += v3 * b2
c33 += v3 * b3
c34 += v3 * b4
c35 += v3 * b5
c36 += v3 * b6
c37 += v3 * b7
end
c0[0] = c00
c0[1] = c01
c0[2] = c02
c0[3] = c03
c0[4] = c04
c0[5] = c05
c0[6] = c06
c0[7] = c07
c1[0] = c10
c1[1] = c11
c1[2] = c12
c1[3] = c13
c1[4] = c14
c1[5] = c15
c1[6] = c16
c1[7] = c17
c2[0] = c20
c2[1] = c21
c2[2] = c22
c2[3] = c23
c2[4] = c24
c2[5] = c25
c2[6] = c26
c2[7] = c27
c3[0] = c30
c3[1] = c31
c3[2] = c32
c3[3] = c33
c3[4] = c34
c3[5] = c35
c3[6] = c36
c3[7] = c37
end
func _mm_edge(pr: f64*, rc: int, px: f64*, xc: int, py: f64*, yc: int, i0: int, i1: int, j0: int, j1: int, kn: int):
mut i := i0
until i < i1:
xrow := _row(px, i * xc)
crow := _row(pr, i * rc)
mut j := j0
until j < j1:
mut acc := 0.0
repeat kn in k: acc += xrow[k] * py[k * yc + j] end
crow[j] = acc
j += 1
end
i += 1
end
end
func _mm_cols(r &: Matrix, x &: Matrix, y &: Matrix, ii: int, kk: int):
mut jj := 0
until jj < r.cols:
_mm_tile(r, x, y, ii, kk, jj)
jj += _MAT_BLOCK
end
end
func _dot_rows(x &: Matrix, xr: int, y &: Matrix, yr: int, n: int): f64:
mut s := 0.0
repeat n in k: s += x.at(xr, k) * y.at(yr, k) end
ret s
end
func _kron_block(r &: Matrix, s: f64, y &: Matrix, r0: int, c0: int):
repeat y.rows in p:
repeat y.cols in q: r.set(r0 + p, c0 + q, s * y.at(p, q)) end
end
end
func _matpow_neg(x &: Matrix, k: int): Matrix:
mut inv := Inverse(x)
if inv.is_empty(): ret Zeros(0, 0) end
r := MatPow(inv, 0 - k)
defer inv.free()
ret r
end
func _blk_op(x &: Matrix, r0: int, c0: int, y &: Matrix, r1: int, c1: int, sub: bool, dst &: Matrix):
px := x.a.data
py := y.a.data
pd := dst.a.data
w := dst.cols
repeat dst.rows in i:
a := _row(px, (r0 + i) * x.cols + c0)
b := _row(py, (r1 + i) * y.cols + c1)
d := _row(pd, i * w)
if sub:
repeat w in j: d[j] = a[j] - b[j] end
else:
repeat w in j: d[j] = a[j] + b[j] end
end
end
end
func _blk_copy(x &: Matrix, r0: int, c0: int, dst &: Matrix):
px := x.a.data
pd := dst.a.data
w := dst.cols
repeat dst.rows in i:
a := _row(px, (r0 + i) * x.cols + c0)
d := _row(pd, i * w)
repeat w in j: d[j] = a[j] end
end
end
func _blk_acc(r &: Matrix, r0: int, c0: int, src &: Matrix, neg: bool):
pr := r.a.data
ps := src.a.data
w := src.cols
repeat src.rows in i:
d := _row(pr, (r0 + i) * r.cols + c0)
t := _row(ps, i * w)
if neg:
repeat w in j: d[j] = d[j] - t[j] end
else:
repeat w in j: d[j] = d[j] + t[j] end
end
end
end
func _zero_into(m &: Matrix):
p := m.a.data
n := m.rows * m.cols
repeat n in i: p[i] = 0.0 end
end
func _strassen(x &: Matrix, y &: Matrix, r &: Matrix):
h := x.rows / 2
k := x.cols / 2
w := y.cols / 2
mut ta := _raw(h, k)
mut tb := _raw(k, w)
mut m := Zeros(h, w)
_blk_op(x, 0, 0, x, h, k, false, ta)
_blk_op(y, 0, 0, y, k, w, false, tb)
_matmul_pick(ta, tb, m)
_blk_acc(r, 0, 0, m, false)
_blk_acc(r, h, w, m, false)
_zero_into(m)
_blk_op(x, h, 0, x, h, k, false, ta)
_blk_copy(y, 0, 0, tb)
_matmul_pick(ta, tb, m)
_blk_acc(r, h, 0, m, false)
_blk_acc(r, h, w, m, true)
_zero_into(m)
_blk_copy(x, 0, 0, ta)
_blk_op(y, 0, w, y, k, w, true, tb)
_matmul_pick(ta, tb, m)
_blk_acc(r, 0, w, m, false)
_blk_acc(r, h, w, m, false)
_zero_into(m)
_blk_copy(x, h, k, ta)
_blk_op(y, k, 0, y, 0, 0, true, tb)
_matmul_pick(ta, tb, m)
_blk_acc(r, 0, 0, m, false)
_blk_acc(r, h, 0, m, false)
_zero_into(m)
_blk_op(x, 0, 0, x, 0, k, false, ta)
_blk_copy(y, k, w, tb)
_matmul_pick(ta, tb, m)
_blk_acc(r, 0, 0, m, true)
_blk_acc(r, 0, w, m, false)
_zero_into(m)
_blk_op(x, h, 0, x, 0, 0, true, ta)
_blk_op(y, 0, 0, y, 0, w, false, tb)
_matmul_pick(ta, tb, m)
_blk_acc(r, h, w, m, false)
_zero_into(m)
_blk_op(x, 0, k, x, h, k, true, ta)
_blk_op(y, k, 0, y, k, w, false, tb)
_matmul_pick(ta, tb, m)
_blk_acc(r, 0, 0, m, false)
ta.free()
tb.free()
m.free()
end
if SALAM_JS:
func _matmul_pick(x &: Matrix, y &: Matrix, r &: Matrix):
n := x.rows
kn := x.cols
m := y.cols
px := x.a.data
py := y.a.data
pr := r.a.data
repeat n in i:
repeat m in j:
mut acc := 0.0
repeat kn in k:
acc += px[i * kn + k] * py[k * m + j]
end
pr[i * m + j] = acc
end
end
end
else:
func _matmul_pick(x &: Matrix, y &: Matrix, r &: Matrix):
if x.rows >= _STRASSEN_MIN and x.cols >= _STRASSEN_MIN and y.cols >= _STRASSEN_MIN:
if (x.rows % 2) == 0 and (x.cols % 2) == 0 and (y.cols % 2) == 0:
_strassen(x, y, r)
ret
end
end
_matmul_into(x, y, r)
end
end
func _matmul_into(x &: Matrix, y &: Matrix, r &: Matrix):
n := x.rows
kn := x.cols
m := y.cols
if n <= 0 or m <= 0 or kn <= 0: ret end
px := x.a.data
py := y.a.data
pr := r.a.data
xc := x.cols
yc := y.cols
rc := m
nfull := (n / _MR) * _MR
mfull := (m / _NR) * _NR
if nfull == 0 or mfull == 0:
_mm_edge(pr, rc, px, xc, py, yc, nfull, n, 0, mfull, kn)
_mm_edge(pr, rc, px, xc, py, yc, 0, n, mfull, m, kn)
ret
end
kcap := _min2(_KC, kn)
bpack := mem.Allocate(((_min2(_NC, mfull) * kcap) as u64) * (sizeof(f64) as u64)) as f64*
defer mem.Free(bpack as void*)
apack := mem.Allocate(((_min2((_MC / _MR) * _MR, nfull) * kcap) as u64) * (sizeof(f64) as u64)) as f64*
defer mem.Free(apack as void*)
mut j0 := 0
until j0 < mfull:
nc := _min2(_NC, mfull - j0)
ncblk := nc / _NR
mut p0 := 0
until p0 < kn:
kc := _min2(_KC, kn - p0)
repeat ncblk in jb:
_mm_pack_b(py, yc, p0, p0 + kc, j0 + jb * _NR, _row(bpack, jb * kc * _NR))
end
mut i0 := 0
until i0 < nfull:
mcap := (_MC / _MR) * _MR
ic := _min2(mcap, nfull - i0)
mut ip := 0
until ip < ic:
_mm_pack_a(px, xc, i0 + ip, p0, kc, _row(apack, ip * kc))
ip += _MR
end
repeat ncblk in jb:
j := j0 + jb * _NR
bp := _row(bpack, jb * kc * _NR)
mut ii := 0
until ii < ic:
i := i0 + ii
_mm_micro(
_row(apack, ii * kc), bp, kc as i64, _row(pr, i * rc + j), _row(pr, (i + 1) * rc + j), _row(pr, (i + 2) * rc + j),
_row(pr, (i + 3) * rc + j)
)
ii += _MR
end
end
i0 += _MC
end
p0 += _KC
end
j0 += _NC
end
_mm_edge(pr, rc, px, xc, py, yc, nfull, n, 0, mfull, kn)
_mm_edge(pr, rc, px, xc, py, yc, 0, n, mfull, m, kn)
end
func _transpose_into(x &: Matrix, r &: Matrix):
n := x.rows
m := x.cols
if n <= 0 or m <= 0: ret end
px := x.a.data
pr := r.a.data
mut i0 := 0
until i0 < n:
i1 := _min2(i0 + _T_BLOCK, n)
mut j0 := 0
until j0 < m:
j1 := _min2(j0 + _T_BLOCK, m)
mut i := i0
until i < i1:
xo := i * m
mut j := j0
until j < j1:
pr[j * n + i] = px[xo + j]
j += 1
end
i += 1
end
j0 += _T_BLOCK
end
i0 += _T_BLOCK
end
end
@en "Transpose"
@fa "ترانهاده"
pub func Transpose(x &: Matrix): Matrix:
r := _raw(x.cols, x.rows)
_transpose_into(x, r)
ret r
end
@en "MatMul"
@fa "ضرب ماتریسی"
pub func MatMul(x &: Matrix, y &: Matrix): Matrix:
if x.cols != y.rows: ret Zeros(0, 0) end
r := Zeros(x.rows, y.cols)
_matmul_pick(x, y, r)
ret r
end
@en "TransposeInto"
@fa "ترانهاده در"
pub func TransposeInto(x &: Matrix, out &: Matrix): bool:
if out.rows != x.cols or out.cols != x.rows: ret false end
_transpose_into(x, out)
ret true
end
@en "MatMulInto"
@fa "ضرب ماتریسی در"
pub func MatMulInto(x &: Matrix, y &: Matrix, out &: Matrix): bool:
if x.cols != y.rows: ret false end
if out.rows != x.rows or out.cols != y.cols: ret false end
pz := out.a.data
repeat out.rows * out.cols in i:
pz[i] = 0.0
end
_matmul_pick(x, y, out)
ret true
end
@en "TransposeMul"
@fa "ضرب ترانهاده"
pub func TransposeMul(x &: Matrix, y &: Matrix): Matrix:
if x.rows != y.rows: ret Zeros(0, 0) end
mut t := Transpose(x)
r := MatMul(t, y)
defer t.free()
ret r
end
@en "MulTranspose"
@fa "ضرب در ترانهاده"
pub func MulTranspose(x &: Matrix, y &: Matrix): Matrix:
if x.cols != y.cols: ret Zeros(0, 0) end
mut r := Zeros(x.rows, y.rows)
repeat x.rows in i:
repeat y.rows in j: r.set(i, j, _dot_rows(x, i, y, j, x.cols)) end
end
ret r
end
@en "Gram"
@fa "گرام"
pub func Gram(x &: Matrix): Matrix:
mut t := Transpose(x)
mut r := Zeros(x.cols, x.cols)
repeat x.cols in i:
mut j := i
until j < x.cols:
v := _dot_rows(t, i, t, j, x.rows)
r.set(i, j, v)
r.set(j, i, v)
j += 1
end
end
defer t.free()
ret r
end
@en "MatVec"
@fa "ضرب در بردار"
pub func MatVec(a &: Matrix, x &: Matrix): Matrix:
if x.cols != 1 or a.cols != x.rows: ret Zeros(0, 0) end
mut r := Zeros(a.rows, 1)
repeat a.rows in i:
mut s := 0.0
repeat a.cols in j: s += a.at(i, j) * x.at(j, 0) end
r.set(i, 0, s)
end
ret r
end
@en "VecMat"
@fa "ضرب بردار در ماتریس"
pub func VecMat(x &: Matrix, a &: Matrix): Matrix:
if x.rows != 1 or x.cols != a.rows: ret Zeros(0, 0) end
mut r := Zeros(1, a.cols)
repeat a.rows in k:
v := x.at(0, k)
if v != 0.0:
repeat a.cols in j: r.add_at(0, j, v * a.at(k, j)) end
end
end
ret r
end
@en "Dot"
@fa "ضرب داخلی"
pub func Dot(x &: Matrix, y &: Matrix): f64:
if x.count() != y.count(): ret 0.0 end
mut s := 0.0
repeat x.count() in k: s += x.a.get(k) * y.a.get(k) end
ret s
end
@en "Outer"
@fa "ضرب خارجی"
pub func Outer(u &: Matrix, v &: Matrix): Matrix:
m := u.count()
n := v.count()
mut r := Zeros(m, n)
repeat m in i:
ui := u.a.get(i)
repeat n in j: r.set(i, j, ui * v.a.get(j)) end
end
ret r
end
@en "Kron"
@fa "ضرب کرونکر"
pub func Kron(x &: Matrix, y &: Matrix): Matrix:
mut r := Zeros(x.rows * y.rows, x.cols * y.cols)
repeat x.rows in i:
repeat x.cols in j:
_kron_block(r, x.at(i, j), y, i * y.rows, j * y.cols)
end
end
ret r
end
@en "MatPow"
@fa "توان ماتریس"
pub func MatPow(x &: Matrix, k: int): Matrix:
if x.is_square() == false: ret Zeros(0, 0) end
if k < 0: ret _matpow_neg(x, k) end
mut acc := Eye(x.rows)
mut base := Clone(x)
mut e := k
until e > 0:
if e % 2 == 1:
t := MatMul(acc, base)
acc.free()
acc = t
end
e = e / 2
if e > 0:
s := MatMul(base, base)
base.free()
base = s
end
end
defer base.free()
ret acc
end
@en "Trace"
@fa "رد"
pub func Trace(x &: Matrix): f64:
mut s := 0.0
repeat x.min_dim() in i: s += x.at(i, i) end
ret s
end
@en "Cross3"
@fa "ضرب برداری"
pub func Cross3(u &: Matrix, v &: Matrix): Matrix:
if u.count() != 3 or v.count() != 3: ret Zeros(0, 0) end
mut r := Zeros(u.rows, u.cols)
r.a.set(0, u.a.get(1) * v.a.get(2) - u.a.get(2) * v.a.get(1))
r.a.set(1, u.a.get(2) * v.a.get(0) - u.a.get(0) * v.a.get(2))
r.a.set(2, u.a.get(0) * v.a.get(1) - u.a.get(1) * v.a.get(0))
ret r
end
package matrix
import math
func _abs_max(x &: Matrix): f64:
mut m := 0.0
repeat x.count() in k:
v := math.Abs(x.a.get(k))
if v > m: m = v end
end
ret m
end
func _scaled_sumsq(x &: Matrix, scale: f64): f64:
mut s := 0.0
repeat x.count() in k:
t := x.a.get(k) / scale
s += t * t
end
ret s
end
func _col_abs_sum(x &: Matrix, j: int): f64:
mut s := 0.0
repeat x.rows in i: s += math.Abs(x.at(i, j)) end
ret s
end
func _row_abs_sum(x &: Matrix, i: int): f64:
mut s := 0.0
repeat x.cols in j: s += math.Abs(x.at(i, j)) end
ret s
end
func _unit_row(r &: Matrix, i: int):
mut s := 0.0
repeat r.cols in j: s += r.at(i, j) * r.at(i, j) end
if s <= 0.0: ret end
inv := 1.0 / math.Sqrt(s)
repeat r.cols in j: r.mul_at(i, j, inv) end
end
func _unit_col(r &: Matrix, j: int):
mut s := 0.0
repeat r.rows in i: s += r.at(i, j) * r.at(i, j) end
if s <= 0.0: ret end
inv := 1.0 / math.Sqrt(s)
repeat r.rows in i: r.mul_at(i, j, inv) end
end
@en "NormFrobenius"
@fa "نرم فروبنیوس"
pub func NormFrobenius(x &: Matrix): f64:
m := _abs_max(x)
if m == 0.0: ret 0.0 end
ret m * math.Sqrt(_scaled_sumsq(x, m))
end
@en "Norm1"
@fa "نرم یک"
pub func Norm1(x &: Matrix): f64:
mut b := 0.0
repeat x.cols in j:
s := _col_abs_sum(x, j)
if s > b: b = s end
end
ret b
end
@en "NormInf"
@fa "نرم بی‌نهایت"
pub func NormInf(x &: Matrix): f64:
mut b := 0.0
repeat x.rows in i:
s := _row_abs_sum(x, i)
if s > b: b = s end
end
ret b
end
@en "NormMax"
@fa "نرم بیشینه"
pub func NormMax(x &: Matrix): f64: ret _abs_max(x) end
@en "Norm2"
@fa "نرم دو"
pub func Norm2(x &: Matrix): f64:
mut s := SingularValues(x)
mut v := 0.0
if s.count() > 0: v = s.a.get(0) end
defer s.free()
ret v
end
@en "NormNuclear"
@fa "نرم هسته‌ای"
pub func NormNuclear(x &: Matrix): f64:
mut s := SingularValues(x)
mut t := 0.0
repeat s.count() in k: t += s.a.get(k) end
defer s.free()
ret t
end
@en "VecNorm"
@fa "نرم بردار"
pub func VecNorm(x &: Matrix, p: f64): f64:
if p <= 0.0: ret _abs_max(x) end
if p == 2.0: ret NormFrobenius(x) end
m := _abs_max(x)
if m == 0.0: ret 0.0 end
mut s := 0.0
repeat x.count() in k: s += math.Pow(math.Abs(x.a.get(k)) / m, p) end
ret m * math.Pow(s, 1.0 / p)
end
@en "Distance"
@fa "فاصله"
pub func Distance(x &: Matrix, y &: Matrix): f64:
if x.same_shape(y) == false: ret 0.0 end
mut d := Sub(x, y)
v := NormFrobenius(d)
defer d.free()
ret v
end
@en "Normalize"
@fa "بهنجارسازی"
pub func Normalize(x &: Matrix): Matrix:
n := NormFrobenius(x)
if n == 0.0: ret Clone(x) end
ret Scale(x, 1.0 / n)
end
@en "NormalizeRows"
@fa "بهنجارسازی سطرها"
pub func NormalizeRows(x &: Matrix): Matrix:
mut r := Clone(x)
repeat x.rows in i: _unit_row(r, i) end
ret r
end
@en "NormalizeCols"
@fa "بهنجارسازی ستون‌ها"
pub func NormalizeCols(x &: Matrix): Matrix:
mut r := Clone(x)
repeat x.cols in j: _unit_col(r, j) end
ret r
end
@en "Cond1"
@fa "شرط یک"
pub func Cond1(x &: Matrix): f64:
mut inv := Inverse(x)
if inv.is_empty(): ret MAT_INF end
c := Norm1(x) * Norm1(inv)
defer inv.free()
ret c
end
@en "CondInf"
@fa "شرط بی‌نهایت"
pub func CondInf(x &: Matrix): f64:
mut inv := Inverse(x)
if inv.is_empty(): ret MAT_INF end
c := NormInf(x) * NormInf(inv)
defer inv.free()
ret c
end
@en "Cond2"
@fa "شرط دو"
pub func Cond2(x &: Matrix): f64:
mut s := SingularValues(x)
n := s.count()
if n == 0:
s.free()
ret MAT_INF
end
hi := s.a.get(0)
lo := s.a.get(n - 1)
defer s.free()
if lo <= 0.0: ret MAT_INF end
ret hi / lo
end
package matrix
import math
func _scale_of(x &: Matrix): f64:
mut m := 0.0
repeat x.count() in k:
v := math.Abs(x.a.get(k))
if v > m: m = v end
end
if m == 0.0: ret 1.0 end
ret m
end
func _close(a: f64, b: f64, tol: f64): bool: ret math.Abs(a - b) <= tol end
func _banded(x &: Matrix, lo: int, hi: int, tol: f64): bool:
repeat x.rows in i:
repeat x.cols in j:
d := j - i
if d < 0 - lo or d > hi:
if math.Abs(x.at(i, j)) > tol: ret false end
end
end
end
ret true
end
func _row_sum_is(x &: Matrix, i: int, want: f64, tol: f64): bool:
mut s := 0.0
repeat x.cols in j: s += x.at(i, j) end
ret _close(s, want, tol)
end
func _col_sum_is(x &: Matrix, j: int, want: f64, tol: f64): bool:
mut s := 0.0
repeat x.rows in i: s += x.at(i, j) end
ret _close(s, want, tol)
end
func _nonnegative(x &: Matrix): bool:
repeat x.count() in k:
if x.a.get(k) < 0.0: ret false end
end
ret true
end
func _product_matches(p &: Matrix, target &: Matrix, tol: f64): bool:
if p.same_shape(target) == false: ret false end
repeat p.count() in k:
if math.Abs(p.a.get(k) - target.a.get(k)) > tol: ret false end
end
ret true
end
func _binary_entries(x &: Matrix, tol: f64): bool:
repeat x.count() in k:
v := x.a.get(k)
if _close(v, 0.0, tol) == false and _close(v, 1.0, tol) == false:
ret false
end
end
ret true
end
@en "IsSquare"
@fa "مربع است"
pub func IsSquare(x &: Matrix): bool: ret x.is_square() end
@en "AllClose"
@fa "همه نزدیک"
pub func AllClose(x &: Matrix, y &: Matrix, tol: f64): bool:
if x.same_shape(y) == false: ret false end
s := _scale_of(x)
repeat x.count() in k:
if math.Abs(x.a.get(k) - y.a.get(k)) > tol * s: ret false end
end
ret true
end
@en "IsZero"
@fa "صفر است"
pub func IsZero(x &: Matrix, tol: f64): bool:
repeat x.count() in k:
if math.Abs(x.a.get(k)) > tol: ret false end
end
ret true
end
@en "IsIdentity"
@fa "همانی است"
pub func IsIdentity(x &: Matrix, tol: f64): bool:
if x.is_square() == false: ret false end
repeat x.rows in i:
repeat x.cols in j:
mut want := 0.0
if i == j: want = 1.0 end
if _close(x.at(i, j), want, tol) == false: ret false end
end
end
ret true
end
@en "IsSymmetric"
@fa "متقارن است"
pub func IsSymmetric(x &: Matrix, tol: f64): bool:
if x.is_square() == false: ret false end
t := tol * _scale_of(x)
repeat x.rows in i:
mut j := i + 1
until j < x.cols:
if _close(x.at(i, j), x.at(j, i), t) == false: ret false end
j += 1
end
end
ret true
end
@en "IsSkewSymmetric"
@fa "پادمتقارن است"
pub func IsSkewSymmetric(x &: Matrix, tol: f64): bool:
if x.is_square() == false: ret false end
t := tol * _scale_of(x)
repeat x.rows in i:
repeat x.cols in j:
if _close(x.at(i, j), 0.0 - x.at(j, i), t) == false: ret false end
end
end
ret true
end
@en "IsDiagonal"
@fa "قطری است"
pub func IsDiagonal(x &: Matrix, tol: f64): bool:
ret _banded(x, 0, 0, tol * _scale_of(x))
end
@en "IsUpperTriangular"
@fa "بالامثلثی است"
pub func IsUpperTriangular(x &: Matrix, tol: f64): bool:
ret _banded(x, 0, x.cols, tol * _scale_of(x))
end
@en "IsLowerTriangular"
@fa "پایین‌مثلثی است"
pub func IsLowerTriangular(x &: Matrix, tol: f64): bool:
ret _banded(x, x.rows, 0, tol * _scale_of(x))
end
@en "IsBanded"
@fa "نواری است"
pub func IsBanded(x &: Matrix, lower: int, upper: int, tol: f64): bool:
ret _banded(x, lower, upper, tol * _scale_of(x))
end
@en "LowerBandwidth"
@fa "پهنای نوار پایین"
pub func LowerBandwidth(x &: Matrix, tol: f64): int:
t := tol * _scale_of(x)
mut b := 0
repeat x.rows in i:
repeat x.cols in j:
if i - j > b and math.Abs(x.at(i, j)) > t: b = i - j end
end
end
ret b
end
@en "UpperBandwidth"
@fa "پهنای نوار بالا"
pub func UpperBandwidth(x &: Matrix, tol: f64): int:
t := tol * _scale_of(x)
mut b := 0
repeat x.rows in i:
repeat x.cols in j:
if j - i > b and math.Abs(x.at(i, j)) > t: b = j - i end
end
end
ret b
end
@en "IsOrthogonal"
@fa "متعامد است"
pub func IsOrthogonal(x &: Matrix, tol: f64): bool:
mut g := Gram(x)
mut id := Eye(x.cols)
ok := _product_matches(g, id, tol)
defer g.free()
defer id.free()
ret ok
end
@en "IsNormal"
@fa "نرمال است"
pub func IsNormal(x &: Matrix, tol: f64): bool:
if x.is_square() == false: ret false end
mut aat := MulTranspose(x, x)
mut ata := TransposeMul(x, x)
ok := _product_matches(aat, ata, tol * _scale_of(x))
defer aat.free()
defer ata.free()
ret ok
end
@en "IsIdempotent"
@fa "خودتوان است"
pub func IsIdempotent(x &: Matrix, tol: f64): bool:
if x.is_square() == false: ret false end
mut p := MatMul(x, x)
ok := _product_matches(p, x, tol * _scale_of(x))
defer p.free()
ret ok
end
@en "IsInvolutory"
@fa "خودوارون است"
pub func IsInvolutory(x &: Matrix, tol: f64): bool:
if x.is_square() == false: ret false end
mut p := MatMul(x, x)
mut id := Eye(x.rows)
ok := _product_matches(p, id, tol)
defer p.free()
defer id.free()
ret ok
end
@en "IsNilpotent"
@fa "پوچ‌توان است"
pub func IsNilpotent(x &: Matrix, tol: f64): bool:
if x.is_square() == false: ret false end
mut p := MatPow(x, x.rows)
ok := IsZero(p, tol * _scale_of(x))
defer p.free()
ret ok
end
@en "IsPositiveDefinite"
@fa "معین مثبت است"
pub func IsPositiveDefinite(x &: Matrix, tol: f64): bool:
if IsSymmetric(x, tol) == false: ret false end
mut l := Cholesky(x)
ok := l.is_empty() == false
defer l.free()
ret ok
end
@en "IsPositiveSemiDefinite"
@fa "نیمه‌معین مثبت است"
pub func IsPositiveSemiDefinite(x &: Matrix, tol: f64): bool:
if IsSymmetric(x, tol) == false: ret false end
mut v := EigValsSym(x)
cut := 0.0 - tol * _scale_of(x)
mut ok := true
repeat v.count() in k:
if v.a.get(k) < cut: ok = false end
end
defer v.free()
ret ok
end
@en "IsSingular"
@fa "تکین است"
pub func IsSingular(x &: Matrix): bool:
if x.is_square() == false: ret true end
ret MatrixRank(x, 0.0) < x.rows
end
@en "IsInvertible"
@fa "وارون‌پذیر است"
pub func IsInvertible(x &: Matrix): bool: ret IsSingular(x) == false end
@en "IsRowStochastic"
@fa "تصادفی سطری است"
pub func IsRowStochastic(x &: Matrix, tol: f64): bool:
if _nonnegative(x) == false: ret false end
repeat x.rows in i:
if _row_sum_is(x, i, 1.0, tol) == false: ret false end
end
ret true
end
@en "IsColStochastic"
@fa "تصادفی ستونی است"
pub func IsColStochastic(x &: Matrix, tol: f64): bool:
if _nonnegative(x) == false: ret false end
repeat x.cols in j:
if _col_sum_is(x, j, 1.0, tol) == false: ret false end
end
ret true
end
@en "IsDoublyStochastic"
@fa "تصادفی دوگانه است"
pub func IsDoublyStochastic(x &: Matrix, tol: f64): bool:
if IsRowStochastic(x, tol) == false: ret false end
ret IsColStochastic(x, tol)
end
@en "IsPermutation"
@fa "جایگشتی است"
pub func IsPermutation(x &: Matrix, tol: f64): bool:
if x.is_square() == false: ret false end
if _binary_entries(x, tol) == false: ret false end
ret IsDoublyStochastic(x, tol)
end
@en "IsToeplitz"
@fa "توپلیتز است"
pub func IsToeplitz(x &: Matrix, tol: f64): bool:
t := tol * _scale_of(x)
mut i := 1
until i < x.rows:
mut j := 1
until j < x.cols:
if _close(x.at(i, j), x.at(i - 1, j - 1), t) == false: ret false end
j += 1
end
i += 1
end
ret true
end
@en "IsHankel"
@fa "هنکل است"
pub func IsHankel(x &: Matrix, tol: f64): bool:
t := tol * _scale_of(x)
mut i := 1
until i < x.rows:
mut j := 0
until j < x.cols - 1:
if _close(x.at(i, j), x.at(i - 1, j + 1), t) == false: ret false end
j += 1
end
i += 1
end
ret true
end
@en "Density"
@fa "چگالی"
pub func Density(x &: Matrix): f64:
if x.count() == 0: ret 0.0 end
ret (CountNonZero(x) as f64) / (x.count() as f64)
end
package matrix
import math
@en "QR"
@fa "کیوآر"
pub struct QR:
pub m: int = 0
pub n: int = 0
pub qr: Matrix = Matrix {}
pub rdiag: Matrix = Matrix {}
pub full_rank: bool = true
@en "free"
@fa "آزادسازی"
pub func free():
this.qr.free()
this.rdiag.free()
end
end
func _house_norm(a &: Matrix, k: int, m: int): f64:
mut scale := 0.0
mut i := k
until i < m:
v := math.Abs(a.at(i, k))
if v > scale: scale = v end
i += 1
end
if scale == 0.0: ret 0.0 end
mut s := 0.0
mut j := k
until j < m:
t := a.at(j, k) / scale
s += t * t
j += 1
end
ret scale * math.Sqrt(s)
end
func _house_apply(a &: Matrix, k: int, j: int, m: int):
mut s := 0.0
mut i := k
until i < m:
s += a.at(i, k) * a.at(i, j)
i += 1
end
if a.at(k, k) == 0.0: ret end
f := 0.0 - s / a.at(k, k)
mut p := k
until p < m:
a.add_at(p, j, f * a.at(p, k))
p += 1
end
end
func _house_step(f &: QR, k: int):
mut nrm := _house_norm(f.qr, k, f.m)
if nrm != 0.0:
if f.qr.at(k, k) < 0.0: nrm = 0.0 - nrm end
mut i := k
until i < f.m:
f.qr.set(i, k, f.qr.at(i, k) / nrm)
i += 1
end
f.qr.add_at(k, k, 1.0)
mut j := k + 1
until j < f.n:
_house_apply(f.qr, k, j, f.m)
j += 1
end
end
f.rdiag.set(0, k, 0.0 - nrm)
if nrm == 0.0: f.full_rank = false end
end
func _qt_apply(f &: QR, b &: Matrix):
repeat f.n in k:
repeat b.cols in c: _qt_col(f, b, k, c) end
end
end
func _qt_col(f &: QR, b &: Matrix, k: int, c: int):
mut s := 0.0
mut i := k
until i < f.m:
s += f.qr.at(i, k) * b.at(i, c)
i += 1
end
if f.qr.at(k, k) == 0.0: ret end
t := 0.0 - s / f.qr.at(k, k)
mut p := k
until p < f.m:
b.add_at(p, c, t * f.qr.at(p, k))
p += 1
end
end
func _r_backsolve(f &: QR, b &: Matrix):
repeat b.cols in c:
mut k := f.n - 1
until k >= 0:
mut s := b.at(k, c)
mut j := k + 1
until j < f.n:
s -= f.qr.at(k, j) * b.at(j, c)
j += 1
end
b.set(k, c, s / f.rdiag.at(0, k))
k -= 1
end
end
end
func _q_expand(f &: QR, q &: Matrix, k: int, j: int):
if f.qr.at(k, k) == 0.0: ret end
mut s := 0.0
mut i := k
until i < f.m:
s += f.qr.at(i, k) * q.at(i, j)
i += 1
end
t := 0.0 - s / f.qr.at(k, k)
mut p := k
until p < f.m:
q.add_at(p, j, t * f.qr.at(p, k))
p += 1
end
end
func _mgs_column(w &: Matrix, cols &: Vector<int>, j: int):
before := _col_length(w, j)
repeat cols.len() in t:
b := cols.get(t)
mut d := 0.0
repeat w.rows in i: d += w.at(i, b) * w.at(i, j) end
repeat w.rows in i: w.add_at(i, j, 0.0 - d * w.at(i, b)) end
end
nrm := _col_length(w, j)
if nrm <= before * MAT_EPS * (w.rows as f64) * 8.0: ret end
repeat w.rows in i: w.set(i, j, w.at(i, j) / nrm) end
cols.push(j)
end
func _col_length(w &: Matrix, j: int): f64:
mut s := 0.0
repeat w.rows in i: s += w.at(i, j) * w.at(i, j) end
ret math.Sqrt(s)
end
func _pack_cols(w &: Matrix, cols &: Vector<int>): Matrix:
mut r := Zeros(w.rows, cols.len())
repeat cols.len() in c:
j := cols.get(c)
repeat w.rows in i: r.set(i, c, w.at(i, j)) end
end
ret r
end
@en "QRDecompose"
@fa "تجزیه کیوآر"
pub func QRDecompose(x &: Matrix): QR:
mut f := QR {}
if x.is_empty(): ret f end
f.m = x.rows
f.n = x.cols
f.qr = Clone(x)
f.rdiag = Zeros(1, x.cols)
repeat x.cols in k: _house_step(f, k) end
ret f
end
@en "QRGetQ"
@fa "کیو"
pub func QRGetQ(f &: QR): Matrix:
mut q := Zeros(f.m, f.n)
mut k := f.n - 1
until k >= 0:
q.set(k, k, 1.0)
mut j := k
until j < f.n:
_q_expand(f, q, k, j)
j += 1
end
k -= 1
end
ret q
end
@en "QRGetR"
@fa "آر"
pub func QRGetR(f &: QR): Matrix:
mut r := Zeros(f.n, f.n)
repeat f.n in i:
r.set(i, i, f.rdiag.at(0, i))
mut j := i + 1
until j < f.n:
r.set(i, j, f.qr.at(i, j))
j += 1
end
end
ret r
end
@en "LeastSquares"
@fa "کمترین مربعات"
pub func LeastSquares(a &: Matrix, b &: Matrix): Matrix:
if a.rows != b.rows or a.rows < a.cols: ret Zeros(0, 0) end
mut f := QRDecompose(a)
r := QRSolve(f, b)
defer f.free()
ret r
end
@en "QRSolve"
@fa "حل کیوآر"
pub func QRSolve(f &: QR, b &: Matrix): Matrix:
if f.full_rank == false or f.m != b.rows: ret Zeros(0, 0) end
mut work := Clone(b)
_qt_apply(f, work)
_r_backsolve(f, work)
r := SubMatrix(work, 0, 0, f.n, b.cols)
defer work.free()
ret r
end
@en "Residual"
@fa "باقیمانده"
pub func Residual(a &: Matrix, x &: Matrix, b &: Matrix): Matrix:
mut ax := MatMul(a, x)
r := Sub(b, ax)
defer ax.free()
ret r
end
@en "Orthonormalize"
@fa "متعامدسازی"
pub func Orthonormalize(x &: Matrix): Matrix:
mut cols := Vector {} as Vector<int>
mut w := Clone(x)
repeat x.cols in j:
_mgs_column(w, cols, j)
end
r := _pack_cols(w, cols)
defer cols.free()
defer w.free()
ret r
end
package matrix
import math
import sort
const _SUM_BLOCK := 256
if SALAM_JS:
func _sum_flat(p: f64*, lo: int, hi: int): f64:
mut s := 0.0
mut i := lo
until i < hi:
s += p[i]
i += 1
end
ret s
end
else:
func _sum_flat(p: f64*, lo: int, hi: int): f64:
n := hi - lo
if n <= 0: ret 0.0 end
if n <= _SUM_BLOCK:
base := _row(p, lo)
mut s0 := 0.0
mut s1 := 0.0
mut s2 := 0.0
mut s3 := 0.0
mut s4 := 0.0
mut s5 := 0.0
mut s6 := 0.0
mut s7 := 0.0
nv := n / 8
repeat nv in k:
q := _row(base, k * 8)
s0 += q[0]
s1 += q[1]
s2 += q[2]
s3 += q[3]
s4 += q[4]
s5 += q[5]
s6 += q[6]
s7 += q[7]
end
mut s := ((s0 + s1) + (s2 + s3)) + ((s4 + s5) + (s6 + s7))
mut i := nv * 8
until i < n:
s += base[i]
i += 1
end
ret s
end
mid := lo + n / 2
ret _sum_flat(p, lo, mid) + _sum_flat(p, mid, hi)
end
end
func _row_sum(x &: Matrix, i: int): f64:
mut s := 0.0
repeat x.cols in j: s += x.at(i, j) end
ret s
end
func _col_sum(x &: Matrix, j: int): f64:
mut s := 0.0
repeat x.rows in i: s += x.at(i, j) end
ret s
end
func _extreme(x &: Matrix, idx: int, by_row: bool, want_max: bool): f64:
n := _extreme_len(x, by_row)
if n <= 0: ret 0.0 end
mut best := _extreme_at(x, idx, 0, by_row)
mut k := 1
until k < n:
v := _extreme_at(x, idx, k, by_row)
if want_max and v > best: best = v end
if want_max == false and v < best: best = v end
k += 1
end
ret best
end
func _extreme_len(x &: Matrix, by_row: bool): int:
if by_row: ret x.cols end
ret x.rows
end
func _extreme_at(x &: Matrix, idx: int, k: int, by_row: bool): f64:
if by_row: ret x.at(idx, k) end
ret x.at(k, idx)
end
func _sum_sq_dev(x &: Matrix): f64:
mu := Mean(x)
mut acc := 0.0
repeat x.count() in k:
d := x.a.get(k) - mu
acc += d * d
end
ret acc
end
func _denominator(n: int, sample: bool): f64:
if sample: ret (n - 1) as f64 end
ret n as f64
end
@en "Sum"
@fa "مجموع"
pub func Sum(x &: Matrix): f64: ret _sum_flat(x.a.data, 0, x.count()) end
@en "Prod"
@fa "حاصل‌ضرب"
pub func Prod(x &: Matrix): f64:
mut p := 1.0
repeat x.count() in k: p = p * x.a.get(k) end
ret p
end
@en "Mean"
@fa "میانگین"
pub func Mean(x &: Matrix): f64:
if x.count() == 0: ret 0.0 end
ret Sum(x) / (x.count() as f64)
end
@en "Min"
@fa "کمینه"
pub func Min(x &: Matrix): f64:
if x.count() == 0: ret 0.0 end
mut b := x.a.get(0)
repeat x.count() in k:
if x.a.get(k) < b: b = x.a.get(k) end
end
ret b
end
@en "Max"
@fa "بیشینه"
pub func Max(x &: Matrix): f64:
if x.count() == 0: ret 0.0 end
mut b := x.a.get(0)
repeat x.count() in k:
if x.a.get(k) > b: b = x.a.get(k) end
end
ret b
end
@en "Range"
@fa "دامنه"
pub func Range(x &: Matrix): f64: ret Max(x) - Min(x) end
@en "ArgMin"
@fa "اندیس کمینه"
pub func ArgMin(x &: Matrix): int:
mut bi := 0
repeat x.count() in k:
if x.a.get(k) < x.a.get(bi): bi = k end
end
ret bi
end
@en "ArgMax"
@fa "اندیس بیشینه"
pub func ArgMax(x &: Matrix): int:
mut bi := 0
repeat x.count() in k:
if x.a.get(k) > x.a.get(bi): bi = k end
end
ret bi
end
@en "IndexRow"
@fa "سطر اندیس"
pub func IndexRow(x &: Matrix, k: int): int:
if x.cols <= 0: ret 0 end
ret k / x.cols
end
@en "IndexCol"
@fa "ستون اندیس"
pub func IndexCol(x &: Matrix, k: int): int:
if x.cols <= 0: ret 0 end
ret k % x.cols
end
@en "MaxAbs"
@fa "بیشینه قدرمطلق"
pub func MaxAbs(x &: Matrix): f64:
mut b := 0.0
repeat x.count() in k:
v := math.Abs(x.a.get(k))
if v > b: b = v end
end
ret b
end
@en "Var"
@fa "واریانس"
pub func Var(x &: Matrix, sample: bool): f64:
d := _denominator(x.count(), sample)
if d <= 0.0: ret 0.0 end
ret _sum_sq_dev(x) / d
end
@en "Std"
@fa "انحراف معیار"
pub func Std(x &: Matrix, sample: bool): f64: ret math.Sqrt(Var(x, sample)) end
@en "Median"
@fa "میانه"
pub func Median(x &: Matrix): f64:
n := x.count()
if n == 0: ret 0.0 end
mut v := Vector {} as Vector<f64>
repeat n in k: v.push(x.a.get(k)) end
sort.Sort(v)
mut m := v.get(n / 2)
if n % 2 == 0: m = 0.5 * (v.get(n / 2 - 1) + v.get(n / 2)) end
defer v.free()
ret m
end
@en "RowSums"
@fa "مجموع سطرها"
pub func RowSums(x &: Matrix): Matrix:
mut r := Zeros(x.rows, 1)
repeat x.rows in i: r.set(i, 0, _row_sum(x, i)) end
ret r
end
@en "ColSums"
@fa "مجموع ستون‌ها"
pub func ColSums(x &: Matrix): Matrix:
mut r := Zeros(1, x.cols)
repeat x.cols in j: r.set(0, j, _col_sum(x, j)) end
ret r
end
@en "RowMeans"
@fa "میانگین سطرها"
pub func RowMeans(x &: Matrix): Matrix:
mut r := RowSums(x)
if x.cols > 0: ScaleInPlace(r, 1.0 / (x.cols as f64)) end
ret r
end
@en "ColMeans"
@fa "میانگین ستون‌ها"
pub func ColMeans(x &: Matrix): Matrix:
mut r := ColSums(x)
if x.rows > 0: ScaleInPlace(r, 1.0 / (x.rows as f64)) end
ret r
end
@en "RowMins"
@fa "کمینه سطرها"
pub func RowMins(x &: Matrix): Matrix:
mut r := Zeros(x.rows, 1)
repeat x.rows in i: r.set(i, 0, _extreme(x, i, true, false)) end
ret r
end
@en "RowMaxs"
@fa "بیشینه سطرها"
pub func RowMaxs(x &: Matrix): Matrix:
mut r := Zeros(x.rows, 1)
repeat x.rows in i: r.set(i, 0, _extreme(x, i, true, true)) end
ret r
end
@en "ColMins"
@fa "کمینه ستون‌ها"
pub func ColMins(x &: Matrix): Matrix:
mut r := Zeros(1, x.cols)
repeat x.cols in j: r.set(0, j, _extreme(x, j, false, false)) end
ret r
end
@en "ColMaxs"
@fa "بیشینه ستون‌ها"
pub func ColMaxs(x &: Matrix): Matrix:
mut r := Zeros(1, x.cols)
repeat x.cols in j: r.set(0, j, _extreme(x, j, false, true)) end
ret r
end
@en "CumSumRows"
@fa "مجموع تجمعی سطری"
pub func CumSumRows(x &: Matrix): Matrix:
mut r := Zeros(x.rows, x.cols)
repeat x.rows in i:
mut s := 0.0
repeat x.cols in j:
s += x.at(i, j)
r.set(i, j, s)
end
end
ret r
end
@en "CumSumCols"
@fa "مجموع تجمعی ستونی"
pub func CumSumCols(x &: Matrix): Matrix:
mut r := Zeros(x.rows, x.cols)
repeat x.cols in j:
mut s := 0.0
repeat x.rows in i:
s += x.at(i, j)
r.set(i, j, s)
end
end
ret r
end
@en "CumProdRows"
@fa "ضرب تجمعی سطری"
pub func CumProdRows(x &: Matrix): Matrix:
mut r := Zeros(x.rows, x.cols)
repeat x.rows in i:
mut p := 1.0
repeat x.cols in j:
p = p * x.at(i, j)
r.set(i, j, p)
end
end
ret r
end
@en "CountNonZero"
@fa "شمار ناصفر"
pub func CountNonZero(x &: Matrix): int:
mut n := 0
repeat x.count() in k:
if x.a.get(k) != 0.0: n += 1 end
end
ret n
end
@en "Any"
@fa "هر"
pub func Any(x &: Matrix): bool: ret CountNonZero(x) > 0 end
@en "All"
@fa "همه"
pub func All(x &: Matrix): bool: ret CountNonZero(x) == x.count() end
@en "AllFinite"
@fa "همه متناهی"
pub func AllFinite(x &: Matrix): bool:
repeat x.count() in k:
v := x.a.get(k)
if math.IsNaN(v): ret false end
if math.IsInf(v): ret false end
end
ret true
end
package matrix
import math
const _RREF_SCALE := 1.0e-12
func _matrix_scale(x &: Matrix): f64:
mut m := 0.0
repeat x.count() in k:
v := math.Abs(x.a.get(k))
if v > m: m = v end
end
if m == 0.0: ret 1.0 end
ret m
end
func _best_pivot(x &: Matrix, from: int, col: int): int:
mut best := from
mut bv := math.Abs(x.at(from, col))
mut i := from + 1
until i < x.rows:
v := math.Abs(x.at(i, col))
if v > bv:
bv = v
best = i
end
i += 1
end
ret best
end
func _scale_row(x &: Matrix, i: int, f: f64):
repeat x.cols in j: x.mul_at(i, j, f) end
end
func _axpy_row(x &: Matrix, target: int, source: int, f: f64):
repeat x.cols in j:
x.set(target, j, x.at(target, j) - f * x.at(source, j))
end
end
func _clear_column(x &: Matrix, pivot_row: int, col: int, full: bool):
pivot := x.at(pivot_row, col)
if pivot == 0.0: ret end
repeat x.rows in i:
if i != pivot_row:
if full or i > pivot_row:
f := x.at(i, col) / pivot
if f != 0.0: _axpy_row(x, i, pivot_row, f) end
end
end
end
end
func _eliminate(x &: Matrix, pivots &: Vector<int>, reduced: bool):
tol := _RREF_SCALE * _matrix_scale(x)
mut row := 0
repeat x.cols in col:
if row < x.rows:
_eliminate_col(x, pivots, row, col, tol, reduced)
if pivots.len() > row: row += 1 end
end
end
end
func _eliminate_col(x &: Matrix, pivots &: Vector<int>, row: int, col: int, tol: f64, reduced: bool):
p := _best_pivot(x, row, col)
if math.Abs(x.at(p, col)) <= tol: ret end
SwapRows(x, row, p)
if reduced: _scale_row(x, row, 1.0 / x.at(row, col)) end
_clear_column(x, row, col, reduced)
pivots.push(col)
end
func _free_columns(ncols: int, piv &: Vector<int>): Vector<int>:
mut free := Vector {} as Vector<int>
repeat ncols in j:
mut found := false
repeat piv.len() in k:
if piv.get(k) == j: found = true end
end
if found == false: free.push(j) end
end
ret free
end
func _null_column(r &: Matrix, piv &: Vector<int>, free &: Vector<int>, basis &: Matrix, k: int):
fc := free.get(k)
basis.set(fc, k, 1.0)
repeat piv.len() in row:
basis.set(piv.get(row), k, 0.0 - r.at(row, fc))
end
end
func _copy_col(src &: Matrix, dst &: Matrix, src_col: int, dst_col: int):
repeat src.rows in i: dst.set(i, dst_col, src.at(i, src_col)) end
end
func _read_solution(aug &: Matrix, piv &: Vector<int>, out &: Matrix, ncols: int): bool:
repeat piv.len() in k:
col := piv.get(k)
if col >= ncols: ret false end
out.set(col, 0, aug.at(k, ncols))
end
ret true
end
@en "RowEchelon"
@fa "پلکانی سطری"
pub func RowEchelon(x &: Matrix): Matrix:
mut r := Clone(x)
mut piv := Vector {} as Vector<int>
_eliminate(r, piv, false)
defer piv.free()
ret r
end
@en "RREF"
@fa "پلکانی کاهش‌یافته"
pub func RREF(x &: Matrix): Matrix:
mut r := Clone(x)
mut piv := Vector {} as Vector<int>
_eliminate(r, piv, true)
defer piv.free()
ret r
end
@en "PivotColumns"
@fa "ستون‌های محوری"
pub func PivotColumns(x &: Matrix): Matrix:
mut work := Clone(x)
mut piv := Vector {} as Vector<int>
_eliminate(work, piv, true)
mut r := Zeros(1, piv.len())
repeat piv.len() in k: r.set(0, k, piv.get(k) as f64) end
defer piv.free()
defer work.free()
ret r
end
@en "RankExact"
@fa "رتبه دقیق"
pub func RankExact(x &: Matrix): int:
mut work := Clone(x)
mut piv := Vector {} as Vector<int>
_eliminate(work, piv, true)
n := piv.len()
defer piv.free()
defer work.free()
ret n
end
@en "Nullity"
@fa "پوچی"
pub func Nullity(x &: Matrix): int: ret x.cols - RankExact(x) end
@en "NullSpaceExact"
@fa "فضای تهی دقیق"
pub func NullSpaceExact(x &: Matrix): Matrix:
mut r := Clone(x)
mut piv := Vector {} as Vector<int>
_eliminate(r, piv, true)
mut free := _free_columns(x.cols, piv)
mut basis := Zeros(x.cols, free.len())
repeat free.len() in k: _null_column(r, piv, free, basis, k) end
defer piv.free()
free.free()
defer r.free()
ret basis
end
@en "ColumnSpaceExact"
@fa "فضای ستونی دقیق"
pub func ColumnSpaceExact(x &: Matrix): Matrix:
mut work := Clone(x)
mut piv := Vector {} as Vector<int>
_eliminate(work, piv, true)
mut r := Zeros(x.rows, piv.len())
repeat piv.len() in k: _copy_col(x, r, piv.get(k), k) end
defer piv.free()
defer work.free()
ret r
end
@en "SolveGeneral"
@fa "حل عمومی"
pub func SolveGeneral(a &: Matrix, b &: Matrix): Matrix:
if a.rows != b.rows or b.cols != 1: ret Zeros(0, 0) end
mut aug := HStack(a, b)
mut piv := Vector {} as Vector<int>
_eliminate(aug, piv, true)
mut r := Zeros(a.cols, 1)
ok := _read_solution(aug, piv, r, a.cols)
defer piv.free()
defer aug.free()
if ok: ret r end
defer r.free()
ret Zeros(0, 0)
end
@en "IsConsistent"
@fa "سازگار است"
pub func IsConsistent(a &: Matrix, b &: Matrix): bool:
if a.rows != b.rows: ret false end
mut aug := HStack(a, b)
ra := RankExact(a)
rb := RankExact(aug)
defer aug.free()
ret ra == rb
end
package matrix
func _copy_block(dst &: Matrix, src &: Matrix, r0: int, c0: int, dr: int, dc: int):
repeat dr in i:
repeat dc in j: dst.set(i, j, src.at(r0 + i, c0 + j)) end
end
end
func _copy_skip_row(dst &: Matrix, src &: Matrix, skip: int):
mut w := 0
repeat src.rows in i:
if i != skip:
repeat src.cols in j: dst.set(w, j, src.at(i, j)) end
w += 1
end
end
end
func _copy_skip_col(dst &: Matrix, src &: Matrix, skip: int):
repeat src.rows in i:
mut w := 0
repeat src.cols in j:
if j != skip:
dst.set(i, w, src.at(i, j))
w += 1
end
end
end
end
func _shift_rows_down(dst &: Matrix, src &: Matrix, from: int):
mut i := from
until i < src.rows:
repeat src.cols in j: dst.set(i + 1, j, src.at(i, j)) end
i += 1
end
end
func _copy_row_split(dst &: Matrix, src &: Matrix, i: int, at: int, v: f64):
repeat at in j: dst.set(i, j, src.at(i, j)) end
dst.set(i, at, v)
mut j := at
until j < src.cols:
dst.set(i, j + 1, src.at(i, j))
j += 1
end
end
func _clamp(v: int, lo: int, hi: int): int:
if v < lo: ret lo end
if v > hi: ret hi end
ret v
end
@en "Reshape"
@fa "تغییر شکل"
pub func Reshape(x &: Matrix, rows: int, cols: int): Matrix:
if rows * cols != x.count(): ret Zeros(0, 0) end
mut r := Zeros(rows, cols)
repeat x.count() in k: r.a.set(k, x.a.get(k)) end
ret r
end
@en "Flatten"
@fa "تخت‌سازی"
pub func Flatten(x &: Matrix): Matrix: ret Reshape(x, 1, x.count()) end
@en "FlattenCol"
@fa "تخت‌سازی ستونی"
pub func FlattenCol(x &: Matrix): Matrix: ret Reshape(x, x.count(), 1) end
@en "Row"
@fa "سطر"
pub func Row(x &: Matrix, i: int): Matrix:
if i < 0 or i >= x.rows: ret Zeros(0, 0) end
mut r := Zeros(1, x.cols)
repeat x.cols in j: r.set(0, j, x.at(i, j)) end
ret r
end
@en "Col"
@fa "ستون"
pub func Col(x &: Matrix, j: int): Matrix:
if j < 0 or j >= x.cols: ret Zeros(0, 0) end
mut r := Zeros(x.rows, 1)
repeat x.rows in i: r.set(i, 0, x.at(i, j)) end
ret r
end
@en "SetRow"
@fa "تنظیم سطر"
pub func SetRow(x &: Matrix, i: int, v &: Matrix):
if i < 0 or i >= x.rows or v.count() != x.cols: ret end
repeat x.cols in j: x.set(i, j, v.a.get(j)) end
end
@en "SetCol"
@fa "تنظیم ستون"
pub func SetCol(x &: Matrix, j: int, v &: Matrix):
if j < 0 or j >= x.cols or v.count() != x.rows: ret end
repeat x.rows in i: x.set(i, j, v.a.get(i)) end
end
@en "SubMatrix"
@fa "زیرماتریس"
pub func SubMatrix(x &: Matrix, r0: int, c0: int, dr: int, dc: int): Matrix:
sr := _clamp(r0, 0, x.rows)
sc := _clamp(c0, 0, x.cols)
nr := _clamp(dr, 0, x.rows - sr)
nc := _clamp(dc, 0, x.cols - sc)
mut r := Zeros(nr, nc)
_copy_block(r, x, sr, sc, nr, nc)
ret r
end
@en "Minor"
@fa "کهاد"
pub func Minor(x &: Matrix, i: int, j: int): Matrix:
if x.rows <= 1 or x.cols <= 1: ret Zeros(0, 0) end
mut cut := DeleteRow(x, i)
r := DeleteCol(cut, j)
defer cut.free()
ret r
end
@en "DeleteRow"
@fa "حذف سطر"
pub func DeleteRow(x &: Matrix, i: int): Matrix:
if i < 0 or i >= x.rows: ret Clone(x) end
mut r := Zeros(x.rows - 1, x.cols)
_copy_skip_row(r, x, i)
ret r
end
@en "DeleteCol"
@fa "حذف ستون"
pub func DeleteCol(x &: Matrix, j: int): Matrix:
if j < 0 or j >= x.cols: ret Clone(x) end
mut r := Zeros(x.rows, x.cols - 1)
_copy_skip_col(r, x, j)
ret r
end
@en "InsertRow"
@fa "درج سطر"
pub func InsertRow(x &: Matrix, i: int, v &: Matrix): Matrix:
if v.count() != x.cols or i < 0 or i > x.rows: ret Clone(x) end
mut r := Zeros(x.rows + 1, x.cols)
_copy_block(r, x, 0, 0, i, x.cols)
repeat x.cols in j: r.set(i, j, v.a.get(j)) end
_shift_rows_down(r, x, i)
ret r
end
@en "InsertCol"
@fa "درج ستون"
pub func InsertCol(x &: Matrix, j: int, v &: Matrix): Matrix:
if v.count() != x.rows or j < 0 or j > x.cols: ret Clone(x) end
mut r := Zeros(x.rows, x.cols + 1)
repeat x.rows in i:
_copy_row_split(r, x, i, j, v.a.get(i))
end
ret r
end
@en "SwapRows"
@fa "تعویض سطر"
pub func SwapRows(x &: Matrix, i: int, j: int):
if i == j or i < 0 or j < 0 or i >= x.rows or j >= x.rows: ret end
repeat x.cols in c:
t := x.at(i, c)
x.set(i, c, x.at(j, c))
x.set(j, c, t)
end
end
@en "SwapCols"
@fa "تعویض ستون"
pub func SwapCols(x &: Matrix, i: int, j: int):
if i == j or i < 0 or j < 0 or i >= x.cols or j >= x.cols: ret end
repeat x.rows in r:
t := x.at(r, i)
x.set(r, i, x.at(r, j))
x.set(r, j, t)
end
end
@en "Diagonal"
@fa "قطر"
pub func Diagonal(x &: Matrix): Matrix:
n := x.min_dim()
mut r := Zeros(1, n)
repeat n in i: r.set(0, i, x.at(i, i)) end
ret r
end
@en "DiagonalOffset"
@fa "قطر جابه‌جا"
pub func DiagonalOffset(x &: Matrix, k: int): Matrix:
mut data := Vector {} as Vector<f64>
repeat x.rows in i:
j := i + k
if j >= 0 and j < x.cols: data.push(x.at(i, j)) end
end
r := RowVector(data)
defer data.free()
ret r
end
@en "SetDiagonal"
@fa "تنظیم قطر"
pub func SetDiagonal(x &: Matrix, v &: Matrix):
mut n := x.min_dim()
if v.count() < n: n = v.count() end
repeat n in i: x.set(i, i, v.a.get(i)) end
end
@en "ShiftDiagonal"
@fa "افزودن به قطر"
pub func ShiftDiagonal(x &: Matrix, c: f64):
repeat x.min_dim() in i: x.add_at(i, i, c) end
end
package matrix
import math
const _RNG_MULT := 2685821657736338717 as u64
const _RNG_ODD := 1442695040888963407 as u64
@en "Rng"
@fa "مولد تصادفی"
pub struct Rng:
pub s: u64 = 0
@en "next_bits"
@fa "بیت بعدی"
pub func next_bits(): u64:
mut x := this.s
x = x ^ (x >> 12)
x = x ^ (x << 25)
x = x ^ (x >> 27)
this.s = x
ret x * _RNG_MULT
end
@en "next_float"
@fa "اعشاری بعدی"
pub func next_float(): f64:
v := this.next_bits() >> 11
ret (v as f64) / 9007199254740992.0
end
@en "next_normal"
@fa "نرمال بعدی"
pub func next_normal(): f64:
mut u := this.next_float()
if u <= 0.0: u = 1.0e-15 end
v := this.next_float()
ret math.Sqrt(0.0 - 2.0 * math.Log(u)) * math.Cos(6.283185307179586 * v)
end
end
func _fill_random(m &: Matrix, g &: Rng, lo: f64, hi: f64):
repeat m.count() in k: m.a.set(k, lo + (hi - lo) * g.next_float()) end
end
func _fill_normal(m &: Matrix, g &: Rng):
repeat m.count() in k: m.a.set(k, g.next_normal()) end
end
func _hilb_inv_entry(i: int, j: int, n: int): f64:
mut v := ((i + j + 1) as f64) * _binom(n + i, n - j - 1) * _binom(n + j, n - i - 1)
v = v * _binom(i + j, i) * _binom(i + j, i)
if (i + j) % 2 == 1: ret 0.0 - v end
ret v
end
func _binom(n: int, k: int): f64:
if k < 0 or k > n: ret 0.0 end
mut r := 1.0
mut i := 0
until i < k:
r = r * ((n - i) as f64) / ((i + 1) as f64)
i += 1
end
ret r
end
func _hankel_at(fc &: Matrix, lr &: Matrix, i: int, j: int, n: int): f64:
k := i + j
if k < n: ret fc.a.get(k) end
ret lr.a.get(k - n + 1)
end
func _rot_fill(m &: Matrix, p: int, q: int, c: f64, s: f64):
m.set(p, p, c)
m.set(p, q, 0.0 - s)
m.set(q, p, s)
m.set(q, q, c)
end
@en "NewRng"
@fa "مولد جدید"
pub func NewRng(seed: i64): Rng:
mut g := Rng {}
g.s = (seed as u64) + _RNG_ODD
if g.s == 0: g.s = _RNG_ODD end
ret g
end
@en "Hilbert"
@fa "هیلبرت"
pub func Hilbert(n: int): Matrix:
mut m := Zeros(n, n)
repeat n in i:
repeat n in j: m.set(i, j, 1.0 / ((i + j + 1) as f64)) end
end
ret m
end
@en "HilbertInverse"
@fa "وارون هیلبرت"
pub func HilbertInverse(n: int): Matrix:
mut m := Zeros(n, n)
repeat n in i:
repeat n in j: m.set(i, j, _hilb_inv_entry(i, j, n)) end
end
ret m
end
@en "Vandermonde"
@fa "واندرموند"
pub func Vandermonde(x &: Matrix, cols: int): Matrix:
n := x.count()
mut m := Zeros(n, cols)
repeat n in i:
mut p := 1.0
repeat cols in j:
m.set(i, j, p)
p = p * x.a.get(i)
end
end
ret m
end
@en "Toeplitz"
@fa "توپلیتز"
pub func Toeplitz(first_col &: Matrix, first_row &: Matrix): Matrix:
n := first_col.count()
m := first_row.count()
mut r := Zeros(n, m)
repeat n in i:
repeat m in j:
if j >= i: r.set(i, j, first_row.a.get(j - i))
else:
r.set(i, j, first_col.a.get(i - j))
end
end
end
ret r
end
@en "Hankel"
@fa "هنکل"
pub func Hankel(first_col &: Matrix, last_row &: Matrix): Matrix:
n := first_col.count()
m := last_row.count()
mut r := Zeros(n, m)
repeat n in i:
repeat m in j: r.set(i, j, _hankel_at(first_col, last_row, i, j, n)) end
end
ret r
end
@en "Circulant"
@fa "دورانی"
pub func Circulant(c &: Matrix): Matrix:
n := c.count()
mut r := Zeros(n, n)
repeat n in i:
repeat n in j: r.set(i, j, c.a.get(((j - i) % n + n) % n)) end
end
ret r
end
@en "Companion"
@fa "همراه"
pub func Companion(coeffs &: Matrix): Matrix:
n := coeffs.count() - 1
if n < 1: ret Zeros(0, 0) end
lead := coeffs.a.get(n)
if lead == 0.0: ret Zeros(0, 0) end
mut m := Zeros(n, n)
repeat n in i: m.set(i, n - 1, 0.0 - coeffs.a.get(i) / lead) end
mut i := 1
until i < n:
m.set(i, i - 1, 1.0)
i += 1
end
ret m
end
@en "Pascal"
@fa "پاسکال"
pub func Pascal(n: int): Matrix:
mut m := Zeros(n, n)
repeat n in i: m.set(i, 0, 1.0) end
repeat n in j: m.set(0, j, 1.0) end
mut i := 1
until i < n:
mut j := 1
until j < n:
m.set(i, j, m.at(i - 1, j) + m.at(i, j - 1))
j += 1
end
i += 1
end
ret m
end
@en "Rotation2D"
@fa "دوران دوبعدی"
pub func Rotation2D(theta: f64): Matrix:
c := math.Cos(theta)
s := math.Sin(theta)
mut m := Zeros(2, 2)
m.set(0, 0, c)
m.set(0, 1, 0.0 - s)
m.set(1, 0, s)
m.set(1, 1, c)
ret m
end
@en "Rotation3D"
@fa "دوران سه‌بعدی"
pub func Rotation3D(axis: int, theta: f64): Matrix:
c := math.Cos(theta)
s := math.Sin(theta)
mut m := Eye(3)
if axis == 0: _rot_fill(m, 1, 2, c, s) end
if axis == 1: _rot_fill(m, 2, 0, c, s) end
if axis == 2: _rot_fill(m, 0, 1, c, s) end
ret m
end
@en "Householder"
@fa "هاوس‌هولدر"
pub func Householder(v &: Matrix): Matrix:
n := v.count()
mut d := 0.0
repeat n in k: d += v.a.get(k) * v.a.get(k) end
mut m := Eye(n)
if d == 0.0: ret m end
f := 2.0 / d
repeat n in i:
repeat n in j: m.add_at(i, j, 0.0 - f * v.a.get(i) * v.a.get(j)) end
end
ret m
end
@en "Givens"
@fa "گیونز"
pub func Givens(n: int, p: int, q: int, theta: f64): Matrix:
mut m := Eye(n)
if p < 0 or q < 0 or p >= n or q >= n or p == q: ret m end
_rot_fill(m, p, q, math.Cos(theta), math.Sin(theta))
ret m
end
@en "Permutation"
@fa "جایگشت"
pub func Permutation(perm &: Matrix): Matrix:
n := perm.count()
mut m := Zeros(n, n)
repeat n in i:
j := perm.a.get(i) as int
if j >= 0 and j < n: m.set(i, j, 1.0) end
end
ret m
end
@en "Random"
@fa "تصادفی"
pub func Random(rows: int, cols: int, lo: f64, hi: f64, seed: i64): Matrix:
mut g := NewRng(seed)
mut m := Zeros(rows, cols)
_fill_random(m, g, lo, hi)
ret m
end
@en "RandomNormal"
@fa "تصادفی نرمال"
pub func RandomNormal(rows: int, cols: int, seed: i64): Matrix:
mut g := NewRng(seed)
mut m := Zeros(rows, cols)
_fill_normal(m, g)
ret m
end
@en "RandomSymmetric"
@fa "تصادفی متقارن"
pub func RandomSymmetric(n: int, seed: i64): Matrix:
mut a := RandomNormal(n, n, seed)
m := SymPart(a)
defer a.free()
ret m
end
@en "RandomSPD"
@fa "تصادفی معین مثبت"
pub func RandomSPD(n: int, seed: i64): Matrix:
mut a := RandomNormal(n, n, seed)
mut m := Gram(a)
ShiftDiagonal(m, n as f64)
defer a.free()
ret m
end
@en "RandomOrthogonal"
@fa "تصادفی متعامد"
pub func RandomOrthogonal(n: int, seed: i64): Matrix:
mut a := RandomNormal(n, n, seed)
mut f := QRDecompose(a)
q := QRGetQ(f)
defer f.free()
defer a.free()
ret q
end
package matrix
func _hstack_into(r &: Matrix, x &: Matrix, c0: int):
repeat x.rows in i:
repeat x.cols in j: r.set(i, c0 + j, x.at(i, j)) end
end
end
func _vstack_into(r &: Matrix, x &: Matrix, r0: int):
repeat x.rows in i:
repeat x.cols in j: r.set(r0 + i, j, x.at(i, j)) end
end
end
func _wrap(i: int, n: int): int:
if n <= 0: ret 0 end
mut k := i % n
if k < 0: k += n end
ret k
end
func _rot90_once(x &: Matrix): Matrix:
mut r := Zeros(x.cols, x.rows)
repeat x.rows in i:
repeat x.cols in j: r.set(x.cols - 1 - j, i, x.at(i, j)) end
end
ret r
end
@en "HStack"
@fa "چینش افقی"
pub func HStack(x &: Matrix, y &: Matrix): Matrix:
if x.rows != y.rows: ret Zeros(0, 0) end
mut r := Zeros(x.rows, x.cols + y.cols)
_hstack_into(r, x, 0)
_hstack_into(r, y, x.cols)
ret r
end
@en "VStack"
@fa "چینش عمودی"
pub func VStack(x &: Matrix, y &: Matrix): Matrix:
if x.cols != y.cols: ret Zeros(0, 0) end
mut r := Zeros(x.rows + y.rows, x.cols)
_vstack_into(r, x, 0)
_vstack_into(r, y, x.rows)
ret r
end
@en "Augment"
@fa "افزوده"
pub func Augment(a &: Matrix, b &: Matrix): Matrix: ret HStack(a, b) end
@en "BlockDiag"
@fa "قطری بلوکی"
pub func BlockDiag(x &: Matrix, y &: Matrix): Matrix:
mut r := Zeros(x.rows + y.rows, x.cols + y.cols)
repeat x.rows in i:
repeat x.cols in j: r.set(i, j, x.at(i, j)) end
end
repeat y.rows in i:
repeat y.cols in j: r.set(x.rows + i, x.cols + j, y.at(i, j)) end
end
ret r
end
@en "Triu"
@fa "بالامثلثی"
pub func Triu(x &: Matrix, k: int): Matrix:
mut r := Zeros(x.rows, x.cols)
repeat x.rows in i:
mut j := i + k
if j < 0: j = 0 end
until j < x.cols:
r.set(i, j, x.at(i, j))
j += 1
end
end
ret r
end
@en "Tril"
@fa "پایین‌مثلثی"
pub func Tril(x &: Matrix, k: int): Matrix:
mut r := Zeros(x.rows, x.cols)
repeat x.rows in i:
mut top := i + k
if top >= x.cols: top = x.cols - 1 end
mut j := 0
until j <= top:
r.set(i, j, x.at(i, j))
j += 1
end
end
ret r
end
@en "SymmetrizeUpper"
@fa "متقارن‌سازی بالا"
pub func SymmetrizeUpper(x &: Matrix): Matrix:
if x.is_square() == false: ret Zeros(0, 0) end
mut r := Clone(x)
repeat x.rows in i:
mut j := i + 1
until j < x.cols:
r.set(j, i, r.at(i, j))
j += 1
end
end
ret r
end
@en "SymPart"
@fa "بخش متقارن"
pub func SymPart(x &: Matrix): Matrix:
if x.is_square() == false: ret Zeros(0, 0) end
mut r := Zeros(x.rows, x.cols)
repeat x.rows in i:
repeat x.cols in j:
r.set(i, j, 0.5 * (x.at(i, j) + x.at(j, i)))
end
end
ret r
end
@en "SkewPart"
@fa "بخش پادمتقارن"
pub func SkewPart(x &: Matrix): Matrix:
if x.is_square() == false: ret Zeros(0, 0) end
mut r := Zeros(x.rows, x.cols)
repeat x.rows in i:
repeat x.cols in j:
r.set(i, j, 0.5 * (x.at(i, j) - x.at(j, i)))
end
end
ret r
end
@en "FlipVertical"
@fa "برعکس عمودی"
pub func FlipVertical(x &: Matrix): Matrix:
mut r := Zeros(x.rows, x.cols)
repeat x.rows in i:
repeat x.cols in j: r.set(x.rows - 1 - i, j, x.at(i, j)) end
end
ret r
end
@en "FlipHorizontal"
@fa "برعکس افقی"
pub func FlipHorizontal(x &: Matrix): Matrix:
mut r := Zeros(x.rows, x.cols)
repeat x.rows in i:
repeat x.cols in j: r.set(i, x.cols - 1 - j, x.at(i, j)) end
end
ret r
end
@en "Rot90"
@fa "چرخش نود"
pub func Rot90(x &: Matrix, k: int): Matrix:
turns := _wrap(k, 4)
mut r := Clone(x)
repeat turns:
t := _rot90_once(r)
r.free()
r = t
end
ret r
end
@en "Roll"
@fa "چرخش دوری"
pub func Roll(x &: Matrix, dr: int, dc: int): Matrix:
mut r := Zeros(x.rows, x.cols)
repeat x.rows in i:
ti := _wrap(i + dr, x.rows)
repeat x.cols in j:
r.set(ti, _wrap(j + dc, x.cols), x.at(i, j))
end
end
ret r
end
@en "Tile"
@fa "کاشی‌کاری"
pub func Tile(x &: Matrix, ry: int, rx: int): Matrix:
if ry <= 0 or rx <= 0: ret Zeros(0, 0) end
mut r := Zeros(x.rows * ry, x.cols * rx)
repeat r.rows in i:
repeat r.cols in j: r.set(i, j, x.at(i % x.rows, j % x.cols)) end
end
ret r
end
@en "Pad"
@fa "لبه‌گذاری"
pub func Pad(x &: Matrix, top: int, bottom: int, left: int, right: int, v: f64): Matrix:
if top < 0 or bottom < 0 or left < 0 or right < 0: ret Clone(x) end
mut r := Full(x.rows + top + bottom, x.cols + left + right, v)
repeat x.rows in i:
repeat x.cols in j: r.set(top + i, left + j, x.at(i, j)) end
end
ret r
end
package matrix
import math
@en "PCA"
@fa "تحلیل مولفه اصلی"
pub struct PCA:
pub components: Matrix = Matrix {}
pub variances: Matrix = Matrix {}
pub center: Matrix = Matrix {}
@en "free"
@fa "آزادسازی"
pub func free():
this.components.free()
this.variances.free()
this.center.free()
end
end
func _column_mean(x &: Matrix, j: int): f64:
if x.rows == 0: ret 0.0 end
mut s := 0.0
repeat x.rows in i: s += x.at(i, j) end
ret s / (x.rows as f64)
end
func _column_sd(x &: Matrix, j: int, mu: f64, denom: f64): f64:
mut s := 0.0
repeat x.rows in i:
d := x.at(i, j) - mu
s += d * d
end
if denom <= 0.0: ret 0.0 end
ret math.Sqrt(s / denom)
end
func _denom(n: int, sample: bool): f64:
if sample: ret (n - 1) as f64 end
ret n as f64
end
func _scale_column(r &: Matrix, x &: Matrix, j: int, d: f64):
sd := _column_sd(x, j, _column_mean(x, j), d)
if sd == 0.0: ret end
repeat r.rows in i: r.mul_at(i, j, 1.0 / sd) end
end
func _corr_entry(c &: Matrix, i: int, j: int):
if i == j: ret end
di := math.Sqrt(math.Abs(c.at(i, i)))
dj := math.Sqrt(math.Abs(c.at(j, j)))
if di == 0.0 or dj == 0.0:
c.set(i, j, 0.0)
ret
end
c.set(i, j, c.at(i, j) / (di * dj))
end
func _unit_diagonal(c &: Matrix):
repeat c.min_dim() in i:
if c.at(i, i) != 0.0: c.set(i, i, 1.0) end
end
end
func _sv_to_var(s &: Matrix, n: int): Matrix:
mut r := Clone(s)
d := _denom(n, true)
repeat r.count() in k:
v := r.a.get(k)
mut out := 0.0
if d > 0.0: out = v * v / d end
r.a.set(k, out)
end
ret r
end
func _center_with(x &: Matrix, mu &: Matrix): Matrix:
mut r := Clone(x)
repeat x.rows in i:
repeat x.cols in j: r.add_at(i, j, 0.0 - mu.a.get(j)) end
end
ret r
end
@en "CenterColumns"
@fa "مرکزی‌سازی ستون‌ها"
pub func CenterColumns(x &: Matrix): Matrix:
mut r := Clone(x)
repeat x.cols in j:
mu := _column_mean(x, j)
repeat x.rows in i: r.add_at(i, j, 0.0 - mu) end
end
ret r
end
@en "ColumnMeans"
@fa "میانگین ستونی"
pub func ColumnMeans(x &: Matrix): Matrix:
mut r := Zeros(1, x.cols)
repeat x.cols in j: r.set(0, j, _column_mean(x, j)) end
ret r
end
@en "ColumnStds"
@fa "انحراف معیار ستون‌ها"
pub func ColumnStds(x &: Matrix, sample: bool): Matrix:
d := _denom(x.rows, sample)
mut r := Zeros(1, x.cols)
repeat x.cols in j:
r.set(0, j, _column_sd(x, j, _column_mean(x, j), d))
end
ret r
end
@en "Standardize"
@fa "استانداردسازی"
pub func Standardize(x &: Matrix, sample: bool): Matrix:
d := _denom(x.rows, sample)
mut r := CenterColumns(x)
repeat x.cols in j: _scale_column(r, x, j, d) end
ret r
end
@en "Covariance"
@fa "کوواریانس"
pub func Covariance(x &: Matrix, sample: bool): Matrix:
d := _denom(x.rows, sample)
if d <= 0.0: ret Zeros(x.cols, x.cols) end
mut c := CenterColumns(x)
mut g := Gram(c)
ScaleInPlace(g, 1.0 / d)
defer c.free()
ret g
end
@en "Correlation"
@fa "همبستگی"
pub func Correlation(x &: Matrix): Matrix:
mut c := Covariance(x, true)
repeat c.rows in i:
repeat c.cols in j: _corr_entry(c, i, j) end
end
_unit_diagonal(c)
ret c
end
@en "PCAFit"
@fa "برازش مولفه اصلی"
pub func PCAFit(x &: Matrix): PCA:
mut p := PCA {}
p.center = ColumnMeans(x)
mut cov := Covariance(x, true)
mut e := EigSym(cov)
p.components = Clone(e.vectors)
p.variances = Clone(e.values)
defer e.free()
defer cov.free()
ret p
end
@en "PCAFromSVD"
@fa "مولفه اصلی از تجزیه تکین"
pub func PCAFromSVD(x &: Matrix): PCA:
mut p := PCA {}
p.center = ColumnMeans(x)
mut c := CenterColumns(x)
mut f := SVDecompose(c)
p.components = Clone(f.v)
p.variances = _sv_to_var(f.s, x.rows)
defer f.free()
defer c.free()
ret p
end
@en "PCATransform"
@fa "تبدیل مولفه اصلی"
pub func PCATransform(p &: PCA, x &: Matrix, k: int): Matrix:
mut n := k
if n > p.components.cols: n = p.components.cols end
mut c := _center_with(x, p.center)
mut basis := SubMatrix(p.components, 0, 0, p.components.rows, n)
r := MatMul(c, basis)
defer c.free()
defer basis.free()
ret r
end
@en "ExplainedVariance"
@fa "واریانس تبیین‌شده"
pub func ExplainedVariance(p &: PCA): Matrix:
mut total := 0.0
repeat p.variances.count() in k: total += p.variances.a.get(k) end
mut r := Clone(p.variances)
if total <= 0.0: ret r end
ScaleInPlace(r, 1.0 / total)
ret r
end
@en "LinearRegression"
@fa "رگرسیون خطی"
pub func LinearRegression(x &: Matrix, y &: Matrix): Matrix:
if x.rows != y.rows or y.cols != 1: ret Zeros(0, 0) end
mut ones := Full(x.rows, 1, 1.0)
mut design := HStack(ones, x)
beta := LeastSquares(design, y)
defer ones.free()
defer design.free()
ret beta
end
@en "RSquared"
@fa "آر دو"
pub func RSquared(y &: Matrix, fitted &: Matrix): f64:
if y.count() != fitted.count(): ret 0.0 end
mu := Mean(y)
mut ss_res := 0.0
mut ss_tot := 0.0
repeat y.count() in k:
d := y.a.get(k) - fitted.a.get(k)
t := y.a.get(k) - mu
ss_res += d * d
ss_tot += t * t
end
if ss_tot == 0.0: ret 0.0 end
ret 1.0 - ss_res / ss_tot
end
package matrix
import math
const _SVD_MAX_SWEEPS := 60
@en "SVD"
@fa "تجزیه مقادیر تکین"
pub struct SVD:
pub u: Matrix = Matrix {}
pub s: Matrix = Matrix {}
pub v: Matrix = Matrix {}
pub ok: bool = false
@en "free"
@fa "آزادسازی"
pub func free():
this.u.free()
this.s.free()
this.v.free()
end
end
func _col_dot(w &: Matrix, p: int, q: int): f64:
mut s := 0.0
repeat w.rows in i: s += w.at(i, p) * w.at(i, q) end
ret s
end
func _col_norm2(w &: Matrix, p: int): f64: ret _col_dot(w, p, p) end
func _rot_cols(w &: Matrix, p: int, q: int, c: f64, s: f64):
repeat w.rows in i:
wp := w.at(i, p)
wq := w.at(i, q)
w.set(i, p, c * wp - s * wq)
w.set(i, q, s * wp + c * wq)
end
end
func _jacobi_rot(w &: Matrix, v &: Matrix, p: int, q: int): bool:
g := _col_dot(w, p, q)
if g == 0.0: ret false end
alpha := _col_norm2(w, p)
beta := _col_norm2(w, q)
if math.Abs(g) <= MAT_EPS * math.Sqrt(alpha * beta): ret false end
zeta := (beta - alpha) / (2.0 * g)
mut t := 1.0 / (math.Abs(zeta) + math.Sqrt(1.0 + zeta * zeta))
if zeta < 0.0: t = 0.0 - t end
c := 1.0 / math.Sqrt(1.0 + t * t)
s := c * t
_rot_cols(w, p, q, c, s)
_rot_cols(v, p, q, c, s)
ret true
end
func _svd_sweep(w &: Matrix, v &: Matrix): bool:
mut moved := false
n := w.cols
mut p := 0
until p < n - 1:
mut q := p + 1
until q < n:
if _jacobi_rot(w, v, p, q): moved = true end
q += 1
end
p += 1
end
ret moved
end
func _svd_extract(w &: Matrix, s &: Matrix):
repeat w.cols in j:
sigma := math.Sqrt(_col_norm2(w, j))
s.set(0, j, sigma)
if sigma > 0.0:
inv := 1.0 / sigma
repeat w.rows in i: w.mul_at(i, j, inv) end
end
end
end
func _svd_sort(u &: Matrix, s &: Matrix, v &: Matrix):
n := s.cols
repeat n in i:
mut best := i
mut j := i + 1
until j < n:
if s.at(0, j) > s.at(0, best): best = j end
j += 1
end
if best != i: _svd_swap(u, s, v, i, best) end
end
end
func _svd_swap(u &: Matrix, s &: Matrix, v &: Matrix, i: int, j: int):
t := s.at(0, i)
s.set(0, i, s.at(0, j))
s.set(0, j, t)
SwapCols(u, i, j)
SwapCols(v, i, j)
end
func _svd_tall(x &: Matrix): SVD:
mut r := SVD {}
r.u = Clone(x)
r.v = Eye(x.cols)
r.s = Zeros(1, x.cols)
mut sweeps := 0
mut moved := true
until moved and sweeps < _SVD_MAX_SWEEPS:
moved = _svd_sweep(r.u, r.v)
sweeps += 1
end
_svd_extract(r.u, r.s)
_svd_sort(r.u, r.s, r.v)
r.ok = sweeps < _SVD_MAX_SWEEPS
ret r
end
func _svd_wide(x &: Matrix): SVD:
mut t := Transpose(x)
inner := _svd_tall(t)
mut r := SVD {}
r.u = inner.v
r.v = inner.u
r.s = inner.s
r.ok = inner.ok
defer t.free()
ret r
end
func _rank_tol(x &: Matrix, s &: Matrix): f64:
if s.count() == 0: ret 0.0 end
mut d := x.rows
if x.cols > d: d = x.cols end
ret s.a.get(0) * (d as f64) * MAT_EPS
end
func _null_pick(f &: SVD, keep &: Vector<int>, k: int, cut: f64):
if k >= f.s.count():
keep.push(k)
ret
end
if f.s.a.get(k) <= cut: keep.push(k) end
end
func _gather_cols(src &: Matrix, idx &: Vector<int>): Matrix:
mut r := Zeros(src.rows, idx.len())
repeat idx.len() in c:
j := idx.get(c)
repeat src.rows in i: r.set(i, c, src.at(i, j)) end
end
ret r
end
func _pinv_add(f &: SVD, out &: Matrix, k: int, w: f64):
repeat out.rows in i:
vi := w * f.v.at(i, k)
repeat out.cols in j: out.add_at(i, j, vi * f.u.at(j, k)) end
end
end
func _pinv_build(f &: SVD, out &: Matrix, cut: f64):
repeat f.s.count() in k:
sigma := f.s.a.get(k)
if sigma > cut: _pinv_add(f, out, k, 1.0 / sigma) end
end
end
func _rank1_add(f &: SVD, out &: Matrix, t: int):
sigma := f.s.a.get(t)
repeat out.rows in i:
ui := sigma * f.u.at(i, t)
repeat out.cols in j: out.add_at(i, j, ui * f.v.at(j, t)) end
end
end
@en "SVDecompose"
@fa "تجزیه تکین"
pub func SVDecompose(x &: Matrix): SVD:
if x.is_empty(): ret SVD {} end
if x.rows >= x.cols: ret _svd_tall(x) end
ret _svd_wide(x)
end
@en "SingularValues"
@fa "مقادیر تکین"
pub func SingularValues(x &: Matrix): Matrix:
mut f := SVDecompose(x)
s := Clone(f.s)
defer f.free()
ret s
end
@en "MatrixRank"
@fa "رتبه"
pub func MatrixRank(x &: Matrix, tol: f64): int:
mut s := SingularValues(x)
mut cut := tol
if cut <= 0.0: cut = _rank_tol(x, s) end
mut n := 0
repeat s.count() in k:
if s.a.get(k) > cut: n += 1 end
end
defer s.free()
ret n
end
@en "PseudoInverse"
@fa "شبه‌وارون"
pub func PseudoInverse(x &: Matrix, tol: f64): Matrix:
mut f := SVDecompose(x)
mut cut := tol
if cut <= 0.0: cut = _rank_tol(x, f.s) end
mut sv := Zeros(f.v.rows, f.u.rows)
_pinv_build(f, sv, cut)
defer f.free()
ret sv
end
@en "NullSpace"
@fa "فضای تهی"
pub func NullSpace(x &: Matrix, tol: f64): Matrix:
mut f := SVDecompose(x)
mut cut := tol
if cut <= 0.0: cut = _rank_tol(x, f.s) end
mut keep := Vector {} as Vector<int>
repeat f.v.cols in k: _null_pick(f, keep, k, cut) end
r := _gather_cols(f.v, keep)
defer keep.free()
defer f.free()
ret r
end
@en "ColumnSpace"
@fa "فضای ستونی"
pub func ColumnSpace(x &: Matrix, tol: f64): Matrix:
mut f := SVDecompose(x)
mut cut := tol
if cut <= 0.0: cut = _rank_tol(x, f.s) end
mut keep := Vector {} as Vector<int>
repeat f.s.count() in k:
if f.s.a.get(k) > cut: keep.push(k) end
end
r := _gather_cols(f.u, keep)
defer keep.free()
defer f.free()
ret r
end
@en "LowRankApprox"
@fa "تقریب رتبه پایین"
pub func LowRankApprox(x &: Matrix, k: int): Matrix:
mut f := SVDecompose(x)
mut r := Zeros(x.rows, x.cols)
mut n := k
if n > f.s.count(): n = f.s.count() end
repeat n in t: _rank1_add(f, r, t) end
defer f.free()
ret r
end
@en "matrix"
@fa "ماتریس"
package matrix
import math
@en "MAT_EPS"
@fa "اپسیلون ماتریس"
pub const MAT_EPS := 2.220446049250313e-16
@en "MAT_TOL"
@fa "رواداری ماتریس"
pub const MAT_TOL := 1.0e-9
@en "MAT_INF"
@fa "بی‌نهایت ماتریس"
pub const MAT_INF := 1.0e300
@en "Matrix"
@fa "ماتریس"
pub struct Matrix:
pub rows: int = 0
pub cols: int = 0
pub a: Vector<f64> = Vector {}
@en "at"
@fa "عنصر"
pub func at(i: int, j: int): f64: ret this.a.get(i * this.cols + j) end
@en "set"
@fa "تنظیم"
pub func set(i: int, j: int, v: f64): this.a.set(i * this.cols + j, v) end
@en "add_at"
@fa "افزودن در"
pub func add_at(i: int, j: int, v: f64):
k := i * this.cols + j
this.a.set(k, this.a.get(k) + v)
end
@en "mul_at"
@fa "ضرب در"
pub func mul_at(i: int, j: int, v: f64):
k := i * this.cols + j
this.a.set(k, this.a.get(k) * v)
end
@en "flat"
@fa "تخت"
pub func flat(k: int): f64: ret this.a.get(k) end
@en "set_flat"
@fa "تنظیم تخت"
pub func set_flat(k: int, v: f64): this.a.set(k, v) end
@en "count"
@fa "شمار"
pub func count(): int: ret this.rows * this.cols end
@en "is_square"
@fa "مربع است"
pub func is_square(): bool: ret this.rows == this.cols end
@en "is_empty"
@fa "تهی است"
pub func is_empty(): bool: ret this.rows <= 0 or this.cols <= 0 end
@en "same_shape"
@fa "هم‌شکل"
pub func same_shape(o &: Matrix): bool:
ret this.rows == o.rows and this.cols == o.cols
end
@en "min_dim"
@fa "کمینه بعد"
pub func min_dim(): int:
if this.rows < this.cols: ret this.rows end
ret this.cols
end
@en "free"
@fa "آزادسازی"
pub func free(): this.a.free() end
end
func _fill(v &: Vector<f64>, n: int, x: f64):
v.clear()
repeat n: v.push(x) end
end
func _raw(rows: int, cols: int): Matrix:
mut m := _shape(rows, cols)
m.a.alloc(rows * cols)
ret m
end
func _shape(r: int, c: int): Matrix:
mut m := Matrix {}
m.rows = r
m.cols = c
ret m
end
func _arange_go(x: f64, stop: f64, step: f64): bool:
if step > 0.0: ret x < stop end
ret x > stop
end
@en "Zeros"
@fa "صفرها"
pub func Zeros(rows: int, cols: int): Matrix:
mut m := _shape(rows, cols)
m.a.zeros(rows * cols)
ret m
end
@en "Ones"
@fa "یک‌ها"
pub func Ones(rows: int, cols: int): Matrix: ret Full(rows, cols, 1.0) end
@en "Full"
@fa "پرشده"
pub func Full(rows: int, cols: int, x: f64): Matrix:
m := _shape(rows, cols)
_fill(m.a, rows * cols, x)
ret m
end
@en "Eye"
@fa "همانی"
pub func Eye(n: int): Matrix:
mut m := Zeros(n, n)
repeat n in i: m.set(i, i, 1.0) end
ret m
end
@en "EyeOffset"
@fa "همانی جابه‌جا"
pub func EyeOffset(rows: int, cols: int, k: int): Matrix:
mut m := Zeros(rows, cols)
repeat rows in i:
j := i + k
if j >= 0 and j < cols: m.set(i, j, 1.0) end
end
ret m
end
@en "FromArray"
@fa "از آرایه"
pub func FromArray(rows: int, cols: int, data &: Vector<f64>): Matrix:
mut m := Zeros(rows, cols)
mut n := rows * cols
if data.len() < n: n = data.len() end
repeat n in k: m.a.set(k, data.get(k)) end
ret m
end
@en "RowVector"
@fa "بردار سطری"
pub func RowVector(data &: Vector<f64>): Matrix:
ret FromArray(1, data.len(), data)
end
@en "ColVector"
@fa "بردار ستونی"
pub func ColVector(data &: Vector<f64>): Matrix:
ret FromArray(data.len(), 1, data)
end
@en "Diag"
@fa "قطری"
pub func Diag(data &: Vector<f64>): Matrix:
n := data.len()
mut m := Zeros(n, n)
repeat n in i: m.set(i, i, data.get(i)) end
ret m
end
@en "Clone"
@fa "همانند"
pub func Clone(x &: Matrix): Matrix:
mut m := _shape(x.rows, x.cols)
m.a.zeros(x.count())
repeat x.count() in k: m.a.set(k, x.a.get(k)) end
ret m
end
@en "CopyInto"
@fa "رونوشت در"
pub func CopyInto(dst &: Matrix, src &: Matrix):
if dst.same_shape(src) == false: ret end
repeat src.count() in k: dst.a.set(k, src.a.get(k)) end
end
@en "Free"
@fa "آزادسازی"
pub func Free(x &: Matrix): x.a.free() end
@en "SetAll"
@fa "تنظیم همه"
pub func SetAll(x &: Matrix, v: f64):
repeat x.count() in k: x.a.set(k, v) end
end
@en "Arange"
@fa "بازه گام"
pub func Arange(start: f64, stop: f64, step: f64): Matrix:
mut data := Vector {} as Vector<f64>
if step != 0.0:
mut x := start
until _arange_go(x, stop, step):
data.push(x)
x += step
end
end
m := RowVector(data)
defer data.free()
ret m
end
@en "Linspace"
@fa "بازه یکنواخت"
pub func Linspace(start: f64, stop: f64, num: int): Matrix:
if num <= 0: ret Zeros(1, 0) end
if num == 1: ret Full(1, 1, start) end
mut m := Zeros(1, num)
h := (stop - start) / ((num - 1) as f64)
repeat num in i: m.set(0, i, start + h * (i as f64)) end
m.set(0, num - 1, stop)
ret m
end
@en "Logspace"
@fa "بازه لگاریتمی"
pub func Logspace(start: f64, stop: f64, num: int, base: f64): Matrix:
mut m := Linspace(start, stop, num)
repeat m.count() in k: m.a.set(k, math.Pow(base, m.a.get(k))) end
ret m
end
package mem
@en "Arena"
@fa "قلمرو"
pub struct Arena:
pub buf: void* = null
pub cap: u64 = 0 as u64
pub used: u64 = 0 as u64
end
func _align8(size: u64): u64:
rem := size % (8 as u64)
if rem == (0 as u64): ret size end
ret size + ((8 as u64) - rem)
end
@en "NewArena"
@fa "قلمرو جدید"
pub func NewArena(capacity: u64): Arena:
ret Arena { buf = Allocate(capacity), cap = capacity, used = 0 as u64 }
end
@en "ArenaAlloc"
@fa "تخصیص در قلمرو"
pub func ArenaAlloc(a &: Arena, size: u64): void*:
if a.buf == null or size == (0 as u64): ret null end
aligned := _align8(size)
if a.used + aligned > a.cap: ret null end
p := ((a.buf as u64) + a.used) as void*
a.used += aligned
ret p
end
@en "ArenaAllocZeroed"
@fa "تخصیص صفرشده در قلمرو"
pub func ArenaAllocZeroed(a &: Arena, size: u64): void*:
p := ArenaAlloc(a, size)
if p != null: Set(p, 0, size) end
ret p
end
@en "ArenaReset"
@fa "بازنشانی قلمرو"
pub func ArenaReset(a &: Arena): a.used = 0 as u64 end
@en "ArenaFree"
@fa "آزادسازی قلمرو"
pub func ArenaFree(a &: Arena):
Free(a.buf)
a.buf = null
a.cap = 0 as u64
a.used = 0 as u64
end
@en "ArenaUsed"
@fa "استفاده شده قلمرو"
pub func ArenaUsed(a &: Arena): u64: ret a.used end
@en "ArenaCapacity"
@fa "ظرفیت قلمرو"
pub func ArenaCapacity(a &: Arena): u64: ret a.cap end
@en "ArenaRemaining"
@fa "باقیمانده قلمرو"
pub func ArenaRemaining(a &: Arena): u64: ret a.cap - a.used end
@en "mem"
@fa "حافظه"
package mem
import conv
extern:
func malloc(size: u64): void*
func calloc(count: u64, size: u64): void*
func realloc(ptr: void*, size: u64): void*
func free(ptr: void*)
func memset(ptr: void*, value: int, n: u64): void*
func memcpy(dst: void*, src: void*, n: u64): void*
func memmove(dst: void*, src: void*, n: u64): void*
end
const HDR_SIZE := 8 as u64
mut _md_allocs := 0 as i64
mut _md_frees := 0 as i64
mut _md_live := 0 as i64
mut _md_peak := 0 as i64
@en "Allocate"
@fa "تخصیص"
pub func Allocate(size: u64): void*:
if SALAM_MEM_DEBUG:
total := size + HDR_SIZE
if total < size: ret null end
p := malloc(total)
if p == null: ret null end
mut hdr := p as i64*
hdr[0] = size as i64
_md_allocs += 1
_md_live += (size as i64)
if _md_live > _md_peak:
_md_peak = _md_live
end
ret ((p as u64) + HDR_SIZE) as void*
else:
ret malloc(size)
end
end
@en "Reallocate"
@fa "بازتخصیص"
pub func Reallocate(ptr: void*, size: u64): void*:
if SALAM_MEM_DEBUG:
if ptr == null:
ret Allocate(size)
end
orig := ((ptr as u64) - HDR_SIZE) as void*
old_hdr := orig as i64*
old_size := old_hdr[0]
total := size + HDR_SIZE
if total < size: ret null end
p := realloc(orig, total)
if p == null: ret null end
mut hdr := p as i64*
hdr[0] = size as i64
_md_live = _md_live - old_size + (size as i64)
if _md_live > _md_peak:
_md_peak = _md_live
end
ret ((p as u64) + HDR_SIZE) as void*
else:
ret realloc(ptr, size)
end
end
@en "Free"
@fa "آزادسازی"
pub func Free(ptr: void*):
if ptr == null:
ret
end
if SALAM_MEM_DEBUG:
orig := ((ptr as u64) - HDR_SIZE) as void*
hdr := orig as i64*
size := hdr[0]
if _md_live >= size:
_md_live -= size
else:
_md_live = 0
end
_md_frees += 1
free(orig)
else:
free(ptr)
end
end
@en "Set"
@fa "تنظیم"
pub func Set(ptr: void*, value: int, n: u64):
if ptr == null or n == 0:
ret
end
memset(ptr, value, n)
end
@en "Copy"
@fa "کپی"
pub func Copy(dst: void*, src: void*, n: u64):
if dst == src or n == 0:
ret
end
memcpy(dst, src, n)
end
@en "MemMove"
@fa "جابجایی حافظه"
pub func MemMove(dst: void*, src: void*, n: u64): void*:
if dst == src or n == 0:
ret dst
end
ret memmove(dst, src, n)
end
@en "AllocateZeroed"
@fa "تخصیص صفرشده"
pub func AllocateZeroed(size: u64): void*:
if SALAM_MEM_DEBUG:
p := Allocate(size)
if p != null:
Set(p, 0, size)
end
ret p
else:
ret calloc(size, 1 as u64)
end
end
@en "AllocateArray"
@fa "تخصیص آرایه"
pub func AllocateArray(count: u64, size: u64): void*:
if count == 0 or size == 0:
ret null
end
total := count * size
if total / count != size:
ret null
end
ret AllocateZeroed(total)
end
@en "AllocCount"
@fa "شمار تخصیص"
pub func AllocCount(): i64:
if SALAM_MEM_DEBUG:
ret _md_allocs
else:
ret 0
end
end
@en "FreeCount"
@fa "شمار آزادسازی"
pub func FreeCount(): i64:
if SALAM_MEM_DEBUG:
ret _md_frees
else:
ret 0
end
end
@en "LiveBytes"
@fa "بایت های زنده"
pub func LiveBytes(): i64:
if SALAM_MEM_DEBUG:
ret _md_live
else:
ret 0
end
end
@en "PeakBytes"
@fa "بیشترین بایت ها"
pub func PeakBytes(): i64:
if SALAM_MEM_DEBUG:
ret _md_peak
else:
ret 0
end
end
@en "IsMemDebug"
@fa "اشکال زدایی حافظه فعال است"
pub func IsMemDebug(): bool:
if SALAM_MEM_DEBUG:
ret true
else:
ret false
end
end
@en "IsAsanActive"
@fa "ای سن فعال است"
pub func IsAsanActive(): bool:
if SALAM_ASAN:
ret true
else:
ret false
end
end
@en "MemDebugActive"
@fa "بررسی حافظه فعال است"
pub func MemDebugActive(): bool:
ret IsMemDebug() or IsAsanActive()
end
@en "CheckLeaks"
@fa "بررسی نشتی"
pub func CheckLeaks():
if IsAsanActive():
printerrln "[salam memcheck] ASAN active - report at exit"
else IsMemDebug():
printerr "[salam memcheck] allocs="
printerr conv.FormatInt(AllocCount())
printerr " frees="
printerr conv.FormatInt(FreeCount())
printerr " live="
printerr conv.FormatInt(LiveBytes())
printerr " peak="
printerrln conv.FormatInt(PeakBytes())
if LiveBytes() > 0:
printerr "[WARNING] leak bytes="
printerrln conv.FormatInt(LiveBytes())
end
end
end
package mem
@en "Pool"
@fa "استخر"
pub struct Pool:
pub block_size: u64 = 0 as u64
pub block_count: u64 = 0 as u64
pub blocks: void* = null
pub free_list: void* = null
end
func _pool_next(block: void*): void*:
p := block as i64*
ret p[0] as void*
end
func _pool_set_next(block: void*, next: void*):
p := block as i64*
p[0] = next as i64
end
@en "NewPool"
@fa "استخر جدید"
pub func NewPool(block_size: u64, block_count: u64): Pool:
mut bs := block_size
if bs < (8 as u64): bs = 8 as u64 end
rem := bs % (8 as u64)
if rem != (0 as u64): bs = bs + ((8 as u64) - rem) end
if block_count == (0 as u64):
ret Pool { block_size = bs, block_count = 0 as u64 }
end
total := bs * block_count
buf := Allocate(total)
if buf == null:
ret Pool { block_size = bs, block_count = 0 as u64 }
end
mut i := 0 as u64
until i < block_count:
addr := ((buf as u64) + i * bs) as void*
mut next := null as void*
if i + (1 as u64) < block_count:
next = ((buf as u64) + (i + (1 as u64)) * bs) as void*
end
_pool_set_next(addr, next)
i += 1 as u64
end
ret Pool { block_size = bs, block_count = block_count, blocks = buf, free_list = buf }
end
@en "PoolAlloc"
@fa "تخصیص از استخر"
pub func PoolAlloc(p &: Pool): void*:
if p.free_list == null: ret null end
head := p.free_list
p.free_list = _pool_next(head)
ret head
end
@en "PoolFree"
@fa "بازگشت به استخر"
pub func PoolFree(p &: Pool, ptr: void*):
if ptr == null: ret end
_pool_set_next(ptr, p.free_list)
p.free_list = ptr
end
@en "PoolBlockSize"
@fa "اندازه بلوک"
pub func PoolBlockSize(p &: Pool): u64: ret p.block_size end
@en "PoolCapacity"
@fa "ظرفیت استخر"
pub func PoolCapacity(p &: Pool): u64: ret p.block_count end
@en "PoolDestroy"
@fa "نابودسازی استخر"
pub func PoolDestroy(p &: Pool):
Free(p.blocks)
p.blocks = null
p.free_list = null
p.block_count = 0 as u64
end
@en "ml"
@fa "یادگیری ماشین"
package ml
import matrix
@en "TREE_GINI"
@fa "معیار جینی"
pub const TREE_GINI := 0
@en "TREE_ENTROPY"
@fa "معیار آنتروپی"
pub const TREE_ENTROPY := 1
@en "TREE_MSE"
@fa "معیار میانگین مربعات"
pub const TREE_MSE := 2
@en "IMPUTE_MEAN"
@fa "جایگذاری میانگین"
pub const IMPUTE_MEAN := 0
@en "IMPUTE_MEDIAN"
@fa "جایگذاری میانه"
pub const IMPUTE_MEDIAN := 1
@en "IMPUTE_CONSTANT"
@fa "جایگذاری ثابت"
pub const IMPUTE_CONSTANT := 2
@en "ML_TOL"
@fa "رواداری یادگیری"
pub const ML_TOL := 1.0e-6
@en "LabelsToInts"
@fa "برچسب به عدد"
pub func LabelsToInts(y &: matrix.Matrix): Vector<int>:
mut out := Vector {} as Vector<int>
repeat y.rows in i: out.push(y.at(i, 0) as int) end
ret out
end
@en "CountClasses"
@fa "شمارش رده‌ها"
pub func CountClasses(y &: matrix.Matrix): int:
mut best := 0 - 1
repeat y.rows in i:
v := y.at(i, 0) as int
if v > best: best = v end
end
ret best + 1
end
package ml
import math
import matrix
@en "GaussianNB"
@fa "بیز ساده گاوسی"
pub struct GaussianNB:
pub var_smoothing: f64 = 0.000000001
pub means: matrix.Matrix = matrix.Matrix {}
pub vars: matrix.Matrix = matrix.Matrix {}
pub log_priors: matrix.Matrix = matrix.Matrix {}
pub n_classes: int = 0
pub ok: bool = false
@en "fit"
@fa "برازش"
pub func fit(x &: matrix.Matrix, y &: matrix.Matrix): bool:
this.ok = false
if x.is_empty() or y.rows != x.rows or y.cols != 1: ret false end
k := CountClasses(y)
if k < 1: ret false end
p := x.cols
n := x.rows
matrix.Free(this.means)
matrix.Free(this.vars)
matrix.Free(this.log_priors)
this.means = matrix.Zeros(k, p)
this.vars = matrix.Zeros(k, p)
this.log_priors = matrix.Zeros(k, 1)
mut counts := Vector {} as Vector<int>
counts.zeros(k)
repeat n in i:
c := y.at(i, 0) as int
counts.set(c, counts.get(c) + 1)
repeat p in j: this.means.add_at(c, j, x.at(i, j)) end
end
repeat k in c:
if counts.get(c) > 0:
repeat p in j: this.means.mul_at(c, j, 1.0 / (counts.get(c) as f64)) end
end
end
repeat n in i:
c := y.at(i, 0) as int
repeat p in j:
d := x.at(i, j) - this.means.at(c, j)
this.vars.add_at(c, j, d * d)
end
end
mut vmax := 0.0
repeat p in j:
m := _col_mean(x, j)
v := _col_std(x, j, m)
if v * v > vmax: vmax = v * v end
end
eps := this.var_smoothing * vmax
repeat k in c:
cnt := counts.get(c)
if cnt > 0:
repeat p in j: this.vars.set(c, j, this.vars.at(c, j) / (cnt as f64) + eps) end
this.log_priors.set(c, 0, math.Log((cnt as f64) / (n as f64)))
else:
repeat p in j: this.vars.set(c, j, 1.0) end
this.log_priors.set(c, 0, 0.0 - 700.0)
end
end
counts.free()
this.n_classes = k
this.ok = true
ret true
end
@en "predict_proba"
@fa "پیش‌بینی احتمال"
pub func predict_proba(x &: matrix.Matrix): matrix.Matrix:
if this.ok == false or x.cols != this.means.cols: ret matrix.Matrix {} end
k := this.n_classes
p := x.cols
mut out := matrix.Zeros(x.rows, k)
half_log_2pi := 0.5 * math.Log(2.0 * math.PI)
repeat x.rows in i:
mut m := 0.0 - 1.0e300
repeat k in c:
mut ll := this.log_priors.at(c, 0)
repeat p in j:
v := this.vars.at(c, j)
d := x.at(i, j) - this.means.at(c, j)
ll -= half_log_2pi + 0.5 * math.Log(v) + d * d / (2.0 * v)
end
out.set(i, c, ll)
if ll > m: m = ll end
end
mut s := 0.0
repeat k in c:
e := math.Exp(out.at(i, c) - m)
out.set(i, c, e)
s += e
end
repeat k in c: out.set(i, c, out.at(i, c) / s) end
end
ret out
end
@en "predict"
@fa "پیش‌بینی"
pub func predict(x &: matrix.Matrix): matrix.Matrix:
mut probs := this.predict_proba(x)
if probs.is_empty(): ret probs end
mut out := matrix.Zeros(x.rows, 1)
repeat x.rows in i:
mut best := 0
repeat this.n_classes in c:
if probs.at(i, c) > probs.at(i, best): best = c end
end
out.set(i, 0, best as f64)
end
matrix.Free(probs)
ret out
end
@en "score"
@fa "امتیاز"
pub func score(x &: matrix.Matrix, y &: matrix.Matrix): f64:
mut p := this.predict(x)
if p.is_empty(): ret 0.0 end
r := Accuracy(y, p)
matrix.Free(p)
ret r
end
@en "free"
@fa "آزادسازی"
pub func free():
matrix.Free(this.means)
matrix.Free(this.vars)
matrix.Free(this.log_priors)
end
end
@en "MultinomialNB"
@fa "بیز ساده چندجمله‌ای"
pub struct MultinomialNB:
pub alpha: f64 = 1.0
pub fit_prior: bool = true
pub log_prob: matrix.Matrix = matrix.Matrix {}
pub log_priors: matrix.Matrix = matrix.Matrix {}
pub n_classes: int = 0
pub ok: bool = false
@en "fit"
@fa "برازش"
pub func fit(x &: matrix.Matrix, y &: matrix.Matrix): bool:
this.ok = false
if x.is_empty() or y.rows != x.rows or y.cols != 1: ret false end
repeat x.count() in t:
if x.a.get(t) < 0.0: ret false end
end
k := CountClasses(y)
if k < 1: ret false end
n := x.rows
p := x.cols
matrix.Free(this.log_prob)
matrix.Free(this.log_priors)
this.log_prob = matrix.Zeros(k, p)
this.log_priors = matrix.Zeros(k, 1)
mut counts := Vector {} as Vector<int>
counts.zeros(k)
repeat n in i:
c := y.at(i, 0) as int
counts.set(c, counts.get(c) + 1)
repeat p in j: this.log_prob.add_at(c, j, x.at(i, j)) end
end
repeat k in c:
mut total := 0.0
repeat p in j: total += this.log_prob.at(c, j) + this.alpha end
repeat p in j:
v := (this.log_prob.at(c, j) + this.alpha) / total
this.log_prob.set(c, j, math.Log(v))
end
mut prior := 1.0 / (k as f64)
if this.fit_prior and n > 0: prior = (counts.get(c) as f64) / (n as f64) end
if prior <= 0.0: prior = 1.0 / ((n + k) as f64) end
this.log_priors.set(c, 0, math.Log(prior))
end
counts.free()
this.n_classes = k
this.ok = true
ret true
end
@en "decision"
@fa "تصمیم"
pub func decision(x &: matrix.Matrix): matrix.Matrix:
if this.ok == false or x.cols != this.log_prob.cols: ret matrix.Matrix {} end
mut out := matrix.MulTranspose(x, this.log_prob)
repeat out.rows in i:
repeat this.n_classes in c: out.add_at(i, c, this.log_priors.at(c, 0)) end
end
ret out
end
@en "predict_proba"
@fa "پیش‌بینی احتمال"
pub func predict_proba(x &: matrix.Matrix): matrix.Matrix:
mut out := this.decision(x)
if out.is_empty(): ret out end
repeat out.rows in i:
mut mx := out.at(i, 0)
repeat this.n_classes in c:
if out.at(i, c) > mx: mx = out.at(i, c) end
end
mut s := 0.0
repeat this.n_classes in c:
e := math.Exp(out.at(i, c) - mx)
out.set(i, c, e)
s += e
end
repeat this.n_classes in c: out.set(i, c, out.at(i, c) / s) end
end
ret out
end
@en "predict"
@fa "پیش‌بینی"
pub func predict(x &: matrix.Matrix): matrix.Matrix:
mut d := this.decision(x)
if d.is_empty(): ret d end
mut out := matrix.Zeros(x.rows, 1)
repeat x.rows in i:
mut best := 0
repeat this.n_classes in c:
if d.at(i, c) > d.at(i, best): best = c end
end
out.set(i, 0, best as f64)
end
matrix.Free(d)
ret out
end
@en "score"
@fa "امتیاز"
pub func score(x &: matrix.Matrix, y &: matrix.Matrix): f64:
mut p := this.predict(x)
if p.is_empty(): ret 0.0 end
r := Accuracy(y, p)
matrix.Free(p)
ret r
end
@en "free"
@fa "آزادسازی"
pub func free():
matrix.Free(this.log_prob)
matrix.Free(this.log_priors)
end
end
package ml
import math
import matrix
@en "AdaBoost"
@fa "آدابوست"
pub struct AdaBoost:
pub n_estimators: int = 50
pub max_depth: int = 1
pub learning_rate: f64 = 1.0
pub seed: i64 = 42
pub trees: Vector<DecisionTree> = Vector {}
pub alphas: Vector<f64> = Vector {}
pub n_classes: int = 0
pub ok: bool = false
@en "fit"
@fa "برازش"
pub func fit(x &: matrix.Matrix, y &: matrix.Matrix): bool:
this.ok = false
if x.is_empty() or y.rows != x.rows or y.cols != 1 or this.n_estimators < 1: ret false end
n := x.rows
k := CountClasses(y)
if k < 2: ret false end
this.free_all()
mut wts := Vector {} as Vector<f64>
repeat n: wts.push(1.0 / (n as f64)) end
mut g := matrix.NewRng(this.seed)
mut round := 0
mut stop := false
until round < this.n_estimators and stop == false:
mut xs := matrix.Zeros(n, x.cols)
mut ys := matrix.Zeros(n, 1)
repeat n in i:
src := _weighted_pick(wts, g.next_float())
repeat x.cols in j: xs.set(i, j, x.at(src, j)) end
ys.set(i, 0, y.at(src, 0))
end
mut tree := DecisionTree {}
tree.max_depth = this.max_depth
tree.n_classes_hint = k
tree.seed = this.seed + (round as i64)
tree.fit(xs, ys)
matrix.Free(xs)
matrix.Free(ys)
mut pred := tree.predict(x)
mut err := 0.0
repeat n in i:
if pred.at(i, 0) != y.at(i, 0): err += wts.get(i) end
end
if err >= 1.0 - 1.0 / (k as f64):
tree.free()
matrix.Free(pred)
stop = true
else:
mut e := err
if e < 1.0e-10: e = 1.0e-10 end
alpha := this.learning_rate * (math.Log((1.0 - e) / e) + math.Log((k - 1) as f64))
mut total := 0.0
repeat n in i:
if pred.at(i, 0) != y.at(i, 0):
wts.set(i, wts.get(i) * math.Exp(alpha))
end
total += wts.get(i)
end
repeat n in i: wts.set(i, wts.get(i) / total) end
this.trees.push(tree)
this.alphas.push(alpha)
matrix.Free(pred)
if err < 1.0e-10: stop = true end
end
round += 1
end
wts.free()
this.n_classes = k
this.ok = this.trees.len() > 0
ret this.ok
end
@en "predict_proba"
@fa "پیش‌بینی احتمال"
pub func predict_proba(x &: matrix.Matrix): matrix.Matrix:
if this.ok == false: ret matrix.Matrix {} end
mut out := matrix.Zeros(x.rows, this.n_classes)
repeat this.trees.len() in t:
mut tree := this.trees.get(t)
mut p := tree.predict(x)
a := this.alphas.get(t)
repeat x.rows in i: out.add_at(i, p.at(i, 0) as int, a) end
matrix.Free(p)
end
repeat x.rows in i:
mut s := 0.0
repeat this.n_classes in c: s += out.at(i, c) end
if s > 0.0:
repeat this.n_classes in c: out.set(i, c, out.at(i, c) / s) end
end
end
ret out
end
@en "predict"
@fa "پیش‌بینی"
pub func predict(x &: matrix.Matrix): matrix.Matrix:
mut probs := this.predict_proba(x)
if probs.is_empty(): ret probs end
out := _argmax_rows(probs)
matrix.Free(probs)
ret out
end
@en "score"
@fa "امتیاز"
pub func score(x &: matrix.Matrix, y &: matrix.Matrix): f64:
mut p := this.predict(x)
if p.is_empty(): ret 0.0 end
r := Accuracy(y, p)
matrix.Free(p)
ret r
end
@en "free_all"
@fa "آزادسازی همه"
pub func free_all():
repeat this.trees.len() in t:
mut tree := this.trees.get(t)
tree.free()
end
this.trees.free()
this.alphas.free()
end
@en "free"
@fa "آزادسازی"
pub func free(): this.free_all() end
end
@en "GradientBoosting"
@fa "تقویت گرادیانی"
pub struct GradientBoosting:
pub n_estimators: int = 100
pub learning_rate: f64 = 0.1
pub max_depth: int = 3
pub min_samples_leaf: int = 1
pub regression: bool = false
pub trees: Vector<DecisionTree> = Vector {}
pub base: matrix.Matrix = matrix.Matrix {}
pub n_classes: int = 0
pub ok: bool = false
@en "fit"
@fa "برازش"
pub func fit(x &: matrix.Matrix, y &: matrix.Matrix): bool:
this.ok = false
if x.is_empty() or y.rows != x.rows or y.cols != 1 or this.n_estimators < 1: ret false end
n := x.rows
this.free_all()
mut k := 1
if this.regression == false:
k = CountClasses(y)
if k < 2: ret false end
end
matrix.Free(this.base)
this.base = matrix.Zeros(1, k)
mut f := matrix.Zeros(n, k)
if this.regression:
mut mean := 0.0
repeat n in i: mean += y.at(i, 0) end
mean = mean / (n as f64)
this.base.set(0, 0, mean)
repeat n in i: f.set(i, 0, mean) end
else:
repeat n in i: this.base.add_at(0, y.at(i, 0) as int, 1.0) end
repeat k in c:
mut pr := this.base.at(0, c) / (n as f64)
if pr < 1.0e-6: pr = 1.0e-6 end
this.base.set(0, c, math.Log(pr))
end
repeat n in i:
repeat k in c: f.set(i, c, this.base.at(0, c)) end
end
end
mut resid := matrix.Zeros(n, 1)
repeat this.n_estimators in round:
repeat k in c:
if this.regression:
repeat n in i: resid.set(i, 0, y.at(i, 0) - f.at(i, 0)) end
else:
repeat n in i:
mut m := f.at(i, 0)
repeat k in cc:
if f.at(i, cc) > m: m = f.at(i, cc) end
end
mut s := 0.0
repeat k in cc: s += math.Exp(f.at(i, cc) - m) end
p := math.Exp(f.at(i, c) - m) / s
mut target := 0.0
if (y.at(i, 0) as int) == c: target = 1.0 end
resid.set(i, 0, target - p)
end
end
mut tree := DecisionTree {}
tree.criterion = TREE_MSE
tree.max_depth = this.max_depth
tree.min_samples_leaf = this.min_samples_leaf
tree.seed = (round * k + c) as i64
tree.fit(x, resid)
mut step := tree.predict(x)
repeat n in i: f.add_at(i, c, this.learning_rate * step.at(i, 0)) end
matrix.Free(step)
this.trees.push(tree)
end
end
matrix.Free(resid)
matrix.Free(f)
this.n_classes = k
this.ok = true
ret true
end
@en "decision"
@fa "تصمیم"
pub func decision(x &: matrix.Matrix): matrix.Matrix:
if this.ok == false: ret matrix.Matrix {} end
k := this.n_classes
mut f := matrix.Zeros(x.rows, k)
repeat x.rows in i:
repeat k in c: f.set(i, c, this.base.at(0, c)) end
end
rounds := this.trees.len() / k
repeat rounds in r:
repeat k in c:
mut tree := this.trees.get(r * k + c)
mut step := tree.predict(x)
repeat x.rows in i: f.add_at(i, c, this.learning_rate * step.at(i, 0)) end
matrix.Free(step)
end
end
ret f
end
@en "predict_proba"
@fa "پیش‌بینی احتمال"
pub func predict_proba(x &: matrix.Matrix): matrix.Matrix:
if this.ok == false or this.regression: ret matrix.Matrix {} end
mut f := this.decision(x)
k := this.n_classes
repeat x.rows in i:
mut m := f.at(i, 0)
repeat k in c:
if f.at(i, c) > m: m = f.at(i, c) end
end
mut s := 0.0
repeat k in c:
e := math.Exp(f.at(i, c) - m)
f.set(i, c, e)
s += e
end
repeat k in c: f.set(i, c, f.at(i, c) / s) end
end
ret f
end
@en "predict"
@fa "پیش‌بینی"
pub func predict(x &: matrix.Matrix): matrix.Matrix:
if this.ok == false: ret matrix.Matrix {} end
if this.regression: ret this.decision(x) end
mut probs := this.predict_proba(x)
out := _argmax_rows(probs)
matrix.Free(probs)
ret out
end
@en "score"
@fa "امتیاز"
pub func score(x &: matrix.Matrix, y &: matrix.Matrix): f64:
mut p := this.predict(x)
if p.is_empty(): ret 0.0 end
mut r := 0.0
if this.regression: r = R2Score(y, p)
else:
r = Accuracy(y, p)
end
matrix.Free(p)
ret r
end
@en "free_all"
@fa "آزادسازی همه"
pub func free_all():
repeat this.trees.len() in t:
mut tree := this.trees.get(t)
tree.free()
end
this.trees.free()
end
@en "free"
@fa "آزادسازی"
pub func free():
this.free_all()
matrix.Free(this.base)
end
end
func _weighted_pick(wts &: Vector<f64>, u: f64): int:
mut acc := 0.0
n := wts.len()
repeat n in i:
acc += wts.get(i)
if acc >= u: ret i end
end
ret n - 1
end
func _argmax_rows(p &: matrix.Matrix): matrix.Matrix:
mut out := matrix.Zeros(p.rows, 1)
repeat p.rows in i:
mut best := 0
repeat p.cols in c:
if p.at(i, c) > p.at(i, best): best = c end
end
out.set(i, 0, best as f64)
end
ret out
end
package ml
import matrix
import pool
mut _km_x := matrix.Matrix {}
mut _km_centers := matrix.Matrix {}
mut _km_labels := Vector {} as Vector<int>
mut _km_dist := Vector {} as Vector<f64>
mut _km_k := 0
@en "KMeans"
@fa "کی میانگین"
pub struct KMeans:
pub k: int = 8
pub max_iter: int = 300
pub tol: f64 = 0.0001
pub n_init: int = 3
pub seed: i64 = 42
pub workers: int = 0
pub centers: matrix.Matrix = matrix.Matrix {}
pub inertia: f64 = 0.0
pub n_iter: int = 0
pub ok: bool = false
@en "fit"
@fa "برازش"
pub func fit(x &: matrix.Matrix): bool:
this.ok = false
if x.is_empty() or this.k < 1 or x.rows < this.k: ret false end
mut labels := Vector {} as Vector<int>
labels.zeros(x.rows)
mut best_inertia := 1.0e300
mut best_centers := matrix.Matrix {}
mut best_iters := 0
mut runs := this.n_init
if runs < 1: runs = 1 end
repeat runs in r:
mut g := matrix.NewRng(this.seed + 7919 * (r as i64))
mut c := _kmeanspp(x, this.k, g)
mut iters := 0
inertia := _lloyd(x, c, labels, this.max_iter, this.tol, this.workers, iters)
if inertia < best_inertia:
best_inertia = inertia
matrix.Free(best_centers)
best_centers = c
best_iters = iters
else:
matrix.Free(c)
end
end
labels.free()
matrix.Free(this.centers)
this.centers = best_centers
this.inertia = best_inertia
this.n_iter = best_iters
this.ok = true
ret true
end
@en "predict"
@fa "پیش‌بینی"
pub func predict(x &: matrix.Matrix): matrix.Matrix:
if this.ok == false or x.cols != this.centers.cols: ret matrix.Matrix {} end
mut out := matrix.Zeros(x.rows, 1)
repeat x.rows in i:
mut bi := 0
mut bd := _sqdist(x, i, this.centers, 0)
repeat this.k - 1 in t:
d := _sqdist(x, i, this.centers, t + 1)
if d < bd:
bd = d
bi = t + 1
end
end
out.set(i, 0, bi as f64)
end
ret out
end
@en "fit_predict"
@fa "برازش سپس پیش‌بینی"
pub func fit_predict(x &: matrix.Matrix): matrix.Matrix:
if this.fit(x) == false: ret matrix.Matrix {} end
ret this.predict(x)
end
@en "transform"
@fa "تبدیل"
pub func transform(x &: matrix.Matrix): matrix.Matrix:
if this.ok == false or x.cols != this.centers.cols: ret matrix.Matrix {} end
mut out := matrix.Zeros(x.rows, this.k)
repeat x.rows in i:
repeat this.k in c: out.set(i, c, _sqdist(x, i, this.centers, c)) end
end
repeat out.count() in t: out.a.set(t, _sqrt_pos(out.a.get(t))) end
ret out
end
@en "free"
@fa "آزادسازی"
pub func free(): matrix.Free(this.centers) end
end
@en "DBSCAN"
@fa "دی‌بی‌اسکن"
pub struct DBSCAN:
pub eps: f64 = 0.5
pub min_samples: int = 5
pub labels: matrix.Matrix = matrix.Matrix {}
pub n_clusters: int = 0
pub ok: bool = false
@en "fit"
@fa "برازش"
pub func fit(x &: matrix.Matrix): bool:
this.ok = false
if x.is_empty(): ret false end
n := x.rows
eps2 := this.eps * this.eps
matrix.Free(this.labels)
this.labels = matrix.Full(n, 1, 0.0 - 1.0)
mut visited := Vector {} as Vector<bool>
visited.zeros(n)
mut cluster := 0
mut queue := Vector {} as Vector<int>
repeat n in i:
if visited.get(i): continue end
visited.set(i, true)
mut nb := _region(x, i, eps2)
if nb.len() < this.min_samples:
nb.free()
continue
end
this.labels.set(i, 0, cluster as f64)
queue.clear()
repeat nb.len() in t: queue.push(nb.get(t)) end
nb.free()
mut head := 0
until head < queue.len():
q := queue.get(head)
head += 1
if this.labels.at(q, 0) < 0.0: this.labels.set(q, 0, cluster as f64) end
if visited.get(q): continue end
visited.set(q, true)
mut nq := _region(x, q, eps2)
if nq.len() >= this.min_samples:
repeat nq.len() in t: queue.push(nq.get(t)) end
end
nq.free()
end
cluster += 1
end
visited.free()
queue.free()
this.n_clusters = cluster
this.ok = true
ret true
end
@en "fit_predict"
@fa "برازش سپس پیش‌بینی"
pub func fit_predict(x &: matrix.Matrix): matrix.Matrix:
if this.fit(x) == false: ret matrix.Matrix {} end
ret matrix.Clone(this.labels)
end
@en "free"
@fa "آزادسازی"
pub func free(): matrix.Free(this.labels) end
end
func _sqdist(a &: matrix.Matrix, i: int, b &: matrix.Matrix, j: int): f64:
mut s := 0.0
repeat a.cols in c:
d := a.at(i, c) - b.at(j, c)
s += d * d
end
ret s
end
func _kmeanspp(x &: matrix.Matrix, k: int, g &: matrix.Rng): matrix.Matrix:
n := x.rows
mut c := matrix.Zeros(k, x.cols)
first := (g.next_float() * (n as f64)) as int
repeat x.cols in j: c.set(0, j, x.at(first, j)) end
mut best := Vector {} as Vector<f64>
repeat n in i: best.push(_sqdist(x, i, c, 0)) end
mut chosen := 1
until chosen < k:
mut total := 0.0
repeat n in i: total += best.get(i) end
mut pick := n - 1
if total > 0.0:
r := g.next_float() * total
mut acc := 0.0
mut found := false
repeat n in i:
if found == false:
acc += best.get(i)
if acc >= r:
pick = i
found = true
end
end
end
else:
pick = (g.next_float() * (n as f64)) as int
end
repeat x.cols in j: c.set(chosen, j, x.at(pick, j)) end
repeat n in i:
d := _sqdist(x, i, c, chosen)
if d < best.get(i): best.set(i, d) end
end
chosen += 1
end
best.free()
ret c
end
func _km_one(x &: matrix.Matrix, centers &: matrix.Matrix, labels &: Vector<int>, dist &: Vector<f64>, i: int, k: int):
mut bi := 0
mut bd := _sqdist(x, i, centers, 0)
repeat k - 1 in t:
d := _sqdist(x, i, centers, t + 1)
if d < bd:
bd = d
bi = t + 1
end
end
labels.set(i, bi)
dist.set(i, bd)
end
func _km_row(i: i64):
_km_one(_km_x, _km_centers, _km_labels, _km_dist, i as int, _km_k)
end
func _km_assign(x &: matrix.Matrix, centers &: matrix.Matrix, labels &: Vector<int>, dist &: Vector<f64>, workers: int):
k := centers.rows
mut w := workers
if w < 0: w = pool.CPUCount() as int end
if w <= 1:
repeat x.rows in i: _km_one(x, centers, labels, dist, i, k) end
ret
end
_km_x = x
_km_centers = centers
_km_labels = labels
_km_dist = dist
_km_k = k
pool.ParallelFor(x.rows as i64, w as i64, (i: i64): _km_row(i) end)
_km_x = matrix.Matrix {}
_km_centers = matrix.Matrix {}
_km_labels = Vector {} as Vector<int>
_km_dist = Vector {} as Vector<f64>
end
func _lloyd(x &: matrix.Matrix, centers &: matrix.Matrix, labels &: Vector<int>, max_iter: int, tol: f64, workers: int, iters_out &: int): f64:
n := x.rows
k := centers.rows
p := x.cols
mut sums := matrix.Zeros(k, p)
mut counts := Vector {} as Vector<int>
counts.zeros(k)
mut dist := Vector {} as Vector<f64>
dist.zeros(n)
mut inertia := 0.0
mut it := 0
mut done := false
until it < max_iter and done == false:
_km_assign(x, centers, labels, dist, workers)
inertia = 0.0
repeat n in i: inertia += dist.get(i) end
matrix.SetAll(sums, 0.0)
repeat k in c: counts.set(c, 0) end
repeat n in i:
c := labels.get(i)
counts.set(c, counts.get(c) + 1)
repeat p in j: sums.add_at(c, j, x.at(i, j)) end
end
mut shift := 0.0
repeat k in c:
if counts.get(c) > 0:
repeat p in j:
nv := sums.at(c, j) / (counts.get(c) as f64)
d := nv - centers.at(c, j)
shift += d * d
centers.set(c, j, nv)
end
end
end
it += 1
if shift <= tol * tol: done = true end
end
iters_out = it
sums.free()
counts.free()
dist.free()
ret inertia
end
func _sqrt_pos(v: f64): f64:
if v <= 0.0: ret 0.0 end
mut r := v
if r > 1.0: r = v / 2.0 end
repeat 40: r = 0.5 * (r + v / r) end
ret r
end
func _region(x &: matrix.Matrix, i: int, eps2: f64): Vector<int>:
mut out := Vector {} as Vector<int>
repeat x.rows in j:
if _sqdist(x, i, x, j) <= eps2: out.push(j) end
end
ret out
end
package ml
import math
import matrix
@en "LINK_SINGLE"
@fa "پیوند تکی"
pub const LINK_SINGLE := 0
@en "LINK_COMPLETE"
@fa "پیوند کامل"
pub const LINK_COMPLETE := 1
@en "LINK_AVERAGE"
@fa "پیوند میانگین"
pub const LINK_AVERAGE := 2
@en "GaussianMixture"
@fa "آمیزه گاوسی"
pub struct GaussianMixture:
pub k: int = 2
pub max_iter: int = 100
pub tol: f64 = 0.0001
pub var_floor: f64 = 0.000001
pub seed: i64 = 42
pub means: matrix.Matrix = matrix.Matrix {}
pub vars: matrix.Matrix = matrix.Matrix {}
pub weights: matrix.Matrix = matrix.Matrix {}
pub log_likelihood: f64 = 0.0
pub n_iter: int = 0
pub ok: bool = false
@en "fit"
@fa "برازش"
pub func fit(x &: matrix.Matrix): bool:
this.ok = false
if x.is_empty() or this.k < 1 or x.rows < this.k: ret false end
n := x.rows
p := x.cols
k := this.k
mut g := matrix.NewRng(this.seed)
matrix.Free(this.means)
matrix.Free(this.vars)
matrix.Free(this.weights)
this.means = _kmeanspp(x, k, g)
this.vars = matrix.Ones(k, p)
this.weights = matrix.Full(k, 1, 1.0 / (k as f64))
mut resp := matrix.Zeros(n, k)
mut prev := 0.0 - 1.0e300
mut it := 0
mut done := false
until it < this.max_iter and done == false:
ll := _gmm_estep(x, this.means, this.vars, this.weights, resp)
repeat k in c:
mut nk := 0.0
repeat n in i: nk += resp.at(i, c) end
if nk < 1.0e-12: nk = 1.0e-12 end
repeat p in j:
mut m := 0.0
repeat n in i: m += resp.at(i, c) * x.at(i, j) end
m = m / nk
this.means.set(c, j, m)
mut v := 0.0
repeat n in i:
d := x.at(i, j) - m
v += resp.at(i, c) * d * d
end
v = v / nk
if v < this.var_floor: v = this.var_floor end
this.vars.set(c, j, v)
end
this.weights.set(c, 0, nk / (n as f64))
end
it += 1
if ll - prev < this.tol and it > 1: done = true end
prev = ll
end
this.log_likelihood = prev
this.n_iter = it
matrix.Free(resp)
this.ok = true
ret true
end
@en "predict_proba"
@fa "پیش‌بینی احتمال"
pub func predict_proba(x &: matrix.Matrix): matrix.Matrix:
if this.ok == false or x.cols != this.means.cols: ret matrix.Matrix {} end
mut resp := matrix.Zeros(x.rows, this.k)
_gmm_estep(x, this.means, this.vars, this.weights, resp)
ret resp
end
@en "predict"
@fa "پیش‌بینی"
pub func predict(x &: matrix.Matrix): matrix.Matrix:
mut resp := this.predict_proba(x)
if resp.is_empty(): ret resp end
out := _argmax_rows(resp)
matrix.Free(resp)
ret out
end
@en "fit_predict"
@fa "برازش سپس پیش‌بینی"
pub func fit_predict(x &: matrix.Matrix): matrix.Matrix:
if this.fit(x) == false: ret matrix.Matrix {} end
ret this.predict(x)
end
@en "free"
@fa "آزادسازی"
pub func free():
matrix.Free(this.means)
matrix.Free(this.vars)
matrix.Free(this.weights)
end
end
@en "Agglomerative"
@fa "خوشه‌بندی تجمیعی"
pub struct Agglomerative:
pub n_clusters: int = 2
pub linkage: int = LINK_AVERAGE
pub labels: matrix.Matrix = matrix.Matrix {}
pub ok: bool = false
@en "fit"
@fa "برازش"
pub func fit(x &: matrix.Matrix): bool:
this.ok = false
n := x.rows
if x.is_empty() or this.n_clusters < 1 or n < this.n_clusters: ret false end
mut cid := Vector {} as Vector<int>
mut size := Vector {} as Vector<int>
repeat n in i:
cid.push(i)
size.push(1)
end
mut d := matrix.Zeros(n, n)
repeat n in i:
repeat n in j:
if j > i:
v := math.Sqrt(_sqdist(x, i, x, j))
d.set(i, j, v)
d.set(j, i, v)
end
end
end
mut alive := n
until alive > this.n_clusters:
mut bi := 0 - 1
mut bj := 0 - 1
mut best := 1.0e300
repeat n in i:
if size.get(i) > 0:
repeat n in j:
if j > i and size.get(j) > 0 and d.at(i, j) < best:
best = d.at(i, j)
bi = i
bj = j
end
end
end
end
if bi < 0: break end
si := size.get(bi) as f64
sj := size.get(bj) as f64
repeat n in t:
if t != bi and t != bj and size.get(t) > 0:
mut nv := d.at(bi, t)
if this.linkage == LINK_SINGLE:
if d.at(bj, t) < nv: nv = d.at(bj, t) end
else this.linkage == LINK_COMPLETE:
if d.at(bj, t) > nv: nv = d.at(bj, t) end
else:
nv = (si * d.at(bi, t) + sj * d.at(bj, t)) / (si + sj)
end
d.set(bi, t, nv)
d.set(t, bi, nv)
end
end
repeat n in r:
if cid.get(r) == bj: cid.set(r, bi) end
end
size.set(bi, size.get(bi) + size.get(bj))
size.set(bj, 0)
alive -= 1
end
matrix.Free(this.labels)
this.labels = matrix.Zeros(n, 1)
mut remap := Vector {} as Vector<int>
remap.zeros(n)
repeat n in i: remap.set(i, 0 - 1) end
mut next := 0
repeat n in r:
c := cid.get(r)
if remap.get(c) < 0:
remap.set(c, next)
next += 1
end
this.labels.set(r, 0, remap.get(c) as f64)
end
cid.free()
size.free()
remap.free()
matrix.Free(d)
this.ok = true
ret true
end
@en "fit_predict"
@fa "برازش سپس پیش‌بینی"
pub func fit_predict(x &: matrix.Matrix): matrix.Matrix:
if this.fit(x) == false: ret matrix.Matrix {} end
ret matrix.Clone(this.labels)
end
@en "free"
@fa "آزادسازی"
pub func free(): matrix.Free(this.labels) end
end
@en "MiniBatchKMeans"
@fa "کی میانگین دسته کوچک"
pub struct MiniBatchKMeans:
pub k: int = 8
pub batch_size: int = 64
pub max_iter: int = 200
pub seed: i64 = 42
pub centers: matrix.Matrix = matrix.Matrix {}
pub ok: bool = false
@en "fit"
@fa "برازش"
pub func fit(x &: matrix.Matrix): bool:
this.ok = false
if x.is_empty() or this.k < 1 or x.rows < this.k: ret false end
n := x.rows
p := x.cols
mut g := matrix.NewRng(this.seed)
matrix.Free(this.centers)
this.centers = _kmeanspp(x, this.k, g)
mut counts := Vector {} as Vector<int>
counts.zeros(this.k)
mut bs := this.batch_size
if bs > n: bs = n end
repeat this.max_iter:
repeat bs:
i := (g.next_float() * (n as f64)) as int
mut bi := 0
mut bd := _sqdist(x, i, this.centers, 0)
repeat this.k - 1 in t:
dd := _sqdist(x, i, this.centers, t + 1)
if dd < bd:
bd = dd
bi = t + 1
end
end
counts.set(bi, counts.get(bi) + 1)
eta := 1.0 / (counts.get(bi) as f64)
repeat p in j:
this.centers.set(bi, j, (1.0 - eta) * this.centers.at(bi, j) + eta * x.at(i, j))
end
end
end
counts.free()
this.ok = true
ret true
end
@en "predict"
@fa "پیش‌بینی"
pub func predict(x &: matrix.Matrix): matrix.Matrix:
if this.ok == false or x.cols != this.centers.cols: ret matrix.Matrix {} end
mut out := matrix.Zeros(x.rows, 1)
repeat x.rows in i:
mut bi := 0
mut bd := _sqdist(x, i, this.centers, 0)
repeat this.k - 1 in t:
dd := _sqdist(x, i, this.centers, t + 1)
if dd < bd:
bd = dd
bi = t + 1
end
end
out.set(i, 0, bi as f64)
end
ret out
end
@en "fit_predict"
@fa "برازش سپس پیش‌بینی"
pub func fit_predict(x &: matrix.Matrix): matrix.Matrix:
if this.fit(x) == false: ret matrix.Matrix {} end
ret this.predict(x)
end
@en "free"
@fa "آزادسازی"
pub func free(): matrix.Free(this.centers) end
end
func _gmm_estep(x &: matrix.Matrix, means &: matrix.Matrix, vars &: matrix.Matrix, weights &: matrix.Matrix, resp &: matrix.Matrix): f64:
n := x.rows
p := x.cols
k := means.rows
half_log_2pi := 0.5 * math.Log(2.0 * math.PI)
mut total := 0.0
repeat n in i:
mut m := 0.0 - 1.0e300
repeat k in c:
mut ll := math.Log(weights.at(c, 0) + 1.0e-300)
repeat p in j:
v := vars.at(c, j)
d := x.at(i, j) - means.at(c, j)
ll -= half_log_2pi + 0.5 * math.Log(v) + d * d / (2.0 * v)
end
resp.set(i, c, ll)
if ll > m: m = ll end
end
mut s := 0.0
repeat k in c:
e := math.Exp(resp.at(i, c) - m)
resp.set(i, c, e)
s += e
end
repeat k in c: resp.set(i, c, resp.at(i, c) / s) end
total += m + math.Log(s)
end
ret total / (n as f64)
end
package ml
import matrix
@en "PCA"
@fa "تحلیل مؤلفه اصلی"
pub struct PCA:
pub n_components: int = 0
pub components: matrix.Matrix = matrix.Matrix {}
pub mean: matrix.Matrix = matrix.Matrix {}
pub explained_variance: matrix.Matrix = matrix.Matrix {}
pub explained_ratio: matrix.Matrix = matrix.Matrix {}
pub ok: bool = false
@en "fit"
@fa "برازش"
pub func fit(x &: matrix.Matrix): bool:
this.ok = false
if x.is_empty() or x.rows < 2: ret false end
mut full := matrix.PCAFit(x)
if full.components.is_empty():
full.free()
ret false
end
mut keep := this.n_components
if keep <= 0 or keep > full.components.cols: keep = full.components.cols end
matrix.Free(this.components)
matrix.Free(this.mean)
matrix.Free(this.explained_variance)
matrix.Free(this.explained_ratio)
this.components = matrix.SubMatrix(full.components, 0, 0, full.components.rows, keep)
this.mean = matrix.Clone(full.center)
this.explained_variance = matrix.SubMatrix(full.variances, 0, 0, 1, keep)
mut total := 0.0
repeat full.variances.count() in t: total += full.variances.a.get(t) end
this.explained_ratio = matrix.Zeros(1, keep)
if total > 0.0:
repeat keep in j: this.explained_ratio.set(0, j, this.explained_variance.at(0, j) / total) end
end
full.free()
this.n_components = keep
this.ok = true
ret true
end
@en "transform"
@fa "تبدیل"
pub func transform(x &: matrix.Matrix): matrix.Matrix:
if this.ok == false or x.cols != this.components.rows: ret matrix.Matrix {} end
mut xc := matrix.Clone(x)
repeat x.rows in i:
repeat x.cols in j: xc.add_at(i, j, 0.0 - this.mean.at(0, j)) end
end
r := matrix.MatMul(xc, this.components)
matrix.Free(xc)
ret r
end
@en "fit_transform"
@fa "برازش سپس تبدیل"
pub func fit_transform(x &: matrix.Matrix): matrix.Matrix:
if this.fit(x) == false: ret matrix.Matrix {} end
ret this.transform(x)
end
@en "inverse_transform"
@fa "تبدیل معکوس"
pub func inverse_transform(z &: matrix.Matrix): matrix.Matrix:
if this.ok == false or z.cols != this.components.cols: ret matrix.Matrix {} end
mut r := matrix.MulTranspose(z, this.components)
repeat r.rows in i:
repeat r.cols in j: r.add_at(i, j, this.mean.at(0, j)) end
end
ret r
end
@en "free"
@fa "آزادسازی"
pub func free():
matrix.Free(this.components)
matrix.Free(this.mean)
matrix.Free(this.explained_variance)
matrix.Free(this.explained_ratio)
end
end
@en "TruncatedSVD"
@fa "تجزیه مقادیر تکین بریده"
pub struct TruncatedSVD:
pub n_components: int = 2
pub components: matrix.Matrix = matrix.Matrix {}
pub singular_values: matrix.Matrix = matrix.Matrix {}
pub explained_variance: matrix.Matrix = matrix.Matrix {}
pub explained_ratio: matrix.Matrix = matrix.Matrix {}
pub ok: bool = false
@en "fit"
@fa "برازش"
pub func fit(x &: matrix.Matrix): bool:
this.ok = false
if x.is_empty(): ret false end
mut k := this.n_components
mut most := x.cols
if x.rows < most: most = x.rows end
if k < 1 or k > most: k = most end
mut f := matrix.SVDecompose(x)
if f.ok == false:
f.free()
ret false
end
matrix.Free(this.components)
matrix.Free(this.singular_values)
matrix.Free(this.explained_variance)
matrix.Free(this.explained_ratio)
this.components = matrix.SubMatrix(f.v, 0, 0, x.cols, k)
this.singular_values = matrix.Zeros(1, k)
this.explained_variance = matrix.Zeros(1, k)
this.explained_ratio = matrix.Zeros(1, k)
nf := (x.rows - 1) as f64
mut total := 0.0
repeat x.rows in i:
repeat x.cols in j: total += x.at(i, j) * x.at(i, j) end
end
repeat k in c:
s := f.s.at(0, c)
this.singular_values.set(0, c, s)
this.explained_variance.set(0, c, nf > 0.0 ? s * s / nf : 0.0)
this.explained_ratio.set(0, c, total > 0.0 ? s * s / total : 0.0)
end
f.free()
this.n_components = k
this.ok = true
ret true
end
@en "transform"
@fa "تبدیل"
pub func transform(x &: matrix.Matrix): matrix.Matrix:
if this.ok == false or x.cols != this.components.rows: ret matrix.Matrix {} end
ret matrix.MatMul(x, this.components)
end
@en "fit_transform"
@fa "برازش سپس تبدیل"
pub func fit_transform(x &: matrix.Matrix): matrix.Matrix:
if this.fit(x) == false: ret matrix.Matrix {} end
ret this.transform(x)
end
@en "inverse_transform"
@fa "تبدیل معکوس"
pub func inverse_transform(z &: matrix.Matrix): matrix.Matrix:
if this.ok == false or z.cols != this.components.cols: ret matrix.Matrix {} end
ret matrix.MulTranspose(z, this.components)
end
@en "free"
@fa "آزادسازی"
pub func free():
matrix.Free(this.components)
matrix.Free(this.singular_values)
matrix.Free(this.explained_variance)
matrix.Free(this.explained_ratio)
end
end
package ml
import math
import matrix
@en "LDA"
@fa "تحلیل تشخیصی خطی"
pub struct LDA:
pub ridge: f64 = 0.000001
pub means: matrix.Matrix = matrix.Matrix {}
pub cov: matrix.Matrix = matrix.Matrix {}
pub log_priors: matrix.Matrix = matrix.Matrix {}
pub n_classes: int = 0
pub ok: bool = false
@en "fit"
@fa "برازش"
pub func fit(x &: matrix.Matrix, y &: matrix.Matrix): bool:
this.ok = false
if x.is_empty() or y.rows != x.rows or y.cols != 1: ret false end
k := CountClasses(y)
if k < 2: ret false end
n := x.rows
p := x.cols
matrix.Free(this.means)
matrix.Free(this.cov)
matrix.Free(this.log_priors)
mut counts := Vector {} as Vector<int>
counts.zeros(k)
this.means = _class_means(x, y, k, counts)
this.log_priors = matrix.Zeros(k, 1)
repeat k in c:
mut pr := (counts.get(c) as f64) / (n as f64)
if pr < 1.0e-12: pr = 1.0e-12 end
this.log_priors.set(c, 0, math.Log(pr))
end
this.cov = matrix.Zeros(p, p)
repeat n in i:
c := y.at(i, 0) as int
repeat p in a:
da := x.at(i, a) - this.means.at(c, a)
repeat p in bb:
this.cov.add_at(a, bb, da * (x.at(i, bb) - this.means.at(c, bb)))
end
end
end
matrix.ScaleInPlace(this.cov, 1.0 / ((n - k) as f64))
repeat p in a: this.cov.add_at(a, a, this.ridge) end
counts.free()
this.n_classes = k
this.ok = true
ret true
end
@en "predict_proba"
@fa "پیش‌بینی احتمال"
pub func predict_proba(x &: matrix.Matrix): matrix.Matrix:
if this.ok == false or x.cols != this.means.cols: ret matrix.Matrix {} end
mut out := matrix.Zeros(x.rows, this.n_classes)
mut inv := matrix.InverseSPD(this.cov)
if inv.is_empty():
matrix.Free(out)
ret matrix.Matrix {}
end
repeat this.n_classes in c:
mut mu := matrix.Row(this.means, c)
mut mut_t := matrix.Transpose(mu)
mut smu := matrix.MatMul(inv, mut_t)
matrix.Free(mut_t)
mut mm := 0.0
repeat x.cols in j: mm += mu.at(0, j) * smu.at(j, 0) end
repeat x.rows in i:
mut s := 0.0
repeat x.cols in j: s += x.at(i, j) * smu.at(j, 0) end
out.set(i, c, s - 0.5 * mm + this.log_priors.at(c, 0))
end
matrix.Free(mu)
matrix.Free(smu)
end
matrix.Free(inv)
_softmax_rows(out)
ret out
end
@en "predict"
@fa "پیش‌بینی"
pub func predict(x &: matrix.Matrix): matrix.Matrix:
mut probs := this.predict_proba(x)
if probs.is_empty(): ret probs end
out := _argmax_rows(probs)
matrix.Free(probs)
ret out
end
@en "score"
@fa "امتیاز"
pub func score(x &: matrix.Matrix, y &: matrix.Matrix): f64:
mut p := this.predict(x)
if p.is_empty(): ret 0.0 end
r := Accuracy(y, p)
matrix.Free(p)
ret r
end
@en "free"
@fa "آزادسازی"
pub func free():
matrix.Free(this.means)
matrix.Free(this.cov)
matrix.Free(this.log_priors)
end
end
@en "QDA"
@fa "تحلیل تشخیصی درجه دو"
pub struct QDA:
pub ridge: f64 = 0.000001
pub means: matrix.Matrix = matrix.Matrix {}
pub covs: Vector<matrix.Matrix> = Vector {}
pub log_priors: matrix.Matrix = matrix.Matrix {}
pub n_classes: int = 0
pub ok: bool = false
@en "fit"
@fa "برازش"
pub func fit(x &: matrix.Matrix, y &: matrix.Matrix): bool:
this.ok = false
if x.is_empty() or y.rows != x.rows or y.cols != 1: ret false end
k := CountClasses(y)
if k < 2: ret false end
n := x.rows
p := x.cols
this.free()
mut counts := Vector {} as Vector<int>
counts.zeros(k)
this.means = _class_means(x, y, k, counts)
this.log_priors = matrix.Zeros(k, 1)
repeat k in c:
mut cov := matrix.Zeros(p, p)
repeat n in i:
if (y.at(i, 0) as int) == c:
repeat p in a:
da := x.at(i, a) - this.means.at(c, a)
repeat p in bb:
cov.add_at(a, bb, da * (x.at(i, bb) - this.means.at(c, bb)))
end
end
end
end
mut denom := counts.get(c) - 1
if denom < 1: denom = 1 end
matrix.ScaleInPlace(cov, 1.0 / (denom as f64))
repeat p in a: cov.add_at(a, a, this.ridge) end
this.covs.push(cov)
mut pr := (counts.get(c) as f64) / (n as f64)
if pr < 1.0e-12: pr = 1.0e-12 end
this.log_priors.set(c, 0, math.Log(pr))
end
counts.free()
this.n_classes = k
this.ok = true
ret true
end
@en "predict_proba"
@fa "پیش‌بینی احتمال"
pub func predict_proba(x &: matrix.Matrix): matrix.Matrix:
if this.ok == false or x.cols != this.means.cols: ret matrix.Matrix {} end
p := x.cols
mut out := matrix.Zeros(x.rows, this.n_classes)
repeat this.n_classes in c:
mut cov := this.covs.get(c)
mut inv := matrix.InverseSPD(cov)
logdet := matrix.LogDetSPD(cov)
if inv.is_empty():
matrix.Free(out)
ret matrix.Matrix {}
end
repeat x.rows in i:
mut q := 0.0
repeat p in a:
da := x.at(i, a) - this.means.at(c, a)
repeat p in bb:
q += da * inv.at(a, bb) * (x.at(i, bb) - this.means.at(c, bb))
end
end
out.set(i, c, 0.0 - 0.5 * q - 0.5 * logdet + this.log_priors.at(c, 0))
end
matrix.Free(inv)
end
_softmax_rows(out)
ret out
end
@en "predict"
@fa "پیش‌بینی"
pub func predict(x &: matrix.Matrix): matrix.Matrix:
mut probs := this.predict_proba(x)
if probs.is_empty(): ret probs end
out := _argmax_rows(probs)
matrix.Free(probs)
ret out
end
@en "score"
@fa "امتیاز"
pub func score(x &: matrix.Matrix, y &: matrix.Matrix): f64:
mut p := this.predict(x)
if p.is_empty(): ret 0.0 end
r := Accuracy(y, p)
matrix.Free(p)
ret r
end
@en "free"
@fa "آزادسازی"
pub func free():
matrix.Free(this.means)
matrix.Free(this.log_priors)
repeat this.covs.len() in c:
mut cv := this.covs.get(c)
matrix.Free(cv)
end
this.covs.free()
end
end
func _class_means(x &: matrix.Matrix, y &: matrix.Matrix, k: int, counts &: Vector<int>): matrix.Matrix:
mut m := matrix.Zeros(k, x.cols)
repeat x.rows in i:
c := y.at(i, 0) as int
counts.set(c, counts.get(c) + 1)
repeat x.cols in j: m.add_at(c, j, x.at(i, j)) end
end
repeat k in c:
if counts.get(c) > 0:
repeat x.cols in j: m.mul_at(c, j, 1.0 / (counts.get(c) as f64)) end
end
end
ret m
end
func _softmax_rows(m &: matrix.Matrix):
repeat m.rows in i:
mut mx := m.at(i, 0)
repeat m.cols in c:
if m.at(i, c) > mx: mx = m.at(i, c) end
end
mut s := 0.0
repeat m.cols in c:
e := math.Exp(m.at(i, c) - mx)
m.set(i, c, e)
s += e
end
repeat m.cols in c: m.set(i, c, m.at(i, c) / s) end
end
end
package ml
import matrix
import pool
mut _rf_x := matrix.Matrix {}
mut _rf_y := matrix.Matrix {}
mut _rf_trees := Vector {} as Vector<DecisionTree>
mut _rf_criterion := 0
mut _rf_depth := 16
mut _rf_leaf := 1
mut _rf_features := 0
mut _rf_bootstrap := true
mut _rf_seed := 0 as i64
mut _rf_classes := 0
@en "RandomForest"
@fa "جنگل تصادفی"
pub struct RandomForest:
pub n_trees: int = 100
pub criterion: int = TREE_GINI
pub max_depth: int = 16
pub min_samples_leaf: int = 1
pub max_features: int = 0
pub bootstrap: bool = true
pub seed: i64 = 42
pub workers: int = 0
pub trees: Vector<DecisionTree> = Vector {}
pub n_classes: int = 0
pub ok: bool = false
@en "is_regression"
@fa "رگرسیون است"
pub func is_regression(): bool: ret this.criterion == TREE_MSE end
@en "fit"
@fa "برازش"
pub func fit(x &: matrix.Matrix, y &: matrix.Matrix): bool:
this.ok = false
if x.is_empty() or y.rows != x.rows or y.cols != 1 or this.n_trees < 1: ret false end
this.free_trees()
mut mf := this.max_features
if mf <= 0:
if this.is_regression():
mf = x.cols / 3
else:
mf = _isqrt(x.cols)
end
if mf < 1: mf = 1 end
end
_rf_x = x
_rf_y = y
_rf_criterion = this.criterion
_rf_depth = this.max_depth
_rf_leaf = this.min_samples_leaf
_rf_features = mf
_rf_bootstrap = this.bootstrap
_rf_seed = this.seed
_rf_classes = 0
if this.is_regression() == false: _rf_classes = CountClasses(y) end
_rf_trees = Vector {} as Vector<DecisionTree>
repeat this.n_trees: _rf_trees.push(DecisionTree {}) end
mut w := this.workers
if w < 0: w = pool.CPUCount() as int end
if w <= 1:
repeat this.n_trees in t: _rf_fit_one(t as i64) end
else:
pool.ParallelFor(this.n_trees as i64, w as i64, (i: i64): _rf_fit_one(i) end)
end
this.trees = _rf_trees
_rf_trees = Vector {} as Vector<DecisionTree>
if this.is_regression(): this.n_classes = 1
else:
this.n_classes = CountClasses(y)
end
this.ok = true
ret true
end
@en "predict_proba"
@fa "پیش‌بینی احتمال"
pub func predict_proba(x &: matrix.Matrix): matrix.Matrix:
if this.ok == false or this.is_regression(): ret matrix.Matrix {} end
mut out := matrix.Zeros(x.rows, this.n_classes)
repeat this.trees.len() in t:
mut tree := this.trees.get(t)
mut p := tree.predict_proba(x)
if p.is_empty() == false and p.cols == this.n_classes: matrix.AddInPlace(out, p) end
matrix.Free(p)
end
matrix.ScaleInPlace(out, 1.0 / (this.trees.len() as f64))
ret out
end
@en "predict"
@fa "پیش‌بینی"
pub func predict(x &: matrix.Matrix): matrix.Matrix:
if this.ok == false: ret matrix.Matrix {} end
if this.is_regression():
mut out := matrix.Zeros(x.rows, 1)
repeat this.trees.len() in t:
mut tree := this.trees.get(t)
mut p := tree.predict(x)
if p.is_empty() == false: matrix.AddInPlace(out, p) end
matrix.Free(p)
end
matrix.ScaleInPlace(out, 1.0 / (this.trees.len() as f64))
ret out
end
mut probs := this.predict_proba(x)
mut out := matrix.Zeros(x.rows, 1)
repeat x.rows in i:
mut best := 0
repeat this.n_classes in c:
if probs.at(i, c) > probs.at(i, best): best = c end
end
out.set(i, 0, best as f64)
end
matrix.Free(probs)
ret out
end
@en "score"
@fa "امتیاز"
pub func score(x &: matrix.Matrix, y &: matrix.Matrix): f64:
mut p := this.predict(x)
if p.is_empty(): ret 0.0 end
mut r := 0.0
if this.is_regression(): r = R2Score(y, p)
else:
r = Accuracy(y, p)
end
matrix.Free(p)
ret r
end
@en "free_trees"
@fa "آزادسازی درخت‌ها"
pub func free_trees():
repeat this.trees.len() in t:
mut tree := this.trees.get(t)
tree.free()
end
this.trees.free()
end
@en "free"
@fa "آزادسازی"
pub func free(): this.free_trees() end
end
func _isqrt(n: int): int:
mut r := 0
until (r + 1) * (r + 1) <= n: r += 1 end
ret r
end
func _derive_seed(seed: i64, index: i64): i64:
ret seed + (0 - 7046029254386353131) * (index + 1)
end
func _rf_fit_one(t: i64):
n := _rf_x.rows
seed := _derive_seed(_rf_seed, t)
mut g := matrix.NewRng(seed)
mut xb := matrix.Matrix {}
mut yb := matrix.Matrix {}
if _rf_bootstrap:
xb = matrix.Zeros(n, _rf_x.cols)
yb = matrix.Zeros(n, 1)
repeat n in i:
src := (g.next_float() * (n as f64)) as int
repeat _rf_x.cols in j: xb.set(i, j, _rf_x.at(src, j)) end
yb.set(i, 0, _rf_y.at(src, 0))
end
else:
xb = matrix.Clone(_rf_x)
yb = matrix.Clone(_rf_y)
end
mut tree := DecisionTree {}
tree.criterion = _rf_criterion
tree.max_depth = _rf_depth
tree.min_samples_leaf = _rf_leaf
tree.max_features = _rf_features
tree.seed = seed + 1
tree.n_classes_hint = _rf_classes
tree.fit(xb, yb)
_rf_trees.set(t as int, tree)
matrix.Free(xb)
matrix.Free(yb)
end
package ml
import math
import matrix
import sort
@en "HistTree"
@fa "درخت هیستوگرام"
pub struct HistTree:
pub feature: Vector<int> = Vector {}
pub threshold: Vector<f64> = Vector {}
pub left: Vector<int> = Vector {}
pub right: Vector<int> = Vector {}
pub value: Vector<f64> = Vector {}
@en "apply_row"
@fa "اعمال سطر"
pub func apply_row(x &: matrix.Matrix, i: int): f64:
mut nd := 0
until this.feature.get(nd) >= 0:
if x.at(i, this.feature.get(nd)) <= this.threshold.get(nd):
nd = this.left.get(nd)
else:
nd = this.right.get(nd)
end
end
ret this.value.get(nd)
end
@en "free"
@fa "آزادسازی"
pub func free():
this.feature.free()
this.threshold.free()
this.left.free()
this.right.free()
this.value.free()
end
end
@en "HistGradientBoosting"
@fa "تقویت گرادیان هیستوگرامی"
pub struct HistGradientBoosting:
pub n_estimators: int = 100
pub learning_rate: f64 = 0.1
pub max_depth: int = 6
pub max_bins: int = 255
pub min_samples_leaf: int = 20
pub l2: f64 = 1.0
pub regression: bool = false
pub edges: Vector<f64> = Vector {}
pub edges_start: Vector<int> = Vector {}
pub base: Vector<f64> = Vector {}
pub trees: Vector<HistTree> = Vector {}
pub n_classes: int = 0
pub ok: bool = false
@en "fit"
@fa "برازش"
pub func fit(x &: matrix.Matrix, y &: matrix.Matrix): bool:
this.free_all()
this.ok = false
n := x.rows
p := x.cols
if n < 2 or p < 1 or y.rows != n: ret false end
kk := this.regression ? 1 : CountClasses(y)
if not this.regression and kk < 2: ret false end
this.n_classes = kk
mut bins := Vector {} as Vector<int>
repeat n * p: bins.push(0) end
_hist_bin_features(x, this.max_bins, this.edges, this.edges_start, bins)
repeat kk: this.base.push(0.0) end
if this.regression:
mut s := 0.0
repeat n in i: s += y.at(i, 0) end
this.base.set(0, s / (n as f64))
else:
mut counts := Vector {} as Vector<f64>
repeat kk: counts.push(1.0) end
repeat n in i:
c := y.at(i, 0) as int
counts.set(c, counts.get(c) + 1.0)
end
repeat kk in c: this.base.set(c, math.Log(counts.get(c) / ((n + kk) as f64))) end
counts.free()
end
mut f := Vector {} as Vector<f64>
repeat n:
repeat kk in c: f.push(this.base.get(c)) end
end
mut g := Vector {} as Vector<f64>
mut h := Vector {} as Vector<f64>
repeat n:
g.push(0.0)
h.push(0.0)
end
mut probs := Vector {} as Vector<f64>
repeat kk: probs.push(0.0) end
edges := this.edges
starts := this.edges_start
repeat this.n_estimators:
repeat kk in c:
repeat n in i:
if this.regression:
g.set(i, f.get(i) - y.at(i, 0))
h.set(i, 1.0)
else:
_softmax_row(f, i, kk, probs)
pc := probs.get(c)
target := (y.at(i, 0) as int) == c ? 1.0 : 0.0
g.set(i, pc - target)
h.set(i, pc * (1.0 - pc) + 0.000001)
end
end
mut t := HistTree {}
_hist_grow(t, bins, n, p, edges, starts, g, h, this.max_depth, this.min_samples_leaf, this.l2, this.learning_rate)
repeat n in i: f.set(i * kk + c, f.get(i * kk + c) + t.apply_row(x, i)) end
this.trees.push(t)
end
end
bins.free()
f.free()
g.free()
h.free()
probs.free()
this.ok = true
ret true
end
@en "decision"
@fa "تصمیم"
pub func decision(x &: matrix.Matrix): matrix.Matrix:
if not this.ok: ret matrix.Matrix {} end
kk := this.n_classes
mut out := matrix.Zeros(x.rows, kk)
repeat x.rows in i:
repeat kk in c: out.set(i, c, this.base.get(c)) end
end
repeat this.trees.len() in ti:
c := ti % kk
t := this.trees.get(ti)
repeat x.rows in i: out.add_at(i, c, t.apply_row(x, i)) end
end
ret out
end
@en "predict_proba"
@fa "پیش‌بینی احتمال"
pub func predict_proba(x &: matrix.Matrix): matrix.Matrix:
mut out := this.decision(x)
if out.is_empty() or this.regression: ret out end
kk := this.n_classes
mut probs := Vector {} as Vector<f64>
repeat kk: probs.push(0.0) end
repeat x.rows in i:
_softmax_row(out.a, i, kk, probs)
repeat kk in c: out.set(i, c, probs.get(c)) end
end
probs.free()
ret out
end
@en "predict"
@fa "پیش‌بینی"
pub func predict(x &: matrix.Matrix): matrix.Matrix:
mut d := this.decision(x)
if d.is_empty() or this.regression: ret d end
out := _argmax_rows(d)
matrix.Free(d)
ret out
end
@en "score"
@fa "امتیاز"
pub func score(x &: matrix.Matrix, y &: matrix.Matrix): f64:
mut pred := this.predict(x)
if pred.is_empty(): ret 0.0 end
s := this.regression ? R2Score(y, pred) : Accuracy(y, pred)
matrix.Free(pred)
ret s
end
@en "free_all"
@fa "آزادسازی همه"
pub func free_all():
this.edges.free()
this.edges_start.free()
this.base.free()
repeat this.trees.len() in i:
mut t := this.trees.get(i)
t.free()
end
this.trees.free()
end
@en "free"
@fa "آزادسازی"
pub func free(): this.free_all() end
end
func _hist_bin_features(x &: matrix.Matrix, max_bins: int, edges &: Vector<f64>, starts &: Vector<int>, bins &: Vector<int>):
n := x.rows
p := x.cols
mut col := Vector {} as Vector<f64>
repeat p in j:
starts.push(edges.len())
col.clear()
repeat n in i: col.push(x.at(i, j)) end
sort.Sort(col)
mut last := 0.0
mut have := false
repeat max_bins - 1 in b:
e := col.get(((b + 1) * n) / max_bins)
if e >= col.get(n - 1): continue end
if have and e <= last: continue end
edges.push(e)
last = e
have = true
end
end
starts.push(edges.len())
repeat p in j:
lo := starts.get(j)
hi := starts.get(j + 1)
repeat n in i:
v := x.at(i, j)
mut a := lo
mut b := hi
until a < b:
mid := (a + b) / 2
if edges.get(mid) < v: a = mid + 1 else:
b = mid
end
end
bins.set(i * p + j, a - lo)
end
end
col.free()
end
func _softmax_row(f &: Vector<f64>, i: int, kk: int, probs &: Vector<f64>):
mut mx := f.get(i * kk)
repeat kk in c:
if f.get(i * kk + c) > mx: mx = f.get(i * kk + c) end
end
mut s := 0.0
repeat kk in c:
e := math.Exp(f.get(i * kk + c) - mx)
probs.set(c, e)
s += e
end
repeat kk in c: probs.set(c, probs.get(c) / s) end
end
func _hist_leaf(t &: HistTree, value: f64): int:
id := t.feature.len()
t.feature.push(0 - 1)
t.threshold.push(0.0)
t.left.push(0 - 1)
t.right.push(0 - 1)
t.value.push(value)
ret id
end
func _hist_grow(t &: HistTree, bins &: Vector<int>, n: int, p: int, edges &: Vector<f64>, starts &: Vector<int>, g &: Vector<f64>, h &: Vector<f64>, max_depth: int, min_leaf: int, l2: f64, lr: f64):
mut rows := Vector {} as Vector<int>
repeat n in i: rows.push(i) end
mut st_node := Vector {} as Vector<int>
mut st_lo := Vector {} as Vector<int>
mut st_hi := Vector {} as Vector<int>
mut st_depth := Vector {} as Vector<int>
root := _hist_leaf(t, 0.0)
st_node.push(root)
st_lo.push(0)
st_hi.push(n)
st_depth.push(0)
mut hg := Vector {} as Vector<f64>
mut hh := Vector {} as Vector<f64>
mut hc := Vector {} as Vector<int>
until st_node.len() > 0:
nd := st_node.pop()
lo := st_lo.pop()
hi := st_hi.pop()
depth := st_depth.pop()
mut gs := 0.0
mut hs := 0.0
repeat hi - lo in r:
i := rows.get(lo + r)
gs += g.get(i)
hs += h.get(i)
end
t.value.set(nd, 0.0 - lr * gs / (hs + l2))
if depth >= max_depth or hi - lo < 2 * min_leaf: continue end
parent_gain := gs * gs / (hs + l2)
mut best_gain := 0.0
mut best_f := 0 - 1
mut best_b := 0
repeat p in j:
nb := starts.get(j + 1) - starts.get(j) + 1
if nb < 2: continue end
hg.clear()
hh.clear()
hc.clear()
repeat nb:
hg.push(0.0)
hh.push(0.0)
hc.push(0)
end
repeat hi - lo in r:
i := rows.get(lo + r)
b := bins.get(i * p + j)
hg.set(b, hg.get(b) + g.get(i))
hh.set(b, hh.get(b) + h.get(i))
hc.set(b, hc.get(b) + 1)
end
mut gl := 0.0
mut hl := 0.0
mut cl := 0
repeat nb - 1 in b:
gl += hg.get(b)
hl += hh.get(b)
cl += hc.get(b)
cr := hi - lo - cl
if cl < min_leaf or cr < min_leaf: continue end
gr := gs - gl
hr := hs - hl
gain := gl * gl / (hl + l2) + gr * gr / (hr + l2) - parent_gain
if gain > best_gain:
best_gain = gain
best_f = j
best_b = b
end
end
end
if best_f < 0: continue end
mut a := lo
mut b2 := hi - 1
until a <= b2:
if bins.get(rows.get(a) * p + best_f) <= best_b:
a += 1
else:
tmp := rows.get(a)
rows.set(a, rows.get(b2))
rows.set(b2, tmp)
b2 -= 1
end
end
mid := a
left := _hist_leaf(t, 0.0)
right := _hist_leaf(t, 0.0)
t.feature.set(nd, best_f)
t.threshold.set(nd, edges.get(starts.get(best_f) + best_b))
t.left.set(nd, left)
t.right.set(nd, right)
st_node.push(left)
st_lo.push(lo)
st_hi.push(mid)
st_depth.push(depth + 1)
st_node.push(right)
st_lo.push(mid)
st_hi.push(hi)
st_depth.push(depth + 1)
end
rows.free()
st_node.free()
st_lo.free()
st_hi.free()
st_depth.free()
hg.free()
hh.free()
hc.free()
end
package ml
import matrix
import pool
import sort
@en "KNN_BRUTE"
@fa "همسایه جستجوی کامل"
pub const KNN_BRUTE := 0
@en "KNN_KDTREE"
@fa "همسایه درخت کی‌دی"
pub const KNN_KDTREE := 1
mut _knn_q := matrix.Matrix {}
mut _knn_xtrain := matrix.Matrix {}
mut _knn_ytrain := matrix.Matrix {}
mut _knn_tree := KDTree {}
mut _knn_out := matrix.Matrix {}
mut _knn_k := 5
mut _knn_weighted := false
mut _knn_classes := 0
mut _knn_alg := 0
@en "KDTree"
@fa "درخت کی‌دی"
pub struct KDTree:
pub leaf_size: int = 16
pub x: matrix.Matrix = matrix.Matrix {}
pub idx: Vector<int> = Vector {}
pub node_lo: Vector<int> = Vector {}
pub node_hi: Vector<int> = Vector {}
pub node_dim: Vector<int> = Vector {}
pub node_split: Vector<f64> = Vector {}
pub node_left: Vector<int> = Vector {}
pub node_right: Vector<int> = Vector {}
pub ok: bool = false
@en "build"
@fa "ساخت"
pub func build(x &: matrix.Matrix): bool:
this.free()
this.ok = false
if x.is_empty(): ret false end
this.x = matrix.Clone(x)
repeat x.rows in i: this.idx.push(i) end
mut me := KDTree {}
me.leaf_size = this.leaf_size
me.x = this.x
me.idx = this.idx
_kd_build(me)
this.node_lo = me.node_lo
this.node_hi = me.node_hi
this.node_dim = me.node_dim
this.node_split = me.node_split
this.node_left = me.node_left
this.node_right = me.node_right
this.ok = true
ret true
end
@en "node_count"
@fa "شمار گره"
pub func node_count(): int: ret this.node_lo.len() end
@en "query"
@fa "پرس‌وجو"
pub func query(q &: matrix.Matrix, qi: int, k: int, dist_out &: Vector<f64>): Vector<int>:
mut out := Vector {} as Vector<int>
dist_out.clear()
if not this.ok or k <= 0 or q.cols != this.x.cols: ret out end
mut me := KDTree {}
me.x = this.x
me.idx = this.idx
me.node_lo = this.node_lo
me.node_hi = this.node_hi
me.node_dim = this.node_dim
me.node_split = this.node_split
me.node_left = this.node_left
me.node_right = this.node_right
_kd_query(me, q, qi, k, out, dist_out)
ret out
end
@en "free"
@fa "آزادسازی"
pub func free():
this.x.free()
this.idx.free()
this.node_lo.free()
this.node_hi.free()
this.node_dim.free()
this.node_split.free()
this.node_left.free()
this.node_right.free()
this.ok = false
end
end
func _kd_build(t &: KDTree):
p := t.x.cols
mut stack := Vector {} as Vector<int>
t.node_lo.push(0)
t.node_hi.push(t.idx.len())
t.node_dim.push(0 - 1)
t.node_split.push(0.0)
t.node_left.push(0 - 1)
t.node_right.push(0 - 1)
stack.push(0)
until stack.len() > 0:
nd := stack.pop()
lo := t.node_lo.get(nd)
hi := t.node_hi.get(nd)
if hi - lo <= t.leaf_size: continue end
mut best_d := 0
mut best_w := 0.0 - 1.0
repeat p in dd:
mut mn := t.x.at(t.idx.get(lo), dd)
mut mx := mn
repeat hi - lo in r:
v := t.x.at(t.idx.get(lo + r), dd)
if v < mn: mn = v end
if v > mx: mx = v end
end
if mx - mn > best_w:
best_w = mx - mn
best_d = dd
end
end
if best_w <= 0.0: continue end
mut part := Vector {} as Vector<int>
mut keys := Vector {} as Vector<f64>
keys.zeros(t.x.rows)
repeat hi - lo in r:
row := t.idx.get(lo + r)
part.push(row)
keys.set(row, t.x.at(row, best_d))
end
sort.SortIndex(part, keys)
repeat hi - lo in r: t.idx.set(lo + r, part.get(r)) end
part.free()
keys.free()
mid := (lo + hi) / 2
t.node_dim.set(nd, best_d)
t.node_split.set(nd, t.x.at(t.idx.get(mid), best_d))
left := t.node_lo.len()
t.node_lo.push(lo)
t.node_hi.push(mid)
t.node_dim.push(0 - 1)
t.node_split.push(0.0)
t.node_left.push(0 - 1)
t.node_right.push(0 - 1)
right := t.node_lo.len()
t.node_lo.push(mid)
t.node_hi.push(hi)
t.node_dim.push(0 - 1)
t.node_split.push(0.0)
t.node_left.push(0 - 1)
t.node_right.push(0 - 1)
t.node_left.set(nd, left)
t.node_right.set(nd, right)
stack.push(left)
stack.push(right)
end
stack.free()
end
func _kd_offer(best_i &: Vector<int>, best_d &: Vector<f64>, k: int, i: int, d: f64):
if best_i.len() == k and d >= best_d.get(k - 1): ret end
mut pos := best_i.len()
until pos > 0 and best_d.get(pos - 1) > d: pos -= 1 end
best_i.insert(pos, i)
best_d.insert(pos, d)
if best_i.len() > k:
_i := best_i.remove_at(k)
_d := best_d.remove_at(k)
end
end
func _kd_query(t &: KDTree, q &: matrix.Matrix, qi: int, k: int, out &: Vector<int>, dist_out &: Vector<f64>):
p := t.x.cols
mut nodes := Vector {} as Vector<int>
mut bounds := Vector {} as Vector<f64>
nodes.push(0)
bounds.push(0.0)
until nodes.len() > 0:
nd := nodes.pop()
bound := bounds.pop()
if out.len() == k and bound >= dist_out.get(k - 1): continue end
dd := t.node_dim.get(nd)
if dd < 0:
lo := t.node_lo.get(nd)
hi := t.node_hi.get(nd)
repeat hi - lo in r:
row := t.idx.get(lo + r)
mut s := 0.0
repeat p in j:
v := q.at(qi, j) - t.x.at(row, j)
s += v * v
end
_kd_offer(out, dist_out, k, row, s)
end
continue
end
diff := q.at(qi, dd) - t.node_split.get(nd)
mut near := t.node_left.get(nd)
mut far := t.node_right.get(nd)
if diff >= 0.0:
near = t.node_right.get(nd)
far = t.node_left.get(nd)
end
far_bound := diff * diff > bound ? diff * diff : bound
nodes.push(far)
bounds.push(far_bound)
nodes.push(near)
bounds.push(bound)
end
nodes.free()
bounds.free()
end
func _knn_one(q &: matrix.Matrix, xtrain &: matrix.Matrix, ytrain &: matrix.Matrix, tree &: KDTree, out &: matrix.Matrix, qi: int, k: int, weighted: bool, classes: int, alg: int):
mut dist := Vector {} as Vector<f64>
mut nb := Vector {} as Vector<int>
if alg == KNN_KDTREE:
nb = tree.query(q, qi, k, dist)
else:
nb = _nearest(xtrain, q, qi, k, dist)
end
mut total := 0.0
mut acc := 0.0
repeat nb.len() in t:
mut wgt := 1.0
if weighted: wgt = 1.0 / (dist.get(t) + 0.000000001) end
yv := ytrain.at(nb.get(t), 0)
if classes > 0:
out.add_at(qi, yv as int, wgt)
else:
acc += wgt * yv
end
total += wgt
end
if total > 0.0:
if classes > 0:
repeat classes in c: out.set(qi, c, out.at(qi, c) / total) end
else:
out.set(qi, 0, acc / total)
end
end
nb.free()
dist.free()
end
func _knn_row(qi64: i64):
_knn_one(_knn_q, _knn_xtrain, _knn_ytrain, _knn_tree, _knn_out, qi64 as int, _knn_k, _knn_weighted, _knn_classes, _knn_alg)
end
func _knn_run(q &: matrix.Matrix, xtrain &: matrix.Matrix, ytrain &: matrix.Matrix, tree &: KDTree, out &: matrix.Matrix, k: int, weighted: bool, classes: int, alg: int, workers: int):
mut w := workers
if w < 0: w = pool.CPUCount() as int end
if w <= 1:
repeat q.rows in i: _knn_one(q, xtrain, ytrain, tree, out, i, k, weighted, classes, alg) end
ret
end
_knn_q = q
_knn_xtrain = xtrain
_knn_ytrain = ytrain
_knn_tree = tree
_knn_out = out
_knn_k = k
_knn_weighted = weighted
_knn_classes = classes
_knn_alg = alg
pool.ParallelFor(q.rows as i64, w as i64, (i: i64): _knn_row(i) end)
_knn_q = matrix.Matrix {}
_knn_xtrain = matrix.Matrix {}
_knn_ytrain = matrix.Matrix {}
_knn_tree = KDTree {}
_knn_out = matrix.Matrix {}
end
@en "NewKDTree"
@fa "درخت کی‌دی جدید"
pub func NewKDTree(x &: matrix.Matrix, leaf_size: int): KDTree:
mut t := KDTree {}
if leaf_size > 0: t.leaf_size = leaf_size end
_ok := t.build(x)
ret t
end
package ml
import math
import matrix
@en "LinearReg"
@fa "رگرسیون خطی"
pub struct LinearReg:
pub fit_intercept: bool = true
pub coef: matrix.Matrix = matrix.Matrix {}
pub intercept: f64 = 0.0
pub ok: bool = false
@en "fit"
@fa "برازش"
pub func fit(x &: matrix.Matrix, y &: matrix.Matrix): bool:
this.ok = false
if x.is_empty() or y.rows != x.rows or y.cols != 1: ret false end
mut xm := matrix.Zeros(1, x.cols)
mut ym := 0.0
mut xc := _centered(x, this.fit_intercept, xm)
mut yc := _centered_col(y, this.fit_intercept, ym)
w := matrix.LeastSquares(xc, yc)
matrix.Free(xc)
matrix.Free(yc)
if w.is_empty():
matrix.Free(xm)
ret false
end
matrix.Free(this.coef)
this.coef = w
this.intercept = _intercept_of(xm, ym, this.coef)
matrix.Free(xm)
this.ok = true
ret true
end
@en "predict"
@fa "پیش‌بینی"
pub func predict(x &: matrix.Matrix): matrix.Matrix:
if this.ok == false or x.cols != this.coef.rows: ret matrix.Matrix {} end
ret _linear_predict(x, this.coef, this.intercept)
end
@en "score"
@fa "امتیاز"
pub func score(x &: matrix.Matrix, y &: matrix.Matrix): f64:
mut p := this.predict(x)
if p.is_empty(): ret 0.0 end
r := R2Score(y, p)
matrix.Free(p)
ret r
end
