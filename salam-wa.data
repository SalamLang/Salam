d16 := _vp8_sse_rect(sb, ws, _VP8_YOFF, 16, 16)
_vp8_copy9(top_nz, tbase, tn)
_vp8_copy9(left_nz, 0, ln)
dry.bits = 0
_vp8w_put(dry, 1, 145)
_vp8_ymode_bits(dry, ymode)
_vp8_tokens_y(dry, false, lv16, tn, ln)
score16 := dry.bits * lambda_mode + 256 * d16
repeat 16 in j:
repeat 16 in i:
save[_VP8_YOFF + j * _VP8_BPS + i] = ws[_VP8_YOFF + j * _VP8_BPS + i]
end
end
dry.bits = 0
_vp8w_put(dry, 0, 145)
mut total4 := dry.bits * lambda_mode
mut is4 := true
