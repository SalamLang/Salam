a1 := (27 * a + 63) >> 7
a2 := (18 * a + 63) >> 7
a3 := (9 * a + 63) >> 7
pl[p - 3 * step] = _vp8_clamp(p2 + a3, 255) as u8
pl[p - 2 * step] = _vp8_clamp(p1 + a2, 255) as u8
pl[p - step] = _vp8_clamp(p0 + a1, 255) as u8
pl[p] = _vp8_clamp(q0 - a1, 255) as u8
pl[p + step] = _vp8_clamp(q1 - a2, 255) as u8
pl[p + 2 * step] = _vp8_clamp(q2 - a3, 255) as u8
end
func _vp8_needs(pl: u8*, p: int, step: int, t: int): bool:
ret 4 * _vp8_abs(_vp8_pg(pl, p - step) - _vp8_pg(pl, p)) + _vp8_abs(_vp8_pg(pl, p - 2 * step) - _vp8_pg(pl, p + step)) <= t
end
func _vp8_needs2(pl: u8*, p: int, step: int, t: int, it: int): bool:
if not _vp8_needs(pl, p, step, t):
