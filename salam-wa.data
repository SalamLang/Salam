repeat 16 in i:
o.v[i] = a.v[i] - b.v[i]
end
ret o
end
func _gf_car(o &: Gf):
repeat 16 in i:
o.v[i] += (1 as i64) << (16 as i64)
c := o.v[i] >> (16 as i64)
if i < 15:
o.v[i + 1] += c - 1
else:
o.v[0] += 38 * (c - 1)
end
o.v[i] -= c << (16 as i64)
end
end
func _gf_mul(a: Gf, b: Gf): Gf:
