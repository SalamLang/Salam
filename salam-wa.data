mut eb := tensor.Expand(b, shape)
shape.free()
out := tensor.Clone(ea)
p := out.data.data
pb := eb.data.data
repeat out.numel() in k: p[k] = math.Pow(p[k] as f64, pb[k] as f64) as f32 end
ea.free()
eb.free()
_emit(node, env, 0, out)
ret true
end
func _variadic(model &: Model, node &: Node, env &: _Env): bool:
