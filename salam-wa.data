hi2 := a.lo
lo2 := a.hi
if m == 0:
ret _u64(hi2, lo2)
end
nlo := lo2 / POW2[m] + (hi2 % POW2[m]) * POW2[32 - m]
nhi := hi2 / POW2[m] + (lo2 % POW2[m]) * POW2[32 - m]
ret _u64(nhi % 4294967296, nlo % 4294967296)
end
func _shr64(a: U64Pair, n: int): U64Pair:
if n == 0:
ret a
end
if n < 32:
nlo := a.lo / POW2[n] + (a.hi % POW2[n]) * POW2[32 - n]
nhi := a.hi / POW2[n]
ret _u64(nhi % 4294967296, nlo % 4294967296)
end
if n < 64:
m := n - 32
mut nlo := a.hi
if m > 0:
nlo = a.hi / POW2[m]
end
ret _u64(0, nlo % 4294967296)
end
ret _u64(0, 0)
end
noret func _crypto_fatal():
abort()
end
func _os_random_fill(buf: void*, n: int):
if SALAM_OS_WINDOWS:
tmp := mem.Allocate(4 as u64)
defer mem.Free(tmp)
mut filled := 0
until filled < n:
rc := rand_s(tmp)
if rc != 0:
_crypto_fatal()
end
mut k := 0
until k < 4 and filled < n:
_bput(buf, filled, _bget(tmp, k))
filled += 1
k += 1
end
end
else:
f := fopen("/dev/urandom", "rb")
if f == null:
_crypto_fatal()
end
mut total := 0
until total < n:
dst := ((buf as i64) + total) as void*
got := fread(dst, 1 as u64, (n - total) as u64, f)
if got == (0 as u64):
fclose(f)
_crypto_fatal()
end
total += got as int
end
fclose(f)
end
end
inline func _or32(a: i64, b: i64): i64:
ret (a | b) & (4294967295 as i64)
