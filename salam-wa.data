if SALAM_OS_WINDOWS:
const _SEND_FLAGS := 0
else SALAM_OS_MAC:
const _SEND_FLAGS := 0
else SALAM_OS_FREEBSD:
const _SEND_FLAGS := 131072
else SALAM_OS_OPENBSD or SALAM_OS_NETBSD:
const _SEND_FLAGS := 1024
else:
const _SEND_FLAGS := 16384
end
@en "AF_INET"
@fa "خانواده آی‌پی۴"
pub const AF_INET := 2
@en "SOCK_STREAM"
@fa "سوکت جریانی"
pub const SOCK_STREAM := 1
@en "SOCK_DGRAM"
@fa "سوکت داده‌نگاری"
pub const SOCK_DGRAM := 2
if SALAM_OS_WINDOWS:
@en "AF_INET6"
@fa "خانواده آی‌پی۶"
pub const AF_INET6 := 23
else SALAM_OS_MAC:
@en "AF_INET6"
@fa "خانواده آی‌پی۶"
pub const AF_INET6 := 30
else SALAM_OS_FREEBSD:
@en "AF_INET6"
@fa "خانواده آی‌پی۶"
pub const AF_INET6 := 28
else SALAM_OS_OPENBSD or SALAM_OS_NETBSD:
@en "AF_INET6"
@fa "خانواده آی‌پی۶"
pub const AF_INET6 := 24
else:
@en "AF_INET6"
@fa "خانواده آی‌پی۶"
pub const AF_INET6 := 10
end
@en "ShutRd"
@fa "بستن خواندن"
pub const ShutRd := 0
@en "ShutWr"
@fa "بستن نوشتن"
pub const ShutWr := 1
@en "ShutRdWr"
@fa "بستن دوطرفه"
pub const ShutRdWr := 2
const _SHUT_BOTH := 2
if SALAM_OS_WINDOWS:
mut _rawsock_wsa_init := 0
end
@en "Socket"
@fa "سوکت"
pub struct Socket:
pub fd: i64 = 0 - 1
pub family: int = AF_INET
end
if SALAM_OS_WINDOWS:
func _net_init():
if _rawsock_wsa_init == 0:
wsa := mem.Allocate(512 as u64)
WSAStartup(514, wsa)
mem.Free(wsa)
_rawsock_wsa_init = 1
end
end
end
func _sk(fd: i64): usize:
ret fd as usize
end
func _fd_of(s: usize): i64:
if s == (0 - 1) as usize: ret 0 - 1 end
ret s as i64
end
func _hostent_addr4(he: void*): int:
listp := (he as i64 + 24) as i64*
list := listp[0]
if list == 0: ret 0 end
addrp := list as i64*
addr := addrp[0]
if addr == 0: ret 0 end
bytes := addr as int*
ret bytes[0]
end
func _resolve_addr4(host: str): int:
he := gethostbyname(host)
if he == null: ret 0 end
ret _hostent_addr4(he)
end
func _make_sa4(h_addr: int, port: int): void*:
sa := mem.Allocate(16 as u64)
memset(sa, 0, 16 as u64)
sa32 := sa as int*
port_n := htons(port)
packed := (port_n as i64) * 65536 + AF_INET
sa32[0] = packed as int
sa32[1] = h_addr
ret sa
end
func _ai_family(ai: void*): int: ret ((ai as i64 + 4) as int*)[0] end
func _ai_addrlen(ai: void*): i64:
if SALAM_OS_WINDOWS:
ret ((ai as i64 + 16) as i64*)[0]
else:
ret ((ai as i64 + 16) as int*)[0]
end
end
func _ai_addr(ai: void*): void*:
if SALAM_OS_LINUX:
ret ((ai as i64 + 24) as i64*)[0] as void*
else:
ret ((ai as i64 + 32) as i64*)[0] as void*
end
end
func _ai_next(ai: void*): void*: ret ((ai as i64 + 40) as i64*)[0] as void* end
func _try_connect(sa: void*, alen: int, fam: int, socktype: int): Socket:
if SALAM_OS_WINDOWS:
s := _fd_of(socket(fam, socktype, 0))
if s == (0 - 1 as i64):
ret Socket { fd = 0 - 1, family = fam }
end
if connect(_sk(s), sa, alen) != 0:
closesocket(_sk(s))
ret Socket { fd = 0 - 1, family = fam }
end
ret Socket { fd = s, family = fam }
else:
s := socket(fam, socktype, 0)
if s == 0 - 1:
ret Socket { fd = 0 - 1, family = fam }
end
if connect(s, sa, alen) != 0:
close(s)
ret Socket { fd = 0 - 1, family = fam }
end
_no_sigpipe(s as i64)
ret Socket { fd = s as i64, family = fam }
end
end
func _resolve_all(host: str, port: int, addrs &: Vector<i64>, lens &: Vector<int>, fams &: Vector<int>):
hints := mem.Allocate(48 as u64)
defer mem.Free(hints)
memset(hints, 0, 48 as u64)
hp := hints as int*
hp[2] = SOCK_STREAM
res_slot := mem.Allocate(8 as u64)
defer mem.Free(res_slot)
rp := res_slot as i64*
rp[0] = 0
port_str := str.FromInt(port as i64)
if getaddrinfo(host, port_str, hints, res_slot) != 0:
ret
end
res := rp[0] as void*
if res == null:
ret
end
defer freeaddrinfo(res)
mut cur := res
until cur != null:
mut alen := 0
sa := _copy_sockaddr(cur, alen)
addrs.push(sa as i64)
lens.push(alen)
fams.push(_ai_family(cur))
cur = _ai_next(cur)
end
end
func _copy_sockaddr(ai: void*, out_len &: int): void*:
alen := _ai_addrlen(ai) as int
addr := _ai_addr(ai)
out := mem.Allocate(alen as u64)
memcpy(out, addr, alen as u64)
out_len = alen
ret out
end
func _no_sigpipe(fd: i64):
if fd < 0:
ret
end
if SALAM_OS_MAC:
opt := mem.Allocate(4 as u64)
defer mem.Free(opt)
o32 := opt as int*
o32[0] = 1
setsockopt(fd as int, 65535, 4130, opt, 4)
end
end
@en "FromFd"
@fa "سوکت از توصیف‌گر"
pub func FromFd(fd: i64): Socket:
ret Socket { fd = fd, family = AF_INET }
end
@en "Open"
@fa "باز کردن سوکت"
pub func Open(family: int, socktype: int): Socket:
if SALAM_OS_WINDOWS:
_net_init()
end
if SALAM_OS_WINDOWS:
s := _fd_of(socket(family, socktype, 0))
ret Socket { fd = s, family = family }
else:
s := socket(family, socktype, 0)
_no_sigpipe(s as i64)
ret Socket { fd = s as i64, family = family }
end
end
@en "Connect"
@fa "اتصال"
pub func Connect(host: str, port: int): Socket:
ret ConnectProto(host, port, SOCK_STREAM)
end
@en "ConnectProto"
@fa "اتصال با نوع"
pub func ConnectProto(host: str, port: int, socktype: int): Socket:
if SALAM_OS_WINDOWS:
_net_init()
end
mut addrs := Vector {} as Vector<i64>
mut lens := Vector {} as Vector<int>
mut fams := Vector {} as Vector<int>
_resolve_all(host, port, addrs, lens, fams)
mut out := Socket { fd = 0 - 1, family = AF_INET }
repeat addrs.len() in i:
if out.fd < 0:
out = _try_connect(addrs.get(i) as void*, lens.get(i), fams.get(i), socktype)
end
mem.Free(addrs.get(i) as void*)
end
addrs.free()
lens.free()
fams.free()
ret out
end
@en "ListenOn"
@fa "شنود روی"
pub func ListenOn(host: str, port: int, socktype: int): Socket:
if SALAM_OS_WINDOWS:
_net_init()
end
mut h_addr := 0
if host.len() > 0 and host != "0.0.0.0" and host != "::":
h_addr = _resolve_addr4(host)
if h_addr == 0:
ret Socket { fd = 0 - 1, family = AF_INET }
end
end
if SALAM_OS_WINDOWS:
s := _fd_of(socket(AF_INET, socktype, 0))
if s == (0 - 1 as i64): ret Socket { fd = 0 - 1, family = AF_INET } end
opt := mem.Allocate(4 as u64)
defer mem.Free(opt)
mut opt32 := opt as int*
opt32[0] = 1
setsockopt(_sk(s), 65535, 4, opt, 4)
sa := _make_sa4(h_addr, port)
defer mem.Free(sa)
if bind(_sk(s), sa, 16) != 0:
closesocket(_sk(s))
ret Socket { fd = 0 - 1, family = AF_INET }
end
if socktype == SOCK_STREAM:
if listen(_sk(s), 128) != 0:
closesocket(_sk(s))
ret Socket { fd = 0 - 1, family = AF_INET }
end
end
ret Socket { fd = s, family = AF_INET }
else:
s := socket(AF_INET, socktype, 0)
if s == 0 - 1: ret Socket { fd = 0 - 1, family = AF_INET } end
opt := mem.Allocate(4 as u64)
defer mem.Free(opt)
opt32 := opt as int*
opt32[0] = 1
if SALAM_OS_BSD:
setsockopt(s, 65535, 4, opt, 4)
else:
setsockopt(s, 1, 2, opt, 4)
end
sa := _make_sa4(h_addr, port)
defer mem.Free(sa)
if bind(s, sa, 16) != 0:
close(s)
ret Socket { fd = 0 - 1, family = AF_INET }
end
if socktype == SOCK_STREAM:
if listen(s, 128) != 0:
close(s)
ret Socket { fd = 0 - 1, family = AF_INET }
end
end
ret Socket { fd = s as i64, family = AF_INET }
end
end
@en "Listen"
@fa "شنود"
pub func Listen(port: int): Socket:
ret ListenOn("", port, SOCK_STREAM)
end
@en "LocalPort"
@fa "درگاه محلی"
pub func LocalPort(s: Socket): int:
buf := mem.Allocate(16 as u64)
defer mem.Free(buf)
lenbuf := mem.Allocate(4 as u64)
defer mem.Free(lenbuf)
lenbuf32 := lenbuf as int*
lenbuf32[0] = 16
mut ok := 0 - 1
if SALAM_OS_WINDOWS:
ok = getsockname(_sk(s.fd), buf, lenbuf)
else:
ok = getsockname(s.fd as int, buf, lenbuf)
end
if ok != 0: ret 0 end
bp := buf as i8*
mut hi := bp[2] as int
mut lo := bp[3] as int
if hi < 0: hi += 256 end
if lo < 0: lo += 256 end
ret hi * 256 + lo
end
@en "Accept"
@fa "پذیرش"
pub func Accept(server: Socket): Socket:
if SALAM_OS_WINDOWS:
c := _fd_of(accept(_sk(server.fd), null, null))
if c == (0 - 1 as i64): ret Socket { fd = 0 - 1, family = server.family } end
ret Socket { fd = c, family = server.family }
else:
c := accept(server.fd as int, null, null)
if c == 0 - 1: ret Socket { fd = 0 - 1, family = server.family } end
_no_sigpipe(c as i64)
ret Socket { fd = c as i64, family = server.family }
end
end
@en "Send"
@fa "ارسال"
pub func Send(sock: Socket, data: str): int:
if SALAM_OS_WINDOWS:
ret send(_sk(sock.fd), data as void*, data.len(), _SEND_FLAGS)
else:
ret send(sock.fd as int, data as void*, data.len(), _SEND_FLAGS)
end
end
@en "SendBytes"
@fa "ارسال بایت"
pub func SendBytes(sock: Socket, ptr: void*, n: int): int:
if SALAM_OS_WINDOWS:
mut sent := 0
until sent < n:
r := send(_sk(sock.fd), (ptr as i64 + sent) as void*, n - sent, _SEND_FLAGS)
if r <= 0: ret sent end
sent += r
end
ret sent
else:
mut sent := 0
until sent < n:
r := send(sock.fd as int, (ptr as i64 + sent) as void*, n - sent, _SEND_FLAGS)
if r <= 0: ret sent end
sent += r
end
ret sent
end
end
@en "Recv"
@fa "دریافت"
pub func Recv(sock: Socket, max: int): str:
mut m := max
if m <= 0: m = 4096 end
buf := mem.Allocate((m + 1) as u64)
defer mem.Free(buf)
memset(buf, 0, (m + 1) as u64)
if SALAM_OS_WINDOWS:
recv(_sk(sock.fd), buf, m, 0)
else:
recv(sock.fd as int, buf, m, 0)
end
ret str.Clone(buf as str)
end
@en "RecvBytes"
@fa "دریافت بایت"
pub func RecvBytes(sock: Socket, buf: void*, max: int): int:
if SALAM_OS_WINDOWS:
ret recv(_sk(sock.fd), buf, max, 0)
else:
ret recv(sock.fd as int, buf, max, 0)
end
end
@en "Shutdown"
@fa "خاموش کردن"
pub func Shutdown(sock: Socket):
if sock.fd < 0: ret end
if SALAM_OS_WINDOWS:
shutdown(_sk(sock.fd), _SHUT_BOTH)
else:
shutdown(sock.fd as int, _SHUT_BOTH)
end
end
@en "Close"
@fa "بستن"
pub func Close(sock: Socket):
if sock.fd < 0: ret end
if SALAM_OS_WINDOWS:
closesocket(_sk(sock.fd))
else:
close(sock.fd as int)
end
end
@en "Ok"
@fa "معتبر"
pub func Ok(sock: Socket): bool:
ret sock.fd >= 0
end
@en "Resolve"
@fa "تفکیک نشانی"
pub func Resolve(host: str): str:
if SALAM_OS_WINDOWS:
_net_init()
end
addr := _resolve_addr4(host)
if addr == 0: ret "" end
ret str.Clone(inet_ntoa(addr))
end
@en "ResolveAddr4Raw"
@fa "نشانی خام آی‌پی۴"
pub func ResolveAddr4Raw(host: str): int:
if SALAM_OS_WINDOWS:
