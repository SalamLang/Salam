until s.blen < SHA512_BLOCK:
s.blk[s.blen] = 0 as u8
s.blen += 1
end
_sha512_block(s)
s.blen = 0
end
until s.blen < 112:
s.blk[s.blen] = 0 as u8
s.blen += 1
end
repeat 8 in i:
s.blk[112 + i] = 0 as u8
