@en "SetBroadcast"
@fa "فعال‌سازی پخش"
pub func SetBroadcast(sock: Socket, enable: bool):
opt := mem.Allocate(4 as u64)
defer mem.Free(opt)
o32 := opt as int*
if enable: o32[0] = 1 else:
o32[0] = 0
end
if SALAM_OS_WINDOWS:
setsockopt(_sk(sock.fd), 65535, 32, opt, 4)
else SALAM_OS_MAC or SALAM_OS_BSD:
setsockopt(sock.fd as int, 65535, 32, opt, 4)
else:
setsockopt(sock.fd as int, 1, 6, opt, 4)
end
end
@en "SendToBytes"
@fa "ارسال بایت به"
pub func SendToBytes(sock: Socket, host: str, port: int, ptr: void*, n: int): int:
h_addr := _resolve_addr4(host)
if h_addr == 0: ret 0 - 1 end
sa := _make_sa4(h_addr, port)
defer mem.Free(sa)
if SALAM_OS_WINDOWS:
ret sendto(_sk(sock.fd), ptr, n, 0, sa, 16)
else:
ret sendto(sock.fd as int, ptr, n, 0, sa, 16)
end
end
@en "SendTo"
@fa "ارسال به"
pub func SendTo(sock: Socket, host: str, port: int, data: str): int:
ret SendToBytes(sock, host, port, data as void*, data.len())
end
@en "RecvFromBytes"
@fa "دریافت بایت از"
pub func RecvFromBytes(sock: Socket, buf: void*, max: int, out_host &: str, out_port &: int): int:
sa := mem.Allocate(16 as u64)
defer mem.Free(sa)
memset(sa, 0, 16 as u64)
salen := mem.Allocate(4 as u64)
defer mem.Free(salen)
salen32 := salen as int*
salen32[0] = 16
mut n := 0
if SALAM_OS_WINDOWS:
n = recvfrom(_sk(sock.fd), buf, max, 0, sa, salen)
else:
n = recvfrom(sock.fd as int, buf, max, 0, sa, salen)
end
if n < 0:
out_host = ""
out_port = 0
ret n
end
sap := sa as i8*
sa32 := sa as int*
mut hi := sap[2] as int
mut lo := sap[3] as int
if hi < 0: hi += 256 end
if lo < 0: lo += 256 end
out_port = hi * 256 + lo
out_host = str.Clone(inet_ntoa(sa32[1]))
ret n
end
@en "RecvFrom"
@fa "دریافت از"
pub func RecvFrom(sock: Socket, max: int, out_host &: str, out_port &: int): str:
mut m := max
if m <= 0: m = 65536 end
buf := mem.Allocate((m + 1) as u64)
defer mem.Free(buf)
memset(buf, 0, (m + 1) as u64)
n := RecvFromBytes(sock, buf, m, out_host, out_port)
if n < 0: ret "" end
ret str.Clone(buf as str).substr(0, n)
end
@en "net/mime"
@fa "مایم"
package mime
import mem
import str
import filepath
import crypto
import compress
@en "ContentTypeParam"
@fa "پارامتر نوع محتوا"
pub struct ContentTypeParam:
pub key: str = ""
pub value: str = ""
end
@en "ContentTypeParams"
@fa "پارامترهای نوع محتوا"
pub struct ContentTypeParams:
pub items: Vector<ContentTypeParam> = Vector {}
end
@en "ContentType"
@fa "نوع محتوا"
pub struct ContentType:
pub media_type: str = ""
pub params: ContentTypeParams = ContentTypeParams {}
end
@en "MultipartHeader"
@fa "سرآیند بخش"
pub struct MultipartHeader:
pub key: str = ""
pub value: str = ""
end
@en "MultipartHeaders"
@fa "سرآیندهای بخش"
pub struct MultipartHeaders:
pub items: Vector<MultipartHeader> = Vector {}
end
@en "MultipartPart"
@fa "بخش چندبخشی"
pub struct MultipartPart:
pub name: str = ""
pub filename: str = ""
pub content_type: str = ""
pub headers: MultipartHeaders = MultipartHeaders {}
pub body: compress.ByteBuf = compress.ByteBuf {}
end
@en "MultipartParts"
@fa "بخش‌های چندبخشی"
pub struct MultipartParts:
pub items: Vector<MultipartPart> = Vector {}
end
@en "MultipartWriter"
@fa "نویسنده چندبخشی"
pub struct MultipartWriter:
pub boundary: str = ""
pub buf: compress.ByteBuf = compress.ByteBuf {}
pub closed: bool = false
end
func _wbytes(b &: compress.ByteBuf, s: str):
compress.BufPushBytes(b, s as void*, s.len())
end
func _bytes_to_str(p: void*, n: int): str:
buf := mem.Allocate((n + 1) as u64)
defer mem.Free(buf)
mem.Copy(buf, p, n as u64)
bufp := buf as i8*
bufp[n] = 0 as i8
ret str.Clone(buf as str)
end
func _mem_find(hay: void*, hay_len: int, needle: void*, needle_len: int, start: int): int:
if needle_len == 0: ret start end
if needle_len > hay_len: ret 0 - 1 end
hp := hay as i64
np := needle as i64
limit := hay_len - needle_len
mut i := start
until i <= limit:
mut j := 0
mut matched := true
until j < needle_len:
hb := ((hp + i + j) as i8*)[0]
nb := ((np + j) as i8*)[0]
if hb != nb:
matched = false
j = needle_len
else:
j += 1
end
end
if matched: ret i end
i += 1
end
ret 0 - 1
end
func _ltrim(s: str): str:
mut a := 0
n := s.len()
until a < n:
c := s.substr(a, 1)
if c == " " or c == "\t":
a += 1
else:
ret s.substr(a, n - a)
end
end
ret ""
end
func _rtrim(s: str): str:
mut b := s.len()
until b > 0:
c := s.substr(b - 1, 1)
if c == " " or c == "\t" or c == "\r" or c == "\n":
b -= 1
else:
ret s.substr(0, b)
end
end
ret ""
end
func _strip(s: str): str:
ret _rtrim(_ltrim(s))
end
func _unquote(s: str): str:
if s.len() >= 2 and s.substr(0, 1) == "\"" and s.substr(s.len() - 1, 1) == "\"":
ret s.substr(1, s.len() - 2)
end
ret s
end
func _header_value(headers: MultipartHeaders, key: str): str:
n := headers.items.len()
mut i := 0
until i < n:
h := headers.items.get(i)
if h.key == key:
ret h.value
end
i += 1
end
ret ""
end
func _cd_quoted_param(cd: str, key: str): str:
needle := key + "=\""
idx := cd.find(needle)
if idx < 0: ret "" end
start := idx + needle.len()
rest := cd.substr(start, cd.len() - start)
close := rest.find("\"")
if close < 0: ret "" end
ret rest.substr(0, close)
end
func _write_part_header(w &: MultipartWriter, disposition: str, content_type: str):
_wbytes(w.buf, "--" + w.boundary + "\r\n")
_wbytes(w.buf, "Content-Disposition: " + disposition + "\r\n")
if content_type.len() > 0:
_wbytes(w.buf, "Content-Type: " + content_type + "\r\n")
end
_wbytes(w.buf, "\r\n")
end
@en "MimeExt"
@fa "پسوند مایم"
pub func MimeExt(ext: str): str:
if ext == "html" or ext == "htm": ret "text/html; charset=utf-8"
else ext == "css": ret "text/css"
else ext == "js" or ext == "mjs": ret "application/javascript"
else ext == "json": ret "application/json"
else ext == "png": ret "image/png"
else ext == "jpg" or ext == "jpeg": ret "image/jpeg"
else ext == "gif": ret "image/gif"
else ext == "svg": ret "image/svg+xml"
else ext == "ico": ret "image/x-icon"
else ext == "webp": ret "image/webp"
else ext == "txt": ret "text/plain; charset=utf-8"
else ext == "md": ret "text/markdown; charset=utf-8"
else ext == "pdf": ret "application/pdf"
else ext == "xml": ret "application/xml"
else ext == "wasm": ret "application/wasm"
else ext == "map": ret "application/json"
else ext == "zip": ret "application/zip"
else ext == "mp4": ret "video/mp4"
else ext == "webm": ret "video/webm"
else ext == "mp3": ret "audio/mpeg"
else ext == "wav": ret "audio/wav"
else ext == "woff": ret "font/woff"
else ext == "woff2": ret "font/woff2"
else:
ret "application/octet-stream"
end
end
@en "MimeType"
@fa "رده مایم"
pub func MimeType(p: str): str:
e := filepath.Ext(p)
if e.len() == 0:
mem.Free(e as void*)
ret "application/octet-stream"
end
bare := e.substr(1, e.len() - 1)
out := MimeExt(bare)
mem.Free(bare as void*)
mem.Free(e as void*)
ret out
end
@en "StatusText"
@fa "متن وضعیت"
pub func StatusText(code: int): str:
if code == 100: ret "Continue"
else code == 101: ret "Switching Protocols"
else code == 102: ret "Processing"
else code == 103: ret "Early Hints"
else code == 200: ret "OK"
else code == 201: ret "Created"
else code == 202: ret "Accepted"
else code == 203: ret "Non-Authoritative Information"
else code == 204: ret "No Content"
else code == 205: ret "Reset Content"
else code == 206: ret "Partial Content"
else code == 207: ret "Multi-Status"
else code == 208: ret "Already Reported"
else code == 226: ret "IM Used"
else code == 300: ret "Multiple Choices"
else code == 301: ret "Moved Permanently"
else code == 302: ret "Found"
else code == 303: ret "See Other"
else code == 304: ret "Not Modified"
else code == 305: ret "Use Proxy"
else code == 307: ret "Temporary Redirect"
else code == 308: ret "Permanent Redirect"
else code == 400: ret "Bad Request"
else code == 401: ret "Unauthorized"
else code == 402: ret "Payment Required"
else code == 403: ret "Forbidden"
else code == 404: ret "Not Found"
else code == 405: ret "Method Not Allowed"
else code == 406: ret "Not Acceptable"
else code == 407: ret "Proxy Authentication Required"
else code == 408: ret "Request Timeout"
else code == 409: ret "Conflict"
else code == 410: ret "Gone"
else code == 411: ret "Length Required"
else code == 412: ret "Precondition Failed"
else code == 413: ret "Content Too Large"
else code == 414: ret "URI Too Long"
else code == 415: ret "Unsupported Media Type"
else code == 416: ret "Range Not Satisfiable"
else code == 417: ret "Expectation Failed"
else code == 418: ret "I'm a teapot"
else code == 421: ret "Misdirected Request"
else code == 422: ret "Unprocessable Entity"
else code == 423: ret "Locked"
else code == 424: ret "Failed Dependency"
else code == 425: ret "Too Early"
else code == 426: ret "Upgrade Required"
else code == 428: ret "Precondition Required"
else code == 429: ret "Too Many Requests"
else code == 431: ret "Request Header Fields Too Large"
else code == 451: ret "Unavailable For Legal Reasons"
else code == 500: ret "Internal Server Error"
else code == 501: ret "Not Implemented"
else code == 502: ret "Bad Gateway"
else code == 503: ret "Service Unavailable"
else code == 504: ret "Gateway Timeout"
else code == 505: ret "HTTP Version Not Supported"
else code == 506: ret "Variant Also Negotiates"
else code == 507: ret "Insufficient Storage"
else code == 508: ret "Loop Detected"
else code == 510: ret "Not Extended"
else code == 511: ret "Network Authentication Required"
else:
ret "Unknown"
end
end
@en "ParseContentType"
@fa "تجزیه نوع محتوا"
pub func ParseContentType(header: str): ContentType:
mut out := ContentType {}
parts := str.Split(header, ";")
if parts.len() == 0: ret out end
out.media_type = _strip(parts.get(0))
mut i := 1
until i < parts.len():
piece := _strip(parts.get(i))
eq_at := piece.find("=")
if eq_at >= 0:
k := _strip(piece.substr(0, eq_at))
v := _unquote(_strip(piece.substr(eq_at + 1, piece.len() - eq_at - 1)))
out.params.items.push(ContentTypeParam { key = k, value = v })
end
i += 1
end
ret out
end
@en "ParamGet"
@fa "دریافت پارامتر"
pub func ParamGet(ct: ContentType, key: str): str:
n := ct.params.items.len()
mut i := 0
until i < n:
p := ct.params.items.get(i)
if p.key == key:
ret p.value
end
i += 1
end
ret ""
end
@en "ParseMultipart"
@fa "تجزیه چندبخشی"
pub func ParseMultipart(data: void*, n: int, boundary: str): MultipartParts:
mut out := MultipartParts {}
delim := "--" + boundary
dbytes := delim as void*
dlen := delim.len()
mut pos := _mem_find(data, n, dbytes, dlen, 0)
if pos < 0: ret out end
pos += dlen
mut done := false
until not done:
if pos + 1 < n:
b0 := ((data as i64 + pos) as i8*)[0]
b1 := ((data as i64 + pos + 1) as i8*)[0]
if b0 == 45 and b1 == 45:
done = true
continue
end
end
crlf := _mem_find(data, n, "\r\n" as void*, 2, pos)
if crlf < 0:
done = true
continue
end
header_start := crlf + 2
sep := _mem_find(data, n, "\r\n\r\n" as void*, 4, header_start)
if sep < 0:
done = true
continue
end
next_boundary := _mem_find(data, n, dbytes, dlen, header_start)
if next_boundary < 0:
done = true
continue
end
header_text := _bytes_to_str((data as i64 + header_start) as void*, sep - header_start)
mut part := MultipartPart {}
lines := str.Split(header_text, "\r\n")
mut li := 0
until li < lines.len():
line := lines.get(li)
colon := line.find(":")
if colon >= 0:
hk := _strip(line.substr(0, colon))
hv := _strip(line.substr(colon + 1, line.len() - colon - 1))
part.headers.items.push(MultipartHeader { key = hk, value = hv })
end
li += 1
end
cd := _header_value(part.headers, "Content-Disposition")
part.name = _cd_quoted_param(cd, "name")
part.filename = _cd_quoted_param(cd, "filename")
part.content_type = _header_value(part.headers, "Content-Type")
body_start := sep + 4
mut body_end := next_boundary
if body_end - 2 >= body_start:
body_end -= 2
end
blen := body_end - body_start
if blen > 0:
src := (data as i64 + body_start) as void*
compress.BufPushBytes(part.body, src, blen)
end
out.items.push(part)
pos = next_boundary + dlen
end
ret out
end
@en "NewMultipartWriter"
@fa "نویسنده چندبخشی جدید"
pub func NewMultipartWriter(): MultipartWriter:
mut w := MultipartWriter {}
w.boundary = "SalamBoundary" + crypto.RandomHex(16)
w.buf = compress.NewByteBuf()
w.closed = false
ret w
end
@en "ContentTypeHeader"
@fa "سرآیند نوع محتوا"
pub func ContentTypeHeader(w: MultipartWriter): str:
ret "multipart/form-data; boundary=" + w.boundary
end
@en "WriteField"
@fa "نوشتن فیلد"
pub func WriteField(w &: MultipartWriter, name: str, value: str):
_write_part_header(w, "form-data; name=\"" + name + "\"", "")
_wbytes(w.buf, value)
_wbytes(w.buf, "\r\n")
end
@en "WriteFileBytes"
@fa "نوشتن پرونده"
pub func WriteFileBytes(w &: MultipartWriter, name: str, filename: str, content_type: str, data: void*, n: int):
mut ct := content_type
if ct.len() == 0: ct = MimeType(filename) end
_write_part_header(w, "form-data; name=\"" + name + "\"; filename=\"" + filename + "\"", ct)
compress.BufPushBytes(w.buf, data, n)
_wbytes(w.buf, "\r\n")
end
@en "WriteFileStr"
@fa "نوشتن پرونده متنی"
pub func WriteFileStr(w &: MultipartWriter, name: str, filename: str, content_type: str, data: str):
WriteFileBytes(w, name, filename, content_type, data as void*, data.len())
end
@en "CloseWriter"
@fa "بستن نویسنده"
pub func CloseWriter(w &: MultipartWriter): compress.ByteBuf:
if not w.closed:
_wbytes(w.buf, "--" + w.boundary + "--\r\n")
w.closed = true
end
ret w.buf
end
@en "net"
@fa "شبکه"
package net
@en "net/proxy"
@fa "پراکسی"
package proxy
import mem
import str
import encoding
import net.tcp
@en "TypeHTTP"
@fa "نوع اچ‌تی‌تی‌پی"
pub const TypeHTTP := 0
@en "TypeSOCKS5"
@fa "نوع ساکس۵"
pub const TypeSOCKS5 := 1
struct _AddrParts:
pub host: str = ""
pub port: int = 0
end
@en "Proxy"
@fa "پراکسی"
pub struct Proxy:
pub kind: int = 0
pub host: str = ""
pub port: int = 0
pub username: str = ""
pub password: str = ""
end
@en "Chain"
@fa "زنجیره پراکسی"
pub struct Chain:
pub items: Vector<Proxy> = Vector {}
end
inline pure func _ub(p: i8*, i: int): int:
b := p[i] as int
if b < 0: ret b + 256 end
ret b
end
func _parse_addr(addr: str): _AddrParts:
mut r := _AddrParts {}
idx := addr.find(":")
if idx < 0:
r.host = addr
else:
r.host = addr.substr(0, idx)
r.port = addr.substr(idx + 1, addr.len() - idx - 1).to_int()
end
ret r
end
func _http_connect(conn: tcp.Conn, p: Proxy, host: str, port: int): bool:
hostport := host + ":" + str.FromInt(port as i64)
mut req := "CONNECT " + hostport + " HTTP/1.1\r\nHost: " + hostport + "\r\n"
if p.username.len() > 0:
cred := p.username + ":" + p.password
req += "Proxy-Authorization: Basic " + encoding.Base64Encode(cred) + "\r\n"
end
req += "Proxy-Connection: Keep-Alive\r\n\r\n"
tcp.Write(conn, req)
resp := tcp.Read(conn, 4096)
if resp.len() < 12: ret false end
ret resp.substr(9, 3) == "200"
end
func _socks5_auth(conn: tcp.Conn, p: Proxy): bool:
ulen := p.username.len()
plen := p.password.len()
total := 3 + ulen + plen
buf := mem.Allocate(total as u64)
defer mem.Free(buf)
bp := buf as i8*
bp[0] = 1 as i8
bp[1] = ulen as i8
mem.Copy((buf as i64 + 2) as void*, p.username as void*, ulen as u64)
bp[2 + ulen] = plen as i8
mem.Copy((buf as i64 + 3 + ulen) as void*, p.password as void*, plen as u64)
tcp.WriteBytes(conn, buf, total)
resp := mem.Allocate(2 as u64)
defer mem.Free(resp)
n := tcp.ReadBytes(conn, resp, 2)
if n < 2: ret false end
rp := resp as i8*
ret _ub(rp, 1) == 0
end
func _socks5_negotiate(conn: tcp.Conn, p: Proxy): bool:
mut nmethods := 1
if p.username.len() > 0: nmethods = 2 end
buf := mem.Allocate((2 + nmethods) as u64)
defer mem.Free(buf)
bp := buf as i8*
bp[0] = 5 as i8
bp[1] = nmethods as i8
bp[2] = 0 as i8
if nmethods == 2: bp[3] = 2 as i8 end
tcp.WriteBytes(conn, buf, 2 + nmethods)
resp := mem.Allocate(2 as u64)
defer mem.Free(resp)
n := tcp.ReadBytes(conn, resp, 2)
if n < 2: ret false end
rp := resp as i8*
method := _ub(rp, 1)
if method == 255: ret false end
if method == 2: ret _socks5_auth(conn, p) end
ret true
end
func _socks5_connect(conn: tcp.Conn, host: str, port: int): bool:
hlen := host.len()
total := 4 + 1 + hlen + 2
buf := mem.Allocate(total as u64)
defer mem.Free(buf)
bp := buf as i8*
bp[0] = 5 as i8
bp[1] = 1 as i8
bp[2] = 0 as i8
bp[3] = 3 as i8
bp[4] = hlen as i8
mem.Copy((buf as i64 + 5) as void*, host as void*, hlen as u64)
bp[5 + hlen] = ((port / 256) & 255) as i8
bp[6 + hlen] = (port & 255) as i8
tcp.WriteBytes(conn, buf, total)
resp := mem.Allocate(262 as u64)
defer mem.Free(resp)
n := tcp.ReadBytes(conn, resp, 262)
if n < 4: ret false end
rp := resp as i8*
ret _ub(rp, 1) == 0
end
func _handshake(conn: tcp.Conn, p: Proxy, host: str, port: int): bool:
if p.kind == TypeSOCKS5:
if not _socks5_negotiate(conn, p): ret false end
ret _socks5_connect(conn, host, port)
end
ret _http_connect(conn, p, host, port)
end
@en "NewHTTPProxy"
@fa "پراکسی اچ‌تی‌تی‌پی جدید"
pub func NewHTTPProxy(addr: str): Proxy:
parts := _parse_addr(addr)
ret Proxy { kind = TypeHTTP, host = parts.host, port = parts.port }
end
@en "NewHTTPProxyAuth"
@fa "پراکسی اچ‌تی‌تی‌پی با احراز هویت"
pub func NewHTTPProxyAuth(addr: str, username: str, password: str): Proxy:
mut p := NewHTTPProxy(addr)
p.username = username
p.password = password
ret p
end
@en "NewSOCKS5Proxy"
@fa "پراکسی ساکس۵ جدید"
pub func NewSOCKS5Proxy(addr: str): Proxy:
parts := _parse_addr(addr)
ret Proxy { kind = TypeSOCKS5, host = parts.host, port = parts.port }
end
@en "NewSOCKS5ProxyAuth"
@fa "پراکسی ساکس۵ با احراز هویت"
pub func NewSOCKS5ProxyAuth(addr: str, username: str, password: str): Proxy:
mut p := NewSOCKS5Proxy(addr)
p.username = username
p.password = password
ret p
end
@en "Dial"
@fa "شماره‌گیری"
pub func Dial(p: Proxy, target_host: str, target_port: int): tcp.Conn:
conn := tcp.Dial(p.host, p.port)
if not tcp.ConnOk(conn): ret conn end
ok := _handshake(conn, p, target_host, target_port)
if not ok:
tcp.Close(conn)
ret tcp.Conn {}
end
ret conn
end
@en "NewChain"
@fa "زنجیره جدید"
pub func NewChain(): Chain:
ret Chain {}
end
@en "Add"
@fa "افزودن"
pub func Add(c &: Chain, p: Proxy):
c.items.push(p)
end
@en "DialChain"
@fa "شماره‌گیری زنجیره‌ای"
pub func DialChain(c: Chain, target_host: str, target_port: int): tcp.Conn:
n := c.items.len()
if n == 0: ret tcp.Dial(target_host, target_port) end
first := c.items.get(0)
conn := tcp.Dial(first.host, first.port)
if not tcp.ConnOk(conn): ret conn end
mut i := 0
mut failed := false
until i < n:
p := c.items.get(i)
mut next_host := target_host
mut next_port := target_port
if i + 1 < n:
nxt := c.items.get(i + 1)
next_host = nxt.host
next_port = nxt.port
end
ok := _handshake(conn, p, next_host, next_port)
if not ok:
failed = true
i = n
continue
end
i += 1
end
if failed:
tcp.Close(conn)
ret tcp.Conn {}
end
ret conn
end
@en "net/router"
@fa "مسیریاب"
package router
import mem
const _CH_SLASH := 47
const _CH_COLON := 58
const _CH_STAR := 42
@en "Param"
@fa "پارامتر"
pub struct Param:
pub key: str = ""
pub value: str = ""
end
@en "ParamList"
@fa "پارامترها"
pub struct ParamList:
pub items: Vector<Param> = Vector {}
end
@en "Route"
@fa "مسیر مسیریابی"
pub struct Route:
pub method: str = ""
pub pattern: str = ""
pub fn: i64 = 0
pub mid: int = 0
pub spec: int = 0
end
@en "Router"
@fa "مسیریاب"
pub struct Router:
pub routes: Vector<Route> = Vector {}
pub static_prefix: str = ""
pub static_dir: str = ""
pub has_static: bool = false
pub static_listing: bool = false
pub idx: Vector<int> = Vector {}
pub idx_mask: int = 0
pub n_literal: int = 0
pub n_dynamic: int = 0
end
@en "Match"
@fa "تطابق"
pub struct Match:
pub matched: bool = false
pub fn: i64 = 0
pub params: ParamList = ParamList {}
end
func _free_params(p &: ParamList):
n := p.items.len()
mut i := 0
until i < n:
kv := p.items.get(i)
mem.Free(kv.key as void *)
mem.Free(kv.value as void *)
i += 1
end
p.items.free()
p.items = Vector {} as Vector<Param>
end
func _method_id(m: str): int:
if m == "GET": ret 1 end
if m == "POST": ret 2 end
if m == "PUT": ret 3 end
if m == "DELETE": ret 4 end
if m == "PATCH": ret 5 end
if m == "HEAD": ret 6 end
if m == "OPTIONS": ret 7 end
ret 0
end
func _hash_key(mid: int, s: str): int:
mut h := 2166136261 as i64
h = ((h ^ (mid as i64)) * 16777619) & 4294967295
p := s as i8 *
n := s.len()
mut i := 0
until i < n:
h = ((h ^ ((p[i] as i64) & 255)) * 16777619) & 4294967295
i += 1
end
ret (h & 2147483647) as int
end
func _param_get(p: ParamList, key: str): str:
n := p.items.len()
mut i := 0
until i < n:
kv := p.items.get(i)
if kv.key == key: ret kv.value end
i += 1
end
ret ""
end
func _specificity(pattern: str): int:
if pattern.find("*") >= 0: ret 2 end
if pattern.find(":") >= 0: ret 1 end
ret 0
end
func _byte_at(s: str, i: int): int:
p := s as i8 *
ret p[i]
end
func _try_match(pattern: str, path: str, out_params &: ParamList): bool:
mut pi := 0
mut pp := 0
plen := pattern.len()
pathlen := path.len()
until pi < plen or pp < pathlen:
if pi < plen and _byte_at(pattern, pi) == _CH_STAR:
ret true
end
if pi < plen and _byte_at(pattern, pi) == _CH_COLON:
mut ne := pi + 1
until ne < plen and _byte_at(pattern, ne) != _CH_SLASH:
ne += 1
end
pname := pattern.substr(pi + 1, ne - pi - 1)
mut ve := pp
until ve < pathlen and _byte_at(path, ve) != _CH_SLASH:
ve += 1
end
pval := path.substr(pp, ve - pp)
out_params.items.push(Param { key = pname, value = pval })
pi = ne
pp = ve
else:
if pi >= plen or pp >= pathlen:
break
end
if _byte_at(pattern, pi) != _byte_at(path, pp):
ret false
end
pi += 1
pp += 1
end
end
until pi < plen and _byte_at(pattern, pi) == _CH_SLASH: pi = pi + 1 end
until pp < pathlen and _byte_at(path, pp) == _CH_SLASH: pp = pp + 1 end
ret pi == plen and pp == pathlen
end
func _idx_insert(r &: Router, ri: int):
route := r.routes.get(ri)
if route.spec != 0: ret end
mut slot := _hash_key(route.mid, route.pattern) & r.idx_mask
until r.idx.get(slot) != 0:
prev := r.routes.get(r.idx.get(slot) - 1)
if prev.mid == route.mid and prev.method == route.method and prev.pattern == route.pattern:
ret
end
slot = (slot + 1) & r.idx_mask
end
r.idx.set(slot, ri + 1)
end
func _idx_grow(r &: Router, cap: int):
r.idx.free()
r.idx = Vector {} as Vector<int>
repeat cap in _:
r.idx.push(0)
end
r.idx_mask = cap - 1
n := r.routes.len()
mut i := 0
until i < n:
_idx_insert(r, i)
i += 1
end
end
func _add(r &: Router, method: str, pattern: str, fn: i64):
mut rt := Route {}
rt.method = method
rt.pattern = pattern
rt.fn = fn
rt.spec = _specificity(pattern)
rt.mid = _method_id(method)
r.routes.push(rt)
if rt.spec != 0:
r.n_dynamic += 1
ret
end
r.n_literal += 1
cap := r.idx_mask + 1
if (r.n_literal * 2) > cap:
mut want := 16
until want < (r.n_literal * 4):
want = want * 2
end
_idx_grow(r, want)
else:
_idx_insert(r, r.routes.len() - 1)
end
end
func _dispatch_exact(r: Router, method: str, path: str): Match:
mut m := Match {}
mid := _method_id(method)
if r.idx_mask > 0:
mut slot := _hash_key(mid, path) & r.idx_mask
until r.idx.get(slot) != 0:
route := r.routes.get(r.idx.get(slot) - 1)
if route.mid == mid and route.pattern == path:
if mid != 0 or route.method == method:
m.matched = true
m.fn = route.fn
ret m
end
end
slot = (slot + 1) & r.idx_mask
end
end
if r.n_dynamic == 0: ret m end
n := r.routes.len()
mut best := 3
mut i := 0
until i < n:
route := r.routes.get(i)
if route.spec != 0 and route.mid == mid and route.spec < best:
if mid != 0 or route.method == method:
mut params := ParamList {}
if _try_match(route.pattern, path, params):
_free_params(m.params)
m.matched = true
m.fn = route.fn
m.params = params
best = route.spec
else:
_free_params(params)
end
end
end
i += 1
end
ret m
end
@en "NewRouter"
@fa "مسیریاب جدید"
pub func NewRouter(): Router:
ret Router {}
end
@en "Get"
@fa "دریافت"
pub func Get(r &: Router, path: str, fn: i64): _add(r, "GET", path, fn) end
@en "Post"
@fa "ارسال"
pub func Post(r &: Router, path: str, fn: i64): _add(r, "POST", path, fn) end
@en "Put"
@fa "قراردادن"
pub func Put(r &: Router, path: str, fn: i64): _add(r, "PUT", path, fn) end
@en "Delete"
@fa "حذف"
pub func Delete(r &: Router, path: str, fn: i64): _add(r, "DELETE", path, fn) end
@en "Patch"
@fa "وصله"
pub func Patch(r &: Router, path: str, fn: i64): _add(r, "PATCH", path, fn) end
@en "Head"
@fa "سر"
pub func Head(r &: Router, path: str, fn: i64): _add(r, "HEAD", path, fn) end
@en "Options"
@fa "گزینه ها"
pub func Options(r &: Router, path: str, fn: i64): _add(r, "OPTIONS", path, fn) end
@en "Method"
@fa "روش"
pub func Method(r &: Router, method: str, path: str, fn: i64):
_add(r, method, path, fn)
end
@en "Group"
@fa "گروه"
pub func Group(r &: Router, prefix: str, method: str, path: str, fn: i64):
_add(r, method, prefix + path, fn)
end
@en "Static"
@fa "ایستا"
pub func Static(r &: Router, prefix: str, dir: str):
r.static_prefix = prefix
r.static_dir = dir
r.has_static = true
end
@en "EnableListing"
@fa "فعال سازی فهرست پوشه"
pub func EnableListing(r &: Router):
r.static_listing = true
end
@en "ParamGet"
@fa "دریافت پارامتر"
pub func ParamGet(m: Match, key: str): str:
ret _param_get(m.params, key)
end
@en "Dispatch"
@fa "اعزام"
pub func Dispatch(r: Router, method: str, path: str): Match:
m := _dispatch_exact(r, method, path)
if not m.matched and method == "HEAD":
ret _dispatch_exact(r, "GET", path)
end
ret m
end
@en "FreeMatch"
@fa "آزادسازی تطابق"
pub func FreeMatch(m &: Match):
_free_params(m.params)
end
package socketio
import encoding.json
import encoding.value
import encoding.encerr
import conv
@en "Args"
@fa "آرگومان‌ها"
pub struct Args:
pub items: Vector<str> = Vector {}
pub bins: Vector<Bytes> = Vector {}
end
func _decode_one(frag: str): value.Value:
mut err := encerr.EncodingError {}
ret json.Decode(frag, err)
end
@en "NewArgs"
@fa "آرگومان جدید"
pub func NewArgs(): Args:
ret Args {}
end
@en "AddStr"
@fa "افزودن رشته"
pub func AddStr(a &: Args, s: str):
a.items.push(json.Str(s))
end
@en "AddInt"
@fa "افزودن عدد"
pub func AddInt(a &: Args, n: i64):
a.items.push("" + n)
end
@en "AddFloat"
@fa "افزودن اعشاری"
pub func AddFloat(a &: Args, n: f64):
a.items.push("" + n)
end
@en "AddBool"
@fa "افزودن بولی"
pub func AddBool(a &: Args, b: bool):
if b:
a.items.push("true")
else:
a.items.push("false")
end
end
@en "AddNull"
@fa "افزودن تهی"
pub func AddNull(a &: Args):
a.items.push("null")
end
@en "AddJSON"
@fa "افزودن جیسون"
pub func AddJSON(a &: Args, raw: str):
if raw.len() == 0:
a.items.push("null")
else:
a.items.push(raw)
end
end
@en "AddValue"
@fa "افزودن مقدار"
pub func AddValue(a &: Args, v: value.Value):
a.items.push(json.EncodeDefault(v))
end
@en "AddBytes"
@fa "افزودن بایت"
pub func AddBytes(a &: Args, ptr: void*, n: int):
a.items.push(Placeholder(a.bins.len()))
a.bins.push(NewBytes(ptr, n))
end
@en "AddBinaryStr"
@fa "افزودن رشته دودویی"
pub func AddBinaryStr(a &: Args, s: str):
AddBytes(a, s as void*, s.len())
end
@en "ArgsCount"
@fa "شمار آرگومان"
pub func ArgsCount(a: Args): int:
ret a.items.len()
end
@en "ArgsFree"
@fa "آزادسازی آرگومان"
pub func ArgsFree(a &: Args):
repeat a.bins.len() in i:
mut b := a.bins.get(i)
BytesFree(b)
end
a.bins.free()
a.items.free()
end
@en "ArgsJSON"
@fa "جیسون آرگومان"
pub func ArgsJSON(a: Args, name: str): str:
mut out := "["
mut first := true
if name.len() > 0:
out += json.Str(name)
first = false
end
repeat a.items.len() in i:
if not first:
out += ","
end
out += a.items.get(i)
first = false
end
ret out + "]"
end
@en "ItemCount"
@fa "شمار عنصر"
pub func ItemCount(raw: str): int:
mut parts := SplitJSONArray(raw)
defer parts.free()
ret parts.len()
end
@en "Item"
@fa "عنصر"
pub func Item(raw: str, i: int): str:
mut parts := SplitJSONArray(raw)
defer parts.free()
if i < 0 or i >= parts.len():
ret ""
end
ret parts.get(i)
end
@en "ItemStr"
@fa "عنصر رشته‌ای"
pub func ItemStr(raw: str, i: int): str:
frag := Item(raw, i)
if frag.len() == 0:
ret ""
end
mut v := _decode_one(frag)
defer value.ValueFree(v)
if value.IsString(v):
ret value.AsString(v)
end
ret frag
end
@en "ItemInt"
@fa "عنصر عددی"
pub func ItemInt(raw: str, i: int): i64:
mut v := _decode_one(Item(raw, i))
defer value.ValueFree(v)
if value.IsString(v):
ret conv.ParseInt(value.AsString(v))
end
ret value.AsInt(v)
end
@en "ItemFloat"
@fa "عنصر اعشاری"
pub func ItemFloat(raw: str, i: int): f64:
mut v := _decode_one(Item(raw, i))
defer value.ValueFree(v)
if value.IsString(v):
ret conv.ParseFloat(value.AsString(v))
end
ret value.AsFloat(v)
end
@en "ItemBool"
@fa "عنصر بولی"
pub func ItemBool(raw: str, i: int): bool:
mut v := _decode_one(Item(raw, i))
defer value.ValueFree(v)
if value.IsBool(v):
ret value.AsBool(v)
end
if value.IsNumber(v):
ret value.AsInt(v) != 0
end
if value.IsString(v):
t := value.AsString(v)
ret t == "true" or t == "1"
end
ret false
end
@en "ItemValue"
@fa "مقدار عنصر"
pub func ItemValue(raw: str, i: int): value.Value:
ret _decode_one(Item(raw, i))
end
package socketio
import net.http
import str
import time
import rand
import encoding
import encoding.json
func _now(): i64:
ret time.MonoMillis()
end
func _cookie_header(m: MgrState*): str:
if m[0].cookies.size() == 0:
ret ""
end
ck := http.CookieHeader(m[0].cookies)
if ck.len() == 0:
ret ""
end
ret "Cookie: " + ck + "\r\n"
end
func _headers_of(m: MgrState*): str:
mut own := m[0].opts.headers
if str.Trim(own).len() == 0:
own = ""
else not str.EndsWith(own, "\r\n"):
own += "\r\n"
end
ret own + _cookie_header(m)
end
func _absorb_cookies(m: MgrState*, r: http.Response):
mut got := http.CookieMap(r)
defer got.free()
each k, v in got:
m[0].cookies.put(k, v)
end
end
func _query_of(m: MgrState*, transport: str, sid: str): str:
mut q := "EIO=4&transport=" + transport
if sid.len() > 0:
q += "&sid=" + sid
end
q += "&t=" + time.NowMillis() + "-" + rand.Int32Range(0, 999999)
mut extra := _clean_query(m[0].ep.query)
own := _clean_query(m[0].opts.query)
if own.len() > 0:
if extra.len() > 0:
extra += "&"
end
extra += own
end
if extra.len() > 0:
q += "&" + extra
end
ret q
end
func _mount(m: MgrState*): str:
if m[0].opts.trailing_slash and m[0].ep.path != "/":
ret m[0].ep.path + "/?"
end
ret m[0].ep.path + "?"
end
func _clean_query(q: str): str:
mut out := str.Trim(q)
until str.StartsWith(out, "?") or str.StartsWith(out, "&"):
out = out.substr(1, out.len() - 1)
end
ret out
end
func _poll_url(m: MgrState*, sid: str): str:
ret Origin(m[0].ep) + _mount(m) + _query_of(m, "polling", sid)
end
func _ws_path(m: MgrState*, sid: str): str:
ret _mount(m) + _query_of(m, "websocket", sid)
end
func _read_open(m: MgrState*, body: str): bool:
if json.Get(body, "sid").len() == 0:
ret false
end
m[0].sid = json.Get(body, "sid")
if json.Has(body, "pingInterval"):
m[0].ping_interval = json.GetInt(body, "pingInterval")
end
if json.Has(body, "pingTimeout"):
m[0].ping_timeout = json.GetInt(body, "pingTimeout")
end
if json.Has(body, "maxPayload"):
m[0].max_payload = json.GetInt(body, "maxPayload")
end
m[0].can_upgrade = str.Contains(json.Get(body, "upgrades"), "websocket")
m[0].last_rx = _now()
ret true
end
func _ws_open(m: MgrState*, sid: str): bool:
path := _ws_path(m, sid)
hdrs := _headers_of(m)
if m[0].ep.secure and m[0].opts.insecure:
m[0].ws = websocket.DialWSSUnverified(m[0].ep.host, m[0].ep.port, path, hdrs)
else m[0].ep.secure:
m[0].ws = websocket.DialWSSWith(m[0].ep.host, m[0].ep.port, path, hdrs)
else:
m[0].ws = websocket.DialWith(m[0].ep.host, m[0].ep.port, path, hdrs)
end
if not websocket.IsOpen(m[0].ws):
m[0].last_error = "websocket handshake to " + Origin(m[0].ep) + " was refused"
ret false
end
ret true
end
func _ws_direct(m: MgrState*): bool:
if not _ws_open(m, ""):
ret false
end
msg := websocket.Poll(m[0].ws, _connect_timeout(m))
if msg.kind != websocket.TEXT:
m[0].last_error = "no open packet from the server"
websocket.Close(m[0].ws)
ret false
end
if EngineKind(msg.text) != EIO_OPEN:
m[0].last_error = "expected an open packet, got " + msg.text
websocket.Close(m[0].ws)
ret false
end
if not _read_open(m, EngineBody(msg.text)):
m[0].last_error = "malformed open packet"
websocket.Close(m[0].ws)
ret false
end
m[0].transport = TRANSPORT_WEBSOCKET
m[0].upgraded_before = true
ret true
end
func _poll_handshake(m: MgrState*): bool:
r := http.RequestRaw("GET", _poll_url(m, ""), _headers_of(m), "")
if r.status != 200:
if r.err.len() > 0:
m[0].last_error = r.err
else:
m[0].last_error = "handshake to " + m[0].ep.path + " answered " + r.status
end
ret false
end
_absorb_cookies(m, r)
mut payloads := SplitPayloads(r.body)
defer payloads.free()
if payloads.len() == 0:
m[0].last_error = "empty handshake response"
ret false
end
first := payloads.get(0)
if EngineKind(first) != EIO_OPEN:
m[0].last_error = "expected an open packet, got " + first
ret false
end
if not _read_open(m, EngineBody(first)):
m[0].last_error = "malformed open packet"
ret false
end
m[0].transport = TRANSPORT_POLLING
mut i := 1
until i < payloads.len():
_engine_payload(m, payloads.get(i))
i += 1
end
ret true
end
func _try_upgrade(m: MgrState*): bool:
if not m[0].can_upgrade:
ret false
end
if not _ws_open(m, m[0].sid):
ret false
end
if websocket.SendText(m[0].ws, EncodeEngine(EIO_PING, "probe")) != 0:
websocket.Close(m[0].ws)
ret false
end
deadline := _now() + (_connect_timeout(m) as i64)
mut probed := false
mut going := true
until going:
left := (deadline - _now()) as int
if left <= 0:
going = false
else:
msg := websocket.Poll(m[0].ws, left)
if msg.kind == websocket.TIMEOUT:
going = false
else msg.kind != websocket.TEXT:
going = false
else EngineKind(msg.text) == EIO_PONG and EngineBody(msg.text) == "probe":
probed = true
going = false
end
end
end
if not probed:
websocket.Close(m[0].ws)
ret false
end
if websocket.SendText(m[0].ws, EncodeEngine(EIO_UPGRADE, "")) != 0:
websocket.Close(m[0].ws)
ret false
end
m[0].transport = TRANSPORT_WEBSOCKET
m[0].upgraded_before = true
m[0].last_rx = _now()
_broadcast_lifecycle(m, EV_UPGRADE, "websocket")
ret true
end
func _engine_open(m: MgrState*): bool:
m[0].last_error = ""
m[0].sid = ""
m[0].recon = false
m[0].pollout.clear()
remembered := m[0].opts.remember_upgrade and m[0].upgraded_before and m[0].opts.transports == TRANSPORT_AUTO
if m[0].opts.transports == TRANSPORT_WEBSOCKET or remembered or (m[0].ep.secure and m[0].opts.insecure):
if _ws_direct(m):
m[0].state = ST_OPEN
ret true
end
if not remembered:
ret false
end
m[0].upgraded_before = false
m[0].last_error = ""
end
if not _poll_handshake(m):
ret false
end
if m[0].opts.transports == TRANSPORT_AUTO:
_try_upgrade(m)
end
m[0].state = ST_OPEN
ret true
end
func _engine_close(m: MgrState*):
if m[0].transport == TRANSPORT_POLLING and m[0].state == ST_OPEN and m[0].sid.len() > 0:
m[0].pollout.push(EncodeEngine(EIO_CLOSE, ""))
_poll_flush(m)
end
if websocket.IsOpen(m[0].ws):
if m[0].transport == TRANSPORT_WEBSOCKET:
websocket.SendText(m[0].ws, EncodeEngine(EIO_CLOSE, ""))
end
websocket.Close(m[0].ws)
end
m[0].state = ST_CLOSED
m[0].sid = ""
end
func _poll_flush(m: MgrState*): bool:
if m[0].pollout.len() == 0:
ret true
end
mut cap := m[0].max_payload
if cap < 1024:
cap = 1024
end
mut batch := Vector {} as Vector<str>
defer batch.free()
mut used := 0
mut ok := true
repeat m[0].pollout.len() in i:
one := m[0].pollout.get(i)
if batch.len() > 0 and used + one.len() + 1 > cap:
if not _poll_post(m, batch):
ok = false
end
batch.clear()
used = 0
end
batch.push(one)
used += one.len() + 1
end
if batch.len() > 0 and ok:
if not _poll_post(m, batch):
ok = false
end
end
m[0].pollout.clear()
ret ok
end
func _poll_post(m: MgrState*, items: Vector<str>): bool:
body := JoinPayloads(items)
hdrs := _headers_of(m) + "Content-Type: text/plain;charset=UTF-8\r\n"
r := http.RequestRaw("POST", _poll_url(m, m[0].sid), hdrs, body)
if r.status != 200:
m[0].last_error = "polling write answered " + r.status
ret false
end
_absorb_cookies(m, r)
ret true
end
func _engine_write(m: MgrState*, payload: str): bool:
if m[0].state != ST_OPEN:
ret false
end
if m[0].transport == TRANSPORT_WEBSOCKET:
ret websocket.SendText(m[0].ws, payload) == 0
end
m[0].pollout.push(payload)
if m[0].batching:
ret true
end
ret _poll_flush(m)
end
func _engine_write_bytes(m: MgrState*, b: Bytes): bool:
if m[0].state != ST_OPEN:
ret false
end
if m[0].transport == TRANSPORT_WEBSOCKET:
ret websocket.SendBinaryBytes(m[0].ws, b.ptr, b.len) == 0
end
m[0].pollout.push("b" + BytesToBase64(b))
if m[0].batching:
ret true
end
ret _poll_flush(m)
end
func _heartbeat_expired(m: MgrState*): bool:
if m[0].state != ST_OPEN:
ret false
end
limit := (m[0].ping_interval + m[0].ping_timeout) as i64
ret _now() - m[0].last_rx > limit
end
func _engine_payload(m: MgrState*, payload: str):
if payload.len() == 0:
ret
end
m[0].last_rx = _now()
k := EngineKind(payload)
if k == EIO_PING:
_engine_write(m, EncodeEngine(EIO_PONG, ""))
_broadcast_lifecycle(m, EV_PING, "")
else k == EIO_CLOSE:
_engine_shutdown(m, REASON_TRANSPORT_CLOSE)
else k == EIO_MESSAGE:
_on_socketio_text(m, EngineBody(payload))
end
end
func _engine_binary(m: MgrState*, b: Bytes):
m[0].last_rx = _now()
_on_socketio_binary(m, b)
end
func _poll_turn(m: MgrState*): int:
if not _poll_flush(m):
ret PUMP_CLOSED
end
r := http.RequestRaw("GET", _poll_url(m, m[0].sid), _headers_of(m), "")
if r.status != 200:
m[0].last_error = "long-poll answered " + r.status
ret PUMP_CLOSED
end
_absorb_cookies(m, r)
mut payloads := SplitPayloads(r.body)
defer payloads.free()
mut got := false
repeat payloads.len() in i:
p := payloads.get(i)
if p.len() > 0:
got = true
if str.StartsWith(p, "b"):
_poll_binary(m, p.substr(1, p.len() - 1))
else:
_engine_payload(m, p)
end
end
end
if not got:
ret PUMP_TIMEOUT
end
ret PUMP_OK
end
func _poll_binary(m: MgrState*, encoded: str):
if encoded.len() == 0:
ret
end
cap := (encoded.len() / 4) * 3 + 4
buf := mem.Allocate(cap as u64)
if buf == null:
ret
end
defer mem.Free(buf)
mut ok := true
n := encoding.Base64DecodeBytes(encoded, buf, cap, ok)
if not ok or n <= 0:
ret
end
mut b := NewBytes(buf, n)
_engine_binary(m, b)
BytesFree(b)
end
func _ws_turn(m: MgrState*, timeout_ms: int): int:
msg := websocket.Poll(m[0].ws, timeout_ms)
if msg.kind == websocket.TIMEOUT:
ret PUMP_TIMEOUT
end
if msg.kind == websocket.TEXT:
_engine_payload(m, msg.text)
ret PUMP_OK
end
if msg.kind == websocket.BINARY:
mut b := NewBytes(msg.data, msg.len)
_engine_binary(m, b)
BytesFree(b)
ret PUMP_OK
end
if msg.kind == websocket.PONG:
ret PUMP_TIMEOUT
end
ret PUMP_CLOSED
end
func _transport_read(m: MgrState*, timeout_ms: int): int:
if m[0].state != ST_OPEN:
ret PUMP_CLOSED
end
if m[0].transport == TRANSPORT_WEBSOCKET:
ret _ws_turn(m, timeout_ms)
end
ret _poll_turn(m)
end
package socketio
import str
import mem
import encoding
@en "EngineOpen"
@fa "باز کردن موتور"
pub const EIO_OPEN := 0
@en "EngineClose"
@fa "بستن موتور"
pub const EIO_CLOSE := 1
@en "EnginePing"
@fa "پینگ موتور"
pub const EIO_PING := 2
@en "EnginePong"
@fa "پونگ موتور"
pub const EIO_PONG := 3
@en "EngineMessage"
@fa "پیام موتور"
pub const EIO_MESSAGE := 4
@en "EngineUpgrade"
@fa "ارتقای موتور"
pub const EIO_UPGRADE := 5
@en "EngineNoop"
@fa "بی‌کار موتور"
pub const EIO_NOOP := 6
@en "ConnectPacket"
@fa "بسته اتصال"
pub const PKT_CONNECT := 0
@en "DisconnectPacket"
@fa "بسته قطع اتصال"
pub const PKT_DISCONNECT := 1
@en "EventPacket"
@fa "بسته رویداد"
pub const PKT_EVENT := 2
@en "AckPacket"
@fa "بسته تایید"
pub const PKT_ACK := 3
@en "ConnectError"
@fa "خطای اتصال"
pub const PKT_CONNECT_ERROR := 4
@en "BinaryEvent"
@fa "رویداد دودویی"
pub const PKT_BINARY_EVENT := 5
@en "BinaryAck"
@fa "تایید دودویی"
pub const PKT_BINARY_ACK := 6
const RS := 30
const MAX_ATTACHMENTS := 1024
const MAX_ACK_ID := 1000000000
@en "Bytes"
@fa "بایت‌ها"
pub struct Bytes:
pub ptr: void* = null
pub len: int = 0
end
@en "Packet"
@fa "بسته"
pub struct Packet:
pub kind: int = 0 - 1
pub nsp: str = "/"
pub id: int = 0 - 1
pub data: str = ""
pub attachments: int = 0
pub ok: bool = false
end
func _digit_at(s: str, i: int): int:
if i < 0 or i >= s.len():
ret 0 - 1
end
c := char_code(s.substr(i, 1))
if c < 48 or c > 57:
ret 0 - 1
end
ret c - 48
end
func _is_ws(ch: str): bool:
ret ch == " " or ch == "\t" or ch == "\n" or ch == "\r"
end
@en "EncodePacket"
@fa "رمزگذاری بسته"
pub func EncodePacket(p: Packet): str:
mut out := "" + p.kind
if p.attachments > 0 and (p.kind == PKT_BINARY_EVENT or p.kind == PKT_BINARY_ACK):
out += "" + p.attachments + "-"
end
if p.nsp.len() > 0 and p.nsp != "/":
out += p.nsp + ","
end
if p.id >= 0:
out += "" + p.id
end
out += p.data
ret out
end
@en "DecodePacket"
@fa "رمزگشایی بسته"
pub func DecodePacket(text: str): Packet:
mut p := Packet {}
n := text.len()
if n == 0:
ret p
end
k := _digit_at(text, 0)
if k < 0 or k > PKT_BINARY_ACK:
ret p
end
p.kind = k
mut i := 1
if k == PKT_BINARY_EVENT or k == PKT_BINARY_ACK:
mut num := 0
mut seen := false
until _digit_at(text, i) >= 0 and num <= MAX_ATTACHMENTS:
num = num * 10 + _digit_at(text, i)
seen = true
i += 1
end
if not seen or num > MAX_ATTACHMENTS or i >= n or text.substr(i, 1) != "-":
ret p
end
p.attachments = num
i += 1
end
if i < n and text.substr(i, 1) == "/":
c := str.IndexFrom(text, ",", i)
if c < 0:
p.nsp = text.substr(i, n - i)
i = n
else:
p.nsp = text.substr(i, c - i)
i = c + 1
end
end
if _digit_at(text, i) >= 0:
mut id := 0
until _digit_at(text, i) >= 0 and id <= MAX_ACK_ID:
id = id * 10 + _digit_at(text, i)
i += 1
end
if id > MAX_ACK_ID:
ret p
end
p.id = id
end
if i < n:
p.data = text.substr(i, n - i)
end
p.ok = true
ret p
end
@en "EncodeEngine"
@fa "رمزگذاری موتور"
pub func EncodeEngine(kind: int, body: str): str:
ret "" + kind + body
end
@en "EngineKind"
@fa "نوع موتور"
pub func EngineKind(payload: str): int:
ret _digit_at(payload, 0)
end
@en "EngineBody"
@fa "بدنه موتور"
pub func EngineBody(payload: str): str:
if payload.len() < 2:
ret ""
end
ret payload.substr(1, payload.len() - 1)
end
@en "SplitPayloads"
@fa "جداسازی بارها"
pub func SplitPayloads(body: str): Vector<str>:
mut out := Vector {} as Vector<str>
n := body.len()
if n == 0:
ret out
end
mut start := 0
mut i := 0
until i < n:
if char_code(body.substr(i, 1)) == RS:
out.push(body.substr(start, i - start))
start = i + 1
end
i += 1
end
out.push(body.substr(start, n - start))
ret out
end
@en "JoinPayloads"
@fa "پیوستن بارها"
pub func JoinPayloads(items: Vector<str>): str:
mut sb := str.NewBuilder()
defer str.BufFree(sb)
repeat items.len() in i:
if i > 0:
str.BufAppendChar(sb, RS)
end
str.BufAppend(sb, items.get(i))
end
ret str.BufStr(sb)
end
@en "SplitJSONArray"
@fa "جداسازی آرایه جیسون"
pub func SplitJSONArray(text: str): Vector<str>:
mut out := Vector {} as Vector<str>
s := str.Trim(text)
if not str.StartsWith(s, "["):
ret out
end
n := s.len()
mut i := 1
mut depth := 0
mut instr := false
mut esc := false
mut start := 0 - 1
mut done := false
until i < n and not done:
ch := s.substr(i, 1)
if instr:
if esc:
esc = false
else ch == "\\":
esc = true
else ch == "\"":
instr = false
end
else ch == "\"":
instr = true
if start < 0:
start = i
end
else ch == "[" or ch == "{":
if start < 0:
start = i
end
depth += 1
else ch == "]" and depth == 0:
if start >= 0:
out.push(str.Trim(s.substr(start, i - start)))
end
done = true
else ch == "]" or ch == "}":
depth -= 1
else ch == "," and depth == 0:
if start >= 0:
out.push(str.Trim(s.substr(start, i - start)))
else:
out.push("")
end
start = 0 - 1
else:
if not _is_ws(ch) and start < 0:
start = i
end
end
i += 1
end
ret out
end
@en "Placeholder"
@fa "جانگهدار"
pub func Placeholder(num: int): str:
ret `{"_placeholder":true,"num":` + num + "}"
end
@en "PlaceholderNum"
@fa "شماره جانگهدار"
pub func PlaceholderNum(frag: str): int:
if not str.Contains(frag, "_placeholder"):
ret 0 - 1
end
k := str.Find(frag, "\"num\"")
if k < 0:
ret 0 - 1
end
c := str.IndexFrom(frag, ":", k)
if c < 0:
ret 0 - 1
end
mut i := c + 1
until _is_ws(frag.substr(i, 1)):
i += 1
end
if _digit_at(frag, i) < 0:
ret 0 - 1
end
mut num := 0
until _digit_at(frag, i) >= 0 and num <= MAX_ATTACHMENTS:
num = num * 10 + _digit_at(frag, i)
i += 1
end
if num > MAX_ATTACHMENTS:
ret 0 - 1
end
ret num
end
@en "NewBytes"
@fa "بایت جدید"
pub func NewBytes(ptr: void*, n: int): Bytes:
if ptr == null or n <= 0:
ret Bytes {}
end
buf := mem.Allocate(n as u64)
if buf == null:
ret Bytes {}
end
mem.Copy(buf, ptr, n as u64)
ret Bytes { ptr = buf, len = n }
end
@en "BytesFromStr"
@fa "بایت از رشته"
pub func BytesFromStr(s: str): Bytes:
ret NewBytes(s as void*, s.len())
end
@en "BytesToStr"
@fa "بایت به رشته"
pub func BytesToStr(b: Bytes): str:
if b.ptr == null or b.len <= 0:
ret ""
end
mut sb := str.NewBuilder()
defer str.BufFree(sb)
bp := b.ptr as i8*
repeat b.len in i:
mut v := bp[i] as int
if v < 0:
v += 256
end
if v == 0:
ret str.BufStr(sb)
end
str.BufAppendChar(sb, v)
end
ret str.BufStr(sb)
end
@en "BytesToBase64"
@fa "بایت به بیس۶۴"
pub func BytesToBase64(b: Bytes): str:
if b.ptr == null or b.len <= 0:
ret ""
end
ret encoding.Base64EncodeBytes(b.ptr, b.len)
end
@en "BytesAt"
@fa "بایت در"
pub func BytesAt(b: Bytes, i: int): int:
if b.ptr == null or i < 0 or i >= b.len:
ret 0 - 1
end
bp := b.ptr as i8*
mut v := bp[i] as int
if v < 0:
v += 256
end
ret v
end
@en "BytesFree"
@fa "آزادسازی بایت"
pub func BytesFree(b &: Bytes):
if b.ptr != null:
mem.Free(b.ptr)
b.ptr = null
end
b.len = 0
end
@en "net/socketio"
@fa "سوکت‌آیاو"
package socketio
import str
import mem
import time
import encoding.json
import encoding.value
const RESERVED := "|connect|connect_error|disconnect|disconnecting|newListener|removeListener|"
func _lifecycle_name(kind: int): str:
if kind == EV_CONNECT:
ret "connect"
end
if kind == EV_DISCONNECT:
ret "disconnect"
end
if kind == EV_CONNECT_ERROR:
ret "connect_error"
end
if kind == EV_ERROR:
ret "error"
end
if kind == EV_RECONNECT:
ret "reconnect"
end
if kind == EV_RECONNECT_ATTEMPT:
ret "reconnect_attempt"
end
if kind == EV_RECONNECT_ERROR:
ret "reconnect_error"
end
if kind == EV_RECONNECT_FAILED:
ret "reconnect_failed"
end
if kind == EV_PING:
ret "ping"
end
if kind == EV_UPGRADE:
ret "upgrade"
end
ret ""
end
func _event_name(ev: Event): str:
if ev.kind == EV_EVENT:
ret ev.name
end
ret _lifecycle_name(ev.kind)
end
func _compact_handlers(v &: Vector<Handler>):
mut kept := Vector {} as Vector<Handler>
repeat v.len() in i:
h := v.get(i)
if h.alive:
kept.push(h)
end
end
v.free()
v = kept
end
func _deliver(c: Client, ev0: Event):
sp := _sock(c)
m := sp[0].mgr as MgrState*
mut ev := ev0
ev.client = c
mut dead := false
m[0].dispatching += 1
if ev.kind == EV_EVENT:
n := sp[0].any_handlers.len()
mut i := 0
until i < n and i < sp[0].any_handlers.len():
h := sp[0].any_handlers.get(i)
if h.alive:
h.cb(ev)
end
i += 1
end
end
want := _event_name(ev)
if want.len() > 0:
n := sp[0].handlers.len()
mut i := 0
until i < n and i < sp[0].handlers.len():
mut h := sp[0].handlers.get(i)
if h.alive and h.name == want:
h.cb(ev)
if h.once:
h.alive = false
sp[0].handlers.set(i, h)
dead = true
end
end
i += 1
end
end
if dead:
_compact_handlers(sp[0].handlers)
end
m[0].dispatching -= 1
if sp[0].queueing and sp[0].max_queue > 0:
sp[0].inbox.push(ev)
until sp[0].inbox.len() > sp[0].max_queue:
mut old := sp[0].inbox.get(0)
_free_bins(old.bins)
sp[0].inbox.remove_at(0)
end
else:
_free_bins(ev.bins)
end
end
func _notify_outgoing(c: Client, name: str, data: str, ack_id: int):
sp := _sock(c)
if sp[0].out_handlers.len() == 0:
ret
end
ev := Event { kind = EV_EVENT, name = name, nsp = sp[0].nsp, data = data, ack_id = ack_id, client = c }
n := sp[0].out_handlers.len()
mut i := 0
until i < n and i < sp[0].out_handlers.len():
h := sp[0].out_handlers.get(i)
if h.alive:
h.cb(ev)
end
i += 1
end
end
func _broadcast_lifecycle(m: MgrState*, kind: int, message: str):
repeat m[0].socks.len() in i:
c := m[0].socks.get(i)
_deliver(c, Event { kind = kind, nsp = _sock(c)[0].nsp, message = message, data = "[]" })
end
end
func _find_sock(m: MgrState*, nsp: str): Client:
repeat m[0].socks.len() in i:
c := m[0].socks.get(i)
if _sock(c)[0].nsp == nsp:
ret c
end
end
ret Client {}
end
func _resolve_ack(c: Client, id: int, data: str, bins &: Vector<Bytes>): bool:
sp := _sock(c)
mut found := false
repeat sp[0].waiters.len() in i:
mut w := sp[0].waiters.get(i)
if w.alive and w.id == id:
w.alive = false
if w.has_packet:
mut kept := w.packet
_free_bins(kept.bins)
w.has_packet = false
end
sp[0].waiters.set(i, w)
mut a := Ack { ok = true, id = id, data = data, bins = bins }
if w.has_cb:
w.cb(a)
_free_bins(a.bins)
else if w.internal:
_free_bins(a.bins)
else:
sp[0].results.push(a)
end
found = true
end
end
if not found:
_free_bins(bins)
end
ret found
end
func _expire_acks(m: MgrState*):
now := time.MonoMillis()
repeat m[0].socks.len() in s:
c := m[0].socks.get(s)
sp := _sock(c)
mut dead := false
repeat sp[0].waiters.len() in i:
mut w := sp[0].waiters.get(i)
if not w.alive:
dead = true
else w.has_deadline and now >= w.deadline:
if w.internal and m[0].state != ST_OPEN:
w.deadline = now + (w.interval as i64)
sp[0].waiters.set(i, w)
else w.retries_left > 0 and w.has_packet:
w.retries_left -= 1
w.deadline = now + (w.interval as i64)
sp[0].waiters.set(i, w)
_write_packet(m, w.packet.text, w.packet.bins)
else:
w.alive = false
dead = true
if w.has_packet:
mut p := w.packet
_free_bins(p.bins)
w.has_packet = false
end
sp[0].waiters.set(i, w)
a := Ack { ok = false, id = w.id, data = "[]" }
if w.has_cb:
w.cb(a)
else if not w.internal:
sp[0].results.push(a)
end
end
end
end
if dead:
_drop_dead_waiters(sp)
end
end
end
func _free_waiter_packets(sp: SockState*):
repeat sp[0].waiters.len() in i:
w := sp[0].waiters.get(i)
if w.has_packet:
mut p := w.packet
_free_bins(p.bins)
end
end
end
func _fail_pending_acks(sp: SockState*):
mut dead := false
repeat sp[0].waiters.len() in i:
mut w := sp[0].waiters.get(i)
if w.alive and not w.internal:
w.alive = false
sp[0].waiters.set(i, w)
dead = true
a := Ack { ok = false, id = w.id, data = "[]" }
if w.has_cb:
w.cb(a)
else:
sp[0].results.push(a)
end
end
end
if dead:
_drop_dead_waiters(sp)
end
end
func _drop_dead_waiters(sp: SockState*):
mut kept := Vector {} as Vector<AckWaiter>
repeat sp[0].waiters.len() in i:
w := sp[0].waiters.get(i)
if w.alive:
kept.push(w)
end
end
sp[0].waiters.free()
sp[0].waiters = kept
end
func _take_result(sp: SockState*, id: int, out &: Ack): bool:
repeat sp[0].results.len() in i:
a := sp[0].results.get(i)
if a.id == id:
out = a
sp[0].results.remove_at(i)
ret true
end
end
ret false
end
func _on_connect_packet(c: Client, p: Packet):
sp := _sock(c)
sp[0].id = json.Get(p.data, "sid")
newpid := json.Get(p.data, "pid")
sp[0].recovered = newpid.len() > 0 and sp[0].pid.len() > 0 and sp[0].pid == newpid
if newpid.len() > 0:
sp[0].pid = newpid
end
sp[0].connected = true
_flush_outbuf(c)
_deliver(c, Event { kind = EV_CONNECT, nsp = sp[0].nsp, data = "[]" })
end
func _on_event_packet(c: Client, p: Packet, bins &: Vector<Bytes>):
sp := _sock(c)
mut parts := SplitJSONArray(p.data)
defer parts.free()
if parts.len() == 0:
_free_bins(bins)
ret
end
name := ItemStr(p.data, 0)
mut rest := "["
mut i := 1
until i < parts.len():
if i > 1:
rest += ","
end
rest += parts.get(i)
i += 1
end
rest += "]"
if sp[0].pid.len() > 0 and parts.len() > 1:
last := parts.get(parts.len() - 1)
if str.StartsWith(last, "\""):
sp[0].last_offset = ItemStr(p.data, parts.len() - 1)
end
end
_deliver(c, Event { kind = EV_EVENT, name = name, nsp = sp[0].nsp, data = rest, ack_id = p.id, bins = bins })
end
func _handle_packet(m: MgrState*, p: Packet, bins &: Vector<Bytes>):
c := _find_sock(m, p.nsp)
if c.p == null:
_free_bins(bins)
ret
end
sp := _sock(c)
if p.kind == PKT_CONNECT:
_free_bins(bins)
_on_connect_packet(c, p)
else p.kind == PKT_CONNECT_ERROR:
_free_bins(bins)
sp[0].connected = false
mut why := json.Get(p.data, "message")
if why.len() == 0:
why = p.data
end
sp[0].refused = true
sp[0].refusal = why
_deliver(c, Event { kind = EV_CONNECT_ERROR, nsp = sp[0].nsp, message = why, data = "[]" })
else p.kind == PKT_DISCONNECT:
_free_bins(bins)
sp[0].connected = false
sp[0].id = ""
sp[0].active = false
_fail_pending_acks(sp)
_deliver(c, Event { kind = EV_DISCONNECT, nsp = sp[0].nsp, message = REASON_SERVER_DISCONNECT, data = "[]" })
else p.kind == PKT_EVENT or p.kind == PKT_BINARY_EVENT:
_on_event_packet(c, p, bins)
else p.kind == PKT_ACK or p.kind == PKT_BINARY_ACK:
_resolve_ack(c, p.id, p.data, bins)
else:
_free_bins(bins)
end
end
func _on_socketio_text(m: MgrState*, text: str):
p := DecodePacket(text)
if not p.ok:
_broadcast_lifecycle(m, EV_ERROR, REASON_PARSE_ERROR + ": " + text)
ret
end
if p.attachments > 0 and (p.kind == PKT_BINARY_EVENT or p.kind == PKT_BINARY_ACK):
_free_bins(m[0].recon_bins)
m[0].recon_bins = Vector {} as Vector<Bytes>
m[0].recon_pkt = p
m[0].recon = true
ret
end
mut none := Vector {} as Vector<Bytes>
_handle_packet(m, p, none)
end
func _on_socketio_binary(m: MgrState*, b: Bytes):
if not m[0].recon:
ret
end
m[0].recon_bins.push(NewBytes(b.ptr, b.len))
if m[0].recon_bins.len() < m[0].recon_pkt.attachments:
ret
end
p := m[0].recon_pkt
mut bins := m[0].recon_bins
m[0].recon_bins = Vector {} as Vector<Bytes>
m[0].recon = false
_handle_packet(m, p, bins)
end
func _write_packet(m: MgrState*, text: str, bins: Vector<Bytes>): bool:
if not _engine_write(m, text):
ret false
end
repeat bins.len() in i:
if not _engine_write_bytes(m, bins.get(i)):
ret false
end
end
ret true
end
func _send_connect(m: MgrState*, c: Client):
sp := _sock(c)
sp[0].refused = false
sp[0].refusal = ""
mut payload := ""
if sp[0].pid.len() > 0:
payload = `{"pid":` + json.Str(sp[0].pid) + `,"offset":` + json.Str(sp[0].last_offset) + "}"
else sp[0].auth.len() > 0:
payload = sp[0].auth
end
p := Packet { kind = PKT_CONNECT, nsp = sp[0].nsp, data = payload }
_engine_write(m, EncodeEngine(EIO_MESSAGE, EncodePacket(p)))
end
func _flush_outbuf(c: Client):
sp := _sock(c)
m := sp[0].mgr as MgrState*
if sp[0].outbuf.len() == 0:
ret
end
mut pending := sp[0].outbuf
sp[0].outbuf = Vector {} as Vector<Outgoing>
m[0].batching = true
repeat pending.len() in i:
mut o := pending.get(i)
_write_packet(m, o.text, o.bins)
_free_bins(o.bins)
end
m[0].batching = false
pending.free()
_poll_flush(m)
end
func _reconnect_namespaces(m: MgrState*):
repeat m[0].socks.len() in i:
c := m[0].socks.get(i)
if _sock(c)[0].active:
_send_connect(m, c)
end
end
end
func _engine_shutdown(m: MgrState*, reason: str):
if m[0].state == ST_CLOSED:
ret
end
_engine_close(m)
m[0].last_error = reason
mut wants_more := false
repeat m[0].socks.len() in i:
c := m[0].socks.get(i)
sp := _sock(c)
was := sp[0].connected
sp[0].connected = false
sp[0].id = ""
if sp[0].active:
wants_more = true
end
if was:
_fail_pending_acks(sp)
_deliver(c, Event { kind = EV_DISCONNECT, nsp = sp[0].nsp, message = reason, data = "[]" })
end
end
if m[0].opts.reconnection and wants_more:
m[0].state = ST_WAITING
m[0].retry_at = time.MonoMillis() + _backoff(m)
end
end
func _backoff(m: MgrState*): i64:
cap := m[0].opts.reconnection_delay_max as i64
mut d := m[0].opts.reconnection_delay as i64
if d < 1:
d = 1
end
mut i := 0
until i < m[0].attempts and d < cap:
d *= 2
i += 1
end
if d > cap:
d = cap
end
spread := (d * (m[0].opts.randomization_factor as i64)) / 100
if spread > 0:
d += rand.Int32Range(0, spread as int) as i64
end
ret d
end
func _reconnect_step(m: MgrState*, timeout_ms: int): int:
if m[0].state != ST_WAITING:
ret PUMP_CLOSED
end
limit := m[0].opts.reconnection_attempts
if limit > 0 and m[0].attempts >= limit:
m[0].state = ST_CLOSED
_broadcast_lifecycle(m, EV_RECONNECT_FAILED, "gave up after " + m[0].attempts + " attempts")
ret PUMP_CLOSED
end
now := time.MonoMillis()
if now < m[0].retry_at:
mut nap := (m[0].retry_at - now) as int
if timeout_ms >= 0 and nap > timeout_ms:
nap = timeout_ms
end
if nap > 0:
time.Sleep(nap)
end
ret PUMP_TIMEOUT
end
m[0].attempts += 1
_broadcast_lifecycle(m, EV_RECONNECT_ATTEMPT, "" + m[0].attempts)
if _engine_open(m):
m[0].attempts = 0
_reconnect_namespaces(m)
_broadcast_lifecycle(m, EV_RECONNECT, "")
ret PUMP_OK
end
_broadcast_lifecycle(m, EV_RECONNECT_ERROR, m[0].last_error)
m[0].retry_at = time.MonoMillis() + _backoff(m)
ret PUMP_TIMEOUT
end
func _pump_mgr(m: MgrState*, timeout_ms: int): int:
_expire_acks(m)
if m[0].state == ST_OPEN and _heartbeat_expired(m):
_engine_shutdown(m, REASON_PING_TIMEOUT)
end
if m[0].state != ST_OPEN:
ret _reconnect_step(m, timeout_ms)
end
rc := _transport_read(m, timeout_ms)
if rc == PUMP_CLOSED:
_engine_shutdown(m, REASON_TRANSPORT_CLOSE)
ret PUMP_CLOSED
end
ret rc
end
func _copy_outgoing(text: str, a: Args): Outgoing:
mut o := Outgoing { text = text }
repeat a.bins.len() in i:
b := a.bins.get(i)
o.bins.push(NewBytes(b.ptr, b.len))
end
ret o
end
func _emit_raw(c: Client, kind: int, name: str, a: Args, ack_id0: int, volatile: bool): bool:
sp := _sock(c)
m := sp[0].mgr as MgrState*
mut ack_id := ack_id0
mut retrying := false
if kind == PKT_EVENT and ack_id < 0 and m[0].opts.retries > 0 and m[0].opts.ack_timeout > 0:
ack_id = _next_ack_id(sp)
retrying = true
end
data := ArgsJSON(a, name)
mut p := Packet { kind = kind, nsp = sp[0].nsp, id = ack_id, data = data }
if a.bins.len() > 0:
if kind == PKT_EVENT:
p.kind = PKT_BINARY_EVENT
else:
p.kind = PKT_BINARY_ACK
end
p.attachments = a.bins.len()
end
text := EncodeEngine(EIO_MESSAGE, EncodePacket(p))
if kind == PKT_EVENT:
_notify_outgoing(c, name, data, ack_id0)
end
if retrying:
mut w := AckWaiter { id = ack_id, alive = true, internal = true, has_deadline = true, has_packet = true }
w.deadline = time.MonoMillis() + (m[0].opts.ack_timeout as i64)
w.interval = m[0].opts.ack_timeout
w.retries_left = m[0].opts.retries
w.packet = _copy_outgoing(text, a)
sp[0].waiters.push(w)
end
if not sp[0].connected:
if volatile:
ret false
end
sp[0].outbuf.push(_copy_outgoing(text, a))
ret true
end
ret _write_packet(m, text, a.bins)
end
func _wait_connected(c: Client, deadline: i64): bool:
sp := _sock(c)
m := sp[0].mgr as MgrState*
until not sp[0].connected and not sp[0].refused and time.MonoMillis() < deadline:
left := (deadline - time.MonoMillis()) as int
if left <= 0:
ret sp[0].connected
end
rc := _pump_mgr(m, left)
if rc == PUMP_CLOSED and m[0].state == ST_CLOSED:
ret sp[0].connected
end
end
ret sp[0].connected
end
func _reserved(name: str): bool:
ret str.Contains(RESERVED, "|" + name + "|")
end
func _norm_nsp(nsp: str): str:
mut s := str.Trim(nsp)
if s.len() == 0:
ret "/"
end
if not str.StartsWith(s, "/"):
s = "/" + s
end
ret s
end
func _norm_path(path: str): str:
mut s := str.Trim(path)
if s.len() == 0:
ret "/socket.io"
end
if not str.StartsWith(s, "/"):
s = "/" + s
end
until s.len() > 1 and str.EndsWith(s, "/"):
s = s.substr(0, s.len() - 1)
end
ret s
end
func _connect_timeout(m: MgrState*): int:
if m[0].opts.timeout > 0:
ret m[0].opts.timeout
end
ret 20000
end
func _ack_wait(m: MgrState*, timeout_ms: int): int:
if timeout_ms > 0:
ret timeout_ms
end
if timeout_ms < 0:
ret 0
end
ret m[0].opts.ack_timeout
end
func _next_ack_id(sp: SockState*): int:
id := sp[0].ack_seq
sp[0].ack_seq += 1
ret id
end
func _register_waiter(sp: SockState*, id: int, timeout_ms: int, has_cb: bool, cb: func (Ack)):
mut w := AckWaiter { id = id, alive = true, has_cb = has_cb, cb = cb }
if timeout_ms > 0:
w.has_deadline = true
w.deadline = time.MonoMillis() + (timeout_ms as i64)
end
sp[0].waiters.push(w)
end
func _free_sock(c: Client):
if c.p == null:
ret
end
sp := _sock(c)
sp[0].handlers.free()
sp[0].any_handlers.free()
sp[0].out_handlers.free()
_free_waiter_packets(sp)
sp[0].waiters.free()
repeat sp[0].outbuf.len() in i:
mut o := sp[0].outbuf.get(i)
_free_bins(o.bins)
end
sp[0].outbuf.free()
repeat sp[0].inbox.len() in i:
mut ev := sp[0].inbox.get(i)
_free_bins(ev.bins)
end
sp[0].inbox.free()
repeat sp[0].results.len() in i:
mut a := sp[0].results.get(i)
_free_bins(a.bins)
end
sp[0].results.free()
mem.Free(c.p)
end
func _any_active(m: MgrState*): bool:
mut any := false
repeat m[0].socks.len() in i:
if _sock(m[0].socks.get(i))[0].active:
any = true
end
end
ret any
end
@en "NewOptions"
@fa "گزینه‌های جدید"
pub func NewOptions(): Options:
ret Options {}
end
@en "NewManager"
@fa "مدیر جدید"
pub func NewManager(url: str, opts: Options): Manager:
mut ep := ParseURL(url)
mut o := opts
o.path = _norm_path(opts.path)
ep.path = o.path
m := _new_mgr(ep, o)
if m.p != null and not ep.ok:
mp := _mgr(m)
mp[0].last_error = "could not read the server URL: " + url
end
ret m
end
@en "Of"
@fa "از"
pub func Of(m: Manager, nsp: str): Client:
if m.p == null:
ret Client {}
end
mp := _mgr(m)
ns := _norm_nsp(nsp)
existing := _find_sock(mp, ns)
if existing.p != null:
ret existing
end
c := _new_sock(m.p, ns)
if c.p == null:
ret c
end
sp := _sock(c)
sp[0].auth = mp[0].opts.auth
sp[0].max_queue = mp[0].opts.event_queue
sp[0].queueing = mp[0].opts.event_queue > 0
mp[0].socks.push(c)
ret c
end
@en "ManagerOf"
@fa "مدیر کلاینت"
pub func ManagerOf(c: Client): Manager:
if c.p == null:
ret Manager {}
end
ret Manager { p = _sock(c)[0].mgr }
end
@en "Dial"
@fa "اتصال"
pub func Dial(url: str): Client:
ret DialWith(url, NewOptions())
end
@en "DialWith"
@fa "اتصال با"
pub func DialWith(url: str, opts: Options): Client:
m := NewManager(url, opts)
if m.p == null:
ret Client {}
end
mp := _mgr(m)
c := Of(m, mp[0].ep.namespace)
if not mp[0].ep.ok:
ret c
end
if mp[0].opts.auto_connect:
Connect(c)
end
ret c
end
@en "Connect"
@fa "وصل شدن"
pub func Connect(c: Client): bool:
if c.p == null:
ret false
end
sp := _sock(c)
m := sp[0].mgr as MgrState*
sp[0].active = true
if sp[0].connected:
ret true
end
if not m[0].ep.ok:
_deliver(c, Event { kind = EV_CONNECT_ERROR, nsp = sp[0].nsp, message = m[0].last_error, data = "[]" })
ret false
end
if m[0].state != ST_OPEN:
if not _engine_open(m):
if m[0].opts.reconnection:
m[0].state = ST_WAITING
m[0].retry_at = time.MonoMillis() + _backoff(m)
end
_deliver(c, Event { kind = EV_CONNECT_ERROR, nsp = sp[0].nsp, message = m[0].last_error, data = "[]" })
ret false
end
m[0].attempts = 0
end
_send_connect(m, c)
ret _wait_connected(c, time.MonoMillis() + (_connect_timeout(m) as i64))
end
@en "Disconnect"
@fa "قطع اتصال"
pub func Disconnect(c: Client):
if c.p == null:
ret
end
sp := _sock(c)
m := sp[0].mgr as MgrState*
sp[0].active = false
if sp[0].connected:
p := Packet { kind = PKT_DISCONNECT, nsp = sp[0].nsp }
_engine_write(m, EncodeEngine(EIO_MESSAGE, EncodePacket(p)))
sp[0].connected = false
sp[0].id = ""
_fail_pending_acks(sp)
_deliver(c, Event { kind = EV_DISCONNECT, nsp = sp[0].nsp, message = REASON_CLIENT_DISCONNECT, data = "[]" })
end
if not _any_active(m):
_engine_close(m)
m[0].state = ST_CLOSED
end
end
@en "CloseManager"
@fa "بستن مدیر"
pub func CloseManager(m: Manager):
if m.p == null:
ret
end
mp := _mgr(m)
if mp[0].dispatching > 0:
repeat mp[0].socks.len() in i:
Disconnect(mp[0].socks.get(i))
end
ret
end
repeat mp[0].socks.len() in i:
Disconnect(mp[0].socks.get(i))
end
_engine_close(mp)
repeat mp[0].socks.len() in i:
_free_sock(mp[0].socks.get(i))
end
mp[0].socks.free()
mp[0].cookies.free()
mp[0].pollout.free()
_free_bins(mp[0].recon_bins)
mem.Free(m.p)
end
@en "Close"
@fa "بستن"
pub func Close(c: Client):
if c.p == null:
ret
end
m := ManagerOf(c)
mp := _mgr(m)
Disconnect(c)
if mp[0].dispatching > 0:
ret
end
if mp[0].socks.len() <= 1:
CloseManager(m)
ret
end
mut kept := Vector {} as Vector<Client>
repeat mp[0].socks.len() in i:
other := mp[0].socks.get(i)
if other.p != c.p:
kept.push(other)
end
end
mp[0].socks.free()
mp[0].socks = kept
_free_sock(c)
end
@en "Pump"
@fa "پمپ"
pub func Pump(c: Client, timeout_ms: int): int:
if c.p == null:
ret PUMP_CLOSED
end
ret _pump_mgr(_mgr_of(c), timeout_ms)
end
@en "PumpManager"
@fa "پمپ مدیر"
pub func PumpManager(m: Manager, timeout_ms: int): int:
if m.p == null:
ret PUMP_CLOSED
end
ret _pump_mgr(_mgr(m), timeout_ms)
end
@en "Next"
@fa "بعدی"
pub func Next(c: Client, timeout_ms: int): Event:
if c.p == null:
ret Event { kind = EV_TIMEOUT }
end
sp := _sock(c)
m := sp[0].mgr as MgrState*
if sp[0].max_queue <= 0:
sp[0].max_queue = 256
end
sp[0].queueing = true
deadline := time.MonoMillis() + (timeout_ms as i64)
mut out := Event { kind = EV_TIMEOUT, nsp = sp[0].nsp, client = c }
mut going := true
mut finished := false
until going:
if sp[0].inbox.len() > 0:
out = sp[0].inbox.get(0)
sp[0].inbox.remove_at(0)
going = false
else finished:
going = false
else:
mut left := (deadline - time.MonoMillis()) as int
if timeout_ms < 0:
left = 0 - 1
else left <= 0:
going = false
end
if going:
rc := _pump_mgr(m, left)
if rc == PUMP_CLOSED and m[0].state == ST_CLOSED:
finished = true
end
end
end
end
ret out
end
@en "NextEvent"
@fa "رویداد بعدی"
pub func NextEvent(c: Client, timeout_ms: int): Event:
if c.p == null:
ret Event { kind = EV_TIMEOUT }
end
sp := _sock(c)
m := sp[0].mgr as MgrState*
deadline := time.MonoMillis() + (timeout_ms as i64)
mut out := Event { kind = EV_TIMEOUT, nsp = sp[0].nsp, client = c }
mut going := true
until going:
mut left := 0 - 1
if timeout_ms >= 0:
left = (deadline - time.MonoMillis()) as int
if left <= 0:
going = false
end
end
if going:
mut ev := Next(c, left)
if ev.kind == EV_EVENT or ev.kind == EV_TIMEOUT:
out = ev
going = false
else ev.kind == EV_DISCONNECT and (not sp[0].active or m[0].state == ST_CLOSED):
out = ev
going = false
else:
EventFree(ev)
end
end
end
ret out
end
@en "Run"
@fa "اجرا"
pub func Run(c: Client):
if c.p == null:
ret
end
sp := _sock(c)
m := sp[0].mgr as MgrState*
until sp[0].active and m[0].state != ST_CLOSED:
_pump_mgr(m, 1000)
end
end
@en "RunFor"
@fa "اجرا برای"
pub func RunFor(c: Client, ms: int):
if c.p == null:
ret
end
sp := _sock(c)
m := sp[0].mgr as MgrState*
deadline := time.MonoMillis() + (ms as i64)
until sp[0].active and m[0].state != ST_CLOSED and time.MonoMillis() < deadline:
mut left := (deadline - time.MonoMillis()) as int
if left > 250:
left = 250
end
if left <= 0:
ret
end
_pump_mgr(m, left)
end
end
@en "On"
@fa "روی"
pub func On(c: Client, name: str, cb: func (Event)):
if c.p == null:
ret
end
sp := _sock(c)
sp[0].handlers.push(Handler { name = name, cb = cb })
end
