@en "S3ExpiryRule"
@fa "اس۳ قاعده انقضا"
pub func S3ExpiryRule(prefix: str, days: int, abort_days: int): str:
mut sb := str.NewBuilder()
defer str.BufFree(sb)
str.BufAppend(sb, "<LifecycleConfiguration><Rule><ID>salam-expiry</ID>")
str.BufAppend(sb, "<Filter><Prefix>")
str.BufAppend(sb, _xml_escape(prefix))
str.BufAppend(sb, "</Prefix></Filter><Status>Enabled</Status>")
if days > 0:
str.BufAppend(sb, "<Expiration><Days>")
str.BufAppendInt(sb, days as i64)
str.BufAppend(sb, "</Days></Expiration>")
end
mut abort := abort_days
if abort <= 0: abort = 7 end
str.BufAppend(sb, "<AbortIncompleteMultipartUpload><DaysAfterInitiation>")
str.BufAppendInt(sb, abort as i64)
str.BufAppend(sb, "</DaysAfterInitiation></AbortIncompleteMultipartUpload>")
str.BufAppend(sb, "</Rule></LifecycleConfiguration>")
ret str.BufStr(sb)
end
package aws
import str
import env
import os
func _clean_endpoint(endpoint: str): str:
mut out := endpoint.trim()
until str.EndsWith(out, "/"):
out = out.substr(0, out.len() - 1)
end
ret out
end
func _env_first(a: str, b: str): str:
v := env.Get(a)
if v.len() > 0: ret v end
ret env.Get(b)
end
func _truthy(v: str): bool:
l := v.lower()
ret l == "1" or l == "true" or l == "yes" or l == "on"
end
func _line_at(text: str, from: int, stop &: int): str:
n := text.len()
if from >= n:
stop = n
ret ""
end
mut e := str.IndexFrom(text, "\n", from)
if e < 0: e = n end
stop = e + 1
mut line := text.substr(from, e - from)
if line.len() > 0 and str.EndsWith(line, "\r"):
line = line.substr(0, line.len() - 1)
end
ret line
end
func _ini_value(text: str, section: str, key: str): str:
want := "[" + section + "]"
mut inside := false
mut pos := 0
until pos < text.len():
mut next := 0
raw := _line_at(text, pos, next)
pos = next
line := raw.trim()
if line.len() == 0 or str.StartsWith(line, "#") or str.StartsWith(line, ";"):
continue
end
if str.StartsWith(line, "["):
inside = line == want
continue
end
if not inside: continue end
eq_at := line.find("=")
if eq_at < 0: continue end
if line.substr(0, eq_at).trim().lower() == key.lower():
ret line.substr(eq_at + 1, line.len() - eq_at - 1).trim()
end
end
ret ""
end
func _home(): str:
h := env.Get("HOME")
if h.len() > 0: ret h end
drive := env.Get("HOMEDRIVE")
rest := env.Get("HOMEPATH")
if drive.len() > 0 and rest.len() > 0: ret drive + rest end
ret env.Get("USERPROFILE")
end
@en "AwsEndpoint"
@fa "نقطه پایانی ای دبلیو اس"
pub func AwsEndpoint(region: str): str:
if region.len() == 0 or region == "us-east-1":
ret "https://s3.amazonaws.com"
end
ret "https://s3." + region + ".amazonaws.com"
end
@en "ForAws"
@fa "برای ای دبلیو اس"
pub func ForAws(region: str, bucket: str): Config:
mut cfg := Config {
endpoint = AwsEndpoint(region), bucket = bucket, path_style = false
}
if region.len() > 0: cfg.region = region end
ret cfg
end
@en "ForMinio"
@fa "برای مینیو"
pub func ForMinio(endpoint: str, bucket: str): Config:
ret Config {
endpoint = _clean_endpoint(endpoint), bucket = bucket, path_style = true
}
end
@en "ForR2"
@fa "برای آر۲"
pub func ForR2(account_id: str, bucket: str): Config:
ret Config {
endpoint = "https://" + account_id + ".r2.cloudflarestorage.com", region = "auto", bucket = bucket,
path_style = true
}
end
@en "ForSpaces"
@fa "برای اسپیسز"
pub func ForSpaces(region: str, bucket: str): Config:
ret Config {
endpoint = "https://" + region + ".digitaloceanspaces.com", region = region, bucket = bucket,
path_style = false
}
end
@en "ForWasabi"
@fa "برای واسابی"
pub func ForWasabi(region: str, bucket: str): Config:
