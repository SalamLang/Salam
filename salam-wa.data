if last == 32 or last == 58: ret true end
mut i := 0
until i < n:
c := _ub(bp, i)
if c == 10 or c == 13 or c == 9: ret true end
if c == 58 and i + 1 < n and _ub(bp, i + 1) == 32: ret true end
if c == 35 and i > 0 and _ub(bp, i - 1) == 32: ret true end
i = i + 1
end
ret false
end
func _json_str_literal(raw: str): str:
ret `"`.concat(Escape(raw)).concat(`"`)
