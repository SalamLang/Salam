end
package crypto
@en "Sha256Hex"
@fa "شا۲۵۶ شانزدهی"
pub func Sha256Hex(data: str): str:
dlen := data.len()
out := mem.Allocate(32 as u64)
defer mem.Free(out)
_sha256_core(data as void*, dlen, out)
mut result := ""
repeat 8 in i:
base := i * 4
w := (_bget(out, base) as i64) * 16777216 + (_bget(out, base + 1) as i64) * 65536 + (_bget(out, base + 2) as i64) * 256 + (_bget(out, base + 3) as i64)
result = result.concat(_hex32(w))
end
ret result
end
package crypto
@en "Sha512Hex"
@fa "شا۵۱۲ شانزدهی"
pub func Sha512Hex(data: str): str:
dlen := data.len()
out := mem.Allocate(64 as u64)
defer mem.Free(out)
_sha512_core(data as void*, dlen, out)
mut result := ""
repeat 16 in i:
base := i * 4
w := (_bget(out, base) as i64) * 16777216 + (_bget(out, base + 1) as i64) * 65536 + (_bget(out, base + 2) as i64) * 256 + (_bget(out, base + 3) as i64)
result = result.concat(_hex32(w))
end
ret result
end
@en "ctx"
@fa "زمینه"
package ctx
import mem
import sync
@en "Context"
@fa "زمینه"
pub struct Context:
pub state: i64* = null
pub parent: Context* = null
pub mu: sync.Mutex = sync.Mutex {}
pub cv: sync.CondVar = sync.CondVar {}
pub is_root: bool = false
end
func done_chain(c: Context, reason &: int): bool:
mut cur := c
until true:
s := cur.state
if s[0] != 0:
reason = 1
ret true
end
if s[2] != 0 and sync.NowMs() >= s[1]:
reason = 2
ret true
end
if cur.parent == null:
break
end
cur = cur.parent[0]
end
reason = 0
ret false
end
func nearest_deadline(c: Context): i64:
mut cur := c
mut best := 0 as i64
until true:
s := cur.state
if s[2] != 0:
if best == 0 or s[1] < best:
best = s[1]
end
end
if cur.parent == null:
break
end
cur = cur.parent[0]
end
ret best
end
func child_of(parent: Context, deadline: i64, has_deadline: bool): Context:
p := mem.AllocateZeroed(sizeof(Context) as u64) as Context*
p[0] = parent
st := mem.AllocateZeroed(24 as u64) as i64*
if has_deadline:
st[1] = deadline
st[2] = 1
end
ret Context { state = st, parent = p, mu = parent.mu, cv = parent.cv, is_root = false }
end
@en "Background"
@fa "پس زمینه"
pub func Background(): Context:
st := mem.AllocateZeroed(24 as u64) as i64*
ret Context {
state = st, parent = null, mu = sync.NewMutex(), cv = sync.NewCondVar(), is_root = true
}
end
@en "WithCancel"
@fa "با لغو"
pub func WithCancel(parent: Context): Context:
ret child_of(parent, 0 as i64, false)
end
@en "WithTimeout"
@fa "با مهلت"
pub func WithTimeout(parent: Context, ms: i64): Context:
ret child_of(parent, sync.NowMs() + ms, true)
end
@en "WithDeadline"
@fa "با موعد"
pub func WithDeadline(parent: Context, at_ms: i64): Context:
ret child_of(parent, at_ms, true)
end
@en "Cancel"
@fa "لغو"
pub func Cancel(c: Context):
s := c.state
sync.Lock(c.mu)
s[0] = 1
sync.Broadcast(c.cv)
sync.Unlock(c.mu)
end
@en "IsDone"
@fa "تمام شده"
pub func IsDone(c: Context): bool:
mut why := 0
sync.Lock(c.mu)
r := done_chain(c, why)
sync.Unlock(c.mu)
ret r
end
@en "Err"
@fa "خطا"
pub func Err(c: Context): str:
mut why := 0
sync.Lock(c.mu)
_ := done_chain(c, why)
sync.Unlock(c.mu)
if why == 1:
ret "cancelled"
end
if why == 2:
ret "deadline exceeded"
end
ret ""
end
@en "Deadline"
@fa "موعد"
pub func Deadline(c: Context): i64:
sync.Lock(c.mu)
d := nearest_deadline(c)
sync.Unlock(c.mu)
ret d
end
@en "Wait"
@fa "انتظار"
pub func Wait(c: Context, ms: i64): bool:
mut why := 0
sync.Lock(c.mu)
until_ms := sync.NowMs() + ms
mut fin := done_chain(c, why)
until not fin:
mut left := until_ms - sync.NowMs()
dl := nearest_deadline(c)
if dl > 0:
dleft := dl - sync.NowMs()
if dleft < left:
left = dleft
end
end
if left <= 0:
break
end
_ := sync.WaitCondTimeout(c.cv, c.mu, left)
fin = done_chain(c, why)
end
sync.Unlock(c.mu)
ret fin
end
@en "Free"
@fa "آزادسازی"
pub func Free(c: Context):
mem.Free(c.state as void*)
if c.parent != null:
mem.Free(c.parent as void*)
end
if c.is_root:
sync.DestroyCondVar(c.cv)
sync.Destroy(c.mu)
end
end
@en "data"
@fa "داده"
package data
@en "COL_FLOAT"
@fa "ستون اعشاری"
pub const COL_FLOAT := 0
@en "COL_INT"
@fa "ستون صحیح"
pub const COL_INT := 1
@en "COL_CAT"
@fa "ستون رده‌ای"
pub const COL_CAT := 2
@en "COL_STR"
@fa "ستون رشته‌ای"
pub const COL_STR := 3
package data
import conv
import encoding.csv
import io
import mem
import math
import matrix
import os
import str
@en "Table"
@fa "جدول"
pub struct Table:
pub names: Vector<str> = Vector {}
pub kinds: Vector<int> = Vector {}
pub cats: Vector<Vector<str>> = Vector {}
pub raw: Vector<Vector<str>> = Vector {}
pub cells: matrix.Matrix = matrix.Matrix {}
@en "rows"
@fa "سطرها"
pub func rows(): int: ret this.cells.rows end
@en "cols"
@fa "ستون‌ها"
pub func cols(): int: ret this.names.len() end
@en "col_index"
@fa "نمایه ستون"
pub func col_index(name: str): int:
repeat this.names.len() in j:
if str.Equals(this.names.get(j), name): ret j end
end
ret 0 - 1
end
@en "cat_levels"
@fa "سطوح رده‌ای"
pub func cat_levels(name: str): Vector<str>:
mut out := Vector {} as Vector<str>
j := this.col_index(name)
if j < 0 or this.kinds.get(j) != COL_CAT: ret out end
lv := this.cats.get(j)
repeat lv.len() in i: out.push(lv.get(i)) end
ret out
end
@en "to_matrix"
@fa "به ماتریس"
pub func to_matrix(): matrix.Matrix:
mut keep := Vector {} as Vector<int>
repeat this.kinds.len() in j:
if this.kinds.get(j) != COL_STR: keep.push(j) end
end
r := _select_cols(this.cells, keep)
keep.free()
ret r
end
@en "split_xy"
@fa "جداسازی ویژگی از برچسب"
pub func split_xy(label: str, x &: matrix.Matrix, y &: matrix.Matrix): bool:
lj := this.col_index(label)
if lj < 0 or this.kinds.get(lj) == COL_STR: ret false end
mut keep := Vector {} as Vector<int>
repeat this.kinds.len() in j:
if j != lj and this.kinds.get(j) != COL_STR: keep.push(j) end
end
matrix.Free(x)
matrix.Free(y)
x = _select_cols(this.cells, keep)
mut one := Vector {} as Vector<int>
one.push(lj)
y = _select_cols(this.cells, one)
keep.free()
one.free()
ret true
end
@en "free"
@fa "آزادسازی"
pub func free():
repeat this.names.len() in j: mem.Free(this.names.get(j) as void*) end
this.names.free()
this.kinds.free()
repeat this.cats.len() in j:
mut lv := this.cats.get(j)
_free_strs(lv)
end
this.cats.free()
repeat this.raw.len() in j:
mut rv := this.raw.get(j)
_free_strs(rv)
end
this.raw.free()
matrix.Free(this.cells)
end
end
inline pure func _bp(s: str): i8*: ret (s as void*) as i8* end
inline pure func _ub(bp: i8*, i: int): int:
mut v := bp[i] as int
if v < 0: v = v + 256 end
ret v
end
func _free_strs(v &: Vector<str>):
repeat v.len() in i: mem.Free(v.get(i) as void*) end
v.free()
end
func _trim(s: str): str:
mid := str.TrimRight(s)
out := str.TrimLeft(mid)
mem.Free(mid as void*)
ret out
end
func _is_number(s: str, whole &: bool): bool:
n := str.Len(s)
bp := _bp(s)
mut i := 0
if i < n and (_ub(bp, i) == 43 or _ub(bp, i) == 45): i += 1 end
mut digits := 0
until i < n and _ub(bp, i) >= 48 and _ub(bp, i) <= 57:
i += 1
digits += 1
end
whole = true
if i < n and _ub(bp, i) == 46:
whole = false
i += 1
until i < n and _ub(bp, i) >= 48 and _ub(bp, i) <= 57:
i += 1
digits += 1
end
end
if digits == 0: ret false end
if i < n and (_ub(bp, i) == 101 or _ub(bp, i) == 69):
whole = false
i += 1
if i < n and (_ub(bp, i) == 43 or _ub(bp, i) == 45): i += 1 end
mut ed := 0
until i < n and _ub(bp, i) >= 48 and _ub(bp, i) <= 57:
i += 1
ed += 1
end
if ed == 0: ret false end
end
ret i == n
end
func _select_cols(cells &: matrix.Matrix, keep &: Vector<int>): matrix.Matrix:
mut r := matrix.Zeros(cells.rows, keep.len())
repeat cells.rows in i:
repeat keep.len() in t: r.set(i, t, cells.at(i, keep.get(t))) end
end
ret r
end
func _level_index(levels &: Vector<str>, v: str): int:
repeat levels.len() in i:
if str.Equals(levels.get(i), v): ret i end
end
ret 0 - 1
end
@en "LoadCsv"
@fa "بارگذاری سی‌اس‌وی"
pub func LoadCsv(text: str, header: bool): Table:
mut t := Table {}
mut parsed := csv.ReadAll(text)
total := parsed.rows.len()
if total == 0: ret t end
mut first := 0
ncols := parsed.rows.get(0).fields.len()
if header:
hdr := parsed.rows.get(0)
repeat ncols in j: t.names.push(_trim(hdr.fields.get(j))) end
first = 1
else:
repeat ncols in j: t.names.push("col" + j) end
end
n := total - first
t.cells = matrix.Zeros(n, ncols)
nan := math.NaN()
repeat ncols in j:
mut all_int := true
mut all_num := true
mut levels := Vector {} as Vector<str>
mut texts := Vector {} as Vector<str>
repeat n in i:
row := parsed.rows.get(first + i)
mut cell := ""
if j < row.fields.len(): cell = _trim(row.fields.get(j)) end
texts.push(cell)
if str.Len(cell) > 0:
mut whole := false
if _is_number(cell, whole):
if whole == false: all_int = false end
else:
all_int = false
all_num = false
end
end
if _level_index(levels, cell) < 0: levels.push(str.Clone(cell)) end
end
mut kind := COL_STR
if all_num:
kind = COL_FLOAT
if all_int: kind = COL_INT end
else:
mut cap := n / 10
if cap < 20: cap = 20 end
if levels.len() <= cap and levels.len() < n: kind = COL_CAT end
end
t.kinds.push(kind)
repeat n in i:
cell := texts.get(i)
mut v := nan
if kind == COL_CAT:
v = _level_index(levels, cell) as f64
else kind != COL_STR:
if str.Len(cell) > 0: v = conv.ParseFloat(cell) end
end
t.cells.set(i, j, v)
end
if kind == COL_CAT:
t.cats.push(levels)
else:
_free_strs(levels)
t.cats.push(Vector {} as Vector<str>)
end
if kind == COL_STR:
t.raw.push(texts)
else:
_free_strs(texts)
t.raw.push(Vector {} as Vector<str>)
end
end
csv.FreeTable(parsed)
ret t
end
@en "LoadCsvFile"
@fa "بارگذاری پرونده سی‌اس‌وی"
pub func LoadCsvFile(path: str, header: bool, ok &: bool): Table:
ok = false
if os.Exists(path) == false: ret Table {} end
text := io.ReadFile(path)
t := LoadCsv(text, header)
mem.Free(text as void*)
ok = t.cols() > 0
ret t
end
package data
import matrix
import tensor
@en "BatchIter"
@fa "پیمایشگر دسته"
pub struct BatchIter:
pub x: matrix.Matrix = matrix.Matrix {}
pub y: matrix.Matrix = matrix.Matrix {}
pub batch: int = 32
pub shuffle: bool = true
pub seed: i64 = 0
pub order: Vector<int> = Vector {}
pub pos: int = 0
@en "reset"
@fa "بازنشانی"
pub func reset(epoch: i64):
n := this.x.rows
this.order.clear()
repeat n in i: this.order.push(i) end
if this.shuffle:
mut g := matrix.NewRng(this.seed + epoch)
mut i := n - 1
until i > 0:
j := (g.next_float() * ((i + 1) as f64)) as int
t := this.order.get(i)
this.order.set(i, this.order.get(j))
this.order.set(j, t)
i -= 1
end
end
this.pos = 0
end
@en "next"
@fa "بعدی"
pub func next(x_out &: matrix.Matrix, y_out &: matrix.Matrix): bool:
n := this.order.len()
if this.pos >= n: ret false end
mut cnt := this.batch
if this.pos + cnt > n: cnt = n - this.pos end
matrix.Free(x_out)
matrix.Free(y_out)
x_out = matrix.Zeros(cnt, this.x.cols)
y_out = matrix.Zeros(cnt, this.y.cols)
repeat cnt in i:
src := this.order.get(this.pos + i)
repeat this.x.cols in j: x_out.set(i, j, this.x.at(src, j)) end
repeat this.y.cols in j: y_out.set(i, j, this.y.at(src, j)) end
end
this.pos += cnt
ret true
end
@en "next_tensor"
@fa "بعدی تانسور"
pub func next_tensor(x_out &: tensor.Tensor, labels_out &: Vector<int>): bool:
n := this.order.len()
if this.pos >= n: ret false end
mut cnt := this.batch
if this.pos + cnt > n: cnt = n - this.pos end
x_out.free()
x_out = tensor.Zeros2(cnt, this.x.cols)
labels_out.clear()
p := x_out.data.data
repeat cnt in i:
src := this.order.get(this.pos + i)
repeat this.x.cols in j: p[i * this.x.cols + j] = this.x.at(src, j) as f32 end
labels_out.push(this.y.at(src, 0) as int)
end
this.pos += cnt
ret true
end
@en "batches_per_epoch"
@fa "شمار دسته در دور"
pub func batches_per_epoch(): int:
n := this.x.rows
if this.batch <= 0: ret 0 end
ret (n + this.batch - 1) / this.batch
end
@en "free"
@fa "آزادسازی"
pub func free(): this.order.free() end
end
@en "MatrixDataset"
@fa "مجموعه‌داده ماتریسی"
pub struct MatrixDataset:
pub x: matrix.Matrix = matrix.Matrix {}
pub y: matrix.Matrix = matrix.Matrix {}
@en "len"
@fa "طول"
pub func len(): int: ret this.x.rows end
@en "batches"
@fa "دسته‌ها"
pub func batches(batch: int, shuffle: bool, seed: i64): BatchIter:
mut it := BatchIter {}
it.x = this.x
it.y = this.y
it.batch = batch
it.shuffle = shuffle
it.seed = seed
it.reset(0)
ret it
end
@en "free"
@fa "آزادسازی"
pub func free():
matrix.Free(this.x)
matrix.Free(this.y)
end
end
@en "XTensor"
@fa "تانسور ویژگی"
pub func XTensor(x &: matrix.Matrix): tensor.Tensor:
ret tensor.FromMatrix(x)
end
@en "YLabels"
@fa "برچسب‌ها"
pub func YLabels(y &: matrix.Matrix): Vector<int>:
mut out := Vector {} as Vector<int>
repeat y.rows in i: out.push(y.at(i, 0) as int) end
ret out
end
package data
import archive
import compress
import encoding.binary
import matrix
const _IDX_U8 := 8
const _IDX_I8 := 9
const _IDX_I16 := 11
const _IDX_I32 := 12
const _IDX_F32 := 13
const _IDX_F64 := 14
func _idx_elem(rd &: compress.ByteReader, kind: int): f64:
if kind == _IDX_U8: ret binary.ReadU8(rd) as f64 end
if kind == _IDX_I8:
mut v := binary.ReadU8(rd)
if v >= 128: v = v - 256 end
ret v as f64
end
if kind == _IDX_I16:
mut v := binary.ReadU16BE(rd)
if v >= 32768: v = v - 65536 end
ret v as f64
end
if kind == _IDX_I32: ret binary.ReadU32BE(rd) as f64 end
if kind == _IDX_F32: ret binary.ReadF32(rd, true) end
ret binary.ReadF64(rd, true)
end
func _idx_size(kind: int): int:
if kind == _IDX_U8 or kind == _IDX_I8: ret 1 end
if kind == _IDX_I16: ret 2 end
if kind == _IDX_I32 or kind == _IDX_F32: ret 4 end
ret 8
end
@en "ParseIdx"
@fa "تجزیه آی‌دی‌ایکس"
pub func ParseIdx(p: void*, n: int, ok &: bool): matrix.Matrix:
ok = false
if n < 8: ret matrix.Matrix {} end
mut rd := compress.NewByteReader(p, n)
if binary.ReadU8(rd) != 0 or binary.ReadU8(rd) != 0: ret matrix.Matrix {} end
kind := binary.ReadU8(rd)
ndim := binary.ReadU8(rd)
if ndim < 1 or ndim > 4: ret matrix.Matrix {} end
if kind != _IDX_U8 and kind != _IDX_I8 and kind != _IDX_I16 and kind != _IDX_I32 and kind != _IDX_F32 and kind != _IDX_F64:
ret matrix.Matrix {}
end
if compress.RdLeft(rd) < 4 * ndim: ret matrix.Matrix {} end
rows := binary.ReadU32BE(rd)
mut inner := 1
repeat ndim - 1: inner = inner * binary.ReadU32BE(rd) end
if rows < 0 or inner < 0: ret matrix.Matrix {} end
if compress.RdLeft(rd) < rows * inner * _idx_size(kind): ret matrix.Matrix {} end
mut m := matrix.Zeros(rows, inner)
repeat rows * inner in k: m.a.set(k, _idx_elem(rd, kind)) end
ok = true
ret m
end
@en "LoadIdx"
@fa "بارگذاری آی‌دی‌ایکس"
pub func LoadIdx(path: str, ok &: bool): matrix.Matrix:
ok = false
mut fok := false
mut raw := archive.ReadBinaryFile(path, fok)
if fok == false:
compress.BufFree(raw)
ret matrix.Matrix {}
end
n := compress.BufLen(raw)
mut m := matrix.Matrix {}
if n >= 2 and compress.BufGet(raw, 0) == 31 and compress.BufGet(raw, 1) == 139:
mut zok := false
mut plain := compress.GzipDecompressBuf(raw, zok)
if zok: m = ParseIdx(plain.data, compress.BufLen(plain), ok) end
compress.BufFree(plain)
else:
m = ParseIdx(raw.data, n, ok)
end
compress.BufFree(raw)
ret m
end
@en "LoadMnist"
@fa "بارگذاری ام‌نیست"
pub func LoadMnist(images_path: str, labels_path: str, x &: matrix.Matrix, y &: matrix.Matrix): bool:
mut iok := false
mut xi := LoadIdx(images_path, iok)
if iok == false:
matrix.Free(xi)
ret false
end
mut lok := false
mut yl := LoadIdx(labels_path, lok)
if lok == false or yl.rows != xi.rows:
matrix.Free(xi)
matrix.Free(yl)
ret false
end
matrix.ScaleInPlace(xi, 1.0 / 255.0)
matrix.Free(x)
matrix.Free(y)
x = xi
y = yl
ret true
end
package data
import filepath
import image
import os
import str
import tensor
inline pure func _sbp(s: str): i8*: ret (s as void*) as i8* end
inline pure func _sub(bp: i8*, i: int): int:
mut v := bp[i] as int
if v < 0: v = v + 256 end
ret v
end
func _str_less(a: str, b: str): bool:
na := str.Len(a)
nb := str.Len(b)
pa := _sbp(a)
pb := _sbp(b)
mut i := 0
until i < na and i < nb:
ca := _sub(pa, i)
cb := _sub(pb, i)
if ca != cb: ret ca < cb end
i += 1
end
ret na < nb
end
func _sort_names(v &: Vector<str>):
n := v.len()
mut i := 1
until i < n:
key := v.get(i)
mut j := i - 1
until j >= 0 and _str_less(key, v.get(j)):
v.set(j + 1, v.get(j))
j -= 1
end
v.set(j + 1, key)
i += 1
end
end
func _listing(dir: str): Vector<str>:
mut raw := os.ListDir(dir)
mut out := Vector {} as Vector<str>
repeat raw.len() in i:
e := raw.get(i)
if str.Equals(e, ".") or str.Equals(e, ".."): continue end
if os.Exists(e) and str.StartsWith(e, dir):
out.push(e)
else:
out.push(filepath.Join(dir, e))
end
end
raw.free()
_sort_names(out)
ret out
end
func _base_name(path: str): str:
n := str.Len(path)
bp := _sbp(path)
mut i := n - 1
until i >= 0 and _sub(bp, i) != 47 and _sub(bp, i) != 92: i -= 1 end
ret str.Substr(path, i + 1, n - i - 1)
end
func _pack(img: image.Image, p: f32*, s: int, c: int, h: int, w: int):
inv := (1.0 / 255.0) as f32
repeat h in y:
repeat w in x:
px := image.GetPixel(img, x, y)
r := (px.r as int) as f32
g := (px.g as int) as f32
b := (px.b as int) as f32
base := s * c * h * w
if c == 1:
lum := (0.299 as f32) * r + (0.587 as f32) * g + (0.114 as f32) * b
p[base + y * w + x] = lum * inv
else:
p[base + y * w + x] = r * inv
p[base + h * w + y * w + x] = g * inv
p[base + 2 * h * w + y * w + x] = b * inv
end
end
end
end
@en "LoadImageFolder"
@fa "بارگذاری پوشه تصویر"
pub func LoadImageFolder(root: str, width: int, height: int, gray: bool, x &: tensor.Tensor, labels &: Vector<int>, classes &: Vector<str>): bool:
labels.clear()
classes.clear()
if width <= 0 or height <= 0 or os.IsDir(root) == false: ret false end
mut dirs := _listing(root)
mut files := Vector {} as Vector<str>
mut file_class := Vector {} as Vector<int>
repeat dirs.len() in d:
dpath := dirs.get(d)
if os.IsDir(dpath) == false: continue end
cls := classes.len()
classes.push(_base_name(dpath))
mut inner := _listing(dpath)
repeat inner.len() in f:
if os.IsDir(inner.get(f)) == false:
files.push(inner.get(f))
file_class.push(cls)
end
end
inner.free()
end
dirs.free()
mut c := 3
if gray: c = 1 end
mut imgs := Vector {} as Vector<image.Image>
repeat files.len() in f:
mut ok := false
mut img := image.Open(files.get(f), ok)
if ok and img.width > 0 and img.height > 0:
sized := image.ResizeNearestNeighbor(img, width, height)
image.Free(img)
imgs.push(sized)
labels.push(file_class.get(f))
else:
image.Free(img)
end
end
files.free()
file_class.free()
n := imgs.len()
x.free()
if n == 0:
imgs.free()
ret false
end
x = tensor.Zeros4(n, c, height, width)
p := x.data.data
repeat n in s:
mut img := imgs.get(s)
_pack(img, p, s, c, height, width)
image.Free(img)
end
imgs.free()
ret true
end
package data
import math
import matrix
func _centers(g &: matrix.Rng, k: int, p: int): matrix.Matrix:
mut c := matrix.Zeros(k, p)
repeat k * p in i:
c.a.set(i, 0.0 - 10.0 + 20.0 * g.next_float())
end
ret c
end
@en "MakeBlobs"
@fa "ساخت خوشه‌ها"
pub func MakeBlobs(n: int, centers: int, p: int, spread: f64, seed: i64, y &: matrix.Matrix): matrix.Matrix:
if n <= 0 or centers <= 0 or p <= 0: ret matrix.Matrix {} end
mut g := matrix.NewRng(seed)
mut c := _centers(g, centers, p)
defer matrix.Free(c)
mut x := matrix.Zeros(n, p)
y = matrix.Zeros(n, 1)
repeat n in i:
cls := i % centers
y.set(i, 0, cls as f64)
repeat p in j:
x.set(i, j, c.at(cls, j) + spread * g.next_normal())
end
end
ret x
end
@en "MakeMoons"
@fa "ساخت هلال‌ها"
pub func MakeMoons(n: int, noise: f64, seed: i64, y &: matrix.Matrix): matrix.Matrix:
if n <= 0: ret matrix.Matrix {} end
mut g := matrix.NewRng(seed)
mut x := matrix.Zeros(n, 2)
y = matrix.Zeros(n, 1)
repeat n in i:
cls := i % 2
t := math.PI * g.next_float()
mut px := math.Cos(t)
mut py := math.Sin(t)
if cls == 1:
px = 1.0 - px
py = 0.5 - py
end
x.set(i, 0, px + noise * g.next_normal())
x.set(i, 1, py + noise * g.next_normal())
y.set(i, 0, cls as f64)
end
ret x
end
@en "MakeCircles"
@fa "ساخت دایره‌ها"
pub func MakeCircles(n: int, noise: f64, factor: f64, seed: i64, y &: matrix.Matrix): matrix.Matrix:
if n <= 0: ret matrix.Matrix {} end
mut g := matrix.NewRng(seed)
mut x := matrix.Zeros(n, 2)
y = matrix.Zeros(n, 1)
repeat n in i:
cls := i % 2
t := 2.0 * math.PI * g.next_float()
mut r := 1.0
if cls == 1: r = factor end
x.set(i, 0, r * math.Cos(t) + noise * g.next_normal())
x.set(i, 1, r * math.Sin(t) + noise * g.next_normal())
y.set(i, 0, cls as f64)
end
ret x
end
@en "MakeRegression"
@fa "ساخت رگرسیون"
pub func MakeRegression(n: int, p: int, noise: f64, seed: i64, y &: matrix.Matrix, true_coef &: matrix.Matrix): matrix.Matrix:
if n <= 0 or p <= 0: ret matrix.Matrix {} end
mut g := matrix.NewRng(seed)
true_coef = matrix.Zeros(p, 1)
repeat p in j:
true_coef.set(j, 0, 0.0 - 2.0 + 4.0 * g.next_float())
end
mut x := matrix.Zeros(n, p)
y = matrix.Zeros(n, 1)
repeat n in i:
mut acc := 0.0
repeat p in j:
v := g.next_normal()
x.set(i, j, v)
acc += v * true_coef.at(j, 0)
end
y.set(i, 0, acc + noise * g.next_normal())
end
ret x
end
@en "MakeClassification"
@fa "ساخت دسته‌بندی"
pub func MakeClassification(n: int, p: int, classes: int, sep: f64, seed: i64, y &: matrix.Matrix): matrix.Matrix:
if n <= 0 or p <= 0 or classes <= 0: ret matrix.Matrix {} end
mut g := matrix.NewRng(seed)
mut c := matrix.Zeros(classes, p)
repeat classes * p in i:
c.a.set(i, sep * (0.0 - 1.0 + 2.0 * g.next_float()))
end
mut x := matrix.Zeros(n, p)
y = matrix.Zeros(n, 1)
repeat n in i:
cls := i % classes
y.set(i, 0, cls as f64)
repeat p in j:
x.set(i, j, c.at(cls, j) + g.next_normal())
end
end
matrix.Free(c)
ret x
end
@en "db"
@fa "دیتابیس"
package db
@en "SQLITE"
@fa "اس کیو لایت"
pub const SQLITE := "sqlite"
@en "MYSQL"
@fa "مای اس کیو ال"
pub const MYSQL := "mysql"
@en "POSTGRES"
@fa "پستگرس"
pub const POSTGRES := "postgres"
@en "TYPE_NULL"
@fa "نوع خالی"
pub const TYPE_NULL := 0
@en "TYPE_INT"
@fa "نوع صحیح"
pub const TYPE_INT := 1
@en "TYPE_FLOAT"
@fa "نوع اعشاری"
pub const TYPE_FLOAT := 2
@en "TYPE_TEXT"
@fa "نوع متن"
pub const TYPE_TEXT := 3
@en "TYPE_BLOB"
@fa "نوع دودویی"
pub const TYPE_BLOB := 4
@en "Rows"
@fa "ردیف ها"
pub interface Rows:
@en "Ok"
@fa "معتبر"
func Ok(): bool
@en "Next"
@fa "بعدی"
func Next(): bool
@en "ColumnCount"
@fa "تعداد ستون"
func ColumnCount(): int
@en "ColumnName"
@fa "نام ستون"
func ColumnName(col: int): str
@en "ColumnType"
@fa "نوع ستون"
func ColumnType(col: int): int
@en "IsNull"
@fa "خالی است"
func IsNull(col: int): bool
@en "Text"
@fa "متن"
func Text(col: int): str
@en "Int"
@fa "عدد صحیح"
func Int(col: int): int
@en "Int64"
@fa "عدد صحیح۶۴"
func Int64(col: int): i64
@en "Float"
@fa "عدد اعشار"
func Float(col: int): f64
@en "Close"
@fa "بستن"
func Close(): int
end
@en "Tx"
@fa "تراکنش"
pub interface Tx:
@en "Ok"
@fa "معتبر"
func Ok(): bool
@en "Exec"
@fa "اجرا"
func Exec(sql: str): int
@en "Query"
@fa "پرسمان"
func Query(sql: str): dyn Rows
@en "Commit"
@fa "ثبت تراکنش"
func Commit(): int
@en "Rollback"
@fa "بازگردانی"
func Rollback(): int
end
@en "Connection"
@fa "اتصال"
pub interface Connection:
@en "Kind"
@fa "نوع"
func Kind(): str
@en "Ok"
@fa "معتبر"
func Ok(): bool
@en "Ping"
@fa "پینگ"
func Ping(): bool
@en "Exec"
@fa "اجرا"
func Exec(sql: str): int
@en "Query"
@fa "پرسمان"
func Query(sql: str): dyn Rows
@en "Begin"
@fa "شروع تراکنش"
func Begin(): dyn Tx
@en "LastInsertId"
@fa "شناسه آخرین درج"
func LastInsertId(): i64
@en "Changes"
@fa "تعداد تغییرات"
func Changes(): i64
@en "Error"
@fa "خطا"
func Error(): str
@en "Quote"
@fa "نقل قول"
func Quote(s: str): str
@en "Close"
@fa "بستن"
func Close(): int
end
@en "QueryInt"
@fa "پرسمان عدد"
pub func QueryInt(c: dyn Connection, sql: str): int:
r := c.Query(sql)
mut out := 0
if r.Ok():
if r.Next():
out = r.Int(0)
end
r.Close()
end
ret out
end
@en "QueryInt64"
@fa "پرسمان عدد۶۴"
pub func QueryInt64(c: dyn Connection, sql: str): i64:
r := c.Query(sql)
mut out := 0 as i64
if r.Ok():
if r.Next():
out = r.Int64(0)
end
r.Close()
end
ret out
end
@en "QueryFloat"
@fa "پرسمان اعشار"
pub func QueryFloat(c: dyn Connection, sql: str): f64:
r := c.Query(sql)
mut out := 0.0
if r.Ok():
if r.Next():
out = r.Float(0)
end
r.Close()
end
ret out
end
@en "QueryText"
@fa "پرسمان متن"
pub func QueryText(c: dyn Connection, sql: str): str:
r := c.Query(sql)
mut out := ""
if r.Ok():
if r.Next():
out = r.Text(0)
end
r.Close()
end
ret out
end
@en "CountRows"
@fa "شمارش ردیف ها"
pub func CountRows(c: dyn Connection, sql: str): int:
r := c.Query(sql)
mut n := 0
if r.Ok():
until r.Next():
n = n + 1
end
r.Close()
end
ret n
end
@en "Run"
@fa "اجرا کن"
pub func Run(c: dyn Connection, sql: str): bool:
ret c.Exec(sql) == 0
end
@en "RunAll"
@fa "اجرای همه"
pub func RunAll(c: dyn Connection, stmts: Vector<str>): int:
mut done := 0
mut i := 0
until i < stmts.len():
if c.Exec(stmts.get(i)) != 0:
ret done
end
done = done + 1
i = i + 1
end
ret done
end
@en "InTx"
@fa "در تراکنش"
pub func InTx(c: dyn Connection, stmts: Vector<str>): bool:
t := c.Begin()
if not t.Ok():
ret false
end
mut i := 0
until i < stmts.len():
if t.Exec(stmts.get(i)) != 0:
t.Rollback()
ret false
end
i = i + 1
end
ret t.Commit() == 0
end
@en "QuoteLiteral"
@fa "نقل قول"
pub func QuoteLiteral(s: str): str:
mut out := "'"
mut i := 0
until i < len(s):
ch := s[i]
if ch == '\'':
out = out + "''"
else:
out = out + ch
end
i = i + 1
end
ret out + "'"
end
package db
import conv
@en "MIGRATION_TABLE"
@fa "جدول مهاجرت"
pub const MIGRATION_TABLE := "schema_migrations"
@en "Migration"
@fa "مهاجرت"
pub struct Migration:
pub version: int = 0
pub name: str = ""
pub up: str = ""
pub down: str = ""
end
@en "Migrator"
@fa "مهاجرت گر"
pub struct Migrator:
pub items: Vector<Migration>
pub table: str = ""
end
func _TrimSpace(s: str): str:
mut start := 0
mut stop := len(s)
until start < stop and _IsSpace(s[start]):
start = start + 1
end
until stop > start and _IsSpace(s[stop - 1]):
stop = stop - 1
end
mut out := ""
mut i := start
until i < stop:
out = out + s[i]
i = i + 1
end
ret out
end
func _IsSpace(c: char): bool:
ret c == ' ' or c == '\t' or c == '\n' or c == '\r'
end
func _ApplyUp(m: Migrator, c: dyn Connection, step: Migration): bool:
stmts := SplitStatements(step.up)
defer stmts.free()
stmts.push(
"INSERT INTO " + m.table + " (version, name, applied_at) VALUES (" + conv.FormatInt(step.version as i64) + ", " + QuoteLiteral(step.name) + ", CURRENT_TIMESTAMP)"
)
ret InTx(c, stmts)
end
func _ApplyDown(m: Migrator, c: dyn Connection, step: Migration): bool:
if step.down == "":
ret false
end
stmts := SplitStatements(step.down)
defer stmts.free()
stmts.push("DELETE FROM " + m.table + " WHERE version = " + conv.FormatInt(step.version as i64))
ret InTx(c, stmts)
end
@en "NewMigrator"
@fa "مهاجرت گر جدید"
pub func NewMigrator(): Migrator:
ret Migrator { items = Vector {} as Vector<Migration>, table = MIGRATION_TABLE }
end
@en "NewMigratorIn"
@fa "مهاجرت گر در"
pub func NewMigratorIn(table: str): Migrator:
ret Migrator { items = Vector {} as Vector<Migration>, table = table }
end
@en "FreeMigrator"
@fa "آزادکردن مهاجرت گر"
pub func FreeMigrator(m &: Migrator):
m.items.free()
end
@en "AddMigration"
@fa "افزودن مهاجرت"
pub func AddMigration(m &: Migrator, version: int, name: str, up: str, down: str):
step := Migration { version = version, name = name, up = up, down = down }
mut i := 0
until i < m.items.len():
if m.items.get(i).version > version:
m.items.insert(i, step)
ret
end
i = i + 1
end
m.items.push(step)
end
@en "MigrationCount"
@fa "تعداد مهاجرت"
pub func MigrationCount(m: Migrator): int: ret m.items.len() end
@en "SplitStatements"
@fa "جداکردن دستورها"
pub func SplitStatements(sql: str): Vector<str>:
mut out := Vector {} as Vector<str>
mut cur := ""
mut inquote := false
mut i := 0
until i < len(sql):
ch := sql[i]
if ch == '\'':
inquote = not inquote
cur = cur + ch
else:
if ch == ';' and not inquote:
trimmed := _TrimSpace(cur)
if trimmed != "":
out.push(trimmed)
end
cur = ""
else:
cur = cur + ch
end
end
i = i + 1
end
last := _TrimSpace(cur)
if last != "":
out.push(last)
end
ret out
end
@en "EnsureTable"
@fa "ساخت جدول"
pub func EnsureTable(m: Migrator, c: dyn Connection): int:
ret c.Exec(
"CREATE TABLE IF NOT EXISTS " + m.table + " (version INTEGER PRIMARY KEY, name TEXT NOT NULL, applied_at TEXT NOT NULL)"
)
end
@en "SchemaVersion"
@fa "نسخه طرح‌واره"
pub func SchemaVersion(m: Migrator, c: dyn Connection): int:
EnsureTable(m, c)
ret QueryInt(c, "SELECT COALESCE(MAX(version), 0) FROM " + m.table)
end
@en "IsApplied"
@fa "اعمال شده"
pub func IsApplied(m: Migrator, c: dyn Connection, version: int): bool:
EnsureTable(m, c)
ret QueryInt(
c, "SELECT COUNT(*) FROM " + m.table + " WHERE version = " + conv.FormatInt(version as i64)
) > 0
end
@en "PendingCount"
@fa "تعداد در انتظار"
pub func PendingCount(m: Migrator, c: dyn Connection): int:
at := SchemaVersion(m, c)
mut n := 0
mut i := 0
until i < m.items.len():
if m.items.get(i).version > at:
n = n + 1
end
i = i + 1
end
ret n
end
@en "MigrateUp"
@fa "مهاجرت به بالا"
pub func MigrateUp(m: Migrator, c: dyn Connection): int:
at := SchemaVersion(m, c)
mut done := 0
mut i := 0
until i < m.items.len():
step := m.items.get(i)
if step.version > at:
if not _ApplyUp(m, c, step):
ret done
end
done = done + 1
end
i = i + 1
end
ret done
end
@en "Rollback"
@fa "بازگردانی"
pub func Rollback(m: Migrator, c: dyn Connection): bool:
at := SchemaVersion(m, c)
if at == 0:
ret false
end
mut i := m.items.len() - 1
until i >= 0:
step := m.items.get(i)
if step.version == at:
ret _ApplyDown(m, c, step)
end
i = i - 1
end
ret false
end
@en "MigrateTo"
@fa "مهاجرت به"
pub func MigrateTo(m: Migrator, c: dyn Connection, target: int): int:
mut moved := 0
mut at := SchemaVersion(m, c)
until at < target:
mut i := 0
mut ran := false
until i < m.items.len():
step := m.items.get(i)
if step.version > at and step.version <= target:
if not _ApplyUp(m, c, step):
ret moved
end
moved = moved + 1
ran = true
i = m.items.len()
else:
i = i + 1
end
end
if not ran:
ret moved
end
at = SchemaVersion(m, c)
end
until at > target:
if not Rollback(m, c):
ret moved
end
moved = moved + 1
at = SchemaVersion(m, c)
end
ret moved
end
