@en "BgBlue"
@fa "پس‌زمینه آبی"
pub const BgBlue := 44
@en "BgMagenta"
@fa "پس‌زمینه ارغوانی"
pub const BgMagenta := 45
@en "BgCyan"
@fa "پس‌زمینه فیروزه‌ای"
