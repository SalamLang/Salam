maj := (a & b) ^ (a & c) ^ (b & c)
t2 := bigs0 + maj
hh = g
g = f
f = e
e = d + t1
d = c
c = b
b = a
a = t1 + t2
end
s.h[0] += a
s.h[1] += b
s.h[2] += c
s.h[3] += d
s.h[4] += e
s.h[5] += f
s.h[6] += g
s.h[7] += hh
