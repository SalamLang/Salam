ret true
end
func _prelu(model &: Model, node &: Node, env &: _Env): bool:
mut x := tensor.Empty()
mut sl := tensor.Empty()
if _in(model, node, env, 0, x) == false or _in(model, node, env, 1, sl) == false: ret false end
out := tensor.Clone(x)
p := out.data.data
ps := sl.data.data
ns := sl.numel()
inner := x.rank() > 2 ? x.numel() / (x.dim(0) * x.dim(1)) : 1
chan := x.rank() > 1 ? x.dim(1) : 1
zero := 0.0 as f32
repeat out.numel() in k:
if p[k] < zero:
mut s := ps[0]
if ns > 1:
c := (k / inner) % chan
if c < ns: s = ps[c] end
end
p[k] = p[k] * s
end
end
