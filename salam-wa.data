mut c1_13 := c1[13]
mut c1_14 := c1[14]
mut c1_15 := c1[15]
mut c2_0 := c2[0]
mut c2_1 := c2[1]
mut c2_2 := c2[2]
mut c2_3 := c2[3]
mut c2_4 := c2[4]
mut c2_5 := c2[5]
mut c2_6 := c2[6]
mut c2_7 := c2[7]
mut c2_8 := c2[8]
mut c2_9 := c2[9]
mut c2_10 := c2[10]
mut c2_11 := c2[11]
mut c2_12 := c2[12]
mut c2_13 := c2[13]
mut c2_14 := c2[14]
mut c2_15 := c2[15]
mut c3_0 := c3[0]
mut c3_1 := c3[1]
mut c3_2 := c3[2]
mut c3_3 := c3[3]
mut c3_4 := c3[4]
mut c3_5 := c3[5]
mut c3_6 := c3[6]
mut c3_7 := c3[7]
mut c3_8 := c3[8]
mut c3_9 := c3[9]
mut c3_10 := c3[10]
mut c3_11 := c3[11]
mut c3_12 := c3[12]
mut c3_13 := c3[13]
mut c3_14 := c3[14]
mut c3_15 := c3[15]
repeat kn in k:
pak := _p3264(pa, k * (_MR as i64))
pbk := _p3264(pb, k * (_NR as i64))
b0 := pbk[0]
b1 := pbk[1]
b2 := pbk[2]
b3 := pbk[3]
b4 := pbk[4]
b5 := pbk[5]
b6 := pbk[6]
b7 := pbk[7]
b8 := pbk[8]
b9 := pbk[9]
b10 := pbk[10]
b11 := pbk[11]
b12 := pbk[12]
b13 := pbk[13]
b14 := pbk[14]
b15 := pbk[15]
v0 := pak[0]
c0_0 += v0 * b0
c0_1 += v0 * b1
c0_2 += v0 * b2
c0_3 += v0 * b3
c0_4 += v0 * b4
c0_5 += v0 * b5
