compress.BufFree(b)
else fnum == 7:
good = _read_floats(rd, wt, a.floats)
else fnum == 8:
good = _read_ints(rd, wt, a.ints)
else fnum == 20:
mut ok := false
a.kind = protobuf.ReadVarint(rd, ok) as int
good = ok
else:
good = _skip(rd, wt)
end
end
ret good
end
func _decode_node(p: void*, n: int, node &: Node): bool:
mut rd := compress.NewByteReader(p, n)
mut good := true
until compress.RdLeft(rd) > 0 and good:
mut fnum := 0
mut wt := 0
mut tok := false
protobuf.ReadTag(rd, fnum, wt, tok)
if tok == false:
good = false
else fnum == 1:
mut ok := false
node.inputs.push(protobuf.ReadLenPrefixedStr(rd, ok))
good = ok
else fnum == 2:
mut ok := false
node.outputs.push(protobuf.ReadLenPrefixedStr(rd, ok))
good = ok
else fnum == 3:
mut ok := false
node.name = protobuf.ReadLenPrefixedStr(rd, ok)
good = ok
else fnum == 4:
mut ok := false
node.op = protobuf.ReadLenPrefixedStr(rd, ok)
good = ok
else fnum == 5:
mut ok := false
mut b := protobuf.ReadLenPrefixedBuf(rd, ok)
if ok:
mut a := Attr {}
good = _decode_attr(b.data, compress.BufLen(b), a)
node.attrs.push(a)
else:
good = false
end
compress.BufFree(b)
else:
good = _skip(rd, wt)
end
end
ret good
end
func _decode_value_name(p: void*, n: int, name_out &: str): bool:
mut rd := compress.NewByteReader(p, n)
mut good := true
until compress.RdLeft(rd) > 0 and good:
mut fnum := 0
mut wt := 0
mut tok := false
protobuf.ReadTag(rd, fnum, wt, tok)
if tok == false:
good = false
else fnum == 1:
mut ok := false
name_out = protobuf.ReadLenPrefixedStr(rd, ok)
good = ok
else:
good = _skip(rd, wt)
end
end
ret good
end
func _decode_graph(p: void*, n: int, m &: Model): bool:
mut rd := compress.NewByteReader(p, n)
mut good := true
until compress.RdLeft(rd) > 0 and good:
mut fnum := 0
mut wt := 0
mut tok := false
protobuf.ReadTag(rd, fnum, wt, tok)
if tok == false:
good = false
else fnum == 1:
mut ok := false
mut b := protobuf.ReadLenPrefixedBuf(rd, ok)
if ok:
mut node := Node {}
good = _decode_node(b.data, compress.BufLen(b), node)
m.nodes.push(node)
else:
good = false
end
compress.BufFree(b)
else fnum == 5:
mut ok := false
mut b := protobuf.ReadLenPrefixedBuf(rd, ok)
if ok:
mut nm := ""
mut t := tensor.Empty()
good = _decode_tensor(b.data, compress.BufLen(b), nm, t)
m.init_names.push(nm)
m.inits.push(t)
else:
good = false
end
compress.BufFree(b)
else fnum == 11 or fnum == 12:
mut ok := false
mut b := protobuf.ReadLenPrefixedBuf(rd, ok)
if ok:
mut nm := ""
good = _decode_value_name(b.data, compress.BufLen(b), nm)
if fnum == 11: m.inputs.push(nm) else:
m.outputs.push(nm)
end
else:
good = false
end
compress.BufFree(b)
else:
good = _skip(rd, wt)
end
end
ret good
end
func _decode_model(p: void*, n: int, m &: Model): bool:
mut rd := compress.NewByteReader(p, n)
mut good := true
mut saw_graph := false
until compress.RdLeft(rd) > 0 and good:
mut fnum := 0
mut wt := 0
mut tok := false
protobuf.ReadTag(rd, fnum, wt, tok)
if tok == false:
good = false
else fnum == 1:
mut ok := false
m.ir_version = protobuf.ReadVarint(rd, ok) as i64
good = ok
else fnum == 7:
mut ok := false
mut b := protobuf.ReadLenPrefixedBuf(rd, ok)
if ok:
good = _decode_graph(b.data, compress.BufLen(b), m)
saw_graph = true
else:
good = false
end
compress.BufFree(b)
else:
good = _skip(rd, wt)
end
end
if good == false: m.error = str.Clone("malformed protobuf") end
if good and saw_graph == false:
m.error = str.Clone("no graph")
good = false
end
ret good
end
package onnx
import str
import tensor
struct _Env:
pub names: Vector<str> = Vector {}
pub vals: Vector<tensor.Tensor> = Vector {}
pub owned: Vector<bool> = Vector {}
end
func _env_find(env &: _Env, name: str): int:
mut i := env.names.len() - 1
until i >= 0:
if str.Equals(env.names.get(i), name): ret i end
i -= 1
end
ret 0 - 1
end
func _env_get(env &: _Env, name: str, out &: tensor.Tensor): bool:
k := _env_find(env, name)
if k < 0: ret false end
t := env.vals.get(k)
out.data = t.data
out.shape = t.shape
ret true
end
func _env_put(env &: _Env, name: str, t: tensor.Tensor, owned: bool):
env.names.push(name)
env.vals.push(t)
env.owned.push(owned)
end
func _env_free(env &: _Env):
repeat env.vals.len() in i:
if env.owned.get(i):
mut t := env.vals.get(i)
t.free()
end
end
env.names.free()
env.vals.free()
env.owned.free()
end
func _run_graph(model &: Model, inputs &: Vector<tensor.Tensor>, ok &: bool): Vector<tensor.Tensor>:
mut outs := Vector {} as Vector<tensor.Tensor>
ok = false
if model.ok == false: ret outs end
mut env := _Env {}
repeat model.inits.len() in i:
_env_put(env, model.init_names.get(i), model.inits.get(i), false)
end
mut feeds := model.feed_names()
if feeds.len() != inputs.len():
model.error = "expected " + feeds.len() + " inputs, got " + inputs.len()
feeds.free()
_env_free(env)
ret outs
end
repeat feeds.len() in i: _env_put(env, feeds.get(i), inputs.get(i), false) end
feeds.free()
mut good := true
mut ni := 0
until ni < model.nodes.len() and good:
node := model.nodes.get(ni)
good = _exec_node(model, node, env)
ni += 1
end
if good:
repeat model.outputs.len() in i:
mut t := tensor.Empty()
if _env_get(env, model.outputs.get(i), t):
outs.push(tensor.Clone(t))
else:
model.error = "output " + model.outputs.get(i) + " was never produced"
good = false
end
end
end
_env_free(env)
if good == false:
repeat outs.len() in i:
mut t := outs.get(i)
t.free()
end
outs.clear()
end
ok = good
ret outs
end
package opencv
import mem
@en "Contours"
@fa "پیرامون‌ها"
pub struct Contours:
pub handle: void* = null
@en "ok"
@fa "معتبر"
pub func ok(): bool: ret this.handle != null end
@en "count"
@fa "تعداد"
pub func count(): int:
if this.handle == null: ret 0 end
ret scv_contour_count(this.handle)
end
@en "point_count"
@fa "تعداد نقطه"
pub func point_count(idx: int): int:
if this.handle == null: ret 0 end
ret scv_contour_point_count(this.handle, idx)
end
@en "point"
@fa "نقطه"
pub func point(idx: int, pt_idx: int): Point:
if this.handle == null: ret Point {} end
buf := mem.Allocate(8 as u64)
defer mem.Free(buf)
p := buf as i32*
scv_contour_point_get(this.handle, idx, pt_idx, p)
ret Point { x = p[0], y = p[1] }
end
@en "area"
@fa "مساحت"
pub func area(idx: int): f64:
if this.handle == null: ret 0.0 end
ret scv_contour_area(this.handle, idx)
end
@en "bounding_rect"
@fa "مستطیل محاط"
pub func bounding_rect(idx: int): Rect:
if this.handle == null: ret Rect {} end
buf := mem.Allocate(16 as u64)
defer mem.Free(buf)
p := buf as i32*
scv_contour_bounding_rect(this.handle, idx, p)
ret Rect { x = p[0], y = p[1], width = p[2], height = p[3] }
end
@en "free"
@fa "آزادسازی"
pub func free():
if this.handle != null: scv_free_contours(this.handle) end
this.handle = null
end
end
package opencv
import collections
@en "Net"
@fa "شبکه"
pub struct Net:
pub handle: void* = null
@en "ok"
@fa "معتبر"
pub func ok(): bool: ret this.handle != null end
@en "set_input"
@fa "تنظیم ورودی"
pub func set_input(image: Mat, scale: f64, mean: Color, swap_rb: bool, size: Size): bool:
if this.handle == null or image.handle == null: ret false end
mut swap := 0
if swap_rb: swap = 1 end
ret scv_dnn_set_input(this.handle, image.handle, scale, mean.r as f64, mean.g as f64, mean.b as f64, swap, size.width, size.height) != 0
end
@en "forward"
@fa "پیش‌رو"
pub func forward(): Mat:
if this.handle == null: ret Mat { handle = null } end
ret Mat { handle = scv_dnn_forward(this.handle) }
end
@en "forward_layer"
@fa "پیش‌رو لایه"
pub func forward_layer(layer_name: str): Mat:
if this.handle == null: ret Mat { handle = null } end
ret Mat { handle = scv_dnn_forward_named(this.handle, layer_name) }
end
@en "free"
@fa "آزادسازی"
pub func free():
if this.handle != null: scv_dnn_free(this.handle) end
this.handle = null
end
end
@en "Detection"
@fa "شناسایی"
pub struct Detection:
pub class_id: int = 0
pub confidence: f64 = 0.0
pub x: int = 0
pub y: int = 0
pub width: int = 0
pub height: int = 0
end
@en "LoadNet"
@fa "بارگذاری شبکه"
pub func LoadNet(model_path: str, config_path: str): Net:
ret Net { handle = scv_dnn_load(model_path, config_path) }
end
@en "LoadNetSingleFile"
@fa "بارگذاری شبکه تک‌فایل"
pub func LoadNetSingleFile(path: str): Net:
ret LoadNet(path, "")
end
@en "ParseSSDDetections"
@fa "تجزیه شناسایی‌های اس‌اس‌دی"
pub func ParseSSDDetections(output: Mat, img_width: int, img_height: int, confidence_threshold: f64): Vector<Detection>:
mut out := Vector {} as Vector<Detection>
if output.handle == null: ret out end
n := output.total() / 7
p := output.data() as f32*
mut i := 0
until i < n:
base := i * 7
confidence := p[base + 2] as f64
if confidence >= confidence_threshold:
x1 := ((p[base + 3] as f64) * (img_width as f64)) as int
y1 := ((p[base + 4] as f64) * (img_height as f64)) as int
x2 := ((p[base + 5] as f64) * (img_width as f64)) as int
y2 := ((p[base + 6] as f64) * (img_height as f64)) as int
out.push(
Detection {
class_id = p[base + 1] as int, confidence = confidence, x = x1, y = y1, width = x2 - x1, height = y2 - y1,
}
)
end
i += 1
end
ret out
end
import opencv
import os
func main:
args := os.Args()
mut path := "input.jpg"
if args.len() > 1:
path = args.get(1)
end
img := opencv.Read(path)
if not img.ok():
println "failed to read", path, "-", opencv.LastError()
ret 1
end
println "loaded", path, "-", img.width(), "x", img.height(), img.channels(), "channels"
gray := img.to_gray()
edges := gray.canny(50.0, 150.0)
opencv.Write("edges.png", edges)
println "wrote edges.png"
resized := img.resize(800, 600, opencv.INTERP_LINEAR)
opencv.Write("resized.png", resized)
println "wrote resized.png"
defer img.free()
defer gray.free()
defer edges.free()
defer resized.free()
ret 0
end
import opencv
func main:
cam := opencv.OpenCamera(0)
if not cam.ok():
println "could not open camera 0 -", opencv.LastError()
ret 1
end
println "camera open - press 'q' or Esc to quit"
mut running := true
until running:
frame := cam.read()
if not frame.ok():
println "frame read failed -", opencv.LastError()
running = false
else:
edges := frame.to_gray().canny(50.0, 150.0)
opencv.Imshow("Camera", frame)
opencv.Imshow("Edges", edges)
frame.free()
edges.free()
key := opencv.WaitKey(1)
if key == 113 or key == 27:
running = false
end
end
end
cam.close()
opencv.DestroyAllWindows()
ret 0
end
import opencv
import os
func main:
args := os.Args()
if args.len() < 3:
println "usage: 03_feature_matching <image_a> <image_b>"
ret 1
end
path_a := args.get(1)
path_b := args.get(2)
a := opencv.Read(path_a)
b := opencv.Read(path_b)
if not a.ok() or not b.ok():
println "failed to read one of the images -", opencv.LastError()
ret 1
end
kp_a := a.detect_orb(500)
kp_b := b.detect_orb(500)
println path_a, "-", kp_a.count(), "keypoints"
println path_b, "-", kp_b.count(), "keypoints"
desc_a := kp_a.descriptors()
desc_b := kp_b.descriptors()
matches := opencv.MatchDescriptors(desc_a, desc_b, 30, opencv.NORM_HAMMING) as Vector<opencv.Match>
println matches.len(), "matches (best first)"
mut i := 0
until i < matches.len():
m := matches.get(i)
println "  query", m.query_idx, "-> train", m.train_idx, "distance", m.distance
i += 1
end
defer a.free()
defer b.free()
defer kp_a.free()
defer kp_b.free()
defer desc_a.free()
defer desc_b.free()
ret 0
end
import opencv
import os
func main:
args := os.Args()
if args.len() < 3:
println "usage: 04_face_detection <image> <cascade.xml>"
ret 1
end
img := opencv.Read(args.get(1))
if not img.ok():
println "failed to read image -", opencv.LastError()
ret 1
end
cascade := opencv.LoadCascade(args.get(2))
if not cascade.ok():
println "failed to load cascade -", opencv.LastError()
ret 1
end
gray := img.to_gray()
faces := cascade.detect(gray, 1.1, 3, 50) as Vector<opencv.DetectedObject>
println "found", faces.len(), "face(s)"
mut i := 0
until i < faces.len():
f := faces.get(i)
println "  face at (", f.x, ",", f.y, ") size", f.width, "x", f.height
img.rectangle(f.x, f.y, f.width, f.height, opencv.RGB(0, 255, 0), 2)
i += 1
end
opencv.Write("faces.png", img)
println "wrote faces.png"
defer img.free()
defer gray.free()
defer cascade.free()
ret 0
end
import opencv
import os
func main:
args := os.Args()
mut path := "photo.jpg"
if args.len() > 1:
path = args.get(1)
end
img := opencv.Read(path)
if not img.ok():
println "failed to read", path, "-", opencv.LastError()
ret 1
end
gray := img.to_gray()
blurred := gray.gaussian_blur(5, 0.0)
edges := blurred.threshold_otsu(255.0)
cs := edges.find_contours()
println "found", cs.count(), "contour(s)"
mut best_idx := -1
mut best_area := 0.0
mut i := 0
until i < cs.count():
a := cs.area(i)
if a > best_area:
best_area = a
best_idx = i
end
i += 1
end
if best_idx < 0:
println "no document-sized contour found"
ret 1
end
println "largest contour area:", best_area
r := cs.bounding_rect(best_idx)
println "bounding box:", r.x, r.y, r.width, r.height
corners := Vector {} as Vector<opencv.Point>
corners.push(opencv.Point { x = r.x, y = r.y })
corners.push(opencv.Point { x = r.x + r.width, y = r.y })
corners.push(opencv.Point { x = r.x + r.width, y = r.y + r.height })
corners.push(opencv.Point { x = r.x, y = r.y + r.height })
flattened := img.warp_perspective(corners, 800, 1000)
opencv.Write("scanned.png", flattened)
println "wrote scanned.png"
defer img.free()
defer gray.free()
defer blurred.free()
defer edges.free()
defer cs.free()
defer flattened.free()
ret 0
end
import opencv
import os
func main:
args := os.Args()
if args.len() < 3:
println "usage: 06_dnn_classification <image> <model.onnx>"
ret 1
end
img := opencv.Read(args.get(1))
if not img.ok():
println "failed to read image -", opencv.LastError()
ret 1
end
net := opencv.LoadNetSingleFile(args.get(2))
if not net.ok():
println "failed to load model -", opencv.LastError()
ret 1
end
ok := net.set_input(img, 1.0 / 255.0, opencv.RGB(0, 0, 0), true, opencv.Size { width = 224, height = 224 })
if not ok:
println "set_input failed -", opencv.LastError()
ret 1
end
output := net.forward()
if not output.ok():
println "forward pass failed -", opencv.LastError()
ret 1
end
n := output.total()
p := output.data() as f32*
mut best_idx := 0
mut best_score := p[0]
mut i := 1
until i < n:
if p[i] > best_score:
best_score = p[i]
best_idx = i
end
i += 1
end
println "predicted class:", best_idx, "score:", best_score
defer img.free()
defer net.free()
defer output.free()
ret 0
end
package opencv
import mem
import collections
@en "Keypoint"
@fa "نقطه کلیدی"
pub struct Keypoint:
pub x: f64 = 0.0
pub y: f64 = 0.0
pub size: f64 = 0.0
pub angle: f64 = 0.0
pub response: f64 = 0.0
end
@en "Keypoints"
@fa "نقاط کلیدی"
pub struct Keypoints:
pub handle: void* = null
@en "ok"
@fa "معتبر"
pub func ok(): bool: ret this.handle != null end
@en "count"
@fa "تعداد"
pub func count(): int:
if this.handle == null: ret 0 end
ret scv_keypoint_count(this.handle)
end
@en "get"
@fa "دریافت"
pub func get(i: int): Keypoint:
if this.handle == null or i < 0 or i >= this.count(): ret Keypoint {} end
buf := mem.Allocate(40 as u64)
defer mem.Free(buf)
p := buf as f64*
scv_keypoint_get(this.handle, i, p)
ret Keypoint { x = p[0], y = p[1], size = p[2], angle = p[3], response = p[4] }
end
@en "descriptors"
@fa "توصیف‌گرها"
pub func descriptors(): Mat:
if this.handle == null: ret Mat { handle = null } end
ret Mat { handle = scv_orb_descriptors(this.handle) }
end
@en "free"
@fa "آزادسازی"
pub func free():
if this.handle != null: scv_free_keypoints(this.handle) end
this.handle = null
end
end
@en "Match"
@fa "تطابق"
pub struct Match:
pub query_idx: int = 0
pub train_idx: int = 0
pub distance: f64 = 0.0
end
@en "MatchDescriptors"
@fa "تطبیق توصیف‌گرها"
pub func MatchDescriptors(desc1: Mat, desc2: Mat, max_matches: int, norm: int): Vector<Match>:
mut out := Vector {} as Vector<Match>
if desc1.handle == null or desc2.handle == null or max_matches <= 0: ret out end
handle := scv_bf_match(desc1.handle, desc2.handle, max_matches, norm)
if handle == null: ret out end
defer scv_free_matches(handle)
n := scv_match_count(handle)
qbuf := mem.Allocate(4 as u64)
tbuf := mem.Allocate(4 as u64)
dbuf := mem.Allocate(8 as u64)
defer mem.Free(qbuf)
defer mem.Free(tbuf)
defer mem.Free(dbuf)
qp := qbuf as i32*
tp := tbuf as i32*
dp := dbuf as f64*
mut i := 0
until i < n:
scv_match_get(handle, i, qp, tp, dp)
out.push(Match { query_idx = qp[0], train_idx = tp[0], distance = dp[0] })
i += 1
end
ret out
end
