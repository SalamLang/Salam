func _gg_edge(pr: f32*, rc: int, px: f32*, xc: int, py: f32*, yc: int, i0: int, i1: int, j0: int, j1: int, kn: int):
mut i := i0
until i < i1:
xrow := _p32(px, i * xc)
crow := _p32(pr, i * rc)
mut j := j0
until j < j1:
mut acc := 0.0 as f32
repeat kn in k: acc += xrow[k] * py[k * yc + j] end
crow[j] = crow[j] + acc
j += 1
end
i += 1
end
end
func _gemm_acc(px: f32*, py: f32*, pr: f32*, n: int, kn: int, m: int):
if n <= 0 or m <= 0 or kn <= 0: ret end
nfull := (n / _MR) * _MR
mfull := (m / _NR) * _NR
if nfull == 0 or mfull == 0:
_gg_edge(pr, m, px, kn, py, m, nfull, n, 0, mfull, kn)
_gg_edge(pr, m, px, kn, py, m, 0, n, mfull, m, kn)
ret
end
kcap := _gmin(_KC, kn)
bpack := mem.Allocate(((_gmin(_NC, mfull) * kcap) as u64) * (sizeof(f32) as u64)) as f32*
defer mem.Free(bpack as void*)
apack := mem.Allocate(((_gmin((_MC / _MR) * _MR, nfull) * kcap) as u64) * (sizeof(f32) as u64)) as f32*
defer mem.Free(apack as void*)
mut j0 := 0
until j0 < mfull:
nc := _gmin(_NC, mfull - j0)
ncblk := nc / _NR
mut p0 := 0
until p0 < kn:
kc := _gmin(_KC, kn - p0)
repeat ncblk in jb:
_gg_pack_b(py, m, p0, p0 + kc, j0 + jb * _NR, _p32(bpack, jb * kc * _NR))
end
mut i0 := 0
until i0 < nfull:
mcap := (_MC / _MR) * _MR
ic := _gmin(mcap, nfull - i0)
mut ip := 0
until ip < ic:
_gg_pack_a(px, kn, i0 + ip, p0, kc, _p32(apack, ip * kc))
ip += _MR
end
repeat ncblk in jb:
j := j0 + jb * _NR
bp := _p32(bpack, jb * kc * _NR)
mut ii := 0
until ii < ic:
i := i0 + ii
_gg_micro(
_p32(apack, ii * kc), bp, kc as i64, _p32(pr, i * m + j), _p32(pr, (i + 1) * m + j), _p32(pr, (i + 2) * m + j),
_p32(pr, (i + 3) * m + j)
)
ii += _MR
end
end
i0 += _MC
end
p0 += _KC
end
j0 += _NC
end
_gg_edge(pr, m, px, kn, py, m, nfull, n, 0, mfull, kn)
_gg_edge(pr, m, px, kn, py, m, 0, n, mfull, m, kn)
end
func _transpose2d_into(px: f32*, n: int, m: int, pr: f32*):
mut i0 := 0
until i0 < n:
i1 := _gmin(i0 + _T_BLOCK, n)
mut j0 := 0
until j0 < m:
j1 := _gmin(j0 + _T_BLOCK, m)
mut i := i0
until i < i1:
xo := i * m
mut j := j0
until j < j1:
pr[j * n + i] = px[xo + j]
j += 1
end
i += 1
end
j0 += _T_BLOCK
end
i0 += _T_BLOCK
end
end
func _is_mat(x &: Tensor): bool: ret x.rank() == 2 and x.is_empty() == false end
@en "Transpose2D"
@fa "ترانهاده دوبعدی"
pub func Transpose2D(x &: Tensor): Tensor:
if _is_mat(x) == false: ret Empty() end
n := x.shape.get(0)
m := x.shape.get(1)
t := Zeros2(m, n)
_transpose2d_into(x.data.data, n, m, t.data.data)
ret t
end
@en "MatMul"
@fa "ضرب ماتریسی"
pub func MatMul(x &: Tensor, y &: Tensor): Tensor:
if _is_mat(x) == false or _is_mat(y) == false: ret Empty() end
if x.shape.get(1) != y.shape.get(0): ret Empty() end
n := x.shape.get(0)
kn := x.shape.get(1)
m := y.shape.get(1)
t := Zeros2(n, m)
_par_gemm(x.data.data, y.data.data, t.data.data, n, kn, m)
ret t
end
@en "MatMulInto"
@fa "ضرب ماتریسی در"
pub func MatMulInto(x &: Tensor, y &: Tensor, out &: Tensor): bool:
if _is_mat(x) == false or _is_mat(y) == false or out.rank() != 2: ret false end
if x.shape.get(1) != y.shape.get(0): ret false end
n := x.shape.get(0)
m := y.shape.get(1)
if out.shape.get(0) != n or out.shape.get(1) != m: ret false end
pz := out.data.data
zero := 0.0 as f32
repeat n * m in i: pz[i] = zero end
_par_gemm(x.data.data, y.data.data, pz, n, x.shape.get(1), m)
ret true
end
@en "MatMulAcc"
@fa "ضرب ماتریسی انباشته"
pub func MatMulAcc(x &: Tensor, y &: Tensor, out &: Tensor): bool:
if _is_mat(x) == false or _is_mat(y) == false or out.rank() != 2: ret false end
if x.shape.get(1) != y.shape.get(0): ret false end
n := x.shape.get(0)
m := y.shape.get(1)
if out.shape.get(0) != n or out.shape.get(1) != m: ret false end
_par_gemm(x.data.data, y.data.data, out.data.data, n, x.shape.get(1), m)
ret true
end
@en "TransposeMul"
@fa "ضرب ترانهاده"
pub func TransposeMul(x &: Tensor, y &: Tensor): Tensor:
if _is_mat(x) == false or _is_mat(y) == false: ret Empty() end
if x.shape.get(0) != y.shape.get(0): ret Empty() end
mut t := Transpose2D(x)
r := MatMul(t, y)
defer t.free()
ret r
end
@en "MulTranspose"
@fa "ضرب در ترانهاده"
pub func MulTranspose(x &: Tensor, y &: Tensor): Tensor:
if _is_mat(x) == false or _is_mat(y) == false: ret Empty() end
if x.shape.get(1) != y.shape.get(1): ret Empty() end
mut t := Transpose2D(y)
r := MatMul(x, t)
defer t.free()
ret r
end
@en "BatchMatMul"
@fa "ضرب ماتریسی دسته‌ای"
pub func BatchMatMul(x &: Tensor, y &: Tensor): Tensor:
if x.rank() != 3 or y.rank() != 3: ret Empty() end
if x.shape.get(0) != y.shape.get(0): ret Empty() end
if x.shape.get(2) != y.shape.get(1): ret Empty() end
b := x.shape.get(0)
n := x.shape.get(1)
kn := x.shape.get(2)
m := y.shape.get(2)
t := Zeros3(b, n, m)
_par_batch_gemm(x.data.data, y.data.data, t.data.data, b, n, kn, m)
ret t
end
@en "MatVec"
@fa "ضرب در بردار"
pub func MatVec(a &: Tensor, x &: Tensor): Tensor:
if _is_mat(a) == false or x.rank() != 1: ret Empty() end
if a.shape.get(1) != x.shape.get(0): ret Empty() end
n := a.shape.get(0)
kn := a.shape.get(1)
t := Zeros1(n)
pa := a.data.data
pv := x.data.data
pr := t.data.data
repeat n in i:
row := _p32(pa, i * kn)
mut s := 0.0 as f32
repeat kn in k: s += row[k] * pv[k] end
pr[i] = s
end
ret t
end
@en "TransposeRaw"
@fa "ترانهاده خام"
pub func TransposeRaw(px: f32*, n: int, m: int): Tensor:
t := Zeros2(m, n)
_transpose2d_into(px, n, m, t.data.data)
ret t
end
@en "GemmAcc"
@fa "ضرب انباشته خام"
pub func GemmAcc(px: f32*, py: f32*, pr: f32*, n: int, k: int, m: int):
_gemm_acc(px, py, pr, n, k, m)
end
@en "Dot"
@fa "ضرب داخلی"
pub func Dot(x &: Tensor, y &: Tensor): f64:
if x.rank() != 1 or y.rank() != 1: ret 0.0 end
n := x.shape.get(0)
if n != y.shape.get(0): ret 0.0 end
p := x.data.data
q := y.data.data
mut s := 0.0
repeat n in k: s += (p[k] as f64) * (q[k] as f64) end
ret s
end
package tensor
func _bstrides(x &: Tensor, rank: int, out &: Vector<int>):
out.clear()
xr := x.rank()
mut own := Vector {} as Vector<int>
repeat xr: own.push(0) end
mut s := 1
mut i := xr - 1
until i >= 0:
own.set(i, s)
s = s * x.shape.get(i)
i -= 1
end
repeat rank in d:
xi := d - (rank - xr)
if xi < 0 or x.shape.get(xi) == 1:
out.push(0)
else:
out.push(own.get(xi))
end
end
own.free()
end
func _can_expand(x &: Tensor, shape &: Vector<int>): bool:
r := shape.len()
xr := x.rank()
if xr > r: ret false end
repeat xr in i:
d := x.shape.get(i)
if d != 1 and d != shape.get(i + r - xr): ret false end
end
ret true
end
func _cmp(a &: Tensor, b &: Tensor, op: int): Tensor:
mut shape := Vector {} as Vector<int>
if not BroadcastShape(a, b, shape):
shape.free()
ret Empty()
end
mut ea := Expand(a, shape)
mut eb := Expand(b, shape)
out := Zeros(shape)
shape.free()
n := out.numel()
pa := ea.data.data
pb := eb.data.data
po := out.data.data
one := 1.0 as f32
if op == 0:
repeat n in k: if pa[k] > pb[k]: po[k] = one end end
else op == 1:
repeat n in k: if pa[k] >= pb[k]: po[k] = one end end
else op == 2:
repeat n in k: if pa[k] < pb[k]: po[k] = one end end
else op == 3:
repeat n in k: if pa[k] <= pb[k]: po[k] = one end end
else op == 4:
repeat n in k: if pa[k] == pb[k]: po[k] = one end end
else:
repeat n in k: if pa[k] != pb[k]: po[k] = one end end
end
ea.free()
eb.free()
ret out
end
func _cmp_scalar(x &: Tensor, s: f64, op: int): Tensor:
mut t := Scalar(s)
out := _cmp(x, t, op)
t.free()
ret out
end
func _split_axis(x &: Tensor, axis: int, outer &: int, inner &: int):
outer = 1
inner = 1
repeat x.rank() in i:
if i < axis: outer = outer * x.shape.get(i)
else i > axis: inner = inner * x.shape.get(i) end
end
end
func _tri(x &: Tensor, diagonal: int, lower: bool): Tensor:
if x.rank() < 2: ret Empty() end
cols := x.shape.get(x.rank() - 1)
rows := x.shape.get(x.rank() - 2)
planes := x.numel() / (rows * cols)
out := Clone(x)
po := out.data.data
zero := 0.0 as f32
repeat planes in p:
base := p * rows * cols
repeat rows in i:
repeat cols in j:
keep := lower ? j <= i + diagonal : j >= i + diagonal
if not keep: po[base + i * cols + j] = zero end
end
end
end
ret out
end
@en "BroadcastShape"
@fa "شکل پخش"
pub func BroadcastShape(a &: Tensor, b &: Tensor, out &: Vector<int>): bool:
out.clear()
ra := a.rank()
rb := b.rank()
r := ra > rb ? ra : rb
repeat r in i:
ia := i - (r - ra)
ib := i - (r - rb)
da := ia < 0 ? 1 : a.shape.get(ia)
db := ib < 0 ? 1 : b.shape.get(ib)
if da != db and da != 1 and db != 1:
out.clear()
ret false
end
out.push(da == 1 ? db : da)
end
ret true
end
@en "Expand"
@fa "گسترش"
pub func Expand(x &: Tensor, shape &: Vector<int>): Tensor:
if x.is_empty() or not _can_expand(x, shape): ret Empty() end
r := shape.len()
mut st := Vector {} as Vector<int>
_bstrides(x, r, st)
out := Zeros(shape)
n := out.numel()
px := x.data.data
po := out.data.data
mut idx := Vector {} as Vector<int>
repeat r: idx.push(0) end
mut off := 0
repeat n in k:
po[k] = px[off]
mut d := r - 1
mut carry := true
until carry and d >= 0:
idx.set(d, idx.get(d) + 1)
off += st.get(d)
if idx.get(d) < shape.get(d):
carry = false
else:
off -= st.get(d) * shape.get(d)
idx.set(d, 0)
d -= 1
end
end
end
idx.free()
st.free()
ret out
end
@en "Greater"
@fa "بزرگتر"
pub func Greater(a &: Tensor, b &: Tensor): Tensor: ret _cmp(a, b, 0) end
@en "GreaterEqual"
@fa "بزرگتر مساوی"
pub func GreaterEqual(a &: Tensor, b &: Tensor): Tensor: ret _cmp(a, b, 1) end
@en "Less"
@fa "کوچکتر"
pub func Less(a &: Tensor, b &: Tensor): Tensor: ret _cmp(a, b, 2) end
@en "LessEqual"
@fa "کوچکتر مساوی"
pub func LessEqual(a &: Tensor, b &: Tensor): Tensor: ret _cmp(a, b, 3) end
@en "EqualMask"
@fa "ماسک برابری"
pub func EqualMask(a &: Tensor, b &: Tensor): Tensor: ret _cmp(a, b, 4) end
@en "NotEqualMask"
@fa "ماسک نابرابری"
pub func NotEqualMask(a &: Tensor, b &: Tensor): Tensor: ret _cmp(a, b, 5) end
@en "GreaterScalar"
@fa "بزرگتر از عدد"
pub func GreaterScalar(x &: Tensor, s: f64): Tensor: ret _cmp_scalar(x, s, 0) end
@en "LessScalar"
@fa "کوچکتر از عدد"
pub func LessScalar(x &: Tensor, s: f64): Tensor: ret _cmp_scalar(x, s, 2) end
@en "EqualScalar"
@fa "یکسان با عدد"
pub func EqualScalar(x &: Tensor, s: f64): Tensor: ret _cmp_scalar(x, s, 4) end
@en "Where"
@fa "کجا"
pub func Where(cond &: Tensor, a &: Tensor, b &: Tensor): Tensor:
mut s1 := Vector {} as Vector<int>
if not BroadcastShape(cond, a, s1):
s1.free()
ret Empty()
end
mut tmp := Zeros(s1)
mut shape := Vector {} as Vector<int>
ok := BroadcastShape(tmp, b, shape)
tmp.free()
s1.free()
if not ok:
shape.free()
ret Empty()
end
mut ec := Expand(cond, shape)
mut ea := Expand(a, shape)
mut eb := Expand(b, shape)
out := Zeros(shape)
shape.free()
n := out.numel()
pc := ec.data.data
pa := ea.data.data
pb := eb.data.data
po := out.data.data
zero := 0.0 as f32
repeat n in k: po[k] = pc[k] != zero ? pa[k] : pb[k] end
ec.free()
ea.free()
eb.free()
ret out
end
@en "MaskedFill"
@fa "پرکردن ماسک‌شده"
pub func MaskedFill(x &: Tensor, mask &: Tensor, value: f64): Tensor:
mut em := Expand(mask, x.shape)
if em.is_empty(): ret Empty() end
out := Clone(x)
n := out.numel()
pm := em.data.data
po := out.data.data
v := value as f32
zero := 0.0 as f32
repeat n in k: if pm[k] != zero: po[k] = v end end
em.free()
ret out
end
@en "IndexSelect"
@fa "انتخاب نمایه"
pub func IndexSelect(x &: Tensor, axis: int, ids &: Vector<int>): Tensor:
if x.is_empty() or axis < 0 or axis >= x.rank(): ret Empty() end
len := x.shape.get(axis)
repeat ids.len() in i:
if ids.get(i) < 0 or ids.get(i) >= len: ret Empty() end
end
mut outer := 1
mut inner := 1
_split_axis(x, axis, outer, inner)
mut shape := Vector {} as Vector<int>
repeat x.rank() in i: shape.push(i == axis ? ids.len() : x.shape.get(i)) end
out := Zeros(shape)
shape.free()
m := ids.len()
px := x.data.data
po := out.data.data
repeat outer in o:
repeat m in t:
src := (o * len + ids.get(t)) * inner
dst := (o * m + t) * inner
repeat inner in k: po[dst + k] = px[src + k] end
end
end
ret out
end
@en "TakeRows"
@fa "گرفتن ردیف‌ها"
pub func TakeRows(x &: Tensor, ids &: Vector<int>): Tensor: ret IndexSelect(x, 0, ids) end
@en "Gather"
@fa "گردآوری"
pub func Gather(x &: Tensor, axis: int, idx &: Tensor): Tensor:
if x.is_empty() or idx.is_empty() or axis < 0 or axis >= x.rank() or idx.rank() != x.rank(): ret Empty() end
repeat x.rank() in i:
if i != axis and idx.shape.get(i) != x.shape.get(i): ret Empty() end
end
mut outer := 1
mut inner := 1
_split_axis(x, axis, outer, inner)
lx := x.shape.get(axis)
li := idx.shape.get(axis)
out := Zeros(idx.shape)
px := x.data.data
pi := idx.data.data
po := out.data.data
repeat outer in o:
repeat li in j:
repeat inner in k:
at := (o * li + j) * inner + k
mut id := pi[at] as int
if id < 0: id = 0 end
if id >= lx: id = lx - 1 end
po[at] = px[(o * lx + id) * inner + k]
end
end
end
ret out
end
@en "ScatterAddRows"
@fa "پراکندن جمعی ردیف‌ها"
pub func ScatterAddRows(dst &: Tensor, ids &: Vector<int>, src &: Tensor): bool:
if dst.rank() != 2 or src.rank() != 2 or src.dim(1) != dst.dim(1) or src.dim(0) != ids.len(): ret false end
w := dst.dim(1)
rows := dst.dim(0)
pd := dst.data.data
ps := src.data.data
repeat ids.len() in i:
r := ids.get(i)
if r < 0 or r >= rows: continue end
repeat w in k: pd[r * w + k] += ps[i * w + k] end
end
ret true
end
@en "OneHot"
@fa "یک‌داغ"
pub func OneHot(ids &: Vector<int>, classes: int): Tensor:
n := ids.len()
out := Zeros2(n, classes)
po := out.data.data
one := 1.0 as f32
repeat n in i:
c := ids.get(i)
if c >= 0 and c < classes: po[i * classes + c] = one end
end
ret out
end
@en "TopK"
@fa "کِی برتر"
pub func TopK(x &: Tensor, k: int, largest: bool, idx_out &: Tensor): Tensor:
if x.is_empty() or k < 1: ret Empty() end
width := x.shape.get(x.rank() - 1)
if k > width: ret Empty() end
rows := x.numel() / width
mut shape := Vector {} as Vector<int>
repeat x.rank() in i: shape.push(i == x.rank() - 1 ? k : x.shape.get(i)) end
out := Zeros(shape)
idx_out.free()
idx_out = Zeros(shape)
shape.free()
px := x.data.data
po := out.data.data
pi := idx_out.data.data
repeat rows in r:
base := r * width
obase := r * k
mut taken := Vector {} as Vector<bool>
repeat width: taken.push(false) end
repeat k in t:
mut best := 0 - 1
repeat width in c:
if taken.get(c): continue end
if best < 0: best = c
else largest and px[base + c] > px[base + best]: best = c
else not largest and px[base + c] < px[base + best]: best = c end
end
taken.set(best, true)
po[obase + t] = px[base + best]
pi[obase + t] = best as f32
end
taken.free()
end
ret out
end
@en "Tril"
@fa "مثلث پایین"
pub func Tril(x &: Tensor, diagonal: int): Tensor: ret _tri(x, diagonal, true) end
@en "Triu"
@fa "مثلث بالا"
pub func Triu(x &: Tensor, diagonal: int): Tensor: ret _tri(x, diagonal, false) end
@en "Cumsum"
@fa "جمع تجمعی"
pub func Cumsum(x &: Tensor, axis: int): Tensor:
if x.is_empty() or axis < 0 or axis >= x.rank(): ret Empty() end
mut outer := 1
mut inner := 1
_split_axis(x, axis, outer, inner)
len := x.shape.get(axis)
out := Clone(x)
po := out.data.data
repeat outer in o:
repeat inner in i:
mut acc := 0.0 as f32
repeat len in t:
at := (o * len + t) * inner + i
acc += po[at]
po[at] = acc
end
end
end
ret out
end
package tensor
import compress
import encoding.binary
import mem
import str
const _TSR_DTYPE_F32 := 1
@en "WriteTensor"
@fa "نوشتن تانسور"
pub func WriteTensor(buf &: compress.ByteBuf, name: str, t &: Tensor): bool:
nl := str.Len(name)
if nl <= 0 or nl > 65535: ret false end
if t.is_empty(): ret false end
r := t.rank()
if r > 255: ret false end
binary.WriteU16LE(buf, nl)
compress.BufPushBytes(buf, name as void*, nl)
binary.WriteU8(buf, _TSR_DTYPE_F32)
binary.WriteU8(buf, r)
repeat r in i: binary.WriteU32LE(buf, t.shape.get(i)) end
n := t.numel()
binary.WriteU64LE(buf, (n as i64) * 4)
compress.BufPushBytes(buf, t.data.data as void*, n * 4)
ret true
end
@en "ReadTensor"
@fa "خواندن تانسور"
pub func ReadTensor(rd &: compress.ByteReader, name_out &: str, out &: Tensor): bool:
nl := binary.ReadU16LE(rd)
if rd.bad or nl <= 0: ret false end
if compress.RdLeft(rd) < nl: ret false end
mut nb := compress.RdBytes(rd, nl)
name_out = compress.BufToStrUnsafe(nb)
compress.BufFree(nb)
dtype := binary.ReadU8(rd)
r := binary.ReadU8(rd)
if rd.bad or dtype != _TSR_DTYPE_F32 or r <= 0 or r > 255: ret false end
mut shape := Vector {} as Vector<int>
mut n := 1
repeat r:
d := binary.ReadU32LE(rd)
shape.push(d)
n = n * d
end
nbytes := binary.ReadU64LE(rd)
if rd.bad or nbytes != (n as i64) * 4 or compress.RdLeft(rd) < n * 4:
shape.free()
ret false
end
out.free()
t := _raw(shape)
shape.free()
src := ((rd.data as i64) + (rd.pos as i64)) as void*
mem.Copy(t.data.data as void*, src, (n * 4) as u64)
rd.pos += n * 4
out = t
ret true
end
package tensor
import pool
const _EW_CHUNK := 65536
const _EW_MIN := 262144
const _GM_MIN_FLOPS := 32000000.0
mut _tsr_threads := 0
mut _ew_pa := null as f32*
mut _ew_pb := null as f32*
mut _ew_pr := null as f32*
mut _ew_n := 0
mut _ew_op := 0
mut _gm_px := null as f32*
mut _gm_py := null as f32*
mut _gm_pr := null as f32*
mut _gm_n := 0
mut _gm_k := 0
mut _gm_m := 0
mut _gm_band := 0
mut _bm_px := null as f32*
mut _bm_py := null as f32*
mut _bm_pr := null as f32*
mut _bm_n := 0
mut _bm_k := 0
mut _bm_m := 0
func _ew_zip_worker(t: i64):
off := (t as int) * _EW_CHUNK
mut cnt := _ew_n - off
if cnt > _EW_CHUNK: cnt = _EW_CHUNK end
_k_same(_p32(_ew_pa, off), _p32(_ew_pb, off), _p32(_ew_pr, off), cnt, _ew_op)
end
func _ew_map_worker(t: i64):
off := (t as int) * _EW_CHUNK
mut cnt := _ew_n - off
if cnt > _EW_CHUNK: cnt = _EW_CHUNK end
_u_range(_p32(_ew_pa, off), _p32(_ew_pr, off), cnt, _ew_op)
end
func _gm_worker(t: i64):
start := (t as int) * _gm_band
mut rows := _gm_n - start
if rows > _gm_band: rows = _gm_band end
if rows <= 0: ret end
_gemm_acc(_p32(_gm_px, start * _gm_k), _gm_py, _p32(_gm_pr, start * _gm_m), rows, _gm_k, _gm_m)
end
func _bm_worker(t: i64):
i := t as int
_gemm_acc(
_p32(_bm_px, i * _bm_n * _bm_k), _p32(_bm_py, i * _bm_k * _bm_m), _p32(_bm_pr, i * _bm_n * _bm_m),
_bm_n, _bm_k, _bm_m
)
end
func _par_zip(pa: f32*, pb: f32*, pr: f32*, n: int, op: int):
if n < _EW_MIN or Threads() <= 1:
_k_same(pa, pb, pr, n, op)
ret
end
_ew_pa = pa
_ew_pb = pb
_ew_pr = pr
_ew_n = n
_ew_op = op
chunks := (n + _EW_CHUNK - 1) / _EW_CHUNK
pool.ParallelFor(chunks as i64, Threads() as i64, (i: i64): _ew_zip_worker(i) end)
end
func _par_map(pa: f32*, pr: f32*, n: int, op: int):
if n < _EW_MIN or Threads() <= 1:
_u_range(pa, pr, n, op)
ret
end
_ew_pa = pa
_ew_pr = pr
_ew_n = n
_ew_op = op
chunks := (n + _EW_CHUNK - 1) / _EW_CHUNK
pool.ParallelFor(chunks as i64, Threads() as i64, (i: i64): _ew_map_worker(i) end)
end
func _par_gemm(px: f32*, py: f32*, pr: f32*, n: int, kn: int, m: int):
t := Threads()
flops := 2.0 * (n as f64) * (kn as f64) * (m as f64)
if t <= 1 or flops < _GM_MIN_FLOPS or n < 2 * _MR:
_gemm_acc(px, py, pr, n, kn, m)
ret
end
mut band := (n + t - 1) / t
band = ((band + _MR - 1) / _MR) * _MR
bands := (n + band - 1) / band
_gm_px = px
_gm_py = py
_gm_pr = pr
_gm_n = n
_gm_k = kn
_gm_m = m
_gm_band = band
pool.ParallelFor(bands as i64, t as i64, (i: i64): _gm_worker(i) end)
end
func _par_batch_gemm(px: f32*, py: f32*, pr: f32*, b: int, n: int, kn: int, m: int):
t := Threads()
if t <= 1 or b < 2:
repeat b in i:
_par_gemm(_p32(px, i * n * kn), _p32(py, i * kn * m), _p32(pr, i * n * m), n, kn, m)
end
ret
end
if b < t:
repeat b in i:
_par_gemm(_p32(px, i * n * kn), _p32(py, i * kn * m), _p32(pr, i * n * m), n, kn, m)
end
ret
end
_bm_px = px
_bm_py = py
_bm_pr = pr
_bm_n = n
_bm_k = kn
_bm_m = m
pool.ParallelFor(b as i64, t as i64, (i: i64): _bm_worker(i) end)
end
@en "SetThreads"
@fa "تنظیم نخ‌ها"
pub func SetThreads(n: int): _tsr_threads = n end
@en "Threads"
@fa "نخ‌ها"
pub func Threads(): int:
if _tsr_threads > 0: ret _tsr_threads end
c := pool.CPUCount() as int
if c > 8: ret 8 end
ret c
end
package tensor
import math
const _RNG_MULT := 2685821657736338717 as u64
const _RNG_ODD := 1442695040888963407 as u64
@en "Rng"
@fa "مولد تصادفی"
pub struct Rng:
pub s: u64 = 0
@en "next_bits"
@fa "بیت بعدی"
pub func next_bits(): u64:
mut x := this.s
x = x ^ (x >> 12)
x = x ^ (x << 25)
x = x ^ (x >> 27)
this.s = x
ret x * _RNG_MULT
end
@en "next_float"
@fa "اعشاری بعدی"
pub func next_float(): f64:
v := this.next_bits() >> 11
ret (v as f64) / 9007199254740992.0
end
@en "next_normal"
@fa "نرمال بعدی"
pub func next_normal(): f64:
mut u := this.next_float()
if u <= 0.0: u = 1.0e-15 end
v := this.next_float()
ret math.Sqrt(0.0 - 2.0 * math.Log(u)) * math.Cos(6.283185307179586 * v)
end
end
@en "NewRng"
@fa "مولد تصادفی جدید"
pub func NewRng(seed: i64): Rng:
mut g := Rng {}
g.s = (seed as u64) + _RNG_ODD
if g.s == 0: g.s = _RNG_ODD end
ret g
end
@en "DeriveSeed"
@fa "بذر مشتق"
pub func DeriveSeed(seed: i64, index: i64): i64:
ret seed + (0 - 7046029254386353131) * (index + 1)
end
@en "FillUniform"
@fa "پر کردن یکنواخت"
pub func FillUniform(t &: Tensor, lo: f64, hi: f64, g &: Rng):
n := t.data.len()
p := t.data.data
repeat n in k: p[k] = (lo + (hi - lo) * g.next_float()) as f32 end
end
@en "FillNormal"
@fa "پر کردن نرمال"
pub func FillNormal(t &: Tensor, mean: f64, std: f64, g &: Rng):
n := t.data.len()
p := t.data.data
repeat n in k: p[k] = (mean + std * g.next_normal()) as f32 end
end
@en "FillBernoulli"
@fa "پر کردن برنولی"
pub func FillBernoulli(t &: Tensor, p: f64, g &: Rng):
n := t.data.len()
d := t.data.data
one := 1.0 as f32
zero := 0.0 as f32
repeat n in k:
mut v := zero
if g.next_float() < p: v = one end
d[k] = v
end
end
@en "RandUniform"
@fa "تصادفی یکنواخت"
pub func RandUniform(shape &: Vector<int>, lo: f64, hi: f64, seed: i64): Tensor:
t := _raw(shape)
mut g := NewRng(seed)
FillUniform(t, lo, hi, g)
ret t
end
@en "RandNormal"
@fa "تصادفی نرمال"
pub func RandNormal(shape &: Vector<int>, seed: i64): Tensor:
t := _raw(shape)
mut g := NewRng(seed)
FillNormal(t, 0.0, 1.0, g)
ret t
end
package tensor
func _reduced_shape(x &: Tensor, axis: int, keepdim: bool): Vector<int>:
mut s := Vector {} as Vector<int>
repeat x.rank() in i:
if i == axis:
if keepdim: s.push(1) end
else:
s.push(x.shape.get(i))
end
end
if s.len() == 0: s.push(1) end
ret s
end
func _axis_ok(x &: Tensor, axis: int): bool:
if x.is_empty(): ret false end
ret axis >= 0 and axis < x.rank()
end
@en "SumAll"
@fa "مجموع همه"
pub func SumAll(x &: Tensor): f64:
n := x.data.len()
p := x.data.data
mut s := 0.0
repeat n in k: s += p[k] as f64 end
ret s
end
@en "MeanAll"
@fa "میانگین همه"
pub func MeanAll(x &: Tensor): f64:
n := x.data.len()
if n <= 0: ret 0.0 end
ret SumAll(x) / (n as f64)
end
@en "MaxAll"
@fa "بیشینه همه"
pub func MaxAll(x &: Tensor): f64:
n := x.data.len()
if n <= 0: ret 0.0 end
p := x.data.data
mut best := p[0]
repeat n in k:
v := p[k]
if v > best: best = v end
end
ret best as f64
end
@en "MinAll"
@fa "کمینه همه"
pub func MinAll(x &: Tensor): f64:
n := x.data.len()
if n <= 0: ret 0.0 end
p := x.data.data
mut best := p[0]
repeat n in k:
v := p[k]
if v < best: best = v end
end
ret best as f64
end
@en "ArgMaxAll"
@fa "نمایه بیشینه همه"
pub func ArgMaxAll(x &: Tensor): int:
n := x.data.len()
if n <= 0: ret 0 - 1 end
p := x.data.data
mut best := p[0]
mut at_idx := 0
repeat n in k:
v := p[k]
if v > best:
best = v
at_idx = k
end
end
ret at_idx
end
@en "SumAxis"
@fa "مجموع محور"
pub func SumAxis(x &: Tensor, axis: int, keepdim: bool): Tensor:
if _axis_ok(x, axis) == false: ret Empty() end
n := x.shape.get(axis)
outer := _outer_of(x, axis)
inner := _inner_of(x, axis)
mut oshape := _reduced_shape(x, axis, keepdim)
t := Zeros(oshape)
oshape.free()
p := t.data.data
q := x.data.data
repeat outer in o:
dbase := o * inner
repeat n in i:
sbase := (o * n + i) * inner
repeat inner in k: p[dbase + k] = p[dbase + k] + q[sbase + k] end
end
end
ret t
end
@en "MeanAxis"
@fa "میانگین محور"
pub func MeanAxis(x &: Tensor, axis: int, keepdim: bool): Tensor:
mut t := SumAxis(x, axis, keepdim)
if t.is_empty(): ret t end
ScaleInPlace(t, 1.0 / (x.shape.get(axis) as f64))
ret t
end
@en "MaxAxis"
@fa "بیشینه محور"
pub func MaxAxis(x &: Tensor, axis: int, keepdim: bool): Tensor:
if _axis_ok(x, axis) == false: ret Empty() end
n := x.shape.get(axis)
outer := _outer_of(x, axis)
inner := _inner_of(x, axis)
mut oshape := _reduced_shape(x, axis, keepdim)
t := _raw(oshape)
oshape.free()
p := t.data.data
q := x.data.data
repeat outer in o:
dbase := o * inner
sbase0 := o * n * inner
repeat inner in k: p[dbase + k] = q[sbase0 + k] end
repeat n - 1 in i:
sbase := (o * n + i + 1) * inner
repeat inner in k:
v := q[sbase + k]
if v > p[dbase + k]: p[dbase + k] = v end
end
end
end
ret t
end
@en "ArgMaxAxis"
@fa "نمایه بیشینه محور"
pub func ArgMaxAxis(x &: Tensor, axis: int, keepdim: bool): Tensor:
if _axis_ok(x, axis) == false: ret Empty() end
n := x.shape.get(axis)
outer := _outer_of(x, axis)
inner := _inner_of(x, axis)
mut oshape := _reduced_shape(x, axis, keepdim)
t := Zeros(oshape)
oshape.free()
p := t.data.data
q := x.data.data
repeat outer in o:
dbase := o * inner
repeat inner in k:
mut best := q[o * n * inner + k]
mut bi := 0
repeat n - 1 in i:
v := q[(o * n + i + 1) * inner + k]
if v > best:
best = v
bi = i + 1
end
end
p[dbase + k] = bi as f32
end
end
ret t
end
@en "Softmax"
@fa "بیشینه نرم"
pub func Softmax(x &: Tensor): Tensor:
if x.is_empty(): ret Empty() end
width := x.shape.get(x.rank() - 1)
rows := x.numel() / width
t := _raw_like(x)
p := t.data.data
q := x.data.data
one := 1.0 as f32
repeat rows in r:
base := r * width
mut m := q[base]
repeat width in k:
v := q[base + k]
if v > m: m = v end
end
mut s := 0.0 as f32
repeat width in k:
e := expf(q[base + k] - m)
p[base + k] = e
s += e
end
inv := one / s
repeat width in k: p[base + k] = p[base + k] * inv end
end
ret t
end
@en "LogSoftmax"
@fa "لگاریتم بیشینه نرم"
pub func LogSoftmax(x &: Tensor): Tensor:
if x.is_empty(): ret Empty() end
width := x.shape.get(x.rank() - 1)
rows := x.numel() / width
t := _raw_like(x)
p := t.data.data
q := x.data.data
repeat rows in r:
base := r * width
mut m := q[base]
repeat width in k:
v := q[base + k]
if v > m: m = v end
end
mut s := 0.0 as f32
repeat width in k: s += expf(q[base + k] - m) end
lse := m + logf(s)
repeat width in k: p[base + k] = q[base + k] - lse end
end
ret t
end
package tensor
func _outer_of(x &: Tensor, axis: int): int:
mut o := 1
repeat axis in i: o = o * x.shape.get(i) end
ret o
end
func _inner_of(x &: Tensor, axis: int): int:
mut v := 1
r := x.rank()
repeat r - axis - 1 in i: v = v * x.shape.get(axis + 1 + i) end
ret v
end
@en "Reshape"
@fa "تغییر شکل"
pub func Reshape(x &: Tensor, shape &: Vector<int>): Tensor:
mut n := 1
if shape.len() == 0: n = 0 end
repeat shape.len() in i: n = n * shape.get(i) end
if n != x.numel(): ret Empty() end
mut t := Clone(x)
t.reshape_(shape)
ret t
end
@en "SqueezeInPlace"
@fa "فشردن درجا"
pub func SqueezeInPlace(x &: Tensor):
mut s := Vector {} as Vector<int>
repeat x.rank() in i:
d := x.shape.get(i)
if d != 1: s.push(d) end
end
if s.len() == 0: s.push(1) end
x.shape.free()
x.shape = s
end
@en "UnsqueezeInPlace"
@fa "گشودن درجا"
pub func UnsqueezeInPlace(x &: Tensor, axis: int):
r := x.rank()
if axis < 0 or axis > r: ret end
x.shape.insert(axis, 1)
end
@en "Permute"
@fa "جایگشت"
pub func Permute(x &: Tensor, perm &: Vector<int>): Tensor:
r := x.rank()
if perm.len() != r or r == 0: ret Empty() end
mut in_range := true
repeat r in i:
p := perm.get(i)
if p < 0 or p >= r: in_range = false end
end
if in_range == false: ret Empty() end
mut seen := Vector {} as Vector<int>
seen.zeros(r)
repeat r in i: seen.set(perm.get(i), seen.get(perm.get(i)) + 1) end
mut valid := true
repeat r in i:
if seen.get(i) != 1: valid = false end
end
seen.free()
if valid == false: ret Empty() end
mut istr := Vector {} as Vector<int>
istr.zeros(r)
mut acc := 1
repeat r in i:
d := r - 1 - i
istr.set(d, acc)
acc = acc * x.shape.get(d)
end
mut ostr := Vector {} as Vector<int>
ostr.zeros(r)
mut oshape := Vector {} as Vector<int>
repeat r in i:
oshape.push(x.shape.get(perm.get(i)))
ostr.set(i, istr.get(perm.get(i)))
end
t := _raw(oshape)
n := t.data.len()
if n > 0:
p := t.data.data
q := x.data.data
mut idx := Vector {} as Vector<int>
idx.zeros(r)
mut src := 0
repeat n in k:
p[k] = q[src]
mut d := r - 1
mut carrying := true
until carrying:
v := idx.get(d) + 1
if v < oshape.get(d):
idx.set(d, v)
src += ostr.get(d)
carrying = false
else:
src -= idx.get(d) * ostr.get(d)
idx.set(d, 0)
if d == 0:
carrying = false
else:
d -= 1
end
end
end
end
idx.free()
end
istr.free()
ostr.free()
oshape.free()
ret t
end
@en "SliceAxis0"
@fa "برش محور صفر"
pub func SliceAxis0(x &: Tensor, start: int, len: int): Tensor:
r := x.rank()
if r == 0: ret Empty() end
d0 := x.shape.get(0)
if start < 0 or len <= 0 or start + len > d0: ret Empty() end
mut oshape := _copy_shape(x.shape)
oshape.set(0, len)
t := _raw(oshape)
oshape.free()
inner := x.numel() / d0
n := len * inner
p := t.data.data
q := x.data.data
base := start * inner
repeat n in k: p[k] = q[base + k] end
ret t
end
@en "Narrow"
@fa "باریک‌سازی"
pub func Narrow(x &: Tensor, axis: int, start: int, len: int): Tensor:
r := x.rank()
if axis < 0 or axis >= r: ret Empty() end
if axis == 0: ret SliceAxis0(x, start, len) end
mid := x.shape.get(axis)
if start < 0 or len <= 0 or start + len > mid: ret Empty() end
outer := _outer_of(x, axis)
inner := _inner_of(x, axis)
mut oshape := _copy_shape(x.shape)
oshape.set(axis, len)
t := _raw(oshape)
oshape.free()
p := t.data.data
q := x.data.data
block := len * inner
repeat outer in o:
sbase := (o * mid + start) * inner
dbase := o * block
repeat block in k: p[dbase + k] = q[sbase + k] end
end
ret t
end
@en "Concat2"
@fa "پیوند دو"
pub func Concat2(a &: Tensor, b &: Tensor, axis: int): Tensor:
r := a.rank()
if r == 0 or b.rank() != r or axis < 0 or axis >= r: ret Empty() end
repeat r in i:
if i != axis and a.shape.get(i) != b.shape.get(i): ret Empty() end
end
ma := a.shape.get(axis)
mb := b.shape.get(axis)
outer := _outer_of(a, axis)
inner := _inner_of(a, axis)
mut oshape := _copy_shape(a.shape)
oshape.set(axis, ma + mb)
t := _raw(oshape)
oshape.free()
p := t.data.data
qa := a.data.data
qb := b.data.data
blocka := ma * inner
blockb := mb * inner
ostride := blocka + blockb
repeat outer in o:
dbase := o * ostride
abase := o * blocka
repeat blocka in k: p[dbase + k] = qa[abase + k] end
bbase := o * blockb
repeat blockb in k: p[dbase + blocka + k] = qb[bbase + k] end
end
ret t
end
@en "Stack2"
@fa "انباشت دو"
pub func Stack2(a &: Tensor, b &: Tensor): Tensor:
if a.same_shape(b) == false or a.rank() == 0: ret Empty() end
mut oshape := Vector {} as Vector<int>
oshape.push(2)
repeat a.rank() in i: oshape.push(a.shape.get(i)) end
t := _raw(oshape)
oshape.free()
n := a.numel()
p := t.data.data
qa := a.data.data
qb := b.data.data
repeat n in k: p[k] = qa[k] end
repeat n in k: p[n + k] = qb[k] end
ret t
end
@en "Pad2D"
@fa "لایه‌گذاری دوبعدی"
pub func Pad2D(x &: Tensor, pt: int, pb: int, pl: int, pr: int): Tensor:
r := x.rank()
if r < 2 or pt < 0 or pb < 0 or pl < 0 or pr < 0: ret Empty() end
h := x.shape.get(r - 2)
w := x.shape.get(r - 1)
oh := h + pt + pb
ow := w + pl + pr
mut oshape := _copy_shape(x.shape)
oshape.set(r - 2, oh)
oshape.set(r - 1, ow)
t := Zeros(oshape)
oshape.free()
planes := x.numel() / (h * w)
p := t.data.data
q := x.data.data
repeat planes in c:
splane := c * h * w
dplane := c * oh * ow
repeat h in i:
sbase := splane + i * w
dbase := dplane + (i + pt) * ow + pl
repeat w in k: p[dbase + k] = q[sbase + k] end
end
end
ret t
end
@en "term"
@fa "پایانه"
package term
import str
import mem
extern:
func printf(fmt: str, ...): int
func fflush(stream: void*): int
func getenv(name: str): void*
func memset(ptr: void*, val: int, n: u64): void*
end
if SALAM_OS_WINDOWS:
extern:
func _isatty(fd: int): int
func GetStdHandle(which: int): void*
func GetConsoleMode(h: void*, mode: void*): int
func SetConsoleMode(h: void*, mode: int): int
func GetConsoleScreenBufferInfo(h: void*, info: void*): int
end
else:
extern:
func isatty(fd: int): int
func ioctl(fd: int, req: u64, ...): int
func tcgetattr(fd: int, t: void*): int
func tcsetattr(fd: int, act: int, t: void*): int
func cfmakeraw(t: void*)
end
end
@en "StdinFd"
@fa "شناسه ورودی"
pub const StdinFd := 0
@en "StdoutFd"
@fa "شناسه خروجی"
pub const StdoutFd := 1
@en "StderrFd"
@fa "شناسه خطا"
pub const StderrFd := 2
@en "Esc"
@fa "گریز"
pub const Esc := "\x1b"
@en "Csi"
@fa "آغازگر دنباله"
pub const Csi := "\x1b["
@en "ColorAuto"
@fa "رنگ خودکار"
pub const ColorAuto := 0
@en "ColorAlways"
@fa "رنگ همیشه"
pub const ColorAlways := 1
@en "ColorNever"
@fa "بدون رنگ"
pub const ColorNever := 2
const _TCSAFLUSH := 2
const _TERMIOS_CAP := 128
const _TIOCGWINSZ_LINUX := 0x5413
const _TIOCGWINSZ_BSD := 0x40087468
const _ECHO := 0x8
mut _color_mode := 0
mut _color_auto := 0
@en "TermState"
@fa "وضعیت پایانه"
pub struct TermState:
pub fd: int = 0
pub saved: void* = null
pub mode_in: int = 0
pub mode_out: int = 0
pub ok: bool = false
end
@en "WinSize"
@fa "اندازه پنجره"
pub struct WinSize:
pub cols: int = 80
pub rows: int = 24
end
func _env(name: str): str:
v := getenv(name)
if v == null: ret "" end
ret str.Clone(v as str)
end
func _lflag_off(): int:
if SALAM_OS_MAC: ret 24 else:
ret 12
end
end
func _vmin_off(): int:
if SALAM_OS_MAC: ret 48
else SALAM_OS_BSD: ret 32
else:
ret 23
end
end
func _vtime_off(): int:
if SALAM_OS_MAC: ret 49
else SALAM_OS_BSD: ret 33
else:
ret 22
end
end
func _icanon_bit(): int:
if SALAM_OS_MAC or SALAM_OS_BSD: ret 0x100 else:
ret 0x2
end
end
func _winsz_req(): u64:
if SALAM_OS_MAC or SALAM_OS_BSD: ret _TIOCGWINSZ_BSD
else:
ret _TIOCGWINSZ_LINUX
end
end
func _win_handle(_fd: int): void*:
if SALAM_OS_WINDOWS:
if _fd == StdinFd: ret GetStdHandle(0 - 10) end
if _fd == StderrFd: ret GetStdHandle(0 - 12) end
ret GetStdHandle(0 - 11)
else:
ret null
end
end
func _win_mode(_fd: int): int:
if SALAM_OS_WINDOWS:
h := _win_handle(_fd)
if h == null: ret 0 end
buf := mem.Allocate(8 as u64)
defer mem.Free(buf)
memset(buf, 0, 8 as u64)
if GetConsoleMode(h, buf) == 0: ret 0 end
p := buf as int*
ret p[0]
else:
ret 0
end
end
func _detect_color(): bool:
if getenv("NO_COLOR") != null: ret false end
force := _env("CLICOLOR_FORCE")
if force.len() > 0 and force != "0": ret true end
if _env("TERM") == "dumb": ret false end
ret IsTTY(StdoutFd)
end
func _set_mode(fd: int, full: bool): TermState:
mut st := TermState { fd = fd }
if SALAM_OS_WINDOWS:
h := _win_handle(fd)
if h == null: ret st end
st.mode_in = _win_mode(fd)
st.mode_out = _win_mode(StdoutFd)
mut m := st.mode_in & ~(0x2 | 0x4)
if full: m = m & ~0x1 end
m = m | 0x200
if SetConsoleMode(h, m) == 0: ret st end
_vt := EnableAnsi()
st.ok = true
ret st
else:
saved := mem.Allocate(_TERMIOS_CAP as u64)
memset(saved, 0, _TERMIOS_CAP as u64)
if tcgetattr(fd, saved) != 0:
mem.Free(saved)
ret st
end
work := mem.Allocate(_TERMIOS_CAP as u64)
defer mem.Free(work)
mem.Copy(work, saved, _TERMIOS_CAP as u64)
if full:
cfmakeraw(work)
else:
lf := ((work as i64) + _lflag_off()) as int*
lf[0] = lf[0] & ~(_ECHO | _icanon_bit())
end
vmin := ((work as i64) + _vmin_off()) as i8*
vtime := ((work as i64) + _vtime_off()) as i8*
vmin[0] = 1 as i8
vtime[0] = 0 as i8
if tcsetattr(fd, _TCSAFLUSH, work) != 0:
mem.Free(saved)
ret st
end
st.saved = saved
st.ok = true
ret st
end
end
@en "Write"
@fa "نوشتن"
pub func Write(s: str):
_n := printf("%s", s)
end
@en "WriteErr"
@fa "نوشتن خطا"
pub func WriteErr(s: str):
printerr s
end
@en "Flush"
@fa "تخلیه"
pub func Flush():
_r := fflush(null as void*)
end
@en "Emit"
@fa "فرستادن"
pub func Emit(s: str):
Write(s)
Flush()
end
@en "IsTTY"
@fa "پایانه است"
pub func IsTTY(fd: int): bool:
if SALAM_OS_WINDOWS:
ret _isatty(fd) != 0
else:
ret isatty(fd) != 0
end
end
@en "IsTerminal"
@fa "پایانه دارد"
pub func IsTerminal(): bool: ret IsTTY(StdoutFd) end
@en "Size"
@fa "اندازه"
pub func Size(): WinSize:
mut out := WinSize {}
if SALAM_OS_WINDOWS:
h := _win_handle(StdoutFd)
if h != null:
info := mem.Allocate(32 as u64)
defer mem.Free(info)
memset(info, 0, 32 as u64)
if GetConsoleScreenBufferInfo(h, info) != 0:
base := info as i64
left := ((base + 10) as i16*)[0] as int
top := ((base + 12) as i16*)[0] as int
right := ((base + 14) as i16*)[0] as int
bottom := ((base + 16) as i16*)[0] as int
c := right - left + 1
r := bottom - top + 1
if c > 0 and r > 0:
out.cols = c
out.rows = r
ret out
end
end
end
else:
ws := mem.Allocate(16 as u64)
defer mem.Free(ws)
req := _winsz_req()
mut fd := StdoutFd
until fd <= StderrFd:
memset(ws, 0, 16 as u64)
if ioctl(fd, req, ws) == 0:
p := ws as u16*
r := p[0] as int
c := p[1] as int
if c > 0 and r > 0:
out.cols = c
out.rows = r
ret out
end
end
fd += 1
end
end
envc := str.ToInt(_env("COLUMNS"))
envr := str.ToInt(_env("LINES"))
if envc > 0: out.cols = envc end
if envr > 0: out.rows = envr end
ret out
end
@en "Cols"
@fa "ستون ها"
pub func Cols(): int:
s := Size()
ret s.cols
end
@en "Rows"
@fa "سطرها"
pub func Rows(): int:
s := Size()
ret s.rows
end
@en "SetColorMode"
@fa "تنظیم حالت رنگ"
pub func SetColorMode(mode: int):
_color_mode = mode
end
@en "ColorMode"
@fa "حالت رنگ"
pub func ColorMode(): int: ret _color_mode end
@en "SupportsColor"
@fa "رنگ پشتیبانی می‌شود"
pub func SupportsColor(): bool:
if _color_mode == ColorAlways: ret true end
if _color_mode == ColorNever: ret false end
if _color_auto == 0:
if _detect_color():
_color_auto = 1
else:
_color_auto = 2
end
end
ret _color_auto == 1
end
@en "Supports256Color"
@fa "رنگ۲۵۶ پشتیبانی می‌شود"
pub func Supports256Color(): bool:
if str.Contains(_env("TERM"), "256color"): ret true end
if _env("COLORTERM").len() > 0: ret true end
ret false
end
@en "SupportsTrueColor"
@fa "رنگ کامل پشتیبانی می‌شود"
pub func SupportsTrueColor(): bool:
ct := _env("COLORTERM")
ret ct == "truecolor" or ct == "24bit"
end
@en "EnableAnsi"
@fa "فعال‌سازی انسی"
pub func EnableAnsi(): bool:
if SALAM_OS_WINDOWS:
h := _win_handle(StdoutFd)
if h == null: ret false end
buf := mem.Allocate(8 as u64)
defer mem.Free(buf)
memset(buf, 0, 8 as u64)
if GetConsoleMode(h, buf) == 0: ret true end
p := buf as int*
ret SetConsoleMode(h, p[0] | 0x4) != 0
else:
ret true
end
end
@en "MakeRaw"
@fa "حالت خام"
pub func MakeRaw(fd: int): TermState: ret _set_mode(fd, true) end
@en "MakeCbreak"
@fa "حالت نیمه‌خام"
pub func MakeCbreak(fd: int): TermState: ret _set_mode(fd, false) end
@en "Restore"
@fa "بازگردانی"
pub func Restore(st &: TermState): bool:
if not st.ok: ret false end
mut done := false
if SALAM_OS_WINDOWS:
h := _win_handle(st.fd)
if h != null: done = SetConsoleMode(h, st.mode_in) != 0 end
else:
if st.saved != null:
done = tcsetattr(st.fd, _TCSAFLUSH, st.saved) == 0
mem.Free(st.saved)
st.saved = null
end
end
st.ok = false
ret done
end
@en "Bell"
@fa "زنگ"
pub func Bell(): Emit("\x07") end
@en "SeqTitle"
@fa "دنباله عنوان"
pub func SeqTitle(title: str): str: ret Esc + "]0;" + title + "\x07" end
@en "SetTitle"
@fa "تنظیم عنوان"
pub func SetTitle(title: str): Emit(SeqTitle(title)) end
package term
import str
@en "Reset"
@fa "بازنشانی"
pub const Reset := "\x1b[0m"
@en "StyleBold"
@fa "سبک ضخیم"
pub const StyleBold := 1
@en "StyleDim"
@fa "سبک کم‌رنگ"
pub const StyleDim := 2
