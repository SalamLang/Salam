@en "FileSize"
@fa "اندازه پرونده"
pub func FileSize(path: str): i64:
fp := _fopen_compat(path, "rb")
if fp == null: ret 0 - 1 end
fseek(fp, 0, 2)
n := ftell(fp)
fclose(fp)
ret n
end
@en "Stat"
@fa "وضعیت پرونده"
pub func Stat(path: str): FileInfo:
if _os_exists(path) == false:
ret FileInfo { size = 0, is_dir = false, exists = false }
end
dir := _os_is_dir(path)
mut sz := 0 as i64
if dir == false:
sz = FileSize(path)
if sz < 0: sz = 0 end
end
ret FileInfo { size = sz, is_dir = dir, exists = true }
end
@en "platform"
@fa "سکو"
package platform
import os
import io
import conv
if SALAM_OS_LINUX:
extern:
func sysconf(name: int): i64
end
const _SC_NPROCESSORS_ONLN := 84
end
func str_has_prefix(text: str, prefix: str): bool:
if prefix.len() > text.len(): ret false end
ret text.substr(0, prefix.len()) == prefix
end
func extract_digits(text: str): str:
mut digits := ""
mut i := 0
n := text.len()
until i < n:
ch := text.substr(i, 1)
code := char_code(ch)
if code >= 48 and code <= 57:
digits = digits.concat(ch)
else:
if digits.len() > 0: ret digits end
end
i += 1
end
ret digits
end
func _meminfo_field(key: str): i64:
meminfo := io.ReadFile("/proc/meminfo")
if meminfo.len() == 0: ret 0 - 1 end
lines := meminfo.split("\n")
defer lines.free()
mut i := 0
line_count := lines.len()
until i < line_count:
line := lines.get(i)
if str_has_prefix(line, key):
after_key := line.substr(key.len(), line.len() - key.len())
digits := extract_digits(after_key)
if digits.len() > 0: ret conv.ParseInt(digits) * 1024 end
ret 0 - 1
end
i += 1
end
ret 0 - 1
end
