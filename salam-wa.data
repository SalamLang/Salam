@en "arabic"
@fa "عربی"
package arabic
import str
import unicode
@en "FoldLetters"
@fa "یکسان سازی حروف"
pub const FoldLetters := 1
@en "StripHarakat"
@fa "حذف اعراب"
pub const StripHarakat := 2
@en "StripTatweel"
@fa "حذف کشیده"
pub const StripTatweel := 4
@en "FoldDigits"
@fa "یکسان سازی رقم ها"
pub const FoldDigits := 8
@en "FoldAlef"
@fa "یکسان سازی الف"
pub const FoldAlef := 16
@en "FoldTehMarbuta"
@fa "یکسان سازی ته گرد"
pub const FoldTehMarbuta := 32
@en "StripZWNJ"
@fa "حذف نیم فاصله"
pub const StripZWNJ := 64
@en "FoldPresentation"
@fa "یکسان سازی شکل نمایشی"
pub const FoldPresentation := 128
const _TATWEEL := 0x0640
pure func _map_cp(cp: int, flags: int): int:
if (flags / StripTatweel) % 2 == 1 and cp == _TATWEEL: ret 0 - 1 end
if (flags / StripHarakat) % 2 == 1 and IsHaraka(cp): ret 0 - 1 end
if (flags / StripZWNJ) % 2 == 1 and cp == unicode.ZWNJ: ret 0 - 1 end
if (flags / FoldLetters) % 2 == 1:
if cp == 0x0643: ret 0x06A9 end
if cp == 0x064A: ret 0x06CC end
if cp == 0x0649: ret 0x06CC end
if cp == 0x06D2: ret 0x06CC end
if cp == 0x06D3: ret 0x06CC end
if cp == 0x06AA: ret 0x06A9 end
if cp == 0x06AB: ret 0x06A9 end
end
if (flags / FoldAlef) % 2 == 1:
if cp == 0x0622 or cp == 0x0623 or cp == 0x0625 or cp == 0x0671: ret 0x0627 end
end
if (flags / FoldTehMarbuta) % 2 == 1:
if cp == 0x0629: ret 0x0647 end
end
ret cp
end
@en "IsArabicScript"
@fa "خط عربی است"
pub pure func IsArabicScript(cp: int): bool:
if unicode.Script(cp) == unicode.ScriptArabic: ret true end
ret IsHaraka(cp)
end
@en "IsHaraka"
@fa "اعراب است"
pub pure func IsHaraka(cp: int): bool:
if cp >= 0x0610 and cp <= 0x061A: ret true end
if cp >= 0x064B and cp <= 0x065F: ret true end
if cp == 0x0670: ret true end
if cp >= 0x06D6 and cp <= 0x06DC: ret true end
if cp >= 0x06DF and cp <= 0x06E4: ret true end
if cp >= 0x06E7 and cp <= 0x06E8: ret true end
if cp >= 0x06EA and cp <= 0x06ED: ret true end
if cp >= 0x08D3 and cp <= 0x08FF: ret true end
ret false
end
@en "IsTatweel"
@fa "کشیده است"
pub inline pure func IsTatweel(cp: int): bool:
ret cp == _TATWEEL
end
@en "Normalize"
@fa "هنجارسازی"
pub func Normalize(s: str, flags: int): str:
mut subject := s
if (flags / FoldPresentation) % 2 == 1:
subject = str.NFKC(s)
end
if (flags / FoldDigits) % 2 == 1:
subject = str.ToEnglishDigits(subject)
end
mut sb := str.NewBuilder()
defer str.BufFree(sb)
n := subject.len()
mut i := 0
mut cp := 0
until i < n:
i = str.CodePointAt(subject, i, cp)
if cp < 0: cp = 0xFFFD end
out := _map_cp(cp, flags)
if out >= 0: str.BufAppendCp(sb, out) end
end
ret str.BufStr(sb)
end
@en "NormalizePersian"
@fa "هنجارسازی فارسی"
pub func NormalizePersian(s: str): str:
ret Normalize(s, FoldPresentation + FoldLetters + StripTatweel)
end
@en "SearchKey"
@fa "کلید جستجو"
pub func SearchKey(s: str): str:
folded := Normalize(
s, FoldPresentation + FoldLetters + StripHarakat + StripTatweel + FoldDigits + FoldAlef + FoldTehMarbuta + StripZWNJ
)
ret str.Lower(folded)
end
@en "EqualLoose"
@fa "یکسان تقریبی"
pub func EqualLoose(a: str, b: str): bool:
ret SearchKey(a) == SearchKey(b)
end
@en "archive"
@fa "بایگانی"
package archive
import mem
import compress
import os
extern:
func fopen(path: str, mode: str): void*
func fclose(fp: void*): int
func fread(ptr: void*, size: u64, nmemb: u64, stream: void*): u64
func fwrite(ptr: void*, size: u64, nmemb: u64, stream: void*): u64
func fseek(fp: void*, off: int, whence: int): int
func ftell(fp: void*): int
end
@en "Entry"
@fa "مدخل"
pub struct Entry:
pub name: str = ""
pub size: i64 = 0 as i64
pub compressed_size: i64 = 0 as i64
pub is_dir: bool = false
pub method: int = 0
pub crc32: u32 = 0 as u32
pub mtime: i64 = 0 as i64
end
func _safe_entry_name(name: str): bool:
n := name.len()
if n == 0:
ret false
end
bp := name as u8*
first := bp[0] as int
if first == 47 or first == 92 or (n >= 2 and (bp[1] as int) == 58):
ret false
end
mut start := 0
mut i := 0
until i <= n:
c := i < n ? bp[i] as int : 47
if c == 47 or c == 92:
if i - start == 2 and (bp[start] as int) == 46 and (bp[start + 1] as int) == 46:
ret false
end
start = i + 1
end
i += 1
end
ret true
end
@en "ReadBinaryFile"
@fa "خواندن پرونده دودویی"
pub func ReadBinaryFile(path: str, ok &: bool): compress.ByteBuf:
ok = false
fp := fopen(path, "rb")
if fp == null:
ret compress.NewByteBuf()
end
fseek(fp, 0, 2)
size := ftell(fp)
fseek(fp, 0, 0)
mut buf := compress.NewByteBufCap(size)
if size > 0:
raw := mem.Allocate(size as u64)
got := fread(raw, 1 as u64, size as u64, fp)
compress.BufPushBytes(buf, raw, got as int)
mem.Free(raw)
end
fclose(fp)
ok = true
ret buf
end
@en "WriteBinaryFile"
@fa "نوشتن پرونده دودویی"
pub func WriteBinaryFile(path: str, p: void*, n: int): bool:
fp := fopen(path, "wb")
if fp == null:
ret false
end
mut written := 0 as u64
if n > 0:
written = fwrite(p, 1 as u64, n as u64, fp)
end
fclose(fp)
ret (written as int) == n
end
@en "WriteBinaryFileBuf"
@fa "نوشتن پرونده دودویی از بافر"
pub func WriteBinaryFileBuf(path: str, b: compress.ByteBuf): bool:
ret WriteBinaryFile(path, b.data, b.len)
end
@en "EnsureDir"
@fa "اطمینان از پوشه"
pub func EnsureDir(dir: str):
if dir.len() == 0: ret end
if os.Exists(dir): ret end
os.MkdirAll(dir)
end
@en "LEGet16"
@fa "خواندن شانزده بیتی کم ارزش‌اول"
pub func LEGet16(p: void*, off: int): int:
bp := p as u8*
ret (bp[off] as int) | ((bp[off + 1] as int) << 8)
end
@en "LEGet32"
@fa "خواندن عدد۳۲ کم ارزش‌اول"
pub func LEGet32(p: void*, off: int): int:
bp := p as u8*
ret (bp[off] as int) | ((bp[off + 1] as int) << 8) | ((bp[off + 2] as int) << 16) | ((bp[off + 3] as int) << 24)
end
@en "LEPut16"
@fa "نوشتن شانزده بیتی کم ارزش‌اول"
pub func LEPut16(b &: compress.ByteBuf, v: int):
compress.BufPush(b, v & 255)
compress.BufPush(b, (v >> 8) & 255)
end
@en "LEPut32"
@fa "نوشتن عدد۳۲ کم ارزش‌اول"
pub func LEPut32(b &: compress.ByteBuf, v: int):
compress.BufPush(b, v & 255)
compress.BufPush(b, (v >> 8) & 255)
compress.BufPush(b, (v >> 16) & 255)
compress.BufPush(b, (v >> 24) & 255)
end
@en "FreeEntries"
@fa "آزادسازی فهرست"
pub func FreeEntries(v &: Vector<Entry>):
repeat v.len() in i:
nm := v.get(i).name
if nm.len() > 0: mem.Free(nm as void*) end
end
v.free()
end
package archive
import compress
@en "GzipCompressFile"
@fa "فشرده سازی پرونده جی زیپ"
pub func GzipCompressFile(inpath: str, outpath: str): bool:
mut rok := false
inbuf := ReadBinaryFile(inpath, rok)
if not rok:
ret false
end
mut out := compress.GzipCompress(inbuf.data, inbuf.len)
wok := WriteBinaryFileBuf(outpath, out)
compress.BufFree(inbuf)
compress.BufFree(out)
ret wok
end
@en "GzipDecompressFile"
@fa "کدگشایی پرونده جی زیپ"
pub func GzipDecompressFile(inpath: str, outpath: str): bool:
mut rok := false
inbuf := ReadBinaryFile(inpath, rok)
if not rok:
ret false
end
mut gok := false
mut out := compress.GzipDecompress(inbuf.data, inbuf.len, gok)
compress.BufFree(inbuf)
if not gok:
compress.BufFree(out)
ret false
end
wok := WriteBinaryFileBuf(outpath, out)
compress.BufFree(out)
ret wok
end
package archive
import compress
import filepath
import mem
const _RAR4_SIG_LEN := 7
const _RAR5_SIG_LEN := 8
func _rar4_sig_match(p: void*, n: int): bool:
if n < _RAR4_SIG_LEN: ret false end
bp := p as u8*
ret bp[0] as int == 0x52 and bp[1] as int == 0x61 and bp[2] as int == 0x72 and bp[3] as int == 0x21 and bp[4] as int == 0x1a and bp[5] as int == 0x07 and bp[6] as int == 0x00
end
func _rar5_sig_match(p: void*, n: int): bool:
if n < _RAR5_SIG_LEN: ret false end
bp := p as u8*
ret bp[0] as int == 0x52 and bp[1] as int == 0x61 and bp[2] as int == 0x72 and bp[3] as int == 0x21 and bp[4] as int == 0x1a and bp[5] as int == 0x07 and bp[6] as int == 0x01 and bp[7] as int == 0x00
end
func _rar_bytes_to_str(p: void*, off: int, n: int): str:
mut buf := compress.NewByteBuf()
compress.BufPushBytes(buf, ((p as i64) + (off as i64)) as void*, n)
s := compress.BufToStrUnsafe(buf)
compress.BufFree(buf)
ret s
end
func _rar_free_name(s: str):
if s.len() > 0:
mem.Free(s as void*)
end
end
func _rar4_read_file_fields(p: void*, block_start: int, pack_size_out &: int, unp_size_out &: int, method_out &: int, flags_out &: int, name_out &: str): int:
bp := p as u8*
flags_out = (bp[block_start + 3] as int) | ((bp[block_start + 4] as int) << 8)
head_size := (bp[block_start + 5] as int) | ((bp[block_start + 6] as int) << 8)
f := block_start + 7
pack_size_out = LEGet32(p, f)
unp_size_out = LEGet32(p, f + 4)
method_out = bp[f + 18] as int
name_size := LEGet16(p, f + 19)
name_off := f + 25
name_out = _rar_bytes_to_str(p, name_off, name_size)
ret head_size
end
func _rar5_vint(p: void*, pos: int, len_out &: int): i64:
bp := p as u8*
mut result := 0 as i64
mut shift := 0
mut i := 0
until i < 10:
b := bp[pos + i] as int
result = result | (((b & 0x7f) as i64) << shift)
i += 1
if (b & 0x80) == 0:
len_out = i
ret result
end
shift += 7
end
len_out = i
ret result
end
func _rar5_parse_block(p: void*, block_start: int, n: int, header_type_out &: int, total_size_out &: int, is_dir_out &: bool, unp_size_out &: int, method_out &: int, name_out &: str, data_offset_out &: int, data_size_out &: int): bool:
if block_start + 5 > n:
ret false
end
mut hsize_len := 0
hsize := _rar5_vint(p, block_start + 4, hsize_len) as int
header_data_start := block_start + 4 + hsize_len
if header_data_start + hsize > n:
ret false
end
mut cur := header_data_start
mut vlen := 0
header_type := _rar5_vint(p, cur, vlen) as int
cur += vlen
header_flags := _rar5_vint(p, cur, vlen) as int
cur += vlen
if (header_flags & 0x01) != 0:
_extra_size := _rar5_vint(p, cur, vlen)
cur += vlen
end
mut data_size := 0
if (header_flags & 0x02) != 0:
data_size = _rar5_vint(p, cur, vlen) as int
cur += vlen
end
header_type_out = header_type
data_size_out = data_size
is_dir_out = false
unp_size_out = 0
method_out = 0
name_out = ""
data_offset_out = header_data_start + hsize
if header_type == 2 or header_type == 3:
file_flags := _rar5_vint(p, cur, vlen) as int
cur += vlen
unp_size := _rar5_vint(p, cur, vlen) as int
cur += vlen
_attr := _rar5_vint(p, cur, vlen)
cur += vlen
if (file_flags & 0x02) != 0:
cur += 4
end
if (file_flags & 0x04) != 0:
cur += 4
end
compinfo := _rar5_vint(p, cur, vlen) as int
cur += vlen
_host_os := _rar5_vint(p, cur, vlen)
cur += vlen
name_size := _rar5_vint(p, cur, vlen) as int
cur += vlen
name_out = _rar_bytes_to_str(p, cur, name_size)
is_dir_out = (file_flags & 0x01) != 0
unp_size_out = unp_size
method_out = (compinfo >> 7) & 7
end
total_size_out = (header_data_start - block_start) + hsize + data_size
ret true
end
func _rar4_list(p: void*, n: int, out &: Vector<Entry>):
bp := p as u8*
mut pos := _RAR4_SIG_LEN
until pos + 7 <= n:
head_type := bp[pos + 2] as int
head_size := (bp[pos + 5] as int) | ((bp[pos + 6] as int) << 8)
if head_size < 7:
break
end
if head_type == 0x7b:
break
end
if head_type == 0x74:
mut pack_size := 0
mut unp_size := 0
mut method := 0
mut flags := 0
mut name := ""
_rar4_read_file_fields(p, pos, pack_size, unp_size, method, flags, name)
e := Entry {
name = name
size = unp_size as i64
compressed_size = pack_size as i64
is_dir = false
method = method
crc32 = 0 as u32
mtime = 0 as i64
}
out.push(e)
pos += head_size + pack_size
else:
pos += head_size
end
end
end
func _rar5_list(p: void*, n: int, out &: Vector<Entry>):
mut pos := _RAR5_SIG_LEN
until pos < n:
mut header_type := 0
mut total_size := 0
mut is_dir := false
mut unp_size := 0
mut method := 0
mut name := ""
mut data_offset := 0
mut data_size := 0
good := _rar5_parse_block(p, pos, n, header_type, total_size, is_dir, unp_size, method, name, data_offset, data_size)
if not (good and total_size > 0 and header_type == 2 and name.len() > 0):
_rar_free_name(name)
end
if not good or total_size <= 0:
break
end
if header_type == 5:
break
end
if header_type == 2 and name.len() > 0:
e := Entry {
name = name
size = unp_size as i64
compressed_size = data_size as i64
is_dir = is_dir
method = method
crc32 = 0 as u32
mtime = 0 as i64
}
out.push(e)
end
pos += total_size
end
end
func _rar4_extract(p: void*, n: int, name: str, out &: compress.ByteBuf, ok &: bool):
bp := p as u8*
mut pos := _RAR4_SIG_LEN
until pos + 7 <= n:
head_type := bp[pos + 2] as int
head_size := (bp[pos + 5] as int) | ((bp[pos + 6] as int) << 8)
if head_size < 7:
break
end
if head_type == 0x7b:
break
end
if head_type == 0x74:
mut pack_size := 0
mut unp_size := 0
mut method := 0
mut flags := 0
mut nm := ""
_rar4_read_file_fields(p, pos, pack_size, unp_size, method, flags, nm)
hit := nm == name
_rar_free_name(nm)
if hit:
if (flags & 0x0004) != 0:
ret
end
if method != 0x30:
ret
end
data_ptr := ((p as i64) + ((pos + head_size) as i64)) as void*
compress.BufPushBytes(out, data_ptr, pack_size)
ok = true
ret
end
pos += head_size + pack_size
else:
pos += head_size
end
end
end
func _rar5_extract(p: void*, n: int, name: str, out &: compress.ByteBuf, ok &: bool):
mut pos := _RAR5_SIG_LEN
until pos < n:
mut header_type := 0
mut total_size := 0
mut is_dir := false
mut unp_size := 0
mut method := 0
mut nm := ""
mut data_offset := 0
mut data_size := 0
good := _rar5_parse_block(p, pos, n, header_type, total_size, is_dir, unp_size, method, nm, data_offset, data_size)
hit := header_type == 2 and nm == name and not is_dir
_rar_free_name(nm)
if not good or total_size <= 0:
break
end
if header_type == 5:
break
end
if hit:
if method != 0:
ret
end
data_ptr := ((p as i64) + (data_offset as i64)) as void*
compress.BufPushBytes(out, data_ptr, data_size)
ok = true
ret
end
pos += total_size
end
end
@en "IsRar"
@fa "آر ای آر است"
pub func IsRar(p: void*, n: int): bool:
ret _rar4_sig_match(p, n) or _rar5_sig_match(p, n)
end
@en "RarList"
@fa "فهرست آر ای آر"
pub func RarList(p: void*, n: int): Vector<Entry>:
mut out := Vector {} as Vector<Entry>
if _rar4_sig_match(p, n):
_rar4_list(p, n, out)
else:
if _rar5_sig_match(p, n):
_rar5_list(p, n, out)
end
end
ret out
end
@en "RarExtractByName"
@fa "استخراج با نام از آر ای آر"
pub func RarExtractByName(p: void*, n: int, name: str, ok &: bool): compress.ByteBuf:
ok = false
mut out := compress.NewByteBuf()
if _rar4_sig_match(p, n):
_rar4_extract(p, n, name, out, ok)
else:
if _rar5_sig_match(p, n):
_rar5_extract(p, n, name, out, ok)
end
end
ret out
end
@en "RarExtractAll"
@fa "استخراج همه از آر ای آر"
pub func RarExtractAll(p: void*, n: int, destdir: str): bool:
entries := RarList(p, n)
mut all_ok := true
mut i := 0
until i < entries.len():
e := entries.get(i)
if not _safe_entry_name(e.name):
all_ok = false
i += 1
continue
end
outpath := filepath.Join(destdir, e.name)
if e.is_dir:
EnsureDir(outpath)
else:
parent := filepath.Dir(outpath)
EnsureDir(parent)
mem.Free(parent as void*)
mut ok := false
data := RarExtractByName(p, n, e.name, ok)
if ok:
if not WriteBinaryFileBuf(outpath, data):
all_ok = false
end
else:
all_ok = false
end
compress.BufFree(data)
end
mem.Free(outpath as void*)
i += 1
end
defer FreeEntries(entries)
ret all_ok
end
package archive
import compress
import mem
import filepath
@en "TarFileInput"
@fa "ورودی پرونده تار"
pub struct TarFileInput:
pub name: str = ""
pub data_ptr: void* = null
pub data_len: int = 0
pub is_dir: bool = false
end
func _tar_put_octal(b &: compress.ByteBuf, value: i64, width: int):
ndigits := width - 1
mut digits: int[16]
mut v := value
mut i := ndigits - 1
until i >= 0:
digits[i] = (v % (8 as i64)) as int
v = v / (8 as i64)
i -= 1
end
mut k := 0
until k < ndigits:
compress.BufPush(b, 48 + digits[k])
k += 1
end
compress.BufPush(b, 0)
end
func _tar_get_octal(p: void*, off: int, width: int): i64:
bp := p as u8*
mut v := 0 as i64
mut i := 0
until i < width:
c := bp[off + i] as int
if c >= 48 and c <= 55:
v = v * (8 as i64) + ((c - 48) as i64)
end
i += 1
end
ret v
end
func _tar_put_str(b &: compress.ByteBuf, s: str, width: int):
n := s.len()
mut w := n
if w > width: w = width end
compress.BufPushBytes(b, s as void*, w)
mut pad := width - w
until pad > 0:
compress.BufPush(b, 0)
pad -= 1
end
end
func _tar_get_str(p: void*, off: int, width: int): str:
bp := p as u8*
mut len := 0
until len < width and (bp[off + len] as int) != 0:
len += 1
end
mut buf := compress.NewByteBuf()
compress.BufPushBytes(buf, ((p as i64) + (off as i64)) as void*, len)
s := compress.BufToStrUnsafe(buf)
compress.BufFree(buf)
ret s
end
func _tar_free_str(name: str):
if name.len() > 0: mem.Free(name as void*) end
end
func _tar_checksum(header: void*): int:
bp := header as u8*
mut sum := 0
mut i := 0
until i < 512:
if i >= 148 and i < 156:
sum += 32
else:
sum += bp[i] as int
end
i += 1
end
ret sum
end
func _tar_is_zero_block(p: void*, pos: int): bool:
bp := p as u8*
mut i := 0
until i < 512:
if (bp[pos + i] as int) != 0:
ret false
end
i += 1
end
ret true
end
func _tar_write_header(out &: compress.ByteBuf, f: TarFileInput):
mut h := compress.NewByteBuf()
_tar_put_str(h, f.name, 100)
_tar_put_octal(h, 0o644 as i64, 8)
_tar_put_octal(h, 0 as i64, 8)
_tar_put_octal(h, 0 as i64, 8)
mut sz := f.data_len
if f.is_dir: sz = 0 end
_tar_put_octal(h, sz as i64, 12)
_tar_put_octal(h, 0 as i64, 12)
repeat 8: compress.BufPush(h, 32) end
mut typeflag := 48
if f.is_dir: typeflag = 53 end
compress.BufPush(h, typeflag)
_tar_put_str(h, "", 100)
_tar_put_str(h, "ustar", 6)
compress.BufPush(h, 48)
compress.BufPush(h, 48)
_tar_put_str(h, "", 32)
_tar_put_str(h, "", 32)
_tar_put_octal(h, 0 as i64, 8)
_tar_put_octal(h, 0 as i64, 8)
_tar_put_str(h, "", 155)
repeat 12: compress.BufPush(h, 0) end
sum := _tar_checksum(h.data)
mut tmp := compress.NewByteBuf()
_tar_put_octal(tmp, sum as i64, 7)
mut k := 0
until k < 6:
compress.BufSet(h, 148 + k, compress.BufGet(tmp, k))
k += 1
end
compress.BufSet(h, 148 + 6, 0)
compress.BufSet(h, 148 + 7, 32)
compress.BufFree(tmp)
compress.BufPushBuf(out, h)
compress.BufFree(h)
end
@en "MakeTarFileInput"
@fa "ساخت ورودی پرونده تار"
pub func MakeTarFileInput(name: str, data_ptr: void*, data_len: int, is_dir: bool): TarFileInput:
ret TarFileInput { name = name, data_ptr = data_ptr, data_len = data_len, is_dir = is_dir }
end
@en "TarCreate"
@fa "ساخت تار"
pub func TarCreate(files: Vector<TarFileInput>): compress.ByteBuf:
mut out := compress.NewByteBuf()
mut i := 0
until i < files.len():
f := files.get(i)
_tar_write_header(out, f)
if not f.is_dir:
compress.BufPushBytes(out, f.data_ptr, f.data_len)
pad := f.data_len % 512
if pad > 0:
mut k := 0
until k < 512 - pad:
compress.BufPush(out, 0)
k += 1
end
end
end
i += 1
end
repeat 1024: compress.BufPush(out, 0) end
ret out
end
@en "TarCreateFile"
@fa "ساخت پرونده تار"
pub func TarCreateFile(files: Vector<TarFileInput>, outpath: str): bool:
mut out := TarCreate(files)
ok := WriteBinaryFileBuf(outpath, out)
compress.BufFree(out)
ret ok
end
@en "TarList"
@fa "فهرست تار"
pub func TarList(p: void*, n: int): Vector<Entry>:
mut out := Vector {} as Vector<Entry>
mut pos := 0
until pos + 512 <= n:
if _tar_is_zero_block(p, pos):
break
end
nm := _tar_get_str(p, pos, 100)
if nm.len() == 0:
break
end
size := _tar_get_octal(p, pos + 124, 12)
if size < (0 as i64) or (pos as i64) + (512 as i64) + size > (n as i64):
_tar_free_str(nm)
break
end
mtime := _tar_get_octal(p, pos + 136, 12)
bp := p as u8*
typeflag := bp[pos + 156] as int
is_dir := typeflag == 53
e := Entry {
name = nm
size = size
compressed_size = size
is_dir = is_dir
method = 0
crc32 = 0 as u32
mtime = mtime
}
out.push(e)
pos += 512
if not is_dir:
datasize := size as int
pos += datasize
pad := datasize % 512
if pad > 0:
pos += 512 - pad
end
end
end
ret out
end
@en "TarExtractByName"
@fa "استخراج با نام از تار"
pub func TarExtractByName(p: void*, n: int, name: str, ok &: bool): compress.ByteBuf:
ok = false
mut out := compress.NewByteBuf()
mut pos := 0
until pos + 512 <= n:
if _tar_is_zero_block(p, pos):
break
end
nm := _tar_get_str(p, pos, 100)
empty := nm.len() == 0
size := _tar_get_octal(p, pos + 124, 12)
bp := p as u8*
typeflag := bp[pos + 156] as int
is_dir := typeflag == 53
datasize := size as int
hit := not empty and nm == name and not is_dir
_tar_free_str(nm)
if empty or size < (0 as i64) or (pos as i64) + (512 as i64) + size > (n as i64):
break
end
if hit:
data_ptr := ((p as i64) + ((pos + 512) as i64)) as void*
compress.BufPushBytes(out, data_ptr, datasize)
ok = true
ret out
end
pos += 512
if not is_dir:
pos += datasize
pad := datasize % 512
if pad > 0:
pos += 512 - pad
end
end
end
ret out
end
@en "TarExtractAll"
@fa "استخراج همه از تار"
pub func TarExtractAll(p: void*, n: int, destdir: str): bool:
entries := TarList(p, n)
mut all_ok := true
mut i := 0
until i < entries.len():
e := entries.get(i)
if not _safe_entry_name(e.name):
all_ok = false
i += 1
continue
end
outpath := filepath.Join(destdir, e.name)
if e.is_dir:
EnsureDir(outpath)
else:
parent := filepath.Dir(outpath)
EnsureDir(parent)
mem.Free(parent as void*)
mut ok := false
data := TarExtractByName(p, n, e.name, ok)
if ok:
if not WriteBinaryFileBuf(outpath, data):
all_ok = false
end
else:
all_ok = false
end
compress.BufFree(data)
end
mem.Free(outpath as void*)
i += 1
end
defer FreeEntries(entries)
ret all_ok
end
package archive
import compress
import filepath
import mem
import str
@en "ZipFileInput"
@fa "ورودی پرونده زیپ"
pub struct ZipFileInput:
pub name: str = ""
pub data_ptr: void* = null
pub data_len: int = 0
pub method: int = 8
end
func _zip_find_eocd(p: void*, n: int, eocd_pos_out &: int): bool:
if n < 22:
ret false
end
mut search_start := n - 22 - 65535
if search_start < 0: search_start = 0 end
mut i := n - 22
until i >= search_start:
if LEGet32(p, i) == 0x06054b50:
eocd_pos_out = i
ret true
end
i -= 1
end
ret false
end
func _zip_in(off: int, len: int, n: int): bool:
ret off >= 0 and len >= 0 and (off as i64) + (len as i64) <= (n as i64)
end
func _zip_read_name(p: void*, off: int, name_len: int): str:
mut nmbuf := compress.NewByteBuf()
name_ptr := ((p as i64) + (off as i64)) as void*
compress.BufPushBytes(nmbuf, name_ptr, name_len)
nm := compress.BufToStrUnsafe(nmbuf)
compress.BufFree(nmbuf)
ret nm
end
func _zip_free_name(name: str):
if str.Len(name) > 0: mem.Free(name as void*) end
end
func _zip_is_dir_name(name: str): bool:
n := name.len()
if n == 0: ret false end
ret str.EndsWith(name, "/")
end
@en "MakeZipFileInput"
@fa "ساخت ورودی پرونده زیپ"
pub func MakeZipFileInput(name: str, data_ptr: void*, data_len: int, method: int): ZipFileInput:
ret ZipFileInput { name = name, data_ptr = data_ptr, data_len = data_len, method = method }
end
@en "ZipCreate"
@fa "ساخت زیپ"
pub func ZipCreate(files: Vector<ZipFileInput>): compress.ByteBuf:
mut body := compress.NewByteBuf()
mut central := compress.NewByteBuf()
mut count := 0
mut i := 0
until i < files.len():
f := files.get(i)
crc := compress.CRC32(f.data_ptr, f.data_len)
mut comp_ptr := f.data_ptr
mut comp_len := f.data_len
mut owned := compress.NewByteBuf()
mut has_owned := false
if f.method == 8:
owned = compress.RawDeflate(f.data_ptr, f.data_len)
comp_ptr = owned.data
comp_len = owned.len
has_owned = true
end
offset := compress.BufLen(body)
name_len := f.name.len()
LEPut32(body, 0x04034b50)
LEPut16(body, 20)
LEPut16(body, 0)
LEPut16(body, f.method)
LEPut16(body, 0)
LEPut16(body, 0x21)
LEPut32(body, crc as int)
LEPut32(body, comp_len)
LEPut32(body, f.data_len)
LEPut16(body, name_len)
LEPut16(body, 0)
compress.BufPushBytes(body, f.name as void*, name_len)
compress.BufPushBytes(body, comp_ptr, comp_len)
LEPut32(central, 0x02014b50)
LEPut16(central, 20)
LEPut16(central, 20)
LEPut16(central, 0)
LEPut16(central, f.method)
LEPut16(central, 0)
LEPut16(central, 0x21)
LEPut32(central, crc as int)
LEPut32(central, comp_len)
LEPut32(central, f.data_len)
LEPut16(central, name_len)
LEPut16(central, 0)
LEPut16(central, 0)
LEPut16(central, 0)
LEPut16(central, 0)
LEPut32(central, 0)
LEPut32(central, offset)
compress.BufPushBytes(central, f.name as void*, name_len)
if has_owned:
compress.BufFree(owned)
end
count += 1
i += 1
end
mut out := compress.NewByteBuf()
compress.BufPushBuf(out, body)
cd_offset := compress.BufLen(out)
compress.BufPushBuf(out, central)
cd_size := compress.BufLen(central)
compress.BufFree(body)
compress.BufFree(central)
LEPut32(out, 0x06054b50)
LEPut16(out, 0)
LEPut16(out, 0)
LEPut16(out, count)
LEPut16(out, count)
LEPut32(out, cd_size)
LEPut32(out, cd_offset)
LEPut16(out, 0)
ret out
end
@en "ZipCreateFile"
@fa "ساخت پرونده زیپ"
pub func ZipCreateFile(files: Vector<ZipFileInput>, outpath: str): bool:
mut out := ZipCreate(files)
ok := WriteBinaryFileBuf(outpath, out)
compress.BufFree(out)
ret ok
end
@en "ZipList"
@fa "فهرست زیپ"
pub func ZipList(p: void*, n: int): Vector<Entry>:
mut out := Vector {} as Vector<Entry>
mut eocd_pos := 0
if not _zip_find_eocd(p, n, eocd_pos):
ret out
end
count := LEGet16(p, eocd_pos + 10)
cd_offset := LEGet32(p, eocd_pos + 16)
mut pos := cd_offset
mut k := 0
until k < count:
if not _zip_in(pos, 46, n) or LEGet32(p, pos) != 0x02014b50:
break
end
if not _zip_in(pos + 46, LEGet16(p, pos + 28), n):
break
end
method := LEGet16(p, pos + 10)
crc := LEGet32(p, pos + 16)
comp_size := LEGet32(p, pos + 20)
uncomp_size := LEGet32(p, pos + 24)
name_len := LEGet16(p, pos + 28)
extra_len := LEGet16(p, pos + 30)
comment_len := LEGet16(p, pos + 32)
nm := _zip_read_name(p, pos + 46, name_len)
e := Entry {
name = nm
size = uncomp_size as i64
compressed_size = comp_size as i64
is_dir = _zip_is_dir_name(nm)
method = method
crc32 = crc as u32
mtime = 0 as i64
}
out.push(e)
pos += 46 + name_len + extra_len + comment_len
k += 1
end
ret out
end
@en "ZipExtractByName"
@fa "استخراج با نام از زیپ"
pub func ZipExtractByName(p: void*, n: int, name: str, ok &: bool): compress.ByteBuf:
ok = false
mut out := compress.NewByteBuf()
mut eocd_pos := 0
if not _zip_find_eocd(p, n, eocd_pos):
ret out
end
count := LEGet16(p, eocd_pos + 10)
cd_offset := LEGet32(p, eocd_pos + 16)
mut pos := cd_offset
mut k := 0
until k < count:
if not _zip_in(pos, 46, n) or LEGet32(p, pos) != 0x02014b50:
break
end
if not _zip_in(pos + 46, LEGet16(p, pos + 28), n):
break
end
flags := LEGet16(p, pos + 8)
method := LEGet16(p, pos + 10)
comp_size := LEGet32(p, pos + 20)
uncomp_size := LEGet32(p, pos + 24)
name_len := LEGet16(p, pos + 28)
extra_len := LEGet16(p, pos + 30)
comment_len := LEGet16(p, pos + 32)
local_offset := LEGet32(p, pos + 42)
nm := _zip_read_name(p, pos + 46, name_len)
hit := nm == name
_zip_free_name(nm)
if hit:
if (flags & 1) != 0 or not _zip_in(local_offset, 30, n):
ret out
end
lname_len := LEGet16(p, local_offset + 26)
lextra_len := LEGet16(p, local_offset + 28)
data_start := local_offset + 30 + lname_len + lextra_len
if not _zip_in(data_start, comp_size, n):
ret out
end
data_ptr := ((p as i64) + (data_start as i64)) as void*
if method == 0:
compress.BufPushBytes(out, data_ptr, comp_size)
ok = true
else:
if method == 8:
mut infl_ok := false
result := compress.RawInflate(data_ptr, comp_size, uncomp_size < 0 ? 0 : uncomp_size, infl_ok)
if infl_ok:
compress.BufFree(out)
out = result
ok = true
else:
compress.BufFree(result)
end
end
end
ret out
end
pos += 46 + name_len + extra_len + comment_len
k += 1
end
ret out
end
@en "ZipExtractAll"
@fa "استخراج همه از زیپ"
pub func ZipExtractAll(p: void*, n: int, destdir: str): bool:
entries := ZipList(p, n)
mut all_ok := true
mut i := 0
until i < entries.len():
e := entries.get(i)
if not _safe_entry_name(e.name):
all_ok = false
i += 1
continue
end
outpath := filepath.Join(destdir, e.name)
if e.is_dir:
EnsureDir(outpath)
else:
parent := filepath.Dir(outpath)
EnsureDir(parent)
mem.Free(parent as void*)
mut ok := false
data := ZipExtractByName(p, n, e.name, ok)
if ok:
if not WriteBinaryFileBuf(outpath, data):
all_ok = false
end
else:
all_ok = false
end
compress.BufFree(data)
end
mem.Free(outpath as void*)
i += 1
end
defer FreeEntries(entries)
ret all_ok
end
@en "atomic"
@fa "اتمی"
package atomic
import mem
import sync
@en "I64"
@fa "صحیح۶۴"
pub struct I64:
pub cell: i64* = null
pub mu: sync.Mutex = sync.Mutex {}
end
@en "Flag"
@fa "پرچم"
pub struct Flag:
pub cell: i64* = null
pub mu: sync.Mutex = sync.Mutex {}
end
if defined(SALAM_CC_TCC):
func cell_new(v: i64): I64:
c := mem.AllocateZeroed(8 as u64) as i64*
c[0] = v
ret I64 { cell = c, mu = sync.NewMutex() }
end
func cell_load(a: I64): i64:
c := a.cell
sync.Lock(a.mu)
v := c[0]
sync.Unlock(a.mu)
ret v
end
func cell_store(a: I64, v: i64):
c := a.cell
sync.Lock(a.mu)
c[0] = v
sync.Unlock(a.mu)
end
func cell_add(a: I64, delta: i64): i64:
c := a.cell
sync.Lock(a.mu)
c[0] = c[0] + delta
v := c[0]
sync.Unlock(a.mu)
ret v
end
func cell_swap(a: I64, v: i64): i64:
c := a.cell
sync.Lock(a.mu)
old := c[0]
c[0] = v
sync.Unlock(a.mu)
ret old
end
func cell_cas(a: I64, expected: i64, next: i64): bool:
c := a.cell
sync.Lock(a.mu)
mut won := false
if c[0] == expected:
c[0] = next
won = true
end
sync.Unlock(a.mu)
ret won
end
func cell_free(a: I64):
mem.Free(a.cell as void*)
sync.Destroy(a.mu)
end
else:
func cell_new(v: i64): I64:
c := mem.AllocateZeroed(8 as u64) as i64*
atomic_store(c, v)
ret I64 { cell = c, mu = sync.Mutex {} }
end
func cell_load(a: I64): i64: ret atomic_load(a.cell) end
func cell_store(a: I64, v: i64): atomic_store(a.cell, v) end
func cell_add(a: I64, delta: i64): i64: ret atomic_add(a.cell, delta) end
func cell_swap(a: I64, v: i64): i64: ret atomic_swap(a.cell, v) end
func cell_cas(a: I64, expected: i64, next: i64): bool:
ret atomic_cas(a.cell, expected, next)
end
func cell_free(a: I64): mem.Free(a.cell as void*) end
end
@en "NewI64"
@fa "صحیح۶۴ جدید"
pub func NewI64(v: i64): I64: ret cell_new(v) end
@en "Load"
@fa "بارگذاری"
pub func Load(a: I64): i64: ret cell_load(a) end
@en "Store"
@fa "ذخیره"
pub func Store(a: I64, v: i64): cell_store(a, v) end
@en "Add"
@fa "افزودن"
pub func Add(a: I64, delta: i64): i64: ret cell_add(a, delta) end
@en "Swap"
@fa "تعویض"
pub func Swap(a: I64, v: i64): i64: ret cell_swap(a, v) end
@en "CompareAndSwap"
@fa "مقایسه سپس تعویض"
pub func CompareAndSwap(a: I64, expected: i64, next: i64): bool:
ret cell_cas(a, expected, next)
end
@en "DestroyI64"
@fa "نابودسازی صحیح۶۴"
pub func DestroyI64(a: I64): cell_free(a) end
@en "NewFlag"
@fa "پرچم جدید"
pub func NewFlag(v: bool): Flag:
mut n := 0 as i64
if v: n = 1 end
c := cell_new(n)
ret Flag { cell = c.cell, mu = c.mu }
end
@en "Get"
@fa "گرفتن"
pub func Get(f: Flag): bool:
ret cell_load(I64 { cell = f.cell, mu = f.mu }) != 0
end
@en "Set"
@fa "تنظیم"
pub func Set(f: Flag, v: bool):
mut n := 0 as i64
if v: n = 1 end
cell_store(I64 { cell = f.cell, mu = f.mu }, n)
end
@en "TestAndSet"
@fa "آزمون سپس تنظیم"
pub func TestAndSet(f: Flag): bool:
ret cell_cas(I64 { cell = f.cell, mu = f.mu }, 0 as i64, 1 as i64)
end
@en "DestroyFlag"
@fa "نابودسازی پرچم"
pub func DestroyFlag(f: Flag):
cell_free(I64 { cell = f.cell, mu = f.mu })
end
package autograd
import tensor
extern:
pure func expf(x: f32): f32
pure func tanhf(x: f32): f32
pure func powf(x: f32, y: f32): f32
end
func _bk_flat_add(pg: f32*, pd: f32*, n: int):
repeat n in k: pg[k] = pg[k] + pd[k] end
end
func _acc_reduced(tp &: Tape, v: int, dc &: tensor.Tensor):
if tp.needs.get(v) == false: ret end
target := Value(tp, v)
g := _grad_of(tp, v)
pg := g.data.data
pd := dc.data.data
tn := target.numel()
dn := dc.numel()
if target.same_shape(dc):
_bk_flat_add(pg, pd, dn)
ret
end
if tn == 1:
pg[0] = pg[0] + (tensor.SumAll(dc) as f32)
ret
end
tr := target.rank()
dr := dc.rank()
if tr == dr and target.shape.get(tr - 1) == 1:
width := dc.shape.get(dr - 1)
rows := dn / width
repeat rows in r:
base := r * width
mut s := 0.0 as f32
repeat width in k: s += pd[base + k] end
pg[r] = pg[r] + s
end
ret
end
inner := tn
outer := dn / inner
repeat outer in o:
base := o * inner
repeat inner in k: pg[k] = pg[k] + pd[base + k] end
end
end
func _bk_mul(tp &: Tape, n &: Node, dc &: tensor.Tensor):
va := Value(tp, n.a)
vb := Value(tp, n.b)
if tp.needs.get(n.a):
mut t := tensor.Mul(dc, vb)
_acc_reduced(tp, n.a, t)
t.free()
end
if tp.needs.get(n.b):
mut t := tensor.Mul(dc, va)
_acc_reduced(tp, n.b, t)
t.free()
end
end
func _bk_div(tp &: Tape, n &: Node, dc &: tensor.Tensor):
vb := Value(tp, n.b)
vo := Value(tp, n.out)
if tp.needs.get(n.a):
mut t := tensor.Div(dc, vb)
_acc_reduced(tp, n.a, t)
t.free()
end
if tp.needs.get(n.b):
mut t := tensor.Mul(dc, vo)
mut t2 := tensor.Div(t, vb)
tensor.ScaleInPlace(t2, 0.0 - 1.0)
_acc_reduced(tp, n.b, t2)
t.free()
t2.free()
end
end
func _bk_unary(op: int, pin: f32*, pout: f32*, pd: f32*, pg: f32*, cnt: int, f0: f64):
zero := 0.0 as f32
one := 1.0 as f32
if op == _OP_NEG:
repeat cnt in k: pg[k] = pg[k] - pd[k] end
else op == _OP_SCALE:
s := f0 as f32
repeat cnt in k: pg[k] = pg[k] + s * pd[k] end
else op == _OP_ADDS:
repeat cnt in k: pg[k] = pg[k] + pd[k] end
else op == _OP_EXP:
repeat cnt in k: pg[k] = pg[k] + pd[k] * pout[k] end
else op == _OP_LOG:
repeat cnt in k:
v := pin[k]
if v != zero: pg[k] = pg[k] + pd[k] / v end
end
else op == _OP_TANH:
repeat cnt in k:
o := pout[k]
pg[k] = pg[k] + pd[k] * (one - o * o)
end
else op == _OP_SIGMOID:
repeat cnt in k:
o := pout[k]
pg[k] = pg[k] + pd[k] * o * (one - o)
end
else op == _OP_RELU:
repeat cnt in k:
mut m := zero
if pin[k] > zero: m = one end
pg[k] = pg[k] + pd[k] * m
end
else op == _OP_GELU:
c0 := 0.7978845608028654 as f32
c1 := 0.044715 as f32
half := 0.5 as f32
three := 3.0 as f32
repeat cnt in k:
x := pin[k]
u := c0 * (x + c1 * x * x * x)
t := tanhf(u)
du := c0 * (one + three * c1 * x * x)
d := half * (one + t) + half * x * (one - t * t) * du
pg[k] = pg[k] + pd[k] * d
end
else op == _OP_SQRT:
half := 0.5 as f32
repeat cnt in k:
o := pout[k]
if o != zero: pg[k] = pg[k] + pd[k] * half / o end
end
else op == _OP_SQUARE:
two := 2.0 as f32
repeat cnt in k: pg[k] = pg[k] + pd[k] * two * pin[k] end
else op == _OP_SILU:
repeat cnt in k:
x := pin[k]
s := one / (one + expf(zero - x))
pg[k] = pg[k] + pd[k] * s * (one + x * (one - s))
end
else:
p := f0 as f32
pm1 := (f0 - 1.0) as f32
repeat cnt in k: pg[k] = pg[k] + pd[k] * p * powf(pin[k], pm1) end
end
end
func _bk_matmul(tp &: Tape, n &: Node, dc &: tensor.Tensor):
if tp.needs.get(n.a):
vb := Value(tp, n.b)
mut tb := tensor.Transpose2D(vb)
mut ga := _grad_of(tp, n.a)
tensor.MatMulAcc(dc, tb, ga)
tb.free()
end
if tp.needs.get(n.b):
va := Value(tp, n.a)
mut ta := tensor.Transpose2D(va)
mut gb := _grad_of(tp, n.b)
tensor.MatMulAcc(ta, dc, gb)
ta.free()
end
end
func _bk_sum_axis(tp &: Tape, n &: Node, dc &: tensor.Tensor, mean: bool):
if tp.needs.get(n.a) == false: ret end
va := Value(tp, n.a)
g := _grad_of(tp, n.a)
axis := n.s0
cnt := va.shape.get(axis)
mut outer := 1
repeat axis in i: outer = outer * va.shape.get(i) end
inner := va.numel() / (outer * cnt)
pg := g.data.data
pd := dc.data.data
mut scale := 1.0 as f32
if mean: scale = (1.0 / (cnt as f64)) as f32 end
repeat outer in o:
dbase := o * inner
repeat cnt in i:
gbase := (o * cnt + i) * inner
repeat inner in k: pg[gbase + k] = pg[gbase + k] + scale * pd[dbase + k] end
end
end
end
func _bk_softmax(tp &: Tape, n &: Node, dc &: tensor.Tensor, logform: bool):
if tp.needs.get(n.a) == false: ret end
vo := Value(tp, n.out)
g := _grad_of(tp, n.a)
width := vo.shape.get(vo.rank() - 1)
rows := vo.numel() / width
pg := g.data.data
pd := dc.data.data
po := vo.data.data
repeat rows in r:
base := r * width
if logform:
mut s := 0.0 as f32
repeat width in k: s += pd[base + k] end
repeat width in k:
pg[base + k] = pg[base + k] + pd[base + k] - expf(po[base + k]) * s
end
else:
mut s := 0.0 as f32
repeat width in k: s += pd[base + k] * po[base + k] end
repeat width in k:
pg[base + k] = pg[base + k] + po[base + k] * (pd[base + k] - s)
end
end
end
end
func _bk_celoss(tp &: Tape, n &: Node, dc &: tensor.Tensor):
if tp.needs.get(n.a) == false: ret end
vl := Value(tp, n.a)
idx := Value(tp, n.aux)
g := _grad_of(tp, n.a)
width := vl.shape.get(vl.rank() - 1)
rows := vl.numel() / width
p := vl.data.data
pi := idx.data.data
pg := g.data.data
scale := (dc.at(0) / (rows as f64)) as f32
one := 1.0 as f32
repeat rows in r:
base := r * width
mut m := p[base]
repeat width in k:
v := p[base + k]
if v > m: m = v end
end
mut s := 0.0 as f32
repeat width in k: s += expf(p[base + k] - m) end
inv := one / s
t := pi[r] as int
repeat width in k:
mut sm := expf(p[base + k] - m) * inv
if k == t: sm = sm - one end
pg[base + k] = pg[base + k] + scale * sm
end
end
end
func _bk_bcewl(tp &: Tape, n &: Node, dc &: tensor.Tensor):
vl := Value(tp, n.a)
vt := Value(tp, n.b)
cnt := vl.numel()
scale := (dc.at(0) / (cnt as f64)) as f32
one := 1.0 as f32
zero := 0.0 as f32
p := vl.data.data
q := vt.data.data
if tp.needs.get(n.a):
g := _grad_of(tp, n.a)
pg := g.data.data
repeat cnt in k:
sg := one / (one + expf(zero - p[k]))
pg[k] = pg[k] + scale * (sg - q[k])
end
end
if tp.needs.get(n.b):
g := _grad_of(tp, n.b)
pg := g.data.data
repeat cnt in k:
pg[k] = pg[k] - scale * p[k]
end
end
end
func _bk_transpose2d(tp &: Tape, n &: Node, dc &: tensor.Tensor):
if tp.needs.get(n.a) == false: ret end
mut t := tensor.Transpose2D(dc)
g := _grad_of(tp, n.a)
_bk_flat_add(g.data.data, t.data.data, t.numel())
t.free()
end
func _backprop_node(tp &: Tape, n: Node):
mut dc := tp.grads.get(n.out)
if n.op == _OP_ADD:
_acc_reduced(tp, n.a, dc)
_acc_reduced(tp, n.b, dc)
else n.op == _OP_SUB:
_acc_reduced(tp, n.a, dc)
if tp.needs.get(n.b):
mut t := tensor.Neg(dc)
_acc_reduced(tp, n.b, t)
t.free()
end
else n.op == _OP_MUL:
_bk_mul(tp, n, dc)
else n.op == _OP_DIV:
_bk_div(tp, n, dc)
else n.op == _OP_MATMUL:
_bk_matmul(tp, n, dc)
else n.op == _OP_SUM:
if tp.needs.get(n.a):
mut g := _grad_of(tp, n.a)
tensor.AddScalarInPlace(g, dc.at(0))
end
else n.op == _OP_MEAN:
if tp.needs.get(n.a):
mut g := _grad_of(tp, n.a)
va := Value(tp, n.a)
tensor.AddScalarInPlace(g, dc.at(0) / (va.numel() as f64))
end
else n.op == _OP_SUMAXIS:
_bk_sum_axis(tp, n, dc, false)
else n.op == _OP_MEANAXIS:
_bk_sum_axis(tp, n, dc, true)
else n.op == _OP_SOFTMAX:
_bk_softmax(tp, n, dc, false)
else n.op == _OP_LOGSOFTMAX:
_bk_softmax(tp, n, dc, true)
else n.op == _OP_RESHAPE:
if tp.needs.get(n.a):
g := _grad_of(tp, n.a)
_bk_flat_add(g.data.data, dc.data.data, dc.numel())
end
else n.op == _OP_TRANSPOSE2D:
_bk_transpose2d(tp, n, dc)
else n.op == _OP_CELOSS:
_bk_celoss(tp, n, dc)
else n.op == _OP_BCEWL:
_bk_bcewl(tp, n, dc)
else n.op == _OP_CONV2D:
_bk_conv2d(tp, n, dc)
else n.op == _OP_MAXPOOL:
_bk_maxpool(tp, n, dc)
else n.op == _OP_AVGPOOL:
_bk_avgpool(tp, n, dc)
else n.op == _OP_BMM:
_bk_bmm(tp, n, dc)
else n.op == _OP_PERMUTE:
_bk_permute(tp, n, dc)
else n.op == _OP_EMBED:
_bk_embed(tp, n, dc)
else n.op == _OP_DROPOUT:
_bk_dropout(tp, n, dc)
else n.op == _OP_LAYERNORM:
_bk_layernorm(tp, n, dc)
else n.op == _OP_NARROW:
_bk_narrow(tp, n, dc)
else n.op == _OP_CONCAT2:
_bk_concat2(tp, n, dc)
else n.op == _OP_ROPE:
_bk_rope(tp, n, dc)
else n.op == _OP_RMSNORM:
_bk_rmsnorm(tp, n, dc)
else n.op == _OP_BATCHNORM:
_bk_batchnorm(tp, n, dc)
else n.op == _OP_GROUPNORM:
_bk_groupnorm(tp, n, dc)
else:
if tp.needs.get(n.a):
va := Value(tp, n.a)
vo := Value(tp, n.out)
g := _grad_of(tp, n.a)
_bk_unary(n.op, va.data.data, vo.data.data, dc.data.data, g.data.data, va.numel(), n.f0)
end
end
end
package autograd
import tensor
inline func _off(p: f32*, off: int): f32*:
ret (p as i64 + (off as i64) * (sizeof(f32) as i64)) as f32*
end
func _bk_conv2d(tp &: Tape, n &: Node, dc &: tensor.Tensor):
vx := Value(tp, n.a)
vw := Value(tp, n.b)
sh := n.s0 / 256
sw := n.s0 % 256
ph := n.s1 / 256
pw := n.s1 % 256
batch := vx.shape.get(0)
c := vx.shape.get(1)
h := vx.shape.get(2)
wd := vx.shape.get(3)
oc := vw.shape.get(0)
kh := vw.shape.get(2)
kw := vw.shape.get(3)
oh := tensor.ConvOutSize(h, kh, sh, ph)
ow := tensor.ConvOutSize(wd, kw, sw, pw)
kdim := c * kh * kw
p := oh * ow
pd := dc.data.data
need_x := tp.needs.get(n.a)
need_w := tp.needs.get(n.b)
mut wt := tensor.Empty()
if need_x: wt = tensor.TransposeRaw(vw.data.data, oc, kdim) end
mut dcols := tensor.Empty()
if need_x: dcols = tensor.Zeros2(kdim, p) end
repeat batch in i:
doff := i * oc * p
if need_w:
mut cols := tensor.Im2Col(vx, i, kh, kw, sh, sw, ph, pw)
mut colst := tensor.Transpose2D(cols)
gw := _grad_of(tp, n.b)
tensor.GemmAcc(_off(pd, doff), colst.data.data, gw.data.data, oc, p, kdim)
cols.free()
colst.free()
end
if need_x:
zp := dcols.data.data
zero := 0.0 as f32
repeat kdim * p in z: zp[z] = zero end
tensor.GemmAcc(wt.data.data, _off(pd, doff), zp, kdim, oc, p)
mut gx := _grad_of(tp, n.a)
tensor.Col2ImAcc(dcols, gx, i, kh, kw, sh, sw, ph, pw)
end
end
if need_x:
wt.free()
dcols.free()
end
if n.aux >= 0 and tp.needs.get(n.aux):
gb := _grad_of(tp, n.aux)
pg := gb.data.data
repeat batch in i:
sbase := i * oc * p
repeat oc in o:
obase := sbase + o * p
mut s := 0.0 as f32
repeat p in k: s += pd[obase + k] end
pg[o] = pg[o] + s
end
end
end
end
func _bk_maxpool(tp &: Tape, n &: Node, dc &: tensor.Tensor):
if tp.needs.get(n.a) == false: ret end
vx := Value(tp, n.a)
am := Value(tp, n.aux)
g := _grad_of(tp, n.a)
h := vx.shape.get(2)
w := vx.shape.get(3)
planes := vx.shape.get(0) * vx.shape.get(1)
op := am.numel() / planes
pg := g.data.data
pd := dc.data.data
pa := am.data.data
repeat planes in pl:
ibase := pl * h * w
obase := pl * op
repeat op in k:
idx := pa[obase + k] as int
pg[ibase + idx] = pg[ibase + idx] + pd[obase + k]
end
end
end
func _bk_avgpool(tp &: Tape, n &: Node, dc &: tensor.Tensor):
if tp.needs.get(n.a) == false: ret end
vx := Value(tp, n.a)
vo := Value(tp, n.out)
g := _grad_of(tp, n.a)
kh := n.s0 / 256
kw := n.s0 % 256
sh := n.s1 / 256
sw := n.s1 % 256
h := vx.shape.get(2)
w := vx.shape.get(3)
oh := vo.shape.get(2)
ow := vo.shape.get(3)
planes := vx.shape.get(0) * vx.shape.get(1)
pg := g.data.data
pd := dc.data.data
repeat planes in pl:
ibase := pl * h * w
obase := pl * oh * ow
repeat oh in oi:
repeat ow in oj:
mut cnt := 0
repeat kh in ki:
if oi * sh + ki < h:
repeat kw in kj:
if oj * sw + kj < w: cnt += 1 end
end
end
end
share := pd[obase + oi * ow + oj] / (cnt as f32)
repeat kh in ki:
ii := oi * sh + ki
if ii < h:
repeat kw in kj:
jj := oj * sw + kj
if jj < w:
pg[ibase + ii * w + jj] = pg[ibase + ii * w + jj] + share
end
end
end
end
end
end
end
end
@en "Conv2D"
@fa "پیچش دوبعدی"
pub func Conv2D(tp &: Tape, x: int, w: int, b: int, sh: int, sw: int, ph: int, pw: int): int:
vx := Value(tp, x)
vw := Value(tp, w)
mut vb := tensor.Empty()
if b >= 0: vb = Value(tp, b) end
out := tensor.Conv2DForward(vx, vw, vb, sh, sw, ph, pw)
mut needs_grad := tp.needs.get(x) or tp.needs.get(w)
if b >= 0 and tp.needs.get(b): needs_grad = true end
id := _push_val(tp, out, true, needs_grad)
if needs_grad:
_record(tp, _OP_CONV2D, x, w, id, b, sh * 256 + sw, ph * 256 + pw, 0.0)
end
ret id
end
@en "MaxPool2D"
@fa "بیشینه‌گیری دوبعدی"
pub func MaxPool2D(tp &: Tape, x: int, kh: int, kw: int, sh: int, sw: int): int:
vx := Value(tp, x)
mut am := tensor.Empty()
out := tensor.MaxPool2DForward(vx, kh, kw, sh, sw, am)
needs_grad := tp.needs.get(x)
aux := _push_val(tp, am, true, false)
id := _push_val(tp, out, true, needs_grad)
if needs_grad:
_record(tp, _OP_MAXPOOL, x, 0 - 1, id, aux, kh * 256 + kw, sh * 256 + sw, 0.0)
end
ret id
end
@en "AvgPool2D"
@fa "میانگین‌گیری دوبعدی"
pub func AvgPool2D(tp &: Tape, x: int, kh: int, kw: int, sh: int, sw: int): int:
vx := Value(tp, x)
out := tensor.AvgPool2DForward(vx, kh, kw, sh, sw)
needs_grad := tp.needs.get(x)
id := _push_val(tp, out, true, needs_grad)
if needs_grad:
_record(tp, _OP_AVGPOOL, x, 0 - 1, id, 0 - 1, kh * 256 + kw, sh * 256 + sw, 0.0)
end
ret id
end
package autograd
import math
import tensor
func _ce_forward(logits &: tensor.Tensor, idx &: tensor.Tensor): f64:
width := logits.shape.get(logits.rank() - 1)
rows := logits.numel() / width
p := logits.data.data
pi := idx.data.data
mut total := 0.0
repeat rows in r:
base := r * width
mut m := p[base]
repeat width in k:
v := p[base + k]
if v > m: m = v end
end
mut s := 0.0
repeat width in k: s += math.Exp((p[base + k] - m) as f64) end
t := pi[r] as int
total += (math.Log(s) + (m as f64)) - (p[base + t] as f64)
end
ret total / (rows as f64)
end
@en "MSELoss"
@fa "خطای میانگین مربعات"
pub func MSELoss(tp &: Tape, pred: int, target: int): int:
ret Mean(tp, Square(tp, Sub(tp, pred, target)))
end
@en "CrossEntropyLogits"
@fa "آنتروپی متقاطع لوجیت"
pub func CrossEntropyLogits(tp &: Tape, logits: int, targets &: Vector<int>): int:
vl := Value(tp, logits)
if vl.is_empty() or vl.rank() < 2: ret _push_val(tp, tensor.Empty(), true, false) end
width := vl.shape.get(vl.rank() - 1)
rows := vl.numel() / width
if targets.len() != rows: ret _push_val(tp, tensor.Empty(), true, false) end
ti := tensor.Zeros1(rows)
pt := ti.data.data
repeat rows in r: pt[r] = targets.get(r) as f32 end
aux := _push_val(tp, ti, true, false)
tv := Value(tp, aux)
out := tensor.Scalar(_ce_forward(vl, tv))
needs_grad := tp.needs.get(logits)
id := _push_val(tp, out, true, needs_grad)
if needs_grad: _record(tp, _OP_CELOSS, logits, 0 - 1, id, aux, 0, 0, 0.0) end
ret id
end
@en "BCEWithLogits"
@fa "آنتروپی دودویی لوجیت"
pub func BCEWithLogits(tp &: Tape, logits: int, target: int): int:
vl := Value(tp, logits)
vt := Value(tp, target)
if vl.is_empty() or vl.same_shape(vt) == false:
ret _push_val(tp, tensor.Empty(), true, false)
end
n := vl.numel()
p := vl.data.data
q := vt.data.data
mut total := 0.0
repeat n in k:
x := p[k] as f64
y := q[k] as f64
mut mx := x
if mx < 0.0: mx = 0.0 end
mut ax := x
if ax < 0.0: ax = 0.0 - ax end
total += mx - x * y + math.Log(1.0 + math.Exp(0.0 - ax))
end
out := tensor.Scalar(total / (n as f64))
needs_grad := tp.needs.get(logits) or tp.needs.get(target)
id := _push_val(tp, out, true, needs_grad)
if needs_grad: _record(tp, _OP_BCEWL, logits, target, id, 0 - 1, 0, 0, 0.0) end
ret id
end
package autograd
import tensor
extern:
pure func sqrtf(x: f32): f32
end
func _bk_layernorm(tp &: Tape, n &: Node, dc &: tensor.Tensor):
vx := Value(tp, n.a)
vg := Value(tp, n.b)
st := Value(tp, n.aux)
beta := n.s0
d := vx.shape.get(vx.rank() - 1)
rows := vx.numel() / d
px := vx.data.data
pgam := vg.data.data
ps := st.data.data
pd := dc.data.data
need_x := tp.needs.get(n.a)
need_g := tp.needs.get(n.b)
need_b := tp.needs.get(beta)
mut gx := tensor.Empty()
mut gg := tensor.Empty()
mut gb := tensor.Empty()
if need_x: gx = _grad_of(tp, n.a) end
if need_g: gg = _grad_of(tp, n.b) end
if need_b: gb = _grad_of(tp, beta) end
pgx := gx.data.data
pgg := gg.data.data
pgb := gb.data.data
inv_d := (1.0 / (d as f64)) as f32
repeat rows in r:
base := r * d
mean := ps[r * 2]
rstd := ps[r * 2 + 1]
mut s1 := 0.0 as f32
mut s2 := 0.0 as f32
repeat d in k:
xhat := (px[base + k] - mean) * rstd
dxhat := pd[base + k] * pgam[k]
s1 += dxhat
s2 += dxhat * xhat
if need_g: pgg[k] = pgg[k] + pd[base + k] * xhat end
if need_b: pgb[k] = pgb[k] + pd[base + k] end
end
if need_x:
m1 := s1 * inv_d
m2 := s2 * inv_d
repeat d in k:
xhat := (px[base + k] - mean) * rstd
dxhat := pd[base + k] * pgam[k]
pgx[base + k] = pgx[base + k] + rstd * (dxhat - m1 - xhat * m2)
end
end
end
end
func _bk_rmsnorm(tp &: Tape, n &: Node, dc &: tensor.Tensor):
vx := Value(tp, n.a)
vg := Value(tp, n.b)
st := Value(tp, n.aux)
d := vx.shape.get(vx.rank() - 1)
rows := vx.numel() / d
px := vx.data.data
pgam := vg.data.data
ps := st.data.data
pd := dc.data.data
need_x := tp.needs.get(n.a)
need_g := tp.needs.get(n.b)
mut gx := tensor.Empty()
mut gg := tensor.Empty()
if need_x: gx = _grad_of(tp, n.a) end
if need_g: gg = _grad_of(tp, n.b) end
pgx := gx.data.data
pgg := gg.data.data
inv_d := (1.0 / (d as f64)) as f32
repeat rows in r:
base := r * d
rs := ps[r]
mut s2 := 0.0 as f32
repeat d in k:
xhat := px[base + k] * rs
dxhat := pd[base + k] * pgam[k]
s2 += dxhat * xhat
if need_g: pgg[k] = pgg[k] + pd[base + k] * xhat end
end
if need_x:
m2 := s2 * inv_d
repeat d in k:
xhat := px[base + k] * rs
dxhat := pd[base + k] * pgam[k]
pgx[base + k] = pgx[base + k] + rs * (dxhat - xhat * m2)
end
end
end
end
func _bk_batchnorm(tp &: Tape, n &: Node, dc &: tensor.Tensor):
vx := Value(tp, n.a)
vg := Value(tp, n.b)
st := Value(tp, n.aux)
beta := n.s0
inference := n.s1 == 1
nb := vx.shape.get(0)
c := vx.shape.get(1)
inner := vx.numel() / (nb * c)
cnt := nb * inner
px := vx.data.data
pgam := vg.data.data
ps := st.data.data
pd := dc.data.data
need_x := tp.needs.get(n.a)
need_g := tp.needs.get(n.b)
need_b := tp.needs.get(beta)
mut gx := tensor.Empty()
mut gg := tensor.Empty()
mut gb := tensor.Empty()
if need_x: gx = _grad_of(tp, n.a) end
if need_g: gg = _grad_of(tp, n.b) end
if need_b: gb = _grad_of(tp, beta) end
pgx := gx.data.data
pgg := gg.data.data
pgb := gb.data.data
inv_cnt := (1.0 / (cnt as f64)) as f32
repeat c in ch:
mean := ps[ch * 2]
rstd := ps[ch * 2 + 1]
gamma := pgam[ch]
mut s1 := 0.0 as f32
mut s2 := 0.0 as f32
repeat nb in i:
base := (i * c + ch) * inner
repeat inner in k:
xhat := (px[base + k] - mean) * rstd
dy := pd[base + k]
s1 += dy
s2 += dy * xhat
end
end
if need_g: pgg[ch] = pgg[ch] + s2 end
if need_b: pgb[ch] = pgb[ch] + s1 end
if need_x:
m1 := s1 * gamma * inv_cnt
m2 := s2 * gamma * inv_cnt
repeat nb in i:
base := (i * c + ch) * inner
repeat inner in k:
dxhat := pd[base + k] * gamma
if inference:
pgx[base + k] = pgx[base + k] + rstd * dxhat
else:
xhat := (px[base + k] - mean) * rstd
pgx[base + k] = pgx[base + k] + rstd * (dxhat - m1 - xhat * m2)
end
end
end
end
end
end
func _bk_groupnorm(tp &: Tape, n &: Node, dc &: tensor.Tensor):
vx := Value(tp, n.a)
vg := Value(tp, n.b)
st := Value(tp, n.aux)
beta := n.s0
groups := n.s1
nb := vx.shape.get(0)
c := vx.shape.get(1)
inner := vx.numel() / (nb * c)
cpg := c / groups
m := cpg * inner
px := vx.data.data
pgam := vg.data.data
ps := st.data.data
pd := dc.data.data
need_x := tp.needs.get(n.a)
need_g := tp.needs.get(n.b)
need_b := tp.needs.get(beta)
mut gx := tensor.Empty()
mut gg := tensor.Empty()
mut gb := tensor.Empty()
if need_x: gx = _grad_of(tp, n.a) end
if need_g: gg = _grad_of(tp, n.b) end
if need_b: gb = _grad_of(tp, beta) end
pgx := gx.data.data
pgg := gg.data.data
pgb := gb.data.data
inv_m := (1.0 / (m as f64)) as f32
repeat nb in bi:
repeat groups in g:
mean := ps[(bi * groups + g) * 2]
rstd := ps[(bi * groups + g) * 2 + 1]
mut s1 := 0.0 as f32
mut s2 := 0.0 as f32
repeat cpg in cc:
ch := g * cpg + cc
base := (bi * c + ch) * inner
repeat inner in s:
xhat := (px[base + s] - mean) * rstd
dxhat := pd[base + s] * pgam[ch]
s1 += dxhat
s2 += dxhat * xhat
if need_g: pgg[ch] = pgg[ch] + pd[base + s] * xhat end
if need_b: pgb[ch] = pgb[ch] + pd[base + s] end
end
end
if need_x:
m1 := s1 * inv_m
m2 := s2 * inv_m
repeat cpg in cc:
ch := g * cpg + cc
base := (bi * c + ch) * inner
repeat inner in s:
xhat := (px[base + s] - mean) * rstd
dxhat := pd[base + s] * pgam[ch]
pgx[base + s] = pgx[base + s] + rstd * (dxhat - m1 - xhat * m2)
end
end
end
end
end
end
@en "LayerNorm"
@fa "نرمال‌سازی لایه"
pub func LayerNorm(tp &: Tape, x: int, gamma: int, beta: int, eps: f64): int:
vx := Value(tp, x)
vg := Value(tp, gamma)
vb := Value(tp, beta)
if vx.is_empty(): ret _push_val(tp, tensor.Empty(), true, false) end
d := vx.shape.get(vx.rank() - 1)
if vg.numel() != d or vb.numel() != d: ret _push_val(tp, tensor.Empty(), true, false) end
rows := vx.numel() / d
out := tensor.Zeros(vx.shape)
st := tensor.Zeros2(rows, 2)
px := vx.data.data
pg := vg.data.data
pb := vb.data.data
po := out.data.data
ps := st.data.data
ef := eps as f32
inv_d := (1.0 / (d as f64)) as f32
one := 1.0 as f32
repeat rows in r:
base := r * d
mut s := 0.0 as f32
repeat d in k: s += px[base + k] end
mean := s * inv_d
mut v := 0.0 as f32
repeat d in k:
dlt := px[base + k] - mean
v += dlt * dlt
end
rstd := one / sqrtf(v * inv_d + ef)
ps[r * 2] = mean
ps[r * 2 + 1] = rstd
repeat d in k:
po[base + k] = pg[k] * ((px[base + k] - mean) * rstd) + pb[k]
end
end
needs_grad := tp.needs.get(x) or tp.needs.get(gamma) or tp.needs.get(beta)
aux := _push_val(tp, st, true, false)
id := _push_val(tp, out, true, needs_grad)
if needs_grad: _record(tp, _OP_LAYERNORM, x, gamma, id, aux, beta, 0, eps) end
ret id
end
@en "RMSNorm"
@fa "نرمال‌سازی جذر میانگین مربعات"
pub func RMSNorm(tp &: Tape, x: int, gamma: int, eps: f64): int:
vx := Value(tp, x)
vg := Value(tp, gamma)
if vx.is_empty(): ret _push_val(tp, tensor.Empty(), true, false) end
d := vx.shape.get(vx.rank() - 1)
if vg.numel() != d: ret _push_val(tp, tensor.Empty(), true, false) end
rows := vx.numel() / d
out := tensor.Zeros(vx.shape)
st := tensor.Zeros1(rows)
px := vx.data.data
pg := vg.data.data
po := out.data.data
ps := st.data.data
ef := eps as f32
inv_d := (1.0 / (d as f64)) as f32
one := 1.0 as f32
repeat rows in r:
base := r * d
mut s := 0.0 as f32
repeat d in k: s += px[base + k] * px[base + k] end
rs := one / sqrtf(s * inv_d + ef)
ps[r] = rs
repeat d in k: po[base + k] = pg[k] * px[base + k] * rs end
end
needs_grad := tp.needs.get(x) or tp.needs.get(gamma)
aux := _push_val(tp, st, true, false)
id := _push_val(tp, out, true, needs_grad)
if needs_grad: _record(tp, _OP_RMSNORM, x, gamma, id, aux, 0, 0, eps) end
ret id
end
@en "BatchNorm"
@fa "نرمال‌سازی دسته"
pub func BatchNorm(tp &: Tape, x: int, gamma: int, beta: int, running_mean &: tensor.Tensor, running_var &: tensor.Tensor, momentum: f64, eps: f64): int:
vx := Value(tp, x)
vg := Value(tp, gamma)
vb := Value(tp, beta)
if vx.rank() != 2 and vx.rank() != 4: ret _push_val(tp, tensor.Empty(), true, false) end
nb := vx.shape.get(0)
c := vx.shape.get(1)
if vg.numel() != c or vb.numel() != c or running_mean.numel() != c or running_var.numel() != c:
ret _push_val(tp, tensor.Empty(), true, false)
end
inner := vx.numel() / (nb * c)
cnt := nb * inner
out := tensor.Zeros(vx.shape)
st := tensor.Zeros2(c, 2)
px := vx.data.data
pg := vg.data.data
pb := vb.data.data
po := out.data.data
ps := st.data.data
prm := running_mean.data.data
prv := running_var.data.data
ef := eps as f32
one := 1.0 as f32
mom := momentum as f32
inv_cnt := (1.0 / (cnt as f64)) as f32
repeat c in ch:
mut mean := 0.0 as f32
mut var := 0.0 as f32
if tp.training:
mut s := 0.0 as f32
repeat nb in i:
base := (i * c + ch) * inner
repeat inner in k: s += px[base + k] end
end
mean = s * inv_cnt
mut v := 0.0 as f32
repeat nb in i:
base := (i * c + ch) * inner
repeat inner in k:
dlt := px[base + k] - mean
v += dlt * dlt
end
end
var = v * inv_cnt
mut unbiased := var
if cnt > 1: unbiased = v / ((cnt - 1) as f32) end
prm[ch] = (one - mom) * prm[ch] + mom * mean
prv[ch] = (one - mom) * prv[ch] + mom * unbiased
else:
mean = prm[ch]
var = prv[ch]
end
rstd := one / sqrtf(var + ef)
ps[ch * 2] = mean
ps[ch * 2 + 1] = rstd
repeat nb in i:
base := (i * c + ch) * inner
repeat inner in k: po[base + k] = pg[ch] * ((px[base + k] - mean) * rstd) + pb[ch] end
end
end
needs_grad := tp.needs.get(x) or tp.needs.get(gamma) or tp.needs.get(beta)
aux := _push_val(tp, st, true, false)
id := _push_val(tp, out, true, needs_grad)
mut mode := 0
if tp.training == false: mode = 1 end
if needs_grad: _record(tp, _OP_BATCHNORM, x, gamma, id, aux, beta, mode, eps) end
ret id
end
@en "GroupNorm"
@fa "نرمال‌سازی گروهی"
pub func GroupNorm(tp &: Tape, x: int, gamma: int, beta: int, groups: int, eps: f64): int:
vx := Value(tp, x)
vg := Value(tp, gamma)
vb := Value(tp, beta)
if vx.rank() < 2 or groups < 1: ret _push_val(tp, tensor.Empty(), true, false) end
nb := vx.shape.get(0)
c := vx.shape.get(1)
if c % groups != 0 or vg.numel() != c or vb.numel() != c:
ret _push_val(tp, tensor.Empty(), true, false)
end
inner := vx.numel() / (nb * c)
cpg := c / groups
m := cpg * inner
out := tensor.Zeros(vx.shape)
st := tensor.Zeros2(nb * groups, 2)
px := vx.data.data
pg := vg.data.data
pb := vb.data.data
po := out.data.data
ps := st.data.data
ef := eps as f32
inv_m := (1.0 / (m as f64)) as f32
one := 1.0 as f32
repeat nb in bi:
repeat groups in g:
mut sum := 0.0 as f32
repeat cpg in cc:
base := (bi * c + g * cpg + cc) * inner
repeat inner in s: sum += px[base + s] end
end
mean := sum * inv_m
mut var := 0.0 as f32
repeat cpg in cc:
base := (bi * c + g * cpg + cc) * inner
repeat inner in s:
dlt := px[base + s] - mean
var += dlt * dlt
end
end
rstd := one / sqrtf(var * inv_m + ef)
ps[(bi * groups + g) * 2] = mean
ps[(bi * groups + g) * 2 + 1] = rstd
repeat cpg in cc:
ch := g * cpg + cc
base := (bi * c + ch) * inner
repeat inner in s:
po[base + s] = pg[ch] * ((px[base + s] - mean) * rstd) + pb[ch]
end
end
end
end
needs_grad := tp.needs.get(x) or tp.needs.get(gamma) or tp.needs.get(beta)
aux := _push_val(tp, st, true, false)
id := _push_val(tp, out, true, needs_grad)
if needs_grad: _record(tp, _OP_GROUPNORM, x, gamma, id, aux, beta, groups, eps) end
ret id
end
package autograd
import tensor
func _bin_op(tp &: Tape, op: int, a: int, b: int): int:
va := Value(tp, a)
vb := Value(tp, b)
mut out := tensor.Empty()
if op == _OP_ADD:
out = tensor.Add(va, vb)
else op == _OP_SUB:
out = tensor.Sub(va, vb)
else op == _OP_MUL:
out = tensor.Mul(va, vb)
else:
out = tensor.Div(va, vb)
end
needs_grad := tp.needs.get(a) or tp.needs.get(b)
id := _push_val(tp, out, true, needs_grad)
if needs_grad: _record(tp, op, a, b, id, 0 - 1, 0, 0, 0.0) end
ret id
end
func _un_op(tp &: Tape, op: int, a: int, f0: f64): int:
va := Value(tp, a)
mut out := tensor.Empty()
if op == _OP_NEG:
out = tensor.Neg(va)
else op == _OP_SCALE:
out = tensor.Scale(va, f0)
else op == _OP_ADDS:
out = tensor.AddScalar(va, f0)
else op == _OP_EXP:
out = tensor.Exp(va)
else op == _OP_LOG:
out = tensor.Log(va)
else op == _OP_TANH:
out = tensor.Tanh(va)
else op == _OP_SIGMOID:
out = tensor.Sigmoid(va)
else op == _OP_RELU:
out = tensor.Relu(va)
else op == _OP_GELU:
out = tensor.Gelu(va)
else op == _OP_SQRT:
out = tensor.Sqrt(va)
else op == _OP_SQUARE:
out = tensor.Square(va)
else op == _OP_SILU:
out = tensor.Silu(va)
else:
out = tensor.PowScalar(va, f0)
end
needs_grad := tp.needs.get(a)
id := _push_val(tp, out, true, needs_grad)
if needs_grad: _record(tp, op, a, 0 - 1, id, 0 - 1, 0, 0, f0) end
ret id
end
@en "Add"
@fa "جمع"
pub func Add(tp &: Tape, a: int, b: int): int: ret _bin_op(tp, _OP_ADD, a, b) end
@en "Sub"
@fa "تفریق"
pub func Sub(tp &: Tape, a: int, b: int): int: ret _bin_op(tp, _OP_SUB, a, b) end
@en "Mul"
@fa "ضرب درایه‌ای"
pub func Mul(tp &: Tape, a: int, b: int): int: ret _bin_op(tp, _OP_MUL, a, b) end
@en "Div"
@fa "تقسیم درایه‌ای"
pub func Div(tp &: Tape, a: int, b: int): int: ret _bin_op(tp, _OP_DIV, a, b) end
@en "Neg"
@fa "قرینه"
pub func Neg(tp &: Tape, a: int): int: ret _un_op(tp, _OP_NEG, a, 0.0) end
@en "Scale"
@fa "مقیاس"
pub func Scale(tp &: Tape, a: int, s: f64): int: ret _un_op(tp, _OP_SCALE, a, s) end
@en "AddScalar"
@fa "جمع با عدد"
pub func AddScalar(tp &: Tape, a: int, s: f64): int: ret _un_op(tp, _OP_ADDS, a, s) end
@en "Exp"
@fa "نمایی"
pub func Exp(tp &: Tape, a: int): int: ret _un_op(tp, _OP_EXP, a, 0.0) end
@en "Log"
@fa "لگاریتم"
pub func Log(tp &: Tape, a: int): int: ret _un_op(tp, _OP_LOG, a, 0.0) end
@en "Tanh"
@fa "تانژانت هذلولی"
pub func Tanh(tp &: Tape, a: int): int: ret _un_op(tp, _OP_TANH, a, 0.0) end
@en "Sigmoid"
@fa "سیگموئید"
pub func Sigmoid(tp &: Tape, a: int): int: ret _un_op(tp, _OP_SIGMOID, a, 0.0) end
@en "Relu"
@fa "یکسوساز"
pub func Relu(tp &: Tape, a: int): int: ret _un_op(tp, _OP_RELU, a, 0.0) end
@en "Gelu"
@fa "گلو"
pub func Gelu(tp &: Tape, a: int): int: ret _un_op(tp, _OP_GELU, a, 0.0) end
@en "Sqrt"
@fa "ریشه دوم"
pub func Sqrt(tp &: Tape, a: int): int: ret _un_op(tp, _OP_SQRT, a, 0.0) end
@en "Square"
@fa "مربع"
pub func Square(tp &: Tape, a: int): int: ret _un_op(tp, _OP_SQUARE, a, 0.0) end
@en "PowScalar"
@fa "توان عددی"
pub func PowScalar(tp &: Tape, a: int, p: f64): int: ret _un_op(tp, _OP_POWS, a, p) end
@en "Silu"
@fa "سیلو"
pub func Silu(tp &: Tape, a: int): int: ret _un_op(tp, _OP_SILU, a, 0.0) end
@en "MatMul"
@fa "ضرب ماتریسی"
pub func MatMul(tp &: Tape, a: int, b: int): int:
va := Value(tp, a)
vb := Value(tp, b)
out := tensor.MatMul(va, vb)
needs_grad := tp.needs.get(a) or tp.needs.get(b)
id := _push_val(tp, out, true, needs_grad)
if needs_grad: _record(tp, _OP_MATMUL, a, b, id, 0 - 1, 0, 0, 0.0) end
ret id
end
@en "Sum"
@fa "مجموع"
pub func Sum(tp &: Tape, a: int): int:
va := Value(tp, a)
out := tensor.Scalar(tensor.SumAll(va))
needs_grad := tp.needs.get(a)
id := _push_val(tp, out, true, needs_grad)
if needs_grad: _record(tp, _OP_SUM, a, 0 - 1, id, 0 - 1, 0, 0, 0.0) end
ret id
end
@en "Mean"
@fa "میانگین"
pub func Mean(tp &: Tape, a: int): int:
