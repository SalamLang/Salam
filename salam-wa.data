end
@en "SetTimeout"
@fa "تنظیم زمان انتظار"
pub func SetTimeout(s: Socket, millis: int):
rawsock.SetTimeout(_sock(s), millis)
end
@en "JoinMulticast"
@fa "پیوستن به گروه پخش"
pub func JoinMulticast(s: Socket, group_ip: str): bool:
group := rawsock.ResolveAddr4Raw(group_ip)
if group == 0: ret false end
mreq := _make_mreq(group, 0)
defer mem.Free(mreq)
r := rawsock.SetOpt(_sock(s), 0, _mcast_optname(true), mreq, 8)
ret r == 0
end
@en "LeaveMulticast"
@fa "ترک گروه پخش"
pub func LeaveMulticast(s: Socket, group_ip: str): bool:
group := rawsock.ResolveAddr4Raw(group_ip)
if group == 0: ret false end
mreq := _make_mreq(group, 0)
defer mem.Free(mreq)
r := rawsock.SetOpt(_sock(s), 0, _mcast_optname(false), mreq, 8)
ret r == 0
end
@en "net/websocket"
@fa "وب‌سوکت"
package websocket
import net.internal.rawsock
import mem
import str
import rand
import encoding
import crypto
import tls
import time
const WS_GUID := "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"
@en "NONE"
@fa "هیچ"
pub const NONE := 0
@en "TEXT"
@fa "متن"
pub const TEXT := 1
@en "BINARY"
@fa "دودویی"
pub const BINARY := 2
@en "CLOSE"
@fa "بسته"
pub const CLOSE := 8
@en "PING"
@fa "پینگ"
pub const PING := 9
@en "PONG"
@fa "پونگ"
pub const PONG := 10
@en "TIMEOUT"
@fa "مهلت"
pub const TIMEOUT := 100
mut _tls_slots := Vector {} as Vector<tls.Conn>
mut _tls_free := Vector {} as Vector<int>
mut _wss_cfg := tls.ServerConfig {}
@en "Server"
@fa "سرور"
pub struct Server:
pub fd: i64 = 0 - 1
pub port: int = 0
end
@en "Conn"
@fa "اتصال وب"
pub struct Conn:
pub fd: i64 = 0 - 1
pub open: bool = false
pub path: str = ""
pub client: bool = false
pub buf: void* = null
pub blen: int = 0
pub bcap: int = 0
pub secure: bool = false
pub tls_idx: int = 0 - 1
pub hdr: str = ""
pub acc: str = ""
pub acc_kind: int = 0
pub fragmented: bool = false
pub bin: void* = null
pub binlen: int = 0
pub bincap: int = 0
end
@en "Message"
@fa "پیام"
pub struct Message:
pub kind: int = 0
pub text: str = ""
pub data: void* = null
pub len: int = 0
end
@en "RoomMembers"
@fa "اعضای اتاق"
pub struct RoomMembers:
pub items: Vector<Conn> = Vector {}
end
@en "Hub"
@fa "هاب"
pub struct Hub:
pub rooms: HashMap<str, RoomMembers> = HashMap {} as HashMap<str, RoomMembers>
end
func _tls_store(tc: tls.Conn): int:
if _tls_free.len() > 0:
idx := _tls_free.get(_tls_free.len() - 1)
_tls_free.remove_at(_tls_free.len() - 1)
_tls_slots.set(idx, tc)
ret idx
end
_tls_slots.push(tc)
ret _tls_slots.len() - 1
end
func _tls_release(idx: int):
if idx < 0 or idx >= _tls_slots.len():
ret
end
_tls_free.push(idx)
end
func _tls_get(idx: int): tls.Conn:
ret _tls_slots.get(idx)
end
func _tls_put(idx: int, tc: tls.Conn):
_tls_slots.set(idx, tc)
end
func _pow2(n: int): i64:
mut r := 1 as i64
repeat n:
r *= 2
end
ret r
end
func _xor8(a0: int, b0: int): int:
mut a := a0
mut b := b0
mut r := 0
mut p := 1
repeat 8:
if a % 2 != b % 2:
r += p
end
a /= 2
b /= 2
p *= 2
end
ret r
end
func _bget(p: void*, i: int): int:
bp := p as i8*
mut v := bp[i] as int
if v < 0:
v += 256
end
ret v
end
func _bput(p: void*, i: int, v: int):
bp := p as i8*
bp[i] = v as i8
end
func _copy_raw(buf: void*, off: int, payload: void*, n: int):
if n <= 0:
ret
end
mem.Copy(((buf as i64) + (off as i64)) as void*, payload, n as u64)
end
func _byte_at(s: str, i: int): int:
mut v := char_code(s.substr(i, 1))
if v < 0:
v += 256
end
ret v
end
func _no_delay(fd: i64):
if fd < 0:
ret
end
rawsock.SetNoDelay(rawsock.FromFd(fd), true)
end
func _new_conn(fd: i64, client: bool): Conn:
ret Conn { fd = fd, open = false, client = client, buf = mem.Allocate(4096 as u64), blen = 0, bcap = 4096 }
end
func _ensure(c &: Conn, need: int):
if need <= c.bcap:
ret
end
mut ncap := c.bcap * 2
if ncap < need:
ncap = need
end
nb := mem.Reallocate(c.buf, ncap as u64)
if nb != null:
c.buf = nb
c.bcap = ncap
end
end
func _fill(c &: Conn): int:
if c.bcap - c.blen < 1024:
_ensure(c, c.bcap + 4096)
end
space := c.bcap - c.blen
if space <= 0:
ret 0 - 1
end
dst := ((c.buf as i64) + (c.blen as i64)) as void*
mut n := 0
if c.secure:
mut tc := _tls_get(c.tls_idx)
n = tls.ReadBytes(tc, dst, space)
_tls_put(c.tls_idx, tc)
else:
n = rawsock.RecvBytes(rawsock.FromFd(c.fd), dst, space)
end
if n > 0:
c.blen += n
end
ret n
end
func _readable(c &: Conn, timeout_ms: int): bool:
if c.secure:
tc := _tls_get(c.tls_idx)
if tls.Readable(tc):
ret true
end
ret rawsock.WaitReadable(rawsock.FromFd(tls.Fd(tc)), timeout_ms)
end
if c.fd < 0:
ret false
end
ret rawsock.WaitReadable(rawsock.FromFd(c.fd), timeout_ms)
end
func _bin_ensure(c &: Conn, need: int):
if need <= c.bincap:
ret
end
mut ncap := c.bincap * 2
if ncap < need:
ncap = need
end
if ncap < 1024:
ncap = 1024
end
mut nb := null as void*
if c.bin == null:
nb = mem.Allocate(ncap as u64)
else:
nb = mem.Reallocate(c.bin, ncap as u64)
end
if nb != null:
c.bin = nb
c.bincap = ncap
end
end
func _bin_reset(c &: Conn):
c.binlen = 0
end
func _bin_append(c &: Conn, off: int, plen: int, masked: bool, moff: int):
if plen <= 0:
ret
end
_bin_ensure(c, c.binlen + plen)
if c.bincap < c.binlen + plen:
ret
end
dst := ((c.bin as i64) + (c.binlen as i64)) as i8*
repeat plen in i:
mut b := _bget(c.buf, off + i)
if masked:
b = _xor8(b, _bget(c.buf, moff + (i % 4)))
end
dst[i] = b as i8
end
c.binlen += plen
end
func _dial_wss(host: str, port: int, path: str, extra: str, insecure: bool): Conn:
mut cfg := tls.NewConfig(host)
cfg.insecure_skip_verify = insecure
mut tc := tls.Dial(host, port, cfg)
mut c := _new_conn(0 - 1, true)
c.secure = true
c.tls_idx = _tls_store(tc)
if not tls.ConnOk(tc):
c.open = false
ret c
end
key := encoding.Base64Encode(rand.Alnum(16))
req := HandshakeRequestWith(host, path, key, extra)
n := tls.Write(tc, req)
_tls_put(c.tls_idx, tc)
if n <= 0:
_shutdown(c)
ret c
end
hdr := _read_headers(c)
c.hdr = hdr
if not str.Contains(hdr, " 101 "):
_shutdown(c)
ret c
end
if not str.Contains(hdr, AcceptKey(key)):
_shutdown(c)
ret c
end
c.path = path
c.open = true
ret c
end
func _bin_str(c &: Conn): str:
if c.binlen <= 0:
ret ""
end
mut sb := str.NewBuilder()
defer str.BufFree(sb)
bp := c.bin as i8*
repeat c.binlen in i:
mut v := bp[i] as int
if v < 0:
v += 256
end
str.BufAppendChar(sb, v)
end
ret str.BufStr(sb)
end
func _consume(c &: Conn, n: int):
if n <= 0:
ret
end
if n >= c.blen:
c.blen = 0
ret
end
src := ((c.buf as i64) + (n as i64)) as void*
mem.MemMove(c.buf, src, (c.blen - n) as u64)
c.blen -= n
end
func _shutdown(c &: Conn):
if c.secure and c.tls_idx >= 0:
mut tc := _tls_get(c.tls_idx)
tls.Close(tc)
_tls_put(c.tls_idx, tc)
_tls_release(c.tls_idx)
c.tls_idx = 0 - 1
else c.secure:
c.open = false
else:
if c.fd >= 0:
rawsock.Close(rawsock.FromFd(c.fd))
end
end
c.open = false
c.fd = 0 - 1
if c.buf != null:
mem.Free(c.buf)
c.buf = null
c.blen = 0
c.bcap = 0
end
if c.bin != null:
mem.Free(c.bin)
c.bin = null
c.binlen = 0
c.bincap = 0
end
end
func _payload_str(c &: Conn, off: int, plen: int, masked: bool, moff: int): str:
mut sb := str.NewBuilder()
defer str.BufFree(sb)
repeat plen in i:
mut b := _bget(c.buf, off + i)
if masked:
mk := _bget(c.buf, moff + (i % 4))
b = _xor8(b, mk)
end
str.BufAppendChar(sb, b)
end
result := str.BufStr(sb)
ret result
end
func _find_hdr_end(c &: Conn): int:
mut i := 0
until i + 3 < c.blen:
if _bget(c.buf, i) == 13 and _bget(c.buf, i + 1) == 10 and _bget(c.buf, i + 2) == 13 and _bget(c.buf, i + 3) == 10:
ret i
end
i += 1
end
ret 0 - 1
end
func _read_headers(c &: Conn): str:
mut hdr := ""
mut going := true
until going:
e := _find_hdr_end(c)
if e >= 0:
hdr = _payload_str(c, 0, e + 4, false, 0)
_consume(c, e + 4)
going = false
else:
if c.blen > 65536:
going = false
else:
n := _fill(c)
if n <= 0:
going = false
end
end
end
end
ret hdr
end
func _request_path(request: str): str:
sp := str.Find(request, " ")
if sp < 0: ret "" end
rest := request.substr(sp + 1, request.len() - sp - 1)
e := str.Find(rest, " ")
if e < 0: ret "" end
ret rest.substr(0, e)
end
func _frame_size(c &: Conn): int:
if c.blen < 2:
ret 0
end
b1 := _bget(c.buf, 1)
masked := b1 / 128
mut plen := (b1 % 128) as i64
mut hlen := 2
if plen == 126:
if c.blen < 4:
ret 0
end
plen = (_bget(c.buf, 2) * 256 + _bget(c.buf, 3)) as i64
hlen = 4
else plen == 127:
if c.blen < 10:
ret 0
end
mut v := 0 as i64
repeat 8 in k:
v = v * 256 + (_bget(c.buf, 2 + k) as i64)
end
if v < (0 as i64) or v > 104857600:
ret 0 - 1
end
plen = v
hlen = 10
end
if masked == 1:
hlen += 4
end
need := (hlen as i64) + plen
if (c.blen as i64) < need:
ret 0
end
ret need as int
end
func _send_frame(c &: Conn, opcode: int, payload: str): int:
ret _send_frame_raw(c, opcode, payload as void*, payload.len())
end
func _send_frame_raw(c &: Conn, opcode: int, payload: void*, plen: int): int:
if not c.open and opcode != 8:
ret 0 - 1
end
if not c.secure and c.fd < 0:
ret 0 - 1
end
mut hlen := 2
if plen >= 126 and plen < 65536:
hlen = 4
end
if plen >= 65536:
hlen = 10
end
mut mlen := 0
if c.client:
mlen = 4
end
total := hlen + mlen + plen
buf := mem.Allocate(total as u64)
defer mem.Free(buf)
_bput(buf, 0, 128 + opcode)
mut maskbit := 0
if c.client:
maskbit = 128
end
if plen < 126:
_bput(buf, 1, maskbit + plen)
else plen < 65536:
_bput(buf, 1, maskbit + 126)
_bput(buf, 2, plen / 256)
_bput(buf, 3, plen % 256)
else:
_bput(buf, 1, maskbit + 127)
p64 := plen as i64
repeat 8 in k:
_bput(buf, 2 + k, ((p64 / _pow2(8 * (7 - k))) % 256) as int)
end
end
if c.client:
m0 := rand.Int32Range(0, 255)
m1 := rand.Int32Range(0, 255)
m2 := rand.Int32Range(0, 255)
m3 := rand.Int32Range(0, 255)
_bput(buf, hlen, m0)
_bput(buf, hlen + 1, m1)
_bput(buf, hlen + 2, m2)
_bput(buf, hlen + 3, m3)
_copy_raw(buf, hlen + 4, payload, plen)
body := ((buf as i64) + ((hlen + 4) as i64)) as i8*
repeat plen in i:
mi := i % 4
mut mk := m0
if mi == 1: mk = m1 end
if mi == 2: mk = m2 end
if mi == 3: mk = m3 end
mut v := body[i] as int
if v < 0: v += 256 end
body[i] = _xor8(v, mk) as i8
end
else:
_copy_raw(buf, hlen, payload, plen)
end
mut sent := 0
if c.secure and c.tls_idx < 0:
ret 0 - 1
else c.secure:
mut tc := _tls_get(c.tls_idx)
sent = tls.WriteBytes(tc, buf, total)
_tls_put(c.tls_idx, tc)
else:
sent = rawsock.SendBytes(rawsock.FromFd(c.fd), buf, total)
end
if sent != total:
c.open = false
ret 0 - 1
end
ret 0
end
func _header_value(headers: str, name_lower: str): str:
lower := str.Lower(headers)
idx := str.Find(lower, name_lower)
if idx < 0:
ret ""
end
ci := str.IndexFrom(headers, ":", idx)
if ci < 0:
ret ""
end
mut e := str.IndexFrom(headers, "\r", ci)
if e < 0:
e = headers.len()
end
ret str.Trim(headers.substr(ci + 1, e - ci - 1))
end
@en "AcceptKey"
@fa "کلید پذیرش"
pub func AcceptKey(key: str): str:
ret crypto.Sha1Base64(key + WS_GUID)
end
@en "HandshakeResponse"
@fa "پاسخ دست دادن"
pub func HandshakeResponse(request: str): str:
key := _header_value(request, "sec-websocket-key")
if key == "":
ret ""
end
ret "HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: " + AcceptKey(key) + "\r\n\r\n"
end
@en "HandshakeRequest"
@fa "درخواست دست دادن"
pub func HandshakeRequest(host: str, path: str, key: str): str:
ret HandshakeRequestWith(host, path, key, "")
end
@en "HandshakeRequestWith"
@fa "درخواست دست دادن با سربرگ"
pub func HandshakeRequestWith(host: str, path: str, key: str, extra: str): str:
mut req := "GET " + path + " HTTP/1.1\r\nHost: " + host + "\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: " + key + "\r\nSec-WebSocket-Version: 13\r\n"
if str.Trim(extra).len() > 0:
req += extra
if not str.EndsWith(extra, "\r\n"):
req += "\r\n"
end
end
ret req + "\r\n"
end
@en "Listen"
@fa "شنود"
pub func Listen(port: int): Server:
ret Server { fd = rawsock.Listen(port).fd, port = port }
end
@en "Ok"
@fa "معتبر"
pub func Ok(srv: Server): bool:
ret srv.fd >= 0
end
@en "Port"
@fa "درگاه"
pub func Port(srv: Server): int:
if srv.fd < 0:
ret 0
end
ret rawsock.LocalPort(rawsock.FromFd(srv.fd))
end
@en "CloseServer"
@fa "بستن سرور"
pub func CloseServer(srv: Server):
if srv.fd >= 0:
rawsock.Close(rawsock.FromFd(srv.fd))
end
end
@en "Accept"
@fa "پذیرش"
pub func Accept(srv: Server): Conn:
t := rawsock.Accept(rawsock.FromFd(srv.fd))
mut c := _new_conn(t.fd, false)
if t.fd < 0:
ret c
end
_no_delay(t.fd)
hdr := _read_headers(c)
resp := HandshakeResponse(hdr)
if resp == "":
_shutdown(c)
ret c
end
n := rawsock.Send(rawsock.FromFd(c.fd), resp)
if n <= 0:
_shutdown(c)
ret c
end
c.hdr = hdr
c.path = _request_path(hdr)
c.open = true
ret c
end
@en "LoadWSSConfig"
@fa "بارگذاری پیکربندی امن"
pub func LoadWSSConfig(cert_file: str, key_file: str):
_wss_cfg = tls.NewServerConfig(cert_file, key_file)
end
@en "AcceptWSS"
@fa "پذیرش امن"
pub func AcceptWSS(srv: Server): Conn:
t := rawsock.Accept(rawsock.FromFd(srv.fd))
mut c := _new_conn(0 - 1, false)
if t.fd < 0:
ret c
end
_no_delay(t.fd)
tc := tls.WrapServer(t.fd, _wss_cfg)
c.secure = true
c.tls_idx = _tls_store(tc)
if not tls.ConnOk(tc):
c.open = false
ret c
end
hdr := _read_headers(c)
resp := HandshakeResponse(hdr)
if resp == "":
_shutdown(c)
ret c
end
mut tc2 := _tls_get(c.tls_idx)
n := tls.Write(tc2, resp)
_tls_put(c.tls_idx, tc2)
if n <= 0:
_shutdown(c)
ret c
end
c.hdr = hdr
c.path = _request_path(hdr)
c.open = true
ret c
end
@en "Dial"
@fa "شماره گیری"
pub func Dial(host: str, port: int, path: str): Conn:
ret DialWith(host, port, path, "")
end
@en "DialWith"
@fa "شماره گیری با سربرگ"
pub func DialWith(host: str, port: int, path: str, extra: str): Conn:
s := rawsock.Connect(host, port)
mut c := _new_conn(s.fd, true)
if s.fd < 0:
ret c
end
_no_delay(s.fd)
key := encoding.Base64Encode(rand.Alnum(16))
req := HandshakeRequestWith(host, path, key, extra)
n := rawsock.Send(s, req)
if n <= 0:
_shutdown(c)
ret c
end
hdr := _read_headers(c)
c.hdr = hdr
if not str.Contains(hdr, " 101 "):
_shutdown(c)
ret c
end
if not str.Contains(hdr, AcceptKey(key)):
_shutdown(c)
ret c
end
c.path = path
c.open = true
ret c
end
@en "DialWSS"
@fa "شماره گیری امن"
pub func DialWSS(host: str, port: int, path: str): Conn:
ret DialWSSWith(host, port, path, "")
end
@en "DialWSSWith"
@fa "شماره گیری امن با سربرگ"
pub func DialWSSWith(host: str, port: int, path: str, extra: str): Conn:
ret _dial_wss(host, port, path, extra, false)
end
@en "DialWSSUnverified"
@fa "شماره گیری امن بدون بررسی"
pub func DialWSSUnverified(host: str, port: int, path: str, extra: str): Conn:
ret _dial_wss(host, port, path, extra, true)
end
@en "IsOpen"
@fa "باز است"
pub func IsOpen(c &: Conn): bool:
ret c.open
end
@en "Receive"
@fa "دریافت پیام"
pub func Receive(c &: Conn): Message:
ret Poll(c, 0 - 1)
end
@en "Poll"
@fa "دریافت با مهلت"
pub func Poll(c &: Conn, timeout_ms: int): Message:
mut msg := Message { kind = NONE, text = "" }
if not c.open:
ret msg
end
start := time.MonoMillis()
mut going := true
until going:
fsize := _frame_size(c)
if fsize < 0:
Close(c)
going = false
else fsize == 0:
mut remaining := timeout_ms
if timeout_ms >= 0:
spent := (time.MonoMillis() - start) as int
remaining = timeout_ms - spent
if remaining < 0:
remaining = 0
end
end
if not _readable(c, remaining):
msg = Message { kind = TIMEOUT, text = "" }
going = false
else:
n := _fill(c)
if n <= 0:
_shutdown(c)
going = false
end
end
else:
b0 := _bget(c.buf, 0)
b1 := _bget(c.buf, 1)
fin := b0 / 128
opcode := b0 % 16
masked := (b1 / 128) == 1
mut plen := b1 % 128
mut hlen := 2
if plen == 126:
plen = _bget(c.buf, 2) * 256 + _bget(c.buf, 3)
hlen = 4
else plen == 127:
mut v := 0 as i64
repeat 8 in k:
v = v * 256 + (_bget(c.buf, 2 + k) as i64)
end
plen = v as int
hlen = 10
end
mut moff := 0
if masked:
moff = hlen
hlen += 4
end
if opcode == 9:
payload := _payload_str(c, hlen, plen, masked, moff)
_consume(c, fsize)
_send_frame(c, 10, payload)
else opcode == 10:
payload := _payload_str(c, hlen, plen, masked, moff)
_consume(c, fsize)
msg = Message { kind = 10, text = payload }
going = false
else opcode == 8:
_consume(c, fsize)
_send_frame(c, 8, "")
_shutdown(c)
msg = Message { kind = 8, text = "" }
going = false
else:
if opcode == 1 or opcode == 2:
c.acc_kind = opcode
c.acc = ""
_bin_reset(c)
end
if c.acc_kind == 2:
_bin_append(c, hlen, plen, masked, moff)
else:
c.acc += _payload_str(c, hlen, plen, masked, moff)
end
_consume(c, fsize)
if fin == 1:
if c.acc_kind == 2:
msg = Message { kind = 2, text = _bin_str(c), data = c.bin, len = c.binlen }
else:
msg = Message { kind = c.acc_kind, text = c.acc }
end
c.acc = ""
going = false
end
end
end
end
ret msg
end
@en "ReceiveText"
@fa "دریافت متن"
pub func ReceiveText(c &: Conn): str:
m := Receive(c)
if m.kind == 1:
ret m.text
end
ret ""
end
@en "IsText"
@fa "متن است"
pub func IsText(m: Message): bool:
ret m.kind == 1
end
@en "IsBinary"
@fa "دودویی است"
pub func IsBinary(m: Message): bool:
ret m.kind == 2
end
@en "IsClose"
@fa "بسته است"
pub func IsClose(m: Message): bool:
ret m.kind == 8
end
@en "IsPong"
@fa "پونگ است"
pub func IsPong(m: Message): bool:
ret m.kind == 10
end
@en "SendText"
@fa "ارسال متن"
pub func SendText(c &: Conn, msg: str): int:
ret _send_frame(c, 1, msg)
end
@en "SendBinary"
@fa "ارسال دودویی"
pub func SendBinary(c &: Conn, data: str): int:
ret _send_frame(c, 2, data)
end
@en "SendBinaryBytes"
@fa "ارسال بایت دودویی"
pub func SendBinaryBytes(c &: Conn, ptr: void*, n: int): int:
ret _send_frame_raw(c, 2, ptr, n)
end
@en "Ping"
@fa "پینگ فرست"
pub func Ping(c &: Conn, data: str): int:
ret _send_frame(c, 9, data)
end
@en "Close"
@fa "بستن"
pub func Close(c &: Conn):
if c.open:
_send_frame(c, 8, "")
end
_shutdown(c)
end
@en "Stop"
@fa "توقف"
pub func Stop(c &: Conn):
if c.open:
_send_frame(c, 8, "")
end
if c.secure and c.tls_idx >= 0:
mut tc := _tls_get(c.tls_idx)
tls.Close(tc)
_tls_put(c.tls_idx, tc)
else c.secure:
c.open = false
else:
if c.fd >= 0:
rawsock.Shutdown(rawsock.FromFd(c.fd))
end
end
c.open = false
end
@en "NewHub"
@fa "هاب جدید"
pub func NewHub(): Hub:
ret Hub {}
end
@en "Register"
@fa "ثبت"
pub func Register(h &: Hub, room: str, c: Conn):
mut members := RoomMembers {}
if h.rooms.has(room): members = h.rooms.get(room) end
members.items.push(c)
h.rooms.put(room, members)
end
@en "Unregister"
@fa "لغو ثبت"
pub func Unregister(h &: Hub, room: str, c: Conn):
if not h.rooms.has(room): ret end
mut members := h.rooms.get(room)
mut kept := RoomMembers {}
n := members.items.len()
mut i := 0
until i < n:
m := members.items.get(i)
mut same := false
if c.secure:
same = m.secure and m.tls_idx == c.tls_idx
else:
same = not m.secure and m.fd == c.fd
end
if not same:
kept.items.push(m)
end
i += 1
end
h.rooms.put(room, kept)
end
@en "RoomSize"
@fa "اندازه اتاق"
pub func RoomSize(h: Hub, room: str): int:
if not h.rooms.has(room): ret 0 end
ret h.rooms.get(room).items.len()
end
@en "Broadcast"
@fa "پخش"
pub func Broadcast(h &: Hub, room: str, msg: str): int:
if not h.rooms.has(room): ret 0 end
mut members := h.rooms.get(room)
mut sent := 0
n := members.items.len()
mut i := 0
until i < n:
mut m := members.items.get(i)
if m.open:
rc := _send_frame(m, 1, msg)
if rc == 0: sent += 1 end
members.items.set(i, m)
end
i += 1
end
h.rooms.put(room, members)
ret sent
end
@en "BroadcastBinary"
@fa "پخش دودویی"
pub func BroadcastBinary(h &: Hub, room: str, data: str): int:
if not h.rooms.has(room): ret 0 end
mut members := h.rooms.get(room)
mut sent := 0
n := members.items.len()
mut i := 0
until i < n:
mut m := members.items.get(i)
if m.open:
rc := _send_frame(m, 2, data)
if rc == 0: sent += 1 end
members.items.set(i, m)
end
i += 1
end
h.rooms.put(room, members)
ret sent
end
@en "nn"
@fa "شبکه عصبی"
package nn
import autograd
import mem
import str
import tensor
@en "Parameter"
@fa "پارامتر"
pub struct Parameter:
pub name: str = ""
pub value: tensor.Tensor = tensor.Tensor {}
pub grad: tensor.Tensor = tensor.Tensor {}
end
@en "ParamStore"
@fa "مخزن پارامتر"
pub struct ParamStore:
pub items: Vector<Parameter> = Vector {}
@en "add"
@fa "افزودن"
pub func add(name: str, t: tensor.Tensor): int:
mut p := Parameter {}
p.name = str.Clone(name)
p.value = t
p.grad = tensor.Zeros(t.shape)
id := this.items.len()
this.items.push(p)
ret id
end
@en "count"
@fa "شمار"
pub func count(): int: ret this.items.len() end
@en "at"
@fa "عنصر"
pub func at(h: int): Parameter: ret this.items.get(h) end
@en "zero_grad"
@fa "صفر کردن گرادیان"
pub func zero_grad():
repeat this.items.len() in i:
mut p := this.items.get(i)
tensor.SetAll(p.grad, 0.0)
end
end
@en "free"
@fa "آزادسازی"
pub func free():
repeat this.items.len() in i:
mut p := this.items.get(i)
p.value.free()
p.grad.free()
mem.Free(p.name as void*)
end
this.items.free()
end
end
@en "Bind"
@fa "پیوند"
pub func Bind(tp &: autograd.Tape, ps &: ParamStore, h: int): int:
mut p := ps.items.get(h)
ret autograd.Param(tp, p.value, p.grad)
end
package nn
import autograd
@en "Dropout"
@fa "حذف تصادفی"
pub struct Dropout:
pub p: f64 = 0.1
@en "forward"
@fa "پیشرو"
pub func forward(tp &: autograd.Tape, x: int): int:
ret autograd.Dropout(tp, x, this.p)
end
end
package nn
import autograd
import mem
import math
import tensor
@en "MultiHeadAttention"
@fa "توجه چندسر"
pub struct MultiHeadAttention:
pub wq: Linear = Linear {}
pub wk: Linear = Linear {}
pub wv: Linear = Linear {}
pub wo: Linear = Linear {}
pub dim: int = 0
pub heads: int = 1
pub dropout: f64 = 0.0
pub causal: bool = false
@en "forward"
@fa "پیشرو"
pub func forward(tp &: autograd.Tape, ps &: ParamStore, x: int, batch: int, seq: int): int:
dh := this.dim / this.heads
q := _split_heads(tp, this.wq.forward(tp, ps, x), batch, seq, this.heads, dh)
k := _split_heads(tp, this.wk.forward(tp, ps, x), batch, seq, this.heads, dh)
v := _split_heads(tp, this.wv.forward(tp, ps, x), batch, seq, this.heads, dh)
kt := _transpose_last(tp, k)
mut scores := autograd.BatchMatMul(tp, q, kt)
scores = autograd.Scale(tp, scores, 1.0 / math.Sqrt(dh as f64))
if this.causal:
mut mask := CausalMask(seq)
scores = autograd.Add(tp, scores, autograd.Constant(tp, mask))
mask.free()
end
mut attn := autograd.Softmax(tp, scores)
attn = autograd.Dropout(tp, attn, this.dropout)
ctx := autograd.BatchMatMul(tp, attn, v)
merged := _merge_heads(tp, ctx, batch, seq, this.heads, dh)
ret this.wo.forward(tp, ps, merged)
end
end
@en "TransformerEncoderLayer"
@fa "لایه رمزگذار ترنسفورمر"
pub struct TransformerEncoderLayer:
pub attn: MultiHeadAttention = MultiHeadAttention {}
pub ln1: LayerNorm = LayerNorm {}
pub ln2: LayerNorm = LayerNorm {}
pub ff1: Linear = Linear {}
pub ff2: Linear = Linear {}
pub dropout: f64 = 0.0
@en "forward"
@fa "پیشرو"
pub func forward(tp &: autograd.Tape, ps &: ParamStore, x: int, batch: int, seq: int): int:
a := this.attn.forward(tp, ps, this.ln1.forward(tp, ps, x), batch, seq)
h := autograd.Add(tp, x, autograd.Dropout(tp, a, this.dropout))
mut f := autograd.Gelu(tp, this.ff1.forward(tp, ps, this.ln2.forward(tp, ps, h)))
f = this.ff2.forward(tp, ps, f)
ret autograd.Add(tp, h, autograd.Dropout(tp, f, this.dropout))
end
end
func _split_heads(tp &: autograd.Tape, x: int, b: int, t: int, h: int, dh: int): int:
mut s4 := tensor.Shape4(b, t, h, dh)
r := autograd.Reshape(tp, x, s4)
s4.free()
mut perm := Vector {} as Vector<int>
perm.push(0)
perm.push(2)
perm.push(1)
perm.push(3)
p := autograd.Permute(tp, r, perm)
perm.free()
mut s3 := tensor.Shape3(b * h, t, dh)
out := autograd.Reshape(tp, p, s3)
s3.free()
ret out
end
func _merge_heads(tp &: autograd.Tape, x: int, b: int, t: int, h: int, dh: int): int:
mut s4 := tensor.Shape4(b, h, t, dh)
r := autograd.Reshape(tp, x, s4)
s4.free()
mut perm := Vector {} as Vector<int>
perm.push(0)
perm.push(2)
perm.push(1)
perm.push(3)
p := autograd.Permute(tp, r, perm)
perm.free()
mut s2 := tensor.Shape2(b * t, h * dh)
out := autograd.Reshape(tp, p, s2)
s2.free()
ret out
end
func _transpose_last(tp &: autograd.Tape, x: int): int:
mut perm := Vector {} as Vector<int>
perm.push(0)
perm.push(2)
perm.push(1)
out := autograd.Permute(tp, x, perm)
perm.free()
ret out
end
@en "NewMultiHeadAttention"
@fa "توجه چندسر جدید"
pub func NewMultiHeadAttention(ps &: ParamStore, name: str, dim: int, heads: int, dropout: f64, g &: tensor.Rng): MultiHeadAttention:
mut m := MultiHeadAttention {}
m.dim = dim
m.heads = heads
m.dropout = dropout
_pn1 := name + ".q"
m.wq = NewLinear(ps, _pn1, dim, dim, g)
mem.Free(_pn1 as void*)
_pn2 := name + ".k"
m.wk = NewLinear(ps, _pn2, dim, dim, g)
mem.Free(_pn2 as void*)
_pn3 := name + ".v"
m.wv = NewLinear(ps, _pn3, dim, dim, g)
mem.Free(_pn3 as void*)
_pn4 := name + ".o"
m.wo = NewLinear(ps, _pn4, dim, dim, g)
mem.Free(_pn4 as void*)
ret m
end
@en "NewTransformerEncoderLayer"
@fa "لایه رمزگذار ترنسفورمر جدید"
pub func NewTransformerEncoderLayer(ps &: ParamStore, name: str, dim: int, heads: int, ff_dim: int, dropout: f64, g &: tensor.Rng): TransformerEncoderLayer:
mut l := TransformerEncoderLayer {}
l.dropout = dropout
_pn5 := name + ".attn"
l.attn = NewMultiHeadAttention(ps, _pn5, dim, heads, dropout, g)
mem.Free(_pn5 as void*)
_pn6 := name + ".ln1"
l.ln1 = NewLayerNorm(ps, _pn6, dim)
mem.Free(_pn6 as void*)
_pn7 := name + ".ln2"
l.ln2 = NewLayerNorm(ps, _pn7, dim)
mem.Free(_pn7 as void*)
_pn8 := name + ".ff1"
l.ff1 = NewLinear(ps, _pn8, dim, ff_dim, g)
mem.Free(_pn8 as void*)
_pn9 := name + ".ff2"
l.ff2 = NewLinear(ps, _pn9, ff_dim, dim, g)
mem.Free(_pn9 as void*)
ret l
end
@en "CausalMask"
@fa "ماسک علّی"
pub func CausalMask(seq: int): tensor.Tensor:
m := tensor.Zeros2(seq, seq)
p := m.data.data
neg := (0.0 - 1.0e9) as f32
repeat seq in i:
repeat seq in j:
if j > i: p[i * seq + j] = neg end
end
end
ret m
end
@en "NewTransformerDecoderLayer"
@fa "لایه رمزگشای ترنسفورمر جدید"
pub func NewTransformerDecoderLayer(ps &: ParamStore, name: str, dim: int, heads: int, ff_dim: int, dropout: f64, g &: tensor.Rng): TransformerEncoderLayer:
mut l := NewTransformerEncoderLayer(ps, name, dim, heads, ff_dim, dropout, g)
l.attn.causal = true
ret l
end
package nn
import archive
import compress
import encoding.binary
import mem
import str
import tensor
const _CKPT_VERSION := 1
func _find_param(ps &: ParamStore, name: str): int:
repeat ps.count() in i:
p := ps.items.get(i)
if str.Equals(p.name, name): ret i end
end
ret 0 - 1
end
@en "SaveCheckpointBuf"
@fa "ذخیره نقطه بازرسی در بافر"
pub func SaveCheckpointBuf(ps &: ParamStore): compress.ByteBuf:
mut buf := compress.NewByteBuf()
compress.BufPushBytes(buf, "SLMT" as void*, 4)
binary.WriteU32LE(buf, _CKPT_VERSION)
binary.WriteU32LE(buf, 0)
binary.WriteU32LE(buf, ps.count())
repeat ps.count() in i:
mut p := ps.items.get(i)
tensor.WriteTensor(buf, p.name, p.value)
end
crc := compress.CRC32Buf(buf)
binary.WriteU32LE(buf, crc as int)
ret buf
end
@en "LoadCheckpointBuf"
@fa "بارگذاری نقطه بازرسی از بافر"
pub func LoadCheckpointBuf(buf: compress.ByteBuf, ps &: ParamStore): bool:
n := compress.BufLen(buf)
if n < 20: ret false end
stored := compress.BufGet(buf, n - 4) | (compress.BufGet(buf, n - 3) << 8) | (compress.BufGet(buf, n - 2) << 16) | (compress.BufGet(buf, n - 1) << 24)
computed := compress.CRC32(buf.data, n - 4)
if (stored as u32) != computed: ret false end
mut rd := compress.NewByteReader(buf.data, n - 4)
if binary.ReadU8(rd) != 83 or binary.ReadU8(rd) != 76 or binary.ReadU8(rd) != 77 or binary.ReadU8(rd) != 84: ret false end
if binary.ReadU32LE(rd) != _CKPT_VERSION: ret false end
binary.ReadU32LE(rd)
count := binary.ReadU32LE(rd)
if rd.bad or count < 0: ret false end
mut all_ok := count == ps.count()
mut seen := Vector {} as Vector<bool>
seen.zeros(ps.count())
repeat count:
mut name := ""
mut t := tensor.Empty()
if tensor.ReadTensor(rd, name, t) == false:
all_ok = false
else:
idx := _find_param(ps, name)
if idx < 0:
all_ok = false
else:
mut p := ps.items.get(idx)
if p.value.same_shape(t):
tensor.CopyInto(p.value, t)
seen.set(idx, true)
else:
all_ok = false
end
end
t.free()
end
if str.Len(name) > 0: mem.Free(name as void*) end
end
repeat ps.count() in i:
if seen.get(i) == false: all_ok = false end
end
seen.free()
ret all_ok
end
@en "SaveCheckpoint"
@fa "ذخیره نقطه بازرسی"
pub func SaveCheckpoint(path: str, ps &: ParamStore): bool:
mut buf := SaveCheckpointBuf(ps)
mut ok := false
if str.EndsWith(path, ".gz"):
mut z := compress.GzipCompressBuf(buf)
ok = archive.WriteBinaryFileBuf(path, z)
compress.BufFree(z)
else:
ok = archive.WriteBinaryFileBuf(path, buf)
end
compress.BufFree(buf)
ret ok
end
@en "LoadCheckpoint"
@fa "بارگذاری نقطه بازرسی"
pub func LoadCheckpoint(path: str, ps &: ParamStore): bool:
mut fok := false
mut raw := archive.ReadBinaryFile(path, fok)
if fok == false:
compress.BufFree(raw)
ret false
end
mut ok := false
if str.EndsWith(path, ".gz"):
mut zok := false
mut plain := compress.GzipDecompressBuf(raw, zok)
if zok: ok = LoadCheckpointBuf(plain, ps) end
compress.BufFree(plain)
else:
ok = LoadCheckpointBuf(raw, ps)
end
compress.BufFree(raw)
ret ok
end
package nn
import autograd
import mem
import tensor
@en "Conv2D"
@fa "لایه پیچشی"
pub struct Conv2D:
pub w: int = 0 - 1
pub b: int = 0 - 1
pub stride: int = 1
pub pad: int = 0
@en "forward"
@fa "پیشرو"
pub func forward(tp &: autograd.Tape, ps &: ParamStore, x: int): int:
wid := Bind(tp, ps, this.w)
bid := Bind(tp, ps, this.b)
ret autograd.Conv2D(tp, x, wid, bid, this.stride, this.stride, this.pad, this.pad)
end
end
@en "MaxPool2D"
@fa "لایه بیشینه‌گیری"
pub struct MaxPool2D:
pub size: int = 2
pub stride: int = 2
@en "forward"
@fa "پیشرو"
pub func forward(tp &: autograd.Tape, x: int): int:
ret autograd.MaxPool2D(tp, x, this.size, this.size, this.stride, this.stride)
end
end
@en "AvgPool2D"
@fa "لایه میانگین‌گیری"
pub struct AvgPool2D:
pub size: int = 2
pub stride: int = 2
@en "forward"
@fa "پیشرو"
pub func forward(tp &: autograd.Tape, x: int): int:
ret autograd.AvgPool2D(tp, x, this.size, this.size, this.stride, this.stride)
end
end
@en "NewConv2D"
@fa "لایه پیچشی جدید"
pub func NewConv2D(ps &: ParamStore, name: str, in_ch: int, out_ch: int, k: int, stride: int, pad: int, g &: tensor.Rng): Conv2D:
mut l := Conv2D {}
l.stride = stride
l.pad = pad
mut w := tensor.Zeros4(out_ch, in_ch, k, k)
KaimingUniform(w, in_ch * k * k, g)
_pn1 := name + ".w"
l.w = ps.add(_pn1, w)
mem.Free(_pn1 as void*)
b := tensor.Zeros1(out_ch)
_pn2 := name + ".b"
l.b = ps.add(_pn2, b)
mem.Free(_pn2 as void*)
ret l
end
@en "Flatten"
@fa "تخت‌سازی"
pub func Flatten(tp &: autograd.Tape, x: int): int:
v := autograd.Value(tp, x)
n := v.dim(0)
mut s := tensor.Shape2(n, v.numel() / n)
out := autograd.Reshape(tp, x, s)
s.free()
ret out
end
package nn
import autograd
import mem
import math
import tensor
@en "Embedding"
@fa "جاسازی"
pub struct Embedding:
pub w: int = 0 - 1
pub vocab: int = 0
pub dim: int = 0
@en "forward"
@fa "پیشرو"
pub func forward(tp &: autograd.Tape, ps &: ParamStore, indices &: Vector<int>): int:
wid := Bind(tp, ps, this.w)
ret autograd.Embedding(tp, wid, indices)
end
end
@en "NewEmbedding"
@fa "جاسازی جدید"
pub func NewEmbedding(ps &: ParamStore, name: str, vocab: int, dim: int, g &: tensor.Rng): Embedding:
mut e := Embedding {}
e.vocab = vocab
e.dim = dim
mut w := tensor.Zeros2(vocab, dim)
tensor.FillNormal(w, 0.0, 1.0 / math.Sqrt(dim as f64), g)
_pn1 := name + ".w"
e.w = ps.add(_pn1, w)
mem.Free(_pn1 as void*)
ret e
end
@en "SinusoidalPositions"
@fa "موقعیت سینوسی"
pub func SinusoidalPositions(batch: int, seq: int, dim: int): tensor.Tensor:
t := tensor.Zeros2(batch * seq, dim)
p := t.data.data
repeat seq in pos:
repeat dim in i:
pair := (i / 2) * 2
freq := 1.0 / math.Pow(10000.0, (pair as f64) / (dim as f64))
angle := (pos as f64) * freq
mut v := math.Sin(angle)
if i % 2 == 1: v = math.Cos(angle) end
repeat batch in b:
p[(b * seq + pos) * dim + i] = v as f32
end
end
end
ret t
end
package nn
import math
import tensor
@en "XavierUniform"
@fa "ژاویر یکنواخت"
pub func XavierUniform(t &: tensor.Tensor, fan_in: int, fan_out: int, g &: tensor.Rng):
limit := math.Sqrt(6.0 / ((fan_in + fan_out) as f64))
tensor.FillUniform(t, 0.0 - limit, limit, g)
end
@en "XavierNormal"
@fa "ژاویر نرمال"
pub func XavierNormal(t &: tensor.Tensor, fan_in: int, fan_out: int, g &: tensor.Rng):
std := math.Sqrt(2.0 / ((fan_in + fan_out) as f64))
tensor.FillNormal(t, 0.0, std, g)
end
@en "KaimingUniform"
@fa "کایمینگ یکنواخت"
pub func KaimingUniform(t &: tensor.Tensor, fan_in: int, g &: tensor.Rng):
limit := math.Sqrt(6.0 / (fan_in as f64))
tensor.FillUniform(t, 0.0 - limit, limit, g)
end
@en "KaimingNormal"
@fa "کایمینگ نرمال"
pub func KaimingNormal(t &: tensor.Tensor, fan_in: int, g &: tensor.Rng):
std := math.Sqrt(2.0 / (fan_in as f64))
tensor.FillNormal(t, 0.0, std, g)
end
package nn
import autograd
import mem
import tensor
@en "Linear"
@fa "لایه خطی"
pub struct Linear:
pub w: int = 0 - 1
pub b: int = 0 - 1
pub in_features: int = 0
pub out_features: int = 0
pub has_bias: bool = true
@en "forward"
@fa "پیشرو"
pub func forward(tp &: autograd.Tape, ps &: ParamStore, x: int): int:
wid := Bind(tp, ps, this.w)
mut out := autograd.MatMul(tp, x, wid)
if this.has_bias:
bid := Bind(tp, ps, this.b)
out = autograd.Add(tp, out, bid)
end
ret out
end
end
@en "NewLinear"
@fa "لایه خطی جدید"
pub func NewLinear(ps &: ParamStore, name: str, in_f: int, out_f: int, g &: tensor.Rng): Linear:
mut l := Linear {}
l.in_features = in_f
l.out_features = out_f
mut w := tensor.Zeros2(in_f, out_f)
KaimingUniform(w, in_f, g)
_pn1 := name + ".w"
l.w = ps.add(_pn1, w)
mem.Free(_pn1 as void*)
b := tensor.Zeros1(out_f)
_pn2 := name + ".b"
l.b = ps.add(_pn2, b)
mem.Free(_pn2 as void*)
ret l
end
@en "NewLinearNoBias"
@fa "لایه خطی بی‌بایاس"
pub func NewLinearNoBias(ps &: ParamStore, name: str, in_f: int, out_f: int, g &: tensor.Rng): Linear:
mut l := Linear {}
l.in_features = in_f
l.out_features = out_f
l.has_bias = false
mut w := tensor.Zeros2(in_f, out_f)
KaimingUniform(w, in_f, g)
_pn3 := name + ".w"
l.w = ps.add(_pn3, w)
mem.Free(_pn3 as void*)
ret l
end
package nn
import autograd
import mem
import tensor
@en "LayerNorm"
@fa "نرمال‌سازی لایه"
pub struct LayerNorm:
pub gamma: int = 0 - 1
pub beta: int = 0 - 1
pub eps: f64 = 0.00001
@en "forward"
@fa "پیشرو"
pub func forward(tp &: autograd.Tape, ps &: ParamStore, x: int): int:
g := Bind(tp, ps, this.gamma)
b := Bind(tp, ps, this.beta)
ret autograd.LayerNorm(tp, x, g, b, this.eps)
end
end
@en "BatchNorm"
@fa "نرمال‌سازی دسته"
pub struct BatchNorm:
pub gamma: int = 0 - 1
pub beta: int = 0 - 1
pub running_mean: tensor.Tensor = tensor.Tensor {}
pub running_var: tensor.Tensor = tensor.Tensor {}
pub momentum: f64 = 0.1
pub eps: f64 = 0.00001
@en "forward"
@fa "پیشرو"
pub func forward(tp &: autograd.Tape, ps &: ParamStore, x: int): int:
g := Bind(tp, ps, this.gamma)
b := Bind(tp, ps, this.beta)
ret autograd.BatchNorm(tp, x, g, b, this.running_mean, this.running_var, this.momentum, this.eps)
end
@en "free"
@fa "آزادسازی"
pub func free():
this.running_mean.free()
this.running_var.free()
end
end
@en "GroupNorm"
@fa "نرمال‌سازی گروهی"
pub struct GroupNorm:
pub gamma: int = 0 - 1
pub beta: int = 0 - 1
pub groups: int = 1
pub eps: f64 = 0.00001
@en "forward"
@fa "پیشرو"
pub func forward(tp &: autograd.Tape, ps &: ParamStore, x: int): int:
g := Bind(tp, ps, this.gamma)
b := Bind(tp, ps, this.beta)
ret autograd.GroupNorm(tp, x, g, b, this.groups, this.eps)
end
end
@en "RMSNorm"
@fa "نرمال‌سازی جذر میانگین مربعات"
pub struct RMSNorm:
pub gamma: int = 0 - 1
pub eps: f64 = 0.00001
@en "forward"
@fa "پیشرو"
pub func forward(tp &: autograd.Tape, ps &: ParamStore, x: int): int:
g := Bind(tp, ps, this.gamma)
ret autograd.RMSNorm(tp, x, g, this.eps)
end
end
@en "NewLayerNorm"
@fa "نرمال‌سازی لایه جدید"
pub func NewLayerNorm(ps &: ParamStore, name: str, dim: int): LayerNorm:
mut l := LayerNorm {}
mut g := tensor.Zeros1(dim)
tensor.SetAll(g, 1.0)
_pn1 := name + ".gamma"
l.gamma = ps.add(_pn1, g)
mem.Free(_pn1 as void*)
b := tensor.Zeros1(dim)
_pn2 := name + ".beta"
l.beta = ps.add(_pn2, b)
mem.Free(_pn2 as void*)
ret l
end
@en "NewBatchNorm"
@fa "نرمال‌سازی دسته جدید"
pub func NewBatchNorm(ps &: ParamStore, name: str, channels: int): BatchNorm:
mut l := BatchNorm {}
mut g := tensor.Zeros1(channels)
tensor.SetAll(g, 1.0)
_pn3 := name + ".gamma"
l.gamma = ps.add(_pn3, g)
mem.Free(_pn3 as void*)
b := tensor.Zeros1(channels)
_pn4 := name + ".beta"
l.beta = ps.add(_pn4, b)
mem.Free(_pn4 as void*)
l.running_mean = tensor.Zeros1(channels)
mut v := tensor.Zeros1(channels)
tensor.SetAll(v, 1.0)
l.running_var = v
ret l
end
@en "NewGroupNorm"
@fa "نرمال‌سازی گروهی جدید"
pub func NewGroupNorm(ps &: ParamStore, name: str, channels: int, groups: int): GroupNorm:
mut l := GroupNorm {}
l.groups = groups
mut g := tensor.Zeros1(channels)
tensor.SetAll(g, 1.0)
_pn5 := name + ".gamma"
l.gamma = ps.add(_pn5, g)
mem.Free(_pn5 as void*)
b := tensor.Zeros1(channels)
_pn6 := name + ".beta"
l.beta = ps.add(_pn6, b)
mem.Free(_pn6 as void*)
ret l
end
@en "NewRMSNorm"
@fa "نرمال‌سازی جذر میانگین مربعات جدید"
pub func NewRMSNorm(ps &: ParamStore, name: str, dim: int): RMSNorm:
mut l := RMSNorm {}
mut g := tensor.Zeros1(dim)
tensor.SetAll(g, 1.0)
_pn7 := name + ".gamma"
l.gamma = ps.add(_pn7, g)
mem.Free(_pn7 as void*)
ret l
end
package nn
import autograd
import mem
import tensor
@en "LSTM"
@fa "حافظه کوتاه‌مدت بلند"
pub struct LSTM:
pub wx: Linear = Linear {}
pub wh: Linear = Linear {}
pub hidden: int = 0
@en "forward"
@fa "پیشرو"
pub func forward(tp &: autograd.Tape, ps &: ParamStore, x: int, seq: int, batch: int): int:
hd := this.hidden
mut zeros := tensor.Zeros2(batch, hd)
mut h := autograd.Constant(tp, zeros)
mut c := autograd.Constant(tp, zeros)
zeros.free()
mut out := 0 - 1
repeat seq in t:
xt := autograd.SliceAxis0(tp, x, t * batch, batch)
gates := autograd.Add(tp, this.wx.forward(tp, ps, xt), this.wh.forward(tp, ps, h))
ig := autograd.Sigmoid(tp, autograd.Narrow(tp, gates, 1, 0, hd))
fg := autograd.Sigmoid(tp, autograd.Narrow(tp, gates, 1, hd, hd))
gg := autograd.Tanh(tp, autograd.Narrow(tp, gates, 1, 2 * hd, hd))
og := autograd.Sigmoid(tp, autograd.Narrow(tp, gates, 1, 3 * hd, hd))
c = autograd.Add(tp, autograd.Mul(tp, fg, c), autograd.Mul(tp, ig, gg))
h = autograd.Mul(tp, og, autograd.Tanh(tp, c))
if out < 0: out = h else:
out = autograd.Concat2(tp, out, h, 0)
end
end
ret out
end
end
@en "GRU"
@fa "واحد بازگشتی دروازه‌دار"
pub struct GRU:
pub wx: Linear = Linear {}
pub wh: Linear = Linear {}
pub hidden: int = 0
@en "forward"
@fa "پیشرو"
pub func forward(tp &: autograd.Tape, ps &: ParamStore, x: int, seq: int, batch: int): int:
hd := this.hidden
mut zeros := tensor.Zeros2(batch, hd)
mut h := autograd.Constant(tp, zeros)
zeros.free()
mut out := 0 - 1
repeat seq in t:
xt := autograd.SliceAxis0(tp, x, t * batch, batch)
gx := this.wx.forward(tp, ps, xt)
gh := this.wh.forward(tp, ps, h)
r := autograd.Sigmoid(tp, autograd.Add(tp, autograd.Narrow(tp, gx, 1, 0, hd), autograd.Narrow(tp, gh, 1, 0, hd)))
z := autograd.Sigmoid(tp, autograd.Add(tp, autograd.Narrow(tp, gx, 1, hd, hd), autograd.Narrow(tp, gh, 1, hd, hd)))
n := autograd.Tanh(tp, autograd.Add(tp, autograd.Narrow(tp, gx, 1, 2 * hd, hd), autograd.Mul(tp, r, autograd.Narrow(tp, gh, 1, 2 * hd, hd))))
h = autograd.Add(tp, n, autograd.Mul(tp, z, autograd.Sub(tp, h, n)))
if out < 0: out = h else:
out = autograd.Concat2(tp, out, h, 0)
end
end
ret out
end
end
@en "NewLSTM"
@fa "حافظه کوتاه‌مدت بلند جدید"
pub func NewLSTM(ps &: ParamStore, name: str, in_f: int, hidden: int, g &: tensor.Rng): LSTM:
mut l := LSTM {}
l.hidden = hidden
_pn1 := name + ".x"
l.wx = NewLinear(ps, _pn1, in_f, 4 * hidden, g)
mem.Free(_pn1 as void*)
_pn2 := name + ".h"
l.wh = NewLinearNoBias(ps, _pn2, hidden, 4 * hidden, g)
mem.Free(_pn2 as void*)
ret l
end
@en "NewGRU"
@fa "واحد بازگشتی دروازه‌دار جدید"
pub func NewGRU(ps &: ParamStore, name: str, in_f: int, hidden: int, g &: tensor.Rng): GRU:
mut l := GRU {}
l.hidden = hidden
_pn3 := name + ".x"
l.wx = NewLinear(ps, _pn3, in_f, 3 * hidden, g)
mem.Free(_pn3 as void*)
_pn4 := name + ".h"
l.wh = NewLinear(ps, _pn4, hidden, 3 * hidden, g)
mem.Free(_pn4 as void*)
ret l
end
@en "LastStep"
@fa "گام آخر"
pub func LastStep(tp &: autograd.Tape, out: int, seq: int, batch: int): int:
ret autograd.SliceAxis0(tp, out, (seq - 1) * batch, batch)
end
package nn
import autograd
@en "Layer"
@fa "لایه"
pub interface Layer:
func forward(tp &: autograd.Tape, ps &: ParamStore, x: int): int
end
@en "ReluLayer"
@fa "لایه یکسوساز"
pub struct ReluLayer:
pub unused: int = 0
@en "forward"
@fa "پیشرو"
pub func forward(tp &: autograd.Tape, _ps &: ParamStore, x: int): int:
ret autograd.Relu(tp, x)
end
end
@en "GeluLayer"
@fa "لایه گلو"
pub struct GeluLayer:
pub unused: int = 0
@en "forward"
@fa "پیشرو"
pub func forward(tp &: autograd.Tape, _ps &: ParamStore, x: int): int:
ret autograd.Gelu(tp, x)
end
end
@en "TanhLayer"
@fa "لایه تانژانت هذلولی"
pub struct TanhLayer:
pub unused: int = 0
@en "forward"
@fa "پیشرو"
pub func forward(tp &: autograd.Tape, _ps &: ParamStore, x: int): int:
ret autograd.Tanh(tp, x)
end
end
@en "Sequential"
@fa "ترتیبی"
pub struct Sequential:
pub layers: Vector<dyn Layer> = Vector {}
@en "add"
@fa "افزودن"
pub func add(l: dyn Layer): this.layers.push(l) end
@en "forward"
@fa "پیشرو"
pub func forward(tp &: autograd.Tape, ps &: ParamStore, x: int): int:
mut h := x
repeat this.layers.len() in i:
l := this.layers.get(i)
h = l.forward(tp, ps, h)
end
ret h
end
@en "free"
@fa "آزادسازی"
pub func free(): this.layers.free() end
end
@en "node"
@fa "نود"
package node
import str
extern:
func require(id: str): i64
func salam_js_get_prop(obj: i64, name: str): i64
func salam_js_get_num(obj: i64, name: str): f64
func salam_js_get_str(obj: i64, name: str): str
func salam_js_get_bool(obj: i64, name: str): bool
func salam_js_set_prop(obj: i64, name: str, ...)
func salam_js_call(obj: i64, method: str, ...): i64
func salam_js_new(ctor: i64, ...): i64
func salam_js_invoke(fn: i64, ...): i64
func salam_js_is_nullish(x: i64): bool
func salam_js_global(name: str): i64
func salam_js_array0(): i64
func salam_js_obj0(): i64
func salam_js_new_promise(executor: func (i64, i64)): i64
func salam_js_to_str(x: i64): str
func salam_js_to_bool(x: i64): bool
module: i64
process: i64
__dirname: i64
__filename: i64
end
func js_to_str(x: i64): str: ret salam_js_to_str(x) end
@en "Require"
@fa "واردکردن"
pub func Require(id: str): i64: ret require(id) end
@en "Exports"
@fa "صادرات"
pub func Exports(): i64: ret salam_js_get_prop(module, "exports") end
@en "GetProp"
@fa "دریافت خاصیت"
pub func GetProp(obj: i64, name: str): i64: ret salam_js_get_prop(obj, name) end
@en "GetNum"
@fa "دریافت خاصیت عددی"
pub func GetNum(obj: i64, name: str): f64: ret salam_js_get_num(obj, name) end
@en "GetStr"
@fa "دریافت خاصیت رشته ای"
pub func GetStr(obj: i64, name: str): str: ret salam_js_get_str(obj, name) end
@en "GetBool"
@fa "دریافت خاصیت منطقی"
pub func GetBool(obj: i64, name: str): bool: ret salam_js_get_bool(obj, name) end
@en "SetProp"
@fa "تنظیم خاصیت"
pub func SetProp(obj: i64, name: str, value: i64): salam_js_set_prop(obj, name, value) end
@en "SetStr"
@fa "تنظیم خاصیت رشته ای"
pub func SetStr(obj: i64, name: str, value: str): salam_js_set_prop(obj, name, value) end
@en "SetNum"
@fa "تنظیم خاصیت عددی"
pub func SetNum(obj: i64, name: str, value: f64): salam_js_set_prop(obj, name, value) end
@en "SetBool"
@fa "تنظیم خاصیت منطقی"
pub func SetBool(obj: i64, name: str, value: bool): salam_js_set_prop(obj, name, value) end
@en "SetPropFn0"
@fa "تنظیم خاصیت به تابع بدون آرگومان"
pub func SetPropFn0(obj: i64, name: str, fn: func ()): salam_js_set_prop(obj, name, fn) end
@en "SetPropFn1"
@fa "تنظیم خاصیت به تابع یک آرگومانی"
pub func SetPropFn1(obj: i64, name: str, fn: func (i64)): salam_js_set_prop(obj, name, fn) end
@en "SetPropFn1R"
@fa "تنظیم خاصیت به تابع یک آرگومانی بازگشتی"
pub func SetPropFn1R(obj: i64, name: str, fn: func (i64) i64): salam_js_set_prop(obj, name, fn) end
@en "Call0"
@fa "فراخوان"
pub func Call0(obj: i64, method: str): i64: ret salam_js_call(obj, method) end
@en "CallS1"
@fa "فراخوان رشته یک"
pub func CallS1(obj: i64, method: str, a: str): i64: ret salam_js_call(obj, method, a) end
@en "CallS2"
@fa "فراخوان رشته دو"
pub func CallS2(obj: i64, method: str, a: str, b: str): i64: ret salam_js_call(obj, method, a, b) end
@en "CallS3"
@fa "فراخوان رشته سه"
pub func CallS3(obj: i64, method: str, a: str, b: str, c: str): i64: ret salam_js_call(obj, method, a, b, c) end
