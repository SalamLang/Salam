v := px.get(i)
bp[i * 4] = _wpd_ch(v, 16) as u8
bp[i * 4 + 1] = _wpd_ch(v, 8) as u8
bp[i * 4 + 2] = _wpd_ch(v, 0) as u8
bp[i * 4 + 3] = _wpd_ch(v, 24) as u8
end
px.free()
ok = true
ret img
end
func _wpd_u32(bp: u8*, at: int): int:
ret (bp[at] as int) | ((bp[at + 1] as int) << 8) | ((bp[at + 2] as int) << 16) | ((bp[at + 3] as int) << 24)
