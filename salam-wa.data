@fa "سبک خط‌خورده"
pub const StyleStrike := 9
@en "FgBlack"
@fa "پیش‌زمینه سیاه"
pub const FgBlack := 30
@en "FgRed"
@fa "پیش‌زمینه قرمز"
pub const FgRed := 31
@en "FgGreen"
@fa "پیش‌زمینه سبز"
pub const FgGreen := 32
@en "FgYellow"
@fa "پیش‌زمینه زرد"
pub const FgYellow := 33
@en "FgBlue"
@fa "پیش‌زمینه آبی"
pub const FgBlue := 34
@en "FgMagenta"
@fa "پیش‌زمینه ارغوانی"
pub const FgMagenta := 35
@en "FgCyan"
@fa "پیش‌زمینه فیروزه‌ای"
pub const FgCyan := 36
@en "FgWhite"
@fa "پیش‌زمینه سفید"
pub const FgWhite := 37
@en "FgDefault"
@fa "پیش‌زمینه پیش‌فرض"
pub const FgDefault := 39
