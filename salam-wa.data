end
func _gf_add(a: Gf, b: Gf): Gf:
mut o := Gf {}
repeat 16 in i:
o.v[i] = a.v[i] + b.v[i]
end
ret o
end
func _gf_sub(a: Gf, b: Gf): Gf:
