end
end
cache.free()
entropy.free()
_wpd_free_codes(codes)
end
func _wpd_ch(p: i64, shift: int): int:
ret ((p >> shift) & (255 as i64)) as int
end
func _wpd_avg(a: i64, b: i64): i64:
ret _wpd_argb((_wpd_ch(a, 24) + _wpd_ch(b, 24)) / 2, (_wpd_ch(a, 16) + _wpd_ch(b, 16)) / 2, (_wpd_ch(a, 8) + _wpd_ch(b, 8)) / 2, (_wpd_ch(a, 0) + _wpd_ch(b, 0)) / 2)
end
func _wpd_clamp(v: int): int:
if v < 0:
ret 0
end
if v > 255:
ret 255
end
ret v
end
func _wpd_abs(v: int): int:
ret v < 0 ? 0 - v : v
end
func _wpd_select(l: i64, t: i64, tl: i64): i64:
mut pl := 0
mut pt := 0
repeat 4 in k:
sh := k * 8
p := _wpd_ch(l, sh) + _wpd_ch(t, sh) - _wpd_ch(tl, sh)
pl += _wpd_abs(p - _wpd_ch(l, sh))
pt += _wpd_abs(p - _wpd_ch(t, sh))
end
ret pl < pt ? l : t
end
func _wpd_predict(mode: int, l: i64, t: i64, tr: i64, tl: i64): i64:
if mode == 0 or mode > 13:
ret 4278190080
else mode == 1:
ret l
else mode == 2:
ret t
else mode == 3:
ret tr
else mode == 4:
ret tl
else mode == 5:
ret _wpd_avg(_wpd_avg(l, tr), t)
else mode == 6:
ret _wpd_avg(l, tl)
else mode == 7:
ret _wpd_avg(l, t)
else mode == 8:
ret _wpd_avg(tl, t)
else mode == 9:
ret _wpd_avg(t, tr)
else mode == 10:
ret _wpd_avg(_wpd_avg(l, tl), _wpd_avg(t, tr))
else mode == 11:
ret _wpd_select(l, t, tl)
else mode == 12:
ret _wpd_argb(_wpd_clamp(_wpd_ch(l, 24) + _wpd_ch(t, 24) - _wpd_ch(tl, 24)), _wpd_clamp(_wpd_ch(l, 16) + _wpd_ch(t, 16) - _wpd_ch(tl, 16)), _wpd_clamp(_wpd_ch(l, 8) + _wpd_ch(t, 8) - _wpd_ch(tl, 8)), _wpd_clamp(_wpd_ch(l, 0) + _wpd_ch(t, 0) - _wpd_ch(tl, 0)))
end
a := _wpd_avg(l, t)
ret _wpd_argb(_wpd_clamp(_wpd_ch(a, 24) + (_wpd_ch(a, 24) - _wpd_ch(tl, 24)) / 2), _wpd_clamp(_wpd_ch(a, 16) + (_wpd_ch(a, 16) - _wpd_ch(tl, 16)) / 2), _wpd_clamp(_wpd_ch(a, 8) + (_wpd_ch(a, 8) - _wpd_ch(tl, 8)) / 2), _wpd_clamp(_wpd_ch(a, 0) + (_wpd_ch(a, 0) - _wpd_ch(tl, 0)) / 2))
end
func _wpd_add(a: i64, b: i64): i64:
