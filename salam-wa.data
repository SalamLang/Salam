defer _buf_free(x)
mut y := _newbuf(cv.nb)
defer _buf_free(y)
mut tries := 0
until tries < 8:
tries += 1
_bufreset(x)
_bufreset(y)
_putzeros(x, cv.nb)
_putzeros(y, cv.nb)
_bufreset(h.ecpriv)
_putzeros(h.ecpriv, cv.nb)
crypto.RandomBytes(h.ecpriv.p, cv.nb)
if _ec_base_mul(cv, h.ecpriv.p, x.p, y.p):
