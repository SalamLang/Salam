i += 1
end
else:
repeat size in i:
ws[d - _VP8_BPS + i] = pl[(py - 1) * ps + px + i]
end
ws[d - _VP8_BPS - 1] = (mx > 0 ? pl[(py - 1) * ps + px - 1] : 129 as u8)
end
end
