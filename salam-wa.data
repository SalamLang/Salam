end
if _wpd_tag(bp, at, 86, 80, 56, 76):
ret _wpd_vp8l(((p as i64) + (body as i64)) as void*, size, ok)
end
if _wpd_tag(bp, at, 86, 80, 56, 88) and size >= 10:
canvas_w = _wpd_u24(bp, body + 4) + 1
canvas_h = _wpd_u24(bp, body + 7) + 1
if (canvas_w as i64) * (canvas_h as i64) > (268435456 as i64):
