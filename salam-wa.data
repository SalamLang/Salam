_vp8_simple(y, yp + 4 * (k + 1), 1, ys, limit)
end
end
if my > 0:
_vp8_simple(y, yp, ys, 1, limit + 4)
end
if inner:
repeat 3 in k:
_vp8_simple(y, yp + 4 * (k + 1) * ys, ys, 1, limit)
end
end
