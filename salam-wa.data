end
@en "HexDecodeBuf"
@fa "کدگشایی شانزدهی"
pub func HexDecodeBuf(s: str): Buf:
ret _hexbuf(s)
end
@en "NewBuf"
@fa "بافر جدید"
pub func NewBuf(cap: int): Buf:
ret _newbuf(cap)
end
@en "NewZeroBuf"
@fa "بافر صفر جدید"
pub func NewZeroBuf(n: int): Buf:
mut b := _newbuf(n)
_putzeros(b, n)
ret b
end
@en "FreeBuf"
@fa "آزادسازی بافر"
pub func FreeBuf(b &: Buf):
_buf_free(b)
end
@en "WipeBuf"
@fa "پاک سازی بافر"
pub func WipeBuf(b &: Buf):
_buf_wipe(b)
end
@en "BufLen"
@fa "طول بافر"
pub func BufLen(b: Buf): int:
ret b.len
end
@en "BufAppendStr"
@fa "افزودن رشته به بافر"
pub func BufAppendStr(b &: Buf, s: str):
_putstr(b, s)
end
@en "LoadRoots"
@fa "بارگذاری ریشه ها"
pub func LoadRoots(ca_file: str): Roots:
ret _roots_load(ca_file)
end
@en "RootCount"
@fa "تعداد ریشه ها"
pub func RootCount(r: Roots): int:
ret r.count
end
@en "FreeRoots"
