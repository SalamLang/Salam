_vp8_copy9(left_nz, 0, ln)
mem.Set(lv as void*, 0, (17 * 16 * 4) as u64)
repeat 16 in nb:
if is4:
bx := nb % 4
by4 := nb / 4
top_m := by4 == 0 ? intra_t.get(mx * 4 + bx) : sub[nb - 4]
left_m := bx == 0 ? intra_l[by4] : sub[nb - 1]
ctx := ln.get(by4) + tn.get(bx)
