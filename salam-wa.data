ax := _norm_axis(axes.get(i) as i64, cur.rank())
if ax < 0 or ax >= cur.rank():
cur.free()
model.error = str.Clone("Slice: axis out of range")
ret false
end
n := cur.dim(ax)
mut lo := starts.get(i)
mut hi := ends.get(i)
if lo < 0: lo = lo + n end
if hi < 0: hi = hi + n end
if lo < 0: lo = 0 end
if hi > n: hi = n end
if hi < lo: hi = lo end
nxt := tensor.Narrow(cur, ax, lo, hi - lo)
