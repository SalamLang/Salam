package middleware
import net.http
import conv
@en "Log"
@fa "ثبت رخداد"
pub func Log(ctx: i64):
println "[HTTP]", http.Ctx_method(ctx), http.Ctx_path(ctx)
end
@en "AllowAll"
@fa "اجازه به همه"
pub func AllowAll(ctx: i64):
http.Ctx_set_header(ctx, "Access-Control-Allow-Origin", "*")
http.Ctx_set_header(ctx, "Access-Control-Allow-Methods", "GET, POST, PUT, DELETE, OPTIONS")
http.Ctx_set_header(ctx, "Access-Control-Allow-Headers", "Content-Type, Authorization")
end
@en "Secure"
@fa "امن"
pub func Secure(ctx: i64):
http.Ctx_set_header(ctx, "X-Content-Type-Options", "nosniff")
http.Ctx_set_header(ctx, "X-Frame-Options", "DENY")
http.Ctx_set_header(ctx, "X-XSS-Protection", "1; mode=block")
end
@en "NoCache"
@fa "بدون کش"
pub func NoCache(ctx: i64):
http.Ctx_set_header(ctx, "Cache-Control", "no-store, no-cache, must-revalidate")
http.Ctx_set_header(ctx, "Pragma", "no-cache")
end
@en "Cache"
@fa "کش"
pub func Cache(ctx: i64, seconds: int):
http.Ctx_set_header(ctx, "Cache-Control", "max-age=" + conv.FormatInt(seconds as i64))
end
package http
@en "UrlDecode"
@fa "رمزگشایی نشانی"
pub func UrlDecode(s: str): str:
ret encoding.URLDecode(s)
end
package http
import net.router
import mem
import tls
if SALAM_OS_WINDOWS:
extern:
func _beginthreadex(sec: void *, stack: u32, start: void *, arg: void *, flags: u32, thrdaddr: void *): u64
func CloseHandle(h: void *): int
end
else:
extern:
func pthread_create(thread: void *, attr: void *, start: void *, arg: void *): int
func pthread_detach(thread: u64): int
end
end
if not SALAM_OS_WINDOWS:
extern:
func signal(signum: int, handler: void *): void *
end
export:
func _http_ignore_sigpipe():
signal(13, 1 as void *)
end
end
end
if SALAM_OS_WINDOWS:
export:
func salam_spawn_fn_i64(fn: i64, arg: i64):
h := _beginthreadex(null, 0 as u32, fn as void *, arg as void *, 0 as u32, null)
if h != (0 as u64): CloseHandle(h as void *) end
end
end
else:
export:
func salam_spawn_fn_i64(fn: i64, arg: i64):
t := mem.Allocate(8 as u64)
if pthread_create(t, null, fn as void *, arg as void *) == 0:
tp := t as i64 *
pthread_detach(tp[0] as u64)
end
mem.Free(t)
end
end
end
func _bind(s: Server): i64:
_reqctx_sizeof()
_warm_up_split()
if not SALAM_OS_WINDOWS:
_http_ignore_sigpipe()
end
ret _net_listen(s.host, s.port)
end
func _accept_loop(packed: i64):
slot := _srv_slot_of(packed)
lfd := _srv_fd_of(packed)
until 1 == 1:
cfd := _net_accept(lfd)
if cfd >= 0:
salam_spawn_fn_i64(_web_conn_handler, _srv_pack(slot, cfd))
end
end
end
func _accept_loop_tls(packed: i64):
slot := _srv_slot_of(packed)
lfd := _srv_fd_of(packed)
until 1 == 1:
cfd := _net_accept(lfd)
if cfd >= 0:
salam_spawn_fn_i64(_web_tls_conn_handler, _srv_pack(slot, cfd))
end
end
end
@en "NewServer"
@fa "سرور جدید"
pub func NewServer(port: int): Server:
ret Server { port = port }
end
@en "Use"
@fa "استفاده"
pub func Use(s &: Server, r: router.Router):
s.router = r
end
@en "HideTokens"
@fa "پنهان سازی توکن"
pub func HideTokens(s &: Server):
s.hide_tokens = true
end
@en "SetHost"
@fa "تنظیم میزبان"
pub func SetHost(s &: Server, host: str):
s.host = host
end
@en "EnableAccessLog"
@fa "فعال سازی گزارش دسترسی"
pub func EnableAccessLog(s &: Server):
s.access_log = true
end
@en "Run"
@fa "اجرا"
pub func Run(s: Server):
if SALAM_OS_WASM:
_edge_serve(s.router, s.hide_tokens, s.access_log)
else:
lfd := _bind(s)
if lfd < 0:
ret
end
_accept_loop(_srv_pack(_srv_claim(s.router, s.hide_tokens, s.access_log), lfd))
end
end
@en "RunBackground"
@fa "اجرا در پس زمینه"
pub func RunBackground(s: Server): bool:
if SALAM_OS_WASM:
_edge_serve(s.router, s.hide_tokens, s.access_log)
ret true
else:
lfd := _bind(s)
if lfd < 0:
ret false
end
slot := _srv_claim(s.router, s.hide_tokens, s.access_log)
salam_spawn_fn_i64(_accept_loop, _srv_pack(slot, lfd))
ret true
end
end
@en "RunTLS"
@fa "اجرای امن"
pub func RunTLS(s: Server, cert_file: str, key_file: str):
if SALAM_OS_WASM:
_edge_serve(s.router, s.hide_tokens, s.access_log)
else:
lfd := _bind(s)
if lfd < 0:
ret
end
slot := _srv_claim(s.router, s.hide_tokens, s.access_log)
_srv_tls.set(slot, tls.NewServerConfig(cert_file, key_file))
_accept_loop_tls(_srv_pack(slot, lfd))
end
end
@en "net/http/session"
@fa "نشست"
package session
import net.http
import crypto
import time
import sync
@en "DefaultCookieName"
@fa "نام پیش فرض کوکی"
pub const DefaultCookieName := "salam_sid"
@en "DefaultMaxAge"
@fa "حداکثر عمر پیش فرض"
pub const DefaultMaxAge := 86400
const _csrf_key := "_csrf_token"
mut _sessions := HashMap {} as HashMap<str, Session>
mut _mu := sync.Mutex {}
mut _cookie_name := "salam_sid"
mut _max_age := 86400
mut _secure := false
mut _same_site := "Lax"
mut _gc_hits := 0
@en "SessionData"
@fa "داده نشست"
pub struct SessionData:
pub items: HashMap<str, str> = HashMap {} as HashMap<str, str>
end
@en "Session"
@fa "نشست"
pub struct Session:
pub id: str = ""
pub data: SessionData = SessionData {}
pub created_at: i64 = 0
pub last_seen: i64 = 0
pub max_age: int = 0
end
func _gen_id(): str:
ret crypto.RandomToken(32)
end
func _is_expired(s: Session, now: i64): bool:
if s.max_age <= 0: ret false end
ret (now - s.last_seen) > (s.max_age as i64)
end
func _ensure_mu():
if _mu.handle == null:
_mu = sync.NewMutex()
end
end
func _store_put(id: str, s: Session):
_ensure_mu()
sync.Lock(_mu)
_sessions.put(id, s)
sync.Unlock(_mu)
end
func _store_delete(id: str):
_ensure_mu()
sync.Lock(_mu)
_sessions.remove(id)
sync.Unlock(_mu)
end
func _store_touch(id: str, ok &: bool): Session:
now := time.Now()
_ensure_mu()
sync.Lock(_mu)
mut found := _sessions.has(id)
mut s := Session {}
if found:
s = _sessions.get(id)
if _is_expired(s, now):
_sessions.remove(id)
found = false
else:
s.last_seen = now
_sessions.put(id, s)
end
end
sync.Unlock(_mu)
ok = found
ret s
end
func _cleanup_expired(): int:
now := time.Now()
mut dead := Vector {} as Vector<str>
_ensure_mu()
sync.Lock(_mu)
it := _sessions.iter()
until it.has_next():
s := it.value()
if _is_expired(s, now):
dead.push(it.key())
end
it.next()
end
repeat dead.len() in i:
_sessions.remove(dead.get(i))
end
sync.Unlock(_mu)
n := dead.len()
defer dead.free()
ret n
end
func _maybe_gc():
_gc_hits += 1
if _gc_hits < 100:
ret
end
_gc_hits = 0
_cleanup_expired()
end
func _cookie_for(id: str): http.Cookie:
mut c := http.ExpiringCookie(_cookie_name, id, _max_age)
c.secure = _secure
c.same_site = _same_site
c.http_only = true
c.path = "/"
ret c
end
@en "Configure"
@fa "پیکربندی"
pub func Configure(cookie_name: str, max_age_seconds: int, secure: bool, same_site: str):
_cookie_name = cookie_name
_max_age = max_age_seconds
_secure = secure
_same_site = same_site
end
@en "CleanupExpired"
@fa "پاکسازی منقضی شده ها"
pub func CleanupExpired(): int: ret _cleanup_expired() end
@en "New"
@fa "جدید"
pub func New(): Session:
_maybe_gc()
now := time.Now()
s := Session { id = _gen_id(), created_at = now, last_seen = now, max_age = _max_age }
_store_put(s.id, s)
ret s
end
@en "Get"
@fa "دریافت"
pub func Get(id: str, ok &: bool): Session:
_maybe_gc()
mut found := false
s := _store_touch(id, found)
ok = found
ret s
end
@en "Save"
@fa "ذخیره"
pub func Save(s: Session): _store_put(s.id, s) end
@en "Destroy"
@fa "نابودسازی"
pub func Destroy(id: str): _store_delete(id) end
@en "Value"
@fa "مقدار"
pub func Value(s: Session, key: str): str:
if s.data.items.has(key): ret s.data.items.get(key) end
ret ""
end
@en "HasValue"
@fa "مقدار دارد"
pub func HasValue(s: Session, key: str): bool:
ret s.data.items.has(key)
end
@en "SetValue"
@fa "تنظیم مقدار"
pub func SetValue(s &: Session, key: str, value: str):
s.data.items.put(key, value)
end
@en "DeleteValue"
@fa "حذف مقدار"
pub func DeleteValue(s &: Session, key: str): bool:
ret s.data.items.remove(key)
end
@en "ClearValues"
@fa "پاک کردن مقادیر"
pub func ClearValues(s &: Session):
s.data = SessionData {}
end
@en "Start"
@fa "شروع"
pub func Start(h: i64): Session:
sid := http.Ctx_cookie(h, _cookie_name)
mut ok := false
mut s := Session {}
if sid.len() > 0:
s = Get(sid, ok)
end
if ok == false:
s = New()
end
http.Ctx_set_cookie(h, _cookie_for(s.id))
ret s
end
@en "End"
@fa "پایان"
pub func End(h: i64):
sid := http.Ctx_cookie(h, _cookie_name)
if sid.len() > 0:
Destroy(sid)
end
http.Ctx_clear_cookie(h, _cookie_name)
end
@en "Regenerate"
@fa "بازتولید"
pub func Regenerate(h: i64, s &: Session):
Destroy(s.id)
now := time.Now()
s.id = _gen_id()
s.created_at = now
s.last_seen = now
Save(s)
http.Ctx_set_cookie(h, _cookie_for(s.id))
end
@en "CSRFToken"
@fa "توکن سی اس آر اف"
pub func CSRFToken(s &: Session): str:
if HasValue(s, _csrf_key) == false:
SetValue(s, _csrf_key, crypto.RandomToken(24))
end
ret Value(s, _csrf_key)
end
@en "CSRFVerify"
@fa "تایید سی اس آر اف"
pub func CSRFVerify(s: Session, token: str): bool:
if token.len() == 0: ret false end
want := Value(s, _csrf_key)
if want.len() == 0: ret false end
ret crypto.SecretEquals(want, token)
end
package swagger
import net.router
import str
import conv
func _op_label(o: Op): str:
ret o.method.concat(" ").concat(o.pattern)
end
func _has_scheme(d: Doc, name: str): bool:
repeat d.schemes.len() in i:
if str.Equals(d.schemes.get(i).name, name):
ret true
end
end
ret false
end
func _param_named(o: Op, name: str, loc: str): bool:
repeat o.params.len() in i:
p := o.params.get(i)
if str.Equals(p.name, name) and str.Equals(p.loc, loc):
ret true
end
end
ret false
end
func _op_id_of(o: Op): str:
ret o.op_id.len() > 0 ? o.op_id : _default_op_id(o.method, o.pattern)
end
func _bodyless(method: str): bool:
ret str.Equals(method, "GET") or str.Equals(method, "HEAD")
end
func _check_security(d: Doc, o: Op, out &: Vector<str>):
repeat o.security.len() in i:
name := o.security.get(i)
if not _has_scheme(d, name):
out.push(
_op_label(o).concat(": needs security scheme '").concat(name).concat("', which no BearerAuth or ApiKeyAuth declared")
)
end
end
end
func _check_path_params(o: Op, out &: Vector<str>):
declared := _path_params(o.pattern)
defer declared.free()
repeat declared.len() in i:
name := declared.get(i).name
if not _param_named(o, name, "path"):
out.push(
_op_label(o).concat(": the path has '{").concat(name).concat("}' but the operation does not declare it")
)
end
end
repeat o.params.len() in j:
p := o.params.get(j)
if not str.Equals(p.loc, "path"):
continue
end
mut found := false
repeat declared.len() in k:
if str.Equals(declared.get(k).name, p.name):
found = true
end
end
if not found:
out.push(
_op_label(o).concat(": declares path parameter '").concat(p.name).concat("', which the path does not contain")
)
end
if not p.required:
out.push(
_op_label(o).concat(": path parameter '").concat(p.name).concat("' is optional, and a path parameter cannot be")
)
end
end
end
func _check_replies(o: Op, out &: Vector<str>):
repeat o.replies.len() in i:
code := o.replies.get(i).code
if code < 100 or code > 599:
out.push(
_op_label(o).concat(": ").concat(conv.FormatInt(code as i64)).concat(" is not an HTTP status code")
)
end
end
end
@en "Problems"
@fa "مشکلات"
pub func Problems(d: Doc): Vector<str>:
mut out := Vector {} as Vector<str>
if d.title.len() == 0:
out.push("the document has no title")
end
if d.version.len() == 0:
out.push("the document has no version")
end
mut ids := Vector {} as Vector<str>
defer ids.free()
repeat d.ops.len() in i:
o := d.ops.get(i)
_check_security(d, o, out)
_check_path_params(o, out)
_check_replies(o, out)
if o.body_schema.len() > 0 and _bodyless(o.method):
out.push(
_op_label(o).concat(
": has a request body, and nothing between the client and the" + " handler will carry one on this method"
)
)
end
id := _op_id_of(o)
repeat ids.len() in j:
if str.Equals(ids.get(j), id):
out.push(
_op_label(o).concat(": operationId '").concat(id).concat("' is already used by another operation")
)
end
end
ids.push(id)
end
ret out
end
@en "Undocumented"
@fa "توضیح داده نشده"
pub func Undocumented(d: Doc): Vector<str>:
mut out := Vector {} as Vector<str>
repeat d.ops.len() in i:
o := d.ops.get(i)
if o.summary.len() == 0 and o.description.len() == 0 and o.replies.len() == 0:
out.push(_op_label(o))
end
end
ret out
end
@en "Missing"
@fa "جا افتاده"
pub func Missing(d: Doc, r: router.Router): Vector<str>:
mut out := Vector {} as Vector<str>
repeat r.routes.len() in i:
rt := r.routes.get(i)
if _is_own_route(rt.fn):
continue
end
mut found := false
repeat d.ops.len() in j:
o := d.ops.get(j)
if str.Equals(o.method, rt.method) and str.Equals(o.pattern, rt.pattern):
found = true
end
end
if not found:
out.push(rt.method.concat(" ").concat(rt.pattern))
end
end
ret out
end
@en "Free"
@fa "آزاد سازی"
pub func Free(d &: Doc):
repeat d.ops.len() in i:
mut o := d.ops.get(i)
o.tags.free()
o.params.free()
repeat o.replies.len() in j:
mut rp := o.replies.get(j)
rp.header_names.free()
rp.header_notes.free()
end
o.replies.free()
o.security.free()
end
d.ops.free()
d.servers.free()
d.server_notes.free()
d.defs.free()
d.schemes.free()
d.cur = 0 - 1
end
package swagger
import net.router
import str
const _WILDCARD_NAME := "path"
func _path_params(pattern: str): Vector<Param>:
mut out := Vector {} as Vector<Param>
n := pattern.len()
mut i := 0
until i < n:
c := pattern.substr(i, 1)
if str.Equals(c, ":"):
mut e := i + 1
until e < n and not str.Equals(pattern.substr(e, 1), "/"):
e += 1
end
out.push(
Param {
name = pattern.substr(i + 1, e - i - 1), loc = "path", required = true
}
)
i = e
else str.Equals(c, "*"):
out.push(
Param {
name = _WILDCARD_NAME, loc = "path", required = true, description = "the rest of the path, slashes included"
}
)
i += 1
else:
i += 1
end
end
ret out
end
func _openapi_path(pattern: str): str:
mut out := ""
n := pattern.len()
mut i := 0
until i < n:
c := pattern.substr(i, 1)
if str.Equals(c, ":"):
mut e := i + 1
until e < n and not str.Equals(pattern.substr(e, 1), "/"):
e += 1
end
out = out.concat("{").concat(pattern.substr(i + 1, e - i - 1)).concat("}")
i = e
else str.Equals(c, "*"):
out = out.concat("{").concat(_WILDCARD_NAME).concat("}")
i += 1
else:
out = out.concat(c)
i += 1
end
end
ret out
end
func _is_own_route(fn: i64): bool:
ret fn == _handle_ui or fn == _handle_spec
end
func _default_op_id(method: str, pattern: str): str:
mut out := method.lower()
n := pattern.len()
mut last_us := false
repeat n in i:
c := pattern.substr(i, 1)
if str.Equals(c, "/") or str.Equals(c, ":") or str.Equals(c, "*") or str.Equals(c, "-"):
if not last_us:
out = out.concat("_")
last_us = true
end
else:
out = out.concat(c)
last_us = false
end
end
if last_us and out.len() > 1:
ret out.substr(0, out.len() - 1)
end
ret out
end
@en "Scan"
@fa "پویش"
pub func Scan(d &: Doc, r: router.Router):
n := r.routes.len()
mut i := 0
until i < n:
rt := r.routes.get(i)
if not _is_own_route(rt.fn):
_add := Route(d, rt.method, rt.pattern)
end
i += 1
end
d.cur = 0 - 1
end
@en "ScanPrefix"
@fa "پویش با پیشوند"
pub func ScanPrefix(d &: Doc, r: router.Router, prefix: str):
n := r.routes.len()
mut i := 0
until i < n:
rt := r.routes.get(i)
if not _is_own_route(rt.fn) and rt.pattern.len() >= prefix.len() and str.Equals(
rt.pattern.substr(0, prefix.len()), prefix
):
_add := Route(d, rt.method, rt.pattern)
end
i += 1
end
d.cur = 0 - 1
end
package swagger
import net.http
import net.router
import os
import str
mut _mounts := Vector {} as Vector<_Mount>
struct _Mount:
pub prefix: str = ""
pub prefix_slash: str = ""
pub spec_path: str = ""
pub title: str = ""
pub spec: str = ""
pub page: str = ""
pub port: int = 0
end
func _host_port(host: str): int:
colon := str.LastIndex(host, ":")
if colon < 0 or colon == host.len() - 1:
ret 0
end
tail := host.substr(colon + 1, host.len() - colon - 1)
repeat tail.len() in i:
c := tail.substr(i, 1)
if c < "0" or c > "9":
ret 0
end
end
ret tail.to_int()
end
func _path_matches(m: _Mount, path: str, want_spec: bool): bool:
if want_spec:
ret str.Equals(m.spec_path, path)
end
ret str.Equals(m.prefix, path) or str.Equals(m.prefix_slash, path)
end
func _mount_for(path: str, host: str, want_spec: bool): int:
port := _host_port(host)
if port > 0:
repeat _mounts.len() in i:
m := _mounts.get(i)
if m.port == port and _path_matches(m, path, want_spec):
ret i
end
end
end
repeat _mounts.len() in j:
m2 := _mounts.get(j)
if m2.port == 0 and _path_matches(m2, path, want_spec):
ret j
end
end
repeat _mounts.len() in k:
if _path_matches(_mounts.get(k), path, want_spec):
ret k
end
end
ret 0 - 1
end
func _clean_prefix(prefix: str): str:
mut p := prefix
if p.len() == 0:
ret "/"
end
if not str.Equals(p.substr(0, 1), "/"):
p = "/".concat(p)
end
until p.len() > 1 and str.Equals(p.substr(p.len() - 1, 1), "/"):
p = p.substr(0, p.len() - 1)
end
ret p
end
func _spec_path_for(prefix: str): str:
if str.Equals(prefix, "/"):
ret "/openapi.json"
end
ret prefix.concat("/openapi.json")
end
func _register(prefix: str, port: int, title: str, spec: str): int:
p := _clean_prefix(prefix)
entry := _Mount {
prefix = p, prefix_slash = p.concat("/"), spec_path = _spec_path_for(p), title = title, spec = spec,
page = Page(title, ""), port = port
}
repeat _mounts.len() in i:
m := _mounts.get(i)
if str.Equals(m.prefix, p) and m.port == port:
_mounts.set(i, entry)
ret i
end
end
_mounts.push(entry)
ret _mounts.len() - 1
end
func _handle_ui(ctx: i64):
i := _mount_for(http.Ctx_path(ctx), http.Ctx_header(ctx, "Host"), false)
if i < 0:
http.Ctx_status(ctx, 404)
http.Ctx_text(ctx, "404 Not Found")
ret
end
http.Ctx_set_header(ctx, "Cache-Control", "no-cache")
http.Ctx_html(ctx, _mounts.get(i).page)
end
func _handle_spec(ctx: i64):
i := _mount_for(http.Ctx_path(ctx), http.Ctx_header(ctx, "Host"), true)
if i < 0:
http.Ctx_status(ctx, 404)
http.Ctx_json(ctx, "{\"error\":\"not found\"}")
ret
end
http.Ctx_set_header(ctx, "Access-Control-Allow-Origin", "*")
http.Ctx_set_header(ctx, "Cache-Control", "no-cache")
http.Ctx_json(ctx, _mounts.get(i).spec)
end
func _mount_routes(r &: router.Router, prefix: str):
p := _clean_prefix(prefix)
router.Get(r, p, _handle_ui)
if not str.Equals(p, "/"):
router.Get(r, p.concat("/"), _handle_ui)
end
router.Get(r, _spec_path_for(p), _handle_spec)
end
func _serve_on(prefix: str, port: int): bool:
mut r := router.NewRouter()
_mount_routes(r, prefix)
mut s := http.NewServer(port)
http.Use(s, r)
ret http.RunBackground(s)
end
@en "Mount"
@fa "نصب"
pub func Mount(d: Doc, r &: router.Router, prefix: str):
_reg := _register(prefix, 0, d.title, Spec(d))
_mount_routes(r, prefix)
end
@en "MountSpec"
@fa "نصب مشخصات"
pub func MountSpec(spec: str, title: str, r &: router.Router, prefix: str):
_reg := _register(prefix, 0, title, spec)
_mount_routes(r, prefix)
end
@en "Serve"
@fa "سرو"
pub func Serve(d: Doc, port: int): bool:
_reg := _register("/", port, d.title, Spec(d))
ret _serve_on("/", port)
end
@en "ServeSpec"
@fa "سرو مشخصات"
pub func ServeSpec(spec: str, title: str, port: int): bool:
_reg := _register("/", port, title, spec)
ret _serve_on("/", port)
end
@en "SpecFromFile"
@fa "مشخصات از پرونده"
pub func SpecFromFile(path: str): str:
if not os.Exists(path):
ret ""
end
ret os.ReadFile(path)
end
@en "WriteSpec"
@fa "نوشتن مشخصات"
pub func WriteSpec(d: Doc, path: str): bool:
ret os.WriteFile(path, SpecIndent(d)) > 0
end
package swagger
import encoding.json
import conv
import str
func _q(s: str): str:
ret json.Str(s)
end
func _finish(b &: str.StringBuilder): str:
out := str.BufStr(b)
str.BufFree(b)
ret out
end
func _kv(key: str, value: str): str:
mut b := str.NewBuilder()
str.BufAppend(b, _q(key))
str.BufAppend(b, ":")
str.BufAppend(b, _q(value))
ret _finish(b)
end
func _kraw(key: str, raw: str): str:
mut b := str.NewBuilder()
str.BufAppend(b, _q(key))
str.BufAppend(b, ":")
str.BufAppend(b, raw)
ret _finish(b)
end
func _wrap(open: str, parts: Vector<str>, close: str): str:
mut b := str.NewBuilder()
str.BufAppend(b, open)
repeat parts.len() in i:
if i > 0:
str.BufAppend(b, ",")
end
str.BufAppend(b, parts.get(i))
end
str.BufAppend(b, close)
ret _finish(b)
end
func _obj(parts: Vector<str>): str:
ret _wrap("{", parts, "}")
end
func _arr(parts: Vector<str>): str:
ret _wrap("[", parts, "]")
end
func _opt(parts &: Vector<str>, key: str, value: str):
if value.len() > 0:
parts.push(_kv(key, value))
end
end
func _info(d: Doc): str:
mut parts := Vector {} as Vector<str>
defer parts.free()
parts.push(_kv("title", d.title))
parts.push(_kv("version", d.version))
_opt(parts, "description", d.description)
if d.contact_name.len() > 0 or d.contact_url.len() > 0 or d.contact_email.len() > 0:
mut c := Vector {} as Vector<str>
defer c.free()
_opt(c, "name", d.contact_name)
_opt(c, "url", d.contact_url)
_opt(c, "email", d.contact_email)
parts.push(_kraw("contact", _obj(c)))
end
if d.license_name.len() > 0:
mut l := Vector {} as Vector<str>
defer l.free()
l.push(_kv("name", d.license_name))
_opt(l, "url", d.license_url)
parts.push(_kraw("license", _obj(l)))
end
ret _obj(parts)
end
func _servers(d: Doc): str:
mut parts := Vector {} as Vector<str>
defer parts.free()
repeat d.servers.len() in i:
mut s := Vector {} as Vector<str>
defer s.free()
s.push(_kv("url", d.servers.get(i)))
_opt(s, "description", d.server_notes.get(i))
parts.push(_obj(s))
end
ret _arr(parts)
end
func _param(p: Param): str:
mut parts := Vector {} as Vector<str>
defer parts.free()
parts.push(_kv("name", p.name))
parts.push(_kv("in", p.loc))
parts.push(_kraw("required", p.required ? "true" : "false"))
_opt(parts, "description", p.description)
parts.push(_kraw("schema", p.schema))
ret _obj(parts)
end
func _content(content_type: str, schema: str): str:
mut b := str.NewBuilder()
str.BufAppend(b, "{")
str.BufAppend(b, _q(content_type.len() > 0 ? content_type : JSON_TYPE))
str.BufAppend(b, ":{\"schema\":")
str.BufAppend(b, schema)
str.BufAppend(b, "}}")
ret _finish(b)
end
func _replies(o: Op): str:
mut parts := Vector {} as Vector<str>
defer parts.free()
repeat o.replies.len() in i:
rp := o.replies.get(i)
mut body := Vector {} as Vector<str>
defer body.free()
body.push(_kv("description", rp.description.len() > 0 ? rp.description : "response"))
if rp.header_names.len() > 0:
mut hs := Vector {} as Vector<str>
defer hs.free()
repeat rp.header_names.len() in h:
mut one := Vector {} as Vector<str>
defer one.free()
_opt(one, "description", rp.header_notes.get(h))
one.push(_kraw("schema", "{\"type\":\"string\"}"))
hs.push(_kraw(rp.header_names.get(h), _obj(one)))
end
body.push(_kraw("headers", _obj(hs)))
end
if rp.schema.len() > 0:
body.push(_kraw("content", _content(rp.content_type, rp.schema)))
end
parts.push(_kraw(conv.FormatInt(rp.code as i64), _obj(body)))
end
if parts.len() == 0:
ret "{\"200\":{\"description\":\"OK\"}}"
end
ret _obj(parts)
end
func _security(o: Op): str:
mut parts := Vector {} as Vector<str>
defer parts.free()
repeat o.security.len() in i:
parts.push("{".concat(_kraw(o.security.get(i), "[]")).concat("}"))
end
ret _arr(parts)
end
func _tags_of(o: Op): str:
mut parts := Vector {} as Vector<str>
defer parts.free()
repeat o.tags.len() in i:
parts.push(_q(o.tags.get(i)))
end
ret _arr(parts)
end
func _params_of(o: Op): str:
mut parts := Vector {} as Vector<str>
defer parts.free()
repeat o.params.len() in i:
parts.push(_param(o.params.get(i)))
end
ret _arr(parts)
end
func _operation(o: Op): str:
mut parts := Vector {} as Vector<str>
defer parts.free()
parts.push(_kv("operationId", o.op_id.len() > 0 ? o.op_id : _default_op_id(o.method, o.pattern)))
if o.tags.len() > 0:
parts.push(_kraw("tags", _tags_of(o)))
end
_opt(parts, "summary", o.summary)
_opt(parts, "description", o.description)
if o.is_deprecated:
parts.push(_kraw("deprecated", "true"))
end
if o.params.len() > 0:
parts.push(_kraw("parameters", _params_of(o)))
end
if o.body_schema.len() > 0:
mut rb := Vector {} as Vector<str>
defer rb.free()
_opt(rb, "description", o.body_description)
rb.push(_kraw("required", o.body_required ? "true" : "false"))
rb.push(_kraw("content", _content(o.body_content_type, o.body_schema)))
parts.push(_kraw("requestBody", _obj(rb)))
end
if o.security.len() > 0:
parts.push(_kraw("security", _security(o)))
end
parts.push(_kraw("responses", _replies(o)))
ret _obj(parts)
end
func _paths(d: Doc): str:
mut done := Vector {} as Vector<str>
defer done.free()
mut parts := Vector {} as Vector<str>
defer parts.free()
repeat d.ops.len() in i:
path := _openapi_path(d.ops.get(i).pattern)
mut seen := false
repeat done.len() in j:
if str.Equals(done.get(j), path):
seen = true
end
end
if seen:
continue
end
done.push(path)
mut methods := Vector {} as Vector<str>
defer methods.free()
repeat d.ops.len() in k:
o := d.ops.get(k)
if str.Equals(_openapi_path(o.pattern), path):
methods.push(_kraw(o.method.lower(), _operation(o)))
end
end
parts.push(_kraw(path, _obj(methods)))
end
ret _obj(parts)
end
func _scheme(s: Scheme): str:
mut parts := Vector {} as Vector<str>
defer parts.free()
parts.push(_kv("type", s.kind))
if str.Equals(s.kind, "apiKey"):
parts.push(_kv("in", s.loc))
parts.push(_kv("name", s.param.len() > 0 ? s.param : s.name))
else:
parts.push(_kv("scheme", s.scheme))
_opt(parts, "bearerFormat", s.format)
end
_opt(parts, "description", s.description)
ret _obj(parts)
end
func _components(d: Doc): str:
mut parts := Vector {} as Vector<str>
defer parts.free()
if d.defs.len() > 0:
mut schemas := Vector {} as Vector<str>
defer schemas.free()
repeat d.defs.len() in i:
schemas.push(_kraw(d.defs.get(i).name, d.defs.get(i).body))
end
parts.push(_kraw("schemas", _obj(schemas)))
end
if d.schemes.len() > 0:
mut sec := Vector {} as Vector<str>
defer sec.free()
repeat d.schemes.len() in i:
sec.push(_kraw(d.schemes.get(i).name, _scheme(d.schemes.get(i))))
end
parts.push(_kraw("securitySchemes", _obj(sec)))
end
ret _obj(parts)
end
func _tag_list(d: Doc): str:
mut seen := Vector {} as Vector<str>
defer seen.free()
mut parts := Vector {} as Vector<str>
defer parts.free()
repeat d.ops.len() in i:
o := d.ops.get(i)
repeat o.tags.len() in j:
name := o.tags.get(j)
mut have := false
repeat seen.len() in k:
if str.Equals(seen.get(k), name):
have = true
end
end
if not have:
seen.push(name)
parts.push("{".concat(_kv("name", name)).concat("}"))
end
end
end
ret _arr(parts)
end
@en "Spec"
@fa "مشخصات"
pub func Spec(d: Doc): str:
mut parts := Vector {} as Vector<str>
defer parts.free()
parts.push(_kv("openapi", "3.1.0"))
parts.push(_kraw("info", _info(d)))
if d.servers.len() > 0:
parts.push(_kraw("servers", _servers(d)))
end
tags := _tag_list(d)
if tags.len() > 2:
parts.push(_kraw("tags", tags))
end
parts.push(_kraw("paths", _paths(d)))
components := _components(d)
if components.len() > 2:
parts.push(_kraw("components", components))
end
ret _obj(parts)
end
@en "SpecIndent"
@fa "مشخصات با تورفتگی"
pub func SpecIndent(d: Doc): str:
ret json.Indent(Spec(d))
end
@en "net/http/swagger"
@fa "سواگر"
package swagger
import net.router
import encoding.json
import str
const _DEFS_PREFIX := "#/$defs/"
const _COMP_PREFIX := "#/components/schemas/"
@en "JSON_TYPE"
@fa "نوع جیسون"
pub const JSON_TYPE := "application/json"
@en "TEXT_TYPE"
@fa "نوع متن"
pub const TEXT_TYPE := "text/plain; charset=utf-8"
@en "HTML_TYPE"
@fa "نوع اچ تی ام ال"
pub const HTML_TYPE := "text/html; charset=utf-8"
@en "FORM_TYPE"
@fa "نوع فرم"
pub const FORM_TYPE := "application/x-www-form-urlencoded"
@en "TEXT_SCHEMA"
@fa "طرحواره متن"
pub const TEXT_SCHEMA := "{\"type\":\"string\"}"
@en "BINARY_SCHEMA"
@fa "طرحواره دودویی"
pub const BINARY_SCHEMA := "{\"type\":\"string\",\"format\":\"binary\"}"
@en "Param"
@fa "پارامتر"
pub struct Param:
pub name: str = ""
pub loc: str = "query"
pub required: bool = false
pub description: str = ""
pub schema: str = "{\"type\":\"string\"}"
end
@en "Reply"
@fa "پاسخ"
pub struct Reply:
pub code: int = 200
pub description: str = ""
pub schema: str = ""
pub content_type: str = "application/json"
pub header_names: Vector<str> = Vector {}
pub header_notes: Vector<str> = Vector {}
end
@en "Scheme"
@fa "طرح احراز هویت"
pub struct Scheme:
pub name: str = ""
pub kind: str = "http"
pub scheme: str = "bearer"
pub format: str = ""
pub loc: str = "header"
pub param: str = ""
pub description: str = ""
end
@en "Op"
@fa "عملیات"
pub struct Op:
pub method: str = ""
pub pattern: str = ""
pub op_id: str = ""
pub summary: str = ""
pub description: str = ""
pub is_deprecated: bool = false
pub tags: Vector<str> = Vector {}
pub params: Vector<Param> = Vector {}
pub replies: Vector<Reply> = Vector {}
pub security: Vector<str> = Vector {}
pub body_schema: str = ""
pub body_description: str = ""
pub body_required: bool = true
pub body_content_type: str = "application/json"
end
@en "Definition"
@fa "تعریف"
pub struct Definition:
pub name: str = ""
pub body: str = ""
end
@en "Doc"
@fa "سند"
pub struct Doc:
pub title: str = "API"
pub version: str = "1.0.0"
pub description: str = ""
pub servers: Vector<str> = Vector {}
pub server_notes: Vector<str> = Vector {}
pub ops: Vector<Op> = Vector {}
pub defs: Vector<Definition> = Vector {}
pub schemes: Vector<Scheme> = Vector {}
pub contact_name: str = ""
pub contact_url: str = ""
pub contact_email: str = ""
pub license_name: str = ""
pub license_url: str = ""
pub cur: int = 0 - 1
end
func _reref(schema: str): str:
ret str.Replace(schema, _DEFS_PREFIX, _COMP_PREFIX)
end
func _op_index(d &: Doc, method: str, pattern: str): int:
repeat d.ops.len() in i:
o := d.ops.get(i)
if str.Equals(o.method, method) and str.Equals(o.pattern, pattern):
ret i
end
end
ret 0 - 1
end
func _def_has(d &: Doc, name: str): bool:
repeat d.defs.len() in i:
if str.Equals(d.defs.get(i).name, name):
ret true
end
end
ret false
end
func _absorb(d &: Doc, envelope: str): str:
defs := json.Get(envelope, "defs")
if defs.len() > 2:
names := json.Keys(defs)
defer names.free()
repeat names.len() in i:
name := names.get(i)
if not _def_has(d, name):
d.defs.push(Definition { name = name, body = _reref(json.Get(defs, name)) })
end
end
end
ret _reref(json.Get(envelope, "schema"))
end
func _cur(d &: Doc): int:
if d.cur < 0 or d.cur >= d.ops.len():
ret 0 - 1
end
ret d.cur
end
func _put_param(d &: Doc, name: str, loc: str, description: str, required: bool, schema: str):
_set_param(
d, Param {
name = name, loc = loc, required = required, description = description, schema = schema
}
)
end
func _enum_schema(values: Vector<str>): str:
if values.len() == 0:
ret "{\"type\":\"string\"}"
end
mut out := "{\"type\":\"string\",\"enum\":["
repeat values.len() in i:
if i > 0:
out = out.concat(",")
end
out = out.concat(json.Str(values.get(i)))
end
ret out.concat("]}")
end
func _put_body(d &: Doc, description: str, schema: str, content_type: str, required: bool):
i := _cur(d)
if i < 0:
ret
end
mut o := d.ops.get(i)
o.body_schema = schema
o.body_description = description
o.body_content_type = content_type
o.body_required = required
d.ops.set(i, o)
end
func _set_param(d &: Doc, p: Param):
i := _cur(d)
if i < 0:
ret
end
mut o := d.ops.get(i)
repeat o.params.len() in j:
if str.Equals(o.params.get(j).name, p.name) and str.Equals(o.params.get(j).loc, p.loc):
o.params.set(j, p)
d.ops.set(i, o)
ret
end
end
o.params.push(p)
d.ops.set(i, o)
end
func _add_reply(d &: Doc, code: int, description: str, schema: str, content_type: str):
i := _cur(d)
if i < 0:
ret
end
mut o := d.ops.get(i)
r := Reply {
code = code, description = description, schema = schema, content_type = content_type
}
repeat o.replies.len() in j:
if o.replies.get(j).code == code:
o.replies.set(j, r)
d.ops.set(i, o)
ret
end
end
o.replies.push(r)
d.ops.set(i, o)
end
@en "New"
@fa "جدید"
pub func New(title: str, version: str): Doc:
ret Doc { title = title, version = version }
end
@en "Describe"
@fa "توضیح"
pub func Describe(d &: Doc, text: str):
d.description = text
end
@en "Server"
@fa "سرور"
pub func Server(d &: Doc, url: str, note: str):
d.servers.push(url)
d.server_notes.push(note)
end
@en "Contact"
@fa "تماس"
pub func Contact(d &: Doc, name: str, url: str, email: str):
d.contact_name = name
d.contact_url = url
d.contact_email = email
end
@en "License"
@fa "پروانه"
pub func License(d &: Doc, name: str, url: str):
d.license_name = name
d.license_url = url
end
@en "BearerAuth"
@fa "احراز هویت حامل"
pub func BearerAuth(d &: Doc, name: str, format: str):
d.schemes.push(Scheme { name = name, kind = "http", scheme = "bearer", format = format })
end
@en "ApiKeyAuth"
@fa "احراز هویت کلید"
pub func ApiKeyAuth(d &: Doc, name: str, loc: str, param: str):
d.schemes.push(Scheme { name = name, kind = "apiKey", loc = loc, param = param })
end
@en "Route"
@fa "مسیر"
pub func Route(d &: Doc, method: str, pattern: str): int:
verb := str.Upper(method)
hit := _op_index(d, verb, pattern)
if hit >= 0:
d.cur = hit
ret hit
end
mut o := Op { method = verb, pattern = pattern }
found := _path_params(pattern)
defer found.free()
repeat found.len() in i:
o.params.push(found.get(i))
end
d.ops.push(o)
d.cur = d.ops.len() - 1
ret d.cur
end
@en "At"
@fa "انتخاب مسیر"
pub func At(d &: Doc, method: str, pattern: str): bool:
hit := _op_index(d, str.Upper(method), pattern)
d.cur = hit
ret hit >= 0
end
@en "Summary"
@fa "خلاصه"
pub func Summary(d &: Doc, text: str):
i := _cur(d)
if i < 0:
ret
end
mut o := d.ops.get(i)
o.summary = text
d.ops.set(i, o)
end
@en "Details"
@fa "جزئیات"
pub func Details(d &: Doc, text: str):
i := _cur(d)
if i < 0:
ret
end
mut o := d.ops.get(i)
o.description = text
d.ops.set(i, o)
end
@en "Tag"
@fa "برچسب"
pub func Tag(d &: Doc, name: str):
i := _cur(d)
if i < 0:
ret
end
mut o := d.ops.get(i)
o.tags.push(name)
d.ops.set(i, o)
end
@en "OperationId"
@fa "شناسه عملیات"
pub func OperationId(d &: Doc, id: str):
i := _cur(d)
if i < 0:
ret
end
mut o := d.ops.get(i)
o.op_id = id
d.ops.set(i, o)
end
@en "Deprecated"
@fa "منسوخ"
pub func Deprecated(d &: Doc):
i := _cur(d)
if i < 0:
ret
end
mut o := d.ops.get(i)
o.is_deprecated = true
d.ops.set(i, o)
end
@en "Secure"
@fa "امن"
pub func Secure(d &: Doc, scheme: str):
i := _cur(d)
if i < 0:
ret
end
mut o := d.ops.get(i)
o.security.push(scheme)
d.ops.set(i, o)
end
@en "Query"
@fa "پرسمان"
pub func Query(d &: Doc, name: str, description: str, required: bool):
_put_param(d, name, "query", description, required, "{\"type\":\"string\"}")
end
@en "QueryTyped"
@fa "پرسمان نوع دار"
pub func QueryTyped<T>(d &: Doc, name: str, description: str, required: bool, sample: T):
_put_param(d, name, "query", description, required, _absorb(d, json.SchemaEnvelope(sample)))
end
@en "QueryEnum"
@fa "پرسمان گزینه ای"
pub func QueryEnum(
d &: Doc, name: str, description: str, required: bool, values: Vector<str>
):
_put_param(d, name, "query", description, required, _enum_schema(values))
end
@en "Header"
@fa "سرصفحه"
pub func Header(d &: Doc, name: str, description: str, required: bool):
_put_param(d, name, "header", description, required, "{\"type\":\"string\"}")
end
@en "Cookie"
@fa "کوکی"
pub func Cookie(d &: Doc, name: str, description: str, required: bool):
_put_param(d, name, "cookie", description, required, "{\"type\":\"string\"}")
end
@en "PathParam"
@fa "پارامتر مسیر"
pub func PathParam(d &: Doc, name: str, description: str):
_put_param(d, name, "path", description, true, "{\"type\":\"string\"}")
end
@en "Accepts"
@fa "می پذیرد"
pub func Accepts<T>(d &: Doc, description: str, sample: T):
_put_body(d, description, _absorb(d, json.SchemaEnvelope(sample)), JSON_TYPE, true)
end
@en "AcceptsOptional"
@fa "می پذیرد اختیاری"
pub func AcceptsOptional<T>(d &: Doc, description: str, sample: T):
_put_body(d, description, _absorb(d, json.SchemaEnvelope(sample)), JSON_TYPE, false)
end
@en "AcceptsRaw"
@fa "می پذیرد خام"
pub func AcceptsRaw(d &: Doc, description: str, content_type: str, schema: str, required: bool):
_put_body(d, description, schema, content_type, required)
end
@en "AcceptsForm"
@fa "می پذیرد فرم"
pub func AcceptsForm<T>(d &: Doc, description: str, sample: T):
_put_body(d, description, _absorb(d, json.SchemaEnvelope(sample)), FORM_TYPE, true)
end
@en "Returns"
@fa "برمی گرداند"
pub func Returns<T>(d &: Doc, code: int, description: str, sample: T):
_add_reply(d, code, description, _absorb(d, json.SchemaEnvelope(sample)), JSON_TYPE)
end
@en "ReturnsRaw"
@fa "برمی گرداند خام"
pub func ReturnsRaw(d &: Doc, code: int, description: str, content_type: str, schema: str):
_add_reply(d, code, description, schema, content_type)
end
@en "ReturnsText"
@fa "برمی گرداند متن"
pub func ReturnsText(d &: Doc, code: int, description: str):
_add_reply(d, code, description, TEXT_SCHEMA, TEXT_TYPE)
end
@en "ReturnsHtml"
@fa "برمی گرداند اچ تی ام ال"
pub func ReturnsHtml(d &: Doc, code: int, description: str):
_add_reply(d, code, description, TEXT_SCHEMA, HTML_TYPE)
end
@en "ReturnsFile"
@fa "برمی گرداند پرونده"
pub func ReturnsFile(d &: Doc, code: int, description: str, content_type: str):
_add_reply(d, code, description, BINARY_SCHEMA, content_type)
end
@en "ReturnsHeader"
@fa "برمی گرداند سرصفحه"
pub func ReturnsHeader(d &: Doc, code: int, name: str, description: str):
i := _cur(d)
if i < 0:
ret
end
mut o := d.ops.get(i)
mut at_slot := 0 - 1
repeat o.replies.len() in j:
if o.replies.get(j).code == code:
at_slot = j
end
end
if at_slot < 0:
o.replies.push(Reply { code = code, description = "", schema = "", content_type = "" })
at_slot = o.replies.len() - 1
end
mut rp := o.replies.get(at_slot)
repeat rp.header_names.len() in k:
if str.Equals(rp.header_names.get(k), name):
rp.header_notes.set(k, description)
o.replies.set(at_slot, rp)
d.ops.set(i, o)
ret
end
end
rp.header_names.push(name)
rp.header_notes.push(description)
o.replies.set(at_slot, rp)
d.ops.set(i, o)
end
@en "ReturnsNothing"
@fa "بدون بدنه برمی گرداند"
pub func ReturnsNothing(d &: Doc, code: int, description: str):
_add_reply(d, code, description, "", "")
end
package swagger
import encoding.json
import str
const _PAGE_HEAD := `<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>__TITLE__</title>
<style>
:root {
  --bg: #ffffff; --fg: #11181c; --muted: #5c6b73; --line: #e3e8ec;
  --card: #f7f9fa; --accent: #2b6cb0; --code: #f1f4f6;
  --get: #1a7f5a; --post: #2b6cb0; --put: #9a6700; --patch: #7a4bbd;
  --delete: #b42318; --other: #5c6b73;
}
@media (prefers-color-scheme: dark) {
  :root {
    --bg: #0f1417; --fg: #e6edf3; --muted: #93a1ad; --line: #263039;
    --card: #161c21; --accent: #6ba6e8; --code: #12181d;
    --get: #4ec99a; --post: #6ba6e8; --put: #e0b341; --patch: #b18cf0;
    --delete: #f0776a; --other: #93a1ad;
  }
}
* { box-sizing: border-box; }
body {
  margin: 0; background: var(--bg); color: var(--fg);
  font: 15px/1.55 ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
}
code, pre, .mono { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
.wrap { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem 6rem; }
header h1 { margin: 0 0 .25rem; font-size: 1.65rem; letter-spacing: -.01em; }
.ver {
  display: inline-block; padding: .1rem .45rem; border: 1px solid var(--line);
  border-radius: 99px; font-size: .78rem; color: var(--muted); vertical-align: .18em;
}
.desc { color: var(--muted); margin: .4rem 0 0; }
.bar {
  display: flex; gap: .6rem; align-items: center; flex-wrap: wrap;
  margin: 1.25rem 0 .5rem; padding: .7rem .8rem;
  background: var(--card); border: 1px solid var(--line); border-radius: 8px;
}
.bar label { font-size: .8rem; color: var(--muted); }
select, input[type=text], input[type=search], textarea {
  font: inherit; color: inherit; background: var(--bg);
  border: 1px solid var(--line); border-radius: 6px; padding: .3rem .45rem;
}
input[type=search] { flex: 1 1 12rem; min-width: 8rem; }
textarea { width: 100%; min-height: 7rem; resize: vertical; }
h2.tag {
  margin: 2rem 0 .6rem; padding-bottom: .35rem; font-size: 1.05rem;
  border-bottom: 1px solid var(--line); text-transform: uppercase;
  letter-spacing: .06em; color: var(--muted);
}
.op { border: 1px solid var(--line); border-radius: 8px; margin: .5rem 0; overflow: hidden; }
.op > summary {
  display: flex; gap: .6rem; align-items: center; cursor: pointer;
  padding: .6rem .75rem; list-style: none; background: var(--card);
}
.op > summary::-webkit-details-marker { display: none; }
.m {
  flex: none; min-width: 4.4rem; text-align: center; padding: .12rem .4rem;
  border-radius: 5px; font-size: .74rem; font-weight: 700; letter-spacing: .05em;
  color: #fff; background: var(--other);
}
.m.get { background: var(--get); } .m.post { background: var(--post); }
.m.put { background: var(--put); } .m.patch { background: var(--patch); }
.m.delete { background: var(--delete); }
.path { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: .92rem; }
.sum { color: var(--muted); font-size: .88rem; margin-left: auto; text-align: right; }
.dep { text-decoration: line-through; opacity: .65; }
.body { padding: .85rem .95rem 1rem; border-top: 1px solid var(--line); }
h3 { font-size: .8rem; text-transform: uppercase; letter-spacing: .06em;
     color: var(--muted); margin: 1.1rem 0 .4rem; }
h3:first-child { margin-top: 0; }
table { width: 100%; border-collapse: collapse; font-size: .9rem; }
th, td { text-align: left; padding: .35rem .5rem; border-bottom: 1px solid var(--line);
         vertical-align: top; }
th { font-size: .76rem; text-transform: uppercase; letter-spacing: .05em; color: var(--muted); }
.req { color: var(--delete); font-weight: 700; }
.ty { color: var(--accent); }
.note { color: var(--muted); }
pre {
  margin: 0; padding: .6rem .7rem; background: var(--code);
  border: 1px solid var(--line); border-radius: 6px;
  overflow-x: auto; font-size: .85rem;
}
.schema { font-size: .87rem; display: inline-block; vertical-align: top; }
.schema ul { margin: .15rem 0 .15rem .4rem; padding-left: .8rem;
             border-left: 1px solid var(--line); list-style: none; }
.schema li { padding: .07rem 0; }
.schema .note { display: block; }
.k { color: var(--fg); font-weight: 600; }
.status { display: inline-block; min-width: 2.6rem; font-weight: 700; }
.s2 { color: var(--get); } .s3 { color: var(--put); }
.s4 { color: var(--delete); } .s5 { color: var(--delete); }
button {
  font: inherit; cursor: pointer; padding: .35rem .8rem; border-radius: 6px;
  border: 1px solid var(--accent); background: var(--accent); color: #fff;
}
button.ghost { background: transparent; color: var(--accent); }
.try { margin-top: .6rem; display: flex; gap: .5rem; align-items: center; flex-wrap: wrap; }
.out { margin-top: .55rem; }
.empty { color: var(--muted); padding: 2rem 0; }
footer { margin-top: 3rem; color: var(--muted); font-size: .82rem;
         border-top: 1px solid var(--line); padding-top: .8rem; }
a { color: var(--accent); }
</style>
</head>
<body>
<div class="wrap">
<header id="head"></header>
<div class="bar">
  <label for="srv">Server</label><select id="srv"></select>
  <input id="q" type="search" placeholder="Filter by path, method or summary">
  <label for="auth">Auth</label>
  <input id="auth" type="text" placeholder="Bearer token" style="flex:0 1 14rem">
  <button id="expand" class="ghost" type="button">Expand all</button>
</div>
<main id="main"></main>
<footer>Rendered by <a href="https://github.com/SalamLang/Salam">Salam</a>
  <code>net/http/swagger</code> (<a id="raw">OpenAPI document</a>)
  &middot; <a href="https://www.salamlang.ir">salamlang.ir</a></footer>
</div>
<script>
"use strict";
// Where the OpenAPI document is. Empty means "next to this page", which is
// how Mount and Serve leave it: the page is at /docs, /docs/ or /, and only
// the page itself knows which of those it was actually fetched as.
var SPEC_URL = "__SPEC_JS__";
if (!SPEC_URL) {
  var here = location.pathname.replace(/\/+$/, "");
  // "/docs" and "/docs/" are directories and the spec sits under them;
  // "/docs/index.html" is a file and the spec sits beside it. A dot in the
  // last segment is what tells the two apart, which is the same guess a
  // browser makes when it resolves a relative link.
  if (/\/[^\/]*\.[^\/]*$/.test(here)) here = here.replace(/\/[^\/]*$/, "");
  SPEC_URL = here + "/openapi.json";
}
var spec = null;

function el(tag, cls, text) {
  var n = document.createElement(tag);
  if (cls) n.className = cls;
  if (text !== undefined && text !== null) n.textContent = String(text);
  return n;
}

// $ref resolution against the document, with a depth cap. A schema may point
// at itself (a tree node whose children are tree nodes), so the renderer
// cannot simply follow every ref it meets - it stops and prints the name.
function deref(s) {
  var seen = 0;
  while (s && s.$ref && seen < 32) {
    var p = String(s.$ref);
    if (p.indexOf("#/") !== 0) return s;
    var cur = spec;
    var parts = p.slice(2).split("/");
    for (var i = 0; i < parts.length && cur; i++) {
      cur = cur[parts[i].replace(/~1/g, "/").replace(/~0/g, "~")];
    }
    if (!cur) return s;
    s = cur;
    seen++;
  }
  return s;
}

function refName(s) {
  if (!s || !s.$ref) return null;
  var p = String(s.$ref).split("/");
  return p[p.length - 1];
}

// A one-line type for a schema: "string", "Todo[]", "integer<int64>",
// "string | null". Enough to read a parameter table without expanding
// anything.
function typeName(s, depth) {
  depth = depth || 0;
  if (!s) return "any";
  if (s.$ref) return refName(s);
  if (depth > 6) return "...";
  var alt = s.anyOf || s.oneOf;
  if (alt) return alt.map(function (x) { return typeName(x, depth + 1); }).join(" | ");
  if (s.allOf) return s.allOf.map(function (x) { return typeName(x, depth + 1); }).join(" & ");
  var t = s.type;
  if (Array.isArray(t)) return t.join(" | ");
  if (t === "array") return typeName(s.items, depth + 1) + "[]";
  if (t === "object" || (!t && s.properties)) {
    if (s.title) return s.title;
    if (s.additionalProperties && s.additionalProperties !== true) {
      return "map<string, " + typeName(s.additionalProperties, depth + 1) + ">";
    }
    return "object";
  }
  if (!t) return s.enum ? "enum" : "any";
  return s.format ? t + "<" + s.format + ">" : t;
}

// The expandable tree under a request or response. 'seen' carries the refs on
// the current path so a self-referential schema renders one level and stops
// instead of looping.
function schemaTree(s, seen, depth) {
  seen = seen || [];
  depth = depth || 0;
  var box = el("div", "schema");
  if (!s) { box.appendChild(el("span", "note", "any")); return box; }
  var name = refName(s);
  if (name && seen.indexOf(name) >= 0) {
    box.appendChild(el("span", "ty", name + " (recursive)"));
    return box;
  }
  var next = name ? seen.concat([name]) : seen;
  var r = deref(s);
  if (depth > 12) { box.appendChild(el("span", "note", "...")); return box; }

  var head = el("span", "ty", typeName(s));
  box.appendChild(head);
  if (r.description) box.appendChild(el("div", "note", r.description));
  if (r.enum) {
    box.appendChild(el("div", "note", "one of: " + r.enum.join(", ")));
    return box;
  }
  var alt = r.anyOf || r.oneOf || r.allOf;
  if (alt) {
    var ul = el("ul");
    alt.forEach(function (x) {
      var li = el("li");
      li.appendChild(schemaTree(x, next, depth + 1));
      ul.appendChild(li);
    });
    box.appendChild(ul);
    return box;
  }
  if (r.type === "array" || r.items) {
    var ul2 = el("ul");
    var li2 = el("li");
    li2.appendChild(schemaTree(r.items, next, depth + 1));
    ul2.appendChild(li2);
    box.appendChild(ul2);
    return box;
  }
  if (r.properties) {
    var req = r.required || [];
    var ul3 = el("ul");
    Object.keys(r.properties).forEach(function (k) {
      var li = el("li");
      li.appendChild(el("span", "k", k));
      if (req.indexOf(k) >= 0) {
        li.appendChild(document.createTextNode(" "));
        li.appendChild(el("span", "req", "*"));
      }
      li.appendChild(document.createTextNode(" "));
      li.appendChild(schemaTree(r.properties[k], next, depth + 1));
      ul3.appendChild(li);
    });
    box.appendChild(ul3);
    if (r.additionalProperties === false) box.appendChild(el("div", "note", "no other keys"));
    return box;
  }
  if (r.additionalProperties && r.additionalProperties !== true) {
    var ul4 = el("ul");
    var li4 = el("li");
    li4.appendChild(el("span", "k", "<any key>"));
    li4.appendChild(document.createTextNode(" "));
    li4.appendChild(schemaTree(r.additionalProperties, next, depth + 1));
    ul4.appendChild(li4);
    box.appendChild(ul4);
  }
  return box;
}

// A worked example built from the schema, so the try-it-out box starts with a
// body of the right shape instead of an empty one.
function sample(s, seen, depth) {
  seen = seen || [];
  depth = depth || 0;
  if (!s || depth > 8) return null;
  var name = refName(s);
  if (name && seen.indexOf(name) >= 0) return null;
  var next = name ? seen.concat([name]) : seen;
  var r = deref(s);
  if (r.default !== undefined) return r.default;
  if (r.enum && r.enum.length) return r.enum[0];
  if (r.anyOf || r.oneOf) return sample((r.anyOf || r.oneOf)[0], next, depth + 1);
  if (r.allOf) return sample(r.allOf[0], next, depth + 1);
  var t = Array.isArray(r.type) ? r.type[0] : r.type;
  if (t === "array" || r.items) {
    var one = sample(r.items, next, depth + 1);
    return one === null ? [] : [one];
  }
  if (r.properties) {
    var o = {};
    Object.keys(r.properties).forEach(function (k) {
      o[k] = sample(r.properties[k], next, depth + 1);
    });
    return o;
  }
  if (t === "object") return {};
  if (t === "integer") return 0;
  if (t === "number") return 0;
  if (t === "boolean") return false;
  if (t === "null") return null;
  if (t === "string") return r.format ? r.format : "";
  return null;
}

function statusClass(code) {
  var n = parseInt(code, 10);
  if (n >= 200 && n < 300) return "s2";
  if (n >= 300 && n < 400) return "s3";
  if (n >= 400 && n < 500) return "s4";
  if (n >= 500) return "s5";
  return "";
}

function jsonSchemaOf(holder) {
  var b = bodyOf(holder);
  return b ? b.schema : null;
}

// The one representation of a request or response body this page shows: JSON
// when the operation offers it, otherwise whatever it does offer. The media
// type comes back too, because a body that is a PNG or a form is a different
// thing to send than the same schema in JSON would be.
function bodyOf(holder) {
  if (!holder || !holder.content) return null;
  var c = holder.content;
  var keys = Object.keys(c);
  if (!keys.length) return null;
  var key = keys.filter(function (k) { return k.indexOf("json") >= 0; })[0] || keys[0];
  return { type: key, schema: c[key] ? c[key].schema : null };
}

function paramTable(params) {
  var t = el("table");
  var hr = el("tr");
  ["Name", "In", "Type", "Description"].forEach(function (h) { hr.appendChild(el("th", null, h)); });
  t.appendChild(hr);
  params.forEach(function (p) {
    var tr = el("tr");
    var td = el("td");
    td.appendChild(el("span", "mono k", p.name));
    if (p.required) {
      td.appendChild(document.createTextNode(" "));
      td.appendChild(el("span", "req", "*"));
    }
    tr.appendChild(td);
    tr.appendChild(el("td", "note", p.in));
    tr.appendChild(el("td", "ty mono", typeName(p.schema)));
    var note = el("td", "note", p.description || "");
    var choices = deref(p.schema || {}).enum;
    if (choices && choices.length) {
      note.appendChild(el("div", null, "one of: " + choices.join(", ")));
    }
    tr.appendChild(note);
    t.appendChild(tr);
  });
  return t;
}

// The try-it-out form. Path parameters become inputs, query parameters become
// inputs, and a body-carrying method gets a textarea seeded from the schema.
function tryBox(method, path, op) {
  var wrap = el("div");
  var params = op.parameters || [];
  var inputs = {};
  if (params.length) {
    var grid = el("div", "try");
    params.forEach(function (p) {
      var choices = deref(p.schema || {}).enum;
      var i;
      if (choices && choices.length) {
        // A parameter with a fixed set of values is a menu. The blank first
        // option is "do not send this at all", which is a different request
        // from sending the first value.
        i = el("select");
        i.appendChild(el("option", null, p.required ? "choose" : "(omit)"));
        i.firstChild.value = "";
        choices.forEach(function (c) {
          var o = el("option", null, String(c));
          o.value = String(c);
          i.appendChild(o);
        });
      } else {
        i = el("input");
        i.type = "text";
        i.placeholder = p.name + (p.required ? " *" : "");
        i.size = 12;
      }
      inputs[p.in + ":" + p.name] = i;
      var lab = el("label", null, p.name);
      lab.style.display = "inline-flex";
      lab.style.gap = ".3rem";
      lab.style.alignItems = "center";
      lab.appendChild(i);
      grid.appendChild(lab);
    });
    wrap.appendChild(grid);
  }
  var bodyArea = null;
  var reqBody = bodyOf(op.requestBody);
  var bodySchema = reqBody ? reqBody.schema : null;
  var bodyType = (reqBody && reqBody.type) || "application/json";
  if (bodySchema) {
    bodyArea = el("textarea");
    var s = sample(bodySchema);
    bodyArea.value = s === null ? "{}" : JSON.stringify(s, null, 2);
    wrap.appendChild(bodyArea);
  }
  var row = el("div", "try");
  var go = el("button", null, "Send");
  var copy = el("button", "ghost", "Copy as curl");
  var out = el("div", "out");
  row.appendChild(go);
  row.appendChild(copy);
  wrap.appendChild(row);
  wrap.appendChild(out);

  // One place decides what the request is, so the curl the page prints is the
  // request the page sends and not a second guess at it.
  function compose() {
    var url = path;
    var qs = [];
    var headers = {};
    params.forEach(function (p) {
      var v = inputs[p.in + ":" + p.name].value;
      if (!v) return;
      if (p.in === "path") url = url.split("{" + p.name + "}").join(encodeURIComponent(v));
      else if (p.in === "query") qs.push(encodeURIComponent(p.name) + "=" + encodeURIComponent(v));
      else if (p.in === "header") headers[p.name] = v;
      else if (p.in === "cookie") {
        headers["Cookie"] = (headers["Cookie"] ? headers["Cookie"] + "; " : "")
          + p.name + "=" + v;
      }
    });
    var base = document.getElementById("srv").value || "";
    if (base.charAt(base.length - 1) === "/") base = base.slice(0, -1);
    var full = base + url + (qs.length ? "?" + qs.join("&") : "");
    var tok = document.getElementById("auth").value.trim();
    if (tok) headers["Authorization"] = tok.indexOf(" ") > 0 ? tok : "Bearer " + tok;
    var body = bodyArea && bodyArea.value.trim() ? bodyArea.value : null;
    if (body !== null) headers["Content-Type"] = bodyType;
    return { url: full, method: method.toUpperCase(), headers: headers, body: body };
  }

  // Single quotes, with the shell's own escape for a single quote inside one.
  // Nothing else needs escaping between them.
  function shq(v) {
    return "'" + String(v).split("'").join("'\\''") + "'";
  }

  function asCurl(req) {
    var parts = ["curl"];
    if (req.method !== "GET") parts.push("-X " + req.method);
    parts.push(shq(req.url));
    Object.keys(req.headers).forEach(function (k) {
      parts.push("-H " + shq(k + ": " + req.headers[k]));
    });
    if (req.body !== null) parts.push("--data " + shq(req.body));
    return parts.join(" \\\n  ");
  }

  copy.onclick = function () {
    var text = asCurl(compose());
    out.textContent = "";
    var pre = el("pre", null, text);
    out.appendChild(pre);
    // The clipboard needs a secure context, and a documentation page is as
    // often on plain http as not - so the command is on the page either way,
    // and copying it is the bonus rather than the mechanism.
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(text).then(function () {
        out.appendChild(el("div", "note", "copied to the clipboard"));
      }, function () {});
    }
  };

  go.onclick = function () {
    var req = compose();
    out.textContent = "";
    out.appendChild(el("div", "note", "sending..."));
    fetch(req.url, { method: req.method, headers: req.headers, body: req.body })
      .then(function (res) {
        return res.text().then(function (text) { return { res: res, text: text }; });
      }).then(function (r) {
        out.textContent = "";
        var line = el("div");
        line.appendChild(el("span", "status " + statusClass(r.res.status), r.res.status));
        line.appendChild(document.createTextNode(" " + r.res.statusText));
        var ct = r.res.headers.get("content-type");
        if (ct) line.appendChild(el("span", "note", "   " + ct));
        out.appendChild(line);
        var pre = el("pre");
        try { pre.textContent = JSON.stringify(JSON.parse(r.text), null, 2); }
        catch (e) { pre.textContent = r.text; }
        out.appendChild(pre);
      }).catch(function (e) {
        out.textContent = "";
        out.appendChild(el("div", "req", "request failed: " + e.message));
        out.appendChild(el("div", "note",
          "A cross-origin request needs the API to send Access-Control-Allow-Origin."));
      });
  };
  return wrap;
}

// A stable id for one operation, so a link to it survives a reload and can be
// pasted into a chat: "#op-get-api-todos-id".
function opAnchor(path, method) {
  return "op-" + (method + path).toLowerCase().replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");
}

function opCard(path, method, op) {
  var d = el("details", "op");
  d.id = opAnchor(path, method);
  var sm = el("summary");
  sm.appendChild(el("span", "m " + method, method.toUpperCase()));
  sm.appendChild(el("span", "path" + (op.deprecated ? " dep" : ""), path));
  if (op.summary) sm.appendChild(el("span", "sum", op.summary));
  // Opening an operation puts it in the address bar; closing it takes it out
  // again, so the URL always names what is actually open.
  d.addEventListener("toggle", function () {
    if (d.open) {
      if (location.hash !== "#" + d.id) history.replaceState(null, "", "#" + d.id);
    } else if (location.hash === "#" + d.id) {
      history.replaceState(null, "", location.pathname + location.search);
    }
  });
  d.appendChild(sm);

  var b = el("div", "body");
  if (op.description) b.appendChild(el("p", "note", op.description));
  if (op.deprecated) b.appendChild(el("p", "req", "Deprecated."));
  if (op.security && op.security.length) {
    var names = op.security.map(function (s) { return Object.keys(s).join(", "); }).join(", ");
    b.appendChild(el("p", "note", "Requires: " + names));
  }
  if (op.parameters && op.parameters.length) {
    b.appendChild(el("h3", null, "Parameters"));
    b.appendChild(paramTable(op.parameters));
  }
  var req = bodyOf(op.requestBody);
  if (req && req.schema) {
    b.appendChild(el("h3", null,
      "Request body" + (op.requestBody.required === false ? " (optional)" : "")));
    if (op.requestBody.description) b.appendChild(el("p", "note", op.requestBody.description));
    b.appendChild(el("div", "note mono", req.type));
    b.appendChild(schemaTree(req.schema));
  }
  var responses = op.responses || {};
  var codes = Object.keys(responses);
  if (codes.length) {
    b.appendChild(el("h3", null, "Responses"));
    codes.sort().forEach(function (code) {
      var r = responses[code] || {};
      var row = el("div");
      row.style.margin = ".45rem 0";
      var head = el("div");
      head.appendChild(el("span", "status " + statusClass(code), code));
      head.appendChild(document.createTextNode(" " + (r.description || "")));
      row.appendChild(head);
      if (r.headers) {
        Object.keys(r.headers).forEach(function (h) {
          var hd = el("div", "note");
          hd.appendChild(el("span", "mono k", h));
          var note = r.headers[h] && r.headers[h].description;
          if (note) hd.appendChild(document.createTextNode("  " + note));
          row.appendChild(hd);
        });
      }
      var rb = bodyOf(r);
      if (rb && rb.schema) {
        if (rb.type !== "application/json") row.appendChild(el("div", "note mono", rb.type));
        row.appendChild(schemaTree(rb.schema));
      }
      b.appendChild(row);
    });
  }
  b.appendChild(el("h3", null, "Try it"));
  b.appendChild(tryBox(method, path, op));
  d.appendChild(b);
  return d;
}

var METHODS = ["get", "post", "put", "patch", "delete", "head", "options", "trace"];

function collect() {
  var out = [];
  var paths = spec.paths || {};
  Object.keys(paths).forEach(function (p) {
    METHODS.forEach(function (m) {
      if (paths[p][m]) out.push({ path: p, method: m, op: paths[p][m] });
    });
  });
  return out;
}

// The operation named in the address bar, opened and scrolled to. Runs after
// every render, because rendering rebuilds the cards and a filter that hides
// the named one should simply leave nothing to open.
function openFromHash() {
  if (!location.hash) return;
  var target = document.getElementById(location.hash.slice(1));
  if (!target) return;
  target.open = true;
  target.scrollIntoView({ block: "start" });
}

function render() {
  var head = document.getElementById("head");
  head.textContent = "";
  var info = spec.info || {};
  var h1 = el("h1", null, info.title || "API");
  if (info.version) {
    h1.appendChild(document.createTextNode(" "));
    h1.appendChild(el("span", "ver", "v" + info.version));
  }
  head.appendChild(h1);
  if (info.description) head.appendChild(el("p", "desc", info.description));
  if (info.contact && (info.contact.url || info.contact.email)) {
    var p = el("p", "desc");
    var a = el("a", null, info.contact.name || info.contact.url || info.contact.email);
    a.href = info.contact.url || ("mailto:" + info.contact.email);
    p.appendChild(a);
    head.appendChild(p);
  }

  var srv = document.getElementById("srv");
  srv.textContent = "";
  var servers = (spec.servers && spec.servers.length) ? spec.servers : [{ url: location.origin }];
  servers.forEach(function (s) {
    var o = el("option", null, s.url + (s.description ? "  (" + s.description + ")" : ""));
    o.value = s.url;
    srv.appendChild(o);
  });

  var all = collect();
  var filter = document.getElementById("q").value.trim().toLowerCase();
  var shown = all.filter(function (x) {
    if (!filter) return true;
    return (x.path + " " + x.method + " " + (x.op.summary || "")).toLowerCase().indexOf(filter) >= 0;
  });

  var main = document.getElementById("main");
  main.textContent = "";
  if (!shown.length) {
    main.appendChild(el("p", "empty", all.length ? "Nothing matches that filter."
                                                 : "This document has no operations."));
    return;
  }
  // Section order follows the document's own 'tags' list, then any tag only an
  // operation mentions, then the untagged ones.
  var order = (spec.tags || []).map(function (t) { return t.name; });
  shown.forEach(function (x) {
    (x.op.tags || []).forEach(function (t) { if (order.indexOf(t) < 0) order.push(t); });
  });
  order.push(null);
  order.forEach(function (tag) {
    var group = shown.filter(function (x) {
      var tags = x.op.tags || [];
      return tag === null ? tags.length === 0 : tags.indexOf(tag) >= 0;
    });
    if (!group.length) return;
    if (tag !== null || order.length > 1) {
      main.appendChild(el("h2", "tag", tag === null ? "Other" : tag));
    }
    group.forEach(function (x) { main.appendChild(opCard(x.path, x.method, x.op)); });
  });
}

document.getElementById("q").addEventListener("input", function () {
  if (spec) render();
});

// One button rather than two: what it does next is whatever is not already
// the case, which is also what its label says.
document.getElementById("expand").addEventListener("click", function () {
  var all = document.querySelectorAll("details.op");
  var anyClosed = false;
  all.forEach(function (d) { if (!d.open) anyClosed = true; });
  all.forEach(function (d) { d.open = anyClosed; });
  this.textContent = anyClosed ? "Collapse all" : "Expand all";
});

document.getElementById("raw").href = SPEC_URL;

fetch(SPEC_URL).then(function (r) {
  if (!r.ok) throw new Error("HTTP " + r.status);
  return r.json();
}).then(function (doc) {
  spec = doc;
  render();
  openFromHash();
}).catch(function (e) {
  var main = document.getElementById("main");
  main.textContent = "";
  main.appendChild(el("p", "req", "Could not load " + SPEC_URL + ": " + e.message));
});
</script>
</body>
</html>
`
func _escape_html(s: str): str:
mut out := str.Replace(s, "&", "&amp;")
out = str.Replace(out, "<", "&lt;")
out = str.Replace(out, ">", "&gt;")
ret str.Replace(out, "\"", "&quot;")
end
func _escape_js(s: str): str:
quoted := json.Str(s)
mut out := quoted.substr(1, quoted.len() - 2)
out = str.Replace(out, "<", "\\u003c")
ret str.Replace(out, ">", "\\u003e")
end
@en "Page"
@fa "صفحه"
pub func Page(title: str, spec_url: str): str:
out := str.Replace(_PAGE_HEAD, "__TITLE__", _escape_html(title))
ret str.Replace(out, "__SPEC_JS__", _escape_js(spec_url))
end
@en "validate"
@fa "اعتبارسنجی"
package validate
import net.http
import regex
import str
@en "Required"
@fa "الزامی"
pub func Required(value: str): bool:
ret len(value) > 0
end
@en "Length"
@fa "طول"
pub func Length(value: str, min_len: int, max_len: int): bool:
l := str.CharCount(value)
ret l >= min_len and l <= max_len
end
@en "IsEmail"
@fa "ایمیل است"
pub func IsEmail(value: str): bool:
if value.find("@") < 0:
ret false
end
if value.find(".") < 0:
ret false
end
ret true
end
@en "Matches"
@fa "تطابق دارد"
pub func Matches(value: str, pattern: str): bool:
ret regex.MatchStr(pattern, value)
end
@en "Assert"
@fa "ادعا"
pub func Assert(ctx: i64, ok: bool, message: str):
if ok:
ret
end
http.Ctx_status(ctx, 400)
http.Ctx_json(ctx, `{"error":"` + message + `"}`)
end
package http2
import compress
@en "H2_POLL_ERROR"
@fa "نتیجه خطا"
pub const H2_POLL_ERROR := 0 - 1
@en "H2_POLL_CONNECTION"
@fa "نتیجه اتصال"
pub const H2_POLL_CONNECTION := 0
@en "Stream"
@fa "جریان اچ تی تی پی"
pub struct Stream:
pub id: int = 0
pub state: int = 0
pub send_window: int = 65535
pub recv_window: int = 65535
pub headers: HeaderList = HeaderList {}
pub trailers: HeaderList = HeaderList {}
pub data: compress.ByteBuf = compress.ByteBuf {}
pub got_headers: bool = false
pub got_trailers: bool = false
pub end_stream: bool = false
pub reset: bool = false
pub error_code: int = 0
pub live: bool = false
end
@en "StreamTable"
@fa "جدول جریان‌ها"
pub struct StreamTable:
pub items: Vector<Stream> = Vector {}
end
@en "Conn"
@fa "اتصال اچ تی تی پی۲"
pub struct Conn:
pub tx: Transport = Transport {}
pub is_server: bool = false
pub enc: DynTable = DynTable {}
pub dec: DynTable = DynTable {}
pub local: Settings = Settings {}
pub remote: Settings = Settings {}
pub next_id: int = 1
pub streams: StreamTable = StreamTable {}
pub send_window: int = 65535
pub recv_window: int = 65535
pub goaway: bool = false
pub last_error: int = 0
pub ok: bool = false
pub pending_stream: int = 0
pub pending_block: compress.ByteBuf = compress.ByteBuf {}
pub pending_end_stream: bool = false
pub pending_trailers: bool = false
end
func _find_stream(c: Conn, id: int): int:
mut i := 0
until i < c.streams.items.len():
if c.streams.items.get(i).id == id: ret i end
i += 1
end
ret 0 - 1
end
func _ensure_stream(c &: Conn, id: int): int:
idx := _find_stream(c, id)
if idx >= 0: ret idx end
mut s := Stream {}
s.id = id
s.state = H2_STREAM_OPEN
s.send_window = c.remote.initial_window_size
s.recv_window = c.local.initial_window_size
s.data = compress.NewByteBuf()
s.live = true
c.streams.items.push(s)
ret c.streams.items.len() - 1
end
func _store(c &: Conn, idx: int, s: Stream):
c.streams.items.set(idx, s)
end
func _maybe_window_update(c &: Conn, id: int, idx: int):
half := c.local.initial_window_size / 2
mut s := c.streams.items.get(idx)
if s.recv_window < half:
inc := c.local.initial_window_size - s.recv_window
mut wf := MakeWindowUpdate(id, inc)
WriteFrame(c.tx, wf)
FreeFrame(wf)
s.recv_window += inc
_store(c, idx, s)
end
if c.recv_window < half:
inc := c.local.initial_window_size - c.recv_window
mut cf := MakeWindowUpdate(0, inc)
WriteFrame(c.tx, cf)
FreeFrame(cf)
c.recv_window += inc
end
end
func _deliver_block(c &: Conn): int:
id := c.pending_stream
idx := _ensure_stream(c, id)
mut ok := false
hl := DecodeHeaderList(c.dec, c.pending_block, ok)
compress.BufFree(c.pending_block)
c.pending_block = compress.NewByteBuf()
c.pending_stream = 0
mut s := c.streams.items.get(idx)
if not ok:
c.last_error = H2_COMPRESSION_ERROR
c.ok = false
s.reset = true
s.error_code = H2_COMPRESSION_ERROR
_store(c, idx, s)
ret id
end
if c.pending_trailers:
s.trailers = hl
s.got_trailers = true
else:
s.headers = hl
s.got_headers = true
end
if c.pending_end_stream:
s.end_stream = true
s.state = H2_STREAM_HALF_CLOSED_REMOTE
end
_store(c, idx, s)
ret id
end
func _on_headers(c &: Conn, f: Frame): int:
mut bok := false
block := HeaderBlockOf(f, bok)
if not bok:
compress.BufFree(block)
c.last_error = H2_PROTOCOL_ERROR
c.ok = false
ret H2_POLL_ERROR
end
idx := _ensure_stream(c, f.stream_id)
c.pending_trailers = c.streams.items.get(idx).got_headers
c.pending_stream = f.stream_id
c.pending_end_stream = FrameHasFlag(f, H2_FLAG_END_STREAM)
compress.BufFree(c.pending_block)
c.pending_block = block
if FrameHasFlag(f, H2_FLAG_END_HEADERS):
ret _deliver_block(c)
end
ret f.stream_id
end
func _on_continuation(c &: Conn, f: Frame): int:
if c.pending_stream == 0 or c.pending_stream != f.stream_id:
c.last_error = H2_PROTOCOL_ERROR
c.ok = false
ret H2_POLL_ERROR
end
compress.BufPushBuf(c.pending_block, f.payload)
if FrameHasFlag(f, H2_FLAG_END_HEADERS):
ret _deliver_block(c)
end
ret f.stream_id
end
func _on_data(c &: Conn, f: Frame): int:
mut dok := false
body := DataOf(f, dok)
if not dok:
compress.BufFree(body)
c.last_error = H2_PROTOCOL_ERROR
c.ok = false
ret H2_POLL_ERROR
end
idx := _ensure_stream(c, f.stream_id)
mut s := c.streams.items.get(idx)
compress.BufPushBuf(s.data, body)
consumed := compress.BufLen(f.payload)
s.recv_window -= consumed
c.recv_window -= consumed
if FrameHasFlag(f, H2_FLAG_END_STREAM):
s.end_stream = true
s.state = H2_STREAM_HALF_CLOSED_REMOTE
end
_store(c, idx, s)
compress.BufFree(body)
_maybe_window_update(c, f.stream_id, idx)
ret f.stream_id
end
func _on_settings(c &: Conn, f: Frame): int:
if FrameHasFlag(f, H2_FLAG_ACK): ret H2_POLL_CONNECTION end
old_initial := c.remote.initial_window_size
if not ApplySettings(c.remote, f):
c.last_error = H2_FRAME_SIZE_ERROR
c.ok = false
ret H2_POLL_ERROR
end
delta := c.remote.initial_window_size - old_initial
if delta != 0:
mut i := 0
until i < c.streams.items.len():
mut s := c.streams.items.get(i)
s.send_window += delta
_store(c, i, s)
i += 1
end
end
DynSetMaxSize(c.enc, c.remote.header_table_size)
mut ack := MakeSettingsAck()
WriteFrame(c.tx, ack)
FreeFrame(ack)
ret H2_POLL_CONNECTION
end
func _on_window_update(c &: Conn, f: Frame): int:
inc := WindowIncrementOf(f)
if inc == 0:
c.last_error = H2_PROTOCOL_ERROR
c.ok = false
ret H2_POLL_ERROR
end
if f.stream_id == 0:
c.send_window += inc
ret H2_POLL_CONNECTION
end
idx := _find_stream(c, f.stream_id)
if idx < 0: ret f.stream_id end
mut s := c.streams.items.get(idx)
s.send_window += inc
_store(c, idx, s)
ret f.stream_id
end
func _on_rst(c &: Conn, f: Frame): int:
idx := _ensure_stream(c, f.stream_id)
mut s := c.streams.items.get(idx)
s.reset = true
s.error_code = ErrorCodeOf(f)
s.state = H2_STREAM_CLOSED_STATE
s.end_stream = true
_store(c, idx, s)
ret f.stream_id
end
func _write_block(c &: Conn, stream_id: int, block: compress.ByteBuf, end_stream: bool): bool:
total := compress.BufLen(block)
mut maxf := c.remote.max_frame_size
if maxf < 1: maxf = H2_DEFAULT_FRAME_SIZE end
mut off := 0
mut first := true
mut sent_ok := true
until off < total or first:
mut n := total - off
if n > maxf: n = maxf end
last := (off + n) >= total
mut kind := H2_CONTINUATION
mut flags := 0
if first:
kind = H2_HEADERS
if end_stream: flags = flags | H2_FLAG_END_STREAM end
end
if last: flags = flags | H2_FLAG_END_HEADERS end
mut f := NewFrame(kind, flags, stream_id)
mut i := 0
until i < n:
compress.BufPush(f.payload, compress.BufGet(block, off + i))
i += 1
end
if not WriteFrame(c.tx, f): sent_ok = false end
FreeFrame(f)
off += n
first = false
if not sent_ok: ret false end
if last: ret true end
end
ret sent_ok
end
@en "NewConn"
@fa "اتصال جدید"
pub func NewConn(t: Transport, is_server: bool): Conn:
mut c := Conn {}
c.tx = t
c.is_server = is_server
c.enc = NewDynTable(H2_DEFAULT_TABLE_SIZE)
c.dec = NewDynTable(H2_DEFAULT_TABLE_SIZE)
c.local = DefaultSettings()
c.remote = DefaultSettings()
c.pending_block = compress.NewByteBuf()
if is_server:
c.next_id = 2
else:
c.next_id = 1
end
ret c
end
@en "ClientHandshake"
@fa "دست‌دهی کارخواه"
pub func ClientHandshake(c &: Conn): bool:
if not WritePreface(c.tx): ret false end
mut sf := MakeSettingsFrame(c.local)
ok := WriteFrame(c.tx, sf)
FreeFrame(sf)
if not ok: ret false end
c.ok = true
ret true
end
@en "ServerHandshake"
@fa "دست‌دهی سرور"
pub func ServerHandshake(c &: Conn): bool:
if not ReadPreface(c.tx): ret false end
mut sf := MakeSettingsFrame(c.local)
ok := WriteFrame(c.tx, sf)
FreeFrame(sf)
if not ok: ret false end
c.ok = true
ret true
end
@en "NextStreamId"
@fa "شناسه جریان بعدی"
pub func NextStreamId(c &: Conn): int:
id := c.next_id
c.next_id += 2
_ensure_stream(c, id)
ret id
end
@en "StreamAt"
@fa "جریان با شناسه"
pub func StreamAt(c: Conn, id: int): Stream:
idx := _find_stream(c, id)
if idx < 0: ret Stream {} end
ret c.streams.items.get(idx)
end
@en "StreamCount"
@fa "تعداد جریان‌ها"
pub func StreamCount(c: Conn): int:
ret c.streams.items.len()
end
@en "ConnOk"
@fa "اتصال معتبر"
pub func ConnOk(c: Conn): bool:
ret c.ok
end
@en "SendHeaders"
@fa "ارسال سرآیندها"
pub func SendHeaders(c &: Conn, stream_id: int, hl: HeaderList, end_stream: bool): bool:
mut block := EncodeHeaderList(c.enc, hl, true)
ok := _write_block(c, stream_id, block, end_stream)
compress.BufFree(block)
ret ok
end
@en "SendTrailers"
@fa "ارسال دنباله‌ها"
pub func SendTrailers(c &: Conn, stream_id: int, hl: HeaderList): bool:
ret SendHeaders(c, stream_id, hl, true)
end
@en "SendData"
@fa "ارسال داده"
pub func SendData(c &: Conn, stream_id: int, body: compress.ByteBuf, end_stream: bool): bool:
total := compress.BufLen(body)
mut maxf := c.remote.max_frame_size
if maxf < 1: maxf = H2_DEFAULT_FRAME_SIZE end
mut off := 0
mut first := true
until off < total or first:
idx := _ensure_stream(c, stream_id)
mut avail := c.streams.items.get(idx).send_window
if c.send_window < avail: avail = c.send_window end
if avail <= 0 and (total - off) > 0:
if Poll(c) == H2_POLL_ERROR: ret false end
continue
end
mut n := total - off
if n > maxf: n = maxf end
if n > avail: n = avail end
last := (off + n) >= total
mut flags := 0
if last and end_stream: flags = H2_FLAG_END_STREAM end
mut f := NewFrame(H2_DATA, flags, stream_id)
mut i := 0
until i < n:
compress.BufPush(f.payload, compress.BufGet(body, off + i))
i += 1
end
sent := WriteFrame(c.tx, f)
FreeFrame(f)
if not sent: ret false end
mut s := c.streams.items.get(idx)
s.send_window -= n
_store(c, idx, s)
c.send_window -= n
off += n
first = false
if last: ret true end
end
ret true
end
@en "SendRstStream"
@fa "ارسال بازنشانی جریان"
pub func SendRstStream(c &: Conn, stream_id: int, error_code: int): bool:
mut f := MakeRstStream(stream_id, error_code)
ok := WriteFrame(c.tx, f)
FreeFrame(f)
ret ok
end
@en "SendGoAway"
@fa "ارسال خداحافظی"
pub func SendGoAway(c &: Conn, error_code: int, debug: str): bool:
mut last := 0
mut i := 0
until i < c.streams.items.len():
id := c.streams.items.get(i).id
if id > last: last = id end
i += 1
end
mut f := MakeGoAway(last, error_code, debug)
ok := WriteFrame(c.tx, f)
FreeFrame(f)
c.goaway = true
ret ok
end
@en "SendPing"
@fa "ارسال پینگ"
pub func SendPing(c &: Conn, payload: compress.ByteBuf): bool:
mut f := MakePing(payload, false)
ok := WriteFrame(c.tx, f)
FreeFrame(f)
ret ok
end
@en "Poll"
@fa "دریافت رویداد"
pub func Poll(c &: Conn): int:
mut maxf := c.local.max_frame_size
if maxf < 1: maxf = H2_DEFAULT_FRAME_SIZE end
mut f := ReadFrame(c.tx, maxf)
if not f.ok:
FreeFrame(f)
c.ok = false
ret H2_POLL_ERROR
end
if c.pending_stream != 0 and f.kind != H2_CONTINUATION:
FreeFrame(f)
c.last_error = H2_PROTOCOL_ERROR
c.ok = false
ret H2_POLL_ERROR
end
mut result := H2_POLL_CONNECTION
if f.kind == H2_HEADERS:
result = _on_headers(c, f)
else f.kind == H2_CONTINUATION:
result = _on_continuation(c, f)
else f.kind == H2_DATA:
result = _on_data(c, f)
else f.kind == H2_SETTINGS:
result = _on_settings(c, f)
else f.kind == H2_WINDOW_UPDATE:
result = _on_window_update(c, f)
else f.kind == H2_RST_STREAM:
result = _on_rst(c, f)
else f.kind == H2_PING:
if not FrameHasFlag(f, H2_FLAG_ACK):
mut pong := MakePing(f.payload, true)
WriteFrame(c.tx, pong)
FreeFrame(pong)
end
else f.kind == H2_GOAWAY:
c.goaway = true
c.last_error = ErrorCodeOf(f)
result = H2_POLL_CONNECTION
else f.kind == H2_PUSH_PROMISE:
SendRstStream(c, f.stream_id, H2_REFUSED_STREAM)
else:
result = H2_POLL_CONNECTION
end
FreeFrame(f)
ret result
end
@en "AwaitStreamEnd"
@fa "انتظار اتمام جریان"
pub func AwaitStreamEnd(c &: Conn, stream_id: int, max_frames: int): bool:
mut n := 0
until n < max_frames:
s := StreamAt(c, stream_id)
if s.live and s.end_stream: ret true end
if s.live and s.reset: ret false end
if c.goaway and not c.ok: ret false end
if Poll(c) == H2_POLL_ERROR: ret false end
n += 1
end
ret false
end
@en "AwaitAnyHeaders"
@fa "انتظار سرآیند"
pub func AwaitAnyHeaders(c &: Conn, max_frames: int): int:
mut n := 0
until n < max_frames:
id := Poll(c)
if id == H2_POLL_ERROR: ret H2_POLL_ERROR end
if id > 0:
s := StreamAt(c, id)
if s.got_headers: ret id end
end
n += 1
end
ret H2_POLL_ERROR
end
@en "CloseConn"
@fa "بستن اتصال"
pub func CloseConn(c &: Conn):
compress.BufFree(c.pending_block)
mut i := 0
until i < c.streams.items.len():
s := c.streams.items.get(i)
compress.BufFree(s.data)
i += 1
end
CloseTransport(c.tx)
c.ok = false
end
package http2
import compress
import mem
import net.internal.rawsock
import tls
@en "H2_TRANSPORT_PLAIN"
@fa "انتقال ساده"
pub const H2_TRANSPORT_PLAIN := 0
@en "H2_TRANSPORT_TLS"
@fa "انتقال امن"
pub const H2_TRANSPORT_TLS := 1
mut _tls_conns := TlsBox {}
@en "Transport"
@fa "ترابری"
pub struct Transport:
pub kind: int = 0
pub fd: i64 = 0 - 1
pub sec_id: int = 0 - 1
pub ok: bool = false
end
func _tx_send(t &: Transport, p: void*, n: int): int:
if t.kind == H2_TRANSPORT_TLS:
mut c := _tls_conns.items.get(t.sec_id)
r := tls.WriteBytes(c, p, n)
_tls_conns.items.set(t.sec_id, c)
ret r
end
ret rawsock.SendBytes(rawsock.FromFd(t.fd), p, n)
end
func _tx_recv(t &: Transport, p: void*, n: int): int:
if t.kind == H2_TRANSPORT_TLS:
mut c := _tls_conns.items.get(t.sec_id)
r := tls.ReadBytes(c, p, n)
_tls_conns.items.set(t.sec_id, c)
ret r
end
ret rawsock.RecvBytes(rawsock.FromFd(t.fd), p, n)
end
func _read_exact(t &: Transport, n: int, ok &: bool): compress.ByteBuf:
mut out := compress.NewByteBufCap(n + 1)
if n == 0:
ok = true
ret out
end
p := mem.Allocate(n as u64)
if p == null:
ok = false
ret out
end
mut got := 0
until got < n:
base := ((p as i64) + (got as i64)) as void*
r := _tx_recv(t, base, n - got)
if r <= 0:
mem.Free(p)
ok = false
ret out
end
got += r
end
compress.BufPushBytes(out, p, n)
mem.Free(p)
ok = true
ret out
end
func _write_all(t &: Transport, b: compress.ByteBuf): bool:
n := compress.BufLen(b)
if n == 0: ret true end
mut sent := 0
until sent < n:
base := ((b.data as i64) + (sent as i64)) as void*
w := _tx_send(t, base, n - sent)
if w <= 0: ret false end
sent += w
end
ret true
end
func _put_setting(out &: compress.ByteBuf, id: int, v: int):
compress.BufPush(out, (id >> 8) & 255)
compress.BufPush(out, id & 255)
compress.BufPush(out, (v >> 24) & 255)
compress.BufPush(out, (v >> 16) & 255)
compress.BufPush(out, (v >> 8) & 255)
compress.BufPush(out, v & 255)
end
@en "PlainTransport"
@fa "ترابری ساده"
pub func PlainTransport(fd: i64): Transport:
mut t := Transport {}
t.kind = H2_TRANSPORT_PLAIN
t.fd = fd
t.ok = fd >= 0
ret t
end
@en "TLSTransport"
@fa "ترابری امن"
pub func TLSTransport(c: tls.Conn): Transport:
mut t := Transport {}
t.kind = H2_TRANSPORT_TLS
_tls_conns.items.push(c)
t.sec_id = _tls_conns.items.len() - 1
t.ok = tls.ConnOk(c)
ret t
end
@en "CloseTransport"
@fa "بستن ترابری"
pub func CloseTransport(t &: Transport):
if t.kind == H2_TRANSPORT_TLS:
if t.sec_id >= 0 and t.sec_id < _tls_conns.items.len():
mut c := _tls_conns.items.get(t.sec_id)
tls.Close(c)
_tls_conns.items.set(t.sec_id, c)
end
else:
if t.fd >= 0: rawsock.Close(rawsock.FromFd(t.fd)) end
end
t.ok = false
end
@en "NewFrame"
@fa "قاب جدید"
pub func NewFrame(kind: int, flags: int, stream_id: int): Frame:
mut f := Frame {}
f.kind = kind
f.flags = flags
f.stream_id = stream_id
f.payload = compress.NewByteBuf()
f.ok = true
ret f
end
@en "FreeFrame"
@fa "آزادسازی قاب"
pub func FreeFrame(f &: Frame):
compress.BufFree(f.payload)
f.ok = false
end
@en "FrameHasFlag"
@fa "قاب پرچم دارد"
pub func FrameHasFlag(f: Frame, flag: int): bool:
ret (f.flags & flag) != 0
end
@en "FrameEncode"
@fa "کدگذاری قاب"
pub func FrameEncode(f: Frame): compress.ByteBuf:
n := compress.BufLen(f.payload)
mut out := compress.NewByteBufCap(n + 9)
compress.BufPush(out, (n >> 16) & 255)
compress.BufPush(out, (n >> 8) & 255)
compress.BufPush(out, n & 255)
compress.BufPush(out, f.kind & 255)
compress.BufPush(out, f.flags & 255)
compress.BufPush(out, (f.stream_id >> 24) & 127)
compress.BufPush(out, (f.stream_id >> 16) & 255)
compress.BufPush(out, (f.stream_id >> 8) & 255)
compress.BufPush(out, f.stream_id & 255)
compress.BufPushBuf(out, f.payload)
ret out
end
@en "WriteFrame"
@fa "نوشتن قاب"
pub func WriteFrame(t &: Transport, f: Frame): bool:
mut wire := FrameEncode(f)
ok := _write_all(t, wire)
compress.BufFree(wire)
ret ok
end
@en "ReadFrame"
@fa "خواندن قاب"
pub func ReadFrame(t &: Transport, max_frame_size: int): Frame:
mut f := Frame {}
mut ok := false
mut head := _read_exact(t, 9, ok)
if not ok:
compress.BufFree(head)
ret f
end
n := (compress.BufGet(head, 0) << 16) | (compress.BufGet(head, 1) << 8) | compress.BufGet(head, 2)
f.kind = compress.BufGet(head, 3)
f.flags = compress.BufGet(head, 4)
f.stream_id = ((compress.BufGet(head, 5) & 127) << 24) | (compress.BufGet(head, 6) << 16) | (compress.BufGet(head, 7) << 8) | compress.BufGet(head, 8)
compress.BufFree(head)
if n > max_frame_size:
ret f
end
mut pok := false
f.payload = _read_exact(t, n, pok)
if not pok:
compress.BufFree(f.payload)
f.payload = compress.NewByteBuf()
ret f
end
f.ok = true
ret f
end
@en "WritePreface"
@fa "نوشتن پیش‌درآمد"
pub func WritePreface(t &: Transport): bool:
mut b := compress.BufFromStr(H2_PREFACE)
ok := _write_all(t, b)
compress.BufFree(b)
ret ok
end
@en "ReadPreface"
@fa "خواندن پیش‌درآمد"
pub func ReadPreface(t &: Transport): bool:
mut ok := false
mut got := _read_exact(t, H2_PREFACE.len(), ok)
if not ok:
compress.BufFree(got)
ret false
end
mut want := compress.BufFromStr(H2_PREFACE)
same := compress.BufEquals(got, want)
compress.BufFree(got)
compress.BufFree(want)
ret same
end
@en "HeaderBlockOf"
@fa "بلوک سرآیند قاب"
pub func HeaderBlockOf(f: Frame, ok &: bool): compress.ByteBuf:
n := compress.BufLen(f.payload)
mut start := 0
mut stop := n
if FrameHasFlag(f, H2_FLAG_PADDED):
if n < 1:
ok = false
ret compress.NewByteBuf()
end
pad := compress.BufGet(f.payload, 0)
start = 1
stop = n - pad
end
if FrameHasFlag(f, H2_FLAG_PRIORITY):
start += 5
end
if start > stop:
ok = false
ret compress.NewByteBuf()
end
mut out := compress.NewByteBufCap(stop - start + 1)
mut i := start
until i < stop:
compress.BufPush(out, compress.BufGet(f.payload, i))
i += 1
end
ok = true
ret out
end
@en "DataOf"
@fa "داده قاب"
pub func DataOf(f: Frame, ok &: bool): compress.ByteBuf:
n := compress.BufLen(f.payload)
mut start := 0
mut stop := n
if FrameHasFlag(f, H2_FLAG_PADDED):
if n < 1:
ok = false
ret compress.NewByteBuf()
end
pad := compress.BufGet(f.payload, 0)
start = 1
stop = n - pad
end
if start > stop:
ok = false
ret compress.NewByteBuf()
end
mut out := compress.NewByteBufCap(stop - start + 1)
mut i := start
until i < stop:
compress.BufPush(out, compress.BufGet(f.payload, i))
i += 1
end
ok = true
ret out
end
@en "MakeSettingsFrame"
@fa "ساخت قاب تنظیمات"
pub func MakeSettingsFrame(s: Settings): Frame:
f := NewFrame(H2_SETTINGS, 0, 0)
_put_setting(f.payload, H2_SETTINGS_HEADER_TABLE_SIZE, s.header_table_size)
_put_setting(f.payload, H2_SETTINGS_ENABLE_PUSH, s.enable_push)
if s.max_concurrent_streams >= 0:
_put_setting(f.payload, H2_SETTINGS_MAX_CONCURRENT_STREAMS, s.max_concurrent_streams)
end
_put_setting(f.payload, H2_SETTINGS_INITIAL_WINDOW_SIZE, s.initial_window_size)
_put_setting(f.payload, H2_SETTINGS_MAX_FRAME_SIZE, s.max_frame_size)
if s.max_header_list_size >= 0:
_put_setting(f.payload, H2_SETTINGS_MAX_HEADER_LIST_SIZE, s.max_header_list_size)
end
ret f
end
@en "MakeSettingsAck"
@fa "ساخت تایید تنظیمات"
pub func MakeSettingsAck(): Frame:
ret NewFrame(H2_SETTINGS, H2_FLAG_ACK, 0)
end
@en "ApplySettings"
@fa "اعمال تنظیمات"
pub func ApplySettings(s &: Settings, f: Frame): bool:
n := compress.BufLen(f.payload)
if n % 6 != 0: ret false end
mut i := 0
until i < n:
id := (compress.BufGet(f.payload, i) << 8) | compress.BufGet(f.payload, i + 1)
v := (compress.BufGet(f.payload, i + 2) << 24) | (compress.BufGet(f.payload, i + 3) << 16) | (compress.BufGet(f.payload, i + 4) << 8) | compress.BufGet(f.payload, i + 5)
if id == H2_SETTINGS_HEADER_TABLE_SIZE: s.header_table_size = v end
if id == H2_SETTINGS_ENABLE_PUSH: s.enable_push = v end
if id == H2_SETTINGS_MAX_CONCURRENT_STREAMS: s.max_concurrent_streams = v end
if id == H2_SETTINGS_INITIAL_WINDOW_SIZE: s.initial_window_size = v end
if id == H2_SETTINGS_MAX_FRAME_SIZE: s.max_frame_size = v end
if id == H2_SETTINGS_MAX_HEADER_LIST_SIZE: s.max_header_list_size = v end
i += 6
end
ret true
end
@en "MakeWindowUpdate"
@fa "ساخت به‌روزرسانی پنجره"
pub func MakeWindowUpdate(stream_id: int, increment: int): Frame:
f := NewFrame(H2_WINDOW_UPDATE, 0, stream_id)
compress.BufPush(f.payload, (increment >> 24) & 127)
compress.BufPush(f.payload, (increment >> 16) & 255)
compress.BufPush(f.payload, (increment >> 8) & 255)
compress.BufPush(f.payload, increment & 255)
ret f
end
@en "WindowIncrementOf"
@fa "مقدار افزایش پنجره"
pub func WindowIncrementOf(f: Frame): int:
if compress.BufLen(f.payload) < 4: ret 0 end
ret ((compress.BufGet(f.payload, 0) & 127) << 24) | (compress.BufGet(f.payload, 1) << 16) | (compress.BufGet(f.payload, 2) << 8) | compress.BufGet(f.payload, 3)
end
@en "MakeRstStream"
@fa "ساخت بازنشانی جریان"
pub func MakeRstStream(stream_id: int, error_code: int): Frame:
f := NewFrame(H2_RST_STREAM, 0, stream_id)
compress.BufPush(f.payload, (error_code >> 24) & 255)
compress.BufPush(f.payload, (error_code >> 16) & 255)
compress.BufPush(f.payload, (error_code >> 8) & 255)
compress.BufPush(f.payload, error_code & 255)
ret f
end
@en "ErrorCodeOf"
@fa "کد خطای قاب"
pub func ErrorCodeOf(f: Frame): int:
n := compress.BufLen(f.payload)
if f.kind == H2_RST_STREAM:
if n < 4: ret H2_PROTOCOL_ERROR end
ret (compress.BufGet(f.payload, 0) << 24) | (compress.BufGet(f.payload, 1) << 16) | (compress.BufGet(f.payload, 2) << 8) | compress.BufGet(f.payload, 3)
end
if n < 8: ret H2_PROTOCOL_ERROR end
ret (compress.BufGet(f.payload, 4) << 24) | (compress.BufGet(f.payload, 5) << 16) | (compress.BufGet(f.payload, 6) << 8) | compress.BufGet(f.payload, 7)
end
@en "MakeGoAway"
@fa "ساخت خداحافظی"
pub func MakeGoAway(last_stream_id: int, error_code: int, debug: str): Frame:
f := NewFrame(H2_GOAWAY, 0, 0)
compress.BufPush(f.payload, (last_stream_id >> 24) & 127)
compress.BufPush(f.payload, (last_stream_id >> 16) & 255)
compress.BufPush(f.payload, (last_stream_id >> 8) & 255)
compress.BufPush(f.payload, last_stream_id & 255)
compress.BufPush(f.payload, (error_code >> 24) & 255)
compress.BufPush(f.payload, (error_code >> 16) & 255)
compress.BufPush(f.payload, (error_code >> 8) & 255)
compress.BufPush(f.payload, error_code & 255)
if debug != "":
compress.BufPushBytes(f.payload, debug as void*, debug.len())
end
ret f
end
@en "MakePing"
@fa "ساخت پینگ"
pub func MakePing(payload: compress.ByteBuf, ack: bool): Frame:
mut flags := 0
if ack: flags = H2_FLAG_ACK end
f := NewFrame(H2_PING, flags, 0)
mut i := 0
until i < 8:
mut v := 0
if i < compress.BufLen(payload): v = compress.BufGet(payload, i) end
compress.BufPush(f.payload, v)
i += 1
end
ret f
end
@en "PutSetting"
@fa "درج تنظیم"
pub func PutSetting(out &: compress.ByteBuf, id: int, v: int):
_put_setting(out, id, v)
end
package http2
import compress
const _STATIC := [
":authority", ""
":method", "GET"
":method", "POST"
":path", "/"
":path", "/index.html"
":scheme", "http"
":scheme", "https"
":status", "200"
":status", "204"
":status", "206"
":status", "304"
":status", "400"
":status", "404"
":status", "500"
"accept-charset", ""
"accept-encoding", "gzip, deflate"
"accept-language", ""
"accept-ranges", ""
"accept", ""
"access-control-allow-origin", ""
"age", ""
"allow", ""
"authorization", ""
"cache-control", ""
"content-disposition", ""
"content-encoding", ""
"content-language", ""
"content-length", ""
"content-location", ""
"content-range", ""
"content-type", ""
"cookie", ""
"date", ""
"etag", ""
"expect", ""
"expires", ""
"from", ""
"host", ""
"if-match", ""
"if-modified-since", ""
"if-none-match", ""
"if-range", ""
"if-unmodified-since", ""
"last-modified", ""
"link", ""
"location", ""
"max-forwards", ""
"proxy-authenticate", ""
"proxy-authorization", ""
"range", ""
"referer", ""
"refresh", ""
"retry-after", ""
"server", ""
"set-cookie", ""
"strict-transport-security", ""
"transfer-encoding", ""
"user-agent", ""
"vary", ""
"via", ""
"www-authenticate", ""
]
@en "HPACK_STATIC_COUNT"
@fa "شمار جدول ایستای اچ‌پک"
pub const HPACK_STATIC_COUNT := 61
@en "HPACK_ENTRY_OVERHEAD"
@fa "سربار مدخل اچ‌پک"
pub const HPACK_ENTRY_OVERHEAD := 32
func _dyn_count(t: DynTable): int:
ret t.items.len() - t.head
end
func _entry_size(h: Header): int:
ret h.name.len() + h.value.len() + HPACK_ENTRY_OVERHEAD
end
func _dyn_compact(t &: DynTable):
if t.head < 32: ret end
mut fresh := Vector {} as Vector<Header>
mut i := t.head
until i < t.items.len():
fresh.push(t.items.get(i))
i += 1
end
t.items = fresh
t.head = 0
end
func _dyn_evict_to(t &: DynTable, limit: int):
until t.size > limit and _dyn_count(t) > 0:
oldest := t.items.get(t.head)
t.size -= _entry_size(oldest)
t.head += 1
end
_dyn_compact(t)
end
func _enc_int(out &: compress.ByteBuf, mask: int, prefix_bits: int, value: int):
limit := (1 << prefix_bits) - 1
if value < limit:
compress.BufPush(out, mask | value)
ret
end
compress.BufPush(out, mask | limit)
mut v := value - limit
until v >= 128:
compress.BufPush(out, (v & 127) | 128)
v = v / 128
end
compress.BufPush(out, v)
end
func _dec_int(src: compress.ByteBuf, pos &: int, first: int, prefix_bits: int, ok &: bool): int:
limit := (1 << prefix_bits) - 1
v := first & limit
if v < limit:
ok = true
ret v
end
mut result := limit
mut shift := 0
n := compress.BufLen(src)
until true:
if pos >= n:
ok = false
ret 0
end
b := compress.BufGet(src, pos)
pos += 1
result += (b & 127) << shift
if (b & 128) == 0:
ok = true
ret result
end
shift += 7
if shift > 28:
ok = false
ret 0
end
end
end
func _enc_string(out &: compress.ByteBuf, s: str, use_huffman: bool):
if use_huffman:
hlen := HuffmanEncodedLenStr(s)
if hlen < s.len():
_enc_int(out, 128, 7, hlen)
HuffmanEncode(out, s as void*, s.len())
ret
end
end
_enc_int(out, 0, 7, s.len())
compress.BufPushBytes(out, s as void*, s.len())
end
func _dec_string(src: compress.ByteBuf, pos &: int, ok &: bool): str:
n := compress.BufLen(src)
if pos >= n:
ok = false
ret ""
end
first := compress.BufGet(src, pos)
pos += 1
huff := (first & 128) != 0
mut lok := false
slen := _dec_int(src, pos, first, 7, lok)
if not lok or pos + slen > n:
ok = false
ret ""
end
if not huff:
mut raw := compress.NewByteBufCap(slen + 1)
mut i := 0
until i < slen:
compress.BufPush(raw, compress.BufGet(src, pos + i))
i += 1
end
pos += slen
out := compress.BufToStrUnsafe(raw)
compress.BufFree(raw)
ok = true
ret out
end
mut hok := false
mut dec := HuffmanDecode(src, pos, slen, hok)
pos += slen
if not hok:
compress.BufFree(dec)
ok = false
ret ""
end
out := compress.BufToStrUnsafe(dec)
compress.BufFree(dec)
ok = true
ret out
end
@en "NewDynTable"
@fa "جدول پویا جدید"
pub func NewDynTable(max_size: int): DynTable:
mut t := DynTable {}
t.max_size = max_size
ret t
end
@en "DynCount"
@fa "تعداد جدول پویا"
pub func DynCount(t: DynTable): int:
ret _dyn_count(t)
end
@en "DynSize"
@fa "اندازه جدول پویا"
pub func DynSize(t: DynTable): int:
ret t.size
end
@en "DynGet"
@fa "دریافت از جدول پویا"
pub func DynGet(t: DynTable, index: int): Header:
if index < 1 or index > _dyn_count(t): ret Header {} end
ret t.items.get(t.items.len() - index)
end
@en "DynInsert"
@fa "درج در جدول پویا"
pub func DynInsert(t &: DynTable, h: Header):
sz := _entry_size(h)
if sz > t.max_size:
_dyn_evict_to(t, 0 - 1)
ret
end
_dyn_evict_to(t, t.max_size - sz)
t.items.push(h)
t.size += sz
end
@en "DynSetMaxSize"
@fa "تنظیم اندازه جدول"
pub func DynSetMaxSize(t &: DynTable, max_size: int):
t.max_size = max_size
_dyn_evict_to(t, max_size)
end
@en "StaticGet"
@fa "دریافت از جدول ثابت"
pub func StaticGet(index: int): Header:
if index < 1 or index > HPACK_STATIC_COUNT: ret Header {} end
mut h := Header {}
h.name = _STATIC[(index - 1) * 2]
h.value = _STATIC[(index - 1) * 2 + 1]
ret h
end
@en "TableGet"
@fa "دریافت از جدول"
pub func TableGet(t: DynTable, index: int, ok &: bool): Header:
if index >= 1 and index <= HPACK_STATIC_COUNT:
ok = true
ret StaticGet(index)
end
d := index - HPACK_STATIC_COUNT
if d >= 1 and d <= _dyn_count(t):
ok = true
ret DynGet(t, d)
end
ok = false
ret Header {}
end
@en "TableFind"
@fa "جستجوی جدول"
pub func TableFind(t: DynTable, name: str, value: str, exact &: bool): int:
mut name_only := 0
mut i := 1
until i <= HPACK_STATIC_COUNT:
if _STATIC[(i - 1) * 2] == name:
if _STATIC[(i - 1) * 2 + 1] == value:
exact = true
ret i
end
if name_only == 0: name_only = i end
end
i += 1
end
mut d := 1
until d <= _dyn_count(t):
e := DynGet(t, d)
if e.name == name:
if e.value == value:
exact = true
ret HPACK_STATIC_COUNT + d
end
if name_only == 0: name_only = HPACK_STATIC_COUNT + d end
end
d += 1
end
exact = false
ret name_only
end
@en "EncodeHeader"
@fa "کدگذاری سرآیند"
pub func EncodeHeader(out &: compress.ByteBuf, t &: DynTable, h: Header, use_huffman: bool):
mut exact := false
idx := TableFind(t, h.name, h.value, exact)
if exact and not h.sensitive:
_enc_int(out, 128, 7, idx)
ret
end
if h.sensitive:
_enc_int(out, 16, 4, idx)
if idx == 0: _enc_string(out, h.name, use_huffman) end
_enc_string(out, h.value, use_huffman)
ret
end
_enc_int(out, 64, 6, idx)
if idx == 0: _enc_string(out, h.name, use_huffman) end
_enc_string(out, h.value, use_huffman)
DynInsert(t, h)
end
@en "EncodeHeaderList"
@fa "کدگذاری فهرست سرآیند"
pub func EncodeHeaderList(t &: DynTable, hl: HeaderList, use_huffman: bool): compress.ByteBuf:
mut out := compress.NewByteBufCap(256)
mut i := 0
until i < hl.items.len():
EncodeHeader(out, t, hl.items.get(i), use_huffman)
i += 1
end
ret out
end
@en "EncodeTableSizeUpdate"
@fa "کدگذاری تغییر اندازه جدول"
pub func EncodeTableSizeUpdate(out &: compress.ByteBuf, t &: DynTable, new_size: int):
DynSetMaxSize(t, new_size)
_enc_int(out, 32, 5, new_size)
end
@en "DecodeHeaderList"
@fa "کدگشایی فهرست سرآیند"
pub func DecodeHeaderList(t &: DynTable, block: compress.ByteBuf, ok &: bool): HeaderList:
mut out := HeaderList {}
mut pos := 0
n := compress.BufLen(block)
until pos < n:
b := compress.BufGet(block, pos)
pos += 1
if (b & 128) != 0:
mut iok := false
idx := _dec_int(block, pos, b, 7, iok)
if not iok or idx == 0:
ok = false
ret out
end
mut gok := false
h := TableGet(t, idx, gok)
if not gok:
ok = false
ret out
end
out.items.push(h)
continue
end
if (b & 64) != 0:
mut iok := false
idx := _dec_int(block, pos, b, 6, iok)
if not iok:
ok = false
ret out
end
mut h := Header {}
if idx == 0:
mut sok := false
h.name = _dec_string(block, pos, sok)
if not sok:
ok = false
ret out
end
else:
mut gok := false
h.name = TableGet(t, idx, gok).name
if not gok:
ok = false
ret out
end
end
mut vok := false
h.value = _dec_string(block, pos, vok)
if not vok:
ok = false
ret out
end
DynInsert(t, h)
out.items.push(h)
continue
end
if (b & 32) != 0:
mut iok := false
newmax := _dec_int(block, pos, b, 5, iok)
if not iok:
ok = false
ret out
end
DynSetMaxSize(t, newmax)
continue
end
never := (b & 16) != 0
mut iok := false
idx := _dec_int(block, pos, b, 4, iok)
if not iok:
ok = false
ret out
end
mut h := Header {}
h.sensitive = never
if idx == 0:
mut sok := false
h.name = _dec_string(block, pos, sok)
if not sok:
ok = false
ret out
end
else:
mut gok := false
h.name = TableGet(t, idx, gok).name
if not gok:
ok = false
ret out
end
end
mut vok := false
h.value = _dec_string(block, pos, vok)
if not vok:
ok = false
ret out
end
out.items.push(h)
end
ok = true
ret out
end
