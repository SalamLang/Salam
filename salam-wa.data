@fa "نوع ستون"
pub func ColumnType(col: int): int:
if this.handle == null:
ret db.TYPE_NULL
end
t := sqlite3_column_type(this.handle, col)
if t == 5:
ret db.TYPE_NULL
end
ret t
end
@en "IsNull"
@fa "خالی است"
pub func IsNull(col: int): bool:
if this.handle == null:
ret true
end
ret sqlite3_column_type(this.handle, col) == 5
end
@en "Text"
@fa "متن"
pub func Text(col: int): str:
if this.handle == null:
