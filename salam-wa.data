@en "Open"
@fa "بازکردن"
pub func Open(path: str): Database:
mut p := path
if p == "":
p = ":memory:"
end
mut db := null as void*
sqlite3_open(p, db)
if db == null:
ret Database { handle = null }
end
ret Database { handle = db }
end
