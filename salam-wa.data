p = _cws(s, p)
ke := _cstr_end(s, p)
p = _cws(s, ke)
if p < n and _ub(bp, p) == 58: p = p + 1 end
p = _cval_end(s, p)
p = _cws(s, p)
if p < n and _ub(bp, p) == 44:
p = p + 1
continue
end
if p < n and _ub(bp, p) == 125: ret p + 1 end
break
end
ret p
end
if c == 91:
mut p := _cws(s, i + 1)
if p < n and _ub(bp, p) == 93: ret p + 1 end
until p < n:
p = _cval_end(s, p)
p = _cws(s, p)
if p < n and _ub(bp, p) == 44:
p = p + 1
continue
end
if p < n and _ub(bp, p) == 93: ret p + 1 end
break
end
ret p
end
mut p := i
until p < n:
cc := _ub(bp, p)
if cc == 44 or cc == 93 or cc == 125 or cc == 32 or cc == 10 or cc == 9 or cc == 13: break end
p = p + 1
end
