hi := x / POW2[32 - n]
lo := (x * POW2[n]) % 4294967296
ret lo + hi
end
func _sha1_pad_byte(data: void*, dlen: int, total: int, i: int): int:
if i < dlen:
ret _bget(data, i)
end
if i == dlen:
ret 128
end
if i >= total - 8:
ml := (dlen as i64) * 8
shift := total - 1 - i
mut d := ml
repeat shift:
d /= 256
end
ret (d % 256) as int
end
ret 0
end
func _sha1_core(data: void*, dlen: int, outp: void*):
