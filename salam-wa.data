mut all_ok := true
until p < n:
v := _flow_value(s, p, depth + 1)
if v.ok == false: all_ok = false end
items.push(v.value)
p = _flow_ws(s, v.next)
if p < n and _ub(bp, p) == 44:
p = p + 1
continue
end
if p < n and _ub(bp, p) == 93:
p = p + 1
closed = true
end
break
end
out := Array(items)
ret _YR { value = out, next = p, ok = closed and all_ok }
end
func _parse_block_scalar(lines: Vector<str>, li: int, indicator: str): _YR:
mut folded := false
if indicator.substr(0, 1) == ">": folded = true end
mut chomp := 0
k := 1
ilen := indicator.len()
if k < ilen:
ch := indicator.substr(k, 1)
if ch == "-":
chomp = 1
else ch == "+":
chomp = 2
end
end
n := lines.len()
mut bi := li + 1
mut base := 0 - 1
until bi < n and base < 0:
raw := lines.get(bi)
if str.Trim(raw) != "":
base = _raw_indent(raw)
else:
bi = bi + 1
end
end
if base < 0:
ret _YR { value = _json_str_literal(""), next = li + 1 }
end
body_lines := Vector {} as Vector<str>
defer body_lines.free()
mut cur := li + 1
until cur < n:
raw := lines.get(cur)
if str.Trim(raw) == "":
body_lines.push("")
cur = cur + 1
else:
ind := _raw_indent(raw)
if ind < base: break end
mut piece := ""
if raw.len() >= base: piece = raw.substr(base, raw.len() - base) end
body_lines.push(str.TrimRight(piece))
cur = cur + 1
end
end
mut endi := body_lines.len()
until endi > 0 and body_lines.get(endi - 1) == "":
endi = endi - 1
end
mut sb := str.NewBuilder()
defer str.BufFree(sb)
mut prev_blank := false
repeat endi in idx:
line := body_lines.get(idx)
if idx > 0:
if folded:
if line == "" or prev_blank:
str.BufAppendChar(sb, 10)
else:
str.BufAppendChar(sb, 32)
end
else:
str.BufAppendChar(sb, 10)
end
end
str.BufAppend(sb, line)
prev_blank = line == ""
end
mut result := str.BufStr(sb)
if chomp == 2:
trailing := body_lines.len() - endi
mut t := 0
until t < trailing + 1:
result = result.concat("\n")
t = t + 1
end
else chomp == 0:
if endi > 0: result = result.concat("\n") end
end
ret _YR { value = _json_str_literal(result), next = cur }
end
func _dump_indent(sb &: str.StringBuilder, unit: str, depth: int):
repeat depth:
str.BufAppend(sb, unit)
end
end
func _dump_scalar(s: str, i: int, sb &: str.StringBuilder): int:
n := s.len()
bp := _bp(s)
if i < n and _ub(bp, i) == 34:
e := _cstr_end(s, i)
raw := _json_unescape(s.substr(i + 1, e - i - 2))
if _needs_quote(raw):
str.BufAppend(sb, _json_str_literal(raw))
else:
str.BufAppend(sb, raw)
end
ret e
end
e := _cval_end(s, i)
str.BufAppend(sb, s.substr(i, e - i))
ret e
end
func _dump_collection_or_scalar(s: str, vs: int, sb &: str.StringBuilder, unit: str, depth: int): int:
n := s.len()
bp := _bp(s)
vc := _ub(bp, vs)
if vc == 123 or vc == 91:
mut closec := 125
if vc == 91: closec = 93 end
inner := _cws(s, vs + 1)
if inner < n and _ub(bp, inner) == closec:
str.BufAppendChar(sb, 32)
if vc == 123: str.BufAppend(sb, "{}") else:
str.BufAppend(sb, "[]")
end
ret inner + 1
end
str.BufAppendChar(sb, 10)
ret _dump_block(s, vs, sb, unit, depth + 1)
end
str.BufAppendChar(sb, 32)
ret _dump_scalar(s, vs, sb)
end
func _dump_block(s: str, i0: int, sb &: str.StringBuilder, unit: str, depth: int): int:
i := _cws(s, i0)
n := s.len()
bp := _bp(s)
if i >= n:
str.BufAppend(sb, "null")
ret i
end
c := _ub(bp, i)
if c == 123:
mut p := _cws(s, i + 1)
if p < n and _ub(bp, p) == 125:
str.BufAppend(sb, "{}")
ret p + 1
end
mut first := true
until p < n:
p = _cws(s, p)
ke := _cstr_end(s, p)
keyraw := _json_unescape(s.substr(p + 1, ke - p - 2))
if first == false: str.BufAppendChar(sb, 10) end
first = false
_dump_indent(sb, unit, depth)
if _needs_quote(keyraw):
str.BufAppend(sb, _json_str_literal(keyraw))
else:
str.BufAppend(sb, keyraw)
end
str.BufAppendChar(sb, 58)
p = _cws(s, ke)
if p < n and _ub(bp, p) == 58: p = p + 1 end
vs := _cws(s, p)
p = _dump_collection_or_scalar(s, vs, sb, unit, depth)
p = _cws(s, p)
if p < n and _ub(bp, p) == 44:
p = p + 1
continue
end
if p < n and _ub(bp, p) == 125: p = p + 1 end
break
end
ret p
end
if c == 91:
mut p := _cws(s, i + 1)
if p < n and _ub(bp, p) == 93:
str.BufAppend(sb, "[]")
ret p + 1
end
mut first := true
until p < n:
if first == false: str.BufAppendChar(sb, 10) end
first = false
_dump_indent(sb, unit, depth)
str.BufAppendChar(sb, 45)
vs := _cws(s, p)
p = _dump_collection_or_scalar(s, vs, sb, unit, depth)
p = _cws(s, p)
if p < n and _ub(bp, p) == 44:
p = p + 1
continue
end
if p < n and _ub(bp, p) == 93: p = p + 1 end
break
end
ret p
end
ret _dump_scalar(s, i, sb)
end
@en "Parse"
@fa "تجزیه"
pub func Parse(text: str): str:
r := _parse_document(text)
ret r.value
end
@en "ToJSON"
@fa "به جیسون"
pub func ToJSON(text: str): str:
ret Parse(text)
end
@en "Valid"
@fa "معتبر"
pub func Valid(text: str): bool:
r := _parse_document(text)
if r.ok == false: ret false end
t := _truncate_to_first_doc(text)
lines := t.split("\n")
defer lines.free()
tail := _skip_noise(lines, r.next)
total := lines.len()
ret tail >= total
end
@en "SplitDocuments"
@fa "تفکیک کردن اسناد"
pub func SplitDocuments(text: str): Vector<str>:
lines := text.split("\n")
defer lines.free()
out := Vector {} as Vector<str>
mut cur := str.NewBuilder()
mut any := false
n := lines.len()
mut i := 0
until i < n:
raw := lines.get(i)
t := str.Trim(raw)
if t == "---":
if any: out.push(str.BufStr(cur)) end
str.BufReset(cur)
any = true
else t == "...":
if any: out.push(str.BufStr(cur)) end
str.BufReset(cur)
any = false
else:
if str.BufIsEmpty(cur) == false: str.BufAppendChar(cur, 10) end
str.BufAppend(cur, raw)
any = true
end
i = i + 1
end
if any: out.push(str.BufStr(cur)) end
str.BufFree(cur)
ret out
end
@en "env"
@fa "محیط"
package env
import str
import conv
import io
import fs.path
import encoding.envfile
if SALAM_OS_WINDOWS:
extern:
func getenv(name: str): void*
func _putenv_s(name: str, value: str): int
end
else:
extern:
func getenv(name: str): void*
func setenv(name: str, value: str, overwrite: int): int
func unsetenv(name: str): int
end
end
func _base_from_names(names: Vector<str>): envfile.Doc:
mut base := envfile.New()
repeat names.len() in i:
n := names.get(i)
if Has(n): envfile.Set(base, n, Get(n)) end
end
ret base
end
func _env_base(raw &: envfile.Doc): envfile.Doc:
names := envfile.RefNames(raw)
defer names.free()
ret _base_from_names(names)
end
func _apply_doc(d &: envfile.Doc, override: bool): int:
mut count := 0
repeat envfile.Len(d) in i:
k := envfile.KeyAt(d, i)
if override or Has(k) == false:
Set(k, envfile.ValueAt(d, i))
count += 1
end
end
ret count
end
func _apply_raw(raw &: envfile.Doc, override: bool): int:
mut base := _env_base(raw)
defer envfile.Free(base)
mut d := envfile.ExpandDoc(raw, base)
defer envfile.Free(d)
ret _apply_doc(d, override)
end
func _apply_text(text: str, override: bool): int:
mut raw := envfile.ParseRaw(text)
defer envfile.Free(raw)
ret _apply_raw(raw, override)
end
func _merge_file(dst &: envfile.Doc, p: str):
mut raw := envfile.ParseRaw(io.ReadFile(p))
defer envfile.Free(raw)
envfile.MergeInto(dst, raw)
end
@en "Get"
@fa "دریافت"
pub func Get(name: str): str:
v := getenv(name)
if v == null: ret "" end
ret str.Clone(v as str)
end
@en "GetOr"
@fa "دریافت با پیش فرض"
pub func GetOr(name: str, def: str): str:
v := Get(name)
if v.len() == 0: ret def end
ret v
end
@en "Has"
@fa "دارد"
pub func Has(name: str): bool: ret getenv(name) != null end
@en "GetInt"
@fa "دریافت صحیح"
pub func GetInt(name: str, def: i64): i64:
v := Get(name)
if v.len() == 0: ret def end
ret conv.ParseInt(v)
end
@en "GetFloat"
@fa "دریافت اعشاری"
pub func GetFloat(name: str, def: f64): f64:
v := Get(name)
if v.len() == 0: ret def end
ret conv.ParseFloat(v)
end
@en "GetBool"
@fa "دریافت منطقی"
pub func GetBool(name: str, def: bool): bool:
v := Get(name)
if v.len() == 0: ret def end
ret conv.ParseBool(v)
end
if SALAM_OS_WINDOWS:
@en "Set"
@fa "تنظیم"
pub func Set(name: str, value: str): bool: ret _putenv_s(name, value) == 0 end
@en "Unset"
@fa "حذف"
pub func Unset(name: str): bool: ret _putenv_s(name, "") == 0 end
else:
@en "Set"
@fa "تنظیم"
pub func Set(name: str, value: str): bool: ret setenv(name, value, 1) == 0 end
@en "Unset"
@fa "حذف"
pub func Unset(name: str): bool: ret unsetenv(name) == 0 end
end
@en "Mask"
@fa "پوشاندن"
pub func Mask(value: str): str:
n := value.len()
if n == 0: ret "" end
if n <= 8:
mut out := ""
repeat n: out = out.concat("*") end
ret out
end
ret value.substr(0, 2).concat("****").concat(value.substr(n - 2, 2))
end
@en "GetMasked"
@fa "دریافت پوشیده"
pub func GetMasked(name: str): str: ret Mask(Get(name)) end
@en "Profile"
@fa "نمایه"
pub func Profile(): str:
v := GetOr("SALAM_ENV", GetOr("APP_ENV", GetOr("ENV", "development")))
ret str.Lower(v)
end
@en "IsProduction"
@fa "تولید است"
pub func IsProduction(): bool: ret Profile() == "production" or Profile() == "prod" end
@en "IsDevelopment"
@fa "توسعه است"
pub func IsDevelopment(): bool: ret Profile() == "development" or Profile() == "dev" end
@en "IsTest"
@fa "آزمایش است"
pub func IsTest(): bool: ret Profile() == "test" or Profile() == "testing" end
@en "IsStaging"
@fa "آزمایشی است"
pub func IsStaging(): bool: ret Profile() == "staging" end
@en "Load"
@fa "بارگذاری"
pub func Load(path: str): int:
ret _apply_text(io.ReadFile(path), false)
end
@en "Overload"
@fa "بارگذاری اجباری"
pub func Overload(path: str): int:
ret _apply_text(io.ReadFile(path), true)
end
@en "LoadText"
@fa "بارگذاری متن"
pub func LoadText(text: str): int:
ret _apply_text(text, false)
end
@en "LoadDotEnv"
@fa "بارگذاری نقطه‌محیط"
pub func LoadDotEnv(path: str): int:
ret _apply_text(io.ReadFile(path), true)
end
@en "LoadProfile"
@fa "بارگذاری نمایه"
pub func LoadProfile(dir: str): int:
p := Profile()
mut d := envfile.New()
defer envfile.Free(d)
_merge_file(d, path.Join(dir, ".env"))
_merge_file(d, path.Join(dir, ".env.local"))
_merge_file(d, path.Join(dir, ".env.".concat(p)))
_merge_file(d, path.Join(dir, ".env.".concat(p).concat(".local")))
ret _apply_raw(d, false)
end
@en "Expand"
@fa "گسترش"
pub func Expand(text: str): str:
names := envfile.RefNamesIn(text)
defer names.free()
mut base := _base_from_names(names)
defer envfile.Free(base)
mut none := envfile.New()
defer envfile.Free(none)
ret envfile.Expand(text, none, base)
end
@en "error"
@fa "خطا"
package error
import str
import fmt
import collections
@en "KindUnknown"
@fa "نوع نامشخص"
pub const KindUnknown := "unknown"
@en "KindNotFound"
@fa "یافت نشد"
pub const KindNotFound := "not_found"
@en "KindInvalidArgument"
@fa "آرگومان نامعتبر"
pub const KindInvalidArgument := "invalid_argument"
@en "KindPermissionDenied"
@fa "دسترسی رد شد"
pub const KindPermissionDenied := "permission_denied"
@en "KindAlreadyExists"
@fa "نوع از قبل موجود"
pub const KindAlreadyExists := "already_exists"
@en "KindUnavailable"
@fa "در دسترس نیست"
pub const KindUnavailable := "unavailable"
@en "KindTimeout"
@fa "پایان زمان"
pub const KindTimeout := "timeout"
@en "KindCanceled"
@fa "لغو شد"
pub const KindCanceled := "canceled"
@en "KindInternal"
@fa "داخلی"
pub const KindInternal := "internal"
@en "KindIO"
@fa "ورودی خروجی"
pub const KindIO := "io"
@en "KindUnimplemented"
@fa "پیاده سازی نشده"
pub const KindUnimplemented := "unimplemented"
@en "Error"
@fa "خطا"
pub struct Error:
pub kind: str = ""
pub messages: Vector<str> = Vector {}
pub kinds: Vector<str> = Vector {}
pub trace: Vector<str> = Vector {}
pub meta_keys: Vector<str> = Vector {}
pub meta_vals: Vector<str> = Vector {}
end
@en "RetryPolicy"
@fa "سیاست تکرار"
pub struct RetryPolicy:
pub max_attempts: int = 3
pub base_delay_ms: int = 100
pub max_delay_ms: int = 5000
end
func _new(kind: str, message: str, at: str): Error:
mut k := kind
if k == "": k = KindUnknown end
mut e := Error { kind = k }
e.messages.push(message)
e.kinds.push(k)
if at != "": e.trace.push(at) end
ret e
end
@en "Nil"
@fa "خالی"
pub func Nil(): Error: ret Error {} end
@en "IsNil"
@fa "خالی است"
pub func IsNil(e: Error): bool: ret e.kind == "" end
@en "Ok"
@fa "بدون خطا"
pub func Ok(e: Error): bool: ret e.kind == "" end
@en "New"
@fa "جدید"
pub func New(kind: str, message: str): Error: ret _new(kind, message, "") end
@en "NewAt"
@fa "جدید در"
pub func NewAt(kind: str, message: str, at: str): Error: ret _new(kind, message, at) end
@en "Newf"
@fa "جدید قالبی"
pub func Newf(kind: str, tmpl: str, args: Vector<str>): Error: ret _new(kind, fmt.Sprintf(tmpl, args), "") end
@en "Wrap"
@fa "پیچیدن"
pub func Wrap(e: Error, message: str): Error:
if IsNil(e): ret New(KindUnknown, message) end
mut out := Error { kind = e.kind }
out.messages = collections.clone(e.messages)
out.messages.push(message)
out.kinds = collections.clone(e.kinds)
out.trace = collections.clone(e.trace)
out.meta_keys = collections.clone(e.meta_keys)
out.meta_vals = collections.clone(e.meta_vals)
ret out
end
@en "WrapAt"
@fa "پیچیدن در"
pub func WrapAt(e: Error, message: str, at: str): Error:
mut out := Wrap(e, message)
if at != "": out.trace.push(at) end
ret out
end
@en "WrapKind"
@fa "پیچیدن با نوع"
pub func WrapKind(e: Error, kind: str, message: str): Error:
mut out := Wrap(e, message)
out.kind = kind
out.kinds.push(kind)
ret out
end
@en "WithMeta"
@fa "با فراداده"
pub func WithMeta(e: Error, key: str, val: str): Error:
mut src := e
if IsNil(src): src = New(KindUnknown, "") end
mut out := Error { kind = src.kind }
out.messages = collections.clone(src.messages)
out.kinds = collections.clone(src.kinds)
out.trace = collections.clone(src.trace)
out.meta_keys = collections.clone(src.meta_keys)
out.meta_vals = collections.clone(src.meta_vals)
out.meta_keys.push(key)
out.meta_vals.push(val)
ret out
end
@en "Meta"
@fa "فراداده"
pub func Meta(e: Error, key: str): str:
repeat e.meta_keys.len() in i:
if e.meta_keys.get(i) == key: ret e.meta_vals.get(i) end
end
ret ""
end
@en "Kind"
@fa "نوع"
pub func Kind(e: Error): str: ret e.kind end
@en "Is"
@fa "است"
pub func Is(e: Error, kind: str): bool:
repeat e.kinds.len() in i:
if e.kinds.get(i) == kind: ret true end
end
ret false
end
@en "Message"
@fa "پیام"
pub func Message(e: Error): str:
n := e.messages.len()
if n == 0: ret "" end
mut out := e.messages.get(n - 1)
mut i := n - 2
until i >= 0:
out = out.concat(": ").concat(e.messages.get(i))
i -= 1
end
ret out
end
@en "RootMessage"
@fa "پیام ریشه"
pub func RootMessage(e: Error): str:
if e.messages.len() == 0: ret "" end
ret e.messages.get(0)
end
@en "Trace"
@fa "ردیابی"
pub func Trace(e: Error): str:
mut out := str.NewBuilder()
defer str.BufFree(out)
repeat e.trace.len() in i:
if i > 0: str.BufAppend(out, " -> ") end
str.BufAppend(out, e.trace.get(i))
end
ret str.BufStr(out)
end
@en "Format"
@fa "قالب"
pub func Format(e: Error): str:
if IsNil(e): ret "<nil>" end
mut b := str.NewBuilder()
defer str.BufFree(b)
str.BufAppend(b, "[")
str.BufAppend(b, e.kind)
str.BufAppend(b, "] ")
str.BufAppend(b, Message(e))
if e.trace.len() > 0:
str.BufAppend(b, "\n  trace: ")
str.BufAppend(b, Trace(e))
end
repeat e.meta_keys.len() in i:
str.BufAppend(b, "\n  ")
str.BufAppend(b, e.meta_keys.get(i))
str.BufAppend(b, "=")
str.BufAppend(b, e.meta_vals.get(i))
end
ret str.BufStr(b)
end
@en "IsNotFound"
@fa "یافت نشد است"
pub func IsNotFound(e: Error): bool: ret Is(e, KindNotFound) end
@en "IsInvalidArgument"
@fa "آرگومان نامعتبر است"
pub func IsInvalidArgument(e: Error): bool: ret Is(e, KindInvalidArgument) end
@en "IsPermissionDenied"
@fa "دسترسی رد شد است"
pub func IsPermissionDenied(e: Error): bool: ret Is(e, KindPermissionDenied) end
@en "IsAlreadyExists"
@fa "از قبل موجود است"
pub func IsAlreadyExists(e: Error): bool: ret Is(e, KindAlreadyExists) end
@en "IsTimeout"
@fa "پایان زمان است"
pub func IsTimeout(e: Error): bool: ret Is(e, KindTimeout) end
@en "IsCanceled"
@fa "لغو شد است"
pub func IsCanceled(e: Error): bool: ret Is(e, KindCanceled) end
@en "IsUnavailable"
@fa "در دسترس نیست است"
pub func IsUnavailable(e: Error): bool: ret Is(e, KindUnavailable) end
@en "IsInternal"
@fa "داخلی است"
pub func IsInternal(e: Error): bool: ret Is(e, KindInternal) end
@en "IsRetryable"
@fa "قابل تکرار است"
pub func IsRetryable(e: Error): bool:
ret Is(e, KindTimeout) or Is(e, KindUnavailable) or Is(e, KindIO)
end
@en "NewRetryPolicy"
@fa "سیاست تکرار جدید"
pub func NewRetryPolicy(max_attempts: int, base_delay_ms: int, max_delay_ms: int): RetryPolicy:
ret RetryPolicy { max_attempts = max_attempts, base_delay_ms = base_delay_ms, max_delay_ms = max_delay_ms }
end
@en "DelayForAttempt"
@fa "تاخیر برای تلاش"
pub func DelayForAttempt(p &: RetryPolicy, attempt: int): int:
if attempt <= 1: ret p.base_delay_ms end
mut delay := p.base_delay_ms
mut i := 1
until i < attempt:
delay *= 2
if delay >= p.max_delay_ms: ret p.max_delay_ms end
i += 1
end
ret delay
end
@en "ShouldRetry"
@fa "باید تکرار شود"
pub func ShouldRetry(p &: RetryPolicy, e: Error, attempt: int): bool:
if IsNil(e): ret false end
if attempt >= p.max_attempts: ret false end
ret IsRetryable(e)
end
@en "Free"
@fa "آزادسازی"
pub func Free(e &: Error):
e.messages.free()
e.kinds.free()
e.trace.free()
e.meta_keys.free()
e.meta_vals.free()
end
package excel
import conv
@en "CellEmpty"
@fa "سلول خالی"
pub const CellEmpty := 0
@en "CellString"
@fa "سلول رشته‌ای"
pub const CellString := 1
@en "CellNumber"
@fa "سلول عددی"
pub const CellNumber := 2
@en "CellBool"
@fa "سلول منطقی"
pub const CellBool := 3
@en "CellDate"
@fa "سلول تاریخ"
pub const CellDate := 4
@en "CellFormula"
@fa "سلول فرمول"
pub const CellFormula := 5
@en "CellError"
@fa "سلول خطا"
pub const CellError := 6
@en "Cell"
@fa "سلول"
pub struct Cell:
pub row: int = 0
pub col: int = 0
pub kind: int = 0
pub text: str = ""
pub num: f64 = 0.0
pub flag: bool = false
pub formula: str = ""
pub style_id: int = -1
end
@en "CellPos"
@fa "موقعیت سلول"
pub struct CellPos:
pub row: int = 0
pub col: int = 0
end
inline pure func _bp(s: str): i8*: ret (s as void*) as i8* end
inline pure func _ub(bp: i8*, i: int): int:
mut v := bp[i] as int
if v < 0: v = v + 256 end
ret v
end
@en "NewStringCell"
@fa "سلول رشته‌ای جدید"
pub func NewStringCell(row: int, col: int, value: str): Cell:
ret Cell { row = row, col = col, kind = CellString, text = value }
end
@en "NewNumberCell"
@fa "سلول عددی جدید"
pub func NewNumberCell(row: int, col: int, value: f64): Cell:
ret Cell { row = row, col = col, kind = CellNumber, num = value }
end
@en "NewBoolCell"
@fa "سلول منطقی جدید"
pub func NewBoolCell(row: int, col: int, value: bool): Cell:
ret Cell { row = row, col = col, kind = CellBool, flag = value }
end
@en "NewDateCell"
@fa "سلول تاریخ جدید"
pub func NewDateCell(row: int, col: int, epoch: i64): Cell:
ret Cell { row = row, col = col, kind = CellDate, num = EpochToSerial(epoch) }
end
@en "NewFormulaCell"
@fa "سلول فرمول جدید"
pub func NewFormulaCell(row: int, col: int, formula: str, cached: f64): Cell:
ret Cell { row = row, col = col, kind = CellFormula, formula = formula, num = cached }
end
@en "ColumnLabel"
@fa "برچسب ستون"
pub func ColumnLabel(col: int): str:
mut n := col + 1
mut out := ""
until n > 0:
n -= 1
rem := n % 26
out = char_from_code(65 + rem).concat(out)
n /= 26
end
ret out
end
@en "ColumnIndex"
@fa "اندیس ستون"
pub func ColumnIndex(label: str): int:
up := label.upper()
n := up.len()
if n == 0: ret -1 end
bp := _bp(up)
mut idx := 0
mut i := 0
until i < n:
code := _ub(bp, i)
if code < 65 or code > 90: ret -1 end
idx = idx * 26 + (code - 64)
i += 1
end
ret idx - 1
end
@en "CellRef"
@fa "ارجاع سلول"
pub func CellRef(row: int, col: int): str:
ret ColumnLabel(col).concat(conv.FormatInt((row + 1) as i64))
end
@en "ParseCellRef"
@fa "تجزیه ارجاع سلول"
pub func ParseCellRef(ref: str, row_out &: int, col_out &: int): bool:
n := ref.len()
if n == 0: ret false end
bp := _bp(ref)
mut i := 0
until i < n:
code := _ub(bp, i)
mut is_alpha := false
if code >= 65 and code <= 90: is_alpha = true
else code >= 97 and code <= 122: is_alpha = true
end
if not is_alpha: break end
i += 1
end
if i == 0 or i >= n: ret false end
col := ColumnIndex(ref.substr(0, i))
if col < 0: ret false end
rowpart := ref.substr(i, n - i)
rp := _bp(rowpart)
mut j := 0
until j < rowpart.len():
c := _ub(rp, j)
if c < 48 or c > 57: ret false end
j += 1
end
row1 := conv.ParseInt(rowpart) as int
if row1 <= 0: ret false end
row_out = row1 - 1
col_out = col
ret true
end
@en "EpochToSerial"
@fa "تبدیل زمان به سریال"
pub func EpochToSerial(epoch: i64): f64:
ret (epoch as f64) / 86400.0 + 25569.0
end
@en "SerialToEpoch"
@fa "تبدیل سریال به زمان"
pub func SerialToEpoch(serial: f64): i64:
ret ((serial - 25569.0) * 86400.0) as i64
end
package excel
import encoding.csv
import os
import str
@en "SheetToCSV"
@fa "برگه به سی‌اس‌وی"
pub func SheetToCSV(sheet: Sheet): str:
mut sb := str.NewBuilder()
defer str.BufFree(sb)
nr := sheet.row_count()
nc := sheet.col_count()
mut r := 0
until r < nr:
mut fields := Vector {} as Vector<str>
mut c := 0
until c < nc:
fields.push(sheet.get_string(r, c))
c += 1
end
str.BufAppend(sb, csv.WriteLine(fields))
fields.free()
if r < nr - 1: str.BufAppend(sb, "\n") end
r += 1
end
out := str.BufStr(sb)
ret out
end
@en "CSVToSheet"
@fa "سی‌اس‌وی به برگه"
pub func CSVToSheet(text: str, sheet_name: str): Sheet:
mut sh := NewSheet(sheet_name)
normalized := str.Replace(text, "\r\n", "\n")
lines := str.Split(normalized, "\n")
defer lines.free()
mut r := 0
until r < lines.len():
line := lines.get(r)
skip := r == lines.len() - 1 and line.len() == 0
if not skip:
fields := csv.ReadLine(line)
mut c := 0
until c < fields.len():
sh.set_string(r, c, fields.get(c))
c += 1
end
fields.free()
end
r += 1
end
ret sh
end
@en "ReadCSVWorkbook"
@fa "خواندن کتاب کار سی‌اس‌وی"
pub func ReadCSVWorkbook(path: str, ok &: bool, err &: str): Workbook:
ok = false
err = ""
if not os.Exists(path):
err = "cannot open file: ".concat(path)
ret NewWorkbook()
end
text := os.ReadFile(path)
mut book := NewWorkbook()
sh := CSVToSheet(text, "Sheet1")
book.sheets.push(sh)
book.format = FormatCSV
book.source_path = path
ok = true
ret book
end
@en "WriteCSVWorkbook"
@fa "نوشتن کتاب کار سی‌اس‌وی"
pub func WriteCSVWorkbook(book &: Workbook, path: str): bool:
if book.sheets.len() == 0: ret false end
mut idx := book.active_sheet
if idx < 0 or idx >= book.sheets.len(): idx = 0 end
sh := book.sheets.get(idx)
text := SheetToCSV(sh)
ret os.WriteFile(path, text) >= 0
end
@en "excel"
@fa "اکسل"
package excel
import archive
import compress
import conv
import encoding.csv
import filepath
import encoding.json
import os
import str
import time
@en "FormatUnknown"
@fa "قالب نامشخص"
pub const FormatUnknown := 0
@en "FormatXLSX"
@fa "قالب ایکس‌ال‌اس‌ایکس"
pub const FormatXLSX := 1
@en "FormatXLS"
@fa "قالب ایکس‌ال‌اس"
pub const FormatXLS := 2
@en "FormatODS"
@fa "قالب اُدی‌اس"
pub const FormatODS := 3
@en "FormatCSV"
@fa "قالب سی‌اس‌وی"
pub const FormatCSV := 4
@en "DetectFormat"
@fa "تشخیص قالب"
pub func DetectFormat(path: str): int:
ext := filepath.Ext(path).lower()
if ext == ".xlsx": ret FormatXLSX end
if ext == ".xls": ret FormatXLS end
if ext == ".ods": ret FormatODS end
if ext == ".csv": ret FormatCSV end
ret FormatUnknown
end
@en "New"
@fa "جدید"
pub func New(): Workbook:
ret NewWorkbook()
end
@en "Open"
@fa "بازکردن"
pub func Open(path: str, ok &: bool, err &: str): Workbook:
fmt := DetectFormat(path)
if fmt == FormatXLSX:
ret ReadXLSX(path, ok, err)
end
if fmt == FormatODS:
ret ReadODS(path, ok, err)
end
if fmt == FormatXLS:
ret ReadXLS(path, ok, err)
end
if fmt == FormatCSV:
ret ReadCSVWorkbook(path, ok, err)
end
ok = false
err = "unsupported file extension: ".concat(filepath.Ext(path))
ret NewWorkbook()
end
@en "Save"
@fa "ذخیره"
pub func Save(book &: Workbook, path: str): bool:
fmt := DetectFormat(path)
if fmt == FormatXLSX:
ret WriteXLSX(book, path)
end
if fmt == FormatODS:
ret WriteODS(book, path)
end
if fmt == FormatCSV:
ret WriteCSVWorkbook(book, path)
end
ret false
end
package excel
import encoding.json
import str
func _json_ws(s: str, i: int): int:
n := s.len()
bp := _bp(s)
mut p := i
until p < n:
c := _ub(bp, p)
if c != 32 and c != 9 and c != 10 and c != 13: ret p end
p += 1
end
ret p
end
func _json_parse_string(s: str, i: int, out_val &: str): int:
n := s.len()
bp := _bp(s)
if i >= n or _ub(bp, i) != 34: ret -1 end
mut p := i + 1
mut sb := str.NewBuilder()
defer str.BufFree(sb)
until p < n:
c := _ub(bp, p)
if c == 34:
out_val = str.BufStr(sb)
ret p + 1
end
if c == 92 and p + 1 < n:
nc := _ub(bp, p + 1)
if nc == 34: str.BufAppendChar(sb, 34)
else nc == 92: str.BufAppendChar(sb, 92)
else nc == 110: str.BufAppendChar(sb, 10)
else nc == 116: str.BufAppendChar(sb, 9)
else nc == 114: str.BufAppendChar(sb, 13)
else:
str.BufAppendChar(sb, nc)
end
p += 2
else:
str.BufAppendChar(sb, c)
p += 1
end
end
ret -1
end
func _json_parse_token(s: str, i: int, out_val &: str): int:
n := s.len()
bp := _bp(s)
mut p := i
until p < n:
c := _ub(bp, p)
if c == 44 or c == 93 or c == 32 or c == 9 or c == 10 or c == 13: break end
p += 1
end
out_val = s.substr(i, p - i)
ret p
end
func _json_parse_value(s: str, i: int, out_val &: str): int:
p := _json_ws(s, i)
n := s.len()
if p >= n: ret -1 end
bp := _bp(s)
if _ub(bp, p) == 34: ret _json_parse_string(s, p, out_val) end
ret _json_parse_token(s, p, out_val)
end
func _json_parse_row_array(s: str, i: int, out &: Vector<str>): int:
mut p := _json_ws(s, i)
n := s.len()
if p >= n: ret -1 end
bp := _bp(s)
if _ub(bp, p) != 91: ret -1 end
p += 1
p = _json_ws(s, p)
if p < n and _ub(bp, p) == 93: ret p + 1 end
until true:
mut val := ""
p = _json_parse_value(s, p, val)
if p < 0: ret -1 end
out.push(val)
p = _json_ws(s, p)
if p >= n: ret -1 end
c := _ub(bp, p)
if c == 44:
p += 1
p = _json_ws(s, p)
else c == 93:
ret p + 1
else:
ret -1
end
end
end
@en "SheetToJSON"
@fa "برگه به جیسون"
pub func SheetToJSON(sheet: Sheet): str:
mut rows := Vector {} as Vector<str>
defer rows.free()
nr := sheet.row_count()
nc := sheet.col_count()
mut r := 0
until r < nr:
mut cells := Vector {} as Vector<str>
mut c := 0
until c < nc:
cells.push(json.Str(sheet.get_string(r, c)))
c += 1
end
rows.push(json.Array(cells))
cells.free()
r += 1
end
out := json.Array(rows)
ret out
end
@en "JSONToSheet"
@fa "جیسون به برگه"
pub func JSONToSheet(text: str, sheet_name: str): Sheet:
mut sh := NewSheet(sheet_name)
n := text.len()
p := _json_ws(text, 0)
if p >= n: ret sh end
bp := _bp(text)
if _ub(bp, p) != 91: ret sh end
mut pos := p + 1
pos = _json_ws(text, pos)
if pos < n and _ub(bp, pos) == 93: ret sh end
mut row := 0
mut go := true
until go:
mut fields := Vector {} as Vector<str>
np := _json_parse_row_array(text, pos, fields)
if np < 0:
fields.free()
go = false
else:
mut c := 0
until c < fields.len():
sh.set_string(row, c, fields.get(c))
c += 1
end
fields.free()
pos = _json_ws(text, np)
if pos >= n:
go = false
else:
cc := _ub(bp, pos)
if cc == 44:
pos += 1
pos = _json_ws(text, pos)
row += 1
else:
go = false
end
end
end
end
ret sh
end
package excel
import os
@en "FileMeta"
@fa "فراداده پرونده"
pub struct FileMeta:
pub path: str = ""
pub format: int = 0
pub exists: bool = false
pub size: i64 = 0
pub sheet_names: Vector<str> = Vector {} as Vector<str>
pub sheet_rows: Vector<int> = Vector {} as Vector<int>
pub sheet_cols: Vector<int> = Vector {} as Vector<int>
@en "free"
@fa "آزادسازی"
pub func free():
this.sheet_names.free()
this.sheet_rows.free()
this.sheet_cols.free()
end
end
@en "Inspect"
@fa "بازرسی"
pub func Inspect(path: str, ok &: bool, err &: str): FileMeta:
ok = false
err = ""
mut meta := FileMeta { path = path }
if not os.Exists(path):
err = "file does not exist: ".concat(path)
ret meta
end
meta.exists = true
meta.size = os.FileSize(path)
meta.format = DetectFormat(path)
mut open_ok := false
mut open_err := ""
mut book := Open(path, open_ok, open_err)
if not open_ok:
err = open_err
book.free()
ret meta
end
mut i := 0
until i < book.sheets.len():
sh := book.sheets.get(i)
meta.sheet_names.push(sh.name)
meta.sheet_rows.push(sh.row_count())
meta.sheet_cols.push(sh.col_count())
i += 1
end
defer book.free()
ok = true
ret meta
end
package excel
import archive
import compress
import conv
import str
func _ods_days_from_civil(y: i64, m: i64, d: i64): i64:
mut yy := y
if m <= (2 as i64): yy = yy - (1 as i64) end
mut era := 0 as i64
if yy >= (0 as i64): era = yy / (400 as i64)
else:
era = (yy - (399 as i64)) / (400 as i64)
end
yoe := yy - era * (400 as i64)
mp := (m + (9 as i64)) % (12 as i64)
doy := ((153 as i64) * mp + (2 as i64)) / (5 as i64) + d - (1 as i64)
doe := yoe * (365 as i64) + yoe / (4 as i64) - yoe / (100 as i64) + doy
ret era * (146097 as i64) + doe - (719468 as i64)
end
func _ods_parse_iso_date(s: str): i64:
if s.len() < 10: ret 0 end
year := conv.ParseInt(s.substr(0, 4))
month := conv.ParseInt(s.substr(5, 2))
day := conv.ParseInt(s.substr(8, 2))
mut hour := 0 as i64
mut minute := 0 as i64
mut second := 0 as i64
if s.len() >= 19:
hour = conv.ParseInt(s.substr(11, 2))
minute = conv.ParseInt(s.substr(14, 2))
second = conv.ParseInt(s.substr(17, 2))
end
days := _ods_days_from_civil(year, month, day)
ret days * (86400 as i64) + hour * (3600 as i64) + minute * (60 as i64) + second
end
func _ods_strip_formula_prefix(f: str): str:
if str.StartsWith(f, "of:="): ret f.substr(4, f.len() - 4) end
if str.StartsWith(f, "="): ret f.substr(1, f.len() - 1) end
ret f
end
func _ods_collect_text(xml: str, from: int, to_pos: int): str:
mut out := ""
mut pos := from
until true:
idx := XmlFind(xml, "text:p", pos)
if idx < 0 or idx >= to_pos: break end
if XmlSelfClosing(xml, idx):
pos = XmlTagEnd(xml, idx)
else:
cs := XmlTagEnd(xml, idx)
ce := XmlFindClose(xml, "text:p", cs)
if ce < 0 or ce > to_pos: break end
if out.len() > 0: out = out.concat("\n") end
out = out.concat(XmlUnescape(xml.substr(cs, ce - cs)))
pos = XmlTagEnd(xml, ce)
end
end
ret out
end
func _ods_align_from_str(h: str): int:
if h == "start" or h == "left": ret AlignLeft end
if h == "center": ret AlignCenter end
if h == "end" or h == "right": ret AlignRight end
ret AlignDefault
end
func _ods_strip_hash(c: str): str:
if str.StartsWith(c, "#"): ret c.substr(1, c.len() - 1) end
ret c
end
func _ods_parse_automatic_styles(xml: str): HashMap<str, Style>:
mut out := HashMap {} as HashMap<str, Style>
start := XmlFind(xml, "office:automatic-styles", 0)
if start < 0: ret out end
if XmlSelfClosing(xml, start): ret out end
cs := XmlTagEnd(xml, start)
ce := XmlFindClose(xml, "office:automatic-styles", cs)
if ce < 0: ret out end
mut pos := cs
until true:
idx := XmlFind(xml, "style:style", pos)
if idx < 0 or idx >= ce: break end
name := XmlAttr(xml, idx, "style:name")
family := XmlAttr(xml, idx, "style:family")
if XmlSelfClosing(xml, idx):
pos = XmlTagEnd(xml, idx)
else:
scs := XmlTagEnd(xml, idx)
sce := XmlFindClose(xml, "style:style", scs)
if sce < 0 or sce > ce: break end
if family == "table-cell" and name.len() > 0:
mut st := Style {}
tpidx := XmlFind(xml, "style:text-properties", scs)
if tpidx >= 0 and tpidx < sce:
if XmlAttr(xml, tpidx, "fo:font-weight") == "bold": st.bold = true end
if XmlAttr(xml, tpidx, "fo:font-style") == "italic": st.italic = true end
us := XmlAttr(xml, tpidx, "style:text-underline-style")
if us.len() > 0 and us != "none": st.underline = true end
fsz := XmlAttr(xml, tpidx, "fo:font-size")
if fsz.len() > 0:
mut numpart := fsz
if str.EndsWith(fsz, "pt"): numpart = fsz.substr(0, fsz.len() - 2) end
st.font_size = conv.ParseInt(numpart) as int
end
fc := XmlAttr(xml, tpidx, "fo:color")
if fc.len() > 0: st.font_color = _ods_strip_hash(fc) end
end
cpidx := XmlFind(xml, "style:table-cell-properties", scs)
if cpidx >= 0 and cpidx < sce:
bg := XmlAttr(xml, cpidx, "fo:background-color")
if bg.len() > 0: st.bg_color = _ods_strip_hash(bg) end
end
ppidx := XmlFind(xml, "style:paragraph-properties", scs)
if ppidx >= 0 and ppidx < sce:
align := XmlAttr(xml, ppidx, "fo:text-align")
if align.len() > 0: st.align_h = _ods_align_from_str(align) end
end
out.put(name, st)
end
pos = XmlTagEnd(xml, sce)
end
end
ret out
end
func _ods_parse_row_into(xml: str, from: int, to_pos: int, sheet &: Sheet, row: int, styles &: StyleSheet, style_by_name: HashMap<str, Style>):
mut pos := from
mut col := 0
until true:
cidx := XmlFind(xml, "table:table-cell", pos)
covidx := XmlFind(xml, "table:covered-table-cell", pos)
mut idx := cidx
mut is_covered := false
if covidx >= 0 and (cidx < 0 or covidx < cidx):
idx = covidx
is_covered = true
end
if idx < 0 or idx >= to_pos: break end
rep_str := XmlAttr(xml, idx, "table:number-columns-repeated")
mut rep := 1
if rep_str.len() > 0: rep = conv.ParseInt(rep_str) as int end
if rep < 1: rep = 1 end
if is_covered:
col += rep
pos = XmlTagEnd(xml, idx)
else:
if XmlSelfClosing(xml, idx):
pos = XmlTagEnd(xml, idx)
else:
vtype := XmlAttr(xml, idx, "office:value-type")
cs := XmlTagEnd(xml, idx)
ce := XmlFindClose(xml, "table:table-cell", cs)
if ce < 0 or ce > to_pos: break end
if vtype == "string":
sheet.set_string(row, col, _ods_collect_text(xml, cs, ce))
else vtype == "boolean":
bv := XmlAttr(xml, idx, "office:boolean-value")
sheet.set_bool(row, col, bv == "true")
else vtype == "date":
dv := XmlAttr(xml, idx, "office:date-value")
sheet.set_date(row, col, _ods_parse_iso_date(dv))
else vtype == "float" or vtype == "currency" or vtype == "percentage":
vv := XmlAttr(xml, idx, "office:value")
num := conv.ParseFloat(vv)
formula := XmlAttr(xml, idx, "table:formula")
if formula.len() > 0:
sheet.set_formula(row, col, _ods_strip_formula_prefix(formula), num)
else:
sheet.set_number(row, col, num)
end
end
span_cols_str := XmlAttr(xml, idx, "table:number-columns-spanned")
span_rows_str := XmlAttr(xml, idx, "table:number-rows-spanned")
if span_cols_str.len() > 0 or span_rows_str.len() > 0:
mut sc := 1
mut sr := 1
if span_cols_str.len() > 0: sc = conv.ParseInt(span_cols_str) as int end
if span_rows_str.len() > 0: sr = conv.ParseInt(span_rows_str) as int end
if sc > 1 or sr > 1:
sheet.merge_cells(row, col, row + sr - 1, col + sc - 1)
end
end
sname := XmlAttr(xml, idx, "table:style-name")
if sname.len() > 0 and style_by_name.has(sname):
sid := styles.get_or_add(style_by_name.get(sname))
sheet.set_style(row, col, sid)
end
pos = XmlTagEnd(xml, ce)
end
col += rep
end
end
end
func _ods_parse_table_into(xml: str, from: int, to_pos: int, sheet &: Sheet, styles &: StyleSheet, style_by_name: HashMap<str, Style>):
mut pos := from
mut row := 0
until true:
ridx := XmlFind(xml, "table:table-row", pos)
if ridx < 0 or ridx >= to_pos: break end
rep_str := XmlAttr(xml, ridx, "table:number-rows-repeated")
mut rep := 1
if rep_str.len() > 0: rep = conv.ParseInt(rep_str) as int end
if rep < 1: rep = 1 end
if XmlSelfClosing(xml, ridx):
row += rep
pos = XmlTagEnd(xml, ridx)
else:
rcs := XmlTagEnd(xml, ridx)
rce := XmlFindClose(xml, "table:table-row", rcs)
if rce < 0 or rce > to_pos: break end
_ods_parse_row_into(xml, rcs, rce, sheet, row, styles, style_by_name)
row += rep
pos = XmlTagEnd(xml, rce)
end
end
end
@en "ReadODS"
@fa "خواندن اُدی‌اس"
pub func ReadODS(path: str, ok &: bool, err &: str): Workbook:
ok = false
err = ""
mut book := NewWorkbook()
mut read_ok := false
data := archive.ReadBinaryFile(path, read_ok)
if not read_ok:
err = "cannot open file: ".concat(path)
compress.BufFree(data)
ret book
end
mut content_ok := false
contentbuf := archive.ZipExtractByName(data.data, data.len, "content.xml", content_ok)
if not content_ok:
err = "not a valid .ods file (missing content.xml)"
compress.BufFree(contentbuf)
compress.BufFree(data)
ret book
end
xml := compress.BufToStrUnsafe(contentbuf)
style_by_name := _ods_parse_automatic_styles(xml)
mut pos := 0
until true:
tidx := XmlFind(xml, "table:table", pos)
if tidx < 0: break end
name := XmlAttr(xml, tidx, "table:name")
mut sh := NewSheet(name)
if XmlSelfClosing(xml, tidx):
pos = XmlTagEnd(xml, tidx)
else:
tcs := XmlTagEnd(xml, tidx)
tce := XmlFindClose(xml, "table:table", tcs)
if tce < 0:
pos = XmlTagEnd(xml, tidx)
else:
_ods_parse_table_into(xml, tcs, tce, sh, book.styles, style_by_name)
pos = XmlTagEnd(xml, tce)
end
end
book.sheets.push(sh)
end
defer style_by_name.free()
compress.BufFree(contentbuf)
compress.BufFree(data)
book.format = FormatODS
book.source_path = path
ok = true
ret book
end
package excel
import archive
import conv
import str
import time
const _ODS_MIME := "application/vnd.oasis.opendocument.spreadsheet"
func _ods_style_name(idx: int): str:
ret "ce".concat(conv.FormatInt(idx as i64))
end
func _ods_text_props(st: Style): str:
mut out := "<style:text-properties"
if st.bold: out = out.concat(` fo:font-weight="bold"`) end
if st.italic: out = out.concat(` fo:font-style="italic"`) end
if st.underline: out = out.concat(` style:text-underline-style="solid" style:text-underline-type="single"`) end
out = out.concat(` fo:font-size="`).concat(conv.FormatInt(st.font_size as i64)).concat(`pt"`)
if st.font_color.len() > 0: out = out.concat(` fo:color="#`).concat(st.font_color).concat(`"`) end
out = out.concat("/>")
ret out
end
func _ods_align_value(h: int): str:
if h == AlignLeft: ret "start" end
if h == AlignCenter: ret "center" end
if h == AlignRight: ret "end" end
ret ""
end
func _ods_automatic_styles(styles: StyleSheet): str:
mut sb := str.NewBuilder()
defer str.BufFree(sb)
n := styles.count()
mut i := 0
until i < n:
st := styles.get(i)
str.BufAppend(sb, `<style:style style:name="`)
str.BufAppend(sb, _ods_style_name(i))
str.BufAppend(sb, `" style:family="table-cell">`)
str.BufAppend(sb, _ods_text_props(st))
if st.bg_color.len() > 0:
str.BufAppend(sb, `<style:table-cell-properties fo:background-color="#`.concat(st.bg_color).concat(`"/>`))
end
align := _ods_align_value(st.align_h)
if align.len() > 0:
str.BufAppend(sb, `<style:paragraph-properties fo:text-align="`.concat(align).concat(`"/>`))
end
str.BufAppend(sb, "</style:style>")
i += 1
end
out := str.BufStr(sb)
ret out
end
func _ods_cell_xml(c: Cell): str:
mut style_attr := ""
if c.style_id >= 0: style_attr = ` table:style-name="`.concat(_ods_style_name(c.style_id)).concat(`"`) end
if c.kind == CellString:
ret `<table:table-cell office:value-type="string"`.concat(style_attr).concat("><text:p>").concat(XmlEscape(c.text)).concat("</text:p></table:table-cell>")
else c.kind == CellBool:
mut bv := "false"
mut disp := "FALSE"
if c.flag:
bv = "true"
disp = "TRUE"
end
ret `<table:table-cell office:value-type="boolean" office:boolean-value="`.concat(bv).concat(`"`).concat(style_attr).concat("><text:p>").concat(disp).concat("</text:p></table:table-cell>")
else c.kind == CellDate:
epoch := SerialToEpoch(c.num)
iso := time.FormatISO(epoch)
disp := time.FormatDate(epoch)
ret `<table:table-cell office:value-type="date" office:date-value="`.concat(iso).concat(`"`).concat(style_attr).concat("><text:p>").concat(disp).concat("</text:p></table:table-cell>")
else c.kind == CellFormula:
ret `<table:table-cell table:formula="of:=`.concat(XmlEscape(c.formula)).concat(`" office:value-type="float" office:value="`).concat(conv.FormatFloat(c.num)).concat(`"`).concat(style_attr).concat("><text:p>").concat(conv.FormatFloat(c.num)).concat("</text:p></table:table-cell>")
else c.kind == CellError:
ret `<table:table-cell office:value-type="string"`.concat(style_attr).concat("><text:p>").concat(XmlEscape(c.text)).concat("</text:p></table:table-cell>")
else c.kind == CellNumber:
ret `<table:table-cell office:value-type="float" office:value="`.concat(conv.FormatFloat(c.num)).concat(`"`).concat(style_attr).concat("><text:p>").concat(conv.FormatFloat(c.num)).concat("</text:p></table:table-cell>")
else:
ret "<table:table-cell/>"
end
end
func _ods_splice_span(cellxml: str, cols: int, rows: int): str:
prefix := "<table:table-cell"
if not str.StartsWith(cellxml, prefix): ret cellxml end
rest := cellxml.substr(prefix.len(), cellxml.len() - prefix.len())
span := ` table:number-columns-spanned="`.concat(conv.FormatInt(cols as i64)).concat(`" table:number-rows-spanned="`).concat(conv.FormatInt(rows as i64)).concat(`"`)
ret prefix.concat(span).concat(rest)
end
func _ods_sheet_xml(sheet: Sheet): str:
mut sb := str.NewBuilder()
defer str.BufFree(sb)
str.BufAppend(sb, `<table:table table:name="`)
str.BufAppend(sb, XmlEscape(sheet.name))
str.BufAppend(sb, `">`)
nr := sheet.row_count()
nc := sheet.col_count()
if nc > 0:
str.BufAppend(sb, `<table:table-column table:number-columns-repeated="`)
str.BufAppendInt(sb, nc as i64)
str.BufAppend(sb, `"/>`)
end
mut r := 0
until r < nr:
str.BufAppend(sb, "<table:table-row>")
mut c := 0
until c < nc:
mut found := false
rg := sheet.merged_range(r, c, found)
if found and rg.row1 == r and rg.col1 == c:
span_cols := rg.col2 - rg.col1 + 1
span_rows := rg.row2 - rg.row1 + 1
cell := sheet.get_cell(r, c)
str.BufAppend(sb, _ods_splice_span(_ods_cell_xml(cell), span_cols, span_rows))
else found:
str.BufAppend(sb, "<table:covered-table-cell/>")
else:
if sheet.has_cell(r, c):
str.BufAppend(sb, _ods_cell_xml(sheet.get_cell(r, c)))
else:
str.BufAppend(sb, "<table:table-cell/>")
end
end
c += 1
end
str.BufAppend(sb, "</table:table-row>")
r += 1
end
str.BufAppend(sb, "</table:table>")
out := str.BufStr(sb)
ret out
end
func _ods_content_xml(book &: Workbook): str:
mut sb := str.NewBuilder()
defer str.BufFree(sb)
str.BufAppend(sb, `<?xml version="1.0" encoding="UTF-8"?><office:document-content xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:version="1.2">`)
str.BufAppend(sb, "<office:automatic-styles>")
str.BufAppend(sb, _ods_automatic_styles(book.styles))
str.BufAppend(sb, "</office:automatic-styles>")
str.BufAppend(sb, "<office:body><office:spreadsheet>")
mut i := 0
until i < book.sheets.len():
sh := book.sheets.get(i)
str.BufAppend(sb, _ods_sheet_xml(sh))
i += 1
end
str.BufAppend(sb, "</office:spreadsheet></office:body></office:document-content>")
out := str.BufStr(sb)
ret out
end
func _ods_manifest_xml(): str:
ret `<?xml version="1.0" encoding="UTF-8"?><manifest:manifest xmlns:manifest="urn:oasis:names:tc:opendocument:xmlns:manifest:1.0" manifest:version="1.2"><manifest:file-entry manifest:full-path="/" manifest:version="1.2" manifest:media-type="application/vnd.oasis.opendocument.spreadsheet"/><manifest:file-entry manifest:full-path="content.xml" manifest:media-type="text/xml"/></manifest:manifest>`
end
@en "WriteODS"
@fa "نوشتن اُدی‌اس"
pub func WriteODS(book &: Workbook, path: str): bool:
n := book.sheets.len()
if n == 0: ret false end
mut files := Vector {} as Vector<archive.ZipFileInput>
defer files.free()
files.push(archive.MakeZipFileInput("mimetype", _ODS_MIME as void*, _ODS_MIME.len(), 0))
manifest := _ods_manifest_xml()
files.push(archive.MakeZipFileInput("META-INF/manifest.xml", manifest as void*, manifest.len(), 8))
content := _ods_content_xml(book)
files.push(archive.MakeZipFileInput("content.xml", content as void*, content.len(), 8))
ret archive.ZipCreateFile(files, path)
end
package excel
import conv
import time
@en "MergeRange"
@fa "بازه ادغام"
pub struct MergeRange:
pub row1: int = 0
pub col1: int = 0
pub row2: int = 0
pub col2: int = 0
end
@en "Sheet"
@fa "برگه"
pub struct Sheet:
pub name: str = ""
pub cells: HashMap<str, Cell> = HashMap {} as HashMap<str, Cell>
pub max_row: int = -1
pub max_col: int = -1
pub merges: Vector<MergeRange> = Vector {} as Vector<MergeRange>
func _touch(row: int, col: int):
if row > this.max_row: this.max_row = row end
if col > this.max_col: this.max_col = col end
end
@en "set_string"
@fa "تنظیم رشته"
pub func set_string(row: int, col: int, value: str):
this.cells.put(_cell_key(row, col), NewStringCell(row, col, value))
this._touch(row, col)
end
@en "set_cell"
@fa "تنظیم سلول"
pub func set_cell(row: int, col: int, value: str):
this.set_string(row, col, value)
end
@en "set_number"
@fa "تنظیم عدد"
pub func set_number(row: int, col: int, value: f64):
this.cells.put(_cell_key(row, col), NewNumberCell(row, col, value))
this._touch(row, col)
end
@en "set_int"
@fa "تنظیم عدد صحیح"
pub func set_int(row: int, col: int, value: i64):
this.set_number(row, col, value as f64)
end
@en "set_bool"
@fa "تنظیم منطقی"
pub func set_bool(row: int, col: int, value: bool):
this.cells.put(_cell_key(row, col), NewBoolCell(row, col, value))
this._touch(row, col)
end
@en "set_date"
@fa "تنظیم تاریخ"
pub func set_date(row: int, col: int, epoch: i64):
this.cells.put(_cell_key(row, col), NewDateCell(row, col, epoch))
this._touch(row, col)
end
@en "set_formula"
@fa "تنظیم فرمول"
pub func set_formula(row: int, col: int, formula: str, cached: f64):
this.cells.put(_cell_key(row, col), NewFormulaCell(row, col, formula, cached))
this._touch(row, col)
end
@en "set_error"
@fa "تنظیم خطا"
pub func set_error(row: int, col: int, code: str):
c := Cell { row = row, col = col, kind = CellError, text = code }
this.cells.put(_cell_key(row, col), c)
this._touch(row, col)
end
@en "set_style"
@fa "تنظیم سبک"
pub func set_style(row: int, col: int, style_id: int):
mut c := this.get_cell(row, col)
c.style_id = style_id
this.cells.put(_cell_key(row, col), c)
this._touch(row, col)
end
@en "clear_cell"
@fa "پاک‌سازی سلول"
pub func clear_cell(row: int, col: int):
this.cells.remove(_cell_key(row, col))
end
@en "has_cell"
@fa "دارای سلول"
pub func has_cell(row: int, col: int): bool:
ret this.cells.has(_cell_key(row, col))
end
@en "get_cell"
@fa "دریافت سلول"
pub func get_cell(row: int, col: int): Cell:
key := _cell_key(row, col)
if this.cells.has(key): ret this.cells.get(key) end
ret Cell { row = row, col = col, kind = CellEmpty }
end
@en "get_string"
@fa "دریافت رشته"
pub func get_string(row: int, col: int): str:
ret _cell_display(this.get_cell(row, col))
end
@en "get_number"
@fa "دریافت عدد"
pub func get_number(row: int, col: int): f64:
c := this.get_cell(row, col)
if c.kind == CellNumber: ret c.num
else c.kind == CellDate: ret c.num
else c.kind == CellFormula: ret c.num
else c.kind == CellBool:
if c.flag: ret 1.0 end
ret 0.0
else:
ret 0.0
end
end
@en "get_bool"
@fa "دریافت منطقی"
pub func get_bool(row: int, col: int): bool:
c := this.get_cell(row, col)
if c.kind == CellBool: ret c.flag end
if c.kind == CellNumber: ret c.num != 0.0 end
ret false
end
@en "get_formula"
@fa "دریافت فرمول"
pub func get_formula(row: int, col: int): str:
ret this.get_cell(row, col).formula
end
@en "row_count"
@fa "شمار سطرها"
pub func row_count(): int: ret this.max_row + 1 end
@en "col_count"
@fa "شمار ستون‌ها"
pub func col_count(): int: ret this.max_col + 1 end
@en "set_row"
@fa "تنظیم سطر"
pub func set_row(row: int, values: Vector<str>):
mut i := 0
until i < values.len():
this.set_string(row, i, values.get(i))
i += 1
end
end
@en "set_column"
@fa "تنظیم ستون"
pub func set_column(col: int, values: Vector<str>):
mut i := 0
until i < values.len():
this.set_string(i, col, values.get(i))
i += 1
end
end
@en "set_table"
@fa "تنظیم جدول"
pub func set_table(start_row: int, start_col: int, flat: Vector<str>, num_cols: int):
if num_cols <= 0: ret end
mut i := 0
until i < flat.len():
r := start_row + i / num_cols
c := start_col + i % num_cols
this.set_string(r, c, flat.get(i))
i += 1
end
end
@en "get_row"
@fa "دریافت سطر"
pub func get_row(row: int): Vector<Cell>:
mut out := Vector {} as Vector<Cell>
mut c := 0
n := this.col_count()
until c < n:
out.push(this.get_cell(row, c))
c += 1
end
ret out
end
@en "get_column"
@fa "دریافت ستون"
pub func get_column(col: int): Vector<Cell>:
mut out := Vector {} as Vector<Cell>
mut r := 0
n := this.row_count()
until r < n:
out.push(this.get_cell(r, col))
r += 1
end
ret out
end
@en "get_all"
@fa "دریافت همه"
pub func get_all(): Vector<Cell>:
mut out := Vector {} as Vector<Cell>
nr := this.row_count()
nc := this.col_count()
mut r := 0
until r < nr:
mut c := 0
until c < nc:
out.push(this.get_cell(r, c))
c += 1
end
r += 1
end
ret out
end
@en "find"
@fa "جستجو"
pub func find(value: str): Vector<CellPos>:
mut out := Vector {} as Vector<CellPos>
mut it := this.cells.iter()
until it.has_next():
cell := it.value()
if _cell_display(cell) == value:
out.push(CellPos { row = cell.row, col = cell.col })
end
it.next()
end
ret out
end
@en "filter_rows_equals"
@fa "پالایش سطرها"
pub func filter_rows_equals(col: int, value: str): Vector<int>:
mut out := Vector {} as Vector<int>
mut r := 0
n := this.row_count()
until r < n:
if this.get_string(r, col) == value:
out.push(r)
end
r += 1
end
ret out
end
@en "merge_cells"
@fa "ادغام سلول‌ها"
pub func merge_cells(row1: int, col1: int, row2: int, col2: int):
this.merges.push(MergeRange { row1 = row1, col1 = col1, row2 = row2, col2 = col2 })
this._touch(row2, col2)
end
@en "is_merged"
@fa "ادغام‌شده است"
pub func is_merged(row: int, col: int): bool:
mut i := 0
until i < this.merges.len():
m := this.merges.get(i)
if row >= m.row1 and row <= m.row2 and col >= m.col1 and col <= m.col2:
ret true
end
i += 1
end
ret false
end
@en "merged_range"
@fa "بازه ادغام‌شده"
pub func merged_range(row: int, col: int, found &: bool): MergeRange:
mut i := 0
until i < this.merges.len():
m := this.merges.get(i)
if row >= m.row1 and row <= m.row2 and col >= m.col1 and col <= m.col2:
found = true
ret m
end
i += 1
end
found = false
ret MergeRange {}
end
@en "free"
@fa "آزادسازی"
pub func free():
this.cells.free()
this.merges.free()
end
end
func _cell_key(row: int, col: int): str:
ret conv.FormatInt(row as i64).concat(":").concat(conv.FormatInt(col as i64))
end
func _cell_display(c: Cell): str:
if c.kind == CellString: ret c.text
else c.kind == CellNumber: ret conv.FormatFloat(c.num)
else c.kind == CellBool: ret conv.FormatBool(c.flag)
else c.kind == CellDate: ret time.FormatDate(SerialToEpoch(c.num))
else c.kind == CellFormula: ret conv.FormatFloat(c.num)
else c.kind == CellError: ret c.text
else:
ret ""
end
end
@en "NewSheet"
@fa "برگه جدید"
pub func NewSheet(name: str): Sheet:
ret Sheet { name = name }
end
