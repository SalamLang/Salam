t[i] = 0 as i64
end
repeat 16 in i:
repeat 16 in j:
t[i + j] += a.v[i] * b.v[j]
end
end
repeat 15 in i:
t[i] += 38 * t[i + 16]
end
mut o := Gf {}
repeat 16 in i:
o.v[i] = t[i]
end
_gf_car(o)
_gf_car(o)
ret o
end
func _gf_sq(a: Gf): Gf:
ret _gf_mul(a, a)
end
func _gf_sel(p &: Gf, q &: Gf, b: int):
c := ~((b as i64) - (1 as i64))
repeat 16 in i:
t := c & (p.v[i] ^ q.v[i])
p.v[i] = p.v[i] ^ t
q.v[i] = q.v[i] ^ t
