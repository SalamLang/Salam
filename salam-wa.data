@en "npy"
@fa "ان‌پی‌وای"
package npy
import archive
import compress
import encoding.binary
import matrix
import mem
@en "NPY_F64"
@fa "نوع اعشاری هشت"
pub const NPY_F64 := 0
@en "NPY_F32"
@fa "نوع اعشاری چهار"
pub const NPY_F32 := 1
@en "NPY_I8"
@fa "نوع صحیح یک"
pub const NPY_I8 := 2
@en "NPY_I16"
@fa "نوع صحیح دو"
pub const NPY_I16 := 3
@en "NPY_I32"
@fa "نوع صحیح چهار"
pub const NPY_I32 := 4
@en "NPY_I64"
@fa "نوع صحیح هشت"
pub const NPY_I64 := 5
@en "NPY_U8"
@fa "نوع بی‌علامت یک"
pub const NPY_U8 := 6
@en "NPY_U16"
@fa "نوع بی‌علامت دو"
pub const NPY_U16 := 7
@en "NPY_U32"
@fa "نوع بی‌علامت چهار"
pub const NPY_U32 := 8
@en "NPY_BOOL"
@fa "نوع دودویی"
pub const NPY_BOOL := 9
@en "NpyArray"
@fa "آرایه ان‌پی‌وای"
pub struct NpyArray:
pub shape: Vector<int> = Vector {}
pub dtype: int = NPY_F64
pub data: Vector<f64> = Vector {}
@en "ndim"
@fa "شمار بعد"
pub func ndim(): int: ret this.shape.len() end
@en "count"
@fa "شمار"
pub func count(): int: ret this.data.len() end
@en "free"
@fa "آزادسازی"
pub func free():
this.shape.free()
this.data.free()
end
end
func _elem_size(dtype: int): int:
if dtype == NPY_F64 or dtype == NPY_I64: ret 8 end
if dtype == NPY_F32 or dtype == NPY_I32 or dtype == NPY_U32: ret 4 end
if dtype == NPY_I16 or dtype == NPY_U16: ret 2 end
ret 1
end
func _read_elem(rd &: compress.ByteReader, dtype: int, big: bool): f64:
if dtype == NPY_F64: ret binary.ReadF64(rd, big) end
if dtype == NPY_F32: ret binary.ReadF32(rd, big) end
if dtype == NPY_I8 or dtype == NPY_U8 or dtype == NPY_BOOL:
mut v := binary.ReadU8(rd)
if dtype == NPY_I8 and v >= 128: v = v - 256 end
ret v as f64
end
if dtype == NPY_I16 or dtype == NPY_U16:
mut v := 0
if big: v = binary.ReadU16BE(rd) else:
v = binary.ReadU16LE(rd)
end
if dtype == NPY_I16 and v >= 32768: v = v - 65536 end
ret v as f64
end
if dtype == NPY_I32 or dtype == NPY_U32:
mut v := 0 as i64
if big: v = binary.ReadU32BE(rd) as i64 else:
v = binary.ReadU32LE(rd) as i64
end
if v < 0: v = v + 4294967296 end
if dtype == NPY_I32 and v >= 2147483648: v = v - 4294967296 end
ret v as f64
end
if big: ret binary.ReadU64BE(rd) as f64 end
ret binary.ReadU64LE(rd) as f64
end
@en "ReadNpy"
@fa "خواندن ان‌پی‌وای"
pub func ReadNpy(p: void*, n: int, ok &: bool): NpyArray:
ok = false
mut a := NpyArray {}
mut rd := compress.NewByteReader(p, n)
mut dtype := 0
mut big := false
mut fortran := false
hdr_ok := _read_header(rd, dtype, big, fortran, a.shape)
if hdr_ok == false: ret a end
mut total := 1
repeat a.shape.len() in i: total = total * a.shape.get(i) end
if a.shape.len() == 0: total = 1 end
esz := _elem_size(dtype)
if compress.RdLeft(rd) < total * esz:
a.shape.free()
ret a
end
if fortran and a.shape.len() > 2:
a.shape.free()
ret a
end
a.dtype = dtype
a.data.alloc(total)
pd := a.data.data
if dtype == NPY_F64 and big == false and fortran == false:
src := ((rd.data as i64) + (rd.pos as i64)) as void*
mem.Copy(pd as void*, src, (total * 8) as u64)
else fortran and a.shape.len() == 2:
rows := a.shape.get(0)
cols := a.shape.get(1)
repeat cols in j:
repeat rows in i: pd[i * cols + j] = _read_elem(rd, dtype, big) end
end
else:
repeat total in k: pd[k] = _read_elem(rd, dtype, big) end
end
if a.shape.len() == 0: a.shape.push(1) end
ok = true
ret a
end
@en "ReadNpyFile"
@fa "خواندن پرونده ان‌پی‌وای"
pub func ReadNpyFile(path: str, ok &: bool): NpyArray:
ok = false
mut fok := false
mut raw := archive.ReadBinaryFile(path, fok)
if fok == false:
compress.BufFree(raw)
ret NpyArray {}
end
a := ReadNpy(raw.data, compress.BufLen(raw), ok)
compress.BufFree(raw)
ret a
end
@en "WriteNpy"
@fa "نوشتن ان‌پی‌وای"
pub func WriteNpy(a &: NpyArray): compress.ByteBuf:
mut buf := compress.NewByteBuf()
_write_header(buf, a.shape)
n := a.data.len()
compress.BufPushBytes(buf, a.data.data as void*, n * 8)
ret buf
end
@en "WriteNpyFile"
@fa "نوشتن پرونده ان‌پی‌وای"
pub func WriteNpyFile(a &: NpyArray, path: str): bool:
mut buf := WriteNpy(a)
ok := archive.WriteBinaryFileBuf(path, buf)
compress.BufFree(buf)
ret ok
end
@en "ToMatrix"
@fa "به ماتریس"
pub func ToMatrix(a &: NpyArray, ok &: bool): matrix.Matrix:
ok = false
d := a.shape.len()
if d != 1 and d != 2: ret matrix.Matrix {} end
mut rows := 1
mut cols := a.shape.get(0)
if d == 2:
rows = a.shape.get(0)
cols = a.shape.get(1)
end
m := matrix.FromArray(rows, cols, a.data)
ok = true
ret m
end
@en "FromMatrix"
@fa "از ماتریس"
pub func FromMatrix(m &: matrix.Matrix): NpyArray:
mut a := NpyArray {}
a.shape.push(m.rows)
a.shape.push(m.cols)
a.data.alloc(m.count())
pd := a.data.data
repeat m.count() in k: pd[k] = m.a.get(k) end
ret a
end
package npy
import compress
import conv
import encoding.binary
import mem
import str
inline pure func _bp(s: str): i8*: ret (s as void*) as i8* end
inline pure func _ub(bp: i8*, i: int): int:
mut v := bp[i] as int
if v < 0: v = v + 256 end
ret v
end
func _quoted_after(text: str, key: str): str:
k := str.IndexOf(text, key)
if k < 0: ret "" end
n := str.Len(text)
bp := _bp(text)
mut i := k + str.Len(key)
mut colon := false
until i < n:
c := _ub(bp, i)
if c == 58: colon = true end
if colon and (c == 39 or c == 34):
mut j := i + 1
until j < n and _ub(bp, j) != 39 and _ub(bp, j) != 34: j += 1 end
ret str.Substr(text, i + 1, j - i - 1)
end
i += 1
end
ret ""
end
func _bool_after(text: str, key: str, found &: bool): bool:
found = false
k := str.IndexOf(text, key)
if k < 0: ret false end
rest := str.Substr(text, k + str.Len(key), str.Len(text) - k - str.Len(key))
t := str.IndexOf(rest, "True")
f := str.IndexOf(rest, "False")
mem.Free(rest as void*)
if t < 0 and f < 0: ret false end
found = true
if f < 0: ret true end
if t < 0: ret false end
ret t < f
end
func _shape_after(text: str, key: str, shape_out &: Vector<int>): bool:
k := str.IndexOf(text, key)
if k < 0: ret false end
n := str.Len(text)
bp := _bp(text)
mut i := k + str.Len(key)
until i < n and _ub(bp, i) != 40: i += 1 end
if i >= n: ret false end
i += 1
mut cur := 0
mut have := false
until i < n:
c := _ub(bp, i)
if c >= 48 and c <= 57:
cur = cur * 10 + (c - 48)
have = true
else c == 44:
if have: shape_out.push(cur) end
cur = 0
have = false
else c == 41:
if have: shape_out.push(cur) end
ret true
else c != 32:
ret false
end
i += 1
end
ret false
end
func _descr_to_dtype(descr: str, dtype &: int, big &: bool): bool:
n := str.Len(descr)
if n < 2: ret false end
bp := _bp(descr)
mut i := 0
c0 := _ub(bp, 0)
big = false
if c0 == 60 or c0 == 124 or c0 == 61:
i = 1
else c0 == 62:
big = true
i = 1
end
if i >= n: ret false end
kind := _ub(bp, i)
mut size := 0
mut j := i + 1
until j < n:
d := _ub(bp, j)
if d < 48 or d > 57: ret false end
size = size * 10 + (d - 48)
j += 1
end
if kind == 102:
if size == 8: dtype = NPY_F64 ret true end
if size == 4: dtype = NPY_F32 ret true end
ret false
end
if kind == 105:
if size == 1: dtype = NPY_I8 ret true end
if size == 2: dtype = NPY_I16 ret true end
if size == 4: dtype = NPY_I32 ret true end
if size == 8: dtype = NPY_I64 ret true end
ret false
end
if kind == 117:
if size == 1: dtype = NPY_U8 ret true end
if size == 2: dtype = NPY_U16 ret true end
if size == 4: dtype = NPY_U32 ret true end
ret false
end
if kind == 98 and size == 1:
dtype = NPY_BOOL
ret true
end
ret false
end
func _read_header(rd &: compress.ByteReader, dtype &: int, big &: bool, fortran &: bool, shape_out &: Vector<int>): bool:
if compress.RdLeft(rd) < 10: ret false end
if binary.ReadU8(rd) != 147: ret false end
if binary.ReadU8(rd) != 78 or binary.ReadU8(rd) != 85 or binary.ReadU8(rd) != 77 or binary.ReadU8(rd) != 80 or binary.ReadU8(rd) != 89: ret false end
major := binary.ReadU8(rd)
binary.ReadU8(rd)
mut hlen := 0
if major == 1:
hlen = binary.ReadU16LE(rd)
else major == 2 or major == 3:
hlen = binary.ReadU32LE(rd)
else:
ret false
end
if rd.bad or hlen <= 0 or compress.RdLeft(rd) < hlen: ret false end
mut hb := compress.RdBytes(rd, hlen)
text := compress.BufToStrUnsafe(hb)
compress.BufFree(hb)
descr := _quoted_after(text, "descr")
mut ok := str.Len(descr) > 0
if ok: ok = _descr_to_dtype(descr, dtype, big) end
mut found := false
if ok:
fortran = _bool_after(text, "fortran_order", found)
ok = found
end
if ok: ok = _shape_after(text, "shape", shape_out) end
if str.Len(descr) > 0: mem.Free(descr as void*) end
if str.Len(text) > 0: mem.Free(text as void*) end
ret ok
end
func _write_header(buf &: compress.ByteBuf, shape &: Vector<int>):
mut sb := str.NewBuilder()
str.BufAppend(sb, "{'descr': '<f8', 'fortran_order': False, 'shape': (")
repeat shape.len() in i:
str.BufAppendInt(sb, shape.get(i) as i64)
if shape.len() == 1 or i + 1 < shape.len(): str.BufAppendChar(sb, 44) end
if i + 1 < shape.len(): str.BufAppendChar(sb, 32) end
end
str.BufAppend(sb, "), }")
total := 10 + (str.BufLen(sb) as int) + 1
mut pad := 0
if total % 64 != 0: pad = 64 - total % 64 end
repeat pad: str.BufAppendChar(sb, 32) end
str.BufAppendChar(sb, 10)
dict := str.BufStr(sb)
str.BufFree(sb)
binary.WriteU8(buf, 147)
compress.BufPushBytes(buf, "NUMPY" as void*, 5)
binary.WriteU8(buf, 1)
binary.WriteU8(buf, 0)
binary.WriteU16LE(buf, str.Len(dict))
compress.BufPushBytes(buf, dict as void*, str.Len(dict))
mem.Free(dict as void*)
end
package npy
import archive
import compress
import mem
import str
func _strip_npy(name: str): str:
if str.EndsWith(name, ".npy"):
ret str.Substr(name, 0, str.Len(name) - 4)
end
ret str.Clone(name)
end
@en "NpzList"
@fa "فهرست ان‌پی‌زد"
pub func NpzList(path: str, ok &: bool): Vector<str>:
mut out := Vector {} as Vector<str>
ok = false
mut fok := false
mut raw := archive.ReadBinaryFile(path, fok)
if fok == false:
compress.BufFree(raw)
ret out
end
mut entries := archive.ZipList(raw.data, compress.BufLen(raw))
repeat entries.len() in i:
e := entries.get(i)
if e.is_dir == false: out.push(_strip_npy(e.name)) end
end
ok = entries.len() > 0
archive.FreeEntries(entries)
compress.BufFree(raw)
ret out
end
@en "NpzRead"
@fa "خواندن ان‌پی‌زد"
pub func NpzRead(path: str, key: str, ok &: bool): NpyArray:
ok = false
mut fok := false
mut raw := archive.ReadBinaryFile(path, fok)
if fok == false:
compress.BufFree(raw)
ret NpyArray {}
end
mut zok := false
named := key + ".npy"
mut member := archive.ZipExtractByName(raw.data, compress.BufLen(raw), named, zok)
mem.Free(named as void*)
if zok == false:
compress.BufFree(member)
member = archive.ZipExtractByName(raw.data, compress.BufLen(raw), key, zok)
end
mut a := NpyArray {}
if zok: a = ReadNpy(member.data, compress.BufLen(member), ok) end
compress.BufFree(member)
compress.BufFree(raw)
ret a
end
@en "NpzWrite"
@fa "نوشتن ان‌پی‌زد"
pub func NpzWrite(path: str, keys &: Vector<str>, arrays &: Vector<NpyArray>): bool:
if keys.len() != arrays.len() or keys.len() == 0: ret false end
mut bufs := Vector {} as Vector<compress.ByteBuf>
mut inputs := Vector {} as Vector<archive.ZipFileInput>
repeat keys.len() in i:
mut a := arrays.get(i)
b := WriteNpy(a)
mut fi := archive.ZipFileInput {}
fi.name = keys.get(i) + ".npy"
fi.data_ptr = b.data
fi.data_len = compress.BufLen(b)
fi.method = 0
inputs.push(fi)
bufs.push(b)
end
ok := archive.ZipCreateFile(inputs, path)
repeat bufs.len() in i:
mut b := bufs.get(i)
compress.BufFree(b)
end
repeat inputs.len() in i: mem.Free(inputs.get(i).name as void*) end
bufs.free()
inputs.free()
ret ok
end
@en "onnx"
@fa "اونیکس"
package onnx
import archive
import compress
import mem
import str
import tensor
@en "Attr"
@fa "ویژگی"
pub struct Attr:
pub name: str = ""
pub kind: int = 0
pub f: f64 = 0.0
pub i: i64 = 0
pub s: str = ""
pub t: tensor.Tensor = tensor.Tensor {}
pub floats: Vector<f64> = Vector {}
pub ints: Vector<i64> = Vector {}
@en "free"
@fa "آزادسازی"
pub func free():
this.t.free()
this.floats.free()
this.ints.free()
_free_wire_str(this.name)
_free_wire_str(this.s)
end
end
@en "Node"
@fa "گره"
pub struct Node:
pub op: str = ""
pub name: str = ""
pub inputs: Vector<str> = Vector {}
pub outputs: Vector<str> = Vector {}
pub attrs: Vector<Attr> = Vector {}
@en "attr_index"
@fa "نمایه ویژگی"
pub func attr_index(name: str): int:
repeat this.attrs.len() in i:
a := this.attrs.get(i)
if str.Equals(a.name, name): ret i end
end
ret 0 - 1
end
@en "attr_int"
@fa "ویژگی صحیح"
pub func attr_int(name: str, dflt: i64): i64:
k := this.attr_index(name)
if k < 0: ret dflt end
ret this.attrs.get(k).i
end
@en "attr_float"
@fa "ویژگی اعشاری"
pub func attr_float(name: str, dflt: f64): f64:
k := this.attr_index(name)
if k < 0: ret dflt end
ret this.attrs.get(k).f
end
@en "free"
@fa "آزادسازی"
pub func free():
_free_wire_strs(this.inputs)
_free_wire_strs(this.outputs)
_free_wire_str(this.op)
_free_wire_str(this.name)
repeat this.attrs.len() in i:
mut a := this.attrs.get(i)
a.free()
end
this.attrs.free()
end
end
@en "Model"
@fa "مدل"
pub struct Model:
pub inputs: Vector<str> = Vector {}
pub outputs: Vector<str> = Vector {}
pub nodes: Vector<Node> = Vector {}
pub init_names: Vector<str> = Vector {}
pub inits: Vector<tensor.Tensor> = Vector {}
pub ir_version: i64 = 0
pub error: str = ""
pub ok: bool = false
@en "feed_names"
@fa "نام ورودی‌ها"
pub func feed_names(): Vector<str>:
mut out := Vector {} as Vector<str>
repeat this.inputs.len() in i:
nm := this.inputs.get(i)
mut is_init := false
repeat this.init_names.len() in j:
if str.Equals(this.init_names.get(j), nm): is_init = true end
end
if is_init == false: out.push(nm) end
end
ret out
end
@en "free"
@fa "آزادسازی"
pub func free():
_free_wire_str(this.error)
_free_wire_strs(this.inputs)
_free_wire_strs(this.outputs)
repeat this.nodes.len() in i:
mut n := this.nodes.get(i)
n.free()
end
this.nodes.free()
_free_wire_strs(this.init_names)
repeat this.inits.len() in i:
mut t := this.inits.get(i)
t.free()
end
this.inits.free()
end
end
func _free_wire_str(s: str):
if str.Len(s) > 0: mem.Free(s as void*) end
end
func _free_wire_strs(v &: Vector<str>):
repeat v.len() in i: _free_wire_str(v.get(i)) end
v.free()
end
@en "ParseOnnx"
@fa "تجزیه اونیکس"
pub func ParseOnnx(p: void*, n: int, ok &: bool): Model:
mut m := Model {}
ok = _decode_model(p, n, m)
m.ok = ok
ret m
end
@en "LoadOnnx"
@fa "بارگذاری اونیکس"
pub func LoadOnnx(path: str, ok &: bool): Model:
ok = false
mut fok := false
mut raw := archive.ReadBinaryFile(path, fok)
if fok == false:
compress.BufFree(raw)
mut m := Model {}
m.error = "cannot read " + path
ret m
end
m := ParseOnnx(raw.data, compress.BufLen(raw), ok)
compress.BufFree(raw)
ret m
end
@en "Run"
@fa "اجرا"
pub func Run(model &: Model, inputs &: Vector<tensor.Tensor>, ok &: bool): Vector<tensor.Tensor>:
ret _run_graph(model, inputs, ok)
end
package onnx
import str
import tensor
func _norm_axis(axis: i64, rank: int): int:
mut a := axis as int
if a < 0: a = a + rank end
ret a
end
func _in(model &: Model, node &: Node, env &: _Env, k: int, out &: tensor.Tensor): bool:
if k >= node.inputs.len() or str.Len(node.inputs.get(k)) == 0:
model.error = node.op + ": missing input " + k
ret false
end
if _env_get(env, node.inputs.get(k), out) == false:
model.error = node.op + ": unbound input " + node.inputs.get(k)
ret false
end
ret true
end
func _emit(node &: Node, env &: _Env, k: int, t: tensor.Tensor):
if k < node.outputs.len(): _env_put(env, node.outputs.get(k), t, true) end
end
func _axes_of(model &: Model, node &: Node, env &: _Env, out &: Vector<int>): bool:
k := node.attr_index("axes")
if k >= 0:
a := node.attrs.get(k)
repeat a.ints.len() in i: out.push(a.ints.get(i) as int) end
ret true
end
mut t := tensor.Empty()
if _in(model, node, env, 1, t) == false: ret false end
repeat t.numel() in i: out.push(t.at(i) as int) end
ret true
end
func _unary(model &: Model, node &: Node, env &: _Env): bool:
mut x := tensor.Empty()
if _in(model, node, env, 0, x) == false: ret false end
mut y := tensor.Empty()
if str.Equals(node.op, "Relu"): y = tensor.Relu(x)
else str.Equals(node.op, "Sigmoid"): y = tensor.Sigmoid(x)
else str.Equals(node.op, "Tanh"): y = tensor.Tanh(x)
else str.Equals(node.op, "Exp"): y = tensor.Exp(x)
else str.Equals(node.op, "Log"): y = tensor.Log(x)
else str.Equals(node.op, "Sqrt"): y = tensor.Sqrt(x)
else str.Equals(node.op, "Neg"): y = tensor.Neg(x)
else str.Equals(node.op, "Softmax"): y = tensor.Softmax(x)
else str.Equals(node.op, "LogSoftmax"): y = tensor.LogSoftmax(x)
else str.Equals(node.op, "LeakyRelu"):
alpha := node.attr_float("alpha", 0.01)
y = tensor.Clone(x)
p := y.data.data
a := alpha as f32
zero := 0.0 as f32
repeat y.numel() in k:
if p[k] < zero: p[k] = p[k] * a end
end
else:
y = tensor.Clone(x)
end
if str.Equals(node.op, "Softmax") or str.Equals(node.op, "LogSoftmax"):
ax := _norm_axis(node.attr_int("axis", 0 - 1), x.rank())
if ax != x.rank() - 1:
model.error = node.op + ": only the last axis is supported"
y.free()
ret false
end
end
_emit(node, env, 0, y)
ret true
end
func _binary(model &: Model, node &: Node, env &: _Env): bool:
mut a := tensor.Empty()
mut b := tensor.Empty()
if _in(model, node, env, 0, a) == false or _in(model, node, env, 1, b) == false: ret false end
mut y := tensor.Empty()
if str.Equals(node.op, "Add"): y = tensor.Add(a, b)
else str.Equals(node.op, "Sub"): y = tensor.Sub(a, b)
else str.Equals(node.op, "Mul"): y = tensor.Mul(a, b)
else:
y = tensor.Div(a, b)
end
if y.is_empty():
model.error = node.op + ": shapes " + tensor.ShapeString(a) + " and " + tensor.ShapeString(b) + " do not broadcast"
ret false
end
_emit(node, env, 0, y)
ret true
end
func _clip(model &: Model, node &: Node, env &: _Env): bool:
mut x := tensor.Empty()
if _in(model, node, env, 0, x) == false: ret false end
mut lo := node.attr_float("min", 0.0 - 3.0e38)
mut hi := node.attr_float("max", 3.0e38)
if node.inputs.len() > 1 and str.Len(node.inputs.get(1)) > 0:
mut t := tensor.Empty()
if _in(model, node, env, 1, t) == false: ret false end
lo = t.at(0)
end
if node.inputs.len() > 2 and str.Len(node.inputs.get(2)) > 0:
mut t := tensor.Empty()
if _in(model, node, env, 2, t) == false: ret false end
hi = t.at(0)
end
_emit(node, env, 0, tensor.Clip(x, lo, hi))
ret true
end
func _matmul(model &: Model, node &: Node, env &: _Env): bool:
mut a := tensor.Empty()
mut b := tensor.Empty()
if _in(model, node, env, 0, a) == false or _in(model, node, env, 1, b) == false: ret false end
mut y := tensor.Empty()
if a.rank() == 3 and b.rank() == 3:
y = tensor.BatchMatMul(a, b)
else:
y = tensor.MatMul(a, b)
end
if y.is_empty():
model.error = "MatMul: shapes " + tensor.ShapeString(a) + " x " + tensor.ShapeString(b)
ret false
end
_emit(node, env, 0, y)
ret true
end
func _gemm(model &: Model, node &: Node, env &: _Env): bool:
mut a := tensor.Empty()
mut b := tensor.Empty()
if _in(model, node, env, 0, a) == false or _in(model, node, env, 1, b) == false: ret false end
alpha := node.attr_float("alpha", 1.0)
beta := node.attr_float("beta", 1.0)
ta := node.attr_int("transA", 0) != 0
tb := node.attr_int("transB", 0) != 0
mut aa := tensor.Empty()
mut bb := tensor.Empty()
if ta: aa = tensor.Transpose2D(a) else:
aa = tensor.Clone(a)
end
if tb: bb = tensor.Transpose2D(b) else:
bb = tensor.Clone(b)
end
mut y := tensor.MatMul(aa, bb)
aa.free()
bb.free()
if y.is_empty():
model.error = "Gemm: shapes " + tensor.ShapeString(a) + " x " + tensor.ShapeString(b)
ret false
end
if alpha != 1.0: tensor.ScaleInPlace(y, alpha) end
if node.inputs.len() > 2 and str.Len(node.inputs.get(2)) > 0:
mut c := tensor.Empty()
if _in(model, node, env, 2, c) == false:
y.free()
ret false
end
mut cs := tensor.Scale(c, beta)
mut z := tensor.Add(y, cs)
cs.free()
y.free()
if z.is_empty():
model.error = str.Clone("Gemm: C does not broadcast")
ret false
end
y = z
end
_emit(node, env, 0, y)
ret true
end
func _window(node &: Node, kh &: int, kw &: int, sh &: int, sw &: int, ph &: int, pw &: int, msg &: str): bool:
sh = 1
sw = 1
ks := node.attr_index("strides")
if ks >= 0:
s := node.attrs.get(ks)
if s.ints.len() >= 2:
sh = s.ints.get(0) as int
sw = s.ints.get(1) as int
end
end
ph = 0
pw = 0
kp := node.attr_index("pads")
if kp >= 0:
p := node.attrs.get(kp)
if p.ints.len() >= 4:
if p.ints.get(0) != p.ints.get(2) or p.ints.get(1) != p.ints.get(3):
msg = node.op + ": asymmetric pads are not supported"
ret false
end
ph = p.ints.get(0) as int
pw = p.ints.get(1) as int
end
end
kk := node.attr_index("kernel_shape")
if kk >= 0:
k := node.attrs.get(kk)
if k.ints.len() >= 2:
kh = k.ints.get(0) as int
kw = k.ints.get(1) as int
end
end
kd := node.attr_index("dilations")
if kd >= 0:
d := node.attrs.get(kd)
repeat d.ints.len() in i:
if d.ints.get(i) != 1:
msg = node.op + ": dilations are not supported"
ret false
end
end
end
if node.attr_int("group", 1) != 1:
msg = node.op + ": grouped convolution is not supported"
ret false
end
ret true
end
func _conv(model &: Model, node &: Node, env &: _Env): bool:
mut x := tensor.Empty()
mut w := tensor.Empty()
if _in(model, node, env, 0, x) == false or _in(model, node, env, 1, w) == false: ret false end
if x.rank() != 4 or w.rank() != 4:
model.error = str.Clone("Conv: only 2D convolution is supported")
ret false
end
mut kh := w.shape.get(2)
mut kw := w.shape.get(3)
mut sh := 1
mut sw := 1
mut ph := 0
mut pw := 0
mut msg := ""
if _window(node, kh, kw, sh, sw, ph, pw, msg) == false:
model.error = msg
ret false
end
mut bias := tensor.Empty()
if node.inputs.len() > 2 and str.Len(node.inputs.get(2)) > 0:
if _in(model, node, env, 2, bias) == false: ret false end
end
mut y := tensor.Conv2DForward(x, w, bias, sh, sw, ph, pw)
if y.is_empty():
model.error = "Conv: shapes " + tensor.ShapeString(x) + " and " + tensor.ShapeString(w)
ret false
end
_emit(node, env, 0, y)
ret true
end
func _pool(model &: Model, node &: Node, env &: _Env): bool:
mut x := tensor.Empty()
if _in(model, node, env, 0, x) == false: ret false end
if x.rank() != 4:
model.error = node.op + ": only 2D pooling is supported"
ret false
end
mut kh := 1
mut kw := 1
mut sh := 1
mut sw := 1
mut ph := 0
mut pw := 0
mut msg := ""
if _window(node, kh, kw, sh, sw, ph, pw, msg) == false:
model.error = msg
ret false
end
if ph != 0 or pw != 0:
model.error = node.op + ": padded pooling is not supported"
ret false
end
mut y := tensor.Empty()
if str.Equals(node.op, "MaxPool"):
mut am := tensor.Empty()
y = tensor.MaxPool2DForward(x, kh, kw, sh, sw, am)
am.free()
else:
y = tensor.AvgPool2DForward(x, kh, kw, sh, sw)
end
if y.is_empty():
model.error = node.op + ": bad window for " + tensor.ShapeString(x)
ret false
end
_emit(node, env, 0, y)
ret true
end
func _global_avg(model &: Model, node &: Node, env &: _Env): bool:
mut x := tensor.Empty()
if _in(model, node, env, 0, x) == false: ret false end
if x.rank() != 4:
model.error = str.Clone("GlobalAveragePool: rank 4 input required")
ret false
end
mut m1 := tensor.MeanAxis(x, 3, true)
y := tensor.MeanAxis(m1, 2, true)
m1.free()
_emit(node, env, 0, y)
ret true
end
func _batchnorm(model &: Model, node &: Node, env &: _Env): bool:
mut x := tensor.Empty()
mut scale := tensor.Empty()
mut bias := tensor.Empty()
mut mean := tensor.Empty()
mut vr := tensor.Empty()
if _in(model, node, env, 0, x) == false or _in(model, node, env, 1, scale) == false: ret false end
if _in(model, node, env, 2, bias) == false or _in(model, node, env, 3, mean) == false: ret false end
if _in(model, node, env, 4, vr) == false: ret false end
if x.rank() < 2:
model.error = str.Clone("BatchNormalization: rank 2 or more required")
ret false
end
eps := node.attr_float("epsilon", 0.00001)
c := x.shape.get(1)
if scale.numel() != c or bias.numel() != c or mean.numel() != c or vr.numel() != c:
model.error = "BatchNormalization: per-channel parameters must have " + c + " entries"
ret false
end
y := tensor.Clone(x)
n := x.shape.get(0)
inner := x.numel() / (n * c)
p := y.data.data
repeat c in ch:
g := (scale.at(ch) / _sqrt64(vr.at(ch) + eps)) as f32
b := (bias.at(ch) - mean.at(ch) * (g as f64)) as f32
repeat n in i:
base := (i * c + ch) * inner
repeat inner in k: p[base + k] = p[base + k] * g + b end
end
end
_emit(node, env, 0, y)
ret true
end
func _reshape(model &: Model, node &: Node, env &: _Env): bool:
mut x := tensor.Empty()
mut sh := tensor.Empty()
if _in(model, node, env, 0, x) == false or _in(model, node, env, 1, sh) == false: ret false end
mut dims := Vector {} as Vector<int>
mut infer := 0 - 1
mut known := 1
repeat sh.numel() in i:
mut d := sh.at(i) as int
if d == 0 and i < x.rank(): d = x.shape.get(i) end
if d == 0 - 1:
infer = i
dims.push(1)
else:
dims.push(d)
known = known * d
end
end
if infer >= 0 and known > 0: dims.set(infer, x.numel() / known) end
mut y := tensor.Reshape(x, dims)
dims.free()
if y.is_empty():
model.error = str.Clone("Reshape: element count mismatch")
ret false
end
_emit(node, env, 0, y)
ret true
end
func _flatten(model &: Model, node &: Node, env &: _Env): bool:
mut x := tensor.Empty()
if _in(model, node, env, 0, x) == false: ret false end
ax := _norm_axis(node.attr_int("axis", 1), x.rank())
mut outer := 1
repeat ax in i: outer = outer * x.shape.get(i) end
mut dims := tensor.Shape2(outer, x.numel() / outer)
y := tensor.Reshape(x, dims)
dims.free()
_emit(node, env, 0, y)
ret true
end
func _transpose(model &: Model, node &: Node, env &: _Env): bool:
mut x := tensor.Empty()
if _in(model, node, env, 0, x) == false: ret false end
mut perm := Vector {} as Vector<int>
k := node.attr_index("perm")
if k >= 0:
a := node.attrs.get(k)
repeat a.ints.len() in i: perm.push(a.ints.get(i) as int) end
else:
repeat x.rank() in i: perm.push(x.rank() - 1 - i) end
end
mut y := tensor.Permute(x, perm)
perm.free()
if y.is_empty():
model.error = str.Clone("Transpose: bad perm")
ret false
end
_emit(node, env, 0, y)
ret true
end
func _squeeze(model &: Model, node &: Node, env &: _Env, insert: bool): bool:
mut x := tensor.Empty()
if _in(model, node, env, 0, x) == false: ret false end
mut axes := Vector {} as Vector<int>
if _axes_of(model, node, env, axes) == false:
if insert:
axes.free()
ret false
end
model.error = str.Clone("")
end
mut y := tensor.Clone(x)
if insert:
mut i := 0
until i < axes.len():
mut best := i
mut j := i + 1
until j < axes.len():
if axes.get(j) < axes.get(best): best = j end
j += 1
end
t := axes.get(i)
axes.set(i, axes.get(best))
axes.set(best, t)
i += 1
end
repeat axes.len() in t:
tensor.UnsqueezeInPlace(y, _norm_axis(axes.get(t) as i64, y.rank() + 1))
end
else axes.len() == 0:
tensor.SqueezeInPlace(y)
else:
mut keep := Vector {} as Vector<int>
repeat x.rank() in d:
mut drop := false
repeat axes.len() in t:
if _norm_axis(axes.get(t) as i64, x.rank()) == d and x.shape.get(d) == 1: drop = true end
end
if drop == false: keep.push(x.shape.get(d)) end
end
if keep.len() == 0: keep.push(1) end
y.reshape_(keep)
keep.free()
end
axes.free()
_emit(node, env, 0, y)
ret true
end
func _concat(model &: Model, node &: Node, env &: _Env): bool:
if node.inputs.len() == 0:
model.error = str.Clone("Concat: no inputs")
ret false
end
mut first := tensor.Empty()
if _in(model, node, env, 0, first) == false: ret false end
ax := _norm_axis(node.attr_int("axis", 0), first.rank())
mut acc := tensor.Clone(first)
mut i := 1
until i < node.inputs.len():
mut nxt := tensor.Empty()
if _in(model, node, env, i, nxt) == false:
acc.free()
ret false
end
mut joined := tensor.Concat2(acc, nxt, ax)
acc.free()
if joined.is_empty():
model.error = "Concat: shapes disagree off axis " + ax
ret false
end
acc = joined
i += 1
end
_emit(node, env, 0, acc)
ret true
end
func _constant(model &: Model, node &: Node, env &: _Env): bool:
k := node.attr_index("value")
if k < 0:
model.error = str.Clone("Constant: only the tensor form is supported")
ret false
end
a := node.attrs.get(k)
_emit(node, env, 0, tensor.Clone(a.t))
ret true
end
func _sqrt64(v: f64): f64:
if v <= 0.0: ret 0.0 end
mut r := v
if r > 1.0: r = v / 2.0 end
repeat 40: r = 0.5 * (r + v / r) end
ret r
end
func _exec_node(model &: Model, node: Node, env &: _Env): bool:
op := node.op
if str.Equals(op, "Relu") or str.Equals(op, "Sigmoid") or str.Equals(op, "Tanh") or str.Equals(op, "Exp") or str.Equals(op, "Log") or str.Equals(op, "Sqrt") or str.Equals(op, "Neg") or str.Equals(op, "Softmax") or str.Equals(op, "LogSoftmax") or str.Equals(op, "LeakyRelu") or str.Equals(op, "Identity") or str.Equals(op, "Dropout"):
ret _unary(model, node, env)
end
if str.Equals(op, "Add") or str.Equals(op, "Sub") or str.Equals(op, "Mul") or str.Equals(op, "Div"): ret _binary(model, node, env) end
if str.Equals(op, "Clip"): ret _clip(model, node, env) end
if str.Equals(op, "MatMul"): ret _matmul(model, node, env) end
if str.Equals(op, "Gemm"): ret _gemm(model, node, env) end
if str.Equals(op, "Conv"): ret _conv(model, node, env) end
if str.Equals(op, "MaxPool") or str.Equals(op, "AveragePool"): ret _pool(model, node, env) end
if str.Equals(op, "GlobalAveragePool"): ret _global_avg(model, node, env) end
if str.Equals(op, "BatchNormalization"): ret _batchnorm(model, node, env) end
if str.Equals(op, "Reshape"): ret _reshape(model, node, env) end
if str.Equals(op, "Flatten"): ret _flatten(model, node, env) end
if str.Equals(op, "Transpose"): ret _transpose(model, node, env) end
if str.Equals(op, "Squeeze"): ret _squeeze(model, node, env, false) end
if str.Equals(op, "Unsqueeze"): ret _squeeze(model, node, env, true) end
if str.Equals(op, "Concat"): ret _concat(model, node, env) end
if str.Equals(op, "Constant"): ret _constant(model, node, env) end
if _exec_node2(model, node, env): ret true end
if str.Len(model.error) > 0: ret false end
model.error = "unsupported op: " + op
ret false
end
package onnx
import math
import str
import tensor
func _erf(x: f64): f64:
mut sign := 1.0
mut v := x
if v < 0.0:
sign = 0.0 - 1.0
v = 0.0 - v
end
t := 1.0 / (1.0 + 0.3275911 * v)
y := 1.0 - (((((1.061405429 * t - 1.453152027) * t) + 1.421413741) * t - 0.284496736) * t + 0.254829592) * t * math.Exp(0.0 - v * v)
ret sign * y
end
func _map_op(x &: tensor.Tensor, op: str, a1: f64, a2: f64): tensor.Tensor:
out := tensor.Clone(x)
p := out.data.data
repeat out.numel() in k:
v := p[k] as f64
mut r := v
if str.Equals(op, "Erf"): r = _erf(v)
else str.Equals(op, "Softplus"): r = math.Log(1.0 + math.Exp(v))
else str.Equals(op, "Elu"): r = v > 0.0 ? v : a1 * (math.Exp(v) - 1.0)
else str.Equals(op, "Selu"): r = a2 * (v > 0.0 ? v : a1 * (math.Exp(v) - 1.0))
else str.Equals(op, "HardSigmoid"): r = math.ClampF(a1 * v + a2, 0.0, 1.0)
else str.Equals(op, "Floor"): r = math.Floor(v)
else str.Equals(op, "Ceil"): r = math.Ceil(v)
else str.Equals(op, "Round"): r = math.Round(v)
else str.Equals(op, "Reciprocal"): r = v == 0.0 ? 0.0 : 1.0 / v
else str.Equals(op, "Sign"): r = math.Sign(v)
else:
r = v
end
p[k] = r as f32
end
ret out
end
func _unary2(model &: Model, node &: Node, env &: _Env): bool:
mut x := tensor.Empty()
if _in(model, node, env, 0, x) == false: ret false end
op := node.op
mut y := tensor.Empty()
if str.Equals(op, "Abs"):
y = tensor.Abs(x)
else str.Equals(op, "Gelu"):
y = tensor.Gelu(x)
else str.Equals(op, "Cast"):
target := node.attr_int("to", 1)
if target == 6 or target == 7 or target == 5 or target == 12 or target == 13:
y = _map_op(x, "Floor", 0.0, 0.0)
else:
y = tensor.Clone(x)
end
else str.Equals(op, "Elu"):
y = _map_op(x, op, node.attr_float("alpha", 1.0), 0.0)
else str.Equals(op, "Selu"):
y = _map_op(x, op, node.attr_float("alpha", 1.6732632), node.attr_float("gamma", 1.0507009))
else str.Equals(op, "HardSigmoid"):
y = _map_op(x, op, node.attr_float("alpha", 0.2), node.attr_float("beta", 0.5))
else:
y = _map_op(x, op, 0.0, 0.0)
end
_emit(node, env, 0, y)
ret true
end
func _pow(model &: Model, node &: Node, env &: _Env): bool:
mut a := tensor.Empty()
mut b := tensor.Empty()
if _in(model, node, env, 0, a) == false or _in(model, node, env, 1, b) == false: ret false end
