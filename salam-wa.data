0xca, 0x82, 0xc9, 0x7d, 0xfa, 0x59, 0x47, 0xf0, 0xad, 0xd4, 0xa2, 0xaf, 0x9c, 0xa4, 0x72, 0xc0
0xb7, 0xfd, 0x93, 0x26, 0x36, 0x3f, 0xf7, 0xcc, 0x34, 0xa5, 0xe5, 0xf1, 0x71, 0xd8, 0x31, 0x15
0x04, 0xc7, 0x23, 0xc3, 0x18, 0x96, 0x05, 0x9a, 0x07, 0x12, 0x80, 0xe2, 0xeb, 0x27, 0xb2, 0x75
0x09, 0x83, 0x2c, 0x1a, 0x1b, 0x6e, 0x5a, 0xa0, 0x52, 0x3b, 0xd6, 0xb3, 0x29, 0xe3, 0x2f, 0x84
0x53, 0xd1, 0x00, 0xed, 0x20, 0xfc, 0xb1, 0x5b, 0x6a, 0xcb, 0xbe, 0x39, 0x4a, 0x4c, 0x58, 0xcf
0xd0, 0xef, 0xaa, 0xfb, 0x43, 0x4d, 0x33, 0x85, 0x45, 0xf9, 0x02, 0x7f, 0x50, 0x3c, 0x9f, 0xa8
0x51, 0xa3, 0x40, 0x8f, 0x92, 0x9d, 0x38, 0xf5, 0xbc, 0xb6, 0xda, 0x21, 0x10, 0xff, 0xf3, 0xd2
0xcd, 0x0c, 0x13, 0xec, 0x5f, 0x97, 0x44, 0x17, 0xc4, 0xa7, 0x7e, 0x3d, 0x64, 0x5d, 0x19, 0x73
0x60, 0x81, 0x4f, 0xdc, 0x22, 0x2a, 0x90, 0x88, 0x46, 0xee, 0xb8, 0x14, 0xde, 0x5e, 0x0b, 0xdb
0xe0, 0x32, 0x3a, 0x0a, 0x49, 0x06, 0x24, 0x5c, 0xc2, 0xd3, 0xac, 0x62, 0x91, 0x95, 0xe4, 0x79
0xe7, 0xc8, 0x37, 0x6d, 0x8d, 0xd5, 0x4e, 0xa9, 0x6c, 0x56, 0xf4, 0xea, 0x65, 0x7a, 0xae, 0x08
0xba, 0x78, 0x25, 0x2e, 0x1c, 0xa6, 0xb4, 0xc6, 0xe8, 0xdd, 0x74, 0x1f, 0x4b, 0xbd, 0x8b, 0x8a
0x70, 0x3e, 0xb5, 0x66, 0x48, 0x03, 0xf6, 0x0e, 0x61, 0x35, 0x57, 0xb9, 0x86, 0xc1, 0x1d, 0x9e
0xe1, 0xf8, 0x98, 0x11, 0x69, 0xd9, 0x8e, 0x94, 0x9b, 0x1e, 0x87, 0xe9, 0xce, 0x55, 0x28, 0xdf
0x8c, 0xa1, 0x89, 0x0d, 0xbf, 0xe6, 0x42, 0x68, 0x41, 0x99, 0x2d, 0x0f, 0xb0, 0x54, 0xbb, 0x16
]
const SSH_AES_RCON := [0x01, 0x02, 0x04, 0x08, 0x10, 0x20, 0x40, 0x80, 0x1b, 0x36]
struct Aes:
pub rk: u32[60] = [
0 as u32, 0 as u32, 0 as u32, 0 as u32
0 as u32, 0 as u32, 0 as u32, 0 as u32
0 as u32, 0 as u32, 0 as u32, 0 as u32
0 as u32, 0 as u32, 0 as u32, 0 as u32
0 as u32, 0 as u32, 0 as u32, 0 as u32
0 as u32, 0 as u32, 0 as u32, 0 as u32
0 as u32, 0 as u32, 0 as u32, 0 as u32
0 as u32, 0 as u32, 0 as u32, 0 as u32
0 as u32, 0 as u32, 0 as u32, 0 as u32
0 as u32, 0 as u32, 0 as u32, 0 as u32
0 as u32, 0 as u32, 0 as u32, 0 as u32
0 as u32, 0 as u32, 0 as u32, 0 as u32
0 as u32, 0 as u32, 0 as u32, 0 as u32
0 as u32, 0 as u32, 0 as u32, 0 as u32
0 as u32, 0 as u32, 0 as u32, 0 as u32
]
pub nr: int = 0
end
func _aes_subword(w: u32): u32:
b0 := SSH_AES_SBOX[((w >> (24 as u32)) & (0xFF as u32)) as int] as u32
b1 := SSH_AES_SBOX[((w >> (16 as u32)) & (0xFF as u32)) as int] as u32
b2 := SSH_AES_SBOX[((w >> (8 as u32)) & (0xFF as u32)) as int] as u32
b3 := SSH_AES_SBOX[(w & (0xFF as u32)) as int] as u32
ret (b0 << (24 as u32)) | (b1 << (16 as u32)) | (b2 << (8 as u32)) | b3
end
func _aes_rotword(w: u32): u32:
ret (w << (8 as u32)) | (w >> (24 as u32))
end
func _aes_init(key: void*, keylen: int): Aes:
mut a := Aes {}
mut nk := 0
if keylen == 16:
nk = 4
a.nr = 10
else keylen == 32:
nk = 8
a.nr = 14
else:
a.nr = 0
ret a
end
total := 4 * (a.nr + 1)
repeat nk in i:
o := i * 4
a.rk[i] = ((_bget(key, o) as u32) << (24 as u32)) | ((_bget(key, o + 1) as u32) << (16 as u32)) | ((_bget(key, o + 2) as u32) << (8 as u32)) | (_bget(key, o + 3) as u32)
end
mut i := nk
until i < total:
mut t := a.rk[i - 1]
if i % nk == 0:
t = _aes_subword(_aes_rotword(t)) ^ ((SSH_AES_RCON[i / nk - 1] as u32) << (24 as u32))
else nk > 6 and i % nk == 4:
t = _aes_subword(t)
end
a.rk[i] = a.rk[i - nk] ^ t
i += 1
end
ret a
end
inline func _xtime(a: int): int:
r := a << 1
ret (r ^ (((r >> 8) & 1) * 0x1b)) & 0xFF
end
func _aes_encrypt_block(a: Aes, inp: void*, out: void*):
mut s: int[16]
repeat 16 in i:
s[i] = _bget(inp, i)
end
repeat 4 in c:
k := a.rk[c]
s[c * 4] = s[c * 4] ^ (((k >> (24 as u32)) & (0xFF as u32)) as int)
s[c * 4 + 1] = s[c * 4 + 1] ^ (((k >> (16 as u32)) & (0xFF as u32)) as int)
s[c * 4 + 2] = s[c * 4 + 2] ^ (((k >> (8 as u32)) & (0xFF as u32)) as int)
s[c * 4 + 3] = s[c * 4 + 3] ^ ((k & (0xFF as u32)) as int)
end
mut round := 1
until round < a.nr + 1:
repeat 16 in i:
s[i] = SSH_AES_SBOX[s[i]]
end
mut t: int[16]
repeat 4 in c:
repeat 4 in r:
t[c * 4 + r] = s[(((c + r) % 4) * 4) + r]
end
end
repeat 16 in i:
s[i] = t[i]
end
if round < a.nr:
repeat 4 in c:
o := c * 4
a0 := s[o]
a1 := s[o + 1]
a2 := s[o + 2]
a3 := s[o + 3]
x := a0 ^ a1 ^ a2 ^ a3
s[o] = a0 ^ x ^ _xtime(a0 ^ a1)
s[o + 1] = a1 ^ x ^ _xtime(a1 ^ a2)
s[o + 2] = a2 ^ x ^ _xtime(a2 ^ a3)
s[o + 3] = a3 ^ x ^ _xtime(a3 ^ a0)
end
end
repeat 4 in c:
k := a.rk[round * 4 + c]
s[c * 4] = s[c * 4] ^ (((k >> (24 as u32)) & (0xFF as u32)) as int)
s[c * 4 + 1] = s[c * 4 + 1] ^ (((k >> (16 as u32)) & (0xFF as u32)) as int)
s[c * 4 + 2] = s[c * 4 + 2] ^ (((k >> (8 as u32)) & (0xFF as u32)) as int)
s[c * 4 + 3] = s[c * 4 + 3] ^ ((k & (0xFF as u32)) as int)
end
round += 1
end
repeat 16 in i:
_bput(out, i, s[i])
end
end
func _ctr_increment(block &: Buf):
mut i := 15
mut carry := true
until i >= 0 and carry:
v := (_bget(block.p, i) + 1) & 0xFF
_bput(block.p, i, v)
carry = v == 0
i -= 1
end
end
func _aes_ctr_xor(a: Aes, counter &: Buf, data: void*, n: int, out: void*):
mut ks := NewBuf(16)
BufPutZeros(ks, 16)
mut done := 0
until done < n:
_aes_encrypt_block(a, counter.p, ks.p)
take := n - done < 16 ? n - done : 16
repeat take in i:
_bput(out, done + i, _bget(data, done + i) ^ _bget(ks.p, i))
end
_ctr_increment(counter)
done += take
end
WipeBuf(ks)
end
package ssh
import str
const KEX_ALGORITHMS := "curve25519-sha256,curve25519-sha256@libssh.org,diffie-hellman-group14-sha256,diffie-hellman-group14-sha1"
const HOSTKEY_ALGORITHMS := "rsa-sha2-256,rsa-sha2-512,ssh-rsa"
const CIPHER_ALGORITHMS := "aes128-ctr,aes256-ctr"
const MAC_ALGORITHMS := "hmac-sha2-256,hmac-sha1"
const COMPRESSION_ALGORITHMS := "none"
const KEX_CURVE25519 := "curve25519-sha256"
const KEX_CURVE25519_LIBSSH := "curve25519-sha256@libssh.org"
const KEX_DH14_SHA256 := "diffie-hellman-group14-sha256"
const KEX_DH14_SHA1 := "diffie-hellman-group14-sha1"
const HOSTKEY_SSH_RSA := "ssh-rsa"
const HOSTKEY_RSA_SHA256 := "rsa-sha2-256"
const HOSTKEY_RSA_SHA512 := "rsa-sha2-512"
const CIPHER_AES128_CTR := "aes128-ctr"
const CIPHER_AES256_CTR := "aes256-ctr"
const MAC_HMAC_SHA256 := "hmac-sha2-256"
const MAC_HMAC_SHA1 := "hmac-sha1"
func _cipher_key_len(name: str): int:
if str.Equals(name, CIPHER_AES256_CTR):
ret 32
end
ret 16
end
func _cipher_iv_len(_name: str): int:
ret 16
end
func _mac_kind_for(name: str): int:
if str.Equals(name, MAC_HMAC_SHA256):
ret MAC_SHA256
end
ret MAC_SHA1
end
func _mac_key_len(name: str): int:
ret _mac_size(_mac_kind_for(name))
end
func _kex_uses_sha256(name: str): bool:
ret not str.EndsWith(name, "sha1")
end
func _kex_is_curve25519(name: str): bool:
ret str.Equals(name, KEX_CURVE25519) or str.Equals(name, KEX_CURVE25519_LIBSSH)
end
package ssh
const _AUTH_SERVICE := "ssh-connection"
func _auth_request_service(t &: Transport): bool:
mut req := NewBuf(32)
BufPutByte(req, SSH_MSG_SERVICE_REQUEST)
BufPutStringStr(req, "ssh-userauth")
if not _packet_send(t.ps, req):
FreeBuf(req)
ret false
end
FreeBuf(req)
reply := _packet_recv(t.ps)
if reply.bad:
ret false
end
mut r := ReaderFromBuf(reply)
msgtype := RGetByte(r)
mut ok := false
if not r.bad:
if msgtype == SSH_MSG_SERVICE_ACCEPT:
ok = true
end
end
FreeBuf(reply)
ret ok
end
func _auth_send_and_await(t &: Transport, req: Buf): bool:
if not _packet_send(t.ps, req):
ret false
end
mut attempts := 0
until attempts < 5:
reply := _packet_recv(t.ps)
if reply.bad:
ret false
end
mut r := ReaderFromBuf(reply)
msgtype := RGetByte(r)
if msgtype == SSH_MSG_USERAUTH_SUCCESS:
FreeBuf(reply)
ret true
end
if msgtype == SSH_MSG_USERAUTH_BANNER:
FreeBuf(reply)
attempts += 1
continue
end
FreeBuf(reply)
ret false
end
ret false
end
@en "AuthPassword"
@fa "احراز هویت با رمز"
func _auth_password(t &: Transport, user: str, password: str): bool:
mut req := NewBuf(64 + user.len() + password.len())
BufPutByte(req, SSH_MSG_USERAUTH_REQUEST)
BufPutStringStr(req, user)
BufPutStringStr(req, _AUTH_SERVICE)
BufPutStringStr(req, "password")
BufPutBool(req, false)
BufPutStringStr(req, password)
ok := _auth_send_and_await(t, req)
FreeBuf(req)
ret ok
end
func _auth_pubkey_blob(id: Identity): Buf:
mut blob := NewBuf(16 + id.e.len + id.n.len)
BufPutStringStr(blob, HOSTKEY_SSH_RSA)
BufPutMpintBuf(blob, id.e)
BufPutMpintBuf(blob, id.n)
ret blob
end
func _auth_try_publickey(t &: Transport, user: str, id: Identity, algo: str): bool:
mut blob := _auth_pubkey_blob(id)
mut signed_data := NewBuf(64 + t.session_id.len + user.len() + blob.len)
BufPutStringBuf(signed_data, t.session_id)
BufPutByte(signed_data, SSH_MSG_USERAUTH_REQUEST)
BufPutStringStr(signed_data, user)
BufPutStringStr(signed_data, _AUTH_SERVICE)
BufPutStringStr(signed_data, "publickey")
BufPutBool(signed_data, true)
BufPutStringStr(signed_data, algo)
BufPutStringBuf(signed_data, blob)
kind := _hostkey_digest_kind(algo)
hlen := _rsa_hash_size(kind)
mut digest := NewBuf(hlen)
BufPutZeros(digest, hlen)
_hash_for_kind(kind, signed_data.p, signed_data.len, digest.p)
FreeBuf(signed_data)
mut sigbytes := NewBuf(id.n.len)
BufPutZeros(sigbytes, id.n.len)
signed_ok := _rsa_sign_pkcs1(kind, digest.p, id.n, id.e, id.d, id.phi, sigbytes.p)
FreeBuf(digest)
if not signed_ok:
FreeBuf(blob)
FreeBuf(sigbytes)
ret false
end
mut sigblob := NewBuf(16 + sigbytes.len)
BufPutStringStr(sigblob, algo)
BufPutStringBuf(sigblob, sigbytes)
FreeBuf(sigbytes)
mut req := NewBuf(64 + user.len() + blob.len + sigblob.len)
BufPutByte(req, SSH_MSG_USERAUTH_REQUEST)
BufPutStringStr(req, user)
BufPutStringStr(req, _AUTH_SERVICE)
BufPutStringStr(req, "publickey")
BufPutBool(req, true)
BufPutStringStr(req, algo)
BufPutStringBuf(req, blob)
BufPutStringBuf(req, sigblob)
FreeBuf(blob)
FreeBuf(sigblob)
ok := _auth_send_and_await(t, req)
FreeBuf(req)
ret ok
end
@en "AuthPublicKey"
@fa "احراز هویت با کلید عمومی"
func _auth_publickey(t &: Transport, user: str, id: Identity): bool:
if _auth_try_publickey(t, user, id, HOSTKEY_RSA_SHA256):
ret true
end
ret _auth_try_publickey(t, user, id, HOSTKEY_SSH_RSA)
end
package ssh
struct Big:
pub b: Buf = Buf {}
pub cap: int = 0
pub n: int = 0
pub bad: bool = false
end
struct Barrett:
pub m: Big = Big {}
pub mu: Big = Big {}
pub k: int = 0
end
inline func _limb(x: Big, i: int): u32:
p := x.b.p as u32*
ret p[i]
end
inline func _setlimb(x: Big, i: int, v: u32):
p := x.b.p as u32*
p[i] = v
end
func _big_new(limbs: int): Big:
mut nl := limbs
if nl < 1:
nl = 1
end
bb := NewBuf(nl * 4)
mut x := Big {}
x.b = bb
x.cap = nl
x.n = 0
x.bad = bb.bad
if bb.bad:
x.cap = 0
ret x
end
repeat nl in i:
_setlimb(x, i, 0 as u32)
end
ret x
end
func _big_free(x &: Big):
FreeBuf(x.b)
x.cap = 0
x.n = 0
end
func _big_wipe_free(x &: Big):
WipeBuf(x.b)
x.cap = 0
x.n = 0
end
func _big_trim(x &: Big):
until x.n >= 1:
if _limb(x, x.n - 1) != (0 as u32):
ret
end
x.n -= 1
end
end
func _big_zero(x &: Big):
nc := x.cap
repeat nc in i:
_setlimb(x, i, 0 as u32)
end
x.n = 0
end
func _big_is_zero(x: Big): bool:
ret x.n == 0
end
func _big_set_u32(x &: Big, v: u32):
_big_zero(x)
if v != (0 as u32):
_setlimb(x, 0, v)
x.n = 1
end
end
func _big_copy(dst &: Big, src: Big):
if dst.cap < src.n:
dst.bad = true
ret
end
dc := dst.cap
repeat dc in i:
_setlimb(dst, i, 0 as u32)
end
sn := src.n
repeat sn in i:
_setlimb(dst, i, _limb(src, i))
end
dst.n = src.n
end
func _big_cmp(a: Big, b: Big): int:
if a.n != b.n:
if a.n < b.n:
ret 0 - 1
end
ret 1
end
mut i := a.n - 1
until i >= 0:
av := _limb(a, i)
bv := _limb(b, i)
if av != bv:
if av < bv:
ret 0 - 1
end
ret 1
end
i -= 1
end
ret 0
end
func _big_bitlen(x: Big): int:
if x.n == 0:
ret 0
end
top := _limb(x, x.n - 1)
mut bits := 0
mut v := top
until v != (0 as u32):
bits += 1
v = v >> (1 as u32)
end
ret (x.n - 1) * 32 + bits
end
func _big_bit(x: Big, i: int): int:
if i < 0:
ret 0
end
li := i / 32
if li >= x.n:
ret 0
end
ret ((_limb(x, li) >> ((i % 32) as u32)) & (1 as u32)) as int
end
func _big_setbit(x &: Big, i: int):
li := i / 32
if li >= x.cap:
x.bad = true
ret
end
_setlimb(x, li, _limb(x, li) | ((1 as u32) << ((i % 32) as u32)))
if li + 1 > x.n:
x.n = li + 1
end
end
func _big_add(r &: Big, a: Big, b: Big):
mut maxn := a.n
if b.n > maxn:
maxn = b.n
end
if r.cap < maxn + 1:
r.bad = true
ret
end
_big_zero(r)
mut carry := 0 as u64
repeat maxn in i:
mut s := carry
if i < a.n:
s += _limb(a, i) as u64
end
if i < b.n:
s += _limb(b, i) as u64
end
_setlimb(r, i, s as u32)
carry = s >> (32 as u64)
end
mut n := maxn
if carry != (0 as u64):
_setlimb(r, maxn, carry as u32)
n = maxn + 1
end
r.n = n
_big_trim(r)
end
func _big_sub(r &: Big, a: Big, b: Big): bool:
if _big_cmp(a, b) < 0:
ret false
end
if r.cap < a.n:
r.bad = true
ret false
end
_big_zero(r)
an := a.n
mut borrow := 0 as i64
repeat an in i:
mut d := (_limb(a, i) as i64) - borrow
if i < b.n:
d -= _limb(b, i) as i64
end
if d < 0:
d += 4294967296
borrow = 1
else:
borrow = 0
end
_setlimb(r, i, d as u32)
end
r.n = a.n
_big_trim(r)
ret true
end
func _big_mul(r &: Big, a: Big, b: Big):
if r.cap < a.n + b.n:
r.bad = true
ret
end
_big_zero(r)
if a.n == 0 or b.n == 0:
ret
end
an := a.n
bn := b.n
repeat an in i:
mut carry := 0 as u64
av := _limb(a, i) as u64
repeat bn in j:
cur := (_limb(r, i + j) as u64) + av * (_limb(b, j) as u64) + carry
_setlimb(r, i + j, cur as u32)
carry = cur >> (32 as u64)
end
mut k := i + bn
until carry != (0 as u64):
cur := (_limb(r, k) as u64) + carry
_setlimb(r, k, cur as u32)
carry = cur >> (32 as u64)
k += 1
end
end
r.n = a.n + b.n
_big_trim(r)
end
func _big_shl1(x &: Big):
mut carry := 0 as u32
lim := x.n
repeat lim in i:
v := _limb(x, i)
_setlimb(x, i, (v << (1 as u32)) | carry)
carry = v >> (31 as u32)
end
if carry != (0 as u32):
if x.n >= x.cap:
x.bad = true
ret
end
_setlimb(x, x.n, carry)
x.n += 1
end
end
func _big_divmod(q &: Big, rem &: Big, a: Big, m: Big): bool:
if m.n == 0:
ret false
end
if q.cap < a.n or rem.cap < m.n + 1:
q.bad = true
ret false
end
_big_zero(q)
_big_zero(rem)
mut scratch := _big_new(m.n + 2)
defer _big_free(scratch)
if scratch.bad:
ret false
end
mut i := _big_bitlen(a) - 1
until i >= 0:
_big_shl1(rem)
if rem.bad:
ret false
end
if _big_bit(a, i) == 1:
if rem.n == 0:
_setlimb(rem, 0, 1 as u32)
rem.n = 1
else:
_setlimb(rem, 0, _limb(rem, 0) | (1 as u32))
end
end
if _big_cmp(rem, m) >= 0:
if not _big_sub(scratch, rem, m):
ret false
end
_big_copy(rem, scratch)
_big_setbit(q, i)
end
i -= 1
end
_big_trim(q)
_big_trim(rem)
ret true
end
func _big_mod(r &: Big, a: Big, m: Big): bool:
mut q := _big_new(a.n + 1)
defer _big_free(q)
if q.bad:
ret false
end
ret _big_divmod(q, r, a, m)
end
func _big_modexp(r &: Big, base: Big, e: Big, m: Big): bool:
if m.n == 0:
ret false
end
mut acc := _big_new(m.n + 1)
defer _big_free(acc)
mut cur := _big_new(m.n + 1)
defer _big_free(cur)
mut prod := _big_new(2 * m.n + 2)
defer _big_free(prod)
mut red := _big_new(m.n + 2)
defer _big_free(red)
if acc.bad or cur.bad or prod.bad or red.bad:
ret false
end
_big_set_u32(acc, 1 as u32)
if not _big_mod(cur, base, m):
ret false
end
bits := _big_bitlen(e)
mut i := 0
until i < bits:
if _big_bit(e, i) == 1:
_big_mul(prod, acc, cur)
if prod.bad or not _big_mod(red, prod, m):
ret false
end
_big_copy(acc, red)
end
if i + 1 < bits:
_big_mul(prod, cur, cur)
if prod.bad or not _big_mod(red, prod, m):
ret false
end
_big_copy(cur, red)
end
i += 1
end
_big_copy(r, acc)
ret not r.bad
end
func _big_shr_limbs(x: Big, s: int): Big:
mut nn := x.n - s
if nn < 0:
nn = 0
end
mut r := _big_new(nn + 1)
repeat nn in i:
_setlimb(r, i, _limb(x, i + s))
end
r.n = nn
_big_trim(r)
ret r
end
func _big_low_limbs(x: Big, s: int): Big:
mut nn := x.n
if nn > s:
nn = s
end
mut r := _big_new(s + 1)
repeat nn in i:
_setlimb(r, i, _limb(x, i))
end
r.n = nn
_big_trim(r)
ret r
end
func _barrett_new(m: Big): Barrett:
mut bt := Barrett {}
k := m.n
mut bk2 := _big_new(2 * k + 4)
_big_setbit(bk2, 2 * k * 32)
mut mu := _big_new(2 * k + 4)
mut rem := _big_new(k + 4)
_dok := _big_divmod(mu, rem, bk2, m)
_big_free(bk2)
_big_free(rem)
mut mcopy := _big_new(k + 4)
_big_copy(mcopy, m)
bt.m = mcopy
bt.mu = mu
bt.k = k
ret bt
end
func _barrett_free(bt &: Barrett):
_big_free(bt.m)
_big_free(bt.mu)
bt.k = 0
end
func _barrett_reduce(bt: Barrett, x: Big, r &: Big): bool:
k := bt.k
if x.n > 2 * k:
ret false
end
mut q1 := _big_shr_limbs(x, k - 1)
mut q2 := _big_new(q1.n + bt.mu.n + 4)
_big_mul(q2, q1, bt.mu)
mut q3 := _big_shr_limbs(q2, k + 1)
_big_free(q1)
_big_free(q2)
mut r1 := _big_low_limbs(x, k + 1)
mut prod := _big_new(q3.n + bt.m.n + 4)
_big_mul(prod, q3, bt.m)
mut r2 := _big_low_limbs(prod, k + 1)
_big_free(q3)
_big_free(prod)
mut wide := _big_new(k + 6)
if _big_cmp(r1, r2) >= 0:
_s1 := _big_sub(wide, r1, r2)
else:
mut base := _big_new(k + 6)
_big_setbit(base, (k + 1) * 32)
mut r1adj := _big_new(k + 6)
_big_add(r1adj, r1, base)
_s3 := _big_sub(wide, r1adj, r2)
_big_free(base)
_big_free(r1adj)
end
_big_free(r1)
_big_free(r2)
mut cur := wide
mut guard := 0
until _big_cmp(cur, bt.m) >= 0 and guard <= 4:
mut nxt := _big_new(k + 6)
_s4 := _big_sub(nxt, cur, bt.m)
_big_free(cur)
cur = nxt
guard += 1
end
_big_copy(r, cur)
_big_free(cur)
ret not r.bad
end
func _big_modexp_barrett(r &: Big, base: Big, e: Big, m: Big): bool:
if m.n == 0:
ret false
end
mut bt := _barrett_new(m)
mut acc := _big_new(m.n + 1)
_big_set_u32(acc, 1 as u32)
mut cur := _big_new(m.n + 1)
_dok2 := _big_mod(cur, base, m)
bits := _big_bitlen(e)
mut i := 0
mut ok := true
until i < bits and ok:
if _big_bit(e, i) == 1:
mut prod := _big_new(acc.n + cur.n)
_big_mul(prod, acc, cur)
mut red := _big_new(m.n + 1)
if prod.bad or not _barrett_reduce(bt, prod, red):
ok = false
end
_big_free(prod)
_big_copy(acc, red)
_big_free(red)
end
if ok and i + 1 < bits:
mut sq := _big_new(cur.n + cur.n)
_big_mul(sq, cur, cur)
mut red2 := _big_new(m.n + 1)
if sq.bad or not _barrett_reduce(bt, sq, red2):
ok = false
end
_big_free(sq)
_big_copy(cur, red2)
_big_free(red2)
end
i += 1
end
if ok:
_big_copy(r, acc)
end
_big_free(acc)
_big_free(cur)
_barrett_free(bt)
ret ok and not r.bad
end
func _big_from_bytes(p: void*, len: int): Big:
mut nl := (len + 3) / 4
if nl < 1:
nl = 1
end
mut x := _big_new(nl)
if x.bad:
ret x
end
repeat len in i:
v := _bget(p, len - 1 - i)
li := i / 4
sh := ((i % 4) * 8) as u32
_setlimb(x, li, _limb(x, li) | ((v as u32) << sh))
end
x.n = nl
_big_trim(x)
ret x
end
func _big_bytelen(x: Big): int:
bl := _big_bitlen(x)
ret (bl + 7) / 8
end
func _big_to_bytes(x: Big, out: void*, outlen: int): bool:
if _big_bytelen(x) > outlen:
ret false
end
repeat outlen in i:
_bput(out, i, 0)
end
total := x.n * 4
repeat total in i:
li := i / 4
sh := ((i % 4) * 8) as u32
v := ((_limb(x, li) >> sh) & (0xFF as u32)) as int
pos := outlen - 1 - i
if pos >= 0:
_bput(out, pos, v)
end
end
ret true
end
func _big_modexp_blinded_dh(r &: Big, base: Big, secret_e: Big, group_order: Big, m: Big, rnd_p: void*, rnd_n: int): bool:
mut mask := _big_from_bytes(rnd_p, rnd_n)
defer _big_free(mask)
if mask.bad:
ret false
end
mut kord := _big_new(group_order.n + mask.n + 1)
defer _big_free(kord)
_big_mul(kord, mask, group_order)
if kord.bad:
ret false
end
mut blinded_e := _big_new(kord.n + secret_e.n + 1)
defer _big_wipe_free(blinded_e)
_big_add(blinded_e, secret_e, kord)
if blinded_e.bad:
ret false
end
ret _big_modexp_barrett(r, base, blinded_e, m)
end
package ssh
import mem
import str
mut _ssh_split_warmed := false
struct Buf:
pub p: void* = null
pub len: int = 0
pub cap: int = 0
pub bad: bool = false
end
struct Reader:
pub p: void* = null
pub len: int = 0
pub pos: int = 0
pub bad: bool = false
end
inline func _bget(p: void*, i: int): int:
bp := p as u8*
ret bp[i] as int
end
inline func _bput(p: void*, i: int, v: int):
bp := p as u8*
bp[i] = v as u8
end
func _buf_grow(b &: Buf, need: int):
if b.bad:
ret
end
if b.len + need <= b.cap:
ret
end
mut nc := b.cap
if nc < 32:
nc = 32
end
until b.len + need > nc:
nc *= 2
end
np := mem.Reallocate(b.p, nc as u64)
if np == null:
b.bad = true
ret
end
b.p = np
b.cap = nc
end
func _ensure_split_warm():
if not _ssh_split_warmed:
mut junk := "a,b,c".split(",")
junk.free()
_ssh_split_warmed = true
end
end
@en "NewBuf"
@fa "بافر جدید"
pub func NewBuf(cap0: int): Buf:
mut c := cap0
if c < 32:
c = 32
end
p := mem.Allocate(c as u64)
mut b := Buf {}
if p == null:
b.bad = true
ret b
end
b.p = p
b.len = 0
b.cap = c
b.bad = false
ret b
end
@en "FreeBuf"
@fa "آزادسازی بافر"
pub func FreeBuf(b &: Buf):
if b.p != null:
mem.Free(b.p)
end
b.p = null
b.len = 0
b.cap = 0
end
@en "WipeBuf"
@fa "پاک سازی بافر"
pub func WipeBuf(b &: Buf):
if b.p != null and b.cap > 0:
mem.Set(b.p, 0, b.cap as u64)
end
FreeBuf(b)
end
@en "BufPutByte"
@fa "افزودن بایت"
pub func BufPutByte(b &: Buf, v: int):
_buf_grow(b, 1)
if b.bad:
ret
end
_bput(b.p, b.len, v)
b.len += 1
end
@en "BufPutBytes"
@fa "افزودن بایت ها"
pub func BufPutBytes(b &: Buf, p: void*, n: int):
if n <= 0:
ret
end
_buf_grow(b, n)
if b.bad:
ret
end
mem.Copy((b.p as i64 + b.len) as void*, p, n as u64)
b.len += n
end
@en "BufPutBuf"
@fa "افزودن بافر"
pub func BufPutBuf(b &: Buf, src: Buf):
BufPutBytes(b, src.p, src.len)
end
@en "BufPutZeros"
@fa "افزودن صفرها"
pub func BufPutZeros(b &: Buf, n: int):
if n <= 0:
ret
end
_buf_grow(b, n)
if b.bad:
ret
end
mem.Set((b.p as i64 + b.len) as void*, 0, n as u64)
b.len += n
end
@en "BufPutUint32"
@fa "افزودن یو۳۲"
pub func BufPutUint32(b &: Buf, v: u32):
_buf_grow(b, 4)
if b.bad:
ret
end
_bput(b.p, b.len, ((v >> (24 as u32)) & (0xFF as u32)) as int)
_bput(b.p, b.len + 1, ((v >> (16 as u32)) & (0xFF as u32)) as int)
_bput(b.p, b.len + 2, ((v >> (8 as u32)) & (0xFF as u32)) as int)
_bput(b.p, b.len + 3, (v & (0xFF as u32)) as int)
b.len += 4
end
@en "BufPutUint64"
@fa "افزودن یو۶۴"
pub func BufPutUint64(b &: Buf, v: u64):
_buf_grow(b, 8)
if b.bad:
ret
end
mut i := 0
until i < 8:
sh := ((7 - i) * 8) as u64
_bput(b.p, b.len + i, ((v >> sh) & (0xFF as u64)) as int)
i += 1
end
b.len += 8
end
@en "BufPutBool"
@fa "افزودن بولی"
pub func BufPutBool(b &: Buf, v: bool):
if v:
BufPutByte(b, 1)
else:
BufPutByte(b, 0)
end
end
@en "BufPutString"
@fa "افزودن رشته"
pub func BufPutString(b &: Buf, p: void*, n: int):
BufPutUint32(b, n as u32)
BufPutBytes(b, p, n)
end
@en "BufPutStringBuf"
@fa "افزودن رشته بافر"
pub func BufPutStringBuf(b &: Buf, src: Buf):
BufPutString(b, src.p, src.len)
end
@en "BufPutStringStr"
@fa "افزودن رشته متن"
pub func BufPutStringStr(b &: Buf, s: str):
BufPutString(b, s as void*, s.len())
end
@en "BufPutMpintBytes"
@fa "افزودن ام پی اینت"
pub func BufPutMpintBytes(b &: Buf, p: void*, n: int):
mut start := 0
until start < n:
if _bget(p, start) != 0:
break
end
start += 1
end
mlen := n - start
mut needpad := false
if mlen > 0 and (_bget(p, start) & 0x80) != 0:
needpad = true
end
if mlen == 0:
BufPutUint32(b, 0 as u32)
ret
end
mut extra := 0
if needpad:
extra = 1
end
BufPutUint32(b, (mlen + extra) as u32)
if needpad:
BufPutByte(b, 0)
end
BufPutBytes(b, (p as i64 + start) as void*, mlen)
end
@en "BufPutMpintBuf"
@fa "افزودن ام پی اینت بافر"
pub func BufPutMpintBuf(b &: Buf, src: Buf):
BufPutMpintBytes(b, src.p, src.len)
end
@en "NewReader"
@fa "خواننده جدید"
pub func NewReader(p: void*, n: int): Reader:
mut r := Reader {}
r.p = p
r.len = n
r.pos = 0
r.bad = false
ret r
end
@en "ReaderFromBuf"
@fa "خواننده از بافر"
pub func ReaderFromBuf(b: Buf): Reader:
ret NewReader(b.p, b.len)
end
@en "RRemaining"
@fa "باقی مانده"
pub func RRemaining(r: Reader): int:
ret r.len - r.pos
end
@en "RGetByte"
@fa "دریافت بایت"
pub func RGetByte(r &: Reader): int:
if r.bad or r.pos >= r.len:
r.bad = true
ret 0
end
v := _bget(r.p, r.pos)
r.pos += 1
ret v
end
@en "RGetBool"
@fa "دریافت بولی"
pub func RGetBool(r &: Reader): bool:
ret RGetByte(r) != 0
end
@en "RSkip"
@fa "رد شدن"
pub func RSkip(r &: Reader, n: int):
if r.bad or n < 0 or r.pos + n > r.len:
r.bad = true
ret
end
r.pos += n
end
@en "RGetUint32"
@fa "دریافت یو۳۲"
pub func RGetUint32(r &: Reader): u32:
if r.bad or r.pos + 4 > r.len:
r.bad = true
ret 0
end
b0 := _bget(r.p, r.pos) as u32
b1 := _bget(r.p, r.pos + 1) as u32
b2 := _bget(r.p, r.pos + 2) as u32
b3 := _bget(r.p, r.pos + 3) as u32
r.pos += 4
ret (b0 << (24 as u32)) | (b1 << (16 as u32)) | (b2 << (8 as u32)) | b3
end
@en "RGetUint64"
@fa "دریافت یو۶۴"
pub func RGetUint64(r &: Reader): u64:
if r.bad or r.pos + 8 > r.len:
r.bad = true
ret 0
end
mut v := 0 as u64
mut i := 0
until i < 8:
v = (v << (8 as u64)) | (_bget(r.p, r.pos + i) as u64)
i += 1
end
r.pos += 8
ret v
end
@en "RGetStringView"
@fa "دریافت نمای رشته"
pub func RGetStringView(r &: Reader): Reader:
n := RGetUint32(r) as int
if r.bad or n < 0 or r.pos + n > r.len:
r.bad = true
ret NewReader(null, 0)
end
v := NewReader((r.p as i64 + r.pos) as void*, n)
r.pos += n
ret v
end
@en "RGetStringCopy"
@fa "کپی رشته"
pub func RGetStringCopy(r &: Reader): Buf:
v := RGetStringView(r)
if r.bad:
ret NewBuf(1)
end
mut out := NewBuf(v.len)
BufPutBytes(out, v.p, v.len)
ret out
end
@en "RGetStringAsStr"
@fa "دریافت رشته متن"
pub func RGetStringAsStr(r &: Reader): str:
v := RGetStringView(r)
if r.bad or v.len == 0:
ret ""
end
p := mem.Allocate((v.len + 1) as u64)
defer mem.Free(p)
mem.Copy(p, v.p, v.len as u64)
_bput(p, v.len, 0)
ret str.Clone(p as str)
end
@en "RGetMpintView"
@fa "خواندن ام پی اینت"
pub func RGetMpintView(r &: Reader): Reader:
v := RGetStringView(r)
if r.bad:
ret v
end
if v.len > 0 and _bget(v.p, 0) == 0:
ret NewReader((v.p as i64 + 1) as void*, v.len - 1)
end
ret v
end
@en "RGetMpintCopy"
@fa "کپی ام پی اینت"
pub func RGetMpintCopy(r &: Reader): Buf:
v := RGetMpintView(r)
if r.bad:
ret NewBuf(1)
end
mut out := NewBuf(v.len)
BufPutBytes(out, v.p, v.len)
ret out
end
@en "RGetNameList"
@fa "دریافت لیست نام"
pub func RGetNameList(r &: Reader): str:
ret RGetStringAsStr(r)
end
@en "NameListContains"
@fa "شامل لیست نام"
pub func NameListContains(list: str, name: str): bool:
if list.len() == 0:
ret false
end
_ensure_split_warm()
parts := list.split(",")
defer parts.free()
mut found := false
each p in parts:
if str.Equals(p, name):
found = true
end
end
ret found
end
@en "NegotiateFirstMatch"
@fa "توافق اولین تطابق"
pub func NegotiateFirstMatch(mine: str, theirs: str): str:
_ensure_split_warm()
parts := mine.split(",")
defer parts.free()
mut result := ""
each p in parts:
if result.len() == 0 and NameListContains(theirs, p):
result = p
end
end
ret result
end
@en "ConstantTimeEqual"
@fa "برابری زمان ثابت"
pub func ConstantTimeEqual(a: void*, b: void*, n: int): bool:
mut diff := 0
repeat n in i:
diff = diff | (_bget(a, i) ^ _bget(b, i))
end
ret diff == 0
end
package ssh
import str
const _CHANNEL_INITIAL_WINDOW := 1048576
const _CHANNEL_MAX_PACKET := 32768
const _CHANNEL_WINDOW_LOW_WATER := 262144
struct Channel:
pub local_id: u32 = 0 as u32
pub remote_id: u32 = 0 as u32
pub local_window: u32 = 0 as u32
pub remote_window: u32 = 0 as u32
pub eof_received: bool = false
pub close_received: bool = false
pub close_sent: bool = false
pub exit_status: int = 0 - 1
pub stdout: Buf = Buf {}
pub stderr: Buf = Buf {}
pub open: bool = false
end
func _channel_new(): Channel:
mut ch := Channel {}
ch.local_id = 0 as u32
ch.local_window = _CHANNEL_INITIAL_WINDOW as u32
ch.exit_status = 0 - 1
ch.stdout = NewBuf(4096)
ch.stderr = NewBuf(1024)
ch.open = false
ret ch
end
func _channel_free(ch &: Channel):
FreeBuf(ch.stdout)
FreeBuf(ch.stderr)
ch.open = false
end
func _channel_open_session(t &: Transport): Channel:
mut ch := _channel_new()
mut req := NewBuf(32)
BufPutByte(req, SSH_MSG_CHANNEL_OPEN)
BufPutStringStr(req, "session")
BufPutUint32(req, ch.local_id)
BufPutUint32(req, ch.local_window)
BufPutUint32(req, _CHANNEL_MAX_PACKET as u32)
if not _packet_send(t.ps, req):
FreeBuf(req)
ret ch
end
FreeBuf(req)
mut attempts := 0
until attempts < 20:
reply := _packet_recv(t.ps)
if reply.bad:
ret ch
end
mut r := ReaderFromBuf(reply)
msgtype := RGetByte(r)
if msgtype == SSH_MSG_CHANNEL_OPEN_CONFIRMATION:
_their_id_of_our_channel := RGetUint32(r)
ch.remote_id = RGetUint32(r)
ch.remote_window = RGetUint32(r)
_their_max_packet := RGetUint32(r)
if not r.bad:
ch.open = true
end
FreeBuf(reply)
ret ch
end
if msgtype == SSH_MSG_CHANNEL_OPEN_FAILURE:
FreeBuf(reply)
ret ch
end
FreeBuf(reply)
attempts += 1
end
ret ch
end
func _channel_send_window_adjust(t &: Transport, ch &: Channel, add: u32):
mut m := NewBuf(16)
BufPutByte(m, SSH_MSG_CHANNEL_WINDOW_ADJUST)
BufPutUint32(m, ch.remote_id)
BufPutUint32(m, add)
_sent_ok := _packet_send(t.ps, m)
FreeBuf(m)
ch.local_window = ch.local_window + add
end
func _channel_pump_step(t &: Transport, ch &: Channel): int:
pkt := _packet_recv(t.ps)
if pkt.bad:
ch.close_received = true
FreeBuf(pkt)
ret 0 - 1
end
mut r := ReaderFromBuf(pkt)
msgtype := RGetByte(r)
if msgtype == SSH_MSG_CHANNEL_DATA:
_cid := RGetUint32(r)
data := RGetStringView(r)
if not r.bad:
BufPutBytes(ch.stdout, data.p, data.len)
if (ch.local_window as i64) - (data.len as i64) < (_CHANNEL_WINDOW_LOW_WATER as i64):
_channel_send_window_adjust(t, ch, _CHANNEL_INITIAL_WINDOW as u32)
else:
ch.local_window = ch.local_window - (data.len as u32)
end
end
FreeBuf(pkt)
ret 0
end
if msgtype == SSH_MSG_CHANNEL_EXTENDED_DATA:
_cid := RGetUint32(r)
dtype := RGetUint32(r)
data := RGetStringView(r)
if not r.bad and dtype == (SSH_EXTENDED_DATA_STDERR as u32):
BufPutBytes(ch.stderr, data.p, data.len)
if (ch.local_window as i64) - (data.len as i64) < (_CHANNEL_WINDOW_LOW_WATER as i64):
_channel_send_window_adjust(t, ch, _CHANNEL_INITIAL_WINDOW as u32)
else:
ch.local_window = ch.local_window - (data.len as u32)
end
end
FreeBuf(pkt)
ret 0
end
if msgtype == SSH_MSG_CHANNEL_WINDOW_ADJUST:
_cid := RGetUint32(r)
add := RGetUint32(r)
if not r.bad:
ch.remote_window = ch.remote_window + add
end
FreeBuf(pkt)
ret 0
end
if msgtype == SSH_MSG_CHANNEL_EOF:
ch.eof_received = true
FreeBuf(pkt)
ret ch.close_received ? 3 : 0
end
if msgtype == SSH_MSG_CHANNEL_CLOSE:
ch.close_received = true
if not ch.close_sent:
mut m := NewBuf(8)
BufPutByte(m, SSH_MSG_CHANNEL_CLOSE)
BufPutUint32(m, ch.remote_id)
_sent_ok := _packet_send(t.ps, m)
FreeBuf(m)
ch.close_sent = true
end
FreeBuf(pkt)
ret 3
end
if msgtype == SSH_MSG_CHANNEL_REQUEST:
_cid := RGetUint32(r)
reqtype := RGetStringAsStr(r)
_want_reply := RGetBool(r)
if str.Equals(reqtype, "exit-status"):
code := RGetUint32(r)
if not r.bad:
ch.exit_status = code as int
end
end
FreeBuf(pkt)
ret 0
end
if msgtype == SSH_MSG_CHANNEL_SUCCESS:
FreeBuf(pkt)
ret 1
end
if msgtype == SSH_MSG_CHANNEL_FAILURE:
FreeBuf(pkt)
ret 2
end
FreeBuf(pkt)
ret 0
end
func _channel_await_reply(t &: Transport, ch &: Channel): bool:
mut steps := 0
until steps < 100000:
code := _channel_pump_step(t, ch)
if code == 1:
ret true
end
if code == 2 or code == (0 - 1) or code == 3:
ret false
end
steps += 1
end
ret false
end
func _channel_pump_to_close(t &: Transport, ch &: Channel):
mut steps := 0
until (not ch.eof_received or not ch.close_received) and steps < 1000000:
code := _channel_pump_step(t, ch)
if code == 3 or code == (0 - 1):
ret
end
steps += 1
end
end
func _channel_send_request(t &: Transport, ch &: Channel, reqtype: str, want_reply: bool, extra: Buf): bool:
mut m := NewBuf(32 + extra.len)
BufPutByte(m, SSH_MSG_CHANNEL_REQUEST)
BufPutUint32(m, ch.remote_id)
BufPutStringStr(m, reqtype)
BufPutBool(m, want_reply)
BufPutBuf(m, extra)
ok := _packet_send(t.ps, m)
FreeBuf(m)
if not ok:
ret false
end
if want_reply:
ret _channel_await_reply(t, ch)
end
ret true
end
func _channel_exec(t &: Transport, ch &: Channel, cmd: str): bool:
mut extra := NewBuf(8 + cmd.len())
BufPutStringStr(extra, cmd)
ok := _channel_send_request(t, ch, "exec", true, extra)
FreeBuf(extra)
ret ok
end
func _channel_shell(t &: Transport, ch &: Channel): bool:
extra := NewBuf(1)
ret _channel_send_request(t, ch, "shell", true, extra)
end
func _channel_pty(t &: Transport, ch &: Channel, term: str, cols: int, rows: int): bool:
mut extra := NewBuf(32 + term.len())
BufPutStringStr(extra, term)
BufPutUint32(extra, cols as u32)
BufPutUint32(extra, rows as u32)
BufPutUint32(extra, 0 as u32)
BufPutUint32(extra, 0 as u32)
BufPutStringStr(extra, "")
ok := _channel_send_request(t, ch, "pty-req", true, extra)
FreeBuf(extra)
ret ok
end
func _channel_write(t &: Transport, ch &: Channel, data: void*, n: int): bool:
mut sent := 0
mut waits := 0
until sent < n and waits < 10000:
if ch.remote_window == (0 as u32):
code := _channel_pump_step(t, ch)
if code == (0 - 1) or code == 3:
ret false
end
waits += 1
continue
end
mut chunk := n - sent
if chunk > _CHANNEL_MAX_PACKET:
chunk = _CHANNEL_MAX_PACKET
end
if (chunk as u32) > ch.remote_window:
chunk = ch.remote_window as int
end
mut m := NewBuf(16 + chunk)
BufPutByte(m, SSH_MSG_CHANNEL_DATA)
BufPutUint32(m, ch.remote_id)
BufPutString(m, (data as i64 + sent) as void*, chunk)
ok := _packet_send(t.ps, m)
FreeBuf(m)
if not ok:
ret false
end
ch.remote_window = ch.remote_window - (chunk as u32)
sent += chunk
end
ret sent >= n
end
func _channel_send_eof(t &: Transport, ch &: Channel):
mut m := NewBuf(8)
BufPutByte(m, SSH_MSG_CHANNEL_EOF)
BufPutUint32(m, ch.remote_id)
_sent_ok := _packet_send(t.ps, m)
FreeBuf(m)
end
func _channel_send_close(t &: Transport, ch &: Channel):
if ch.close_sent:
ret
end
mut m := NewBuf(8)
BufPutByte(m, SSH_MSG_CHANNEL_CLOSE)
BufPutUint32(m, ch.remote_id)
_sent_ok := _packet_send(t.ps, m)
FreeBuf(m)
ch.close_sent = true
end
package ssh
import net.internal.rawsock
import str
import encoding
@en "Client"
@fa "کارخواه"
pub struct Client:
pub transport: Transport = Transport {}
pub cfg: Config = Config {}
pub connected: bool = false
pub errmsg: str = ""
end
func _client_fail(msg: str): Client:
mut c := Client {}
c.connected = false
c.errmsg = msg
ret c
end
func _knownhosts_path_for(cfg: Config): str:
if cfg.known_hosts_path.len() > 0:
ret cfg.known_hosts_path
end
ret _knownhosts_default_path()
end
func _check_host_key(cfg: Config, hk: HostKey): bool:
if cfg.hostkey_mode == HOSTKEY_MODE_INSECURE:
ret true
end
path := _knownhosts_path_for(cfg)
key_b64 := encoding.Base64EncodeBytes(hk.blob.p, hk.blob.len)
result := _knownhosts_check(path, cfg.host, cfg.port, HOSTKEY_SSH_RSA, key_b64)
if result == KH_UNKNOWN and cfg.hostkey_mode == HOSTKEY_MODE_ACCEPT_NEW:
_appended_ok := _knownhosts_append(path, cfg.host, cfg.port, HOSTKEY_SSH_RSA, key_b64)
end
ret _knownhosts_decide(cfg.hostkey_mode, result)
end
func _authenticate(t &: Transport, cfg: Config): bool:
if not _auth_request_service(t):
ret false
end
if cfg.use_key:
id := _load_identity_pem(cfg.key_pem)
if not id.ok:
ret false
end
ok := _auth_publickey(t, cfg.user, id)
_identity_free(id)
ret ok
end
if cfg.use_password:
ret _auth_password(t, cfg.user, cfg.password)
end
ret false
end
@en "Dial"
@fa "شماره گیری"
pub func Dial(cfg: Config): Client:
sock := rawsock.Connect(cfg.host, cfg.port)
if not rawsock.Ok(sock):
ret _client_fail("could not connect to " + cfg.host)
end
mut t := _transport_handshake(sock)
if not t.ok:
rawsock.Close(sock)
ret _client_fail("handshake failed: " + t.errmsg)
end
if not _check_host_key(cfg, t.hostkey):
_packet_state_free(t.ps)
rawsock.Close(sock)
ret _client_fail("host key verification failed for " + cfg.host)
end
if not _authenticate(t, cfg):
_packet_state_free(t.ps)
rawsock.Close(sock)
ret _client_fail("authentication failed for user " + cfg.user)
end
mut c := Client {}
c.transport = t
c.cfg = cfg
c.connected = true
ret c
end
@en "Connect"
@fa "اتصال"
pub func Connect(cfg: Config): Client:
ret Dial(cfg)
end
@en "Ok"
@fa "معتبر"
pub func Ok(client: Client): bool:
ret client.connected
end
@en "Error"
@fa "خطا"
pub func Error(client: Client): str:
ret client.errmsg
end
@en "HostKeyFingerprint"
@fa "اثر انگشت کلید میزبان"
pub func HostKeyFingerprint(client: Client): str:
ret _hostkey_fingerprint(client.transport.hostkey)
end
@en "Close"
@fa "بستن"
pub func Close(client &: Client):
if not client.connected:
ret
end
sock := client.transport.ps.sock
_packet_state_free(client.transport.ps)
rawsock.Close(sock)
client.connected = false
end
@en "Reconnect"
@fa "اتصال مجدد"
pub func Reconnect(client &: Client): bool:
cfg := client.cfg
if client.connected:
Close(client)
end
fresh := Dial(cfg)
client.transport = fresh.transport
client.cfg = fresh.cfg
client.connected = fresh.connected
client.errmsg = fresh.errmsg
ret client.connected
end
@en "RunCommand"
@fa "اجرای دستور"
pub func RunCommand(client &: Client, cmd: str): ExecResult:
ret Exec(client, cmd)
end
package ssh
import io
@en "Config"
@fa "پیکربندی"
pub struct Config:
pub host: str = ""
pub port: int = 22
pub user: str = ""
pub password: str = ""
pub use_password: bool = false
pub key_pem: str = ""
pub use_key: bool = false
pub hostkey_mode: int = 1
pub known_hosts_path: str = ""
end
@en "NewConfig"
@fa "پیکربندی جدید"
pub func NewConfig(host: str, port: int, user: str): Config:
mut cfg := Config {}
cfg.host = host
cfg.port = port
cfg.user = user
cfg.hostkey_mode = HOSTKEY_MODE_ACCEPT_NEW
ret cfg
end
@en "WithPassword"
@fa "با رمز عبور"
pub func WithPassword(cfg &: Config, password: str):
cfg.password = password
cfg.use_password = true
cfg.use_key = false
end
@en "WithKeyFile"
@fa "با فایل کلید"
pub func WithKeyFile(cfg &: Config, path: str): bool:
pem := io.ReadFile(path)
if pem.len() == 0:
ret false
end
cfg.key_pem = pem
cfg.use_key = true
cfg.use_password = false
ret true
end
@en "WithKeyPEM"
@fa "با متن کلید"
pub func WithKeyPEM(cfg &: Config, pem: str):
cfg.key_pem = pem
cfg.use_key = true
cfg.use_password = false
end
@en "WithHostKeyMode"
@fa "با حالت کلید میزبان"
pub func WithHostKeyMode(cfg &: Config, mode: int):
cfg.hostkey_mode = mode
end
@en "WithKnownHostsPath"
@fa "با مسیر میزبان های شناخته شده"
pub func WithKnownHostsPath(cfg &: Config, path: str):
cfg.known_hosts_path = path
end
package ssh
import crypto
const _DH14_P_HEX := ""
struct DH14KeyPair:
pub secret: Buf = Buf {}
pub public: Buf = Buf {}
end
func _dh14_prime(): Big:
h := _hexbuf(_DH14_P_HEX)
p := _big_from_bytes(h.p, h.len)
FreeBuf(h)
ret p
end
func _dh14_order(p: Big): Big:
mut one := _big_new(1)
_big_set_u32(one, 1 as u32)
mut order := _big_new(p.n + 1)
_ok := _big_sub(order, p, one)
_big_free(one)
ret order
end
func _dh14_generate(): DH14KeyPair:
mut p := _dh14_prime()
mut order := _dh14_order(p)
mut xbytes := NewBuf(256)
BufPutZeros(xbytes, 256)
crypto.RandomBytes(xbytes.p, 256)
_bput(xbytes.p, 0, _bget(xbytes.p, 0) & 0x7F)
_bput(xbytes.p, 255, _bget(xbytes.p, 255) | 0x01)
mut x := _big_from_bytes(xbytes.p, 256)
mut g := _big_new(1)
_big_set_u32(g, 2 as u32)
mut rndmask := NewBuf(32)
BufPutZeros(rndmask, 32)
crypto.RandomBytes(rndmask.p, 32)
mut e := _big_new(p.n + 1)
_ok := _big_modexp_blinded_dh(e, g, x, order, p, rndmask.p, rndmask.len)
mut kp := DH14KeyPair {}
kp.secret = xbytes
kp.public = NewBuf(_big_bytelen(e))
BufPutZeros(kp.public, _big_bytelen(e))
_tobytes_ok := _big_to_bytes(e, kp.public.p, kp.public.len)
_big_free(p)
_big_free(order)
_big_free(x)
_big_free(g)
FreeBuf(rndmask)
_big_free(e)
ret kp
end
func _dh14_shared(secret_x: Buf, peer_public: Buf): Buf:
mut p := _dh14_prime()
mut order := _dh14_order(p)
mut x := _big_from_bytes(secret_x.p, secret_x.len)
mut f := _big_from_bytes(peer_public.p, peer_public.len)
mut two := _big_new(1)
_big_set_u32(two, 2 as u32)
mut pm1 := _big_new(p.n + 1)
mut one := _big_new(1)
_big_set_u32(one, 1 as u32)
_ok1 := _big_sub(pm1, p, one)
bad := _big_cmp(f, two) < 0 or _big_cmp(f, pm1) >= 0
_big_free(two)
_big_free(pm1)
_big_free(one)
mut rndmask := NewBuf(32)
BufPutZeros(rndmask, 32)
crypto.RandomBytes(rndmask.p, 32)
mut k := _big_new(p.n + 1)
mut out := NewBuf(1)
if not bad:
_ok2 := _big_modexp_blinded_dh(k, f, x, order, p, rndmask.p, rndmask.len)
FreeBuf(out)
out = NewBuf(_big_bytelen(k))
BufPutZeros(out, _big_bytelen(k))
_tobytes_ok := _big_to_bytes(k, out.p, out.len)
end
_big_free(p)
_big_free(order)
_big_free(x)
_big_free(f)
FreeBuf(rndmask)
_big_free(k)
ret out
end
package ssh
import str
import crypto
import encoding
struct HostKey:
pub ok: bool = false
pub n: Buf = Buf {}
pub e: Buf = Buf {}
pub blob: Buf = Buf {}
end
func _hostkey_free(hk &: HostKey):
FreeBuf(hk.n)
FreeBuf(hk.e)
FreeBuf(hk.blob)
hk.ok = false
end
func _mpint_significant(b: Buf): int:
mut i := 0
until i < b.len and _bget(b.p, i) == 0:
i += 1
end
ret b.len - i
end
func _hostkey_sane(e: Buf, n: Buf): bool:
nlen := _mpint_significant(n)
elen := _mpint_significant(e)
if nlen < 128 or nlen > 2048 or elen < 1 or elen > 8:
ret false
end
if (_bget(n.p, n.len - 1) & 1) == 0 or (_bget(e.p, e.len - 1) & 1) == 0:
ret false
end
ret not (elen == 1 and _bget(e.p, e.len - 1) == 1)
end
func _hostkey_parse(raw: Buf): HostKey:
mut r := ReaderFromBuf(raw)
keytype := RGetStringAsStr(r)
if r.bad or not str.Equals(keytype, "ssh-rsa"):
ret HostKey {}
end
e := RGetMpintCopy(r)
n := RGetMpintCopy(r)
if r.bad:
FreeBuf(e)
FreeBuf(n)
ret HostKey {}
end
if not _hostkey_sane(e, n):
FreeBuf(e)
FreeBuf(n)
ret HostKey {}
end
mut hk := HostKey {}
hk.n = n
hk.e = e
hk.blob = NewBuf(raw.len)
BufPutBuf(hk.blob, raw)
hk.ok = true
ret hk
end
func _hostkey_digest_kind(sig_format: str): int:
if str.Equals(sig_format, HOSTKEY_RSA_SHA256):
ret SSH_HASH_SHA256
end
if str.Equals(sig_format, HOSTKEY_RSA_SHA512):
ret SSH_HASH_SHA512
end
ret SSH_HASH_SHA1
end
func _hash_for_kind(kind: int, p: void*, n: int, out: void*):
if kind == SSH_HASH_SHA1:
crypto.Sha1Bytes(p, n, out)
ret
end
if kind == SSH_HASH_SHA512:
crypto.Sha512Bytes(p, n, out)
ret
end
crypto.Sha256Bytes(p, n, out)
end
func _hostkey_verify(hk: HostKey, h: Buf, sig_blob: Buf): bool:
if not hk.ok:
ret false
end
mut r := ReaderFromBuf(sig_blob)
sig_format := RGetStringAsStr(r)
sig := RGetStringCopy(r)
if r.bad or not (str.Equals(sig_format, HOSTKEY_SSH_RSA) or str.Equals(sig_format, HOSTKEY_RSA_SHA256) or str.Equals(sig_format, HOSTKEY_RSA_SHA512)):
FreeBuf(sig)
ret false
end
kind := _hostkey_digest_kind(sig_format)
hlen := _rsa_hash_size(kind)
mut digest := NewBuf(hlen)
BufPutZeros(digest, hlen)
_hash_for_kind(kind, h.p, h.len, digest.p)
result := _rsa_verify_pkcs1(kind, digest.p, hk.n.p, hk.n.len, hk.e.p, hk.e.len, sig.p, sig.len)
FreeBuf(sig)
FreeBuf(digest)
ret result
end
func _hostkey_fingerprint(hk: HostKey): str:
mut d := NewBuf(32)
BufPutZeros(d, 32)
crypto.Sha256Bytes(hk.blob.p, hk.blob.len, d.p)
b64 := encoding.Base64EncodeBytes(d.p, 32)
FreeBuf(d)
mut trimmed := b64
until str.EndsWith(trimmed, "="):
trimmed = trimmed.substr(0, trimmed.len() - 1)
end
ret "SHA256:" + trimmed
end
package ssh
import crypto
const KDF_IV_CTOS := 65
const KDF_IV_STOC := 66
const KDF_KEY_CTOS := 67
const KDF_KEY_STOC := 68
const KDF_MAC_CTOS := 69
const KDF_MAC_STOC := 70
func _kdf_hash(sha256: bool, p: void*, n: int, out: void*):
if sha256:
crypto.Sha256Bytes(p, n, out)
ret
end
crypto.Sha1Bytes(p, n, out)
end
func _derive_key(sha256: bool, k_mpint: Buf, h: Buf, session_id: Buf, letter: int, needed_len: int): Buf:
hlen := sha256 ? 32 : 20
mut result := NewBuf(needed_len)
mut hbuf := NewBuf(k_mpint.len + h.len + 1 + session_id.len)
BufPutBuf(hbuf, k_mpint)
BufPutBuf(hbuf, h)
BufPutByte(hbuf, letter)
BufPutBuf(hbuf, session_id)
mut block := NewBuf(hlen)
BufPutZeros(block, hlen)
_kdf_hash(sha256, hbuf.p, hbuf.len, block.p)
FreeBuf(hbuf)
mut take := needed_len
if take > hlen:
take = hlen
end
BufPutBytes(result, block.p, take)
FreeBuf(block)
until result.len < needed_len:
mut input2 := NewBuf(k_mpint.len + h.len + result.len)
BufPutBuf(input2, k_mpint)
BufPutBuf(input2, h)
BufPutBytes(input2, result.p, result.len)
mut block2 := NewBuf(hlen)
BufPutZeros(block2, hlen)
_kdf_hash(sha256, input2.p, input2.len, block2.p)
FreeBuf(input2)
mut take2 := needed_len - result.len
if take2 > hlen:
take2 = hlen
end
BufPutBytes(result, block2.p, take2)
FreeBuf(block2)
end
ret result
end
package ssh
import str
import io
import os
import encoding
import conv
import filepath
@en "HOSTKEY_MODE_INSECURE"
@fa "حالت کلید میزبان ناامن"
pub const HOSTKEY_MODE_INSECURE := 0
@en "HOSTKEY_MODE_ACCEPT_NEW"
@fa "حالت پذیرش کلید میزبان تازه"
pub const HOSTKEY_MODE_ACCEPT_NEW := 1
@en "HOSTKEY_MODE_STRICT"
@fa "حالت کلید میزبان سخت‌گیر"
pub const HOSTKEY_MODE_STRICT := 2
const KH_UNKNOWN := 0
const KH_MATCH := 1
const KH_MISMATCH := 2
func _knownhosts_default_path(): str:
if SALAM_OS_WINDOWS:
home := os.Env("USERPROFILE")
ret home + "\\.ssh\\known_hosts"
else:
home := os.Env("HOME")
ret home + "/.ssh/known_hosts"
end
end
func _knownhosts_hostpattern(host: str, port: int): str:
if port == DefaultPort:
ret host
end
ret "[" + host + "]:" + conv.FormatInt(port as i64)
end
func _knownhosts_line_matches_host(line_hosts: str, pattern: str): bool:
if line_hosts.len() == 0 or _bget(line_hosts as void*, 0) == 124:
ret false
end
ret NameListContains(line_hosts, pattern)
end
func _knownhosts_check(path: str, host: str, port: int, keytype: str, key_b64: str): int:
if not os.Exists(path):
ret KH_UNKNOWN
end
pattern := _knownhosts_hostpattern(host, port)
content := io.ReadFile(path)
lines := content.split("\n")
mut result := KH_UNKNOWN
each ln in lines:
trimmed := ln.trim()
if trimmed.len() == 0 or str.StartsWith(trimmed, "#"):
continue
end
fields := trimmed.split(" ")
if fields.len() < 3:
continue
end
lhosts := fields.get(0)
lkeytype := fields.get(1)
lkey := fields.get(2)
if _knownhosts_line_matches_host(lhosts, pattern) and str.Equals(lkeytype, keytype):
if str.Equals(lkey, key_b64):
result = KH_MATCH
else if result != KH_MATCH:
result = KH_MISMATCH
end
end
fields.free()
end
defer lines.free()
ret result
end
func _knownhosts_append(path: str, host: str, port: int, keytype: str, key_b64: str): bool:
dir := filepath.Dir(path)
if dir.len() > 0 and not os.Exists(dir):
_mkdir_ok := os.MkdirAll(dir)
end
pattern := _knownhosts_hostpattern(host, port)
line := pattern + " " + keytype + " " + key_b64 + "\n"
ret io.AppendFile(path, line) >= 0
end
func _knownhosts_decide(mode: int, result: int): bool:
if mode == HOSTKEY_MODE_INSECURE:
ret true
end
if result == KH_MISMATCH:
ret false
end
if mode == HOSTKEY_MODE_STRICT:
ret result == KH_MATCH
end
ret true
end
package ssh
import crypto
const MAC_SHA1 := 0
const MAC_SHA256 := 1
const _HMAC_BLOCK := 64
func _mac_size(kind: int): int:
if kind == MAC_SHA256:
ret 32
end
ret 20
end
func _mac_hash(kind: int, p: void*, n: int, out: void*):
if kind == MAC_SHA256:
crypto.Sha256Bytes(p, n, out)
ret
end
crypto.Sha1Bytes(p, n, out)
end
func _hmac(kind: int, key: void*, klen: int, msg: void*, mlen: int, out: void*):
hlen := _mac_size(kind)
mut key0 := NewBuf(_HMAC_BLOCK)
BufPutZeros(key0, _HMAC_BLOCK)
if klen > _HMAC_BLOCK:
mut kh := NewBuf(hlen)
BufPutZeros(kh, hlen)
_mac_hash(kind, key, klen, kh.p)
repeat hlen in i:
_bput(key0.p, i, _bget(kh.p, i))
end
FreeBuf(kh)
else:
repeat klen in i:
_bput(key0.p, i, _bget(key, i))
end
end
mut ipad := NewBuf(_HMAC_BLOCK)
BufPutZeros(ipad, _HMAC_BLOCK)
mut opad := NewBuf(_HMAC_BLOCK)
BufPutZeros(opad, _HMAC_BLOCK)
repeat _HMAC_BLOCK in i:
kb := _bget(key0.p, i)
_bput(ipad.p, i, kb ^ 0x36)
_bput(opad.p, i, kb ^ 0x5c)
end
mut inner_in := NewBuf(_HMAC_BLOCK + mlen)
BufPutBytes(inner_in, ipad.p, _HMAC_BLOCK)
BufPutBytes(inner_in, msg, mlen)
mut inner := NewBuf(hlen)
BufPutZeros(inner, hlen)
_mac_hash(kind, inner_in.p, inner_in.len, inner.p)
mut outer_in := NewBuf(_HMAC_BLOCK + hlen)
BufPutBytes(outer_in, opad.p, _HMAC_BLOCK)
BufPutBytes(outer_in, inner.p, hlen)
_mac_hash(kind, outer_in.p, outer_in.len, out)
WipeBuf(key0)
FreeBuf(ipad)
FreeBuf(opad)
FreeBuf(inner_in)
FreeBuf(inner)
FreeBuf(outer_in)
end
package ssh
const SSH_MSG_DISCONNECT := 1
const SSH_MSG_IGNORE := 2
const SSH_MSG_UNIMPLEMENTED := 3
const SSH_MSG_DEBUG := 4
const SSH_MSG_SERVICE_REQUEST := 5
const SSH_MSG_SERVICE_ACCEPT := 6
const SSH_MSG_KEXINIT := 20
const SSH_MSG_NEWKEYS := 21
const SSH_MSG_KEXDH_INIT := 30
const SSH_MSG_KEXDH_REPLY := 31
const SSH_MSG_USERAUTH_REQUEST := 50
const SSH_MSG_USERAUTH_FAILURE := 51
const SSH_MSG_USERAUTH_SUCCESS := 52
const SSH_MSG_USERAUTH_BANNER := 53
const SSH_MSG_USERAUTH_PK_OK := 60
const SSH_MSG_GLOBAL_REQUEST := 80
const SSH_MSG_REQUEST_SUCCESS := 81
const SSH_MSG_REQUEST_FAILURE := 82
const SSH_MSG_CHANNEL_OPEN := 90
const SSH_MSG_CHANNEL_OPEN_CONFIRMATION := 91
const SSH_MSG_CHANNEL_OPEN_FAILURE := 92
const SSH_MSG_CHANNEL_WINDOW_ADJUST := 93
const SSH_MSG_CHANNEL_DATA := 94
const SSH_MSG_CHANNEL_EXTENDED_DATA := 95
const SSH_MSG_CHANNEL_EOF := 96
const SSH_MSG_CHANNEL_CLOSE := 97
const SSH_MSG_CHANNEL_REQUEST := 98
const SSH_MSG_CHANNEL_SUCCESS := 99
const SSH_MSG_CHANNEL_FAILURE := 100
const SSH_DISCONNECT_PROTOCOL_ERROR := 2
const SSH_DISCONNECT_KEY_EXCHANGE_FAILED := 3
const SSH_DISCONNECT_HOST_KEY_NOT_VERIFIABLE := 4
const SSH_DISCONNECT_MAC_ERROR := 5
const SSH_DISCONNECT_BY_APPLICATION := 11
const SSH_EXTENDED_DATA_STDERR := 1
const SSH_OPEN_ADMINISTRATIVELY_PROHIBITED := 1
package ssh
import net.internal.rawsock
import crypto
struct PacketState:
pub sock: rawsock.Socket = rawsock.Socket {}
pub seq_read: u32 = 0 as u32
pub seq_write: u32 = 0 as u32
pub encrypted: bool = false
pub cipher_read: Aes = Aes {}
pub cipher_write: Aes = Aes {}
pub counter_read: Buf = Buf {}
pub counter_write: Buf = Buf {}
pub mac_kind_read: int = 0
pub mac_kind_write: int = 0
pub mac_key_read: Buf = Buf {}
pub mac_key_write: Buf = Buf {}
pub block_size_read: int = 8
pub block_size_write: int = 8
pub ok: bool = true
end
func _packet_state_new(sock: rawsock.Socket): PacketState:
mut ps := PacketState {}
ps.sock = sock
ps.seq_read = 0 as u32
ps.seq_write = 0 as u32
ps.encrypted = false
ps.block_size_read = 8
ps.block_size_write = 8
ps.ok = true
ret ps
end
func _packet_state_free(ps &: PacketState):
WipeBuf(ps.counter_read)
WipeBuf(ps.counter_write)
WipeBuf(ps.mac_key_read)
WipeBuf(ps.mac_key_write)
end
func _read_exact(sock: rawsock.Socket, buf: void*, n: int): bool:
mut got := 0
until got < n:
r := rawsock.RecvBytes(sock, (buf as i64 + got) as void*, n - got)
if r <= 0:
ret false
end
got += r
end
ret true
end
func _packet_mac_compute(kind: int, key: Buf, seq: u32, plaintext: Buf, out: void*):
mut m := NewBuf(4 + plaintext.len)
BufPutUint32(m, seq)
BufPutBuf(m, plaintext)
_hmac(kind, key.p, key.len, m.p, m.len, out)
FreeBuf(m)
end
func _packet_send(ps &: PacketState, payload: Buf): bool:
bs := ps.block_size_write
mut padlen := bs - ((5 + payload.len) % bs)
if padlen < 4:
padlen += bs
end
packet_len := 1 + payload.len + padlen
mut pkt := NewBuf(4 + packet_len)
BufPutUint32(pkt, packet_len as u32)
BufPutByte(pkt, padlen)
BufPutBuf(pkt, payload)
mut padbytes := NewBuf(padlen)
BufPutZeros(padbytes, padlen)
crypto.RandomBytes(padbytes.p, padlen)
BufPutBuf(pkt, padbytes)
FreeBuf(padbytes)
mlen := ps.encrypted ? _mac_size(ps.mac_kind_write) : 0
mut mac := NewBuf(1)
if ps.encrypted:
FreeBuf(mac)
mac = NewBuf(mlen)
BufPutZeros(mac, mlen)
_packet_mac_compute(ps.mac_kind_write, ps.mac_key_write, ps.seq_write, pkt, mac.p)
end
mut wire := NewBuf(pkt.len + mlen)
if ps.encrypted:
mut enc := NewBuf(pkt.len)
BufPutZeros(enc, pkt.len)
_aes_ctr_xor(ps.cipher_write, ps.counter_write, pkt.p, pkt.len, enc.p)
BufPutBuf(wire, enc)
FreeBuf(enc)
else:
BufPutBuf(wire, pkt)
end
BufPutBuf(wire, mac)
sent := rawsock.SendBytes(ps.sock, wire.p, wire.len)
ok := sent == wire.len
FreeBuf(pkt)
FreeBuf(mac)
FreeBuf(wire)
if ok:
ps.seq_write = ps.seq_write + (1 as u32)
end
ret ok
end
func _packet_recv(ps &: PacketState): Buf:
bs := ps.block_size_read
mut first := NewBuf(bs)
BufPutZeros(first, bs)
if not _read_exact(ps.sock, first.p, bs):
FreeBuf(first)
mut bad := NewBuf(1)
bad.bad = true
ret bad
end
mut plain := NewBuf(bs)
BufPutZeros(plain, bs)
if ps.encrypted:
_aes_ctr_xor(ps.cipher_read, ps.counter_read, first.p, bs, plain.p)
else:
plain.len = 0
BufPutBytes(plain, first.p, bs)
end
FreeBuf(first)
mut plr := ReaderFromBuf(plain)
packet_len := RGetUint32(plr) as int
if plr.bad or packet_len < 1 or packet_len > 262144:
FreeBuf(plain)
mut bad := NewBuf(1)
bad.bad = true
ret bad
end
total_needed := 4 + packet_len
mut full := NewBuf(total_needed)
BufPutBuf(full, plain)
FreeBuf(plain)
remaining := total_needed - bs
if remaining > 0:
mut rest_enc := NewBuf(remaining)
BufPutZeros(rest_enc, remaining)
if not _read_exact(ps.sock, rest_enc.p, remaining):
FreeBuf(rest_enc)
FreeBuf(full)
mut bad := NewBuf(1)
bad.bad = true
ret bad
end
mut rest_plain := NewBuf(remaining)
BufPutZeros(rest_plain, remaining)
if ps.encrypted:
_aes_ctr_xor(ps.cipher_read, ps.counter_read, rest_enc.p, remaining, rest_plain.p)
else:
rest_plain.len = 0
BufPutBytes(rest_plain, rest_enc.p, remaining)
end
BufPutBytes(full, rest_plain.p, remaining)
FreeBuf(rest_enc)
FreeBuf(rest_plain)
end
if ps.encrypted:
mlen := _mac_size(ps.mac_kind_read)
mut got_mac := NewBuf(mlen)
BufPutZeros(got_mac, mlen)
if not _read_exact(ps.sock, got_mac.p, mlen):
FreeBuf(got_mac)
FreeBuf(full)
mut bad := NewBuf(1)
bad.bad = true
ret bad
end
mut want_mac := NewBuf(mlen)
BufPutZeros(want_mac, mlen)
_packet_mac_compute(ps.mac_kind_read, ps.mac_key_read, ps.seq_read, full, want_mac.p)
mac_ok := ConstantTimeEqual(got_mac.p, want_mac.p, mlen)
FreeBuf(got_mac)
FreeBuf(want_mac)
if not mac_ok:
FreeBuf(full)
mut bad := NewBuf(1)
bad.bad = true
ret bad
end
end
padding_len := _bget(full.p, 4)
payload_len := packet_len - padding_len - 1
if payload_len < 0 or 5 + payload_len > full.len:
FreeBuf(full)
mut bad := NewBuf(1)
bad.bad = true
ret bad
end
mut payload := NewBuf(payload_len)
BufPutBytes(payload, (full.p as i64 + 5) as void*, payload_len)
FreeBuf(full)
ps.seq_read = ps.seq_read + (1 as u32)
ret payload
end
package ssh
import str
import io
import os
import encoding
import tls
const _OPENSSH_MAGIC := "openssh-key-v1"
struct Identity:
pub ok: bool = false
pub n: Buf = Buf {}
pub e: Buf = Buf {}
pub d: Buf = Buf {}
pub phi: Buf = Buf {}
end
func _identity_bad(): Identity:
ret Identity {}
end
func _identity_free(k &: Identity):
WipeBuf(k.d)
WipeBuf(k.phi)
FreeBuf(k.n)
FreeBuf(k.e)
k.ok = false
end
func _load_pem(pem: str): Identity:
tk := tls.ParsePrivateKeyPEM(pem)
if not tk.ok or tk.rsa_n.len == 0:
ret _identity_bad()
end
mut id := Identity {}
id.n = NewBuf(tk.rsa_n.len)
BufPutBytes(id.n, tk.rsa_n.p, tk.rsa_n.len)
id.e = NewBuf(tk.rsa_e.len)
BufPutBytes(id.e, tk.rsa_e.p, tk.rsa_e.len)
id.d = NewBuf(tk.rsa_d.len)
BufPutBytes(id.d, tk.rsa_d.p, tk.rsa_d.len)
id.phi = NewBuf(tk.rsa_phi.len)
BufPutBytes(id.phi, tk.rsa_phi.p, tk.rsa_phi.len)
id.ok = true
ret id
end
func _phi_from_pq(p: Buf, q: Buf): Buf:
mut pbig := _big_from_bytes(p.p, p.len)
mut qbig := _big_from_bytes(q.p, q.len)
mut one := _big_new(1)
_big_set_u32(one, 1 as u32)
mut pm1 := _big_new(pbig.n + 4)
mut qm1 := _big_new(qbig.n + 4)
ok := _big_sub(pm1, pbig, one) and _big_sub(qm1, qbig, one)
mut phi := _big_new(pm1.n + qm1.n + 4)
mut out := NewBuf(1)
if ok:
_big_mul(phi, pm1, qm1)
philen := _big_bytelen(phi)
FreeBuf(out)
out = NewBuf(philen)
BufPutZeros(out, philen)
_tobytes_ok := _big_to_bytes(phi, out.p, philen)
end
_big_free(pbig)
_big_free(qbig)
_big_free(one)
_big_free(pm1)
_big_free(qm1)
_big_free(phi)
ret out
end
func _parse_openssh_body(r &: Reader): Identity:
mut magic := NewBuf(_OPENSSH_MAGIC.len() + 1)
repeat _OPENSSH_MAGIC.len() + 1:
BufPutByte(magic, RGetByte(r))
end
magic_ok := not r.bad and ConstantTimeEqual(magic.p, _OPENSSH_MAGIC as void*, _OPENSSH_MAGIC.len())
FreeBuf(magic)
if not magic_ok:
ret _identity_bad()
end
_ciphername := RGetStringAsStr(r)
_kdfname := RGetStringAsStr(r)
_kdfopts := RGetStringView(r)
nkeys := RGetUint32(r) as int
if r.bad or nkeys != 1 or not str.Equals(_ciphername, "none"):
ret _identity_bad()
end
_pubblob := RGetStringView(r)
priv := RGetStringView(r)
if r.bad:
ret _identity_bad()
end
mut pr := priv
check1 := RGetUint32(pr)
check2 := RGetUint32(pr)
if pr.bad or check1 != check2:
ret _identity_bad()
end
keytype := RGetStringAsStr(pr)
if not str.Equals(keytype, "ssh-rsa"):
ret _identity_bad()
end
n := RGetMpintCopy(pr)
e := RGetMpintCopy(pr)
d := RGetMpintCopy(pr)
_iqmp := RGetMpintCopy(pr)
p := RGetMpintCopy(pr)
q := RGetMpintCopy(pr)
if pr.bad:
FreeBuf(n)
FreeBuf(e)
WipeBuf(d)
WipeBuf(_iqmp)
WipeBuf(p)
WipeBuf(q)
ret _identity_bad()
end
mut id := Identity {}
id.n = n
id.e = e
id.d = d
id.phi = _phi_from_pq(p, q)
id.ok = id.phi.len > 0
WipeBuf(p)
WipeBuf(q)
WipeBuf(_iqmp)
if not id.ok:
_identity_free(id)
ret _identity_bad()
end
ret id
end
func _load_openssh(pem: str): Identity:
begintag := "-----BEGIN OPENSSH PRIVATE KEY-----"
endtag := "-----END OPENSSH PRIVATE KEY-----"
b := pem.find(begintag)
if b < 0:
ret _identity_bad()
end
bodystart := b + begintag.len()
e := str.IndexFrom(pem, endtag, bodystart)
if e < 0:
ret _identity_bad()
end
b64 := pem.substr(bodystart, e - bodystart)
room := b64.len() / 4 * 3 + 8
mut der := NewBuf(room)
BufPutZeros(der, room)
mut good := false
got := encoding.Base64DecodeBytes(b64, der.p, room, good)
if not good or got <= 0:
FreeBuf(der)
ret _identity_bad()
end
mut r := NewReader(der.p, got)
id := _parse_openssh_body(r)
FreeBuf(der)
ret id
end
func _load_identity_pem(pem: str): Identity:
if str.Contains(pem, "OPENSSH PRIVATE KEY"):
ret _load_openssh(pem)
end
ret _load_pem(pem)
end
func _load_identity_file(path: str): Identity:
if not os.Exists(path):
ret _identity_bad()
end
pem := io.ReadFile(path)
ret _load_identity_pem(pem)
end
package ssh
import crypto
const SSH_HASH_SHA1 := 0
const SSH_HASH_SHA256 := 1
const SSH_HASH_SHA512 := 2
const SSH_RSA_MAX_BYTES := 1024
func _rsa_hash_size(kind: int): int:
if kind == SSH_HASH_SHA1:
ret 20
end
if kind == SSH_HASH_SHA512:
ret 64
end
ret 32
end
func _rsa_digestinfo(kind: int): str:
if kind == SSH_HASH_SHA1:
ret "3021300906052b0e03021a05000414"
end
if kind == SSH_HASH_SHA512:
ret "3051300d060960864801650304020305000440"
end
ret "3031300d060960864801650304020105000420"
end
func _rsa_public_op(sig: void*, siglen: int, nmod: void*, nlen: int, expo: void*, elen: int, out: void*, klen: int): bool:
mut n := _big_from_bytes(nmod, nlen)
mut e := _big_from_bytes(expo, elen)
mut s := _big_from_bytes(sig, siglen)
mut ok := not n.bad and not e.bad and not s.bad and not _big_is_zero(n) and not _big_is_zero(e)
if ok and _big_cmp(s, n) >= 0:
ok = false
end
mut m := _big_new(n.n + 4)
if ok:
ok = _big_modexp_barrett(m, s, e, n)
end
if ok:
ok = _big_to_bytes(m, out, klen)
end
_big_free(n)
_big_free(e)
_big_free(s)
_big_free(m)
ret ok
end
func _rsa_verify_pkcs1(kind: int, digest: void*, nmod: void*, nlen: int, expo: void*, elen: int, sig: void*, siglen: int): bool:
klen := nlen
if klen < 16 or klen > SSH_RSA_MAX_BYTES or siglen != klen:
ret false
end
hlen := _rsa_hash_size(kind)
mut di := _hexbuf(_rsa_digestinfo(kind))
mut want := NewBuf(klen)
tlen := di.len + hlen
mut ok := klen >= tlen + 11
if ok:
BufPutByte(want, 0x00)
BufPutByte(want, 0x01)
pslen := klen - tlen - 3
repeat pslen:
BufPutByte(want, 0xFF)
end
BufPutByte(want, 0x00)
BufPutBuf(want, di)
BufPutBytes(want, digest, hlen)
end
mut got := NewBuf(klen)
BufPutZeros(got, klen)
if ok:
ok = _rsa_public_op(sig, siglen, nmod, nlen, expo, elen, got.p, klen)
end
result := ok and ConstantTimeEqual(got.p, want.p, klen)
FreeBuf(di)
FreeBuf(want)
FreeBuf(got)
ret result
end
func _rsa_private_op_blinded(msg: void*, mlen: int, nmod: void*, nlen: int, dexp: void*, dlen: int, eexp: void*, elen: int, phi: void*, philen: int, out: void*, klen: int): bool:
mut n := _big_from_bytes(nmod, nlen)
mut e := _big_from_bytes(eexp, elen)
mut d := _big_from_bytes(dexp, dlen)
mut ph := _big_from_bytes(phi, philen)
mut m := _big_from_bytes(msg, mlen)
mut ok := not n.bad and not e.bad and not d.bad and not ph.bad and not m.bad and not _big_is_zero(n) and _big_cmp(m, n) < 0
mut rbytes := NewBuf(nlen)
if ok:
BufPutZeros(rbytes, nlen)
crypto.RandomBytes(rbytes.p, nlen)
end
mut rraw := _big_from_bytes(rbytes.p, rbytes.len)
mut r := _big_new(n.n + 4)
if ok:
ok = not rraw.bad and _big_mod(r, rraw, n) and not _big_is_zero(r)
end
mut re := _big_new(n.n + 4)
if ok:
ok = _big_modexp_barrett(re, r, e, n)
end
mut prod := _big_new(2 * n.n + 8)
mut blinded := _big_new(n.n + 4)
if ok:
_big_mul(prod, m, re)
ok = not prod.bad and _big_mod(blinded, prod, n)
end
mut s := _big_new(n.n + 4)
if ok:
ok = _big_modexp_barrett(s, blinded, d, n)
end
mut one := _big_new(1)
_big_set_u32(one, 1 as u32)
mut phim1 := _big_new(ph.n + 4)
mut rinv := _big_new(n.n + 4)
if ok:
ok = _big_sub(phim1, ph, one) and _big_modexp_barrett(rinv, r, phim1, n)
end
mut prod2 := _big_new(2 * n.n + 8)
mut result := _big_new(n.n + 4)
if ok:
_big_mul(prod2, s, rinv)
ok = not prod2.bad and _big_mod(result, prod2, n)
end
if ok:
ok = _big_to_bytes(result, out, klen)
end
_big_free(n)
_big_free(e)
_big_wipe_free(d)
_big_wipe_free(ph)
_big_free(m)
WipeBuf(rbytes)
_big_wipe_free(rraw)
_big_wipe_free(r)
_big_free(re)
_big_free(prod)
_big_wipe_free(blinded)
_big_wipe_free(s)
_big_free(one)
_big_wipe_free(phim1)
_big_wipe_free(rinv)
_big_free(prod2)
_big_wipe_free(result)
ret ok
end
func _rsa_sign_pkcs1(kind: int, digest: void*, n: Buf, e: Buf, d: Buf, phi: Buf, sigout: void*): bool:
klen := n.len
if klen < 16 or klen > SSH_RSA_MAX_BYTES:
ret false
end
hlen := _rsa_hash_size(kind)
mut di := _hexbuf(_rsa_digestinfo(kind))
tlen := di.len + hlen
mut ok := klen >= tlen + 11
mut em := NewBuf(klen)
if ok:
BufPutByte(em, 0x00)
BufPutByte(em, 0x01)
pslen := klen - tlen - 3
repeat pslen:
BufPutByte(em, 0xFF)
end
BufPutByte(em, 0x00)
BufPutBuf(em, di)
BufPutBytes(em, digest, hlen)
ok = _rsa_private_op_blinded(em.p, em.len, n.p, n.len, d.p, d.len, e.p, e.len, phi.p, phi.len, sigout, klen)
end
FreeBuf(di)
FreeBuf(em)
ret ok
end
package ssh
mut _ssh_st_fails := 0
mut _ssh_st_total := 0
func _ck(cond: bool, name: str):
_ssh_st_total += 1
if not cond:
_ssh_st_fails += 1
println "  FAIL:", name
end
end
func _ckhex(got: str, want: str, name: str):
_ssh_st_total += 1
if got != want:
_ssh_st_fails += 1
println "  FAIL:", name
println "    got  ", got
println "    want ", want
end
end
func _hex_of(p: void*, n: int): str:
mut out := ""
repeat n in i:
v := _bget(p, i)
out = out.concat(_hex_byte(v))
end
ret out
end
func _hex_byte(v: int): str:
digits := "0123456789abcdef"
hi := (v >> 4) & 0xF
lo := v & 0xF
mut out := ""
out = out.concat(digits.substr(hi, 1))
out = out.concat(digits.substr(lo, 1))
ret out
end
func _hexnibble(c: int): int:
if c >= 48 and c <= 57:
ret c - 48
end
if c >= 97 and c <= 102:
ret c - 97 + 10
end
if c >= 65 and c <= 70:
ret c - 65 + 10
end
ret 0
end
func _hexbuf(hex: str): Buf:
n := hex.len() / 2
mut out := NewBuf(n)
p := hex as void*
repeat n in i:
hi := _hexnibble(_bget(p, 2 * i))
lo := _hexnibble(_bget(p, 2 * i + 1))
BufPutByte(out, (hi << 4) | lo)
end
ret out
end
@en "SelfTest"
@fa "خودآزمایی"
pub func SelfTest(): int:
_ssh_st_fails = 0
_ssh_st_total = 0
println "ssh self-test"
_selftest_bigint()
_selftest_x25519()
_selftest_dh()
_selftest_aes()
_selftest_mac()
_selftest_rsa()
_selftest_bytes()
_selftest_algorithms()
_selftest_kdf()
_selftest_hostkey()
_selftest_knownhosts()
_selftest_privatekey()
_selftest_sftp()
_selftest_packet()
if _ssh_st_fails == 0:
println "ssh self-test:", _ssh_st_total, "checks passed"
else:
println "ssh self-test:", _ssh_st_fails, "of", _ssh_st_total, "checks FAILED"
end
ret _ssh_st_fails
end
package ssh
func _selftest_aes():
mut key128 := _hexbuf("000102030405060708090a0b0c0d0e0f")
mut pt := _hexbuf("00112233445566778899aabbccddeeff")
_ck(key128.len == 16, "aes: 128-bit key is 16 bytes")
_ck(pt.len == 16, "aes: test block is 16 bytes")
a128 := _aes_init(key128.p, 16)
_ck(a128.nr == 10, "aes-128: key schedule has 10 rounds")
mut ct128 := NewBuf(16)
BufPutZeros(ct128, 16)
_aes_encrypt_block(a128, pt.p, ct128.p)
_ckhex(_hex_of(ct128.p, 16), "69c4e0d86a7b0430d8cdb78070b4c55a", "aes-128: FIPS-197 worked example")
mut key256 := _hexbuf("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f")
_ck(key256.len == 32, "aes: 256-bit key is 32 bytes")
a256 := _aes_init(key256.p, 32)
_ck(a256.nr == 14, "aes-256: key schedule has 14 rounds")
mut ct256 := NewBuf(16)
BufPutZeros(ct256, 16)
_aes_encrypt_block(a256, pt.p, ct256.p)
_ckhex(_hex_of(ct256.p, 16), "8ea2b7ca516745bfeafc49904b496089", "aes-256: openssl cross-check")
mut ctrkey := _hexbuf("2b7e151628aed2a6abf7158809cf4f3c")
mut ctr_pt := _hexbuf("74686520717569636b2062726f776e20666f7820313233343536373839303132")
_ck(ctr_pt.len == 32, "aes-ctr: test plaintext is 32 bytes (2 full blocks)")
a_ctr := _aes_init(ctrkey.p, 16)
mut counter := _hexbuf("f0f1f2f3f4f5f6f7f8f9fafbfcfdfeff")
mut ctr_ct := NewBuf(ctr_pt.len)
BufPutZeros(ctr_ct, ctr_pt.len)
_aes_ctr_xor(a_ctr, counter, ctr_pt.p, ctr_pt.len, ctr_ct.p)
_ckhex(_hex_of(ctr_ct.p, ctr_ct.len), "98e4ba53e91515d399f2740785e9cfc45044041c564162572d9640efc560429c", "aes-128-ctr: openssl cross-check")
mut counter2 := _hexbuf("f0f1f2f3f4f5f6f7f8f9fafbfcfdfeff")
mut roundtrip := NewBuf(ctr_ct.len)
BufPutZeros(roundtrip, ctr_ct.len)
_aes_ctr_xor(a_ctr, counter2, ctr_ct.p, ctr_ct.len, roundtrip.p)
_ckhex(_hex_of(roundtrip.p, roundtrip.len), _hex_of(ctr_pt.p, ctr_pt.len), "aes-128-ctr: decrypt(encrypt(x)) == x")
mut counter3 := _hexbuf("f0f1f2f3f4f5f6f7f8f9fafbfcfdfeff")
mut partial_pt := _hexbuf("7061727469616c20626c6f636b20746573742121")
_ck(partial_pt.len == 20, "aes-ctr: partial-block test plaintext is 20 bytes")
mut partial_ct := NewBuf(20)
BufPutZeros(partial_ct, 20)
_aes_ctr_xor(a_ctr, counter3, partial_pt.p, 20, partial_ct.p)
_ckhex(_hex_of(partial_ct.p, 20), "9cedad07f101109090be791681bed581455f5d1d", "aes-128-ctr: partial final block")
mut allff := NewBuf(16)
repeat 16:
BufPutByte(allff, 0xFF)
end
_ctr_increment(allff)
mut allzero := NewBuf(16)
BufPutZeros(allzero, 16)
_ckhex(_hex_of(allff.p, 16), _hex_of(allzero.p, 16), "aes-ctr: 0xff..ff counter wraps to 0x00..00")
FreeBuf(key128)
FreeBuf(pt)
FreeBuf(ct128)
FreeBuf(key256)
FreeBuf(ct256)
FreeBuf(ctrkey)
FreeBuf(ctr_pt)
FreeBuf(counter)
FreeBuf(ctr_ct)
FreeBuf(counter2)
FreeBuf(roundtrip)
FreeBuf(allff)
FreeBuf(allzero)
FreeBuf(counter3)
FreeBuf(partial_pt)
FreeBuf(partial_ct)
end
package ssh
func _selftest_algorithms():
_ck(_cipher_key_len(CIPHER_AES128_CTR) == 16, "algorithms: aes128-ctr key length is 16 bytes")
_ck(_cipher_key_len(CIPHER_AES256_CTR) == 32, "algorithms: aes256-ctr key length is 32 bytes")
_ck(_cipher_iv_len(CIPHER_AES128_CTR) == 16, "algorithms: aes128-ctr IV length is 16 bytes")
_ck(_cipher_iv_len(CIPHER_AES256_CTR) == 16, "algorithms: aes256-ctr IV length is 16 bytes")
_ck(_mac_kind_for(MAC_HMAC_SHA256) == MAC_SHA256, "algorithms: hmac-sha2-256 maps to MAC_SHA256")
_ck(_mac_kind_for(MAC_HMAC_SHA1) == MAC_SHA1, "algorithms: hmac-sha1 maps to MAC_SHA1")
_ck(_mac_key_len(MAC_HMAC_SHA256) == 32, "algorithms: hmac-sha2-256 key length is 32 bytes")
_ck(_mac_key_len(MAC_HMAC_SHA1) == 20, "algorithms: hmac-sha1 key length is 20 bytes")
_ck(_kex_uses_sha256(KEX_CURVE25519), "algorithms: curve25519-sha256 uses SHA-256 for the exchange hash")
_ck(_kex_uses_sha256(KEX_DH14_SHA256), "algorithms: diffie-hellman-group14-sha256 uses SHA-256")
_ck(not _kex_uses_sha256(KEX_DH14_SHA1), "algorithms: diffie-hellman-group14-sha1 uses SHA-1, not SHA-256")
_ck(_kex_is_curve25519(KEX_CURVE25519), "algorithms: curve25519-sha256 is recognized as curve25519")
_ck(_kex_is_curve25519(KEX_CURVE25519_LIBSSH), "algorithms: the @libssh.org alias is also recognized as curve25519")
_ck(not _kex_is_curve25519(KEX_DH14_SHA256), "algorithms: group14 is not misclassified as curve25519")
end
package ssh
func _bighex(x: Big): str:
n := _big_bytelen(x)
if n == 0:
ret "00"
end
mut o := NewBuf(n)
BufPutZeros(o, n)
ok := _big_to_bytes(x, o.p, n)
if not ok:
FreeBuf(o)
ret "TOOBIG"
end
out := _hex_of(o.p, n)
FreeBuf(o)
ret out
end
func _bigof(hex: str): Big:
h := _hexbuf(hex)
x := _big_from_bytes(h.p, h.len)
FreeBuf(h)
ret x
end
func _selftest_bigint():
mut a := _bigof("123456789abcdef0fedcba9876543210")
mut b := _bigof("deadbeefcafebabe0123456789abcdef")
_ckhex(_bighex(a), "123456789abcdef0fedcba9876543210", "bigint: from/to bytes")
mut lz := _bigof("0000000000ff00")
_ckhex(_bighex(lz), "ff00", "bigint: strips leading zeros")
mut zero := _bigof("00")
_ck(_big_is_zero(zero), "bigint: zero detected")
_ck(_big_bitlen(zero) == 0, "bigint: zero bitlen")
_ck(_big_cmp(a, b) < 0, "bigint: cmp a<b")
_ck(_big_cmp(b, a) > 0, "bigint: cmp b>a")
_ck(_big_cmp(a, a) == 0, "bigint: cmp a==a")
mut x2 := _bigof("02")
mut x3 := _bigof("03")
mut sum := _big_new(2)
_big_add(sum, x2, x3)
_ckhex(_bighex(sum), "05", "bigint: 2+3=5")
mut x10 := _bigof("0a")
mut x4 := _bigof("04")
mut diff := _big_new(2)
_ok_sub := _big_sub(diff, x10, x4)
_ck(_ok_sub, "bigint: 10-4 ok")
_ckhex(_bighex(diff), "06", "bigint: 10-4=6")
mut x6 := _bigof("06")
mut x7 := _bigof("07")
mut prod := _big_new(4)
_big_mul(prod, x6, x7)
_ckhex(_bighex(prod), "2a", "bigint: 6*7=42")
mut x17 := _bigof("11")
mut x5 := _bigof("05")
mut rem := _big_new(2)
_ok_mod := _big_mod(rem, x17, x5)
_ck(_ok_mod, "bigint: 17 mod 5 ok")
_ckhex(_bighex(rem), "02", "bigint: 17 mod 5 = 2")
mut base := _bigof("04")
mut expo := _bigof("0d")
mut modu := _bigof("01f1")
mut result := _big_new(4)
_ok_exp := _big_modexp(result, base, expo, modu)
_ck(_ok_exp, "bigint: modexp ok")
_ckhex(_bighex(result), "01bd", "bigint: 4^13 mod 497 = 445")
mut result_bt := _big_new(4)
_ok_bt := _big_modexp_barrett(result_bt, base, expo, modu)
_ck(_ok_bt, "bigint: barrett modexp ok")
_ckhex(_bighex(result_bt), "01bd", "bigint: barrett 4^13 mod 497 = 445")
mut bigbase := _bigof("9a8b7c6d5e4f30211f2e3d4c5b6a798897a6b5c4d3e2f1009182736455647382")
mut bigexpo := _bigof("010203040506070809")
mut bigmod := _bigof("d1e2f30415263748596a7b8c9daebfc011223344556677889900aabbccddeef1")
mut r_plain := _big_new(40)
mut r_bt := _big_new(40)
_ok_p := _big_modexp(r_plain, bigbase, bigexpo, bigmod)
_ok_b := _big_modexp_barrett(r_bt, bigbase, bigexpo, bigmod)
_ck(_ok_p and _ok_b, "bigint: large modexp (plain+barrett) ok")
_ckhex(_bighex(r_plain), _bighex(r_bt), "bigint: barrett agrees with plain modexp on a large case")
_big_free(result_bt)
_big_free(bigbase)
_big_free(bigexpo)
_big_free(bigmod)
_big_free(r_plain)
_big_free(r_bt)
mut g := _bigof("05")
mut xsec := _bigof("06")
mut order := _bigof("16")
mut p23 := _bigof("17")
mut blinded := _big_new(4)
mut rndbuf := _hexbuf("03")
_ok_bl := _big_modexp_blinded_dh(blinded, g, xsec, order, p23, rndbuf.p, rndbuf.len)
_ck(_ok_bl, "bigint: blinded modexp ok")
_ckhex(_bighex(blinded), "08", "bigint: blinded 5^6 mod 23 = 8")
_big_free(a)
_big_free(b)
_big_free(lz)
_big_free(zero)
_big_free(x2)
_big_free(x3)
_big_free(sum)
_big_free(x10)
_big_free(x4)
_big_free(diff)
_big_free(x6)
_big_free(x7)
_big_free(prod)
_big_free(x17)
_big_free(x5)
_big_free(rem)
_big_free(base)
_big_free(expo)
_big_free(modu)
_big_free(result)
_big_free(g)
_big_free(xsec)
_big_free(order)
_big_free(p23)
_big_free(blinded)
FreeBuf(rndbuf)
end
package ssh
import str
func _selftest_bytes():
mut b_small := NewBuf(1)
_ck(b_small.cap >= 32, "buf: NewBuf floors capacity at 32 bytes")
_ck(b_small.len == 0, "buf: NewBuf starts empty")
FreeBuf(b_small)
mut grown := NewBuf(4)
mut i := 0
until i < 300:
BufPutByte(grown, i & 0xFF)
i += 1
end
_ck(grown.len == 300, "buf: 300 single-byte appends land at len 300")
_ck(grown.cap >= 300, "buf: capacity grew to cover 300 bytes")
mut grow_ok := true
mut j := 0
until j < 300:
if _bget(grown.p, j) != (j & 0xFF):
grow_ok = false
end
j += 1
end
_ck(grow_ok, "buf: every byte written during growth reads back correctly")
FreeBuf(grown)
mut src := NewBuf(500)
repeat 500 in k:
BufPutByte(src, (k * 7) & 0xFF)
end
mut bulk := NewBuf(1)
BufPutBytes(bulk, src.p, src.len)
_ck(bulk.len == 500, "buf: single bulk append past many doublings lands at correct len")
_ckhex(_hex_of(bulk.p, 500), _hex_of(src.p, 500), "buf: bulk-appended bytes match source exactly")
FreeBuf(src)
FreeBuf(bulk)
mut u32b := NewBuf(4)
BufPutUint32(u32b, 0x01020304 as u32)
_ckhex(_hex_of(u32b.p, 4), "01020304", "buf: BufPutUint32 is big-endian")
mut ru32 := NewReader(u32b.p, u32b.len)
got32 := RGetUint32(ru32)
_ck(got32 == (0x01020304 as u32), "reader: RGetUint32 round-trips BufPutUint32")
FreeBuf(u32b)
mut u64b := NewBuf(8)
BufPutUint64(u64b, 0x0102030405060708 as u64)
_ckhex(_hex_of(u64b.p, 8), "0102030405060708", "buf: BufPutUint64 is big-endian")
mut ru64 := NewReader(u64b.p, u64b.len)
got64 := RGetUint64(ru64)
_ck(got64 == (0x0102030405060708 as u64), "reader: RGetUint64 round-trips BufPutUint64")
FreeBuf(u64b)
mut boolb := NewBuf(2)
BufPutBool(boolb, true)
BufPutBool(boolb, false)
_ckhex(_hex_of(boolb.p, 2), "0100", "buf: BufPutBool encodes true=1 false=0")
mut rbool := NewReader(boolb.p, boolb.len)
_ck(RGetBool(rbool) == true, "reader: RGetBool decodes true")
_ck(RGetBool(rbool) == false, "reader: RGetBool decodes false")
FreeBuf(boolb)
mut sb := NewBuf(16)
BufPutStringStr(sb, "ssh-rsa")
_ck(sb.len == 4 + 7, "buf: BufPutStringStr is 4-byte length prefix + bytes")
mut rs := NewReader(sb.p, sb.len)
name := RGetStringAsStr(rs)
_ck(str.Equals(name, "ssh-rsa"), "reader: RGetStringAsStr round-trips BufPutStringStr")
FreeBuf(sb)
mut binsrc := NewBuf(5)
BufPutByte(binsrc, 0xAA)
BufPutByte(binsrc, 0x00)
BufPutByte(binsrc, 0xBB)
BufPutByte(binsrc, 0x00)
BufPutByte(binsrc, 0xCC)
mut binb := NewBuf(16)
BufPutString(binb, binsrc.p, binsrc.len)
mut rbin := NewReader(binb.p, binb.len)
binview := RGetStringView(rbin)
_ck(binview.len == 5, "reader: RGetStringView preserves embedded-NUL length")
_ckhex(_hex_of(binview.p, 5), "aa00bb00cc", "reader: RGetStringView bytes survive embedded 0x00 untouched")
FreeBuf(binsrc)
FreeBuf(binb)
mut copysrc := NewBuf(16)
BufPutStringStr(copysrc, "copy-me")
mut rcopy := NewReader(copysrc.p, copysrc.len)
mut copied := RGetStringCopy(rcopy)
_ck(copied.len == 7, "reader: RGetStringCopy has the right length")
_ckhex(_hex_of(copied.p, 7), _hex_of(("copy-me" as void*), 7), "reader: RGetStringCopy content matches original")
FreeBuf(copysrc)
FreeBuf(copied)
mut mp0src := _hexbuf("000000")
mut mp0 := NewBuf(8)
BufPutMpintBytes(mp0, mp0src.p, mp0src.len)
_ckhex(_hex_of(mp0.p, 4), "00000000", "mpint: an all-zero magnitude encodes as length 0")
FreeBuf(mp0src)
FreeBuf(mp0)
mut mp1 := NewBuf(8)
BufPutMpintBytes(mp1, "\x01" as void*, 1)
_ckhex(_hex_of(mp1.p, mp1.len), "0000000101", "mpint: 0x01 needs no pad byte")
FreeBuf(mp1)
mut mp2 := NewBuf(8)
BufPutMpintBytes(mp2, "\x80" as void*, 1)
_ckhex(_hex_of(mp2.p, mp2.len), "000000020080", "mpint: 0x80 gets a leading 0x00 pad byte")
FreeBuf(mp2)
mut mp3src := _hexbuf("00000102")
mut mp3 := NewBuf(8)
BufPutMpintBytes(mp3, mp3src.p, mp3src.len)
_ckhex(_hex_of(mp3.p, mp3.len), "000000020102", "mpint: leading zero bytes in the source are stripped")
FreeBuf(mp3src)
FreeBuf(mp3)
mut mpbuf := NewBuf(8)
BufPutMpintBytes(mpbuf, "\x80" as void*, 1)
mut rmp := NewReader(mpbuf.p, mpbuf.len)
mpview := RGetMpintView(rmp)
_ck(mpview.len == 1, "reader: RGetMpintView strips the pad byte back off")
_ckhex(_hex_of(mpview.p, 1), "80", "reader: RGetMpintView magnitude matches the original byte")
FreeBuf(mpbuf)
mut short := NewBuf(2)
BufPutByte(short, 0xAB)
BufPutByte(short, 0xCD)
mut rshort := NewReader(short.p, short.len)
_first := RGetByte(rshort)
_second := RGetByte(rshort)
_ck(not rshort.bad, "reader: reading exactly the available bytes leaves .bad false")
third := RGetByte(rshort)
_ck(rshort.bad, "reader: reading past the end sets .bad")
_ck(third == 0, "reader: a read past the end returns 0, not garbage")
FreeBuf(short)
mut rskip := NewReader(short.p, 0)
RSkip(rskip, 5)
_ck(rskip.bad, "reader: RSkip past the end sets .bad")
_ck(NameListContains("ssh-rsa,rsa-sha2-256,rsa-sha2-512", "rsa-sha2-256"), "namelist: contains finds a middle entry")
_ck(not NameListContains("ssh-rsa,rsa-sha2-256", "ssh-ed25519"), "namelist: contains correctly rejects a missing entry")
_ck(not NameListContains("", "anything"), "namelist: contains on an empty list is always false")
firstmatch := NegotiateFirstMatch("curve25519-sha256,curve25519-sha256@libssh.org,diffie-hellman-group14-sha256", "diffie-hellman-group14-sha256,diffie-hellman-group14-sha1")
_ck(str.Equals(firstmatch, "diffie-hellman-group14-sha256"), "negotiate: first-of-mine-that-appears-in-theirs, skipping unsupported entries")
nomatch := NegotiateFirstMatch("aes128-ctr,aes256-ctr", "aes192-cbc,3des-cbc")
_ck(str.Equals(nomatch, ""), "negotiate: no overlap returns empty string")
preforder := NegotiateFirstMatch("hmac-sha2-256,hmac-sha1", "hmac-sha1,hmac-sha2-256")
_ck(str.Equals(preforder, "hmac-sha2-256"), "negotiate: my preference order wins even if theirs lists the other one first")
_ck(ConstantTimeEqual("identical" as void*, "identical" as void*, 9), "constanttime: identical byte ranges compare equal")
_ck(not ConstantTimeEqual("identicalX" as void*, "identicalY" as void*, 10), "constanttime: a single differing byte compares unequal")
end
package ssh
func _selftest_dh():
mut p := _dh14_prime()
_ck(_big_bitlen(p) == 2048, "dh14: group prime is 2048 bits")
_big_free(p)
alice := _dh14_generate()
bob := _dh14_generate()
_ck(alice.public.len > 0, "dh14: alice public value generated")
_ck(bob.public.len > 0, "dh14: bob public value generated")
_ck(_hex_of(alice.public.p, alice.public.len) != _hex_of(bob.public.p, bob.public.len), "dh14: two keypairs are not identical")
mut k_alice := _dh14_shared(alice.secret, bob.public)
mut k_bob := _dh14_shared(bob.secret, alice.public)
_ck(k_alice.len > 0, "dh14: alice computed a shared secret")
_ck(k_bob.len > 0, "dh14: bob computed a shared secret")
_ckhex(_hex_of(k_alice.p, k_alice.len), _hex_of(k_bob.p, k_bob.len), "dh14: shared secret agrees on both sides")
mut zero_peer := NewBuf(1)
BufPutByte(zero_peer, 0)
mut k_bad := _dh14_shared(alice.secret, zero_peer)
_ck(k_bad.len == 0, "dh14: degenerate peer public value (0) rejected")
FreeBuf(zero_peer)
FreeBuf(k_bad)
FreeBuf(k_alice)
FreeBuf(k_bob)
FreeBuf(alice.secret)
FreeBuf(alice.public)
FreeBuf(bob.secret)
FreeBuf(bob.public)
end
package ssh
import str
import crypto
import encoding
func _selftest_hostkey():
mut n := _hexbuf(_RSA_TV_N)
mut e := _hexbuf(_RSA_TV_E)
mut d := _hexbuf(_RSA_TV_D)
mut phi := _hexbuf(_RSA_TV_PHI)
mut blob := NewBuf(8 + n.len)
BufPutStringStr(blob, "ssh-rsa")
BufPutMpintBuf(blob, e)
BufPutMpintBuf(blob, n)
mut hk := _hostkey_parse(blob)
_ck(hk.ok, "hostkey: parses a well-formed ssh-rsa key blob")
_ck(hk.n.len == n.len, "hostkey: parsed modulus length matches the source key")
_ckhex(_hex_of(hk.n.p, hk.n.len), _hex_of(n.p, n.len), "hostkey: parsed modulus bytes match the source key exactly")
_ckhex(_hex_of(hk.e.p, hk.e.len), _hex_of(e.p, e.len), "hostkey: parsed exponent bytes match the source key exactly")
_ck(hk.blob.len == blob.len, "hostkey: .blob keeps the original wire bytes verbatim")
mut badtype := NewBuf(8)
BufPutStringStr(badtype, "ssh-ed25519")
badhk := _hostkey_parse(badtype)
_ck(not badhk.ok, "hostkey: an unsupported key type (ssh-ed25519) is rejected, not misparsed")
FreeBuf(badtype)
mut truncated := NewBuf(8)
BufPutStringStr(truncated, "ssh-rsa")
trunchk := _hostkey_parse(truncated)
_ck(not trunchk.ok, "hostkey: a truncated blob (missing e/n) is rejected")
FreeBuf(truncated)
mut small_n := NewBuf(64)
repeat 64:
BufPutByte(small_n, 255)
end
mut small := NewBuf(96)
BufPutStringStr(small, "ssh-rsa")
BufPutMpintBuf(small, e)
BufPutMpintBuf(small, small_n)
smallhk := _hostkey_parse(small)
_ck(not smallhk.ok, "hostkey: a 512-bit modulus is rejected")
FreeBuf(small)
FreeBuf(small_n)
mut big_n := NewBuf(2100)
repeat 2100:
BufPutByte(big_n, 255)
end
mut big := NewBuf(2200)
BufPutStringStr(big, "ssh-rsa")
BufPutMpintBuf(big, e)
BufPutMpintBuf(big, big_n)
bighk := _hostkey_parse(big)
_ck(not bighk.ok, "hostkey: a modulus over 16384 bits is rejected")
FreeBuf(big)
FreeBuf(big_n)
each ev in [2, 1]:
mut bad_e := NewBuf(1)
BufPutByte(bad_e, ev)
mut be := NewBuf(8 + n.len)
BufPutStringStr(be, "ssh-rsa")
BufPutMpintBuf(be, bad_e)
BufPutMpintBuf(be, n)
behk := _hostkey_parse(be)
_ck(not behk.ok, "hostkey: an even or trivial public exponent is rejected")
FreeBuf(be)
FreeBuf(bad_e)
end
mut h := _hexbuf("0102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f")
mut digest256 := NewBuf(32)
BufPutZeros(digest256, 32)
crypto.Sha256Bytes(h.p, h.len, digest256.p)
mut sig256 := NewBuf(n.len)
BufPutZeros(sig256, n.len)
signed256 := _rsa_sign_pkcs1(SSH_HASH_SHA256, digest256.p, n, e, d, phi, sig256.p)
_ck(signed256, "hostkey: (setup) sign H's SHA-256 digest for the rsa-sha2-256 case")
mut sigblob256 := NewBuf(8 + sig256.len)
BufPutStringStr(sigblob256, "rsa-sha2-256")
BufPutStringBuf(sigblob256, sig256)
_ck(_hostkey_verify(hk, h, sigblob256), "hostkey: verifies a valid rsa-sha2-256 signature over H")
mut htampered := NewBuf(h.len)
BufPutBytes(htampered, h.p, h.len)
_bput(htampered.p, 0, _bget(htampered.p, 0) ^ 0x01)
_ck(not _hostkey_verify(hk, htampered, sigblob256), "hostkey: a tampered exchange hash fails verification")
FreeBuf(htampered)
mut digest1 := NewBuf(20)
BufPutZeros(digest1, 20)
crypto.Sha1Bytes(h.p, h.len, digest1.p)
mut sig1 := NewBuf(n.len)
BufPutZeros(sig1, n.len)
signed1 := _rsa_sign_pkcs1(SSH_HASH_SHA1, digest1.p, n, e, d, phi, sig1.p)
_ck(signed1, "hostkey: (setup) sign H's SHA-1 digest for the ssh-rsa case")
mut sigblob1 := NewBuf(8 + sig1.len)
BufPutStringStr(sigblob1, "ssh-rsa")
BufPutStringBuf(sigblob1, sig1)
_ck(_hostkey_verify(hk, h, sigblob1), "hostkey: verifies a valid ssh-rsa (SHA-1) signature over H")
mut mislabeled := NewBuf(8 + sig256.len)
BufPutStringStr(mislabeled, "ssh-rsa")
BufPutStringBuf(mislabeled, sig256)
_ck(not _hostkey_verify(hk, h, mislabeled), "hostkey: a sha2-256 signature mislabeled as ssh-rsa (sha1) does not verify")
FreeBuf(mislabeled)
mut want_digest := NewBuf(32)
BufPutZeros(want_digest, 32)
crypto.Sha256Bytes(hk.blob.p, hk.blob.len, want_digest.p)
want_b64 := encoding.Base64EncodeBytes(want_digest.p, 32)
mut want_trimmed := want_b64
until str.EndsWith(want_trimmed, "="):
want_trimmed = want_trimmed.substr(0, want_trimmed.len() - 1)
end
want_fp := "SHA256:" + want_trimmed
got_fp := _hostkey_fingerprint(hk)
_ck(str.Equals(got_fp, want_fp), "hostkey: fingerprint matches an independently recomputed SHA256/base64 value")
_ck(str.StartsWith(got_fp, "SHA256:"), "hostkey: fingerprint carries the SHA256: prefix ssh-keygen -lf uses")
_ck(not str.Contains(got_fp, "="), "hostkey: fingerprint base64 has padding stripped")
FreeBuf(want_digest)
FreeBuf(n)
FreeBuf(e)
WipeBuf(d)
WipeBuf(phi)
FreeBuf(blob)
FreeBuf(h)
FreeBuf(digest256)
FreeBuf(sig256)
FreeBuf(sigblob256)
FreeBuf(digest1)
FreeBuf(sig1)
FreeBuf(sigblob1)
_hostkey_free(hk)
end
package ssh
import crypto
func _selftest_kdf():
mut k_mpint := _hexbuf("0000002000112233445566778899aabbccddeeff0011223344556677889900")
mut h := _hexbuf("aabbccddeeff00112233445566778899900112233445566778899aabbccdd")
mut session_id := _hexbuf("deadbeefcafebabe0011223344556677889900112233445566778899aabbcc")
mut manual1 := NewBuf(k_mpint.len + h.len + 1 + session_id.len)
BufPutBuf(manual1, k_mpint)
BufPutBuf(manual1, h)
BufPutByte(manual1, KDF_KEY_CTOS)
BufPutBuf(manual1, session_id)
mut want1 := NewBuf(32)
BufPutZeros(want1, 32)
crypto.Sha256Bytes(manual1.p, manual1.len, want1.p)
FreeBuf(manual1)
mut got1 := _derive_key(true, k_mpint, h, session_id, KDF_KEY_CTOS, 32)
_ck(got1.len == 32, "kdf: sha256 single-block derive returns exactly the requested length")
_ckhex(_hex_of(got1.p, 32), _hex_of(want1.p, 32), "kdf: sha256 single-block matches HASH(K||H||letter||session_id) directly")
FreeBuf(got1)
FreeBuf(want1)
mut manual1a := NewBuf(k_mpint.len + h.len + 1 + session_id.len)
BufPutBuf(manual1a, k_mpint)
BufPutBuf(manual1a, h)
BufPutByte(manual1a, KDF_IV_CTOS)
BufPutBuf(manual1a, session_id)
mut want1a := NewBuf(20)
BufPutZeros(want1a, 20)
crypto.Sha1Bytes(manual1a.p, manual1a.len, want1a.p)
FreeBuf(manual1a)
mut got1a := _derive_key(false, k_mpint, h, session_id, KDF_IV_CTOS, 20)
_ck(got1a.len == 20, "kdf: sha1 single-block derive returns exactly the requested length")
_ckhex(_hex_of(got1a.p, 20), _hex_of(want1a.p, 20), "kdf: sha1 single-block matches HASH(K||H||letter||session_id) directly")
FreeBuf(got1a)
FreeBuf(want1a)
needed := 40
mut block1in := NewBuf(k_mpint.len + h.len + 1 + session_id.len)
BufPutBuf(block1in, k_mpint)
BufPutBuf(block1in, h)
BufPutByte(block1in, KDF_MAC_CTOS)
BufPutBuf(block1in, session_id)
mut k1 := NewBuf(32)
BufPutZeros(k1, 32)
crypto.Sha256Bytes(block1in.p, block1in.len, k1.p)
FreeBuf(block1in)
mut block2in := NewBuf(k_mpint.len + h.len + k1.len)
BufPutBuf(block2in, k_mpint)
BufPutBuf(block2in, h)
BufPutBuf(block2in, k1)
mut k2 := NewBuf(32)
BufPutZeros(k2, 32)
crypto.Sha256Bytes(block2in.p, block2in.len, k2.p)
FreeBuf(block2in)
mut want2 := NewBuf(needed)
BufPutBytes(want2, k1.p, 32)
BufPutBytes(want2, k2.p, needed - 32)
FreeBuf(k1)
FreeBuf(k2)
mut got2 := _derive_key(true, k_mpint, h, session_id, KDF_MAC_CTOS, needed)
_ck(got2.len == needed, "kdf: extension-block derive returns exactly the requested length")
_ckhex(_hex_of(got2.p, needed), _hex_of(want2.p, needed), "kdf: extension block matches K1 || HASH(K||H||K1) truncated to length")
FreeBuf(got2)
FreeBuf(want2)
mut a := _derive_key(true, k_mpint, h, session_id, KDF_KEY_CTOS, 16)
mut b := _derive_key(true, k_mpint, h, session_id, KDF_KEY_STOC, 16)
_ck(not (a.len == b.len and ConstantTimeEqual(a.p, b.p, 16)), "kdf: different letters (C-to-S vs S-to-C) derive different keys")
FreeBuf(a)
FreeBuf(b)
FreeBuf(k_mpint)
FreeBuf(h)
FreeBuf(session_id)
end
package ssh
import str
import os
import io
func _selftest_knownhosts():
_ck(str.Equals(_knownhosts_hostpattern("example.com", 22), "example.com"), "knownhosts: default port 22 uses the bare hostname")
_ck(str.Equals(_knownhosts_hostpattern("example.com", 2222), "[example.com]:2222"), "knownhosts: a non-default port is bracketed OpenSSH-style")
_ck(_knownhosts_line_matches_host("host1.com,host2.com", "host2.com"), "knownhosts: line-matches finds a host in a comma-separated list")
_ck(not _knownhosts_line_matches_host("host1.com,host2.com", "host3.com"), "knownhosts: line-matches rejects a host not in the list")
_ck(not _knownhosts_line_matches_host("|1|abcd1234|deadbeef==", "example.com"), "knownhosts: a hashed entry (starts with '|') is never matched")
_ck(not _knownhosts_line_matches_host("", "example.com"), "knownhosts: an empty host field never matches")
dir := os.TempDir()
path := dir + "/salam_ssh_selftest_known_hosts"
mut content := ""
content = content + "# a comment line, must be skipped\n"
content = content + "\n"
content = content + "otherhost.example ssh-rsa AAAAOTHERHOSTKEY==\n"
content = content + "example.com ssh-rsa AAAAEXAMPLEKEYA==\n"
content = content + "|1|c29tZXNhbHQ=|c29tZWhhc2g= ssh-rsa AAAAHASHEDKEY==\n"
content = content + "[example.com]:2222 ssh-rsa AAAAEXAMPLEKEYB==\n"
_wrote := io.WriteFile(path, content)
r_match := _knownhosts_check(path, "example.com", 22, "ssh-rsa", "AAAAEXAMPLEKEYA==")
_ck(r_match == KH_MATCH, "knownhosts: check() reports MATCH for a byte-identical known key")
r_mismatch := _knownhosts_check(path, "example.com", 22, "ssh-rsa", "AAAADIFFERENTKEY==")
_ck(r_mismatch == KH_MISMATCH, "knownhosts: check() reports MISMATCH when the host is known under a different key")
r_unknown := _knownhosts_check(path, "neverseen.example", 22, "ssh-rsa", "AAAAEXAMPLEKEYA==")
_ck(r_unknown == KH_UNKNOWN, "knownhosts: check() reports UNKNOWN for a host not in the file")
r_customport := _knownhosts_check(path, "example.com", 2222, "ssh-rsa", "AAAAEXAMPLEKEYB==")
_ck(r_customport == KH_MATCH, "knownhosts: check() matches a [host]:port entry on a non-default port")
r_hashed_ignored := _knownhosts_check(path, "example.com", 22, "ssh-rsa", "AAAAHASHEDKEY==")
_ck(r_hashed_ignored == KH_MISMATCH or r_hashed_ignored == KH_MATCH, "knownhosts: (sanity) a hashed-entry-only key never independently causes MISMATCH against the plain entry")
_ck(r_hashed_ignored == KH_MISMATCH, "knownhosts: a hashed entry is skipped, so looking up its key against the plain entry is a MISMATCH, not a MATCH")
r_missing_file := _knownhosts_check(dir + "/salam_ssh_selftest_does_not_exist", "example.com", 22, "ssh-rsa", "AAAAEXAMPLEKEYA==")
_ck(r_missing_file == KH_UNKNOWN, "knownhosts: check() against a nonexistent file reports UNKNOWN, not an error")
_removed := os.Remove(path)
path2 := dir + "/salam_ssh_selftest_known_hosts_append"
_removed_before := os.Remove(path2)
appended := _knownhosts_append(path2, "fresh.example", 22, "ssh-rsa", "AAAAFRESHKEY==")
_ck(appended, "knownhosts: append() reports success")
r_after_append := _knownhosts_check(path2, "fresh.example", 22, "ssh-rsa", "AAAAFRESHKEY==")
_ck(r_after_append == KH_MATCH, "knownhosts: a freshly appended entry is found by check() immediately after")
_removed2 := os.Remove(path2)
_ck(_knownhosts_decide(HOSTKEY_MODE_INSECURE, KH_MISMATCH), "knownhosts: INSECURE mode proceeds even on MISMATCH")
_ck(_knownhosts_decide(HOSTKEY_MODE_INSECURE, KH_UNKNOWN), "knownhosts: INSECURE mode proceeds on UNKNOWN")
_ck(_knownhosts_decide(HOSTKEY_MODE_STRICT, KH_MATCH), "knownhosts: STRICT mode proceeds on MATCH")
_ck(not _knownhosts_decide(HOSTKEY_MODE_STRICT, KH_UNKNOWN), "knownhosts: STRICT mode refuses an UNKNOWN host")
_ck(not _knownhosts_decide(HOSTKEY_MODE_STRICT, KH_MISMATCH), "knownhosts: STRICT mode refuses a MISMATCH")
_ck(_knownhosts_decide(HOSTKEY_MODE_ACCEPT_NEW, KH_MATCH), "knownhosts: ACCEPT_NEW proceeds on MATCH")
_ck(_knownhosts_decide(HOSTKEY_MODE_ACCEPT_NEW, KH_UNKNOWN), "knownhosts: ACCEPT_NEW proceeds on UNKNOWN (caller appends first)")
_ck(not _knownhosts_decide(HOSTKEY_MODE_ACCEPT_NEW, KH_MISMATCH), "knownhosts: ACCEPT_NEW still refuses a MISMATCH - TOFU never overrides a changed key")
end
package ssh
import crypto
func _selftest_mac():
mut key := _hexbuf("0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b")
_ck(key.len == 20, "mac: RFC2202 test-1 key is 20 bytes")
data := "Hi There"
mut got1 := NewBuf(20)
BufPutZeros(got1, 20)
_hmac(MAC_SHA1, key.p, key.len, data as void*, data.len(), got1.p)
_ckhex(_hex_of(got1.p, 20), "b617318655057264e28bc0b6fb378c8ef146be00", "mac: HMAC-SHA1 RFC2202 test case 1")
ref := crypto.HmacSha256Hex("key", "The quick brown fox jumps over the lazy dog")
mut got2 := NewBuf(32)
BufPutZeros(got2, 32)
keystr := "key"
msgstr := "The quick brown fox jumps over the lazy dog"
_hmac(MAC_SHA256, keystr as void*, keystr.len(), msgstr as void*, msgstr.len(), got2.p)
_ckhex(_hex_of(got2.p, 32), ref, "mac: HMAC-SHA2-256 matches std/crypto.HmacSha256Hex")
mut longkey := NewBuf(80)
BufPutZeros(longkey, 80)
repeat 80 in i:
_bput(longkey.p, i, i % 256)
end
mut got3 := NewBuf(32)
BufPutZeros(got3, 32)
_hmac(MAC_SHA256, longkey.p, 80, msgstr as void*, msgstr.len(), got3.p)
mut got3b := NewBuf(32)
BufPutZeros(got3b, 32)
_hmac(MAC_SHA256, longkey.p, 80, msgstr as void*, msgstr.len(), got3b.p)
_ckhex(_hex_of(got3.p, 32), _hex_of(got3b.p, 32), "mac: HMAC-SHA2-256 is deterministic with an over-long key")
FreeBuf(key)
FreeBuf(got1)
FreeBuf(got2)
FreeBuf(longkey)
FreeBuf(got3)
FreeBuf(got3b)
end
package ssh
import net.internal.rawsock
const _PKT_TEST_PORT := 48391
func _pkt_expect_roundtrip(sender &: PacketState, receiver &: PacketState, payload: Buf, label: str):
ok_send := _packet_send(sender, payload)
_ck(ok_send, label + ": send succeeds")
mut got := _packet_recv(receiver)
_ck(not got.bad, label + ": receive succeeds (frame parses, MAC checks out if encrypted)")
_ck(got.len == payload.len, label + ": received payload length matches what was sent")
_ckhex(_hex_of(got.p, got.len), _hex_of(payload.p, payload.len), label + ": received payload bytes match what was sent exactly")
FreeBuf(got)
end
func _selftest_packet():
srv := rawsock.Listen(_PKT_TEST_PORT)
if not rawsock.Ok(srv):
_ck(false, "packet: (setup) could not open a loopback listen socket - skipping the rest of this suite")
ret
end
cli := rawsock.Connect("127.0.0.1", _PKT_TEST_PORT)
peer := rawsock.Accept(srv)
_ck(rawsock.Ok(cli), "packet: (setup) client connects to the loopback listener")
_ck(rawsock.Ok(peer), "packet: (setup) server accepts the loopback connection")
if not rawsock.Ok(cli) or not rawsock.Ok(peer):
rawsock.Close(srv)
ret
end
mut cli_ps := _packet_state_new(cli)
mut peer_ps := _packet_state_new(peer)
mut p1 := NewBuf(4)
BufPutByte(p1, 1)
BufPutStringStr(p1, "hello server")
_pkt_expect_roundtrip(cli_ps, peer_ps, p1, "packet plaintext: client -> server, small payload")
FreeBuf(p1)
mut p2 := NewBuf(4)
BufPutByte(p2, 2)
BufPutStringStr(p2, "hello client")
_pkt_expect_roundtrip(peer_ps, cli_ps, p2, "packet plaintext: server -> client, small payload")
FreeBuf(p2)
_ck(cli_ps.seq_write == (1 as u32), "packet: client's write sequence number is 1 after one send")
_ck(peer_ps.seq_read == (1 as u32), "packet: server's read sequence number is 1 after one receive")
_ck(peer_ps.seq_write == (1 as u32), "packet: server's write sequence number is 1 after one send")
_ck(cli_ps.seq_read == (1 as u32), "packet: client's read sequence number is 1 after one receive")
mut big_pt := NewBuf(5000)
mut bi := 0
until bi < 5000:
BufPutByte(big_pt, bi & 0xFF)
bi += 1
end
_pkt_expect_roundtrip(cli_ps, peer_ps, big_pt, "packet plaintext: client -> server, 5000-byte payload spanning many blocks")
FreeBuf(big_pt)
key_c2s := _hexbuf("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f")
key_s2c := _hexbuf("1f1e1d1c1b1a191817161514131211100f0e0d0c0b0a09080706050403020100")
cli_ps.cipher_write = _aes_init(key_c2s.p, 32)
cli_ps.cipher_read = _aes_init(key_s2c.p, 32)
peer_ps.cipher_write = _aes_init(key_s2c.p, 32)
peer_ps.cipher_read = _aes_init(key_c2s.p, 32)
FreeBuf(key_c2s)
FreeBuf(key_s2c)
cli_ps.counter_write = _hexbuf("00000000000000000000000000000001")
peer_ps.counter_read = _hexbuf("00000000000000000000000000000001")
peer_ps.counter_write = _hexbuf("000000000000000000000000000000ff")
cli_ps.counter_read = _hexbuf("000000000000000000000000000000ff")
cli_ps.mac_key_write = _hexbuf("2020202020202020202020202020202020202020202020202020202020202020")
peer_ps.mac_key_read = _hexbuf("2020202020202020202020202020202020202020202020202020202020202020")
peer_ps.mac_key_write = _hexbuf("3030303030303030303030303030303030303030303030303030303030303030")
cli_ps.mac_key_read = _hexbuf("3030303030303030303030303030303030303030303030303030303030303030")
cli_ps.mac_kind_write = MAC_SHA256
cli_ps.mac_kind_read = MAC_SHA256
peer_ps.mac_kind_write = MAC_SHA256
peer_ps.mac_kind_read = MAC_SHA256
cli_ps.block_size_write = 16
cli_ps.block_size_read = 16
peer_ps.block_size_write = 16
peer_ps.block_size_read = 16
cli_ps.encrypted = true
peer_ps.encrypted = true
mut e1 := NewBuf(4)
BufPutByte(e1, 50)
BufPutStringStr(e1, "encrypted hello from client")
_pkt_expect_roundtrip(cli_ps, peer_ps, e1, "packet encrypted: client -> server, small payload")
FreeBuf(e1)
mut e2 := NewBuf(4)
BufPutByte(e2, 51)
BufPutStringStr(e2, "encrypted hello from server")
_pkt_expect_roundtrip(peer_ps, cli_ps, e2, "packet encrypted: server -> client, small payload")
FreeBuf(e2)
mut big_ct := NewBuf(9000)
mut ci := 0
until ci < 9000:
BufPutByte(big_ct, (ci * 3) & 0xFF)
ci += 1
end
_pkt_expect_roundtrip(cli_ps, peer_ps, big_ct, "packet encrypted: client -> server, 9000-byte payload spanning many cipher blocks")
FreeBuf(big_ct)
_ck(cli_ps.seq_write == (4 as u32), "packet: client's write sequence continues counting across the encryption switch (2 plaintext + 2 encrypted sends so far)")
tampered_key := peer_ps.mac_key_read
_bput(tampered_key.p, 0, _bget(tampered_key.p, 0) ^ 0xFF)
mut e3 := NewBuf(4)
BufPutByte(e3, 52)
BufPutStringStr(e3, "this must not verify")
ok_send3 := _packet_send(cli_ps, e3)
_ck(ok_send3, "packet: (setup) send for the MAC-mismatch case succeeds at the transport level")
mut got3 := _packet_recv(peer_ps)
_ck(got3.bad, "packet: a receiver with the wrong MAC key rejects the packet instead of accepting it")
FreeBuf(got3)
FreeBuf(e3)
_packet_state_free(cli_ps)
_packet_state_free(peer_ps)
rawsock.Close(cli)
rawsock.Close(peer)
rawsock.Close(srv)
end
