package http
import net.tcp
import net.mime
import net.router
import net.internal.rawsock
import tls
import mem
import str
import conv
import encoding
import filepath
import os
extern:
func fopen(path: str, mode: str): void *
func fread(ptr: void *, size: u64, nmemb: u64, stream: void *): u64
func fseek(stream: void *, off: int, whence: int): int
func ftell(stream: void *): int
func fclose(stream: void *): int
end
@en "SERVER_VERSION"
@fa "نسخه سرور"
pub const SERVER_VERSION := SALAM_VERSION
const _RD_CHUNK := 65536
const _SRV_MAX := 8
const _SRV_SHIFT := 32 as i64
const _SRV_MASK := 4294967295 as i64
mut _reqctx_size := 0 as i64
mut _keepalive_idle_ms := 5000
mut _keepalive_max_reqs := 100000
mut _max_header_bytes := 65536
mut _max_body_bytes := 67108864
mut _srv_routers := Vector {} as Vector<router.Router>
mut _srv_hide := Vector {} as Vector<bool>
mut _srv_log := Vector {} as Vector<bool>
mut _srv_tls := Vector {} as Vector<tls.ServerConfig>
mut _srv_shdr := Vector {} as Vector<str>
mut _srv_count := 0
struct _KV:
pub k: str = ""
pub v: str = ""
end
struct _ReqCtx:
pub fd: i64 = 0
pub status: int = 200
pub is_sent: bool = false
pub method: str = ""
pub path: str = ""
pub query: str = ""
pub body: str = ""
pub resp_ct: str = ""
pub resp_body: str = ""
pub req_hdrs: Vector<_KV> = Vector {}
pub path_params: Vector<_KV> = Vector {}
pub resp_hdrs: Vector<_KV> = Vector {}
pub keep_alive: bool = true
pub owned: Vector<i64> = Vector {}
pub raw: str = ""
pub hdr_pos: int = 0
pub hdr_end: int = 0
end
@en "Context"
@fa "زمینه"
pub struct Context:
pub h: i64
end
@en "Server"
@fa "سرور"
pub struct Server:
pub port: int = 0
pub host: str = "0.0.0.0"
pub router: router.Router = router.Router {}
pub hide_tokens: bool = false
pub access_log: bool = false
end
func _srv_init():
if _srv_routers.len() > 0:
ret
end
repeat _SRV_MAX in _:
_srv_routers.push(router.NewRouter())
_srv_hide.push(false)
_srv_log.push(false)
_srv_tls.push(tls.NewServerConfig("", ""))
_srv_shdr.push("Salam")
end
end
func _srv_claim(r: router.Router, hide: bool, log: bool): int:
_srv_init()
mut slot := _srv_count
if slot >= _SRV_MAX:
slot = _SRV_MAX - 1
else:
_srv_count += 1
end
_srv_routers.set(slot, r)
_srv_hide.set(slot, hide)
_srv_log.set(slot, log)
_srv_shdr.set(slot, _server_header(hide))
ret slot
end
func _srv_pack(slot: int, fd: i64): i64:
ret (slot as i64 << _SRV_SHIFT) | fd
end
func _srv_slot_of(packed: i64): int:
ret (packed >> _SRV_SHIFT) as int
end
func _srv_fd_of(packed: i64): i64:
ret packed & _SRV_MASK
end
func _warm_up_split():
junk := "a/b".split("/")
repeat junk.len() in i:
mem.Free(junk.get(i) as void *)
end
junk.free()
end
func _reqctx_sizeof(): i64:
if _reqctx_size == 0:
mut v := Vector {} as Vector<_ReqCtx> v.push(_ReqCtx {})
v.push(_ReqCtx {})
_reqctx_size = (v.ref(1) as i64) - (v.ref(0) as i64)
v.free()
end
ret _reqctx_size
end
func _rc(h: i64): _ReqCtx *:
ret h as _ReqCtx *
end
func _eq_at(s: str, pos: int, lit: str): bool:
m := lit.len()
if pos < 0 or pos + m > s.len(): ret false end
sp := s as i8 *
lp := lit as i8 *
mut i := 0
until i < m:
if sp[pos + i] != lp[i]: ret false end
i += 1
end
ret true
end
func _ows_at(s: str, i: int): bool:
p := s as i8 *
b := p[i] as int
ret b == 32 or b == 9
end
func _eq_at_ifold(s: str, pos: int, name: str): bool:
m := name.len()
if pos < 0 or pos + m > s.len(): ret false end
sp := s as i8 *
np := name as i8 *
mut i := 0
until i < m:
mut a := sp[pos + i] as int
mut b := np[i] as int
if a >= 65 and a <= 90: a += 32 end
if b >= 65 and b <= 90: b += 32 end
if a != b: ret false end
i += 1
end
ret true
end
func _eq_at_fold(s: str, pos: int, lit: str): bool:
m := lit.len()
if pos < 0 or pos + m > s.len(): ret false end
sp := s as i8 *
lp := lit as i8 *
mut i := 0
until i < m:
mut a := sp[pos + i] as int
if a >= 65 and a <= 90: a += 32 end
if a != (lp[i] as int): ret false end
i += 1
end
ret true
end
func salam_ctx_new(fd: i64): i64:
p := mem.Allocate(_reqctx_sizeof() as u64)
c := p as _ReqCtx * c[0] = _ReqCtx { fd = fd }
ret p as i64
end
func _ctx_own(h: i64, s: str): str:
c := _rc(h)
c.owned.push((s as void *) as i64)
ret s
end
func salam_ctx_reset(h: i64):
c := _rc(h)
n := c.owned.len()
mut i := 0
until i < n:
mem.Free(c.owned.get(i) as void *)
i += 1
end
until c.owned.len() > 0:
c.owned.pop()
end
_kvl_clear(c.req_hdrs)
_kvl_clear(c.path_params)
_kvl_clear(c.resp_hdrs)
c.status = 200
c.is_sent = false
c.keep_alive = true
c.raw = ""
c.hdr_pos = 0
c.hdr_end = 0
c.method = ""
c.path = ""
c.query = ""
c.body = ""
c.resp_ct = ""
c.resp_body = ""
end
func salam_ctx_free(h: i64):
c := _rc(h)
n := c.owned.len()
mut i := 0
until i < n:
mem.Free(c.owned.get(i) as void *)
i += 1
end
c.owned.free()
c.req_hdrs.free()
c.path_params.free()
c.resp_hdrs.free()
mem.Free(h as void *)
end
func salam_ctx_fd(h: i64): i64:
ret _rc(h).fd
end
func salam_ctx_get(h: i64, idx: int): str:
c := _rc(h)
if idx == 0: ret c.method
else idx == 1: ret c.path
else idx == 2: ret c.query
else idx == 3: ret c.body
else idx == 4: ret c.resp_ct
else idx == 5: ret c.resp_body
else:
ret ""
end
end
func salam_ctx_set(h: i64, idx: int, val: str):
c := _rc(h)
if idx == 0: c.method = val
else idx == 1: c.path = val
else idx == 2: c.query = val
else idx == 3: c.body = val
else idx == 4: c.resp_ct = val
else idx == 5: c.resp_body = val end
end
func salam_ctx_get_status(h: i64): int:
ret _rc(h).status
end
func salam_ctx_set_status(h: i64, status: int):
c := _rc(h)
c.status = status
end
func salam_ctx_is_sent(h: i64): int:
if _rc(h).is_sent: ret 1 end
ret 0
end
func _ctx_mark_sent(h: i64):
c := _rc(h)
c.is_sent = true
end
func _kvl_get(l &: Vector<_KV>, key: str): str:
repeat l.len() in i:
kv := l.get(i)
if kv.k == key: ret kv.v end
end
ret ""
end
func _kvl_get_field(l &: Vector<_KV>, key: str): str:
repeat l.len() in i:
kv := l.get(i)
if str.EqualFold(kv.k, key): ret kv.v end
end
ret ""
end
func _kvl_set(l &: Vector<_KV>, key: str, val: str):
repeat l.len() in i:
if l.get(i).k == key:
l.set(i, _KV { k = key, v = val })
ret
end
end
l.push(_KV { k = key, v = val })
end
func _kvl_set_cookie(l &: Vector<_KV>, cookie_name: str, val: str):
prefix := cookie_name.concat("=")
mut i := 0
until i < l.len():
kv := l.get(i)
if kv.k == "Set-Cookie" and kv.v.len() >= prefix.len() and kv.v.substr(0, prefix.len()) == prefix:
l.remove_at(i)
else:
i += 1
end
end
l.push(_KV { k = "Set-Cookie", v = val })
end
func _kvl_clear(l &: Vector<_KV>):
until l.len() > 0:
l.pop()
end
end
func _hdr_lookup(h: i64, name: str): str:
c := _rc(h)
raw := c.raw
if raw.len() == 0: ret "" end
e := c.hdr_end
nlen := name.len()
mut pos := c.hdr_pos
until pos < e:
line_end := str.IndexFrom(raw, "\r\n", pos)
if line_end < 0 or line_end > e: break end
colon := str.IndexFrom(raw, ":", pos)
if colon >= 0 and colon < line_end and colon - pos == nlen and _eq_at_ifold(raw, pos, name):
mut vs := colon + 1
until vs < line_end and _ows_at(raw, vs):
vs += 1
end
ret _ctx_own(h, raw.substr(vs, line_end - vs))
end
pos = line_end + 2
end
ret ""
end
func salam_ctx_kv_get(h: i64, list: int, key: str): str:
c := _rc(h)
if list == 0:
if c.req_hdrs.len() > 0:
over := _kvl_get_field(c.req_hdrs, key)
if over.len() > 0: ret over end
end
ret _hdr_lookup(h, key)
else list == 1: ret _kvl_get(c.path_params, key)
else:
ret _kvl_get_field(c.resp_hdrs, key)
end
end
func salam_ctx_kv_add(h: i64, list: int, key: str, val: str):
c := _rc(h)
if list == 0: _kvl_set(c.req_hdrs, key, val)
else list == 1: _kvl_set(c.path_params, key, val)
else:
_kvl_set(c.resp_hdrs, key, val)
end
end
func salam_ctx_kv_set_cookie(h: i64, cookie_name: str, val: str):
c := _rc(h)
_kvl_set_cookie(c.resp_hdrs, cookie_name, val)
end
func salam_ctx_kv_clear(h: i64, list: int):
c := _rc(h)
if list == 0: _kvl_clear(c.req_hdrs)
else list == 1: _kvl_clear(c.path_params)
else:
_kvl_clear(c.resp_hdrs)
end
end
func salam_ctx_kv_n(h: i64, list: int): int:
c := _rc(h)
if list == 0: ret c.req_hdrs.len()
else list == 1: ret c.path_params.len()
else:
ret c.resp_hdrs.len()
end
end
func salam_ctx_kv_key(h: i64, list: int, idx: int): str:
c := _rc(h)
if list == 0: ret c.req_hdrs.get(idx).k
else list == 1: ret c.path_params.get(idx).k
else:
ret c.resp_hdrs.get(idx).k
end
end
func salam_ctx_kv_val(h: i64, list: int, idx: int): str:
c := _rc(h)
if list == 0: ret c.req_hdrs.get(idx).v
else list == 1: ret c.path_params.get(idx).v
else:
ret c.resp_hdrs.get(idx).v
end
end
func _query_parse(req: str, key: str): str:
n := req.len()
mut pos := 0
until pos < n:
amp := str.IndexFrom(req, "&", pos)
mut fend := amp
if fend < 0: fend = n end
eq_at := str.IndexFrom(req, "=", pos)
if eq_at >= 0 and eq_at < fend:
kraw := req.substr(pos, eq_at - pos)
kdec := UrlDecode(kraw)
mem.Free(kraw as void *)
hit := kdec == key
mem.Free(kdec as void *)
if hit:
vraw := req.substr(eq_at + 1, fend - eq_at - 1)
vdec := UrlDecode(vraw)
mem.Free(vraw as void *)
ret vdec
end
end
if amp < 0: break end
pos = amp + 1
end
ret str.Clone("")
end
func _parse_http(ctx: i64, req: str):
c := _rc(ctx)
n := req.len()
sp1 := req.find(" ")
if sp1 < 0: ret end
c.method = _ctx_own(ctx, req.substr(0, sp1))
sp2 := str.IndexFrom(req, " ", sp1 + 1)
if sp2 < 0: ret end
pathquery := req.substr(sp1 + 1, sp2 - sp1 - 1)
qmark := pathquery.find("?")
if qmark >= 0:
c.path = _ctx_own(ctx, pathquery.substr(0, qmark))
c.query = _ctx_own(ctx, pathquery.substr(qmark + 1, pathquery.len() - qmark - 1))
mem.Free(pathquery as void *)
else:
c.path = _ctx_own(ctx, pathquery)
c.query = ""
end
first_crlf := str.IndexFrom(req, "\r\n", sp2 + 1)
if first_crlf < 0: ret end
if first_crlf - sp2 - 1 >= 8 and _eq_at(req, sp2 + 1, "HTTP/1.0"):
c.keep_alive = false
end
c.raw = req
c.hdr_pos = first_crlf + 2
mut pos := first_crlf + 2
mut body_start := 0 - 1
until pos < n:
if pos + 1 < n and _eq_at(req, pos, "\r\n"):
body_start = pos + 2
break
end
line_end := str.IndexFrom(req, "\r\n", pos)
if line_end < 0:
break
end
colon := str.IndexFrom(req, ":", pos)
if colon >= 0 and colon < line_end and colon - pos == 10 and _eq_at_fold(req, pos, "connection"):
mut vs := colon + 1
until vs < line_end and _ows_at(req, vs):
vs += 1
end
if _eq_at_fold(req, vs, "close"): c.keep_alive = false
else _eq_at_fold(req, vs, "keep-alive"): c.keep_alive = true end
end
pos = line_end + 2
end
c.hdr_end = pos
if body_start >= 0 and body_start < n:
c.body = _ctx_own(ctx, req.substr(body_start, n - body_start))
end
end
func _server_header(hide: bool): str:
if hide: ret "Salam" end
ret "Salam/".concat(SERVER_VERSION)
end
func _has_header(ctx: i64, name: str): bool:
n := salam_ctx_kv_n(ctx, 2)
repeat n in i:
if str.EqualFold(salam_ctx_kv_key(ctx, 2, i), name): ret true end
end
ret false
end
func _append_status(b &: str.StringBuilder, status: int):
if status == 200: str.BufAppend(b, "200 OK") ret end
if status == 404: str.BufAppend(b, "404 Not Found") ret end
if status == 204: str.BufAppend(b, "204 No Content") ret end
if status == 500: str.BufAppend(b, "500 Internal Server Error") ret end
str.BufAppendInt(b, status as i64)
str.BufAppend(b, " ")
str.BufAppend(b, mime.StatusText(status))
end
func _hdr_dirty(s: str): bool:
ret str.Contains(s, "\r") or str.Contains(s, "\n")
end
func _hdr_clean(s: str): str:
a := str.Replace(s, "\r", " ")
out := str.Replace(a, "\n", " ")
mem.Free(a as void *)
ret out
end
func _fill_response(b &: str.StringBuilder, ctx: i64, shdr: str, keep: bool):
status := salam_ctx_get_status(ctx)
ct := salam_ctx_get(ctx, 4)
body := salam_ctx_get(ctx, 5)
str.BufAppend(b, "HTTP/1.1 ")
_append_status(b, status)
str.BufAppend(b, "\r\nContent-Length: ")
str.BufAppendInt(b, body.len() as i64)
if keep:
str.BufAppend(b, "\r\nConnection: keep-alive")
else:
str.BufAppend(b, "\r\nConnection: close")
end
str.BufAppend(b, "\r\nServer: ")
str.BufAppend(b, shdr)
if _has_header(ctx, "X-Powered-By") == false:
str.BufAppend(b, "\r\nX-Powered-By: ")
str.BufAppend(b, shdr)
end
str.BufAppend(b, "\r\n")
if ct.len() > 0 and _has_header(ctx, "Content-Type") == false:
str.BufAppend(b, "Content-Type: ")
str.BufAppend(b, ct)
str.BufAppend(b, "\r\n")
end
nhdr := salam_ctx_kv_n(ctx, 2)
repeat nhdr in i:
k0 := salam_ctx_kv_key(ctx, 2, i)
v0 := salam_ctx_kv_val(ctx, 2, i)
if _hdr_dirty(k0) or _hdr_dirty(v0):
hk := _hdr_clean(k0)
hv := _hdr_clean(v0)
str.BufAppend(b, hk)
str.BufAppend(b, ": ")
str.BufAppend(b, hv)
mem.Free(hk as void *)
mem.Free(hv as void *)
else:
str.BufAppend(b, k0)
str.BufAppend(b, ": ")
str.BufAppend(b, v0)
end
str.BufAppend(b, "\r\n")
end
str.BufAppend(b, "\r\n")
if salam_ctx_get(ctx, 0) != "HEAD":
str.BufAppend(b, body)
end
end
func _build_response(ctx: i64, shdr: str): str:
mut b := str.NewBuilder()
_fill_response(b, ctx, shdr, false)
out := str.BufStr(b)
str.BufFree(b)
ret out
end
func _dispatch(r: router.Router, ctx: i64): bool:
method := salam_ctx_get(ctx, 0)
path := salam_ctx_get(ctx, 1)
mut m := router.Dispatch(r, method, path)
if not m.matched:
router.FreeMatch(m)
ret false
end
salam_ctx_kv_clear(ctx, 1)
n := m.params.items.len()
mut i := 0
until i < n:
kv := m.params.items.get(i)
salam_ctx_kv_add(ctx, 1, _ctx_own(ctx, kv.key), _ctx_own(ctx, kv.value))
i += 1
end
m.params.items.free()
m.params = router.ParamList {}
callhandler(m.fn, ctx)
ret true
end
func _net_listen(host: str, port: int): i64:
ret rawsock.ListenOn(host, port, rawsock.SOCK_STREAM).fd
end
func _net_accept(lfd: i64): i64:
ret rawsock.Accept(rawsock.FromFd(lfd)).fd
end
func _str_of(ptr: void *, n: int): str:
r := mem.Allocate((n + 1) as u64)
mem.Copy(r, ptr, n as u64)
p := r as i8 *
p[n] = 0 as i8
ret r as str
end
func _has_transfer_encoding(head: str, head_len: int): bool:
mut pos := 0
until pos < head_len:
line_end := str.IndexFrom(head, "\r\n", pos)
if line_end < 0 or line_end >= head_len: break end
colon := str.IndexFrom(head, ":", pos)
if colon >= 0 and colon < line_end:
if colon - pos == 17 and _eq_at_fold(head, pos, "transfer-encoding"):
ret true
end
end
pos = line_end + 2
end
ret false
end
func _bad_content_length(head: str, head_len: int): bool:
mut pos := 0
mut seen := false
mut first := 0
until pos < head_len:
line_end := str.IndexFrom(head, "\r\n", pos)
if line_end < 0 or line_end >= head_len: break end
colon := str.IndexFrom(head, ":", pos)
if colon >= 0 and colon < line_end:
if colon - pos == 14 and _eq_at_fold(head, pos, "content-length"):
raw := head.substr(colon + 1, line_end - colon - 1)
t := str.Trim(raw)
mem.Free(raw as void *)
if t.len() == 0:
mem.Free(t as void *)
ret true
end
tp := t as u8 *
mut k := 0
until k < t.len():
c := tp[k] as int
if c < 48 or c > 57:
mem.Free(t as void *)
ret true
end
k += 1
end
if t.len() > 15:
mem.Free(t as void *)
ret true
end
v := t.to_int()
mem.Free(t as void *)
if v < 0: ret true end
if seen and v != first: ret true end
seen = true
first = v
end
end
pos = line_end + 2
end
ret false
end
func _content_length(head: str, head_len: int): int:
mut pos := 0
until pos < head_len:
line_end := str.IndexFrom(head, "\r\n", pos)
if line_end < 0 or line_end >= head_len: break end
colon := str.IndexFrom(head, ":", pos)
if colon >= 0 and colon < line_end:
if colon - pos == 14 and _eq_at_fold(head, pos, "content-length"):
raw := head.substr(colon + 1, line_end - colon - 1)
t := str.Trim(raw)
mem.Free(raw as void *)
mut valid := t.len() > 0 and t.len() <= 15
tp := t as u8 *
mut k := 0
until valid and k < t.len():
c := tp[k] as int
if c < 48 or c > 57: valid = false end
k += 1
end
mut v := 0
if valid: v = t.to_int() end
mem.Free(t as void *)
if valid and v > 0: ret v end
ret 0
end
end
pos = line_end + 2
end
ret 0
end
func _has_body_at(s: str, vend: int): bool:
if vend == 3 and _eq_at(s, 0, "GET"): ret false end
if vend == 4 and _eq_at(s, 0, "HEAD"): ret false end
if vend == 7 and _eq_at(s, 0, "OPTIONS"): ret false end
ret true
end
func _read_request(fd: i64, scratch: void *, pending &: str, owned &: bool, oversize &: int): str:
sock := rawsock.FromFd(fd)
owned = false
if pending.len() == 0:
got := rawsock.RecvBytes(sock, scratch, _RD_CHUNK)
if got <= 0: ret "" end
sp0 := scratch as i8 *
sp0[got] = 0 as i8
one := scratch as str
head_end := str.IndexFrom(one, "\r\n\r\n", 0)
if head_end >= 0:
head_len := head_end + 4
mut need := head_len
vend := one.find(" ")
if vend > 0 and _has_body_at(one, vend):
need = head_len + _content_length(one, head_len)
end
if need == got: ret one end
if need < got:
pending = one.substr(need, got - need)
owned = true
ret one.substr(0, need)
end
end
pending = _str_of(scratch, got)
end
mut buf := pending
pending = ""
mut scan := 0
mut head_end := str.IndexFrom(buf, "\r\n\r\n", scan)
until head_end < 0:
if buf.len() >= _max_header_bytes:
mem.Free(buf as void *)
oversize = 431
ret ""
end
got := rawsock.RecvBytes(sock, scratch, _RD_CHUNK)
if got <= 0:
mem.Free(buf as void *)
ret ""
end
chunk := _str_of(scratch, got)
grown := buf.concat(chunk)
mem.Free(chunk as void *)
scan = buf.len() - 3
if scan < 0: scan = 0 end
mem.Free(buf as void *)
buf = grown
head_end = str.IndexFrom(buf, "\r\n\r\n", scan)
end
head_len := head_end + 4
mut need := head_len
vend := buf.find(" ")
if vend > 0 and _has_body_at(buf, vend):
need = head_len + _content_length(buf, head_len)
if need - head_len > _max_body_bytes:
mem.Free(buf as void *)
oversize = 413
ret ""
end
if buf.len() < need:
mut acc := str.NewBuilder()
str.BufAppend(acc, buf)
mem.Free(buf as void *)
until (str.BufLen(acc) as int) < need:
got := rawsock.RecvBytes(sock, scratch, _RD_CHUNK)
if got <= 0: break end
chunk := _str_of(scratch, got)
str.BufAppend(acc, chunk)
mem.Free(chunk as void *)
end
buf = str.BufStr(acc)
str.BufFree(acc)
end
if buf.len() < need: need = buf.len() end
end
owned = true
if need == buf.len(): ret buf end
pending = buf.substr(need, buf.len() - need)
out := buf.substr(0, need)
mem.Free(buf as void *)
ret out
end
func _net_send_all(fd: i64, data: str):
tcp.Write(tcp.ConnFromFd(fd), data)
end
func _net_close(fd: i64):
tcp.Close(tcp.ConnFromFd(fd))
end
func _send_file(fd: i64, path: str, ct: str, server_hdr: str, keep: bool): int:
f := fopen(path, "rb")
if f == null:
ret 0
end
defer fclose(f)
fseek(f, 0, 2)
sz := ftell(f) as i64
fseek(f, 0, 0)
if sz < 0:
ret 0
end
mut hb := str.NewBuilder()
str.BufAppend(hb, "HTTP/1.1 200 OK\r\nContent-Length: ")
str.BufAppendInt(hb, sz)
str.BufAppend(hb, "\r\nContent-Type: ")
str.BufAppend(hb, ct)
if keep:
str.BufAppend(hb, "\r\nConnection: keep-alive\r\nServer: ")
else:
str.BufAppend(hb, "\r\nConnection: close\r\nServer: ")
end
str.BufAppend(hb, server_hdr)
str.BufAppend(hb, "\r\nX-Powered-By: ")
str.BufAppend(hb, server_hdr)
str.BufAppend(hb, "\r\n\r\n")
hdr := str.BufStr(hb)
str.BufFree(hb)
_net_send_all(fd, hdr)
mem.Free(hdr as void *)
chunk_cap := 65536 as u64
buf := mem.Allocate(chunk_cap)
defer mem.Free(buf)
conn := tcp.ConnFromFd(fd)
mut remaining := sz
until remaining > 0:
want := remaining < (chunk_cap as i64) ? (remaining as u64) : chunk_cap
got := fread(buf, 1 as u64, want, f)
if got == (0 as u64):
break
end
if tcp.WriteBytes(conn, buf, got as int) <= 0:
break
end
remaining -= got as i64
end
ret 1
end
func _html_escape(s: str): str:
n := s.len()
mut b := str.NewBuilder()
defer str.BufFree(b)
repeat n in i:
c := s.substr(i, 1)
if c == "&": str.BufAppend(b, "&amp;")
else c == "<": str.BufAppend(b, "&lt;")
else c == ">": str.BufAppend(b, "&gt;")
else c == `"`: str.BufAppend(b, "&quot;")
else c == "'": str.BufAppend(b, "&#39;")
else:
str.BufAppend(b, c)
end
end
ret str.BufStr(b)
end
func _safe_static_path(root: str, rel: str): str:
croot := filepath.Clean(root)
joined := filepath.Join(croot, rel)
cleaned := filepath.Clean(joined)
mem.Free(joined as void *)
mut ok := false
if croot == ".":
ok = true
if cleaned == "..": ok = false end
if str.StartsWith(cleaned, "../"): ok = false end
if cleaned != "." and filepath.IsAbs(cleaned): ok = false end
else cleaned == croot:
ok = true
else:
ok = _eq_at(cleaned, 0, croot) and _eq_at(cleaned, croot.len(), "/")
end
mem.Free(croot as void *)
if ok: ret cleaned end
mem.Free(cleaned as void *)
ret str.Clone("")
end
func _static_dir_redirect(ctx: i64, path: str):
mut loc := path.concat("/")
q := salam_ctx_get(ctx, 2)
if q.len() > 0:
loc = loc.concat("?").concat(q)
end
salam_ctx_set_status(ctx, 301)
salam_ctx_kv_add(ctx, 2, "Location", _ctx_own(ctx, loc))
salam_ctx_set(ctx, 4, "text/plain; charset=utf-8")
salam_ctx_set(ctx, 5, "301 Moved Permanently")
end
func _dir_listing_html(url_path: str, disk_path: str): str:
names := os.ListDir(disk_path)
defer names.free()
mut dirs := Vector {} as Vector<str>
defer dirs.free()
mut files := Vector {} as Vector<str>
defer files.free()
repeat names.len() in i:
name := names.get(i)
if os.IsDir(filepath.Join(disk_path, name)):
dirs.push(name)
else:
files.push(name)
end
end
_insertion_sort_strs(dirs)
_insertion_sort_strs(files)
mut rows := str.NewBuilder()
defer str.BufFree(rows)
if url_path != "/":
str.BufAppend(rows, "<li><a href=\"../\">../</a></li>\n")
end
repeat dirs.len() in i:
name := dirs.get(i)
href := encoding.URLEncode(name)
str.BufAppend(rows, `<li><a href="`)
str.BufAppend(rows, href)
str.BufAppend(rows, `/">`)
str.BufAppend(rows, _html_escape(name))
str.BufAppend(rows, "/</a></li>\n")
end
repeat files.len() in i:
name := files.get(i)
href := encoding.URLEncode(name)
str.BufAppend(rows, `<li><a href="`)
str.BufAppend(rows, href)
str.BufAppend(rows, `">`)
str.BufAppend(rows, _html_escape(name))
str.BufAppend(rows, "</a></li>\n")
end
title := _html_escape(url_path)
mut out := "<!doctype html>\n<html><head><meta charset=\"utf-8\"><title>Index of "
out = out.concat(title)
out = out.concat("</title></head><body>\n<h1>Index of ")
out = out.concat(title)
out = out.concat("</h1>\n<ul>\n")
out = out.concat(str.BufStr(rows))
out = out.concat("</ul>\n</body></html>\n")
ret out
end
func _insertion_sort_strs(v &: Vector<str>):
n := v.len()
repeat n in i:
mut j := i
until j > 0 and v.get(j - 1) > v.get(j):
a := v.get(j - 1)
b := v.get(j)
v.set(j - 1, b)
v.set(j, a)
j -= 1
end
end
end
func _log_access(slot: int, method: str, path: str, status: int):
if _srv_log.get(slot) == false: ret end
println method, path, "->", status
end
func _route_request(slot: int, fd: i64, ctx: i64, req: str, keep &: bool): bool:
if req.len() == 0:
keep = false
ret false
end
salam_ctx_reset(ctx)
_parse_http(ctx, req)
keep = _rc(ctx).keep_alive
r := _srv_routers.get(slot)
shdr := _srv_shdr.get(slot)
mut static_handled := false
if r.has_static:
prefix := r.static_prefix
path := salam_ctx_get(ctx, 1)
if _eq_at(path, 0, prefix):
relraw := path.substr(prefix.len(), path.len() - prefix.len())
rel := UrlDecode(relraw)
mem.Free(relraw as void *)
target := _safe_static_path(r.static_dir, rel)
mem.Free(rel as void *)
if target.len() > 0:
if os.IsDir(target) and str.EndsWith(path, "/") == false:
_static_dir_redirect(ctx, path)
static_handled = true
else os.IsDir(target):
idx := filepath.Join(target, "index.html")
if os.Exists(idx) and os.IsDir(idx) == false:
if _send_file(fd, idx, mime.MimeType(idx), shdr, keep) == 1:
_ctx_mark_sent(ctx)
static_handled = true
end
else r.static_listing:
salam_ctx_set_status(ctx, 200)
salam_ctx_set(ctx, 4, "text/html; charset=utf-8")
salam_ctx_set(ctx, 5, _ctx_own(ctx, _dir_listing_html(path, target)))
static_handled = true
end
mem.Free(idx as void *)
else os.Exists(target):
if _send_file(fd, target, mime.MimeType(target), shdr, keep) == 1:
_ctx_mark_sent(ctx)
static_handled = true
end
end
end
mem.Free(target as void *)
end
end
if static_handled == false:
dispatched := _dispatch(r, ctx)
if dispatched == false:
salam_ctx_set_status(ctx, 404)
salam_ctx_set(ctx, 4, "text/plain; charset=utf-8")
salam_ctx_set(ctx, 5, "404 Not Found")
end
end
_log_access(slot, salam_ctx_get(ctx, 0), salam_ctx_get(ctx, 1), salam_ctx_get_status(ctx))
ret true
end
func _serve_request(slot: int, fd: i64, ctx: i64, req: str, keep &: bool): bool:
if not _route_request(slot, fd, ctx, req, keep):
ret false
end
if salam_ctx_is_sent(ctx) == 0:
mut b := str.NewBuilder()
_fill_response(b, ctx, _srv_shdr.get(slot), keep)
tcp.WriteBytes(tcp.ConnFromFd(fd), b.data, b.len as int)
str.BufFree(b)
end
ret true
end
func _web_conn_handler(packed: i64):
slot := _srv_slot_of(packed)
fd := _srv_fd_of(packed)
sock := rawsock.FromFd(fd)
rawsock.SetNoDelay(sock, true)
rawsock.SetTimeout(sock, _keepalive_idle_ms)
scratch := mem.Allocate((_RD_CHUNK + 1) as u64)
ctx := salam_ctx_new(fd)
mut pending := ""
mut served := 0
until 1 == 1:
mut owned := false
mut oversize := 0
req := _read_request(fd, scratch, pending, owned, oversize)
if oversize == 431:
_net_send_all(fd, "HTTP/1.1 431 Request Header Fields Too Large\r\nContent-Length: 0\r\nConnection: close\r\n\r\n")
break
end
if oversize != 0:
_net_send_all(fd, "HTTP/1.1 413 Content Too Large\r\nContent-Length: 0\r\nConnection: close\r\n\r\n")
break
end
if req.len() == 0: break end
te_end := str.IndexFrom(req, "\r\n\r\n", 0)
if te_end >= 0 and (_has_transfer_encoding(req, te_end + 4) or _bad_content_length(req, te_end + 4)):
_net_send_all(fd, "HTTP/1.1 400 Bad Request\r\nContent-Length: 0\r\nConnection: close\r\n\r\n")
if owned: mem.Free(req as void *) end
break
end
mut keep := true
ok := _serve_request(slot, fd, ctx, req, keep)
if owned: mem.Free(req as void *) end
if ok == false: break end
served += 1
if keep == false or served >= _keepalive_max_reqs: break end
end
if pending.len() > 0: mem.Free(pending as void *) end
salam_ctx_free(ctx)
mem.Free(scratch)
_net_close(fd)
end
func _web_tls_conn_handler(packed: i64):
slot := _srv_slot_of(packed)
fd := _srv_fd_of(packed)
mut c := tls.WrapServer(fd, _srv_tls.get(slot))
if not tls.ConnOk(c):
tls.Close(c)
ret
end
req := tls.Read(c, 32768)
if req.len() == 0:
mem.Free(req as void *)
tls.Close(c)
ret
end
ctx := salam_ctx_new(fd)
defer salam_ctx_free(ctx)
defer mem.Free(req as void *)
_parse_http(ctx, req)
r := _srv_routers.get(slot)
shdr := _srv_shdr.get(slot)
mut static_handled := false
if r.has_static:
prefix := r.static_prefix
path := salam_ctx_get(ctx, 1)
if _eq_at(path, 0, prefix):
relraw := path.substr(prefix.len(), path.len() - prefix.len())
rel := UrlDecode(relraw)
mem.Free(relraw as void *)
target := _safe_static_path(r.static_dir, rel)
mem.Free(rel as void *)
if target.len() > 0:
if os.IsDir(target) and str.EndsWith(path, "/") == false:
_static_dir_redirect(ctx, path)
static_handled = true
else os.IsDir(target):
idx := filepath.Join(target, "index.html")
if os.Exists(idx) and os.IsDir(idx) == false:
_tls_send_file(c, idx, mime.MimeType(idx), shdr)
_ctx_mark_sent(ctx)
static_handled = true
else r.static_listing:
salam_ctx_set_status(ctx, 200)
salam_ctx_set(ctx, 4, "text/html; charset=utf-8")
salam_ctx_set(ctx, 5, _ctx_own(ctx, _dir_listing_html(path, target)))
static_handled = true
end
mem.Free(idx as void *)
else os.Exists(target):
_tls_send_file(c, target, mime.MimeType(target), shdr)
_ctx_mark_sent(ctx)
static_handled = true
end
end
mem.Free(target as void *)
end
end
if static_handled == false:
dispatched := _dispatch(r, ctx)
if dispatched == false:
salam_ctx_set_status(ctx, 404)
salam_ctx_set(ctx, 4, "text/plain; charset=utf-8")
salam_ctx_set(ctx, 5, "404 Not Found")
end
end
_log_access(slot, salam_ctx_get(ctx, 0), salam_ctx_get(ctx, 1), salam_ctx_get_status(ctx))
if salam_ctx_is_sent(ctx) == 0:
resp := _build_response(ctx, shdr)
tls.Write(c, resp)
mem.Free(resp as void *)
end
tls.Close(c)
end
func _tls_send_file(c &: tls.Conn, path: str, ct: str, server_hdr: str):
f := fopen(path, "rb")
if f == null: ret end
fseek(f, 0, 2)
sz := ftell(f) as i64
fseek(f, 0, 0)
if sz < 0:
fclose(f)
ret
end
mut hdr := "HTTP/1.1 200 OK\r\nContent-Length: "
hdr = hdr.concat(conv.FormatInt(sz))
hdr = hdr.concat("\r\nContent-Type: ")
hdr = hdr.concat(ct)
hdr = hdr.concat("\r\nConnection: close\r\nServer: ")
hdr = hdr.concat(server_hdr)
hdr = hdr.concat("\r\nX-Powered-By: ")
hdr = hdr.concat(server_hdr)
hdr = hdr.concat("\r\n\r\n")
tls.Write(c, hdr)
buf := mem.Allocate((sz + 1) as u64)
defer mem.Free(buf)
got := fread(buf, 1 as u64, sz as u64, f)
fclose(f)
if got > (0 as u64):
tls.WriteBytes(c, buf, got as int)
end
end
@en "SetKeepAliveIdle"
@fa "تنظیم بیکاری زنده نگه داشتن"
pub func SetKeepAliveIdle(millis: int):
_keepalive_idle_ms = millis
end
@en "SetMaxHeaderBytes"
@fa "بیشینه بایت سرایند"
pub func SetMaxHeaderBytes(n: int):
if n > 0: _max_header_bytes = n end
end
@en "SetMaxBodyBytes"
@fa "بیشینه بایت بدنه"
pub func SetMaxBodyBytes(n: int):
if n > 0: _max_body_bytes = n end
end
@en "SetKeepAliveMaxRequests"
@fa "بیشینه درخواست زنده نگه داشتن"
pub func SetKeepAliveMaxRequests(n: int):
_keepalive_max_reqs = n
end
package http
import mem
import str
import os
import net.router
if SALAM_OS_WASM:
extern:
func read(fd: int, buf: void *, n: u32): int
func write(fd: int, buf: void *, n: u32): int
end
end
const _EDGE_IN_FD := 0
const _EDGE_OUT_FD := 3
const _EDGE_CHUNK := 65536
func _edge_read_request(): str:
if SALAM_OS_WASM:
mut cap := _EDGE_CHUNK
mut buf := mem.Allocate((cap + 1) as u64)
mut got := 0
until 1 == 1:
if got == cap:
cap = cap * 2
buf = mem.Reallocate(buf, (cap + 1) as u64)
end
n := read(_EDGE_IN_FD, ((buf as i64) + (got as i64)) as void *, (cap - got) as u32)
if n <= 0:
break
end
got += n
end
p := buf as i8 *
p[got] = 0 as i8
ret buf as str
else:
ret ""
end
end
func _edge_write(data: void *, n: int):
if SALAM_OS_WASM:
mut off := 0
until off < n:
w := write(_EDGE_OUT_FD, ((data as i64) + (off as i64)) as void *, (n - off) as u32)
if w <= 0:
ret
end
off += w
end
else:
ret
end
end
func _edge_serve(r: router.Router, hide: bool, log: bool):
slot := _srv_claim(r, hide, log)
req := _edge_read_request()
ctx := salam_ctx_new(0 - 1)
mut keep := false
if _route_request(slot, 0 - 1, ctx, req, keep):
if salam_ctx_is_sent(ctx) == 0:
mut b := str.NewBuilder()
_fill_response(b, ctx, _srv_shdr.get(slot), false)
_edge_write(b.data, b.len as int)
str.BufFree(b)
end
else:
bad := "HTTP/1.1 400 Bad Request\r\nContent-Length: 0\r\nConnection: close\r\n\r\n"
_edge_write(bad as void *, bad.len())
end
salam_ctx_free(ctx)
mem.Free(req as void *)
os.Exit(0)
end
@en "IsEdge"
@fa "لبه است"
pub func IsEdge(): bool:
if SALAM_OS_WASM:
ret true
else:
ret false
end
end
@en "net/http"
@fa "اچ تی تی پی"
package http
import mem
import str
import encoding
import compress
import net.internal.rawsock
import encoding.url
import tls
if SALAM_OS_WINDOWS and not SALAM_NATIVE_TLS:
link dynamic "winhttp"
end
if SALAM_OS_WINDOWS and not SALAM_NATIVE_TLS:
extern:
func MultiByteToWideChar(codepage: u32, flags: u32, src: str, srclen: i32, dst: void*, dstlen: i32): i32
func WideCharToMultiByte(codepage: u32, flags: u32, src: void*, srclen: i32, dst: void*, dstlen: i32, def: void*, used: void*): i32
func WinHttpOpen(agent: void*, access_type: int, proxy: void*, bypass: void*, flags: int): void*
func WinHttpConnect(session: void*, host: void*, port: int, flags: int): void*
func WinHttpOpenRequest(conn: void*, verb: void*, path: void*, ver: void*, ref: void*, types: void*, flags: int): void*
func WinHttpSendRequest(req: void*, headers: void*, hlen: int, body: str, blen: int, total: int, ctx: usize): int
func WinHttpReceiveResponse(req: void*, reserved: void*): int
func WinHttpQueryHeaders(req: void*, info: int, name: void*, buf: void*, buflen: void*, index: void*): int
func WinHttpReadData(req: void*, buf: void*, toread: int, read: void*): int
func WinHttpAddRequestHeaders(req: void*, headers: void*, hlen: int, modifiers: int): int
func WinHttpCloseHandle(handle: void*): int
end
end
mut _g_http_status := 0
mut _g_http_headers := ""
mut _g_http_error := ""
@en "Response"
@fa "پاسخ"
pub struct Response:
pub status: int = 0
pub body: str = ""
pub head: str = ""
pub err: str = ""
end
@en "Client"
@fa "کارخواه"
pub struct Client:
pub cookies: HashMap<str, str> = HashMap {} as HashMap<str, str>
pub headers: HashMap<str, str> = HashMap {} as HashMap<str, str>
@en "SetHeader"
@fa "تنظیم سرصفحه"
pub func SetHeader(name: str, value: str):
this.headers.put(name, value)
end
@en "SetCookie"
@fa "تنظیم کوکی"
pub func SetCookie(name: str, value: str):
this.cookies.put(name, value)
end
@en "ClearCookies"
@fa "پاک کردن کوکی ها"
pub func ClearCookies():
this.cookies = HashMap {} as HashMap<str, str>
end
func _merged_headers(extra: str): str:
mut out := serialize(this.headers)
ck := CookieHeader(this.cookies)
if ck.len() > 0:
out = out.concat("Cookie: ").concat(ck).concat("\r\n")
end
if extra.len() > 0:
out = out.concat(extra)
end
ret out
end
func _absorb(r: Response):
cs := CookieMap(r)
it := cs.iter()
until it.has_next():
this.cookies.put(it.key(), it.value())
it.next()
end
end
@en "Request"
@fa "درخواست"
pub func Request(method: str, url: str, body: str): Response:
r := send(method, url, this._merged_headers(""), body)
this._absorb(r)
ret r
end
@en "RequestWith"
@fa "درخواست با"
pub func RequestWith(method: str, url: str, body: str, extra: HashMap<str, str>): Response:
r := send(method, url, this._merged_headers(serialize(extra)), body)
this._absorb(r)
ret r
end
@en "Get"
@fa "دریافت"
pub func Get(url: str): Response: ret this.Request("GET", url, "") end
@en "Post"
@fa "ارسال"
pub func Post(url: str, body: str): Response: ret this.Request("POST", url, body) end
@en "Put"
@fa "قرار دادن"
pub func Put(url: str, body: str): Response: ret this.Request("PUT", url, body) end
@en "Delete"
@fa "حذف"
pub func Delete(url: str): Response: ret this.Request("DELETE", url, "") end
@en "Patch"
@fa "وصله"
pub func Patch(url: str, body: str): Response: ret this.Request("PATCH", url, body) end
@en "Options"
@fa "گزینه ها"
pub func Options(url: str): Response: ret this.Request("OPTIONS", url, "") end
@en "Head"
@fa "درخواست هد"
pub func Head(url: str): Response: ret this.Request("HEAD", url, "") end
end
func _header_at(headers: str, name: str): int:
if headers.len() == 0:
ret 0 - 1
end
lower := str.Lower(headers)
key := str.Lower(name).concat(":")
if str.StartsWith(lower, key):
ret 0
end
nl := str.Find(lower, "\r\n".concat(key))
if nl < 0:
ret 0 - 1
end
ret nl + 2
end
func _header_value(headers: str, name: str, fallback: str): str:
at := _header_at(headers, name)
if at < 0:
ret fallback
end
start := at + name.len() + 1
mut stop := str.IndexFrom(headers, "\r\n", start)
if stop < 0:
stop = headers.len()
end
value := str.Trim(headers.substr(start, stop - start))
if value.len() == 0:
ret fallback
end
ret value
end
func _drop_transport_headers(headers: str): str:
if headers.len() == 0:
ret ""
end
lines := str.Split(headers, "\r\n")
defer lines.free()
mut out := ""
each line in lines:
low := str.Lower(line)
mut keep := line.len() > 0
if str.StartsWith(low, "accept-encoding:") or str.StartsWith(low, "connection:"):
keep = false
end
if keep:
out = out.concat(line).concat("\r\n")
end
end
ret out
end
if SALAM_OS_WINDOWS and not SALAM_NATIVE_TLS:
func _make_str(buf: void*, len: int): str:
if buf == null or len <= 0:
ret ""
end
dst := mem.Allocate((len + 1) as u64)
mem.Set(dst, 0, (len + 1) as u64)
mem.Copy(dst, buf, len as u64)
ret dst as str
end
func _str_to_wide(s: str): void*:
n := MultiByteToWideChar(65001 as u32, 0 as u32, s, 0 - 1, null, 0)
if n <= 0:
ret mem.Allocate(2 as u64)
end
w := mem.Allocate((n * 2) as u64)
MultiByteToWideChar(65001 as u32, 0 as u32, s, 0 - 1, w, n)
ret w
end
func _wide_to_str(w: void*): str:
if w == null: ret "" end
n := WideCharToMultiByte(65001 as u32, 0 as u32, w, 0 - 1, null, 0, null, null)
if n <= 0: ret "" end
buf := mem.Allocate(n as u64)
WideCharToMultiByte(65001 as u32, 0 as u32, w, 0 - 1, buf, n, null, null)
ret _make_str(buf, n - 1)
end
func _fetch_https(method: str, url: str, raw_headers: str, body: str): str:
headers := _drop_transport_headers(raw_headers)
mut p := url
mut secure := 1
mut wport := 443
if url.substr(0, 8) == "https://":
p = url.substr(8, url.len() - 8)
else:
if url.substr(0, 7) == "http://":
secure = 0
wport = 80
p = url.substr(7, url.len() - 7)
end
end
slash_pos := p.find("/")
mut host_part := p
mut path_part := "/"
if slash_pos >= 0:
host_part = p.substr(0, slash_pos)
path_part = p.substr(slash_pos, p.len() - slash_pos)
end
colon_pos := host_part.find(":")
mut host_only := host_part
if colon_pos >= 0:
host_only = host_part.substr(0, colon_pos)
wport = host_part.substr(colon_pos + 1, host_part.len() - colon_pos - 1).to_int()
end
wagent := _str_to_wide(_header_value(headers, "User-Agent", "Salam/1.0"))
sess := WinHttpOpen(wagent, 0, null, null, 0)
mem.Free(wagent)
if sess == null: ret "" end
defer WinHttpCloseHandle(sess)
whost := _str_to_wide(host_only)
conn := WinHttpConnect(sess, whost, wport, 0)
mem.Free(whost)
if conn == null:
ret ""
end
defer WinHttpCloseHandle(conn)
mut req_flags := 0
if secure == 1: req_flags = 8388608 end
wverb := _str_to_wide(method)
wpath := _str_to_wide(path_part)
req := WinHttpOpenRequest(conn, wverb, wpath, null, null, null, req_flags)
mem.Free(wverb)
mem.Free(wpath)
if req == null:
ret ""
end
defer WinHttpCloseHandle(req)
if headers.len() > 0:
wh := _str_to_wide(headers)
WinHttpAddRequestHeaders(req, wh, 0 - 1, 805306368)
mem.Free(wh)
end
blen := body.len()
sent := WinHttpSendRequest(req, null, 0, body, blen, blen, 0 as usize)
if sent == 0:
ret ""
end
recv_ok := WinHttpReceiveResponse(req, null)
if recv_ok == 0:
ret ""
end
mut hlen := mem.Allocate(8 as u64) as i64*
defer mem.Free(hlen as void*)
hlen[0] = 0
WinHttpQueryHeaders(req, 22, null, null, hlen as void*, null)
hsize := hlen[0] as int
mut hdr_str := "HTTP/1.1 0 \r\n\r\n"
if hsize > 0:
wh := mem.Allocate((hsize + 4) as u64)
q2 := WinHttpQueryHeaders(req, 22, null, wh, hlen as void*, null)
if q2 != 0:
hdr_str = _wide_to_str(wh)
end
mem.Free(wh)
end
hend := hdr_str.len() - 4
if hend < 0 or hdr_str.substr(hend, 4) != "\r\n\r\n":
hdr_str = hdr_str.concat("\r\n\r\n")
end
buf := mem.Allocate(2050 as u64)
defer mem.Free(buf)
mut got := mem.Allocate(8 as u64) as i64*
defer mem.Free(got as void*)
mut body_str := ""
mut reading := true
until reading:
got[0] = 0
rd_ok := WinHttpReadData(req, buf, 2048, got as void*)
if rd_ok == 0 or got[0] == 0:
reading = false
else:
chunk := _make_str(buf, got[0] as int)
body_str = body_str.concat(chunk)
end
end
result := hdr_str.concat(body_str)
ret result
end
else:
func _read_all_plain(s: rawsock.Socket): compress.ByteBuf:
buf := compress.NewByteBuf()
tmp := mem.Allocate(16384 as u64)
defer mem.Free(tmp)
mut going := true
until going:
n := rawsock.RecvBytes(s, tmp, 16384)
if n <= 0:
going = false
else:
compress.BufPushBytes(buf, tmp, n)
end
end
ret buf
end
func _read_all_tls(c &: tls.Conn): compress.ByteBuf:
buf := compress.NewByteBuf()
tmp := mem.Allocate(16384 as u64)
defer mem.Free(tmp)
mut going := true
until going:
n := tls.ReadBytes(c, tmp, 16384)
if n <= 0:
going = false
else:
compress.BufPushBytes(buf, tmp, n)
end
end
ret buf
end
func _buf_find_crlf(b: compress.ByteBuf, from: int): int:
p := b.data as i8*
n := b.len
mut i := from
until i + 1 < n:
if p[i] == 13 and p[i + 1] == 10:
ret i
end
i += 1
end
ret 0 - 1
end
func _buf_find_crlf_crlf(b: compress.ByteBuf): int:
p := b.data as i8*
n := b.len
mut i := 0
until i + 3 < n:
if p[i] == 13 and p[i + 1] == 10 and p[i + 2] == 13 and p[i + 3] == 10:
ret i
end
i += 1
end
ret 0 - 1
end
func _buf_slice_str(b: compress.ByteBuf, start: int, length: int): str:
tmp := compress.NewByteBuf()
if length > 0:
compress.BufPushBytes(tmp, ((b.data as i64) + start) as void*, length)
end
ret compress.BufToStrUnsafe(tmp)
end
func _buf_slice_buf(b: compress.ByteBuf, start: int, length: int): compress.ByteBuf:
out := compress.NewByteBuf()
if length > 0:
compress.BufPushBytes(out, ((b.data as i64) + start) as void*, length)
end
ret out
end
func _hexval(s: str): int:
mut v := 0
n := s.len()
repeat n in i:
c := char_code(s.substr(i, 1))
mut d := 0 - 1
if c >= 48 and c <= 57: d = c - 48 end
if c >= 97 and c <= 102: d = c - 87 end
if c >= 65 and c <= 70: d = c - 55 end
if d < 0:
ret v
end
v = v * 16 + d
end
ret v
end
func _dechunk_buf(body: compress.ByteBuf): compress.ByteBuf:
out := compress.NewByteBuf()
mut pos := 0
mut going := true
until going:
nl := _buf_find_crlf(body, pos)
if nl < 0:
going = false
else:
line := _buf_slice_str(body, pos, nl - pos)
semi := line.find(";")
mut sizestr := line
if semi >= 0:
sizestr = line.substr(0, semi)
end
sz := _hexval(str.Trim(sizestr))
pos = nl + 2
if sz <= 0:
going = false
else:
if pos + sz > body.len:
going = false
else:
compress.BufPushBytes(out, ((body.data as i64) + pos) as void*, sz)
pos = pos + sz + 2
end
end
end
end
ret out
end
func _request_target(u: url.URL): str:
mut path := u.path
if path.len() == 0:
path = "/"
end
if u.raw_query.len() > 0:
ret path + "?" + u.raw_query
end
ret path
end
func _host_header(u: url.URL): str:
if u.port == 0:
ret u.host
end
if u.port == 80 and str.Equals(u.scheme, "http"):
ret u.host
end
if u.port == 443 and str.Equals(u.scheme, "https"):
ret u.host
end
ret u.host.concat(":").concat(str.FromInt(u.port as i64))
end
func _build_request(method: str, u: url.URL, raw_headers: str, body: str): str:
target := _request_target(u)
headers := _drop_transport_headers(raw_headers)
mut req := method.concat(" ").concat(target).concat(" HTTP/1.1\r\nHost: ")
req = req.concat(_host_header(u)).concat("\r\n")
if _header_at(headers, "User-Agent") < 0:
req = req.concat("User-Agent: Salam/1.0\r\n")
end
if _header_at(headers, "Accept") < 0:
req = req.concat("Accept: */*\r\n")
end
req = req.concat("Accept-Encoding: gzip\r\nConnection: close\r\n")
if headers.len() > 0:
req = req.concat(headers)
end
if body.len() > 0:
req = req.concat("Content-Length: ").concat(str.FromInt(body.len() as i64)).concat("\r\n")
end
req = req.concat("\r\n")
if body.len() > 0:
req = req.concat(body)
end
ret req
end
func _fetch_https(method: str, url_str: str, headers: str, body: str): str:
u := url.Parse(url_str)
secure := u.scheme != "http"
mut port := u.port
if port == 0:
if secure:
port = 443
else:
port = 80
end
end
if u.host.len() == 0:
_g_http_error = "no host in URL '" + url_str + "'"
ret ""
end
req := _build_request(method, u, headers, body)
mut raw := compress.NewByteBuf()
if secure:
cfg := tls.NewConfig(u.host)
mut c := tls.Dial(u.host, port, cfg)
if not tls.ConnOk(c):
_g_http_error = "TLS: " + tls.ConnError(c)
tls.Close(c)
ret ""
end
tls.Write(c, req)
raw = _read_all_tls(c)
tls.Close(c)
else:
s := rawsock.Connect(u.host, port)
if not rawsock.Ok(s):
_g_http_error = "could not connect to " + u.host + ":" + port
ret ""
end
rawsock.Send(s, req)
raw = _read_all_plain(s)
rawsock.Close(s)
end
sep := _buf_find_crlf_crlf(raw)
if sep < 0:
ret _buf_slice_str(raw, 0, raw.len)
end
head := _buf_slice_str(raw, 0, sep + 4)
mut rest := _buf_slice_buf(raw, sep + 4, raw.len - sep - 4)
lhead := str.Lower(head)
if str.Find(lhead, "transfer-encoding: chunked") >= 0:
rest = _dechunk_buf(rest)
end
mut rest_str := ""
if str.Find(lhead, "content-encoding: gzip") >= 0:
mut ok := false
decompressed := compress.GzipDecompressBuf(rest, ok)
if ok:
rest_str = compress.BufToStrUnsafe(decompressed)
else:
rest_str = compress.BufToStrUnsafe(rest)
end
else:
rest_str = compress.BufToStrUnsafe(rest)
end
ret head.concat(rest_str)
end
end
func _parse_response(req: str): Response:
sp := req.find(" ")
if sp >= 0:
_g_http_status = req.substr(sp + 1, 3).to_int()
else:
_g_http_status = 0
end
sep_pos := req.find("\r\n\r\n")
if sep_pos >= 0:
_g_http_headers = req.substr(0, sep_pos + 4)
ret Response { status = _g_http_status, body = req.substr(sep_pos + 4, req.len() - sep_pos - 4), head = _g_http_headers, err = _g_http_error }
end
_g_http_headers = ""
ret Response { status = _g_http_status, body = req, head = "", err = _g_http_error }
end
func serialize(headers: HashMap<str, str>): str:
mut out := ""
it := headers.iter()
until it.has_next():
out = out.concat(it.key()).concat(": ").concat(it.value()).concat("\r\n")
it.next()
end
ret out
end
func send(method: str, url_str: str, header_block: str, body: str): Response:
_g_http_status = 0
_g_http_headers = ""
_g_http_error = ""
mut effective_headers := header_block
if body.len() > 0:
if header_block.find("Content-Type") < 0:
effective_headers = header_block.concat("Content-Type: application/x-www-form-urlencoded\r\n")
end
end
req := _fetch_https(method, url_str, effective_headers, body)
ret _parse_response(req)
end
func _hdr_lower(s: str): str:
ret str.Lower(s)
end
@en "NewHeaders"
@fa "سرصفحه جدید"
pub func NewHeaders(): HashMap<str, str>:
m := HashMap {} as HashMap<str, str> ret m
end
@en "Get"
@fa "دریافت"
pub func Get(url: str): Response: ret send("GET", url, "", "") end
@en "Post"
@fa "ارسال"
pub func Post(url: str, body: str): Response: ret send("POST", url, "", body) end
@en "GetWith"
@fa "دریافت با"
pub func GetWith(url: str, headers: HashMap<str, str>): Response:
ret send("GET", url, serialize(headers), "")
end
@en "PostWith"
@fa "ارسال با"
pub func PostWith(url: str, body: str, headers: HashMap<str, str>): Response:
ret send("POST", url, serialize(headers), body)
end
@en "Request"
@fa "درخواست"
pub func Request(method: str, url: str, headers: HashMap<str, str>, body: str): Response:
ret send(method, url, serialize(headers), body)
end
@en "RequestRaw"
@fa "درخواست خام"
pub func RequestRaw(method: str, url: str, header_block: str, body: str): Response:
ret send(method, url, header_block, body)
end
@en "Ok"
@fa "موفق"
pub func Ok(r: Response): bool:
ret r.status >= 200 and r.status < 300
end
@en "Status"
@fa "وضعیت"
pub func Status(r: Response): int:
ret r.status
end
@en "Body"
@fa "بدنه"
pub func Body(r: Response): str:
ret r.body
end
@en "Error"
@fa "خطا"
pub func Error(r: Response): str:
ret r.err
end
@en "Headers"
@fa "سرصفحه ها"
pub func Headers(r: Response): HashMap<str, str>:
m := HashMap {} as HashMap<str, str> lines := r.head.split("\r\n")
defer lines.free()
repeat lines.len() in i:
line := lines.get(i)
c := line.find(":")
if c > 0:
key := line.substr(0, c)
val := line.substr(c + 1, line.len() - c - 1)
m.put(key, val.trim())
end
end
ret m
end
@en "GetHeader"
@fa "دریافت سرصفحه"
pub func GetHeader(r: Response, name: str): str:
target := _hdr_lower(name)
lines := r.head.split("\r\n")
defer lines.free()
mut result := ""
mut found := false
repeat lines.len() in i:
if found == false:
line := lines.get(i)
c := line.find(":")
if c > 0:
if _hdr_lower(line.substr(0, c)) == target:
result = line.substr(c + 1, line.len() - c - 1).trim()
found = true
end
end
end
end
ret result
end
@en "Raw"
@fa "خام"
pub func Raw(r: Response): str:
ret r.head.concat(r.body)
end
@en "RawHeaders"
@fa "سرصفحه های خام"
pub func RawHeaders(r: Response): str:
ret r.head
end
@en "HeaderValues"
@fa "مقادیر سرصفحه"
pub func HeaderValues(r: Response, name: str): Vector<str>:
target := _hdr_lower(name)
out := Vector {} as Vector<str>
lines := r.head.split("\r\n")
defer lines.free()
repeat lines.len() in i:
line := lines.get(i)
c := line.find(":")
if c > 0:
if _hdr_lower(line.substr(0, c)) == target:
out.push(line.substr(c + 1, line.len() - c - 1).trim())
end
end
end
ret out
end
