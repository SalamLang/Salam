ret frame
end
if fx + frame.width > canvas_w or fy + frame.height > canvas_h:
ok = false
Free(frame)
ret New(0, 0)
end
canvas := New(canvas_w, canvas_h)
dst := canvas.pixels as u8*
src := frame.pixels as u8*
repeat frame.height in y:
repeat frame.width * 4 in k:
dst[((fy + y) * canvas_w + fx) * 4 + k] = src[y * frame.width * 4 + k]
end
end
Free(frame)
ret canvas
end
at = body + size + (size % 2)
end
ret New(0, 0)
end
@en "DecodeWebP"
@fa "کدگشایی وب‌پی"
pub func DecodeWebP(p: void*, n: int, ok &: bool): Image:
ok = false
if not IsWebP(p, n):
ret New(0, 0)
end
ret _wpd_chunks(p, 12, n, ok)
end
