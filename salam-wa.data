package opencv
import mem
import image
@en "FromImage"
@fa "از تصویر"
pub func FromImage(img: image.Image): Mat:
if img.pixels == null or img.width <= 0 or img.height <= 0:
ret Mat { handle = null }
end
n := img.width * img.height
buf := mem.Allocate((n * 3) as u64)
defer mem.Free(buf)
src := img.pixels as u8*
dst := buf as u8*
mut i := 0
until i < n:
so := i * 4
do := i * 3
dst[do] = src[so]
dst[do + 1] = src[so + 1]
dst[do + 2] = src[so + 2]
i += 1
end
ret Mat { handle = scv_from_buffer(buf, img.width, img.height, 3) }
end
@en "ToImage"
@fa "به تصویر"
pub func ToImage(m: Mat): image.Image:
if m.handle == null: ret image.New(0, 0) end
w := m.width()
h := m.height()
mut out := image.New(w, h)
mut y := 0
until y < h:
mut x := 0
until x < w:
c := m.at(x, y)
image.SetPixel(out, x, y, image.RGBA(c.r, c.g, c.b, 255))
x += 1
end
y += 1
end
ret out
end
