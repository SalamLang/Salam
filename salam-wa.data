endpoint = "https://s3." + region + ".wasabisys.com", region = region, bucket = bucket, path_style = false
}
end
@en "ForBackblaze"
@fa "برای بک‌بلیز"
pub func ForBackblaze(region: str, bucket: str): Config:
ret Config {
endpoint = "https://s3." + region + ".backblazeb2.com", region = region, bucket = bucket,
path_style = false
}
end
@en "ForEndpoint"
@fa "برای نقطه پایانی"
pub func ForEndpoint(endpoint: str, region: str, bucket: str): Config:
mut cfg := Config {
endpoint = _clean_endpoint(endpoint), bucket = bucket, path_style = true
}
if region.len() > 0: cfg.region = region end
ret cfg
end
@en "FromEnvironment"
@fa "پیکربندی از محیط"
pub func FromEnvironment(bucket: str): Config:
endpoint := _env_first("AWS_ENDPOINT_URL_S3", "AWS_ENDPOINT_URL")
region := _env_first("AWS_REGION", "AWS_DEFAULT_REGION")
mut cfg := Config {}
if endpoint.len() > 0:
cfg.endpoint = _clean_endpoint(endpoint)
cfg.path_style = true
else:
cfg.endpoint = AwsEndpoint(region)
cfg.path_style = false
end
if region.len() > 0: cfg.region = region end
cfg.bucket = bucket
if cfg.bucket.len() == 0: cfg.bucket = env.Get("AWS_S3_BUCKET") end
cfg.access_key = env.Get("AWS_ACCESS_KEY_ID")
cfg.secret_key = env.Get("AWS_SECRET_ACCESS_KEY")
cfg.session_token = env.Get("AWS_SESSION_TOKEN")
forced := env.Get("AWS_S3_FORCE_PATH_STYLE")
if forced.len() > 0: cfg.path_style = _truthy(forced) end
ret cfg
end
@en "CredentialsPath"
@fa "مسیر اعتبارنامه‌ها"
pub func CredentialsPath(): str:
override := env.Get("AWS_SHARED_CREDENTIALS_FILE")
if override.len() > 0: ret override end
home := _home()
if home.len() == 0: ret "" end
ret home + "/.aws/credentials"
end
@en "ConfigPath"
@fa "مسیر پیکربندی"
pub func ConfigPath(): str:
override := env.Get("AWS_CONFIG_FILE")
if override.len() > 0: ret override end
home := _home()
if home.len() == 0: ret "" end
ret home + "/.aws/config"
end
@en "FromProfile"
@fa "پیکربندی از نمایه"
pub func FromProfile(profile: str, bucket: str): Config:
mut name := profile
if name.len() == 0: name = env.Get("AWS_PROFILE") end
if name.len() == 0: name = "default" end
mut cfg := Config { bucket = bucket }
creds_path := CredentialsPath()
if creds_path.len() > 0 and os.Exists(creds_path):
text := os.ReadFile(creds_path)
cfg.access_key = _ini_value(text, name, "aws_access_key_id")
cfg.secret_key = _ini_value(text, name, "aws_secret_access_key")
cfg.session_token = _ini_value(text, name, "aws_session_token")
end
mut region := ""
conf_path := ConfigPath()
if conf_path.len() > 0 and os.Exists(conf_path):
text := os.ReadFile(conf_path)
region = _ini_value(text, name, "region")
if region.len() == 0:
region = _ini_value(text, "profile " + name, "region")
end
end
if region.len() > 0: cfg.region = region end
cfg.endpoint = AwsEndpoint(cfg.region)
cfg.path_style = false
ret cfg
end
@en "ParseIni"
@fa "تجزیه آی ان آی"
pub func ParseIni(text: str, section: str, key: str): str:
ret _ini_value(text, section, key)
end
@en "WithBucket"
@fa "با سطل"
pub func WithBucket(cfg: Config, bucket: str): Config:
mut out := cfg
out.bucket = bucket
ret out
end
@en "WithSessionToken"
@fa "با توکن نشست"
pub func WithSessionToken(cfg: Config, token: str): Config:
mut out := cfg
out.session_token = token
ret out
end
@en "WithRetry"
@fa "با تلاش دوباره"
pub func WithRetry(cfg: Config, attempts: int, base_ms: int): Config:
mut out := cfg
out.retry = attempts
if base_ms > 0: out.retry_base_ms = base_ms end
ret out
end
@en "Describe"
@fa "توصیف پیکربندی"
pub func Describe(cfg: Config): str:
mut mode := "path"
if not cfg.path_style: mode = "virtual-host" end
mut secret := "unset"
if cfg.secret_key.len() > 0:
secret = "set (" + cfg.secret_key.len() + " chars)"
end
mut key := cfg.access_key
if key.len() > 4: key = key.substr(0, 4) + "..." end
if key.len() == 0: key = "unset" end
ret "endpoint=" + cfg.endpoint + " bucket=" + cfg.bucket + " region=" + cfg.region + " addressing=" + mode + " access_key=" + key + " secret=" + secret
end
package aws
import str
import mem
import os
import net.mime
extern:
func fopen(path: str, mode: str): void*
func fread(ptr: void*, size: u64, count: u64, stream: void*): u64
func fwrite(ptr: void*, size: u64, count: u64, stream: void*): u64
func fclose(stream: void*): int
func fseek(stream: void*, offset: i64, whence: int): int
func ftell(stream: void*): i64
func remove(path: str): int
func rename(oldpath: str, newpath: str): int
end
const _S3_DOWNLOAD_CHUNK := 8388608
const _S3_MD5_WIDTH := 16
@en "TransferResult"
@fa "نتیجه انتقال"
pub struct TransferResult:
pub ok: bool = false
pub status: int = 0
pub bytes: i64 = 0
pub parts: int = 0
pub etag: str = ""
pub path: str = ""
pub key: str = ""
pub error: str = ""
pub code: str = ""
end
@en "DirResult"
@fa "نتیجه پوشه"
pub struct DirResult:
pub ok: bool = false
pub files: int = 0
pub bytes: i64 = 0
pub skipped: int = 0
pub failed_path: str = ""
pub error: str = ""
pub code: str = ""
end
func _file_size(path: str): i64:
f := fopen(path, "rb")
if f == null: ret 0 - (1 as i64) end
if fseek(f, 0 as i64, 2) != 0:
fclose(f)
ret 0 - (1 as i64)
end
n := ftell(f)
fclose(f)
ret n
end
func _transfer_failure(res: Result, path: str, key: str): TransferResult:
ret TransferResult {
ok = false, status = res.status, error = res.error, code = res.code, path = path, key = key
}
end
func _content_type_for(path: str, given: str): str:
if given.len() > 0: ret given end
ret mime.MimeType(path)
end
func _read_all(path: str, size: i64, out_len &: int): void*:
out_len = 0
if size <= 0 as i64: ret null end
p := mem.Allocate(size as u64)
if p == null: ret null end
f := fopen(path, "rb")
if f == null:
mem.Free(p)
ret null
end
got := fread(p, 1 as u64, size as u64, f)
fclose(f)
if (got as i64) != size:
mem.Free(p)
ret null
end
out_len = size as int
ret p
end
func _upload_stream(
cfg: Config, key: str, path: str, size: i64, part: int, o: PutOptions
): TransferResult:
buf := mem.Allocate(part as u64)
if buf == null:
ret TransferResult {
error = "no memory for a " + part + "-byte part", path = path, key = key
}
end
defer mem.Free(buf)
f := fopen(path, "rb")
if f == null:
ret TransferResult {
error = "could not open " + path, path = path, key = key
}
end
defer fclose(f)
mut u := S3CreateUpload(cfg, key, o)
if not u.ok:
ret TransferResult {
status = u.status, error = u.error, code = u.code, path = path, key = key
}
end
mut sent := 0 as i64
mut number := 1
until sent < size:
got := fread(buf, 1 as u64, part as u64, f) as int
if got <= 0:
S3AbortUpload(cfg, u)
u.parts.free()
ret TransferResult {
error = path + " ended after " + str.FromInt(sent) + " of " + str.FromInt(size) + " bytes", path = path,
key = key
}
end
res := S3UploadPart(cfg, u, number, buf, got)
if not res.ok:
S3AbortUpload(cfg, u)
u.parts.free()
ret _transfer_failure(res, path, key)
end
sent = sent + (got as i64)
number += 1
end
done := S3CompleteUpload(cfg, u)
count := u.parts.len()
if not done.ok:
S3AbortUpload(cfg, u)
u.parts.free()
ret _transfer_failure(done, path, key)
end
u.parts.free()
ret TransferResult {
ok = true, status = done.status, bytes = size, parts = count, etag = done.etag, path = path, key = key
}
end
func _relative(base: str, path: str): str:
mut rest := path
if base.len() > 0 and str.StartsWith(path, base):
rest = path.substr(base.len(), path.len() - base.len())
end
until rest.len() > 0 and (str.StartsWith(rest, "/") or str.StartsWith(rest, "\\")):
rest = rest.substr(1, rest.len() - 1)
end
ret str.Replace(rest, "\\", "/")
end
func _parent_of(path: str): str:
mut cut := -1
repeat path.len() in i:
c := path[i] as int
if c == 47 or c == 92: cut = i end
end
if cut <= 0: ret "" end
ret path.substr(0, cut)
end
@en "S3UploadFile"
@fa "اس۳ بارگذاری پرونده"
pub func S3UploadFile(
cfg: Config, key: str, path: str, o: PutOptions
): TransferResult:
size := _file_size(path)
if size < 0 as i64:
ret TransferResult {
error = "could not read " + path, path = path, key = key
}
end
mut opts := o
opts.content_type = _content_type_for(path, o.content_type)
part := _part_size_of(o.part_size)
if size > (part as i64):
ret _upload_stream(cfg, key, path, size, part, opts)
end
mut n := 0
body := _read_all(path, size, n)
defer mem.Free(body)
if size > 0 as i64 and body == null:
ret TransferResult {
error = "could not read " + path, path = path, key = key
}
end
res := S3PutBytesWith(cfg, key, body, n, opts)
if not res.ok: ret _transfer_failure(res, path, key) end
ret TransferResult {
ok = true, status = res.status, bytes = size, parts = 1, etag = Unquote(res.etag), path = path, key = key
}
end
@en "S3UploadFileAs"
@fa "اس۳ بارگذاری پرونده با نوع"
pub func S3UploadFileAs(
cfg: Config, key: str, path: str, content_type: str
): TransferResult:
ret S3UploadFile(cfg, key, path, PutOptions { content_type = content_type })
end
@en "S3DownloadFile"
@fa "اس۳ دریافت پرونده"
pub func S3DownloadFile(cfg: Config, key: str, path: str): TransferResult:
info := S3Stat(cfg, key)
if not info.ok:
ret TransferResult {
status = info.status, error = info.error, code = info.code, path = path, key = key
}
end
tmp := path + ".part"
f := fopen(tmp, "wb")
if f == null:
ret TransferResult {
error = "could not create " + tmp, path = path, key = key
}
end
mut at := 0 as i64
mut chunks := 0
until at < info.size:
mut stop := at + (_S3_DOWNLOAD_CHUNK as i64) - (1 as i64)
if stop >= info.size: stop = info.size - (1 as i64) end
mut piece := S3GetRange(cfg, key, at, stop)
if not piece.ok or piece.len <= 0:
fclose(f)
remove(tmp)
mut err := piece.error
if err.len() == 0: err = "the object store returned an empty range" end
FreeBytes(piece)
ret TransferResult {
status = piece.status, error = err, code = piece.code, path = path, key = key
}
end
got := piece.len
written := fwrite(piece.data, 1 as u64, got as u64, f) as int
at = at + (got as i64)
chunks += 1
FreeBytes(piece)
if written != got:
fclose(f)
remove(tmp)
ret TransferResult {
error = "could not write to " + tmp, path = path, key = key
}
end
end
fclose(f)
if rename(tmp, path) != 0:
remove(path)
if rename(tmp, path) != 0:
remove(tmp)
ret TransferResult {
error = "could not move " + tmp + " into place", path = path, key = key
}
end
end
ret TransferResult {
ok = true, status = 200, bytes = info.size, parts = chunks, etag = info.etag, path = path, key = key
}
end
@en "S3UploadDir"
@fa "اس۳ بارگذاری پوشه"
pub func S3UploadDir(
cfg: Config, dir: str, prefix: str, o: PutOptions
): DirResult:
if not os.IsDir(dir):
ret DirResult { error = dir + " is not a directory", code = "NotADirectory" }
end
files := os.Walk(dir) as Vector<str>
defer files.free()
mut out := DirResult { ok = true }
mut base := prefix
if base.len() > 0 and not str.EndsWith(base, "/"): base = base + "/" end
mut i := 0
until i < files.len():
path := files.get(i)
rel := _relative(dir, path)
if rel.len() == 0:
out.skipped += 1
else:
res := S3UploadFile(cfg, base + rel, path, o)
if not res.ok:
out.ok = false
out.failed_path = path
out.error = res.error
out.code = res.code
ret out
end
out.files += 1
out.bytes = out.bytes + res.bytes
end
i += 1
end
ret out
end
@en "S3DownloadPrefix"
@fa "اس۳ دریافت پیشوند"
pub func S3DownloadPrefix(cfg: Config, prefix: str, dir: str): DirResult:
if os.MkdirAll(dir) != 0:
ret DirResult { error = "could not create " + dir, code = "IOError" }
end
listing := S3ListAll(cfg, prefix)
if not listing.ok:
ret DirResult { error = listing.error, code = listing.code }
end
mut out := DirResult { ok = true }
mut i := 0
until i < listing.items.len():
entry := listing.items.get(i)
rel := _relative(prefix, entry.key)
if rel.len() == 0 or str.EndsWith(entry.key, "/"):
out.skipped += 1
else:
path := dir + "/" + rel
parent := _parent_of(path)
if parent.len() > 0: os.MkdirAll(parent) end
res := S3DownloadFile(cfg, entry.key, path)
if not res.ok:
out.ok = false
out.failed_path = path
out.error = res.error
out.code = res.code
ListFree(listing)
ret out
end
out.files += 1
out.bytes = out.bytes + res.bytes
end
i += 1
end
ListFree(listing)
ret out
end
@en "S3FileEtag"
@fa "اس۳ ای‌تگ پرونده"
pub func S3FileEtag(path: str, part_size: int): str:
size := _file_size(path)
if size < 0 as i64: ret "" end
part := _part_size_of(part_size)
f := fopen(path, "rb")
if f == null: ret "" end
defer fclose(f)
buf := mem.Allocate(part as u64)
if buf == null: ret "" end
defer mem.Free(buf)
if size <= part as i64:
got := fread(buf, 1 as u64, size as u64, f) as int
ret S3ContentHashMd5(buf, got)
end
count := ((size + (part as i64) - (1 as i64)) / (part as i64)) as int
digests := mem.Allocate((count * _S3_MD5_WIDTH) as u64)
if digests == null: ret "" end
defer mem.Free(digests)
mut i := 0
until i < count:
got := fread(buf, 1 as u64, part as u64, f) as int
if got <= 0: ret "" end
crypto.Md5Bytes(
buf, got, ((digests as i64) + ((i * _S3_MD5_WIDTH) as i64)) as void*
)
i += 1
end
ret S3ContentHashMd5(digests, count * _S3_MD5_WIDTH) + "-" + count
end
package aws
import str
import encoding.xml
const _S3_LIST_MAX := 1000
const _S3_LIST_ALL_CAP := 100000
const _S3_DELETE_BATCH := 1000
@en "ObjectEntry"
@fa "مدخل شیء"
pub struct ObjectEntry:
pub key: str = ""
pub size: i64 = 0
pub etag: str = ""
pub last_modified: str = ""
pub modified_epoch: i64 = 0
pub storage_class: str = ""
pub owner: str = ""
pub version_id: str = ""
pub is_latest: bool = false
pub delete_marker: bool = false
end
@en "ObjectList"
@fa "فهرست اشیا"
pub struct ObjectList:
pub ok: bool = false
pub status: int = 0
pub items: Vector<ObjectEntry> = Vector {}
pub prefixes: Vector<str> = Vector {}
pub truncated: bool = false
pub next_token: str = ""
pub next_key_marker: str = ""
pub next_version_marker: str = ""
pub key_count: int = 0
pub name: str = ""
pub prefix: str = ""
pub delimiter: str = ""
pub error: str = ""
pub code: str = ""
end
@en "BucketEntry"
@fa "مدخل سطل"
pub struct BucketEntry:
pub name: str = ""
pub created: str = ""
pub created_epoch: i64 = 0
pub region: str = ""
end
@en "BucketList"
@fa "فهرست سطل"
pub struct BucketList:
pub ok: bool = false
pub status: int = 0
pub items: Vector<BucketEntry> = Vector {}
pub owner: str = ""
pub error: str = ""
pub code: str = ""
end
@en "ListOptions"
@fa "گزینه‌های فهرست"
pub struct ListOptions:
pub prefix: str = ""
pub delimiter: str = ""
pub max_keys: int = 0
pub continuation_token: str = ""
pub start_after: str = ""
pub fetch_owner: bool = false
pub url_encode: bool = true
end
@en "KeyList"
@fa "فهرست کلیدها"
pub struct KeyList:
pub items: Vector<str> = Vector {}
end
func _list_query(r &: Request, o: ListOptions, v2: bool):
if o.prefix.len() > 0: SetQuery(r, "prefix", o.prefix) end
if o.delimiter.len() > 0: SetQuery(r, "delimiter", o.delimiter) end
mut n := o.max_keys
if n > _S3_LIST_MAX: n = _S3_LIST_MAX end
if n > 0: SetQueryInt(r, "max-keys", n) end
if o.url_encode: SetQuery(r, "encoding-type", "url") end
if not v2: ret end
if o.continuation_token.len() > 0:
SetQuery(r, "continuation-token", o.continuation_token)
end
if o.start_after.len() > 0: SetQuery(r, "start-after", o.start_after) end
if o.fetch_owner: SetQuery(r, "fetch-owner", "true") end
end
func _entry_of(node: xml.XMLNode, encoded: bool): ObjectEntry:
mut e := ObjectEntry {
key = _decoded(_xml_text(node, "Key"), encoded), size = _xml_int(node, "Size"), etag = Unquote(_xml_text(node, "ETag")),
last_modified = _xml_text(node, "LastModified"), storage_class = _xml_text(node, "StorageClass"),
version_id = _xml_text(node, "VersionId"), is_latest = _xml_bool(node, "IsLatest")
}
e.modified_epoch = _iso_epoch(e.last_modified)
owner := xml.Child(node, "Owner")
if xml.Found(owner):
e.owner = _xml_text(owner, "DisplayName")
if e.owner.len() == 0: e.owner = _xml_text(owner, "ID") end
end
ret e
end
func _fill_prefixes(root: xml.XMLNode, out &: ObjectList, encoded: bool):
group := xml.Children(root, "CommonPrefixes")
mut i := 0
until i < group.items.len():
p := _decoded(_xml_text(group.items.get(i), "Prefix"), encoded)
if p.len() > 0: out.prefixes.push(p) end
i += 1
end
end
func _fill_contents(
root: xml.XMLNode, tag: str, out &: ObjectList, encoded: bool, marker: bool
):
rows := xml.Children(root, tag)
mut i := 0
until i < rows.items.len():
mut e := _entry_of(rows.items.get(i), encoded)
e.delete_marker = marker
out.items.push(e)
i += 1
end
end
func _list_failure(res: Result): ObjectList:
ret ObjectList {
ok = false, status = res.status, error = res.error, code = res.code
}
end
func _parse_list(res: Result): ObjectList:
if not res.ok: ret _list_failure(res) end
mut ok := false
root := xml.DecodeStrict(res.body, ok)
if not ok:
ret ObjectList {
status = res.status, error = "the listing could not be parsed", code = "MalformedXML"
}
end
encoded := _xml_text(root, "EncodingType").lower() == "url"
mut out := ObjectList {
ok = true, status = res.status, name = _xml_text(root, "Name"), prefix = _decoded(_xml_text(root, "Prefix"), encoded),
delimiter = _decoded(_xml_text(root, "Delimiter"), encoded), truncated = _xml_bool(root, "IsTruncated"),
next_token = _xml_text(root, "NextContinuationToken"), next_key_marker = _decoded(_xml_text(root, "NextKeyMarker"), encoded),
next_version_marker = _xml_text(root, "NextVersionIdMarker")
}
if out.next_token.len() == 0:
out.next_token = _decoded(_xml_text(root, "NextMarker"), encoded)
end
_fill_contents(root, "Contents", out, encoded, false)
_fill_contents(root, "Version", out, encoded, false)
_fill_contents(root, "DeleteMarker", out, encoded, true)
_fill_prefixes(root, out, encoded)
out.key_count = out.items.len()
if out.truncated and out.next_token.len() == 0 and out.items.len() > 0:
out.next_token = out.items.get(out.items.len() - 1).key
end
ret out
end
func _delete_body(keys: KeyList, from: int, count: int, quiet: bool): str:
mut sb := str.NewBuilder()
defer str.BufFree(sb)
str.BufAppend(sb, "<Delete>")
if quiet: str.BufAppend(sb, "<Quiet>true</Quiet>") end
mut i := 0
until i < count:
str.BufAppend(sb, "<Object><Key>")
str.BufAppend(sb, _xml_escape(keys.items.get(from + i)))
str.BufAppend(sb, "</Key></Object>")
i += 1
end
str.BufAppend(sb, "</Delete>")
ret str.BufStr(sb)
end
func _list_result(l: ObjectList): Result:
ret Result {
ok = l.ok, status = l.status, error = l.error, code = l.code, length = l.items.len() as i64
}
end
@en "S3List"
@fa "اس۳ فهرست"
pub func S3List(cfg: Config, o: ListOptions): ObjectList:
mut r := NewRequest("GET", "")
SetQuery(r, "list-type", "2")
_list_query(r, o, true)
ret _parse_list(Do(cfg, r))
end
@en "S3ListPrefix"
@fa "اس۳ فهرست پیشوند"
pub func S3ListPrefix(cfg: Config, prefix: str): ObjectList:
ret S3List(cfg, ListOptions { prefix = prefix })
end
@en "S3ListFolder"
@fa "اس۳ فهرست پوشه"
pub func S3ListFolder(cfg: Config, prefix: str): ObjectList:
ret S3List(cfg, ListOptions { prefix = prefix, delimiter = "/" })
end
@en "S3ListV1"
@fa "اس۳ فهرست نسخه یک"
pub func S3ListV1(cfg: Config, o: ListOptions, marker: str): ObjectList:
mut r := NewRequest("GET", "")
_list_query(r, o, false)
if marker.len() > 0: SetQuery(r, "marker", marker) end
ret _parse_list(Do(cfg, r))
end
@en "S3ListAll"
@fa "اس۳ فهرست همه"
pub func S3ListAll(cfg: Config, prefix: str): ObjectList:
ret S3ListAllWith(cfg, ListOptions { prefix = prefix })
end
@en "S3ListAllWith"
@fa "اس۳ فهرست همه با گزینه"
pub func S3ListAllWith(cfg: Config, o: ListOptions): ObjectList:
mut opts := o
mut out := ObjectList { ok = true, prefix = o.prefix, delimiter = o.delimiter }
until true:
page := S3List(cfg, opts)
if not page.ok: ret page end
out.name = page.name
out.status = page.status
mut i := 0
until i < page.items.len():
out.items.push(page.items.get(i))
i += 1
end
mut p := 0
until p < page.prefixes.len():
out.prefixes.push(page.prefixes.get(p))
p += 1
end
if not page.truncated or page.next_token.len() == 0:
out.key_count = out.items.len()
ret out
end
if out.items.len() >= _S3_LIST_ALL_CAP:
out.truncated = true
out.next_token = page.next_token
out.key_count = out.items.len()
ret out
end
if page.next_token == opts.continuation_token:
out.truncated = true
out.next_token = page.next_token
out.key_count = out.items.len()
ret out
end
opts.continuation_token = page.next_token
end
end
@en "S3ListVersions"
@fa "اس۳ فهرست نسخه‌ها"
pub func S3ListVersions(
cfg: Config, o: ListOptions, key_marker: str, version_marker: str
): ObjectList:
mut r := NewRequest("GET", "")
SetFlag(r, "versions")
_list_query(r, o, false)
if key_marker.len() > 0: SetQuery(r, "key-marker", key_marker) end
if version_marker.len() > 0:
SetQuery(r, "version-id-marker", version_marker)
end
ret _parse_list(Do(cfg, r))
end
@en "S3Keys"
@fa "اس۳ کلیدها"
pub func S3Keys(cfg: Config, prefix: str): KeyList:
listing := S3ListAll(cfg, prefix)
mut out := KeyList {}
mut i := 0
until i < listing.items.len():
out.items.push(listing.items.get(i).key)
i += 1
end
ret out
end
@en "ListCount"
@fa "شمار فهرست"
pub func ListCount(l: ObjectList): int: ret l.items.len() end
@en "ListAt"
@fa "مدخل فهرست"
pub func ListAt(l: ObjectList, i: int): ObjectEntry:
if i < 0 or i >= l.items.len(): ret ObjectEntry {} end
ret l.items.get(i)
end
@en "ListPrefixCount"
@fa "شمار پیشوندهای فهرست"
pub func ListPrefixCount(l: ObjectList): int: ret l.prefixes.len() end
@en "ListPrefixAt"
@fa "پیشوند فهرست"
pub func ListPrefixAt(l: ObjectList, i: int): str:
if i < 0 or i >= l.prefixes.len(): ret "" end
ret l.prefixes.get(i)
end
@en "ListTotalSize"
@fa "اندازه کل فهرست"
pub func ListTotalSize(l: ObjectList): i64:
mut total := 0 as i64
mut i := 0
until i < l.items.len():
total = total + l.items.get(i).size
i += 1
end
ret total
end
@en "ListFree"
@fa "آزادسازی فهرست"
pub func ListFree(l &: ObjectList):
l.items.free()
l.prefixes.free()
end
@en "KeyCount"
@fa "شمار کلیدها"
pub func KeyCount(k: KeyList): int: ret k.items.len() end
@en "KeyAt"
@fa "کلید شماره"
pub func KeyAt(k: KeyList, i: int): str:
if i < 0 or i >= k.items.len(): ret "" end
ret k.items.get(i)
end
@en "NewKeyList"
@fa "فهرست کلید جدید"
pub func NewKeyList(): KeyList: ret KeyList {} end
@en "KeyPush"
@fa "افزودن کلید"
pub func KeyPush(k &: KeyList, key: str): k.items.push(key) end
@en "KeyFree"
@fa "آزادسازی کلیدها"
pub func KeyFree(k &: KeyList): k.items.free() end
@en "S3DeleteMany"
@fa "اس۳ حذف چندتایی"
pub func S3DeleteMany(cfg: Config, keys: KeyList): Result:
total := keys.items.len()
if total == 0: ret Result { ok = true, status = 200 } end
mut done := 0
mut last := Result { ok = true, status = 200 }
until done < total:
mut count := total - done
if count > _S3_DELETE_BATCH: count = _S3_DELETE_BATCH end
body := _delete_body(keys, done, count, true)
mut r := NewRequest("POST", "")
SetFlag(r, "delete")
SetText(r, body)
SetHeader(r, "Content-Type", "application/xml")
SetHeader(r, "Content-MD5", S3ContentMd5(body as void*, body.len()))
res := Do(cfg, r)
if not res.ok: ret res end
if res.body.find("<Error>") >= 0:
mut bad := res
bad.ok = false
bad.code = ResultErrorCode(res.body)
bad.error = ResultErrorMessage(res.body, res.status)
ret bad
end
last = res
done += count
end
ret last
end
@en "S3DeletePrefix"
@fa "اس۳ حذف پیشوند"
pub func S3DeletePrefix(cfg: Config, prefix: str): Result:
if prefix.len() == 0:
ret Failure("refusing to delete every object in the bucket; pass a prefix")
end
mut token := ""
mut removed := 0
until true:
page := S3List(
cfg, ListOptions {
prefix = prefix, continuation_token = token, max_keys = _S3_LIST_MAX
}
)
if not page.ok: ret _list_result(page) end
if page.items.len() == 0:
ret Result { ok = true, status = 200, length = removed as i64 }
end
mut batch := KeyList {}
mut i := 0
until i < page.items.len():
batch.items.push(page.items.get(i).key)
i += 1
end
res := S3DeleteMany(cfg, batch)
batch.items.free()
if not res.ok: ret res end
removed += page.items.len()
if not page.truncated or page.next_token.len() == 0:
ret Result { ok = true, status = 200, length = removed as i64 }
end
if page.next_token == token:
ret Failure("the listing stopped advancing at " + page.next_token)
end
token = page.next_token
end
end
@en "ListToResult"
@fa "فهرست به نتیجه"
pub func ListToResult(l: ObjectList): Result:
ret _list_result(l)
end
@en "ParseListing"
@fa "تجزیه فهرست"
pub func ParseListing(body: str, status: int): ObjectList:
ret _parse_list(
Result {
ok = status >= 200 and status < 300, status = status, body = body
}
)
end
package aws
import str
import encoding.xml
@en "S3_PART_MIN"
@fa "کمینه اندازه بخش"
pub const S3_PART_MIN := 5242880
@en "S3_PART_MAX_COUNT"
@fa "بیشینه شمار بخش‌ها"
pub const S3_PART_MAX_COUNT := 10000
@en "S3_PART_DEFAULT"
@fa "اندازه پیش‌فرض بخش"
pub const S3_PART_DEFAULT := 8388608
const _S3_MD5_SIZE := 16
@en "PartRef"
@fa "مرجع بخش"
pub struct PartRef:
pub number: int = 0
pub etag: str = ""
pub size: i64 = 0
end
@en "Upload"
@fa "بارگذاری چندبخشی"
pub struct Upload:
pub ok: bool = false
pub status: int = 0
pub upload_id: str = ""
pub key: str = ""
pub bucket: str = ""
pub parts: Vector<PartRef> = Vector {}
pub error: str = ""
pub code: str = ""
end
@en "PartList"
@fa "فهرست بخش‌ها"
pub struct PartList:
pub ok: bool = false
pub status: int = 0
pub items: Vector<PartRef> = Vector {}
pub truncated: bool = false
pub next_marker: str = ""
pub error: str = ""
pub code: str = ""
end
@en "UploadRef"
@fa "مرجع بارگذاری"
pub struct UploadRef:
pub key: str = ""
pub upload_id: str = ""
pub initiated: str = ""
pub initiated_epoch: i64 = 0
pub storage_class: str = ""
end
@en "UploadList"
@fa "فهرست بارگذاری‌ها"
pub struct UploadList:
pub ok: bool = false
pub status: int = 0
pub items: Vector<UploadRef> = Vector {}
pub truncated: bool = false
pub next_key_marker: str = ""
pub next_upload_marker: str = ""
pub error: str = ""
pub code: str = ""
end
func _upload_failure(res: Result): Upload:
ret Upload {
ok = false, status = res.status, error = res.error, code = res.code
}
end
func _complete_body(u: Upload): str:
mut sb := str.NewBuilder()
defer str.BufFree(sb)
str.BufAppend(sb, "<CompleteMultipartUpload>")
mut i := 0
until i < u.parts.len():
p := u.parts.get(i)
str.BufAppend(sb, "<Part><PartNumber>")
str.BufAppendInt(sb, p.number as i64)
str.BufAppend(sb, "</PartNumber><ETag>&quot;")
str.BufAppend(sb, _xml_escape(Unquote(p.etag)))
str.BufAppend(sb, "&quot;</ETag></Part>")
i += 1
end
str.BufAppend(sb, "</CompleteMultipartUpload>")
ret str.BufStr(sb)
end
func _sorted_parts(u: Upload): Upload:
mut out := u
mut sorted := Vector {} as Vector<PartRef>
mut i := 0
until i < u.parts.len():
p := u.parts.get(i)
mut at := sorted.len()
mut j := 0
until j < sorted.len():
if sorted.get(j).number > p.number:
at = j
j = sorted.len()
else:
j += 1
end
end
sorted.push(p)
mut k := sorted.len() - 1
until k > at:
sorted.set(k, sorted.get(k - 1))
k -= 1
end
sorted.set(at, p)
i += 1
end
out.parts = sorted
ret out
end
func _part_size_of(want: int): int:
mut size := want
if size <= 0: size = S3_PART_DEFAULT end
if size < S3_PART_MIN: size = S3_PART_MIN end
ret size
end
func _md5_into(p: void*, n: int, out: void*):
crypto.Md5Bytes(p, n, out)
end
@en "S3CreateUpload"
@fa "اس۳ آغاز بارگذاری"
pub func S3CreateUpload(cfg: Config, key: str, o: PutOptions): Upload:
mut r := NewRequest("POST", key)
SetFlag(r, "uploads")
_apply_put(r, o)
res := Do(cfg, r)
if not res.ok: ret _upload_failure(res) end
mut ok := false
root := xml.DecodeStrict(res.body, ok)
id := _xml_text(root, "UploadId")
if not ok or id.len() == 0:
ret Upload {
status = res.status, error = "the upload id could not be read from the answer", code = "MalformedXML"
}
end
ret Upload {
ok = true, status = res.status, upload_id = id, key = key, bucket = _xml_text(root, "Bucket")
}
end
@en "S3UploadPart"
@fa "اس۳ بارگذاری بخش"
pub func S3UploadPart(
cfg: Config, u &: Upload, number: int, data: void*, n: int
): Result:
if not u.ok or u.upload_id.len() == 0:
ret Failure("the upload was never created")
end
if number < 1 or number > S3_PART_MAX_COUNT:
ret Failure("a part number must be between 1 and 10000")
end
mut r := NewRequest("PUT", u.key)
SetQueryInt(r, "partNumber", number)
SetQuery(r, "uploadId", u.upload_id)
SetBody(r, data, n)
res := Do(cfg, r)
if not res.ok: ret res end
etag := Unquote(res.etag)
if etag.len() == 0:
ret Failure("the service accepted part " + number + " without an ETag")
end
u.parts.push(PartRef { number = number, etag = etag, size = n as i64 })
ret res
end
@en "S3UploadPartCopy"
@fa "اس۳ رونوشت بخش"
pub func S3UploadPartCopy(
cfg: Config, u &: Upload, number: int, src_key: str, o: CopyOptions, start: i64, stop: i64
): Result:
if not u.ok or u.upload_id.len() == 0:
ret Failure("the upload was never created")
end
mut r := NewRequest("PUT", u.key)
SetQueryInt(r, "partNumber", number)
SetQuery(r, "uploadId", u.upload_id)
SetHeader(r, "x-amz-copy-source", _copy_source(cfg, src_key, o))
if start >= 0 and stop >= start:
SetHeader(
r, "x-amz-copy-source-range", "bytes=" + str.FromInt(start) + "-" + str.FromInt(stop)
)
end
res := Do(cfg, r)
if not res.ok: ret res end
etag := Unquote(ResultTag(res.body, "ETag").trim())
if etag.len() == 0:
ret Failure("the copied part " + number + " came back without an ETag")
end
mut size := 0 as i64
if start >= 0 and stop >= start: size = stop - start + (1 as i64) end
u.parts.push(PartRef { number = number, etag = etag, size = size })
ret res
end
@en "S3CompleteUpload"
@fa "اس۳ تکمیل بارگذاری"
pub func S3CompleteUpload(cfg: Config, u: Upload): Result:
if not u.ok or u.upload_id.len() == 0:
ret Failure("the upload was never created")
end
if u.parts.len() == 0:
ret Failure("an upload cannot be completed with no parts")
end
mut ordered := _sorted_parts(u)
body := _complete_body(ordered)
ordered.parts.free()
mut r := NewRequest("POST", u.key)
SetQuery(r, "uploadId", u.upload_id)
SetText(r, body)
SetHeader(r, "Content-Type", "application/xml")
res := Do(cfg, r)
if not res.ok: ret res end
if res.body.find("<Error") >= 0 or ResultErrorCode(res.body).len() > 0:
mut bad := res
bad.ok = false
bad.code = ResultErrorCode(res.body)
bad.error = ResultErrorMessage(res.body, res.status)
ret bad
end
mut out := res
out.etag = Unquote(ResultTag(res.body, "ETag").trim())
ret out
end
@en "S3AbortUpload"
@fa "اس۳ لغو بارگذاری"
pub func S3AbortUpload(cfg: Config, u: Upload): Result:
if u.upload_id.len() == 0: ret Failure("the upload was never created") end
mut r := NewRequest("DELETE", u.key)
SetQuery(r, "uploadId", u.upload_id)
ret Do(cfg, r)
end
@en "S3ListParts"
@fa "اس۳ فهرست بخش‌ها"
pub func S3ListParts(cfg: Config, key: str, upload_id: str): PartList:
mut r := NewRequest("GET", key)
SetQuery(r, "uploadId", upload_id)
res := Do(cfg, r)
if not res.ok:
ret PartList { status = res.status, error = res.error, code = res.code }
end
mut ok := false
root := xml.DecodeStrict(res.body, ok)
if not ok:
ret PartList {
status = res.status, error = "the part listing could not be parsed", code = "MalformedXML"
}
end
mut out := PartList {
ok = true, status = res.status, truncated = _xml_bool(root, "IsTruncated"), next_marker = _xml_text(root, "NextPartNumberMarker")
}
rows := xml.Children(root, "Part")
mut i := 0
until i < rows.items.len():
node := rows.items.get(i)
out.items.push(
PartRef {
number = _xml_text(node, "PartNumber").to_int(), etag = Unquote(_xml_text(node, "ETag")), size = _xml_int(node, "Size")
}
)
i += 1
end
ret out
end
@en "S3ListUploads"
@fa "اس۳ فهرست بارگذاری‌ها"
pub func S3ListUploads(cfg: Config, prefix: str): UploadList:
mut r := NewRequest("GET", "")
SetFlag(r, "uploads")
if prefix.len() > 0: SetQuery(r, "prefix", prefix) end
res := Do(cfg, r)
if not res.ok:
ret UploadList { status = res.status, error = res.error, code = res.code }
end
mut ok := false
root := xml.DecodeStrict(res.body, ok)
if not ok:
ret UploadList {
status = res.status, error = "the upload listing could not be parsed", code = "MalformedXML"
}
end
mut out := UploadList {
ok = true, status = res.status, truncated = _xml_bool(root, "IsTruncated"), next_key_marker = _xml_text(root, "NextKeyMarker"),
next_upload_marker = _xml_text(root, "NextUploadIdMarker")
}
rows := xml.Children(root, "Upload")
mut i := 0
until i < rows.items.len():
node := rows.items.get(i)
mut u := UploadRef {
key = _xml_text(node, "Key"), upload_id = _xml_text(node, "UploadId"), initiated = _xml_text(node, "Initiated"),
storage_class = _xml_text(node, "StorageClass")
}
u.initiated_epoch = _iso_epoch(u.initiated)
out.items.push(u)
i += 1
end
ret out
end
@en "S3PutLarge"
@fa "اس۳ نوشتن بزرگ"
pub func S3PutLarge(
cfg: Config, key: str, data: void*, n: int, part_size: int, o: PutOptions
): Result:
size := _part_size_of(part_size)
if n <= size: ret S3PutBytesWith(cfg, key, data, n, o) end
if n / size >= S3_PART_MAX_COUNT:
ret Failure("the part size is too small for an object of " + n + " bytes")
end
mut u := S3CreateUpload(cfg, key, o)
if not u.ok:
ret Result { status = u.status, error = u.error, code = u.code }
end
mut sent := 0
mut number := 1
until sent < n:
mut count := n - sent
if count > size: count = size end
chunk := ((data as i64) + (sent as i64)) as void*
res := S3UploadPart(cfg, u, number, chunk, count)
if not res.ok:
S3AbortUpload(cfg, u)
u.parts.free()
ret res
end
sent += count
number += 1
end
done := S3CompleteUpload(cfg, u)
if not done.ok: S3AbortUpload(cfg, u) end
u.parts.free()
ret done
end
@en "S3CopyLarge"
@fa "اس۳ رونوشت بزرگ"
pub func S3CopyLarge(
cfg: Config, src_key: str, dst_key: str, part_size: int, o: CopyOptions
): Result:
mut src_cfg := cfg
if o.source_bucket.len() > 0: src_cfg.bucket = o.source_bucket end
info := S3Stat(src_cfg, src_key)
if not info.ok:
ret Result { status = info.status, error = info.error, code = info.code }
end
size := _part_size_of(part_size) as i64
if info.size <= size: ret S3CopyWith(cfg, src_key, dst_key, o) end
mut u := S3CreateUpload(
cfg, dst_key, PutOptions {
content_type = o.content_type, cache_control = o.cache_control, storage_class = o.storage_class,
acl = o.acl, sse = o.sse, meta = o.meta
}
)
if not u.ok:
ret Result { status = u.status, error = u.error, code = u.code }
end
mut at := 0 as i64
mut number := 1
until at < info.size:
mut stop := at + size - (1 as i64)
if stop >= info.size: stop = info.size - (1 as i64) end
res := S3UploadPartCopy(cfg, u, number, src_key, o, at, stop)
if not res.ok:
S3AbortUpload(cfg, u)
u.parts.free()
ret res
end
at = stop + (1 as i64)
number += 1
end
done := S3CompleteUpload(cfg, u)
if not done.ok: S3AbortUpload(cfg, u) end
u.parts.free()
ret done
end
@en "S3MultipartEtag"
@fa "اس۳ ای‌تگ چندبخشی"
pub func S3MultipartEtag(data: void*, n: int, part_size: int): str:
size := _part_size_of(part_size)
if n <= size: ret S3ContentHashMd5(data, n) end
count := (n + size - 1) / size
digests := mem.Allocate((count * _S3_MD5_SIZE) as u64)
if digests == null: ret "" end
defer mem.Free(digests)
mut i := 0
until i < count:
off := i * size
mut take := n - off
if take > size: take = size end
_md5_into(
((data as i64) + (off as i64)) as void*, take, ((digests as i64) + ((i * _S3_MD5_SIZE) as i64)) as void*
)
i += 1
end
outer := mem.Allocate(_S3_MD5_SIZE as u64)
if outer == null: ret "" end
defer mem.Free(outer)
_md5_into(digests, count * _S3_MD5_SIZE, outer)
ret _hex(outer, _S3_MD5_SIZE) + "-" + count
end
@en "S3ContentHashMd5"
@fa "اس۳ چکیده محتوا با ام دی۵"
pub func S3ContentHashMd5(data: void*, n: int): str:
digest := mem.Allocate(_S3_MD5_SIZE as u64)
if digest == null: ret "" end
defer mem.Free(digest)
_md5_into(data, n, digest)
ret _hex(digest, _S3_MD5_SIZE)
end
@en "PartCount"
@fa "شمار بخش‌ها"
pub func PartCount(p: PartList): int: ret p.items.len() end
@en "PartAt"
@fa "بخش شماره"
pub func PartAt(p: PartList, i: int): PartRef:
if i < 0 or i >= p.items.len(): ret PartRef {} end
ret p.items.get(i)
end
@en "UploadCount"
@fa "شمار بارگذاری‌ها"
pub func UploadCount(u: UploadList): int: ret u.items.len() end
@en "UploadAt"
@fa "بارگذاری شماره"
pub func UploadAt(u: UploadList, i: int): UploadRef:
if i < 0 or i >= u.items.len(): ret UploadRef {} end
ret u.items.get(i)
end
@en "UploadParts"
@fa "بخش‌های بارگذاری"
pub func UploadParts(u: Upload): int: ret u.parts.len() end
@en "UploadBytes"
@fa "بایت‌های بارگذاری"
pub func UploadBytes(u: Upload): i64:
mut total := 0 as i64
mut i := 0
until i < u.parts.len():
total = total + u.parts.get(i).size
i += 1
end
ret total
end
@en "UploadFreeParts"
@fa "آزادسازی بخش‌ها"
pub func UploadFreeParts(u &: Upload): u.parts.free() end
package aws
import str
import time
import encoding
import net.httpx
const _S3_MAX_EXPIRES := 604800
@en "PresignOptions"
@fa "گزینه‌های پیش‌امضا"
pub struct PresignOptions:
pub expires: int = 0
pub version_id: str = ""
pub content_type: str = ""
pub acl: str = ""
pub storage_class: str = ""
pub response_content_type: str = ""
pub response_content_disposition: str = ""
pub response_cache_control: str = ""
end
@en "PostOptions"
@fa "گزینه‌های فرم"
pub struct PostOptions:
pub expires: int = 0
pub key_is_prefix: bool = false
pub content_type: str = ""
pub content_type_is_prefix: bool = false
pub acl: str = ""
pub cache_control: str = ""
pub storage_class: str = ""
pub min_bytes: i64 = 0
pub max_bytes: i64 = 0
pub success_status: str = ""
pub success_redirect: str = ""
pub meta: Headers = Headers {}
end
@en "PostForm"
@fa "فرم ارسال"
pub struct PostForm:
pub ok: bool = false
pub url: str = ""
pub fields: Headers = Headers {}
pub policy: str = ""
pub error: str = ""
end
func _origin(ep: httpx.Endpoint, host: str): str:
if ep.secure: ret "https://" + host end
ret "http://" + host
end
func _expiry_of(cfg: Config, want: int): int:
mut secs := want
if secs <= 0: secs = cfg.expires end
if secs <= 0: secs = 900 end
if secs > _S3_MAX_EXPIRES: secs = _S3_MAX_EXPIRES end
ret secs
end
func _presign_query(
cfg: Config, amz_date: str, expires: int, signed: str, o: PresignOptions
): Headers:
mut q := Headers {}
HeaderSet(q, "X-Amz-Algorithm", ALGORITHM)
HeaderSet(
q, "X-Amz-Credential", cfg.access_key + "/" + Scope(DateStamp(amz_date), cfg.region, cfg.service)
)
HeaderSet(q, "X-Amz-Date", amz_date)
HeaderSet(q, "X-Amz-Expires", "" + expires)
HeaderSet(q, "X-Amz-SignedHeaders", signed)
if cfg.session_token.len() > 0:
HeaderSet(q, "X-Amz-Security-Token", cfg.session_token)
end
if o.version_id.len() > 0: HeaderSet(q, "versionId", o.version_id) end
if o.response_content_type.len() > 0:
HeaderSet(q, "response-content-type", o.response_content_type)
end
if o.response_content_disposition.len() > 0:
HeaderSet(q, "response-content-disposition", o.response_content_disposition)
end
if o.response_cache_control.len() > 0:
HeaderSet(q, "response-cache-control", o.response_cache_control)
end
ret q
end
func _presign_headers(host: str, o: PresignOptions): Headers:
mut h := Headers {}
HeaderSet(h, "host", host)
if o.content_type.len() > 0: HeaderSet(h, "content-type", o.content_type) end
if o.acl.len() > 0: HeaderSet(h, "x-amz-acl", o.acl) end
if o.storage_class.len() > 0:
HeaderSet(h, "x-amz-storage-class", o.storage_class)
end
ret h
end
func _json_escape(s: str): str:
mut sb := str.NewBuilder()
defer str.BufFree(sb)
repeat s.len() in i:
c := s[i] as int
if c == 34: str.BufAppend(sb, "\\\"")
else c == 92: str.BufAppend(sb, "\\\\")
else c == 10: str.BufAppend(sb, "\\n")
else c == 13: str.BufAppend(sb, "\\r")
else c == 9: str.BufAppend(sb, "\\t")
else c < 32: str.BufAppend(sb, " ")
else:
str.BufAppendChar(sb, c)
end
end
ret str.BufStr(sb)
end
func _attr_escape(s: str): str:
mut out := str.Replace(s, "&", "&amp;")
out = str.Replace(out, "\"", "&quot;")
out = str.Replace(out, "<", "&lt;")
ret str.Replace(out, ">", "&gt;")
end
func _cond_exact(name: str, value: str): str:
ret "{\"" + _json_escape(name) + "\":\"" + _json_escape(value) + "\"}"
end
func _cond_starts(name: str, value: str): str:
ret "[\"starts-with\",\"$" + _json_escape(name) + "\",\"" + _json_escape(value) + "\"]"
end
func _post_fields(cfg: Config, key: str, amz_date: str, o: PostOptions): Headers:
mut f := Headers {}
HeaderSet(f, "key", key)
HeaderSet(f, "x-amz-algorithm", ALGORITHM)
HeaderSet(
f, "x-amz-credential", cfg.access_key + "/" + Scope(DateStamp(amz_date), cfg.region, cfg.service)
)
HeaderSet(f, "x-amz-date", amz_date)
if cfg.session_token.len() > 0:
HeaderSet(f, "x-amz-security-token", cfg.session_token)
end
if o.acl.len() > 0: HeaderSet(f, "acl", o.acl) end
if o.cache_control.len() > 0: HeaderSet(f, "Cache-Control", o.cache_control) end
if o.storage_class.len() > 0:
HeaderSet(f, "x-amz-storage-class", o.storage_class)
end
if o.content_type.len() > 0 and not o.content_type_is_prefix:
HeaderSet(f, "Content-Type", o.content_type)
end
if o.success_status.len() > 0:
HeaderSet(f, "success_action_status", o.success_status)
end
if o.success_redirect.len() > 0:
HeaderSet(f, "success_action_redirect", o.success_redirect)
end
mut i := 0
until i < o.meta.names.len():
HeaderSet(
f, "x-amz-meta-" + o.meta.names.get(i).lower(), o.meta.values.get(i)
)
i += 1
end
ret f
end
func _post_policy(
cfg: Config, expiry_iso: str, fields: Headers, o: PostOptions
): str:
mut sb := str.NewBuilder()
defer str.BufFree(sb)
str.BufAppend(sb, "{\"expiration\":\"")
str.BufAppend(sb, expiry_iso)
str.BufAppend(sb, "\",\"conditions\":[")
str.BufAppend(sb, _cond_exact("bucket", cfg.bucket))
mut i := 0
until i < fields.names.len():
name := fields.names.get(i)
value := fields.values.get(i)
str.BufAppend(sb, ",")
if name == "key" and o.key_is_prefix:
str.BufAppend(sb, _cond_starts("key", value))
else:
str.BufAppend(sb, _cond_exact(name, value))
end
i += 1
end
if o.content_type.len() > 0 and o.content_type_is_prefix:
str.BufAppend(sb, ",")
str.BufAppend(sb, _cond_starts("Content-Type", o.content_type))
end
if o.max_bytes > 0:
str.BufAppend(sb, ",[\"content-length-range\",")
str.BufAppendInt(sb, o.min_bytes)
str.BufAppend(sb, ",")
str.BufAppendInt(sb, o.max_bytes)
str.BufAppend(sb, "]")
end
str.BufAppend(sb, "]}")
ret str.BufStr(sb)
end
@en "S3Url"
@fa "اس۳ نشانی"
pub func S3Url(cfg: Config, key: str): str:
ep := httpx.ParseEndpoint(cfg.endpoint)
if not ep.ok: ret "" end
ret _origin(ep, _wire_host(cfg, ep, cfg.bucket)) + _wire_path(cfg, cfg.bucket, key)
end
@en "S3Presign"
@fa "اس۳ پیش‌امضا"
pub func S3Presign(cfg: Config, method: str, key: str, expires: int): str:
ret S3PresignAt(cfg, method, key, expires, time.Now())
end
@en "S3PresignAt"
@fa "اس۳ پیش‌امضا با زمان"
pub func S3PresignAt(
cfg: Config, method: str, key: str, expires: int, epoch_seconds: i64
): str:
ret S3PresignWith(
cfg, method, key, PresignOptions { expires = expires }, epoch_seconds
)
end
@en "S3PresignWith"
@fa "اس۳ پیش‌امضا با گزینه"
pub func S3PresignWith(
cfg: Config, method: str, key: str, o: PresignOptions, epoch_seconds: i64
): str:
if not Configured(cfg): ret "" end
ep := httpx.ParseEndpoint(cfg.endpoint)
if not ep.ok: ret "" end
host := _wire_host(cfg, ep, cfg.bucket)
path := _wire_path(cfg, cfg.bucket, key)
amz_date := AmzDate(epoch_seconds)
headers := _presign_headers(host, o)
mut signed_names := ""
canonical := _canon_headers(headers, signed_names)
query := _canon_query(
_presign_query(
cfg, amz_date, _expiry_of(cfg, o.expires), signed_names, o
)
)
signature := SignQueryHeaders(
cfg, method, path, query, canonical, signed_names, epoch_seconds
)
if signature.len() == 0: ret "" end
ret _origin(ep, host) + path + "?" + query + "&X-Amz-Signature=" + signature
end
@en "S3PresignGet"
@fa "اس۳ پیش‌امضای خواندن"
pub func S3PresignGet(cfg: Config, key: str, expires: int): str:
ret S3PresignAt(cfg, "GET", key, expires, time.Now())
end
@en "S3PresignPut"
@fa "اس۳ پیش‌امضای نوشتن"
pub func S3PresignPut(
cfg: Config, key: str, content_type: str, expires: int
): str:
ret S3PresignWith(
cfg, "PUT", key, PresignOptions { expires = expires, content_type = content_type }, time.Now()
)
end
@en "S3PresignDownload"
@fa "اس۳ پیش‌امضای دانلود"
pub func S3PresignDownload(
cfg: Config, key: str, filename: str, expires: int
): str:
ret S3PresignWith(
cfg, "GET", key, PresignOptions {
expires = expires, response_content_disposition = "attachment; filename=\"" + filename + "\""
}, time.Now()
)
end
@en "S3PresignPost"
@fa "اس۳ پیش‌امضای فرم"
pub func S3PresignPost(cfg: Config, key: str, o: PostOptions): PostForm:
ret S3PresignPostAt(cfg, key, o, time.Now())
end
@en "S3PresignPostAt"
@fa "اس۳ پیش‌امضای فرم با زمان"
pub func S3PresignPostAt(
cfg: Config, key: str, o: PostOptions, epoch_seconds: i64
): PostForm:
if not Configured(cfg):
ret PostForm { error = "the object store is not configured" }
end
ep := httpx.ParseEndpoint(cfg.endpoint)
if not ep.ok:
ret PostForm { error = "the endpoint could not be parsed: " + cfg.endpoint }
end
amz_date := AmzDate(epoch_seconds)
expiry := epoch_seconds + (_expiry_of(cfg, o.expires) as i64)
mut fields := _post_fields(cfg, key, amz_date, o)
policy := _post_policy(cfg, time.FormatISOUTC(expiry), fields, o)
encoded := encoding.Base64Encode(policy)
signature := SignString(cfg, DateStamp(amz_date), encoded)
if signature.len() == 0:
ret PostForm { error = "the policy could not be signed" }
end
HeaderSet(fields, "policy", encoded)
HeaderSet(fields, "x-amz-signature", signature)
host := _wire_host(cfg, ep, cfg.bucket)
mut url := _origin(ep, host)
if cfg.path_style: url = url + "/" + cfg.bucket end
ret PostForm { ok = true, url = url, fields = fields, policy = policy }
end
@en "PostFormHtml"
@fa "اچ تی ام ال فرم ارسال"
pub func PostFormHtml(f: PostForm, file_field: str): str:
if not f.ok: ret "" end
mut name := file_field
if name.len() == 0: name = "file" end
mut sb := str.NewBuilder()
defer str.BufFree(sb)
str.BufAppend(sb, "<form action=\"")
str.BufAppend(sb, f.url)
str.BufAppend(sb, "\" method=\"post\" enctype=\"multipart/form-data\">\n")
mut i := 0
until i < f.fields.names.len():
str.BufAppend(sb, "  <input type=\"hidden\" name=\"")
str.BufAppend(sb, f.fields.names.get(i))
str.BufAppend(sb, "\" value=\"")
str.BufAppend(sb, _attr_escape(f.fields.values.get(i)))
str.BufAppend(sb, "\">\n")
i += 1
end
str.BufAppend(sb, "  <input type=\"file\" name=\"")
str.BufAppend(sb, name)
str.BufAppend(sb, "\">\n  <button type=\"submit\">Upload</button>\n</form>")
ret str.BufStr(sb)
end
package aws
import str
const _S3_TAG_MAX := 50
func _object_tag_request(method: str, key: str, version_id: str): Request:
mut r := NewRequest(method, key)
SetFlag(r, "tagging")
if version_id.len() > 0: SetQuery(r, "versionId", version_id) end
ret r
end
@en "NewTags"
@fa "برچسب‌های جدید"
pub func NewTags(): Headers: ret Headers {} end
@en "TagSet"
@fa "تنظیم برچسب"
pub func TagSet(h &: Headers, name: str, value: str): HeaderSet(h, name, value) end
@en "TagString"
@fa "متن برچسب‌ها"
pub func TagString(tags: Headers): str:
mut sb := str.NewBuilder()
defer str.BufFree(sb)
mut i := 0
until i < tags.names.len():
if i > 0: str.BufAppend(sb, "&") end
str.BufAppend(sb, UriEncode(tags.names.get(i), false))
str.BufAppend(sb, "=")
str.BufAppend(sb, UriEncode(tags.values.get(i), false))
i += 1
end
ret str.BufStr(sb)
end
@en "S3SetObjectTags"
@fa "اس۳ تنظیم برچسب شیء"
pub func S3SetObjectTags(cfg: Config, key: str, tags: Headers): Result:
if tags.names.len() > _S3_TAG_MAX:
ret Failure("an object may carry at most " + _S3_TAG_MAX + " tags")
end
mut r := _object_tag_request("PUT", key, "")
body := _tag_body(tags)
SetText(r, body)
SetHeader(r, "Content-Type", "application/xml")
SetHeader(r, "Content-MD5", S3ContentMd5(body as void*, body.len()))
ret Do(cfg, r)
end
@en "S3ObjectTags"
@fa "اس۳ برچسب شیء"
pub func S3ObjectTags(cfg: Config, key: str): Headers:
ret _parse_tags(Do(cfg, _object_tag_request("GET", key, "")))
end
@en "S3ObjectTagsVersion"
@fa "اس۳ برچسب نسخه"
pub func S3ObjectTagsVersion(cfg: Config, key: str, version_id: str): Headers:
ret _parse_tags(Do(cfg, _object_tag_request("GET", key, version_id)))
end
@en "S3DeleteObjectTags"
@fa "اس۳ حذف برچسب شیء"
pub func S3DeleteObjectTags(cfg: Config, key: str): Result:
ret Do(cfg, _object_tag_request("DELETE", key, ""))
end
@en "S3AddObjectTag"
@fa "اس۳ افزودن برچسب شیء"
pub func S3AddObjectTag(cfg: Config, key: str, name: str, value: str): Result:
mut tags := S3ObjectTags(cfg, key)
HeaderSet(tags, name, value)
res := S3SetObjectTags(cfg, key, tags)
HeaderFree(tags)
ret res
end
@en "S3SetObjectAcl"
@fa "اس۳ تنظیم دسترسی شیء"
pub func S3SetObjectAcl(cfg: Config, key: str, acl: str): Result:
mut r := NewRequest("PUT", key)
SetFlag(r, "acl")
SetHeader(r, "x-amz-acl", acl)
ret Do(cfg, r)
end
@en "S3ObjectAcl"
@fa "اس۳ دسترسی شیء"
pub func S3ObjectAcl(cfg: Config, key: str): str:
mut r := NewRequest("GET", key)
SetFlag(r, "acl")
res := Do(cfg, r)
if not res.ok: ret "" end
ret res.body
end
@en "S3MakePublic"
@fa "اس۳ عمومی کردن"
pub func S3MakePublic(cfg: Config, key: str): Result:
ret S3SetObjectAcl(cfg, key, "public-read")
end
@en "S3MakePrivate"
@fa "اس۳ خصوصی کردن"
pub func S3MakePrivate(cfg: Config, key: str): Result:
ret S3SetObjectAcl(cfg, key, "private")
end
@en "S3SetLegalHold"
@fa "اس۳ تنظیم توقیف قانونی"
pub func S3SetLegalHold(cfg: Config, key: str, held: bool): Result:
mut r := NewRequest("PUT", key)
SetFlag(r, "legal-hold")
mut state := "OFF"
if held: state = "ON" end
body := "<LegalHold><Status>" + state + "</Status></LegalHold>"
SetText(r, body)
SetHeader(r, "Content-Type", "application/xml")
SetHeader(r, "Content-MD5", S3ContentMd5(body as void*, body.len()))
ret Do(cfg, r)
end
@en "S3LegalHold"
@fa "اس۳ توقیف قانونی"
pub func S3LegalHold(cfg: Config, key: str): bool:
mut r := NewRequest("GET", key)
SetFlag(r, "legal-hold")
res := Do(cfg, r)
if not res.ok: ret false end
ret ResultTag(res.body, "Status").trim().upper() == "ON"
end
@en "S3SetRetention"
@fa "اس۳ تنظیم نگهداری"
pub func S3SetRetention(
cfg: Config, key: str, mode: str, until_epoch: i64
): Result:
mut r := NewRequest("PUT", key)
SetFlag(r, "retention")
mut m := mode.upper()
if m != "COMPLIANCE": m = "GOVERNANCE" end
body := "<Retention><Mode>" + m + "</Mode><RetainUntilDate>" + time.FormatISOUTC(until_epoch) + "</RetainUntilDate></Retention>"
SetText(r, body)
SetHeader(r, "Content-Type", "application/xml")
SetHeader(r, "Content-MD5", S3ContentMd5(body as void*, body.len()))
ret Do(cfg, r)
end
package aws
import mem
import str
import time
import conv
import net.httpx
const _S3_HDR_MAX := 128
@en "Headers"
@fa "سرآیندها"
pub struct Headers:
pub names: Vector<str> = Vector {}
pub values: Vector<str> = Vector {}
end
@en "Request"
@fa "درخواست"
pub struct Request:
pub method: str = "GET"
pub key: str = ""
pub bucket: str = ""
pub service_level: bool = false
pub headers: Headers = Headers {}
pub query: Headers = Headers {}
pub body: void* = null
pub body_len: int = 0
pub body_hash: str = ""
end
@en "Bytes"
@fa "بایت‌ها"
pub struct Bytes:
pub ok: bool = false
pub status: int = 0
pub data: void* = null
pub len: int = 0
pub etag: str = ""
pub head: str = ""
pub code: str = ""
pub error: str = ""
end
func _hdr_find(h: Headers, name: str): int:
lower := name.lower()
mut i := 0
until i < h.names.len():
if h.names.get(i).lower() == lower: ret i end
i += 1
end
ret -1
end
func _hdr_set(h &: Headers, name: str, value: str):
at := _hdr_find(h, name)
if at >= 0:
h.values.set(at, value)
ret
end
if h.names.len() >= _S3_HDR_MAX: ret end
h.names.push(name)
h.values.push(value)
end
func _hdr_copy(src: Headers): Headers:
mut out := Headers {}
mut i := 0
until i < src.names.len():
out.names.push(src.names.get(i))
out.values.push(src.values.get(i))
i += 1
end
ret out
end
func _hdr_sort(h &: Headers):
n := h.names.len()
mut i := 1
until i < n:
nm := h.names.get(i)
vl := h.values.get(i)
mut j := i - 1
until j >= 0 and str.Compare(h.names.get(j), nm) > 0:
h.names.set(j + 1, h.names.get(j))
h.values.set(j + 1, h.values.get(j))
j -= 1
end
h.names.set(j + 1, nm)
h.values.set(j + 1, vl)
i += 1
end
end
func _canon_value(v: str): str:
mut out := v.trim()
until str.Contains(out, "  "):
out = str.Replace(out, "  ", " ")
end
ret out
end
func _canon_headers(h: Headers, signed &: str): str:
mut sorted := _hdr_copy(h)
mut i := 0
until i < sorted.names.len():
sorted.names.set(i, sorted.names.get(i).lower())
i += 1
end
_hdr_sort(sorted)
mut block := str.NewBuilder()
defer str.BufFree(block)
mut list := str.NewBuilder()
defer str.BufFree(list)
mut k := 0
until k < sorted.names.len():
nm := sorted.names.get(k)
str.BufAppend(block, nm)
str.BufAppend(block, ":")
str.BufAppend(block, _canon_value(sorted.values.get(k)))
str.BufAppend(block, "\n")
if k > 0: str.BufAppend(list, ";") end
str.BufAppend(list, nm)
k += 1
end
signed = str.BufStr(list)
ret str.BufStr(block)
end
func _canon_query(q: Headers): str:
mut enc := Headers {}
mut i := 0
until i < q.names.len():
enc.names.push(UriEncode(q.names.get(i), false))
enc.values.push(UriEncode(q.values.get(i), false))
i += 1
end
_hdr_sort(enc)
mut sb := str.NewBuilder()
defer str.BufFree(sb)
mut k := 0
until k < enc.names.len():
if k > 0: str.BufAppend(sb, "&") end
str.BufAppend(sb, enc.names.get(k))
str.BufAppend(sb, "=")
str.BufAppend(sb, enc.values.get(k))
k += 1
end
ret str.BufStr(sb)
end
func _bucket_of(cfg: Config, r: Request): str:
if r.service_level: ret "" end
if r.bucket.len() > 0: ret r.bucket end
ret cfg.bucket
end
func _wire_host(cfg: Config, ep: httpx.Endpoint, bucket: str): str:
mut host := ep.host
if bucket.len() > 0 and not cfg.path_style: host = bucket + "." + ep.host end
if (ep.secure and ep.port != 443) or (not ep.secure and ep.port != 80):
host = host + ":" + ep.port
end
ret host
end
func _wire_path(cfg: Config, bucket: str, key: str): str:
if bucket.len() == 0: ret "/" end
if not cfg.path_style:
if key.len() == 0: ret "/" end
ret EncodeKey(key)
end
if key.len() == 0: ret "/" + bucket end
ret "/" + bucket + EncodeKey(key)
end
func _tag_text(body: str, tag: str): str:
open := "<" + tag + ">"
at := body.find(open)
if at < 0: ret "" end
start := at + open.len()
stop := str.IndexFrom(body, "</" + tag + ">", start)
if stop < 0: ret "" end
ret body.substr(start, stop - start)
end
func _describe(status: int, body: str): str:
msg := _tag_text(body, "Message")
if msg.len() > 0: ret msg end
code := _tag_text(body, "Code")
if code.len() > 0: ret code end
if status == 0: ret "the object store could not be reached" end
ret "the object store answered " + status
end
func _retryable(status: int): bool:
if status == 0: ret true end
if status == 429: ret true end
ret status == 500 or status == 502 or status == 503 or status == 504
end
func _backoff_ms(cfg: Config, attempt: int): int:
mut base := cfg.retry_base_ms
if base <= 0: base = 100 end
mut wait := base
repeat attempt:
wait = wait * 2
if wait > 10000: ret 10000 end
end
ret wait
end
func _head_block(
method: str, path: str, query: str, authorization: str, signed_set: Headers, body_len: int
): str:
mut sb := str.NewBuilder()
defer str.BufFree(sb)
str.BufAppend(sb, method)
str.BufAppend(sb, " ")
str.BufAppend(sb, path)
if query.len() > 0:
str.BufAppend(sb, "?")
str.BufAppend(sb, query)
end
str.BufAppend(sb, " HTTP/1.1\r\n")
mut i := 0
until i < signed_set.names.len():
str.BufAppend(sb, signed_set.names.get(i))
str.BufAppend(sb, ": ")
str.BufAppend(sb, signed_set.values.get(i))
str.BufAppend(sb, "\r\n")
i += 1
end
if authorization.len() > 0:
str.BufAppend(sb, "Authorization: ")
str.BufAppend(sb, authorization)
str.BufAppend(sb, "\r\n")
end
str.BufAppend(sb, "Content-Length: ")
str.BufAppendInt(sb, body_len as i64)
str.BufAppend(sb, "\r\nConnection: close\r\n\r\n")
ret str.BufStr(sb)
end
func _signing_set(
cfg: Config, extra: Headers, host: str, amz_date: str, payload_hash: str
): Headers:
mut out := Headers {}
_hdr_set(out, "Host", host)
mut i := 0
until i < extra.names.len():
_hdr_set(out, extra.names.get(i), extra.values.get(i))
i += 1
end
if cfg.request_payer: _hdr_set(out, "x-amz-request-payer", "requester") end
if cfg.anonymous: ret out end
_hdr_set(out, "x-amz-content-sha256", payload_hash)
_hdr_set(out, "x-amz-date", amz_date)
if cfg.session_token.len() > 0:
_hdr_set(out, "x-amz-security-token", cfg.session_token)
end
ret out
end
func _payload_hash(r: Request): str:
if r.body_hash.len() > 0: ret r.body_hash end
if r.body_len > 0 and r.body != null: ret Sha256Bytes(r.body, r.body_len) end
ret EMPTY_SHA256
end
func _dispatch(
cfg: Config, ep: httpx.Endpoint, method: str, host: str, path: str, query: str, extra: Headers,
body: void*, body_len: int, payload_hash: str, at: i64
): httpx.Raw:
amz_date := AmzDate(at)
signed_set := _signing_set(cfg, extra, host, amz_date, payload_hash)
if cfg.anonymous:
ret httpx.SendRawTimeout(
ep, _head_block(method, path, query, "", signed_set, body_len), body, body_len, cfg.timeout_ms
)
end
mut signed_names := ""
canonical := _canon_headers(signed_set, signed_names)
s := SignRequest(
cfg, method, path, query, canonical, signed_names, payload_hash, at
)
if not s.ok: ret httpx.Raw { error = "the request could not be signed" } end
head := _head_block(
method, path, query, s.authorization, signed_set, body_len
)
ret httpx.SendRawTimeout(ep, head, body, body_len, cfg.timeout_ms)
end
func _send_once(cfg: Config, r: Request, at: i64): httpx.Raw:
ep := httpx.ParseEndpoint(cfg.endpoint)
if not ep.ok:
ret httpx.Raw { error = "the endpoint could not be parsed: " + cfg.endpoint }
end
bucket := _bucket_of(cfg, r)
ret _dispatch(
cfg, ep, r.method, _wire_host(cfg, ep, bucket), _wire_path(cfg, bucket, r.key), _canon_query(r.query),
r.headers, r.body, r.body_len, _payload_hash(r), at
)
end
func _do_raw(cfg: Config, r: Request): httpx.Raw:
mut attempts := cfg.retry
if attempts < 1: attempts = 1 end
if attempts > 10: attempts = 10 end
mut n := 0
until n < attempts:
mut raw := _send_once(cfg, r, time.Now())
if not _retryable(raw.status) or n == attempts - 1: ret raw end
httpx.FreeRaw(raw)
time.Sleep(_backoff_ms(cfg, n))
n += 1
end
ret httpx.Raw { error = "the request was never attempted" }
end
func _fill_common(
raw: httpx.Raw, status: int, ok &: bool, etag &: str, code &: str, error &: str, body: str
):
ok = raw.ok
etag = Unquote(httpx.HeaderValue(raw.head, "ETag"))
if raw.error.len() > 0:
error = raw.error
code = "Transport"
ret
end
if not raw.ok:
code = _tag_text(body, "Code")
error = _describe(status, body)
end
end
@en "NewHeaders"
@fa "سرآیندهای جدید"
pub func NewHeaders(): Headers:
ret Headers {}
end
@en "HeaderSet"
@fa "تنظیم سرآیند"
pub func HeaderSet(h &: Headers, name: str, value: str):
_hdr_set(h, name, value)
end
@en "HeaderAdd"
@fa "افزودن سرآیند"
pub func HeaderAdd(h &: Headers, name: str, value: str):
if h.names.len() >= _S3_HDR_MAX: ret end
h.names.push(name)
h.values.push(value)
end
@en "HeaderGet"
@fa "دریافت سرآیند"
pub func HeaderGet(h: Headers, name: str): str:
at := _hdr_find(h, name)
if at < 0: ret "" end
ret h.values.get(at)
end
@en "HeaderHas"
@fa "سرآیند دارد"
pub func HeaderHas(h: Headers, name: str): bool:
ret _hdr_find(h, name) >= 0
end
@en "HeaderCount"
@fa "شمار سرآیندها"
pub func HeaderCount(h: Headers): int:
ret h.names.len()
end
@en "HeaderNameAt"
@fa "نام سرآیند شماره"
pub func HeaderNameAt(h: Headers, i: int): str:
if i < 0 or i >= h.names.len(): ret "" end
ret h.names.get(i)
end
@en "HeaderValueAt"
@fa "مقدار سرآیند شماره"
pub func HeaderValueAt(h: Headers, i: int): str:
if i < 0 or i >= h.values.len(): ret "" end
ret h.values.get(i)
end
@en "HeaderFree"
@fa "آزادسازی سرآیندها"
pub func HeaderFree(h &: Headers):
h.names.free()
h.values.free()
end
@en "NewRequest"
@fa "درخواست جدید"
pub func NewRequest(method: str, key: str): Request:
ret Request { method = method, key = key }
end
@en "NewBucketRequest"
@fa "درخواست سطل جدید"
pub func NewBucketRequest(method: str, bucket: str, key: str): Request:
ret Request { method = method, bucket = bucket, key = key }
end
@en "NewServiceRequest"
@fa "درخواست سرویس جدید"
pub func NewServiceRequest(method: str): Request:
ret Request { method = method, service_level = true }
end
@en "SetQuery"
@fa "تنظیم پرسمان"
pub func SetQuery(r &: Request, name: str, value: str):
_hdr_set(r.query, name, value)
end
@en "SetQueryInt"
@fa "تنظیم پرسمان عددی"
pub func SetQueryInt(r &: Request, name: str, value: int):
_hdr_set(r.query, name, "" + value)
end
@en "SetFlag"
@fa "تنظیم پرچم"
pub func SetFlag(r &: Request, name: str):
_hdr_set(r.query, name, "")
end
@en "SetHeader"
@fa "تنظیم سرآیند درخواست"
pub func SetHeader(r &: Request, name: str, value: str):
if value.len() == 0: ret end
_hdr_set(r.headers, name, value)
end
@en "SetBody"
@fa "تنظیم بدنه"
pub func SetBody(r &: Request, p: void*, n: int):
r.body = p
r.body_len = n
end
@en "SetText"
@fa "تنظیم بدنه متنی"
pub func SetText(r &: Request, s: str):
if s.len() == 0:
r.body = null
r.body_len = 0
ret
end
r.body = s as void*
r.body_len = s.len()
end
@en "SetUnsignedPayload"
@fa "تنظیم بار امضانشده"
pub func SetUnsignedPayload(r &: Request):
r.body_hash = UNSIGNED_PAYLOAD
end
@en "Do"
@fa "اجرای درخواست"
pub func Do(cfg: Config, r: Request): Result:
if not Configured(cfg): ret Failure("the object store is not configured") end
mut raw := _do_raw(cfg, r)
defer httpx.FreeRaw(raw)
body := httpx.RawText(raw)
mut out := Result { status = raw.status, body = body, head = raw.head }
_fill_common(raw, raw.status, out.ok, out.etag, out.code, out.error, body)
out.request_id = httpx.HeaderValue(raw.head, "x-amz-request-id")
out.version_id = httpx.HeaderValue(raw.head, "x-amz-version-id")
length := httpx.HeaderValue(raw.head, "Content-Length")
if length.len() > 0: out.length = conv.ParseInt(length) end
ret out
end
@en "DoBytes"
@fa "اجرای درخواست بایتی"
pub func DoBytes(cfg: Config, r: Request): Bytes:
if not Configured(cfg):
ret Bytes { error = "the object store is not configured", code = "Config" }
end
mut raw := _do_raw(cfg, r)
mut out := Bytes { status = raw.status, head = raw.head }
if raw.error.len() > 0:
httpx.FreeRaw(raw)
out.error = raw.error
out.code = "Transport"
ret out
end
if not raw.ok:
body := httpx.RawText(raw)
httpx.FreeRaw(raw)
out.code = _tag_text(body, "Code")
out.error = _describe(raw.status, body)
ret out
end
out.ok = true
out.etag = Unquote(httpx.HeaderValue(raw.head, "ETag"))
out.data = raw.data
out.len = raw.len
ret out
end
@en "FreeBytes"
@fa "آزادسازی بایت‌ها"
pub func FreeBytes(b &: Bytes):
if b.data != null:
mem.Free(b.data)
b.data = null
end
b.len = 0
end
@en "ResultHeader"
@fa "سرآیند نتیجه"
pub func ResultHeader(r: Result, name: str): str:
ret httpx.HeaderValue(r.head, name)
end
@en "BytesHeader"
@fa "سرآیند بایت‌ها"
pub func BytesHeader(b: Bytes, name: str): str:
ret httpx.HeaderValue(b.head, name)
end
@en "ResultErrorCode"
@fa "کد خطای نتیجه"
pub func ResultErrorCode(body: str): str:
ret _tag_text(body, "Code")
end
@en "ResultErrorMessage"
@fa "پیام خطای نتیجه"
pub func ResultErrorMessage(body: str, status: int): str:
ret _describe(status, body)
end
@en "ResultTag"
@fa "برچسب نتیجه"
pub func ResultTag(body: str, tag: str): str:
ret _tag_text(body, tag)
end
@en "Unquote"
@fa "حذف گیومه"
pub func Unquote(s: str): str:
if s.len() >= 2 and s.substr(0, 1) == "\"" and s.substr(s.len() - 1, 1) == "\"":
ret s.substr(1, s.len() - 2)
end
ret s
end
@en "CanonicalRequest"
@fa "درخواست متعارف"
pub func CanonicalRequest(cfg: Config, r: Request, at: i64): str:
ep := httpx.ParseEndpoint(cfg.endpoint)
bucket := _bucket_of(cfg, r)
host := _wire_host(cfg, ep, bucket)
payload_hash := _payload_hash(r)
signed_set := _signing_set(cfg, r.headers, host, AmzDate(at), payload_hash)
mut signed_names := ""
canonical := _canon_headers(signed_set, signed_names)
ret r.method + "\n" + _wire_path(cfg, bucket, r.key) + "\n" + _canon_query(r.query) + "\n" + canonical + "\n" + signed_names + "\n" + payload_hash
end
@en "PreparedHead"
@fa "سرآیندهای آماده"
pub func PreparedHead(cfg: Config, r: Request, at: i64): str:
ep := httpx.ParseEndpoint(cfg.endpoint)
bucket := _bucket_of(cfg, r)
host := _wire_host(cfg, ep, bucket)
path := _wire_path(cfg, bucket, r.key)
query := _canon_query(r.query)
payload_hash := _payload_hash(r)
amz_date := AmzDate(at)
signed_set := _signing_set(cfg, r.headers, host, amz_date, payload_hash)
mut signed_names := ""
canonical := _canon_headers(signed_set, signed_names)
s := SignRequest(
cfg, r.method, path, query, canonical, signed_names, payload_hash, at
)
if cfg.anonymous:
ret _head_block(r.method, path, query, "", signed_set, r.body_len)
end
ret _head_block(
r.method, path, query, s.authorization, signed_set, r.body_len
)
end
package aws
import str
import time
import conv
import encoding.xml
func _xml_text(node: xml.XMLNode, tag: str): str:
ret xml.Child(node, tag).text.trim()
end
func _xml_int(node: xml.XMLNode, tag: str): i64:
v := _xml_text(node, tag)
if v.len() == 0: ret 0 end
ret conv.ParseInt(v)
end
func _xml_bool(node: xml.XMLNode, tag: str): bool:
ret _xml_text(node, tag).lower() == "true"
end
func _hexdigit(c: int): int:
if c >= 48 and c <= 57: ret c - 48 end
if c >= 97 and c <= 102: ret c - 87 end
if c >= 65 and c <= 70: ret c - 55 end
ret -1
end
func _pct_decode(s: str): str:
if s.find("%") < 0: ret s end
mut sb := str.NewBuilder()
defer str.BufFree(sb)
n := s.len()
mut i := 0
until i < n:
c := s[i] as int
if c == 37 and i + 2 < n:
hi := _hexdigit(s[i + 1] as int)
lo := _hexdigit(s[i + 2] as int)
if hi >= 0 and lo >= 0:
str.BufAppendChar(sb, hi * 16 + lo)
i += 3
continue
end
end
str.BufAppendChar(sb, c)
i += 1
end
ret str.BufStr(sb)
end
func _iso_epoch(s: str): i64:
if s.len() == 0: ret 0 end
when := time.ParseISO(s)
if not when.ok: ret 0 end
ret when.epoch
end
func _xml_escape(s: str): str:
mut out := str.Replace(s, "&", "&amp;")
out = str.Replace(out, "<", "&lt;")
out = str.Replace(out, ">", "&gt;")
out = str.Replace(out, "\"", "&quot;")
ret str.Replace(out, "'", "&apos;")
end
func _decoded(s: str, encoded: bool): str:
if not encoded: ret s end
ret _pct_decode(s)
end
package aws
import str
import time
import net.httpx
const _AWS_GLOBAL := "iam cloudfront route53 organizations waf globalaccelerator"
const _CT_FORM := "application/x-www-form-urlencoded; charset=utf-8"
@en "Call"
@fa "فراخوان سرویس"
pub struct Call:
pub service: str = ""
pub region: str = ""
pub method: str = "POST"
pub path: str = "/"
pub target: str = ""
pub content_type: str = ""
pub query: Headers = Headers {}
pub headers: Headers = Headers {}
pub params: Headers = Headers {}
pub body: str = ""
pub endpoint: str = ""
pub global_endpoint: bool = false
end
func _is_global(service: str): bool:
if service.len() == 0: ret false end
ret str.Contains(_AWS_GLOBAL, service.lower())
end
func _form_body(params: Headers): str:
mut sb := str.NewBuilder()
defer str.BufFree(sb)
mut i := 0
until i < params.names.len():
if i > 0: str.BufAppend(sb, "&") end
str.BufAppend(sb, UriEncode(params.names.get(i), false))
str.BufAppend(sb, "=")
str.BufAppend(sb, UriEncode(params.values.get(i), false))
i += 1
end
ret str.BufStr(sb)
end
func _call_body(c: Call): str:
if c.params.names.len() > 0: ret _form_body(c.params) end
ret c.body
end
func _call_content_type(c: Call): str:
if c.content_type.len() > 0: ret c.content_type end
if c.params.names.len() > 0: ret _CT_FORM end
if c.target.len() > 0: ret "application/x-amz-json-1.0" end
ret ""
end
func _call_region(cfg: Config, c: Call): str:
if c.region.len() > 0: ret c.region end
if cfg.region.len() > 0: ret cfg.region end
ret "us-east-1"
end
func _call_endpoint(cfg: Config, c: Call): str:
if c.endpoint.len() > 0: ret c.endpoint end
if c.global_endpoint or _is_global(c.service):
ret "https://" + c.service + ".amazonaws.com"
end
ret ServiceEndpoint(c.service, _call_region(cfg, c))
end
func _call_host(ep: httpx.Endpoint): str:
mut host := ep.host
if (ep.secure and ep.port != 443) or (not ep.secure and ep.port != 80):
host = host + ":" + ep.port
end
ret host
end
func _call_headers(c: Call, content_type: str): Headers:
mut h := _hdr_copy(c.headers)
if content_type.len() > 0: _hdr_set(h, "Content-Type", content_type) end
if c.target.len() > 0: _hdr_set(h, "X-Amz-Target", c.target) end
ret h
end
func _invoke_once(cfg: Config, c: Call, at: i64): httpx.Raw:
endpoint := _call_endpoint(cfg, c)
ep := httpx.ParseEndpoint(endpoint)
if not ep.ok:
ret httpx.Raw { error = "the endpoint could not be parsed: " + endpoint }
end
mut svc := cfg
svc.service = c.service
svc.region = _call_region(cfg, c)
body := _call_body(c)
content_type := _call_content_type(c)
headers := _call_headers(c, content_type)
mut path := c.path
if path.len() == 0: path = "/" end
mut payload := EMPTY_SHA256
if body.len() > 0: payload = Sha256Bytes(body as void*, body.len()) end
mut data := null as void*
if body.len() > 0: data = body as void* end
ret _dispatch(
svc, ep, c.method, _call_host(ep), path, _canon_query(c.query), headers, data, body.len(), payload,
at
)
end
func _invoke_raw(cfg: Config, c: Call): httpx.Raw:
mut attempts := cfg.retry
if attempts < 1: attempts = 1 end
if attempts > 10: attempts = 10 end
mut n := 0
until n < attempts:
mut raw := _invoke_once(cfg, c, time.Now())
if not _retryable(raw.status) or n == attempts - 1: ret raw end
httpx.FreeRaw(raw)
time.Sleep(_backoff_ms(cfg, n))
n += 1
end
ret httpx.Raw { error = "the request was never attempted" }
end
func _service_ready(cfg: Config, c: Call): str:
if c.service.len() == 0 and c.endpoint.len() == 0:
ret "the call names no service"
end
if cfg.anonymous: ret "" end
if cfg.access_key.len() == 0 or cfg.secret_key.len() == 0:
ret "no credentials were supplied for " + c.service
end
ret ""
end
func _json_field(body: str, name: str): str:
needle := "\"" + name + "\""
at := body.find(needle)
if at < 0: ret "" end
mut i := at + needle.len()
until i < body.len():
c := body[i] as int
if c != 32 and c != 58 and c != 9 and c != 10 and c != 13: break end
i += 1
end
if i >= body.len() or body[i] as int != 34: ret "" end
i += 1
mut sb := str.NewBuilder()
defer str.BufFree(sb)
until i < body.len():
c := body[i] as int
if c == 92 and i + 1 < body.len():
esc := body[i + 1] as int
if esc == 110: str.BufAppendChar(sb, 10)
else esc == 116: str.BufAppendChar(sb, 9)
else esc == 114: str.BufAppendChar(sb, 13)
else:
str.BufAppendChar(sb, esc)
end
i += 2
continue
end
if c == 34: ret str.BufStr(sb) end
str.BufAppendChar(sb, c)
i += 1
end
ret str.BufStr(sb)
end
@en "ServiceEndpoint"
@fa "نقطه پایانی سرویس"
pub func ServiceEndpoint(service: str, region: str): str:
if service.len() == 0: ret "" end
if region.len() == 0 or _is_global(service):
ret "https://" + service + ".amazonaws.com"
end
ret "https://" + service + "." + region + ".amazonaws.com"
end
@en "NewQueryCall"
@fa "فراخوان پرسمانی جدید"
pub func NewQueryCall(service: str, action: str, version: str): Call:
mut c := Call { service = service, method = "POST", path = "/" }
_hdr_set(c.params, "Action", action)
_hdr_set(c.params, "Version", version)
ret c
end
@en "NewJsonCall"
@fa "فراخوان جیسون جدید"
pub func NewJsonCall(service: str, target: str, json: str): Call:
ret Call {
service = service, method = "POST", path = "/", target = target, body = json, content_type = "application/x-amz-json-1.0"
}
end
@en "NewJson11Call"
@fa "فراخوان جیسون۱۱ جدید"
pub func NewJson11Call(service: str, target: str, json: str): Call:
mut c := NewJsonCall(service, target, json)
c.content_type = "application/x-amz-json-1.1"
ret c
end
@en "NewRestCall"
@fa "فراخوان رست جدید"
pub func NewRestCall(service: str, method: str, path: str): Call:
ret Call { service = service, method = method, path = path }
end
@en "CallParam"
@fa "پارامتر فراخوان"
pub func CallParam(c &: Call, name: str, value: str):
if value.len() == 0: ret end
_hdr_set(c.params, name, value)
end
@en "CallParamInt"
@fa "پارامتر عددی فراخوان"
pub func CallParamInt(c &: Call, name: str, value: int):
_hdr_set(c.params, name, "" + value)
end
@en "CallHeader"
@fa "سرآیند فراخوان"
pub func CallHeader(c &: Call, name: str, value: str):
if value.len() == 0: ret end
_hdr_set(c.headers, name, value)
end
@en "CallQuery"
@fa "پرسمان فراخوان"
pub func CallQuery(c &: Call, name: str, value: str):
_hdr_set(c.query, name, value)
end
@en "CallBody"
@fa "بدنه فراخوان"
pub func CallBody(c &: Call, body: str, content_type: str):
c.body = body
if content_type.len() > 0: c.content_type = content_type end
end
@en "CallRegion"
@fa "منطقه فراخوان"
pub func CallRegion(c &: Call, region: str):
c.region = region
end
@en "CallEndpoint"
@fa "نقطه پایانی فراخوان"
pub func CallEndpoint(c &: Call, endpoint: str):
c.endpoint = endpoint
end
@en "Invoke"
@fa "اجرای فراخوان"
pub func Invoke(cfg: Config, c: Call): Result:
why := _service_ready(cfg, c)
if why.len() > 0: ret Failure(why) end
mut raw := _invoke_raw(cfg, c)
defer httpx.FreeRaw(raw)
body := httpx.RawText(raw)
mut out := Result { status = raw.status, body = body, head = raw.head }
out.request_id = httpx.HeaderValue(raw.head, "x-amzn-requestid")
if out.request_id.len() == 0:
out.request_id = httpx.HeaderValue(raw.head, "x-amz-request-id")
end
if raw.error.len() > 0:
out.code = "Transport"
out.error = raw.error
ret out
end
out.ok = raw.ok
if not raw.ok:
out.code = ServiceErrorCode(body)
out.error = ServiceErrorMessage(body, raw.status)
end
ret out
end
@en "ServiceErrorCode"
@fa "کد خطای سرویس"
pub func ServiceErrorCode(body: str): str:
tagged := _tag_text(body, "Code")
if tagged.len() > 0: ret tagged end
mut typed := _json_field(body, "__type")
if typed.len() == 0: typed = _json_field(body, "code") end
hash := typed.find("#")
if hash >= 0: ret typed.substr(hash + 1, typed.len() - hash - 1) end
ret typed
end
@en "ServiceErrorMessage"
@fa "پیام خطای سرویس"
pub func ServiceErrorMessage(body: str, status: int): str:
tagged := _tag_text(body, "Message")
if tagged.len() > 0: ret tagged end
mut msg := _json_field(body, "message")
if msg.len() == 0: msg = _json_field(body, "Message") end
if msg.len() > 0: ret msg end
code := ServiceErrorCode(body)
if code.len() > 0: ret code end
if status == 0: ret "the service could not be reached" end
ret "the service answered " + status
end
@en "CallFree"
@fa "آزادسازی فراخوان"
pub func CallFree(c &: Call):
HeaderFree(c.params)
HeaderFree(c.headers)
HeaderFree(c.query)
end
@en "PreparedCall"
@fa "فراخوان آماده"
pub func PreparedCall(cfg: Config, c: Call, at: i64): str:
endpoint := _call_endpoint(cfg, c)
ep := httpx.ParseEndpoint(endpoint)
if not ep.ok: ret "" end
mut svc := cfg
svc.service = c.service
svc.region = _call_region(cfg, c)
body := _call_body(c)
content_type := _call_content_type(c)
headers := _call_headers(c, content_type)
mut path := c.path
if path.len() == 0: path = "/" end
mut payload := EMPTY_SHA256
if body.len() > 0: payload = Sha256Bytes(body as void*, body.len()) end
host := _call_host(ep)
query := _canon_query(c.query)
amz_date := AmzDate(at)
signed_set := _signing_set(svc, headers, host, amz_date, payload)
mut signed_names := ""
canonical := _canon_headers(signed_set, signed_names)
s := SignRequest(
svc, c.method, path, query, canonical, signed_names, payload, at
)
mut auth := s.authorization
if svc.anonymous: auth = "" end
ret _head_block(c.method, path, query, auth, signed_set, body.len()) + body
end
@en "CallBodyText"
@fa "متن بدنه فراخوان"
pub func CallBodyText(c: Call): str:
ret _call_body(c)
end
package aws
import mem
import str
import crypto
import time
const HEX_DIGITS := "0123456789abcdef"
const HMAC_SIZE := 32
@en "Signed"
@fa "امضاشده"
pub struct Signed:
pub authorization: str = ""
pub amz_date: str = ""
pub payload_hash: str = ""
pub ok: bool = false
end
func _unreserved(code: int): bool:
if code >= 65 and code <= 90: ret true end
if code >= 97 and code <= 122: ret true end
if code >= 48 and code <= 57: ret true end
ret code == 45 or code == 46 or code == 95 or code == 126
end
func _hex_byte(v: int): str:
ret HEX_DIGITS.substr(v / 16, 1) + HEX_DIGITS.substr(v % 16, 1)
end
func _uri_encode(s: str, keep_slash: bool): str:
mut sb := str.NewBuilder()
defer str.BufFree(sb)
repeat s.len() in i:
code := s[i] as int
if _unreserved(code) or (keep_slash and code == 47):
str.BufAppendChar(sb, code)
else:
str.BufAppend(sb, "%" + _hex_byte(code).upper())
end
end
ret str.BufStr(sb)
end
func _hex(ptr: void*, n: int): str:
bp := ptr as u8*
mut sb := str.NewBuilder()
defer str.BufFree(sb)
repeat n in i:
str.BufAppend(sb, _hex_byte(bp[i] as int))
end
ret str.BufStr(sb)
end
func _hmac_into(key: void*, klen: int, msg: str, out: void*):
crypto.HmacSha256Raw(key, klen, msg as void*, msg.len(), out)
end
func _signing_key(secret: str, date_stamp: str, region: str, service: str): void*:
out := mem.Allocate(HMAC_SIZE as u64)
if out == null: ret null end
seed := "AWS4" + secret
_hmac_into(seed as void*, seed.len(), date_stamp, out)
_hmac_into(out, HMAC_SIZE, region, out)
_hmac_into(out, HMAC_SIZE, service, out)
_hmac_into(out, HMAC_SIZE, "aws4_request", out)
ret out
end
func _canonical_request(
method: str, path: str, query: str, headers: str, signed_headers: str, payload_hash: str
): str:
ret method + "\n" + path + "\n" + query + "\n" + headers + "\n" + signed_headers + "\n" + payload_hash
end
func _string_to_sign(amz_date: str, scope: str, canonical: str): str:
ret ALGORITHM + "\n" + amz_date + "\n" + scope + "\n" + crypto.Sha256Hex(canonical)
end
func _sign_with(key: void*, string_to_sign: str): str:
out := mem.Allocate(HMAC_SIZE as u64)
defer mem.Free(out)
if out == null: ret "" end
_hmac_into(key, HMAC_SIZE, string_to_sign, out)
ret _hex(out, HMAC_SIZE)
end
@en "AmzDate"
@fa "تاریخ ای ام زد"
pub func AmzDate(epoch_seconds: i64): str:
iso := time.FormatISOUTC(epoch_seconds)
ret str.Replace(str.Replace(iso, "-", ""), ":", "")
end
@en "DateStamp"
@fa "مهر تاریخ"
pub func DateStamp(amz_date: str): str:
if amz_date.len() < 8: ret amz_date end
ret amz_date.substr(0, 8)
end
@en "Scope"
@fa "دامنه اعتبار"
pub func Scope(date_stamp: str, region: str, service: str): str:
ret date_stamp + "/" + region + "/" + service + "/aws4_request"
end
@en "UriEncode"
@fa "کدگذاری نشانی"
pub func UriEncode(s: str, keep_slash: bool): str:
ret _uri_encode(s, keep_slash)
end
@en "EncodeKey"
@fa "کدگذاری کلید"
pub func EncodeKey(key: str): str:
mut trimmed := key
if trimmed.len() > 0 and trimmed.substr(0, 1) == "/":
trimmed = trimmed.substr(1, trimmed.len() - 1)
end
ret "/" + _uri_encode(trimmed, true)
end
@en "Sha256Bytes"
@fa "شا۲۵۶ بایت"
pub func Sha256Bytes(ptr: void*, n: int): str:
digest := mem.Allocate(HMAC_SIZE as u64)
defer mem.Free(digest)
if digest == null: ret EMPTY_SHA256 end
crypto.Sha256Bytes(ptr, n, digest)
ret _hex(digest, HMAC_SIZE)
end
@en "SignRequest"
@fa "امضای درخواست"
pub func SignRequest(
cfg: Config, method: str, path: str, query: str, canonical_headers: str, signed_headers: str,
payload_hash: str, epoch_seconds: i64
): Signed:
if cfg.secret_key.len() == 0: ret Signed {} end
amz_date := AmzDate(epoch_seconds)
date_stamp := DateStamp(amz_date)
scope := Scope(date_stamp, cfg.region, cfg.service)
canonical := _canonical_request(
method, path, query, canonical_headers, signed_headers, payload_hash
)
key := _signing_key(cfg.secret_key, date_stamp, cfg.region, cfg.service)
if key == null: ret Signed {} end
defer mem.Free(key)
signature := _sign_with(key, _string_to_sign(amz_date, scope, canonical))
if signature.len() == 0: ret Signed {} end
ret Signed {
authorization = ALGORITHM + " Credential=" + cfg.access_key + "/" + scope + ", SignedHeaders=" + signed_headers + ", Signature=" + signature,
amz_date = amz_date, payload_hash = payload_hash, ok = true
}
end
@en "SignString"
@fa "امضای رشته"
pub func SignString(cfg: Config, date_stamp: str, payload: str): str:
if cfg.secret_key.len() == 0: ret "" end
key := _signing_key(cfg.secret_key, date_stamp, cfg.region, cfg.service)
if key == null: ret "" end
defer mem.Free(key)
ret _sign_with(key, payload)
end
@en "SignQueryHeaders"
@fa "امضای سرآیندهای پرسمان"
pub func SignQueryHeaders(
cfg: Config, method: str, path: str, query: str, canonical_headers: str, signed_headers: str,
epoch_seconds: i64
): str:
if cfg.secret_key.len() == 0: ret "" end
amz_date := AmzDate(epoch_seconds)
date_stamp := DateStamp(amz_date)
canonical := _canonical_request(
method, path, query, canonical_headers, signed_headers, UNSIGNED_PAYLOAD
)
ret SignString(
cfg, date_stamp, _string_to_sign(
amz_date, Scope(date_stamp, cfg.region, cfg.service), canonical
)
)
end
@en "SignQuery"
@fa "امضای پرسمان"
pub func SignQuery(
cfg: Config, method: str, path: str, query: str, host: str, epoch_seconds: i64
): str:
ret SignQueryHeaders(
cfg, method, path, query, "host:" + host + "\n", "host", epoch_seconds
)
end
package aws
import str
import conv
import encoding.xml
@en "SQS_VERSION"
@fa "نسخه اس کیو اس"
pub const SQS_VERSION := "2012-11-05"
@en "SQS_MAX_MESSAGES"
@fa "بیشینه پیام‌های اس کیو اس"
pub const SQS_MAX_MESSAGES := 10
@en "SQS_MAX_WAIT"
@fa "بیشینه انتظار اس کیو اس"
pub const SQS_MAX_WAIT := 20
@en "SQS_MAX_BATCH"
@fa "بیشینه دسته اس کیو اس"
pub const SQS_MAX_BATCH := 10
@en "Message"
@fa "پیام صف"
pub struct Message:
pub id: str = ""
pub body: str = ""
pub receipt: str = ""
pub md5: str = ""
pub receive_count: int = 0
pub sent_epoch: i64 = 0
pub group_id: str = ""
pub dedup_id: str = ""
pub attributes: Headers = Headers {}
pub message_attributes: Headers = Headers {}
end
@en "MessageList"
@fa "فهرست پیام‌ها"
pub struct MessageList:
pub ok: bool = false
pub status: int = 0
pub items: Vector<Message> = Vector {}
pub error: str = ""
pub code: str = ""
end
@en "SendResult"
@fa "نتیجه ارسال"
pub struct SendResult:
pub ok: bool = false
pub id: str = ""
pub md5: str = ""
pub sequence: str = ""
pub error: str = ""
pub code: str = ""
end
@en "OutMessage"
@fa "پیام خروجی"
pub struct OutMessage:
pub body: str = ""
pub delay: int = 0
pub group_id: str = ""
pub dedup_id: str = ""
pub attributes: Headers = Headers {}
end
@en "ReceiveOptions"
@fa "گزینه‌های دریافت"
pub struct ReceiveOptions:
pub max_messages: int = 1
pub wait_seconds: int = 20
pub visibility_timeout: int = 0
pub want_attributes: bool = true
pub want_message_attributes: bool = true
pub receive_request_attempt_id: str = ""
end
@en "QueueList"
@fa "فهرست صف‌ها"
pub struct QueueList:
pub ok: bool = false
pub items: Vector<str> = Vector {}
pub error: str = ""
pub code: str = ""
end
func _queue_path(url: str): str:
scheme := url.find("://")
if scheme < 0: ret "/" end
slash := str.IndexFrom(url, "/", scheme + 3)
if slash < 0: ret "/" end
ret url.substr(slash, url.len() - slash)
end
func _queue_origin(url: str): str:
scheme := url.find("://")
if scheme < 0: ret "" end
slash := str.IndexFrom(url, "/", scheme + 3)
if slash < 0: ret url end
ret url.substr(0, slash)
end
func _queue_call(url: str, action: str): Call:
mut c := NewQueryCall("sqs", action, SQS_VERSION)
if url.len() == 0: ret c end
c.path = _queue_path(url)
CallEndpoint(c, _queue_origin(url))
ret c
end
func _service_call(action: str): Call:
mut c := NewQueryCall("sqs", action, SQS_VERSION)
override := env.Get("AWS_ENDPOINT_URL_SQS")
if override.len() > 0: CallEndpoint(c, override) end
ret c
end
func _put_attributes(c &: Call, attrs: Headers):
mut i := 0
until i < attrs.names.len():
n := "MessageAttribute." + (i + 1)
CallParam(c, n + ".Name", attrs.names.get(i))
CallParam(c, n + ".Value.DataType", "String")
CallParam(c, n + ".Value.StringValue", attrs.values.get(i))
i += 1
end
end
func _read_pairs(node: xml.XMLNode, tag: str, out &: Headers):
rows := xml.Children(node, tag)
mut i := 0
until i < rows.items.len():
row := rows.items.get(i)
name := _xml_text(row, "Name")
mut value := _xml_text(row, "Value")
if value.len() == 0:
inner := xml.Child(row, "Value")
if xml.Found(inner): value = _xml_text(inner, "StringValue") end
end
if name.len() > 0: HeaderSet(out, name, value) end
i += 1
end
end
func _message_of(node: xml.XMLNode): Message:
mut m := Message {
id = _xml_text(node, "MessageId"), body = _xml_text(node, "Body"), receipt = _xml_text(node, "ReceiptHandle"),
md5 = _xml_text(node, "MD5OfBody")
}
_read_pairs(node, "Attribute", m.attributes)
_read_pairs(node, "MessageAttribute", m.message_attributes)
count := HeaderGet(m.attributes, "ApproximateReceiveCount")
if count.len() > 0: m.receive_count = count.to_int() end
sent := HeaderGet(m.attributes, "SentTimestamp")
if sent.len() > 0:
m.sent_epoch = conv.ParseInt(sent) / (1000 as i64)
end
m.group_id = HeaderGet(m.attributes, "MessageGroupId")
m.dedup_id = HeaderGet(m.attributes, "MessageDeduplicationId")
ret m
end
func _root_of(res: Result, ok &: bool): xml.XMLNode:
ok = false
if not res.ok: ret xml.XMLNode {} end
ret xml.DecodeStrict(res.body, ok)
end
func _clamp(v: int, lo: int, hi: int): int:
if v < lo: ret lo end
if v > hi: ret hi end
ret v
end
@en "SqsQueueUrl"
@fa "اس کیو اس نشانی صف"
pub func SqsQueueUrl(cfg: Config, name: str): str:
mut c := _service_call("GetQueueUrl")
CallParam(c, "QueueName", name)
res := Invoke(cfg, c)
CallFree(c)
if not res.ok: ret "" end
ret ResultTag(res.body, "QueueUrl").trim()
end
@en "SqsCreateQueue"
@fa "اس کیو اس ساخت صف"
pub func SqsCreateQueue(cfg: Config, name: str, attributes: Headers): str:
mut c := _service_call("CreateQueue")
CallParam(c, "QueueName", name)
mut i := 0
until i < attributes.names.len():
n := "Attribute." + (i + 1)
CallParam(c, n + ".Name", attributes.names.get(i))
CallParam(c, n + ".Value", attributes.values.get(i))
i += 1
end
res := Invoke(cfg, c)
CallFree(c)
if not res.ok: ret "" end
ret ResultTag(res.body, "QueueUrl").trim()
end
@en "SqsDeleteQueue"
@fa "اس کیو اس حذف صف"
pub func SqsDeleteQueue(cfg: Config, url: str): Result:
mut c := _queue_call(url, "DeleteQueue")
res := Invoke(cfg, c)
CallFree(c)
ret res
end
@en "SqsListQueues"
@fa "اس کیو اس فهرست صف‌ها"
pub func SqsListQueues(cfg: Config, prefix: str): QueueList:
mut c := _service_call("ListQueues")
CallParam(c, "QueueNamePrefix", prefix)
res := Invoke(cfg, c)
CallFree(c)
if not res.ok:
ret QueueList { error = res.error, code = res.code }
end
mut ok := false
root := _root_of(res, ok)
mut out := QueueList { ok = true }
if not ok: ret out end
holder := xml.Child(root, "ListQueuesResult")
mut rows := xml.Children(holder, "QueueUrl")
if rows.items.len() == 0: rows = xml.Children(root, "QueueUrl") end
mut i := 0
until i < rows.items.len():
url := rows.items.get(i).text.trim()
if url.len() > 0: out.items.push(url) end
i += 1
end
ret out
end
@en "QueueCount"
@fa "شمار صف‌ها"
pub func QueueCount(l: QueueList): int: ret l.items.len() end
@en "QueueAt"
@fa "صف شماره"
pub func QueueAt(l: QueueList, i: int): str:
if i < 0 or i >= l.items.len(): ret "" end
ret l.items.get(i)
end
@en "QueueListFree"
@fa "آزادسازی فهرست صف‌ها"
pub func QueueListFree(l &: QueueList): l.items.free() end
@en "SqsSend"
@fa "اس کیو اس ارسال"
pub func SqsSend(cfg: Config, url: str, body: str): SendResult:
ret SqsSendWith(cfg, url, OutMessage { body = body })
end
@en "SqsSendWith"
@fa "اس کیو اس ارسال با گزینه"
pub func SqsSendWith(cfg: Config, url: str, m: OutMessage): SendResult:
if m.body.len() == 0:
ret SendResult { error = "an empty message cannot be sent", code = "Config" }
end
mut c := SqsSendCall(url, m)
res := Invoke(cfg, c)
CallFree(c)
if not res.ok:
ret SendResult { error = res.error, code = res.code }
end
ret SendResult {
ok = true, id = ResultTag(res.body, "MessageId").trim(), md5 = ResultTag(res.body, "MD5OfMessageBody").trim(),
sequence = ResultTag(res.body, "SequenceNumber").trim()
}
end
@en "SqsSendCall"
@fa "اس کیو اس فراخوان ارسال"
pub func SqsSendCall(url: str, m: OutMessage): Call:
mut c := _queue_call(url, "SendMessage")
CallParam(c, "MessageBody", m.body)
if m.delay > 0: CallParamInt(c, "DelaySeconds", _clamp(m.delay, 0, 900)) end
CallParam(c, "MessageGroupId", m.group_id)
CallParam(c, "MessageDeduplicationId", m.dedup_id)
_put_attributes(c, m.attributes)
ret c
end
@en "SqsReceive"
@fa "اس کیو اس دریافت"
pub func SqsReceive(cfg: Config, url: str, o: ReceiveOptions): MessageList:
mut c := SqsReceiveCall(url, o)
res := Invoke(cfg, c)
CallFree(c)
ret ParseReceive(res.body, res.status)
end
@en "SqsReceiveCall"
@fa "اس کیو اس فراخوان دریافت"
pub func SqsReceiveCall(url: str, o: ReceiveOptions): Call:
mut c := _queue_call(url, "ReceiveMessage")
CallParamInt(c, "MaxNumberOfMessages", _clamp(o.max_messages, 1, SQS_MAX_MESSAGES))
CallParamInt(c, "WaitTimeSeconds", _clamp(o.wait_seconds, 0, SQS_MAX_WAIT))
if o.visibility_timeout > 0:
CallParamInt(c, "VisibilityTimeout", _clamp(o.visibility_timeout, 0, 43200))
end
if o.want_attributes: CallParam(c, "AttributeName.1", "All") end
if o.want_message_attributes:
CallParam(c, "MessageAttributeName.1", "All")
end
CallParam(c, "ReceiveRequestAttemptId", o.receive_request_attempt_id)
ret c
end
@en "ParseReceive"
@fa "تجزیه دریافت"
pub func ParseReceive(body: str, status: int): MessageList:
res := Result {
ok = status >= 200 and status < 300, status = status, body = body
}
if not res.ok:
ret MessageList {
status = status, error = ServiceErrorMessage(body, status), code = ServiceErrorCode(body)
}
end
mut ok := false
root := _root_of(res, ok)
mut out := MessageList { ok = true, status = status }
if not ok:
out.ok = false
out.error = "the queue's answer could not be parsed"
out.code = "MalformedXML"
ret out
end
holder := xml.Child(root, "ReceiveMessageResult")
mut rows := xml.Children(holder, "Message")
if rows.items.len() == 0: rows = xml.Children(root, "Message") end
mut i := 0
until i < rows.items.len():
out.items.push(_message_of(rows.items.get(i)))
i += 1
end
ret out
end
@en "SqsPoll"
@fa "اس کیو اس انتظار پیام"
pub func SqsPoll(cfg: Config, url: str): MessageList:
ret SqsReceive(cfg, url, ReceiveOptions {})
end
@en "SqsReceiveBatch"
@fa "اس کیو اس دریافت دسته"
pub func SqsReceiveBatch(cfg: Config, url: str, count: int): MessageList:
ret SqsReceive(cfg, url, ReceiveOptions { max_messages = count })
end
@en "MessageCount"
@fa "شمار پیام‌ها"
pub func MessageCount(l: MessageList): int: ret l.items.len() end
@en "MessageAt"
@fa "پیام شماره"
pub func MessageAt(l: MessageList, i: int): Message:
if i < 0 or i >= l.items.len(): ret Message {} end
ret l.items.get(i)
end
@en "MessageListFree"
@fa "آزادسازی فهرست پیام‌ها"
pub func MessageListFree(l &: MessageList): l.items.free() end
@en "MessageAttribute"
@fa "ویژگی پیام"
pub func MessageAttribute(m: Message, name: str): str:
ret HeaderGet(m.message_attributes, name)
end
@en "SqsDelete"
@fa "اس کیو اس حذف"
pub func SqsDelete(cfg: Config, url: str, receipt: str): Result:
if receipt.len() == 0:
ret Failure("a message cannot be deleted without its receipt handle")
end
mut c := _queue_call(url, "DeleteMessage")
CallParam(c, "ReceiptHandle", receipt)
res := Invoke(cfg, c)
CallFree(c)
ret res
end
@en "SqsDeleteBatch"
@fa "اس کیو اس حذف دسته"
pub func SqsDeleteBatch(cfg: Config, url: str, l: MessageList): Result:
total := l.items.len()
if total == 0: ret Result { ok = true, status = 200 } end
mut done := 0
mut last := Result { ok = true, status = 200 }
until done < total:
mut count := total - done
if count > SQS_MAX_BATCH: count = SQS_MAX_BATCH end
mut c := _queue_call(url, "DeleteMessageBatch")
mut i := 0
until i < count:
n := "DeleteMessageBatchRequestEntry." + (i + 1)
CallParam(c, n + ".Id", "m" + i)
CallParam(c, n + ".ReceiptHandle", l.items.get(done + i).receipt)
i += 1
end
res := Invoke(cfg, c)
CallFree(c)
if not res.ok: ret res end
if res.body.find("<BatchResultErrorEntry") >= 0:
mut bad := res
bad.ok = false
bad.code = ResultTag(res.body, "Code")
bad.error = "some messages were not deleted: " + ResultTag(res.body, "Message")
ret bad
end
last = res
done += count
end
ret last
end
@en "SqsChangeVisibility"
@fa "اس کیو اس تغییر پنهان‌ماندن"
pub func SqsChangeVisibility(
cfg: Config, url: str, receipt: str, seconds: int
): Result:
mut c := _queue_call(url, "ChangeMessageVisibility")
CallParam(c, "ReceiptHandle", receipt)
CallParamInt(c, "VisibilityTimeout", _clamp(seconds, 0, 43200))
res := Invoke(cfg, c)
CallFree(c)
ret res
end
@en "SqsRelease"
@fa "اس کیو اس رها کردن"
pub func SqsRelease(cfg: Config, url: str, receipt: str): Result:
ret SqsChangeVisibility(cfg, url, receipt, 0)
end
@en "SqsPurge"
@fa "اس کیو اس خالی کردن"
pub func SqsPurge(cfg: Config, url: str): Result:
mut c := _queue_call(url, "PurgeQueue")
res := Invoke(cfg, c)
CallFree(c)
ret res
end
@en "SqsAttributes"
@fa "اس کیو اس ویژگی‌ها"
pub func SqsAttributes(cfg: Config, url: str): Headers:
mut c := _queue_call(url, "GetQueueAttributes")
CallParam(c, "AttributeName.1", "All")
res := Invoke(cfg, c)
CallFree(c)
mut out := Headers {}
if not res.ok: ret out end
mut ok := false
root := _root_of(res, ok)
if not ok: ret out end
holder := xml.Child(root, "GetQueueAttributesResult")
if xml.Found(holder): _read_pairs(holder, "Attribute", out)
else:
_read_pairs(root, "Attribute", out)
end
ret out
end
@en "SqsSetAttributes"
@fa "اس کیو اس تنظیم ویژگی‌ها"
pub func SqsSetAttributes(cfg: Config, url: str, attributes: Headers): Result:
mut c := _queue_call(url, "SetQueueAttributes")
mut i := 0
until i < attributes.names.len():
n := "Attribute." + (i + 1)
CallParam(c, n + ".Name", attributes.names.get(i))
CallParam(c, n + ".Value", attributes.values.get(i))
i += 1
end
res := Invoke(cfg, c)
CallFree(c)
ret res
end
@en "SqsDepth"
@fa "اس کیو اس طول صف"
pub func SqsDepth(cfg: Config, url: str): int:
attrs := SqsAttributes(cfg, url)
v := HeaderGet(attrs, "ApproximateNumberOfMessages")
HeaderFree(attrs)
if v.len() == 0: ret 0 - 1 end
ret v.to_int()
end
@en "SqsRedrivePolicy"
@fa "اس کیو اس سیاست صف مرده"
pub func SqsRedrivePolicy(dead_letter_arn: str, max_receives: int): str:
mut n := max_receives
if n < 1: n = 5 end
ret "{\"deadLetterTargetArn\":\"" + dead_letter_arn + "\",\"maxReceiveCount\":\"" + n + "\"}"
end
@en "SqsQueueArn"
@fa "اس کیو اس شناسه صف"
pub func SqsQueueArn(cfg: Config, url: str): str:
attrs := SqsAttributes(cfg, url)
arn := HeaderGet(attrs, "QueueArn")
HeaderFree(attrs)
ret arn
end
package aws
import str
import time
import encoding.xml
@en "STS_VERSION"
@fa "نسخه اس تی اس"
pub const STS_VERSION := "2011-06-15"
@en "STS_MIN_DURATION"
@fa "کمینه مدت اس تی اس"
pub const STS_MIN_DURATION := 900
@en "STS_MAX_DURATION"
@fa "بیشینه مدت اس تی اس"
pub const STS_MAX_DURATION := 43200
@en "STS_DEFAULT_SKEW"
@fa "حاشیه زمانی پیش‌فرض"
pub const STS_DEFAULT_SKEW := 300
@en "Credentials"
@fa "اعتبارنامه"
pub struct Credentials:
pub ok: bool = false
pub access_key: str = ""
pub secret_key: str = ""
pub session_token: str = ""
pub expires: str = ""
pub expires_epoch: i64 = 0
pub source: str = ""
pub error: str = ""
pub code: str = ""
end
@en "Identity"
@fa "هویت"
pub struct Identity:
pub ok: bool = false
pub account: str = ""
pub arn: str = ""
pub user_id: str = ""
pub error: str = ""
pub code: str = ""
end
func _duration_of(seconds: int): int:
mut d := seconds
if d <= 0: ret 0 end
if d < STS_MIN_DURATION: d = STS_MIN_DURATION end
if d > STS_MAX_DURATION: d = STS_MAX_DURATION end
ret d
end
func _sts_failure(res: Result, source: str): Credentials:
ret Credentials {
ok = false, error = res.error, code = res.code, source = source
}
end
func _credentials_of(res: Result, source: str): Credentials:
if not res.ok: ret _sts_failure(res, source) end
mut ok := false
root := xml.DecodeStrict(res.body, ok)
if not ok:
ret Credentials {
error = "the security token service answer could not be parsed", code = "MalformedXML", source = source
}
end
mut holder := xml.Child(root, "Credentials")
if not xml.Found(holder):
mut i := 0
until i < root.children.len():
found := xml.Child(root.children.get(i), "Credentials")
if xml.Found(found):
holder = found
i = root.children.len()
else:
i += 1
end
end
end
if not xml.Found(holder):
ret Credentials {
error = "the answer carried no credentials", code = "MalformedXML", source = source
}
end
mut out := Credentials {
ok = true, access_key = _xml_text(holder, "AccessKeyId"), secret_key = _xml_text(holder, "SecretAccessKey"),
session_token = _xml_text(holder, "SessionToken"), expires = _xml_text(holder, "Expiration"),
source = source
}
out.expires_epoch = _iso_epoch(out.expires)
if out.access_key.len() == 0 or out.secret_key.len() == 0:
out.ok = false
out.error = "the answer carried an incomplete credential"
out.code = "MalformedXML"
end
ret out
end
func _sts_call(action: str): Call:
mut c := NewQueryCall("sts", action, STS_VERSION)
override := env.Get("AWS_ENDPOINT_URL_STS")
if override.len() > 0: CallEndpoint(c, override) end
ret c
end
@en "StsEndpoint"
@fa "نقطه پایانی اس تی اس"
pub func StsEndpoint(region: str): str:
if region.len() == 0: ret "https://sts.amazonaws.com" end
ret "https://sts." + region + ".amazonaws.com"
end
@en "AssumeRole"
@fa "گرفتن نقش"
pub func AssumeRole(
cfg: Config, role_arn: str, session_name: str, duration: int
): Credentials:
ret AssumeRoleWith(cfg, role_arn, session_name, duration, "", "")
end
@en "AssumeRoleWith"
@fa "گرفتن نقش با گزینه"
pub func AssumeRoleWith(
cfg: Config, role_arn: str, session_name: str, duration: int, external_id: str, policy_arn: str
): Credentials:
if role_arn.len() == 0:
ret Credentials { error = "no role was named", code = "Config" }
end
mut name := session_name
if name.len() == 0: name = "salam-session" end
mut c := _sts_call("AssumeRole")
CallParam(c, "RoleArn", role_arn)
CallParam(c, "RoleSessionName", name)
secs := _duration_of(duration)
if secs > 0: CallParamInt(c, "DurationSeconds", secs) end
CallParam(c, "ExternalId", external_id)
if policy_arn.len() > 0:
CallParam(c, "PolicyArns.member.1.arn", policy_arn)
end
res := Invoke(cfg, c)
CallFree(c)
ret _credentials_of(res, "AssumeRole " + role_arn)
end
@en "AssumeRoleWithWebIdentity"
@fa "گرفتن نقش با هویت وب"
pub func AssumeRoleWithWebIdentity(
cfg: Config, role_arn: str, session_name: str, web_identity_token: str, duration: int
): Credentials:
if role_arn.len() == 0 or web_identity_token.len() == 0:
ret Credentials {
error = "a role and a web identity token are both required", code = "Config"
}
end
mut name := session_name
if name.len() == 0: name = "salam-session" end
mut anon := cfg
anon.anonymous = true
mut c := _sts_call("AssumeRoleWithWebIdentity")
CallParam(c, "RoleArn", role_arn)
CallParam(c, "RoleSessionName", name)
CallParam(c, "WebIdentityToken", web_identity_token)
secs := _duration_of(duration)
if secs > 0: CallParamInt(c, "DurationSeconds", secs) end
res := Invoke(anon, c)
CallFree(c)
ret _credentials_of(res, "AssumeRoleWithWebIdentity " + role_arn)
end
@en "GetSessionToken"
@fa "گرفتن توکن نشست"
pub func GetSessionToken(
cfg: Config, duration: int, mfa_serial: str, mfa_code: str
): Credentials:
mut c := _sts_call("GetSessionToken")
secs := _duration_of(duration)
if secs > 0: CallParamInt(c, "DurationSeconds", secs) end
CallParam(c, "SerialNumber", mfa_serial)
CallParam(c, "TokenCode", mfa_code)
res := Invoke(cfg, c)
CallFree(c)
ret _credentials_of(res, "GetSessionToken")
end
@en "GetFederationToken"
@fa "گرفتن توکن فدراسیون"
pub func GetFederationToken(
cfg: Config, name: str, policy_json: str, duration: int
): Credentials:
if name.len() == 0 or policy_json.len() == 0:
ret Credentials {
error = "a name and a policy are both required", code = "Config"
}
end
mut c := _sts_call("GetFederationToken")
CallParam(c, "Name", name)
CallParam(c, "Policy", policy_json)
secs := _duration_of(duration)
if secs > 0: CallParamInt(c, "DurationSeconds", secs) end
res := Invoke(cfg, c)
CallFree(c)
ret _credentials_of(res, "GetFederationToken " + name)
end
@en "GetCallerIdentity"
@fa "هویت فراخواننده"
pub func GetCallerIdentity(cfg: Config): Identity:
mut c := _sts_call("GetCallerIdentity")
res := Invoke(cfg, c)
CallFree(c)
if not res.ok:
ret Identity { error = res.error, code = res.code }
end
ret Identity {
ok = true, account = ResultTag(res.body, "Account"), arn = ResultTag(res.body, "Arn"), user_id = ResultTag(res.body, "UserId")
}
end
@en "Apply"
@fa "اعمال اعتبارنامه"
pub func Apply(cfg: Config, creds: Credentials): Config:
mut out := cfg
if not creds.ok: ret out end
out.access_key = creds.access_key
out.secret_key = creds.secret_key
out.session_token = creds.session_token
out.anonymous = false
ret out
end
@en "StaticCredentials"
@fa "اعتبارنامه ثابت"
pub func StaticCredentials(access_key: str, secret_key: str): Credentials:
ret Credentials {
ok = access_key.len() > 0 and secret_key.len() > 0, access_key = access_key, secret_key = secret_key,
source = "static"
}
end
@en "Expired"
@fa "منقضی شده"
pub func Expired(creds: Credentials, now: i64, skew: int): bool:
if not creds.ok: ret true end
if creds.expires_epoch == 0 as i64: ret false end
mut margin := skew
if margin < 0: margin = STS_DEFAULT_SKEW end
ret creds.expires_epoch - (margin as i64) <= now
end
@en "ExpiredNow"
@fa "منقضی شده اکنون"
pub func ExpiredNow(creds: Credentials): bool:
ret Expired(creds, time.Now(), STS_DEFAULT_SKEW)
end
@en "SecondsRemaining"
@fa "ثانیه‌های باقی مانده"
pub func SecondsRemaining(creds: Credentials, now: i64): i64:
if creds.expires_epoch == 0 as i64: ret 0 - (1 as i64) end
ret creds.expires_epoch - now
end
@en "DescribeCredentials"
@fa "توصیف اعتبارنامه"
pub func DescribeCredentials(creds: Credentials): str:
if not creds.ok: ret "credentials unavailable: " + creds.error end
mut key := creds.access_key
if key.len() > 4: key = key.substr(0, 4) + "..." end
mut when := "no expiry"
if creds.expires_epoch != 0 as i64: when = "expires " + creds.expires end
mut kind := "long-lived"
if creds.session_token.len() > 0: kind = "temporary" end
ret kind + " " + key + ", " + when + ", from " + creds.source
end
@en "ParseCredentials"
@fa "تجزیه اعتبارنامه"
pub func ParseCredentials(body: str, status: int, source: str): Credentials:
ret _credentials_of(
Result {
ok = status >= 200 and status < 300, status = status, body = body
}, source
)
end
@en "bidi"
@fa "دوسویه"
package bidi
import str
import unicode
@en "DirAuto"
@fa "جهت خودکار"
pub const DirAuto := 0
@en "DirLTR"
@fa "جهت چپ به راست"
pub const DirLTR := 1
@en "DirRTL"
@fa "جهت راست به چپ"
pub const DirRTL := 2
const _MAX_DEPTH := 125
const _OVR_NEUTRAL := 0
const _OVR_LTR := 1
const _OVR_RTL := 2
inline pure func _is_isolate_init(t: int): bool:
ret t == unicode.BcLRI or t == unicode.BcRLI or t == unicode.BcFSI
end
inline pure func _is_removed(t: int): bool:
if t == unicode.BcRLE or t == unicode.BcLRE: ret true end
if t == unicode.BcRLO or t == unicode.BcLRO: ret true end
ret t == unicode.BcPDF or t == unicode.BcBN
end
inline pure func _is_ni(t: int): bool:
if t == unicode.BcB or t == unicode.BcS: ret true end
if t == unicode.BcWS or t == unicode.BcON: ret true end
ret _is_isolate_init(t) or t == unicode.BcPDI
end
inline pure func _level_dir(level: int): int:
if level % 2 == 1: ret unicode.BcR end
ret unicode.BcL
end
inline pure func _n_dir(t: int): int:
if t == unicode.BcR or t == unicode.BcEN or t == unicode.BcAN: ret unicode.BcR end
if t == unicode.BcL: ret unicode.BcL end
ret 0 - 1
end
func _new_ints(n: int, fill: int): Vector<int>:
out := Vector {} as Vector<int>
repeat n in _: out.push(fill) end
ret out
end
func _auto_level(types: Vector<int>, from: int, stop: int): int:
mut depth := 0
mut i := from
until i < stop:
t := types.get(i)
if _is_isolate_init(t):
depth += 1
else t == unicode.BcPDI:
if depth > 0: depth -= 1 end
else depth == 0:
if t == unicode.BcL: ret 0 end
if t == unicode.BcR or t == unicode.BcAL: ret 1 end
end
i += 1
end
ret 0
end
func _match_isolates(types: Vector<int>, pdi_of &: Vector<int>, init_of &: Vector<int>):
n := types.len()
stack := Vector {} as Vector<int>
defer stack.free()
repeat n in i:
t := types.get(i)
if _is_isolate_init(t):
stack.push(i)
else t == unicode.BcPDI:
if stack.len() > 0:
j := stack.pop()
pdi_of.set(j, i)
init_of.set(i, j)
end
end
end
end
func _explicit_levels(types &: Vector<int>, pdi_of: Vector<int>, para: int, levels &: Vector<int>):
n := types.len()
st_level := Vector {} as Vector<int>
defer st_level.free()
st_over := Vector {} as Vector<int>
defer st_over.free()
st_iso := Vector {} as Vector<int>
defer st_iso.free()
st_level.push(para)
st_over.push(_OVR_NEUTRAL)
st_iso.push(0)
mut overflow_iso := 0
mut overflow_emb := 0
mut valid_iso := 0
mut i := 0
until i < n:
t := types.get(i)
top := st_level.len() - 1
cur := st_level.get(top)
if t == unicode.BcRLE or t == unicode.BcLRE or t == unicode.BcRLO or t == unicode.BcLRO:
levels.set(i, cur)
mut next := cur + 1
if t == unicode.BcRLE or t == unicode.BcRLO:
if next % 2 == 0: next += 1 end
else:
if next % 2 == 1: next += 1 end
end
if next <= _MAX_DEPTH and overflow_iso == 0 and overflow_emb == 0:
st_level.push(next)
if t == unicode.BcRLO: st_over.push(_OVR_RTL)
else t == unicode.BcLRO: st_over.push(_OVR_LTR)
else:
st_over.push(_OVR_NEUTRAL)
end
st_iso.push(0)
else:
if overflow_iso == 0: overflow_emb += 1 end
end
else _is_isolate_init(t):
levels.set(i, cur)
if st_over.get(top) == _OVR_LTR: types.set(i, unicode.BcL)
else st_over.get(top) == _OVR_RTL: types.set(i, unicode.BcR) end
mut rtl := t == unicode.BcRLI
if t == unicode.BcFSI:
mut stop := pdi_of.get(i)
if stop < 0: stop = n end
rtl = _auto_level(types, i + 1, stop) == 1
end
mut next := cur + 1
if rtl:
if next % 2 == 0: next += 1 end
else:
if next % 2 == 1: next += 1 end
end
if next <= _MAX_DEPTH and overflow_iso == 0 and overflow_emb == 0:
valid_iso += 1
st_level.push(next)
st_over.push(_OVR_NEUTRAL)
st_iso.push(1)
else:
overflow_iso += 1
end
else t == unicode.BcPDI:
if overflow_iso > 0:
overflow_iso -= 1
else valid_iso > 0:
overflow_emb = 0
until st_iso.get(st_level.len() - 1) == 0:
st_level.pop()
st_over.pop()
st_iso.pop()
end
st_level.pop()
st_over.pop()
st_iso.pop()
valid_iso -= 1
end
ntop := st_level.len() - 1
levels.set(i, st_level.get(ntop))
if st_over.get(ntop) == _OVR_LTR: types.set(i, unicode.BcL)
else st_over.get(ntop) == _OVR_RTL: types.set(i, unicode.BcR) end
else t == unicode.BcPDF:
levels.set(i, cur)
if overflow_iso > 0:
overflow_iso += 0
else overflow_emb > 0:
overflow_emb -= 1
else st_iso.get(top) == 0 and st_level.len() >= 2:
st_level.pop()
st_over.pop()
st_iso.pop()
end
levels.set(i, st_level.get(st_level.len() - 1))
else t == unicode.BcB:
levels.set(i, para)
else:
levels.set(i, cur)
if st_over.get(top) == _OVR_LTR: types.set(i, unicode.BcL)
else st_over.get(top) == _OVR_RTL: types.set(i, unicode.BcR) end
end
i += 1
end
end
func _resolve_weak(types &: Vector<int>, seq: Vector<int>, sos: int):
m := seq.len()
mut prev := sos
repeat m in k:
p := seq.get(k)
t := types.get(p)
if t == unicode.BcNSM:
if _is_isolate_init(prev) or prev == unicode.BcPDI:
types.set(p, unicode.BcON)
else:
types.set(p, prev)
end
end
prev = types.get(p)
end
mut strong := sos
repeat m in k:
p := seq.get(k)
t := types.get(p)
if t == unicode.BcL or t == unicode.BcR or t == unicode.BcAL: strong = t end
if t == unicode.BcEN and strong == unicode.BcAL:
types.set(p, unicode.BcAN)
end
end
repeat m in k:
p := seq.get(k)
if types.get(p) == unicode.BcAL: types.set(p, unicode.BcR) end
end
repeat m in k:
if k == 0: continue end
if k + 1 >= m: continue end
p := seq.get(k)
t := types.get(p)
before := types.get(seq.get(k - 1))
after := types.get(seq.get(k + 1))
if t == unicode.BcES and before == unicode.BcEN and after == unicode.BcEN:
types.set(p, unicode.BcEN)
else t == unicode.BcCS and before == unicode.BcEN and after == unicode.BcEN:
types.set(p, unicode.BcEN)
else t == unicode.BcCS and before == unicode.BcAN and after == unicode.BcAN:
types.set(p, unicode.BcAN)
end
end
mut k := 0
until k < m:
if types.get(seq.get(k)) != unicode.BcET:
k += 1
continue
end
mut e := k
until e < m and types.get(seq.get(e)) == unicode.BcET:
e += 1
end
mut adjacent := false
if k > 0 and types.get(seq.get(k - 1)) == unicode.BcEN: adjacent = true end
if e < m and types.get(seq.get(e)) == unicode.BcEN: adjacent = true end
if adjacent:
mut j := k
until j < e:
types.set(seq.get(j), unicode.BcEN)
j += 1
end
end
k = e
end
repeat m in q:
p := seq.get(q)
t := types.get(p)
if t == unicode.BcET or t == unicode.BcES or t == unicode.BcCS:
types.set(p, unicode.BcON)
end
end
strong = sos
repeat m in q:
p := seq.get(q)
t := types.get(p)
if t == unicode.BcL or t == unicode.BcR: strong = t end
if t == unicode.BcEN and strong == unicode.BcL:
types.set(p, unicode.BcL)
end
end
end
inline pure func _canon_bracket(cp: int): int:
if cp == 0x3008: ret 0x2329 end
if cp == 0x3009: ret 0x232A end
ret cp
end
func _resolve_brackets(cps: Vector<int>, types &: Vector<int>, seq: Vector<int>, level: int, sos: int):
m := seq.len()
e := _level_dir(level)
mut o := unicode.BcL
if e == unicode.BcL: o = unicode.BcR end
stack_pos := Vector {} as Vector<int>
defer stack_pos.free()
stack_cp := Vector {} as Vector<int>
defer stack_cp.free()
open_at := Vector {} as Vector<int>
defer open_at.free()
close_at := Vector {} as Vector<int>
defer close_at.free()
mut k := 0
until k < m:
p := seq.get(k)
if types.get(p) == unicode.BcON:
cp := cps.get(p)
bt := unicode.PairedBracketType(cp)
if bt == unicode.PbtOpen:
if stack_cp.len() >= 63: break end
stack_pos.push(k)
stack_cp.push(_canon_bracket(unicode.PairedBracket(cp)))
else bt == unicode.PbtClose:
mut d := stack_cp.len() - 1
until d >= 0:
if stack_cp.get(d) == _canon_bracket(cp):
open_at.push(stack_pos.get(d))
close_at.push(k)
until stack_cp.len() > d:
stack_cp.pop()
stack_pos.pop()
end
break
end
d -= 1
end
end
end
k += 1
end
mut a := 0
until a < open_at.len():
mut b := a + 1
until b < open_at.len():
if open_at.get(b) < open_at.get(a):
t1 := open_at.get(a)
open_at.set(a, open_at.get(b))
open_at.set(b, t1)
t2 := close_at.get(a)
close_at.set(a, close_at.get(b))
close_at.set(b, t2)
end
b += 1
end
a += 1
end
mut pair := 0
until pair < open_at.len():
ko := open_at.get(pair)
kc := close_at.get(pair)
mut found_e := false
mut found_o := false
mut q := ko + 1
until q < kc:
d := _n_dir(types.get(seq.get(q)))
if d == e: found_e = true end
if d == o: found_o = true end
q += 1
end
mut chosen := 0 - 1
if found_e:
chosen = e
else found_o:
mut ctx := sos
mut r := ko - 1
until r >= 0:
d := _n_dir(types.get(seq.get(r)))
if d >= 0:
ctx = d
break
end
r -= 1
end
if ctx == o: chosen = o
else:
chosen = e
end
end
if chosen >= 0:
types.set(seq.get(ko), chosen)
types.set(seq.get(kc), chosen)
mut z := ko + 1
until z < m and _orig_nsm(cps, seq, z):
types.set(seq.get(z), chosen)
z += 1
end
z = kc + 1
until z < m and _orig_nsm(cps, seq, z):
types.set(seq.get(z), chosen)
z += 1
end
end
pair += 1
end
end
inline func _orig_nsm(cps: Vector<int>, seq: Vector<int>, k: int): bool:
ret unicode.BidiClass(cps.get(seq.get(k))) == unicode.BcNSM
end
func _resolve_neutrals(types &: Vector<int>, seq: Vector<int>, level: int, sos: int, eos: int):
m := seq.len()
e := _level_dir(level)
mut k := 0
until k < m:
if _is_ni(types.get(seq.get(k))) == false:
k += 1
continue
end
mut end_k := k
until end_k < m and _is_ni(types.get(seq.get(end_k))):
end_k += 1
end
mut before := sos
if k > 0: before = _n_dir(types.get(seq.get(k - 1))) end
mut after := eos
if end_k < m: after = _n_dir(types.get(seq.get(end_k))) end
mut fill := e
if before == after and before >= 0: fill = before end
mut j := k
until j < end_k:
types.set(seq.get(j), fill)
j += 1
end
k = end_k
end
end
func _resolve_implicit(types: Vector<int>, seq: Vector<int>, levels &: Vector<int>):
m := seq.len()
repeat m in k:
p := seq.get(k)
t := types.get(p)
lv := levels.get(p)
if lv % 2 == 0:
if t == unicode.BcR: levels.set(p, lv + 1)
else t == unicode.BcAN or t == unicode.BcEN: levels.set(p, lv + 2) end
else:
if t == unicode.BcL or t == unicode.BcAN or t == unicode.BcEN:
levels.set(p, lv + 1)
end
end
end
end
func _code_points(s: str): Vector<int>:
out := Vector {} as Vector<int>
n := s.len()
mut i := 0
mut cp := 0
until i < n:
i = str.CodePointAt(s, i, cp)
if cp < 0: cp = 0xFFFD end
out.push(cp)
end
ret out
end
func _resolve(cps: Vector<int>, dir: int, levels &: Vector<int>): int:
n := cps.len()
orig := Vector {} as Vector<int>
defer orig.free()
types := Vector {} as Vector<int>
defer types.free()
repeat n in i:
c := unicode.BidiClass(cps.get(i))
orig.push(c)
types.push(c)
end
pdi_of := _new_ints(n, 0 - 1)
defer pdi_of.free()
init_of := _new_ints(n, 0 - 1)
defer init_of.free()
_match_isolates(types, pdi_of, init_of)
mut para := 0
if dir == DirRTL: para = 1
else dir == DirLTR: para = 0
else:
para = _auto_level(types, 0, n)
end
repeat n in i: levels.set(i, para) end
_explicit_levels(types, pdi_of, para, levels)
explicit := _new_ints(n, 0)
defer explicit.free()
repeat n in i: explicit.set(i, levels.get(i)) end
retained := Vector {} as Vector<int>
defer retained.free()
repeat n in i:
if _is_removed(orig.get(i)) == false: retained.push(i) end
end
rn := retained.len()
run_start := Vector {} as Vector<int>
defer run_start.free()
run_end := Vector {} as Vector<int>
defer run_end.free()
run_of := _new_ints(n, 0 - 1)
defer run_of.free()
mut k := 0
until k < rn:
mut e := k
lv := explicit.get(retained.get(k))
until e < rn and explicit.get(retained.get(e)) == lv:
run_of.set(retained.get(e), run_start.len())
e += 1
end
run_start.push(k)
run_end.push(e - 1)
k = e
end
used := _new_ints(run_start.len(), 0)
defer used.free()
mut r := 0
until r < run_start.len():
if used.get(r) == 1:
r += 1
continue
end
first := retained.get(run_start.get(r))
if orig.get(first) == unicode.BcPDI and init_of.get(first) >= 0:
r += 1
continue
end
seq := Vector {} as Vector<int>
defer seq.free()
mut cur := r
until true:
used.set(cur, 1)
mut q := run_start.get(cur)
until q <= run_end.get(cur):
seq.push(retained.get(q))
q += 1
end
last := retained.get(run_end.get(cur))
if _is_isolate_init(orig.get(last)) == false: break end
nxt := pdi_of.get(last)
if nxt < 0: break end
nr := run_of.get(nxt)
if nr < 0 or used.get(nr) == 1: break end
cur = nr
end
level := explicit.get(seq.get(0))
mut prev_level := para
pi := run_start.get(r) - 1
if pi >= 0: prev_level = explicit.get(retained.get(pi)) end
mut hi := level
if prev_level > hi: hi = prev_level end
sos := _level_dir(hi)
seq_last := seq.get(seq.len() - 1)
mut next_level := para
if _is_isolate_init(orig.get(seq_last)) and pdi_of.get(seq_last) < 0:
next_level = para
else:
ni := run_end.get(cur) + 1
if ni < rn: next_level = explicit.get(retained.get(ni)) end
end
hi = level
if next_level > hi: hi = next_level end
eos := _level_dir(hi)
_resolve_weak(types, seq, sos)
_resolve_brackets(cps, types, seq, level, sos)
_resolve_neutrals(types, seq, level, sos, eos)
_resolve_implicit(types, seq, levels)
r += 1
end
mut trailing := true
mut q := rn - 1
until q >= 0:
p := retained.get(q)
t := orig.get(p)
if t == unicode.BcB or t == unicode.BcS:
levels.set(p, para)
trailing = true
else t == unicode.BcWS or _is_isolate_init(t) or t == unicode.BcPDI:
if trailing: levels.set(p, para) end
else:
trailing = false
end
q -= 1
end
repeat n in i:
if _is_removed(orig.get(i)): levels.set(i, 0 - 1) end
end
ret para
end
@en "ParagraphLevel"
@fa "تراز بند"
pub func ParagraphLevel(s: str, dir: int): int:
cps := _code_points(s)
defer cps.free()
levels := _new_ints(cps.len(), 0)
defer levels.free()
ret _resolve(cps, dir, levels)
end
@en "Levels"
@fa "ترازها"
pub func Levels(s: str, dir: int): Vector<int>:
cps := _code_points(s)
defer cps.free()
levels := _new_ints(cps.len(), 0)
_resolve(cps, dir, levels)
ret levels
end
@en "VisualOrder"
@fa "ترتیب دیداری"
pub func VisualOrder(s: str, dir: int): Vector<int>:
cps := _code_points(s)
defer cps.free()
n := cps.len()
levels := _new_ints(n, 0)
defer levels.free()
_resolve(cps, dir, levels)
order := Vector {} as Vector<int>
keep := Vector {} as Vector<int>
defer keep.free()
repeat n in i:
if levels.get(i) >= 0:
order.push(i)
keep.push(levels.get(i))
end
end
m := order.len()
if m == 0: ret order end
mut highest := 0
mut lowest_odd := _MAX_DEPTH + 2
repeat m in i:
lv := keep.get(i)
if lv > highest: highest = lv end
if lv % 2 == 1 and lv < lowest_odd: lowest_odd = lv end
end
mut lv := highest
until lv >= lowest_odd:
mut i := 0
until i < m:
if keep.get(i) < lv:
i += 1
continue
end
mut e := i
until e < m and keep.get(e) >= lv:
e += 1
end
mut a := i
mut b := e - 1
until a < b:
t := order.get(a)
order.set(a, order.get(b))
order.set(b, t)
a += 1
b -= 1
end
i = e
end
lv -= 1
end
ret order
end
@en "Reorder"
@fa "بازچینش"
pub func Reorder(s: str, dir: int): str:
cps := _code_points(s)
defer cps.free()
order := VisualOrder(s, dir)
defer order.free()
mut sb := str.NewBuilder()
defer str.BufFree(sb)
repeat order.len() in i:
str.BufAppendCp(sb, cps.get(order.get(i)))
end
ret str.BufStr(sb)
end
package bigint
@en "Neg"
@fa "قرینه"
pub func Neg(x: Int): Int:
mut r := x.clone()
if not r.is_zero(): r.neg = not r.neg end
ret r
end
@en "Abs"
@fa "قدرمطلق"
pub func Abs(x: Int): Int:
mut r := x.clone()
r.neg = false
ret r
end
@en "Add"
@fa "جمع"
pub func Add(a: Int, b: Int): Int:
if a.neg == b.neg:
mut r := _uadd(a, b)
r.neg = a.neg
_norm(r)
ret r
end
c := _ucmp(a, b)
if c == 0: ret Int {} end
if c > 0:
mut r := _usub(a, b)
r.neg = a.neg
_norm(r)
ret r
end
mut r := _usub(b, a)
r.neg = b.neg
_norm(r)
ret r
end
@en "Sub"
@fa "تفریق"
pub func Sub(a: Int, b: Int): Int:
mut nb := b.clone()
defer nb.free()
if not nb.is_zero(): nb.neg = not nb.neg end
ret Add(a, nb)
end
@en "Mul"
@fa "ضرب"
pub func Mul(a: Int, b: Int): Int:
mut r := _umul(a, b)
r.neg = a.neg != b.neg
_norm(r)
ret r
end
@en "Sqr"
@fa "مربع"
pub func Sqr(x: Int): Int: ret Mul(x, x) end
@en "AddInt"
@fa "جمع صحیح"
pub func AddInt(a: Int, v: i64): Int:
mut b := FromInt(v)
defer b.free()
ret Add(a, b)
end
@en "SubInt"
@fa "تفریق صحیح"
pub func SubInt(a: Int, v: i64): Int:
mut b := FromInt(v)
defer b.free()
ret Sub(a, b)
end
@en "MulInt"
@fa "ضرب صحیح"
pub func MulInt(a: Int, v: i64): Int:
mut b := FromInt(v)
defer b.free()
ret Mul(a, b)
end
@en "Shl"
@fa "شیفت چپ"
pub func Shl(x: Int, k: int): Int:
if k < 0: ret Shr(x, 0 - k) end
mut r := _ushl(x, k)
r.neg = x.neg
_norm(r)
ret r
end
@en "Shr"
@fa "شیفت راست"
pub func Shr(x: Int, k: int): Int:
if k < 0: ret Shl(x, 0 - k) end
mut r := _ushr(x, k)
if x.neg:
if _has_low_bits(x, k):
mut one := One()
defer one.free()
bumped := _uadd(r, one)
r.free()
r = bumped
end
r.neg = true
end
_norm(r)
ret r
end
@en "Set"
@fa "تنظیم"
pub func Set(x &: Int, src: Int): _replace(x, src.clone()) end
@en "SetInt"
@fa "تنظیم صحیح"
pub func SetInt(x &: Int, v: i64): _replace(x, FromInt(v)) end
@en "AddTo"
@fa "افزودن به"
pub func AddTo(x &: Int, y: Int): _replace(x, Add(x, y)) end
@en "SubFrom"
@fa "کاستن از"
pub func SubFrom(x &: Int, y: Int): _replace(x, Sub(x, y)) end
@en "MulBy"
@fa "ضرب در"
pub func MulBy(x &: Int, y: Int): _replace(x, Mul(x, y)) end
@en "AddIntTo"
@fa "افزودن صحیح به"
pub func AddIntTo(x &: Int, v: i64): _replace(x, AddInt(x, v)) end
@en "MulIntBy"
@fa "ضرب در صحیح"
pub func MulIntBy(x &: Int, v: i64): _replace(x, MulInt(x, v)) end
@en "NegateIn"
@fa "قرینه‌سازی"
pub func NegateIn(x &: Int):
if not x.is_zero(): x.neg = not x.neg end
end
@en "ShlBy"
@fa "شیفت چپ در جا"
pub func ShlBy(x &: Int, k: int): _replace(x, Shl(x, k)) end
@en "ShrBy"
@fa "شیفت راست در جا"
pub func ShrBy(x &: Int, k: int): _replace(x, Shr(x, k)) end
package bigint
const _OP_AND := 0
const _OP_OR := 1
const _OP_XOR := 2
const _OP_ANDNOT := 3
func _op_u32(a: u32, b: u32, op: int): u32:
if op == _OP_AND: ret a & b end
if op == _OP_OR: ret a | b end
if op == _OP_XOR: ret a ^ b end
ret a & (~b)
end
func _op_bool(a: bool, b: bool, op: int): bool:
if op == _OP_AND: ret a and b end
if op == _OP_OR: ret a or b end
if op == _OP_XOR: ret a != b end
ret a and not b
end
func _tc_prep(x: Int): Int:
if not x.neg: ret Abs(x) end
mut one := One()
mut ax := Abs(x)
r := _usub(ax, one)
ax.free()
one.free()
ret r
end
func _tc_limb(p: Int, neg: bool, i: int): u32:
v := _at(p, i)
if neg: ret ~v end
ret v
end
func _bitop(a: Int, b: Int, op: int): Int:
mut pa := _tc_prep(a)
mut pb := _tc_prep(b)
mut n := pa.mag.len()
if pb.mag.len() > n: n = pb.mag.len() end
n += 1
rneg := _op_bool(a.neg, b.neg, op)
mut r := _blank(n)
repeat n in i:
r.mag.set(i, _op_u32(_tc_limb(pa, a.neg, i), _tc_limb(pb, b.neg, i), op))
end
pa.free()
pb.free()
if rneg:
mut carry := 1 as u64
repeat n in i:
t := ((~r.mag.get(i)) as u64) + carry
r.mag.set(i, (t & _LOW_MASK) as u32)
carry = t >> 32
end
if carry != 0 as u64: r.mag.push(carry as u32) end
r.neg = true
end
_norm(r)
ret r
end
@en "And"
@fa "اشتراک بیتی"
pub func And(a: Int, b: Int): Int: ret _bitop(a, b, _OP_AND) end
@en "Or"
@fa "اجتماع بیتی"
pub func Or(a: Int, b: Int): Int: ret _bitop(a, b, _OP_OR) end
@en "Xor"
@fa "یای انحصاری"
pub func Xor(a: Int, b: Int): Int: ret _bitop(a, b, _OP_XOR) end
@en "AndNot"
@fa "اشتراک با نقیض"
pub func AndNot(a: Int, b: Int): Int: ret _bitop(a, b, _OP_ANDNOT) end
@en "Not"
@fa "نقیض بیتی"
pub func Not(x: Int): Int:
mut one := One()
defer one.free()
mut s := Add(x, one)
NegateIn(s)
ret s
end
@en "PopCount"
@fa "شمار یک‌ها"
pub func PopCount(x: Int): int:
mut c := 0
repeat x.mag.len() in i:
mut v := x.mag.get(i)
until v != 0 as u32:
v = v & (v - (1 as u32))
c += 1
end
end
ret c
end
@en "TrailingZeros"
@fa "صفرهای پایانی"
pub func TrailingZeros(x: Int): int:
if x.is_zero(): ret 0 - 1 end
repeat x.mag.len() in i:
v := x.mag.get(i)
if v != 0 as u32:
mut k := 0
mut t := v
until (t & (1 as u32)) == 0 as u32:
t = t >> 1
k += 1
end
ret i * _LIMB_BITS + k
end
end
ret 0 - 1
end
package bigint
import str
func _digit_val(c: int, base: int): int:
mut d := 0 - 1
if c >= 48 and c <= 57: d = c - 48
else c >= 97 and c <= 122: d = c - 97 + 10
else c >= 65 and c <= 90: d = c - 65 + 10
end
if d < 0 or d >= base: ret 0 - 1 end
ret d
end
func _digit_char(d: int): int:
if d < 10: ret 48 + d end
ret 97 + (d - 10)
end
@en "ToStr"
@fa "به رشته"
pub func ToStr(x: Int): str: ret ToStrBase(x, 10) end
@en "ToStrBase"
@fa "به رشته با پایه"
pub func ToStrBase(x: Int, base: int): str:
if base < 2 or base > 36: ret "" end
if x.is_zero(): ret "0" end
mut pw := 1 as u64
mut per := 0
until pw * (base as u64) <= _LOW_MASK:
pw = pw * (base as u64)
per += 1
end
mut digits := Vector {} as Vector<int>
mut cur := Abs(x)
until not cur.is_zero():
mut rem := 0 as u32
nx := _udivmod_small(cur, pw as u32, rem)
cur.free()
cur = nx
mut chunk := rem as u64
radix := base as u64
if cur.is_zero():
until chunk > 0 as u64:
digits.push((chunk % radix) as int)
chunk = chunk / radix
end
else:
repeat per:
digits.push((chunk % radix) as int)
chunk = chunk / radix
end
end
end
cur.free()
mut b := str.NewBuilder()
if x.neg: str.BufAppendChar(b, 45) end
mut i := digits.len() - 1
until i >= 0:
str.BufAppendChar(b, _digit_char(digits.get(i)))
i -= 1
end
digits.free()
out := str.BufStr(b)
str.BufFree(b)
ret out
end
@en "ToHex"
@fa "به شانزده‌شانزدهی"
pub func ToHex(x: Int): str: ret ToStrBase(x, 16) end
@en "Parse"
@fa "تجزیه"
pub func Parse(s: str, ok &: bool): Int: ret ParseBase(s, 10, ok) end
@en "ParseBase"
@fa "تجزیه با پایه"
pub func ParseBase(s: str, base: int, ok &: bool): Int:
ok = false
if base != 0 and (base < 2 or base > 36): ret Int {} end
mut norm := s
if str.HasPersianDigits(s) or str.HasArabicDigits(s):
norm = str.ToEnglishDigits(s)
end
n := norm.len()
mut i := 0
until i < n and (norm[i] as int) == 32: i += 1 end
mut neg := false
if i < n:
c := norm[i] as int
if c == 45: neg = true i += 1
else c == 43: i += 1
end
end
mut b := base
if b == 0:
b = 10
if i + 1 < n and (norm[i] as int) == 48:
p := norm[i + 1] as int
if p == 120 or p == 88: b = 16 i += 2
else p == 98 or p == 66: b = 2 i += 2
else p == 111 or p == 79: b = 8 i += 2
end
end
end
mut pw := 1 as u64
mut per := 0
until pw * (b as u64) <= _LOW_MASK:
pw = pw * (b as u64)
per += 1
end
mut acc := Int {}
mut chunk := 0 as u64
mut in_chunk := 0
mut seen := 0
mut bad := false
mut last_sep := false
until i < n:
c := norm[i] as int
i += 1
if c == 95:
if seen == 0: bad = true break end
last_sep = true
continue
end
d := _digit_val(c, b)
if d < 0: bad = true break end
last_sep = false
seen += 1
chunk = chunk * (b as u64) + (d as u64)
in_chunk += 1
if in_chunk == per:
nx := _umul_add_small(acc, pw as u32, chunk as u32)
acc.free()
acc = nx
chunk = 0 as u64
in_chunk = 0
end
end
if bad or seen == 0 or last_sep:
acc.free()
ret Int {}
end
if in_chunk > 0:
mut mult := 1 as u64
repeat in_chunk: mult = mult * (b as u64) end
nx := _umul_add_small(acc, mult as u32, chunk as u32)
acc.free()
acc = nx
end
acc.neg = neg
_norm(acc)
ok = true
ret acc
end
@en "ParseOr"
@fa "تجزیه با پیش فرض"
pub func ParseOr(s: str, base: int): Int:
mut ok := false
mut v := ParseBase(s, base, ok)
if not ok:
v.free()
ret Int {}
end
ret v
end
@en "ToInt"
@fa "به صحیح"
pub func ToInt(x: Int, ok &: bool): i64:
ok = true
n := x.mag.len()
if n == 0: ret 0 end
if n > 2:
ok = false
ret 0
end
mut u := x.mag.get(0) as u64
if n == 2: u = u | ((x.mag.get(1) as u64) << 32) end
if x.neg:
if u > 0x8000000000000000 as u64:
ok = false
ret 0
end
ret (0 as i64) - (u as i64)
end
if u > 0x7FFFFFFFFFFFFFFF as u64:
ok = false
ret 0
end
ret u as i64
end
@en "ToIntClamped"
@fa "به صحیح محدود"
pub func ToIntClamped(x: Int): i64:
mut ok := true
v := ToInt(x, ok)
if ok: ret v end
if x.neg: ret 0 - 0x7FFFFFFFFFFFFFFF as i64 - (1 as i64) end
ret 0x7FFFFFFFFFFFFFFF
end
@en "ToFloat"
@fa "به اعشاری"
pub func ToFloat(x: Int): f64:
mut f := 0.0
mut i := x.mag.len() - 1
until i >= 0:
f = f * 4294967296.0 + (x.mag.get(i) as f64)
i -= 1
end
if x.neg: ret 0.0 - f end
ret f
end
@en "ByteLen"
@fa "طول بایت"
pub func ByteLen(x: Int): int: ret (x.bit_len() + 7) / 8 end
@en "FromBytes"
@fa "از بایت‌ها"
pub func FromBytes(p: void*, n: int): Int:
mut r := Int {}
if p == null or n <= 0: ret r end
src := p as u8*
nl := (n + 3) / 4
r.mag.zeros(nl)
mut i := 0
until i < n:
b := src[n - 1 - i] as u32
li := i / 4
sh := (i % 4) * 8
r.mag.set(li, r.mag.get(li) | (b << sh))
i += 1
end
_norm(r)
ret r
end
@en "ToBytes"
@fa "به بایت‌ها"
pub func ToBytes(x: Int, out: void*, n: int): bool:
if out == null or n < 0: ret false end
need := ByteLen(x)
if need > n: ret false end
dst := out as u8*
mut i := 0
until i < n:
li := i / 4
mut v := 0 as u32
if li < x.mag.len(): v = (x.mag.get(li) >> ((i % 4) * 8)) & (0xFF as u32) end
dst[n - 1 - i] = v as u8
i += 1
end
ret true
end
package bigint
const _BASE := 0x100000000 as u64
func _pad_to(x &: Int, n: int):
until x.mag.len() < n: x.mag.push(0 as u32) end
end
func _udivmod(a: Int, b: Int, q &: Int, r &: Int):
na := a.mag.len()
nb := b.mag.len()
if _ucmp(a, b) < 0:
_replace(q, Int {})
_replace(r, Abs(a))
ret
end
if nb == 1:
mut rem := 0 as u32
_replace(q, _udivmod_small(a, b.mag.get(0), rem))
mut rr := Int {}
if rem != 0 as u32: rr.mag.push(rem) end
_replace(r, rr)
ret
end
n := nb
m := na - nb
s := _LIMB_BITS - _bit_width(b.mag.get(nb - 1))
mut vn := _ushl(b, s)
defer vn.free()
_pad_to(vn, n)
mut un := _ushl(a, s)
defer un.free()
_pad_to(un, na + 1)
vtop := vn.mag.get(n - 1) as u64
vsec := vn.mag.get(n - 2) as u64
mut qq := _blank(m + 1)
mut j := m
until j >= 0:
num := ((un.mag.get(j + n) as u64) << 32) | (un.mag.get(j + n - 1) as u64)
mut qhat := num / vtop
mut rhat := num % vtop
mut again := true
until again:
again = false
if qhat >= _BASE or qhat * vsec > (rhat << 32) + (un.mag.get(j + n - 2) as u64):
qhat -= 1 as u64
rhat += vtop
if rhat < _BASE: again = true end
end
end
mut carry := 0 as u64
mut borrow := 0 as u64
repeat n in i:
p := qhat * (vn.mag.get(i) as u64) + carry
carry = p >> 32
plo := (p & _LOW_MASK) + borrow
cur := un.mag.get(i + j) as u64
if cur >= plo:
un.mag.set(i + j, (cur - plo) as u32)
borrow = 0 as u64
else:
un.mag.set(i + j, ((cur + _BASE) - plo) as u32)
borrow = 1 as u64
end
end
top := un.mag.get(j + n) as u64
sub := carry + borrow
if top >= sub:
un.mag.set(j + n, (top - sub) as u32)
else:
un.mag.set(j + n, ((top + _BASE) - sub) as u32)
qhat -= 1 as u64
mut c := 0 as u64
repeat n in i:
t := (un.mag.get(i + j) as u64) + (vn.mag.get(i) as u64) + c
un.mag.set(i + j, (t & _LOW_MASK) as u32)
c = t >> 32
end
un.mag.set(j + n, ((un.mag.get(j + n) as u64) + c) as u32)
end
qq.mag.set(j, qhat as u32)
j -= 1
end
_norm(qq)
_replace(q, qq)
mut rr := _blank(n)
repeat n in i: rr.mag.set(i, un.mag.get(i)) end
_norm(rr)
rs := _ushr(rr, s)
rr.free()
_replace(r, rs)
end
@en "DivMod"
@fa "تقسیم با باقیمانده"
pub func DivMod(a: Int, b: Int, q &: Int, r &: Int): bool:
if b.is_zero():
_replace(q, Int {})
_replace(r, Int {})
ret false
end
_udivmod(a, b, q, r)
q.neg = a.neg != b.neg
r.neg = a.neg
_norm(q)
_norm(r)
ret true
end
@en "Div"
@fa "تقسیم"
pub func Div(a: Int, b: Int): Int:
mut q := Int {}
mut r := Int {}
_ok := DivMod(a, b, q, r)
r.free()
ret q
end
@en "Rem"
@fa "باقیمانده"
pub func Rem(a: Int, b: Int): Int:
mut q := Int {}
mut r := Int {}
_ok := DivMod(a, b, q, r)
q.free()
ret r
end
@en "FloorDivMod"
@fa "تقسیم کف با باقیمانده"
pub func FloorDivMod(a: Int, b: Int, q &: Int, r &: Int): bool:
if not DivMod(a, b, q, r): ret false end
if not r.is_zero() and (a.neg != b.neg):
mut one := One()
defer one.free()
_replace(q, Sub(q, one))
_replace(r, Add(r, b))
end
ret true
end
@en "FloorDiv"
@fa "تقسیم کف"
pub func FloorDiv(a: Int, b: Int): Int:
mut q := Int {}
mut r := Int {}
_ok := FloorDivMod(a, b, q, r)
r.free()
ret q
end
@en "FloorMod"
@fa "باقیمانده کف"
pub func FloorMod(a: Int, b: Int): Int:
mut q := Int {}
mut r := Int {}
_ok := FloorDivMod(a, b, q, r)
q.free()
ret r
end
@en "Mod"
@fa "پیمانه"
pub func Mod(a: Int, m: Int): Int:
if m.is_zero(): ret Int {} end
mut q := Int {}
defer q.free()
mut r := Int {}
_udivmod(a, m, q, r)
if a.neg and not r.is_zero():
mut am := Abs(m)
defer am.free()
_replace(r, _usub(am, r))
end
r.neg = false
_norm(r)
ret r
end
@en "DivModInt"
@fa "تقسیم صحیح"
pub func DivModInt(a: Int, v: i64, rem &: i64): Int:
mut b := FromInt(v)
defer b.free()
mut q := Int {}
mut r := Int {}
defer r.free()
if not DivMod(a, b, q, r):
rem = 0 as i64
ret q
end
mut ok := true
rem = ToInt(r, ok)
ret q
end
@en "ModInt"
@fa "پیمانه صحیح"
pub func ModInt(a: Int, v: i64): i64:
mut m := FromInt(v)
defer m.free()
mut r := Mod(a, m)
defer r.free()
mut ok := true
ret ToInt(r, ok)
end
package bigint
func _half(x: Int): Int: ret _ushr(x, 1) end
@en "Pow"
@fa "توان"
pub func Pow(x: Int, e: int): Int:
if e < 0: ret Int {} end
if e == 0: ret One() end
mut result := One()
mut base := x.clone()
mut n := e
until n > 0:
if (n & 1) == 1:
t := Mul(result, base)
result.free()
result = t
end
n = n >> 1
if n > 0:
sq := Sqr(base)
base.free()
base = sq
end
end
base.free()
ret result
end
@en "Pow10"
@fa "توان ده"
pub func Pow10(n: int): Int:
if n < 0: ret Int {} end
mut r := One()
mut k := n
until k >= 9:
t := _umul_add_small(r, 1000000000 as u32, 0 as u32)
r.free()
r = t
k -= 9
end
if k > 0:
mut m := 1 as u32
repeat k: m = m * (10 as u32) end
t := _umul_add_small(r, m, 0 as u32)
r.free()
r = t
end
ret r
end
@en "ModExp"
@fa "توان پیمانه‌ای"
pub func ModExp(base: Int, e: Int, m: Int): Int:
if m.is_zero() or e.neg: ret Int {} end
mut mm := Abs(m)
mut one := One()
mut result := Mod(one, mm)
one.free()
mut b := Mod(base, mm)
mut i := e.bit_len() - 1
until i >= 0:
sq := Sqr(result)
result.free()
result = Mod(sq, mm)
sq.free()
if Bit(e, i) == 1:
p := Mul(result, b)
result.free()
result = Mod(p, mm)
p.free()
end
i -= 1
end
b.free()
mm.free()
ret result
end
@en "Gcd"
@fa "ب م م"
pub func Gcd(a: Int, b: Int): Int:
mut x := Abs(a)
mut y := Abs(b)
until not y.is_zero():
r := Mod(x, y)
x.free()
x = y
y = r
end
y.free()
ret x
end
@en "Lcm"
@fa "ک م م"
pub func Lcm(a: Int, b: Int): Int:
if a.is_zero() or b.is_zero(): ret Int {} end
mut g := Gcd(a, b)
mut d := Div(a, g)
g.free()
mut p := Mul(d, b)
d.free()
r := Abs(p)
p.free()
ret r
end
@en "ExtGcd"
@fa "ب م م گسترده"
pub func ExtGcd(a: Int, b: Int, x &: Int, y &: Int): Int:
mut old_r := Abs(a)
mut r := Abs(b)
mut old_s := One()
mut s := Int {}
mut old_t := Int {}
mut t := One()
until not r.is_zero():
q := Div(old_r, r)
qr := Mul(q, r)
nr := Sub(old_r, qr)
qr.free()
old_r.free()
old_r = r
r = nr
qs := Mul(q, s)
ns := Sub(old_s, qs)
qs.free()
old_s.free()
old_s = s
s = ns
qt := Mul(q, t)
nt := Sub(old_t, qt)
qt.free()
old_t.free()
old_t = t
t = nt
q.free()
end
r.free()
s.free()
t.free()
if a.neg: NegateIn(old_s) end
if b.neg: NegateIn(old_t) end
_replace(x, old_s)
_replace(y, old_t)
ret old_r
end
@en "ModInverse"
@fa "وارون پیمانه‌ای"
pub func ModInverse(a: Int, m: Int, ok &: bool): Int:
ok = false
if m.is_zero(): ret Int {} end
mut mm := Abs(m)
mut x := Int {}
mut y := Int {}
mut g := ExtGcd(a, mm, x, y)
y.free()
one := EqualsInt(g, 1 as i64)
g.free()
if not one:
x.free()
mm.free()
ret Int {}
end
r := Mod(x, mm)
x.free()
mm.free()
ok = true
ret r
end
@en "Sqrt"
@fa "جذر"
pub func Sqrt(x: Int): Int:
if x.neg or x.is_zero(): ret Int {} end
bl := x.bit_len()
if bl <= 2: ret One() end
mut one := One()
mut a := Shl(one, (bl + 1) / 2)
one.free()
until true:
d := Div(x, a)
sum := Add(a, d)
d.free()
b := _half(sum)
sum.free()
if Cmp(b, a) >= 0:
b.free()
break
end
a.free()
a = b
end
ret a
end
@en "Factorial"
@fa "فاکتوریل"
pub func Factorial(n: int): Int:
if n < 0: ret Int {} end
mut r := One()
mut i := 2
until i <= n:
MulIntBy(r, i as i64)
i += 1
end
ret r
end
@en "bigint"
@fa "عدد بزرگ"
package bigint
const _LIMB_BITS := 32
const _LOW_MASK := 0xFFFFFFFF as u64
@en "Int"
@fa "صحیح"
pub struct Int:
pub neg: bool = false
pub mag: Vector<u32> = Vector {}
@en "free"
@fa "آزادسازی"
pub func free(): this.mag.free() end
@en "is_zero"
@fa "صفر است"
pub func is_zero(): bool: ret this.mag.len() == 0 end
@en "sign"
@fa "علامت"
pub func sign(): int:
if this.mag.len() == 0: ret 0 end
if this.neg: ret 0 - 1 end
ret 1
end
@en "is_odd"
@fa "فرد است"
pub func is_odd(): bool:
if this.mag.len() == 0: ret false end
ret (this.mag.get(0) & (1 as u32)) != 0 as u32
end
@en "is_even"
@fa "زوج است"
pub func is_even(): bool: ret not this.is_odd() end
@en "bit_len"
@fa "طول بیت"
pub func bit_len(): int:
n := this.mag.len()
if n == 0: ret 0 end
ret (n - 1) * _LIMB_BITS + _bit_width(this.mag.get(n - 1))
end
@en "limb_count"
@fa "شمار لخت"
pub func limb_count(): int: ret this.mag.len() end
@en "clone"
@fa "همانند"
pub func clone(): Int:
mut r := Int {}
r.neg = this.neg
n := this.mag.len()
r.mag.reserve(n)
repeat n in i: r.mag.push(this.mag.get(i)) end
ret r
end
@en "to_str"
@fa "به رشته"
pub func to_str(): str: ret ToStrBase(this[0], 10) end
end
func _bit_width(v: u32): int:
mut x := v
mut n := 0
until x != 0 as u32:
n += 1
x = x >> 1
end
ret n
end
func _norm(x &: Int):
mut n := x.mag.len()
until n > 0 and x.mag.get(n - 1) == 0 as u32:
n -= 1
end
until x.mag.len() > n:
_dropped := x.mag.pop()
end
if n == 0: x.neg = false end
end
func _blank(n: int): Int:
mut r := Int {}
if n > 0: r.mag.zeros(n) end
ret r
end
func _at(x: Int, i: int): u32:
if i >= x.mag.len(): ret 0 end
ret x.mag.get(i)
end
func _ucmp(a: Int, b: Int): int:
na := a.mag.len()
nb := b.mag.len()
if na != nb:
if na < nb: ret 0 - 1 end
ret 1
end
mut i := na - 1
until i >= 0:
av := a.mag.get(i)
bv := b.mag.get(i)
if av != bv:
if av < bv: ret 0 - 1 end
ret 1
end
i -= 1
end
ret 0
end
func _uadd(a: Int, b: Int): Int:
na := a.mag.len()
nb := b.mag.len()
mut n := na
if nb > n: n = nb end
mut r := _blank(n + 1)
mut carry := 0 as u64
repeat n in i:
s := (_at(a, i) as u64) + (_at(b, i) as u64) + carry
r.mag.set(i, (s & _LOW_MASK) as u32)
carry = s >> 32
end
r.mag.set(n, carry as u32)
_norm(r)
ret r
end
func _usub(a: Int, b: Int): Int:
na := a.mag.len()
mut r := _blank(na)
mut borrow := 0 as u64
repeat na in i:
av := a.mag.get(i) as u64
bv := (_at(b, i) as u64) + borrow
if av >= bv:
r.mag.set(i, (av - bv) as u32)
borrow = 0 as u64
else:
r.mag.set(i, ((av + 0x100000000 as u64) - bv) as u32)
borrow = 1 as u64
end
end
_norm(r)
ret r
end
func _umul(a: Int, b: Int): Int:
na := a.mag.len()
nb := b.mag.len()
if na == 0 or nb == 0: ret Int {} end
mut r := _blank(na + nb)
repeat na in i:
av := a.mag.get(i) as u64
if av != 0 as u64:
mut carry := 0 as u64
repeat nb in j:
cur := (r.mag.get(i + j) as u64) + av * (b.mag.get(j) as u64) + carry
r.mag.set(i + j, (cur & _LOW_MASK) as u32)
carry = cur >> 32
end
r.mag.set(i + nb, carry as u32)
end
end
_norm(r)
ret r
end
func _umul_add_small(x: Int, m: u32, add: u32): Int:
n := x.mag.len()
mut r := _blank(n + 1)
mut carry := add as u64
repeat n in i:
cur := (x.mag.get(i) as u64) * (m as u64) + carry
r.mag.set(i, (cur & _LOW_MASK) as u32)
carry = cur >> 32
end
r.mag.set(n, carry as u32)
_norm(r)
ret r
end
func _udivmod_small(x: Int, d: u32, rem &: u32): Int:
n := x.mag.len()
mut q := _blank(n)
mut r := 0 as u64
mut i := n - 1
dv := d as u64
until i >= 0:
cur := (r << 32) | (x.mag.get(i) as u64)
q.mag.set(i, (cur / dv) as u32)
r = cur % dv
i -= 1
end
rem = r as u32
_norm(q)
ret q
end
func _ushl(x: Int, k: int): Int:
n := x.mag.len()
if n == 0 or k <= 0:
mut c := x.clone()
c.neg = false
ret c
end
limbs := k / _LIMB_BITS
bits := k % _LIMB_BITS
mut r := _blank(n + limbs + 1)
if bits == 0:
repeat n in i: r.mag.set(i + limbs, x.mag.get(i)) end
else:
mut carry := 0 as u32
repeat n in i:
v := x.mag.get(i)
r.mag.set(i + limbs, (v << bits) | carry)
carry = v >> (_LIMB_BITS - bits)
end
r.mag.set(n + limbs, carry)
end
_norm(r)
ret r
end
func _ushr(x: Int, k: int): Int:
n := x.mag.len()
limbs := k / _LIMB_BITS
if n == 0 or k <= 0:
mut c := x.clone()
c.neg = false
ret c
end
if limbs >= n: ret Int {} end
bits := k % _LIMB_BITS
keep := n - limbs
mut r := _blank(keep)
if bits == 0:
repeat keep in i: r.mag.set(i, x.mag.get(i + limbs)) end
else:
repeat keep in i:
mut v := x.mag.get(i + limbs) >> bits
if i + limbs + 1 < n:
v = v | (x.mag.get(i + limbs + 1) << (_LIMB_BITS - bits))
end
r.mag.set(i, v)
end
end
_norm(r)
ret r
end
func _has_low_bits(x: Int, k: int): bool:
if k <= 0: ret false end
limbs := k / _LIMB_BITS
bits := k % _LIMB_BITS
n := x.mag.len()
mut i := 0
until i < limbs and i < n:
if x.mag.get(i) != 0 as u32: ret true end
i += 1
end
if bits > 0 and limbs < n:
mask := ((1 as u32) << bits) - (1 as u32)
if (x.mag.get(limbs) & mask) != 0 as u32: ret true end
end
ret false
end
func _replace(x &: Int, src: Int):
x.mag.free()
x.neg = src.neg
x.mag = src.mag
end
@en "Zero"
@fa "صفر"
pub func Zero(): Int: ret Int {} end
@en "One"
@fa "یک"
pub func One(): Int: ret FromInt(1 as i64) end
@en "FromInt"
@fa "از صحیح"
pub func FromInt(v: i64): Int:
mut r := Int {}
if v == 0 as i64: ret r end
mut u := v as u64
if v < 0 as i64:
r.neg = true
u = (0 as u64) - (v as u64)
end
lo := (u & _LOW_MASK) as u32
hi := (u >> 32) as u32
r.mag.push(lo)
if hi != 0 as u32: r.mag.push(hi) end
_norm(r)
ret r
end
@en "FromUint"
@fa "از صحیح بی‌علامت"
pub func FromUint(v: u64): Int:
mut r := Int {}
if v == 0 as u64: ret r end
r.mag.push((v & _LOW_MASK) as u32)
hi := (v >> 32) as u32
if hi != 0 as u32: r.mag.push(hi) end
_norm(r)
ret r
end
@en "Clone"
@fa "همانند"
pub func Clone(x: Int): Int: ret x.clone() end
@en "Free"
@fa "آزادسازی"
pub func Free(x &: Int): x.mag.free() end
@en "IsZero"
@fa "صفر است"
pub func IsZero(x: Int): bool: ret x.is_zero() end
@en "Sign"
@fa "علامت"
pub func Sign(x: Int): int: ret x.sign() end
@en "BitLen"
@fa "طول بیت"
pub func BitLen(x: Int): int: ret x.bit_len() end
@en "Bit"
@fa "بیت"
pub func Bit(x: Int, i: int): int:
if i < 0: ret 0 end
limb := i / _LIMB_BITS
if limb >= x.mag.len(): ret 0 end
ret ((x.mag.get(limb) >> (i % _LIMB_BITS)) & (1 as u32)) as int
end
@en "IsOdd"
@fa "فرد است"
pub func IsOdd(x: Int): bool: ret x.is_odd() end
@en "IsEven"
@fa "زوج است"
pub func IsEven(x: Int): bool: ret x.is_even() end
@en "Cmp"
@fa "مقایسه"
pub func Cmp(a: Int, b: Int): int:
if a.neg != b.neg:
if a.neg: ret 0 - 1 end
ret 1
end
c := _ucmp(a, b)
if a.neg: ret 0 - c end
ret c
end
@en "CmpAbs"
@fa "مقایسه قدرمطلق"
pub func CmpAbs(a: Int, b: Int): int: ret _ucmp(a, b) end
@en "Equals"
@fa "یکسان است"
pub func Equals(a: Int, b: Int): bool: ret Cmp(a, b) == 0 end
@en "Less"
@fa "کمتر است"
pub func Less(a: Int, b: Int): bool: ret Cmp(a, b) < 0 end
@en "Greater"
@fa "بیشتر است"
pub func Greater(a: Int, b: Int): bool: ret Cmp(a, b) > 0 end
@en "Min"
@fa "کمینه"
pub func Min(a: Int, b: Int): Int:
if Cmp(a, b) <= 0: ret a.clone() end
ret b.clone()
end
@en "Max"
@fa "بیشینه"
pub func Max(a: Int, b: Int): Int:
if Cmp(a, b) >= 0: ret a.clone() end
ret b.clone()
end
@en "EqualsInt"
@fa "یکسان با صحیح است"
pub func EqualsInt(a: Int, v: i64): bool:
mut b := FromInt(v)
defer b.free()
ret Cmp(a, b) == 0
end
package calendar
func _shiftMonth(year: int, month: int, n: int): GregorianDate:
total := (year as i64) * 12 + ((month - 1) as i64) + (n as i64)
y := _floordiv(total, 12)
m := _floormod(total, 12) + 1
ret GregorianDate { year = y as int, month = m as int, day = 1 }
end
@en "AddDaysGregorian"
@fa "افزودن روز میلادی"
pub func AddDaysGregorian(d: GregorianDate, n: int): GregorianDate:
