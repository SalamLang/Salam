ret (hi << 8) | lo
end
func _rd24(r &: Reader): int:
a := _rd8(r)
b := _rd8(r)
c := _rd8(r)
ret (a << 16) | (b << 8) | c
end
func _rd32(r &: Reader): i64:
a := _rd8(r) as i64
b := _rd8(r) as i64
c := _rd8(r) as i64
d := _rd8(r) as i64
ret (a << 24) | (b << 16) | (c << 8) | d
end
func _rdskip(r &: Reader, n: int):
if not _rdneed(r, n):
ret
end
r.pos += n
end
func _rdbytes(r &: Reader, n: int): Reader:
if not _rdneed(r, n):
ret _newreader(null, 0)
end
out := _subreader(r, r.pos, n)
r.pos += n
ret out
end
func _rdvec8(r &: Reader): Reader:
n := _rd8(r)
ret _rdbytes(r, n)
end
func _rdvec16(r &: Reader): Reader:
n := _rd16(r)
ret _rdbytes(r, n)
end
func _rdvec24(r &: Reader): Reader:
n := _rd24(r)
ret _rdbytes(r, n)
end
func _rdinto(r &: Reader, b &: Buf, n: int):
