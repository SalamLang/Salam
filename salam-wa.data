pub secure: bool = false
pub ok: bool = false
end
struct Bytes:
pub p: void* = null
pub len: int = 0
pub cap: int = 0
end
@en "FileInfo"
@fa "اطلاعات پرونده"
pub struct FileInfo:
pub name: str = ""
pub size: i64 = 0 as i64
pub is_dir: bool = false
pub is_link: bool = false
pub mode: str = ""
pub raw_date: str = ""
end
@en "Client"
@fa "کارخواه"
pub struct Client:
pub conn: tcp.Conn = tcp.Conn {}
pub ok: bool = false
pub host: str = ""
pub port: int = 21
pub rxbuf: str = ""
pub last_reply: str = ""
pub last_code: int = 0
pub secure: bool = false
pub tls_idx: int = 0 - 1
pub prot_p: bool = false
pub tls_cfg: tls.Config = tls.Config {}
end
func _bytes_new(cap: int): Bytes:
mut b := Bytes {}
mut want := cap
if want < 1024: want = 1024 end
b.p = mem.Allocate(want as u64)
b.cap = want
b.len = 0
ret b
end
func _bytes_grow(b &: Bytes, need: int):
if b.len + need <= b.cap: ret end
mut want := b.cap * 2
until want < b.len + need:
want = want * 2
end
b.p = mem.Reallocate(b.p, want as u64)
b.cap = want
end
func _bytes_append(b &: Bytes, src: void*, n: int):
if n <= 0: ret end
_bytes_grow(b, n)
dst := ((b.p as i64) + (b.len as i64)) as void*
mem.Copy(dst, src, n as u64)
b.len = b.len + n
end
func _bytes_free(b &: Bytes):
if b.p != null: mem.Free(b.p) end
b.p = null
b.len = 0
b.cap = 0
end
func _is_digits(s: str, from: int, n: int): bool:
if s.len() < from + n: ret false end
mut ok := true
repeat n in i:
ch := s.substr(from + i, 1)
if ch < "0" or ch > "9": ok = false end
end
ret ok
end
func _code_of(line: str): int:
if not _is_digits(line, 0, 3): ret 0 end
ret line.substr(0, 3).to_int()
end
func _is_final(line: str): bool:
if line.len() < 4: ret false end
if not _is_digits(line, 0, 3): ret false end
ret line.substr(3, 1) == " "
end
func _fill(c &: Client): bool:
mut chunk := ""
if c.secure:
mut tc := _tls_slots.get(c.tls_idx)
chunk = tls.Read(tc, 4096)
_tls_slots.set(c.tls_idx, tc)
else:
chunk = tcp.Read(c.conn, 4096)
end
if chunk.len() == 0: ret false end
c.rxbuf += chunk
ret true
end
func _read_line(c &: Client): str:
mut idx := c.rxbuf.find("\r\n")
mut spin := 0
until idx < 0 and spin < 400:
if not _fill(c):
spin = 400
else:
idx = c.rxbuf.find("\r\n")
spin += 1
end
end
if idx < 0:
line := c.rxbuf
c.rxbuf = ""
ret line
end
line := c.rxbuf.substr(0, idx)
c.rxbuf = c.rxbuf.substr(idx + 2, c.rxbuf.len() - idx - 2)
ret line
end
func _read_reply(c &: Client): int:
mut full := ""
mut done := false
mut guard := 0
mut opened := 0
until not done and guard < 2000:
line := _read_line(c)
if guard == 0: opened = _code_of(line) end
if full.len() > 0: full += "\r\n" end
full += line
if line.len() == 0:
done = true
else _is_final(line) and _code_of(line) == opened:
done = true
end
guard += 1
end
c.last_reply = full
c.last_code = _code_of(full)
ret c.last_code
end
func _send(c &: Client, line: str): int:
if c.secure:
mut tc := _tls_slots.get(c.tls_idx)
n := tls.Write(tc, line + "\r\n")
_tls_slots.set(c.tls_idx, tc)
ret n
end
ret tcp.Write(c.conn, line + "\r\n")
end
func _cmd(c &: Client, line: str): int:
if line.find("\r") >= 0 or line.find("\n") >= 0:
c.last_reply = "500 refused locally: command contains CR or LF"
c.last_code = 500
ret 500
end
_send(c, line)
ret _read_reply(c)
end
func _good(code: int): bool:
ret code >= 100 and code < 400
end
func _fields(s: str): Vector<str>:
mut out := Vector {} as Vector<str>
mut cur := ""
repeat s.len() in i:
ch := s.substr(i, 1)
if ch == " " or ch == "\t":
if cur.len() > 0:
out.push(cur)
cur = ""
end
else:
cur += ch
end
end
if cur.len() > 0: out.push(cur) end
ret out
end
func _skip_fields(s: str, n: int): int:
mut pos := 0
mut seen := 0
until seen < n and pos < s.len():
until pos < s.len() and (s.substr(pos, 1) == " " or s.substr(pos, 1) == "\t"):
pos += 1
end
if pos >= s.len(): ret pos end
until pos < s.len() and s.substr(pos, 1) != " " and s.substr(pos, 1) != "\t":
pos += 1
end
seen += 1
end
until pos < s.len() and (s.substr(pos, 1) == " " or s.substr(pos, 1) == "\t"):
pos += 1
end
ret pos
end
func _parse_pasv(reply: str): str:
open_at := reply.find("(")
if open_at < 0: ret "" end
rest := reply.substr(open_at + 1, reply.len() - open_at - 1)
close_at := rest.find(")")
if close_at < 0: ret "" end
inner := rest.substr(0, close_at)
parts := str.Split(inner, ",")
defer parts.free()
if parts.len() < 6: ret "" end
mut host := ""
repeat 4 in i:
if i > 0: host += "." end
host += str.Trim(parts.get(i))
end
hi := str.Trim(parts.get(4)).to_int()
lo := str.Trim(parts.get(5)).to_int()
port := hi * 256 + lo
if port <= 0 or port > 65535: ret "" end
ret host + ":" + conv.FormatInt(port as i64)
end
func _parse_epsv(reply: str): int:
open_at := reply.find("(")
if open_at < 0: ret 0 end
rest := reply.substr(open_at + 1, reply.len() - open_at - 1)
close_at := rest.find(")")
if close_at < 0: ret 0 end
inner := rest.substr(0, close_at)
if inner.len() == 0: ret 0 end
delim := inner.substr(0, 1)
parts := str.Split(inner, delim)
defer parts.free()
mut port := 0
each p in parts:
t := str.Trim(p)
if t.len() > 0 and _is_digits(t, 0, t.len()):
port = t.to_int()
end
end
if port <= 0 or port > 65535: ret 0 end
ret port
end
func _parse_list_line(line: str): FileInfo:
mut fi := FileInfo {}
t := str.Trim(line)
if t.len() == 0: ret fi end
f := _fields(t)
defer f.free()
if f.len() < 4: ret fi end
first := f.get(0)
if first.len() >= 8 and first.find("-") == 2:
fi.raw_date = first + " " + f.get(1)
third := f.get(2)
if third == "<DIR>":
fi.is_dir = true
else:
fi.size = third.to_int() as i64
end
at := _skip_fields(t, 3)
if at < t.len(): fi.name = str.Trim(t.substr(at, t.len() - at)) end
ret fi
end
if first.len() < 10 or f.len() < 9: ret fi end
kind := first.substr(0, 1)
fi.is_dir = kind == "d"
fi.is_link = kind == "l"
fi.mode = first.substr(1, first.len() - 1)
fi.size = f.get(4).to_int() as i64
fi.raw_date = f.get(5) + " " + f.get(6) + " " + f.get(7)
at := _skip_fields(t, 8)
mut name := ""
if at < t.len(): name = str.Trim(t.substr(at, t.len() - at)) end
arrow := name.find(" -> ")
if fi.is_link and arrow > 0: name = name.substr(0, arrow) end
fi.name = name
ret fi
end
func _data_open(c &: Client): DataConn:
mut d := DataConn {}
mut raw := tcp.Conn {}
if _good(_cmd(c, "EPSV")) and c.last_code == 229:
port := _parse_epsv(c.last_reply)
if port > 0:
raw = tcp.Dial(c.host, port)
end
end
if not tcp.ConnOk(raw) and _cmd(c, "PASV") == 227:
addr := _parse_pasv(c.last_reply)
if addr.len() > 0:
sep := addr.find(":")
port := addr.substr(sep + 1, addr.len() - sep - 1).to_int()
raw = tcp.Dial(c.host, port)
end
end
if not tcp.ConnOk(raw): ret d end
if c.prot_p:
tc := tcp.UpgradeTLS(raw, c.tls_cfg)
if not tls.ConnOk(tc): ret d end
_tls_slots.push(tc)
d.tls_idx = _tls_slots.len() - 1
d.secure = true
d.ok = true
ret d
end
d.conn = raw
d.ok = true
ret d
end
func _data_read(d &: DataConn, max: int): str:
if d.secure:
mut tc := _tls_slots.get(d.tls_idx)
chunk := tls.Read(tc, max)
_tls_slots.set(d.tls_idx, tc)
ret chunk
end
ret tcp.Read(d.conn, max)
end
func _data_write(d &: DataConn, payload: str): int:
if d.secure:
mut tc := _tls_slots.get(d.tls_idx)
n := tls.Write(tc, payload)
_tls_slots.set(d.tls_idx, tc)
ret n
end
ret tcp.Write(d.conn, payload)
end
func _data_read_bytes(d &: DataConn, buf: void*, max: int): int:
if d.secure:
mut tc := _tls_slots.get(d.tls_idx)
n := tls.ReadBytes(tc, buf, max)
_tls_slots.set(d.tls_idx, tc)
ret n
end
ret tcp.ReadBytes(d.conn, buf, max)
end
func _data_write_bytes(d &: DataConn, ptr: void*, n: int): int:
if d.secure:
mut tc := _tls_slots.get(d.tls_idx)
w := tls.WriteBytes(tc, ptr, n)
_tls_slots.set(d.tls_idx, tc)
ret w
end
ret tcp.WriteBytes(d.conn, ptr, n)
end
func _drain_bytes(d &: DataConn): Bytes:
mut out := _bytes_new(16384)
chunk := mem.Allocate(16384 as u64)
mut more := true
until more:
n := _data_read_bytes(d, chunk, 16384)
if n <= 0:
more = false
else:
_bytes_append(out, chunk, n)
end
end
mem.Free(chunk)
ret out
end
func _data_close(d &: DataConn):
if d.secure:
mut tc := _tls_slots.get(d.tls_idx)
tls.Close(tc)
_tls_slots.set(d.tls_idx, tc)
else:
tcp.Close(d.conn)
end
d.ok = false
end
func _drain(d &: DataConn): str:
mut out := ""
mut more := true
until more:
chunk := _data_read(d, 8192)
if chunk.len() == 0:
more = false
else:
out += chunk
end
end
ret out
end
func _xfer_in(c &: Client, command: str): str:
mut dc := _data_open(c)
if not dc.ok: ret "" end
code := _cmd(c, command)
if not _good(code):
_data_close(dc)
ret ""
end
body := _drain(dc)
_data_close(dc)
_read_reply(c)
ret body
end
func _xfer_out(c &: Client, command: str, payload: str): bool:
mut dc := _data_open(c)
if not dc.ok: ret false end
code := _cmd(c, command)
if not _good(code):
_data_close(dc)
ret false
end
mut sent := 0
if payload.len() > 0: sent = _data_write(dc, payload) end
_data_close(dc)
final := _read_reply(c)
ret _good(final) and (payload.len() == 0 or sent > 0)
end
func _xfer_in_bytes(c &: Client, command: str): Bytes:
mut dc := _data_open(c)
if not dc.ok: ret _bytes_new(0) end
code := _cmd(c, command)
if not _good(code):
_data_close(dc)
ret _bytes_new(0)
end
body := _drain_bytes(dc)
_data_close(dc)
_read_reply(c)
ret body
end
func _xfer_out_bytes(c &: Client, command: str, ptr: void*, n: int): bool:
mut dc := _data_open(c)
if not dc.ok: ret false end
code := _cmd(c, command)
if not _good(code):
_data_close(dc)
ret false
end
mut sent := 0
if n > 0: sent = _data_write_bytes(dc, ptr, n) end
_data_close(dc)
final := _read_reply(c)
ret _good(final) and (n == 0 or sent == n)
end
func _safe_component(name: str): bool:
if name.len() == 0: ret false end
if name == "." or name == "..": ret false end
if name.find("/") >= 0: ret false end
if name.find("\\") >= 0: ret false end
ret true
end
func _remote_join(base: str, name: str): str:
if base.len() == 0: ret name end
if base.substr(base.len() - 1, 1) == "/": ret base + name end
ret base + "/" + name
end
@en "Dial"
@fa "اتصال"
pub func Dial(host: str, port: int): Client:
mut c := Client {}
c.host = host
c.port = port
c.conn = tcp.Dial(host, port)
if not tcp.ConnOk(c.conn): ret c end
c.ok = _read_reply(c) == 220
ret c
end
@en "AuthTLS"
@fa "ارتقا به تی‌ال‌اس"
pub func AuthTLSWith(c &: Client, cfg: tls.Config): bool:
if not c.ok or c.secure: ret false end
if _cmd(c, "AUTH TLS") != 234: ret false end
c.tls_cfg = cfg
tc := tcp.UpgradeTLS(c.conn, cfg)
if not tls.ConnOk(tc): ret false end
_tls_slots.push(tc)
c.tls_idx = _tls_slots.len() - 1
c.secure = true
c.rxbuf = ""
if _cmd(c, "PBSZ 0") == 200:
c.prot_p = _cmd(c, "PROT P") == 200
end
ret true
end
@en "AuthTLS"
@fa "احراز تی‌ال‌اس"
pub func AuthTLS(c &: Client): bool:
ret AuthTLSWith(c, tls.NewConfig(c.host))
end
@en "DialTLS"
@fa "اتصال امن"
pub func DialTLS(host: str, port: int): Client:
mut c := Dial(host, port)
if not c.ok: ret c end
if not AuthTLS(c): c.ok = false end
ret c
end
@en "DialTLSWith"
@fa "اتصال امن با تنظیمات"
pub func DialTLSWith(host: str, port: int, cfg: tls.Config): Client:
mut c := Dial(host, port)
if not c.ok: ret c end
if not AuthTLSWith(c, cfg): c.ok = false end
ret c
end
@en "Secure"
@fa "امن"
pub func Secure(c: Client): bool: ret c.secure end
@en "SecureData"
@fa "داده امن"
pub func SecureData(c: Client): bool: ret c.prot_p end
@en "Login"
@fa "ورود"
pub func Login(c &: Client, user: str, password: str): bool:
if not c.ok: ret false end
code := _cmd(c, "USER " + user)
if code == 230: ret true end
if code != 331: ret false end
ret _cmd(c, "PASS " + password) == 230
end
@en "Quit"
@fa "خروج"
pub func Quit(c &: Client):
if tcp.ConnOk(c.conn):
_bye := _cmd(c, "QUIT")
if c.secure:
mut tc := _tls_slots.get(c.tls_idx)
tls.Close(tc)
_tls_slots.set(c.tls_idx, tc)
c.secure = false
else:
tcp.Close(c.conn)
end
end
c.ok = false
end
@en "Close"
@fa "بستن"
pub func Close(c &: Client):
Quit(c)
end
@en "Ok"
@fa "سالم"
pub func Ok(c: Client): bool: ret c.ok end
@en "LastReply"
@fa "آخرین پاسخ"
pub func LastReply(c: Client): str: ret c.last_reply end
@en "LastCode"
@fa "آخرین کد"
pub func LastCode(c: Client): int: ret c.last_code end
@en "Command"
@fa "فرمان"
pub func Command(c &: Client, line: str): int: ret _cmd(c, line) end
@en "Noop"
@fa "بی‌کار"
pub func Noop(c &: Client): bool: ret _cmd(c, "NOOP") == 200 end
@en "System"
@fa "سامانه"
pub func System(c &: Client): str:
if _cmd(c, "SYST") != 215: ret "" end
ret c.last_reply
end
@en "Features"
@fa "قابلیت‌ها"
pub func Features(c &: Client): str:
if not _good(_cmd(c, "FEAT")): ret "" end
ret c.last_reply
end
@en "Binary"
@fa "دودویی"
pub func Binary(c &: Client): bool: ret _cmd(c, "TYPE I") == 200 end
@en "Ascii"
@fa "متنی"
pub func Ascii(c &: Client): bool: ret _cmd(c, "TYPE A") == 200 end
@en "Pwd"
@fa "مسیر جاری"
pub func Pwd(c &: Client): str:
if _cmd(c, "PWD") != 257: ret "" end
q := c.last_reply.find("\"")
if q < 0: ret "" end
rest := c.last_reply.substr(q + 1, c.last_reply.len() - q - 1)
q2 := rest.find("\"")
if q2 < 0: ret "" end
ret rest.substr(0, q2)
end
@en "Cwd"
@fa "تغییر مسیر"
pub func Cwd(c &: Client, path: str): bool: ret _cmd(c, "CWD " + path) == 250 end
@en "CdUp"
@fa "یک سطح بالا"
pub func CdUp(c &: Client): bool:
code := _cmd(c, "CDUP")
ret code == 250 or code == 200
end
@en "Mkdir"
@fa "ساخت پوشه"
pub func Mkdir(c &: Client, path: str): bool: ret _cmd(c, "MKD " + path) == 257 end
@en "Rmdir"
@fa "حذف پوشه"
pub func Rmdir(c &: Client, path: str): bool: ret _cmd(c, "RMD " + path) == 250 end
@en "MkdirAll"
@fa "ساخت مسیر کامل"
pub func MkdirAll(c &: Client, path: str): bool:
parts := str.Split(path, "/")
defer parts.free()
mut cur := ""
if path.len() > 0 and path.substr(0, 1) == "/": cur = "" end
mut ok := true
each part in parts:
if part.len() > 0:
cur = _remote_join(cur, part)
if path.substr(0, 1) == "/" and cur.substr(0, 1) != "/": cur = "/" + cur end
if not IsDir(c, cur): Mkdir(c, cur) end
end
end
ok = IsDir(c, path)
ret ok
end
@en "ListRaw"
@fa "فهرست خام"
pub func ListRaw(c &: Client, path: str): str:
mut command := "LIST"
if path.len() > 0: command = "LIST " + path end
ret _xfer_in(c, command)
end
@en "List"
@fa "فهرست"
pub func List(c &: Client, path: str): Vector<FileInfo>:
mut out := Vector {} as Vector<FileInfo>
body := ListRaw(c, path)
if body.len() == 0: ret out end
lines := str.Split(body, "\n")
defer lines.free()
each line in lines:
fi := _parse_list_line(line)
if fi.name.len() > 0 and fi.name != "." and fi.name != "..":
out.push(fi)
end
end
ret out
end
@en "NameList"
@fa "فهرست نام‌ها"
pub func NameList(c &: Client, path: str): Vector<str>:
mut out := Vector {} as Vector<str>
mut command := "NLST"
if path.len() > 0: command = "NLST " + path end
body := _xfer_in(c, command)
if body.len() == 0: ret out end
lines := str.Split(body, "\n")
defer lines.free()
each line in lines:
t := str.Trim(line)
if t.len() > 0 and t != "." and t != "..": out.push(t) end
end
ret out
end
@en "Size"
@fa "اندازه"
pub func Size(c &: Client, path: str): i64:
if _cmd(c, "SIZE " + path) != 213: ret 0 - 1 as i64 end
f := _fields(c.last_reply)
defer f.free()
if f.len() < 2: ret 0 - 1 as i64 end
ret f.get(1).to_int()
end
@en "ModTime"
@fa "زمان تغییر"
pub func ModTime(c &: Client, path: str): str:
if _cmd(c, "MDTM " + path) != 213: ret "" end
f := _fields(c.last_reply)
defer f.free()
if f.len() < 2: ret "" end
ret f.get(1)
end
@en "IsDir"
@fa "پوشه است"
pub func IsDir(c &: Client, path: str): bool:
here := Pwd(c)
if not Cwd(c, path): ret false end
if here.len() > 0: Cwd(c, here) end
ret true
end
@en "IsLink"
@fa "پیوند است"
pub func IsLink(c &: Client, path: str): bool:
mut slash := 0 - 1
repeat path.len() in i:
if path.substr(i, 1) == "/": slash = i end
end
mut parent := ""
mut name := path
if slash >= 0:
parent = path.substr(0, slash)
name = path.substr(slash + 1, path.len() - slash - 1)
if parent.len() == 0: parent = "/" end
end
if name.len() == 0: ret false end
entries := List(c, parent)
defer entries.free()
mut found := false
each e in entries:
if e.name == name and e.is_link: found = true end
end
ret found
end
@en "Exists"
@fa "وجود دارد"
pub func Exists(c &: Client, path: str): bool:
if Size(c, path) >= (0 as i64): ret true end
ret IsDir(c, path)
end
@en "Read"
@fa "خواندن"
pub func Read(c &: Client, remote: str): str:
ret _xfer_in(c, "RETR " + remote)
end
@en "Write"
@fa "نوشتن"
pub func Write(c &: Client, remote: str, data: str): bool:
ret _xfer_out(c, "STOR " + remote, data)
end
@en "Append"
@fa "افزودن"
pub func Append(c &: Client, remote: str, data: str): bool:
ret _xfer_out(c, "APPE " + remote, data)
end
@en "Download"
@fa "دریافت"
pub func Download(c &: Client, remote: str, local: str): bool:
mut body := _xfer_in_bytes(c, "RETR " + remote)
if not _good(c.last_code):
_bytes_free(body)
ret false
end
out := fopen(local, "wb")
if out == null:
_bytes_free(body)
ret false
end
mut wrote := 0 as u64
if body.len > 0:
wrote = fwrite(body.p, 1 as u64, body.len as u64, out)
end
fclose(out)
ok := wrote == (body.len as u64)
_bytes_free(body)
ret ok
end
@en "Upload"
@fa "ارسال"
pub func Upload(c &: Client, local: str, remote: str): bool:
src := fopen(local, "rb")
if src == null: ret false end
mut buf := _bytes_new(65536)
chunk := mem.Allocate(65536 as u64)
mut more := true
until more:
n := fread(chunk, 1 as u64, 65536 as u64, src)
if n == (0 as u64):
more = false
else:
_bytes_append(buf, chunk, n as int)
end
end
mem.Free(chunk)
fclose(src)
ok := _xfer_out_bytes(c, "STOR " + remote, buf.p, buf.len)
_bytes_free(buf)
ret ok
end
@en "Delete"
@fa "حذف"
pub func Delete(c &: Client, path: str): bool: ret _cmd(c, "DELE " + path) == 250 end
@en "Rename"
@fa "تغییر نام"
pub func Rename(c &: Client, from_path: str, to_path: str): bool:
if _cmd(c, "RNFR " + from_path) != 350: ret false end
ret _cmd(c, "RNTO " + to_path) == 250
end
@en "Move"
@fa "انتقال"
pub func Move(c &: Client, from_path: str, to_path: str): bool:
ret Rename(c, from_path, to_path)
end
@en "RemoveAll"
@fa "حذف همه"
pub func RemoveAll(c &: Client, path: str): bool:
if IsLink(c, path): ret Delete(c, path) end
if not IsDir(c, path): ret Delete(c, path) end
entries := List(c, path)
defer entries.free()
mut ok := true
each e in entries:
child := _remote_join(path, e.name)
if e.is_dir and not e.is_link:
if not RemoveAll(c, child): ok = false end
else:
if not Delete(c, child): ok = false end
end
end
if not Rmdir(c, path): ok = false end
ret ok
end
@en "DownloadDir"
@fa "دریافت پوشه"
pub func DownloadDir(c &: Client, remote: str, local: str): bool:
dir.MkdirAll(local)
entries := List(c, remote)
defer entries.free()
mut ok := true
each e in entries:
if not _safe_component(e.name):
ok = false
continue
end
rchild := _remote_join(remote, e.name)
lchild := filepath.Join(local, e.name)
if e.is_dir:
if not DownloadDir(c, rchild, lchild): ok = false end
else e.is_link:
ok = ok
else:
if not Download(c, rchild, lchild): ok = false end
end
end
ret ok
end
@en "UploadDir"
@fa "ارسال پوشه"
pub func UploadDir(c &: Client, local: str, remote: str): bool:
MkdirAll(c, remote)
names := dir.List(local)
defer names.free()
mut ok := true
each name in names:
if not _safe_component(name):
ok = false
continue
end
lchild := filepath.Join(local, name)
rchild := _remote_join(remote, name)
if dir.IsDir(lchild):
if not UploadDir(c, lchild, rchild): ok = false end
else:
if not Upload(c, lchild, rchild): ok = false end
end
end
ret ok
end
@en "ReplyCode"
@fa "کد پاسخ"
pub func ReplyCode(line: str): int: ret _code_of(line) end
@en "IsFinalLine"
@fa "خط پایانی است"
pub func IsFinalLine(line: str): bool: ret _is_final(line) end
@en "ParsePasv"
@fa "تحلیل پسیو"
pub func ParsePasv(reply: str): str: ret _parse_pasv(reply) end
@en "ParseEpsv"
@fa "تحلیل پسیو گسترده"
pub func ParseEpsv(reply: str): int: ret _parse_epsv(reply) end
@en "ParseListLine"
@fa "تحلیل خط فهرست"
pub func ParseListLine(line: str): FileInfo: ret _parse_list_line(line) end
@en "gguf"
@fa "جی‌جی‌یو‌اف"
package gguf
import archive
import compress
import encoding.binary
import mem
import str
@en "GGML_F32"
@fa "نوع اعشاری سی‌ودو"
pub const GGML_F32 := 0
@en "GGML_F16"
@fa "نوع اعشاری شانزده"
pub const GGML_F16 := 1
@en "GGML_Q4_0"
@fa "نوع کوانتیزه چهار صفر"
pub const GGML_Q4_0 := 2
@en "GGML_Q4_1"
@fa "نوع کوانتیزه چهار یک"
pub const GGML_Q4_1 := 3
@en "GGML_Q8_0"
@fa "نوع کوانتیزه هشت صفر"
pub const GGML_Q8_0 := 8
@en "META_STRING"
@fa "فراداده رشته"
pub const META_STRING := 8
@en "META_ARRAY"
@fa "فراداده آرایه"
pub const META_ARRAY := 9
@en "MetaValue"
@fa "مقدار فراداده"
pub struct MetaValue:
pub kind: int = 0
pub elem_kind: int = 0
pub i: i64 = 0
pub f: f64 = 0.0
pub s: str = ""
pub ints: Vector<i64> = Vector {}
pub floats: Vector<f64> = Vector {}
pub strs: Vector<str> = Vector {}
@en "free"
@fa "آزادسازی"
pub func free():
this.ints.free()
this.floats.free()
_free_read_str(this.s)
repeat this.strs.len() in i: _free_read_str(this.strs.get(i)) end
this.strs.free()
end
end
@en "TensorInfo"
@fa "اطلاعات تانسور"
pub struct TensorInfo:
pub name: str = ""
pub dims: Vector<int> = Vector {}
pub ggml_type: int = 0
pub offset: i64 = 0
@en "count"
@fa "شمار"
pub func count(): int:
mut n := 1
repeat this.dims.len() in i: n = n * this.dims.get(i) end
ret n
end
@en "free"
@fa "آزادسازی"
pub func free():
_free_read_str(this.name)
this.dims.free()
end
end
@en "Gguf"
@fa "جی‌جی‌یو‌اف"
pub struct Gguf:
pub version: int = 0
pub keys: Vector<str> = Vector {}
pub values: Vector<MetaValue> = Vector {}
pub tensors: Vector<TensorInfo> = Vector {}
pub alignment: int = 32
pub data_offset: int = 0
pub raw: compress.ByteBuf = compress.ByteBuf {}
pub error: str = ""
pub ok: bool = false
@en "meta_index"
@fa "نمایه فراداده"
pub func meta_index(key: str): int:
repeat this.keys.len() in i:
if str.Equals(this.keys.get(i), key): ret i end
end
ret 0 - 1
end
@en "meta_int"
@fa "فراداده صحیح"
pub func meta_int(key: str, dflt: i64): i64:
k := this.meta_index(key)
if k < 0: ret dflt end
ret this.values.get(k).i
end
@en "meta_str"
@fa "فراداده رشته"
pub func meta_str(key: str): str:
k := this.meta_index(key)
if k < 0: ret "" end
ret this.values.get(k).s
end
@en "tensor_index"
@fa "نمایه تانسور"
pub func tensor_index(name: str): int:
repeat this.tensors.len() in i:
t := this.tensors.get(i)
if str.Equals(t.name, name): ret i end
end
ret 0 - 1
end
@en "free"
@fa "آزادسازی"
pub func free():
repeat this.keys.len() in i: _free_read_str(this.keys.get(i)) end
this.keys.free()
repeat this.values.len() in i:
mut v := this.values.get(i)
v.free()
end
this.values.free()
repeat this.tensors.len() in i:
mut t := this.tensors.get(i)
t.free()
end
this.tensors.free()
_free_read_str(this.error)
compress.BufFree(this.raw)
end
end
func _free_read_str(s: str):
if str.Len(s) > 0: mem.Free(s as void*) end
end
func _read_str(rd &: compress.ByteReader, out &: str): bool:
n := binary.ReadU64LE(rd) as int
if rd.bad or n < 0 or compress.RdLeft(rd) < n: ret false end
mut b := compress.RdBytes(rd, n)
out = compress.BufToStrUnsafe(b)
compress.BufFree(b)
ret true
end
func _read_scalar(rd &: compress.ByteReader, kind: int, iv &: i64, fv &: f64): bool:
if kind == 0:
iv = binary.ReadU8(rd) as i64
else kind == 1:
mut x := binary.ReadU8(rd)
if x >= 128: x = x - 256 end
iv = x as i64
else kind == 2:
iv = binary.ReadU16LE(rd) as i64
else kind == 3:
mut x := binary.ReadU16LE(rd)
if x >= 32768: x = x - 65536 end
iv = x as i64
else kind == 4:
mut x := binary.ReadU32LE(rd) as i64
if x < 0: x = x + 4294967296 end
iv = x
else kind == 5:
iv = binary.ReadU32LE(rd) as i64
else kind == 6:
fv = binary.ReadF32(rd, false)
else kind == 7:
iv = binary.ReadU8(rd) as i64
else kind == 10 or kind == 11:
iv = binary.ReadU64LE(rd)
else kind == 12:
fv = binary.ReadF64(rd, false)
else:
ret false
end
ret rd.bad == false
end
func _read_value(rd &: compress.ByteReader, kind: int, v &: MetaValue): bool:
v.kind = kind
if kind == META_STRING: ret _read_str(rd, v.s) end
if kind == META_ARRAY:
ek := binary.ReadU32LE(rd)
cnt := binary.ReadU64LE(rd) as int
if rd.bad or cnt < 0: ret false end
v.elem_kind = ek
repeat cnt:
if ek == META_STRING:
mut s := ""
if _read_str(rd, s) == false: ret false end
v.strs.push(s)
else ek == 6 or ek == 12:
mut f := 0.0
mut iv := 0 as i64
if _read_scalar(rd, ek, iv, f) == false: ret false end
v.floats.push(f)
else:
mut f := 0.0
mut iv := 0 as i64
if _read_scalar(rd, ek, iv, f) == false: ret false end
v.ints.push(iv)
end
end
ret true
end
ret _read_scalar(rd, kind, v.i, v.f)
end
func _parse(g &: Gguf): bool:
mut rd := compress.ReaderFromBuf(g.raw)
if compress.RdLeft(rd) < 24:
g.error = str.Clone("too short")
ret false
end
if binary.ReadU8(rd) != 71 or binary.ReadU8(rd) != 71 or binary.ReadU8(rd) != 85 or binary.ReadU8(rd) != 70:
g.error = str.Clone("not a GGUF file")
ret false
end
g.version = binary.ReadU32LE(rd)
if g.version != 2 and g.version != 3:
g.error = "unsupported version " + g.version
ret false
end
ntensors := binary.ReadU64LE(rd) as int
nkv := binary.ReadU64LE(rd) as int
if rd.bad or ntensors < 0 or nkv < 0:
g.error = str.Clone("bad counts")
ret false
end
repeat nkv:
mut key := ""
if _read_str(rd, key) == false:
g.error = str.Clone("bad metadata key")
ret false
end
kind := binary.ReadU32LE(rd)
mut v := MetaValue {}
if _read_value(rd, kind, v) == false:
g.error = "bad metadata value for " + key
ret false
end
g.keys.push(key)
g.values.push(v)
end
repeat ntensors:
mut t := TensorInfo {}
if _read_str(rd, t.name) == false:
g.error = str.Clone("bad tensor name")
ret false
end
nd := binary.ReadU32LE(rd)
if rd.bad or nd < 0 or nd > 8:
g.error = str.Clone("bad tensor rank")
ret false
end
repeat nd: t.dims.push(binary.ReadU64LE(rd) as int) end
t.ggml_type = binary.ReadU32LE(rd)
t.offset = binary.ReadU64LE(rd)
if rd.bad:
g.error = str.Clone("truncated tensor directory")
ret false
end
g.tensors.push(t)
end
al := g.meta_int("general.alignment", 32)
if al > 0: g.alignment = al as int end
mut off := rd.pos
if off % g.alignment != 0: off = off + (g.alignment - off % g.alignment) end
g.data_offset = off
ret true
end
@en "ParseGguf"
@fa "تجزیه جی‌جی‌یو‌اف"
pub func ParseGguf(buf: compress.ByteBuf, ok &: bool): Gguf:
mut g := Gguf {}
g.raw = buf
ok = _parse(g)
g.ok = ok
ret g
end
@en "LoadGguf"
@fa "بارگذاری جی‌جی‌یو‌اف"
pub func LoadGguf(path: str, ok &: bool): Gguf:
ok = false
mut fok := false
mut raw := archive.ReadBinaryFile(path, fok)
if fok == false:
compress.BufFree(raw)
mut g := Gguf {}
g.error = "cannot read " + path
ret g
end
ret ParseGguf(raw, ok)
end
package gguf
import compress
import encoding.binary
import math
import tensor
func _half(bits: int): f64:
sign := (bits >> 15) & 1
exp := (bits >> 10) & 31
frac := bits & 1023
mut v := 0.0
if exp == 0:
v = (frac as f64) * math.Pow(2.0, 0.0 - 24.0)
else exp == 31:
if frac == 0: v = 1.0e300 * 1.0e300 else:
v = 0.0 / 0.0
end
else:
v = (1.0 + (frac as f64) / 1024.0) * math.Pow(2.0, (exp - 15) as f64)
end
if sign == 1: v = 0.0 - v end
ret v
end
func _bytes_of(t &: TensorInfo): int:
n := t.count()
if t.ggml_type == GGML_F32: ret n * 4 end
if t.ggml_type == GGML_F16: ret n * 2 end
if t.ggml_type == GGML_Q8_0: ret (n / 32) * 34 end
if t.ggml_type == GGML_Q4_0: ret (n / 32) * 18 end
if t.ggml_type == GGML_Q4_1: ret (n / 32) * 20 end
ret 0 - 1
end
@en "TensorBytes"
@fa "بایت‌های تانسور"
pub func TensorBytes(g &: Gguf, index: int): int:
if index < 0 or index >= g.tensors.len(): ret 0 - 1 end
t := g.tensors.get(index)
ret _bytes_of(t)
end
@en "LoadTensorF32"
@fa "بارگذاری تانسور اعشاری"
pub func LoadTensorF32(g &: Gguf, index: int, ok &: bool): tensor.Tensor:
ok = false
if g.ok == false or index < 0 or index >= g.tensors.len(): ret tensor.Empty() end
t := g.tensors.get(index)
nbytes := _bytes_of(t)
if nbytes < 0: ret tensor.Empty() end
n := t.count()
start := g.data_offset + (t.offset as int)
if start < 0 or start + nbytes > compress.BufLen(g.raw): ret tensor.Empty() end
if t.ggml_type != GGML_F32 and t.ggml_type != GGML_F16 and n % 32 != 0: ret tensor.Empty() end
mut shape := Vector {} as Vector<int>
mut i := t.dims.len() - 1
until i >= 0:
shape.push(t.dims.get(i))
i -= 1
end
if shape.len() == 0: shape.push(1) end
out := tensor.Zeros(shape)
shape.free()
p := out.data.data
mut rd := compress.NewByteReader(((g.raw.data as i64) + (start as i64)) as void*, nbytes)
if t.ggml_type == GGML_F32:
repeat n in k: p[k] = binary.ReadF32(rd, false) as f32 end
else t.ggml_type == GGML_F16:
repeat n in k: p[k] = _half(binary.ReadU16LE(rd)) as f32 end
else t.ggml_type == GGML_Q8_0:
repeat n / 32 in b:
d := _half(binary.ReadU16LE(rd))
repeat 32 in j:
mut q := binary.ReadU8(rd)
if q >= 128: q = q - 256 end
p[b * 32 + j] = (d * (q as f64)) as f32
end
end
else t.ggml_type == GGML_Q4_0:
repeat n / 32 in b:
d := _half(binary.ReadU16LE(rd))
repeat 16 in j:
byte := binary.ReadU8(rd)
lo := (byte & 15) - 8
hi := (byte >> 4) - 8
p[b * 32 + j] = (d * (lo as f64)) as f32
p[b * 32 + j + 16] = (d * (hi as f64)) as f32
end
end
else:
repeat n / 32 in b:
d := _half(binary.ReadU16LE(rd))
m := _half(binary.ReadU16LE(rd))
repeat 16 in j:
byte := binary.ReadU8(rd)
lo := byte & 15
hi := byte >> 4
p[b * 32 + j] = (d * (lo as f64) + m) as f32
p[b * 32 + j + 16] = (d * (hi as f64) + m) as f32
end
end
end
ok = true
ret out
end
@en "google"
@fa "گوگل"
package google
import sync
import str
import net.http
import encoding
import encoding.json
import crypto
import tls
import time
const RENEW_MARGIN_SECONDS := 60
const ASSERTION_TTL_SECONDS := 3600
const GRANT_TYPE := "urn:ietf:params:oauth:grant-type:jwt-bearer"
@en "SCOPE_FCM"
@fa "دامنه اف سی ام"
pub const SCOPE_FCM := "https://www.googleapis.com/auth/firebase.messaging"
@en "SCOPE_STORAGE"
@fa "دامنه ذخیره‌سازی"
pub const SCOPE_STORAGE := "https://www.googleapis.com/auth/devstorage.read_write"
@en "SCOPE_CLOUD"
@fa "دامنه ابر"
pub const SCOPE_CLOUD := "https://www.googleapis.com/auth/cloud-platform"
mut _cache_lock := sync.NewMutex()
mut _cache_keys := Vector {} as Vector<str>
mut _cache_tokens := Vector {} as Vector<str>
mut _cache_expiry := Vector {} as Vector<i64>
@en "ServiceAccount"
@fa "حساب سرویس"
pub struct ServiceAccount:
pub client_email: str = ""
pub private_key: str = ""
pub token_uri: str = "https://oauth2.googleapis.com/token"
pub project_id: str = ""
pub ok: bool = false
end
func _b64url(standard: str): str:
mut out := str.Replace(str.Replace(standard, "+", "-"), "/", "_")
until out.len() > 0 and out.substr(out.len() - 1, 1) == "=":
out = out.substr(0, out.len() - 1)
end
ret out
end
func _part(payload: str): str:
ret _b64url(encoding.Base64Encode(payload))
end
func _digest(signing_input: str): str:
ret encoding.Base64Encode(encoding.HexDecode(crypto.Sha256Hex(signing_input)))
end
func _assertion(sa: ServiceAccount, scope: str, now: i64): str:
header := _part(`{"alg":"RS256","typ":"JWT"}`)
claims := _part(
`{"iss":"` + sa.client_email + `","scope":"` + scope + `","aud":"` + sa.token_uri + `","iat":` + _num(now) + `,"exp":` + _num(now + (ASSERTION_TTL_SECONDS as i64)) + `}`
)
signing_input := header + "." + claims
mut ok := false
signature := tls.RsaSignPkcs1Sha256(sa.private_key, _digest(signing_input), ok)
if not ok: ret "" end
ret signing_input + "." + _b64url(signature)
end
func _num(value: i64): str:
mut v := value
if v <= 0 as i64: ret "0" end
mut out := ""
until v > 0 as i64:
out = "0123456789".substr((v % (10 as i64)) as int, 1) + out
v = v / (10 as i64)
end
ret out
end
func _cached(key: str, now: i64): str:
repeat _cache_keys.len() in i:
if _cache_keys.get(i) == key and _cache_expiry.get(i) > now:
ret _cache_tokens.get(i)
end
end
ret ""
end
func _remember(key: str, token: str, expires_at: i64):
repeat _cache_keys.len() in i:
if _cache_keys.get(i) == key:
_cache_tokens.set(i, token)
_cache_expiry.set(i, expires_at)
ret
end
end
_cache_keys.push(key)
_cache_tokens.push(token)
_cache_expiry.push(expires_at)
end
func _exchange(sa: ServiceAccount, scope: str, now: i64, ok &: bool): str:
ok = false
assertion := _assertion(sa, scope, now)
if assertion.len() == 0: ret "" end
mut headers := http.NewHeaders()
defer headers.free()
headers.put("Content-Type", "application/x-www-form-urlencoded")
body := "grant_type=" + encoding.URLEncode(GRANT_TYPE) + "&assertion=" + assertion
response := http.PostWith(sa.token_uri, body, headers)
if not http.Ok(response): ret "" end
token := json.Get(http.Body(response), "access_token")
if token.len() == 0: ret "" end
ok = true
ret token
end
func _mint(sa: ServiceAccount, scope: str, key: str, now: i64, ok &: bool): str:
token := _exchange(sa, scope, now, ok)
if not ok: ret "" end
sync.Lock(_cache_lock)
_remember(key, token, now + (ASSERTION_TTL_SECONDS as i64) - (RENEW_MARGIN_SECONDS as i64))
sync.Unlock(_cache_lock)
ret token
end
@en "ParseServiceAccount"
@fa "تجزیه حساب سرویس"
pub func ParseServiceAccount(document: str): ServiceAccount:
if document.len() == 0: ret ServiceAccount {} end
email := json.Get(document, "client_email")
key := json.Get(document, "private_key")
if email.len() == 0 or key.len() == 0: ret ServiceAccount {} end
mut sa := ServiceAccount {
client_email = email, private_key = key, project_id = json.Get(document, "project_id"), ok = true
}
uri := json.Get(document, "token_uri")
if uri.len() > 0: sa.token_uri = uri end
ret sa
end
@en "AccessToken"
@fa "توکن دسترسی"
pub func AccessToken(sa: ServiceAccount, scope: str, ok &: bool): str:
ok = false
if not sa.ok or scope.len() == 0: ret "" end
now := time.Now()
key := sa.client_email + "|" + scope
sync.Lock(_cache_lock)
hit := _cached(key, now)
sync.Unlock(_cache_lock)
if hit.len() > 0:
ok = true
ret hit
end
ret _mint(sa, scope, key, now, ok)
end
@en "Forget"
@fa "فراموش کردن توکن"
pub func Forget(sa: ServiceAccount):
sync.Lock(_cache_lock)
mut keys := Vector {} as Vector<str>
mut tokens := Vector {} as Vector<str>
mut expiry := Vector {} as Vector<i64>
repeat _cache_keys.len() in i:
if not str.StartsWith(_cache_keys.get(i), sa.client_email + "|"):
keys.push(_cache_keys.get(i))
tokens.push(_cache_tokens.get(i))
expiry.push(_cache_expiry.get(i))
end
end
_cache_keys.free()
_cache_tokens.free()
_cache_expiry.free()
_cache_keys = keys
_cache_tokens = tokens
_cache_expiry = expiry
sync.Unlock(_cache_lock)
end
@en "Authorization"
@fa "سرآیند مجوز"
pub func Authorization(token: str): str:
ret "Bearer " + token
end
package graph
@en "FloydWarshall"
@fa "فلوید وارشال"
pub func FloydWarshall(g &: Graph): Matrix:
mut next := NewIntMatrix(0, 0, 0)
m := FloydWarshallPaths(g, next)
defer next.free()
ret m
end
@en "FloydWarshallPaths"
@fa "فلوید وارشال با مسیر"
pub func FloydWarshallPaths(g &: Graph, next &: IntMatrix): Matrix:
n := g.n
mut d := WeightMatrix(g)
next.rows = n
next.cols = n
FillInt(next.a, n * n, GRAPH_NONE)
_init_next(g, d, next)
repeat n in k:
repeat n in i:
if d.at(i, k) < GRAPH_INF: _fw_row(d, next, i, k, n) end
end
end
ret d
end
@en "FloydPath"
@fa "مسیر فلوید"
pub func FloydPath(next &: IntMatrix, s: int, t: int): Vector<int>:
mut out := Vector {} as Vector<int>
if next.at(s, t) == GRAPH_NONE: ret out end
mut u := s
out.push(u)
until u != t:
u = next.at(u, t)
out.push(u)
end
ret out
end
@en "Johnson"
@fa "جانسون"
pub func Johnson(g &: Graph): Matrix:
n := g.n
mut out := NewMatrix(n, n)
mut pot := Vector {} as Vector<f64>
defer pot.free()
mut parent := Vector {} as Vector<int>
defer parent.free()
FillFloat(pot, n, 0.0)
FillInt(parent, n, GRAPH_NONE)
mut round := 0
until round < n:
if _bf_pass(g, pot, parent) == false: break end
round += 1
end
if round == n: ret _all_inf(out, n) end
_johnson_rows(g, pot, out)
ret out
end
@en "AStar"
@fa "ای‌استار"
pub func AStar(g &: Graph, src: int, target: int, heuristic: Vector<f64>): Vector<int>:
mut dist := Vector {} as Vector<f64>
defer dist.free()
mut parent := Vector {} as Vector<int>
defer parent.free()
FillFloat(dist, g.n, GRAPH_INF)
FillInt(parent, g.n, GRAPH_NONE)
mut h := MinHeap {}
defer h.free()
dist.set(src, 0.0)
h.push(heuristic.get(src), src)
until h.is_empty() == false:
u := h.pop()
if u == target: break end
_relax_astar(g, u, dist, parent, h, heuristic)
end
ret PathFromParents(parent, src, target)
end
@en "KShortestLengths"
@fa "کوتاه‌ترین طول‌ها"
pub func KShortestLengths(g &: Graph, s: int, t: int, k: int): Vector<f64>:
mut out := Vector {} as Vector<f64>
mut count := Vector {} as Vector<int>
defer count.free()
FillInt(count, g.n, 0)
mut h := MinHeap {}
defer h.free()
h.push(0.0, s)
until h.is_empty() == false:
if out.len() >= k: break end
d := h.top_key()
u := h.pop()
if count.get(u) < k:
count.set(u, count.get(u) + 1)
if u == t: out.push(d) end
_push_successors(g, u, d, h)
end
end
ret out
end
@en "AllPairsHops"
@fa "همه فاصله‌های گامی"
pub func AllPairsHops(g &: Graph): IntMatrix:
n := g.n
mut m := NewIntMatrix(n, n, GRAPH_NONE)
mut dist := Vector {} as Vector<int>
defer dist.free()
mut parent := Vector {} as Vector<int>
defer parent.free()
repeat n in s:
BFSFrom(g, s, dist, parent)
repeat n in t: m.set(s, t, dist.get(t)) end
end
ret m
end
package graph
import math
func _brandes_bfs(g &: Graph, s: int, dist &: Vector<int>, sigma &: Vector<f64>, order &: Vector<int>):
FillInt(dist, g.n, GRAPH_NONE)
FillFloat(sigma, g.n, 0.0)
order.clear()
dist.set(s, 0)
sigma.set(s, 1.0)
order.push(s)
mut head := 0
until head < order.len():
u := order.get(head)
head += 1
_brandes_scan(g, u, dist, sigma, order)
end
end
func _brandes_scan(g &: Graph, u: int, dist &: Vector<int>, sigma &: Vector<f64>, order &: Vector<int>):
mut k := g.adj_start(u)
stop := g.adj_stop(u)
until k < stop:
v := g.adj_node(k)
if dist.get(v) == GRAPH_NONE:
dist.set(v, dist.get(u) + 1)
order.push(v)
end
if dist.get(v) == dist.get(u) + 1: sigma.set(v, sigma.get(v) + sigma.get(u)) end
k += 1
end
end
func _brandes_back(g &: Graph, s: int, dist: Vector<int>, sigma: Vector<f64>, order: Vector<int>, delta &: Vector<f64>, score &: Vector<f64>, edge_score &: Vector<f64>):
FillFloat(delta, g.n, 0.0)
mut i := order.len() - 1
until i >= 0:
w := order.get(i)
_brandes_push(g, w, dist, sigma, delta, edge_score)
if w != s: score.set(w, score.get(w) + delta.get(w)) end
i = i - 1
end
end
func _brandes_push(g &: Graph, w: int, dist: Vector<int>, sigma: Vector<f64>, delta &: Vector<f64>, edge_score &: Vector<f64>):
mut k := g.in_start(w)
stop := g.in_stop(w)
until k < stop:
v := g.in_node(k)
if dist.get(v) == dist.get(w) - 1:
share := sigma.get(v) / sigma.get(w) * (1.0 + delta.get(w))
delta.set(v, delta.get(v) + share)
if edge_score.len() > 0:
e := g.in_edge(k)
edge_score.set(e, edge_score.get(e) + share)
end
end
k += 1
end
end
func _normalize(v &: Vector<f64>):
mut norm := 0.0
repeat v.len() in i: norm += v.get(i) * v.get(i) end
norm = math.Sqrt(norm)
if norm <= 0.0: ret end
repeat v.len() in i: v.set(i, v.get(i) / norm) end
end
func _scale_to_sum(v &: Vector<f64>):
mut s := 0.0
repeat v.len() in i: s += v.get(i) end
if s <= 0.0: ret end
repeat v.len() in i: v.set(i, v.get(i) / s) end
end
func _delta_of(a: Vector<f64>, b: Vector<f64>): f64:
mut d := 0.0
repeat a.len() in i: d += math.Abs(a.get(i) - b.get(i)) end
ret d
end
func _spread_out(g &: Graph, src: Vector<f64>, dst &: Vector<f64>):
FillFloat(dst, g.n, 0.0)
repeat g.n in u:
mut k := g.adj_start(u)
stop := g.adj_stop(u)
until k < stop:
v := g.adj_node(k)
dst.set(v, dst.get(v) + src.get(u))
k += 1
end
end
end
func _spread_in(g &: Graph, src: Vector<f64>, dst &: Vector<f64>):
FillFloat(dst, g.n, 0.0)
repeat g.n in u:
mut k := g.in_start(u)
stop := g.in_stop(u)
until k < stop:
v := g.in_node(k)
dst.set(v, dst.get(v) + src.get(u))
k += 1
end
end
end
func _pagerank_step(g &: Graph, cur: Vector<f64>, nxt &: Vector<f64>, damping: f64):
n := g.n
mut sink := 0.0
FillFloat(nxt, n, 0.0)
repeat n in u:
d := g.out_degree(u)
if d == 0: sink += cur.get(u)
else:
_pagerank_spread(g, u, cur.get(u) / (d as f64), nxt)
end
end
base := (1.0 - damping) / (n as f64) + damping * sink / (n as f64)
repeat n in u: nxt.set(u, base + damping * nxt.get(u)) end
end
func _pagerank_spread(g &: Graph, u: int, share: f64, nxt &: Vector<f64>):
mut k := g.adj_start(u)
stop := g.adj_stop(u)
until k < stop:
v := g.adj_node(k)
nxt.set(v, nxt.get(v) + share)
k += 1
end
end
func _closeness_of(dist: Vector<int>, n: int): f64:
mut total := 0.0
mut reached := 0
repeat n in v:
d := dist.get(v)
if d > 0:
total += d as f64
reached += 1
end
end
if reached == 0: ret 0.0 end
if n < 2: ret 0.0 end
ret ((reached as f64) / total) * ((reached as f64) / ((n - 1) as f64))
end
func _brandes_all(g &: Graph, score &: Vector<f64>, edge_score &: Vector<f64>):
mut dist := Vector {} as Vector<int>
defer dist.free()
mut sigma := Vector {} as Vector<f64>
defer sigma.free()
mut order := Vector {} as Vector<int>
defer order.free()
mut delta := Vector {} as Vector<f64>
defer delta.free()
repeat g.n in s:
_brandes_bfs(g, s, dist, sigma, order)
_brandes_back(g, s, dist, sigma, order, delta, score, edge_score)
end
end
@en "DegreeCentrality"
@fa "مرکزیت درجه"
pub func DegreeCentrality(g &: Graph): Vector<f64>:
mut out := Vector {} as Vector<f64>
if g.n < 2: ret out end
d := (g.n - 1) as f64
repeat g.n in u: out.push((g.degree(u) as f64) / d) end
ret out
end
@en "InDegreeCentrality"
@fa "مرکزیت درجه ورودی"
pub func InDegreeCentrality(g &: Graph): Vector<f64>:
mut out := Vector {} as Vector<f64>
if g.n < 2: ret out end
d := (g.n - 1) as f64
repeat g.n in u: out.push((g.in_degree(u) as f64) / d) end
ret out
end
@en "OutDegreeCentrality"
@fa "مرکزیت درجه خروجی"
pub func OutDegreeCentrality(g &: Graph): Vector<f64>:
mut out := Vector {} as Vector<f64>
if g.n < 2: ret out end
d := (g.n - 1) as f64
repeat g.n in u: out.push((g.out_degree(u) as f64) / d) end
ret out
end
@en "ClosenessCentrality"
@fa "مرکزیت نزدیکی"
pub func ClosenessCentrality(g &: Graph): Vector<f64>:
mut out := Vector {} as Vector<f64>
mut dist := Vector {} as Vector<int>
defer dist.free()
mut parent := Vector {} as Vector<int>
defer parent.free()
repeat g.n in u:
BFSFrom(g, u, dist, parent)
out.push(_closeness_of(dist, g.n))
end
ret out
end
@en "HarmonicCentrality"
@fa "مرکزیت هارمونیک"
pub func HarmonicCentrality(g &: Graph): Vector<f64>:
mut out := Vector {} as Vector<f64>
mut dist := Vector {} as Vector<int>
defer dist.free()
mut parent := Vector {} as Vector<int>
defer parent.free()
repeat g.n in u:
BFSFrom(g, u, dist, parent)
mut s := 0.0
repeat g.n in v:
if v != u:
d := dist.get(v)
if d > 0: s += 1.0 / (d as f64) end
end
end
if g.n > 1: s = s / ((g.n - 1) as f64) end
out.push(s)
end
ret out
end
@en "BetweennessCentrality"
@fa "مرکزیت بینابینی"
pub func BetweennessCentrality(g &: Graph): Vector<f64>:
mut score := Vector {} as Vector<f64>
mut edge_score := Vector {} as Vector<f64>
defer edge_score.free()
FillFloat(score, g.n, 0.0)
_brandes_all(g, score, edge_score)
if g.directed == false:
repeat g.n in u: score.set(u, score.get(u) / 2.0) end
end
ret score
end
@en "EdgeBetweenness"
@fa "بینابینی یال"
pub func EdgeBetweenness(g &: Graph): Vector<f64>:
mut score := Vector {} as Vector<f64>
defer score.free()
mut edge_score := Vector {} as Vector<f64>
FillFloat(score, g.n, 0.0)
FillFloat(edge_score, g.size(), 0.0)
_brandes_all(g, score, edge_score)
if g.directed == false:
repeat g.size() in e: edge_score.set(e, edge_score.get(e) / 2.0) end
end
ret edge_score
end
@en "EigenvectorCentrality"
@fa "مرکزیت بردار ویژه"
pub func EigenvectorCentrality(g &: Graph, iters: int, tol: f64): Vector<f64>:
mut cur := Vector {} as Vector<f64>
mut nxt := Vector {} as Vector<f64>
defer nxt.free()
FillFloat(cur, g.n, 1.0)
_normalize(cur)
mut step := 0
until step < iters:
_spread_out(g, cur, nxt)
_normalize(nxt)
d := _delta_of(cur, nxt)
repeat g.n in u: cur.set(u, nxt.get(u)) end
if d < tol: break end
step += 1
end
ret cur
end
@en "KatzCentrality"
@fa "مرکزیت کاتز"
pub func KatzCentrality(g &: Graph, alpha: f64, beta: f64, iters: int, tol: f64): Vector<f64>:
mut cur := Vector {} as Vector<f64>
mut nxt := Vector {} as Vector<f64>
defer nxt.free()
FillFloat(cur, g.n, beta)
mut step := 0
until step < iters:
_spread_out(g, cur, nxt)
repeat g.n in u: nxt.set(u, beta + alpha * nxt.get(u)) end
d := _delta_of(cur, nxt)
repeat g.n in u: cur.set(u, nxt.get(u)) end
if d < tol: break end
step += 1
end
ret cur
end
@en "PageRank"
@fa "رتبه‌بندی صفحه"
pub func PageRank(g &: Graph, damping: f64, iters: int, tol: f64): Vector<f64>:
mut cur := Vector {} as Vector<f64>
mut nxt := Vector {} as Vector<f64>
defer nxt.free()
if g.n == 0: ret cur end
FillFloat(cur, g.n, 1.0 / (g.n as f64))
mut step := 0
until step < iters:
_pagerank_step(g, cur, nxt, damping)
d := _delta_of(cur, nxt)
repeat g.n in u: cur.set(u, nxt.get(u)) end
if d < tol: break end
step += 1
end
ret cur
end
@en "HITS"
@fa "هیتس"
pub func HITS(g &: Graph, iters: int, tol: f64, hubs &: Vector<f64>, auth &: Vector<f64>):
FillFloat(hubs, g.n, 1.0)
FillFloat(auth, g.n, 1.0)
mut tmp := Vector {} as Vector<f64>
defer tmp.free()
mut step := 0
until step < iters:
_spread_out(g, hubs, tmp)
_normalize(tmp)
d := _delta_of(auth, tmp)
repeat g.n in u: auth.set(u, tmp.get(u)) end
_spread_in(g, auth, tmp)
_normalize(tmp)
repeat g.n in u: hubs.set(u, tmp.get(u)) end
if d < tol: break end
step += 1
end
end
@en "TopNode"
@fa "برترین گره"
pub func TopNode(score: Vector<f64>): int:
mut best := GRAPH_NONE
repeat score.len() in u:
if best == GRAPH_NONE: best = u
else score.get(u) > score.get(best): best = u
end
end
ret best
end
@en "ScaleToSum"
@fa "مقیاس به مجموع"
pub func ScaleToSum(v &: Vector<f64>): _scale_to_sum(v) end
package graph
import math
func _has_loop(g &: Graph): bool:
repeat g.size() in e:
if g.edge_from(e) == g.edge_to(e): ret true end
end
ret false
end
func _contract(g &: Graph, drop: int, u: int, v: int): Graph:
mut map := Vector {} as Vector<int>
defer map.free()
mut next := 0
repeat g.n in x:
if x == v: map.push(GRAPH_NONE)
else:
map.push(next)
next += 1
end
end
map.set(v, map.get(u))
mut h := New(next, false)
repeat g.size() in e:
if e != drop:
h.add_edge(map.get(g.edge_from(e)), map.get(g.edge_to(e)))
end
end
ret h
end
func _delete_edge(g &: Graph, drop: int): Graph:
mut h := New(g.n, false)
repeat g.size() in e:
if e != drop: h.add_edge(g.edge_from(e), g.edge_to(e)) end
end
ret h
end
func _count_colorings(g &: Graph, k: int): f64:
if _has_loop(g): ret 0.0 end
if g.size() == 0: ret math.Pow(k as f64, g.n as f64) end
e := 0
u := g.edge_from(e)
v := g.edge_to(e)
mut del := _delete_edge(g, e)
mut con := _contract(g, e, u, v)
a := _count_colorings(del, k)
b := _count_colorings(con, k)
defer del.free()
defer con.free()
ret a - b
end
@en "CountColorings"
@fa "شمار رنگ‌آمیزی‌ها"
pub func CountColorings(g &: Graph, k: int): f64:
mut s := Simplify(g)
repeat g.size() in e:
if g.edge_from(e) == g.edge_to(e):
s.free()
ret 0.0
end
end
v := _count_colorings(s, k)
defer s.free()
ret v
end
package graph
import math
func _bk_pivot(adj &: HashMap<i64, bool>, n: int, p: Vector<int>, x: Vector<int>): int:
mut best := GRAPH_NONE
mut bestc := GRAPH_NONE
repeat p.len() in i: _bk_offer(adj, n, p, p.get(i), best, bestc) end
repeat x.len() in i: _bk_offer(adj, n, p, x.get(i), best, bestc) end
ret best
end
func _bk_offer(adj &: HashMap<i64, bool>, n: int, p: Vector<int>, u: int, best &: int, bestc &: int):
mut c := 0
repeat p.len() in i:
if adj.has(_color_key(n, u, p.get(i))): c += 1 end
end
if c > bestc:
bestc = c
best = u
end
end
func _bk_filter(adj &: HashMap<i64, bool>, n: int, src: Vector<int>, v: int, out &: Vector<int>):
out.clear()
repeat src.len() in i:
u := src.get(i)
if adj.has(_color_key(n, v, u)): out.push(u) end
end
end
func _bk_run(adj &: HashMap<i64, bool>, n: int, r &: Vector<int>, p: Vector<int>, x: Vector<int>, best &: Vector<int>):
if p.len() == 0:
if x.len() == 0: _bk_record(r, best) end
ret
end
pivot := _bk_pivot(adj, n, p, x)
mut cand := Vector {} as Vector<int>
defer cand.free()
repeat p.len() in i:
v := p.get(i)
if adj.has(_color_key(n, pivot, v)) == false: cand.push(v) end
end
mut px := Vector {} as Vector<int>
defer px.free()
mut xx := Vector {} as Vector<int>
defer xx.free()
_bk_branch(adj, n, r, p, x, best, cand, px, xx)
end
func _bk_branch(adj &: HashMap<i64, bool>, n: int, r &: Vector<int>, p: Vector<int>, x: Vector<int>, best &: Vector<int>, cand: Vector<int>, px &: Vector<int>, xx &: Vector<int>):
mut live := Vector {} as Vector<int>
defer live.free()
mut done := Vector {} as Vector<int>
defer done.free()
repeat p.len() in i: live.push(p.get(i)) end
repeat x.len() in i: done.push(x.get(i)) end
repeat cand.len() in i:
v := cand.get(i)
_bk_filter(adj, n, live, v, px)
_bk_filter(adj, n, done, v, xx)
r.push(v)
_bk_run(adj, n, r, px, xx, best)
r.pop()
_bk_drop(live, v)
done.push(v)
end
end
func _bk_drop(v &: Vector<int>, x: int):
mut keep := Vector {} as Vector<int>
repeat v.len() in i:
if v.get(i) != x: keep.push(v.get(i)) end
end
v.clear()
repeat keep.len() in i: v.push(keep.get(i)) end
defer keep.free()
end
func _bk_record(r: Vector<int>, best &: Vector<int>):
if r.len() <= best.len(): ret end
best.clear()
repeat r.len() in i: best.push(r.get(i)) end
end
@en "MaxClique"
@fa "بیشینه خوشه"
pub func MaxClique(g &: Graph): Vector<int>:
mut adj := _color_adj(g)
defer adj.free()
mut r := Vector {} as Vector<int>
defer r.free()
mut p := Vector {} as Vector<int>
defer p.free()
mut x := Vector {} as Vector<int>
defer x.free()
mut best := Vector {} as Vector<int>
Iota(p, g.n)
_bk_run(adj, g.n, r, p, x, best)
ret best
end
@en "CliqueNumber"
@fa "عدد خوشه"
pub func CliqueNumber(g &: Graph): int:
mut c := MaxClique(g)
defer c.free()
ret c.len()
end
@en "MaximumIndependentSet"
@fa "بیشینه مجموعه مستقل"
pub func MaximumIndependentSet(g &: Graph): Vector<int>:
mut c := Complement(g)
best := MaxClique(c)
defer c.free()
ret best
end
@en "IndependenceNumber"
@fa "عدد استقلال"
pub func IndependenceNumber(g &: Graph): int:
mut s := MaximumIndependentSet(g)
defer s.free()
ret s.len()
end
@en "VertexCoverNumber"
@fa "عدد پوشش رأسی"
pub func VertexCoverNumber(g &: Graph): int:
ret g.n - IndependenceNumber(g)
end
@en "GreedyVertexCover"
@fa "پوشش رأسی حریصانه"
pub func GreedyVertexCover(g &: Graph, cover &: Vector<bool>): int:
FillBool(cover, g.n, false)
mut count := 0
repeat g.size() in e:
u := g.edge_from(e)
v := g.edge_to(e)
if u != v:
if cover.get(u) == false:
if cover.get(v) == false:
cover.set(u, true)
cover.set(v, true)
count += 2
end
end
end
end
ret count
end
package graph
import math
@en "LocalClustering"
@fa "خوشگی محلی"
pub func LocalClustering(g &: Graph, u: int): f64:
mut adj := _adjacency_set(g)
defer adj.free()
mut nb := Vector {} as Vector<int>
defer nb.free()
_distinct_neighbors(g, u, nb)
k := nb.len()
if k < 2: ret 0.0 end
links := _links_among(adj, nb, g.n)
ret 2.0 * (links as f64) / ((k as f64) * ((k as f64) - 1.0))
end
@en "AverageClustering"
@fa "میانگین خوشگی"
pub func AverageClustering(g &: Graph): f64:
if g.n == 0: ret 0.0 end
mut adj := _adjacency_set(g)
defer adj.free()
mut nb := Vector {} as Vector<int>
defer nb.free()
mut total := 0.0
repeat g.n in u:
_distinct_neighbors(g, u, nb)
k := nb.len()
if k > 1:
links := _links_among(adj, nb, g.n)
total += 2.0 * (links as f64) / ((k as f64) * ((k as f64) - 1.0))
end
end
ret total / (g.n as f64)
end
@en "Transitivity"
@fa "تعدی"
pub func Transitivity(g &: Graph): f64:
mut adj := _adjacency_set(g)
defer adj.free()
mut nb := Vector {} as Vector<int>
defer nb.free()
mut closed := 0
mut triples := 0
repeat g.n in u:
_distinct_neighbors(g, u, nb)
k := nb.len()
triples += k * (k - 1) / 2
closed += _links_among(adj, nb, g.n)
end
if triples == 0: ret 0.0 end
ret (closed as f64) / (triples as f64)
end
@en "TriangleCount"
@fa "شمار مثلث"
pub func TriangleCount(g &: Graph): int:
mut adj := _adjacency_set(g)
defer adj.free()
mut nb := Vector {} as Vector<int>
defer nb.free()
mut total := 0
repeat g.n in u:
_distinct_neighbors(g, u, nb)
total += _links_among(adj, nb, g.n)
end
ret total / 3
end
@en "Assortativity"
@fa "همگون‌گرایی"
pub func Assortativity(g &: Graph): f64:
m := g.size()
if m == 0: ret 0.0 end
mut s1 := 0.0
mut s2 := 0.0
mut s3 := 0.0
repeat m in e:
a := (g.degree(g.edge_from(e)) as f64) - 1.0
b := (g.degree(g.edge_to(e)) as f64) - 1.0
s1 += a * b
s2 += a + b
s3 += a * a + b * b
end
mf := m as f64
num := s1 / mf - (s2 / (2.0 * mf)) * (s2 / (2.0 * mf))
den := s3 / (2.0 * mf) - (s2 / (2.0 * mf)) * (s2 / (2.0 * mf))
if math.Abs(den) < 0.000000000001: ret 0.0 end
ret num / den
end
@en "CircuitRank"
@fa "رتبه مدار"
pub func CircuitRank(g &: Graph): int:
ret g.size() - g.n + ComponentCount(g)
end
@en "WeightedDiameter"
@fa "قطر وزنی"
pub func WeightedDiameter(g &: Graph): f64:
mut best := 0.0
mut dist := Vector {} as Vector<f64>
defer dist.free()
mut parent := Vector {} as Vector<int>
defer parent.free()
repeat g.n in s:
Dijkstra(g, s, dist, parent)
repeat g.n in t:
d := dist.get(t)
if d < GRAPH_INF:
if d > best: best = d end
end
end
end
ret best
end
package graph
func _color_key(n: int, u: int, v: int): i64: ret (u as i64) * (n as i64) + (v as i64) end
func _color_adj(g &: Graph): HashMap<i64, bool>:
mut s := HashMap {} as HashMap<i64, bool>
repeat g.size() in e:
u := g.edge_from(e)
v := g.edge_to(e)
if u != v:
s.put(_color_key(g.n, u, v), true)
s.put(_color_key(g.n, v, u), true)
end
end
ret s
end
func _lowest_free(g &: Graph, u: int, color: Vector<int>, used &: Vector<bool>): int:
FillBool(used, g.n + 1, false)
mut k := g.adj_start(u)
stop := g.adj_stop(u)
until k < stop:
v := g.adj_node(k)
c := color.get(v)
if c != GRAPH_NONE: used.set(c, true) end
k += 1
end
mut c := 0
until used.get(c): c += 1 end
ret c
end
func _saturation(g &: Graph, u: int, color: Vector<int>, seen &: Vector<bool>): int:
FillBool(seen, g.n + 1, false)
mut count := 0
mut k := g.adj_start(u)
stop := g.adj_stop(u)
until k < stop:
c := color.get(g.adj_node(k))
if c != GRAPH_NONE:
if seen.get(c) == false:
seen.set(c, true)
count += 1
end
end
k += 1
end
ret count
end
func _dsatur_pick(g &: Graph, color: Vector<int>, seen &: Vector<bool>): int:
mut best := GRAPH_NONE
mut bestsat := GRAPH_NONE
repeat g.n in u:
if color.get(u) == GRAPH_NONE:
sat := _saturation(g, u, color, seen)
if _dsatur_better(g, u, best, sat, bestsat):
best = u
bestsat = sat
end
end
end
ret best
end
func _dsatur_better(g &: Graph, u: int, best: int, sat: int, bestsat: int): bool:
if best == GRAPH_NONE: ret true end
if sat > bestsat: ret true end
if sat < bestsat: ret false end
ret g.degree(u) > g.degree(best)
end
func _can_use(g &: Graph, u: int, c: int, color: Vector<int>): bool:
mut k := g.adj_start(u)
stop := g.adj_stop(u)
until k < stop:
v := g.adj_node(k)
if v != u:
if color.get(v) == c: ret false end
end
k += 1
end
ret true
end
func _color_search(g &: Graph, k: int, u: int, color &: Vector<int>, high: int): bool:
if u >= g.n: ret true end
mut top := high + 1
if top > k - 1: top = k - 1 end
mut c := 0
until c <= top:
if _can_use(g, u, c, color):
color.set(u, c)
mut nh := high
if c > nh: nh = c end
if _color_search(g, k, u + 1, color, nh): ret true end
color.set(u, GRAPH_NONE)
end
c += 1
end
ret false
end
func _mark_incident(g &: Graph, u: int, ecolor: Vector<int>, used &: Vector<bool>):
mut k := g.adj_start(u)
stop := g.adj_stop(u)
until k < stop:
c := ecolor.get(g.adj_edge(k))
if c != GRAPH_NONE: used.set(c, true) end
k += 1
end
end
@en "GreedyColoring"
@fa "رنگ‌آمیزی حریصانه"
pub func GreedyColoring(g &: Graph, order: Vector<int>): Vector<int>:
mut color := Vector {} as Vector<int>
mut used := Vector {} as Vector<bool>
defer used.free()
FillInt(color, g.n, GRAPH_NONE)
repeat order.len() in i:
u := order.get(i)
color.set(u, _lowest_free(g, u, color, used))
end
ret color
end
@en "GreedyColoringNatural"
@fa "رنگ‌آمیزی حریصانه طبیعی"
pub func GreedyColoringNatural(g &: Graph): Vector<int>:
mut order := Vector {} as Vector<int>
defer order.free()
Iota(order, g.n)
ret GreedyColoring(g, order)
end
@en "WelshPowell"
@fa "ولش پاول"
pub func WelshPowell(g &: Graph): Vector<int>:
mut h := MinHeap {}
defer h.free()
repeat g.n in u: h.push(0.0 - (g.degree(u) as f64), u) end
mut order := Vector {} as Vector<int>
defer order.free()
until h.is_empty() == false: order.push(h.pop()) end
ret GreedyColoring(g, order)
end
@en "DSatur"
@fa "دی‌سچور"
pub func DSatur(g &: Graph): Vector<int>:
mut color := Vector {} as Vector<int>
mut used := Vector {} as Vector<bool>
defer used.free()
mut seen := Vector {} as Vector<bool>
defer seen.free()
FillInt(color, g.n, GRAPH_NONE)
repeat g.n:
u := _dsatur_pick(g, color, seen)
if u == GRAPH_NONE: break end
color.set(u, _lowest_free(g, u, color, used))
end
ret color
end
@en "ColorCount"
@fa "شمار رنگ"
pub func ColorCount(color: Vector<int>): int:
mut best := GRAPH_NONE
repeat color.len() in u:
if color.get(u) > best: best = color.get(u) end
end
ret best + 1
end
@en "IsProperColoring"
@fa "رنگ‌آمیزی معتبر است"
pub func IsProperColoring(g &: Graph, color: Vector<int>): bool:
repeat g.size() in e:
u := g.edge_from(e)
v := g.edge_to(e)
if u != v:
if color.get(u) == color.get(v): ret false end
end
end
ret true
end
@en "ChromaticNumber"
@fa "عدد رنگی"
pub func ChromaticNumber(g &: Graph): int:
if g.n == 0: ret 0 end
repeat g.size() in e:
if g.edge_from(e) == g.edge_to(e): ret GRAPH_NONE end
end
mut color := Vector {} as Vector<int>
defer color.free()
mut upper := DSatur(g)
limit := ColorCount(upper)
defer upper.free()
mut k := 1
until k <= limit:
FillInt(color, g.n, GRAPH_NONE)
if _color_search(g, k, 0, color, GRAPH_NONE): ret k end
k += 1
end
ret limit
end
@en "EdgeColoringGreedy"
@fa "رنگ‌آمیزی یالی حریصانه"
pub func EdgeColoringGreedy(g &: Graph): Vector<int>:
mut ecolor := Vector {} as Vector<int>
mut used := Vector {} as Vector<bool>
defer used.free()
FillInt(ecolor, g.size(), GRAPH_NONE)
repeat g.size() in e:
FillBool(used, 2 * g.n + 2, false)
_mark_incident(g, g.edge_from(e), ecolor, used)
_mark_incident(g, g.edge_to(e), ecolor, used)
mut c := 0
until used.get(c): c += 1 end
ecolor.set(e, c)
end
ret ecolor
end
package graph
func _degrees_now(g &: Graph, alive: Vector<bool>, deg &: Vector<int>):
FillInt(deg, g.n, 0)
repeat g.size() in e:
u := g.edge_from(e)
v := g.edge_to(e)
if u != v:
if alive.get(u):
if alive.get(v):
deg.set(u, deg.get(u) + 1)
deg.set(v, deg.get(v) + 1)
end
end
end
end
end
func _densify(labels &: Vector<int>): int:
mut map := HashMap {} as HashMap<i64, int>
defer map.free()
mut next := 0
repeat labels.len() in u:
k := labels.get(u) as i64
if map.has(k) == false:
map.put(k, next)
next += 1
end
labels.set(u, map.get(k))
end
ret next
end
func _weighted_degrees(g &: Graph, deg &: Vector<f64>): f64:
FillFloat(deg, g.n, 0.0)
mut total := 0.0
repeat g.size() in e:
u := g.edge_from(e)
v := g.edge_to(e)
w := g.edge_weight(e)
deg.set(u, deg.get(u) + w)
deg.set(v, deg.get(v) + w)
total += w
end
ret total
end
func _best_move(g &: Graph, u: int, comm &: Vector<int>, ktot &: Vector<f64>, deg: Vector<f64>, m2: f64): int:
mut links := HashMap {} as HashMap<i64, f64>
defer links.free()
_neighbor_weights(g, u, comm, links)
mut best := comm.get(u)
mut bestgain := 0.0
repeat g.n in c:
if links.has(c as i64):
gain := links.get(c as i64) - ktot.get(c) * deg.get(u) / m2
if gain > bestgain:
bestgain = gain
best = c
end
end
end
ret best
end
func _neighbor_weights(g &: Graph, u: int, comm &: Vector<int>, links &: HashMap<i64, f64>):
mut k := g.adj_start(u)
stop := g.adj_stop(u)
until k < stop:
v := g.adj_node(k)
if v != u:
c := comm.get(v) as i64
mut cur := 0.0
if links.has(c): cur = links.get(c) end
links.put(c, cur + g.adj_weight(k))
end
k += 1
end
end
func _louvain_phase(g &: Graph, comm &: Vector<int>): bool:
mut deg := Vector {} as Vector<f64>
defer deg.free()
mut ktot := Vector {} as Vector<f64>
defer ktot.free()
total := _weighted_degrees(g, deg)
m2 := 2.0 * total
if m2 <= 0.0: ret false end
FillFloat(ktot, g.n, 0.0)
repeat g.n in u: ktot.set(comm.get(u), ktot.get(comm.get(u)) + deg.get(u)) end
mut moved := false
mut round := 0
until round < 20:
if _louvain_sweep(g, comm, ktot, deg, m2) == false: break end
moved = true
round += 1
end
ret moved
end
func _louvain_sweep(g &: Graph, comm &: Vector<int>, ktot &: Vector<f64>, deg: Vector<f64>, m2: f64): bool:
mut changed := false
repeat g.n in u:
old := comm.get(u)
ktot.set(old, ktot.get(old) - deg.get(u))
best := _best_move(g, u, comm, ktot, deg, m2)
comm.set(u, best)
ktot.set(best, ktot.get(best) + deg.get(u))
if best != old: changed = true end
end
ret changed
end
func _aggregate(g &: Graph, comm: Vector<int>, k: int): Graph:
mut h := New(k, false)
mut acc := HashMap {} as HashMap<i64, f64>
defer acc.free()
mut order := Vector {} as Vector<i64>
defer order.free()
repeat g.size() in e:
a := comm.get(g.edge_from(e))
b := comm.get(g.edge_to(e))
mut lo := a
mut hi := b
if lo > hi:
lo = b
hi = a
end
key := (lo as i64) * (k as i64) + (hi as i64)
if acc.has(key) == false: order.push(key) end
mut cur := 0.0
if acc.has(key): cur = acc.get(key) end
acc.put(key, cur + g.edge_weight(e))
end
_emit_aggregate(h, acc, order, k)
ret h
end
func _emit_aggregate(h &: Graph, acc &: HashMap<i64, f64>, order: Vector<i64>, k: int):
repeat order.len() in i:
key := order.get(i)
a := (key / (k as i64)) as int
b := (key % (k as i64)) as int
h.add_weighted(a, b, acc.get(key))
end
end
func _label_round(g &: Graph, comm &: Vector<int>): bool:
mut changed := false
repeat g.n in u:
best := _majority_label(g, u, comm)
if best != GRAPH_NONE:
if best != comm.get(u):
comm.set(u, best)
changed = true
end
end
end
ret changed
end
func _majority_label(g &: Graph, u: int, comm &: Vector<int>): int:
mut tally := HashMap {} as HashMap<i64, f64>
defer tally.free()
_neighbor_weights(g, u, comm, tally)
mut best := GRAPH_NONE
mut bestw := 0.0
repeat g.n in c:
if tally.has(c as i64):
w := tally.get(c as i64)
if w > bestw:
bestw = w
best = c
end
end
end
ret best
end
func _peel_below(g &: Graph, alive &: Vector<bool>, deg: Vector<int>, core &: Vector<int>, k: int): int:
mut removed := 0
repeat g.n in u:
if alive.get(u):
if deg.get(u) <= k:
core.set(u, k)
alive.set(u, false)
removed += 1
end
end
end
ret removed
end
func _remap(comm &: Vector<int>, mapping &: Vector<int>, local: Vector<int>):
repeat comm.len() in u:
cur := mapping.get(u)
comm.set(u, local.get(cur))
end
repeat mapping.len() in u: mapping.set(u, comm.get(u)) end
end
func _weakest_link(g &: Graph): int:
if g.size() == 0: ret GRAPH_NONE end
mut eb := EdgeBetweenness(g)
defer eb.free()
mut best := 0
repeat eb.len() in e:
if eb.get(e) > eb.get(best): best = e end
end
ret best
end
func _drop_kth_kept(keep &: Vector<bool>, w: int):
mut c := 0
repeat keep.len() in e:
if keep.get(e):
if c == w:
keep.set(e, false)
ret
end
c += 1
end
end
end
@en "KCore"
@fa "هسته کا"
pub func KCore(g &: Graph, k: int, alive &: Vector<bool>): int:
FillBool(alive, g.n, true)
mut deg := Vector {} as Vector<int>
defer deg.free()
mut left := g.n
mut peeled := true
until peeled:
peeled = false
_degrees_now(g, alive, deg)
repeat g.n in u:
if alive.get(u):
if deg.get(u) < k:
alive.set(u, false)
left = left - 1
peeled = true
end
end
end
end
ret left
end
@en "CoreNumbers"
@fa "شماره‌های هسته"
pub func CoreNumbers(g &: Graph): Vector<int>:
mut core := Vector {} as Vector<int>
mut alive := Vector {} as Vector<bool>
defer alive.free()
mut deg := Vector {} as Vector<int>
defer deg.free()
FillInt(core, g.n, 0)
FillBool(alive, g.n, true)
mut k := 0
mut left := g.n
until left > 0:
_degrees_now(g, alive, deg)
removed := _peel_below(g, alive, deg, core, k)
if removed == 0:
k += 1
else:
left = left - removed
end
end
ret core
end
@en "Degeneracy"
@fa "تباهیدگی"
pub func Degeneracy(g &: Graph): int:
mut core := CoreNumbers(g)
defer core.free()
ret MaxInt(core)
end
@en "Modularity"
@fa "پیمانگی"
pub func Modularity(g &: Graph, comm: Vector<int>): f64:
mut deg := Vector {} as Vector<f64>
defer deg.free()
total := _weighted_degrees(g, deg)
if total <= 0.0: ret 0.0 end
mut inside := 0.0
repeat g.size() in e:
if comm.get(g.edge_from(e)) == comm.get(g.edge_to(e)): inside += g.edge_weight(e) end
end
mut expected := 0.0
k := MaxInt(comm) + 1
mut ktot := Vector {} as Vector<f64>
defer ktot.free()
FillFloat(ktot, k, 0.0)
repeat g.n in u: ktot.set(comm.get(u), ktot.get(comm.get(u)) + deg.get(u)) end
repeat k in c: expected += (ktot.get(c) / (2.0 * total)) * (ktot.get(c) / (2.0 * total)) end
ret inside / total - expected
end
@en "LabelPropagation"
@fa "انتشار برچسب"
pub func LabelPropagation(g &: Graph, comm &: Vector<int>): int:
Iota(comm, g.n)
mut round := 0
until round < 100:
if _label_round(g, comm) == false: break end
round += 1
end
ret _densify(comm)
end
@en "Louvain"
@fa "لوون"
pub func Louvain(g &: Graph, comm &: Vector<int>): int:
Iota(comm, g.n)
if g.size() == 0: ret g.n end
mut level := Clone(g)
mut mapping := Vector {} as Vector<int>
defer mapping.free()
Iota(mapping, g.n)
mut depth := 0
until depth < 10:
mut local := Vector {} as Vector<int>
Iota(local, level.n)
improved := _louvain_phase(level, local)
k := _densify(local)
if improved == false:
local.free()
break
end
_remap(comm, mapping, local)
next := _aggregate(level, local, k)
level.free()
level = next
local.free()
depth += 1
end
defer level.free()
ret _densify(comm)
end
@en "GirvanNewman"
@fa "گیروان نیومن"
pub func GirvanNewman(g &: Graph, want: int, comm &: Vector<int>): int:
mut work := Clone(g)
mut keep := Vector {} as Vector<bool>
defer keep.free()
FillBool(keep, g.size(), true)
mut count := Components(work, comm)
mut guard := 0
until count < want:
if guard >= g.size(): break end
e := _weakest_link(work)
if e == GRAPH_NONE: break end
_drop_kth_kept(keep, e)
next := EdgeSubgraph(g, keep)
work.free()
work = next
count = Components(work, comm)
guard += 1
end
defer work.free()
ret count
end
package graph
@en "Components"
@fa "مؤلفه‌ها"
pub func Components(g &: Graph, comp &: Vector<int>): int:
FillInt(comp, g.n, GRAPH_NONE)
mut id := 0
repeat g.n in u:
if comp.get(u) == GRAPH_NONE:
_comp_bfs(g, u, id, comp)
id += 1
end
end
ret id
end
@en "ComponentCount"
@fa "شمار مؤلفه"
pub func ComponentCount(g &: Graph): int:
mut comp := Vector {} as Vector<int>
defer comp.free()
ret Components(g, comp)
end
@en "ComponentSizes"
@fa "اندازه مؤلفه‌ها"
pub func ComponentSizes(g &: Graph): Vector<int>:
mut comp := Vector {} as Vector<int>
defer comp.free()
c := Components(g, comp)
mut out := Vector {} as Vector<int>
FillInt(out, c, 0)
repeat g.n in u:
i := comp.get(u)
out.set(i, out.get(i) + 1)
end
ret out
end
@en "IsConnected"
@fa "همبند است"
pub func IsConnected(g &: Graph): bool:
if g.n == 0: ret true end
ret ComponentCount(g) == 1
end
@en "IsBipartite"
@fa "دوبخشی است"
pub func IsBipartite(g &: Graph, color &: Vector<int>): bool:
FillInt(color, g.n, GRAPH_NONE)
if g.directed == false: ret _bipartite_all(g, color, g.n) end
mut u := ToUndirected(g)
ok := _bipartite_all(u, color, g.n)
defer u.free()
ret ok
end
@en "Bipartite"
@fa "دوبخشی"
pub func Bipartite(g &: Graph): bool:
mut color := Vector {} as Vector<int>
defer color.free()
ret IsBipartite(g, color)
end
@en "TopologicalSort"
@fa "مرتب‌سازی توپولوژیک"
pub func TopologicalSort(g &: Graph, order &: Vector<int>): bool:
order.clear()
mut deg := Vector {} as Vector<int>
defer deg.free()
_indegrees(g, deg)
mut q := Vector {} as Vector<int>
defer q.free()
repeat g.n in u:
if deg.get(u) == 0: q.push(u) end
end
mut head := 0
until head < q.len():
u := q.get(head)
head += 1
order.push(u)
_relax_indegree(g, u, deg, q)
end
ret order.len() == g.n
end
@en "TopologicalSortLex"
@fa "مرتب‌سازی توپولوژیک الفبایی"
pub func TopologicalSortLex(g &: Graph, order &: Vector<int>): bool:
order.clear()
mut deg := Vector {} as Vector<int>
defer deg.free()
_indegrees(g, deg)
mut h := MinHeap {}
defer h.free()
repeat g.n in u:
if deg.get(u) == 0: h.push(u as f64, u) end
end
until h.is_empty() == false:
u := h.pop()
order.push(u)
_relax_indegree_heap(g, u, deg, h)
end
ret order.len() == g.n
end
@en "IsDAG"
@fa "گراف جهت‌دار بی‌دور است"
pub func IsDAG(g &: Graph): bool:
if g.directed == false: ret false end
mut order := Vector {} as Vector<int>
defer order.free()
ret TopologicalSort(g, order)
end
@en "FindCycle"
@fa "یافتن دور"
pub func FindCycle(g &: Graph): Vector<int>:
mut out := Vector {} as Vector<int>
mut state := Vector {} as Vector<int>
defer state.free()
FillInt(state, g.n, 0)
repeat g.n in u:
if state.get(u) == 0:
if _find_cycle_from(g, u, state, out): ret out end
end
end
ret out
end
@en "HasCycle"
@fa "دارای دور"
pub func HasCycle(g &: Graph): bool:
mut c := FindCycle(g)
defer c.free()
ret c.len() > 0
end
package graph
func _tarjan_walk(g &: Graph, root: int, disc &: Vector<int>, low &: Vector<int>, comp &: Vector<int>, onstk &: Vector<bool>, timer &: int, ncomp &: int):
mut stk := Vector {} as Vector<int>
defer stk.free()
mut call := Vector {} as Vector<int>
defer call.free()
mut it := Vector {} as Vector<int>
defer it.free()
_tarjan_open(g, root, disc, low, onstk, stk, call, it, timer)
until call.len() > 0:
u := call.last()
k := it.last()
if k < g.adj_stop(u):
it.set(it.len() - 1, k + 1)
_tarjan_edge(g, u, g.adj_node(k), disc, low, onstk, stk, call, it, timer)
else:
_tarjan_close(u, disc, low, comp, onstk, stk, call, it, ncomp)
end
end
end
func _tarjan_open(g &: Graph, v: int, disc &: Vector<int>, low &: Vector<int>, onstk &: Vector<bool>, stk &: Vector<int>, call &: Vector<int>, it &: Vector<int>, timer &: int):
disc.set(v, timer)
low.set(v, timer)
timer = timer + 1
stk.push(v)
onstk.set(v, true)
call.push(v)
it.push(g.adj_start(v))
end
func _tarjan_edge(g &: Graph, u: int, v: int, disc &: Vector<int>, low &: Vector<int>, onstk &: Vector<bool>, stk &: Vector<int>, call &: Vector<int>, it &: Vector<int>, timer &: int):
if disc.get(v) == GRAPH_NONE:
_tarjan_open(g, v, disc, low, onstk, stk, call, it, timer)
ret
end
if onstk.get(v):
if disc.get(v) < low.get(u): low.set(u, disc.get(v)) end
end
end
func _tarjan_close(u: int, disc &: Vector<int>, low &: Vector<int>, comp &: Vector<int>, onstk &: Vector<bool>, stk &: Vector<int>, call &: Vector<int>, it &: Vector<int>, ncomp &: int):
if low.get(u) == disc.get(u):
until true:
w := stk.pop()
onstk.set(w, false)
comp.set(w, ncomp)
if w == u: break end
end
ncomp = ncomp + 1
end
call.pop()
it.pop()
if call.len() > 0:
p := call.last()
if low.get(u) < low.get(p): low.set(p, low.get(u)) end
end
end
func _bcc_open(g &: Graph, v: int, e: int, disc &: Vector<int>, low &: Vector<int>, call &: Vector<int>, it &: Vector<int>, via &: Vector<int>, kids &: Vector<int>, timer &: int):
disc.set(v, timer)
low.set(v, timer)
timer = timer + 1
call.push(v)
it.push(g.adj_start(v))
via.push(e)
kids.push(0)
end
func _bcc_close(u: int, p: int, root: int, disc &: Vector<int>, low &: Vector<int>, isart &: Vector<bool>, bridge &: Vector<bool>, ecomp &: Vector<int>, estack &: Vector<int>, kids: Vector<int>, e: int, ncomp &: int):
if low.get(u) < low.get(p): low.set(p, low.get(u)) end
if low.get(u) > disc.get(p): bridge.set(e, true) end
if low.get(u) >= disc.get(p):
if p != root: isart.set(p, true)
else kids.get(kids.len() - 1) > 1: isart.set(p, true)
end
until true:
f := estack.pop()
ecomp.set(f, ncomp)
if f == e: break end
end
ncomp = ncomp + 1
end
end
func _bcc_walk(g &: Graph, root: int, disc &: Vector<int>, low &: Vector<int>, isart &: Vector<bool>, bridge &: Vector<bool>, ecomp &: Vector<int>, timer &: int, ncomp &: int):
mut call := Vector {} as Vector<int>
defer call.free()
mut it := Vector {} as Vector<int>
defer it.free()
mut via := Vector {} as Vector<int>
defer via.free()
mut kids := Vector {} as Vector<int>
defer kids.free()
mut estack := Vector {} as Vector<int>
defer estack.free()
_bcc_open(g, root, GRAPH_NONE, disc, low, call, it, via, kids, timer)
until call.len() > 0:
u := call.last()
k := it.last()
if k < g.adj_stop(u):
it.set(it.len() - 1, k + 1)
_bcc_step(g, u, k, disc, low, call, it, via, kids, estack, timer)
else:
_bcc_pop(u, root, disc, low, isart, bridge, ecomp, estack, call, it, via, kids, ncomp)
end
end
end
func _bcc_step(g &: Graph, u: int, k: int, disc &: Vector<int>, low &: Vector<int>, call &: Vector<int>, it &: Vector<int>, via &: Vector<int>, kids &: Vector<int>, estack &: Vector<int>, timer &: int):
e := g.adj_edge(k)
v := g.adj_node(k)
if e == via.last(): ret end
if disc.get(v) == GRAPH_NONE:
estack.push(e)
kids.set(kids.len() - 1, kids.last() + 1)
_bcc_open(g, v, e, disc, low, call, it, via, kids, timer)
ret
end
if disc.get(v) < disc.get(u):
estack.push(e)
if disc.get(v) < low.get(u): low.set(u, disc.get(v)) end
end
end
func _bcc_pop(u: int, root: int, disc &: Vector<int>, low &: Vector<int>, isart &: Vector<bool>, bridge &: Vector<bool>, ecomp &: Vector<int>, estack &: Vector<int>, call &: Vector<int>, it &: Vector<int>, via &: Vector<int>, kids &: Vector<int>, ncomp &: int):
e := via.last()
call.pop()
it.pop()
via.pop()
kids.pop()
if call.len() > 0:
p := call.last()
_bcc_close(u, p, root, disc, low, isart, bridge, ecomp, estack, kids, e, ncomp)
end
end
func _dedupe_arc(seen &: HashMap<i64, bool>, h &: Graph, a: int, b: int, n: int):
k := (a as i64) * (n as i64) + (b as i64)
if seen.has(k): ret end
seen.put(k, true)
h.add_edge(a, b)
end
func _kosaraju_pass(t &: Graph, order: Vector<int>, comp &: Vector<int>): int:
mut ncomp := 0
mut i := order.len() - 1
until i >= 0:
u := order.get(i)
if comp.get(u) == GRAPH_NONE:
_label_reachable(t, u, ncomp, comp)
ncomp += 1
end
i = i - 1
end
ret ncomp
end
func _label_reachable(t &: Graph, s: int, id: int, comp &: Vector<int>):
mut q := Vector {} as Vector<int>
defer q.free()
comp.set(s, id)
q.push(s)
mut head := 0
until head < q.len():
u := q.get(head)
head += 1
mut k := t.adj_start(u)
stop := t.adj_stop(u)
until k < stop:
v := t.adj_node(k)
if comp.get(v) == GRAPH_NONE:
comp.set(v, id)
q.push(v)
end
k += 1
end
end
end
func _bcc_all(g &: Graph, isart &: Vector<bool>, bridge &: Vector<bool>, ecomp &: Vector<int>): int:
if g.directed == false: ret _bcc_run(g, isart, bridge, ecomp) end
mut u := ToUndirected(g)
c := _bcc_run(u, isart, bridge, ecomp)
defer u.free()
ret c
end
func _bcc_run(g &: Graph, isart &: Vector<bool>, bridge &: Vector<bool>, ecomp &: Vector<int>): int:
mut disc := Vector {} as Vector<int>
defer disc.free()
mut low := Vector {} as Vector<int>
defer low.free()
FillInt(disc, g.n, GRAPH_NONE)
FillInt(low, g.n, 0)
FillBool(isart, g.n, false)
FillBool(bridge, g.size(), false)
FillInt(ecomp, g.size(), GRAPH_NONE)
mut timer := 0
mut ncomp := 0
repeat g.n in u:
if disc.get(u) == GRAPH_NONE:
_bcc_walk(g, u, disc, low, isart, bridge, ecomp, timer, ncomp)
end
end
ret ncomp
end
@en "StronglyConnected"
@fa "مؤلفه‌های همبند قوی"
pub func StronglyConnected(g &: Graph, comp &: Vector<int>): int:
mut disc := Vector {} as Vector<int>
defer disc.free()
mut low := Vector {} as Vector<int>
defer low.free()
mut onstk := Vector {} as Vector<bool>
defer onstk.free()
FillInt(disc, g.n, GRAPH_NONE)
FillInt(low, g.n, 0)
FillBool(onstk, g.n, false)
FillInt(comp, g.n, GRAPH_NONE)
mut timer := 0
mut ncomp := 0
repeat g.n in u:
if disc.get(u) == GRAPH_NONE:
_tarjan_walk(g, u, disc, low, comp, onstk, timer, ncomp)
end
end
ret ncomp
end
@en "SCCCount"
@fa "شمار مؤلفه قوی"
pub func SCCCount(g &: Graph): int:
mut comp := Vector {} as Vector<int>
defer comp.free()
ret StronglyConnected(g, comp)
end
@en "IsStronglyConnected"
@fa "همبند قوی است"
pub func IsStronglyConnected(g &: Graph): bool:
if g.n == 0: ret true end
ret SCCCount(g) == 1
end
@en "Kosaraju"
@fa "کوساراجو"
pub func Kosaraju(g &: Graph, comp &: Vector<int>): int:
mut order := Vector {} as Vector<int>
defer order.free()
mut seen := Vector {} as Vector<bool>
defer seen.free()
mut pre := Vector {} as Vector<int>
defer pre.free()
FillBool(seen, g.n, false)
repeat g.n in u: _dfs_walk(g, u, pre, order, seen) end
mut t := Transpose(g)
FillInt(comp, g.n, GRAPH_NONE)
ncomp := _kosaraju_pass(t, order, comp)
defer t.free()
ret ncomp
end
@en "Condensation"
@fa "چگالش"
pub func Condensation(g &: Graph, comp &: Vector<int>): Graph:
ncomp := StronglyConnected(g, comp)
mut h := New(ncomp, true)
mut seen := HashMap {} as HashMap<i64, bool>
defer seen.free()
repeat g.size() in e:
a := comp.get(g.edge_from(e))
b := comp.get(g.edge_to(e))
if a != b: _dedupe_arc(seen, h, a, b, ncomp) end
end
ret h
end
@en "Bridges"
@fa "پل‌ها"
pub func Bridges(g &: Graph): Vector<int>:
mut isart := Vector {} as Vector<bool>
defer isart.free()
mut bridge := Vector {} as Vector<bool>
defer bridge.free()
mut ecomp := Vector {} as Vector<int>
defer ecomp.free()
_bcc_all(g, isart, bridge, ecomp)
mut out := Vector {} as Vector<int>
repeat g.size() in e:
if bridge.get(e): out.push(e) end
end
ret out
end
@en "ArticulationPoints"
@fa "نقاط برش"
pub func ArticulationPoints(g &: Graph): Vector<int>:
mut isart := Vector {} as Vector<bool>
defer isart.free()
mut bridge := Vector {} as Vector<bool>
defer bridge.free()
mut ecomp := Vector {} as Vector<int>
defer ecomp.free()
_bcc_all(g, isart, bridge, ecomp)
mut out := Vector {} as Vector<int>
repeat g.n in u:
if isart.get(u): out.push(u) end
end
ret out
end
@en "BiconnectedComponents"
@fa "مؤلفه‌های دوهمبند"
pub func BiconnectedComponents(g &: Graph, ecomp &: Vector<int>): int:
mut isart := Vector {} as Vector<bool>
defer isart.free()
mut bridge := Vector {} as Vector<bool>
defer bridge.free()
ret _bcc_all(g, isart, bridge, ecomp)
end
@en "IsBiconnected"
@fa "دوهمبند است"
pub func IsBiconnected(g &: Graph): bool:
if g.n < 3: ret false end
if IsConnected(g) == false: ret false end
mut a := ArticulationPoints(g)
defer a.free()
ret a.len() == 0
end
@en "IsTwoEdgeConnected"
@fa "دو یال همبند است"
pub func IsTwoEdgeConnected(g &: Graph): bool:
if g.n < 2: ret false end
if IsConnected(g) == false: ret false end
mut b := Bridges(g)
defer b.free()
ret b.len() == 0
end
@en "TwoEdgeComponents"
@fa "مؤلفه‌های دویالی"
pub func TwoEdgeComponents(g &: Graph, comp &: Vector<int>): int:
mut bridge := Vector {} as Vector<bool>
defer bridge.free()
mut isart := Vector {} as Vector<bool>
defer isart.free()
mut ecomp := Vector {} as Vector<int>
defer ecomp.free()
_bcc_all(g, isart, bridge, ecomp)
mut keep := Vector {} as Vector<bool>
defer keep.free()
repeat g.size() in e: keep.push(bridge.get(e) == false) end
mut h := EdgeSubgraph(g, keep)
c := Components(h, comp)
defer h.free()
ret c
end
package graph
func _sw_matrix(g &: Graph): Matrix:
mut w := NewMatrix(g.n, g.n)
repeat g.size() in e:
u := g.edge_from(e)
v := g.edge_to(e)
if u != v:
w.add_at(u, v, g.edge_weight(e))
w.add_at(v, u, g.edge_weight(e))
end
end
ret w
end
func _sw_phase(w &: Matrix, active &: Vector<int>, wsum &: Vector<f64>, added &: Vector<bool>): f64:
k := active.len()
FillBool(added, w.rows, false)
FillFloat(wsum, w.rows, 0.0)
mut prev := GRAPH_NONE
mut last := GRAPH_NONE
repeat k:
sel := _sw_select(active, wsum, added)
added.set(sel, true)
prev = last
last = sel
_sw_absorb(w, active, wsum, added, sel)
end
cut := wsum.get(last)
_sw_merge(w, active, prev, last)
ret cut
end
func _sw_select(active: Vector<int>, wsum: Vector<f64>, added: Vector<bool>): int:
mut best := GRAPH_NONE
repeat active.len() in i:
v := active.get(i)
if added.get(v) == false:
if best == GRAPH_NONE: best = v
else wsum.get(v) > wsum.get(best): best = v
end
end
end
ret best
end
func _sw_absorb(w &: Matrix, active: Vector<int>, wsum &: Vector<f64>, added: Vector<bool>, sel: int):
repeat active.len() in i:
v := active.get(i)
if added.get(v) == false: wsum.set(v, wsum.get(v) + w.at(sel, v)) end
end
end
func _sw_merge(w &: Matrix, active &: Vector<int>, prev: int, last: int):
if prev == GRAPH_NONE: ret end
repeat active.len() in i:
v := active.get(i)
if v != last:
if v != prev:
w.set(prev, v, w.at(prev, v) + w.at(last, v))
w.set(v, prev, w.at(prev, v))
end
end
end
mut keep := Vector {} as Vector<int>
repeat active.len() in i:
v := active.get(i)
if v != last: keep.push(v) end
end
active.clear()
repeat keep.len() in i: active.push(keep.get(i)) end
defer keep.free()
end
func _split_net(g &: Graph): FlowNet:
n := g.n
mut f := NewFlowNet(2 * n)
repeat n in v: f.add_arc(v, v + n, 1.0) end
repeat g.size() in e:
u := g.edge_from(e)
v := g.edge_to(e)
f.add_arc(u + n, v, GRAPH_INF)
if g.directed == false: f.add_arc(v + n, u, GRAPH_INF) end
end
ret f
end
func _unit_net(g &: Graph): FlowNet:
mut f := NewFlowNet(g.n)
repeat g.size() in e:
u := g.edge_from(e)
v := g.edge_to(e)
if g.directed: f.add_arc(u, v, 1.0)
else:
f.add_edge(u, v, 1.0)
end
end
ret f
end
func _kuhn_try(g &: Graph, u: int, seen &: Vector<bool>, mate &: Vector<int>): bool:
mut k := g.adj_start(u)
stop := g.adj_stop(u)
until k < stop:
v := g.adj_node(k)
if seen.get(v) == false:
seen.set(v, true)
if _kuhn_take(g, u, v, seen, mate): ret true end
end
k += 1
end
ret false
end
func _kuhn_take(g &: Graph, u: int, v: int, seen &: Vector<bool>, mate &: Vector<int>): bool:
w := mate.get(v)
if w == GRAPH_NONE:
mate.set(v, u)
mate.set(u, v)
ret true
end
if _kuhn_try(g, w, seen, mate):
mate.set(v, u)
mate.set(u, v)
ret true
end
ret false
end
func _matching_run(g &: Graph, color: Vector<int>, mate &: Vector<int>): int:
FillInt(mate, g.n, GRAPH_NONE)
mut seen := Vector {} as Vector<bool>
defer seen.free()
mut count := 0
repeat g.n in u:
if _needs_match(color, mate, u):
FillBool(seen, g.n, false)
if _kuhn_try(g, u, seen, mate): count += 1 end
end
end
ret count
end
func _needs_match(color: Vector<int>, mate: Vector<int>, u: int): bool:
if color.get(u) != 0: ret false end
ret mate.get(u) == GRAPH_NONE
end
func _alternating_reach(g &: Graph, color: Vector<int>, mate: Vector<int>, seen &: Vector<bool>):
FillBool(seen, g.n, false)
mut q := Vector {} as Vector<int>
defer q.free()
repeat g.n in u:
if color.get(u) == 0:
if mate.get(u) == GRAPH_NONE:
seen.set(u, true)
q.push(u)
end
end
end
mut head := 0
until head < q.len():
u := q.get(head)
head += 1
_alternating_step(g, color, mate, seen, q, u)
end
end
func _alternating_step(g &: Graph, color: Vector<int>, mate: Vector<int>, seen &: Vector<bool>, q &: Vector<int>, u: int):
mut k := g.adj_start(u)
stop := g.adj_stop(u)
until k < stop:
v := g.adj_node(k)
ok := color.get(u) == 0
matched := mate.get(u) == v
if ok != matched:
if seen.get(v) == false:
seen.set(v, true)
q.push(v)
end
end
k += 1
end
end
func _cover_from(g &: Graph, color: Vector<int>, seen: Vector<bool>, cover &: Vector<bool>): int:
mut count := 0
repeat g.n in u:
left := color.get(u) == 0
mut take := seen.get(u)
if left: take = seen.get(u) == false end
if take:
if g.degree(u) > 0:
cover.set(u, true)
count += 1
end
end
end
ret count
end
func _kappa_row(s &: Graph, f &: FlowNet, a: int, best &: int):
repeat s.n in b:
if a != b:
if s.has_edge(a, b) == false:
f.reset()
v := MaxFlow(f, a + s.n, b)
if v < (best as f64): best = v as int end
end
end
end
end
func _directed_edge_connectivity(g &: Graph): int:
mut f := _unit_net(g)
mut best := GRAPH_INF
repeat g.n in t:
if t != 0:
f.reset()
a := MaxFlow(f, 0, t)
if a < best: best = a end
f.reset()
b := MaxFlow(f, t, 0)
if b < best: best = b end
end
end
defer f.free()
if best >= GRAPH_INF: ret 0 end
ret (best + 0.5) as int
end
@en "GlobalMinCut"
@fa "کمینه برش سراسری"
pub func GlobalMinCut(g &: Graph): f64:
if g.n < 2: ret 0.0 end
mut w := _sw_matrix(g)
mut active := Vector {} as Vector<int>
defer active.free()
mut wsum := Vector {} as Vector<f64>
defer wsum.free()
mut added := Vector {} as Vector<bool>
defer added.free()
Iota(active, g.n)
mut best := GRAPH_INF
until active.len() > 1:
cut := _sw_phase(w, active, wsum, added)
if cut < best: best = cut end
end
defer w.free()
ret best
end
@en "EdgeConnectivity"
@fa "همبندی یالی"
pub func EdgeConnectivity(g &: Graph): int:
if g.n < 2: ret 0 end
if g.directed: ret _directed_edge_connectivity(g) end
mut u := Clone(g)
repeat u.size() in e: u.set_weight(e, 1.0) end
v := GlobalMinCut(u)
defer u.free()
if v >= GRAPH_INF: ret 0 end
ret (v + 0.5) as int
end
@en "VertexConnectivity"
@fa "همبندی رأسی"
pub func VertexConnectivity(g &: Graph): int:
if g.n < 2: ret 0 end
if IsConnected(g) == false: ret 0 end
mut s := Simplify(g)
mut best := s.n - 1
mut f := _split_net(s)
repeat s.n in a:
_kappa_row(s, f, a, best)
end
defer f.free()
defer s.free()
ret best
end
@en "BipartiteMatching"
@fa "جورسازی دوبخشی"
pub func BipartiteMatching(g &: Graph, mate &: Vector<int>): int:
mut color := Vector {} as Vector<int>
defer color.free()
if IsBipartite(g, color) == false: ret GRAPH_NONE end
repeat g.n in u:
if color.get(u) == GRAPH_NONE: color.set(u, 0) end
end
if g.directed == false: ret _matching_run(g, color, mate) end
mut ug := ToUndirected(g)
c := _matching_run(ug, color, mate)
defer ug.free()
ret c
end
@en "MaximalMatching"
@fa "جورسازی بیشینه‌ای"
pub func MaximalMatching(g &: Graph, mate &: Vector<int>): int:
FillInt(mate, g.n, GRAPH_NONE)
mut count := 0
repeat g.size() in e:
u := g.edge_from(e)
v := g.edge_to(e)
if u != v:
if mate.get(u) == GRAPH_NONE:
if mate.get(v) == GRAPH_NONE:
mate.set(u, v)
mate.set(v, u)
count += 1
end
end
end
end
ret count
end
@en "MinimumVertexCover"
@fa "کمینه پوشش رأسی"
pub func MinimumVertexCover(g &: Graph, cover &: Vector<bool>): int:
mut color := Vector {} as Vector<int>
defer color.free()
FillBool(cover, g.n, false)
if IsBipartite(g, color) == false: ret GRAPH_NONE end
repeat g.n in u:
if color.get(u) == GRAPH_NONE: color.set(u, 0) end
end
mut mate := Vector {} as Vector<int>
defer mate.free()
_matching_run(g, color, mate)
mut seen := Vector {} as Vector<bool>
defer seen.free()
_alternating_reach(g, color, mate, seen)
ret _cover_from(g, color, seen, cover)
end
@en "MaximumIndependentSetBipartite"
@fa "بیشینه مجموعه مستقل دوبخشی"
pub func MaximumIndependentSetBipartite(g &: Graph, pick &: Vector<bool>): int:
mut cover := Vector {} as Vector<bool>
defer cover.free()
c := MinimumVertexCover(g, cover)
if c == GRAPH_NONE: ret GRAPH_NONE end
FillBool(pick, g.n, false)
mut count := 0
repeat g.n in u:
if cover.get(u) == false:
pick.set(u, true)
count += 1
end
end
ret count
end
package graph
func _dag_order(g &: Graph, order &: Vector<int>): bool:
if g.directed == false: ret false end
ret TopologicalSort(g, order)
end
func _relax_forward(g &: Graph, u: int, dist &: Vector<f64>, parent &: Vector<int>, longest: bool):
mut k := g.adj_start(u)
stop := g.adj_stop(u)
until k < stop:
v := g.adj_node(k)
new_dist := dist.get(u) + g.adj_weight(k)
if _better(new_dist, dist.get(v), longest):
dist.set(v, new_dist)
parent.set(v, u)
end
k += 1
end
end
func _better(candidate: f64, current: f64, longest: bool): bool:
if longest: ret candidate > current end
ret candidate < current
end
func _closure_row(g &: Graph, s: int, m &: IntMatrix):
mut r := Reachable(g, s)
defer r.free()
repeat g.n in t:
if r.get(t):
if t != s: m.set(s, t, 1) end
end
end
end
func _is_redundant(g &: Graph, closure &: IntMatrix, u: int, v: int): bool:
repeat g.n in w:
if w != u:
if w != v:
if closure.at(u, w) == 1:
if closure.at(w, v) == 1: ret true end
end
end
end
end
ret false
end
func _dag_relax(g &: Graph, src: int, dist &: Vector<f64>, parent &: Vector<int>, longest: bool): bool:
mut order := Vector {} as Vector<int>
defer order.free()
mut start := GRAPH_INF
if longest: start = 0.0 - GRAPH_INF end
FillFloat(dist, g.n, start)
FillInt(parent, g.n, GRAPH_NONE)
if _dag_order(g, order) == false: ret false end
dist.set(src, 0.0)
repeat order.len() in i:
u := order.get(i)
if dist.get(u) != start: _relax_forward(g, u, dist, parent, longest) end
end
ret true
end
func _spread_ways(g &: Graph, u: int, ways &: Vector<f64>):
mut k := g.adj_start(u)
stop := g.adj_stop(u)
until k < stop:
v := g.adj_node(k)
ways.set(v, ways.get(v) + ways.get(u))
k += 1
end
end
func _push_layer(g &: Graph, u: int, layer &: Vector<int>):
mut k := g.adj_start(u)
stop := g.adj_stop(u)
until k < stop:
v := g.adj_node(k)
if layer.get(v) < layer.get(u) + 1: layer.set(v, layer.get(u) + 1) end
k += 1
end
end
func _argmax(dist: Vector<f64>): int:
mut best := 0
repeat dist.len() in u:
if dist.get(u) > dist.get(best): best = u end
end
ret best
end
func _path_root(parent: Vector<int>, t: int): int:
mut u := t
until parent.get(u) != GRAPH_NONE: u = parent.get(u) end
ret u
end
func _reduce_edge(g &: Graph, h &: Graph, closure &: IntMatrix, seen &: HashMap<i64, bool>, u: int, v: int):
if u == v: ret end
k := (u as i64) * (g.n as i64) + (v as i64)
if seen.has(k): ret end
seen.put(k, true)
if _is_redundant(g, closure, u, v): ret end
h.add_edge(u, v)
end
@en "DAGShortestPath"
@fa "کوتاه‌ترین مسیر بی‌دور"
pub func DAGShortestPath(g &: Graph, src: int, dist &: Vector<f64>, parent &: Vector<int>): bool:
ret _dag_relax(g, src, dist, parent, false)
end
@en "DAGLongestPath"
@fa "بلندترین مسیر بی‌دور"
pub func DAGLongestPath(g &: Graph, src: int, dist &: Vector<f64>, parent &: Vector<int>): bool:
ret _dag_relax(g, src, dist, parent, true)
end
@en "CriticalPath"
@fa "مسیر بحرانی"
pub func CriticalPath(g &: Graph): Vector<int>:
mut order := Vector {} as Vector<int>
defer order.free()
out := Vector {} as Vector<int>
if _dag_order(g, order) == false: ret out end
mut dist := Vector {} as Vector<f64>
defer dist.free()
mut parent := Vector {} as Vector<int>
defer parent.free()
FillFloat(dist, g.n, 0.0)
FillInt(parent, g.n, GRAPH_NONE)
repeat order.len() in i: _relax_forward(g, order.get(i), dist, parent, true) end
ret PathFromParents(parent, _path_root(parent, _argmax(dist)), _argmax(dist))
end
@en "CountPaths"
@fa "شمار مسیرها"
pub func CountPaths(g &: Graph, s: int, t: int): f64:
mut order := Vector {} as Vector<int>
defer order.free()
if _dag_order(g, order) == false: ret 0.0 end
mut ways := Vector {} as Vector<f64>
defer ways.free()
FillFloat(ways, g.n, 0.0)
ways.set(s, 1.0)
repeat order.len() in i:
u := order.get(i)
if ways.get(u) > 0.0: _spread_ways(g, u, ways) end
end
ret ways.get(t)
end
@en "PathCounts"
@fa "شمارش مسیرها"
pub func PathCounts(g &: Graph, src: int): Vector<f64>:
mut order := Vector {} as Vector<int>
defer order.free()
mut ways := Vector {} as Vector<f64>
FillFloat(ways, g.n, 0.0)
if _dag_order(g, order) == false: ret ways end
ways.set(src, 1.0)
repeat order.len() in i:
u := order.get(i)
if ways.get(u) > 0.0: _spread_ways(g, u, ways) end
end
ret ways
end
@en "TransitiveClosure"
@fa "بستار تعدی"
pub func TransitiveClosure(g &: Graph): IntMatrix:
mut m := NewIntMatrix(g.n, g.n, 0)
repeat g.n in s: _closure_row(g, s, m) end
ret m
end
@en "TransitiveReduction"
@fa "کاهش تعدی"
pub func TransitiveReduction(g &: Graph): Graph:
mut h := New(g.n, true)
if IsDAG(g) == false: ret h end
mut closure := TransitiveClosure(g)
defer closure.free()
mut seen := HashMap {} as HashMap<i64, bool>
defer seen.free()
repeat g.size() in e:
u := g.edge_from(e)
v := g.edge_to(e)
_reduce_edge(g, h, closure, seen, u, v)
end
ret h
end
@en "TopologicalLayers"
@fa "لایه‌های توپولوژیک"
pub func TopologicalLayers(g &: Graph, layer &: Vector<int>): int:
mut order := Vector {} as Vector<int>
defer order.free()
FillInt(layer, g.n, 0)
if _dag_order(g, order) == false: ret GRAPH_NONE end
repeat order.len() in i: _push_layer(g, order.get(i), layer) end
ret MaxInt(layer) + 1
end
@en "IsTotalOrder"
@fa "ترتیب کلی است"
pub func IsTotalOrder(g &: Graph): bool:
mut order := Vector {} as Vector<int>
defer order.free()
if _dag_order(g, order) == false: ret false end
mut closure := TransitiveClosure(g)
defer closure.free()
mut i := 0
until i < order.len() - 1:
if closure.at(order.get(i), order.get(i + 1)) == 0: ret false end
i += 1
end
ret true
end
package graph
func _dinic_bfs(f &: FlowNet, s: int, t: int, level &: Vector<int>): bool:
FillInt(level, f.n, GRAPH_NONE)
mut q := Vector {} as Vector<int>
defer q.free()
level.set(s, 0)
q.push(s)
mut head := 0
until head < q.len():
u := q.get(head)
head += 1
mut e := f.head.get(u)
until e != GRAPH_NONE:
_dinic_visit(f, u, e, level, q)
e = f.nxt.get(e)
end
end
ret level.get(t) != GRAPH_NONE
end
func _dinic_visit(f &: FlowNet, u: int, e: int, level &: Vector<int>, q &: Vector<int>):
v := f.to.get(e)
if f.cap.get(e) <= 0.0: ret end
if level.get(v) != GRAPH_NONE: ret end
level.set(v, level.get(u) + 1)
q.push(v)
end
func _dinic_step(f &: FlowNet, u: int, level &: Vector<int>, iter &: Vector<int>): int:
mut e := iter.get(u)
until e != GRAPH_NONE:
v := f.to.get(e)
if f.cap.get(e) > 0.0:
if level.get(v) == level.get(u) + 1: ret e end
end
e = f.nxt.get(e)
iter.set(u, e)
end
ret GRAPH_NONE
end
func _apply_path(f &: FlowNet, path: Vector<int>): f64:
mut bottleneck := GRAPH_INF
repeat path.len() in i:
c := f.cap.get(path.get(i))
if c < bottleneck: bottleneck = c end
end
repeat path.len() in i:
e := path.get(i)
f.cap.set(e, f.cap.get(e) - bottleneck)
r := e ^ 1
f.cap.set(r, f.cap.get(r) + bottleneck)
end
ret bottleneck
end
func _dinic_path(f &: FlowNet, s: int, t: int, level &: Vector<int>, iter &: Vector<int>): f64:
mut path := Vector {} as Vector<int>
defer path.free()
mut u := s
mut result := 0.0
until true:
if u == t:
result = _apply_path(f, path)
break
end
e := _dinic_step(f, u, level, iter)
if e != GRAPH_NONE:
path.push(e)
u = f.to.get(e)
else:
if u == s: break end
level.set(u, GRAPH_NONE)
back := path.pop()
u = f.to.get(back ^ 1)
iter.set(u, f.nxt.get(iter.get(u)))
end
end
ret result
end
func _ek_bfs(f &: FlowNet, s: int, t: int, via &: Vector<int>): bool:
FillInt(via, f.n, GRAPH_NONE)
mut seen := Vector {} as Vector<bool>
defer seen.free()
FillBool(seen, f.n, false)
mut q := Vector {} as Vector<int>
defer q.free()
seen.set(s, true)
q.push(s)
mut head := 0
until head < q.len():
u := q.get(head)
head += 1
mut e := f.head.get(u)
until e != GRAPH_NONE:
_ek_visit(f, e, seen, via, q)
e = f.nxt.get(e)
end
end
ret seen.get(t)
end
func _ek_visit(f &: FlowNet, e: int, seen &: Vector<bool>, via &: Vector<int>, q &: Vector<int>):
v := f.to.get(e)
if f.cap.get(e) <= 0.0: ret end
if seen.get(v): ret end
seen.set(v, true)
via.set(v, e)
q.push(v)
end
func _ek_augment(f &: FlowNet, s: int, t: int, via: Vector<int>): f64:
mut path := Vector {} as Vector<int>
defer path.free()
mut u := t
until u != s:
e := via.get(u)
path.push(e)
u = f.to.get(e ^ 1)
end
ret _apply_path(f, path)
end
func _spfa(f &: FlowNet, s: int, t: int, dist &: Vector<f64>, via &: Vector<int>): bool:
FillFloat(dist, f.n, GRAPH_INF)
FillInt(via, f.n, GRAPH_NONE)
dist.set(s, 0.0)
mut round := 0
until round < f.n:
if _spfa_pass(f, dist, via) == false: break end
round += 1
end
ret dist.get(t) < GRAPH_INF
end
func _spfa_pass(f &: FlowNet, dist &: Vector<f64>, via &: Vector<int>): bool:
mut changed := false
repeat f.n in u:
if dist.get(u) < GRAPH_INF:
mut e := f.head.get(u)
until e != GRAPH_NONE:
if _spfa_relax(f, u, e, dist, via): changed = true end
e = f.nxt.get(e)
end
end
end
ret changed
end
func _spfa_relax(f &: FlowNet, u: int, e: int, dist &: Vector<f64>, via &: Vector<int>): bool:
if f.cap.get(e) <= 0.0: ret false end
v := f.to.get(e)
new_dist := dist.get(u) + f.cost.get(e)
if new_dist < dist.get(v):
dist.set(v, new_dist)
via.set(v, e)
ret true
end
ret false
end
func _residual_side(f &: FlowNet, s: int, side &: Vector<bool>):
FillBool(side, f.n, false)
mut q := Vector {} as Vector<int>
defer q.free()
side.set(s, true)
q.push(s)
mut head := 0
until head < q.len():
u := q.get(head)
head += 1
mut e := f.head.get(u)
until e != GRAPH_NONE:
v := f.to.get(e)
if f.cap.get(e) > 0.0:
if side.get(v) == false:
side.set(v, true)
q.push(v)
end
end
e = f.nxt.get(e)
end
end
end
func _mcf_augment(f &: FlowNet, s: int, t: int, via: Vector<int>, room: f64): f64:
mut path := Vector {} as Vector<int>
defer path.free()
mut u := t
mut bottleneck := room
until u != s:
e := via.get(u)
if f.cap.get(e) < bottleneck: bottleneck = f.cap.get(e) end
path.push(e)
u = f.to.get(e ^ 1)
end
repeat path.len() in i:
e := path.get(i)
f.cap.set(e, f.cap.get(e) - bottleneck)
r := e ^ 1
f.cap.set(r, f.cap.get(r) + bottleneck)
end
ret bottleneck
end
@en "NewFlowNet"
@fa "شبکه شار جدید"
pub func NewFlowNet(n: int): FlowNet:
mut f := FlowNet {}
f.n = n
FillInt(f.head, n, GRAPH_NONE)
ret f
end
@en "FlowFromGraph"
@fa "شار از گراف"
pub func FlowFromGraph(g &: Graph): FlowNet:
mut f := NewFlowNet(g.n)
repeat g.size() in e:
if g.directed: f.add_arc(g.edge_from(e), g.edge_to(e), g.edge_weight(e))
else:
f.add_edge(g.edge_from(e), g.edge_to(e), g.edge_weight(e))
end
end
ret f
end
@en "MaxFlow"
@fa "بیشینه شار"
pub func MaxFlow(f &: FlowNet, s: int, t: int): f64:
mut level := Vector {} as Vector<int>
defer level.free()
mut iter := Vector {} as Vector<int>
defer iter.free()
mut total := 0.0
if s == t: ret 0.0 end
FillInt(iter, f.n, GRAPH_NONE)
until _dinic_bfs(f, s, t, level):
repeat f.n in u: iter.set(u, f.head.get(u)) end
mut aug := _dinic_path(f, s, t, level, iter)
until aug > 0.0:
total += aug
aug = _dinic_path(f, s, t, level, iter)
end
end
ret total
end
@en "MaxFlowEdmondsKarp"
@fa "بیشینه شار ادموندز کارپ"
pub func MaxFlowEdmondsKarp(f &: FlowNet, s: int, t: int): f64:
mut via := Vector {} as Vector<int>
defer via.free()
mut total := 0.0
if s == t: ret 0.0 end
until _ek_bfs(f, s, t, via):
total += _ek_augment(f, s, t, via)
end
ret total
end
@en "MinCut"
@fa "کمینه برش"
pub func MinCut(f &: FlowNet, s: int, t: int, side &: Vector<bool>): f64:
v := MaxFlow(f, s, t)
_residual_side(f, s, side)
ret v
end
@en "MaxFlowValue"
@fa "مقدار بیشینه شار"
pub func MaxFlowValue(g &: Graph, s: int, t: int): f64:
mut f := FlowFromGraph(g)
v := MaxFlow(f, s, t)
defer f.free()
ret v
end
@en "MinCutEdges"
@fa "یال‌های کمینه برش"
pub func MinCutEdges(g &: Graph, s: int, t: int, cut &: Vector<int>): f64:
mut f := FlowFromGraph(g)
mut side := Vector {} as Vector<bool>
defer side.free()
v := MinCut(f, s, t, side)
cut.clear()
repeat g.size() in e:
a := side.get(g.edge_from(e))
b := side.get(g.edge_to(e))
if a != b: cut.push(e) end
end
defer f.free()
ret v
end
@en "MinCostFlow"
@fa "شار کم‌هزینه"
pub func MinCostFlow(f &: FlowNet, s: int, t: int, want: f64, sent &: f64): f64:
mut dist := Vector {} as Vector<f64>
defer dist.free()
mut via := Vector {} as Vector<int>
defer via.free()
mut total := 0.0
sent = 0.0
until _spfa(f, s, t, dist, via):
if sent >= want: break end
pushed := _mcf_augment(f, s, t, via, want - sent)
if pushed <= 0.0: break end
sent = sent + pushed
total += pushed * dist.get(t)
end
ret total
end
package graph
@en "FlowNet"
@fa "شبکه شار"
pub struct FlowNet:
pub n: int = 0
pub head: Vector<int> = Vector {}
pub to: Vector<int> = Vector {}
pub cap: Vector<f64> = Vector {}
pub cost: Vector<f64> = Vector {}
pub orig: Vector<f64> = Vector {}
pub nxt: Vector<int> = Vector {}
@en "arc_count"
@fa "شمار کمان"
pub func arc_count(): int: ret this.to.len() end
@en "add_arc"
@fa "افزودن کمان"
pub func add_arc(u: int, v: int, c: f64): int:
ret this.add_cost_arc(u, v, c, 0.0)
end
@en "add_cost_arc"
@fa "افزودن کمان هزینه‌دار"
pub func add_cost_arc(u: int, v: int, c: f64, k: f64): int:
e := this.to.len()
this._push(u, v, c, k)
this._push(v, u, 0.0, 0.0 - k)
ret e
end
@en "add_edge"
@fa "افزودن یال"
pub func add_edge(u: int, v: int, c: f64): int:
e := this.to.len()
this._push(u, v, c, 0.0)
this._push(v, u, c, 0.0)
ret e
end
func _push(u: int, v: int, c: f64, k: f64):
this.to.push(v)
this.cap.push(c)
this.orig.push(c)
this.cost.push(k)
this.nxt.push(this.head.get(u))
this.head.set(u, this.to.len() - 1)
end
@en "flow_on"
@fa "شار روی"
pub func flow_on(e: int): f64: ret this.orig.get(e) - this.cap.get(e) end
@en "reset"
@fa "بازنشانی"
pub func reset():
repeat this.cap.len() in e: this.cap.set(e, this.orig.get(e)) end
end
@en "free"
@fa "آزادسازی"
pub func free():
this.head.free()
this.to.free()
this.cap.free()
this.cost.free()
this.orig.free()
this.nxt.free()
end
end
package graph
import rand
func _link_all(g &: Graph, a: int, b: int):
mut i := a
until i < b:
mut j := i + 1
until j < b:
g.add_edge(i, j)
j += 1
end
i += 1
end
end
func _grid_index(r: int, c: int, cols: int): int: ret r * cols + c end
func _tree_size(branch: int, depth: int): int:
mut total := 1
mut level := 1
repeat depth:
level = level * branch
total += level
end
ret total
end
func _hypercube_bit(u: int, b: int): int: ret u ^ (1 << b) end
func _ba_targets(pool: Vector<int>, m: int, picked &: Vector<int>):
picked.clear()
mut guard := 0
until picked.len() < m:
if guard > 1000: break end
guard += 1
if pool.len() == 0: break end
cand := pool.get(rand.IntN(pool.len() as i64) as int)
if _already(picked, cand) == false: picked.push(cand) end
end
end
func _already(v: Vector<int>, x: int): bool:
repeat v.len() in i:
if v.get(i) == x: ret true end
end
ret false
end
func _circ_link(g &: Graph, seen &: HashMap<i64, bool>, u: int, off: int, n: int):
if off <= 0: ret end
v := (u + off) % n
if v == u: ret end
mut lo := u
mut hi := v
if lo > hi:
lo = v
hi = u
end
key := (lo as i64) * (n as i64) + (hi as i64)
if seen.has(key): ret end
seen.put(key, true)
g.add_edge(lo, hi)
end
func _random_edge(g &: Graph, seen &: HashMap<i64, bool>, n: int): bool:
u := rand.IntN(n as i64) as int
v := rand.IntN(n as i64) as int
if u == v: ret false end
mut lo := u
mut hi := v
if lo > hi:
lo = v
hi = u
end
key := (lo as i64) * (n as i64) + (hi as i64)
if seen.has(key): ret false end
seen.put(key, true)
g.add_edge(lo, hi)
ret true
end
func _seed_pool(g &: Graph, pool &: Vector<int>):
repeat g.size() in e:
pool.push(g.edge_from(e))
pool.push(g.edge_to(e))
end
end
func _ba_attach(g &: Graph, pool &: Vector<int>, picked: Vector<int>, v: int):
repeat picked.len() in i:
t := picked.get(i)
g.add_edge(v, t)
pool.push(v)
pool.push(t)
end
end
func _rewire(ring &: Graph, p: f64, n: int): Graph:
mut g := New(n, false)
mut seen := HashMap {} as HashMap<i64, bool>
defer seen.free()
repeat ring.size() in e:
u := ring.edge_from(e)
mut v := ring.edge_to(e)
if rand.Float() < p: v = rand.IntN(n as i64) as int end
if v != u: _circ_link(g, seen, u, (v - u + n) % n, n) end
end
ret g
end
@en "EmptyGraph"
@fa "گراف تهی"
pub func EmptyGraph(n: int): Graph: ret New(n, false) end
@en "CompleteGraph"
@fa "گراف کامل"
pub func CompleteGraph(n: int): Graph:
mut g := New(n, false)
_link_all(g, 0, n)
ret g
end
@en "CompleteBipartite"
@fa "دوبخشی کامل"
pub func CompleteBipartite(a: int, b: int): Graph:
mut g := New(a + b, false)
repeat a in i:
repeat b in j: g.add_edge(i, a + j) end
end
ret g
end
@en "PathGraph"
@fa "گراف مسیر"
pub func PathGraph(n: int): Graph:
mut g := New(n, false)
mut i := 0
until i < n - 1:
g.add_edge(i, i + 1)
i += 1
end
ret g
end
@en "CycleGraph"
@fa "گراف دور"
pub func CycleGraph(n: int): Graph:
mut g := PathGraph(n)
if n > 2: g.add_edge(n - 1, 0) end
ret g
end
@en "StarGraph"
@fa "گراف ستاره"
pub func StarGraph(n: int): Graph:
mut g := New(n, false)
mut i := 1
until i < n:
g.add_edge(0, i)
i += 1
end
ret g
end
@en "WheelGraph"
@fa "گراف چرخ"
pub func WheelGraph(n: int): Graph:
if n < 4: ret CycleGraph(n) end
mut g := New(n, false)
mut i := 1
until i < n - 1:
g.add_edge(i, i + 1)
i += 1
end
g.add_edge(n - 1, 1)
mut j := 1
until j < n:
g.add_edge(0, j)
j += 1
end
ret g
end
@en "GridGraph"
@fa "گراف شبکه"
pub func GridGraph(rows: int, cols: int): Graph:
mut g := New(rows * cols, false)
repeat rows in r:
repeat cols in c:
if c + 1 < cols: g.add_edge(_grid_index(r, c, cols), _grid_index(r, c + 1, cols)) end
if r + 1 < rows: g.add_edge(_grid_index(r, c, cols), _grid_index(r + 1, c, cols)) end
end
end
ret g
end
@en "HypercubeGraph"
@fa "گراف مکعبی"
pub func HypercubeGraph(d: int): Graph:
n := 1 << d
mut g := New(n, false)
repeat n in u:
repeat d in b:
v := _hypercube_bit(u, b)
if v > u: g.add_edge(u, v) end
end
end
ret g
end
@en "PetersenGraph"
@fa "گراف پترسن"
pub func PetersenGraph(): Graph:
mut g := New(10, false)
repeat 5 in i:
g.add_edge(i, (i + 1) % 5)
g.add_edge(i, i + 5)
g.add_edge(5 + i, 5 + (i + 2) % 5)
end
ret g
end
@en "CirculantGraph"
@fa "گراف دوری"
pub func CirculantGraph(n: int, offsets: Vector<int>): Graph:
mut g := New(n, false)
mut seen := HashMap {} as HashMap<i64, bool>
defer seen.free()
repeat n in u:
repeat offsets.len() in k:
_circ_link(g, seen, u, offsets.get(k), n)
end
end
ret g
end
@en "BalancedTree"
@fa "درخت متوازن"
pub func BalancedTree(branch: int, depth: int): Graph:
n := _tree_size(branch, depth)
mut g := New(n, false)
mut i := 1
until i < n:
g.add_edge((i - 1) / branch, i)
i += 1
end
ret g
end
@en "ErdosRenyi"
@fa "اردوش رنی"
pub func ErdosRenyi(n: int, p: f64): Graph:
mut g := New(n, false)
repeat n in u:
mut v := u + 1
until v < n:
if rand.Float() < p: g.add_edge(u, v) end
v += 1
end
end
ret g
end
@en "RandomGraph"
@fa "گراف تصادفی"
pub func RandomGraph(n: int, m: int): Graph:
mut g := New(n, false)
mut seen := HashMap {} as HashMap<i64, bool>
defer seen.free()
mut added := 0
mut guard := 0
until added < m:
if guard > 100 * m + 1000: break end
guard += 1
if _random_edge(g, seen, n): added += 1 end
end
ret g
end
@en "RandomTree"
@fa "درخت تصادفی"
pub func RandomTree(n: int): Graph:
if n < 2: ret New(n, false) end
mut code := Vector {} as Vector<int>
defer code.free()
repeat n - 2: code.push(rand.IntN(n as i64) as int) end
ret PruferDecode(code)
end
@en "BarabasiAlbert"
@fa "باراباشی آلبرت"
pub func BarabasiAlbert(n: int, m: int): Graph:
if n <= m: ret CompleteGraph(n) end
mut g := CompleteGraph(m + 1)
mut pool := Vector {} as Vector<int>
defer pool.free()
_seed_pool(g, pool)
mut picked := Vector {} as Vector<int>
defer picked.free()
mut v := m + 1
until v < n:
_ba_targets(pool, m, picked)
_ba_attach(g, pool, picked, v)
v += 1
end
ret g
end
@en "WattsStrogatz"
@fa "واتس استروگاتز"
pub func WattsStrogatz(n: int, k: int, p: f64): Graph:
mut ring := New(n, false)
half := k / 2
repeat n in u:
mut d := 1
until d <= half:
ring.add_edge(u, (u + d) % n)
d += 1
end
end
g := _rewire(ring, p, n)
defer ring.free()
ret g
end
package graph
import str
import conv
func _label(g &: Graph, u: int): str:
s := g.name(u)
if str.Len(s) > 0: ret s end
ret conv.FormatInt(u as i64)
end
func _quote(s: str): str: ret "\"" + s + "\"" end
func _weight_text(w: f64): str: ret conv.FormatFloat(w) end
func _arrow(g &: Graph): str:
if g.directed: ret " -> " end
ret " -- "
end
func _is_blank(line: str): bool:
t := str.Trim(line)
if str.Len(t) == 0: ret true end
ret str.StartsWith(t, "#")
end
func _parse_line(g &: Graph, line: str):
if _is_blank(line): ret end
mut parts := str.Fields(str.Trim(line))
defer parts.free()
if parts.len() < 2: ret end
u := str.ToInt(parts.get(0)) as int
v := str.ToInt(parts.get(1)) as int
if parts.len() >= 3: g.add_weighted(u, v, str.ToFloat(parts.get(2)))
else:
g.add_edge(u, v)
end
end
func _max_node(text: str): int:
mut best := 0
mut lines := str.Split(text, "\n")
defer lines.free()
repeat lines.len() in i:
if _is_blank(lines.get(i)) == false:
mut parts := str.Fields(str.Trim(lines.get(i)))
repeat parts.len() in k:
if k < 2:
v := str.ToInt(parts.get(k)) as int
if v > best: best = v end
end
end
parts.free()
end
end
ret best
end
func _json_links(g &: Graph): str:
mut out := ""
repeat g.size() in e:
if e > 0: out = out + "," end
out = out + "{\"source\":" + conv.FormatInt(g.edge_from(e) as i64)
out = out + ",\"target\":" + conv.FormatInt(g.edge_to(e) as i64)
out = out + ",\"weight\":" + _weight_text(g.edge_weight(e)) + "}"
end
ret out
end
@en "ToEdgeList"
@fa "به فهرست یال"
pub func ToEdgeList(g &: Graph): str:
mut out := ""
repeat g.size() in e:
out = out + conv.FormatInt(g.edge_from(e) as i64) + " " + conv.FormatInt(g.edge_to(e) as i64)
out = out + " " + _weight_text(g.edge_weight(e)) + "\n"
end
ret out
end
@en "FromEdgeList"
@fa "از فهرست یال"
pub func FromEdgeList(text: str, n: int, directed: bool): Graph:
mut want := _max_node(text) + 1
if n > want: want = n end
mut g := New(want, directed)
mut lines := str.Split(text, "\n")
defer lines.free()
repeat lines.len() in i: _parse_line(g, lines.get(i)) end
ret g
end
@en "ToAdjacencyList"
@fa "به فهرست مجاورت"
pub func ToAdjacencyList(g &: Graph): str:
mut out := ""
repeat g.n in u:
out = out + _label(g, u) + ":"
mut k := g.adj_start(u)
stop := g.adj_stop(u)
until k < stop:
out = out + " " + _label(g, g.adj_node(k))
k += 1
end
out = out + "\n"
end
ret out
end
@en "ToMatrixText"
@fa "به متن ماتریس"
pub func ToMatrixText(g &: Graph): str:
mut a := AdjacencyMatrix(g)
mut out := ""
repeat g.n in i:
repeat g.n in j:
if j > 0: out = out + " " end
out = out + conv.FormatInt(a.at(i, j) as i64)
end
out = out + "\n"
end
defer a.free()
ret out
end
@en "ToDot"
@fa "به دات"
pub func ToDot(g &: Graph): str:
mut out := "graph G {\n"
if g.directed: out = "digraph G {\n" end
repeat g.n in u:
out = out + "  " + _quote(_label(g, u)) + ";\n"
end
repeat g.size() in e:
out = out + "  " + _quote(_label(g, g.edge_from(e))) + _arrow(g) + _quote(_label(g, g.edge_to(e)))
if IsClose(g.edge_weight(e), 1.0) == false:
out = out + " [label=" + _quote(_weight_text(g.edge_weight(e))) + "]"
end
out = out + ";\n"
end
ret out + "}\n"
end
@en "ToMermaid"
@fa "به مرمید"
pub func ToMermaid(g &: Graph): str:
mut out := "graph LR\n"
mut link := " --- "
if g.directed: link = " --> " end
repeat g.size() in e:
out = out + "  " + _label(g, g.edge_from(e)) + link + _label(g, g.edge_to(e)) + "\n"
end
ret out
end
@en "ToJSON"
@fa "به جیسون"
pub func ToJSON(g &: Graph): str:
mut out := "{\"directed\":"
if g.directed: out = out + "true"
else:
out = out + "false"
end
out = out + ",\"nodes\":["
repeat g.n in u:
if u > 0: out = out + "," end
out = out + "{\"id\":" + conv.FormatInt(u as i64) + ",\"name\":" + _quote(_label(g, u)) + "}"
end
out = out + "],\"links\":["
out = out + _json_links(g)
ret out + "]}"
end
@en "Describe"
@fa "توصیف"
pub func Describe(g &: Graph): str:
mut out := "n=" + conv.FormatInt(g.n as i64) + " m=" + conv.FormatInt(g.size() as i64)
if g.directed: out = out + " directed"
else:
out = out + " undirected"
end
out = out + " components=" + conv.FormatInt(ComponentCount(g) as i64)
if IsSimple(g): out = out + " simple" end
if Bipartite(g): out = out + " bipartite" end
if IsTree(g): out = out + " tree" end
if g.directed:
if IsDAG(g): out = out + " dag" end
end
ret out
end
package graph
func _iso_invariants_match(a &: Graph, b &: Graph): bool:
if a.n != b.n: ret false end
if a.size() != b.size(): ret false end
mut da := DegreeSequence(a)
defer da.free()
mut db := DegreeSequence(b)
defer db.free()
repeat da.len() in i:
if da.get(i) != db.get(i): ret false end
end
ret TriangleCount(a) == TriangleCount(b)
end
func _iso_adj(g &: Graph): HashMap<i64, bool>:
mut s := HashMap {} as HashMap<i64, bool>
repeat g.size() in e:
u := g.edge_from(e)
v := g.edge_to(e)
s.put((u as i64) * (g.n as i64) + (v as i64), true)
s.put((v as i64) * (g.n as i64) + (u as i64), true)
end
ret s
end
func _linked(adj &: HashMap<i64, bool>, n: int, u: int, v: int): bool:
ret adj.has((u as i64) * (n as i64) + (v as i64))
end
func _iso_extend(a &: Graph, b &: Graph, adja &: HashMap<i64, bool>, adjb &: HashMap<i64, bool>, map &: Vector<int>, used &: Vector<bool>, u: int): bool:
if u >= a.n: ret true end
repeat b.n in v:
if used.get(v) == false:
if a.degree(u) == b.degree(v):
if _iso_consistent(a, b, adja, adjb, map, u, v):
map.set(u, v)
used.set(v, true)
if _iso_extend(a, b, adja, adjb, map, used, u + 1): ret true end
map.set(u, GRAPH_NONE)
used.set(v, false)
end
end
end
end
ret false
end
func _iso_consistent(a &: Graph, b &: Graph, adja &: HashMap<i64, bool>, adjb &: HashMap<i64, bool>, map: Vector<int>, u: int, v: int): bool:
repeat u in w:
img := map.get(w)
if _linked(adja, a.n, u, w) != _linked(adjb, b.n, v, img): ret false end
end
ret true
end
func _count_maps(g &: Graph, adj &: HashMap<i64, bool>, map &: Vector<int>, used &: Vector<bool>, u: int): int:
if u >= g.n: ret 1 end
mut total := 0
repeat g.n in v:
if used.get(v) == false:
if g.degree(u) == g.degree(v):
if _iso_consistent(g, g, adj, adj, map, u, v):
map.set(u, v)
used.set(v, true)
total += _count_maps(g, adj, map, used, u + 1)
map.set(u, GRAPH_NONE)
used.set(v, false)
end
end
end
end
ret total
end
func _sorted_copy(seq: Vector<int>): Vector<int>:
mut out := Vector {} as Vector<int>
repeat seq.len() in i: out.push(seq.get(i)) end
mut i := 1
until i < out.len():
x := out.get(i)
mut j := i - 1
until j >= 0:
if out.get(j) >= x: break end
out.set(j + 1, out.get(j))
j = j - 1
end
out.set(j + 1, x)
i += 1
end
ret out
end
func _erdos_gallai(d: Vector<int>, n: int): bool:
mut k := 1
until k <= n:
mut lhs := 0
repeat k in i: lhs += d.get(i) end
mut rhs := k * (k - 1)
mut j := k
until j < n:
mut t := d.get(j)
if t > k: t = k end
rhs += t
j += 1
end
if lhs > rhs: ret false end
k += 1
end
ret true
end
func _largest_left(left: Vector<int>, n: int): int:
mut best := GRAPH_NONE
repeat n in i:
if left.get(i) > 0:
if best == GRAPH_NONE: best = i
else left.get(i) > left.get(best): best = i
end
end
end
ret best
end
func _hh_connect(g &: Graph, left &: Vector<int>, u: int, n: int):
need := left.get(u)
left.set(u, 0)
repeat need:
v := _largest_left(left, n)
if v == GRAPH_NONE: ret end
g.add_edge(u, v)
left.set(v, left.get(v) - 1)
end
end
@en "Isomorphic"
@fa "یکریخت"
pub func Isomorphic(a &: Graph, b &: Graph): bool:
if _iso_invariants_match(a, b) == false: ret false end
if a.n == 0: ret true end
mut adja := _iso_adj(a)
defer adja.free()
mut adjb := _iso_adj(b)
defer adjb.free()
mut map := Vector {} as Vector<int>
defer map.free()
mut used := Vector {} as Vector<bool>
defer used.free()
FillInt(map, a.n, GRAPH_NONE)
FillBool(used, b.n, false)
ret _iso_extend(a, b, adja, adjb, map, used, 0)
end
@en "IsomorphismMap"
@fa "نگاشت یکریختی"
pub func IsomorphismMap(a &: Graph, b &: Graph, map &: Vector<int>): bool:
FillInt(map, a.n, GRAPH_NONE)
if _iso_invariants_match(a, b) == false: ret false end
mut adja := _iso_adj(a)
defer adja.free()
mut adjb := _iso_adj(b)
defer adjb.free()
mut used := Vector {} as Vector<bool>
defer used.free()
FillBool(used, b.n, false)
ret _iso_extend(a, b, adja, adjb, map, used, 0)
end
@en "AutomorphismCount"
@fa "شمار خودریختی"
pub func AutomorphismCount(g &: Graph): int:
if g.n == 0: ret 1 end
mut adj := _iso_adj(g)
defer adj.free()
mut map := Vector {} as Vector<int>
defer map.free()
mut used := Vector {} as Vector<bool>
defer used.free()
FillInt(map, g.n, GRAPH_NONE)
FillBool(used, g.n, false)
ret _count_maps(g, adj, map, used, 0)
end
@en "IsGraphical"
@fa "گرافیک است"
pub func IsGraphical(seq: Vector<int>): bool:
mut d := _sorted_copy(seq)
defer d.free()
n := d.len()
mut total := 0
repeat n in i:
if d.get(i) < 0: ret false end
if d.get(i) > n - 1: ret false end
total += d.get(i)
end
if total % 2 == 1: ret false end
ret _erdos_gallai(d, n)
end
@en "HavelHakimi"
@fa "هاول حکیمی"
pub func HavelHakimi(seq: Vector<int>): Graph:
n := seq.len()
mut g := New(n, false)
if IsGraphical(seq) == false: ret g end
mut left := Vector {} as Vector<int>
defer left.free()
repeat n in i: left.push(seq.get(i)) end
repeat n:
u := _largest_left(left, n)
if u == GRAPH_NONE: break end
_hh_connect(g, left, u, n)
end
ret g
end
@en "SameDegreeSequence"
@fa "دنباله درجه یکسان"
pub func SameDegreeSequence(a &: Graph, b &: Graph): bool:
if a.n != b.n: ret false end
mut da := DegreeSequence(a)
defer da.free()
mut db := DegreeSequence(b)
defer db.free()
repeat da.len() in i:
if da.get(i) != db.get(i): ret false end
end
ret true
end
package graph
import math
@en "Matrix"
@fa "ماتریس"
pub struct Matrix:
pub rows: int = 0
pub cols: int = 0
pub a: Vector<f64> = Vector {}
@en "at"
@fa "عنصر"
pub func at(i: int, j: int): f64: ret this.a.get(i * this.cols + j) end
@en "set"
@fa "تنظیم"
pub func set(i: int, j: int, v: f64): this.a.set(i * this.cols + j, v) end
@en "add_at"
@fa "افزودن در"
pub func add_at(i: int, j: int, v: f64):
this.a.set(i * this.cols + j, this.a.get(i * this.cols + j) + v)
end
@en "trace"
@fa "رد"
pub func trace(): f64:
mut s := 0.0
mut n := this.rows
if this.cols < n: n = this.cols end
repeat n in i: s += this.at(i, i) end
ret s
end
@en "row_sum"
@fa "مجموع سطر"
pub func row_sum(i: int): f64:
mut s := 0.0
repeat this.cols in j: s += this.at(i, j) end
ret s
end
@en "free"
@fa "آزادسازی"
pub func free(): this.a.free() end
end
@en "IntMatrix"
@fa "ماتریس صحیح"
pub struct IntMatrix:
pub rows: int = 0
pub cols: int = 0
pub a: Vector<int> = Vector {}
@en "at"
@fa "عنصر"
pub func at(i: int, j: int): int: ret this.a.get(i * this.cols + j) end
@en "set"
@fa "تنظیم"
pub func set(i: int, j: int, v: int): this.a.set(i * this.cols + j, v) end
@en "free"
@fa "آزادسازی"
pub func free(): this.a.free() end
end
func _matrix_copy(x &: Matrix): Matrix:
mut r := NewMatrix(x.rows, x.cols)
repeat x.rows * x.cols in i: r.a.set(i, x.a.get(i)) end
ret r
end
func _fill_weights(g &: Graph, m &: Matrix):
repeat g.size() in e:
u := g.edge_from(e)
v := g.edge_to(e)
w := g.edge_weight(e)
if w < m.at(u, v): m.set(u, v, w) end
if g.directed == false:
if w < m.at(v, u): m.set(v, u, w) end
end
end
end
func _fill_normalized(g &: Graph, a &: Matrix, m &: Matrix):
repeat g.n in i:
di := g.degree(i) as f64
repeat g.n in j:
dj := g.degree(j) as f64
if di > 0.0:
if i == j: m.set(i, j, 1.0)
else dj > 0.0: m.set(i, j, (0.0 - a.at(i, j)) / math.Sqrt(di * dj))
end
end
end
end
end
func _pivot(m &: Matrix, c: int, n: int): int:
mut best := GRAPH_NONE
mut bv := 0.000000001
mut r := c
until r < n:
v := math.Abs(m.at(r, c))
if v > bv:
bv = v
best = r
end
r += 1
end
ret best
end
func _swap_rows(m &: Matrix, i: int, j: int, n: int):
repeat n in c:
t := m.at(i, c)
m.set(i, c, m.at(j, c))
m.set(j, c, t)
end
end
func _eliminate(m &: Matrix, c: int, n: int):
mut r := c + 1
until r < n:
f := m.at(r, c) / m.at(c, c)
if f != 0.0:
mut j := c
until j < n:
m.set(r, j, m.at(r, j) - f * m.at(c, j))
j += 1
end
end
r += 1
end
end
func _off_diagonal(m &: Matrix, n: int): f64:
mut s := 0.0
repeat n in i:
repeat n in j:
if i != j: s += m.at(i, j) * m.at(i, j) end
end
end
ret s
end
func _jacobi_rotate(m &: Matrix, n: int, p: int, q: int):
apq := m.at(p, q)
if math.Abs(apq) < 1.0e-290: ret end
theta := (m.at(q, q) - m.at(p, p)) / (2.0 * apq)
mut t := 1.0 / (math.Abs(theta) + math.Sqrt(theta * theta + 1.0))
if theta < 0.0: t = 0.0 - t end
c := 1.0 / math.Sqrt(t * t + 1.0)
s := t * c
_apply_rotation(m, n, p, q, c, s)
end
func _apply_rotation(m &: Matrix, n: int, p: int, q: int, c: f64, s: f64):
repeat n in k:
akp := m.at(k, p)
akq := m.at(k, q)
m.set(k, p, c * akp - s * akq)
m.set(k, q, s * akp + c * akq)
end
repeat n in k:
apk := m.at(p, k)
aqk := m.at(q, k)
m.set(p, k, c * apk - s * aqk)
m.set(q, k, s * apk + c * aqk)
end
end
func _jacobi_sweep(m &: Matrix, n: int):
mut p := 0
until p < n - 1:
mut q := p + 1
until q < n:
_jacobi_rotate(m, n, p, q)
q += 1
end
p += 1
end
end
func _sort_floats(v &: Vector<f64>):
mut i := 1
until i < v.len():
x := v.get(i)
mut j := i - 1
until j >= 0:
if v.get(j) <= x: break end
v.set(j + 1, v.get(j))
j = j - 1
end
v.set(j + 1, x)
i += 1
end
end
@en "NewMatrix"
@fa "ماتریس جدید"
pub func NewMatrix(rows: int, cols: int): Matrix:
mut m := Matrix {}
m.rows = rows
m.cols = cols
FillFloat(m.a, rows * cols, 0.0)
ret m
end
@en "NewIntMatrix"
@fa "ماتریس صحیح جدید"
pub func NewIntMatrix(rows: int, cols: int, fill: int): IntMatrix:
mut m := IntMatrix {}
m.rows = rows
m.cols = cols
FillInt(m.a, rows * cols, fill)
ret m
end
@en "AdjacencyMatrix"
@fa "ماتریس مجاورت"
pub func AdjacencyMatrix(g &: Graph): Matrix:
mut m := NewMatrix(g.n, g.n)
repeat g.size() in e:
u := g.edge_from(e)
v := g.edge_to(e)
m.add_at(u, v, 1.0)
if g.directed == false:
m.add_at(v, u, 1.0)
end
end
ret m
end
@en "WeightMatrix"
@fa "ماتریس وزن"
pub func WeightMatrix(g &: Graph): Matrix:
mut m := NewMatrix(g.n, g.n)
repeat g.n in i:
repeat g.n in j:
if i == j: m.set(i, j, 0.0)
else:
m.set(i, j, GRAPH_INF)
end
end
end
_fill_weights(g, m)
ret m
end
@en "DegreeMatrix"
@fa "ماتریس درجه"
pub func DegreeMatrix(g &: Graph): Matrix:
mut m := NewMatrix(g.n, g.n)
repeat g.n in u: m.set(u, u, g.degree(u) as f64) end
ret m
end
@en "LaplacianMatrix"
@fa "ماتریس لاپلاس"
pub func LaplacianMatrix(g &: Graph): Matrix:
mut a := AdjacencyMatrix(g)
mut m := NewMatrix(g.n, g.n)
repeat g.n in i:
repeat g.n in j:
if i == j: m.set(i, j, a.row_sum(i) - a.at(i, i))
else:
m.set(i, j, 0.0 - a.at(i, j))
end
end
end
defer a.free()
ret m
end
@en "NormalizedLaplacian"
@fa "لاپلاس بهنجار"
pub func NormalizedLaplacian(g &: Graph): Matrix:
mut a := AdjacencyMatrix(g)
mut m := NewMatrix(g.n, g.n)
_fill_normalized(g, a, m)
defer a.free()
ret m
end
@en "IncidenceMatrix"
@fa "ماتریس وقوع"
pub func IncidenceMatrix(g &: Graph): Matrix:
m := g.size()
mut r := NewMatrix(g.n, m)
repeat m in e:
u := g.edge_from(e)
v := g.edge_to(e)
if g.directed:
r.add_at(u, e, 0.0 - 1.0)
r.add_at(v, e, 1.0)
else:
r.add_at(u, e, 1.0)
r.add_at(v, e, 1.0)
end
end
ret r
end
@en "MatrixMultiply"
@fa "ضرب ماتریس"
pub func MatrixMultiply(x &: Matrix, y &: Matrix): Matrix:
mut r := NewMatrix(x.rows, y.cols)
repeat x.rows in i:
repeat x.cols in k:
v := x.at(i, k)
if v != 0.0:
repeat y.cols in j: r.add_at(i, j, v * y.at(k, j)) end
end
end
end
ret r
end
@en "MatrixIdentity"
@fa "ماتریس همانی"
pub func MatrixIdentity(n: int): Matrix:
mut r := NewMatrix(n, n)
repeat n in i: r.set(i, i, 1.0) end
ret r
end
@en "MatrixPower"
@fa "توان ماتریس"
pub func MatrixPower(x &: Matrix, k: int): Matrix:
mut result := MatrixIdentity(x.rows)
mut base := _matrix_copy(x)
mut e := k
until e > 0:
if e % 2 == 1:
t := MatrixMultiply(result, base)
result.free()
result = t
end
e = e / 2
if e > 0:
s := MatrixMultiply(base, base)
base.free()
base = s
end
end
defer base.free()
ret result
end
@en "WalkCount"
@fa "شمار گشت"
pub func WalkCount(g &: Graph, k: int, u: int, v: int): f64:
mut a := AdjacencyMatrix(g)
mut p := MatrixPower(a, k)
r := p.at(u, v)
defer p.free()
defer a.free()
ret r
end
package graph
import math
func _pair_key(n: int, u: int, v: int): i64: ret (u as i64) * (n as i64) + (v as i64) end
func _sort_desc(v &: Vector<int>):
mut i := 1
until i < v.len():
x := v.get(i)
mut j := i - 1
until j >= 0:
if v.get(j) >= x: break end
v.set(j + 1, v.get(j))
j = j - 1
end
v.set(j + 1, x)
i += 1
end
end
func _adjacency_set(g &: Graph): HashMap<i64, bool>:
mut s := HashMap {} as HashMap<i64, bool>
repeat g.size() in e:
u := g.edge_from(e)
v := g.edge_to(e)
if u != v:
s.put(_pair_key(g.n, u, v), true)
s.put(_pair_key(g.n, v, u), true)
end
end
ret s
end
func _distinct_neighbors(g &: Graph, u: int, out &: Vector<int>):
out.clear()
mut seen := HashMap {} as HashMap<i64, bool>
mut k := g.adj_start(u)
stop := g.adj_stop(u)
until k < stop:
v := g.adj_node(k)
if v != u:
if seen.has(v as i64) == false:
seen.put(v as i64, true)
out.push(v)
end
end
k += 1
end
defer seen.free()
end
func _links_among(adj &: HashMap<i64, bool>, nb: Vector<int>, n: int): int:
mut links := 0
repeat nb.len() in i:
repeat nb.len() in j:
if i < j:
if adj.has(_pair_key(n, nb.get(i), nb.get(j))): links += 1 end
end
end
end
ret links
end
func _girth_from(g &: Graph, s: int, dist &: Vector<int>, via &: Vector<int>, best: int): int:
FillInt(dist, g.n, GRAPH_NONE)
FillInt(via, g.n, GRAPH_NONE)
mut q := Vector {} as Vector<int>
defer q.free()
mut found := best
dist.set(s, 0)
q.push(s)
mut head := 0
until head < q.len():
u := q.get(head)
head += 1
if 2 * dist.get(u) < found: found = _girth_scan(g, u, dist, via, q, found) end
end
ret found
end
func _girth_scan(g &: Graph, u: int, dist &: Vector<int>, via &: Vector<int>, q &: Vector<int>, best: int): int:
mut found := best
mut k := g.adj_start(u)
stop := g.adj_stop(u)
until k < stop:
v := g.adj_node(k)
e := g.adj_edge(k)
if e != via.get(u):
if dist.get(v) == GRAPH_NONE:
dist.set(v, dist.get(u) + 1)
via.set(v, e)
q.push(v)
else:
c := dist.get(u) + dist.get(v) + 1
if c < found: found = c end
end
end
k += 1
end
ret found
end
@en "Density"
@fa "چگالی"
pub func Density(g &: Graph): f64:
if g.n < 2: ret 0.0 end
m := g.size() as f64
n := g.n as f64
if g.directed: ret m / (n * (n - 1.0)) end
ret 2.0 * m / (n * (n - 1.0))
end
@en "AverageDegree"
@fa "میانگین درجه"
pub func AverageDegree(g &: Graph): f64:
if g.n == 0: ret 0.0 end
mut s := 0
repeat g.n in u: s += g.degree(u) end
ret (s as f64) / (g.n as f64)
end
@en "MaxDegree"
@fa "بیشینه درجه"
pub func MaxDegree(g &: Graph): int:
mut b := 0
repeat g.n in u:
if g.degree(u) > b: b = g.degree(u) end
end
ret b
end
@en "MinDegree"
@fa "کمینه درجه"
pub func MinDegree(g &: Graph): int:
if g.n == 0: ret 0 end
mut b := g.degree(0)
repeat g.n in u:
if g.degree(u) < b: b = g.degree(u) end
end
ret b
end
@en "DegreeSequence"
@fa "دنباله درجه"
pub func DegreeSequence(g &: Graph): Vector<int>:
mut out := Vector {} as Vector<int>
repeat g.n in u: out.push(g.degree(u)) end
_sort_desc(out)
ret out
end
@en "DegreeHistogram"
@fa "بافت‌نگار درجه"
pub func DegreeHistogram(g &: Graph): Vector<int>:
mut out := Vector {} as Vector<int>
FillInt(out, MaxDegree(g) + 1, 0)
repeat g.n in u:
d := g.degree(u)
out.set(d, out.get(d) + 1)
end
ret out
end
@en "IsRegular"
@fa "منتظم است"
pub func IsRegular(g &: Graph): bool:
if g.n == 0: ret true end
ret MinDegree(g) == MaxDegree(g)
end
@en "IsComplete"
@fa "کامل است"
pub func IsComplete(g &: Graph): bool:
mut s := Simplify(g)
mut want := g.n * (g.n - 1) / 2
got := s.size()
if g.directed: want = g.n * (g.n - 1) end
defer s.free()
ret got == want
end
@en "Eccentricity"
@fa "برون‌مرکزی"
pub func Eccentricity(g &: Graph, u: int): int:
mut d := BFS(g, u)
defer d.free()
mut best := GRAPH_NONE
repeat g.n in v:
if d.get(v) > best: best = d.get(v) end
end
ret best
end
@en "EccentricityAll"
@fa "همه برون‌مرکزی‌ها"
pub func EccentricityAll(g &: Graph): Vector<int>:
mut out := Vector {} as Vector<int>
repeat g.n in u: out.push(Eccentricity(g, u)) end
ret out
end
@en "Diameter"
@fa "قطر"
pub func Diameter(g &: Graph): int:
mut e := EccentricityAll(g)
defer e.free()
ret MaxInt(e)
end
@en "Radius"
@fa "شعاع"
pub func Radius(g &: Graph): int:
mut e := EccentricityAll(g)
defer e.free()
mut best := GRAPH_NONE
repeat e.len() in u:
if e.get(u) != GRAPH_NONE:
if best == GRAPH_NONE: best = e.get(u)
else e.get(u) < best: best = e.get(u)
end
end
end
ret best
end
@en "Center"
@fa "مرکز"
pub func Center(g &: Graph): Vector<int>:
mut e := EccentricityAll(g)
defer e.free()
r := Radius(g)
mut out := Vector {} as Vector<int>
repeat e.len() in u:
if e.get(u) == r: out.push(u) end
end
ret out
end
@en "Periphery"
@fa "پیرامون"
pub func Periphery(g &: Graph): Vector<int>:
mut e := EccentricityAll(g)
defer e.free()
d := Diameter(g)
mut out := Vector {} as Vector<int>
repeat e.len() in u:
if e.get(u) == d: out.push(u) end
end
ret out
end
@en "AveragePathLength"
@fa "میانگین طول مسیر"
pub func AveragePathLength(g &: Graph): f64:
mut total := 0.0
mut pairs := 0.0
mut d := Vector {} as Vector<int>
defer d.free()
mut p := Vector {} as Vector<int>
defer p.free()
repeat g.n in s:
BFSFrom(g, s, d, p)
repeat g.n in t:
if t != s:
if d.get(t) != GRAPH_NONE:
total += d.get(t) as f64
pairs += 1.0
end
end
end
end
if pairs == 0.0: ret 0.0 end
ret total / pairs
end
@en "WienerIndex"
@fa "شاخص وینر"
pub func WienerIndex(g &: Graph): f64:
mut total := 0.0
mut d := Vector {} as Vector<int>
defer d.free()
mut p := Vector {} as Vector<int>
defer p.free()
repeat g.n in s:
BFSFrom(g, s, d, p)
repeat g.n in t:
if t != s:
if d.get(t) != GRAPH_NONE: total += d.get(t) as f64 end
end
end
end
if g.directed: ret total end
ret total / 2.0
end
@en "Girth"
@fa "کمر"
pub func Girth(g &: Graph): int:
cap := g.n + 2
mut best := cap
repeat g.size() in e:
if g.edge_from(e) == g.edge_to(e): ret 1 end
end
mut dist := Vector {} as Vector<int>
defer dist.free()
mut via := Vector {} as Vector<int>
defer via.free()
repeat g.n in s: best = _girth_from(g, s, dist, via, best) end
if best >= cap: ret GRAPH_NONE end
ret best
end
package graph
func _sorted_edges(g &: Graph, order &: Vector<int>, sign: f64):
mut h := MinHeap {}
repeat g.size() in e: h.push(sign * g.edge_weight(e), e) end
order.clear()
until h.is_empty() == false: order.push(h.pop()) end
defer h.free()
end
func _kruskal_run(g &: Graph, chosen &: Vector<int>, sign: f64): f64:
mut order := Vector {} as Vector<int>
defer order.free()
_sorted_edges(g, order, sign)
mut ds := NewDisjointSet(g.n)
defer ds.free()
chosen.clear()
mut total := 0.0
repeat order.len() in i:
e := order.get(i)
if ds.union(g.edge_from(e), g.edge_to(e)):
chosen.push(e)
total += g.edge_weight(e)
end
end
ret total
end
func _prim_scan(g &: Graph, u: int, inside &: Vector<bool>, best &: Vector<f64>, parent &: Vector<int>, h &: MinHeap):
mut k := g.adj_start(u)
stop := g.adj_stop(u)
until k < stop:
v := g.adj_node(k)
w := g.adj_weight(k)
if inside.get(v) == false:
if w < best.get(v):
best.set(v, w)
parent.set(v, u)
h.push(w, v)
end
end
k += 1
end
end
func _prim_run(g &: Graph, root: int, parent &: Vector<int>): f64:
mut inside := Vector {} as Vector<bool>
defer inside.free()
mut best := Vector {} as Vector<f64>
defer best.free()
FillBool(inside, g.n, false)
FillFloat(best, g.n, GRAPH_INF)
FillInt(parent, g.n, GRAPH_NONE)
if g.n == 0: ret 0.0 end
mut h := MinHeap {}
defer h.free()
mut total := 0.0
best.set(root, 0.0)
h.push(0.0, root)
until h.is_empty() == false:
u := h.pop()
if inside.get(u) == false:
inside.set(u, true)
total += best.get(u)
_prim_scan(g, u, inside, best, parent, h)
end
end
ret total
end
func _boruvka_round(g &: Graph, ds &: DisjointSet, pick &: Vector<int>):
FillInt(pick, g.n, GRAPH_NONE)
repeat g.size() in e:
a := ds.find(g.edge_from(e))
b := ds.find(g.edge_to(e))
if a != b:
_boruvka_offer(g, pick, a, e)
_boruvka_offer(g, pick, b, e)
end
end
end
func _boruvka_offer(g &: Graph, pick &: Vector<int>, comp: int, e: int):
cur := pick.get(comp)
if cur == GRAPH_NONE:
pick.set(comp, e)
ret
end
if g.edge_weight(e) < g.edge_weight(cur):
pick.set(comp, e)
ret
end
if g.edge_weight(e) == g.edge_weight(cur):
if e < cur: pick.set(comp, e) end
end
end
@en "Kruskal"
@fa "کروسکال"
pub func Kruskal(g &: Graph, chosen &: Vector<int>): f64:
ret _kruskal_run(g, chosen, 1.0)
end
@en "MaximumSpanningTree"
@fa "درخت پوشای بیشینه"
pub func MaximumSpanningTree(g &: Graph, chosen &: Vector<int>): f64:
ret _kruskal_run(g, chosen, 0.0 - 1.0)
end
@en "Prim"
@fa "پریم"
pub func Prim(g &: Graph, root: int, parent &: Vector<int>): f64:
if g.directed == false: ret _prim_run(g, root, parent) end
mut u := ToUndirected(g)
t := _prim_run(u, root, parent)
defer u.free()
ret t
end
@en "Boruvka"
@fa "بوروفکا"
pub func Boruvka(g &: Graph, chosen &: Vector<int>): f64:
chosen.clear()
mut ds := NewDisjointSet(g.n)
defer ds.free()
mut pick := Vector {} as Vector<int>
defer pick.free()
mut total := 0.0
mut progress := true
until progress:
progress = false
_boruvka_round(g, ds, pick)
repeat g.n in c:
e := pick.get(c)
if e != GRAPH_NONE:
if ds.union(g.edge_from(e), g.edge_to(e)):
chosen.push(e)
total += g.edge_weight(e)
progress = true
end
end
end
end
ret total
end
@en "MSTWeight"
@fa "وزن درخت پوشا"
pub func MSTWeight(g &: Graph): f64:
mut chosen := Vector {} as Vector<int>
defer chosen.free()
ret Kruskal(g, chosen)
end
@en "MinimumSpanningTree"
@fa "درخت پوشای کمینه"
pub func MinimumSpanningTree(g &: Graph): Graph:
mut chosen := Vector {} as Vector<int>
defer chosen.free()
Kruskal(g, chosen)
mut h := New(g.n, false)
repeat chosen.len() in i:
e := chosen.get(i)
h.add_weighted(g.edge_from(e), g.edge_to(e), g.edge_weight(e))
end
ret h
end
@en "SpanningAgreement"
@fa "توافق پوشا"
pub func SpanningAgreement(g &: Graph): bool:
mut a := Vector {} as Vector<int>
defer a.free()
mut b := Vector {} as Vector<int>
defer b.free()
mut p := Vector {} as Vector<int>
defer p.free()
ka := Kruskal(g, a)
kb := Boruvka(g, b)
if IsClose(ka, kb) == false: ret false end
if IsConnected(g) == false: ret true end
pr := Prim(g, 0, p)
ret IsClose(ka, pr)
end
package graph
import str
func _key(n: int, u: int, v: int): i64: ret (u as i64) * (n as i64) + (v as i64) end
func _kept(keep: Vector<bool>, i: int): bool:
if i >= keep.len(): ret false end
ret keep.get(i)
end
func _copy_names(src &: Graph, dst &: Graph, shift: int):
repeat src.names.len() in u:
s := src.name(u)
if str.Len(s) > 0: dst.set_name(u + shift, s) end
end
end
func _append_edges(src &: Graph, dst &: Graph, shift: int):
repeat src.size() in e:
dst.add_weighted(src.edge_from(e) + shift, src.edge_to(e) + shift, src.edge_weight(e))
end
end
func _fill_sub(g &: Graph, h &: Graph, map: Vector<int>):
repeat g.size() in e:
a := map.get(g.edge_from(e))
b := map.get(g.edge_to(e))
if a != GRAPH_NONE:
if b != GRAPH_NONE: h.add_weighted(a, b, g.edge_weight(e)) end
end
end
end
func _fill_complement(g &: Graph, h &: Graph, seen &: HashMap<i64, bool>):
repeat g.n in u:
repeat g.n in v:
if u != v:
if seen.has(_key(g.n, u, v)) == false:
if g.directed: h.add_edge(u, v)
else v > u: h.add_edge(u, v)
end
end
end
end
end
end
func _link_incident(g &: Graph, h &: Graph, seen &: HashMap<i64, bool>, u: int, m: int):
start := g.adj_start(u)
stop := g.adj_stop(u)
mut i := start
until i < stop:
mut j := i + 1
until j < stop:
a := g.adj_edge(i)
b := g.adj_edge(j)
if a != b:
mut lo := a
mut hi := b
if lo > hi:
lo = b
hi = a
end
k := _key(m, lo, hi)
if seen.has(k) == false:
seen.put(k, true)
h.add_edge(lo, hi)
end
end
j += 1
end
i += 1
end
end
func _collect_best(g &: Graph, best &: HashMap<i64, f64>, order &: Vector<i64>):
repeat g.size() in e:
u := g.edge_from(e)
v := g.edge_to(e)
if u != v:
mut a := u
mut b := v
if g.directed == false:
if a > b:
a = v
b = u
end
end
k := _key(g.n, a, b)
w := g.edge_weight(e)
if best.has(k):
if w < best.get(k): best.put(k, w) end
else:
best.put(k, w)
order.push(k)
end
end
end
end
@en "Clone"
@fa "همانندسازی"
pub func Clone(g &: Graph): Graph:
mut h := New(g.n, g.directed)
m := g.size()
repeat m in e:
h.add_weighted(g.edge_from(e), g.edge_to(e), g.edge_weight(e))
end
_copy_names(g, h, 0)
ret h
end
@en "Transpose"
@fa "ترانهاده"
pub func Transpose(g &: Graph): Graph:
mut h := New(g.n, g.directed)
m := g.size()
repeat m in e:
h.add_weighted(g.edge_to(e), g.edge_from(e), g.edge_weight(e))
end
_copy_names(g, h, 0)
ret h
end
@en "Reverse"
@fa "برعکس"
pub func Reverse(g &: Graph): Graph: ret Transpose(g) end
@en "ToUndirected"
@fa "به بی‌جهت"
pub func ToUndirected(g &: Graph): Graph:
mut h := New(g.n, false)
m := g.size()
repeat m in e:
h.add_weighted(g.edge_from(e), g.edge_to(e), g.edge_weight(e))
end
_copy_names(g, h, 0)
ret h
end
@en "ToDirected"
@fa "به جهت‌دار"
pub func ToDirected(g &: Graph): Graph:
mut h := New(g.n, true)
m := g.size()
repeat m in e:
u := g.edge_from(e)
v := g.edge_to(e)
w := g.edge_weight(e)
h.add_weighted(u, v, w)
if u != v: h.add_weighted(v, u, w) end
end
_copy_names(g, h, 0)
ret h
end
@en "SubgraphMap"
@fa "زیرگراف با نگاشت"
pub func SubgraphMap(g &: Graph, keep: Vector<bool>, map &: Vector<int>): Graph:
map.clear()
mut k := 0
repeat g.n in u:
if _kept(keep, u):
map.push(k)
k += 1
else:
map.push(GRAPH_NONE)
end
end
mut h := New(k, g.directed)
_fill_sub(g, h, map)
repeat g.n in u:
if map.get(u) != GRAPH_NONE: h.set_name(map.get(u), g.name(u)) end
end
ret h
end
@en "Subgraph"
@fa "زیرگراف"
pub func Subgraph(g &: Graph, keep: Vector<bool>): Graph:
mut map := Vector {} as Vector<int>
defer map.free()
ret SubgraphMap(g, keep, map)
end
@en "EdgeSubgraph"
@fa "زیرگراف یالی"
pub func EdgeSubgraph(g &: Graph, keep: Vector<bool>): Graph:
mut h := New(g.n, g.directed)
m := g.size()
repeat m in e:
if _kept(keep, e): h.add_weighted(g.edge_from(e), g.edge_to(e), g.edge_weight(e)) end
end
_copy_names(g, h, 0)
ret h
end
@en "Complement"
@fa "مکمل"
pub func Complement(g &: Graph): Graph:
mut h := New(g.n, g.directed)
mut seen := HashMap {} as HashMap<i64, bool>
defer seen.free()
m := g.size()
repeat m in e:
seen.put(_key(g.n, g.edge_from(e), g.edge_to(e)), true)
if g.directed == false: seen.put(_key(g.n, g.edge_to(e), g.edge_from(e)), true) end
end
_fill_complement(g, h, seen)
_copy_names(g, h, 0)
ret h
end
@en "Union"
@fa "اجتماع"
pub func Union(a &: Graph, b &: Graph): Graph:
mut n := a.n
if b.n > n: n = b.n end
mut h := New(n, a.directed)
_append_edges(a, h, 0)
_append_edges(b, h, 0)
_copy_names(a, h, 0)
ret h
end
@en "DisjointUnion"
@fa "اجتماع مجزا"
pub func DisjointUnion(a &: Graph, b &: Graph): Graph:
mut h := New(a.n + b.n, a.directed)
_append_edges(a, h, 0)
_append_edges(b, h, a.n)
_copy_names(a, h, 0)
_copy_names(b, h, a.n)
ret h
end
@en "Intersection"
@fa "اشتراک"
pub func Intersection(a &: Graph, b &: Graph): Graph:
mut n := a.n
if b.n > n: n = b.n end
mut h := New(n, a.directed)
mut seen := HashMap {} as HashMap<i64, bool>
defer seen.free()
m := a.size()
repeat m in e:
u := a.edge_from(e)
v := a.edge_to(e)
k := _key(n, u, v)
if seen.has(k) == false:
if b.has_edge(u, v):
seen.put(k, true)
h.add_weighted(u, v, a.edge_weight(e))
end
end
end
ret h
end
@en "LineGraph"
@fa "گراف یالی"
pub func LineGraph(g &: Graph): Graph:
m := g.size()
mut h := New(m, false)
mut seen := HashMap {} as HashMap<i64, bool>
defer seen.free()
repeat g.n in u:
_link_incident(g, h, seen, u, m)
end
ret h
end
@en "Simplify"
@fa "ساده‌سازی"
pub func Simplify(g &: Graph): Graph:
mut h := New(g.n, g.directed)
mut best := HashMap {} as HashMap<i64, f64>
defer best.free()
mut order := Vector {} as Vector<i64>
defer order.free()
_collect_best(g, best, order)
repeat order.len() in i:
k := order.get(i)
h.add_weighted((k / (g.n as i64)) as int, (k % (g.n as i64)) as int, best.get(k))
end
_copy_names(g, h, 0)
ret h
end
@en "RemoveSelfLoops"
@fa "حذف طوقه‌ها"
pub func RemoveSelfLoops(g &: Graph): Graph:
mut h := New(g.n, g.directed)
m := g.size()
repeat m in e:
if g.edge_from(e) != g.edge_to(e):
h.add_weighted(g.edge_from(e), g.edge_to(e), g.edge_weight(e))
end
end
_copy_names(g, h, 0)
ret h
end
@en "SelfLoopCount"
@fa "شمار طوقه"
pub func SelfLoopCount(g &: Graph): int:
mut c := 0
repeat g.size() in e:
if g.edge_from(e) == g.edge_to(e): c += 1 end
end
ret c
end
@en "HasSelfLoop"
@fa "دارای طوقه"
pub func HasSelfLoop(g &: Graph): bool: ret SelfLoopCount(g) > 0 end
@en "ParallelEdgeCount"
@fa "شمار یال موازی"
pub func ParallelEdgeCount(g &: Graph): int:
mut seen := HashMap {} as HashMap<i64, bool>
defer seen.free()
mut c := 0
repeat g.size() in e:
u := g.edge_from(e)
v := g.edge_to(e)
k := _key(g.n, u, v)
if seen.has(k): c += 1
else:
seen.put(k, true)
end
if g.directed == false: seen.put(_key(g.n, v, u), true) end
end
ret c
end
@en "IsSimple"
@fa "ساده است"
pub func IsSimple(g &: Graph): bool:
if HasSelfLoop(g): ret false end
ret ParallelEdgeCount(g) == 0
end
@en "TotalWeight"
@fa "وزن کل"
pub func TotalWeight(g &: Graph): f64:
mut s := 0.0
repeat g.size() in e: s += g.edge_weight(e) end
ret s
end
package graph
func _has_negative(g &: Graph): bool:
repeat g.size() in e:
if g.edge_weight(e) < 0.0: ret true end
end
ret false
end
func _relax_heap(g &: Graph, u: int, d: f64, dist &: Vector<f64>, parent &: Vector<int>, h &: MinHeap):
mut k := g.adj_start(u)
stop := g.adj_stop(u)
until k < stop:
v := g.adj_node(k)
new_dist := d + g.adj_weight(k)
if new_dist < dist.get(v):
dist.set(v, new_dist)
parent.set(v, u)
h.push(new_dist, v)
end
k += 1
end
end
func _relax_astar(g &: Graph, u: int, dist &: Vector<f64>, parent &: Vector<int>, h &: MinHeap, hs: Vector<f64>):
mut k := g.adj_start(u)
stop := g.adj_stop(u)
until k < stop:
v := g.adj_node(k)
new_dist := dist.get(u) + g.adj_weight(k)
if new_dist < dist.get(v):
dist.set(v, new_dist)
parent.set(v, u)
h.push(new_dist + hs.get(v), v)
end
k += 1
end
end
func _bf_pass(g &: Graph, dist &: Vector<f64>, parent &: Vector<int>): bool:
mut changed := false
repeat g.size() in e:
u := g.edge_from(e)
v := g.edge_to(e)
w := g.edge_weight(e)
if _bf_edge(u, v, w, dist, parent): changed = true end
if g.directed == false:
if _bf_edge(v, u, w, dist, parent): changed = true end
end
end
ret changed
end
func _bf_edge(u: int, v: int, w: f64, dist &: Vector<f64>, parent &: Vector<int>): bool:
if dist.get(u) >= GRAPH_INF: ret false end
new_dist := dist.get(u) + w
if new_dist < dist.get(v):
dist.set(v, new_dist)
parent.set(v, u)
ret true
end
ret false
end
func _cycle_at(parent: Vector<int>, start: int, n: int): Vector<int>:
mut c := start
repeat n: c = parent.get(c) end
mut out := Vector {} as Vector<int>
mut seen := Vector {} as Vector<bool>
FillBool(seen, parent.len(), false)
mut x := c
until seen.get(x) == false:
seen.set(x, true)
x = parent.get(x)
end
mut y := x
until true:
out.push(y)
y = parent.get(y)
if y == x: break end
end
defer seen.free()
ReverseInt(out)
ret out
end
func _deque_pop_front(front &: Vector<int>, back &: Vector<int>): int:
if front.len() == 0:
mut i := back.len() - 1
until i >= 0:
front.push(back.get(i))
i = i - 1
end
back.clear()
end
ret front.pop()
end
func _reweight(g &: Graph, pot: Vector<f64>): Graph:
mut h := New(g.n, true)
repeat g.size() in e:
u := g.edge_from(e)
v := g.edge_to(e)
w := g.edge_weight(e)
h.add_weighted(u, v, w + pot.get(u) - pot.get(v))
if g.directed == false:
h.add_weighted(v, u, w + pot.get(v) - pot.get(u))
end
end
ret h
end
func _bf_mark(g &: Graph, dist &: Vector<f64>, parent &: Vector<int>): int:
mut last := GRAPH_NONE
repeat g.size() in e:
u := g.edge_from(e)
v := g.edge_to(e)
w := g.edge_weight(e)
if _bf_edge(u, v, w, dist, parent): last = v end
if g.directed == false:
if _bf_edge(v, u, w, dist, parent): last = u end
end
end
ret last
end
func _zero_one_ok(g &: Graph): bool:
repeat g.size() in e:
w := g.edge_weight(e)
if w != 0.0:
if w != 1.0: ret false end
end
end
ret true
end
func _relax_zero_one(g &: Graph, u: int, dist &: Vector<f64>, parent &: Vector<int>, front &: Vector<int>, back &: Vector<int>):
mut k := g.adj_start(u)
stop := g.adj_stop(u)
until k < stop:
v := g.adj_node(k)
w := g.adj_weight(k)
new_dist := dist.get(u) + w
if new_dist < dist.get(v):
dist.set(v, new_dist)
parent.set(v, u)
if w == 0.0: front.push(v)
else:
back.push(v)
end
end
k += 1
end
end
func _init_next(g &: Graph, d &: Matrix, next &: IntMatrix):
repeat g.n in i:
repeat g.n in j:
if d.at(i, j) < GRAPH_INF: next.set(i, j, j) end
end
end
end
func _fw_row(d &: Matrix, next &: IntMatrix, i: int, k: int, n: int):
dik := d.at(i, k)
repeat n in j:
if d.at(k, j) < GRAPH_INF:
new_dist := dik + d.at(k, j)
if new_dist < d.at(i, j):
d.set(i, j, new_dist)
next.set(i, j, next.at(i, k))
end
end
end
end
func _all_inf(out &: Matrix, n: int): Matrix:
repeat n in i:
repeat n in j: out.set(i, j, GRAPH_INF) end
end
ret out
end
func _johnson_rows(g &: Graph, pot: Vector<f64>, out &: Matrix):
mut r := _reweight(g, pot)
mut dist := Vector {} as Vector<f64>
mut parent := Vector {} as Vector<int>
repeat g.n in s:
Dijkstra(r, s, dist, parent)
_johnson_row(pot, dist, out, s, g.n)
end
defer dist.free()
defer parent.free()
defer r.free()
end
func _johnson_row(pot: Vector<f64>, dist: Vector<f64>, out &: Matrix, s: int, n: int):
repeat n in t:
d := dist.get(t)
if d >= GRAPH_INF: out.set(s, t, GRAPH_INF)
else:
out.set(s, t, d - pot.get(s) + pot.get(t))
end
end
end
func _push_successors(g &: Graph, u: int, d: f64, h &: MinHeap):
mut k := g.adj_start(u)
stop := g.adj_stop(u)
until k < stop:
h.push(d + g.adj_weight(k), g.adj_node(k))
k += 1
end
end
@en "Dijkstra"
@fa "دایکسترا"
pub func Dijkstra(g &: Graph, src: int, dist &: Vector<f64>, parent &: Vector<int>): bool:
FillFloat(dist, g.n, GRAPH_INF)
FillInt(parent, g.n, GRAPH_NONE)
if src < 0: ret false end
if src >= g.n: ret false end
if _has_negative(g): ret false end
mut h := MinHeap {}
defer h.free()
dist.set(src, 0.0)
h.push(0.0, src)
until h.is_empty() == false:
d := h.top_key()
u := h.pop()
if d <= dist.get(u): _relax_heap(g, u, d, dist, parent, h) end
end
ret true
end
@en "DijkstraDist"
@fa "فاصله دایکسترا"
pub func DijkstraDist(g &: Graph, src: int): Vector<f64>:
mut dist := Vector {} as Vector<f64>
mut parent := Vector {} as Vector<int>
defer parent.free()
Dijkstra(g, src, dist, parent)
ret dist
end
@en "ShortestPath"
@fa "کوتاه‌ترین مسیر"
pub func ShortestPath(g &: Graph, s: int, t: int): Vector<int>:
mut dist := Vector {} as Vector<f64>
defer dist.free()
mut parent := Vector {} as Vector<int>
defer parent.free()
if _has_negative(g): BellmanFord(g, s, dist, parent)
else:
Dijkstra(g, s, dist, parent)
end
ret PathFromParents(parent, s, t)
end
@en "ShortestPathLength"
@fa "طول کوتاه‌ترین مسیر"
pub func ShortestPathLength(g &: Graph, s: int, t: int): f64:
mut dist := Vector {} as Vector<f64>
defer dist.free()
mut parent := Vector {} as Vector<int>
defer parent.free()
if _has_negative(g): BellmanFord(g, s, dist, parent)
else:
Dijkstra(g, s, dist, parent)
end
if t < 0: ret GRAPH_INF end
if t >= g.n: ret GRAPH_INF end
ret dist.get(t)
end
@en "BellmanFord"
@fa "بلمن فورد"
pub func BellmanFord(g &: Graph, src: int, dist &: Vector<f64>, parent &: Vector<int>): bool:
FillFloat(dist, g.n, GRAPH_INF)
FillInt(parent, g.n, GRAPH_NONE)
if src < 0: ret false end
if src >= g.n: ret false end
dist.set(src, 0.0)
mut round := 0
until round < g.n - 1:
if _bf_pass(g, dist, parent) == false: ret true end
round += 1
end
ret _bf_pass(g, dist, parent) == false
end
@en "FindNegativeCycle"
@fa "یافتن دور منفی"
pub func FindNegativeCycle(g &: Graph): Vector<int>:
mut dist := Vector {} as Vector<f64>
defer dist.free()
mut parent := Vector {} as Vector<int>
defer parent.free()
FillFloat(dist, g.n, 0.0)
FillInt(parent, g.n, GRAPH_NONE)
mut round := 0
mut last := GRAPH_NONE
until round < g.n:
last = _bf_mark(g, dist, parent)
if last == GRAPH_NONE: break end
round += 1
end
if last == GRAPH_NONE: ret Vector {} end
ret _cycle_at(parent, last, g.n)
end
@en "HasNegativeCycle"
@fa "دارای دور منفی"
pub func HasNegativeCycle(g &: Graph): bool:
mut c := FindNegativeCycle(g)
defer c.free()
ret c.len() > 0
end
@en "ZeroOneBFS"
@fa "پیمایش صفر یک"
pub func ZeroOneBFS(g &: Graph, src: int, dist &: Vector<f64>, parent &: Vector<int>): bool:
FillFloat(dist, g.n, GRAPH_INF)
FillInt(parent, g.n, GRAPH_NONE)
if _zero_one_ok(g) == false: ret false end
if src < 0: ret false end
if src >= g.n: ret false end
mut front := Vector {} as Vector<int>
defer front.free()
mut back := Vector {} as Vector<int>
defer back.free()
dist.set(src, 0.0)
front.push(src)
until front.len() + back.len() > 0:
u := _deque_pop_front(front, back)
_relax_zero_one(g, u, dist, parent, front, back)
end
ret true
end
package graph
import math
@en "Determinant"
@fa "دترمینان"
pub func Determinant(x &: Matrix): f64:
n := x.rows
mut m := _matrix_copy(x)
mut det := 1.0
repeat n in c:
p := _pivot(m, c, n)
if p == GRAPH_NONE:
m.free()
ret 0.0
end
if p != c:
_swap_rows(m, p, c, n)
det = 0.0 - det
end
det = det * m.at(c, c)
_eliminate(m, c, n)
end
defer m.free()
ret det
end
@en "SpanningTreeCount"
@fa "شمار درخت پوشا"
pub func SpanningTreeCount(g &: Graph): f64:
if g.n == 0: ret 0.0 end
if g.n == 1: ret 1.0 end
mut u := ToUndirected(g)
mut l := LaplacianMatrix(u)
mut minor := NewMatrix(g.n - 1, g.n - 1)
repeat g.n - 1 in i:
repeat g.n - 1 in j: minor.set(i, j, l.at(i + 1, j + 1)) end
end
d := Determinant(minor)
defer minor.free()
defer l.free()
defer u.free()
ret math.Round(d)
end
@en "SymmetricEigenvalues"
@fa "مقادیر ویژه متقارن"
pub func SymmetricEigenvalues(x &: Matrix): Vector<f64>:
n := x.rows
mut m := _matrix_copy(x)
mut sweep := 0
until sweep < 60:
off := _off_diagonal(m, n)
if off < 0.000000000001: break end
_jacobi_sweep(m, n)
sweep += 1
end
mut out := Vector {} as Vector<f64>
repeat n in i: out.push(m.at(i, i)) end
defer m.free()
_sort_floats(out)
ret out
end
@en "AdjacencySpectrum"
@fa "طیف مجاورت"
pub func AdjacencySpectrum(g &: Graph): Vector<f64>:
mut a := AdjacencyMatrix(g)
s := SymmetricEigenvalues(a)
defer a.free()
ret s
end
@en "LaplacianSpectrum"
@fa "طیف لاپلاس"
pub func LaplacianSpectrum(g &: Graph): Vector<f64>:
mut u := ToUndirected(g)
mut l := LaplacianMatrix(u)
s := SymmetricEigenvalues(l)
defer l.free()
defer u.free()
ret s
end
@en "SpectralRadius"
@fa "شعاع طیفی"
pub func SpectralRadius(g &: Graph): f64:
mut s := AdjacencySpectrum(g)
mut best := 0.0
repeat s.len() in i:
v := math.Abs(s.get(i))
if v > best: best = v end
end
defer s.free()
ret best
end
@en "AlgebraicConnectivity"
@fa "همبندی جبری"
pub func AlgebraicConnectivity(g &: Graph): f64:
if g.n < 2: ret 0.0 end
mut s := LaplacianSpectrum(g)
v := s.get(1)
defer s.free()
if v < 0.0: ret 0.0 end
ret v
end
package graph
func _odd_count(g &: Graph): int:
mut c := 0
repeat g.n in u:
if g.degree(u) % 2 == 1: c += 1 end
end
ret c
end
func _edges_connected(g &: Graph): bool:
mut start := GRAPH_NONE
repeat g.n in u:
if g.degree(u) > 0:
if start == GRAPH_NONE: start = u end
end
end
if start == GRAPH_NONE: ret true end
mut r := Reachable(g, start)
defer r.free()
mut ok := true
repeat g.n in u:
if g.degree(u) > 0:
if r.get(u) == false: ok = false end
end
end
ret ok
end
func _balanced(g &: Graph): bool:
repeat g.n in u:
if g.in_degree(u) != g.out_degree(u): ret false end
end
ret true
end
func _hierholzer(g &: Graph, start: int): Vector<int>:
mut used := Vector {} as Vector<bool>
defer used.free()
mut iter := Vector {} as Vector<int>
defer iter.free()
mut stack := Vector {} as Vector<int>
defer stack.free()
mut out := Vector {} as Vector<int>
FillBool(used, g.size(), false)
FillInt(iter, g.n, 0)
repeat g.n in u: iter.set(u, g.adj_start(u)) end
stack.push(start)
until stack.len() > 0:
u := stack.last()
e := _next_unused(g, u, used, iter)
if e == GRAPH_NONE:
out.push(u)
stack.pop()
else:
used.set(g.adj_edge(e), true)
stack.push(g.adj_node(e))
end
end
ReverseInt(out)
ret out
end
func _next_unused(g &: Graph, u: int, used &: Vector<bool>, iter &: Vector<int>): int:
mut k := iter.get(u)
stop := g.adj_stop(u)
until k < stop:
if used.get(g.adj_edge(k)) == false:
iter.set(u, k)
ret k
end
k += 1
iter.set(u, k)
end
ret GRAPH_NONE
end
func _euler_start(g &: Graph): int:
if g.directed: ret _euler_start_directed(g) end
mut odd := GRAPH_NONE
mut any := GRAPH_NONE
repeat g.n in u:
if g.degree(u) > 0:
if any == GRAPH_NONE: any = u end
if g.degree(u) % 2 == 1:
if odd == GRAPH_NONE: odd = u end
end
end
end
if odd != GRAPH_NONE: ret odd end
ret any
end
func _euler_start_directed(g &: Graph): int:
mut any := GRAPH_NONE
repeat g.n in u:
if g.out_degree(u) > 0:
if any == GRAPH_NONE: any = u end
if g.out_degree(u) - g.in_degree(u) == 1: ret u end
end
end
ret any
end
func _ham_extend(g &: Graph, path &: Vector<int>, onpath &: Vector<bool>, want_cycle: bool): bool:
if path.len() == g.n: ret _ham_finish(g, path, want_cycle) end
u := path.last()
mut k := g.adj_start(u)
stop := g.adj_stop(u)
until k < stop:
v := g.adj_node(k)
if onpath.get(v) == false:
onpath.set(v, true)
path.push(v)
if _ham_extend(g, path, onpath, want_cycle): ret true end
path.pop()
onpath.set(v, false)
end
k += 1
end
ret false
end
func _ham_finish(g &: Graph, path &: Vector<int>, want_cycle: bool): bool:
if want_cycle == false: ret true end
ret g.has_edge(path.last(), path.get(0))
end
func _nn_tour(g &: Graph, w &: Matrix, start: int): Vector<int>:
mut seen := Vector {} as Vector<bool>
defer seen.free()
FillBool(seen, g.n, false)
mut tour := Vector {} as Vector<int>
mut cur := start
seen.set(cur, true)
tour.push(cur)
repeat g.n - 1:
nxt := _nearest(w, cur, seen, g.n)
if nxt == GRAPH_NONE: break end
seen.set(nxt, true)
tour.push(nxt)
cur = nxt
end
ret tour
end
func _nearest(w &: Matrix, cur: int, seen: Vector<bool>, n: int): int:
mut best := GRAPH_NONE
repeat n in v:
if seen.get(v) == false:
if w.at(cur, v) < GRAPH_INF:
if best == GRAPH_NONE: best = v
else w.at(cur, v) < w.at(cur, best): best = v
end
end
end
end
ret best
end
func _two_opt_pass(w &: Matrix, tour &: Vector<int>): bool:
n := tour.len()
mut improved := false
mut i := 0
until i < n - 2:
mut j := i + 2
until j < n:
if _two_opt_gain(w, tour, i, j, n) < 0.0:
_reverse_span(tour, i + 1, j)
improved = true
end
j += 1
end
i += 1
end
ret improved
end
func _two_opt_gain(w &: Matrix, tour: Vector<int>, i: int, j: int, n: int): f64:
a := tour.get(i)
b := tour.get(i + 1)
c := tour.get(j)
d := tour.get((j + 1) % n)
if a == d: ret 0.0 end
before := w.at(a, b) + w.at(c, d)
after := w.at(a, c) + w.at(b, d)
if before >= GRAPH_INF: ret 0.0 end
if after >= GRAPH_INF: ret 0.0 end
ret after - before
end
func _reverse_span(tour &: Vector<int>, lo: int, hi: int):
mut i := lo
mut j := hi
until i < j:
a := tour.get(i)
b := tour.get(j)
tour.set(i, b)
tour.set(j, a)
i += 1
j = j - 1
end
end
func _directed_path_ok(g &: Graph): bool:
mut extra_out := 0
mut extra_in := 0
repeat g.n in u:
d := g.out_degree(u) - g.in_degree(u)
if d == 1: extra_out += 1
else d == 0 - 1: extra_in += 1
else d != 0: ret false
end
end
if extra_out == 0:
ret extra_in == 0
end
if extra_out != 1: ret false end
ret extra_in == 1
end
func _ham_search(g &: Graph, want_cycle: bool): Vector<int>:
mut path := Vector {} as Vector<int>
mut onpath := Vector {} as Vector<bool>
defer onpath.free()
if g.n == 0: ret path end
mut start := 0
until start < g.n:
FillBool(onpath, g.n, false)
path.clear()
onpath.set(start, true)
path.push(start)
if _ham_extend(g, path, onpath, want_cycle): ret path end
if want_cycle: break end
start += 1
end
path.clear()
ret path
end
@en "HasEulerianCircuit"
@fa "دارای دور اویلری"
pub func HasEulerianCircuit(g &: Graph): bool:
if g.size() == 0: ret true end
if _edges_connected(g) == false: ret false end
if g.directed: ret _balanced(g) end
ret _odd_count(g) == 0
end
@en "HasEulerianPath"
@fa "دارای مسیر اویلری"
pub func HasEulerianPath(g &: Graph): bool:
if g.size() == 0: ret true end
if _edges_connected(g) == false: ret false end
if g.directed: ret _directed_path_ok(g) end
odd := _odd_count(g)
if odd == 0: ret true end
ret odd == 2
end
@en "EulerianCircuit"
@fa "دور اویلری"
pub func EulerianCircuit(g &: Graph): Vector<int>:
mut out := Vector {} as Vector<int>
if HasEulerianCircuit(g) == false: ret out end
if g.size() == 0: ret out end
defer out.free()
ret _hierholzer(g, _euler_start(g))
end
@en "EulerianPath"
@fa "مسیر اویلری"
pub func EulerianPath(g &: Graph): Vector<int>:
mut out := Vector {} as Vector<int>
if HasEulerianPath(g) == false: ret out end
if g.size() == 0: ret out end
defer out.free()
ret _hierholzer(g, _euler_start(g))
end
@en "HamiltonianPath"
@fa "مسیر همیلتونی"
pub func HamiltonianPath(g &: Graph): Vector<int>:
ret _ham_search(g, false)
end
@en "HamiltonianCycle"
@fa "دور همیلتونی"
pub func HamiltonianCycle(g &: Graph): Vector<int>:
ret _ham_search(g, true)
end
@en "HasHamiltonianCycle"
@fa "دارای دور همیلتونی"
pub func HasHamiltonianCycle(g &: Graph): bool:
mut c := HamiltonianCycle(g)
defer c.free()
ret c.len() > 0
end
@en "TourLength"
@fa "طول تور"
pub func TourLength(g &: Graph, tour: Vector<int>): f64:
if tour.len() < 2: ret 0.0 end
mut w := WeightMatrix(g)
mut total := 0.0
repeat tour.len() in i:
a := tour.get(i)
b := tour.get((i + 1) % tour.len())
total += w.at(a, b)
end
defer w.free()
if total >= GRAPH_INF: ret GRAPH_INF end
ret total
end
@en "TSPNearestNeighbor"
@fa "نزدیک‌ترین همسایه"
pub func TSPNearestNeighbor(g &: Graph, start: int): Vector<int>:
mut w := WeightMatrix(g)
tour := _nn_tour(g, w, start)
defer w.free()
ret tour
end
@en "TSPTwoOpt"
@fa "دوبهینه"
pub func TSPTwoOpt(g &: Graph, tour &: Vector<int>): f64:
mut w := WeightMatrix(g)
mut rounds := 0
until rounds < 1000:
if _two_opt_pass(w, tour) == false: break end
rounds += 1
end
defer w.free()
ret TourLength(g, tour)
end
@en "TSPHeuristic"
@fa "ابتکاری فروشنده دوره‌گرد"
pub func TSPHeuristic(g &: Graph, start: int): Vector<int>:
tour := TSPNearestNeighbor(g, start)
TSPTwoOpt(g, tour)
ret tour
end
package graph
func _visit_out(g &: Graph, u: int, id: int, comp &: Vector<int>, q &: Vector<int>):
mut k := g.adj_start(u)
stop := g.adj_stop(u)
until k < stop:
v := g.adj_node(k)
if comp.get(v) == GRAPH_NONE:
comp.set(v, id)
q.push(v)
end
k += 1
end
end
func _visit_in(g &: Graph, u: int, id: int, comp &: Vector<int>, q &: Vector<int>):
mut k := g.in_start(u)
stop := g.in_stop(u)
until k < stop:
v := g.in_node(k)
if comp.get(v) == GRAPH_NONE:
comp.set(v, id)
q.push(v)
end
k += 1
end
end
func _comp_bfs(g &: Graph, s: int, id: int, comp &: Vector<int>):
mut q := Vector {} as Vector<int>
defer q.free()
q.push(s)
comp.set(s, id)
mut head := 0
until head < q.len():
u := q.get(head)
head += 1
_visit_out(g, u, id, comp, q)
if g.directed: _visit_in(g, u, id, comp, q) end
end
end
func _dfs_walk(g &: Graph, src: int, pre &: Vector<int>, post &: Vector<int>, seen &: Vector<bool>):
if seen.get(src): ret end
mut stack := Vector {} as Vector<int>
defer stack.free()
mut it := Vector {} as Vector<int>
defer it.free()
seen.set(src, true)
pre.push(src)
stack.push(src)
it.push(g.adj_start(src))
until stack.len() > 0:
u := stack.last()
k := it.last()
if k < g.adj_stop(u):
it.set(it.len() - 1, k + 1)
v := g.adj_node(k)
if seen.get(v) == false:
seen.set(v, true)
pre.push(v)
stack.push(v)
it.push(g.adj_start(v))
end
else:
post.push(u)
stack.pop()
it.pop()
end
end
end
func _color_bfs(g &: Graph, s: int, color &: Vector<int>): bool:
mut q := Vector {} as Vector<int>
defer q.free()
mut ok := true
color.set(s, 0)
q.push(s)
mut head := 0
until head < q.len():
u := q.get(head)
head += 1
if _color_step(g, u, color, q) == false: ok = false end
end
ret ok
end
func _color_step(g &: Graph, u: int, color &: Vector<int>, q &: Vector<int>): bool:
mut ok := true
mut k := g.adj_start(u)
stop := g.adj_stop(u)
until k < stop:
v := g.adj_node(k)
if color.get(v) == GRAPH_NONE:
color.set(v, 1 - color.get(u))
q.push(v)
else color.get(v) == color.get(u):
ok = false
end
k += 1
end
ret ok
end
func _stack_index(stack: Vector<int>, v: int): int:
mut i := stack.len() - 1
until i >= 0:
if stack.get(i) == v: ret i end
i = i - 1
end
ret GRAPH_NONE
end
func _cycle_from(stack: Vector<int>, at: int): Vector<int>:
mut out := Vector {} as Vector<int>
mut i := at
until i < stack.len():
out.push(stack.get(i))
i += 1
end
ret out
end
func _find_cycle_from(g &: Graph, src: int, state &: Vector<int>, out &: Vector<int>): bool:
mut stack := Vector {} as Vector<int>
defer stack.free()
mut it := Vector {} as Vector<int>
defer it.free()
mut via := Vector {} as Vector<int>
defer via.free()
state.set(src, 1)
stack.push(src)
it.push(g.adj_start(src))
via.push(GRAPH_NONE)
until stack.len() > 0:
u := stack.last()
k := it.last()
if k >= g.adj_stop(u):
state.set(u, 2)
stack.pop()
it.pop()
via.pop()
continue
end
it.set(it.len() - 1, k + 1)
e := g.adj_edge(k)
v := g.adj_node(k)
if g.directed == false:
if e == via.last(): continue end
end
if state.get(v) == 1:
at := _stack_index(stack, v)
mut c := _cycle_from(stack, at)
repeat c.len() in i: out.push(c.get(i)) end
c.free()
ret true
end
if state.get(v) == 0:
state.set(v, 1)
stack.push(v)
it.push(g.adj_start(v))
via.push(e)
end
end
ret false
end
func _relax_indegree(g &: Graph, u: int, deg &: Vector<int>, q &: Vector<int>):
mut k := g.adj_start(u)
stop := g.adj_stop(u)
until k < stop:
v := g.adj_node(k)
deg.set(v, deg.get(v) - 1)
if deg.get(v) == 0: q.push(v) end
k += 1
end
end
func _relax_indegree_heap(g &: Graph, u: int, deg &: Vector<int>, h &: MinHeap):
mut k := g.adj_start(u)
stop := g.adj_stop(u)
until k < stop:
v := g.adj_node(k)
deg.set(v, deg.get(v) - 1)
if deg.get(v) == 0: h.push(v as f64, v) end
k += 1
end
end
func _bipartite_all(g &: Graph, color &: Vector<int>, n: int): bool:
mut ok := true
repeat n in s:
if color.get(s) == GRAPH_NONE:
if _color_bfs(g, s, color) == false: ok = false end
end
end
ret ok
end
func _indegrees(g &: Graph, deg &: Vector<int>):
FillInt(deg, g.n, 0)
repeat g.size() in e:
v := g.edge_to(e)
deg.set(v, deg.get(v) + 1)
end
end
@en "BFSFrom"
@fa "پیمایش سطحی از"
pub func BFSFrom(g &: Graph, src: int, dist &: Vector<int>, parent &: Vector<int>):
FillInt(dist, g.n, GRAPH_NONE)
FillInt(parent, g.n, GRAPH_NONE)
if src < 0: ret end
if src >= g.n: ret end
mut q := Vector {} as Vector<int>
defer q.free()
dist.set(src, 0)
q.push(src)
mut head := 0
until head < q.len():
u := q.get(head)
head += 1
mut k := g.adj_start(u)
stop := g.adj_stop(u)
until k < stop:
v := g.adj_node(k)
if dist.get(v) == GRAPH_NONE:
dist.set(v, dist.get(u) + 1)
parent.set(v, u)
q.push(v)
end
k += 1
end
end
end
@en "BFS"
@fa "پیمایش سطحی"
pub func BFS(g &: Graph, src: int): Vector<int>:
mut dist := Vector {} as Vector<int>
mut parent := Vector {} as Vector<int>
defer parent.free()
BFSFrom(g, src, dist, parent)
ret dist
end
@en "BFSOrder"
@fa "ترتیب سطحی"
pub func BFSOrder(g &: Graph, src: int): Vector<int>:
mut out := Vector {} as Vector<int>
if src < 0: ret out end
if src >= g.n: ret out end
mut seen := Vector {} as Vector<bool>
defer seen.free()
FillBool(seen, g.n, false)
seen.set(src, true)
out.push(src)
mut head := 0
until head < out.len():
u := out.get(head)
head += 1
mut k := g.adj_start(u)
stop := g.adj_stop(u)
until k < stop:
v := g.adj_node(k)
if seen.get(v) == false:
seen.set(v, true)
out.push(v)
end
k += 1
end
end
ret out
end
@en "DFSOrder"
@fa "ترتیب عمقی"
pub func DFSOrder(g &: Graph, src: int): Vector<int>:
mut pre := Vector {} as Vector<int>
mut post := Vector {} as Vector<int>
defer post.free()
mut seen := Vector {} as Vector<bool>
defer seen.free()
FillBool(seen, g.n, false)
_dfs_walk(g, src, pre, post, seen)
ret pre
end
@en "DFSPostOrder"
@fa "ترتیب پسین عمقی"
pub func DFSPostOrder(g &: Graph, src: int): Vector<int>:
mut pre := Vector {} as Vector<int>
defer pre.free()
mut post := Vector {} as Vector<int>
mut seen := Vector {} as Vector<bool>
defer seen.free()
FillBool(seen, g.n, false)
_dfs_walk(g, src, pre, post, seen)
ret post
end
@en "DFSForest"
@fa "جنگل عمقی"
pub func DFSForest(g &: Graph): Vector<int>:
mut pre := Vector {} as Vector<int>
mut post := Vector {} as Vector<int>
defer post.free()
mut seen := Vector {} as Vector<bool>
defer seen.free()
FillBool(seen, g.n, false)
repeat g.n in u: _dfs_walk(g, u, pre, post, seen) end
ret pre
end
@en "Reachable"
@fa "دست‌یافتنی"
pub func Reachable(g &: Graph, src: int): Vector<bool>:
mut dist := Vector {} as Vector<int>
defer dist.free()
mut parent := Vector {} as Vector<int>
defer parent.free()
BFSFrom(g, src, dist, parent)
mut out := Vector {} as Vector<bool>
repeat g.n in u: out.push(dist.get(u) != GRAPH_NONE) end
ret out
end
@en "ReachableCount"
@fa "شمار دست‌یافتنی"
pub func ReachableCount(g &: Graph, src: int): int:
mut r := Reachable(g, src)
defer r.free()
mut c := 0
repeat r.len() in u:
if r.get(u): c += 1 end
end
ret c
end
@en "HopDistance"
@fa "فاصله گامی"
pub func HopDistance(g &: Graph, s: int, t: int): int:
mut d := BFS(g, s)
defer d.free()
if t < 0: ret GRAPH_NONE end
if t >= g.n: ret GRAPH_NONE end
ret d.get(t)
end
@en "PathFromParents"
@fa "مسیر از والدها"
pub func PathFromParents(parent: Vector<int>, s: int, t: int): Vector<int>:
mut out := Vector {} as Vector<int>
if t < 0: ret out end
if t >= parent.len(): ret out end
if t != s:
if parent.get(t) == GRAPH_NONE: ret out end
end
mut c := t
until c != GRAPH_NONE:
out.push(c)
if c == s: break end
c = parent.get(c)
end
ReverseInt(out)
ret out
end
@en "HopPath"
@fa "مسیر گامی"
pub func HopPath(g &: Graph, s: int, t: int): Vector<int>:
mut dist := Vector {} as Vector<int>
defer dist.free()
mut parent := Vector {} as Vector<int>
defer parent.free()
BFSFrom(g, s, dist, parent)
ret PathFromParents(parent, s, t)
end
package graph
import math
import str
import conv
func _tree_far(g &: Graph, s: int, dist &: Vector<int>, parent &: Vector<int>): int:
BFSFrom(g, s, dist, parent)
mut best := s
repeat g.n in u:
if dist.get(u) != GRAPH_NONE:
if dist.get(u) > dist.get(best): best = u end
end
end
ret best
end
func _lift_levels(n: int): int:
mut k := 1
mut span := 1
until span < n:
span = span * 2
k += 1
end
ret k
end
func _peel_leaves(g &: Graph, alive &: Vector<bool>, deg &: Vector<int>, left: int): Vector<int>:
mut remaining := left
mut layer := Vector {} as Vector<int>
repeat g.n in u:
if alive.get(u):
if deg.get(u) <= 1: layer.push(u) end
end
end
until remaining > 2:
remaining = remaining - layer.len()
mut nxt := Vector {} as Vector<int>
_peel_step(g, alive, deg, layer, nxt)
layer.free()
layer = nxt
end
ret layer
end
func _peel_step(g &: Graph, alive &: Vector<bool>, deg &: Vector<int>, layer: Vector<int>, nxt &: Vector<int>):
repeat layer.len() in i:
u := layer.get(i)
alive.set(u, false)
mut k := g.adj_start(u)
stop := g.adj_stop(u)
until k < stop:
v := g.adj_node(k)
if alive.get(v):
deg.set(v, deg.get(v) - 1)
if deg.get(v) == 1: nxt.push(v) end
end
k += 1
end
end
end
func _ahu_name(g &: Graph, u: int, parent: int): str:
mut parts := Vector {} as Vector<str>
defer parts.free()
mut k := g.adj_start(u)
stop := g.adj_stop(u)
until k < stop:
v := g.adj_node(k)
if v != parent: parts.push(_ahu_name(g, v, u)) end
k += 1
end
_sort_strings(parts)
mut out := "("
repeat parts.len() in i: out = out + parts.get(i) end
ret out + ")"
end
func _sort_strings(v &: Vector<str>):
mut i := 1
until i < v.len():
x := v.get(i)
mut j := i - 1
until j >= 0:
if str.Compare(v.get(j), x) <= 0: break end
v.set(j + 1, v.get(j))
j = j - 1
end
v.set(j + 1, x)
i += 1
end
end
func _canonical_rooted(g &: Graph): str:
mut c := TreeCenter(g)
defer c.free()
if c.len() == 0: ret "" end
a := _ahu_name(g, c.get(0), GRAPH_NONE)
if c.len() == 1: ret a end
b := _ahu_name(g, c.get(1), GRAPH_NONE)
if str.Compare(a, b) <= 0: ret a + b end
ret b + a
end
func _render(g &: Graph, u: int, parent: int): str:
mut out := conv.FormatInt(u as i64)
mut kids := Vector {} as Vector<str>
defer kids.free()
mut k := g.adj_start(u)
stop := g.adj_stop(u)
until k < stop:
v := g.adj_node(k)
if v != parent: kids.push(_render(g, v, u)) end
k += 1
end
if kids.len() == 0: ret out end
out = out + "("
repeat kids.len() in i:
if i > 0: out = out + " " end
out = out + kids.get(i)
end
ret out + ")"
end
func _is_centroid(g &: Graph, u: int, size: Vector<int>, parent: Vector<int>): bool:
half := g.n / 2
mut biggest := g.n - size.get(u)
mut k := g.adj_start(u)
stop := g.adj_stop(u)
until k < stop:
v := g.adj_node(k)
if parent.get(v) == u:
if size.get(v) > biggest: biggest = size.get(v) end
end
k += 1
end
ret biggest <= half
end
func _lca_depths(g &: Graph, root: int, parent: Vector<int>, order: Vector<int>, ix &: LCAIndex):
FillInt(ix.depth, g.n, 0)
repeat order.len() in i:
u := order.get(i)
p := parent.get(u)
if p != GRAPH_NONE: ix.depth.set(u, ix.depth.get(p) + 1) end
end
ix.depth.set(root, 0)
end
func _lca_table(parent: Vector<int>, ix &: LCAIndex):
n := ix.n
FillInt(ix.up, ix.levels * n, GRAPH_NONE)
repeat n in v:
p := parent.get(v)
if p == GRAPH_NONE: ix.up.set(v, v)
else:
ix.up.set(v, p)
end
end
mut k := 1
until k < ix.levels:
repeat n in v:
mid := ix.up.get((k - 1) * n + v)
ix.up.set(k * n + v, ix.up.get((k - 1) * n + mid))
end
k += 1
end
end
func _lift_to(ix &: LCAIndex, u0: int, want: int): int:
mut u := u0
mut k := ix.levels - 1
until k >= 0:
if ix.depth.get(ix.ancestor(k, u)) >= want: u = ix.ancestor(k, u) end
k = k - 1
end
ret u
end
func _lowest_leaf(deg: Vector<int>, alive: Vector<bool>, n: int): int:
repeat n in u:
if alive.get(u):
if deg.get(u) == 1: ret u end
end
end
ret GRAPH_NONE
end
func _only_neighbor(g &: Graph, u: int, alive: Vector<bool>): int:
mut k := g.adj_start(u)
stop := g.adj_stop(u)
until k < stop:
v := g.adj_node(k)
if alive.get(v): ret v end
k += 1
end
ret GRAPH_NONE
end
func _prufer_build(g &: Graph, code: Vector<int>, deg &: Vector<int>, n: int):
mut h := MinHeap {}
defer h.free()
repeat n in u:
if deg.get(u) == 1: h.push(u as f64, u) end
end
repeat code.len() in i:
p := code.get(i)
leaf := h.pop()
g.add_edge(leaf, p)
deg.set(p, deg.get(p) - 1)
if deg.get(p) == 1: h.push(p as f64, p) end
end
a := h.pop()
b := h.pop()
g.add_edge(a, b)
end
@en "IsTree"
@fa "درخت است"
pub func IsTree(g &: Graph): bool:
if g.n == 0: ret false end
mut s := Simplify(g)
ok := s.size() == g.n - 1
defer s.free()
if ok == false: ret false end
if HasSelfLoop(g): ret false end
ret IsConnected(g)
end
@en "IsForest"
@fa "جنگل است"
pub func IsForest(g &: Graph): bool:
if HasSelfLoop(g): ret false end
mut s := Simplify(g)
ok := s.size() == g.n - ComponentCount(g)
defer s.free()
ret ok
end
@en "RootTree"
@fa "ریشه‌دار کردن"
pub func RootTree(g &: Graph, root: int, parent &: Vector<int>, order &: Vector<int>):
mut dist := Vector {} as Vector<int>
defer dist.free()
BFSFrom(g, root, dist, parent)
order.clear()
mut best := 0
repeat g.n in u:
if dist.get(u) != GRAPH_NONE:
if dist.get(u) > best: best = dist.get(u) end
end
end
mut d := 0
until d <= best:
repeat g.n in u:
if dist.get(u) == d: order.push(u) end
end
d += 1
end
end
@en "SubtreeSizes"
@fa "اندازه زیردرخت‌ها"
pub func SubtreeSizes(g &: Graph, root: int): Vector<int>:
mut parent := Vector {} as Vector<int>
defer parent.free()
mut order := Vector {} as Vector<int>
defer order.free()
RootTree(g, root, parent, order)
mut size := Vector {} as Vector<int>
FillInt(size, g.n, 1)
mut i := order.len() - 1
until i >= 0:
u := order.get(i)
p := parent.get(u)
if p != GRAPH_NONE: size.set(p, size.get(p) + size.get(u)) end
i = i - 1
end
ret size
end
@en "TreeDiameter"
@fa "قطر درخت"
pub func TreeDiameter(g &: Graph, ends &: Vector<int>): int:
ends.clear()
if g.n == 0: ret GRAPH_NONE end
mut dist := Vector {} as Vector<int>
defer dist.free()
mut parent := Vector {} as Vector<int>
defer parent.free()
a := _tree_far(g, 0, dist, parent)
b := _tree_far(g, a, dist, parent)
ends.push(a)
ends.push(b)
ret dist.get(b)
end
@en "TreeCenter"
@fa "مرکز درخت"
pub func TreeCenter(g &: Graph): Vector<int>:
mut out := Vector {} as Vector<int>
if g.n == 0: ret out end
if g.n <= 2:
repeat g.n in u: out.push(u) end
ret out
end
mut alive := Vector {} as Vector<bool>
defer alive.free()
mut deg := Vector {} as Vector<int>
defer deg.free()
FillBool(alive, g.n, true)
FillInt(deg, g.n, 0)
repeat g.n in u: deg.set(u, g.degree(u)) end
defer out.free()
ret _peel_leaves(g, alive, deg, g.n)
end
@en "TreeCentroid"
@fa "مرکز ثقل درخت"
pub func TreeCentroid(g &: Graph): Vector<int>:
mut out := Vector {} as Vector<int>
if g.n == 0: ret out end
mut size := SubtreeSizes(g, 0)
defer size.free()
mut parent := Vector {} as Vector<int>
defer parent.free()
mut order := Vector {} as Vector<int>
defer order.free()
RootTree(g, 0, parent, order)
repeat g.n in u:
if _is_centroid(g, u, size, parent): out.push(u) end
end
ret out
end
package graph
import math
import str
import conv
@en "LCAIndex"
@fa "نمایه نیای مشترک"
pub struct LCAIndex:
pub n: int = 0
pub levels: int = 0
pub depth: Vector<int> = Vector {}
pub up: Vector<int> = Vector {}
@en "ancestor"
@fa "نیا"
pub func ancestor(k: int, v: int): int: ret this.up.get(k * this.n + v) end
@en "free"
@fa "آزادسازی"
pub func free():
this.depth.free()
this.up.free()
end
end
@en "BuildLCA"
@fa "ساخت نیای مشترک"
pub func BuildLCA(g &: Graph, root: int): LCAIndex:
mut ix := LCAIndex {}
ix.n = g.n
ix.levels = _lift_levels(g.n)
mut parent := Vector {} as Vector<int>
defer parent.free()
mut order := Vector {} as Vector<int>
defer order.free()
RootTree(g, root, parent, order)
_lca_depths(g, root, parent, order, ix)
_lca_table(parent, ix)
ret ix
end
@en "LCA"
@fa "نیای مشترک"
pub func LCA(ix &: LCAIndex, u0: int, v0: int): int:
mut u := u0
mut v := v0
if ix.depth.get(u) < ix.depth.get(v):
t := u
u = v
v = t
end
u = _lift_to(ix, u, ix.depth.get(v))
if u == v: ret u end
mut k := ix.levels - 1
until k >= 0:
if ix.ancestor(k, u) != ix.ancestor(k, v):
u = ix.ancestor(k, u)
v = ix.ancestor(k, v)
end
k = k - 1
end
ret ix.ancestor(0, u)
end
@en "TreeDistance"
@fa "فاصله درختی"
pub func TreeDistance(ix &: LCAIndex, u: int, v: int): int:
a := LCA(ix, u, v)
if a == GRAPH_NONE: ret GRAPH_NONE end
ret ix.depth.get(u) + ix.depth.get(v) - 2 * ix.depth.get(a)
end
@en "PruferEncode"
@fa "کد پروفر"
pub func PruferEncode(g &: Graph): Vector<int>:
mut code := Vector {} as Vector<int>
if g.n < 2: ret code end
mut deg := Vector {} as Vector<int>
defer deg.free()
mut alive := Vector {} as Vector<bool>
defer alive.free()
FillInt(deg, g.n, 0)
FillBool(alive, g.n, true)
repeat g.n in u: deg.set(u, g.degree(u)) end
repeat g.n - 2:
leaf := _lowest_leaf(deg, alive, g.n)
p := _only_neighbor(g, leaf, alive)
code.push(p)
alive.set(leaf, false)
deg.set(p, deg.get(p) - 1)
end
ret code
end
@en "PruferDecode"
@fa "کدگشایی پروفر"
pub func PruferDecode(code: Vector<int>): Graph:
n := code.len() + 2
mut g := New(n, false)
mut deg := Vector {} as Vector<int>
defer deg.free()
FillInt(deg, n, 1)
repeat code.len() in i:
p := code.get(i)
deg.set(p, deg.get(p) + 1)
end
_prufer_build(g, code, deg, n)
ret g
end
@en "TreeIsomorphic"
@fa "درخت‌های یکریخت"
pub func TreeIsomorphic(a &: Graph, b &: Graph): bool:
if a.n != b.n: ret false end
if IsTree(a) == false: ret false end
if IsTree(b) == false: ret false end
ca := _canonical_rooted(a)
cb := _canonical_rooted(b)
ret str.Equals(ca, cb)
end
@en "TreeCanonicalForm"
@fa "شکل متعارف درخت"
pub func TreeCanonicalForm(g &: Graph): str:
if IsTree(g) == false: ret "" end
ret _canonical_rooted(g)
end
@en "LabeledTreeCount"
@fa "شمار درخت برچسب‌دار"
pub func LabeledTreeCount(n: int): f64:
if n < 1: ret 0.0 end
if n < 3: ret 1.0 end
ret math.Pow(n as f64, (n - 2) as f64)
end
@en "TreeToString"
@fa "درخت به رشته"
pub func TreeToString(g &: Graph, root: int): str:
if g.n == 0: ret "" end
ret _render(g, root, GRAPH_NONE)
end
package graph
@en "MinHeap"
@fa "هرم کمینه"
pub struct MinHeap:
pub key: Vector<f64> = Vector {}
pub val: Vector<int> = Vector {}
func _swap(i: int, j: int):
ka := this.key.get(i)
kb := this.key.get(j)
this.key.set(i, kb)
this.key.set(j, ka)
va := this.val.get(i)
vb := this.val.get(j)
this.val.set(i, vb)
this.val.set(j, va)
end
@en "push"
@fa "افزودن"
pub func push(k: f64, v: int):
this.key.push(k)
this.val.push(v)
mut i := this.key.len() - 1
until i > 0:
p := (i - 1) / 2
if this.key.get(p) <= this.key.get(i): break end
this._swap(i, p)
i = p
end
end
@en "size"
@fa "اندازه"
pub func size(): int: ret this.val.len() end
@en "is_empty"
@fa "تهی است"
pub func is_empty(): bool: ret this.val.len() == 0 end
@en "top_key"
@fa "کلید بالا"
pub func top_key(): f64: ret this.key.get(0) end
@en "top_value"
@fa "مقدار بالا"
pub func top_value(): int: ret this.val.get(0) end
@en "pop"
@fa "برداشتن"
pub func pop(): int:
top := this.val.get(0)
last := this.val.len() - 1
this.key.set(0, this.key.get(last))
this.val.set(0, this.val.get(last))
this.key.pop()
this.val.pop()
this._sift(0)
ret top
end
func _sift(from: int):
n := this.val.len()
mut i := from
until true:
l := 2 * i + 1
if l >= n: break end
mut s := l
r := l + 1
if r < n:
if this.key.get(r) < this.key.get(l): s = r end
end
if this.key.get(i) <= this.key.get(s): break end
this._swap(i, s)
i = s
end
end
@en "clear"
@fa "پاکسازی"
pub func clear():
this.key.clear()
this.val.clear()
end
@en "free"
@fa "آزادسازی"
pub func free():
this.key.free()
this.val.free()
end
end
@en "DisjointSet"
@fa "مجموعه‌های مجزا"
pub struct DisjointSet:
pub parent: Vector<int> = Vector {}
pub sz: Vector<int> = Vector {}
pub groups: int = 0
@en "reset"
@fa "بازنشانی"
pub func reset(n: int):
this.parent.clear()
this.sz.clear()
repeat n in i:
this.parent.push(i)
this.sz.push(1)
end
this.groups = n
end
@en "find"
@fa "یافتن"
pub func find(x: int): int:
mut r := x
until this.parent.get(r) != r: r = this.parent.get(r) end
mut c := x
until this.parent.get(c) != c:
nx := this.parent.get(c)
this.parent.set(c, r)
c = nx
end
ret r
end
@en "union"
@fa "یکی‌سازی"
pub func union(a: int, b: int): bool:
mut ra := this.find(a)
mut rb := this.find(b)
if ra == rb: ret false end
if this.sz.get(ra) < this.sz.get(rb):
t := ra
ra = rb
rb = t
end
this.parent.set(rb, ra)
this.sz.set(ra, this.sz.get(ra) + this.sz.get(rb))
this.groups = this.groups - 1
ret true
end
@en "connected"
@fa "متصل"
pub func connected(a: int, b: int): bool: ret this.find(a) == this.find(b) end
@en "set_size"
@fa "اندازه مجموعه"
pub func set_size(a: int): int: ret this.sz.get(this.find(a)) end
@en "count"
@fa "شمار"
pub func count(): int: ret this.groups end
@en "free"
@fa "آزادسازی"
pub func free():
this.parent.free()
this.sz.free()
end
end
@en "NewDisjointSet"
@fa "مجموعه مجزا جدید"
pub func NewDisjointSet(n: int): DisjointSet:
mut d := DisjointSet {}
d.reset(n)
ret d
end
@en "FillInt"
@fa "پرکردن صحیح"
pub func FillInt(v &: Vector<int>, n: int, x: int):
v.clear()
repeat n: v.push(x) end
end
@en "FillFloat"
@fa "پرکردن اعشاری"
pub func FillFloat(v &: Vector<f64>, n: int, x: f64):
v.clear()
repeat n: v.push(x) end
end
@en "FillBool"
@fa "پرکردن منطقی"
pub func FillBool(v &: Vector<bool>, n: int, x: bool):
v.clear()
repeat n: v.push(x) end
end
@en "Iota"
@fa "دنباله"
pub func Iota(v &: Vector<int>, n: int):
v.clear()
repeat n in i: v.push(i) end
end
@en "MaxInt"
@fa "بیشینه صحیح"
pub func MaxInt(v: Vector<int>): int:
if v.len() == 0: ret 0 end
mut b := v.get(0)
repeat v.len() in i:
if v.get(i) > b: b = v.get(i) end
end
ret b
end
@en "SumInt"
@fa "مجموع صحیح"
pub func SumInt(v: Vector<int>): int:
mut s := 0
repeat v.len() in i: s += v.get(i) end
ret s
end
@en "SumFloat"
@fa "مجموع اعشاری"
pub func SumFloat(v: Vector<f64>): f64:
mut s := 0.0
repeat v.len() in i: s += v.get(i) end
ret s
end
@en "ReverseInt"
@fa "وارونه‌سازی"
pub func ReverseInt(v &: Vector<int>):
mut i := 0
mut j := v.len() - 1
until i < j:
a := v.get(i)
b := v.get(j)
v.set(i, b)
v.set(j, a)
i += 1
j = j - 1
end
end
@en "graph"
@fa "گراف"
package graph
const _GRAPH_EPS := 0.000000000001
@en "GRAPH_INF"
@fa "بی‌نهایت گراف"
pub const GRAPH_INF := 1.0e300
@en "GRAPH_NONE"
@fa "هیچ"
pub const GRAPH_NONE := -1
@en "Graph"
@fa "گراف"
pub struct Graph:
pub directed: bool = false
pub n: int = 0
pub eu: Vector<int> = Vector {}
pub ev: Vector<int> = Vector {}
pub ew: Vector<f64> = Vector {}
pub names: Vector<str> = Vector {}
pub off: Vector<int> = Vector {}
pub nbr: Vector<int> = Vector {}
pub eix: Vector<int> = Vector {}
pub roff: Vector<int> = Vector {}
pub rnbr: Vector<int> = Vector {}
pub reix: Vector<int> = Vector {}
pub built: bool = false
@en "add_node"
@fa "افزودن گره"
pub func add_node(): int:
id := this.n
this.n = this.n + 1
this.built = false
ret id
end
@en "add_nodes"
@fa "افزودن گره‌ها"
pub func add_nodes(k: int):
if k <= 0: ret end
this.n = this.n + k
this.built = false
end
@en "add_edge"
@fa "افزودن یال"
pub func add_edge(u: int, v: int): int:
ret this.add_weighted(u, v, 1.0)
end
@en "add_weighted"
@fa "افزودن یال وزن‌دار"
pub func add_weighted(u: int, v: int, w: f64): int:
if u < 0: ret GRAPH_NONE end
if v < 0: ret GRAPH_NONE end
if u >= this.n: this.n = u + 1 end
if v >= this.n: this.n = v + 1 end
this.eu.push(u)
this.ev.push(v)
this.ew.push(w)
this.built = false
ret this.eu.len() - 1
end
@en "order"
@fa "مرتبه"
pub func order(): int: ret this.n end
@en "size"
@fa "اندازه"
pub func size(): int: ret this.eu.len() end
@en "edge_from"
@fa "سر یال"
pub func edge_from(e: int): int: ret this.eu.get(e) end
@en "edge_to"
@fa "ته یال"
pub func edge_to(e: int): int: ret this.ev.get(e) end
@en "edge_weight"
@fa "وزن یال"
pub func edge_weight(e: int): f64: ret this.ew.get(e) end
@en "set_weight"
@fa "تنظیم وزن"
pub func set_weight(e: int, w: f64): this.ew.set(e, w) end
@en "set_name"
@fa "تنظیم نام"
pub func set_name(u: int, s: str):
if u < 0: ret end
if u >= this.n: this.n = u + 1 end
until this.names.len() <= u: this.names.push("") end
this.names.set(u, s)
end
@en "name"
@fa "نام"
pub func name(u: int): str:
if u < 0: ret "" end
if u >= this.names.len(): ret "" end
ret this.names.get(u)
end
@en "build"
@fa "ساخت"
pub func build():
if this.built: ret end
_csr(this.eu, this.ev, this.n, this.directed == false, this.off, this.nbr, this.eix)
if this.directed:
_csr(this.ev, this.eu, this.n, false, this.roff, this.rnbr, this.reix)
end
this.built = true
end
@en "adj_start"
@fa "آغاز مجاورت"
pub func adj_start(u: int): int:
this.build()
ret this.off.get(u)
end
@en "adj_stop"
@fa "پایان مجاورت"
pub func adj_stop(u: int): int:
this.build()
ret this.off.get(u + 1)
end
@en "adj_node"
@fa "گره مجاور"
pub func adj_node(k: int): int: ret this.nbr.get(k) end
@en "adj_edge"
@fa "یال مجاور"
pub func adj_edge(k: int): int: ret this.eix.get(k) end
@en "adj_weight"
@fa "وزن مجاور"
pub func adj_weight(k: int): f64: ret this.ew.get(this.eix.get(k)) end
@en "in_start"
@fa "آغاز ورودی"
pub func in_start(u: int): int:
this.build()
if this.directed: ret this.roff.get(u) end
ret this.off.get(u)
end
@en "in_stop"
@fa "پایان ورودی"
pub func in_stop(u: int): int:
this.build()
if this.directed: ret this.roff.get(u + 1) end
ret this.off.get(u + 1)
end
@en "in_node"
@fa "گره ورودی"
pub func in_node(k: int): int:
if this.directed: ret this.rnbr.get(k) end
ret this.nbr.get(k)
end
@en "in_edge"
@fa "یال ورودی"
pub func in_edge(k: int): int:
if this.directed: ret this.reix.get(k) end
ret this.eix.get(k)
end
@en "out_degree"
@fa "درجه خروجی"
pub func out_degree(u: int): int:
ret this.adj_stop(u) - this.adj_start(u)
end
@en "in_degree"
@fa "درجه ورودی"
pub func in_degree(u: int): int:
ret this.in_stop(u) - this.in_start(u)
end
@en "degree"
@fa "درجه"
pub func degree(u: int): int:
if this.directed: ret this.out_degree(u) + this.in_degree(u) end
ret this.out_degree(u)
end
@en "has_edge"
@fa "دارای یال"
pub func has_edge(u: int, v: int): bool:
ret this.find_edge(u, v) != GRAPH_NONE
end
@en "find_edge"
@fa "یافتن یال"
pub func find_edge(u: int, v: int): int:
if u < 0: ret GRAPH_NONE end
if u >= this.n: ret GRAPH_NONE end
mut k := this.adj_start(u)
stop := this.adj_stop(u)
until k < stop:
if this.adj_node(k) == v: ret this.adj_edge(k) end
k += 1
end
ret GRAPH_NONE
end
@en "weight_between"
@fa "وزن میان"
pub func weight_between(u: int, v: int): f64:
e := this.find_edge(u, v)
if e == GRAPH_NONE: ret GRAPH_INF end
ret this.ew.get(e)
end
@en "neighbors"
@fa "همسایگان"
pub func neighbors(u: int): Vector<int>:
mut out := Vector {} as Vector<int>
mut k := this.adj_start(u)
stop := this.adj_stop(u)
until k < stop:
out.push(this.adj_node(k))
k += 1
end
ret out
end
@en "free"
@fa "آزادسازی"
pub func free():
this.eu.free()
this.ev.free()
this.ew.free()
this.names.free()
this.off.free()
this.nbr.free()
this.eix.free()
this.roff.free()
this.rnbr.free()
this.reix.free()
end
end
func _csr(a: Vector<int>, b: Vector<int>, n: int, both: bool, off &: Vector<int>, nbr &: Vector<int>, eix &: Vector<int>):
m := a.len()
off.zeros(n + 1)
repeat m in i:
_bump(off, a.get(i) + 1)
if both: _bump(off, b.get(i) + 1) end
end
repeat n in i:
off.set(i + 1, off.get(i + 1) + off.get(i))
end
total := off.get(n)
nbr.clear()
eix.clear()
if total > 0:
nbr.zeros(total)
eix.zeros(total)
end
mut cur := Vector {} as Vector<int>
defer cur.free()
cur.zeros(n + 1)
repeat n + 1 in i: cur.set(i, off.get(i)) end
repeat m in i:
_place(cur, nbr, eix, a.get(i), b.get(i), i)
if both: _place(cur, nbr, eix, b.get(i), a.get(i), i) end
end
end
func _bump(v &: Vector<int>, i: int): v.set(i, v.get(i) + 1) end
func _place(cur &: Vector<int>, nbr &: Vector<int>, eix &: Vector<int>, u: int, v: int, e: int):
p := cur.get(u)
nbr.set(p, v)
eix.set(p, e)
cur.set(u, p + 1)
end
@en "New"
@fa "جدید"
pub func New(n: int, directed: bool): Graph:
mut g := Graph {}
g.directed = directed
g.add_nodes(n)
ret g
end
@en "NewUndirected"
@fa "بی‌جهت جدید"
pub func NewUndirected(n: int): Graph: ret New(n, false) end
@en "NewDirected"
@fa "جهت‌دار جدید"
pub func NewDirected(n: int): Graph: ret New(n, true) end
@en "FromEdges"
@fa "از یال‌ها"
pub func FromEdges(n: int, us: Vector<int>, vs: Vector<int>, directed: bool): Graph:
mut g := New(n, directed)
m := us.len()
repeat m in i:
g.add_edge(us.get(i), vs.get(i))
end
ret g
end
@en "IsClose"
@fa "نزدیک است"
pub func IsClose(a: f64, b: f64): bool:
d := a - b
if d < 0.0: ret 0.0 - d < _GRAPH_EPS end
ret d < _GRAPH_EPS
end
package graphql
@en "VAL_NULL"
@fa "مقدار تهی"
pub const VAL_NULL := 0
@en "VAL_BOOL"
@fa "مقدار بولی"
pub const VAL_BOOL := 1
@en "VAL_INT"
@fa "مقدار صحیح"
pub const VAL_INT := 2
@en "VAL_FLOAT"
@fa "مقدار اعشاری"
pub const VAL_FLOAT := 3
@en "VAL_STRING"
@fa "مقدار رشته"
pub const VAL_STRING := 4
@en "VAL_ENUM"
@fa "مقدار شمارشی"
pub const VAL_ENUM := 5
@en "VAL_LIST"
@fa "مقدار فهرست"
pub const VAL_LIST := 6
@en "VAL_OBJECT"
@fa "مقدار شیء"
pub const VAL_OBJECT := 7
@en "VAL_VARIABLE"
@fa "مقدار متغیر"
pub const VAL_VARIABLE := 8
@en "TREF_NAMED"
@fa "ارجاع نوع نام‌دار"
pub const TREF_NAMED := 0
@en "TREF_LIST"
@fa "ارجاع نوع فهرست"
pub const TREF_LIST := 1
@en "SEL_FIELD"
@fa "گزینش فیلد"
pub const SEL_FIELD := 0
@en "SEL_FRAGMENT_SPREAD"
@fa "گزینش پخش قطعه"
pub const SEL_FRAGMENT_SPREAD := 1
@en "SEL_INLINE_FRAGMENT"
@fa "گزینش قطعه درون‌خطی"
pub const SEL_INLINE_FRAGMENT := 2
@en "OP_QUERY"
@fa "عملیات پرسمان"
pub const OP_QUERY := 0
@en "OP_MUTATION"
@fa "عملیات تغییر"
pub const OP_MUTATION := 1
@en "OP_SUBSCRIPTION"
@fa "عملیات اشتراک"
pub const OP_SUBSCRIPTION := 2
@en "AstValue"
@fa "مقدار نحوی"
pub struct AstValue:
pub kind: int = VAL_NULL
pub b: bool = false
pub i: i64 = 0
pub f: f64 = 0.0
pub s: str = ""
pub items: Vector<int> = Vector {}
pub keys: Vector<str> = Vector {}
pub line: int = 0
end
@en "AstTypeRef"
@fa "ارجاع نوع"
pub struct AstTypeRef:
pub kind: int = TREF_NAMED
pub name: str = ""
pub inner: int = 0 - 1
pub nonNull: bool = false
end
@en "AstArgument"
@fa "آرگومان نحوی"
pub struct AstArgument:
pub name: str = ""
pub value: int = 0 - 1
pub line: int = 0
end
@en "AstDirective"
@fa "دستورالعمل نحوی"
pub struct AstDirective:
pub name: str = ""
pub args: Vector<AstArgument> = Vector {}
pub line: int = 0
end
@en "AstSelection"
@fa "گزینش نحوی"
pub struct AstSelection:
pub kind: int = SEL_FIELD
pub name: str = ""
pub alias: str = ""
pub typeCondition: str = ""
pub hasTypeCondition: bool = false
pub args: Vector<AstArgument> = Vector {}
pub directives: Vector<AstDirective> = Vector {}
pub selections: Vector<int> = Vector {}
pub line: int = 0
pub col: int = 0
end
@en "AstVariableDef"
@fa "تعریف متغیر"
pub struct AstVariableDef:
pub name: str = ""
pub typeRef: int = 0 - 1
pub defaultValue: int = 0 - 1
pub hasDefault: bool = false
pub directives: Vector<AstDirective> = Vector {}
pub line: int = 0
end
@en "AstOperation"
@fa "عملیات نحوی"
pub struct AstOperation:
pub optype: int = OP_QUERY
pub name: str = ""
pub varDefs: Vector<AstVariableDef> = Vector {}
pub directives: Vector<AstDirective> = Vector {}
pub selections: Vector<int> = Vector {}
pub shorthand: bool = false
pub line: int = 0
end
@en "AstFragment"
@fa "قطعه نحوی"
pub struct AstFragment:
pub name: str = ""
pub typeCondition: str = ""
pub directives: Vector<AstDirective> = Vector {}
pub selections: Vector<int> = Vector {}
pub line: int = 0
end
@en "Document"
@fa "سند"
pub struct Document:
pub ops: Vector<AstOperation> = Vector {}
pub frags: Vector<AstFragment> = Vector {}
pub sels: Vector<AstSelection> = Vector {}
pub vals: Vector<AstValue> = Vector {}
pub trefs: Vector<AstTypeRef> = Vector {}
end
func _doc_add_value(doc &: Document, v: AstValue): int:
id := doc.vals.len()
doc.vals.push(v)
ret id
end
func _doc_add_selection(doc &: Document, s: AstSelection): int:
id := doc.sels.len()
doc.sels.push(s)
ret id
end
func _doc_add_tref(doc &: Document, t: AstTypeRef): int:
id := doc.trefs.len()
doc.trefs.push(t)
ret id
end
func _free_directives(ds: Vector<AstDirective>):
mut i := 0
until i < ds.len():
mut d := ds.get(i)
d.args.free()
i += 1
end
mut dv := ds
defer dv.free()
end
func _free_var_defs(vs: Vector<AstVariableDef>):
mut i := 0
until i < vs.len():
_free_directives(vs.get(i).directives)
i += 1
end
mut vv := vs
defer vv.free()
end
func _free_ops(doc &: Document):
mut i := 0
until i < doc.ops.len():
mut o := doc.ops.get(i)
_free_directives(o.directives)
_free_var_defs(o.varDefs)
o.selections.free()
i += 1
end
doc.ops.free()
end
func _free_frags(doc &: Document):
mut i := 0
until i < doc.frags.len():
mut f := doc.frags.get(i)
_free_directives(f.directives)
f.selections.free()
i += 1
end
doc.frags.free()
end
func _free_sels(doc &: Document):
mut i := 0
until i < doc.sels.len():
mut s := doc.sels.get(i)
_free_directives(s.directives)
s.args.free()
s.selections.free()
i += 1
end
doc.sels.free()
end
func _free_vals(doc &: Document):
mut i := 0
until i < doc.vals.len():
mut v := doc.vals.get(i)
v.items.free()
v.keys.free()
i += 1
end
doc.vals.free()
end
@en "SelectionAt"
@fa "گزینش در"
pub func SelectionAt(doc: Document, id: int): AstSelection:
if id < 0 or id >= doc.sels.len(): ret AstSelection {} end
ret doc.sels.get(id)
end
@en "ValueAt"
@fa "مقدار در"
pub func ValueAt(doc: Document, id: int): AstValue:
if id < 0 or id >= doc.vals.len(): ret AstValue {} end
ret doc.vals.get(id)
end
@en "TypeRefAt"
@fa "ارجاع نوع در"
pub func TypeRefAt(doc: Document, id: int): AstTypeRef:
if id < 0 or id >= doc.trefs.len(): ret AstTypeRef {} end
ret doc.trefs.get(id)
end
@en "FindOperation"
@fa "یافتن عملیات"
pub func FindOperation(doc: Document, name: str): int:
if name == "":
if doc.ops.len() == 1: ret 0 end
ret 0 - 1
end
mut i := 0
until i < doc.ops.len():
if doc.ops.get(i).name == name: ret i end
i += 1
end
ret 0 - 1
end
@en "FindFragment"
@fa "یافتن قطعه"
pub func FindFragment(doc: Document, name: str): int:
mut i := 0
until i < doc.frags.len():
if doc.frags.get(i).name == name: ret i end
i += 1
end
ret 0 - 1
end
@en "OperationTypeName"
@fa "نام نوع عملیات"
pub func OperationTypeName(optype: int): str:
if optype == OP_MUTATION: ret "mutation" end
if optype == OP_SUBSCRIPTION: ret "subscription" end
ret "query"
end
@en "ResponseKey"
@fa "کلید پاسخ"
pub func ResponseKey(sel: AstSelection): str:
if sel.alias != "": ret sel.alias end
ret sel.name
end
@en "FreeDocument"
@fa "آزادسازی سند"
pub func FreeDocument(doc &: Document):
_free_sels(doc)
_free_vals(doc)
_free_ops(doc)
_free_frags(doc)
doc.trefs.free()
end
package graphql
import encoding.value
import encoding.json
import encoding.encerr
import str
@en "ClientResponse"
@fa "پاسخ کارخواه"
pub struct ClientResponse:
pub data: value.Value = value.Value {}
pub hasData: bool = false
pub errors: GqlErrorList = GqlErrorList {}
pub extensions: value.Value = value.Value {}
pub hasExtensions: bool = false
end
func _cl_error_from_value(v: value.Value): GqlError:
mut e := NewError(ERR_REQUEST, "unknown error")
if not value.IsObject(v):
if value.IsString(v): e.message = value.AsString(v) end
ret e
end
if value.ObjectHas(v, "message"):
e.message = value.AsString(value.ObjectGet(v, "message"))
end
_cl_read_location(v, e)
_cl_read_path(v, e)
_cl_read_code(v, e)
ret e
end
func _cl_read_location(v: value.Value, e &: GqlError):
if not value.ObjectHas(v, "locations"): ret end
locs := value.ObjectGet(v, "locations")
if not value.IsArray(locs) or value.ArrayLen(locs) == 0: ret end
first := value.ArrayGet(locs, 0)
if not value.IsObject(first): ret end
e.line = value.AsInt(value.ObjectGet(first, "line")) as int
e.col = value.AsInt(value.ObjectGet(first, "column")) as int
e.hasLocation = true
end
func _cl_read_path(v: value.Value, e &: GqlError):
if not value.ObjectHas(v, "path"): ret end
p := value.ObjectGet(v, "path")
if not value.IsArray(p): ret end
mut i := 0
until i < value.ArrayLen(p):
seg := value.ArrayGet(p, i)
if value.IsInt(seg):
PathPushIndex(e, value.AsInt(seg) as int)
else:
PathPushKey(e, value.AsString(seg))
end
i += 1
end
end
func _cl_read_code(v: value.Value, e &: GqlError):
if not value.ObjectHas(v, "extensions"): ret end
ext := value.ObjectGet(v, "extensions")
if not value.IsObject(ext) or not value.ObjectHas(ext, "code"): ret end
e.code = value.AsString(value.ObjectGet(ext, "code"))
end
func _cl_unreserved(c: int): bool:
if c >= 65 and c <= 90: ret true end
if c >= 97 and c <= 122: ret true end
if c >= 48 and c <= 57: ret true end
ret c == 45 or c == 95 or c == 46 or c == 126
end
func _gql_percent_encode(s: str): str:
hex := "0123456789ABCDEF"
mut sb := str.NewBuilder()
defer str.BufFree(sb)
bp := _gbp(s)
mut i := 0
until i < s.len():
c := _gub(bp, i)
if _cl_unreserved(c):
str.BufAppendChar(sb, c)
else:
str.BufAppendChar(sb, 37)
str.BufAppend(sb, hex.substr(c / 16, 1))
str.BufAppend(sb, hex.substr(c % 16, 1))
end
i += 1
end
ret str.BufStr(sb)
end
func _cl_bad_response(message: str): ClientResponse:
r := ClientResponse {}
AddError(r.errors, NewError(ERR_REQUEST, message))
ret r
end
@en "BuildRequestBody"
@fa "ساخت بدنه درخواست"
pub func BuildRequestBody(queryText: str, operationName: str, variables: value.Value): str:
mut o := value.NewValueObject()
value.ObjectSet(o, "query", value.ValueString(queryText))
if operationName != "":
value.ObjectSet(o, "operationName", value.ValueString(operationName))
end
if value.IsObject(variables) and value.ObjectLen(variables) > 0:
value.ObjectSet(o, "variables", variables)
end
ret json.EncodeDefault(o)
end
@en "BuildQueryBody"
@fa "ساخت بدنه پرس‌وجو"
pub func BuildQueryBody(queryText: str): str:
ret BuildRequestBody(queryText, "", value.NewValueObject())
end
@en "BuildRequestQueryString"
@fa "ساخت رشته پرس‌وجو"
pub func BuildRequestQueryString(queryText: str, operationName: str, variables: value.Value): str:
mut sb := str.NewBuilder()
defer str.BufFree(sb)
str.BufAppend(sb, "query=")
str.BufAppend(sb, _gql_percent_encode(queryText))
if operationName != "":
str.BufAppend(sb, "&operationName=")
str.BufAppend(sb, _gql_percent_encode(operationName))
end
if value.IsObject(variables) and value.ObjectLen(variables) > 0:
str.BufAppend(sb, "&variables=")
str.BufAppend(sb, _gql_percent_encode(json.EncodeDefault(variables)))
end
ret str.BufStr(sb)
end
@en "ParseResponse"
@fa "تجزیه پاسخ"
pub func ParseResponse(body: str): ClientResponse:
mut err := encerr.NoError()
parsed := json.Decode(body, err)
if encerr.IsError(err): ret _cl_bad_response("the response is not valid JSON") end
if not value.IsObject(parsed): ret _cl_bad_response("the response is not a JSON object") end
mut r := ClientResponse {}
if value.ObjectHas(parsed, "data"):
r.data = value.ObjectGet(parsed, "data")
r.hasData = true
end
if value.ObjectHas(parsed, "extensions"):
r.extensions = value.ObjectGet(parsed, "extensions")
r.hasExtensions = true
end
if value.ObjectHas(parsed, "errors"):
errs := value.ObjectGet(parsed, "errors")
mut i := 0
until i < value.ArrayLen(errs):
AddError(r.errors, _cl_error_from_value(value.ArrayGet(errs, i)))
i += 1
end
end
if not r.hasData and not HasErrors(r.errors):
ret _cl_bad_response("the response has neither data nor errors")
end
ret r
end
@en "ResponseField"
@fa "فیلد پاسخ"
pub func ResponseField(r: ClientResponse, name: str): value.Value:
if not r.hasData: ret value.ValueNull() end
ret value.ObjectGet(r.data, name)
end
@en "ResponseOk"
@fa "پاسخ موفق"
pub func ResponseOk(r: ClientResponse): bool: ret not HasErrors(r.errors) end
@en "ResponseErrorMessage"
@fa "پیام خطای پاسخ"
pub func ResponseErrorMessage(r: ClientResponse): str:
if not HasErrors(r.errors): ret "" end
ret ErrorString(ErrorAt(r.errors, 0))
end
@en "FreeClientResponse"
@fa "آزادسازی پاسخ کارخواه"
pub func FreeClientResponse(r &: ClientResponse):
FreeErrorList(r.errors)
end
package graphql
import encoding.value
import conv
@en "CoerceResult"
@fa "نتیجه تبدیل"
pub struct CoerceResult:
pub ok: bool = true
pub message: str = ""
pub value: value.Value = value.Value {}
end
func _co_fail(message: str): CoerceResult:
mut r := CoerceResult { ok = false }
r.message = message
ret r
end
func _co_ok(v: value.Value): CoerceResult:
mut r := CoerceResult { ok = true }
r.value = v
ret r
end
func _co_int_str(n: i64): str: ret conv.FormatInt(n) end
func _co_type_msg(prefix: str, typeName: str, suffix: str): str:
ret prefix + typeName + suffix
end
func _co_var_missing(vars: value.Value, name: str): bool:
ret not value.ObjectHas(vars, name)
end
func _co_literal_list(sch: Schema, doc: Document, v: AstValue, vars: value.Value): CoerceResult:
mut out := value.NewValueArray()
mut i := 0
until i < v.items.len():
r := LiteralToValue(sch, doc, v.items.get(i), vars)
if not r.ok: ret r end
value.ArrayPush(out, r.value)
i += 1
end
ret _co_ok(out)
end
func _co_literal_object(sch: Schema, doc: Document, v: AstValue, vars: value.Value): CoerceResult:
mut out := value.NewValueObject()
mut i := 0
until i < v.items.len():
childId := v.items.get(i)
child := ValueAt(doc, childId)
if child.kind == VAL_VARIABLE and _co_var_missing(vars, child.s):
i += 1
continue
end
r := LiteralToValue(sch, doc, childId, vars)
if not r.ok: ret r end
value.ObjectSet(out, v.keys.get(i), r.value)
i += 1
end
ret _co_ok(out)
end
func _co_int(v: value.Value): CoerceResult:
if value.IsInt(v):
n := value.AsInt(v)
if n > 2147483647 or n < 0 - 2147483648:
ret _co_fail("Int cannot represent value outside 32-bit range: " + _co_int_str(n))
end
ret _co_ok(value.ValueInt(n))
end
if value.IsFloat(v):
f := value.AsFloat(v)
n := f as i64
if (n as f64) != f:
ret _co_fail("Int cannot represent non-integer value")
end
ret _co_ok(value.ValueInt(n))
end
ret _co_fail("Int cannot represent a non-numeric value")
end
func _co_float(v: value.Value): CoerceResult:
if value.IsInt(v): ret _co_ok(value.ValueFloat(value.AsInt(v) as f64)) end
if value.IsFloat(v): ret _co_ok(v) end
ret _co_fail("Float cannot represent a non-numeric value")
end
func _co_string(v: value.Value): CoerceResult:
if value.IsString(v): ret _co_ok(v) end
ret _co_fail("String cannot represent a non-string value")
end
func _co_boolean(v: value.Value): CoerceResult:
if value.IsBool(v): ret _co_ok(v) end
ret _co_fail("Boolean cannot represent a non-boolean value")
end
func _co_id(v: value.Value): CoerceResult:
if value.IsString(v): ret _co_ok(v) end
if value.IsInt(v): ret _co_ok(value.ValueString(_co_int_str(value.AsInt(v)))) end
ret _co_fail("ID cannot represent a value that is neither a string nor an integer")
end
func _co_enum(t: TypeDef, v: value.Value): CoerceResult:
if not value.IsString(v):
ret _co_fail(_co_type_msg("Enum ", t.name, " cannot represent a non-string value"))
end
name := value.AsString(v)
if not HasEnumValue(t, name):
ret _co_fail(_co_type_msg("Enum ", t.name, " has no value named " + _gql_quote(name)))
end
ret _co_ok(v)
end
func _co_scalar(t: TypeDef, v: value.Value): CoerceResult:
if t.name == "Int": ret _co_int(v) end
if t.name == "Float": ret _co_float(v) end
if t.name == "String": ret _co_string(v) end
if t.name == "Boolean": ret _co_boolean(v) end
if t.name == "ID": ret _co_id(v) end
ret _co_ok(v)
end
func _co_input_object_field(sch: Schema, iv: InputValueDef, provided: value.Value, has: bool, out &: value.Value, name: str): str:
if has:
r := CoerceInput(sch, sch.doc, iv.typeRef, provided)
if not r.ok: ret "field " + _gql_quote(name) + ": " + r.message end
value.ObjectSet(out, name, r.value)
ret ""
end
if iv.hasDefault:
d := LiteralToValue(sch, sch.doc, iv.defaultValue, value.NewValueObject())
if d.ok: value.ObjectSet(out, name, d.value) end
ret ""
end
if TypeRefIsNonNull(sch.doc, iv.typeRef):
ret "field " + _gql_quote(name) + " of required type is missing"
end
ret ""
end
func _co_input_object(sch: Schema, t: TypeDef, v: value.Value): CoerceResult:
if not value.IsObject(v):
ret _co_fail(_co_type_msg("Input type ", t.name, " expects an object"))
end
mut out := value.NewValueObject()
mut i := 0
until i < t.inputFields.len():
iv := t.inputFields.get(i)
has := value.ObjectHas(v, iv.name)
msg := _co_input_object_field(sch, iv, value.ObjectGet(v, iv.name), has, out, iv.name)
if msg != "": ret _co_fail(msg) end
i += 1
end
mut keys := value.ObjectKeys(v)
defer keys.free()
mut j := 0
until j < keys.len():
k := keys.get(j)
if FindInputField(t, k).name == "":
ret _co_fail(_co_type_msg("Input type ", t.name, " has no field " + _gql_quote(k)))
end
j += 1
end
ret _co_ok(out)
end
func _co_list(sch: Schema, refDoc: Document, elemRef: int, v: value.Value): CoerceResult:
if not value.IsArray(v):
r := CoerceInput(sch, refDoc, elemRef, v)
if not r.ok: ret r end
mut single := value.NewValueArray()
value.ArrayPush(single, r.value)
ret _co_ok(single)
end
mut out := value.NewValueArray()
mut i := 0
until i < value.ArrayLen(v):
r := CoerceInput(sch, refDoc, elemRef, value.ArrayGet(v, i))
if not r.ok: ret _co_fail("at index " + _co_int_str(i as i64) + ": " + r.message) end
value.ArrayPush(out, r.value)
i += 1
end
ret _co_ok(out)
end
@en "LiteralToValue"
@fa "تبدیل لفظ به مقدار"
pub func LiteralToValue(sch: Schema, doc: Document, valueId: int, vars: value.Value): CoerceResult:
v := ValueAt(doc, valueId)
if v.kind == VAL_NULL: ret _co_ok(value.ValueNull()) end
if v.kind == VAL_BOOL: ret _co_ok(value.ValueBool(v.b)) end
if v.kind == VAL_INT: ret _co_ok(value.ValueInt(v.i)) end
if v.kind == VAL_FLOAT: ret _co_ok(value.ValueFloat(v.f)) end
if v.kind == VAL_STRING: ret _co_ok(value.ValueString(v.s)) end
if v.kind == VAL_ENUM: ret _co_ok(value.ValueString(v.s)) end
if v.kind == VAL_LIST: ret _co_literal_list(sch, doc, v, vars) end
if v.kind == VAL_OBJECT: ret _co_literal_object(sch, doc, v, vars) end
if v.kind == VAL_VARIABLE:
if _co_var_missing(vars, v.s): ret _co_ok(value.ValueNull()) end
ret _co_ok(value.ObjectGet(vars, v.s))
end
ret _co_fail("unsupported literal")
end
@en "CoerceInput"
@fa "تبدیل ورودی"
pub func CoerceInput(sch: Schema, refDoc: Document, typeRef: int, v: value.Value): CoerceResult:
t := TypeRefAt(refDoc, typeRef)
if value.IsNull(v):
if t.nonNull: ret _co_fail("expected a non-null value, found null") end
ret _co_ok(value.ValueNull())
end
if t.kind == TREF_LIST: ret _co_list(sch, refDoc, t.inner, v) end
def := FindType(sch, t.name)
if def.kind < 0: ret _co_fail("unknown type " + _gql_quote(t.name)) end
if def.kind == TYPE_SCALAR: ret _co_scalar(def, v) end
if def.kind == TYPE_ENUM: ret _co_enum(def, v) end
if def.kind == TYPE_INPUT_OBJECT: ret _co_input_object(sch, def, v) end
ret _co_fail(_co_type_msg("Type ", t.name, " is not an input type"))
end
@en "CoerceLeafResult"
@fa "تبدیل نتیجه برگ"
pub func CoerceLeafResult(sch: Schema, typeName: str, v: value.Value): CoerceResult:
def := FindType(sch, typeName)
if def.kind == TYPE_ENUM:
if value.IsString(v): ret _co_enum(def, v) end
ret _co_fail(_co_type_msg("Enum ", typeName, " cannot represent a non-string value"))
end
if def.kind == TYPE_SCALAR: ret _co_scalar(def, v) end
ret _co_fail(_co_type_msg("Type ", typeName, " is not a leaf type"))
end
package graphql
import encoding.value
@en "FieldGroup"
@fa "گروه فیلد"
pub struct FieldGroup:
pub key: str = ""
pub sels: Vector<int> = Vector {}
end
@en "FieldGroups"
@fa "گروه‌های فیلد"
pub struct FieldGroups:
pub items: Vector<FieldGroup> = Vector {}
end
func _cl_group_index(gs: FieldGroups, key: str): int:
mut i := 0
until i < gs.items.len():
if gs.items.get(i).key == key: ret i end
i += 1
end
ret 0 - 1
end
func _cl_add(gs &: FieldGroups, key: str, selId: int):
idx := _cl_group_index(gs, key)
if idx >= 0:
mut g := gs.items.get(idx)
g.sels.push(selId)
gs.items.set(idx, g)
ret
end
mut g := FieldGroup {}
g.key = key
g.sels.push(selId)
gs.items.push(g)
end
func _cl_visited(names: Vector<str>, name: str): bool:
mut i := 0
until i < names.len():
if names.get(i) == name: ret true end
i += 1
end
ret false
end
func _cl_directive_if(sch: Schema, doc: Document, d: AstDirective, vars: value.Value, fallback: bool): bool:
mut i := 0
until i < d.args.len():
a := d.args.get(i)
if a.name == "if":
r := LiteralToValue(sch, doc, a.value, vars)
if r.ok and value.IsBool(r.value): ret value.AsBool(r.value) end
ret fallback
end
i += 1
end
ret fallback
end
func _cl_should_include(sch: Schema, doc: Document, ds: Vector<AstDirective>, vars: value.Value): bool:
mut keep := true
mut i := 0
until i < ds.len():
d := ds.get(i)
if d.name == "skip":
if _cl_directive_if(sch, doc, d, vars, false): ret false end
else d.name == "include":
if not _cl_directive_if(sch, doc, d, vars, true): keep = false end
end
i += 1
end
ret keep
end
func _cl_fragment_applies(sch: Schema, condition: str, objectType: str, hasCondition: bool): bool:
if not hasCondition: ret true end
ret IsPossibleType(sch, condition, objectType)
end
func _cl_visit_spread(sch: Schema, doc: Document, s: AstSelection, objectType: str, vars: value.Value, gs &: FieldGroups, visited &: Vector<str>):
if _cl_visited(visited, s.name): ret end
fragIdx := FindFragment(doc, s.name)
if fragIdx < 0: ret end
frag := doc.frags.get(fragIdx)
if not IsPossibleType(sch, frag.typeCondition, objectType): ret end
visited.push(s.name)
_cl_walk(sch, doc, frag.selections, objectType, vars, gs, visited)
end
func _cl_walk(sch: Schema, doc: Document, sels: Vector<int>, objectType: str, vars: value.Value, gs &: FieldGroups, visited &: Vector<str>):
mut i := 0
until i < sels.len():
selId := sels.get(i)
s := SelectionAt(doc, selId)
i += 1
if not _cl_should_include(sch, doc, s.directives, vars): continue end
if s.kind == SEL_FIELD:
_cl_add(gs, ResponseKey(s), selId)
else s.kind == SEL_FRAGMENT_SPREAD:
_cl_visit_spread(sch, doc, s, objectType, vars, gs, visited)
else:
if _cl_fragment_applies(sch, s.typeCondition, objectType, s.hasTypeCondition):
_cl_walk(sch, doc, s.selections, objectType, vars, gs, visited)
end
end
end
end
@en "CollectFields"
@fa "گردآوری فیلدها"
pub func CollectFields(sch: Schema, doc: Document, sels: Vector<int>, objectType: str, vars: value.Value): FieldGroups:
mut gs := FieldGroups {}
mut visited := Vector {} as Vector<str>
defer visited.free()
_cl_walk(sch, doc, sels, objectType, vars, gs, visited)
ret gs
end
@en "MergeSelections"
@fa "ادغام گزینش‌ها"
pub func MergeSelections(doc: Document, g: FieldGroup): Vector<int>:
mut out := Vector {} as Vector<int>
mut i := 0
until i < g.sels.len():
s := SelectionAt(doc, g.sels.get(i))
mut j := 0
until j < s.selections.len():
out.push(s.selections.get(j))
j += 1
end
i += 1
end
ret out
end
@en "FreeFieldGroups"
@fa "آزادسازی گروه‌های فیلد"
pub func FreeFieldGroups(gs &: FieldGroups):
mut i := 0
until i < gs.items.len():
mut g := gs.items.get(i)
g.sels.free()
i += 1
end
gs.items.free()
end
package graphql
import encoding.value
import str
@en "ERR_SYNTAX"
@fa "دسته خطای نحوی"
pub const ERR_SYNTAX := 0
@en "ERR_VALIDATION"
@fa "دسته خطای اعتبارسنجی"
pub const ERR_VALIDATION := 1
@en "ERR_EXECUTION"
@fa "دسته خطای اجرا"
pub const ERR_EXECUTION := 2
@en "ERR_REQUEST"
@fa "دسته خطای درخواست"
pub const ERR_REQUEST := 3
@en "GqlError"
@fa "خطای گراف‌کیوال"
pub struct GqlError:
pub category: int = ERR_EXECUTION
pub message: str = ""
pub line: int = 0
pub col: int = 0
pub hasLocation: bool = false
pub pathKeys: Vector<str> = Vector {}
pub pathIndex: Vector<int> = Vector {}
pub code: str = ""
end
@en "ErrorList"
@fa "فهرست خطا"
pub struct GqlErrorList:
pub items: Vector<GqlError> = Vector {}
end
func _path_value(e: GqlError): value.Value:
mut arr := value.NewValueArray()
mut i := 0
until i < e.pathKeys.len():
idx := e.pathIndex.get(i)
if idx >= 0:
value.ArrayPush(arr, value.ValueInt(idx as i64))
else:
value.ArrayPush(arr, value.ValueString(e.pathKeys.get(i)))
end
i += 1
end
ret arr
end
func _locations_value(e: GqlError): value.Value:
mut loc := value.NewValueObject()
value.ObjectSet(loc, "line", value.ValueInt(e.line as i64))
value.ObjectSet(loc, "column", value.ValueInt(e.col as i64))
mut arr := value.NewValueArray()
value.ArrayPush(arr, loc)
ret arr
end
func _gql_quote(s: str): str:
mut sb := str.NewBuilder()
defer str.BufFree(sb)
str.BufAppendChar(sb, 34)
str.BufAppend(sb, s)
str.BufAppendChar(sb, 34)
ret str.BufStr(sb)
end
func _gql_describe_token(t: GqlToken): str:
if t.kind == TOK_EOF: ret "<EOF>" end
if t.kind == TOK_NAME: ret _gql_quote(t.lexeme) end
if t.kind == TOK_INT or t.kind == TOK_FLOAT: ret t.lexeme end
if IsStringToken(t.kind): ret "a string value" end
if t.kind == TOK_ERROR: ret t.sval end
ret _gql_quote(TokenKindName(t.kind))
end
func _gql_expected_msg(want: str, found: GqlToken): str:
mut sb := str.NewBuilder()
defer str.BufFree(sb)
str.BufAppend(sb, "expected ")
str.BufAppend(sb, want)
str.BufAppend(sb, ", found ")
str.BufAppend(sb, _gql_describe_token(found))
ret str.BufStr(sb)
end
func _gql_unexpected_msg(found: GqlToken): str:
mut sb := str.NewBuilder()
defer str.BufFree(sb)
str.BufAppend(sb, "unexpected ")
str.BufAppend(sb, _gql_describe_token(found))
ret str.BufStr(sb)
end
@en "NewError"
@fa "خطای جدید"
pub func NewError(category: int, message: str): GqlError:
mut e := GqlError { category = category }
e.message = message
ret e
end
@en "NewErrorAt"
@fa "خطا در محل"
pub func NewErrorAt(category: int, message: str, line: int, col: int): GqlError:
mut e := NewError(category, message)
e.line = line
e.col = col
e.hasLocation = true
ret e
end
@en "SyntaxError"
@fa "خطای نحوی"
pub func SyntaxError(message: str, line: int, col: int): GqlError:
ret NewErrorAt(ERR_SYNTAX, message, line, col)
end
@en "PathPushKey"
@fa "افزودن کلید مسیر"
pub func PathPushKey(e &: GqlError, key: str):
e.pathKeys.push(key)
e.pathIndex.push(0 - 1)
end
@en "PathPushIndex"
@fa "افزودن نمایه مسیر"
pub func PathPushIndex(e &: GqlError, idx: int):
e.pathKeys.push("")
e.pathIndex.push(idx)
end
@en "PathLen"
@fa "طول مسیر"
pub func PathLen(e: GqlError): int: ret e.pathKeys.len() end
@en "PathString"
@fa "رشته مسیر"
pub func PathString(e: GqlError): str:
mut sb := str.NewBuilder()
defer str.BufFree(sb)
mut i := 0
until i < e.pathKeys.len():
if e.pathIndex.get(i) >= 0:
str.BufAppendChar(sb, 91)
str.BufAppendInt(sb, e.pathIndex.get(i) as i64)
str.BufAppendChar(sb, 93)
else:
if not str.BufIsEmpty(sb): str.BufAppendChar(sb, 46) end
str.BufAppend(sb, e.pathKeys.get(i))
end
i += 1
end
ret str.BufStr(sb)
end
@en "AddError"
@fa "افزودن خطا"
pub func AddError(list &: GqlErrorList, e: GqlError):
list.items.push(e)
end
@en "HasErrors"
@fa "خطا دارد"
pub func HasErrors(list: GqlErrorList): bool: ret list.items.len() > 0 end
@en "ErrorCount"
@fa "تعداد خطا"
pub func ErrorCount(list: GqlErrorList): int: ret list.items.len() end
@en "ErrorAt"
@fa "خطا در"
pub func ErrorAt(list: GqlErrorList, i: int): GqlError:
if i < 0 or i >= list.items.len(): ret GqlError {} end
ret list.items.get(i)
end
@en "ErrorString"
@fa "رشته خطا"
pub func ErrorString(e: GqlError): str:
mut sb := str.NewBuilder()
defer str.BufFree(sb)
str.BufAppend(sb, e.message)
if e.hasLocation:
str.BufAppend(sb, " (line ")
str.BufAppendInt(sb, e.line as i64)
str.BufAppend(sb, ", column ")
str.BufAppendInt(sb, e.col as i64)
str.BufAppendChar(sb, 41)
end
if PathLen(e) > 0:
str.BufAppend(sb, " at ")
str.BufAppend(sb, PathString(e))
end
ret str.BufStr(sb)
end
@en "ErrorToValue"
@fa "خطا به مقدار"
pub func ErrorToValue(e: GqlError): value.Value:
mut o := value.NewValueObject()
value.ObjectSet(o, "message", value.ValueString(e.message))
if e.hasLocation:
value.ObjectSet(o, "locations", _locations_value(e))
end
if PathLen(e) > 0:
value.ObjectSet(o, "path", _path_value(e))
end
if e.code != "":
mut ext := value.NewValueObject()
value.ObjectSet(ext, "code", value.ValueString(e.code))
value.ObjectSet(o, "extensions", ext)
end
ret o
end
@en "ErrorsToValue"
@fa "خطاها به مقدار"
pub func ErrorsToValue(list: GqlErrorList): value.Value:
mut arr := value.NewValueArray()
mut i := 0
until i < list.items.len():
value.ArrayPush(arr, ErrorToValue(list.items.get(i)))
i += 1
end
ret arr
end
@en "FreeError"
@fa "آزادسازی خطا"
pub func FreeError(e &: GqlError):
e.pathKeys.free()
e.pathIndex.free()
end
@en "FreeErrorList"
@fa "آزادسازی فهرست خطا"
pub func FreeErrorList(list &: GqlErrorList):
mut i := 0
until i < list.items.len():
mut e := list.items.get(i)
FreeError(e)
i += 1
end
list.items.free()
end
package graphql
import encoding.value
@en "Ex"
@fa "وضعیت اجرا"
pub struct Ex:
pub sch: Schema = Schema {}
pub doc: Document = Document {}
pub vars: value.Value = value.Value {}
pub ctx: value.Value = value.Value {}
pub errors: GqlErrorList = GqlErrorList {}
pub pathKeys: Vector<str> = Vector {}
pub pathIdx: Vector<int> = Vector {}
pub depth: int = 0
pub maxDepth: int = 512
end
func _ex_push_key(ex &: Ex, key: str):
ex.pathKeys.push(key)
ex.pathIdx.push(0 - 1)
end
func _ex_push_index(ex &: Ex, idx: int):
ex.pathKeys.push("")
ex.pathIdx.push(idx)
end
func _ex_pop(ex &: Ex):
if ex.pathKeys.len() == 0: ret end
ex.pathKeys.pop()
ex.pathIdx.pop()
end
func _ex_error(ex &: Ex, message: str, line: int, col: int):
mut e := NewError(ERR_EXECUTION, message)
if line > 0:
e.line = line
e.col = col
e.hasLocation = true
end
mut i := 0
until i < ex.pathKeys.len():
if ex.pathIdx.get(i) >= 0:
PathPushIndex(e, ex.pathIdx.get(i))
else:
PathPushKey(e, ex.pathKeys.get(i))
end
i += 1
end
AddError(ex.errors, e)
end
func _ex_arg_from_literal(ex &: Ex, argDef: InputValueDef, a: AstArgument, out &: value.Value, name: str): bool:
lit := LiteralToValue(ex.sch, ex.doc, a.value, ex.vars)
if not lit.ok:
_ex_error(ex, _gql_arg_msg(name, lit.message), a.line, 0)
ret false
end
co := CoerceInput(ex.sch, ex.sch.doc, argDef.typeRef, lit.value)
if not co.ok:
_ex_error(ex, _gql_arg_msg(name, co.message), a.line, 0)
ret false
end
value.ObjectSet(out, name, co.value)
ret true
end
func _ex_arg_supplied(ex: Ex, sel: AstSelection, name: str, found &: AstArgument): bool:
mut i := 0
until i < sel.args.len():
a := sel.args.get(i)
if a.name == name:
v := ValueAt(ex.doc, a.value)
if v.kind == VAL_VARIABLE and not value.ObjectHas(ex.vars, v.s): ret false end
found = a
ret true
end
i += 1
end
ret false
end
func _ex_default_arg(ex &: Ex, argDef: InputValueDef, out &: value.Value): bool:
if argDef.hasDefault:
d := LiteralToValue(ex.sch, ex.sch.doc, argDef.defaultValue, value.NewValueObject())
if d.ok: value.ObjectSet(out, argDef.name, d.value) end
ret true
end
if TypeRefIsNonNull(ex.sch.doc, argDef.typeRef):
_ex_error(ex, _gql_required_arg_msg(argDef.name), 0, 0)
ret false
end
ret true
end
func _ex_coerce_args(ex &: Ex, fieldDef: FieldDef, sel: AstSelection, ok &: bool): value.Value:
mut out := value.NewValueObject()
ok = true
mut i := 0
until i < fieldDef.args.len():
argDef := fieldDef.args.get(i)
mut a := AstArgument {}
if _ex_arg_supplied(ex, sel, argDef.name, a):
if not _ex_arg_from_literal(ex, argDef, a, out, argDef.name): ok = false end
else:
if not _ex_default_arg(ex, argDef, out): ok = false end
end
i += 1
end
ret out
end
func _ex_default_resolve(parent: value.Value, fieldName: str): value.Value:
if not value.IsObject(parent): ret value.ValueNull() end
if not value.ObjectHas(parent, fieldName): ret value.ValueNull() end
ret value.ObjectGet(parent, fieldName)
end
func _ex_call_resolver(ex &: Ex, fn: i64, parent: value.Value, args: value.Value, objectType: str, fieldName: str, failed &: bool, message &: str): value.Value:
slot := _rs_alloc()
_rs_prepare(slot, parent, args, ex.ctx, objectType, fieldName)
callhandler(fn, slot as i64)
s := _rs_at(slot as i64)
failed = s.failed
message = s.message
mut out := value.ValueNull()
if s.resolved and not s.failed: out = s.result end
_rs_release(slot)
ret out
end
func _ex_resolve_field(ex &: Ex, objectType: str, parent: value.Value, sel: AstSelection, args: value.Value, failed &: bool): value.Value:
failed = false
if sel.name == "__typename": ret value.ValueString(objectType) end
fn := _rs_lookup(ex.sch, objectType, sel.name)
if fn == 0: ret _ex_default_resolve(parent, sel.name) end
mut rfailed := false
mut msg := ""
out := _ex_call_resolver(ex, fn, parent, args, objectType, sel.name, rfailed, msg)
if rfailed:
_ex_error(ex, msg, sel.line, sel.col)
failed = true
ret value.ValueNull()
end
ret out
end
func _ex_resolve_abstract(ex &: Ex, abstractName: str, v: value.Value, sel: AstSelection): str:
if value.IsObject(v) and value.ObjectHas(v, "__typename"):
name := value.AsString(value.ObjectGet(v, "__typename"))
if IsPossibleType(ex.sch, abstractName, name): ret name end
_ex_error(ex, _gql_bad_typename_msg(name, abstractName), sel.line, sel.col)
ret ""
end
mut poss := PossibleTypes(ex.sch, abstractName)
defer poss.free()
if poss.len() == 1: ret poss.get(0) end
_ex_error(ex, _gql_no_typename_msg(abstractName), sel.line, sel.col)
ret ""
end
func _ex_complete_leaf(ex &: Ex, typeName: str, v: value.Value, sel: AstSelection): value.Value:
r := CoerceLeafResult(ex.sch, typeName, v)
if r.ok: ret r.value end
_ex_error(ex, r.message, sel.line, sel.col)
ret value.ValueNull()
end
func _ex_complete_list(ex &: Ex, elemRef: int, g: FieldGroup, v: value.Value, sel: AstSelection, bubble &: bool): value.Value:
if not value.IsArray(v):
_ex_error(ex, _gql_expected_list_msg(), sel.line, sel.col)
bubble = true
ret value.ValueNull()
end
mut out := value.NewValueArray()
mut i := 0
until i < value.ArrayLen(v):
_ex_push_index(ex, i)
mut itemBubble := false
item := _ex_complete_value(ex, elemRef, g, value.ArrayGet(v, i), sel, itemBubble)
_ex_pop(ex)
if itemBubble:
bubble = true
ret value.ValueNull()
end
value.ArrayPush(out, item)
i += 1
end
ret out
end
func _ex_complete_object(ex &: Ex, typeName: str, g: FieldGroup, v: value.Value, sel: AstSelection, bubble &: bool): value.Value:
mut concrete := typeName
if IsAbstractType(ex.sch, typeName):
concrete = _ex_resolve_abstract(ex, typeName, v, sel)
if concrete == "":
bubble = true
ret value.ValueNull()
end
end
mut sub := MergeSelections(ex.doc, g)
defer sub.free()
ret _ex_selection_set(ex, concrete, sub, v, bubble)
end
func _ex_complete_value(ex &: Ex, typeRef: int, g: FieldGroup, v: value.Value, sel: AstSelection, bubble &: bool): value.Value:
t := TypeRefAt(ex.sch.doc, typeRef)
if t.nonNull:
mut innerBubble := false
out := _ex_complete_nullable(ex, t, g, v, sel, innerBubble)
if innerBubble or value.IsNull(out):
if not innerBubble: _ex_error(ex, _gql_null_nonnull_msg(), sel.line, sel.col) end
bubble = true
ret value.ValueNull()
end
ret out
end
ret _ex_complete_nullable(ex, t, g, v, sel, bubble)
end
func _ex_complete_nullable(ex &: Ex, t: AstTypeRef, g: FieldGroup, v: value.Value, sel: AstSelection, bubble &: bool): value.Value:
if value.IsNull(v): ret value.ValueNull() end
if t.kind == TREF_LIST: ret _ex_complete_list(ex, t.inner, g, v, sel, bubble) end
if IsLeafType(ex.sch, t.name): ret _ex_complete_leaf(ex, t.name, v, sel) end
ret _ex_complete_object(ex, t.name, g, v, sel, bubble)
end
func _ex_typename_field(ex &: Ex, objectType: str, g: FieldGroup, out &: value.Value): bool:
s := SelectionAt(ex.doc, g.sels.get(0))
if s.name != "__typename": ret false end
value.ObjectSet(out, g.key, value.ValueString(objectType))
ret true
end
func _ex_introspection_field(ex &: Ex, objectType: str, g: FieldGroup, out &: value.Value): bool:
if objectType != ex.sch.queryType: ret false end
ret _in_root_field(ex, g, out)
end
func _ex_field(ex &: Ex, objectType: str, parent: value.Value, g: FieldGroup, out &: value.Value, bubble &: bool): bool:
sel := SelectionAt(ex.doc, g.sels.get(0))
fieldDef := _ex_field_def(ex, objectType, sel.name)
if fieldDef.typeRef < 0:
_ex_error(ex, _gql_unknown_field_msg(sel.name, objectType), sel.line, sel.col)
ret false
end
_ex_push_key(ex, g.key)
mut argsOk := true
args := _ex_coerce_args(ex, fieldDef, sel, argsOk)
mut resolveFailed := false
mut raw := value.ValueNull()
if argsOk:
raw = _ex_resolve_field(ex, objectType, parent, sel, args, resolveFailed)
end
if not argsOk or resolveFailed:
_ex_pop(ex)
if TypeRefIsNonNull(ex.sch.doc, fieldDef.typeRef):
bubble = true
ret false
end
value.ObjectSet(out, g.key, value.ValueNull())
ret true
end
mut fieldBubble := false
completed := _ex_complete_value(ex, fieldDef.typeRef, g, raw, sel, fieldBubble)
_ex_pop(ex)
if fieldBubble:
bubble = true
ret false
end
value.ObjectSet(out, g.key, completed)
ret true
end
func _ex_field_def(ex: Ex, objectType: str, fieldName: str): FieldDef:
t := FindType(ex.sch, objectType)
f := FindField(t, fieldName)
if f.name != "": ret f end
mut i := 0
until i < t.interfaces.len():
it := FindType(ex.sch, t.interfaces.get(i))
itf := FindField(it, fieldName)
if itf.name != "": ret itf end
i += 1
end
ret FieldDef { typeRef = 0 - 1 }
end
func _ex_selection_set(ex &: Ex, objectType: str, sels: Vector<int>, parent: value.Value, bubble &: bool): value.Value:
ex.depth += 1
if ex.depth > ex.maxDepth:
ex.depth -= 1
_ex_error(ex, _gql_depth_msg(ex.maxDepth), 0, 0)
bubble = true
ret value.ValueNull()
end
mut gs := CollectFields(ex.sch, ex.doc, sels, objectType, ex.vars)
defer FreeFieldGroups(gs)
mut out := value.NewValueObject()
mut i := 0
until i < gs.items.len():
g := gs.items.get(i)
mut childBubble := false
if not _ex_typename_field(ex, objectType, g, out) and not _ex_introspection_field(ex, objectType, g, out):
_ex_field(ex, objectType, parent, g, out, childBubble)
end
if childBubble:
ex.depth -= 1
bubble = true
ret value.ValueNull()
end
i += 1
end
ex.depth -= 1
ret out
end
func _ex_var_missing(ex &: Ex, vd: AstVariableDef, out &: value.Value): bool:
if vd.hasDefault:
d := LiteralToValue(ex.sch, ex.doc, vd.defaultValue, value.NewValueObject())
if d.ok: value.ObjectSet(out, vd.name, d.value) end
ret true
end
if TypeRefIsNonNull(ex.doc, vd.typeRef):
_ex_error(ex, _gql_required_var_msg(vd.name), vd.line, 0)
ret false
end
ret true
end
func _ex_var_type_known(ex: Ex, vd: AstVariableDef): bool:
ret HasType(ex.sch, TypeRefName(ex.doc, vd.typeRef))
end
func _ex_coerce_variables(ex &: Ex, op: AstOperation, raw: value.Value, ok &: bool): value.Value:
mut out := value.NewValueObject()
ok = true
mut i := 0
until i < op.varDefs.len():
vd := op.varDefs.get(i)
i += 1
if not value.ObjectHas(raw, vd.name):
if not _ex_var_missing(ex, vd, out): ok = false end
continue
end
if not _ex_var_type_known(ex, vd):
_ex_error(ex, _gql_bad_var_type_msg(vd.name), vd.line, 0)
ok = false
continue
end
r := CoerceInput(ex.sch, ex.doc, vd.typeRef, value.ObjectGet(raw, vd.name))
if not r.ok:
_ex_error(ex, _gql_var_msg(vd.name, r.message), vd.line, 0)
ok = false
continue
end
value.ObjectSet(out, vd.name, r.value)
end
ret out
end
package graphql
import encoding.value
import encoding.json
import encoding.query
import encoding.encerr
import str
@en "HttpRequest"
@fa "درخواست وب"
pub struct GqlHttpRequest:
pub query: str = ""
pub operationName: str = ""
pub variables: value.Value = value.Value {}
pub extensions: value.Value = value.Value {}
pub ok: bool = true
pub error: str = ""
end
@en "HttpResponse"
@fa "پاسخ وب"
pub struct GqlHttpResponse:
pub status: int = 200
pub contentType: str = "application/json"
pub body: str = ""
end
func _ht_bad(message: str): GqlHttpRequest:
mut r := GqlHttpRequest {}
r.ok = false
r.error = message
r.variables = value.NewValueObject()
r.extensions = value.NewValueObject()
ret r
end
func _ht_empty(): GqlHttpRequest:
mut r := GqlHttpRequest {}
r.variables = value.NewValueObject()
r.extensions = value.NewValueObject()
ret r
end
func _ht_object_param(v: value.Value): value.Value:
if value.IsObject(v): ret v end
if value.IsString(v):
mut err := encerr.NoError()
parsed := json.Decode(value.AsString(v), err)
if not encerr.IsError(err) and value.IsObject(parsed): ret parsed end
end
ret value.NewValueObject()
end
func _ht_str_param(v: value.Value): str:
if value.IsString(v): ret value.AsString(v) end
ret ""
end
func _ht_media_type(contentType: str): str:
mut out := ""
bp := _gbp(contentType)
mut i := 0
until i < contentType.len():
c := _gub(bp, i)
if c == 59 or c == 32: break end
out = out + contentType.substr(i, 1)
i += 1
end
ret str.Lower(out)
end
func _ht_from_json(body: str): GqlHttpRequest:
mut err := encerr.NoError()
parsed := json.Decode(body, err)
if encerr.IsError(err): ret _ht_bad("request body is not valid JSON") end
if not value.IsObject(parsed): ret _ht_bad("request body must be a JSON object") end
mut r := _ht_empty()
r.query = _ht_str_param(value.ObjectGet(parsed, "query"))
r.operationName = _ht_str_param(value.ObjectGet(parsed, "operationName"))
if value.ObjectHas(parsed, "variables"):
r.variables = _ht_object_param(value.ObjectGet(parsed, "variables"))
end
if value.ObjectHas(parsed, "extensions"):
r.extensions = _ht_object_param(value.ObjectGet(parsed, "extensions"))
end
if r.query == "": ret _ht_bad("the request is missing a query") end
ret r
end
func _ht_from_query_string(qs: str): GqlHttpRequest:
mut r := _ht_empty()
r.query = query.Get(qs, "query")
r.operationName = query.Get(qs, "operationName")
if query.Has(qs, "variables"):
r.variables = _ht_object_param(value.ValueString(query.Get(qs, "variables")))
end
if query.Has(qs, "extensions"):
r.extensions = _ht_object_param(value.ValueString(query.Get(qs, "extensions")))
end
if r.query == "": ret _ht_bad("the request is missing a query") end
ret r
end
func _ht_is_query_only(source: str): bool:
mut err := GqlError {}
mut doc := Parse(source, err)
defer FreeDocument(doc)
if err.message != "": ret true end
mut i := 0
until i < doc.ops.len():
if doc.ops.get(i).optype != OP_QUERY: ret false end
i += 1
end
ret true
end
func _ht_response(status: int, body: str): GqlHttpResponse:
mut r := GqlHttpResponse {}
r.status = status
r.body = body
ret r
end
func _ht_error_body(message: str): str:
mut errs := GqlErrorList {}
AddError(errs, NewError(ERR_REQUEST, message))
mut o := value.NewValueObject()
value.ObjectSet(o, "errors", ErrorsToValue(errs))
out := json.EncodeDefault(o)
FreeErrorList(errs)
ret out
end
@en "ParseHttpRequest"
@fa "تجزیه درخواست وب"
pub func ParseHttpRequest(method: str, contentType: str, body: str, queryString: str): GqlHttpRequest:
m := str.Upper(method)
if m == "GET": ret _ht_from_query_string(queryString) end
if m != "POST": ret _ht_bad("only GET and POST are supported") end
media := _ht_media_type(contentType)
if media == "application/graphql":
mut r := _ht_empty()
r.query = body
if r.query == "": ret _ht_bad("the request is missing a query") end
ret r
end
ret _ht_from_json(body)
end
@en "ParseHttpRequestJSON"
@fa "تجزیه درخواست جیسون"
pub func ParseHttpRequestJSON(body: str): GqlHttpRequest: ret _ht_from_json(body) end
@en "HandleRequest"
@fa "رسیدگی به درخواست"
pub func HandleRequest(sch: Schema, req: GqlHttpRequest, rootValue: value.Value, ctx: value.Value): ExecutionResult:
ret ExecuteSource(sch, req.query, req.operationName, req.variables, rootValue, ctx)
end
@en "HandleHttp"
@fa "رسیدگی به وب"
pub func HandleHttp(sch: Schema, method: str, contentType: str, body: str, queryString: str, rootValue: value.Value, ctx: value.Value): GqlHttpResponse:
req := ParseHttpRequest(method, contentType, body, queryString)
if not req.ok: ret _ht_response(400, _ht_error_body(req.error)) end
if str.Upper(method) == "GET" and not _ht_is_query_only(req.query):
ret _ht_response(405, _ht_error_body("only query operations are allowed over GET"))
end
mut result := HandleRequest(sch, req, rootValue, ctx)
out := ResultToJSON(result)
mut status := 200
if not result.hasData: status = 400 end
FreeResult(result)
ret _ht_response(status, out)
end
@en "HandleHttpSimple"
@fa "رسیدگی ساده به وب"
pub func HandleHttpSimple(sch: Schema, method: str, contentType: str, body: str, queryString: str): GqlHttpResponse:
ret HandleHttp(sch, method, contentType, body, queryString, value.NewValueObject(), value.NewValueObject())
end
@en "FreeHttpRequest"
@fa "آزادسازی درخواست وب"
pub func FreeHttpRequest(req &: GqlHttpRequest):
value.ValueFree(req.variables)
value.ValueFree(req.extensions)
end
package graphql
func _in_sdl(): str:
ret `
type __Schema {
  description: String
  types: [__Type!]!
  queryType: __Type!
  mutationType: __Type
  subscriptionType: __Type
  directives: [__Directive!]!
}

type __Type {
  kind: __TypeKind!
  name: String
  description: String
  specifiedByURL: String
  fields(includeDeprecated: Boolean = false): [__Field!]
  interfaces: [__Type!]
  possibleTypes: [__Type!]
  enumValues(includeDeprecated: Boolean = false): [__EnumValue!]
  inputFields(includeDeprecated: Boolean = false): [__InputValue!]
  ofType: __Type
}

type __Field {
  name: String!
  description: String
  args(includeDeprecated: Boolean = false): [__InputValue!]!
  type: __Type!
  isDeprecated: Boolean!
  deprecationReason: String
}

type __InputValue {
  name: String!
  description: String
  type: __Type!
  defaultValue: String
  isDeprecated: Boolean!
  deprecationReason: String
}

type __EnumValue {
  name: String!
  description: String
  isDeprecated: Boolean!
  deprecationReason: String
}

type __Directive {
  name: String!
  description: String
  locations: [__DirectiveLocation!]!
  args(includeDeprecated: Boolean = false): [__InputValue!]!
  isRepeatable: Boolean!
}

enum __TypeKind {
  SCALAR
  OBJECT
  INTERFACE
  UNION
  ENUM
  INPUT_OBJECT
  LIST
  NON_NULL
}

enum __DirectiveLocation {
  QUERY
  MUTATION
  SUBSCRIPTION
  FIELD
  FRAGMENT_DEFINITION
  FRAGMENT_SPREAD
  INLINE_FRAGMENT
  VARIABLE_DEFINITION
  SCHEMA
  SCALAR
  OBJECT
  FIELD_DEFINITION
  ARGUMENT_DEFINITION
  INTERFACE
  UNION
  ENUM
  ENUM_VALUE
  INPUT_OBJECT
  INPUT_FIELD_DEFINITION
}
`
end
func _in_kind_name(kind: int): str:
if kind == TYPE_OBJECT: ret "OBJECT" end
if kind == TYPE_INTERFACE: ret "INTERFACE" end
if kind == TYPE_UNION: ret "UNION" end
if kind == TYPE_ENUM: ret "ENUM" end
if kind == TYPE_INPUT_OBJECT: ret "INPUT_OBJECT" end
ret "SCALAR"
end
func _in_is_reserved(name: str): bool:
if name.len() < 2: ret false end
ret name.substr(0, 2) == "__"
end
@en "IsIntrospectionType"
@fa "نوع درون‌نگری است"
pub func IsIntrospectionType(name: str): bool: ret _in_is_reserved(name) end
@en "AddIntrospectionTypes"
@fa "افزودن انواع درون‌نگری"
pub func AddIntrospectionTypes(sch &: Schema):
mut err := GqlError {}
ParseSchemaInto(sch, _in_sdl(), err)
end
package graphql
import encoding.value
func _in_bool(includeDeprecated: bool): bool: ret includeDeprecated end
func _in_include_deprecated(ex &: Ex, sel: AstSelection): bool:
mut i := 0
until i < sel.args.len():
a := sel.args.get(i)
if a.name == "includeDeprecated":
r := LiteralToValue(ex.sch, ex.doc, a.value, ex.vars)
if r.ok and value.IsBool(r.value): ret value.AsBool(r.value) end
end
i += 1
end
ret false
end
func _in_str_or_null(s: str): value.Value:
if s == "": ret value.ValueNull() end
ret value.ValueString(s)
end
func _in_input_value(ex &: Ex, iv: InputValueDef, sels: Vector<int>): value.Value:
mut gs := CollectFields(ex.sch, ex.doc, sels, "__InputValue", ex.vars)
defer FreeFieldGroups(gs)
mut out := value.NewValueObject()
mut i := 0
until i < gs.items.len():
g := gs.items.get(i)
i += 1
s := SelectionAt(ex.doc, g.sels.get(0))
if s.name == "name": value.ObjectSet(out, g.key, value.ValueString(iv.name))
else s.name == "description": value.ObjectSet(out, g.key, _in_str_or_null(iv.description))
else s.name == "type":
value.ObjectSet(out, g.key, _in_type_from_ref(ex, iv.typeRef, MergeSelections(ex.doc, g)))
else s.name == "defaultValue":
value.ObjectSet(out, g.key, _in_default_value(ex, iv))
else s.name == "isDeprecated": value.ObjectSet(out, g.key, value.ValueBool(iv.is_deprecated))
else s.name == "deprecationReason": value.ObjectSet(out, g.key, _in_str_or_null(iv.deprecationReason))
else s.name == "__typename": value.ObjectSet(out, g.key, value.ValueString("__InputValue"))
end
end
ret out
end
func _in_default_value(ex &: Ex, iv: InputValueDef): value.Value:
if not iv.hasDefault: ret value.ValueNull() end
ret value.ValueString(PrintValue(ex.sch.doc, iv.defaultValue))
end
func _in_input_values(ex &: Ex, defs: Vector<InputValueDef>, sels: Vector<int>, includeDeprecated: bool): value.Value:
mut out := value.NewValueArray()
mut i := 0
until i < defs.len():
iv := defs.get(i)
i += 1
if iv.is_deprecated and not includeDeprecated: continue end
value.ArrayPush(out, _in_input_value(ex, iv, sels))
end
ret out
end
func _in_field(ex &: Ex, f: FieldDef, sels: Vector<int>): value.Value:
mut gs := CollectFields(ex.sch, ex.doc, sels, "__Field", ex.vars)
defer FreeFieldGroups(gs)
mut out := value.NewValueObject()
mut i := 0
until i < gs.items.len():
g := gs.items.get(i)
i += 1
s := SelectionAt(ex.doc, g.sels.get(0))
if s.name == "name": value.ObjectSet(out, g.key, value.ValueString(f.name))
else s.name == "description": value.ObjectSet(out, g.key, _in_str_or_null(f.description))
else s.name == "type":
value.ObjectSet(out, g.key, _in_type_from_ref(ex, f.typeRef, MergeSelections(ex.doc, g)))
else s.name == "args":
value.ObjectSet(out, g.key, _in_input_values(ex, f.args, MergeSelections(ex.doc, g), _in_include_deprecated(ex, s)))
else s.name == "isDeprecated": value.ObjectSet(out, g.key, value.ValueBool(f.is_deprecated))
else s.name == "deprecationReason": value.ObjectSet(out, g.key, _in_str_or_null(f.deprecationReason))
else s.name == "__typename": value.ObjectSet(out, g.key, value.ValueString("__Field"))
end
end
ret out
end
func _in_fields(ex &: Ex, t: TypeDef, sels: Vector<int>, includeDeprecated: bool): value.Value:
if t.kind != TYPE_OBJECT and t.kind != TYPE_INTERFACE: ret value.ValueNull() end
mut out := value.NewValueArray()
mut i := 0
until i < t.fields.len():
f := t.fields.get(i)
i += 1
if f.is_deprecated and not includeDeprecated: continue end
value.ArrayPush(out, _in_field(ex, f, sels))
end
ret out
end
func _in_enum_value(ex &: Ex, ev: EnumValueDef, sels: Vector<int>): value.Value:
mut gs := CollectFields(ex.sch, ex.doc, sels, "__EnumValue", ex.vars)
defer FreeFieldGroups(gs)
mut out := value.NewValueObject()
mut i := 0
until i < gs.items.len():
g := gs.items.get(i)
i += 1
s := SelectionAt(ex.doc, g.sels.get(0))
if s.name == "name": value.ObjectSet(out, g.key, value.ValueString(ev.name))
else s.name == "description": value.ObjectSet(out, g.key, _in_str_or_null(ev.description))
else s.name == "isDeprecated": value.ObjectSet(out, g.key, value.ValueBool(ev.is_deprecated))
else s.name == "deprecationReason": value.ObjectSet(out, g.key, _in_str_or_null(ev.deprecationReason))
else s.name == "__typename": value.ObjectSet(out, g.key, value.ValueString("__EnumValue"))
end
end
ret out
end
func _in_enum_values(ex &: Ex, t: TypeDef, sels: Vector<int>, includeDeprecated: bool): value.Value:
if t.kind != TYPE_ENUM: ret value.ValueNull() end
mut out := value.NewValueArray()
mut i := 0
until i < t.enumValues.len():
ev := t.enumValues.get(i)
i += 1
if ev.is_deprecated and not includeDeprecated: continue end
value.ArrayPush(out, _in_enum_value(ex, ev, sels))
end
ret out
end
func _in_named_types(ex &: Ex, names: Vector<str>, sels: Vector<int>): value.Value:
mut out := value.NewValueArray()
mut i := 0
until i < names.len():
value.ArrayPush(out, _in_type_named(ex, names.get(i), sels))
i += 1
end
ret out
end
func _in_interfaces(ex &: Ex, t: TypeDef, sels: Vector<int>): value.Value:
if t.kind != TYPE_OBJECT and t.kind != TYPE_INTERFACE: ret value.ValueNull() end
ret _in_named_types(ex, t.interfaces, sels)
end
func _in_possible_types(ex &: Ex, t: TypeDef, sels: Vector<int>): value.Value:
if t.kind != TYPE_INTERFACE and t.kind != TYPE_UNION: ret value.ValueNull() end
mut poss := PossibleTypes(ex.sch, t.name)
defer poss.free()
ret _in_named_types(ex, poss, sels)
end
func _in_input_fields(ex &: Ex, t: TypeDef, sels: Vector<int>, includeDeprecated: bool): value.Value:
if t.kind != TYPE_INPUT_OBJECT: ret value.ValueNull() end
ret _in_input_values(ex, t.inputFields, sels, includeDeprecated)
end
func _in_type_named(ex &: Ex, name: str, sels: Vector<int>): value.Value:
t := FindType(ex.sch, name)
if t.kind < 0: ret value.ValueNull() end
mut gs := CollectFields(ex.sch, ex.doc, sels, "__Type", ex.vars)
defer FreeFieldGroups(gs)
mut out := value.NewValueObject()
mut i := 0
until i < gs.items.len():
g := gs.items.get(i)
i += 1
_in_type_field(ex, t, g, out)
end
ret out
end
func _in_type_field(ex &: Ex, t: TypeDef, g: FieldGroup, out &: value.Value):
s := SelectionAt(ex.doc, g.sels.get(0))
if s.name == "kind": value.ObjectSet(out, g.key, value.ValueString(_in_kind_name(t.kind)))
else s.name == "name": value.ObjectSet(out, g.key, value.ValueString(t.name))
else s.name == "description": value.ObjectSet(out, g.key, _in_str_or_null(t.description))
else s.name == "specifiedByURL": value.ObjectSet(out, g.key, _in_str_or_null(t.specifiedByURL))
else s.name == "fields":
value.ObjectSet(out, g.key, _in_fields(ex, t, MergeSelections(ex.doc, g), _in_include_deprecated(ex, s)))
else s.name == "interfaces":
value.ObjectSet(out, g.key, _in_interfaces(ex, t, MergeSelections(ex.doc, g)))
else s.name == "possibleTypes":
value.ObjectSet(out, g.key, _in_possible_types(ex, t, MergeSelections(ex.doc, g)))
else s.name == "enumValues":
value.ObjectSet(out, g.key, _in_enum_values(ex, t, MergeSelections(ex.doc, g), _in_include_deprecated(ex, s)))
else s.name == "inputFields":
value.ObjectSet(out, g.key, _in_input_fields(ex, t, MergeSelections(ex.doc, g), _in_include_deprecated(ex, s)))
else s.name == "ofType": value.ObjectSet(out, g.key, value.ValueNull())
else s.name == "__typename": value.ObjectSet(out, g.key, value.ValueString("__Type"))
end
end
func _in_type_wrapper(ex &: Ex, kind: str, innerRef: int, innerPeeled: bool, sels: Vector<int>): value.Value:
mut gs := CollectFields(ex.sch, ex.doc, sels, "__Type", ex.vars)
defer FreeFieldGroups(gs)
mut out := value.NewValueObject()
mut i := 0
until i < gs.items.len():
g := gs.items.get(i)
i += 1
s := SelectionAt(ex.doc, g.sels.get(0))
if s.name == "kind": value.ObjectSet(out, g.key, value.ValueString(kind))
else s.name == "ofType":
value.ObjectSet(out, g.key, _in_type_ref(ex, innerRef, innerPeeled, MergeSelections(ex.doc, g)))
else s.name == "__typename": value.ObjectSet(out, g.key, value.ValueString("__Type"))
else:
value.ObjectSet(out, g.key, value.ValueNull())
end
end
ret out
end
func _in_type_ref(ex &: Ex, refId: int, peeled: bool, sels: Vector<int>): value.Value:
t := TypeRefAt(ex.sch.doc, refId)
if t.nonNull and not peeled:
ret _in_type_wrapper(ex, "NON_NULL", refId, true, sels)
end
if t.kind == TREF_LIST: ret _in_type_wrapper(ex, "LIST", t.inner, false, sels) end
ret _in_type_named(ex, t.name, sels)
end
func _in_type_from_ref(ex &: Ex, refId: int, sels: Vector<int>): value.Value:
ret _in_type_ref(ex, refId, false, sels)
end
func _in_directive(ex &: Ex, d: DirectiveDef, sels: Vector<int>): value.Value:
mut gs := CollectFields(ex.sch, ex.doc, sels, "__Directive", ex.vars)
defer FreeFieldGroups(gs)
mut out := value.NewValueObject()
mut i := 0
until i < gs.items.len():
g := gs.items.get(i)
i += 1
s := SelectionAt(ex.doc, g.sels.get(0))
if s.name == "name": value.ObjectSet(out, g.key, value.ValueString(d.name))
else s.name == "description": value.ObjectSet(out, g.key, _in_str_or_null(d.description))
else s.name == "isRepeatable": value.ObjectSet(out, g.key, value.ValueBool(d.repeatable))
else s.name == "locations": value.ObjectSet(out, g.key, _in_locations(d))
else s.name == "args":
value.ObjectSet(out, g.key, _in_input_values(ex, d.args, MergeSelections(ex.doc, g), _in_include_deprecated(ex, s)))
else s.name == "__typename": value.ObjectSet(out, g.key, value.ValueString("__Directive"))
end
end
ret out
end
func _in_locations(d: DirectiveDef): value.Value:
mut out := value.NewValueArray()
mut i := 0
until i < d.locations.len():
value.ArrayPush(out, value.ValueString(d.locations.get(i)))
i += 1
end
ret out
end
func _in_all_types(ex &: Ex, sels: Vector<int>): value.Value:
mut out := value.NewValueArray()
mut i := 0
until i < TypeCount(ex.sch):
t := TypeAt(ex.sch, i)
i += 1
if _in_is_reserved(t.name): continue end
value.ArrayPush(out, _in_type_named(ex, t.name, sels))
end
ret out
end
func _in_all_directives(ex &: Ex, sels: Vector<int>): value.Value:
mut out := value.NewValueArray()
mut i := 0
until i < ex.sch.directives.len():
value.ArrayPush(out, _in_directive(ex, ex.sch.directives.get(i), sels))
i += 1
end
ret out
end
func _in_root_type(ex &: Ex, name: str, sels: Vector<int>): value.Value:
if name == "" or not HasType(ex.sch, name): ret value.ValueNull() end
ret _in_type_named(ex, name, sels)
end
func _in_schema_value(ex &: Ex, sels: Vector<int>): value.Value:
mut gs := CollectFields(ex.sch, ex.doc, sels, "__Schema", ex.vars)
defer FreeFieldGroups(gs)
mut out := value.NewValueObject()
mut i := 0
until i < gs.items.len():
g := gs.items.get(i)
i += 1
s := SelectionAt(ex.doc, g.sels.get(0))
if s.name == "description": value.ObjectSet(out, g.key, _in_str_or_null(ex.sch.description))
else s.name == "types": value.ObjectSet(out, g.key, _in_all_types(ex, MergeSelections(ex.doc, g)))
else s.name == "directives": value.ObjectSet(out, g.key, _in_all_directives(ex, MergeSelections(ex.doc, g)))
else s.name == "queryType":
value.ObjectSet(out, g.key, _in_root_type(ex, ex.sch.queryType, MergeSelections(ex.doc, g)))
else s.name == "mutationType":
value.ObjectSet(out, g.key, _in_root_type(ex, ex.sch.mutationType, MergeSelections(ex.doc, g)))
else s.name == "subscriptionType":
value.ObjectSet(out, g.key, _in_root_type(ex, ex.sch.subscriptionType, MergeSelections(ex.doc, g)))
else s.name == "__typename": value.ObjectSet(out, g.key, value.ValueString("__Schema"))
end
end
ret out
end
func _in_type_arg(ex &: Ex, sel: AstSelection): str:
mut i := 0
until i < sel.args.len():
a := sel.args.get(i)
if a.name == "name":
r := LiteralToValue(ex.sch, ex.doc, a.value, ex.vars)
if r.ok and value.IsString(r.value): ret value.AsString(r.value) end
end
i += 1
end
ret ""
end
func _in_root_field(ex &: Ex, g: FieldGroup, out &: value.Value): bool:
s := SelectionAt(ex.doc, g.sels.get(0))
if s.name != "__schema" and s.name != "__type": ret false end
mut sub := MergeSelections(ex.doc, g)
if s.name == "__schema":
value.ObjectSet(out, g.key, _in_schema_value(ex, sub))
sub.free()
ret true
end
name := _in_type_arg(ex, s)
if HasType(ex.sch, name):
value.ObjectSet(out, g.key, _in_type_named(ex, name, sub))
else:
value.ObjectSet(out, g.key, value.ValueNull())
end
defer sub.free()
ret true
end
func _vs_introspection_field(vx &: Vx, s: AstSelection, parentType: str): bool:
if s.name != "__schema" and s.name != "__type": ret false end
if parentType != vx.sch.queryType:
_vx_error(vx, _gql_unknown_field_msg(s.name, parentType), s.line, s.col)
ret true
end
if s.name == "__schema":
_vs_walk(vx, s.selections, "__Schema")
ret true
end
_vs_walk(vx, s.selections, "__Type")
ret true
end
package graphql
import str
struct GqlLx:
pub s: str = ""
pub n: int = 0
pub pos: int = 0
pub line: int = 1
pub lineStart: int = 0
end
inline pure func _gbp(s: str): i8*: ret (s as void*) as i8* end
inline pure func _gub(bp: i8*, i: int): int:
mut v := bp[i] as int
if v < 0: v = v + 256 end
ret v
end
func _gql_is_digit(c: int): bool: ret c >= 48 and c <= 57 end
func _gql_is_name_start(c: int): bool:
ret (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95
end
func _gql_is_name_cont(c: int): bool:
ret _gql_is_name_start(c) or _gql_is_digit(c)
end
func _lx_at(lx: GqlLx, off: int): int:
p := lx.pos + off
if p >= lx.n or p < 0: ret -1 end
ret _gub(_gbp(lx.s), p)
end
func _lx_cur(lx: GqlLx): int: ret _lx_at(lx, 0) end
func _lx_col(lx: GqlLx): int: ret lx.pos - lx.lineStart + 1 end
func _lx_newline(lx &: GqlLx):
if _lx_cur(lx) == 13 and _lx_at(lx, 1) == 10: lx.pos += 2
else:
lx.pos += 1
end
lx.line += 1
lx.lineStart = lx.pos
end
func _lx_skip_ignored(lx &: GqlLx):
until true:
c := _lx_cur(lx)
if c == 32 or c == 9 or c == 44:
lx.pos += 1
else c == 10 or c == 13:
_lx_newline(lx)
else c == 35:
until true:
d := _lx_cur(lx)
if d == -1 or d == 10 or d == 13: break end
lx.pos += 1
end
else c == 239 and _lx_at(lx, 1) == 187 and _lx_at(lx, 2) == 191:
lx.pos += 3
else:
ret
end
end
end
func _lx_make(kind: int, startLine: int, startCol: int, startPos: int): GqlToken:
mut t := GqlToken { kind = kind }
t.line = startLine
t.col = startCol
t.pos = startPos
ret t
end
func _lx_error(lx &: GqlLx, msg: str, startLine: int, startCol: int): GqlToken:
mut t := GqlToken { kind = TOK_ERROR }
t.sval = msg
t.line = startLine
t.col = startCol
t.pos = lx.pos
ret t
end
func _lx_name(lx &: GqlLx): GqlToken:
startLine := lx.line
startCol := _lx_col(lx)
start := lx.pos
until _gql_is_name_cont(_lx_cur(lx)):
lx.pos += 1
end
mut t := _lx_make(TOK_NAME, startLine, startCol, start)
t.lexeme = lx.s.substr(start, lx.pos - start)
ret t
end
func _lx_number(lx &: GqlLx): GqlToken:
startLine := lx.line
startCol := _lx_col(lx)
start := lx.pos
if _lx_cur(lx) == 45: lx.pos += 1 end
if _lx_cur(lx) == 48:
lx.pos += 1
if _gql_is_digit(_lx_cur(lx)):
ret _lx_error(lx, "invalid number: unexpected digit after 0", startLine, startCol)
end
else:
if not _gql_is_digit(_lx_cur(lx)):
ret _lx_error(lx, "invalid number: expected digit", startLine, startCol)
end
until _gql_is_digit(_lx_cur(lx)):
lx.pos += 1
end
end
mut isFloat := false
if _lx_cur(lx) == 46 and _gql_is_digit(_lx_at(lx, 1)):
isFloat = true
lx.pos += 1
until _gql_is_digit(_lx_cur(lx)):
lx.pos += 1
end
end
if _lx_cur(lx) == 101 or _lx_cur(lx) == 69:
isFloat = true
lx.pos += 1
if _lx_cur(lx) == 43 or _lx_cur(lx) == 45: lx.pos += 1 end
if not _gql_is_digit(_lx_cur(lx)):
ret _lx_error(lx, "invalid number: expected exponent digits", startLine, startCol)
end
until _gql_is_digit(_lx_cur(lx)):
lx.pos += 1
end
end
if _gql_is_name_start(_lx_cur(lx)) or _lx_cur(lx) == 46:
ret _lx_error(lx, "invalid number: unexpected trailing character", startLine, startCol)
end
text := lx.s.substr(start, lx.pos - start)
if isFloat:
mut t := _lx_make(TOK_FLOAT, startLine, startCol, start)
t.lexeme = text
t.fval = text.to_float()
ret t
end
mut t := _lx_make(TOK_INT, startLine, startCol, start)
t.lexeme = text
t.ival = text.to_int() as i64
ret t
end
func _lx_escape(lx &: GqlLx, sb &: str.StringBuilder, msg &: str): bool:
e := _lx_cur(lx)
if e == 34: str.BufAppendChar(sb, 34) lx.pos += 1 ret true end
if e == 92: str.BufAppendChar(sb, 92) lx.pos += 1 ret true end
if e == 47: str.BufAppendChar(sb, 47) lx.pos += 1 ret true end
if e == 98: str.BufAppendChar(sb, 8) lx.pos += 1 ret true end
if e == 102: str.BufAppendChar(sb, 12) lx.pos += 1 ret true end
if e == 110: str.BufAppendChar(sb, 10) lx.pos += 1 ret true end
if e == 114: str.BufAppendChar(sb, 13) lx.pos += 1 ret true end
if e == 116: str.BufAppendChar(sb, 9) lx.pos += 1 ret true end
if e == 117: ret _lx_unicode_escape(lx, sb, msg) end
msg = "invalid escape sequence in string"
ret false
end
func _lx_string(lx &: GqlLx): GqlToken:
startLine := lx.line
startCol := _lx_col(lx)
start := lx.pos
lx.pos += 1
mut sb := str.NewBuilder()
defer str.BufFree(sb)
until true:
c := _lx_cur(lx)
if c == -1 or c == 10 or c == 13:
ret _lx_error(lx, "unterminated string", startLine, startCol)
end
if c == 34:
lx.pos += 1
mut t := _lx_make(TOK_STRING, startLine, startCol, start)
t.sval = str.BufStr(sb)
ret t
end
if c == 92:
lx.pos += 1
mut msg := ""
if not _lx_escape(lx, sb, msg):
ret _lx_error(lx, msg, startLine, startCol)
end
else:
str.BufAppendChar(sb, c)
lx.pos += 1
end
end
end
func _lx_block_string(lx &: GqlLx): GqlToken:
startLine := lx.line
startCol := _lx_col(lx)
start := lx.pos
lx.pos += 3
mut sb := str.NewBuilder()
defer str.BufFree(sb)
until true:
c := _lx_cur(lx)
if c == -1:
ret _lx_error(lx, "unterminated block string", startLine, startCol)
end
if c == 92 and _lx_at(lx, 1) == 34 and _lx_at(lx, 2) == 34 and _lx_at(lx, 3) == 34:
str.BufAppend(sb, `"""`)
lx.pos += 4
else c == 34 and _lx_at(lx, 1) == 34 and _lx_at(lx, 2) == 34:
lx.pos += 3
mut t := _lx_make(TOK_BLOCK_STRING, startLine, startCol, start)
t.sval = _gql_dedent_block(str.BufStr(sb))
ret t
else c == 10 or c == 13:
_lx_newline(lx)
str.BufAppendChar(sb, 10)
else:
str.BufAppendChar(sb, c)
lx.pos += 1
end
end
end
func _lx_punct(lx &: GqlLx): GqlToken:
startLine := lx.line
startCol := _lx_col(lx)
start := lx.pos
c := _lx_cur(lx)
if c == 46:
if _lx_at(lx, 1) == 46 and _lx_at(lx, 2) == 46:
lx.pos += 3
ret _lx_make(TOK_SPREAD, startLine, startCol, start)
end
lx.pos += 1
ret _lx_error(lx, `expected "..." but found "."`, startLine, startCol)
end
k := _gql_punct_kind(c)
if k < 0:
lx.pos += 1
ret _lx_error(lx, _gql_bad_char_msg(c), startLine, startCol)
end
lx.pos += 1
ret _lx_make(k, startLine, startCol, start)
end
func _lx_next(lx &: GqlLx): GqlToken:
_lx_skip_ignored(lx)
c := _lx_cur(lx)
if c == -1:
ret _lx_make(TOK_EOF, lx.line, _lx_col(lx), lx.pos)
end
if _gql_is_name_start(c): ret _lx_name(lx) end
if _gql_is_digit(c) or c == 45: ret _lx_number(lx) end
if c == 34:
if _lx_at(lx, 1) == 34 and _lx_at(lx, 2) == 34: ret _lx_block_string(lx) end
ret _lx_string(lx)
end
ret _lx_punct(lx)
end
@en "Tokenize"
@fa "توکن‌سازی"
pub func Tokenize(source: str, ok &: bool): GqlTokenStream:
mut lx := GqlLx { s = source }
lx.n = source.len()
mut out := GqlTokenStream {}
ok = true
until true:
t := _lx_next(lx)
out.toks.push(t)
if t.kind == TOK_EOF: ret out end
if t.kind == TOK_ERROR: ok = false end
end
end
@en "LexOk"
@fa "تحلیل واژگانی موفق"
pub func LexOk(source: str): bool:
mut ok := true
mut ts := Tokenize(source, ok)
defer ts.toks.free()
ret ok
end
package graphql
import str
func _gql_punct_kind(c: int): int:
if c == 33: ret TOK_BANG end
if c == 36: ret TOK_DOLLAR end
if c == 38: ret TOK_AMP end
if c == 40: ret TOK_LPAREN end
if c == 41: ret TOK_RPAREN end
if c == 58: ret TOK_COLON end
if c == 61: ret TOK_EQUALS end
if c == 64: ret TOK_AT end
if c == 91: ret TOK_LBRACKET end
if c == 93: ret TOK_RBRACKET end
if c == 123: ret TOK_LBRACE end
if c == 125: ret TOK_RBRACE end
if c == 124: ret TOK_PIPE end
ret 0 - 1
end
func _gql_bad_char_msg(c: int): str:
if c == 39:
ret `unexpected single quote character ('), did you mean to use a double quote (")?`
end
ret "unexpected character in document"
end
func _gql_hex_val(c: int): int:
if c >= 48 and c <= 57: ret c - 48 end
if c >= 97 and c <= 102: ret c - 97 + 10 end
if c >= 65 and c <= 70: ret c - 65 + 10 end
ret 0 - 1
end
func _gql_append_utf8(sb &: str.StringBuilder, cp: int):
if cp < 0 or cp > 1114111: ret end
if cp < 128:
str.BufAppendChar(sb, cp)
else cp < 2048:
str.BufAppendChar(sb, 192 + (cp / 64))
str.BufAppendChar(sb, 128 + (cp % 64))
else cp < 65536:
str.BufAppendChar(sb, 224 + (cp / 4096))
str.BufAppendChar(sb, 128 + ((cp / 64) % 64))
str.BufAppendChar(sb, 128 + (cp % 64))
else:
str.BufAppendChar(sb, 240 + (cp / 262144))
str.BufAppendChar(sb, 128 + ((cp / 4096) % 64))
str.BufAppendChar(sb, 128 + ((cp / 64) % 64))
str.BufAppendChar(sb, 128 + (cp % 64))
end
end
func _lx_hex4(lx &: GqlLx): int:
mut v := 0
mut i := 0
until i < 4:
d := _gql_hex_val(_lx_at(lx, i))
if d < 0: ret 0 - 1 end
v = v * 16 + d
i += 1
end
lx.pos += 4
ret v
end
func _lx_hex_braced(lx &: GqlLx): int:
lx.pos += 1
mut v := 0
mut n := 0
until true:
c := _lx_cur(lx)
if c == 125:
lx.pos += 1
if n == 0: ret 0 - 1 end
ret v
end
d := _gql_hex_val(c)
if d < 0 or n >= 6: ret 0 - 1 end
v = v * 16 + d
n += 1
lx.pos += 1
end
end
func _lx_unicode_escape(lx &: GqlLx, sb &: str.StringBuilder, msg &: str): bool:
lx.pos += 1
if _lx_cur(lx) == 123:
cp := _lx_hex_braced(lx)
if cp < 0 or cp > 1114111:
msg = "invalid \\u{...} escape in string"
ret false
end
_gql_append_utf8(sb, cp)
ret true
end
hi := _lx_hex4(lx)
if hi < 0:
msg = "invalid \\u escape in string"
ret false
end
if hi >= 55296 and hi <= 56319 and _lx_cur(lx) == 92 and _lx_at(lx, 1) == 117:
save := lx.pos
lx.pos += 2
lo := _lx_hex4(lx)
if lo >= 56320 and lo <= 57343:
_gql_append_utf8(sb, 65536 + (hi - 55296) * 1024 + (lo - 56320))
ret true
end
lx.pos = save
end
_gql_append_utf8(sb, hi)
ret true
end
func _gql_line_indent(line: str): int:
n := line.len()
bp := _gbp(line)
mut i := 0
until i < n:
c := _gub(bp, i)
if c != 32 and c != 9: ret i end
i += 1
end
ret n
end
func _gql_is_blank(line: str): bool:
ret _gql_line_indent(line) == line.len()
end
func _gql_split_lines(s: str): Vector<str>:
ret s.split("\n")
end
func _gql_common_indent(lines: Vector<str>): int:
mut common := 0 - 1
mut i := 1
until i < lines.len():
line := lines.get(i)
if not _gql_is_blank(line):
ind := _gql_line_indent(line)
if common < 0 or ind < common: common = ind end
end
i += 1
end
ret common
end
func _gql_strip_indent(lines &: Vector<str>, common: int):
if common <= 0: ret end
mut i := 1
until i < lines.len():
line := lines.get(i)
if line.len() >= common:
lines.set(i, line.substr(common, line.len() - common))
else:
lines.set(i, "")
end
i += 1
end
end
func _gql_first_content(lines: Vector<str>): int:
mut i := 0
until i < lines.len():
if not _gql_is_blank(lines.get(i)): ret i end
i += 1
end
ret lines.len()
end
func _gql_last_content(lines: Vector<str>): int:
mut i := lines.len() - 1
until i >= 0:
if not _gql_is_blank(lines.get(i)): ret i end
i -= 1
end
ret 0 - 1
end
func _gql_dedent_block(raw: str): str:
mut lines := _gql_split_lines(raw)
defer lines.free()
_gql_strip_indent(lines, _gql_common_indent(lines))
first := _gql_first_content(lines)
last := _gql_last_content(lines)
if last < first: ret "" end
mut sb := str.NewBuilder()
defer str.BufFree(sb)
mut i := first
until i <= last:
if i > first: str.BufAppendChar(sb, 10) end
str.BufAppend(sb, lines.get(i))
i += 1
end
ret str.BufStr(sb)
end
package graphql
struct Ps:
pub toks: Vector<GqlToken> = Vector {}
pub pos: int = 0
pub failed: bool = false
pub err: GqlError = GqlError {}
pub depth: int = 0
end
func _ps_cur(ps: Ps): GqlToken:
if ps.pos >= ps.toks.len(): ret GqlToken {} end
ret ps.toks.get(ps.pos)
end
func _ps_kind(ps: Ps): int: ret _ps_cur(ps).kind end
func _ps_at(ps: Ps, kind: int): bool: ret _ps_kind(ps) == kind end
func _ps_at_name(ps: Ps, word: str): bool:
t := _ps_cur(ps)
ret t.kind == TOK_NAME and t.lexeme == word
end
func _ps_advance(ps &: Ps): GqlToken:
t := _ps_cur(ps)
if ps.pos < ps.toks.len() - 1: ps.pos += 1 end
ret t
end
func _ps_fail(ps &: Ps, message: str):
if ps.failed: ret end
t := _ps_cur(ps)
ps.failed = true
ps.err = SyntaxError(message, t.line, t.col)
end
func _ps_expect(ps &: Ps, kind: int): GqlToken:
if ps.failed: ret GqlToken {} end
if not _ps_at(ps, kind):
_ps_fail(ps, _gql_expected_msg(TokenKindName(kind), _ps_cur(ps)))
ret GqlToken {}
end
ret _ps_advance(ps)
end
func _ps_expect_name(ps &: Ps): str:
t := _ps_expect(ps, TOK_NAME)
ret t.lexeme
end
func _ps_expect_word(ps &: Ps, word: str):
if ps.failed: ret end
if not _ps_at_name(ps, word):
_ps_fail(ps, _gql_expected_msg(word, _ps_cur(ps)))
ret
end
_ps_advance(ps)
end
func _ps_skip(ps &: Ps, kind: int): bool:
if _ps_at(ps, kind):
_ps_advance(ps)
ret true
end
ret false
end
func _ps_enter(ps &: Ps): bool:
ps.depth += 1
if ps.depth > 256:
_ps_fail(ps, "the document nests deeper than 256 levels")
ret false
end
ret true
end
func _p_value(ps &: Ps, doc &: Document, isConst: bool): int:
mut id := 0 - 1
if _ps_enter(ps):
id = _p_value_body(ps, doc, isConst)
end
ps.depth -= 1
ret id
end
func _p_type_ref(ps &: Ps, doc &: Document): int:
mut id := 0 - 1
if _ps_enter(ps):
id = _p_type_ref_body(ps, doc)
end
ps.depth -= 1
ret id
end
func _p_selection_set(ps &: Ps, doc &: Document): Vector<int>:
if not _ps_enter(ps):
ps.depth -= 1
ret Vector {}
end
out := _p_selection_set_body(ps, doc)
ps.depth -= 1
ret out
end
func _p_value_body(ps &: Ps, doc &: Document, isConst: bool): int:
if ps.failed: ret 0 - 1 end
t := _ps_cur(ps)
if t.kind == TOK_DOLLAR: ret _p_variable_value(ps, doc, isConst) end
if t.kind == TOK_INT:
_ps_advance(ps)
mut v := AstValue { kind = VAL_INT }
v.i = t.ival
v.line = t.line
ret _doc_add_value(doc, v)
end
if t.kind == TOK_FLOAT:
_ps_advance(ps)
mut v := AstValue { kind = VAL_FLOAT }
v.f = t.fval
v.line = t.line
ret _doc_add_value(doc, v)
end
if IsStringToken(t.kind):
_ps_advance(ps)
mut v := AstValue { kind = VAL_STRING }
v.s = t.sval
v.line = t.line
ret _doc_add_value(doc, v)
end
if t.kind == TOK_LBRACKET: ret _p_list_value(ps, doc, isConst) end
if t.kind == TOK_LBRACE: ret _p_object_value(ps, doc, isConst) end
if t.kind == TOK_NAME: ret _p_name_value(ps, doc) end
_ps_fail(ps, _gql_expected_msg("Value", t))
ret 0 - 1
end
func _p_variable_value(ps &: Ps, doc &: Document, isConst: bool): int:
t := _ps_cur(ps)
if isConst:
_ps_fail(ps, "unexpected variable in constant position")
ret 0 - 1
end
_ps_advance(ps)
name := _ps_expect_name(ps)
if ps.failed: ret 0 - 1 end
mut v := AstValue { kind = VAL_VARIABLE }
v.s = name
v.line = t.line
ret _doc_add_value(doc, v)
end
func _p_name_value(ps &: Ps, doc &: Document): int:
t := _ps_advance(ps)
mut v := AstValue {}
v.line = t.line
if t.lexeme == "true":
v.kind = VAL_BOOL
v.b = true
else t.lexeme == "false":
v.kind = VAL_BOOL
v.b = false
else t.lexeme == "null":
v.kind = VAL_NULL
else:
v.kind = VAL_ENUM
v.s = t.lexeme
end
ret _doc_add_value(doc, v)
end
func _p_list_value(ps &: Ps, doc &: Document, isConst: bool): int:
t := _ps_expect(ps, TOK_LBRACKET)
mut items := Vector {} as Vector<int>
until not _ps_at(ps, TOK_RBRACKET):
if ps.failed or _ps_at(ps, TOK_EOF):
_ps_fail(ps, "unterminated list value")
items.free()
ret 0 - 1
end
items.push(_p_value(ps, doc, isConst))
end
_ps_advance(ps)
mut v := AstValue { kind = VAL_LIST }
v.items = items
v.line = t.line
ret _doc_add_value(doc, v)
end
func _p_object_value(ps &: Ps, doc &: Document, isConst: bool): int:
t := _ps_expect(ps, TOK_LBRACE)
mut items := Vector {} as Vector<int>
mut keys := Vector {} as Vector<str>
until not _ps_at(ps, TOK_RBRACE):
if ps.failed or _ps_at(ps, TOK_EOF):
_ps_fail(ps, "unterminated object value")
items.free()
keys.free()
ret 0 - 1
end
keys.push(_ps_expect_name(ps))
_ps_expect(ps, TOK_COLON)
items.push(_p_value(ps, doc, isConst))
end
_ps_advance(ps)
mut v := AstValue { kind = VAL_OBJECT }
v.items = items
v.keys = keys
v.line = t.line
ret _doc_add_value(doc, v)
end
func _p_type_ref_body(ps &: Ps, doc &: Document): int:
if ps.failed: ret 0 - 1 end
mut id := 0 - 1
if _ps_skip(ps, TOK_LBRACKET):
inner := _p_type_ref(ps, doc)
_ps_expect(ps, TOK_RBRACKET)
mut t := AstTypeRef { kind = TREF_LIST }
t.inner = inner
id = _doc_add_tref(doc, t)
else:
name := _ps_expect_name(ps)
if ps.failed: ret 0 - 1 end
mut t := AstTypeRef { kind = TREF_NAMED }
t.name = name
id = _doc_add_tref(doc, t)
end
if _ps_skip(ps, TOK_BANG):
mut t := doc.trefs.get(id)
t.nonNull = true
doc.trefs.set(id, t)
end
ret id
end
func _p_arguments(ps &: Ps, doc &: Document, isConst: bool): Vector<AstArgument>:
mut out := Vector {} as Vector<AstArgument>
if not _ps_at(ps, TOK_LPAREN): ret out end
_ps_advance(ps)
until not _ps_at(ps, TOK_RPAREN):
if ps.failed or _ps_at(ps, TOK_EOF):
_ps_fail(ps, "unterminated argument list")
ret out
end
t := _ps_cur(ps)
mut a := AstArgument {}
a.name = _ps_expect_name(ps)
a.line = t.line
_ps_expect(ps, TOK_COLON)
a.value = _p_value(ps, doc, isConst)
out.push(a)
end
_ps_advance(ps)
ret out
end
func _p_directives(ps &: Ps, doc &: Document, isConst: bool): Vector<AstDirective>:
mut out := Vector {} as Vector<AstDirective>
until _ps_at(ps, TOK_AT):
if ps.failed: ret out end
t := _ps_advance(ps)
mut d := AstDirective {}
d.name = _ps_expect_name(ps)
d.line = t.line
d.args = _p_arguments(ps, doc, isConst)
out.push(d)
end
ret out
end
func _p_selection_set_body(ps &: Ps, doc &: Document): Vector<int>:
mut out := Vector {} as Vector<int>
_ps_expect(ps, TOK_LBRACE)
if ps.failed: ret out end
until not _ps_at(ps, TOK_RBRACE):
if ps.failed or _ps_at(ps, TOK_EOF):
_ps_fail(ps, "unterminated selection set")
ret out
end
out.push(_p_selection(ps, doc))
end
_ps_advance(ps)
if out.len() == 0 and not ps.failed:
_ps_fail(ps, "a selection set must select at least one field")
end
ret out
end
func _p_selection(ps &: Ps, doc &: Document): int:
if _ps_at(ps, TOK_SPREAD): ret _p_spread(ps, doc) end
ret _p_field(ps, doc)
end
func _p_spread(ps &: Ps, doc &: Document): int:
t := _ps_advance(ps)
mut s := AstSelection {}
s.line = t.line
s.col = t.col
if _ps_at_name(ps, "on"):
_ps_advance(ps)
s.kind = SEL_INLINE_FRAGMENT
s.typeCondition = _ps_expect_name(ps)
s.hasTypeCondition = true
s.directives = _p_directives(ps, doc, false)
s.selections = _p_selection_set(ps, doc)
ret _doc_add_selection(doc, s)
end
if _ps_at(ps, TOK_NAME):
s.kind = SEL_FRAGMENT_SPREAD
s.name = _ps_expect_name(ps)
s.directives = _p_directives(ps, doc, false)
ret _doc_add_selection(doc, s)
end
s.kind = SEL_INLINE_FRAGMENT
s.directives = _p_directives(ps, doc, false)
s.selections = _p_selection_set(ps, doc)
ret _doc_add_selection(doc, s)
end
func _p_field(ps &: Ps, doc &: Document): int:
t := _ps_cur(ps)
mut s := AstSelection { kind = SEL_FIELD }
s.line = t.line
s.col = t.col
first := _ps_expect_name(ps)
if ps.failed: ret 0 - 1 end
if _ps_skip(ps, TOK_COLON):
s.alias = first
s.name = _ps_expect_name(ps)
else:
s.name = first
end
s.args = _p_arguments(ps, doc, false)
s.directives = _p_directives(ps, doc, false)
if _ps_at(ps, TOK_LBRACE):
s.selections = _p_selection_set(ps, doc)
end
ret _doc_add_selection(doc, s)
end
func _p_variable_defs(ps &: Ps, doc &: Document): Vector<AstVariableDef>:
mut out := Vector {} as Vector<AstVariableDef>
if not _ps_at(ps, TOK_LPAREN): ret out end
_ps_advance(ps)
until not _ps_at(ps, TOK_RPAREN):
if ps.failed or _ps_at(ps, TOK_EOF):
_ps_fail(ps, "unterminated variable definitions")
ret out
end
out.push(_p_variable_def(ps, doc))
end
_ps_advance(ps)
ret out
end
func _p_variable_def(ps &: Ps, doc &: Document): AstVariableDef:
t := _ps_expect(ps, TOK_DOLLAR)
mut v := AstVariableDef {}
v.line = t.line
v.name = _ps_expect_name(ps)
_ps_expect(ps, TOK_COLON)
v.typeRef = _p_type_ref(ps, doc)
if _ps_skip(ps, TOK_EQUALS):
v.defaultValue = _p_value(ps, doc, true)
v.hasDefault = true
end
v.directives = _p_directives(ps, doc, true)
ret v
end
func _p_operation_type(ps &: Ps): int:
if _ps_at_name(ps, "mutation"):
_ps_advance(ps)
ret OP_MUTATION
end
if _ps_at_name(ps, "subscription"):
_ps_advance(ps)
ret OP_SUBSCRIPTION
end
_ps_expect_word(ps, "query")
ret OP_QUERY
end
func _p_shorthand_operation(ps &: Ps, doc &: Document): AstOperation:
t := _ps_cur(ps)
mut op := AstOperation { optype = OP_QUERY }
op.shorthand = true
op.line = t.line
op.selections = _p_selection_set(ps, doc)
ret op
end
func _p_operation(ps &: Ps, doc &: Document): AstOperation:
if _ps_at(ps, TOK_LBRACE): ret _p_shorthand_operation(ps, doc) end
t := _ps_cur(ps)
mut op := AstOperation {}
op.line = t.line
op.optype = _p_operation_type(ps)
if _ps_at(ps, TOK_NAME): op.name = _ps_expect_name(ps) end
op.varDefs = _p_variable_defs(ps, doc)
op.directives = _p_directives(ps, doc, false)
op.selections = _p_selection_set(ps, doc)
ret op
end
func _p_fragment(ps &: Ps, doc &: Document): AstFragment:
t := _ps_cur(ps)
_ps_expect_word(ps, "fragment")
mut f := AstFragment {}
f.line = t.line
f.name = _ps_expect_name(ps)
if f.name == "on":
_ps_fail(ps, `a fragment cannot be named "on"`)
ret f
end
_ps_expect_word(ps, "on")
f.typeCondition = _ps_expect_name(ps)
f.directives = _p_directives(ps, doc, false)
f.selections = _p_selection_set(ps, doc)
ret f
end
func _p_definition(ps &: Ps, doc &: Document):
if _ps_at_name(ps, "fragment"):
doc.frags.push(_p_fragment(ps, doc))
ret
end
if _ps_at(ps, TOK_LBRACE) or _ps_at_name(ps, "query") or _ps_at_name(ps, "mutation") or _ps_at_name(ps, "subscription"):
doc.ops.push(_p_operation(ps, doc))
ret
end
_ps_fail(ps, _gql_unexpected_msg(_ps_cur(ps)))
end
func _ps_from_source(source: str, ps &: Ps): bool:
mut ok := true
ts := Tokenize(source, ok)
ps.toks = ts.toks
ps.pos = 0
if ok: ret true end
mut i := 0
until i < ps.toks.len():
t := ps.toks.get(i)
if t.kind == TOK_ERROR:
ps.failed = true
ps.err = SyntaxError(t.sval, t.line, t.col)
ret false
end
i += 1
end
ret true
end
@en "Parse"
@fa "تجزیه"
pub func Parse(source: str, err &: GqlError): Document:
mut doc := Document {}
mut ps := Ps {}
if not _ps_from_source(source, ps):
err = ps.err
ps.toks.free()
ret doc
end
until not _ps_at(ps, TOK_EOF):
if ps.failed: break end
_p_definition(ps, doc)
end
if not ps.failed and doc.ops.len() == 0 and doc.frags.len() == 0:
_ps_fail(ps, "a document must contain at least one definition")
end
if ps.failed: err = ps.err end
defer ps.toks.free()
ret doc
end
@en "ParseOk"
@fa "تجزیه موفق"
pub func ParseOk(source: str): bool:
mut err := GqlError {}
mut doc := Parse(source, err)
FreeDocument(doc)
ret err.message == ""
end
package graphql
import str
import conv
func _pr_indent(sb &: str.StringBuilder, depth: int):
mut i := 0
until i < depth:
str.BufAppend(sb, "  ")
i += 1
end
end
func _gql_has_char(s: str, c: int): bool:
bp := _gbp(s)
mut i := 0
until i < s.len():
if _gub(bp, i) == c: ret true end
i += 1
end
ret false
end
func _pr_float(sb &: str.StringBuilder, f: f64):
text := conv.FormatFloat(f)
str.BufAppend(sb, text)
if not _gql_has_char(text, 46) and not _gql_has_char(text, 101) and not _gql_has_char(text, 69):
str.BufAppend(sb, ".0")
end
end
func _pr_hex4(c: int): str:
digits := "0123456789ABCDEF"
mut out := ""
out = out + digits.substr((c / 4096) % 16, 1)
out = out + digits.substr((c / 256) % 16, 1)
out = out + digits.substr((c / 16) % 16, 1)
out = out + digits.substr(c % 16, 1)
ret out
end
func _pr_escape_byte(sb &: str.StringBuilder, c: int):
if c == 34: str.BufAppend(sb, `\"`) ret end
if c == 92: str.BufAppend(sb, `\\`) ret end
if c == 8: str.BufAppend(sb, `\b`) ret end
if c == 12: str.BufAppend(sb, `\f`) ret end
if c == 10: str.BufAppend(sb, `\n`) ret end
if c == 13: str.BufAppend(sb, `\r`) ret end
if c == 9: str.BufAppend(sb, `\t`) ret end
if c < 32:
str.BufAppend(sb, `\u`)
str.BufAppend(sb, _pr_hex4(c))
ret
end
str.BufAppendChar(sb, c)
end
func _pr_string_lit(s: str): str:
mut sb := str.NewBuilder()
defer str.BufFree(sb)
str.BufAppendChar(sb, 34)
bp := _gbp(s)
mut i := 0
until i < s.len():
_pr_escape_byte(sb, _gub(bp, i))
i += 1
end
str.BufAppendChar(sb, 34)
ret str.BufStr(sb)
end
func _gql_bool_text(b: bool): str:
if b: ret "true" end
ret "false"
end
func _pr_list(sb &: str.StringBuilder, doc: Document, v: AstValue):
str.BufAppendChar(sb, 91)
mut i := 0
until i < v.items.len():
if i > 0: str.BufAppend(sb, ", ") end
_pr_value(sb, doc, v.items.get(i))
i += 1
end
str.BufAppendChar(sb, 93)
end
func _pr_object(sb &: str.StringBuilder, doc: Document, v: AstValue):
str.BufAppendChar(sb, 123)
mut i := 0
until i < v.items.len():
if i > 0: str.BufAppend(sb, ", ") end
str.BufAppend(sb, v.keys.get(i))
str.BufAppend(sb, ": ")
_pr_value(sb, doc, v.items.get(i))
i += 1
end
str.BufAppendChar(sb, 125)
end
func _pr_value(sb &: str.StringBuilder, doc: Document, id: int):
v := ValueAt(doc, id)
if v.kind == VAL_NULL: str.BufAppend(sb, "null")
else v.kind == VAL_BOOL: str.BufAppend(sb, _gql_bool_text(v.b))
else v.kind == VAL_INT: str.BufAppendInt(sb, v.i)
else v.kind == VAL_FLOAT: _pr_float(sb, v.f)
else v.kind == VAL_STRING: str.BufAppend(sb, _pr_string_lit(v.s))
else v.kind == VAL_ENUM: str.BufAppend(sb, v.s)
else v.kind == VAL_VARIABLE:
str.BufAppendChar(sb, 36)
str.BufAppend(sb, v.s)
else v.kind == VAL_LIST: _pr_list(sb, doc, v)
else v.kind == VAL_OBJECT: _pr_object(sb, doc, v)
end
end
func _pr_type_ref(sb &: str.StringBuilder, doc: Document, id: int):
t := TypeRefAt(doc, id)
if t.kind == TREF_LIST:
str.BufAppendChar(sb, 91)
_pr_type_ref(sb, doc, t.inner)
str.BufAppendChar(sb, 93)
else:
str.BufAppend(sb, t.name)
end
if t.nonNull: str.BufAppendChar(sb, 33) end
end
func _pr_arguments(sb &: str.StringBuilder, doc: Document, args: Vector<AstArgument>):
if args.len() == 0: ret end
str.BufAppendChar(sb, 40)
mut i := 0
until i < args.len():
if i > 0: str.BufAppend(sb, ", ") end
a := args.get(i)
str.BufAppend(sb, a.name)
str.BufAppend(sb, ": ")
_pr_value(sb, doc, a.value)
i += 1
end
str.BufAppendChar(sb, 41)
end
func _pr_directives(sb &: str.StringBuilder, doc: Document, ds: Vector<AstDirective>):
mut i := 0
until i < ds.len():
d := ds.get(i)
str.BufAppend(sb, " @")
str.BufAppend(sb, d.name)
_pr_arguments(sb, doc, d.args)
i += 1
end
end
func _pr_field(sb &: str.StringBuilder, doc: Document, s: AstSelection, depth: int):
if s.alias != "":
str.BufAppend(sb, s.alias)
str.BufAppend(sb, ": ")
end
str.BufAppend(sb, s.name)
_pr_arguments(sb, doc, s.args)
_pr_directives(sb, doc, s.directives)
if s.selections.len() > 0:
str.BufAppendChar(sb, 32)
_pr_selection_set(sb, doc, s.selections, depth)
end
str.BufAppendChar(sb, 10)
end
func _pr_selection(sb &: str.StringBuilder, doc: Document, id: int, depth: int):
s := SelectionAt(doc, id)
_pr_indent(sb, depth)
if s.kind == SEL_FRAGMENT_SPREAD:
str.BufAppend(sb, "...")
str.BufAppend(sb, s.name)
_pr_directives(sb, doc, s.directives)
str.BufAppendChar(sb, 10)
ret
end
if s.kind == SEL_INLINE_FRAGMENT:
str.BufAppend(sb, "...")
if s.hasTypeCondition:
str.BufAppend(sb, " on ")
str.BufAppend(sb, s.typeCondition)
end
_pr_directives(sb, doc, s.directives)
str.BufAppendChar(sb, 32)
_pr_selection_set(sb, doc, s.selections, depth)
str.BufAppendChar(sb, 10)
ret
end
_pr_field(sb, doc, s, depth)
end
func _pr_selection_set(sb &: str.StringBuilder, doc: Document, sels: Vector<int>, depth: int):
str.BufAppend(sb, "{\n")
mut i := 0
until i < sels.len():
_pr_selection(sb, doc, sels.get(i), depth + 1)
i += 1
end
_pr_indent(sb, depth)
str.BufAppend(sb, "}")
end
func _pr_variable_defs(sb &: str.StringBuilder, doc: Document, vs: Vector<AstVariableDef>):
if vs.len() == 0: ret end
str.BufAppendChar(sb, 40)
mut i := 0
until i < vs.len():
if i > 0: str.BufAppend(sb, ", ") end
v := vs.get(i)
str.BufAppendChar(sb, 36)
str.BufAppend(sb, v.name)
str.BufAppend(sb, ": ")
_pr_type_ref(sb, doc, v.typeRef)
if v.hasDefault:
str.BufAppend(sb, " = ")
_pr_value(sb, doc, v.defaultValue)
end
_pr_directives(sb, doc, v.directives)
i += 1
end
str.BufAppendChar(sb, 41)
end
func _pr_operation(sb &: str.StringBuilder, doc: Document, op: AstOperation):
if not op.shorthand:
str.BufAppend(sb, OperationTypeName(op.optype))
if op.name != "":
str.BufAppendChar(sb, 32)
str.BufAppend(sb, op.name)
end
_pr_variable_defs(sb, doc, op.varDefs)
_pr_directives(sb, doc, op.directives)
str.BufAppendChar(sb, 32)
end
_pr_selection_set(sb, doc, op.selections, 0)
str.BufAppendChar(sb, 10)
end
func _pr_fragment(sb &: str.StringBuilder, doc: Document, f: AstFragment):
str.BufAppend(sb, "fragment ")
str.BufAppend(sb, f.name)
str.BufAppend(sb, " on ")
str.BufAppend(sb, f.typeCondition)
_pr_directives(sb, doc, f.directives)
str.BufAppendChar(sb, 32)
_pr_selection_set(sb, doc, f.selections, 0)
str.BufAppendChar(sb, 10)
end
@en "PrintStringValue"
@fa "چاپ مقدار رشته"
pub func PrintStringValue(s: str): str: ret _pr_string_lit(s) end
@en "PrintTypeRef"
@fa "چاپ ارجاع نوع"
pub func PrintTypeRef(doc: Document, id: int): str:
mut sb := str.NewBuilder()
defer str.BufFree(sb)
_pr_type_ref(sb, doc, id)
ret str.BufStr(sb)
end
@en "PrintValue"
@fa "چاپ مقدار"
pub func PrintValue(doc: Document, id: int): str:
mut sb := str.NewBuilder()
defer str.BufFree(sb)
_pr_value(sb, doc, id)
ret str.BufStr(sb)
end
@en "Print"
@fa "چاپ"
pub func Print(doc: Document): str:
mut sb := str.NewBuilder()
defer str.BufFree(sb)
mut i := 0
until i < doc.ops.len():
if i > 0: str.BufAppendChar(sb, 10) end
_pr_operation(sb, doc, doc.ops.get(i))
i += 1
end
mut j := 0
until j < doc.frags.len():
if doc.ops.len() > 0 or j > 0: str.BufAppendChar(sb, 10) end
_pr_fragment(sb, doc, doc.frags.get(j))
j += 1
end
ret str.BufStr(sb)
end
package graphql
import encoding.value
mut _gql_slots := GqlSlotTable {}
func _rs_at(id: i64): ResolverSlot:
i := id as int
if i < 0 or i >= _gql_slots.items.len(): ret ResolverSlot {} end
ret _gql_slots.items.get(i)
end
func _rs_store(id: i64, s: ResolverSlot):
i := id as int
if i < 0 or i >= _gql_slots.items.len(): ret end
_gql_slots.items.set(i, s)
end
func _rs_alloc(): int:
mut i := 0
until i < _gql_slots.items.len():
if not _gql_slots.items.get(i).busy:
mut s := ResolverSlot {}
s.busy = true
_gql_slots.items.set(i, s)
ret i
end
i += 1
end
mut s := ResolverSlot {}
s.busy = true
_gql_slots.items.push(s)
ret _gql_slots.items.len() - 1
end
func _rs_release(id: int):
if id < 0 or id >= _gql_slots.items.len(): ret end
_gql_slots.items.set(id, ResolverSlot {})
end
func _rs_prepare(id: int, parent: value.Value, args: value.Value, ctx: value.Value, parentType: str, fieldName: str):
mut s := _rs_at(id as i64)
s.busy = true
s.parent = parent
s.args = args
s.ctx = ctx
s.parentType = parentType
s.fieldName = fieldName
_rs_store(id as i64, s)
end
func _rs_set_result(slot: i64, v: value.Value):
mut s := _rs_at(slot)
s.result = v
s.resolved = true
_rs_store(slot, s)
end
func _rs_lookup(sch: Schema, typeName: str, fieldName: str): i64:
t := FindType(sch, typeName)
f := FindField(t, fieldName)
if f.resolver != 0: ret f.resolver end
mut i := 0
until i < t.interfaces.len():
it := FindType(sch, t.interfaces.get(i))
itf := FindField(it, fieldName)
if itf.resolver != 0: ret itf.resolver end
i += 1
end
ret 0
end
@en "SetResolver"
@fa "تعیین حل‌کننده"
pub func SetResolver(sch &: Schema, typeName: str, fieldName: str, fn: i64): bool:
idx := TypeIndex(sch, typeName)
if idx < 0: ret false end
mut t := sch.types.get(idx)
mut i := 0
until i < t.fields.len():
mut f := t.fields.get(i)
if f.name == fieldName:
f.resolver = fn
t.fields.set(i, f)
sch.types.set(idx, t)
ret true
end
i += 1
end
ret false
end
@en "HasResolver"
@fa "حل‌کننده دارد"
pub func HasResolver(sch: Schema, typeName: str, fieldName: str): bool:
ret _rs_lookup(sch, typeName, fieldName) != 0
end
@en "Parent"
@fa "والد"
pub func Parent(slot: i64): value.Value: ret _rs_at(slot).parent end
@en "Args"
@fa "آرگومان‌ها"
pub func Args(slot: i64): value.Value: ret _rs_at(slot).args end
@en "Context"
@fa "زمینه"
pub func Context(slot: i64): value.Value: ret _rs_at(slot).ctx end
@en "FieldName"
@fa "نام فیلد"
pub func FieldName(slot: i64): str: ret _rs_at(slot).fieldName end
@en "ParentTypeName"
@fa "نام نوع والد"
pub func ParentTypeName(slot: i64): str: ret _rs_at(slot).parentType end
@en "HasArg"
@fa "آرگومان دارد"
pub func HasArg(slot: i64, name: str): bool:
ret value.ObjectHas(_rs_at(slot).args, name)
end
@en "Arg"
@fa "آرگومان"
pub func Arg(slot: i64, name: str): value.Value:
ret value.ObjectGet(_rs_at(slot).args, name)
end
@en "ArgInt"
@fa "آرگومان عددی"
pub func ArgInt(slot: i64, name: str): i64:
ret value.AsInt(Arg(slot, name))
end
@en "ArgFloat"
@fa "آرگومان اعشاری"
pub func ArgFloat(slot: i64, name: str): f64:
ret value.AsFloat(Arg(slot, name))
end
@en "ArgStr"
@fa "آرگومان رشته"
pub func ArgStr(slot: i64, name: str): str:
ret value.AsString(Arg(slot, name))
end
@en "ArgBool"
@fa "آرگومان بولی"
pub func ArgBool(slot: i64, name: str): bool:
ret value.AsBool(Arg(slot, name))
end
@en "ParentField"
@fa "فیلد والد"
pub func ParentField(slot: i64, name: str): value.Value:
ret value.ObjectGet(_rs_at(slot).parent, name)
end
@en "Resolve"
@fa "حل"
pub func Resolve(slot: i64, v: value.Value): _rs_set_result(slot, v) end
@en "ResolveInt"
@fa "حل عددی"
pub func ResolveInt(slot: i64, n: i64): _rs_set_result(slot, value.ValueInt(n)) end
@en "ResolveFloat"
@fa "حل اعشاری"
pub func ResolveFloat(slot: i64, f: f64): _rs_set_result(slot, value.ValueFloat(f)) end
@en "ResolveStr"
@fa "حل رشته"
pub func ResolveStr(slot: i64, s: str): _rs_set_result(slot, value.ValueString(s)) end
@en "ResolveBool"
@fa "حل بولی"
pub func ResolveBool(slot: i64, b: bool): _rs_set_result(slot, value.ValueBool(b)) end
@en "ResolveNull"
@fa "حل تهی"
pub func ResolveNull(slot: i64): _rs_set_result(slot, value.ValueNull()) end
@en "Fail"
@fa "شکست"
pub func Fail(slot: i64, message: str):
mut s := _rs_at(slot)
s.failed = true
s.message = message
s.resolved = true
_rs_store(slot, s)
end
@en "ResetSlots"
@fa "بازنشانی شکاف‌ها"
pub func ResetSlots():
_gql_slots.items.free()
_gql_slots = GqlSlotTable {}
end
package graphql
import encoding.value
import encoding.json
import conv
@en "ExecutionResult"
@fa "نتیجه اجرا"
pub struct ExecutionResult:
pub data: value.Value = value.Value {}
pub hasData: bool = false
pub errors: GqlErrorList = GqlErrorList {}
pub extensions: value.Value = value.Value {}
pub hasExtensions: bool = false
end
func _gql_arg_msg(name: str, detail: str): str:
ret "argument " + _gql_quote(name) + " is invalid: " + detail
end
func _gql_var_msg(name: str, detail: str): str:
ret "variable " + _gql_quote("$" + name) + " is invalid: " + detail
end
func _gql_required_arg_msg(name: str): str:
ret "argument " + _gql_quote(name) + " of required type was not provided"
end
func _gql_required_var_msg(name: str): str:
ret "variable " + _gql_quote("$" + name) + " of required type was not provided"
end
func _gql_bad_var_type_msg(name: str): str:
ret "variable " + _gql_quote("$" + name) + " has a type that is not defined in the schema"
end
func _gql_unknown_field_msg(fieldName: str, typeName: str): str:
ret "cannot query field " + _gql_quote(fieldName) + " on type " + _gql_quote(typeName)
end
func _gql_null_nonnull_msg(): str:
ret "cannot return null for a non-nullable field"
end
func _gql_expected_list_msg(): str:
ret "expected a list value for a list type"
end
func _gql_bad_typename_msg(name: str, abstractName: str): str:
ret "__typename " + _gql_quote(name) + " is not a possible type of " + _gql_quote(abstractName)
end
func _gql_no_typename_msg(abstractName: str): str:
ret "cannot determine the concrete type for abstract type " + _gql_quote(abstractName) + ": the resolved object has no __typename"
end
func _gql_depth_msg(maxDepth: int): str:
ret "selection set exceeded the maximum depth of " + conv.FormatInt(maxDepth as i64)
end
func _gql_no_operation_msg(name: str): str:
if name == "":
ret "the document contains more than one operation, so an operation name is required"
end
ret "no operation named " + _gql_quote(name) + " in the document"
end
func _gql_no_root_msg(opName: str): str:
ret "the schema does not define a root type for a " + opName + " operation"
end
func _res_request_error(message: str): ExecutionResult:
r := ExecutionResult {}
e := NewError(ERR_REQUEST, message)
AddError(r.errors, e)
ret r
end
func _res_from_ex(ex &: Ex, data: value.Value, nulled: bool): ExecutionResult:
mut r := ExecutionResult {}
r.hasData = true
if nulled: r.data = value.ValueNull()
else:
r.data = data
end
r.errors = ex.errors
ret r
end
func _res_new_ex(sch: Schema, doc: Document, ctx: value.Value): Ex:
mut ex := Ex {}
ex.sch = sch
ex.doc = doc
ex.ctx = ctx
ret ex
end
func _res_run(ex &: Ex, op: AstOperation, rootValue: value.Value): ExecutionResult:
rootType := RootTypeName(ex.sch, op.optype)
if rootType == "" or not HasType(ex.sch, rootType):
r := _res_request_error(_gql_no_root_msg(OperationTypeName(op.optype)))
ret r
end
mut varsOk := true
ex.vars = _ex_coerce_variables(ex, op, ex.vars, varsOk)
if not varsOk:
mut r := ExecutionResult {}
r.errors = ex.errors
ret r
end
mut bubble := false
data := _ex_selection_set(ex, rootType, op.selections, rootValue, bubble)
ret _res_from_ex(ex, data, bubble)
end
@en "Execute"
@fa "اجرا"
pub func Execute(sch: Schema, doc: Document, operationName: str, variables: value.Value, rootValue: value.Value, ctx: value.Value): ExecutionResult:
opIdx := FindOperation(doc, operationName)
if opIdx < 0: ret _res_request_error(_gql_no_operation_msg(operationName)) end
mut ex := _res_new_ex(sch, doc, ctx)
ex.vars = variables
op := doc.ops.get(opIdx)
r := _res_run(ex, op, rootValue)
defer ex.pathKeys.free()
defer ex.pathIdx.free()
ret r
end
@en "ExecuteSource"
@fa "اجرای منبع"
pub func ExecuteSource(sch: Schema, source: str, operationName: str, variables: value.Value, rootValue: value.Value, ctx: value.Value): ExecutionResult:
mut err := GqlError {}
mut doc := Parse(source, err)
if err.message != "":
FreeDocument(doc)
r := ExecutionResult {}
AddError(r.errors, err)
ret r
end
mut verrs := Validate(sch, doc)
if HasErrors(verrs):
FreeDocument(doc)
mut r := ExecutionResult {}
r.errors = verrs
ret r
end
FreeErrorList(verrs)
r := Execute(sch, doc, operationName, variables, rootValue, ctx)
FreeDocument(doc)
ret r
end
@en "Run"
@fa "اجرای ساده"
pub func Run(sch: Schema, source: str): ExecutionResult:
ret ExecuteSource(sch, source, "", value.NewValueObject(), value.NewValueObject(), value.NewValueObject())
end
@en "SetExtensions"
@fa "تعیین افزونه‌ها"
pub func SetExtensions(r &: ExecutionResult, ext: value.Value):
r.extensions = ext
r.hasExtensions = true
end
@en "ResultToValue"
@fa "نتیجه به مقدار"
pub func ResultToValue(r: ExecutionResult): value.Value:
mut o := value.NewValueObject()
if HasErrors(r.errors):
value.ObjectSet(o, "errors", ErrorsToValue(r.errors))
end
if r.hasData:
value.ObjectSet(o, "data", r.data)
end
if r.hasExtensions:
value.ObjectSet(o, "extensions", r.extensions)
end
ret o
end
@en "ResultToJSON"
@fa "نتیجه به جیسون"
pub func ResultToJSON(r: ExecutionResult): str:
ret json.EncodeDefault(ResultToValue(r))
end
@en "ResultToJSONIndent"
@fa "نتیجه به جیسون با تورفتگی"
pub func ResultToJSONIndent(r: ExecutionResult): str:
ret json.Indent(json.EncodeDefault(ResultToValue(r)))
end
@en "ResultToJSONStable"
@fa "نتیجه به جیسون قطعی"
pub func ResultToJSONStable(r: ExecutionResult): str:
mut opts := json.JSONOptions {}
opts.sort_keys = true
ret json.Encode(ResultToValue(r), opts)
end
@en "ResultOk"
@fa "نتیجه موفق"
pub func ResultOk(r: ExecutionResult): bool: ret not HasErrors(r.errors) end
@en "ResultErrorMessage"
@fa "پیام خطای نتیجه"
pub func ResultErrorMessage(r: ExecutionResult): str:
if not HasErrors(r.errors): ret "" end
ret ErrorString(ErrorAt(r.errors, 0))
end
@en "FreeResult"
@fa "آزادسازی نتیجه"
pub func FreeResult(r &: ExecutionResult):
FreeErrorList(r.errors)
end
package graphql
@en "TYPE_SCALAR"
@fa "گونه نرده‌ای"
pub const TYPE_SCALAR := 0
@en "TYPE_OBJECT"
@fa "گونه شیء"
pub const TYPE_OBJECT := 1
@en "TYPE_INTERFACE"
@fa "گونه رابط"
pub const TYPE_INTERFACE := 2
@en "TYPE_UNION"
@fa "گونه اجتماع"
pub const TYPE_UNION := 3
@en "TYPE_ENUM"
@fa "گونه شمارشی"
pub const TYPE_ENUM := 4
@en "TYPE_INPUT_OBJECT"
@fa "گونه شیء ورودی"
pub const TYPE_INPUT_OBJECT := 5
@en "InputValueDef"
@fa "تعریف مقدار ورودی"
pub struct InputValueDef:
pub name: str = ""
pub description: str = ""
pub typeRef: int = 0 - 1
pub defaultValue: int = 0 - 1
pub hasDefault: bool = false
pub is_deprecated: bool = false
pub deprecationReason: str = ""
end
@en "FieldDef"
@fa "تعریف فیلد"
pub struct FieldDef:
pub name: str = ""
pub description: str = ""
pub typeRef: int = 0 - 1
pub args: Vector<InputValueDef> = Vector {}
pub is_deprecated: bool = false
pub deprecationReason: str = ""
pub resolver: i64 = 0
end
@en "EnumValueDef"
@fa "تعریف مقدار شمارشی"
pub struct EnumValueDef:
pub name: str = ""
pub description: str = ""
pub is_deprecated: bool = false
pub deprecationReason: str = ""
end
@en "TypeDef"
@fa "تعریف نوع"
pub struct TypeDef:
pub kind: int = TYPE_SCALAR
pub name: str = ""
pub description: str = ""
pub fields: Vector<FieldDef> = Vector {}
pub inputFields: Vector<InputValueDef> = Vector {}
pub interfaces: Vector<str> = Vector {}
pub unionMembers: Vector<str> = Vector {}
pub enumValues: Vector<EnumValueDef> = Vector {}
pub specifiedByURL: str = ""
end
@en "DirectiveDef"
@fa "تعریف دستورالعمل"
pub struct DirectiveDef:
pub name: str = ""
pub description: str = ""
pub args: Vector<InputValueDef> = Vector {}
pub locations: Vector<str> = Vector {}
pub repeatable: bool = false
end
@en "Schema"
@fa "طرح‌واره"
pub struct Schema:
pub doc: Document = Document {}
pub types: Vector<TypeDef> = Vector {}
pub directives: Vector<DirectiveDef> = Vector {}
pub queryType: str = "Query"
pub mutationType: str = ""
pub subscriptionType: str = ""
pub description: str = ""
pub hasSchemaDef: bool = false
end
func _sch_find_index(s: Schema, name: str): int:
mut i := 0
until i < s.types.len():
if s.types.get(i).name == name: ret i end
i += 1
end
ret 0 - 1
end
func _sch_in_names(names: Vector<str>, want: str): bool:
mut i := 0
until i < names.len():
if names.get(i) == want: ret true end
i += 1
end
ret false
end
@en "TypeRefIsNonNull"
@fa "ارجاع نوع ناتهی است"
pub func TypeRefIsNonNull(doc: Document, id: int): bool:
ret TypeRefAt(doc, id).nonNull
end
@en "TypeRefIsList"
@fa "ارجاع نوع فهرست است"
pub func TypeRefIsList(doc: Document, id: int): bool:
ret TypeRefAt(doc, id).kind == TREF_LIST
end
@en "TypeRefElement"
@fa "عنصر ارجاع نوع"
pub func TypeRefElement(doc: Document, id: int): int:
t := TypeRefAt(doc, id)
if t.kind != TREF_LIST: ret 0 - 1 end
ret t.inner
end
@en "TypeRefName"
@fa "نام ارجاع نوع"
pub func TypeRefName(doc: Document, id: int): str:
mut cur := id
mut guard := 0
until guard < 64:
t := TypeRefAt(doc, cur)
if t.kind != TREF_LIST: ret t.name end
cur = t.inner
guard += 1
end
ret ""
end
@en "FindType"
@fa "یافتن نوع"
pub func FindType(s: Schema, name: str): TypeDef:
idx := _sch_find_index(s, name)
if idx < 0: ret TypeDef { kind = 0 - 1 } end
ret s.types.get(idx)
end
@en "HasType"
@fa "نوع دارد"
pub func HasType(s: Schema, name: str): bool:
ret _sch_find_index(s, name) >= 0
end
@en "TypeIndex"
@fa "نمایه نوع"
pub func TypeIndex(s: Schema, name: str): int: ret _sch_find_index(s, name) end
@en "TypeCount"
@fa "تعداد نوع"
pub func TypeCount(s: Schema): int: ret s.types.len() end
@en "TypeAt"
@fa "نوع در"
pub func TypeAt(s: Schema, i: int): TypeDef:
if i < 0 or i >= s.types.len(): ret TypeDef { kind = 0 - 1 } end
ret s.types.get(i)
end
@en "FindField"
@fa "یافتن فیلد"
pub func FindField(t: TypeDef, name: str): FieldDef:
mut i := 0
until i < t.fields.len():
if t.fields.get(i).name == name: ret t.fields.get(i) end
i += 1
end
ret FieldDef { typeRef = 0 - 1 }
end
@en "HasField"
@fa "فیلد دارد"
pub func HasField(t: TypeDef, name: str): bool:
ret FindField(t, name).name != ""
end
@en "FindInputField"
@fa "یافتن فیلد ورودی"
pub func FindInputField(t: TypeDef, name: str): InputValueDef:
mut i := 0
until i < t.inputFields.len():
if t.inputFields.get(i).name == name: ret t.inputFields.get(i) end
i += 1
end
ret InputValueDef { typeRef = 0 - 1 }
end
@en "FindArg"
@fa "یافتن آرگومان"
pub func FindArg(f: FieldDef, name: str): InputValueDef:
mut i := 0
until i < f.args.len():
if f.args.get(i).name == name: ret f.args.get(i) end
i += 1
end
ret InputValueDef { typeRef = 0 - 1 }
end
@en "FindDirectiveDef"
@fa "یافتن تعریف دستورالعمل"
pub func FindDirectiveDef(s: Schema, name: str): DirectiveDef:
mut i := 0
until i < s.directives.len():
if s.directives.get(i).name == name: ret s.directives.get(i) end
i += 1
end
ret DirectiveDef {}
end
@en "HasEnumValue"
@fa "مقدار شمارشی دارد"
pub func HasEnumValue(t: TypeDef, name: str): bool:
mut i := 0
until i < t.enumValues.len():
if t.enumValues.get(i).name == name: ret true end
i += 1
end
ret false
end
@en "IsInputType"
@fa "نوع ورودی است"
pub func IsInputType(s: Schema, name: str): bool:
k := FindType(s, name).kind
ret k == TYPE_SCALAR or k == TYPE_ENUM or k == TYPE_INPUT_OBJECT
end
@en "IsOutputType"
@fa "نوع خروجی است"
pub func IsOutputType(s: Schema, name: str): bool:
k := FindType(s, name).kind
ret k == TYPE_SCALAR or k == TYPE_ENUM or k == TYPE_OBJECT or k == TYPE_INTERFACE or k == TYPE_UNION
end
@en "IsAbstractType"
@fa "نوع انتزاعی است"
pub func IsAbstractType(s: Schema, name: str): bool:
k := FindType(s, name).kind
ret k == TYPE_INTERFACE or k == TYPE_UNION
end
@en "IsLeafType"
@fa "نوع برگ است"
pub func IsLeafType(s: Schema, name: str): bool:
k := FindType(s, name).kind
ret k == TYPE_SCALAR or k == TYPE_ENUM
end
@en "IsPossibleType"
@fa "نوع ممکن است"
pub func IsPossibleType(s: Schema, abstractName: str, objectName: str): bool:
if abstractName == objectName: ret true end
absType := FindType(s, abstractName)
if absType.kind == TYPE_UNION: ret _sch_in_names(absType.unionMembers, objectName) end
if absType.kind == TYPE_INTERFACE:
objType := FindType(s, objectName)
ret _sch_in_names(objType.interfaces, abstractName)
end
ret false
end
@en "PossibleTypes"
@fa "انواع ممکن"
pub func PossibleTypes(s: Schema, name: str): Vector<str>:
mut out := Vector {} as Vector<str>
t := FindType(s, name)
if t.kind == TYPE_UNION:
mut i := 0
until i < t.unionMembers.len():
out.push(t.unionMembers.get(i))
i += 1
end
ret out
end
if t.kind == TYPE_OBJECT:
out.push(name)
ret out
end
if t.kind != TYPE_INTERFACE: ret out end
mut j := 0
until j < s.types.len():
objType := s.types.get(j)
if objType.kind == TYPE_OBJECT and _sch_in_names(objType.interfaces, name):
out.push(objType.name)
end
j += 1
end
ret out
end
@en "RootTypeName"
@fa "نام نوع ریشه"
pub func RootTypeName(s: Schema, optype: int): str:
if optype == OP_MUTATION: ret s.mutationType end
if optype == OP_SUBSCRIPTION: ret s.subscriptionType end
ret s.queryType
end
package graphql
func _gql_redefined_msg(name: str): str:
ret "type " + _gql_quote(name) + " is defined more than once"
end
func _gql_cannot_extend_msg(name: str): str:
ret "cannot extend type " + _gql_quote(name) + " because it is not defined"
end
func _gql_bad_root_msg(role: str): str:
ret "unknown root operation type " + _gql_quote(role)
end
func _sb_scalar(sch &: Schema, name: str, desc: str):
mut t := TypeDef { kind = TYPE_SCALAR }
t.name = name
t.description = desc
sch.types.push(t)
end
func _sb_builtin_scalars(sch &: Schema):
_sb_scalar(sch, "Int", "A signed 32-bit integer.")
_sb_scalar(sch, "Float", "A signed double-precision floating-point value.")
_sb_scalar(sch, "String", "A UTF-8 character sequence.")
_sb_scalar(sch, "Boolean", "True or false.")
_sb_scalar(sch, "ID", "A unique identifier, serialised as a String.")
end
func _sb_arg(sch &: Schema, name: str, typeText: str, desc: str): InputValueDef:
mut iv := InputValueDef {}
iv.name = name
iv.description = desc
iv.typeRef = TypeRefText(sch, typeText)
ret iv
end
func _sb_directive(sch &: Schema, name: str, desc: str, locations: Vector<str>, args: Vector<InputValueDef>):
mut d := DirectiveDef {}
d.name = name
d.description = desc
d.locations = locations
d.args = args
sch.directives.push(d)
end
func _sb_locs2(a: str, b: str): Vector<str>:
mut v := Vector {} as Vector<str>
v.push(a)
v.push(b)
ret v
end
func _sb_locs3(a: str, b: str, c: str): Vector<str>:
mut v := _sb_locs2(a, b)
v.push(c)
ret v
end
func _sb_skip_include(sch &: Schema):
mut ifArgs := Vector {} as Vector<InputValueDef>
ifArgs.push(_sb_arg(sch, "if", "Boolean!", "Included when true."))
_sb_directive(
sch, "include", "Include this selection only when the argument is true.", _sb_locs3("FIELD", "FRAGMENT_SPREAD", "INLINE_FRAGMENT"),
ifArgs
)
mut skipArgs := Vector {} as Vector<InputValueDef>
skipArgs.push(_sb_arg(sch, "if", "Boolean!", "Skipped when true."))
_sb_directive(
sch, "skip", "Skip this selection when the argument is true.", _sb_locs3("FIELD", "FRAGMENT_SPREAD", "INLINE_FRAGMENT"),
skipArgs
)
end
func _sb_deprecated(sch &: Schema):
mut args := Vector {} as Vector<InputValueDef>
mut reason := _sb_arg(sch, "reason", "String", "Why this element was deprecated.")
mut v := AstValue { kind = VAL_STRING }
v.s = "No longer supported"
reason.defaultValue = _doc_add_value(sch.doc, v)
reason.hasDefault = true
args.push(reason)
_sb_directive(
sch, "deprecated", "Marks an element as deprecated.", _sb_locs2("FIELD_DEFINITION", "ENUM_VALUE"),
args
)
end
func _sb_specified_by(sch &: Schema):
mut args := Vector {} as Vector<InputValueDef>
args.push(_sb_arg(sch, "url", "String!", "A URL specifying the scalar's behaviour."))
mut locs := Vector {} as Vector<str>
locs.push("SCALAR")
_sb_directive(sch, "specifiedBy", "Points at a specification for a custom scalar.", locs, args)
end
func _sb_type_index_or_add(sch &: Schema, name: str, kind: int): int:
idx := TypeIndex(sch, name)
if idx >= 0: ret idx end
mut t := TypeDef { kind = kind }
t.name = name
sch.types.push(t)
ret sch.types.len() - 1
end
func _sb_free_inputs(vs: Vector<InputValueDef>):
mut v := vs
defer v.free()
end
func _sb_free_fields(fs: Vector<FieldDef>):
mut i := 0
until i < fs.len():
_sb_free_inputs(fs.get(i).args)
i += 1
end
mut f := fs
defer f.free()
end
func _sb_free_type(t: TypeDef):
_sb_free_fields(t.fields)
_sb_free_inputs(t.inputFields)
mut ifaces := t.interfaces
defer ifaces.free()
mut members := t.unionMembers
defer members.free()
mut evs := t.enumValues
defer evs.free()
end
@en "NewSchema"
@fa "طرح‌واره جدید"
pub func NewSchema(): Schema:
mut sch := Schema {}
_sb_builtin_scalars(sch)
_sb_skip_include(sch)
_sb_deprecated(sch)
_sb_specified_by(sch)
AddIntrospectionTypes(sch)
ret sch
end
@en "TypeRefText"
@fa "متن ارجاع نوع"
pub func TypeRefText(sch &: Schema, text: str): int:
mut ps := Ps {}
if not _ps_from_source(text, ps):
ps.toks.free()
ret 0 - 1
end
id := _p_type_ref(ps, sch.doc)
failed := ps.failed
defer ps.toks.free()
if failed: ret 0 - 1 end
ret id
end
@en "AddScalarType"
@fa "افزودن نوع اسکالر"
pub func AddScalarType(sch &: Schema, name: str, description: str):
idx := _sb_type_index_or_add(sch, name, TYPE_SCALAR)
mut t := sch.types.get(idx)
t.kind = TYPE_SCALAR
t.description = description
sch.types.set(idx, t)
end
@en "AddObjectType"
@fa "افزودن نوع شیء"
pub func AddObjectType(sch &: Schema, name: str, description: str):
idx := _sb_type_index_or_add(sch, name, TYPE_OBJECT)
mut t := sch.types.get(idx)
t.kind = TYPE_OBJECT
t.description = description
sch.types.set(idx, t)
end
@en "AddInterfaceType"
@fa "افزودن نوع رابط"
pub func AddInterfaceType(sch &: Schema, name: str, description: str):
idx := _sb_type_index_or_add(sch, name, TYPE_INTERFACE)
mut t := sch.types.get(idx)
t.kind = TYPE_INTERFACE
t.description = description
sch.types.set(idx, t)
end
@en "AddInputObjectType"
@fa "افزودن نوع ورودی"
pub func AddInputObjectType(sch &: Schema, name: str, description: str):
idx := _sb_type_index_or_add(sch, name, TYPE_INPUT_OBJECT)
mut t := sch.types.get(idx)
t.kind = TYPE_INPUT_OBJECT
t.description = description
sch.types.set(idx, t)
end
@en "AddEnumType"
@fa "افزودن نوع شمارشی"
pub func AddEnumType(sch &: Schema, name: str, values: Vector<str>):
idx := _sb_type_index_or_add(sch, name, TYPE_ENUM)
mut t := sch.types.get(idx)
t.kind = TYPE_ENUM
mut i := 0
until i < values.len():
mut ev := EnumValueDef {}
ev.name = values.get(i)
t.enumValues.push(ev)
i += 1
end
sch.types.set(idx, t)
end
@en "AddUnionType"
@fa "افزودن نوع اجتماع"
pub func AddUnionType(sch &: Schema, name: str, members: Vector<str>):
idx := _sb_type_index_or_add(sch, name, TYPE_UNION)
mut t := sch.types.get(idx)
t.kind = TYPE_UNION
mut i := 0
until i < members.len():
t.unionMembers.push(members.get(i))
i += 1
end
sch.types.set(idx, t)
end
@en "AddInterfaceTo"
@fa "افزودن رابط به"
pub func AddInterfaceTo(sch &: Schema, typeName: str, interfaceName: str):
idx := TypeIndex(sch, typeName)
if idx < 0: ret end
mut t := sch.types.get(idx)
t.interfaces.push(interfaceName)
sch.types.set(idx, t)
end
@en "AddField"
@fa "افزودن فیلد"
pub func AddField(sch &: Schema, typeName: str, fieldName: str, typeText: str): bool:
idx := TypeIndex(sch, typeName)
if idx < 0: ret false end
ref := TypeRefText(sch, typeText)
if ref < 0: ret false end
mut f := FieldDef {}
f.name = fieldName
f.typeRef = ref
mut t := sch.types.get(idx)
t.fields.push(f)
sch.types.set(idx, t)
ret true
end
@en "AddFieldArg"
@fa "افزودن آرگومان فیلد"
pub func AddFieldArg(sch &: Schema, typeName: str, fieldName: str, argName: str, typeText: str): bool:
idx := TypeIndex(sch, typeName)
if idx < 0: ret false end
ref := TypeRefText(sch, typeText)
if ref < 0: ret false end
mut t := sch.types.get(idx)
mut i := 0
until i < t.fields.len():
mut f := t.fields.get(i)
if f.name == fieldName:
mut iv := InputValueDef {}
iv.name = argName
iv.typeRef = ref
f.args.push(iv)
t.fields.set(i, f)
sch.types.set(idx, t)
ret true
end
i += 1
end
ret false
end
@en "AddInputField"
@fa "افزودن فیلد ورودی"
pub func AddInputField(sch &: Schema, typeName: str, fieldName: str, typeText: str): bool:
idx := TypeIndex(sch, typeName)
if idx < 0: ret false end
ref := TypeRefText(sch, typeText)
if ref < 0: ret false end
mut iv := InputValueDef {}
iv.name = fieldName
iv.typeRef = ref
mut t := sch.types.get(idx)
t.inputFields.push(iv)
sch.types.set(idx, t)
ret true
end
@en "SetRootTypes"
@fa "تعیین انواع ریشه"
pub func SetRootTypes(sch &: Schema, queryType: str, mutationType: str, subscriptionType: str):
sch.queryType = queryType
sch.mutationType = mutationType
sch.subscriptionType = subscriptionType
end
@en "FreeSchema"
@fa "آزادسازی طرح‌واره"
pub func FreeSchema(sch &: Schema):
mut i := 0
until i < sch.types.len():
_sb_free_type(sch.types.get(i))
i += 1
end
sch.types.free()
mut j := 0
until j < sch.directives.len():
mut d := sch.directives.get(j)
_sb_free_inputs(d.args)
d.locations.free()
j += 1
end
sch.directives.free()
FreeDocument(sch.doc)
end
package graphql
func _sd_description(ps &: Ps): str:
if not IsStringToken(_ps_kind(ps)): ret "" end
ret _ps_advance(ps).sval
end
func _sd_directive_arg_string(doc: Document, d: AstDirective, argName: str, fallback: str): str:
mut i := 0
until i < d.args.len():
a := d.args.get(i)
if a.name == argName:
v := ValueAt(doc, a.value)
if v.kind == VAL_STRING: ret v.s end
end
i += 1
end
ret fallback
end
func _sd_find_directive(ds: Vector<AstDirective>, name: str, found &: bool): AstDirective:
mut i := 0
until i < ds.len():
if ds.get(i).name == name:
found = true
ret ds.get(i)
end
i += 1
end
found = false
ret AstDirective {}
end
func _sd_apply_deprecated(doc: Document, ds: Vector<AstDirective>, dep &: bool, reason &: str):
mut found := false
d := _sd_find_directive(ds, "deprecated", found)
if not found: ret end
dep = true
reason = _sd_directive_arg_string(doc, d, "reason", "No longer supported")
end
func _sd_input_value(ps &: Ps, sch &: Schema): InputValueDef:
mut iv := InputValueDef {}
iv.description = _sd_description(ps)
iv.name = _ps_expect_name(ps)
_ps_expect(ps, TOK_COLON)
iv.typeRef = _p_type_ref(ps, sch.doc)
if _ps_skip(ps, TOK_EQUALS):
iv.defaultValue = _p_value(ps, sch.doc, true)
iv.hasDefault = true
end
ds := _p_directives(ps, sch.doc, true)
_sd_apply_deprecated(sch.doc, ds, iv.is_deprecated, iv.deprecationReason)
_free_directives(ds)
ret iv
end
func _sd_arguments_def(ps &: Ps, sch &: Schema): Vector<InputValueDef>:
mut out := Vector {} as Vector<InputValueDef>
if not _ps_at(ps, TOK_LPAREN): ret out end
_ps_advance(ps)
until not _ps_at(ps, TOK_RPAREN):
if ps.failed or _ps_at(ps, TOK_EOF):
_ps_fail(ps, "unterminated argument definitions")
ret out
end
out.push(_sd_input_value(ps, sch))
end
_ps_advance(ps)
ret out
end
func _sd_field(ps &: Ps, sch &: Schema): FieldDef:
mut f := FieldDef {}
f.description = _sd_description(ps)
f.name = _ps_expect_name(ps)
f.args = _sd_arguments_def(ps, sch)
_ps_expect(ps, TOK_COLON)
f.typeRef = _p_type_ref(ps, sch.doc)
ds := _p_directives(ps, sch.doc, true)
_sd_apply_deprecated(sch.doc, ds, f.is_deprecated, f.deprecationReason)
_free_directives(ds)
ret f
end
func _sd_fields_def(ps &: Ps, sch &: Schema): Vector<FieldDef>:
mut out := Vector {} as Vector<FieldDef>
if not _ps_at(ps, TOK_LBRACE): ret out end
_ps_advance(ps)
until not _ps_at(ps, TOK_RBRACE):
if ps.failed or _ps_at(ps, TOK_EOF):
_ps_fail(ps, "unterminated field definitions")
ret out
end
out.push(_sd_field(ps, sch))
end
_ps_advance(ps)
ret out
end
func _sd_input_fields_def(ps &: Ps, sch &: Schema): Vector<InputValueDef>:
mut out := Vector {} as Vector<InputValueDef>
if not _ps_at(ps, TOK_LBRACE): ret out end
_ps_advance(ps)
until not _ps_at(ps, TOK_RBRACE):
if ps.failed or _ps_at(ps, TOK_EOF):
_ps_fail(ps, "unterminated input field definitions")
ret out
end
out.push(_sd_input_value(ps, sch))
end
_ps_advance(ps)
ret out
end
func _sd_implements(ps &: Ps): Vector<str>:
mut out := Vector {} as Vector<str>
if not _ps_at_name(ps, "implements"): ret out end
_ps_advance(ps)
_ps_skip(ps, TOK_AMP)
out.push(_ps_expect_name(ps))
until _ps_skip(ps, TOK_AMP):
if ps.failed: ret out end
out.push(_ps_expect_name(ps))
end
ret out
end
func _sd_union_members(ps &: Ps): Vector<str>:
mut out := Vector {} as Vector<str>
if not _ps_skip(ps, TOK_EQUALS): ret out end
_ps_skip(ps, TOK_PIPE)
out.push(_ps_expect_name(ps))
until _ps_skip(ps, TOK_PIPE):
if ps.failed: ret out end
out.push(_ps_expect_name(ps))
end
ret out
end
func _sd_enum_values(ps &: Ps, sch &: Schema): Vector<EnumValueDef>:
mut out := Vector {} as Vector<EnumValueDef>
if not _ps_at(ps, TOK_LBRACE): ret out end
_ps_advance(ps)
until not _ps_at(ps, TOK_RBRACE):
if ps.failed or _ps_at(ps, TOK_EOF):
_ps_fail(ps, "unterminated enum values")
ret out
end
mut ev := EnumValueDef {}
ev.description = _sd_description(ps)
ev.name = _ps_expect_name(ps)
ds := _p_directives(ps, sch.doc, true)
_sd_apply_deprecated(sch.doc, ds, ev.is_deprecated, ev.deprecationReason)
_free_directives(ds)
out.push(ev)
end
_ps_advance(ps)
ret out
end
func _sd_merge_type(ps &: Ps, sch &: Schema, t: TypeDef, isExtend: bool):
if ps.failed: ret end
idx := TypeIndex(sch, t.name)
if idx < 0:
if isExtend:
_ps_fail(ps, _gql_cannot_extend_msg(t.name))
ret
end
sch.types.push(t)
ret
end
if not isExtend:
_ps_fail(ps, _gql_redefined_msg(t.name))
ret
end
mut cur := sch.types.get(idx)
_sd_extend_into(cur, t)
sch.types.set(idx, cur)
end
func _sd_extend_into(cur &: TypeDef, add: TypeDef):
mut i := 0
until i < add.fields.len():
cur.fields.push(add.fields.get(i))
i += 1
end
mut j := 0
until j < add.inputFields.len():
cur.inputFields.push(add.inputFields.get(j))
j += 1
end
mut k := 0
until k < add.interfaces.len():
cur.interfaces.push(add.interfaces.get(k))
k += 1
end
mut m := 0
until m < add.unionMembers.len():
cur.unionMembers.push(add.unionMembers.get(m))
m += 1
end
mut n := 0
until n < add.enumValues.len():
cur.enumValues.push(add.enumValues.get(n))
n += 1
end
end
func _sd_object(ps &: Ps, sch &: Schema, desc: str, kind: int, isExtend: bool):
_ps_advance(ps)
mut t := TypeDef { kind = kind }
t.description = desc
t.name = _ps_expect_name(ps)
t.interfaces = _sd_implements(ps)
_free_directives(_p_directives(ps, sch.doc, true))
t.fields = _sd_fields_def(ps, sch)
_sd_merge_type(ps, sch, t, isExtend)
end
func _sd_scalar(ps &: Ps, sch &: Schema, desc: str, isExtend: bool):
_ps_advance(ps)
mut t := TypeDef { kind = TYPE_SCALAR }
t.description = desc
t.name = _ps_expect_name(ps)
ds := _p_directives(ps, sch.doc, true)
mut found := false
d := _sd_find_directive(ds, "specifiedBy", found)
if found: t.specifiedByURL = _sd_directive_arg_string(sch.doc, d, "url", "") end
_free_directives(ds)
_sd_merge_type(ps, sch, t, isExtend)
end
func _sd_union(ps &: Ps, sch &: Schema, desc: str, isExtend: bool):
_ps_advance(ps)
mut t := TypeDef { kind = TYPE_UNION }
t.description = desc
t.name = _ps_expect_name(ps)
_free_directives(_p_directives(ps, sch.doc, true))
t.unionMembers = _sd_union_members(ps)
_sd_merge_type(ps, sch, t, isExtend)
end
func _sd_enum(ps &: Ps, sch &: Schema, desc: str, isExtend: bool):
_ps_advance(ps)
mut t := TypeDef { kind = TYPE_ENUM }
t.description = desc
t.name = _ps_expect_name(ps)
_free_directives(_p_directives(ps, sch.doc, true))
t.enumValues = _sd_enum_values(ps, sch)
_sd_merge_type(ps, sch, t, isExtend)
end
func _sd_input(ps &: Ps, sch &: Schema, desc: str, isExtend: bool):
_ps_advance(ps)
mut t := TypeDef { kind = TYPE_INPUT_OBJECT }
t.description = desc
t.name = _ps_expect_name(ps)
_free_directives(_p_directives(ps, sch.doc, true))
t.inputFields = _sd_input_fields_def(ps, sch)
_sd_merge_type(ps, sch, t, isExtend)
end
func _sd_directive_def(ps &: Ps, sch &: Schema, desc: str):
_ps_advance(ps)
_ps_expect(ps, TOK_AT)
mut d := DirectiveDef {}
d.description = desc
d.name = _ps_expect_name(ps)
d.args = _sd_arguments_def(ps, sch)
if _ps_at_name(ps, "repeatable"):
_ps_advance(ps)
d.repeatable = true
end
_ps_expect_word(ps, "on")
_ps_skip(ps, TOK_PIPE)
d.locations.push(_ps_expect_name(ps))
until _ps_skip(ps, TOK_PIPE):
if ps.failed: break end
d.locations.push(_ps_expect_name(ps))
end
if not ps.failed: sch.directives.push(d) end
end
func _sd_schema_def(ps &: Ps, sch &: Schema, desc: str):
_ps_advance(ps)
sch.hasSchemaDef = true
if desc != "": sch.description = desc end
_free_directives(_p_directives(ps, sch.doc, true))
_ps_expect(ps, TOK_LBRACE)
until not _ps_at(ps, TOK_RBRACE):
if ps.failed or _ps_at(ps, TOK_EOF):
_ps_fail(ps, "unterminated schema definition")
ret
end
role := _ps_expect_name(ps)
_ps_expect(ps, TOK_COLON)
name := _ps_expect_name(ps)
if role == "query": sch.queryType = name
else role == "mutation": sch.mutationType = name
else role == "subscription": sch.subscriptionType = name
else:
_ps_fail(ps, _gql_bad_root_msg(role))
ret
end
end
_ps_advance(ps)
end
func _sd_default_roots(sch &: Schema):
if sch.hasSchemaDef: ret end
if sch.mutationType == "" and HasType(sch, "Mutation"): sch.mutationType = "Mutation" end
if sch.subscriptionType == "" and HasType(sch, "Subscription"): sch.subscriptionType = "Subscription" end
end
func _sd_definition(ps &: Ps, sch &: Schema, isExtend: bool):
desc := _sd_description(ps)
if _ps_at_name(ps, "extend") and not isExtend:
_ps_advance(ps)
_sd_definition(ps, sch, true)
ret
end
if _ps_at_name(ps, "type"): _sd_object(ps, sch, desc, TYPE_OBJECT, isExtend)
else _ps_at_name(ps, "interface"): _sd_object(ps, sch, desc, TYPE_INTERFACE, isExtend)
else _ps_at_name(ps, "scalar"): _sd_scalar(ps, sch, desc, isExtend)
else _ps_at_name(ps, "union"): _sd_union(ps, sch, desc, isExtend)
else _ps_at_name(ps, "enum"): _sd_enum(ps, sch, desc, isExtend)
else _ps_at_name(ps, "input"): _sd_input(ps, sch, desc, isExtend)
else _ps_at_name(ps, "directive"): _sd_directive_def(ps, sch, desc)
else _ps_at_name(ps, "schema"): _sd_schema_def(ps, sch, desc)
else:
_ps_fail(ps, _gql_unexpected_msg(_ps_cur(ps)))
end
end
@en "ParseSchema"
@fa "تجزیه طرح‌واره"
pub func ParseSchema(source: str, err &: GqlError): Schema:
mut sch := NewSchema()
ParseSchemaInto(sch, source, err)
ret sch
end
@en "ParseSchemaInto"
@fa "تجزیه در طرح‌واره"
pub func ParseSchemaInto(sch &: Schema, source: str, err &: GqlError):
mut ps := Ps {}
if not _ps_from_source(source, ps):
err = ps.err
ps.toks.free()
ret
end
until not _ps_at(ps, TOK_EOF):
if ps.failed: break end
_sd_definition(ps, sch, false)
end
if ps.failed: err = ps.err end
_sd_default_roots(sch)
defer ps.toks.free()
end
@en "ParseSchemaOk"
@fa "تجزیه طرح‌واره موفق"
pub func ParseSchemaOk(source: str): bool:
mut err := GqlError {}
mut sch := ParseSchema(source, err)
FreeSchema(sch)
ret err.message == ""
end
package graphql
import str
func _sp_is_builtin_scalar(name: str): bool:
ret name == "Int" or name == "Float" or name == "String" or name == "Boolean" or name == "ID"
end
func _sp_is_builtin_directive(name: str): bool:
ret name == "skip" or name == "include" or name == "deprecated" or name == "specifiedBy"
end
func _sp_description(sb &: str.StringBuilder, desc: str, indent: str):
if desc == "": ret end
str.BufAppend(sb, indent)
if _gql_has_char(desc, 10):
str.BufAppend(sb, `"""`)
str.BufAppendChar(sb, 10)
str.BufAppend(sb, desc)
str.BufAppendChar(sb, 10)
str.BufAppend(sb, indent)
str.BufAppend(sb, `"""`)
else:
str.BufAppend(sb, PrintStringValue(desc))
end
str.BufAppendChar(sb, 10)
end
func _sp_deprecated(sb &: str.StringBuilder, dep: bool, reason: str):
if not dep: ret end
str.BufAppend(sb, " @deprecated")
if reason != "" and reason != "No longer supported":
str.BufAppend(sb, "(reason: ")
str.BufAppend(sb, PrintStringValue(reason))
str.BufAppendChar(sb, 41)
end
end
func _sp_default(sb &: str.StringBuilder, sch: Schema, iv: InputValueDef):
if not iv.hasDefault: ret end
str.BufAppend(sb, " = ")
str.BufAppend(sb, PrintValue(sch.doc, iv.defaultValue))
end
func _sp_args(sb &: str.StringBuilder, sch: Schema, args: Vector<InputValueDef>):
if args.len() == 0: ret end
str.BufAppendChar(sb, 40)
mut i := 0
until i < args.len():
if i > 0: str.BufAppend(sb, ", ") end
iv := args.get(i)
str.BufAppend(sb, iv.name)
str.BufAppend(sb, ": ")
str.BufAppend(sb, PrintTypeRef(sch.doc, iv.typeRef))
_sp_default(sb, sch, iv)
i += 1
end
str.BufAppendChar(sb, 41)
end
func _sp_fields(sb &: str.StringBuilder, sch: Schema, fields: Vector<FieldDef>):
if fields.len() == 0: ret end
str.BufAppend(sb, " {\n")
mut i := 0
until i < fields.len():
f := fields.get(i)
_sp_description(sb, f.description, "  ")
str.BufAppend(sb, "  ")
str.BufAppend(sb, f.name)
_sp_args(sb, sch, f.args)
str.BufAppend(sb, ": ")
str.BufAppend(sb, PrintTypeRef(sch.doc, f.typeRef))
_sp_deprecated(sb, f.is_deprecated, f.deprecationReason)
str.BufAppendChar(sb, 10)
i += 1
end
str.BufAppendChar(sb, 125)
end
func _sp_input_fields(sb &: str.StringBuilder, sch: Schema, fields: Vector<InputValueDef>):
if fields.len() == 0: ret end
str.BufAppend(sb, " {\n")
mut i := 0
until i < fields.len():
iv := fields.get(i)
_sp_description(sb, iv.description, "  ")
str.BufAppend(sb, "  ")
str.BufAppend(sb, iv.name)
str.BufAppend(sb, ": ")
str.BufAppend(sb, PrintTypeRef(sch.doc, iv.typeRef))
_sp_default(sb, sch, iv)
_sp_deprecated(sb, iv.is_deprecated, iv.deprecationReason)
str.BufAppendChar(sb, 10)
i += 1
end
str.BufAppendChar(sb, 125)
end
func _sp_implements(sb &: str.StringBuilder, ifaces: Vector<str>):
if ifaces.len() == 0: ret end
str.BufAppend(sb, " implements ")
mut i := 0
until i < ifaces.len():
if i > 0: str.BufAppend(sb, " & ") end
str.BufAppend(sb, ifaces.get(i))
i += 1
end
end
func _sp_enum(sb &: str.StringBuilder, t: TypeDef):
if t.enumValues.len() == 0: ret end
str.BufAppend(sb, " {\n")
mut i := 0
until i < t.enumValues.len():
ev := t.enumValues.get(i)
_sp_description(sb, ev.description, "  ")
str.BufAppend(sb, "  ")
str.BufAppend(sb, ev.name)
_sp_deprecated(sb, ev.is_deprecated, ev.deprecationReason)
str.BufAppendChar(sb, 10)
i += 1
end
str.BufAppendChar(sb, 125)
end
func _sp_union(sb &: str.StringBuilder, t: TypeDef):
if t.unionMembers.len() == 0: ret end
str.BufAppend(sb, " = ")
mut i := 0
until i < t.unionMembers.len():
if i > 0: str.BufAppend(sb, " | ") end
str.BufAppend(sb, t.unionMembers.get(i))
i += 1
end
end
func _sp_type_keyword(kind: int): str:
if kind == TYPE_OBJECT: ret "type " end
if kind == TYPE_INTERFACE: ret "interface " end
if kind == TYPE_UNION: ret "union " end
if kind == TYPE_ENUM: ret "enum " end
if kind == TYPE_INPUT_OBJECT: ret "input " end
ret "scalar "
end
func _sp_type(sb &: str.StringBuilder, sch: Schema, t: TypeDef):
_sp_description(sb, t.description, "")
str.BufAppend(sb, _sp_type_keyword(t.kind))
str.BufAppend(sb, t.name)
if t.kind == TYPE_OBJECT or t.kind == TYPE_INTERFACE:
_sp_implements(sb, t.interfaces)
_sp_fields(sb, sch, t.fields)
else t.kind == TYPE_INPUT_OBJECT:
_sp_input_fields(sb, sch, t.inputFields)
else t.kind == TYPE_ENUM:
_sp_enum(sb, t)
else t.kind == TYPE_UNION:
_sp_union(sb, t)
else t.specifiedByURL != "":
str.BufAppend(sb, " @specifiedBy(url: ")
str.BufAppend(sb, PrintStringValue(t.specifiedByURL))
str.BufAppendChar(sb, 41)
end
str.BufAppendChar(sb, 10)
end
func _sp_directive(sb &: str.StringBuilder, sch: Schema, d: DirectiveDef):
_sp_description(sb, d.description, "")
str.BufAppend(sb, "directive @")
str.BufAppend(sb, d.name)
_sp_args(sb, sch, d.args)
if d.repeatable: str.BufAppend(sb, " repeatable") end
str.BufAppend(sb, " on ")
mut i := 0
until i < d.locations.len():
if i > 0: str.BufAppend(sb, " | ") end
str.BufAppend(sb, d.locations.get(i))
i += 1
end
str.BufAppendChar(sb, 10)
end
func _sp_needs_schema_block(sch: Schema): bool:
if sch.queryType != "" and sch.queryType != "Query": ret true end
if sch.mutationType != "" and sch.mutationType != "Mutation": ret true end
if sch.subscriptionType != "" and sch.subscriptionType != "Subscription": ret true end
ret false
end
func _sp_schema_block(sb &: str.StringBuilder, sch: Schema):
if not _sp_needs_schema_block(sch): ret end
str.BufAppend(sb, "schema {\n")
if sch.queryType != "":
str.BufAppend(sb, "  query: ")
str.BufAppend(sb, sch.queryType)
str.BufAppendChar(sb, 10)
end
if sch.mutationType != "":
str.BufAppend(sb, "  mutation: ")
str.BufAppend(sb, sch.mutationType)
str.BufAppendChar(sb, 10)
end
if sch.subscriptionType != "":
str.BufAppend(sb, "  subscription: ")
str.BufAppend(sb, sch.subscriptionType)
str.BufAppendChar(sb, 10)
end
str.BufAppend(sb, "}\n")
end
func _sp_print(sch: Schema, includeBuiltins: bool): str:
mut sb := str.NewBuilder()
defer str.BufFree(sb)
mut wrote := false
if _sp_needs_schema_block(sch):
_sp_schema_block(sb, sch)
wrote = true
end
mut i := 0
until i < sch.directives.len():
d := sch.directives.get(i)
if includeBuiltins or not _sp_is_builtin_directive(d.name):
if wrote: str.BufAppendChar(sb, 10) end
_sp_directive(sb, sch, d)
wrote = true
end
i += 1
end
mut j := 0
until j < sch.types.len():
t := sch.types.get(j)
if IsIntrospectionType(t.name):
j += 1
continue
end
if includeBuiltins or not _sp_is_builtin_scalar(t.name):
if wrote: str.BufAppendChar(sb, 10) end
_sp_type(sb, sch, t)
wrote = true
end
j += 1
end
ret str.BufStr(sb)
end
@en "PrintSchema"
@fa "چاپ طرح‌واره"
pub func PrintSchema(sch: Schema): str: ret _sp_print(sch, false) end
@en "PrintSchemaFull"
@fa "چاپ کامل طرح‌واره"
pub func PrintSchemaFull(sch: Schema): str: ret _sp_print(sch, true) end
@en "PrintType"
@fa "چاپ نوع"
pub func PrintType(sch: Schema, name: str): str:
t := FindType(sch, name)
if t.kind < 0: ret "" end
mut sb := str.NewBuilder()
defer str.BufFree(sb)
_sp_type(sb, sch, t)
ret str.BufStr(sb)
end
package graphql
import encoding.value
@en "ResolverSlot"
@fa "شکاف حل‌کننده"
pub struct ResolverSlot:
pub busy: bool = false
pub parent: value.Value = value.Value {}
pub args: value.Value = value.Value {}
pub ctx: value.Value = value.Value {}
pub fieldName: str = ""
pub parentType: str = ""
pub result: value.Value = value.Value {}
pub resolved: bool = false
pub failed: bool = false
pub message: str = ""
end
@en "SlotTable"
@fa "جدول شکاف"
pub struct GqlSlotTable:
pub items: Vector<ResolverSlot> = Vector {}
end
package graphql
@en "TOK_EOF"
@fa "نشانه انتهای متن"
pub const TOK_EOF := 0
@en "TOK_NAME"
@fa "نشانه نام"
pub const TOK_NAME := 1
@en "TOK_INT"
@fa "نشانه عدد صحیح"
pub const TOK_INT := 2
@en "TOK_FLOAT"
@fa "نشانه عدد اعشاری"
pub const TOK_FLOAT := 3
@en "TOK_STRING"
@fa "نشانه رشته"
pub const TOK_STRING := 4
@en "TOK_BLOCK_STRING"
@fa "نشانه رشته بلوکی"
pub const TOK_BLOCK_STRING := 5
@en "TOK_BANG"
@fa "نشانه علامت تعجب"
pub const TOK_BANG := 6
@en "TOK_DOLLAR"
@fa "نشانه دلار"
pub const TOK_DOLLAR := 7
@en "TOK_AMP"
@fa "نشانه امپرسند"
pub const TOK_AMP := 8
@en "TOK_LPAREN"
@fa "نشانه پرانتز باز"
pub const TOK_LPAREN := 9
@en "TOK_RPAREN"
@fa "نشانه پرانتز بسته"
pub const TOK_RPAREN := 10
@en "TOK_SPREAD"
@fa "نشانه پخش"
pub const TOK_SPREAD := 11
@en "TOK_COLON"
@fa "نشانه دونقطه"
pub const TOK_COLON := 12
@en "TOK_EQUALS"
@fa "نشانه مساوی"
pub const TOK_EQUALS := 13
@en "TOK_AT"
@fa "نشانه ات"
pub const TOK_AT := 14
@en "TOK_LBRACKET"
@fa "نشانه کروشه باز"
pub const TOK_LBRACKET := 15
@en "TOK_RBRACKET"
@fa "نشانه کروشه بسته"
pub const TOK_RBRACKET := 16
@en "TOK_LBRACE"
@fa "نشانه آکولاد باز"
pub const TOK_LBRACE := 17
@en "TOK_RBRACE"
@fa "نشانه آکولاد بسته"
pub const TOK_RBRACE := 18
@en "TOK_PIPE"
@fa "نشانه خط عمودی"
pub const TOK_PIPE := 19
@en "TOK_ERROR"
@fa "نشانه خطا"
pub const TOK_ERROR := 20
@en "Token"
@fa "توکن"
pub struct GqlToken:
pub kind: int = TOK_EOF
pub lexeme: str = ""
pub sval: str = ""
pub ival: i64 = 0
pub fval: f64 = 0.0
pub line: int = 0
pub col: int = 0
pub pos: int = 0
end
@en "TokenStream"
@fa "جریان توکن"
pub struct GqlTokenStream:
pub toks: Vector<GqlToken> = Vector {}
end
@en "TokenKindName"
@fa "نام نوع توکن"
pub func TokenKindName(kind: int): str:
if kind == TOK_EOF: ret "<EOF>" end
if kind == TOK_NAME: ret "Name" end
if kind == TOK_INT: ret "Int" end
if kind == TOK_FLOAT: ret "Float" end
if kind == TOK_STRING: ret "String" end
if kind == TOK_BLOCK_STRING: ret "BlockString" end
if kind == TOK_BANG: ret "!" end
if kind == TOK_DOLLAR: ret "$" end
if kind == TOK_AMP: ret "&" end
if kind == TOK_LPAREN: ret "(" end
if kind == TOK_RPAREN: ret ")" end
if kind == TOK_SPREAD: ret "..." end
if kind == TOK_COLON: ret ":" end
if kind == TOK_EQUALS: ret "=" end
if kind == TOK_AT: ret "@" end
if kind == TOK_LBRACKET: ret "[" end
if kind == TOK_RBRACKET: ret "]" end
if kind == TOK_LBRACE: ret "{" end
if kind == TOK_RBRACE: ret "}" end
if kind == TOK_PIPE: ret "|" end
ret "<error>"
end
@en "IsStringToken"
@fa "توکن رشته است"
pub func IsStringToken(kind: int): bool:
ret kind == TOK_STRING or kind == TOK_BLOCK_STRING
end
package graphql
@en "Vx"
@fa "وضعیت اعتبارسنجی"
pub struct Vx:
pub sch: Schema = Schema {}
pub doc: Document = Document {}
pub errors: GqlErrorList = GqlErrorList {}
pub usedFragments: Vector<str> = Vector {}
pub usedVars: Vector<str> = Vector {}
end
func _vx_error(vx &: Vx, message: str, line: int, col: int):
mut e := NewError(ERR_VALIDATION, message)
if line > 0:
e.line = line
e.col = col
e.hasLocation = true
end
AddError(vx.errors, e)
end
func _vx_has(names: Vector<str>, name: str): bool:
mut i := 0
until i < names.len():
if names.get(i) == name: ret true end
i += 1
end
ret false
end
func _v_operations(vx &: Vx):
mut seen := Vector {} as Vector<str>
defer seen.free()
mut anonymous := 0
mut i := 0
until i < vx.doc.ops.len():
op := vx.doc.ops.get(i)
if op.name == "":
anonymous += 1
else:
if _vx_has(seen, op.name):
_vx_error(vx, _gql_dup_operation_msg(op.name), op.line, 0)
end
seen.push(op.name)
end
i += 1
end
if anonymous > 0 and vx.doc.ops.len() > 1:
_vx_error(vx, _gql_lone_anonymous_msg(), 0, 0)
end
end
func _v_operation_roots(vx &: Vx):
mut i := 0
until i < vx.doc.ops.len():
op := vx.doc.ops.get(i)
root := RootTypeName(vx.sch, op.optype)
if root == "" or not HasType(vx.sch, root):
_vx_error(vx, _gql_no_root_msg(OperationTypeName(op.optype)), op.line, 0)
end
i += 1
end
end
func _v_fragment_names(vx &: Vx):
mut seen := Vector {} as Vector<str>
defer seen.free()
mut i := 0
until i < vx.doc.frags.len():
f := vx.doc.frags.get(i)
if _vx_has(seen, f.name):
_vx_error(vx, _gql_dup_fragment_msg(f.name), f.line, 0)
end
seen.push(f.name)
i += 1
end
end
func _v_fragment_conditions(vx &: Vx):
mut i := 0
until i < vx.doc.frags.len():
f := vx.doc.frags.get(i)
_v_check_condition(vx, f.typeCondition, f.line)
i += 1
end
end
func _v_check_condition(vx &: Vx, name: str, line: int):
if not HasType(vx.sch, name):
_vx_error(vx, _gql_unknown_type_msg(name), line, 0)
ret
end
k := FindType(vx.sch, name).kind
if k != TYPE_OBJECT and k != TYPE_INTERFACE and k != TYPE_UNION:
_vx_error(vx, _gql_not_composite_msg(name), line, 0)
end
end
func _v_fragment_cycles(vx &: Vx):
mut reported := Vector {} as Vector<str>
defer reported.free()
mut i := 0
until i < vx.doc.frags.len():
mut chain := Vector {} as Vector<str>
_v_cycle_walk(vx, i, chain, reported)
chain.free()
i += 1
end
end
func _v_cycle_walk(vx &: Vx, fragIdx: int, chain &: Vector<str>, reported &: Vector<str>):
f := vx.doc.frags.get(fragIdx)
if _vx_has(chain, f.name):
if not _vx_has(reported, f.name):
reported.push(f.name)
_vx_error(vx, _gql_fragment_cycle_msg(f.name), f.line, 0)
end
ret
end
chain.push(f.name)
_v_cycle_selections(vx, f.selections, chain, reported)
chain.pop()
end
func _v_cycle_selections(vx &: Vx, sels: Vector<int>, chain &: Vector<str>, reported &: Vector<str>):
mut i := 0
until i < sels.len():
s := SelectionAt(vx.doc, sels.get(i))
i += 1
if s.kind == SEL_FRAGMENT_SPREAD:
idx := FindFragment(vx.doc, s.name)
if idx >= 0: _v_cycle_walk(vx, idx, chain, reported) end
continue
end
_v_cycle_selections(vx, s.selections, chain, reported)
end
end
func _v_collect_spreads(vx &: Vx, sels: Vector<int>):
mut i := 0
until i < sels.len():
s := SelectionAt(vx.doc, sels.get(i))
i += 1
if s.kind == SEL_FRAGMENT_SPREAD:
if FindFragment(vx.doc, s.name) < 0:
_vx_error(vx, _gql_unknown_fragment_msg(s.name), s.line, s.col)
end
if not _vx_has(vx.usedFragments, s.name): vx.usedFragments.push(s.name) end
continue
end
_v_collect_spreads(vx, s.selections)
end
end
func _v_fragment_usage(vx &: Vx):
mut i := 0
until i < vx.doc.ops.len():
_v_collect_spreads(vx, vx.doc.ops.get(i).selections)
i += 1
end
mut j := 0
until j < vx.doc.frags.len():
_v_collect_spreads(vx, vx.doc.frags.get(j).selections)
j += 1
end
mut k := 0
until k < vx.doc.frags.len():
f := vx.doc.frags.get(k)
if not _vx_has(vx.usedFragments, f.name):
_vx_error(vx, _gql_unused_fragment_msg(f.name), f.line, 0)
end
k += 1
end
end
func _v_variable_defs(vx &: Vx, op: AstOperation):
mut seen := Vector {} as Vector<str>
defer seen.free()
mut i := 0
until i < op.varDefs.len():
vd := op.varDefs.get(i)
i += 1
if _vx_has(seen, vd.name):
_vx_error(vx, _gql_dup_variable_msg(vd.name), vd.line, 0)
end
seen.push(vd.name)
name := TypeRefName(vx.doc, vd.typeRef)
if not HasType(vx.sch, name):
_vx_error(vx, _gql_unknown_type_msg(name), vd.line, 0)
continue
end
if not IsInputType(vx.sch, name):
_vx_error(vx, _gql_not_input_type_msg(vd.name, name), vd.line, 0)
end
end
end
func _v_collect_var_uses(vx &: Vx, sels: Vector<int>, seenFrags &: Vector<str>):
mut i := 0
until i < sels.len():
s := SelectionAt(vx.doc, sels.get(i))
i += 1
_v_collect_arg_vars(vx, s.args)
_v_collect_directive_vars(vx, s.directives)
if s.kind == SEL_FRAGMENT_SPREAD:
if _vx_has(seenFrags, s.name): continue end
seenFrags.push(s.name)
idx := FindFragment(vx.doc, s.name)
if idx >= 0:
f := vx.doc.frags.get(idx)
_v_collect_directive_vars(vx, f.directives)
_v_collect_var_uses(vx, f.selections, seenFrags)
end
continue
end
_v_collect_var_uses(vx, s.selections, seenFrags)
end
end
func _v_collect_arg_vars(vx &: Vx, args: Vector<AstArgument>):
mut i := 0
until i < args.len():
_v_collect_value_vars(vx, args.get(i).value)
i += 1
end
end
func _v_collect_directive_vars(vx &: Vx, ds: Vector<AstDirective>):
mut i := 0
until i < ds.len():
_v_collect_arg_vars(vx, ds.get(i).args)
i += 1
end
end
func _v_collect_value_vars(vx &: Vx, valueId: int):
v := ValueAt(vx.doc, valueId)
if v.kind == VAL_VARIABLE:
if not _vx_has(vx.usedVars, v.s): vx.usedVars.push(v.s) end
ret
end
mut i := 0
until i < v.items.len():
_v_collect_value_vars(vx, v.items.get(i))
i += 1
end
end
func _v_variable_usage(vx &: Vx, op: AstOperation):
vx.usedVars.free()
vx.usedVars = Vector {} as Vector<str>
mut seenFrags := Vector {} as Vector<str>
defer seenFrags.free()
_v_collect_directive_vars(vx, op.directives)
_v_collect_var_uses(vx, op.selections, seenFrags)
mut defined := Vector {} as Vector<str>
defer defined.free()
mut i := 0
until i < op.varDefs.len():
defined.push(op.varDefs.get(i).name)
i += 1
end
mut j := 0
until j < vx.usedVars.len():
name := vx.usedVars.get(j)
if not _vx_has(defined, name):
_vx_error(vx, _gql_undefined_variable_msg(name), op.line, 0)
end
j += 1
end
mut k := 0
until k < defined.len():
name := defined.get(k)
if not _vx_has(vx.usedVars, name):
_vx_error(vx, _gql_unused_variable_msg(name), op.line, 0)
end
k += 1
end
end
@en "Validate"
@fa "اعتبارسنجی"
pub func Validate(sch: Schema, doc: Document): GqlErrorList:
mut vx := Vx {}
vx.sch = sch
vx.doc = doc
_v_operations(vx)
_v_operation_roots(vx)
_v_fragment_names(vx)
_v_fragment_conditions(vx)
_v_fragment_cycles(vx)
_v_fragment_usage(vx)
mut i := 0
until i < doc.ops.len():
op := doc.ops.get(i)
_v_variable_defs(vx, op)
_v_variable_usage(vx, op)
_v_operation_selections(vx, op)
i += 1
end
_v_fragment_selections(vx)
defer vx.usedFragments.free()
defer vx.usedVars.free()
ret vx.errors
end
@en "ValidateOk"
@fa "اعتبارسنجی موفق"
pub func ValidateOk(sch: Schema, doc: Document): bool:
mut errs := Validate(sch, doc)
ok := not HasErrors(errs)
FreeErrorList(errs)
ret ok
end
@en "ValidateSource"
@fa "اعتبارسنجی منبع"
pub func ValidateSource(sch: Schema, source: str): GqlErrorList:
mut err := GqlError {}
mut doc := Parse(source, err)
mut out := GqlErrorList {}
if err.message != "":
AddError(out, err)
FreeDocument(doc)
ret out
end
out = Validate(sch, doc)
FreeDocument(doc)
ret out
end
package graphql
import encoding.value
func _vs_dup(names: Vector<str>, name: str): bool:
mut i := 0
until i < names.len():
if names.get(i) == name: ret true end
i += 1
end
ret false
end
func _vs_location_allowed(d: DirectiveDef, want: str): bool:
mut i := 0
until i < d.locations.len():
if d.locations.get(i) == want: ret true end
i += 1
end
ret false
end
func _vs_directives(vx &: Vx, ds: Vector<AstDirective>, location: str):
mut seen := Vector {} as Vector<str>
defer seen.free()
mut i := 0
until i < ds.len():
d := ds.get(i)
i += 1
def := FindDirectiveDef(vx.sch, d.name)
if def.name == "":
_vx_error(vx, _gql_unknown_directive_msg(d.name), d.line, 0)
continue
end
if not _vs_location_allowed(def, location):
_vx_error(vx, _gql_directive_location_msg(d.name, location), d.line, 0)
end
if not def.repeatable and _vs_dup(seen, d.name):
_vx_error(vx, _gql_dup_directive_msg(d.name), d.line, 0)
end
seen.push(d.name)
_vs_arguments(vx, def.args, d.args, d.name, true, d.line)
end
end
func _vs_arguments(vx &: Vx, defs: Vector<InputValueDef>, args: Vector<AstArgument>, owner: str, isDirective: bool, line: int):
mut seen := Vector {} as Vector<str>
defer seen.free()
mut i := 0
until i < args.len():
a := args.get(i)
i += 1
if _vs_dup(seen, a.name):
_vx_error(vx, _gql_dup_argument_msg(a.name), a.line, 0)
end
seen.push(a.name)
def := _vs_find_arg(defs, a.name)
if def.name == "":
_vx_error(vx, _gql_unknown_argument_msg(a.name, owner, isDirective), a.line, 0)
continue
end
_vs_value(vx, a.value, def.typeRef, a.name, a.line)
end
_vs_required_arguments(vx, defs, args, owner, isDirective, line)
end
func _vs_find_arg(defs: Vector<InputValueDef>, name: str): InputValueDef:
mut i := 0
until i < defs.len():
if defs.get(i).name == name: ret defs.get(i) end
i += 1
end
ret InputValueDef { typeRef = 0 - 1 }
end
func _vs_arg_present(args: Vector<AstArgument>, name: str): bool:
mut i := 0
until i < args.len():
if args.get(i).name == name: ret true end
i += 1
end
ret false
end
func _vs_required_arguments(vx &: Vx, defs: Vector<InputValueDef>, args: Vector<AstArgument>, owner: str, isDirective: bool, line: int):
mut i := 0
until i < defs.len():
def := defs.get(i)
i += 1
if not TypeRefIsNonNull(vx.sch.doc, def.typeRef): continue end
if def.hasDefault: continue end
if not _vs_arg_present(args, def.name):
_vx_error(vx, _gql_missing_argument_msg(def.name, owner, isDirective), line, 0)
end
end
end
func _vs_value(vx &: Vx, valueId: int, typeRef: int, argName: str, line: int):
if typeRef < 0: ret end
v := ValueAt(vx.doc, valueId)
if v.kind == VAL_VARIABLE: ret end
if _vs_value_has_variable(vx, valueId): ret end
lit := LiteralToValue(vx.sch, vx.doc, valueId, value.NewValueObject())
if not lit.ok:
_vx_error(vx, _gql_arg_msg(argName, lit.message), line, 0)
ret
end
r := CoerceInput(vx.sch, vx.sch.doc, typeRef, lit.value)
if not r.ok:
_vx_error(vx, _gql_arg_msg(argName, r.message), line, 0)
end
end
func _vs_value_has_variable(vx: Vx, valueId: int): bool:
v := ValueAt(vx.doc, valueId)
if v.kind == VAL_VARIABLE: ret true end
mut i := 0
until i < v.items.len():
if _vs_value_has_variable(vx, v.items.get(i)): ret true end
i += 1
end
ret false
end
func _vs_field_def(vx: Vx, typeName: str, fieldName: str): FieldDef:
t := FindType(vx.sch, typeName)
f := FindField(t, fieldName)
if f.name != "": ret f end
mut i := 0
until i < t.interfaces.len():
it := FindType(vx.sch, t.interfaces.get(i))
itf := FindField(it, fieldName)
if itf.name != "": ret itf end
i += 1
end
ret FieldDef { typeRef = 0 - 1 }
end
func _vs_meta_field(vx &: Vx, s: AstSelection): bool:
if s.name != "__typename": ret false end
if s.selections.len() > 0:
_vx_error(vx, _gql_leaf_selection_msg(s.name, "String"), s.line, s.col)
end
ret true
end
func _vs_selection_shape(vx &: Vx, s: AstSelection, typeName: str):
if IsLeafType(vx.sch, typeName):
if s.selections.len() > 0:
_vx_error(vx, _gql_leaf_selection_msg(s.name, typeName), s.line, s.col)
end
ret
end
if s.selections.len() == 0:
_vx_error(vx, _gql_missing_selection_msg(s.name, typeName), s.line, s.col)
end
end
func _vs_field(vx &: Vx, s: AstSelection, parentType: str):
_vs_directives(vx, s.directives, "FIELD")
if _vs_meta_field(vx, s): ret end
if _vs_introspection_field(vx, s, parentType): ret end
def := _vs_field_def(vx, parentType, s.name)
if def.typeRef < 0:
_vx_error(vx, _gql_unknown_field_msg(s.name, parentType), s.line, s.col)
ret
end
_vs_arguments(vx, def.args, s.args, s.name, false, s.line)
typeName := TypeRefName(vx.sch.doc, def.typeRef)
_vs_selection_shape(vx, s, typeName)
if s.selections.len() > 0:
_vs_walk(vx, s.selections, typeName)
end
end
func _vs_types_overlap(vx: Vx, a: str, b: str): bool:
if a == b: ret true end
mut pa := PossibleTypes(vx.sch, a)
defer pa.free()
mut pb := PossibleTypes(vx.sch, b)
defer pb.free()
mut i := 0
until i < pa.len():
mut j := 0
until j < pb.len():
if pa.get(i) == pb.get(j): ret true end
j += 1
end
i += 1
end
ret false
end
func _vs_spread(vx &: Vx, s: AstSelection, parentType: str):
_vs_directives(vx, s.directives, "FRAGMENT_SPREAD")
idx := FindFragment(vx.doc, s.name)
if idx < 0: ret end
cond := vx.doc.frags.get(idx).typeCondition
if not HasType(vx.sch, cond): ret end
if not _vs_types_overlap(vx, cond, parentType):
_vx_error(vx, _gql_spread_incompatible_msg(s.name, cond, parentType), s.line, s.col)
end
end
func _vs_inline(vx &: Vx, s: AstSelection, parentType: str):
_vs_directives(vx, s.directives, "INLINE_FRAGMENT")
mut inner := parentType
if s.hasTypeCondition:
_v_check_condition(vx, s.typeCondition, s.line)
if not HasType(vx.sch, s.typeCondition): ret end
if not _vs_types_overlap(vx, s.typeCondition, parentType):
_vx_error(vx, _gql_inline_incompatible_msg(s.typeCondition, parentType), s.line, s.col)
ret
end
inner = s.typeCondition
end
_vs_walk(vx, s.selections, inner)
end
func _vs_walk(vx &: Vx, sels: Vector<int>, parentType: str):
if not HasType(vx.sch, parentType): ret end
mut i := 0
until i < sels.len():
s := SelectionAt(vx.doc, sels.get(i))
i += 1
if s.kind == SEL_FIELD: _vs_field(vx, s, parentType)
else s.kind == SEL_FRAGMENT_SPREAD: _vs_spread(vx, s, parentType)
else:
_vs_inline(vx, s, parentType)
end
end
end
func _v_operation_selections(vx &: Vx, op: AstOperation):
mut location := "QUERY"
if op.optype == OP_MUTATION: location = "MUTATION" end
if op.optype == OP_SUBSCRIPTION: location = "SUBSCRIPTION" end
_vs_directives(vx, op.directives, location)
root := RootTypeName(vx.sch, op.optype)
if root == "" or not HasType(vx.sch, root): ret end
_vs_walk(vx, op.selections, root)
if op.optype == OP_SUBSCRIPTION: _vs_single_root_field(vx, op) end
end
func _vs_single_root_field(vx &: Vx, op: AstOperation):
root := RootTypeName(vx.sch, op.optype)
mut gs := CollectFields(vx.sch, vx.doc, op.selections, root, value.NewValueObject())
defer FreeFieldGroups(gs)
if gs.items.len() != 1:
_vx_error(vx, _gql_single_root_field_msg(), op.line, 0)
end
end
func _v_fragment_selections(vx &: Vx):
mut i := 0
until i < vx.doc.frags.len():
f := vx.doc.frags.get(i)
i += 1
_vs_directives(vx, f.directives, "FRAGMENT_DEFINITION")
if not HasType(vx.sch, f.typeCondition): continue end
_vs_walk(vx, f.selections, f.typeCondition)
end
end
package graphql
func _gql_dup_operation_msg(name: str): str:
ret "there can be only one operation named " + _gql_quote(name)
end
func _gql_lone_anonymous_msg(): str:
ret "this anonymous operation must be the only defined operation"
end
func _gql_dup_fragment_msg(name: str): str:
ret "there can be only one fragment named " + _gql_quote(name)
end
func _gql_unknown_fragment_msg(name: str): str:
ret "unknown fragment " + _gql_quote(name)
end
func _gql_unused_fragment_msg(name: str): str:
ret "fragment " + _gql_quote(name) + " is never used"
end
func _gql_fragment_cycle_msg(name: str): str:
ret "cannot spread fragment " + _gql_quote(name) + " within itself"
end
func _gql_unknown_type_msg(name: str): str:
ret "unknown type " + _gql_quote(name)
end
func _gql_not_composite_msg(name: str): str:
ret "fragment cannot condition on non-composite type " + _gql_quote(name)
end
func _gql_not_input_type_msg(varName: str, typeName: str): str:
ret "variable " + _gql_quote("$" + varName) + " cannot be non-input type " + _gql_quote(typeName)
end
func _gql_dup_variable_msg(name: str): str:
ret "there can be only one variable named " + _gql_quote("$" + name)
end
func _gql_undefined_variable_msg(name: str): str:
ret "variable " + _gql_quote("$" + name) + " is not defined by the operation"
end
func _gql_unused_variable_msg(name: str): str:
ret "variable " + _gql_quote("$" + name) + " is never used"
end
func _gql_unknown_directive_msg(name: str): str:
ret "unknown directive " + _gql_quote("@" + name)
end
func _gql_directive_location_msg(name: str, location: str): str:
ret "directive " + _gql_quote("@" + name) + " may not be used on " + location
end
func _gql_dup_directive_msg(name: str): str:
ret "the directive " + _gql_quote("@" + name) + " can only be used once at this location"
end
func _gql_dup_argument_msg(name: str): str:
ret "there can be only one argument named " + _gql_quote(name)
end
func _gql_owner_label(owner: str, isDirective: bool): str:
if isDirective: ret "directive " + _gql_quote("@" + owner) end
ret "field " + _gql_quote(owner)
end
func _gql_unknown_argument_msg(name: str, owner: str, isDirective: bool): str:
ret "unknown argument " + _gql_quote(name) + " on " + _gql_owner_label(owner, isDirective)
end
func _gql_missing_argument_msg(name: str, owner: str, isDirective: bool): str:
ret _gql_owner_label(owner, isDirective) + " requires argument " + _gql_quote(name)
end
func _gql_leaf_selection_msg(fieldName: str, typeName: str): str:
ret "field " + _gql_quote(fieldName) + " of type " + _gql_quote(typeName) + " must not have a selection set"
end
func _gql_missing_selection_msg(fieldName: str, typeName: str): str:
ret "field " + _gql_quote(fieldName) + " of type " + _gql_quote(typeName) + " must have a selection set"
end
func _gql_spread_incompatible_msg(name: str, cond: str, parent: str): str:
ret "fragment " + _gql_quote(name) + " cannot be spread here as objects of type " + _gql_quote(parent) + " can never be of type " + _gql_quote(cond)
end
func _gql_inline_incompatible_msg(cond: str, parent: str): str:
ret "fragment cannot be spread here as objects of type " + _gql_quote(parent) + " can never be of type " + _gql_quote(cond)
end
func _gql_single_root_field_msg(): str:
ret "a subscription operation must select exactly one root field"
end
@en "graphql"
@fa "گراف‌کیوال"
package graphql
@en "SpecEdition"
@fa "ویرایش مشخصات"
pub const SpecEdition := "October2021"
@en "grpc"
@fa "جی آر پی سی"
package grpc
import compress
import net.http2
@en "GRPC_OK"
@fa "وضعیت بدون خطا"
pub const GRPC_OK := 0
@en "GRPC_CANCELLED"
@fa "وضعیت لغو شده"
pub const GRPC_CANCELLED := 1
@en "GRPC_UNKNOWN"
@fa "وضعیت ناشناخته"
pub const GRPC_UNKNOWN := 2
@en "GRPC_INVALID_ARGUMENT"
@fa "وضعیت آرگومان نامعتبر"
pub const GRPC_INVALID_ARGUMENT := 3
@en "GRPC_DEADLINE_EXCEEDED"
@fa "وضعیت گذشت مهلت"
pub const GRPC_DEADLINE_EXCEEDED := 4
@en "GRPC_NOT_FOUND"
@fa "وضعیت یافت نشد"
pub const GRPC_NOT_FOUND := 5
@en "GRPC_ALREADY_EXISTS"
@fa "وضعیت از پیش موجود"
pub const GRPC_ALREADY_EXISTS := 6
@en "GRPC_PERMISSION_DENIED"
@fa "وضعیت دسترسی رد شد"
pub const GRPC_PERMISSION_DENIED := 7
@en "GRPC_RESOURCE_EXHAUSTED"
@fa "وضعیت منابع تمام شد"
pub const GRPC_RESOURCE_EXHAUSTED := 8
@en "GRPC_FAILED_PRECONDITION"
@fa "وضعیت پیش‌شرط ناموفق"
pub const GRPC_FAILED_PRECONDITION := 9
@en "GRPC_ABORTED"
@fa "وضعیت قطع شده"
pub const GRPC_ABORTED := 10
@en "GRPC_OUT_OF_RANGE"
@fa "وضعیت خارج از محدوده"
pub const GRPC_OUT_OF_RANGE := 11
@en "GRPC_UNIMPLEMENTED"
@fa "وضعیت پیاده‌سازی نشده"
pub const GRPC_UNIMPLEMENTED := 12
@en "GRPC_INTERNAL"
@fa "وضعیت خطای داخلی"
pub const GRPC_INTERNAL := 13
@en "GRPC_UNAVAILABLE"
@fa "وضعیت ناموجود"
pub const GRPC_UNAVAILABLE := 14
@en "GRPC_DATA_LOSS"
@fa "وضعیت از دست رفتن داده"
pub const GRPC_DATA_LOSS := 15
@en "GRPC_UNAUTHENTICATED"
@fa "وضعیت احراز نشده"
pub const GRPC_UNAUTHENTICATED := 16
@en "GRPC_CONTENT_TYPE"
@fa "نوع محتوا"
pub const GRPC_CONTENT_TYPE := "application/grpc"
@en "GRPC_CONTENT_TYPE_PROTO"
@fa "نوع محتوای پروتو"
pub const GRPC_CONTENT_TYPE_PROTO := "application/grpc+proto"
@en "GRPC_CONTENT_TYPE_JSON"
@fa "نوع محتوای جیسون"
pub const GRPC_CONTENT_TYPE_JSON := "application/grpc+json"
@en "GRPC_COMP_NONE"
@fa "بدون فشرده‌سازی"
pub const GRPC_COMP_NONE := 0
@en "GRPC_COMP_GZIP"
@fa "فشرده‌سازی جی زیپ"
pub const GRPC_COMP_GZIP := 1
@en "GRPC_MAX_FRAMES"
@fa "بیشینه قاب‌ها"
pub const GRPC_MAX_FRAMES := 100000
@en "Status"
@fa "وضعیت"
pub struct Status:
pub code: int = 0
pub message: str = ""
end
@en "MDEntry"
@fa "مدخل فراداده"
pub struct MDEntry:
pub key: str = ""
pub value: str = ""
pub binary: bool = false
end
@en "Metadata"
@fa "فراداده"
pub struct Metadata:
pub items: Vector<MDEntry> = Vector {}
end
@en "CallCtx"
@fa "زمینه فراخوان"
pub struct CallCtx:
pub stream_id: int = 0
pub method: str = ""
pub headers: http2.HeaderList = http2.HeaderList {}
pub recv: compress.ByteBuf = compress.ByteBuf {}
pub recv_pos: int = 0
pub client_done: bool = false
pub sent_headers: bool = false
pub status: Status = Status {}
pub busy: bool = false
pub failed: bool = false
end
@en "CallTable"
@fa "جدول فراخوان‌ها"
pub struct CallTable:
pub items: Vector<CallCtx> = Vector {}
end
@en "MethodDesc"
@fa "توصیف متد"
pub struct MethodDesc:
pub path: str = ""
pub fn: i64 = 0
pub client_stream: bool = false
pub server_stream: bool = false
end
@en "MethodTable"
@fa "جدول متدها"
pub struct MethodTable:
pub items: Vector<MethodDesc> = Vector {}
end
@en "Cursor"
@fa "مکان‌نما"
pub struct Cursor:
pub stream_id: int = 0
pub pos: int = 0
end
@en "CursorTable"
@fa "جدول مکان‌نماها"
pub struct CursorTable:
pub items: Vector<Cursor> = Vector {}
end
@en "NewStatus"
@fa "وضعیت جدید"
pub func NewStatus(code: int, message: str): Status:
mut s := Status {}
s.code = code
s.message = message
ret s
end
@en "StatusOk"
@fa "وضعیت موفق"
pub func StatusOk(s: Status): bool:
ret s.code == GRPC_OK
end
@en "MethodPath"
@fa "مسیر متد"
pub func MethodPath(service: str, method: str): str:
ret "/" + service + "/" + method
end
package grpc
import compress
import conv
import net.http2
import net.internal.rawsock
import tls
@en "Channel"
@fa "کانال"
pub struct Channel:
pub conn: http2.Conn = http2.Conn {}
pub authority: str = ""
pub scheme: str = "http"
pub user_agent: str = "salam-grpc/1.0"
pub timeout_ms: int = 0
pub use_gzip: bool = false
pub cursors: CursorTable = CursorTable {}
pub ok: bool = false
pub last_error: str = ""
end
func _cursor_index(ch &: Channel, sid: int): int:
mut i := 0
until i < ch.cursors.items.len():
if ch.cursors.items.get(i).stream_id == sid: ret i end
i += 1
end
mut c := Cursor {}
c.stream_id = sid
c.pos = 0
ch.cursors.items.push(c)
ret ch.cursors.items.len() - 1
end
func _cursor_pos(ch &: Channel, sid: int): int:
ret ch.cursors.items.get(_cursor_index(ch, sid)).pos
end
func _cursor_set(ch &: Channel, sid: int, pos: int):
idx := _cursor_index(ch, sid)
mut c := ch.cursors.items.get(idx)
c.pos = pos
ch.cursors.items.set(idx, c)
end
func _timeout_header(ms: int): str:
ret conv.FormatInt(ms as i64) + "m"
end
func _finish_channel(ch &: Channel): bool:
if not http2.ClientHandshake(ch.conn):
ch.last_error = "HTTP/2 handshake failed"
ret false
end
if http2.Poll(ch.conn) == http2.H2_POLL_ERROR:
ch.last_error = "no SETTINGS from server"
ret false
end
ch.ok = true
ret true
end
@en "Dial"
@fa "اتصال"
pub func Dial(host: str, port: int): Channel:
mut ch := Channel {}
ch.authority = host + ":" + conv.FormatInt(port as i64)
ch.scheme = "http"
sock := rawsock.Connect(host, port)
if not rawsock.Ok(sock):
ch.last_error = "connect failed"
ret ch
end
ch.conn = http2.NewConn(http2.PlainTransport(sock.fd), false)
_finish_channel(ch)
ret ch
end
@en "DialTLS"
@fa "اتصال امن"
pub func DialTLS(host: str, port: int): Channel:
mut ch := Channel {}
ch.authority = host + ":" + conv.FormatInt(port as i64)
ch.scheme = "https"
cfg := tls.NewConfig(host)
sec := tls.Dial(host, port, cfg)
if not tls.ConnOk(sec):
ch.last_error = tls.ConnError(sec)
ret ch
end
ch.conn = http2.NewConn(http2.TLSTransport(sec), false)
_finish_channel(ch)
ret ch
end
@en "ChannelOk"
@fa "کانال معتبر"
pub func ChannelOk(ch: Channel): bool:
ret ch.ok
end
@en "ChannelError"
@fa "خطای کانال"
pub func ChannelError(ch: Channel): str:
ret ch.last_error
end
@en "SetTimeout"
@fa "تنظیم مهلت"
pub func SetTimeout(ch &: Channel, ms: int):
ch.timeout_ms = ms
end
@en "SetGzip"
@fa "فعال‌سازی فشرده‌سازی"
pub func SetGzip(ch &: Channel, enable: bool):
ch.use_gzip = enable
end
@en "CloseChannel"
@fa "بستن کانال"
pub func CloseChannel(ch &: Channel):
if ch.ok:
http2.SendGoAway(ch.conn, http2.H2_NO_ERROR, "")
http2.CloseConn(ch.conn)
end
ch.ok = false
end
@en "StartCall"
@fa "شروع فراخوان"
pub func StartCall(ch &: Channel, path: str, md: Metadata): int:
if not ch.ok: ret 0 end
sid := http2.NextStreamId(ch.conn)
mut hl := http2.HeaderList {}
http2.HeadersAdd(hl, ":method", "POST")
http2.HeadersAdd(hl, ":scheme", ch.scheme)
http2.HeadersAdd(hl, ":path", path)
http2.HeadersAdd(hl, ":authority", ch.authority)
http2.HeadersAdd(hl, "content-type", GRPC_CONTENT_TYPE_PROTO)
http2.HeadersAdd(hl, "user-agent", ch.user_agent)
http2.HeadersAdd(hl, "te", "trailers")
if ch.timeout_ms > 0:
http2.HeadersAdd(hl, "grpc-timeout", _timeout_header(ch.timeout_ms))
end
if ch.use_gzip:
http2.HeadersAdd(hl, "grpc-encoding", "gzip")
end
http2.HeadersAdd(hl, "grpc-accept-encoding", "identity,gzip")
MDToHeaders(md, hl)
if not http2.SendHeaders(ch.conn, sid, hl, false):
ch.last_error = "failed to send headers"
ret 0
end
ret sid
end
@en "SendMessage"
@fa "ارسال پیام"
pub func SendMessage(ch &: Channel, sid: int, msg: compress.ByteBuf, last: bool): bool:
if not ch.ok or sid == 0: ret false end
mut framed := FrameMessageGzip(msg, ch.use_gzip)
ok := http2.SendData(ch.conn, sid, framed, last)
compress.BufFree(framed)
if not ok: ch.last_error = "failed to send message" end
ret ok
end
@en "CloseSend"
@fa "بستن ارسال"
pub func CloseSend(ch &: Channel, sid: int): bool:
if not ch.ok or sid == 0: ret false end
empty := compress.NewByteBuf()
ok := http2.SendData(ch.conn, sid, empty, true)
compress.BufFree(empty)
ret ok
end
@en "RecvMessage"
@fa "دریافت پیام"
pub func RecvMessage(ch &: Channel, sid: int, ok &: bool): compress.ByteBuf:
if not ch.ok or sid == 0:
ok = false
ret compress.NewByteBuf()
end
mut guard := 0
until guard < GRPC_MAX_FRAMES:
s := http2.StreamAt(ch.conn, sid)
mut pos := _cursor_pos(ch, sid)
if HasMessage(s.data, pos):
mut mok := false
msg := NextMessage(s.data, pos, mok)
_cursor_set(ch, sid, pos)
ok = mok
ret msg
end
if s.end_stream or s.reset:
ok = false
ret compress.NewByteBuf()
end
if http2.Poll(ch.conn) == http2.H2_POLL_ERROR:
ch.last_error = "connection closed while awaiting a message"
ok = false
ret compress.NewByteBuf()
end
guard += 1
end
ok = false
ret compress.NewByteBuf()
end
@en "FinishCall"
@fa "پایان فراخوان"
pub func FinishCall(ch &: Channel, sid: int): Status:
mut st := Status {}
if not ch.ok or sid == 0:
st.code = GRPC_UNAVAILABLE
st.message = ch.last_error
ret st
end
if not http2.AwaitStreamEnd(ch.conn, sid, GRPC_MAX_FRAMES):
s := http2.StreamAt(ch.conn, sid)
if s.reset:
st.code = GRPC_CANCELLED
st.message = "stream reset: " + http2.ErrorName(s.error_code)
ret st
end
st.code = GRPC_UNAVAILABLE
st.message = "connection closed before the call completed"
ret st
end
s := http2.StreamAt(ch.conn, sid)
mut code_text := http2.HeadersGet(s.trailers, "grpc-status")
mut msg_text := http2.HeadersGet(s.trailers, "grpc-message")
if code_text == "":
code_text = http2.HeadersGet(s.headers, "grpc-status")
msg_text = http2.HeadersGet(s.headers, "grpc-message")
end
if code_text == "":
status_text := http2.HeadersGet(s.headers, ":status")
if status_text != "" and status_text != "200":
st.code = GRPC_UNKNOWN
st.message = "HTTP status " + status_text
ret st
end
st.code = GRPC_UNKNOWN
st.message = "server sent no grpc-status"
ret st
end
st.code = ParseStatusCode(code_text)
st.message = DecodeStatusMessage(msg_text)
ret st
end
@en "CallHeaders"
@fa "سرآیندهای فراخوان"
pub func CallHeaders(ch: Channel, sid: int): Metadata:
s := http2.StreamAt(ch.conn, sid)
ret MDFromHeaders(s.headers)
end
@en "CallTrailers"
@fa "دنباله‌های فراخوان"
pub func CallTrailers(ch: Channel, sid: int): Metadata:
s := http2.StreamAt(ch.conn, sid)
ret MDFromHeaders(s.trailers)
end
@en "UnaryCall"
@fa "فراخوان یگانه"
pub func UnaryCall(ch &: Channel, path: str, req: compress.ByteBuf, md: Metadata, st &: Status): compress.ByteBuf:
sid := StartCall(ch, path, md)
if sid == 0:
st = NewStatus(GRPC_UNAVAILABLE, ch.last_error)
ret compress.NewByteBuf()
end
if not SendMessage(ch, sid, req, true):
st = NewStatus(GRPC_UNAVAILABLE, ch.last_error)
ret compress.NewByteBuf()
end
mut ok := false
reply := RecvMessage(ch, sid, ok)
st = FinishCall(ch, sid)
if not ok and st.code == GRPC_OK:
st = NewStatus(GRPC_INTERNAL, "server returned no message")
end
ret reply
end
@en "UnaryCallStr"
@fa "فراخوان یگانه متنی"
pub func UnaryCallStr(ch &: Channel, path: str, req: str, st &: Status): str:
mut body := compress.BufFromStr(req)
md := NewMetadata()
mut reply := UnaryCall(ch, path, body, md, st)
compress.BufFree(body)
out := compress.BufToStrUnsafe(reply)
compress.BufFree(reply)
ret out
end
package grpc
import compress
@en "GRPC_MAX_MESSAGE"
@fa "بیشینه اندازه پیام"
pub const GRPC_MAX_MESSAGE := 4194304
@en "FrameMessage"
@fa "قاب‌بندی پیام"
pub func FrameMessage(msg: compress.ByteBuf, compressed: bool): compress.ByteBuf:
n := compress.BufLen(msg)
mut out := compress.NewByteBufCap(n + 5)
mut flag := 0
if compressed: flag = 1 end
compress.BufPush(out, flag)
compress.BufPush(out, (n >> 24) & 255)
compress.BufPush(out, (n >> 16) & 255)
compress.BufPush(out, (n >> 8) & 255)
compress.BufPush(out, n & 255)
compress.BufPushBuf(out, msg)
ret out
end
@en "FrameMessageGzip"
@fa "قاب‌بندی فشرده"
pub func FrameMessageGzip(msg: compress.ByteBuf, use_gzip: bool): compress.ByteBuf:
if not use_gzip: ret FrameMessage(msg, false) end
mut z := compress.GzipCompressBuf(msg)
if compress.BufLen(z) >= compress.BufLen(msg):
compress.BufFree(z)
ret FrameMessage(msg, false)
end
out := FrameMessage(z, true)
compress.BufFree(z)
ret out
end
@en "FrameMessageStr"
@fa "قاب‌بندی پیام متنی"
pub func FrameMessageStr(msg: str): compress.ByteBuf:
mut b := compress.BufFromStr(msg)
out := FrameMessage(b, false)
compress.BufFree(b)
ret out
end
@en "HasMessage"
@fa "پیام کامل دارد"
pub func HasMessage(data: compress.ByteBuf, pos: int): bool:
n := compress.BufLen(data)
if pos + 5 > n: ret false end
len := (compress.BufGet(data, pos + 1) << 24) | (compress.BufGet(data, pos + 2) << 16) | (compress.BufGet(data, pos + 3) << 8) | compress.BufGet(data, pos + 4)
if len < 0 or len > GRPC_MAX_MESSAGE: ret false end
ret pos + 5 + len <= n
end
@en "NextMessage"
@fa "پیام بعدی"
pub func NextMessage(data: compress.ByteBuf, pos &: int, ok &: bool): compress.ByteBuf:
if not HasMessage(data, pos):
ok = false
ret compress.NewByteBuf()
end
flag := compress.BufGet(data, pos)
len := (compress.BufGet(data, pos + 1) << 24) | (compress.BufGet(data, pos + 2) << 16) | (compress.BufGet(data, pos + 3) << 8) | compress.BufGet(data, pos + 4)
mut raw := compress.NewByteBufCap(len + 1)
mut i := 0
until i < len:
compress.BufPush(raw, compress.BufGet(data, pos + 5 + i))
i += 1
end
pos += 5 + len
if flag == 0:
ok = true
ret raw
end
mut zok := false
plain := compress.GzipDecompressBuf(raw, zok)
compress.BufFree(raw)
ok = zok
ret plain
end
@en "MessageCount"
@fa "تعداد پیام‌ها"
pub func MessageCount(data: compress.ByteBuf): int:
mut pos := 0
mut n := 0
until HasMessage(data, pos):
len := (compress.BufGet(data, pos + 1) << 24) | (compress.BufGet(data, pos + 2) << 16) | (compress.BufGet(data, pos + 3) << 8) | compress.BufGet(data, pos + 4)
pos += 5 + len
n += 1
end
ret n
end
package grpc
import compress
import net.http2
import net.internal.rawsock
mut _methods := MethodTable {}
mut _calls := CallTable {}
mut _conn := http2.Conn {}
@en "Server"
@fa "سرور جی آر پی سی"
pub struct Server:
pub port: int = 0
pub listen_fd: i64 = 0 - 1
pub running: bool = false
pub served: int = 0
end
func _find_method(path: str): int:
mut i := 0
until i < _methods.items.len():
if _methods.items.get(i).path == path: ret i end
i += 1
end
ret 0 - 1
end
func _alloc_call(): int:
mut i := 0
until i < _calls.items.len():
if not _calls.items.get(i).busy:
mut c := CallCtx {}
c.busy = true
c.recv = compress.NewByteBuf()
_calls.items.set(i, c)
ret i
end
i += 1
end
mut c := CallCtx {}
c.busy = true
c.recv = compress.NewByteBuf()
_calls.items.push(c)
ret _calls.items.len() - 1
end
func _call_at(slot: i64): CallCtx:
i := slot as int
if i < 0 or i >= _calls.items.len(): ret CallCtx {} end
ret _calls.items.get(i)
end
func _call_store(slot: i64, c: CallCtx):
i := slot as int
if i < 0 or i >= _calls.items.len(): ret end
_calls.items.set(i, c)
end
func _release_call(slot: int):
if slot < 0 or slot >= _calls.items.len(): ret end
c := _calls.items.get(slot)
compress.BufFree(c.recv)
_calls.items.set(slot, CallCtx {})
end
func _sync_recv(slot: i64):
mut c := _call_at(slot)
s := http2.StreamAt(_conn, c.stream_id)
have := compress.BufLen(c.recv)
total := compress.BufLen(s.data)
if total > have:
mut i := have
until i < total:
compress.BufPush(c.recv, compress.BufGet(s.data, i))
i += 1
end
end
if s.end_stream: c.client_done = true end
_call_store(slot, c)
end
func _send_response_headers(slot: i64):
mut c := _call_at(slot)
if c.sent_headers: ret end
mut hl := http2.HeaderList {}
http2.HeadersAdd(hl, ":status", "200")
http2.HeadersAdd(hl, "content-type", GRPC_CONTENT_TYPE_PROTO)
http2.HeadersAdd(hl, "grpc-accept-encoding", "identity,gzip")
http2.SendHeaders(_conn, c.stream_id, hl, false)
c.sent_headers = true
_call_store(slot, c)
end
func _send_trailers(slot: i64):
c := _call_at(slot)
mut hl := http2.HeaderList {}
if not c.sent_headers:
http2.HeadersAdd(hl, ":status", "200")
http2.HeadersAdd(hl, "content-type", GRPC_CONTENT_TYPE_PROTO)
end
http2.HeadersAdd(hl, "grpc-status", FormatStatusCode(c.status.code))
if c.status.message != "":
http2.HeadersAdd(hl, "grpc-message", EncodeStatusMessage(c.status.message))
end
http2.SendTrailers(_conn, c.stream_id, hl)
end
@en "NewServer"
@fa "سرور جدید"
pub func NewServer(port: int): Server:
mut s := Server {}
s.port = port
ret s
end
@en "RegisterMethod"
@fa "ثبت متد"
pub func RegisterMethod(path: str, fn: i64):
idx := _find_method(path)
mut m := MethodDesc {}
m.path = path
m.fn = fn
if idx >= 0:
_methods.items.set(idx, m)
ret
end
_methods.items.push(m)
end
@en "RegisterStreamMethod"
@fa "ثبت متد جریانی"
pub func RegisterStreamMethod(path: str, fn: i64, client_stream: bool, server_stream: bool):
RegisterMethod(path, fn)
idx := _find_method(path)
if idx < 0: ret end
mut m := _methods.items.get(idx)
m.client_stream = client_stream
m.server_stream = server_stream
_methods.items.set(idx, m)
end
@en "MethodCount"
@fa "تعداد متدها"
pub func MethodCount(): int:
ret _methods.items.len()
end
@en "HasMethod"
@fa "متد دارد"
pub func HasMethod(path: str): bool:
ret _find_method(path) >= 0
end
@en "ResetMethods"
@fa "بازنشانی متدها"
pub func ResetMethods():
_methods = MethodTable {}
end
@en "CallPath"
@fa "مسیر فراخوان"
pub func CallPath(slot: i64): str:
ret _call_at(slot).method
end
@en "CallMetadata"
@fa "فراداده فراخوان"
pub func CallMetadata(slot: i64): Metadata:
ret MDFromHeaders(_call_at(slot).headers)
end
@en "Recv"
@fa "دریافت"
pub func Recv(slot: i64, ok &: bool): compress.ByteBuf:
mut guard := 0
until guard < GRPC_MAX_FRAMES:
_sync_recv(slot)
mut c := _call_at(slot)
if HasMessage(c.recv, c.recv_pos):
mut pos := c.recv_pos
mut mok := false
msg := NextMessage(c.recv, pos, mok)
c.recv_pos = pos
_call_store(slot, c)
ok = mok
ret msg
end
if c.client_done:
ok = false
ret compress.NewByteBuf()
end
if http2.Poll(_conn) == http2.H2_POLL_ERROR:
c.failed = true
_call_store(slot, c)
ok = false
ret compress.NewByteBuf()
end
guard += 1
end
ok = false
ret compress.NewByteBuf()
end
@en "RecvStr"
@fa "دریافت متن"
pub func RecvStr(slot: i64, ok &: bool): str:
mut b := Recv(slot, ok)
out := compress.BufToStrUnsafe(b)
compress.BufFree(b)
ret out
end
@en "Send"
@fa "ارسال"
pub func Send(slot: i64, msg: compress.ByteBuf): bool:
_send_response_headers(slot)
c := _call_at(slot)
mut framed := FrameMessage(msg, false)
ok := http2.SendData(_conn, c.stream_id, framed, false)
compress.BufFree(framed)
ret ok
end
@en "SendStr"
@fa "ارسال متن"
pub func SendStr(slot: i64, msg: str): bool:
mut b := compress.BufFromStr(msg)
ok := Send(slot, b)
compress.BufFree(b)
ret ok
end
@en "SetStatus"
@fa "تنظیم وضعیت"
pub func SetStatus(slot: i64, code: int, message: str):
mut c := _call_at(slot)
c.status = NewStatus(code, message)
_call_store(slot, c)
end
@en "Fail"
@fa "شکست"
pub func Fail(slot: i64, code: int, message: str):
SetStatus(slot, code, message)
end
@en "Listen"
@fa "گوش دادن"
pub func Listen(s &: Server): bool:
sock := rawsock.Listen(s.port)
if not rawsock.Ok(sock): ret false end
s.listen_fd = sock.fd
s.port = rawsock.LocalPort(sock)
s.running = true
ret true
end
@en "Port"
@fa "درگاه"
pub func Port(s: Server): int:
ret s.port
end
@en "ServeConn"
@fa "خدمت به اتصال"
pub func ServeConn(fd: i64): int:
_conn = http2.NewConn(http2.PlainTransport(fd), true)
if not http2.ServerHandshake(_conn):
http2.CloseConn(_conn)
ret 0
end
mut handled := 0
mut guard := 0
until guard < GRPC_MAX_FRAMES:
sid := http2.AwaitAnyHeaders(_conn, GRPC_MAX_FRAMES)
if sid == http2.H2_POLL_ERROR: break end
st := http2.StreamAt(_conn, sid)
path := http2.HeadersGet(st.headers, ":path")
slot := _alloc_call()
mut c := _calls.items.get(slot)
c.stream_id = sid
c.method = path
c.headers = st.headers
_calls.items.set(slot, c)
idx := _find_method(path)
if idx < 0:
SetStatus(slot as i64, GRPC_UNIMPLEMENTED, "unknown method " + path)
else:
fn := _methods.items.get(idx).fn
callhandler(fn, slot as i64)
end
_send_trailers(slot as i64)
_release_call(slot)
handled += 1
if _conn.goaway: break end
guard += 1
end
http2.CloseConn(_conn)
ret handled
end
@en "ServeCount"
@fa "خدمت به تعداد"
pub func ServeCount(s &: Server, n: int): int:
if not s.running:
if not Listen(s): ret 0 end
end
mut i := 0
until i < n:
c := rawsock.Accept(rawsock.FromFd(s.listen_fd))
if not rawsock.Ok(c): break end
ServeConn(c.fd)
s.served += 1
i += 1
end
ret s.served
end
@en "Serve"
@fa "خدمت"
pub func Serve(s &: Server):
if not s.running:
if not Listen(s): ret end
end
until s.running:
c := rawsock.Accept(rawsock.FromFd(s.listen_fd))
if not rawsock.Ok(c): continue end
ServeConn(c.fd)
s.served += 1
end
end
@en "StopServer"
@fa "توقف سرور"
pub func StopServer(s &: Server):
s.running = false
if s.listen_fd >= 0:
rawsock.Close(rawsock.FromFd(s.listen_fd))
s.listen_fd = 0 - 1
end
end
package grpc
import encoding
import net.http2
func _is_reserved(key: str): bool:
if key.len() > 0 and key.substr(0, 1) == ":": ret true end
if key == "content-type": ret true end
if key == "te": ret true end
if key == "grpc-status": ret true end
if key == "grpc-message": ret true end
if key == "grpc-timeout": ret true end
if key == "grpc-encoding": ret true end
if key == "grpc-accept-encoding": ret true end
if key == "user-agent": ret true end
ret false
end
func _lower(s: str): str:
ret s.lower()
end
func _valid_key(key: str): bool:
n := key.len()
if n == 0: ret false end
p := key as i8 *
repeat n in i:
c := (p[i] as int) & 255
ok := (c >= 48 and c <= 57) or (c >= 97 and c <= 122) or c == 45 or c == 95 or c == 46
if not ok: ret false end
end
ret true
end
func _valid_text(value: str): bool:
p := value as i8 *
repeat value.len() in i:
c := (p[i] as int) & 255
if c < 32 or c > 126: ret false end
end
ret true
end
func _ends_bin(key: str): bool:
n := key.len()
if n < 4: ret false end
ret key.substr(n - 4, 4) == "-bin"
end
@en "NewMetadata"
@fa "فراداده جدید"
pub func NewMetadata(): Metadata:
ret Metadata {}
end
@en "MDAdd"
@fa "افزودن فراداده"
pub func MDAdd(md &: Metadata, key: str, value: str): bool:
k := _lower(key)
if not _valid_key(k) or not _valid_text(value): ret false end
if _is_reserved(k) or _ends_bin(k): ret false end
mut e := MDEntry {}
e.key = k
e.value = value
md.items.push(e)
ret true
end
@en "MDAddBinary"
@fa "افزودن فراداده دودویی"
pub func MDAddBinary(md &: Metadata, key: str, value: str): bool:
k := _lower(key)
if not _valid_key(k): ret false end
if _is_reserved(k) or not _ends_bin(k): ret false end
mut e := MDEntry {}
e.key = k
e.value = value
e.binary = true
md.items.push(e)
ret true
end
@en "MDGet"
@fa "دریافت فراداده"
pub func MDGet(md: Metadata, key: str): str:
k := _lower(key)
mut i := 0
until i < md.items.len():
e := md.items.get(i)
if e.key == k: ret e.value end
i += 1
end
ret ""
end
@en "MDHas"
@fa "فراداده دارد"
pub func MDHas(md: Metadata, key: str): bool:
k := _lower(key)
mut i := 0
until i < md.items.len():
if md.items.get(i).key == k: ret true end
i += 1
end
ret false
end
@en "MDGetAll"
@fa "دریافت همه فراداده"
pub func MDGetAll(md: Metadata, key: str): Vector<str>:
k := _lower(key)
mut out := Vector {} as Vector<str>
mut i := 0
until i < md.items.len():
e := md.items.get(i)
if e.key == k: out.push(e.value) end
i += 1
end
ret out
end
@en "MDCount"
@fa "تعداد فراداده"
pub func MDCount(md: Metadata): int:
ret md.items.len()
end
@en "MDKeyAt"
@fa "کلید فراداده"
pub func MDKeyAt(md: Metadata, i: int): str:
if i < 0 or i >= md.items.len(): ret "" end
ret md.items.get(i).key
end
@en "MDValueAt"
@fa "مقدار فراداده"
pub func MDValueAt(md: Metadata, i: int): str:
if i < 0 or i >= md.items.len(): ret "" end
ret md.items.get(i).value
end
@en "MDToHeaders"
@fa "فراداده به سرآیند"
pub func MDToHeaders(md: Metadata, hl &: http2.HeaderList):
mut i := 0
until i < md.items.len():
e := md.items.get(i)
if e.binary:
http2.HeadersAdd(hl, e.key, encoding.Base64Encode(e.value))
else:
http2.HeadersAdd(hl, e.key, e.value)
end
i += 1
end
end
@en "MDFromHeaders"
@fa "فراداده از سرآیند"
pub func MDFromHeaders(hl: http2.HeaderList): Metadata:
mut md := Metadata {}
mut i := 0
until i < hl.items.len():
h := hl.items.get(i)
if not _is_reserved(h.name):
mut e := MDEntry {}
e.key = h.name
if _ends_bin(h.name):
e.binary = true
e.value = encoding.Base64Decode(h.value)
else:
e.value = h.value
end
md.items.push(e)
end
i += 1
end
ret md
end
package grpc
import conv
import str
func _hexdig(v: int): str:
if v < 10: ret conv.FormatInt(v as i64) end
if v == 10: ret "A" end
if v == 11: ret "B" end
if v == 12: ret "C" end
if v == 13: ret "D" end
if v == 14: ret "E" end
ret "F"
end
func _hexval(c: int): int:
if c >= 48 and c <= 57: ret c - 48 end
if c >= 97 and c <= 102: ret c - 87 end
if c >= 65 and c <= 70: ret c - 55 end
ret 0 - 1
end
func _byte_of(s: str, i: int): int:
bp := (s as void*) as i8*
mut v := bp[i] as int
if v < 0: v = v + 256 end
ret v
end
func _chr(v: int): str:
mut sb := str.NewBuilder()
str.BufAppendChar(sb, v)
out := str.BufStr(sb)
str.BufFree(sb)
ret out
end
@en "StatusName"
@fa "نام وضعیت"
pub func StatusName(code: int): str:
if code == GRPC_OK: ret "OK" end
if code == GRPC_CANCELLED: ret "CANCELLED" end
if code == GRPC_UNKNOWN: ret "UNKNOWN" end
if code == GRPC_INVALID_ARGUMENT: ret "INVALID_ARGUMENT" end
if code == GRPC_DEADLINE_EXCEEDED: ret "DEADLINE_EXCEEDED" end
if code == GRPC_NOT_FOUND: ret "NOT_FOUND" end
if code == GRPC_ALREADY_EXISTS: ret "ALREADY_EXISTS" end
if code == GRPC_PERMISSION_DENIED: ret "PERMISSION_DENIED" end
if code == GRPC_RESOURCE_EXHAUSTED: ret "RESOURCE_EXHAUSTED" end
if code == GRPC_FAILED_PRECONDITION: ret "FAILED_PRECONDITION" end
if code == GRPC_ABORTED: ret "ABORTED" end
if code == GRPC_OUT_OF_RANGE: ret "OUT_OF_RANGE" end
if code == GRPC_UNIMPLEMENTED: ret "UNIMPLEMENTED" end
if code == GRPC_INTERNAL: ret "INTERNAL" end
if code == GRPC_UNAVAILABLE: ret "UNAVAILABLE" end
if code == GRPC_DATA_LOSS: ret "DATA_LOSS" end
if code == GRPC_UNAUTHENTICATED: ret "UNAUTHENTICATED" end
ret "UNKNOWN"
end
@en "EncodeStatusMessage"
@fa "کدگذاری پیام وضعیت"
pub func EncodeStatusMessage(msg: str): str:
mut out := ""
mut i := 0
until i < msg.len():
c := _byte_of(msg, i)
if c < 32 or c > 126 or c == 37:
out = out + "%" + _hexdig((c >> 4) & 15) + _hexdig(c & 15)
else:
out = out + _chr(c)
end
i += 1
end
ret out
end
@en "DecodeStatusMessage"
@fa "کدگشایی پیام وضعیت"
pub func DecodeStatusMessage(msg: str): str:
mut sb := str.NewBuilder()
mut i := 0
n := msg.len()
until i < n:
c := _byte_of(msg, i)
if c == 37 and i + 2 < n:
hi := _hexval(_byte_of(msg, i + 1))
lo := _hexval(_byte_of(msg, i + 2))
if hi >= 0 and lo >= 0:
str.BufAppendChar(sb, hi * 16 + lo)
i += 3
continue
end
end
str.BufAppendChar(sb, c)
i += 1
end
out := str.BufStr(sb)
str.BufFree(sb)
ret out
end
@en "FormatStatusCode"
@fa "قالب‌بندی کد وضعیت"
pub func FormatStatusCode(code: int): str:
ret conv.FormatInt(code as i64)
end
@en "ParseStatusCode"
@fa "تجزیه کد وضعیت"
pub func ParseStatusCode(text: str): int:
if text == "": ret GRPC_UNKNOWN end
mut n := 0
mut i := 0
mut any := false
until i < text.len():
c := _byte_of(text, i)
if c < 48 or c > 57: break end
n = n * 10 + (c - 48)
any = true
i += 1
end
if not any: ret GRPC_UNKNOWN end
ret n
end
@en "StatusString"
@fa "متن وضعیت"
pub func StatusString(s: Status): str:
if s.message == "": ret StatusName(s.code) end
ret StatusName(s.code) + ": " + s.message
end
@en "i18n"
@fa "بین‌المللی‌سازی"
package i18n
import str
import env
import config
@en "Catalog"
@fa "فهرست ترجمه"
pub struct Catalog:
pub keys: Vector<str> = Vector {}
pub vals: Vector<str> = Vector {}
pub fallback: str = "en"
end
func _combine(locale: str, key: str): str: ret locale.concat(":").concat(key) end
func _find(c &: Catalog, locale: str, key: str): int:
combined := _combine(locale, key)
repeat c.keys.len() in i:
if c.keys.get(i) == combined: ret i end
end
ret 0 - 1
end
func _normalize_locale(v: str): str:
mut s := str.Trim(v)
dot := s.find(".")
if dot >= 0: s = s.substr(0, dot) end
us := s.find("_")
if us >= 0: s = s.substr(0, us) end
dash := s.find("-")
if dash >= 0: s = s.substr(0, dash) end
ret str.Lower(s)
end
@en "New"
@fa "جدید"
pub func New(default_locale: str): Catalog: ret Catalog { fallback = default_locale } end
@en "Set"
@fa "تنظیم"
pub func Set(c &: Catalog, locale: str, key: str, val: str):
idx := _find(c, locale, key)
if idx >= 0:
c.vals.set(idx, val)
else:
c.keys.push(_combine(locale, key))
c.vals.push(val)
end
end
@en "Has"
@fa "دارد"
pub func Has(c &: Catalog, locale: str, key: str): bool: ret _find(c, locale, key) >= 0 end
@en "RawGet"
@fa "دریافت خام"
pub func RawGet(c &: Catalog, locale: str, key: str): str:
idx := _find(c, locale, key)
if idx < 0: ret "" end
ret c.vals.get(idx)
end
@en "T"
@fa "ترجمه"
pub func T(c &: Catalog, locale: str, key: str): str:
v := RawGet(c, locale, key)
if v.len() > 0: ret v end
if locale != c.fallback:
fv := RawGet(c, c.fallback, key)
if fv.len() > 0: ret fv end
end
ret key
end
@en "Interpolate"
@fa "جایگذاری"
pub func Interpolate(msg: str, param_names: Vector<str>, param_vals: Vector<str>): str:
mut out := msg
repeat param_names.len() in i:
placeholder := "{".concat(param_names.get(i)).concat("}")
out = str.Replace(out, placeholder, param_vals.get(i))
end
ret out
end
@en "Tf"
@fa "ترجمه قالبی"
pub func Tf(c &: Catalog, locale: str, key: str, param_names: Vector<str>, param_vals: Vector<str>): str:
ret Interpolate(T(c, locale, key), param_names, param_vals)
end
@en "Plural"
@fa "جمع"
pub func Plural(c &: Catalog, locale: str, key: str, n: i64): str:
mut suffix := ".other"
if n == (1 as i64): suffix = ".one" end
combined_key := key.concat(suffix)
if Has(c, locale, combined_key) or Has(c, c.fallback, combined_key):
ret T(c, locale, combined_key)
end
ret T(c, locale, key)
end
@en "LoadLocale"
@fa "بارگذاری زبان"
pub func LoadLocale(c &: Catalog, locale: str, path: str): int:
cfg := config.LoadEnv(path)
keys := config.Keys(cfg)
defer keys.free()
repeat keys.len() in i:
k := keys.get(i)
Set(c, locale, k, config.Get(cfg, k))
end
ret keys.len()
end
@en "DetectLocale"
@fa "تشخیص زبان"
pub func DetectLocale(): str:
mut v := env.Get("SALAM_LOCALE")
if v.len() > 0: ret _normalize_locale(v) end
v = env.Get("LANG")
if v.len() > 0: ret _normalize_locale(v) end
v = env.Get("LC_ALL")
if v.len() > 0: ret _normalize_locale(v) end
ret "en"
end
@en "Free"
@fa "آزادسازی"
pub func Free(c &: Catalog):
c.keys.free()
c.vals.free()
end
package image
import mem
import math
@en "Histogram"
@fa "بافت‌نگار"
pub struct Histogram:
pub r: void* = null
pub g: void* = null
pub b: void* = null
pub luma: void* = null
end
func _hist_alloc(): void*:
ret mem.AllocateZeroed(256 * 4 as u64)
end
func _hist_bump(buf: void*, bucket: int):
p := buf as i32*
p[bucket] = p[bucket] + (1 as i32)
end
@en "ComputeHistogram"
@fa "محاسبه بافت‌نگار"
pub func ComputeHistogram(img: Image): Histogram:
mut h := Histogram { r = _hist_alloc(), g = _hist_alloc() }
h.b = _hist_alloc()
h.luma = _hist_alloc()
if img.pixels == null:
ret h
end
bp := img.pixels as u8*
mut i := 0
n := img.width * img.height
until i < n:
off := i * 4
r := bp[off] as int
g := bp[off + 1] as int
b := bp[off + 2] as int
_hist_bump(h.r, r)
_hist_bump(h.g, g)
_hist_bump(h.b, b)
_hist_bump(h.luma, (r * 299 + g * 587 + b * 114) / 1000)
i += 1
end
ret h
end
@en "HistogramGet"
@fa "خواندن بافت‌نگار"
pub func HistogramGet(channel: void*, bucket: int): int:
if channel == null or bucket < 0 or bucket > 255:
ret 0
end
p := channel as i32*
ret p[bucket]
end
@en "HistogramFree"
@fa "آزادسازی بافت‌نگار"
pub func HistogramFree(h &: Histogram):
if h.r != null: mem.Free(h.r) end
if h.g != null: mem.Free(h.g) end
if h.b != null: mem.Free(h.b) end
if h.luma != null: mem.Free(h.luma) end
h.r = null
h.g = null
h.b = null
h.luma = null
end
@en "Diff"
@fa "تفاوت"
pub func Diff(a: Image, b: Image): Image:
w := a.width > b.width ? a.width : b.width
h := a.height > b.height ? a.height : b.height
out := New(w, h)
mut y := 0
until y < h:
mut x := 0
until x < w:
ca := GetPixel(a, x, y)
cb := GetPixel(b, x, y)
dr := ca.r as int - (cb.r as int)
dg := ca.g as int - (cb.g as int)
db := ca.b as int - (cb.b as int)
SetPixel(out, x, y, RGB(_iabs(dr), _iabs(dg), _iabs(db)))
x += 1
end
y += 1
end
ret out
end
@en "MeanAbsError"
@fa "میانگین خطای مطلق"
pub func MeanAbsError(a: Image, b: Image): f64:
w := a.width > b.width ? a.width : b.width
h := a.height > b.height ? a.height : b.height
if w == 0 or h == 0: ret 0.0 end
mut total := 0.0
mut y := 0
until y < h:
mut x := 0
until x < w:
ca := GetPixel(a, x, y)
cb := GetPixel(b, x, y)
total += (_iabs(ca.r as int - (cb.r as int)) as f64)
total += (_iabs(ca.g as int - (cb.g as int)) as f64)
total += (_iabs(ca.b as int - (cb.b as int)) as f64)
x += 1
end
y += 1
end
ret total / ((w * h * 3) as f64)
end
@en "PSNR"
@fa "نسبت سیگنال به نویز"
pub func PSNR(a: Image, b: Image): f64:
w := a.width > b.width ? a.width : b.width
h := a.height > b.height ? a.height : b.height
if w == 0 or h == 0: ret 100.0 end
mut sq_sum := 0.0
mut y := 0
until y < h:
mut x := 0
until x < w:
ca := GetPixel(a, x, y)
cb := GetPixel(b, x, y)
dr := (ca.r as int) - (cb.r as int)
dg := (ca.g as int) - (cb.g as int)
db := (ca.b as int) - (cb.b as int)
sq_sum += (dr * dr + dg * dg + db * db) as f64
x += 1
end
y += 1
end
mse := sq_sum / ((w * h * 3) as f64)
if mse <= 0.0: ret 100.0 end
ret 10.0 * math.Log10(65025.0 / mse)
end
package image
const _AR_ISOLATED := 0
const _AR_FINAL := 1
const _AR_INITIAL := 2
const _AR_MEDIAL := 3
func _arabic_form_base(cp: int, count &: int): int:
count = 0
if cp == 0xFEF5 or cp == 0xFEF7 or cp == 0xFEF9 or cp == 0xFEFB:
count = 2
ret cp
end
if cp < 0x0621 or cp > 0x06D3:
ret 0
end
if cp == 0x0621: count = 1 ret 0xFE80 end
if cp == 0x0622: count = 2 ret 0xFE81 end
if cp == 0x0623: count = 2 ret 0xFE83 end
if cp == 0x0624: count = 2 ret 0xFE85 end
if cp == 0x0625: count = 2 ret 0xFE87 end
if cp == 0x0626: count = 4 ret 0xFE89 end
if cp == 0x0627: count = 2 ret 0xFE8D end
if cp == 0x0628: count = 4 ret 0xFE8F end
if cp == 0x0629: count = 2 ret 0xFE93 end
if cp == 0x062A: count = 4 ret 0xFE95 end
if cp == 0x062B: count = 4 ret 0xFE99 end
if cp == 0x062C: count = 4 ret 0xFE9D end
if cp == 0x062D: count = 4 ret 0xFEA1 end
if cp == 0x062E: count = 4 ret 0xFEA5 end
if cp == 0x062F: count = 2 ret 0xFEA9 end
if cp == 0x0630: count = 2 ret 0xFEAB end
if cp == 0x0631: count = 2 ret 0xFEAD end
if cp == 0x0632: count = 2 ret 0xFEAF end
if cp == 0x0633: count = 4 ret 0xFEB1 end
if cp == 0x0634: count = 4 ret 0xFEB5 end
if cp == 0x0635: count = 4 ret 0xFEB9 end
if cp == 0x0636: count = 4 ret 0xFEBD end
if cp == 0x0637: count = 4 ret 0xFEC1 end
if cp == 0x0638: count = 4 ret 0xFEC5 end
if cp == 0x0639: count = 4 ret 0xFEC9 end
if cp == 0x063A: count = 4 ret 0xFECD end
if cp == 0x0641: count = 4 ret 0xFED1 end
if cp == 0x0642: count = 4 ret 0xFED5 end
if cp == 0x0643: count = 4 ret 0xFED9 end
if cp == 0x0644: count = 4 ret 0xFEDD end
if cp == 0x0645: count = 4 ret 0xFEE1 end
if cp == 0x0646: count = 4 ret 0xFEE5 end
if cp == 0x0647: count = 4 ret 0xFEE9 end
if cp == 0x0648: count = 2 ret 0xFEED end
if cp == 0x064A: count = 4 ret 0xFEF1 end
if cp == 0x0671: count = 2 ret 0xFB50 end
if cp == 0x0677: count = 1 ret 0xFBDD end
if cp == 0x0679: count = 4 ret 0xFB66 end
if cp == 0x067A: count = 4 ret 0xFB5E end
if cp == 0x067B: count = 4 ret 0xFB52 end
if cp == 0x067E: count = 4 ret 0xFB56 end
if cp == 0x067F: count = 4 ret 0xFB62 end
if cp == 0x0680: count = 4 ret 0xFB5A end
if cp == 0x0683: count = 4 ret 0xFB76 end
if cp == 0x0684: count = 4 ret 0xFB72 end
if cp == 0x0686: count = 4 ret 0xFB7A end
if cp == 0x0687: count = 4 ret 0xFB7E end
if cp == 0x0688: count = 2 ret 0xFB88 end
if cp == 0x068C: count = 2 ret 0xFB84 end
if cp == 0x068D: count = 2 ret 0xFB82 end
if cp == 0x068E: count = 2 ret 0xFB86 end
if cp == 0x0691: count = 2 ret 0xFB8C end
if cp == 0x0698: count = 2 ret 0xFB8A end
if cp == 0x06A4: count = 4 ret 0xFB6A end
if cp == 0x06A6: count = 4 ret 0xFB6E end
if cp == 0x06A9: count = 4 ret 0xFB8E end
if cp == 0x06AD: count = 4 ret 0xFBD3 end
if cp == 0x06AF: count = 4 ret 0xFB92 end
if cp == 0x06B1: count = 4 ret 0xFB9A end
if cp == 0x06B3: count = 4 ret 0xFB96 end
if cp == 0x06BA: count = 2 ret 0xFB9E end
if cp == 0x06BB: count = 4 ret 0xFBA0 end
if cp == 0x06BE: count = 4 ret 0xFBAA end
if cp == 0x06C0: count = 2 ret 0xFBA4 end
if cp == 0x06C1: count = 4 ret 0xFBA6 end
if cp == 0x06C5: count = 2 ret 0xFBE0 end
if cp == 0x06C6: count = 2 ret 0xFBD9 end
if cp == 0x06C7: count = 2 ret 0xFBD7 end
if cp == 0x06C8: count = 2 ret 0xFBDB end
if cp == 0x06C9: count = 2 ret 0xFBE2 end
if cp == 0x06CB: count = 2 ret 0xFBDE end
if cp == 0x06CC: count = 4 ret 0xFBFC end
if cp == 0x06D0: count = 4 ret 0xFBE4 end
if cp == 0x06D2: count = 2 ret 0xFBAE end
if cp == 0x06D3: count = 2 ret 0xFBB0 end
ret 0
end
func _arabic_join_count(cp: int): int:
if cp == 0x0640:
ret 2
end
mut count := 0
_arabic_form_base(cp, count)
if count == 4: ret 2 end
if count == 2: ret 1 end
ret 0
end
func _arabic_transparent(cp: int): bool:
if cp >= 0x0610 and cp <= 0x061A: ret true end
if cp >= 0x064B and cp <= 0x065F: ret true end
if cp == 0x0670: ret true end
if cp >= 0x06D6 and cp <= 0x06DC: ret true end
if cp >= 0x06DF and cp <= 0x06E4: ret true end
if cp >= 0x06E7 and cp <= 0x06E8: ret true end
if cp >= 0x06EA and cp <= 0x06ED: ret true end
if cp >= 0x0300 and cp <= 0x036F: ret true end
if cp >= 0x0591 and cp <= 0x05BD: ret true end
if cp == 0x05BF or cp == 0x05C1 or cp == 0x05C2: ret true end
if cp == 0x05C4 or cp == 0x05C5 or cp == 0x05C7: ret true end
if cp == 0x200D: ret true end
ret false
end
func _arabic_shaped(cp: int, form: int): int:
if cp == 0x0649:
if form == _AR_INITIAL: ret 0xFBE8 end
if form == _AR_MEDIAL: ret 0xFBE9 end
if form == _AR_FINAL: ret 0xFEF0 end
ret 0xFEEF
end
mut count := 0
base := _arabic_form_base(cp, count)
if base == 0 or count == 0:
ret cp
end
mut want := form
if want >= count:
if want == _AR_MEDIAL: want = _AR_FINAL end
if want == _AR_INITIAL: want = _AR_ISOLATED end
end
if want >= count:
want = _AR_ISOLATED
end
ret base + want
end
func _arabic_lam_alef(lam: int, alef: int): int:
if lam != 0x0644:
ret 0
end
if alef == 0x0622: ret 0xFEF5 end
if alef == 0x0623: ret 0xFEF7 end
if alef == 0x0625: ret 0xFEF9 end
if alef == 0x0627: ret 0xFEFB end
ret 0
end
package image
func _shape_prev_index(cps &: Vector<int>, i: int): int:
mut k := i - 1
until k >= 0:
if not _arabic_transparent(cps.get(k)):
ret k
end
k -= 1
end
ret -1
end
func _shape_next_index(cps &: Vector<int>, i: int): int:
mut k := i + 1
until k < cps.len():
if not _arabic_transparent(cps.get(k)):
ret k
end
k += 1
end
ret -1
end
func _shape_merge_ligatures(src &: Vector<int>, out &: Vector<int>):
n := src.len()
mut i := 0
until i < n:
cp := src.get(i)
mut merged := false
if cp == 0x0644:
j := _shape_next_index(src, i)
if j >= 0:
lig := _arabic_lam_alef(cp, src.get(j))
if lig != 0:
out.push(lig)
mut k := i + 1
until k < j:
out.push(src.get(k))
k += 1
end
i = j + 1
merged = true
end
end
end
if not merged:
out.push(cp)
i += 1
end
end
end
func _shape_form_at(cps &: Vector<int>, i: int): int:
cp := cps.get(i)
if _arabic_join_count(cp) == 0:
ret _AR_ISOLATED
end
p := _shape_prev_index(cps, i)
n := _shape_next_index(cps, i)
joined_prev := p >= 0 and _arabic_join_count(cps.get(p)) == 2
joined_next := n >= 0 and _arabic_join_count(cp) == 2 and _arabic_join_count(cps.get(n)) >= 1
if joined_prev and joined_next: ret _AR_MEDIAL end
if joined_next: ret _AR_INITIAL end
if joined_prev: ret _AR_FINAL end
ret _AR_ISOLATED
end
func _shape_arabic(src &: Vector<int>, out &: Vector<int>):
mut merged := Vector {} as Vector<int>
_shape_merge_ligatures(src, merged)
mut i := 0
until i < merged.len():
out.push(_arabic_shaped(merged.get(i), _shape_form_at(merged, i)))
i += 1
end
merged.free()
end
@en "ShapeArabic"
@fa "شکل‌دهی عربی"
pub func ShapeArabic(text: str): str:
mut src := Vector {} as Vector<int>
mut out := Vector {} as Vector<int>
_utf8_decode_all(text, src)
_shape_arabic(src, out)
s := _utf8_encode_all(out)
src.free()
out.free()
ret s
end
package image
import str
@en "FontWidth"
@fa "عرض قلم"
pub const FontWidth := 5
@en "FontHeight"
@fa "ارتفاع قلم"
pub const FontHeight := 7
func _glyph(ch: int): str:
if ch == 48: ret ".###." + "#...#" + "#..##" + "#.#.#" + "##..#" + "#...#" + ".###." end
if ch == 49: ret "..#.." + ".##.." + "..#.." + "..#.." + "..#.." + "..#.." + ".###." end
if ch == 50: ret ".###." + "#...#" + "....#" + "...#." + "..#.." + ".#..." + "#####" end
if ch == 51: ret ".###." + "#...#" + "....#" + "..##." + "....#" + "#...#" + ".###." end
if ch == 52: ret "...#." + "..##." + ".#.#." + "#..#." + "#####" + "...#." + "...#." end
if ch == 53: ret "#####" + "#...." + "####." + "....#" + "....#" + "#...#" + ".###." end
if ch == 54: ret ".###." + "#...." + "#...." + "####." + "#...#" + "#...#" + ".###." end
if ch == 55: ret "#####" + "....#" + "...#." + "..#.." + "..#.." + "..#.." + "..#.." end
if ch == 56: ret ".###." + "#...#" + "#...#" + ".###." + "#...#" + "#...#" + ".###." end
if ch == 57: ret ".###." + "#...#" + "#...#" + ".####" + "....#" + "....#" + ".###." end
if ch == 65: ret "..#.." + ".#.#." + "#...#" + "#####" + "#...#" + "#...#" + "#...#" end
if ch == 66: ret "####." + "#...#" + "#...#" + "####." + "#...#" + "#...#" + "####." end
if ch == 67: ret ".###." + "#...#" + "#...." + "#...." + "#...." + "#...#" + ".###." end
if ch == 68: ret "####." + "#...#" + "#...#" + "#...#" + "#...#" + "#...#" + "####." end
if ch == 69: ret "#####" + "#...." + "#...." + "####." + "#...." + "#...." + "#####" end
if ch == 70: ret "#####" + "#...." + "#...." + "####." + "#...." + "#...." + "#...." end
if ch == 71: ret ".###." + "#...#" + "#...." + "#.###" + "#...#" + "#...#" + ".####" end
if ch == 72: ret "#...#" + "#...#" + "#...#" + "#####" + "#...#" + "#...#" + "#...#" end
if ch == 73: ret ".###." + "..#.." + "..#.." + "..#.." + "..#.." + "..#.." + ".###." end
if ch == 74: ret "..###" + "...#." + "...#." + "...#." + "...#." + "#..#." + ".##.." end
if ch == 75: ret "#...#" + "#..#." + "#.#.." + "##..." + "#.#.." + "#..#." + "#...#" end
if ch == 76: ret "#...." + "#...." + "#...." + "#...." + "#...." + "#...." + "#####" end
if ch == 77: ret "#...#" + "##.##" + "#.#.#" + "#...#" + "#...#" + "#...#" + "#...#" end
if ch == 78: ret "#...#" + "##..#" + "#.#.#" + "#..##" + "#...#" + "#...#" + "#...#" end
if ch == 79: ret ".###." + "#...#" + "#...#" + "#...#" + "#...#" + "#...#" + ".###." end
if ch == 80: ret "####." + "#...#" + "#...#" + "####." + "#...." + "#...." + "#...." end
if ch == 81: ret ".###." + "#...#" + "#...#" + "#...#" + "#.#.#" + "#..#." + ".##.#" end
if ch == 82: ret "####." + "#...#" + "#...#" + "####." + "#.#.." + "#..#." + "#...#" end
if ch == 83: ret ".####" + "#...." + "#...." + ".###." + "....#" + "....#" + "####." end
if ch == 84: ret "#####" + "..#.." + "..#.." + "..#.." + "..#.." + "..#.." + "..#.." end
if ch == 85: ret "#...#" + "#...#" + "#...#" + "#...#" + "#...#" + "#...#" + ".###." end
if ch == 86: ret "#...#" + "#...#" + "#...#" + "#...#" + "#...#" + ".#.#." + "..#.." end
if ch == 87: ret "#...#" + "#...#" + "#...#" + "#.#.#" + "#.#.#" + "##.##" + "#...#" end
if ch == 88: ret "#...#" + "#...#" + ".#.#." + "..#.." + ".#.#." + "#...#" + "#...#" end
if ch == 89: ret "#...#" + "#...#" + ".#.#." + "..#.." + "..#.." + "..#.." + "..#.." end
if ch == 90: ret "#####" + "....#" + "...#." + "..#.." + ".#..." + "#...." + "#####" end
if ch == 46: ret "....." + "....." + "....." + "....." + "....." + "..#.." + "..#.." end
if ch == 44: ret "....." + "....." + "....." + "....." + "....." + "..#.." + ".#..." end
if ch == 45: ret "....." + "....." + "....." + "#####" + "....." + "....." + "....." end
if ch == 58: ret "....." + "..#.." + "....." + "....." + "..#.." + "....." + "....." end
if ch == 33: ret "..#.." + "..#.." + "..#.." + "..#.." + "..#.." + "....." + "..#.." end
if ch == 63: ret ".###." + "#...#" + "....#" + "..##." + "..#.." + "....." + "..#.." end
ret "....." + "....." + "....." + "....." + "....." + "....." + "....."
end
func _text_glyph_byte(s: str, i: int): int:
bp := s as u8*
ret bp[i] as int
end
@en "DrawText"
@fa "نوشتن متن"
pub func DrawText(img &: Image, x: int, y: int, text: str, c: Color, scale: int):
s := scale < 1 ? 1 : scale
n := str.Len(text)
bp := text as u8*
mut pen_x := x
mut i := 0
until i < n:
ch := bp[i] as int
glyph := _glyph(ch)
mut row := 0
until row < FontHeight:
mut col := 0
until col < FontWidth:
gp := _text_glyph_byte(glyph, row * FontWidth + col)
if gp == 35:
DrawRectFilled(img, pen_x + col * s, y + row * s, s, s, c)
end
col += 1
end
row += 1
end
pen_x += (FontWidth + 1) * s
i += 1
end
end
@en "TextWidth"
@fa "عرض متن"
pub func TextWidth(text: str, scale: int): int:
s := scale < 1 ? 1 : scale
ret str.Len(text) * (FontWidth + 1) * s
end
package image
import compress
import archive
import mem
func _row_stride(width: int, bytes_per_pixel: int): int:
ret ((width * bytes_per_pixel + 3) / 4) * 4
end
func _bmp_channel(v: int, mask: int): int:
if mask == 0:
ret 0
end
mut m := mask
mut shift := 0
until (m & 1) == 0 and shift < 32:
m = (m >> 1) & 2147483647
shift += 1
end
mut bits := 0
until (m & 1) == 1 and bits < 32:
m = (m >> 1) & 2147483647
bits += 1
end
val := ((v >> shift) & ((1 << bits) - 1))
if bits >= 8:
ret (val >> (bits - 8)) & 255
end
mut out := val << (8 - bits)
mut s := bits
until s < 8:
out = out | (out >> s)
s = s * 2
end
ret out & 255
end
func _bmp_put(dst: u8*, width: int, height: int, top_down: bool, x: int, row: int, c: int):
if x < 0 or x >= width or row < 0 or row >= height:
ret
end
y := top_down ? row : height - 1 - row
o := (y * width + x) * 4
dst[o] = ((c >> 16) & 255) as u8
dst[o + 1] = ((c >> 8) & 255) as u8
dst[o + 2] = (c & 255) as u8
dst[o + 3] = 255 as u8
end
func _bmp_rle(bp: u8*, off: int, n: int, four: bool, width: int, height: int, top_down: bool, pal: Vector<int>, dst: u8*): bool:
mut at := off
mut x := 0
mut row := 0
until at + 1 < n and row < height:
count := bp[at] as int
val := bp[at + 1] as int
at += 2
if count > 0:
repeat count in k:
idx := four ? ((k % 2) == 0 ? val >> 4 : val & 15) : val
_bmp_put(dst, width, height, top_down, x, row, idx < pal.len() ? pal.get(idx) : 0)
x += 1
end
else val == 0:
x = 0
row += 1
else val == 1:
ret true
else val == 2:
if at + 1 >= n:
ret true
end
x += bp[at] as int
row += bp[at + 1] as int
at += 2
else:
bytes := four ? (val + 1) / 2 : val
if at + bytes > n:
ret true
end
repeat val in k:
mut idx := 0
if four:
b := bp[at + k / 2] as int
idx = (k % 2) == 0 ? b >> 4 : b & 15
else:
idx = bp[at + k] as int
end
_bmp_put(dst, width, height, top_down, x, row, idx < pal.len() ? pal.get(idx) : 0)
x += 1
end
at += bytes + (bytes % 2)
end
end
ret true
end
@en "EncodeBMP"
@fa "کدگذاری بی‌ام‌پی"
pub func EncodeBMP(img: Image): compress.ByteBuf:
mut out := compress.NewByteBuf()
w := img.width
h := img.height
pixel_bytes := w * h * 4
file_size := 138 + pixel_bytes
compress.BufPush(out, 66)
compress.BufPush(out, 77)
archive.LEPut32(out, file_size)
archive.LEPut32(out, 0)
archive.LEPut32(out, 138)
archive.LEPut32(out, 124)
archive.LEPut32(out, w)
archive.LEPut32(out, h)
archive.LEPut16(out, 1)
archive.LEPut16(out, 32)
archive.LEPut32(out, 3)
archive.LEPut32(out, pixel_bytes)
archive.LEPut32(out, 2835)
archive.LEPut32(out, 2835)
archive.LEPut32(out, 0)
archive.LEPut32(out, 0)
archive.LEPut32(out, 16711680)
archive.LEPut32(out, 65280)
archive.LEPut32(out, 255)
archive.LEPut32(out, 0 - 16777216)
archive.LEPut32(out, 1934772034)
repeat 12:
archive.LEPut32(out, 0)
end
archive.LEPut32(out, 4)
repeat 3:
archive.LEPut32(out, 0)
end
if img.pixels != null:
mut y := h - 1
until y >= 0:
mut x := 0
until x < w:
c := GetPixel(img, x, y)
compress.BufPush(out, c.b as int)
compress.BufPush(out, c.g as int)
compress.BufPush(out, c.r as int)
compress.BufPush(out, c.a as int)
x += 1
end
y -= 1
end
end
ret out
end
@en "SaveBMP"
@fa "ذخیره بی‌ام‌پی"
pub func SaveBMP(img: Image, path: str): bool:
buf := EncodeBMP(img)
ok := archive.WriteBinaryFileBuf(path, buf)
compress.BufFree(buf)
ret ok
end
@en "DecodeBMP"
@fa "کدگشایی بی‌ام‌پی"
pub func DecodeBMP(p: void*, n: int, ok &: bool): Image:
ok = false
if n < 26:
ret New(0, 0)
end
bp := p as u8*
if (bp[0] as int) != 66 or (bp[1] as int) != 77:
ret New(0, 0)
end
off := archive.LEGet32(p, 10)
dib := archive.LEGet32(p, 14)
mut width := 0
mut height := 0
mut bpp := 0
mut comp := 0
mut used := 0
mut entry := 4
if dib == 12:
width = archive.LEGet16(p, 18)
height = archive.LEGet16(p, 20)
bpp = archive.LEGet16(p, 24)
entry = 3
else dib >= 16 and dib <= 124 and n >= 14 + dib:
width = archive.LEGet32(p, 18)
height = archive.LEGet32(p, 22)
bpp = archive.LEGet16(p, 28)
if dib >= 20:
comp = archive.LEGet32(p, 30)
end
if dib >= 36:
used = archive.LEGet32(p, 46)
end
if dib == 64 and (comp == 3 or comp == 4):
ret New(0, 0)
end
else:
ret New(0, 0)
end
if comp == 4 or comp == 5:
if off <= 0 or off >= n:
ret New(0, 0)
end
inner := ((p as i64) + (off as i64)) as void*
ret comp == 4 ? DecodeJPEG(inner, n - off, ok) : DecodePNG(inner, n - off, ok)
end
top_down := height < 0
if top_down:
height = 0 - height
end
if width <= 0 or height <= 0 or (width as i64) * (height as i64) > (268435456 as i64):
ret New(0, 0)
end
if bpp != 1 and bpp != 2 and bpp != 4 and bpp != 8 and bpp != 16 and bpp != 24 and bpp != 32:
ret New(0, 0)
end
if comp != 0 and comp != 1 and comp != 2 and comp != 3 and comp != 6:
ret New(0, 0)
end
if (comp == 1 and bpp != 8) or (comp == 2 and bpp != 4) or ((comp == 3 or comp == 6) and bpp != 16 and bpp != 32):
ret New(0, 0)
end
mut rmask := 0
mut gmask := 0
mut bmask := 0
mut amask := 0
mut explicit_alpha := false
mut pal_at := 14 + dib
if comp == 3 or comp == 6:
mat := 54
if dib == 40:
pal_at += comp == 6 ? 16 : 12
end
if mat + 12 > n:
ret New(0, 0)
end
rmask = archive.LEGet32(p, mat)
gmask = archive.LEGet32(p, mat + 4)
bmask = archive.LEGet32(p, mat + 8)
if (comp == 6 or dib >= 56) and mat + 16 <= n:
amask = archive.LEGet32(p, mat + 12)
explicit_alpha = amask != 0
end
else bpp == 16:
rmask = 31744
gmask = 992
bmask = 31
else bpp == 32:
rmask = 16711680
gmask = 65280
bmask = 255
amask = 0 - 16777216
end
mut pal := Vector {} as Vector<int>
if bpp <= 8:
count := used > 0 and used < (1 << bpp) ? used : 1 << bpp
repeat count in i:
at := pal_at + i * entry
if at + 3 <= n and (off <= 0 or at + 3 <= off or off < pal_at):
pal.push(((bp[at + 2] as int) << 16) | ((bp[at + 1] as int) << 8) | (bp[at] as int))
end
end
end
if off <= 0 or off >= n:
pal.free()
ret New(0, 0)
end
out := New(width, height)
dst := out.pixels as u8*
mut good := true
if comp == 1 or comp == 2:
good = _bmp_rle(bp, off, n, comp == 2, width, height, top_down, pal, dst)
else:
stride64 := (((width as i64) * (bpp as i64) + (31 as i64)) / (32 as i64)) * (4 as i64)
if (off as i64) + stride64 * (height as i64) > (n as i64):
good = false
else:
stride := stride64 as int
mut any_alpha := false
repeat height in row:
y := top_down ? row : height - 1 - row
at := off + row * stride
repeat width in x:
o := (y * width + x) * 4
if bpp <= 8:
bit := x * bpp
idx := ((bp[at + bit / 8] as int) >> (8 - bpp - bit % 8)) & ((1 << bpp) - 1)
c := idx < pal.len() ? pal.get(idx) : 0
dst[o] = ((c >> 16) & 255) as u8
dst[o + 1] = ((c >> 8) & 255) as u8
dst[o + 2] = (c & 255) as u8
dst[o + 3] = 255 as u8
else bpp == 24:
q := at + x * 3
dst[o] = bp[q + 2]
dst[o + 1] = bp[q + 1]
dst[o + 2] = bp[q]
dst[o + 3] = 255 as u8
else:
mut v := 0
if bpp == 16:
v = archive.LEGet16(p, at + x * 2)
else:
v = archive.LEGet32(p, at + x * 4)
end
dst[o] = _bmp_channel(v, rmask) as u8
dst[o + 1] = _bmp_channel(v, gmask) as u8
dst[o + 2] = _bmp_channel(v, bmask) as u8
a := amask != 0 ? _bmp_channel(v, amask) : 255
if a != 0:
any_alpha = true
end
dst[o + 3] = a as u8
end
end
end
if bpp == 32 and not explicit_alpha and not any_alpha:
repeat width * height in i:
dst[i * 4 + 3] = 255 as u8
end
end
end
end
pal.free()
if not good:
mut bad := out
Free(bad)
ret New(0, 0)
end
ok = true
ret out
end
@en "OpenBMP"
@fa "بازکردن بی‌ام‌پی"
pub func OpenBMP(path: str, ok &: bool): Image:
mut read_ok := false
buf := archive.ReadBinaryFile(path, read_ok)
if not read_ok:
ok = false
ret New(0, 0)
end
out := DecodeBMP(buf.data, buf.len, ok)
compress.BufFree(buf)
ret out
end
package image
import compress
import archive
import str
import filepath
@en "FormatUnknown"
@fa "قالب نامشخص"
pub const FormatUnknown := 0
@en "FormatPNG"
@fa "قالب پی‌ان‌جی"
pub const FormatPNG := 1
@en "FormatBMP"
@fa "قالب بی‌ام‌پی"
pub const FormatBMP := 2
@en "FormatJPEG"
@fa "قالب جی‌پگ"
pub const FormatJPEG := 3
@en "FormatWebP"
@fa "قالب وب‌پی"
pub const FormatWebP := 4
@en "FormatGIF"
@fa "قالب گیف"
pub const FormatGIF := 5
@en "DetectFormat"
@fa "شناسایی قالب"
pub func DetectFormat(p: void*, n: int): int:
if n < 12:
ret FormatUnknown
end
bp := p as u8*
if n >= 8 and (bp[0] as int) == 137 and (bp[1] as int) == 80 and (bp[2] as int) == 78 and (bp[3] as int) == 71:
ret FormatPNG
end
if (bp[0] as int) == 66 and (bp[1] as int) == 77:
ret FormatBMP
end
if (bp[0] as int) == 0xFF and (bp[1] as int) == 0xD8:
ret FormatJPEG
end
if (bp[0] as int) == 82 and (bp[1] as int) == 73 and (bp[2] as int) == 70 and (bp[3] as int) == 70 and (bp[8] as int) == 87 and (bp[9] as int) == 69 and (bp[10] as int) == 66 and (bp[11] as int) == 80:
ret FormatWebP
end
if IsGIF(p, n):
ret FormatGIF
end
ret FormatUnknown
end
@en "FormatFromExt"
@fa "قالب از پسوند"
pub func FormatFromExt(path: str): int:
ext := str.Lower(filepath.Ext(path))
if ext == ".png": ret FormatPNG end
if ext == ".bmp": ret FormatBMP end
if ext == ".jpg" or ext == ".jpeg": ret FormatJPEG end
if ext == ".webp": ret FormatWebP end
if ext == ".gif": ret FormatGIF end
ret FormatUnknown
end
@en "Decode"
@fa "کدگشایی"
pub func Decode(p: void*, n: int, ok &: bool): Image:
fmt := DetectFormat(p, n)
if fmt == FormatPNG: ret DecodePNG(p, n, ok) end
if fmt == FormatBMP: ret DecodeBMP(p, n, ok) end
if fmt == FormatJPEG: ret DecodeJPEG(p, n, ok) end
if fmt == FormatWebP: ret DecodeWebP(p, n, ok) end
if fmt == FormatGIF: ret DecodeGIF(p, n, ok) end
ok = false
ret New(0, 0)
end
@en "Open"
@fa "بازکردن"
pub func Open(path: str, ok &: bool): Image:
mut read_ok := false
buf := archive.ReadBinaryFile(path, read_ok)
if not read_ok:
ok = false
ret New(0, 0)
end
out := Decode(buf.data, buf.len, ok)
compress.BufFree(buf)
ret out
end
@en "FlattenAlpha"
@fa "تخت کردن آلفا"
pub func FlattenAlpha(img: Image, bg: Color): Image:
out := New(img.width, img.height)
Fill(out, bg)
mut y := 0
until y < img.height:
mut x := 0
until x < img.width:
BlendPixel(out, x, y, GetPixel(img, x, y))
x += 1
end
y += 1
end
ret out
end
@en "Convert"
@fa "تبدیل"
pub func Convert(img: Image, format: int): Image:
if format == FormatJPEG:
ret FlattenAlpha(img, RGB(255, 255, 255))
end
ret Clone(img)
end
@en "Encode"
@fa "کدگذاری"
pub func Encode(img: Image, format: int, quality: int): compress.ByteBuf:
if format == FormatPNG: ret EncodePNG(img) end
if format == FormatBMP: ret EncodeBMP(img) end
if format == FormatWebP: ret EncodeWebPQuality(img, quality) end
if format == FormatGIF: ret EncodeGIF(img) end
if format == FormatJPEG:
mut flat := Convert(img, format)
out := EncodeJPEG(flat, quality)
Free(flat)
ret out
end
ret compress.NewByteBuf()
end
@en "SaveQuality"
@fa "ذخیره با کیفیت"
pub func SaveQuality(img: Image, path: str, quality: int): bool:
format := FormatFromExt(path)
if format == FormatUnknown:
ret false
end
buf := Encode(img, format, quality)
if buf.len == 0:
compress.BufFree(buf)
ret false
end
ok := archive.WriteBinaryFileBuf(path, buf)
compress.BufFree(buf)
ret ok
end
@en "Save"
@fa "ذخیره"
pub func Save(img: Image, path: str): bool:
ret SaveQuality(img, path, 90)
end
package image
import math
func _iabs(v: int): int:
if v < 0: ret -v end
ret v
end
func _imin(a: int, b: int): int:
if a < b: ret a end
ret b
end
func _imax(a: int, b: int): int:
if a > b: ret a end
ret b
end
@en "DrawLine"
@fa "رسم خط"
pub func DrawLine(img &: Image, x0: int, y0: int, x1: int, y1: int, c: Color):
dx := _iabs(x1 - x0)
dy := -_iabs(y1 - y0)
mut sx := 1
if x0 >= x1: sx = -1 end
mut sy := 1
if y0 >= y1: sy = -1 end
mut err := dx + dy
mut x := x0
mut y := y0
until true:
BlendPixel(img, x, y, c)
if x == x1 and y == y1: break end
e2 := 2 * err
if e2 >= dy:
err += dy
x += sx
end
if e2 <= dx:
err += dx
y += sy
end
end
end
@en "DrawRect"
@fa "رسم مستطیل"
pub func DrawRect(img &: Image, x: int, y: int, w: int, h: int, c: Color):
if w <= 0 or h <= 0: ret end
x1 := x + w - 1
y1 := y + h - 1
DrawLine(img, x, y, x1, y, c)
DrawLine(img, x, y1, x1, y1, c)
DrawLine(img, x, y, x, y1, c)
DrawLine(img, x1, y, x1, y1, c)
end
@en "DrawRectFilled"
@fa "رسم مستطیل پر"
pub func DrawRectFilled(img &: Image, x: int, y: int, w: int, h: int, c: Color):
if w <= 0 or h <= 0: ret end
x0 := _imax(x, 0)
y0 := _imax(y, 0)
x1 := _imin(x + w, img.width)
y1 := _imin(y + h, img.height)
mut yy := y0
until yy < y1:
mut xx := x0
until xx < x1:
BlendPixel(img, xx, yy, c)
xx += 1
end
yy += 1
end
end
@en "DrawCircle"
@fa "رسم دایره"
pub func DrawCircle(img &: Image, cx: int, cy: int, radius: int, c: Color):
if radius <= 0:
BlendPixel(img, cx, cy, c)
ret
end
mut x := radius
mut y := 0
mut err := 0
until y <= x:
BlendPixel(img, cx + x, cy + y, c)
BlendPixel(img, cx + y, cy + x, c)
BlendPixel(img, cx - y, cy + x, c)
BlendPixel(img, cx - x, cy + y, c)
BlendPixel(img, cx - x, cy - y, c)
BlendPixel(img, cx - y, cy - x, c)
BlendPixel(img, cx + y, cy - x, c)
BlendPixel(img, cx + x, cy - y, c)
y += 1
if err <= 0:
err += 2 * y + 1
end
if err > 0:
x -= 1
err -= 2 * x + 1
end
end
end
@en "DrawCircleFilled"
@fa "رسم دایره پر"
pub func DrawCircleFilled(img &: Image, cx: int, cy: int, radius: int, c: Color):
if radius <= 0:
BlendPixel(img, cx, cy, c)
ret
end
r2 := radius * radius
mut dy := -radius
until dy <= radius:
dx_max := math.Sqrt((r2 - dy * dy) as f64) as int
mut dx := -dx_max
until dx <= dx_max:
BlendPixel(img, cx + dx, cy + dy, c)
dx += 1
end
dy += 1
end
end
package image
func _clamp255(v: int): int:
if v < 0: ret 0 end
if v > 255: ret 255 end
ret v
end
func _copy_pixels(dst &: Image, src: Image):
if dst.pixels == null or src.pixels == null: ret end
n := (src.width * src.height * 4) as u64
mut i := 0 as u64
dp := dst.pixels as u8*
sp := src.pixels as u8*
until i < n:
dp[i as int] = sp[i as int]
i += 1 as u64
end
end
@en "Grayscale"
@fa "خاکستری کردن"
pub func Grayscale(img &: Image):
if img.pixels == null: ret end
bp := img.pixels as u8*
mut i := 0
n := img.width * img.height
until i < n:
off := i * 4
r := bp[off] as int
g := bp[off + 1] as int
b := bp[off + 2] as int
l := (r * 299 + g * 587 + b * 114) / 1000
lv := l as u8
bp[off] = lv
bp[off + 1] = lv
bp[off + 2] = lv
i += 1
end
end
@en "Invert"
@fa "معکوس کردن"
pub func Invert(img &: Image):
if img.pixels == null: ret end
bp := img.pixels as u8*
mut i := 0
n := img.width * img.height
until i < n:
off := i * 4
bp[off] = (255 - (bp[off] as int)) as u8
bp[off + 1] = (255 - (bp[off + 1] as int)) as u8
bp[off + 2] = (255 - (bp[off + 2] as int)) as u8
i += 1
end
end
@en "Brightness"
@fa "روشنایی"
pub func Brightness(img &: Image, delta: int):
if img.pixels == null: ret end
bp := img.pixels as u8*
mut i := 0
n := img.width * img.height
until i < n:
off := i * 4
bp[off] = _clamp255((bp[off] as int) + delta) as u8
bp[off + 1] = _clamp255((bp[off + 1] as int) + delta) as u8
bp[off + 2] = _clamp255((bp[off + 2] as int) + delta) as u8
i += 1
end
end
@en "Contrast"
@fa "کنتراست"
pub func Contrast(img &: Image, factor: f64):
if img.pixels == null: ret end
bp := img.pixels as u8*
mut i := 0
n := img.width * img.height
until i < n:
off := i * 4
r := (((bp[off] as f64) - 128.0) * factor + 128.0) as int
g := (((bp[off + 1] as f64) - 128.0) * factor + 128.0) as int
b := (((bp[off + 2] as f64) - 128.0) * factor + 128.0) as int
bp[off] = _clamp255(r) as u8
bp[off + 1] = _clamp255(g) as u8
bp[off + 2] = _clamp255(b) as u8
i += 1
end
end
@en "Threshold"
@fa "آستانه"
pub func Threshold(img &: Image, level: int):
if img.pixels == null: ret end
bp := img.pixels as u8*
mut i := 0
n := img.width * img.height
until i < n:
off := i * 4
r := bp[off] as int
g := bp[off + 1] as int
b := bp[off + 2] as int
l := (r * 299 + g * 587 + b * 114) / 1000
mut v := 0 as u8
if l >= level: v = 255 as u8 end
bp[off] = v
bp[off + 1] = v
bp[off + 2] = v
i += 1
end
end
@en "Blurred"
@fa "تار شده"
pub func Blurred(img: Image, radius: int): Image:
out := New(img.width, img.height)
if IsEmpty(img) or radius <= 0:
if not IsEmpty(img): _copy_pixels(out, img) end
ret out
end
mut y := 0
until y < img.height:
mut x := 0
until x < img.width:
mut sr := 0
mut sg := 0
mut sb := 0
mut sa := 0
mut count := 0
mut dy := -radius
until dy <= radius:
sy := _clampi(y + dy, 0, img.height - 1)
mut dx := -radius
until dx <= radius:
sx := _clampi(x + dx, 0, img.width - 1)
c := GetPixel(img, sx, sy)
sr += c.r as int
sg += c.g as int
sb += c.b as int
sa += c.a as int
count += 1
dx += 1
end
dy += 1
end
SetPixel(out, x, y, RGBA(sr / count, sg / count, sb / count, sa / count))
x += 1
end
y += 1
end
ret out
end
@en "Sharpened"
@fa "تیزتر شده"
pub func Sharpened(img: Image, amount: f64): Image:
out := New(img.width, img.height)
if IsEmpty(img):
ret out
end
mut y := 0
until y < img.height:
mut x := 0
until x < img.width:
center := GetPixel(img, x, y)
up := GetPixel(img, x, _clampi(y - 1, 0, img.height - 1))
down := GetPixel(img, x, _clampi(y + 1, 0, img.height - 1))
left := GetPixel(img, _clampi(x - 1, 0, img.width - 1), y)
right := GetPixel(img, _clampi(x + 1, 0, img.width - 1), y)
cr := (center.r as f64) * (1.0 + 4.0 * amount) - amount * ((up.r as f64) + (down.r as f64) + (left.r as f64) + (right.r as f64))
cg := (center.g as f64) * (1.0 + 4.0 * amount) - amount * ((up.g as f64) + (down.g as f64) + (left.g as f64) + (right.g as f64))
cb := (center.b as f64) * (1.0 + 4.0 * amount) - amount * ((up.b as f64) + (down.b as f64) + (left.b as f64) + (right.b as f64))
SetPixel(out, x, y, RGBA(cr as int, cg as int, cb as int, center.a as int))
x += 1
end
y += 1
end
ret out
end
@en "Overlay"
@fa "روپوش"
pub func Overlay(base &: Image, mark: Image, x: int, y: int, opacity: f64):
if IsEmpty(mark): ret end
mut op := opacity
if op < 0.0: op = 0.0 end
if op > 1.0: op = 1.0 end
mut yy := 0
until yy < mark.height:
mut xx := 0
until xx < mark.width:
c := GetPixel(mark, xx, yy)
a := ((c.a as f64) * op) as int
if a > 0:
BlendPixel(base, x + xx, y + yy, RGBA(c.r as int, c.g as int, c.b as int, a))
end
xx += 1
end
yy += 1
end
end
package image
import compress
import archive
struct _GifLzw:
pub w: compress.BitWriter = compress.BitWriter {}
pub min: int = 2
pub dsize: int = 3
pub dnext: int = 6
pub dprev: bool = false
end
func _gif_u16(bp: u8*, at: int): int:
ret (bp[at] as int) | ((bp[at + 1] as int) << 8)
end
func _gif_lzw(data: compress.ByteBuf, min: int, total: int, out &: Vector<int>): bool:
if min < 2 or min > 8:
ret false
end
clear := 1 << min
eoi := clear + 1
mut prefix := Vector {} as Vector<int>
mut suffix := Vector {} as Vector<int>
mut length := Vector {} as Vector<int>
repeat 4096 in i:
prefix.push(0 - 1)
suffix.push(i < clear ? i : 0)
length.push(i < clear ? 1 : 0)
end
mut r := compress.NewBitReader(data.data, compress.BufLen(data))
mut size := min + 1
mut next := eoi + 1
mut prev := 0 - 1
mut good := true
mut done := false
until not done and out.len() < total:
code := compress.BitReadBits(r, size)
if r.bad:
done = true
else code == clear:
size = min + 1
next = eoi + 1
prev = 0 - 1
else code == eoi:
done = true
else:
cur := code
mut first := 0
if code < next and length.get(code) > 0:
mut c := code
until prefix.get(c) >= 0:
c = prefix.get(c)
end
first = suffix.get(c)
else code == next and prev >= 0:
mut c := prev
until prefix.get(c) >= 0:
c = prefix.get(c)
end
first = suffix.get(c)
else:
good = false
done = true
end
if not done:
if prev >= 0 and next < 4096:
prefix.set(next, prev)
suffix.set(next, first)
length.set(next, length.get(prev) + 1)
next += 1
if next == (1 << size) and size < 12:
size += 1
end
end
n := length.get(cur)
base := out.len()
repeat n:
out.push(0)
end
mut k := base + n - 1
mut c := cur
until c >= 0:
if k < total:
out.set(k, suffix.get(c))
end
k -= 1
c = prefix.get(c)
end
prev = code
end
end
end
prefix.free()
suffix.free()
length.free()
until out.len() > total:
out.pop()
end
ret good
end
func _gif_find(keys: Vector<int>, key: int): int:
mask := keys.len() - 1
mut h := ((((key as i64) * (40503 as i64)) >> 4) & (mask as i64)) as int
until keys.get(h) != 0 - 1 and keys.get(h) != key:
h = (h + 1) & mask
end
ret h
end
func _gif_exact(bp: u8*, total: int, limit: int, pal &: Vector<int>, keys &: Vector<int>, vals &: Vector<int>): bool:
repeat 1024:
keys.push(0 - 1)
vals.push(0)
end
repeat total in i:
if (bp[i * 4 + 3] as int) >= 128:
rgb := ((bp[i * 4] as int) << 16) | ((bp[i * 4 + 1] as int) << 8) | (bp[i * 4 + 2] as int)
h := _gif_find(keys, rgb)
if keys.get(h) != rgb:
if pal.len() >= limit:
ret false
end
keys.set(h, rgb)
vals.set(h, pal.len())
pal.push(rgb)
end
end
end
ret true
end
func _gif_bin(r: int, g: int, b: int): int:
ret ((r >> 3) << 10) | ((g >> 3) << 5) | (b >> 3)
end
func _gif_median(bp: u8*, total: int, limit: int, pal &: Vector<int>):
mut cnt := Vector {} as Vector<int>
mut sr := Vector {} as Vector<int>
mut sg := Vector {} as Vector<int>
mut sb := Vector {} as Vector<int>
repeat 32768:
cnt.push(0)
sr.push(0)
sg.push(0)
sb.push(0)
end
repeat total in i:
if (bp[i * 4 + 3] as int) >= 128:
r := bp[i * 4] as int
g := bp[i * 4 + 1] as int
b := bp[i * 4 + 2] as int
k := _gif_bin(r, g, b)
cnt.set(k, cnt.get(k) + 1)
sr.set(k, sr.get(k) + r)
sg.set(k, sg.get(k) + g)
sb.set(k, sb.get(k) + b)
end
end
mut bins := Vector {} as Vector<int>
repeat 32768 in k:
if cnt.get(k) > 0:
bins.push(k)
end
end
mut lo := Vector {} as Vector<int>
mut hi := Vector {} as Vector<int>
lo.push(0)
hi.push(bins.len())
mut tmp := Vector {} as Vector<int>
repeat bins.len():
tmp.push(0)
end
mut more := bins.len() > 0
until more and lo.len() < limit:
mut pick := 0 - 1
mut pick_score := 0
mut pick_ch := 0
repeat lo.len() in bi:
if hi.get(bi) - lo.get(bi) > 1:
mut mins := [31, 31, 31]
mut maxs := [0, 0, 0]
mut pixels := 0
mut j := lo.get(bi)
until j < hi.get(bi):
k := bins.get(j)
repeat 3 in c:
v := (k >> (10 - 5 * c)) & 31
if v < mins[c]:
mins[c] = v
end
if v > maxs[c]:
maxs[c] = v
end
end
pixels += cnt.get(k)
j += 1
end
mut ch := 0
repeat 3 in c:
if maxs[c] - mins[c] > maxs[ch] - mins[ch]:
ch = c
end
end
score := (maxs[ch] - mins[ch] + 1) * pixels
if maxs[ch] > mins[ch] and score > pick_score:
pick = bi
pick_score = score
pick_ch = ch
end
end
end
if pick < 0:
more = false
else:
a := lo.get(pick)
z := hi.get(pick)
shift := 10 - 5 * pick_ch
mut buckets := Vector {} as Vector<int>
repeat 33:
buckets.push(0)
end
mut j := a
until j < z:
v := (bins.get(j) >> shift) & 31
buckets.set(v + 1, buckets.get(v + 1) + 1)
j += 1
end
repeat 32 in v:
buckets.set(v + 1, buckets.get(v + 1) + buckets.get(v))
end
j = a
until j < z:
k := bins.get(j)
v := (k >> shift) & 31
tmp.set(a + buckets.get(v), k)
buckets.set(v, buckets.get(v) + 1)
j += 1
end
j = a
mut total_px := 0
until j < z:
bins.set(j, tmp.get(j))
total_px += cnt.get(bins.get(j))
j += 1
end
mut half := 0
mut cut := a + 1
j = a
until j < z - 1 and half + cnt.get(bins.get(j)) <= total_px / 2:
half += cnt.get(bins.get(j))
j += 1
end
cut = j > a ? j : a + 1
if cut >= z:
cut = z - 1
end
hi.set(pick, cut)
lo.push(cut)
hi.push(z)
buckets.free()
end
end
repeat lo.len() in bi:
mut tr := 0
mut tg := 0
mut tb := 0
mut tc := 0
mut j := lo.get(bi)
until j < hi.get(bi):
k := bins.get(j)
tr += sr.get(k)
tg += sg.get(k)
tb += sb.get(k)
tc += cnt.get(k)
j += 1
end
if tc > 0:
pal.push((((tr + tc / 2) / tc) << 16) | (((tg + tc / 2) / tc) << 8) | ((tb + tc / 2) / tc))
end
end
cnt.free()
sr.free()
sg.free()
sb.free()
bins.free()
lo.free()
hi.free()
tmp.free()
end
func _gif_nearest(pal: Vector<int>, r: int, g: int, b: int): int:
mut best := 0
mut best_d := 0 - 1
repeat pal.len() in i:
c := pal.get(i)
dr := ((c >> 16) & 255) - r
dg := ((c >> 8) & 255) - g
db := (c & 255) - b
d := dr * dr * 2 + dg * dg * 4 + db * db * 3
if best_d < 0 or d < best_d:
best_d = d
best = i
end
end
ret best
end
func _gif_clamp(v: int): int:
ret v < 0 ? 0 : (v > 255 ? 255 : v)
end
func _gif_emit(z &: _GifLzw, code: int):
compress.BitWriteBits(z.w, code, z.dsize)
clear := 1 << z.min
if code == clear:
z.dsize = z.min + 1
z.dnext = clear + 2
z.dprev = false
ret
end
if z.dprev and z.dnext < 4096:
z.dnext += 1
if z.dnext == (1 << z.dsize) and z.dsize < 12:
z.dsize += 1
end
end
z.dprev = true
end
func _gif_lzw_encode(idx: Vector<int>, min: int): compress.ByteBuf:
clear := 1 << min
mut z := _GifLzw { w = compress.NewBitWriter(), min = min, dsize = min + 1, dnext = clear + 2 }
mut keys := Vector {} as Vector<int>
mut codes := Vector {} as Vector<int>
repeat 8192:
keys.push(0 - 1)
codes.push(0)
end
_gif_emit(z, clear)
mut next := clear + 2
mut cur := 0 - 1
repeat idx.len() in i:
c := idx.get(i)
if cur < 0:
cur = c
else:
key := (cur << 8) | c
h := _gif_find(keys, key)
if keys.get(h) == key:
cur = codes.get(h)
else:
_gif_emit(z, cur)
if next < 4096:
keys.set(h, key)
codes.set(h, next)
next += 1
end
if next == 4096:
_gif_emit(z, clear)
next = clear + 2
repeat 8192 in k:
keys.set(k, 0 - 1)
end
end
cur = c
end
end
end
if cur >= 0:
_gif_emit(z, cur)
end
_gif_emit(z, clear + 1)
compress.BitFlush(z.w)
keys.free()
codes.free()
ret z.w.buf
end
@en "IsGIF"
@fa "گیف است"
pub func IsGIF(p: void*, n: int): bool:
if n < 6:
ret false
end
bp := p as u8*
ret (bp[0] as int) == 71 and (bp[1] as int) == 73 and (bp[2] as int) == 70 and (bp[3] as int) == 56 and ((bp[4] as int) == 55 or (bp[4] as int) == 57) and (bp[5] as int) == 97
end
@en "DecodeGIF"
@fa "کدگشایی گیف"
pub func DecodeGIF(p: void*, n: int, ok &: bool): Image:
ok = false
if not IsGIF(p, n) or n < 13:
ret New(0, 0)
end
bp := p as u8*
width := _gif_u16(bp, 6)
height := _gif_u16(bp, 8)
flags := bp[10] as int
mut at := 13
mut gct := 0
mut gct_at := 0
if (flags & 128) != 0:
gct = 1 << ((flags & 7) + 1)
gct_at = at
at += gct * 3
end
mut transparent := 0 - 1
until at < n:
b := bp[at] as int
if b == 33:
if at + 2 > n:
ret New(0, 0)
end
label := bp[at + 1] as int
at += 2
if label == 249 and at + 5 <= n and (bp[at] as int) >= 4:
transparent = ((bp[at + 1] as int) & 1) == 1 ? bp[at + 4] as int : 0 - 1
end
until at < n and (bp[at] as int) != 0:
at += (bp[at] as int) + 1
end
at += 1
else b == 44:
if at + 11 > n:
ret New(0, 0)
end
fx := _gif_u16(bp, at + 1)
fy := _gif_u16(bp, at + 3)
fw := _gif_u16(bp, at + 5)
fh := _gif_u16(bp, at + 7)
iflags := bp[at + 9] as int
at += 10
mut ct := gct
mut ct_at := gct_at
if (iflags & 128) != 0:
ct = 1 << ((iflags & 7) + 1)
ct_at = at
at += ct * 3
end
if ct == 0 or at >= n or fw == 0 or fh == 0 or width == 0 or height == 0 or (width as i64) * (height as i64) > (268435456 as i64):
ret New(0, 0)
end
min := bp[at] as int
at += 1
mut data := compress.NewByteBuf()
until at < n and (bp[at] as int) != 0:
len := bp[at] as int
if at + 1 + len > n:
compress.BufFree(data)
ret New(0, 0)
end
compress.BufPushBytes(data, ((p as i64) + ((at + 1) as i64)) as void*, len)
at += len + 1
end
mut idx := Vector {} as Vector<int>
good := _gif_lzw(data, min, fw * fh, idx)
compress.BufFree(data)
if not good or idx.len() == 0:
idx.free()
ret New(0, 0)
end
img := New(width, height)
dst := img.pixels as u8*
interlaced := (iflags & 64) != 0
mut row := 0
mut pass := 0
mut step := 8
repeat fh in j:
mut y := j
if interlaced:
if j > 0:
row += step
until row >= fh and pass < 3:
pass += 1
row = pass == 1 ? 4 : (pass == 2 ? 2 : 1)
step = pass == 1 ? 8 : (pass == 2 ? 4 : 2)
end
end
y = row
end
repeat fw in x:
k := j * fw + x
if k < idx.len() and fy + y < height and fx + x < width:
c := idx.get(k)
if c != transparent and c < ct:
o := ((fy + y) * width + fx + x) * 4
dst[o] = bp[ct_at + c * 3]
dst[o + 1] = bp[ct_at + c * 3 + 1]
dst[o + 2] = bp[ct_at + c * 3 + 2]
dst[o + 3] = 255 as u8
end
end
end
end
idx.free()
ok = true
ret img
else:
ret New(0, 0)
end
end
ret New(0, 0)
end
@en "OpenGIF"
@fa "بازکردن گیف"
pub func OpenGIF(path: str, ok &: bool): Image:
mut read_ok := false
mut buf := archive.ReadBinaryFile(path, read_ok)
ok = false
if not read_ok:
ret New(0, 0)
end
img := DecodeGIF(buf.data, compress.BufLen(buf), ok)
compress.BufFree(buf)
ret img
end
@en "EncodeGIF"
@fa "کدگذاری گیف"
pub func EncodeGIF(img: Image): compress.ByteBuf:
mut out := compress.NewByteBuf()
if IsEmpty(img) or img.width > 65535 or img.height > 65535:
ret out
end
bp := img.pixels as u8*
w := img.width
h := img.height
total := w * h
mut has_clear := false
repeat total in i:
if (bp[i * 4 + 3] as int) < 128:
has_clear = true
end
end
limit := has_clear ? 255 : 256
mut pal := Vector {} as Vector<int>
mut keys := Vector {} as Vector<int>
mut vals := Vector {} as Vector<int>
exact := _gif_exact(bp, total, limit, pal, keys, vals)
mut idx := Vector {} as Vector<int>
if exact:
repeat total in i:
if (bp[i * 4 + 3] as int) < 128:
idx.push(pal.len())
else:
rgb := ((bp[i * 4] as int) << 16) | ((bp[i * 4 + 1] as int) << 8) | (bp[i * 4 + 2] as int)
idx.push(vals.get(_gif_find(keys, rgb)))
end
end
else:
pal.clear()
_gif_median(bp, total, limit, pal)
mut cache := Vector {} as Vector<int>
repeat 32768:
cache.push(0 - 1)
end
mut err := Vector {} as Vector<int>
repeat (w + 2) * 6:
err.push(0)
end
repeat h in y:
cur := (y % 2) * (w + 2) * 3
nxt := ((y + 1) % 2) * (w + 2) * 3
repeat (w + 2) * 3 in k:
err.set(nxt + k, 0)
end
repeat w in x:
i := y * w + x
if (bp[i * 4 + 3] as int) < 128:
idx.push(pal.len())
else:
e := cur + (x + 1) * 3
r := _gif_clamp((bp[i * 4] as int) + err.get(e) / 16)
g := _gif_clamp((bp[i * 4 + 1] as int) + err.get(e + 1) / 16)
b := _gif_clamp((bp[i * 4 + 2] as int) + err.get(e + 2) / 16)
k := _gif_bin(r, g, b)
if cache.get(k) < 0:
cache.set(k, _gif_nearest(pal, (r & 248) | 4, (g & 248) | 4, (b & 248) | 4))
end
pi := cache.get(k)
idx.push(pi)
c := pal.get(pi)
dr := r - ((c >> 16) & 255)
dg := g - ((c >> 8) & 255)
db := b - (c & 255)
ds := [dr, dg, db]
repeat 3 in ch:
d := ds[ch]
err.set(e + 3 + ch, err.get(e + 3 + ch) + d * 7)
err.set(nxt + x * 3 + ch, err.get(nxt + x * 3 + ch) + d * 3)
err.set(nxt + (x + 1) * 3 + ch, err.get(nxt + (x + 1) * 3 + ch) + d * 5)
err.set(nxt + (x + 2) * 3 + ch, err.get(nxt + (x + 2) * 3 + ch) + d)
end
end
end
end
cache.free()
err.free()
end
used := pal.len() + (has_clear ? 1 : 0)
mut bits := 1
until (1 << bits) < used:
bits += 1
end
compress.BufPushBytes(out, "GIF89a" as void*, 6)
compress.BufPush(out, w & 255)
compress.BufPush(out, w >> 8)
compress.BufPush(out, h & 255)
compress.BufPush(out, h >> 8)
compress.BufPush(out, 240 | (bits - 1))
compress.BufPush(out, 0)
compress.BufPush(out, 0)
repeat 1 << bits in i:
c := i < pal.len() ? pal.get(i) : 0
compress.BufPush(out, (c >> 16) & 255)
compress.BufPush(out, (c >> 8) & 255)
compress.BufPush(out, c & 255)
end
if has_clear:
each b in [33, 249, 4, 1, 0, 0]:
compress.BufPush(out, b)
end
compress.BufPush(out, pal.len())
compress.BufPush(out, 0)
end
each b in [44, 0, 0, 0, 0]:
compress.BufPush(out, b)
end
compress.BufPush(out, w & 255)
compress.BufPush(out, w >> 8)
compress.BufPush(out, h & 255)
compress.BufPush(out, h >> 8)
compress.BufPush(out, 0)
min := bits < 2 ? 2 : bits
compress.BufPush(out, min)
mut data := _gif_lzw_encode(idx, min)
dlen := compress.BufLen(data)
mut at := 0
until at < dlen:
len := dlen - at > 255 ? 255 : dlen - at
compress.BufPush(out, len)
compress.BufPushBytes(out, ((data.data as i64) + (at as i64)) as void*, len)
at += len
end
compress.BufPush(out, 0)
compress.BufPush(out, 59)
compress.BufFree(data)
pal.free()
keys.free()
vals.free()
idx.free()
ret out
end
@en "SaveGIF"
@fa "ذخیره گیف"
pub func SaveGIF(img: Image, path: str): bool:
mut buf := EncodeGIF(img)
if compress.BufLen(buf) == 0:
compress.BufFree(buf)
ret false
end
ok := archive.WriteBinaryFileBuf(path, buf)
compress.BufFree(buf)
ret ok
end
package image
import math
const _TTF_SUBSAMPLES := 4
struct _Edge:
pub x0: f64 = 0.0
pub y0: f64 = 0.0
pub x1: f64 = 0.0
pub y1: f64 = 0.0
pub dir: int = 0
end
struct _Cross:
pub x: f64 = 0.0
pub dir: int = 0
end
func _ttf_clampi(v: int, lo: int, hi: int): int:
if v < lo: ret lo end
if v > hi: ret hi end
ret v
end
func _edge_push(edges &: Vector<_Edge>, x0: f64, y0: f64, x1: f64, y1: f64):
if y0 == y1:
ret
end
mut e := _Edge {}
if y0 < y1:
e.x0 = x0
e.y0 = y0
e.x1 = x1
e.y1 = y1
e.dir = 1
else:
e.x0 = x1
e.y0 = y1
e.x1 = x0
e.y1 = y0
e.dir = 0 - 1
end
edges.push(e)
end
func _quad_to(edges &: Vector<_Edge>, x0: f64, y0: f64, cx: f64, cy: f64, x1: f64, y1: f64):
d := math.Abs(cx - x0) + math.Abs(cy - y0) + math.Abs(x1 - cx) + math.Abs(y1 - cy)
mut n := 2 + (d / 3.0) as int
if n > 32:
n = 32
end
mut px := x0
mut py := y0
mut i := 1
until i <= n:
t := (i as f64) / (n as f64)
mt := 1.0 - t
qx := mt * mt * x0 + 2.0 * mt * t * cx + t * t * x1
qy := mt * mt * y0 + 2.0 * mt * t * cy + t * t * y1
_edge_push(edges, px, py, qx, qy)
px = qx
py = qy
i += 1
end
end
func _contour_edges(pts &: Vector<_GlyphPoint>, s: int, e: int, edges &: Vector<_Edge>):
if e - s < 2:
ret
end
p0 := pts.get(s)
plast := pts.get(e - 1)
mut startx := 0.0
mut starty := 0.0
mut lo := s
mut hi := e - 1
if p0.on:
startx = p0.x
starty = p0.y
lo = s + 1
else if plast.on:
startx = plast.x
starty = plast.y
hi = e - 2
else:
startx = (p0.x + plast.x) * 0.5
starty = (p0.y + plast.y) * 0.5
end
mut cx := startx
mut cy := starty
mut ctrlx := 0.0
mut ctrly := 0.0
mut have_ctrl := false
mut i := lo
until i <= hi:
p := pts.get(i)
if p.on:
if have_ctrl:
_quad_to(edges, cx, cy, ctrlx, ctrly, p.x, p.y)
have_ctrl = false
else:
_edge_push(edges, cx, cy, p.x, p.y)
end
cx = p.x
cy = p.y
else:
if have_ctrl:
mx := (ctrlx + p.x) * 0.5
my := (ctrly + p.y) * 0.5
_quad_to(edges, cx, cy, ctrlx, ctrly, mx, my)
cx = mx
cy = my
end
ctrlx = p.x
ctrly = p.y
have_ctrl = true
end
i += 1
end
if have_ctrl:
_quad_to(edges, cx, cy, ctrlx, ctrly, startx, starty)
else:
_edge_push(edges, cx, cy, startx, starty)
end
end
func _build_edges(pts &: Vector<_GlyphPoint>, ends &: Vector<int>, edges &: Vector<_Edge>):
mut s := 0
mut k := 0
until k < ends.len():
e := ends.get(k)
if e > s and e <= pts.len():
_contour_edges(pts, s, e, edges)
end
s = e
k += 1
end
end
func _add_span(acc &: Vector<f64>, xoff: int, w: int, xa: f64, xb: f64, weight: f64):
mut a := xa - (xoff as f64)
mut b := xb - (xoff as f64)
if a < 0.0:
a = 0.0
end
if b > (w as f64):
b = w as f64
end
if b <= a:
ret
end
ia := a as int
mut ib := b as int
if ib >= w:
ib = w - 1
end
if ia >= w or ib < ia:
ret
end
if ia == ib:
acc.set(ia, acc.get(ia) + (b - a) * weight)
ret
end
acc.set(ia, acc.get(ia) + (((ia + 1) as f64) - a) * weight)
mut i := ia + 1
until i < ib:
acc.set(i, acc.get(i) + weight)
i += 1
end
acc.set(ib, acc.get(ib) + (b - (ib as f64)) * weight)
end
func _accumulate_spans(xs &: Vector<_Cross>, acc &: Vector<f64>, xoff: int, w: int, weight: f64):
mut wind := 0
mut spanx := 0.0
mut i := 0
until i < xs.len():
cr := xs.get(i)
prev := wind
wind += cr.dir
if prev == 0 and wind != 0:
spanx = cr.x
else if prev != 0 and wind == 0:
_add_span(acc, xoff, w, spanx, cr.x, weight)
end
i += 1
end
end
func _blit_coverage(img &: Image, acc &: Vector<f64>, xoff: int, w: int, py: int, c: Color):
ca := c.a as int
mut i := 0
until i < w:
mut cov := acc.get(i)
if cov > 0.002:
if cov > 1.0:
cov = 1.0
end
alpha := ((ca as f64) * cov + 0.5) as int
if alpha > 0:
BlendPixel(img, xoff + i, py, RGBA(c.r as int, c.g as int, c.b as int, alpha))
end
end
i += 1
end
end
func _gr_msort(idx &: Vector<int>, keys &: Vector<f64>, tmp &: Vector<int>, lo: int, hi: int):
if hi - lo < 2:
ret
end
mid := (lo + hi) / 2
_gr_msort(idx, keys, tmp, lo, mid)
_gr_msort(idx, keys, tmp, mid, hi)
mut i := lo
mut j := mid
mut k := lo
until k < hi:
if j >= hi or (i < mid and keys.get(idx.get(i)) <= keys.get(idx.get(j))):
tmp.set(k, idx.get(i))
i += 1
else:
tmp.set(k, idx.get(j))
j += 1
end
k += 1
end
k = lo
until k < hi:
idx.set(k, tmp.get(k))
k += 1
end
end
func _gr_sort(idx &: Vector<int>, keys &: Vector<f64>, tmp &: Vector<int>):
until tmp.len() < idx.len():
tmp.push(0)
end
_gr_msort(idx, keys, tmp, 0, idx.len())
end
func _fill_edges(img &: Image, edges &: Vector<_Edge>, c: Color):
n := edges.len()
if n == 0 or img.pixels == null:
ret
end
mut minx := 1.0e30
mut maxx := 0.0 - 1.0e30
mut miny := 1.0e30
mut maxy := 0.0 - 1.0e30
mut ykeys := Vector {} as Vector<f64>
mut order := Vector {} as Vector<int>
mut i := 0
until i < n:
e := edges.get(i)
if e.x0 < minx: minx = e.x0 end
if e.x1 < minx: minx = e.x1 end
if e.x0 > maxx: maxx = e.x0 end
if e.x1 > maxx: maxx = e.x1 end
if e.y0 < miny: miny = e.y0 end
if e.y1 > maxy: maxy = e.y1 end
ykeys.push(e.y0)
order.push(i)
i += 1
end
x0 := _ttf_clampi(math.Floor(minx) as int, 0, img.width)
x1 := _ttf_clampi((math.Floor(maxx) as int) + 1, 0, img.width)
y0 := _ttf_clampi(math.Floor(miny) as int, 0, img.height)
y1 := _ttf_clampi((math.Floor(maxy) as int) + 1, 0, img.height)
if x1 <= x0 or y1 <= y0:
ykeys.free()
order.free()
ret
end
mut tmp := Vector {} as Vector<int>
_gr_sort(order, ykeys, tmp)
w := x1 - x0
step := 1.0 / (_TTF_SUBSAMPLES as f64)
mut acc := Vector {} as Vector<f64>
acc.zeros(w)
mut xs := Vector {} as Vector<_Cross>
mut active := Vector {} as Vector<int>
mut xkeys := Vector {} as Vector<f64>
mut xorder := Vector {} as Vector<int>
mut sorted := Vector {} as Vector<_Cross>
mut next := 0
mut py := y0
until py < y1:
mut k := 0
until k < w:
acc.set(k, 0.0)
k += 1
end
mut s := 0
until s < _TTF_SUBSAMPLES:
sy := (py as f64) + ((s as f64) + 0.5) * step
until next < n and edges.get(order.get(next)).y0 <= sy:
active.push(order.get(next))
next += 1
end
xs.clear()
xkeys.clear()
xorder.clear()
mut keep := 0
mut a := 0
until a < active.len():
ei := active.get(a)
e := edges.get(ei)
if e.y1 > sy:
active.set(keep, ei)
keep += 1
if sy >= e.y0:
mut cr := _Cross {}
cr.x = e.x0 + (sy - e.y0) * (e.x1 - e.x0) / (e.y1 - e.y0)
cr.dir = e.dir
xorder.push(xs.len())
xkeys.push(cr.x)
xs.push(cr)
end
end
a += 1
end
until active.len() > keep:
active.pop()
end
_gr_sort(xorder, xkeys, tmp)
sorted.clear()
mut q := 0
until q < xorder.len():
sorted.push(xs.get(xorder.get(q)))
q += 1
end
_accumulate_spans(sorted, acc, x0, w, step)
s += 1
end
_blit_coverage(img, acc, x0, w, py, c)
py += 1
end
acc.free()
xs.free()
active.free()
xkeys.free()
xorder.free()
sorted.free()
tmp.free()
ykeys.free()
order.free()
end
func _draw_glyph_xform(img &: Image, f: Font, glyph: int, a: f64, b: f64, c: f64, d: f64, dx: f64, dy: f64, col: Color):
if not FontValid(f) or img.pixels == null:
ret
end
mut pts := Vector {} as Vector<_GlyphPoint>
mut ends := Vector {} as Vector<int>
mut edges := Vector {} as Vector<_Edge>
mut work := 0
_ttf_append_glyph(f, glyph, a, b, c, d, dx, dy, pts, ends, 0, work)
_build_edges(pts, ends, edges)
if edges.len() <= 65536:
_fill_edges(img, edges, col)
end
pts.free()
ends.free()
edges.free()
end
@en "image"
@fa "تصویر"
package image
import mem
@en "Image"
@fa "تصویر"
pub struct Image:
pub width: int = 0
pub height: int = 0
pub pixels: void* = null
end
@en "Color"
@fa "رنگ"
pub struct Color:
pub r: u8 = 0 as u8
pub g: u8 = 0 as u8
pub b: u8 = 0 as u8
pub a: u8 = 255 as u8
end
inline func _px_off(img: Image, x: int, y: int): int:
ret (y * img.width + x) * 4
end
@en "New"
@fa "جدید"
pub func New(width: int, height: int): Image:
if width <= 0 or height <= 0:
ret Image { width = 0, height = 0 }
end
pixels := (width as i64) * (height as i64)
if pixels > (536870912 as i64):
ret Image { width = 0, height = 0 }
end
p := mem.AllocateZeroed((pixels * (4 as i64)) as u64)
if p == null:
ret Image { width = 0, height = 0 }
end
mut img := Image { width = width, height = height }
img.pixels = p
ret img
end
@en "NewFilled"
@fa "جدید با رنگ"
pub func NewFilled(width: int, height: int, c: Color): Image:
mut img := New(width, height)
Fill(img, c)
ret img
end
@en "Free"
@fa "آزادسازی"
pub func Free(img &: Image):
if img.pixels != null:
mem.Free(img.pixels)
end
img.pixels = null
img.width = 0
img.height = 0
end
@en "Clone"
@fa "کپی"
pub func Clone(img: Image): Image:
out := New(img.width, img.height)
if out.pixels != null and img.pixels != null:
mem.Copy(out.pixels, img.pixels, (img.width * img.height * 4) as u64)
end
ret out
end
@en "IsEmpty"
@fa "خالی است"
pub func IsEmpty(img: Image): bool:
ret img.width <= 0 or img.height <= 0 or img.pixels == null
end
@en "InBounds"
@fa "در محدوده"
pub func InBounds(img: Image, x: int, y: int): bool:
ret x >= 0 and y >= 0 and x < img.width and y < img.height
end
@en "GetPixel"
@fa "دریافت پیکسل"
pub func GetPixel(img: Image, x: int, y: int): Color:
if img.pixels == null or not InBounds(img, x, y):
ret Color { r = 0 as u8, g = 0 as u8, b = 0 as u8, a = 0 as u8 }
end
bp := img.pixels as u8*
off := _px_off(img, x, y)
mut c := Color { r = bp[off], g = bp[off + 1] }
c.b = bp[off + 2]
c.a = bp[off + 3]
ret c
end
@en "SetPixel"
@fa "تنظیم پیکسل"
pub func SetPixel(img &: Image, x: int, y: int, c: Color):
if img.pixels == null or not InBounds(img, x, y):
ret
end
bp := img.pixels as u8*
off := _px_off(img, x, y)
bp[off] = c.r
bp[off + 1] = c.g
bp[off + 2] = c.b
bp[off + 3] = c.a
end
@en "BlendPixel"
@fa "ترکیب پیکسل"
pub func BlendPixel(img &: Image, x: int, y: int, c: Color):
if c.a == (255 as u8):
SetPixel(img, x, y, c)
ret
end
if c.a == (0 as u8):
ret
end
under := GetPixel(img, x, y)
SetPixel(img, x, y, Blend(under, c))
end
@en "Fill"
@fa "پر کردن"
pub func Fill(img &: Image, c: Color):
if img.pixels == null:
ret
end
bp := img.pixels as u8*
mut i := 0
n := img.width * img.height
until i < n:
off := i * 4
bp[off] = c.r
bp[off + 1] = c.g
bp[off + 2] = c.b
bp[off + 3] = c.a
i += 1
end
end
@en "FillHex"
@fa "پر کردن با هگز"
pub func FillHex(img &: Image, hex: str):
Fill(img, ParseHex(hex))
end
