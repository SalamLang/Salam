@en "Open"
@fa "باز کردن"
pub func Open(m: Manager): bool:
if m.p == null:
ret false
end
mp := _mgr(m)
if mp[0].state == ST_OPEN:
ret true
end
if not mp[0].ep.ok:
ret false
end
if not _engine_open(mp):
if mp[0].opts.reconnection:
mp[0].state = ST_WAITING
mp[0].retry_at = time.MonoMillis() + _backoff(mp)
end
ret false
end
mp[0].attempts = 0
ret true
end
@en "IsOpen"
@fa "باز است"
