package layoutgen
JALALI_JS := `function salamJalaliDate(el) {
  var fa = "۰۱۲۳۴۵۶۷۸۹", ar = "٠١٢٣٤٥٦٧٨٩";
  function latin(s) {
    var o = "";
    for (var i = 0; i < s.length; i++) {
      var c = s.charAt(i), k = fa.indexOf(c);
      if (k < 0) k = ar.indexOf(c);
      o += k >= 0 ? String(k) : c;
    }
    return o;
  }
  function persian(s) { return s.replace(/[0-9]/g, function (d) { return fa.charAt(+d); }); }
  function clean(s) {
    s = latin(s).replace(/[-.\s]/g, "/").replace(/[^0-9\/]/g, "").replace(/\/+/g, "/");
    if (s.indexOf("/") < 0) {
      var p = [s.slice(0, 4), s.slice(4, 6), s.slice(6, 8)];
      s = p.filter(function (x) { return x.length > 0; }).join("/");
    }
    return s.slice(0, 10);
  }
  function leap(y) { return [1, 5, 9, 13, 17, 22, 26, 30].indexOf(((y % 33) + 33) % 33) >= 0; }
  function valid(s) {
    var m = /^(\d{4})\/(\d{1,2})\/(\d{1,2})$/.exec(s);
    if (!m) return false;
    var y = +m[1], mo = +m[2], d = +m[3];
    if (mo < 1 || mo > 12 || d < 1) return false;
    var max = mo <= 6 ? 31 : (mo <= 11 ? 30 : (leap(y) ? 30 : 29));
    return d <= max;
  }
  function pad(s) {
    var m = /^(\d{4})\/(\d{1,2})\/(\d{1,2})$/.exec(s);
    return m ? m[1] + "/" + ("0" + m[2]).slice(-2) + "/" + ("0" + m[3]).slice(-2) : s;
  }
  function sync(full) {
    var v = clean(el.value);
    if (full) v = pad(v);
    el.value = persian(v);
    el.dataset.value = v;
    el.setCustomValidity(v === "" || valid(v) ? "" : (el.dataset.message || "تاریخ شمسی نامعتبر است"));
  }
  el.addEventListener("input", function () { sync(false); });
  el.addEventListener("change", function () { sync(true); el.reportValidity(); });
  el.addEventListener("paste", function (e) {
    var t = (e.clipboardData || window.clipboardData).getData("text");
    e.preventDefault();
    el.value = t;
    sync(true);
  });
  el.addEventListener("copy", function (e) {
    if (!e.clipboardData) return;
    e.clipboardData.setData("text/plain", el.dataset.value || "");
    e.preventDefault();
  });
  sync(true);
}
`
@en "jalali_date"
@fa "تاریخ_شمسی"
pub func jalali_date(n: Node): Output:
mut o := Output {}
o.html = "<input type=\"text\" inputmode=\"numeric\" autocomplete=\"off\" dir=\"ltr\" maxlength=\"10\"" + n.attrs + ClassAttr(n, n.uid) + ">"
if not n.compact:
o.html += "\n"
end
o.css = "." + n.uid + ":invalid { outline: 2px solid #d33; }"
o.shared_js = JALALI_JS
o.js = "const " + n.uid + " = document.querySelector(\"." + n.uid + "\");\nsalamJalaliDate(" + n.uid + ");"
ret o
end
@en "layoutgen"
@fa "سازنده‌ها"
package layoutgen
import str
@en "Node"
@fa "گره"
pub struct Node:
pub name: str = ""
pub tag: str = ""
pub uid: str = ""
pub class_name: str = ""
pub attrs: str = ""
pub content: str = ""
pub inner: str = ""
pub parents: str = ""
pub compact: bool = false
pub keys: Vector<str> = Vector {}
pub vals: Vector<str> = Vector {}
end
@en "Output"
@fa "خروجی"
pub struct Output:
pub html: str = ""
pub css: str = ""
pub js: str = ""
pub head: str = ""
pub shared_css: str = ""
pub shared_js: str = ""
end
@en "Set"
@fa "بگذار"
pub func Set(n &: Node, key: str, value: str):
n.keys.push(key)
n.vals.push(value)
end
@en "Get"
@fa "بگیر"
pub func Get(n: Node, key: str): str:
repeat n.keys.len() in i:
if n.keys.get(i) == key:
ret n.vals.get(i)
end
end
ret ""
end
@en "Has"
@fa "دارد"
pub func Has(n: Node, key: str): bool:
repeat n.keys.len() in i:
if n.keys.get(i) == key:
ret true
end
end
ret false
end
@en "Parent"
@fa "والد"
pub func Parent(n: Node): str:
comma := n.parents.find(",")
if comma < 0:
ret n.parents
end
ret n.parents.substr(0, comma)
end
@en "Escape"
@fa "گریز"
pub func Escape(s: str): str:
ret str.Replace(str.Replace(str.Replace(str.Replace(str.Replace(s, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), "\"", "&quot;"), "'", "&#39;")
end
@en "ClassAttr"
@fa "ویژگی کلاس"
pub func ClassAttr(n: Node, extra: str): str:
mut cls := extra
if n.class_name.len() > 0:
cls = cls.len() > 0 ? cls + " " + n.class_name : n.class_name
end
if cls.len() == 0:
ret ""
end
ret " class=\"" + cls + "\""
end
@en "Emit"
@fa "بنویس"
pub func Emit(o: Output):
print o.html + "\x1f" + o.css + "\x1f" + o.js + "\x1f" + o.head + "\x1f" + o.shared_css + "\x1f" + o.shared_js + "\x1e"
end
@en "llm"
@fa "مدل زبانی بزرگ"
package llm
import math
import tensor
@en "ROPE_NORMAL"
@fa "روپ عادی"
pub const ROPE_NORMAL := 0
@en "ROPE_NEOX"
@fa "روپ نئوایکس"
pub const ROPE_NEOX := 1
@en "Config"
@fa "پیکربندی"
pub struct Config:
pub vocab: int = 0
pub dim: int = 0
pub layers: int = 0
pub heads: int = 1
pub kv_heads: int = 1
pub ff: int = 0
pub ctx: int = 512
pub eps: f64 = 0.00001
pub rope_theta: f64 = 10000.0
pub rope_kind: int = ROPE_NORMAL
@en "head_dim"
@fa "بعد سر"
pub func head_dim(): int: ret this.dim / this.heads end
end
@en "Layer"
@fa "لایه"
pub struct Layer:
pub attn_norm: tensor.Tensor = tensor.Tensor {}
pub wq: tensor.Tensor = tensor.Tensor {}
pub wk: tensor.Tensor = tensor.Tensor {}
pub wv: tensor.Tensor = tensor.Tensor {}
pub wo: tensor.Tensor = tensor.Tensor {}
pub ffn_norm: tensor.Tensor = tensor.Tensor {}
pub w_gate: tensor.Tensor = tensor.Tensor {}
pub w_up: tensor.Tensor = tensor.Tensor {}
pub w_down: tensor.Tensor = tensor.Tensor {}
@en "free"
@fa "آزادسازی"
pub func free():
this.attn_norm.free()
this.wq.free()
this.wk.free()
this.wv.free()
this.wo.free()
this.ffn_norm.free()
this.w_gate.free()
this.w_up.free()
this.w_down.free()
end
end
@en "Model"
@fa "مدل"
pub struct Model:
pub cfg: Config = Config {}
pub tok_embed: tensor.Tensor = tensor.Tensor {}
pub layers: Vector<Layer> = Vector {}
pub out_norm: tensor.Tensor = tensor.Tensor {}
pub out_head: tensor.Tensor = tensor.Tensor {}
pub ok: bool = false
@en "free"
@fa "آزادسازی"
pub func free():
this.tok_embed.free()
repeat this.layers.len() in i:
mut l := this.layers.get(i)
l.free()
end
this.layers.free()
this.out_norm.free()
this.out_head.free()
end
end
@en "KVCache"
@fa "حافظه کلید مقدار"
pub struct KVCache:
pub k: Vector<tensor.Tensor> = Vector {}
pub v: Vector<tensor.Tensor> = Vector {}
pub len: int = 0
pub ctx: int = 0
@en "reset"
@fa "بازنشانی"
pub func reset(): this.len = 0 end
@en "free"
@fa "آزادسازی"
pub func free():
repeat this.k.len() in i:
mut kt := this.k.get(i)
kt.free()
mut vt := this.v.get(i)
vt.free()
end
this.k.free()
this.v.free()
end
end
func _normal(shape &: Vector<int>, std: f64, g &: tensor.Rng): tensor.Tensor:
mut t := tensor.Zeros(shape)
tensor.FillNormal(t, 0.0, std, g)
ret t
end
func _ones(n: int): tensor.Tensor:
mut t := tensor.Zeros1(n)
tensor.SetAll(t, 1.0)
ret t
end
@en "NewKVCache"
@fa "حافظه کلید مقدار جدید"
pub func NewKVCache(cfg &: Config): KVCache:
mut c := KVCache {}
c.ctx = cfg.ctx
width := cfg.kv_heads * cfg.head_dim()
repeat cfg.layers:
c.k.push(tensor.Zeros2(cfg.ctx, width))
c.v.push(tensor.Zeros2(cfg.ctx, width))
end
ret c
end
@en "RandomModel"
@fa "مدل تصادفی"
pub func RandomModel(cfg &: Config, seed: i64): Model:
mut m := Model {}
m.cfg = cfg
mut g := tensor.NewRng(seed)
hd := cfg.head_dim()
sd := 1.0 / math.Sqrt(cfg.dim as f64)
sf := 1.0 / math.Sqrt(cfg.ff as f64)
mut s := tensor.Shape2(cfg.vocab, cfg.dim)
m.tok_embed = _normal(s, 1.0, g)
s.free()
repeat cfg.layers:
mut l := Layer {}
l.attn_norm = _ones(cfg.dim)
l.ffn_norm = _ones(cfg.dim)
mut sq := tensor.Shape2(cfg.heads * hd, cfg.dim)
l.wq = _normal(sq, sd, g)
l.wo = _normal(sq, sd, g)
sq.free()
mut sk := tensor.Shape2(cfg.kv_heads * hd, cfg.dim)
l.wk = _normal(sk, sd, g)
l.wv = _normal(sk, sd, g)
sk.free()
mut sg := tensor.Shape2(cfg.ff, cfg.dim)
l.w_gate = _normal(sg, sd, g)
l.w_up = _normal(sg, sd, g)
sg.free()
mut sdn := tensor.Shape2(cfg.dim, cfg.ff)
l.w_down = _normal(sdn, sf, g)
sdn.free()
m.layers.push(l)
end
m.out_norm = _ones(cfg.dim)
m.ok = true
ret m
end
package llm
import math
import tensor
extern:
func expf(x: f32): f32
func sqrtf(x: f32): f32
end
func _rmsnorm(x &: tensor.Tensor, w &: tensor.Tensor, eps: f64): tensor.Tensor:
n := x.dim(0)
d := x.dim(1)
out := tensor.Zeros2(n, d)
px := x.data.data
pw := w.data.data
po := out.data.data
repeat n in r:
base := r * d
mut ss := 0.0 as f32
repeat d in k:
v := px[base + k]
ss += v * v
end
inv := (1.0 as f32) / sqrtf(ss / (d as f32) + (eps as f32))
repeat d in k: po[base + k] = px[base + k] * inv * pw[k] end
end
ret out
end
func _rope(x &: tensor.Tensor, heads: int, hd: int, pos0: int, theta: f64, kind: int):
n := x.dim(0)
width := heads * hd
half := hd / 2
p := x.data.data
repeat n in i:
pos := (pos0 + i) as f64
repeat half in j:
freq := math.Pow(theta, 0.0 - (2.0 * (j as f64)) / (hd as f64))
ang := pos * freq
c := math.Cos(ang) as f32
s := math.Sin(ang) as f32
mut ia := 2 * j
mut ib := 2 * j + 1
if kind == ROPE_NEOX:
ia = j
ib = j + half
end
repeat heads in h:
base := i * width + h * hd
a := p[base + ia]
b := p[base + ib]
p[base + ia] = a * c - b * s
p[base + ib] = a * s + b * c
end
end
end
end
func _attention(q &: tensor.Tensor, kc &: tensor.Tensor, vc &: tensor.Tensor, pos0: int, heads: int, kv_heads: int, hd: int): tensor.Tensor:
n := q.dim(0)
width := heads * hd
kw := kv_heads * hd
out := tensor.Zeros2(n, width)
mut sc := tensor.Zeros1(pos0 + n)
pq := q.data.data
pk := kc.data.data
pv := vc.data.data
po := out.data.data
ps := sc.data.data
scale := (1.0 / math.Sqrt(hd as f64)) as f32
group := heads / kv_heads
repeat heads in h:
kh := h / group
repeat n in i:
last := pos0 + i
qb := i * width + h * hd
mut mx := 0.0 as f32
repeat last + 1 in j:
kb := j * kw + kh * hd
mut s := 0.0 as f32
repeat hd in d: s += pq[qb + d] * pk[kb + d] end
s = s * scale
ps[j] = s
if j == 0 or s > mx: mx = s end
end
mut sum := 0.0 as f32
repeat last + 1 in j:
e := expf(ps[j] - mx)
ps[j] = e
sum += e
end
inv := (1.0 as f32) / sum
ob := i * width + h * hd
repeat last + 1 in j:
pj := ps[j] * inv
vb := j * kw + kh * hd
repeat hd in d: po[ob + d] += pj * pv[vb + d] end
end
end
end
sc.free()
ret out
end
func _cache_put(dst &: tensor.Tensor, x &: tensor.Tensor, pos0: int):
n := x.dim(0)
w := x.dim(1)
pd := dst.data.data
px := x.data.data
repeat n * w in k: pd[pos0 * w + k] = px[k] end
end
func _gather_rows(table &: tensor.Tensor, ids &: Vector<int>): tensor.Tensor:
n := ids.len()
d := table.dim(1)
vocab := table.dim(0)
out := tensor.Zeros2(n, d)
pt := table.data.data
po := out.data.data
repeat n in i:
mut id := ids.get(i)
if id < 0 or id >= vocab: id = 0 end
repeat d in k: po[i * d + k] = pt[id * d + k] end
end
ret out
end
func _layer_forward(m &: Model, li: int, cache &: KVCache, x &: tensor.Tensor, pos0: int):
cfg := m.cfg
l := m.layers.get(li)
hd := cfg.head_dim()
mut h := _rmsnorm(x, l.attn_norm, cfg.eps)
mut q := tensor.MulTranspose(h, l.wq)
mut k := tensor.MulTranspose(h, l.wk)
mut v := tensor.MulTranspose(h, l.wv)
h.free()
_rope(q, cfg.heads, hd, pos0, cfg.rope_theta, cfg.rope_kind)
_rope(k, cfg.kv_heads, hd, pos0, cfg.rope_theta, cfg.rope_kind)
mut kc := cache.k.get(li)
mut vc := cache.v.get(li)
_cache_put(kc, k, pos0)
_cache_put(vc, v, pos0)
k.free()
v.free()
mut ctx := _attention(q, kc, vc, pos0, cfg.heads, cfg.kv_heads, hd)
q.free()
mut o := tensor.MulTranspose(ctx, l.wo)
ctx.free()
tensor.AddInPlace(x, o)
o.free()
mut h2 := _rmsnorm(x, l.ffn_norm, cfg.eps)
mut gate := tensor.MulTranspose(h2, l.w_gate)
mut up := tensor.MulTranspose(h2, l.w_up)
h2.free()
mut act := tensor.Silu(gate)
gate.free()
tensor.MulInPlace(act, up)
up.free()
mut down := tensor.MulTranspose(act, l.w_down)
act.free()
tensor.AddInPlace(x, down)
down.free()
end
@en "Forward"
@fa "پیشرو"
pub func Forward(m &: Model, cache &: KVCache, tokens &: Vector<int>): tensor.Tensor:
n := tokens.len()
pos0 := cache.len
if not m.ok or n == 0 or pos0 + n > cache.ctx: ret tensor.Empty() end
mut x := _gather_rows(m.tok_embed, tokens)
repeat m.cfg.layers in li:
_layer_forward(m, li, cache, x, pos0)
end
cache.len = pos0 + n
mut xn := _rmsnorm(x, m.out_norm, m.cfg.eps)
x.free()
mut logits := tensor.Empty()
if m.out_head.is_empty():
logits = tensor.MulTranspose(xn, m.tok_embed)
else:
logits = tensor.MulTranspose(xn, m.out_head)
end
xn.free()
ret logits
end
@en "LogitsRow"
@fa "ردیف لاجیت"
pub func LogitsRow(logits &: tensor.Tensor, row: int): tensor.Tensor:
ret tensor.SliceAxis0(logits, row, 1)
end
package llm
import gguf
import mem
import str
import tensor
func _meta_f64(g &: gguf.Gguf, key: str, dflt: f64): f64:
k := g.meta_index(key)
if k < 0: ret dflt end
v := g.values.get(k)
if v.kind == 6 or v.kind == 12: ret v.f end
ret v.i as f64
end
func _arch_int(g &: gguf.Gguf, arch: str, name: str, dflt: i64): i64:
key := arch + name
v := g.meta_int(key, dflt)
mem.Free(key as void*)
ret v
end
func _arch_f64(g &: gguf.Gguf, arch: str, name: str, dflt: f64): f64:
key := arch + name
v := _meta_f64(g, key, dflt)
mem.Free(key as void*)
ret v
end
func _blk_prefix(i: int): str:
mut sb := str.NewBuilder()
str.BufAppend(sb, "blk.")
str.BufAppendInt(sb, i as i64)
str.BufAppendChar(sb, 46)
r := str.BufStr(sb)
str.BufFree(sb)
ret r
end
func _blk_tensor(g &: gguf.Gguf, p: str, name: str, ok &: bool): tensor.Tensor:
key := p + name
t := _tensor(g, key, ok)
mem.Free(key as void*)
ret t
end
func _tensor(g &: gguf.Gguf, name: str, ok &: bool): tensor.Tensor:
idx := g.tensor_index(name)
if idx < 0:
ok = false
ret tensor.Empty()
end
mut got := false
t := gguf.LoadTensorF32(g, idx, got)
if not got: ok = false end
ret t
end
func _neox_arch(arch: str): bool:
names := ["qwen2", "qwen", "qwen3", "phi2", "phi3", "gptneox", "stablelm", "gemma", "gemma2", "olmo"]
repeat 10 in i:
if str.Equals(arch, names[i]): ret true end
end
ret false
end
@en "ConfigFromGguf"
@fa "پیکربندی از جی‌جی‌یو‌اف"
pub func ConfigFromGguf(g &: gguf.Gguf): Config:
mut c := Config {}
arch := g.meta_str("general.architecture")
c.dim = _arch_int(g, arch, ".embedding_length", 0) as int
c.layers = _arch_int(g, arch, ".block_count", 0) as int
c.heads = _arch_int(g, arch, ".attention.head_count", 1) as int
c.kv_heads = _arch_int(g, arch, ".attention.head_count_kv", c.heads as i64) as int
c.ff = _arch_int(g, arch, ".feed_forward_length", 0) as int
c.ctx = _arch_int(g, arch, ".context_length", 512) as int
c.eps = _arch_f64(g, arch, ".attention.layer_norm_rms_epsilon", 0.00001)
c.rope_theta = _arch_f64(g, arch, ".rope.freq_base", 10000.0)
c.rope_kind = _neox_arch(arch) ? ROPE_NEOX : ROPE_NORMAL
k := g.meta_index("tokenizer.ggml.tokens")
if k >= 0: c.vocab = g.values.get(k).strs.len() end
ret c
end
@en "ModelFromGguf"
@fa "مدل از جی‌جی‌یو‌اف"
pub func ModelFromGguf(g &: gguf.Gguf): Model:
mut m := Model {}
m.cfg = ConfigFromGguf(g)
mut ok := g.ok and m.cfg.dim > 0 and m.cfg.layers > 0
if not ok: ret m end
m.tok_embed = _tensor(g, "token_embd.weight", ok)
if m.cfg.vocab == 0 and not m.tok_embed.is_empty(): m.cfg.vocab = m.tok_embed.dim(0) end
m.out_norm = _tensor(g, "output_norm.weight", ok)
if g.tensor_index("output.weight") >= 0:
m.out_head = _tensor(g, "output.weight", ok)
end
repeat m.cfg.layers in i:
p := _blk_prefix(i)
mut l := Layer {}
l.attn_norm = _blk_tensor(g, p, "attn_norm.weight", ok)
l.wq = _blk_tensor(g, p, "attn_q.weight", ok)
l.wk = _blk_tensor(g, p, "attn_k.weight", ok)
l.wv = _blk_tensor(g, p, "attn_v.weight", ok)
l.wo = _blk_tensor(g, p, "attn_output.weight", ok)
l.ffn_norm = _blk_tensor(g, p, "ffn_norm.weight", ok)
l.w_gate = _blk_tensor(g, p, "ffn_gate.weight", ok)
l.w_up = _blk_tensor(g, p, "ffn_up.weight", ok)
l.w_down = _blk_tensor(g, p, "ffn_down.weight", ok)
m.layers.push(l)
mem.Free(p as void*)
end
m.ok = ok
if not ok: m.free() end
ret m
end
@en "TokenizerFromGguf"
@fa "توکن‌ساز از جی‌جی‌یو‌اف"
pub func TokenizerFromGguf(g &: gguf.Gguf): Tokenizer:
model := g.meta_str("tokenizer.ggml.model")
mut t := NewTokenizer(str.Equals(model, "gpt2") ? TOK_BPE : TOK_SPM)
kt := g.meta_index("tokenizer.ggml.tokens")
ks := g.meta_index("tokenizer.ggml.scores")
if kt >= 0:
toks := g.values.get(kt).strs
repeat toks.len() in i:
mut sc := 0.0
if ks >= 0 and i < g.values.get(ks).floats.len(): sc = g.values.get(ks).floats.get(i) end
_id := t.add_token(toks.get(i), sc)
end
end
km := g.meta_index("tokenizer.ggml.merges")
if km >= 0:
ms := g.values.get(km).strs
repeat ms.len() in i:
rule := ms.get(i)
sp := str.IndexOf(rule, " ")
if sp > 0: t.add_merge(str.Substr(rule, 0, sp), str.Substr(rule, sp + 1, rule.len() - sp - 1)) end
end
end
t.bos = g.meta_int("tokenizer.ggml.bos_token_id", 0 - 1) as int
t.eos = g.meta_int("tokenizer.ggml.eos_token_id", 0 - 1) as int
t.unk = g.meta_int("tokenizer.ggml.unknown_token_id", 0) as int
t.add_bos = g.meta_int("tokenizer.ggml.add_bos_token", 1) != 0
t.finish()
ret t
end
@en "LoadGgufModel"
@fa "بارگذاری مدل جی‌جی‌یو‌اف"
pub func LoadGgufModel(path: str, m &: Model, t &: Tokenizer): bool:
mut ok := false
mut g := gguf.LoadGguf(path, ok)
if not ok:
g.free()
ret false
end
m = ModelFromGguf(g)
t = TokenizerFromGguf(g)
g.free()
ret m.ok
end
package llm
import math
import sort
import tensor
@en "Sampler"
@fa "نمونه‌بردار"
pub struct Sampler:
pub temperature: f64 = 1.0
pub top_k: int = 0
pub top_p: f64 = 1.0
pub repeat_penalty: f64 = 1.0
pub rng: tensor.Rng = tensor.Rng {}
@en "sample"
@fa "نمونه"
pub func sample(logits &: tensor.Tensor, row: int, recent &: Vector<int>): int:
vocab := logits.dim(logits.rank() - 1)
mut val := Vector {} as Vector<f64>
base := row * vocab
repeat vocab in k: val.push(logits.at(base + k)) end
if this.repeat_penalty != 1.0:
repeat recent.len() in r:
id := recent.get(r)
if id < 0 or id >= vocab: continue end
v := val.get(id)
val.set(id, v > 0.0 ? v / this.repeat_penalty : v * this.repeat_penalty)
end
end
mut best := 0
repeat vocab in k:
if val.get(k) > val.get(best): best = k end
end
if this.temperature <= 0.0 or this.top_k == 1:
val.free()
ret best
end
mut idx := Vector {} as Vector<int>
repeat vocab in k: idx.push(k) end
sort.SortIndexDesc(idx, val)
mut keep := vocab
if this.top_k > 0 and this.top_k < keep: keep = this.top_k end
mx := val.get(idx.get(0))
mut probs := Vector {} as Vector<f64>
mut total := 0.0
repeat keep in k:
p := math.Exp((val.get(idx.get(k)) - mx) / this.temperature)
probs.push(p)
total += p
end
if this.top_p < 1.0:
mut mass := 0.0
mut cut := keep
repeat keep in k:
mass += probs.get(k) / total
if mass >= this.top_p and cut == keep: cut = k + 1 end
end
keep = cut
total = 0.0
repeat keep in k: total += probs.get(k) end
end
u := this.rng.next_float() * total
mut acc := 0.0
mut pick := idx.get(keep - 1)
mut done := false
repeat keep in k:
if done: continue end
acc += probs.get(k)
if u < acc:
pick = idx.get(k)
done = true
end
end
val.free()
idx.free()
probs.free()
ret pick
end
end
@en "NewSampler"
@fa "نمونه‌بردار جدید"
pub func NewSampler(seed: i64): Sampler:
mut s := Sampler {}
s.rng = tensor.NewRng(seed)
ret s
end
@en "Greedy"
@fa "حریصانه"
pub func Greedy(logits &: tensor.Tensor, row: int): int:
vocab := logits.dim(logits.rank() - 1)
base := row * vocab
mut best := 0
repeat vocab in k:
if logits.at(base + k) > logits.at(base + best): best = k end
end
ret best
end
@en "GenerateIds"
@fa "تولید شناسه‌ها"
pub func GenerateIds(m &: Model, cache &: KVCache, prompt_ids &: Vector<int>, max_new: int, sp &: Sampler, eos: int): Vector<int>:
mut out := Vector {} as Vector<int>
if prompt_ids.len() == 0: ret out end
mut logits := Forward(m, cache, prompt_ids)
if logits.is_empty(): ret out end
mut step := Vector {} as Vector<int>
step.push(0)
mut n := 0
mut stop := false
until n < max_new and not stop:
next := sp.sample(logits, logits.dim(0) - 1, out)
logits.free()
if next == eos:
stop = true
else:
out.push(next)
n += 1
if cache.len >= cache.ctx:
stop = true
else:
step.set(0, next)
logits = Forward(m, cache, step)
if logits.is_empty(): stop = true end
end
end
end
if not stop: logits.free() end
step.free()
ret out
end
@en "Generate"
@fa "تولید"
pub func Generate(m &: Model, cache &: KVCache, tok &: Tokenizer, prompt: str, max_new: int, sp &: Sampler): str:
mut ids := tok.encode(prompt)
mut gen := GenerateIds(m, cache, ids, max_new, sp, tok.eos)
text := tok.decode(gen)
ids.free()
gen.free()
ret text
end
package llm
import mem
import str
@en "TOK_SPM"
@fa "توکن‌ساز قطعه جمله"
pub const TOK_SPM := 0
@en "TOK_BPE"
@fa "توکن‌ساز بایتی"
pub const TOK_BPE := 1
const _SPM_SPACE := "\xE2\x96\x81"
@en "Tokenizer"
@fa "توکن‌ساز"
pub struct Tokenizer:
pub kind: int = TOK_SPM
pub tokens: Vector<str> = Vector {}
pub scores: Vector<f64> = Vector {}
pub index: HashMap<str, int> = HashMap {}
pub merges: HashMap<str, int> = HashMap {}
pub merge_keys: Vector<str> = Vector {}
pub bos: int = 0 - 1
pub eos: int = 0 - 1
pub unk: int = 0
pub add_bos: bool = true
pub byte_ids: Vector<int> = Vector {}
pub b2u: Vector<int> = Vector {}
@en "add_token"
@fa "افزودن توکن"
pub func add_token(text: str, score: f64): int:
id := this.tokens.len()
own := str.Clone(text)
this.tokens.push(own)
this.scores.push(score)
this.index.put(own, id)
ret id
end
@en "add_merge"
@fa "افزودن ادغام"
pub func add_merge(a: str, b: str):
rule := _join_pair(a, b)
this.merge_keys.push(rule)
this.merges.put(rule, this.merges.size())
end
@en "finish"
@fa "پایان"
pub func finish():
this.byte_ids.clear()
this.b2u.free()
this.b2u = _bpe_b2u()
repeat 256 in b:
mut key := ""
if this.kind == TOK_SPM:
key = _byte_token_text(b)
else:
mut sb := str.NewBuilder()
str.BufAppendCp(sb, this.b2u.get(b))
key = str.BufStr(sb)
str.BufFree(sb)
end
this.byte_ids.push(this.index.get_or(key, 0 - 1))
mem.Free(key as void*)
end
end
@en "size"
@fa "اندازه"
pub func size(): int: ret this.tokens.len() end
@en "token_text"
@fa "متن توکن"
pub func token_text(id: int): str:
if id < 0 or id >= this.tokens.len(): ret "" end
ret this.tokens.get(id)
end
@en "encode"
@fa "رمزگذاری"
pub func encode(text: str): Vector<int>:
mut out := Vector {} as Vector<int>
if this.add_bos and this.bos >= 0: out.push(this.bos) end
if this.kind == TOK_SPM:
this._encode_spm(text, out)
else:
this._encode_bpe(text, out)
end
ret out
end
@en "decode"
@fa "رمزگشایی"
pub func decode(ids &: Vector<int>): str:
mut sb := str.NewBuilder()
mut first := true
repeat ids.len() in i:
id := ids.get(i)
if id == this.bos or id == this.eos or id < 0 or id >= this.tokens.len(): continue end
t := this.tokens.get(id)
if this.kind == TOK_SPM:
if first and str.StartsWith(t, _SPM_SPACE):
trimmed := str.Substr(t, 3, t.len() - 3)
this._decode_spm_piece(sb, trimmed)
mem.Free(trimmed as void*)
else:
this._decode_spm_piece(sb, t)
end
else:
this._decode_bpe_piece(sb, t)
end
first = false
end
s := str.BufStr(sb)
str.BufFree(sb)
ret s
end
@en "free"
@fa "آزادسازی"
pub func free():
repeat this.tokens.len() in i: mem.Free(this.tokens.get(i) as void*) end
this.tokens.free()
this.scores.free()
this.index.free()
repeat this.merge_keys.len() in i: mem.Free(this.merge_keys.get(i) as void*) end
this.merge_keys.free()
this.merges.free()
this.byte_ids.free()
this.b2u.free()
end
func _encode_spm(text: str, out &: Vector<int>):
body := str.Replace(text, " ", _SPM_SPACE)
norm := _SPM_SPACE + body
mem.Free(body as void*)
mut syms := _chars_of(norm)
mem.Free(norm as void*)
this._merge_by_score(syms)
repeat syms.len() in i:
piece := syms.get(i)
id := this.index.get_or(piece, 0 - 1)
if id >= 0:
out.push(id)
continue
end
repeat piece.len() in k:
bid := this.byte_ids.get(_byte_at(piece, k))
out.push(bid >= 0 ? bid : this.unk)
end
end
_free_syms(syms)
end
func _merge_by_score(syms &: Vector<str>):
mut again := true
until again and syms.len() > 1:
mut best := 0 - 1
mut best_score := 0.0
repeat syms.len() - 1 in i:
cand := syms.get(i) + syms.get(i + 1)
id := this.index.get_or(cand, 0 - 1)
mem.Free(cand as void*)
if id < 0: continue end
sc := this.scores.get(id)
if best < 0 or sc > best_score:
best = i
best_score = sc
end
end
if best < 0:
again = false
else:
merged := syms.get(best) + syms.get(best + 1)
mem.Free(syms.get(best) as void*)
mem.Free(syms.get(best + 1) as void*)
syms.set(best, merged)
_r := syms.remove_at(best + 1)
end
end
end
func _encode_bpe(text: str, out &: Vector<int>):
n := text.len()
mut start := 0
until start < n:
mut stop := start + 1
until stop < n and _byte_at(text, stop) != 32: stop += 1 end
word := text.substr(start, stop - start)
this._encode_bpe_word(word, out)
mem.Free(word as void*)
start = stop
end
end
func _encode_bpe_word(word: str, out &: Vector<int>):
mut syms := Vector {} as Vector<str>
repeat word.len() in k:
mut sb := str.NewBuilder()
str.BufAppendCp(sb, this.b2u.get(_byte_at(word, k)))
syms.push(str.BufStr(sb))
str.BufFree(sb)
end
mut again := true
until again and syms.len() > 1:
mut best := 0 - 1
mut best_rank := 0
repeat syms.len() - 1 in i:
probe := _join_pair(syms.get(i), syms.get(i + 1))
rank := this.merges.get_or(probe, 0 - 1)
mem.Free(probe as void*)
if rank < 0: continue end
if best < 0 or rank < best_rank:
best = i
best_rank = rank
end
end
if best < 0:
again = false
else:
merged := syms.get(best) + syms.get(best + 1)
mem.Free(syms.get(best) as void*)
mem.Free(syms.get(best + 1) as void*)
syms.set(best, merged)
_r := syms.remove_at(best + 1)
end
end
repeat syms.len() in i:
id := this.index.get_or(syms.get(i), 0 - 1)
out.push(id >= 0 ? id : this.unk)
end
_free_syms(syms)
end
func _decode_spm_piece(sb &: str.StringBuilder, t: str):
if t.len() == 6 and str.StartsWith(t, "<0x") and str.EndsWith(t, ">"):
hi := _hex_val(_byte_at(t, 3))
lo := _hex_val(_byte_at(t, 4))
if hi >= 0 and lo >= 0:
str.BufAppendChar(sb, hi * 16 + lo)
ret
end
end
n := t.len()
mut i := 0
until i < n:
marker := i + 3 <= n and _byte_at(t, i) == 0xE2 and _byte_at(t, i + 1) == 0x96 and _byte_at(t, i + 2) == 0x81
if marker:
str.BufAppendChar(sb, 32)
i += 3
else:
str.BufAppendChar(sb, _byte_at(t, i))
i += 1
end
end
end
func _decode_bpe_piece(sb &: str.StringBuilder, t: str):
n := t.len()
mut i := 0
mut cp := 0
until i < n:
i = str.CodePointAt(t, i, cp)
mut b := 0 - 1
if cp >= 0 and cp < 256 and this.b2u.get(cp) == cp:
b = cp
else cp >= 256:
repeat 256 in k:
if this.b2u.get(k) == cp: b = k end
end
end
if b >= 0: str.BufAppendChar(sb, b) end
end
end
end
func _bpe_b2u(): Vector<int>:
mut t := Vector {} as Vector<int>
mut next := 256
repeat 256 in b:
printable := (b >= 33 and b <= 126) or (b >= 161 and b <= 172) or (b >= 174 and b <= 255)
if printable:
t.push(b)
else:
t.push(next)
next += 1
end
end
ret t
end
func _byte_at(s: str, i: int): int:
p := (s as void*) as i8*
ret (p[i] as int) & 255
end
func _chars_of(s: str): Vector<str>:
mut out := Vector {} as Vector<str>
n := s.len()
mut i := 0
until i < n:
mut w := str.CharLen(_byte_at(s, i))
if i + w > n: w = n - i end
out.push(s.substr(i, w))
i += w
end
ret out
end
func _join_pair(a: str, b: str): str:
mut sb := str.NewBuilder()
str.BufAppend(sb, a)
str.BufAppendChar(sb, 32)
str.BufAppend(sb, b)
r := str.BufStr(sb)
str.BufFree(sb)
ret r
end
func _free_syms(syms &: Vector<str>):
repeat syms.len() in i: mem.Free(syms.get(i) as void*) end
syms.free()
end
func _hex_digit(v: int): int:
if v < 10: ret 48 + v end
ret 65 + v - 10
end
func _hex_val(c: int): int:
if c >= 48 and c <= 57: ret c - 48 end
if c >= 65 and c <= 70: ret c - 55 end
if c >= 97 and c <= 102: ret c - 87 end
ret 0 - 1
end
func _byte_token_text(b: int): str:
mut sb := str.NewBuilder()
str.BufAppend(sb, "<0x")
str.BufAppendChar(sb, _hex_digit(b >> 4))
str.BufAppendChar(sb, _hex_digit(b & 15))
str.BufAppend(sb, ">")
out := str.BufStr(sb)
str.BufFree(sb)
ret out
end
@en "NewTokenizer"
@fa "توکن‌ساز جدید"
pub func NewTokenizer(kind: int): Tokenizer:
mut t := Tokenizer {}
t.kind = kind
ret t
end
