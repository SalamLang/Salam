// Flat merge of the salam/interp port (see salam/PORTING.md "Layout — FLAT"):
// compiler/src/interp/ — one package `interp`, one file. Import alias for
// consumers: `ip`. The module is ported by TWO sequential agents INTO THIS
// ONE FILE (the evaluator is mutually recursive with the statement executor):
//
//   A (THIS STAGE, DONE): interp.h/value.h/interp_internal.h (state, value
//     representation), interp.c (environments/scopes, decl collection,
//     module wiring, generic-env fixup, entry point), interp_value.c (value
//     construction/conversion/printing, arrays/maps/structs/closures,
//     arithmetic, comparisons), interp_builtin.c (print/input, intrinsic
//     shims, builtin methods on str/array/map/iter/ptr). call_func and
//     exec_list (interp_expr.c/interp_stmt.c glue) are ALSO ported here —
//     stage B must NOT re-port them.
//   B (THIS STAGE, DONE): interp_expr.c eval() + eval_call/eval_args/
//     eval_match/do_listdir/sizeof-alignof, interp_stmt.c (exec_stmt,
//     interp_assign_to, interp_resolve_loc, interp_loc_get/set,
//     interp_match_arm, interp_find_match_arm) and interp_ffi.c
//     (call_native_extern via a NATIVE_SYMS-equivalent extern-decl table +
//     name dispatch; the C called every symbol through a cast
//     int64(*)(int64 x8) — the port declares each symbol with its
//     std-compatible signature and marshals the same i64 argument bits).
//     `link` directives are ignored exactly like the C (collect_decls has
//     no AST_LINK case; native symbols come from the fixed table only).
//
// C -> Salam decisions for this module (stage B must inherit these):
// - value_t stays a small COPY-BY-VALUE struct (`Value`); heap kinds carry an
//   integer handle (`id`) into a per-kind pool on Interp:
//     VAL_ARRAY -> Interp.arrs (Arr), VAL_MAP -> Interp.maps (SMap),
//     VAL_MAPITER -> Interp.iters, VAL_STRUCT -> Interp.sts (SStruct),
//     VAL_FUNC -> Interp.clos (Closure), VAL_MODULE -> Interp.mods,
//     VAL_VARIANT -> Interp.variants. Slot 0 of every pool is a sentinel
//     (= the C NULL pointer), so handle 0 means "none".
//   Copying a Value copies the handle — heap values share identity exactly
//   like the C pointer union (struct assignment aliases, value_eq on structs
//   compares ids). VAL_PTR keeps the raw address bits in `pa` (i64) plus the
//   PTR_* element kind in `pe`.
// - env_t* -> EnvId index into Interp.envs; Env keeps parallel names/vals
//   vectors. The C lazy itab index on envs (ENV_INDEX_THRESHOLD) is dropped:
//   lookup is a linear scan with identical semantics (perf-only difference,
//   same call the semantic port made for scope_t's hash index).
// - itab_t/ptab_t (interp.c) ARE ported (open addressing, FNV-1a / splitmix
//   avalanche, same growth policy). itab vals are ints with per-table
//   meaning: tab_structs/tab_enums/tab_extern_decls -> at.NodeId,
//   tab_modules -> ModId, tab_funcs -> index into Interp.fnlists (the C
//   per-name vec_t* of overloads), tab_extern_fns -> index into
//   Interp.extern_fns (the C boxed value_t*), tab_def_envs (ptab, keyed by
//   def NodeId) -> EnvId.
// - ast_node_t* -> at.NodeId ints; the Ast is threaded `a &: at.Ast` through
//   every function that touches nodes (never stored in Interp). The
//   sema_result_t is likewise threaded `sem &: sm.Sema` (only the setup path
//   needs it: build_modules/wire_imports/fixup_generic_envs).
// - arena allocation -> pool Vectors owned by Interp; Free() releases
//   everything (the C freed the arena wholesale).
// - setjmp/longjmp (rt_error) -> cooperative unwinding: rt_error/rt_fail set
//   Interp.failed/errmsg/errspan and KEEP THE FIRST error; every caller of a
//   fallible function must check `ip.failed` and bail out (Run logs
//   "runtime error ..." exactly like the C setjmp branch and returns 1).
//   STAGE B RULE: check ip.failed after eval/exec/call_* calls, and make
//   loops exit when it is set.
// - FILE *out/err -> print/io.EPrint, or capture-to-string when
//   Options.capture is set (Interp.out_text/err_text; the web wave writes
//   the captured text to its file — it passed one FILE* for both streams).
// - clock()-based timeout -> wall-clock time.NowMillis deadline (CPU-time vs
//   wall-clock is the only difference; default 5000ms like the C).
// - afmt/"%..." -> co.FormatN at call sites; rt_error messages are
//   pre-translated with i18.Tr and pre-formatted at the call site (the C
//   rt_error ran i18n_tr internally).
// - Array slices (array_view) can't share a data pointer: a view Arr stores
//   base/off/vlen and reads/writes THROUGH the base (views of views compose
//   at creation). arr_push on a view overwrites base[off+vlen] when the slot
//   exists, else appends to the base (the C wrote past the view's data
//   pointer — UB beyond the base allocation; not replicable).
// - smap_t is ported field-for-field (entries as parallel keys/vals/used
//   vectors + the uint32 open-addressed index with 0=empty/1=tomb/idx+2,
//   free_hint reuse, same rebuild thresholds) so `each` iteration order over
//   maps matches the C byte-for-byte.
// - PTR_STR ptr_load/ptr_store (reading/writing C `char*` cells) ARE ported
//   (stage B): a str's byte pointer is `(s as void*) as i64` and a char*
//   read back is `(bits as void*) as str` (the same reinterpretation
//   std/fs uses). The values ALIAS the target bytes exactly like the C.
//   One deviation: loading a NULL char* cell yields "" (the C's
//   val_str(NULL) crashed on first use). ptr addresses live in i64 (like
//   the web package's funcptr slots).
// - INTRINSICS[] function-pointer table -> k_ip_intrinsics name table (same
//   order) + an index dispatch in call_intrinsic; the platform row is
//   "SleepEx" (ms) on Windows and "usleep" (µs) elsewhere via compile-time
//   `if SALAM_OS_WINDOWS`, exactly like the C #ifdef.
package interp

import str
import io
import math
import time
import mem
import co "sal_core.salam"
import tok "token.salam"
import at "ast.salam"
import lg "logger.salam"
import i18 "i18n.salam"
import sm "semantic.salam"

// ===== interp_ffi.c NATIVE_SYMS[] extern prototypes =====
// Bodyless externs count as ORDER_IMPORT (see ast_toplevel_order_phase in
// ast.c) so they must sit here, right after the imports; native_dispatch
// (near the bottom of the private section) does the by-name call.
extern:
    func getenv(name: str): void*
    func malloc(size: u64): void*
    func realloc(ptr: void*, size: u64): void*
    func free(ptr: void*)
    func memset(ptr: void*, value: int, n: u64): void*
    func memcpy(dst: void*, src: void*, n: u64): void*
    func memmove(dst: void*, src: void*, n: u64): void*
    func remove(path: str): int
    func rename(old: str, new_path: str): int
    func fopen(path: str, mode: str): void*
    func fclose(fp: void*): int
    func fseek(fp: void*, off: int, whence: int): int
    func ftell(fp: void*): int
    func fread(ptr: void*, size: u64, nmemb: u64, stream: void*): u64
    func fwrite(ptr: void*, size: u64, nmemb: u64, stream: void*): u64
    func fgetc(stream: void*): int
    func fgets(buf: void*, n: int, fp: void*): void*
    noret func exit(code: int)
    noret func abort()
end

if SALAM_OS_WINDOWS:
    extern:
        func _mkdir(path: str): int
        func _rmdir(path: str): int
        func _chdir(path: str): int
        func GetCurrentDirectoryA(sz: int, buf: void*): int
        func GetFileAttributesA(path: str): int
        func _fseeki64(fp: void*, off: i64, whence: int): int
        func FindFirstFileA(pat: str, data: void*): void*
        func FindNextFileA(h: void*, data: void*): int
        func FindClose(h: void*): int
        func GetSystemTimeAsFileTime(ft: void*)
        func _getpid(): int
        func _popen(cmd: str, mode: str): void*
        func _pclose(fp: void*): int
    end
else:
    extern:
        func mkdir(path: str, mode: int): int
        func rmdir(path: str): int
        func chdir(path: str): int
        func access(path: str, mode: int): int
        func getcwd(buf: void*, sz: int): void*
        func opendir(path: str): void*
        func readdir(d: void*): void*
        func closedir(d: void*): int
        func fseeko(fp: void*, off: i64, whence: int): int
        func clock_gettime(clock_id: int, ts: void*): int
        func popen(cmd: str, mode: str): void*
        func pclose(fp: void*): int
        func getpid(): int
        func system(cmd: str): int
    end
end

// ===== value.h =====
// val_kind_t — order and values MUST stay identical to the C enum.
pub const VAL_NULL := 0
pub const VAL_INT := 1
pub const VAL_CHAR := 2
pub const VAL_FLOAT := 3
pub const VAL_BOOL := 4
pub const VAL_STR := 5
pub const VAL_ARRAY := 6
pub const VAL_MAP := 7
pub const VAL_MAPITER := 8
pub const VAL_STRUCT := 9
pub const VAL_FUNC := 10
pub const VAL_MODULE := 11
pub const VAL_PTR := 12
pub const VAL_VARIANT := 13

// ptr_elem_t
pub const PTR_I8 := 0
pub const PTR_U8 := 1
pub const PTR_I16 := 2
pub const PTR_U16 := 3
pub const PTR_I32 := 4
pub const PTR_U32 := 5
pub const PTR_I64 := 6
pub const PTR_U64 := 7
pub const PTR_F32 := 8
pub const PTR_F64 := 9
pub const PTR_STR := 10
pub const PTR_OPAQUE := 11

// ===== interp_internal.h =====
// flow_t
pub const FLOW_NORMAL := 0
pub const FLOW_RETURN := 1
pub const FLOW_BREAK := 2
pub const FLOW_CONTINUE := 3
pub const FLOW_MATCH_RET := 4

// iloc_kind_t
pub const ILOC_VAR := 0
pub const ILOC_FIELD := 1
pub const ILOC_ARR := 2
pub const ILOC_PTR := 3
pub const ILOC_OPIDX := 4

// #define INTERP_MAX_DEPTH 1000
pub const INTERP_MAX_DEPTH := 1000

const K_IP_INTR_COUNT := 22

// INTRINSICS[] name column (interp_builtin.c), same order as the C table.
// Index 22 is the platform sleep row (SleepEx / usleep), handled separately.
// Declared mut only because of the non-main-package const-array codegen bug
// (see salam/PORTING.md) — never reassigned.
mut k_ip_intrinsics := [
    "sqrt", "sin", "cos", "tan", "asin", "acos", "atan", "atan2",
    "log", "log10", "exp", "floor", "ceil", "fabs", "fmod", "pow",
    "strlen", "strcmp", "strtol", "strtod", "salam_input", "time"
] as str[22]

// ===== handle type aliases (all 0 = the C NULL pointer) =====
pub type EnvId = int
pub type ArrId = int
pub type MapId = int
pub type IterId = int
pub type StructId = int
pub type ClosId = int
pub type VariantId = int
pub type ModId = int

// ===== value.h (struct value) =====
// The tagged union is flattened; `id` is the per-kind pool handle (see the
// file header for the pool table). Copying a Value copies the handle only.
pub struct Value:
    pub kind: int = VAL_NULL
    pub i: i64 = 0 as i64    // VAL_INT / VAL_CHAR (codepoint)
    pub f: f64 = 0.0         // VAL_FLOAT
    pub b: bool = false      // VAL_BOOL
    pub s: str = ""          // VAL_STR
    pub id: int = 0          // ArrId/MapId/IterId/StructId/ClosId/ModId/VariantId
    pub pa: i64 = 0 as i64   // VAL_PTR address bits (sptr_t.addr)
    pub pe: int = 0          // VAL_PTR element kind (sptr_t.elem, PTR_*)
end

// struct sarray. Non-view: items owns the data, cap mirrors the C capacity
// (observable through the `.cap` builtin method). View (array_view): base is
// the (never-view) root ArrId, off/vlen give the window; items stays empty.
pub struct Arr:
    pub items: Vector<Value> = Vector {}
    pub cap: int = 0
    pub is_view: bool = false
    pub base: ArrId = 0
    pub off: int = 0
    pub vlen: int = 0
end

// struct smap. entries[] -> parallel keys/vals/used (cap = their length);
// index[] semantics identical to the C: 0 = empty, 1 = tomb, entry_idx + 2.
pub struct SMap:
    pub keys: Vector<Value> = Vector {}
    pub vals: Vector<Value> = Vector {}
    pub used: Vector<bool> = Vector {}
    pub count: int = 0
    pub cap: int = 0
    pub index: Vector<int> = Vector {}
    pub index_cap: int = 0
    pub index_used: int = 0
    pub free_hint: int = 0
end

// struct smapiter
pub struct SMapIter:
    pub map: MapId = 0
    pub idx: int = 0
end

// struct sstruct (fields[] -> parallel fnames/fvals; def is the AST_STRUCT_DEF)
pub struct SStruct:
    pub type_name: str = ""
    pub def: int = 0 // at.NodeId
    pub fnames: Vector<str> = Vector {}
    pub fvals: Vector<Value> = Vector {}
end

// struct sclosure
pub struct Closure:
    pub fn: int = 0 // at.NodeId of the AST_FUNC_DEF / extern decl
    pub env: EnvId = 0
end

// struct svariant (boxed value_t* -> inline Value + has_boxed flag)
pub struct SVariant:
    pub tag: int = 0
    pub has_boxed: bool = false
    pub boxed: Value = Value {}
end

// struct env (bindings vec of binding_t* -> parallel names/vals; the lazy
// itab index is dropped — see the file header).
pub struct Env:
    pub parent: EnvId = 0
    pub names: Vector<str> = Vector {}
    pub vals: Vector<Value> = Vector {}
end

// struct module
pub struct Module:
    pub name: str = ""
    pub env: EnvId = 0
end

// One overload list of tab_funcs (the C per-name vec_t*).
pub struct FuncList:
    pub nodes: Vector<int> = Vector {} // at.NodeIds of AST_FUNC_DEF
end

// itab_t — string-keyed open-addressed table ("" = empty slot, val 0 = miss).
pub struct Itab:
    pub keys: Vector<str> = Vector {}
    pub vals: Vector<int> = Vector {}
    pub cap: int = 0
    pub count: int = 0
end

// ptab_t — int-keyed (NodeId) open-addressed table (key 0 = empty slot).
pub struct Ptab:
    pub keys: Vector<int> = Vector {}
    pub vals: Vector<int> = Vector {}
    pub cap: int = 0
    pub count: int = 0
end

// frame_t (defer_t vec -> parallel stmt/env vectors)
pub struct Frame:
    pub defer_stmts: Vector<int> = Vector {} // at.NodeIds
    pub defer_envs: Vector<int> = Vector {}  // EnvIds
end

// iloc_t. binding_t *b -> (env, slot); sarray_t* -> ArrId; sptr_t -> pa/pe.
pub struct Loc:
    pub kind: int = ILOC_VAR
    pub target: int = 0    // at.NodeId
    pub env: EnvId = 0     // ILOC_VAR
    pub slot: int = 0      // ILOC_VAR (binding index inside env)
    pub obj: Value = Value {}  // ILOC_FIELD / ILOC_OPIDX: the struct value
    pub field_idx: int = 0     // ILOC_FIELD
    pub arr: ArrId = 0         // ILOC_ARR
    pub idx: i64 = 0 as i64    // ILOC_ARR / ILOC_PTR
    pub pa: i64 = 0 as i64     // ILOC_PTR address bits
    pub pe: int = 0            // ILOC_PTR element kind
    pub key: Value = Value {}  // ILOC_OPIDX
    pub get_m: int = 0         // ILOC_OPIDX (at.NodeId)
    pub set_m: int = 0         // ILOC_OPIDX (at.NodeId)
end

// interp_options_t. FILE *out/err -> capture flag (see file header);
// input_data's C NULL vs "" distinction -> has_input.
pub struct Options:
    pub capture: bool = false
    pub has_input: bool = false
    pub input_data: str = ""
    pub lang: str = "en"
    pub timeout_ms: int = 0
end

// interp_t. Always create through New() — a bare `Interp {}` has no pool
// sentinels. See the file header for every representation change.
pub struct Interp:
    pub log: lg.Logger = lg.New(2, false)
    pub entry: str = ""
    pub lang: str = "en"
    // output sinks (FILE *out/err):
    pub capture: bool = false
    pub out_text: str = ""
    pub err_text: str = ""
    // scripted input (in_data/in_pos):
    pub in_has: bool = false
    pub in_data: str = ""
    pub in_pos: int = 0
    pub globals: EnvId = 0
    // pools (slot 0 = sentinel = C NULL):
    pub envs: Vector<Env> = Vector {}
    pub arrs: Vector<Arr> = Vector {}
    pub maps: Vector<SMap> = Vector {}
    pub iters: Vector<SMapIter> = Vector {}
    pub sts: Vector<SStruct> = Vector {}
    pub clos: Vector<Closure> = Vector {}
    pub variants: Vector<SVariant> = Vector {}
    pub mods: Vector<Module> = Vector {}
    pub fnlists: Vector<FuncList> = Vector {}
    // decl registries (at.NodeIds), mirroring the C vec_t fields:
    pub funcs: Vector<int> = Vector {}
    pub structs: Vector<int> = Vector {}
    pub enums: Vector<int> = Vector {}
    pub impls: Vector<int> = Vector {}
    pub extern_fns: Vector<Value> = Vector {}   // boxed closures (slot 0 sentinel)
    pub extern_decls: Vector<int> = Vector {}
    pub def_env_defs: Vector<int> = Vector {}   // vec def_envs (parallel)
    pub def_env_envs: Vector<int> = Vector {}
    // lookup tables:
    pub tab_funcs: Itab = Itab {}
    pub tab_structs: Itab = Itab {}
    pub tab_enums: Itab = Itab {}
    pub tab_modules: Itab = Itab {}
    pub tab_extern_fns: Itab = Itab {}
    pub tab_extern_decls: Itab = Itab {}
    pub tab_def_envs: Ptab = Ptab {}
    // jmp_buf on_error/errmsg/errspan -> cooperative error state:
    pub failed: bool = false
    pub errmsg: str = ""
    pub errspan: co.SrcSpan = co.EmptySpan()
    pub have_errspan: bool = false
    // steps/deadline/depth/match_expr_depth/pending_flow:
    pub steps: u64 = 0 as u64
    pub deadline_ms: i64 = 0 as i64 // 0 = no deadline
    pub depth: int = 0
    pub match_expr_depth: int = 0
    pub pending_flow: int = FLOW_NORMAL
end

// ---------------------------------------------------------------------------
// Low-level shared helpers (no direct C equivalent).
// ---------------------------------------------------------------------------

// Unsigned byte read from a str (same idiom as the other ports).
func byte_at(s: str, i: int): int:
    bp := (s as void*) as i8*
    mut v := bp[i] as int
    if v < 0:
        v += 256
    end
    ret v
end

// &node->span — rebuild a co.SrcSpan from the node's inlined span fields.
func span_of(a &: at.Ast, id: int): co.SrcSpan:
    n := at.Get(a, id)
    ret co.MakeSpan(co.MakePos(n.begin_line, n.begin_col, n.begin_index),
                    co.MakePos(n.end_line, n.end_col, n.end_index), n.length)
end

// C-locale isspace (strtol's whitespace skip).
func is_c_space(c: int): bool:
    ret c == 32 || (c >= 9 && c <= 13)
end

// Bit pattern of a double (the C memcpy'd into a uint64_t).
func f64_bits(d: f64): u64:
    p := mem.Allocate(8 as u64)
    dp := p as f64*
    dp[0] = d
    up := p as u64*
    bits := up[0]
    mem.Free(p)
    ret bits
end

// ===========================================================================
// ===== interp.c =====
// ===========================================================================

// rt_error with a NULL node (tick's timeout). Keeps the FIRST error, like
// the C longjmp which never came back for a second one.
func rt_fail(ip &: Interp, msg: str):
    if ip.failed:
        ret
    end
    ip.failed = true
    ip.errmsg = msg
end

// rt_error — `msg` is pre-translated/pre-formatted at the call site with
// i18.Tr + co.FormatN (the C ran i18n_tr on the format internally).
func rt_error(ip &: Interp, a &: at.Ast, n: int, msg: str):
    if ip.failed:
        ret
    end
    ip.failed = true
    ip.errmsg = msg
    if n != 0:
        ip.errspan = span_of(a, n)
        ip.have_errspan = true
    end
end

func tick(ip &: Interp):
    ip.steps = ip.steps + (1 as u64)
    if (ip.steps & (0xFFFFF as u64)) == (0 as u64) && ip.deadline_ms != (0 as i64) &&
       time.NowMillis() > ip.deadline_ms:
        rt_fail(ip, i18.Tr("execution timed out (possible infinite loop)"))
    end
end

// itab_hash — FNV-1a.
func itab_hash(s: str): u64:
    mut h := 1469598103934665603 as u64
    n := str.Len(s)
    repeat n with i:
        h = h ^ (byte_at(s, i) as u64)
        h = h * (1099511628211 as u64)
    end
    ret h
end

// ptab_hash — splitmix-style avalanche of the (former pointer) key.
func ptab_hash(k: int): u64:
    mut x := k as u64
    x = x ^ (x >> (33 as u64))
    x = x * (0xff51afd7ed558ccd as u64)
    x = x ^ (x >> (33 as u64))
    ret x
end

func itab_grow(t &: Itab, want: int):
    ok := t.keys
    ov := t.vals
    oc := t.cap
    mut nc := 16
    until nc < want * 2:
        nc *= 2
    end
    mut nk := Vector {} as Vector<str>
    mut nv := Vector {} as Vector<int>
    repeat nc:
        nk.push("")
        nv.push(0)
    end
    t.keys = nk
    t.vals = nv
    t.cap = nc
    mask := nc - 1
    repeat oc with i:
        k := ok.get(i)[0]
        if str.Len(k) == 0:
            continue
        end
        mut j := (itab_hash(k) & (mask as u64)) as int
        until str.Len(t.keys.get(j)[0]) != 0:
            j = (j + 1) & mask
        end
        t.keys.set(j, k)
        t.vals.set(j, ov.get(i)[0])
    end
    ok.free()
    ov.free()
end

// Returns the stored val, 0 when absent (the C returned NULL; no table
// stores 0 — every handle/NodeId val is >= 1).
func itab_get(t: Itab, key: str): int:
    if t.cap == 0:
        ret 0
    end
    mask := t.cap - 1
    mut i := (itab_hash(key) & (mask as u64)) as int
    until str.Len(t.keys.get(i)[0]) != 0:
        if str.Equals(t.keys.get(i)[0], key):
            ret t.vals.get(i)[0]
        end
        i = (i + 1) & mask
    end
    ret 0
end

// First put wins (the C itab_put returned without overwriting).
func itab_put(t &: Itab, key: str, val: int):
    if (t.count + 1) * 4 >= t.cap * 3:
        itab_grow(t, t.count + 1)
    end
    mask := t.cap - 1
    mut i := (itab_hash(key) & (mask as u64)) as int
    until str.Len(t.keys.get(i)[0]) != 0:
        if str.Equals(t.keys.get(i)[0], key):
            ret
        end
        i = (i + 1) & mask
    end
    t.keys.set(i, key)
    t.vals.set(i, val)
    t.count += 1
end

func ptab_get(t: Ptab, key: int): int:
    if t.cap == 0:
        ret 0
    end
    mask := t.cap - 1
    mut i := (ptab_hash(key) & (mask as u64)) as int
    until t.keys.get(i)[0] != 0:
        if t.keys.get(i)[0] == key:
            ret t.vals.get(i)[0]
        end
        i = (i + 1) & mask
    end
    ret 0
end

func ptab_put(t &: Ptab, key: int, val: int):
    if (t.count + 1) * 4 >= t.cap * 3:
        ok := t.keys
        ov := t.vals
        oc := t.cap
        mut nc := 16
        until nc < (t.count + 1) * 2:
            nc *= 2
        end
        mut nk := Vector {} as Vector<int>
        mut nv := Vector {} as Vector<int>
        repeat nc:
            nk.push(0)
            nv.push(0)
        end
        t.keys = nk
        t.vals = nv
        t.cap = nc
        m2 := nc - 1
        repeat oc with i0:
            k0 := ok.get(i0)[0]
            if k0 == 0:
                continue
            end
            mut j := (ptab_hash(k0) & (m2 as u64)) as int
            until t.keys.get(j)[0] != 0:
                j = (j + 1) & m2
            end
            t.keys.set(j, k0)
            t.vals.set(j, ov.get(i0)[0])
        end
        ok.free()
        ov.free()
    end
    mask := t.cap - 1
    mut i := (ptab_hash(key) & (mask as u64)) as int
    until t.keys.get(i)[0] != 0:
        if t.keys.get(i)[0] == key:
            ret
        end
        i = (i + 1) & mask
    end
    t.keys.set(i, key)
    t.vals.set(i, val)
    t.count += 1
end

func env_new(ip &: Interp, parent: int): int:
    id := ip.envs.len()
    ip.envs.push(Env { parent = parent })
    ret id
end

// env_find_local — binding slot index inside `e`, -1 when absent.
func env_find_local(ip &: Interp, e: int, name: str): int:
    en := ip.envs.get(e)[0]
    repeat en.names.len() with i:
        if str.Equals(en.names.get(i)[0], name):
            ret i
        end
    end
    ret 0 - 1
end

// env_find — walks the parent chain; returns the slot and stores the owning
// EnvId in `where` (-1/0 when absent). The C returned the binding pointer.
func env_find(ip &: Interp, e0: int, name: str, where &: int): int:
    mut e := e0
    until e != 0:
        slot := env_find_local(ip, e, name)
        if slot >= 0:
            where = e
            ret slot
        end
        en := ip.envs.get(e)[0]
        e = en.parent
    end
    where = 0
    ret 0 - 1
end

func env_slot_val(ip &: Interp, e: int, slot: int): Value:
    en := ip.envs.get(e)[0]
    ret en.vals.get(slot)[0]
end

func env_slot_set(ip &: Interp, e: int, slot: int, v: Value):
    mut en := ip.envs.get(e)[0]
    en.vals.set(slot, v)
    ip.envs.set(e, en)
end

func env_define(ip &: Interp, e: int, name: str, v: Value):
    slot := env_find_local(ip, e, name)
    if slot >= 0:
        env_slot_set(ip, e, slot, v)
        ret
    end
    mut en := ip.envs.get(e)[0]
    en.names.push(name)
    en.vals.push(v)
    ip.envs.set(e, en)
end

func find_struct(ip &: Interp, name: str): int:
    ret itab_get(ip.tab_structs, name)
end

func find_enum(ip &: Interp, name: str): int:
    ret itab_get(ip.tab_enums, name)
end

func register_func(ip &: Interp, a &: at.Ast, f: int):
    ip.funcs.push(f)
    fn := at.Get(a, f)
    if str.Len(fn.name) == 0:
        ret
    end
    mut li := itab_get(ip.tab_funcs, fn.name)
    if li == 0:
        li = ip.fnlists.len()
        ip.fnlists.push(FuncList {})
        mut t := ip.tab_funcs
        itab_put(t, fn.name, li)
        ip.tab_funcs = t
    end
    mut fl := ip.fnlists.get(li)[0]
    fl.nodes.push(f)
    ip.fnlists.set(li, fl)
end

// find_func — exact param-count match, else the first overload. Call with
// nargs = -1 (the C passed (size_t)-1) to take the first one (entry lookup).
func find_func(ip &: Interp, a &: at.Ast, name: str, nargs: int): int:
    li := itab_get(ip.tab_funcs, name)
    if li == 0:
        ret 0
    end
    fl := ip.fnlists.get(li)[0]
    if fl.nodes.len() == 0:
        ret 0
    end
    repeat fl.nodes.len() with i:
        f := fl.nodes.get(i)[0]
        if at.ChildCount(a, f) == nargs:
            ret f
        end
    end
    ret fl.nodes.get(0)[0]
end

func find_module(ip &: Interp, name: str): int:
    ret itab_get(ip.tab_modules, name)
end

// find_extern_fn — index into ip.extern_fns (0 = none; the C returned the
// boxed value_t*).
func find_extern_fn(ip &: Interp, name: str): int:
    ret itab_get(ip.tab_extern_fns, name)
end

func find_extern_decl(ip &: Interp, name: str): int:
    ret itab_get(ip.tab_extern_decls, name)
end

func struct_method(a &: at.Ast, sdef: int, name: str): int:
    repeat at.ChildCount(a, sdef) with i:
        m := at.Child(a, sdef, i)
        mn := at.Get(a, m)
        if mn.kind == at.AST_FUNC_DEF && str.Len(mn.name) != 0 &&
           str.Equals(mn.name, name):
            ret m
        end
    end
    ret 0
end

func struct_method_arity(a &: at.Ast, sdef: int, name: str, nparams: int): int:
    repeat at.ChildCount(a, sdef) with i:
        m := at.Child(a, sdef, i)
        mn := at.Get(a, m)
        if mn.kind == at.AST_FUNC_DEF && str.Len(mn.name) != 0 &&
           str.Equals(mn.name, name) && mn.list.len() == nparams:
            ret m
        end
    end
    ret 0
end

func find_impl_method(ip &: Interp, a &: at.Ast, typestr: str, method: str,
                      nargs: int): int:
    if str.Len(typestr) == 0:
        ret 0
    end
    repeat ip.impls.len() with i:
        d := ip.impls.get(i)[0]
        dn := at.Get(a, d)
        if dn.ty == 0:
            continue
        end
        tn := at.Get(a, dn.ty)
        if !str.Equals(tn.type_str, typestr):
            continue
        end
        mut m := struct_method_arity(a, d, method, nargs)
        if m == 0:
            m = struct_method(a, d, method)
        end
        if m != 0:
            ret m
        end
    end
    ret 0
end

func register_def_env_one(ip &: Interp, def: int, env: int):
    ip.def_env_defs.push(def)
    ip.def_env_envs.push(env)
    mut t := ip.tab_def_envs
    ptab_put(t, def, env)
    ip.tab_def_envs = t
end

func register_method_envs(ip &: Interp, a &: at.Ast, def: int, env: int):
    register_def_env_one(ip, def, env)
    repeat at.ChildCount(a, def) with i:
        m := at.Child(a, def, i)
        if at.KindOf(a, m) != at.AST_FUNC_DEF:
            continue
        end
        register_def_env_one(ip, m, env)
    end
end

func find_def_env(ip &: Interp, def: int): int:
    ret ptab_get(ip.tab_def_envs, def)
end

func register_extern_decl(ip &: Interp, a &: at.Ast, env: int, d: int):
    dn := at.Get(a, d)
    if dn.a != 0:
        cl := mk_closure(ip, d, env)
        idx := ip.extern_fns.len()
        ip.extern_fns.push(cl)
        if str.Len(dn.name) != 0:
            mut t := ip.tab_extern_fns
            itab_put(t, dn.name, idx)
            ip.tab_extern_fns = t
        end
        if str.Len(dn.name) != 0 && env_find_local(ip, env, dn.name) < 0:
            env_define(ip, env, dn.name, cl)
        end
    else:
        ip.extern_decls.push(d)
        if str.Len(dn.name) != 0:
            mut t2 := ip.tab_extern_decls
            itab_put(t2, dn.name, d)
            ip.tab_extern_decls = t2
        end
    end
end

func collect_decls(ip &: Interp, a &: at.Ast, program: int):
    repeat at.ChildCount(a, program) with i:
        d := at.Child(a, program, i)
        dn := at.Get(a, d)
        if dn.kind == at.AST_FUNC_DEF:
            if dn.is_extern:
                register_extern_decl(ip, a, ip.globals, d)
            else:
                register_func(ip, a, d)
            end
        else dn.kind == at.AST_STRUCT_DEF:
            ip.structs.push(d)
            if str.Len(dn.name) != 0:
                mut t := ip.tab_structs
                itab_put(t, dn.name, d)
                ip.tab_structs = t
            end
            if !dn.synthetic:
                register_method_envs(ip, a, d, ip.globals)
            end
        else dn.kind == at.AST_ENUM_DEF:
            ip.enums.push(d)
            if str.Len(dn.name) != 0:
                mut t2 := ip.tab_enums
                itab_put(t2, dn.name, d)
                ip.tab_enums = t2
            end
        else dn.kind == at.AST_IMPL_DEF:
            ip.impls.push(d)
            if !dn.synthetic:
                register_method_envs(ip, a, d, ip.globals)
            end
        else dn.kind == at.AST_CONST_DECL || dn.kind == at.AST_VAR_DECL:
            v := dn.a != 0 ? eval(ip, a, ip.globals, dn.a) : val_null()
            env_define(ip, ip.globals, dn.name, v)
            if ip.failed:
                ret
            end
        end
    end
    repeat ip.funcs.len() with j:
        f := ip.funcs.get(j)[0]
        fn := at.Get(a, f)
        if str.Len(fn.name) != 0 && env_find_local(ip, ip.globals, fn.name) < 0:
            env_define(ip, ip.globals, fn.name, mk_closure(ip, f, ip.globals))
        end
    end
end

func collect_module_funcs(ip &: Interp, a &: at.Ast, mid: int, prog: int):
    md := ip.mods.get(mid)[0]
    repeat at.ChildCount(a, prog) with i:
        d := at.Child(a, prog, i)
        dn := at.Get(a, d)
        if dn.kind == at.AST_FUNC_DEF:
            if dn.is_extern:
                register_extern_decl(ip, a, md.env, d)
            else str.Len(dn.name) != 0 && env_find_local(ip, md.env, dn.name) < 0:
                env_define(ip, md.env, dn.name, mk_closure(ip, d, md.env))
            end
        else dn.kind == at.AST_STRUCT_DEF:
            if find_struct(ip, dn.name) == 0:
                ip.structs.push(d)
                if str.Len(dn.name) != 0:
                    mut t := ip.tab_structs
                    itab_put(t, dn.name, d)
                    ip.tab_structs = t
                end
                if !dn.synthetic:
                    register_method_envs(ip, a, d, md.env)
                end
            end
        else dn.kind == at.AST_ENUM_DEF:
            if find_enum(ip, dn.name) == 0:
                ip.enums.push(d)
                if str.Len(dn.name) != 0:
                    mut t2 := ip.tab_enums
                    itab_put(t2, dn.name, d)
                    ip.tab_enums = t2
                end
            end
        else dn.kind == at.AST_IMPL_DEF:
            ip.impls.push(d)
            if !dn.synthetic:
                register_method_envs(ip, a, d, md.env)
            end
        end
    end
end

func wire_imports(ip &: Interp, sem &: sm.Sema, env: int, scope: int):
    if scope == 0:
        ret
    end
    sc := sm.ScopeAt(sem, scope)
    repeat sc.symbols.len() with i:
        symid := sc.symbols.get(i)[0]
        sy := sm.SymAt(sem, symid)
        if sy.kind != sm.SYM_PACKAGE || str.Len(sy.pkgname) == 0:
            continue
        end
        target := find_module(ip, sy.pkgname)
        if target != 0:
            env_define(ip, env, sy.name, val_module(target))
        end
    end
end

func eval_module_consts(ip &: Interp, a &: at.Ast, mid: int, prog: int):
    md := ip.mods.get(mid)[0]
    repeat at.ChildCount(a, prog) with i:
        d := at.Child(a, prog, i)
        dn := at.Get(a, d)
        if dn.kind == at.AST_CONST_DECL || dn.kind == at.AST_VAR_DECL:
            env_define(ip, md.env, dn.name,
                       dn.a != 0 ? eval(ip, a, md.env, dn.a) : val_null())
            if ip.failed:
                ret
            end
        end
    end
end

// Package symbol's display name (pk->pkgname ? : pk->decl->name).
func pkg_name_of(a &: at.Ast, sem &: sm.Sema, pkid: int): str:
    pk := sm.SymAt(sem, pkid)
    if str.Len(pk.pkgname) != 0:
        ret pk.pkgname
    end
    if pk.decl != 0:
        dn := at.Get(a, pk.decl)
        ret dn.name
    end
    ret ""
end

func build_modules(ip &: Interp, a &: at.Ast, sem &: sm.Sema):
    npk := sm.PackageCount(sem)
    repeat npk with i:
        pkid := sm.PackageAt(sem, i)
        pk := sm.SymAt(sem, pkid)
        name := pkg_name_of(a, sem, pkid)
        if str.Len(name) == 0 || pk.decl == 0 || find_module(ip, name) != 0:
            continue
        end
        menv := env_new(ip, 0)
        mid := ip.mods.len()
        ip.mods.push(Module { name = name, env = menv })
        mut t := ip.tab_modules
        itab_put(t, name, mid)
        ip.tab_modules = t
        collect_module_funcs(ip, a, mid, pk.decl)
    end
    repeat npk with i2:
        pkid2 := sm.PackageAt(sem, i2)
        pk2 := sm.SymAt(sem, pkid2)
        name2 := pkg_name_of(a, sem, pkid2)
        mid2 := str.Len(name2) != 0 ? find_module(ip, name2) : 0
        if mid2 != 0:
            md := ip.mods.get(mid2)[0]
            wire_imports(ip, sem, md.env, pk2.members)
        end
    end
    wire_imports(ip, sem, ip.globals, sem.global)
    repeat npk with i3:
        pkid3 := sm.PackageAt(sem, i3)
        pk3 := sm.SymAt(sem, pkid3)
        name3 := pkg_name_of(a, sem, pkid3)
        mid3 := str.Len(name3) != 0 ? find_module(ip, name3) : 0
        if mid3 != 0 && pk3.decl != 0:
            eval_module_consts(ip, a, mid3, pk3.decl)
            if ip.failed:
                ret
            end
        end
    end
end

func fixup_generic_envs_in(ip &: Interp, a &: at.Ast, sem &: sm.Sema,
                           defs: Vector<int>):
    repeat defs.len() with i:
        d := defs.get(i)[0]
        dn := at.Get(a, d)
        if !dn.synthetic || str.Len(dn.name) == 0 || find_def_env(ip, d) != 0:
            continue
        end
        symid := sm.Lookup(sem, sem.global, dn.name)
        if symid == 0:
            continue
        end
        sy := sm.SymAt(sem, symid)
        if str.Len(sy.generic_base) == 0:
            continue
        end
        repeat defs.len() with j:
            bd := defs.get(j)[0]
            if bd == d:
                continue
            end
            bn := at.Get(a, bd)
            if bn.synthetic || str.Len(bn.name) == 0:
                continue
            end
            if !str.Equals(bn.name, sy.generic_base):
                continue
            end
            base_env := find_def_env(ip, bd)
            if base_env != 0:
                register_method_envs(ip, a, d, base_env)
            end
            break
        end
    end
end

func fixup_generic_envs(ip &: Interp, a &: at.Ast, sem &: sm.Sema):
    fixup_generic_envs_in(ip, a, sem, ip.structs)
    fixup_generic_envs_in(ip, a, sem, ip.impls)
end

// The C interp_run's setjmp branch (runtime-error report), shared by Run.
func run_fail(ip &: Interp): int:
    if ip.have_errspan:
        lg.Log(ip.log, lg.PH_DRIVER, lg.LOG_ERROR,
               co.Format2(i18.Tr("runtime error at line %u: %s"),
                          co.ArgUint(ip.errspan.begin.line as u64),
                          co.ArgStr(ip.errmsg)))
    else:
        lg.Log(ip.log, lg.PH_DRIVER, lg.LOG_ERROR,
               co.Format1(i18.Tr("runtime error: %s"), co.ArgStr(ip.errmsg)))
    end
    ret 1
end

// ===========================================================================
// ===== interp_value.c =====
// ===========================================================================

// value.h constructors (SAL_INLINE val_*).
func val_null(): Value:
    ret Value {}
end

func val_int(x: i64): Value:
    ret Value { kind = VAL_INT, i = x }
end

func val_char(x: i64): Value:
    ret Value { kind = VAL_CHAR, i = x }
end

func val_float(x: f64): Value:
    ret Value { kind = VAL_FLOAT, f = x }
end

func val_bool(x: bool): Value:
    ret Value { kind = VAL_BOOL, b = x }
end

func val_str(s: str): Value:
    ret Value { kind = VAL_STR, s = s }
end

func val_module(m: int): Value:
    ret Value { kind = VAL_MODULE, id = m }
end

func val_ptr(addr: i64, elem: int): Value:
    ret Value { kind = VAL_PTR, pa = addr, pe = elem }
end

func val_variant(vid: int): Value:
    ret Value { kind = VAL_VARIANT, id = vid }
end

func val_arr(aid: int): Value:
    ret Value { kind = VAL_ARRAY, id = aid }
end

func val_map(mid: int): Value:
    ret Value { kind = VAL_MAP, id = mid }
end

func ptr_elem_size(elem: int): int:
    if elem == PTR_I8 || elem == PTR_U8:
        ret 1
    end
    if elem == PTR_I16 || elem == PTR_U16:
        ret 2
    end
    if elem == PTR_I32 || elem == PTR_U32 || elem == PTR_F32:
        ret 4
    end
    ret 8
end

// str_repeat — the C doubled a buffer; str.Repeat is byte-identical.
func str_repeat(s: str, n: i64): Value:
    if n == (1 as i64):
        ret val_str(s)
    end
    if n < (1 as i64) || str.Len(s) == 0:
        ret val_str("")
    end
    ret val_str(str.Repeat(s, n as int))
end

func to_bool(v: Value): bool:
    if v.kind == VAL_BOOL:
        ret v.b
    end
    if v.kind == VAL_INT || v.kind == VAL_CHAR:
        ret v.i != (0 as i64)
    end
    if v.kind == VAL_FLOAT:
        ret v.f != 0.0
    end
    if v.kind == VAL_NULL:
        ret false
    end
    if v.kind == VAL_STR:
        ret str.Len(v.s) != 0
    end
    if v.kind == VAL_PTR:
        ret v.pa != (0 as i64)
    end
    ret true
end

func to_float(v: Value): f64:
    if v.kind == VAL_FLOAT:
        ret v.f
    end
    if v.kind == VAL_INT || v.kind == VAL_CHAR:
        ret v.i as f64
    end
    if v.kind == VAL_BOOL:
        ret v.b ? 1.0 : 0.0
    end
    ret 0.0
end

func to_int(v: Value): i64:
    if v.kind == VAL_INT || v.kind == VAL_CHAR:
        ret v.i
    end
    if v.kind == VAL_FLOAT:
        ret v.f as i64
    end
    if v.kind == VAL_BOOL:
        ret v.b ? (1 as i64) : (0 as i64)
    end
    if v.kind == VAL_PTR:
        ret v.pa
    end
    ret 0 as i64
end

func is_intlike(v: Value): bool:
    ret v.kind == VAL_INT || v.kind == VAL_CHAR
end

func is_number(v: Value): bool:
    ret v.kind == VAL_INT || v.kind == VAL_CHAR || v.kind == VAL_FLOAT
end

func utf8_put(b &: str.StringBuilder, cp: i64):
    c := cp as int
    if c < 0x80:
        str.BufAppendChar(b, c)
    else c < 0x800:
        str.BufAppendChar(b, 0xC0 | (c >> 6))
        str.BufAppendChar(b, 0x80 | (c & 0x3F))
    else c < 0x10000:
        str.BufAppendChar(b, 0xE0 | (c >> 12))
        str.BufAppendChar(b, 0x80 | ((c >> 6) & 0x3F))
        str.BufAppendChar(b, 0x80 | (c & 0x3F))
    else:
        str.BufAppendChar(b, 0xF0 | (c >> 18))
        str.BufAppendChar(b, 0x80 | ((c >> 12) & 0x3F))
        str.BufAppendChar(b, 0x80 | ((c >> 6) & 0x3F))
        str.BufAppendChar(b, 0x80 | (c & 0x3F))
    end
end

// to_str — the printing format is OBSERVABLE (print/println); every branch
// must stay byte-identical to the C (%lld ints, %.15g floats, [a, b] arrays,
// Name{f=v} structs).
func to_str(ip &: Interp, v: Value): str:
    if v.kind == VAL_STR:
        ret v.s
    end
    if v.kind == VAL_INT:
        ret co.I64Toa(v.i)
    end
    if v.kind == VAL_CHAR:
        mut b := str.NewBuilder()
        utf8_put(b, v.i)
        r := str.BufStr(b)
        str.BufFree(b)
        ret r
    end
    if v.kind == VAL_BOOL:
        ret v.b ? "true" : "false"
    end
    if v.kind == VAL_NULL:
        ret "null"
    end
    if v.kind == VAL_FLOAT:
        ret co.Format1("%.15g", co.ArgFloat(v.f))
    end
    if v.kind == VAL_ARRAY:
        mut ab := str.NewBuilder()
        str.BufAppend(ab, "[")
        n := arr_len(ip, v.id)
        repeat n with i:
            if i != 0:
                str.BufAppend(ab, ", ")
            end
            str.BufAppend(ab, to_str(ip, arr_get(ip, v.id, i)))
        end
        str.BufAppend(ab, "]")
        ar := str.BufStr(ab)
        str.BufFree(ab)
        ret ar
    end
    if v.kind == VAL_STRUCT:
        stv := ip.sts.get(v.id)[0]
        mut sb := str.NewBuilder()
        str.BufAppend(sb, stv.type_name)
        str.BufAppend(sb, "{")
        repeat stv.fnames.len() with i:
            if i != 0:
                str.BufAppend(sb, ", ")
            end
            str.BufAppend(sb, stv.fnames.get(i)[0])
            str.BufAppend(sb, "=")
            str.BufAppend(sb, to_str(ip, stv.fvals.get(i)[0]))
        end
        str.BufAppend(sb, "}")
        sr := str.BufStr(sb)
        str.BufFree(sb)
        ret sr
    end
    if v.kind == VAL_MAP:
        ret "<map>"
    end
    if v.kind == VAL_MAPITER:
        ret "<mapiter>"
    end
    if v.kind == VAL_FUNC:
        ret "<func>"
    end
    if v.kind == VAL_MODULE:
        if v.id == 0:
            ret "<module>"
        end
        md := ip.mods.get(v.id)[0]
        ret co.Format1("<module %s>", co.ArgStr(md.name))
    end
    if v.kind == VAL_PTR:
        if v.pa == (0 as i64):
            ret "null"
        end
        ret co.Format1("<ptr %p>", co.ArgPtr(v.pa as u64))
    end
    if v.kind == VAL_VARIANT:
        vv := ip.variants.get(v.id)[0]
        if vv.has_boxed:
            ret to_str(ip, vv.boxed)
        end
        ret ""
    end
    ret ""
end

func arr_new(ip &: Interp, cap: int): int:
    id := ip.arrs.len()
    ip.arrs.push(Arr { cap = cap < 4 ? 4 : cap })
    ret id
end

// array_view — base+off composition happens at creation, so `base` is never
// itself a view.
func arr_view(ip &: Interp, base: int, off: int, length: int): int:
    mut b0 := base
    mut o0 := off
    bn := ip.arrs.get(base)[0]
    if bn.is_view:
        b0 = bn.base
        o0 = bn.off + off
    end
    id := ip.arrs.len()
    ip.arrs.push(Arr { is_view = true, base = b0, off = o0, vlen = length })
    ret id
end

func arr_len(ip &: Interp, id: int): int:
    an := ip.arrs.get(id)[0]
    ret an.is_view ? an.vlen : an.items.len()
end

func arr_get(ip &: Interp, id: int, i: int): Value:
    an := ip.arrs.get(id)[0]
    if an.is_view:
        bn := ip.arrs.get(an.base)[0]
        ret bn.items.get(an.off + i)[0]
    end
    ret an.items.get(i)[0]
end

func arr_set(ip &: Interp, id: int, i: int, v: Value):
    mut an := ip.arrs.get(id)[0]
    if an.is_view:
        mut bn := ip.arrs.get(an.base)[0]
        bn.items.set(an.off + i, v)
        ip.arrs.set(an.base, bn)
        ret
    end
    an.items.set(i, v)
    ip.arrs.set(id, an)
end

func arr_push(ip &: Interp, id: int, v: Value):
    mut an := ip.arrs.get(id)[0]
    if an.is_view:
        // See the file header: the C wrote past the view (UB beyond the base
        // allocation); the port writes into/onto the base instead.
        pos := an.off + an.vlen
        mut bn := ip.arrs.get(an.base)[0]
        if pos < bn.items.len():
            bn.items.set(pos, v)
        else:
            bn.items.push(v)
        end
        ip.arrs.set(an.base, bn)
        an.vlen += 1
        ip.arrs.set(id, an)
        ret
    end
    if an.items.len() == an.cap:
        an.cap = co.GrowCap(an.cap as u64, (an.items.len() + 1) as u64,
                            4 as u64) as int
    end
    an.items.push(v)
    ip.arrs.set(id, an)
end

// Drops the last element (the `pop` builtin's --a->len).
func arr_shrink(ip &: Interp, id: int):
    mut an := ip.arrs.get(id)[0]
    if an.is_view:
        an.vlen -= 1
    else:
        _last := an.items.pop()
    end
    ip.arrs.set(id, an)
end

func key_eq(ka: Value, kb: Value): bool:
    if ka.kind != kb.kind:
        ret false
    end
    if ka.kind == VAL_STR:
        ret str.Equals(ka.s, kb.s)
    end
    if ka.kind == VAL_INT || ka.kind == VAL_CHAR:
        ret ka.i == kb.i
    end
    if ka.kind == VAL_BOOL:
        ret ka.b == kb.b
    end
    if ka.kind == VAL_FLOAT:
        ret ka.f == kb.f
    end
    ret false
end

func key_hash(k: Value): u64:
    if k.kind == VAL_STR:
        ret itab_hash(k.s)
    end
    if k.kind == VAL_INT || k.kind == VAL_CHAR:
        mut x := k.i as u64
        x = x ^ (x >> (33 as u64))
        x = x * (0xff51afd7ed558ccd as u64)
        x = x ^ (x >> (33 as u64))
        ret x
    end
    if k.kind == VAL_BOOL:
        ret k.b ? (2 as u64) : (1 as u64)
    end
    if k.kind == VAL_FLOAT:
        d := k.f == 0.0 ? 0.0 : k.f
        mut bits := f64_bits(d)
        bits = bits ^ (bits >> (33 as u64))
        bits = bits * (0xff51afd7ed558ccd as u64)
        bits = bits ^ (bits >> (33 as u64))
        ret bits
    end
    ret 0 as u64
end

// MAP_SLOT_EMPTY = 0, MAP_SLOT_TOMB = 1, else entry_idx + 2.
func map_index_insert(m &: SMap, hash: u64, entry_idx: int):
    mask := m.index_cap - 1
    mut i := (hash & (mask as u64)) as int
    until true:
        s0 := m.index.get(i)[0]
        if s0 == 0 || s0 == 1:
            if s0 == 0:
                m.index_used += 1
            end
            m.index.set(i, entry_idx + 2)
            ret
        end
        i = (i + 1) & mask
    end
end

func map_index_rebuild(m &: SMap, want: int):
    mut nc := 16
    until nc < want * 2:
        nc *= 2
    end
    old := m.index
    mut ni := Vector {} as Vector<int>
    repeat nc:
        ni.push(0)
    end
    m.index = ni
    old.free()
    m.index_cap = nc
    m.index_used = 0
    mcap := m.cap
    repeat mcap with i:
        if m.used.get(i)[0]:
            map_index_insert(m, key_hash(m.keys.get(i)[0]), i)
        end
    end
end

func map_new(ip &: Interp): int:
    mut m := SMap {}
    m.cap = 8
    repeat 8:
        m.keys.push(val_null())
        m.vals.push(val_null())
        m.used.push(false)
    end
    map_index_rebuild(m, 8)
    id := ip.maps.len()
    ip.maps.push(m)
    ret id
end

// map_index_slot — the position in index[] holding this key, -1 when absent.
func map_slot_pos(m: SMap, k: Value): int:
    mask := m.index_cap - 1
    mut i := (key_hash(k) & (mask as u64)) as int
    until true:
        s0 := m.index.get(i)[0]
        if s0 == 0:
            ret 0 - 1
        end
        if s0 != 1:
            ei := s0 - 2
            if m.used.get(ei)[0] && key_eq(m.keys.get(ei)[0], k):
                ret i
            end
        end
        i = (i + 1) & mask
    end
end

// map_find — entry index, -1 when absent (the C returned the entry pointer).
func map_find(m: SMap, k: Value): int:
    pos := map_slot_pos(m, k)
    if pos < 0:
        ret 0 - 1
    end
    ret m.index.get(pos)[0] - 2
end

func map_put(ip &: Interp, mid: int, k: Value, v: Value):
    mut m := ip.maps.get(mid)[0]
    e := map_find(m, k)
    if e >= 0:
        m.vals.set(e, v)
        ip.maps.set(mid, m)
        ret
    end
    if m.count + 1 > m.cap:
        nc := co.GrowCap(m.cap as u64, (m.count + 1) as u64, 8 as u64) as int
        until m.cap < nc:
            m.keys.push(val_null())
            m.vals.push(val_null())
            m.used.push(false)
            m.cap += 1
        end
    end
    mut i := m.free_hint
    until i < m.cap && m.used.get(i)[0]:
        i += 1
    end
    m.keys.set(i, k)
    m.vals.set(i, v)
    m.used.set(i, true)
    m.count += 1
    m.free_hint = i + 1
    if (m.index_used + 1) * 4 >= m.index_cap * 3:
        map_index_rebuild(m, m.count)
    else:
        map_index_insert(m, key_hash(k), i)
    end
    ip.maps.set(mid, m)
end

func map_remove(ip &: Interp, mid: int, k: Value): bool:
    mut m := ip.maps.get(mid)[0]
    pos := map_slot_pos(m, k)
    if pos < 0:
        ret false
    end
    ei := m.index.get(pos)[0] - 2
    m.used.set(ei, false)
    m.count -= 1
    if ei < m.free_hint:
        m.free_hint = ei
    end
    m.index.set(pos, 1)
    ip.maps.set(mid, m)
    ret true
end

// mk_struct — fields are preallocated ("", null) and filled by index later
// (st_field_set), exactly like the C's uninitialized sfield_t array.
func mk_struct(ip &: Interp, name: str, def: int, nfields: int): Value:
    mut s := SStruct { type_name = name, def = def }
    repeat nfields:
        s.fnames.push("")
        s.fvals.push(val_null())
    end
    id := ip.sts.len()
    ip.sts.push(s)
    ret Value { kind = VAL_STRUCT, id = id }
end

func st_field_set(ip &: Interp, sid: int, i: int, name: str, v: Value):
    mut s := ip.sts.get(sid)[0]
    s.fnames.set(i, name)
    s.fvals.set(i, v)
    ip.sts.set(sid, s)
end

func st_field_set_val(ip &: Interp, sid: int, i: int, v: Value):
    mut s := ip.sts.get(sid)[0]
    s.fvals.set(i, v)
    ip.sts.set(sid, s)
end

func st_find_field(ip &: Interp, sid: int, name: str): int:
    s := ip.sts.get(sid)[0]
    repeat s.fnames.len() with i:
        if str.Equals(s.fnames.get(i)[0], name):
            ret i
        end
    end
    ret 0 - 1
end

func mk_closure(ip &: Interp, fnnode: int, env: int): Value:
    id := ip.clos.len()
    ip.clos.push(Closure { fn = fnnode, env = env })
    ret Value { kind = VAL_FUNC, id = id }
end

func mk_variant(ip &: Interp, tag: int, has_boxed: bool, boxed: Value): Value:
    id := ip.variants.len()
    ip.variants.push(SVariant { tag = tag, has_boxed = has_boxed, boxed = boxed })
    ret val_variant(id)
end

// base_typename — prefix before '<' '[' '*' ' ', clamped at 95 chars like
// the C's char[96] buffer.
func base_typename(ts: str): str:
    n := str.Len(ts)
    mut b := str.NewBuilder()
    mut i := 0
    until i < n && i < 95:
        c := byte_at(ts, i)
        if c == 60 || c == 91 || c == 42 || c == 32:
            break
        end
        str.BufAppendChar(b, c)
        i += 1
    end
    r := str.BufStr(b)
    str.BufFree(b)
    ret r
end

func ptr_elem_from_typestr(ts: str): int:
    base := base_typename(ts)
    if str.Equals(base, "i8"):
        ret PTR_I8
    end
    if str.Equals(base, "u8") || str.Equals(base, "byte"):
        ret PTR_U8
    end
    if str.Equals(base, "i16"):
        ret PTR_I16
    end
    if str.Equals(base, "u16"):
        ret PTR_U16
    end
    if str.Equals(base, "i32"):
        ret PTR_I32
    end
    if str.Equals(base, "u32"):
        ret PTR_U32
    end
    if str.Equals(base, "i64"):
        ret PTR_I64
    end
    if str.Equals(base, "u64") || str.Equals(base, "size"):
        ret PTR_U64
    end
    if str.Equals(base, "f32"):
        ret PTR_F32
    end
    if str.Equals(base, "f64"):
        ret PTR_F64
    end
    if str.Equals(base, "str"):
        ret PTR_STR
    end
    ret PTR_OPAQUE
end

// ptr_load / ptr_store — raw typed memory access for FFI values. PTR_STR
// reinterprets the cell's pointer bits as a char* str (aliasing, like the
// C); a NULL cell loads as "" (the C's val_str(NULL) was unusable).
func ptr_load(pa: i64, elem: int, idx: i64): Value:
    if elem == PTR_I8:
        p0 := pa as i8*
        ret val_int(p0[idx] as i64)
    end
    if elem == PTR_U8:
        p1 := pa as u8*
        ret val_int(p1[idx] as i64)
    end
    if elem == PTR_I16:
        p2 := pa as i16*
        ret val_int(p2[idx] as i64)
    end
    if elem == PTR_U16:
        p3 := pa as u16*
        ret val_int(p3[idx] as i64)
    end
    if elem == PTR_I32:
        p4 := pa as i32*
        ret val_int(p4[idx] as i64)
    end
    if elem == PTR_U32:
        p5 := pa as u32*
        ret val_int(p5[idx] as i64)
    end
    if elem == PTR_I64:
        p6 := pa as i64*
        ret val_int(p6[idx])
    end
    if elem == PTR_U64:
        p7 := pa as u64*
        ret val_int(p7[idx] as i64)
    end
    if elem == PTR_F32:
        p8 := pa as f32*
        ret val_float(p8[idx] as f64)
    end
    if elem == PTR_F64:
        p9 := pa as f64*
        ret val_float(p9[idx])
    end
    if elem == PTR_STR:
        // C: val_str(((const char **)addr)[idx]) — alias the char* as a str.
        ps := pa as i64*
        bits := ps[idx]
        if bits == (0 as i64):
            ret val_str("")
        end
        sp := bits as void*
        ret val_str(sp as str)
    end
    pv := pa as i64*
    ret val_ptr(pv[idx], PTR_OPAQUE)
end

func ptr_store(pa: i64, elem: int, idx: i64, v: Value):
    if elem == PTR_I8:
        p0 := pa as i8*
        p0[idx] = to_int(v) as i8
        ret
    end
    if elem == PTR_U8:
        p1 := pa as u8*
        p1[idx] = to_int(v) as u8
        ret
    end
    if elem == PTR_I16:
        p2 := pa as i16*
        p2[idx] = to_int(v) as i16
        ret
    end
    if elem == PTR_U16:
        p3 := pa as u16*
        p3[idx] = to_int(v) as u16
        ret
    end
    if elem == PTR_I32:
        p4 := pa as i32*
        p4[idx] = to_int(v) as i32
        ret
    end
    if elem == PTR_U32:
        p5 := pa as u32*
        p5[idx] = to_int(v) as u32
        ret
    end
    if elem == PTR_I64:
        p6 := pa as i64*
        p6[idx] = to_int(v)
        ret
    end
    if elem == PTR_U64:
        p7 := pa as u64*
        p7[idx] = to_int(v) as u64
        ret
    end
    if elem == PTR_F32:
        p8 := pa as f32*
        p8[idx] = to_float(v) as f32
        ret
    end
    if elem == PTR_F64:
        p9 := pa as f64*
        p9[idx] = to_float(v)
        ret
    end
    if elem == PTR_STR:
        // C: cell = v.kind == VAL_STR ? v.as.s : "" (the value's char*).
        ps := pa as i64*
        cs := v.kind == VAL_STR ? v.s : ""
        cp := cs as void*
        ps[idx] = cp as i64
        ret
    end
    pv := pa as i64*
    pv[idx] = v.kind == VAL_PTR ? v.pa : to_int(v)
end

func is_int_typename(b0: str): bool:
    ret str.Equals(b0, "i8") || str.Equals(b0, "i16") || str.Equals(b0, "i32") ||
        str.Equals(b0, "i64") || str.Equals(b0, "u8") || str.Equals(b0, "u16") ||
        str.Equals(b0, "u32") || str.Equals(b0, "u64") || str.Equals(b0, "int") ||
        str.Equals(b0, "byte") || str.Equals(b0, "char") || str.Equals(b0, "size")
end

func is_float_typename(b0: str): bool:
    ret str.Equals(b0, "f32") || str.Equals(b0, "f64") || str.Equals(b0, "float")
end

func zero_for_base(base: str): Value:
    if is_int_typename(base):
        ret val_int(0 as i64)
    end
    if is_float_typename(base):
        ret val_float(0.0)
    end
    if str.Equals(base, "bool"):
        ret val_bool(false)
    end
    if str.Equals(base, "str"):
        ret val_str("")
    end
    ret val_null()
end

// default_for_type — zero-filled array for "T[n]" type strings, else null.
func default_for_type(ip &: Interp, ts: str): Value:
    if str.Len(ts) == 0:
        ret val_null()
    end
    lb := str.Find(ts, "[")
    if lb < 0:
        ret val_null()
    end
    mut n := 0
    mut p := lb + 1
    tn := str.Len(ts)
    until p < tn && byte_at(ts, p) != 93:
        c := byte_at(ts, p)
        if c >= 48 && c <= 57:
            n = n * 10 + (c - 48)
        end
        p += 1
    end
    zero := zero_for_base(base_typename(ts))
    aid := arr_new(ip, n > 0 ? n : 4)
    repeat n:
        arr_push(ip, aid, zero)
    end
    ret val_arr(aid)
end

// binop_method — operator-overload method name for a token kind ("" = none).
func binop_method(op: int): str:
    if op == tok.TK_PLUS:
        ret "operator_add"
    end
    if op == tok.TK_MINUS:
        ret "operator_sub"
    end
    if op == tok.TK_STAR:
        ret "operator_mul"
    end
    if op == tok.TK_SLASH:
        ret "operator_div"
    end
    if op == tok.TK_PERCENT:
        ret "operator_mod"
    end
    if op == tok.TK_POWER:
        ret "operator_pow"
    end
    if op == tok.TK_EQ:
        ret "operator_eq"
    end
    if op == tok.TK_NE:
        ret "operator_ne"
    end
    if op == tok.TK_LT:
        ret "operator_lt"
    end
    if op == tok.TK_GT:
        ret "operator_gt"
    end
    if op == tok.TK_LE:
        ret "operator_le"
    end
    if op == tok.TK_GE:
        ret "operator_ge"
    end
    ret ""
end

func compound_base(op: int): int:
    if op == tok.TK_PLUS_EQ:
        ret tok.TK_PLUS
    end
    if op == tok.TK_MINUS_EQ:
        ret tok.TK_MINUS
    end
    if op == tok.TK_STAR_EQ:
        ret tok.TK_STAR
    end
    if op == tok.TK_SLASH_EQ:
        ret tok.TK_SLASH
    end
    if op == tok.TK_PERCENT_EQ:
        ret tok.TK_PERCENT
    end
    if op == tok.TK_POWER_EQ:
        ret tok.TK_POWER
    end
    if op == tok.TK_AMP_EQ:
        ret tok.TK_AMP
    end
    if op == tok.TK_PIPE_EQ:
        ret tok.TK_PIPE
    end
    if op == tok.TK_CARET_EQ:
        ret tok.TK_CARET
    end
    if op == tok.TK_SHL_EQ:
        ret tok.TK_SHL
    end
    if op == tok.TK_SHR_EQ:
        ret tok.TK_SHR
    end
    ret tok.TK_EOF
end

func try_struct_op(ip &: Interp, a &: at.Ast, op: int, va: Value, vb: Value,
                   has_b: bool, found &: bool): Value:
    found = false
    if va.kind != VAL_STRUCT:
        ret val_null()
    end
    mname := binop_method(op)
    if str.Len(mname) == 0:
        ret val_null()
    end
    stv := ip.sts.get(va.id)[0]
    m := struct_method_arity(a, stv.def, mname, has_b ? 1 : 0)
    if m == 0 && op == tok.TK_NE:
        eqm := struct_method_arity(a, stv.def, "operator_eq", 1)
        if eqm != 0:
            denv := find_def_env(ip, eqm)
            found = true
            mut args1 := Vector {} as Vector<Value>
            args1.push(vb)
            r := call_func(ip, a, eqm, denv != 0 ? denv : ip.globals, true, va,
                           args1)
            args1.free()
            ret val_bool(!to_bool(r))
        end
    end
    if m == 0:
        ret val_null()
    end
    found = true
    denv2 := find_def_env(ip, m)
    mut args2 := Vector {} as Vector<Value>
    if has_b:
        args2.push(vb)
    end
    r2 := call_func(ip, a, m, denv2 != 0 ? denv2 : ip.globals, true, va, args2)
    args2.free()
    ret r2
end

func arith(ip &: Interp, a &: at.Ast, n: int, op: int, x: Value, y: Value): Value:
    if op == tok.TK_PLUS && (x.kind == VAL_STR || y.kind == VAL_STR):
        ret val_str(to_str(ip, x) + to_str(ip, y))
    end
    if op == tok.TK_STAR && (x.kind == VAL_STR || y.kind == VAL_STR):
        x_str := x.kind == VAL_STR
        sv := x_str ? x : y
        nv := x_str ? y : x
        ret str_repeat(sv.s, to_int(nv))
    end
    if op == tok.TK_POWER:
        r := math.Pow(to_float(x), to_float(y))
        if x.kind == VAL_INT && y.kind == VAL_INT && r == math.Floor(r) &&
           math.Abs(r) < 9200000000000000000.0:
            ret val_int(r as i64)
        end
        ret val_float(r)
    end
    if is_intlike(x) && is_intlike(y):
        xi := x.i
        yi := y.i
        negone := (0 as i64) - (1 as i64)
        // INT64_MIN (a literal-lhs 1<<63 would be const-folded at 32 bits)
        imin := (0x8000000000000000 as u64) as i64
        if op == tok.TK_PLUS:
            ret val_int(((xi as u64) + (yi as u64)) as i64)
        end
        if op == tok.TK_MINUS:
            ret val_int(((xi as u64) - (yi as u64)) as i64)
        end
        if op == tok.TK_STAR:
            ret val_int(((xi as u64) * (yi as u64)) as i64)
        end
        if op == tok.TK_SLASH:
            if yi == (0 as i64):
                rt_error(ip, a, n, i18.Tr("division by zero"))
                ret val_null()
            end
            if xi == imin && yi == negone:
                ret val_int(imin)
            end
            ret val_int(xi / yi)
        end
        if op == tok.TK_PERCENT:
            if yi == (0 as i64):
                rt_error(ip, a, n, i18.Tr("modulo by zero"))
                ret val_null()
            end
            if xi == imin && yi == negone:
                ret val_int(0 as i64)
            end
            ret val_int(xi % yi)
        end
        if op == tok.TK_AMP:
            ret val_int(((xi as u64) & (yi as u64)) as i64)
        end
        if op == tok.TK_PIPE:
            ret val_int(((xi as u64) | (yi as u64)) as i64)
        end
        if op == tok.TK_CARET:
            ret val_int(((xi as u64) ^ (yi as u64)) as i64)
        end
        if op == tok.TK_SHL:
            ret val_int(((xi as u64) << ((yi as u64) & (63 as u64))) as i64)
        end
        if op == tok.TK_SHR:
            ret val_int(xi >> ((((yi as u64) & (63 as u64))) as i64))
        end
    end
    xf := to_float(x)
    yf := to_float(y)
    if op == tok.TK_PLUS:
        ret val_float(xf + yf)
    end
    if op == tok.TK_MINUS:
        ret val_float(xf - yf)
    end
    if op == tok.TK_STAR:
        ret val_float(xf * yf)
    end
    if op == tok.TK_SLASH:
        if yf == 0.0:
            rt_error(ip, a, n, i18.Tr("division by zero"))
            ret val_null()
        end
        ret val_float(xf / yf)
    end
    if op == tok.TK_PERCENT:
        if yf == 0.0:
            rt_error(ip, a, n, i18.Tr("modulo by zero"))
            ret val_null()
        end
        ret val_float(math.Mod(xf, yf))
    end
    rt_error(ip, a, n, i18.Tr("unsupported arithmetic operator"))
    ret val_null()
end

func value_cmp(x: Value, y: Value): int:
    if x.kind == VAL_STR && y.kind == VAL_STR:
        c := str.Compare(x.s, y.s)
        ret c < 0 ? (0 - 1) : (c > 0 ? 1 : 0)
    end
    xf := to_float(x)
    yf := to_float(y)
    ret xf < yf ? (0 - 1) : (xf > yf ? 1 : 0)
end

func value_eq(x: Value, y: Value): bool:
    if x.kind == VAL_STR && y.kind == VAL_STR:
        ret str.Equals(x.s, y.s)
    end
    if x.kind == VAL_PTR && y.kind == VAL_PTR:
        ret x.pa == y.pa
    end
    if x.kind == VAL_PTR && y.kind == VAL_NULL:
        ret x.pa == (0 as i64)
    end
    if x.kind == VAL_NULL && y.kind == VAL_PTR:
        ret y.pa == (0 as i64)
    end
    if x.kind == VAL_NULL || y.kind == VAL_NULL:
        ret x.kind == y.kind
    end
    if x.kind == VAL_BOOL || y.kind == VAL_BOOL:
        ret to_bool(x) == to_bool(y)
    end
    if is_number(x) && is_number(y):
        ret to_float(x) == to_float(y)
    end
    if x.kind == VAL_STRUCT && y.kind == VAL_STRUCT:
        ret x.id == y.id
    end
    ret false
end

// ===========================================================================
// ===== interp_builtin.c =====
// ===========================================================================

func bstr_trim(s: str): str:
    n := str.Len(s)
    mut st := 0
    until st < n && is_trim_ws(byte_at(s, st)):
        st += 1
    end
    mut en := n
    until en > st && is_trim_ws(byte_at(s, en - 1)):
        en -= 1
    end
    ret str.Substr(s, st, en - st)
end

func is_trim_ws(c: int): bool:
    ret c == 32 || c == 9 || c == 10 || c == 13
end

func bstr_substr(s: str, start: i64, length: i64): str:
    n := str.Len(s) as i64
    mut st := start
    if st < (0 as i64):
        st = 0 as i64
    end
    if st > n:
        st = n
    end
    mut l := length
    if l < (0 as i64):
        l = 0 as i64
    end
    if l > n - st:
        l = n - st
    end
    ret str.Substr(s, st as int, l as int)
end

func bstr_upper(s: str): str:
    n := str.Len(s)
    mut b := str.NewBuilder()
    repeat n with i:
        c := byte_at(s, i)
        str.BufAppendChar(b, c >= 97 && c <= 122 ? c - 32 : c)
    end
    r := str.BufStr(b)
    str.BufFree(b)
    ret r
end

func bstr_lower(s: str): str:
    n := str.Len(s)
    mut b := str.NewBuilder()
    repeat n with i:
        c := byte_at(s, i)
        str.BufAppendChar(b, c >= 65 && c <= 90 ? c + 32 : c)
    end
    r := str.BufStr(b)
    str.BufFree(b)
    ret r
end

func bstr_split(ip &: Interp, s: str, sep: str): Value:
    aid := arr_new(ip, 8)
    if str.Len(sep) == 0:
        arr_push(ip, aid, val_str(s))
        ret val_arr(aid)
    end
    seplen := str.Len(sep)
    mut p := 0
    until true:
        hit := str.IndexFrom(s, sep, p)
        if hit < 0:
            break
        end
        arr_push(ip, aid, val_str(str.Substr(s, p, hit - p)))
        p = hit + seplen
    end
    arr_push(ip, aid, val_str(str.Substr(s, p, str.Len(s) - p)))
    ret val_arr(aid)
end

// strtol(s, NULL, 10) — whitespace skip, sign, digits, LONG_MIN/MAX clamp.
func c_strtol10(s: str): i64:
    n := str.Len(s)
    mut i := 0
    until i < n && is_c_space(byte_at(s, i)):
        i += 1
    end
    mut neg := false
    if i < n:
        c0 := byte_at(s, i)
        if c0 == 45:
            neg = true
            i += 1
        else c0 == 43:
            i += 1
        end
    end
    mut lim := 9223372036854775807 as u64 // LONG_MAX
    if neg:
        lim = 0x8000000000000000 as u64 // |LONG_MIN|
    end
    mut acc := 0 as u64
    mut over := false
    until i < n && byte_at(s, i) >= 48 && byte_at(s, i) <= 57:
        d := (byte_at(s, i) - 48) as u64
        if acc > (lim - d) / (10 as u64):
            over = true
        else:
            acc = acc * (10 as u64) + d
        end
        i += 1
    end
    if over:
        acc = lim
    end
    if neg:
        ret ((0 as u64) - acc) as i64
    end
    ret acc as i64
end

// FILE* sink — stdout/stderr, or the capture buffers (see file header).
func sink(ip &: Interp, txt: str, to_err: bool):
    if ip.capture:
        if to_err:
            ip.err_text = ip.err_text + txt
        else:
            ip.out_text = ip.out_text + txt
        end
        ret
    end
    if to_err:
        io.EPrint(txt)
    else:
        print txt
    end
end

func do_print(ip &: Interp, a &: at.Ast, env: int, call: int, newline: bool,
              to_err: bool):
    repeat at.ChildCount(a, call) with i:
        if i != 0:
            sink(ip, " ", to_err)
        end
        v := eval(ip, a, env, at.Child(a, call, i))
        if ip.failed:
            ret
        end
        sink(ip, to_str(ip, v), to_err)
    end
    if newline:
        sink(ip, "\n", to_err)
    end
end

func do_input(ip &: Interp): Value:
    if ip.in_has:
        n := str.Len(ip.in_data)
        if ip.in_pos >= n:
            ret val_str("")
        end
        mut e := ip.in_pos
        until e < n && byte_at(ip.in_data, e) != 10:
            e += 1
        end
        line := str.Substr(ip.in_data, ip.in_pos, e - ip.in_pos)
        ip.in_pos = e < n ? e + 1 : e
        ret val_str(line)
    end
    buf := io.Input()
    mut m := str.Len(buf)
    until m > 0 && (byte_at(buf, m - 1) == 10 || byte_at(buf, m - 1) == 13):
        m -= 1
    end
    ret val_str(str.Substr(buf, 0, m))
end

func call_module_func(ip &: Interp, a &: at.Ast, call: int, mid: int, fnname: str,
                      args: Vector<Value>): Value:
    md := ip.mods.get(mid)[0]
    slot := env_find_local(ip, md.env, fnname)
    mut fv := val_null()
    if slot >= 0:
        fv = env_slot_val(ip, md.env, slot)
    end
    if slot < 0 || fv.kind != VAL_FUNC:
        rt_error(ip, a, call,
                 co.Format2(i18.Tr("package '%s' has no exported function '%s'"),
                            co.ArgStr(md.name), co.ArgStr(fnname)))
        ret val_null()
    end
    cl := ip.clos.get(fv.id)[0]
    ret call_func(ip, a, cl.fn, cl.env, false, val_null(), args)
end

// INTRINSICS[] dispatch (index order = k_ip_intrinsics = the C table).
func call_intrinsic(ip &: Interp, name: str, args: Vector<Value>,
                    handled &: bool): Value:
    idx := IntrinsicLookup(name)
    if idx < 0:
        handled = false
        ret val_null()
    end
    handled = true
    a0 := args.len() > 0 ? args.get(0)[0] : val_null()
    a1 := args.len() > 1 ? args.get(1)[0] : val_null()
    if idx == 0:
        ret val_float(math.Sqrt(to_float(a0)))
    end
    if idx == 1:
        ret val_float(math.Sin(to_float(a0)))
    end
    if idx == 2:
        ret val_float(math.Cos(to_float(a0)))
    end
    if idx == 3:
        ret val_float(math.Tan(to_float(a0)))
    end
    if idx == 4:
        ret val_float(math.Asin(to_float(a0)))
    end
    if idx == 5:
        ret val_float(math.Acos(to_float(a0)))
    end
    if idx == 6:
        ret val_float(math.Atan(to_float(a0)))
    end
    if idx == 7:
        ret val_float(math.Atan2(to_float(a0), to_float(a1)))
    end
    if idx == 8:
        ret val_float(math.Log(to_float(a0)))
    end
    if idx == 9:
        ret val_float(math.Log10(to_float(a0)))
    end
    if idx == 10:
        ret val_float(math.Exp(to_float(a0)))
    end
    if idx == 11:
        ret val_float(math.Floor(to_float(a0)))
    end
    if idx == 12:
        ret val_float(math.Ceil(to_float(a0)))
    end
    if idx == 13:
        ret val_float(math.Abs(to_float(a0)))
    end
    if idx == 14:
        ret val_float(math.Mod(to_float(a0), to_float(a1)))
    end
    if idx == 15:
        ret val_float(math.Pow(to_float(a0), to_float(a1)))
    end
    if idx == 16:
        ret val_int(str.Len(to_str(ip, a0)) as i64)
    end
    if idx == 17:
        ret val_int(str.Compare(to_str(ip, a0), to_str(ip, a1)) as i64)
    end
    if idx == 18:
        ret val_int(c_strtol10(to_str(ip, a0)))
    end
    if idx == 19:
        ret val_float(str.ToFloat(to_str(ip, a0)))
    end
    if idx == 20:
        ret do_input(ip)
    end
    if idx == 21:
        ret val_int(time.Now())
    end
    // idx == 22: SleepEx(ms) on Windows, usleep(µs) elsewhere.
    if SALAM_OS_WINDOWS:
        time.Sleep(to_int(a0) as int)
    else:
        time.Sleep((to_int(a0) / (1000 as i64)) as int)
    end
    ret val_int(0 as i64)
end

func call_builtin_method(ip &: Interp, a &: at.Ast, call: int, recv: Value,
                         method: str, args: Vector<Value>): Value:
    a0 := args.len() > 0 ? args.get(0)[0] : val_null()
    a1 := args.len() > 1 ? args.get(1)[0] : val_null()
    if recv.kind == VAL_STR:
        s := recv.s
        if str.Equals(method, "len"):
            ret val_int(str.Len(s) as i64)
        end
        if str.Equals(method, "concat"):
            ret val_str(s + to_str(ip, a0))
        end
        if str.Equals(method, "substr"):
            ret val_str(bstr_substr(s, to_int(a0), to_int(a1)))
        end
        if str.Equals(method, "find") || str.Equals(method, "search") ||
           str.Equals(method, "indexOf"):
            ret val_int(str.Find(s, to_str(ip, a0)) as i64)
        end
        if str.Equals(method, "trim"):
            ret val_str(bstr_trim(s))
        end
        if str.Equals(method, "to_int"):
            ret val_int(c_strtol10(s))
        end
        if str.Equals(method, "to_float"):
            ret val_float(str.ToFloat(s))
        end
        if str.Equals(method, "split"):
            ret bstr_split(ip, s, to_str(ip, a0))
        end
        if str.Equals(method, "lower"):
            ret val_str(bstr_lower(s))
        end
        if str.Equals(method, "upper"):
            ret val_str(bstr_upper(s))
        end
        if str.Equals(method, "repeat"):
            ret str_repeat(s, to_int(a0))
        end
    else recv.kind == VAL_ARRAY:
        aid := recv.id
        if str.Equals(method, "push"):
            arr_push(ip, aid, a0)
            ret val_null()
        end
        if str.Equals(method, "pop"):
            n := arr_len(ip, aid)
            if n == 0:
                rt_error(ip, a, call, i18.Tr("pop from empty vector"))
                ret val_null()
            end
            last := arr_get(ip, aid, n - 1)
            arr_shrink(ip, aid)
            ret last
        end
        if str.Equals(method, "get"):
            iv := to_int(a0)
            n2 := arr_len(ip, aid)
            if iv < (0 as i64) || iv >= (n2 as i64):
                rt_error(ip, a, call,
                         co.Format2(i18.Tr("vector index %lld out of range (len %zu)"),
                                    co.ArgInt(iv), co.ArgUint(n2 as u64)))
                ret val_null()
            end
            box := arr_new(ip, 1)
            arr_push(ip, box, arr_get(ip, aid, iv as int))
            ret val_arr(box)
        end
        if str.Equals(method, "set"):
            iv2 := to_int(a0)
            n3 := arr_len(ip, aid)
            if iv2 < (0 as i64) || iv2 >= (n3 as i64):
                rt_error(ip, a, call,
                         co.Format2(i18.Tr("vector index %lld out of range (len %zu)"),
                                    co.ArgInt(iv2), co.ArgUint(n3 as u64)))
                ret val_null()
            end
            arr_set(ip, aid, iv2 as int, a1)
            ret val_null()
        end
        if str.Equals(method, "len"):
            ret val_int(arr_len(ip, aid) as i64)
        end
        if str.Equals(method, "cap"):
            an := ip.arrs.get(aid)[0]
            ret val_int(an.cap as i64)
        end
        if str.Equals(method, "free"):
            ret val_null()
        end
    else recv.kind == VAL_MAP:
        mid := recv.id
        if str.Equals(method, "put"):
            map_put(ip, mid, a0, a1)
            ret val_null()
        end
        if str.Equals(method, "get"):
            m := ip.maps.get(mid)[0]
            e := map_find(m, a0)
            ret e >= 0 ? m.vals.get(e)[0] : val_null()
        end
        if str.Equals(method, "has"):
            m2 := ip.maps.get(mid)[0]
            ret val_bool(map_find(m2, a0) >= 0)
        end
        if str.Equals(method, "remove"):
            ret val_bool(map_remove(ip, mid, a0))
        end
        if str.Equals(method, "size"):
            m3 := ip.maps.get(mid)[0]
            ret val_int(m3.count as i64)
        end
        if str.Equals(method, "iter"):
            itid := ip.iters.len()
            ip.iters.push(SMapIter { map = mid })
            ret Value { kind = VAL_MAPITER, id = itid }
        end
    else recv.kind == VAL_PTR:
        fmn := ["read", "readline", "write", "seek", "close"] as str[5]
        fmf := ["salam_file_read", "salam_file_readline", "salam_file_write",
                "salam_file_seek", "salam_file_close"] as str[5]
        repeat 5 with i:
            if !str.Equals(method, fmn[i]):
                continue
            end
            efi := find_extern_fn(ip, fmf[i])
            if efi == 0:
                break
            end
            ef := ip.extern_fns.get(efi)[0]
            mut allargs := Vector {} as Vector<Value>
            allargs.push(recv)
            repeat args.len() with j:
                allargs.push(args.get(j)[0])
            end
            cl := ip.clos.get(ef.id)[0]
            r := call_func(ip, a, cl.fn, cl.env, false, val_null(), allargs)
            allargs.free()
            ret r
        end
    else recv.kind == VAL_MAPITER:
        itv := ip.iters.get(recv.id)[0]
        m4 := ip.maps.get(itv.map)[0]
        if str.Equals(method, "has_next"):
            mut i := itv.idx
            until i < m4.cap:
                if m4.used.get(i)[0]:
                    ret val_bool(true)
                end
                i += 1
            end
            ret val_bool(false)
        end
        if str.Equals(method, "next"):
            mut i2 := itv.idx
            until i2 < m4.cap && !m4.used.get(i2)[0]:
                i2 += 1
            end
            if i2 < m4.cap:
                i2 += 1
            end
            ip.iters.set(recv.id, SMapIter { map = itv.map, idx = i2 })
            ret val_null()
        end
        if str.Equals(method, "key"):
            mut i3 := itv.idx
            until i3 < m4.cap && !m4.used.get(i3)[0]:
                i3 += 1
            end
            ret i3 < m4.cap ? m4.keys.get(i3)[0] : val_null()
        end
        if str.Equals(method, "value"):
            mut i4 := itv.idx
            until i4 < m4.cap && !m4.used.get(i4)[0]:
                i4 += 1
            end
            ret i4 < m4.cap ? m4.vals.get(i4)[0] : val_null()
        end
    end
    rt_error(ip, a, call,
             co.Format1(i18.Tr("method '%s' is not available on this value"),
                        co.ArgStr(method)))
    ret val_null()
end

// ===========================================================================
// ===== interp_expr.c / interp_stmt.c shared glue (ported in stage A) =====
// ===========================================================================

// call_func (interp_expr.c) — parameter binding, body execution, LIFO defers.
// thisv is passed with has_this (the C took a nullable value_t*).
func call_func(ip &: Interp, a &: at.Ast, fnnode: int, defenv: int, has_this: bool,
               thisv: Value, args: Vector<Value>): Value:
    ip.depth += 1
    if ip.depth > INTERP_MAX_DEPTH:
        rt_error(ip, a, fnnode,
                 i18.Tr("call stack too deep (possible infinite recursion)"))
        ip.depth -= 1
        ret val_null()
    end
    env := env_new(ip, defenv)
    if has_this:
        env_define(ip, env, "this", thisv)
    end
    repeat at.ChildCount(a, fnnode) with i:
        p := at.Child(a, fnnode, i)
        pn := at.Get(a, p)
        if i < args.len():
            env_define(ip, env, pn.name, args.get(i)[0])
        else pn.a != 0:
            env_define(ip, env, pn.name, eval(ip, a, env, pn.a))
        else:
            env_define(ip, env, pn.name, val_null())
        end
        if ip.failed:
            ip.depth -= 1
            ret val_null()
        end
    end
    mut fr := Frame {}
    saved_med := ip.match_expr_depth
    mut retv := val_null()
    ip.match_expr_depth = 0
    fnn := at.Get(a, fnnode)
    if fnn.a != 0:
        _f := exec_list(ip, a, env, fr, fnn.a, retv)
    end
    ip.match_expr_depth = saved_med
    mut di := fr.defer_stmts.len()
    until di > 0:
        di -= 1
        mut dummy := val_null()
        mut inner := Frame {}
        _f2 := exec_stmt(ip, a, fr.defer_envs.get(di)[0], inner,
                         fr.defer_stmts.get(di)[0], dummy)
        inner.defer_stmts.free()
        inner.defer_envs.free()
    end
    fr.defer_stmts.free()
    fr.defer_envs.free()
    ip.depth -= 1
    ret retv
end

// exec_list (interp_stmt.c) — executes `owner`'s child list; cooperative
// unwinding stops the walk once ip.failed is set.
func exec_list(ip &: Interp, a &: at.Ast, env: int, fr &: Frame, owner: int,
               retv &: Value): int:
    repeat at.ChildCount(a, owner) with i:
        f := exec_stmt(ip, a, env, fr, at.Child(a, owner, i), retv)
        if f != FLOW_NORMAL:
            ret f
        end
        if ip.failed:
            ret FLOW_NORMAL
        end
    end
    ret FLOW_NORMAL
end

// ===========================================================================
// ===== interp_ffi.c =====
// ===========================================================================
// The C table NATIVE_SYMS[] held &symbol pointers and called each through a
// cast int64_t(*)(int64_t x8). The port declares every table symbol as a
// bodyless extern up top (see just below the imports — E083/ast_order
// classifies bodyless extern funcs as ORDER_IMPORT, so they must precede all
// consts/types/funcs, same as compiler/std/os.salam etc.) and dispatches by
// name in native_dispatch, marshalling the same i64 bit patterns the C
// passed. No NATIVE_SYMS function takes more than 4 arguments, so 4 slots
// suffice (the C passed 8 junk-padded registers; a typed call passes exactly
// the declared ones — same callee-visible values).

// Reinterpret marshalled char* bits as a str (the C passed the raw pointer).
func nx_str(x: i64): str:
    p := x as void*
    ret p as str
end

// typestr_is_float (interp_ffi.c)
func typestr_is_float(ts: str): bool:
    ret is_float_typename(base_typename(ts))
end

// marshal_arg (interp_ffi.c) — the same i64 bit patterns the C produced.
func marshal_arg(v: Value): i64:
    if v.kind == VAL_STR:
        sp := v.s as void*
        ret sp as i64
    end
    if v.kind == VAL_PTR:
        ret v.pa
    end
    if v.kind == VAL_BOOL:
        ret v.b ? (1 as i64) : (0 as i64)
    end
    if v.kind == VAL_CHAR || v.kind == VAL_INT:
        ret v.i
    end
    ret 0 as i64
end

// find_native_sym + the fn(a[0..7]) call, fused: dispatch by name and call
// the extern with the marshalled bits (table order = the C NATIVE_SYMS).
func native_dispatch(name: str, a0: i64, a1: i64, a2: i64, a3: i64,
                     found &: bool): i64:
    found = true
    if str.Equals(name, "getenv"):
        gv := getenv(nx_str(a0))
        ret gv as i64
    end
    if str.Equals(name, "malloc"):
        mv := malloc(a0 as u64)
        ret mv as i64
    end
    if str.Equals(name, "realloc"):
        rv := realloc(a0 as void*, a1 as u64)
        ret rv as i64
    end
    if str.Equals(name, "free"):
        free(a0 as void*)
        ret 0 as i64
    end
    if str.Equals(name, "memset"):
        msv := memset(a0 as void*, a1 as int, a2 as u64)
        ret msv as i64
    end
    if str.Equals(name, "memcpy"):
        mcv := memcpy(a0 as void*, a1 as void*, a2 as u64)
        ret mcv as i64
    end
    if str.Equals(name, "memmove"):
        mmv := memmove(a0 as void*, a1 as void*, a2 as u64)
        ret mmv as i64
    end
    if str.Equals(name, "remove"):
        ret remove(nx_str(a0)) as i64
    end
    if str.Equals(name, "rename"):
        ret rename(nx_str(a0), nx_str(a1)) as i64
    end
    if str.Equals(name, "fopen"):
        fv := fopen(nx_str(a0), nx_str(a1))
        ret fv as i64
    end
    if str.Equals(name, "fclose"):
        ret fclose(a0 as void*) as i64
    end
    if str.Equals(name, "fseek"):
        ret fseek(a0 as void*, a1 as int, a2 as int) as i64
    end
    if str.Equals(name, "ftell"):
        ret ftell(a0 as void*) as i64
    end
    if str.Equals(name, "fread"):
        ret fread(a0 as void*, a1 as u64, a2 as u64, a3 as void*) as i64
    end
    if str.Equals(name, "fwrite"):
        ret fwrite(a0 as void*, a1 as u64, a2 as u64, a3 as void*) as i64
    end
    if str.Equals(name, "fgetc"):
        ret fgetc(a0 as void*) as i64
    end
    if str.Equals(name, "fgets"):
        gsv := fgets(a0 as void*, a1 as int, a2 as void*)
        ret gsv as i64
    end
    if str.Equals(name, "exit"):
        exit(a0 as int)
    end
    if str.Equals(name, "abort"):
        abort()
    end
    if SALAM_OS_WINDOWS:
        if str.Equals(name, "_mkdir"):
            ret _mkdir(nx_str(a0)) as i64
        end
        if str.Equals(name, "_rmdir"):
            ret _rmdir(nx_str(a0)) as i64
        end
        if str.Equals(name, "_chdir"):
            ret _chdir(nx_str(a0)) as i64
        end
        if str.Equals(name, "GetCurrentDirectoryA"):
            ret GetCurrentDirectoryA(a0 as int, a1 as void*) as i64
        end
        if str.Equals(name, "GetFileAttributesA"):
            ret GetFileAttributesA(nx_str(a0)) as i64
        end
        if str.Equals(name, "_fseeki64"):
            ret _fseeki64(a0 as void*, a1, a2 as int) as i64
        end
        if str.Equals(name, "FindFirstFileA"):
            ffv := FindFirstFileA(nx_str(a0), a1 as void*)
            ret ffv as i64
        end
        if str.Equals(name, "FindNextFileA"):
            ret FindNextFileA(a0 as void*, a1 as void*) as i64
        end
        if str.Equals(name, "FindClose"):
            ret FindClose(a0 as void*) as i64
        end
        if str.Equals(name, "GetSystemTimeAsFileTime"):
            GetSystemTimeAsFileTime(a0 as void*)
            ret 0 as i64
        end
        if str.Equals(name, "_getpid"):
            ret _getpid() as i64
        end
        if str.Equals(name, "_popen"):
            pv := _popen(nx_str(a0), nx_str(a1))
            ret pv as i64
        end
        if str.Equals(name, "_pclose"):
            ret _pclose(a0 as void*) as i64
        end
    else:
        if str.Equals(name, "mkdir"):
            ret mkdir(nx_str(a0), a1 as int) as i64
        end
        if str.Equals(name, "rmdir"):
            ret rmdir(nx_str(a0)) as i64
        end
        if str.Equals(name, "chdir"):
            ret chdir(nx_str(a0)) as i64
        end
        if str.Equals(name, "access"):
            ret access(nx_str(a0), a1 as int) as i64
        end
        if str.Equals(name, "getcwd"):
            cwv := getcwd(a0 as void*, a1 as int)
            ret cwv as i64
        end
        if str.Equals(name, "opendir"):
            odv := opendir(nx_str(a0))
            ret odv as i64
        end
        if str.Equals(name, "readdir"):
            rdv := readdir(a0 as void*)
            ret rdv as i64
        end
        if str.Equals(name, "closedir"):
            ret closedir(a0 as void*) as i64
        end
        if str.Equals(name, "fseeko"):
            ret fseeko(a0 as void*, a1, a2 as int) as i64
        end
        if str.Equals(name, "clock_gettime"):
            ret clock_gettime(a0 as int, a1 as void*) as i64
        end
        if str.Equals(name, "popen"):
            pov := popen(nx_str(a0), nx_str(a1))
            ret pov as i64
        end
        if str.Equals(name, "pclose"):
            ret pclose(a0 as void*) as i64
        end
        if str.Equals(name, "getpid"):
            ret getpid() as i64
        end
        if str.Equals(name, "system"):
            ret system(nx_str(a0)) as i64
        end
    end
    found = false
    ret 0 as i64
end

// call_native_extern (interp_ffi.c) — same guard order as the C: variadic,
// arity > 8, float args, float return, then symbol lookup.
func call_native_extern(ip &: Interp, a &: at.Ast, call: int, decl: int,
                        args: Vector<Value>): Value:
    dn := at.Get(a, decl)
    if dn.is_variadic:
        rt_error(ip, a, call,
                 co.Format1(i18.Tr("extern function '%s' is variadic, which the interpreter does not support (use 'salam run' instead)"),
                            co.ArgStr(dn.name)))
        ret val_null()
    end
    np := at.ChildCount(a, decl)
    if np > 8:
        rt_error(ip, a, call,
                 co.Format1(i18.Tr("extern function '%s' takes too many parameters for the interpreter's native call support"),
                            co.ArgStr(dn.name)))
        ret val_null()
    end
    repeat np with i:
        p := at.Child(a, decl, i)
        pn := at.Get(a, p)
        pts := pn.ty != 0 ? at.Get(a, pn.ty).type_str : ""
        if typestr_is_float(pts):
            rt_error(ip, a, call,
                     co.Format1(i18.Tr("extern function '%s' takes a floating-point argument, which the interpreter does not support (use 'salam run' instead)"),
                                co.ArgStr(dn.name)))
            ret val_null()
        end
    end
    rts := dn.ty != 0 ? at.Get(a, dn.ty).type_str : ""
    if str.Len(rts) != 0 && typestr_is_float(rts):
        rt_error(ip, a, call,
                 co.Format1(i18.Tr("extern function '%s' returns a floating-point value, which the interpreter does not support (use 'salam run' instead)"),
                            co.ArgStr(dn.name)))
        ret val_null()
    end
    mut a0 := 0 as i64
    mut a1 := 0 as i64
    mut a2 := 0 as i64
    mut a3 := 0 as i64
    mut mi := 0
    until mi < np && mi < args.len():
        mv := marshal_arg(args.get(mi)[0])
        if mi == 0:
            a0 = mv
        else mi == 1:
            a1 = mv
        else mi == 2:
            a2 = mv
        else mi == 3:
            a3 = mv
        end
        mi += 1
    end
    mut found := false
    r := native_dispatch(dn.name, a0, a1, a2, a3, found)
    if !found:
        rt_error(ip, a, call,
                 co.Format1(i18.Tr("extern function '%s' is not supported by the interpreter (use 'salam run' instead)"),
                            co.ArgStr(dn.name)))
        ret val_null()
    end
    if str.Len(rts) == 0:
        ret val_null()
    end
    if byte_at(rts, str.Len(rts) - 1) == 42:
        ret val_ptr(r, ptr_elem_from_typestr(rts))
    end
    rbase := base_typename(rts)
    if str.Equals(rbase, "bool"):
        ret val_bool(r != (0 as i64))
    end
    ret val_int(r)
end

// ===========================================================================
// ===== interp_expr.c (stage B) =====
// ===========================================================================

// eval_args — evaluates the call's argument list into `out`; stops at the
// first runtime error (the C longjmp'd out of the loop).
func eval_args(ip &: Interp, a &: at.Ast, env: int, call: int,
               out &: Vector<Value>):
    repeat at.ChildCount(a, call) with i:
        out.push(eval(ip, a, env, at.Child(a, call, i)))
        if ip.failed:
            ret
        end
    end
end

func interp_alignof_typename(ip &: Interp, a &: at.Ast, ts: str): i64:
    n := str.Len(ts)
    if n == 0:
        ret 8 as i64
    end
    if byte_at(ts, n - 1) == 42:
        ret 8 as i64
    end
    if str.Equals(ts, "i8") || str.Equals(ts, "u8") || str.Equals(ts, "bool") ||
       str.Equals(ts, "char"):
        ret 1 as i64
    end
    if str.Equals(ts, "i16") || str.Equals(ts, "u16"):
        ret 2 as i64
    end
    if str.Equals(ts, "i32") || str.Equals(ts, "u32") || str.Equals(ts, "f32"):
        ret 4 as i64
    end
    if str.Equals(ts, "i64") || str.Equals(ts, "u64") || str.Equals(ts, "f64") ||
       str.Equals(ts, "str"):
        ret 8 as i64
    end
    sd := find_struct(ip, ts)
    if sd != 0:
        mut maxalign := 1 as i64
        repeat at.ChildCount(a, sd) with i:
            f := at.Child(a, sd, i)
            fn := at.Get(a, f)
            if fn.kind != at.AST_FIELD:
                continue
            end
            al := interp_alignof_typename(ip, a,
                                          fn.ty != 0 ? at.Get(a, fn.ty).type_str : "")
            if al > maxalign:
                maxalign = al
            end
        end
        ret maxalign
    end
    ret 8 as i64
end

func interp_sizeof_typename(ip &: Interp, a &: at.Ast, ts: str): i64:
    n := str.Len(ts)
    if n == 0:
        ret 8 as i64
    end
    if byte_at(ts, n - 1) == 42:
        ret 8 as i64
    end
    if str.Equals(ts, "i8") || str.Equals(ts, "u8") || str.Equals(ts, "bool") ||
       str.Equals(ts, "char"):
        ret 1 as i64
    end
    if str.Equals(ts, "i16") || str.Equals(ts, "u16"):
        ret 2 as i64
    end
    if str.Equals(ts, "i32") || str.Equals(ts, "u32") || str.Equals(ts, "f32"):
        ret 4 as i64
    end
    if str.Equals(ts, "i64") || str.Equals(ts, "u64") || str.Equals(ts, "f64") ||
       str.Equals(ts, "str"):
        ret 8 as i64
    end
    sd := find_struct(ip, ts)
    if sd != 0:
        mut off := 0 as i64
        mut maxalign := 1 as i64
        repeat at.ChildCount(a, sd) with i:
            f := at.Child(a, sd, i)
            fn := at.Get(a, f)
            if fn.kind != at.AST_FIELD:
                continue
            end
            fts := fn.ty != 0 ? at.Get(a, fn.ty).type_str : ""
            sz := interp_sizeof_typename(ip, a, fts)
            al := interp_alignof_typename(ip, a, fts)
            off = (off + al - (1 as i64)) & (~(al - (1 as i64)))
            off += sz
            if al > maxalign:
                maxalign = al
            end
        end
        off = (off + maxalign - (1 as i64)) & (~(maxalign - (1 as i64)))
        ret off != (0 as i64) ? off : (8 as i64)
    end
    ret 8 as i64
end

func do_listdir(ip &: Interp, a &: at.Ast, call: int, patharg: Value): Value:
    efi := find_extern_fn(ip, "salam_os_listdir")
    if efi == 0:
        rt_error(ip, a, call, i18.Tr("'listdir' is not supported by the interpreter"))
        ret val_null()
    end
    cntp := mem.AllocateZeroed(4 as u64)
    mut cargs := Vector {} as Vector<Value>
    cargs.push(patharg)
    cargs.push(val_ptr(cntp as i64, PTR_I32))
    ef := ip.extern_fns.get(efi)[0]
    cl := ip.clos.get(ef.id)[0]
    r := call_func(ip, a, cl.fn, cl.env, false, val_null(), cargs)
    cargs.free()
    cip := cntp as i32*
    cnt := cip[0] as int
    mem.Free(cntp)
    out := arr_new(ip, cnt > 0 ? cnt : 4)
    if !ip.failed && r.kind == VAL_PTR && r.pa != (0 as i64) && cnt > 0:
        repeat cnt with i:
            // C: val_str(arena_strdup(I->a, arr[i] ? arr[i] : "")); the port
            // aliases the char* (the interpreted fs code owns the buffers).
            arr_push(ip, out, ptr_load(r.pa, PTR_STR, i as i64))
        end
    end
    ret val_arr(out)
end

// eval_call (interp_expr.c) — builtin names first, then bindings, named
// functions, extern fns, intrinsics, native extern decls (same order).
func eval_call(ip &: Interp, a &: at.Ast, env: int, n: int): Value:
    nd := at.Get(a, n)
    callee := nd.a
    cn := at.Get(a, callee)
    // One shared, function-scoped args vector: `defer` cleanup runs at every
    // `ret` in this function regardless of which nested block registered it
    // (the codegen's defer list isn't C-block-scoped — see PORTING.md), so a
    // Vector declared and deferred inside a nested if is unsafe once OTHER
    // returns exist outside that block. Only ONE of the branches below ever
    // fills this vector before returning (mirrors the C, which never calls
    // eval_args twice for the same call), so reuse is safe.
    mut args := Vector {} as Vector<Value>
    defer args.free()

    if cn.kind == at.AST_IDENTIFIER:
        nm := cn.name
        if str.Equals(nm, "print"):
            do_print(ip, a, env, n, false, false)
            ret val_null()
        end
        if str.Equals(nm, "println"):
            do_print(ip, a, env, n, true, false)
            ret val_null()
        end
        if str.Equals(nm, "printerr"):
            do_print(ip, a, env, n, false, true)
            ret val_null()
        end
        if str.Equals(nm, "printerrln"):
            do_print(ip, a, env, n, true, true)
            ret val_null()
        end
        if str.Equals(nm, "input"):
            ret do_input(ip)
        end
        if str.Equals(nm, "lang"):
            ret val_str(ip.lang)
        end
        if str.Equals(nm, "args") && at.ChildCount(a, n) == 0:
            ret val_arr(arr_new(ip, 0))
        end
        if str.Equals(nm, "sizeof") && at.ChildCount(a, n) == 1:
            op := at.Child(a, n, 0)
            ret val_int(interp_sizeof_typename(ip, a, at.Get(a, op).type_str))
        end
        eval_args(ip, a, env, n, args)
        if ip.failed:
            ret val_null()
        end
        na := args.len()
        if str.Equals(nm, "len") && na == 1:
            la := args.get(0)[0]
            if la.kind == VAL_ARRAY:
                ret val_int(arr_len(ip, la.id) as i64)
            end
            if la.kind == VAL_STR:
                ret val_int(str.Len(la.s) as i64)
            end
            if la.kind == VAL_MAP:
                lm := ip.maps.get(la.id)[0]
                ret val_int(lm.count as i64)
            end
            rt_error(ip, a, n, i18.Tr("len() expects an array, string, or map"))
            ret val_null()
        end
        if str.Equals(nm, "char_code") && na == 1:
            cs := to_str(ip, args.get(0)[0])
            // C read s[0] — the NUL terminator (0) for an empty string.
            ret val_int((str.Len(cs) > 0 ? byte_at(cs, 0) : 0) as i64)
        end
        if str.Equals(nm, "char_from_code") && na == 1:
            cb := (to_int(args.get(0)[0]) & (0xFF as i64)) as int
            if cb == 0:
                ret val_str("") // C built "\0" — strdup'd to ""
            end
            mut cbb := str.NewBuilder()
            str.BufAppendChar(cbb, cb)
            cr := str.BufStr(cbb)
            str.BufFree(cbb)
            ret val_str(cr)
        end
        if str.Equals(nm, "strcmp") && na == 2:
            ret val_int(str.Compare(to_str(ip, args.get(0)[0]),
                                    to_str(ip, args.get(1)[0])) as i64)
        end
        if str.Equals(nm, "funcptr") && na == 1:
            ret args.get(0)[0]
        end
        if str.Equals(nm, "listdir") && na == 1:
            ret do_listdir(ip, a, n, args.get(0)[0])
        end
        if str.Equals(nm, "hash") && na == 1:
            ha := args.get(0)[0]
            hname := ha.kind == VAL_STR ? "salam_str_hash" : "salam_hash_int"
            hefi := find_extern_fn(ip, hname)
            if hefi == 0:
                rt_error(ip, a, n, i18.Tr("'hash' is not supported by the interpreter"))
                ret val_null()
            end
            mut hargs := Vector {} as Vector<Value>
            hargs.push(ha.kind == VAL_STR ? ha : val_int(to_int(ha)))
            hef := ip.extern_fns.get(hefi)[0]
            hcl := ip.clos.get(hef.id)[0]
            hr := call_func(ip, a, hcl.fn, hcl.env, false, val_null(), hargs)
            hargs.free()
            // Clear bit 63: VAL_INT is signed, hash(k) % cap must stay >= 0.
            ret val_int(to_int(hr) & (0x7FFFFFFFFFFFFFFF as i64))
        end

        mut bw := 0
        bslot := env_find(ip, env, nm, bw)
        if bslot >= 0:
            bv := env_slot_val(ip, bw, bslot)
            if bv.kind == VAL_FUNC:
                bcl := ip.clos.get(bv.id)[0]
                ret call_func(ip, a, bcl.fn, bcl.env, false, val_null(), args)
            end
        end
        fn := find_func(ip, a, nm, na)
        if fn != 0:
            ret call_func(ip, a, fn, ip.globals, false, val_null(), args)
        end
        efi := find_extern_fn(ip, nm)
        if efi != 0:
            ef := ip.extern_fns.get(efi)[0]
            ecl := ip.clos.get(ef.id)[0]
            ret call_func(ip, a, ecl.fn, ecl.env, false, val_null(), args)
        end
        mut handled := false
        ir := call_intrinsic(ip, nm, args, handled)
        if handled:
            ret ir
        end
        decl := find_extern_decl(ip, nm)
        if decl != 0:
            ret call_native_extern(ip, a, n, decl, args)
        end
        rt_error(ip, a, n, co.Format1(i18.Tr("call to undefined function '%s'"),
                                      co.ArgStr(nm)))
        ret val_null()
    end

    if cn.kind == at.AST_MEMBER:
        obj := cn.a
        method := cn.name
        onn := at.Get(a, obj)
        if onn.kind == at.AST_IDENTIFIER:
            mut mw := 0
            mslot := env_find(ip, env, onn.name, mw)
            if mslot >= 0:
                mv := env_slot_val(ip, mw, mslot)
                if mv.kind == VAL_MODULE:
                    eval_args(ip, a, env, n, args)
                    if ip.failed:
                        ret val_null()
                    end
                    ret call_module_func(ip, a, n, mv.id, method, args)
                end
            end
        end
        recv := eval(ip, a, env, obj)
        if ip.failed:
            ret val_null()
        end
        eval_args(ip, a, env, n, args)
        if ip.failed:
            ret val_null()
        end
        na2 := args.len()

        if str.Equals(method, "free") && na2 == 0:
            ret val_null()
        end
        if recv.kind == VAL_STRUCT:
            stv := ip.sts.get(recv.id)[0]
            mut m := struct_method_arity(a, stv.def, method, na2)
            if m == 0:
                m = struct_method(a, stv.def, method)
            end
            if m != 0:
                denv := find_def_env(ip, m)
                ret call_func(ip, a, m, denv != 0 ? denv : ip.globals, true, recv,
                              args)
            end
            fi := st_find_field(ip, recv.id, method)
            if fi >= 0:
                s2 := ip.sts.get(recv.id)[0]
                fv := s2.fvals.get(fi)[0]
                if fv.kind == VAL_FUNC:
                    fcl := ip.clos.get(fv.id)[0]
                    ret call_func(ip, a, fcl.fn, fcl.env, false, val_null(), args)
                end
            end
            rt_error(ip, a, n, co.Format2(i18.Tr("struct '%s' has no method '%s'"),
                                          co.ArgStr(stv.type_name),
                                          co.ArgStr(method)))
            ret val_null()
        end

        im := find_impl_method(ip, a, onn.type_str, method, na2)
        if im != 0:
            denv2 := find_def_env(ip, im)
            ret call_func(ip, a, im, denv2 != 0 ? denv2 : ip.globals, true, recv,
                          args)
        end
        ret call_builtin_method(ip, a, n, recv, method, args)
    end

    fv2 := eval(ip, a, env, callee)
    if ip.failed:
        ret val_null()
    end
    if fv2.kind == VAL_FUNC:
        eval_args(ip, a, env, n, args)
        if ip.failed:
            ret val_null()
        end
        vcl := ip.clos.get(fv2.id)[0]
        ret call_func(ip, a, vcl.fn, vcl.env, false, val_null(), args)
    end
    rt_error(ip, a, n, i18.Tr("value is not callable"))
    ret val_null()
end

// Runs a frame's defers LIFO (shared by eval_match; call_func inlines the
// same walk — ported in stage A).
func run_defers(ip &: Interp, a &: at.Ast, fr &: Frame):
    mut di := fr.defer_stmts.len()
    until di > 0:
        di -= 1
        mut dummy := val_null()
        mut inner := Frame {}
        _f := exec_stmt(ip, a, fr.defer_envs.get(di)[0], inner,
                        fr.defer_stmts.get(di)[0], dummy)
        inner.defer_stmts.free()
        inner.defer_envs.free()
    end
end

// eval_match (interp_expr.c) — match in expression position; the arm body
// runs with match_expr_depth bumped so `ret` yields FLOW_MATCH_RET, and
// break/continue escape through ip.pending_flow.
func eval_match(ip &: Interp, a &: at.Ast, env: int, n: int): Value:
    nd := at.Get(a, n)
    subj := eval(ip, a, env, nd.a)
    if ip.failed:
        ret val_null()
    end
    arm := interp_find_match_arm(ip, a, env, n, subj)
    if arm == 0 || ip.failed:
        ret val_null()
    end
    c := env_new(ip, env)
    mut fr := Frame {}
    mut val := val_null()
    saved_depth := ip.match_expr_depth
    ip.match_expr_depth = saved_depth + 1
    f := exec_list(ip, a, c, fr, at.Get(a, arm).b, val)
    ip.match_expr_depth = saved_depth
    if f == FLOW_BREAK || f == FLOW_CONTINUE:
        ip.pending_flow = f
    end
    run_defers(ip, a, fr)
    fr.defer_stmts.free()
    fr.defer_envs.free()
    ret val
end

// eval (interp_expr.c) — the full expression evaluator.
func eval(ip &: Interp, a &: at.Ast, env: int, n: int): Value:
    if n == 0 || ip.failed:
        ret val_null()
    end
    nd := at.Get(a, n)
    k := nd.kind
    if k == at.AST_LITERAL:
        if nd.op == tok.TK_INT:
            ret val_int(nd.value_int as i64)
        end
        if nd.op == tok.TK_FLOAT:
            ret val_float(nd.value_float)
        end
        if nd.op == tok.TK_CHAR:
            ret val_char(nd.value_int as i64)
        end
        if nd.op == tok.TK_STRING || nd.op == tok.TK_TRIPLE_STRING ||
           nd.op == tok.TK_RAW_STRING || nd.op == tok.TK_UTF8_CHAR:
            ret val_str(nd.value_str)
        end
        if nd.op == tok.TK_KW_TRUE:
            ret val_bool(true)
        end
        if nd.op == tok.TK_KW_FALSE:
            ret val_bool(false)
        end
        ret val_null() // TK_KW_NULL + default
    end
    if k == at.AST_IDENTIFIER:
        mut w := 0
        slot := env_find(ip, env, nd.name, w)
        if slot >= 0:
            ret env_slot_val(ip, w, slot)
        end
        mut tw := 0
        tslot := env_find(ip, env, "this", tw)
        if tslot >= 0:
            tv := env_slot_val(ip, tw, tslot)
            if tv.kind == VAL_STRUCT:
                fi := st_find_field(ip, tv.id, nd.name)
                if fi >= 0:
                    ts := ip.sts.get(tv.id)[0]
                    ret ts.fvals.get(fi)[0]
                end
            end
        end
        fn := find_func(ip, a, nd.name, 0 - 1)
        if fn != 0:
            ret mk_closure(ip, fn, ip.globals)
        end
        rt_error(ip, a, n, co.Format1(i18.Tr("undefined variable '%s'"),
                                      co.ArgStr(nd.name)))
        ret val_null()
    end
    if k == at.AST_THIS:
        mut thw := 0
        thslot := env_find(ip, env, "this", thw)
        if thslot < 0:
            rt_error(ip, a, n, i18.Tr("'this' used outside a method"))
            ret val_null()
        end
        ret env_slot_val(ip, thw, thslot)
    end
    if k == at.AST_BINARY:
        op := nd.op
        if op == tok.TK_AND:
            av0 := eval(ip, a, env, nd.a)
            if ip.failed:
                ret val_null()
            end
            if !to_bool(av0):
                ret val_bool(false)
            end
            ret val_bool(to_bool(eval(ip, a, env, nd.b)))
        end
        if op == tok.TK_OR:
            av1 := eval(ip, a, env, nd.a)
            if ip.failed:
                ret val_null()
            end
            if to_bool(av1):
                ret val_bool(true)
            end
            ret val_bool(to_bool(eval(ip, a, env, nd.b)))
        end
        av := eval(ip, a, env, nd.a)
        if ip.failed:
            ret val_null()
        end
        bv := eval(ip, a, env, nd.b)
        if ip.failed:
            ret val_null()
        end
        mut found := false
        r := try_struct_op(ip, a, op, av, bv, true, found)
        if found:
            ret r
        end
        if op == tok.TK_EQ:
            ret val_bool(value_eq(av, bv))
        end
        if op == tok.TK_NE:
            ret val_bool(!value_eq(av, bv))
        end
        if op == tok.TK_LT:
            ret val_bool(value_cmp(av, bv) < 0)
        end
        if op == tok.TK_GT:
            ret val_bool(value_cmp(av, bv) > 0)
        end
        if op == tok.TK_LE:
            ret val_bool(value_cmp(av, bv) <= 0)
        end
        if op == tok.TK_GE:
            ret val_bool(value_cmp(av, bv) >= 0)
        end
        ret arith(ip, a, n, op, av, bv)
    end
    if k == at.AST_TERNARY:
        cv := eval(ip, a, env, nd.a)
        if ip.failed:
            ret val_null()
        end
        ret to_bool(cv) ? eval(ip, a, env, nd.b) : eval(ip, a, env, nd.c)
    end
    if k == at.AST_MATCH:
        ret eval_match(ip, a, env, n)
    end
    if k == at.AST_VARIANT_BOX:
        inner := eval(ip, a, env, nd.a)
        if ip.failed:
            ret val_null()
        end
        ret mk_variant(ip, nd.value_int as int, true, inner)
    end
    if k == at.AST_VARIANT_UNWRAP:
        uv := eval(ip, a, env, nd.a)
        if ip.failed:
            ret val_null()
        end
        if uv.kind != VAL_VARIANT || uv.id == 0:
            rt_error(ip, a, n, i18.Tr("invalid Variant unwrap"))
            ret val_null()
        end
        vv := ip.variants.get(uv.id)[0]
        if !vv.has_boxed:
            rt_error(ip, a, n, i18.Tr("invalid Variant unwrap"))
            ret val_null()
        end
        ret vv.boxed
    end
    if k == at.AST_UNARY:
        uav := eval(ip, a, env, nd.a)
        if ip.failed:
            ret val_null()
        end
        if uav.kind == VAL_STRUCT:
            mut ufound := false
            ur := try_struct_op(ip, a, nd.op, uav, val_null(), false, ufound)
            if ufound:
                ret ur
            end
        end
        if nd.op == tok.TK_MINUS:
            if uav.kind == VAL_FLOAT:
                ret val_float(0.0 - uav.f)
            end
            ret val_int(((0 as u64) - (to_int(uav) as u64)) as i64)
        end
        if nd.op == tok.TK_NOT:
            ret val_bool(!to_bool(uav))
        end
        if nd.op == tok.TK_TILDE:
            ret val_int((~(to_int(uav) as u64)) as i64)
        end
        ret uav
    end
    if k == at.AST_INCDEC:
        mut loc := interp_resolve_loc(ip, a, env, nd.a)
        if ip.failed:
            ret val_null()
        end
        cur := interp_loc_get(ip, a, loc)
        if ip.failed:
            ret val_null()
        end
        base := nd.op == tok.TK_PLUS_PLUS ? tok.TK_PLUS : tok.TK_MINUS
        updated := arith(ip, a, n, base, cur, val_int(1 as i64))
        if ip.failed:
            ret val_null()
        end
        interp_loc_set(ip, a, loc, updated)
        ret nd.is_prefix ? updated : cur
    end
    if k == at.AST_CAST:
        cav := eval(ip, a, env, nd.a)
        if ip.failed:
            ret val_null()
        end
        ts := nd.ty != 0 ? at.Get(a, nd.ty).type_str : ""
        tn := str.Len(ts)
        if tn != 0 && byte_at(ts, tn - 1) == 42:
            mut addr := 0 as i64
            if cav.kind == VAL_STR:
                svp := cav.s as void*
                addr = svp as i64
            else:
                addr = to_int(cav)
            end
            ret val_ptr(addr, ptr_elem_from_typestr(ts))
        end
        base := base_typename(ts)
        if str.Equals(base, "char"):
            ret val_char(to_int(cav))
        end
        if is_int_typename(base):
            ret val_int(to_int(cav))
        end
        if is_float_typename(base):
            ret val_float(to_float(cav))
        end
        if str.Equals(base, "bool"):
            ret val_bool(to_bool(cav))
        end
        if str.Equals(base, "str"):
            if cav.kind == VAL_PTR:
                // C: val_str((const char *)addr); NULL would be unusable —
                // map it to "" (see the PTR_STR note in the file header).
                if cav.pa == (0 as i64):
                    ret val_str("")
                end
                pv := cav.pa as void*
                ret val_str(pv as str)
            end
            ret val_str(to_str(ip, cav))
        end
        ret cav
    end
    if k == at.AST_CALL:
        ret eval_call(ip, a, env, n)
    end
    if k == at.AST_MEMBER:
        obj := nd.a
        onn := at.Get(a, obj)
        if onn.kind == at.AST_IDENTIFIER:
            mut ew := 0
            if env_find(ip, env, onn.name, ew) < 0:
                edef := find_enum(ip, onn.name)
                if edef != 0:
                    mut val := 0 as i64
                    repeat at.ChildCount(a, edef) with i:
                        m := at.Child(a, edef, i)
                        mn := at.Get(a, m)
                        if mn.a != 0:
                            val = to_int(eval(ip, a, ip.globals, mn.a))
                            if ip.failed:
                                ret val_null()
                            end
                        end
                        if str.Len(mn.name) != 0 && str.Equals(mn.name, nd.name):
                            ret val_int(val)
                        end
                        val += 1 as i64
                    end
                    rt_error(ip, a, n,
                             co.Format2(i18.Tr("enum '%s' has no member '%s'"),
                                        co.ArgStr(onn.name), co.ArgStr(nd.name)))
                    ret val_null()
                end
            end
        end
        recv := eval(ip, a, env, obj)
        if ip.failed:
            ret val_null()
        end
        if recv.kind == VAL_MODULE:
            md := ip.mods.get(recv.id)[0]
            cslot := env_find_local(ip, md.env, nd.name)
            if cslot >= 0:
                ret env_slot_val(ip, md.env, cslot)
            end
            rt_error(ip, a, n,
                     co.Format2(i18.Tr("package '%s' has no member '%s'"),
                                co.ArgStr(md.name), co.ArgStr(nd.name)))
            ret val_null()
        end
        if recv.kind == VAL_STRUCT:
            fi := st_find_field(ip, recv.id, nd.name)
            if fi >= 0:
                sv := ip.sts.get(recv.id)[0]
                ret sv.fvals.get(fi)[0]
            end
            stv := ip.sts.get(recv.id)[0]
            rt_error(ip, a, n,
                     co.Format2(i18.Tr("struct '%s' has no field '%s'"),
                                co.ArgStr(stv.type_name), co.ArgStr(nd.name)))
            ret val_null()
        end
        rt_error(ip, a, n, co.Format1(i18.Tr("cannot access member '%s'"),
                                      co.ArgStr(nd.name)))
        ret val_null()
    end
    if k == at.AST_INDEX:
        iav := eval(ip, a, env, nd.a)
        if ip.failed:
            ret val_null()
        end
        if iav.kind == VAL_STRUCT:
            stv := ip.sts.get(iav.id)[0]
            m := struct_method(a, stv.def, "operator_index")
            if m != 0:
                idx0 := eval(ip, a, env, nd.b)
                if ip.failed:
                    ret val_null()
                end
                denv := find_def_env(ip, m)
                mut ia := Vector {} as Vector<Value>
                ia.push(idx0)
                r := call_func(ip, a, m, denv != 0 ? denv : ip.globals, true, iav, ia)
                ia.free()
                ret r
            end
        end
        idxv := eval(ip, a, env, nd.b)
        if ip.failed:
            ret val_null()
        end
        if iav.kind == VAL_ARRAY:
            iv := to_int(idxv)
            ln := arr_len(ip, iav.id)
            if iv < (0 as i64) || iv >= (ln as i64):
                rt_error(ip, a, n,
                         co.Format2(i18.Tr("index %lld out of range (len %zu)"),
                                    co.ArgInt(iv), co.ArgUint(ln as u64)))
                ret val_null()
            end
            ret arr_get(ip, iav.id, iv as int)
        end
        if iav.kind == VAL_STR:
            iv2 := to_int(idxv)
            ln2 := str.Len(iav.s)
            if iv2 < (0 as i64) || iv2 >= (ln2 as i64):
                rt_error(ip, a, n, i18.Tr("string index out of range"))
                ret val_null()
            end
            ret val_char(byte_at(iav.s, iv2 as int) as i64)
        end
        if iav.kind == VAL_PTR:
            if iav.pa == (0 as i64):
                rt_error(ip, a, n, i18.Tr("dereference of a null pointer"))
                ret val_null()
            end
            ret ptr_load(iav.pa, iav.pe, to_int(idxv))
        end
        if to_int(idxv) == (0 as i64):
            ret iav
        end
        rt_error(ip, a, n, i18.Tr("value is not indexable"))
        ret val_null()
    end
    if k == at.AST_SLICE:
        basev := eval(ip, a, env, nd.a)
        if ip.failed:
            ret val_null()
        end
        if basev.kind != VAL_ARRAY:
            rt_error(ip, a, n, i18.Tr("cannot slice a non-array value"))
            ret val_null()
        end
        blen := arr_len(ip, basev.id) as i64
        mut lo := 0 as i64
        if nd.b != 0:
            lo = to_int(eval(ip, a, env, nd.b))
            if ip.failed:
                ret val_null()
            end
        end
        mut hi := blen
        if nd.c != 0:
            hi = to_int(eval(ip, a, env, nd.c))
            if ip.failed:
                ret val_null()
            end
        end
        if lo < (0 as i64):
            lo = 0 as i64
        end
        if hi > blen:
            hi = blen
        end
        if hi < lo:
            hi = lo
        end
        ret val_arr(arr_view(ip, basev.id, lo as int, (hi - lo) as int))
    end
    if k == at.AST_LAMBDA:
        ret mk_closure(ip, n, env)
    end
    if k == at.AST_STRUCT_LIT:
        // Keep the C's literal-name checks even though sema usually rewrites
        // HashMap/Vector literals into generic instantiations.
        if str.Equals(nd.name, "HashMap"):
            ret val_map(map_new(ip))
        end
        if str.Equals(nd.name, "Vector"):
            ret val_arr(arr_new(ip, 4))
        end
        sdef := find_struct(ip, nd.name)
        if sdef == 0:
            rt_error(ip, a, n, co.Format1(i18.Tr("unknown struct '%s'"),
                                          co.ArgStr(nd.name)))
            ret val_null()
        end
        mut nf := 0
        repeat at.ChildCount(a, sdef) with ci:
            if at.KindOf(a, at.Child(a, sdef, ci)) == at.AST_FIELD:
                nf += 1
            end
        end
        sdn := at.Get(a, sdef)
        sv := mk_struct(ip, sdn.name, sdef, nf)
        mut fi := 0
        repeat at.ChildCount(a, sdef) with i:
            f := at.Child(a, sdef, i)
            fnode := at.Get(a, f)
            if fnode.kind != at.AST_FIELD:
                continue
            end
            mut provided := 0
            repeat at.ChildCount(a, n) with j:
                p := at.Child(a, n, j)
                pn := at.Get(a, p)
                if str.Len(pn.name) != 0 && str.Equals(pn.name, fnode.name):
                    provided = p
                    break
                end
            end
            mut fval := val_null()
            if provided != 0:
                fval = eval(ip, a, env, at.Get(a, provided).a)
            else fnode.a != 0:
                fval = eval(ip, a, ip.globals, fnode.a)
            end
            if ip.failed:
                ret val_null()
            end
            st_field_set(ip, sv.id, fi, fnode.name, fval)
            fi += 1
        end
        ret sv
    end
    if k == at.AST_ARRAY_LIT:
        cnt := at.ChildCount(a, n)
        aid := arr_new(ip, cnt != 0 ? cnt : 4)
        repeat cnt with i:
            arr_push(ip, aid, eval(ip, a, env, at.Child(a, n, i)))
            if ip.failed:
                ret val_null()
            end
        end
        ret val_arr(aid)
    end
    rt_error(ip, a, n, co.Format1(i18.Tr("cannot evaluate %s"),
                                  co.ArgStr(at.KindName(k))))
    ret val_null()
end

// ===========================================================================
// ===== interp_stmt.c (stage B) =====
// ===========================================================================

// interp_match_arm — does `arm` match subj (else-arms always do).
func interp_match_arm(ip &: Interp, a &: at.Ast, env: int, arm: int,
                      subj: Value): bool:
    an := at.Get(a, arm)
    if an.op == tok.TK_KW_ELSE:
        ret true
    end
    repeat at.ChildCount(a, arm) with pi:
        pat := at.Child(a, arm, pi)
        if subj.kind == VAL_VARIANT:
            if subj.id != 0:
                pn := at.Get(a, pat)
                vv := ip.variants.get(subj.id)[0]
                if (pn.value_int as i64) == (vv.tag as i64):
                    ret true
                end
            end
        else:
            pv := eval(ip, a, env, at.Get(a, pat).a)
            if ip.failed:
                ret false
            end
            if value_eq(pv, subj):
                ret true
            end
        end
    end
    ret false
end

// interp_find_match_arm — first matching arm NodeId (0 = none).
func interp_find_match_arm(ip &: Interp, a &: at.Ast, env: int, n: int,
                           subj: Value): int:
    repeat at.ChildCount(a, n) with i:
        arm := at.Child(a, n, i)
        if interp_match_arm(ip, a, env, arm, subj):
            ret arm
        end
        if ip.failed:
            ret 0
        end
    end
    ret 0
end

// interp_resolve_loc — classify an assignment target.
func interp_resolve_loc(ip &: Interp, a &: at.Ast, env: int, target: int): Loc:
    mut loc := Loc {}
    loc.target = target
    tn := at.Get(a, target)

    if tn.kind == at.AST_IDENTIFIER:
        mut w := 0
        slot := env_find(ip, env, tn.name, w)
        if slot >= 0:
            loc.kind = ILOC_VAR
            loc.env = w
            loc.slot = slot
            ret loc
        end
        mut tw := 0
        tslot := env_find(ip, env, "this", tw)
        if tslot >= 0:
            tv := env_slot_val(ip, tw, tslot)
            if tv.kind == VAL_STRUCT:
                fi := st_find_field(ip, tv.id, tn.name)
                if fi >= 0:
                    loc.kind = ILOC_FIELD
                    loc.obj = tv
                    loc.field_idx = fi
                    ret loc
                end
            end
        end
        rt_error(ip, a, target,
                 co.Format1(i18.Tr("assignment to undeclared variable '%s'"),
                            co.ArgStr(tn.name)))
        ret loc
    end

    if tn.kind == at.AST_MEMBER:
        obj := eval(ip, a, env, tn.a)
        if ip.failed:
            ret loc
        end
        if obj.kind != VAL_STRUCT:
            rt_error(ip, a, target, i18.Tr("cannot assign to member of non-struct"))
            ret loc
        end
        fi2 := st_find_field(ip, obj.id, tn.name)
        if fi2 >= 0:
            loc.kind = ILOC_FIELD
            loc.obj = obj
            loc.field_idx = fi2
            ret loc
        end
        stv := ip.sts.get(obj.id)[0]
        rt_error(ip, a, target,
                 co.Format2(i18.Tr("struct '%s' has no field '%s'"),
                            co.ArgStr(stv.type_name), co.ArgStr(tn.name)))
        ret loc
    end

    if tn.kind == at.AST_INDEX:
        av := eval(ip, a, env, tn.a)
        if ip.failed:
            ret loc
        end
        if av.kind == VAL_STRUCT:
            stv2 := ip.sts.get(av.id)[0]
            set_m := struct_method(a, stv2.def, "operator_index_set")
            if set_m != 0:
                loc.kind = ILOC_OPIDX
                loc.obj = av
                loc.key = eval(ip, a, env, tn.b)
                loc.set_m = set_m
                loc.get_m = struct_method(a, stv2.def, "operator_index")
                ret loc
            end
            rt_error(ip, a, target, i18.Tr("value is not index-assignable"))
            ret loc
        end
        if av.kind == VAL_ARRAY:
            iv := to_int(eval(ip, a, env, tn.b))
            if ip.failed:
                ret loc
            end
            if iv < (0 as i64) || iv >= (arr_len(ip, av.id) as i64):
                rt_error(ip, a, target, i18.Tr("index out of range in assignment"))
                ret loc
            end
            loc.kind = ILOC_ARR
            loc.arr = av.id
            loc.idx = iv
            ret loc
        end
        if av.kind == VAL_PTR:
            if av.pa == (0 as i64):
                rt_error(ip, a, target, i18.Tr("write through a null pointer"))
                ret loc
            end
            loc.kind = ILOC_PTR
            loc.pa = av.pa
            loc.pe = av.pe
            loc.idx = to_int(eval(ip, a, env, tn.b))
            ret loc
        end
        rt_error(ip, a, target, i18.Tr("value is not index-assignable"))
        ret loc
    end

    rt_error(ip, a, target, i18.Tr("invalid assignment target"))
    ret loc
end

func interp_loc_get(ip &: Interp, a &: at.Ast, loc &: Loc): Value:
    if loc.kind == ILOC_VAR:
        ret env_slot_val(ip, loc.env, loc.slot)
    end
    if loc.kind == ILOC_FIELD:
        s := ip.sts.get(loc.obj.id)[0]
        ret s.fvals.get(loc.field_idx)[0]
    end
    if loc.kind == ILOC_ARR:
        ret arr_get(ip, loc.arr, loc.idx as int)
    end
    if loc.kind == ILOC_PTR:
        ret ptr_load(loc.pa, loc.pe, loc.idx)
    end
    // ILOC_OPIDX
    if loc.get_m != 0:
        denv := find_def_env(ip, loc.get_m)
        mut ka := Vector {} as Vector<Value>
        ka.push(loc.key)
        r := call_func(ip, a, loc.get_m, denv != 0 ? denv : ip.globals, true,
                       loc.obj, ka)
        ka.free()
        ret r
    end
    rt_error(ip, a, loc.target, i18.Tr("value is not index-readable"))
    ret val_null()
end

func interp_loc_set(ip &: Interp, a &: at.Ast, loc &: Loc, v: Value):
    if loc.kind == ILOC_VAR:
        env_slot_set(ip, loc.env, loc.slot, v)
        ret
    end
    if loc.kind == ILOC_FIELD:
        st_field_set_val(ip, loc.obj.id, loc.field_idx, v)
        ret
    end
    if loc.kind == ILOC_ARR:
        arr_set(ip, loc.arr, loc.idx as int, v)
        ret
    end
    if loc.kind == ILOC_PTR:
        ptr_store(loc.pa, loc.pe, loc.idx, v)
        ret
    end
    // ILOC_OPIDX
    mut sargs := Vector {} as Vector<Value>
    sargs.push(loc.key)
    sargs.push(v)
    denv := find_def_env(ip, loc.set_m)
    _r := call_func(ip, a, loc.set_m, denv != 0 ? denv : ip.globals, true,
                    loc.obj, sargs)
    sargs.free()
end

func interp_assign_to(ip &: Interp, a &: at.Ast, env: int, target: int, v: Value):
    mut loc := interp_resolve_loc(ip, a, env, target)
    if ip.failed:
        ret
    end
    interp_loc_set(ip, a, loc, v)
end

// take_pending_flow — consumes ip.pending_flow (set by eval_match when a
// break/continue escaped a match arm in expression position).
func take_pending_flow(ip &: Interp, out &: int): bool:
    if ip.pending_flow == FLOW_NORMAL:
        ret false
    end
    out = ip.pending_flow
    ip.pending_flow = FLOW_NORMAL
    ret true
end

// The C REP_NUM macro — evaluates a repeat header operand; msg is the
// pre-translated "repeat ... must be a number" text.
func rep_num(ip &: Interp, a &: at.Ast, env: int, node: int, msg: str,
             out &: i64): bool:
    v := eval(ip, a, env, node)
    if v.kind == VAL_INT:
        out = v.i
        ret true
    end
    if v.kind == VAL_FLOAT:
        out = v.f as i64
        ret true
    end
    rt_error(ip, a, node, msg)
    ret false
end

// exec_stmt (interp_stmt.c) — returns a FLOW_* code; cooperative unwinding
// makes every loop exit when ip.failed is set (the C longjmp'd instead).
func exec_stmt(ip &: Interp, a &: at.Ast, env: int, fr &: Frame, n: int,
               retv &: Value): int:
    tick(ip)
    if ip.failed:
        ret FLOW_NORMAL
    end
    nd := at.Get(a, n)
    k := nd.kind

    if k == at.AST_BLOCK:
        child := env_new(ip, env)
        ret exec_list(ip, a, child, fr, n, retv)
    end
    if k == at.AST_VAR_DECL || k == at.AST_CONST_DECL:
        mut v := val_null()
        if nd.a != 0:
            v = eval(ip, a, env, nd.a)
            if ip.failed:
                ret FLOW_NORMAL
            end
            mut pf := FLOW_NORMAL
            if take_pending_flow(ip, pf):
                ret pf
            end
        else:
            v = default_for_type(ip, nd.type_str)
        end
        env_define(ip, env, nd.name, v)
        ret FLOW_NORMAL
    end
    if k == at.AST_EXPR_STMT:
        _v := eval(ip, a, env, nd.a)
        mut pf1 := FLOW_NORMAL
        if take_pending_flow(ip, pf1):
            ret pf1
        end
        ret FLOW_NORMAL
    end
    if k == at.AST_ASSIGN:
        if nd.op == tok.TK_ASSIGN:
            rhs := eval(ip, a, env, nd.b)
            if ip.failed:
                ret FLOW_NORMAL
            end
            mut pf2 := FLOW_NORMAL
            if take_pending_flow(ip, pf2):
                ret pf2
            end
            interp_assign_to(ip, a, env, nd.a, rhs)
            ret FLOW_NORMAL
        end
        base := compound_base(nd.op)
        mut loc := interp_resolve_loc(ip, a, env, nd.a)
        if ip.failed:
            ret FLOW_NORMAL
        end
        cur := interp_loc_get(ip, a, loc)
        if ip.failed:
            ret FLOW_NORMAL
        end
        r := eval(ip, a, env, nd.b)
        if ip.failed:
            ret FLOW_NORMAL
        end
        mut pf3 := FLOW_NORMAL
        if take_pending_flow(ip, pf3):
            ret pf3
        end
        mut found := false
        sr := try_struct_op(ip, a, base, cur, r, true, found)
        rhs2 := found ? sr : arith(ip, a, n, base, cur, r)
        if ip.failed:
            ret FLOW_NORMAL
        end
        interp_loc_set(ip, a, loc, rhs2)
        ret FLOW_NORMAL
    end
    if k == at.AST_IF:
        cv := eval(ip, a, env, nd.a)
        if ip.failed:
            ret FLOW_NORMAL
        end
        cond := to_bool(cv)
        mut pf4 := FLOW_NORMAL
        if take_pending_flow(ip, pf4):
            ret pf4
        end
        if cond:
            c := env_new(ip, env)
            ret exec_list(ip, a, c, fr, nd.b, retv)
        end
        if nd.c != 0:
            if at.KindOf(a, nd.c) == at.AST_IF:
                ret exec_stmt(ip, a, env, fr, nd.c, retv)
            end
            c2 := env_new(ip, env)
            ret exec_list(ip, a, c2, fr, nd.c, retv)
        end
        ret FLOW_NORMAL
    end
    if k == at.AST_UNTIL:
        until true:
            tick(ip)
            if ip.failed:
                ret FLOW_NORMAL
            end
            ucv := eval(ip, a, env, nd.a)
            if ip.failed:
                ret FLOW_NORMAL
            end
            cond := to_bool(ucv)
            mut pf5 := FLOW_NORMAL
            if take_pending_flow(ip, pf5):
                ret pf5
            end
            if !cond:
                break
            end
            c := env_new(ip, env)
            f := exec_list(ip, a, c, fr, nd.b, retv)
            if f == FLOW_RETURN:
                ret f
            end
            if f == FLOW_BREAK:
                break
            end
            if ip.failed:
                ret FLOW_NORMAL
            end
        end
        ret FLOW_NORMAL
    end
    if k == at.AST_REPEAT:
        mut start := 0 as i64
        mut endv := 0 as i64
        mut step := 1 as i64
        if nd.c != 0:
            if !rep_num(ip, a, env, nd.a, i18.Tr("repeat range start must be a number"),
                        start):
                ret FLOW_NORMAL
            end
            if !rep_num(ip, a, env, nd.c, i18.Tr("repeat range bound must be a number"),
                        endv):
                ret FLOW_NORMAL
            end
            if nd.d != 0:
                if !rep_num(ip, a, env, nd.d, i18.Tr("repeat step must be a number"),
                            step):
                    ret FLOW_NORMAL
                end
            else:
                step = 1 as i64
            end
            if step <= (0 as i64):
                rt_error(ip, a, nd.d != 0 ? nd.d : n,
                         i18.Tr("repeat step must be positive"))
                ret FLOW_NORMAL
            end
            if start > endv:
                step = (0 as i64) - step
            end
        else:
            if !rep_num(ip, a, env, nd.a, i18.Tr("repeat count must be a number"),
                        endv):
                ret FLOW_NORMAL
            end
            start = 0 as i64
            endv -= 1 as i64
            step = 1 as i64
        end
        mut kk := start
        until (step > (0 as i64)) ? (kk <= endv) : (kk >= endv):
            tick(ip)
            if ip.failed:
                ret FLOW_NORMAL
            end
            c := env_new(ip, env)
            if str.Len(nd.name) != 0:
                env_define(ip, c, nd.name, val_int(kk))
            end
            f := exec_list(ip, a, c, fr, nd.b, retv)
            if f == FLOW_RETURN:
                ret f
            end
            if f == FLOW_BREAK:
                break
            end
            if ip.failed:
                ret FLOW_NORMAL
            end
            kk += step
        end
        ret FLOW_NORMAL
    end
    if k == at.AST_FOR:
        loop := env_new(ip, env)
        if nd.a != 0:
            _fi := exec_stmt(ip, a, loop, fr, nd.a, retv)
        end
        until true:
            tick(ip)
            if ip.failed:
                ret FLOW_NORMAL
            end
            mut cond := true
            if nd.b != 0:
                fcv := eval(ip, a, loop, nd.b)
                if ip.failed:
                    ret FLOW_NORMAL
                end
                cond = to_bool(fcv)
            end
            mut pf6 := FLOW_NORMAL
            if take_pending_flow(ip, pf6):
                ret pf6
            end
            if !cond:
                break
            end
            c := env_new(ip, loop)
            f := exec_list(ip, a, c, fr, nd.d, retv)
            if f == FLOW_RETURN:
                ret f
            end
            if f == FLOW_BREAK:
                break
            end
            if ip.failed:
                ret FLOW_NORMAL
            end
            if nd.c != 0:
                _fc := exec_stmt(ip, a, loop, fr, nd.c, retv)
            end
        end
        ret FLOW_NORMAL
    end
    if k == at.AST_MATCH:
        subj := eval(ip, a, env, nd.a)
        if ip.failed:
            ret FLOW_NORMAL
        end
        arm := interp_find_match_arm(ip, a, env, n, subj)
        if arm == 0 || ip.failed:
            ret FLOW_NORMAL
        end
        c := env_new(ip, env)
        ret exec_list(ip, a, c, fr, at.Get(a, arm).b, retv)
    end
    if k == at.AST_RETURN:
        if nd.a != 0:
            retv = eval(ip, a, env, nd.a)
        else:
            retv = val_null()
        end
        ret ip.match_expr_depth > 0 ? FLOW_MATCH_RET : FLOW_RETURN
    end
    if k == at.AST_BREAK:
        ret FLOW_BREAK
    end
    if k == at.AST_CONTINUE:
        ret FLOW_CONTINUE
    end
    if k == at.AST_DEFER:
        fr.defer_stmts.push(nd.a)
        fr.defer_envs.push(env)
        ret FLOW_NORMAL
    end
    _dv := eval(ip, a, env, n)
    ret FLOW_NORMAL
end

