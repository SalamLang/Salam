// Port of compiler/src/langpack/ (langpack.c, langpack.h,
// langpack_internal.h, langpack_data.c). Flat single-file module
// (see salam/PORTING.md "Layout — FLAT"): langpack_lookup.c merged below
// with a `// ===== <file>.c =====` marker.
//
// This file carries the package's globals (the keyword/contextual tables of
// langpack_data.c) and every private helper so the file satisfies
// E083/E085/E088; langpack_data.c therefore has
// no separate sibling file — its tables live here.
//
// C -> Salam decisions for this module:
// - langpack_t* handle -> `pub type Langpack = int` with LP_NONE/LP_EN/
//   LP_FA/LP_AR constants. langpack_load() returns LP_NONE where the C
//   returns NULL; accessors answer "" / 0-length for LP_NONE instead of
//   dereferencing NULL.
// - kw_entry_t[] tables -> parallel arrays k_kw_kind_* (int, the TK_*
//   values from salam/token.salam, identical to the C enum) and
//   k_kw_spell_* (str, byte-for-byte the C spellings; generated
//   mechanically from langpack_data.c).
// - ctx_entry_t[] tables -> parallel arrays k_ctx_canon_* / k_ctx_spell_*.
// - k_entry_fa / k_entry_ar keep the exact C byte sequences (note the ar
//   entry point intentionally contains U+06CC Farsi Yeh, as in the C hex).
// - langpack_free() is a no-op in C (static packs) and here too.
// - The byte-level kw_fold()/kw_ident_equal() loose matcher is re-expressed
//   over UTF-8 codepoints via str.Chars — equivalent for valid UTF-8:
//   spaces and ZWNJ are skipped, U+064A Arabic Yeh and U+06CC Farsi Yeh
//   fold together, U+0643 Arabic Kaf and U+06A9 Keheh fold together.
package langpack

import str
import tok "token.salam"

// langpack_t handles (C: &g_lang_en / &g_lang_fa / &g_lang_ar, NULL)
pub const LP_NONE := 0
pub const LP_EN := 1
pub const LP_FA := 2
pub const LP_AR := 3

// ZWNJ (U+200C) and the folded letter pairs of kw_fold() (langpack_lookup.c)
k_lp_zwnj := "\xE2\x80\x8C"
k_lp_yeh_ar := "\xD9\x8A"  // U+064A ARABIC LETTER YEH
k_lp_yeh_fa := "\xDB\x8C"  // U+06CC ARABIC LETTER FARSI YEH
k_lp_kaf_ar := "\xD9\x83"  // U+0643 ARABIC LETTER KAF
k_lp_keheh := "\xDA\xA9"   // U+06A9 ARABIC LETTER KEHEH

