k_entry_fa := "اصلی"
k_entry_ar := "الرئیسیة"

// langpack_t / Langpack handle type (see file header)
pub type Langpack = int

// ---------------------------------------------------------------------------
// Private helpers (must precede the first pub function of the merged
// package — rule E088).
// ---------------------------------------------------------------------------

// struct langpack .keywords length for a handle
func kw_count(p: int): int:
    if p == LP_EN:
        ret len(k_kw_kind_en)
    end
    if p == LP_FA:
        ret len(k_kw_kind_fa)
    end
    if p == LP_AR:
        ret len(k_kw_kind_ar)
    end
    ret 0
end

// keywords[i].kind for a handle
func kw_kind_at(p: int, i: int): int:
    if p == LP_EN:
        ret k_kw_kind_en[i]
    end
    if p == LP_FA:
        ret k_kw_kind_fa[i]
    end
    ret k_kw_kind_ar[i]
end

// keywords[i].spelling for a handle
func kw_spell_at(p: int, i: int): str:
    if p == LP_EN:
        ret k_kw_spell_en[i]
    end
    if p == LP_FA:
        ret k_kw_spell_fa[i]
    end
    ret k_kw_spell_ar[i]
end

// struct langpack .contextual length (NULL for en -> 0)
func ctx_count(p: int): int:
    if p == LP_FA:
        ret len(k_ctx_canon_fa)
    end
    if p == LP_AR:
        ret len(k_ctx_canon_ar)
    end
    ret 0
end

// contextual[i].canon for a handle
func ctx_canon_at(p: int, i: int): str:
    if p == LP_FA:
        ret k_ctx_canon_fa[i]
    end
    ret k_ctx_canon_ar[i]
end

// contextual[i].spelling for a handle
func ctx_spell_at(p: int, i: int): str:
    if p == LP_FA:
        ret k_ctx_spell_fa[i]
    end
    ret k_ctx_spell_ar[i]
end

// The skip set of kw_ident_equal(): spaces and ZWNJ are ignored.
func kw_is_skip(c: str): bool:
    ret str.Equals(c, " ") || str.Equals(c, k_lp_zwnj)
end

// kw_fold (langpack_lookup.c): fold the two Yeh forms together (C code
// 0x101) and the two Kaf forms together (C code 0x102); anything else
// represents itself. \x01/\x02 cannot appear in identifiers, so they are
// safe stand-ins for the C fold codes.
func kw_fold_char(c: str): str:
    if str.Equals(c, k_lp_yeh_ar) || str.Equals(c, k_lp_yeh_fa):
        ret "\x01"
    end
    if str.Equals(c, k_lp_kaf_ar) || str.Equals(c, k_lp_keheh):
        ret "\x02"
    end
    ret c
end

// Normalized spelling: skip set removed, fold classes applied. Comparing
// two normalized spellings is exactly the C kw_ident_equal() loop.
func kw_normalize(s: str): str:
    cs := str.Chars(s)
    defer cs.free()
    mut out := ""
    each c in cs:
        if !kw_is_skip(c):
            out = out + kw_fold_char(c)
        end
    end
    ret out
end

// kw_ident_equal (langpack_lookup.c)
func kw_ident_equal(a: str, b: str): bool:
    ret str.Equals(kw_normalize(a), kw_normalize(b))
end

// The has_join scan of langpack_lookup_keyword(): true when ident contains
// a space, ZWNJ, or one of the foldable Yeh/Kaf letters — only then is the
// loose pass worth running.
func has_join_char(ident: str): bool:
    cs := str.Chars(ident)
    defer cs.free()
    mut found := false
    each c in cs:
        if kw_is_skip(c) || str.Equals(c, k_lp_yeh_ar) || str.Equals(c, k_lp_yeh_fa) || str.Equals(c, k_lp_kaf_ar) || str.Equals(c, k_lp_keheh):
            found = true
        end
    end
    ret found
end

// ---------------------------------------------------------------------------
// Public API of langpack.c
// ---------------------------------------------------------------------------

// langpack_load — LP_NONE where the C returns NULL.
pub func Load(code: str): Langpack:
    if str.Equals(code, "en"):
        ret LP_EN
    end
    if str.Equals(code, "fa"):
        ret LP_FA
    end
    if str.Equals(code, "ar"):
        ret LP_AR
    end
    ret LP_NONE
end

// langpack_free — packs are static, nothing to release.
pub func Free(_p: Langpack):
    ret
end

// langpack_code
pub func Code(p: Langpack): str:
    if p == LP_EN:
        ret "en"
    end
    if p == LP_FA:
        ret "fa"
    end
    if p == LP_AR:
        ret "ar"
    end
    ret ""
end

// langpack_entry — the localized entry-point function name.
pub func Entry(p: Langpack): str:
    if p == LP_EN:
        ret "main"
    end
    if p == LP_FA:
        ret k_entry_fa
    end
    if p == LP_AR:
        ret k_entry_ar
    end
    ret ""
end

// langpack_entry_for — "main" for unknown codes, like the C ternary.
pub func EntryFor(code: str): str:
    p := Load(code)
    if p == LP_NONE:
        ret "main"
    end
    ret Entry(p)
end

// langpack_end_spelling — the localized spelling of the 'end' keyword.
pub func EndSpelling(p: Langpack): str:
    n := kw_count(p)
    mut i := 0
    until i < n:
        if kw_kind_at(p, i) == tok.TK_KW_END:
            ret kw_spell_at(p, i)
        end
        i += 1
    end
    ret "end"
end

// ===== langpack_lookup.c =====
// Port of compiler/src/langpack/langpack_lookup.c (the two pub lookups;
// the private helpers kw_fold/kw_ident_equal/has_join live in
// langpack.salam so the merged package satisfies E088).
// Merged into this flat file: tables and helpers are referenced
// unqualified.
//
// Notes vs the C version:
// - langpack_canon_word() returns NULL when there is no contextual table
//   (en) or no match; this port returns "" (canonical words are never
//   empty, so "" is an unambiguous "no translation" sentinel).
// - Called with LP_NONE, both lookups scan zero entries and fall through
//   to their miss result (the C would dereference NULL).


// langpack_lookup_keyword — token kind for a keyword spelling, TK_IDENT
// when ident is not a keyword of this pack. Pass 1 is an exact match;
// pass 2 (only when ident contains a space/ZWNJ/foldable letter) ignores
// spaces and ZWNJ and folds the Yeh and Kaf letter pairs.
pub func LookupKeyword(p: Langpack, ident: str): int:
    n := kw_count(p)
    mut i := 0
    until i < n:
        if str.Equals(kw_spell_at(p, i), ident):
            ret kw_kind_at(p, i)
        end
        i += 1
    end
    if has_join_char(ident):
        i = 0
        until i < n:
            if kw_ident_equal(kw_spell_at(p, i), ident):
                ret kw_kind_at(p, i)
            end
            i += 1
        end
    end
    ret tok.TK_IDENT
end

// langpack_canon_word — canonical English form of a contextual (soft)
// keyword, "" when ident has no mapping in this pack.
pub func CanonWord(p: Langpack, ident: str): str:
    n := ctx_count(p)
    mut i := 0
    until i < n:
        if str.Equals(ctx_spell_at(p, i), ident):
            ret ctx_canon_at(p, i)
        end
        i += 1
    end
    ret ""
end
