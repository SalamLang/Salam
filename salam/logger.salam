// Flat merge of the salam/logger port (see salam/PORTING.md "Layout — FLAT"):
// logger.c (+ logger.h, logger_internal.h) + logger_level.c + logger_emit.c —
// one package `logger`, one file.
//
// C -> Salam decisions for this module:
// - log_level_t / phase_t enums -> pub int constants (LOG_*, PH_*): imported
//   enum members cannot be referenced across files (alias.Enum.Member is not
//   supported), so levels/phases travel as plain ints.
// - FILE *sink -> dropped; the logger always writes to stderr via io.EPrint*
//   (the C compiler only ever passes stderr).
// - logger_t* -> value struct Logger; setters take it by reference (&:).
// - i18n_tr() is skipped (identity for English); it applies unchanged until
//   the i18n module is ported.
// - The rich diagnostic path (logger_emit_rich -> diag_render) falls back to
//   plain emission until wired to the diag module; SetDiagSource state is
//   stored but not yet consumed here.
// - printf-style fmt/varargs -> callers pass a pre-formatted message string.
package logger

import str
import io
import time

// ===== logger.c =====
// log_level_t
pub const LOG_TRACE := 0
pub const LOG_DEBUG := 1
pub const LOG_INFO := 2
pub const LOG_WARN := 3
pub const LOG_ERROR := 4
pub const LOG_OFF := 5

// phase_t
pub const PH_DRIVER := 0
pub const PH_CLI := 1
pub const PH_LEXER := 2
pub const PH_PARSER := 3
pub const PH_SEMANTIC := 4
pub const PH_IR := 5
pub const PH_CODEGEN := 6

// diag_style_t / diag_format_t values live in the diag module
// (salam/diag.salam: DIAG_STYLE_* / DIAG_FORMAT_*); the logger stores
// them as plain ints. 0 = DIAG_STYLE_RUST = DIAG_FORMAT_HUMAN.

// struct logger (logger_internal.h) — sink is always stderr in this port
pub struct Logger:
    pub min_level: int = 2
    pub color: bool = false
    pub timestamps: bool = true
    pub diag_rich: bool = false
    pub diag_style: int = 0
    pub diag_format: int = 0
    pub src_text: str = ""
    pub src_len: int = 0
end

// ===== logger_emit.c =====
// k_level_colors — index = level; reset is "\x1b[0m"
func level_color(level: int): str:
    ret match level:
        0 => "\x1b[90m"
        1 => "\x1b[36m"
        2 => "\x1b[32m"
        3 => "\x1b[33m"
        4 => "\x1b[31m"
        else => "\x1b[0m"
    end
end

// logger_write_timestamp — "[YYYY-MM-DD HH:MM:SS]" local time
func timestamp_str(): str:
    ret "[" + time.Format(time.Now()) + "]"
end

// ===== logger.c =====
// logger_new — sink parameter dropped (always stderr)
pub func New(min_level: int, color: bool): Logger:
    mut lg := Logger {}
    lg.min_level = min_level
    lg.color = color
    lg.timestamps = true
    lg.diag_rich = false
    lg.diag_style = 0  // diag.DIAG_STYLE_RUST
    lg.diag_format = 0 // diag.DIAG_FORMAT_HUMAN
    lg.src_text = ""
    lg.src_len = 0
    ret lg
end

// logger_free — Logger is a value struct, nothing to release
pub func Free(_lg: Logger):
    ret
end

// logger_set_diag_source
pub func SetDiagSource(lg &: Logger, src_text: str, src_len: int, style: int, format: int):
    lg.diag_rich = str.Len(src_text) > 0
    lg.src_text = src_text
    lg.src_len = src_len
    lg.diag_style = style
    lg.diag_format = format
end

// logger_set_timestamps
pub func SetTimestamps(lg &: Logger, enabled: bool):
    lg.timestamps = enabled
end

// logger_set_level
pub func SetLevel(lg &: Logger, min_level: int):
    lg.min_level = min_level
end

// logger_get_level
pub func GetLevel(lg: Logger): int:
    ret lg.min_level
end

// ===== logger_level.c =====
// log_level_name
pub func LevelName(level: int): str:
    ret match level:
        0 => "TRACE"
        1 => "DEBUG"
        2 => "INFO"
        3 => "WARN"
        4 => "ERROR"
        5 => "OFF"
        else => "?"
    end
end

// log_phase_name
pub func PhaseName(phase: int): str:
    ret match phase:
        0 => "DRIVER"
        1 => "CLI"
        2 => "LEXER"
        3 => "PARSER"
        4 => "SEMANTIC"
        5 => "IR"
        6 => "CODEGEN"
        else => "?"
    end
end

// log_level_from_string — case-insensitive, accepts "warning" for WARN
pub func LevelFromString(s: str, out &: int): bool:
    if str.EqualFold(s, "trace"):
        out = 0
        ret true
    end
    if str.EqualFold(s, "debug"):
        out = 1
        ret true
    end
    if str.EqualFold(s, "info"):
        out = 2
        ret true
    end
    if str.EqualFold(s, "warn") || str.EqualFold(s, "warning"):
        out = 3
        ret true
    end
    if str.EqualFold(s, "error"):
        out = 4
        ret true
    end
    if str.EqualFold(s, "off"):
        out = 5
        ret true
    end
    ret false
end

// ===== logger_emit.c =====
// Level filter from logger_log: true when a message at `level` is emitted.
pub func Enabled(lgr: Logger, level: int): bool:
    if level < lgr.min_level || lgr.min_level == LOG_OFF:
        ret false
    end
    ret true
end

// logger_emit_plain, as a pure-formatting step (no trailing newline).
// Pass file = "" for a message without a source location.
pub func FormatPlain(lgr: Logger, phase: int, level: int, file: str, line: int, col: int, msg: str): str:
    mut out := ""
    if lgr.timestamps:
        out = timestamp_str()
    end
    if lgr.color:
        out = out + "[" + PhaseName(phase) + "][" + level_color(level) +
              LevelName(level) + "\x1b[0m" + "] "
    else:
        out = out + "[" + PhaseName(phase) + "][" + LevelName(level) + "] "
    end
    out = out + msg
    if str.Len(file) > 0:
        out = out + " (" + file + ":" + line + ":" + col + ")"
    end
    ret out
end

// logger_log without a source location (LOG_T/D/I/W/E macros)
pub func Log(lgr: Logger, phase: int, level: int, msg: str):
    if !Enabled(lgr, level):
        ret
    end
    io.EPrintln(FormatPlain(lgr, phase, level, "", 0, 0, msg))
end

// logger_log with file + span (LOG_*_AT macros)
pub func LogAt(lgr: Logger, phase: int, level: int, file: str, line: int, col: int, msg: str):
    if !Enabled(lgr, level):
        ret
    end
    io.EPrintln(FormatPlain(lgr, phase, level, file, line, col, msg))
end
