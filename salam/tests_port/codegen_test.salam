// Unit tests for the codegen port, stages 6a+6b (see salam/codegen.salam):
// type -> C emission, mangling, print_fmt segments, cident, tidy, the
// generated header for a small checked module, the .c scaffolding (dyn
// vtables, private protos, globals, main shell), and — 6b — expression,
// statement, call, and lambda-lifting emission. Expected C text was
// derived from compiler/src/codegen/*.c AND from HEAD `bin/salam build
// --keep-c` output on the same programs (salam_mod_cgref.{h,c} and the
// tmp_cg/cgexpr.salam, tmp_cg/cglam.salam fixtures).
package main

import testing
import os
import str
import tok "../token.salam"
import src "../source.salam"
import lg "../logger.salam"
import lp "../langpack.salam"
import lx "../lexer.salam"
import at "../ast.salam"
import ps "../parser.salam"
import cc "../condcomp.salam"
import sm "../semantic.salam"
import cg "../codegen.salam"

// The fixture program (same content as the HEAD reference build cgref.salam).
func fixture_src(): str:
    ret "extern:\n" +
        "    func puts(s: str): int\n" +
        "end\n" +
        "\n" +
        "pub const MAXN := 100\n" +
        "mut g_count := 7\n" +
        "\n" +
        "struct Point:\n" +
        "    pub x: int = 0\n" +
        "    pub y: f64 = 0.0\n" +
        "    pub func dist(): f64:\n" +
        "        ret this.y\n" +
        "    end\n" +
        "end\n" +
        "\n" +
        "enum Color: Red, Green = 5, Blue end\n" +
        "\n" +
        "interface Shape:\n" +
        "    func area(): f64\n" +
        "end\n" +
        "\n" +
        "struct Circle:\n" +
        "    pub r: f64 = 0.0\n" +
        "    pub func area(): f64:\n" +
        "        ret this.r\n" +
        "    end\n" +
        "end\n" +
        "\n" +
        "func helper(s: str): str:\n" +
        "    ret s\n" +
        "end\n" +
        "\n" +
        "func main:\n" +
        "    mut p := Point {}\n" +
        "    p.x = AddOne(MAXN) + g_count\n" +
        "    _d := p.dist()\n" +
        "    _sh := Circle { r = 1.0 } as dyn Shape\n" +
        "    _v := 21 as Variant<i32, str>\n" +
        "    parts := \"a,b\".split(\",\")\n" +
        "    defer parts.free()\n" +
        "    _r := puts(helper(\"hi\"))\n" +
        "    println p.x\n" +
        "end\n" +
        "\n" +
        "pub func AddOne(v: int): int:\n" +
        "    ret v + 1\n" +
        "end\n"
end

// driver pipeline: load -> lex -> parse -> prune -> sema -> codegen.
func build_module(path: str, module: str, h &: str, c &: str): bool:
    mut sf := src.New()
    if !src.Load(path, sf):
        ret false
    end
    quiet := lg.New(lg.LOG_OFF, false)
    pack := lx.Detect(sf, lp.Load("en"))
    mut toks := tok.StreamNew(path)
    _lok := lx.Run(quiet, pack, sf, toks)
    mut a := at.NewAst()
    mut prog := 0
    _pok := ps.Run(quiet, toks, a, prog)
    tok.StreamFree(toks)
    mut s := sm.New(quiet, path, lp.Code(pack))
    sm.SetCc(s, cc.TableBuild("", Vector {} as Vector<str>))
    _ck := cc.PruneProgram(a, quiet, path, s.cctab, prog)
    sok := sm.Run(s, a, prog)
    if sok:
        o := cg.Run(quiet, s, a, prog, module, false, false, path, "main",
                    "")
        h = o.h_src
        c = o.c_src
    end
    sm.Free(s)
    at.FreeAst(a)
    ret sok
end

func test_cident():
    testing.AssertEqStr(cg.Cident("count"), "count")
    testing.AssertEqStr(cg.Cident("g_count"), "g__count")
    testing.AssertEqStr(cg.Cident("if"), "if_")
    testing.AssertEqStr(cg.Cident("while"), "while_")
    testing.AssertEqStr(cg.Cident("main"), "main")
    testing.AssertEqStr(cg.Cident("2x"), "_2x")
    testing.AssertEqStr(cg.Cident(""), "_")
    testing.AssertEqStr(cg.Cident("_Bool"), "__Bool")
    testing.AssertEqStr(cg.Cident("a-b"), "a_2db")
end

func test_ctype():
    testing.AssertEqStr(cg.Ctype(""), "void")
    testing.AssertEqStr(cg.Ctype("void"), "void")
    testing.AssertEqStr(cg.Ctype("bool"), "bool")
    testing.AssertEqStr(cg.Ctype("char"), "char")
    testing.AssertEqStr(cg.Ctype("str"), "const char*")
    testing.AssertEqStr(cg.Ctype("uchar"), "const char*")
    testing.AssertEqStr(cg.Ctype("i8"), "int8_t")
    testing.AssertEqStr(cg.Ctype("i16"), "int16_t")
    testing.AssertEqStr(cg.Ctype("i32"), "int32_t")
    testing.AssertEqStr(cg.Ctype("i64"), "int64_t")
    testing.AssertEqStr(cg.Ctype("u8"), "uint8_t")
    testing.AssertEqStr(cg.Ctype("u16"), "uint16_t")
    testing.AssertEqStr(cg.Ctype("u32"), "uint32_t")
    testing.AssertEqStr(cg.Ctype("u64"), "uint64_t")
    testing.AssertEqStr(cg.Ctype("size"), "size_t")
    testing.AssertEqStr(cg.Ctype("f32"), "float")
    testing.AssertEqStr(cg.Ctype("f64"), "double")
    testing.AssertEqStr(cg.Ctype("File"), "salam_file")
    // "int" is NOT in base_ctype's table (sema canonicalizes to i32); the
    // C falls through to cident, which appends '_' to C keywords.
    testing.AssertEqStr(cg.Ctype("int"), "int_")
    testing.AssertEqStr(cg.Ctype("Point"), "Point")
    testing.AssertEqStr(cg.Ctype("Point*"), "Point*")
    testing.AssertEqStr(cg.Ctype("i64*"), "int64_t*")
    testing.AssertEqStr(cg.Ctype("i32[3]"), "int32_t*")
    testing.AssertEqStr(cg.Ctype("slice<i32>"), "salam_slice")
    testing.AssertEqStr(cg.Ctype("func(i32) i32"), "void*")
    testing.AssertEqStr(cg.Ctype("externfunc(i32) void"), "void*")
    testing.AssertEqStr(cg.Ctype("dyn Shape"), "_Salam_dyn_Shape")
    testing.AssertEqStr(cg.Ctype("dyn Shape*"), "_Salam_dyn_Shape*")
    // '[' suffix also gets the '*' in cg_ctype (bug-compat with the C).
    testing.AssertEqStr(cg.Ctype("dyn Shape[2]"), "_Salam_dyn_Shape*")
    testing.AssertEqStr(cg.Ctype("Variant<i32, str>"),
                        "_Salam_variant_i32_str")
    testing.AssertEqStr(cg.Ctype("Variant<i32, Vector<str>>"),
                        "_Salam_variant_i32_Vector_3cstr_3e")
    testing.AssertEqStr(cg.Ctype("Vector_str"), "Vector__str")
end

func test_cdecl():
    testing.AssertEqStr(cg.CDecl("i32", "x"), "int32_t x")
    testing.AssertEqStr(cg.CDecl("str", "name"), "const char* name")
    testing.AssertEqStr(cg.CDecl("i64*", "p"), "int64_t* p")
    testing.AssertEqStr(cg.CDecl("i32[3]", "xs"), "int32_t xs[3]")
    testing.AssertEqStr(cg.CDecl("i32[2][3]", "grid"), "int32_t grid[2][3]")
    testing.AssertEqStr(cg.CDecl("slice<str>", "sv"), "salam_slice sv")
    testing.AssertEqStr(cg.CDecl("dyn Shape", "sh"), "_Salam_dyn_Shape sh")
    testing.AssertEqStr(cg.CDecl("dyn Shape*", "p"), "_Salam_dyn_Shape* p")
    testing.AssertEqStr(cg.CDecl("dyn Shape[2]", "arr"),
                        "_Salam_dyn_Shape arr[2]")
    testing.AssertEqStr(cg.CDecl("func(i32) i32", "cb"), "void* cb")
    testing.AssertEqStr(cg.CDecl("Variant<i32, str>", "v"),
                        "_Salam_variant_i32_str v")
    testing.AssertEqStr(cg.CDecl("Color", "c"), "Color c")
end

func test_vec_variant_names():
    testing.AssertEqStr(cg.VecCname("Vector<i32>"), "Vector_i32")
    testing.AssertEqStr(cg.VecCname("Vector<str>"), "Vector_str")
    testing.AssertEqStr(cg.VecCname("Vector<Vector<i32>>"),
                        "Vector_Vector_3ci32_3e")
    testing.AssertEqStr(cg.VecElem("Vector< str >"), "str")
    testing.AssertEqStr(cg.VecElem("Vector<i32>"), "i32")
    testing.AssertEqStr(cg.VariantCname("Variant<i32, f64>"),
                        "_Salam_variant_i32_f64")
    testing.AssertEqInt(cg.VariantTagOf("Variant<i32, str>", "i32"), 0)
    testing.AssertEqInt(cg.VariantTagOf("Variant<i32, str>", "str"), 1)
    testing.AssertEqInt(cg.VariantTagOf("Variant<i32, str>", "f64"), 0 - 1)
    mut mv := cg.VariantMembersOf("Variant<i32, Vector<str>, f64>")
    testing.AssertEqInt(mv.len(), 3)
    testing.AssertEqStr(mv.get(1)[0], "Vector<str>")
    mv.free()
    testing.AssertTrue(cg.IsSliceTs("slice<i32>"))
    testing.AssertFalse(cg.IsSliceTs("i32"))
    testing.AssertEqStr(cg.SliceElem("slice<u8>"), "u8")
    testing.AssertTrue(cg.IsIntTypestr("i32"))
    testing.AssertTrue(cg.IsIntTypestr("size"))
    // cg_is_int_typestr's table has no "int" (bug-compat with the C).
    testing.AssertFalse(cg.IsIntTypestr("int"))
    testing.AssertTrue(cg.IsUnsignedTypestr("u8"))
    testing.AssertTrue(cg.IsUnsignedTypestr("size"))
    testing.AssertFalse(cg.IsUnsignedTypestr("i8"))
end

func test_func_types():
    testing.AssertEqStr(cg.FuncRetOf("func(i32, str) f64"), "f64")
    testing.AssertEqStr(cg.FuncRetOf("func()"), "void")
    testing.AssertEqStr(cg.FuncRetOf("i32"), "void")
    testing.AssertEqStr(cg.FuncRetOf("func(func(i32) i32) i32"), "i32")
    testing.AssertEqStr(cg.RawRetOf("externfunc(i32) void*"), "void*")
    testing.AssertEqStr(cg.RawRetOf("func(i32) i32"), "void")
    testing.AssertEqStr(cg.RawCastParams("externfunc(i32, str)"),
                        "(int32_t, const char*)")
    testing.AssertEqStr(cg.RawCastParams("externfunc()"), "(void)")
    testing.AssertEqStr(cg.RawCastParams("i32"), "(void)")
    testing.AssertEqStr(cg.FuncCastParamsEnv("func(i32, f64) i32"),
                        "(void*, int32_t, double)")
    testing.AssertEqStr(cg.FuncCastParamsEnv("func() void"), "(void*)")
    testing.AssertEqInt(cg.ArraySizeOf("i32[16]") as int, 16)
    testing.AssertEqInt(cg.ArraySizeOf("f64[2][3]") as int, 2)
    testing.AssertEqInt(cg.ArraySizeOf("i32") as int, 0)
end

func test_print_tags():
    testing.AssertEqInt(cg.PrintTag("str"), 7)
    testing.AssertEqInt(cg.PrintTag(""), 7)
    testing.AssertEqInt(cg.PrintTag("uchar"), 7)
    testing.AssertEqInt(cg.PrintTag("bool"), 5)
    testing.AssertEqInt(cg.PrintTag("char"), 6)
    testing.AssertEqInt(cg.PrintTag("f32"), 4)
    testing.AssertEqInt(cg.PrintTag("f64"), 4)
    testing.AssertEqInt(cg.PrintTag("i64"), 1)
    testing.AssertEqInt(cg.PrintTag("u32"), 2)
    testing.AssertEqInt(cg.PrintTag("u64"), 3)
    testing.AssertEqInt(cg.PrintTag("size"), 3)
    testing.AssertEqInt(cg.PrintTag("i32"), 0)
    testing.AssertEqInt(cg.PrintTag("Point"), 0)
    testing.AssertEqStr(cg.PrimSuffix(1), "i64")
    testing.AssertEqStr(cg.PrimSuffix(2), "u32")
    testing.AssertEqStr(cg.PrimSuffix(3), "u64")
    testing.AssertEqStr(cg.PrimSuffix(4), "f64")
    testing.AssertEqStr(cg.PrimSuffix(5), "bool")
    testing.AssertEqStr(cg.PrimSuffix(6), "char")
    testing.AssertEqStr(cg.PrimSuffix(0), "i32")
    testing.AssertEqStr(cg.PfSpec(cg.PF_STR), "%s")
    testing.AssertEqStr(cg.PfSpec(cg.PF_I32), "%d")
    testing.AssertEqStr(cg.PfSpec(cg.PF_U32), "%u")
    testing.AssertEqStr(cg.PfSpec(cg.PF_I64), "%lld")
    testing.AssertEqStr(cg.PfSpec(cg.PF_U64), "%llu")
    testing.AssertEqStr(cg.PfSpec(cg.PF_SIZE), "%zu")
    testing.AssertEqStr(cg.PfSpec(cg.PF_F64), "%g")
    testing.AssertEqStr(cg.PfSpec(cg.PF_BOOL), "%s")
    testing.AssertEqStr(cg.PfSpec(cg.PF_CHAR), "%c")
    testing.AssertEqStr(cg.PfSpec(cg.PF_LIT), "")
end

// Builds `println "n:", <ident i32>, 7, true, 'A', 2.5, <ident u64>` by
// hand and checks the folded segment list.
func test_pf_build():
    mut a := at.NewAst()
    call := at.NewNode(a, at.AST_CALL)

    lit0 := at.NewNode(a, at.AST_LITERAL)
    at.SetOp(a, lit0, tok.TK_STRING)
    mut n0 := at.Get(a, lit0)
    n0.value_kind = tok.TV_STRING
    n0.value_str = "n:"
    n0.type_str = "str"
    at.Put(a, lit0, n0)
    at.AddChild(a, call, lit0)

    id1 := at.NewNode(a, at.AST_IDENTIFIER)
    at.SetName(a, id1, "x")
    at.SetTypeStr(a, id1, "i32")
    at.AddChild(a, call, id1)

    lit2 := at.NewNode(a, at.AST_LITERAL)
    at.SetOp(a, lit2, tok.TK_INT)
    mut n2 := at.Get(a, lit2)
    n2.value_kind = tok.TV_INT
    n2.value_int = 7 as u64
    n2.type_str = "i32"
    at.Put(a, lit2, n2)
    at.AddChild(a, call, lit2)

    lit3 := at.NewNode(a, at.AST_LITERAL)
    at.SetOp(a, lit3, tok.TK_KW_TRUE)
    at.SetTypeStr(a, lit3, "bool")
    at.AddChild(a, call, lit3)

    lit4 := at.NewNode(a, at.AST_LITERAL)
    at.SetOp(a, lit4, tok.TK_CHAR)
    mut n4 := at.Get(a, lit4)
    n4.value_kind = tok.TV_CHAR
    n4.value_int = 65 as u64
    n4.type_str = "char"
    at.Put(a, lit4, n4)
    at.AddChild(a, call, lit4)

    lit5 := at.NewNode(a, at.AST_LITERAL)
    at.SetOp(a, lit5, tok.TK_FLOAT)
    mut n5 := at.Get(a, lit5)
    n5.value_kind = tok.TV_FLOAT
    n5.value_float = 2.5
    n5.type_str = "f64"
    at.Put(a, lit5, n5)
    at.AddChild(a, call, lit5)

    id6 := at.NewNode(a, at.AST_IDENTIFIER)
    at.SetName(a, id6, "u")
    at.SetTypeStr(a, id6, "u64")
    at.AddChild(a, call, id6)

    mut segs := Vector {} as Vector<cg.PfSeg>
    cg.PfBuild(a, call, true, segs)
    // "n:" + ' ' -> lit; ident x -> I32 seg; " 7 true A 2.5 " folds;
    // ident u -> U64 seg; trailing "\n" lit.
    testing.AssertEqInt(segs.len(), 5)
    testing.AssertEqInt(segs.get(0)[0].kind, cg.PF_LIT)
    testing.AssertEqStr(segs.get(0)[0].text, "n: ")
    testing.AssertEqInt(segs.get(1)[0].kind, cg.PF_I32)
    testing.AssertEqInt(segs.get(1)[0].expr, id1)
    testing.AssertEqInt(segs.get(2)[0].kind, cg.PF_LIT)
    testing.AssertEqStr(segs.get(2)[0].text, " 7 true A 2.5 ")
    testing.AssertEqInt(segs.get(3)[0].kind, cg.PF_U64)
    testing.AssertEqInt(segs.get(3)[0].expr, id6)
    testing.AssertEqInt(segs.get(4)[0].kind, cg.PF_LIT)
    testing.AssertEqStr(segs.get(4)[0].text, "\n")
    segs.free()

    // no-newline print of a single non-foldable str arg: one segment.
    mut segs2 := Vector {} as Vector<cg.PfSeg>
    call2 := at.NewNode(a, at.AST_CALL)
    id7 := at.NewNode(a, at.AST_IDENTIFIER)
    at.SetName(a, id7, "msg")
    at.SetTypeStr(a, id7, "str")
    at.AddChild(a, call2, id7)
    cg.PfBuild(a, call2, false, segs2)
    testing.AssertEqInt(segs2.len(), 1)
    testing.AssertEqInt(segs2.get(0)[0].kind, cg.PF_STR)
    testing.AssertEqInt(segs2.get(0)[0].expr, id7)
    segs2.free()

    // folded-only println: negative fold + arithmetic fold + f64 division.
    mut segs3 := Vector {} as Vector<cg.PfSeg>
    call3 := at.NewNode(a, at.AST_CALL)
    neg := at.NewNode(a, at.AST_UNARY)
    at.SetOp(a, neg, tok.TK_MINUS)
    lit8 := at.NewNode(a, at.AST_LITERAL)
    at.SetOp(a, lit8, tok.TK_INT)
    mut n8 := at.Get(a, lit8)
    n8.value_kind = tok.TV_INT
    n8.value_int = 4 as u64
    n8.type_str = "i32"
    at.Put(a, lit8, n8)
    mut nn := at.Get(a, neg)
    nn.a = lit8
    nn.type_str = "i32"
    at.Put(a, neg, nn)
    at.AddChild(a, call3, neg)
    cg.PfBuild(a, call3, true, segs3)
    testing.AssertEqInt(segs3.len(), 1)
    testing.AssertEqStr(segs3.get(0)[0].text, "-4\n")
    segs3.free()

    at.FreeAst(a)
end

func test_mangle():
    quiet := lg.New(lg.LOG_OFF, false)
    mut s := sm.New(quiet, "mangle_test", "en")
    mut p1 := Vector {} as Vector<int>
    p1.push(sm.Prim(s, sm.TY_I32))
    testing.AssertEqStr(cg.MangleIn(s, "main", "", "AddOne", p1),
                        "_Salam_main_AddOne_i32")
    // "" pkg = the C NULL -> "main".
    testing.AssertEqStr(cg.MangleIn(s, "", "", "AddOne", p1),
                        "_Salam_main_AddOne_i32")
    mut p0 := Vector {} as Vector<int>
    testing.AssertEqStr(cg.MangleIn(s, "main", "Point", "dist", p0),
                        "_Salam_main_S_Point_dist")
    mut p2 := Vector {} as Vector<int>
    p2.push(sm.Prim(s, sm.TY_STR))
    testing.AssertEqStr(cg.MangleIn(s, "g", "Vector_str", "push", p2),
                        "_Salam_g_S_Vector__str_push_str")
    mut p3 := Vector {} as Vector<int>
    p3.push(sm.PtrTo(s, sm.Prim(s, sm.TY_VOID)))
    testing.AssertEqStr(cg.MangleIn(s, "mem", "", "Free", p3),
                        "_Salam_mem_Free_void_ptr")
    mut p4 := Vector {} as Vector<int>
    p4.push(sm.Prim(s, sm.TY_U64))
    testing.AssertEqStr(cg.MangleIn(s, "mem", "", "Allocate", p4),
                        "_Salam_mem_Allocate_u64")
    // cg_mangle_ti routes through the struct_name slot -> "_S_" infix.
    testing.AssertEqStr(cg.MangleTi(s, "i32", "rank", p0),
                        "_Salam_ti_S_i32_rank")
    // type_is_byval_agg over TypeIds.
    testing.AssertFalse(cg.TypeIsByvalAgg(s, sm.Prim(s, sm.TY_I32)))
    testing.AssertFalse(cg.TypeIsByvalAgg(s, sm.TYPE_NONE))
    testing.AssertTrue(cg.TypeIsByvalAgg(s, sm.StructType(s, 0, "P")))
    testing.AssertTrue(cg.TypeIsByvalAgg(s, sm.VecOf(s, sm.Prim(s,
                                                                sm.TY_I32))))
    testing.AssertTrue(cg.TypeIsByvalAgg(s, sm.SliceOf(s, sm.Prim(s,
                                                                  sm.TY_U8))))
    p1.free()
    p0.free()
    p2.free()
    p3.free()
    p4.free()
    sm.Free(s)
end

func test_tidy():
    testing.AssertEqStr(cg.Tidy("a  \n\n\n\nb\n"), "a\n\nb\n")
    testing.AssertEqStr(cg.Tidy("\n\nx\n"), "x\n")
    testing.AssertEqStr(cg.Tidy("x \t\r\n"), "x\n")
    testing.AssertEqStr(cg.Tidy("x"), "x\n")
    testing.AssertEqStr(cg.Tidy("x\n\n"), "x\n")
    testing.AssertEqStr(cg.Tidy(""), "")
end

func test_single_threaded():
    mut a := at.NewAst()
    prog := at.NewNode(a, at.AST_PROGRAM)
    testing.AssertTrue(cg.ModuleSingleThreaded(a, prog))
    imp := at.NewNode(a, at.AST_IMPORT)
    at.SetName(a, imp, "thread")
    at.AddChild(a, prog, imp)
    testing.AssertFalse(cg.ModuleSingleThreaded(a, prog))
    // spawn() call anywhere in the tree also disables it.
    prog2 := at.NewNode(a, at.AST_PROGRAM)
    call := at.NewNode(a, at.AST_CALL)
    callee := at.NewNode(a, at.AST_IDENTIFIER)
    at.SetName(a, callee, "spawn")
    mut cn := at.Get(a, call)
    cn.a = callee
    at.Put(a, call, cn)
    at.AddChild(a, prog2, call)
    testing.AssertFalse(cg.ModuleSingleThreaded(a, prog2))
    at.FreeAst(a)
end

// Full pipeline over the fixture; exact expected text from HEAD --keep-c.
func test_module_output():
    dir := "salam/tests_port/tmp_cg"
    _mk := os.MkdirAll(dir)
    path := dir + "/cgport_t1.salam"
    _w := os.WriteFile(path, fixture_src())
    mut h := ""
    mut c := ""
    ok := build_module(path, "cgref", h, c)
    testing.AssertMsg(ok, "fixture must pass sema")
    if !ok:
        _rm := os.Remove(path)
        ret
    end

    // --- header ---
    testing.AssertTrue(str.StartsWith(h,
        "#pragma once\n#ifndef SALAM_MODULE_cgref_H\n" +
        "#define SALAM_MODULE_cgref_H\n#include <stdint.h>\n"))
    testing.AssertContains(h, "#define SALAM_OB_SZ 65536\n")
    testing.AssertContains(h,
        "void* _Salam_mem_Allocate_u64(uint64_t size);\n" +
        "void* _Salam_mem_Reallocate_void_ptr_u64(void* ptr, uint64_t " +
        "size);\nvoid _Salam_mem_Free_void_ptr(void* ptr);\n")
    testing.AssertContains(h, "#include \"salam_mod_core.h\"\n")
    testing.AssertContains(h,
        "typedef enum { Color_Red = 0, Color_Green = 5, Color_Blue = 6 } " +
        "Color;\n")
    testing.AssertContains(h,
        "#ifndef SALAM_FWD_Point\n#define SALAM_FWD_Point\n" +
        "typedef struct Point Point;\n#endif\n")
    testing.AssertContains(h,
        "#ifndef SALAM_FWD_Circle\n#define SALAM_FWD_Circle\n" +
        "typedef struct Circle Circle;\n#endif\n")
    testing.AssertContains(h,
        "#ifndef SALAM_DYN_Shape_DEFINED\n#define SALAM_DYN_Shape_DEFINED" +
        "\ntypedef struct _Salam_vtbl_Shape {\n    double (*area)(void*);" +
        "\n} _Salam_vtbl_Shape;\ntypedef struct { void* data; const " +
        "_Salam_vtbl_Shape* vtable; } _Salam_dyn_Shape;\n#endif\n")
    testing.AssertContains(h,
        "#ifndef SALAM_DEF_Point\n#define SALAM_DEF_Point\nstruct Point " +
        "{\n    int32_t x;\n    double y;\n};\n#endif\n")
    testing.AssertContains(h,
        "#ifndef SALAM_DEF_Circle\n#define SALAM_DEF_Circle\nstruct " +
        "Circle {\n    double r;\n};\n#endif\n")
    testing.AssertContains(h,
        "#ifndef SALAM__Salam_variant_i32_str_TYPEDEF\n" +
        "#define SALAM__Salam_variant_i32_str_TYPEDEF\n" +
        "typedef struct { int32_t tag; union { int32_t v0; const char* " +
        "v1; } payload; } _Salam_variant_i32_str;\n#endif\n")
    testing.AssertContains(h, "extern int32_t puts(const char* s);\n")
    testing.AssertContains(h, "extern const int32_t MAXN;\n")
    testing.AssertContains(h,
        "double _Salam_main_S_Point_dist(Point* this);\n")
    testing.AssertContains(h,
        "double _Salam_main_S_Circle_area(Circle* this);\n")
    testing.AssertContains(h,
        "int32_t _Salam_main_AddOne_i32(int32_t v);\n")
    // generic instance prototypes (synthetic Vector<str> from .split).
    testing.AssertContains(h,
        "#ifndef SALAM_IP__Salam_g_S_Vector__str_push_str\n" +
        "#define SALAM_IP__Salam_g_S_Vector__str_push_str\n" +
        "static inline void _Salam_g_S_Vector__str_push_str(Vector__str* " +
        "this, const char* x);\n#endif\n")
    testing.AssertContains(h,
        "static inline const char** _Salam_g_S_Vector__str_get_i32(" +
        "Vector__str* this, int32_t i);\n")
    testing.AssertContains(h, "#ifndef SALAM_IB__Salam_g_S_Vector__str_free")
    testing.AssertTrue(str.EndsWith(h, "\n#endif\n"))
    // g_count is not pub and this is a main module: no extern for it.
    testing.AssertFalse(str.Contains(h, "g__count"))

    // --- C file ---
    testing.AssertTrue(str.StartsWith(c,
        "#include \"salam_mod_cgref.h\"\n\nstatic double " +
        "_Salam_thunk_Shape_Circle_area(void* self){ return " +
        "_Salam_main_S_Circle_area((Circle*)self); }\nstatic const " +
        "_Salam_vtbl_Shape _Salam_vtbl_Shape_Circle = { " +
        "_Salam_thunk_Shape_Circle_area };\n"))
    testing.AssertContains(c,
        "static const char* _Salam_main_helper_str(const char* s);\n")
    // global initializers, real cg_expr text now that 6b is ported.
    testing.AssertContains(c, "const int32_t MAXN = 100;\n")
    testing.AssertContains(c, "int32_t g__count = 7;\n")
    testing.AssertContains(c, "int main(int argc, char** argv) {\n")
    testing.AssertContains(c, "    salam_set_args(argc, argv);\n")
    testing.AssertContains(c, "    return 0;\n")
    testing.AssertContains(c,
        "double _Salam_main_S_Point_dist(Point* this) {\n")
    testing.AssertContains(c,
        "int32_t _Salam_main_AddOne_i32(int32_t v) {\n")
    testing.AssertContains(c,
        "static const char* _Salam_main_helper_str(const char* s) {\n")

    _rm := os.Remove(path)
end

// Package-module fixture: sret, slices, ref params, attrs, inline header,
// type alias, pkg globals — and the extern-const array bug, bug-for-bug.
func fixture_pkg_src(): str:
    ret "package util2\n" +
        "\n" +
        "mut g_u2 := 0\n" +
        "vals := [1, 2] as int[2]\n" +
        "\n" +
        "pub type Id2 = int\n" +
        "\n" +
        "pub struct Pair2:\n" +
        "    pub first: int = 0\n" +
        "    pub second: int = 0\n" +
        "end\n" +
        "\n" +
        "func hidden2(x: int): int:\n" +
        "    ret x + 1\n" +
        "end\n" +
        "\n" +
        "pub func MkPair2(x: int, y: int): Pair2:\n" +
        "    ret Pair2 { first = x, second = y }\n" +
        "end\n" +
        "\n" +
        "pub inline func Twice2(x: int): int:\n" +
        "    ret x * 2\n" +
        "end\n" +
        "\n" +
        "pub func Sum2(view: i32[:]): int:\n" +
        "    mut t := vals[0] + g_u2\n" +
        "    each v in view:\n" +
        "        t += v\n" +
        "    end\n" +
        "    ret hidden2(t)\n" +
        "end\n" +
        "\n" +
        "pub pure func Sq2(x: f64): f64:\n" +
        "    ret x * x\n" +
        "end\n" +
        "\n" +
        "pub deprecated func Old2(): int:\n" +
        "    ret 1\n" +
        "end\n" +
        "\n" +
        "pub func Bump2(c &: Pair2):\n" +
        "    c.first = c.first + 1\n" +
        "end\n"
end

func test_pkg_module_output():
    dir := "salam/tests_port/tmp_cg"
    _mk := os.MkdirAll(dir)
    path := dir + "/cgport_t2.salam"
    _w := os.WriteFile(path, fixture_pkg_src())
    mut h := ""
    mut c := ""
    ok := build_module(path, "cgport_t2", h, c)
    testing.AssertMsg(ok, "pkg fixture must pass sema")
    if !ok:
        _rm := os.Remove(path)
        ret
    end
    // type alias + pkg globals (every pkg global is extern'd in the .h).
    testing.AssertContains(h, "typedef int32_t Id2;\n")
    testing.AssertContains(h, "extern int32_t g__u2;\n")
    // THE extern-const array bug (PORTING.md), ported bug-for-bug: the .h
    // declares the non-mut array const, the .c defines it non-const.
    testing.AssertContains(h, "extern const int32_t vals[2];\n")
    testing.AssertContains(c, "\nint32_t vals[2] = ")
    testing.AssertFalse(str.Contains(c, "const int32_t vals[2]"))
    // sret: by-value struct returns become a trailing __ret out-param.
    testing.AssertContains(h,
        "void _Salam_util2_MkPair2_i32_i32(int32_t x, int32_t y, " +
        "util2__Pair2* __ret);\n")
    // pub inline: proto + body both live in the header.
    testing.AssertContains(h,
        "static inline int32_t _Salam_util2_Twice2_i32(int32_t x);\n")
    testing.AssertContains(h,
        "static inline int32_t _Salam_util2_Twice2_i32(int32_t x) {\n")
    // slice param, attrs, ref param, and the pkgmod non-static private fn.
    testing.AssertContains(h,
        "int32_t _Salam_util2_Sum2_slice_3ci32_3e(salam_slice view);\n")
    testing.AssertContains(h, "SALAM_PURE double _Salam_util2_Sq2_f64(" +
                              "double x);\n")
    testing.AssertContains(h, "SALAM_DEPRECATED int32_t _Salam_util2_Old2(" +
                              "void);\n")
    testing.AssertContains(h,
        "int32_t _Salam_util2_hidden2_i32(int32_t x);\n")
    testing.AssertContains(h,
        "void _Salam_util2_Bump2_util2__Pair2(util2__Pair2* c);\n")
    testing.AssertContains(h,
        "#ifndef SALAM_FWD_util2__Pair2\n#define SALAM_FWD_util2__Pair2\n" +
        "typedef struct util2__Pair2 util2__Pair2;\n#endif\n")
    testing.AssertContains(h,
        "struct util2__Pair2 {\n    int32_t first;\n    int32_t second;\n" +
        "};\n")
    testing.AssertContains(c, "#include \"salam_mod_cgport_t2.h\"\n")
    testing.AssertContains(c,
        "int32_t _Salam_util2_hidden2_i32(int32_t x);\n")
    _rm := os.Remove(path)
end

// --- 6b: expression / statement emission (codegen_expr.c, codegen_stmt.c).
// Expected C text derived from HEAD `bin/salam build --keep-c` on the same
// program (salam/tests_port/tmp_cg/cgexpr.salam / hexpr/salam_mod_cgexpr.c).
func fixture_expr_stmt_src(): str:
    ret "func main:\n" +
        "    a := 3\n" +
        "    b := 4\n" +
        "    x := a + b * 2\n" +
        "    s := \"n=\" + a\n" +
        "    t := a > b ? \"big\" : \"small\"\n" +
        "    mut i := 0\n" +
        "    until i < 3:\n" +
        "        i += 1\n" +
        "    end\n" +
        "    mut total := 0\n" +
        "    repeat 3 with k:\n" +
        "        total += k\n" +
        "    end\n" +
        "    grade := match total:\n" +
        "        3 => \"three\"\n" +
        "        else => \"other\"\n" +
        "    end\n" +
        "    defer println \"done\"\n" +
        "    println x, s, t, grade\n" +
        "end\n"
end

func test_expr_stmt_output():
    dir := "salam/tests_port/tmp_cg"
    _mk := os.MkdirAll(dir)
    path := dir + "/cgport_t3.salam"
    _w := os.WriteFile(path, fixture_expr_stmt_src())
    mut h := ""
    mut c := ""
    ok := build_module(path, "cgport_t3", h, c)
    testing.AssertMsg(ok, "expr/stmt fixture must pass sema")
    if !ok:
        _rm := os.Remove(path)
        ret
    end
    // binary precedence: a + b * 2
    testing.AssertContains(c, "const int32_t x = (a + (b * 2));\n")
    // str + int concat lowers to salam_strcat + salam_tostr_i32
    testing.AssertContains(c,
        "const char* s = salam_strcat(\"n=\", salam_tostr_i32(a));\n")
    // ternary: every branch double-parenthesized like the C
    testing.AssertContains(c,
        "const char* t = (((a > b)) ? (\"big\") : (\"small\"));\n")
    // until == while
    testing.AssertContains(c, "while ((i < 3)) {\n")
    testing.AssertContains(c, "    i += 1;\n")
    // repeat n with k -> counted for-loop over __repN
    testing.AssertContains(c,
        "for (int64_t __rep1 = 0, __repn1 = (int64_t)(3); __rep1 < " +
        "__repn1; __rep1++) {\n")
    testing.AssertContains(c, "const int32_t k = (int32_t)__rep1;\n")
    // match-expr: statement-expression with a goto-terminated result temp
    testing.AssertContains(c, "if (((__msubj2) == (3))) {\n")
    testing.AssertContains(c, "= (\"three\"); goto __mend2;\n")
    testing.AssertContains(c, "else if (1) {\n")
    testing.AssertContains(c, "= (\"other\"); goto __mend2;\n")
    testing.AssertContains(c, "__mend2: __mres2; });\n")
    // defer runs LIFO at function end, after the rest of the body.
    printidx := str.IndexOf(c, "printf(\"%d %s %s %s\\n\"")
    deferidx := str.IndexOf(c, "SALAM_OUT_LIT(\"done\\n\", 5);\n")
    testing.AssertTrue(printidx >= 0 && deferidx > printidx)
    _rm := os.Remove(path)
end

// --- 6b: lambda lifting + closure calls (codegen_lambda.c, call_value).
// Expected C text derived from HEAD `bin/salam build --keep-c` on
// salam/tests_port/tmp_cg/cglam.salam / hlam/salam_mod_cglam.c.
func fixture_lambda_src(): str:
    ret "func main:\n" +
        "    n := 10\n" +
        "    add := (p: int, q: int) => p + q + n\n" +
        "    println add(3, 4)\n" +
        "end\n"
end

func test_lambda_output():
    dir := "salam/tests_port/tmp_cg"
    _mk := os.MkdirAll(dir)
    path := dir + "/cgport_t4.salam"
    _w := os.WriteFile(path, fixture_lambda_src())
    mut h := ""
    mut c := ""
    ok := build_module(path, "cgport_t4", h, c)
    testing.AssertMsg(ok, "lambda fixture must pass sema")
    if !ok:
        _rm := os.Remove(path)
        ret
    end
    // captures env struct + forward decls, lifted ABOVE main (blamd/blamf).
    testing.AssertContains(c,
        "typedef struct { void *fn; int32_t n; } _Salam_lambda_0_env;\n")
    testing.AssertContains(c,
        "static void *_Salam_lambda_0_make(int32_t n);\n")
    testing.AssertContains(c,
        "static int32_t _Salam_lambda_0(void *__envp, int32_t p, " +
        "int32_t q);\n")
    // body: captured `n` read through __env->n.
    testing.AssertContains(c,
        "static int32_t _Salam_lambda_0(void *__envp, int32_t p, " +
        "int32_t q) {\n")
    testing.AssertContains(c,
        "_Salam_lambda_0_env *__env = (_Salam_lambda_0_env *)__envp; " +
        "(void)__env;\n")
    testing.AssertContains(c, "return ((p + q) + __env->n);\n")
    // _make allocates the env and stores fn ptr + captured n.
    testing.AssertContains(c, "e->fn = (void*)&_Salam_lambda_0;\n")
    testing.AssertContains(c, "e->n = n;\n")
    // lambda VALUE at the use site is the _make() call.
    testing.AssertContains(c,
        "const void* add = _Salam_lambda_0_make(n);\n")
    // calling a `func(...)`-typed local goes through call_value's
    // deref-and-prepend-env convention.
    testing.AssertContains(c,
        "({ void *_clz0 = (void*)(add); ((int32_t(*)(void*, int32_t, " +
        "int32_t))(*(void**)_clz0))(_clz0, 3, 4); })")
    _rm := os.Remove(path)
end

func main:
    test_cident()
    test_ctype()
    test_cdecl()
    test_vec_variant_names()
    test_func_types()
    test_print_tags()
    test_pf_build()
    test_mangle()
    test_tidy()
    test_single_threaded()
    test_module_output()
    test_pkg_module_output()
    test_expr_stmt_output()
    test_lambda_output()
    os.Exit(testing.Summary())
end
