// Smoke test for the jsgen port (salam/jsgen.salam): representative JS
// snippets — functions, params/locals, print formatting, string ops +
// template-literal concat, int division / power, control flow, structs +
// methods + struct literals, closures (plain + captured), defer ordering,
// match-expression lowering, Variant box/tag output, name minification.
// Expectations derive from compiler/src/jsgen/*.c and are cross-checked
// against HEAD `bin/salam js` bundles by tests_port/jsgen_cmp.sh.
package main

import os
import str
import testing
import tok "../token.salam"
import at "../ast.salam"
import lg "../logger.salam"
import src "../source.salam"
import lx "../lexer.salam"
import ps "../parser.salam"
import cc "../condcomp.salam"
import lp "../langpack.salam"
import sm "../semantic.salam"
import jg "../jsgen.salam"

// One driver-shaped run: write src -> lex -> parse -> prune(SALAM_JS) ->
// sema -> jsgen. Returns false when any stage fails.
func gen_js(path: str, source: str, minify: bool, compact: bool,
            a &: at.Ast, s &: sm.Sema, out &: jg.Output,
            minify_last &: str, mkeys &: Vector<str>,
            mvals &: Vector<str>): bool:
    _w := os.WriteFile(path, source)
    mut sf := src.New()
    if !src.Load(path, sf):
        ret false
    end
    quiet := lg.New(lg.LOG_OFF, false)
    pack := lx.Detect(sf, lp.Load("en"))
    mut toks := tok.StreamNew(path)
    lok := lx.Run(quiet, pack, sf, toks)
    mut prog := 0
    mut pok := ps.Run(quiet, toks, a, prog)
    tok.StreamFree(toks)
    mut defs := Vector {} as Vector<str>
    defer defs.free()
    defs.push("SALAM_JS")
    sm.SetCc(s, cc.TableBuild("", defs))
    if !cc.PruneProgram(a, quiet, path, s.cctab, prog):
        pok = false
    end
    sok := sm.Run(s, a, prog)
    if !lok || !pok || !sok:
        ret false
    end
    jg.Run(quiet, a, s, prog, "t", lp.Entry(pack), minify, compact,
           minify_last, mkeys, mvals, out)
    ret true
end

// Plain (no minify) single-file run.
func gen_plain(path: str, source: str, a &: at.Ast, s &: sm.Sema,
               out &: jg.Output): bool:
    mut ml := ""
    mut mk := Vector {} as Vector<str>
    mut mv := Vector {} as Vector<str>
    ok := gen_js(path, source, false, false, a, s, out, ml, mk, mv)
    mk.free()
    mv.free()
    ret ok
end

// fn text for a generated function name ("" = not found).
func fn_text(out: jg.Output, name: str): str:
    repeat out.fn_names.len() with i:
        if str.Equals(out.fn_names.get(i)[0], name):
            ret out.fn_texts.get(i)[0]
        end
    end
    ret ""
end

func main:
    tmp := "salam/tests_port/tmp_js"
    _m := os.Mkdir(tmp)

    // -- 1: basics — globals, functions, print, template concat ------------
    mut a1 := at.NewAst()
    quiet := lg.New(lg.LOG_OFF, false)
    mut s1 := sm.New(quiet, tmp + "/t1.salam", "en")
    mut o1 := jg.NewOutput()
    ok1 := gen_plain(tmp + "/t1.salam",
        "mut count := 0\n" +
        "func add(x: int, y: int): int:\n" +
        "    ret x + y\n" +
        "end\n" +
        "func main:\n" +
        "    count = count + 1\n" +
        "    println \"hi\", add(2, 3)\n" +
        "    println count\n" +
        "end\n",
        a1, s1, o1)
    testing.AssertTrue(ok1)
    testing.AssertEqStr(o1.globals_src, "let count = 0;\n")
    testing.AssertEqStr(o1.entry_mangled, "main")
    testing.AssertEqStr(fn_text(o1, "add"),
        "function add(x, y) {\n    return x + y;\n}\n")
    testing.AssertEqStr(fn_text(o1, "main"),
        "function main() {\n" +
        "    count++;\n" +
        "    console.log(\"hi\", add(2, 3));\n" +
        "    console.log(count);\n" +
        "}\n")
    jg.FreeOutput(o1)
    sm.Free(s1)
    at.FreeAst(a1)

    // -- 2: int division, power, floats, string ops ------------------------
    mut a2 := at.NewAst()
    mut s2 := sm.New(quiet, tmp + "/t2.salam", "en")
    mut o2 := jg.NewOutput()
    ok2 := gen_plain(tmp + "/t2.salam",
        "func main:\n" +
        "    a := 7\n" +
        "    b := 2\n" +
        "    println a / b\n" +
        "    println 2.5\n" +
        "    println a ** b\n" +
        "    name := \"world\"\n" +
        "    println \"hello \" + name + \"!\"\n" +
        "    println name.upper()\n" +
        "    println \"ab\" * b\n" +
        "end\n",
        a2, s2, o2)
    testing.AssertTrue(ok2)
    m2 := fn_text(o2, "main")
    testing.AssertContains(m2, "console.log(Math.trunc(a / b));")
    testing.AssertContains(m2, "console.log(2.5);")
    testing.AssertContains(m2, "console.log(Math.pow(a, b));")
    testing.AssertContains(m2, "console.log(`hello ${name}!`);")
    testing.AssertContains(m2, "console.log(name.toUpperCase());")
    testing.AssertContains(m2, "console.log(\"ab\".repeat(Math.max(0, b)));")
    jg.FreeOutput(o2)
    sm.Free(s2)
    at.FreeAst(a2)

    // -- 3: control flow — until/repeat/if-else ----------------------------
    mut a3 := at.NewAst()
    mut s3 := sm.New(quiet, tmp + "/t3.salam", "en")
    mut o3 := jg.NewOutput()
    ok3 := gen_plain(tmp + "/t3.salam",
        "func main:\n" +
        "    mut i := 0\n" +
        "    until i < 3:\n" +
        "        i += 1\n" +
        "    end\n" +
        "    repeat 3 with k:\n" +
        "        println k\n" +
        "    end\n" +
        "    if i == 3:\n" +
        "        println \"three\"\n" +
        "    else:\n" +
        "        println \"other\"\n" +
        "    end\n" +
        "end\n",
        a3, s3, o3)
    testing.AssertTrue(ok3)
    m3 := fn_text(o3, "main")
    testing.AssertContains(m3, "while (i < 3) {")
    testing.AssertContains(m3, "i += 1;")
    testing.AssertContains(m3, "for (let k = 0; k < 3; k++) {")
    testing.AssertContains(m3, "if (i === 3) {")
    testing.AssertContains(m3, "} else {")
    jg.FreeOutput(o3)
    sm.Free(s3)
    at.FreeAst(a3)

    // -- 4: struct + method + struct literal -------------------------------
    mut a4 := at.NewAst()
    mut s4 := sm.New(quiet, tmp + "/t4.salam", "en")
    mut o4 := jg.NewOutput()
    ok4 := gen_plain(tmp + "/t4.salam",
        "struct Point:\n" +
        "    pub x: int = 0\n" +
        "    pub y: int = 0\n" +
        "    pub func sum(): int:\n" +
        "        ret this.x + this.y\n" +
        "    end\n" +
        "end\n" +
        "func main:\n" +
        "    p := Point { x = 1, y = 2 }\n" +
        "    println p.sum()\n" +
        "end\n",
        a4, s4, o4)
    testing.AssertTrue(ok4)
    testing.AssertEqStr(fn_text(o4, "Point_sum"),
        "function Point_sum(__self) {\n" +
        "    return __self.x + __self.y;\n" +
        "}\n")
    m4 := fn_text(o4, "main")
    testing.AssertContains(m4, "const p = { x: 1, y: 2 };")
    testing.AssertContains(m4, "console.log(Point_sum(p));")
    jg.FreeOutput(o4)
    sm.Free(s4)
    at.FreeAst(a4)

    // -- 5: closures — expression lambda + immutable capture ----------------
    mut a5 := at.NewAst()
    mut s5 := sm.New(quiet, tmp + "/t5.salam", "en")
    mut o5 := jg.NewOutput()
    ok5 := gen_plain(tmp + "/t5.salam",
        "func main:\n" +
        "    double := (x: int) => x * 2\n" +
        "    println double(4)\n" +
        "    base := 10\n" +
        "    addb := (x: int) => x + base\n" +
        "    println addb(5)\n" +
        "end\n",
        a5, s5, o5)
    testing.AssertTrue(ok5)
    m5 := fn_text(o5, "main")
    testing.AssertContains(m5, "const double = (x) => x * 2;")
    testing.AssertContains(m5, "console.log(double(4));")
    testing.AssertContains(m5, "const addb = (x) => x + base;")
    jg.FreeOutput(o5)
    sm.Free(s5)
    at.FreeAst(a5)

    // -- 6: defer ordering --------------------------------------------------
    mut a6 := at.NewAst()
    mut s6 := sm.New(quiet, tmp + "/t6.salam", "en")
    mut o6 := jg.NewOutput()
    ok6 := gen_plain(tmp + "/t6.salam",
        "func main:\n" +
        "    defer println \"last\"\n" +
        "    println \"first\"\n" +
        "end\n",
        a6, s6, o6)
    testing.AssertTrue(ok6)
    testing.AssertEqStr(fn_text(o6, "main"),
        "function main() {\n" +
        "    console.log(\"first\");\n" +
        "    console.log(\"last\");\n" +
        "}\n")
    jg.FreeOutput(o6)
    sm.Free(s6)
    at.FreeAst(a6)

    // -- 7: match expression -> guarded IIFE -------------------------------
    mut a7 := at.NewAst()
    mut s7 := sm.New(quiet, tmp + "/t7.salam", "en")
    mut o7 := jg.NewOutput()
    ok7 := gen_plain(tmp + "/t7.salam",
        "func main:\n" +
        "    score := 8\n" +
        "    grade := match score:\n" +
        "        8 => \"B\"\n" +
        "        else => \"F\"\n" +
        "    end\n" +
        "    println grade\n" +
        "end\n",
        a7, s7, o7)
    testing.AssertTrue(ok7)
    m7 := fn_text(o7, "main")
    testing.AssertContains(m7, "(() => {")
    testing.AssertContains(m7, "const __msubj1 = score;")
    testing.AssertContains(m7, "if ((__msubj1 === 8)) {")
    testing.AssertContains(m7, "} else if (true) {")
    testing.AssertContains(m7, "})();")
    jg.FreeOutput(o7)
    sm.Free(s7)
    at.FreeAst(a7)

    // -- 8: Variant — box tags + match on tags ------------------------------
    mut a8 := at.NewAst()
    mut s8 := sm.New(quiet, tmp + "/t8.salam", "en")
    mut o8 := jg.NewOutput()
    ok8 := gen_plain(tmp + "/t8.salam",
        "func main:\n" +
        "    mut v := 1 as Variant<i32, str>\n" +
        "    v = \"x\"\n" +
        "    r := match v:\n" +
        "        i32 n => \"int \" + n\n" +
        "        str t => \"text \" + t\n" +
        "    end\n" +
        "    println r\n" +
        "end\n",
        a8, s8, o8)
    testing.AssertTrue(ok8)
    m8 := fn_text(o8, "main")
    testing.AssertContains(m8, "({ tag: 0, value: 1 })")
    testing.AssertContains(m8, "({ tag: 1, value: \"x\" })")
    testing.AssertContains(m8, ".tag === 0)")
    testing.AssertContains(m8, ".tag === 1)")
    jg.FreeOutput(o8)
    sm.Free(s8)
    at.FreeAst(a8)

    // -- 9: string escapes --------------------------------------------------
    mut a9 := at.NewAst()
    mut s9 := sm.New(quiet, tmp + "/t9.salam", "en")
    mut o9 := jg.NewOutput()
    ok9 := gen_plain(tmp + "/t9.salam",
        "func main:\n" +
        "    println \"a\\nb\\\"c\\\\d\"\n" +
        "end\n",
        a9, s9, o9)
    testing.AssertTrue(ok9)
    testing.AssertContains(fn_text(o9, "main"),
        "console.log(\"a\\nb\\\"c\\\\d\");")
    jg.FreeOutput(o9)
    sm.Free(s9)
    at.FreeAst(a9)

    // -- 10: minified + compact --------------------------------------------
    mut a10 := at.NewAst()
    mut s10 := sm.New(quiet, tmp + "/t10.salam", "en")
    mut o10 := jg.NewOutput()
    mut ml := ""
    mut mk := Vector {} as Vector<str>
    mut mv := Vector {} as Vector<str>
    ok10 := gen_js(tmp + "/t10.salam",
        "func helper(a: int): int:\n" +
        "    ret a + 1\n" +
        "end\n" +
        "func main:\n" +
        "    println helper(1)\n" +
        "end\n",
        true, true, a10, s10, o10, ml, mk, mv)
    testing.AssertTrue(ok10)
    testing.AssertEqStr(fn_text(o10, "a"),
        "function a(b) { return b + 1; } ")
    testing.AssertEqStr(fn_text(o10, "c"),
        "function c() { console.log(a(1)); } ")
    testing.AssertEqStr(o10.entry_mangled, "c")
    testing.AssertEqStr(ml, "c")
    mk.free()
    mv.free()
    jg.FreeOutput(o10)
    sm.Free(s10)
    at.FreeAst(a10)

    // -- 11: host template lookup ------------------------------------------
    testing.AssertEqStr(jg.HostLookup("salam_js_query"),
                        "document.querySelector(%0)")
    testing.AssertEqStr(jg.HostLookup("salam_js_call"), "%0[%1](%+2)")
    testing.AssertEqStr(jg.HostLookup("nope"), "")

    // clean up temp files
    repeat 10 with ti:
        _r := os.Remove(tmp + "/t" + (ti + 1) + ".salam")
    end
    os.Exit(testing.Summary())
end
