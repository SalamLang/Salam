extern:
    func puts(s: str): int
end

pub const MAXN := 100
mut g_count := 7

struct Point:
    pub x: int = 0
    pub y: f64 = 0.0
    pub func dist(): f64:
        ret this.y
    end
end

enum Color: Red, Green = 5, Blue end

interface Shape:
    func area(): f64
end

struct Circle:
    pub r: f64 = 0.0
    pub func area(): f64:
        ret this.r
    end
end

func helper(s: str): str:
    ret s
end

func main:
    mut p := Point {}
    p.x = AddOne(MAXN) + g_count
    _d := p.dist()
    _sh := Circle { r = 1.0 } as dyn Shape
    _v := 21 as Variant<i32, str>
    parts := "a,b".split(",")
    defer parts.free()
    _r := puts(helper("hi"))
    println p.x
end

pub func AddOne(v: int): int:
    ret v + 1
end
