package main

import os
import io
import str
import dr "../../driver.salam"

func oct11(n: int): str:
    mut v := n
    mut digits := Vector {} as Vector<int>
    repeat 11 with _i:
        digits.push(v % 8)
        v = v / 8
    end
    mut b := str.NewBuilder()
    mut i := 10
    until i >= 0:
        str.BufAppendChar(b, 48 + digits.get(i)[0])
        i -= 1
    end
    digits.free()
    r := str.BufStr(b)
    str.BufFree(b)
    ret r
end

func tar_zeros(b &: str.StringBuilder, n: int):
    repeat n with _i:
        str.BufAppendChar(b, 0)
    end
end

func tar_entry(name: str, content: str, is_dir: bool): str:
    mut b := str.NewBuilder()
    str.BufAppend(b, name)
    tar_zeros(b, 100 - str.Len(name))
    tar_zeros(b, 24)
    sz := is_dir ? 0 : str.Len(content)
    str.BufAppend(b, oct11(sz))
    str.BufAppendChar(b, 0)
    tar_zeros(b, 20)
    str.BufAppendChar(b, is_dir ? 53 : 48)
    tar_zeros(b, 188)
    tar_zeros(b, 167)
    if !is_dir:
        str.BufAppend(b, content)
        pad := (512 - (str.Len(content) % 512)) % 512
        tar_zeros(b, pad)
    end
    r := str.BufStr(b)
    str.BufFree(b)
    ret r
end

func main:
    mut b := str.NewBuilder()
    e1 := tar_entry("sub/", "", true)
    e2 := tar_entry("sub/hi.txt", "hello sysroot", false)
    println "e1 len=", str.Len(e1)
    println "e2 len=", str.Len(e2)
    str.BufAppend(b, e1)
    str.BufAppend(b, e2)
    tar_zeros(b, 1024)
    tarbytes := str.BufStr(b)
    str.BufFree(b)
    println "tarbytes len=", str.Len(tarbytes)

    mut out := ""
    ok := dr.MaterializeSysroot("dbg_test_sysroot_v3", tarbytes, out)
    println "ok=", ok
    println "out=", out
    println "exists out=", os.Exists(out)
    println "exists sub=", os.Exists(out + "/sub")
    println "exists file=", os.Exists(out + "/sub/hi.txt")
    content := io.ReadFile(out + "/sub/hi.txt")
    println "content=[", content, "]"
end
