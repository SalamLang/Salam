func describe(n: int): str:
    ret match n:
        1, 2 => "small"
        3 => "three"
        else => "big"
    end
end
func main:
    println describe(1), describe(3), describe(9)
    mut v := 21 as Variant<i32, str>
    label := match v:
        i32 x => "int " + x
        str s => "text " + s
    end
    println label
    v = "offline"
    label2 := match v:
        i32 x => "int " + x
        str s => "text " + s
    end
    println label2
end
