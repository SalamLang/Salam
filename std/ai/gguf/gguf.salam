@en "gguf"
@fa "جی‌جی‌یو‌اف"
package gguf

import archive
import compress
import encoding.binary
import mem
import str

@en "GGML_F32"
@fa "نوع اعشاری سی‌ودو"
pub const GGML_F32 := 0

@en "GGML_F16"
@fa "نوع اعشاری شانزده"
pub const GGML_F16 := 1

@en "GGML_Q4_0"
@fa "نوع کوانتیزه چهار صفر"
pub const GGML_Q4_0 := 2

@en "GGML_Q4_1"
@fa "نوع کوانتیزه چهار یک"
pub const GGML_Q4_1 := 3

@en "GGML_Q8_0"
@fa "نوع کوانتیزه هشت صفر"
pub const GGML_Q8_0 := 8

@en "META_STRING"
@fa "فراداده رشته"
pub const META_STRING := 8

@en "META_ARRAY"
@fa "فراداده آرایه"
pub const META_ARRAY := 9

@en "MetaValue"
@fa "مقدار فراداده"
pub struct MetaValue:
    @en "kind"
    @fa "گونه"
    pub kind: int = 0
    @en "elem_kind"
    @fa "نوع عنصر"
    pub elem_kind: int = 0
    @en "i"
    @fa "مقدار صحیح"
    pub i: i64 = 0
    @en "f"
    @fa "مقدار اعشاری"
    pub f: f64 = 0.0
    @en "s"
    @fa "مقدار رشته"
    pub s: str = ""
    @en "ints"
    @fa "آرایه صحیح"
    pub ints: Vector<i64> = Vector {}
    @en "floats"
    @fa "آرایه اعشاری"
    pub floats: Vector<f64> = Vector {}
    @en "strs"
    @fa "آرایه رشته"
    pub strs: Vector<str> = Vector {}

    @en "Free"
    @fa "آزادسازی"
    pub func Free():
        this.ints.Free()
        this.floats.Free()
        _free_read_str(this.s)
        repeat this.strs.Len() in i: _free_read_str(this.strs.get(i)) end
        this.strs.Free()
    end

    @en "free"
    @fa "آزادسازی"
    pub func free():
        this.Free()
    end
end

@en "TensorInfo"
@fa "اطلاعات تانسور"
pub struct TensorInfo:
    @en "name"
    @fa "نام"
    pub name: str = ""
    @en "dims"
    @fa "ابعاد"
    pub dims: Vector<int> = Vector {}
    @en "ggml_type"
    @fa "نوع وزن"
    pub ggml_type: int = 0
    @en "offset"
    @fa "جابجایی"
    pub offset: i64 = 0

    @en "Count"
    @fa "شمار"
    pub func Count(): int:
        mut n := 1
        repeat this.dims.Len() in i: n *= this.dims.get(i) end
        ret n
    end

    @en "count"
    @fa "شمار"
    pub func count(): int:
        ret this.Count()
    end

    @en "Free"
    @fa "آزادسازی"
    pub func Free():
        _free_read_str(this.name)
        this.dims.Free()
    end

    @en "free"
    @fa "آزادسازی"
    pub func free():
        this.Free()
    end
end

@en "Gguf"
@fa "جی‌جی‌یو‌اف"
pub struct Gguf:
    @en "version"
    @fa "نسخه"
    pub version: int = 0
    @en "keys"
    @fa "کلیدها"
    pub keys: Vector<str> = Vector {}
    @en "values"
    @fa "مقدارها"
    pub values: Vector<MetaValue> = Vector {}
    @en "tensors"
    @fa "تانسورها"
    pub tensors: Vector<TensorInfo> = Vector {}
    @en "alignment"
    @fa "هم‌ترازی"
    pub alignment: int = 32
    @en "data_offset"
    @fa "آغاز داده"
    pub data_offset: int = 0
    @en "raw"
    @fa "بایت‌های خام"
    pub raw: compress.ByteBuf = compress.ByteBuf {}

    @en "MetaIndex"
    @fa "نمایه فراداده"
    pub func MetaIndex(key: str): int:
        repeat this.keys.Len() in i:
            if str.Equals(this.keys.get(i), key): ret i end
        end
        ret 0 - 1
    end

    @en "meta_index"
    @fa "نمایه فراداده"
    pub func meta_index(key: str): int:
        ret this.MetaIndex(key)
    end

    @en "MetaInt"
    @fa "فراداده صحیح"
    pub func MetaInt(key: str, dflt: i64): i64:
        k := this.MetaIndex(key)
        if k < 0: ret dflt end
        ret this.values.get(k).i
    end

    @en "meta_int"
    @fa "فراداده صحیح"
    pub func meta_int(key: str, dflt: i64): i64:
        ret this.MetaInt(key, dflt)
    end

    @en "MetaStr"
    @fa "فراداده رشته"
    pub func MetaStr(key: str): str:
        k := this.MetaIndex(key)
        if k < 0: ret "" end
        ret this.values.get(k).s
    end

    @en "meta_str"
    @fa "فراداده رشته"
    pub func meta_str(key: str): str:
        ret this.MetaStr(key)
    end

    @en "TensorIndex"
    @fa "نمایه تانسور"
    pub func TensorIndex(name: str): int:
        repeat this.tensors.Len() in i:
            t := this.tensors.get(i)
            if str.Equals(t.name, name): ret i end
        end
        ret 0 - 1
    end

    @en "tensor_index"
    @fa "نمایه تانسور"
    pub func tensor_index(name: str): int:
        ret this.TensorIndex(name)
    end

    @en "Free"
    @fa "آزادسازی"
    pub func Free():
        repeat this.keys.Len() in i: _free_read_str(this.keys.get(i)) end
        this.keys.Free()
        repeat this.values.Len() in i:
            mut v := this.values.get(i)
            v.Free()
        end
        this.values.Free()
        repeat this.tensors.Len() in i:
            mut t := this.tensors.get(i)
            t.Free()
        end
        this.tensors.Free()
        compress.BufFree(this.raw)
    end

    @en "free"
    @fa "آزادسازی"
    pub func free():
        this.Free()
    end
end

func _free_read_str(s: str):
    if str.Len(s) > 0: mem.Free(s as void*) end
end

func _gg_err(kind: ErrorKind, msg: str, at: int, code: str): Error:
    ret Error.At(kind, msg, at).with_code(code)
end

func _read_str(rd &: compress.ByteReader): str throws:
    at := rd.pos
    n := try binary.ReadU64LE(rd)
    if n < 0 or n > (compress.RdLeft(rd) as i64):
        throw _gg_err(ErrorKind.UnexpectedEnd, "a string of " + n + " bytes but " + compress.RdLeft(rd) + " are left", at, "gguf.truncated")
    end
    mut b := compress.RdBytes(rd, n as int)
    out := compress.BufToStrUnsafe(b)
    compress.BufFree(b)
    ret out
end

func _read_scalar(rd &: compress.ByteReader, kind: int, iv &: i64, fv &: f64) throws:
    if kind == 0:
        iv = (try binary.ReadU8(rd)) as i64
    else kind == 1:
        mut x := try binary.ReadU8(rd)
        if x >= 128: x -= 256 end
        iv = x as i64
    else kind == 2:
        iv = (try binary.ReadU16LE(rd)) as i64
    else kind == 3:
        mut x := try binary.ReadU16LE(rd)
        if x >= 32768: x -= 65536 end
        iv = x as i64
    else kind == 4:
        mut x := (try binary.ReadU32LE(rd)) as i64
        if x < 0: x += 4294967296 end
        iv = x
    else kind == 5:
        iv = (try binary.ReadU32LE(rd)) as i64
    else kind == 6:
        fv = try binary.ReadF32(rd, false)
    else kind == 7:
        iv = (try binary.ReadU8(rd)) as i64
    else kind == 10 or kind == 11:
        iv = try binary.ReadU64LE(rd)
    else kind == 12:
        fv = try binary.ReadF64(rd, false)
    else:
        throw _gg_err(ErrorKind.Unsupported, "unknown metadata type " + kind, rd.pos - 4, "gguf.meta_type")
    end
end

func _read_value(rd &: compress.ByteReader, kind: int, v &: MetaValue) throws:
    v.kind = kind
    if kind == META_STRING:
        v.s = try _read_str(rd)
        ret
    end
    if kind == META_ARRAY:
        at := rd.pos
        ek := try binary.ReadU32LE(rd)
        cnt := try binary.ReadU64LE(rd)
        if cnt < 0 or cnt > (compress.RdLeft(rd) as i64):
            throw _gg_err(ErrorKind.UnexpectedEnd, "an array of " + cnt + " items but " + compress.RdLeft(rd) + " bytes are left", at, "gguf.truncated")
        end
        v.elem_kind = ek
        repeat cnt as int:
            if ek == META_STRING:
                v.strs.push(try _read_str(rd))
            else ek == 6 or ek == 12:
                mut f := 0.0
                mut iv := 0 as i64
                try _read_scalar(rd, ek, iv, f)
                v.floats.push(f)
            else:
                mut f := 0.0
                mut iv := 0 as i64
                try _read_scalar(rd, ek, iv, f)
                v.ints.push(iv)
            end
        end
        ret
    end
    try _read_scalar(rd, kind, v.i, v.f)
end

func _parse(g &: Gguf) throws:
    mut rd := compress.ReaderFromBuf(g.raw)
    magic := try binary.ReadU32BE(rd)
    if magic != 0x47475546:
        throw _gg_err(ErrorKind.Syntax, "not a GGUF file (bad magic bytes)", 0, "gguf.bad_magic")
    end
    g.version = try binary.ReadU32LE(rd)
    if g.version != 2 and g.version != 3:
        throw _gg_err(ErrorKind.Unsupported, "unsupported GGUF version " + g.version, 4, "gguf.version")
    end
    ntensors := try binary.ReadU64LE(rd)
    nkv := try binary.ReadU64LE(rd)
    if ntensors < 0 or nkv < 0 or ntensors > (compress.RdLeft(rd) as i64) or nkv > (compress.RdLeft(rd) as i64):
        throw _gg_err(ErrorKind.Syntax, "impossible counts: " + ntensors + " tensors, " + nkv + " metadata entries", 8, "gguf.counts")
    end
    repeat nkv as int:
        key := try _read_str(rd)
        g.keys.push(key)
        kind := try binary.ReadU32LE(rd)
        mut v := MetaValue {}
        try:
            _read_value(rd, kind, v)
        catch e:
            v.Free()
            throw e.with_path(str.Clone(key))
        end
        g.values.push(v)
    end
    repeat ntensors as int:
        mut t := TensorInfo {}
        t.name = try _read_str(rd)
        try:
            at := rd.pos
            nd := binary.ReadU32LE(rd)
            if nd < 0 or nd > 8:
                throw _gg_err(ErrorKind.Syntax, "tensor rank " + nd + " (at most 8)", at, "gguf.rank")
            end
            repeat nd: t.dims.push(binary.ReadU64LE(rd) as int) end
            t.ggml_type = binary.ReadU32LE(rd)
            t.offset = binary.ReadU64LE(rd)
        catch e:
            path := str.Clone(t.name)
            t.Free()
            throw e.with_path(path)
        end
        g.tensors.push(t)
    end
    al := g.meta_int("general.alignment", 32)
    if al > 0: g.alignment = al as int end
    mut off := rd.pos
    if off % g.alignment != 0: off += (g.alignment - off % g.alignment) end
    g.data_offset = off
end

@en "ParseGguf"
@fa "تجزیه جی‌جی‌یو‌اف"
pub func ParseGguf(buf: compress.ByteBuf): Gguf throws:
    mut g := Gguf {}
    g.raw = buf
    try:
        _parse(g)
    catch e:
        g.raw = compress.ByteBuf {}
        g.Free()
        throw e.wrap("gguf")
    end
    ret g
end

@en "LoadGguf"
@fa "بارگذاری جی‌جی‌یو‌اف"
pub func LoadGguf(path: str): Gguf throws:
    mut fok := false
    mut raw := archive.ReadBinaryFile(path, fok)
    if fok == false:
        compress.BufFree(raw)
        throw Error.New(ErrorKind.NotFound, "cannot open file").with_path(path).wrap("gguf")
    end
    try:
        ret ParseGguf(raw)
    catch e:
        compress.BufFree(raw)
        if e.path == "": throw e.with_path(path) end
        throw e.with_path(path + ":" + e.path)
    end
end
