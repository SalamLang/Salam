package gguf

import compress
import encoding.binary
import math
import ai.tensor

func _half(bits: int): f64:
    sign := (bits >> 15) & 1
    exp := (bits >> 10) & 31
    frac := bits & 1023
    mut v := 0.0
    if exp == 0:
        v = (frac as f64) * math.Pow(2.0, 0.0 - 24.0)
    else exp == 31:
        if frac == 0: v = 1.0e300 * 1.0e300 else:
            v = 0.0 / 0.0
        end
    else:
        v = (1.0 + (frac as f64) / 1024.0) * math.Pow(2.0, (exp - 15) as f64)
    end
    if sign == 1: v = 0.0 - v end
    ret v
end

func _bytes_of(t &: TensorInfo): int:
    n := t.count()
    if t.ggml_type == GGML_F32: ret n * 4 end
    if t.ggml_type == GGML_F16: ret n * 2 end
    if t.ggml_type == GGML_Q8_0: ret (n / 32) * 34 end
    if t.ggml_type == GGML_Q4_0: ret (n / 32) * 18 end
    if t.ggml_type == GGML_Q4_1: ret (n / 32) * 20 end
    ret 0 - 1
end

@en "TensorBytes"
@fa "بایت‌های تانسور"
pub func TensorBytes(g &: Gguf, index: int): int:
    if index < 0 or index >= g.tensors.Len(): ret 0 - 1 end
    mut t := g.tensors.Get(index)
    ret _bytes_of(t)
end

@en "LoadTensorF32"
@fa "بارگذاری تانسور اعشاری"
pub func LoadTensorF32(g &: Gguf, index: int): tensor.Tensor throws:
    if index < 0 or index >= g.tensors.Len():
        throw Error.New(ErrorKind.OutOfRange, "tensor index " + index + " is out of range for " + g.tensors.Len() + " tensors").with_code("gguf.index").wrap("gguf")
    end
    mut t := g.tensors.Get(index)
    nbytes := _bytes_of(t)
    if nbytes < 0:
        throw Error.New(ErrorKind.Unsupported, "unsupported tensor type " + t.ggml_type).with_code("gguf.tensor_type").with_path(t.name).wrap("gguf")
    end
    n := t.count()
    if t.ggml_type != GGML_F32 and t.ggml_type != GGML_F16 and n % 32 != 0:
        throw Error.New(ErrorKind.Syntax, "a quantized tensor needs a multiple of 32 elements, got " + n).with_code("gguf.block").with_path(t.name).wrap("gguf")
    end
    start := (g.data_offset as i64) + t.offset
    if t.offset < 0 or start + (nbytes as i64) > (compress.BufLen(g.raw) as i64):
        throw Error.At(ErrorKind.UnexpectedEnd, "the tensor data (" + nbytes + " bytes) runs past the end of the file", start as int).with_code("gguf.truncated").with_path(t.name).wrap("gguf")
    end
    mut shape := Vector {} as Vector<int>
    mut i := t.dims.Len() - 1
    until i >= 0:
        shape.Push(t.dims.Get(i))
        i--
    end
    if shape.Len() == 0: shape.Push(1) end
    out := tensor.Zeros(shape)
    shape.Free()
    p := out.data.data
    mut rd := compress.NewByteReader(((g.raw.data as i64) + start) as void*, nbytes)
    if t.ggml_type == GGML_F32:
        repeat n in k: p[k] = try binary.ReadF32(rd, false) as f32 end
    else t.ggml_type == GGML_F16:
        repeat n in k: p[k] = _half(try binary.ReadU16LE(rd)) as f32 end
    else t.ggml_type == GGML_Q8_0:
        repeat n / 32 in b:
            d := _half(try binary.ReadU16LE(rd))
            repeat 32 in j:
                mut q := try binary.ReadU8(rd)
                if q >= 128: q -= 256 end
                p[b * 32 + j] = (d * (q as f64)) as f32
            end
        end
    else t.ggml_type == GGML_Q4_0:
        repeat n / 32 in b:
            d := _half(try binary.ReadU16LE(rd))
            repeat 16 in j:
                byte := try binary.ReadU8(rd)
                lo := (byte & 15) - 8
                hi := (byte >> 4) - 8
                p[b * 32 + j] = (d * (lo as f64)) as f32
                p[b * 32 + j + 16] = (d * (hi as f64)) as f32
            end
        end
    else:
        repeat n / 32 in b:
            d := _half(try binary.ReadU16LE(rd))
            m := _half(try binary.ReadU16LE(rd))
            repeat 16 in j:
                byte := try binary.ReadU8(rd)
                lo := byte & 15
                hi := byte >> 4
                p[b * 32 + j] = (d * (lo as f64) + m) as f32
                p[b * 32 + j + 16] = (d * (hi as f64) + m) as f32
            end
        end
    end
    ret out
end
