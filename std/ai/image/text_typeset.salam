package image

import gui.typeset

@en "TextDirAuto"
@fa "جهت متن خودکار"
pub const TextDirAuto := 0
@en "TextDirLTR"
@fa "جهت متن چپ به راست"
pub const TextDirLTR := 1
@en "TextDirRTL"
@fa "جهت متن راست به چپ"
pub const TextDirRTL := 2

@en "Font"
@fa "قلم"
pub struct Font:
    @en "Font"
    @fa "قلم پایه"
    pub use typeset.Font
end

func _wrap_font(f: typeset.Font): Font:
    mut out := Font {}
    out.Font = f
    ret out
end

func _blit_coverage_rows(img &: Image, cov: typeset.CoverageRows, c: Color):
    ca := c.a as int
    mut py := 0
    until py < cov.height:
        row := py * cov.width
        mut i := 0
        until i < cov.width:
            mut v := cov.values.get(row + i)
            if v > 0.002:
                if v > 1.0:
                    v = 1.0
                end
                alpha := ((ca as f64) * v + 0.5) as int
                if alpha > 0:
                    BlendPixel(img, cov.x + i, cov.y + py, RGBA(c.r as int, c.g as int, c.b as int, alpha))
                end
            end
            i++
        end
        py++
    end
end

func _draw_glyph_xform(img &: Image, f: Font, glyph: int, a: f64, b: f64, c: f64, d: f64, dx: f64, dy: f64, col: Color):
    if not FontValid(f) or img.pixels == null:
        ret
    end
    mut o := typeset.TransformedOutline(f.Font, glyph, a, b, c, d, dx, dy)
    mut cov := typeset.OutlineCoverage(o, img.width, img.height)
    _blit_coverage_rows(img, cov, col)
    typeset.FreeCoverageRows(cov)
    typeset.FreeOutline(o)
end

func _text_to_visual(text: str, st: TextStyle, out &: Vector<int>):
    v := typeset.VisualCodepoints(text, st.dir, st.shape)
    mut i := 0
    until i < v.Len():
        out.push(v.get(i))
        i++
    end
    v.Free()
end

@en "ParseFontIndex"
@fa "خواندن قلم با اندیس"
pub func ParseFontIndex(p: void*, n: int, index: int, ok &: bool): Font:
    ret _wrap_font(typeset.ParseFontIndex(p, n, index, ok))
end

@en "ParseFont"
@fa "خواندن قلم"
pub func ParseFont(p: void*, n: int, ok &: bool): Font:
    ret _wrap_font(typeset.ParseFontIndex(p, n, 0, ok))
end

@en "LoadFont"
@fa "بارگذاری قلم"
pub func LoadFont(path: str, ok &: bool): Font:
    ret _wrap_font(typeset.LoadFontIndex(path, 0, ok))
end

@en "LoadFontIndex"
@fa "بارگذاری قلم با اندیس"
pub func LoadFontIndex(path: str, index: int, ok &: bool): Font:
    ret _wrap_font(typeset.LoadFontIndex(path, index, ok))
end

@en "FreeFont"
@fa "آزادسازی قلم"
pub func FreeFont(f &: Font):
    typeset.FreeFont(f.Font)
end

@en "FontValid"
@fa "قلم معتبر"
pub func FontValid(f: Font): bool:
    ret typeset.FontValid(f.Font)
end

