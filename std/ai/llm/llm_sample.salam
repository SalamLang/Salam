package llm

import math
import sort
import ai.tensor

@en "Sampler"
@fa "نمونه‌بردار"
pub struct Sampler:
    @en "temperature"
    @fa "دما"
    pub temperature: f64 = 1.0
    @en "top_k"
    @fa "شمار محتمل‌ترین‌ها"
    pub top_k: int = 0
    @en "top_p"
    @fa "احتمال تجمعی"
    pub top_p: f64 = 1.0
    @en "repeat_penalty"
    @fa "جریمه تکرارها"
    pub repeat_penalty: f64 = 1.0
    @en "rng"
    @fa "مولد تصادفی"
    pub rng: tensor.Rng = tensor.Rng {}

    pub func Sample(logits &: tensor.Tensor, row: int, recent &: Vector<int>): int: ret this.sample(logits, row, recent) end
    @en "sample"
    pub func sample(logits &: tensor.Tensor, row: int, recent &: Vector<int>): this.Sample(logits, row, recent) end
end

@en "NewSampler"
@fa "نمونه‌بردار جدید"
pub func NewSampler(seed: i64): Sampler:
    mut s := Sampler {}
    s.rng = tensor.NewRng(seed)
    ret s
end

@en "Greedy"
@fa "حریصانه"
pub func Greedy(logits &: tensor.Tensor, row: int): int:
    vocab := logits.dim(logits.rank() - 1)
    base := row * vocab
    mut best := 0
    repeat vocab in k:
        if logits.at(base + k) > logits.at(base + best): best = k end
    end
    ret best
end

@en "GenerateIds"
@fa "تولید شناسه‌ها"
pub func GenerateIds(m &: Model, cache &: KVCache, prompt_ids &: Vector<int>, max_new: int, sp &: Sampler, eos: int): Vector<int>:
    mut out := Vector {} as Vector<int>
    if prompt_ids.Len() == 0: ret out end
    mut logits := Forward(m, cache, prompt_ids)
    if logits.IsEmpty(): ret out end
    mut step := Vector {} as Vector<int>
    step.Push(0)
    mut n := 0
    mut stop := false
    until n < max_new and not stop:
        next := sp.sample(logits, logits.dim(0) - 1, out)
        logits.Free()
        if next == eos:
            stop = true
        else:
            out.Push(next)
            n++
            if cache.len >= cache.ctx:
                stop = true
            else:
                step.Set(0, next)
                logits = Forward(m, cache, step)
                if logits.IsEmpty(): stop = true end
            end
        end
    end
    if not stop: logits.Free() end
    step.Free()
    ret out
end

@en "Generate"
@fa "تولید"
pub func Generate(m &: Model, cache &: KVCache, tok &: Tokenizer, prompt: str, max_new: int, sp &: Sampler): str:
    mut ids := tok.encode(prompt)
    mut gen := GenerateIds(m, cache, ids, max_new, sp, tok.eos)
    text := tok.decode(gen)
    ids.Free()
    gen.Free()
    ret text
end
