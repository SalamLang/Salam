package ml

import math
import matrix

@en "AdaBoost"
@fa "آدابوست"
pub struct AdaBoost:
    @en "n_estimators"
    @fa "شمار برآوردگرها"
    pub n_estimators: int = 50
    @en "max_depth"
    @fa "بیشترین عمق"
    pub max_depth: int = 1
    @en "learning_rate"
    @fa "نرخ یادگیری"
    pub learning_rate: f64 = 1.0
    @en "seed"
    @fa "بذر"
    pub seed: i64 = 42
    @en "trees"
    @fa "درخت‌ها"
    pub trees: Vector<DecisionTree> = Vector {}
    @en "alphas"
    @fa "وزن درخت‌ها"
    pub alphas: Vector<f64> = Vector {}
    @en "n_classes"
    @fa "شمار رده‌ها"
    pub n_classes: int = 0
    @en "ok"
    @fa "موفق"
    pub ok: bool = false


@en "GradientBoosting"
@fa "تقویت گرادیانی"
pub struct GradientBoosting:
    @en "n_estimators"
    @fa "شمار برآوردگرها"
    pub n_estimators: int = 100
    @en "learning_rate"
    @fa "نرخ یادگیری"
    pub learning_rate: f64 = 0.1
    @en "max_depth"
    @fa "بیشترین عمق"
    pub max_depth: int = 3
    @en "min_samples_leaf"
    @fa "کمترین نمونه برگ"
    pub min_samples_leaf: int = 1
    @en "regression"
    @fa "رگرسیون"
    pub regression: bool = false
    @en "trees"
    @fa "درخت‌ها"
    pub trees: Vector<DecisionTree> = Vector {}
    @en "base"
    @fa "پیش‌بینی پایه"
    pub base: matrix.Matrix = matrix.Matrix {}
    @en "n_classes"
    @fa "شمار رده‌ها"
    pub n_classes: int = 0
    @en "ok"
    @fa "موفق"
    pub ok: bool = false

    @en "Fit"
    @fa "برازش"
    pub func Fit(x &: matrix.Matrix, y &: matrix.Matrix): bool:
        this.ok = false
        if x.IsEmpty() or y.rows != x.rows or y.cols != 1 or this.n_estimators < 1: ret false end
        n := x.rows
        this.FreeAll()
        mut k := 1
        if this.regression == false:
            k = CountClasses(y)
            if k < 2: ret false end
        end
        matrix.Free(this.base)
        this.base = matrix.Zeros(1, k)
        mut f := matrix.Zeros(n, k)
        if this.regression:
            mut mean := 0.0
            repeat n in i: mean += y.at(i, 0) end
            mean /= (n as f64)
            this.base.Set(0, 0, mean)
            repeat n in i: f.Set(i, 0, mean) end
        else:
            repeat n in i: this.base.add_at(0, y.at(i, 0) as int, 1.0) end
            repeat k in c:
                mut pr := this.base.at(0, c) / (n as f64)
                if pr < 1.0e-6: pr = 1.0e-6 end
                this.base.Set(0, c, math.Log(pr))
            end
            repeat n in i:
                repeat k in c: f.Set(i, c, this.base.at(0, c)) end
            end
        end
        mut resid := matrix.Zeros(n, 1)
        repeat this.n_estimators in round:
            repeat k in c:
                if this.regression:
                    repeat n in i: resid.Set(i, 0, y.at(i, 0) - f.at(i, 0)) end
                else:
                    repeat n in i:
                        mut m := f.at(i, 0)
                        repeat k in cc:
                            if f.at(i, cc) > m: m = f.at(i, cc) end
                        end
                        mut s := 0.0
                        repeat k in cc: s += math.Exp(f.at(i, cc) - m) end
                        p := math.Exp(f.at(i, c) - m) / s
                        mut target := 0.0
                        if (y.at(i, 0) as int) == c: target = 1.0 end
                        resid.Set(i, 0, target - p)
                    end
                end
                mut tree := DecisionTree {}
                tree.criterion = TREE_MSE
                tree.max_depth = this.max_depth
                tree.min_samples_leaf = this.min_samples_leaf
                tree.seed = (round * k + c) as i64
                tree.Fit(x, resid)
                mut step := tree.Predict(x)
                repeat n in i: f.add_at(i, c, this.learning_rate * step.at(i, 0)) end
                matrix.Free(step)
                this.trees.Push(tree)
            end
        end
        matrix.Free(resid)
        matrix.Free(f)
        this.n_classes = k
        this.ok = true
        ret true
    end

    @en "fit"
    @fa "برازش"
    pub func fit(x &: matrix.Matrix, y &: matrix.Matrix): bool: ret this.Fit(x, y) end

    @en "Decision"
    @fa "تصمیم"
    pub func Decision(x &: matrix.Matrix): matrix.Matrix:
        if this.ok == false: ret matrix.Matrix {} end
        k := this.n_classes
        mut f := matrix.Zeros(x.rows, k)
        repeat x.rows in i:
            repeat k in c: f.Set(i, c, this.base.at(0, c)) end
        end
        rounds := this.trees.Len() / k
        repeat rounds in r:
            repeat k in c:
                mut tree := this.trees.Get(r * k + c)
                mut step := tree.Predict(x)
                repeat x.rows in i: f.add_at(i, c, this.learning_rate * step.at(i, 0)) end
                matrix.Free(step)
            end
        end
        ret f
    end

    @en "decision"
    @fa "تصمیم"
    pub func decision(x &: matrix.Matrix): matrix.Matrix: ret this.Decision(x) end

    @en "PredictProba"
    @fa "پیش‌بینی احتمال"
    pub func PredictProba(x &: matrix.Matrix): matrix.Matrix:
        if this.ok == false or this.regression: ret matrix.Matrix {} end
        mut f := this.Decision(x)
        k := this.n_classes
        repeat x.rows in i:
            mut m := f.at(i, 0)
            repeat k in c:
                if f.at(i, c) > m: m = f.at(i, c) end
            end
            mut s := 0.0
            repeat k in c:
                e := math.Exp(f.at(i, c) - m)
                f.Set(i, c, e)
                s += e
            end
            repeat k in c: f.Set(i, c, f.at(i, c) / s) end
        end
        ret f
    end

    @en "predict_proba"
    @fa "پیش‌بینی احتمال"
    pub func predict_proba(x &: matrix.Matrix): matrix.Matrix: ret this.PredictProba(x) end

    @en "Predict"
    @fa "پیش‌بینی"
    pub func Predict(x &: matrix.Matrix): matrix.Matrix:
        if this.ok == false: ret matrix.Matrix {} end
        if this.regression: ret this.Decision(x) end
        mut probs := this.PredictProba(x)
        out := _argmax_rows(probs)
        matrix.Free(probs)
        ret out
    end

    @en "predict"
    @fa "پیش‌بینی"
    pub func predict(x &: matrix.Matrix): matrix.Matrix: ret this.Predict(x) end

    @en "Score"
    @fa "امتیاز"
    pub func Score(x &: matrix.Matrix, y &: matrix.Matrix): f64:
        mut p := this.Predict(x)
        if p.IsEmpty(): ret 0.0 end
        mut r := 0.0
        if this.regression: r = R2Score(y, p)
        else:
            r = Accuracy(y, p)
        end
        matrix.Free(p)
        ret r
    end

    @en "score"
    @fa "امتیاز"
    pub func score(x &: matrix.Matrix, y &: matrix.Matrix): f64: ret this.Score(x, y) end

    @en "FreeAll"
    @fa "آزادسازی همه"
    pub func FreeAll():
        repeat this.trees.Len() in t:
            mut tree := this.trees.Get(t)
            tree.Free()
        end
        this.trees.Free()
    end

    @en "free_all"
    @fa "آزادسازی همه"
    pub func free_all(): this.FreeAll() end

    @en "Free"
    @fa "آزادسازی"
    pub func Free():
        this.FreeAll()
        matrix.Free(this.base)
    end

    @en "free"
    @fa "آزادسازی"
    pub func free(): this.Free() end
end

func _weighted_pick(wts &: Vector<f64>, u: f64): int:
    mut acc := 0.0
    n := wts.Len()
    repeat n in i:
        acc += wts.Get(i)
        if acc >= u: ret i end
    end
    ret n - 1
end

func _argmax_rows(p &: matrix.Matrix): matrix.Matrix:
    mut out := matrix.Zeros(p.rows, 1)
    repeat p.rows in i:
        mut best := 0
        repeat p.cols in c:
            if p.at(i, c) > p.at(i, best): best = c end
        end
        out.Set(i, 0, best as f64)
    end
    ret out
end
    @en "fit"
    @fa "برازش"
    pub func fit(x &: matrix.Matrix, y &: matrix.Matrix): this.Fit(x, y) end
