package ml

import math
import matrix

@en "LINK_SINGLE"
@fa "پیوند تکی"
pub const LINK_SINGLE := 0

@en "LINK_COMPLETE"
@fa "پیوند کامل"
pub const LINK_COMPLETE := 1

@en "LINK_AVERAGE"
@fa "پیوند میانگین"
pub const LINK_AVERAGE := 2

@en "GaussianMixture"
@fa "آمیزه گاوسی"
pub struct GaussianMixture:
    @en "k"
    @fa "شمار مؤلفه‌ها"
    pub k: int = 2
    @en "max_iter"
    @fa "بیشترین دور"
    pub max_iter: int = 100
    @en "tol"
    @fa "رواداری"
    pub tol: f64 = 0.0001
    @en "var_floor"
    @fa "کف واریانس"
    pub var_floor: f64 = 0.000001
    @en "seed"
    @fa "بذر"
    pub seed: i64 = 42
    @en "means"
    @fa "میانگین‌ها"
    pub means: matrix.Matrix = matrix.Matrix {}
    @en "vars"
    @fa "واریانس‌ها"
    pub vars: matrix.Matrix = matrix.Matrix {}
    @en "weights"
    @fa "وزن‌ها"
    pub weights: matrix.Matrix = matrix.Matrix {}
    @en "log_likelihood"
    @fa "لگاریتم راست‌نمایی"
    pub log_likelihood: f64 = 0.0
    @en "n_iter"
    @fa "شمار تکرارها"
    pub n_iter: int = 0
    @en "ok"
    @fa "موفق"
    pub ok: bool = false

    pub func Fit(x &: matrix.Matrix): bool: ret this.fit(x) end
    @en "fit"
    pub func fit(x &: matrix.Matrix): this.Fit(x) end

    pub func PredictProba(x &: matrix.Matrix): matrix.Matrix: ret this.predict_proba(x) end
    @en "predict_proba"
    pub func predict_proba(x &: matrix.Matrix): this.PredictProba(x) end

    pub func Predict(x &: matrix.Matrix): matrix.Matrix: ret this.predict(x) end
    @en "predict"
    pub func predict(x &: matrix.Matrix): this.Predict(x) end

    pub func FitPredict(x &: matrix.Matrix): matrix.Matrix: ret this.fit_predict(x) end
    @en "fit_predict"
    pub func fit_predict(x &: matrix.Matrix): this.FitPredict(x) end

    @en "Free"
    @fa "آزادسازی"
    pub func Free():
        matrix.Free(this.means)
        matrix.Free(this.vars)
        matrix.Free(this.weights)
    end

    @en "free"
    @fa "آزادسازی"
    pub func free(): this.Free() end
end

@en "Agglomerative"
@fa "خوشه‌بندی تجمیعی"
pub struct Agglomerative:
    @en "n_clusters"
    @fa "شمار خوشه‌ها"
    pub n_clusters: int = 2
    @en "linkage"
    @fa "پیوند"
    pub linkage: int = LINK_AVERAGE
    @en "labels"
    @fa "برچسب‌ها"
    pub labels: matrix.Matrix = matrix.Matrix {}
    @en "ok"
    @fa "موفق"
    pub ok: bool = false

