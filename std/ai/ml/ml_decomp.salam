package ml

import matrix

@en "PCA"
@fa "تحلیل مؤلفه اصلی"
pub struct PCA:
    @en "n_components"
    @fa "شمار مؤلفه‌ها"
    pub n_components: int = 0
    @en "components"
    @fa "مؤلفه‌ها"
    pub components: matrix.Matrix = matrix.Matrix {}
    @en "mean"
    @fa "میانگین"
    pub mean: matrix.Matrix = matrix.Matrix {}
    @en "explained_variance"
    @fa "واریانس توضیح‌داده‌شده"
    pub explained_variance: matrix.Matrix = matrix.Matrix {}
    @en "explained_ratio"
    @fa "نسبت توضیح‌داده‌شده"
    pub explained_ratio: matrix.Matrix = matrix.Matrix {}
    @en "ok"
    @fa "موفق"
    pub ok: bool = false

    pub func Fit(x &: matrix.Matrix): bool: ret this.fit(x) end
    @en "fit"
    pub func fit(x &: matrix.Matrix): this.Fit(x) end

    pub func Transform(x &: matrix.Matrix): matrix.Matrix: ret this.transform(x) end
    @en "transform"
    pub func transform(x &: matrix.Matrix): this.Transform(x) end

    pub func FitTransform(x &: matrix.Matrix): matrix.Matrix: ret this.fit_transform(x) end
    @en "fit_transform"
    pub func fit_transform(x &: matrix.Matrix): this.FitTransform(x) end

    pub func InverseTransform(z &: matrix.Matrix): matrix.Matrix: ret this.inverse_transform(z) end
    @en "inverse_transform"
    pub func inverse_transform(z &: matrix.Matrix): this.InverseTransform(z) end

end

@en "TruncatedSVD"
@fa "تجزیه مقادیر تکین بریده"
pub struct TruncatedSVD:
    @en "n_components"
    @fa "شمار مؤلفه‌ها"
    pub n_components: int = 2
    @en "components"
    @fa "مؤلفه‌ها"
    pub components: matrix.Matrix = matrix.Matrix {}
    @en "singular_values"
    @fa "مقدارهای تکین"
    pub singular_values: matrix.Matrix = matrix.Matrix {}
    @en "explained_variance"
    @fa "واریانس توضیح‌داده‌شده"
    pub explained_variance: matrix.Matrix = matrix.Matrix {}
    @en "explained_ratio"
    @fa "نسبت توضیح‌داده‌شده"
    pub explained_ratio: matrix.Matrix = matrix.Matrix {}
    @en "ok"
    @fa "موفق"
    pub ok: bool = false









    @en "Free"
    @fa "آزادسازی"
    pub func Free():
        matrix.Free(this.components)
        matrix.Free(this.singular_values)
        matrix.Free(this.explained_variance)
        matrix.Free(this.explained_ratio)
    end

    @en "free"
    @fa "آزادسازی"
    pub func free(): this.Free() end
end
