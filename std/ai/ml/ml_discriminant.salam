package ml

import math
import matrix

@en "LDA"
@fa "تحلیل تشخیصی خطی"
pub struct LDA:
    @en "ridge"
    @fa "منظم‌سازی"
    pub ridge: f64 = 0.000001
    @en "means"
    @fa "میانگین‌ها"
    pub means: matrix.Matrix = matrix.Matrix {}
    @en "cov"
    @fa "کوواریانس"
    pub cov: matrix.Matrix = matrix.Matrix {}
    @en "log_priors"
    @fa "لگاریتم پیشین‌ها"
    pub log_priors: matrix.Matrix = matrix.Matrix {}
    @en "n_classes"
    @fa "شمار رده‌ها"
    pub n_classes: int = 0
    @en "ok"
    @fa "موفق"
    pub ok: bool = false

    pub func Fit(x &: matrix.Matrix, y &: matrix.Matrix): bool: ret this.fit(x, y) end
    @en "fit"
    pub func fit(x &: matrix.Matrix, y &: matrix.Matrix): this.Fit(x, y) end

    pub func PredictProba(x &: matrix.Matrix): matrix.Matrix: ret this.predict_proba(x) end
    @en "predict_proba"
    pub func predict_proba(x &: matrix.Matrix): this.PredictProba(x) end

    pub func Predict(x &: matrix.Matrix): matrix.Matrix: ret this.predict(x) end
    @en "predict"
    pub func predict(x &: matrix.Matrix): this.Predict(x) end

    pub func Score(x &: matrix.Matrix, y &: matrix.Matrix): f64: ret this.score(x, y) end
    @en "score"
    pub func score(x &: matrix.Matrix, y &: matrix.Matrix): this.Score(x, y) end

end

@en "QDA"
@fa "تحلیل تشخیصی درجه دو"
pub struct QDA:
    @en "ridge"
    @fa "منظم‌سازی"
    pub ridge: f64 = 0.000001
    @en "means"
    @fa "میانگین‌ها"
    pub means: matrix.Matrix = matrix.Matrix {}
    @en "covs"
    @fa "کوواریانس‌ها"
    pub covs: Vector<matrix.Matrix> = Vector {}
    @en "log_priors"
    @fa "لگاریتم پیشین‌ها"
    pub log_priors: matrix.Matrix = matrix.Matrix {}
    @en "n_classes"
    @fa "شمار رده‌ها"
    pub n_classes: int = 0
    @en "ok"
    @fa "موفق"
    pub ok: bool = false









    @en "Free"
    @fa "آزادسازی"
    pub func Free():
        matrix.Free(this.means)
        matrix.Free(this.log_priors)
        repeat this.covs.Len() in c:
            mut cv := this.covs.Get(c)
            matrix.Free(cv)
        end
        this.covs.Free()
    end

    @en "free"
    @fa "آزادسازی"
    pub func free(): this.Free() end
end

func _class_means(x &: matrix.Matrix, y &: matrix.Matrix, k: int, counts &: Vector<int>): matrix.Matrix:
    mut m := matrix.Zeros(k, x.cols)
    repeat x.rows in i:
        c := y.at(i, 0) as int
        counts.Set(c, counts.Get(c) + 1)
        repeat x.cols in j: m.add_at(c, j, x.at(i, j)) end
    end
    repeat k in c:
        if counts.Get(c) > 0:
            repeat x.cols in j: m.mul_at(c, j, 1.0 / (counts.Get(c) as f64)) end
        end
    end
    ret m
end

func _softmax_rows(m &: matrix.Matrix):
    repeat m.rows in i:
        mut mx := m.at(i, 0)
        repeat m.cols in c:
            if m.at(i, c) > mx: mx = m.at(i, c) end
        end
        mut s := 0.0
        repeat m.cols in c:
            e := math.Exp(m.at(i, c) - mx)
            m.Set(i, c, e)
            s += e
        end
        repeat m.cols in c: m.Set(i, c, m.at(i, c) / s) end
    end
end
