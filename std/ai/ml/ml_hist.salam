package ml

import math
import matrix
import sort

@en "HistTree"
@fa "درخت هیستوگرام"
pub struct HistTree:
    @en "feature"
    @fa "ویژگی"
    pub feature: Vector<int> = Vector {}
    @en "threshold"
    @fa "آستانه"
    pub threshold: Vector<f64> = Vector {}
    @en "left"
    @fa "چپ"
    pub left: Vector<int> = Vector {}
    @en "right"
    @fa "راست"
    pub right: Vector<int> = Vector {}
    @en "value"
    @fa "مقدار"
    pub value: Vector<f64> = Vector {}

    @en "ApplyRow"
    @fa "اعمال سطر"
    pub func ApplyRow(x &: matrix.Matrix, i: int): f64:
        mut nd := 0
        until this.feature.Get(nd) >= 0:
            if x.at(i, this.feature.Get(nd)) <= this.threshold.Get(nd):
                nd = this.left.Get(nd)
            else:
                nd = this.right.Get(nd)
            end
        end
        ret this.value.Get(nd)
    end
    pub func ApplyRow(x &: matrix.Matrix, i: int): f64: ret this.apply_row(x, i) end

    @en "Free"
    @fa "آزادسازی"
    pub func Free():
        this.feature.Free()
        this.threshold.Free()
        this.left.Free()
        this.right.Free()
        this.value.Free()
    end

    @en "free"
    @fa "آزادسازی"
    pub func free(): this.Free() end
end
    @en "apply_row"
    @fa "اعمال سطر"
    pub func apply_row(x &: matrix.Matrix, i: int): this.ApplyRow(x, i) end

@en "HistGradientBoosting"
@fa "تقویت گرادیان هیستوگرامی"
pub struct HistGradientBoosting:
    @en "n_estimators"
    @fa "شمار برآوردگرها"
    pub n_estimators: int = 100
    @en "learning_rate"
    @fa "نرخ یادگیری"
    pub learning_rate: f64 = 0.1
    @en "max_depth"
    @fa "بیشترین عمق"
    pub max_depth: int = 6
    @en "max_bins"
    @fa "بیشترین بازه"
    pub max_bins: int = 255
    @en "min_samples_leaf"
    @fa "کمترین نمونه برگ"
    pub min_samples_leaf: int = 20
    @en "l2"
    @fa "ضریب ال دو"
    pub l2: f64 = 1.0
    @en "regression"
    @fa "رگرسیون"
    pub regression: bool = false
    @en "edges"
    @fa "مرزها"
    pub edges: Vector<f64> = Vector {}
    @en "edges_start"
    @fa "آغاز مرزها"
    pub edges_start: Vector<int> = Vector {}
    @en "base"
    @fa "پیش‌بینی پایه"
    pub base: Vector<f64> = Vector {}
    @en "trees"
    @fa "درخت‌ها"
    pub trees: Vector<HistTree> = Vector {}
    @en "n_classes"
    @fa "شمار رده‌ها"
    pub n_classes: int = 0
    @en "ok"
    @fa "موفق"
    pub ok: bool = false

    @en "Fit"
    @fa "برازش"
    pub func Fit(x &: matrix.Matrix, y &: matrix.Matrix): bool:
        this.FreeAll()
        this.ok = false
        n := x.rows
        p := x.cols
        if n < 2 or p < 1 or y.rows != n: ret false end
        kk := this.regression ? 1 : CountClasses(y)
        if not this.regression and kk < 2: ret false end
        this.n_classes = kk
        mut bins := Vector {} as Vector<int>
        repeat n * p: bins.Push(0) end
        _hist_bin_features(x, this.max_bins, this.edges, this.edges_start, bins)
        repeat kk: this.base.Push(0.0) end
        if this.regression:
            mut s := 0.0
            repeat n in i: s += y.at(i, 0) end
            this.base.Set(0, s / (n as f64))
        else:
            mut counts := Vector {} as Vector<f64>
            repeat kk: counts.Push(1.0) end
            repeat n in i:
                c := y.at(i, 0) as int
                counts.Set(c, counts.Get(c) + 1.0)
            end
            repeat kk in c: this.base.Set(c, math.Log(counts.Get(c) / ((n + kk) as f64))) end
            counts.Free()
        end
        mut f := Vector {} as Vector<f64>
        repeat n:
            repeat kk in c: f.Push(this.base.Get(c)) end
        end
        mut g := Vector {} as Vector<f64>
        mut h := Vector {} as Vector<f64>
        repeat n:
            g.Push(0.0)
            h.Push(0.0)
        end
        mut probs := Vector {} as Vector<f64>
        repeat kk: probs.Push(0.0) end
        mut edges := this.edges
        mut starts := this.edges_start
        repeat this.n_estimators:
            repeat kk in c:
                repeat n in i:
                    if this.regression:
                        g.Set(i, f.Get(i) - y.at(i, 0))
                        h.Set(i, 1.0)
                    else:
                        _softmax_row(f, i, kk, probs)
                        pc := probs.Get(c)
                        target := (y.at(i, 0) as int) == c ? 1.0 : 0.0
                        g.Set(i, pc - target)
                        h.Set(i, pc * (1.0 - pc) + 0.000001)
                    end
                end
                mut t := HistTree {}
                _hist_grow(t, bins, n, p, edges, starts, g, h, this.max_depth, this.min_samples_leaf, this.l2, this.learning_rate)
                repeat n in i: f.Set(i * kk + c, f.Get(i * kk + c) + t.apply_row(x, i)) end
                this.trees.Push(t)
            end
        end
        bins.Free()
        f.Free()
        g.Free()
        h.Free()
        probs.Free()
        this.ok = true
        ret true
    end
    pub func Fit(x &: matrix.Matrix, y &: matrix.Matrix): bool: ret this.fit(x, y) end

    @en "Decision"
    @fa "تصمیم"
    pub func Decision(x &: matrix.Matrix): matrix.Matrix:
        if not this.ok: ret matrix.Matrix {} end
        kk := this.n_classes
        mut out := matrix.Zeros(x.rows, kk)
        repeat x.rows in i:
            repeat kk in c: out.Set(i, c, this.base.Get(c)) end
        end
        repeat this.trees.Len() in ti:
            c := ti % kk
            t := this.trees.Get(ti)
            repeat x.rows in i: out.add_at(i, c, t.apply_row(x, i)) end
        end
        ret out
    end

    @en "decision"
    @fa "تصمیم"
    pub func decision(x &: matrix.Matrix): matrix.Matrix: ret this.Decision(x) end

    @en "PredictProba"
    @fa "پیش‌بینی احتمال"
    pub func PredictProba(x &: matrix.Matrix): matrix.Matrix:
        mut out := this.Decision(x)
        if out.IsEmpty() or this.regression: ret out end
        kk := this.n_classes
        mut probs := Vector {} as Vector<f64>
        repeat kk: probs.Push(0.0) end
        repeat x.rows in i:
            _softmax_row(out.a, i, kk, probs)
            repeat kk in c: out.Set(i, c, probs.Get(c)) end
        end
        probs.Free()
        ret out
    end

    @en "predict_proba"
    @fa "پیش‌بینی احتمال"
    pub func predict_proba(x &: matrix.Matrix): matrix.Matrix: ret this.PredictProba(x) end

    @en "Predict"
    @fa "پیش‌بینی"
    pub func Predict(x &: matrix.Matrix): matrix.Matrix:
        mut d := this.Decision(x)
        if d.IsEmpty() or this.regression: ret d end
        out := _argmax_rows(d)
        matrix.Free(d)
        ret out
    end

    @en "predict"
    @fa "پیش‌بینی"
    pub func predict(x &: matrix.Matrix): matrix.Matrix: ret this.Predict(x) end

    @en "Score"
    @fa "امتیاز"
    pub func Score(x &: matrix.Matrix, y &: matrix.Matrix): f64:
        mut pred := this.Predict(x)
        if pred.IsEmpty(): ret 0.0 end
        v := this.regression ? R2Score(y, pred) : Accuracy(y, pred)
        matrix.Free(pred)
        ret v
    end

    @en "score"
    @fa "امتیاز"
    pub func score(x &: matrix.Matrix, y &: matrix.Matrix): f64: ret this.Score(x, y) end

    @en "FreeAll"
    @fa "آزادسازی همه"
    pub func FreeAll():
        this.edges.Free()
        this.edges_start.Free()
        this.base.Free()
        repeat this.trees.Len() in i:
            mut t := this.trees.Get(i)
            t.Free()
        end
        this.trees.Free()
    end

    @en "free_all"
    @fa "آزادسازی همه"
    pub func free_all(): this.FreeAll() end

    @en "Free"
    @fa "آزادسازی"
    pub func Free(): this.FreeAll() end

    @en "free"
    @fa "آزادسازی"
    pub func free(): this.Free() end
end

func _hist_bin_features(x &: matrix.Matrix, max_bins: int, edges &: Vector<f64>, starts &: Vector<int>, bins &: Vector<int>):
    n := x.rows
    p := x.cols
    mut col := Vector {} as Vector<f64>
    repeat p in j:
        starts.Push(edges.Len())
        col.Clear()
        repeat n in i: col.Push(x.at(i, j)) end
        sort.Sort(col)
        mut last := 0.0
        mut have := false
        repeat max_bins - 1 in b:
            e := col.Get(((b + 1) * n) / max_bins)
            if e >= col.Get(n - 1): continue end
            if have and e <= last: continue end
            edges.Push(e)
            last = e
            have = true
        end
    end
    starts.Push(edges.Len())
    repeat p in j:
        lo := starts.Get(j)
        hi := starts.Get(j + 1)
        repeat n in i:
            v := x.at(i, j)
            mut a := lo
            mut b := hi
            until a < b:
                mid := (a + b) / 2
                if edges.Get(mid) < v: a = mid + 1 else:
                    b = mid
                end
            end
            bins.Set(i * p + j, a - lo)
        end
    end
    col.Free()
end

func _softmax_row(f &: Vector<f64>, i: int, kk: int, probs &: Vector<f64>):
    mut mx := f.Get(i * kk)
    repeat kk in c:
        if f.Get(i * kk + c) > mx: mx = f.Get(i * kk + c) end
    end
    mut s := 0.0
    repeat kk in c:
        e := math.Exp(f.Get(i * kk + c) - mx)
        probs.Set(c, e)
        s += e
    end
    repeat kk in c: probs.Set(c, probs.Get(c) / s) end
end

func _hist_leaf(t &: HistTree, value: f64): int:
    id := t.feature.Len()
    t.feature.Push(0 - 1)
    t.threshold.Push(0.0)
    t.left.Push(0 - 1)
    t.right.Push(0 - 1)
    t.value.Push(value)
    ret id
end

func _hist_grow(t &: HistTree, bins &: Vector<int>, n: int, p: int, edges &: Vector<f64>, starts &: Vector<int>, g &: Vector<f64>, h &: Vector<f64>, max_depth: int, min_leaf: int, l2: f64, lr: f64):
    mut rows := Vector {} as Vector<int>
    repeat n in i: rows.Push(i) end
    mut st_node := Vector {} as Vector<int>
    mut st_lo := Vector {} as Vector<int>
    mut st_hi := Vector {} as Vector<int>
    mut st_depth := Vector {} as Vector<int>
    root := _hist_leaf(t, 0.0)
    st_node.Push(root)
    st_lo.Push(0)
    st_hi.Push(n)
    st_depth.Push(0)
    mut hg := Vector {} as Vector<f64>
    mut hh := Vector {} as Vector<f64>
    mut hc := Vector {} as Vector<int>
    until st_node.Len() > 0:
        nd := st_node.Pop()
        lo := st_lo.Pop()
        hi := st_hi.Pop()
        depth := st_depth.Pop()
        mut gs := 0.0
        mut hs := 0.0
        repeat hi - lo in r:
            i := rows.Get(lo + r)
            gs += g.Get(i)
            hs += h.Get(i)
        end
        t.value.Set(nd, 0.0 - lr * gs / (hs + l2))
        if depth >= max_depth or hi - lo < 2 * min_leaf: continue end
        parent_gain := gs * gs / (hs + l2)
        mut best_gain := 0.0
        mut best_f := 0 - 1
        mut best_b := 0
        repeat p in j:
            nb := starts.Get(j + 1) - starts.Get(j) + 1
            if nb < 2: continue end
            hg.Clear()
            hh.Clear()
            hc.Clear()
            repeat nb:
                hg.Push(0.0)
                hh.Push(0.0)
                hc.Push(0)
            end
            repeat hi - lo in r:
                i := rows.Get(lo + r)
                b := bins.Get(i * p + j)
                hg.Set(b, hg.Get(b) + g.Get(i))
                hh.Set(b, hh.Get(b) + h.Get(i))
                hc.Set(b, hc.Get(b) + 1)
            end
            mut gl := 0.0
            mut hl := 0.0
            mut cl := 0
            repeat nb - 1 in b:
                gl += hg.Get(b)
                hl += hh.Get(b)
                cl += hc.Get(b)
                cr := hi - lo - cl
                if cl < min_leaf or cr < min_leaf: continue end
                gr := gs - gl
                hr := hs - hl
                gain := gl * gl / (hl + l2) + gr * gr / (hr + l2) - parent_gain
                if gain > best_gain:
                    best_gain = gain
                    best_f = j
                    best_b = b
                end
            end
        end
        if best_f < 0: continue end
        mut a := lo
        mut b2 := hi - 1
        until a <= b2:
            if bins.Get(rows.Get(a) * p + best_f) <= best_b:
                a++
            else:
                tmp := rows.Get(a)
                rows.Set(a, rows.Get(b2))
                rows.Set(b2, tmp)
                b2--
            end
        end
        mid := a
        left := _hist_leaf(t, 0.0)
        right := _hist_leaf(t, 0.0)
        t.feature.Set(nd, best_f)
        t.threshold.Set(nd, edges.Get(starts.Get(best_f) + best_b))
        t.left.Set(nd, left)
        t.right.Set(nd, right)
        st_node.Push(left)
        st_lo.Push(lo)
        st_hi.Push(mid)
        st_depth.Push(depth + 1)
        st_node.Push(right)
        st_lo.Push(mid)
        st_hi.Push(hi)
        st_depth.Push(depth + 1)
    end
    rows.Free()
    st_node.Free()
    st_lo.Free()
    st_hi.Free()
    st_depth.Free()
    hg.Free()
    hh.Free()
    hc.Free()
end
    @en "fit"
    @fa "برازش"
    pub func fit(x &: matrix.Matrix, y &: matrix.Matrix): this.Fit(x, y) end
