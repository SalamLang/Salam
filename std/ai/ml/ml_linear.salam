end

@en "Lasso"
@fa "لاسو"
pub struct Lasso:
    @en "alpha"
    @fa "ضریب منظم‌سازی"
    pub alpha: f64 = 1.0
    @en "l1_ratio"
    @fa "نسبت ال یک"
    pub l1_ratio: f64 = 1.0
    @en "fit_intercept"
    @fa "برازش عرض از مبدأ"
    pub fit_intercept: bool = true
    @en "max_iter"
    @fa "بیشترین دور"
    pub max_iter: int = 1000
    @en "tol"
    @fa "رواداری"
    pub tol: f64 = 0.0001
    @en "coef"
    @fa "ضریب‌ها"
    pub coef: matrix.Matrix = matrix.Matrix {}
    @en "intercept"
    @fa "عرض از مبدأ"
    pub intercept: f64 = 0.0
    @en "n_iter"
    @fa "شمار تکرارها"
    pub n_iter: int = 0
    @en "ok"
    @fa "موفق"
    pub ok: bool = false


@en "LogisticRegression"
@fa "رگرسیون لجستیک"
pub struct LogisticRegression:
    @en "alpha"
    @fa "ضریب منظم‌سازی"
    pub alpha: f64 = 0.0001
    @en "fit_intercept"
    @fa "برازش عرض از مبدأ"
    pub fit_intercept: bool = true
    @en "max_iter"
    @fa "بیشترین دور"
    pub max_iter: int = 500
    @en "tol"
    @fa "رواداری"
    pub tol: f64 = 0.000001
    @en "coef"
    @fa "ضریب‌ها"
    pub coef: matrix.Matrix = matrix.Matrix {}
    @en "intercept"
    @fa "عرض از مبدأ"
    pub intercept: matrix.Matrix = matrix.Matrix {}
    @en "n_classes"
    @fa "شمار رده‌ها"
    pub n_classes: int = 0
    @en "n_iter"
    @fa "شمار تکرارها"
    pub n_iter: int = 0
    @en "ok"
    @fa "موفق"
    pub ok: bool = false



    pub func PredictProba(x &: matrix.Matrix): matrix.Matrix: ret this.predict_proba(x) end
    @en "predict_proba"
    pub func predict_proba(x &: matrix.Matrix): this.PredictProba(x) end





    @en "Free"
    @fa "آزادسازی"
    pub func Free():
        matrix.Free(this.coef)
        matrix.Free(this.intercept)
    end

    @en "free"
    @fa "آزادسازی"
    pub func free(): this.Free() end
end

func _centered(x &: matrix.Matrix, center: bool, mean_out &: matrix.Matrix): matrix.Matrix:
    mut r := matrix.Clone(x)
    if center == false: ret r end
    repeat x.cols in j:
        m := _col_mean(x, j)
        mean_out.Set(0, j, m)
        repeat x.rows in i: r.Set(i, j, x.at(i, j) - m) end
    end
    ret r
end

func _centered_col(y &: matrix.Matrix, center: bool, mean_out &: f64): matrix.Matrix:
    mut r := matrix.Clone(y)
    mean_out = 0.0
    if center == false: ret r end
    m := _col_mean(y, 0)
    mean_out = m
    repeat y.rows in i: r.Set(i, 0, y.at(i, 0) - m) end
    ret r
end

func _intercept_of(xm &: matrix.Matrix, ym: f64, w &: matrix.Matrix): f64:
    mut s := ym
    repeat w.rows in j: s -= xm.at(0, j) * w.at(j, 0) end
    ret s
end

func _linear_predict(x &: matrix.Matrix, w &: matrix.Matrix, b: f64): matrix.Matrix:
    mut p := matrix.MatMul(x, w)
    repeat p.rows in i: p.add_at(i, 0, b) end
    ret p
end

func _softmax_scores(x &: matrix.Matrix, w &: matrix.Matrix, b &: matrix.Matrix, out &: matrix.Matrix):
    mut z := matrix.MatMul(x, w)
    k := w.cols
    repeat x.rows in i:
        mut m := z.at(i, 0) + b.at(0, 0)
        repeat k in c:
            v := z.at(i, c) + b.at(0, c)
            if v > m: m = v end
        end
        mut s := 0.0
        repeat k in c:
            e := math.Exp(z.at(i, c) + b.at(0, c) - m)
            out.Set(i, c, e)
            s += e
        end
        repeat k in c: out.Set(i, c, out.at(i, c) / s) end
    end
    matrix.Free(z)
end

@en "NewElasticNet"
@fa "شبکه کشسان جدید"
pub func NewElasticNet(alpha: f64, l1_ratio: f64): Lasso:
    mut m := Lasso {}
    m.alpha = alpha
    m.l1_ratio = l1_ratio
    ret m
end
