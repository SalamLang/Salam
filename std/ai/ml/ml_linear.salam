package ml

import math
import matrix

@en "LinearReg"
@fa "رگرسیون خطی"
pub struct LinearReg:
    @en "fit_intercept"
    @fa "برازش عرض از مبدأ"
    pub fit_intercept: bool = true
    @en "coef"
    @fa "ضریب‌ها"
    pub coef: matrix.Matrix = matrix.Matrix {}
    @en "intercept"
    @fa "عرض از مبدأ"
    pub intercept: f64 = 0.0
    @en "ok"
    @fa "موفق"
    pub ok: bool = false

    pub func Fit(x &: matrix.Matrix, y &: matrix.Matrix): bool: ret this.fit(x, y) end
    @en "fit"
    pub func fit(x &: matrix.Matrix, y &: matrix.Matrix): this.Fit(x, y) end

    pub func Predict(x &: matrix.Matrix): matrix.Matrix: ret this.predict(x) end
    @en "predict"
    pub func predict(x &: matrix.Matrix): this.Predict(x) end

    pub func Score(x &: matrix.Matrix, y &: matrix.Matrix): f64: ret this.score(x, y) end
    @en "score"
    pub func score(x &: matrix.Matrix, y &: matrix.Matrix): this.Score(x, y) end

end

@en "Ridge"
