package ml

import math
import matrix

@en "TSNE"
@fa "تی‌اس‌ان‌ای"
pub struct TSNE:
    @en "n_components"
    @fa "شمار مؤلفه‌ها"
    pub n_components: int = 2
    @en "perplexity"
    @fa "سرگشتگی"
    pub perplexity: f64 = 30.0
    @en "learning_rate"
    @fa "نرخ یادگیری"
    pub learning_rate: f64 = 0.0
    @en "n_iter"
    @fa "شمار تکرارها"
    pub n_iter: int = 500
    @en "early_exaggeration"
    @fa "بزرگ‌نمایی آغازین"
    pub early_exaggeration: f64 = 12.0
    @en "seed"
    @fa "بذر"
    pub seed: i64 = 42
    @en "embedding"
    @fa "جاسازی"
    pub embedding: matrix.Matrix = matrix.Matrix {}
    @en "kl"
    @fa "واگرایی کی ال"
    pub kl: f64 = 0.0
    @en "ok"
    @fa "موفق"
    pub ok: bool = false

    pub func FitTransform(x &: matrix.Matrix): matrix.Matrix: ret this.fit_transform(x) end
    @en "fit_transform"
    pub func fit_transform(x &: matrix.Matrix): this.FitTransform(x) end

    @en "Free"
    @fa "آزادسازی"
    pub func Free(): this.embedding.Free() end
    @en "free"
    @fa "آزادسازی"
    pub func free(): this.Free() end
end

func _pairwise_sq(x &: matrix.Matrix): Vector<f64>:
    n := x.rows
    p := x.cols
    mut d := Vector {} as Vector<f64>
    repeat n * n: d.Push(0.0) end
    repeat n in i:
        repeat i in j:
            mut s := 0.0
            repeat p in k:
                t := x.at(i, k) - x.at(j, k)
                s += t * t
            end
            d.Set(i * n + j, s)
            d.Set(j * n + i, s)
        end
    end
    ret d
end

func _row_p(d &: Vector<f64>, n: int, i: int, beta: f64, p &: Vector<f64>): f64:
    mut sum := 0.0
    mut dsum := 0.0
    repeat n in j:
        if j == i:
            p.Set(i * n + j, 0.0)
            continue
        end
        v := math.Exp(0.0 - d.Get(i * n + j) * beta)
        p.Set(i * n + j, v)
        sum += v
        dsum += d.Get(i * n + j) * v
    end
    if sum <= 0.0: ret 0.0 end
    repeat n in j: p.Set(i * n + j, p.Get(i * n + j) / sum) end
    ret math.Log(sum) + beta * dsum / sum
end

func _joint_p(d &: Vector<f64>, n: int, perp: f64): Vector<f64>:
    target := math.Log(perp)
    mut p := Vector {} as Vector<f64>
    repeat n * n: p.Push(0.0) end
    repeat n in i:
        mut beta := 1.0
        mut lo := 0.0
        mut hi := 0.0
        mut has_hi := false
        repeat 50:
            h := _row_p(d, n, i, beta, p)
            diff := h - target
            if diff < 0.00001 and diff > 0.0 - 0.00001: continue end
            if diff > 0.0:
                lo = beta
                if has_hi: beta = (lo + hi) / 2.0 else:
                    beta *= 2.0
                end
            else:
                hi = beta
                has_hi = true
                beta = (lo + hi) / 2.0
            end
        end
    end
    mut total := 0.0
    repeat n in i:
        repeat i in j:
            v := (p.Get(i * n + j) + p.Get(j * n + i)) / 2.0
            p.Set(i * n + j, v)
            p.Set(j * n + i, v)
            total += 2.0 * v
        end
    end
    if total > 0.0:
        repeat n * n in k:
            mut v := p.Get(k) / total
            if v < 0.000000000001: v = 0.000000000001 end
            p.Set(k, v)
        end
    end
    repeat n in i: p.Set(i * n + i, 0.0) end
    ret p
end

func _student_num(y &: matrix.Matrix, num &: Vector<f64>): f64:
    n := y.rows
    m := y.cols
    mut total := 0.0
    repeat n in i:
        num.Set(i * n + i, 0.0)
        repeat i in j:
            mut s := 0.0
            repeat m in k:
                t := y.at(i, k) - y.at(j, k)
                s += t * t
            end
            v := 1.0 / (1.0 + s)
            num.Set(i * n + j, v)
            num.Set(j * n + i, v)
            total += 2.0 * v
        end
    end
    ret total
end

func _tsne_grad(y &: matrix.Matrix, p &: Vector<f64>, num &: Vector<f64>, sumq: f64, exag: f64, grad &: Vector<f64>):
    n := y.rows
    m := y.cols
    repeat n * m in k: grad.Set(k, 0.0) end
    repeat n in i:
        repeat n in j:
            if j == i: continue end
            nij := num.Get(i * n + j)
            q := nij / sumq
            mult := 4.0 * (exag * p.Get(i * n + j) - q) * nij
            repeat m in k:
                grad.Set(i * m + k, grad.Get(i * m + k) + mult * (y.at(i, k) - y.at(j, k)))
            end
        end
    end
end

func _center_rows(y &: matrix.Matrix):
    n := y.rows
    m := y.cols
    repeat m in k:
        mut s := 0.0
        repeat n in i: s += y.at(i, k) end
        mean := s / (n as f64)
        repeat n in i: y.Set(i, k, y.at(i, k) - mean) end
    end
end

func _kl(p &: Vector<f64>, num &: Vector<f64>, sumq: f64, n: int): f64:
    mut kl := 0.0
    repeat n in i:
        repeat n in j:
            if j == i: continue end
            pij := p.Get(i * n + j)
            mut q := num.Get(i * n + j) / sumq
            if q < 0.000000000001: q = 0.000000000001 end
            if pij > 0.0: kl += pij * math.Log(pij / q) end
        end
    end
    ret kl
end
