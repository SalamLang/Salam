package ml

import matrix
import sort

@en "KNNClassifier"
@fa "دسته‌بند نزدیک‌ترین همسایه"
pub struct KNNClassifier:
    @en "k"
    @fa "شمار همسایه‌ها"
    pub k: int = 5
    @en "weighted"
    @fa "وزن‌دار"
    pub weighted: bool = false
    @en "algorithm"
    @fa "الگوریتم"
    pub algorithm: int = KNN_BRUTE
    @en "leaf_size"
    @fa "اندازه برگ"
    pub leaf_size: int = 16
    @en "workers"
    @fa "شمار نخ‌ها"
    pub workers: int = 0
    @en "xtrain"
    @fa "ویژگی‌های آموزش"
    pub xtrain: matrix.Matrix = matrix.Matrix {}
    @en "ytrain"
    @fa "برچسب‌های آموزش"
    pub ytrain: matrix.Matrix = matrix.Matrix {}
    @en "tree"
    @fa "درخت"
    pub tree: KDTree = KDTree {}
    @en "n_classes"
    @fa "شمار رده‌ها"
    pub n_classes: int = 0
    @en "ok"
    @fa "موفق"
    pub ok: bool = false

    pub func Fit(x &: matrix.Matrix, y &: matrix.Matrix): bool: ret this.fit(x, y) end
    @en "fit"
    pub func fit(x &: matrix.Matrix, y &: matrix.Matrix): this.Fit(x, y) end

    pub func PredictProba(x &: matrix.Matrix): matrix.Matrix: ret this.predict_proba(x) end
    @en "predict_proba"
    pub func predict_proba(x &: matrix.Matrix): this.PredictProba(x) end

    pub func Predict(x &: matrix.Matrix): matrix.Matrix: ret this.predict(x) end
    @en "predict"
    pub func predict(x &: matrix.Matrix): this.Predict(x) end

    pub func Score(x &: matrix.Matrix, y &: matrix.Matrix): f64: ret this.score(x, y) end
    @en "score"
    pub func score(x &: matrix.Matrix, y &: matrix.Matrix): this.Score(x, y) end

end

@en "KNNRegressor"
@fa "رگرسور نزدیک‌ترین همسایه"
pub struct KNNRegressor:
    @en "k"
    @fa "شمار همسایه‌ها"
    pub k: int = 5
    @en "weighted"
    @fa "وزن‌دار"
    pub weighted: bool = false
    @en "algorithm"
    @fa "الگوریتم"
    pub algorithm: int = KNN_BRUTE
    @en "leaf_size"
    @fa "اندازه برگ"
    pub leaf_size: int = 16
    @en "workers"
    @fa "شمار نخ‌ها"
    pub workers: int = 0
    @en "xtrain"
    @fa "ویژگی‌های آموزش"
    pub xtrain: matrix.Matrix = matrix.Matrix {}
    @en "ytrain"
    @fa "برچسب‌های آموزش"
    pub ytrain: matrix.Matrix = matrix.Matrix {}
    @en "tree"
    @fa "درخت"
    pub tree: KDTree = KDTree {}
    @en "ok"
    @fa "موفق"
    pub ok: bool = false







    @en "Free"
    @fa "آزادسازی"
    pub func Free():
        matrix.Free(this.xtrain)
        matrix.Free(this.ytrain)
        this.tree.Free()
    end

    @en "free"
    @fa "آزادسازی"
    pub func free(): this.Free() end
end

func _nearest(xtrain &: matrix.Matrix, x &: matrix.Matrix, qi: int, k: int, dist_out &: Vector<f64>): Vector<int>:
    n := xtrain.rows
    p := xtrain.cols
    mut d := Vector {} as Vector<f64>
    repeat n in i:
        mut s := 0.0
        repeat p in j:
            t := x.at(qi, j) - xtrain.at(i, j)
            s += t * t
        end
        d.Push(s)
    end
    mut idx := Vector {} as Vector<int>
    repeat n in i: idx.Push(i) end
    sort.SortIndex(idx, d)
    mut out := Vector {} as Vector<int>
    dist_out.Clear()
    mut kk := k
    if kk > n: kk = n end
    repeat kk in i:
        out.Push(idx.Get(i))
        dist_out.Push(d.Get(idx.Get(i)))
    end
    d.Free()
    idx.Free()
    ret out
end
