@en "PolynomialFeatures"
@fa "ویژگی چندجمله‌ای"
pub struct PolynomialFeatures:
    @en "degree"
    @fa "درجه"
    pub degree: int = 2
    @en "include_bias"
    @fa "شامل سوگیری"
    pub include_bias: bool = false


func _col_mean(x &: matrix.Matrix, j: int): f64:
    mut s := 0.0
    repeat x.rows in i: s += x.at(i, j) end
    ret s / (x.rows as f64)
end

func _col_std(x &: matrix.Matrix, j: int, mean: f64): f64:
    mut s := 0.0
    repeat x.rows in i:
        d := x.at(i, j) - mean
        s += d * d
    end
    ret math.Sqrt(s / (x.rows as f64))
end

func _col_mean_nan(x &: matrix.Matrix, j: int): f64:
    mut s := 0.0
    mut c := 0
    repeat x.rows in i:
        v := x.at(i, j)
        if math.IsNaN(v) == false:
            s += v
            c++
        end
    end
    if c == 0: ret 0.0 end
    ret s / (c as f64)
end

func _col_median_nan(x &: matrix.Matrix, j: int): f64:
    mut vals := Vector {} as Vector<f64>
    repeat x.rows in i:
        v := x.at(i, j)
        if math.IsNaN(v) == false: vals.Push(v) end
    end
    n := vals.Len()
    if n == 0:
        vals.Free()
        ret 0.0
    end
    sort.Sort(vals)
    mut m := vals.Get(n / 2)
    if n % 2 == 0: m = (vals.Get(n / 2 - 1) + vals.Get(n / 2)) / 2.0 end
    vals.Free()
    ret m
end

func _poly_count(p: int, d: int): int:
    mut total := 0
    repeat d in kk:
        k := kk + 1
        mut c := 1
        repeat k in i:
            c = c * (p + i) / (i + 1)
        end
        total += c
    end
    ret total
end
