package ml

import math
import matrix
import sort
import str

@en "StandardScaler"
@fa "مقیاس‌گر استاندارد"
pub struct StandardScaler:
    @en "with_mean"
    @fa "با میانگین"
    pub with_mean: bool = true
    @en "with_std"
    @fa "با انحراف معیار"
    pub with_std: bool = true
    @en "mean"
    @fa "میانگین"
    pub mean: matrix.Matrix = matrix.Matrix {}
    @en "std"
    @fa "انحراف معیار"
    pub std: matrix.Matrix = matrix.Matrix {}
    @en "ok"
    @fa "موفق"
    pub ok: bool = false

    pub func Fit(x &: matrix.Matrix): bool: ret this.fit(x) end
    @en "fit"
    pub func fit(x &: matrix.Matrix): this.Fit(x) end

    pub func Transform(x &: matrix.Matrix): matrix.Matrix: ret this.transform(x) end
    @en "transform"
    pub func transform(x &: matrix.Matrix): this.Transform(x) end

    pub func FitTransform(x &: matrix.Matrix): matrix.Matrix: ret this.fit_transform(x) end
    @en "fit_transform"
    pub func fit_transform(x &: matrix.Matrix): this.FitTransform(x) end

    pub func InverseTransform(x &: matrix.Matrix): matrix.Matrix: ret this.inverse_transform(x) end
    @en "inverse_transform"
    pub func inverse_transform(x &: matrix.Matrix): this.InverseTransform(x) end

    @en "Free"
    @fa "آزادسازی"
    pub func Free():
        matrix.Free(this.mean)
        matrix.Free(this.std)
    end

    @en "free"
    @fa "آزادسازی"
    pub func free(): this.Free() end
end

