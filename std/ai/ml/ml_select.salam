package ml

import matrix
import pool

@en "Split"
@fa "تقسیم"
pub struct Split:
    @en "x_train"
    @fa "ویژگی‌های آموزش"
    pub x_train: matrix.Matrix = matrix.Matrix {}
    @en "x_test"
    @fa "ویژگی‌های آزمون"
    pub x_test: matrix.Matrix = matrix.Matrix {}
    @en "y_train"
    @fa "برچسب‌های آموزش"
    pub y_train: matrix.Matrix = matrix.Matrix {}
    @en "y_test"
    @fa "برچسب‌های آزمون"
    pub y_test: matrix.Matrix = matrix.Matrix {}

    @en "Free"
    @fa "آزادسازی"
    pub func Free():
        matrix.Free(this.x_train)
        matrix.Free(this.x_test)
        matrix.Free(this.y_train)
        matrix.Free(this.y_test)
    end

    @en "free"
    @fa "آزادسازی"
    pub func free(): this.Free() end
end

@en "Folds"
@fa "برش‌ها"
pub struct Folds:
    @en "train"
    @fa "آموزش"
    pub train: Vector<Vector<int>> = Vector {}
    @en "test"
    @fa "آزمون"
    pub test: Vector<Vector<int>> = Vector {}

    pub func Count(): int: ret this.count() end
    @en "count"
    pub func count(): this.Count() end


end

@en "GridResult"
@fa "نتیجه جستجوی شبکه‌ای"
pub struct GridResult:
    @en "scores"
    @fa "امتیازها"
    pub scores: Vector<f64> = Vector {}
    @en "best"
    @fa "بهترین"
    pub best: int = 0 - 1
    @en "best_score"
    @fa "بهترین امتیاز"
    pub best_score: f64 = 0.0

end

@en "Candidate"
@fa "نامزد"
pub struct Candidate:
    @en "name"
    @fa "نام"
    pub name: str = ""
    @en "fit"
    @fa "کارکرد برازش"
    pub fit: func (matrix.Matrix, matrix.Matrix, matrix.Matrix) matrix.Matrix = (_a: matrix.Matrix, _b: matrix.Matrix, _c: matrix.Matrix): ret matrix.Matrix {} end
end

func _permutation(n: int, seed: i64): Vector<int>:
    mut p := Vector {} as Vector<int>
    repeat n in i: p.Push(i) end
    mut g := matrix.NewRng(seed)
    mut i := n - 1
    until i > 0:
        j := (g.next_float() * ((i + 1) as f64)) as int
        t := p.Get(i)
        p.Set(i, p.Get(j))
        p.Set(j, t)
        i--
    end
    ret p
end

func _take_rows(x &: matrix.Matrix, idx &: Vector<int>): matrix.Matrix:
    mut r := matrix.Zeros(idx.Len(), x.cols)
    repeat idx.Len() in i:
        src := idx.Get(i)
        repeat x.cols in j: r.Set(i, j, x.at(src, j)) end
    end
    ret r
end

func _complete_folds(n: int, f &: Folds):
    repeat f.test.Len() in k:
        mut mask := Vector {} as Vector<bool>
        mask.zeros(n)
        tv := f.test.Get(k)
        repeat tv.Len() in i: mask.Set(tv.Get(i), true) end
        mut tr := Vector {} as Vector<int>
        repeat n in i:
            if mask.Get(i) == false: tr.Push(i) end
        end
        mask.Free()
        f.train.Push(tr)
    end
end

@en "TrainTestSplit"
@fa "تقسیم آموزش‌آزمون"
pub func TrainTestSplit(x &: matrix.Matrix, y &: matrix.Matrix, test_frac: f64, seed: i64): Split:
    mut s := Split {}
    n := x.rows
    if n == 0 or y.rows != n: ret s end
    mut ntest := (test_frac * (n as f64) + 0.5) as int
    if ntest < 1: ntest = 1 end
    if ntest >= n: ntest = n - 1 end
    mut perm := _permutation(n, seed)
    mut te := Vector {} as Vector<int>
    mut tr := Vector {} as Vector<int>
    repeat n in i:
        if i < ntest: te.Push(perm.Get(i))
        else:
            tr.Push(perm.Get(i))
        end
    end
    s.x_train = _take_rows(x, tr)
    s.y_train = _take_rows(y, tr)
    s.x_test = _take_rows(x, te)
    s.y_test = _take_rows(y, te)
    perm.Free()
    te.Free()
    tr.Free()
    ret s
end

@en "KFold"
@fa "کی برش"
pub func KFold(n: int, k: int, shuffle: bool, seed: i64): Folds:
    mut f := Folds {}
    if k < 2 or n < k: ret f end
    mut order := Vector {} as Vector<int>
    if shuffle:
        order = _permutation(n, seed)
    else:
        repeat n in i: order.Push(i) end
    end
    mut start := 0
    repeat k in fold:
        mut size := n / k
        if fold < n % k: size++ end
        mut te := Vector {} as Vector<int>
        repeat size in i: te.Push(order.Get(start + i)) end
        f.test.Push(te)
        start += size
    end
    order.Free()
    _complete_folds(n, f)
    ret f
end

@en "StratifiedKFold"
@fa "کی برش طبقه‌ای"
pub func StratifiedKFold(y &: matrix.Matrix, k: int, seed: i64): Folds:
    mut f := Folds {}
    n := y.rows
    if k < 2 or n < k: ret f end
    repeat k: f.test.Push(Vector {} as Vector<int>) end
    nc := CountClasses(y)
    mut perm := _permutation(n, seed)
    repeat nc in c:
        mut dealt := 0
        repeat n in i:
            row := perm.Get(i)
            if (y.at(row, 0) as int) == c:
                mut te := f.test.Get(dealt % k)
                te.Push(row)
                f.test.Set(dealt % k, te)
                dealt++
            end
        end
    end
    perm.Free()
    _complete_folds(n, f)
    ret f
end

@en "CrossValScore"
@fa "امتیاز اعتبارسنجی متقاطع"
pub func CrossValScore(fitpred: func (matrix.Matrix, matrix.Matrix, matrix.Matrix) matrix.Matrix, metric: func (matrix.Matrix, matrix.Matrix) f64, x &: matrix.Matrix, y &: matrix.Matrix, folds &: Folds): Vector<f64>:
    mut scores := Vector {} as Vector<f64>
    repeat folds.count() in k:
        mut tr := folds.train.Get(k)
        mut te := folds.test.Get(k)
        mut xtr := _take_rows(x, tr)
        mut ytr := _take_rows(y, tr)
        mut xte := _take_rows(x, te)
        mut yte := _take_rows(y, te)
        mut pred := fitpred(xtr, ytr, xte)
        mut sc := 0.0
        if pred.IsEmpty() == false: sc = metric(yte, pred) end
        scores.Push(sc)
        matrix.Free(xtr)
        matrix.Free(ytr)
        matrix.Free(xte)
        matrix.Free(yte)
        matrix.Free(pred)
    end
    ret scores
end

@en "MeanScore"
@fa "میانگین امتیاز"
pub func MeanScore(scores &: Vector<f64>): f64:
    if scores.Len() == 0: ret 0.0 end
    mut s := 0.0
    repeat scores.Len() in i: s += scores.Get(i) end
    ret s / (scores.Len() as f64)
end

@en "CrossValScoreParallel"
@fa "امتیاز اعتبارسنجی متقاطع موازی"
pub func CrossValScoreParallel(fitpred: func (matrix.Matrix, matrix.Matrix, matrix.Matrix) matrix.Matrix, metric: func (matrix.Matrix, matrix.Matrix) f64, x &: matrix.Matrix, y &: matrix.Matrix, folds &: Folds, workers: int): Vector<f64>:
    mut w := workers
    if w < 0: w = pool.CPUCount() as int end
    if w <= 1: ret CrossValScore(fitpred, metric, x, y, folds) end
    k := folds.count()
    mut scores := Vector {} as Vector<f64>
    repeat k: scores.Push(0.0) end
    mut xs := x
    mut ys := y
    fs := folds
    pool.ParallelFor(
        k as i64, w as i64, (i: i64): f := i as int mut tr := fs.train.Get(f) mut te := fs.test.Get(f) mut xtr := _take_rows(xs, tr) mut ytr := _take_rows(ys, tr) mut xte := _take_rows(xs, te) mut yte := _take_rows(ys, te) mut pred := fitpred(xtr, ytr, xte) mut sc := 0.0 if pred.IsEmpty() == false: sc = metric(yte, pred) end scores.Set(f, sc) matrix.Free(xtr) matrix.Free(ytr) matrix.Free(xte) matrix.Free(yte) matrix.Free(pred) end
    )
    ret scores
end

@en "GridSearch"
@fa "جستجوی شبکه‌ای"
pub func GridSearch(candidates &: Vector<Candidate>, metric: func (matrix.Matrix, matrix.Matrix) f64, x &: matrix.Matrix, y &: matrix.Matrix, folds &: Folds, workers: int): GridResult:
    mut r := GridResult {}
    n := candidates.Len()
    repeat n: r.scores.Push(0.0) end
    mut w := workers
    if w < 0: w = pool.CPUCount() as int end
    if w <= 1 or n <= 1:
        repeat n in c:
            mut sc := CrossValScore(candidates.Get(c).fit, metric, x, y, folds)
            r.scores.Set(c, MeanScore(sc))
            sc.Free()
        end
    else:
        mut xs := x
        mut ys := y
        mut fs := folds
        cs := candidates
        out := r.scores
        pool.ParallelFor(
            n as i64, w as i64, (i: i64): c := i as int mut sc := CrossValScore(cs.Get(c).fit, metric, xs, ys, fs) out.Set(c, MeanScore(sc)) sc.Free() end
        )
    end
    repeat n in c:
        if r.best < 0 or r.scores.Get(c) > r.best_score:
            r.best = c
            r.best_score = r.scores.Get(c)
        end
    end
    ret r
end
