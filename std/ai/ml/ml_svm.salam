package ml

import math
import matrix

@en "KERNEL_LINEAR"
@fa "هسته خطی"
pub const KERNEL_LINEAR := 0

@en "KERNEL_RBF"
@fa "هسته شعاعی"
pub const KERNEL_RBF := 1

@en "KERNEL_POLY"
@fa "هسته چندجمله‌ای"
pub const KERNEL_POLY := 2

@en "LinearSVM"
@fa "ماشین بردار پشتیبان خطی"
pub struct LinearSVM:
    @en "c"
    @fa "جریمه"
    pub c: f64 = 1.0
    @en "max_iter"
    @fa "بیشترین دور"
    pub max_iter: int = 1000
    @en "tol"
    @fa "رواداری"
    pub tol: f64 = 0.0001
    @en "seed"
    @fa "بذر"
    pub seed: i64 = 42
    @en "coef"
    @fa "ضریب‌ها"
    pub coef: matrix.Matrix = matrix.Matrix {}
    @en "intercept"
    @fa "عرض از مبدأ"
    pub intercept: matrix.Matrix = matrix.Matrix {}
    @en "n_classes"
    @fa "شمار رده‌ها"
    pub n_classes: int = 0
    @en "ok"
    @fa "موفق"
    pub ok: bool = false

    pub func Fit(x &: matrix.Matrix, y &: matrix.Matrix): bool: ret this.fit(x, y) end
    @en "fit"
    pub func fit(x &: matrix.Matrix, y &: matrix.Matrix): this.Fit(x, y) end

    pub func Decision(x &: matrix.Matrix): matrix.Matrix: ret this.decision(x) end
    @en "decision"
    pub func decision(x &: matrix.Matrix): this.Decision(x) end


@en "SVC"
@fa "دسته‌بند بردار پشتیبان"
pub struct SVC:
    @en "c"
    @fa "جریمه"
    pub c: f64 = 1.0
    @en "kernel"
    @fa "هسته"
    pub kernel: int = KERNEL_RBF
    @en "gamma"
    @fa "گاما"
    pub gamma: f64 = 0.0
    @en "degree"
    @fa "درجه"
    pub degree: int = 3
    @en "coef0"
    @fa "ضریب صفر"
    pub coef0: f64 = 1.0
    @en "max_passes"
    @fa "بیشترین دور"
    pub max_passes: int = 20
    @en "tol"
    @fa "رواداری"
    pub tol: f64 = 0.001
    @en "seed"
    @fa "بذر"
    pub seed: i64 = 42
    @en "support"
    @fa "بردارهای پشتیبان"
    pub support: matrix.Matrix = matrix.Matrix {}
    @en "dual"
    @fa "ضریب‌های دوگان"
    pub dual: matrix.Matrix = matrix.Matrix {}
    @en "bias"
    @fa "سوگیری"
    pub bias: matrix.Matrix = matrix.Matrix {}
    @en "n_classes"
    @fa "شمار رده‌ها"
    pub n_classes: int = 0
    @en "ok"
    @fa "موفق"
    pub ok: bool = false





    @en "Predict"
    @fa "پیش‌بینی"
    pub func Predict(x &: matrix.Matrix): matrix.Matrix:
        mut d := this.Decision(x)
        if d.IsEmpty(): ret d end
        mut out := matrix.Zeros(x.rows, 1)
        repeat x.rows in i:
            if this.n_classes == 2:
                if d.at(i, 0) > 0.0: out.Set(i, 0, 1.0) end
            else:
                mut best := 0
                repeat d.cols in c:
                    if d.at(i, c) > d.at(i, best): best = c end
                end
                out.Set(i, 0, best as f64)
            end
        end
        matrix.Free(d)
        ret out
    end

    @en "predict"
    @fa "پیش‌بینی"
    pub func predict(x &: matrix.Matrix): matrix.Matrix: ret this.Predict(x) end

    @en "NSupport"
    @fa "شمار بردار پشتیبان"
    pub func NSupport(): int:
        mut cnt := 0
        repeat this.dual.rows in s:
            mut any := false
            repeat this.dual.cols in c:
                if this.dual.at(s, c) != 0.0: any = true end
            end
            if any: cnt++ end
        end
        ret cnt
    end

    @en "n_support"
    @fa "شمار بردار پشتیبان"
    pub func n_support(): int: ret this.NSupport() end

    @en "Score"
    @fa "امتیاز"
    pub func Score(x &: matrix.Matrix, y &: matrix.Matrix): f64:
        mut p := this.Predict(x)
        if p.IsEmpty(): ret 0.0 end
        r := Accuracy(y, p)
        matrix.Free(p)
        ret r
    end

    @en "score"
    @fa "امتیاز"
    pub func score(x &: matrix.Matrix, y &: matrix.Matrix): f64: ret this.Score(x, y) end

    @en "Free"
    @fa "آزادسازی"
    pub func Free():
        matrix.Free(this.support)
        matrix.Free(this.dual)
        matrix.Free(this.bias)
    end

    @en "free"
    @fa "آزادسازی"
    pub func free(): this.Free() end
end
    @en "predict"
    @fa "پیش‌بینی"
    pub func predict(x &: matrix.Matrix): this.Predict(x) end

func _kernel(a &: matrix.Matrix, i: int, b &: matrix.Matrix, j: int, kind: int, gamma: f64, degree: int, coef0: f64): f64:
    mut dot := 0.0
    mut sq := 0.0
    repeat a.cols in t:
        u := a.at(i, t)
        v := b.at(j, t)
        dot += u * v
        d := u - v
        sq += d * d
    end
    if kind == KERNEL_RBF: ret math.Exp(0.0 - gamma * sq) end
    if kind == KERNEL_POLY: ret math.Pow(gamma * dot + coef0, degree as f64) end
    ret dot
end

func _dual_cd(x &: matrix.Matrix, y &: matrix.Matrix, target: int, c: f64, max_iter: int, tol: f64, seed: i64, w &: matrix.Matrix):
    n := x.rows
    p := x.cols
    mut alpha := Vector {} as Vector<f64>
    alpha.zeros(n)
    mut q := Vector {} as Vector<f64>
    repeat n in i:
        mut s := 1.0
        repeat p in j: s += x.at(i, j) * x.at(i, j) end
        q.Push(s)
    end
    mut lab := Vector {} as Vector<f64>
    repeat n in i:
        if (y.at(i, 0) as int) == target: lab.Push(1.0) else:
            lab.Push(0.0 - 1.0)
        end
    end
    mut order := Vector {} as Vector<int>
    repeat n in i: order.Push(i) end
    mut g := matrix.NewRng(seed)
    mut it := 0
    mut done := false
    until it < max_iter and done == false:
        mut k := n - 1
        until k > 0:
            r := (g.next_float() * ((k + 1) as f64)) as int
            t := order.Get(k)
            order.Set(k, order.Get(r))
            order.Set(r, t)
            k--
        end
        mut max_change := 0.0
        repeat n in oi:
            i := order.Get(oi)
            yi := lab.Get(i)
            mut margin := w.at(p, 0)
            repeat p in j: margin += w.at(j, 0) * x.at(i, j) end
            grad := yi * margin - 1.0
            a := alpha.Get(i)
            mut pg := grad
            if a == 0.0 and grad > 0.0: pg = 0.0 end
            if a == c and grad < 0.0: pg = 0.0 end
            if pg != 0.0:
                mut na := a - grad / q.Get(i)
                if na < 0.0: na = 0.0 end
                if na > c: na = c end
                d := (na - a) * yi
                if d != 0.0:
                    repeat p in j: w.add_at(j, 0, d * x.at(i, j)) end
                    w.add_at(p, 0, d)
                    alpha.Set(i, na)
                end
                mut ad := na - a
                if ad < 0.0: ad = 0.0 - ad end
                if ad > max_change: max_change = ad end
            end
        end
        it++
        if max_change < tol: done = true end
    end
    alpha.Free()
    q.Free()
    lab.Free()
    order.Free()
end

func _smo(km &: matrix.Matrix, yv &: Vector<f64>, c: f64, tol: f64, max_passes: int, seed: i64, alpha &: Vector<f64>, b &: f64):
    n := km.rows
    mut g := matrix.NewRng(seed)
    mut passes := 0
    mut total_iter := 0
    until passes < max_passes and total_iter < 200:
        mut changed := 0
        repeat n in i:
            ei := _smo_f(km, yv, alpha, b, i) - yv.Get(i)
            ai := alpha.Get(i)
            yi := yv.Get(i)
            if (yi * ei < 0.0 - tol and ai < c) or (yi * ei > tol and ai > 0.0):
                mut j := (g.next_float() * (n as f64)) as int
                if j == i: j = (j + 1) % n end
                ej := _smo_f(km, yv, alpha, b, j) - yv.Get(j)
                aj := alpha.Get(j)
                yj := yv.Get(j)
                mut lo := 0.0
                mut hi := c
                if yi != yj:
                    lo = aj - ai
                    if lo < 0.0: lo = 0.0 end
                    hi = c + aj - ai
                    if hi > c: hi = c end
                else:
                    lo = ai + aj - c
                    if lo < 0.0: lo = 0.0 end
                    hi = ai + aj
                    if hi > c: hi = c end
                end
                if lo < hi:
                    eta := 2.0 * km.at(i, j) - km.at(i, i) - km.at(j, j)
                    if eta < 0.0:
                        mut naj := aj - yj * (ei - ej) / eta
                        if naj > hi: naj = hi end
                        if naj < lo: naj = lo end
                        mut daj := naj - aj
                        if daj < 0.0: daj = 0.0 - daj end
                        if daj > 1.0e-6:
                            nai := ai + yi * yj * (aj - naj)
                            b1 := b - ei - yi * (nai - ai) * km.at(i, i) - yj * (naj - aj) * km.at(i, j)
                            b2 := b - ej - yi * (nai - ai) * km.at(i, j) - yj * (naj - aj) * km.at(j, j)
                            if nai > 0.0 and nai < c: b = b1
                            else naj > 0.0 and naj < c: b = b2
                            else:
                                b = (b1 + b2) / 2.0
                            end
                            alpha.Set(i, nai)
                            alpha.Set(j, naj)
                            changed++
                        end
                    end
                end
            end
        end
        if changed == 0: passes++ else:
            passes = 0
        end
        total_iter++
    end
end

func _smo_f(km &: matrix.Matrix, yv &: Vector<f64>, alpha &: Vector<f64>, b: f64, i: int): f64:
    mut s := b
    repeat km.rows in t:
        a := alpha.Get(t)
        if a != 0.0: s += a * yv.Get(t) * km.at(t, i) end
    end
    ret s
end
