package ml

import math
import matrix
import sort

struct _TreeFrame:
    pub node: int = 0
    pub lo: int = 0
    pub hi: int = 0
    pub depth: int = 0
end

@en "DecisionTree"
@fa "درخت تصمیم"
pub struct DecisionTree:
    @en "criterion"
    @fa "معیار"
    pub criterion: int = TREE_GINI
    @en "max_depth"
    @fa "بیشترین عمق"
    pub max_depth: int = 16
    @en "min_samples_split"
    @fa "کمترین نمونه شکاف"
    pub min_samples_split: int = 2
    @en "min_samples_leaf"
    @fa "کمترین نمونه برگ"
    pub min_samples_leaf: int = 1
    @en "max_features"
    @fa "بیشترین ویژگی"
    pub max_features: int = 0
    @en "seed"
    @fa "بذر"
    pub seed: i64 = 42
    @en "n_classes_hint"
    @fa "شمار رده‌ی پیشنهادی"
    pub n_classes_hint: int = 0
    @en "feature"
    @fa "ویژگی"
    pub feature: Vector<int> = Vector {}
    @en "threshold"
    @fa "آستانه"
    pub threshold: Vector<f64> = Vector {}
    @en "left"
    @fa "چپ"
    pub left: Vector<int> = Vector {}
    @en "right"
    @fa "راست"
    pub right: Vector<int> = Vector {}
    @en "value"
    @fa "مقدار"
    pub value: matrix.Matrix = matrix.Matrix {}
    @en "n_classes"
    @fa "شمار رده‌ها"
    pub n_classes: int = 0
    @en "ok"
    @fa "موفق"
    pub ok: bool = false

    pub func IsRegression(): bool: ret this.is_regression() end
    @en "is_regression"
    pub func is_regression(): this.IsRegression() end

    pub func NodeCount(): int: ret this.node_count() end
    @en "node_count"
    pub func node_count(): this.NodeCount() end

    pub func Fit(x &: matrix.Matrix, y &: matrix.Matrix): bool: ret this.fit(x, y) end
    @en "fit"
    pub func fit(x &: matrix.Matrix, y &: matrix.Matrix): this.Fit(x, y) end

    @en "ApplyRow"
    @fa "اعمال سطر"
    pub func ApplyRow(x &: matrix.Matrix, i: int): int:
        mut node := 0
        until this.feature.Get(node) >= 0:
            if x.at(i, this.feature.Get(node)) <= this.threshold.Get(node):
                node = this.left.Get(node)
            else:
                node = this.right.Get(node)
            end
        end
        ret node
    end
    pub func ApplyRow(x &: matrix.Matrix, i: int): int: ret this.apply_row(x, i) end

    @en "PredictProba"
    @fa "پیش‌بینی احتمال"
    pub func PredictProba(x &: matrix.Matrix): matrix.Matrix:
        if this.ok == false or this.is_regression(): ret matrix.Matrix {} end
        mut out := matrix.Zeros(x.rows, this.n_classes)
        repeat x.rows in i:
            node := this.apply_row(x, i)
            mut total := 0.0
            repeat this.n_classes in c: total += this.value.at(node, c) end
            if total > 0.0:
                repeat this.n_classes in c: out.Set(i, c, this.value.at(node, c) / total) end
            end
        end
        ret out
    end

    @en "predict_proba"
    @fa "پیش‌بینی احتمال"
    pub func predict_proba(x &: matrix.Matrix): matrix.Matrix: ret this.PredictProba(x) end

    @en "predict"
    @fa "پیش‌بینی"
    @en "Predict"
    @fa "پیش‌بینی"
    pub func Predict(x &: matrix.Matrix): matrix.Matrix:
        if this.ok == false: ret matrix.Matrix {} end
        mut out := matrix.Zeros(x.rows, 1)
        repeat x.rows in i:
            node := this.apply_row(x, i)
            if this.is_regression():
                out.Set(i, 0, this.value.at(node, 0))
            else:
                mut best := 0
                repeat this.n_classes in c:
                    if this.value.at(node, c) > this.value.at(node, best): best = c end
                end
                out.Set(i, 0, best as f64)
            end
        end
        ret out
    end

    @en "predict"
    @fa "پیش‌بینی"
    pub func predict(x &: matrix.Matrix): matrix.Matrix: ret this.Predict(x) end

    @en "Score"
    @fa "امتیاز"
    pub func Score(x &: matrix.Matrix, y &: matrix.Matrix): f64:
        mut p := this.Predict(x)
        if p.IsEmpty(): ret 0.0 end
        mut r := 0.0
        if this.is_regression(): r = R2Score(y, p)
        else:
            r = Accuracy(y, p)
        end
        matrix.Free(p)
        ret r
    end

    @en "score"
    @fa "امتیاز"
    pub func score(x &: matrix.Matrix, y &: matrix.Matrix): f64: ret this.Score(x, y) end

    @en "Free"
    @fa "آزادسازی"
    pub func Free():
        this.feature.Free()
        this.threshold.Free()
        this.left.Free()
        this.right.Free()
        matrix.Free(this.value)
    end

    @en "free"
    @fa "آزادسازی"
    pub func free(): this.Free() end
end

func _impurity(counts &: Vector<f64>, total: f64, criterion: int): f64:
    if total <= 0.0: ret 0.0 end
    mut s := 0.0
    repeat counts.Len() in c:
        p := counts.Get(c) / total
        if p > 0.0:
            if criterion == TREE_ENTROPY:
                s -= p * math.Log(p)
            else:
                s += p * (1.0 - p)
            end
        end
    end
    ret s
end

func _node_value(x_rows &: Vector<int>, y &: matrix.Matrix, lo: int, hi: int, k: int, regression: bool, values &: Vector<f64>):
    if regression:
        mut s := 0.0
        repeat hi - lo in t: s += y.at(x_rows.Get(lo + t), 0) end
        values.Push(s / ((hi - lo) as f64))
        ret
    end
    mut counts := Vector {} as Vector<f64>
    counts.zeros(k)
    repeat hi - lo in t:
        c := y.at(x_rows.Get(lo + t), 0) as int
        counts.Set(c, counts.Get(c) + 1.0)
    end
    repeat k in c: values.Push(counts.Get(c)) end
    counts.Free()
end

func _best_split(tree &: DecisionTree, x &: matrix.Matrix, y &: matrix.Matrix, rows &: Vector<int>, lo: int, hi: int, k: int, feats &: Vector<int>, best_f &: int, best_t &: f64): f64:
    n := hi - lo
    regression := tree.is_regression()
    nf := n as f64
    mut parent := 0.0
    mut total_counts := Vector {} as Vector<f64>
    mut ysum := 0.0
    mut ysq := 0.0
    if regression:
        repeat n in t:
            v := y.at(rows.Get(lo + t), 0)
            ysum += v
            ysq += v * v
        end
        parent = ysq / nf - (ysum / nf) * (ysum / nf)
    else:
        total_counts.zeros(k)
        repeat n in t:
            c := y.at(rows.Get(lo + t), 0) as int
            total_counts.Set(c, total_counts.Get(c) + 1.0)
        end
        parent = _impurity(total_counts, nf, tree.criterion)
    end
    mut best_gain := 0.0
    best_f = 0 - 1
    best_t = 0.0
    mut order := Vector {} as Vector<int>
    repeat n in t: order.Push(rows.Get(lo + t)) end
    mut keys := Vector {} as Vector<f64>
    keys.zeros(n)
    mut lcounts := Vector {} as Vector<f64>
    if regression == false: lcounts.zeros(k) end
    min_leaf := tree.min_samples_leaf
    repeat feats.Len() in fi:
        f := feats.Get(fi)
        repeat n in t: keys.Set(t, x.at(order.Get(t), f)) end
        mut idx := Vector {} as Vector<int>
        repeat n in t: idx.Push(t) end
        sort.SortIndex(idx, keys)
        if regression == false:
            repeat k in c: lcounts.Set(c, 0.0) end
        end
        mut lsum := 0.0
        mut lsq := 0.0
        repeat n - 1 in t:
            r := order.Get(idx.Get(t))
            if regression:
                v := y.at(r, 0)
                lsum += v
                lsq += v * v
            else:
                c := y.at(r, 0) as int
                lcounts.Set(c, lcounts.Get(c) + 1.0)
            end
            nl := t + 1
            nr := n - nl
            if nl < min_leaf or nr < min_leaf: continue end
            kv := keys.Get(idx.Get(t))
            kn := keys.Get(idx.Get(t + 1))
            if kv == kn: continue end
            nlf := nl as f64
            nrf := nr as f64
            mut child := 0.0
            if regression:
                rsum := ysum - lsum
                rsq := ysq - lsq
                lvar := lsq / nlf - (lsum / nlf) * (lsum / nlf)
                rvar := rsq / nrf - (rsum / nrf) * (rsum / nrf)
                child = (nlf * lvar + nrf * rvar) / nf
            else:
                mut rcounts := Vector {} as Vector<f64>
                repeat k in c: rcounts.Push(total_counts.Get(c) - lcounts.Get(c)) end
                child = (nlf * _impurity(lcounts, nlf, tree.criterion) + nrf * _impurity(rcounts, nrf, tree.criterion)) / nf
                rcounts.Free()
            end
            gain := parent - child
            if gain > best_gain + 1.0e-12:
                best_gain = gain
                best_f = f
                best_t = (kv + kn) / 2.0
            end
        end
        idx.Free()
    end
    order.Free()
    keys.Free()
    lcounts.Free()
    total_counts.Free()
    ret best_gain
end

func _partition(x &: matrix.Matrix, rows &: Vector<int>, lo: int, hi: int, f: int, t: f64): int:
    mut i := lo
    mut j := hi - 1
    until i <= j:
        if x.at(rows.Get(i), f) <= t:
            i++
        else:
            tmp := rows.Get(i)
            rows.Set(i, rows.Get(j))
            rows.Set(j, tmp)
            j--
        end
    end
    ret i
end

func _grow_tree(tree &: DecisionTree, x &: matrix.Matrix, y &: matrix.Matrix, k: int, values &: Vector<f64>):
    n := x.rows
    p := x.cols
    regression := tree.is_regression()
    mut rows := Vector {} as Vector<int>
    repeat n in i: rows.Push(i) end
    mut g := matrix.NewRng(tree.seed)
    tree.feature.Push(0 - 1)
    tree.threshold.Push(0.0)
    tree.left.Push(0 - 1)
    tree.right.Push(0 - 1)
    _node_value(rows, y, 0, n, k, regression, values)
    mut stack := Vector {} as Vector<_TreeFrame>
    stack.Push(_TreeFrame { node = 0, lo = 0, hi = n, depth = 0 })
    mut feats := Vector {} as Vector<int>
    until stack.Len() > 0:
        fr := stack.Pop()
        cnt := fr.hi - fr.lo
        if fr.depth >= tree.max_depth or cnt < tree.min_samples_split or cnt < 2 * tree.min_samples_leaf: continue end
        feats.Clear()
        if tree.max_features > 0 and tree.max_features < p:
            mut pool := Vector {} as Vector<int>
            repeat p in j: pool.Push(j) end
            repeat tree.max_features in t:
                pick := t + ((g.next_float() * ((p - t) as f64)) as int)
                tmp := pool.Get(t)
                pool.Set(t, pool.Get(pick))
                pool.Set(pick, tmp)
                feats.Push(pool.Get(t))
            end
            pool.Free()
        else:
            repeat p in j: feats.Push(j) end
        end
        mut bf := 0 - 1
        mut bt := 0.0
        gain := _best_split(tree, x, y, rows, fr.lo, fr.hi, k, feats, bf, bt)
        if bf < 0 or gain <= 0.0: continue end
        mid := _partition(x, rows, fr.lo, fr.hi, bf, bt)
        if mid == fr.lo or mid == fr.hi: continue end
        lid := tree.feature.Len()
        tree.feature.Push(0 - 1)
        tree.threshold.Push(0.0)
        tree.left.Push(0 - 1)
        tree.right.Push(0 - 1)
        _node_value(rows, y, fr.lo, mid, k, regression, values)
        rid := tree.feature.Len()
        tree.feature.Push(0 - 1)
        tree.threshold.Push(0.0)
        tree.left.Push(0 - 1)
        tree.right.Push(0 - 1)
        _node_value(rows, y, mid, fr.hi, k, regression, values)
        tree.feature.Set(fr.node, bf)
        tree.threshold.Set(fr.node, bt)
        tree.left.Set(fr.node, lid)
        tree.right.Set(fr.node, rid)
        stack.Push(_TreeFrame { node = lid, lo = fr.lo, hi = mid, depth = fr.depth + 1 })
        stack.Push(_TreeFrame { node = rid, lo = mid, hi = fr.hi, depth = fr.depth + 1 })
    end
    feats.Free()
    stack.Free()
    rows.Free()
end
    @en "apply_row"
    @fa "اعمال سطر"
    pub func apply_row(x &: matrix.Matrix, i: int): this.ApplyRow(x, i) end
