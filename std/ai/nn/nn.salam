@en "nn"
@fa "شبکه عصبی"
package nn

import ai.autograd
import mem
import str
import ai.tensor

@en "Parameter"
@fa "پارامتر"
pub struct Parameter:
    @en "name"
    @fa "نام"
    pub name: str = ""
    @en "value"
    @fa "مقدار"
    pub value: tensor.Tensor = tensor.Tensor {}
    @en "grad"
    @fa "گرادیان"
    pub grad: tensor.Tensor = tensor.Tensor {}
end

@en "ParamStore"
@fa "مخزن پارامتر"
pub struct ParamStore:
    @en "items"
    @fa "پارامترها"
    pub items: Vector<Parameter> = Vector {}

    @en "add"
    @fa "افزودن"
    pub func add(name: str, t: tensor.Tensor): int:
        mut p := Parameter {}
        p.name = str.Clone(name)
        p.value = t
        p.grad = tensor.Zeros(t.shape)
        id := this.items.Len()
        this.items.Push(p)
        ret id
    end
    pub func Add(name: str, t: tensor.Tensor): int: ret this.Add(name, t) end

    @en "count"
    @fa "شمار"
    pub func count(): int: ret this.items.Len() end
    pub func Count(): int: ret this.count() end

    @en "at"
    @fa "عنصر"
    pub func at(h: int): Parameter: ret this.items.Get(h) end
    pub func At(h: int): Parameter: ret this.at(h) end

    @en "zero_grad"
    @fa "صفر کردن گرادیان"
    pub func zero_grad():
        repeat this.items.Len() in i:
            mut p := this.items.Get(i)
            tensor.SetAll(p.grad, 0.0)
        end
    end
    pub func ZeroGrad(): this.zero_grad() end

    @en "free"
    @fa "آزادسازی"
    pub func free():
        repeat this.items.Len() in i:
            mut p := this.items.Get(i)
            p.value.Free()
            p.grad.Free()
            mem.Free(p.name as void*)
        end
        this.items.Free()
    end
    pub func Free(): this.Free() end
end

@en "Bind"
@fa "پیوند"
pub func Bind(tp &: autograd.Tape, ps &: ParamStore, h: int): int:
    mut p := ps.items.Get(h)
    ret autograd.Param(tp, p.value, p.grad)
end
