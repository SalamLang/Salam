package nn

import ai.autograd

@en "Dropout"
@fa "حذف تصادفی"
pub struct Dropout:
    @en "p"
    @fa "احتمال حذف"
    pub p: f64 = 0.1

    @en "forward"
    @fa "پیشرو"
    pub func forward(tp &: autograd.Tape, x: int): int:
        ret autograd.Dropout(tp, x, this.p)
    end
    pub func Forward(tp &: autograd.Tape, x: int): int: ret this.Forward(tp, x) end
end
