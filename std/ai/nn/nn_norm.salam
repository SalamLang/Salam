package nn

import ai.autograd
import mem
import ai.tensor

@en "LayerNorm"
@fa "نرمال‌سازی لایه"
pub struct LayerNorm:
    @en "gamma"
    @fa "شماره گاما"
    pub gamma: int = 0 - 1
    @en "beta"
    @fa "شماره بتا"
    pub beta: int = 0 - 1
    @en "eps"
    @fa "اپسیلون"
    pub eps: f64 = 0.00001

    pub func Forward(tp &: autograd.Tape, ps &: ParamStore, x: int): int: ret this.forward(tp, ps, x) end
    @en "forward"
    pub func forward(tp &: autograd.Tape, ps &: ParamStore, x: int): this.Forward(tp, ps, x) end
end

@en "BatchNorm"
@fa "نرمال‌سازی دسته"
pub struct BatchNorm:
    @en "gamma"
    @fa "شماره گاما"
    pub gamma: int = 0 - 1
    @en "beta"
    @fa "شماره بتا"
    pub beta: int = 0 - 1
    @en "running_mean"
    @fa "میانگین جاری"
    pub running_mean: tensor.Tensor = tensor.Tensor {}
    @en "running_var"
    @fa "واریانس جاری"
    pub running_var: tensor.Tensor = tensor.Tensor {}
    @en "momentum"
    @fa "تکانه"
    pub momentum: f64 = 0.1
    @en "eps"
    @fa "اپسیلون"
    pub eps: f64 = 0.00001



    @en "Free"
    @fa "آزادسازی"
    pub func Free():
        this.running_mean.Free()
        this.running_var.Free()
    end
    @en "free"
    @fa "آزادسازی"
    pub func free(): this.Free() end
end

@en "GroupNorm"
@fa "نرمال‌سازی گروهی"
pub struct GroupNorm:
    @en "gamma"
    @fa "شماره گاما"
    pub gamma: int = 0 - 1
    @en "beta"
    @fa "شماره بتا"
    pub beta: int = 0 - 1
    @en "groups"
    @fa "گروه‌ها"
    pub groups: int = 1
    @en "eps"
    @fa "اپسیلون"
    pub eps: f64 = 0.00001


end

@en "RMSNorm"
@fa "نرمال‌سازی جذر میانگین مربعات"
pub struct RMSNorm:
    @en "gamma"
    @fa "شماره گاما"
    pub gamma: int = 0 - 1
    @en "eps"
    @fa "اپسیلون"
    pub eps: f64 = 0.00001


end

@en "NewLayerNorm"
@fa "نرمال‌سازی لایه جدید"
pub func NewLayerNorm(ps &: ParamStore, name: str, dim: int): LayerNorm:
    mut l := LayerNorm {}
    mut g := tensor.Zeros1(dim)
    tensor.SetAll(g, 1.0)
    _pn1 := name + ".gamma"
    l.gamma = ps.Add(_pn1, g)
    mem.Free(_pn1 as void*)
    b := tensor.Zeros1(dim)
    _pn2 := name + ".beta"
    l.beta = ps.Add(_pn2, b)
    mem.Free(_pn2 as void*)
    ret l
end

@en "NewBatchNorm"
@fa "نرمال‌سازی دسته جدید"
pub func NewBatchNorm(ps &: ParamStore, name: str, channels: int): BatchNorm:
    mut l := BatchNorm {}
    mut g := tensor.Zeros1(channels)
    tensor.SetAll(g, 1.0)
    _pn3 := name + ".gamma"
    l.gamma = ps.Add(_pn3, g)
    mem.Free(_pn3 as void*)
    b := tensor.Zeros1(channels)
    _pn4 := name + ".beta"
    l.beta = ps.Add(_pn4, b)
    mem.Free(_pn4 as void*)
    l.running_mean = tensor.Zeros1(channels)
    mut v := tensor.Zeros1(channels)
    tensor.SetAll(v, 1.0)
    l.running_var = v
    ret l
end

@en "NewGroupNorm"
@fa "نرمال‌سازی گروهی جدید"
pub func NewGroupNorm(ps &: ParamStore, name: str, channels: int, groups: int): GroupNorm:
    mut l := GroupNorm {}
    l.groups = groups
    mut g := tensor.Zeros1(channels)
    tensor.SetAll(g, 1.0)
    _pn5 := name + ".gamma"
    l.gamma = ps.Add(_pn5, g)
    mem.Free(_pn5 as void*)
    b := tensor.Zeros1(channels)
    _pn6 := name + ".beta"
    l.beta = ps.Add(_pn6, b)
    mem.Free(_pn6 as void*)
    ret l
end

@en "NewRMSNorm"
@fa "نرمال‌سازی جذر میانگین مربعات جدید"
pub func NewRMSNorm(ps &: ParamStore, name: str, dim: int): RMSNorm:
    mut l := RMSNorm {}
    mut g := tensor.Zeros1(dim)
    tensor.SetAll(g, 1.0)
    _pn7 := name + ".gamma"
    l.gamma = ps.Add(_pn7, g)
    mem.Free(_pn7 as void*)
    ret l
end
