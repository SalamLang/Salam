package nn

import ai.autograd
import mem
import ai.tensor

@en "LSTM"
@fa "حافظه کوتاه‌مدت بلند"
pub struct LSTM:
    @en "wx"
    @fa "وزن‌ورودی"
    pub wx: Linear = Linear {}
    @en "wh"
    @fa "وزن حالت"
    pub wh: Linear = Linear {}
    @en "hidden"
    @fa "اندازه حالت"
    pub hidden: int = 0

    pub func Forward(tp &: autograd.Tape, ps &: ParamStore, x: int, seq: int, batch: int): int: ret this.forward(tp, ps, x, seq, batch) end
    @en "forward"
    pub func forward(tp &: autograd.Tape, ps &: ParamStore, x: int, seq: int, batch: int): this.Forward(tp, ps, x, seq, batch) end
end

@en "GRU"
@fa "واحد بازگشتی دروازه‌دار"
pub struct GRU:
    @en "wx"
    @fa "وزن‌ورودی"
    pub wx: Linear = Linear {}
    @en "wh"
    @fa "وزن حالت"
    pub wh: Linear = Linear {}
    @en "hidden"
    @fa "اندازه حالت"
    pub hidden: int = 0


end

@en "NewLSTM"
@fa "حافظه کوتاه‌مدت بلند جدید"
pub func NewLSTM(ps &: ParamStore, name: str, in_f: int, hidden: int, g &: tensor.Rng): LSTM:
    mut l := LSTM {}
    l.hidden = hidden
    _pn1 := name + ".x"
    l.wx = NewLinear(ps, _pn1, in_f, 4 * hidden, g)
    mem.Free(_pn1 as void*)
    _pn2 := name + ".h"
    l.wh = NewLinearNoBias(ps, _pn2, hidden, 4 * hidden, g)
    mem.Free(_pn2 as void*)
    ret l
end

@en "NewGRU"
@fa "واحد بازگشتی دروازه‌دار جدید"
pub func NewGRU(ps &: ParamStore, name: str, in_f: int, hidden: int, g &: tensor.Rng): GRU:
    mut l := GRU {}
    l.hidden = hidden
    _pn3 := name + ".x"
    l.wx = NewLinear(ps, _pn3, in_f, 3 * hidden, g)
    mem.Free(_pn3 as void*)
    _pn4 := name + ".h"
    l.wh = NewLinear(ps, _pn4, hidden, 3 * hidden, g)
    mem.Free(_pn4 as void*)
    ret l
end

@en "LastStep"
@fa "گام آخر"
pub func LastStep(tp &: autograd.Tape, out: int, seq: int, batch: int): int:
    ret autograd.SliceAxis0(tp, out, (seq - 1) * batch, batch)
end
