package nn

import ai.autograd

@en "Layer"
@fa "لایه"
pub interface Layer:
    @en "Forward"
    @fa "پیشرو"
    func Forward(tp &: autograd.Tape, ps &: ParamStore, x: int): int

    @en "forward"
    @fa "پیشرو"
    func forward(tp &: autograd.Tape, ps &: ParamStore, x: int): int
end

@en "ReluLayer"
@fa "لایه یکسوساز"
pub struct ReluLayer:
    @en "unused"
    @fa "بی‌کاربرد"
    pub unused: int = 0

    pub func Forward(tp &: autograd.Tape, _ps &: ParamStore, x: int): int: ret this.forward(tp, _ps, x) end
    @en "forward"
    pub func forward(tp &: autograd.Tape, _ps &: ParamStore, x: int): this.Forward(tp, _ps, x) end
end

@en "GeluLayer"
@fa "لایه گلو"
pub struct GeluLayer:
    @en "unused"
    @fa "بی‌کاربرد"
    pub unused: int = 0


end

@en "TanhLayer"
@fa "لایه تانژانت هذلولی"
pub struct TanhLayer:
    @en "unused"
    @fa "بی‌کاربرد"
    pub unused: int = 0


end

@en "Sequential"
@fa "ترتیبی"
pub struct Sequential:
    @en "layers"
    @fa "لایه‌ها"
    pub layers: Vector<dyn Layer> = Vector {}

    @en "Add"
    @fa "افزودن"
    pub func Add(l: dyn Layer): this.layers.Push(l) end
    @en "add"
    @fa "افزودن"
    pub func add(l: dyn Layer): this.Add(l) end



    @en "Free"
    @fa "آزادسازی"
    pub func Free(): this.layers.Free() end
    @en "free"
    @fa "آزادسازی"
    pub func free(): this.Free() end
end
