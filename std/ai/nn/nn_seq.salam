package nn

import ai.autograd

@en "Layer"
@fa "لایه"
pub interface Layer:
    @en "Forward"
    @fa "پیشرو"
    func Forward(tp &: autograd.Tape, ps &: ParamStore, x: int): int

end

@en "ReluLayer"
@fa "لایه یکسوساز"
pub struct ReluLayer:
    @en "unused"
    @fa "بی‌کاربرد"
    pub unused: int = 0

    @en "Forward"
    @fa "پیشرو"
    pub func Forward(tp &: autograd.Tape, _ps &: ParamStore, x: int): int:
        ret autograd.Relu(tp, x)
    end
end

@en "GeluLayer"
@fa "لایه گلو"
pub struct GeluLayer:
    @en "unused"
    @fa "بی‌کاربرد"
    pub unused: int = 0

    @en "Forward"
    @fa "پیشرو"
    pub func Forward(tp &: autograd.Tape, _ps &: ParamStore, x: int): int:
        ret autograd.Gelu(tp, x)
    end

end

@en "TanhLayer"
@fa "لایه تانژانت هذلولی"
pub struct TanhLayer:
    @en "unused"
    @fa "بی‌کاربرد"
    pub unused: int = 0

    @en "Forward"
    @fa "پیشرو"
    pub func Forward(tp &: autograd.Tape, _ps &: ParamStore, x: int): int:
        ret autograd.Tanh(tp, x)
    end

end

@en "Sequential"
@fa "ترتیبی"
pub struct Sequential:
    @en "layers"
    @fa "لایه‌ها"
    pub layers: Vector<dyn Layer> = Vector {}

    @en "Add"
    @fa "افزودن"
    pub func Add(l: dyn Layer): this.layers.Push(l) end

    @en "Forward"
    @fa "پیشرو"
    pub func Forward(tp &: autograd.Tape, ps &: ParamStore, x: int): int:
        mut h := x
        repeat this.layers.Len() in i:
            l := this.layers.Get(i)
            h = l.Forward(tp, ps, h)
        end
        ret h
    end

    @en "Free"
    @fa "آزادسازی" "آزاد"
    pub func Free(): this.layers.Free() end
end
