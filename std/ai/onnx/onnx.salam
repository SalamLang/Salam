@en "onnx"
@fa "اونیکس"
package onnx

import archive
import compress
import mem
import str
import ai.tensor

@en "Attr"
@fa "ویژگی"
pub struct Attr:
    @en "name"
    @fa "نام"
    pub name: str = ""
    @en "kind"
    @fa "گونه"
    pub kind: int = 0
    @en "f"
    @fa "مقدار اعشاری"
    pub f: f64 = 0.0
    @en "i"
    @fa "مقدار صحیح"
    pub i: i64 = 0
    @en "s"
    @fa "مقدار رشته"
    pub s: str = ""
    @en "t"
    @fa "مقدار تانسور"
    pub t: tensor.Tensor = tensor.Tensor {}
    @en "floats"
    @fa "فهرست اعشاری"
    pub floats: Vector<f64> = Vector {}
    @en "ints"
    @fa "فهرست صحیح"
    pub ints: Vector<i64> = Vector {}

    @en "Free"
    @fa "آزادسازی"
    pub func Free():
        this.t.Free()
        this.floats.Free()
        this.ints.Free()
        _free_wire_str(this.name)
        _free_wire_str(this.s)
    end

    @en "free"
    @fa "آزادسازی"
    pub func free():
        this.Free()
    end
end

@en "Node"
@fa "گره"
pub struct Node:
    @en "op"
    @fa "عملگر"
    pub op: str = ""
    @en "name"
    @fa "نام"
    pub name: str = ""
    @en "inputs"
    @fa "ورودی‌ها"
    pub inputs: Vector<str> = Vector {}
    @en "outputs"
    @fa "خروجی‌ها"
    pub outputs: Vector<str> = Vector {}
    @en "attrs"
    @fa "ویژگی‌ها"
    pub attrs: Vector<Attr> = Vector {}

    @en "AttrIndex"
    @fa "نمایه ویژگی"
    pub func AttrIndex(name: str): int:
        repeat this.attrs.Len() in i:
            a := this.attrs.Get(i)
            if str.Equals(a.name, name): ret i end
        end
        ret 0 - 1
    end

    @en "attr_index"
    @fa "نمایه ویژگی"
    pub func attr_index(name: str): int:
        ret this.AttrIndex(name)
    end

    @en "AttrInt"
    @fa "ویژگی صحیح"
    pub func AttrInt(name: str, dflt: i64): i64:
        k := this.AttrIndex(name)
        if k < 0: ret dflt end
        ret this.attrs.Get(k).i
    end

    @en "attr_int"
    @fa "ویژگی صحیح"
    pub func attr_int(name: str, dflt: i64): i64:
        ret this.AttrInt(name, dflt)
    end

    @en "AttrFloat"
    @fa "ویژگی اعشاری"
    pub func AttrFloat(name: str, dflt: f64): f64:
        k := this.AttrIndex(name)
        if k < 0: ret dflt end
        ret this.attrs.Get(k).f
    end

    @en "attr_float"
    @fa "ویژگی اعشاری"
    pub func attr_float(name: str, dflt: f64): f64:
        ret this.AttrFloat(name, dflt)
    end

    @en "Free"
    @fa "آزادسازی"
    pub func Free():
        _free_wire_strs(this.inputs)
        _free_wire_strs(this.outputs)
        _free_wire_str(this.op)
        _free_wire_str(this.name)
        repeat this.attrs.Len() in i:
            mut a := this.attrs.Get(i)
            a.Free()
        end
        this.attrs.Free()
    end

    @en "free"
    @fa "آزادسازی"
    pub func free():
        this.Free()
    end
end

@en "Model"
@fa "مدل"
pub struct Model:
    @en "inputs"
    @fa "ورودی‌ها"
    pub inputs: Vector<str> = Vector {}
    @en "outputs"
    @fa "خروجی‌ها"
    pub outputs: Vector<str> = Vector {}
    @en "nodes"
    @fa "گره‌ها"
    pub nodes: Vector<Node> = Vector {}
    @en "init_names"
    @fa "نام وزن‌های ثابت"
    pub init_names: Vector<str> = Vector {}
    @en "inits"
    @fa "وزن‌های ثابت"
    pub inits: Vector<tensor.Tensor> = Vector {}
    @en "ir_version"
    @fa "نسخه آی آر"
    pub ir_version: i64 = 0
    @en "error"
    @fa "خطا"
    pub error: str = ""
    @en "ok"
    @fa "موفق"
    pub ok: bool = false

    @en "FeedNames"
    @fa "نام ورودی‌ها"
    pub func FeedNames(): Vector<str>:
        mut out := Vector {} as Vector<str>
        repeat this.inputs.Len() in i:
            nm := this.inputs.Get(i)
            mut is_init := false
            repeat this.init_names.Len() in j:
                if str.Equals(this.init_names.Get(j), nm): is_init = true end
            end
            if is_init == false: out.Push(nm) end
        end
        ret out
    end

    @en "feed_names"
    @fa "نام ورودی‌ها"
    pub func feed_names(): Vector<str>:
        ret this.FeedNames()
    end

    @en "Free"
    @fa "آزادسازی"
    pub func Free():
        _free_wire_str(this.error)
        _free_wire_strs(this.inputs)
        _free_wire_strs(this.outputs)
        repeat this.nodes.Len() in i:
            mut n := this.nodes.Get(i)
            n.Free()
        end
        this.nodes.Free()
        _free_wire_strs(this.init_names)
        repeat this.inits.Len() in i:
            mut t := this.inits.Get(i)
            t.Free()
        end
        this.inits.Free()
    end

    @en "free"
    @fa "آزادسازی"
    pub func free():
        this.Free()
    end
end

func _free_wire_str(s: str):
    if str.Len(s) > 0: mem.Free(s as void*) end
end

func _free_wire_strs(v &: Vector<str>):
    repeat v.Len() in i: _free_wire_str(v.Get(i)) end
    v.Free()
end

@en "ParseOnnx"
@fa "تجزیه اونیکس"
pub func ParseOnnx(p: void*, n: int, ok &: bool): Model:
    mut m := Model {}
    ok = true
    try:
        _decode_model(p, n, m)
    catch e:
        ok = false
        m.error = str.Clone(e.ToStr())
    end
    m.ok = ok
    ret m
end

@en "LoadOnnx"
@fa "بارگذاری اونیکس"
pub func LoadOnnx(path: str, ok &: bool): Model:
    ok = false
    mut fok := false
    mut raw := archive.ReadBinaryFile(path, fok)
    if fok == false:
        compress.BufFree(raw)
        mut m := Model {}
        m.error = "cannot read " + path
        ret m
    end
    m := ParseOnnx(raw.data, compress.BufLen(raw), ok)
    compress.BufFree(raw)
    ret m
end

@en "Run"
@fa "اجرا"
pub func Run(model &: Model, inputs &: Vector<tensor.Tensor>, ok &: bool): Vector<tensor.Tensor>:
    ret _run_graph(model, inputs, ok)
end
