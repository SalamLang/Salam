package opencv

import mem

@en "Contours"
@fa "پیرامون‌ها"
pub struct Contours:
    @en "handle"
    @fa "دسته"
    pub handle: void* = null

    @en "Ok"
    @fa "معتبر"
    pub func Ok(): bool: ret this.handle != null end
    @en "ok"
    @fa "معتبر"
    pub func ok(): this.Ok() end


    @en "Count"
    @fa "تعداد"
    pub func Count(): int:
        if this.handle == null: ret 0 end
        ret scv_contour_count(this.handle)
    end
    @en "count"
    @fa "تعداد"
    pub func count(): this.Count() end


    @en "PointCount"
    @fa "تعداد نقطه"
    pub func PointCount(idx: int): int:
        if this.handle == null: ret 0 end
        ret scv_contour_point_count(this.handle, idx)
    end
    @en "point_count"
    @fa "تعداد نقطه"
    pub func point_count(idx: int): this.PointCount(idx) end


    @en "Point"
    @fa "نقطه"
    pub func Point(idx: int, pt_idx: int): Point:
        if this.handle == null: ret Point {} end
        buf := mem.Allocate(8 as u64)
        defer mem.Free(buf)
        p := buf as i32*
        scv_contour_point_get(this.handle, idx, pt_idx, p)
        ret Point { x = p[0], y = p[1] }
    end
    @en "point"
    @fa "نقطه"
    pub func point(idx: int, pt_idx: int): this.Point(idx, pt_idx) end


    @en "Area"
    @fa "مساحت"
    pub func Area(idx: int): f64:
        if this.handle == null: ret 0.0 end
        ret scv_contour_area(this.handle, idx)
    end
    @en "area"
    @fa "مساحت"
    pub func area(idx: int): this.Area(idx) end


    @en "BoundingRect"
    @fa "مستطیل محاط"
    pub func BoundingRect(idx: int): Rect:
        if this.handle == null: ret Rect {} end
        buf := mem.Allocate(16 as u64)
        defer mem.Free(buf)
        p := buf as i32*
        scv_contour_bounding_rect(this.handle, idx, p)
        ret Rect { x = p[0], y = p[1], width = p[2], height = p[3] }
    end
    @en "bounding_rect"
    @fa "مستطیل محاط"
    pub func bounding_rect(idx: int): this.BoundingRect(idx) end


    @en "Free"
    @fa "آزادسازی"
    pub func Free():
        if this.handle != null: scv_free_contours(this.handle) end
        this.handle = null
    end

    @en "free"
    @fa "آزادسازی"
    pub func free(): this.Free() end
end
