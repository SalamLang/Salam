    @en "WarpPerspective"
    @fa "تاب دیدگاهی"
    pub func WarpPerspective(src: Vector<Point>, out_width: int, out_height: int): Mat:
        if this.handle == null or src.Len() != 4: ret Mat { handle = null } end
        src_buf := mem.Allocate(64 as u64)
        dst_buf := mem.Allocate(64 as u64)
        defer mem.Free(src_buf)
        defer mem.Free(dst_buf)
        sp := src_buf as f64*
        dp := dst_buf as f64*
        mut i := 0
        until i < 4:
            p := src.Get(i)
            sp[i * 2] = p.x as f64
            sp[i * 2 + 1] = p.y as f64
            i++
        end
        dp[0] = 0.0
        dp[1] = 0.0
        dp[2] = (out_width - 1) as f64
        dp[3] = 0.0
        dp[4] = (out_width - 1) as f64
        dp[5] = (out_height - 1) as f64
        dp[6] = 0.0
        dp[7] = (out_height - 1) as f64
        ret Mat { handle = scv_warp_perspective_quad(this.handle, sp, dp, out_width, out_height) }
    end

    @en "warp_perspective"
    @fa "تاب دیدگاهی"
    pub func warp_perspective(src: Vector<Point>, out_width: int, out_height: int): Mat: ret this.WarpPerspective(src, out_width, out_height) end

    @en "FindTemplate"
    @fa "یافتن الگو"
    pub func FindTemplate(template: Mat): TemplateMatch:
        if this.handle == null or template.handle == null:
            ret TemplateMatch { found = false }
        end
        xbuf := mem.Allocate(4 as u64)
        ybuf := mem.Allocate(4 as u64)
        sbuf := mem.Allocate(8 as u64)
        defer mem.Free(xbuf)
        defer mem.Free(ybuf)
        defer mem.Free(sbuf)
        xp := xbuf as i32*
        yp := ybuf as i32*
        sp := sbuf as f64*
        ok := scv_match_template(this.handle, template.handle, xp, yp, sp)
        if ok == 0: ret TemplateMatch { found = false } end
        ret TemplateMatch { found = true, x = xp[0], y = yp[0], score = sp[0] }
    end

    @en "find_template"
    @fa "یافتن الگو"
    pub func find_template(template: Mat): TemplateMatch: ret this.FindTemplate(template) end

