    @en "GoodFeatures"
    @fa "ویژگی‌های خوب"
    pub func GoodFeatures(max_corners: int, quality: f64, min_dist: f64): Vector<Point>:
        mut out := Vector {} as Vector<Point>
        if this.handle == null or max_corners <= 0: ret out end
        xbuf := mem.Allocate((max_corners * 4) as u64)
        ybuf := mem.Allocate((max_corners * 4) as u64)
        defer mem.Free(xbuf)
        defer mem.Free(ybuf)
        xp := xbuf as i32*
        yp := ybuf as i32*
        n := scv_good_features(this.handle, max_corners, quality, min_dist, xp, yp)
        mut i := 0
        until i < n:
            out.Push(Point { x = xp[i], y = yp[i] })
            i++
        end
        ret out
    end

    @en "good_features"
    @fa "ویژگی‌های خوب"
    pub func good_features(max_corners: int, quality: f64, min_dist: f64): Vector<Point>: ret this.GoodFeatures(max_corners, quality, min_dist) end

