    @en "HistogramGray"
    @fa "هیستوگرام خاکستری"
    pub func HistogramGray(): Vector<int>:
        mut out := Vector {} as Vector<int>
        if this.handle == null: ret out end
        buf := mem.AllocateZeroed((256 * 4) as u64)
        defer mem.Free(buf)
        p := buf as i32*
        scv_hist_gray(this.handle, p)
        mut i := 0
        until i < 256:
            out.Push(p[i])
            i++
        end
        ret out
    end

    @en "histogram_gray"
    @fa "هیستوگرام خاکستری"
    pub func histogram_gray(): Vector<int>: ret this.HistogramGray() end

