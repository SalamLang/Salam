    @en "Polylines"
    @fa "چندخطی"
    pub func Polylines(pts: Vector<Point>, closed: bool, color: Color, thickness: int):
        if this.handle == null or pts.Len() < 2: ret end
        buf := mem.Allocate((pts.Len() * 8) as u64)
        defer mem.Free(buf)
        p := buf as i32*
        mut i := 0
        until i < pts.Len():
            pt := pts.Get(i)
            p[i * 2] = pt.x
            p[i * 2 + 1] = pt.y
            i++
        end
        mut cf := 0
        if closed: cf = 1 end
        scv_polylines(this.handle, p, pts.Len(), cf, color.r, color.g, color.b, thickness)
    end

    @en "polylines"
    @fa "چندخطی"
    pub func polylines(pts: Vector<Point>, closed: bool, color: Color, thickness: int): this.Polylines(pts, closed, color, thickness) end

    @en "FillPoly"
    @fa "پر کردن چندضلعی"
    pub func FillPoly(pts: Vector<Point>, color: Color):
        if this.handle == null or pts.Len() < 3: ret end
        buf := mem.Allocate((pts.Len() * 8) as u64)
        defer mem.Free(buf)
        p := buf as i32*
        mut i := 0
        until i < pts.Len():
            pt := pts.Get(i)
            p[i * 2] = pt.x
            p[i * 2 + 1] = pt.y
            i++
        end
        scv_fill_poly(this.handle, p, pts.Len(), color.r, color.g, color.b)
    end

    @en "fill_poly"
    @fa "پر کردن چندضلعی"
    pub func fill_poly(pts: Vector<Point>, color: Color): this.FillPoly(pts, color) end

    @en "FindContours"
    @fa "یافتن پیرامون‌ها"
    pub func FindContours(): Contours:
        if this.handle == null: ret Contours { handle = null } end
        ret Contours { handle = scv_find_contours(this.handle) }
    end

    @en "find_contours"
    @fa "یافتن پیرامون‌ها"
    pub func find_contours(): Contours: ret this.FindContours() end

    @en "DrawContour"
    @fa "رسم پیرامون"
    pub func DrawContour(cs: Contours, idx: int, color: Color, thickness: int):
        if this.handle == null or cs.handle == null: ret end
        scv_draw_contour(this.handle, cs.handle, idx, color.r, color.g, color.b, thickness)
    end

    @en "draw_contour"
    @fa "رسم پیرامون"
    pub func draw_contour(cs: Contours, idx: int, color: Color, thickness: int): this.DrawContour(cs, idx, color, thickness) end
end

@en "TemplateMatch"
@fa "تطابق الگو"
pub struct TemplateMatch:
    @en "found"
    @fa "پیدا شد"
    pub found: bool = false
    @en "x"
    @fa "افقی"
    pub x: int = 0
    @en "y"
    @fa "عمودی"
    pub y: int = 0
    @en "score"
    @fa "امتیاز"
    pub score: f64 = 0.0
end

@en "Size"
@fa "اندازه"
pub struct Size:
    @en "width"
    @fa "عرض"
    pub width: int = 0
    @en "height"
    @fa "ارتفاع"
    pub height: int = 0
end

@en "Point"
