package opencv

import mem
import collections

@en "Mat"
@fa "ماتریس"
pub struct Mat:
    @en "handle"
    @fa "دسته"
    pub handle: void* = null

    @en "Ok"
    @fa "معتبر"
    pub func Ok(): bool: ret this.handle != null end

    @en "ok"
    @fa "معتبر"
    pub func ok(): bool: ret this.Ok() end

    @en "Empty"
    @fa "خالی"
    pub func Empty(): bool:
        if this.handle == null: ret true end
        ret scv_empty(this.handle) != 0
    end

    @en "empty"
    @fa "خالی"
    pub func empty(): bool: ret this.Empty() end

    @en "Width"
    @fa "عرض"
    pub func Width(): int:
        if this.handle == null: ret 0 end
        ret scv_width(this.handle)
    end

    @en "width"
    @fa "عرض"
    pub func width(): int: ret this.Width() end

    @en "Height"
    @fa "ارتفاع"
    pub func Height(): int:
        if this.handle == null: ret 0 end
        ret scv_height(this.handle)
    end

    @en "height"
    @fa "ارتفاع"
    pub func height(): int: ret this.Height() end

    @en "Channels"
    @fa "کانال‌ها"
    pub func Channels(): int:
        if this.handle == null: ret 0 end
        ret scv_channels(this.handle)
    end

    @en "channels"
    @fa "کانال‌ها"
    pub func channels(): int: ret this.Channels() end

    @en "size"
    @fa "اندازه"
    pub func size(): Size: ret Size { width = this.width(), height = this.height() } end

    @en "Size"
    @fa "اندازه"
    pub func Size(): Size: ret this.size() end
    @en "Clone"
    @fa "کپی"
    pub func Clone(): Mat:
        if this.handle == null: ret Mat { handle = null } end
        ret Mat { handle = scv_clone(this.handle) }
    end

    @en "clone"
    @fa "کپی"
    pub func clone(): Mat: ret this.Clone() end

    @en "Free"
    @fa "آزادسازی"
    pub func Free():
        if this.handle != null:
            scv_free(this.handle)
        end
        this.handle = null
    end

    @en "free"
    @fa "آزادسازی"
    pub func free(): this.Free() end

    @en "Save"
    @fa "ذخیره"
    pub func Save(path: str): bool:
        if this.handle == null: ret false end
        ret scv_write(path, this.handle) != 0
    end

    @en "save"
    @fa "ذخیره"
    pub func save(path: str): bool: ret this.Save(path) end

    @en "Data"
    @fa "داده"
    pub func Data(): void*:
        if this.handle == null: ret null end
        ret scv_data(this.handle)
    end

    @en "data"
    @fa "داده"
    pub func data(): this.Data() end

    @en "Step"
    @fa "گام"
    pub func Step(): int:
        if this.handle == null: ret 0 end
        ret scv_step(this.handle)
    end

    @en "step"
    @fa "گام"
    pub func step(): int: ret this.Step() end

    @en "Total"
    @fa "مجموع"
    pub func Total(): int:
        if this.handle == null: ret 0 end
        ret scv_mat_total(this.handle)
    end

    @en "total"
    @fa "مجموع"
    pub func total(): int: ret this.Total() end

    @en "At"
    @fa "عنصر"
    pub func At(x: int, y: int): Color:
        if this.handle == null: ret Color { r = 0, g = 0, b = 0 } end
        buf := mem.Allocate(12 as u64)
        defer mem.Free(buf)
        p := buf as i32*
        if scv_get_pixel(this.handle, x, y, p) == 0:
            ret Color { r = 0, g = 0, b = 0 }
        end
        ret Color { r = p[0], g = p[1], b = p[2] }
    end

    @en "at"
    @fa "عنصر"
    pub func at(x: int, y: int): Color: ret this.At(x, y) end

    @en "SetPixel"
    @fa "تنظیم پیکسل"
    pub func SetPixel(x: int, y: int, c: Color):
        if this.handle == null: ret end
        scv_set_pixel(this.handle, x, y, c.r, c.g, c.b)
    end

    @en "set_pixel"
    @fa "تنظیم پیکسل"
    pub func set_pixel(x: int, y: int, c: Color): this.SetPixel(x, y, c) end

    @en "ConvertColor"
    @fa "تبدیل رنگ"
    pub func ConvertColor(code: int): Mat:
        if this.handle == null: ret Mat { handle = null } end
        ret Mat { handle = scv_cvt_color(this.handle, code) }
    end

    @en "convert_color"
    @fa "تبدیل رنگ"
    pub func convert_color(code: int): Mat: ret this.ConvertColor(code) end

    @en "ToGray"
    @fa "به خاکستری"
    pub func ToGray(): Mat:
        if this.handle == null: ret Mat { handle = null } end
        if this.channels() == 1: ret this.Clone() end
        ret this.convert_color(COLOR_BGR2GRAY)
    end

    @en "to_gray"
    @fa "به خاکستری"
    pub func to_gray(): Mat: ret this.ToGray() end

    @en "ToRgb"
    @fa "به آر‌جی‌بی"
    pub func ToRgb(): Mat:
        if this.handle == null: ret Mat { handle = null } end
        if this.channels() != 1: ret this.Clone() end
        ret this.convert_color(COLOR_GRAY2BGR)
    end

    @en "to_rgb"
    @fa "به آر‌جی‌بی"
    pub func to_rgb(): Mat: ret this.ToRgb() end

    @en "ToHsv"
