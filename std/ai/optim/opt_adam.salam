package optim

import ai.nn
import ai.tensor

extern:
    pure func sqrtf(x: f32): f32
end

@en "Adam"
@fa "آدام"
pub struct Adam:
    @en "lr"
    @fa "نرخ یادگیری"
    pub lr: f64 = 0.001
    @en "beta1"
    @fa "بتای یک"
    pub beta1: f64 = 0.9
    @en "beta2"
    @fa "بتای دو"
    pub beta2: f64 = 0.999
    @en "eps"
    @fa "اپسیلون"
    pub eps: f64 = 0.00000001
    @en "weight_decay"
    @fa "کاهش وزن"
    pub weight_decay: f64 = 0.0
    @en "decoupled"
    @fa "کاهش وزن جدا"
    pub decoupled: bool = false
    t: i64 = 0
    m: Vector<tensor.Tensor> = Vector {}
    v: Vector<tensor.Tensor> = Vector {}


    @en "Free"
    @fa "آزادسازی"
    pub func Free():
        _free_state(this.m)
        _free_state(this.v)
    end

    @en "free"
    @fa "آزادسازی"
    pub func free(): this.Free() end
end

@en "RMSProp"
@fa "آر ام اس پراپ"
pub struct RMSProp:
    @en "lr"
    @fa "نرخ یادگیری"
    pub lr: f64 = 0.01
    @en "alpha"
    @fa "ضریب میانگین"
    pub alpha: f64 = 0.99
    @en "eps"
    @fa "اپسیلون"
    pub eps: f64 = 0.00000001
    @en "weight_decay"
    @fa "کاهش وزن"
    pub weight_decay: f64 = 0.0
    sq: Vector<tensor.Tensor> = Vector {}

    @en "Step"
    @fa "گام"
    pub func Step(ps &: nn.ParamStore):
        _ensure_state(this.sq, ps)
        lr := this.lr as f32
        al := this.alpha as f32
        one := 1.0 as f32
        ef := this.eps as f32
        wd := this.weight_decay as f32
        zero := 0.0 as f32
        repeat ps.count() in pi:
            mut p := ps.items.Get(pi)
            n := p.value.numel()
            pw := p.value.data.data
            pg := p.grad.data.data
            st := this.sq.Get(pi)
            pv := st.data.data
            repeat n in k:
                mut g := pg[k]
                if wd != zero: g += wd * pw[k] end
                nv := al * pv[k] + (one - al) * g * g
                pv[k] = nv
                pw[k] = pw[k] - lr * g / (sqrtf(nv) + ef)
            end
        end
    end

    @en "step"
    @fa "گام"
    pub func step(ps &: nn.ParamStore): this.Step(ps) end

end

@en "NewAdamW"
@fa "آدام دابلیو جدید"
pub func NewAdamW(lr: f64, weight_decay: f64): Adam:
    mut a := Adam {}
    a.lr = lr
    a.weight_decay = weight_decay
    a.decoupled = true
    ret a
end
