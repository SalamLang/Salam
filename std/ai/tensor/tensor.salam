@en "tensor"
@fa "تانسور"
package tensor

import matrix

extern:
    pure func expf(x: f32): f32
    pure func logf(x: f32): f32
    pure func tanhf(x: f32): f32
    pure func powf(x: f32, y: f32): f32
    pure func sqrtf(x: f32): f32
    pure func fabsf(x: f32): f32
end

@en "TSR_TOL"
@fa "رواداری تانسور"
pub const TSR_TOL := 1.0e-5

@en "Tensor"
@fa "تانسور"
pub struct Tensor:
    @en "data"
    @fa "درایه‌ها"
    pub data: Vector<f32> = Vector {}
    @en "shape"
    @fa "شکل"
    pub shape: Vector<int> = Vector {}

    pub func Rank(): int: ret this.rank() end
    @en "rank"
    pub func rank(): this.Rank() end

    pub func Numel(): int: ret this.numel() end
    @en "numel"
    pub func numel(): this.Numel() end

    pub func Dim(i: int): int: ret this.dim(i) end
    @en "dim"
    pub func dim(i: int): this.Dim(i) end


    @en "IsEmpty"
    @fa "خالی است"
    pub func IsEmpty(): bool: ret this.is_empty() end
    @en "is_empty"
    @fa "خالی است"
    pub func is_empty(): this.IsEmpty() end
    @en "SameShape"
    @fa "هم‌شکل"
    pub func SameShape(o &: Tensor): bool:
        r := this.shape.Len()
        if r != o.shape.Len(): ret false end
        repeat r in i:
            if this.shape.Get(i) != o.shape.Get(i): ret false end
        end
        ret true
    end
    @en "same_shape"
    @fa "هم‌شکل"
    pub func same_shape(o &: Tensor): this.SameShape(o) end


    pub func At(i: int): f64: ret this.at(i) end
    @en "at"
    pub func at(i: int): this.At(i) end

    @en "SetAt"
    @fa "تنظیم در"
    pub func SetAt(i: int, v: f64): this.data.Set(i, v as f32) end
    @en "set_at"
    @fa "تنظیم در"
    pub func set_at(i: int, v: f64): this.SetAt(i, v) end

    @en "AddAt"
    @fa "افزودن در"
    pub func AddAt(i: int, v: f64):
        this.data.Set(i, this.data.Get(i) + (v as f32))
    end
    @en "add_at"
    @fa "افزودن در"
    pub func add_at(i: int, v: f64): this.AddAt(i, v) end

    pub func At2(i: int, j: int): f64: ret this.at2(i, j) end
    @en "at2"
    pub func at2(i: int, j: int): this.At2(i, j) end

    @en "SetAt2"
    @fa "تنظیم در دو"
    pub func SetAt2(i: int, j: int, v: f64):
        this.data.Set(i * this.shape.Get(1) + j, v as f32)
    end
    @en "set_at2"
    @fa "تنظیم در دو"
    pub func set_at2(i: int, j: int, v: f64): this.SetAt2(i, j, v) end

    pub func Reshape(shape &: Vector<int>): bool: ret this.reshape_(shape) end
    @en "reshape_"
    pub func reshape_(shape &: Vector<int>): this.Reshape(shape) end

    @en "operator +"
    @fa "عملگر جمع"
    pub func + (other: Tensor): Tensor:
        mut me := Tensor {}
        me.data = this.data
        me.shape = this.shape
        mut o := other
        ret Add(me, o)
    end

    @en "operator -"
    @fa "عملگر تفریق"
    pub func -(other: Tensor): Tensor:
        mut me := Tensor {}
        me.data = this.data
        me.shape = this.shape
        mut o := other
        ret Sub(me, o)
    end

    @en "operator *"
    @fa "عملگر ضرب"
    pub func *(other: Tensor): Tensor:
        mut me := Tensor {}
        me.data = this.data
        me.shape = this.shape
        mut o := other
        ret Mul(me, o)
    end

    @en "operator /"
    @fa "عملگر تقسیم"
    pub func / (other: Tensor): Tensor:
        mut me := Tensor {}
        me.data = this.data
        me.shape = this.shape
        mut o := other
        ret Div(me, o)
    end

    @en "Free"
    @fa "آزادسازی"
    pub func Free():
        this.data.Free()
        this.shape.Free()
    end

    @en "free"
    @fa "آزادسازی"
    pub func free(): this.Free() end
end

func _copy_shape(shape &: Vector<int>): Vector<int>:
    mut s := Vector {} as Vector<int>
    n := shape.Len()
    if n > 0:
        s.Alloc(n)
        repeat n in i: s.Set(i, shape.Get(i)) end
    end
    ret s
end

func _numel_of(shape &: Vector<int>): int:
    r := shape.Len()
    if r == 0: ret 0 end
    mut n := 1
    repeat r in i: n *= shape.Get(i) end
    ret n
end

func _raw(shape &: Vector<int>): Tensor:
    mut t := Tensor {}
    t.shape = _copy_shape(shape)
    n := _numel_of(shape)
    if n > 0: t.data.Alloc(n) end
    ret t
end

func _raw_like(x &: Tensor): Tensor:
    ret _raw(x.shape)
end

@en "Empty"
@fa "تهی"
pub func Empty(): Tensor: ret Tensor {} end

@en "Shape1"
@fa "شکل یک"
pub func Shape1(n: int): Vector<int>:
    mut s := Vector {} as Vector<int>
    s.Push(n)
    ret s
end

@en "Shape2"
@fa "شکل دو"
pub func Shape2(a: int, b: int): Vector<int>:
    mut s := Vector {} as Vector<int>
    s.Push(a)
    s.Push(b)
    ret s
end

@en "Shape3"
@fa "شکل سه"
pub func Shape3(a: int, b: int, c: int): Vector<int>:
    mut s := Vector {} as Vector<int>
    s.Push(a)
    s.Push(b)
    s.Push(c)
    ret s
end

@en "Shape4"
@fa "شکل چهار"
pub func Shape4(a: int, b: int, c: int, d: int): Vector<int>:
    mut s := Vector {} as Vector<int>
    s.Push(a)
    s.Push(b)
    s.Push(c)
    s.Push(d)
    ret s
end

@en "Zeros"
@fa "صفرها"
pub func Zeros(shape &: Vector<int>): Tensor:
    mut t := Tensor {}
    t.shape = _copy_shape(shape)
    n := _numel_of(shape)
    if n > 0: t.data.zeros(n) end
    ret t
end

@en "Zeros1"
@fa "صفرها یک"
pub func Zeros1(n: int): Tensor:
    mut s := Shape1(n)
    t := Zeros(s)
    s.Free()
    ret t
end

@en "Zeros2"
@fa "صفرها دو"
pub func Zeros2(r: int, c: int): Tensor:
    mut s := Shape2(r, c)
    t := Zeros(s)
    s.Free()
    ret t
end

@en "Zeros3"
@fa "صفرها سه"
pub func Zeros3(a: int, b: int, c: int): Tensor:
    mut s := Shape3(a, b, c)
    t := Zeros(s)
    s.Free()
    ret t
end

@en "Zeros4"
@fa "صفرها چهار"
pub func Zeros4(a: int, b: int, c: int, d: int): Tensor:
    mut s := Shape4(a, b, c, d)
    t := Zeros(s)
    s.Free()
    ret t
end

@en "Full"
@fa "پرشده"
pub func Full(shape &: Vector<int>, x: f64): Tensor:
    t := _raw(shape)
    n := t.data.Len()
    if n <= 0: ret t end
    v := x as f32
    p := t.data.data
    repeat n in k: p[k] = v end
    ret t
end

@en "Ones"
@fa "یک‌ها"
pub func Ones(shape &: Vector<int>): Tensor: ret Full(shape, 1.0) end

@en "Scalar"
@fa "اسکالر"
pub func Scalar(x: f64): Tensor:
    mut s := Shape1(1)
    t := Full(s, x)
    s.Free()
    ret t
end

@en "FromArray"
@fa "از آرایه"
pub func FromArray(shape &: Vector<int>, data &: Vector<f32>): Tensor:
    n := _numel_of(shape)
    if n != data.Len(): ret Empty() end
    t := _raw(shape)
    if n <= 0: ret t end
    p := t.data.data
    q := data.data
    repeat n in k: p[k] = q[k] end
    ret t
end

@en "Arange"
@fa "بازه گام"
pub func Arange(n: int): Tensor:
    t := Zeros1(n)
    p := t.data.data
    repeat n in k: p[k] = k as f32 end
    ret t
end

@en "Clone"
@fa "همانند"
pub func Clone(x &: Tensor): Tensor:
    t := _raw_like(x)
    n := t.data.Len()
    if n <= 0: ret t end
    p := t.data.data
    q := x.data.data
    repeat n in k: p[k] = q[k] end
    ret t
end

@en "CopyInto"
@fa "رونوشت در"
pub func CopyInto(dst &: Tensor, src &: Tensor):
    if dst.SameShape(src) == false: ret end
    n := src.data.Len()
    if n <= 0: ret end
    p := dst.data.data
    q := src.data.data
    repeat n in k: p[k] = q[k] end
end


@en "SetAll"
@fa "تنظیم همه"
pub func SetAll(x &: Tensor, v: f64):
    n := x.data.Len()
    if n <= 0: ret end
    s := v as f32
    p := x.data.data
    repeat n in k: p[k] = s end
end


@en "ToMatrix"
@fa "به ماتریس"
pub func ToMatrix(x &: Tensor): matrix.Matrix:
    r := x.rank()
    if r != 1 and r != 2: ret matrix.Matrix {} end
    mut rows := 1
    mut cols := x.shape.Get(0)
    if r == 2:
        rows = x.shape.Get(0)
        cols = x.shape.Get(1)
    end
    mut m := matrix.Zeros(rows, cols)
    n := x.data.Len()
    q := x.data.data
    repeat n in k: m.a.Set(k, q[k] as f64) end
    ret m
end

@en "FromMatrix"
@fa "از ماتریس"
pub func FromMatrix(m &: matrix.Matrix): Tensor:
    if m.IsEmpty(): ret Empty() end
    t := Zeros2(m.rows, m.cols)
    n := m.count()
    p := t.data.data
    repeat n in k: p[k] = m.a.Get(k) as f32 end
    ret t
end
