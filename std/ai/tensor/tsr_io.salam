package tensor

import compress
import encoding.binary
import mem
import str

const _TSR_DTYPE_F32 := 1

func _tsr_err(kind: ErrorKind, msg: str, at: int, code: str): Error:
    ret Error.At(kind, msg, at).with_code(code)
end

func _read_shape(rd &: compress.ByteReader, shape &: Vector<int>): i64 throws:
    dtype := try binary.ReadU8(rd)
    r := try binary.ReadU8(rd)
    if dtype != _TSR_DTYPE_F32: throw _tsr_err(ErrorKind.Unsupported, "unsupported dtype " + dtype + " (only f32)", rd.pos - 2, "tensor.dtype") end
    if r <= 0: throw _tsr_err(ErrorKind.Syntax, "rank 0", rd.pos - 1, "tensor.rank") end
    mut n := 1 as i64
    repeat r:
        d := try binary.ReadU32LE(rd)
        if d < 0: throw _tsr_err(ErrorKind.OutOfRange, "dimension too large", rd.pos - 4, "tensor.size") end
        shape.push(d)
        n *= (d as i64)
    end
    nbytes := try binary.ReadU64LE(rd)
    if nbytes != n * 4:
        throw _tsr_err(ErrorKind.Syntax, "the data size " + nbytes + " does not match the shape (" + (n * 4) + " bytes)", rd.pos - 8, "tensor.size")
    end
    if (compress.RdLeft(rd) as i64) < nbytes:
        throw _tsr_err(ErrorKind.UnexpectedEnd, "the data needs " + nbytes + " bytes, " + compress.RdLeft(rd) + " left", rd.pos, "tensor.truncated")
    end
    ret nbytes
end

func _read_name(rd &: compress.ByteReader): str throws:
    start := rd.pos
    nl := try binary.ReadU16LE(rd)
    if nl <= 0: throw _tsr_err(ErrorKind.Syntax, "empty tensor name", start, "tensor.bad_name") end
    if compress.RdLeft(rd) < nl:
        throw _tsr_err(ErrorKind.UnexpectedEnd, "the name needs " + nl + " bytes, " + compress.RdLeft(rd) + " left", rd.pos, "tensor.truncated")
    end
    mut nb := compress.RdBytes(rd, nl)
    name := compress.BufToStrUnsafe(nb)
    compress.BufFree(nb)
    ret name
end

@en "WriteTensor"
@fa "نوشتن تانسور"
pub func WriteTensor(buf &: compress.ByteBuf, name: str, t &: Tensor): bool:
    nl := str.Len(name)
    if nl <= 0 or nl > 65535: ret false end
    if t.IsEmpty(): ret false end
    r := t.rank()
    if r > 255: ret false end
    binary.WriteU16LE(buf, nl)
    compress.BufPushBytes(buf, name as void*, nl)
    binary.WriteU8(buf, _TSR_DTYPE_F32)
    binary.WriteU8(buf, r)
    repeat r in i: binary.WriteU32LE(buf, t.shape.get(i)) end
    n := t.numel()
    binary.WriteU64LE(buf, (n as i64) * 4)
    compress.BufPushBytes(buf, t.data.data as void*, n * 4)
    ret true
end

@en "ReadTensor"
@fa "خواندن تانسور"
pub func ReadTensor(rd &: compress.ByteReader, name_out &: str, out &: Tensor) throws:
    mut name := ""
    try:
        name = _read_name(rd)
    catch e:
        throw e.wrap("tensor")
    end
    mut shape := Vector {} as Vector<int>
    defer shape.Free()
    mut nbytes := 0 as i64
    try:
        nbytes = _read_shape(rd, shape)
    catch e:
        mem.Free(name as void*)
        throw e.wrap("tensor")
    end
    out.Free()
    t := _raw(shape)
    src := ((rd.data as i64) + (rd.pos as i64)) as void*
    mem.Copy(t.data.data as void*, src, nbytes as u64)
    rd.pos += nbytes as int
    out = t
    name_out = name
end
