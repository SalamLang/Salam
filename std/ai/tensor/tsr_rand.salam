package tensor

import math

const _RNG_MULT := 2685821657736338717 as u64
const _RNG_ODD := 1442695040888963407 as u64

@en "Rng"
@fa "مولد تصادفی"
pub struct Rng:
    @en "s"
    @fa "حالت داخلی"
    pub s: u64 = 0

    @en "NextBits"
    @fa "بیت بعدی"
    pub func NextBits(): u64:
        mut x := this.s
        x ^= (x >> 12)
        x ^= (x << 25)
        x ^= (x >> 27)
        this.s = x
        ret x * _RNG_MULT
    end

    @en "NextFloat"
    @fa "اعشاری بعدی"
    pub func NextFloat(): f64:
        v := this.NextBits() >> 11
        ret (v as f64) / 9007199254740992.0
    end

    @en "NextNormal"
    @fa "نرمال بعدی"
    pub func NextNormal(): f64:
        mut u := this.NextFloat()
        if u <= 0.0: u = 1.0e-15 end
        v := this.NextFloat()
        ret math.Sqrt(0.0 - 2.0 * math.Log(u)) * math.Cos(6.283185307179586 * v)
    end
end

@en "NewRng"
@fa "مولد تصادفی جدید"
pub func NewRng(seed: i64): Rng:
    mut g := Rng {}
    g.s = (seed as u64) + _RNG_ODD
    if g.s == 0: g.s = _RNG_ODD end
    ret g
end

@en "DeriveSeed"
@fa "بذر مشتق"
pub func DeriveSeed(seed: i64, index: i64): i64:
    ret seed + (0 - 7046029254386353131) * (index + 1)
end

@en "FillUniform"
@fa "پر کردن یکنواخت"
pub func FillUniform(t &: Tensor, lo: f64, hi: f64, g &: Rng):
    n := t.data.Len()
    p := t.data.data
    repeat n in k: p[k] = (lo + (hi - lo) * g.NextFloat()) as f32 end
end

@en "FillNormal"
@fa "پر کردن نرمال"
pub func FillNormal(t &: Tensor, mean: f64, std: f64, g &: Rng):
    n := t.data.Len()
    p := t.data.data
    repeat n in k: p[k] = (mean + std * g.NextNormal()) as f32 end
end

@en "FillBernoulli"
@fa "پر کردن برنولی"
pub func FillBernoulli(t &: Tensor, p: f64, g &: Rng):
    n := t.data.Len()
    d := t.data.data
    one := 1.0 as f32
    zero := 0.0 as f32
    repeat n in k:
        mut v := zero
        if g.NextFloat() < p: v = one end
        d[k] = v
    end
end

@en "RandUniform"
@fa "تصادفی یکنواخت"
pub func RandUniform(shape &: Vector<int>, lo: f64, hi: f64, seed: i64): Tensor:
    mut t := _raw(shape)
    mut g := NewRng(seed)
    FillUniform(t, lo, hi, g)
    ret t
end

@en "RandNormal"
@fa "تصادفی نرمال"
pub func RandNormal(shape &: Vector<int>, seed: i64): Tensor:
    mut t := _raw(shape)
    mut g := NewRng(seed)
    FillNormal(t, 0.0, 1.0, g)
    ret t
end
