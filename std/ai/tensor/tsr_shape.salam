package tensor

func _outer_of(x &: Tensor, axis: int): int:
    mut o := 1
    repeat axis in i: o *= x.shape.Get(i) end
    ret o
end

func _inner_of(x &: Tensor, axis: int): int:
    mut v := 1
    r := x.rank()
    repeat r - axis - 1 in i: v *= x.shape.Get(axis + 1 + i) end
    ret v
end

@en "Reshape"
@fa "تغییر شکل"
pub func Reshape(x &: Tensor, shape &: Vector<int>): Tensor:
    mut n := 1
    if shape.Len() == 0: n = 0 end
    repeat shape.Len() in i: n *= shape.Get(i) end
    if n != x.numel(): ret Empty() end
    mut t := Clone(x)
    t.reshape_(shape)
    ret t
end

@en "SqueezeInPlace"
@fa "فشردن درجا"
pub func SqueezeInPlace(x &: Tensor):
    mut s := Vector {} as Vector<int>
    repeat x.rank() in i:
        d := x.shape.Get(i)
        if d != 1: s.Push(d) end
    end
    if s.Len() == 0: s.Push(1) end
    x.shape.Free()
    x.shape = s
end

@en "UnsqueezeInPlace"
@fa "گشودن درجا"
pub func UnsqueezeInPlace(x &: Tensor, axis: int):
    r := x.rank()
    if axis < 0 or axis > r: ret end
    x.shape.Insert(axis, 1)
end

@en "Permute"
@fa "جایگشت"
pub func Permute(x &: Tensor, perm &: Vector<int>): Tensor:
    r := x.rank()
    if perm.Len() != r or r == 0: ret Empty() end
    mut in_range := true
    repeat r in i:
        p := perm.Get(i)
        if p < 0 or p >= r: in_range = false end
    end
    if in_range == false: ret Empty() end
    mut seen := Vector {} as Vector<int>
    seen.zeros(r)
    repeat r in i: seen.Set(perm.Get(i), seen.Get(perm.Get(i)) + 1) end
    mut valid := true
    repeat r in i:
        if seen.Get(i) != 1: valid = false end
    end
    seen.Free()
    if valid == false: ret Empty() end

    mut istr := Vector {} as Vector<int>
    istr.zeros(r)
    mut acc := 1
    repeat r in i:
        d := r - 1 - i
        istr.Set(d, acc)
        acc *= x.shape.Get(d)
    end
    mut ostr := Vector {} as Vector<int>
    ostr.zeros(r)
    mut oshape := Vector {} as Vector<int>
    repeat r in i:
        oshape.Push(x.shape.Get(perm.Get(i)))
        ostr.Set(i, istr.Get(perm.Get(i)))
    end

    t := _raw(oshape)
    n := t.data.Len()
    if n > 0:
        p := t.data.data
        q := x.data.data
        mut idx := Vector {} as Vector<int>
        idx.zeros(r)
        mut src := 0
        repeat n in k:
            p[k] = q[src]
            mut d := r - 1
            mut carrying := true
            until carrying:
                v := idx.Get(d) + 1
                if v < oshape.Get(d):
                    idx.Set(d, v)
                    src += ostr.Get(d)
                    carrying = false
                else:
                    src -= idx.Get(d) * ostr.Get(d)
                    idx.Set(d, 0)
                    if d == 0:
                        carrying = false
                    else:
                        d--
                    end
                end
            end
        end
        idx.Free()
    end
    istr.Free()
    ostr.Free()
    oshape.Free()
    ret t
end

@en "SliceAxis0"
@fa "برش محور صفر"
pub func SliceAxis0(x &: Tensor, start: int, len: int): Tensor:
    r := x.rank()
    if r == 0: ret Empty() end
    d0 := x.shape.Get(0)
    if start < 0 or len <= 0 or start + len > d0: ret Empty() end
    mut oshape := _copy_shape(x.shape)
    oshape.Set(0, len)
    t := _raw(oshape)
    oshape.Free()
    inner := x.numel() / d0
    n := len * inner
    p := t.data.data
    q := x.data.data
    base := start * inner
    repeat n in k: p[k] = q[base + k] end
    ret t
end

@en "Narrow"
@fa "باریک‌سازی"
pub func Narrow(x &: Tensor, axis: int, start: int, len: int): Tensor:
    r := x.rank()
    if axis < 0 or axis >= r: ret Empty() end
    if axis == 0: ret SliceAxis0(x, start, len) end
    mid := x.shape.Get(axis)
    if start < 0 or len <= 0 or start + len > mid: ret Empty() end
    outer := _outer_of(x, axis)
    inner := _inner_of(x, axis)
    mut oshape := _copy_shape(x.shape)
    oshape.Set(axis, len)
    t := _raw(oshape)
    oshape.Free()
    p := t.data.data
    q := x.data.data
    block := len * inner
    repeat outer in o:
        sbase := (o * mid + start) * inner
        dbase := o * block
        repeat block in k: p[dbase + k] = q[sbase + k] end
    end
    ret t
end

@en "Concat2"
@fa "پیوند دو"
pub func Concat2(a &: Tensor, b &: Tensor, axis: int): Tensor:
    r := a.rank()
    if r == 0 or b.rank() != r or axis < 0 or axis >= r: ret Empty() end
    repeat r in i:
        if i != axis and a.shape.Get(i) != b.shape.Get(i): ret Empty() end
    end
    ma := a.shape.Get(axis)
    mb := b.shape.Get(axis)
    outer := _outer_of(a, axis)
    inner := _inner_of(a, axis)
    mut oshape := _copy_shape(a.shape)
    oshape.Set(axis, ma + mb)
    t := _raw(oshape)
    oshape.Free()
    p := t.data.data
    qa := a.data.data
    qb := b.data.data
    blocka := ma * inner
    blockb := mb * inner
    ostride := blocka + blockb
    repeat outer in o:
        dbase := o * ostride
        abase := o * blocka
        repeat blocka in k: p[dbase + k] = qa[abase + k] end
        bbase := o * blockb
        repeat blockb in k: p[dbase + blocka + k] = qb[bbase + k] end
    end
    ret t
end

@en "Stack2"
@fa "انباشت دو"
pub func Stack2(a &: Tensor, b &: Tensor): Tensor:
    if a.SameShape(b) == false or a.rank() == 0: ret Empty() end
    mut oshape := Vector {} as Vector<int>
    oshape.Push(2)
    repeat a.rank() in i: oshape.Push(a.shape.Get(i)) end
    t := _raw(oshape)
    oshape.Free()
    n := a.numel()
    p := t.data.data
    qa := a.data.data
    qb := b.data.data
    repeat n in k: p[k] = qa[k] end
    repeat n in k: p[n + k] = qb[k] end
    ret t
end

@en "Pad2D"
@fa "لایه‌گذاری دوبعدی"
pub func Pad2D(x &: Tensor, pt: int, pb: int, pl: int, pr: int): Tensor:
    r := x.rank()
    if r < 2 or pt < 0 or pb < 0 or pl < 0 or pr < 0: ret Empty() end
    h := x.shape.Get(r - 2)
    w := x.shape.Get(r - 1)
    oh := h + pt + pb
    ow := w + pl + pr
    mut oshape := _copy_shape(x.shape)
    oshape.Set(r - 2, oh)
    oshape.Set(r - 1, ow)
    t := Zeros(oshape)
    oshape.Free()
    planes := x.numel() / (h * w)
    p := t.data.data
    q := x.data.data
    repeat planes in c:
        splane := c * h * w
        dplane := c * oh * ow
        repeat h in i:
            sbase := splane + i * w
            dbase := dplane + (i + pt) * ow + pl
            repeat w in k: p[dbase + k] = q[sbase + k] end
        end
    end
    ret t
end
