package archive

import compress

@en "Bzip2CompressFile"
@fa "فشرده سازی پرونده بی زیپ دو"
pub func Bzip2CompressFile(inpath: str, outpath: str): bool:
    ret _cw_compress_path(inpath, outpath, _CW_BZIP2, 9)
end

@en "Bzip2CompressFileLevel"
@fa "فشرده سازی پرونده بی زیپ دو با سطح"
pub func Bzip2CompressFileLevel(inpath: str, outpath: str, level: int): bool:
    mut lv := level
    if lv < 1: lv = 1 end
    if lv > 9: lv = 9 end
    ret _cw_compress_path(inpath, outpath, _CW_BZIP2, lv)
end

@en "Bzip2DecompressFileCap"
@fa "کدگشایی پرونده بی زیپ دو با سقف"
pub func Bzip2DecompressFileCap(inpath: str, outpath: str, cap: i64): int:
    mut rok := false
    mut inbuf := ReadBinaryFile(inpath, rok)
    if not rok:
        ret ARCHIVE_IO_ERROR
    end
    mut why := 0
    mut out := compress.Bzip2DecompressWhy(inbuf.data, inbuf.len, _decap(cap), why)
    compress.BufFree(inbuf)
    if why != compress.DecodeOk:
        compress.BufFree(out)
        ret why == compress.DecodeTooBig ? ARCHIVE_TOO_BIG : ARCHIVE_CORRUPT
    end
    wok := WriteBinaryFileBuf(outpath, out)
    compress.BufFree(out)
    ret wok ? ARCHIVE_OK : ARCHIVE_IO_ERROR
end

@en "Bzip2DecompressFile"
@fa "کدگشایی پرونده بی زیپ دو"
pub func Bzip2DecompressFile(inpath: str, outpath: str): bool:
    mut rok := false
    mut inbuf := ReadBinaryFile(inpath, rok)
    if not rok:
        ret false
    end
    mut bok := false
    mut out := compress.Bzip2Decompress(inbuf.data, inbuf.len, bok)
    compress.BufFree(inbuf)
    if not bok:
        compress.BufFree(out)
        ret false
    end
    wok := WriteBinaryFileBuf(outpath, out)
    compress.BufFree(out)
    ret wok
end
