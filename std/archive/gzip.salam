package archive

import compress

// The GZIP file format (RFC 1952): a small header, a raw DEFLATE stream
// (inflate.salam/deflate.salam), then a CRC-32 and the uncompressed size,
// both little-endian. GzipCompress always writes the minimal 10-byte
// header (no name/comment/extra field); GzipDecompress reads any header a
// real encoder might produce (FEXTRA/FNAME/FCOMMENT/FHCRC), so it can open
// a real .gz file, e.g. `gzip file.txt`'s output, not just its own.
//
// Verified interoperable both directions against the system `gzip`:
// GzipCompress's output passes `gzip -t` and decompresses byte-identical
// via `gzip -d`; GzipDecompress reads `gzip`'s own output byte-identical.

func _skip_cstring(p: void*, start: int, n: int): int:
    bp := p as u8*
    mut pos := start
    until pos < n && (bp[pos] as int) != 0:
        pos += 1
    end
    if pos < n: pos += 1 end
    ret pos
end

@en "GzipCompress"
@fa "فشرده سازی جی زیپ"
@ar "ضغط جي زيب"
pub func GzipCompress(p: void*, n: int): compress.ByteBuf:
    mut out := compress.NewByteBuf()
    compress.BufPush(out, 0x1f)
    compress.BufPush(out, 0x8b)
    compress.BufPush(out, 8)
    compress.BufPush(out, 0)
    LEPut32(out, 0)
    compress.BufPush(out, 0)
    compress.BufPush(out, 255)

    mut comp := Deflate(p, n)
    compress.BufPushBuf(out, comp)
    compress.BufFree(comp)

    crc := compress.CRC32(p, n)
    LEPut32(out, crc as int)
    LEPut32(out, n)
    ret out
end

// `ok` is false for anything that is not a well-formed, CM=8 (deflate)
// gzip stream this can actually decode (encrypted/multi-member/unknown
// compression-method streams are rejected rather than misread).
@en "GzipDecompress"
@fa "کدگشایی جی زیپ"
@ar "فك ضغط جي زيب"
pub func GzipDecompress(p: void*, n: int, ok &: bool): compress.ByteBuf:
    ok = false
    if n < 18:
        ret compress.NewByteBuf()
    end
    bp := p as u8*
    if (bp[0] as int) != 0x1f || (bp[1] as int) != 0x8b:
        ret compress.NewByteBuf()
    end
    if (bp[2] as int) != 8:
        ret compress.NewByteBuf()
    end
    flg := bp[3] as int
    mut pos := 10

    if (flg & 4) != 0:
        xlen := LEGet16(p, pos)
        pos += 2 + xlen
    end
    if (flg & 8) != 0:
        pos = _skip_cstring(p, pos, n)
    end
    if (flg & 16) != 0:
        pos = _skip_cstring(p, pos, n)
    end
    if (flg & 2) != 0:
        pos += 2
    end
    if pos >= n - 8:
        ret compress.NewByteBuf()
    end

    isize := LEGet32(p, n - 4)
    deflate_len := n - 8 - pos
    src := ((p as i64) + (pos as i64)) as void*
    mut inflate_ok := false
    out := Inflate(src, deflate_len, isize, inflate_ok)
    if !inflate_ok:
        ret out
    end
    ok = true
    ret out
end

@en "GzipCompressFile"
@fa "فشرده سازی پرونده جی زیپ"
@ar "ضغط ملف جي زيب"
pub func GzipCompressFile(inpath: str, outpath: str): bool:
    mut rok := false
    inbuf := ReadBinaryFile(inpath, rok)
    if !rok:
        ret false
    end
    mut out := GzipCompress(inbuf.data, inbuf.len)
    wok := WriteBinaryFileBuf(outpath, out)
    compress.BufFree(inbuf)
    compress.BufFree(out)
    ret wok
end

@en "GzipDecompressFile"
@fa "کدگشایی پرونده جی زیپ"
@ar "فك ضغط ملف جي زيب"
pub func GzipDecompressFile(inpath: str, outpath: str): bool:
    mut rok := false
    inbuf := ReadBinaryFile(inpath, rok)
    if !rok:
        ret false
    end
    mut gok := false
    mut out := GzipDecompress(inbuf.data, inbuf.len, gok)
    compress.BufFree(inbuf)
    if !gok:
        compress.BufFree(out)
        ret false
    end
    wok := WriteBinaryFileBuf(outpath, out)
    compress.BufFree(out)
    ret wok
end
