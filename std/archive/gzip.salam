package archive

import compress

// Single-file .gz container I/O (RFC 1952). The actual GZIP encode/decode
// (header, RFC 1951 DEFLATE payload, CRC-32 trailer) lives in
// std/compress's own gzip.salam/raw_deflate.salam/raw_inflate.salam - it
// needs no OS-specific code, so it stays there, reachable by anything that
// imports compress without also pulling in this package's file I/O. What
// belongs here is only the "read/write an actual .gz file on disk" layer,
// via this package's ReadBinaryFile/WriteBinaryFileBuf.

@en "GzipCompressFile"
@fa "فشرده سازی پرونده جی زیپ"
@ar "ضغط ملف جي زيب"
pub func GzipCompressFile(inpath: str, outpath: str): bool:
    mut rok := false
    inbuf := ReadBinaryFile(inpath, rok)
    if !rok:
        ret false
    end
    mut out := compress.GzipCompress(inbuf.data, inbuf.len)
    wok := WriteBinaryFileBuf(outpath, out)
    compress.BufFree(inbuf)
    compress.BufFree(out)
    ret wok
end

@en "GzipDecompressFile"
@fa "کدگشایی پرونده جی زیپ"
@ar "فك ضغط ملف جي زيب"
pub func GzipDecompressFile(inpath: str, outpath: str): bool:
    mut rok := false
    inbuf := ReadBinaryFile(inpath, rok)
    if !rok:
        ret false
    end
    mut gok := false
    mut out := compress.GzipDecompress(inbuf.data, inbuf.len, gok)
    compress.BufFree(inbuf)
    if !gok:
        compress.BufFree(out)
        ret false
    end
    wok := WriteBinaryFileBuf(outpath, out)
    compress.BufFree(out)
    ret wok
end
