package archive

import compress
import filepath
import mem
import os
import str

@en "RAR_OK"
@fa "آر ای آر موفق"
pub const RAR_OK := 0
@en "RAR_NOT_FOUND"
@fa "آر ای آر یافت نشد"
pub const RAR_NOT_FOUND := 1
@en "RAR_UNSUPPORTED"
@fa "آر ای آر پشتیبانی نمی شود"
pub const RAR_UNSUPPORTED := 2
@en "RAR_ENCRYPTED"
@fa "آر ای آر رمزگذاری شده"
pub const RAR_ENCRYPTED := 3
@en "RAR_CORRUPT"
@fa "آر ای آر خراب"
pub const RAR_CORRUPT := 4
@en "RAR_BAD_CRC"
@fa "آر ای آر چک جمع ناهمخوان"
pub const RAR_BAD_CRC := 5
@en "RAR_MULTIVOLUME"
@fa "آر ای آر چند بخشی"
pub const RAR_MULTIVOLUME := 6
@en "RAR_TOO_BIG"
@fa "آر ای آر بیش از حد بزرگ"
pub const RAR_TOO_BIG := 7
@en "RAR_UNSAFE_PATH"
@fa "آر ای آر مسیر ناایمن"
pub const RAR_UNSAFE_PATH := 8
@en "RAR_BAD_PASSWORD"
@fa "آر ای آر گذرواژه اشتباه"
pub const RAR_BAD_PASSWORD := 9

struct _RarFile:
    pub name: str
    pub unp_size: i64
    pub pack_size: i64
    pub data_off: int
    pub crc: u32
    pub has_crc: bool
    pub mtime: i64
    pub is_dir: bool
    pub solid: bool
    pub method: int
    pub ver: int
    pub dict: i64
    pub encrypted: bool
    pub split: bool
    pub redirect: bool
    pub rkind: int
    pub rflags: int
    pub rtarget: str
    pub attr: i64
    pub host: int
    pub dc: int
    pub crypt: int
    pub kdf: int
    pub cflags: int
    pub salt: u8*
    pub iv: u8*
    pub chk: u8*
    pub base: u8*
    pub vlen: int
    pub split_before: bool
    pub split_after: bool
    pub owned: bool
end

struct _RarArc:
    pub p: u8*
    pub n: int
    pub valid: bool
    pub v5: bool
    pub files: Vector<_RarFile>
    pub enc_headers: bool
    pub multi: bool
    pub password: str
    pub hkey: u8*
    pub h4: bool
    pub bad_password: bool
    pub kcache: u8*
end

@en "RarFileInput"
@fa "ورودی پرونده آر ای آر"
pub struct RarFileInput:
    @en "name"
    @fa "نام"
    pub name: str = ""
    @en "data_ptr"
    @fa "نشانی داده"
    pub data_ptr: void* = null
    @en "data_len"
    @fa "طول داده"
    pub data_len: int = 0
    @en "is_dir"
    @fa "پوشه"
    pub is_dir: bool = false
    @en "mtime"
    @fa "زمان تغییر"
    pub mtime: i64 = 0 as i64
end

@en "RarArchive"
@fa "بایگانی آر ای آر"
pub struct RarArchive:
    @en "data"
    @fa "داده"
    pub data: void* = null
    @en "len"
    @fa "طول"
    pub len: int = 0
    @en "password"
    @fa "گذرواژه"
    pub password: str = ""
    @en "status"
    @fa "وضعیت"
    pub status: int = 0
    @en "more"
    @fa "بخش‌های دیگر"
    pub more: Vector<compress.ByteBuf> = Vector {}
end

func _rar_crc_table(): u32*:
    t := mem.Allocate(1024 as u64) as u32*
    repeat 256 in i:
        mut c := i as u32
        repeat 8:
            if (c & (1 as u32)) != (0 as u32):
                c = (c >> 1) ^ (0xEDB88320 as u32)
            else:
                c >>= 1
            end
        end
        t[i] = c
    end
    ret t
end

func _rar_crc(p: void*, n: int): u32:
    t := _rar_crc_table()
    bp := p as u8*
    mut c := 0xFFFFFFFF as u32
    mut i := 0
    until i < n:
        c = t[((c ^ (bp[i] as u32)) & (255 as u32)) as int] ^ (c >> 8)
        i++
    end
    mem.Free(t as void*)
    ret c ^ (0xFFFFFFFF as u32)
end

func _rar_open(p: void*, n: int, pw: str): _RarArc:
    mut a := _RarArc {
        p = p as u8*
        n = n
        valid = false
        v5 = false
        files = Vector {} as Vector<_RarFile>
        enc_headers = false
        multi = false
        password = pw
        hkey = null
        h4 = false
        bad_password = false
        kcache = mem.AllocateZeroed(256 as u64) as u8*
    }
    if _rar5_sig_match(p, n):
        a.valid = true
        a.v5 = true
        _rar5_scan(a)
    else _rar4_sig_match(p, n):
        a.valid = true
        _rar4_scan(a)
    end
    ret a
end

func _rar_merge_volumes(a &: _RarArc):
    mut any := false
    repeat a.files.len() in k:
        g0 := a.files.get(k)
        if g0.split_before or g0.split_after:
            any = true
        end
    end
    if not any:
        ret
    end
    n := a.files.len()
    mut out := Vector {} as Vector<_RarFile>
    mut i := 0
    until i < n:
        f := a.files.get(i)
        i++
        if f.split_after and not f.split_before:
            mut j := i
            mut total := f.pack_size
            mut complete := false
            until j < n:
                g := a.files.get(j)
                if g.name != f.name or not g.split_before:
                    break
                end
                total += g.pack_size
                j++
                if not g.split_after:
                    complete = true
                    break
                end
            end
            if complete and total <= 2000000000:
                buf := mem.AllocateZeroed((total + 16) as u64) as u8*
                mut at := 0
                mut k := i - 1
                until k < j:
                    part := a.files.get(k)
                    mem.Copy(((buf as i64) + (at as i64)) as void*, ((part.base as i64) + (part.data_off as i64)) as void*, part.pack_size as u64)
                    at += part.pack_size as int
                    k++
                end
                last := a.files.get(j - 1)
                mut merged := f
                merged.pack_size = total
                merged.data_off = 0
                merged.base = buf
                merged.vlen = total as int
                merged.owned = true
                merged.split = false
                merged.split_before = false
                merged.split_after = false
                merged.crc = last.crc
                merged.has_crc = last.has_crc
                merged.cflags = last.cflags
                out.push(merged)
                mut d := i
                until d < j:
                    _rar_free_name(a.files.get(d).name)
                    _rar_free_name(a.files.get(d).rtarget)
                    _rar_free_part(a.files.get(d))
                    d++
                end
                i = j
                continue
            end
            out.push(f)
            mut d2 := i
            until d2 < j:
                _rar_free_name(a.files.get(d2).name)
                _rar_free_name(a.files.get(d2).rtarget)
                _rar_free_part(a.files.get(d2))
                d2++
            end
            i = j
            continue
        end
        out.push(f)
    end
    a.files.free()
    a.files = out
end

func _rar_open_vols(p: void*, n: int, more: Vector<compress.ByteBuf>, pw: str): _RarArc:
    mut a := _rar_open(p, n, pw)
    if more.len() == 0 or not a.valid:
        ret a
    end
    repeat more.len() in i:
        v := more.get(i)
        if not IsRar(v.data, v.len):
            continue
        end
        a.p = v.data as u8*
        a.n = v.len
        a.h4 = false
        mem.Free(a.hkey as void*)
        a.hkey = null
        if a.v5:
            _rar5_scan(a)
        else:
            _rar4_scan(a)
        end
    end
    a.p = p as u8*
    a.n = n
    _rar_merge_volumes(a)
    ret a
end

func _rar_transparent(f: _RarFile): bool:
    ret f.is_dir or f.redirect or f.method == 0
end

func _rar_chain_start(a: _RarArc, idx: int): int:
    mut s := idx
    until s > 0:
        cur := a.files.get(s)
        if not cur.solid and not _rar_transparent(cur):
            break
        end
        s--
    end
    ret s
end

func _rar_win_size(a: _RarArc, s: int): i64:
    mut total := 0 as i64
    mut maxdict := 0 as i64
    mut k := s
    until k < a.files.len():
        f := a.files.get(k)
        if k > s and not f.solid and not _rar_transparent(f):
            break
        end
        if not _rar_transparent(f):
            if f.unp_size >= 0:
                total += f.unp_size
            else:
                total += f.dict
            end
            if f.dict > maxdict:
                maxdict = f.dict
            end
        end
        k++
    end
    mut w := total
    if a.v5:
        if maxdict < w:
            w = maxdict
        end
    else:
        if w > 4194304:
            w = 4194304 as i64
        end
    end
    mut sz := 131072 as i64
    until sz < w:
        sz <<= 1
    end
    ret sz
end

func _rar_core(a: _RarArc, r5 &: _R5, r3 &: _R3, ro &: _ROld, nx &: int, rd &: int, idx: int, limit: i64, out &: compress.ByteBuf, src: u8*, psize: int, hk: u8*): int:
    f := a.files.get(idx)
    if f.split:
        ret RAR_MULTIVOLUME
    end
    if f.is_dir or f.redirect:
        if nx == idx:
            nx = idx + 1
        end
        ret RAR_OK
    end
    if limit > 0 and f.unp_size > limit:
        ret RAR_TOO_BIG
    end
    if f.pack_size < 0 or (f.data_off as i64) + f.pack_size > (f.vlen as i64):
        ret RAR_CORRUPT
    end
    base := out.len
    if f.unp_size == 0 and f.pack_size == 0:
        if nx == idx:
            nx = idx + 1
        end
    else f.method == 0:
        if f.encrypted:
            if f.unp_size < 0 or f.unp_size > (psize as i64):
                ret RAR_CORRUPT
            end
            compress.BufPushBytes(out, src as void*, f.unp_size as int)
        else:
            if f.unp_size >= 0 and f.unp_size != f.pack_size:
                ret RAR_CORRUPT
            end
            compress.BufPushBytes(out, src as void*, f.pack_size as int)
        end
        if nx == idx:
            nx = idx + 1
        end
    else:
        if a.v5 and f.ver > 1:
            ret RAR_UNSUPPORTED
        end
        if not a.v5 and f.ver != 29 and f.ver != 36 and f.ver != 20 and f.ver != 26 and f.ver != 15:
            ret RAR_UNSUPPORTED
        end
        if f.method > 5:
            ret RAR_UNSUPPORTED
        end
        if f.solid and nx != idx:
            s := _rar_chain_start(a, idx)
            nx = s
            rd = 0
            mut k := s
            until k < idx:
                mut scratch := compress.NewByteBuf()
                st := _rar_run(a, r5, r3, ro, nx, rd, k, 0 as i64, scratch)
                compress.BufFree(scratch)
                if st != RAR_OK:
                    nx = -1
                    rd = 0
                    ret st
                end
                k++
            end
            nx = idx
        end
        lim := limit > 0 ? limit : (2000000000 as i64)
        mut st := RAR_OK
        if a.v5:
            if not f.solid or rd == 0:
                w := _rar_win_size(a, idx)
                if w > 1073741824:
                    ret RAR_TOO_BIG
                end
                if not _r5_setwin(r5, w as int):
                    ret RAR_TOO_BIG
                end
                r5.dcsize = f.dc
                _r5_reset(r5)
            end
            st = _r5_decode(r5, src, psize, f.unp_size, lim, out)
        else f.ver == 29 or f.ver == 36:
            if not f.solid or rd == 0:
                w := _rar_win_size(a, idx)
                if not _r3_setwin(r3, w as int):
                    ret RAR_TOO_BIG
                end
                _r3_reset(r3)
            end
            st = _r3_decode(r3, src, psize, f.unp_size, lim, out)
        else:
            if not f.solid or rd == 0:
                w := _rar_win_size(a, idx)
                if not _ro_setwin(ro, w as int):
                    ret RAR_TOO_BIG
                end
                _ro_reset(ro)
            end
            if f.ver == 15:
                st = _ro15_decode(ro, src, psize, f.unp_size, lim, f.solid, out)
            else:
                st = _ro20_decode(ro, src, psize, f.unp_size, lim, f.solid, out)
            end
        end
        if st != RAR_OK:
            out.len = base
            nx = -1
            rd = 0
            ret st
        end
        rd = 1
        nx = idx + 1
    end
    if f.has_crc:
        mut c := _rar_crc(((out.data as i64) + (base as i64)) as void*, out.len - base)
        if hk != null and f.crypt == 5 and (f.cflags & 2) != 0:
            c = _rar_mac_crc(c, hk)
        end
        if c != f.crc:
            out.len = base
            if f.crypt >= 1 and f.crypt <= 3:
                ret RAR_BAD_PASSWORD
            end
            ret RAR_BAD_CRC
        end
    end
    ret RAR_OK
end

func _rar_run(a: _RarArc, r5 &: _R5, r3 &: _R3, ro &: _ROld, nx &: int, rd &: int, idx: int, limit: i64, out &: compress.ByteBuf): int:
    f := a.files.get(idx)
    if f.is_dir or f.redirect or f.split or not f.encrypted:
        src := ((f.base as i64) + (f.data_off as i64)) as u8*
        if f.pack_size < 0 or (f.data_off as i64) + f.pack_size > (f.vlen as i64):
            ret RAR_CORRUPT
        end
        ret _rar_core(a, r5, r3, ro, nx, rd, idx, limit, out, src, f.pack_size as int, null)
    end
    if a.password.len() == 0:
        ret RAR_ENCRYPTED
    end
    if f.pack_size < 0 or (f.data_off as i64) + f.pack_size > (f.vlen as i64):
        ret RAR_CORRUPT
    end
    n16 := f.crypt == 1 ? (f.pack_size as int) : ((f.pack_size as int) & (~15))
    mut st := 0
    hk := mem.AllocateZeroed(64 as u64) as u8*
    src := ((f.base as i64) + (f.data_off as i64)) as u8*
    dec := _rar_decrypt_file(a.kcache, a.password, f, src, n16, hk, st)
    if dec == null:
        mem.Free(hk as void*)
        ret st
    end
    mut res := _rar_core(a, r5, r3, ro, nx, rd, idx, limit, out, dec, n16, hk)
    mem.Free(dec as void*)
    mem.Free(hk as void*)
    if f.crypt >= 1 and f.crypt <= 3 and (res == RAR_CORRUPT or res == RAR_BAD_CRC):
        res = RAR_BAD_PASSWORD
    end
    ret res
end

func _rar_find(a: _RarArc, name: str): int:
    mut i := 0
    until i < a.files.len():
        if a.files.get(i).name == name:
            ret i
        end
        i++
    end
    ret -1
end

func _rar_put_vint(b &: compress.ByteBuf, v0: i64):
    mut v := v0
    until true:
        mut x := (v & 0x7f) as int
        v >>= 7
        if v > 0:
            x |= 0x80
        end
        compress.BufPush(b, x)
        if v == 0:
            break
        end
    end
end

func _rar_put_header(out &: compress.ByteBuf, body: compress.ByteBuf):
    mut head := compress.NewByteBuf()
    _rar_put_vint(head, body.len as i64)
    compress.BufPushBuf(head, body)
    LEPut32(out, _rar_crc(head.data, head.len) as int)
    compress.BufPushBuf(out, head)
    compress.BufFree(head)
end

func _rar_entries_of(a: _RarArc): Vector<Entry>:
    mut out := Vector {} as Vector<Entry>
    repeat a.files.len() in i:
        f := a.files.get(i)
        out.push(Entry {
            name = _rar_dup(f.name)
            size = f.unp_size < 0 ? 0 as i64 : f.unp_size
            compressed_size = f.pack_size
            is_dir = f.is_dir
            method = f.method
            crc32 = f.crc
            mtime = f.mtime
        })
    end
    ret out
end

func _rar_dup(s: str): str:
    if s.len() == 0:
        ret ""
    end
    ret _rar_str(s as u8*, 0, s.len())
end

func _rar_arc_status(a: _RarArc): int:
    if a.bad_password:
        ret RAR_BAD_PASSWORD
    end
    if a.enc_headers:
        ret RAR_ENCRYPTED
    end
    ret RAR_OK
end

func _rar_read_from(a: _RarArc, name: str, max: int, status &: int): compress.ByteBuf:
    mut out := compress.NewByteBuf()
    status = RAR_NOT_FOUND
    idx := _rar_find(a, name)
    if idx >= 0:
        mut r5 := _r5_new(131072, 64)
        mut r3 := _r3_new(131072)
        mut ro := _ro_new(131072)
        mut nx := -1
        mut rd := 0
        status = _rar_run(a, r5, r3, ro, nx, rd, idx, max as i64, out)
        _r5_free(r5)
        _r3_free(r3)
        _ro_free(ro)
    else:
        st := _rar_arc_status(a)
        if st != RAR_OK:
            status = st
        end
    end
    ret out
end

func _rar_unix_mode(f: _RarFile): int:
    if f.host != 1:
        ret -1
    end
    ret (f.attr & 0x1ff) as int
end

func _rar_apply_meta(f: _RarFile, path: str):
    m := _rar_unix_mode(f)
    if m >= 0:
        _rar_set_mode(path, f.is_dir ? (m | 0x1c0) : (m | 0x180))
    end
    if f.mtime > 0:
        _rar_set_mtime(path, f.mtime)
    end
end

func _rar_make_link(f: _RarFile, target: str, outpath: str, made &: Vector<str>, status &: int): bool:
    if f.rkind != 1:
        ret false
    end
    if not _rar_link_target_ok(f.name, target, made):
        status = RAR_UNSAFE_PATH
        ret false
    end
    if not _rar_symlink(target, outpath):
        if status == RAR_OK:
            status = RAR_UNSUPPORTED
        end
        ret false
    end
    made.push(_rar_dup(f.name))
    ret true
end

func _rar_copy_link(f: _RarFile, destdir: str, outpath: str, made &: Vector<str>, status &: int): bool:
    if not _safe_entry_name(f.rtarget) or _rar_under_link(f.rtarget, made):
        status = RAR_UNSAFE_PATH
        ret false
    end
    src := filepath.Join(destdir, f.rtarget)
    mut ok := false
    mut data := ReadBinaryFile(src, ok)
    mem.Free(src as void*)
    if not ok:
        if status == RAR_OK:
            status = RAR_NOT_FOUND
        end
        ret false
    end
    if os.Exists(outpath):
        _rar_set_mode(outpath, 0x1a4)
    end
    res := WriteBinaryFileBuf(outpath, data)
    compress.BufFree(data)
    if res:
        _rar_apply_meta(f, outpath)
    else:
        if status == RAR_OK:
            status = RAR_CORRUPT
        end
    end
    ret res
end

func _rar_extract_all_of(a: _RarArc, destdir: str, status &: int): int:
    status = RAR_OK
    mut extracted := 0
    mut r5 := _r5_new(131072, 64)
    mut r3 := _r3_new(131072)
    mut ro := _ro_new(131072)
    mut nx := -1
    mut rd := 0
    mut broken := false
    mut made := Vector {} as Vector<str>
    mut i := 0
    until i < a.files.len():
        f := a.files.get(i)
        i++
        if not _safe_entry_name(f.name) or _rar_under_link(f.name, made):
            status = RAR_UNSAFE_PATH
            continue
        end
        outpath := filepath.Join(destdir, f.name)
        if f.redirect:
            parent := filepath.Dir(outpath)
            EnsureDir(parent)
            mem.Free(parent as void*)
            if f.rkind == 1:
                if _rar_make_link(f, f.rtarget, outpath, made, status):
                    extracted++
                end
            else f.rkind == 4 or f.rkind == 5:
                if _rar_copy_link(f, destdir, outpath, made, status):
                    extracted++
                end
            else:
                if status == RAR_OK:
                    status = RAR_UNSUPPORTED
                end
            end
        else f.is_dir:
            EnsureDir(outpath)
            extracted++
        else:
            if broken and f.solid:
                if status == RAR_OK:
                    status = RAR_CORRUPT
                end
            else:
                parent := filepath.Dir(outpath)
                EnsureDir(parent)
                mem.Free(parent as void*)
                mut data := compress.NewByteBuf()
                st := _rar_run(a, r5, r3, ro, nx, rd, i - 1, 0 as i64, data)
                if st == RAR_OK:
                    if f.rkind == 1:
                        tgt := compress.BufToStrUnsafe(data)
                        if _rar_make_link(f, tgt, outpath, made, status):
                            extracted++
                        end
                        _rar_free_name(tgt)
                    else:
                        if os.Exists(outpath):
                            _rar_set_mode(outpath, 0x1a4)
                        end
                        if WriteBinaryFileBuf(outpath, data):
                            _rar_apply_meta(f, outpath)
                            extracted++
                        else:
                            status = RAR_CORRUPT
                        end
                    end
                else:
                    broken = true
                    if status == RAR_OK:
                        status = st
                    end
                end
                compress.BufFree(data)
            end
        end
        mem.Free(outpath as void*)
    end
    mut j := a.files.len() - 1
    until j >= 0:
        f := a.files.get(j)
        j--
        if f.is_dir and _safe_entry_name(f.name) and not _rar_under_link(f.name, made):
            dpath := filepath.Join(destdir, f.name)
            if os.IsDir(dpath):
                _rar_apply_meta(f, dpath)
            end
            mem.Free(dpath as void*)
        end
    end
    repeat made.len() in k:
        mem.Free(made.get(k) as void*)
    end
    made.free()
    if status == RAR_OK:
        status = _rar_arc_status(a)
    end
    _r5_free(r5)
    _r3_free(r3)
    _ro_free(ro)
    ret extracted
end

func _rar_digits_end(path: str, upto: int): int:
    bp := path as u8*
    mut k := upto
    until k > 0 and (bp[k - 1] as int) >= 48 and (bp[k - 1] as int) <= 57:
        k--
    end
    ret k
end

func _rar_volume_path(first: str, idx: int): str:
    n := first.len()
    if n < 5:
        ret ""
    end
    lower := str.Lower(first)
    if not str.EndsWith(lower, ".rar"):
        _rar_free_name(lower)
        ret ""
    end
    stem := n - 4
    ds := _rar_digits_end(lower, stem)
    mut is_part := false
    if ds < stem and ds >= 5:
        pre := str.Substr(lower, 0, ds)
        is_part = str.EndsWith(pre, ".part")
        _rar_free_name(pre)
    end
    _rar_free_name(lower)
    head := str.Substr(first, 0, is_part ? ds : stem)
    if is_part:
        width := stem - ds
        ns := str.Substr(first, ds, width)
        num := str.ToInt(ns) + idx
        _rar_free_name(ns)
        mut digits := str.FromInt(num as i64)
        until digits.len() < width:
            grown := "0" + digits
            _rar_free_name(digits)
            digits = grown
        end
        tail := str.Substr(first, stem, 4)
        joined := head + digits
        res := joined + tail
        _rar_free_name(head)
        _rar_free_name(digits)
        _rar_free_name(tail)
        _rar_free_name(joined)
        ret res
    end
    k := idx - 1
    if k / 100 >= 9:
        _rar_free_name(head)
        ret ""
    end
    letter := str.Substr("rstuvwxyz", k / 100, 1)
    mut two := str.FromInt((k % 100) as i64)
    if two.len() < 2:
        padded := "0" + two
        _rar_free_name(two)
        two = padded
    end
    dot := head + "."
    mid := dot + letter
    res := mid + two
    _rar_free_name(head)
    _rar_free_name(dot)
    _rar_free_name(mid)
    _rar_free_name(letter)
    _rar_free_name(two)
    ret res
end

@en "IsRar"
@fa "آر ای آر است"
pub func IsRar(p: void*, n: int): bool:
    ret _rar4_sig_match(p, n) or _rar5_sig_match(p, n)
end

@en "RarStatusText"
@fa "متن وضعیت آر ای آر"
pub func RarStatusText(status: int): str:
    if status == RAR_OK: ret "ok" end
    if status == RAR_NOT_FOUND: ret "entry not found" end
    if status == RAR_UNSUPPORTED: ret "unsupported RAR version or method" end
    if status == RAR_ENCRYPTED: ret "encrypted entry" end
    if status == RAR_CORRUPT: ret "corrupt data" end
    if status == RAR_BAD_CRC: ret "checksum mismatch" end
    if status == RAR_MULTIVOLUME: ret "a volume of the multi-volume archive is missing" end
    if status == RAR_TOO_BIG: ret "entry too large" end
    if status == RAR_UNSAFE_PATH: ret "entry path leaves the target folder" end
    if status == RAR_BAD_PASSWORD: ret "wrong password" end
    ret "unknown error"
end

@en "RarList"
@fa "فهرست آر ای آر"
pub func RarList(p: void*, n: int): Vector<Entry>:
    mut a := _rar_open(p, n, "")
    out := _rar_entries_of(a)
    _rar_free_files(a.files)
    _rar_close_arc(a)
    ret out
end

@en "RarExtract"
@fa "استخراج آر ای آر"
pub func RarExtract(p: void*, n: int, name: str, max: int, status &: int): compress.ByteBuf:
    mut a := _rar_open(p, n, "")
    out := _rar_read_from(a, name, max, status)
    _rar_free_files(a.files)
    _rar_close_arc(a)
    ret out
end

@en "RarExtractByNameMax"
@fa "استخراج با نام از آر ای آر با سقف"
pub func RarExtractByNameMax(p: void*, n: int, name: str, max: int, ok &: bool): compress.ByteBuf:
    mut st := 0
    out := RarExtract(p, n, name, max, st)
    ok = st == RAR_OK
    ret out
end

@en "RarExtractByName"
@fa "استخراج با نام از آر ای آر"
pub func RarExtractByName(p: void*, n: int, name: str, ok &: bool): compress.ByteBuf:
    ret RarExtractByNameMax(p, n, name, 0, ok)
end

@en "RarExtractAllStatus"
@fa "استخراج همه از آر ای آر با وضعیت"
pub func RarExtractAllStatus(p: void*, n: int, destdir: str, status &: int): int:
    mut a := _rar_open(p, n, "")
    extracted := _rar_extract_all_of(a, destdir, status)
    _rar_free_files(a.files)
    _rar_close_arc(a)
    ret extracted
end

@en "RarExtractAll"
@fa "استخراج همه از آر ای آر"
pub func RarExtractAll(p: void*, n: int, destdir: str): bool:
    mut st := 0
    _ := RarExtractAllStatus(p, n, destdir, st)
    ret st == RAR_OK
end

@en "RarOpen"
@fa "بازکردن آر ای آر"
pub func RarOpen(p: void*, n: int, password: str): RarArchive:
    ret RarArchive { data = p, len = n, password = password, status = RAR_OK }
end

@en "RarEntries"
@fa "مدخل‌های آر ای آر"
pub func RarEntries(arc &: RarArchive): Vector<Entry>:
    mut a := _rar_open_vols(arc.data, arc.len, arc.more, arc.password)
    arc.status = _rar_arc_status(a)
    out := _rar_entries_of(a)
    _rar_free_files(a.files)
    _rar_close_arc(a)
    ret out
end

@en "RarRead"
@fa "خواندن از آر ای آر"
pub func RarRead(arc &: RarArchive, name: str, max: int): compress.ByteBuf:
    mut a := _rar_open_vols(arc.data, arc.len, arc.more, arc.password)
    mut st := 0
    out := _rar_read_from(a, name, max, st)
    arc.status = st
    _rar_free_files(a.files)
    _rar_close_arc(a)
    ret out
end

@en "RarReadAll"
@fa "خواندن همه از آر ای آر"
pub func RarReadAll(arc &: RarArchive, destdir: str): int:
    mut a := _rar_open_vols(arc.data, arc.len, arc.more, arc.password)
    mut st := 0
    extracted := _rar_extract_all_of(a, destdir, st)
    arc.status = st
    _rar_free_files(a.files)
    _rar_close_arc(a)
    ret extracted
end

@en "RarReadVolumes"
@fa "خواندن بخش‌های آر ای آر"
pub func RarReadVolumes(first: str, ok &: bool): Vector<compress.ByteBuf>:
    mut vols := Vector {} as Vector<compress.ByteBuf>
    head := ReadBinaryFile(first, ok)
    if not ok:
        ret vols
    end
    vols.push(head)
    mut idx := 1
    until true:
        path := _rar_volume_path(first, idx)
        if path.len() == 0:
            break
        end
        if not os.Exists(path):
            mem.Free(path as void*)
            break
        end
        mut more_ok := false
        part := ReadBinaryFile(path, more_ok)
        mem.Free(path as void*)
        if not more_ok:
            break
        end
        vols.push(part)
        idx++
    end
    ret vols
end

@en "RarFreeVolumes"
@fa "آزادسازی بخش‌های آر ای آر"
pub func RarFreeVolumes(vols &: Vector<compress.ByteBuf>):
    repeat vols.len() in i:
        mut b := vols.get(i)
        compress.BufFree(b)
    end
    vols.free()
end

@en "RarOpenVolumes"
@fa "بازکردن بخش‌های آر ای آر"
pub func RarOpenVolumes(vols: Vector<compress.ByteBuf>, password: str): RarArchive:
    mut arc := RarArchive { password = password, status = RAR_OK }
    if vols.len() == 0:
        ret arc
    end
    first := vols.get(0)
    arc.data = first.data
    arc.len = first.len
    repeat vols.len() - 1 in i:
        arc.more.push(vols.get(i + 1))
    end
    ret arc
end

@en "RarClose"
@fa "بستن آر ای آر"
pub func RarClose(arc &: RarArchive):
    arc.more.free()
end

@en "MakeRarFileInput"
@fa "ساخت ورودی پرونده آر ای آر"
pub func MakeRarFileInput(name: str, data_ptr: void*, data_len: int, is_dir: bool): RarFileInput:
    ret RarFileInput { name = name, data_ptr = data_ptr, data_len = data_len, is_dir = is_dir }
end

@en "RarCreate"
@fa "ساخت آر ای آر"
pub func RarCreate(files: Vector<RarFileInput>): compress.ByteBuf:
    mut out := compress.NewByteBuf()
    compress.BufPush(out, 0x52)
    compress.BufPush(out, 0x61)
    compress.BufPush(out, 0x72)
    compress.BufPush(out, 0x21)
    compress.BufPush(out, 0x1a)
    compress.BufPush(out, 0x07)
    compress.BufPush(out, 0x01)
    compress.BufPush(out, 0x00)
    mut mh := compress.NewByteBuf()
    _rar_put_vint(mh, 1 as i64)
    _rar_put_vint(mh, 0 as i64)
    _rar_put_vint(mh, 0 as i64)
    _rar_put_header(out, mh)
    compress.BufFree(mh)
    repeat files.len() in i:
        f := files.get(i)
        isdir := f.is_dir or (f.name.len() > 0 and (f.name as u8*)[f.name.len() - 1] as int == 47)
        mut nm := f.name
        mut nlen := nm.len()
        if isdir and nlen > 0 and (nm as u8*)[nlen - 1] as int == 47:
            nlen--
        end
        dlen := isdir ? 0 : f.data_len
        mut body := compress.NewByteBuf()
        _rar_put_vint(body, 2 as i64)
        _rar_put_vint(body, isdir ? 0 as i64 : 2 as i64)
        if not isdir:
            _rar_put_vint(body, dlen as i64)
        end
        mut ff := isdir ? 1 : 4
        if f.mtime > 0 and f.mtime < 4294967296:
            ff |= 2
        end
        _rar_put_vint(body, ff as i64)
        _rar_put_vint(body, dlen as i64)
        _rar_put_vint(body, isdir ? 0x41ed as i64 : 0x81a4 as i64)
        if (ff & 2) != 0:
            LEPut32(body, f.mtime as int)
        end
        if not isdir:
            LEPut32(body, _rar_crc(f.data_ptr, dlen) as int)
        end
        _rar_put_vint(body, 0 as i64)
        _rar_put_vint(body, 1 as i64)
        _rar_put_vint(body, nlen as i64)
        compress.BufPushBytes(body, nm as void*, nlen)
        _rar_put_header(out, body)
        compress.BufFree(body)
        if dlen > 0:
            compress.BufPushBytes(out, f.data_ptr, dlen)
        end
    end
    mut eh := compress.NewByteBuf()
    _rar_put_vint(eh, 5 as i64)
    _rar_put_vint(eh, 0 as i64)
    _rar_put_vint(eh, 0 as i64)
    _rar_put_header(out, eh)
    compress.BufFree(eh)
    ret out
end

@en "RarCreateFile"
@fa "ساخت پرونده آر ای آر"
pub func RarCreateFile(files: Vector<RarFileInput>, outpath: str): bool:
    mut out := RarCreate(files)
    ok := WriteBinaryFileBuf(outpath, out)
    compress.BufFree(out)
    ret ok
end
