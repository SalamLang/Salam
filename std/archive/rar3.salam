package archive

import mem
import compress

struct _R3:
    pub win: u8*
    pub wsize: int
end

func _r3_new(wsize: int): _R3:
    ret _R3 { win = mem.AllocateZeroed(wsize as u64) as u8*, wsize = wsize }
end

func _r3_free(d &: _R3):
    mem.Free(d.win as void*)
end

func _r3_setwin(_d &: _R3, wsize: int): bool:
    ret wsize > 0
end

func _r3_reset(d &: _R3):
    d.wsize = d.wsize
end

func _r3_decode(_d &: _R3, _p: u8*, _n: int, _unp: i64, _limit: i64, _out &: compress.ByteBuf): int:
    ret 2
end
