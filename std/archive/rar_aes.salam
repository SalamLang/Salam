]

struct _Aes:
    pub rk: u8*
    pub rounds: int
    pub m9: u8*
    pub m11: u8*
    pub m13: u8*
    pub m14: u8*
end

struct _Sha1:
    pub h: i64*
    pub buf: u8*
    pub blen: int
    pub total: i64
    pub w: i64*
end

func _aes_xtime(a: int): int:
    ret ((a << 1) ^ (a >= 128 ? 0x1b : 0)) & 255
end

func _aes_mul(a0: int, b0: int): int:
    mut a := a0
    mut b := b0
    mut r := 0
    until b > 0:
        if (b & 1) != 0:
            r = r ^ a
        end
        a = _aes_xtime(a)
        b = b >> 1
    end
    ret r
end

func _aes_new(key: u8*, klen: int): _Aes:
    mut a := _Aes {
        rk = mem.AllocateZeroed(256 as u64) as u8*
        rounds = (klen / 4) + 6
        m9 = mem.AllocateZeroed(256 as u64) as u8*
        m11 = mem.AllocateZeroed(256 as u64) as u8*
        m13 = mem.AllocateZeroed(256 as u64) as u8*
        m14 = mem.AllocateZeroed(256 as u64) as u8*
    }
    repeat 256 in i:
        a.m9[i] = _aes_mul(i, 9) as u8
        a.m11[i] = _aes_mul(i, 11) as u8
        a.m13[i] = _aes_mul(i, 13) as u8
        a.m14[i] = _aes_mul(i, 14) as u8
    end
    nk := klen / 4
    total := 4 * (a.rounds + 1)
    repeat klen in i:
        a.rk[i] = key[i]
    end
    mut rcon := 1
    mut i := nk
    until i < total:
        mut t0 := a.rk[(i - 1) * 4] as int
        mut t1 := a.rk[(i - 1) * 4 + 1] as int
        mut t2 := a.rk[(i - 1) * 4 + 2] as int
        mut t3 := a.rk[(i - 1) * 4 + 3] as int
        if i % nk == 0:
            u0 := t0
            t0 = _AES_SBOX[t1] ^ rcon
            t1 = _AES_SBOX[t2]
            t2 = _AES_SBOX[t3]
            t3 = _AES_SBOX[u0]
            rcon = _aes_xtime(rcon)
        else nk > 6 and i % nk == 4:
            t0 = _AES_SBOX[t0]
            t1 = _AES_SBOX[t1]
            t2 = _AES_SBOX[t2]
            t3 = _AES_SBOX[t3]
        end
        a.rk[i * 4] = ((a.rk[(i - nk) * 4] as int) ^ t0) as u8
        a.rk[i * 4 + 1] = ((a.rk[(i - nk) * 4 + 1] as int) ^ t1) as u8
        a.rk[i * 4 + 2] = ((a.rk[(i - nk) * 4 + 2] as int) ^ t2) as u8
        a.rk[i * 4 + 3] = ((a.rk[(i - nk) * 4 + 3] as int) ^ t3) as u8
        i++
    end
    ret a
end

func _aes_free(a &: _Aes):
    mem.Free(a.rk as void*)
    mem.Free(a.m9 as void*)
    mem.Free(a.m11 as void*)
    mem.Free(a.m13 as void*)
    mem.Free(a.m14 as void*)
end

func _aes_dec_block(a: _Aes, src: u8*, dst: u8*):
    mut s: int[16]
    mut t: int[16]
    repeat 16 in i:
        s[i] = (src[i] as int) ^ (a.rk[a.rounds * 16 + i] as int)
    end
    mut r := a.rounds - 1
    until r >= 0:
        repeat 4 in c:
            repeat 4 in row:
                t[4 * c + row] = _AES_ISBOX[s[4 * ((c - row + 4) & 3) + row]]
            end
        end
        repeat 16 in i:
            t[i] = t[i] ^ (a.rk[r * 16 + i] as int)
        end
        if r > 0:
            repeat 4 in c:
                a0 := t[4 * c]
                a1 := t[4 * c + 1]
                a2 := t[4 * c + 2]
                a3 := t[4 * c + 3]
                s[4 * c] = (a.m14[a0] as int) ^ (a.m11[a1] as int) ^ (a.m13[a2] as int) ^ (a.m9[a3] as int)
                s[4 * c + 1] = (a.m9[a0] as int) ^ (a.m14[a1] as int) ^ (a.m11[a2] as int) ^ (a.m13[a3] as int)
                s[4 * c + 2] = (a.m13[a0] as int) ^ (a.m9[a1] as int) ^ (a.m14[a2] as int) ^ (a.m11[a3] as int)
                s[4 * c + 3] = (a.m11[a0] as int) ^ (a.m13[a1] as int) ^ (a.m9[a2] as int) ^ (a.m14[a3] as int)
            end
        else:
            repeat 16 in i:
                dst[i] = t[i] as u8
            end
        end
        r--
    end
end

func _aes_cbc_decrypt(a: _Aes, iv: u8*, src: u8*, dst: u8*, n: int):
    mut prev: u8[16]
    mut cur: u8[16]
    repeat 16 in i:
        prev[i] = iv[i]
    end
    mut off := 0
    until off + 16 <= n:
        repeat 16 in i:
            cur[i] = src[off + i]
        end
        _aes_dec_block(a, _poff(src, off), _poff(dst, off))
        repeat 16 in i:
            dst[off + i] = ((dst[off + i] as int) ^ (prev[i] as int)) as u8
            prev[i] = cur[i]
        end
        off += 16
    end
end

func _sha1_new(): _Sha1:
    mut c := _Sha1 {
        h = mem.AllocateZeroed(40 as u64) as i64*
        buf = mem.AllocateZeroed(64 as u64) as u8*
        blen = 0
        total = 0 as i64
        w = mem.AllocateZeroed(640 as u64) as i64*
    }
    c.h[0] = 0x67452301
    c.h[1] = 0xEFCDAB89
    c.h[2] = 0x98BADCFE
    c.h[3] = 0x10325476
    c.h[4] = 0xC3D2E1F0
    ret c
end

func _sha1_free(c &: _Sha1):
    mem.Free(c.h as void*)
    mem.Free(c.buf as void*)
    mem.Free(c.w as void*)
end

func _sha1_copy(dst &: _Sha1, src: _Sha1):
    repeat 5 in i:
        dst.h[i] = src.h[i]
    end
    repeat 64 in i:
        dst.buf[i] = src.buf[i]
    end
    dst.blen = src.blen
    dst.total = src.total
end

func _sha1_rol(v: i64, n: int): i64:
    ret ((v << n) | (v >> (32 - n))) & 0xffffffff
end

func _sha1_block(c &: _Sha1, p: u8*):
    w := c.w
    repeat 16 in i:
        w[i] = ((p[i * 4] as i64) << 24) | ((p[i * 4 + 1] as i64) << 16) | ((p[i * 4 + 2] as i64) << 8) | (p[i * 4 + 3] as i64)
    end
    mut t := 16
    until t < 80:
        w[t] = _sha1_rol(w[t - 3] ^ w[t - 8] ^ w[t - 14] ^ w[t - 16], 1)
        t++
    end
    mut a := c.h[0]
    mut b := c.h[1]
    mut cc := c.h[2]
    mut d := c.h[3]
    mut e := c.h[4]
    repeat 80 in i:
        mut f := 0 as i64
        mut k := 0 as i64
        if i < 20:
            f = (b & cc) | ((~b) & d)
            k = 0x5A827999
        else i < 40:
            f = b ^ cc ^ d
            k = 0x6ED9EBA1
        else i < 60:
            f = (b & cc) | (b & d) | (cc & d)
            k = 0x8F1BBCDC
        else:
            f = b ^ cc ^ d
            k = 0xCA62C1D6
        end
        tmp := (_sha1_rol(a, 5) + (f & 0xffffffff) + e + k + w[i]) & 0xffffffff
        e = d
        d = cc
        cc = _sha1_rol(b, 30)
        b = a
        a = tmp
    end
    c.h[0] = (c.h[0] + a) & 0xffffffff
    c.h[1] = (c.h[1] + b) & 0xffffffff
    c.h[2] = (c.h[2] + cc) & 0xffffffff
    c.h[3] = (c.h[3] + d) & 0xffffffff
    c.h[4] = (c.h[4] + e) & 0xffffffff
end

func _sha1_update(c &: _Sha1, p: u8*, n: int):
    c.total += n as i64
    mut off := 0
    until off < n:
        c.buf[c.blen] = p[off]
        c.blen++
        off++
        if c.blen == 64:
            _sha1_block(c, c.buf)
            c.blen = 0
        end
    end
end

func _sha1_final(c &: _Sha1, out: i64*):
    bits := c.total * 8
    pad := mem.AllocateZeroed(72 as u64) as u8*
    pad[0] = 0x80 as u8
    mut padlen := 56 - c.blen
    if padlen <= 0:
        padlen += 64
    end
    repeat 8 in i:
        pad[padlen + i] = ((bits >> (56 - i * 8)) & 255) as u8
    end
    _sha1_update(c, pad, padlen + 8)
    mem.Free(pad as void*)
    repeat 5 in i:
        out[i] = c.h[i]
    end
end
