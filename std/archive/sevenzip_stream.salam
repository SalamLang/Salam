package archive

import compress
import mem

struct _SzAesR:
    pub inner: void*
    pub ioff: i64
    pub ileft: i64
    pub oleft: i64
    pub pos: i64
    pub aes: _Aes
    pub iv: u8*
    pub cbuf: u8*
    pub pbuf: u8*
    pub pstart: int
    pub pend: int
end

func _szaes_read(off: i64, dst: void*, n: int, ctx: void*): int:
    r := ctx as _SzAesR*
    if off != r[0].pos:
        ret 0
    end
    mut done := 0
    until done < n:
        if r[0].pstart == r[0].pend:
            if r[0].oleft <= (0 as i64) or r[0].ileft < (16 as i64):
                break
            end
            mut want := 65536
            if (want as i64) > r[0].ileft:
                want = (r[0].ileft as int) & (-16)
            end
            got := compress.FileReadAt(r[0].inner, r[0].ioff, r[0].cbuf as void*, want)
            g := got & (-16)
            if g < 16:
                break
            end
            _aes_cbc_decrypt(r[0].aes, r[0].iv, r[0].cbuf, r[0].pbuf, g)
            repeat 16 in q:
                r[0].iv[q] = r[0].cbuf[g - 16 + q]
            end
            r[0].ioff += g as i64
            r[0].ileft -= g as i64
            r[0].pstart = 0
            r[0].pend = g
            if (g as i64) > r[0].oleft:
                r[0].pend = r[0].oleft as int
            end
        end
        mut take := n - done
        if take > r[0].pend - r[0].pstart:
            take = r[0].pend - r[0].pstart
        end
        mem.Copy(((dst as i64) + (done as i64)) as void*, ((r[0].pbuf as i64) + (r[0].pstart as i64)) as void*, take as u64)
        r[0].pstart += take
        done += take
        r[0].pos += take as i64
        r[0].oleft -= take as i64
    end
    ret done
end

func _szaes_open(inner: void*, ioff: i64, ilen: i64, c: _SzCoder, osz: i64, password: str, status &: int): void*:
    key := mem.AllocateZeroed(32 as u64) as u8*
    iv := mem.AllocateZeroed(16 as u64) as u8*
    if not _sz_aes_setup(c, password, key, iv, status):
        mem.Free(key as void*)
        mem.Free(iv as void*)
        ret null
    end
    if osz < (0 as i64) or (ilen & ((-16) as i64)) < osz:
        status = SEVENZIP_CORRUPT
        mem.Free(key as void*)
        mem.Free(iv as void*)
        ret null
    end
    r := mem.AllocateZeroed(sizeof(_SzAesR)) as _SzAesR*
    r[0].inner = inner
    r[0].ioff = ioff
    r[0].ileft = ilen
    r[0].oleft = osz
    r[0].aes = _aes_new(key, 32)
    r[0].iv = iv
    r[0].cbuf = mem.Allocate(65536 as u64) as u8*
    r[0].pbuf = mem.Allocate(65536 as u64) as u8*
    mem.Free(key as void*)
    rd := (o: i64, d: void*, n: int, c: void*): ret _szaes_read(o, d, n, c) end
    ret compress.CallbackOpenRead(osz, rd, r as void*)
end

func _szaes_free(fp: void*):
    if fp == null:
        ret
    end
    r := compress.CallbackContext(fp) as _SzAesR*
    _aes_free(r[0].aes)
    mem.Free(r[0].iv as void*)
    mem.Free(r[0].cbuf as void*)
    mem.Free(r[0].pbuf as void*)
    mem.Free(r as void*)
    compress.FileClose(fp)
end

func _szf_ppmd(rfp: void*, roff: i64, rsz: i64, c: _SzCoder, out_size: i64, memcap: i64, sink &: compress.FileSink): int:
    pr := c.props
    if pr.len < 5 or rsz < (5 as i64) or out_size < (0 as i64):
        ret SEVENZIP_CORRUPT
    end
    pp := pr.data as u8*
    order := pp[0] as int
    msize := _sz_le32(pp, 1)
    if order < 2 or order > 64 or msize < (2048 as i64):
        ret SEVENZIP_UNSUPPORTED
    end
    if msize > (2147483000 as i64) or (memcap > (0 as i64) and msize > memcap):
        ret SEVENZIP_TOO_BIG
    end
    mut m := _pp_new()
    m.rc7z = true
    if not _pp_alloc(m, msize as int):
        _pp_free(m)
        ret SEVENZIP_TOO_BIG
    end
    _pp_init(m, order)
    ib := mem.Allocate(65536 as u64) as u8*
    ob := mem.Allocate(65536 as u64) as u8*
    mut left := rsz
    mut at := roff
    mut want := 65536
    if (want as i64) > left:
        want = left as int
    end
    got := compress.FileReadAt(rfp, at, ib as void*, want)
    mut st := SEVENZIP_OK
    if got != want:
        st = SEVENZIP_IO
    end
    left -= got as i64
    at += got as i64
    mut b := _RarBits { p = ib, n = got, pos = 0 }
    if st == SEVENZIP_OK:
        if _pp_byte(b) != (0 as i64):
            st = SEVENZIP_CORRUPT
        else:
            _pp_rc_init(m, b)
        end
    end
    mut produced := 0 as i64
    mut fill := 0
    until st == SEVENZIP_OK and produced < out_size:
        byte := b.pos >> 3
        if b.n - byte < 32 and left > (0 as i64):
            keep := b.n - byte
            if keep > 0:
                mem.MemMove(ib as void*, ((ib as i64) + (byte as i64)) as void*, keep as u64)
            end
            mut room := 65536 - keep
            if (room as i64) > left:
                room = left as int
            end
            more := compress.FileReadAt(rfp, at, ((ib as i64) + (keep as i64)) as void*, room)
            if more != room:
                st = SEVENZIP_IO
                break
            end
            left -= more as i64
            at += more as i64
            b.n = keep + more
            b.pos = 0
        end
        sym := _pp_decode(m, b)
        if sym < 0:
            st = SEVENZIP_CORRUPT
            break
        end
        ob[fill] = sym as u8
        fill++
        produced++
        if fill == 65536:
            if not compress.SinkWrite(sink, ob as void*, fill):
                st = SEVENZIP_IO
                break
            end
            fill = 0
        end
    end
    if st == SEVENZIP_OK and fill > 0:
        if not compress.SinkWrite(sink, ob as void*, fill):
            st = SEVENZIP_IO
        end
    end
    mem.Free(ib as void*)
    mem.Free(ob as void*)
    _pp_free(m)
    ret st
end
