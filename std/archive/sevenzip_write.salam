package archive

import compress
import mem
import os

struct _SzOut:
    pub fp: void*
    pub buf: compress.ByteBuf
    pub to_file: bool
    pub pos: i64
    pub failed: bool
end

@en "SevenZipFileInput"
@fa "ورودی پرونده هفت زد"
pub struct SevenZipFileInput:
    @en "name"
    @fa "نام"
    pub name: str = ""
    @en "data_ptr"
    @fa "نشانی داده"
    pub data_ptr: void* = null
    @en "data_len"
    @fa "طول داده"
    pub data_len: int = 0
    @en "is_dir"
    @fa "پوشه"
    pub is_dir: bool = false
    @en "mtime"
    @fa "زمان تغییر"
    pub mtime: i64 = 0 as i64
    @en "mode"
    @fa "دسترسی"
    pub mode: int = 0
    @en "link"
    @fa "پیوند"
    pub link: str = ""
    @en "path"
    @fa "مسیر منبع"
    pub path: str = ""
end

func _szw_num(b &: compress.ByteBuf, v: i64):
    if v >= (0 as i64) and v < (128 as i64):
        compress.BufPush(b, v as int)
        ret
    end
    compress.BufPush(b, 255)
    repeat 8 in i:
        compress.BufPush(b, ((v >> (8 * i)) & 255) as int)
    end
end

func _szw_u32(b &: compress.ByteBuf, v: i64):
    repeat 4 in i:
        compress.BufPush(b, ((v >> (8 * i)) & 255) as int)
    end
end

func _szw_bits(b &: compress.ByteBuf, bits: Vector<bool>):
    mut cur := 0
    mut n := 0
    repeat bits.Len() in i:
        cur <<= 1
        if bits.get(i):
            cur |= 1
        end
        n++
        if n == 8:
            compress.BufPush(b, cur)
            cur = 0
            n = 0
        end
    end
    if n > 0:
        compress.BufPush(b, cur << (8 - n))
    end
end

func _szw_name(b &: compress.ByteBuf, name: str):
    p := name as u8*
    mut n := name.Len()
    until n > 1 and ((p[n - 1] as int) == 47 or (p[n - 1] as int) == 92):
        n--
    end
    mut i := 0
    until i < n:
        c := p[i] as int
        mut cp := c
        mut extra := 0
        if c >= 240:
            cp = c & 7
            extra = 3
        else c >= 224:
            cp = c & 15
            extra = 2
        else c >= 192:
            cp = c & 31
            extra = 1
        end
        i++
        repeat extra:
            if i < n:
                cp = (cp << 6) | ((p[i] as int) & 63)
                i++
            end
        end
        if cp == 92:
            cp = 47
        end
        if cp >= 65536:
            v := cp - 65536
            u1 := 55296 + (v >> 10)
            u2 := 56320 + (v & 1023)
            compress.BufPush(b, u1 & 255)
            compress.BufPush(b, u1 >> 8)
            compress.BufPush(b, u2 & 255)
            compress.BufPush(b, u2 >> 8)
        else:
            compress.BufPush(b, cp & 255)
            compress.BufPush(b, cp >> 8)
        end
    end
    compress.BufPush(b, 0)
    compress.BufPush(b, 0)
end

func _szw_wrap(h: compress.ByteBuf, id: int): compress.ByteBuf:
    mut out := compress.NewByteBuf()
    compress.BufPush(out, id)
    _szw_num(out, h.len as i64)
    compress.BufPushBuf(out, h)
    ret out
end

func _szo_write(o &: _SzOut, p: void*, n: int):
    if o.failed or n <= 0:
        ret
    end
    if o.to_file:
        if (fwrite(p, 1 as u64, n as u64, o.fp) as int) != n:
            o.failed = true
            ret
        end
    else:
        compress.BufPushBytes(o.buf, p, n)
    end
    o.pos += n as i64
end

func _szw_entry_size(f: SevenZipFileInput): i64:
    if f.link.Len() > 0:
        ret f.link.Len()
    end
    if f.path.Len() > 0:
        fp := compress.FileOpenRead(f.path)
        if fp == null:
            ret -1
        end
        n := compress.FileSize(fp)
        compress.FileClose(fp)
        ret n
    end
    ret f.data_len
end

func _szw_plan(files: Vector<SevenZipFileInput>, empty &: Vector<bool>, empty_file &: Vector<bool>, nstream &: int, total &: i64, any_mtime &: bool): bool:
    repeat files.Len() in i:
        f := files.get(i)
        if f.data_len < 0 or f.name.Len() == 0 or f.name.Len() > 65535 or (f.path.Len() == 0 and f.data_len > 0 and f.data_ptr == null):
            ret false
        end
        size := f.is_dir ? (0 as i64) : _szw_entry_size(f)
        if size < (0 as i64):
            ret false
        end
        is_empty := f.is_dir or size == (0 as i64)
        empty.push(is_empty)
        if is_empty:
            empty_file.push(not f.is_dir)
        else:
            nstream++
            total += size
        end
        if f.mtime > (0 as i64):
            any_mtime = true
        end
    end
    ret true
end

func _szw_pack_copy(files: Vector<SevenZipFileInput>, empty: Vector<bool>, o &: _SzOut, sizes &: Vector<i64>, crcs &: Vector<i64>, scratch: void*): bool:
    mut ok := true
    mut i := 0
    until i < files.Len() and ok:
        f := files.get(i)
        if empty.get(i):
            i++
            continue
        end
        if f.link.Len() > 0:
            _szo_write(o, f.link as void*, f.link.Len())
            sizes.push(f.link.Len() as i64)
            crcs.push(compress.CRC32(f.link as void*, f.link.Len()) as i64)
        else f.path.Len() > 0:
            src := compress.FileOpenRead(f.path)
            if src == null:
                ok = false
            else:
                size := compress.FileSize(src)
                mut crc := 0 as u32
                mut at := 0 as i64
                until at < size and ok:
                    mut want := 262144
                    if size - at < (want as i64):
                        want = (size - at) as int
                    end
                    got := compress.FileReadAt(src, at, scratch, want)
                    if got != want:
                        ok = false
                    else:
                        crc = compress.CRC32Update(crc, scratch, got)
                        _szo_write(o, scratch, got)
                        at += got as i64
                    end
                end
                compress.FileClose(src)
                sizes.push(size)
                crcs.push(crc as i64)
            end
        else:
            _szo_write(o, f.data_ptr, f.data_len)
            sizes.push(f.data_len as i64)
            crcs.push(compress.CRC32(f.data_ptr, f.data_len) as i64)
        end
        i++
    end
    ret ok and not o.failed
end

func _szw_pack_lzma(files: Vector<SevenZipFileInput>, empty: Vector<bool>, level: int, o &: _SzOut, sizes &: Vector<i64>, crcs &: Vector<i64>, packed &: Vector<i64>, props &: compress.ByteBuf): bool:
    mut ok := true
    mut i := 0
    until i < files.Len() and ok:
        f := files.get(i)
        if empty.get(i):
            i++
            continue
        end
        mut data := compress.NewByteBuf()
        mut ptr := f.data_ptr
        mut len := f.data_len
        if f.link.Len() > 0:
            ptr = f.link as void*
            len = f.link.Len()
        else f.path.Len() > 0:
            mut rok := false
            data = ReadBinaryFile(f.path, rok)
            if not rok:
                ok = false
            end
            ptr = data.data
            len = data.len
        end
        if ok:
            mut comp := compress.LzmaCompressLevel(ptr, len, level)
            compress.BufPushBytes(props, comp.data, 5)
            body := ((comp.data as i64) + (13 as i64)) as void*
            _szo_write(o, body, comp.len - 13)
            packed.push((comp.len - 13) as i64)
            sizes.push(len as i64)
            crcs.push(compress.CRC32(ptr, len) as i64)
            compress.BufFree(comp)
        end
        compress.BufFree(data)
        i++
    end
    ret ok and not o.failed
end

func _szw_header(files: Vector<SevenZipFileInput>, empty: Vector<bool>, empty_file: Vector<bool>, nstream: int, total: i64, any_mtime: bool, lzma: bool, sizes: Vector<i64>, crcs: Vector<i64>, packed: Vector<i64>, props: compress.ByteBuf): compress.ByteBuf:
    n := files.Len()
    mut h := compress.NewByteBuf()
    compress.BufPush(h, 1)
    if nstream > 0:
        compress.BufPush(h, 4)
        compress.BufPush(h, 6)
        _szw_num(h, 0 as i64)
        mut nfold := 1
        if lzma:
            nfold = nstream
        end
        _szw_num(h, nfold as i64)
        compress.BufPush(h, 9)
        if lzma:
            repeat nfold in k:
                _szw_num(h, packed.get(k))
            end
        else:
            _szw_num(h, total)
        end
        compress.BufPush(h, 0)
        compress.BufPush(h, 7)
        compress.BufPush(h, 11)
        _szw_num(h, nfold as i64)
        compress.BufPush(h, 0)
        repeat nfold in k:
            _szw_num(h, 1 as i64)
            if lzma:
                compress.BufPush(h, 0x23)
                compress.BufPush(h, 3)
                compress.BufPush(h, 1)
                compress.BufPush(h, 1)
                _szw_num(h, 5 as i64)
                repeat 5 in q:
                    compress.BufPush(h, compress.BufGet(props, k * 5 + q))
                end
            else:
                compress.BufPush(h, 1)
                compress.BufPush(h, 0)
            end
        end
        compress.BufPush(h, 12)
        if lzma:
            repeat nfold in k:
                _szw_num(h, sizes.get(k))
            end
        else:
            _szw_num(h, total)
        end
        compress.BufPush(h, 0)
        compress.BufPush(h, 8)
        if not lzma:
            compress.BufPush(h, 13)
            _szw_num(h, nstream as i64)
            if nstream > 1:
                compress.BufPush(h, 9)
                repeat nstream - 1 in k:
                    _szw_num(h, sizes.get(k))
                end
            end
        end
        compress.BufPush(h, 10)
        compress.BufPush(h, 1)
        repeat nstream in k:
            _szw_u32(h, crcs.get(k))
        end
        compress.BufPush(h, 0)
        compress.BufPush(h, 0)
    end
    if n > 0:
        compress.BufPush(h, 5)
        _szw_num(h, n as i64)
        if n > nstream:
            mut t := compress.NewByteBuf()
            _szw_bits(t, empty)
            mut w := _szw_wrap(t, 14)
            compress.BufPushBuf(h, w)
            compress.BufFree(w)
            compress.BufFree(t)
            mut any_ef := false
            repeat empty_file.Len() in i:
                if empty_file.get(i):
                    any_ef = true
                end
            end
            if any_ef:
                mut t2 := compress.NewByteBuf()
                _szw_bits(t2, empty_file)
                mut w2 := _szw_wrap(t2, 15)
                compress.BufPushBuf(h, w2)
                compress.BufFree(w2)
                compress.BufFree(t2)
            end
        end
        mut nm := compress.NewByteBuf()
        compress.BufPush(nm, 0)
        repeat n in i:
            _szw_name(nm, files.get(i).name)
        end
        mut wn := _szw_wrap(nm, 17)
        compress.BufPushBuf(h, wn)
        compress.BufFree(wn)
        compress.BufFree(nm)
        if any_mtime:
            mut mt := compress.NewByteBuf()
            mut defined := Vector {} as Vector<bool>
            mut all_def := true
            repeat n in i:
                has := files.get(i).mtime > (0 as i64)
                defined.push(has)
                if not has:
                    all_def = false
                end
            end
            if all_def:
                compress.BufPush(mt, 1)
            else:
                compress.BufPush(mt, 0)
                _szw_bits(mt, defined)
            end
            compress.BufPush(mt, 0)
            repeat n in i:
                if defined.get(i):
                    ft := (files.get(i).mtime + (11644473600 as i64)) * (10000000 as i64)
                    repeat 8 in q:
                        compress.BufPush(mt, ((ft >> (8 * q)) & 255) as int)
                    end
                end
            end
            defined.free()
            mut wm := _szw_wrap(mt, 20)
            compress.BufPushBuf(h, wm)
            compress.BufFree(wm)
            compress.BufFree(mt)
        end
        mut at := compress.NewByteBuf()
        compress.BufPush(at, 1)
        compress.BufPush(at, 0)
        repeat n in i:
            f := files.get(i)
            mut attr := f.is_dir ? (16 as i64) : (32 as i64)
            if f.mode > 0 or f.link.Len() > 0:
                mut m := f.mode & 4095
                if f.link.Len() > 0:
                    m = 0xA000 | (f.mode > 0 ? (f.mode & 4095) : 511)
                else:
                    m |= f.is_dir ? 0x4000 : 0x8000
                end
                attr |= (32768 as i64) | ((m as i64) << 16)
            end
            _szw_u32(at, attr)
        end
        mut wa := _szw_wrap(at, 21)
        compress.BufPushBuf(h, wa)
        compress.BufFree(wa)
        compress.BufFree(at)
        compress.BufPush(h, 0)
    end
    compress.BufPush(h, 0)
    ret h
end

func _szw_run(files: Vector<SevenZipFileInput>, level: int, o &: _SzOut): bool:
    mut empty := Vector {} as Vector<bool>
    mut empty_file := Vector {} as Vector<bool>
    mut nstream := 0
    mut total := 0 as i64
    mut any_mtime := false
    if not _szw_plan(files, empty, empty_file, nstream, total, any_mtime):
        empty.free()
        empty_file.free()
        ret false
    end
    if not o.to_file and total > (1900000000 as i64):
        empty.free()
        empty_file.free()
        ret false
    end
    mut zeros := compress.NewByteBuf()
    repeat 32:
        compress.BufPush(zeros, 0)
    end
    _szo_write(o, zeros.data, 32)
    compress.BufFree(zeros)
    mut sizes := Vector {} as Vector<i64>
    mut crcs := Vector {} as Vector<i64>
    mut packed := Vector {} as Vector<i64>
    mut props := compress.NewByteBuf()
    lzma := level > 0
    mut ok := true
    if nstream > 0:
        if lzma:
            ok = _szw_pack_lzma(files, empty, level > 9 ? 9 : level, o, sizes, crcs, packed, props)
        else:
            scratch := mem.Allocate(262144 as u64)
            ok = _szw_pack_copy(files, empty, o, sizes, crcs, scratch)
            mem.Free(scratch)
        end
    end
    if ok:
        mut h := _szw_header(files, empty, empty_file, nstream, total, any_mtime, lzma, sizes, crcs, packed, props)
        hdr_off := o.pos - (32 as i64)
        hlen := h.len as i64
        _szo_write(o, h.data, h.len)
        hcrc := compress.CRC32(h.data, h.len)
        compress.BufFree(h)
        mut sh := compress.NewByteBuf()
        repeat 8 in i:
            compress.BufPush(sh, ((hdr_off >> (8 * i)) & 255) as int)
        end
        repeat 8 in i:
            compress.BufPush(sh, ((hlen >> (8 * i)) & 255) as int)
        end
        _szw_u32(sh, hcrc as i64)
        scrc := compress.CRC32(sh.data, sh.len) as i64
        mut start := compress.NewByteBuf()
        sig := [55, 122, 188, 175, 39, 28, 0, 4]
        repeat 8 in i:
            compress.BufPush(start, sig[i])
        end
        _szw_u32(start, scrc)
        compress.BufPushBuf(start, sh)
        compress.BufFree(sh)
        if o.to_file:
            if o.failed or fseek(o.fp, 0, 0) != 0:
                ok = false
            else:
                ok = (fwrite(start.data, 1 as u64, 32 as u64, o.fp) as int) == 32
            end
        else:
            mem.Copy(o.buf.data, start.data, 32 as u64)
        end
        compress.BufFree(start)
    end
    sizes.free()
    crcs.free()
    packed.free()
    compress.BufFree(props)
    empty.free()
    empty_file.free()
    ret ok and not o.failed
end

@en "MakeSevenZipFileInput"
@fa "ساخت ورودی پرونده هفت زد"
pub func MakeSevenZipFileInput(name: str, data_ptr: void*, data_len: int, is_dir: bool): SevenZipFileInput:
    ret SevenZipFileInput { name = name, data_ptr = data_ptr, data_len = data_len, is_dir = is_dir }
end

@en "MakeSevenZipFilePath"
@fa "ساخت ورودی پرونده هفت زد از مسیر"
pub func MakeSevenZipFilePath(name: str, path: str): SevenZipFileInput:
    ret SevenZipFileInput { name = name, path = path }
end

@en "SevenZipCreateLevel"
@fa "ساخت هفت زد با سطح"
pub func SevenZipCreateLevel(files: Vector<SevenZipFileInput>, level: int): compress.ByteBuf:
    mut o := _SzOut { fp = null, buf = compress.NewByteBuf(), to_file = false, pos = 0 as i64, failed = false }
    if not _szw_run(files, level, o):
        compress.BufFree(o.buf)
        ret compress.NewByteBuf()
    end
    ret o.buf
end

@en "SevenZipCreate"
@fa "ساخت هفت زد"
pub func SevenZipCreate(files: Vector<SevenZipFileInput>): compress.ByteBuf:
    ret SevenZipCreateLevel(files, 0)
end

@en "SevenZipCreateFileLevel"
@fa "ساخت پرونده هفت زد با سطح"
pub func SevenZipCreateFileLevel(files: Vector<SevenZipFileInput>, path: str, level: int): bool:
    fp := compress.FileOpenWrite(path)
    if fp == null:
        ret false
    end
    mut o := _SzOut { fp = fp, buf = compress.NewByteBuf(), to_file = true, pos = 0 as i64, failed = false }
    ok := _szw_run(files, level, o)
    compress.BufFree(o.buf)
    closed := fclose(fp) == 0
    if not (ok and closed):
        os.Remove(path)
        ret false
    end
    ret true
end

@en "SevenZipCreateFile"
@fa "ساخت پرونده هفت زد"
pub func SevenZipCreateFile(files: Vector<SevenZipFileInput>, path: str): bool:
    ret SevenZipCreateFileLevel(files, path, 0)
end
