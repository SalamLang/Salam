package archive

import compress
import mem
import filepath
import os
import fs

if not SALAM_OS_WINDOWS:
    extern:
        func symlink(target: str, path: str): int
        func link(existing: str, path: str): int
        func utimes(path: str, tv: void*): int
        func readlink(path: str, buf: void*, sz: usize): int
    end
end

@en "TAR_OK"
@fa "تار موفق"
pub const TAR_OK := 0
@en "TAR_NOT_FOUND"
@fa "تار یافت نشد"
pub const TAR_NOT_FOUND := 1
@en "TAR_CORRUPT"
@fa "تار خراب"
pub const TAR_CORRUPT := 4
@en "TAR_TOO_BIG"
@fa "تار بیش از حد بزرگ"
pub const TAR_TOO_BIG := 6
@en "TAR_IO"
@fa "تار خطای ورودی خروجی"
pub const TAR_IO := 7
@en "TAR_UNSAFE_PATH"
@fa "تار مسیر ناامن"
pub const TAR_UNSAFE_PATH := 8

const _TAR_GZ_DEFAULT_MAX := 1073741824
const _TAR_OCTAL_LIMIT := 8589934592

@en "TarFileInput"
@fa "ورودی پرونده تار"
pub struct TarFileInput:
    @en "name"
    @fa "نام"
    pub name: str = ""
    @en "data_ptr"
    @fa "نشانی داده"
    pub data_ptr: void* = null
    @en "data_len"
    @fa "طول داده"
    pub data_len: int = 0
    @en "is_dir"
    @fa "پوشه"
    pub is_dir: bool = false
    @en "mode"
    @fa "دسترسی"
    pub mode: int = 0
    @en "mtime"
    @fa "زمان تغییر"
    pub mtime: i64 = 0 as i64
    @en "link"
    @fa "پیوند"
    pub link: str = ""
    @en "kind"
    @fa "نوع"
    pub kind: int = 0
    @en "path"
    @fa "مسیر منبع"
    pub path: str = ""
end

struct _TarPax:
    pub path: str = ""
    pub linkpath: str = ""
    pub size: i64 = -1 as i64
    pub mtime: i64 = 0 as i64
    pub has_mtime: bool = false
end

struct _TarVirt:
    pub files: Vector<TarFileInput>
    pub n: int
    pub starts: i64*
    pub sizes: i64*
    pub hlens: int*
    pub total: i64
    pub hcur: int
    pub hbuf: compress.ByteBuf
    pub last: int
    pub scur: int
    pub src: void*
end

func _tar_put_octal(b &: compress.ByteBuf, value: i64, width: int):
    ndigits := width - 1
    mut digits: int[16]
    mut v := value
    mut i := ndigits - 1
    until i >= 0:
        digits[i] = (v % (8 as i64)) as int
        v /= (8 as i64)
        i--
    end
    mut k := 0
    until k < ndigits:
        compress.BufPush(b, 48 + digits[k])
        k++
    end
    compress.BufPush(b, 0)
end

func _tar_get_num(p: void*, off: int, width: int): i64:
    bp := p as u8*
    mut v := 0 as i64
    mut i := 0
    if ((bp[off] as int) & 128) != 0:
        v = ((bp[off] as int) & 127) as i64
        i = 1
        until i < width:
            v = v * (256 as i64) + ((bp[off + i] as int) as i64)
            i++
        end
        ret v
    end
    until i < width:
        c := bp[off + i] as int
        if c >= 48 and c <= 55:
            v = v * (8 as i64) + ((c - 48) as i64)
        end
        i++
    end
    ret v
end

func _tar_dec(s: str): i64:
    bp := s as u8*
    n := s.len()
    mut i := 0
    mut neg := false
    if n > 0 and (bp[0] as int) == 45:
        neg = true
        i = 1
    end
    mut v := 0 as i64
    until i < n and (bp[i] as int) >= 48 and (bp[i] as int) <= 57 and v < (100000000000000000 as i64):
        v = v * (10 as i64) + (((bp[i] as int) - 48) as i64)
        i++
    end
    if neg: ret (0 as i64) - v end
    ret v
end

func _tar_put_str(b &: compress.ByteBuf, s: str, width: int):
    n := s.len()
    mut w := n
    if w > width: w = width end
    compress.BufPushBytes(b, s as void*, w)
    mut pad := width - w
    until pad > 0:
        compress.BufPush(b, 0)
        pad--
    end
end

func _tar_get_str(p: void*, off: int, width: int): str:
    bp := p as u8*
    mut len := 0
    until len < width and (bp[off + len] as int) != 0:
        len++
    end
    mut buf := compress.NewByteBuf()
    compress.BufPushBytes(buf, ((p as i64) + (off as i64)) as void*, len)
    s := compress.BufToStrUnsafe(buf)
    compress.BufFree(buf)
    ret s
end

func _tar_free_str(name: str):
    if name.len() > 0: mem.Free(name as void*) end
end

func _tar_drop(s &: str):
    if s.len() > 0: mem.Free(s as void*) end
    s = ""
end

func _tar_take(s &: str): str:
    v := s
    s = ""
    ret v
end

func _tar_px_free(px &: _TarPax):
    _tar_drop(px.path)
    _tar_drop(px.linkpath)
end

func _tar_checksum(header: void*): int:
    bp := header as u8*
    mut sum := 0
    mut i := 0
    until i < 512:
        if i >= 148 and i < 156:
            sum += 32
        else:
            sum += bp[i] as int
        end
        i++
    end
    ret sum
end

func _tar_is_zero_block(p: void*, pos: int): bool:
    bp := p as u8*
    mut i := 0
    until i < 512:
        if (bp[pos + i] as int) != 0:
            ret false
        end
        i++
    end
    ret true
end

func _tar_digits(v: int): int:
    mut d := 1
    mut x := v
    until x >= 10:
        x /= 10
        d++
    end
    ret d
end

func _tar_push_dec(b &: compress.ByteBuf, v: int):
    mut digits: int[12]
    mut x := v
    mut n := 0
    until true:
        digits[n] = x % 10
        x /= 10
        n++
        if x == 0: break end
    end
    mut i := n - 1
    until i >= 0:
        compress.BufPush(b, 48 + digits[i])
        i--
    end
end

func _tar_pax_rec(b &: compress.ByteBuf, key: str, val: str):
    l := key.len() + val.len() + 3
    mut tot := l + _tar_digits(l)
    tot = l + _tar_digits(tot)
    _tar_push_dec(b, tot)
    compress.BufPush(b, 32)
    compress.BufPushBytes(b, key as void*, key.len())
    compress.BufPush(b, 61)
    compress.BufPushBytes(b, val as void*, val.len())
    compress.BufPush(b, 10)
end

func _tar_pad(out &: compress.ByteBuf, n: int):
    pad := n % 512
    if pad > 0:
        mut k := 0
        until k < 512 - pad:
            compress.BufPush(out, 0)
            k++
        end
    end
end

func _tar_raw_header(out &: compress.ByteBuf, name: str, prefix: str, mode: i64, size: i64, mtime: i64, typeflag: int, target: str):
    mut h := compress.NewByteBuf()
    _tar_put_str(h, name, 100)
    _tar_put_octal(h, mode, 8)
    _tar_put_octal(h, 0 as i64, 8)
    _tar_put_octal(h, 0 as i64, 8)
    _tar_put_octal(h, size, 12)
    _tar_put_octal(h, mtime, 12)
    repeat 8: compress.BufPush(h, 32) end
    compress.BufPush(h, typeflag)
    _tar_put_str(h, target, 100)
    _tar_put_str(h, "ustar", 6)
    compress.BufPush(h, 48)
    compress.BufPush(h, 48)
    _tar_put_str(h, "", 32)
    _tar_put_str(h, "", 32)
    _tar_put_octal(h, 0 as i64, 8)
    _tar_put_octal(h, 0 as i64, 8)
    _tar_put_str(h, prefix, 155)
    repeat 12: compress.BufPush(h, 0) end

    sum := _tar_checksum(h.data)
    mut tmp := compress.NewByteBuf()
    _tar_put_octal(tmp, sum as i64, 7)
    mut k := 0
    until k < 6:
        compress.BufSet(h, 148 + k, compress.BufGet(tmp, k))
        k++
    end
    compress.BufSet(h, 148 + 6, 0)
    compress.BufSet(h, 148 + 7, 32)
    compress.BufFree(tmp)

    compress.BufPushBuf(out, h)
    compress.BufFree(h)
end

func _tar_prefix_cut(name: str): int:
    n := name.len()
    if n <= 100: ret 0 - 1 end
    bp := name as u8*
    mut i := 1
    until i < n - 1 and i <= 155:
        if (bp[i] as int) == 47 and n - i - 1 <= 100:
            ret i
        end
        i++
    end
    ret 0 - 2
end

func _tar_input_kind(f: TarFileInput): int:
    if f.is_dir: ret 1 end
    ret f.kind
end

func _tar_write_header(out &: compress.ByteBuf, f: TarFileInput, fsize: i64):
    kind := _tar_input_kind(f)
    mut pax := compress.NewByteBuf()
    mut name_part := f.name
    mut prefix := ""
    mut split := false
    cut := _tar_prefix_cut(f.name)
    if cut == 0 - 2:
        _tar_pax_rec(pax, "path", f.name)
    else cut > 0:
        prefix = f.name.substr(0, cut)
        name_part = f.name.substr(cut + 1, f.name.len() - cut - 1)
        split = true
    end
    mut target := f.link
    if kind != 2 and kind != 3: target = "" end
    if target.len() > 100:
        _tar_pax_rec(pax, "linkpath", target)
    end
    mut mtime := f.mtime
    if mtime < (0 as i64) or mtime >= _TAR_OCTAL_LIMIT:
        mut digits := compress.NewByteBuf()
        mut mv := mtime
        if mv < (0 as i64):
            compress.BufPush(digits, 45)
            mv = (0 as i64) - mv
        end
        mut tmp: int[24]
        mut tn := 0
        until true:
            tmp[tn] = (mv % (10 as i64)) as int
            mv /= (10 as i64)
            tn++
            if mv == (0 as i64): break end
        end
        mut ti := tn - 1
        until ti >= 0:
            compress.BufPush(digits, 48 + tmp[ti])
            ti--
        end
        ms := compress.BufToStrUnsafe(digits)
        compress.BufFree(digits)
        _tar_pax_rec(pax, "mtime", ms)
        _tar_free_str(ms)
        mtime = 0 as i64
    end
    mut hdr_size := fsize
    if kind == 0 and fsize >= _TAR_OCTAL_LIMIT:
        mut sd := compress.NewByteBuf()
        mut sv := fsize
        mut stmp: int[24]
        mut sn := 0
        until sv == (0 as i64):
            stmp[sn] = (sv % (10 as i64)) as int
            sv /= (10 as i64)
            sn++
        end
        mut si := sn - 1
        until si >= 0:
            compress.BufPush(sd, 48 + stmp[si])
            si--
        end
        sstr := compress.BufToStrUnsafe(sd)
        compress.BufFree(sd)
        _tar_pax_rec(pax, "size", sstr)
        _tar_free_str(sstr)
        hdr_size = 0 as i64
    end
    if pax.len > 0:
        _tar_raw_header(out, "PaxHeaders/entry", "", 0o644 as i64, pax.len as i64, 0 as i64, 120, "")
        compress.BufPushBuf(out, pax)
        _tar_pad(out, pax.len)
    end
    compress.BufFree(pax)

    mut file_mode := f.mode as i64
    if file_mode == 0:
        if kind == 1:
            file_mode = 0o755 as i64
        else kind == 2:
            file_mode = 0o777 as i64
        else:
            file_mode = 0o644 as i64
        end
    end
    mut sz := 0 as i64
    mut typeflag := 48
    if kind == 0:
        sz = hdr_size
    else kind == 1:
        typeflag = 53
    else kind == 2:
        typeflag = 50
    else kind == 3:
        typeflag = 49
    end
    _tar_raw_header(out, name_part, prefix, file_mode, sz, mtime, typeflag, target)
    if split:
        _tar_free_str(prefix)
        _tar_free_str(name_part)
    end
end

func _tar_pax_read(p: void*, off: int, size: int, px &: _TarPax):
    bp := p as u8*
    mut pos := 0
    until pos < size:
        mut sp := pos
        until sp < size and (bp[off + sp] as int) != 32:
            sp++
        end
        mut rec_len := 0
        mut d := pos
        until d < sp and rec_len < size:
            c := bp[off + d] as int
            if c < 48 or c > 57:
                ret
            end
            rec_len = rec_len * 10 + (c - 48)
            d++
        end
        if rec_len <= sp - pos + 2 or pos + rec_len > size:
            ret
        end
        bstart := off + sp + 1
        blen := rec_len - (sp - pos) - 2
        mut kq := 0
        until kq < blen and (bp[bstart + kq] as int) != 61:
            kq++
        end
        if kq < blen:
            key := _tar_get_str(p, bstart, kq)
            val := _tar_get_str(p, bstart + kq + 1, blen - kq - 1)
            if key == "path" and val.len() > 0:
                _tar_drop(px.path)
                px.path = val
            else key == "linkpath" and val.len() > 0:
                _tar_drop(px.linkpath)
                px.linkpath = val
            else:
                if key == "size":
                    px.size = _tar_dec(val)
                else key == "mtime":
                    px.mtime = _tar_dec(val)
                    px.has_mtime = true
                end
                _tar_free_str(val)
            end
            _tar_free_str(key)
        end
        pos += rec_len
    end
end

func _tar_next(p: void*, n: int, pos &: int, e &: Entry, data &: int, g &: _TarPax, limit: i64): bool:
    mut px := _TarPax {}
    mut lname := ""
    mut llink := ""
    bp := p as u8*
    until pos + 512 <= n:
        if _tar_is_zero_block(p, pos):
            break
        end
        typeflag := bp[pos + 156] as int
        mut size := _tar_get_num(p, pos + 124, 12)
        dstart := pos + 512
        if typeflag == 103 or typeflag == 120 or typeflag == 76 or typeflag == 75:
            if size < (0 as i64) or (dstart as i64) + size > (n as i64):
                break
            end
            span := (((size as int) + 511) / 512) * 512
            if typeflag == 120:
                _tar_pax_read(p, dstart, size as int, px)
            else typeflag == 103:
                _tar_pax_read(p, dstart, size as int, g)
                _tar_px_free(g)
            else typeflag == 76:
                _tar_drop(lname)
                lname = _tar_get_str(p, dstart, size as int)
            else:
                _tar_drop(llink)
                llink = _tar_get_str(p, dstart, size as int)
            end
            pos = dstart + span
            continue
        end
        mut nm := _tar_get_str(p, pos, 100)
        if px.path.len() > 0:
            _tar_free_str(nm)
            _tar_drop(lname)
            nm = _tar_take(px.path)
        else lname.len() > 0:
            _tar_free_str(nm)
            nm = _tar_take(lname)
        else:
            magic := _tar_get_str(p, pos + 257, 6)
            is_ustar := magic == "ustar"
            _tar_free_str(magic)
            if is_ustar:
                prefix := _tar_get_str(p, pos + 345, 155)
                if prefix.len() > 0:
                    full := prefix + "/" + nm
                    _tar_free_str(nm)
                    nm = full
                end
                _tar_free_str(prefix)
            end
        end
        if nm.len() == 0:
            break
        end
        if px.size >= (0 as i64): size = px.size end
        mut kind := 0
        if typeflag == 53:
            kind = 1
        else typeflag == 50:
            kind = 2
        else typeflag == 49:
            kind = 3
        else typeflag == 51 or typeflag == 52 or typeflag == 54:
            kind = 4
        else:
            nb := nm as u8*
            last := nb[nm.len() - 1] as int
            if last == 47 and (typeflag == 48 or typeflag == 0):
                kind = 1
            end
        end
        mut target := ""
        if kind == 2 or kind == 3:
            if px.linkpath.len() > 0:
                target = _tar_take(px.linkpath)
                _tar_drop(llink)
            else llink.len() > 0:
                target = _tar_take(llink)
            else:
                target = _tar_get_str(p, pos + 157, 100)
            end
            size = 0 as i64
        else kind == 4:
            size = 0 as i64
        end
        span := (((size as int) + 511) / 512) * 512
        if kind == 0 and (size < (0 as i64) or (dstart as i64) + size > limit):
            _tar_free_str(nm)
            _tar_free_str(target)
            break
        end
        mut mt := _tar_get_num(p, pos + 136, 12)
        if px.has_mtime:
            mt = px.mtime
        else g.has_mtime:
            mt = g.mtime
        end
        e = Entry {
            name = nm
            size = size
            compressed_size = size
            is_dir = kind == 1
            method = 0
            crc32 = 0 as u32
            mtime = mt
            link = target
            kind = kind
            mode = _tar_get_num(p, pos + 100, 8) as int
        }
        data = dstart
        pos = dstart
        if kind == 0:
            pos = dstart + span
        end
        _tar_px_free(px)
        _tar_drop(lname)
        _tar_drop(llink)
        ret true
    end
    _tar_px_free(px)
    _tar_drop(lname)
    _tar_drop(llink)
    ret false
end

func _tar_link_ok(name: str, target: str): bool:
    n := target.len()
    if n == 0: ret false end
    bp := target as u8*
    first := bp[0] as int
    if first == 47 or first == 92 or (n >= 2 and (bp[1] as int) == 58):
        ret false
    end
    nb := name as u8*
    mut depth := 0
    mut start := 0
    mut i := 0
    until i <= name.len():
        c := i < name.len() ? nb[i] as int : 47
        if c == 47 or c == 92:
            seg := i - start
            if seg > 0 and not (seg == 1 and (nb[start] as int) == 46):
                depth++
            end
            start = i + 1
        end
        i++
    end
    depth--
    mut ups := 0
    mut seen := false
    start = 0
    i = 0
    until i <= n:
        c := i < n ? bp[i] as int : 47
        if c == 47 or c == 92:
            seg := i - start
            if seg == 2 and (bp[start] as int) == 46 and (bp[start + 1] as int) == 46:
                if seen: ret false end
                ups++
                if ups > depth: ret false end
            else seg > 0 and not (seg == 1 and (bp[start] as int) == 46):
                seen = true
            end
            start = i + 1
        end
        i++
    end
    ret true
end

func _tar_is_link(path: str): bool:
    if SALAM_OS_WINDOWS:
        ret false
    else:
        buf := mem.Allocate(8 as u64)
        r := readlink(path, buf, 8 as usize)
        mem.Free(buf)
        ret r >= 0
    end
end

func _tar_through_link(destdir: str, name: str): bool:
    n := name.len()
    bp := name as u8*
    mut i := 1
    until i < n:
        if (bp[i] as int) == 47:
            part := name.substr(0, i)
            full := filepath.Join(destdir, part)
            hit := _tar_is_link(full)
            mem.Free(full as void*)
            _tar_free_str(part)
            if hit: ret true end
        end
        i++
    end
    ret false
end

func _tar_symlink(target: str, path: str): bool:
    if SALAM_OS_WINDOWS:
        ret false
    else:
        ret symlink(target, path) == 0
    end
end

func _tar_hardlink(src: str, path: str): bool:
    if SALAM_OS_WINDOWS:
        ret false
    else:
        ret link(src, path) == 0
    end
end

func _tar_set_mtime(path: str, t: i64):
    if SALAM_OS_WINDOWS:
        ret
    else:
        if sizeof(void*) != 8: ret end
        tv := mem.AllocateZeroed(32 as u64) as i64*
        tv[0] = t
        tv[2] = t
        utimes(path, tv as void*)
        mem.Free(tv as void*)
    end
end

func _tar_set_mode(path: str, mode: int, is_dir: bool):
    if mode == 0: ret end
    mut m := mode & 0o777
    if is_dir: m |= 0o700 end
    fs.Chmod(path, m)
end

func _tar_write_entry_file(p: void*, data: int, e: Entry, outpath: str): bool:
    parent := filepath.Dir(outpath)
    EnsureDir(parent)
    mem.Free(parent as void*)
    os.Remove(outpath)
    data_ptr := ((p as i64) + (data as i64)) as void*
    ok := WriteBinaryFile(outpath, data_ptr, e.size as int)
    if ok:
        _tar_set_mode(outpath, e.mode, false)
        if e.mtime > (0 as i64): _tar_set_mtime(outpath, e.mtime) end
    end
    ret ok
end

func _tar_copy_file(src: str, dst: str): bool:
    mut ok := false
    mut b := ReadBinaryFile(src, ok)
    if not ok:
        compress.BufFree(b)
        ret false
    end
    r := WriteBinaryFileBuf(dst, b)
    compress.BufFree(b)
    ret r
end

func _tar_finish_dirs(dirs &: Vector<str>, dir_times &: Vector<i64>):
    mut k := dirs.len() - 1
    until k >= 0:
        dp := dirs.get(k)
        _tar_set_mtime(dp, dir_times.get(k))
        mem.Free(dp as void*)
        k--
    end
    dirs.free()
    dir_times.free()
end

func _tar_write_stream(fp: void*, foff: i64, e: Entry, outpath: str, cap: i64, st &: int): bool:
    parent := filepath.Dir(outpath)
    EnsureDir(parent)
    mem.Free(parent as void*)
    os.Remove(outpath)
    mut sink := compress.SinkOpen(outpath, cap)
    if sink.failed:
        st = TAR_IO
        ret false
    end
    good := compress.SinkCopyFrom(sink, fp, foff, e.size)
    closed := compress.SinkClose(sink)
    if not good or not closed:
        os.Remove(outpath)
        if sink.over:
            st = TAR_TOO_BIG
        else sink.failed:
            st = TAR_IO
        else:
            st = TAR_CORRUPT
        end
        ret false
    end
    _tar_set_mode(outpath, e.mode, false)
    if e.mtime > (0 as i64): _tar_set_mtime(outpath, e.mtime) end
    ret true
end

func _tar_place(e: Entry, destdir: str, dirs &: Vector<str>, dir_times &: Vector<i64>, p: void*, data: int, fp: void*, foff: i64, cap: i64, st &: int): bool:
    mut ok := true
    if not _safe_entry_name(e.name) or _tar_through_link(destdir, e.name):
        st = TAR_UNSAFE_PATH
        _tar_free_str(e.name)
        _tar_free_str(e.link)
        ret false
    end
    outpath := filepath.Join(destdir, e.name)
    if e.kind == 1:
        EnsureDir(outpath)
        _tar_set_mode(outpath, e.mode, true)
        if e.mtime > (0 as i64):
            dirs.push(outpath)
            dir_times.push(e.mtime)
            _tar_free_str(e.name)
            _tar_free_str(e.link)
            ret true
        end
    else e.kind == 2:
        if _tar_link_ok(e.name, e.link):
            parent := filepath.Dir(outpath)
            EnsureDir(parent)
            mem.Free(parent as void*)
            os.Remove(outpath)
            if not _tar_symlink(e.link, outpath): ok = false end
        else:
            st = TAR_UNSAFE_PATH
            ok = false
        end
    else e.kind == 3:
        if _safe_entry_name(e.link) and not _tar_through_link(destdir, e.link):
            src := filepath.Join(destdir, e.link)
            parent := filepath.Dir(outpath)
            EnsureDir(parent)
            mem.Free(parent as void*)
            os.Remove(outpath)
            if not _tar_hardlink(src, outpath):
                if not _tar_copy_file(src, outpath): ok = false end
            end
            mem.Free(src as void*)
        else:
            st = TAR_UNSAFE_PATH
            ok = false
        end
    else e.kind == 4:
        ok = false
    else:
        if fp == null:
            if not _tar_write_entry_file(p, data, e, outpath):
                ok = false
            end
        else:
            if not _tar_write_stream(fp, foff, e, outpath, cap, st):
                ok = false
            end
        end
    end
    mem.Free(outpath as void*)
    _tar_free_str(e.name)
    _tar_free_str(e.link)
    ret ok
end

func _tv_close(v: _TarVirt*):
    if v[0].src != null:
        compress.FileClose(v[0].src)
    end
    compress.BufFree(v[0].hbuf)
    mem.Free(v[0].starts as void*)
    mem.Free(v[0].sizes as void*)
    mem.Free(v[0].hlens as void*)
    mem.Free(v as void*)
end

func _tv_open(files: Vector<TarFileInput>): _TarVirt*:
    n := files.len()
    v := mem.AllocateZeroed(sizeof(_TarVirt)) as _TarVirt*
    v[0].files = files
    v[0].n = n
    v[0].starts = mem.AllocateZeroed(((n + 1) * 8) as u64) as i64*
    v[0].sizes = mem.AllocateZeroed(((n + 1) * 8) as u64) as i64*
    v[0].hlens = mem.AllocateZeroed(((n + 1) * 4) as u64) as int*
    v[0].hcur = 0 - 1
    v[0].scur = 0 - 1
    v[0].last = 0
    v[0].hbuf = compress.NewByteBuf()
    mut at := 0 as i64
    mut ok := true
    mut i := 0
    until i < n and ok:
        f := files.get(i)
        kind := _tar_input_kind(f)
        mut size := f.data_len as i64
        if f.path.len() > 0 and kind == 0:
            s := compress.FileOpenRead(f.path)
            if s == null:
                ok = false
            else:
                size = compress.FileSize(s)
                compress.FileClose(s)
                if size < (0 as i64):
                    ok = false
                end
            end
        else kind == 0 and (f.data_len < 0 or (f.data_ptr == null and f.data_len > 0)):
            ok = false
        end
        if ok:
            mut h := compress.NewByteBuf()
            _tar_write_header(h, f, size)
            dsize := kind == 0 ? size : (0 as i64)
            rest := dsize % (512 as i64)
            v[0].starts[i] = at
            v[0].sizes[i] = dsize
            v[0].hlens[i] = h.len
            at += (h.len as i64) + dsize + (rest > (0 as i64) ? (512 as i64) - rest : (0 as i64))
            compress.BufFree(h)
        end
        i++
    end
    v[0].starts[n] = at
    v[0].total = at + (1024 as i64)
    if not ok:
        _tv_close(v)
        ret null
    end
    ret v
end

func _tv_read(off: i64, dst: void*, n: int, c: void*): int:
    v := c as _TarVirt*
    mut done := 0
    until done < n:
        at := off + (done as i64)
        if at < (0 as i64) or at >= v[0].total:
            break
        end
        mut take := n - done
        out := ((dst as i64) + (done as i64)) as void*
        if at >= v[0].starts[v[0].n]:
            left := v[0].total - at
            if (take as i64) > left:
                take = left as int
            end
            mem.Set(out, 0, take as u64)
            done += take
            continue
        end
        mut cur := v[0].last
        if cur < 0 or at < v[0].starts[cur]:
            cur = 0
        end
        until cur + 1 < v[0].n and v[0].starts[cur + 1] <= at:
            cur++
        end
        v[0].last = cur
        rel := at - v[0].starts[cur]
        hl := v[0].hlens[cur] as i64
        dsize := v[0].sizes[cur]
        f := v[0].files.get(cur)
        if rel < hl:
            if v[0].hcur != cur:
                compress.BufReset(v[0].hbuf)
                size := _tar_input_kind(f) == 0 ? dsize : (f.data_len as i64)
                _tar_write_header(v[0].hbuf, f, size)
                v[0].hcur = cur
            end
            if (take as i64) > hl - rel:
                take = (hl - rel) as int
            end
            mem.Copy(out, ((v[0].hbuf.data as i64) + rel) as void*, take as u64)
        else rel < hl + dsize:
            drel := rel - hl
            if (take as i64) > dsize - drel:
                take = (dsize - drel) as int
            end
            if f.path.len() > 0:
                if v[0].scur != cur:
                    if v[0].src != null:
                        compress.FileClose(v[0].src)
                    end
                    v[0].src = compress.FileOpenRead(f.path)
                    v[0].scur = cur
                end
                if v[0].src == null:
                    break
                end
                got := compress.FileReadAt(v[0].src, drel, out, take)
                done += got
                if got != take:
                    break
                end
                continue
            end
            mem.Copy(out, ((f.data_ptr as i64) + drel) as void*, take as u64)
        else:
            room := v[0].starts[cur + 1] - at
            if (take as i64) > room:
                take = room as int
            end
            mem.Set(out, 0, take as u64)
        end
        done += take
    end
    ret done
end

func _tar_stream_single(files: Vector<TarFileInput>, outpath: str, kind: int, level: int): bool:
    v := _tv_open(files)
    if v == null:
        ret false
    end
    read := (off: i64, d: void*, n: int, c: void*): ret _tv_read(off, d, n, c) end
    src := compress.CallbackOpenRead(v[0].total, read, v as void*)
    mut sink := compress.SinkOpen(outpath, 0 as i64)
    mut ok := not sink.failed
    if ok:
        if kind == _CW_BZIP2:
            ok = compress.Bzip2CompressFileToSink(src, 0 as i64, v[0].total, level >= 1 and level <= 9 ? level : 9, sink)
        else:
            ok = compress.ZstdCompressFileToSink(src, 0 as i64, v[0].total, level < 1 ? 3 : level, sink)
        end
    end
    if not compress.SinkClose(sink):
        ok = false
    end
    compress.FileClose(src)
    _tv_close(v)
    if not ok:
        os.Remove(outpath)
    end
    ret ok
end

func _tar_stream(files: Vector<TarFileInput>, outpath: str, kind: int, level: int): bool:
    if kind == _CW_BZIP2 or kind == _CW_ZSTD:
        ret _tar_stream_single(files, outpath, kind, level)
    end
    dst := compress.FileOpenWrite(outpath)
    if dst == null:
        ret false
    end
    mut cw := _cw_open(dst, kind, level)
    scratch := mem.Allocate(262144 as u64)
    mut ok := true
    mut i := 0
    until i < files.len() and ok:
        f := files.get(i)
        mut size := f.data_len as i64
        mut src := null as void*
        if f.path.len() > 0 and _tar_input_kind(f) == 0:
            src = compress.FileOpenRead(f.path)
            if src == null:
                ok = false
            else:
                size = compress.FileSize(src)
                if size < (0 as i64):
                    ok = false
                end
            end
        else _tar_input_kind(f) == 0 and (f.data_len < 0 or (f.data_ptr == null and f.data_len > 0)):
            ok = false
        end
        if ok:
            mut h := compress.NewByteBuf()
            _tar_write_header(h, f, size)
            ok = _cw_write(cw, h.data, h.len)
            compress.BufFree(h)
        end
        if ok and _tar_input_kind(f) == 0:
            if src != null:
                mut at := 0 as i64
                until at < size and ok:
                    mut want := 262144
                    if size - at < (want as i64):
                        want = (size - at) as int
                    end
                    got := compress.FileReadAt(src, at, scratch, want)
                    if got != want:
                        ok = false
                    else:
                        ok = _cw_write(cw, scratch, got)
                        at += got as i64
                    end
                end
            else:
                ok = _cw_write(cw, f.data_ptr, f.data_len)
            end
            if ok and size % (512 as i64) > (0 as i64):
                mut pad := compress.NewByteBuf()
                _tar_pad(pad, (size % (512 as i64)) as int)
                ok = _cw_write(cw, pad.data, pad.len)
                compress.BufFree(pad)
            end
        end
        if src != null:
            compress.FileClose(src)
        end
        i++
    end
    mem.Free(scratch)
    if ok:
        mut z := compress.NewByteBuf()
        repeat 1024: compress.BufPush(z, 0) end
        ok = _cw_write(cw, z.data, z.len)
        compress.BufFree(z)
    end
    if ok:
        ok = _cw_finish(cw)
    else:
        _cw_abort(cw)
    end
    if fclose(dst) != 0:
        ok = false
    end
    if not ok:
        os.Remove(outpath)
    end
    ret ok
end

@en "MakeTarFileInput"
@fa "ساخت ورودی پرونده تار"
pub func MakeTarFileInput(name: str, data_ptr: void*, data_len: int, is_dir: bool): TarFileInput:
    ret TarFileInput { name = name, data_ptr = data_ptr, data_len = data_len, is_dir = is_dir, mode = 0, mtime = 0 as i64, link = "", kind = 0 }
end

@en "MakeTarFilePath"
@fa "ساخت ورودی پرونده تار از مسیر"
pub func MakeTarFilePath(name: str, path: str): TarFileInput:
    ret TarFileInput { name = name, path = path, kind = 0 }
end

@en "MakeTarSymlink"
@fa "ساخت ورودی پیوند نمادین تار"
pub func MakeTarSymlink(name: str, target: str): TarFileInput:
    ret TarFileInput { name = name, data_ptr = null, data_len = 0, is_dir = false, mode = 0, mtime = 0 as i64, link = target, kind = 2 }
end

@en "MakeTarHardlink"
@fa "ساخت ورودی پیوند سخت تار"
pub func MakeTarHardlink(name: str, target: str): TarFileInput:
    ret TarFileInput { name = name, data_ptr = null, data_len = 0, is_dir = false, mode = 0, mtime = 0 as i64, link = target, kind = 3 }
end

@en "TarCreate"
@fa "ساخت تار"
pub func TarCreate(files: Vector<TarFileInput>): compress.ByteBuf:
    mut out := compress.NewByteBuf()
    mut i := 0
    until i < files.len():
        f := files.get(i)
        mut data := compress.NewByteBuf()
        mut dp := f.data_ptr
        mut dn := f.data_len
        if f.path.len() > 0 and _tar_input_kind(f) == 0:
            mut rok := false
            data = ReadBinaryFile(f.path, rok)
            if not rok:
                compress.BufFree(out)
                compress.BufFree(data)
                ret compress.NewByteBuf()
            end
            dp = data.data
            dn = data.len
        end
        _tar_write_header(out, f, dn as i64)
        if _tar_input_kind(f) == 0:
            compress.BufPushBytes(out, dp, dn)
            _tar_pad(out, dn)
        end
        compress.BufFree(data)
        i++
    end
    repeat 1024: compress.BufPush(out, 0) end
    ret out
end

@en "TarBz2CreateFile"
@fa "ساخت پرونده تار بی زیپ دو"
pub func TarBz2CreateFile(files: Vector<TarFileInput>, outpath: str): bool:
    ret _tar_stream(files, outpath, _CW_BZIP2, 9)
end

@en "TarBz2CreateFileLevel"
@fa "ساخت پرونده تار بی زیپ دو با سطح"
pub func TarBz2CreateFileLevel(files: Vector<TarFileInput>, outpath: str, level: int): bool:
    ret _tar_stream(files, outpath, _CW_BZIP2, level < 1 ? 1 : (level > 9 ? 9 : level))
end

@en "TarCreateFile"
@fa "ساخت پرونده تار"
pub func TarCreateFile(files: Vector<TarFileInput>, outpath: str): bool:
    ret _tar_stream(files, outpath, _CW_RAW, 0)
end

@en "TarList"
@fa "فهرست تار"
pub func TarList(p: void*, n: int): Vector<Entry>:
    mut out := Vector {} as Vector<Entry>
    mut pos := 0
    mut e := Entry {}
    mut data := 0
    mut g := _TarPax {}
    until _tar_next(p, n, pos, e, data, g, n as i64):
        out.push(e)
    end
    ret out
end

@en "TarExtractByName"
@fa "استخراج با نام از تار"
pub func TarExtractByName(p: void*, n: int, name: str, ok &: bool): compress.ByteBuf:
    ok = false
    mut out := compress.NewByteBuf()
    mut pos := 0
    mut e := Entry {}
    mut data := 0
    mut g := _TarPax {}
    until _tar_next(p, n, pos, e, data, g, n as i64):
        hit := e.kind == 0 and e.name == name
        _tar_free_str(e.name)
        _tar_free_str(e.link)
        if hit:
            data_ptr := ((p as i64) + (data as i64)) as void*
            compress.BufPushBytes(out, data_ptr, e.size as int)
            ok = true
            ret out
        end
    end
    ret out
end

@en "TarExtractAll"
@fa "استخراج همه از تار"
pub func TarExtractAll(p: void*, n: int, destdir: str): bool:
    mut all_ok := true
    mut pos := 0
    mut e := Entry {}
    mut data := 0
    mut g := _TarPax {}
    mut dirs := Vector {} as Vector<str>
    mut dir_times := Vector {} as Vector<i64>
    mut st := 0
    until _tar_next(p, n, pos, e, data, g, n as i64):
        if not _tar_place(e, destdir, dirs, dir_times, p, data, null, 0 as i64, 0 as i64, st):
            all_ok = false
        end
    end
    _tar_finish_dirs(dirs, dir_times)
    ret all_ok
end

@en "TarGzCreate"
@fa "ساخت تار جی زیپ"
pub func TarGzCreate(files: Vector<TarFileInput>): compress.ByteBuf:
    mut t := TarCreate(files)
    out := compress.GzipCompressBuf(t)
    compress.BufFree(t)
    ret out
end

@en "TarGzCreateFile"
@fa "ساخت پرونده تار جی زیپ"
pub func TarGzCreateFile(files: Vector<TarFileInput>, outpath: str): bool:
    ret _tar_stream(files, outpath, _CW_GZIP, 0)
end

@en "TarGzListMax"
@fa "فهرست تار جی زیپ با سقف"
pub func TarGzListMax(p: void*, n: int, max: int, ok &: bool): Vector<Entry>:
    mut t := compress.GzipDecompressMax(p, n, max, ok)
    if not ok:
        compress.BufFree(t)
        ret Vector {}
    end
    out := TarList(t.data, t.len)
    compress.BufFree(t)
    ret out
end

@en "TarGzList"
@fa "فهرست تار جی زیپ"
pub func TarGzList(p: void*, n: int, ok &: bool): Vector<Entry>:
    ret TarGzListMax(p, n, _TAR_GZ_DEFAULT_MAX, ok)
end

@en "TarGzExtractByNameMax"
@fa "استخراج با نام از تار جی زیپ با سقف"
pub func TarGzExtractByNameMax(p: void*, n: int, name: str, max: int, ok &: bool): compress.ByteBuf:
    mut gok := false
    mut t := compress.GzipDecompressMax(p, n, max, gok)
    if not gok:
        compress.BufFree(t)
        ok = false
        ret compress.NewByteBuf()
    end
    out := TarExtractByName(t.data, t.len, name, ok)
    compress.BufFree(t)
    ret out
end

@en "TarGzExtractByName"
@fa "استخراج با نام از تار جی زیپ"
pub func TarGzExtractByName(p: void*, n: int, name: str, ok &: bool): compress.ByteBuf:
    ret TarGzExtractByNameMax(p, n, name, _TAR_GZ_DEFAULT_MAX, ok)
end

@en "TarGzExtractAllMax"
@fa "استخراج همه از تار جی زیپ با سقف"
pub func TarGzExtractAllMax(p: void*, n: int, destdir: str, max: int): bool:
    mut gok := false
    mut t := compress.GzipDecompressMax(p, n, max, gok)
    if not gok:
        compress.BufFree(t)
        ret false
    end
    ok := TarExtractAll(t.data, t.len, destdir)
    compress.BufFree(t)
    ret ok
end

@en "TarGzExtractAll"
@fa "استخراج همه از تار جی زیپ"
pub func TarGzExtractAll(p: void*, n: int, destdir: str): bool:
    ret TarGzExtractAllMax(p, n, destdir, _TAR_GZ_DEFAULT_MAX)
end

