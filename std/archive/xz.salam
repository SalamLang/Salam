package archive

import compress

@en "XzDecompressFile"
@fa "کدگشایی پرونده ایکس زد"
pub func XzDecompressFile(inpath: str, outpath: str): bool:
    mut rok := false
    mut inbuf := ReadBinaryFile(inpath, rok)
    if not rok:
        ret false
    end
    mut gok := false
    mut out := compress.XzDecompress(inbuf.data, inbuf.len, gok)
    compress.BufFree(inbuf)
    if not gok:
        compress.BufFree(out)
        ret false
    end
    wok := WriteBinaryFileBuf(outpath, out)
    compress.BufFree(out)
    ret wok
end

@en "LzmaDecompressFile"
@fa "کدگشایی پرونده الزد ام ای"
pub func LzmaDecompressFile(inpath: str, outpath: str): bool:
    mut rok := false
    mut inbuf := ReadBinaryFile(inpath, rok)
    if not rok:
        ret false
    end
    mut gok := false
    mut out := compress.LzmaDecompress(inbuf.data, inbuf.len, gok)
    compress.BufFree(inbuf)
    if not gok:
        compress.BufFree(out)
        ret false
    end
    wok := WriteBinaryFileBuf(outpath, out)
    compress.BufFree(out)
    ret wok
end
