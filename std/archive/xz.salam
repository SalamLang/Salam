package archive

import compress

@en "XzCompressFile"
@fa "فشرده سازی پرونده ایکس زد"
pub func XzCompressFile(inpath: str, outpath: str): bool:
    ret _cw_compress_path(inpath, outpath, _CW_XZ, 6)
end

@en "XzCompressFileLevel"
@fa "فشرده سازی پرونده ایکس زد با سطح"
pub func XzCompressFileLevel(inpath: str, outpath: str, level: int): bool:
    mut lv := level
    if lv < 0: lv = 0 end
    if lv > 9: lv = 9 end
    ret _cw_compress_path(inpath, outpath, _CW_XZ, lv)
end

@en "LzmaCompressFile"
@fa "فشرده سازی پرونده الزد ام ای"
pub func LzmaCompressFile(inpath: str, outpath: str): bool:
    ret LzmaCompressFileLevel(inpath, outpath, 6)
end

@en "LzmaCompressFileLevel"
@fa "فشرده سازی پرونده الزد ام ای با سطح"
pub func LzmaCompressFileLevel(inpath: str, outpath: str, level: int): bool:
    mut rok := false
    mut inbuf := ReadBinaryFile(inpath, rok)
    if not rok:
        ret false
    end
    mut out := compress.LzmaCompressLevel(inbuf.data, inbuf.len, level)
    wok := WriteBinaryFileBuf(outpath, out)
    compress.BufFree(inbuf)
    compress.BufFree(out)
    ret wok
end

@en "XzDecompressFile"
@fa "کدگشایی پرونده ایکس زد"
pub func XzDecompressFile(inpath: str, outpath: str): bool:
    mut rok := false
    mut inbuf := ReadBinaryFile(inpath, rok)
    if not rok:
        ret false
    end
    mut gok := false
    mut out := compress.XzDecompress(inbuf.data, inbuf.len, gok)
    compress.BufFree(inbuf)
    if not gok:
        compress.BufFree(out)
        ret false
    end
    wok := WriteBinaryFileBuf(outpath, out)
    compress.BufFree(out)
    ret wok
end

@en "XzDecompressFileCap"
@fa "کدگشایی پرونده ایکس زد با سقف"
pub func XzDecompressFileCap(inpath: str, outpath: str, cap: i64): int:
    mut rok := false
    mut inbuf := ReadBinaryFile(inpath, rok)
    if not rok:
        ret ARCHIVE_IO_ERROR
    end
    mut why := 0
    mut out := compress.XzDecompressWhy(inbuf.data, inbuf.len, _decap(cap), why)
    compress.BufFree(inbuf)
    if why != compress.DecodeOk:
        compress.BufFree(out)
        ret why == compress.DecodeTooBig ? ARCHIVE_TOO_BIG : ARCHIVE_CORRUPT
    end
    wok := WriteBinaryFileBuf(outpath, out)
    compress.BufFree(out)
    ret wok ? ARCHIVE_OK : ARCHIVE_IO_ERROR
end

@en "LzmaDecompressFileCap"
@fa "کدگشایی پرونده الزد ام ای با سقف"
pub func LzmaDecompressFileCap(inpath: str, outpath: str, cap: i64): int:
    mut rok := false
    mut inbuf := ReadBinaryFile(inpath, rok)
    if not rok:
        ret ARCHIVE_IO_ERROR
    end
    mut why := 0
    mut out := compress.LzmaDecompressWhy(inbuf.data, inbuf.len, _decap(cap), why)
    compress.BufFree(inbuf)
    if why != compress.DecodeOk:
        compress.BufFree(out)
        ret why == compress.DecodeTooBig ? ARCHIVE_TOO_BIG : ARCHIVE_CORRUPT
    end
    wok := WriteBinaryFileBuf(outpath, out)
    compress.BufFree(out)
    ret wok ? ARCHIVE_OK : ARCHIVE_IO_ERROR
end

@en "LzmaDecompressFile"
@fa "کدگشایی پرونده الزد ام ای"
pub func LzmaDecompressFile(inpath: str, outpath: str): bool:
    mut rok := false
    mut inbuf := ReadBinaryFile(inpath, rok)
    if not rok:
        ret false
    end
    mut gok := false
    mut out := compress.LzmaDecompress(inbuf.data, inbuf.len, gok)
    compress.BufFree(inbuf)
    if not gok:
        compress.BufFree(out)
        ret false
    end
    wok := WriteBinaryFileBuf(outpath, out)
    compress.BufFree(out)
    ret wok
end
